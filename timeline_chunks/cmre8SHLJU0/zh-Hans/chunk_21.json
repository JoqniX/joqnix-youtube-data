[{"type": "subtitle", "time": 1268.789, "timestamp": "00:21:08", "text": "我为一些想看直播的节目做一些创意工作"}, {"type": "subtitle", "time": 1271.669, "timestamp": "00:21:11", "text": "。 不，我没事。 我"}, {"type": "subtitle", "time": 1275.27, "timestamp": "00:21:15", "text": "其实很好。  K，"}, {"type": "subtitle", "time": 1277.43, "timestamp": "00:21:17", "text": "呃，"}, {"type": "subtitle", "time": 1282.23, "timestamp": "00:21:22", "text": "还有，请呃，遵守"}, {"type": "subtitle", "time": 1284.87, "timestamp": "00:21:24", "text": "直播规则，不要做"}, {"type": "subtitle", "time": 1292.149, "timestamp": "00:21:32", "text": "谢谢。"}, {"type": "subtitle", "time": 1295.35, "timestamp": "00:21:35", "text": "这么多年过去了，传奇人物纷纷退役，AJ、约翰、"}, {"type": "subtitle", "time": 1297.909, "timestamp": "00:21:37", "text": "塞纳、布洛克，还有戈德堡，啊，戈德堡，"}, {"type": "subtitle", "time": 1301.909, "timestamp": "00:21:41", "text": "我认识他，以前经常看他的比赛，"}, {"type": "subtitle", "time": 1304.789, "timestamp": "00:21:44", "text": "兄弟，WWE摔跤什么的就像"}, {"type": "subtitle", "time": 1307.83, "timestamp": "00:21:47", "text": "纯粹的娱乐，现在"}, {"type": "subtitle", "time": 1310.149, "timestamp": "00:21:50", "text": "这样太疯狂了，但仔细想想，"}, {"type": "subtitle", "time": 1311.99, "timestamp": "00:21:51", "text": "他们做这一切都是为了"}, {"type": "subtitle", "time": 1314.47, "timestamp": "00:21:54", "text": "娱乐，对吧？但是当他们做"}, {"type": "subtitle", "time": 1316.31, "timestamp": "00:21:56", "text": "那些摔跤、"}, {"type": "subtitle", "time": 1319.59, "timestamp": "00:21:59", "text": "猛击之类的动作，还有现在的跳跃"}]
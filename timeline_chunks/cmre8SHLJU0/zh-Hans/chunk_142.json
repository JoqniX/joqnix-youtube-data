[{"type": "subtitle", "time": 8524.309, "timestamp": "02:22:04", "text": "基尔。"}, {"type": "subtitle", "time": 8535.03, "timestamp": "02:22:15", "text": "兄弟，"}, {"type": "subtitle", "time": 8536.79, "timestamp": "02:22:16", "text": "我们打架。 我们不能。 我们甚至连"}, {"type": "subtitle", "time": 8553.59, "timestamp": "02:22:33", "text": "试图用拳头打架。"}, {"type": "subtitle", "time": 8565.03, "timestamp": "02:22:45", "text": "再见。 再打一场比赛，我们就结束今天的节目了"}, {"type": "subtitle", "time": 8567.75, "timestamp": "02:22:47", "text": "。   那"}, {"type": "subtitle", "time": 8570.63, "timestamp": "02:22:50", "text": "不是我。"}]
[{"type": "subtitle", "time": 9074.309, "timestamp": "02:31:14", "text": "什么？"}, {"type": "subtitle", "time": 9077.83, "timestamp": "02:31:17", "text": "你好，俊小子。我觉得我死了。我"}, {"type": "subtitle", "time": 9080.07, "timestamp": "02:31:20", "text": "摔倒了，掉到地上了。"}, {"type": "subtitle", "time": 9081.51, "timestamp": "02:31:21", "text": "你们看到这个了吗？"}, {"type": "subtitle", "time": 9082.63, "timestamp": "02:31:22", "text": "无人机。"}, {"type": "subtitle", "time": 9085.99, "timestamp": "02:31:25", "text": "我们现在看到了吗？"}, {"type": "subtitle", "time": 9089.75, "timestamp": "02:31:29", "text": "我没看错吧？"}, {"type": "subtitle", "time": 9118.23, "timestamp": "02:31:58", "text": "什么？"}]
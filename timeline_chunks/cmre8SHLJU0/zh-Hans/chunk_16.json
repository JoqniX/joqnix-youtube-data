[{"type": "subtitle", "time": 962.23, "timestamp": "00:16:02", "text": "你看职业比赛吗？ 我小时候经常看"}, {"type": "subtitle", "time": 964.949, "timestamp": "00:16:04", "text": "。"}, {"type": "subtitle", "time": 969.03, "timestamp": "00:16:09", "text": "什么？ 什么？ 就像兰迪·罗杰斯（Randy Rogan）10岁以后，还有"}, {"type": "subtitle", "time": 972.23, "timestamp": "00:16:12", "text": "约翰·塞纳（John Cena）、巨石强森（The Rock）等等，"}, {"type": "subtitle", "time": 974.15, "timestamp": "00:16:14", "text": "那时候他们还经常这么做。 不，"}, {"type": "subtitle", "time": 980.87, "timestamp": "00:16:20", "text": "我以前每次放学回家都会看那个"}, {"type": "subtitle", "time": 984.31, "timestamp": "00:16:24", "text": "。 我"}, {"type": "subtitle", "time": 985.67, "timestamp": "00:16:25", "text": "想那大概是我"}, {"type": "chat", "time": 1006.958, "timestamp": "00:16:46", "author": "@GoojiiBot", "avatar": "https://yt4.ggpht.com/mPYgxFLpVlEw3IlqLJvO23Nw3qURJpHaR1vq7WFEWKVvRh1eRhQtoaGuPnjptIVN3y8KNCWkr-4=s64-c-k-c0x00ffffff-no-rj", "message": "The legacy those men left behind is just Hall of Fame worthy"}]
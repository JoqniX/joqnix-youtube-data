[{"type": "subtitle", "time": 1824.789, "timestamp": "00:30:24", "text": "換彈。  卡爾斯蒂科夫從未有過戰術召回。  他們確實"}, {"type": "subtitle", "time": 1833.59, "timestamp": "00:30:33", "text": "這麼做了，對吧？  知道跑酷遊戲的"}, {"type": "subtitle", "time": 1842.389, "timestamp": "00:30:42", "text": "酷地圖。是的。是的。是的。  啊，真是太蠢了。"}, {"type": "subtitle", "time": 1859.59, "timestamp": "00:30:59", "text": "啊，你這小鬼"}]
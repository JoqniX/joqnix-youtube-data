[{"type": "subtitle", "time": 425.83, "timestamp": "00:07:05", "text": "我不是故意冒犯你的，但我知道我把"}, {"type": "subtitle", "time": 429.749, "timestamp": "00:07:09", "text": "你誤認成了相反的人，我把你誤認為"}, {"type": "subtitle", "time": 433.11, "timestamp": "00:07:13", "text": "男生。我是個男的。"}, {"type": "subtitle", "time": 435.51, "timestamp": "00:07:15", "text": "我的天哪，各位。是的，我也有這種感覺。"}, {"type": "subtitle", "time": 439.35, "timestamp": "00:07:19", "text": "問題是現在我的聲音"}, {"type": "subtitle", "time": 443.51, "timestamp": "00:07:23", "text": "可能會讓很多人感到困惑。"}, {"type": "subtitle", "time": 449.51, "timestamp": "00:07:29", "text": "我天生就有這樣的嗓音。所以，"}, {"type": "subtitle", "time": 453.51, "timestamp": "00:07:33", "text": "嗯，因為聲音很柔和，嗯，我覺得"}, {"type": "subtitle", "time": 457.189, "timestamp": "00:07:37", "text": "它的音調很高。正因如此，"}, {"type": "subtitle", "time": 471.589, "timestamp": "00:07:51", "text": "如果你"}, {"type": "subtitle", "time": 473.909, "timestamp": "00:07:53", "text": "從我的麥克風"}, {"type": "chat", "time": 476.838, "timestamp": "00:07:56", "author": "@GoojiiBot", "avatar": "https://yt4.ggpht.com/mPYgxFLpVlEw3IlqLJvO23Nw3qURJpHaR1vq7WFEWKVvRh1eRhQtoaGuPnjptIVN3y8KNCWkr-4=s64-c-k-c0x00ffffff-no-rj", "message": "Oh I see! "}]
[{"type": "subtitle", "time": 602.07, "timestamp": "00:10:02", "text": "但說實話，如果你問"}, {"type": "subtitle", "time": 603.91, "timestamp": "00:10:03", "text": "我，"}, {"type": "subtitle", "time": 611.59, "timestamp": "00:10:11", "text": "例如，我看的直播主"}, {"type": "subtitle", "time": 613.99, "timestamp": "00:10:13", "text": "是男的還是女的什麼的。我覺得，"}, {"type": "subtitle", "time": 618.23, "timestamp": "00:10:18", "text": "呃，說到虛擬直播，呃，我們就是"}, {"type": "subtitle", "time": 621.03, "timestamp": "00:10:21", "text": "享受做自己，"}, {"type": "subtitle", "time": 623.59, "timestamp": "00:10:23", "text": "扮演節目中的角色。我的"}, {"type": "subtitle", "time": 626.79, "timestamp": "00:10:26", "text": "天哪，他真的這麼做了，他只是……嗯，還有"}, {"type": "subtitle", "time": 632.389, "timestamp": "00:10:32", "text": "一件事，"}, {"type": "subtitle", "time": 639.75, "timestamp": "00:10:39", "text": "我該怎麼說呢？更像是"}, {"type": "subtitle", "time": 643.75, "timestamp": "00:10:43", "text": "有人把我誤認為"}, {"type": "subtitle", "time": 646.389, "timestamp": "00:10:46", "text": "其他性別，然後我就想，啊，"}, {"type": "subtitle", "time": 649.11, "timestamp": "00:10:49", "text": "誰來告訴他呢？我不想"}, {"type": "subtitle", "time": 652.47, "timestamp": "00:10:52", "text": "破壞他的沉浸感，"}, {"type": "subtitle", "time": 655.99, "timestamp": "00:10:55", "text": "因為他畢竟是個運動健將，對吧？運動健將也是一個"}, {"type": "subtitle", "time": 658.63, "timestamp": "00:10:58", "text": "角色，所以…"}]
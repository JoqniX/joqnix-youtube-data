[{"type": "subtitle", "time": 9541.03, "timestamp": "02:39:01", "text": "下週就是公開測試了。所以，全世界的人都可以在周五和"}, {"type": "subtitle", "time": 9556.07, "timestamp": "02:39:16", "text": "周日免費玩三天。嗯，這是太平洋標準時間。所以對我來說，就是週六、週日和週一。所以，"}, {"type": "subtitle", "time": 9558.389, "timestamp": "02:39:18", "text": "我想大概到週一早上6點左右。"}, {"type": "subtitle", "time": 9562.79, "timestamp": "02:39:22", "text": "是的。但是，等著瞧吧。還有，我忘了說，週日我可能不會"}, {"type": "subtitle", "time": 9565.11, "timestamp": "02:39:25", "text": "直播，因為我要去新宿。我可能會在新宿做偶像直播"}, {"type": "chat", "time": 9591.003, "timestamp": "02:39:51", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "thank you everyone who came by tonight! otsujoq"}]
[{"type": "subtitle", "time": 14761.189, "timestamp": "04:06:01", "text": "仕事とか色々。 JFT相当品および"}, {"type": "subtitle", "time": 14764.189, "timestamp": "04:06:04", "text": "もの。うん、いいよ"}, {"type": "subtitle", "time": 14766.95, "timestamp": "04:06:06", "text": "もの。こんにちは、フリン。ようこそ"}, {"type": "subtitle", "time": 14768.309, "timestamp": "04:06:08", "text": "ストリーム。"}, {"type": "subtitle", "time": 14770.349, "timestamp": "04:06:10", "text": "そうですね"}, {"type": "subtitle", "time": 14773.83, "timestamp": "04:06:13", "text": "えーっと、リンクを確認してください"}, {"type": "subtitle", "time": 14777.75, "timestamp": "04:06:17", "text": "説明が必要な場合は、"}, {"type": "subtitle", "time": 14780.87, "timestamp": "04:06:20", "text": "えーと、勉強とか色々。こんにちは、えっと、私はまだ"}, {"type": "subtitle", "time": 14783.269, "timestamp": "04:06:23", "text": "たくさん準備したけど、これを直してみよう"}, {"type": "subtitle", "time": 14784.51, "timestamp": "04:06:24", "text": "上。"}, {"type": "subtitle", "time": 14788.389, "timestamp": "04:06:28", "text": "わかった。えっと、今日は2つやります"}, {"type": "subtitle", "time": 14792.309, "timestamp": "04:06:32", "text": "もの。 PDFに従う"}, {"type": "subtitle", "time": 14795.91, "timestamp": "04:06:35", "text": "A1教科書入門教科書を暗唱し、"}, {"type": "subtitle", "time": 14797.99, "timestamp": "04:06:37", "text": "公式も検討します"}, {"type": "subtitle", "time": 14801.189, "timestamp": "04:06:41", "text": "ウェブサイトの音声関連。私たちは、"}, {"type": "subtitle", "time": 14804.309, "timestamp": "04:06:44", "text": "ワークシートのような練習問題を解いてください。"}, {"type": "subtitle", "time": 14806.229, "timestamp": "04:06:46", "text": "リスニング理解力が非常に高い"}, {"type": "subtitle", "time": 14809.189, "timestamp": "04:06:49", "text": "音声には多くのものが含まれています。だから私たちは"}, {"type": "subtitle", "time": 14811.67, "timestamp": "04:06:51", "text": "音声を参照し、次に"}, {"type": "subtitle", "time": 14815.03, "timestamp": "04:06:55", "text": "回答はPDFファイルに記載されています。では、私はどうするだろうか"}, {"type": "subtitle", "time": 14817.189, "timestamp": "04:06:57", "text": "私はそれを変更しません。私はただ"}]
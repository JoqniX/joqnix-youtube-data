[{"type": "subtitle", "time": 6661.709, "timestamp": "01:51:01", "text": "午後または"}, {"type": "subtitle", "time": 6664.189, "timestamp": "01:51:04", "text": "夕方または"}, {"type": "subtitle", "time": 6666.87, "timestamp": "01:51:06", "text": "将来的に何かあるだろうね。私"}, {"type": "subtitle", "time": 6669.95, "timestamp": "01:51:09", "text": "わからない。私"}, {"type": "subtitle", "time": 6673.07, "timestamp": "01:51:13", "text": "できません。しかし、どうなるか見てみましょう。調整します"}, {"type": "chat", "time": 6673.381, "timestamp": "01:51:13", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "!lurk"}, {"type": "subtitle", "time": 6676.189, "timestamp": "01:51:16", "text": "これ。わかった。ゲームは"}, {"type": "subtitle", "time": 6679.149, "timestamp": "01:51:19", "text": "オープン。うまくいくことを願おう"}, {"type": "chat", "time": 6679.874, "timestamp": "01:51:19", "author": "@Fossabot", "avatar": "https://yt4.ggpht.com/Qae0Khsat_K9w3KLI_TUx-usVsmpNVDdoSaJjJqkO8yeQsjDwP1oZiwJ8s2cjd_lZ5HnnDuQ=s64-c-k-c0x00ffffff-no-rj", "message": "/me @Solar alt is taking a nap (∪｡∪)｡｡｡zzZ 😴💤💤"}, {"type": "subtitle", "time": 6681.79, "timestamp": "01:51:21", "text": "良い。の"}, {"type": "subtitle", "time": 6684.39, "timestamp": "01:51:24", "text": "もちろん、追加するとこうなります"}, {"type": "subtitle", "time": 6693.91, "timestamp": "01:51:33", "text": "四角い箱の中に雪が降る"}, {"type": "subtitle", "time": 6697.55, "timestamp": "01:51:37", "text": "私自身について、全体ではなく"}, {"type": "subtitle", "time": 6700.91, "timestamp": "01:51:40", "text": "画面。それは良いことでしょうか？私はしません"}, {"type": "subtitle", "time": 6708.55, "timestamp": "01:51:48", "text": "うん、それはおかしいね。私は文字通り"}, {"type": "subtitle", "time": 6711.149, "timestamp": "01:51:51", "text": "黒い画面を前にして。クリックしません"}, {"type": "subtitle", "time": 6715.109, "timestamp": "01:51:55", "text": "音声が届くまで"}, {"type": "subtitle", "time": 6719.109, "timestamp": "01:51:59", "text": "えっと、ゲームが表示されます。はい、表示されました。 5月"}]
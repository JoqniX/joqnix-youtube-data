[{"type": "chat", "time": 5106.769, "timestamp": "01:25:06", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "Keep playing to find out"}, {"type": "chat", "time": 5116.21, "timestamp": "01:25:16", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "No not I think"}, {"type": "subtitle", "time": 5119.229, "timestamp": "01:25:19", "text": "わかった、わかった、そしてもう一度プレイした、"}, {"type": "subtitle", "time": 5121.99, "timestamp": "01:25:21", "text": "何度も何度も。人々は何を気に入ったのか"}, {"type": "subtitle", "time": 5124.43, "timestamp": "01:25:24", "text": "私たちは何をしたの？良い、"}, {"type": "subtitle", "time": 5128.07, "timestamp": "01:25:28", "text": "はい、でもいいえ。でも私たちは本当に"}, {"type": "subtitle", "time": 5129.75, "timestamp": "01:25:29", "text": "切り抜ける必要があったのは、"}, {"type": "subtitle", "time": 5133.189, "timestamp": "01:25:33", "text": "現実にはほとんどの人は何も感じない"}, {"type": "subtitle", "time": 5136.55, "timestamp": "01:25:36", "text": "彼らは広告を見る。症例の48％"}, {"type": "subtitle", "time": 5138.31, "timestamp": "01:25:38", "text": "視聴者はこう感じていると言っています"}, {"type": "subtitle", "time": 5140.31, "timestamp": "01:25:40", "text": "広告の最後には何もありません。そして"}, {"type": "subtitle", "time": 5142.229, "timestamp": "01:25:42", "text": "だから私たちはクリエイティブを選びました"}, {"type": "subtitle", "time": 5145.35, "timestamp": "01:25:45", "text": "賛否両論を巻き起こした。それは大胆な選択だった。"}, {"type": "subtitle", "time": 5147.91, "timestamp": "01:25:47", "text": "そして、我々は見事に世論を二分することに成功した。"}, {"type": "subtitle", "time": 5150.229, "timestamp": "01:25:50", "text": "以下にコメントの例をいくつか示します。誰か"}, {"type": "subtitle", "time": 5152.43, "timestamp": "01:25:52", "text": "f と言います"}, {"type": "subtitle", "time": 5155.27, "timestamp": "01:25:55", "text": "オフ。お願い、お願い、お願いだからこれを止めて"}, {"type": "subtitle", "time": 5158.47, "timestamp": "01:25:58", "text": "広告。彼らはそれを気に入っただろうか？はい、でもいいえ。"}]
[{"type": "subtitle", "time": 14221.83, "timestamp": "03:57:01", "text": "正直カラオケをしたかったんです"}, {"type": "subtitle", "time": 14226.71, "timestamp": "03:57:06", "text": "今日は配信するけど、えっと、"}, {"type": "subtitle", "time": 14229.99, "timestamp": "03:57:09", "text": "今日起こる予期せぬ出来事、"}, {"type": "subtitle", "time": 14234.07, "timestamp": "03:57:14", "text": "えーと、部屋にいる人たちは、"}, {"type": "subtitle", "time": 14236.87, "timestamp": "03:57:16", "text": "労働者とかその他すべて、そして私"}, {"type": "subtitle", "time": 14239.91, "timestamp": "03:57:19", "text": "ますます忙しくなってきた。えっと、私は"}, {"type": "subtitle", "time": 14243.07, "timestamp": "03:57:23", "text": "短い井戸を掘る方が良い"}, {"type": "subtitle", "time": 14245.83, "timestamp": "03:57:25", "text": "配信はしませんが、次回にしましょう。わかった、"}, {"type": "subtitle", "time": 14248.07, "timestamp": "03:57:28", "text": "明日、可能であればコカをします"}, {"type": "subtitle", "time": 14251.11, "timestamp": "03:57:31", "text": "ストリームして、リンクを貼っておきます"}, {"type": "subtitle", "time": 14255.11, "timestamp": "03:57:35", "text": "Twitterで私の3つの色も"}, {"type": "subtitle", "time": 14258.469, "timestamp": "03:57:38", "text": "YouTubeコミュニティの投稿にて。ぜひフォローしてください"}, {"type": "subtitle", "time": 14261.51, "timestamp": "03:57:41", "text": "ええと、確認してみてください。ぜひ貢献してください"}, {"type": "subtitle", "time": 14264.63, "timestamp": "03:57:44", "text": "できれば。今後レビューを行います"}, {"type": "subtitle", "time": 14266.309, "timestamp": "03:57:46", "text": "26日。"}, {"type": "subtitle", "time": 14269.67, "timestamp": "03:57:49", "text": "待って、26日、27日、28日ではなく、金曜日または"}, {"type": "subtitle", "time": 14272.55, "timestamp": "03:57:52", "text": "土曜日。だから、行けるならぜひ来てください。わかった。"}, {"type": "subtitle", "time": 14274.79, "timestamp": "03:57:54", "text": "そしてクリスマス配信は"}, {"type": "subtitle", "time": 14278.75, "timestamp": "03:57:58", "text": "23日か22日の日曜日。"}]
[{"type": "subtitle", "time": 1262.47, "timestamp": "00:21:02", "text": "それは退屈で、すべてが"}, {"type": "subtitle", "time": 1264.99, "timestamp": "00:21:04", "text": "虚無の物と"}, {"type": "subtitle", "time": 1268.83, "timestamp": "00:21:08", "text": "何をすべきか全て"}, {"type": "subtitle", "time": 1272.43, "timestamp": "00:21:12", "text": "では私は何をすべきでしょうか"}, {"type": "subtitle", "time": 1275.51, "timestamp": "00:21:15", "text": "あらゆる可能性に対する解決策を提供しました"}, {"type": "subtitle", "time": 1293.43, "timestamp": "00:21:33", "text": "でも、そう、実は私は以前は"}, {"type": "subtitle", "time": 1296.39, "timestamp": "00:21:36", "text": "フォロータイマーのようなもの、フォローする"}, {"type": "subtitle", "time": 1300.23, "timestamp": "00:21:40", "text": "1分か2分くらいかな"}, {"type": "subtitle", "time": 1303.19, "timestamp": "00:21:43", "text": "そして、すべて。"}, {"type": "subtitle", "time": 1305.59, "timestamp": "00:21:45", "text": "ええと、以前は持っていたんですが、問題は"}, {"type": "subtitle", "time": 1308.789, "timestamp": "00:21:48", "text": "新しい人が私を襲撃するときのように"}, {"type": "subtitle", "time": 1311.43, "timestamp": "00:21:51", "text": "彼らはチャットしたいし、タイプを言いたい"}, {"type": "subtitle", "time": 1313.19, "timestamp": "00:21:53", "text": "襲撃メッセージとか色々あるけど、"}, {"type": "subtitle", "time": 1316.39, "timestamp": "00:21:56", "text": "ra がフォロータイマーであるためできません"}, {"type": "subtitle", "time": 1318.63, "timestamp": "00:21:58", "text": "そうです、1まで待たなければなりません"}]
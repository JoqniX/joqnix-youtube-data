[{"type": "subtitle", "time": 8412.07, "timestamp": "02:20:12", "text": "私はこのゲームをプレイしたことがなく、"}, {"type": "subtitle", "time": 8414.07, "timestamp": "02:20:14", "text": "私はめったにゲームをプレイしないので、好きではありません。"}, {"type": "subtitle", "time": 8416.63, "timestamp": "02:20:16", "text": "私はこれらのことをすべて忘れていました。彼らは来ることができる"}, {"type": "subtitle", "time": 8419.03, "timestamp": "02:20:19", "text": "隅っこから覗き込むように"}, {"type": "subtitle", "time": 8421.59, "timestamp": "02:20:21", "text": "その角度とこの角度のタイプから"}, {"type": "subtitle", "time": 8423.79, "timestamp": "02:20:23", "text": "もの。残り30秒。"}, {"type": "subtitle", "time": 8426.95, "timestamp": "02:20:26", "text": "K. もっとアンレートのゲームをプレイするべきだった、"}, {"type": "subtitle", "time": 8428.95, "timestamp": "02:20:28", "text": "しかし、これはランク戦の配信です。その"}, {"type": "subtitle", "time": 8432.63, "timestamp": "02:20:32", "text": "大丈夫。ランクはどれでも構いません。私たちは"}, {"type": "subtitle", "time": 8435.349, "timestamp": "02:20:35", "text": "ランクを上げて、良いランクを獲得しよう"}, {"type": "subtitle", "time": 8438.79, "timestamp": "02:20:38", "text": "いつか。ええ、そうですね。 TGCをプレイしたい"}, {"type": "subtitle", "time": 8441.75, "timestamp": "02:20:41", "text": "今すぐお買い求めください。おお、"}, {"type": "subtitle", "time": 8443.67, "timestamp": "02:20:43", "text": "残り10秒。彼を殺せ。彼を殺せ。"}, {"type": "subtitle", "time": 8449.07, "timestamp": "02:20:49", "text": "彼。 O. 殺す"}, {"type": "subtitle", "time": 8454.07, "timestamp": "02:20:54", "text": "彼。君ならできるよ。クラッチ。"}, {"type": "subtitle", "time": 8456.87, "timestamp": "02:20:56", "text": "私は死を見たが、私は"}]
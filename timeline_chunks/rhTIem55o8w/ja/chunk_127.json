[{"type": "subtitle", "time": 7624.51, "timestamp": "02:07:04", "text": "終わり。ランディ"}, {"type": "subtitle", "time": 7627.99, "timestamp": "02:07:07", "text": "簡単に。ええ、わかっています。私は"}, {"type": "subtitle", "time": 7630.069, "timestamp": "02:07:10", "text": "真剣さ、ということでしょうね。わからない"}, {"type": "subtitle", "time": 7640.149, "timestamp": "02:07:20", "text": "私は手を置いた方がいいでしょうか？"}, {"type": "subtitle", "time": 7644.069, "timestamp": "02:07:24", "text": "カメラ配信は、まるでフルスリーブの手袋のようだ。"}, {"type": "subtitle", "time": 7647.99, "timestamp": "02:07:27", "text": "準備はできています。それをそのまま使うべきでしょうか"}, {"type": "subtitle", "time": 7651.75, "timestamp": "02:07:31", "text": "私の、えっと、手首の、えっと、あれ？の"}, {"type": "subtitle", "time": 7665.109, "timestamp": "02:07:45", "text": "ああ、シノアが禁止されているって知ってた？"}, {"type": "subtitle", "time": 7667.99, "timestamp": "02:07:47", "text": "ロアクセルを許可しますか？アカウントを取得できません"}, {"type": "subtitle", "time": 7671.27, "timestamp": "02:07:51", "text": "禁止。なぜ？なぜ彼らは許可しないのか"}, {"type": "subtitle", "time": 7673.95, "timestamp": "02:07:53", "text": "ロアクセル？来て。その"}, {"type": "subtitle", "time": 7676.51, "timestamp": "02:07:56", "text": "2025年。"}]
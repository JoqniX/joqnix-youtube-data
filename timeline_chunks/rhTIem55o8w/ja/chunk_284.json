[{"type": "subtitle", "time": 17042.628, "timestamp": "04:44:02", "text": "株式会社ニース。私はそれを学ぶ必要がある。そうします"}, {"type": "subtitle", "time": 17046.03, "timestamp": "04:44:06", "text": "最後にカタナガナの修正があります。"}, {"type": "subtitle", "time": 17048.39, "timestamp": "04:44:08", "text": "わかった。ええ、私たちはそうすべきです"}, {"type": "subtitle", "time": 17063.43, "timestamp": "04:44:23", "text": "お茶。ええと、私の問題はいつもこれなんです。"}, {"type": "subtitle", "time": 17067.19, "timestamp": "04:44:27", "text": "これとこれ。どちらがどちらですか？私はしません"}, {"type": "subtitle", "time": 17070.91, "timestamp": "04:44:30", "text": "それを得る。これはのこぎりですか、それともこれは"}, {"type": "subtitle", "time": 17091.868, "timestamp": "04:44:51", "text": "コント。ああ、コンサート。わかった。これ"}, {"type": "subtitle", "time": 17093.39, "timestamp": "04:44:53", "text": "コンサート。"}, {"type": "subtitle", "time": 17097.19, "timestamp": "04:44:57", "text": "あの、あなたはまだコンサートに行きますか？これ"}, {"type": "subtitle", "time": 17099.708, "timestamp": "04:44:59", "text": "これは"}]
[{"type": "subtitle", "time": 16801.99, "timestamp": "04:40:01", "text": "私の問題用紙は完全に"}, {"type": "subtitle", "time": 16805.628, "timestamp": "04:40:05", "text": "日本語。いいえ。こんにちは、アディ。ようこそ"}, {"type": "subtitle", "time": 16814.99, "timestamp": "04:40:14", "text": "読む。うーん、いやいや"}, {"type": "subtitle", "time": 16828.43, "timestamp": "04:40:28", "text": "えっと、"}, {"type": "subtitle", "time": 16831.27, "timestamp": "04:40:31", "text": "月曜日に病院に行くよ"}, {"type": "subtitle", "time": 16833.23, "timestamp": "04:40:33", "text": "今月の病院"}, {"type": "subtitle", "time": 16836.628, "timestamp": "04:40:36", "text": "月曜日の月角太陽私は知らないけど私は"}, {"type": "subtitle", "time": 16840.628, "timestamp": "04:40:40", "text": "月についてはよくわからない、つまり"}, {"type": "subtitle", "time": 16843.91, "timestamp": "04:40:43", "text": "これは何の漢字ですか、またおっと"}, {"type": "subtitle", "time": 16846.788, "timestamp": "04:40:46", "text": "ああ、忘れてた、えっと、これはえっと、えっと、ミズ"}, {"type": "subtitle", "time": 16855.83, "timestamp": "04:40:55", "text": "ああ、忘れてた。ええと、それは"}, {"type": "subtitle", "time": 16859.23, "timestamp": "04:40:59", "text": "火曜日。何が"}]
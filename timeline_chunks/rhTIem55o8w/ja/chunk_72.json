[{"type": "subtitle", "time": 4320.229, "timestamp": "01:12:00", "text": "子供たち。私は決して、"}, {"type": "subtitle", "time": 4322.79, "timestamp": "01:12:02", "text": "子供のためにそうしたんだ。"}, {"type": "subtitle", "time": 4324.91, "timestamp": "01:12:04", "text": "それをずっと続ける必要がある"}, {"type": "subtitle", "time": 4328.11, "timestamp": "01:12:08", "text": "時間だから私は"}, {"type": "chat", "time": 4334.878, "timestamp": "01:12:14", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "What is that red line?"}, {"type": "subtitle", "time": 4338.11, "timestamp": "01:12:18", "text": "私"}, {"type": "subtitle", "time": 4341.35, "timestamp": "01:12:21", "text": "つまり、18歳以上であっても、"}, {"type": "subtitle", "time": 4345.229, "timestamp": "01:12:25", "text": "18歳以上向けのジョークや、大人向けの内容が好きですか？"}, {"type": "subtitle", "time": 4348.149, "timestamp": "01:12:28", "text": "ここにある物。私はそれを保管しておきたかった"}, {"type": "subtitle", "time": 4349.79, "timestamp": "01:12:29", "text": "健康的"}, {"type": "subtitle", "time": 4353.43, "timestamp": "01:12:33", "text": "可能だ、なぜなら私は厳格なルールに従っているから"}, {"type": "subtitle", "time": 4355.83, "timestamp": "01:12:35", "text": "罵り言葉とかは一切なし。そして"}, {"type": "subtitle", "time": 4358.55, "timestamp": "01:12:38", "text": "時々、私はそれを吐き出す"}, {"type": "subtitle", "time": 4361.75, "timestamp": "01:12:41", "text": "ストレスやその他諸々が心の中に溜まっている。"}, {"type": "subtitle", "time": 4364.11, "timestamp": "01:12:44", "text": "でも実は私は"}, {"type": "subtitle", "time": 4368.149, "timestamp": "01:12:48", "text": "えーっと、そういうことを言わないというルールみたいなもの"}, {"type": "subtitle", "time": 4372.07, "timestamp": "01:12:52", "text": "そして、すでにチャンネルが"}, {"type": "subtitle", "time": 4375.27, "timestamp": "01:12:55", "text": "採用されていると思います。"}, {"type": "subtitle", "time": 4378.63, "timestamp": "01:12:58", "text": "協力者がやって来る 私は好きではない"}]
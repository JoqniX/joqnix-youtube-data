[{"type": "subtitle", "time": 6791.39, "timestamp": "01:53:11", "text": "ゲーム？待って。あなたは"}, {"type": "subtitle", "time": 6793.87, "timestamp": "01:53:13", "text": "ゲーム？なし"}, {"type": "subtitle", "time": 6800.79, "timestamp": "01:53:20", "text": "ハプニング？え、何が起こってるの？いいえ、"}, {"type": "subtitle", "time": 6801.92, "timestamp": "01:53:21", "text": "これは"}, {"type": "subtitle", "time": 6808.83, "timestamp": "01:53:28", "text": "不公平だ。待って、これは"}, {"type": "subtitle", "time": 6810.51, "timestamp": "01:53:30", "text": "不公平だ。"}, {"type": "subtitle", "time": 6812.51, "timestamp": "01:53:32", "text": "なぜ？"}, {"type": "subtitle", "time": 6827.35, "timestamp": "01:53:47", "text": "私はゲームを台無しにしてしまった。私は私の2つのピースが恋しい"}, {"type": "subtitle", "time": 6828.51, "timestamp": "01:53:48", "text": "私は嫌いです"}, {"type": "subtitle", "time": 6832.39, "timestamp": "01:53:52", "text": "これ。人生のこういうところが嫌いだ。 Vライフ。私"}]
[{"type": "subtitle", "time": 15781.229, "timestamp": "04:23:01", "text": "くじはとは"}, {"type": "subtitle", "time": 15783.87, "timestamp": "04:23:03", "text": "午後9時30分"}, {"type": "subtitle", "time": 15789.63, "timestamp": "04:23:09", "text": "9時30分。じゅにじゅんいち。ああ、ジュニ。えっと"}, {"type": "subtitle", "time": 15791.229, "timestamp": "04:23:11", "text": "11"}, {"type": "subtitle", "time": 15796.11, "timestamp": "04:23:16", "text": "水曜日。"}, {"type": "subtitle", "time": 15799.51, "timestamp": "04:23:19", "text": "むよび。待って。スイ。待って待って待って。"}, {"type": "subtitle", "time": 15802.189, "timestamp": "04:23:22", "text": "木は木は"}, {"type": "subtitle", "time": 15805.71, "timestamp": "04:23:25", "text": "これはモクのことですか？"}, {"type": "subtitle", "time": 15812.429, "timestamp": "04:23:32", "text": "木井。それで"}, {"type": "subtitle", "time": 15815.79, "timestamp": "04:23:35", "text": "マクヨビ・マクイは木曜日です。ライチュは"}, {"type": "subtitle", "time": 15818.389, "timestamp": "04:23:38", "text": "来週。これはちょっと変わった例ですね。"}, {"type": "subtitle", "time": 15829.87, "timestamp": "04:23:49", "text": "右"}, {"type": "subtitle", "time": 15832.83, "timestamp": "04:23:52", "text": "金。それで"}, {"type": "subtitle", "time": 15837.189, "timestamp": "04:23:57", "text": "ケニョビ・ケニョビは金曜日です。はい、"}]
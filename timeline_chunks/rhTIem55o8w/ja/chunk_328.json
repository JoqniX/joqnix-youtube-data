[{"type": "subtitle", "time": 19694.708, "timestamp": "05:28:14", "text": "6. 待って、6. ああ、待って。えーと、どうやって"}, {"type": "subtitle", "time": 19701.39, "timestamp": "05:28:21", "text": "6時30分。"}, {"type": "subtitle", "time": 19708.83, "timestamp": "05:28:28", "text": "別名、ああ、それはつまりG"}, {"type": "subtitle", "time": 19713.91, "timestamp": "05:28:33", "text": "Gは、えっと、英語でどう言うんですか？"}, {"type": "subtitle", "time": 19717.788, "timestamp": "05:28:37", "text": "えっと、Gは時間、分みたいなものです。ほんのわずかではない。"}, {"type": "subtitle", "time": 19722.35, "timestamp": "05:28:42", "text": "ホン、それは男だ、これはまるで"}, {"type": "subtitle", "time": 19726.628, "timestamp": "05:28:46", "text": "えっと、こちらはハンですよね。"}, {"type": "subtitle", "time": 19732.03, "timestamp": "05:28:52", "text": "えーと、ルジ・ハン・ハン、私たちはここにこれを書きました"}, {"type": "subtitle", "time": 19735.75, "timestamp": "05:28:55", "text": "思い出す前に、これは私が書いたものです"}, {"type": "subtitle", "time": 19739.15, "timestamp": "05:28:59", "text": "ここはどこにあるの？"}]
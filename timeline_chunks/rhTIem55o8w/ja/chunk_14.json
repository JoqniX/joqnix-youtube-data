[{"type": "subtitle", "time": 841.269, "timestamp": "00:14:01", "text": "1時間、2時間、または3時間かかるかもしれません。"}, {"type": "subtitle", "time": 842.829, "timestamp": "00:14:02", "text": "最大"}, {"type": "subtitle", "time": 846.47, "timestamp": "00:14:06", "text": "家に帰るために"}, {"type": "subtitle", "time": 847.55, "timestamp": "00:14:07", "text": "そして"}, {"type": "subtitle", "time": 850.59, "timestamp": "00:14:10", "text": "すべて。私はしません"}, {"type": "subtitle", "time": 853.11, "timestamp": "00:14:13", "text": "知る。私は彼らに言い訳を与えることはできない"}, {"type": "subtitle", "time": 855.829, "timestamp": "00:14:15", "text": "私はいつも大忙しです。いいえ、私は"}, {"type": "subtitle", "time": 858.47, "timestamp": "00:14:18", "text": "私が何をしているかさえ彼らには伝えていない"}, {"type": "subtitle", "time": 861.509, "timestamp": "00:14:21", "text": "やらなきゃいけないからやってるんだ。私は持っている"}, {"type": "subtitle", "time": 863.55, "timestamp": "00:14:23", "text": "他に選択肢はない"}, {"type": "subtitle", "time": 865.949, "timestamp": "00:14:25", "text": "それと"}, {"type": "subtitle", "time": 868.949, "timestamp": "00:14:28", "text": "すべては、私が言ったように"}, {"type": "subtitle", "time": 873.509, "timestamp": "00:14:33", "text": "すでに一生懸命に取り組んでいるようなもの"}, {"type": "subtitle", "time": 876.629, "timestamp": "00:14:36", "text": "日本は家賃を支払う"}, {"type": "subtitle", "time": 879.67, "timestamp": "00:14:39", "text": "学費とか、その他諸々も。私 私"}, {"type": "subtitle", "time": 881.11, "timestamp": "00:14:41", "text": "最初の6ヶ月はやらなくてもいい"}, {"type": "subtitle", "time": 883.829, "timestamp": "00:14:43", "text": "数ヶ月後、6ヶ月後には、私は"}, {"type": "subtitle", "time": 885.87, "timestamp": "00:14:45", "text": "一生懸命働いて、借金を返済するんだ。"}, {"type": "subtitle", "time": 888.509, "timestamp": "00:14:48", "text": "いいえ。"}, {"type": "subtitle", "time": 892.55, "timestamp": "00:14:52", "text": "右。右。家族に払わせるわけにはいかない"}, {"type": "subtitle", "time": 895.389, "timestamp": "00:14:55", "text": "私の持ち物はいつも、"}]
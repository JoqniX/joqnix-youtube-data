[{"type": "subtitle", "time": 6361.43, "timestamp": "01:46:01", "text": "また？ゲームがクラッシュしたようです。だった"}, {"type": "subtitle", "time": 6364.149, "timestamp": "01:46:04", "text": "簡単な修理をしています。そして自動的に"}, {"type": "subtitle", "time": 6367.35, "timestamp": "01:46:07", "text": "ゲームに復帰させる。もしそれが私に教えてくれたら"}, {"type": "subtitle", "time": 6371.47, "timestamp": "01:46:11", "text": "PCを再起動しなければなりません。"}, {"type": "subtitle", "time": 6374.55, "timestamp": "01:46:14", "text": "ストリームは前回再起動したので"}, {"type": "subtitle", "time": 6378.229, "timestamp": "01:46:18", "text": "ストリームがうまく機能しませんでした。私たちは再び"}, {"type": "subtitle", "time": 6378.83, "timestamp": "01:46:18", "text": "u"}, {"type": "subtitle", "time": 6395.149, "timestamp": "01:46:35", "text": "[音楽]"}, {"type": "subtitle", "time": 6398.87, "timestamp": "01:46:38", "text": "痛みや擦り傷も大丈夫です。"}, {"type": "subtitle", "time": 6400.03, "timestamp": "01:46:40", "text": "クリスマス"}, {"type": "subtitle", "time": 6404.149, "timestamp": "01:46:44", "text": "それで、昨日は、えーと、"}, {"type": "subtitle", "time": 6406.55, "timestamp": "01:46:46", "text": "クリスマスイベントを開催中"}, {"type": "subtitle", "time": 6412.55, "timestamp": "01:46:52", "text": "えっと、それについては投稿します"}, {"type": "subtitle", "time": 6415.91, "timestamp": "01:46:55", "text": "今夜。ええと、今日"}, {"type": "subtitle", "time": 6418.99, "timestamp": "01:46:58", "text": "えっと、ちょっと考えさせてください。"}]
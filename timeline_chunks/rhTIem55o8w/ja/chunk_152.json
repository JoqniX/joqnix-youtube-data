[{"type": "subtitle", "time": 9130.23, "timestamp": "02:32:10", "text": "敵はあと一体。究極の準備完了。"}, {"type": "subtitle", "time": 9132.469, "timestamp": "02:32:12", "text": "スパイクが植えられました。"}, {"type": "subtitle", "time": 9146.389, "timestamp": "02:32:26", "text": "この男に究極の才能があったことを忘れていた。"}, {"type": "subtitle", "time": 9149.91, "timestamp": "02:32:29", "text": "今、この男を倒したのか？"}, {"type": "subtitle", "time": 9153.389, "timestamp": "02:32:33", "text": "立場を変える。"}, {"type": "subtitle", "time": 9168.389, "timestamp": "02:32:48", "text": "ニース。私はそれを拾った。スプライトを選んだ"}, {"type": "subtitle", "time": 9171.59, "timestamp": "02:32:51", "text": "立ち上がってマントに渡した"}, {"type": "subtitle", "time": 9173.67, "timestamp": "02:32:53", "text": "理由。そして彼はそれを手に持っている。彼女は"}]
[{"type": "subtitle", "time": 8886.429, "timestamp": "02:28:06", "text": "ニース。"}, {"type": "subtitle", "time": 8889.99, "timestamp": "02:28:09", "text": "あと少しで彼を捕まえられたのに"}, {"type": "subtitle", "time": 8897.55, "timestamp": "02:28:17", "text": "終わり。ああ、裏切られた"}, {"type": "subtitle", "time": 8900.429, "timestamp": "02:28:20", "text": "自分。頑張れ、パパ。楽しむ。"}, {"type": "subtitle", "time": 8904.51, "timestamp": "02:28:24", "text": "こんにちは。ガムとステディ。持っている"}, {"type": "subtitle", "time": 8913.95, "timestamp": "02:28:33", "text": "運。君は、アスリートのエイムと反動を理解している"}, {"type": "subtitle", "time": 8933.469, "timestamp": "02:28:53", "text": "これ"}]
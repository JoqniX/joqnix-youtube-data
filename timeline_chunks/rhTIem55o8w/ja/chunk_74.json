[{"type": "subtitle", "time": 4441.79, "timestamp": "01:14:01", "text": "その他。そこが赤い線です"}, {"type": "subtitle", "time": 4445.11, "timestamp": "01:14:05", "text": "は。あなたはBの言葉を口にする寸前です"}, {"type": "subtitle", "time": 4454.39, "timestamp": "01:14:14", "text": "何？でも、たとえ私が「B」という言葉を言ったり、"}, {"type": "subtitle", "time": 4457.189, "timestamp": "01:14:17", "text": "それらの言葉はすべて言葉を引き起こし、"}, {"type": "subtitle", "time": 4459.669, "timestamp": "01:14:19", "text": "すべて検閲します。検閲して"}, {"type": "subtitle", "time": 4464.51, "timestamp": "01:14:24", "text": "代替の「uh」という単語を使用する"}, {"type": "subtitle", "time": 4468.87, "timestamp": "01:14:28", "text": "パイナップルか魚か何かみたい"}, {"type": "subtitle", "time": 4472.669, "timestamp": "01:14:32", "text": "あるいは何かのようなもの"}, {"type": "subtitle", "time": 4476.149, "timestamp": "01:14:36", "text": "それ。それが私の検閲方法です。たとえ私が"}, {"type": "chat", "time": 4479.247, "timestamp": "01:14:39", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "I was about to flood you with messages saying EXCUSE YOU ADULT CHILD"}, {"type": "subtitle", "time": 4480.47, "timestamp": "01:14:40", "text": "本当にFワードを言いたい"}, {"type": "subtitle", "time": 4482.83, "timestamp": "01:14:42", "text": "次のように言うでしょう"}, {"type": "subtitle", "time": 4489.73, "timestamp": "01:14:49", "text": "それ。"}, {"type": "subtitle", "time": 4491.149, "timestamp": "01:14:51", "text": "[音楽]"}]
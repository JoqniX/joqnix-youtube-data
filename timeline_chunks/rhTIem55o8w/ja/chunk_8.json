[{"type": "subtitle", "time": 481.589, "timestamp": "00:08:01", "text": "だって、すごく疲れて目が覚めたから、"}, {"type": "subtitle", "time": 486.469, "timestamp": "00:08:06", "text": "疲れ果てた。なぜ不足しているのかわかりません"}, {"type": "subtitle", "time": 488.869, "timestamp": "00:08:08", "text": "ビタミン、カリウム、ナトリウム、私は"}, {"type": "subtitle", "time": 491.189, "timestamp": "00:08:11", "text": "昨日読んだものすべて"}, {"type": "subtitle", "time": 494.629, "timestamp": "00:08:14", "text": "Twitterのツイートで、なぜ目が覚めるのか"}, {"type": "subtitle", "time": 498.07, "timestamp": "00:08:18", "text": "朝からすごく疲れていて、色々だるい。"}, {"type": "subtitle", "time": 501.67, "timestamp": "00:08:21", "text": "はい、ちゃんと食事を摂れていません。はい、違います"}, {"type": "subtitle", "time": 504.23, "timestamp": "00:08:24", "text": "体が追いついていないという問題があり、"}, {"type": "subtitle", "time": 505.629, "timestamp": "00:08:25", "text": "保管しない"}, {"type": "subtitle", "time": 508.309, "timestamp": "00:08:28", "text": "上。そして、私は最善を尽くしたいと思っています"}, {"type": "subtitle", "time": 533.11, "timestamp": "00:08:53", "text": "とにかく、必要なら休んでください。私は知っている"}, {"type": "subtitle", "time": 535.24, "timestamp": "00:08:55", "text": "できた、"}, {"type": "subtitle", "time": 537.71, "timestamp": "00:08:57", "text": "[音楽]"}, {"type": "subtitle", "time": 539.55, "timestamp": "00:08:59", "text": "しかし"}]
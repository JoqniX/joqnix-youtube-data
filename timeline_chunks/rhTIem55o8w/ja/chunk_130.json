[{"type": "subtitle", "time": 7810.91, "timestamp": "02:10:10", "text": "019. くそっ。"}, {"type": "subtitle", "time": 7813.35, "timestamp": "02:10:13", "text": "うん。あなたがグリップを失うことを想像してみてください。"}, {"type": "subtitle", "time": 7815.03, "timestamp": "02:10:15", "text": "奴隷のせいで、ただ彼らを捨てるだけ"}, {"type": "subtitle", "time": 7817.75, "timestamp": "02:10:17", "text": "離れて。待って、それ試してみるべきかな？したい"}, {"type": "subtitle", "time": 7820.709, "timestamp": "02:10:20", "text": "どんな感じか試してみて。ちょっと待って。ください"}, {"type": "subtitle", "time": 7847.03, "timestamp": "02:10:47", "text": "袖。わかった、私は"}, {"type": "subtitle", "time": 7849.35, "timestamp": "02:10:49", "text": "投げろ。よし、感じてみたい。持っている"}, {"type": "subtitle", "time": 7856.99, "timestamp": "02:10:56", "text": "それ。私はそれを投げません。私は感じたい"}]
[{"type": "subtitle", "time": 20113.868, "timestamp": "05:35:13", "text": "今夜新作公開。それで"}, {"type": "subtitle", "time": 20117.948, "timestamp": "05:35:17", "text": "アトラシ・クナイは新しいものではない"}, {"type": "subtitle", "time": 20128.99, "timestamp": "05:35:28", "text": "新しい、私はそれを書くことができます"}, {"type": "subtitle", "time": 20130.14, "timestamp": "05:35:30", "text": "ひらがな"}, {"type": "subtitle", "time": 20131.788, "timestamp": "05:35:31", "text": "[音楽]"}, {"type": "subtitle", "time": 20134.11, "timestamp": "05:35:34", "text": "ああ"}, {"type": "subtitle", "time": 20135.868, "timestamp": "05:35:35", "text": "の"}, {"type": "subtitle", "time": 20138.39, "timestamp": "05:35:38", "text": "ラ・シェ"}, {"type": "subtitle", "time": 20146.59, "timestamp": "05:35:46", "text": "[音楽]"}]
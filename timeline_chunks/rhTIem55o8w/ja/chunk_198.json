[{"type": "subtitle", "time": 11882.389, "timestamp": "03:18:02", "text": "アイデアは、皆さんがメッセージを書けるようにすることです"}, {"type": "subtitle", "time": 11884.389, "timestamp": "03:18:04", "text": "クリスマスプレゼントのように、あるいは"}, {"type": "subtitle", "time": 11886.79, "timestamp": "03:18:06", "text": "クリスマスメッセージでも何でもいいです。書く"}, {"type": "subtitle", "time": 11890.07, "timestamp": "03:18:10", "text": "あなたが望むものなら何でも"}, {"type": "subtitle", "time": 11893.11, "timestamp": "03:18:13", "text": "クリスマスプレゼント。それを次のように考えてみてください"}, {"type": "subtitle", "time": 11896.55, "timestamp": "03:18:16", "text": "私の誕生日配信で皆さんがしてくれたこと、"}, {"type": "subtitle", "time": 11900.07, "timestamp": "03:18:20", "text": "誕生日メッセージみたいな書き方だよね？"}, {"type": "subtitle", "time": 11903.03, "timestamp": "03:18:23", "text": "まさにその通り。自分で書くこともできます"}, {"type": "subtitle", "time": 11904.429, "timestamp": "03:18:24", "text": "もしあなたが願うなら"}, {"type": "subtitle", "time": 11905.95, "timestamp": "03:18:25", "text": "欲しい"}, {"type": "subtitle", "time": 11909.429, "timestamp": "03:18:29", "text": "何でも。何も書かないでください"}, {"type": "subtitle", "time": 11911.75, "timestamp": "03:18:31", "text": "気味が悪いよね？または、悪い内容は書かないでください"}, {"type": "subtitle", "time": 11915.75, "timestamp": "03:18:35", "text": "いいですか？でも自分で書いてみて"}, {"type": "subtitle", "time": 11919.99, "timestamp": "03:18:39", "text": "よろしければ、お望みください。そして私はこうしました"}, {"type": "subtitle", "time": 11922.15, "timestamp": "03:18:42", "text": "誰でも"}, {"type": "subtitle", "time": 11926.11, "timestamp": "03:18:46", "text": "えーと、誰でも書けるように作ったんだ"}, {"type": "subtitle", "time": 11931.91, "timestamp": "03:18:51", "text": "えっと、リンクって何でしたっけ？病気"}, {"type": "subtitle", "time": 11934.309, "timestamp": "03:18:54", "text": "このライブ配信のように、現在の投稿に投稿してください"}, {"type": "subtitle", "time": 11937.349, "timestamp": "03:18:57", "text": "チャット。じゃあ、明日投稿します。"}, {"type": "subtitle", "time": 11939.91, "timestamp": "03:18:59", "text": "今夜投稿します"}]
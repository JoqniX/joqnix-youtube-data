[{"type": "subtitle", "time": 14701.229, "timestamp": "04:05:01", "text": "実際に"}, {"type": "subtitle", "time": 14710.389, "timestamp": "04:05:10", "text": "安定した。こんにちは。それで、えーと、開始前に"}, {"type": "subtitle", "time": 14712.63, "timestamp": "04:05:12", "text": "ストリームについて、はっきりさせておきたい"}, {"type": "subtitle", "time": 14715.349, "timestamp": "04:05:15", "text": "著作権侵害の警告を受ける前に"}, {"type": "subtitle", "time": 14717.269, "timestamp": "04:05:17", "text": "チャンネル、私は二度目の警告は望んでいません。"}, {"type": "subtitle", "time": 14719.309, "timestamp": "04:05:19", "text": "お願いです、お願いします"}, {"type": "subtitle", "time": 14724.309, "timestamp": "04:05:24", "text": "あなた。ぜひ彼に加わってください。だから、私が"}, {"type": "subtitle", "time": 14726.15, "timestamp": "04:05:26", "text": "ストリームをやるよ、ただこれを切り抜きたいだけなんだ"}, {"type": "subtitle", "time": 14729.349, "timestamp": "04:05:29", "text": "ポイント。著作権侵害の警告を受けた場合"}, {"type": "subtitle", "time": 14733.11, "timestamp": "04:05:33", "text": "ストライキなので、私はこれを不服申し立てします。"}, {"type": "subtitle", "time": 14735.59, "timestamp": "04:05:35", "text": "説明文には、クレジットを記載しました"}, {"type": "subtitle", "time": 14737.349, "timestamp": "04:05:37", "text": "使用される材料"}, {"type": "subtitle", "time": 14739.67, "timestamp": "04:05:39", "text": "今日の配信。えっと、私たちは勉強します"}, {"type": "subtitle", "time": 14743.75, "timestamp": "04:05:43", "text": "『まるごと教科書 A1 えーりかい』より"}, {"type": "subtitle", "time": 14746.51, "timestamp": "04:05:46", "text": "教科書とPDF"}, {"type": "subtitle", "time": 14749.429, "timestamp": "04:05:49", "text": "Marugtoの公式ウェブサイトで入手可能です。"}, {"type": "subtitle", "time": 14751.11, "timestamp": "04:05:51", "text": "Webサイト。学びたい人は誰でも"}, {"type": "subtitle", "time": 14754.03, "timestamp": "04:05:54", "text": "日本語を学ぶことをお勧めします"}, {"type": "subtitle", "time": 14756.63, "timestamp": "04:05:56", "text": "丸賀人は好きで、これは良い"}, {"type": "subtitle", "time": 14758.71, "timestamp": "04:05:58", "text": "日本に行くのが好きな人たち"}]
[{"type": "subtitle", "time": 6722.149, "timestamp": "01:52:02", "text": "クリックしますか？待って、待って、待って。私は私は"}, {"type": "subtitle", "time": 6732.229, "timestamp": "01:52:12", "text": "どうか終わらせないでください。終わらせないでください。"}, {"type": "subtitle", "time": 6735.189, "timestamp": "01:52:15", "text": "終わらせないでください。君は欲しくない"}, {"type": "subtitle", "time": 6741.229, "timestamp": "01:52:21", "text": "[音楽]"}, {"type": "subtitle", "time": 6745.109, "timestamp": "01:52:25", "text": "終わり。ああ、全部タブで区切るべきじゃなかった。"}, {"type": "subtitle", "time": 6747.47, "timestamp": "01:52:27", "text": "いいえ、それは"}, {"type": "subtitle", "time": 6751.669, "timestamp": "01:52:31", "text": "お願いします。わかった。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 6754.229, "timestamp": "01:52:34", "text": "わかった。わかった。わかった。わかった。わかった。ショーショー"}, {"type": "subtitle", "time": 6759.189, "timestamp": "01:52:39", "text": "上。姿を現せ。姿を現せ。姿を現せ。来て。"}, {"type": "subtitle", "time": 6761.75, "timestamp": "01:52:41", "text": "君ならできるよ。"}, {"type": "subtitle", "time": 6765.43, "timestamp": "01:52:45", "text": "なぜ電源が入っているのですか？どこ？年末"}, {"type": "subtitle", "time": 6767.79, "timestamp": "01:52:47", "text": "合格。何？何が"}, {"type": "subtitle", "time": 6773.55, "timestamp": "01:52:53", "text": "これ？私は遅れているのでしょうか？いいえ。そうです。わかった。"}]
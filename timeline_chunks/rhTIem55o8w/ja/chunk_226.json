[{"type": "subtitle", "time": 13562.229, "timestamp": "03:46:02", "text": "もっと多くのことを成し遂げた。ええ、でも私が思うのは"}, {"type": "subtitle", "time": 13565.15, "timestamp": "03:46:05", "text": "今年思い出せる"}, {"type": "subtitle", "time": 13569.71, "timestamp": "03:46:09", "text": "基本的にはそれらの長い"}, {"type": "subtitle", "time": 13572.99, "timestamp": "03:46:12", "text": "ストリームですよね？"}, {"type": "subtitle", "time": 13575.79, "timestamp": "03:46:15", "text": "ああ、長いやつ"}, {"type": "subtitle", "time": 13578.269, "timestamp": "03:46:18", "text": "ストリーム。"}, {"type": "subtitle", "time": 13582.15, "timestamp": "03:46:22", "text": "そう、12時間配信だよ。ああ、私はどうですか"}, {"type": "subtitle", "time": 13584.229, "timestamp": "03:46:24", "text": "そんなことするの？私にもわからない。のように"}, {"type": "subtitle", "time": 13587.71, "timestamp": "03:46:27", "text": "今では自分がどうやって生きているのかさえわからない"}, {"type": "subtitle", "time": 13590.71, "timestamp": "03:46:30", "text": "実行中。振り返ってみると、"}, {"type": "subtitle", "time": 13592.429, "timestamp": "03:46:32", "text": "私の出来はどうでしたか？"}, {"type": "subtitle", "time": 13596.349, "timestamp": "03:46:36", "text": "それ？どうやってできたのか"}, {"type": "subtitle", "time": 13599.67, "timestamp": "03:46:39", "text": "それ？最近は、"}, {"type": "subtitle", "time": 13602.83, "timestamp": "03:46:42", "text": "3時間または2時間"}, {"type": "subtitle", "time": 13608.99, "timestamp": "03:46:48", "text": "うん。うん。"}, {"type": "subtitle", "time": 13612.07, "timestamp": "03:46:52", "text": "さよなら。 YouTubeを見てみましょう。確認方法は？"}, {"type": "subtitle", "time": 13614.389, "timestamp": "03:46:54", "text": "YouTube？"}, {"type": "subtitle", "time": 13617.36, "timestamp": "03:46:57", "text": "私はこれを知っていると思います"}, {"type": "subtitle", "time": 13618.429, "timestamp": "03:46:58", "text": "[音楽]"}]
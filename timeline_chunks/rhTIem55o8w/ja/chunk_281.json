[{"type": "subtitle", "time": 16862.39, "timestamp": "04:41:02", "text": "いや、いや、火曜日じゃないよ。ええと、水曜日。"}, {"type": "subtitle", "time": 16872.67, "timestamp": "04:41:12", "text": "[音楽]"}, {"type": "subtitle", "time": 16874.43, "timestamp": "04:41:14", "text": "に"}, {"type": "subtitle", "time": 16882.43, "timestamp": "04:41:22", "text": "テニス。"}, {"type": "subtitle", "time": 16895.67, "timestamp": "04:41:35", "text": "私は自分が何をしているのかを実際に理解する必要がある"}, {"type": "subtitle", "time": 16897.99, "timestamp": "04:41:37", "text": "心の中で読んでから声に出して読む"}, {"type": "subtitle", "time": 16901.03, "timestamp": "04:41:41", "text": "声を出して、えーと練習する必要がある"}, {"type": "subtitle", "time": 16903.628, "timestamp": "04:41:43", "text": "読書好きの男性。"}, {"type": "subtitle", "time": 16906.27, "timestamp": "04:41:46", "text": "神"}, {"type": "subtitle", "time": 16907.948, "timestamp": "04:41:47", "text": "トアダチ"}, {"type": "subtitle", "time": 16912.43, "timestamp": "04:41:52", "text": "シュウ・シマシュウジ・クッキング"}, {"type": "subtitle", "time": 16915.67, "timestamp": "04:41:55", "text": "トモダチ。ああ、目を開けなきゃ"}]
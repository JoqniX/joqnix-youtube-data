[{"type": "subtitle", "time": 18783.51, "timestamp": "05:13:03", "text": "近日公開。ああ、もちろんそうはならないよ"}, {"type": "subtitle", "time": 18785.35, "timestamp": "05:13:05", "text": "英語訳は次のようになります。あなた"}, {"type": "subtitle", "time": 18789.07, "timestamp": "05:13:09", "text": "ダミー。これを読まなければならない"}, {"type": "subtitle", "time": 18801.35, "timestamp": "05:13:21", "text": "来週にはすぐに戻ってきます。わかった。それで"}, {"type": "subtitle", "time": 18812.15, "timestamp": "05:13:32", "text": "鍵は1つ。わかった。おお。わかった。こちらです。えっと"}, {"type": "subtitle", "time": 18815.15, "timestamp": "05:13:35", "text": "ということで、えーと、友達"}, {"type": "subtitle", "time": 18817.5, "timestamp": "05:13:37", "text": "三つ"}, {"type": "subtitle", "time": 18825.708, "timestamp": "05:13:45", "text": "3つはいつ"}, {"type": "subtitle", "time": 18830.65, "timestamp": "05:13:50", "text": "えーと、金曜日のコンサート"}, {"type": "subtitle", "time": 18831.788, "timestamp": "05:13:51", "text": "[音楽]"}, {"type": "subtitle", "time": 18835.75, "timestamp": "05:13:55", "text": "2 そしてキョウギは"}]
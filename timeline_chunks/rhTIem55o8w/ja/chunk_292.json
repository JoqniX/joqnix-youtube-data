[{"type": "subtitle", "time": 17524.4, "timestamp": "04:52:04", "text": "漢字。こんにちは、カサン。やりましょう。"}, {"type": "subtitle", "time": 17547.27, "timestamp": "04:52:27", "text": "10 サンジの母7 彼女はサンジと言った"}, {"type": "subtitle", "time": 17550.59, "timestamp": "04:52:30", "text": "そうだよねサンジ、息子"}, {"type": "subtitle", "time": 17563.43, "timestamp": "04:52:43", "text": "よし、漢字の書き方を学ばなければならないし"}, {"type": "subtitle", "time": 17573.07, "timestamp": "04:52:53", "text": "ええ、３つです。"}, {"type": "subtitle", "time": 17576.23, "timestamp": "04:52:56", "text": "うん。私の文章の書き方は本当にひどい。"}]
[{"type": "subtitle", "time": 1503.71, "timestamp": "00:25:03", "text": "また何かプロが"}, {"type": "subtitle", "time": 1506.63, "timestamp": "00:25:06", "text": "サミー、私が何をしようとしているか、君は分かっているだろう"}, {"type": "subtitle", "time": 1510.47, "timestamp": "00:25:10", "text": "今日。私は気にしない。もう終わりだ。"}, {"type": "subtitle", "time": 1513.35, "timestamp": "00:25:13", "text": "私がそれを運びます。私"}, {"type": "subtitle", "time": 1516.47, "timestamp": "00:25:16", "text": "あまり頼りすぎることはできないと思う"}, {"type": "subtitle", "time": 1518.549, "timestamp": "00:25:18", "text": "ストリーマーモードでは、ストリーマーモードでは"}, {"type": "subtitle", "time": 1521.35, "timestamp": "00:25:21", "text": "死んだり、そういうこと。さらに、私は"}, {"type": "subtitle", "time": 1526.39, "timestamp": "00:25:26", "text": "その他、ミックスイットアップなどのもの"}, {"type": "subtitle", "time": 1528.789, "timestamp": "00:25:28", "text": "それとサミーとか。だから、それらを使うことにします"}, {"type": "subtitle", "time": 1530.99, "timestamp": "00:25:30", "text": "のために"}, {"type": "subtitle", "time": 1533.669, "timestamp": "00:25:33", "text": "なぜなら、一部の人々は愚かだからだ。そこには"}, {"type": "subtitle", "time": 1536.87, "timestamp": "00:25:36", "text": "特に理由はない。それは本当だ。本当に欲しい"}, {"type": "subtitle", "time": 1539.669, "timestamp": "00:25:39", "text": "殺人犯が殺人を犯した理由"}, {"type": "subtitle", "time": 1542.23, "timestamp": "00:25:42", "text": "誰か？ありません。"}, {"type": "subtitle", "time": 1553.549, "timestamp": "00:25:53", "text": "神。"}, {"type": "subtitle", "time": 1557.63, "timestamp": "00:25:57", "text": "えっと、でも問題は、問題は見ていないということです"}]
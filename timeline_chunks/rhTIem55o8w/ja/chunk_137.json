[{"type": "subtitle", "time": 8237.03, "timestamp": "02:17:17", "text": "なぜみんななのか？なぜ私たちは皆、感動できないのだろうか？"}, {"type": "subtitle", "time": 8238.27, "timestamp": "02:17:18", "text": "1つ"}, {"type": "subtitle", "time": 8242.07, "timestamp": "02:17:22", "text": "2番。なぜ誰もがそうしなければならないのか"}, {"type": "subtitle", "time": 8245.07, "timestamp": "02:17:25", "text": "誰もがより良い狙いを持っている"}, {"type": "subtitle", "time": 8266.72, "timestamp": "02:17:46", "text": "一種の"}, {"type": "subtitle", "time": 8269.389, "timestamp": "02:17:49", "text": "[音楽]"}, {"type": "subtitle", "time": 8277.75, "timestamp": "02:17:57", "text": "ああ、なんてことだ、彼は彼をとても高くフラッシュした。"}]
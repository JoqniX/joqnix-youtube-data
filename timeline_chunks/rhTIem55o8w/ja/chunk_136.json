[{"type": "subtitle", "time": 8161.31, "timestamp": "02:16:01", "text": "トグル？"}, {"type": "subtitle", "time": 8164.95, "timestamp": "02:16:04", "text": "あー、それはトグルスイッチです。それが理由です。わかった、"}, {"type": "subtitle", "time": 8187.27, "timestamp": "02:16:27", "text": "外。行け！行け！行け。"}, {"type": "subtitle", "time": 8189.39, "timestamp": "02:16:29", "text": "銃をありがとう。それは"}, {"type": "subtitle", "time": 8193.589, "timestamp": "02:16:33", "text": "つまり敵だ。 A"}, {"type": "subtitle", "time": 8216.23, "timestamp": "02:16:56", "text": "ラスター、このガキめ。"}, {"type": "subtitle", "time": 8218.389, "timestamp": "02:16:58", "text": "誰かがそこにいるだろうと分かっていたし、"}, {"type": "subtitle", "time": 8219.87, "timestamp": "02:16:59", "text": "手に入れた"}]
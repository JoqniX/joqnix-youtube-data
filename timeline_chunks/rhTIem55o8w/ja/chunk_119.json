[{"type": "subtitle", "time": 7141.229, "timestamp": "01:59:01", "text": "ゾーンに入る、ゾーンに入る"}, {"type": "subtitle", "time": 7145.03, "timestamp": "01:59:05", "text": "気分。わかった。私の"}, {"type": "subtitle", "time": 7146.589, "timestamp": "01:59:06", "text": "えっと、私の"}, {"type": "subtitle", "time": 7160.109, "timestamp": "01:59:20", "text": "それ。まさに顔面に。はぁ？"}, {"type": "subtitle", "time": 7171.83, "timestamp": "01:59:31", "text": "右。私は自制心を忘れてしまった。私は忘れました"}, {"type": "subtitle", "time": 7180.589, "timestamp": "01:59:40", "text": "ああ、あれは何だ？ピング1つ。"}, {"type": "subtitle", "time": 7189.109, "timestamp": "01:59:49", "text": "でも、私は切り替えるのをやめなければならない"}]
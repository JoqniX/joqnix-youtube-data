[{"type": "subtitle", "time": 15180.52, "timestamp": "04:13:00", "text": "今日は時間が限られています。 こんにちは。そして、それを行う前に、"}, {"type": "subtitle", "time": 15183.52, "timestamp": "04:13:03", "text": "こんにちは。そして、それを行う前に、 これは"}, {"type": "subtitle", "time": 15185.399, "timestamp": "04:13:05", "text": "これは 側。"}, {"type": "subtitle", "time": 15187.56, "timestamp": "04:13:07", "text": "側。 あぁ、こんにちは、あぁ、こんにちは、フリン。こんにちは、シア。こんにちは"}, {"type": "subtitle", "time": 15191.68, "timestamp": "04:13:11", "text": "あぁ、こんにちは、あぁ、こんにちは、フリン。こんにちは、シア。こんにちは マ。"}, {"type": "subtitle", "time": 15197.99, "timestamp": "04:13:17", "text": "いらっしゃいませ。だから今日は"}, {"type": "subtitle", "time": 15200.59, "timestamp": "04:13:20", "text": "今日の配信は著作権侵害の警告を受けません"}, {"type": "subtitle", "time": 15203.91, "timestamp": "04:13:23", "text": "著作権で保護されています。お願いです、主よ"}, {"type": "subtitle", "time": 15211.11, "timestamp": "04:13:31", "text": "さあ、飛び跳ねましょう。わかった。私はそうは思わない"}, {"type": "subtitle", "time": 15214.87, "timestamp": "04:13:34", "text": "正直に言うと、私は懇願して祈る"}, {"type": "subtitle", "time": 15217.51, "timestamp": "04:13:37", "text": "これはいらない。私たちはただ"}, {"type": "subtitle", "time": 15219.99, "timestamp": "04:13:39", "text": "これ。私たちは共に学んでいます。わかった。"}, {"type": "subtitle", "time": 15223.11, "timestamp": "04:13:43", "text": "来て。少し余裕を持たせよう。私はしません"}, {"type": "subtitle", "time": 15225.67, "timestamp": "04:13:45", "text": "私のチャンネルに著作権侵害の申し立てをしてほしい。私は負けるだろう"}, {"type": "subtitle", "time": 15226.59, "timestamp": "04:13:46", "text": "私の"}, {"type": "subtitle", "time": 15229.11, "timestamp": "04:13:49", "text": "チャネル。私は心の中で死んでしまうだろう。知っている。私は"}, {"type": "subtitle", "time": 15229.79, "timestamp": "04:13:49", "text": "ただ"}, {"type": "subtitle", "time": 15233.149, "timestamp": "04:13:53", "text": "冗談だよ。とにかく、えっと"}, {"type": "subtitle", "time": 15237.429, "timestamp": "04:13:57", "text": "こんにちは。ああ、もし私が行けたらどんなに素晴らしいだろう。私は泣くでしょう、"}]
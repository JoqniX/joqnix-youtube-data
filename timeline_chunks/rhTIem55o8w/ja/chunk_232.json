[{"type": "subtitle", "time": 13929.01, "timestamp": "03:52:09", "text": "指輪。"}, {"type": "subtitle", "time": 13930.51, "timestamp": "03:52:10", "text": "[音楽]"}, {"type": "subtitle", "time": 13933.87, "timestamp": "03:52:13", "text": "つまり、海賊の"}, {"type": "subtitle", "time": 13941.95, "timestamp": "03:52:21", "text": "[音楽]"}, {"type": "subtitle", "time": 13955.71, "timestamp": "03:52:35", "text": "チャット"}, {"type": "subtitle", "time": 13959.55, "timestamp": "03:52:39", "text": "耳。プラグを抜いて、また差し込んでください"}, {"type": "subtitle", "time": 13965.59, "timestamp": "03:52:45", "text": "良い。良い年でした。よくやった。 Gy WP。"}, {"type": "subtitle", "time": 13978.55, "timestamp": "03:52:58", "text": "要約。私たちはそうするとは思っていませんでした"}]
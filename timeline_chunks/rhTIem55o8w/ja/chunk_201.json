[{"type": "subtitle", "time": 12061.55, "timestamp": "03:21:01", "text": "えっと、明日考えていたんだけど"}, {"type": "subtitle", "time": 12064.349, "timestamp": "03:21:04", "text": "何と呼ぶのか"}, {"type": "subtitle", "time": 12072.309, "timestamp": "03:21:12", "text": "クリスマス配信。待って、やるべきかな？"}, {"type": "subtitle", "time": 12076.15, "timestamp": "03:21:16", "text": "日曜日に？待って、わからない。えっと、私は"}, {"type": "subtitle", "time": 12078.11, "timestamp": "03:21:18", "text": "私たちならできると思う"}, {"type": "subtitle", "time": 12081.429, "timestamp": "03:21:21", "text": "明日、金曜日、クリスマスカットのように"}, {"type": "subtitle", "time": 12084.349, "timestamp": "03:21:24", "text": "ストリーム。だから、もしあなたが歌を持っているなら"}, {"type": "subtitle", "time": 12088.15, "timestamp": "03:21:28", "text": "リクエストがあれば、私にも知らせてください。"}, {"type": "subtitle", "time": 12090.99, "timestamp": "03:21:30", "text": "準備し、学ぶ。ああ、もしかしたらやるかもしれないね"}, {"type": "subtitle", "time": 12094.269, "timestamp": "03:21:34", "text": "日曜日に。しかし"}, {"type": "subtitle", "time": 12097.03, "timestamp": "03:21:37", "text": "日曜日、ああ、これはとてもややこしい。私の"}, {"type": "subtitle", "time": 12098.429, "timestamp": "03:21:38", "text": "スケジュールは"}, {"type": "subtitle", "time": 12103.349, "timestamp": "03:21:43", "text": "悪い。えっと、23日か24日には出発します。私"}, {"type": "subtitle", "time": 12105.59, "timestamp": "03:21:45", "text": "たぶん24番街にあると思う。"}, {"type": "subtitle", "time": 12110.19, "timestamp": "03:21:50", "text": "うん。だから、もし私が23位を無料で獲得したら"}, {"type": "subtitle", "time": 12119.99, "timestamp": "03:21:59", "text": "えーと、もし私が24を手に入れたら、もし私が"}]
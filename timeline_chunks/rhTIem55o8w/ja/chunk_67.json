[{"type": "subtitle", "time": 4020.87, "timestamp": "01:07:00", "text": "荒らし。その人がそう思っていなくても"}, {"type": "subtitle", "time": 4022.87, "timestamp": "01:07:02", "text": "私がこれを始めてからもう"}, {"type": "subtitle", "time": 4027.19, "timestamp": "01:07:07", "text": "1、2ヶ月間ストリーミング配信をしていた"}, {"type": "subtitle", "time": 4034.789, "timestamp": "01:07:14", "text": "数時間の間は、人々は何でも言える。いいえ、それは"}, {"type": "subtitle", "time": 4038.47, "timestamp": "01:07:18", "text": "最悪なインターネット。"}, {"type": "subtitle", "time": 4042.15, "timestamp": "01:07:22", "text": "そして、私は方法を考えようと思っています"}, {"type": "chat", "time": 4042.384, "timestamp": "01:07:22", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "I. DON’T. CARE"}, {"type": "subtitle", "time": 4045.19, "timestamp": "01:07:25", "text": "人々がただ言うのを止める"}, {"type": "subtitle", "time": 4047.67, "timestamp": "01:07:27", "text": "彼らが望むことや実際に実行したいことは"}, {"type": "subtitle", "time": 4049.309, "timestamp": "01:07:29", "text": "ルールが増えました。"}, {"type": "chat", "time": 4051.476, "timestamp": "01:07:31", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "YOU NEED SLEEP? YOU GO SLEEP"}, {"type": "subtitle", "time": 4052.63, "timestamp": "01:07:32", "text": "それに、今の人たちは"}, {"type": "subtitle", "time": 4054.23, "timestamp": "01:07:34", "text": "TwitchもYouTubeも同じ"}, {"type": "subtitle", "time": 4057.67, "timestamp": "01:07:37", "text": "新しい人が来てサブになるとき、"}, {"type": "subtitle", "time": 4060.47, "timestamp": "01:07:40", "text": "入力するには購読またはフォローする必要があります"}, {"type": "chat", "time": 4060.684, "timestamp": "01:07:40", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "YOU SLEEP WHEN YOU WANT."}, {"type": "subtitle", "time": 4063.99, "timestamp": "01:07:43", "text": "チャットでは、ルールを読まない"}, {"type": "subtitle", "time": 4073.47, "timestamp": "01:07:53", "text": "それについては、1つあります"}, {"type": "subtitle", "time": 4076.23, "timestamp": "01:07:56", "text": "10点くらいつけるべきかなって思うんだけど"}, {"type": "chat", "time": 4076.241, "timestamp": "01:07:56", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "why not put that thing"}, {"type": "subtitle", "time": 4078.63, "timestamp": "01:07:58", "text": "分または5分カウンター"}]
[{"type": "subtitle", "time": 8839.99, "timestamp": "02:27:19", "text": "私はここから出て行く。"}, {"type": "subtitle", "time": 8846.309, "timestamp": "02:27:26", "text": "下。"}, {"type": "subtitle", "time": 8848.23, "timestamp": "02:27:28", "text": "少し時間がかかるだろう。はい。はい。はい。"}, {"type": "subtitle", "time": 8850.79, "timestamp": "02:27:30", "text": "はい。はい。もうすぐなくなる。数時間かかる"}, {"type": "subtitle", "time": 8853.83, "timestamp": "02:27:33", "text": "試合。うん。"}, {"type": "subtitle", "time": 8857.99, "timestamp": "02:27:37", "text": "回復部隊を救え。ありがとう。"}, {"type": "subtitle", "time": 8869.51, "timestamp": "02:27:49", "text": "[音楽]"}]
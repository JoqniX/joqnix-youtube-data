[{"type": "subtitle", "time": 2827.349, "timestamp": "00:47:07", "text": "先のことは考えないで。私はすでに考えていた"}, {"type": "subtitle", "time": 2829.47, "timestamp": "00:47:09", "text": "はるか前方に"}, {"type": "subtitle", "time": 2831.55, "timestamp": "00:47:11", "text": "それ。"}, {"type": "chat", "time": 2831.996, "timestamp": "00:47:11", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "tch tch, why u saying sry haiyaa"}, {"type": "subtitle", "time": 2835.91, "timestamp": "00:47:15", "text": "ほら、日本にいるときは、"}, {"type": "subtitle", "time": 2838.95, "timestamp": "00:47:18", "text": "2年コース、1年、21年コース、"}, {"type": "subtitle", "time": 2840.829, "timestamp": "00:47:20", "text": "右？一度私が"}, {"type": "subtitle", "time": 2846.75, "timestamp": "00:47:26", "text": "無料。自由になったら、"}, {"type": "subtitle", "time": 2849.51, "timestamp": "00:47:29", "text": "無料。私はこういうことをするつもりです"}, {"type": "subtitle", "time": 2851.15, "timestamp": "00:47:31", "text": "から"}, {"type": "subtitle", "time": 2854.15, "timestamp": "00:47:34", "text": "慈善団体に寄付したいからそこに行った"}, {"type": "chat", "time": 2855.314, "timestamp": "00:47:35", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "just like u thought far ahead, in weeks, to fix yr sleeping?"}, {"type": "subtitle", "time": 2857.349, "timestamp": "00:47:37", "text": "そして、あらゆるもの、あらゆるもの。わかった。私"}, {"type": "subtitle", "time": 2860.309, "timestamp": "00:47:40", "text": "私はそれをするにはあまりにも利己的だったと分かっている"}, {"type": "subtitle", "time": 2864.23, "timestamp": "00:47:44", "text": "自分のモデルとか色々のためのジョッカソンだけど"}, {"type": "subtitle", "time": 2868.069, "timestamp": "00:47:48", "text": "最初の夢のように実現したい"}, {"type": "subtitle", "time": 2871.43, "timestamp": "00:47:51", "text": "私の目標は、実際に私が"}, {"type": "subtitle", "time": 2873.51, "timestamp": "00:47:53", "text": "これ
[{"type": "subtitle", "time": 17220.628, "timestamp": "04:47:00", "text": "これは私が読むのに苦労したことです"}, {"type": "subtitle", "time": 17222.43, "timestamp": "04:47:02", "text": "今日の授業で"}, {"type": "subtitle", "time": 17225.11, "timestamp": "04:47:05", "text": "朝。しかし先生はすべてを奪った"}, {"type": "subtitle", "time": 17228.07, "timestamp": "04:47:08", "text": "また。だから、漢字と"}, {"type": "subtitle", "time": 17231.19, "timestamp": "04:47:11", "text": "すべて。だから、今ようやく理解できた。それで"}, {"type": "subtitle", "time": 17234.27, "timestamp": "04:47:14", "text": "これはつまり"}, {"type": "subtitle", "time": 17238.39, "timestamp": "04:47:18", "text": "ああ、まさにそうだ、ああ、ああ、なぜか忘れた"}, {"type": "subtitle", "time": 17240.868, "timestamp": "04:47:20", "text": "説明しているけど、君たちにも"}, {"type": "subtitle", "time": 17243.51, "timestamp": "04:47:23", "text": "読むことも理解することも、その一つです。"}, {"type": "subtitle", "time": 17246.99, "timestamp": "04:47:26", "text": "私が読んでいるもの"}, {"type": "subtitle", "time": 17249.15, "timestamp": "04:47:29", "text": "ひっ"}, {"type": "subtitle", "time": 17252.47, "timestamp": "04:47:32", "text": "とにかくこれはつまり、えっと、私はただ言うだけです"}, {"type": "subtitle", "time": 17262.708, "timestamp": "04:47:42", "text": "つまり、私は月曜日から仕事に行くということです"}, {"type": "subtitle", "time": 17264.55, "timestamp": "04:47:44", "text": "金曜日"}, {"type": "subtitle", "time": 17268.628, "timestamp": "04:47:48", "text": "えーと、その会社で働くために、そしてその会社で、えーと"}, {"type": "subtitle", "time": 17269.948, "timestamp": "04:47:49", "text": "開始"}, {"type": "subtitle", "time": 17273.628, "timestamp": "04:47:53", "text": "会社Uナン"}, {"type": "subtitle", "time": 17277.19, "timestamp": "04:47:57", "text": "えっと、あなたは生きていますか？それとも死んでいますか？私は生きている。"}]
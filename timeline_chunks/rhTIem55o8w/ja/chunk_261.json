[{"type": "subtitle", "time": 15662.79, "timestamp": "04:21:02", "text": "右？文字通り、あなたは買うことができます"}, {"type": "subtitle", "time": 15664.55, "timestamp": "04:21:04", "text": "教科書はこちらです。いいえ、つまり、あなたは"}, {"type": "subtitle", "time": 15668.349, "timestamp": "04:21:08", "text": "教科書はこちらからダウンロードしてください。"}, {"type": "subtitle", "time": 15681.67, "timestamp": "04:21:21", "text": "お願いします。待って、うまくいくといいんだけど。"}, {"type": "subtitle", "time": 15687.149, "timestamp": "04:21:27", "text": "うん。とにかく、こんにちは、ルオ・ニョビ。ノビとして"}, {"type": "subtitle", "time": 15691.269, "timestamp": "04:21:31", "text": "もう一度待つ。ノビノビサンデーノビ。私"}, {"type": "subtitle", "time": 15693.83, "timestamp": "04:21:33", "text": "日付も修正する必要がある。ああ、私は"}, {"type": "subtitle", "time": 15695.87, "timestamp": "04:21:35", "text": "今日はオフラインで苦戦しました"}, {"type": "subtitle", "time": 15698.11, "timestamp": "04:21:38", "text": "クラス。ああ、来るよ"}, {"type": "subtitle", "time": 15703.269, "timestamp": "04:21:43", "text": "日曜日の膝、えっと、場所、えっと、膝は何だったか"}, {"type": "subtitle", "time": 15707.67, "timestamp": "04:21:47", "text": "再び粒子の使用について。何てことだ。えっと、行くよ"}, {"type": "subtitle", "time": 15711.91, "timestamp": "04:21:51", "text": "今がまさにその時だと思う。あ、こんにちは、ヴィジュ・カーン"}, {"type": "subtitle", "time": 15713.67, "timestamp": "04:21:53", "text": "美術館です。私はそれを学ぶ必要がある"}, {"type": "subtitle", "time": 15716.87, "timestamp": "04:21:56", "text": "語彙も同様です。今日ヴィジュッツと私は言った"}]
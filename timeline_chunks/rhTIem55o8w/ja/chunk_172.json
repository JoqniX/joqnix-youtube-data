[{"type": "subtitle", "time": 10327.67, "timestamp": "02:52:07", "text": "やり方がわからないので、手伝ってください"}, {"type": "subtitle", "time": 10331.11, "timestamp": "02:52:11", "text": "インド訛りで話す。ごめんなさい。私は"}, {"type": "subtitle", "time": 10335.349, "timestamp": "02:52:15", "text": "訛りさえあるの？わからない。"}, {"type": "subtitle", "time": 10336.349, "timestamp": "02:52:16", "text": "私はしません"}, {"type": "subtitle", "time": 10339.309, "timestamp": "02:52:19", "text": "知る。"}, {"type": "subtitle", "time": 10358.55, "timestamp": "02:52:38", "text": "最後まで残った。"}, {"type": "subtitle", "time": 10360.55, "timestamp": "02:52:40", "text": "ああ、そうだね。私はあなたが"}, {"type": "subtitle", "time": 10362.83, "timestamp": "02:52:42", "text": "一瞬、詐欺師だと思った。"}, {"type": "subtitle", "time": 10371.67, "timestamp": "02:52:51", "text": "する？はぁ？待って、あなたはインド出身ですか、"}, {"type": "subtitle", "time": 10377.75, "timestamp": "02:52:57", "text": "誰かが私にそう言ったのはそれが初めてだった"}, {"type": "subtitle", "time": 10378.7, "timestamp": "02:52:58", "text": "1"}]
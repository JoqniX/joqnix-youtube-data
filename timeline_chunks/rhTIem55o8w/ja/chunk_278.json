[{"type": "subtitle", "time": 16680.429, "timestamp": "04:38:00", "text": "三つの自然。これは"}, {"type": "subtitle", "time": 16684.269, "timestamp": "04:38:04", "text": "moyobi e は金曜日です"}, {"type": "subtitle", "time": 16688.629, "timestamp": "04:38:08", "text": "キノビ。えっと、これは「金」の漢字です。"}, {"type": "subtitle", "time": 16692.029, "timestamp": "04:38:12", "text": "そして、Fは土壌です。これは"}, {"type": "subtitle", "time": 16695.349, "timestamp": "04:38:15", "text": "土壌。今日は試験でしたか？いいえ、日曜日です。"}, {"type": "subtitle", "time": 16696.99, "timestamp": "04:38:16", "text": "今日はオフラインでした"}, {"type": "subtitle", "time": 16699.67, "timestamp": "04:38:19", "text": "クラス。全員が学んで参加したわけではなかった。"}, {"type": "subtitle", "time": 16701.99, "timestamp": "04:38:21", "text": "全員が復習したわけではなかった。それで先生は"}, {"type": "subtitle", "time": 16704.789, "timestamp": "04:38:24", "text": "要約して"}, {"type": "subtitle", "time": 16707.429, "timestamp": "04:38:27", "text": "すべてを修正するように言われ、"}, {"type": "subtitle", "time": 16711.51, "timestamp": "04:38:31", "text": "彼が私たちに教えてくれたことをすべて学び、"}, {"type": "subtitle", "time": 16714.949, "timestamp": "04:38:34", "text": "遠い。すべてのトピック、文法、助詞、"}, {"type": "subtitle", "time": 16718.789, "timestamp": "04:38:38", "text": "接続詞、形容詞、動詞、語幹、"}, {"type": "subtitle", "time": 16720.949, "timestamp": "04:38:40", "text": "すべて、漢字、すべて、"}, {"type": "subtitle", "time": 16723.99, "timestamp": "04:38:43", "text": "語彙力、そして明日来てください。それで、私は"}, {"type": "subtitle", "time": 16724.75, "timestamp": "04:38:44", "text": "に"}, {"type": "subtitle", "time": 16727.429, "timestamp": "04:38:47", "text": "準備もしていないし、勉強もしていない。"}, {"type": "subtitle", "time": 16729.99, "timestamp": "04:38:49", "text": "テスト。それを変えなければならない。私は"}, {"type": "subtitle", "time": 16732.75, "timestamp": "04:38:52", "text": "怠けている。それは"}, {"type": "subtitle", "time": 16737.15, "timestamp": "04:38:57", "text": "悪い。オーケー、これは、私はFのように感じます"}]
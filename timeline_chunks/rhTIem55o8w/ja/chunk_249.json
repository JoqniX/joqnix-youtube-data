[{"type": "subtitle", "time": 14942.07, "timestamp": "04:09:02", "text": "休憩。こんにちは。それでは、始める前に"}, {"type": "subtitle", "time": 14944.07, "timestamp": "04:09:04", "text": "カンニングペーパーについて話しましょう。不正行為をしない"}, {"type": "subtitle", "time": 14945.99, "timestamp": "04:09:05", "text": "シートは理解しやすい方法のようなものです"}, {"type": "subtitle", "time": 14949.71, "timestamp": "04:09:09", "text": "音声はどうやってここに挿入されるのか"}, {"type": "subtitle", "time": 14952.269, "timestamp": "04:09:12", "text": "Webサイト。そうすれば"}, {"type": "subtitle", "time": 14954.95, "timestamp": "04:09:14", "text": "えっと、あなたには見えないかもしれないけど"}, {"type": "subtitle", "time": 14958.95, "timestamp": "04:09:18", "text": "正しい。では、最初の3桁は"}, {"type": "subtitle", "time": 14961.99, "timestamp": "04:09:21", "text": "まず、こちらの3桁の数字は"}, {"type": "subtitle", "time": 14964.389, "timestamp": "04:09:24", "text": "このオーディオ番号は、"}, {"type": "subtitle", "time": 14967.75, "timestamp": "04:09:27", "text": "Webサイト。最初のレッスンは001です"}, {"type": "subtitle", "time": 14969.71, "timestamp": "04:09:29", "text": "最後のレッスンは何か"}, {"type": "subtitle", "time": 14973.75, "timestamp": "04:09:33", "text": "297くらいですよね？こんにちは。だから、それを覚えておいてください"}, {"type": "subtitle", "time": 14977.11, "timestamp": "04:09:37", "text": "混乱しているなら、モージョッキー"}, {"type": "subtitle", "time": 14978.79, "timestamp": "04:09:38", "text": "オーディオファイルが多すぎてわからない"}, {"type": "subtitle", "time": 14982.15, "timestamp": "04:09:42", "text": "何を置いて、何を再生するか。覚えて"}, {"type": "subtitle", "time": 14984.229, "timestamp": "04:09:44", "text": "数字と混同しないでください。"}, {"type": "subtitle", "time": 14986.07, "timestamp": "04:09:46", "text": "最初のものはアップロードされたものです"}, {"type": "subtitle", "time": 14990.71, "timestamp": "04:09:50", "text": "オーディオ。 2つ目は、あなたへの教訓です。"}, {"type": "subtitle", "time": 14992.79, "timestamp": "04:09:52", "text": "2つ目はレッスン番号です。"}, {"type": "subtitle", "time": 14996.229, "timestamp": "04:09:56", "text": "それが一つ目です。 3つ目はセッションです"}, {"type": "subtitle", "time": 14999.51, "timestamp": "04:09:59", "text": "セッション番号です。そして最後"}]
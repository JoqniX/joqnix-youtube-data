[{"type": "subtitle", "time": 8042.75, "timestamp": "02:14:02", "text": "私のこの立場は良くない。"}, {"type": "subtitle", "time": 8051.95, "timestamp": "02:14:11", "text": "私は攻撃者だから、その方が良い"}, {"type": "subtitle", "time": 8063.03, "timestamp": "02:14:23", "text": "する。聖なる。"}, {"type": "subtitle", "time": 8095.43, "timestamp": "02:14:55", "text": "私はここから出て行く。あ、待って。私は彼のものを受け取ります"}, {"type": "subtitle", "time": 8097.189, "timestamp": "02:14:57", "text": "銃。"}]
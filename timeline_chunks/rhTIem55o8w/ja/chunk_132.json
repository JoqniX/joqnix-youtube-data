[{"type": "subtitle", "time": 7920.47, "timestamp": "02:12:00", "text": "よし、こうやって投げればいい。私はもう帰ります"}, {"type": "subtitle", "time": 7922.629, "timestamp": "02:12:02", "text": "ここから。"}, {"type": "subtitle", "time": 7938.31, "timestamp": "02:12:18", "text": "キーを押すのが難しい。なぜ"}, {"type": "subtitle", "time": 7950.43, "timestamp": "02:12:30", "text": "なぜ押すのが難しいのか"}, {"type": "subtitle", "time": 7953.229, "timestamp": "02:12:33", "text": "鍵？彼はちょっと"}, {"type": "subtitle", "time": 7955.229, "timestamp": "02:12:35", "text": "強い。私"}, {"type": "subtitle", "time": 7962.87, "timestamp": "02:12:42", "text": "[音楽]"}, {"type": "subtitle", "time": 7973.27, "timestamp": "02:12:53", "text": "再装填中。"}, {"type": "subtitle", "time": 7975.189, "timestamp": "02:12:55", "text": "このガキめ。"}, {"type": "subtitle", "time": 7977.43, "timestamp": "02:12:57", "text": "わかった、手袋をなくしちゃった。"}]
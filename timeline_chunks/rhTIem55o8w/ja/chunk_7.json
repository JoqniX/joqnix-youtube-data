[{"type": "subtitle", "time": 423.67, "timestamp": "00:07:03", "text": "早く寝て、"}, {"type": "subtitle", "time": 439.07, "timestamp": "00:07:19", "text": "繰り返しますが、私は"}, {"type": "subtitle", "time": 442.309, "timestamp": "00:07:22", "text": "知る。だから今日はもっと何かをしてみようと思った。"}, {"type": "subtitle", "time": 445.27, "timestamp": "00:07:25", "text": "色々整理する必要があっただけなんです。私 私"}, {"type": "subtitle", "time": 447.469, "timestamp": "00:07:27", "text": "私は自分のやり方が好きではない"}, {"type": "subtitle", "time": 450.48, "timestamp": "00:07:30", "text": "ジョアソン。私はそれを作りたかった"}, {"type": "subtitle", "time": 451.71, "timestamp": "00:07:31", "text": "[音楽]"}, {"type": "subtitle", "time": 466.469, "timestamp": "00:07:46", "text": "もの。でも、私は"}, {"type": "subtitle", "time": 470.589, "timestamp": "00:07:50", "text": "良くなったし、今日も順調に進んでいる。私"}, {"type": "subtitle", "time": 473.35, "timestamp": "00:07:53", "text": "目が覚めたらそれを見たんだと思う"}, {"type": "subtitle", "time": 475.589, "timestamp": "00:07:55", "text": "コメントして、私の"}, {"type": "subtitle", "time": 478.71, "timestamp": "00:07:58", "text": "今日一日、私の体に残された神聖な正気"}]
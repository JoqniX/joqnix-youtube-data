[{"type": "subtitle", "time": 12540.07, "timestamp": "03:29:00", "text": "楽しい。だから、私に関しては、私は気づく"}, {"type": "subtitle", "time": 12542.07, "timestamp": "03:29:02", "text": "これらに関しては"}, {"type": "subtitle", "time": 12544.55, "timestamp": "03:29:04", "text": "マルチプレイヤーシューティングゲームですよね？の"}, {"type": "subtitle", "time": 12548.95, "timestamp": "03:29:08", "text": "主な概念はランク付けです。たとえあなたが"}, {"type": "subtitle", "time": 12551.19, "timestamp": "03:29:11", "text": "トーナメントに参加したい、またはプレイしたい"}, {"type": "subtitle", "time": 12553.349, "timestamp": "03:29:13", "text": "他のユーチューバーと一緒に、または"}, {"type": "subtitle", "time": 12556.63, "timestamp": "03:29:16", "text": "YouTuberトーナメントやその他何でも、"}, {"type": "subtitle", "time": 12558.11, "timestamp": "03:29:18", "text": "あなたに必要なのは"}, {"type": "subtitle", "time": 12559.63, "timestamp": "03:29:19", "text": "1"}, {"type": "subtitle", "time": 12562.389, "timestamp": "03:29:22", "text": "ランク。 Apexを試してみるべきだ。新しい"}, {"type": "subtitle", "time": 12568.07, "timestamp": "03:29:28", "text": "イベント名：ウィンターエクスプレス。ああ、戻ってきた。"}, {"type": "subtitle", "time": 12572.429, "timestamp": "03:29:32", "text": "私はこれらのFPSゲームをプレイしたいです。"}, {"type": "subtitle", "time": 12575.91, "timestamp": "03:29:35", "text": "しかしストリーミングは少し難しいでしょう"}, {"type": "subtitle", "time": 12577.79, "timestamp": "03:29:37", "text": "シングルPC、"}, {"type": "subtitle", "time": 12581.349, "timestamp": "03:29:41", "text": "知る。ええ、つまり、私はそれで構いません"}, {"type": "subtitle", "time": 12585.269, "timestamp": "03:29:45", "text": "1台のPCでストリーミング配信を行っています。その"}, {"type": "subtitle", "time": 12587.59, "timestamp": "03:29:47", "text": "ただ、動作が遅くなるだけで、"}, {"type": "subtitle", "time": 12590.63, "timestamp": "03:29:50", "text": "体験はちょっと悪いものになるだろうね。"}, {"type": "subtitle", "time": 12593.19, "timestamp": "03:29:53", "text": "それが唯一の点だ。そして、"}, {"type": "subtitle", "time": 12595.75, "timestamp": "03:29:55", "text": "見ているとラグが見える"}, {"type": "subtitle", "time": 12597.55, "timestamp": "03:29:57", "text": "ストリーム。それもまた"}]
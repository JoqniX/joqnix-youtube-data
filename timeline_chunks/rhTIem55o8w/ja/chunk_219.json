[{"type": "subtitle", "time": 13141.469, "timestamp": "03:39:01", "text": "より万全の準備をしておく方が良い。そうですね、"}, {"type": "subtitle", "time": 13144.349, "timestamp": "03:39:04", "text": "あまりにも"}, {"type": "subtitle", "time": 13148.79, "timestamp": "03:39:08", "text": "メニではないけれど、ある意味では良い。"}, {"type": "subtitle", "time": 13151.59, "timestamp": "03:39:11", "text": "その練習は、"}, {"type": "subtitle", "time": 13155.269, "timestamp": "03:39:15", "text": "準備不足ですね、まるでリリースするようなものです"}, {"type": "subtitle", "time": 13158.07, "timestamp": "03:39:18", "text": "準備不足のビデオと後悔"}, {"type": "subtitle", "time": 13160.87, "timestamp": "03:39:20", "text": "ああ、もっとうまくできたはずなのに"}, {"type": "subtitle", "time": 13163.11, "timestamp": "03:39:23", "text": "もっと違うやり方もできたかもしれない"}, {"type": "subtitle", "time": 13165.229, "timestamp": "03:39:25", "text": "そんな感じのもの"}, {"type": "subtitle", "time": 13166.99, "timestamp": "03:39:26", "text": "いいえ、そうではありません"}, {"type": "subtitle", "time": 13175.59, "timestamp": "03:39:35", "text": "それ。でも、確かに難しいですね。それは"}, {"type": "subtitle", "time": 13176.83, "timestamp": "03:39:36", "text": "私が好きな理由"}, {"type": "subtitle", "time": 13179.349, "timestamp": "03:39:39", "text": "それ。毎日がまるで"}, {"type": "subtitle", "time": 13181.349, "timestamp": "03:39:41", "text": "自分自身に挑戦する"}, {"type": "subtitle", "time": 13183.83, "timestamp": "03:39:43", "text": "新しいですよね？あるいは、あなたも同じことをしているなら"}, {"type": "subtitle", "time": 13186.87, "timestamp": "03:39:46", "text": "同じことを何度も繰り返すと、飽きてしまうでしょう。"}, {"type": "subtitle", "time": 13190.229, "timestamp": "03:39:50", "text": "それだけでなく、あなたも"}, {"type": "subtitle", "time": 13193.429, "timestamp": "03:39:53", "text": "何か新しいもの、または既に"}, {"type": "subtitle", "time": 13195.83, "timestamp": "03:39:55", "text": "既存のものを組み込もうとします"}, {"type": "subtitle", "time": 13198.51, "timestamp": "03:39:58", "text": "あなた自身のやり方で。次のような"}]
[{"type": "subtitle", "time": 6120.14, "timestamp": "01:42:00", "text": "トゥイッチ。"}, {"type": "subtitle", "time": 6122.35, "timestamp": "01:42:02", "text": "[音楽]"}, {"type": "subtitle", "time": 6131.4, "timestamp": "01:42:11", "text": "トゥイッチ。私は"}, {"type": "subtitle", "time": 6141.87, "timestamp": "01:42:21", "text": "ライブ？私は。それは"}, {"type": "subtitle", "time": 6144.75, "timestamp": "01:42:24", "text": "良い。こんにちは。"}, {"type": "subtitle", "time": 6148.31, "timestamp": "01:42:28", "text": "えっと、なぜヴァレランは開かないんですか？それは滞在です"}, {"type": "subtitle", "time": 6150.27, "timestamp": "01:42:30", "text": "ものすごく時間がかかる。あなた"}, {"type": "subtitle", "time": 6154.229, "timestamp": "01:42:34", "text": "最近気づいたのですが、"}, {"type": "subtitle", "time": 6157.669, "timestamp": "01:42:37", "text": "昨日、ああ、私が気づいたのは、"}, {"type": "subtitle", "time": 6160.189, "timestamp": "01:42:40", "text": "ゲームを開く、例えば"}, {"type": "subtitle", "time": 6164.709, "timestamp": "01:42:44", "text": "えっと、前回はどのゲームでしたっけ？無限"}, {"type": "subtitle", "time": 6167.189, "timestamp": "01:42:47", "text": "無限ニキですよね？いや、いや、いや、いや。"}, {"type": "subtitle", "time": 6175.629, "timestamp": "01:42:55", "text": "オープニングと今日の号は"}]
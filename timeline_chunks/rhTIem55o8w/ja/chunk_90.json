[{"type": "subtitle", "time": 5400.43, "timestamp": "01:30:00", "text": "これって何の意味があるの？理解できない"}, {"type": "subtitle", "time": 5405.95, "timestamp": "01:30:05", "text": "それ。誰か「ただ食べればいい」って言った？"}, {"type": "subtitle", "time": 5409.189, "timestamp": "01:30:09", "text": "ディンドン？理解できません。何が面白いのか"}, {"type": "subtitle", "time": 5422.99, "timestamp": "01:30:22", "text": "食べる必要がある場合は、"}, {"type": "subtitle", "time": 5426.95, "timestamp": "01:30:26", "text": "食べる。理解できません。"}, {"type": "chat", "time": 5428.316, "timestamp": "01:30:28", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "because she screamed near the end"}, {"type": "subtitle", "time": 5441.97, "timestamp": "01:30:41", "text": "彼女は他の人たちの近くでは緑色なのでショットを撮る"}, {"type": "chat", "time": 5447.854, "timestamp": "01:30:47", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "Listen to it with our audio off"}, {"type": "subtitle", "time": 5454.11, "timestamp": "01:30:54", "text": "終わり。ああ、あのボーカルは最高だ"}, {"type": "subtitle", "time": 5456.55, "timestamp": "01:30:56", "text": "あれ。うん。うん。聴いています"}, {"type": "chat", "time": 5459.02, "timestamp": "01:30:59", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "Yes"}]
[{"type": "subtitle", "time": 16383.429, "timestamp": "04:33:03", "text": "あなた？パーティー。それが正しいことを願っています。"}, {"type": "subtitle", "time": 16385.551, "timestamp": "04:33:05", "text": "それが正しいかどうか確認すべきでしょうか？わかった。"}, {"type": "subtitle", "time": 16389.429, "timestamp": "04:33:09", "text": "待って。えっと、ビョンですよね？ビョインがそれを持っている。する"}, {"type": "subtitle", "time": 16399.07, "timestamp": "04:33:19", "text": "ビオン。"}, {"type": "subtitle", "time": 16408.109, "timestamp": "04:33:28", "text": "ビ。待って。"}, {"type": "subtitle", "time": 16412.109, "timestamp": "04:33:32", "text": "B. 待ってください。我慢する。"}, {"type": "subtitle", "time": 16417.47, "timestamp": "04:33:37", "text": "ニン"}, {"type": "subtitle", "time": 16422.99, "timestamp": "04:33:42", "text": "間違っている？"}, {"type": "subtitle", "time": 16427.349, "timestamp": "04:33:47", "text": "ビョル・ビオン。待って。オーケー、それは"}, {"type": "subtitle", "time": 16430.551, "timestamp": "04:33:50", "text": "大丈夫。これは私の間違いになりそうだ。"}, {"type": "subtitle", "time": 16433.75, "timestamp": "04:33:53", "text": "大丈夫。パーティー。確認させてください。パーティー。"}, {"type": "subtitle", "time": 16436.349, "timestamp": "04:33:56", "text": "パーティー。パーティー。"}]
[{"type": "subtitle", "time": 6966.669, "timestamp": "01:56:06", "text": "[音楽]"}, {"type": "subtitle", "time": 6970.27, "timestamp": "01:56:10", "text": "ハロンはそうです。はい、そうです"}, {"type": "subtitle", "time": 6982.15, "timestamp": "01:56:22", "text": "ハプニング？おお"}, {"type": "subtitle", "time": 6984.03, "timestamp": "01:56:24", "text": "[音楽]"}, {"type": "subtitle", "time": 6992.91, "timestamp": "01:56:32", "text": "いいえ。"}, {"type": "subtitle", "time": 6996.99, "timestamp": "01:56:36", "text": "なぜ再起動する必要があるのか"}, {"type": "subtitle", "time": 7004.669, "timestamp": "01:56:44", "text": "私はできる"}, {"type": "subtitle", "time": 7007.669, "timestamp": "01:56:47", "text": "それ。ほら、すごく動作が遅いでしょ。ああ、今は"}, {"type": "subtitle", "time": 7011.229, "timestamp": "01:56:51", "text": "仕事中だよ、兄弟。"}, {"type": "subtitle", "time": 7013.99, "timestamp": "01:56:53", "text": "何？デスクトップに切り替えた直後"}, {"type": "subtitle", "time": 7016.629, "timestamp": "01:56:56", "text": "捕獲だ、君は今、私を狙っている。は"}]
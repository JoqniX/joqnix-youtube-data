[{"type": "subtitle", "time": 7531.31, "timestamp": "02:05:31", "text": "バッカ。フォートナイトじゃないよ。保つ"}, {"type": "subtitle", "time": 7534.149, "timestamp": "02:05:34", "text": "忘れること。曳光弾は使用されていません。"}, {"type": "subtitle", "time": 7537.03, "timestamp": "02:05:37", "text": "追跡装置ではない。えーと、ヒットはないんだけど"}, {"type": "subtitle", "time": 7558.709, "timestamp": "02:05:58", "text": "ああ、神様。あなたはマーベルファンですか？はい、"}]
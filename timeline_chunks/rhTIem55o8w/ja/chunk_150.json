[{"type": "subtitle", "time": 9001.27, "timestamp": "02:30:01", "text": "制御可能性。今でも慣れていない"}, {"type": "subtitle", "time": 9004.15, "timestamp": "02:30:04", "text": "高い感覚へ。なぜ？まるで"}, {"type": "subtitle", "time": 9007.59, "timestamp": "02:30:07", "text": "何ヶ月間"}, {"type": "subtitle", "time": 9011.03, "timestamp": "02:30:11", "text": "同じマウス軸グラフを使用しています"}, {"type": "subtitle", "time": 9013.51, "timestamp": "02:30:13", "text": "曲線？ほぼ２年間だと思う"}, {"type": "subtitle", "time": 9016.27, "timestamp": "02:30:16", "text": "年ですよね？誰も"}, {"type": "subtitle", "time": 9034.71, "timestamp": "02:30:34", "text": "残量が少なくなってきました。私の世界へようこそ。 1つ"}, {"type": "subtitle", "time": 9041.75, "timestamp": "02:30:41", "text": "スパイクは無事です。"}, {"type": "subtitle", "time": 9048.79, "timestamp": "02:30:48", "text": "私はどうやって彼を殺したのか？目が見えなくなっている間。ああ、"}, {"type": "subtitle", "time": 9051.19, "timestamp": "02:30:51", "text": "神。ニース。それは私です。星座。"}]
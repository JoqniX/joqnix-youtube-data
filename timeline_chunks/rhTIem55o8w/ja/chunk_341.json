[{"type": "subtitle", "time": 20481.09, "timestamp": "05:41:21", "text": "いいえ、どうやって「はい」と書けばいいですか。"}, {"type": "subtitle", "time": 20483.868, "timestamp": "05:41:23", "text": "[音楽]"}, {"type": "subtitle", "time": 20497.27, "timestamp": "05:41:37", "text": "自分。ああ、なるほど。ああ、今わかった。わかった、"}, {"type": "subtitle", "time": 20500.8, "timestamp": "05:41:40", "text": "ありますよ。いいえ。わかった。"}, {"type": "subtitle", "time": 20502.19, "timestamp": "05:41:42", "text": "[音楽]"}, {"type": "subtitle", "time": 20505.99, "timestamp": "05:41:45", "text": "わかった。メイヨー。はい、わかりました。わかった。私 私"}, {"type": "subtitle", "time": 20508.43, "timestamp": "05:41:48", "text": "これを修正する必要がある"}]
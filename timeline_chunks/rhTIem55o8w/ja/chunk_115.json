[{"type": "subtitle", "time": 6903.55, "timestamp": "01:55:03", "text": "の上。来て。来て。わかった。適用する。"}, {"type": "subtitle", "time": 6906.75, "timestamp": "01:55:06", "text": "お願いします。わかった。何か"}, {"type": "subtitle", "time": 6910.07, "timestamp": "01:55:10", "text": "起こった。元に戻される前に、"}, {"type": "subtitle", "time": 6911.83, "timestamp": "01:55:11", "text": "どうか、それを見せてください。"}, {"type": "subtitle", "time": 6913.149, "timestamp": "01:55:13", "text": "わかった。感謝"}, {"type": "subtitle", "time": 6916.47, "timestamp": "01:55:16", "text": "あなた。私の中に紫色の箱がある"}, {"type": "subtitle", "time": 6919.83, "timestamp": "01:55:19", "text": "ああ、私の"}, {"type": "subtitle", "time": 6922.47, "timestamp": "01:55:22", "text": "画面。それは普通のことですか、それとも私は"}, {"type": "subtitle", "time": 6925.27, "timestamp": "01:55:25", "text": "心配した？"}, {"type": "subtitle", "time": 6927.149, "timestamp": "01:55:27", "text": "おお"}, {"type": "subtitle", "time": 6937.99, "timestamp": "01:55:37", "text": "それはレイテンシーの問題でしょうか？そうなるだろうか"}, {"type": "subtitle", "time": 6938.669, "timestamp": "01:55:38", "text": "の"}, {"type": "subtitle", "time": 6942.39, "timestamp": "01:55:42", "text": "遅延？なぜこんなに動作が遅いのですか？え、何？"}, {"type": "subtitle", "time": 6943.669, "timestamp": "01:55:43", "text": "え、何が起こってるの？待って、待って、"}]
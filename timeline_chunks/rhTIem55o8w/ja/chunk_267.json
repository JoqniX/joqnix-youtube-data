[{"type": "subtitle", "time": 16023.149, "timestamp": "04:27:03", "text": "うん。"}, {"type": "subtitle", "time": 16031.03, "timestamp": "04:27:11", "text": "ダケン。私の文章の書き方は本当にひどい。私は必要としている"}, {"type": "subtitle", "time": 16035.67, "timestamp": "04:27:15", "text": "えーと、文字の練習をするために。えっと、待って。"}, {"type": "subtitle", "time": 16040.75, "timestamp": "04:27:20", "text": "上から下へじゃないですか？ああ、もちろんです。"}, {"type": "subtitle", "time": 16043.63, "timestamp": "04:27:23", "text": "待って、"}, {"type": "subtitle", "time": 16048.07, "timestamp": "04:27:28", "text": "なれ。はい、どうぞ。漢字で「B」。ニョビ。あなた"}, {"type": "subtitle", "time": 16065.03, "timestamp": "04:27:45", "text": "ニアニ・ニ。待って、そんなにひどくはないはずだ。"}, {"type": "subtitle", "time": 16068.309, "timestamp": "04:27:48", "text": "大丈夫。ニティを手に入れるかもしれない。待って。神、"}, {"type": "subtitle", "time": 16072.07, "timestamp": "04:27:52", "text": "私の文章の書き方は下手だ。 1 2 3、"}, {"type": "subtitle", "time": 16075.229, "timestamp": "04:27:55", "text": "4つ。 4打数4安打。"}, {"type": "subtitle", "time": 16077.71, "timestamp": "04:27:57", "text": "ニ。これは"}]
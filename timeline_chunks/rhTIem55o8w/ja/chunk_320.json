[{"type": "subtitle", "time": 19202.51, "timestamp": "05:20:02", "text": "私は何かをしています"}, {"type": "subtitle", "time": 19206.708, "timestamp": "05:20:06", "text": "今。テスト用紙の音声ファイルが見つかりません。"}, {"type": "subtitle", "time": 19210.23, "timestamp": "05:20:10", "text": "大丈夫。言語レベルはどのように"}, {"type": "subtitle", "time": 19213.27, "timestamp": "05:20:13", "text": "日本で働いていますか？覚えているのは"}, {"type": "subtitle", "time": 19216.628, "timestamp": "05:20:16", "text": "N3とN5くらいかな。つまりN5は"}, {"type": "subtitle", "time": 19219.19, "timestamp": "05:20:19", "text": "始まり"}, {"type": "subtitle", "time": 19223.11, "timestamp": "05:20:23", "text": "えーとN5は始まりになります、えーと"}, {"type": "subtitle", "time": 19226.39, "timestamp": "05:20:26", "text": "初心者レベル。 N4とN5は"}, {"type": "subtitle", "time": 19230.31, "timestamp": "05:20:30", "text": "日本語初心者クラス"}, {"type": "subtitle", "time": 19232.708, "timestamp": "05:20:32", "text": "そしてN3以降は"}, {"type": "subtitle", "time": 19235.51, "timestamp": "05:20:35", "text": "中級レベルならN3と2と言えるでしょう"}, {"type": "subtitle", "time": 19237.91, "timestamp": "05:20:37", "text": "中間であり、N1はネイティブとなる"}, {"type": "subtitle", "time": 19239.31, "timestamp": "05:20:39", "text": "レベル"}, {"type": "subtitle", "time": 19242.788, "timestamp": "05:20:42", "text": "日本語で、どうやらN3以降は"}, {"type": "subtitle", "time": 19245.11, "timestamp": "05:20:45", "text": "別の言語とか何か"}, {"type": "subtitle", "time": 19246.67, "timestamp": "05:20:46", "text": "ええと、とても"}, {"type": "subtitle", "time": 19254.47, "timestamp": "05:20:54", "text": "うーん、日本"}, {"type": "subtitle", "time": 19255.708, "timestamp": "05:20:55", "text": "えーと"}]
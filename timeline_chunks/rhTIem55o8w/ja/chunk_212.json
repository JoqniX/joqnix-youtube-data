[{"type": "subtitle", "time": 12721.03, "timestamp": "03:32:01", "text": "Twitchのことですよね？時々私は"}, {"type": "subtitle", "time": 12723.83, "timestamp": "03:32:03", "text": "Twitchをやめた方がいいかもしれない。理由がわからない"}, {"type": "subtitle", "time": 12728.309, "timestamp": "03:32:08", "text": "なぜなら、YouTubeにもっと集中したいから"}, {"type": "subtitle", "time": 12732.229, "timestamp": "03:32:12", "text": "もっと"}, {"type": "subtitle", "time": 12736.229, "timestamp": "03:32:16", "text": "えっと、私はたくさんの視聴時間を失ってしまったので"}, {"type": "subtitle", "time": 12740.15, "timestamp": "03:32:20", "text": "4ヶ月間休止していたため、"}, {"type": "subtitle", "time": 12741.95, "timestamp": "03:32:21", "text": "それを削り戻さなければならない"}, {"type": "subtitle", "time": 12746.229, "timestamp": "03:32:26", "text": "立ち上がって、私は、それが"}, {"type": "subtitle", "time": 12749.11, "timestamp": "03:32:29", "text": "私の新年の抱負は正しいか、"}, {"type": "subtitle", "time": 12752.71, "timestamp": "03:32:32", "text": "何か好きなものを収益化できる。"}, {"type": "subtitle", "time": 12756.55, "timestamp": "03:32:36", "text": "2025年までに。しかし、それは実現しないだろう。"}, {"type": "subtitle", "time": 12761.63, "timestamp": "03:32:41", "text": "もうすぐ2025年になりますね。それで、えーと"}, {"type": "subtitle", "time": 12764.51, "timestamp": "03:32:44", "text": "おそらく私はそれを自分のものにするだろう"}, {"type": "subtitle", "time": 12768.63, "timestamp": "03:32:48", "text": "えーっと、2026年の新年の抱負目標、または"}, {"type": "subtitle", "time": 12772.389, "timestamp": "03:32:52", "text": "2025年みたいに。うん、ヒットしたいんだ。"}, {"type": "subtitle", "time": 12774.469, "timestamp": "03:32:54", "text": "収益化とか、そういう類のもの。それは"}, {"type": "subtitle", "time": 12777.83, "timestamp": "03:32:57", "text": "私が本当に欲しいもの、だって知ってるでしょ"}, {"type": "subtitle", "time": 12779.83, "timestamp": "03:32:59", "text": "チャンネルの絵文字が欲しいです"}]
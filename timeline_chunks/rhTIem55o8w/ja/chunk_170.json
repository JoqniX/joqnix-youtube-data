[{"type": "subtitle", "time": 10204.389, "timestamp": "02:50:04", "text": "すべて。なぜ人々がそうしないのか理解できない"}, {"type": "subtitle", "time": 10206.469, "timestamp": "02:50:06", "text": "特定のゲームをプレイするのが好きではない人もいます"}, {"type": "subtitle", "time": 10208.63, "timestamp": "02:50:08", "text": "アイスブロックのようなマップ。一部の人々は嫌っていた"}, {"type": "subtitle", "time": 10210.349, "timestamp": "02:50:10", "text": "それ。そして"}, {"type": "subtitle", "time": 10214.15, "timestamp": "02:50:14", "text": "プレイすればするほど、"}, {"type": "subtitle", "time": 10216.99, "timestamp": "02:50:16", "text": "私たちは"}, {"type": "subtitle", "time": 10220.309, "timestamp": "02:50:20", "text": "プレイすればするほど"}, {"type": "subtitle", "time": 10223.269, "timestamp": "02:50:23", "text": "嫌いな地図ほど、愛着が湧いてくる。いいえ、"}, {"type": "subtitle", "time": 10225.55, "timestamp": "02:50:25", "text": "あるいは何か、君"}, {"type": "subtitle", "time": 10229.55, "timestamp": "02:50:29", "text": "知って、勇気ある行動をとる"}, {"type": "subtitle", "time": 10236.79, "timestamp": "02:50:36", "text": "だから、あと1秒で注意しなければならないのは"}]
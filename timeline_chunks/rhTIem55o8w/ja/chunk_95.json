[{"type": "subtitle", "time": 5709.83, "timestamp": "01:35:09", "text": "えっと、レンドモデルには顔がある"}, {"type": "subtitle", "time": 5711.11, "timestamp": "01:35:11", "text": "トラッキングアドオン。の上。"}, {"type": "subtitle", "time": 5713.55, "timestamp": "01:35:13", "text": "[音楽]"}, {"type": "subtitle", "time": 5716.709, "timestamp": "01:35:16", "text": "くそ。ああ、それでこれらはああ。ああ、これらは"}, {"type": "subtitle", "time": 5719.43, "timestamp": "01:35:19", "text": "顔追跡機能を備えたVRチャットモデルのようなもの"}, {"type": "subtitle", "time": 5721.149, "timestamp": "01:35:21", "text": "アドオン。わかった。"}, {"type": "subtitle", "time": 5725.03, "timestamp": "01:35:25", "text": "わかった。ああ、VRチャットプラスでは、人々は"}, {"type": "subtitle", "time": 5728.149, "timestamp": "01:35:28", "text": "ウェブカメラで顔追跡をするんですよね？おお、"}, {"type": "subtitle", "time": 5731.07, "timestamp": "01:35:31", "text": "うん。それがプレミアム商品であることを忘れていました"}, {"type": "subtitle", "time": 5734.31, "timestamp": "01:35:34", "text": "特徴。つまり、模型制作者、アバター制作者"}, {"type": "subtitle", "time": 5737.83, "timestamp": "01:35:37", "text": "それらのパラメータを追加する必要があります"}, {"type": "subtitle", "time": 5740.43, "timestamp": "01:35:40", "text": "モデル。"}, {"type": "subtitle", "time": 5743.709, "timestamp": "01:35:43", "text": "いいえ。ああ、彼らのバージョン２を作るようなものです"}, {"type": "subtitle", "time": 5747.83, "timestamp": "01:35:47", "text": "チャットでアバターをモデル化して、"}, {"type": "subtitle", "time": 5750.99, "timestamp": "01:35:50", "text": "顔追跡機能を追加できます"}, {"type": "subtitle", "time": 5759.75, "timestamp": "01:35:59", "text": "くそ。わかった。また、いくつかやらなければならないことがあります"}]
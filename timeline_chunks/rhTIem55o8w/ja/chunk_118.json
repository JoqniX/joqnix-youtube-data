[{"type": "subtitle", "time": 7081.75, "timestamp": "01:58:01", "text": "などなど。ピューピューピューソロ"}, {"type": "subtitle", "time": 7085.03, "timestamp": "01:58:05", "text": "ランクを上げてランクを獲得し、"}, {"type": "subtitle", "time": 7088.39, "timestamp": "01:58:08", "text": "最高。実に単純な話だ。"}, {"type": "subtitle", "time": 7113.79, "timestamp": "01:58:33", "text": "うん。"}, {"type": "subtitle", "time": 7116.79, "timestamp": "01:58:36", "text": "ゴエン、元気かい？元気です。"}, {"type": "subtitle", "time": 7121.229, "timestamp": "01:58:41", "text": "今日はちょっと嫌な日だった。"}, {"type": "subtitle", "time": 7124.43, "timestamp": "01:58:44", "text": "推測。うん。"}, {"type": "subtitle", "time": 7129.27, "timestamp": "01:58:49", "text": "ええ、ちょっと嫌な一日だったんです"}, {"type": "subtitle", "time": 7131.27, "timestamp": "01:58:51", "text": "朝起きたばかりの頃だった。それで、"}, {"type": "subtitle", "time": 7134.35, "timestamp": "01:58:54", "text": "それは一つのことですが、"}, {"type": "subtitle", "time": 7138.709, "timestamp": "01:58:58", "text": "わかった。 Vowの勉強が役に立つといいな"}]
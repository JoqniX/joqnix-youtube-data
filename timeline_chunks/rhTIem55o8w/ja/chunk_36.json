[{"type": "subtitle", "time": 2167.67, "timestamp": "00:36:07", "text": "[音楽]"}, {"type": "subtitle", "time": 2170.03, "timestamp": "00:36:10", "text": "時々、"}, {"type": "subtitle", "time": 2172.589, "timestamp": "00:36:12", "text": "購入する"}, {"type": "subtitle", "time": 2186.069, "timestamp": "00:36:26", "text": "右？タスクを何に割り当てますか"}, {"type": "subtitle", "time": 2188.71, "timestamp": "00:36:28", "text": "今日のタスクやストリームのようなものですか、"}, {"type": "subtitle", "time": 2190.47, "timestamp": "00:36:30", "text": "何か。私はそれらのほとんどを見たことがある"}, {"type": "subtitle", "time": 2192.55, "timestamp": "00:36:32", "text": "Twitchで安定した配信を配信中。そこには"}, {"type": "subtitle", "time": 2196.349, "timestamp": "00:36:36", "text": "それにもカテゴリーがあるよね？勉強する"}, {"type": "subtitle", "time": 2200.43, "timestamp": "00:36:40", "text": "カテゴリ。ええ、彼らがそうするのを見たことがあります"}, {"type": "subtitle", "time": 2203.27, "timestamp": "00:36:43", "text": "それ。共同作業と学習。あなたは"}, {"type": "subtitle", "time": 2206.91, "timestamp": "00:36:46", "text": "タスクリストを使用しているEveストリーマーがたくさんいます"}, {"type": "chat", "time": 2206.911, "timestamp": "00:36:46", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "start planning out stuff properly and adhere to it"}, {"type": "subtitle", "time": 2209.67, "timestamp": "00:36:49", "text": "ウィジェットは少し高価ですが"}, {"type": "subtitle", "time": 2212.63, "timestamp": "00:36:52", "text": "でも、彼らが勉強している場所で"}, {"type": "subtitle", "time": 2218.75, "timestamp": "00:36:58", "text": "[音楽]"}, {"type": "chat", "time": 2218.947, "timestamp": "00:36:58", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "not \"i'll play this game for 10hrs straight\""}]
[{"type": "subtitle", "time": 18063.03, "timestamp": "05:01:03", "text": "16. 1時間経ちました。まだ苦戦しています。"}, {"type": "subtitle", "time": 18066.27, "timestamp": "05:01:06", "text": "私はまだ1番目です"}, {"type": "subtitle", "time": 18068.788, "timestamp": "05:01:08", "text": "レッスン。わかりました、説明はしません。"}, {"type": "subtitle", "time": 18071.868, "timestamp": "05:01:11", "text": "これをスピードランするつもりだ。はい、私はとても"}, {"type": "subtitle", "time": 18074.868, "timestamp": "05:01:14", "text": "ごめん。ああ、兄弟。ちょっと待って。やろう"}, {"type": "subtitle", "time": 18078.23, "timestamp": "05:01:18", "text": "これ。えっと、10番目ですよね？わかった。私はただ"}, {"type": "subtitle", "time": 18081.11, "timestamp": "05:01:21", "text": "いや、説明しないで。私はただ聞いて、するだけです"}, {"type": "subtitle", "time": 18102.51, "timestamp": "05:01:42", "text": "えっと"}, {"type": "subtitle", "time": 18113.788, "timestamp": "05:01:53", "text": "マシ。"}]
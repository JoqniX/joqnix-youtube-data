[{"type": "subtitle", "time": 15482.149, "timestamp": "04:18:02", "text": "えっと、君にはマルトと"}, {"type": "subtitle", "time": 15485.83, "timestamp": "04:18:05", "text": "ライ。いや、バカイ。マルトだよ。ライは"}, {"type": "subtitle", "time": 15489.71, "timestamp": "04:18:09", "text": "A1教科書のような教科書、私は"}, {"type": "subtitle", "time": 15493.309, "timestamp": "04:18:13", "text": "推測。わかった。こんにちは、完了しました。"}, {"type": "subtitle", "time": 15495.91, "timestamp": "04:18:15", "text": "あれ、もしかしてスクリーンショット撮ってる？私は"}, {"type": "subtitle", "time": 15497.75, "timestamp": "04:18:17", "text": "ない。待って、ちょっと待って。私に"}, {"type": "subtitle", "time": 15509.309, "timestamp": "04:18:29", "text": "ああ、それは1つ目だ"}, {"type": "subtitle", "time": 15513.269, "timestamp": "04:18:33", "text": "終わり。まだまだ先は長い。 2番。わかった。"}, {"type": "subtitle", "time": 15516.91, "timestamp": "04:18:36", "text": "2ページ目。 3つ目。さあ"}, {"type": "subtitle", "time": 15519.469, "timestamp": "04:18:39", "text": "行く。ようこそ"}, {"type": "subtitle", "time": 15529.79, "timestamp": "04:18:49", "text": "だから、私たちは書かなければならない"}, {"type": "subtitle", "time": 15533.83, "timestamp": "04:18:53", "text": "ひざまずくか待つか、AからCまで1つを選んでください。"}, {"type": "subtitle", "time": 15535.91, "timestamp": "04:18:55", "text": "括弧の中に書いてください。つまり、AからCへ"}, {"type": "subtitle", "time": 15538.83, "timestamp": "04:18:58", "text": "ええと"}]
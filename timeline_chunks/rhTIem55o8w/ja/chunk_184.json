[{"type": "subtitle", "time": 11046.07, "timestamp": "03:04:06", "text": "最後に残ったプレイヤー。"}, {"type": "subtitle", "time": 11048.95, "timestamp": "03:04:08", "text": "何てことだ。"}, {"type": "subtitle", "time": 11051.71, "timestamp": "03:04:11", "text": "うん、このゲームは"}, {"type": "subtitle", "time": 11069.51, "timestamp": "03:04:29", "text": "降伏。まだ大丈夫だ。私たちはまだ"}, {"type": "subtitle", "time": 11072.23, "timestamp": "03:04:32", "text": "了解しました。力を信じて"}, {"type": "subtitle", "time": 11074.83, "timestamp": "03:04:34", "text": "の"}, {"type": "subtitle", "time": 11082.67, "timestamp": "03:04:42", "text": "神。力を信じて"}, {"type": "subtitle", "time": 11085.309, "timestamp": "03:04:45", "text": "チーム。私たちは"}, {"type": "subtitle", "time": 11088.429, "timestamp": "03:04:48", "text": "ゲーム。私達はします"}]
[{"type": "subtitle", "time": 3540.47, "timestamp": "00:59:00", "text": "ジョックが休憩を取っているようなもの"}, {"type": "subtitle", "time": 3544.069, "timestamp": "00:59:04", "text": "新しい雑談やコメントが来たら"}, {"type": "subtitle", "time": 3547.51, "timestamp": "00:59:07", "text": "ジョーが"}, {"type": "subtitle", "time": 3549.99, "timestamp": "00:59:09", "text": "休憩して、すべてを楽しんで"}, {"type": "subtitle", "time": 3554.63, "timestamp": "00:59:14", "text": "投票か何か、そしてすべては"}, {"type": "subtitle", "time": 3558.39, "timestamp": "00:59:18", "text": "もう一方のメインの労働者は"}, {"type": "subtitle", "time": 3561.309, "timestamp": "00:59:21", "text": "メインソフトウェアは"}, {"type": "subtitle", "time": 3564.43, "timestamp": "00:59:24", "text": "働く。後ろの選択肢をやります"}, {"type": "subtitle", "time": 3569.27, "timestamp": "00:59:29", "text": "それにはバックアップシステムが必要です。もし私が"}, {"type": "subtitle", "time": 3572.67, "timestamp": "00:59:32", "text": "たくさん修正できるように、そうしなければならない"}, {"type": "subtitle", "time": 3576.069, "timestamp": "00:59:36", "text": "YouTube側から多くの問題が発生しています"}, {"type": "subtitle", "time": 3578.63, "timestamp": "00:59:38", "text": "ソフトウェアにAPIの問題があります"}, {"type": "subtitle", "time": 3582.549, "timestamp": "00:59:42", "text": "すべては彼らのバカげたAPIのせいだ。"}, {"type": "subtitle", "time": 3584.67, "timestamp": "00:59:44", "text": "なぜYouTubeなのか？なぜGoogleなのか？なぜそんなに"}, {"type": "subtitle", "time": 3587.99, "timestamp": "00:59:47", "text": "一緒に仕事をするのが大変？"}, {"type": "subtitle", "time": 3590.63, "timestamp": "00:59:50", "text": "ということで、2番目にやるべきことは"}, {"type": "subtitle", "time": 3594.15, "timestamp": "00:59:54", "text": "リスト。 3つ目は、"}, {"type": "subtitle", "time": 3596.309, "timestamp": "00:59:56", "text": "しばらく前からですが、アップロードしたいのは"}, {"type": "subtitle", "time": 3597.789, "timestamp": "00:59:57", "text": "私の写真"}]
[{"type": "subtitle", "time": 1082.63, "timestamp": "00:18:02", "text": "コメントしています。しかしそれは問題ではないのか"}, {"type": "subtitle", "time": 1084.669, "timestamp": "00:18:04", "text": "もう？"}, {"type": "subtitle", "time": 1087.029, "timestamp": "00:18:07", "text": "ご覧の通りです。知っている。 DMを送ります"}, {"type": "subtitle", "time": 1088.87, "timestamp": "00:18:08", "text": "あなた。心配しないで。私はそのmodを入れるつもりです"}, {"type": "subtitle", "time": 1098.19, "timestamp": "00:18:18", "text": "私にとっては、"}, {"type": "subtitle", "time": 1101.75, "timestamp": "00:18:21", "text": "5分または10分のフォローをしてください"}, {"type": "subtitle", "time": 1103.909, "timestamp": "00:18:23", "text": "フォロー後、10秒待つ必要があります"}, {"type": "subtitle", "time": 1106.15, "timestamp": "00:18:26", "text": "コメントするのに数分または5分といった感じ"}, {"type": "subtitle", "time": 1112.71, "timestamp": "00:18:32", "text": "さて、これらを削除するにはどうすればいいでしょうか？"}, {"type": "subtitle", "time": 1116.909, "timestamp": "00:18:36", "text": "トロールは誰ですか？たとえ"}, {"type": "subtitle", "time": 1119.75, "timestamp": "00:18:39", "text": "Twitchにはたくさんの人がいる"}, {"type": "subtitle", "time": 1123.27, "timestamp": "00:18:43", "text": "自己宣伝好きで、"}, {"type": "subtitle", "time": 1126.07, "timestamp": "00:18:46", "text": "彼らはGFSとして身を隠している"}, {"type": "subtitle", "time": 1128.789, "timestamp": "00:18:48", "text": "BSと好きと最後に明らかにする"}, {"type": "subtitle", "time": 1130.71, "timestamp": "00:18:50", "text": "彼らはグラフィックアーティストであり、"}, {"type": "subtitle", "time": 1138.15, "timestamp": "00:18:58", "text": "まるで餌にすら乗らないみたいだ"}]
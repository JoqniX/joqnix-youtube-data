[{"type": "subtitle", "time": 7020.03, "timestamp": "01:57:00", "text": "冗談でしょう、あなた？冗談ですか、"}, {"type": "subtitle", "time": 7027.189, "timestamp": "01:57:07", "text": "作品。待って、なぜキャプチャされないの？"}, {"type": "subtitle", "time": 7035.47, "timestamp": "01:57:15", "text": "ねえ、ウィンドウキャプチャは"}, {"type": "subtitle", "time": 7039.709, "timestamp": "01:57:19", "text": "働く。えっと、私は何をしたの？"}, {"type": "subtitle", "time": 7043.669, "timestamp": "01:57:23", "text": "する？やらなきゃいけないんだ、普通のゲームで"}, {"type": "subtitle", "time": 7052.51, "timestamp": "01:57:32", "text": "わかった。皆さんにも聞こえると思います"}, {"type": "subtitle", "time": 7056.43, "timestamp": "01:57:36", "text": "まだ。よし、うまくいった。こんにちは。こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 7059.189, "timestamp": "01:57:39", "text": "こんにちは。配信へようこ​​そ。 1"}, {"type": "subtitle", "time": 7062.709, "timestamp": "01:57:42", "text": "いらっしゃいませ。幸せな土曜日、幸せな木曜日。希望"}, {"type": "subtitle", "time": 7064.709, "timestamp": "01:57:44", "text": "あなたはよくやっています。死んだ"}, {"type": "subtitle", "time": 7066.95, "timestamp": "01:57:46", "text": "マッチ。まだウォーミングアップが終わってない。その"}, {"type": "subtitle", "time": 7068.589, "timestamp": "01:57:48", "text": "わかった。このゲームは5年間プレイしていません"}, {"type": "subtitle", "time": 7071.31, "timestamp": "01:57:51", "text": "年。ああ、でもそれは"}, {"type": "subtitle", "time": 7075.91, "timestamp": "01:57:55", "text": "わかった。知っている。自分の能力は分かっています。"}, {"type": "subtitle", "time": 7078.31, "timestamp": "01:57:58", "text": "ヘッドショットを狙える自信がない"}]
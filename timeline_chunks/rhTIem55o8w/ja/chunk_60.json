[{"type": "subtitle", "time": 3600.39, "timestamp": "01:00:00", "text": "クリップやその他すべてのチャンネル"}, {"type": "subtitle", "time": 3603.43, "timestamp": "01:00:03", "text": "チャンネルにショートパンツ、うん"}, {"type": "subtitle", "time": 3605.349, "timestamp": "01:00:05", "text": "Twitchなどからのクリップです。"}, {"type": "subtitle", "time": 3608.39, "timestamp": "01:00:08", "text": "垂直ポートに変換します"}, {"type": "subtitle", "time": 3611.71, "timestamp": "01:00:11", "text": "フォーマットか何かで、私が望むように"}, {"type": "subtitle", "time": 3615.829, "timestamp": "01:00:15", "text": "今日中にアップロードしてください。"}, {"type": "subtitle", "time": 3619.589, "timestamp": "01:00:19", "text": "古いストリームをワンショットするだけ"}, {"type": "subtitle", "time": 3621.91, "timestamp": "01:00:21", "text": "Twitchにあるクリップなら何でもやります"}, {"type": "subtitle", "time": 3624.589, "timestamp": "01:00:24", "text": "古いものから新しいものへ、ただ"}, {"type": "subtitle", "time": 3628.92, "timestamp": "01:00:28", "text": "知っているものをすべてアップロードして"}, {"type": "subtitle", "time": 3631.63, "timestamp": "01:00:31", "text": "[音楽]"}, {"type": "subtitle", "time": 3638.51, "timestamp": "01:00:38", "text": "えっと、"}, {"type": "subtitle", "time": 3642.71, "timestamp": "01:00:42", "text": "それ。それから私は、えっと、それは、"}, {"type": "subtitle", "time": 3658.75, "timestamp": "01:00:58", "text": "何かしたいので"}]
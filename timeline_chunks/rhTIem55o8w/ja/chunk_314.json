[{"type": "subtitle", "time": 18846.47, "timestamp": "05:14:06", "text": "1つ目は、一緒に食事をすることができるとき"}, {"type": "subtitle", "time": 18848.03, "timestamp": "05:14:08", "text": "週末。"}, {"type": "subtitle", "time": 18849.8, "timestamp": "05:14:09", "text": "まさにその通り"}, {"type": "subtitle", "time": 18869.15, "timestamp": "05:14:29", "text": "[音楽]"}, {"type": "subtitle", "time": 18872.39, "timestamp": "05:14:32", "text": "ええと、彼女は長期的には何も得られないでしょう。"}, {"type": "subtitle", "time": 18874.03, "timestamp": "05:14:34", "text": "はい、わかりました"}, {"type": "subtitle", "time": 18879.51, "timestamp": "05:14:39", "text": "それ。えっと、ロク。つまり、Rokuは依然として"}, {"type": "subtitle", "time": 18883.03, "timestamp": "05:14:43", "text": "会社の仕事はまだ午後6時までです。"}, {"type": "subtitle", "time": 18884.83, "timestamp": "05:14:44", "text": "6時まで"}, {"type": "subtitle", "time": 18897.948, "timestamp": "05:14:57", "text": "ねえ、土曜日はどこ？どこ"}]
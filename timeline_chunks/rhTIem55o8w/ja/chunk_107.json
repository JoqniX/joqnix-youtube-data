[{"type": "subtitle", "time": 6421.59, "timestamp": "01:47:01", "text": "右。それでは、そろそろ失礼します。"}, {"type": "subtitle", "time": 6423.75, "timestamp": "01:47:03", "text": "仕事がある。わかった。気をつけて。感謝"}, {"type": "subtitle", "time": 6425.91, "timestamp": "01:47:05", "text": "あなたが私の投稿を止めてくれたことは、本当に大きな意味があります。"}, {"type": "subtitle", "time": 6428.79, "timestamp": "01:47:08", "text": "実りある一日をお過ごしください。わかった。ハッピー"}, {"type": "subtitle", "time": 6438.149, "timestamp": "01:47:18", "text": "今日は考えなければならないことがある。えっと、私は"}, {"type": "subtitle", "time": 6439.08, "timestamp": "01:47:19", "text": "無料"}, {"type": "subtitle", "time": 6456.629, "timestamp": "01:47:36", "text": "時間？なぜ人生は辛いのか？入手困難"}, {"type": "subtitle", "time": 6467.149, "timestamp": "01:47:47", "text": "私のクリスマスはどこ？"}, {"type": "subtitle", "time": 6476.629, "timestamp": "01:47:56", "text": "年。クリスマスはどうなったの？"}, {"type": "subtitle", "time": 6479.669, "timestamp": "01:47:59", "text": "美術？それは私の別のPCにあったのでしょうか？言わないで"}]
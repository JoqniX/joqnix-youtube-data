[{"type": "subtitle", "time": 9375.67, "timestamp": "02:36:15", "text": "ショットガン。戻ってくる。戻ってくる。"}, {"type": "subtitle", "time": 9397.75, "timestamp": "02:36:37", "text": "始まります。ああ、血液検査をするんですね"}, {"type": "subtitle", "time": 9401.03, "timestamp": "02:36:41", "text": "テストか。"}, {"type": "subtitle", "time": 9404.07, "timestamp": "02:36:44", "text": "試合は私が泣いているのにうまくいっています"}, {"type": "subtitle", "time": 9406.15, "timestamp": "02:36:46", "text": "叫び声。行け！行け！行け。つまり、それは"}]
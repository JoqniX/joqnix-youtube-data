[{"type": "subtitle", "time": 7383.589, "timestamp": "02:03:03", "text": "私はスパム行為が好きかもしれません。私は"}, {"type": "subtitle", "time": 7406.95, "timestamp": "02:03:26", "text": "時々、ジャンクは従兄弟みたいなものだと思う"}, {"type": "subtitle", "time": 7419.55, "timestamp": "02:03:39", "text": "コース"}, {"type": "subtitle", "time": 7421.31, "timestamp": "02:03:41", "text": "の"}, {"type": "subtitle", "time": 7423.149, "timestamp": "02:03:43", "text": "わかった。"}, {"type": "subtitle", "time": 7426.43, "timestamp": "02:03:46", "text": "ああ、朝のチャイ。"}, {"type": "subtitle", "time": 7430.189, "timestamp": "02:03:50", "text": "はい。聞こえなかった"}, {"type": "subtitle", "time": 7433.31, "timestamp": "02:03:53", "text": "彼とドッジ"}, {"type": "subtitle", "time": 7436.229, "timestamp": "02:03:56", "text": "そこには。待って。真剣モードに切り替えます"}, {"type": "subtitle", "time": 7438.189, "timestamp": "02:03:58", "text": "モード。これは"}]
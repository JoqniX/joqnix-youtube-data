[{"type": "subtitle", "time": 4202.229, "timestamp": "01:10:02", "text": "三つ。このコードでは、"}, {"type": "subtitle", "time": 4208.55, "timestamp": "01:10:08", "text": "YouTubeではなぜ3つに制限されているのですか？"}, {"type": "subtitle", "time": 4212.79, "timestamp": "01:10:12", "text": "ガイドラインでは、何が必要かさえも"}, {"type": "subtitle", "time": 4215.75, "timestamp": "01:10:15", "text": "言って、文字数制限は60文字です。"}, {"type": "subtitle", "time": 4218.31, "timestamp": "01:10:18", "text": "文字 キャラクターがあります"}, {"type": "chat", "time": 4219.831, "timestamp": "01:10:19", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "And you was selling the devil’s lettuce"}, {"type": "subtitle", "time": 4221.669, "timestamp": "01:10:21", "text": "こちらも60文字までという制限があります。"}, {"type": "subtitle", "time": 4224.03, "timestamp": "01:10:24", "text": "のように"}, {"type": "subtitle", "time": 4227.11, "timestamp": "01:10:27", "text": "兄弟、ウェルカムメッセージをピン留めして"}, {"type": "subtitle", "time": 4237.149, "timestamp": "01:10:37", "text": "悪魔のルールを売っていた"}, {"type": "subtitle", "time": 4240.55, "timestamp": "01:10:40", "text": "レタス。しかしそれは18歳とみなされる"}, {"type": "subtitle", "time": 4243.83, "timestamp": "01:10:43", "text": "さらにストリーミング配信もする。多分そうすべきだった"}, {"type": "subtitle", "time": 4247.149, "timestamp": "01:10:47", "text": "コメントを固定するか、"}, {"type": "subtitle", "time": 4250.87, "timestamp": "01:10:50", "text": "何かがそうでないかどうかを確認する"}, {"type": "subtitle", "time": 4254.63, "timestamp": "01:10:54", "text": "ジョッカソン配信。もし私がちゃんとしたものを欲しかったら"}, {"type": "subtitle", "time": 4257.99, "timestamp": "01:10:57", "text": "スケジュール1にあるようにその試合をストリーミング配信する。"}]
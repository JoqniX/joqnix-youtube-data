[{"type": "subtitle", "time": 20288.11, "timestamp": "05:38:08", "text": "サキは待って"}, {"type": "subtitle", "time": 20291.75, "timestamp": "05:38:11", "text": "作品は網羅的なリストのようなものですよね。"}, {"type": "subtitle", "time": 20294.51, "timestamp": "05:38:14", "text": "物のリスト"}, {"type": "subtitle", "time": 20296.43, "timestamp": "05:38:16", "text": "えっと、"}, {"type": "subtitle", "time": 20299.23, "timestamp": "05:38:19", "text": "好き"}, {"type": "subtitle", "time": 20302.07, "timestamp": "05:38:22", "text": "私は本を​​持って行かなければならないので、"}, {"type": "subtitle", "time": 20320.67, "timestamp": "05:38:40", "text": "[音楽]"}, {"type": "subtitle", "time": 20324.07, "timestamp": "05:38:44", "text": "戻る。よし、これが答えだと思う"}, {"type": "subtitle", "time": 20325.83, "timestamp": "05:38:45", "text": "大丈夫でしょう。たとえそれが"}, {"type": "subtitle", "time": 20328.788, "timestamp": "05:38:48", "text": "間違いです、大丈夫です。私は私は手に入れるでしょう"}, {"type": "subtitle", "time": 20331.59, "timestamp": "05:38:51", "text": "先生が訂正してくれたら、修正します。"}, {"type": "subtitle", "time": 20332.83, "timestamp": "05:38:52", "text": "そしてそれを学ぶ"}, {"type": "subtitle", "time": 20335.548, "timestamp": "05:38:55", "text": "また。わかった。 4つ目。"}, {"type": "subtitle", "time": 20337.99, "timestamp": "05:38:57", "text": "ああ、わかった。 4つ目。正しくする"}, {"type": "subtitle", "time": 20339.628, "timestamp": "05:38:59", "text": "文。"}]
[{"type": "subtitle", "time": 1941.509, "timestamp": "00:32:21", "text": "そろそろ規制を強化し始めるべきだと思う"}, {"type": "subtitle", "time": 1945.63, "timestamp": "00:32:25", "text": "なぜなら、私たちはより厳しいルールを持っていて、"}, {"type": "subtitle", "time": 1949.509, "timestamp": "00:32:29", "text": "ガイドラインと、次のような人が来る"}, {"type": "subtitle", "time": 1952.549, "timestamp": "00:32:32", "text": "これと荒らしといいね"}, {"type": "subtitle", "time": 1954.63, "timestamp": "00:32:34", "text": "好きなことを何でも言って、"}, {"type": "subtitle", "time": 1957.549, "timestamp": "00:32:37", "text": "良くないですし"}, {"type": "subtitle", "time": 1965.35, "timestamp": "00:32:45", "text": "ああ、私たちはこう思うべきだと思う"}, {"type": "subtitle", "time": 1968.269, "timestamp": "00:32:48", "text": "ルールをより厳しく適用し、"}, {"type": "subtitle", "time": 1970.58, "timestamp": "00:32:50", "text": "罰則、タイムアウト、禁止、または"}, {"type": "subtitle", "time": 1973.07, "timestamp": "00:32:53", "text": "[音楽]"}, {"type": "subtitle", "time": 1978.34, "timestamp": "00:32:58", "text": "それが行き過ぎたとしても、何があっても構わない。"}]
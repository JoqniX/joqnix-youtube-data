[{"type": "subtitle", "time": 18541.03, "timestamp": "05:09:01", "text": "右。つまり、私は"}, {"type": "subtitle", "time": 18546.59, "timestamp": "05:09:06", "text": "今？"}, {"type": "subtitle", "time": 18551.628, "timestamp": "05:09:11", "text": "92 92 93 94 95"}, {"type": "subtitle", "time": 18553.55, "timestamp": "05:09:13", "text": "96. わかりました、"}, {"type": "subtitle", "time": 18557.55, "timestamp": "05:09:17", "text": "良い。次はこれ。両方と"}, {"type": "subtitle", "time": 18567.23, "timestamp": "05:09:27", "text": "今日中に終わらせられるだろうか？"}, {"type": "subtitle", "time": 18569.99, "timestamp": "05:09:29", "text": "わかった。こういうのはスキップしてもいいですか？"}, {"type": "subtitle", "time": 18571.99, "timestamp": "05:09:31", "text": "もの？それは後でできます。私にさせて"}, {"type": "subtitle", "time": 18575.11, "timestamp": "05:09:35", "text": "よろしければ、スピードランをお願いします。ここです"}, {"type": "subtitle", "time": 18576.99, "timestamp": "05:09:36", "text": "括弧内"}]
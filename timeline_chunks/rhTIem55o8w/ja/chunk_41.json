[{"type": "subtitle", "time": 2460.15, "timestamp": "00:41:00", "text": "それが私が決して"}, {"type": "subtitle", "time": 2461.63, "timestamp": "00:41:01", "text": "した"}, {"type": "subtitle", "time": 2464.309, "timestamp": "00:41:04", "text": "手数料も。私は実際に"}, {"type": "subtitle", "time": 2467.19, "timestamp": "00:41:07", "text": "スキルを訓練して、私のスキルを"}, {"type": "subtitle", "time": 2470.23, "timestamp": "00:41:10", "text": "見栄えが悪く、より良いので、"}, {"type": "subtitle", "time": 2473.55, "timestamp": "00:41:13", "text": "少なくともクライアントに製品を提供するか、"}, {"type": "subtitle", "time": 2476.95, "timestamp": "00:41:16", "text": "顧客が満足できる場所"}, {"type": "subtitle", "time": 2480.23, "timestamp": "00:41:20", "text": "中途半端な仕事をするのではなく、"}, {"type": "subtitle", "time": 2483.03, "timestamp": "00:41:23", "text": "本当に粗悪な作りで"}, {"type": "subtitle", "time": 2484.91, "timestamp": "00:41:24", "text": "それ"}, {"type": "subtitle", "time": 2487.23, "timestamp": "00:41:27", "text": "外。右。"}, {"type": "subtitle", "time": 2489.55, "timestamp": "00:41:29", "text": "ええ、私たちは"}, {"type": "subtitle", "time": 2494.39, "timestamp": "00:41:34", "text": "それ。それに、私は楽な道を選びたくない。"}, {"type": "subtitle", "time": 2497.43, "timestamp": "00:41:37", "text": "AI音楽などあらゆるものを活用する方法。"}, {"type": "subtitle", "time": 2499.87, "timestamp": "00:41:39", "text": "いや、それはちょっと"}, {"type": "subtitle", "time": 2502.349, "timestamp": "00:41:42", "text": "バカ。"}, {"type": "subtitle", "time": 2506.23, "timestamp": "00:41:46", "text": "うん。だから私は「うん」って感じだったんだ。"}, {"type": "subtitle", "time": 2508.309, "timestamp": "00:41:48", "text": "それらはすでに私の"}, {"type": "subtitle", "time": 2511.51, "timestamp": "00:41:51", "text": "計画は、私がすでに望んでいたとおりです"}, {"type": "subtitle", "time": 2513.27, "timestamp": "00:41:53", "text": "何か貢献する"}, {"type": "subtitle", "time": 2517.829, "timestamp": "00:41:57", "text": "コミュニティ、ですよね？何らかの形で。私"}]
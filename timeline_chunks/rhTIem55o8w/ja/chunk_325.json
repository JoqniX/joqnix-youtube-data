[{"type": "subtitle", "time": 19501.03, "timestamp": "05:25:01", "text": "わからない。あ、待って。たぶん、たぶん"}, {"type": "subtitle", "time": 19503.11, "timestamp": "05:25:03", "text": "実際の例を挙げる"}, {"type": "subtitle", "time": 19504.868, "timestamp": "05:25:04", "text": "テスト。わからない。漢字を書く"}, {"type": "subtitle", "time": 19507.75, "timestamp": "05:25:07", "text": "読んでいるところは、これは飛ばします。わかった。えっと、"}, {"type": "subtitle", "time": 19509.35, "timestamp": "05:25:09", "text": "漢字の読みをローマ字で書きます"}, {"type": "subtitle", "time": 19512.628, "timestamp": "05:25:12", "text": "アルファベット。ああ、ここで「オーケー」にたどり着きました。えっと、"}, {"type": "subtitle", "time": 19519.55, "timestamp": "05:25:19", "text": "見えますか？わかった。"}, {"type": "subtitle", "time": 19530.23, "timestamp": "05:25:30", "text": "えっと、Q。待って、私の"}, {"type": "subtitle", "time": 19532.59, "timestamp": "05:25:32", "text": "心。"}, {"type": "subtitle", "time": 19534.39, "timestamp": "05:25:34", "text": "[音楽]"}, {"type": "subtitle", "time": 19550.868, "timestamp": "05:25:50", "text": "大丈夫です。わかった。これが漢字です"}, {"type": "subtitle", "time": 19551.948, "timestamp": "05:25:51", "text": "Q"}]
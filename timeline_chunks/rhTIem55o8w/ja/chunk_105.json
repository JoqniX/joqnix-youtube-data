[{"type": "subtitle", "time": 6318.27, "timestamp": "01:45:18", "text": "[音楽]"}, {"type": "subtitle", "time": 6327.91, "timestamp": "01:45:27", "text": "ダイヤモンドの色には、"}, {"type": "subtitle", "time": 6330.149, "timestamp": "01:45:30", "text": "私と遊ぶには、最低限の血が必要だ。何てことだ"}, {"type": "subtitle", "time": 6332.109, "timestamp": "01:45:32", "text": "あなたは"}, {"type": "subtitle", "time": 6334.59, "timestamp": "01:45:34", "text": "ダイヤモンド。"}, {"type": "subtitle", "time": 6337.39, "timestamp": "01:45:37", "text": "聖なる。それは"}, {"type": "subtitle", "time": 6339.83, "timestamp": "01:45:39", "text": "おお。はい、起動しました。発売されました。"}, {"type": "subtitle", "time": 6346.47, "timestamp": "01:45:46", "text": "発売されました。 PCも"}, {"type": "subtitle", "time": 6350.39, "timestamp": "01:45:50", "text": "PC全体が動作が遅い。そうそう。ああ、閉まった"}, {"type": "subtitle", "time": 6354.229, "timestamp": "01:45:54", "text": "それ自体が落ちていく。上向きの要素がある。このゲームは、"}, {"type": "subtitle", "time": 6356.27, "timestamp": "01:45:56", "text": "このゲーム、このゲーム、このゲーム、この"}, {"type": "subtitle", "time": 6359.07, "timestamp": "01:45:59", "text": "ゲーム。なぜアップデートがあるのですか？"}]
[{"type": "subtitle", "time": 17162.39, "timestamp": "04:46:02", "text": "パーティー。パーティーをしよう。うん、何か"}, {"type": "subtitle", "time": 17165.67, "timestamp": "04:46:05", "text": "そんな感じ。私は時間を無駄にしています"}, {"type": "subtitle", "time": 17168.788, "timestamp": "04:46:08", "text": "説明：わかってるけど大丈夫だよ。こんにちは。えっと"}, {"type": "subtitle", "time": 17170.55, "timestamp": "04:46:10", "text": "聞く代わりに、"}, {"type": "subtitle", "time": 17172.868, "timestamp": "04:46:12", "text": "これを読んでください。よし、練習してみよう。"}, {"type": "subtitle", "time": 17174.39, "timestamp": "04:46:14", "text": "練習が必要だ。練習が必要だ"}, {"type": "subtitle", "time": 17190.11, "timestamp": "04:46:30", "text": "えーと"}, {"type": "subtitle", "time": 17197.868, "timestamp": "04:46:37", "text": "はい、これはぎの漢字です"}, {"type": "subtitle", "time": 17200.19, "timestamp": "04:46:40", "text": "くじ"}]
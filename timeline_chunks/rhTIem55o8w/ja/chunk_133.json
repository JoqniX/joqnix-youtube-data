[{"type": "subtitle", "time": 7986.069, "timestamp": "02:13:06", "text": "大丈夫。それを受け取って。それを受け取って。それを受け取って。"}, {"type": "subtitle", "time": 7994.069, "timestamp": "02:13:14", "text": "あの雨でみんな死んでしまうなんて、どういうこと？最後"}, {"type": "subtitle", "time": 7997.27, "timestamp": "02:13:17", "text": "選手の立ち位置。敵はあと一体。"}, {"type": "subtitle", "time": 8027.99, "timestamp": "02:13:47", "text": "ニース。テキストを完全に無効にするにはどうすればよいですか？"}, {"type": "subtitle", "time": 8030.149, "timestamp": "02:13:50", "text": "チャット？彼らはその機能を持つべきだ"}, {"type": "subtitle", "time": 8039.43, "timestamp": "02:13:59", "text": "行け！行け！行け。"}]
[{"type": "subtitle", "time": 17404.43, "timestamp": "04:50:04", "text": "8i ハイ G ハイ"}, {"type": "subtitle", "time": 17431.99, "timestamp": "04:50:31", "text": "ハンハンハンは"}, {"type": "subtitle", "time": 17434.03, "timestamp": "04:50:34", "text": "えーとハン"}, {"type": "subtitle", "time": 17436.868, "timestamp": "04:50:36", "text": "漢字。えっと、アニメ見ますか？はい、私は"}, {"type": "subtitle", "time": 17439.59, "timestamp": "04:50:39", "text": "私のアニメリストのプロフィールを持っています。ただ"}, {"type": "subtitle", "time": 17442.31, "timestamp": "04:50:42", "text": "私を探してみてください。私のアニメリストを見てください"}, {"type": "subtitle", "time": 17445.39, "timestamp": "04:50:45", "text": "そして、次に「drop」と入力するだけです。私の"}, {"type": "subtitle", "time": 17447.51, "timestamp": "04:50:47", "text": "私が観ているものや"}, {"type": "subtitle", "time": 17452.628, "timestamp": "04:50:52", "text": "命令があったはずなのに忘れてしまった"}, {"type": "subtitle", "time": 17457.07, "timestamp": "04:50:57", "text": "それ？"}]
[{"type": "subtitle", "time": 16980.23, "timestamp": "04:43:00", "text": "カタカ・カリーヌとは何だったのですか？何が"}, {"type": "subtitle", "time": 16982.628, "timestamp": "04:43:02", "text": "これはまたどういう意味ですか？"}, {"type": "subtitle", "time": 16987.27, "timestamp": "04:43:07", "text": "これは生データです。これはとても素晴らしい。わかった。株式会社"}, {"type": "subtitle", "time": 16990.27, "timestamp": "04:43:10", "text": "じゃあ、車ってどうやって書くの？"}, {"type": "subtitle", "time": 16999.628, "timestamp": "04:43:19", "text": "[音楽]"}, {"type": "subtitle", "time": 17003.35, "timestamp": "04:43:23", "text": "K. いいえ、Cは違います。それはひらがなです。"}, {"type": "subtitle", "time": 17004.74, "timestamp": "04:43:24", "text": "Cは"}, {"type": "subtitle", "time": 17006.03, "timestamp": "04:43:26", "text": "[音楽]"}, {"type": "subtitle", "time": 17018.708, "timestamp": "04:43:38", "text": "また？いいえ、それはナレーションです。それはVです。いいえ、"}, {"type": "subtitle", "time": 17032.23, "timestamp": "04:43:52", "text": "それ。それはまるで銃のようだ。それはまるで銃のようだ。"}, {"type": "subtitle", "time": 17033.868, "timestamp": "04:43:53", "text": "あなたもそう思ってるでしょ"}, {"type": "subtitle", "time": 17039.35, "timestamp": "04:43:59", "text": "すでに。了解。カキ株式会社わかった。カキ"}]
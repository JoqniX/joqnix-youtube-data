[{"type": "subtitle", "time": 10381.389, "timestamp": "02:53:01", "text": "[音楽]"}, {"type": "subtitle", "time": 10389.19, "timestamp": "02:53:09", "text": "君は独特で可愛らしい子供っぽいアクセントを持っているね。"}, {"type": "subtitle", "time": 10390.87, "timestamp": "02:53:10", "text": "私を信じて。ああ、ありがとうございます。それが理由です"}, {"type": "subtitle", "time": 10394.15, "timestamp": "02:53:14", "text": "ええと、他の多くの人が言っていたように、私は"}, {"type": "subtitle", "time": 10395.75, "timestamp": "02:53:15", "text": "このインドのアプリでストリーミング配信"}, {"type": "subtitle", "time": 10398.469, "timestamp": "02:53:18", "text": "モッズですよね？いくつかあった"}, {"type": "subtitle", "time": 10401.87, "timestamp": "02:53:21", "text": "気味が悪い。ああ、それは"}, {"type": "subtitle", "time": 10404.389, "timestamp": "02:53:24", "text": "痛み。うん。それが女の子か女の子か見てください"}, {"type": "subtitle", "time": 10428.389, "timestamp": "02:53:48", "text": "最後に残ったプレイヤー。 Aを急降下させる。"}]
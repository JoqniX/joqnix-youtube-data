[{"type": "subtitle", "time": 10862.11, "timestamp": "03:01:02", "text": "ナイフによる刺傷。それは私が必要としているもののひとつです"}, {"type": "subtitle", "time": 10864.03, "timestamp": "03:01:04", "text": "止める"}, {"type": "subtitle", "time": 10867.349, "timestamp": "03:01:07", "text": "実行中。ナイフを使うのをやめろ。"}, {"type": "subtitle", "time": 10870.07, "timestamp": "03:01:10", "text": "ナイフで刺す、つまりこの物を取り出す"}, {"type": "subtitle", "time": 10873.469, "timestamp": "03:01:13", "text": "ナイフナイフと、ナイフをするように"}, {"type": "subtitle", "time": 10876.03, "timestamp": "03:01:16", "text": "それは何かだ。する必要がある"}, {"type": "subtitle", "time": 10887.469, "timestamp": "03:01:27", "text": "私は死んだ。下。急落"}, {"type": "subtitle", "time": 10906.55, "timestamp": "03:01:46", "text": "いや、フェニックスは文字通りたくさんの人を殺した"}, {"type": "subtitle", "time": 10915.11, "timestamp": "03:01:55", "text": "人々。私たちはどのように死んでいくのか？ああ、俺たちは"}]
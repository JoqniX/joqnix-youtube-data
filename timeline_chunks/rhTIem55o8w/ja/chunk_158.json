[{"type": "subtitle", "time": 9480.55, "timestamp": "02:38:00", "text": "下？"}, {"type": "subtitle", "time": 9493.75, "timestamp": "02:38:13", "text": "私の準備はできています。"}, {"type": "subtitle", "time": 9522.11, "timestamp": "02:38:42", "text": "音はわかるよ、兄弟。来る"}, {"type": "subtitle", "time": 9525.469, "timestamp": "02:38:45", "text": "の上。よし、ゆっくり演奏しよう"}]
[{"type": "subtitle", "time": 12963.11, "timestamp": "03:36:03", "text": "少ない。望むならそうすればいい。ええ、私は"}, {"type": "subtitle", "time": 12966.07, "timestamp": "03:36:06", "text": "分けたかったけど、私は"}, {"type": "subtitle", "time": 12968.95, "timestamp": "03:36:08", "text": "すでにこれ持ってたよね？えっと"}, {"type": "subtitle", "time": 12972.389, "timestamp": "03:36:12", "text": "YouTube も両方欲しかった"}, {"type": "subtitle", "time": 12976.469, "timestamp": "03:36:16", "text": "えーと、YouTubeの詐欺師"}, {"type": "subtitle", "time": 12979.269, "timestamp": "03:36:19", "text": "待って、私はあなたに電話したり電話したりした"}, {"type": "subtitle", "time": 12982.309, "timestamp": "03:36:22", "text": "みんなYouTubeファミリーは古い"}, {"type": "subtitle", "time": 12986.389, "timestamp": "03:36:26", "text": "1つとオランダの家族、つまりそれはまだ"}, {"type": "subtitle", "time": 12989.95, "timestamp": "03:36:29", "text": "私たちはまだ家族です"}, {"type": "subtitle", "time": 12991.95, "timestamp": "03:36:31", "text": "ファミリージョッキー"}, {"type": "subtitle", "time": 12995.75, "timestamp": "03:36:35", "text": "家族、そう、えっと、そういうことがあったんだ"}, {"type": "subtitle", "time": 12998.55, "timestamp": "03:36:38", "text": "過去には、YouTube と"}, {"type": "subtitle", "time": 13001.51, "timestamp": "03:36:41", "text": "そしてTwitchは、我々のように統合される"}, {"type": "subtitle", "time": 13004.55, "timestamp": "03:36:44", "text": "均等に成長するタイプのもの。"}, {"type": "subtitle", "time": 13006.79, "timestamp": "03:36:46", "text": "まるで競争みたいだったから。いいえ、いいえ、"}, {"type": "subtitle", "time": 13009.19, "timestamp": "03:36:49", "text": "競争ではない。最初は、"}, {"type": "subtitle", "time": 13011.87, "timestamp": "03:36:51", "text": "Twitch のようだった"}, {"type": "subtitle", "time": 13015.03, "timestamp": "03:36:55", "text": "数字は〇〇で、YouTubeは"}, {"type": "subtitle", "time": 13018.07, "timestamp": "03:36:58", "text": "その背後には欠けているものがある。 YouTube はできませんでした"}]
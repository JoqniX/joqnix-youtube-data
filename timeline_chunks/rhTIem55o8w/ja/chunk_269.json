[{"type": "subtitle", "time": 16140.229, "timestamp": "04:29:00", "text": "平均。何てことだ。私はJ.O.を書いています。"}, {"type": "subtitle", "time": 16141.469, "timestamp": "04:29:01", "text": "やり方を忘れた"}, {"type": "subtitle", "time": 16159.07, "timestamp": "04:29:19", "text": "それは"}, {"type": "subtitle", "time": 16162.83, "timestamp": "04:29:22", "text": "コンボ。私は何者なのか、なぜ私は存在するのか"}, {"type": "subtitle", "time": 16173.149, "timestamp": "04:29:33", "text": "C"}, {"type": "subtitle", "time": 16176.389, "timestamp": "04:29:36", "text": "G食G。そうです。そこには「Shoku」と書いてあります。"}, {"type": "subtitle", "time": 16178.87, "timestamp": "04:29:38", "text": "右？もう一度聞いてみましょう。私は行けません"}, {"type": "subtitle", "time": 16181.71, "timestamp": "04:29:41", "text": "戻る。あ、待って。私"}, {"type": "subtitle", "time": 16183.79, "timestamp": "04:29:43", "text": "できる"}]
[{"type": "subtitle", "time": 1021.43, "timestamp": "00:17:01", "text": "朝6時に起きて、いろいろする。私はいくつかことをしました、"}, {"type": "subtitle", "time": 1023.91, "timestamp": "00:17:03", "text": "運動も色々試してみた。飲んだ"}, {"type": "chat", "time": 1024.856, "timestamp": "00:17:04", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "lemme check the vod to see who did"}, {"type": "subtitle", "time": 1026.549, "timestamp": "00:17:06", "text": "水、バナナ、その他何でも食べました"}, {"type": "subtitle", "time": 1029.75, "timestamp": "00:17:09", "text": "おそらくそうするだろう、私はそれを試みている間に"}, {"type": "subtitle", "time": 1032.39, "timestamp": "00:17:12", "text": "仕事もその他諸々。レポートを作成する、"}, {"type": "subtitle", "time": 1033.909, "timestamp": "00:17:13", "text": "メールとその他すべてを書く、"}, {"type": "subtitle", "time": 1035.909, "timestamp": "00:17:15", "text": "DMとか、全部。私はすべてをやり遂げた"}, {"type": "subtitle", "time": 1038.189, "timestamp": "00:17:18", "text": "できる。そして私はとても"}, {"type": "subtitle", "time": 1041.23, "timestamp": "00:17:21", "text": "疲れた。えっと"}, {"type": "subtitle", "time": 1044.75, "timestamp": "00:17:24", "text": "うん、目"}, {"type": "chat", "time": 1049.715, "timestamp": "00:17:29", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "fk, we cant see chat"}, {"type": "chat", "time": 1055.654, "timestamp": "00:17:35", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "rip"}, {"type": "subtitle", "time": 1062.789, "timestamp": "00:17:42", "text": "スクリーンショット ああ、待って。私は勝つかもしれない"}, {"type": "subtitle", "time": 1064.789, "timestamp": "00:17:44", "text": "破棄。"}, {"type": "subtitle", "time": 1066.789, "timestamp": "00:17:46", "text": "これは新しいチャンネルだと思います。それは"}, {"type": "subtitle", "time": 1070.47, "timestamp": "00:17:50", "text": "荒らしか何かだろう。問題は私ではない"}, {"type": "subtitle", "time": 1074.31, "timestamp": "00:17:54", "text": "人々は留まってチェックするだろう"}, {"type": "subtitle", "time": 1077.59, "timestamp": "00:17:57", "text": "購読する前にまず確認してください"}, {"type": "subtitle", "time": 1078.66, "timestamp": "00:17:58", "text": "そして"}, {"type": "subtitle", "time": 1079.789, "timestamp": "00:17:59", "text": "[音楽]"}]
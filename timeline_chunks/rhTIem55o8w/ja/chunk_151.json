[{"type": "subtitle", "time": 9063.91, "timestamp": "02:31:03", "text": "あれは本当に美味しかった。前回は良かった。何？"}, {"type": "subtitle", "time": 9065.55, "timestamp": "02:31:05", "text": "最後の試合は"}, {"type": "subtitle", "time": 9068.71, "timestamp": "02:31:08", "text": "良い。それは良かった。私はキルを獲得しました"}, {"type": "subtitle", "time": 9071.51, "timestamp": "02:31:11", "text": "盲目。"}, {"type": "subtitle", "time": 9088.15, "timestamp": "02:31:28", "text": "彼らを探し出せ。"}, {"type": "subtitle", "time": 9090.95, "timestamp": "02:31:30", "text": "狩りが始まる。敵を発見。あなたは欲しい"}, {"type": "subtitle", "time": 9094.15, "timestamp": "02:31:34", "text": "遊ぶ？遊ぼう。敵を発見。"}, {"type": "subtitle", "time": 9109.19, "timestamp": "02:31:49", "text": "私は最善を尽くしました。 2キルできてよかった。"}]
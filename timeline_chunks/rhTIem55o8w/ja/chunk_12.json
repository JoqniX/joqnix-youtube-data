[{"type": "subtitle", "time": 721.23, "timestamp": "00:12:01", "text": "実践。要約を書きます"}, {"type": "subtitle", "time": 724.47, "timestamp": "00:12:04", "text": "昨日やったことをツイートして、それから"}, {"type": "subtitle", "time": 726.99, "timestamp": "00:12:06", "text": "そのツイートは"}, {"type": "subtitle", "time": 734.67, "timestamp": "00:12:14", "text": "右。えっと、問題は"}, {"type": "subtitle", "time": 739.949, "timestamp": "00:12:19", "text": "えっと、さっきも言ったように、私は"}, {"type": "subtitle", "time": 741.55, "timestamp": "00:12:21", "text": "日本"}, {"type": "subtitle", "time": 744.31, "timestamp": "00:12:24", "text": "そう、必要なものがたくさんある"}, {"type": "subtitle", "time": 747.91, "timestamp": "00:12:27", "text": "多くの例と同様に、それに備えるために"}, {"type": "subtitle", "time": 750.629, "timestamp": "00:12:30", "text": "荷物とかそういうもの"}, {"type": "subtitle", "time": 752.47, "timestamp": "00:12:32", "text": "そして、"}, {"type": "subtitle", "time": 755.11, "timestamp": "00:12:35", "text": "えっと、家族と時間を過ごしたりとか"}, {"type": "subtitle", "time": 758.75, "timestamp": "00:12:38", "text": "そして私は何もしていない"}, {"type": "subtitle", "time": 761.829, "timestamp": "00:12:41", "text": "それは私が自分のことだけに集中しているからです"}, {"type": "subtitle", "time": 764.87, "timestamp": "00:12:44", "text": "ストリーム。主にそれを優先してきた"}, {"type": "subtitle", "time": 767.67, "timestamp": "00:12:47", "text": "物事のバランスを取ろうとしながら、"}, {"type": "subtitle", "time": 770.19, "timestamp": "00:12:50", "text": "家族と過ごす時間も"}, {"type": "subtitle", "time": 772.87, "timestamp": "00:12:52", "text": "私自身も彼らと少し時間を過ごす"}, {"type": "subtitle", "time": 775.389, "timestamp": "00:12:55", "text": "少しずつ、私が飲むたびに少しずつ"}]
[{"type": "subtitle", "time": 9905.75, "timestamp": "02:45:05", "text": "私たちは勝った。それが、我々がその試合で望むことだ。"}, {"type": "subtitle", "time": 9923.11, "timestamp": "02:45:23", "text": "遊びたい？遊ぼう。いいえ。"}, {"type": "subtitle", "time": 9935.99, "timestamp": "02:45:35", "text": "はい。狩りの時間だ。"}, {"type": "subtitle", "time": 9940.07, "timestamp": "02:45:40", "text": "偵察機は破壊された。スパイクを打った。"}, {"type": "subtitle", "time": 9942.55, "timestamp": "02:45:42", "text": "気をつけて。"}]
[{"type": "subtitle", "time": 6845.75, "timestamp": "01:54:05", "text": "待って。もちろんできますよ。"}, {"type": "subtitle", "time": 6850.99, "timestamp": "01:54:10", "text": "ああ、ゲームがすごくカクカクして"}, {"type": "subtitle", "time": 6858.109, "timestamp": "01:54:18", "text": "の上。メニュー項目はスーパーワンのようなものです"}, {"type": "subtitle", "time": 6860.709, "timestamp": "01:54:20", "text": "現れる。待って、設定をクリックしてもいいですか？"}, {"type": "subtitle", "time": 6862.629, "timestamp": "01:54:22", "text": "お願いします？カチッ、カチッ、カチッ、カチッ。なぜ"}, {"type": "subtitle", "time": 6865.91, "timestamp": "01:54:25", "text": "読み込み中ですか？あなたにそうさせてあげたい"}, {"type": "subtitle", "time": 6868.149, "timestamp": "01:54:28", "text": "みんな、僕の画面で何が起こっているか見てよ。"}, {"type": "subtitle", "time": 6870.31, "timestamp": "01:54:30", "text": "もしそれがもしそれがもしそれがもし表示されるなら、あなたは"}, {"type": "subtitle", "time": 6873.27, "timestamp": "01:54:33", "text": "見る。ちょっと待って。試してみます"}, {"type": "subtitle", "time": 6877.55, "timestamp": "01:54:37", "text": "君ならできるよ。"}, {"type": "subtitle", "time": 6880.149, "timestamp": "01:54:40", "text": "設定。もう少しだけ。来て。"}, {"type": "subtitle", "time": 6881.31, "timestamp": "01:54:41", "text": "あなたは"}, {"type": "subtitle", "time": 6885.03, "timestamp": "01:54:45", "text": "これ。もう少しフレームレートを上げたい。あげて。"}, {"type": "subtitle", "time": 6885.79, "timestamp": "01:54:45", "text": "与える"}, {"type": "subtitle", "time": 6888.79, "timestamp": "01:54:48", "text": "それ。ビデオ。動画をクリックしてください。来て。私は"}, {"type": "subtitle", "time": 6892.189, "timestamp": "01:54:52", "text": "それをクリックしてください。動画を開いてください。"}, {"type": "subtitle", "time": 6895.39, "timestamp": "01:54:55", "text": "わかった。変化。変化。変化。変化"}, {"type": "subtitle", "time": 6897.91, "timestamp": "01:54:57", "text": "それ。ウィンドウ。全画面表示。来て。来る"}]
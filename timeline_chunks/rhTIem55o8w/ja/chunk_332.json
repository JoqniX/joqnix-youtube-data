[{"type": "subtitle", "time": 19921.15, "timestamp": "05:32:01", "text": "えっと、つまり"}, {"type": "subtitle", "time": 19924.35, "timestamp": "05:32:04", "text": "えっと、なんで画面が真っ暗になったの？待って、何？"}, {"type": "subtitle", "time": 19927.59, "timestamp": "05:32:07", "text": "何が起こったのか？はい、保存していませんでした。私はそうしました"}, {"type": "subtitle", "time": 19930.788, "timestamp": "05:32:10", "text": "ない。ちょっと待って、スクリーンショットを撮らせて。えっと、"}, {"type": "subtitle", "time": 19933.35, "timestamp": "05:32:13", "text": "私はどれくらい書いただろうか？"}, {"type": "subtitle", "time": 19935.51, "timestamp": "05:32:15", "text": "わかった。わかった。もう一度書きます。"}, {"type": "subtitle", "time": 19939.47, "timestamp": "05:32:19", "text": "大丈夫です。では、これは"}, {"type": "subtitle", "time": 19942.628, "timestamp": "05:32:22", "text": "えっと、それを学ぶ必要があるんです。これを記録しておきます。"}, {"type": "subtitle", "time": 19949.11, "timestamp": "05:32:29", "text": "接続詞でも、実際に確認してみます"}, {"type": "subtitle", "time": 19952.23, "timestamp": "05:32:32", "text": "素早い。ええと、場所を知っています。まるで"}, {"type": "subtitle", "time": 19956.67, "timestamp": "05:32:36", "text": "それはどこか"}, {"type": "subtitle", "time": 19960.59, "timestamp": "05:32:40", "text": "この辺りのどこか。えっと、"}, {"type": "subtitle", "time": 19964.15, "timestamp": "05:32:44", "text": "いいえ。この辺りのどこかにあるはずだ。知っている"}, {"type": "subtitle", "time": 19967.43, "timestamp": "05:32:47", "text": "あなたはここにいます。大きい方か小さい方か。"}, {"type": "subtitle", "time": 19970.19, "timestamp": "05:32:50", "text": "きっとそうだ"}, {"type": "subtitle", "time": 19978.628, "timestamp": "05:32:58", "text": "漢字。君たちのせいじゃないよ。もしこれらの人たちが"}]
[{"type": "subtitle", "time": 17103.628, "timestamp": "04:45:03", "text": "えっと、漢字３つ。それで"}, {"type": "subtitle", "time": 17115.948, "timestamp": "04:45:15", "text": "私のモヨビアは"}, {"type": "subtitle", "time": 17118.51, "timestamp": "04:45:18", "text": "姉は右年上です"}, {"type": "subtitle", "time": 17131.43, "timestamp": "04:45:31", "text": "ええと、火曜日。いや、違う、木曜日だ。うん、"}, {"type": "subtitle", "time": 17134.31, "timestamp": "04:45:34", "text": "もよみ。木曜日。木曜日。ああ、神様。私"}, {"type": "subtitle", "time": 17136.27, "timestamp": "04:45:36", "text": "まだ必要"}, {"type": "subtitle", "time": 17140.47, "timestamp": "04:45:40", "text": "練習する。わかった。えっと、これは土です"}, {"type": "subtitle", "time": 17144.868, "timestamp": "04:45:44", "text": "漢字。つまり、土曜日のことです。つまり、"}, {"type": "subtitle", "time": 17147.49, "timestamp": "04:45:47", "text": "土曜日。えっと"}, {"type": "subtitle", "time": 17158.51, "timestamp": "04:45:58", "text": "土曜日には"}]
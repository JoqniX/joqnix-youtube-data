[{"type": "subtitle", "time": 17820.47, "timestamp": "04:57:00", "text": "えっと、もう一度書いてみましょう。わかった。"}, {"type": "subtitle", "time": 17823.67, "timestamp": "04:57:03", "text": "太陽の漢字に"}, {"type": "subtitle", "time": 17828.27, "timestamp": "04:57:08", "text": "えー、えー、イチ、えー、うん、えー"}, {"type": "subtitle", "time": 17831.67, "timestamp": "04:57:11", "text": "待って、太陽と漢字って日本語だったっけ？"}, {"type": "subtitle", "time": 17834.628, "timestamp": "04:57:14", "text": "また忘れたよ、うん、孫の漢字"}, {"type": "subtitle", "time": 17836.19, "timestamp": "04:57:16", "text": "u"}, {"type": "subtitle", "time": 17847.83, "timestamp": "04:57:27", "text": "そうです、こちらです。はい。"}, {"type": "subtitle", "time": 17849.31, "timestamp": "04:57:29", "text": "それで大丈夫です"}, {"type": "subtitle", "time": 17868.91, "timestamp": "04:57:48", "text": "また。待って。ヨウジ。ああ、サンジじゃないんだな。"}, {"type": "subtitle", "time": 17874.868, "timestamp": "04:57:54", "text": "または、ここで彼らが言うこの言葉は"}, {"type": "subtitle", "time": 17877.27, "timestamp": "04:57:57", "text": "特別。"}]
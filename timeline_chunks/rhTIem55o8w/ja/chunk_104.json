[{"type": "subtitle", "time": 6245.27, "timestamp": "01:44:05", "text": "ええ、経験を積ませようと思います"}, {"type": "subtitle", "time": 6246.189, "timestamp": "01:44:06", "text": "の"}, {"type": "subtitle", "time": 6278.07, "timestamp": "01:44:38", "text": "わあ、それは素晴らしいですね。"}, {"type": "subtitle", "time": 6280.79, "timestamp": "01:44:40", "text": "彼らはランク戦で私と合流するだろう。えっと、もし私が"}, {"type": "subtitle", "time": 6285.189, "timestamp": "01:44:45", "text": "現在ランク付けされている"}, {"type": "subtitle", "time": 6288.149, "timestamp": "01:44:48", "text": "順位はついていないので"}, {"type": "subtitle", "time": 6291.59, "timestamp": "01:44:51", "text": "私はランクを得るために一生懸命働かなければならない"}, {"type": "subtitle", "time": 6294.229, "timestamp": "01:44:54", "text": "他の人たちと一緒に列に並ぶ理由が妥当である"}, {"type": "subtitle", "time": 6297.109, "timestamp": "01:44:57", "text": "起動しないので、再生ボタンを押しました。"}, {"type": "subtitle", "time": 6299.629, "timestamp": "01:44:59", "text": "過去5分"}]
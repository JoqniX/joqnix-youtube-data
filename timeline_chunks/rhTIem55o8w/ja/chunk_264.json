[{"type": "subtitle", "time": 15840.59, "timestamp": "04:24:00", "text": "わかった。少し復習しておいてよかった"}, {"type": "subtitle", "time": 15849.83, "timestamp": "04:24:09", "text": "金曜日ですか？見る？はい、今日は木曜日です。"}, {"type": "subtitle", "time": 15851.59, "timestamp": "04:24:11", "text": "あれ、火曜日って言ったっけ？待って、待って、"}, {"type": "subtitle", "time": 15854.189, "timestamp": "04:24:14", "text": "待って。火曜日に言ったが、"}, {"type": "subtitle", "time": 15857.189, "timestamp": "04:24:17", "text": "私？ああ、今日は火曜日じゃない。今日は木曜日です。"}, {"type": "subtitle", "time": 15863.149, "timestamp": "04:24:23", "text": "私のミスです。火曜日はキョウビです。キョービ"}, {"type": "subtitle", "time": 15867.67, "timestamp": "04:24:27", "text": "モクイは木曜日になります。こんにちは。 3番目"}, {"type": "subtitle", "time": 15883.389, "timestamp": "04:24:43", "text": "朝。おお、"}, {"type": "subtitle", "time": 15887.03, "timestamp": "04:24:47", "text": "待って。待って。はい、これが順番です。"}, {"type": "subtitle", "time": 15897.75, "timestamp": "04:24:57", "text": "靴は"}]
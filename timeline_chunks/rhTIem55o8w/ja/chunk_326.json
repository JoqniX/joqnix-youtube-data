[{"type": "subtitle", "time": 19561.868, "timestamp": "05:26:01", "text": "グオミルク。"}, {"type": "subtitle", "time": 19566.708, "timestamp": "05:26:06", "text": "うーんのみまさのみこの漢字はタブです"}, {"type": "subtitle", "time": 19570.948, "timestamp": "05:26:10", "text": "そして、この一品を合わせると、うーん"}, {"type": "subtitle", "time": 19575.15, "timestamp": "05:26:15", "text": "飲む。私の答えは"}, {"type": "subtitle", "time": 19578.23, "timestamp": "05:26:18", "text": "ローマ字またはひらがなを使用してください。いや"}, {"type": "subtitle", "time": 19585.51, "timestamp": "05:26:25", "text": "いいえ。"}, {"type": "subtitle", "time": 19610.17, "timestamp": "05:26:50", "text": "su"}]
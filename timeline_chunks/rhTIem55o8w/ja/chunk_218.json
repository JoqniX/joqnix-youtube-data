[{"type": "subtitle", "time": 13081.269, "timestamp": "03:38:01", "text": "その時私が言おうとしていたことを言う"}, {"type": "subtitle", "time": 13084.87, "timestamp": "03:38:04", "text": "では、要約に入りましょうか。"}, {"type": "subtitle", "time": 13087.269, "timestamp": "03:38:07", "text": "今日やればまた大丈夫。大丈夫、"}, {"type": "subtitle", "time": 13090.03, "timestamp": "03:38:10", "text": "右？要約を確認していません。"}, {"type": "subtitle", "time": 13097.63, "timestamp": "03:38:17", "text": "確認していません。わかった。"}, {"type": "subtitle", "time": 13100.389, "timestamp": "03:38:20", "text": "ええと、わかりました。えっと、何て言おうとしてたんだっけ？"}, {"type": "subtitle", "time": 13102.87, "timestamp": "03:38:22", "text": "V2であることは本当に大変なんです。のように、"}, {"type": "subtitle", "time": 13104.87, "timestamp": "03:38:24", "text": "たくさんのことを戦略的に考えなければならない"}, {"type": "subtitle", "time": 13107.51, "timestamp": "03:38:27", "text": "そして、多くのことをじっくり考える。"}, {"type": "subtitle", "time": 13111.229, "timestamp": "03:38:31", "text": "最近は、現実世界での活動にもっと力を入れているので"}, {"type": "subtitle", "time": 13113.59, "timestamp": "03:38:33", "text": "そういうことですよね？"}, {"type": "subtitle", "time": 13116.79, "timestamp": "03:38:36", "text": "えーっと、取得は"}, {"type": "subtitle", "time": 13119.91, "timestamp": "03:38:39", "text": "PCを開くだけではなく、"}, {"type": "subtitle", "time": 13122.309, "timestamp": "03:38:42", "text": "PC の電源を入れて、PS を開いて、"}, {"type": "subtitle", "time": 13123.309, "timestamp": "03:38:43", "text": "行く"}, {"type": "subtitle", "time": 13125.75, "timestamp": "03:38:45", "text": "そのまま生きて、ただやるだけ"}, {"type": "subtitle", "time": 13129.83, "timestamp": "03:38:49", "text": "何でも。それはとても違う、あなたのように"}, {"type": "subtitle", "time": 13133.349, "timestamp": "03:38:53", "text": "もちろんそうすることもできますが、"}, {"type": "subtitle", "time": 13136.389, "timestamp": "03:38:56", "text": "それもしない方がいい。とても"}]
[{"type": "subtitle", "time": 3960.43, "timestamp": "01:06:00", "text": "椅子で寝るなんて、"}, {"type": "chat", "time": 3966.76, "timestamp": "01:06:06", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "Why"}, {"type": "chat", "time": 3972.807, "timestamp": "01:06:12", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "The pride getting in the way"}, {"type": "subtitle", "time": 3976.19, "timestamp": "01:06:16", "text": "多くの。ベッドがあります"}, {"type": "subtitle", "time": 3980.309, "timestamp": "01:06:20", "text": "近くの小川の部屋。"}, {"type": "chat", "time": 3984.513, "timestamp": "01:06:24", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "You are very wrong my dear friend"}, {"type": "subtitle", "time": 3987.109, "timestamp": "01:06:27", "text": "そこには。賞が邪魔になっている。"}, {"type": "subtitle", "time": 3989.75, "timestamp": "01:06:29", "text": "いいえ、今ストリーミング配信中だからです。その"}, {"type": "chat", "time": 3991.975, "timestamp": "01:06:31", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "I have slept on my chair"}, {"type": "subtitle", "time": 3996.829, "timestamp": "01:06:36", "text": "朝。その"}, {"type": "subtitle", "time": 3999.789, "timestamp": "01:06:39", "text": "朝。もう一つ欲しい"}, {"type": "subtitle", "time": 4004.71, "timestamp": "01:06:44", "text": "男のような人、通りかかった荒らし"}, {"type": "subtitle", "time": 4007.029, "timestamp": "01:06:47", "text": "「寝ているなんて恥を知れ」"}, {"type": "subtitle", "time": 4010.47, "timestamp": "01:06:50", "text": "「ストリーム」というコメントが再び起こる。"}, {"type": "subtitle", "time": 4012.95, "timestamp": "01:06:52", "text": "私は既にそのコメントに影響を受けています"}, {"type": "chat", "time": 4013.598, "timestamp": "01:06:53", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "10/10 I (don’t) recommend "}]
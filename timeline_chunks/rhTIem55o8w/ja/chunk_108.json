[{"type": "subtitle", "time": 6480.95, "timestamp": "01:48:00", "text": "私の場合、それは反対側にあります。ああ、神様。わかった。"}, {"type": "subtitle", "time": 6483.59, "timestamp": "01:48:03", "text": "わかった。わかった。それは"}, {"type": "subtitle", "time": 6484.91, "timestamp": "01:48:04", "text": "他の"}, {"type": "subtitle", "time": 6487.35, "timestamp": "01:48:07", "text": "PC。こんにちは。"}, {"type": "subtitle", "time": 6490.109, "timestamp": "01:48:10", "text": "私はテーマを持っています。わかった。私は"}, {"type": "subtitle", "time": 6493.47, "timestamp": "01:48:13", "text": "テーマ性のある。今日はクリスマス気分です。"}, {"type": "subtitle", "time": 6500.59, "timestamp": "01:48:20", "text": "良い。久しぶりですね。"}, {"type": "subtitle", "time": 6504.39, "timestamp": "01:48:24", "text": "いいえ。私はどれくらい前から"}, {"type": "subtitle", "time": 6506.91, "timestamp": "01:48:26", "text": "これらのストリーミングのために"}, {"type": "subtitle", "time": 6509.87, "timestamp": "01:48:29", "text": "日？私"}, {"type": "subtitle", "time": 6512.35, "timestamp": "01:48:32", "text": "忘れた。しかし"}, {"type": "subtitle", "time": 6524.43, "timestamp": "01:48:44", "text": "のように"}, {"type": "subtitle", "time": 6527.669, "timestamp": "01:48:47", "text": "雪。自分がやっているこの擦り傷が気に入ってる。私"}, {"type": "subtitle", "time": 6528.91, "timestamp": "01:48:48", "text": "気にしない"}, {"type": "subtitle", "time": 6531.69, "timestamp": "01:48:51", "text": "それ。あなたなの？"}]
[{"type": "subtitle", "time": 20044.35, "timestamp": "05:34:04", "text": "ニマス"}, {"type": "subtitle", "time": 20049.39, "timestamp": "05:34:09", "text": "そして、ath 漢字は"}, {"type": "subtitle", "time": 20052.788, "timestamp": "05:34:12", "text": "えっと、7番目には漢字がないよ"}, {"type": "subtitle", "time": 20054.27, "timestamp": "05:34:14", "text": "しなければならない"}, {"type": "subtitle", "time": 20057.51, "timestamp": "05:34:17", "text": "ああ、7番目には漢字がなかった"}, {"type": "subtitle", "time": 20064.99, "timestamp": "05:34:24", "text": "1つ。ああ、そうそう。ああ、これだ。"}, {"type": "subtitle", "time": 20068.788, "timestamp": "05:34:28", "text": "オキアシ。あたらし。わかった。あたらし。新しい。"}, {"type": "subtitle", "time": 20072.27, "timestamp": "05:34:32", "text": "わかった。わかった。わかった。これを勉強する必要がある。"}, {"type": "subtitle", "time": 20074.59, "timestamp": "05:34:34", "text": "おお。"}, {"type": "subtitle", "time": 20077.15, "timestamp": "05:34:37", "text": "わかった。これは"}, {"type": "subtitle", "time": 20086.15, "timestamp": "05:34:46", "text": "わかった。これをスクリーンショットしておきます。"}, {"type": "subtitle", "time": 20088.628, "timestamp": "05:34:48", "text": "ノートか何かに書き込んでください。"}, {"type": "subtitle", "time": 20099.03, "timestamp": "05:34:59", "text": "意味。えっと、100だったよね？"}]
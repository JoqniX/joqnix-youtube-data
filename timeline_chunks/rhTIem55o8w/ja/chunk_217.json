[{"type": "subtitle", "time": 13021.469, "timestamp": "03:37:01", "text": "かなり上まで"}, {"type": "subtitle", "time": 13024.429, "timestamp": "03:37:04", "text": "立ち上がって"}, {"type": "subtitle", "time": 13029.87, "timestamp": "03:37:09", "text": "えっと、今はTwitchを席巻しています"}, {"type": "subtitle", "time": 13033.469, "timestamp": "03:37:13", "text": "そんな家族もいたんです。だから私は"}, {"type": "subtitle", "time": 13035.15, "timestamp": "03:37:15", "text": "のように、"}, {"type": "subtitle", "time": 13037.55, "timestamp": "03:37:17", "text": "ええと、それは"}, {"type": "subtitle", "time": 13041.95, "timestamp": "03:37:21", "text": "まあ、それでもいいでしょう。それでも、私たちは団結している"}, {"type": "subtitle", "time": 13051.87, "timestamp": "03:37:31", "text": "だから私はこう思った、そうすれば"}, {"type": "subtitle", "time": 13055.55, "timestamp": "03:37:35", "text": "おそらくその時は複数ページにわたって処理していたのだろう。私"}, {"type": "subtitle", "time": 13058.389, "timestamp": "03:37:38", "text": "そうだな、と思った。それから、それからもう"}, {"type": "subtitle", "time": 13062.229, "timestamp": "03:37:42", "text": "問題は、他のプラットフォームです"}, {"type": "subtitle", "time": 13064.349, "timestamp": "03:37:44", "text": "ストリーミングを試みています"}, {"type": "subtitle", "time": 13068.87, "timestamp": "03:37:48", "text": "そう、それも私が"}, {"type": "subtitle", "time": 13070.51, "timestamp": "03:37:50", "text": "考えなければならない"}, {"type": "subtitle", "time": 13073.59, "timestamp": "03:37:53", "text": "まあ、そういうことの一つは"}, {"type": "subtitle", "time": 13077.269, "timestamp": "03:37:57", "text": "それは難しい、あ、待って、私たちは、私は"}, {"type": "subtitle", "time": 13079.11, "timestamp": "03:37:59", "text": "このトピックをクリアするために私がしようとしていること"}]
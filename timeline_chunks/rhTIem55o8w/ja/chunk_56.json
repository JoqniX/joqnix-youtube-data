[{"type": "subtitle", "time": 3369.19, "timestamp": "00:56:09", "text": "うん。私のモデルはどこにいますか？ちょっと見てみましょう。"}, {"type": "subtitle", "time": 3371.67, "timestamp": "00:56:11", "text": "見てみてください。なぜそんなに"}, {"type": "subtitle", "time": 3379.349, "timestamp": "00:56:19", "text": "質問チャレンジがあります。ハチミツって何？"}, {"type": "chat", "time": 3379.819, "timestamp": "00:56:19", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "Joq. I dare you to play Minecraft with mods and hardcore"}, {"type": "subtitle", "time": 3381.19, "timestamp": "00:56:21", "text": "でも心配しないで、"}, {"type": "subtitle", "time": 3384.23, "timestamp": "00:56:24", "text": "少なくとも時間の経過に伴うシルエットをモデル化する。私"}, {"type": "subtitle", "time": 3391.91, "timestamp": "00:56:31", "text": "もの。私はマインクラフトとMODをプレイする勇気がある"}, {"type": "subtitle", "time": 3398.39, "timestamp": "00:56:38", "text": "えっと、私はすでにマインクラフトをプレイしました。しないで"}, {"type": "subtitle", "time": 3400.95, "timestamp": "00:56:40", "text": "そのゲームをやり過ぎさせてください。私は"}, {"type": "subtitle", "time": 3408.39, "timestamp": "00:56:48", "text": "ソウルシリーズをプレイするのも構わないし、"}, {"type": "subtitle", "time": 3410.549, "timestamp": "00:56:50", "text": "もし余裕があれば、そんな感じのものが欲しい。"}, {"type": "subtitle", "time": 3412.39, "timestamp": "00:56:52", "text": "もしくはエレン・リングとか、そんな感じの名前。"}, {"type": "chat", "time": 3412.601, "timestamp": "00:56:52", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "okay maybe for when you are better-"}]
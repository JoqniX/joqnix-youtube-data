[{"type": "subtitle", "time": 6600.39, "timestamp": "01:50:00", "text": "午後。"}, {"type": "subtitle", "time": 6608.669, "timestamp": "01:50:08", "text": "そして、実に多くのこと。"}, {"type": "subtitle", "time": 6612.229, "timestamp": "01:50:12", "text": "聖なる。うん。でも、まあいいでしょう。 77%。ほとんど"}, {"type": "subtitle", "time": 6616.75, "timestamp": "01:50:16", "text": "わかった。"}, {"type": "subtitle", "time": 6620.149, "timestamp": "01:50:20", "text": "うん。この頃になると、"}, {"type": "subtitle", "time": 6621.149, "timestamp": "01:50:21", "text": "右？"}, {"type": "subtitle", "time": 6626.229, "timestamp": "01:50:26", "text": "午後9時30分えっと、あまり多くの人が"}, {"type": "subtitle", "time": 6627.55, "timestamp": "01:50:27", "text": "アクティブまたは"}, {"type": "subtitle", "time": 6629.83, "timestamp": "01:50:29", "text": "なんて言うんだっけ？入ることができます、"}, {"type": "subtitle", "time": 6632.87, "timestamp": "01:50:32", "text": "右？数人が"}, {"type": "subtitle", "time": 6635.07, "timestamp": "01:50:35", "text": "皆さんが来られる場合"}, {"type": "subtitle", "time": 6638.95, "timestamp": "01:50:38", "text": "まるで私がストリーミングしたいと思ったように"}, {"type": "subtitle", "time": 6642.47, "timestamp": "01:50:42", "text": "夜のスロットですが、夜のスロットは常に"}, {"type": "subtitle", "time": 6646.149, "timestamp": "01:50:46", "text": "まあ、もっと忙しくなると思う。しかしおそらく"}, {"type": "subtitle", "time": 6648.39, "timestamp": "01:50:48", "text": "将来も、私は"}, {"type": "subtitle", "time": 6650.47, "timestamp": "01:50:50", "text": "ストリーム"}, {"type": "subtitle", "time": 6653.91, "timestamp": "01:50:53", "text": "えーと、夜間は、"}, {"type": "subtitle", "time": 6656.43, "timestamp": "01:50:56", "text": "悲しい"}, {"type": "subtitle", "time": 6659.51, "timestamp": "01:50:59", "text": "この時期になるともっとこうなるだろう"}]
[{"type": "subtitle", "time": 9860.469, "timestamp": "02:44:20", "text": "再装填中。"}, {"type": "subtitle", "time": 9863.11, "timestamp": "02:44:23", "text": "わかった。よし、これでいい。"}, {"type": "subtitle", "time": 9876.309, "timestamp": "02:44:36", "text": "ああ、あれは本当に愚かなことだった。それは本当に愚かなことだった。"}, {"type": "subtitle", "time": 9877.67, "timestamp": "02:44:37", "text": "それは本当に愚かなことだった。それは本当に愚かなことだった。それ"}, {"type": "subtitle", "time": 9880.71, "timestamp": "02:44:40", "text": "本当にバカだった。撤回します。でもあなたは"}, {"type": "subtitle", "time": 9884.15, "timestamp": "02:44:44", "text": "勝利。大丈夫です。私は失敗しました"}, {"type": "subtitle", "time": 9886.87, "timestamp": "02:44:46", "text": "かわいい。何と言っていいかわからない。私"}]
[{"type": "subtitle", "time": 9541.15, "timestamp": "02:39:01", "text": "再装填中。ロッキング"}, {"type": "subtitle", "time": 9544.83, "timestamp": "02:39:04", "text": "タバコを吸う。引き戻せ。引き戻せ。引く"}, {"type": "subtitle", "time": 9548.07, "timestamp": "02:39:08", "text": "戻る。急落した。"}, {"type": "subtitle", "time": 9550.469, "timestamp": "02:39:10", "text": "急落。 A."}, {"type": "subtitle", "time": 9553.59, "timestamp": "02:39:13", "text": "私はスパイクを持っています。"}, {"type": "subtitle", "time": 9556.51, "timestamp": "02:39:16", "text": "敵を発見。"}, {"type": "subtitle", "time": 9564.55, "timestamp": "02:39:24", "text": "視力。再装填してください。ああ。なぜ暑いのか？なぜ"}, {"type": "subtitle", "time": 9580.71, "timestamp": "02:39:40", "text": "これは難しい。皆さんはどうやってプレイしますか？"}, {"type": "subtitle", "time": 9582.67, "timestamp": "02:39:42", "text": "これ"}, {"type": "subtitle", "time": 9585.389, "timestamp": "02:39:45", "text": "ゲーム？理解できない"}, {"type": "subtitle", "time": 9588.87, "timestamp": "02:39:48", "text": "それ。うん。ポジショニングは、確かにそうですね。"}, {"type": "subtitle", "time": 9595.03, "timestamp": "02:39:55", "text": "右。元気かい、ジャ？私は"}]
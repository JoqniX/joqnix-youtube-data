[{"type": "subtitle", "time": 7682.51, "timestamp": "02:08:02", "text": "なぜ？そしてヴァラーとトニーでさえ"}, {"type": "subtitle", "time": 7686.43, "timestamp": "02:08:06", "text": "Roaxを許可する。冗談でしょ？"}, {"type": "subtitle", "time": 7701.03, "timestamp": "02:08:21", "text": "N Axelがライブ配信中です。なぜ？私は生きていけない"}, {"type": "subtitle", "time": 7702.35, "timestamp": "02:08:22", "text": "それなし"}, {"type": "subtitle", "time": 7706.069, "timestamp": "02:08:26", "text": "それ。どうして60でプレイできるんだろう？待って、どうやって"}, {"type": "subtitle", "time": 7709.35, "timestamp": "02:08:29", "text": "私はいくつのゲームで遊んでいますか？現在使用しているDPIはいくつですか？"}, {"type": "subtitle", "time": 7715.589, "timestamp": "02:08:35", "text": "忘れた。カビゴン。いいえ。ええと、ロアクセル。それ"}, {"type": "subtitle", "time": 7718.55, "timestamp": "02:08:38", "text": "1つ。大好きです。私はプレイしているのを見ました"}, {"type": "subtitle", "time": 7721.589, "timestamp": "02:08:41", "text": "解像度は11,000 DPIのままです。君たちは忘れたのか？"}, {"type": "subtitle", "time": 7724.95, "timestamp": "02:08:44", "text": "それ？ええと、今のあのストリームのように、"}, {"type": "subtitle", "time": 7727.669, "timestamp": "02:08:47", "text": "11,000に変更しました。私のお気に入りは"}, {"type": "subtitle", "time": 7728.99, "timestamp": "02:08:48", "text": "番号は"}, {"type": "subtitle", "time": 7739.31, "timestamp": "02:08:59", "text": "11."}]
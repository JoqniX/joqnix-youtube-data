[{"type": "subtitle", "time": 364.15, "timestamp": "00:06:04", "text": "ストリーム。そう、つまりそういうことなんだけど"}, {"type": "subtitle", "time": 366.59, "timestamp": "00:06:06", "text": "流れの第二部、夜"}, {"type": "subtitle", "time": 369.07, "timestamp": "00:06:09", "text": "ストリーム、パート2"}, {"type": "subtitle", "time": 372.79, "timestamp": "00:06:12", "text": "ストリーム、私は最善を尽くして、えーと、"}, {"type": "subtitle", "time": 375.27, "timestamp": "00:06:15", "text": "それに注意を払い、それを実行するように"}, {"type": "subtitle", "time": 378.07, "timestamp": "00:06:18", "text": "私が早く寝た理由は、"}, {"type": "subtitle", "time": 381.35, "timestamp": "00:06:21", "text": "スケジュールを調整して、もっとエネルギッシュに過ごせるようにする"}, {"type": "subtitle", "time": 383.749, "timestamp": "00:06:23", "text": "朝の小川では、これは"}, {"type": "subtitle", "time": 385.909, "timestamp": "00:06:25", "text": "ストリーム、新しいストリームのパート1"}, {"type": "subtitle", "time": 388.749, "timestamp": "00:06:28", "text": "日。"}, {"type": "subtitle", "time": 391.35, "timestamp": "00:06:31", "text": "私には分かりません。それは"}, {"type": "subtitle", "time": 393.30899999999997, "timestamp": "00:06:33", "text": "ランダムな人または"}, {"type": "subtitle", "time": 396.15, "timestamp": "00:06:36", "text": "何か。子供か何かかもしれない。私"}, {"type": "subtitle", "time": 397.95, "timestamp": "00:06:37", "text": "しないで"}, {"type": "subtitle", "time": 400.87, "timestamp": "00:06:40", "text": "知る。おい、なんで寝てるんだよ"}, {"type": "subtitle", "time": 403.029, "timestamp": "00:06:43", "text": "とかそういうの？そして彼らはこう言った、"}, {"type": "subtitle", "time": 405.71, "timestamp": "00:06:45", "text": "「恥を知れ、とか何とか。」私は"}, {"type": "subtitle", "time": 408.189, "timestamp": "00:06:48", "text": "のように、"}, {"type": "subtitle", "time": 411.79, "timestamp": "00:06:51", "text": "「兄弟よ、私の立場になってくれ。"}, {"type": "subtitle", "time": 415.11, "timestamp": "00:06:55", "text": "4ヶ月間、3人に対して24時間体制で"}, {"type": "subtitle", "time": 418.55, "timestamp": "00:06:58", "text": "真っ直ぐ。そうすれば、私がなぜ"}]
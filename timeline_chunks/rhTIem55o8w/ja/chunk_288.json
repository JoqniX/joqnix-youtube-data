[{"type": "subtitle", "time": 17280.07, "timestamp": "04:48:00", "text": "どういう意味ですか？アニメの声へようこそ"}, {"type": "subtitle", "time": 17281.47, "timestamp": "04:48:01", "text": "の"}, {"type": "subtitle", "time": 17284.11, "timestamp": "04:48:04", "text": "ストリーム。えっと"}, {"type": "subtitle", "time": 17286.788, "timestamp": "04:48:06", "text": "カイシャワ カイシャワは会社が好きです"}, {"type": "subtitle", "time": 17289.99, "timestamp": "04:48:09", "text": "勤務時間は会社の勤務時間です"}, {"type": "subtitle", "time": 17290.91, "timestamp": "04:48:10", "text": "から"}, {"type": "subtitle", "time": 17293.31, "timestamp": "04:48:13", "text": "9"}, {"type": "subtitle", "time": 17298.83, "timestamp": "04:48:18", "text": "午前9時から午後5時までえっと"}, {"type": "subtitle", "time": 17301.788, "timestamp": "04:48:21", "text": "5時30分。うん。 9から"}, {"type": "subtitle", "time": 17306.47, "timestamp": "04:48:26", "text": "5時30分。えーと、土曜日と日曜日、えーと"}, {"type": "subtitle", "time": 17309.83, "timestamp": "04:48:29", "text": "今日は休息日なので、彼は行かないだろう。"}, {"type": "subtitle", "time": 17313.11, "timestamp": "04:48:33", "text": "やすみやすみ。こんにちは。やろう"}, {"type": "subtitle", "time": 17315.99, "timestamp": "04:48:35", "text": "エクササイズ。わかった。何時から何時まで"}, {"type": "subtitle", "time": 17323.948, "timestamp": "04:48:43", "text": "ニカラ。これは何語ですか？これは"}, {"type": "subtitle", "time": 17327.59, "timestamp": "04:48:47", "text": "日本語。わかった。 149から152。"}, {"type": "subtitle", "time": 17329.55, "timestamp": "04:48:49", "text": "それ。"}, {"type": "subtitle", "time": 17331.708, "timestamp": "04:48:51", "text": "えっと"}, {"type": "subtitle", "time": 17335.59, "timestamp": "04:48:55", "text": "149. ああ、私はたくさん書きました。はぁ？おお、"}]
[{"type": "subtitle", "time": 12901.51, "timestamp": "03:35:01", "text": "YouTubeチャットでYouTubeフィードを送信する"}, {"type": "subtitle", "time": 12905.429, "timestamp": "03:35:05", "text": "著作権で保護された音楽を使用したTwitchフィード"}, {"type": "subtitle", "time": 12909.349, "timestamp": "03:35:09", "text": "そして、Twitchチャットも。私もそういう人間です"}, {"type": "subtitle", "time": 12912.55, "timestamp": "03:35:12", "text": "今ではたくさんの選択肢とテクノロジーがあります"}, {"type": "subtitle", "time": 12914.51, "timestamp": "03:35:14", "text": "そこにも、そして"}, {"type": "subtitle", "time": 12919.67, "timestamp": "03:35:19", "text": "それを実行するためのハードウェアリソースがない、といった具合です。"}, {"type": "subtitle", "time": 12921.91, "timestamp": "03:35:21", "text": "例えば、ゲーム配信をしていると、"}, {"type": "subtitle", "time": 12924.87, "timestamp": "03:35:24", "text": "少し面倒なことになるだろう。でも、もし私が"}, {"type": "subtitle", "time": 12928.389, "timestamp": "03:35:28", "text": "ゲーム配信をするなら、大丈夫でしょう。私はできる"}, {"type": "subtitle", "time": 12931.469, "timestamp": "03:35:31", "text": "そうしてください。私はそれをしたい"}, {"type": "subtitle", "time": 12933.71, "timestamp": "03:35:33", "text": "未来。"}, {"type": "subtitle", "time": 12935.55, "timestamp": "03:35:35", "text": "うん。"}, {"type": "subtitle", "time": 12938.59, "timestamp": "03:35:38", "text": "だから、でも知りたいのは"}, {"type": "subtitle", "time": 12942.07, "timestamp": "03:35:42", "text": "みんなは私のゲーム配信が好き？"}, {"type": "subtitle", "time": 12945.51, "timestamp": "03:35:45", "text": "私と話すのは好きですか？"}, {"type": "subtitle", "time": 12948.15, "timestamp": "03:35:48", "text": "なぜなら私はこういうトークストリームを"}, {"type": "subtitle", "time": 12959.229, "timestamp": "03:35:59", "text": "私がこれらのトークストリームを行う方法"}]
[{"type": "subtitle", "time": 60.47, "timestamp": "00:01:00", "text": "36日目、今日は管理の日です。今日"}, {"type": "subtitle", "time": 61.83, "timestamp": "00:01:01", "text": "私が書き留めるもの"}, {"type": "subtitle", "time": 64.27, "timestamp": "00:01:04", "text": "私たちがこれから行うこと"}, {"type": "subtitle", "time": 67.91, "timestamp": "00:01:07", "text": "今日は音楽をやります。私たちは"}, {"type": "subtitle", "time": 71.99, "timestamp": "00:01:11", "text": "音楽とか色々やって、えーと"}, {"type": "subtitle", "time": 74.67, "timestamp": "00:01:14", "text": "サウンドデザインを実験したり、"}, {"type": "subtitle", "time": 78.31, "timestamp": "00:01:18", "text": "実際に最善を尽くして"}, {"type": "subtitle", "time": 80.91, "timestamp": "00:01:20", "text": "何か"}, {"type": "subtitle", "time": 85.23, "timestamp": "00:01:25", "text": "それ。何かがおかしい。"}, {"type": "subtitle", "time": 87.469, "timestamp": "00:01:27", "text": "ではなぜ私の"}, {"type": "subtitle", "time": 90.91, "timestamp": "00:01:30", "text": "モデルがジッターするので"}, {"type": "subtitle", "time": 106.22999999999999, "timestamp": "00:01:46", "text": "2番。ええ、私のモデルはすごくうるさいんです。"}, {"type": "subtitle", "time": 109.19, "timestamp": "00:01:49", "text": "はい、次にそれをさらに行います。"}, {"type": "subtitle", "time": 111.22999999999999, "timestamp": "00:01:51", "text": "だから、私は"}]
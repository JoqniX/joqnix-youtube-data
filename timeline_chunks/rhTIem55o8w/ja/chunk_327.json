[{"type": "subtitle", "time": 19621.43, "timestamp": "05:27:01", "text": "スル ス オオ オオ サンプル オーケー スル ゴッド イット"}, {"type": "subtitle", "time": 19624.708, "timestamp": "05:27:04", "text": "時間がかかるので、読書の練習が必要です"}, {"type": "subtitle", "time": 19627.59, "timestamp": "05:27:07", "text": "こんな状況でどうやって試験を受ければいいの？"}, {"type": "subtitle", "time": 19637.868, "timestamp": "05:27:17", "text": "自分。"}, {"type": "subtitle", "time": 19640.51, "timestamp": "05:27:20", "text": "いや、違うよ。"}, {"type": "subtitle", "time": 19653.548, "timestamp": "05:27:33", "text": "飲む。"}, {"type": "subtitle", "time": 19662.27, "timestamp": "05:27:42", "text": "ジハン。六自半。"}, {"type": "subtitle", "time": 19673.15, "timestamp": "05:27:53", "text": "えっと。えっと。六自半。えっと。了解。オキマス。"}, {"type": "subtitle", "time": 19676.548, "timestamp": "05:27:56", "text": "わかった。ジハン。わかった。えーと、漢字の読み方、"}, {"type": "subtitle", "time": 19678.27, "timestamp": "05:27:58", "text": "右？"}]
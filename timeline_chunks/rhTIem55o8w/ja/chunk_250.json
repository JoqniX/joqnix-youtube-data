[{"type": "subtitle", "time": 15002.95, "timestamp": "04:10:02", "text": "こちらにあるのが問題番号です。"}, {"type": "subtitle", "time": 15006.469, "timestamp": "04:10:06", "text": "わかった。例えば、"}, {"type": "subtitle", "time": 15008.389, "timestamp": "04:10:08", "text": "現在レッスン10に取り組んでいます。"}, {"type": "subtitle", "time": 15011.429, "timestamp": "04:10:11", "text": "これはオーディオの数を意味します"}, {"type": "subtitle", "time": 15015.51, "timestamp": "04:10:15", "text": "私がアップロードしたものです。ということで、143かな。うん。"}, {"type": "subtitle", "time": 15019.51, "timestamp": "04:10:19", "text": "それでは、レッスン10です。わかりました。 2つ目は"}, {"type": "subtitle", "time": 15022.309, "timestamp": "04:10:22", "text": "レッスン10。これが今回のセッションです。"}, {"type": "subtitle", "time": 15025.51, "timestamp": "04:10:25", "text": "そしてこれが問題です。まず最初にこれらすべてを"}, {"type": "subtitle", "time": 15028.87, "timestamp": "04:10:28", "text": "何もない一つは"}, {"type": "subtitle", "time": 15032.59, "timestamp": "04:10:32", "text": "質問音声、例えば、これをやってみよう"}, {"type": "subtitle", "time": 15035.429, "timestamp": "04:10:35", "text": "リスニングの質問のような質問または"}, {"type": "subtitle", "time": 15038.55, "timestamp": "04:10:38", "text": "会話の質問など、もし"}, {"type": "subtitle", "time": 15041.389, "timestamp": "04:10:41", "text": "何もない何かがある"}, {"type": "subtitle", "time": 15044.87, "timestamp": "04:10:44", "text": "下線を引いて、ここに何か"}, {"type": "subtitle", "time": 15047.51, "timestamp": "04:10:47", "text": "日本語のように、いつもこうです"}, {"type": "subtitle", "time": 15049.59, "timestamp": "04:10:49", "text": "質問なので、もしあなたが"}, {"type": "subtitle", "time": 15052.469, "timestamp": "04:10:52", "text": "宿題をする、これをやる、日本語"}, {"type": "subtitle", "time": 15054.389, "timestamp": "04:10:54", "text": "1から7まであります。これらは"}, {"type": "subtitle", "time": 15057.429, "timestamp": "04:10:57", "text": "リスニングに関する質問"}, {"type": "subtitle", "time": 15058.68, "timestamp": "04:10:58", "text": "質問 答え。つまり、それを書かなければならないということです"}]
[{"type": "subtitle", "time": 9193.349, "timestamp": "02:33:13", "text": "待って。"}, {"type": "subtitle", "time": 9225.75, "timestamp": "02:33:45", "text": "行け！行け！行け。"}, {"type": "subtitle", "time": 9228.71, "timestamp": "02:33:48", "text": "いや、あれは私が今までした中で一番愚かなことだった"}, {"type": "subtitle", "time": 9230.79, "timestamp": "02:33:50", "text": "私の人生全体において。次に話しました"}, {"type": "subtitle", "time": 9232.27, "timestamp": "02:33:52", "text": "に"}, {"type": "subtitle", "time": 9235.99, "timestamp": "02:33:55", "text": "君のせいかもしれないけど、後悔はしていない。私は飛び乗った"}]
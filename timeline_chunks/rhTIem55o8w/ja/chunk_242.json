[{"type": "subtitle", "time": 14524.469, "timestamp": "04:02:04", "text": "ハワ、長文になってしまって本当にごめんなさい。"}, {"type": "subtitle", "time": 14528.389, "timestamp": "04:02:08", "text": "つまり、BBがロードを開始するということです。何てことだ、"}, {"type": "subtitle", "time": 14529.309, "timestamp": "04:02:09", "text": "私はただ"}, {"type": "subtitle", "time": 14538.269, "timestamp": "04:02:18", "text": "今気づいたんだけど、忘れてた"}, {"type": "subtitle", "time": 14541.67, "timestamp": "04:02:21", "text": "開く。いいえ、水を飲むのを忘れました"}, {"type": "subtitle", "time": 14544.11, "timestamp": "04:02:24", "text": "ボトル。それで、私は走った"}, {"type": "subtitle", "time": 14553.87, "timestamp": "04:02:33", "text": "戻る。させて"}, {"type": "subtitle", "time": 14560.309, "timestamp": "04:02:40", "text": "[音楽]"}, {"type": "subtitle", "time": 14563.349, "timestamp": "04:02:43", "text": "さて、ご視聴いただいている皆様へ、"}]
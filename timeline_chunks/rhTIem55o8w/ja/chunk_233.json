[{"type": "subtitle", "time": 13982.15, "timestamp": "03:53:02", "text": "要約みたいなもの"}, {"type": "subtitle", "time": 13990.87, "timestamp": "03:53:10", "text": "YouTube の問題は、"}, {"type": "subtitle", "time": 13996.75, "timestamp": "03:53:16", "text": "例えば、あなたがプレイしているカテゴリーは"}, {"type": "subtitle", "time": 14000.229, "timestamp": "03:53:20", "text": "ヴァレラント、そしてもし私が切り替えたいなら"}, {"type": "subtitle", "time": 14001.91, "timestamp": "03:53:21", "text": "そんなに簡単じゃないし、私は"}, {"type": "subtitle", "time": 14002.99, "timestamp": "03:53:22", "text": "違う"}, {"type": "subtitle", "time": 14005.75, "timestamp": "03:53:25", "text": "ストリーム配信と視聴に来る人々"}, {"type": "subtitle", "time": 14007.59, "timestamp": "03:53:27", "text": "彼らは「ああ、ジョーはいいプレーをしている」と言うだろう"}, {"type": "subtitle", "time": 14010.87, "timestamp": "03:53:30", "text": "でも彼らがテレビをつけると、ああ彼は"}, {"type": "subtitle", "time": 14014.71, "timestamp": "03:53:34", "text": "単にその問題についてチャットしているだけですが、Twitch"}, {"type": "subtitle", "time": 14017.87, "timestamp": "03:53:37", "text": "その方が簡単だ。その方が簡単だ。その"}, {"type": "subtitle", "time": 14026.349, "timestamp": "03:53:46", "text": "[音楽]"}, {"type": "subtitle", "time": 14030.429, "timestamp": "03:53:50", "text": "右？大丈夫。それで、"}, {"type": "subtitle", "time": 14034.79, "timestamp": "03:53:54", "text": "終わり。えっと、1時間やってみたいんだけど"}, {"type": "subtitle", "time": 14035.95, "timestamp": "03:53:55", "text": "ストリーム"}]
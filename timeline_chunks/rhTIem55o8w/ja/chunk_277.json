[{"type": "subtitle", "time": 16624.629, "timestamp": "04:37:04", "text": "正しい。待って、待って、違う。ムヨビは"}, {"type": "subtitle", "time": 16626.99, "timestamp": "04:37:06", "text": "木曜日。待って、待って、"}, {"type": "subtitle", "time": 16632.23, "timestamp": "04:37:12", "text": "待って。ゲッツィ・マンデー。火曜日はキョウビです。"}, {"type": "subtitle", "time": 16640.75, "timestamp": "04:37:20", "text": "あぁ、忘れてた。大豆。"}, {"type": "subtitle", "time": 16645.349, "timestamp": "04:37:25", "text": "ああ、ロードする必要がある。わかった、わかった。いらっしゃいませ"}, {"type": "subtitle", "time": 16646.949, "timestamp": "04:37:26", "text": "みんな。配信へようこ​​そ。私たちは"}, {"type": "subtitle", "time": 16649.59, "timestamp": "04:37:29", "text": "むごと運動。終わらせる必要がある"}, {"type": "subtitle", "time": 16651.429, "timestamp": "04:37:31", "text": "宿題。現在10位です"}, {"type": "subtitle", "time": 16653.189, "timestamp": "04:37:33", "text": "レッスン。私たちは8つのレッスンを受けなければならない"}, {"type": "subtitle", "time": 16656.269, "timestamp": "04:37:36", "text": "今日中に宿題を提出します。"}, {"type": "subtitle", "time": 16659.429, "timestamp": "04:37:39", "text": "では、一緒に学んでいきましょう。月曜日"}, {"type": "subtitle", "time": 16662.59, "timestamp": "04:37:42", "text": "火曜日はBに行くことを意味します。"}, {"type": "subtitle", "time": 16667.709, "timestamp": "04:37:47", "text": "キョビ。水曜日はスヨビです。木曜日"}, {"type": "subtitle", "time": 16669.789, "timestamp": "04:37:49", "text": "は"}, {"type": "subtitle", "time": 16673.67, "timestamp": "04:37:53", "text": "もよび。木曜日は待ち時間として識別できます"}, {"type": "subtitle", "time": 16675.109, "timestamp": "04:37:55", "text": "月曜日、火曜日、水曜日、木曜日。"}, {"type": "subtitle", "time": 16677.75, "timestamp": "04:37:57", "text": "木曜日は3時です。これは漢字です"}]
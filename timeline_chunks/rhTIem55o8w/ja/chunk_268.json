[{"type": "subtitle", "time": 16081.51, "timestamp": "04:28:01", "text": "ニ。えっと、漢字を忘れてた"}, {"type": "subtitle", "time": 16085.87, "timestamp": "04:28:05", "text": "yi、でも書いても大丈夫だと思う"}, {"type": "subtitle", "time": 16117.87, "timestamp": "04:28:37", "text": "[音楽]"}, {"type": "subtitle", "time": 16129.99, "timestamp": "04:28:49", "text": "コヌ。何てことだ。 J を書いてしまったのでしょうか？"}, {"type": "subtitle", "time": 16131.55, "timestamp": "04:28:51", "text": "の"}, {"type": "subtitle", "time": 16134.62, "timestamp": "04:28:54", "text": "あなた？あなたではなく、私は"}, {"type": "subtitle", "time": 16136.83, "timestamp": "04:28:56", "text": "[笑い]"}]
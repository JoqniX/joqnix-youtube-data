[{"type": "subtitle", "time": 10141.389, "timestamp": "02:49:01", "text": "[音楽]"}, {"type": "subtitle", "time": 10145.11, "timestamp": "02:49:05", "text": "兄弟。何だって？みんな倒れたの？"}, {"type": "subtitle", "time": 10175.349, "timestamp": "02:49:35", "text": "そうそう。遊ぶのが好きではない人もいる"}, {"type": "subtitle", "time": 10177.99, "timestamp": "02:49:37", "text": "競技モードのマップがいくつかあるんですね？そうそう。"}, {"type": "subtitle", "time": 10188.349, "timestamp": "02:49:48", "text": "私にはそんなものはない"}, {"type": "subtitle", "time": 10193.03, "timestamp": "02:49:53", "text": "嫌いなこと"}, {"type": "subtitle", "time": 10195.51, "timestamp": "02:49:55", "text": "ええ、嫌いなことは何もありません"}, {"type": "subtitle", "time": 10197.59, "timestamp": "02:49:57", "text": "地図とかそういう類の話になるね。私は好きです"}]
[{"type": "subtitle", "time": 13261.59, "timestamp": "03:41:01", "text": "ヴァレランドの音楽。ああ、歌う小川"}, {"type": "subtitle", "time": 13264.429, "timestamp": "03:41:04", "text": "今年の。おお"}, {"type": "subtitle", "time": 13270.79, "timestamp": "03:41:10", "text": "うん。 25. 視聴者は25人でした。本当に？ 25"}, {"type": "subtitle", "time": 13272.95, "timestamp": "03:41:12", "text": "あなたたちのうち、何人かはそこにいました。待って、それは"}, {"type": "subtitle", "time": 13275.429, "timestamp": "03:41:15", "text": "これは私がめったに見ることのない数字のようなものです"}, {"type": "subtitle", "time": 13278.229, "timestamp": "03:41:18", "text": "めったにない、めったにない、本質的に"}, {"type": "subtitle", "time": 13280.309, "timestamp": "03:41:20", "text": "見る。"}, {"type": "subtitle", "time": 13282.71, "timestamp": "03:41:22", "text": "2桁の数字を持つということは、大きな"}, {"type": "subtitle", "time": 13285.269, "timestamp": "03:41:25", "text": "これは私にとって"}, {"type": "subtitle", "time": 13288.03, "timestamp": "03:41:28", "text": "珍しいことだけど、嬉しい。"}, {"type": "subtitle", "time": 13300.51, "timestamp": "03:41:40", "text": "1,445件のチャットが送信されました。"}, {"type": "subtitle", "time": 13304.63, "timestamp": "03:41:44", "text": "聖なる。ああ、あのエモートたち。わーい。ああ、スポーツマンが怒ってる"}, {"type": "subtitle", "time": 13316.59, "timestamp": "03:41:56", "text": "2番。"}]
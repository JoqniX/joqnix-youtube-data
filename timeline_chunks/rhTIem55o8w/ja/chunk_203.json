[{"type": "subtitle", "time": 12181.03, "timestamp": "03:23:01", "text": "今年の私のツリー、えーと、あれ。次"}, {"type": "subtitle", "time": 12183.11, "timestamp": "03:23:03", "text": "今年はさらに何か特別なことをします"}, {"type": "subtitle", "time": 12186.03, "timestamp": "03:23:06", "text": "より大きく、より良く。だから心配しないで"}, {"type": "subtitle", "time": 12188.269, "timestamp": "03:23:08", "text": "それ。それで"}, {"type": "subtitle", "time": 12190.71, "timestamp": "03:23:10", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 12191.49, "timestamp": "03:23:11", "text": "そして"}, {"type": "subtitle", "time": 12194.67, "timestamp": "03:23:14", "text": "[音楽]"}, {"type": "subtitle", "time": 12198.75, "timestamp": "03:23:18", "text": "えっと、それで、私は何をすればいいの？"}, {"type": "subtitle", "time": 12203.309, "timestamp": "03:23:23", "text": "言う？私はたくさんのイベントに参加したいです。"}, {"type": "subtitle", "time": 12206.25, "timestamp": "03:23:26", "text": "しかしタイミングは"}, {"type": "subtitle", "time": 12207.469, "timestamp": "03:23:27", "text": "[音楽]"}, {"type": "subtitle", "time": 12212.95, "timestamp": "03:23:32", "text": "痛み。つまり、タイミングが苦痛なのだ。私は手に入れている"}, {"type": "subtitle", "time": 12213.74, "timestamp": "03:23:33", "text": "それで"}, {"type": "subtitle", "time": 12214.91, "timestamp": "03:23:34", "text": "[音楽]"}, {"type": "subtitle", "time": 12217.75, "timestamp": "03:23:37", "text": "忙しくて、時間を過ごせないのが嫌だ"}, {"type": "subtitle", "time": 12220.95, "timestamp": "03:23:40", "text": "かなりの時間。将来は"}, {"type": "subtitle", "time": 12223.67, "timestamp": "03:23:43", "text": "これまで以上に深刻な事態になるだろう"}, {"type": "subtitle", "time": 12227.55, "timestamp": "03:23:47", "text": "これは"}, {"type": "subtitle", "time": 12231.51, "timestamp": "03:23:51", "text": "えっと、朝から晩まで、夜まで"}, {"type": "subtitle", "time": 12235.51, "timestamp": "03:23:55", "text": "パートタイムのせいで忙しくなりそうです"}, {"type": "subtitle", "time": 12239.71, "timestamp": "03:23:59", "text": "それは大学で、そういったもの全てです"}]
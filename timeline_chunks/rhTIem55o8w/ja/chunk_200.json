[{"type": "subtitle", "time": 12001.75, "timestamp": "03:20:01", "text": "名前。お好きなメッセージを書いてください"}, {"type": "subtitle", "time": 12004.99, "timestamp": "03:20:04", "text": "そして、お好きな装飾品をお選びください。"}, {"type": "subtitle", "time": 12009.07, "timestamp": "03:20:09", "text": "そしてそれを木に飾ってください。ええ、実に簡単です"}, {"type": "subtitle", "time": 12013.63, "timestamp": "03:20:13", "text": "それ。では、"}, {"type": "subtitle", "time": 12018.229, "timestamp": "03:20:18", "text": "戻ってきたら配信します。おそらく"}, {"type": "subtitle", "time": 12021.349, "timestamp": "03:20:21", "text": "ええと、クリスマス週ですね。それはまるで"}, {"type": "subtitle", "time": 12024.79, "timestamp": "03:20:24", "text": "27日（金）または28日（土）。私達はします"}, {"type": "chat", "time": 12026.203, "timestamp": "03:20:26", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "no worries, rest up joq"}, {"type": "subtitle", "time": 12028.269, "timestamp": "03:20:28", "text": "ライブストリームで"}, {"type": "subtitle", "time": 12031.75, "timestamp": "03:20:31", "text": "それから、クリスマスについて話しましょう"}, {"type": "chat", "time": 12033.681, "timestamp": "03:20:33", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "and drink water"}, {"type": "subtitle", "time": 12035.59, "timestamp": "03:20:35", "text": "もの。ストーリータイムの配信になります"}, {"type": "subtitle", "time": 12039.55, "timestamp": "03:20:39", "text": "えっと、27日か28日ですね。私はそれを受け取ります"}, {"type": "subtitle", "time": 12042.71, "timestamp": "03:20:42", "text": "近日中に予定されています。ストーリーについて話しましょう"}, {"type": "subtitle", "time": 12046.03, "timestamp": "03:20:46", "text": "時間に関すること。それから"}, {"type": "subtitle", "time": 12049.389, "timestamp": "03:20:49", "text": "えーと、これから数日間は、"}, {"type": "subtitle", "time": 12054.87, "timestamp": "03:20:54", "text": "明日ですよね？明日、えっと、私は"}, {"type": "subtitle", "time": 12057.83, "timestamp": "03:20:57", "text": "考え"}]
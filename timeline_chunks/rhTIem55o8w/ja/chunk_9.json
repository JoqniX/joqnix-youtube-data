[{"type": "subtitle", "time": 543.389, "timestamp": "00:09:03", "text": "うん。もう一度言いますが、私はマラソンをします"}, {"type": "subtitle", "time": 548.55, "timestamp": "00:09:08", "text": "6月12日までストリーミング配信される。"}, {"type": "subtitle", "time": 552.07, "timestamp": "00:09:12", "text": "12日から24時間。私はそれを言ったし、"}, {"type": "subtitle", "time": 555.35, "timestamp": "00:09:15", "text": "それを実行する。そこが問題なんです。"}, {"type": "subtitle", "time": 558.03, "timestamp": "00:09:18", "text": "それが私がやっている唯一の理由です"}, {"type": "subtitle", "time": 561.43, "timestamp": "00:09:21", "text": "ジョッカソンは24時間こんな感じ、または"}, {"type": "subtitle", "time": 563.99, "timestamp": "00:09:23", "text": "そうでなければ、私たちはすでに"}, {"type": "subtitle", "time": 566.79, "timestamp": "00:09:26", "text": "YouTubeパートナープログラムにも参加しました。だから私は"}, {"type": "subtitle", "time": 570.47, "timestamp": "00:09:30", "text": "好きになる理由がない"}, {"type": "subtitle", "time": 574.47, "timestamp": "00:09:34", "text": "これからもこういった24時間配信を続けてください。"}, {"type": "subtitle", "time": 576.389, "timestamp": "00:09:36", "text": "また、自分の記録を破りたかった。"}, {"type": "subtitle", "time": 579.509, "timestamp": "00:09:39", "text": "そして、私がどれだけ長く耐えられるか試してみます。"}, {"type": "subtitle", "time": 583.509, "timestamp": "00:09:43", "text": "そして、すべて。トレーニング方法に近い"}, {"type": "subtitle", "time": 587.35, "timestamp": "00:09:47", "text": "私自身はよくわからないと思うけど、"}, {"type": "subtitle", "time": 593.07, "timestamp": "00:09:53", "text": "私の痛みを知っている"}, {"type": "subtitle", "time": 594.59, "timestamp": "00:09:54", "text": "えーと"}, {"type": "subtitle", "time": 597.509, "timestamp": "00:09:57", "text": "とにかく、皆さんの一日が良いものになりますように。"}]
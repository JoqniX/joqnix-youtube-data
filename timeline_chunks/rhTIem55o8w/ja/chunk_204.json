[{"type": "subtitle", "time": 12244.95, "timestamp": "03:24:04", "text": "すべてとタイムゾーンなど"}, {"type": "subtitle", "time": 12246.67, "timestamp": "03:24:06", "text": "私は"}, {"type": "subtitle", "time": 12250.07, "timestamp": "03:24:10", "text": "疲れているように見られたくないんです。それで"}, {"type": "subtitle", "time": 12253.03, "timestamp": "03:24:13", "text": "疲れた。疲れ果てた騎手。わかった。私が"}, {"type": "subtitle", "time": 12254.03, "timestamp": "03:24:14", "text": "だった"}, {"type": "subtitle", "time": 12258.87, "timestamp": "03:24:18", "text": "ストリーミング配信。ああ、それはまるで"}, {"type": "subtitle", "time": 12260.83, "timestamp": "03:24:20", "text": "私の最後の配信？昨日、"}, {"type": "subtitle", "time": 12263.59, "timestamp": "03:24:23", "text": "右？昨日はとても疲れた声だった。"}, {"type": "subtitle", "time": 12267.309, "timestamp": "03:24:27", "text": "右。ニッキー、インフィニティ・ニッキー"}, {"type": "subtitle", "time": 12271.71, "timestamp": "03:24:31", "text": "ストリーム。うん、私はとても"}, {"type": "subtitle", "time": 12278.63, "timestamp": "03:24:38", "text": "では、私は昨日何をしたのでしょうか？はい、私は"}, {"type": "subtitle", "time": 12279.79, "timestamp": "03:24:39", "text": "行きました"}, {"type": "subtitle", "time": 12282.83, "timestamp": "03:24:42", "text": "散歩、ジョギング、"}, {"type": "subtitle", "time": 12286.67, "timestamp": "03:24:46", "text": "それから、"}, {"type": "subtitle", "time": 12287.7, "timestamp": "03:24:47", "text": "予定、"}, {"type": "subtitle", "time": 12288.91, "timestamp": "03:24:48", "text": "[音楽]"}, {"type": "subtitle", "time": 12291.91, "timestamp": "03:24:51", "text": "それからどこかへ行かなければならなくなり、そして戻ってきた。"}, {"type": "subtitle", "time": 12294.07, "timestamp": "03:24:54", "text": "急いで家に帰って、"}, {"type": "subtitle", "time": 12297.03, "timestamp": "03:24:57", "text": "午後2時だからストリーミング配信する。すでに。そして今"}]
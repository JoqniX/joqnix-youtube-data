[{"type": "subtitle", "time": 8535.99, "timestamp": "02:22:15", "text": "何てことだ。私は何をしているのだろう？"}, {"type": "subtitle", "time": 8538.15, "timestamp": "02:22:18", "text": "私の世界"}, {"type": "subtitle", "time": 8542.07, "timestamp": "02:22:22", "text": "チャンバー、あなたはあなたの"}, {"type": "subtitle", "time": 8554.35, "timestamp": "02:22:34", "text": "家に帰ってきたところです。"}]
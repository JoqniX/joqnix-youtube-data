[{"type": "subtitle", "time": 3482.63, "timestamp": "00:58:02", "text": "それに取り組む。それを録画して、私が"}, {"type": "subtitle", "time": 3486.109, "timestamp": "00:58:06", "text": "実際に作業しました。"}, {"type": "chat", "time": 3486.168, "timestamp": "00:58:06", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "I will be back I am going to listen to the last time you sang"}, {"type": "subtitle", "time": 3489.87, "timestamp": "00:58:09", "text": "そして今日の"}, {"type": "subtitle", "time": 3493.43, "timestamp": "00:58:13", "text": "えーっと、私がたまたま目にしたもの"}, {"type": "subtitle", "time": 3495.83, "timestamp": "00:58:15", "text": "目が覚めた"}, {"type": "subtitle", "time": 3512.27, "timestamp": "00:58:32", "text": "噛み砕く、たぶん私はそうしない"}, {"type": "subtitle", "time": 3515.43, "timestamp": "00:58:35", "text": "睡眠さえも"}, {"type": "subtitle", "time": 3517.99, "timestamp": "00:58:37", "text": "これは一部の荒らしにとって問題となっている。何ができるだろうか"}, {"type": "subtitle", "time": 3520.63, "timestamp": "00:58:40", "text": "言う？だから私は作りたかった、私はやりたかった"}, {"type": "subtitle", "time": 3525.349, "timestamp": "00:58:45", "text": "ストリーマーが物を曲げるときのあのやつ"}, {"type": "subtitle", "time": 3529.91, "timestamp": "00:58:49", "text": "YouTubeはオフラインですよね？私"}, {"type": "subtitle", "time": 3533.069, "timestamp": "00:58:53", "text": "バックアップシステムが必要だったのですが"}, {"type": "subtitle", "time": 3537.589, "timestamp": "00:58:57", "text": "仕事やチャットでの通知など"}]
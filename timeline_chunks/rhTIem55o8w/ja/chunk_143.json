[{"type": "subtitle", "time": 8581.349, "timestamp": "02:23:01", "text": "ああ、お前を殺してやったことに感謝しろ"}, {"type": "subtitle", "time": 8584.03, "timestamp": "02:23:04", "text": "素早く。もちろん。"}, {"type": "subtitle", "time": 8588.469, "timestamp": "02:23:08", "text": "いいえ。はい。私のロコは夜から戻ってきた"}, {"type": "subtitle", "time": 8594.309, "timestamp": "02:23:14", "text": "何？待って、君は夜勤だよ、"}, {"type": "subtitle", "time": 8604.79, "timestamp": "02:23:24", "text": "何？でも待って、あなたは夜に配信するの？"}, {"type": "subtitle", "time": 8606.71, "timestamp": "02:23:26", "text": "待って、いや、待って。夜に配信しますか？"}, {"type": "subtitle", "time": 8608.55, "timestamp": "02:23:28", "text": "いいえ、いいえ、いいえ、そうではありません。そうそう。それ"}, {"type": "subtitle", "time": 8609.95, "timestamp": "02:23:29", "text": "だった"}, {"type": "subtitle", "time": 8614.07, "timestamp": "02:23:34", "text": "私の記憶より前のことです。"}, {"type": "subtitle", "time": 8616.309, "timestamp": "02:23:36", "text": "私はここから出て行く。"}, {"type": "subtitle", "time": 8623.83, "timestamp": "02:23:43", "text": "ドットドットってどういう意味ですか？それは"}, {"type": "subtitle", "time": 8632.87, "timestamp": "02:23:52", "text": "それ？皮膚の束。"}]
[{"type": "subtitle", "time": 15240.59, "timestamp": "04:14:00", "text": "男。泣いちゃう。誰でも？"}, {"type": "subtitle", "time": 15243.79, "timestamp": "04:14:03", "text": "こんにちは。控訴します。しないで"}, {"type": "subtitle", "time": 15267.51, "timestamp": "04:14:27", "text": "うん、良さそうだね。わかった。こんにちは。私"}, {"type": "subtitle", "time": 15270.63, "timestamp": "04:14:30", "text": "第1章は既に9時までに終わっています。"}, {"type": "subtitle", "time": 15272.63, "timestamp": "04:14:32", "text": "私は宿題を早く終わらせる。それでは、ページ"}, {"type": "subtitle", "time": 15275.269, "timestamp": "04:14:35", "text": "95番。一緒に学んでいる場合"}, {"type": "subtitle", "time": 15277.59, "timestamp": "04:14:37", "text": "そして、もしあなたが一緒に始めたいなら"}, {"type": "subtitle", "time": 15280.95, "timestamp": "04:14:40", "text": "私の場合、これらはすべて既に済ませています。"}, {"type": "subtitle", "time": 15283.71, "timestamp": "04:14:43", "text": "それでは、まず"}, {"type": "subtitle", "time": 15291.149, "timestamp": "04:14:51", "text": "それ。こんにちは、行きましょう。"}, {"type": "subtitle", "time": 15295.51, "timestamp": "04:14:55", "text": "143 音声番号 143。では、これです。こんにちは、"}, {"type": "subtitle", "time": 15297.51, "timestamp": "04:14:57", "text": "さあ行こう。ヘッドホンを装着させてください"}]
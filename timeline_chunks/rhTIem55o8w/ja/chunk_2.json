[{"type": "subtitle", "time": 121.27, "timestamp": "00:02:01", "text": "えっと、実はやる気が出ないんだけど"}, {"type": "subtitle", "time": 124.469, "timestamp": "00:02:04", "text": "今日中に1件予約を入れてください。私たちはそれをやります"}, {"type": "subtitle", "time": 129.949, "timestamp": "00:02:09", "text": "後で。朝はダメ"}, {"type": "subtitle", "time": 145.43, "timestamp": "00:02:25", "text": "もっと話をする必要がある"}, {"type": "subtitle", "time": 165.869, "timestamp": "00:02:45", "text": "[音楽]"}]
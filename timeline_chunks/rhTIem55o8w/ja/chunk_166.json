[{"type": "subtitle", "time": 9982.79, "timestamp": "02:46:22", "text": "いや、行き詰まっちゃったんだよ。ダウンA。いいえ。"}, {"type": "subtitle", "time": 10003.429, "timestamp": "02:46:43", "text": "彼は植え付けを否定した。"}, {"type": "subtitle", "time": 10006.389, "timestamp": "02:46:46", "text": "残り10秒。敵はあと一体。"}, {"type": "subtitle", "time": 10011.429, "timestamp": "02:46:51", "text": "ああ、勝ったよ。わーい。攻撃側の勝利。"}, {"type": "subtitle", "time": 10017.75, "timestamp": "02:46:57", "text": "下手だったけど、まあいいか。しかし、我々は勝った。"}]
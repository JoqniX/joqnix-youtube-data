[{"type": "subtitle", "time": 901.55, "timestamp": "00:15:01", "text": "そして、"}, {"type": "subtitle", "time": 904.43, "timestamp": "00:15:04", "text": "ジョアソンのものは"}, {"type": "subtitle", "time": 908.949, "timestamp": "00:15:08", "text": "うまくいっていないし、まだ何も進展していない"}, {"type": "subtitle", "time": 911.509, "timestamp": "00:15:11", "text": "ゴールまたはチェックポイントの近く"}, {"type": "subtitle", "time": 915.11, "timestamp": "00:15:15", "text": "マイルストーンとその他すべて、"}, {"type": "subtitle", "time": 918.629, "timestamp": "00:15:18", "text": "えーと、即興で対応して、"}, {"type": "subtitle", "time": 920.91, "timestamp": "00:15:20", "text": "何か対策を講じる"}, {"type": "subtitle", "time": 925.269, "timestamp": "00:15:25", "text": "ストリームに頼らず、"}, {"type": "subtitle", "time": 931.829, "timestamp": "00:15:31", "text": "[音楽]"}, {"type": "subtitle", "time": 933.75, "timestamp": "00:15:33", "text": "ええ、裏ではうまくいってないみたいですね"}, {"type": "subtitle", "time": 936.11, "timestamp": "00:15:36", "text": "終わり。私ができるのはそれだけです"}, {"type": "subtitle", "time": 940.389, "timestamp": "00:15:40", "text": "言う。オフかオフか、そう、オフかオンか"}, {"type": "subtitle", "time": 941.55, "timestamp": "00:15:41", "text": "私はしません"}, {"type": "subtitle", "time": 944.389, "timestamp": "00:15:44", "text": "わかってるけど、何とかするよ。病気"}, {"type": "chat", "time": 944.928, "timestamp": "00:15:44", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "morning mr nix"}, {"type": "subtitle", "time": 945.79, "timestamp": "00:15:45", "text": "考えてみてください"}, {"type": "subtitle", "time": 955.71, "timestamp": "00:15:55", "text": "外。おはようございます、クロノス。"}, {"type": "chat", "time": 956.799, "timestamp": "00:15:56", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "its a sad day"}]
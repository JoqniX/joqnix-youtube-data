[{"type": "subtitle", "time": 8701.03, "timestamp": "02:25:01", "text": "なぜ私は育てているのか？私は育てているのですか？"}, {"type": "subtitle", "time": 8702.79, "timestamp": "02:25:02", "text": "皆さんは私が育てていると思いますか？いいえ、私は"}, {"type": "subtitle", "time": 8705.15, "timestamp": "02:25:05", "text": "ない。午前"}, {"type": "subtitle", "time": 8708.59, "timestamp": "02:25:08", "text": "私？いいえ。"}, {"type": "subtitle", "time": 8716.87, "timestamp": "02:25:16", "text": "知る。それで、あなたはこんなに震えているのですか？"}, {"type": "subtitle", "time": 8721.75, "timestamp": "02:25:21", "text": "FPSゲームをプレイしている時？これです。これは"}]
[{"type": "subtitle", "time": 8111.669, "timestamp": "02:15:11", "text": "私のバカなマウス、どうなってるの？"}, {"type": "subtitle", "time": 8114.47, "timestamp": "02:15:14", "text": "敵はあと一体。私のマウスは"}, {"type": "subtitle", "time": 8116.39, "timestamp": "02:15:16", "text": "覗き見。"}, {"type": "subtitle", "time": 8119.91, "timestamp": "02:15:19", "text": "停止。停止。停止。停止。停止。停止。"}, {"type": "subtitle", "time": 8122.069, "timestamp": "02:15:22", "text": "停止。何が起こっている？"}, {"type": "subtitle", "time": 8125.189, "timestamp": "02:15:25", "text": "とんでもない。私のマウスが壊れています。いや、いや、いや、"}, {"type": "subtitle", "time": 8128.91, "timestamp": "02:15:28", "text": "いや、いや、いや、いや。何が起こっている？"}, {"type": "subtitle", "time": 8133.75, "timestamp": "02:15:33", "text": "何？何？何？"}, {"type": "subtitle", "time": 8136.229, "timestamp": "02:15:36", "text": "そこまで近づけさせてください。何？そしてあなたは"}, {"type": "subtitle", "time": 8139.669, "timestamp": "02:15:39", "text": "既に死んでいる。"}, {"type": "subtitle", "time": 8142.229, "timestamp": "02:15:42", "text": "はぁ？"}, {"type": "subtitle", "time": 8144.39, "timestamp": "02:15:44", "text": "これはセットですか？これは、これは、そうでなければならない"}, {"type": "subtitle", "time": 8146.629, "timestamp": "02:15:46", "text": "設定？いや、いや、いや、いや、いや。私は知っています"}, {"type": "subtitle", "time": 8149.91, "timestamp": "02:15:49", "text": "私のマウス。壊れることはない。ありえない"}, {"type": "subtitle", "time": 8151.99, "timestamp": "02:15:51", "text": "壊れた。完璧であるはずがない。もちろん"}, {"type": "subtitle", "time": 8155.55, "timestamp": "02:15:55", "text": "ない。ありがとう。"}, {"type": "subtitle", "time": 8159.31, "timestamp": "02:15:59", "text": "えっと、どこが"}]
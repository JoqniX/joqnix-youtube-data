[{"type": "subtitle", "time": 19029.99, "timestamp": "05:17:09", "text": "えっと、テストを受けるにはどうすればいいですか？"}, {"type": "subtitle", "time": 19033.47, "timestamp": "05:17:13", "text": "また？えっと、テスト"}, {"type": "subtitle", "time": 19051.59, "timestamp": "05:17:31", "text": "何？ああ、それはまるでテスト用紙のようだ"}, {"type": "subtitle", "time": 19054.868, "timestamp": "05:17:34", "text": "年上。おお。まあ。テスト用紙によって"}, {"type": "subtitle", "time": 19056.788, "timestamp": "05:17:36", "text": "すべての章について。いや、いや、いや、いや、"}, {"type": "subtitle", "time": 19059.23, "timestamp": "05:17:39", "text": "いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、"}, {"type": "subtitle", "time": 19062.15, "timestamp": "05:17:42", "text": "いいえ。オーディオをテストしたいだけです"}, {"type": "subtitle", "time": 19065.35, "timestamp": "05:17:45", "text": "テスト。音声を取得するにはどうすればいいですか"}, {"type": "subtitle", "time": 19072.59, "timestamp": "05:17:52", "text": "ファイル"}, {"type": "subtitle", "time": 19075.35, "timestamp": "05:17:55", "text": "eラーニング？音声を取得するにはどうすればいいですか"}, {"type": "subtitle", "time": 19077.11, "timestamp": "05:17:57", "text": "テスト"}, {"type": "subtitle", "time": 19078.51, "timestamp": "05:17:58", "text": "[音楽]"}]
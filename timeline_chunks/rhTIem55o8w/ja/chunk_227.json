[{"type": "subtitle", "time": 13621.07, "timestamp": "03:47:01", "text": "もし私がメールを送るなら"}, {"type": "subtitle", "time": 13634.79, "timestamp": "03:47:14", "text": "えっと、この面は見せたくないんです。何"}, {"type": "subtitle", "time": 13637.389, "timestamp": "03:47:17", "text": "そうですね"}, {"type": "subtitle", "time": 13640.51, "timestamp": "03:47:20", "text": "私はそれを次のようにすることができます"}, {"type": "subtitle", "time": 13649.55, "timestamp": "03:47:29", "text": "待って、これはこれですか"}, {"type": "subtitle", "time": 13655.55, "timestamp": "03:47:35", "text": "それ？ YouTubeのリキャップがなぜこうなっているのか"}, {"type": "subtitle", "time": 13664.83, "timestamp": "03:47:44", "text": "詳細ですか？さて、これはYouTubeです"}, {"type": "subtitle", "time": 13667.389, "timestamp": "03:47:47", "text": "1つ。それは"}, {"type": "subtitle", "time": 13671.67, "timestamp": "03:47:51", "text": "自分。 YouTube 2012に参加しよう。そう、2012年は"}, {"type": "subtitle", "time": 13673.83, "timestamp": "03:47:53", "text": "私が最初に作成したとき"}, {"type": "subtitle", "time": 13676.63, "timestamp": "03:47:56", "text": "チャネル。個人使用のため"}, {"type": "subtitle", "time": 13678.269, "timestamp": "03:47:58", "text": "実は。それから"}]
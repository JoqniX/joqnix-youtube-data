[{"type": "subtitle", "time": 2520.23, "timestamp": "00:42:00", "text": "すでに考えていたことだ。それが理由です"}, {"type": "subtitle", "time": 2522.91, "timestamp": "00:42:02", "text": "これらすべてを考えて、私は"}, {"type": "subtitle", "time": 2525.75, "timestamp": "00:42:05", "text": "お金を与えるために出席しましたが、"}, {"type": "subtitle", "time": 2528.829, "timestamp": "00:42:08", "text": "この音楽コースは高額です"}, {"type": "subtitle", "time": 2531.75, "timestamp": "00:42:11", "text": "いつか自分もそうなりたいから参加する"}, {"type": "subtitle", "time": 2534.79, "timestamp": "00:42:14", "text": "迷子になったり混乱したりするのではなく"}, {"type": "subtitle", "time": 2537.67, "timestamp": "00:42:17", "text": "音楽に関して何をすべきかなどなど。私は"}, {"type": "subtitle", "time": 2540.23, "timestamp": "00:42:20", "text": "ガイド。私には私を導いてくれる人がいて、"}, {"type": "subtitle", "time": 2543.349, "timestamp": "00:42:23", "text": "私を訂正し、批判してください。"}, {"type": "subtitle", "time": 2545.349, "timestamp": "00:42:25", "text": "何をすべきか、どのようにすべきかについてのガイダンス"}, {"type": "subtitle", "time": 2549.349, "timestamp": "00:42:29", "text": "自分のスキルセットを向上させるために、その方が良いでしょう"}, {"type": "subtitle", "time": 2550.589, "timestamp": "00:42:30", "text": "ゆっくりと"}, {"type": "subtitle", "time": 2554.47, "timestamp": "00:42:34", "text": "ゆっくり。最後に私がすべきことは"}, {"type": "subtitle", "time": 2557.75, "timestamp": "00:42:37", "text": "実際に時間と労力を費やして"}, {"type": "subtitle", "time": 2560.109, "timestamp": "00:42:40", "text": "練習を続けてください"}, {"type": "subtitle", "time": 2563.99, "timestamp": "00:42:43", "text": "それ。うん。だから私はそのレベルに到達できる"}, {"type": "subtitle", "time": 2565.79, "timestamp": "00:42:45", "text": "満足できる"}, {"type": "subtitle", "time": 2570.23, "timestamp": "00:42:50", "text": "と。うん。音楽は芸術のようなものだから。いいえ、"}, {"type": "subtitle", "time": 2573.27, "timestamp": "00:42:53", "text": "千、あるいは数千を描かなければならない"}, {"type": "subtitle", "time": 2575.829, "timestamp": "00:42:55", "text": "何千倍もの芸術作品"}, {"type": "subtitle", "time": 2579.91, "timestamp": "00:42:59", "text": "それを実現できるように"}]
[{"type": "subtitle", "time": 1861.789, "timestamp": "00:31:01", "text": "これも投稿します"}, {"type": "subtitle", "time": 1866.23, "timestamp": "00:31:06", "text": "まあ、何とかして手に入れよう"}, {"type": "subtitle", "time": 1870.23, "timestamp": "00:31:10", "text": "YouTubeからVか何かをダウンロードしてください"}, {"type": "subtitle", "time": 1872.31, "timestamp": "00:31:12", "text": "そして、クリップのハイライト部分を入手しようとした。"}, {"type": "subtitle", "time": 1875.029, "timestamp": "00:31:15", "text": "人々が作った各ストリームから"}, {"type": "subtitle", "time": 1877.99, "timestamp": "00:31:17", "text": "ダウンロードするのがちょっと面倒だから"}, {"type": "subtitle", "time": 1881.43, "timestamp": "00:31:21", "text": "YouTubeはYouTubeの動画クリップを表示します。どうにかして"}, {"type": "subtitle", "time": 1883.549, "timestamp": "00:31:23", "text": "考えてみてください"}, {"type": "subtitle", "time": 1885.23, "timestamp": "00:31:25", "text": "外。"}, {"type": "subtitle", "time": 1888.63, "timestamp": "00:31:28", "text": "ええ、私もそうしようと思っていました。"}, {"type": "subtitle", "time": 1890.31, "timestamp": "00:31:30", "text": "正直に言うと、私はそうするはずだったんです"}]
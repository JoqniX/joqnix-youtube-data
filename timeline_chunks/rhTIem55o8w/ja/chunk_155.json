[{"type": "subtitle", "time": 9308.91, "timestamp": "02:35:08", "text": "また、私は練習する必要があります"}, {"type": "subtitle", "time": 9311.87, "timestamp": "02:35:11", "text": "日本人は正直"}, {"type": "subtitle", "time": 9314.79, "timestamp": "02:35:14", "text": "JP流の考え方で話している。私"}, {"type": "subtitle", "time": 9324.309, "timestamp": "02:35:24", "text": "中央にスパイクを叩き込む。"}]
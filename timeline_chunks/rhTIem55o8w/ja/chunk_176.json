[{"type": "subtitle", "time": 10561.51, "timestamp": "02:56:01", "text": "残り10秒。"}, {"type": "subtitle", "time": 10564.63, "timestamp": "02:56:04", "text": "プラン。プラン。プラン。プラン。"}, {"type": "subtitle", "time": 10565.63, "timestamp": "02:56:05", "text": "手に入れた"}, {"type": "subtitle", "time": 10597.67, "timestamp": "02:56:37", "text": "それ。ああ、あれはストレスだった。そのこと"}, {"type": "subtitle", "time": 10603.11, "timestamp": "02:56:43", "text": "私の場合、ショットではなくスパムを送ります。"}, {"type": "subtitle", "time": 10606.07, "timestamp": "02:56:46", "text": "このような。そういう風にスパムするんだ。それは"}, {"type": "subtitle", "time": 10609.07, "timestamp": "02:56:49", "text": "もの。私はトリガーホールドを作動させます。それは"}, {"type": "subtitle", "time": 10611.429, "timestamp": "02:56:51", "text": "毎回必ず問題が発生する。私は"}, {"type": "subtitle", "time": 10613.269, "timestamp": "02:56:53", "text": "忘れること。ヴァンダルの場合、"}, {"type": "subtitle", "time": 10616.63, "timestamp": "02:56:56", "text": "3発の弾丸を放って、それから、ええ、"}]
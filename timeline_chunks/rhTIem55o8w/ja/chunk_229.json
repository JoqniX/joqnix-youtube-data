[{"type": "subtitle", "time": 13740.349, "timestamp": "03:49:00", "text": "とても小さい。とても短い。なし"}, {"type": "subtitle", "time": 13743.87, "timestamp": "03:49:03", "text": "そこには。なぜそうなるのか"}, {"type": "subtitle", "time": 13747.51, "timestamp": "03:49:07", "text": "短い？ Twitch のほうが"}, {"type": "subtitle", "time": 13750.87, "timestamp": "03:49:10", "text": "詳細な。ほら、すごく詳細だったんだよ。"}, {"type": "subtitle", "time": 13754.83, "timestamp": "03:49:14", "text": "それは統計など多くのものを提供してくれました。"}, {"type": "subtitle", "time": 13757.189, "timestamp": "03:49:17", "text": "すべて。あ、待って。私の"}, {"type": "subtitle", "time": 13763.87, "timestamp": "03:49:23", "text": "すべて錆びる"}, {"type": "subtitle", "time": 13767.269, "timestamp": "03:49:27", "text": "その周り。ええ、私は"}, {"type": "subtitle", "time": 13775.87, "timestamp": "03:49:35", "text": "[音楽]"}, {"type": "subtitle", "time": 13779.51, "timestamp": "03:49:39", "text": "ドロップス。はい、彼らは"}, {"type": "subtitle", "time": 13781.429, "timestamp": "03:49:41", "text": "私が実際に視聴した配信者"}, {"type": "subtitle", "time": 13786.67, "timestamp": "03:49:46", "text": "だって、私は彼らが大好きなんですもの。"}, {"type": "subtitle", "time": 13793.229, "timestamp": "03:49:53", "text": "唾を吐く"}, {"type": "subtitle", "time": 13795.83, "timestamp": "03:49:55", "text": "バッジ。では、もう片方を見てみましょう。"}, {"type": "subtitle", "time": 13797.87, "timestamp": "03:49:57", "text": "コミュニティ。何が"}]
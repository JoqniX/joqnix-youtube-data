[{"type": "subtitle", "time": 10087.389, "timestamp": "02:48:07", "text": "ゲーム。私はウィンドウにアクセスします"}, {"type": "subtitle", "time": 10091.95, "timestamp": "02:48:11", "text": "戻る。これは新しいものだ。ああ、ファンドと"}, {"type": "subtitle", "time": 10100.07, "timestamp": "02:48:20", "text": "[音楽]"}, {"type": "subtitle", "time": 10102.309, "timestamp": "02:48:22", "text": "それは良くない。私を信じて。それは それは"}, {"type": "subtitle", "time": 10105.429, "timestamp": "02:48:25", "text": "中毒と呼ばれる状態。中毒。待って、"}, {"type": "subtitle", "time": 10107.99, "timestamp": "02:48:27", "text": "太極拳とは何ですか？待って、これは何？おお、"}, {"type": "subtitle", "time": 10111.07, "timestamp": "02:48:31", "text": "えっと、パワーみたいなものだと思ってたんだけど"}, {"type": "subtitle", "time": 10113.19, "timestamp": "02:48:33", "text": "レンジャーだけど、パワーみたい"}, {"type": "subtitle", "time": 10138.63, "timestamp": "02:48:58", "text": "何？みんな辞めて、"}]
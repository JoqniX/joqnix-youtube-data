[{"type": "subtitle", "time": 11411.429, "timestamp": "03:10:11", "text": "視界から外れないように。"}, {"type": "subtitle", "time": 11415.99, "timestamp": "03:10:15", "text": "敵はあと一体。それは"}, {"type": "subtitle", "time": 11417.309, "timestamp": "03:10:17", "text": "それは私の"}, {"type": "subtitle", "time": 11420.71, "timestamp": "03:10:20", "text": "銃。セージが持っていたのは、私の銃だった。"}, {"type": "subtitle", "time": 11455.389, "timestamp": "03:10:55", "text": "わかった。"}]
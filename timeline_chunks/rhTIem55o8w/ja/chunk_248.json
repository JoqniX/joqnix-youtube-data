[{"type": "subtitle", "time": 14881.67, "timestamp": "04:08:01", "text": "うん。こんにちは。ええと、教科書通りですね。つまり、これは"}, {"type": "subtitle", "time": 14886.63, "timestamp": "04:08:06", "text": "A1スターターのライ。最初のA1はライです。それで、"}, {"type": "subtitle", "time": 14889.75, "timestamp": "04:08:09", "text": "これが、私たちが聞く方法です。"}, {"type": "subtitle", "time": 14891.83, "timestamp": "04:08:11", "text": "私たちはどのように耳を傾けるか。私たちは耳を傾けます"}, {"type": "subtitle", "time": 14895.03, "timestamp": "04:08:15", "text": "音声ファイルとワークブックもあります"}, {"type": "subtitle", "time": 14897.189, "timestamp": "04:08:17", "text": "教材と語彙に関するもの。それはとても"}, {"type": "subtitle", "time": 14900.07, "timestamp": "04:08:20", "text": "教育的。 100％お勧めします"}, {"type": "subtitle", "time": 14903.67, "timestamp": "04:08:23", "text": "これをざっと見ています。こんにちは。だから私たちは"}, {"type": "subtitle", "time": 14906.95, "timestamp": "04:08:26", "text": "現在レッスン中です"}, {"type": "subtitle", "time": 14909.75, "timestamp": "04:08:29", "text": "10. では、レッスン10をクリックします。わかりました。"}, {"type": "subtitle", "time": 14913.269, "timestamp": "04:08:33", "text": "ご覧のとおり、これがレッスン18です。私"}, {"type": "subtitle", "time": 14915.83, "timestamp": "04:08:35", "text": "私がここにいるのが見えるかどうか分かりません。私たちは"}, {"type": "subtitle", "time": 14917.83, "timestamp": "04:08:37", "text": "18歳まで到達する必要がある。それが"}, {"type": "subtitle", "time": 14920.229, "timestamp": "04:08:40", "text": "今日の配信のチェックポイント。"}, {"type": "subtitle", "time": 14923.59, "timestamp": "04:08:43", "text": "チェックポイントは15番だと思う。待って。 1"}, {"type": "subtitle", "time": 14928.55, "timestamp": "04:08:48", "text": "2 3 4 5 6 7 8 9。ああ、奇数だ。おお、"}, {"type": "subtitle", "time": 14931.269, "timestamp": "04:08:51", "text": "16か15にしよう。わかった。 16歳以降"}, {"type": "subtitle", "time": 14934.389, "timestamp": "04:08:54", "text": "15、術をしたり、ちょっと話したりしよう"}, {"type": "subtitle", "time": 14936.87, "timestamp": "04:08:56", "text": "もしくは、宿題からちょっと休憩しよう"}, {"type": "subtitle", "time": 14939.189, "timestamp": "04:08:59", "text": "だって、うん、知ってるでしょ、"}]
[{"type": "subtitle", "time": 19448.19, "timestamp": "05:24:08", "text": "わかった。"}, {"type": "subtitle", "time": 19459.59, "timestamp": "05:24:19", "text": "ああ、わかりました。記入する"}, {"type": "subtitle", "time": 19463.628, "timestamp": "05:24:23", "text": "ひらがなまたはカタカナ。しかし、"}, {"type": "subtitle", "time": 19467.23, "timestamp": "05:24:27", "text": "音声はどこで見つけられますか？"}, {"type": "subtitle", "time": 19470.31, "timestamp": "05:24:30", "text": "それ？ここにはない。あ、待って。たぶんそれは"}, {"type": "subtitle", "time": 19473.59, "timestamp": "05:24:33", "text": "次のページをご覧ください。第11課"}, {"type": "subtitle", "time": 19474.51, "timestamp": "05:24:34", "text": "質問"}, {"type": "subtitle", "time": 19476.11, "timestamp": "05:24:36", "text": "マークしてください。"}, {"type": "subtitle", "time": 19478.19, "timestamp": "05:24:38", "text": "[音楽]"}, {"type": "subtitle", "time": 19482.03, "timestamp": "05:24:42", "text": "1つ。ああ、それは提供していません。"}, {"type": "subtitle", "time": 19484.788, "timestamp": "05:24:44", "text": "何？あなたは秘密をどこに隠していますか？"}, {"type": "subtitle", "time": 19495.43, "timestamp": "05:24:55", "text": "それ。文字通り「聞いて書いて」と書いてあります"}, {"type": "subtitle", "time": 19496.27, "timestamp": "05:24:56", "text": "で"}, {"type": "subtitle", "time": 19499.03, "timestamp": "05:24:59", "text": "ひらがな。どこで聴けますか？たぶん私は"}]
[{"type": "subtitle", "time": 10440.99, "timestamp": "02:54:00", "text": "彼らは2ラウンドを獲得した。それは"}, {"type": "subtitle", "time": 10444.389, "timestamp": "02:54:04", "text": "わかった。えっと、なんで急上昇してるの？私"}, {"type": "subtitle", "time": 10447.67, "timestamp": "02:54:07", "text": "私にスパイクが刺さるのは嫌だった。いいね"}, {"type": "subtitle", "time": 10448.99, "timestamp": "02:54:08", "text": "スパイクがあれば、それはあなたの"}, {"type": "subtitle", "time": 10452.07, "timestamp": "02:54:12", "text": "責任ですよね？計画を立てる"}, {"type": "subtitle", "time": 10454.67, "timestamp": "02:54:14", "text": "などなど、"}, {"type": "subtitle", "time": 10456.19, "timestamp": "02:54:16", "text": "兄弟。"}, {"type": "subtitle", "time": 10460.79, "timestamp": "02:54:20", "text": "ハネ、私たちと一緒に来て。おお、"}, {"type": "subtitle", "time": 10468.87, "timestamp": "02:54:28", "text": "わかった。それはおそらくいくつかの地図が"}, {"type": "subtitle", "time": 10472.11, "timestamp": "02:54:32", "text": "それらはただ悪いだけです。"}, {"type": "subtitle", "time": 10495.269, "timestamp": "02:54:55", "text": "ナイフで切り裂けばいい。"}, {"type": "subtitle", "time": 10497.23, "timestamp": "02:54:57", "text": "おお"}]
[{"type": "subtitle", "time": 11227.83, "timestamp": "03:07:07", "text": "いい考えが浮かんだ。もし私たちが…私にはわかりません。"}, {"type": "subtitle", "time": 11231.03, "timestamp": "03:07:11", "text": "スパイクを掴め。"}, {"type": "subtitle", "time": 11249.99, "timestamp": "03:07:29", "text": "敵を発見。敵を発見。注意深い"}, {"type": "subtitle", "time": 11252.63, "timestamp": "03:07:32", "text": "ここ。"}, {"type": "subtitle", "time": 11263.429, "timestamp": "03:07:43", "text": "あなたの任務はまだ終わっていません。これを取りなさい"}, {"type": "subtitle", "time": 11265.429, "timestamp": "03:07:45", "text": "準備完了"}, {"type": "subtitle", "time": 11268.15, "timestamp": "03:07:48", "text": "あなたのために。"}, {"type": "subtitle", "time": 11269.55, "timestamp": "03:07:49", "text": "これ"}, {"type": "subtitle", "time": 11278.51, "timestamp": "03:07:58", "text": "そこで私たちは"}]
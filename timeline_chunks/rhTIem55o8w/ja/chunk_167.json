[{"type": "subtitle", "time": 10020.389, "timestamp": "02:47:00", "text": "少なくとも1試合は勝つべきだった。私たちは"}, {"type": "subtitle", "time": 10024.03, "timestamp": "02:47:04", "text": "5勝、10勝くらい必要だ。"}, {"type": "subtitle", "time": 10027.99, "timestamp": "02:47:07", "text": "知る。 8キル。悪くない。あと4人"}, {"type": "subtitle", "time": 10033.309, "timestamp": "02:47:13", "text": "わかった。"}, {"type": "subtitle", "time": 10037.269, "timestamp": "02:47:17", "text": "うん。わかった。"}, {"type": "subtitle", "time": 10047.429, "timestamp": "02:47:27", "text": "ショット。待って、1試合は1時間だよ。ああ、"}, {"type": "subtitle", "time": 10049.429, "timestamp": "02:47:29", "text": "神。 4試合は4試合のようなものです"}, {"type": "subtitle", "time": 10052.269, "timestamp": "02:47:32", "text": "試合は4試合"}, {"type": "subtitle", "time": 10055.67, "timestamp": "02:47:35", "text": "数時間程度。人々はこのゲームをどのようにプレイするのですか？"}, {"type": "subtitle", "time": 10059.429, "timestamp": "02:47:39", "text": "競争的な感じ？皆さんの多くを見かけました"}, {"type": "subtitle", "time": 10063.19, "timestamp": "02:47:43", "text": "みんな、僕の知り合いみたいにこのゲームをプレイするよ。"}, {"type": "subtitle", "time": 10065.91, "timestamp": "02:47:45", "text": "YouTuberの友達とか。"}, {"type": "subtitle", "time": 10071.07, "timestamp": "02:47:51", "text": "どうしてなのか、私には全く理解できない。私は受け取らなかった"}, {"type": "subtitle", "time": 10073.15, "timestamp": "02:47:53", "text": "それ。"}]
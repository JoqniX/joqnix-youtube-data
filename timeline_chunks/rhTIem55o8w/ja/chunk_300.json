[{"type": "subtitle", "time": 18001.86, "timestamp": "05:00:01", "text": "うん。よし。よし。手に入れた"}, {"type": "subtitle", "time": 18008.868, "timestamp": "05:00:08", "text": "それ。わかった。思考のスクリーンショット。忘れた。"}, {"type": "subtitle", "time": 18013.07, "timestamp": "05:00:13", "text": "Fは忘れた。それで、スクリーンショットを何枚撮ったか"}, {"type": "subtitle", "time": 18016.03, "timestamp": "05:00:16", "text": "また？では、私の写真を確認してみましょう"}, {"type": "subtitle", "time": 18017.948, "timestamp": "05:00:17", "text": "スクリーンショット。"}, {"type": "subtitle", "time": 18022.868, "timestamp": "05:00:22", "text": "えーっと、１、２、私はこれを取って、"}, {"type": "subtitle", "time": 18026.15, "timestamp": "05:00:26", "text": "これを選びました。これは私が撮った写真ではありません。"}, {"type": "subtitle", "time": 18036.15, "timestamp": "05:00:36", "text": "1つ。 94ページ。了解。そして95もまた"}, {"type": "subtitle", "time": 18042.708, "timestamp": "05:00:42", "text": "終了した。えっと、そのページを拝見させてください"}, {"type": "subtitle", "time": 18043.27, "timestamp": "05:00:43", "text": "番号"}, {"type": "subtitle", "time": 18045.39, "timestamp": "05:00:45", "text": "[音楽]"}, {"type": "subtitle", "time": 18048.91, "timestamp": "05:00:48", "text": "95ページ番号"}, {"type": "subtitle", "time": 18052.948, "timestamp": "05:00:52", "text": "90。ああ、96をやるよ。ああ、"}, {"type": "subtitle", "time": 18055.11, "timestamp": "05:00:55", "text": "やらなければならないことが山ほどある。文字通り"}, {"type": "subtitle", "time": 18057.31, "timestamp": "05:00:57", "text": "教科書を全部読み終える"}, {"type": "subtitle", "time": 18059.628, "timestamp": "05:00:59", "text": "今日。"}]
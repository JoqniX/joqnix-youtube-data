[{"type": "subtitle", "time": 11104.79, "timestamp": "03:05:04", "text": "ああ、なんてことだ。 B地点にスパイクを打つ。もうここから出る。"}, {"type": "subtitle", "time": 11114.83, "timestamp": "03:05:14", "text": "言葉。私には森がありません。私は持っていません"}, {"type": "subtitle", "time": 11116.11, "timestamp": "03:05:16", "text": "[音楽]"}, {"type": "subtitle", "time": 11139.71, "timestamp": "03:05:39", "text": "これ。もちろん、私たちは"}]
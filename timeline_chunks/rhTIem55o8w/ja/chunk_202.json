[{"type": "subtitle", "time": 12122.95, "timestamp": "03:22:02", "text": "23日は休日です。もし私ができるなら"}, {"type": "subtitle", "time": 12125.229, "timestamp": "03:22:05", "text": "ストリーム、私は次のようにします"}, {"type": "subtitle", "time": 12130.83, "timestamp": "03:22:10", "text": "おそらく私はこうするでしょう"}, {"type": "subtitle", "time": 12135.95, "timestamp": "03:22:15", "text": "えっと、わからないです。私はそうすべきでしょうか"}, {"type": "subtitle", "time": 12139.429, "timestamp": "03:22:19", "text": "空手か、それともただ"}, {"type": "subtitle", "time": 12141.59, "timestamp": "03:22:21", "text": "クリスマス配信とか何か？私は"}, {"type": "subtitle", "time": 12145.269, "timestamp": "03:22:25", "text": "何か特別なことをしたいんだよ。私"}, {"type": "subtitle", "time": 12146.79, "timestamp": "03:22:26", "text": "やりたいことがある やりたいことがある"}, {"type": "subtitle", "time": 12153.79, "timestamp": "03:22:33", "text": "久しぶりのような特別な"}, {"type": "subtitle", "time": 12155.469, "timestamp": "03:22:35", "text": "右？"}, {"type": "subtitle", "time": 12159.469, "timestamp": "03:22:39", "text": "ええ、それは"}, {"type": "subtitle", "time": 12163.95, "timestamp": "03:22:43", "text": "その間。えーと、でも、私たちの"}, {"type": "subtitle", "time": 12167.83, "timestamp": "03:22:47", "text": "カスタマイズされた伝統的なもの、私たちは"}, {"type": "subtitle", "time": 12170.55, "timestamp": "03:22:50", "text": "今年はXだけをやります"}, {"type": "subtitle", "time": 12173.51, "timestamp": "03:22:53", "text": "私の木に色を塗ってください。はい、そのことを言いました"}, {"type": "subtitle", "time": 12176.469, "timestamp": "03:22:56", "text": "昨日もそうだった。色を塗る"}]
[{"type": "subtitle", "time": 14640.51, "timestamp": "04:04:00", "text": "いろいろと大変なことがあって、試験も控えている。"}, {"type": "subtitle", "time": 14644.309, "timestamp": "04:04:04", "text": "日曜日。日曜日ですね。私のNAT試験"}, {"type": "subtitle", "time": 14649.189, "timestamp": "04:04:09", "text": "これはQ5、つまりJPDN5に相当するものです。"}, {"type": "subtitle", "time": 14652.63, "timestamp": "04:04:12", "text": "試験は日曜日です。この流れ、この"}, {"type": "subtitle", "time": 14655.269, "timestamp": "04:04:15", "text": "これから行う宿題は"}, {"type": "subtitle", "time": 14659.59, "timestamp": "04:04:19", "text": "私の復習のために、復習のために"}, {"type": "subtitle", "time": 14662.91, "timestamp": "04:04:22", "text": "試験。さあ、最善を尽くしましょう。わかった。"}, {"type": "subtitle", "time": 14666.55, "timestamp": "04:04:26", "text": "こんにちは。私のモデルカメラ設定は"}, {"type": "subtitle", "time": 14669.11, "timestamp": "04:04:29", "text": "今日は少し調子が悪い。昨日は"}, {"type": "subtitle", "time": 14672.229, "timestamp": "04:04:32", "text": "私たちは手持ちカメラのストリームのようなものをしました、"}, {"type": "subtitle", "time": 14673.309, "timestamp": "04:04:33", "text": "右？"}, {"type": "subtitle", "time": 14676.63, "timestamp": "04:04:36", "text": "だから、その理由で、"}, {"type": "subtitle", "time": 14680.55, "timestamp": "04:04:40", "text": "その理由は、えっと、なんて言うんでしたっけ？"}, {"type": "subtitle", "time": 14683.83, "timestamp": "04:04:43", "text": "私のカメラはトップダウンモードになっています。つまり"}, {"type": "subtitle", "time": 14687.63, "timestamp": "04:04:47", "text": "トップモードは、"}, {"type": "subtitle", "time": 14698.269, "timestamp": "04:04:58", "text": "ええ、つまり私の電話です"}]
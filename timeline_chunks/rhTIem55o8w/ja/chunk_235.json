[{"type": "subtitle", "time": 14104.51, "timestamp": "03:55:04", "text": "えっと、一度言ったと思うけど、"}, {"type": "subtitle", "time": 14107.63, "timestamp": "03:55:07", "text": "ストリームを見たら、"}, {"type": "subtitle", "time": 14110.95, "timestamp": "03:55:10", "text": "それがどれほど愚かな考えだったか理解している。"}, {"type": "subtitle", "time": 14144.309, "timestamp": "03:55:44", "text": "ええ、もう行かなくちゃ。それが私の順番です。"}, {"type": "subtitle", "time": 14147.51, "timestamp": "03:55:47", "text": "えっと、待って、大丈夫だよって感じだった。良い"}, {"type": "subtitle", "time": 14149.91, "timestamp": "03:55:49", "text": "こちらでまとめてください。わかった。ええ、そうですね。"}, {"type": "subtitle", "time": 14152.75, "timestamp": "03:55:52", "text": "お越しいただいた皆様、ありがとうございました。"}, {"type": "subtitle", "time": 14155.269, "timestamp": "03:55:55", "text": "えっと、ちょっと待って、待って、待って。私は何をしたの？"}, {"type": "subtitle", "time": 14157.51, "timestamp": "03:55:57", "text": "お越しいただいた皆様、ありがとうございました。私はしなければならない"}]
[{"type": "subtitle", "time": 19980.868, "timestamp": "05:33:00", "text": "彼らが来たとしても、私は彼らだと気づかなかっただろう。うん、"}, {"type": "subtitle", "time": 19986.11, "timestamp": "05:33:06", "text": "これです。木木"}, {"type": "subtitle", "time": 19988.83, "timestamp": "05:33:08", "text": "1つ。"}, {"type": "subtitle", "time": 19991.99, "timestamp": "05:33:11", "text": "えっと、待って。 1から5までですよね？待って、何？"}, {"type": "subtitle", "time": 19999.31, "timestamp": "05:33:19", "text": "また？私は16歳になった。"}, {"type": "subtitle", "time": 20002.27, "timestamp": "05:33:22", "text": "えっと、テスト用紙は"}, {"type": "subtitle", "time": 20005.15, "timestamp": "05:33:25", "text": "[音楽]"}, {"type": "subtitle", "time": 20008.51, "timestamp": "05:33:28", "text": "ああ、時間を無駄にしている。コメントしてください。"}, {"type": "subtitle", "time": 20012.31, "timestamp": "05:33:32", "text": "えっと、テスト用紙は1から5までですよね？"}, {"type": "subtitle", "time": 20013.868, "timestamp": "05:33:33", "text": "トピック1から"}, {"type": "subtitle", "time": 20017.03, "timestamp": "05:33:37", "text": "五。 1から5のどれですか？"}, {"type": "subtitle", "time": 20021.11, "timestamp": "05:33:41", "text": "これはこれですか、それはどのようなものですか"}, {"type": "subtitle", "time": 20023.23, "timestamp": "05:33:43", "text": "トピック？それは"}, {"type": "subtitle", "time": 20027.35, "timestamp": "05:33:47", "text": "レッスン？今は混乱しています。大丈夫。私たちは"}, {"type": "subtitle", "time": 20029.59, "timestamp": "05:33:49", "text": "チェックしたよ、えっと、6つだよね？えっと、"}, {"type": "subtitle", "time": 20033.28, "timestamp": "05:33:53", "text": "漢字を引き続き確認してください。私"}, {"type": "subtitle", "time": 20035.548, "timestamp": "05:33:55", "text": "[音楽]"}, {"type": "subtitle", "time": 20038.948, "timestamp": "05:33:58", "text": "これは漢字ではないことを忘れていた"}]
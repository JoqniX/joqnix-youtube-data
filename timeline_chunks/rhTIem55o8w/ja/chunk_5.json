[{"type": "subtitle", "time": 308.23, "timestamp": "00:05:08", "text": "男。睡眠は、"}, {"type": "subtitle", "time": 311.31, "timestamp": "00:05:11", "text": "睡眠不良"}, {"type": "subtitle", "time": 313.79, "timestamp": "00:05:13", "text": "そしてこの時"}, {"type": "subtitle", "time": 318.31, "timestamp": "00:05:18", "text": "ポイント？わからない。私は、私は、私は"}, {"type": "subtitle", "time": 322.469, "timestamp": "00:05:22", "text": "早く寝て、Vを入れた。"}, {"type": "subtitle", "time": 323.629, "timestamp": "00:05:23", "text": "すでに"}, {"type": "subtitle", "time": 326.39, "timestamp": "00:05:26", "text": "昨日、申し訳ないのですが、"}, {"type": "subtitle", "time": 329.43, "timestamp": "00:05:29", "text": "今日は愚痴をこぼします。でも、昨日は"}, {"type": "subtitle", "time": 332.59000000000003, "timestamp": "00:05:32", "text": "2作目をやるかどうかまだ考えている"}, {"type": "subtitle", "time": 335.909, "timestamp": "00:05:35", "text": "配信するかどうかは別として、でも私はそうしたくなかった"}, {"type": "subtitle", "time": 339.99, "timestamp": "00:05:39", "text": "24時間連続記録を破るために"}, {"type": "subtitle", "time": 340.83, "timestamp": "00:05:40", "text": "そして"}, {"type": "subtitle", "time": 344.87, "timestamp": "00:05:44", "text": "いろいろやってるよ。"}, {"type": "subtitle", "time": 347.59000000000003, "timestamp": "00:05:47", "text": "えっと、もう2ヶ月くらい経ちます。"}, {"type": "subtitle", "time": 351.909, "timestamp": "00:05:51", "text": "これは2ヶ月目で、私は"}, {"type": "subtitle", "time": 354.23, "timestamp": "00:05:54", "text": "うん、じゃあ配信を流すね。病気"}, {"type": "subtitle", "time": 357.11, "timestamp": "00:05:57", "text": "寝なさい、たとえ"}, {"type": "subtitle", "time": 359.39, "timestamp": "00:05:59", "text": "夜"}]
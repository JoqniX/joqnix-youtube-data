[{"type": "subtitle", "time": 3909.95, "timestamp": "01:05:09", "text": "それ。ほら、まだ疲れてるよ"}, {"type": "subtitle", "time": 3912.19, "timestamp": "01:05:12", "text": "寝ている。"}, {"type": "subtitle", "time": 3914.67, "timestamp": "01:05:14", "text": "まあ、これは"}, {"type": "subtitle", "time": 3917.25, "timestamp": "01:05:17", "text": "最悪だ。疲労は本物だ。"}, {"type": "subtitle", "time": 3918.51, "timestamp": "01:05:18", "text": "[音楽]"}, {"type": "subtitle", "time": 3931.39, "timestamp": "01:05:31", "text": "昼食を食べに行かないといけないので"}, {"type": "chat", "time": 3932.259, "timestamp": "01:05:32", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "Go back to bed"}, {"type": "subtitle", "time": 3934.95, "timestamp": "01:05:34", "text": "15分後に少し。そうではないことは分かっています"}, {"type": "subtitle", "time": 3938.19, "timestamp": "01:05:38", "text": "準備が整わないでしょう。まだ準備ができていません。"}, {"type": "chat", "time": 3941.137, "timestamp": "01:05:41", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "AND YES. A REAL BED"}, {"type": "subtitle", "time": 3942.15, "timestamp": "01:05:42", "text": "でも、それでも階下へ降りて食事をする。戻る"}, {"type": "chat", "time": 3947.047, "timestamp": "01:05:47", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "NOT SLEEPING IN A CHAIR"}, {"type": "subtitle", "time": 3957.349, "timestamp": "01:05:57", "text": "バカ、私は椅子で寝たことはないよ。"}]
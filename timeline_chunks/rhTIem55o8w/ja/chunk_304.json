[{"type": "subtitle", "time": 18249.99, "timestamp": "05:04:09", "text": "ナバン。ナアバン。わかった。位置番号。"}, {"type": "subtitle", "time": 18253.19, "timestamp": "05:04:13", "text": "わかった。こんにちは。なぜ私がそのことに言及しているのか？私"}, {"type": "subtitle", "time": 18255.628, "timestamp": "05:04:15", "text": "わからない。わかった。こんにちは。"}, {"type": "subtitle", "time": 18257.788, "timestamp": "05:04:17", "text": "いや、違うよ。"}, {"type": "subtitle", "time": 18272.75, "timestamp": "05:04:32", "text": "サン、これは何？何が"}, {"type": "subtitle", "time": 18275.27, "timestamp": "05:04:35", "text": "サニオ？こんにちは、ナン。久しぶりですね。"}, {"type": "subtitle", "time": 18277.15, "timestamp": "05:04:37", "text": "こんにちは。お元気でいらっしゃることを願っています"}, {"type": "subtitle", "time": 18285.03, "timestamp": "05:04:45", "text": "良い。こんにちは。えっと、ニジニジニジャニジをやるために"}, {"type": "subtitle", "time": 18286.67, "timestamp": "05:04:46", "text": "ジクは"}, {"type": "subtitle", "time": 18289.23, "timestamp": "05:04:49", "text": "私たちのギス"}, {"type": "subtitle", "time": 18298.11, "timestamp": "05:04:58", "text": "os。ウー・ハンは30歳です"}]
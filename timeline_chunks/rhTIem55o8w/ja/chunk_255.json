[{"type": "subtitle", "time": 15300.469, "timestamp": "04:15:00", "text": "絵を描き始めましょう。よし、作ってみよう"}, {"type": "subtitle", "time": 15303.429, "timestamp": "04:15:03", "text": "確かに、私のペンタブレットは接続されています。"}, {"type": "subtitle", "time": 15305.83, "timestamp": "04:15:05", "text": "はい、接続されています。ええ、でも"}, {"type": "subtitle", "time": 15308.149, "timestamp": "04:15:08", "text": "これはMicrosoft Edgeに問題があるということですよね？"}, {"type": "subtitle", "time": 15310.63, "timestamp": "04:15:10", "text": "Microsoft Edge を使用している場合"}, {"type": "subtitle", "time": 15314.07, "timestamp": "04:15:14", "text": "この文章を書くときは、Ctrl+E は使えません。"}, {"type": "subtitle", "time": 15316.229, "timestamp": "04:15:16", "text": "消去する。クリックする必要があります"}, {"type": "subtitle", "time": 15319.67, "timestamp": "04:15:19", "text": "消しゴムで消して。痛すぎる。しかし"}, {"type": "subtitle", "time": 15320.83, "timestamp": "04:15:20", "text": "その"}, {"type": "subtitle", "time": 15323.83, "timestamp": "04:15:23", "text": "わかった。そして、あなたがコントロールできないのは、"}, {"type": "subtitle", "time": 15325.95, "timestamp": "04:15:25", "text": "もの。だから最悪だ"}, {"type": "subtitle", "time": 15339.189, "timestamp": "04:15:39", "text": "ああ、よし、これならもっといいだろう。しない"}, {"type": "subtitle", "time": 15341.99, "timestamp": "04:15:41", "text": "心配。したい気持ちもあるし、したくない気持ちもある"}, {"type": "subtitle", "time": 15344.189, "timestamp": "04:15:44", "text": "ストレッチ"}, {"type": "subtitle", "time": 15347.75, "timestamp": "04:15:47", "text": "それ。はぁ？大丈夫ですよね？それは"}, {"type": "subtitle", "time": 15348.67, "timestamp": "04:15:48", "text": "大丈夫。"}, {"type": "subtitle", "time": 15359.229, "timestamp": "04:15:59", "text": "それでは一緒に聞いてみましょう"}]
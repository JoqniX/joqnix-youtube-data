[{"type": "subtitle", "time": 2342.43, "timestamp": "00:39:02", "text": "24時間配信マラソン"}, {"type": "subtitle", "time": 2346.95, "timestamp": "00:39:06", "text": "あれ。それから私はそれを思い出した"}, {"type": "subtitle", "time": 2348.349, "timestamp": "00:39:08", "text": "のように"}, {"type": "subtitle", "time": 2352.31, "timestamp": "00:39:12", "text": "ああ、もし私がそのアイデアを実行していたら"}, {"type": "subtitle", "time": 2353.069, "timestamp": "00:39:13", "text": "私の"}, {"type": "subtitle", "time": 2357.829, "timestamp": "00:39:17", "text": "心はそうだったし、もし私がそうしなかったら怖くなかっただろう"}, {"type": "subtitle", "time": 2360.39, "timestamp": "00:39:20", "text": "他人がどう思うかを考えて、"}, {"type": "subtitle", "time": 2363.03, "timestamp": "00:39:23", "text": "それ。私はまた好きになれた"}, {"type": "subtitle", "time": 2365.51, "timestamp": "00:39:25", "text": "その時、少しだけ時計の時間を手に入れた"}, {"type": "subtitle", "time": 2368.31, "timestamp": "00:39:28", "text": "実際に何かを手に入れた"}, {"type": "subtitle", "time": 2371.19, "timestamp": "00:39:31", "text": "でも私はそう感じないだろう"}, {"type": "subtitle", "time": 2373.79, "timestamp": "00:39:33", "text": "一生懸命努力しなさい。私"}, {"type": "subtitle", "time": 2376.79, "timestamp": "00:39:36", "text": "大変な作業をスキップしたり、"}, {"type": "subtitle", "time": 2379.15, "timestamp": "00:39:39", "text": "ある意味では、"}, {"type": "subtitle", "time": 2381.91, "timestamp": "00:39:41", "text": "右？私が感じた通りかどうかはわかりません"}, {"type": "subtitle", "time": 2384.51, "timestamp": "00:39:44", "text": "まるでそれが悪いことであるかのように。うん、"}, {"type": "subtitle", "time": 2388.39, "timestamp": "00:39:48", "text": "それなら、私には分かりません。"}, {"type": "subtitle", "time": 2393.03, "timestamp": "00:39:53", "text": "正直、えっと、正直に"}, {"type": "subtitle", "time": 2396.23, "timestamp": "00:39:56", "text": "ジョアソンからのYouTubeパートナーのやつ"}, {"type": "subtitle", "time": 2399.349, "timestamp": "00:39:59", "text": "それはちょっと気持ちよかった。なぜなら私は"}]
[{"type": "subtitle", "time": 7440.79, "timestamp": "02:04:00", "text": "働く。私は、私は、"}, {"type": "subtitle", "time": 7456.55, "timestamp": "02:04:16", "text": "いとこは誰ですか？カシンいとこ7または"}, {"type": "subtitle", "time": 7460.47, "timestamp": "02:04:20", "text": "何か。いとこ7番目のいとこ。"}, {"type": "subtitle", "time": 7462.03, "timestamp": "02:04:22", "text": "いとこの"}, {"type": "subtitle", "time": 7472.589, "timestamp": "02:04:32", "text": "[音楽]"}, {"type": "subtitle", "time": 7485.669, "timestamp": "02:04:45", "text": "クラッカー用？"}, {"type": "subtitle", "time": 7488.629, "timestamp": "02:04:48", "text": "私は他の人を責めなかったし、あなたも責めない。私が勝ちました"}]
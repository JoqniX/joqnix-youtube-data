[{"type": "subtitle", "time": 15720.469, "timestamp": "04:22:00", "text": "理性が与えた時、"}, {"type": "subtitle", "time": 15722.63, "timestamp": "04:22:02", "text": "会話のこと、忘れちゃったみたい。私は思う"}, {"type": "subtitle", "time": 15725.67, "timestamp": "04:22:05", "text": "それは、こちらの会話のことだった。"}, {"type": "subtitle", "time": 15729.269, "timestamp": "04:22:09", "text": "これは彼が聞いていた時のもので、"}, {"type": "subtitle", "time": 15732.63, "timestamp": "04:22:12", "text": "えっと、私たち全員に聞かせて、"}, {"type": "subtitle", "time": 15735.03, "timestamp": "04:22:15", "text": "その意味を理解する。私は言った"}, {"type": "subtitle", "time": 15737.79, "timestamp": "04:22:17", "text": "展示会ですが、そうではありません"}, {"type": "subtitle", "time": 15741.389, "timestamp": "04:22:21", "text": "展示。えっと、それはアートです、それはアートです"}, {"type": "subtitle", "time": 15744.229, "timestamp": "04:22:24", "text": "博物館。私は美術展のように思いました。"}, {"type": "subtitle", "time": 15747.309, "timestamp": "04:22:27", "text": "美術館、何もかも以前と変わらない。"}, {"type": "subtitle", "time": 15749.99, "timestamp": "04:22:29", "text": "しかし、"}, {"type": "subtitle", "time": 15751.91, "timestamp": "04:22:31", "text": "YouTubeで一般公開されている。あなたが知っている"}, {"type": "subtitle", "time": 15753.309, "timestamp": "04:22:33", "text": "どのように"}, {"type": "subtitle", "time": 15762.63, "timestamp": "04:22:42", "text": "そうではない。何も起こらないことを願おう"}, {"type": "subtitle", "time": 15766.309, "timestamp": "04:22:46", "text": "けれど。こんにちは。こんにちは。ああ、これで終わりだ。第四"}, {"type": "subtitle", "time": 15769.11, "timestamp": "04:22:49", "text": "1つ。これを終わらせよう。ありません"}, {"type": "subtitle", "time": 15771.51, "timestamp": "04:22:51", "text": "4つ目の音声。だから私たちは"}, {"type": "subtitle", "time": 15775.99, "timestamp": "04:22:55", "text": "自分たちで書きます。ヨウジ 午後5時"}, {"type": "subtitle", "time": 15779.269, "timestamp": "04:22:59", "text": "悟飯、あれは異質な存在だ。ク・ジハン。"}]
[{"type": "subtitle", "time": 11704.55, "timestamp": "03:15:04", "text": "良い。あ、待って。これはどんな感じですか？"}, {"type": "subtitle", "time": 11707.55, "timestamp": "03:15:07", "text": "待って、私は"}, {"type": "subtitle", "time": 11715.389, "timestamp": "03:15:15", "text": "のように？それは"}, {"type": "subtitle", "time": 11719.03, "timestamp": "03:15:19", "text": "なんて言うんだっけ？軸だが、"}, {"type": "subtitle", "time": 11729.349, "timestamp": "03:15:29", "text": "フィニッシャー。必ず滞在してください"}, {"type": "subtitle", "time": 11738.229, "timestamp": "03:15:38", "text": "それはアクセス権ではありません。この男を見て、ピュー"}, {"type": "subtitle", "time": 11749.07, "timestamp": "03:15:49", "text": "えっと、19日間ですよね？まだ時間はある。"}, {"type": "subtitle", "time": 11752.469, "timestamp": "03:15:52", "text": "えっと、あと、2時間かかる予定です。えっと"}, {"type": "subtitle", "time": 11756.07, "timestamp": "03:15:56", "text": "1時間40分かかる予定です。"}, {"type": "subtitle", "time": 11758.309, "timestamp": "03:15:58", "text": "右？えっと、どうすればいいですか？私は何をしますか？"}]
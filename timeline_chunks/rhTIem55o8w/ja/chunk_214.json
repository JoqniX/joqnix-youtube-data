[{"type": "subtitle", "time": 12841.99, "timestamp": "03:34:01", "text": "ストリーム。クリエイティブストリームは次のようになります"}, {"type": "subtitle", "time": 12844.63, "timestamp": "03:34:04", "text": "その時私はOBS関連の作業をしていました"}, {"type": "subtitle", "time": 12848.229, "timestamp": "03:34:08", "text": "あるいは芸術のようなもの、あるいはライブ任務のようなもの"}, {"type": "subtitle", "time": 12850.229, "timestamp": "03:34:10", "text": "実地訓練や技能習得"}, {"type": "subtitle", "time": 12852.55, "timestamp": "03:34:12", "text": "あるいはコーディングの正しいやり方で、以前は"}, {"type": "subtitle", "time": 12855.63, "timestamp": "03:34:15", "text": "ずっと昔からある種類のストリーム、ちょうど2年前"}, {"type": "subtitle", "time": 12858.63, "timestamp": "03:34:18", "text": "当時は、マルチプルの方が良いと思っていました"}, {"type": "subtitle", "time": 12861.269, "timestamp": "03:34:21", "text": "マルチストリーミングのトレンドが到来したとき、私は"}, {"type": "subtitle", "time": 12862.67, "timestamp": "03:34:22", "text": "夢中になって"}, {"type": "subtitle", "time": 12865.63, "timestamp": "03:34:25", "text": "そうだね"}, {"type": "subtitle", "time": 12869.19, "timestamp": "03:34:29", "text": "こんにちは、では仕事に取り掛かりましょう。ええ、いつでも"}, {"type": "subtitle", "time": 12871.269, "timestamp": "03:34:31", "text": "マルチリームストリーミングは現在"}, {"type": "subtitle", "time": 12872.75, "timestamp": "03:34:32", "text": "もの。"}, {"type": "subtitle", "time": 12875.55, "timestamp": "03:34:35", "text": "えっと、私は"}, {"type": "subtitle", "time": 12877.229, "timestamp": "03:34:37", "text": "それ"}, {"type": "subtitle", "time": 12881.71, "timestamp": "03:34:41", "text": "そして今、ストリームのように"}, {"type": "subtitle", "time": 12885.19, "timestamp": "03:34:45", "text": "エレメントマルチリーマーが登場し、"}, {"type": "subtitle", "time": 12888.95, "timestamp": "03:34:48", "text": "キャンバスが複数枚あるなど。"}, {"type": "subtitle", "time": 12890.87, "timestamp": "03:34:50", "text": "広告の問題ではない。待って、なぜ私は"}, {"type": "subtitle", "time": 12894.15, "timestamp": "03:34:54", "text": "それを宣伝する？気に入ったよ。でも、そうだね"}, {"type": "subtitle", "time": 12897.269, "timestamp": "03:34:57", "text": "むしろ今なら私ができる方法がある"}]
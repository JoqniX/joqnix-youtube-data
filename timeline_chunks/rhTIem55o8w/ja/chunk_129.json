[{"type": "subtitle", "time": 7742.31, "timestamp": "02:09:02", "text": "うん。よし、行こう。私は"}, {"type": "subtitle", "time": 7745.83, "timestamp": "02:09:05", "text": "まとめて保管する。どのサーバーに行けばいいですか？"}, {"type": "subtitle", "time": 7749.629, "timestamp": "02:09:09", "text": "東京が好きかもしれないけど、わからない"}, {"type": "subtitle", "time": 7752.95, "timestamp": "02:09:12", "text": "シンガポールは良い選択だ ムンバイ"}, {"type": "subtitle", "time": 7756.149, "timestamp": "02:09:16", "text": "君たちも差別的な言葉の応酬が見られるよ"}, {"type": "subtitle", "time": 7758.03, "timestamp": "02:09:18", "text": "虐殺を見たい"}, {"type": "subtitle", "time": 7761.43, "timestamp": "02:09:21", "text": "フェスティバル、よし、行こう"}, {"type": "subtitle", "time": 7766.35, "timestamp": "02:09:26", "text": "u"}, {"type": "subtitle", "time": 7769.99, "timestamp": "02:09:29", "text": "ええ、あなたの感覚は11,000 DPIです"}, {"type": "subtitle", "time": 7774.27, "timestamp": "02:09:34", "text": "マウスとゲームでは"}, {"type": "subtitle", "time": 7778.149, "timestamp": "02:09:38", "text": "えっと、どうやって確認するんですか？えっと、どうやって"}, {"type": "subtitle", "time": 7780.51, "timestamp": "02:09:40", "text": "調整する？そうそう。 1"}, {"type": "subtitle", "time": 7783.51, "timestamp": "02:09:43", "text": "0 1 91"}, {"type": "subtitle", "time": 7787.43, "timestamp": "02:09:47", "text": "一致する結果が見つかりました。おはよう、ブラッド。こんにちは。"}, {"type": "subtitle", "time": 7795.39, "timestamp": "02:09:55", "text": "感度"}, {"type": "subtitle", "time": 7798.55, "timestamp": "02:09:58", "text": "0.91 91。"}]
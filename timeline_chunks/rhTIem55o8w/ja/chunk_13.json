[{"type": "subtitle", "time": 812.79, "timestamp": "00:13:32", "text": "私にはわからない。"}, {"type": "subtitle", "time": 820.19, "timestamp": "00:13:40", "text": "えっと、３つか４つあります"}, {"type": "subtitle", "time": 824.43, "timestamp": "00:13:44", "text": "1つのようなもののためのもの"}, {"type": "subtitle", "time": 829.67, "timestamp": "00:13:49", "text": "ストリーム配信中かもしれない。ああ、その件は、えっと、私は"}, {"type": "subtitle", "time": 831.829, "timestamp": "00:13:51", "text": "家族と出かけなければならないし、"}, {"type": "subtitle", "time": 833.87, "timestamp": "00:13:53", "text": "買う"}, {"type": "subtitle", "time": 836.23, "timestamp": "00:13:56", "text": "もの。私が行かなければならない場所のいくつか"}, {"type": "subtitle", "time": 839.269, "timestamp": "00:13:59", "text": "外は、えっと、ちょっと遠い感じですね。だからそれは"}]
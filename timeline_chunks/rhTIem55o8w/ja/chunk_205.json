[{"type": "subtitle", "time": 12300.19, "timestamp": "03:25:00", "text": "私も15分くらい遅刻したよ。"}, {"type": "subtitle", "time": 12302.91, "timestamp": "03:25:02", "text": "おお。"}, {"type": "subtitle", "time": 12310.63, "timestamp": "03:25:10", "text": "夜にも配信したいです。"}, {"type": "subtitle", "time": 12313.55, "timestamp": "03:25:13", "text": "しかし"}, {"type": "subtitle", "time": 12317.309, "timestamp": "03:25:17", "text": "夜に私は"}, {"type": "subtitle", "time": 12323.11, "timestamp": "03:25:23", "text": "クラス。最近は夜11時か12時頃に寝るようになった。"}, {"type": "subtitle", "time": 12325.99, "timestamp": "03:25:25", "text": "私は10時に寝る予定です。こんにちは、"}, {"type": "subtitle", "time": 12342.55, "timestamp": "03:25:42", "text": "[音楽]"}, {"type": "subtitle", "time": 12343.71, "timestamp": "03:25:43", "text": "お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 12347.67, "timestamp": "03:25:47", "text": "良い。そう、スケジュールの問題みたいな"}, {"type": "subtitle", "time": 12350.11, "timestamp": "03:25:50", "text": "です"}, {"type": "subtitle", "time": 12353.15, "timestamp": "03:25:53", "text": "難しい。今まで"}, {"type": "subtitle", "time": 12357.51, "timestamp": "03:25:57", "text": "今まで感じたことありますか？また寝坊してしまいましたか？"}]
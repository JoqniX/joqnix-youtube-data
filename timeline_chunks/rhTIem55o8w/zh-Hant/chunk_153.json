[{"type": "subtitle", "time": 9193.349, "timestamp": "02:33:13", "text": "匆忙。  拿著。  [音樂] 還剩一個敵人。敵方發現B點。 B點在哪裡？  好的。我覺得"}, {"type": "subtitle", "time": 9228.71, "timestamp": "02:33:48", "text": "我做了什麼事"}, {"type": "subtitle", "time": 9230.79, "timestamp": "02:33:50", "text": "。  是的，我做了點什麼。  我可以用一滴。"}, {"type": "subtitle", "time": 9235.99, "timestamp": "02:33:55", "text": "謝謝。"}]
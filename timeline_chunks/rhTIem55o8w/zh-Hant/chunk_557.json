[{"type": "subtitle", "time": 33420.15, "timestamp": "09:17:00", "text": "不分級。沒關係。好了，我們"}, {"type": "subtitle", "time": 33425.112, "timestamp": "09:17:05", "text": "走吧。再一次。沒關係。你好。"}, {"type": "subtitle", "time": 33445.35, "timestamp": "09:17:25", "text": "我將成為靈魂。"}, {"type": "subtitle", "time": 33447.5, "timestamp": "09:17:27", "text": "你想成為靈魂嗎？"}, {"type": "subtitle", "time": 33466.31, "timestamp": "09:17:46", "text": "是的"}]
[{"type": "subtitle", "time": 33846.35, "timestamp": "09:24:06", "text": "嗯，需要一擊斃命"}, {"type": "subtitle", "time": 33864.23, "timestamp": "09:24:24", "text": "。剩下的都是些愚蠢至極的傻瓜"}, {"type": "subtitle", "time": 33865.906, "timestamp": "09:24:25", "text": "。  去！去！去。"}, {"type": "subtitle", "time": 33885.67, "timestamp": "09:24:45", "text": "，查克。請。  沒有什麼"}]
[{"type": "subtitle", "time": 364.15, "timestamp": "00:06:04", "text": "看，"}, {"type": "subtitle", "time": 366.59, "timestamp": "00:06:06", "text": "直播的第二部分，也就是夜間"}, {"type": "subtitle", "time": 369.07, "timestamp": "00:06:09", "text": "直播，第二部分"}, {"type": "subtitle", "time": 372.79, "timestamp": "00:06:12", "text": "直播，我會盡力去做，我會盡力去"}, {"type": "subtitle", "time": 375.27, "timestamp": "00:06:15", "text": "關注它，我會努力去做，"}, {"type": "subtitle", "time": 378.07, "timestamp": "00:06:18", "text": "我早睡的原因是為了調整"}, {"type": "subtitle", "time": 381.35, "timestamp": "00:06:21", "text": "我的作息時間，這樣我才能"}, {"type": "subtitle", "time": 383.749, "timestamp": "00:06:23", "text": "在早晨的直播中更有活力，也就是今天的"}, {"type": "subtitle", "time": 385.909, "timestamp": "00:06:25", "text": "直播，新的一天的第一部分直播"}, {"type": "subtitle", "time": 388.749, "timestamp": "00:06:28", "text": "。"}, {"type": "subtitle", "time": 391.35, "timestamp": "00:06:31", "text": "我不知道。我覺得那可能是個"}, {"type": "subtitle", "time": 393.30899999999997, "timestamp": "00:06:33", "text": "陌生人之類的"}, {"type": "subtitle", "time": 396.15, "timestamp": "00:06:36", "text": "。也許是小孩之類的。我不知道"}, {"type": "subtitle", "time": 400.87, "timestamp": "00:06:40", "text": "。哦，你他媽的為什麼在睡覺什麼的"}, {"type": "subtitle", "time": 403.029, "timestamp": "00:06:43", "text": "？他們說，"}, {"type": "subtitle", "time": 405.71, "timestamp": "00:06:45", "text": "「你真丟臉」之類的話。我"}, {"type": "subtitle", "time": 408.189, "timestamp": "00:06:48", "text": "心想："}, {"type": "subtitle", "time": 411.79, "timestamp": "00:06:51", "text": "「兄弟，你來設身處地想想。連續"}, {"type": "subtitle", "time": 415.11, "timestamp": "00:06:55", "text": "三四個月24小時不間斷直播。"}, {"type": "subtitle", "time": 418.55, "timestamp": "00:06:58", "text": "你就會明白我為什麼"}]
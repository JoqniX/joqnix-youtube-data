[{"type": "subtitle", "time": 28386.15, "timestamp": "07:53:06", "text": "語對吧？如果一天中的時間是晚上，我們就說晚上好；如果一天中的時間是下午，"}, {"type": "subtitle", "time": 28392.11, "timestamp": "07:53:12", "text": "我們就說下午好。哦，哦，等等。它會說“晚安”。它會說晚安。就是這樣。"}, {"type": "subtitle", "time": 28397.91, "timestamp": "07:53:17", "text": "呃，我得做分離工作"}]
[{"type": "subtitle", "time": 6480.95, "timestamp": "01:48:00", "text": "拜託。好的。好的。好的。好的。  好的。好的。好的。好的。好的。演出照常進行。到場。到場。到場。快點。  你一定可以的。  為什麼它開著？在哪裡？"}, {"type": "subtitle", "time": 6493.47, "timestamp": "01:48:13", "text": "年末通行證。什麼？這是什麼？我進度落後了嗎？不。"}, {"type": "subtitle", "time": 6500.59, "timestamp": "01:48:20", "text": "1格"}, {"type": "subtitle", "time": 6509.87, "timestamp": "01:48:29", "text": "？"}, {"type": "subtitle", "time": 6512.35, "timestamp": "01:48:32", "text": "等待。你沒看到比賽嗎？沒有。發生了什麼事？等等"}]
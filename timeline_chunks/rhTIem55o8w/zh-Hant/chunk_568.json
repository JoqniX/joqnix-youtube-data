[{"type": "subtitle", "time": 34085.31, "timestamp": "09:28:05", "text": "直播畫面顯示我"}, {"type": "subtitle", "time": 34088.746, "timestamp": "09:28:08", "text": "輸了。我的天哪。"}, {"type": "subtitle", "time": 34092.39, "timestamp": "09:28:12", "text": "他的電腦常常當機。等等，"}, {"type": "subtitle", "time": 34097.03, "timestamp": "09:28:17", "text": "聊天功能還在進行嗎？是的。是的，他們是。"}, {"type": "subtitle", "time": 34099.83, "timestamp": "09:28:19", "text": "我這是在玩弄我對"}, {"type": "subtitle", "time": 34113.426, "timestamp": "09:28:33", "text": "，真棒。驚人的。"}, {"type": "subtitle", "time": 34119.266, "timestamp": "09:28:39", "text": "我的天哪。哦，不。哦，不。哦，不。那是「別擔心」。不用擔心。我抓到"}, {"type": "subtitle", "time": 34122.79, "timestamp": "09:28:42", "text": "他了。我抓到他了。我抓到他了。喬克。哦，寶貝。你"}, {"type": "subtitle", "time": 34138.31, "timestamp": "09:28:58", "text": "[掌聲]"}]
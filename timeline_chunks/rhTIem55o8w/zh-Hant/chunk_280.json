[{"type": "subtitle", "time": 16805.628, "timestamp": "04:40:05", "text": "好的。這場音樂會。"}, {"type": "subtitle", "time": 16831.27, "timestamp": "04:40:31", "text": "星期二回家。等等，不對，是星期四。是的，"}, {"type": "subtitle", "time": 16836.628, "timestamp": "04:40:36", "text": "moyomi。週四。週四。我的天哪。我還需要練習。好的。"}, {"type": "subtitle", "time": 16846.788, "timestamp": "04:40:46", "text": "呃，這是「土壤」的"}, {"type": "subtitle", "time": 16859.23, "timestamp": "04:40:59", "text": "星期六。嗯（音樂）週六我們會開派對。我們要開派對。嗯，差不多是這樣。我知道解釋這些是在浪費時間"}]
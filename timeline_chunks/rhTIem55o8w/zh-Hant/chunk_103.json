[{"type": "subtitle", "time": 6183.669, "timestamp": "01:43:03", "text": "我得到了它。  我得到了它。我得到了它。另一台"}, {"type": "subtitle", "time": 6204.35, "timestamp": "01:43:24", "text": "電腦上沒有"}, {"type": "subtitle", "time": 6211.109, "timestamp": "01:43:31", "text": "我的主題是…"}, {"type": "subtitle", "time": 6216.709, "timestamp": "01:43:36", "text": "我"}, {"type": "subtitle", "time": 6218.59, "timestamp": "01:43:38", "text": "今天穿的是聖誕主題服裝。  耶。這是好事。好久不見了。  不。這些天我已經"}, {"type": "subtitle", "time": 6222.55, "timestamp": "01:43:42", "text": "直播多久了？我忘了。是"}]
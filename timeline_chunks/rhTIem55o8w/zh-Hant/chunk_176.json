[{"type": "subtitle", "time": 10597.67, "timestamp": "02:56:37", "text": "哦，不。什麼？  我其實是要省錢的。  尖峰向下。重新"}, {"type": "subtitle", "time": 10606.07, "timestamp": "02:56:46", "text": "裝彈。  那兩個人死了。  最後一名倖存者。  我的天啊。  是的，這場"}, {"type": "subtitle", "time": 10611.429, "timestamp": "02:56:51", "text": "比賽結束了。"}, {"type": "subtitle", "time": 10613.269, "timestamp": "02:56:53", "text": "等等，別放棄。不要放棄。不要投降"}]
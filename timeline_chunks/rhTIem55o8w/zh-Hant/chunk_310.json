[{"type": "subtitle", "time": 18613.23, "timestamp": "05:10:13", "text": "競技，星期二、三、四、五"}, {"type": "subtitle", "time": 18616.708, "timestamp": "05:10:16", "text": "。哦，等等。  好的。哦，"}, {"type": "subtitle", "time": 18626.948, "timestamp": "05:10:26", "text": "我想我是這麼認為的"}, {"type": "subtitle", "time": 18629.708, "timestamp": "05:10:29", "text": "。不，"}, {"type": "subtitle", "time": 18632.23, "timestamp": "05:10:32", "text": "等等。不，不，不，不，不，不，不，不，不。呃，Suyobi是星期三。  莫基星期四。週四。那些就那樣吧。好的。測試與反思。呃，一，二，f。"}, {"type": "subtitle", "time": 18643.19, "timestamp": "05:10:43", "text": "我的天啊。主啊"}]
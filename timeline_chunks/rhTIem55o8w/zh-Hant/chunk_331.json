[{"type": "subtitle", "time": 19862.27, "timestamp": "05:31:02", "text": "之前出現的漢字，而且漢字是呃等等第七個沒有漢字，你得是哦第七個沒有漢字，好吧，第八個。啊，"}, {"type": "subtitle", "time": 19864.948, "timestamp": "05:31:04", "text": "找到了。哦，是這個。  衝"}, {"type": "subtitle", "time": 19870.39, "timestamp": "05:31:10", "text": "亞志。阿特拉希。好的。"}, {"type": "subtitle", "time": 19873.868, "timestamp": "05:31:13", "text": "阿特拉希。新的。  好的。好的。好的。我需要研究一下這個。  哦。  好的。這一點很重要。 H.好的。  好的。"}, {"type": "subtitle", "time": 19889.67, "timestamp": "05:31:29", "text": "我直接截圖吧。  把它加到筆記本之類的東西裡。  阿特拉希。阿特拉希。"}, {"type": "subtitle", "time": 19914.948, "timestamp": "05:31:54", "text": "我知道它的意思。是……呃，1……100，對吧？  第100頁，"}, {"type": "subtitle", "time": 19917.628, "timestamp": "05:31:57", "text": "編號100。"}]
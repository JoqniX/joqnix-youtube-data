[{"type": "subtitle", "time": 28205.75, "timestamp": "07:50:05", "text": "如果我正在睡覺，或者如果我處於可破壞狀態，它會顯示不同的訊息，我們會有"}, {"type": "subtitle", "time": 28218.83, "timestamp": "07:50:18", "text": "一個預設值，"}, {"type": "subtitle", "time": 28226.708, "timestamp": "07:50:26", "text": "我們會把它設為"}, {"type": "subtitle", "time": 28228.548, "timestamp": "07:50:28", "text": "預設值。預設選項。我們會安排這個人"}, {"type": "subtitle", "time": 28230.708, "timestamp": "07:50:30", "text": "。  是的。至於睡覺休息之類的安排，我們會把這個複製"}, {"type": "subtitle", "time": 28232.708, "timestamp": "07:50:32", "text": "下來放到這裡。"}, {"type": "subtitle", "time": 28247.788, "timestamp": "07:50:47", "text": "複製這段文字"}]
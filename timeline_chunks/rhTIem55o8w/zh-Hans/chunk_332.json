[{"type": "subtitle", "time": 19921.15, "timestamp": "05:32:01", "text": "呃，所以就像"}, {"type": "subtitle", "time": 19924.35, "timestamp": "05:32:04", "text": "呃，等等，为什么屏幕变黑了？等等，什么？"}, {"type": "subtitle", "time": 19927.59, "timestamp": "05:32:07", "text": "发生了吗？好吧，我没有保存。我做了"}, {"type": "subtitle", "time": 19930.788, "timestamp": "05:32:10", "text": "不是。等等，让我截个图。呃，"}, {"type": "subtitle", "time": 19933.35, "timestamp": "05:32:13", "text": "我写了多少？"}, {"type": "subtitle", "time": 19935.51, "timestamp": "05:32:15", "text": "好的。好的。我……我会再写一遍。"}, {"type": "subtitle", "time": 19939.47, "timestamp": "05:32:19", "text": "没关系。所以，就是这个"}, {"type": "subtitle", "time": 19942.628, "timestamp": "05:32:22", "text": "嗯，我需要学习一下。我会记下这一点。"}, {"type": "subtitle", "time": 19949.11, "timestamp": "05:32:29", "text": "结合但我会，我会核实清楚。"}, {"type": "subtitle", "time": 19952.23, "timestamp": "05:32:32", "text": "快的。嗯，我知道它在哪儿。就像"}, {"type": "subtitle", "time": 19956.67, "timestamp": "05:32:36", "text": "就像在某个地方"}, {"type": "subtitle", "time": 19960.59, "timestamp": "05:32:40", "text": "大概就在这附近。呃，"}, {"type": "subtitle", "time": 19964.15, "timestamp": "05:32:44", "text": "不。就在这附近。我知道"}, {"type": "subtitle", "time": 19967.43, "timestamp": "05:32:47", "text": "你在这里。不管是大的还是小的。"}, {"type": "subtitle", "time": 19970.19, "timestamp": "05:32:50", "text": "我确信是这样。"}, {"type": "subtitle", "time": 19978.628, "timestamp": "05:32:58", "text": "汉字。不是你们的错。如果这些人"}]
[{"type": "subtitle", "time": 6361.43, "timestamp": "01:46:01", "text": "再次？看起来像是游戏崩溃了。是"}, {"type": "subtitle", "time": 6364.149, "timestamp": "01:46:04", "text": "进行快速维修。并且自动"}, {"type": "subtitle", "time": 6367.35, "timestamp": "01:46:07", "text": "将其重新投入游戏。如果它告诉我"}, {"type": "subtitle", "time": 6371.47, "timestamp": "01:46:11", "text": "我必须重启电脑，我要结束了。"}, {"type": "subtitle", "time": 6374.55, "timestamp": "01:46:14", "text": "因为上次重启了流媒体。"}, {"type": "subtitle", "time": 6378.229, "timestamp": "01:46:18", "text": "直播效果不好。我们不得不再次"}, {"type": "subtitle", "time": 6378.83, "timestamp": "01:46:18", "text": "你"}, {"type": "subtitle", "time": 6395.149, "timestamp": "01:46:35", "text": "[音乐]"}, {"type": "subtitle", "time": 6398.87, "timestamp": "01:46:38", "text": "疼痛、擦伤，没关系，也还可以。"}, {"type": "subtitle", "time": 6400.03, "timestamp": "01:46:40", "text": "圣诞节"}, {"type": "subtitle", "time": 6404.149, "timestamp": "01:46:44", "text": "所以昨天我谈到了……"}, {"type": "subtitle", "time": 6406.55, "timestamp": "01:46:46", "text": "举办一些圣诞节活动"}, {"type": "subtitle", "time": 6412.55, "timestamp": "01:46:52", "text": "呃，具体是什么呢？我会发帖说明的。"}, {"type": "subtitle", "time": 6415.91, "timestamp": "01:46:55", "text": "今晚。呃，今天"}, {"type": "subtitle", "time": 6418.99, "timestamp": "01:46:58", "text": "呃，等等，我需要考虑一下。"}]
[{"type": "subtitle", "time": 4381.75, "timestamp": "01:13:01", "text": "不想限制他们对……的使用"}, {"type": "subtitle", "time": 4383.709, "timestamp": "01:13:03", "text": "就像表达一样"}, {"type": "subtitle", "time": 4385.79, "timestamp": "01:13:05", "text": "他们自己"}, {"type": "subtitle", "time": 4389.189, "timestamp": "01:13:09", "text": "对，就像……嗯，这就是为什么你可能会……"}, {"type": "subtitle", "time": 4393.27, "timestamp": "01:13:13", "text": "注意到他们像很多人一样都在问"}, {"type": "subtitle", "time": 4396.63, "timestamp": "01:13:16", "text": "我喜欢运动型男，我可以骂脏话吗？"}, {"type": "subtitle", "time": 4398.55, "timestamp": "01:13:18", "text": "呃，还有那些乱七八糟的事，我当时"}, {"type": "subtitle", "time": 4400.55, "timestamp": "01:13:20", "text": "是的，请随意，你可以。"}, {"type": "subtitle", "time": 4402.51, "timestamp": "01:13:22", "text": "你自己不"}, {"type": "subtitle", "time": 4404.669, "timestamp": "01:13:24", "text": "诸如此类的担忧"}, {"type": "subtitle", "time": 4407.59, "timestamp": "01:13:27", "text": "那是因为那条规则不适用"}, {"type": "subtitle", "time": 4410.95, "timestamp": "01:13:30", "text": "请来找我，因为我有自己的规则。"}, {"type": "subtitle", "time": 4413.35, "timestamp": "01:13:33", "text": "我自己的生活琐事，我不想……"}, {"type": "subtitle", "time": 4416.27, "timestamp": "01:13:36", "text": "诅咒或类似的东西"}, {"type": "subtitle", "time": 4419.35, "timestamp": "01:13:39", "text": "并且针对某人或任何人"}, {"type": "subtitle", "time": 4421.47, "timestamp": "01:13:41", "text": "或者像使用那些"}, {"type": "subtitle", "time": 4426.229, "timestamp": "01:13:46", "text": "字。我照做了，嗯，还有那条规则，我"}, {"type": "subtitle", "time": 4428.669, "timestamp": "01:13:48", "text": "我想把它添加到我的频道里，因为"}, {"type": "chat", "time": 4429.644, "timestamp": "01:13:49", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "You was close to saying the b word in the clip"}, {"type": "subtitle", "time": 4430.59, "timestamp": "01:13:50", "text": "出色地。但"}, {"type": "subtitle", "time": 4434.87, "timestamp": "01:13:54", "text": "是的，对于观众来说，你可以这样做，但是……"}, {"type": "subtitle", "time": 4437.189, "timestamp": "01:13:57", "text": "未能实现的局限性"}, {"type": "subtitle", "time": 4438.99, "timestamp": "01:13:58", "text": "不舒服"}]
[{"type": "subtitle", "time": 841.269, "timestamp": "00:14:01", "text": "可能需要一到两个小时，或者三个小时。"}, {"type": "subtitle", "time": 842.829, "timestamp": "00:14:02", "text": "最大限度。"}, {"type": "subtitle", "time": 846.47, "timestamp": "00:14:06", "text": "回到我的家，回到我的家"}, {"type": "subtitle", "time": 847.55, "timestamp": "00:14:07", "text": "和"}, {"type": "subtitle", "time": 850.59, "timestamp": "00:14:10", "text": "一切。我不"}, {"type": "subtitle", "time": 853.11, "timestamp": "00:14:13", "text": "知道。我不能给他们这样的借口。"}, {"type": "subtitle", "time": 855.829, "timestamp": "00:14:15", "text": "我一直都忙得不可开交。不，我"}, {"type": "subtitle", "time": 858.47, "timestamp": "00:14:18", "text": "我甚至都没告诉他们我在做什么。"}, {"type": "subtitle", "time": 861.509, "timestamp": "00:14:21", "text": "我这么做是因为我不得不这么做。我有"}, {"type": "subtitle", "time": 863.55, "timestamp": "00:14:23", "text": "别无选择，只能这样做"}, {"type": "subtitle", "time": 865.949, "timestamp": "00:14:25", "text": "它和"}, {"type": "subtitle", "time": 868.949, "timestamp": "00:14:28", "text": "一切都是因为我已经说过了，就像我"}, {"type": "subtitle", "time": 873.509, "timestamp": "00:14:33", "text": "就像努力工作一样"}, {"type": "subtitle", "time": 876.629, "timestamp": "00:14:36", "text": "日本将偿还租金"}, {"type": "subtitle", "time": 879.67, "timestamp": "00:14:39", "text": "还有学费和其他所有费用。我 我"}, {"type": "subtitle", "time": 881.11, "timestamp": "00:14:41", "text": "前6个月不必这样做"}, {"type": "subtitle", "time": 883.829, "timestamp": "00:14:43", "text": "几个月后，但6个月后，不，我必须……"}, {"type": "subtitle", "time": 885.87, "timestamp": "00:14:45", "text": "努力工作，偿还债务。"}, {"type": "subtitle", "time": 888.509, "timestamp": "00:14:48", "text": "不。"}, {"type": "subtitle", "time": 892.55, "timestamp": "00:14:52", "text": "正确的。正确的。我不能让我的家人付钱。"}, {"type": "subtitle", "time": 895.389, "timestamp": "00:14:55", "text": "我的东西一直都在，"}]
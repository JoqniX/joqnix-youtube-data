[{"type": "subtitle", "time": 901.55, "timestamp": "00:15:01", "text": "而且由于"}, {"type": "subtitle", "time": 904.43, "timestamp": "00:15:04", "text": "Joathon 的东西是"}, {"type": "subtitle", "time": 908.949, "timestamp": "00:15:08", "text": "情况不妙，我们仍然毫无进展。"}, {"type": "subtitle", "time": 911.509, "timestamp": "00:15:11", "text": "靠近终点或检查点"}, {"type": "subtitle", "time": 915.11, "timestamp": "00:15:15", "text": "里程碑等等，"}, {"type": "subtitle", "time": 918.629, "timestamp": "00:15:18", "text": "呃，我得即兴发挥一下，比如……"}, {"type": "subtitle", "time": 920.91, "timestamp": "00:15:20", "text": "采取行动"}, {"type": "subtitle", "time": 925.269, "timestamp": "00:15:25", "text": "它无需依赖流媒体即可实现，而且"}, {"type": "subtitle", "time": 931.829, "timestamp": "00:15:31", "text": "[音乐]"}, {"type": "subtitle", "time": 933.75, "timestamp": "00:15:33", "text": "是的，后台情况不太妙。"}, {"type": "subtitle", "time": 936.11, "timestamp": "00:15:36", "text": "结尾。我只能做到这些了。"}, {"type": "subtitle", "time": 940.389, "timestamp": "00:15:40", "text": "说。关掉，关掉，或者开着"}, {"type": "subtitle", "time": 941.55, "timestamp": "00:15:41", "text": "我不"}, {"type": "subtitle", "time": 944.389, "timestamp": "00:15:44", "text": "我知道，但我会想办法的。患病的"}, {"type": "chat", "time": 944.928, "timestamp": "00:15:44", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "morning mr nix"}, {"type": "subtitle", "time": 945.79, "timestamp": "00:15:45", "text": "想想看"}, {"type": "subtitle", "time": 955.71, "timestamp": "00:15:55", "text": "出去。早上好，克洛诺斯。"}, {"type": "chat", "time": 956.799, "timestamp": "00:15:56", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "its a sad day"}]
[{"type": "subtitle", "time": 1214.47, "timestamp": "00:20:14", "text": "但现在情况是一样的。"}, {"type": "subtitle", "time": 1218.07, "timestamp": "00:20:18", "text": "适用于我昨天注意到的情况"}, {"type": "subtitle", "time": 1220.789, "timestamp": "00:20:20", "text": "突袭了我。这是我第二次这么做了。"}, {"type": "subtitle", "time": 1224.99, "timestamp": "00:20:24", "text": "趁我睡觉时，他们袭击了我。我感觉"}, {"type": "subtitle", "time": 1228.149, "timestamp": "00:20:28", "text": "坏的。这就是我刚才说的。"}, {"type": "subtitle", "time": 1230.87, "timestamp": "00:20:30", "text": "关于。我真的应该做第二个吗？"}, {"type": "subtitle", "time": 1233.51, "timestamp": "00:20:33", "text": "现在开始直播了吗？但也有"}, {"type": "subtitle", "time": 1236.149, "timestamp": "00:20:36", "text": "有时候我不得不参与合作之类的活动"}, {"type": "subtitle", "time": 1238.029, "timestamp": "00:20:38", "text": "在"}, {"type": "subtitle", "time": 1250.789, "timestamp": "00:20:50", "text": "为什么Twitch上的用户会……"}, {"type": "subtitle", "time": 1253.83, "timestamp": "00:20:53", "text": "他们做这些事没关系，但是当我"}, {"type": "subtitle", "time": 1256.95, "timestamp": "00:20:56", "text": "当我在……时，用多线程运行它"}, {"type": "subtitle", "time": 1259.47, "timestamp": "00:20:59", "text": "YouTube上也有人不喜欢。"}]
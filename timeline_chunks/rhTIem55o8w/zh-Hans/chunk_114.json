[{"type": "subtitle", "time": 6845.75, "timestamp": "01:54:05", "text": "等待。当然可以。"}, {"type": "subtitle", "time": 6850.99, "timestamp": "01:54:10", "text": "我的天啊，这游戏太卡顿了。"}, {"type": "subtitle", "time": 6858.109, "timestamp": "01:54:18", "text": "在。菜单上的菜品就像超级一号一样。"}, {"type": "subtitle", "time": 6860.709, "timestamp": "01:54:20", "text": "出现。等等，我可以点击设置吗？"}, {"type": "subtitle", "time": 6862.629, "timestamp": "01:54:22", "text": "请？点击，点击，点击，点击。为什么"}, {"type": "subtitle", "time": 6865.91, "timestamp": "01:54:25", "text": "是否有装载？我希望我能让你"}, {"type": "subtitle", "time": 6868.149, "timestamp": "01:54:28", "text": "伙计们，看看我屏幕上发生了什么。"}, {"type": "subtitle", "time": 6870.31, "timestamp": "01:54:30", "text": "如果是这样，如果它显示了，你可以"}, {"type": "subtitle", "time": 6873.27, "timestamp": "01:54:33", "text": "看。嘿，等等。让我试着登录一下"}, {"type": "subtitle", "time": 6877.55, "timestamp": "01:54:37", "text": "你一定可以的。"}, {"type": "subtitle", "time": 6880.149, "timestamp": "01:54:40", "text": "设置。再多一点。快点。"}, {"type": "subtitle", "time": 6881.31, "timestamp": "01:54:41", "text": "你得到了"}, {"type": "subtitle", "time": 6885.03, "timestamp": "01:54:45", "text": "这。帧率再提高一点。给它。"}, {"type": "subtitle", "time": 6885.79, "timestamp": "01:54:45", "text": "给"}, {"type": "subtitle", "time": 6888.79, "timestamp": "01:54:48", "text": "它。视频。点击观看视频。快点。我是"}, {"type": "subtitle", "time": 6892.189, "timestamp": "01:54:52", "text": "点击它。请打开视频。"}, {"type": "subtitle", "time": 6895.39, "timestamp": "01:54:55", "text": "好的。改变。改变。改变。改变"}, {"type": "subtitle", "time": 6897.91, "timestamp": "01:54:57", "text": "那。窗户。全屏。快点。来"}]
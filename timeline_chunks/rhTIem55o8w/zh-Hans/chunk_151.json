[{"type": "subtitle", "time": 9063.91, "timestamp": "02:31:03", "text": "太棒了。上次表现不错。什么？"}, {"type": "subtitle", "time": 9065.55, "timestamp": "02:31:05", "text": "上一场比赛是"}, {"type": "subtitle", "time": 9068.71, "timestamp": "02:31:08", "text": "好的。那很好。我被击杀了"}, {"type": "subtitle", "time": 9071.51, "timestamp": "02:31:11", "text": "瞎的。"}, {"type": "subtitle", "time": 9088.15, "timestamp": "02:31:28", "text": "去找找他们。"}, {"type": "subtitle", "time": 9090.95, "timestamp": "02:31:30", "text": "狩猎开始了。敌方目标。你想"}, {"type": "subtitle", "time": 9094.15, "timestamp": "02:31:34", "text": "玩吗？让我们玩。发现敌军。"}, {"type": "subtitle", "time": 9109.19, "timestamp": "02:31:49", "text": "我尽力了。我很高兴拿到了两个人头。"}]
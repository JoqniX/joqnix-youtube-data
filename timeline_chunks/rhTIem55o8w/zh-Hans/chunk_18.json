[{"type": "subtitle", "time": 1082.63, "timestamp": "00:18:02", "text": "评论。但这难道不是一种现象吗？"}, {"type": "subtitle", "time": 1084.669, "timestamp": "00:18:04", "text": "还有吗？"}, {"type": "subtitle", "time": 1087.029, "timestamp": "00:18:07", "text": "就像你看到的一样。我知道。我会私信你。"}, {"type": "subtitle", "time": 1088.87, "timestamp": "00:18:08", "text": "你。不用担心。我会把模组放进去。"}, {"type": "subtitle", "time": 1098.19, "timestamp": "00:18:18", "text": "你觉得我这样做更好吗？"}, {"type": "subtitle", "time": 1101.75, "timestamp": "00:18:21", "text": "比如 5 分钟或 10 分钟的关注"}, {"type": "subtitle", "time": 1103.909, "timestamp": "00:18:23", "text": "关注后，您需要等待10分钟。"}, {"type": "subtitle", "time": 1106.15, "timestamp": "00:18:26", "text": "几分钟或五分钟的评论时间"}, {"type": "subtitle", "time": 1112.71, "timestamp": "00:18:32", "text": "现在，我该如何移除这些？"}, {"type": "subtitle", "time": 1116.909, "timestamp": "00:18:36", "text": "哪些人是喷子？就像即使在"}, {"type": "subtitle", "time": 1119.75, "timestamp": "00:18:39", "text": "Twitch上有很多用户"}, {"type": "subtitle", "time": 1123.27, "timestamp": "00:18:43", "text": "自我推销，喜欢来凑热闹"}, {"type": "subtitle", "time": 1126.07, "timestamp": "00:18:46", "text": "给他们穿上衣服，把自己伪装成GFS"}, {"type": "subtitle", "time": 1128.789, "timestamp": "00:18:48", "text": "胡说八道，最后却暴露了真相。"}, {"type": "subtitle", "time": 1130.71, "timestamp": "00:18:50", "text": "他们是平面设计师，"}, {"type": "subtitle", "time": 1138.15, "timestamp": "00:18:58", "text": "我根本不会上钩。"}]
[{"type": "subtitle", "time": 18900.948, "timestamp": "05:15:00", "text": "星期日？星期一。京义，周二，"}, {"type": "subtitle", "time": 18903.35, "timestamp": "05:15:03", "text": "星期三、星期四、星期五。哦，等等。"}, {"type": "subtitle", "time": 18905.23, "timestamp": "05:15:05", "text": "好的。哦，我"}, {"type": "subtitle", "time": 18911.99, "timestamp": "05:15:11", "text": "所以。不，等等。不，不，不，不，不，不，"}, {"type": "subtitle", "time": 18914.788, "timestamp": "05:15:14", "text": "不，不，不。呃，Suyobi是星期三。"}, {"type": "subtitle", "time": 18918.91, "timestamp": "05:15:18", "text": "莫基星期四。周四。那些东西也就那样吧。"}, {"type": "subtitle", "time": 18921.99, "timestamp": "05:15:21", "text": "所以。好的。测试与反思。呃，一，"}, {"type": "subtitle", "time": 18926.07, "timestamp": "05:15:26", "text": "二，f。我的天哪，有份试卷"}, {"type": "subtitle", "time": 18928.47, "timestamp": "05:15:28", "text": "共五章。我的天啊。哦"}, {"type": "subtitle", "time": 18937.07, "timestamp": "05:15:37", "text": "我。等等，可是我该如何进行测试呢？"}, {"type": "subtitle", "time": 18940.788, "timestamp": "05:15:40", "text": "等等，等等。我该如何进行测试？听"}, {"type": "subtitle", "time": 18944.788, "timestamp": "05:15:44", "text": "并写出平假名或片假名。"}, {"type": "subtitle", "time": 18946.47, "timestamp": "05:15:46", "text": "用罗马字母写出汉字读音。"}, {"type": "subtitle", "time": 18951.51, "timestamp": "05:15:51", "text": "字母。哦，我在这里等着。测试内容是什么"}, {"type": "subtitle", "time": 18953.868, "timestamp": "05:15:53", "text": "考试？等待。"}, {"type": "subtitle", "time": 18956.07, "timestamp": "05:15:56", "text": "呃，等等，等等，等等，等等，等等，等等，"}, {"type": "subtitle", "time": 18957.56, "timestamp": "05:15:57", "text": "等待。我在哪里可以买到这个？"}, {"type": "subtitle", "time": 18959.07, "timestamp": "05:15:59", "text": "[音乐]"}]
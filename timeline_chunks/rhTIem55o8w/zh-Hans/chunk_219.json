[{"type": "subtitle", "time": 13141.469, "timestamp": "03:39:01", "text": "有备无患。是的，就是这样。"}, {"type": "subtitle", "time": 13144.349, "timestamp": "03:39:04", "text": "也是这样"}, {"type": "subtitle", "time": 13148.79, "timestamp": "03:39:08", "text": "不是meni，但某种程度上来说也不错"}, {"type": "subtitle", "time": 13151.59, "timestamp": "03:39:11", "text": "这种做法比这样做要好得多。"}, {"type": "subtitle", "time": 13155.269, "timestamp": "03:39:15", "text": "它毫无准备，就像释放一样。"}, {"type": "subtitle", "time": 13158.07, "timestamp": "03:39:18", "text": "一段未经准备的视频，让你后悔不已"}, {"type": "subtitle", "time": 13160.87, "timestamp": "03:39:20", "text": "唉，我本可以做得更好。"}, {"type": "subtitle", "time": 13163.11, "timestamp": "03:39:23", "text": "本来可以做得更不一样一些。"}, {"type": "subtitle", "time": 13165.229, "timestamp": "03:39:25", "text": "类似这样的"}, {"type": "subtitle", "time": 13166.99, "timestamp": "03:39:26", "text": "不这样"}, {"type": "subtitle", "time": 13175.59, "timestamp": "03:39:35", "text": "那。没错，这确实是个挑战。那是"}, {"type": "subtitle", "time": 13176.83, "timestamp": "03:39:36", "text": "我喜欢的原因"}, {"type": "subtitle", "time": 13179.349, "timestamp": "03:39:39", "text": "它。每天都感觉像你"}, {"type": "subtitle", "time": 13181.349, "timestamp": "03:39:41", "text": "挑战自己去做某件事"}, {"type": "subtitle", "time": 13183.83, "timestamp": "03:39:43", "text": "新的，对吧？或者如果你也在做同样的事情"}, {"type": "subtitle", "time": 13186.87, "timestamp": "03:39:46", "text": "反复做同一件事，你会感到厌倦。"}, {"type": "subtitle", "time": 13190.229, "timestamp": "03:39:50", "text": "不仅如此，你还会想做"}, {"type": "subtitle", "time": 13193.429, "timestamp": "03:39:53", "text": "一些新的东西，或者如果它已经是的话。"}, {"type": "subtitle", "time": 13195.83, "timestamp": "03:39:55", "text": "现有的，你试图把它融入其中"}, {"type": "subtitle", "time": 13198.51, "timestamp": "03:39:58", "text": "用你自己的方式。类似"}]
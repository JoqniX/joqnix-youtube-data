[{"type": "subtitle", "time": 11046.07, "timestamp": "03:04:06", "text": "最后一名幸存者。"}, {"type": "subtitle", "time": 11048.95, "timestamp": "03:04:08", "text": "我的天啊。"}, {"type": "subtitle", "time": 11051.71, "timestamp": "03:04:11", "text": "是的，这款游戏是"}, {"type": "subtitle", "time": 11069.51, "timestamp": "03:04:29", "text": "投降。我们仍然拥有它。我们仍然"}, {"type": "subtitle", "time": 11072.23, "timestamp": "03:04:32", "text": "明白了。相信力量"}, {"type": "subtitle", "time": 11074.83, "timestamp": "03:04:34", "text": "的"}, {"type": "subtitle", "time": 11082.67, "timestamp": "03:04:42", "text": "上帝。相信力量"}, {"type": "subtitle", "time": 11085.309, "timestamp": "03:04:45", "text": "团队。我们是"}, {"type": "subtitle", "time": 11088.429, "timestamp": "03:04:48", "text": "游戏。我们将"}]
[{"type": "subtitle", "time": 15720.469, "timestamp": "04:22:00", "text": "你知道当理智像……一样消失的时候"}, {"type": "subtitle", "time": 15722.63, "timestamp": "04:22:02", "text": "我好像忘了那次谈话的内容。我认为"}, {"type": "subtitle", "time": 15725.67, "timestamp": "04:22:05", "text": "就是这边的这段对话。"}, {"type": "subtitle", "time": 15729.269, "timestamp": "04:22:09", "text": "当他听的时候，就像这样"}, {"type": "subtitle", "time": 15732.63, "timestamp": "04:22:12", "text": "呃，好像让我们所有人都听到了似的。"}, {"type": "subtitle", "time": 15735.03, "timestamp": "04:22:15", "text": "理解它的含义。我说"}, {"type": "subtitle", "time": 15737.79, "timestamp": "04:22:17", "text": "展览，但它不是"}, {"type": "subtitle", "time": 15741.389, "timestamp": "04:22:21", "text": "展览。呃，这是艺术，这是艺术。"}, {"type": "subtitle", "time": 15744.229, "timestamp": "04:22:24", "text": "博物馆。我当时想，就像艺术展览一样，"}, {"type": "subtitle", "time": 15747.309, "timestamp": "04:22:27", "text": "艺术博物馆，一切都和以前一样了。"}, {"type": "subtitle", "time": 15749.99, "timestamp": "04:22:29", "text": "但也可以听来自"}, {"type": "subtitle", "time": 15751.91, "timestamp": "04:22:31", "text": "可在 YouTube 上公开观看。你知道"}, {"type": "subtitle", "time": 15753.309, "timestamp": "04:22:33", "text": "它是如何做到的"}, {"type": "subtitle", "time": 15762.63, "timestamp": "04:22:42", "text": "不。但愿什么事都不会发生。"}, {"type": "subtitle", "time": 15766.309, "timestamp": "04:22:46", "text": "尽管。你好。你好。好了，这件事完成了。第四"}, {"type": "subtitle", "time": 15769.11, "timestamp": "04:22:49", "text": "一。我们结束这件事吧。没有"}, {"type": "subtitle", "time": 15771.51, "timestamp": "04:22:51", "text": "第四个音频。所以我们必须"}, {"type": "subtitle", "time": 15775.99, "timestamp": "04:22:55", "text": "呃，我们自己写。 Yoji 下午 5 点"}, {"type": "subtitle", "time": 15779.269, "timestamp": "04:22:59", "text": "悟饭，他才是那个特例。库吉汉。"}]
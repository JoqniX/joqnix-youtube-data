[{"type": "subtitle", "time": 8111.669, "timestamp": "02:15:11", "text": "我的鼠标到底怎么了？"}, {"type": "subtitle", "time": 8114.47, "timestamp": "02:15:14", "text": "还剩一个敌人。我的鼠标是"}, {"type": "subtitle", "time": 8116.39, "timestamp": "02:15:16", "text": "偷窥。"}, {"type": "subtitle", "time": 8119.91, "timestamp": "02:15:19", "text": "停止。停止。停止。停止。停止。停止。"}, {"type": "subtitle", "time": 8122.069, "timestamp": "02:15:22", "text": "停止。怎么了？"}, {"type": "subtitle", "time": 8125.189, "timestamp": "02:15:25", "text": "决不。我的鼠标坏了。不，不，不"}, {"type": "subtitle", "time": 8128.91, "timestamp": "02:15:28", "text": "不，不，不，不。怎么了？"}, {"type": "subtitle", "time": 8133.75, "timestamp": "02:15:33", "text": "什么？什么？什么？"}, {"type": "subtitle", "time": 8136.229, "timestamp": "02:15:36", "text": "让我靠近一点。什么？而你是"}, {"type": "subtitle", "time": 8139.669, "timestamp": "02:15:39", "text": "已经死了。"}, {"type": "subtitle", "time": 8142.229, "timestamp": "02:15:42", "text": "嗯？"}, {"type": "subtitle", "time": 8144.39, "timestamp": "02:15:44", "text": "这是一套吗？这就是吗？一定是这样"}, {"type": "subtitle", "time": 8146.629, "timestamp": "02:15:46", "text": "场景？不，不，不，不，不。我知道"}, {"type": "subtitle", "time": 8149.91, "timestamp": "02:15:49", "text": "我的鼠标。它坚不可摧。不可能"}, {"type": "subtitle", "time": 8151.99, "timestamp": "02:15:51", "text": "破碎的。它不可能完美。当然"}, {"type": "subtitle", "time": 8155.55, "timestamp": "02:15:55", "text": "不是。谢谢。"}, {"type": "subtitle", "time": 8159.31, "timestamp": "02:15:59", "text": "等等，在哪儿？"}]
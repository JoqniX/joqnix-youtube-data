[{"type": "subtitle", "time": 13740.349, "timestamp": "03:49:00", "text": "它太小了。它太短了。没有任何"}, {"type": "subtitle", "time": 13743.87, "timestamp": "03:49:03", "text": "那里。为什么会这样？"}, {"type": "subtitle", "time": 13747.51, "timestamp": "03:49:07", "text": "短的？就像Twitch那个更……"}, {"type": "subtitle", "time": 13750.87, "timestamp": "03:49:10", "text": "详细的。你看，它细节做得非常到位。"}, {"type": "subtitle", "time": 13754.83, "timestamp": "03:49:14", "text": "它给了你很多东西，比如统计数据。"}, {"type": "subtitle", "time": 13757.189, "timestamp": "03:49:17", "text": "一切。哦，等等。我可以看看我的"}, {"type": "subtitle", "time": 13763.87, "timestamp": "03:49:23", "text": "锈蚀"}, {"type": "subtitle", "time": 13767.269, "timestamp": "03:49:27", "text": "大约。是的，我当时正在努力。"}, {"type": "subtitle", "time": 13775.87, "timestamp": "03:49:35", "text": "[音乐]"}, {"type": "subtitle", "time": 13779.51, "timestamp": "03:49:39", "text": "滴落。是的，就是这些人。"}, {"type": "subtitle", "time": 13781.429, "timestamp": "03:49:41", "text": "我真正认真看过的主播"}, {"type": "subtitle", "time": 13786.67, "timestamp": "03:49:46", "text": "因为我非常喜欢它们。"}, {"type": "subtitle", "time": 13793.229, "timestamp": "03:49:53", "text": "争吵"}, {"type": "subtitle", "time": 13795.83, "timestamp": "03:49:55", "text": "徽章。好的，我们来看看另一个。"}, {"type": "subtitle", "time": 13797.87, "timestamp": "03:49:57", "text": "社区。什么是"}]
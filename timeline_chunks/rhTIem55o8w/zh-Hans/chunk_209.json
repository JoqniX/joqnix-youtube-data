[{"type": "subtitle", "time": 12540.07, "timestamp": "03:29:00", "text": "乐趣。所以当谈到我时，我意识到"}, {"type": "subtitle", "time": 12542.07, "timestamp": "03:29:02", "text": "说到这些方面……"}, {"type": "subtitle", "time": 12544.55, "timestamp": "03:29:04", "text": "多人射击游戏，对吧？这"}, {"type": "subtitle", "time": 12548.95, "timestamp": "03:29:08", "text": "主要概念是排名。即使你"}, {"type": "subtitle", "time": 12551.19, "timestamp": "03:29:11", "text": "想参加锦标赛或比赛"}, {"type": "subtitle", "time": 12553.349, "timestamp": "03:29:13", "text": "与其他 YouTuber 一起或参与"}, {"type": "subtitle", "time": 12556.63, "timestamp": "03:29:16", "text": "YouTuber锦标赛以及任何其他活动，"}, {"type": "subtitle", "time": 12558.11, "timestamp": "03:29:18", "text": "你需要"}, {"type": "subtitle", "time": 12559.63, "timestamp": "03:29:19", "text": "一个"}, {"type": "subtitle", "time": 12562.389, "timestamp": "03:29:22", "text": "秩。应该试试Apex。有一个新的"}, {"type": "subtitle", "time": 12568.07, "timestamp": "03:29:28", "text": "活动：冬季特快列车。啊，它又回来了。"}, {"type": "subtitle", "time": 12572.429, "timestamp": "03:29:32", "text": "我想玩这些第一人称射击游戏。"}, {"type": "subtitle", "time": 12575.91, "timestamp": "03:29:35", "text": "但直播会有点困难，因为"}, {"type": "subtitle", "time": 12577.79, "timestamp": "03:29:37", "text": "单台电脑，你"}, {"type": "subtitle", "time": 12581.349, "timestamp": "03:29:41", "text": "知道。是的，我的意思是，我没意见。"}, {"type": "subtitle", "time": 12585.269, "timestamp": "03:29:45", "text": "我用一台电脑进行直播。它是"}, {"type": "subtitle", "time": 12587.59, "timestamp": "03:29:47", "text": "只是会有些卡顿而已。"}, {"type": "subtitle", "time": 12590.63, "timestamp": "03:29:50", "text": "你知道，这次经历会有点糟糕。"}, {"type": "subtitle", "time": 12593.19, "timestamp": "03:29:53", "text": "就这一件事。以及那些"}, {"type": "subtitle", "time": 12595.75, "timestamp": "03:29:55", "text": "观看时会感觉像卡顿"}, {"type": "subtitle", "time": 12597.55, "timestamp": "03:29:57", "text": "溪流。那也是"}]
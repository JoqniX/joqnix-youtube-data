[{"type": "subtitle", "time": 6318.27, "timestamp": "01:45:18", "text": "[音乐]"}, {"type": "subtitle", "time": 6327.91, "timestamp": "01:45:27", "text": "嗯，钻石颜色需要你……"}, {"type": "subtitle", "time": 6330.149, "timestamp": "01:45:30", "text": "最少的血要跟我玩。我的天啊"}, {"type": "subtitle", "time": 6332.109, "timestamp": "01:45:32", "text": "你是"}, {"type": "subtitle", "time": 6334.59, "timestamp": "01:45:34", "text": "钻石。"}, {"type": "subtitle", "time": 6337.39, "timestamp": "01:45:37", "text": "圣。那是"}, {"type": "subtitle", "time": 6339.83, "timestamp": "01:45:39", "text": "哇。好了，它启动了。它启动了。"}, {"type": "subtitle", "time": 6346.47, "timestamp": "01:45:46", "text": "已启动。我感觉不到我的电脑或"}, {"type": "subtitle", "time": 6350.39, "timestamp": "01:45:50", "text": "整台电脑都卡顿。哦，是的。哦，它关上了"}, {"type": "subtitle", "time": 6354.229, "timestamp": "01:45:54", "text": "倒下。有上升。这款游戏，"}, {"type": "subtitle", "time": 6356.27, "timestamp": "01:45:56", "text": "这个游戏，这个游戏，这个游戏，这个"}, {"type": "subtitle", "time": 6359.07, "timestamp": "01:45:59", "text": "游戏。为什么会有更新"}]
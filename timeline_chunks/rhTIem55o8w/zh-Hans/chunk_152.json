[{"type": "subtitle", "time": 9130.23, "timestamp": "02:32:10", "text": "还剩一个敌人。终极准备就绪。"}, {"type": "subtitle", "time": 9132.469, "timestamp": "02:32:12", "text": "已种下种子。"}, {"type": "subtitle", "time": 9146.389, "timestamp": "02:32:26", "text": "我都忘了这家伙还有终极技能这回事了。"}, {"type": "subtitle", "time": 9149.91, "timestamp": "02:32:29", "text": "你把他干掉了吗？"}, {"type": "subtitle", "time": 9153.389, "timestamp": "02:32:33", "text": "换边站。"}, {"type": "subtitle", "time": 9168.389, "timestamp": "02:32:48", "text": "好的。我把它捡了起来。选中了精灵"}, {"type": "subtitle", "time": 9171.59, "timestamp": "02:32:51", "text": "起身把它交给了斗篷，没有"}, {"type": "subtitle", "time": 9173.67, "timestamp": "02:32:53", "text": "原因。他正拿着它。她是"}]
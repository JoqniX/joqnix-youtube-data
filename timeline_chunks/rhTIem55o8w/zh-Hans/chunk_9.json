[{"type": "subtitle", "time": 543.389, "timestamp": "00:09:03", "text": "是的。我又说了，我要跑马拉松。"}, {"type": "subtitle", "time": 548.55, "timestamp": "00:09:08", "text": "就像流媒体播放一样，一直持续到6月12日。"}, {"type": "subtitle", "time": 552.07, "timestamp": "00:09:12", "text": "12号，持续24小时。我说过，而且我……"}, {"type": "subtitle", "time": 555.35, "timestamp": "00:09:15", "text": "去做这件事。就是这样。"}, {"type": "subtitle", "time": 558.03, "timestamp": "00:09:18", "text": "这就是我这么做的唯一原因。"}, {"type": "subtitle", "time": 561.43, "timestamp": "00:09:21", "text": "Jockathon 就像这样持续 24 小时，或者"}, {"type": "subtitle", "time": 563.99, "timestamp": "00:09:23", "text": "否则我本来会想，因为我们已经……"}, {"type": "subtitle", "time": 566.79, "timestamp": "00:09:26", "text": "拿到了 YouTube 合作伙伴资格，一切都搞定了。所以，我"}, {"type": "subtitle", "time": 570.47, "timestamp": "00:09:30", "text": "没有理由喜欢它。"}, {"type": "subtitle", "time": 574.47, "timestamp": "00:09:34", "text": "继续像这样进行24小时直播。"}, {"type": "subtitle", "time": 576.389, "timestamp": "00:09:36", "text": "另外，我还想打破自己的纪录。"}, {"type": "subtitle", "time": 579.509, "timestamp": "00:09:39", "text": "看看我能坚持多久。"}, {"type": "subtitle", "time": 583.509, "timestamp": "00:09:43", "text": "以及所有的一切。更像是一种训练方式"}, {"type": "subtitle", "time": 587.35, "timestamp": "00:09:47", "text": "我自己，我想我不知道我的呃我"}, {"type": "subtitle", "time": 593.07, "timestamp": "00:09:53", "text": "知道我的痛苦"}, {"type": "subtitle", "time": 594.59, "timestamp": "00:09:54", "text": "呃"}, {"type": "subtitle", "time": 597.509, "timestamp": "00:09:57", "text": "总之，希望大家今天都过得愉快。"}]
[{"type": "subtitle", "time": 7020.03, "timestamp": "01:57:00", "text": "你在开玩笑吗，先生？你在开玩笑吧，"}, {"type": "subtitle", "time": 7027.189, "timestamp": "01:57:07", "text": "作品。等等，为什么没有录制？"}, {"type": "subtitle", "time": 7035.47, "timestamp": "01:57:15", "text": "嘿，窗口捕获也并非如此。"}, {"type": "subtitle", "time": 7039.709, "timestamp": "01:57:19", "text": "在职的。呃，我做了什么？"}, {"type": "subtitle", "time": 7043.669, "timestamp": "01:57:23", "text": "做？我得做，好吧，正常的游戏呃"}, {"type": "subtitle", "time": 7052.51, "timestamp": "01:57:32", "text": "好的。我想你们都能听到。"}, {"type": "subtitle", "time": 7056.43, "timestamp": "01:57:36", "text": "仍然。好了，成功了。你好。你好。你好。你好。"}, {"type": "subtitle", "time": 7059.189, "timestamp": "01:57:39", "text": "你好。另外，欢迎来到直播间。一个"}, {"type": "subtitle", "time": 7062.709, "timestamp": "01:57:42", "text": "欢迎。周六快乐，周四快乐。希望"}, {"type": "subtitle", "time": 7064.709, "timestamp": "01:57:44", "text": "你做得很好。我们会死掉"}, {"type": "subtitle", "time": 7066.95, "timestamp": "01:57:46", "text": "匹配。我还没热身。它是"}, {"type": "subtitle", "time": 7068.589, "timestamp": "01:57:48", "text": "好的。我已经5年没玩过这个游戏了。"}, {"type": "subtitle", "time": 7071.31, "timestamp": "01:57:51", "text": "年。呃，但是是"}, {"type": "subtitle", "time": 7075.91, "timestamp": "01:57:55", "text": "好的。我知道。嗯，我了解自己的能力。"}, {"type": "subtitle", "time": 7078.31, "timestamp": "01:57:58", "text": "我不太有信心能打中头部。"}]
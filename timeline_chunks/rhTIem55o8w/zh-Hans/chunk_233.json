[{"type": "subtitle", "time": 13982.15, "timestamp": "03:53:02", "text": "就像一个回顾之类的东西"}, {"type": "subtitle", "time": 13990.87, "timestamp": "03:53:10", "text": "YouTube 的问题在于现在"}, {"type": "subtitle", "time": 13993.75, "timestamp": "03:53:13", "text": "关于 YouTube，问题在于……"}, {"type": "subtitle", "time": 13996.75, "timestamp": "03:53:16", "text": "你参加的比赛类别是这样的："}, {"type": "subtitle", "time": 14000.229, "timestamp": "03:53:20", "text": "Valerant，如果我想换的话……"}, {"type": "subtitle", "time": 14001.91, "timestamp": "03:53:21", "text": "没那么容易，我得做一个"}, {"type": "subtitle", "time": 14002.99, "timestamp": "03:53:22", "text": "不同的"}, {"type": "subtitle", "time": 14005.75, "timestamp": "03:53:25", "text": "直播以及前来观看的人们"}, {"type": "subtitle", "time": 14007.59, "timestamp": "03:53:27", "text": "他们会说，哦，乔打得真好。"}, {"type": "subtitle", "time": 14010.87, "timestamp": "03:53:30", "text": "但当他们收看节目时，就会觉得“哦，他是……”"}, {"type": "subtitle", "time": 14014.71, "timestamp": "03:53:34", "text": "只是闲聊一下这个问题，但 Twitch"}, {"type": "subtitle", "time": 14017.87, "timestamp": "03:53:37", "text": "这样更容易。这样更容易。它是"}, {"type": "subtitle", "time": 14026.349, "timestamp": "03:53:46", "text": "[音乐]"}, {"type": "subtitle", "time": 14030.429, "timestamp": "03:53:50", "text": "正确的？没关系。所以，"}, {"type": "subtitle", "time": 14034.79, "timestamp": "03:53:54", "text": "完毕。嗯，我想尝试做一小时。"}, {"type": "subtitle", "time": 14035.95, "timestamp": "03:53:55", "text": "溪流"}]
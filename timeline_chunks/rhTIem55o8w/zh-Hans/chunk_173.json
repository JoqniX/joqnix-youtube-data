[{"type": "subtitle", "time": 10381.389, "timestamp": "02:53:01", "text": "[音乐]"}, {"type": "subtitle", "time": 10389.19, "timestamp": "02:53:09", "text": "你的童音独特又可爱。"}, {"type": "subtitle", "time": 10390.87, "timestamp": "02:53:10", "text": "相信我。啊，谢谢。这就是原因"}, {"type": "subtitle", "time": 10394.15, "timestamp": "02:53:14", "text": "就像其他人说的那样，因为我也是。"}, {"type": "subtitle", "time": 10395.75, "timestamp": "02:53:15", "text": "在这台名为印度的应用程序上进行流媒体播放"}, {"type": "subtitle", "time": 10398.469, "timestamp": "02:53:18", "text": "是模组吧？就像有些"}, {"type": "subtitle", "time": 10401.87, "timestamp": "02:53:21", "text": "变态。我的天啊，真是"}, {"type": "subtitle", "time": 10404.389, "timestamp": "02:53:24", "text": "疼痛。是的。看看那是不是个女孩"}, {"type": "subtitle", "time": 10428.389, "timestamp": "02:53:48", "text": "最后一名幸存者。 A点下降。是"}]
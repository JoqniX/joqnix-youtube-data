[{"type": "subtitle", "time": 19741.628, "timestamp": "05:29:01", "text": "是的，我写"}, {"type": "subtitle", "time": 19745.67, "timestamp": "05:29:05", "text": "汉字，呃，那我该怎么写呢？"}, {"type": "subtitle", "time": 19748.43, "timestamp": "05:29:08", "text": "这将是英语"}, {"type": "subtitle", "time": 19753.11, "timestamp": "05:29:13", "text": "就像六个呃等等，我得给呃"}, {"type": "subtitle", "time": 19756.27, "timestamp": "05:29:16", "text": "意思是，对，就是这样"}, {"type": "subtitle", "time": 19760.19, "timestamp": "05:29:20", "text": "嗯，一半30"}, {"type": "subtitle", "time": 19766.43, "timestamp": "05:29:26", "text": "分钟，这将是一个时钟。"}, {"type": "subtitle", "time": 19780.23, "timestamp": "05:29:40", "text": "30. 哦，等等。是不是就像“哦，我有……”"}, {"type": "subtitle", "time": 19782.59, "timestamp": "05:29:42", "text": "放置"}, {"type": "subtitle", "time": 19785.03, "timestamp": "05:29:45", "text": "整个过程是“等等，等等，等等”。它是"}, {"type": "subtitle", "time": 19787.19, "timestamp": "05:29:47", "text": "它没有单独加下划线。"}, {"type": "subtitle", "time": 19790.83, "timestamp": "05:29:50", "text": "这是完整的，对吧？所以，"}, {"type": "subtitle", "time": 19793.628, "timestamp": "05:29:53", "text": "呃"}]
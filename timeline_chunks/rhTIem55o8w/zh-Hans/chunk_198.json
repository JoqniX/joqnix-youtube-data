[{"type": "subtitle", "time": 11882.389, "timestamp": "03:18:02", "text": "你们可以写条消息。"}, {"type": "subtitle", "time": 11884.389, "timestamp": "03:18:04", "text": "就像圣诞礼物一样，或者像……"}, {"type": "subtitle", "time": 11886.79, "timestamp": "03:18:06", "text": "圣诞祝福或其他任何内容。写"}, {"type": "subtitle", "time": 11890.07, "timestamp": "03:18:10", "text": "几乎任何你想要的东西"}, {"type": "subtitle", "time": 11893.11, "timestamp": "03:18:13", "text": "圣诞礼物。把它想象成什么"}, {"type": "subtitle", "time": 11896.55, "timestamp": "03:18:16", "text": "你们都在我的生日直播中做了这些事，"}, {"type": "subtitle", "time": 11900.07, "timestamp": "03:18:20", "text": "写得像写生日祝福一样，对吧？"}, {"type": "subtitle", "time": 11903.03, "timestamp": "03:18:23", "text": "就这样。你可以自己编写。"}, {"type": "subtitle", "time": 11904.429, "timestamp": "03:18:24", "text": "如果您希望"}, {"type": "subtitle", "time": 11905.95, "timestamp": "03:18:25", "text": "想"}, {"type": "subtitle", "time": 11909.429, "timestamp": "03:18:29", "text": "任何事物。呃，什么都别写。"}, {"type": "subtitle", "time": 11911.75, "timestamp": "03:18:31", "text": "有点吓人，好吗？或者不要写任何不好的东西。"}, {"type": "subtitle", "time": 11915.75, "timestamp": "03:18:35", "text": "事情都好吗？但你可以自己写。"}, {"type": "subtitle", "time": 11919.99, "timestamp": "03:18:39", "text": "喜欢的话就许愿吧。我做到了这一点"}, {"type": "subtitle", "time": 11922.15, "timestamp": "03:18:42", "text": "任何人都可以"}, {"type": "subtitle", "time": 11926.11, "timestamp": "03:18:46", "text": "呃，我把它设置成任何人都可以写成这样。"}, {"type": "subtitle", "time": 11931.91, "timestamp": "03:18:51", "text": "呃，等等，链接是什么来着？患病的"}, {"type": "subtitle", "time": 11934.309, "timestamp": "03:18:54", "text": "把它发布到当前直播中"}, {"type": "subtitle", "time": 11937.349, "timestamp": "03:18:57", "text": "聊天。那我明天就发过去。"}, {"type": "subtitle", "time": 11939.91, "timestamp": "03:18:59", "text": "我会在今晚之后把它发出来。"}]
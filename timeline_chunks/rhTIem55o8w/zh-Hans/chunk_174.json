[{"type": "subtitle", "time": 10440.99, "timestamp": "02:54:00", "text": "他们打了两轮。那是"}, {"type": "subtitle", "time": 10444.389, "timestamp": "02:54:04", "text": "好的。呃，为什么我的血糖会飙升？我"}, {"type": "subtitle", "time": 10447.67, "timestamp": "02:54:07", "text": "不想被尖刺扎伤。喜欢的话就点赞吧"}, {"type": "subtitle", "time": 10448.99, "timestamp": "02:54:08", "text": "有了尖峰，那就是你的"}, {"type": "subtitle", "time": 10452.07, "timestamp": "02:54:12", "text": "责任，对吧？计划计划"}, {"type": "subtitle", "time": 10454.67, "timestamp": "02:54:14", "text": "等等，"}, {"type": "subtitle", "time": 10456.19, "timestamp": "02:54:16", "text": "兄弟。"}, {"type": "subtitle", "time": 10460.79, "timestamp": "02:54:20", "text": "哈内，跟我们一起走。哦，"}, {"type": "subtitle", "time": 10468.87, "timestamp": "02:54:28", "text": "好的。这可能是因为某些地图"}, {"type": "subtitle", "time": 10472.11, "timestamp": "02:54:32", "text": "太糟糕了。"}, {"type": "subtitle", "time": 10495.269, "timestamp": "02:54:55", "text": "直接用刀切就行了。"}, {"type": "subtitle", "time": 10497.23, "timestamp": "02:54:57", "text": "哦"}]
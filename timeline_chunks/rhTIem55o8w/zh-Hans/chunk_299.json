[{"type": "subtitle", "time": 17940.47, "timestamp": "04:59:00", "text": "她说了什么？我的天哪。是的。你知道"}, {"type": "subtitle", "time": 17943.91, "timestamp": "04:59:03", "text": "在我监听NAT的过程中"}, {"type": "subtitle", "time": 17947.19, "timestamp": "04:59:07", "text": "考试的时候，他们不让我听音频。"}, {"type": "subtitle", "time": 17949.75, "timestamp": "04:59:09", "text": "两次、三次、四次。只是"}, {"type": "subtitle", "time": 17953.51, "timestamp": "04:59:13", "text": "他们最多只会让你听两次。"}, {"type": "subtitle", "time": 17962.47, "timestamp": "04:59:22", "text": "兄弟，我有点听不懂。我"}, {"type": "subtitle", "time": 17964.31, "timestamp": "04:59:24", "text": "明白了。但当它像……"}, {"type": "subtitle", "time": 17967.03, "timestamp": "04:59:27", "text": "现在如果有人问，我会说：“等等，什么？”"}, {"type": "subtitle", "time": 17969.39, "timestamp": "04:59:29", "text": "她说过吗？"}, {"type": "subtitle", "time": 17993.27, "timestamp": "04:59:53", "text": "知道了。知道了。知道了。知道了。知道了。"}, {"type": "subtitle", "time": 17996.15, "timestamp": "04:59:56", "text": "这"}, {"type": "subtitle", "time": 17999.07, "timestamp": "04:59:59", "text": "呃，等等，对吧？"}]
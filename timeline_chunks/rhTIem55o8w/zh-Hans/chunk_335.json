[{"type": "subtitle", "time": 20113.868, "timestamp": "05:35:13", "text": "今晚新上线。所以"}, {"type": "subtitle", "time": 20117.948, "timestamp": "05:35:17", "text": "阿特拉什苦无，这不是什么新鲜事。"}, {"type": "subtitle", "time": 20128.99, "timestamp": "05:35:28", "text": "新的哦，我可以把它写进去"}, {"type": "subtitle", "time": 20130.14, "timestamp": "05:35:30", "text": "平假名"}, {"type": "subtitle", "time": 20131.788, "timestamp": "05:35:31", "text": "[音乐]"}, {"type": "subtitle", "time": 20134.11, "timestamp": "05:35:34", "text": "啊"}, {"type": "subtitle", "time": 20135.868, "timestamp": "05:35:35", "text": "这"}, {"type": "subtitle", "time": 20138.39, "timestamp": "05:35:38", "text": "拉她"}, {"type": "subtitle", "time": 20146.59, "timestamp": "05:35:46", "text": "[音乐]"}]
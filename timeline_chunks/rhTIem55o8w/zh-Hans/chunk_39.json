[{"type": "subtitle", "time": 2342.43, "timestamp": "00:39:02", "text": "24小时直播马拉松"}, {"type": "subtitle", "time": 2346.95, "timestamp": "00:39:06", "text": "东西。然后它提醒了我"}, {"type": "subtitle", "time": 2348.349, "timestamp": "00:39:08", "text": "喜欢"}, {"type": "subtitle", "time": 2352.31, "timestamp": "00:39:12", "text": "哦，就像如果我当初真的实施了我之前想的那个想法一样。"}, {"type": "subtitle", "time": 2353.069, "timestamp": "00:39:13", "text": "我的"}, {"type": "subtitle", "time": 2357.829, "timestamp": "00:39:17", "text": "我当时心里想着，如果我不那样做，我也不害怕。"}, {"type": "subtitle", "time": 2360.39, "timestamp": "00:39:20", "text": "不在乎别人怎么想，就这么做了。"}, {"type": "subtitle", "time": 2363.03, "timestamp": "00:39:23", "text": "它。我本来可以再次点赞的"}, {"type": "subtitle", "time": 2365.51, "timestamp": "00:39:25", "text": "那段时间我花了不少时间看表。"}, {"type": "subtitle", "time": 2368.31, "timestamp": "00:39:28", "text": "也确实得到了一些东西"}, {"type": "subtitle", "time": 2371.19, "timestamp": "00:39:31", "text": "但我感觉好像我没有那样做。"}, {"type": "subtitle", "time": 2373.79, "timestamp": "00:39:33", "text": "努力争取。我"}, {"type": "subtitle", "time": 2376.79, "timestamp": "00:39:36", "text": "就这么跳过了那段艰苦的工作，或者"}, {"type": "subtitle", "time": 2379.15, "timestamp": "00:39:39", "text": "某种程度上，"}, {"type": "subtitle", "time": 2381.91, "timestamp": "00:39:41", "text": "正确的？我不知道是不是像我感觉到的那样。"}, {"type": "subtitle", "time": 2384.51, "timestamp": "00:39:44", "text": "好像那件事很糟糕似的。是的，"}, {"type": "subtitle", "time": 2388.39, "timestamp": "00:39:48", "text": "那我就不知道了。"}, {"type": "subtitle", "time": 2393.03, "timestamp": "00:39:53", "text": "说实话，就像……说实话，得到……"}, {"type": "subtitle", "time": 2396.23, "timestamp": "00:39:56", "text": "Joathon 的 YouTube 合作伙伴计划"}, {"type": "subtitle", "time": 2399.349, "timestamp": "00:39:59", "text": "那种感觉挺好的，因为我"}]
[{"type": "subtitle", "time": 5400.43, "timestamp": "01:30:00", "text": "这样做有什么意义？我不明白"}, {"type": "subtitle", "time": 5405.95, "timestamp": "01:30:05", "text": "它。有人说只要吃就行了吗？"}, {"type": "subtitle", "time": 5409.189, "timestamp": "01:30:09", "text": "叮咚？我不明白。什么好笑"}, {"type": "subtitle", "time": 5422.99, "timestamp": "01:30:22", "text": "如果需要吃饭，就……"}, {"type": "subtitle", "time": 5426.95, "timestamp": "01:30:26", "text": "吃。我不明白。"}, {"type": "chat", "time": 5428.316, "timestamp": "01:30:28", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "because she screamed near the end"}, {"type": "subtitle", "time": 5441.97, "timestamp": "01:30:41", "text": "因为她靠近另一个地方时脸色发绿，所以要拍几张照片。"}, {"type": "chat", "time": 5447.854, "timestamp": "01:30:47", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "Listen to it with our audio off"}, {"type": "subtitle", "time": 5454.11, "timestamp": "01:30:54", "text": "结尾。哦，那欢呼声"}, {"type": "subtitle", "time": 5456.55, "timestamp": "01:30:56", "text": "东西。是的。是的。我正在听。"}, {"type": "chat", "time": 5459.02, "timestamp": "01:30:59", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "Yes"}]
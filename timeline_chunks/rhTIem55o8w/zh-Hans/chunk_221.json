[{"type": "subtitle", "time": 13261.59, "timestamp": "03:41:01", "text": "瓦勒朗音乐。啊，歌唱的溪流"}, {"type": "subtitle", "time": 13264.429, "timestamp": "03:41:04", "text": "今年的。哦"}, {"type": "subtitle", "time": 13270.79, "timestamp": "03:41:10", "text": "是的。 25. 我有25个观众。真的吗？ 25"}, {"type": "subtitle", "time": 13272.95, "timestamp": "03:41:12", "text": "你们当时都在场。等等，那是"}, {"type": "subtitle", "time": 13275.429, "timestamp": "03:41:15", "text": "这就像一个我很少使用的数字"}, {"type": "subtitle", "time": 13278.229, "timestamp": "03:41:18", "text": "很少，极少，基本上"}, {"type": "subtitle", "time": 13280.309, "timestamp": "03:41:20", "text": "看见。"}, {"type": "subtitle", "time": 13282.71, "timestamp": "03:41:22", "text": "就像拥有两位数就像一个大"}, {"type": "subtitle", "time": 13285.269, "timestamp": "03:41:25", "text": "对我来说，这就像……"}, {"type": "subtitle", "time": 13288.03, "timestamp": "03:41:28", "text": "虽然很少见，但我很开心。"}, {"type": "subtitle", "time": 13300.51, "timestamp": "03:41:40", "text": "已发送聊天记录 1445 条。"}, {"type": "subtitle", "time": 13304.63, "timestamp": "03:41:44", "text": "圣。哦，表情符号。耶。呃，运动员生气了"}, {"type": "subtitle", "time": 13316.59, "timestamp": "03:41:56", "text": "第二。"}]
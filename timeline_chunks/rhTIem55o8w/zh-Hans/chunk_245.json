[{"type": "subtitle", "time": 14701.229, "timestamp": "04:05:01", "text": "确实如此"}, {"type": "subtitle", "time": 14710.389, "timestamp": "04:05:10", "text": "稳定的。你好。所以，呃，在开始之前"}, {"type": "subtitle", "time": 14712.63, "timestamp": "04:05:12", "text": "我只是想把直播内容说清楚。"}, {"type": "subtitle", "time": 14715.349, "timestamp": "04:05:15", "text": "在我收到版权警告之前"}, {"type": "subtitle", "time": 14717.269, "timestamp": "04:05:17", "text": "频道，我不想再被警告了。"}, {"type": "subtitle", "time": 14719.309, "timestamp": "04:05:19", "text": "求求你"}, {"type": "subtitle", "time": 14724.309, "timestamp": "04:05:24", "text": "你。请加入他。所以，在我……之前"}, {"type": "subtitle", "time": 14726.15, "timestamp": "04:05:26", "text": "别直播了，我只想剪辑一下。"}, {"type": "subtitle", "time": 14729.349, "timestamp": "04:05:29", "text": "观点。如果我收到版权警告"}, {"type": "subtitle", "time": 14733.11, "timestamp": "04:05:33", "text": "罢工，我会对此提出上诉，因为"}, {"type": "subtitle", "time": 14735.59, "timestamp": "04:05:35", "text": "呃，在描述中，我已经注明了出处。"}, {"type": "subtitle", "time": 14737.349, "timestamp": "04:05:37", "text": "将使用的材料"}, {"type": "subtitle", "time": 14739.67, "timestamp": "04:05:39", "text": "今天的直播。嗯，我们将学习"}, {"type": "subtitle", "time": 14743.75, "timestamp": "04:05:43", "text": "出自 Marugoto 教科书 A1 呃 Rikai"}, {"type": "subtitle", "time": 14746.51, "timestamp": "04:05:46", "text": "教科书和PDF"}, {"type": "subtitle", "time": 14749.429, "timestamp": "04:05:49", "text": "可在 Marugto 官方网站上找到"}, {"type": "subtitle", "time": 14751.11, "timestamp": "04:05:51", "text": "网站。如果有人想学"}, {"type": "subtitle", "time": 14754.03, "timestamp": "04:05:54", "text": "我建议他们学习日语"}, {"type": "subtitle", "time": 14756.63, "timestamp": "04:05:56", "text": "Marugato 只喜欢这样，这对他来说是好事。"}, {"type": "subtitle", "time": 14758.71, "timestamp": "04:05:58", "text": "那些喜欢去日本的人"}]
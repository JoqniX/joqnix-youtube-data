[{"type": "subtitle", "time": 17524.4, "timestamp": "04:52:04", "text": "汉字。嗨，卡桑。我们开始做吧。"}, {"type": "subtitle", "time": 17547.27, "timestamp": "04:52:27", "text": "10 山治 母亲 7 她说 山治"}, {"type": "subtitle", "time": 17550.59, "timestamp": "04:52:30", "text": "对，山治，所以儿子"}, {"type": "subtitle", "time": 17563.43, "timestamp": "04:52:43", "text": "好吧，我得学习写汉字了。"}, {"type": "subtitle", "time": 17573.07, "timestamp": "04:52:53", "text": "对，三个。"}, {"type": "subtitle", "time": 17576.23, "timestamp": "04:52:56", "text": "是的。我写的东西太糟糕了。"}]
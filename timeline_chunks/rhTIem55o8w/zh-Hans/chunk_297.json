[{"type": "subtitle", "time": 17820.47, "timestamp": "04:57:00", "text": "嗯，我们再写一遍。好的。"}, {"type": "subtitle", "time": 17823.67, "timestamp": "04:57:03", "text": "孙汉字你"}, {"type": "subtitle", "time": 17828.27, "timestamp": "04:57:08", "text": "呃呃一呃耶呃"}, {"type": "subtitle", "time": 17831.67, "timestamp": "04:57:11", "text": "等等，什么是太阳和汉字？日语"}, {"type": "subtitle", "time": 17834.628, "timestamp": "04:57:14", "text": "我又忘了，对，是的，太阳汉字"}, {"type": "subtitle", "time": 17836.19, "timestamp": "04:57:16", "text": "你"}, {"type": "subtitle", "time": 17847.83, "timestamp": "04:57:27", "text": "没错，就在这里，好的，是的。"}, {"type": "subtitle", "time": 17849.31, "timestamp": "04:57:29", "text": "这样可以吗？"}, {"type": "subtitle", "time": 17868.91, "timestamp": "04:57:48", "text": "再次。等等。洋二。哦，不是山治。"}, {"type": "subtitle", "time": 17874.868, "timestamp": "04:57:54", "text": "或者，他们在这里说的这个词是"}, {"type": "subtitle", "time": 17877.27, "timestamp": "04:57:57", "text": "特别的。"}]
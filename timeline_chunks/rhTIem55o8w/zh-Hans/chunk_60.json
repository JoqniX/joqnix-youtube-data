[{"type": "subtitle", "time": 3600.39, "timestamp": "01:00:00", "text": "频道内容来自剪辑等等"}, {"type": "subtitle", "time": 3603.43, "timestamp": "01:00:03", "text": "短裤到频道呃到是的"}, {"type": "subtitle", "time": 3605.349, "timestamp": "01:00:05", "text": "呃，来自 Twitch 和其他平台的片段。"}, {"type": "subtitle", "time": 3608.39, "timestamp": "01:00:08", "text": "我会把它转换成垂直端口"}, {"type": "subtitle", "time": 3611.71, "timestamp": "01:00:11", "text": "格式或其他什么，就像我希望的那样"}, {"type": "subtitle", "time": 3615.829, "timestamp": "01:00:15", "text": "比如至少今天上传。"}, {"type": "subtitle", "time": 3619.589, "timestamp": "01:00:19", "text": "一枪毙命，我这就去打一些老旧的小溪。"}, {"type": "subtitle", "time": 3621.91, "timestamp": "01:00:21", "text": "不管Twitch上有哪个片段，我都会做。"}, {"type": "subtitle", "time": 3624.589, "timestamp": "01:00:24", "text": "我只想把它从旧的变成新的。"}, {"type": "subtitle", "time": 3628.92, "timestamp": "01:00:28", "text": "上传所有你认识的人和"}, {"type": "subtitle", "time": 3631.63, "timestamp": "01:00:31", "text": "[音乐]"}, {"type": "subtitle", "time": 3638.51, "timestamp": "01:00:38", "text": "嗯，有"}, {"type": "subtitle", "time": 3642.71, "timestamp": "01:00:42", "text": "那。然后我希望……嗯……就是这样。"}, {"type": "subtitle", "time": 3658.75, "timestamp": "01:00:58", "text": "我希望做某事"}]
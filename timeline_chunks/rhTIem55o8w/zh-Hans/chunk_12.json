[{"type": "subtitle", "time": 721.23, "timestamp": "00:12:01", "text": "实践。我将撰写摘要"}, {"type": "subtitle", "time": 724.47, "timestamp": "00:12:04", "text": "昨天我们在推特上做了什么，然后"}, {"type": "subtitle", "time": 726.99, "timestamp": "00:12:06", "text": "关于这条推文"}, {"type": "subtitle", "time": 734.67, "timestamp": "00:12:14", "text": "正确的。嗯，问题是……"}, {"type": "subtitle", "time": 739.949, "timestamp": "00:12:19", "text": "嗯，就像我说的，我应该去……"}, {"type": "subtitle", "time": 741.55, "timestamp": "00:12:21", "text": "日本"}, {"type": "subtitle", "time": 744.31, "timestamp": "00:12:24", "text": "对，我还有很多东西需要。"}, {"type": "subtitle", "time": 747.91, "timestamp": "00:12:27", "text": "为那做好准备，就像在很多情况下一样"}, {"type": "subtitle", "time": 750.629, "timestamp": "00:12:30", "text": "比如行李之类的东西"}, {"type": "subtitle", "time": 752.47, "timestamp": "00:12:32", "text": "和喜欢"}, {"type": "subtitle", "time": 755.11, "timestamp": "00:12:35", "text": "嗯，和家人待在一起之类的"}, {"type": "subtitle", "time": 758.75, "timestamp": "00:12:38", "text": "我甚至什么都没做。"}, {"type": "subtitle", "time": 761.829, "timestamp": "00:12:41", "text": "那是因为我只专注于我的"}, {"type": "subtitle", "time": 764.87, "timestamp": "00:12:44", "text": "流。一直优先考虑这件事"}, {"type": "subtitle", "time": 767.67, "timestamp": "00:12:47", "text": "在努力平衡各方利益的同时，"}, {"type": "subtitle", "time": 770.19, "timestamp": "00:12:50", "text": "抽出时间陪伴家人，也为了"}, {"type": "subtitle", "time": 772.87, "timestamp": "00:12:52", "text": "我自己也想多花点时间陪陪他们。"}, {"type": "subtitle", "time": 775.389, "timestamp": "00:12:55", "text": "每次服用的时候，都会有一点点。"}]
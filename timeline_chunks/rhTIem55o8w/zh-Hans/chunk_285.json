[{"type": "subtitle", "time": 17103.628, "timestamp": "04:45:03", "text": "嗯，三个汉字。所以"}, {"type": "subtitle", "time": 17115.948, "timestamp": "04:45:15", "text": "莫约比亚斯我的一个是"}, {"type": "subtitle", "time": 17118.51, "timestamp": "04:45:18", "text": "姐姐"}, {"type": "subtitle", "time": 17131.43, "timestamp": "04:45:31", "text": "呃，星期二。等等，不对，是星期四。是的，"}, {"type": "subtitle", "time": 17134.31, "timestamp": "04:45:34", "text": "梦读音。周四。周四。我的天哪。我"}, {"type": "subtitle", "time": 17136.27, "timestamp": "04:45:36", "text": "仍然需要一个"}, {"type": "subtitle", "time": 17140.47, "timestamp": "04:45:40", "text": "实践。好的。呃，这个是土壤"}, {"type": "subtitle", "time": 17144.868, "timestamp": "04:45:44", "text": "汉字。星期六就到这里了。所以，意思是"}, {"type": "subtitle", "time": 17147.49, "timestamp": "04:45:47", "text": "周六。呃"}, {"type": "subtitle", "time": 17158.51, "timestamp": "04:45:58", "text": "嗯，星期六我们会"}]
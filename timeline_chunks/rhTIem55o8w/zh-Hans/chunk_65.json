[{"type": "subtitle", "time": 3909.95, "timestamp": "01:05:09", "text": "它。你看，即使过了……我还是觉得累。"}, {"type": "subtitle", "time": 3912.19, "timestamp": "01:05:12", "text": "睡眠。"}, {"type": "subtitle", "time": 3914.67, "timestamp": "01:05:14", "text": "嗯，这个"}, {"type": "subtitle", "time": 3917.25, "timestamp": "01:05:17", "text": "真糟糕。疲劳感是真实存在的。"}, {"type": "subtitle", "time": 3918.51, "timestamp": "01:05:18", "text": "[音乐]"}, {"type": "subtitle", "time": 3931.39, "timestamp": "01:05:31", "text": "我得去吃午饭了。"}, {"type": "chat", "time": 3932.259, "timestamp": "01:05:32", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "Go back to bed"}, {"type": "subtitle", "time": 3934.95, "timestamp": "01:05:34", "text": "大约过了15分钟。我知道这不会发生"}, {"type": "subtitle", "time": 3938.19, "timestamp": "01:05:38", "text": "它还没准备好。还没准备好。"}, {"type": "chat", "time": 3941.137, "timestamp": "01:05:41", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "AND YES. A REAL BED"}, {"type": "subtitle", "time": 3942.15, "timestamp": "01:05:42", "text": "但还是要下楼吃饭。回去"}, {"type": "chat", "time": 3947.047, "timestamp": "01:05:47", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "NOT SLEEPING IN A CHAIR"}, {"type": "subtitle", "time": 3957.349, "timestamp": "01:05:57", "text": "笨蛋，我从不在椅子上睡觉。"}]
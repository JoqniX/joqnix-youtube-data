[{"type": "subtitle", "time": 8581.349, "timestamp": "02:23:01", "text": "是的，你应该感谢我杀了你。"}, {"type": "subtitle", "time": 8584.03, "timestamp": "02:23:04", "text": "迅速地。当然。"}, {"type": "subtitle", "time": 8588.469, "timestamp": "02:23:08", "text": "不。是。我的天啊，Roco 晚上回来了"}, {"type": "subtitle", "time": 8594.309, "timestamp": "02:23:14", "text": "什么？等等，你上夜班？"}, {"type": "subtitle", "time": 8604.79, "timestamp": "02:23:24", "text": "什么？等等，你是在晚上直播吗？"}, {"type": "subtitle", "time": 8606.71, "timestamp": "02:23:26", "text": "等等，不，等等。你晚上直播吗？"}, {"type": "subtitle", "time": 8608.55, "timestamp": "02:23:28", "text": "不，不，不，你不需要。哦，是的。那"}, {"type": "subtitle", "time": 8609.95, "timestamp": "02:23:29", "text": "曾是"}, {"type": "subtitle", "time": 8614.07, "timestamp": "02:23:34", "text": "在我记忆之前。"}, {"type": "subtitle", "time": 8616.309, "timestamp": "02:23:36", "text": "我走了。"}, {"type": "subtitle", "time": 8623.83, "timestamp": "02:23:43", "text": "你说的“省略号”是什么意思？是吗？"}, {"type": "subtitle", "time": 8632.87, "timestamp": "02:23:52", "text": "它？皮肤包。"}]
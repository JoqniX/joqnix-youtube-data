[{"type": "subtitle", "time": 18001.86, "timestamp": "05:00:01", "text": "是的。好的。好的。得到"}, {"type": "subtitle", "time": 18008.868, "timestamp": "05:00:08", "text": "它。好的。截图想法。我忘了。"}, {"type": "subtitle", "time": 18013.07, "timestamp": "05:00:13", "text": "F 忘了。所以我截了多少张图？"}, {"type": "subtitle", "time": 18016.03, "timestamp": "05:00:16", "text": "再次？嗯，让我看看我的照片。"}, {"type": "subtitle", "time": 18017.948, "timestamp": "05:00:17", "text": "截图。"}, {"type": "subtitle", "time": 18022.868, "timestamp": "05:00:22", "text": "嗯，一、二，我拿了这个，然后我"}, {"type": "subtitle", "time": 18026.15, "timestamp": "05:00:26", "text": "拍了这张。我没拍这张。"}, {"type": "subtitle", "time": 18036.15, "timestamp": "05:00:36", "text": "一。第94页。好的。还有95"}, {"type": "subtitle", "time": 18042.708, "timestamp": "05:00:42", "text": "完成的。呃，让我来翻那一页。"}, {"type": "subtitle", "time": 18043.27, "timestamp": "05:00:43", "text": "数字"}, {"type": "subtitle", "time": 18045.39, "timestamp": "05:00:45", "text": "[音乐]"}, {"type": "subtitle", "time": 18048.91, "timestamp": "05:00:48", "text": "95 和页码"}, {"type": "subtitle", "time": 18052.948, "timestamp": "05:00:52", "text": "90. 哦耶，我们要去96号。伙计，我"}, {"type": "subtitle", "time": 18055.11, "timestamp": "05:00:55", "text": "要做的事情太多了。我必须真的"}, {"type": "subtitle", "time": 18057.31, "timestamp": "05:00:57", "text": "读完整本教科书"}, {"type": "subtitle", "time": 18059.628, "timestamp": "05:00:59", "text": "今天。"}]
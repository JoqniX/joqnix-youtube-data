[{"type": "subtitle", "time": 1941.509, "timestamp": "00:32:21", "text": "我认为我们应该开始强制执行一些事情。"}, {"type": "subtitle", "time": 1945.63, "timestamp": "00:32:25", "text": "因为我们有更严格的规定，"}, {"type": "subtitle", "time": 1949.509, "timestamp": "00:32:29", "text": "指导方针和一些人来了"}, {"type": "subtitle", "time": 1952.549, "timestamp": "00:32:32", "text": "这个和钓鱼以及点赞"}, {"type": "subtitle", "time": 1954.63, "timestamp": "00:32:34", "text": "呃，他们想说什么就说什么，就是这样。"}, {"type": "subtitle", "time": 1957.549, "timestamp": "00:32:37", "text": "不好，而且"}, {"type": "subtitle", "time": 1965.35, "timestamp": "00:32:45", "text": "应该吗？哦，我觉得我们应该喜欢"}, {"type": "subtitle", "time": 1968.269, "timestamp": "00:32:48", "text": "更严格地执行规则，并给予更多支持"}, {"type": "subtitle", "time": 1970.58, "timestamp": "00:32:50", "text": "处罚、暂停或禁赛"}, {"type": "subtitle", "time": 1973.07, "timestamp": "00:32:53", "text": "[音乐]"}, {"type": "subtitle", "time": 1978.34, "timestamp": "00:32:58", "text": "如果事情发展得太过分了怎么办？"}]
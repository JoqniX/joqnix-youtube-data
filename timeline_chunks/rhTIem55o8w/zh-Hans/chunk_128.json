[{"type": "subtitle", "time": 7682.51, "timestamp": "02:08:02", "text": "为什么？就连瓦洛尔和托尼也不例外。"}, {"type": "subtitle", "time": 7686.43, "timestamp": "02:08:06", "text": "允许 Roax。你在开玩笑吧？"}, {"type": "subtitle", "time": 7701.03, "timestamp": "02:08:21", "text": "N Axel 正在直播。为什么？我无法活下去"}, {"type": "subtitle", "time": 7702.35, "timestamp": "02:08:22", "text": "没有"}, {"type": "subtitle", "time": 7706.069, "timestamp": "02:08:26", "text": "它。我怎么才能玩到60级？等等，我怎么了？"}, {"type": "subtitle", "time": 7709.35, "timestamp": "02:08:29", "text": "我玩多少局？我目前使用的是哪种DPI？"}, {"type": "subtitle", "time": 7715.589, "timestamp": "02:08:35", "text": "忘了。卡比兽。不。呃，罗克塞尔。那"}, {"type": "subtitle", "time": 7718.55, "timestamp": "02:08:38", "text": "一。爱它。我看到了我正在玩的游戏"}, {"type": "subtitle", "time": 7721.589, "timestamp": "02:08:41", "text": "仍然是 11,000 DPI。你们忘了吗？"}, {"type": "subtitle", "time": 7724.95, "timestamp": "02:08:44", "text": "那？呃，就像现在这个直播一样，"}, {"type": "subtitle", "time": 7727.669, "timestamp": "02:08:47", "text": "我改成11000了，因为这是我最喜欢的数字。"}, {"type": "subtitle", "time": 7728.99, "timestamp": "02:08:48", "text": "数字是"}, {"type": "subtitle", "time": 7739.31, "timestamp": "02:08:59", "text": "11."}]
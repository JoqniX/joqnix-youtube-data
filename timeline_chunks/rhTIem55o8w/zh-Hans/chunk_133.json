[{"type": "subtitle", "time": 7986.069, "timestamp": "02:13:06", "text": "没关系。拿着吧。拿着吧。拿着吧。"}, {"type": "subtitle", "time": 7994.069, "timestamp": "02:13:14", "text": "这场雨怎么会害死所有人？最后的"}, {"type": "subtitle", "time": 7997.27, "timestamp": "02:13:17", "text": "球员站立。还剩一个敌人。"}, {"type": "subtitle", "time": 8027.99, "timestamp": "02:13:47", "text": "好的。如何永久禁用文本"}, {"type": "subtitle", "time": 8030.149, "timestamp": "02:13:50", "text": "聊天？他们应该具备那个功能。"}, {"type": "subtitle", "time": 8039.43, "timestamp": "02:13:59", "text": "去！去！去。"}]
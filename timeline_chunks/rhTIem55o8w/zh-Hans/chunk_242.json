[{"type": "subtitle", "time": 14524.469, "timestamp": "04:02:04", "text": "哈瓦，我真的非常非常抱歉，BB拖了这么久。"}, {"type": "subtitle", "time": 14528.389, "timestamp": "04:02:08", "text": "我的意思是BB正在加载。我的天啊，"}, {"type": "subtitle", "time": 14529.309, "timestamp": "04:02:09", "text": "我只是"}, {"type": "subtitle", "time": 14538.269, "timestamp": "04:02:18", "text": "我突然意识到我忘了"}, {"type": "subtitle", "time": 14541.67, "timestamp": "04:02:21", "text": "打开。不，我忘了带水。"}, {"type": "subtitle", "time": 14544.11, "timestamp": "04:02:24", "text": "瓶子。于是，我跑了"}, {"type": "subtitle", "time": 14553.87, "timestamp": "04:02:33", "text": "后退。让"}, {"type": "subtitle", "time": 14560.309, "timestamp": "04:02:40", "text": "[音乐]"}, {"type": "subtitle", "time": 14563.349, "timestamp": "04:02:43", "text": "好的，所以对于正在收看的各位来说，"}]
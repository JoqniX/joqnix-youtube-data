[{"type": "subtitle", "time": 17220.628, "timestamp": "04:47:00", "text": "这是我费力才读懂的内容。"}, {"type": "subtitle", "time": 17222.43, "timestamp": "04:47:02", "text": "今天在课堂上"}, {"type": "subtitle", "time": 17225.11, "timestamp": "04:47:05", "text": "早晨。但老师拿走了一切"}, {"type": "subtitle", "time": 17228.07, "timestamp": "04:47:08", "text": "再次。所以我很高兴所有的汉字和"}, {"type": "subtitle", "time": 17231.19, "timestamp": "04:47:11", "text": "一切。我现在明白了。所以"}, {"type": "subtitle", "time": 17234.27, "timestamp": "04:47:14", "text": "这意味着"}, {"type": "subtitle", "time": 17238.39, "timestamp": "04:47:18", "text": "嗯，对对对，我忘了为什么了。"}, {"type": "subtitle", "time": 17240.868, "timestamp": "04:47:20", "text": "我是在解释吗？但我也想让你们知道。"}, {"type": "subtitle", "time": 17243.51, "timestamp": "04:47:23", "text": "要读懂也很重要，这是其中之一。"}, {"type": "subtitle", "time": 17246.99, "timestamp": "04:47:26", "text": "我正在读的东西"}, {"type": "subtitle", "time": 17249.15, "timestamp": "04:47:29", "text": "嗨"}, {"type": "subtitle", "time": 17252.47, "timestamp": "04:47:32", "text": "总之，这意味着……嗯，我就直说了吧……"}, {"type": "subtitle", "time": 17262.708, "timestamp": "04:47:42", "text": "这意味着我从星期一开始上班"}, {"type": "subtitle", "time": 17264.55, "timestamp": "04:47:44", "text": "星期五"}, {"type": "subtitle", "time": 17268.628, "timestamp": "04:47:48", "text": "呃，在公司工作，公司呃"}, {"type": "subtitle", "time": 17269.948, "timestamp": "04:47:49", "text": "开始"}, {"type": "subtitle", "time": 17273.628, "timestamp": "04:47:53", "text": "公司 u nan"}, {"type": "subtitle", "time": 17277.19, "timestamp": "04:47:57", "text": "呃，你还活着吗？我还活着。"}]
[{"type": "subtitle", "time": 7081.75, "timestamp": "01:58:01", "text": "还有一些其他的东西。我们将独自一人开枪射击。"}, {"type": "subtitle", "time": 7085.03, "timestamp": "01:58:05", "text": "努力提升等级，获得等级，然后完成我们的任务"}, {"type": "subtitle", "time": 7088.39, "timestamp": "01:58:08", "text": "最好的。就这么简单。"}, {"type": "subtitle", "time": 7113.79, "timestamp": "01:58:33", "text": "是的。"}, {"type": "subtitle", "time": 7116.79, "timestamp": "01:58:36", "text": "Goen，你好吗？我很好。"}, {"type": "subtitle", "time": 7121.229, "timestamp": "01:58:41", "text": "今天我过得有点不顺心，"}, {"type": "subtitle", "time": 7124.43, "timestamp": "01:58:44", "text": "猜测。是的。"}, {"type": "subtitle", "time": 7129.27, "timestamp": "01:58:49", "text": "嗯，是啊，我今天过得有点不顺心。"}, {"type": "subtitle", "time": 7131.27, "timestamp": "01:58:51", "text": "就在我早上醒来的时候。所以，"}, {"type": "subtitle", "time": 7134.35, "timestamp": "01:58:54", "text": "这是一回事，但也是另一回事。"}, {"type": "subtitle", "time": 7138.709, "timestamp": "01:58:58", "text": "好的。希望誓言的磨练能帮到我。"}]
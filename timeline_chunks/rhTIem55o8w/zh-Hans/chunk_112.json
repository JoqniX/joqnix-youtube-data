[{"type": "subtitle", "time": 6722.149, "timestamp": "01:52:02", "text": "我点击？等等，等等，等等。我会我会"}, {"type": "subtitle", "time": 6732.229, "timestamp": "01:52:12", "text": "请不要结束。请不要结束。"}, {"type": "subtitle", "time": 6735.189, "timestamp": "01:52:15", "text": "请不要结束。我不想要你"}, {"type": "subtitle", "time": 6741.229, "timestamp": "01:52:21", "text": "[音乐]"}, {"type": "subtitle", "time": 6745.109, "timestamp": "01:52:25", "text": "结尾。啊，我不该全部都用标签页的。"}, {"type": "subtitle", "time": 6747.47, "timestamp": "01:52:27", "text": "不，是"}, {"type": "subtitle", "time": 6751.669, "timestamp": "01:52:31", "text": "是的，请。好的。好的。好的。好的。"}, {"type": "subtitle", "time": 6754.229, "timestamp": "01:52:34", "text": "好的。好的。好的。好的。好的。表演秀"}, {"type": "subtitle", "time": 6759.189, "timestamp": "01:52:39", "text": "向上。到场。到场。到场。快点。"}, {"type": "subtitle", "time": 6761.75, "timestamp": "01:52:41", "text": "你一定可以的。"}, {"type": "subtitle", "time": 6765.43, "timestamp": "01:52:45", "text": "为什么它开着？在哪里？年底"}, {"type": "subtitle", "time": 6767.79, "timestamp": "01:52:47", "text": "经过。什么？什么是"}, {"type": "subtitle", "time": 6773.55, "timestamp": "01:52:53", "text": "这？我进度落后了吗？不。对。好的。"}]
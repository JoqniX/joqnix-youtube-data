[{"type": "subtitle", "time": 7810.91, "timestamp": "02:10:10", "text": "019. 该死。"}, {"type": "subtitle", "time": 7813.35, "timestamp": "02:10:13", "text": "是的。想象一下，你因为以下原因而失去控制："}, {"type": "subtitle", "time": 7815.03, "timestamp": "02:10:15", "text": "因为奴隶，就把他们扔掉吧。"}, {"type": "subtitle", "time": 7817.75, "timestamp": "02:10:17", "text": "离开。等等，我应该试试吗？我想要"}, {"type": "subtitle", "time": 7820.709, "timestamp": "02:10:20", "text": "看看感觉如何。等等。给我"}, {"type": "subtitle", "time": 7847.03, "timestamp": "02:10:47", "text": "袖子。好的，我要……我想……"}, {"type": "subtitle", "time": 7849.35, "timestamp": "02:10:49", "text": "扔掉它。好吧，我想感受一下。有"}, {"type": "subtitle", "time": 7856.99, "timestamp": "02:10:56", "text": "它。我不会扔掉它。我想感受一下"}]
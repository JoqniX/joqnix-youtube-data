[{"type": "subtitle", "time": 2460.15, "timestamp": "00:41:00", "text": "这也是我从不……的原因"}, {"type": "subtitle", "time": 2461.63, "timestamp": "00:41:01", "text": "做过"}, {"type": "subtitle", "time": 2464.309, "timestamp": "00:41:04", "text": "还有佣金。我其实想这么做"}, {"type": "subtitle", "time": 2467.19, "timestamp": "00:41:07", "text": "训练这项技能，并提高我的技能"}, {"type": "subtitle", "time": 2470.23, "timestamp": "00:41:10", "text": "至少要体面，这样我才能……"}, {"type": "subtitle", "time": 2473.55, "timestamp": "00:41:13", "text": "至少向客户提供产品或"}, {"type": "subtitle", "time": 2476.95, "timestamp": "00:41:16", "text": "让顾客满意"}, {"type": "subtitle", "time": 2480.23, "timestamp": "00:41:20", "text": "而不是敷衍了事或"}, {"type": "subtitle", "time": 2483.03, "timestamp": "00:41:23", "text": "做工非常粗糙，而且还在赠送"}, {"type": "subtitle", "time": 2484.91, "timestamp": "00:41:24", "text": "它"}, {"type": "subtitle", "time": 2487.23, "timestamp": "00:41:27", "text": "出去。正确的。"}, {"type": "subtitle", "time": 2489.55, "timestamp": "00:41:29", "text": "是的，我们不想"}, {"type": "subtitle", "time": 2494.39, "timestamp": "00:41:34", "text": "那。而且，我不想做容易的事。"}, {"type": "subtitle", "time": 2497.43, "timestamp": "00:41:37", "text": "使用人工智能音乐等各种技术的方法。"}, {"type": "subtitle", "time": 2499.87, "timestamp": "00:41:39", "text": "不，那样太过了。"}, {"type": "subtitle", "time": 2502.349, "timestamp": "00:41:42", "text": "哑的。"}, {"type": "subtitle", "time": 2506.23, "timestamp": "00:41:46", "text": "是的。所以，这就是我当时的想法，是啊。"}, {"type": "subtitle", "time": 2508.309, "timestamp": "00:41:48", "text": "这些就像我之前已经拥有的一样。"}, {"type": "subtitle", "time": 2511.51, "timestamp": "00:41:51", "text": "虽然已经计划好了，就像我之前想的那样。"}, {"type": "subtitle", "time": 2513.27, "timestamp": "00:41:53", "text": "为……做出贡献"}, {"type": "subtitle", "time": 2517.829, "timestamp": "00:41:57", "text": "社区，对吧？以某种方式。我"}]
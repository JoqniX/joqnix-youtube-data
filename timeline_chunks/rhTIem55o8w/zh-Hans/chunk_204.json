[{"type": "subtitle", "time": 12244.95, "timestamp": "03:24:04", "text": "所有的一切，包括时区等等。"}, {"type": "subtitle", "time": 12246.67, "timestamp": "03:24:06", "text": "我是"}, {"type": "subtitle", "time": 12250.07, "timestamp": "03:24:10", "text": "我不想表现得很疲惫。所以"}, {"type": "subtitle", "time": 12253.03, "timestamp": "03:24:13", "text": "疲劳的。累死了的骑师。好的。当我"}, {"type": "subtitle", "time": 12254.03, "timestamp": "03:24:14", "text": "曾是"}, {"type": "subtitle", "time": 12258.87, "timestamp": "03:24:18", "text": "流媒体。嗯，是的，那就像……"}, {"type": "subtitle", "time": 12260.83, "timestamp": "03:24:20", "text": "我上次直播？昨天，"}, {"type": "subtitle", "time": 12263.59, "timestamp": "03:24:23", "text": "正确的？昨天我听起来很疲惫。"}, {"type": "subtitle", "time": 12267.309, "timestamp": "03:24:27", "text": "正确的。妮基，呃，无限妮基"}, {"type": "subtitle", "time": 12271.71, "timestamp": "03:24:31", "text": "溪流。是啊，我当时听起来……"}, {"type": "subtitle", "time": 12278.63, "timestamp": "03:24:38", "text": "那我昨天做了什么？是的，我"}, {"type": "subtitle", "time": 12279.79, "timestamp": "03:24:39", "text": "去"}, {"type": "subtitle", "time": 12282.83, "timestamp": "03:24:42", "text": "散步，或者去慢跑，"}, {"type": "subtitle", "time": 12286.67, "timestamp": "03:24:46", "text": "然后做了一个"}, {"type": "subtitle", "time": 12287.7, "timestamp": "03:24:47", "text": "预约，"}, {"type": "subtitle", "time": 12288.91, "timestamp": "03:24:48", "text": "[音乐]"}, {"type": "subtitle", "time": 12291.91, "timestamp": "03:24:51", "text": "然后不得不去别的地方，之后又回来了。"}, {"type": "subtitle", "time": 12294.07, "timestamp": "03:24:54", "text": "匆匆赶回家只是为了开始"}, {"type": "subtitle", "time": 12297.03, "timestamp": "03:24:57", "text": "直播，因为现在是下午2点。已经。现在"}]
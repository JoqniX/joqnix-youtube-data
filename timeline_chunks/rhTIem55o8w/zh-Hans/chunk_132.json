[{"type": "subtitle", "time": 7920.47, "timestamp": "02:12:00", "text": "好的，我可以这样扔。我走了"}, {"type": "subtitle", "time": 7922.629, "timestamp": "02:12:02", "text": "这里。"}, {"type": "subtitle", "time": 7938.31, "timestamp": "02:12:18", "text": "按键很困难。为什么会这样？"}, {"type": "subtitle", "time": 7950.43, "timestamp": "02:12:30", "text": "为什么很难按下"}, {"type": "subtitle", "time": 7953.229, "timestamp": "02:12:33", "text": "钥匙？他有点像"}, {"type": "subtitle", "time": 7955.229, "timestamp": "02:12:35", "text": "强的。我"}, {"type": "subtitle", "time": 7962.87, "timestamp": "02:12:42", "text": "[音乐]"}, {"type": "subtitle", "time": 7973.27, "timestamp": "02:12:53", "text": "重新装弹。"}, {"type": "subtitle", "time": 7975.189, "timestamp": "02:12:55", "text": "你这小鬼。"}, {"type": "subtitle", "time": 7977.43, "timestamp": "02:12:57", "text": "好吧，我……我……我的手套丢了。"}]
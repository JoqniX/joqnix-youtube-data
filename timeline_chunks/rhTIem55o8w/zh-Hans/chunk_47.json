[{"type": "subtitle", "time": 2827.349, "timestamp": "00:47:07", "text": "不要想得太远。我之前就这么想过"}, {"type": "subtitle", "time": 2829.47, "timestamp": "00:47:09", "text": "远远领先于"}, {"type": "subtitle", "time": 2831.55, "timestamp": "00:47:11", "text": "它。"}, {"type": "chat", "time": 2831.996, "timestamp": "00:47:11", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "tch tch, why u saying sry haiyaa"}, {"type": "subtitle", "time": 2835.91, "timestamp": "00:47:15", "text": "你看，当我在日本的时候，一旦我完成了我的"}, {"type": "subtitle", "time": 2838.95, "timestamp": "00:47:18", "text": "两年制课程、一年制课程、二十一年制课程"}, {"type": "subtitle", "time": 2840.829, "timestamp": "00:47:20", "text": "正确的？一旦我"}, {"type": "subtitle", "time": 2846.75, "timestamp": "00:47:26", "text": "自由的。一旦我获得自由，"}, {"type": "subtitle", "time": 2849.51, "timestamp": "00:47:29", "text": "自由的。我打算做类似的事情"}, {"type": "subtitle", "time": 2851.15, "timestamp": "00:47:31", "text": "从"}, {"type": "subtitle", "time": 2854.15, "timestamp": "00:47:34", "text": "因为我想捐款给慈善机构。"}, {"type": "chat", "time": 2855.314, "timestamp": "00:47:35", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "just like u thought far ahead, in weeks, to fix yr sleeping?"}, {"type": "subtitle", "time": 2857.349, "timestamp": "00:47:37", "text": "以及所有的一切。好的。我"}, {"type": "subtitle", "time": 2860.309, "timestamp": "00:47:40", "text": "我知道我太自私了，做不到这一点。"}, {"type": "subtitle", "time": 2864.23, "timestamp": "00:47:44", "text": "为我自己的模型之类的东西举办运动马拉松，但是"}, {"type": "subtitle", "time": 2868.069, "timestamp": "00:47:48", "text": "我希望能够像最初的梦想那样去做。"}, {"type": "subtitle", "time": 2871.43, "timestamp": "00:47:51", "text": "我的目标是如果我是的话，就实际进行。"}, {"type": "subtitle", "time": 2873.51, "timestamp": "00:47:53", "text": "曾经参加过马拉松比赛吗？我真的很想"}, {"type": "subtitle", "time": 2877.19, "timestamp": "00:47:57", "text": "他是第一个为了慈善事业而做这件事的人，但是"}, {"type": "subtitle", "time": 2879.19, "timestamp": "00:47:59", "text": "呃，事情并没有按照我想的方向发展。"}]
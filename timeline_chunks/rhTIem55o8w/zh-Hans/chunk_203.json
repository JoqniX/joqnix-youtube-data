[{"type": "subtitle", "time": 12181.03, "timestamp": "03:23:01", "text": "我今年的圣诞树……呃，就是那个东西。下一个"}, {"type": "subtitle", "time": 12183.11, "timestamp": "03:23:03", "text": "今年我们会做更多的事情。"}, {"type": "subtitle", "time": 12186.03, "timestamp": "03:23:06", "text": "更好更棒。所以不用担心"}, {"type": "subtitle", "time": 12188.269, "timestamp": "03:23:08", "text": "那。所以"}, {"type": "subtitle", "time": 12190.71, "timestamp": "03:23:10", "text": "嗯，是的。"}, {"type": "subtitle", "time": 12191.49, "timestamp": "03:23:11", "text": "和"}, {"type": "subtitle", "time": 12194.67, "timestamp": "03:23:14", "text": "[音乐]"}, {"type": "subtitle", "time": 12198.75, "timestamp": "03:23:18", "text": "嗯，还有，呃，我该怎么办？"}, {"type": "subtitle", "time": 12203.309, "timestamp": "03:23:23", "text": "说？我想举办很多活动，"}, {"type": "subtitle", "time": 12206.25, "timestamp": "03:23:26", "text": "但时机是"}, {"type": "subtitle", "time": 12207.469, "timestamp": "03:23:27", "text": "[音乐]"}, {"type": "subtitle", "time": 12212.95, "timestamp": "03:23:32", "text": "疼痛。所以时机很棘手。我正在获得"}, {"type": "subtitle", "time": 12213.74, "timestamp": "03:23:33", "text": "所以"}, {"type": "subtitle", "time": 12214.91, "timestamp": "03:23:34", "text": "[音乐]"}, {"type": "subtitle", "time": 12217.75, "timestamp": "03:23:37", "text": "越来越忙，我讨厌自己没时间消磨时间。"}, {"type": "subtitle", "time": 12220.95, "timestamp": "03:23:40", "text": "很多时间。我知道将来会是这样。"}, {"type": "subtitle", "time": 12223.67, "timestamp": "03:23:43", "text": "情况甚至会比现在糟糕得多。"}, {"type": "subtitle", "time": 12227.55, "timestamp": "03:23:47", "text": "这就像"}, {"type": "subtitle", "time": 12231.51, "timestamp": "03:23:51", "text": "嗯，就像从早到晚，呃，晚上"}, {"type": "subtitle", "time": 12235.51, "timestamp": "03:23:55", "text": "因为是兼职，我会很忙。"}, {"type": "subtitle", "time": 12239.71, "timestamp": "03:23:59", "text": "呃，就是大学里那些东西。"}]
[{"type": "subtitle", "time": 364.15, "timestamp": "00:06:04", "text": "溪流。是啊，你看，问题是……"}, {"type": "subtitle", "time": 366.59, "timestamp": "00:06:06", "text": "溪流的第二部分，夜晚"}, {"type": "subtitle", "time": 369.07, "timestamp": "00:06:09", "text": "直播，第二部分"}, {"type": "subtitle", "time": 372.79, "timestamp": "00:06:12", "text": "直播，我尽力去做……呃……呃……"}, {"type": "subtitle", "time": 375.27, "timestamp": "00:06:15", "text": "就像关注它，就像做它一样"}, {"type": "subtitle", "time": 378.07, "timestamp": "00:06:18", "text": "我早睡的原因是为了修复"}, {"type": "subtitle", "time": 381.35, "timestamp": "00:06:21", "text": "调整我的日程安排，这样我才能更有活力。"}, {"type": "subtitle", "time": 383.749, "timestamp": "00:06:23", "text": "在清晨的溪流中，就是这个"}, {"type": "subtitle", "time": 385.909, "timestamp": "00:06:25", "text": "流，新流的第一部分"}, {"type": "subtitle", "time": 388.749, "timestamp": "00:06:28", "text": "天。"}, {"type": "subtitle", "time": 391.35, "timestamp": "00:06:31", "text": "我不知道。我觉得那是"}, {"type": "subtitle", "time": 393.30899999999997, "timestamp": "00:06:33", "text": "随机的人或"}, {"type": "subtitle", "time": 396.15, "timestamp": "00:06:36", "text": "某物。也许是个小孩之类的。我"}, {"type": "subtitle", "time": 397.95, "timestamp": "00:06:37", "text": "不"}, {"type": "subtitle", "time": 400.87, "timestamp": "00:06:40", "text": "知道。哦，你他妈的怎么还在睡觉？"}, {"type": "subtitle", "time": 403.029, "timestamp": "00:06:43", "text": "还有别的什么？他们说，就像，"}, {"type": "subtitle", "time": 405.71, "timestamp": "00:06:45", "text": "“真丢人。”我是"}, {"type": "subtitle", "time": 408.189, "timestamp": "00:06:48", "text": "喜欢，"}, {"type": "subtitle", "time": 411.79, "timestamp": "00:06:51", "text": "兄弟，你来替我想想。直播"}, {"type": "subtitle", "time": 415.11, "timestamp": "00:06:55", "text": "24小时不间断，持续了三个人大约四个月"}, {"type": "subtitle", "time": 418.55, "timestamp": "00:06:58", "text": "直的。到那时你就会明白为什么我"}]
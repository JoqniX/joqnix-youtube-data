[{"type": "subtitle", "time": 14221.83, "timestamp": "03:57:01", "text": "说实话，我本来想做个卡拉OK之类的。"}, {"type": "subtitle", "time": 14226.71, "timestamp": "03:57:06", "text": "今天直播，但是因为……"}, {"type": "subtitle", "time": 14229.99, "timestamp": "03:57:09", "text": "今天发生了一些意想不到的事情，比如"}, {"type": "subtitle", "time": 14234.07, "timestamp": "03:57:14", "text": "呃，房间里的人，人们是"}, {"type": "subtitle", "time": 14236.87, "timestamp": "03:57:16", "text": "比如工人，还有我，以及所有的一切。"}, {"type": "subtitle", "time": 14239.91, "timestamp": "03:57:19", "text": "越来越忙了。呃，我以为会是"}, {"type": "subtitle", "time": 14243.07, "timestamp": "03:57:23", "text": "最好还是做个短的井"}, {"type": "subtitle", "time": 14245.83, "timestamp": "03:57:25", "text": "直播的话，下次吧。好的，"}, {"type": "subtitle", "time": 14248.07, "timestamp": "03:57:28", "text": "如果可能的话，明天我们会做一次koka"}, {"type": "subtitle", "time": 14251.11, "timestamp": "03:57:31", "text": "直播，我会把链接发给你。"}, {"type": "subtitle", "time": 14255.11, "timestamp": "03:57:35", "text": "我在推特上发的三个颜色，还有"}, {"type": "subtitle", "time": 14258.469, "timestamp": "03:57:38", "text": "在 YouTube 社区帖子中。所以请跟随"}, {"type": "subtitle", "time": 14261.51, "timestamp": "03:57:41", "text": "呃，请务必查一下。请把它贡献出来。"}, {"type": "subtitle", "time": 14264.63, "timestamp": "03:57:44", "text": "如果可以的话。我们将对此进行审查。"}, {"type": "subtitle", "time": 14266.309, "timestamp": "03:57:46", "text": "26日"}, {"type": "subtitle", "time": 14269.67, "timestamp": "03:57:49", "text": "等等，不是26号、27号或28号，而是星期五。"}, {"type": "subtitle", "time": 14272.55, "timestamp": "03:57:52", "text": "周六。所以如果可以的话，请务必到场。好的。"}, {"type": "subtitle", "time": 14274.79, "timestamp": "03:57:54", "text": "圣诞节直播将会是……"}, {"type": "subtitle", "time": 14278.75, "timestamp": "03:57:58", "text": "22日或23日星期日。"}]
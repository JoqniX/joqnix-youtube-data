[{"type": "subtitle", "time": 2221.47, "timestamp": "00:37:01", "text": "嗯，他们在哪里学习，"}, {"type": "subtitle", "time": 2224.31, "timestamp": "00:37:04", "text": "你知道，当我看着它的时候，它是……"}, {"type": "subtitle", "time": 2225.87, "timestamp": "00:37:05", "text": "喜欢"}, {"type": "subtitle", "time": 2228.55, "timestamp": "00:37:08", "text": "嗯，不，我会玩这个游戏10个小时。"}, {"type": "subtitle", "time": 2230.75, "timestamp": "00:37:10", "text": "直的。我"}, {"type": "subtitle", "time": 2233.71, "timestamp": "00:37:13", "text": "我知道事情是这样的……"}, {"type": "subtitle", "time": 2237.109, "timestamp": "00:37:17", "text": "最初就像很久以前一样，我"}, {"type": "subtitle", "time": 2240.95, "timestamp": "00:37:20", "text": "我想做的是类似低保真风格的东西"}, {"type": "subtitle", "time": 2245.109, "timestamp": "00:37:25", "text": "就像24小时不间断的低保真流媒体一样"}, {"type": "subtitle", "time": 2248.15, "timestamp": "00:37:28", "text": "就像你知道的，某个频道之类的东西"}, {"type": "subtitle", "time": 2251.109, "timestamp": "00:37:31", "text": "我开始做这件事了，现在我想做这件事"}, {"type": "subtitle", "time": 2253.67, "timestamp": "00:37:33", "text": "我当时已经准备好购买一台服务器了。"}, {"type": "subtitle", "time": 2256.31, "timestamp": "00:37:36", "text": "就像真的把我的 OBS 设置放进去一样"}, {"type": "subtitle", "time": 2259.75, "timestamp": "00:37:39", "text": "所有事情都要这样做，就像24小时一样。"}, {"type": "subtitle", "time": 2263.069, "timestamp": "00:37:43", "text": "就像……就像低保真音乐"}, {"type": "chat", "time": 2268.184, "timestamp": "00:37:48", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "u want a music project, ez, make a lofi that u can put on brb screens"}, {"type": "subtitle", "time": 2269.19, "timestamp": "00:37:49", "text": "某物。我最初想制作我的"}, {"type": "subtitle", "time": 2271.99, "timestamp": "00:37:51", "text": "自己做一张低保真专辑之类的，然后就去做吧。"}, {"type": "subtitle", "time": 2275.589, "timestamp": "00:37:55", "text": "诸如此类，或者像普通的低保真音乐一样。"}]
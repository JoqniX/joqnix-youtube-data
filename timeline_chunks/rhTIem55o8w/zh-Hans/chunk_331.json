[{"type": "subtitle", "time": 19862.27, "timestamp": "05:31:02", "text": "前？嘿，"}, {"type": "subtitle", "time": 19864.948, "timestamp": "05:31:04", "text": "等待。他们会说什么？会是什么呢？"}, {"type": "subtitle", "time": 19868.39, "timestamp": "05:31:08", "text": "这是一个。这是一个。这是一个。这是一个。这是一个。"}, {"type": "subtitle", "time": 19870.39, "timestamp": "05:31:10", "text": "Onomi 的意思是中文阅读。以便"}, {"type": "subtitle", "time": 19873.868, "timestamp": "05:31:13", "text": "可以通过给予来获得音读。"}, {"type": "subtitle", "time": 19876.868, "timestamp": "05:31:16", "text": "我的笔记本上没有。"}, {"type": "subtitle", "time": 19878.83, "timestamp": "05:31:18", "text": "是的，就在这里。就它的"}, {"type": "subtitle", "time": 19882.07, "timestamp": "05:31:22", "text": "就像为了形成这个汉字一样"}, {"type": "subtitle", "time": 19885.99, "timestamp": "05:31:25", "text": "使用两个汉字直接放在一起，所以"}, {"type": "subtitle", "time": 19889.67, "timestamp": "05:31:29", "text": "差不多就是这样，嗯，是的。"}, {"type": "subtitle", "time": 19911.91, "timestamp": "05:31:51", "text": "再次。它很大吗？呃，它不算太大。"}, {"type": "subtitle", "time": 19914.948, "timestamp": "05:31:54", "text": "哦，我记得这件事。这是从那里来的"}, {"type": "subtitle", "time": 19917.628, "timestamp": "05:31:57", "text": "呃，章节。"}]
[{"type": "subtitle", "time": 4020.87, "timestamp": "01:07:00", "text": "喷子。即使那个人没有"}, {"type": "subtitle", "time": 4022.87, "timestamp": "01:07:02", "text": "我知道我做这件事已经有一段时间了。"}, {"type": "subtitle", "time": 4027.19, "timestamp": "01:07:07", "text": "过去一两个月我一直在直播"}, {"type": "subtitle", "time": 4034.789, "timestamp": "01:07:14", "text": "几个小时之内，人们可以随便说什么。不，是"}, {"type": "subtitle", "time": 4038.47, "timestamp": "01:07:18", "text": "糟糕的互联网。"}, {"type": "subtitle", "time": 4042.15, "timestamp": "01:07:22", "text": "就像我在考虑采用一些方法一样。"}, {"type": "chat", "time": 4042.384, "timestamp": "01:07:22", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "I. DON’T. CARE"}, {"type": "subtitle", "time": 4045.19, "timestamp": "01:07:25", "text": "阻止人们只是说"}, {"type": "subtitle", "time": 4047.67, "timestamp": "01:07:27", "text": "他们想要和喜欢的东西实际上会强制执行"}, {"type": "subtitle", "time": 4049.309, "timestamp": "01:07:29", "text": "规则更多。"}, {"type": "chat", "time": 4051.476, "timestamp": "01:07:31", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "YOU NEED SLEEP? YOU GO SLEEP"}, {"type": "subtitle", "time": 4052.63, "timestamp": "01:07:32", "text": "而且，你知道现在这些人喜欢"}, {"type": "subtitle", "time": 4054.23, "timestamp": "01:07:34", "text": "Twitch 或 YouTube 都是一样的。"}, {"type": "subtitle", "time": 4057.67, "timestamp": "01:07:37", "text": "就像有新人加入一样，他们会订阅。"}, {"type": "subtitle", "time": 4060.47, "timestamp": "01:07:40", "text": "他们必须订阅或关注才能输入"}, {"type": "chat", "time": 4060.684, "timestamp": "01:07:40", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "YOU SLEEP WHEN YOU WANT."}, {"type": "subtitle", "time": 4063.99, "timestamp": "01:07:43", "text": "聊天中他们却不看规则。"}, {"type": "subtitle", "time": 4073.47, "timestamp": "01:07:53", "text": "关于这一点，那就是一个。"}, {"type": "subtitle", "time": 4076.23, "timestamp": "01:07:56", "text": "我当时在想，我应该打10分吗？"}, {"type": "chat", "time": 4076.241, "timestamp": "01:07:56", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "why not put that thing"}, {"type": "subtitle", "time": 4078.63, "timestamp": "01:07:58", "text": "分钟或 5 分钟计数器"}]
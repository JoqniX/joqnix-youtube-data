[{"type": "subtitle", "time": 14942.07, "timestamp": "04:09:02", "text": "休息。你好。那么，在我们开始之前，我将"}, {"type": "subtitle", "time": 14944.07, "timestamp": "04:09:04", "text": "谈谈作弊小抄。不作弊"}, {"type": "subtitle", "time": 14945.99, "timestamp": "04:09:05", "text": "表格更像是一种易于理解的方式"}, {"type": "subtitle", "time": 14949.71, "timestamp": "04:09:09", "text": "音频是如何插入到这里的？"}, {"type": "subtitle", "time": 14952.269, "timestamp": "04:09:12", "text": "网站。所以你可以"}, {"type": "subtitle", "time": 14954.95, "timestamp": "04:09:14", "text": "我不知道你能不能看到……"}, {"type": "subtitle", "time": 14958.95, "timestamp": "04:09:18", "text": "正确的。所以这里是前三位数字"}, {"type": "subtitle", "time": 14961.99, "timestamp": "04:09:21", "text": "首先，这边的三个数字是"}, {"type": "subtitle", "time": 14964.389, "timestamp": "04:09:24", "text": "上传到此的音频编号"}, {"type": "subtitle", "time": 14967.75, "timestamp": "04:09:27", "text": "网站。所以第一课是001"}, {"type": "subtitle", "time": 14969.71, "timestamp": "04:09:29", "text": "最后一课将会是……"}, {"type": "subtitle", "time": 14973.75, "timestamp": "04:09:33", "text": "大概297左右吧？你好。所以记住这一点。"}, {"type": "subtitle", "time": 14977.11, "timestamp": "04:09:37", "text": "如果你感到困惑，Mo 骑师"}, {"type": "subtitle", "time": 14978.79, "timestamp": "04:09:38", "text": "有很多音频文件我都不知道。"}, {"type": "subtitle", "time": 14982.15, "timestamp": "04:09:42", "text": "放什么歌，玩什么歌。记住"}, {"type": "subtitle", "time": 14984.229, "timestamp": "04:09:44", "text": "不要把数字搞混了。"}, {"type": "subtitle", "time": 14986.07, "timestamp": "04:09:46", "text": "第一个只是上传的内容。"}, {"type": "subtitle", "time": 14990.71, "timestamp": "04:09:50", "text": "声音的。第二点是你的课程。"}, {"type": "subtitle", "time": 14992.79, "timestamp": "04:09:52", "text": "第二个是课程编号。"}, {"type": "subtitle", "time": 14996.229, "timestamp": "04:09:56", "text": "这是其中之一。第三个是会话"}, {"type": "subtitle", "time": 14999.51, "timestamp": "04:09:59", "text": "请查看会话编号。最后"}]
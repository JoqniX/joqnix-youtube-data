[{"type": "subtitle", "time": 481.589, "timestamp": "00:08:01", "text": "因为我醒来时感觉很累，所以"}, {"type": "subtitle", "time": 486.469, "timestamp": "00:08:06", "text": "已排干。我不知道为什么会缺乏"}, {"type": "subtitle", "time": 488.869, "timestamp": "00:08:08", "text": "维生素、钾、钠，我正在服用"}, {"type": "subtitle", "time": 491.189, "timestamp": "00:08:11", "text": "我昨天读的那些东西。"}, {"type": "subtitle", "time": 494.629, "timestamp": "00:08:14", "text": "在推特上发一条类似“你为什么醒来”的推文"}, {"type": "subtitle", "time": 498.07, "timestamp": "00:08:18", "text": "早上起来好累好难受。"}, {"type": "subtitle", "time": 501.67, "timestamp": "00:08:21", "text": "是的，我吃得不好。是的，我不是"}, {"type": "subtitle", "time": 504.23, "timestamp": "00:08:24", "text": "我的身体跟不上节奏，"}, {"type": "subtitle", "time": 505.629, "timestamp": "00:08:25", "text": "不保留"}, {"type": "subtitle", "time": 508.309, "timestamp": "00:08:28", "text": "向上。是的，我想尽我所能做到最好。"}, {"type": "subtitle", "time": 533.11, "timestamp": "00:08:53", "text": "总之，如果需要的话就休息一下吧。我知道我"}, {"type": "subtitle", "time": 535.24, "timestamp": "00:08:55", "text": "可以，"}, {"type": "subtitle", "time": 537.71, "timestamp": "00:08:57", "text": "[音乐]"}, {"type": "subtitle", "time": 539.55, "timestamp": "00:08:59", "text": "但"}]
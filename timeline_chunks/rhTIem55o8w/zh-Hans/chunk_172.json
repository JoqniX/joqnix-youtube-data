[{"type": "subtitle", "time": 10327.67, "timestamp": "02:52:07", "text": "请帮我解决一个问题，我不知道该怎么做。"}, {"type": "subtitle", "time": 10331.11, "timestamp": "02:52:11", "text": "使用印度口音。对不起。我该怎么做？"}, {"type": "subtitle", "time": 10335.349, "timestamp": "02:52:15", "text": "甚至还有口音？我不知道。"}, {"type": "subtitle", "time": 10336.349, "timestamp": "02:52:16", "text": "我不"}, {"type": "subtitle", "time": 10339.309, "timestamp": "02:52:19", "text": "知道。"}, {"type": "subtitle", "time": 10358.55, "timestamp": "02:52:38", "text": "最后剩下的。"}, {"type": "subtitle", "time": 10360.55, "timestamp": "02:52:40", "text": "是的，你有。我以为你是"}, {"type": "subtitle", "time": 10362.83, "timestamp": "02:52:42", "text": "骗子只出现了一秒钟。"}, {"type": "subtitle", "time": 10371.67, "timestamp": "02:52:51", "text": "做？嗯？等等，你是印度人吗？"}, {"type": "subtitle", "time": 10377.75, "timestamp": "02:52:57", "text": "这是第一次有人说我有"}, {"type": "subtitle", "time": 10378.7, "timestamp": "02:52:58", "text": "一个"}]
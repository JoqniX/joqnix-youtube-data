[{"type": "subtitle", "time": 308.23, "timestamp": "00:05:08", "text": "男人。就像睡觉一样，是放置的。"}, {"type": "subtitle", "time": 311.31, "timestamp": "00:05:11", "text": "睡眠不好"}, {"type": "subtitle", "time": 313.79, "timestamp": "00:05:13", "text": "然后就此"}, {"type": "subtitle", "time": 318.31, "timestamp": "00:05:18", "text": "观点？我不知道。我放了“我，我，我是”。"}, {"type": "subtitle", "time": 322.469, "timestamp": "00:05:22", "text": "我早早睡了，然后把V放了进去。我当时"}, {"type": "subtitle", "time": 323.629, "timestamp": "00:05:23", "text": "已经"}, {"type": "subtitle", "time": 326.39, "timestamp": "00:05:26", "text": "昨天我很抱歉，我可能要……"}, {"type": "subtitle", "time": 329.43, "timestamp": "00:05:29", "text": "今天想吐槽一下。是的，昨天我是"}, {"type": "subtitle", "time": 332.59000000000003, "timestamp": "00:05:32", "text": "还在考虑要不要再做一次。"}, {"type": "subtitle", "time": 335.909, "timestamp": "00:05:35", "text": "直播还是不直播，因为我也不想直播。"}, {"type": "subtitle", "time": 339.99, "timestamp": "00:05:39", "text": "为了打破我连续24小时不喝酒的记录"}, {"type": "subtitle", "time": 340.83, "timestamp": "00:05:40", "text": "和"}, {"type": "subtitle", "time": 344.87, "timestamp": "00:05:44", "text": "做些事情。"}, {"type": "subtitle", "time": 347.59000000000003, "timestamp": "00:05:47", "text": "呃，已经持续两个月了。"}, {"type": "subtitle", "time": 351.909, "timestamp": "00:05:51", "text": "这是第二个月了，我当时就想："}, {"type": "subtitle", "time": 354.23, "timestamp": "00:05:54", "text": "好的，我这就打开直播。患病的"}, {"type": "subtitle", "time": 357.11, "timestamp": "00:05:57", "text": "即使感觉好像要睡着了，也要去睡觉。"}, {"type": "subtitle", "time": 359.39, "timestamp": "00:05:59", "text": "一夜"}]
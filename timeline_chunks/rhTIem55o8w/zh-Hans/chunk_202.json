[{"type": "subtitle", "time": 12122.95, "timestamp": "03:22:02", "text": "23日休息。如果我能够"}, {"type": "subtitle", "time": 12125.229, "timestamp": "03:22:05", "text": "直播的时候，我会喜欢"}, {"type": "subtitle", "time": 12130.83, "timestamp": "03:22:10", "text": "我大概会……这样做"}, {"type": "subtitle", "time": 12135.95, "timestamp": "03:22:15", "text": "呃，我不知道。我应该这样做吗？"}, {"type": "subtitle", "time": 12139.429, "timestamp": "03:22:19", "text": "空手道，还是我应该像……一样？"}, {"type": "subtitle", "time": 12141.59, "timestamp": "03:22:21", "text": "圣诞直播之类的？我想要"}, {"type": "subtitle", "time": 12145.269, "timestamp": "03:22:25", "text": "想让它变得特别一些，你知道的。我"}, {"type": "subtitle", "time": 12146.79, "timestamp": "03:22:26", "text": "我想做一些事情，我想做"}, {"type": "subtitle", "time": 12153.79, "timestamp": "03:22:33", "text": "感觉很特别，好像已经过了一段时间了。"}, {"type": "subtitle", "time": 12155.469, "timestamp": "03:22:35", "text": "正确的？"}, {"type": "subtitle", "time": 12159.469, "timestamp": "03:22:39", "text": "是的，一直以来都是这样。"}, {"type": "subtitle", "time": 12163.95, "timestamp": "03:22:43", "text": "尽管。呃，但是呃，而不是我们的"}, {"type": "subtitle", "time": 12167.83, "timestamp": "03:22:47", "text": "定制的传统物件，我们有"}, {"type": "subtitle", "time": 12170.55, "timestamp": "03:22:50", "text": "今年我们只做 X 部分。"}, {"type": "subtitle", "time": 12173.51, "timestamp": "03:22:53", "text": "给我的树涂上颜色。好吧，我提过了。"}, {"type": "subtitle", "time": 12176.469, "timestamp": "03:22:56", "text": "昨天也是。我们会像涂颜色一样涂颜色。"}]
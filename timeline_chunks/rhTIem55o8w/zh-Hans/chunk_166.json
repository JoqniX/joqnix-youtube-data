[{"type": "subtitle", "time": 9982.79, "timestamp": "02:46:22", "text": "不，我卡住了，兄弟。向下 A. 号"}, {"type": "subtitle", "time": 10003.429, "timestamp": "02:46:43", "text": "他否认栽赃陷害。"}, {"type": "subtitle", "time": 10006.389, "timestamp": "02:46:46", "text": "还剩10秒。还剩一个敌人。"}, {"type": "subtitle", "time": 10011.429, "timestamp": "02:46:51", "text": "哦，我们赢了。耶。进攻方获胜。"}, {"type": "subtitle", "time": 10017.75, "timestamp": "02:46:57", "text": "我打得不好，不过没关系。但我们赢了。"}]
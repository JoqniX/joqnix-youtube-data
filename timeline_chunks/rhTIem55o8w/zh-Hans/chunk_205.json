[{"type": "subtitle", "time": 12300.19, "timestamp": "03:25:00", "text": "我也迟到了15分钟。"}, {"type": "subtitle", "time": 12302.91, "timestamp": "03:25:02", "text": "哦。"}, {"type": "subtitle", "time": 12310.63, "timestamp": "03:25:10", "text": "我也想晚上直播。"}, {"type": "subtitle", "time": 12313.55, "timestamp": "03:25:13", "text": "但"}, {"type": "subtitle", "time": 12317.309, "timestamp": "03:25:17", "text": "嗯，晚上我有"}, {"type": "subtitle", "time": 12323.11, "timestamp": "03:25:23", "text": "课程。我现在一般晚上11、12点睡觉。"}, {"type": "subtitle", "time": 12325.99, "timestamp": "03:25:25", "text": "我应该10点睡觉。你好。"}, {"type": "subtitle", "time": 12342.55, "timestamp": "03:25:42", "text": "[音乐]"}, {"type": "subtitle", "time": 12343.71, "timestamp": "03:25:43", "text": "希望你一切顺利"}, {"type": "subtitle", "time": 12347.67, "timestamp": "03:25:47", "text": "出色地。所以，是的，比如日程安排问题。"}, {"type": "subtitle", "time": 12350.11, "timestamp": "03:25:50", "text": "真是如此"}, {"type": "subtitle", "time": 12353.15, "timestamp": "03:25:53", "text": "难的。你有没有过"}, {"type": "subtitle", "time": 12357.51, "timestamp": "03:25:57", "text": "你有没有过这样的经历：我又睡过头了？"}]
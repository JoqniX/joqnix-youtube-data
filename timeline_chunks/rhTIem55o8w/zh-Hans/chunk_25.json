[{"type": "subtitle", "time": 1503.71, "timestamp": "00:25:03", "text": "又来了，嗯"}, {"type": "subtitle", "time": 1506.63, "timestamp": "00:25:06", "text": "萨米，你知道我要做什么。"}, {"type": "subtitle", "time": 1510.47, "timestamp": "00:25:10", "text": "今天。我不在乎。我做完了。"}, {"type": "subtitle", "time": 1513.35, "timestamp": "00:25:13", "text": "我会把东西运走。我"}, {"type": "subtitle", "time": 1516.47, "timestamp": "00:25:16", "text": "我觉得我不能太依赖别人。"}, {"type": "subtitle", "time": 1518.549, "timestamp": "00:25:18", "text": "主播模式和主播模式可以"}, {"type": "subtitle", "time": 1521.35, "timestamp": "00:25:21", "text": "死亡之类的。而且，我知道我可以拥有"}, {"type": "subtitle", "time": 1526.39, "timestamp": "00:25:26", "text": "所有其他东西，比如混合在一起"}, {"type": "subtitle", "time": 1528.789, "timestamp": "00:25:28", "text": "还有萨米之类的。所以，我会用它们。"}, {"type": "subtitle", "time": 1530.99, "timestamp": "00:25:30", "text": "为了"}, {"type": "subtitle", "time": 1533.669, "timestamp": "00:25:33", "text": "现在是因为有些人很愚蠢。有"}, {"type": "subtitle", "time": 1536.87, "timestamp": "00:25:36", "text": "没有理由。这是真的。你真的很想"}, {"type": "subtitle", "time": 1539.669, "timestamp": "00:25:39", "text": "凶手解释他杀人的原因"}, {"type": "subtitle", "time": 1542.23, "timestamp": "00:25:42", "text": "有人吗？没有。"}, {"type": "subtitle", "time": 1553.549, "timestamp": "00:25:53", "text": "上帝。"}, {"type": "subtitle", "time": 1557.63, "timestamp": "00:25:57", "text": "嗯，但问题是，你没看到问题是……"}]
[{"type": "subtitle", "time": 10020.389, "timestamp": "02:47:00", "text": "我们至少应该赢一场比赛。我们"}, {"type": "subtitle", "time": 10024.03, "timestamp": "02:47:04", "text": "需要赢五场、十场。我不需要。"}, {"type": "subtitle", "time": 10027.99, "timestamp": "02:47:07", "text": "知道。八次击杀。不错。还有四个"}, {"type": "subtitle", "time": 10033.309, "timestamp": "02:47:13", "text": "好的。"}, {"type": "subtitle", "time": 10037.269, "timestamp": "02:47:17", "text": "是的。好的。"}, {"type": "subtitle", "time": 10047.429, "timestamp": "02:47:27", "text": "射击。等等，一场比赛要一个小时。哦，我的"}, {"type": "subtitle", "time": 10049.429, "timestamp": "02:47:29", "text": "上帝。四场比赛就像四场"}, {"type": "subtitle", "time": 10052.269, "timestamp": "02:47:32", "text": "比赛将有四场。"}, {"type": "subtitle", "time": 10055.67, "timestamp": "02:47:35", "text": "大约几个小时。人们是如何玩这个游戏的"}, {"type": "subtitle", "time": 10059.429, "timestamp": "02:47:39", "text": "像个竞争对手？我见过你们中的很多人。"}, {"type": "subtitle", "time": 10063.19, "timestamp": "02:47:43", "text": "玩这款游戏的人就像我认识的人一样。"}, {"type": "subtitle", "time": 10065.91, "timestamp": "02:47:45", "text": "和油管博主朋友们之类的。"}, {"type": "subtitle", "time": 10071.07, "timestamp": "02:47:51", "text": "我就是不明白。我没有收到"}, {"type": "subtitle", "time": 10073.15, "timestamp": "02:47:53", "text": "它。"}]
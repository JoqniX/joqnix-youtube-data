[{"type": "subtitle", "time": 2284.31, "timestamp": "00:38:04", "text": "嗯，还有其他的一切。那感觉就像"}, {"type": "subtitle", "time": 2287.829, "timestamp": "00:38:07", "text": "2021年的笑话。好了，这就是我的……"}, {"type": "subtitle", "time": 2290.31, "timestamp": "00:38:10", "text": "主意。"}, {"type": "subtitle", "time": 2293.79, "timestamp": "00:38:13", "text": "我当时想，哦，人们可能……"}, {"type": "subtitle", "time": 2296.47, "timestamp": "00:38:16", "text": "人们对此有不同的看法，因为……"}, {"type": "subtitle", "time": 2298.03, "timestamp": "00:38:18", "text": "将"}, {"type": "subtitle", "time": 2301.39, "timestamp": "00:38:21", "text": "就像会有持续不断的流一样"}, {"type": "subtitle", "time": 2304.87, "timestamp": "00:38:24", "text": "全天候24小时在线，可能会获得"}, {"type": "subtitle", "time": 2307.19, "timestamp": "00:38:27", "text": "值班时间或其他什么"}, {"type": "subtitle", "time": 2309.75, "timestamp": "00:38:29", "text": "现在一切都结束了，以后也只会这样。"}, {"type": "subtitle", "time": 2311.91, "timestamp": "00:38:31", "text": "听听音乐，也没什么别的。"}, {"type": "subtitle", "time": 2314.31, "timestamp": "00:38:34", "text": "一切，我觉得人们可能会"}, {"type": "subtitle", "time": 2316.47, "timestamp": "00:38:36", "text": "看法不一样，等等等等，我"}, {"type": "chat", "time": 2316.486, "timestamp": "00:38:36", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "it'll 1. help u practice. 2. free asset that u can share on socials for other's to use\\"}, {"type": "subtitle", "time": 2318.63, "timestamp": "00:38:38", "text": "已经看到很多频道都在这么做了。"}, {"type": "subtitle", "time": 2321.95, "timestamp": "00:38:41", "text": "当时因为李家的女孩爆红，"}, {"type": "subtitle", "time": 2324.71, "timestamp": "00:38:44", "text": "正确的？很多 YouTube 频道都是"}, {"type": "subtitle", "time": 2326.19, "timestamp": "00:38:46", "text": "正在做"}, {"type": "subtitle", "time": 2329.03, "timestamp": "00:38:49", "text": "以及其他一切。所以我就想，"}, {"type": "subtitle", "time": 2331.03, "timestamp": "00:38:51", "text": "“好吧，行。我不做了。”然后"}, {"type": "subtitle", "time": 2334.55, "timestamp": "00:38:54", "text": "然后我写了好几年。然后"}, {"type": "subtitle", "time": 2337.349, "timestamp": "00:38:57", "text": "Jockathon活动发生了，然后就开始了。"}, {"type": "subtitle", "time": 2339.99, "timestamp": "00:38:59", "text": "我开始做这件事了，对吧？"}]
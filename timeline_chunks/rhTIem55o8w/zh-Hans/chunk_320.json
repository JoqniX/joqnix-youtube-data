[{"type": "subtitle", "time": 19202.51, "timestamp": "05:20:02", "text": "我正在做一些事情"}, {"type": "subtitle", "time": 19206.708, "timestamp": "05:20:06", "text": "现在。我找不到试卷的音频。"}, {"type": "subtitle", "time": 19210.23, "timestamp": "05:20:10", "text": "没关系。嗯，语言水平如何？"}, {"type": "subtitle", "time": 19213.27, "timestamp": "05:20:13", "text": "在日本工作？我记得当时"}, {"type": "subtitle", "time": 19216.628, "timestamp": "05:20:16", "text": "一些N3和N5之类的。所以N5是"}, {"type": "subtitle", "time": 19219.19, "timestamp": "05:20:19", "text": "开始"}, {"type": "subtitle", "time": 19223.11, "timestamp": "05:20:23", "text": "呃，N5 将是开始，呃，就像一个"}, {"type": "subtitle", "time": 19226.39, "timestamp": "05:20:26", "text": "初级水平。 N4 和 N5 将是"}, {"type": "subtitle", "time": 19230.31, "timestamp": "05:20:30", "text": "课程级别为初级日语"}, {"type": "subtitle", "time": 19232.708, "timestamp": "05:20:32", "text": "从N3开始就有点像这样了。"}, {"type": "subtitle", "time": 19235.51, "timestamp": "05:20:35", "text": "中级水平，可以说N3和二。"}, {"type": "subtitle", "time": 19237.91, "timestamp": "05:20:37", "text": "中级和N1将是母语"}, {"type": "subtitle", "time": 19239.31, "timestamp": "05:20:39", "text": "水平"}, {"type": "subtitle", "time": 19242.788, "timestamp": "05:20:42", "text": "日本版，而且显然从N3开始就是如此。"}, {"type": "subtitle", "time": 19245.11, "timestamp": "05:20:45", "text": "就像另一种语言之类的"}, {"type": "subtitle", "time": 19246.67, "timestamp": "05:20:46", "text": "呃，非常"}, {"type": "subtitle", "time": 19254.47, "timestamp": "05:20:54", "text": "嗯，日本"}, {"type": "subtitle", "time": 19255.708, "timestamp": "05:20:55", "text": "呃"}]
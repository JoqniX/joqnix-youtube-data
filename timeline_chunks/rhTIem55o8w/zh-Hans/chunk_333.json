[{"type": "subtitle", "time": 19980.868, "timestamp": "05:33:00", "text": "他们来了，我都认不出来了。是的，"}, {"type": "subtitle", "time": 19986.11, "timestamp": "05:33:06", "text": "这个。木头"}, {"type": "subtitle", "time": 19988.83, "timestamp": "05:33:08", "text": "一。"}, {"type": "subtitle", "time": 19991.99, "timestamp": "05:33:11", "text": "呃，等等。是1到5，对吧？等等，什么？"}, {"type": "subtitle", "time": 19999.31, "timestamp": "05:33:19", "text": "再次？我到了16岁。"}, {"type": "subtitle", "time": 20002.27, "timestamp": "05:33:22", "text": "嗯，试卷是为"}, {"type": "subtitle", "time": 20005.15, "timestamp": "05:33:25", "text": "[音乐]"}, {"type": "subtitle", "time": 20008.51, "timestamp": "05:33:28", "text": "呃，我在浪费时间。请留言。"}, {"type": "subtitle", "time": 20012.31, "timestamp": "05:33:32", "text": "呃，试卷上的题数是一到五，对吧？"}, {"type": "subtitle", "time": 20013.868, "timestamp": "05:33:33", "text": "主题一"}, {"type": "subtitle", "time": 20017.03, "timestamp": "05:33:37", "text": "五。哪一到五？"}, {"type": "subtitle", "time": 20021.11, "timestamp": "05:33:41", "text": "是这个吗？呃，是像哪个？"}, {"type": "subtitle", "time": 20023.23, "timestamp": "05:33:43", "text": "话题？是吗？"}, {"type": "subtitle", "time": 20027.35, "timestamp": "05:33:47", "text": "课？我现在很困惑。没关系。我们"}, {"type": "subtitle", "time": 20029.59, "timestamp": "05:33:49", "text": "检查了六个，对吧？呃，我们还是这样吧"}, {"type": "subtitle", "time": 20033.28, "timestamp": "05:33:53", "text": "继续检查汉字。我"}, {"type": "subtitle", "time": 20035.548, "timestamp": "05:33:55", "text": "[音乐]"}, {"type": "subtitle", "time": 20038.948, "timestamp": "05:33:58", "text": "忘了，这不是汉字。"}]
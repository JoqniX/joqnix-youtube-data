[{"type": "subtitle", "time": 423.67, "timestamp": "00:07:03", "text": "需要早睡，并把 v 放在"}, {"type": "subtitle", "time": 439.07, "timestamp": "00:07:19", "text": "我还是不。"}, {"type": "subtitle", "time": 442.309, "timestamp": "00:07:22", "text": "知道。所以今天我想做更多的事情。"}, {"type": "subtitle", "time": 445.27, "timestamp": "00:07:25", "text": "我只是需要把一些事情弄清楚。我 我"}, {"type": "subtitle", "time": 447.469, "timestamp": "00:07:27", "text": "我不喜欢我现在的做法"}, {"type": "subtitle", "time": 450.48, "timestamp": "00:07:30", "text": "乔森。我想把它做出来"}, {"type": "subtitle", "time": 451.71, "timestamp": "00:07:31", "text": "[音乐]"}, {"type": "subtitle", "time": 466.469, "timestamp": "00:07:46", "text": "东西。是的，我正在努力成为"}, {"type": "subtitle", "time": 470.589, "timestamp": "00:07:50", "text": "情况好转了，而且我今天过得也很顺利。我"}, {"type": "subtitle", "time": 473.35, "timestamp": "00:07:53", "text": "我想就是我醒来后看到的。"}, {"type": "subtitle", "time": 475.589, "timestamp": "00:07:55", "text": "评论，还有那条评论，基本上毁了我的心情。"}, {"type": "subtitle", "time": 478.71, "timestamp": "00:07:58", "text": "今天我体内仅存的一点理智，算是神圣的了。"}]
[{"type": "subtitle", "time": 15300.469, "timestamp": "04:15:00", "text": "我们开始画图。好的，让我来做"}, {"type": "subtitle", "time": 15303.429, "timestamp": "04:15:03", "text": "我的绘图板肯定已连接。"}, {"type": "subtitle", "time": 15305.83, "timestamp": "04:15:05", "text": "是的，它们已连接。是的，但是"}, {"type": "subtitle", "time": 15308.149, "timestamp": "04:15:08", "text": "是不是微软Edge浏览器有问题？"}, {"type": "subtitle", "time": 15310.63, "timestamp": "04:15:10", "text": "如果你使用 Microsoft Edge 浏览器，你会喜欢"}, {"type": "subtitle", "time": 15314.07, "timestamp": "04:15:14", "text": "写这些东西的时候，你不能用Ctrl+E。"}, {"type": "subtitle", "time": 15316.229, "timestamp": "04:15:16", "text": "擦除。你必须点击"}, {"type": "subtitle", "time": 15319.67, "timestamp": "04:15:19", "text": "用橡皮擦擦掉。太疼了。但"}, {"type": "subtitle", "time": 15320.83, "timestamp": "04:15:20", "text": "它是"}, {"type": "subtitle", "time": 15323.83, "timestamp": "04:15:23", "text": "好的。你无法控制的就是这一点。"}, {"type": "subtitle", "time": 15325.95, "timestamp": "04:15:25", "text": "东西。真糟糕。"}, {"type": "subtitle", "time": 15339.189, "timestamp": "04:15:39", "text": "好的，这样会好一些。不"}, {"type": "subtitle", "time": 15341.99, "timestamp": "04:15:41", "text": "担心。我有点想，又有点不想。"}, {"type": "subtitle", "time": 15344.189, "timestamp": "04:15:44", "text": "拉紧"}, {"type": "subtitle", "time": 15347.75, "timestamp": "04:15:47", "text": "它。嗯？没问题吧？我认为是"}, {"type": "subtitle", "time": 15348.67, "timestamp": "04:15:48", "text": "美好的。"}, {"type": "subtitle", "time": 15359.229, "timestamp": "04:15:59", "text": "那么，让我们一起来听吧。"}]
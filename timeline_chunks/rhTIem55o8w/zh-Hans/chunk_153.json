[{"type": "subtitle", "time": 9193.349, "timestamp": "02:33:13", "text": "等待。"}, {"type": "subtitle", "time": 9225.75, "timestamp": "02:33:45", "text": "去！去！去。"}, {"type": "subtitle", "time": 9228.71, "timestamp": "02:33:48", "text": "不，那是我做过的最愚蠢的事。"}, {"type": "subtitle", "time": 9230.79, "timestamp": "02:33:50", "text": "在我整个人生中。接下来我要讲的是……"}, {"type": "subtitle", "time": 9232.27, "timestamp": "02:33:52", "text": "到"}, {"type": "subtitle", "time": 9235.99, "timestamp": "02:33:55", "text": "你，但我并不后悔。我跳了上去"}]
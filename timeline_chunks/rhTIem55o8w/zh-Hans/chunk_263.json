[{"type": "subtitle", "time": 15781.229, "timestamp": "04:23:01", "text": "Kujihan 的意思是"}, {"type": "subtitle", "time": 15783.87, "timestamp": "04:23:03", "text": "晚上9:30"}, {"type": "subtitle", "time": 15789.63, "timestamp": "04:23:09", "text": "9:30朱尼纯一.呃，Juni。呃"}, {"type": "subtitle", "time": 15791.229, "timestamp": "04:23:11", "text": "11"}, {"type": "subtitle", "time": 15796.11, "timestamp": "04:23:16", "text": "周三。"}, {"type": "subtitle", "time": 15799.51, "timestamp": "04:23:19", "text": "穆约比。等待。隋。等等等等等等。"}, {"type": "subtitle", "time": 15802.189, "timestamp": "04:23:22", "text": "Moku 是 Moku 是"}, {"type": "subtitle", "time": 15805.71, "timestamp": "04:23:25", "text": "这是Moku吗？"}, {"type": "subtitle", "time": 15812.429, "timestamp": "04:23:32", "text": "木井。所以"}, {"type": "subtitle", "time": 15815.79, "timestamp": "04:23:35", "text": "Makuyobi Makui 是星期四。雷丘是"}, {"type": "subtitle", "time": 15818.389, "timestamp": "04:23:38", "text": "下周。所以这是个特例。"}, {"type": "subtitle", "time": 15829.87, "timestamp": "04:23:49", "text": "正确的"}, {"type": "subtitle", "time": 15832.83, "timestamp": "04:23:52", "text": "金子。所以"}, {"type": "subtitle", "time": 15837.189, "timestamp": "04:23:57", "text": "Kenyobi Kenyobi 是星期五。好吧，我想"}]
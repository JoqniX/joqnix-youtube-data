[{"type": "subtitle", "time": 7624.51, "timestamp": "02:07:04", "text": "完毕。兰迪"}, {"type": "subtitle", "time": 7627.99, "timestamp": "02:07:07", "text": "容易地。是的，我知道。就像我不放"}, {"type": "subtitle", "time": 7630.069, "timestamp": "02:07:10", "text": "我想，大概是那种严肃的态度吧。我不知道"}, {"type": "subtitle", "time": 7640.149, "timestamp": "02:07:20", "text": "我应该把我的……我还有我的……那只手"}, {"type": "subtitle", "time": 7644.069, "timestamp": "02:07:24", "text": "摄像头直播就像全袖手套一样。"}, {"type": "subtitle", "time": 7647.99, "timestamp": "02:07:27", "text": "我准备好了。我应该就这么用吗？"}, {"type": "subtitle", "time": 7651.75, "timestamp": "02:07:31", "text": "我的……呃，就像手腕上的那个东西？这"}, {"type": "subtitle", "time": 7665.109, "timestamp": "02:07:45", "text": "哦，你知道Sinoa禁令好像并不适用吗？"}, {"type": "subtitle", "time": 7667.99, "timestamp": "02:07:47", "text": "允许罗克塞尔吗？我的账户打不开。"}, {"type": "subtitle", "time": 7671.27, "timestamp": "02:07:51", "text": "已禁止。为什么？为什么他们不允许"}, {"type": "subtitle", "time": 7673.95, "timestamp": "02:07:53", "text": "罗克塞尔？快点。它是"}, {"type": "subtitle", "time": 7676.51, "timestamp": "02:07:56", "text": "2025年。将会是"}, {"type": "subtitle", "time": 7679.31, "timestamp": "02:07:59", "text": "2025年。谁？为什么？"}]
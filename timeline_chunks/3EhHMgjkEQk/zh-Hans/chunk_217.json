[{"type": "subtitle", "time": 13020.79, "timestamp": "03:37:00", "text": "好的。现在看看我现在的高度。好的。"}, {"type": "subtitle", "time": 13024.309, "timestamp": "03:37:04", "text": "你在哪里？"}, {"type": "subtitle", "time": 13026.07, "timestamp": "03:37:06", "text": "哦，你看不见我吗？就像"}, {"type": "subtitle", "time": 13028.79, "timestamp": "03:37:08", "text": "你不能观看我的比赛吗？不，不，不。"}, {"type": "subtitle", "time": 13032.389, "timestamp": "03:37:12", "text": "我现在就在飞机上。第"}, {"type": "subtitle", "time": 13033.91, "timestamp": "03:37:13", "text": "哦，你排在第四位。哦，太好了。"}, {"type": "subtitle", "time": 13036.63, "timestamp": "03:37:16", "text": "伟大的。好的，好的，好的。所以我会进来。"}, {"type": "subtitle", "time": 13038.99, "timestamp": "03:37:18", "text": "低空向你飞来。"}, {"type": "subtitle", "time": 13043.11, "timestamp": "03:37:23", "text": "好的。我现在距离 A 点 15 公里。"}, {"type": "subtitle", "time": 13045.429, "timestamp": "03:37:25", "text": "所以我离目的地很远。"}, {"type": "subtitle", "time": 13047.99, "timestamp": "03:37:27", "text": "你认为你能向那里发射导弹吗？"}, {"type": "subtitle", "time": 13053.429, "timestamp": "03:37:33", "text": "现在的我？像这样。去做。"}, {"type": "subtitle", "time": 13055.71, "timestamp": "03:37:35", "text": "等待。让我爬一小段路。"}, {"type": "subtitle", "time": 13058.269, "timestamp": "03:37:38", "text": "少量。"}, {"type": "subtitle", "time": 13060.87, "timestamp": "03:37:40", "text": "现在我只需要打开雷达了。"}, {"type": "subtitle", "time": 13061.87, "timestamp": "03:37:41", "text": "狩猎"}, {"type": "subtitle", "time": 13065.99, "timestamp": "03:37:45", "text": "你。所以我必须见你。"}, {"type": "subtitle", "time": 13068.79, "timestamp": "03:37:48", "text": "我已入土。哦，我看到你了。"}, {"type": "subtitle", "time": 13070.389, "timestamp": "03:37:50", "text": "同一个地方。是的。那里有一枚导弹"}, {"type": "subtitle", "time": 13076.95, "timestamp": "03:37:56", "text": "尽量贴近地面。拥抱"}, {"type": "subtitle", "time": 13078.79, "timestamp": "03:37:58", "text": "几乎就像你要去踩地一样"}]
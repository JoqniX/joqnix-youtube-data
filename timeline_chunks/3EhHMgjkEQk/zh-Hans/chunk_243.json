[{"type": "subtitle", "time": 14580.63, "timestamp": "04:03:00", "text": "所以，你可以把它当作娱乐活动。"}, {"type": "subtitle", "time": 14581.99, "timestamp": "04:03:01", "text": "仅仅因为你没有更好的选择"}, {"type": "subtitle", "time": 14584.71, "timestamp": "04:03:04", "text": "做或者你可以用它来执行机动动作"}, {"type": "subtitle", "time": 14589.51, "timestamp": "04:03:09", "text": "保护你免受导弹和其他垃圾的侵害。"}, {"type": "subtitle", "time": 14591.79, "timestamp": "04:03:11", "text": "这招确实管用。进行体检"}, {"type": "subtitle", "time": 14593.91, "timestamp": "04:03:13", "text": "物品会一直保护你"}, {"type": "subtitle", "time": 14596.03, "timestamp": "04:03:16", "text": "无论如何"}, {"type": "subtitle", "time": 14599.59, "timestamp": "04:03:19", "text": "其他玩家的技术越好。"}, {"type": "subtitle", "time": 14611.91, "timestamp": "04:03:31", "text": "是的。"}, {"type": "subtitle", "time": 14613.469, "timestamp": "04:03:33", "text": "哦，"}, {"type": "subtitle", "time": 14616.79, "timestamp": "04:03:36", "text": "好的。出去。第二。你相对来说已经出局了。"}, {"type": "subtitle", "time": 14621.91, "timestamp": "04:03:41", "text": "我应该选第二个的。"}, {"type": "subtitle", "time": 14627.91, "timestamp": "04:03:47", "text": "而且，如果我就在你身后，或者"}, {"type": "subtitle", "time": 14629.99, "timestamp": "04:03:49", "text": "就在你眼前，毫无意义"}, {"type": "subtitle", "time": 14632.03, "timestamp": "04:03:52", "text": "因为没有"}, {"type": "subtitle", "time": 14635.189, "timestamp": "04:03:55", "text": "障碍。啊，需要有一个"}, {"type": "subtitle", "time": 14637.83, "timestamp": "04:03:57", "text": "障碍。对，就待在那儿。我这就去"}]
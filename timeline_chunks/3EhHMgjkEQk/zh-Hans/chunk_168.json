[{"type": "subtitle", "time": 10082.15, "timestamp": "02:48:02", "text": "哦，这个东西。是的，那是你的空气"}, {"type": "subtitle", "time": 10084.79, "timestamp": "02:48:04", "text": "胸罩。"}, {"type": "subtitle", "time": 10087.83, "timestamp": "02:48:07", "text": "如果你想雄心勃勃，"}, {"type": "subtitle", "time": 10089.75, "timestamp": "02:48:09", "text": "你可以尝试建造一艘航空母舰。"}, {"type": "subtitle", "time": 10090.99, "timestamp": "02:48:10", "text": "像着陆一样"}, {"type": "subtitle", "time": 10095.87, "timestamp": "02:48:15", "text": "这架飞机上的 Topg。等等，真的吗？"}, {"type": "subtitle", "time": 10099.75, "timestamp": "02:48:19", "text": "是的。首先，呃，再打一下，摆脱它"}, {"type": "subtitle", "time": 10101.15, "timestamp": "02:48:21", "text": "你的空气"}, {"type": "subtitle", "time": 10103.91, "timestamp": "02:48:23", "text": "刹车，恢复发动机动力，"}, {"type": "subtitle", "time": 10111.11, "timestamp": "02:48:31", "text": "航空母舰"}, {"type": "subtitle", "time": 10113.51, "timestamp": "02:48:33", "text": "就在海里。"}, {"type": "subtitle", "time": 10121.429, "timestamp": "02:48:41", "text": "在你右边。它就在右边"}, {"type": "subtitle", "time": 10132.309, "timestamp": "02:48:52", "text": "你离我很远。"}, {"type": "subtitle", "time": 10136.469, "timestamp": "02:48:56", "text": "我不能，我不能就这么降落在这片土地上。"}, {"type": "subtitle", "time": 10138.23, "timestamp": "02:48:58", "text": "是的，但你不会体验到……"}]
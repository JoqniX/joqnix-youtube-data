[{"type": "subtitle", "time": 2040.149, "timestamp": "00:34:00", "text": "飞机。我应该把它穿上吗？"}, {"type": "subtitle", "time": 2043.43, "timestamp": "00:34:03", "text": "简化控制？"}, {"type": "subtitle", "time": 2045.269, "timestamp": "00:34:05", "text": "即使你那样做，你也得去。"}, {"type": "subtitle", "time": 2047.99, "timestamp": "00:34:07", "text": "检查您的默认设置。一般来说，"}, {"type": "subtitle", "time": 2049.51, "timestamp": "00:34:09", "text": "当你开始玩游戏时，你会做什么？"}, {"type": "subtitle", "time": 2052.79, "timestamp": "00:34:12", "text": "游戏规则由你根据自己的喜好设定。"}, {"type": "subtitle", "time": 2055.109, "timestamp": "00:34:15", "text": "舒适。"}, {"type": "subtitle", "time": 2057.669, "timestamp": "00:34:17", "text": "所以，我的设置不是默认值。我已经"}, {"type": "subtitle", "time": 2061.99, "timestamp": "00:34:21", "text": "我改了一下我的。啊，所以要去飞机上。"}, {"type": "subtitle", "time": 2066.389, "timestamp": "00:34:26", "text": "移动一下，然后看看你的按钮。它是"}, {"type": "subtitle", "time": 2071.349, "timestamp": "00:34:31", "text": "限制访问权限。呃，鼠标滚轮。"}, {"type": "subtitle", "time": 2079.99, "timestamp": "00:34:39", "text": "呃，我甚至不知道也不记得是什么了。"}, {"type": "subtitle", "time": 2083.349, "timestamp": "00:34:43", "text": "我玩这个游戏的时候。我本来打算"}, {"type": "subtitle", "time": 2085.75, "timestamp": "00:34:45", "text": "问：你以前玩过这个游戏吗？我"}, {"type": "subtitle", "time": 2093.669, "timestamp": "00:34:53", "text": "我不记得了。我教过你了吗？我"}, {"type": "subtitle", "time": 2095.27, "timestamp": "00:34:55", "text": "当时我想，我唯一做的就是"}, {"type": "subtitle", "time": 2098.31, "timestamp": "00:34:58", "text": "教你如何像飞翔一样轻松自如。"}]
[{"type": "subtitle", "time": 5761.11, "timestamp": "01:36:01", "text": "现在感觉无聊多了。"}, {"type": "subtitle", "time": 5763.43, "timestamp": "01:36:03", "text": "但是，正是这种无聊感造就了它。"}, {"type": "subtitle", "time": 5767.51, "timestamp": "01:36:07", "text": "更安全。进入了一场真正的战斗。"}, {"type": "subtitle", "time": 5769.189, "timestamp": "01:36:09", "text": "嗯。"}, {"type": "subtitle", "time": 5771.83, "timestamp": "01:36:11", "text": "现在，你想在比赛开始前参加一场比赛。"}, {"type": "subtitle", "time": 5774.709, "timestamp": "01:36:14", "text": "我们进入比赛。呃，在那些"}, {"type": "subtitle", "time": 5777.03, "timestamp": "01:36:17", "text": "那些高端产品线，那些拥有……的产品"}, {"type": "subtitle", "time": 5779.43, "timestamp": "01:36:19", "text": "绿色背景。"}, {"type": "subtitle", "time": 5781.75, "timestamp": "01:36:21", "text": "是的。无论你看到哪架飞机有"}, {"type": "subtitle", "time": 5783.189, "timestamp": "01:36:23", "text": "绿色背景。不仅仅是飞机，"}, {"type": "subtitle", "time": 5786.229, "timestamp": "01:36:26", "text": "它也包括坦克，你可以加入一个"}, {"type": "subtitle", "time": 5788.95, "timestamp": "01:36:28", "text": "《战争雷霆》中的中队"}, {"type": "subtitle", "time": 5790.87, "timestamp": "01:36:30", "text": "你可以继续玩下去。做"}, {"type": "subtitle", "time": 5792.629, "timestamp": "01:36:32", "text": "无论你代表哪个国家参赛。它"}, {"type": "subtitle", "time": 5793.99, "timestamp": "01:36:33", "text": "不必是同一个国家或地区"}, {"type": "subtitle", "time": 5797.669, "timestamp": "01:36:37", "text": "诸如此类的事情。每隔两天，"}, {"type": "subtitle", "time": 5800.87, "timestamp": "01:36:40", "text": "你会获得另一种类型的经验值。"}, {"type": "subtitle", "time": 5802.59, "timestamp": "01:36:42", "text": "你会得到一个中队"}, {"type": "subtitle", "time": 5805.91, "timestamp": "01:36:45", "text": "XP。你只需要玩游戏就行了。"}, {"type": "subtitle", "time": 5808.47, "timestamp": "01:36:48", "text": "现在，经验值会不断积累。"}, {"type": "subtitle", "time": 5811.43, "timestamp": "01:36:51", "text": "大约 3 到 4 个月的时间。"}, {"type": "subtitle", "time": 5813.51, "timestamp": "01:36:53", "text": "它会填满所需的量"}, {"type": "subtitle", "time": 5816.39, "timestamp": "01:36:56", "text": "绿色中队的经验值"}, {"type": "subtitle", "time": 5818.629, "timestamp": "01:36:58", "text": "车辆。所以飞机一直都在"}]
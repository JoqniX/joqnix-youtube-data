[{"type": "subtitle", "time": 4509.59, "timestamp": "01:15:09", "text": "哇。就是这样做的。"}, {"type": "subtitle", "time": 4511.91, "timestamp": "01:15:11", "text": "撞到了，我还在飞，但我"}, {"type": "subtitle", "time": 4514.75, "timestamp": "01:15:14", "text": "很快就要崩溃了。哦，我"}, {"type": "subtitle", "time": 4517.35, "timestamp": "01:15:17", "text": "崩溃了。哦，什么？你击杀了目标。我"}, {"type": "subtitle", "time": 4522.95, "timestamp": "01:15:22", "text": "好的。"}, {"type": "subtitle", "time": 4525.189, "timestamp": "01:15:25", "text": "好了，是时候使用更强大的工具了。"}, {"type": "subtitle", "time": 4536.149, "timestamp": "01:15:36", "text": "还有更大口径的枪。嗯。你好。"}, {"type": "subtitle", "time": 4539.99, "timestamp": "01:15:39", "text": "碧昂丝是谁？超过"}, {"type": "subtitle", "time": 4546.51, "timestamp": "01:15:46", "text": "我的天啊。"}, {"type": "subtitle", "time": 4549.55, "timestamp": "01:15:49", "text": "油门 油门"}, {"type": "subtitle", "time": 4553.189, "timestamp": "01:15:53", "text": "WP。鼠标滚轮倍增器，控制"}]
[{"type": "subtitle", "time": 6804.229, "timestamp": "01:53:24", "text": "好了，我抓住了你身后的那个人。我"}, {"type": "subtitle", "time": 6806.83, "timestamp": "01:53:26", "text": "不过我没看到你。哦，你在这儿啊。"}, {"type": "subtitle", "time": 6814.55, "timestamp": "01:53:34", "text": "这里。抓住他。他已经伤得很重了。"}, {"type": "subtitle", "time": 6817.83, "timestamp": "01:53:37", "text": "少量。顺便说一句，就在你上面。"}, {"type": "subtitle", "time": 6820.47, "timestamp": "01:53:40", "text": "下面。有一个。那家伙走了。"}, {"type": "subtitle", "time": 6822.35, "timestamp": "01:53:42", "text": "那家伙要……"}, {"type": "subtitle", "time": 6825.589, "timestamp": "01:53:45", "text": "碰撞。好的。乔克，你后面。你看"}, {"type": "subtitle", "time": 6827.99, "timestamp": "01:53:47", "text": "他们？是的。你看到他们了吗？小心。不"}, {"type": "subtitle", "time": 6830.39, "timestamp": "01:53:50", "text": "离开。"}, {"type": "subtitle", "time": 6834.669, "timestamp": "01:53:54", "text": "啊。哦，还不错。不错。你让他……"}, {"type": "subtitle", "time": 6838.07, "timestamp": "01:53:58", "text": "火。我不会开枪打死他。"}]
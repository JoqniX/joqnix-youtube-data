[{"type": "subtitle", "time": 13089.51, "timestamp": "03:38:09", "text": "哇。哦，但我还活着。"}, {"type": "subtitle", "time": 13091.6, "timestamp": "03:38:11", "text": "但我还活着。 我的天啊。所以，比……略低一些"}, {"type": "subtitle", "time": 13093.68, "timestamp": "03:38:13", "text": "我的天啊。所以，比……略低一些 你当时的处境有多低，你或许就能活下来"}, {"type": "subtitle", "time": 13096.08, "timestamp": "03:38:16", "text": "你当时的处境有多低，你或许就能活下来 下次。"}, {"type": "subtitle", "time": 13097.92, "timestamp": "03:38:17", "text": "下次。 还有一个。"}, {"type": "subtitle", "time": 13101.239, "timestamp": "03:38:21", "text": "还有一个。 嗯？啊，我该在哪里等呢？"}, {"type": "subtitle", "time": 13112.07, "timestamp": "03:38:32", "text": "你看到了我当时的处境有多低落。是的，"}, {"type": "subtitle", "time": 13115.269, "timestamp": "03:38:35", "text": "你必须像那样卑微。我"}, {"type": "subtitle", "time": 13117.03, "timestamp": "03:38:37", "text": "对于一架喷气式飞机来说，这个温度真的很低。所以，对于一个"}, {"type": "subtitle", "time": 13117.99, "timestamp": "03:38:37", "text": "螺旋桨，你必须稍微……"}, {"type": "subtitle", "time": 13119.67, "timestamp": "03:38:39", "text": "降低。"}, {"type": "subtitle", "time": 13122.229, "timestamp": "03:38:42", "text": "哦，好的。因为你比别人慢得多"}, {"type": "subtitle", "time": 13124.15, "timestamp": "03:38:44", "text": "对我来说，导弹更容易保持"}, {"type": "subtitle", "time": 13126.55, "timestamp": "03:38:46", "text": "追踪你。好的。更好的飞机，"}, {"type": "subtitle", "time": 13128.63, "timestamp": "03:38:48", "text": "高级飞机。我来了。做"}, {"type": "subtitle", "time": 13130.389, "timestamp": "03:38:50", "text": "同一件事。"}, {"type": "subtitle", "time": 13133.03, "timestamp": "03:38:53", "text": "当然。"}]
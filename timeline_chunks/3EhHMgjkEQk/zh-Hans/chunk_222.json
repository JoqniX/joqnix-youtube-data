[{"type": "subtitle", "time": 13321.11, "timestamp": "03:42:01", "text": "你知道，有时候人们就是喜欢"}, {"type": "subtitle", "time": 13323.51, "timestamp": "03:42:03", "text": "不要参与任务，直接飞。"}, {"type": "subtitle", "time": 13324.87, "timestamp": "03:42:04", "text": "他们坐在飞机里四处张望……"}, {"type": "subtitle", "time": 13327.75, "timestamp": "03:42:07", "text": "风景。你也可以这样做。哦，是的。"}, {"type": "subtitle", "time": 13332.309, "timestamp": "03:42:12", "text": "他们现在拥有高清画面了。 M"}, {"type": "subtitle", "time": 13333.91, "timestamp": "03:42:13", "text": "当你拥有它时，它非常美丽"}, {"type": "subtitle", "time": 13337.03, "timestamp": "03:42:17", "text": "日出或日落时分，云彩缭绕。"}, {"type": "subtitle", "time": 13339.03, "timestamp": "03:42:19", "text": "啊，你看，光线穿透了"}, {"type": "subtitle", "time": 13340.71, "timestamp": "03:42:20", "text": "云层被遮挡住了"}, {"type": "subtitle", "time": 13347.11, "timestamp": "03:42:27", "text": "好的，我看看能不能创建会话。"}, {"type": "subtitle", "time": 13349.469, "timestamp": "03:42:29", "text": "准备。"}, {"type": "subtitle", "time": 13353.99, "timestamp": "03:42:33", "text": "是的。哦，不。这是图形模式"}, {"type": "subtitle", "time": 13358.63, "timestamp": "03:42:38", "text": "您现在在大厅里，对吗？是的。"}, {"type": "subtitle", "time": 13361.269, "timestamp": "03:42:41", "text": "啊，没错。只是确认一下，免得我们……"}, {"type": "subtitle", "time": 13364.389, "timestamp": "03:42:44", "text": "出现了和上次一样的故障。"}, {"type": "subtitle", "time": 13365.55, "timestamp": "03:42:45", "text": "好的。"}, {"type": "subtitle", "time": 13374.07, "timestamp": "03:42:54", "text": "这？呃，重生后我看到了我的一些作品"}, {"type": "subtitle", "time": 13377.03, "timestamp": "03:42:57", "text": "就像你拥有某样东西一样"}, {"type": "subtitle", "time": 13379.269, "timestamp": "03:42:59", "text": "就像那样，它应该在你的……"}]
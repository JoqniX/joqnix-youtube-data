[{"type": "subtitle", "time": 6421.189, "timestamp": "01:47:01", "text": "根据。"}, {"type": "subtitle", "time": 6423.669, "timestamp": "01:47:03", "text": "你为什么要返回基地？"}, {"type": "subtitle", "time": 6427.109, "timestamp": "01:47:07", "text": "因为维修是免费的。"}, {"type": "subtitle", "time": 6429.51, "timestamp": "01:47:09", "text": "是的，但你没有像……那样受到伤害。"}, {"type": "subtitle", "time": 6433.51, "timestamp": "01:47:13", "text": "全部。我不是"}, {"type": "subtitle", "time": 6436.55, "timestamp": "01:47:16", "text": "我没看到你身上有任何伤痕。是吗？"}, {"type": "subtitle", "time": 6439.109, "timestamp": "01:47:19", "text": "有损坏吗？是的，红色的"}, {"type": "subtitle", "time": 6441.51, "timestamp": "01:47:21", "text": "螺旋桨。"}, {"type": "subtitle", "time": 6443.109, "timestamp": "01:47:23", "text": "螺旋桨上有红色。是的，没问题。"}, {"type": "subtitle", "time": 6446.79, "timestamp": "01:47:26", "text": "没关系。没关系。好的。"}, {"type": "subtitle", "time": 6450.07, "timestamp": "01:47:30", "text": "我什么也没看到。好的。按下 O。"}, {"type": "subtitle", "time": 6454.31, "timestamp": "01:47:34", "text": "让我看看。是的。黄色的。红色的。妈的。"}, {"type": "subtitle", "time": 6455.99, "timestamp": "01:47:35", "text": "是的。是的。返回基地。我的天啊。"}, {"type": "subtitle", "time": 6457.35, "timestamp": "01:47:37", "text": "我没意识到那不是红色。那是"}, {"type": "subtitle", "time": 6460.149, "timestamp": "01:47:40", "text": "黑色的。你没有引擎。"}, {"type": "subtitle", "time": 6462.07, "timestamp": "01:47:42", "text": "我不。你到底在哪儿？你"}, {"type": "subtitle", "time": 6463.51, "timestamp": "01:47:43", "text": "你没有引擎。你是"}, {"type": "subtitle", "time": 6465.03, "timestamp": "01:47:45", "text": "你现在正滑翔在空中，对吧？"}, {"type": "subtitle", "time": 6468.39, "timestamp": "01:47:48", "text": "现在。好的。稍微向下指一点。去"}, {"type": "subtitle", "time": 6470.07, "timestamp": "01:47:50", "text": "径直飞向空军基地，向下指。"}, {"type": "subtitle", "time": 6472.87, "timestamp": "01:47:52", "text": "一点点。空气在哪里？你是"}]
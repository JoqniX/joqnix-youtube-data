[{"type": "subtitle", "time": 15662.229, "timestamp": "04:21:02", "text": "东西。除此之外，《战争雷霆》"}, {"type": "subtitle", "time": 15665.349, "timestamp": "04:21:05", "text": "实际上它有这个东西。你是什​​么"}, {"type": "subtitle", "time": 15669.83, "timestamp": "04:21:09", "text": "那叫什么？呃，现在有比赛了。哦，"}, {"type": "subtitle", "time": 15672.149, "timestamp": "04:21:12", "text": "这样你就能成为职业选手，进入"}, {"type": "subtitle", "time": 15675.71, "timestamp": "04:21:15", "text": "参加锦标赛，那样你就能获得"}, {"type": "subtitle", "time": 15679.67, "timestamp": "04:21:19", "text": "很多。另外，你可以假设你当时在"}, {"type": "subtitle", "time": 15681.429, "timestamp": "04:21:21", "text": "一场比赛，你真的做了些什么。"}, {"type": "subtitle", "time": 15683.469, "timestamp": "04:21:23", "text": "酷，或者一些非常有趣又酷的东西。"}, {"type": "subtitle", "time": 15686.87, "timestamp": "04:21:26", "text": "发生了。你可以查看哪些记录"}, {"type": "subtitle", "time": 15688.469, "timestamp": "04:21:28", "text": "游戏玩法。它没有记录"}, {"type": "subtitle", "time": 15690.95, "timestamp": "04:21:30", "text": "视频。它会记录整个游戏过程。"}, {"type": "subtitle", "time": 15692.63, "timestamp": "04:21:32", "text": "所以在游戏过程中，你可以改变"}, {"type": "subtitle", "time": 15695.429, "timestamp": "04:21:35", "text": "角度、加速、减速游戏"}, {"type": "subtitle", "time": 15697.51, "timestamp": "04:21:37", "text": "玩。您可以换乘另一架飞机"}, {"type": "subtitle", "time": 15699.269, "timestamp": "04:21:39", "text": "一切。"}, {"type": "subtitle", "time": 15702.07, "timestamp": "04:21:42", "text": "这不是视频文件，而是游戏文件。"}, {"type": "subtitle", "time": 15703.75, "timestamp": "04:21:43", "text": "我觉得这很酷。其他"}, {"type": "subtitle", "time": 15705.99, "timestamp": "04:21:45", "text": "游戏也应该这样做。"}, {"type": "subtitle", "time": 15709.51, "timestamp": "04:21:49", "text": "嗯，你可以用 OBS 录制下来。"}, {"type": "subtitle", "time": 15712.149, "timestamp": "04:21:52", "text": "你可以把它发给《战争雷霆》的公关部门。"}, {"type": "subtitle", "time": 15714.71, "timestamp": "04:21:54", "text": "团队。他们有YouTube频道。他们"}, {"type": "subtitle", "time": 15717.51, "timestamp": "04:21:57", "text": "告诉你如何发送给他们。"}, {"type": "subtitle", "time": 15719.91, "timestamp": "04:21:59", "text": "你可以把它发给他们。如果他们认为"}]
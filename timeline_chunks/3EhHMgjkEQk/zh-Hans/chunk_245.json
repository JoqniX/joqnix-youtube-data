[{"type": "subtitle", "time": 14709.11, "timestamp": "04:05:09", "text": "我相信莫希克和一护那帮人。"}, {"type": "subtitle", "time": 14711.51, "timestamp": "04:05:11", "text": "他们也有，我们只是在提及名字而已。"}, {"type": "subtitle", "time": 14713.83, "timestamp": "04:05:13", "text": "这样可以吗？"}, {"type": "subtitle", "time": 14716.63, "timestamp": "04:05:16", "text": "我不太了解直播伦理，但是"}, {"type": "subtitle", "time": 14719.189, "timestamp": "04:05:19", "text": "拍照没问题"}, {"type": "subtitle", "time": 14722.79, "timestamp": "04:05:22", "text": "是的，那两个人已经下载了。"}, {"type": "subtitle", "time": 14725.03, "timestamp": "04:05:25", "text": "我觉得他们还没玩过。"}, {"type": "subtitle", "time": 14727.75, "timestamp": "04:05:27", "text": "Kyra玩过，她很喜欢。"}, {"type": "subtitle", "time": 14731.03, "timestamp": "04:05:31", "text": "我记得她演奏的时候，好像是草莓·基拉"}, {"type": "subtitle", "time": 14735.75, "timestamp": "04:05:35", "text": "呃，赤丸也一起玩过。"}, {"type": "subtitle", "time": 14738.389, "timestamp": "04:05:38", "text": "他们玩的那次玩得很开心。"}, {"type": "subtitle", "time": 14742.389, "timestamp": "04:05:42", "text": "不错的 Mura I 我有点你知道我只是"}, {"type": "subtitle", "time": 14749.189, "timestamp": "04:05:49", "text": "演奏和爵士乐，我得想办法把他拉过来。"}]
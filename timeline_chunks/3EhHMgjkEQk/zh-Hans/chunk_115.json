[{"type": "subtitle", "time": 6907.91, "timestamp": "01:55:07", "text": "上帝。你维修期间，我会负责空中掩护。"}, {"type": "subtitle", "time": 6909.109, "timestamp": "01:55:09", "text": "嘿，不错。你正在着陆"}, {"type": "subtitle", "time": 6914.07, "timestamp": "01:55:14", "text": "实践。是的。现在去四处看看吧。"}, {"type": "subtitle", "time": 6917.27, "timestamp": "01:55:17", "text": "是的，完美。绕一圈。土地"}, {"type": "subtitle", "time": 6920.87, "timestamp": "01:55:20", "text": "长度"}, {"type": "subtitle", "time": 6923.27, "timestamp": "01:55:23", "text": "是的。跑道。"}, {"type": "subtitle", "time": 6950.79, "timestamp": "01:55:50", "text": "我还在挨枪子儿。他们来了"}]
[{"type": "subtitle", "time": 10201.67, "timestamp": "02:50:01", "text": "一旦你落地之后。"}, {"type": "subtitle", "time": 10204.55, "timestamp": "02:50:04", "text": "而且你的时速必须低于400公里。"}, {"type": "subtitle", "time": 10207.269, "timestamp": "02:50:07", "text": "为此。所以从某种意义上说，这架飞机将会是"}, {"type": "subtitle", "time": 10214.71, "timestamp": "02:50:14", "text": "嗯，这不是你的飞行员。"}, {"type": "subtitle", "time": 10217.23, "timestamp": "02:50:17", "text": "喷射。感觉很拖沓"}, {"type": "subtitle", "time": 10226.309, "timestamp": "02:50:26", "text": "刹车。它有点像尿布。它"}, {"type": "subtitle", "time": 10228.309, "timestamp": "02:50:28", "text": "当你达到一定速度时就会出现"}, {"type": "subtitle", "time": 10230.389, "timestamp": "02:50:30", "text": "着陆后，这对你有帮助"}, {"type": "subtitle", "time": 10233.11, "timestamp": "02:50:33", "text": "速度再慢一些，然后就……"}, {"type": "subtitle", "time": 10235.19, "timestamp": "02:50:35", "text": "切断。你装上了一个新的降落伞"}, {"type": "subtitle", "time": 10248.15, "timestamp": "02:50:48", "text": "飞机。壮志凌云：独行侠着陆。壮志凌云"}, {"type": "subtitle", "time": 10249.67, "timestamp": "02:50:49", "text": "特立独行的着陆。你快要崩溃了"}, {"type": "subtitle", "time": 10252.55, "timestamp": "02:50:52", "text": "你的飞机。对你来说，没有平坦的土地。"}, {"type": "subtitle", "time": 10255.51, "timestamp": "02:50:55", "text": "降落。先生，我什么也看不见。"}]
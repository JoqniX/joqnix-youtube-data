[{"type": "subtitle", "time": 9481.59, "timestamp": "02:38:01", "text": "不同的车辆。"}, {"type": "subtitle", "time": 9483.99, "timestamp": "02:38:03", "text": "现在，这次活动即将开始。"}, {"type": "subtitle", "time": 9488.15, "timestamp": "02:38:08", "text": "就在下周，5月22日或24日。"}, {"type": "subtitle", "time": 9490.15, "timestamp": "02:38:10", "text": "那件事挺有意思的。你"}, {"type": "subtitle", "time": 9491.99, "timestamp": "02:38:11", "text": "如果你能投入其中并努力工作，你就能做到。"}, {"type": "subtitle", "time": 9497.19, "timestamp": "02:38:17", "text": "想。好的。那件事就是车辆"}, {"type": "subtitle", "time": 9499.349, "timestamp": "02:38:19", "text": "在该事件中分配，您将获得"}, {"type": "subtitle", "time": 9501.87, "timestamp": "02:38:21", "text": "如果你在那项赛事中成功，那就是印度的赛事。"}, {"type": "subtitle", "time": 9503.55, "timestamp": "02:38:23", "text": "第一的"}, {"type": "subtitle", "time": 9505.91, "timestamp": "02:38:25", "text": "自制飞机，本应是超音速的"}, {"type": "subtitle", "time": 9507.91, "timestamp": "02:38:27", "text": "战斗机。"}, {"type": "subtitle", "time": 9510.95, "timestamp": "02:38:30", "text": "等等，他们居然要加入最新的技术！"}, {"type": "subtitle", "time": 9513.79, "timestamp": "02:38:33", "text": "也一样。这不是最新的版本。它来自"}, {"type": "subtitle", "time": 9517.67, "timestamp": "02:38:37", "text": "1960年代。哇。所以，我们有一架飞机，"}, {"type": "subtitle", "time": 9521.03, "timestamp": "02:38:41", "text": "它在印度设计，并在美国生产。"}, {"type": "subtitle", "time": 9523.27, "timestamp": "02:38:43", "text": "印度。我们没有从其他任何地方购买它。"}, {"type": "subtitle", "time": 9526.63, "timestamp": "02:38:46", "text": "20世纪60年代的国家。"}, {"type": "subtitle", "time": 9529.99, "timestamp": "02:38:49", "text": "哦，所以他们要把那架飞机放进去……"}, {"type": "subtitle", "time": 9532.87, "timestamp": "02:38:52", "text": "事件平面。"}, {"type": "subtitle", "time": 9535.99, "timestamp": "02:38:55", "text": "哦，所以如果你把所有步骤都做完 2"}, {"type": "subtitle", "time": 9537.59, "timestamp": "02:38:57", "text": "天，2天，2天，2天"}, {"type": "subtitle", "time": 9539.11, "timestamp": "02:38:59", "text": "几周后，你就可以免费获得那架飞机了。"}]
[{"type": "subtitle", "time": 1501.75, "timestamp": "00:25:01", "text": "现在感觉很舒服，因为我们彼此了解。"}, {"type": "subtitle", "time": 1504.31, "timestamp": "00:25:04", "text": "之前也和其他成员合作过，所以很容易。"}, {"type": "subtitle", "time": 1506.149, "timestamp": "00:25:06", "text": "合作"}, {"type": "subtitle", "time": 1508.789, "timestamp": "00:25:08", "text": "和新认识的人相处真的太痛苦了。"}, {"type": "subtitle", "time": 1510.51, "timestamp": "00:25:10", "text": "正式的事情"}, {"type": "subtitle", "time": 1513.35, "timestamp": "00:25:13", "text": "现在很多事情，嗯，我有点……"}, {"type": "subtitle", "time": 1515.35, "timestamp": "00:25:15", "text": "我难以适应我所使用的那种正式感。"}, {"type": "subtitle", "time": 1517.83, "timestamp": "00:25:17", "text": "为了做这件事，我想带来"}, {"type": "subtitle", "time": 1521.35, "timestamp": "00:25:21", "text": "周围有人，但我当时就想，是啊，我"}, {"type": "subtitle", "time": 1522.789, "timestamp": "00:25:22", "text": "只是想问问她你想来吗？"}, {"type": "subtitle", "time": 1524.549, "timestamp": "00:25:24", "text": "然后人们就可以来了，我觉得就是这样。"}, {"type": "subtitle", "time": 1527.11, "timestamp": "00:25:27", "text": "它。我不想做那种事。"}, {"type": "subtitle", "time": 1529.669, "timestamp": "00:25:29", "text": "你如何做很多事情"}, {"type": "subtitle", "time": 1534.549, "timestamp": "00:25:34", "text": "就像那样，最近我意识到"}, {"type": "subtitle", "time": 1537.99, "timestamp": "00:25:37", "text": "有些人就像，如果你是"}, {"type": "subtitle", "time": 1540.47, "timestamp": "00:25:40", "text": "数量和方面都比较匮乏"}, {"type": "subtitle", "time": 1542.23, "timestamp": "00:25:42", "text": "对他们来说有点麻烦之类的。"}, {"type": "subtitle", "time": 1544.95, "timestamp": "00:25:44", "text": "哦，你是指整个，就像哦，是"}, {"type": "subtitle", "time": 1547.35, "timestamp": "00:25:47", "text": "你懂我的意思吗？更多的"}, {"type": "subtitle", "time": 1549.83, "timestamp": "00:25:49", "text": "就像跨性别者会说的那样，把它看作是一种"}, {"type": "subtitle", "time": 1551.99, "timestamp": "00:25:51", "text": "事务性协作。并非生意"}, {"type": "subtitle", "time": 1554.87, "timestamp": "00:25:54", "text": "诸如此类的事情。是的。就像一样"}, {"type": "subtitle", "time": 1557.269, "timestamp": "00:25:57", "text": "观众人数等等。"}, {"type": "subtitle", "time": 1559.19, "timestamp": "00:25:59", "text": "是的。是的。是的。我不知道。我"}]
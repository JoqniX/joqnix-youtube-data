[{"type": "subtitle", "time": 9961.269, "timestamp": "02:46:01", "text": "是的，这就是过渡。你要去"}, {"type": "subtitle", "time": 9965.51, "timestamp": "02:46:05", "text": "现在比音速还快。哇。"}, {"type": "subtitle", "time": 9968.15, "timestamp": "02:46:08", "text": "所以，如果你从远处看这架飞机……"}, {"type": "subtitle", "time": 9969.91, "timestamp": "02:46:09", "text": "后面能听到引擎声。什么时候"}, {"type": "subtitle", "time": 9979.11, "timestamp": "02:46:19", "text": "因为你比……快，所以保持沉默"}, {"type": "subtitle", "time": 9987.269, "timestamp": "02:46:27", "text": "哇。"}, {"type": "subtitle", "time": 9989.11, "timestamp": "02:46:29", "text": "现在把摄像头再转回前面。"}, {"type": "subtitle", "time": 9991.79, "timestamp": "02:46:31", "text": "是的。稍微把它翻到顶部。"}, {"type": "subtitle", "time": 9999.83, "timestamp": "02:46:39", "text": "更多的。现在看看你的飞机是什么样子。"}, {"type": "subtitle", "time": 10001.83, "timestamp": "02:46:41", "text": "是的。"}, {"type": "subtitle", "time": 10004.63, "timestamp": "02:46:44", "text": "做得更多。"}, {"type": "subtitle", "time": 10006.79, "timestamp": "02:46:46", "text": "哦，再加一点相机。举起你的"}, {"type": "subtitle", "time": 10010.91, "timestamp": "02:46:50", "text": "相机。好的，完美。现在就去拿你的"}, {"type": "subtitle", "time": 10013.11, "timestamp": "02:46:53", "text": "你必须拿着它。你必须坚持"}, {"type": "subtitle", "time": 10016.15, "timestamp": "02:46:56", "text": "它。是的。现在降低发动机功率"}, {"type": "subtitle", "time": 10017.389, "timestamp": "02:46:57", "text": "到"}, {"type": "subtitle", "time": 10018.99, "timestamp": "02:46:58", "text": "零"}]
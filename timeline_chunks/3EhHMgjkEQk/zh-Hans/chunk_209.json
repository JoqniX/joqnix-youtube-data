[{"type": "subtitle", "time": 12540.63, "timestamp": "03:29:00", "text": "导弹会击中你所在的位置。"}, {"type": "subtitle", "time": 12542.79, "timestamp": "03:29:02", "text": "哦。所以我必须让我的飞机对准目标。"}, {"type": "subtitle", "time": 12545.83, "timestamp": "03:29:05", "text": "在你的飞机上，直到导弹击中你。"}, {"type": "subtitle", "time": 12548.79, "timestamp": "03:29:08", "text": "这是其中之一。"}, {"type": "subtitle", "time": 12550.429, "timestamp": "03:29:10", "text": "另一个"}, {"type": "subtitle", "time": 12554.19, "timestamp": "03:29:14", "text": "其中一个是我拍摄的地方"}, {"type": "subtitle", "time": 12556.55, "timestamp": "03:29:16", "text": "导弹。几秒钟后，"}, {"type": "subtitle", "time": 12558.95, "timestamp": "03:29:18", "text": "导弹有自己的雷达，可以开启"}, {"type": "subtitle", "time": 12561.03, "timestamp": "03:29:21", "text": "距离足够近，可以容纳八个人"}, {"type": "subtitle", "time": 12563.11, "timestamp": "03:29:23", "text": "再见。所以，我不需要保留"}, {"type": "subtitle", "time": 12565.269, "timestamp": "03:29:25", "text": "指着你。我可以直接开枪，"}, {"type": "subtitle", "time": 12567.91, "timestamp": "03:29:27", "text": "你知道，就是逃跑。"}, {"type": "subtitle", "time": 12576.95, "timestamp": "03:29:36", "text": "我选择了另一种导弹。"}, {"type": "subtitle", "time": 12578.79, "timestamp": "03:29:38", "text": "立即装载。我认为我有权利"}, {"type": "subtitle", "time": 12579.95, "timestamp": "03:29:39", "text": "导弹载荷"}, {"type": "subtitle", "time": 12583.19, "timestamp": "03:29:43", "text": "出去。 H"}, {"type": "subtitle", "time": 12587.349, "timestamp": "03:29:47", "text": "等等，你准备好了吗？是的。"}, {"type": "subtitle", "time": 12589.19, "timestamp": "03:29:49", "text": "所有队员尚未准备就绪。什么？"}, {"type": "subtitle", "time": 12591.429, "timestamp": "03:29:51", "text": "为什么一直显示“正在加载”？我在"}, {"type": "subtitle", "time": 12593.83, "timestamp": "03:29:53", "text": "游戏。等等，等等，等等，等等，等等。"}, {"type": "subtitle", "time": 12596.71, "timestamp": "03:29:56", "text": "开始。等等，什么？"}, {"type": "subtitle", "time": 12599.75, "timestamp": "03:29:59", "text": "我在里面。你进去了"}]
[{"type": "subtitle", "time": 12600.87, "timestamp": "03:30:00", "text": "别的什么。那你就得离开了。"}, {"type": "subtitle", "time": 12604.469, "timestamp": "03:30:04", "text": "什么？无论你进去了什么。呃，发生了什么"}, {"type": "subtitle", "time": 12608.389, "timestamp": "03:30:08", "text": "你进去吗？我只需点击“准备就绪”即可。"}, {"type": "subtitle", "time": 12610.95, "timestamp": "03:30:10", "text": "它给你安排了一场比赛。这"}, {"type": "subtitle", "time": 12620.99, "timestamp": "03:30:20", "text": "出去。好的，我们来看看。你在吗？"}, {"type": "subtitle", "time": 12623.429, "timestamp": "03:30:23", "text": "队？是的，你入选了。"}, {"type": "subtitle", "time": 12625.429, "timestamp": "03:30:25", "text": "一切都很好。它说玩家一"}, {"type": "subtitle", "time": 12628.07, "timestamp": "03:30:28", "text": "共64人。"}, {"type": "subtitle", "time": 12629.51, "timestamp": "03:30:29", "text": "哦，你得想办法摆脱那种境地。回去"}, {"type": "subtitle", "time": 12633.51, "timestamp": "03:30:33", "text": "游说。你。它出故障了。"}, {"type": "subtitle", "time": 12636.229, "timestamp": "03:30:36", "text": "我该如何返回大厅？"}, {"type": "subtitle", "time": 12642.309, "timestamp": "03:30:42", "text": "就在左下角美国旁边。"}, {"type": "subtitle", "time": 12645.03, "timestamp": "03:30:45", "text": "好的。"}]
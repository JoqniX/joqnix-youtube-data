[{"type": "subtitle", "time": 12843.279, "timestamp": "03:34:03", "text": "好的。呃，好的。你现在看到这个了吗？ 在你面前？"}, {"type": "subtitle", "time": 12850.309, "timestamp": "03:34:10", "text": "什么？我在找。哦，我仍然相当"}, {"type": "subtitle", "time": 12853.91, "timestamp": "03:34:13", "text": "远非“还可以”。搞什么鬼？"}, {"type": "subtitle", "time": 12856.55, "timestamp": "03:34:16", "text": "这也是渲染距离。我懂了"}, {"type": "subtitle", "time": 12859.429, "timestamp": "03:34:19", "text": "这是我们正在关注的事情，对吧？等待，"}, {"type": "subtitle", "time": 12862.07, "timestamp": "03:34:22", "text": "发生了什么？"}, {"type": "subtitle", "time": 12865.59, "timestamp": "03:34:25", "text": "比如发生车祸之类的。坠机地点在哪里？"}, {"type": "subtitle", "time": 12867.03, "timestamp": "03:34:27", "text": "哦，不，不，不，不。我不小心看到了"}, {"type": "subtitle", "time": 12869.75, "timestamp": "03:34:29", "text": "你之前的直播流。好吧，总之。"}, {"type": "subtitle", "time": 12873.349, "timestamp": "03:34:33", "text": "等待。所以，抬头看看。我看见你。你看"}, {"type": "subtitle", "time": 12876.63, "timestamp": "03:34:36", "text": "我？是的，我现在真的快完成了。所以，我是"}, {"type": "subtitle", "time": 12880.63, "timestamp": "03:34:40", "text": "大概离你3公里远吧？"}, {"type": "subtitle", "time": 12883.99, "timestamp": "03:34:43", "text": "距离3至4公里。我可以带你出去"}, {"type": "subtitle", "time": 12886.95, "timestamp": "03:34:46", "text": "超过这个范围的两倍或三倍"}, {"type": "subtitle", "time": 12890.95, "timestamp": "03:34:50", "text": "只需一把枪就能轻松做到。不，我的"}, {"type": "subtitle", "time": 12892.55, "timestamp": "03:34:52", "text": "导弹。"}, {"type": "chat", "time": 12893.839, "timestamp": "03:34:53", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "we see da fuji"}, {"type": "subtitle", "time": 12894.95, "timestamp": "03:34:54", "text": "我可以向你开枪。我离那里大概5公里。"}, {"type": "subtitle", "time": 12896.55, "timestamp": "03:34:56", "text": "是你，对吧？我可以从这里向你开枪"}, {"type": "subtitle", "time": 12899.349, "timestamp": "03:34:59", "text": "距离35公里。"}]
[{"type": "subtitle", "time": 15061.11, "timestamp": "04:11:01", "text": "那是一架速度很慢的喷气式轰炸机。好的，我需要"}, {"type": "subtitle", "time": 15063.11, "timestamp": "04:11:03", "text": "改变这种情况。所以，你拥有了一切"}, {"type": "subtitle", "time": 15065.75, "timestamp": "04:11:05", "text": "这些选项。不要选择直升机"}, {"type": "subtitle", "time": 15068.63, "timestamp": "04:11:08", "text": "因为或者因为你需要坦克才能前进。"}, {"type": "subtitle", "time": 15070.71, "timestamp": "04:11:10", "text": "乘坐直升机。你不会飞"}, {"type": "subtitle", "time": 15073.11, "timestamp": "04:11:13", "text": "直升机单独行动。要么就这么做"}, {"type": "subtitle", "time": 15076.07, "timestamp": "04:11:16", "text": "坦克或喷气式飞机。"}, {"type": "subtitle", "time": 15079.429, "timestamp": "04:11:19", "text": "哦，这是一辆印度坦克。哇。是的，"}, {"type": "subtitle", "time": 15081.03, "timestamp": "04:11:21", "text": "这是一辆在印度的俄罗斯坦克。"}, {"type": "subtitle", "time": 15083.309, "timestamp": "04:11:23", "text": "军队"}, {"type": "subtitle", "time": 15086.229, "timestamp": "04:11:26", "text": "服务。有一架印度飞机"}, {"type": "subtitle", "time": 15088.71, "timestamp": "04:11:28", "text": "嗯，但我认为它不在中队里。"}, {"type": "subtitle", "time": 15091.189, "timestamp": "04:11:31", "text": "一。它被单独列为一个事件"}, {"type": "subtitle", "time": 15093.11, "timestamp": "04:11:33", "text": "车辆。"}, {"type": "subtitle", "time": 15095.99, "timestamp": "04:11:35", "text": "所以，中间那架蓝色的飞机，"}, {"type": "subtitle", "time": 15098.389, "timestamp": "04:11:38", "text": "我现在用的就是这个。"}, {"type": "subtitle", "time": 15101.11, "timestamp": "04:11:41", "text": "哦，所以我每两天就跟你说对了"}, {"type": "subtitle", "time": 15103.349, "timestamp": "04:11:43", "text": "如果你这样做，大概能得到 18,000 到 20,000 美元。"}, {"type": "subtitle", "time": 15105.51, "timestamp": "04:11:45", "text": "你和你的团队都非常完美"}, {"type": "subtitle", "time": 15108.87, "timestamp": "04:11:48", "text": "活动安排得恰到好处。"}, {"type": "subtitle", "time": 15111.59, "timestamp": "04:11:51", "text": "你看，那些500、80或者其他什么数字"}, {"type": "subtitle", "time": 15113.91, "timestamp": "04:11:53", "text": "数据如下。任选其一。"}, {"type": "subtitle", "time": 15118.87, "timestamp": "04:11:58", "text": "是的。你看到580了吗？不。是的。是的。 580."}]
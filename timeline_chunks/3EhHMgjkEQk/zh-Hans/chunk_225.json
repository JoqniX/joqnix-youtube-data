[{"type": "subtitle", "time": 13502.95, "timestamp": "03:45:02", "text": "你知道，就现实主义而言，"}, {"type": "subtitle", "time": 13504.71, "timestamp": "03:45:04", "text": "如果你一直这样做，你的飞机可能会失速。"}, {"type": "subtitle", "time": 13511.99, "timestamp": "03:45:11", "text": "向上。而且我可以一直凌驾于你之上。"}, {"type": "subtitle", "time": 13513.75, "timestamp": "03:45:13", "text": "啊，"}, {"type": "subtitle", "time": 13523.189, "timestamp": "03:45:23", "text": "等等，你在哪里？那我就可以做了"}, {"type": "subtitle", "time": 13530.07, "timestamp": "03:45:30", "text": "我的天啊。"}, {"type": "chat", "time": 13530.395, "timestamp": "03:45:30", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "flying around at the speed of sound"}, {"type": "subtitle", "time": 13533.67, "timestamp": "03:45:33", "text": "你简直把我的飞机左舷弄坏了。"}, {"type": "subtitle", "time": 13535.269, "timestamp": "03:45:35", "text": "我刚才已经告诉过你，我可以待在你上面。我"}, {"type": "chat", "time": 13536.773, "timestamp": "03:45:36", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "rip no wing"}, {"type": "subtitle", "time": 13538.309, "timestamp": "03:45:38", "text": "比你高出一筹。你当时指着上方。哦"}, {"type": "subtitle", "time": 13546.07, "timestamp": "03:45:46", "text": "上帝。哦，你想让我做吗？"}, {"type": "subtitle", "time": 13549.11, "timestamp": "03:45:49", "text": "对你来说，登上新飞机的速度更快吗？"}, {"type": "subtitle", "time": 13551.91, "timestamp": "03:45:51", "text": "哦，对。哦，那是指你。"}, {"type": "subtitle", "time": 13555.03, "timestamp": "03:45:55", "text": "想杀了我。哦好的。不。"}, {"type": "subtitle", "time": 13556.95, "timestamp": "03:45:56", "text": "我的意思是，你会开它吗？还是你只是个摆设？"}, {"type": "subtitle", "time": 13558.63, "timestamp": "03:45:58", "text": "会慢慢坠落到地面吗？不，"}]
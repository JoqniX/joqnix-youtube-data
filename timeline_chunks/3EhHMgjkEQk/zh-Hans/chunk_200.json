[{"type": "subtitle", "time": 12004.229, "timestamp": "03:20:04", "text": "等等。哦，对，就是那个"}, {"type": "subtitle", "time": 12006.389, "timestamp": "03:20:06", "text": "现在操控感觉有点……嗯。是的。"}, {"type": "subtitle", "time": 12008.55, "timestamp": "03:20:08", "text": "是的。你可以胡乱挥舞手臂，但是"}, {"type": "subtitle", "time": 12009.83, "timestamp": "03:20:09", "text": "你现在肩负重任。"}, {"type": "subtitle", "time": 12012.55, "timestamp": "03:20:12", "text": "让你再次清除炸弹。如何"}, {"type": "subtitle", "time": 12015.07, "timestamp": "03:20:15", "text": "清除大部分所有"}, {"type": "subtitle", "time": 12019.11, "timestamp": "03:20:19", "text": "炸弹。如何摆脱所有这些？"}, {"type": "subtitle", "time": 12020.63, "timestamp": "03:20:20", "text": "是的，有个按钮可以实现这个功能，但是"}, {"type": "subtitle", "time": 12021.75, "timestamp": "03:20:21", "text": "再说一遍，你得去寻找……"}, {"type": "subtitle", "time": 12036.19, "timestamp": "03:20:36", "text": "没关系。你会遇到困难"}, {"type": "subtitle", "time": 12038.469, "timestamp": "03:20:38", "text": "它。离开。我会用定制的方式给你展示。"}, {"type": "subtitle", "time": 12048.389, "timestamp": "03:20:48", "text": "现在，这会有点奇怪，因为你会"}, {"type": "subtitle", "time": 12051.67, "timestamp": "03:20:51", "text": "我会在一架螺旋桨飞机里。"}, {"type": "subtitle", "time": 12056.469, "timestamp": "03:20:56", "text": "就像上世纪90年代的喷气式飞机。一架巨型战斗机。"}, {"type": "subtitle", "time": 12058.95, "timestamp": "03:20:58", "text": "哦，"}]
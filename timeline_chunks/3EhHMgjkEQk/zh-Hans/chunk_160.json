[{"type": "subtitle", "time": 9600.469, "timestamp": "02:40:00", "text": "底部你看到的是红色的拉斐尔。"}, {"type": "subtitle", "time": 9602.469, "timestamp": "02:40:02", "text": "是的。拉斐尔。"}, {"type": "subtitle", "time": 9607.07, "timestamp": "02:40:07", "text": "点击那里。点击预览。"}, {"type": "subtitle", "time": 9615.91, "timestamp": "02:40:15", "text": "这是最新型的高科技"}, {"type": "subtitle", "time": 9617.55, "timestamp": "02:40:17", "text": "某种喷气式飞机"}, {"type": "subtitle", "time": 9620.63, "timestamp": "02:40:20", "text": "这架飞机仍然是全新的。"}, {"type": "subtitle", "time": 9622.87, "timestamp": "02:40:22", "text": "在许多空军中飞行，包括"}, {"type": "subtitle", "time": 9624.63, "timestamp": "02:40:24", "text": "印度空军。它正在飞行"}, {"type": "subtitle", "time": 9626.75, "timestamp": "02:40:26", "text": "印度人、法国人、"}, {"type": "subtitle", "time": 9630.07, "timestamp": "02:40:30", "text": "卡塔尔人，我相信还有埃及人。我不是"}, {"type": "subtitle", "time": 9631.429, "timestamp": "02:40:31", "text": "当然，如果它在埃及航空飞行的话。"}, {"type": "subtitle", "time": 9633.429, "timestamp": "02:40:33", "text": "力量，但它像四五英里/小时那样飞行吗？"}, {"type": "subtitle", "time": 9636.95, "timestamp": "02:40:36", "text": "空军现在。这是目前的状况。"}, {"type": "subtitle", "time": 9639.03, "timestamp": "02:40:39", "text": "技术。"}, {"type": "subtitle", "time": 9644.389, "timestamp": "02:40:44", "text": "所以，如果你，你知道，献出你的生命"}, {"type": "subtitle", "time": 9647.11, "timestamp": "02:40:47", "text": "而不是献给撒旦或任何其他类似的东西"}, {"type": "subtitle", "time": 9650.389, "timestamp": "02:40:50", "text": "天使，如果你将生命献给神"}, {"type": "subtitle", "time": 9654.07, "timestamp": "02:40:54", "text": "《战争雷霆》的运行速度慢得像蜗牛。"}, {"type": "subtitle", "time": 9657.19, "timestamp": "02:40:57", "text": "蜗牛？是的，它真的是一只蜗牛。"}, {"type": "subtitle", "time": 9659.429, "timestamp": "02:40:59", "text": "所以，拥有 War 的母公司"}]
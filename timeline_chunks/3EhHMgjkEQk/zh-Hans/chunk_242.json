[{"type": "subtitle", "time": 14520.389, "timestamp": "04:02:00", "text": "你。我们去其他城市吧。其他城市。"}, {"type": "subtitle", "time": 14523.269, "timestamp": "04:02:03", "text": "好的。是的，我在那里。好的。你会看到"}, {"type": "subtitle", "time": 14526.389, "timestamp": "04:02:06", "text": "我真的会从你旁边进去。"}, {"type": "subtitle", "time": 14541.03, "timestamp": "04:02:21", "text": "该死。这其实是个好城市。这"}, {"type": "subtitle", "time": 14543.99, "timestamp": "04:02:23", "text": "下一个。好吧，你飞过去，然后走公路。"}, {"type": "subtitle", "time": 14545.75, "timestamp": "04:02:25", "text": "我会尽量从你前面进来。"}, {"type": "subtitle", "time": 14548.63, "timestamp": "04:02:28", "text": "笔直的道路。"}, {"type": "subtitle", "time": 14553.429, "timestamp": "04:02:33", "text": "哦，等等。这样做。送路。"}, {"type": "subtitle", "time": 14564.59, "timestamp": "04:02:44", "text": "未来。有点太过了"}, {"type": "subtitle", "time": 14567.429, "timestamp": "04:02:47", "text": "紧的。哦，"}, {"type": "subtitle", "time": 14572.79, "timestamp": "04:02:52", "text": "去。我设法钻到了你身下。"}]
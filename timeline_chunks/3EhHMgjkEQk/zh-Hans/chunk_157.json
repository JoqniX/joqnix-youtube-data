[{"type": "subtitle", "time": 9421.429, "timestamp": "02:37:01", "text": "免费加入中队，战争"}, {"type": "subtitle", "time": 9423.51, "timestamp": "02:37:03", "text": "雷霆队也有这种行为，他们"}, {"type": "subtitle", "time": 9426.389, "timestamp": "02:37:06", "text": "他们举办活动，也提供活动用车。"}, {"type": "subtitle", "time": 9429.349, "timestamp": "02:37:09", "text": "所以，下一个活动将在不久后举行。"}, {"type": "subtitle", "time": 9433.19, "timestamp": "02:37:13", "text": "天。下周就开始了"}, {"type": "subtitle", "time": 9437.349, "timestamp": "02:37:17", "text": "我相信这种情况持续了两周。"}, {"type": "subtitle", "time": 9440.55, "timestamp": "02:37:20", "text": "现在，在这两周内，每两天你"}, {"type": "subtitle", "time": 9442.79, "timestamp": "02:37:22", "text": "必须玩《战争雷霆》"}, {"type": "subtitle", "time": 9446.23, "timestamp": "02:37:26", "text": "足以填满经验条的数值。"}, {"type": "subtitle", "time": 9447.83, "timestamp": "02:37:27", "text": "圣。"}, {"type": "subtitle", "time": 9451.27, "timestamp": "02:37:31", "text": "你必须达到最低限度。"}, {"type": "subtitle", "time": 9453.83, "timestamp": "02:37:33", "text": "就像你获得了及格分数一样。这"}, {"type": "subtitle", "time": 9458.87, "timestamp": "02:37:38", "text": "及格分数大概是 80% 到 90%。"}, {"type": "subtitle", "time": 9461.11, "timestamp": "02:37:41", "text": "所以每隔两天你就得玩一次。"}, {"type": "subtitle", "time": 9464.55, "timestamp": "02:37:44", "text": "足以达到并跨越那个横杆。"}, {"type": "subtitle", "time": 9470.87, "timestamp": "02:37:50", "text": "次数，也就是大约16天，所以"}, {"type": "subtitle", "time": 9473.389, "timestamp": "02:37:53", "text": "大约两天多一点，两个"}, {"type": "subtitle", "time": 9477.349, "timestamp": "02:37:57", "text": "几周后，你就能拿到活动用车了。"}, {"type": "subtitle", "time": 9479.51, "timestamp": "02:37:59", "text": "每次 WAN 广播它时，它都是一个"}]
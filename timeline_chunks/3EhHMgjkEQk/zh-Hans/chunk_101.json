[{"type": "subtitle", "time": 6061.35, "timestamp": "01:41:01", "text": "所以，你的账号没有丢失？哦，"}, {"type": "subtitle", "time": 6068.229, "timestamp": "01:41:08", "text": "我的账号确实被封了。我不会"}, {"type": "subtitle", "time": 6076.07, "timestamp": "01:41:16", "text": "好的。该死。等等，我想进入一个"}, {"type": "subtitle", "time": 6077.75, "timestamp": "01:41:17", "text": "匹配。是的。是的。哦，等等，等等，等等"}, {"type": "subtitle", "time": 6079.189, "timestamp": "01:41:19", "text": "等待。我不小心点到了什么东西。"}, {"type": "subtitle", "time": 6081.35, "timestamp": "01:41:21", "text": "糟糕。如何划掉，但是如果"}, {"type": "subtitle", "time": 6082.629, "timestamp": "01:41:22", "text": "你已经在比赛里了，我可以走了。"}, {"type": "subtitle", "time": 6084.47, "timestamp": "01:41:24", "text": "你通过了。没关系。我能看出这一点"}, {"type": "subtitle", "time": 6087.75, "timestamp": "01:41:27", "text": "即时的。不，不，不，不，不。"}, {"type": "subtitle", "time": 6090.07, "timestamp": "01:41:30", "text": "那样你就没法和日本队比赛了。"}, {"type": "subtitle", "time": 6091.83, "timestamp": "01:41:31", "text": "什么？"}, {"type": "subtitle", "time": 6093.99, "timestamp": "01:41:33", "text": "是啊，因为这就像你退出了……"}, {"type": "subtitle", "time": 6097.59, "timestamp": "01:41:37", "text": "在做任何事情之前先进行匹配。"}, {"type": "subtitle", "time": 6099.99, "timestamp": "01:41:39", "text": "你可以玩这三个平面，但是"}, {"type": "subtitle", "time": 6101.59, "timestamp": "01:41:41", "text": "另外两架飞机，都被锁在外面了。"}, {"type": "subtitle", "time": 6103.59, "timestamp": "01:41:43", "text": "大概持续了5分钟。"}, {"type": "subtitle", "time": 6106.31, "timestamp": "01:41:46", "text": "这是一个非常有效的系统，非常有效。"}, {"type": "subtitle", "time": 6108.39, "timestamp": "01:41:48", "text": "深入的系统。"}, {"type": "subtitle", "time": 6114.149, "timestamp": "01:41:54", "text": "为什么以色列真的很酷"}, {"type": "subtitle", "time": 6116.87, "timestamp": "01:41:56", "text": "飞机？呃，点击搜索，你就会"}]
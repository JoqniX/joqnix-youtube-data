[{"type": "subtitle", "time": 16141.269, "timestamp": "04:29:01", "text": "我也觉得他来得晚了一些。"}, {"type": "subtitle", "time": 16143.11, "timestamp": "04:29:03", "text": "然后他们意识到，哦，这有点像……"}, {"type": "subtitle", "time": 16145.349, "timestamp": "04:29:05", "text": "如果觉得无聊，我们会添加更多国家。"}, {"type": "subtitle", "time": 16147.03, "timestamp": "04:29:07", "text": "所以他们把以色列等国家也加了进去。"}, {"type": "subtitle", "time": 16148.59, "timestamp": "04:29:08", "text": "瑞典，"}, {"type": "subtitle", "time": 16150.87, "timestamp": "04:29:10", "text": "中国。然后他们就说，哦，我们想……"}, {"type": "subtitle", "time": 16152.07, "timestamp": "04:29:12", "text": "增加更多国家，但他们不想。"}, {"type": "subtitle", "time": 16153.99, "timestamp": "04:29:13", "text": "为了填满酒吧，他们意识到"}, {"type": "subtitle", "time": 16155.79, "timestamp": "04:29:15", "text": "很多这样的"}, {"type": "subtitle", "time": 16158.63, "timestamp": "04:29:18", "text": "各国的整个舰队"}, {"type": "subtitle", "time": 16161.269, "timestamp": "04:29:21", "text": "从其他公司购买的现有飞机"}, {"type": "subtitle", "time": 16165.269, "timestamp": "04:29:25", "text": "已经参与游戏的国家。"}, {"type": "subtitle", "time": 16168.469, "timestamp": "04:29:28", "text": "所以他们做了一件叫做子树的事情。"}, {"type": "subtitle", "time": 16171.83, "timestamp": "04:29:31", "text": "如果你在英国之下打开英国，那会怎样？"}, {"type": "subtitle", "time": 16175.67, "timestamp": "04:29:35", "text": "你会找到印度科技树。这"}, {"type": "subtitle", "time": 16177.63, "timestamp": "04:29:37", "text": "整张地图"}, {"type": "subtitle", "time": 16180.469, "timestamp": "04:29:40", "text": "矩形上带有平面，这是一个"}, {"type": "subtitle", "time": 16184.79, "timestamp": "04:29:44", "text": "科技树。这是什么Gaen市场？"}, {"type": "subtitle", "time": 16187.99, "timestamp": "04:29:47", "text": "Gajun市场不适合我们这些免费玩家。"}, {"type": "subtitle", "time": 16190.63, "timestamp": "04:29:50", "text": "除非你打算"}, {"type": "subtitle", "time": 16191.71, "timestamp": "04:29:51", "text": "在哪里？"}, {"type": "subtitle", "time": 16194.229, "timestamp": "04:29:54", "text": "技术？这就是技术。你正在看"}, {"type": "subtitle", "time": 16195.91, "timestamp": "04:29:55", "text": "科技树。整件事就是"}, {"type": "subtitle", "time": 16198.389, "timestamp": "04:29:58", "text": "科技树。哦，原来这就是全部内容。"}]
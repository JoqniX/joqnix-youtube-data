[{"type": "subtitle", "time": 10028.79, "timestamp": "02:47:08", "text": "它。保持摄像机角度不变。"}, {"type": "subtitle", "time": 10031.11, "timestamp": "02:47:11", "text": "好的。"}, {"type": "subtitle", "time": 10033.83, "timestamp": "02:47:13", "text": "击中H。如果我不是的话，H应该是空气胸罩。"}, {"type": "subtitle", "time": 10049.91, "timestamp": "02:47:29", "text": "他们会根据情况改变位置"}, {"type": "subtitle", "time": 10052.309, "timestamp": "02:47:32", "text": "你很快就能做到"}, {"type": "subtitle", "time": 10054.389, "timestamp": "02:47:34", "text": "机动性强，易于飞行"}, {"type": "subtitle", "time": 10057.51, "timestamp": "02:47:37", "text": "速度。关闭。是的。所以，在低速行驶时，"}, {"type": "subtitle", "time": 10059.67, "timestamp": "02:47:39", "text": "翅膀可以展开，这样你就可以转动了。"}, {"type": "subtitle", "time": 10062.07, "timestamp": "02:47:42", "text": "更好的。高速飞行时，机翼会……"}, {"type": "subtitle", "time": 10064.15, "timestamp": "02:47:44", "text": "回去，这样他们就不会给你太多。"}, {"type": "subtitle", "time": 10070.07, "timestamp": "02:47:50", "text": "如果改变相机角度，你就可以看到"}, {"type": "subtitle", "time": 10072.71, "timestamp": "02:47:52", "text": "你的气垫胸罩看起来也有点……"}]
[{"type": "subtitle", "time": 16201.83, "timestamp": "04:30:01", "text": "弹出窗口是科技树。哦，所以"}, {"type": "subtitle", "time": 16205.75, "timestamp": "04:30:05", "text": "如果你向下滚动，会发现英国人"}, {"type": "subtitle", "time": 16208.389, "timestamp": "04:30:08", "text": "你在高级版上能看到它们，你会看到捷豹。"}, {"type": "subtitle", "time": 16212.71, "timestamp": "04:30:12", "text": "然后你会看到最后一个在下面。"}, {"type": "subtitle", "time": 16216.26, "timestamp": "04:30:16", "text": "21头大野牛。是的，都是印度人。"}, {"type": "subtitle", "time": 16217.91, "timestamp": "04:30:17", "text": "[音乐]"}, {"type": "subtitle", "time": 16221.91, "timestamp": "04:30:21", "text": "许多其他国家也是如此，并非如此。"}, {"type": "subtitle", "time": 16223.59, "timestamp": "04:30:23", "text": "仅在部分国家/地区提供高级服务"}, {"type": "subtitle", "time": 16227.349, "timestamp": "04:30:27", "text": "标准科技树中也有。"}, {"type": "subtitle", "time": 16230.71, "timestamp": "04:30:30", "text": "比如说，你在哪里可以弄到一架飞机？"}, {"type": "subtitle", "time": 16233.429, "timestamp": "04:30:33", "text": "罗马尼亚，我觉得它就在……"}, {"type": "subtitle", "time": 16236.87, "timestamp": "04:30:36", "text": "意大利科技树之类的"}, {"type": "subtitle", "time": 16238.87, "timestamp": "04:30:38", "text": "罗马尼亚现在不是一个大国，但是"}, {"type": "subtitle", "time": 16240.309, "timestamp": "04:30:40", "text": "他们有很多飞机想要增加"}]
[{"type": "subtitle", "time": 12180.87, "timestamp": "03:23:00", "text": "现在，我会比以前快得多地赶到你那里。"}, {"type": "subtitle", "time": 12189.51, "timestamp": "03:23:09", "text": "速度再次提升。另外，我相信我有一个"}, {"type": "subtitle", "time": 12196.55, "timestamp": "03:23:16", "text": "你在哪里？"}, {"type": "subtitle", "time": 12204.87, "timestamp": "03:23:24", "text": "你好。哦，你看不见我。为什么？为什么"}, {"type": "subtitle", "time": 12219.79, "timestamp": "03:23:39", "text": "战斗"}, {"type": "subtitle", "time": 12222.229, "timestamp": "03:23:42", "text": "男生？好的。不要因为想开枪就开枪"}, {"type": "subtitle", "time": 12225.95, "timestamp": "03:23:45", "text": "看看这东西飞得怎么样。"}, {"type": "subtitle", "time": 12229.349, "timestamp": "03:23:49", "text": "啊。就像你关闭引擎一样吗？"}, {"type": "subtitle", "time": 12231.91, "timestamp": "03:23:51", "text": "你喜欢吗？哦，我还没做过呢。"}, {"type": "subtitle", "time": 12233.83, "timestamp": "03:23:53", "text": "我还没做。我只是在飞。"}, {"type": "subtitle", "time": 12237.11, "timestamp": "03:23:57", "text": "目前一切正常。好的。好的。好的。"}, {"type": "subtitle", "time": 12239.429, "timestamp": "03:23:59", "text": "这架飞机通常能做到这一点。"}]
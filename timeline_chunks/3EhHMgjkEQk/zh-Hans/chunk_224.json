[{"type": "subtitle", "time": 13440.63, "timestamp": "03:44:00", "text": "是无限的，对吗？ 3秒。是的，"}, {"type": "subtitle", "time": 13442.95, "timestamp": "03:44:02", "text": "这是无限的。"}, {"type": "subtitle", "time": 13445.91, "timestamp": "03:44:05", "text": "好的。"}, {"type": "subtitle", "time": 13448.469, "timestamp": "03:44:08", "text": "我已将响应时间设置为无限制。"}, {"type": "subtitle", "time": 13450.15, "timestamp": "03:44:10", "text": "但时间有限。我们得到"}, {"type": "subtitle", "time": 13452.95, "timestamp": "03:44:12", "text": "等等，飞机不会"}, {"type": "subtitle", "time": 13455.189, "timestamp": "03:44:15", "text": "休息一下，对吧？"}, {"type": "subtitle", "time": 13456.469, "timestamp": "03:44:16", "text": "飞机要出故障了。你可以直接"}, {"type": "subtitle", "time": 13458.79, "timestamp": "03:44:18", "text": "在同一平面上重生。我认为"}, {"type": "subtitle", "time": 13461.429, "timestamp": "03:44:21", "text": "应该就是这样。"}, {"type": "subtitle", "time": 13463.91, "timestamp": "03:44:23", "text": "事实就是如此。现在比赛开始了。"}, {"type": "subtitle", "time": 13466.309, "timestamp": "03:44:26", "text": "时间仍然有限。好的。我们不"}, {"type": "subtitle", "time": 13468.389, "timestamp": "03:44:28", "text": "获得无限时间。我们获得无限量供应"}, {"type": "subtitle", "time": 13470.309, "timestamp": "03:44:30", "text": "重生。"}, {"type": "subtitle", "time": 13472.389, "timestamp": "03:44:32", "text": "明白了。"}, {"type": "subtitle", "time": 13474.15, "timestamp": "03:44:34", "text": "你想让我做什么？什么情况"}, {"type": "subtitle", "time": 13476.469, "timestamp": "03:44:36", "text": "你想让我玩吗？我会来战斗"}, {"type": "subtitle", "time": 13482.79, "timestamp": "03:44:42", "text": "你想让我反击吗？我们"}, {"type": "subtitle", "time": 13484.63, "timestamp": "03:44:44", "text": "当然你可以使用你的枪支，不是吗？"}, {"type": "subtitle", "time": 13486.95, "timestamp": "03:44:46", "text": "导弹？"}, {"type": "subtitle", "time": 13488.11, "timestamp": "03:44:48", "text": "这就是你"}, {"type": "subtitle", "time": 13490.03, "timestamp": "03:44:50", "text": "意思是。我"}, {"type": "subtitle", "time": 13492.79, "timestamp": "03:44:52", "text": "看。如果我早知道，我就会……"}, {"type": "subtitle", "time": 13495.269, "timestamp": "03:44:55", "text": "只是没装到我的导弹上。只是"}]
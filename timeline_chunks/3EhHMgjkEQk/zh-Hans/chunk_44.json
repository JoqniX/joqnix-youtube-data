[{"type": "subtitle", "time": 2643.03, "timestamp": "00:44:03", "text": "比如，“哦，我喜欢玩舰船游戏。”"}, {"type": "subtitle", "time": 2645.309, "timestamp": "00:44:05", "text": "就是这样。他们"}, {"type": "subtitle", "time": 2647.99, "timestamp": "00:44:07", "text": "是的，他们仍然试图做他们的事情"}, {"type": "subtitle", "time": 2651.55, "timestamp": "00:44:11", "text": "船舶用品。很好"}, {"type": "subtitle", "time": 2656.23, "timestamp": "00:44:16", "text": "他们。不够。哦，等等。呃，你需要"}, {"type": "subtitle", "time": 2658.95, "timestamp": "00:44:18", "text": "也加入。我该如何让你加入？"}, {"type": "subtitle", "time": 2666.109, "timestamp": "00:44:26", "text": "中队。"}, {"type": "subtitle", "time": 2669.63, "timestamp": "00:44:29", "text": "呃，等等。我不是邀请过你吗？哦，"}, {"type": "subtitle", "time": 2673.19, "timestamp": "00:44:33", "text": "等待。哦，我从来没邀请过你。我的错。我"}, {"type": "subtitle", "time": 2677.03, "timestamp": "00:44:37", "text": "又收到邀请了。好的。"}, {"type": "subtitle", "time": 2679.43, "timestamp": "00:44:39", "text": "是的，我刚刚加你了。我忘了"}, {"type": "subtitle", "time": 2681.069, "timestamp": "00:44:41", "text": "邀请您进来"}, {"type": "subtitle", "time": 2686.55, "timestamp": "00:44:46", "text": "好的，现在我可以了。就这样。"}, {"type": "subtitle", "time": 2687.71, "timestamp": "00:44:47", "text": "好了。"}, {"type": "subtitle", "time": 2698.309, "timestamp": "00:44:58", "text": "零场战斗。 Z：不，我不认为我……"}, {"type": "subtitle", "time": 2699.91, "timestamp": "00:44:59", "text": "玩过。至少在这个账户里不是这样。"}]
[{"type": "subtitle", "time": 2522.79, "timestamp": "00:42:02", "text": "就像他们所有人一样。更像是"}, {"type": "subtitle", "time": 2525.19, "timestamp": "00:42:05", "text": "随你喜欢，然后如果你……"}, {"type": "subtitle", "time": 2527.77, "timestamp": "00:42:07", "text": "想做其他你能做的事情吗？"}, {"type": "subtitle", "time": 2529.43, "timestamp": "00:42:09", "text": "[音乐]"}, {"type": "subtitle", "time": 2531.19, "timestamp": "00:42:11", "text": "一般来说，只有像tryh hard这样的事情才会发生。"}, {"type": "subtitle", "time": 2533.589, "timestamp": "00:42:13", "text": "喜欢一切的人"}, {"type": "subtitle", "time": 2536.15, "timestamp": "00:42:16", "text": "通常情况下，即使如此，人们也倾向于给予"}, {"type": "subtitle", "time": 2539.15, "timestamp": "00:42:19", "text": "起来，然后就……"}, {"type": "subtitle", "time": 2544.55, "timestamp": "00:42:24", "text": "比如购买付费版本。"}, {"type": "subtitle", "time": 2550.39, "timestamp": "00:42:30", "text": "等到最后再做决定是值得的。"}, {"type": "subtitle", "time": 2553.67, "timestamp": "00:42:33", "text": "天。是的。等等，这个游戏允许吗？"}, {"type": "subtitle", "time": 2557.99, "timestamp": "00:42:37", "text": "那是真正的飞行装备吗？"}, {"type": "subtitle", "time": 2560.63, "timestamp": "00:42:40", "text": "你确实有一个实际的模拟模式"}, {"type": "subtitle", "time": 2563.43, "timestamp": "00:42:43", "text": "我不会推荐这样做，因为在我看来"}, {"type": "subtitle", "time": 2566.79, "timestamp": "00:42:46", "text": "我玩《战争雷霆》的人生"}, {"type": "subtitle", "time": 2570.79, "timestamp": "00:42:50", "text": "哦，这里有个飞行控制教程。"}, {"type": "subtitle", "time": 2574.15, "timestamp": "00:42:54", "text": "两三次。这里有一个教程"}, {"type": "subtitle", "time": 2576.79, "timestamp": "00:42:56", "text": "飞行就像驾驶飞机一样。我应该吗？"}]
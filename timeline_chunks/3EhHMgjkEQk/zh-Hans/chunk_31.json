[{"type": "subtitle", "time": 1862.95, "timestamp": "00:31:02", "text": "人们过去常去的地方，就像一口井"}, {"type": "subtitle", "time": 1864.63, "timestamp": "00:31:04", "text": "也许是父母或祖父母，我不知道。"}, {"type": "subtitle", "time": 1867.269, "timestamp": "00:31:07", "text": "知道。人们过去常常去某个人家"}, {"type": "subtitle", "time": 1870.71, "timestamp": "00:31:10", "text": "回家给亲戚打电话。就像一个"}, {"type": "subtitle", "time": 1873.269, "timestamp": "00:31:13", "text": "五组房子将各有一个"}, {"type": "subtitle", "time": 1874.95, "timestamp": "00:31:14", "text": "拿着手机的人和所有人"}, {"type": "subtitle", "time": 1877.59, "timestamp": "00:31:17", "text": "会使用那个人的手机"}, {"type": "subtitle", "time": 1880.71, "timestamp": "00:31:20", "text": "或者像用电视看板球比赛一样。它"}, {"type": "subtitle", "time": 1883.87, "timestamp": "00:31:23", "text": "就像那样，只不过是PC版的。"}, {"type": "subtitle", "time": 1887.269, "timestamp": "00:31:27", "text": "玩游戏是因为我们都很穷。我们"}, {"type": "subtitle", "time": 1889.029, "timestamp": "00:31:29", "text": "没有。"}, {"type": "subtitle", "time": 1891.909, "timestamp": "00:31:31", "text": "所以，在屏幕上购买东西是"}, {"type": "subtitle", "time": 1894.71, "timestamp": "00:31:34", "text": "这不适合我们父母。他们是"}, {"type": "subtitle", "time": 1896.389, "timestamp": "00:31:36", "text": "比如，“你不要实体玩具吗？”"}, {"type": "subtitle", "time": 1897.99, "timestamp": "00:31:37", "text": "可以理解。"}, {"type": "subtitle", "time": 1899.909, "timestamp": "00:31:39", "text": "你想要一个可以……的数字产品"}, {"type": "subtitle", "time": 1902.63, "timestamp": "00:31:42", "text": "去赚真金白银？不，不，你想要"}, {"type": "subtitle", "time": 1904.71, "timestamp": "00:31:44", "text": "我会用电子货币支付。我"}, {"type": "subtitle", "time": 1914.63, "timestamp": "00:31:54", "text": "我以前也是这么玩游戏机的。我已经"}, {"type": "subtitle", "time": 1915.95, "timestamp": "00:31:55", "text": "从未有过"}, {"type": "subtitle", "time": 1919.99, "timestamp": "00:31:59", "text": "安慰。啊，真是太奇怪了。我从未"}]
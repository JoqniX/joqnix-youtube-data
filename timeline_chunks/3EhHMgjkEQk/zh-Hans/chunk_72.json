[{"type": "subtitle", "time": 4320.149, "timestamp": "01:12:00", "text": "就像看着你一样。有摄像头吗？"}, {"type": "subtitle", "time": 4321.99, "timestamp": "01:12:01", "text": "事物？我知道你有一架更好的飞机"}, {"type": "subtitle", "time": 4326.149, "timestamp": "01:12:06", "text": "比我强。我已经达到100级了。"}, {"type": "subtitle", "time": 4327.229, "timestamp": "01:12:07", "text": "等级"}, {"type": "subtitle", "time": 4331.51, "timestamp": "01:12:11", "text": "100？什么？像飞行员那样？"}, {"type": "subtitle", "time": 4333.75, "timestamp": "01:12:13", "text": "嘿。是的，我已经100级了。"}, {"type": "subtitle", "time": 4336.149, "timestamp": "01:12:16", "text": "我是玩家，所以我知道如何飞行。看，"}, {"type": "subtitle", "time": 4338.07, "timestamp": "01:12:18", "text": "严格来说，你的转弯速度比"}, {"type": "subtitle", "time": 4349.709, "timestamp": "01:12:29", "text": "哇。我的天哪。这是什么？"}, {"type": "subtitle", "time": 4353.83, "timestamp": "01:12:33", "text": "移动？这场保护运动。"}, {"type": "subtitle", "time": 4355.669, "timestamp": "01:12:35", "text": "好了，就是这样。就是这样"}, {"type": "subtitle", "time": 4358.55, "timestamp": "01:12:38", "text": "第一次世界大战期间发生过空战。"}, {"type": "subtitle", "time": 4361.43, "timestamp": "01:12:41", "text": "你是我的朋友，重温了昔日的辉煌"}, {"type": "subtitle", "time": 4364.31, "timestamp": "01:12:44", "text": "空战。"}, {"type": "subtitle", "time": 4366.149, "timestamp": "01:12:46", "text": "你在哪里？有没有办法锁定"}, {"type": "subtitle", "time": 4368.31, "timestamp": "01:12:48", "text": "你带相机了吗？"}, {"type": "subtitle", "time": 4369.75, "timestamp": "01:12:49", "text": "确实有，但你不想这么做。"}, {"type": "subtitle", "time": 4372.709, "timestamp": "01:12:52", "text": "那是因为它会开始让你感到困惑。"}, {"type": "subtitle", "time": 4378.87, "timestamp": "01:12:58", "text": "飞机。我通常就一直转身。"}]
[{"type": "subtitle", "time": 3961.87, "timestamp": "01:06:01", "text": "呃，还有《灵魂能力》，我以前玩过《灵魂能力：世界》。"}, {"type": "subtitle", "time": 3963.87, "timestamp": "01:06:03", "text": "军舰。那是很多年前的事了。"}, {"type": "subtitle", "time": 3966.23, "timestamp": "01:06:06", "text": "尽管。哦。"}, {"type": "subtitle", "time": 3969.19, "timestamp": "01:06:09", "text": "结果速度非常慢。"}, {"type": "subtitle", "time": 3975.75, "timestamp": "01:06:15", "text": "游戏玩法。呃，乔克，你在哪儿？什么"}, {"type": "subtitle", "time": 3977.51, "timestamp": "01:06:17", "text": "发生了吗？我得走了。你曾是"}, {"type": "subtitle", "time": 3982.309, "timestamp": "01:06:22", "text": "起飞。哦，等等。"}, {"type": "subtitle", "time": 3985.15, "timestamp": "01:06:25", "text": "如何操作？游戏正在将你计入在内。"}, {"type": "subtitle", "time": 3987.589, "timestamp": "01:06:27", "text": "不存在。我可能两分钟就能赢。"}, {"type": "subtitle", "time": 3991.27, "timestamp": "01:06:31", "text": "秒。哦，等等。我们输了。是的，你"}, {"type": "subtitle", "time": 3993.27, "timestamp": "01:06:33", "text": "没起飞。"}, {"type": "subtitle", "time": 3995.99, "timestamp": "01:06:35", "text": "哦，原来还有这回事。我不……没关系。"}, {"type": "subtitle", "time": 3999.349, "timestamp": "01:06:39", "text": "我们可以重做一遍。呃，当我最初"}, {"type": "subtitle", "time": 4002.15, "timestamp": "01:06:42", "text": "从训练开始，就像……"}, {"type": "subtitle", "time": 4004.87, "timestamp": "01:06:44", "text": "我按了一下，然后……"}, {"type": "subtitle", "time": 4006.91, "timestamp": "01:06:46", "text": "改变起飞模式"}, {"type": "subtitle", "time": 4010.15, "timestamp": "01:06:50", "text": "一切。那是什么？那是"}, {"type": "subtitle", "time": 4012.789, "timestamp": "01:06:52", "text": "切换模式。什么？"}, {"type": "subtitle", "time": 4016.069, "timestamp": "01:06:56", "text": "屏幕上有什么变化吗？就像着陆一样"}]
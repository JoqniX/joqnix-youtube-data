[{"type": "subtitle", "time": 13562.79, "timestamp": "03:46:02", "text": "不。我正朝你走来。哦，你真是。"}, {"type": "subtitle", "time": 13564.91, "timestamp": "03:46:04", "text": "我没看到"}, {"type": "subtitle", "time": 13567.75, "timestamp": "03:46:07", "text": "那。好的。你确实打了个小洞"}, {"type": "subtitle", "time": 13570.91, "timestamp": "03:46:10", "text": "我的翅膀。微小的。我觉得它得到了"}, {"type": "subtitle", "time": 13573.75, "timestamp": "03:46:13", "text": "已密封。有个很小的漏水点。和"}, {"type": "subtitle", "time": 13575.71, "timestamp": "03:46:15", "text": "是的，你可以看到"}, {"type": "subtitle", "time": 13579.03, "timestamp": "03:46:19", "text": "泄露。好的。所以，你还能飞。"}, {"type": "subtitle", "time": 13581.11, "timestamp": "03:46:21", "text": "是的。"}, {"type": "subtitle", "time": 13582.389, "timestamp": "03:46:22", "text": "我以为你只是在胡乱挥舞手臂"}, {"type": "subtitle", "time": 13606.63, "timestamp": "03:46:46", "text": "错过。哦，我的瞄准不太准。"}, {"type": "subtitle", "time": 13610.309, "timestamp": "03:46:50", "text": "是啊，做好人确实难得多。"}, {"type": "subtitle", "time": 13619.429, "timestamp": "03:46:59", "text": "螺旋桨。螺旋桨很容易制作。"}]
[{"type": "subtitle", "time": 11160.07, "timestamp": "03:06:00", "text": "开枪。是的。"}, {"type": "subtitle", "time": 11161.67, "timestamp": "03:06:01", "text": "你觉得他们是怎么避免被枪击的？"}, {"type": "subtitle", "time": 11168.71, "timestamp": "03:06:08", "text": "呃，他们把它摆放成这样："}, {"type": "subtitle", "time": 11171.75, "timestamp": "03:06:11", "text": "不会开枪。"}, {"type": "subtitle", "time": 11173.349, "timestamp": "03:06:13", "text": "不，它就放在后面"}, {"type": "subtitle", "time": 11175.51, "timestamp": "03:06:15", "text": "螺旋桨。所以，它当时正在向……射击"}, {"type": "subtitle", "time": 11178.71, "timestamp": "03:06:18", "text": "螺旋桨。他们提升了它。"}, {"type": "subtitle", "time": 11181.349, "timestamp": "03:06:21", "text": "不，他们没有。如果他们把它抬高了，"}, {"type": "subtitle", "time": 11182.63, "timestamp": "03:06:22", "text": "飞行员将无法看到"}, {"type": "subtitle", "time": 11184.07, "timestamp": "03:06:24", "text": "任何事物。他们必须提升"}, {"type": "subtitle", "time": 11187.03, "timestamp": "03:06:27", "text": "也是飞行员。那不会是一个非常"}, {"type": "subtitle", "time": 11189.99, "timestamp": "03:06:29", "text": "空气动力学飞机。"}, {"type": "subtitle", "time": 11191.51, "timestamp": "03:06:31", "text": "我的意思是，你开过日本飞机。"}, {"type": "subtitle", "time": 11196.79, "timestamp": "03:06:36", "text": "它的枪炮位于螺旋桨之间"}, {"type": "chat", "time": 11198.193, "timestamp": "03:06:38", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "WOAH"}, {"type": "subtitle", "time": 11199.03, "timestamp": "03:06:39", "text": "还有飞行员。"}, {"type": "subtitle", "time": 11208.95, "timestamp": "03:06:48", "text": "这是对的那个东西吗？你必须"}, {"type": "subtitle", "time": 11210.23, "timestamp": "03:06:50", "text": "指向那艘船。你正指着别处。"}, {"type": "subtitle", "time": 11212.79, "timestamp": "03:06:52", "text": "从船上。"}, {"type": "subtitle", "time": 11215.79, "timestamp": "03:06:55", "text": "略高一些。把鼻子指向前方"}, {"type": "subtitle", "time": 11218.75, "timestamp": "03:06:58", "text": "向上。好了。"}]
[{"type": "subtitle", "time": 15123.269, "timestamp": "04:12:03", "text": "是的。那58万卢比就是……"}, {"type": "subtitle", "time": 15125.59, "timestamp": "04:12:05", "text": "吧台满了。你用……填满那个吧台"}, {"type": "subtitle", "time": 15129.11, "timestamp": "04:12:09", "text": "20k，20k，20k，20k。那就是"}, {"type": "subtitle", "time": 15130.55, "timestamp": "04:12:10", "text": "专项研究。那是一个中队"}, {"type": "subtitle", "time": 15131.99, "timestamp": "04:12:11", "text": "研究。那与你的无关。"}, {"type": "subtitle", "time": 15135.349, "timestamp": "04:12:15", "text": "标准游戏研究。"}, {"type": "subtitle", "time": 15137.429, "timestamp": "04:12:17", "text": "你们的游戏有很多规则。"}, {"type": "subtitle", "time": 15139.03, "timestamp": "04:12:19", "text": "研究。你必须乘坐同一航班。"}, {"type": "subtitle", "time": 15141.03, "timestamp": "04:12:21", "text": "国家。你的飞机也需要一样。"}, {"type": "subtitle", "time": 15143.67, "timestamp": "04:12:23", "text": "与你正在研究的水平相同。为了"}, {"type": "subtitle", "time": 15145.51, "timestamp": "04:12:25", "text": "中队飞机，你可以驾驶任何一架。"}, {"type": "subtitle", "time": 15147.189, "timestamp": "04:12:27", "text": "无论哪个国家，任何飞机，它都能坐满。"}, {"type": "subtitle", "time": 15149.99, "timestamp": "04:12:29", "text": "这边。"}, {"type": "subtitle", "time": 15152.55, "timestamp": "04:12:32", "text": "哦，所以你和你的中队需要……"}, {"type": "subtitle", "time": 15154.95, "timestamp": "04:12:34", "text": "努力。每隔两天就会装满。"}, {"type": "subtitle", "time": 15157.99, "timestamp": "04:12:37", "text": "在一个月或一个月的时间里"}, {"type": "subtitle", "time": 15160.55, "timestamp": "04:12:40", "text": "这项研究将耗时一半。"}, {"type": "subtitle", "time": 15162.99, "timestamp": "04:12:42", "text": "完全的。一旦研究完成"}, {"type": "subtitle", "time": 15165.99, "timestamp": "04:12:45", "text": "由于所有这些飞机都已完工，"}, {"type": "subtitle", "time": 15168.55, "timestamp": "04:12:48", "text": "你知道，评分真​​的很高，你"}, {"type": "subtitle", "time": 15170.389, "timestamp": "04:12:50", "text": "大约需要一百五十万"}, {"type": "subtitle", "time": 15172.309, "timestamp": "04:12:52", "text": "用美元买它。我的意思是，不是美元。"}, {"type": "subtitle", "time": 15175.03, "timestamp": "04:12:55", "text": "银地。"}, {"type": "subtitle", "time": 15179.229, "timestamp": "04:12:59", "text": "哇。如何才能得到它？"}]
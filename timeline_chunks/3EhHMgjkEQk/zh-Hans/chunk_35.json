[{"type": "subtitle", "time": 2103.03, "timestamp": "00:35:03", "text": "是的，我记得我们玩过，我们做过。"}, {"type": "subtitle", "time": 2111.829, "timestamp": "00:35:11", "text": "嗯，我的移动速度已设置为节流。"}, {"type": "subtitle", "time": 2113.589, "timestamp": "00:35:13", "text": "轴。你看，卷轴就在那里，但是"}, {"type": "subtitle", "time": 2116.39, "timestamp": "00:35:16", "text": "卷轴上还有 W 和 S 或"}, {"type": "subtitle", "time": 2119.19, "timestamp": "00:35:19", "text": "越来越多"}, {"type": "subtitle", "time": 2121.99, "timestamp": "00:35:21", "text": "然后我认为滚动轴是 A，"}, {"type": "subtitle", "time": 2124.23, "timestamp": "00:35:24", "text": "D."}, {"type": "subtitle", "time": 2127.51, "timestamp": "00:35:27", "text": "啊，所以如果你想保持原样的话"}, {"type": "subtitle", "time": 2130.39, "timestamp": "00:35:30", "text": "默认情况下，你可以这样做，或者你可以"}, {"type": "subtitle", "time": 2133.87, "timestamp": "00:35:33", "text": "补充一下似乎"}, {"type": "subtitle", "time": 2136.47, "timestamp": "00:35:36", "text": "好的，大多数情况下你也可以这样做。"}, {"type": "subtitle", "time": 2138.47, "timestamp": "00:35:38", "text": "用鼠标操作。不要指着"}, {"type": "subtitle", "time": 2140.15, "timestamp": "00:35:40", "text": "向下。不要向下指。不要指指点点"}, {"type": "subtitle", "time": 2141.91, "timestamp": "00:35:41", "text": "向上。好的。好了。哦，好了。"}, {"type": "subtitle", "time": 2144.91, "timestamp": "00:35:44", "text": "你已经起飞了。哦好的。现在"}, {"type": "subtitle", "time": 2147.19, "timestamp": "00:35:47", "text": "按下“呃，好的”，你不必按。"}, {"type": "subtitle", "time": 2149.99, "timestamp": "00:35:49", "text": "任何事物。襟翼已升起。"}, {"type": "subtitle", "time": 2156.75, "timestamp": "00:35:56", "text": "什么过载了？"}]
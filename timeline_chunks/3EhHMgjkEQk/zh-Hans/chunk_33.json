[{"type": "subtitle", "time": 1980.31, "timestamp": "00:33:00", "text": "呃，等等，那是什么来着？ PS，是吗？"}, {"type": "subtitle", "time": 1983.83, "timestamp": "00:33:03", "text": "PlayStation？不是PlayStation。那"}, {"type": "subtitle", "time": 1985.669, "timestamp": "00:33:05", "text": "Joy-Con 或其他什么东西？我不知道。我"}, {"type": "subtitle", "time": 1987.669, "timestamp": "00:33:07", "text": "不记得了。 Joy-Con。哦好的。它是"}, {"type": "subtitle", "time": 1989.75, "timestamp": "00:33:09", "text": "就像一盒小磁带之类的东西"}, {"type": "subtitle", "time": 1993.99, "timestamp": "00:33:13", "text": "放。不，我很享受。我也有过。哦，"}, {"type": "subtitle", "time": 2000.31, "timestamp": "00:33:20", "text": "是的。还有，飞机怎么开？"}, {"type": "subtitle", "time": 2002.75, "timestamp": "00:33:22", "text": "再次？"}, {"type": "subtitle", "time": 2011.19, "timestamp": "00:33:31", "text": "我已经找到那东西了。等等，怎么会这样"}, {"type": "subtitle", "time": 2015.11, "timestamp": "00:33:35", "text": "我该如何引导你？呃，好的。等待，"}, {"type": "subtitle", "time": 2016.549, "timestamp": "00:33:36", "text": "把衣架留下。我将无法"}, {"type": "subtitle", "time": 2018.31, "timestamp": "00:33:38", "text": "指引你，因为我看不见你"}, {"type": "subtitle", "time": 2021.19, "timestamp": "00:33:41", "text": "即时的。好的。我上次查看的时候，你"}, {"type": "subtitle", "time": 2023.83, "timestamp": "00:33:43", "text": "应该有WD。"}, {"type": "subtitle", "time": 2026.87, "timestamp": "00:33:46", "text": "WD什么也没做。"}, {"type": "subtitle", "time": 2030.549, "timestamp": "00:33:50", "text": "那么它就恢复到默认设置了。你去呃"}, {"type": "subtitle", "time": 2033.87, "timestamp": "00:33:53", "text": "按Esc键。是的。"}]
[{"type": "subtitle", "time": 11881.75, "timestamp": "03:18:01", "text": "意外地，卢克倒在哪儿了？好的，"}, {"type": "subtitle", "time": 11883.429, "timestamp": "03:18:03", "text": "向下看的选项仍然存在。你，你只是"}, {"type": "subtitle", "time": 11885.03, "timestamp": "03:18:05", "text": "把它加在了向下看的上方。你没有"}, {"type": "subtitle", "time": 11887.91, "timestamp": "03:18:07", "text": "幸好，它被替换掉了。好了，现在"}, {"type": "subtitle", "time": 11890.55, "timestamp": "03:18:10", "text": "分配你想要的内容"}, {"type": "subtitle", "time": 11893.59, "timestamp": "03:18:13", "text": "代替。好了，现在应该可以了。"}, {"type": "subtitle", "time": 11895.83, "timestamp": "03:18:15", "text": "关闭。是的。好的。把所有炸弹都投下去。"}, {"type": "subtitle", "time": 11898.469, "timestamp": "03:18:18", "text": "把所有炸弹都投下去。是的，确实如此。等待，"}, {"type": "subtitle", "time": 11900.51, "timestamp": "03:18:20", "text": "把它关掉。关闭"}, {"type": "subtitle", "time": 11904.07, "timestamp": "03:18:24", "text": "再次。把所有炸弹都投下去。这是。你"}, {"type": "subtitle", "time": 11905.99, "timestamp": "03:18:25", "text": "需要精准投放。摆脱它"}, {"type": "subtitle", "time": 11909.71, "timestamp": "03:18:29", "text": "你所有的炸弹。好了，现在全力以赴"}, {"type": "subtitle", "time": 11912.67, "timestamp": "03:18:32", "text": "风门。切发动机"}, {"type": "subtitle", "time": 11916.91, "timestamp": "03:18:36", "text": "力量。打开它。"}, {"type": "subtitle", "time": 11920.309, "timestamp": "03:18:40", "text": "好的。油门，对吧？引擎。是的。"}, {"type": "subtitle", "time": 11922.229, "timestamp": "03:18:42", "text": "打开你的……呃，打开那个"}, {"type": "subtitle", "time": 11924.469, "timestamp": "03:18:44", "text": "按钮。"}, {"type": "subtitle", "time": 11932.07, "timestamp": "03:18:52", "text": "你是什​​么意思？胡乱挥舞手臂。哦，"}, {"type": "subtitle", "time": 11934.07, "timestamp": "03:18:54", "text": "直接向上拉就行了。对，拉"}, {"type": "subtitle", "time": 11935.99, "timestamp": "03:18:55", "text": "直上或侧向前进。非常"}, {"type": "subtitle", "time": 11938.469, "timestamp": "03:18:58", "text": "锋利的。不要试图轻手轻脚地走。"}]
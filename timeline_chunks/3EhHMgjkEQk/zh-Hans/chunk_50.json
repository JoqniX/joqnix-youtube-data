[{"type": "subtitle", "time": 3002.95, "timestamp": "00:50:02", "text": "是的。好的。不，看看你的野生动物园。如何"}, {"type": "subtitle", "time": 3005.99, "timestamp": "00:50:05", "text": "摆动你的翅膀。摆动你的翅膀"}, {"type": "subtitle", "time": 3007.23, "timestamp": "00:50:07", "text": "喜欢"}, {"type": "subtitle", "time": 3023.19, "timestamp": "00:50:23", "text": "管理员，那是什么？听起来像"}, {"type": "subtitle", "time": 3025.27, "timestamp": "00:50:25", "text": "一台发动机。"}, {"type": "subtitle", "time": 3027.589, "timestamp": "00:50:27", "text": "是的，它是一台发动机。你是做什么的"}, {"type": "subtitle", "time": 3029.75, "timestamp": "00:50:29", "text": "感到惊讶吗？"}, {"type": "subtitle", "time": 3031.51, "timestamp": "00:50:31", "text": "那是一架飞机。它有引擎。这"}, {"type": "subtitle", "time": 3034.47, "timestamp": "00:50:34", "text": "引擎会发出声音。我的意思是，什么？不，"}, {"type": "subtitle", "time": 3037.349, "timestamp": "00:50:37", "text": "就像一台动力强劲的蒸汽机"}, {"type": "subtitle", "time": 3040.15, "timestamp": "00:50:40", "text": "引擎就像喷气式飞机一样。我是说，"}, {"type": "subtitle", "time": 3044.63, "timestamp": "00:50:44", "text": "这些就像是非常，你知道的，入门级的。"}, {"type": "subtitle", "time": 3047.27, "timestamp": "00:50:47", "text": "飞机。即使就现实而言"}, {"type": "subtitle", "time": 3049.589, "timestamp": "00:50:49", "text": "飞机，它们都基于所有这些"}, {"type": "subtitle", "time": 3055.91, "timestamp": "00:50:55", "text": "好的。就各方面而言，做得相当不错"}, {"type": "subtitle", "time": 3059.03, "timestamp": "00:50:59", "text": "只需使用鼠标即可。"}]
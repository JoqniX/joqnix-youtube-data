[{"type": "subtitle", "time": 8167.27, "timestamp": "02:16:07", "text": "B. 要稍微谨慎一些，因为人们可能会"}, {"type": "subtitle", "time": 8170.189, "timestamp": "02:16:10", "text": "把你从缝隙里射出去"}, {"type": "subtitle", "time": 8184.35, "timestamp": "02:16:24", "text": "糟糕，我的引擎出问题了"}, {"type": "subtitle", "time": 8188.149, "timestamp": "02:16:28", "text": "射击。所以，你也可以帮忙维修。所以，"}, {"type": "subtitle", "time": 8196.389, "timestamp": "02:16:36", "text": "等等，我无法修复。哦，没关系。"}, {"type": "subtitle", "time": 8198.11, "timestamp": "02:16:38", "text": "它是"}, {"type": "subtitle", "time": 8201.27, "timestamp": "02:16:41", "text": "好吧，大概是这样。新油罐。哦，我们是"}, {"type": "subtitle", "time": 8203.19, "timestamp": "02:16:43", "text": "死的。我们死定了。我们死定了。我们如此"}, {"type": "subtitle", "time": 8206.15, "timestamp": "02:16:46", "text": "死的。炸弹。"}, {"type": "subtitle", "time": 8207.99, "timestamp": "02:16:47", "text": "哦，"}, {"type": "subtitle", "time": 8210.549, "timestamp": "02:16:50", "text": "是的。那声音，还有掉落在前面的东西"}, {"type": "subtitle", "time": 8213.19, "timestamp": "02:16:53", "text": "你真是太棒了。"}]
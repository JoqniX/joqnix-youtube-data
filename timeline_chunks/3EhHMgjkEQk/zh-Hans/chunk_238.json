[{"type": "subtitle", "time": 14288.15, "timestamp": "03:58:08", "text": "被欺凌。好的，我会等你到。"}, {"type": "subtitle", "time": 14289.15, "timestamp": "03:58:09", "text": "进入"}, {"type": "subtitle", "time": 14291.91, "timestamp": "03:58:11", "text": "城市。你想进入主城区"}, {"type": "subtitle", "time": 14293.91, "timestamp": "03:58:13", "text": "或者你知道吗？随便挑一个。思考"}, {"type": "subtitle", "time": 14296.63, "timestamp": "03:58:16", "text": "我们想要什么？我其实不知道"}, {"type": "subtitle", "time": 14298.269, "timestamp": "03:58:18", "text": "实际上。是的。是的。前进。去"}, {"type": "subtitle", "time": 14312.87, "timestamp": "03:58:32", "text": "好的？让我们来看看。你把我搞糊涂了吗？"}, {"type": "subtitle", "time": 14315.429, "timestamp": "03:58:35", "text": "并不真地。不，是发射了一枚导弹。"}, {"type": "subtitle", "time": 14320.95, "timestamp": "03:58:40", "text": "哦，"}, {"type": "subtitle", "time": 14322.389, "timestamp": "03:58:42", "text": "你必须身处其中"}, {"type": "subtitle", "time": 14324.229, "timestamp": "03:58:44", "text": "建筑物。你必须乘坐飞机"}, {"type": "subtitle", "time": 14325.91, "timestamp": "03:58:45", "text": "街道。"}, {"type": "subtitle", "time": 14327.83, "timestamp": "03:58:47", "text": "哦，有树的话，那是不可能的。"}, {"type": "subtitle", "time": 14329.51, "timestamp": "03:58:49", "text": "一切。"}, {"type": "subtitle", "time": 14331.349, "timestamp": "03:58:51", "text": "哦，你想看看怎么做吗？"}, {"type": "subtitle", "time": 14334.79, "timestamp": "03:58:54", "text": "好的，进来吧，我带你看。好的。"}, {"type": "subtitle", "time": 14337.75, "timestamp": "03:58:57", "text": "好的。所以，我要和你一起飞。"}]
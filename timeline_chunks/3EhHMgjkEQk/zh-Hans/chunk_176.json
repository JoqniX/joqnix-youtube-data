[{"type": "subtitle", "time": 10562.15, "timestamp": "02:56:02", "text": "按钮目前已分配，但您可以看到"}, {"type": "subtitle", "time": 10565.429, "timestamp": "02:56:05", "text": "底部有三个符号。"}, {"type": "subtitle", "time": 10569.11, "timestamp": "02:56:09", "text": "对，就是中间那个符号。我忘了"}, {"type": "subtitle", "time": 10570.55, "timestamp": "02:56:10", "text": "它叫什么名字，否则我可能……"}, {"type": "subtitle", "time": 10573.349, "timestamp": "02:56:13", "text": "帮到你了。我去查一下，你等着。"}, {"type": "subtitle", "time": 10575.03, "timestamp": "02:56:15", "text": "尝试着陆。但其中的符号"}, {"type": "subtitle", "time": 10576.87, "timestamp": "02:56:16", "text": "中间的按钮类似于“获取”。"}, {"type": "subtitle", "time": 10581.75, "timestamp": "02:56:21", "text": "你可以在飞机上胡乱挥舞手臂"}, {"type": "subtitle", "time": 10583.95, "timestamp": "02:56:23", "text": "在"}, {"type": "subtitle", "time": 10586.389, "timestamp": "02:56:26", "text": "天空。你会感觉自己正在坠落"}, {"type": "subtitle", "time": 10597.19, "timestamp": "02:56:37", "text": "哦，没事了。"}, {"type": "subtitle", "time": 10599.75, "timestamp": "02:56:39", "text": "我必须了解风暴巡航飞机的情况。"}, {"type": "subtitle", "time": 10603.429, "timestamp": "02:56:43", "text": "在航空母舰上，你无法降落"}, {"type": "subtitle", "time": 10606.469, "timestamp": "02:56:46", "text": "除了从后面以外，可以从任何地方出发。你"}, {"type": "subtitle", "time": 10609.95, "timestamp": "02:56:49", "text": "必须走正确的路。"}]
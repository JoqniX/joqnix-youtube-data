[{"type": "subtitle", "time": 6722.31, "timestamp": "01:52:02", "text": "好的，这里是绿色。"}, {"type": "subtitle", "time": 6733.51, "timestamp": "01:52:13", "text": "哦，他们坠机了。好了，他在那里。"}, {"type": "subtitle", "time": 6740.31, "timestamp": "01:52:20", "text": "好的，小心点。我不是在保护"}, {"type": "subtitle", "time": 6743.669, "timestamp": "01:52:23", "text": "你现在落后了。我得去接一个人"}, {"type": "subtitle", "time": 6750.35, "timestamp": "01:52:30", "text": "哦，我死了。"}, {"type": "subtitle", "time": 6753.189, "timestamp": "01:52:33", "text": "呃，好的。"}, {"type": "subtitle", "time": 6765.83, "timestamp": "01:52:45", "text": "门。所以，我们必须摧毁这些坦克。"}, {"type": "subtitle", "time": 6768.709, "timestamp": "01:52:48", "text": "也一样。呃，"}, {"type": "subtitle", "time": 6776.31, "timestamp": "01:52:56", "text": "你可以找到卡车，也可以射击"}]
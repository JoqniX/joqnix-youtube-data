[{"type": "subtitle", "time": 12363.79, "timestamp": "03:26:03", "text": "这。你的热信号并不那么……哦"}, {"type": "subtitle", "time": 12368.15, "timestamp": "03:26:08", "text": "我的天，这也太快了吧。"}, {"type": "subtitle", "time": 12371.11, "timestamp": "03:26:11", "text": "圣主啊，"}, {"type": "subtitle", "time": 12372.63, "timestamp": "03:26:12", "text": "非常接近了。顺便说一下，在"}, {"type": "subtitle", "time": 12375.51, "timestamp": "03:26:15", "text": "另一架飞机，如果你没有开枪打我的话，"}, {"type": "subtitle", "time": 12377.429, "timestamp": "03:26:17", "text": "你会被击毙的。你 你"}, {"type": "subtitle", "time": 12379.11, "timestamp": "03:26:19", "text": "知道什么？在我告诉你之前，我们先……"}, {"type": "subtitle", "time": 12380.87, "timestamp": "03:26:20", "text": "亲身体验一下。摆脱纠缠。"}, {"type": "subtitle", "time": 12383.349, "timestamp": "03:26:23", "text": "去汉格尔。让我们进入定制环节。"}, {"type": "subtitle", "time": 12389.03, "timestamp": "03:26:29", "text": "真好。这就像教孩子一样"}, {"type": "subtitle", "time": 12391.67, "timestamp": "03:26:31", "text": "幼儿园小朋友怎么骑自行车？哦"}, {"type": "subtitle", "time": 12393.99, "timestamp": "03:26:33", "text": "我的上帝。"}, {"type": "subtitle", "time": 12395.75, "timestamp": "03:26:35", "text": "是的。通常战争就像真的"}, {"type": "subtitle", "time": 12397.95, "timestamp": "03:26:37", "text": "烦人且"}, {"type": "subtitle", "time": 12407.99, "timestamp": "03:26:47", "text": "甜的。好了，停。"}, {"type": "subtitle", "time": 12410.63, "timestamp": "03:26:50", "text": "我们没法测试这个东西的高级功能。"}, {"type": "subtitle", "time": 12412.469, "timestamp": "03:26:52", "text": "就像我们都是定制的一样。是的，你不能"}, {"type": "subtitle", "time": 12414.55, "timestamp": "03:26:54", "text": "和我一起进行一场测试赛吧"}, {"type": "subtitle", "time": 12416.63, "timestamp": "03:26:56", "text": "飞机。"}, {"type": "subtitle", "time": 12418.469, "timestamp": "03:26:58", "text": "测试飞机只能做到这一切"}]
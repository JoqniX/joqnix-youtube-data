[{"type": "subtitle", "time": 1624.23, "timestamp": "00:27:04", "text": "不太确定。你们是朋友吗？"}, {"type": "subtitle", "time": 1626.789, "timestamp": "00:27:06", "text": "就像和那些你不认识的人相处一样"}, {"type": "subtitle", "time": 1628.87, "timestamp": "00:27:08", "text": "不一定是朋友，你这样做"}, {"type": "subtitle", "time": 1631.029, "timestamp": "00:27:11", "text": "更像是熟人关系。我可以"}, {"type": "subtitle", "time": 1633.269, "timestamp": "00:27:13", "text": "要明白，那意味着更多的工作，那意味着更多的时间。"}, {"type": "subtitle", "time": 1637.35, "timestamp": "00:27:17", "text": "商业。嗯。在那里我大概能看到"}, {"type": "subtitle", "time": 1641.19, "timestamp": "00:27:21", "text": "比如考虑所有这些因素。"}, {"type": "subtitle", "time": 1642.87, "timestamp": "00:27:22", "text": "是的。"}, {"type": "subtitle", "time": 1646.35, "timestamp": "00:27:26", "text": "我个人不喜欢那样做。不是"}, {"type": "subtitle", "time": 1649.83, "timestamp": "00:27:29", "text": "因为你知道我有一些哲学思想。"}, {"type": "subtitle", "time": 1653.029, "timestamp": "00:27:33", "text": "更多的是因为像我一样，我无法成为"}, {"type": "subtitle", "time": 1655.19, "timestamp": "00:27:35", "text": "感到困扰。工作量太大了。我非常"}, {"type": "subtitle", "time": 1658.63, "timestamp": "00:27:38", "text": "懒惰的。我几乎无法应付尝试成为……"}, {"type": "subtitle", "time": 1661.07, "timestamp": "00:27:41", "text": "积极主动地做我自己"}, {"type": "subtitle", "time": 1663.269, "timestamp": "00:27:43", "text": "渠道。别想着找人了。"}, {"type": "subtitle", "time": 1668.31, "timestamp": "00:27:48", "text": "男人。"}, {"type": "subtitle", "time": 1671.669, "timestamp": "00:27:51", "text": "曾经在什么情况下发生过？每6个月中出现一次"}, {"type": "subtitle", "time": 1674.43, "timestamp": "00:27:54", "text": "几个月后，我们会私信联系。我会这样说："}, {"type": "subtitle", "time": 1676.669, "timestamp": "00:27:56", "text": "J，你想玩吗？"}]
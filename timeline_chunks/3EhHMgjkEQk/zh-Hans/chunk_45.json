[{"type": "subtitle", "time": 2703.27, "timestamp": "00:45:03", "text": "零场战斗。零胜。零系列。"}, {"type": "subtitle", "time": 2705.67, "timestamp": "00:45:05", "text": "未摧毁任何目标。零目标"}, {"type": "subtitle", "time": 2709.51, "timestamp": "00:45:09", "text": "已摧毁。人工智能。总分零分。"}, {"type": "subtitle", "time": 2712.55, "timestamp": "00:45:12", "text": "三级。"}, {"type": "subtitle", "time": 2715.51, "timestamp": "00:45:15", "text": "可能。等待。你已经100级了。什么？"}, {"type": "subtitle", "time": 2718.55, "timestamp": "00:45:18", "text": "什么？嘿，我已经满级了。是的，"}, {"type": "subtitle", "time": 2719.79, "timestamp": "00:45:19", "text": "你是"}, {"type": "subtitle", "time": 2732.069, "timestamp": "00:45:32", "text": "我玩这个游戏已经超过5年了。我有"}, {"type": "subtitle", "time": 2735.19, "timestamp": "00:45:35", "text": "搭载导弹的喷气式飞机。所以，我当时正在……"}, {"type": "subtitle", "time": 2737.03, "timestamp": "00:45:37", "text": "在我们之前的谈话中提到过。但"}, {"type": "subtitle", "time": 2739.19, "timestamp": "00:45:39", "text": "是的，"}, {"type": "subtitle", "time": 2740.71, "timestamp": "00:45:40", "text": "我当时就是这么想的。"}, {"type": "subtitle", "time": 2742.47, "timestamp": "00:45:42", "text": "在自定义战斗中，我应该直接横扫对手吗？"}, {"type": "subtitle", "time": 2745.109, "timestamp": "00:45:45", "text": "用喷气式飞机？"}, {"type": "subtitle", "time": 2747.829, "timestamp": "00:45:47", "text": "对，就这么做。搞什么鬼？我想要"}, {"type": "subtitle", "time": 2751.349, "timestamp": "00:45:51", "text": "在这款游戏中可以看到真正的喷气式飞机。好的，"}, {"type": "subtitle", "time": 2754.15, "timestamp": "00:45:54", "text": "我们会进行一次会议，我只是喜欢"}, {"type": "subtitle", "time": 2758.47, "timestamp": "00:45:58", "text": "帮你驾驶飞机。"}]
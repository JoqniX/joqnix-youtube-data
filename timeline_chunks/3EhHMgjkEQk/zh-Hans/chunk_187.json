[{"type": "subtitle", "time": 11220.79, "timestamp": "03:07:00", "text": "极好的。现在你就到了。你"}, {"type": "subtitle", "time": 11222.309, "timestamp": "03:07:02", "text": "只需稍微转个身就行了"}, {"type": "subtitle", "time": 11224.79, "timestamp": "03:07:04", "text": "直接起飞。"}, {"type": "subtitle", "time": 11227.269, "timestamp": "03:07:07", "text": "好的。惊人的。你学会了着陆"}, {"type": "subtitle", "time": 11230.07, "timestamp": "03:07:10", "text": "这里真的很好。人们通常"}, {"type": "subtitle", "time": 11233.03, "timestamp": "03:07:13", "text": "在这方面我做得不够好。"}, {"type": "subtitle", "time": 11235.51, "timestamp": "03:07:15", "text": "我的天啊。你有没有让赤村上阵？"}, {"type": "subtitle", "time": 11239.269, "timestamp": "03:07:19", "text": "频道开通了吗？呃，他会在六月。"}, {"type": "subtitle", "time": 11240.79, "timestamp": "03:07:20", "text": "第三。"}, {"type": "subtitle", "time": 11244.55, "timestamp": "03:07:24", "text": "是啊，他玩《战争雷霆》很菜。"}, {"type": "subtitle", "time": 11252.309, "timestamp": "03:07:32", "text": "他。哦，等等。你一动不动。哦，这个"}, {"type": "chat", "time": 11252.849, "timestamp": "03:07:32", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "yeah even just seeing I feel like I'd crash every two seconds"}, {"type": "subtitle", "time": 11254.389, "timestamp": "03:07:34", "text": "完美。他们是自动完成的。"}, {"type": "subtitle", "time": 11257.67, "timestamp": "03:07:37", "text": "为你。好的。现在，"}, {"type": "subtitle", "time": 11259.349, "timestamp": "03:07:39", "text": "呃，什么？好的，什么都别做。不"}, {"type": "subtitle", "time": 11261.11, "timestamp": "03:07:41", "text": "做任何事。你想怎么做？"}, {"type": "subtitle", "time": 11262.87, "timestamp": "03:07:42", "text": "有过这种经历吗？这艘船即将"}, {"type": "subtitle", "time": 11264.389, "timestamp": "03:07:44", "text": "把你送上飞翔。你想怎么做？"}, {"type": "subtitle", "time": 11265.429, "timestamp": "03:07:45", "text": "有过这种经历吗？你想要_____吗"}, {"type": "subtitle", "time": 11267.83, "timestamp": "03:07:47", "text": "体验一下这个外部摄像头视角或"}, {"type": "subtitle", "time": 11269.19, "timestamp": "03:07:49", "text": "你想体验一下驾驶舱吗？"}, {"type": "subtitle", "time": 11271.51, "timestamp": "03:07:51", "text": "看法？你坐在驾驶舱里，"}, {"type": "subtitle", "time": 11274.07, "timestamp": "03:07:54", "text": "哪个更好更酷？"}, {"type": "subtitle", "time": 11277.03, "timestamp": "03:07:57", "text": "所以，这取决于你喜欢什么。"}, {"type": "subtitle", "time": 11279.269, "timestamp": "03:07:59", "text": "总的来说，驾驶舱的视野很棒。"}]
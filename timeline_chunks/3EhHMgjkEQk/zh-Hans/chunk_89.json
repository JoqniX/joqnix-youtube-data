[{"type": "subtitle", "time": 5344.55, "timestamp": "01:29:04", "text": "更高。你的右边是你的"}, {"type": "subtitle", "time": 5346.31, "timestamp": "01:29:06", "text": "雷达。它向你展示了距离有多近"}, {"type": "subtitle", "time": 5349.59, "timestamp": "01:29:09", "text": "敌机是。是的。这是什么？"}, {"type": "subtitle", "time": 5352.79, "timestamp": "01:29:12", "text": "雷达上的问号？在左边。"}, {"type": "subtitle", "time": 5355.83, "timestamp": "01:29:15", "text": "哦，左边那个就是你要找的。"}, {"type": "subtitle", "time": 5358.709, "timestamp": "01:29:18", "text": "被敌方雷达扫描，但你的系统"}, {"type": "subtitle", "time": 5360.55, "timestamp": "01:29:20", "text": "不知道是谁在扫描。所以它"}, {"type": "subtitle", "time": 5362.95, "timestamp": "01:29:22", "text": "显示为一个问题。"}, {"type": "subtitle", "time": 5364.629, "timestamp": "01:29:24", "text": "你知道，你中了三四枪。"}, {"type": "subtitle", "time": 5366.149, "timestamp": "01:29:26", "text": "次数。"}, {"type": "subtitle", "time": 5369.03, "timestamp": "01:29:29", "text": "是的，那就是那些问号。"}, {"type": "subtitle", "time": 5371.47, "timestamp": "01:29:31", "text": "把你击倒。等等，你离得还远着呢。"}, {"type": "subtitle", "time": 5373.83, "timestamp": "01:29:33", "text": "足够的。另外，你是在背后开枪的。"}, {"type": "subtitle", "time": 5375.51, "timestamp": "01:29:35", "text": "飞机。你必须把它指向前方。看"}, {"type": "subtitle", "time": 5384.55, "timestamp": "01:29:44", "text": "至于导弹方面，你需要检查一下。"}, {"type": "subtitle", "time": 5386.39, "timestamp": "01:29:46", "text": "你的绑定又坏了。只需查看一下是什么即可"}, {"type": "subtitle", "time": 5397.95, "timestamp": "01:29:57", "text": "左侧控制"}]
[{"type": "subtitle", "time": 1800.149, "timestamp": "00:30:00", "text": "那是《暴力摩托》。"}, {"type": "subtitle", "time": 1803.029, "timestamp": "00:30:03", "text": "哦，对了，《公路救赎》现在已经上线了。我"}, {"type": "subtitle", "time": 1805.47, "timestamp": "00:30:05", "text": "最近玩过。有这么一款游戏"}, {"type": "subtitle", "time": 1808.87, "timestamp": "00:30:08", "text": "名为“救赎之路”。"}, {"type": "subtitle", "time": 1811.029, "timestamp": "00:30:11", "text": "哦，那应该是这样的。"}, {"type": "subtitle", "time": 1813.99, "timestamp": "00:30:13", "text": "是《暴力摩托》的续集，对吧？"}, {"type": "subtitle", "time": 1815.669, "timestamp": "00:30:15", "text": "是的。"}, {"type": "subtitle", "time": 1820.31, "timestamp": "00:30:20", "text": "相对地。我听说不错，但是"}, {"type": "subtitle", "time": 1824.149, "timestamp": "00:30:24", "text": "就像不能像《暴力摩托》里那样做一样。"}, {"type": "subtitle", "time": 1834.47, "timestamp": "00:30:34", "text": "太好玩了。我至今仍记得。我当时"}, {"type": "subtitle", "time": 1837.909, "timestamp": "00:30:37", "text": "就像玩了好几个小时一样。"}, {"type": "subtitle", "time": 1840.149, "timestamp": "00:30:40", "text": "哦，我根本就没有。我们过去常常"}, {"type": "subtitle", "time": 1843.269, "timestamp": "00:30:43", "text": "就像我楼里有个小孩一样"}, {"type": "subtitle", "time": 1845.19, "timestamp": "00:30:45", "text": "谁像在一楼或"}, {"type": "subtitle", "time": 1847.11, "timestamp": "00:30:47", "text": "某物。"}, {"type": "subtitle", "time": 1849.11, "timestamp": "00:30:49", "text": "我们以前经常去他家玩。"}, {"type": "subtitle", "time": 1852.71, "timestamp": "00:30:52", "text": "在他爸爸的电脑上玩《公路狂飙》"}, {"type": "subtitle", "time": 1859.59, "timestamp": "00:30:59", "text": "你知道，就像我们父母那一代一样。"}]
[{"type": "subtitle", "time": 4981.91, "timestamp": "01:23:01", "text": "为此。离开。我会让你加入"}, {"type": "subtitle", "time": 4991.11, "timestamp": "01:23:11", "text": "我的天哪。这是什么？"}, {"type": "subtitle", "time": 4997.03, "timestamp": "01:23:17", "text": "好的。按下V键。V。我的天哪。"}, {"type": "subtitle", "time": 4999.83, "timestamp": "01:23:19", "text": "现在按下 C 键，然后一直按住 C 键。"}, {"type": "subtitle", "time": 5002.629, "timestamp": "01:23:22", "text": "然后转身。我的天啊。瞧不起。"}, {"type": "subtitle", "time": 5007.27, "timestamp": "01:23:27", "text": "瞧不起。我的天啊。这真是太"}, {"type": "subtitle", "time": 5010.149, "timestamp": "01:23:30", "text": "好的，当你继续寻找的时候"}, {"type": "subtitle", "time": 5012.95, "timestamp": "01:23:32", "text": "向下，按 Q 和 E。紧接着……"}, {"type": "subtitle", "time": 5020.229, "timestamp": "01:23:40", "text": "圣主啊。"}, {"type": "subtitle", "time": 5023.27, "timestamp": "01:23:43", "text": "现在点击右键。"}, {"type": "subtitle", "time": 5026.31, "timestamp": "01:23:46", "text": "是的，你只要转动你的……就能看到所有东西。"}, {"type": "subtitle", "time": 5029.43, "timestamp": "01:23:49", "text": "驾驶飞机或者用你的飞机做点什么。"}, {"type": "subtitle", "time": 5031.189, "timestamp": "01:23:51", "text": "呃，你可以看到所有的刻度盘和"}, {"type": "subtitle", "time": 5033.51, "timestamp": "01:23:53", "text": "一切。移动。哦，你中枪了。"}, {"type": "subtitle", "time": 5035.99, "timestamp": "01:23:55", "text": "向下。"}, {"type": "subtitle", "time": 5038.629, "timestamp": "01:23:58", "text": "什么？离开飞机。离开。那也是"}]
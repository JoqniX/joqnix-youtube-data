[{"type": "subtitle", "time": 13629.03, "timestamp": "03:47:09", "text": "游戏玩法。好的，我把它简化了。"}, {"type": "subtitle", "time": 13642.309, "timestamp": "03:47:22", "text": "好吧，现在没人告诉我该怎么做了"}, {"type": "subtitle", "time": 13644.79, "timestamp": "03:47:24", "text": "我的枪没了。只有一件事"}, {"type": "subtitle", "time": 13652.389, "timestamp": "03:47:32", "text": "哦，我明白了。你得崩溃"}, {"type": "subtitle", "time": 13654.309, "timestamp": "03:47:34", "text": "在我身上。"}, {"type": "subtitle", "time": 13657.269, "timestamp": "03:47:37", "text": "什么？不，那工作量太大了。为什么"}, {"type": "subtitle", "time": 13658.99, "timestamp": "03:47:38", "text": "我会想做什么"}, {"type": "subtitle", "time": 13664.15, "timestamp": "03:47:44", "text": "那？呃，我做不到。不。"}, {"type": "subtitle", "time": 13666.269, "timestamp": "03:47:46", "text": "正确的。它不起作用。"}, {"type": "subtitle", "time": 13668.79, "timestamp": "03:47:48", "text": "确切地。我按错按钮了。我需要"}, {"type": "subtitle", "time": 13670.51, "timestamp": "03:47:50", "text": "达到我的速度"}, {"type": "subtitle", "time": 13677.429, "timestamp": "03:47:57", "text": "你。我未来五年内都没有枪。"}]
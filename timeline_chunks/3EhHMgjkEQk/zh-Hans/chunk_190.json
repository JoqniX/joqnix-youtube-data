[{"type": "subtitle", "time": 11400.309, "timestamp": "03:10:00", "text": "现在您可以体验到如此快速的"}, {"type": "subtitle", "time": 11401.75, "timestamp": "03:10:01", "text": "想玩多少次就玩多少次。你没有"}, {"type": "subtitle", "time": 11405.51, "timestamp": "03:10:05", "text": "坐在那里。降落在摄像机上。"}, {"type": "subtitle", "time": 11412.51, "timestamp": "03:10:12", "text": "好的。"}, {"type": "subtitle", "time": 11415.99, "timestamp": "03:10:15", "text": "哇。他们是怎么做到的？"}, {"type": "subtitle", "time": 11419.349, "timestamp": "03:10:19", "text": "你知道你是怎么用橡胶的"}, {"type": "subtitle", "time": 11421.67, "timestamp": "03:10:21", "text": "乐队，你往里面放了一块石头，然后你"}, {"type": "subtitle", "time": 11423.67, "timestamp": "03:10:23", "text": "用弹弓发射石头？你要去"}, {"type": "subtitle", "time": 11426.59, "timestamp": "03:10:26", "text": "撞上去。小心。"}, {"type": "subtitle", "time": 11428.95, "timestamp": "03:10:28", "text": "是的。你知道怎么把石头放在"}, {"type": "subtitle", "time": 11439.19, "timestamp": "03:10:39", "text": "你做过那种事吗？是的。"}, {"type": "subtitle", "time": 11441.19, "timestamp": "03:10:41", "text": "是的。所以，弹弓就是船，"}, {"type": "subtitle", "time": 11448.87, "timestamp": "03:10:48", "text": "哇。那条金属条，那种灰色"}, {"type": "subtitle", "time": 11450.71, "timestamp": "03:10:50", "text": "你的飞机停放的那条跑道，"}, {"type": "subtitle", "time": 11452.63, "timestamp": "03:10:52", "text": "它基本上是钩在底部的"}, {"type": "subtitle", "time": 11454.55, "timestamp": "03:10:54", "text": "你的飞机。"}, {"type": "subtitle", "time": 11457.51, "timestamp": "03:10:57", "text": "你一加速，它就射速起来。"}, {"type": "subtitle", "time": 11459.19, "timestamp": "03:10:59", "text": "你下船了。所以你必须"}]
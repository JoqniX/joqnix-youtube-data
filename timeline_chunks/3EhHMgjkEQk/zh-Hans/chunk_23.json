[{"type": "subtitle", "time": 1394.31, "timestamp": "00:23:14", "text": "我本该睡觉，但我却想：嗯……我……"}, {"type": "subtitle", "time": 1396.27, "timestamp": "00:23:16", "text": "我现在一直在计划与……合作"}, {"type": "subtitle", "time": 1399.11, "timestamp": "00:23:19", "text": "每个人。所以我一直都想……"}, {"type": "subtitle", "time": 1401.27, "timestamp": "00:23:21", "text": "安排日程和联系等"}, {"type": "subtitle", "time": 1404.19, "timestamp": "00:23:24", "text": "确定最终日期和"}, {"type": "subtitle", "time": 1406.95, "timestamp": "00:23:26", "text": "一切都在做坏事。"}, {"type": "subtitle", "time": 1408.71, "timestamp": "00:23:28", "text": "你是什​​么意思？是的，我24小时"}, {"type": "subtitle", "time": 1411.669, "timestamp": "00:23:31", "text": "虽然是直播。"}, {"type": "subtitle", "time": 1414.07, "timestamp": "00:23:34", "text": "是啊，但你一半时间都在睡觉。不。"}, {"type": "subtitle", "time": 1415.59, "timestamp": "00:23:35", "text": "是的，没错。你有回放。"}, {"type": "subtitle", "time": 1418.63, "timestamp": "00:23:38", "text": "发生了很多事。不，是时间。"}, {"type": "subtitle", "time": 1421.669, "timestamp": "00:23:41", "text": "没错。然后睡4个小时。"}, {"type": "subtitle", "time": 1424.27, "timestamp": "00:23:44", "text": "睡眠不足。 12小时睡眠"}, {"type": "subtitle", "time": 1426.63, "timestamp": "00:23:46", "text": "重播。你把所有的事情都告诉我了"}, {"type": "subtitle", "time": 1429.43, "timestamp": "00:23:49", "text": "另一次则用于布置场地"}, {"type": "subtitle", "time": 1431.11, "timestamp": "00:23:51", "text": "合作。"}, {"type": "subtitle", "time": 1433.029, "timestamp": "00:23:53", "text": "我上次查看的时候，好像只用了五个小时。"}, {"type": "subtitle", "time": 1434.63, "timestamp": "00:23:54", "text": "几分钟内即可完成协作设置。你是"}, {"type": "subtitle", "time": 1437.669, "timestamp": "00:23:57", "text": "比如，“嘿，普吉，你想玩吗？”"}, {"type": "subtitle", "time": 1439.669, "timestamp": "00:23:59", "text": "哦，当然可以。"}]
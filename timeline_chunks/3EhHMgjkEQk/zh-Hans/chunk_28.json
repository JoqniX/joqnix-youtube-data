[{"type": "subtitle", "time": 1680.149, "timestamp": "00:28:00", "text": "“旺达？” 是的。"}, {"type": "subtitle", "time": 1683.83, "timestamp": "00:28:03", "text": "我就像汽车保险推销员一样。"}, {"type": "subtitle", "time": 1685.669, "timestamp": "00:28:05", "text": "您有时间谈谈您的情况吗？"}, {"type": "subtitle", "time": 1692.07, "timestamp": "00:28:12", "text": "然后我就会到处骚扰别人"}, {"type": "subtitle", "time": 1694.149, "timestamp": "00:28:14", "text": "大家都这么做。然后一旦进入"}, {"type": "subtitle", "time": 1697.31, "timestamp": "00:28:17", "text": "你每隔六个月要给我回一次信息。"}, {"type": "subtitle", "time": 1702.71, "timestamp": "00:28:22", "text": "富士某某。就这样那样。"}, {"type": "subtitle", "time": 1706.549, "timestamp": "00:28:26", "text": "我的天啊。是的。"}, {"type": "subtitle", "time": 1708.75, "timestamp": "00:28:28", "text": "哦，我的"}, {"type": "subtitle", "time": 1711.75, "timestamp": "00:28:31", "text": "上帝。我得思考一下。什么"}, {"type": "subtitle", "time": 1713.669, "timestamp": "00:28:33", "text": "我该怎么说呢？我对此无可奉告。"}, {"type": "subtitle", "time": 1716.389, "timestamp": "00:28:36", "text": "约翰联系我是为了什么？我该怎么办？"}, {"type": "subtitle", "time": 1718.549, "timestamp": "00:28:38", "text": "说？"}, {"type": "subtitle", "time": 1727.44, "timestamp": "00:28:47", "text": "妈的。"}, {"type": "subtitle", "time": 1729.83, "timestamp": "00:28:49", "text": "[音乐]"}, {"type": "subtitle", "time": 1731.83, "timestamp": "00:28:51", "text": "你有没有玩过什么新游戏？"}, {"type": "subtitle", "time": 1734.23, "timestamp": "00:28:54", "text": "你最近喜欢什么？"}]
[{"type": "subtitle", "time": 2342.95, "timestamp": "00:39:02", "text": "1. 什么也没发生。是摄像头"}, {"type": "subtitle", "time": 2345.91, "timestamp": "00:39:05", "text": "移动。进去看看。我应该喜欢吗？"}, {"type": "subtitle", "time": 2349.27, "timestamp": "00:39:09", "text": "真的会这样移动吗？"}, {"type": "subtitle", "time": 2351.349, "timestamp": "00:39:11", "text": "是的。是的，"}, {"type": "subtitle", "time": 2354.71, "timestamp": "00:39:14", "text": "我做了。"}, {"type": "subtitle", "time": 2358.63, "timestamp": "00:39:18", "text": "嗯，这很有意思。好的。呃，等等。"}, {"type": "subtitle", "time": 2360.71, "timestamp": "00:39:20", "text": "你的战斗等级是多少？什么？"}, {"type": "subtitle", "time": 2364.87, "timestamp": "00:39:24", "text": "最高数字平面是单位平面吗？"}, {"type": "subtitle", "time": 2367.19, "timestamp": "00:39:27", "text": "我该如何核实？你只在……"}, {"type": "subtitle", "time": 2368.71, "timestamp": "00:39:28", "text": "你是吗？因为你必须……你会有"}, {"type": "subtitle", "time": 2370.55, "timestamp": "00:39:30", "text": "回大厅去办这件事。我得到了"}, {"type": "subtitle", "time": 2384.069, "timestamp": "00:39:44", "text": "好的。分享一下你的想法。什么"}, {"type": "subtitle", "time": 2390.15, "timestamp": "00:39:50", "text": "你管它叫什么？好的。嗯，好的，稍等一下。"}, {"type": "subtitle", "time": 2392.15, "timestamp": "00:39:52", "text": "分享你的作品。我必须把你添加为……"}, {"type": "subtitle", "time": 2393.8, "timestamp": "00:39:53", "text": "朋友。"}]
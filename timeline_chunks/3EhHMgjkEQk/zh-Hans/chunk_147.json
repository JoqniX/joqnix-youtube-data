[{"type": "subtitle", "time": 8821.83, "timestamp": "02:27:01", "text": "H 检查一下 Fujik，你听到我说话了吗？"}, {"type": "subtitle", "time": 8825.91, "timestamp": "02:27:05", "text": "看起来没问题。你好，我。是的，我明白了。"}, {"type": "subtitle", "time": 8827.75, "timestamp": "02:27:07", "text": "你听见我说话了吗？那里发生了什么事？我"}, {"type": "subtitle", "time": 8830.55, "timestamp": "02:27:10", "text": "我还是听不到你的声音，但听起来……"}, {"type": "subtitle", "time": 8832.389, "timestamp": "02:27:12", "text": "就像你能听到我说话一样，或者看起来像你"}, {"type": "subtitle", "time": 8834.79, "timestamp": "02:27:14", "text": "能听到我说话。是的。让我离开。"}]
[{"type": "subtitle", "time": 12968.55, "timestamp": "03:36:08", "text": "是的。现在，这里最酷的部分是……"}, {"type": "subtitle", "time": 12971.03, "timestamp": "03:36:11", "text": "当你离地面很近的时候，我的"}, {"type": "subtitle", "time": 12973.83, "timestamp": "03:36:13", "text": "雷达难以区分你"}, {"type": "subtitle", "time": 12980.15, "timestamp": "03:36:20", "text": "当我抓住你的时候，要离你非常近。"}, {"type": "subtitle", "time": 12981.67, "timestamp": "03:36:21", "text": "地面。就像，紧紧贴着地面。"}, {"type": "subtitle", "time": 12983.59, "timestamp": "03:36:23", "text": "有导弹要来了。真的"}, {"type": "subtitle", "time": 12989.51, "timestamp": "03:36:29", "text": "兄弟。"}, {"type": "subtitle", "time": 13002.309, "timestamp": "03:36:42", "text": "该死。你简直太非常非常"}, {"type": "subtitle", "time": 13005.11, "timestamp": "03:36:45", "text": "地面，你知道，就差一点点就能到。"}, {"type": "subtitle", "time": 13009.11, "timestamp": "03:36:49", "text": "刚好高于坠毁高度。"}, {"type": "subtitle", "time": 13011.269, "timestamp": "03:36:51", "text": "当你这样做时，你就能"}, {"type": "subtitle", "time": 13013.11, "timestamp": "03:36:53", "text": "避开导弹，因为导弹会……"}, {"type": "subtitle", "time": 13014.79, "timestamp": "03:36:54", "text": "最后时刻有点懵。所以你在寻找"}, {"type": "subtitle", "time": 13017.83, "timestamp": "03:36:57", "text": "在我的私人飞机上。"}]
[{"type": "subtitle", "time": 15901.75, "timestamp": "04:25:01", "text": "雷霆，就像你一样，将会是"}, {"type": "subtitle", "time": 15904.71, "timestamp": "04:25:04", "text": "我认识的人里，开喷气式飞机速度最快的。"}, {"type": "subtitle", "time": 15906.79, "timestamp": "04:25:06", "text": "在。"}, {"type": "subtitle", "time": 15911.03, "timestamp": "04:25:11", "text": "你会打败所有人，你会打败贾祖玛。"}, {"type": "subtitle", "time": 15914.07, "timestamp": "04:25:14", "text": "好的。你会打败贾西玛，但你知道"}, {"type": "subtitle", "time": 15915.83, "timestamp": "04:25:15", "text": "那家伙也经历了多少……"}, {"type": "subtitle", "time": 15918.149, "timestamp": "04:25:18", "text": "玩这款游戏轻松超过一年。"}, {"type": "subtitle", "time": 15920.87, "timestamp": "04:25:20", "text": "或者两年。该死。容易地。他一直"}, {"type": "subtitle", "time": 15922.469, "timestamp": "04:25:22", "text": "玩这个游戏已经好几年了。"}, {"type": "subtitle", "time": 15924.229, "timestamp": "04:25:24", "text": "他玩游戏的方式是"}, {"type": "subtitle", "time": 15926.55, "timestamp": "04:25:26", "text": "每次我骚扰他，我的意思是，"}, {"type": "subtitle", "time": 15928.309, "timestamp": "04:25:28", "text": "温和礼貌地请求他玩"}, {"type": "subtitle", "time": 15932.79, "timestamp": "04:25:32", "text": "游戏结束后，他会像劝说一样……"}, {"type": "subtitle", "time": 15934.79, "timestamp": "04:25:34", "text": "大概一周后，他会下载并玩。"}, {"type": "subtitle", "time": 15935.79, "timestamp": "04:25:35", "text": "它一"}, {"type": "subtitle", "time": 15938.309, "timestamp": "04:25:38", "text": "一天之后，他就会把它删掉，就像……"}, {"type": "subtitle", "time": 15939.99, "timestamp": "04:25:39", "text": "接下来的六个月也是如此。他就是这样的人。"}, {"type": "subtitle", "time": 15946.229, "timestamp": "04:25:46", "text": "我一直在玩，现在已经有点……"}, {"type": "subtitle", "time": 15948.309, "timestamp": "04:25:48", "text": "我做事很迟钝，很生疏，因为我就是"}, {"type": "subtitle", "time": 15951.349, "timestamp": "04:25:51", "text": "开始玩《极限竞速》游戏，"}, {"type": "subtitle", "time": 15954.229, "timestamp": "04:25:54", "text": "但我一直在或多或少地玩这个游戏。"}]
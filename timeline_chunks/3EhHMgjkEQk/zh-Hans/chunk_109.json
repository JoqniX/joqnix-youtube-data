[{"type": "subtitle", "time": 6542.229, "timestamp": "01:49:02", "text": "是的。是的。是的。是的。是的。现在，轻轻地……"}, {"type": "subtitle", "time": 6544.47, "timestamp": "01:49:04", "text": "它走了。注意不要藏东西"}, {"type": "subtitle", "time": 6545.87, "timestamp": "01:49:05", "text": "在...前面"}, {"type": "subtitle", "time": 6552.59, "timestamp": "01:49:12", "text": "去。是的，"}, {"type": "subtitle", "time": 6555.35, "timestamp": "01:49:15", "text": "男生。第一次紧急迫降的笑话。"}, {"type": "subtitle", "time": 6559.51, "timestamp": "01:49:19", "text": "我们走吧。我的天啊。"}, {"type": "subtitle", "time": 6563.59, "timestamp": "01:49:23", "text": "你做到了。你现在在空军基地里。"}, {"type": "subtitle", "time": 6566.31, "timestamp": "01:49:26", "text": "好的。"}, {"type": "subtitle", "time": 6568.55, "timestamp": "01:49:28", "text": "现在你彻底崩溃了，然后你等待"}, {"type": "subtitle", "time": 6570.55, "timestamp": "01:49:30", "text": "为此。它会给你一个计时器。"}, {"type": "subtitle", "time": 6582.39, "timestamp": "01:49:42", "text": "该死。你刚才开枪打我了吗？想象一下我"}, {"type": "subtitle", "time": 6583.91, "timestamp": "01:49:43", "text": "死了。"}, {"type": "subtitle", "time": 6585.51, "timestamp": "01:49:45", "text": "我当时想开枪打死你。我最终"}, {"type": "subtitle", "time": 6587.99, "timestamp": "01:49:47", "text": "地位低于你。我的天啊。我的意思是，我"}, {"type": "subtitle", "time": 6591.229, "timestamp": "01:49:51", "text": "能。等等，去做。不要这样做"}]
[{"type": "subtitle", "time": 14881.189, "timestamp": "04:08:01", "text": "而且它也对会员开放，因为"}, {"type": "subtitle", "time": 14883.51, "timestamp": "04:08:03", "text": "中队的问题在于，无论谁是……"}, {"type": "subtitle", "time": 14885.189, "timestamp": "04:08:05", "text": "中队的拥有者，他们必须支付费用"}, {"type": "subtitle", "time": 14889.11, "timestamp": "04:08:09", "text": "用真金白银维持中队的运转。"}, {"type": "subtitle", "time": 14891.59, "timestamp": "04:08:11", "text": "嗯，我看到很多“我基本上是对的”这种说法。"}, {"type": "subtitle", "time": 14893.349, "timestamp": "04:08:13", "text": "现在正白吃一些中国人的便宜呢。"}, {"type": "subtitle", "time": 14895.67, "timestamp": "04:08:15", "text": "老兄。我不知道。"}, {"type": "subtitle", "time": 14896.75, "timestamp": "04:08:16", "text": "哦，我的"}, {"type": "subtitle", "time": 14899.67, "timestamp": "04:08:19", "text": "上帝。为什么说要获取我的私人信息"}, {"type": "subtitle", "time": 14901.91, "timestamp": "04:08:21", "text": "返回数据？但是，是的，或者说，真的有吗？"}, {"type": "subtitle", "time": 14903.59, "timestamp": "04:08:23", "text": "您不符合会员资格。"}, {"type": "subtitle", "time": 14908.63, "timestamp": "04:08:28", "text": "小队队员的要求"}, {"type": "subtitle", "time": 14910.79, "timestamp": "04:08:30", "text": "那里？他们中有些人有严格的规定。"}, {"type": "subtitle", "time": 14911.91, "timestamp": "04:08:31", "text": "限制。他们中的一些人就像这样："}, {"type": "subtitle", "time": 14913.83, "timestamp": "04:08:33", "text": "“哦，你想来玩吗？来玩吧。”"}, {"type": "subtitle", "time": 14916.75, "timestamp": "04:08:36", "text": "他们就让你进来了。"}, {"type": "subtitle", "time": 14919.349, "timestamp": "04:08:39", "text": "[音乐]"}, {"type": "subtitle", "time": 14923.03, "timestamp": "04:08:43", "text": "合规要求是什么？"}, {"type": "subtitle", "time": 14927.11, "timestamp": "04:08:47", "text": "我不知道。我以前一无所有。"}, {"type": "subtitle", "time": 14930.15, "timestamp": "04:08:50", "text": "好的。尝试一下。等等，你在干什么？"}, {"type": "subtitle", "time": 14933.269, "timestamp": "04:08:53", "text": "某物？我知道应用程序。 SOT R。它"}, {"type": "subtitle", "time": 14935.189, "timestamp": "04:08:55", "text": "出现了。它显示在最上面。 SOTR 下一章"}, {"type": "subtitle", "time": 14938.87, "timestamp": "04:08:58", "text": "以你的名义。哦，所以我应该我应该"}]
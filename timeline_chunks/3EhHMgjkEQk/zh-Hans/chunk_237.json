[{"type": "subtitle", "time": 14220.63, "timestamp": "03:57:00", "text": "要知道你只是进去而已。也许"}, {"type": "subtitle", "time": 14222.15, "timestamp": "03:57:02", "text": "你会获得一次击杀，然后你会得到"}, {"type": "subtitle", "time": 14224.07, "timestamp": "03:57:04", "text": "被杀。"}, {"type": "subtitle", "time": 14225.51, "timestamp": "03:57:05", "text": "没有哪个版本能让你击杀敌人。"}, {"type": "subtitle", "time": 14227.429, "timestamp": "03:57:07", "text": "当你安全飞回家时"}, {"type": "subtitle", "time": 14229.15, "timestamp": "03:57:09", "text": "螺旋桨与喷气发动机对抗"}, {"type": "subtitle", "time": 14232.79, "timestamp": "03:57:12", "text": "战士。啊，"}, {"type": "subtitle", "time": 14234.309, "timestamp": "03:57:14", "text": "我给你留点空间，这样你就可以……"}, {"type": "subtitle", "time": 14237.349, "timestamp": "03:57:17", "text": "进入市区。"}, {"type": "subtitle", "time": 14240.07, "timestamp": "03:57:20", "text": "引擎熄火了。哇。"}, {"type": "subtitle", "time": 14243.03, "timestamp": "03:57:23", "text": "它是怎么死的？螺旋桨经纪人。等待，"}, {"type": "subtitle", "time": 14245.229, "timestamp": "03:57:25", "text": "你是怎么弄坏你的？你是怎么弄坏你的？"}, {"type": "subtitle", "time": 14249.03, "timestamp": "03:57:29", "text": "螺旋桨？什么？"}, {"type": "subtitle", "time": 14251.189, "timestamp": "03:57:31", "text": "没关系。只是在开玩笑。好的。它是"}, {"type": "subtitle", "time": 14253.59, "timestamp": "03:57:33", "text": "好的。"}, {"type": "subtitle", "time": 14265.59, "timestamp": "03:57:45", "text": "啊。是的。当你想进入"}, {"type": "subtitle", "time": 14267.67, "timestamp": "03:57:47", "text": "起飞位置很容易做到"}, {"type": "subtitle", "time": 14273.99, "timestamp": "03:57:53", "text": "否则，感觉就像你"}]
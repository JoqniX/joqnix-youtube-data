[{"type": "subtitle", "time": 8281.19, "timestamp": "02:18:01", "text": "你看它看起来像一架蓝色的飞机"}, {"type": "subtitle", "time": 8283.83, "timestamp": "02:18:03", "text": "还有一架红色的飞机。是的，那是你的"}, {"type": "subtitle", "time": 8286.07, "timestamp": "02:18:06", "text": "队友和敌方队伍。他们有"}, {"type": "subtitle", "time": 8287.75, "timestamp": "02:18:07", "text": "他们做得已经足够好了，而且他们"}, {"type": "subtitle", "time": 8289.87, "timestamp": "02:18:09", "text": "选定"}, {"type": "subtitle", "time": 8292.15, "timestamp": "02:18:12", "text": "一些。所以，它的意思是说，将会发生"}, {"type": "subtitle", "time": 8294.79, "timestamp": "02:18:14", "text": "成为敌方轰炸机"}, {"type": "subtitle", "time": 8304.87, "timestamp": "02:18:24", "text": "哦，你现在是在看热闹吗？是的。我"}, {"type": "subtitle", "time": 8307.509, "timestamp": "02:18:27", "text": "假设你只有两个油箱。你可以"}, {"type": "subtitle", "time": 8316.75, "timestamp": "02:18:36", "text": "好了。我的天啊。这是什么？"}, {"type": "subtitle", "time": 8320.79, "timestamp": "02:18:40", "text": "事物？该死。这是一辆装有小型枪的汽车"}, {"type": "subtitle", "time": 8325.27, "timestamp": "02:18:45", "text": "还有一把大枪。这是一辆车。是的，就是这样。"}, {"type": "subtitle", "time": 8328.07, "timestamp": "02:18:48", "text": "一辆装甲车。"}, {"type": "subtitle", "time": 8330.95, "timestamp": "02:18:50", "text": "所以，在坦克里，不仅仅是你的主炮。"}, {"type": "subtitle", "time": 8338.95, "timestamp": "02:18:58", "text": "种类。我必须小心。好了，现在我"}]
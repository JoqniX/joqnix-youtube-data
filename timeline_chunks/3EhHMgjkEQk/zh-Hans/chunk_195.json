[{"type": "subtitle", "time": 11707.07, "timestamp": "03:15:07", "text": "钥匙。是的。分配任务。极好的。现在"}, {"type": "subtitle", "time": 11710.309, "timestamp": "03:15:10", "text": "关闭。现在启动。出发，然后"}, {"type": "subtitle", "time": 11711.99, "timestamp": "03:15:11", "text": "稍微高一点，然后放下你的"}, {"type": "subtitle", "time": 11713.51, "timestamp": "03:15:13", "text": "炸弹。把你的炸弹处理掉。让你的"}, {"type": "subtitle", "time": 11724.269, "timestamp": "03:15:24", "text": "好吧，把你的"}, {"type": "subtitle", "time": 11727.03, "timestamp": "03:15:27", "text": "襟翼。一旦你投下炸弹，你就可以"}, {"type": "subtitle", "time": 11729.11, "timestamp": "03:15:29", "text": "几乎笔直向上。所以，这些"}, {"type": "subtitle", "time": 11731.349, "timestamp": "03:15:31", "text": "平面，这个和那个三角形"}, {"type": "subtitle", "time": 11732.75, "timestamp": "03:15:32", "text": "我展示的那架飞机"}, {"type": "subtitle", "time": 11735.11, "timestamp": "03:15:35", "text": "你，引擎动力足够强劲。"}, {"type": "subtitle", "time": 11736.87, "timestamp": "03:15:36", "text": "他们可以把飞机推直"}, {"type": "subtitle", "time": 11738.79, "timestamp": "03:15:38", "text": "向上。"}, {"type": "subtitle", "time": 11741.429, "timestamp": "03:15:41", "text": "一般来说，飞机不可能垂直上升。"}, {"type": "subtitle", "time": 11742.99, "timestamp": "03:15:42", "text": "至少是旧的"}, {"type": "subtitle", "time": 11747.03, "timestamp": "03:15:47", "text": "一。保持襟翼笔直。增加"}, {"type": "subtitle", "time": 11750.15, "timestamp": "03:15:50", "text": "你的皮瓣。"}, {"type": "subtitle", "time": 11752.309, "timestamp": "03:15:52", "text": "完美的。现在全速前进！"}, {"type": "subtitle", "time": 11755.309, "timestamp": "03:15:55", "text": "尽管。往上走一点。增加一些"}, {"type": "subtitle", "time": 11757.349, "timestamp": "03:15:57", "text": "高度。看起来你还没有"}, {"type": "subtitle", "time": 11759.349, "timestamp": "03:15:59", "text": "已分配密钥。为什么它不显示？"}]
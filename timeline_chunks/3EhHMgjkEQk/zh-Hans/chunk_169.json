[{"type": "subtitle", "time": 10140.63, "timestamp": "02:49:00", "text": "随后，航空母舰将着陆。哦，"}, {"type": "subtitle", "time": 10142.389, "timestamp": "02:49:02", "text": "没关系。全速前进。全力以赴"}, {"type": "subtitle", "time": 10144.95, "timestamp": "02:49:04", "text": "朝着那些红色区域加速"}, {"type": "subtitle", "time": 10148.15, "timestamp": "02:49:08", "text": "她海边。她岸"}, {"type": "subtitle", "time": 10149.67, "timestamp": "02:49:09", "text": "海滨。对，直接走就行了。"}, {"type": "subtitle", "time": 10152.79, "timestamp": "02:49:12", "text": "海滨。沿着海岸线。我的天哪。"}, {"type": "subtitle", "time": 10161.67, "timestamp": "02:49:21", "text": "直的。或者你可以试试用……"}, {"type": "subtitle", "time": 10163.469, "timestamp": "02:49:23", "text": "另一架飞机。你想试试"}, {"type": "subtitle", "time": 10166.87, "timestamp": "02:49:26", "text": "F18？你想用那个试试吗？"}, {"type": "subtitle", "time": 10170.71, "timestamp": "02:49:30", "text": "是的。好的，那就回机库去。让"}, {"type": "subtitle", "time": 10177.309, "timestamp": "02:49:37", "text": "是的，那将是你的"}, {"type": "subtitle", "time": 10184.07, "timestamp": "02:49:44", "text": "此外，这些飞机通常都在飞行"}, {"type": "subtitle", "time": 10186.55, "timestamp": "02:49:46", "text": "速度太快，根本无法着陆。所以，他们来了"}, {"type": "subtitle", "time": 10189.19, "timestamp": "02:49:49", "text": "带着降落伞。"}, {"type": "subtitle", "time": 10192.59, "timestamp": "02:49:52", "text": "所以，一旦发生这种情况，它就会被摧毁。"}, {"type": "subtitle", "time": 10194.55, "timestamp": "02:49:54", "text": "自动地。着陆后"}, {"type": "subtitle", "time": 10196.309, "timestamp": "02:49:56", "text": "成功，所有降落伞"}, {"type": "subtitle", "time": 10198.23, "timestamp": "02:49:58", "text": "降落伞的作用是帮助你减速。"}]
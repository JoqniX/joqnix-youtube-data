[{"type": "subtitle", "time": 4922.79, "timestamp": "01:22:02", "text": "免费。它们被分成多个部分。"}, {"type": "subtitle", "time": 4925.83, "timestamp": "01:22:05", "text": "飞机的种类。所以第一行就结束了。"}, {"type": "subtitle", "time": 4927.47, "timestamp": "01:22:07", "text": "成为你的"}, {"type": "subtitle", "time": 4930.189, "timestamp": "01:22:10", "text": "擅长飞行的拦截机"}, {"type": "subtitle", "time": 4933.669, "timestamp": "01:22:13", "text": "速度快、射程远，而且拥有强大的火力"}, {"type": "subtitle", "time": 4935.43, "timestamp": "01:22:15", "text": "但它们转运效果不好。你的第二个"}, {"type": "subtitle", "time": 4937.43, "timestamp": "01:22:17", "text": "第三行通常倾向于"}, {"type": "subtitle", "time": 4939.99, "timestamp": "01:22:19", "text": "你的战士们。"}, {"type": "subtitle", "time": 4941.83, "timestamp": "01:22:21", "text": "它们转弯很快。他们可以，他们是"}, {"type": "subtitle", "time": 4943.35, "timestamp": "01:22:23", "text": "你知道，他们什么都能做到。"}, {"type": "subtitle", "time": 4945.91, "timestamp": "01:22:25", "text": "但不是最好的。然后是你的最后两个"}, {"type": "subtitle", "time": 4953.83, "timestamp": "01:22:33", "text": "轰炸。之后，你就会看到"}, {"type": "subtitle", "time": 4956.47, "timestamp": "01:22:36", "text": "你知道，就是那个非红色区域，仅此而已。"}, {"type": "subtitle", "time": 4959.75, "timestamp": "01:22:39", "text": "高档车辆。"}, {"type": "subtitle", "time": 4961.75, "timestamp": "01:22:41", "text": "您将有机会试驾的顶级车辆"}, {"type": "subtitle", "time": 4963.83, "timestamp": "01:22:43", "text": "随时都可以。例如，您可以点击"}, {"type": "subtitle", "time": 4966.229, "timestamp": "01:22:46", "text": "最后那三个中的任何一个，就是那几个。"}, {"type": "subtitle", "time": 4968.709, "timestamp": "01:22:48", "text": "您正在结账。"}, {"type": "subtitle", "time": 4971.669, "timestamp": "01:22:51", "text": "最后三名。我可以测试一下吗？"}, {"type": "subtitle", "time": 4974.31, "timestamp": "01:22:54", "text": "喷射？对，放手去做吧。"}, {"type": "subtitle", "time": 4976.39, "timestamp": "01:22:56", "text": "等等，在你做之前……哦，是的。好的，开始"}, {"type": "subtitle", "time": 4978.87, "timestamp": "01:22:58", "text": "为此。去。你必须离开小队"}]
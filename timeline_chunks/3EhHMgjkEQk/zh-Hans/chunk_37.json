[{"type": "subtitle", "time": 2220.55, "timestamp": "00:37:00", "text": "这就是重力。现在已经有了"}, {"type": "subtitle", "time": 2222.79, "timestamp": "00:37:02", "text": "还有一种叫做离心力的东西。"}, {"type": "subtitle", "time": 2224.47, "timestamp": "00:37:04", "text": "你知道，当你挥动某物的时候。"}, {"type": "subtitle", "time": 2226.79, "timestamp": "00:37:06", "text": "它周围的东西有点像是被推开的。"}, {"type": "subtitle", "time": 2230.15, "timestamp": "00:37:10", "text": "向右外侧"}, {"type": "subtitle", "time": 2232.39, "timestamp": "00:37:12", "text": "现在，当你坐在飞机上时，"}, {"type": "subtitle", "time": 2234.27, "timestamp": "00:37:14", "text": "当你转身时"}, {"type": "subtitle", "time": 2237.91, "timestamp": "00:37:17", "text": "飞机几乎总是你在拉你的"}, {"type": "subtitle", "time": 2240.069, "timestamp": "00:37:20", "text": "飞机起飞。如果你想转向"}, {"type": "subtitle", "time": 2242.31, "timestamp": "00:37:22", "text": "没错，你把飞机向右倾斜"}, {"type": "subtitle", "time": 2245.91, "timestamp": "00:37:25", "text": "然后拉。正确的。是的。所以，作为一个"}, {"type": "subtitle", "time": 2247.43, "timestamp": "00:37:27", "text": "坐在里面的飞行员，感觉有点像"}, {"type": "subtitle", "time": 2250.15, "timestamp": "00:37:30", "text": "总是停下来。当你这样做的时候，你"}, {"type": "subtitle", "time": 2252.39, "timestamp": "00:37:32", "text": "画个圈，你就到了"}, {"type": "subtitle", "time": 2253.63, "timestamp": "00:37:33", "text": "外侧"}, {"type": "subtitle", "time": 2257.109, "timestamp": "00:37:37", "text": "圆圈。所以你体验到了那种沉重感。"}, {"type": "subtitle", "time": 2258.349, "timestamp": "00:37:38", "text": "离心"}, {"type": "subtitle", "time": 2262.31, "timestamp": "00:37:42", "text": "力，这被称为重力，例如 g"}, {"type": "subtitle", "time": 2264.109, "timestamp": "00:37:44", "text": "引力"}, {"type": "subtitle", "time": 2266.79, "timestamp": "00:37:46", "text": "力量。这就像地球被……多少次一样"}, {"type": "subtitle", "time": 2270.23, "timestamp": "00:37:50", "text": "你感觉到重力了吗？"}, {"type": "subtitle", "time": 2272.47, "timestamp": "00:37:52", "text": "啊，所以严格来说，如果我加一个称重"}, {"type": "subtitle", "time": 2275.109, "timestamp": "00:37:55", "text": "在你的驾驶舱里，你脚下的秤，如果你"}, {"type": "subtitle", "time": 2278.23, "timestamp": "00:37:58", "text": "你体重大概有100公斤，而且你确实"}]
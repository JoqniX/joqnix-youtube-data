[{"type": "subtitle", "time": 11580.79, "timestamp": "03:13:00", "text": "现在杆上的凸起正好是"}, {"type": "subtitle", "time": 11583.429, "timestamp": "03:13:03", "text": "螺旋桨在那里。所以每次"}, {"type": "subtitle", "time": 11584.79, "timestamp": "03:13:04", "text": "即使你……螺旋桨也会抬起来"}, {"type": "subtitle", "time": 11587.64, "timestamp": "03:13:07", "text": "点击后，枪没有发射。"}, {"type": "subtitle", "time": 11589.11, "timestamp": "03:13:09", "text": "[音乐]"}, {"type": "subtitle", "time": 11590.95, "timestamp": "03:13:10", "text": "而且这一切发生得非常快。这是"}, {"type": "subtitle", "time": 11593.51, "timestamp": "03:13:13", "text": "就像在不到一秒的时间内。所以"}, {"type": "subtitle", "time": 11596.59, "timestamp": "03:13:16", "text": "你以为你在射击你的"}, {"type": "subtitle", "time": 11598.63, "timestamp": "03:13:18", "text": "螺旋桨。与此同时，每次"}, {"type": "subtitle", "time": 11600.309, "timestamp": "03:13:20", "text": "螺旋桨出现在前方"}, {"type": "subtitle", "time": 11608.71, "timestamp": "03:13:28", "text": "哦，触发器会在……之后重新连接。"}, {"type": "subtitle", "time": 11611.67, "timestamp": "03:13:31", "text": "螺旋桨已停止转动。啊，等等。呃，为什么"}, {"type": "subtitle", "time": 11614.389, "timestamp": "03:13:34", "text": "我能否为这个机翼分配一个按钮？"}, {"type": "subtitle", "time": 11616.79, "timestamp": "03:13:36", "text": "扫？"}, {"type": "subtitle", "time": 11619.67, "timestamp": "03:13:39", "text": "好的。编辑坐标轴。点击编辑访问权限。"}, {"type": "subtitle", "time": 11621.59, "timestamp": "03:13:41", "text": "是的，"}, {"type": "subtitle", "time": 11623.75, "timestamp": "03:13:43", "text": "分配按钮。"}, {"type": "chat", "time": 11624.444, "timestamp": "03:13:44", "author": "@BRUCELEE-wt7hk", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kywKa6HSckNVxhER8qedLRRVkcGIqFFytjQHe-071HyMo=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/egJ1XufTKYfegwOo57ewAg"}, {"type": "subtitle", "time": 11631.429, "timestamp": "03:13:51", "text": "是的。我想你必须做出选择"}, {"type": "subtitle", "time": 11635.99, "timestamp": "03:13:55", "text": "价值观。这并非普遍现象。汽车。"}]
[{"type": "subtitle", "time": 1742.95, "timestamp": "00:29:02", "text": "嗯，新游戏当然有。仓库。我"}, {"type": "subtitle", "time": 1745.909, "timestamp": "00:29:05", "text": "试过了。很有趣。"}, {"type": "subtitle", "time": 1749.909, "timestamp": "00:29:09", "text": "我们什么？仓库。一位代表。哦，对。正确的。"}, {"type": "subtitle", "time": 1754.63, "timestamp": "00:29:14", "text": "是的。是的。那游戏真吓人。"}, {"type": "subtitle", "time": 1764.549, "timestamp": "00:29:24", "text": "还有什么呢？我刚才"}, {"type": "subtitle", "time": 1766.87, "timestamp": "00:29:26", "text": "玩上了《极限竞速》。"}, {"type": "subtitle", "time": 1768.63, "timestamp": "00:29:28", "text": "哦"}, {"type": "subtitle", "time": 1772.149, "timestamp": "00:29:32", "text": "是的。就像过去两三周一样。"}, {"type": "subtitle", "time": 1774.63, "timestamp": "00:29:34", "text": "十多年来第一次"}, {"type": "subtitle", "time": 1782.47, "timestamp": "00:29:42", "text": "游戏。就像我玩过的其他赛车游戏一样"}, {"type": "subtitle", "time": 1784.07, "timestamp": "00:29:44", "text": "偶尔玩玩，但最后一次"}, {"type": "subtitle", "time": 1787.11, "timestamp": "00:29:47", "text": "我喜欢认真地、正确地玩耍。"}, {"type": "subtitle", "time": 1790.11, "timestamp": "00:29:50", "text": "一款只关于"}, {"type": "subtitle", "time": 1792.95, "timestamp": "00:29:52", "text": "像往常一样比赛，你知道的，我"}, {"type": "subtitle", "time": 1795.909, "timestamp": "00:29:55", "text": "信奉某种宗教或其他什么宗教"}]
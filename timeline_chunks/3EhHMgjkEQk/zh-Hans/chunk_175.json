[{"type": "subtitle", "time": 10502.75, "timestamp": "02:55:02", "text": "是啊，现代喷气式飞机。惊人的"}, {"type": "subtitle", "time": 10505.309, "timestamp": "02:55:05", "text": "机动性也很好。好的。呃，使用"}, {"type": "subtitle", "time": 10513.19, "timestamp": "02:55:13", "text": "小的。好的。爬一小段路。"}, {"type": "subtitle", "time": 10522.07, "timestamp": "02:55:22", "text": "好了，现在稍等。前往控制面板。"}, {"type": "subtitle", "time": 10525.83, "timestamp": "02:55:25", "text": "呃，我们需要检查是否有移动。"}, {"type": "subtitle", "time": 10528.429, "timestamp": "02:55:28", "text": "我忘了那玩意儿叫什么了。"}, {"type": "subtitle", "time": 10531.67, "timestamp": "02:55:31", "text": "除了肢体动作，还有头部动作。预知能力。"}, {"type": "subtitle", "time": 10534.55, "timestamp": "02:55:34", "text": "哦，原来你看到的是这个。"}, {"type": "subtitle", "time": 10537.51, "timestamp": "02:55:37", "text": "哦，那是浮力。呃，推力"}, {"type": "subtitle", "time": 10539.91, "timestamp": "02:55:39", "text": "向量。"}, {"type": "subtitle", "time": 10543.269, "timestamp": "02:55:43", "text": "你有推力矢量。在哪里？"}, {"type": "subtitle", "time": 10546.309, "timestamp": "02:55:46", "text": "它的按钮是什么？"}, {"type": "subtitle", "time": 10552.309, "timestamp": "02:55:52", "text": "不，不，不，不，不，不。这架飞机"}, {"type": "subtitle", "time": 10554.07, "timestamp": "02:55:54", "text": "没有直肠推进功能。我有点"}, {"type": "subtitle", "time": 10558.07, "timestamp": "02:55:58", "text": "忘了给那东西扣按钮了。"}, {"type": "subtitle", "time": 10559.83, "timestamp": "02:55:59", "text": "嗯，基本上，你没有"}]
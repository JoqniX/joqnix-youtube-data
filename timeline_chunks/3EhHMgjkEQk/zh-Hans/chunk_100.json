[{"type": "subtitle", "time": 6001.109, "timestamp": "01:40:01", "text": "和我进行定制比赛。"}, {"type": "subtitle", "time": 6005.27, "timestamp": "01:40:05", "text": "等等，自定义面具可以获得经验值？"}, {"type": "subtitle", "time": 6007.51, "timestamp": "01:40:07", "text": "我猜也是。所以，我认为它能给你"}, {"type": "subtitle", "time": 6008.51, "timestamp": "01:40:08", "text": "玩家"}, {"type": "subtitle", "time": 6011.109, "timestamp": "01:40:11", "text": "XP。你看，你现在是三级，但是"}, {"type": "subtitle", "time": 6012.629, "timestamp": "01:40:12", "text": "你什么都没得到。"}, {"type": "subtitle", "time": 6014.55, "timestamp": "01:40:14", "text": "你的飞机。"}, {"type": "subtitle", "time": 6016.87, "timestamp": "01:40:16", "text": "所以，即使我从头开始玩"}, {"type": "subtitle", "time": 6018.39, "timestamp": "01:40:18", "text": "这款游戏刚推出时，它将"}, {"type": "subtitle", "time": 6021.59, "timestamp": "01:40:21", "text": "仍然保留着历史。"}, {"type": "subtitle", "time": 6023.669, "timestamp": "01:40:23", "text": "它应该拥有悠久的历史，只要"}, {"type": "subtitle", "time": 6025.83, "timestamp": "01:40:25", "text": "你以前玩过，而且它是"}, {"type": "subtitle", "time": 6029.91, "timestamp": "01:40:29", "text": "同一个账户。它就像Steam一样。"}, {"type": "subtitle", "time": 6032.87, "timestamp": "01:40:32", "text": "除非你以某种神奇的方式成为皇室成员"}, {"type": "subtitle", "time": 6035.83, "timestamp": "01:40:35", "text": "搞砸了账号就会被锁定"}, {"type": "subtitle", "time": 6037.75, "timestamp": "01:40:37", "text": "离开后就无法再次访问了。"}, {"type": "subtitle", "time": 6040.27, "timestamp": "01:40:40", "text": "它会被冲走"}, {"type": "subtitle", "time": 6042.629, "timestamp": "01:40:42", "text": "洗手间。除非这种情况发生，否则你……"}, {"type": "subtitle", "time": 6045.27, "timestamp": "01:40:45", "text": "你所有的Steam内容，对吧？"}, {"type": "subtitle", "time": 6047.109, "timestamp": "01:40:47", "text": "啊，"}, {"type": "subtitle", "time": 6049.51, "timestamp": "01:40:49", "text": "就是这样。"}, {"type": "subtitle", "time": 6052.07, "timestamp": "01:40:52", "text": "该死，"}, {"type": "subtitle", "time": 6053.91, "timestamp": "01:40:53", "text": "我绝对没有暗示什么。"}, {"type": "subtitle", "time": 6056.81, "timestamp": "01:40:56", "text": "这种情况以前发生过。"}, {"type": "subtitle", "time": 6058.39, "timestamp": "01:40:58", "text": "[笑声]"}]
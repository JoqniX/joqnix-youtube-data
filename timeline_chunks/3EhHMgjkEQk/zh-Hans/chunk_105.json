[{"type": "subtitle", "time": 6300.39, "timestamp": "01:45:00", "text": "我怎样才能拿到第二名？你要进去了。"}, {"type": "subtitle", "time": 6302.87, "timestamp": "01:45:02", "text": "街机比赛。选择其他选项"}, {"type": "subtitle", "time": 6304.87, "timestamp": "01:45:04", "text": "国家。或者，你也可以直接选择一个"}, {"type": "subtitle", "time": 6312.109, "timestamp": "01:45:12", "text": "选择 P26。你已经有了。"}, {"type": "subtitle", "time": 6314.87, "timestamp": "01:45:14", "text": "哦，P26。"}, {"type": "subtitle", "time": 6319.35, "timestamp": "01:45:19", "text": "任何一个。两者皆可。或者两者兼有。嗯，是的。"}, {"type": "subtitle", "time": 6322.31, "timestamp": "01:45:22", "text": "好的。好的。打。好的。"}, {"type": "subtitle", "time": 6326.709, "timestamp": "01:45:26", "text": "选择船员。然后是第三个。我"}, {"type": "subtitle", "time": 6329.83, "timestamp": "01:45:29", "text": "还需要。我可以买这个。好的。"}, {"type": "subtitle", "time": 6331.75, "timestamp": "01:45:31", "text": "是的。"}, {"type": "subtitle", "time": 6340.51, "timestamp": "01:45:40", "text": "飞机。你准备好了。我们走吧"}, {"type": "subtitle", "time": 6343.83, "timestamp": "01:45:43", "text": "斗争。现在记住所有基本知识。如何"}, {"type": "subtitle", "time": 6347.59, "timestamp": "01:45:47", "text": "飞机转弯了。你如何拍摄？不"}, {"type": "subtitle", "time": 6349.47, "timestamp": "01:45:49", "text": "继续前进"}, {"type": "subtitle", "time": 6352.55, "timestamp": "01:45:52", "text": "喷洒。不要指着，不要开枪"}, {"type": "subtitle", "time": 6355.83, "timestamp": "01:45:55", "text": "飞机本身。抢先一步射击。正确的。"}]
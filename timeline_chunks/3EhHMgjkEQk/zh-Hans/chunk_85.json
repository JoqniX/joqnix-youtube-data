[{"type": "subtitle", "time": 5102.07, "timestamp": "01:25:02", "text": "我应该搜索什么？应对措施。"}, {"type": "subtitle", "time": 5105.51, "timestamp": "01:25:05", "text": "应对措施。左移 D 键。呃，不。"}, {"type": "subtitle", "time": 5115.39, "timestamp": "01:25:15", "text": "哦好的。好的。回去。我们"}, {"type": "subtitle", "time": 5117.629, "timestamp": "01:25:17", "text": "不是"}, {"type": "subtitle", "time": 5120.35, "timestamp": "01:25:20", "text": "看？你看，什么也没有"}, {"type": "subtitle", "time": 5123.59, "timestamp": "01:25:23", "text": "在职的。 C 语言无法正常运行。"}, {"type": "subtitle", "time": 5125.75, "timestamp": "01:25:25", "text": "不，你应该按C键。你可以"}, {"type": "subtitle", "time": 5128.59, "timestamp": "01:25:28", "text": "直接按C就行了。不，不是这样的。"}, {"type": "subtitle", "time": 5131.189, "timestamp": "01:25:31", "text": "在职的。哦，我得挪一下鼠标。"}, {"type": "subtitle", "time": 5139.51, "timestamp": "01:25:39", "text": "替代你一直按所有 D 键。"}, {"type": "subtitle", "time": 5142.95, "timestamp": "01:25:42", "text": "这是免费的。哦，不。一名玩家。我"}, {"type": "subtitle", "time": 5144.79, "timestamp": "01:25:44", "text": "你看。数量有限，但是"}, {"type": "subtitle", "time": 5148.31, "timestamp": "01:25:48", "text": "是的，你不用为此付费。"}, {"type": "subtitle", "time": 5151.43, "timestamp": "01:25:51", "text": "是的。那么，谁会去？谁是“什么”？"}, {"type": "subtitle", "time": 5153.51, "timestamp": "01:25:53", "text": "我的天啊。谁在射杀我？你有"}, {"type": "subtitle", "time": 5157.11, "timestamp": "01:25:57", "text": "转身离开。是机器人。这是一个"}, {"type": "subtitle", "time": 5158.629, "timestamp": "01:25:58", "text": "非玩家角色。"}]
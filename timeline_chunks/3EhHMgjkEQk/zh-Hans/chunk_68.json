[{"type": "subtitle", "time": 4081.829, "timestamp": "01:08:01", "text": "现实就是如此，你可以那样玩。现在"}, {"type": "subtitle", "time": 4084.549, "timestamp": "01:08:04", "text": "问题在于，它相对而言比较少见。"}, {"type": "subtitle", "time": 4087.75, "timestamp": "01:08:07", "text": "慢的。打败它需要很长时间"}, {"type": "subtitle", "time": 4090.63, "timestamp": "01:08:10", "text": "要么找另一个人，要么你得走运。"}, {"type": "subtitle", "time": 4092.95, "timestamp": "01:08:12", "text": "类似暴击的攻击通常"}, {"type": "subtitle", "time": 4096.07, "timestamp": "01:08:16", "text": "这种情况不会发生，而且涉及距离。"}, {"type": "subtitle", "time": 4097.47, "timestamp": "01:08:17", "text": "比如10"}, {"type": "subtitle", "time": 4099.91, "timestamp": "01:08:19", "text": "公里。哦，所以你真的必须"}, {"type": "subtitle", "time": 4103.189, "timestamp": "01:08:23", "text": "瞄准船的前方，这是一种技巧。"}, {"type": "subtitle", "time": 4106.63, "timestamp": "01:08:26", "text": "你在游戏中不断成长。你开枪"}, {"type": "subtitle", "time": 4112.95, "timestamp": "01:08:32", "text": "然后你等大约30秒。"}, {"type": "subtitle", "time": 4114.87, "timestamp": "01:08:34", "text": "因为在那30秒内，你的回合数是"}, {"type": "subtitle", "time": 4116.709, "timestamp": "01:08:36", "text": "在空中飞行，你的枪也是"}, {"type": "subtitle", "time": 4125.349, "timestamp": "01:08:45", "text": "这也是原因之一。"}, {"type": "subtitle", "time": 4127.829, "timestamp": "01:08:47", "text": "人们不会在《战争》中玩战舰游戏"}, {"type": "subtitle", "time": 4130.07, "timestamp": "01:08:50", "text": "雷。但还有另一个原因"}, {"type": "subtitle", "time": 4134.229, "timestamp": "01:08:54", "text": "War Thunder 的用户界面简直糟糕透了。"}, {"type": "subtitle", "time": 4136.55, "timestamp": "01:08:56", "text": "适用于《战争雷霆》。"}]
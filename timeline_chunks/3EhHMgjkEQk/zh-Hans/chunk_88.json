[{"type": "subtitle", "time": 5281.28, "timestamp": "01:28:01", "text": "向上，你的飞机仍在继续飞行 向下，因为惯性太大了。"}, {"type": "subtitle", "time": 5284.52, "timestamp": "01:28:04", "text": "向下，因为惯性太大了。 更多的。具体来说，在喷气式飞机上发生的"}, {"type": "subtitle", "time": 5287.12, "timestamp": "01:28:07", "text": "更多的。具体来说，在喷气式飞机上发生的 很多。所以你必须小心，不要……"}, {"type": "subtitle", "time": 5289.36, "timestamp": "01:28:09", "text": "很多。所以你必须小心，不要…… 也停下来了"}, {"type": "subtitle", "time": 5291.719, "timestamp": "01:28:11", "text": "也停下来了 晚的。"}, {"type": "subtitle", "time": 5300.31, "timestamp": "01:28:20", "text": "呃，现在按C键。还有一点点……"}, {"type": "subtitle", "time": 5301.83, "timestamp": "01:28:21", "text": "在你足够接近之前的时间"}, {"type": "subtitle", "time": 5304.47, "timestamp": "01:28:24", "text": "飞机。现在按下 O 键，同时像这样"}, {"type": "subtitle", "time": 5311.27, "timestamp": "01:28:31", "text": "哦，这是你的X光片。"}, {"type": "subtitle", "time": 5313.59, "timestamp": "01:28:33", "text": "飞机。如果你受伤了，你会想要"}, {"type": "subtitle", "time": 5315.35, "timestamp": "01:28:35", "text": "仔细检查一下你的伤势究竟在哪里。"}, {"type": "subtitle", "time": 5318.229, "timestamp": "01:28:38", "text": "你可以在战斗中途这样做。"}, {"type": "subtitle", "time": 5321.75, "timestamp": "01:28:41", "text": "好的。你可以获得你的二维视图"}, {"type": "subtitle", "time": 5323.27, "timestamp": "01:28:43", "text": "左下角的飞机"}, {"type": "subtitle", "time": 5325.31, "timestamp": "01:28:45", "text": "屏幕上会显示你受到的伤害。"}, {"type": "subtitle", "time": 5327.75, "timestamp": "01:28:47", "text": "虽然有损坏，但你可以用3D方式查看。"}]
[{"type": "subtitle", "time": 14466.51, "timestamp": "04:01:06", "text": "选择一个"}, {"type": "subtitle", "time": 14468.95, "timestamp": "04:01:08", "text": "像这样的街道应该就在……"}, {"type": "subtitle", "time": 14470.83, "timestamp": "04:01:10", "text": "前面"}, {"type": "subtitle", "time": 14475.429, "timestamp": "04:01:15", "text": "你去看看。"}, {"type": "subtitle", "time": 14478.07, "timestamp": "04:01:18", "text": "哦，你已经跑出我的视线范围了。我有"}, {"type": "subtitle", "time": 14480.389, "timestamp": "04:01:20", "text": "存在。哦，我已经超出你的距离了。"}, {"type": "subtitle", "time": 14481.59, "timestamp": "04:01:21", "text": "等等，等等，等等，等等。待在那儿。停留"}, {"type": "subtitle", "time": 14483.03, "timestamp": "04:01:23", "text": "那里。我会朝你走来。你继续"}, {"type": "subtitle", "time": 14485.429, "timestamp": "04:01:25", "text": "看着那条路。我会从……进来"}, {"type": "subtitle", "time": 14496.71, "timestamp": "04:01:36", "text": "哦，否则照这个速度下去，我们可能就……"}, {"type": "subtitle", "time": 14500.9, "timestamp": "04:01:40", "text": "碰撞。不，直接走就行了。"}, {"type": "subtitle", "time": 14503.59, "timestamp": "04:01:43", "text": "[音乐]"}, {"type": "chat", "time": 14504.995, "timestamp": "04:01:44", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "imagine flying"}, {"type": "subtitle", "time": 14505.75, "timestamp": "04:01:45", "text": "我的意思就是这样。"}, {"type": "subtitle", "time": 14508.229, "timestamp": "04:01:48", "text": "哦，尾部控制系统崩溃了。那是"}, {"type": "subtitle", "time": 14512.15, "timestamp": "04:01:52", "text": "好的。哦，我打到你了吗？是的。哦，"}, {"type": "subtitle", "time": 14514.75, "timestamp": "04:01:54", "text": "拉屎。我的错。"}, {"type": "subtitle", "time": 14516.63, "timestamp": "04:01:56", "text": "好的。"}, {"type": "subtitle", "time": 14518.389, "timestamp": "04:01:58", "text": "我们去另一个城市吧。真的击中了"}]
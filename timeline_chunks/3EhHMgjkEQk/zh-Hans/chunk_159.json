[{"type": "subtitle", "time": 9541.23, "timestamp": "02:39:01", "text": "否则你就得……"}, {"type": "subtitle", "time": 9544.07, "timestamp": "02:39:04", "text": "支付大量真金白银"}, {"type": "subtitle", "time": 9547.03, "timestamp": "02:39:07", "text": "如果失败了，之后再拿飞机。"}, {"type": "subtitle", "time": 9549.19, "timestamp": "02:39:09", "text": "哦。"}, {"type": "subtitle", "time": 9551.91, "timestamp": "02:39:11", "text": "现在，就他们是否采用最新技术而言……"}, {"type": "subtitle", "time": 9555.11, "timestamp": "02:39:15", "text": "东西？接近最新"}, {"type": "subtitle", "time": 9557.67, "timestamp": "02:39:17", "text": "他们放进去的东西是一架法国飞机"}, {"type": "subtitle", "time": 9561.83, "timestamp": "02:39:21", "text": "那是2010年代初期的东西。"}, {"type": "subtitle", "time": 9568.27, "timestamp": "02:39:28", "text": "但对我们来说"}, {"type": "subtitle", "time": 9571.51, "timestamp": "02:39:31", "text": "明白了，这是2010年代的，因为……"}, {"type": "subtitle", "time": 9573.349, "timestamp": "02:39:33", "text": "飞机还在飞行，而且"}, {"type": "subtitle", "time": 9577.349, "timestamp": "02:39:37", "text": "被认为是最新、最高级别的之一"}, {"type": "subtitle", "time": 9580.03, "timestamp": "02:39:40", "text": "美国以外的技术飞机"}, {"type": "subtitle", "time": 9583.03, "timestamp": "02:39:43", "text": "飞机。所以，请前往法国科技树。"}, {"type": "subtitle", "time": 9585.59, "timestamp": "02:39:45", "text": "你可以把它展示给你的观众。还，"}, {"type": "subtitle", "time": 9587.27, "timestamp": "02:39:47", "text": "我无法实时看到，所以我不会"}, {"type": "subtitle", "time": 9589.67, "timestamp": "02:39:49", "text": "能够实时指导您。好的，"}, {"type": "subtitle", "time": 9592.389, "timestamp": "02:39:52", "text": "朋友们。"}, {"type": "subtitle", "time": 9594.07, "timestamp": "02:39:54", "text": "研究。"}]
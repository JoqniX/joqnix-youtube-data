[{"type": "subtitle", "time": 5640.07, "timestamp": "01:34:00", "text": "导弹就是你玩游戏的方式，而你"}, {"type": "subtitle", "time": 5642.07, "timestamp": "01:34:02", "text": "解锁。你知道全部事情的来龙去脉"}, {"type": "subtitle", "time": 5644.07, "timestamp": "01:34:04", "text": "教你如何获得股票"}, {"type": "subtitle", "time": 5645.35, "timestamp": "01:34:05", "text": "该飞机的版本，然后你"}, {"type": "subtitle", "time": 5647.99, "timestamp": "01:34:07", "text": "升级它。"}, {"type": "subtitle", "time": 5656.709, "timestamp": "01:34:16", "text": "那。现在你可以用任何一种方式携带它"}, {"type": "subtitle", "time": 5681.03, "timestamp": "01:34:41", "text": "哦，没子弹了。好的，"}, {"type": "subtitle", "time": 5687.83, "timestamp": "01:34:47", "text": "去。好的。好的。所以，这就是方法。"}, {"type": "subtitle", "time": 5691.91, "timestamp": "01:34:51", "text": "这将是一场真实的战斗。呃，"}, {"type": "subtitle", "time": 5694.629, "timestamp": "01:34:54", "text": "我不会称之为真实的战斗。所以"}, {"type": "subtitle", "time": 5696.709, "timestamp": "01:34:56", "text": "就游戏模式而言，《战争雷霆》"}, {"type": "subtitle", "time": 5699.11, "timestamp": "01:34:59", "text": "共有三种游戏模式。如果你是这么说的话"}]
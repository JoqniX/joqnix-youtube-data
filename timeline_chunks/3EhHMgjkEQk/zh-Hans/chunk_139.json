[{"type": "subtitle", "time": 8340.79, "timestamp": "02:19:00", "text": "可以乘飞机去，但现在不行。"}, {"type": "subtitle", "time": 8343.03, "timestamp": "02:19:03", "text": "最佳时机，因为有一辆敌方坦克"}, {"type": "subtitle", "time": 8344.83, "timestamp": "02:19:04", "text": "就在前面"}, {"type": "subtitle", "time": 8348.07, "timestamp": "02:19:08", "text": "我。这里还有其他人。"}, {"type": "subtitle", "time": 8351.23, "timestamp": "02:19:11", "text": "也一样。所以如果我是"}, {"type": "subtitle", "time": 8353.469, "timestamp": "02:19:13", "text": "喜欢"}, {"type": "subtitle", "time": 8357.669, "timestamp": "02:19:17", "text": "就算你要那样做，我也不会那样做。"}, {"type": "subtitle", "time": 8360.709, "timestamp": "02:19:20", "text": "做到。"}, {"type": "subtitle", "time": 8362.389, "timestamp": "02:19:22", "text": "因为那辆坦克的正面装甲太厚了。"}, {"type": "subtitle", "time": 8364.629, "timestamp": "02:19:24", "text": "强的。我只有子弹。我没有"}, {"type": "subtitle", "time": 8368.19, "timestamp": "02:19:28", "text": "有真正的坦克炮弹。"}, {"type": "subtitle", "time": 8374.309, "timestamp": "02:19:34", "text": "啊。所以如果我……呃，如果我像"}, {"type": "subtitle", "time": 8375.389, "timestamp": "02:19:35", "text": "转变"}, {"type": "subtitle", "time": 8378.709, "timestamp": "02:19:38", "text": "飞机上，那东西会是自动驾驶的吗？"}, {"type": "subtitle", "time": 8380.709, "timestamp": "02:19:40", "text": "NPC？"}, {"type": "subtitle", "time": 8383.429, "timestamp": "02:19:43", "text": "它会一直保持暂停状态。哇。所以"}, {"type": "subtitle", "time": 8385.349, "timestamp": "02:19:45", "text": "你必须把你的坦克藏在一个……"}, {"type": "subtitle", "time": 8390.79, "timestamp": "02:19:50", "text": "假设你身处一个坦克中，而你……"}, {"type": "subtitle", "time": 8392.79, "timestamp": "02:19:52", "text": "在前线战斗，而你"}, {"type": "subtitle", "time": 8394.03, "timestamp": "02:19:54", "text": "选择一个"}, {"type": "subtitle", "time": 8396.469, "timestamp": "02:19:56", "text": "飞机很可能在那时"}]
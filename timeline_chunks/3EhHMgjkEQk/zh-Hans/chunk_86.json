[{"type": "subtitle", "time": 5160.31, "timestamp": "01:26:00", "text": "所以，你看到那些红点了吗？"}, {"type": "subtitle", "time": 5163.35, "timestamp": "01:26:03", "text": "地面，对吧？是的。它们是防空武器。"}, {"type": "subtitle", "time": 5165.43, "timestamp": "01:26:05", "text": "系统。不要直接冲上去。它将"}, {"type": "subtitle", "time": 5168.87, "timestamp": "01:26:08", "text": "把你射下去。别理它。"}, {"type": "subtitle", "time": 5171.669, "timestamp": "01:26:11", "text": "现在避免这种情况的方法是……"}, {"type": "subtitle", "time": 5174.11, "timestamp": "01:26:14", "text": "朝着它飞去"}, {"type": "subtitle", "time": 5183.669, "timestamp": "01:26:23", "text": "向上。现在通常在左边你会看到"}, {"type": "subtitle", "time": 5187.11, "timestamp": "01:26:27", "text": "警告。是的。"}, {"type": "subtitle", "time": 5189.43, "timestamp": "01:26:29", "text": "所以右边是你的雷达，左边是"}, {"type": "subtitle", "time": 5191.51, "timestamp": "01:26:31", "text": "你的警告。"}, {"type": "subtitle", "time": 5193.99, "timestamp": "01:26:33", "text": "现在，在屏幕的左上角，"}, {"type": "subtitle", "time": 5196.229, "timestamp": "01:26:36", "text": "左下角，可以看到一些红点。"}, {"type": "subtitle", "time": 5199.59, "timestamp": "01:26:39", "text": "天空。向左转。"}, {"type": "subtitle", "time": 5201.669, "timestamp": "01:26:41", "text": "红点。我想你会看到红点"}, {"type": "subtitle", "time": 5204.31, "timestamp": "01:26:44", "text": "天空。啊，你高度不够。"}, {"type": "subtitle", "time": 5209.35, "timestamp": "01:26:49", "text": "如果你想测试你的导弹，"}, {"type": "subtitle", "time": 5211.189, "timestamp": "01:26:51", "text": "你必须朝着那些飞机的方向走去。"}, {"type": "subtitle", "time": 5214.229, "timestamp": "01:26:54", "text": "现在，向左转。左急转弯。锋利的"}, {"type": "subtitle", "time": 5217.91, "timestamp": "01:26:57", "text": "左边。是的。是的。那些台词。是的。是的。"}]
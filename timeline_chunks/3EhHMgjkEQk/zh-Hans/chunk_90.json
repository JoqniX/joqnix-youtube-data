[{"type": "subtitle", "time": 5402.629, "timestamp": "01:30:02", "text": "备用地面空间。左 Ctrl Alt。"}, {"type": "subtitle", "time": 5405.51, "timestamp": "01:30:05", "text": "好的。稍等。附近没有飞机。"}, {"type": "subtitle", "time": 5411.149, "timestamp": "01:30:11", "text": "大约。去你刚才坐的飞机"}, {"type": "subtitle", "time": 5413.07, "timestamp": "01:30:13", "text": "交叉"}, {"type": "subtitle", "time": 5415.83, "timestamp": "01:30:15", "text": "并努力支持它。你不会"}, {"type": "subtitle", "time": 5417.79, "timestamp": "01:30:17", "text": "能够从前方发射"}, {"type": "subtitle", "time": 5420.149, "timestamp": "01:30:20", "text": "它。现在，你想知道为什么吗？"}, {"type": "subtitle", "time": 5423.59, "timestamp": "01:30:23", "text": "那？为什么？"}, {"type": "subtitle", "time": 5426.149, "timestamp": "01:30:26", "text": "导弹还是新鲜事物的年代"}, {"type": "subtitle", "time": 5428.79, "timestamp": "01:30:28", "text": "它们只是看起来像摄像头的导弹。"}, {"type": "subtitle", "time": 5431.91, "timestamp": "01:30:31", "text": "为了给敌机提供热量，发动机"}, {"type": "subtitle", "time": 5432.99, "timestamp": "01:30:32", "text": "排气"}, {"type": "subtitle", "time": 5435.99, "timestamp": "01:30:35", "text": "高温，还有他们，你知道的，新技术。"}, {"type": "subtitle", "time": 5438.55, "timestamp": "01:30:38", "text": "他们不够优秀。所以你可以"}, {"type": "subtitle", "time": 5441.27, "timestamp": "01:30:41", "text": "只能看到背面的热量。那是"}, {"type": "subtitle", "time": 5442.79, "timestamp": "01:30:42", "text": "为什么这些导弹只有在以下情况下才能发挥作用"}, {"type": "subtitle", "time": 5446.31, "timestamp": "01:30:46", "text": "你位于敌机后方。"}, {"type": "subtitle", "time": 5450.31, "timestamp": "01:30:50", "text": "啊，现在将内圆指向……"}, {"type": "subtitle", "time": 5452.03, "timestamp": "01:30:52", "text": "敌人"}, {"type": "subtitle", "time": 5455.47, "timestamp": "01:30:55", "text": "按下按钮"}, {"type": "subtitle", "time": 5457.95, "timestamp": "01:30:57", "text": "再次。好的，要点"}]
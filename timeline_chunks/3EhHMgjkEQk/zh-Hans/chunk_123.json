[{"type": "subtitle", "time": 7380.95, "timestamp": "02:03:00", "text": "呃，这是个特别活动。"}, {"type": "subtitle", "time": 7383.03, "timestamp": "02:03:03", "text": "所以，不是每个人都能得到。"}, {"type": "subtitle", "time": 7386.39, "timestamp": "02:03:06", "text": "它。它属于装饰品类。所以，"}, {"type": "subtitle", "time": 7389.51, "timestamp": "02:03:09", "text": "当你进行修改时"}, {"type": "subtitle", "time": 7391.75, "timestamp": "02:03:11", "text": "或者等等，不要修改。在哪里？"}, {"type": "subtitle", "time": 7394.709, "timestamp": "02:03:14", "text": "它？物品商店。"}, {"type": "subtitle", "time": 7396.31, "timestamp": "02:03:16", "text": "不，你"}, {"type": "subtitle", "time": 7397.91, "timestamp": "02:03:17", "text": "呃，你点击你的飞机，你就会得到"}, {"type": "subtitle", "time": 7400.79, "timestamp": "02:03:20", "text": "定制化。"}, {"type": "subtitle", "time": 7404.87, "timestamp": "02:03:24", "text": "好的。在自定义设置中，你可以获得皮肤。"}, {"type": "subtitle", "time": 7406.189, "timestamp": "02:03:26", "text": "和"}, {"type": "subtitle", "time": 7409.03, "timestamp": "02:03:29", "text": "伪装。但是对于坦克来说，你必须"}, {"type": "subtitle", "time": 7410.91, "timestamp": "02:03:30", "text": "改用坦克"}, {"type": "subtitle", "time": 7413.43, "timestamp": "02:03:33", "text": "那。因为在飞机上，你不能放"}, {"type": "subtitle", "time": 7415.83, "timestamp": "02:03:35", "text": "飞机顶部的任何东西。在"}, {"type": "subtitle", "time": 7417.51, "timestamp": "02:03:37", "text": "坦克上可以放置东西。"}, {"type": "subtitle", "time": 7419.669, "timestamp": "02:03:39", "text": "坦克。"}, {"type": "subtitle", "time": 7422.669, "timestamp": "02:03:42", "text": "你还会得到另一个东西，叫做"}, {"type": "subtitle", "time": 7430.709, "timestamp": "02:03:50", "text": "我们聊天群里也有人。你好。"}, {"type": "subtitle", "time": 7431.629, "timestamp": "02:03:51", "text": "你好"}, {"type": "subtitle", "time": 7436.149, "timestamp": "02:03:56", "text": "尚。晚上好/进来吧。"}, {"type": "subtitle", "time": 7439.589, "timestamp": "02:03:59", "text": "欢迎。欢迎。你是同伴吗？"}]
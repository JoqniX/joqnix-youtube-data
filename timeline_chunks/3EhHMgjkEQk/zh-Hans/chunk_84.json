[{"type": "subtitle", "time": 5041.35, "timestamp": "01:24:01", "text": "乐趣。离开飞机。我被枪击了。"}, {"type": "subtitle", "time": 5043.35, "timestamp": "01:24:03", "text": "哦，不错。"}, {"type": "subtitle", "time": 5053.99, "timestamp": "01:24:13", "text": "该死。你拥有一个弹射座椅。哇哦。"}, {"type": "subtitle", "time": 5056.95, "timestamp": "01:24:16", "text": "顺便一提，你还能获得加力燃烧室。如果"}, {"type": "subtitle", "time": 5060.149, "timestamp": "01:24:20", "text": "你拉远镜头，就像开了加力燃烧室一样。"}, {"type": "subtitle", "time": 5063.03, "timestamp": "01:24:23", "text": "加力燃烧室。这是大写锁定键吗？"}, {"type": "subtitle", "time": 5065.43, "timestamp": "01:24:25", "text": "那玩意儿？"}, {"type": "subtitle", "time": 5068.07, "timestamp": "01:24:28", "text": "哦，那是你们的导弹。"}, {"type": "subtitle", "time": 5071.03, "timestamp": "01:24:31", "text": "哇。"}, {"type": "subtitle", "time": 5074.31, "timestamp": "01:24:34", "text": "你有闪光弹和豺狼。所以按Y。呃。"}, {"type": "subtitle", "time": 5082.229, "timestamp": "01:24:42", "text": "好的。好的。击中 Y"}, {"type": "subtitle", "time": 5085.27, "timestamp": "01:24:45", "text": "多功能。等等。是的。别走"}, {"type": "subtitle", "time": 5089.51, "timestamp": "01:24:49", "text": "返回您的菜单。请查看您的菜单"}, {"type": "subtitle", "time": 5092.79, "timestamp": "01:24:52", "text": "你的按钮是什么？因为你还没有……"}, {"type": "subtitle", "time": 5094.709, "timestamp": "01:24:54", "text": "自定义按键绑定完成了，对吧？你有"}, {"type": "subtitle", "time": 5097.99, "timestamp": "01:24:57", "text": "检查您的基本按键绑定。嗯，什么"}]
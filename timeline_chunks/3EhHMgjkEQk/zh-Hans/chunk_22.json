[{"type": "subtitle", "time": 1321.35, "timestamp": "00:22:01", "text": "比如切换到BBI模式并进行设置"}, {"type": "subtitle", "time": 1323.83, "timestamp": "00:22:03", "text": "向上，然后切换到右。我当时"}, {"type": "subtitle", "time": 1325.59, "timestamp": "00:22:05", "text": "其实我之前就想问你了，就像"}, {"type": "subtitle", "time": 1327.99, "timestamp": "00:22:07", "text": "你想测试所有功能吗？"}, {"type": "subtitle", "time": 1331.43, "timestamp": "00:22:11", "text": "在我们开始之前？"}, {"type": "subtitle", "time": 1346.31, "timestamp": "00:22:26", "text": "我今天睡了一整天。"}, {"type": "subtitle", "time": 1356.07, "timestamp": "00:22:36", "text": "我的天啊。我一直努力"}, {"type": "subtitle", "time": 1357.59, "timestamp": "00:22:37", "text": "睡觉"}, {"type": "subtitle", "time": 1362.149, "timestamp": "00:22:42", "text": "而且喜欢项目工作。我的天啊。哦"}, {"type": "subtitle", "time": 1364.63, "timestamp": "00:22:44", "text": "我的上帝。痛苦。非常痛苦。"}, {"type": "subtitle", "time": 1366.23, "timestamp": "00:22:46", "text": "工作太多了。我想回去"}, {"type": "subtitle", "time": 1368.31, "timestamp": "00:22:48", "text": "开始工作。"}, {"type": "subtitle", "time": 1369.75, "timestamp": "00:22:49", "text": "当你真正投入工作时，工作量就会减少。"}, {"type": "subtitle", "time": 1371.37, "timestamp": "00:22:51", "text": "在职的。"}, {"type": "subtitle", "time": 1379.19, "timestamp": "00:22:59", "text": "你最近怎么样？我只听见你这么说"}]
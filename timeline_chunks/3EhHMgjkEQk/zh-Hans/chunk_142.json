[{"type": "subtitle", "time": 8520.27, "timestamp": "02:22:00", "text": "和喜欢的人一起玩游戏"}, {"type": "subtitle", "time": 8522.63, "timestamp": "02:22:02", "text": "一些创作者链接之类的。那是"}, {"type": "subtitle", "time": 8525.19, "timestamp": "02:22:05", "text": "为什么您可能需要支付额外费用。"}, {"type": "subtitle", "time": 8527.19, "timestamp": "02:22:07", "text": "我愿意。"}, {"type": "subtitle", "time": 8530.55, "timestamp": "02:22:10", "text": "等等，你有一架高级飞机，对吧？"}, {"type": "subtitle", "time": 8533.59, "timestamp": "02:22:13", "text": "是的。你可能用某种方式得到了它"}, {"type": "subtitle", "time": 8541.91, "timestamp": "02:22:21", "text": "有可能。等等，它是免费的吗？还是收费的？"}, {"type": "subtitle", "time": 8544.07, "timestamp": "02:22:24", "text": "没有上帝吗？好的，就是你"}, {"type": "subtitle", "time": 8546.87, "timestamp": "02:22:26", "text": "拥有是免费的。它是你的。它归你所有。"}, {"type": "subtitle", "time": 8548.87, "timestamp": "02:22:28", "text": "嗯。"}]
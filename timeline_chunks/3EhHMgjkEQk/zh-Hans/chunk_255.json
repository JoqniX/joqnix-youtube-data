[{"type": "subtitle", "time": 15301.99, "timestamp": "04:15:01", "text": "和其他游戏一样。明白了。"}, {"type": "subtitle", "time": 15306.59, "timestamp": "04:15:06", "text": "然后你还要等1、2、3、4"}, {"type": "subtitle", "time": 15309.99, "timestamp": "04:15:09", "text": "我之前跟你说过22号或24号的事"}, {"type": "subtitle", "time": 15312.309, "timestamp": "04:15:12", "text": "他们会举办这个活动的。"}, {"type": "subtitle", "time": 15313.67, "timestamp": "04:15:13", "text": "是的。他们要去哪里"}, {"type": "subtitle", "time": 15316.309, "timestamp": "04:15:16", "text": "20世纪60年代的印度飞机。"}, {"type": "subtitle", "time": 15318.55, "timestamp": "04:15:18", "text": "嗯。你只需要去……"}, {"type": "subtitle", "time": 15321.11, "timestamp": "04:15:21", "text": "活动，激活活动，然后就可以玩了。"}, {"type": "subtitle", "time": 15322.71, "timestamp": "04:15:22", "text": "就像火腿一样。你必须拼尽全力去玩。"}, {"type": "subtitle", "time": 15325.429, "timestamp": "04:15:25", "text": "它会显示一个酒吧"}, {"type": "subtitle", "time": 15327.189, "timestamp": "04:15:27", "text": "就像 Scotton 的车辆一样。每两个"}, {"type": "subtitle", "time": 15329.67, "timestamp": "04:15:29", "text": "你需要花几天时间填满一个新的吧台，"}, {"type": "subtitle", "time": 15331.189, "timestamp": "04:15:31", "text": "吧台前会排起长队。你有"}, {"type": "subtitle", "time": 15333.99, "timestamp": "04:15:33", "text": "每天都要越过酒吧的界限。"}, {"type": "subtitle", "time": 15336.07, "timestamp": "04:15:36", "text": "你肯定不会错过。你只能错过它"}, {"type": "subtitle", "time": 15338.79, "timestamp": "04:15:38", "text": "一次。它给了你一次不达标的机会。"}, {"type": "subtitle", "time": 15341.11, "timestamp": "04:15:41", "text": "要求。所以，一共会有八个。"}, {"type": "subtitle", "time": 15348.07, "timestamp": "04:15:48", "text": "你可以错过这八个中的一个。"}, {"type": "subtitle", "time": 15350.229, "timestamp": "04:15:50", "text": "机会，或者九次机会。一人"}, {"type": "subtitle", "time": 15354.07, "timestamp": "04:15:54", "text": "那九次机会。是的。如果你这样做的话"}, {"type": "subtitle", "time": 15356.87, "timestamp": "04:15:56", "text": "所有这些，你都能获得那条车道。"}]
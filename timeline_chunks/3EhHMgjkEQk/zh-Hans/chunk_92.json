[{"type": "subtitle", "time": 5520.55, "timestamp": "01:32:00", "text": "战争时期公认的法律是：你不能开枪。"}, {"type": "subtitle", "time": 5522.07, "timestamp": "01:32:02", "text": "一个像你知道的那样跳伞的飞行员"}, {"type": "subtitle", "time": 5525.27, "timestamp": "01:32:05", "text": "注入舒适感。"}, {"type": "subtitle", "time": 5527.27, "timestamp": "01:32:07", "text": "历史上发生过两起著名的事件"}, {"type": "subtitle", "time": 5531.59, "timestamp": "01:32:11", "text": "太平洋，曾经有日本人"}, {"type": "subtitle", "time": 5534.03, "timestamp": "01:32:14", "text": "飞行员没有遵守规定"}, {"type": "subtitle", "time": 5537.91, "timestamp": "01:32:17", "text": "规则，他还射杀了不少美国人。"}, {"type": "subtitle", "time": 5541.11, "timestamp": "01:32:21", "text": "飞行员，然后其中一名队友……"}, {"type": "subtitle", "time": 5543.87, "timestamp": "01:32:23", "text": "有机会击落这架日本飞机"}, {"type": "subtitle", "time": 5546.47, "timestamp": "01:32:26", "text": "飞行员和飞行员就像无助的……"}, {"type": "subtitle", "time": 5548.79, "timestamp": "01:32:28", "text": "水和美国飞行员真的"}, {"type": "subtitle", "time": 5550.95, "timestamp": "01:32:30", "text": "想杀了他，你知道的。"}, {"type": "subtitle", "time": 5553.99, "timestamp": "01:32:33", "text": "地面，但最后一秒他就像……"}, {"type": "subtitle", "time": 5555.83, "timestamp": "01:32:35", "text": "他很有人情味，最终……"}, {"type": "subtitle", "time": 5556.669, "timestamp": "01:32:36", "text": "投掷"}, {"type": "subtitle", "time": 5563.27, "timestamp": "01:32:43", "text": "漂浮物拯救日本飞行员"}, {"type": "subtitle", "time": 5565.99, "timestamp": "01:32:45", "text": "而不是开枪射击。那是其中之一。"}, {"type": "subtitle", "time": 5567.83, "timestamp": "01:32:47", "text": "还有另一次事件，我"}, {"type": "subtitle", "time": 5569.669, "timestamp": "01:32:49", "text": "再次确认那是一名日本飞行员"}, {"type": "subtitle", "time": 5572.149, "timestamp": "01:32:52", "text": "他试图喜欢上一位美国飞行员"}, {"type": "subtitle", "time": 5574.149, "timestamp": "01:32:54", "text": "已经弹出"}, {"type": "subtitle", "time": 5575.91, "timestamp": "01:32:55", "text": "一名日本飞行员试图杀死"}, {"type": "subtitle", "time": 5577.83, "timestamp": "01:32:57", "text": "他开着飞机去了那里。"}]
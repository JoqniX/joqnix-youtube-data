[{"type": "subtitle", "time": 7320.95, "timestamp": "02:02:00", "text": "但后来你又觉得你不应该……"}, {"type": "subtitle", "time": 7327.189, "timestamp": "02:02:07", "text": "哦，我之前有个疑问。我该如何获得"}, {"type": "subtitle", "time": 7338.229, "timestamp": "02:02:18", "text": "是的，各位。你知道乔，你"}, {"type": "subtitle", "time": 7341.669, "timestamp": "02:02:21", "text": "知道获取变得多么容易"}, {"type": "subtitle", "time": 7345.03, "timestamp": "02:02:25", "text": "当我告诉他们我喜欢《战争雷霆》时，他们都很喜欢。"}, {"type": "subtitle", "time": 7346.87, "timestamp": "02:02:26", "text": "有老婆抱枕，还有"}, {"type": "subtitle", "time": 7349.229, "timestamp": "02:02:29", "text": "战争的老婆皮肤"}, {"type": "subtitle", "time": 7351.91, "timestamp": "02:02:31", "text": "雷。就像你可以拥有老婆皮肤一样"}, {"type": "subtitle", "time": 7360.95, "timestamp": "02:02:40", "text": "汽车。你也可以选择经典款"}, {"type": "subtitle", "time": 7362.47, "timestamp": "02:02:42", "text": "就像二战那样，你知道的。"}, {"type": "subtitle", "time": 7365.03, "timestamp": "02:02:45", "text": "电影里有妻子的照片"}, {"type": "subtitle", "time": 7368.55, "timestamp": "02:02:48", "text": "在驾驶舱内。是的，你可以拥有你的"}, {"type": "subtitle", "time": 7377.189, "timestamp": "02:02:57", "text": "所以，我认为，尤其是枕头。"}]
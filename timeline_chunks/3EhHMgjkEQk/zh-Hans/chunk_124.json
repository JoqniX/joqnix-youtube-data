[{"type": "subtitle", "time": 7441.07, "timestamp": "02:04:01", "text": "享受者"}, {"type": "subtitle", "time": 7444.629, "timestamp": "02:04:04", "text": "雷霆队的比赛？"}, {"type": "subtitle", "time": 7447.99, "timestamp": "02:04:07", "text": "雷霆游戏，里面有砰砰的射击声"}, {"type": "subtitle", "time": 7451.91, "timestamp": "02:04:11", "text": "飞机、坦克，还有所有人"}, {"type": "subtitle", "time": 7455.35, "timestamp": "02:04:15", "text": "忘记了那些船。不过，没关系。"}, {"type": "subtitle", "time": 7457.669, "timestamp": "02:04:17", "text": "不过，乔，还是去当兵吧。我会展示"}, {"type": "subtitle", "time": 7459.35, "timestamp": "02:04:19", "text": "你"}, {"type": "subtitle", "time": 7467.35, "timestamp": "02:04:27", "text": "取消吧。呃，好的。现在，点击"}, {"type": "subtitle", "time": 7470.47, "timestamp": "02:04:30", "text": "那个东西。点击坦克图标。"}, {"type": "subtitle", "time": 7475.91, "timestamp": "02:04:35", "text": "定制化。装饰。点击"}, {"type": "subtitle", "time": 7478.95, "timestamp": "02:04:38", "text": "空的。"}, {"type": "subtitle", "time": 7480.79, "timestamp": "02:04:40", "text": "现在点击任何你想点击的东西"}, {"type": "subtitle", "time": 7491.91, "timestamp": "02:04:51", "text": "去看看最上面的那些。去。这些都是"}, {"type": "subtitle", "time": 7493.87, "timestamp": "02:04:53", "text": "已锁定。返回顶部"}, {"type": "subtitle", "time": 7497.589, "timestamp": "02:04:57", "text": "一。现在这边，他们中的一些人是"}, {"type": "subtitle", "time": 7499.589, "timestamp": "02:04:59", "text": "未锁定。你可以直接把它们穿上。"}]
[{"type": "subtitle", "time": 15602.229, "timestamp": "04:20:02", "text": "瘾。它更像是一种"}, {"type": "subtitle", "time": 15604.95, "timestamp": "04:20:04", "text": "有效减缓成瘾。速度很慢。"}, {"type": "subtitle", "time": 15606.59, "timestamp": "04:20:06", "text": "这是一个缓慢的过程"}, {"type": "subtitle", "time": 15609.75, "timestamp": "04:20:09", "text": "骨。就像《鬼灭之刃》一样。前19名"}, {"type": "subtitle", "time": 15611.11, "timestamp": "04:20:11", "text": "剧集播出后，你会想，“嘿，这是怎么回事？”"}, {"type": "subtitle", "time": 15614.229, "timestamp": "04:20:14", "text": "发生了什么事？没关系。没关系。”"}, {"type": "subtitle", "time": 15626.469, "timestamp": "04:20:26", "text": "平衡通行证不会给你金币"}, {"type": "subtitle", "time": 15629.91, "timestamp": "04:20:29", "text": "鹰。嗯。"}, {"type": "subtitle", "time": 15632.389, "timestamp": "04:20:32", "text": "哇。他们本可以给的。自由的"}, {"type": "subtitle", "time": 15634.229, "timestamp": "04:20:34", "text": "东西都是免费的东西。付费内容就是付费的"}, {"type": "subtitle", "time": 15638.149, "timestamp": "04:20:38", "text": "东西。两人对此都非常清楚。"}, {"type": "subtitle", "time": 15639.67, "timestamp": "04:20:39", "text": "你没有办法得到"}, {"type": "subtitle", "time": 15642.149, "timestamp": "04:20:42", "text": "在免费区购买付费内容。"}, {"type": "subtitle", "time": 15643.75, "timestamp": "04:20:43", "text": "我跟你说的没错，只有两个。"}, {"type": "subtitle", "time": 15646.07, "timestamp": "04:20:46", "text": "你可以通过其他方式获得同样的东西。"}, {"type": "subtitle", "time": 15649.269, "timestamp": "04:20:49", "text": "付费的人就能得到。一个是"}, {"type": "subtitle", "time": 15651.75, "timestamp": "04:20:51", "text": "中队车辆，另一个是"}, {"type": "subtitle", "time": 15654.87, "timestamp": "04:20:54", "text": "活动用车。"}, {"type": "subtitle", "time": 15659.71, "timestamp": "04:20:59", "text": "这是获得报酬的唯一途径"}]
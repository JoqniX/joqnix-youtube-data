[{"type": "subtitle", "time": 4740.95, "timestamp": "01:19:00", "text": "更多努力。"}, {"type": "subtitle", "time": 4749.51, "timestamp": "01:19:09", "text": "现在我的问题是找到合适的阵容。"}, {"type": "subtitle", "time": 4753.669, "timestamp": "01:19:13", "text": "如何购买这些炸弹之类的东西。"}, {"type": "subtitle", "time": 4757.11, "timestamp": "01:19:17", "text": "哦，好的。让我看看是什么"}, {"type": "subtitle", "time": 4758.83, "timestamp": "01:19:18", "text": "你正在寻找"}, {"type": "subtitle", "time": 4761.91, "timestamp": "01:19:21", "text": "在。啊，所以它的运作方式是这样的："}, {"type": "subtitle", "time": 4764.709, "timestamp": "01:19:24", "text": "你的经验值吧？"}, {"type": "subtitle", "time": 4767.91, "timestamp": "01:19:27", "text": "飞行员升级所需的经验值为"}, {"type": "subtitle", "time": 4770.63, "timestamp": "01:19:30", "text": "与飞机的XP不同。"}, {"type": "subtitle", "time": 4774.31, "timestamp": "01:19:34", "text": "所以就像任何一款赛车游戏一样，比如说"}, {"type": "subtitle", "time": 4776.709, "timestamp": "01:19:36", "text": "Forza 或任何其他你玩的游戏"}, {"type": "subtitle", "time": 4779.27, "timestamp": "01:19:39", "text": "您车辆的原厂版本。我的天哪。"}, {"type": "subtitle", "time": 4783.03, "timestamp": "01:19:43", "text": "你需要升级你的车辆。嗯。"}, {"type": "subtitle", "time": 4790.55, "timestamp": "01:19:50", "text": "炸弹。当你达到更高的境界时"}, {"type": "subtitle", "time": 4799.39, "timestamp": "01:19:59", "text": "修改。"}]
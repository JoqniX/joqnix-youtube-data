[{"type": "subtitle", "time": 14656.63, "timestamp": "04:04:16", "text": "那么，还有谁像你一样玩水系角色呢？"}, {"type": "subtitle", "time": 14660.229, "timestamp": "04:04:20", "text": "我们之中？"}, {"type": "subtitle", "time": 14665.11, "timestamp": "04:04:25", "text": "大家都知道。发送呃发送呃"}, {"type": "subtitle", "time": 14668.63, "timestamp": "04:04:28", "text": "直接寄出去就行了。无论哪种方式，"}, {"type": "subtitle", "time": 14670.469, "timestamp": "04:04:30", "text": "好的，"}, {"type": "subtitle", "time": 14674.07, "timestamp": "04:04:34", "text": "为时已晚。我确实发了一份。爵士乐往往"}, {"type": "subtitle", "time": 14683.67, "timestamp": "04:04:43", "text": "当我骚扰他时，他会玩得很不高兴。我是说"}, {"type": "subtitle", "time": 14687.67, "timestamp": "04:04:47", "text": "请他来演奏。骚扰他。"}, {"type": "subtitle", "time": 14688.99, "timestamp": "04:04:48", "text": "我会威胁"}, {"type": "subtitle", "time": 14692.309, "timestamp": "04:04:52", "text": "他。我的意思是委婉礼貌地请求他。"}, {"type": "subtitle", "time": 14695.189, "timestamp": "04:04:55", "text": "玩"}, {"type": "subtitle", "time": 14697.03, "timestamp": "04:04:57", "text": "至于其他的，我其实还没去过。"}, {"type": "subtitle", "time": 14699.91, "timestamp": "04:04:59", "text": "我真的非常忙。所以我得到了不少"}]
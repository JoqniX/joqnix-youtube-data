[{"type": "subtitle", "time": 4140.63, "timestamp": "01:09:00", "text": "是的，用于《战争雷霆》中的海战。"}, {"type": "subtitle", "time": 4142.229, "timestamp": "01:09:02", "text": "哦，"}, {"type": "subtitle", "time": 4144.709, "timestamp": "01:09:04", "text": "他们一直在更新，但它仍然"}, {"type": "subtitle", "time": 4147.91, "timestamp": "01:09:07", "text": "就像你知道的，多年来一直没有人"}, {"type": "subtitle", "time": 4149.91, "timestamp": "01:09:09", "text": "播放它。"}, {"type": "subtitle", "time": 4152.87, "timestamp": "01:09:12", "text": "啊，所以他们肯定会想办法的。"}, {"type": "subtitle", "time": 4154.87, "timestamp": "01:09:14", "text": "就像奇迹一样，他们会"}, {"type": "subtitle", "time": 4164.63, "timestamp": "01:09:24", "text": "Manda 在以下方面做得非常出色："}, {"type": "subtitle", "time": 4167.189, "timestamp": "01:09:27", "text": "飞机和坦克。所以一般来说，你"}, {"type": "subtitle", "time": 4172.07, "timestamp": "01:09:32", "text": "感觉没必要深入探讨。"}, {"type": "subtitle", "time": 4176.229, "timestamp": "01:09:36", "text": "飞船空间。另外，如果你拿起"}, {"type": "subtitle", "time": 4178.87, "timestamp": "01:09:38", "text": "玩游戏并开始定期玩"}, {"type": "subtitle", "time": 4181.11, "timestamp": "01:09:41", "text": "有些比赛是混合的。"}, {"type": "subtitle", "time": 4183.349, "timestamp": "01:09:43", "text": "战斗。所以，无论你身在何处，你都可以乘坐飞机。"}, {"type": "subtitle", "time": 4185.349, "timestamp": "01:09:45", "text": "或者放在水箱里。所以会有一些"}, {"type": "subtitle", "time": 4186.63, "timestamp": "01:09:46", "text": "飞机上的玩家，会有一些"}, {"type": "subtitle", "time": 4189.749, "timestamp": "01:09:49", "text": "坦克里的玩家。啊，我想我见过"}, {"type": "subtitle", "time": 4197.189, "timestamp": "01:09:57", "text": "你可以通过以下方式帮助你的友好团队："}, {"type": "subtitle", "time": 4199.99, "timestamp": "01:09:59", "text": "轰炸敌方坦克，或者你可以"}]
[{"type": "subtitle", "time": 4860.229, "timestamp": "01:21:00", "text": "好的，"}, {"type": "subtitle", "time": 4862.63, "timestamp": "01:21:02", "text": "你的薪水大概是入门级水平。"}, {"type": "subtitle", "time": 4866.31, "timestamp": "01:21:06", "text": "在业内。好吧，真正的方法是什么？"}, {"type": "subtitle", "time": 4868.39, "timestamp": "01:21:08", "text": "具体做法是不断投入"}, {"type": "subtitle", "time": 4871.189, "timestamp": "01:21:11", "text": "努力。你变得非常富有，然后"}, {"type": "subtitle", "time": 4873.59, "timestamp": "01:21:13", "text": "你知道，比如说你已经得到了"}, {"type": "subtitle", "time": 4877.11, "timestamp": "01:21:17", "text": "比如升到八级或九级。"}, {"type": "subtitle", "time": 4879.59, "timestamp": "01:21:19", "text": "目前共有13个关卡。"}, {"type": "subtitle", "time": 4880.79, "timestamp": "01:21:20", "text": "但假设你已经达到了某个级别"}, {"type": "subtitle", "time": 4884.31, "timestamp": "01:21:24", "text": "飞机上的八级或九级。"}, {"type": "subtitle", "time": 4886.07, "timestamp": "01:21:26", "text": "然后你买一架飞机，然后去"}, {"type": "subtitle", "time": 4887.149, "timestamp": "01:21:27", "text": "打破"}, {"type": "subtitle", "time": 4890.63, "timestamp": "01:21:30", "text": "破产了，而且破产得很惨，因为"}, {"type": "subtitle", "time": 4893.27, "timestamp": "01:21:33", "text": "一架飞机大约需要 10,000 到 20,000 人。"}, {"type": "subtitle", "time": 4895.189, "timestamp": "01:21:35", "text": "维修。"}, {"type": "subtitle", "time": 4896.87, "timestamp": "01:21:36", "text": "哦。"}, {"type": "subtitle", "time": 4900.07, "timestamp": "01:21:40", "text": "所以现在，例如，呃，返回去"}, {"type": "subtitle", "time": 4904.63, "timestamp": "01:21:44", "text": "大厅。是的。呃，随便哪个都行。所以，日本。呃"}, {"type": "subtitle", "time": 4907.59, "timestamp": "01:21:47", "text": "点击搜索。"}, {"type": "subtitle", "time": 4909.55, "timestamp": "01:21:49", "text": "哦，滚动"}, {"type": "subtitle", "time": 4913.709, "timestamp": "01:21:53", "text": "现在下降了不少。所有这些红色"}, {"type": "subtitle", "time": 4916.95, "timestamp": "01:21:56", "text": "这些是不同类型的飞机。"}, {"type": "subtitle", "time": 4919.27, "timestamp": "01:21:59", "text": "你付出努力就能有所收获"}]
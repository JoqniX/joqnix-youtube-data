[{"type": "subtitle", "time": 15240.79, "timestamp": "04:14:00", "text": "去还债了。不，我没有。我只是"}, {"type": "subtitle", "time": 15243.51, "timestamp": "04:14:03", "text": "他一眼就看出他是个假玩家。我只是"}, {"type": "subtitle", "time": 15246.469, "timestamp": "04:14:06", "text": "看过了。"}, {"type": "subtitle", "time": 15248.07, "timestamp": "04:14:08", "text": "你仔细观察了很多遍。"}, {"type": "chat", "time": 15248.714, "timestamp": "04:14:08", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "ayyyy"}, {"type": "subtitle", "time": 15250.07, "timestamp": "04:14:10", "text": "比你关注的其他任何东西都多。还，"}, {"type": "subtitle", "time": 15251.99, "timestamp": "04:14:11", "text": "我必须在其他所有方面指导你"}, {"type": "chat", "time": 15253.791, "timestamp": "04:14:13", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "dont buy it"}, {"type": "subtitle", "time": 15254.07, "timestamp": "04:14:14", "text": "弹出窗口。我从没告诉过你该去哪里"}, {"type": "subtitle", "time": 15257.83, "timestamp": "04:14:17", "text": "检查一下购买的物品。"}, {"type": "subtitle", "time": 15263.11, "timestamp": "04:14:23", "text": "我的天啊。裸露。假玩家身份曝光。"}, {"type": "subtitle", "time": 15265.67, "timestamp": "04:14:25", "text": "我的天啊。"}, {"type": "subtitle", "time": 15266.83, "timestamp": "04:14:26", "text": "不，只是"}, {"type": "subtitle", "time": 15269.99, "timestamp": "04:14:29", "text": "开玩笑的。所以，金鹰是高级货。"}, {"type": "subtitle", "time": 15271.67, "timestamp": "04:14:31", "text": "有一种东西叫做高级账户"}, {"type": "subtitle", "time": 15274.55, "timestamp": "04:14:34", "text": "您可以在这里购买高级帐户和"}, {"type": "subtitle", "time": 15277.189, "timestamp": "04:14:37", "text": "然后每场比赛你就能获得双倍奖励"}, {"type": "subtitle", "time": 15281.51, "timestamp": "04:14:41", "text": "金钱和双倍标准经验值。"}, {"type": "subtitle", "time": 15283.349, "timestamp": "04:14:43", "text": "那更像是高级订阅服务"}, {"type": "subtitle", "time": 15285.91, "timestamp": "04:14:45", "text": "就像亚马逊的订阅服务一样。"}, {"type": "subtitle", "time": 15289.59, "timestamp": "04:14:49", "text": "哦，是的。然后还有一些类似的事情"}, {"type": "subtitle", "time": 15291.91, "timestamp": "04:14:51", "text": "你可以直接购买一架高级飞机，或者"}, {"type": "subtitle", "time": 15293.75, "timestamp": "04:14:53", "text": "您可以购买高级套餐，您可以在其中"}, {"type": "subtitle", "time": 15296.389, "timestamp": "04:14:56", "text": "包裹里包含多件商品。它是"}, {"type": "subtitle", "time": 15298.63, "timestamp": "04:14:58", "text": "捆绑销售"}]
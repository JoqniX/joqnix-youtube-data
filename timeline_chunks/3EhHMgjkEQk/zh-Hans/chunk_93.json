[{"type": "subtitle", "time": 5581.35, "timestamp": "01:33:01", "text": "现在，每位飞行员都有自己分配的飞行员。"}, {"type": "subtitle", "time": 5584.629, "timestamp": "01:33:04", "text": "某些个人隐私，甚至包括你自己的隐私"}, {"type": "subtitle", "time": 5586.709, "timestamp": "01:33:06", "text": "跳出飞机。所以，这个人有"}, {"type": "subtitle", "time": 5589.91, "timestamp": "01:33:09", "text": "他身上带着一把左轮手枪。不知何故，神奇地，"}, {"type": "subtitle", "time": 5591.51, "timestamp": "01:33:11", "text": "他掏出了左轮手枪。他开始了"}, {"type": "subtitle", "time": 5593.03, "timestamp": "01:33:13", "text": "向飞机开火并击中了它"}, {"type": "subtitle", "time": 5595.27, "timestamp": "01:33:15", "text": "日本小伙。"}, {"type": "subtitle", "time": 5597.91, "timestamp": "01:33:17", "text": "什么？他漂浮在半空中。"}, {"type": "subtitle", "time": 5599.669, "timestamp": "01:33:19", "text": "降落伞。他拿着左轮手枪"}, {"type": "subtitle", "time": 5604.35, "timestamp": "01:33:24", "text": "成功击败了日本飞行员。"}, {"type": "subtitle", "time": 5611.83, "timestamp": "01:33:31", "text": "可能会发生，但是，是的，有了这架飞机，你可以……"}, {"type": "subtitle", "time": 5614.229, "timestamp": "01:33:34", "text": "很容易晕厥"}, {"type": "subtitle", "time": 5617.75, "timestamp": "01:33:37", "text": "因为承受了最大的G力"}, {"type": "subtitle", "time": 5623.99, "timestamp": "01:33:43", "text": "你只需要继续提交作业即可。"}, {"type": "subtitle", "time": 5631.189, "timestamp": "01:33:51", "text": "我该如何进行远距离射击？"}, {"type": "subtitle", "time": 5633.99, "timestamp": "01:33:53", "text": "你不能那样做，你需要花很长时间"}, {"type": "subtitle", "time": 5636.39, "timestamp": "01:33:56", "text": "距离，呃，导弹，你需要获得"}, {"type": "subtitle", "time": 5638.39, "timestamp": "01:33:58", "text": "雷达制导导弹。获取雷达的方式"}]
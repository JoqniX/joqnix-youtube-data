[{"type": "subtitle", "time": 2160.15, "timestamp": "00:36:00", "text": "Overlord 8G 之类的。"}, {"type": "subtitle", "time": 2163.67, "timestamp": "00:36:03", "text": "哦，8G会让你晕倒的。我是说9G。"}, {"type": "subtitle", "time": 2166.63, "timestamp": "00:36:06", "text": "你会在那里晕倒。哦，引力"}, {"type": "subtitle", "time": 2170.23, "timestamp": "00:36:10", "text": "力量。你转得这么快，是的。"}, {"type": "subtitle", "time": 2172.55, "timestamp": "00:36:12", "text": "你的飞行员正被向下推入"}, {"type": "subtitle", "time": 2174.31, "timestamp": "00:36:14", "text": "飞机。血液全部流出"}, {"type": "subtitle", "time": 2178.069, "timestamp": "00:36:18", "text": "他们的大脑。那确实有这么回事。"}, {"type": "subtitle", "time": 2181.51, "timestamp": "00:36:21", "text": "是的。好的。呃，让我解释一下。科学"}, {"type": "subtitle", "time": 2184.23, "timestamp": "00:36:24", "text": "与富士山共度的时光。所以，"}, {"type": "subtitle", "time": 2186.31, "timestamp": "00:36:26", "text": "呃，重力是指当你处于……时所感受到的力。"}, {"type": "subtitle", "time": 2189.51, "timestamp": "00:36:29", "text": "地球，你体验第一单元。"}, {"type": "subtitle", "time": 2190.95, "timestamp": "00:36:30", "text": "体验一次地球之旅"}, {"type": "subtitle", "time": 2193.19, "timestamp": "00:36:33", "text": "重力。"}, {"type": "subtitle", "time": 2195.43, "timestamp": "00:36:35", "text": "如果你去像火星这样的行星，你会……"}, {"type": "subtitle", "time": 2198.63, "timestamp": "00:36:38", "text": "感觉更像是一次，而且"}, {"type": "subtitle", "time": 2200.349, "timestamp": "00:36:40", "text": "半"}, {"type": "subtitle", "time": 2203.19, "timestamp": "00:36:43", "text": "二。如果你去木星，你不会"}, {"type": "subtitle", "time": 2204.95, "timestamp": "00:36:44", "text": "能够站立。试想一下"}, {"type": "subtitle", "time": 2209.43, "timestamp": "00:36:49", "text": "你知道，木星上有坚实的陆地。"}, {"type": "subtitle", "time": 2211.589, "timestamp": "00:36:51", "text": "你绝对不可能"}, {"type": "subtitle", "time": 2213.589, "timestamp": "00:36:53", "text": "完全站起来。就像你根本不会那样"}, {"type": "subtitle", "time": 2215.67, "timestamp": "00:36:55", "text": "能够坐起来。你只会"}, {"type": "subtitle", "time": 2218.39, "timestamp": "00:36:58", "text": "被挤压在地板上。"}]
[{"type": "subtitle", "time": 3480.47, "timestamp": "00:58:00", "text": "M：你看到地图了吗？"}, {"type": "subtitle", "time": 3482.43, "timestamp": "00:58:02", "text": "是的。"}, {"type": "subtitle", "time": 3485.19, "timestamp": "00:58:05", "text": "注意力。这上面有一条巨大的红线"}, {"type": "subtitle", "time": 3493.03, "timestamp": "00:58:13", "text": "所以红色就像蓝色。你是说蓝色吗？"}, {"type": "subtitle", "time": 3495.67, "timestamp": "00:58:15", "text": "正确的？嗯，是的。对你来说将是"}, {"type": "subtitle", "time": 3499.27, "timestamp": "00:58:19", "text": "蓝色的。知道了。好的。好的。好的。那"}, {"type": "subtitle", "time": 3502.549, "timestamp": "00:58:22", "text": "一。是的。为什么这里这么远？正确的"}, {"type": "subtitle", "time": 3506.47, "timestamp": "00:58:26", "text": "现在。为什么这么远？嗯，因为我们"}, {"type": "subtitle", "time": 3508.47, "timestamp": "00:58:28", "text": "正在进行地面战斗。即使在空气中"}, {"type": "subtitle", "time": 3511.349, "timestamp": "00:58:31", "text": "战斗的话，那会有点远。"}, {"type": "subtitle", "time": 3514.95, "timestamp": "00:58:34", "text": "哇。它能为你争取时间。我的意思是，我们看到"}, {"type": "subtitle", "time": 3516.47, "timestamp": "00:58:36", "text": "就在你没时间的时候，你该怎么办？"}, {"type": "subtitle", "time": 3519.43, "timestamp": "00:58:39", "text": "登陆。"}, {"type": "subtitle", "time": 3521.349, "timestamp": "00:58:41", "text": "就是这样。好的。现在，这个我"}, {"type": "subtitle", "time": 3523.829, "timestamp": "00:58:43", "text": "不能跟你一起降落，因为你的空军基地"}, {"type": "subtitle", "time": 3526.71, "timestamp": "00:58:46", "text": "它有防御能力，会把我击落。和"}, {"type": "subtitle", "time": 3528.95, "timestamp": "00:58:48", "text": "我们时间不够了。"}, {"type": "subtitle", "time": 3530.549, "timestamp": "00:58:50", "text": "哦，"}, {"type": "subtitle", "time": 3532.39, "timestamp": "00:58:52", "text": "是的。上面有个计时器。这"}, {"type": "subtitle", "time": 3534.23, "timestamp": "00:58:54", "text": "总是配有定时器。我会安排"}, {"type": "subtitle", "time": 3537.589, "timestamp": "00:58:57", "text": "又一个。这个游戏有多少GB？"}]
[{"type": "subtitle", "time": 6240.07, "timestamp": "01:44:00", "text": "嘿，我们走吧。亚历克斯。呃，好的。你等着。"}, {"type": "subtitle", "time": 6241.669, "timestamp": "01:44:01", "text": "我得把整个中队都搞定。"}, {"type": "subtitle", "time": 6254.79, "timestamp": "01:44:14", "text": "好的。现在由你来选择。我们是什么？"}, {"type": "subtitle", "time": 6256.43, "timestamp": "01:44:16", "text": "玩吗？"}, {"type": "subtitle", "time": 6259.709, "timestamp": "01:44:19", "text": "开玩笑。什么级别和什么游戏"}, {"type": "subtitle", "time": 6268.109, "timestamp": "01:44:28", "text": "H 哪个更好？"}, {"type": "subtitle", "time": 6272.55, "timestamp": "01:44:32", "text": "我还是战斗？街机或地面街机。"}, {"type": "subtitle", "time": 6275.51, "timestamp": "01:44:35", "text": "我们或许更适合你。"}, {"type": "subtitle", "time": 6278.95, "timestamp": "01:44:38", "text": "所以就是上面那个。是的。所以你现在处于"}, {"type": "subtitle", "time": 6281.75, "timestamp": "01:44:41", "text": "正确的那个。我会换成那个，因为"}, {"type": "subtitle", "time": 6285.43, "timestamp": "01:44:45", "text": "这支队伍是我的，对吧？"}, {"type": "subtitle", "time": 6288.79, "timestamp": "01:44:48", "text": "是的。它归我所有。所以，"}, {"type": "subtitle", "time": 6295.59, "timestamp": "01:44:55", "text": "你需要多个。你有一个"}, {"type": "subtitle", "time": 6297.27, "timestamp": "01:44:57", "text": "飞机。为什么你只有一个？"}, {"type": "subtitle", "time": 6298.87, "timestamp": "01:44:58", "text": "飞机？"}]
[{"type": "subtitle", "time": 4680.43, "timestamp": "01:18:00", "text": "时间到了"}, {"type": "subtitle", "time": 4684.07, "timestamp": "01:18:04", "text": "死。是时候抽出时间来获取 B 了。编号。"}, {"type": "subtitle", "time": 4686.11, "timestamp": "01:18:06", "text": "爆炸"}, {"type": "subtitle", "time": 4691.11, "timestamp": "01:18:11", "text": "如何提升我的球员等级。"}, {"type": "subtitle", "time": 4694.149, "timestamp": "01:18:14", "text": "呃，那只是配对而已。你得到"}, {"type": "subtitle", "time": 4697.39, "timestamp": "01:18:17", "text": "除了金钱之外，你还能获得经验值。"}, {"type": "subtitle", "time": 4701.189, "timestamp": "01:18:21", "text": "XP。啊"}, {"type": "subtitle", "time": 4704.79, "timestamp": "01:18:24", "text": "所以你玩游戏，然后取决于"}, {"type": "subtitle", "time": 4707.669, "timestamp": "01:18:27", "text": "你玩得好不好，这很重要。"}, {"type": "subtitle", "time": 4710.43, "timestamp": "01:18:30", "text": "游戏中的相应算法。你得到"}, {"type": "subtitle", "time": 4712.95, "timestamp": "01:18:32", "text": "XP。假设你当时正在飞行"}, {"type": "subtitle", "time": 4715.27, "timestamp": "01:18:35", "text": "径直，有人最终直接进去了"}, {"type": "subtitle", "time": 4717.51, "timestamp": "01:18:37", "text": "你把它们放在你面前，然后把它们拿了出来。你"}, {"type": "subtitle", "time": 4719.99, "timestamp": "01:18:39", "text": "射杀了他们。"}, {"type": "subtitle", "time": 4723.189, "timestamp": "01:18:43", "text": "这样你就得不到那么多了。比如说"}, {"type": "subtitle", "time": 4724.79, "timestamp": "01:18:44", "text": "你当时的反抗就像你在反抗一样"}, {"type": "subtitle", "time": 4726.149, "timestamp": "01:18:46", "text": "就像你和我一起转身一样。你是"}, {"type": "subtitle", "time": 4727.709, "timestamp": "01:18:47", "text": "不断转动。你总是"}, {"type": "subtitle", "time": 4730.39, "timestamp": "01:18:50", "text": "打斗持续了大约一分钟"}, {"type": "subtitle", "time": 4733.189, "timestamp": "01:18:53", "text": "与这个人战斗时，你带走了他们"}, {"type": "subtitle", "time": 4736.55, "timestamp": "01:18:56", "text": "向下。这样你就能获得更多经验值，因为"}, {"type": "subtitle", "time": 4738.63, "timestamp": "01:18:58", "text": "游戏会认可你投入了大量精力。"}]
[{"type": "subtitle", "time": 3720.549, "timestamp": "01:02:00", "text": "咔哒一声，就像拥有它一样。"}, {"type": "subtitle", "time": 3722.91, "timestamp": "01:02:02", "text": "持续按压，它可以"}, {"type": "subtitle", "time": 3731.829, "timestamp": "01:02:11", "text": "所以，我们要做一件事。你直线飞行。"}, {"type": "subtitle", "time": 3733.67, "timestamp": "01:02:13", "text": "我来带你了解一下游戏流程。"}, {"type": "chat", "time": 3736.332, "timestamp": "01:02:16", "author": "@soulofswords", "avatar": "https://yt4.ggpht.com/N5UGOOCkqJY6i3x846X2nx9EjZpP3SAIdAeuPAjxPPdNLWmO1Oi53_c__BkFrKVpJqviVQ07=s64-c-k-c0x00ffffff-no-rj", "message": "fuji u also play world of warships ?"}, {"type": "subtitle", "time": 3743.23, "timestamp": "01:02:23", "text": "好的。现在你明白了"}, {"type": "subtitle", "time": 3746.23, "timestamp": "01:02:26", "text": "你的外大圆，然后是你的"}, {"type": "subtitle", "time": 3748.549, "timestamp": "01:02:28", "text": "内圈比较小，对吧？你更大的"}, {"type": "subtitle", "time": 3751.27, "timestamp": "01:02:31", "text": "圆圈代表鼠标。"}, {"type": "subtitle", "time": 3753.589, "timestamp": "01:02:33", "text": "你的核心圈子里藏着枪。"}, {"type": "subtitle", "time": 3755.99, "timestamp": "01:02:35", "text": "如果你开枪，它会发射子弹。火"}, {"type": "subtitle", "time": 3758.47, "timestamp": "01:02:38", "text": "一点点。你看它是如何匹配的"}, {"type": "subtitle", "time": 3761.19, "timestamp": "01:02:41", "text": "带点的内圈？是的，"}, {"type": "subtitle", "time": 3764.71, "timestamp": "01:02:44", "text": "十字准星。是的。是的，是十字空袭。哦，"}, {"type": "subtitle", "time": 3766.309, "timestamp": "01:02:46", "text": "我猜你的视觉感受有点不同。"}, {"type": "subtitle", "time": 3769.549, "timestamp": "01:02:49", "text": "比我的还不如。好了，既然如此……"}, {"type": "subtitle", "time": 3772.789, "timestamp": "01:02:52", "text": "发生了，按下它，按住它"}, {"type": "subtitle", "time": 3775.789, "timestamp": "01:02:55", "text": "你的枪"}, {"type": "subtitle", "time": 3779.19, "timestamp": "01:02:59", "text": "开火，持续开火并观察"}]
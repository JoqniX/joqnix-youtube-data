[{"type": "subtitle", "time": 14400.71, "timestamp": "04:00:00", "text": "好的。现在，我会稍微放慢速度，这样你……"}, {"type": "subtitle", "time": 14403.349, "timestamp": "04:00:03", "text": "可以来这里。我将向你展示如何"}, {"type": "subtitle", "time": 14406.309, "timestamp": "04:00:06", "text": "低空飞行。真的。如果你开枪打我，那"}, {"type": "subtitle", "time": 14415.189, "timestamp": "04:00:15", "text": "好的。我在等。我在等。我是"}, {"type": "subtitle", "time": 14421.469, "timestamp": "04:00:21", "text": "好的。"}, {"type": "subtitle", "time": 14424.389, "timestamp": "04:00:24", "text": "现在，你们要到我的机翼列队。"}, {"type": "subtitle", "time": 14427.189, "timestamp": "04:00:27", "text": "我打算走得更远一些。"}, {"type": "subtitle", "time": 14430.71, "timestamp": "04:00:30", "text": "然后我就要转身了。好的。"}, {"type": "subtitle", "time": 14432.469, "timestamp": "04:00:32", "text": "我将进城。你只需观看。"}]
[{"type": "subtitle", "time": 3902.87, "timestamp": "01:05:02", "text": "发生了。我居然考得完美。"}, {"type": "subtitle", "time": 3904.95, "timestamp": "01:05:04", "text": "我们走吧。"}, {"type": "subtitle", "time": 3907.19, "timestamp": "01:05:07", "text": "这就是"}, {"type": "subtitle", "time": 3909.75, "timestamp": "01:05:09", "text": "降落。这就是你如何获得……"}, {"type": "subtitle", "time": 3912.47, "timestamp": "01:05:12", "text": "飞机。起飞通常要困难得多。"}, {"type": "subtitle", "time": 3914.789, "timestamp": "01:05:14", "text": "更容易"}, {"type": "subtitle", "time": 3918.069, "timestamp": "01:05:18", "text": "通常是着陆点"}, {"type": "subtitle", "time": 3920.789, "timestamp": "01:05:20", "text": "灾难。所以你倾向于提出的问题"}, {"type": "subtitle", "time": 3923.43, "timestamp": "01:05:23", "text": "当你……脸……当你飞行时"}, {"type": "subtitle", "time": 3926.309, "timestamp": "01:05:26", "text": "道具就是你不会意识到你拥有"}, {"type": "subtitle", "time": 3928.39, "timestamp": "01:05:28", "text": "稍微抬起头来"}, {"type": "subtitle", "time": 3931.27, "timestamp": "01:05:31", "text": "你快要崩溃了，然后你就倒下了。"}, {"type": "subtitle", "time": 3934.069, "timestamp": "01:05:34", "text": "在你的"}, {"type": "subtitle", "time": 3937.15, "timestamp": "01:05:37", "text": "这种情况往往是这样的。哦，我"}, {"type": "subtitle", "time": 3940.47, "timestamp": "01:05:40", "text": "知道。我的天啊，你死了。"}, {"type": "subtitle", "time": 3942.71, "timestamp": "01:05:42", "text": "所以，在这方面你必须小心。"}, {"type": "subtitle", "time": 3945.829, "timestamp": "01:05:45", "text": "通常不会那样做。嗯。现在当我"}, {"type": "subtitle", "time": 3949.27, "timestamp": "01:05:49", "text": "回来，我们起飞，然后我们就会"}, {"type": "subtitle", "time": 3951.27, "timestamp": "01:05:51", "text": "径直朝对方驶去。出色地"}, {"type": "subtitle", "time": 3953.75, "timestamp": "01:05:53", "text": "彼此交叉一次，然后"}, {"type": "subtitle", "time": 3956.47, "timestamp": "01:05:56", "text": "我们会打起来的。好的。耶。我们开始吧"}, {"type": "subtitle", "time": 3958.15, "timestamp": "01:05:58", "text": "去。"}]
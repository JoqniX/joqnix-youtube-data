[{"type": "subtitle", "time": 3122.71, "timestamp": "00:52:02", "text": "现在你想试试。所以当你……"}, {"type": "subtitle", "time": 3125.27, "timestamp": "00:52:05", "text": "你就像在做转弯动作一样，是吗？"}, {"type": "subtitle", "time": 3128.549, "timestamp": "00:52:08", "text": "搞到那些统治者的东西了吗？呃"}, {"type": "subtitle", "time": 3130.47, "timestamp": "00:52:10", "text": "这些飞机很难"}, {"type": "subtitle", "time": 3137.109, "timestamp": "00:52:17", "text": "那。你通常需要获得更多"}, {"type": "subtitle", "time": 3139.109, "timestamp": "00:52:19", "text": "如何形容它更快、更高效？"}, {"type": "subtitle", "time": 3141.309, "timestamp": "00:52:21", "text": "行动迟缓的飞机"}, {"type": "subtitle", "time": 3144.23, "timestamp": "00:52:24", "text": "转动。这些飞机原本是要飞的"}, {"type": "subtitle", "time": 3146.309, "timestamp": "00:52:26", "text": "速度相对较慢，而且很漂亮"}, {"type": "subtitle", "time": 3149.829, "timestamp": "00:52:29", "text": "出色地。所以，这相对来说比较困难。为了"}, {"type": "chat", "time": 3151.18, "timestamp": "00:52:31", "author": "@soulofswords", "avatar": "https://yt4.ggpht.com/N5UGOOCkqJY6i3x846X2nx9EjZpP3SAIdAeuPAjxPPdNLWmO1Oi53_c__BkFrKVpJqviVQ07=s64-c-k-c0x00ffffff-no-rj", "message": "ohh fuji san"}, {"type": "subtitle", "time": 3152.069, "timestamp": "00:52:32", "text": "例如，我们的两名飞行员甚至都没有"}, {"type": "subtitle", "time": 3154.43, "timestamp": "00:52:34", "text": "像这样封闭"}, {"type": "subtitle", "time": 3156.549, "timestamp": "00:52:36", "text": "座舱。他们就坐在外面"}, {"type": "subtitle", "time": 3159.67, "timestamp": "00:52:39", "text": "露天的，对吧？"}, {"type": "subtitle", "time": 3161.589, "timestamp": "00:52:41", "text": "有点"}, {"type": "subtitle", "time": 3164.67, "timestamp": "00:52:44", "text": "哦，它开着。经验丰富"}, {"type": "subtitle", "time": 3173.19, "timestamp": "00:52:53", "text": "你想试试着陆吗？是的。"}]
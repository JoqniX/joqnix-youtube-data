[{"type": "subtitle", "time": 9302.79, "timestamp": "02:35:02", "text": "在日本。嗯，好的。好的。所以，"}, {"type": "subtitle", "time": 9304.389, "timestamp": "02:35:04", "text": "倒数第二个之间的区别"}, {"type": "subtitle", "time": 9307.75, "timestamp": "02:35:07", "text": "最后一个是最后一个"}, {"type": "subtitle", "time": 9310.309, "timestamp": "02:35:10", "text": "你就像一支真正的轰炸机舰队。他们"}, {"type": "subtitle", "time": 9312.349, "timestamp": "02:35:12", "text": "变得又大又重"}, {"type": "subtitle", "time": 9316.07, "timestamp": "02:35:16", "text": "笨重的轰炸机。你几乎无法"}, {"type": "subtitle", "time": 9318.23, "timestamp": "02:35:18", "text": "演习。你只需直线飞行，然后下降"}, {"type": "subtitle", "time": 9321.03, "timestamp": "02:35:21", "text": "投下炸弹后直接飞回去。你得到一个"}, {"type": "subtitle", "time": 9323.27, "timestamp": "02:35:23", "text": "枪支很多，但通常情况下你是……"}, {"type": "subtitle", "time": 9325.03, "timestamp": "02:35:25", "text": "活靶子。你真的得飞。"}, {"type": "subtitle", "time": 9328.389, "timestamp": "02:35:28", "text": "高处。啊，倒数第二行，"}, {"type": "subtitle", "time": 9331.67, "timestamp": "02:35:31", "text": "这是一架攻击机，它在那里……"}, {"type": "subtitle", "time": 9334.15, "timestamp": "02:35:34", "text": "战斗机改装成轰炸机。所以，"}, {"type": "subtitle", "time": 9337.03, "timestamp": "02:35:37", "text": "它比战斗机更迟缓。"}, {"type": "subtitle", "time": 9339.27, "timestamp": "02:35:39", "text": "但它有一定的机动性和防御能力。"}, {"type": "subtitle", "time": 9344.95, "timestamp": "02:35:44", "text": "它可以潜入水下。它可以滚动。大"}, {"type": "subtitle", "time": 9347.03, "timestamp": "02:35:47", "text": "轰炸机不能俯冲和翻滚。你会"}, {"type": "subtitle", "time": 9348.63, "timestamp": "02:35:48", "text": "立即将翅膀折断"}, {"type": "subtitle", "time": 9357.429, "timestamp": "02:35:57", "text": "所以，这取决于你。的"}, {"type": "subtitle", "time": 9359.429, "timestamp": "02:35:59", "text": "大型轰炸机的优点在于一旦你"}]
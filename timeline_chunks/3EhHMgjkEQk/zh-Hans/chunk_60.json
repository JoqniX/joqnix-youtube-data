[{"type": "subtitle", "time": 3600.109, "timestamp": "01:00:00", "text": "因为游戏会更新"}, {"type": "subtitle", "time": 3602.87, "timestamp": "01:00:02", "text": "就像游戏会进行一些小更新一样"}, {"type": "subtitle", "time": 3606.069, "timestamp": "01:00:06", "text": "一年10到15次。 M 大更新"}, {"type": "subtitle", "time": 3608.63, "timestamp": "01:00:08", "text": "新车至少会配备类似的东西"}, {"type": "subtitle", "time": 3612.71, "timestamp": "01:00:12", "text": "每年两到三次"}, {"type": "subtitle", "time": 3615.349, "timestamp": "01:00:15", "text": "它们往往伴随着大型活动。"}, {"type": "subtitle", "time": 3617.109, "timestamp": "01:00:17", "text": "所以，《壮志凌云：独行侠》这部电影，你"}, {"type": "subtitle", "time": 3619.27, "timestamp": "01:00:19", "text": "我们正在谈论“是啊”。他们启动了"}, {"type": "subtitle", "time": 3621.27, "timestamp": "01:00:21", "text": "那架飞机以及它的拖车"}, {"type": "subtitle", "time": 3628.789, "timestamp": "01:00:28", "text": "等电影上映吧。"}, {"type": "subtitle", "time": 3631.67, "timestamp": "01:00:31", "text": "嗯，不是为了电影。他们做了"}, {"type": "subtitle", "time": 3634.309, "timestamp": "01:00:34", "text": "这是一种巧妙的营销手段，他们做到了"}, {"type": "subtitle", "time": 3637.27, "timestamp": "01:00:37", "text": "飞机准备就绪。他们有很多东西"}, {"type": "subtitle", "time": 3640.71, "timestamp": "01:00:40", "text": "准备好进行所谓的更新"}, {"type": "subtitle", "time": 3644.069, "timestamp": "01:00:44", "text": "以及即将推出的公司"}, {"type": "subtitle", "time": 3647.03, "timestamp": "01:00:47", "text": "他们推出了《壮志凌云：独行侠》电影，并发行了一部电影。"}, {"type": "subtitle", "time": 3648.87, "timestamp": "01:00:48", "text": "拖车。这些人看到了预告片发布。"}, {"type": "subtitle", "time": 3651.51, "timestamp": "01:00:51", "text": "并发布了他们的更新预告片"}, {"type": "subtitle", "time": 3656.15, "timestamp": "01:00:56", "text": "当天或几天内即可完成。哇。"}]
[{"type": "subtitle", "time": 11947.91, "timestamp": "03:19:07", "text": "机动。你可以把发动机装回去。"}, {"type": "subtitle", "time": 11950.349, "timestamp": "03:19:10", "text": "在。你不需要保留它"}, {"type": "subtitle", "time": 11952.63, "timestamp": "03:19:12", "text": "离开。我刚才已经告诉过你把引擎放好。"}, {"type": "subtitle", "time": 11953.91, "timestamp": "03:19:13", "text": "关闭，因为你已经超越了……"}, {"type": "subtitle", "time": 11955.07, "timestamp": "03:19:15", "text": "速度"}, {"type": "subtitle", "time": 11964.229, "timestamp": "03:19:24", "text": "我是谁？"}, {"type": "subtitle", "time": 11972.75, "timestamp": "03:19:32", "text": "所以，等等。如果我再点击一次，就会……"}, {"type": "subtitle", "time": 11977.19, "timestamp": "03:19:37", "text": "离开。我必须态度更强硬一些，对吧？这"}, {"type": "subtitle", "time": 11980.59, "timestamp": "03:19:40", "text": "控制力增强。当你转动它"}, {"type": "subtitle", "time": 11984.55, "timestamp": "03:19:44", "text": "之后，控制力会变得更加麻木。"}, {"type": "subtitle", "time": 11994.15, "timestamp": "03:19:54", "text": "如果你在理解上遇到困难"}, {"type": "subtitle", "time": 11996.07, "timestamp": "03:19:56", "text": "退出后，我们可以进行自定义战斗。我可以"}]
[{"type": "subtitle", "time": 9900.83, "timestamp": "02:45:00", "text": "等待。它没有执行“哪里是……”的操作。"}, {"type": "subtitle", "time": 9903.23, "timestamp": "02:45:03", "text": "耀斑？在哪里？"}, {"type": "subtitle", "time": 9905.75, "timestamp": "02:45:05", "text": "火？哦，"}, {"type": "subtitle", "time": 9914.07, "timestamp": "02:45:14", "text": "去。好的。现在按下 C 键并更改"}, {"type": "subtitle", "time": 9916.429, "timestamp": "02:45:16", "text": "你的相机。让你的镜头平移"}, {"type": "subtitle", "time": 9938.389, "timestamp": "02:45:38", "text": "直的。好的。现在看看你的翅膀。"}, {"type": "subtitle", "time": 9940.79, "timestamp": "02:45:40", "text": "他们看起来和以前一样吗？"}, {"type": "subtitle", "time": 9942.07, "timestamp": "02:45:42", "text": "开始？"}, {"type": "subtitle", "time": 9945.11, "timestamp": "02:45:45", "text": "等一下。你根本听不见"}, {"type": "subtitle", "time": 9946.71, "timestamp": "02:45:46", "text": "现在有什么事吗？你刚刚穿过了"}, {"type": "subtitle", "time": 9948.19, "timestamp": "02:45:48", "text": "声音"}, {"type": "subtitle", "time": 9951.59, "timestamp": "02:45:51", "text": "呃，音障。什么？那就是"}, {"type": "subtitle", "time": 9955.75, "timestamp": "02:45:55", "text": "事物。什么？是的。你看到那白色了"}, {"type": "subtitle", "time": 9958.15, "timestamp": "02:45:58", "text": "冲击锥上升半秒钟。"}]
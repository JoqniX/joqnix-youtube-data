[{"type": "subtitle", "time": 9244.55, "timestamp": "02:34:04", "text": "你们在瑞典还有其他飞机吗？"}, {"type": "subtitle", "time": 9246.67, "timestamp": "02:34:06", "text": "瑞典。我"}, {"type": "subtitle", "time": 9253.95, "timestamp": "02:34:13", "text": "等等，J。第一个。"}, {"type": "subtitle", "time": 9267.51, "timestamp": "02:34:27", "text": "哦，好的。是的，你没有任何种类"}, {"type": "subtitle", "time": 9269.07, "timestamp": "02:34:29", "text": "轰炸"}, {"type": "subtitle", "time": 9272.11, "timestamp": "02:34:32", "text": "飞机。嗯，你必须……"}, {"type": "subtitle", "time": 9274.469, "timestamp": "02:34:34", "text": "研究。研究完成后，你"}, {"type": "subtitle", "time": 9276.55, "timestamp": "02:34:36", "text": "那时就可以开始轰炸了。那真有趣"}, {"type": "subtitle", "time": 9278.63, "timestamp": "02:34:38", "text": "也一样。"}, {"type": "subtitle", "time": 9281.11, "timestamp": "02:34:41", "text": "啊，这样更有趣，因为你有点身临其境。"}, {"type": "subtitle", "time": 9283.19, "timestamp": "02:34:43", "text": "一场激烈的竞争，而你总是处于某种程度上……"}, {"type": "subtitle", "time": 9285.67, "timestamp": "02:34:45", "text": "老鼠，无论你跑到哪里，躲到哪里，"}, {"type": "subtitle", "time": 9286.71, "timestamp": "02:34:46", "text": "你先是轰炸，然后你就走了"}, {"type": "subtitle", "time": 9289.429, "timestamp": "02:34:49", "text": "返回基地。所以，我应该选择"}, {"type": "subtitle", "time": 9292.71, "timestamp": "02:34:52", "text": "鱼雷，呃，是哪种轰炸机？就像上次一样"}, {"type": "subtitle", "time": 9296.07, "timestamp": "02:34:56", "text": "倒数第一个还是倒数第二个？"}, {"type": "subtitle", "time": 9299.67, "timestamp": "02:34:59", "text": "瑞典语的那个？是的，在日本"}]
[{"type": "subtitle", "time": 8403.19, "timestamp": "02:20:03", "text": "现在在这些比赛中，你不会得到"}, {"type": "subtitle", "time": 8406.07, "timestamp": "02:20:06", "text": "选择飞机时，你还可以获得"}, {"type": "subtitle", "time": 8408.07, "timestamp": "02:20:08", "text": "飞机上的时间有限。它不是"}, {"type": "subtitle", "time": 8411.03, "timestamp": "02:20:11", "text": "无限时间。"}, {"type": "subtitle", "time": 8413.349, "timestamp": "02:20:13", "text": "你只有大约50秒的时间。在50个"}, {"type": "subtitle", "time": 8415.03, "timestamp": "02:20:15", "text": "几秒钟后，你必须做你正在做的事情。"}, {"type": "subtitle", "time": 8416.67, "timestamp": "02:20:16", "text": "然后你就被送回去了"}, {"type": "subtitle", "time": 8419.469, "timestamp": "02:20:19", "text": "如果你想体验无限畅玩"}, {"type": "subtitle", "time": 8428.07, "timestamp": "02:20:28", "text": "是的。"}, {"type": "subtitle", "time": 8442.07, "timestamp": "02:20:42", "text": "你想做什么？你想要"}, {"type": "subtitle", "time": 8444.389, "timestamp": "02:20:44", "text": "继续用坦克和飞机作战吗？"}, {"type": "subtitle", "time": 8446.95, "timestamp": "02:20:46", "text": "是的。"}, {"type": "subtitle", "time": 8449.99, "timestamp": "02:20:49", "text": "所以点击“准备就绪”，对吧？或者想做"}, {"type": "subtitle", "time": 8452.389, "timestamp": "02:20:52", "text": "飞机。"}, {"type": "subtitle", "time": 8454.79, "timestamp": "02:20:54", "text": "我问的是哪一个。你是什​​么"}, {"type": "subtitle", "time": 8457.75, "timestamp": "02:20:57", "text": "想做什么？好的。飞机。"}]
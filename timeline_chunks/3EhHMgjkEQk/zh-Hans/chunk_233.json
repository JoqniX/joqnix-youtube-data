[{"type": "subtitle", "time": 13981.59, "timestamp": "03:53:01", "text": "确切地。我比他强大得多。"}, {"type": "subtitle", "time": 13983.349, "timestamp": "03:53:03", "text": "飞机，所以你还没到家就会死。"}, {"type": "subtitle", "time": 13985.269, "timestamp": "03:53:05", "text": "我。你确实害死了我，因为，你知道的，"}, {"type": "subtitle", "time": 13993.51, "timestamp": "03:53:13", "text": "好的。真倒霉。你多久了？"}, {"type": "subtitle", "time": 14000.87, "timestamp": "03:53:20", "text": "呃，我不知道你到底有多少"}, {"type": "subtitle", "time": 14002.99, "timestamp": "03:53:22", "text": "玩过。我玩过。"}, {"type": "subtitle", "time": 14005.91, "timestamp": "03:53:25", "text": "多年来。是的。至少超过"}, {"type": "subtitle", "time": 14026.469, "timestamp": "03:53:46", "text": "你必须利用地面和城市"}, {"type": "subtitle", "time": 14028.75, "timestamp": "03:53:48", "text": "致你"}, {"type": "subtitle", "time": 14036.71, "timestamp": "03:53:56", "text": "接下来。我们有十分钟时间。"}, {"type": "subtitle", "time": 14038.229, "timestamp": "03:53:58", "text": "10分钟时间已到。我会安排"}]
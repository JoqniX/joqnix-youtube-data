[{"type": "subtitle", "time": 10741.11, "timestamp": "02:59:01", "text": "嗯，是的。好了。你找到了。现在"}, {"type": "subtitle", "time": 10742.71, "timestamp": "02:59:02", "text": "调整得更整齐一些。你偏离了……"}, {"type": "subtitle", "time": 10744.87, "timestamp": "02:59:04", "text": "船的侧面。指向"}, {"type": "subtitle", "time": 10747.269, "timestamp": "02:59:07", "text": "船。指向船的方向。稍微了解一下"}, {"type": "subtitle", "time": 10753.23, "timestamp": "02:59:13", "text": "高的。好的"}, {"type": "subtitle", "time": 10761.309, "timestamp": "02:59:21", "text": "向上。向上指。再多一点。"}, {"type": "subtitle", "time": 10766.71, "timestamp": "02:59:26", "text": "是的。我的天啊。我做到了。我们走吧。"}, {"type": "subtitle", "time": 10769.71, "timestamp": "02:59:29", "text": "我的天啊。就是这样。喜欢"}, {"type": "subtitle", "time": 10771.67, "timestamp": "02:59:31", "text": "着陆时自动启动。"}, {"type": "subtitle", "time": 10773.11, "timestamp": "02:59:33", "text": "这就是飞机着陆的方式"}, {"type": "subtitle", "time": 10775.51, "timestamp": "02:59:35", "text": "载体。它有电线，还有你的飞机"}, {"type": "subtitle", "time": 10778.389, "timestamp": "02:59:38", "text": "把电线钩住。"}, {"type": "subtitle", "time": 10780.55, "timestamp": "02:59:40", "text": "哦，关键在于那些电线能把你引向……"}, {"type": "subtitle", "time": 10782.87, "timestamp": "02:59:42", "text": "停止。"}, {"type": "subtitle", "time": 10786.79, "timestamp": "02:59:46", "text": "啊。现在你想体验一次愉快的起飞。"}, {"type": "subtitle", "time": 10789.51, "timestamp": "02:59:49", "text": "是的。看前面。改变你的"}, {"type": "subtitle", "time": 10792.429, "timestamp": "02:59:52", "text": "镜头对准“好的”。缓慢地，非常"}, {"type": "subtitle", "time": 10795.269, "timestamp": "02:59:55", "text": "慢慢地，将飞机对准那两个方向。"}, {"type": "subtitle", "time": 10797.59, "timestamp": "02:59:57", "text": "你看到的线条，嗯，严格来说"}, {"type": "subtitle", "time": 10799.51, "timestamp": "02:59:59", "text": "你旁边就是一条线，但你看到了那些"}]
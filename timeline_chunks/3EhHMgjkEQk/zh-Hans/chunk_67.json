[{"type": "subtitle", "time": 4020.87, "timestamp": "01:07:00", "text": "像这样的装备就能起飞。"}, {"type": "subtitle", "time": 4022.71, "timestamp": "01:07:02", "text": "嗯，你没有起落架。"}, {"type": "subtitle", "time": 4025.349, "timestamp": "01:07:05", "text": "在那架飞机上会有所改变。所以，除了……"}, {"type": "subtitle", "time": 4028.39, "timestamp": "01:07:08", "text": "也就是说，你只能更换襟翼。你"}, {"type": "subtitle", "time": 4032.23, "timestamp": "01:07:12", "text": "你的飞机有襟翼。哦，"}, {"type": "subtitle", "time": 4034.15, "timestamp": "01:07:14", "text": "所以我会一步步地向你介绍这些内容。"}, {"type": "subtitle", "time": 4037.91, "timestamp": "01:07:17", "text": "出色地。嗯，你刚才说的是“是啊，你是……”"}, {"type": "subtitle", "time": 4040.63, "timestamp": "01:07:20", "text": "说什么？雷。不，世界"}, {"type": "subtitle", "time": 4042.71, "timestamp": "01:07:22", "text": "军舰。战舰世界。是的。所以，"}, {"type": "subtitle", "time": 4045.99, "timestamp": "01:07:25", "text": "《战舰世界》是唯一一款来自 I 的游戏"}, {"type": "subtitle", "time": 4047.789, "timestamp": "01:07:27", "text": "我相信公司名称是"}, {"type": "subtitle", "time": 4050.15, "timestamp": "01:07:30", "text": "战争游戏。 《战舰世界》是"}, {"type": "subtitle", "time": 4053.91, "timestamp": "01:07:33", "text": "唯一一款我更喜欢的游戏是其他游戏。"}, {"type": "subtitle", "time": 4056.95, "timestamp": "01:07:36", "text": "在 War Thunder 中，他们是一家公司。"}, {"type": "subtitle", "time": 4060.63, "timestamp": "01:07:40", "text": "舰船之间的战斗非常精彩。"}, {"type": "subtitle", "time": 4063.029, "timestamp": "01:07:43", "text": "所以你可以参与这些大规模的世界大战"}, {"type": "subtitle", "time": 4065.15, "timestamp": "01:07:45", "text": "II 艘战列舰和"}, {"type": "subtitle", "time": 4069.349, "timestamp": "01:07:49", "text": "体型堪比一座城市的毁灭者。"}, {"type": "subtitle", "time": 4073.349, "timestamp": "01:07:53", "text": "哦，而且你可以精准瞄准。它是"}, {"type": "subtitle", "time": 4076.43, "timestamp": "01:07:56", "text": "比较现实。接下来是"}, {"type": "subtitle", "time": 4079.47, "timestamp": "01:07:59", "text": "过去发生的事情的物理原理"}]
[{"type": "subtitle", "time": 5702.709, "timestamp": "01:35:02", "text": "实际行动是什么？"}, {"type": "subtitle", "time": 5705.03, "timestamp": "01:35:05", "text": "是的，现实世界中的战斗，有点像"}, {"type": "subtitle", "time": 5706.87, "timestamp": "01:35:06", "text": "这，"}, {"type": "subtitle", "time": 5709.83, "timestamp": "01:35:09", "text": "但上世纪80年代的情况就是这样。不是"}, {"type": "subtitle", "time": 5711.75, "timestamp": "01:35:11", "text": "不再是了。"}, {"type": "subtitle", "time": 5715.43, "timestamp": "01:35:15", "text": "哦，如果今天你离得足够近的话"}, {"type": "subtitle", "time": 5718.55, "timestamp": "01:35:18", "text": "目视可以看到敌机，那里有……"}, {"type": "subtitle", "time": 5721.47, "timestamp": "01:35:21", "text": "有50%的几率你会回家"}, {"type": "subtitle", "time": 5724.31, "timestamp": "01:35:24", "text": "活。什么？"}, {"type": "subtitle", "time": 5726.95, "timestamp": "01:35:26", "text": "要知道这项技术如此出色，"}, {"type": "subtitle", "time": 5728.79, "timestamp": "01:35:28", "text": "你们会在雷达上看到彼此，"}, {"type": "subtitle", "time": 5730.87, "timestamp": "01:35:30", "text": "在距离对方200公里左右的地方互相射击"}, {"type": "subtitle", "time": 5737.189, "timestamp": "01:35:37", "text": "啊，所以你的飞机开得很快。"}, {"type": "subtitle", "time": 5739.51, "timestamp": "01:35:39", "text": "直接冲向敌人"}, {"type": "subtitle", "time": 5741.51, "timestamp": "01:35:41", "text": "你会一直攀爬。"}, {"type": "subtitle", "time": 5743.43, "timestamp": "01:35:43", "text": "你会在雷达上看到敌人。"}, {"type": "subtitle", "time": 5745.59, "timestamp": "01:35:45", "text": "你会进入武器的射程。"}, {"type": "subtitle", "time": 5747.35, "timestamp": "01:35:47", "text": "你会发射导弹并立即"}, {"type": "subtitle", "time": 5754.149, "timestamp": "01:35:54", "text": "离开。所以，这更像是你……"}]
[{"type": "subtitle", "time": 3300.15, "timestamp": "00:55:00", "text": "每架飞机。总共有多少架飞机？"}, {"type": "subtitle", "time": 3303.71, "timestamp": "00:55:03", "text": "总共有超过四千五百人。"}, {"type": "subtitle", "time": 3305.23, "timestamp": "00:55:05", "text": "不同的"}, {"type": "subtitle", "time": 3307.19, "timestamp": "00:55:07", "text": "其中，我会说是这些车辆中的"}, {"type": "subtitle", "time": 3310.27, "timestamp": "00:55:10", "text": "至少有500个"}, {"type": "subtitle", "time": 3313.43, "timestamp": "00:55:13", "text": "保费。然后我看到"}, {"type": "subtitle", "time": 3315.589, "timestamp": "00:55:15", "text": "现在，如果你按下 L 键，你应该能够"}, {"type": "subtitle", "time": 3321.43, "timestamp": "00:55:21", "text": "那是什么？"}, {"type": "subtitle", "time": 3323.589, "timestamp": "00:55:23", "text": "是烟。它叫什么来着？"}, {"type": "subtitle", "time": 3326.75, "timestamp": "00:55:26", "text": "特技飞行模式。只是"}, {"type": "subtitle", "time": 3330.309, "timestamp": "00:55:30", "text": "你是怎么做到的？"}, {"type": "subtitle", "time": 3333.67, "timestamp": "00:55:33", "text": "正在试用键盘。看？"}, {"type": "subtitle", "time": 3336.71, "timestamp": "00:55:36", "text": "是的。我没有我的。给你。我"}, {"type": "subtitle", "time": 3342.069, "timestamp": "00:55:42", "text": "按下 C 键，然后使用鼠标。向后看"}, {"type": "subtitle", "time": 3343.91, "timestamp": "00:55:43", "text": "你。对了，再按一次 L 键。是的，"}, {"type": "subtitle", "time": 3346.87, "timestamp": "00:55:46", "text": "好了。"}, {"type": "subtitle", "time": 3348.549, "timestamp": "00:55:48", "text": "哦，"}, {"type": "subtitle", "time": 3350.27, "timestamp": "00:55:50", "text": "真的就转身吧"}, {"type": "subtitle", "time": 3359.19, "timestamp": "00:55:59", "text": "你看到了吗？是的。如果我要搬家"}]
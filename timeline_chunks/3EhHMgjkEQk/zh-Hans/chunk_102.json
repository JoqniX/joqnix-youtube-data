[{"type": "subtitle", "time": 6124.149, "timestamp": "01:42:04", "text": "好的，我会尽量往上爬，爬得非常非常高。"}, {"type": "subtitle", "time": 6127.91, "timestamp": "01:42:07", "text": "看看那些飞机。原因何在"}, {"type": "subtitle", "time": 6130.709, "timestamp": "01:42:10", "text": "以色列迅速发展喷气式飞机"}, {"type": "subtitle", "time": 6133.03, "timestamp": "01:42:13", "text": "因为以色列科技树，"}, {"type": "subtitle", "time": 6135.35, "timestamp": "01:42:15", "text": "以色列空军成立于第一次世界大战之后。"}, {"type": "subtitle", "time": 6137.51, "timestamp": "01:42:17", "text": "二、"}, {"type": "subtitle", "time": 6141.03, "timestamp": "01:42:21", "text": "啊，所以他们有两三个世界"}, {"type": "subtitle", "time": 6143.109, "timestamp": "01:42:23", "text": "二战飞机，然后它们开始"}, {"type": "subtitle", "time": 6145.189, "timestamp": "01:42:25", "text": "很快就能拿到喷气式飞机。这是因为"}, {"type": "subtitle", "time": 6147.59, "timestamp": "01:42:27", "text": "它们的树线从这里开始。看看如何"}, {"type": "subtitle", "time": 6152.02, "timestamp": "01:42:32", "text": "第一个平面是 4.3、3.3 和 5.0。"}, {"type": "subtitle", "time": 6153.83, "timestamp": "01:42:33", "text": "[音乐]"}, {"type": "subtitle", "time": 6155.75, "timestamp": "01:42:35", "text": "其他技术公司没有这种现象。"}, {"type": "subtitle", "time": 6157.99, "timestamp": "01:42:37", "text": "另一条科技树从储备开始。"}, {"type": "subtitle", "time": 6160.31, "timestamp": "01:42:40", "text": "然后是一、二、三、四"}, {"type": "subtitle", "time": 6168.109, "timestamp": "01:42:48", "text": "所以你基本上跳过了很多……"}, {"type": "subtitle", "time": 6171.189, "timestamp": "01:42:51", "text": "以色列科技树的底层。这是"}, {"type": "subtitle", "time": 6172.709, "timestamp": "01:42:52", "text": "最受欢迎的科技树之一"}, {"type": "subtitle", "time": 6175.229, "timestamp": "01:42:55", "text": "想要快速到达目的地的人"}]
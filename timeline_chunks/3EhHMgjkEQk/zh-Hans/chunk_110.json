[{"type": "subtitle", "time": 6600.87, "timestamp": "01:50:00", "text": "是的。该死。好的。"}, {"type": "subtitle", "time": 6602.55, "timestamp": "01:50:02", "text": "你看，只要你小心谨慎，你就可以"}, {"type": "subtitle", "time": 6609.07, "timestamp": "01:50:09", "text": "好的，我们开始吧"}, {"type": "subtitle", "time": 6612.87, "timestamp": "01:50:12", "text": "去。哦，我真的必须做这件事。"}, {"type": "subtitle", "time": 6615.91, "timestamp": "01:50:15", "text": "是的，你得起飞了。胜利是"}, {"type": "subtitle", "time": 6617.91, "timestamp": "01:50:17", "text": "关闭。"}, {"type": "subtitle", "time": 6619.47, "timestamp": "01:50:19", "text": "咱们来演夜魔侠吧"}, {"type": "subtitle", "time": 6622.87, "timestamp": "01:50:22", "text": "起飞。是的。"}, {"type": "subtitle", "time": 6625.91, "timestamp": "01:50:25", "text": "我的天啊。"}, {"type": "subtitle", "time": 6628.39, "timestamp": "01:50:28", "text": "别担心，乔。我玩过它"}, {"type": "subtitle", "time": 6630.629, "timestamp": "01:50:30", "text": "许多很多年。"}, {"type": "subtitle", "time": 6632.87, "timestamp": "01:50:32", "text": "你是专业人士吗？"}, {"type": "subtitle", "time": 6635.83, "timestamp": "01:50:35", "text": "是的。这些人怎么样？"}, {"type": "subtitle", "time": 6637.51, "timestamp": "01:50:37", "text": "活？它们坠毁而不是什么"}, {"type": "subtitle", "time": 6639.03, "timestamp": "01:50:39", "text": "当时发生的事情我们不愿多谈。"}, {"type": "subtitle", "time": 6646.39, "timestamp": "01:50:46", "text": "那绝对是一枚轰炸机。看看那架轰炸机"}, {"type": "subtitle", "time": 6649.669, "timestamp": "01:50:49", "text": "刚去世。好的。"}, {"type": "subtitle", "time": 6651.669, "timestamp": "01:50:51", "text": "那么，谁是炸弹袭击者？一般保持"}, {"type": "subtitle", "time": 6654.83, "timestamp": "01:50:54", "text": "他们自己真的很高"}, {"type": "subtitle", "time": 6657.99, "timestamp": "01:50:57", "text": "向上。嗯。现在我们的任务就是进去。"}]
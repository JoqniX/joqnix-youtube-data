[{"type": "subtitle", "time": 12780.79, "timestamp": "03:33:00", "text": "在哪里？下去。飞得非常靠近"}, {"type": "subtitle", "time": 12781.75, "timestamp": "03:33:01", "text": "地面。这是你唯一的办法"}, {"type": "subtitle", "time": 12785.83, "timestamp": "03:33:05", "text": "避免这样做。我的天哪。你去了哪里？"}, {"type": "subtitle", "time": 12789.349, "timestamp": "03:33:09", "text": "嗯？我当时比你高。"}, {"type": "subtitle", "time": 12791.269, "timestamp": "03:33:11", "text": "好的。你还有一架飞机吗？是的，"}, {"type": "subtitle", "time": 12793.67, "timestamp": "03:33:13", "text": "三个平面。好的，太好了。极好的。"}, {"type": "subtitle", "time": 12795.429, "timestamp": "03:33:15", "text": "这次我将一步步指导你完成。患病的"}, {"type": "subtitle", "time": 12797.83, "timestamp": "03:33:17", "text": "确保你的视线清晰。我做了吗？"}, {"type": "subtitle", "time": 12801.59, "timestamp": "03:33:21", "text": "我买的是金色的吗？所以，我有"}, {"type": "subtitle", "time": 12804.71, "timestamp": "03:33:24", "text": "六个槽位。不管怎样，金色的"}, {"type": "subtitle", "time": 12806.79, "timestamp": "03:33:26", "text": "你拥有的东西，很可能是你买的。"}, {"type": "subtitle", "time": 12810.79, "timestamp": "03:33:30", "text": "自由的。你没有投入真金白银。"}, {"type": "subtitle", "time": 12813.19, "timestamp": "03:33:33", "text": "是的。如果你买了东西，那就是"}, {"type": "subtitle", "time": 12815.11, "timestamp": "03:33:35", "text": "使用游戏内货币。你购买了它"}, {"type": "subtitle", "time": 12818.469, "timestamp": "03:33:38", "text": "反正。好的。现在，稍微抬头看看"}, {"type": "subtitle", "time": 12822.55, "timestamp": "03:33:42", "text": "在你面前。你看见我了吗？"}, {"type": "subtitle", "time": 12825.91, "timestamp": "03:33:45", "text": "不。好的。现在，你看出什么了吗？"}, {"type": "subtitle", "time": 12833.67, "timestamp": "03:33:53", "text": "空气？你看到橙色或黄色的线条了吗？"}, {"type": "subtitle", "time": 12835.429, "timestamp": "03:33:55", "text": "不。"}, {"type": "subtitle", "time": 12837.99, "timestamp": "03:33:57", "text": "哦，那我离得真的很远。什么？"}, {"type": "subtitle", "time": 12839.64, "timestamp": "03:33:59", "text": "什么？ 好的。呃，好的。你现在看到这个了吗？"}]
[{"type": "subtitle", "time": 15541.59, "timestamp": "04:19:01", "text": "进去付钱，否则你就得拼命挣扎"}, {"type": "subtitle", "time": 15544.63, "timestamp": "04:19:04", "text": "像我这样的。"}, {"type": "subtitle", "time": 15551.349, "timestamp": "04:19:11", "text": "游戏。茉莉花其实真的很好"}, {"type": "subtitle", "time": 15554.229, "timestamp": "04:19:14", "text": "他自己。他很快就会来了。他"}, {"type": "subtitle", "time": 15568.229, "timestamp": "04:19:28", "text": "[音乐]"}, {"type": "subtitle", "time": 15571.51, "timestamp": "04:19:31", "text": "最初的学习曲线就是……我的意思是……"}, {"type": "subtitle", "time": 15574.149, "timestamp": "04:19:34", "text": "或许今天已经看到了最初的版本。"}, {"type": "subtitle", "time": 15581.79, "timestamp": "04:19:41", "text": "你知道它并不像"}, {"type": "subtitle", "time": 15585.03, "timestamp": "04:19:45", "text": "明显存在类似成瘾或"}, {"type": "subtitle", "time": 15592.469, "timestamp": "04:19:52", "text": "该死的。我刚才是不是玩了《Valerant》？它不是"}, {"type": "subtitle", "time": 15595.59, "timestamp": "04:19:55", "text": "就像，是啊，你走，你匆匆忙忙，你"}, {"type": "subtitle", "time": 15597.67, "timestamp": "04:19:57", "text": "开拍，哦耶，走吧。它不是"}, {"type": "subtitle", "time": 15599.71, "timestamp": "04:19:59", "text": "如此迅速地"}]
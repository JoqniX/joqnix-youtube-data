[{"type": "subtitle", "time": 4633.59, "timestamp": "01:17:13", "text": "乔，发生什么事了？你在哪里？"}, {"type": "subtitle", "time": 4635.91, "timestamp": "01:17:15", "text": "老兄，这正是我要问你的。我是"}, {"type": "subtitle", "time": 4640.669, "timestamp": "01:17:20", "text": "正在寻找你。我的天啊。我"}, {"type": "subtitle", "time": 4643.39, "timestamp": "01:17:23", "text": "你从哪里来的？"}, {"type": "subtitle", "time": 4647.31, "timestamp": "01:17:27", "text": "从？那是什么飞机？"}, {"type": "subtitle", "time": 4651.27, "timestamp": "01:17:31", "text": "所以，我的飞机又不行了，我没有"}, {"type": "subtitle", "time": 4653.27, "timestamp": "01:17:33", "text": "目前我还没有选择飞机。"}, {"type": "subtitle", "time": 4654.75, "timestamp": "01:17:34", "text": "哪些擅长"}, {"type": "subtitle", "time": 4663.99, "timestamp": "01:17:43", "text": "强大的。所以我可以这样做。"}, {"type": "subtitle", "time": 4672.79, "timestamp": "01:17:52", "text": "哦，你真的把我弄死了。是的。"}, {"type": "subtitle", "time": 4674.39, "timestamp": "01:17:54", "text": "好的。我的枪也更……"}, {"type": "subtitle", "time": 4675.91, "timestamp": "01:17:55", "text": "强大的。就是这样。你想要"}, {"type": "subtitle", "time": 4679.27, "timestamp": "01:17:59", "text": "试试参加一场真正的比赛？是的。是的。"}]
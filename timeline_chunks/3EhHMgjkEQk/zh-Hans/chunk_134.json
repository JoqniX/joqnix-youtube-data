[{"type": "subtitle", "time": 8051.99, "timestamp": "02:14:11", "text": "你怎么没到场？"}, {"type": "subtitle", "time": 8053.43, "timestamp": "02:14:13", "text": "我的意思是，我玩过一段时间这个游戏。"}, {"type": "subtitle", "time": 8056.709, "timestamp": "02:14:16", "text": "大概就是这样。"}, {"type": "subtitle", "time": 8060.149, "timestamp": "02:14:20", "text": "哇。此外，运动背心并非一劳永逸。"}, {"type": "subtitle", "time": 8063.27, "timestamp": "02:14:23", "text": "杀。我刚才死了。坦克是"}, {"type": "subtitle", "time": 8065.51, "timestamp": "02:14:25", "text": "通常不会一枪毙命。好的，基于"}, {"type": "subtitle", "time": 8068.31, "timestamp": "02:14:28", "text": "在你射击坦克的位置，你可以"}, {"type": "subtitle", "time": 8069.55, "timestamp": "02:14:29", "text": "损害"}, {"type": "subtitle", "time": 8073.189, "timestamp": "02:14:33", "text": "引擎可能会损坏，或者炮塔也可能受损。所以，"}, {"type": "subtitle", "time": 8074.99, "timestamp": "02:14:34", "text": "他们不能开火，但他们仍然可以"}, {"type": "subtitle", "time": 8077.43, "timestamp": "02:14:37", "text": "移动。或者，如果你运气好，你就能开枪。"}, {"type": "subtitle", "time": 8078.87, "timestamp": "02:14:38", "text": "他们的弹药，然后你炸毁了"}, {"type": "subtitle", "time": 8080.109, "timestamp": "02:14:40", "text": "一个罐体"}, {"type": "subtitle", "time": 8088.229, "timestamp": "02:14:48", "text": "发生。所以，躲在什么东西后面吧。有"}, {"type": "subtitle", "time": 8090.629, "timestamp": "02:14:50", "text": "你的鱼缸大部分被石头挡住了，或者"}, {"type": "subtitle", "time": 8093.149, "timestamp": "02:14:53", "text": "另一名玩家或"}, {"type": "subtitle", "time": 8095.79, "timestamp": "02:14:55", "text": "某物。然后指向"}, {"type": "subtitle", "time": 8098.51, "timestamp": "02:14:58", "text": "敌方坦克"}]
[{"type": "subtitle", "time": 14763.75, "timestamp": "04:06:03", "text": "一般来说，如果你想了解……"}, {"type": "subtitle", "time": 14765.99, "timestamp": "04:06:05", "text": "玩家数量比英国的还要多。"}, {"type": "subtitle", "time": 14772.55, "timestamp": "04:06:12", "text": "英国人口大约是66"}, {"type": "subtitle", "time": 14774.55, "timestamp": "04:06:14", "text": "百万和《战争雷霆》人口"}, {"type": "subtitle", "time": 14782.95, "timestamp": "04:06:22", "text": "我觉得平均而言，你会做什么？"}, {"type": "subtitle", "time": 14785.99, "timestamp": "04:06:25", "text": "你管那叫蒸汽？"}, {"type": "subtitle", "time": 14789.83, "timestamp": "04:06:29", "text": "活跃玩家群体通常在任何"}, {"type": "subtitle", "time": 14792.95, "timestamp": "04:06:32", "text": "考虑到活跃玩家数量约为"}, {"type": "subtitle", "time": 14799.349, "timestamp": "04:06:39", "text": "因此，在游戏过程中的任何特定时刻"}, {"type": "subtitle", "time": 14802.9, "timestamp": "04:06:42", "text": "大概有十万人在玩。"}, {"type": "subtitle", "time": 14804.309, "timestamp": "04:06:44", "text": "[音乐]"}, {"type": "subtitle", "time": 14807.03, "timestamp": "04:06:47", "text": "呃，教教我，你有什么队伍吗？我可以吗？"}, {"type": "subtitle", "time": 14808.95, "timestamp": "04:06:48", "text": "加入。"}, {"type": "subtitle", "time": 14811.349, "timestamp": "04:06:51", "text": "我在一个中队里。我不知道"}, {"type": "subtitle", "time": 14813.349, "timestamp": "04:06:53", "text": "人民。它完全开放自由"}, {"type": "subtitle", "time": 14816.99, "timestamp": "04:06:56", "text": "中队。于是，我加入了。必须是"}]
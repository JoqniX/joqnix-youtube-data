[{"type": "subtitle", "time": 16080.87, "timestamp": "04:28:00", "text": "这项赛事是最困难的赛事之一。"}, {"type": "subtitle", "time": 16083.03, "timestamp": "04:28:03", "text": "可以做的事情"}, {"type": "subtitle", "time": 16088.07, "timestamp": "04:28:08", "text": "我试过三次了，都放弃了。"}, {"type": "subtitle", "time": 16090.229, "timestamp": "04:28:10", "text": "三次都是如此。一旦我真正"}, {"type": "subtitle", "time": 16092.389, "timestamp": "04:28:12", "text": "非常接近"}, {"type": "subtitle", "time": 16095.269, "timestamp": "04:28:15", "text": "我错过了，就差一点点，就像我"}, {"type": "subtitle", "time": 16098.71, "timestamp": "04:28:18", "text": "比预定时间晚了两个小时。"}, {"type": "subtitle", "time": 16100.389, "timestamp": "04:28:20", "text": "啊"}, {"type": "subtitle", "time": 16102.469, "timestamp": "04:28:22", "text": "这两个都和我之前说的很像。"}, {"type": "subtitle", "time": 16104.71, "timestamp": "04:28:24", "text": "错过的就像印度飞机一样"}, {"type": "subtitle", "time": 16105.91, "timestamp": "04:28:25", "text": "正规的印度空军飞机。我当时"}, {"type": "subtitle", "time": 16107.269, "timestamp": "04:28:27", "text": "哦，我好想得到它。我想得到"}, {"type": "subtitle", "time": 16109.67, "timestamp": "04:28:29", "text": "它。"}, {"type": "subtitle", "time": 16113.03, "timestamp": "04:28:33", "text": "现在它们都是高级飞机了。"}, {"type": "subtitle", "time": 16115.269, "timestamp": "04:28:35", "text": "在英国科技树中。所以如果你想"}, {"type": "subtitle", "time": 16117.67, "timestamp": "04:28:37", "text": "为了刷普通科技树"}, {"type": "subtitle", "time": 16119.27, "timestamp": "04:28:39", "text": "航空，"}, {"type": "subtitle", "time": 16120.63, "timestamp": "04:28:40", "text": "[音乐]"}, {"type": "subtitle", "time": 16123.79, "timestamp": "04:28:43", "text": "最好的做法是英国人"}, {"type": "subtitle", "time": 16127.75, "timestamp": "04:28:47", "text": "一是因为他们给了印度潜艇。所以对于"}, {"type": "subtitle", "time": 16130.229, "timestamp": "04:28:50", "text": "例如，他们最初拥有全世界"}, {"type": "subtitle", "time": 16133.349, "timestamp": "04:28:53", "text": "二战国家。这就是你看到我们的原因。"}, {"type": "subtitle", "time": 16135.83, "timestamp": "04:28:55", "text": "德国、苏联、英国、日本和"}, {"type": "subtitle", "time": 16138.63, "timestamp": "04:28:58", "text": "中国、意大利和法国位居前列。中国"}]
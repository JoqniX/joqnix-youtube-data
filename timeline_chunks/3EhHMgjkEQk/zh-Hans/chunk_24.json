[{"type": "subtitle", "time": 1442.31, "timestamp": "00:24:02", "text": "我的意思是，对你来说没问题。对于某些人来说"}, {"type": "subtitle", "time": 1445.11, "timestamp": "00:24:05", "text": "现在人们要花很长时间才能……"}, {"type": "subtitle", "time": 1447.35, "timestamp": "00:24:07", "text": "回应。所以我就想，“我的天哪，他们"}, {"type": "subtitle", "time": 1448.71, "timestamp": "00:24:08", "text": "尚未确认。”所以你睡不着"}, {"type": "subtitle", "time": 1450.63, "timestamp": "00:24:10", "text": "直到他们回应？"}, {"type": "subtitle", "time": 1454.47, "timestamp": "00:24:14", "text": "不，我一般会等他们过来。"}, {"type": "subtitle", "time": 1456.549, "timestamp": "00:24:16", "text": "在线的。"}, {"type": "subtitle", "time": 1459.75, "timestamp": "00:24:19", "text": "然后我就想，“哦，已经过了凌晨5点了。”"}, {"type": "subtitle", "time": 1461.19, "timestamp": "00:24:21", "text": "他们应该去睡觉了。”他们之后就没再来了。"}, {"type": "subtitle", "time": 1463.19, "timestamp": "00:24:23", "text": "线。所以你真的要等很久很久。"}, {"type": "subtitle", "time": 1470.07, "timestamp": "00:24:30", "text": "不，我还有其他工作，那样我就会……"}, {"type": "subtitle", "time": 1472.149, "timestamp": "00:24:32", "text": "请稍等。"}, {"type": "subtitle", "time": 1475.35, "timestamp": "00:24:35", "text": "是的。我的天啊。"}, {"type": "subtitle", "time": 1477.11, "timestamp": "00:24:37", "text": "还有，为什么非要等到凌晨5点？"}, {"type": "subtitle", "time": 1478.63, "timestamp": "00:24:38", "text": "谁会在这段时间回复你？"}, {"type": "subtitle", "time": 1481.11, "timestamp": "00:24:41", "text": "凌晨3点和5点？每个人的"}, {"type": "subtitle", "time": 1484.149, "timestamp": "00:24:44", "text": "反正已经睡着了。就像他们一样"}, {"type": "subtitle", "time": 1487.269, "timestamp": "00:24:47", "text": "日本 YouTuber。不。所以，我当时就想，"}, {"type": "subtitle", "time": 1489.269, "timestamp": "00:24:49", "text": "等待。哦，对。你就像到处都是"}, {"type": "subtitle", "time": 1491.95, "timestamp": "00:24:51", "text": "这个地方。对，对，对，对。"}, {"type": "subtitle", "time": 1494.19, "timestamp": "00:24:54", "text": "我，但是"}, {"type": "subtitle", "time": 1498.669, "timestamp": "00:24:58", "text": "是啊，所以我就想，是啊，但是就像我"}]
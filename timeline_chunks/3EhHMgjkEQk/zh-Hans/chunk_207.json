[{"type": "subtitle", "time": 12420.95, "timestamp": "03:27:00", "text": "独自一人"}, {"type": "subtitle", "time": 12422.389, "timestamp": "03:27:02", "text": "否则他们怎么能让你……"}, {"type": "subtitle", "time": 12424.79, "timestamp": "03:27:04", "text": "渴望得到它吗？"}, {"type": "subtitle", "time": 12426.469, "timestamp": "03:27:06", "text": "这就像小说结尾的悬念一样。"}, {"type": "subtitle", "time": 12428.429, "timestamp": "03:27:08", "text": "日本动画片"}, {"type": "subtitle", "time": 12431.51, "timestamp": "03:27:11", "text": "类似新版《炎炎消防队》或类似剧集"}, {"type": "subtitle", "time": 12433.19, "timestamp": "03:27:13", "text": "我不知道哪些动漫好看"}, {"type": "subtitle", "time": 12436.07, "timestamp": "03:27:16", "text": "现在正在进行中。你也"}, {"type": "subtitle", "time": 12437.469, "timestamp": "03:27:17", "text": "忘了"}, {"type": "subtitle", "time": 12440.87, "timestamp": "03:27:20", "text": "目前还没有什么事发生，所以没法成为X英雄。"}, {"type": "subtitle", "time": 12443.269, "timestamp": "03:27:23", "text": "成为X英雄。我还没开始考虑这个问题。"}, {"type": "subtitle", "time": 12446.15, "timestamp": "03:27:26", "text": "然而。"}, {"type": "subtitle", "time": 12451.51, "timestamp": "03:27:31", "text": "感觉制作痕迹太重了。"}, {"type": "subtitle", "time": 12455.63, "timestamp": "03:27:35", "text": "好的，我们来看看。在哪里？"}, {"type": "subtitle", "time": 12465.99, "timestamp": "03:27:45", "text": "哦，真令人惊讶。你个子太小了，"}]
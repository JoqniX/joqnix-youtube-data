[{"type": "subtitle", "time": 11341.75, "timestamp": "03:09:01", "text": "110%。三、二、一。像完整版一样去"}, {"type": "subtitle", "time": 11344.23, "timestamp": "03:09:04", "text": "快速加速。嗯，我们正在使用Shift键。"}, {"type": "subtitle", "time": 11346.15, "timestamp": "03:09:06", "text": "正确的？"}, {"type": "subtitle", "time": 11347.91, "timestamp": "03:09:07", "text": "无论你的快捷键是什么。我的不是"}, {"type": "subtitle", "time": 11356.07, "timestamp": "03:09:16", "text": "然后你就离开了那艘船，但是……"}, {"type": "subtitle", "time": 11358.469, "timestamp": "03:09:18", "text": "你没指着上面，你这傻瓜，你这架飞机。"}, {"type": "subtitle", "time": 11360.55, "timestamp": "03:09:20", "text": "你必须向上指。哦，我当时在……"}, {"type": "subtitle", "time": 11363.83, "timestamp": "03:09:23", "text": "座舱。所以，是的，你得向上指。"}, {"type": "subtitle", "time": 11365.83, "timestamp": "03:09:25", "text": "是的，它能把你发射出去"}, {"type": "subtitle", "time": 11367.83, "timestamp": "03:09:27", "text": "立即地。"}, {"type": "subtitle", "time": 11369.67, "timestamp": "03:09:29", "text": "好的，我们开始吧。你不需要"}, {"type": "subtitle", "time": 11371.59, "timestamp": "03:09:31", "text": "完成整个航母着舰过程。"}, {"type": "subtitle", "time": 11373.91, "timestamp": "03:09:33", "text": "返回机库。"}, {"type": "subtitle", "time": 11376.23, "timestamp": "03:09:36", "text": "是的。"}, {"type": "subtitle", "time": 11377.51, "timestamp": "03:09:37", "text": "如果你只是想体验一下"}, {"type": "subtitle", "time": 11380.469, "timestamp": "03:09:40", "text": "起飞。"}, {"type": "subtitle", "time": 11382.71, "timestamp": "03:09:42", "text": "该死。"}, {"type": "subtitle", "time": 11385.99, "timestamp": "03:09:45", "text": "点击试飞。就像是“是啊”。"}, {"type": "subtitle", "time": 11389.19, "timestamp": "03:09:49", "text": "然后等待起始重生点"}, {"type": "subtitle", "time": 11391.59, "timestamp": "03:09:51", "text": "航空母舰"}]
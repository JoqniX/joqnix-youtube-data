[{"type": "subtitle", "time": 6185.189, "timestamp": "01:43:05", "text": "我的排名必须比他高四五位。"}, {"type": "subtitle", "time": 6189.27, "timestamp": "01:43:09", "text": "我们。是的。所以为了买到这架飞机，"}, {"type": "subtitle", "time": 6192.39, "timestamp": "01:43:12", "text": "你必须在任何方面达到这个水平。"}, {"type": "subtitle", "time": 6194.229, "timestamp": "01:43:14", "text": "其他国家。"}, {"type": "subtitle", "time": 6198.229, "timestamp": "01:43:18", "text": "啊，假设你最终的成绩是3.3"}, {"type": "subtitle", "time": 6201.669, "timestamp": "01:43:21", "text": "那么，如果你乘坐美国或日本的飞机，你就可以"}, {"type": "subtitle", "time": 6204.629, "timestamp": "01:43:24", "text": "切换到以色列。另外，你还需要"}, {"type": "subtitle", "time": 6207.31, "timestamp": "01:43:27", "text": "这笔钱"}, {"type": "subtitle", "time": 6211.07, "timestamp": "01:43:31", "text": "一直都是这样。显然，你需要"}, {"type": "subtitle", "time": 6219.59, "timestamp": "01:43:39", "text": "该死。现在，坦克完全是"}, {"type": "subtitle", "time": 6221.51, "timestamp": "01:43:41", "text": "完全是两码事。"}, {"type": "subtitle", "time": 6223.03, "timestamp": "01:43:43", "text": "啊，"}, {"type": "subtitle", "time": 6225.59, "timestamp": "01:43:45", "text": "你得到的也是同样的……嗯，该怎么称呼它呢？"}, {"type": "subtitle", "time": 6227.59, "timestamp": "01:43:47", "text": "像飞机那样的X射线，但所有的一切"}, {"type": "subtitle", "time": 6230.82, "timestamp": "01:43:50", "text": "否则情况就截然不同了。"}]
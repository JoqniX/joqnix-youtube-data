[{"type": "subtitle", "time": 8882.71, "timestamp": "02:28:02", "text": "那里到底发生了什么事？"}, {"type": "subtitle", "time": 8894.87, "timestamp": "02:28:14", "text": "检查一下你的音频？哦，我的天啊。什么"}, {"type": "subtitle", "time": 8898.309, "timestamp": "02:28:18", "text": "发生了吗？是的。啊，这……"}, {"type": "subtitle", "time": 8899.91, "timestamp": "02:28:19", "text": "令人尴尬。为什么非得发生这种事呢？"}, {"type": "subtitle", "time": 8902.71, "timestamp": "02:28:22", "text": "正在直播吗？发生了什么？你知道"}, {"type": "subtitle", "time": 8906.23, "timestamp": "02:28:26", "text": "发生了什么？是的，我不小心按到了"}, {"type": "subtitle", "time": 8908.19, "timestamp": "02:28:28", "text": "我把扬声器静音了"}, {"type": "subtitle", "time": 8910.469, "timestamp": "02:28:30", "text": "系统。我甚至不知道我是什么时候做的。"}, {"type": "subtitle", "time": 8914.469, "timestamp": "02:28:34", "text": "那。我的天啊。没关系。"}, {"type": "subtitle", "time": 8918.469, "timestamp": "02:28:38", "text": "哇。那我在这里教你们什么呢？"}, {"type": "subtitle", "time": 8921.349, "timestamp": "02:28:41", "text": "没事的。没关系。没关系。"}, {"type": "subtitle", "time": 8923.59, "timestamp": "02:28:43", "text": "嗯，基本上就是那个人，你"}, {"type": "subtitle", "time": 8927.07, "timestamp": "02:28:47", "text": "我知道，耍我们，我是谁？"}, {"type": "subtitle", "time": 8929.75, "timestamp": "02:28:49", "text": "杀了人，我做的事很糟糕。"}, {"type": "subtitle", "time": 8933.59, "timestamp": "02:28:53", "text": "确实如此，但他之前试图用TK攻击我们。"}, {"type": "subtitle", "time": 8936.23, "timestamp": "02:28:56", "text": "他想误伤我们队友。注意力"}]
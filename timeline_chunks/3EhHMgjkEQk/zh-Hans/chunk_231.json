[{"type": "subtitle", "time": 13890.269, "timestamp": "03:51:30", "text": "下一个，该死。我用完了"}, {"type": "subtitle", "time": 13892.309, "timestamp": "03:51:32", "text": "枪。等等，我的……怎么了？"}, {"type": "subtitle", "time": 13896.51, "timestamp": "03:51:36", "text": "导弹？他们没有这样做"}, {"type": "subtitle", "time": 13899.91, "timestamp": "03:51:39", "text": "事物。哦，也许你打爆了我的电脑"}, {"type": "subtitle", "time": 13907.67, "timestamp": "03:51:47", "text": "或许。"}, {"type": "subtitle", "time": 13913.429, "timestamp": "03:51:53", "text": "嗯，我可以继续，让你……"}, {"type": "subtitle", "time": 13916.55, "timestamp": "03:51:56", "text": "慢慢地让我的飞机性能下降，直到它坠毁。"}, {"type": "subtitle", "time": 13919.189, "timestamp": "03:51:59", "text": "或者我可以修理。速度会更快"}]
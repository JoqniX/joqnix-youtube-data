[{"type": "subtitle", "time": 2460.27, "timestamp": "00:41:00", "text": "一。啊，只是"}, {"type": "subtitle", "time": 2464.39, "timestamp": "00:41:04", "text": "接受它。好了。"}, {"type": "subtitle", "time": 2467.75, "timestamp": "00:41:07", "text": "我们已接受。"}, {"type": "subtitle", "time": 2476.55, "timestamp": "00:41:16", "text": "你想知道如何驾驶一架基础型飞机吗？"}, {"type": "subtitle", "time": 2479.91, "timestamp": "00:41:19", "text": "这东西？正确的。是的。"}, {"type": "subtitle", "time": 2482.75, "timestamp": "00:41:22", "text": "我需要去找基础层"}, {"type": "subtitle", "time": 2485.27, "timestamp": "00:41:25", "text": "飞机。我的所有国家都得到了"}, {"type": "subtitle", "time": 2489.51, "timestamp": "00:41:29", "text": "至少有点喜欢。"}, {"type": "subtitle", "time": 2491.19, "timestamp": "00:41:31", "text": "但问题就在这里。我不明白这些"}, {"type": "subtitle", "time": 2493.43, "timestamp": "00:41:33", "text": "这类游戏。不，这款游戏和"}, {"type": "subtitle", "time": 2496.39, "timestamp": "00:41:36", "text": "已入伍。你必须提升你的所有等级"}, {"type": "subtitle", "time": 2498.43, "timestamp": "00:41:38", "text": "其他国家"}, {"type": "subtitle", "time": 2501.51, "timestamp": "00:41:41", "text": "也。这游戏玩起来太肝了。它"}, {"type": "subtitle", "time": 2504.15, "timestamp": "00:41:44", "text": "视情况而定。你可以选择一个"}, {"type": "subtitle", "time": 2506.069, "timestamp": "00:41:46", "text": "如果你喜欢某个国家，那么你可以去那里。"}, {"type": "subtitle", "time": 2512.87, "timestamp": "00:41:52", "text": "我选择了这个。"}, {"type": "subtitle", "time": 2515.03, "timestamp": "00:41:55", "text": "哦，对不起。是的。是的。前进。去"}, {"type": "subtitle", "time": 2517.99, "timestamp": "00:41:57", "text": "前方。不，所以你不必……"}, {"type": "subtitle", "time": 2519.71, "timestamp": "00:41:59", "text": "特别"}]
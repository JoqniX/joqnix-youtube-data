[{"type": "subtitle", "time": 15851.99, "timestamp": "04:24:11", "text": "该死。你玩这个游戏。我要去"}, {"type": "subtitle", "time": 15853.83, "timestamp": "04:24:13", "text": "开始游戏。我打算尝试"}, {"type": "subtitle", "time": 15856.229, "timestamp": "04:24:16", "text": "从活动现场弄到那架飞机。这是我的"}, {"type": "subtitle", "time": 15858.87, "timestamp": "04:24:18", "text": "上周是项目工作量最大的一周，所以……"}, {"type": "subtitle", "time": 15860.79, "timestamp": "04:24:20", "text": "也许我得不到，但我"}, {"type": "subtitle", "time": 15862.95, "timestamp": "04:24:22", "text": "无论如何，我都会尝试。"}, {"type": "subtitle", "time": 15864.469, "timestamp": "04:24:24", "text": "这是一架喷气式飞机。我打算尝试"}, {"type": "subtitle", "time": 15866.71, "timestamp": "04:24:26", "text": "得到回应：是的，这是一架喷气式飞机。它不是"}, {"type": "subtitle", "time": 15868.71, "timestamp": "04:24:28", "text": "超音速的，但它可以触碰"}, {"type": "subtitle", "time": 15871.429, "timestamp": "04:24:31", "text": "超音速。这是印度制造的"}, {"type": "subtitle", "time": 15874.349, "timestamp": "04:24:34", "text": "呃，一种名为HL的近乎超音速的喷气式飞机。"}, {"type": "subtitle", "time": 15878.91, "timestamp": "04:24:38", "text": "马鲁特。玛鲁特。就是这样。没有"}, {"type": "subtitle", "time": 15881.51, "timestamp": "04:24:41", "text": "H. 如果历史也很酷的话"}, {"type": "subtitle", "time": 15884.07, "timestamp": "04:24:44", "text": "你想稍后再查看。但是……"}, {"type": "subtitle", "time": 15887.429, "timestamp": "04:24:47", "text": "游戏中将会加入飞机。"}, {"type": "subtitle", "time": 15891.229, "timestamp": "04:24:51", "text": "活动从22号开始。"}, {"type": "subtitle", "time": 15894.07, "timestamp": "04:24:54", "text": "24日如果你能坚持2"}, {"type": "subtitle", "time": 15898.59, "timestamp": "04:24:58", "text": "几周时间，在战争中做一件疯狂的事"}]
[{"type": "subtitle", "time": 12667.389, "timestamp": "03:31:07", "text": "开始。"}, {"type": "subtitle", "time": 12670.15, "timestamp": "03:31:10", "text": "申请。准备好。"}, {"type": "subtitle", "time": 12676.71, "timestamp": "03:31:16", "text": "这次应该可以了。我当时"}, {"type": "subtitle", "time": 12678.75, "timestamp": "03:31:18", "text": "有点像要展示"}, {"type": "subtitle", "time": 12681.79, "timestamp": "03:31:21", "text": "你施加了巨大的压力，"}, {"type": "subtitle", "time": 12684.229, "timestamp": "03:31:24", "text": "但我忘了我没有……"}, {"type": "subtitle", "time": 12693.59, "timestamp": "03:31:33", "text": "我先坐那架破飞机，因为它……"}, {"type": "subtitle", "time": 12696.55, "timestamp": "03:31:36", "text": "反正都要被杀了。"}, {"type": "subtitle", "time": 12698.07, "timestamp": "03:31:38", "text": "哦，对了，你可以用你所有的飞机"}, {"type": "subtitle", "time": 12699.429, "timestamp": "03:31:39", "text": "反对我。你根本靠近不了。"}, {"type": "subtitle", "time": 12707.95, "timestamp": "03:31:47", "text": "H. 所以，"}, {"type": "subtitle", "time": 12710.87, "timestamp": "03:31:50", "text": "你对抗喷气式飞机的唯一机会"}, {"type": "subtitle", "time": 12712.95, "timestamp": "03:31:52", "text": "如果你保持非常低的飞行高度，螺旋桨会……"}, {"type": "subtitle", "time": 12715.11, "timestamp": "03:31:55", "text": "地面，如果你身处城市某种程度上"}, {"type": "subtitle", "time": 12716.469, "timestamp": "03:31:56", "text": "一个持续存在的环境"}, {"type": "subtitle", "time": 12718.389, "timestamp": "03:31:58", "text": "阻碍物"}]
[{"type": "subtitle", "time": 14341.15, "timestamp": "03:59:01", "text": "我打算在前面开枪。"}, {"type": "subtitle", "time": 14349.11, "timestamp": "03:59:09", "text": "这座位于沙漠地带的城市，"}, {"type": "subtitle", "time": 14350.87, "timestamp": "03:59:10", "text": "笔直的道路。实际上，这是"}, {"type": "subtitle", "time": 14352.63, "timestamp": "03:59:12", "text": "非常适合练习着陆。"}, {"type": "subtitle", "time": 14355.75, "timestamp": "03:59:15", "text": "起降练习。"}, {"type": "subtitle", "time": 14358.07, "timestamp": "03:59:18", "text": "你得糟糕透顶才会得不到奖励"}, {"type": "subtitle", "time": 14359.83, "timestamp": "03:59:19", "text": "立即着陆。好了，你看到我了吗？"}, {"type": "subtitle", "time": 14366.95, "timestamp": "03:59:26", "text": "城市背后是沙漠地带的下一个地方"}, {"type": "subtitle", "time": 14370.429, "timestamp": "03:59:30", "text": "到你的出生点。回转"}, {"type": "subtitle", "time": 14375.99, "timestamp": "03:59:35", "text": "180°。现在你看到我了吗？是的。"}, {"type": "subtitle", "time": 14379.189, "timestamp": "03:59:39", "text": "好的。让我看看你的渲染距离"}, {"type": "subtitle", "time": 14381.63, "timestamp": "03:59:41", "text": "不高"}, {"type": "subtitle", "time": 14387.99, "timestamp": "03:59:47", "text": "我。不，你要进城。你"}, {"type": "subtitle", "time": 14391.349, "timestamp": "03:59:51", "text": "必须走出困境。哦，在后面。"}, {"type": "subtitle", "time": 14396.63, "timestamp": "03:59:56", "text": "在后面。啊，我看到你了。是的。你看我？"}]
[{"type": "subtitle", "time": 12481.349, "timestamp": "03:28:01", "text": "哦，糟糕。妈的。好的，返回"}, {"type": "subtitle", "time": 12485.11, "timestamp": "03:28:05", "text": "衣架。我知道发生了什么。"}, {"type": "subtitle", "time": 12487.51, "timestamp": "03:28:07", "text": "发生了什么？"}, {"type": "subtitle", "time": 12490.55, "timestamp": "03:28:10", "text": "所以在那架飞机上会发生雷达对峙，"}, {"type": "subtitle", "time": 12493.91, "timestamp": "03:28:13", "text": "正确的？我会在我的实际比赛中飞行"}, {"type": "subtitle", "time": 12496.469, "timestamp": "03:28:16", "text": "那架飞机。有一种东西叫做"}, {"type": "subtitle", "time": 12497.99, "timestamp": "03:28:17", "text": "不同，有不同种类的"}, {"type": "subtitle", "time": 12500.389, "timestamp": "03:28:20", "text": "导弹。"}, {"type": "subtitle", "time": 12502.269, "timestamp": "03:28:22", "text": "所以，就是这样。"}, {"type": "subtitle", "time": 12504.95, "timestamp": "03:28:24", "text": "我跟你说过，就是那种普通的导弹。"}, {"type": "subtitle", "time": 12510.309, "timestamp": "03:28:30", "text": "它会在哪里寻找你的热量。哦，"}, {"type": "subtitle", "time": 12512.15, "timestamp": "03:28:32", "text": "那是老式导弹。"}, {"type": "subtitle", "time": 12514.309, "timestamp": "03:28:34", "text": "它们仍然在使用，但使用方式已不再相同。"}, {"type": "subtitle", "time": 12516.95, "timestamp": "03:28:36", "text": "现在有备份了。以前，他们是"}, {"type": "subtitle", "time": 12519.75, "timestamp": "03:28:39", "text": "用作主导弹。现在他们是"}, {"type": "subtitle", "time": 12526.389, "timestamp": "03:28:46", "text": "导弹。现在有两枚雷达制导导弹。"}, {"type": "subtitle", "time": 12528.269, "timestamp": "03:28:48", "text": "导弹有其自身的"}, {"type": "subtitle", "time": 12532.67, "timestamp": "03:28:52", "text": "雷达。其中一种是导弹，你可以发射它"}, {"type": "subtitle", "time": 12535.67, "timestamp": "03:28:55", "text": "它和你的飞机正在引导"}, {"type": "subtitle", "time": 12537.19, "timestamp": "03:28:57", "text": "导弹。所以我的飞机正在告诉"}]
[{"type": "subtitle", "time": 9726.469, "timestamp": "02:42:06", "text": "优质的。"}, {"type": "subtitle", "time": 9728.99, "timestamp": "02:42:08", "text": "嗯。 F11"}, {"type": "subtitle", "time": 9732.71, "timestamp": "02:42:12", "text": "F117。是的。"}, {"type": "subtitle", "time": 9745.75, "timestamp": "02:42:25", "text": "是的。这是第一个正式的"}, {"type": "subtitle", "time": 9754.63, "timestamp": "02:42:34", "text": "然而，这架飞机的缺点是……"}, {"type": "subtitle", "time": 9757.349, "timestamp": "02:42:37", "text": "只有一架轰炸机。它无法与其他生物战斗。"}, {"type": "subtitle", "time": 9760.71, "timestamp": "02:42:40", "text": "飞机。啊，"}, {"type": "subtitle", "time": 9763.349, "timestamp": "02:42:43", "text": "如果你想测试一下《壮志凌云》，"}, {"type": "subtitle", "time": 9765.59, "timestamp": "02:42:45", "text": "在飞机上，您可以继续向下滚动。"}, {"type": "subtitle", "time": 9767.389, "timestamp": "02:42:47", "text": "这"}, {"type": "subtitle", "time": 9769.429, "timestamp": "02:42:49", "text": "优质的。你到的时候告诉我"}, {"type": "subtitle", "time": 9772.71, "timestamp": "02:42:52", "text": "底部。对，底部。好的。大黄蜂"}, {"type": "subtitle", "time": 9774.389, "timestamp": "02:42:54", "text": "早期的。"}, {"type": "subtitle", "time": 9777.59, "timestamp": "02:42:57", "text": "早期的“大黄蜂”来自新版《壮志凌云》"}]
[{"type": "subtitle", "time": 12301.67, "timestamp": "03:25:01", "text": "哇。你知道我可以从类似的地方射杀你"}, {"type": "subtitle", "time": 12305.99, "timestamp": "03:25:05", "text": "距离目的地20英里，对吧？距离20公里。真的吗？"}, {"type": "subtitle", "time": 12308.87, "timestamp": "03:25:08", "text": "我只会挠挠你。在那架飞机上。"}, {"type": "subtitle", "time": 12310.309, "timestamp": "03:25:10", "text": "在那架飞机上。我没有那架飞机。"}, {"type": "subtitle", "time": 12311.67, "timestamp": "03:25:11", "text": "再次。所以，我们得开始……"}, {"type": "subtitle", "time": 12319.03, "timestamp": "03:25:19", "text": "哪架飞机？就是汤姆·克鲁斯那一个。"}, {"type": "subtitle", "time": 12321.91, "timestamp": "03:25:21", "text": "你刚才看到的那个。"}, {"type": "subtitle", "time": 12323.67, "timestamp": "03:25:23", "text": "等等，我们可以……对，汤姆·克鲁斯的那个"}, {"type": "subtitle", "time": 12326.71, "timestamp": "03:25:26", "text": "还。我们可以，我可以做到，因为我有"}, {"type": "subtitle", "time": 12328.79, "timestamp": "03:25:28", "text": "飞机，但你不能，因为你没有"}, {"type": "subtitle", "time": 12331.19, "timestamp": "03:25:31", "text": "有飞机。是那架飞机吗？我"}, {"type": "subtitle", "time": 12333.269, "timestamp": "03:25:33", "text": "我没有。我不得不，你知道的，"}, {"type": "subtitle", "time": 12336.63, "timestamp": "03:25:36", "text": "努力奋斗才能买到那架飞机。"}, {"type": "subtitle", "time": 12338.15, "timestamp": "03:25:38", "text": "该死。"}, {"type": "subtitle", "time": 12342.389, "timestamp": "03:25:42", "text": "你在哪里？我必须得到我所有的"}, {"type": "subtitle", "time": 12344.95, "timestamp": "03:25:44", "text": "我隔着盔甲打不到你。"}, {"type": "subtitle", "time": 12346.309, "timestamp": "03:25:46", "text": "帮助。没有什么能帮到你"}, {"type": "subtitle", "time": 12348.07, "timestamp": "03:25:48", "text": "躲过导弹袭击。"}, {"type": "subtitle", "time": 12349.67, "timestamp": "03:25:49", "text": "运气能让你躲过导弹袭击。"}, {"type": "subtitle", "time": 12351.67, "timestamp": "03:25:51", "text": "就是这样。好的。现在，我没有"}, {"type": "subtitle", "time": 12353.51, "timestamp": "03:25:53", "text": "能那样机动的飞机。这"}, {"type": "subtitle", "time": 12355.03, "timestamp": "03:25:55", "text": "比你那架飞机稍微老一些。"}]
[{"type": "subtitle", "time": 7982.55, "timestamp": "02:13:02", "text": "现在我们进入了街机模式，乔克，"}, {"type": "subtitle", "time": 7987.069, "timestamp": "02:13:07", "text": "你的光标，你的"}, {"type": "subtitle", "time": 7989.669, "timestamp": "02:13:09", "text": "当你用十字准星瞄准敌人时"}, {"type": "subtitle", "time": 7992.95, "timestamp": "02:13:12", "text": "油箱，一旦它变成绿色，你就……"}, {"type": "subtitle", "time": 7995.35, "timestamp": "02:13:15", "text": "射击。我死了。除非它变成绿色，否则你"}, {"type": "subtitle", "time": 7996.35, "timestamp": "02:13:16", "text": "不"}, {"type": "subtitle", "time": 7999.35, "timestamp": "02:13:19", "text": "射击。你已经死了。极好的。"}, {"type": "subtitle", "time": 8002.39, "timestamp": "02:13:22", "text": "好的，我会等你回来。"}, {"type": "subtitle", "time": 8019.31, "timestamp": "02:13:39", "text": "去。我们正在将另一个转换成"}, {"type": "subtitle", "time": 8021.669, "timestamp": "02:13:41", "text": "它。我们还要再买一个"}, {"type": "subtitle", "time": 8024.189, "timestamp": "02:13:44", "text": "正在玩《战争雷霆》。我们开始吧"}, {"type": "subtitle", "time": 8026.109, "timestamp": "02:13:46", "text": "去。"}, {"type": "subtitle", "time": 8039.589, "timestamp": "02:13:59", "text": "现在我所要做的就是努力留下来。"}]
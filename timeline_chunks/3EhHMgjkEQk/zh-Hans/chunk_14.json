[{"type": "subtitle", "time": 863.23, "timestamp": "00:14:23", "text": "我得以重新开始。点击重新开始"}, {"type": "subtitle", "time": 865.55, "timestamp": "00:14:25", "text": "慢慢地。快点。快点。快点。来"}, {"type": "subtitle", "time": 868.03, "timestamp": "00:14:28", "text": "在。我的天啊。这"}, {"type": "subtitle", "time": 870.31, "timestamp": "00:14:30", "text": "老鼠，兄弟。鼠标不见了。好的，"}, {"type": "subtitle", "time": 871.55, "timestamp": "00:14:31", "text": "等待。得到"}, {"type": "subtitle", "time": 883.389, "timestamp": "00:14:43", "text": "是的，我们"}, {"type": "subtitle", "time": 885.389, "timestamp": "00:14:45", "text": "开始"}, {"type": "subtitle", "time": 886.91, "timestamp": "00:14:46", "text": "我"}, {"type": "subtitle", "time": 891.55, "timestamp": "00:14:51", "text": "思考。好的。呃，让我来告诉你如何……"}]
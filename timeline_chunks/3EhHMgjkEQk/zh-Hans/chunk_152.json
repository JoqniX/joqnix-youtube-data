[{"type": "subtitle", "time": 9120.63, "timestamp": "02:32:00", "text": "是的，那也是比较新的。"}, {"type": "subtitle", "time": 9123.03, "timestamp": "02:32:03", "text": "它大概有一两年的历史了，"}, {"type": "subtitle", "time": 9136.79, "timestamp": "02:32:16", "text": "在逼真的坦克中，情况要复杂得多。"}, {"type": "subtitle", "time": 9140.23, "timestamp": "02:32:20", "text": "比飞机还可怕"}, {"type": "subtitle", "time": 9142.389, "timestamp": "02:32:22", "text": "因为你进入坦克，你就进去了，你"}, {"type": "subtitle", "time": 9145.27, "timestamp": "02:32:25", "text": "你知道，你得看看地面。"}, {"type": "subtitle", "time": 9147.429, "timestamp": "02:32:27", "text": "敌方坦克通常很容易就能……"}, {"type": "subtitle", "time": 9150.19, "timestamp": "02:32:30", "text": "伪装在地面上，位于前方"}, {"type": "subtitle", "time": 9152.87, "timestamp": "02:32:32", "text": "你。你的指标为零。你有"}, {"type": "subtitle", "time": 9155.51, "timestamp": "02:32:35", "text": "用你的眼睛去寻找"}, {"type": "subtitle", "time": 9158.79, "timestamp": "02:32:38", "text": "敌方坦克"}, {"type": "subtitle", "time": 9161.429, "timestamp": "02:32:41", "text": "然后，你还得想办法安排好一切。"}, {"type": "subtitle", "time": 9164.92, "timestamp": "02:32:44", "text": "击中坦克。所以，这真的有那么现实。"}, {"type": "subtitle", "time": 9175.83, "timestamp": "02:32:55", "text": "等等，让我看看你们有哪些飞机。"}, {"type": "subtitle", "time": 9177.03, "timestamp": "02:32:57", "text": "看看你有没有什么类型的"}, {"type": "subtitle", "time": 9179.51, "timestamp": "02:32:59", "text": "轰炸机。"}]
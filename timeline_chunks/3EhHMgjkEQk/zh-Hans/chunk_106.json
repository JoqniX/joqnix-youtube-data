[{"type": "subtitle", "time": 6360.31, "timestamp": "01:46:00", "text": "时刻注意身后。"}, {"type": "subtitle", "time": 6361.91, "timestamp": "01:46:01", "text": "因为当你开枪射杀某人时，"}, {"type": "subtitle", "time": 6372.31, "timestamp": "01:46:12", "text": "明白了。也许它们都是团队，对吧？"}, {"type": "subtitle", "time": 6374.189, "timestamp": "01:46:14", "text": "还是同一个团队，对吧？是的，我们身处……"}, {"type": "subtitle", "time": 6377.75, "timestamp": "01:46:17", "text": "相同的。这是一张真实的地图，所以我不会"}, {"type": "subtitle", "time": 6380.709, "timestamp": "01:46:20", "text": "几乎总是身处对手阵营。"}, {"type": "subtitle", "time": 6383.35, "timestamp": "01:46:23", "text": "我的天哪，好多飞机啊！"}, {"type": "subtitle", "time": 6385.27, "timestamp": "01:46:25", "text": "是的。所以，如果你转身往回看"}, {"type": "subtitle", "time": 6388.79, "timestamp": "01:46:28", "text": "在你身后，你可以看到敌方飞机。"}, {"type": "subtitle", "time": 6390.629, "timestamp": "01:46:30", "text": "红色部分代表你自己的队友。"}, {"type": "subtitle", "time": 6399.03, "timestamp": "01:46:39", "text": "那是某人的标识符。"}, {"type": "subtitle", "time": 6401.35, "timestamp": "01:46:41", "text": "你在玩。"}, {"type": "subtitle", "time": 6403.91, "timestamp": "01:46:43", "text": "现在，如果你爬到很高的地方，通常"}, {"type": "subtitle", "time": 6405.31, "timestamp": "01:46:45", "text": "那些飞机是"}, {"type": "subtitle", "time": 6407.669, "timestamp": "01:46:47", "text": "轰炸机。如果你不正面迎击，"}, {"type": "subtitle", "time": 6410.229, "timestamp": "01:46:50", "text": "它们很容易被射杀。如果你下去，"}, {"type": "subtitle", "time": 6413.27, "timestamp": "01:46:53", "text": "你打了一场漂亮的仗。"}, {"type": "subtitle", "time": 6416.149, "timestamp": "01:46:56", "text": "迎面相撞时务必格外小心。"}, {"type": "subtitle", "time": 6418.47, "timestamp": "01:46:58", "text": "我受伤了。我要返回"}]
[{"type": "subtitle", "time": 13141.59, "timestamp": "03:39:01", "text": "好的。你想让我怎么来？你"}, {"type": "subtitle", "time": 13144.55, "timestamp": "03:39:04", "text": "你想让我从高处还是低处来？"}, {"type": "subtitle", "time": 13149.11, "timestamp": "03:39:09", "text": "低的？任何事物。暂停。呃，不，不，不。"}, {"type": "subtitle", "time": 13151.59, "timestamp": "03:39:11", "text": "我给你一个选择。你想要怎样的？"}, {"type": "subtitle", "time": 13154.229, "timestamp": "03:39:14", "text": "让我攻击你？高还是低？"}, {"type": "subtitle", "time": 13161.429, "timestamp": "03:39:21", "text": "呃，向下。"}, {"type": "subtitle", "time": 13162.67, "timestamp": "03:39:22", "text": "低处。"}, {"type": "subtitle", "time": 13165.229, "timestamp": "03:39:25", "text": "好的。你看，往下看，你有更多的时间。"}, {"type": "subtitle", "time": 13167.83, "timestamp": "03:39:27", "text": "因为那里有建筑物之类的东西。我"}]
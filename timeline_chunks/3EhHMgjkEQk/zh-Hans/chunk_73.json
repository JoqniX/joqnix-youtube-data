[{"type": "subtitle", "time": 4381.91, "timestamp": "01:13:01", "text": "进入你的摄像头锁定模式。我不"}, {"type": "subtitle", "time": 4384.229, "timestamp": "01:13:04", "text": "实际锁定摄像头拍摄你。告诉我"}, {"type": "subtitle", "time": 4386.95, "timestamp": "01:13:06", "text": "换成钥匙。因为现在正在发生什么"}, {"type": "subtitle", "time": 4388.709, "timestamp": "01:13:08", "text": "事情的起因是我们俩都不会……"}, {"type": "subtitle", "time": 4390.55, "timestamp": "01:13:10", "text": "因为你有架更好的飞机，所以能拍一张照片。"}, {"type": "subtitle", "time": 4401.59, "timestamp": "01:13:21", "text": "我想看看你怎么射中我。"}, {"type": "subtitle", "time": 4404.55, "timestamp": "01:13:24", "text": "方式。不，你的飞机好得多。"}, {"type": "subtitle", "time": 4406.149, "timestamp": "01:13:26", "text": "所以，我恐怕很难做到。"}, {"type": "subtitle", "time": 4407.55, "timestamp": "01:13:27", "text": "落后"}, {"type": "subtitle", "time": 4419.75, "timestamp": "01:13:39", "text": "哦，"}, {"type": "subtitle", "time": 4422.55, "timestamp": "01:13:42", "text": "你也可以直接撞我。顺便说一句，我们"}, {"type": "subtitle", "time": 4423.83, "timestamp": "01:13:43", "text": "可能会不小心撞到彼此。"}, {"type": "subtitle", "time": 4428.709, "timestamp": "01:13:48", "text": "你可以和队友一起做这件事，而且"}, {"type": "subtitle", "time": 4431.11, "timestamp": "01:13:51", "text": "敌人。在空战中"}, {"type": "subtitle", "time": 4434.229, "timestamp": "01:13:54", "text": "尤其值得一提的是，你可以进行队友误伤。"}, {"type": "subtitle", "time": 4437.55, "timestamp": "01:13:57", "text": "啊，在坦克比赛中，你不能这样做"}]
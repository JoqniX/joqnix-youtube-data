[{"type": "subtitle", "time": 3848.39, "timestamp": "01:04:08", "text": "逐渐加速。你速度太慢了。"}, {"type": "subtitle", "time": 3851.029, "timestamp": "01:04:11", "text": "你会撞到山上。拿"}, {"type": "subtitle", "time": 3854.47, "timestamp": "01:04:14", "text": "离开。起飞。起飞。等等，其实"}, {"type": "subtitle", "time": 3857.67, "timestamp": "01:04:17", "text": "起飞？是的。对，真的要起飞了。"}, {"type": "subtitle", "time": 3862.71, "timestamp": "01:04:22", "text": "我为什么不呢？什么是假起飞？"}, {"type": "subtitle", "time": 3867.19, "timestamp": "01:04:27", "text": "不，我可以，我其实可以减慢它的速度。"}, {"type": "subtitle", "time": 3870.069, "timestamp": "01:04:30", "text": "好了，现在再跟着我走。让我们找到一个"}, {"type": "subtitle", "time": 3878.549, "timestamp": "01:04:38", "text": "我的天啊。我不知道你可以转身"}, {"type": "subtitle", "time": 3894.95, "timestamp": "01:04:54", "text": "好的。你可能取消了一个着陆点"}, {"type": "subtitle", "time": 3898.63, "timestamp": "01:04:58", "text": "一两套装备。不，没什么。没有什么"}]
[{"type": "subtitle", "time": 9780.63, "timestamp": "02:43:00", "text": "F14A 是来自新的，而且"}, {"type": "subtitle", "time": 9782.67, "timestamp": "02:43:02", "text": "较旧的顶部"}, {"type": "subtitle", "time": 9784.59, "timestamp": "02:43:04", "text": "枪。这"}, {"type": "subtitle", "time": 9787.75, "timestamp": "02:43:07", "text": "F-14A是能够移动的飞机"}, {"type": "subtitle", "time": 9790.389, "timestamp": "02:43:10", "text": "翅膀。所以你或许可以试试这个方法。"}, {"type": "subtitle", "time": 9792.389, "timestamp": "02:43:12", "text": "第一的。"}, {"type": "subtitle", "time": 9795.19, "timestamp": "02:43:15", "text": "好的。我应该进行试飞吗？是的，测试"}, {"type": "subtitle", "time": 9797.91, "timestamp": "02:43:17", "text": "航班。"}, {"type": "subtitle", "time": 9801.59, "timestamp": "02:43:21", "text": "好的。此外，你还没有体验过"}, {"type": "subtitle", "time": 9803.75, "timestamp": "02:43:23", "text": "嗯，突破音障。你会"}, {"type": "subtitle", "time": 9806.87, "timestamp": "02:43:26", "text": "体验一下吧。"}, {"type": "chat", "time": 9807.66, "timestamp": "02:43:27", "author": "@BRUCELEE-wt7hk", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kywKa6HSckNVxhER8qedLRRVkcGIqFFytjQHe-071HyMo=s64-c-k-c0x00ffffff-no-rj", "message": "hello joqnix"}, {"type": "subtitle", "time": 9809.429, "timestamp": "02:43:29", "text": "你在破坏什么？"}, {"type": "subtitle", "time": 9810.95, "timestamp": "02:43:30", "text": "当你加速时，音障就会消失。"}, {"type": "subtitle", "time": 9813.03, "timestamp": "02:43:33", "text": "比音速还快。"}, {"type": "subtitle", "time": 9816.95, "timestamp": "02:43:36", "text": "等等，什么？那确实有这么回事。是的。乔，我们"}, {"type": "subtitle", "time": 9819.429, "timestamp": "02:43:39", "text": "这里正飞着喷气式飞机。喷气机"}, {"type": "subtitle", "time": 9822.389, "timestamp": "02:43:42", "text": "比音速还快。哦，"}, {"type": "subtitle", "time": 9824.15, "timestamp": "02:43:44", "text": "至少是军用飞机，不是客运飞机。"}, {"type": "subtitle", "time": 9826.79, "timestamp": "02:43:46", "text": "一。这也会在以下方面进行建模："}, {"type": "chat", "time": 9833.177, "timestamp": "02:43:53", "author": "@BRUCELEE-wt7hk", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kywKa6HSckNVxhER8qedLRRVkcGIqFFytjQHe-071HyMo=s64-c-k-c0x00ffffff-no-rj", "message": "how you doing"}]
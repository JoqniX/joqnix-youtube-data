[{"type": "subtitle", "time": 11054.389, "timestamp": "03:04:14", "text": "我觉得我需要更高一些。"}, {"type": "subtitle", "time": 11055.91, "timestamp": "03:04:15", "text": "另外，你是从前面进来的"}, {"type": "subtitle", "time": 11058.23, "timestamp": "03:04:18", "text": "那艘船。你需要走到它后面去。这"}, {"type": "subtitle", "time": 11061.349, "timestamp": "03:04:21", "text": "并不落后。不，你必须进来。"}, {"type": "subtitle", "time": 11063.99, "timestamp": "03:04:23", "text": "来自土地。"}, {"type": "subtitle", "time": 11065.75, "timestamp": "03:04:25", "text": "呃，就我所见，这艘船是"}, {"type": "subtitle", "time": 11066.91, "timestamp": "03:04:26", "text": "指向"}, {"type": "subtitle", "time": 11069.99, "timestamp": "03:04:29", "text": "你。查看船只的位置。"}, {"type": "subtitle", "time": 11071.269, "timestamp": "03:04:31", "text": "去？它是朝着陆地方向前进吗？"}, {"type": "subtitle", "time": 11073.83, "timestamp": "03:04:33", "text": "它正朝你这边过来吗？"}, {"type": "subtitle", "time": 11075.269, "timestamp": "03:04:35", "text": "它没有显示方向。"}, {"type": "subtitle", "time": 11076.79, "timestamp": "03:04:36", "text": "地图。"}, {"type": "subtitle", "time": 11085.03, "timestamp": "03:04:45", "text": "好吧，我们可以……"}, {"type": "subtitle", "time": 11087.91, "timestamp": "03:04:47", "text": "如果塔在左边，"}, {"type": "subtitle", "time": 11091.19, "timestamp": "03:04:51", "text": "船正朝你驶来。看？"}, {"type": "subtitle", "time": 11093.269, "timestamp": "03:04:53", "text": "哦。每当船塔要"}, {"type": "subtitle", "time": 11097.269, "timestamp": "03:04:57", "text": "它的左边，它正朝你飞来。"}]
[{"type": "subtitle", "time": 13205.11, "timestamp": "03:40:05", "text": "等等，在你杀他之前我就坠机了。"}, {"type": "subtitle", "time": 13208.469, "timestamp": "03:40:08", "text": "是的。哦，看来你藏得很好啊。"}, {"type": "subtitle", "time": 13211.03, "timestamp": "03:40:11", "text": "建筑物后面。我看到你大概6、7岁。"}, {"type": "subtitle", "time": 13214.55, "timestamp": "03:40:14", "text": "距离目标还有几公里，但我无法瞄准导弹。"}, {"type": "subtitle", "time": 13217.55, "timestamp": "03:40:17", "text": "因为你总是落后于人，所以才这样对你。"}, {"type": "subtitle", "time": 13219.75, "timestamp": "03:40:19", "text": "建筑物。所以，如果你走到一个后面"}, {"type": "subtitle", "time": 13222.389, "timestamp": "03:40:22", "text": "物理屏障，无论什么"}, {"type": "subtitle", "time": 13225.19, "timestamp": "03:40:25", "text": "我拥有的那种导弹。"}, {"type": "subtitle", "time": 13227.349, "timestamp": "03:40:27", "text": "如果你待在屏障后面，我就没办法了。"}, {"type": "subtitle", "time": 13229.75, "timestamp": "03:40:29", "text": "打你。"}, {"type": "subtitle", "time": 13233.67, "timestamp": "03:40:33", "text": "啊，我得起床了，要么我得……"}, {"type": "subtitle", "time": 13235.83, "timestamp": "03:40:35", "text": "就在你旁边，随时可能打到你，或者我已经……"}, {"type": "subtitle", "time": 13238.229, "timestamp": "03:40:38", "text": "高度要足够高，使得障碍物"}, {"type": "subtitle", "time": 13241.75, "timestamp": "03:40:41", "text": "不够高，藏不住你。"}, {"type": "subtitle", "time": 13243.349, "timestamp": "03:40:43", "text": "哦，"}, {"type": "subtitle", "time": 13252.79, "timestamp": "03:40:52", "text": "我想你们的飞机都完工了。是的。"}, {"type": "subtitle", "time": 13254.87, "timestamp": "03:40:54", "text": "难道没有办法重生吗？"}, {"type": "subtitle", "time": 13256.71, "timestamp": "03:40:56", "text": "飞机？"}, {"type": "subtitle", "time": 13258.55, "timestamp": "03:40:58", "text": "呃，如果你需要的话，我可以更改模式。"}]
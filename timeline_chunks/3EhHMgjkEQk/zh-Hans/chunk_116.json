[{"type": "subtitle", "time": 6960.07, "timestamp": "01:56:00", "text": "哦，我只是想给你一点小小的暗示。"}, {"type": "subtitle", "time": 6965.83, "timestamp": "01:56:05", "text": "好的。你学会了如何迫降"}, {"type": "subtitle", "time": 6967.83, "timestamp": "01:56:07", "text": "没有着陆。我们走吧。我敢肯定。"}, {"type": "subtitle", "time": 6976.47, "timestamp": "01:56:16", "text": "一般来说，人们往往会崩溃"}, {"type": "subtitle", "time": 6978.95, "timestamp": "01:56:18", "text": "着陆比降落快"}, {"type": "subtitle", "time": 6981.99, "timestamp": "01:56:21", "text": "带有起落架。嗯。但是你可以"}, {"type": "subtitle", "time": 7000.87, "timestamp": "01:56:40", "text": "那个人完蛋了。还有另一个人，"}, {"type": "subtitle", "time": 7002.95, "timestamp": "01:56:42", "text": "但他其实挺聪明的。他坚持"}, {"type": "subtitle", "time": 7009.99, "timestamp": "01:56:49", "text": "只有两个。"}, {"type": "subtitle", "time": 7013.669, "timestamp": "01:56:53", "text": "只剩下两架飞机了"}, {"type": "subtitle", "time": 7015.99, "timestamp": "01:56:55", "text": "站在我们这边。看起来是这样。哦，糟糕。"}, {"type": "subtitle", "time": 7019.75, "timestamp": "01:56:59", "text": "是的，我们是最后一批了。哇。我"}]
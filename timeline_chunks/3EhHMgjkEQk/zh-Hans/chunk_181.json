[{"type": "subtitle", "time": 10861.429, "timestamp": "03:01:01", "text": "向右走。"}, {"type": "subtitle", "time": 10863.51, "timestamp": "03:01:03", "text": "哦，不。气刹对你没有帮助"}, {"type": "subtitle", "time": 10871.67, "timestamp": "03:01:11", "text": "轮胎。好的。现在，你必须想办法"}, {"type": "subtitle", "time": 10874.19, "timestamp": "03:01:14", "text": "转动你的飞机"}, {"type": "subtitle", "time": 10878.309, "timestamp": "03:01:18", "text": "足以让人惊叹：等等，看看那个。看"}, {"type": "subtitle", "time": 10880.71, "timestamp": "03:01:20", "text": "在呃，你看到那两块灰色的灰色"}, {"type": "subtitle", "time": 10884.55, "timestamp": "03:01:24", "text": "线路？是的。"}, {"type": "subtitle", "time": 10886.59, "timestamp": "03:01:26", "text": "在最前面，而不是你们这些人"}, {"type": "subtitle", "time": 10889.67, "timestamp": "03:01:29", "text": "在。在你前方右侧。不，不"}, {"type": "subtitle", "time": 10892.95, "timestamp": "03:01:32", "text": "在你面前。就在你面前。"}, {"type": "subtitle", "time": 10896.309, "timestamp": "03:01:36", "text": "两条灰色线条，就像这个金属制品上的那样。"}, {"type": "subtitle", "time": 10900.23, "timestamp": "03:01:40", "text": "是的，但位于船头前方。"}, {"type": "subtitle", "time": 10903.59, "timestamp": "03:01:43", "text": "船上。是的。试着转弯你的飞机"}, {"type": "subtitle", "time": 10906.07, "timestamp": "03:01:46", "text": "缓慢而小心地使用"}, {"type": "chat", "time": 10913.277, "timestamp": "03:01:53", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "👋🏻"}]
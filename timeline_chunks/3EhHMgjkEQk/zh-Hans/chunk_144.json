[{"type": "subtitle", "time": 8641.03, "timestamp": "02:24:01", "text": "这里。我在这里。我想他只是需要"}, {"type": "subtitle", "time": 8643.67, "timestamp": "02:24:03", "text": "静音。迈克真的在上场。好的。"}, {"type": "subtitle", "time": 8653.99, "timestamp": "02:24:13", "text": "等等，等等，等等。已经有了"}, {"type": "subtitle", "time": 8656.87, "timestamp": "02:24:16", "text": "有人试图击杀队友。"}, {"type": "subtitle", "time": 8677.67, "timestamp": "02:24:37", "text": "等等，不知为何我没听到乔克的声音。"}, {"type": "subtitle", "time": 8680.59, "timestamp": "02:24:40", "text": "完全没有。等等，你为什么听不见？"}, {"type": "subtitle", "time": 8684.23, "timestamp": "02:24:44", "text": "我？你好。"}, {"type": "subtitle", "time": 8686.27, "timestamp": "02:24:46", "text": "不，乔，别跟他打架。他是我们的"}, {"type": "subtitle", "time": 8688.27, "timestamp": "02:24:48", "text": "队友。他是"}, {"type": "subtitle", "time": 8699.55, "timestamp": "02:24:59", "text": "那。我有一个燃料湖。我必须"}]
[{"type": "subtitle", "time": 14940.95, "timestamp": "04:09:00", "text": "我可以订购这个吗？不，不，不"}, {"type": "subtitle", "time": 14944.71, "timestamp": "04:09:04", "text": "不，不。你不能。你不能。为什么？你"}, {"type": "subtitle", "time": 14948.79, "timestamp": "04:09:08", "text": "不能。为什么？没有十字架。结束它。你"}, {"type": "subtitle", "time": 14952.309, "timestamp": "04:09:12", "text": "必须付出努力。乔克。我的天啊。"}, {"type": "subtitle", "time": 14955.91, "timestamp": "04:09:15", "text": "这不是免费赠品。点击 sotr。"}, {"type": "subtitle", "time": 14960.15, "timestamp": "04:09:20", "text": "哪里是这样？好的。是的。是的。现在，"}, {"type": "subtitle", "time": 14962.429, "timestamp": "04:09:22", "text": "点击"}, {"type": "subtitle", "time": 14966.309, "timestamp": "04:09:26", "text": "活动。底部。底部。底部。"}, {"type": "subtitle", "time": 14967.59, "timestamp": "04:09:27", "text": "您无需滚动页面。就是这样"}, {"type": "subtitle", "time": 14970.189, "timestamp": "04:09:30", "text": "就在那儿。"}, {"type": "subtitle", "time": 14972.63, "timestamp": "04:09:32", "text": "活动。哦，好的。你不必"}, {"type": "subtitle", "time": 14975.11, "timestamp": "04:09:35", "text": "滚动。不，不是那种活动。这"}, {"type": "subtitle", "time": 14977.349, "timestamp": "04:09:37", "text": "底部活动。"}, {"type": "subtitle", "time": 14980.79, "timestamp": "04:09:40", "text": "啊，是的。现在，你明白中队是如何运作的了吧"}, {"type": "subtitle", "time": 14984.15, "timestamp": "04:09:44", "text": "活跃度为 21%，而您的活跃度为零。"}, {"type": "subtitle", "time": 14985.51, "timestamp": "04:09:45", "text": "是的。"}, {"type": "subtitle", "time": 14987.91, "timestamp": "04:09:47", "text": "下面写着这段时间"}, {"type": "subtitle", "time": 14991.11, "timestamp": "04:09:51", "text": "将于5月19日结束。"}, {"type": "subtitle", "time": 14993.349, "timestamp": "04:09:53", "text": "就像我之前提到的那个活动一样"}, {"type": "subtitle", "time": 14996.07, "timestamp": "04:09:56", "text": "我每两天就跟你说过你真的会玩。"}, {"type": "subtitle", "time": 14998.229, "timestamp": "04:09:58", "text": "出色地。你的中队也打得非常好"}]
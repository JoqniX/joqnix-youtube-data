[{"type": "subtitle", "time": 4261.51, "timestamp": "01:11:01", "text": "在线购买食品杂货？很少。我确实有，但是"}, {"type": "subtitle", "time": 4264.87, "timestamp": "01:11:04", "text": "很少。是的，我明白了。等等，什么？"}, {"type": "subtitle", "time": 4266.63, "timestamp": "01:11:06", "text": "发生了吗？难道不是吗？这表明"}, {"type": "subtitle", "time": 4269.669, "timestamp": "01:11:09", "text": "你不在比赛名单中。好吧，我忘了"}, {"type": "subtitle", "time": 4272.55, "timestamp": "01:11:12", "text": "点击开始。好了，我们走吧。"}, {"type": "subtitle", "time": 4274.87, "timestamp": "01:11:14", "text": "哦，找到了。它给了我21分"}, {"type": "subtitle", "time": 4277.35, "timestamp": "01:11:17", "text": "满分60分，因为感觉就像你是"}, {"type": "subtitle", "time": 4281.27, "timestamp": "01:11:21", "text": "在那里玩。那确实有这么回事。我的天啊。"}, {"type": "subtitle", "time": 4283.669, "timestamp": "01:11:23", "text": "是的。如果显示你不在场"}, {"type": "subtitle", "time": 4286.55, "timestamp": "01:11:26", "text": "或者你会想，那该怎么称呼呢？"}, {"type": "subtitle", "time": 4288.149, "timestamp": "01:11:28", "text": "离开键盘，它就会"}, {"type": "subtitle", "time": 4290.229, "timestamp": "01:11:30", "text": "赶紧把所有分数都给我。"}, {"type": "subtitle", "time": 4291.99, "timestamp": "01:11:31", "text": "好的。禁止射击。你只需穿过"}, {"type": "subtitle", "time": 4293.59, "timestamp": "01:11:33", "text": "互相转身，然后你们就开始吧"}, {"type": "subtitle", "time": 4296.39, "timestamp": "01:11:36", "text": "斗争。好的。"}, {"type": "subtitle", "time": 4298.47, "timestamp": "01:11:38", "text": "现在，除了着陆襟翼之外，其他襟翼和"}, {"type": "subtitle", "time": 4308.27, "timestamp": "01:11:48", "text": "比赛开始。你会看到一个"}, {"type": "subtitle", "time": 4310.55, "timestamp": "01:11:50", "text": "我面前出现了一个半透明的圆圈。"}, {"type": "subtitle", "time": 4313.95, "timestamp": "01:11:53", "text": "那就是你要瞄准的圆圈。"}, {"type": "subtitle", "time": 4316.95, "timestamp": "01:11:56", "text": "是的。你怎么转得这么快？我是"}]
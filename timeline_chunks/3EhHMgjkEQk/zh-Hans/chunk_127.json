[{"type": "subtitle", "time": 7624.79, "timestamp": "02:07:04", "text": "重新加载游戏，即可获得皮肤。哦。"}, {"type": "subtitle", "time": 7626.709, "timestamp": "02:07:06", "text": "这是社区的事情。所以"}, {"type": "subtitle", "time": 7629.03, "timestamp": "02:07:09", "text": "它不是来自游戏，而是来自……"}, {"type": "subtitle", "time": 7634.79, "timestamp": "02:07:14", "text": "游戏允许你这么做。那就是"}, {"type": "subtitle", "time": 7637.55, "timestamp": "02:07:17", "text": "War Thunder 允许的改装程度"}, {"type": "subtitle", "time": 7640.79, "timestamp": "02:07:20", "text": "你。除此之外的任何进一步修改"}, {"type": "subtitle", "time": 7644.39, "timestamp": "02:07:24", "text": "可以在您的私人定制课程中进行。"}, {"type": "subtitle", "time": 7646.47, "timestamp": "02:07:26", "text": "假设你和我正在玩……"}, {"type": "subtitle", "time": 7649.589, "timestamp": "02:07:29", "text": "游戏。我可以要这个坦克，或者像……"}, {"type": "subtitle", "time": 7652.229, "timestamp": "02:07:32", "text": "飞机上有一门大炮，大小为"}, {"type": "subtitle", "time": 7653.87, "timestamp": "02:07:33", "text": "你的"}, {"type": "subtitle", "time": 7656.069, "timestamp": "02:07:36", "text": "房子里不允许这样做。"}, {"type": "subtitle", "time": 7658.189, "timestamp": "02:07:38", "text": "实际游戏。"}, {"type": "subtitle", "time": 7661.99, "timestamp": "02:07:41", "text": "明白了。他们会不喜欢得到"}, {"type": "subtitle", "time": 7664.629, "timestamp": "02:07:44", "text": "请通知我您正在使用非法设备。它是"}, {"type": "subtitle", "time": 7667.03, "timestamp": "02:07:47", "text": "就像GTA一样。立即封禁。他们有"}, {"type": "subtitle", "time": 7671.91, "timestamp": "02:07:51", "text": "一个完整的独立的反车系统。"}, {"type": "subtitle", "time": 7679.91, "timestamp": "02:07:59", "text": "通常情况下，你甚至都玩不了这款游戏。"}]
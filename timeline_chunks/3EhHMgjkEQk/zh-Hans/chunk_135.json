[{"type": "subtitle", "time": 8102.229, "timestamp": "02:15:02", "text": "然后等待绿色的那个东西。出色地，"}, {"type": "subtitle", "time": 8104.229, "timestamp": "02:15:04", "text": "不要等待。指着它"}, {"type": "subtitle", "time": 8105.91, "timestamp": "02:15:05", "text": "正确。一直移动它，直到你"}, {"type": "subtitle", "time": 8108.43, "timestamp": "02:15:08", "text": "让十字准星移动"}, {"type": "subtitle", "time": 8111.189, "timestamp": "02:15:11", "text": "绿色的。一旦它变成绿色，那就"}, {"type": "subtitle", "time": 8113.669, "timestamp": "02:15:13", "text": "这意味着你的游戏正在告诉你你的"}, {"type": "subtitle", "time": 8118.03, "timestamp": "02:15:18", "text": "子弹会穿透坦克的装甲。"}, {"type": "subtitle", "time": 8126.55, "timestamp": "02:15:26", "text": "极好的。现在，我们来看看。你是做什么的"}, {"type": "subtitle", "time": 8136.47, "timestamp": "02:15:36", "text": "目标已摧毁。我杀了她。"}, {"type": "subtitle", "time": 8139.27, "timestamp": "02:15:39", "text": "我们走吧。你杀了人。"}, {"type": "subtitle", "time": 8141.31, "timestamp": "02:15:41", "text": "极好的。还"}, {"type": "subtitle", "time": 8144.47, "timestamp": "02:15:44", "text": "开玩笑。始终将油箱倾斜放置。没有"}, {"type": "subtitle", "time": 8147.91, "timestamp": "02:15:47", "text": "完全正面或侧面。哦"}, {"type": "subtitle", "time": 8149.27, "timestamp": "02:15:49", "text": "上帝。你这是在给自己制造一个麻烦"}]
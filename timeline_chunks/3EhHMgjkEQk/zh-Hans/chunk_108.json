[{"type": "subtitle", "time": 6480.39, "timestamp": "01:48:00", "text": "速度。好的。我就在你旁边。"}, {"type": "subtitle", "time": 6482.149, "timestamp": "01:48:02", "text": "你飞得太棒了。你在飞行"}, {"type": "subtitle", "time": 6484.51, "timestamp": "01:48:04", "text": "非常好。继续做你正在做的事"}, {"type": "subtitle", "time": 6487.99, "timestamp": "01:48:07", "text": "正在做。我带你进去。在哪儿？"}, {"type": "subtitle", "time": 6489.35, "timestamp": "01:48:09", "text": "空军基地？"}, {"type": "subtitle", "time": 6490.51, "timestamp": "01:48:10", "text": "就在前面"}, {"type": "subtitle", "time": 6493.83, "timestamp": "01:48:13", "text": "你，但它不匹配。你要走了"}, {"type": "subtitle", "time": 6495.99, "timestamp": "01:48:15", "text": "垂直。所以，当我们来到……"}, {"type": "subtitle", "time": 6498.149, "timestamp": "01:48:18", "text": "空军基地，你得去一个"}, {"type": "subtitle", "time": 6499.99, "timestamp": "01:48:19", "text": "边。"}, {"type": "subtitle", "time": 6502.39, "timestamp": "01:48:22", "text": "边线在哪里？走到旁边去。哦，"}, {"type": "subtitle", "time": 6505.91, "timestamp": "01:48:25", "text": "这个。是的，就在前面。"}, {"type": "subtitle", "time": 6522.709, "timestamp": "01:48:42", "text": "哦，等等。我无法提高速度。哦。"}, {"type": "subtitle", "time": 6524.47, "timestamp": "01:48:44", "text": "是的，你没有引擎。你"}, {"type": "subtitle", "time": 6527.75, "timestamp": "01:48:47", "text": "无法提高速度"}, {"type": "subtitle", "time": 6529.629, "timestamp": "01:48:49", "text": "因为速度推动。"}, {"type": "subtitle", "time": 6534.229, "timestamp": "01:48:54", "text": "不。哦，等等。我可能会迫降。"}, {"type": "subtitle", "time": 6537.189, "timestamp": "01:48:57", "text": "是的。紧急迫降。拉起"}, {"type": "subtitle", "time": 6539.75, "timestamp": "01:48:59", "text": "一点。稍微往上拉一点。好的。"}]
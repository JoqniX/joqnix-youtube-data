[{"type": "subtitle", "time": 6840.149, "timestamp": "01:54:00", "text": "你可以完成击杀。所以，如果我呃得到"}, {"type": "subtitle", "time": 6844.149, "timestamp": "01:54:04", "text": "我的所有飞机都坏了，我出局了。"}, {"type": "subtitle", "time": 6846.99, "timestamp": "01:54:06", "text": "那你这场比赛就到此为止了。"}, {"type": "subtitle", "time": 6851.51, "timestamp": "01:54:11", "text": "呃，你弄坏了多少架飞机？"}, {"type": "subtitle", "time": 6854.39, "timestamp": "01:54:14", "text": "嗯，到目前为止只有一个。哦，不错。你得到了"}, {"type": "subtitle", "time": 6861.43, "timestamp": "01:54:21", "text": "哇哦。我的意思是，这是一种方法。"}, {"type": "subtitle", "time": 6864.229, "timestamp": "01:54:24", "text": "关于它。你的飞机到了。"}, {"type": "subtitle", "time": 6866.79, "timestamp": "01:54:26", "text": "控制。惊人的。而且你没有"}, {"type": "subtitle", "time": 6869.189, "timestamp": "01:54:29", "text": "起落架。"}, {"type": "subtitle", "time": 6871.91, "timestamp": "01:54:31", "text": "哦，你走了。嗯，你确实有一个"}, {"type": "subtitle", "time": 6873.109, "timestamp": "01:54:33", "text": "起落架。不，不，不。你有一个"}, {"type": "subtitle", "time": 6875.99, "timestamp": "01:54:35", "text": "起落架。我真的得记住。"}, {"type": "subtitle", "time": 6877.75, "timestamp": "01:54:37", "text": "你有一个可伸缩的。是的，你"}, {"type": "subtitle", "time": 6880.07, "timestamp": "01:54:40", "text": "需要修理。你可以开那辆车。那是"}, {"type": "subtitle", "time": 6883.27, "timestamp": "01:54:43", "text": "损坏程度不算太严重。我曾战斗过"}, {"type": "subtitle", "time": 6885.589, "timestamp": "01:54:45", "text": "病情更严重的人。好的，你"}, {"type": "subtitle", "time": 6886.87, "timestamp": "01:54:46", "text": "土地。我会为你辩护一下。有"}, {"type": "subtitle", "time": 6891.51, "timestamp": "01:54:51", "text": "有人想找你麻烦。砰。"}, {"type": "subtitle", "time": 6895.43, "timestamp": "01:54:55", "text": "不要直线飞行。不要直线飞行。"}, {"type": "subtitle", "time": 6897.31, "timestamp": "01:54:57", "text": "你这是在给自己制造一个麻烦"}, {"type": "subtitle", "time": 6899.83, "timestamp": "01:54:59", "text": "目标。好的。抓到那个追捕他的人了"}]
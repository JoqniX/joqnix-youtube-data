[{"type": "subtitle", "time": 15180.91, "timestamp": "04:13:00", "text": "玩。"}, {"type": "subtitle", "time": 15184.87, "timestamp": "04:13:04", "text": "要么玩电子游戏，要么投入真金白银。如果"}, {"type": "subtitle", "time": 15186.229, "timestamp": "04:13:06", "text": "你投入的是真金白银，你不需要"}, {"type": "subtitle", "time": 15187.51, "timestamp": "04:13:07", "text": "中队或其他什么。你最好也"}, {"type": "subtitle", "time": 15190.229, "timestamp": "04:13:10", "text": "直接把飞机买下来就行了。如何"}, {"type": "subtitle", "time": 15192.389, "timestamp": "04:13:12", "text": "有多少？"}, {"type": "subtitle", "time": 15195.87, "timestamp": "04:13:15", "text": "嗯，通常在30美元到……之间。"}, {"type": "subtitle", "time": 15199.55, "timestamp": "04:13:19", "text": "80美元。"}, {"type": "subtitle", "time": 15205.03, "timestamp": "04:13:25", "text": "7900美元，对吧？是的。大致按平面计算。"}, {"type": "subtitle", "time": 15208.389, "timestamp": "04:13:28", "text": "那就像……哦，"}, {"type": "subtitle", "time": 15214.11, "timestamp": "04:13:34", "text": "上帝。"}, {"type": "subtitle", "time": 15221.429, "timestamp": "04:13:41", "text": "是的，你可以弄到一架高级飞机。"}, {"type": "subtitle", "time": 15223.83, "timestamp": "04:13:43", "text": "以及一架低级别的优质飞机。"}, {"type": "subtitle", "time": 15233.03, "timestamp": "04:13:53", "text": "聊天中提到，Jock是个假玩家。他是"}, {"type": "subtitle", "time": 15234.59, "timestamp": "04:13:54", "text": "立刻消失了"}, {"type": "subtitle", "time": 15237.99, "timestamp": "04:13:57", "text": "花钱才能赢。他立刻"}]
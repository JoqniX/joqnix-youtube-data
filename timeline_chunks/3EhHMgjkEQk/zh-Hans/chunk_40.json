[{"type": "subtitle", "time": 2414.15, "timestamp": "00:40:14", "text": "不，是你在游戏里的角色。你的"}, {"type": "subtitle", "time": 2416.47, "timestamp": "00:40:16", "text": "玩家ID。"}, {"type": "subtitle", "time": 2419.349, "timestamp": "00:40:19", "text": "什么？不是讨论本身。"}, {"type": "subtitle", "time": 2420.95, "timestamp": "00:40:20", "text": "我的意思是，是啊，当然。如果你能做到这一点，"}, {"type": "subtitle", "time": 2422.95, "timestamp": "00:40:22", "text": "那也很棒。我当时说的是分享"}, {"type": "subtitle", "time": 2427.27, "timestamp": "00:40:27", "text": "我需要ID才能进行设置"}, {"type": "subtitle", "time": 2430.31, "timestamp": "00:40:30", "text": "我们俩的专属名字。 ID。是的。"}, {"type": "subtitle", "time": 2433.109, "timestamp": "00:40:33", "text": "知道了。知道了。知道了。它，它是"}, {"type": "subtitle", "time": 2445.91, "timestamp": "00:40:45", "text": "质量越大，引力越小，笨蛋，而不是越大。"}, {"type": "subtitle", "time": 2449.19, "timestamp": "00:40:49", "text": "大约是0.7克。没关系。质量引力"}, {"type": "subtitle", "time": 2453.03, "timestamp": "00:40:53", "text": "小于。是 0.38 克。那么，什么是"}, {"type": "subtitle", "time": 2455.19, "timestamp": "00:40:55", "text": "地球引力？"}, {"type": "subtitle", "time": 2457.43, "timestamp": "00:40:57", "text": "一。你会采用地球重力单位"}]
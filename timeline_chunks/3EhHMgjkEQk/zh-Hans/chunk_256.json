[{"type": "subtitle", "time": 15360.95, "timestamp": "04:16:00", "text": "最后会有奖励。啊，"}, {"type": "subtitle", "time": 15363.51, "timestamp": "04:16:03", "text": "现在最简单的办法是填满那个条形码"}, {"type": "subtitle", "time": 15365.429, "timestamp": "04:16:05", "text": "是玩模拟战斗游戏。但是"}, {"type": "subtitle", "time": 15368.63, "timestamp": "04:16:08", "text": "模拟器战斗的问题在于你"}, {"type": "subtitle", "time": 15371.67, "timestamp": "04:16:11", "text": "我宁愿去读核能学博士。"}, {"type": "subtitle", "time": 15373.91, "timestamp": "04:16:13", "text": "比玩模拟战斗游戏更注重物理效果。"}, {"type": "subtitle", "time": 15376.309, "timestamp": "04:16:16", "text": "非常痛苦。"}, {"type": "subtitle", "time": 15378.309, "timestamp": "04:16:18", "text": "哦，"}, {"type": "subtitle", "time": 15380.95, "timestamp": "04:16:20", "text": "你可以做到，但这非常痛苦。"}, {"type": "subtitle", "time": 15383.07, "timestamp": "04:16:23", "text": "另外，如果你有"}, {"type": "subtitle", "time": 15385.67, "timestamp": "04:16:25", "text": "限制？是的。你看，你必须到达"}, {"type": "subtitle", "time": 15387.67, "timestamp": "04:16:27", "text": "达到一定水平。这是新东西，作者"}, {"type": "subtitle", "time": 15389.349, "timestamp": "04:16:29", "text": "道路。"}, {"type": "subtitle", "time": 15390.95, "timestamp": "04:16:30", "text": "我走了进去，从后面钻了进去。"}, {"type": "subtitle", "time": 15393.91, "timestamp": "04:16:33", "text": "天。你可以随便走进去。"}, {"type": "subtitle", "time": 15397.189, "timestamp": "04:16:37", "text": "现在你必须击落10架飞机才能获得"}, {"type": "subtitle", "time": 15399.99, "timestamp": "04:16:39", "text": "这里。解锁此游戏模式。杀死10"}, {"type": "subtitle", "time": 15401.99, "timestamp": "04:16:41", "text": "坦克是解锁该游戏模式的必要条件。全部"}, {"type": "subtitle", "time": 15403.99, "timestamp": "04:16:43", "text": "专业的。"}, {"type": "subtitle", "time": 15410.309, "timestamp": "04:16:50", "text": "是的，你提到过那是一个旧的"}, {"type": "subtitle", "time": 15413.83, "timestamp": "04:16:53", "text": "游戏。是的。但它大约每30次更新一次。"}, {"type": "subtitle", "time": 15416.55, "timestamp": "04:16:56", "text": "一年几次。"}]
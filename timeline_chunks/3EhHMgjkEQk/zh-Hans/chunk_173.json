[{"type": "subtitle", "time": 10380.79, "timestamp": "02:53:00", "text": "对准红点，然后击"}, {"type": "subtitle", "time": 10391.19, "timestamp": "02:53:11", "text": "哦，我打他了。"}, {"type": "subtitle", "time": 10393.11, "timestamp": "02:53:13", "text": "是的，你需要更准确地描述情况。"}, {"type": "subtitle", "time": 10395.15, "timestamp": "02:53:15", "text": "破坏"}, {"type": "subtitle", "time": 10399.71, "timestamp": "02:53:19", "text": "他们。那就是你的飞机"}, {"type": "subtitle", "time": 10403.429, "timestamp": "02:53:23", "text": "载体。现在，这是"}, {"type": "subtitle", "time": 10405.269, "timestamp": "02:53:25", "text": "远没有降落在……上那么容易"}, {"type": "subtitle", "time": 10407.11, "timestamp": "02:53:27", "text": "地面。"}, {"type": "subtitle", "time": 10410.07, "timestamp": "02:53:30", "text": "所以，要小心。保持距离。去"}, {"type": "subtitle", "time": 10412.87, "timestamp": "02:53:32", "text": "在航母后方很远的地方。"}, {"type": "subtitle", "time": 10428.95, "timestamp": "02:53:48", "text": "卷。另外，我也同意布鲁斯的观点。"}, {"type": "subtitle", "time": 10439.83, "timestamp": "02:53:59", "text": "哦，原来还有这回事。你看，就是这样。"}]
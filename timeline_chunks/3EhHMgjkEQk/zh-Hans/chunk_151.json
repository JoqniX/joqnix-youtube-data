[{"type": "subtitle", "time": 9060.63, "timestamp": "02:31:00", "text": "拉屎。更有趣多了。"}, {"type": "subtitle", "time": 9062.23, "timestamp": "02:31:02", "text": "街机更像是，你知道，对于新玩家来说。"}, {"type": "subtitle", "time": 9063.67, "timestamp": "02:31:03", "text": "让玩家参与进来。一般来说，"}, {"type": "subtitle", "time": 9066.63, "timestamp": "02:31:06", "text": "这是给孩子看的。"}, {"type": "subtitle", "time": 9067.83, "timestamp": "02:31:07", "text": "然后你想玩得像"}, {"type": "subtitle", "time": 9073.83, "timestamp": "02:31:13", "text": "实际的。然后当你理解了"}, {"type": "subtitle", "time": 9076.309, "timestamp": "02:31:16", "text": "现实主义是如何运作的，如果你仍然"}, {"type": "subtitle", "time": 9078.63, "timestamp": "02:31:18", "text": "如果你讨厌自己的生活，那就去做"}, {"type": "subtitle", "time": 9084.23, "timestamp": "02:31:24", "text": "如果你像表情包里那样，那我可不想这样。"}, {"type": "subtitle", "time": 9089.03, "timestamp": "02:31:29", "text": "我想要和平，我想要战争。那是什么？"}, {"type": "subtitle", "time": 9091.27, "timestamp": "02:31:31", "text": "怎么样？"}, {"type": "subtitle", "time": 9093.51, "timestamp": "02:31:33", "text": "如果你真的想受苦，那好吧，你"}, {"type": "subtitle", "time": 9096.55, "timestamp": "02:31:36", "text": "继续进入模拟模式，我"}, {"type": "subtitle", "time": 9098.79, "timestamp": "02:31:38", "text": "今天不收你了，因为……"}, {"type": "subtitle", "time": 9101.51, "timestamp": "02:31:41", "text": "对你来说将会非常糟糕。"}, {"type": "subtitle", "time": 9105.03, "timestamp": "02:31:45", "text": "好的。如果真是这样，那将令人震惊。"}, {"type": "subtitle", "time": 9107.19, "timestamp": "02:31:47", "text": "如果你能成功起飞，你会喜欢的"}, {"type": "subtitle", "time": 9109.429, "timestamp": "02:31:49", "text": "那。"}, {"type": "subtitle", "time": 9111.03, "timestamp": "02:31:51", "text": "我甚至都没来得及脱掉我的"}, {"type": "subtitle", "time": 9112.71, "timestamp": "02:31:52", "text": "前两次、三次在模拟器中"}, {"type": "subtitle", "time": 9114.63, "timestamp": "02:31:54", "text": "模式。"}, {"type": "subtitle", "time": 9118.63, "timestamp": "02:31:58", "text": "该死。哦，那里有一辆战斗巴士。"}]
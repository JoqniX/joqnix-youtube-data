[{"type": "subtitle", "time": 2580.069, "timestamp": "00:43:00", "text": "用那个吗？哦，基础教程。是的，"}, {"type": "subtitle", "time": 2581.91, "timestamp": "00:43:01", "text": "如果你想的话，可以学习一下教程。"}, {"type": "subtitle", "time": 2588.87, "timestamp": "00:43:08", "text": "欢迎来到基础知识的第一部分。"}, {"type": "subtitle", "time": 2590.15, "timestamp": "00:43:10", "text": "教程。你想参加教程吗？"}, {"type": "subtitle", "time": 2592.23, "timestamp": "00:43:12", "text": "现在还是想加入定制版？"}, {"type": "subtitle", "time": 2595.51, "timestamp": "00:43:15", "text": "这东西？做你自己。是的。是的。教我"}, {"type": "subtitle", "time": 2598.67, "timestamp": "00:43:18", "text": "那。你是专业人士。"}, {"type": "subtitle", "time": 2601.99, "timestamp": "00:43:21", "text": "好的。等待。我可以访问这些教程。"}, {"type": "subtitle", "time": 2604.63, "timestamp": "00:43:24", "text": "稍后吧？是的。是的，你可以访问"}, {"type": "subtitle", "time": 2607.75, "timestamp": "00:43:27", "text": "他们。是的。"}, {"type": "subtitle", "time": 2609.91, "timestamp": "00:43:29", "text": "这个游戏的目标是什么？你坐"}, {"type": "subtitle", "time": 2614.55, "timestamp": "00:43:34", "text": "彼此面对面坐着。所以基本上，你"}, {"type": "subtitle", "time": 2617.79, "timestamp": "00:43:37", "text": "战术性地摆放长椅。你学会了如何砰砰砰"}, {"type": "subtitle", "time": 2620.71, "timestamp": "00:43:40", "text": "正确操作后，你就可以不断升级。"}, {"type": "subtitle", "time": 2622.55, "timestamp": "00:43:42", "text": "所以，有三种方法。"}, {"type": "subtitle", "time": 2624.23, "timestamp": "00:43:44", "text": "着手去做。你可以选择乘坐飞机，"}, {"type": "subtitle", "time": 2625.91, "timestamp": "00:43:45", "text": "你可以选择坦克，或者你可以选择"}, {"type": "subtitle", "time": 2628.23, "timestamp": "00:43:48", "text": "船舶。严格来说，只有两个"}, {"type": "subtitle", "time": 2630.069, "timestamp": "00:43:50", "text": "实现目标的方法。没人会去"}, {"type": "subtitle", "time": 2631.829, "timestamp": "00:43:51", "text": "船舶。战争中没人玩船。"}, {"type": "subtitle", "time": 2635.75, "timestamp": "00:43:55", "text": "雷。这是一个令人悲伤的局面。我的天啊。"}, {"type": "subtitle", "time": 2637.349, "timestamp": "00:43:57", "text": "每 1000 名 War Thunder 玩家，"}, {"type": "subtitle", "time": 2638.95, "timestamp": "00:43:58", "text": "会有这样一个人……"}]
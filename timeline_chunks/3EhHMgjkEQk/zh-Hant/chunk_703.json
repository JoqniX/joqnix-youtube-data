[{"type": "subtitle", "time": 42180.39, "timestamp": "11:43:00", "text": "連結在"}, {"type": "subtitle", "time": 42184.83, "timestamp": "11:43:04", "text": "描述裡。去關注他，支持他。是的。是的。那麼也別忘了關注傑克·尼克斯。他真的很好，是一位非常棒的虛擬主播。嗯。  那麼，各位，我們就不多說了，下次直播再見。"}, {"type": "subtitle", "time": 42198.55, "timestamp": "11:43:18", "text": "我也會結束"}, {"type": "subtitle", "time": 42199.23, "timestamp": "11:43:19", "text": "直播。  是的。"}]
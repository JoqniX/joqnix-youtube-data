[{"type": "subtitle", "time": 25996.628, "timestamp": "07:13:16", "text": "嗯。  你買這些東西是為了治病嗎？當然。好的"}, {"type": "subtitle", "time": 26009.628, "timestamp": "07:13:29", "text": "，我拿一些綠色的"}, {"type": "subtitle", "time": 26029.83, "timestamp": "07:13:49", "text": "好的。讓我們把這些緊急任務都解決掉"}, {"type": "subtitle", "time": 26036.31, "timestamp": "07:13:56", "text": "。  是的"}, {"type": "subtitle", "time": 26038.15, "timestamp": "07:13:58", "text": "。  瞧瞧這些人，他們在這裡開派對呢。是的，他們在開派對"}]
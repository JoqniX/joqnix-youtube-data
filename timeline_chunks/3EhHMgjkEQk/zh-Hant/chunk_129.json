[{"type": "subtitle", "time": 7747.99, "timestamp": "02:09:07", "text": "應該跟其他遊戲皮膚一樣吧。你拿到文件，把它放到正確的位置，重新加載遊戲，就能獲得皮膚。"}, {"type": "subtitle", "time": 7749.629, "timestamp": "02:09:09", "text": "哦。  這是社區的事。"}, {"type": "subtitle", "time": 7752.39, "timestamp": "02:09:12", "text": "所以這"}, {"type": "subtitle", "time": 7766.95, "timestamp": "02:09:26", "text": "水準。除此之外的任何修改都可以在您的自訂私人會話中進行。"}, {"type": "subtitle", "time": 7770.629, "timestamp": "02:09:30", "text": "假設你我正在玩這個遊戲。我可以給坦克或像飛機一樣裝上和你家房子一樣大的砲，但這在實際遊戲中是不允許的"}]
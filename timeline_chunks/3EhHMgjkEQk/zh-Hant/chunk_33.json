[{"type": "subtitle", "time": 1980.31, "timestamp": "00:33:00", "text": "等等，那是什麼來著？ PS，是"}, {"type": "subtitle", "time": 1983.83, "timestamp": "00:33:03", "text": "PlayStation嗎？不是PlayStation。是"}, {"type": "subtitle", "time": 1985.669, "timestamp": "00:33:05", "text": "Joy-Con之類的嗎？不知道。我"}, {"type": "subtitle", "time": 1987.669, "timestamp": "00:33:07", "text": "不記得了。 Joy-Con。哦，好的。就像"}, {"type": "subtitle", "time": 1989.75, "timestamp": "00:33:09", "text": "個小磁帶之類的東西，"}, {"type": "subtitle", "time": 1993.99, "timestamp": "00:33:13", "text": "插進去就行。不，我以前很喜歡那個。我以前有。哦，"}, {"type": "subtitle", "time": 2000.31, "timestamp": "00:33:20", "text": "啊。還有，飛機怎麼開來著"}, {"type": "subtitle", "time": 2002.75, "timestamp": "00:33:22", "text": "？"}, {"type": "subtitle", "time": 2011.19, "timestamp": "00:33:31", "text": "我已經找到了。等等，"}, {"type": "subtitle", "time": 2015.11, "timestamp": "00:33:35", "text": "我該怎麼引導你？呃，好的。等等，"}, {"type": "subtitle", "time": 2016.549, "timestamp": "00:33:36", "text": "離開機庫。我沒辦法"}, {"type": "subtitle", "time": 2018.31, "timestamp": "00:33:38", "text": "引導你，因為我看不見你"}, {"type": "subtitle", "time": 2021.19, "timestamp": "00:33:41", "text": "。好的。我上次檢查的時候，你"}, {"type": "subtitle", "time": 2023.83, "timestamp": "00:33:43", "text": "應該要有個WD（方向盤）。"}, {"type": "subtitle", "time": 2026.87, "timestamp": "00:33:46", "text": "WD沒用。"}, {"type": "subtitle", "time": 2030.549, "timestamp": "00:33:50", "text": "那它就是預設值。你去，呃，按Esc鍵。"}, {"type": "subtitle", "time": 2033.87, "timestamp": "00:33:53", "text": "對。"}]
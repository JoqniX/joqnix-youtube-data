[{"type": "subtitle", "time": 2580.069, "timestamp": "00:43:00", "text": "用那個嗎？哦，基礎教程。是的，"}, {"type": "subtitle", "time": 2581.91, "timestamp": "00:43:01", "text": "如果你想的話可以做教學。"}, {"type": "subtitle", "time": 2588.87, "timestamp": "00:43:08", "text": "歡迎來到基礎教程的第一部分"}, {"type": "subtitle", "time": 2590.15, "timestamp": "00:43:10", "text": "。你想現在做教學"}, {"type": "subtitle", "time": 2592.23, "timestamp": "00:43:12", "text": "還是想進入自訂模式"}, {"type": "subtitle", "time": 2595.51, "timestamp": "00:43:15", "text": "？做你自己。是的。是的。教我吧"}, {"type": "subtitle", "time": 2598.67, "timestamp": "00:43:18", "text": "。你是高手。"}, {"type": "subtitle", "time": 2601.99, "timestamp": "00:43:21", "text": "好的。等等。我可以稍後再訪問這些教程"}, {"type": "subtitle", "time": 2604.63, "timestamp": "00:43:24", "text": "，對吧？是的。是的，你可以訪問"}, {"type": "subtitle", "time": 2607.75, "timestamp": "00:43:27", "text": "它們。是的。"}, {"type": "subtitle", "time": 2609.91, "timestamp": "00:43:29", "text": "這個遊戲的目標是什麼？"}, {"type": "subtitle", "time": 2614.55, "timestamp": "00:43:34", "text": "互相射擊。所以基本上，你要進行"}, {"type": "subtitle", "time": 2617.79, "timestamp": "00:43:37", "text": "戰術射擊。你學習如何"}, {"type": "subtitle", "time": 2620.71, "timestamp": "00:43:40", "text": "正確地射擊，然後不斷升級。"}, {"type": "subtitle", "time": 2622.55, "timestamp": "00:43:42", "text": "所以有三種方式"}, {"type": "subtitle", "time": 2624.23, "timestamp": "00:43:44", "text": "。你可以選擇飛機，"}, {"type": "subtitle", "time": 2625.91, "timestamp": "00:43:45", "text": "你可以選擇坦克，或者你可以選擇"}, {"type": "subtitle", "time": 2628.23, "timestamp": "00:43:48", "text": "船隻。嚴格來說，只有兩種"}, {"type": "subtitle", "time": 2630.069, "timestamp": "00:43:50", "text": "方式。沒人選擇"}, {"type": "subtitle", "time": 2631.829, "timestamp": "00:43:51", "text": "艦艇。沒人會在《戰爭雷霆》裡玩船艦"}, {"type": "subtitle", "time": 2635.75, "timestamp": "00:43:55", "text": "。真是令人遺憾。我的天哪。"}, {"type": "subtitle", "time": 2637.349, "timestamp": "00:43:57", "text": "每1000個《戰爭雷霆》玩家裡，總會"}, {"type": "subtitle", "time": 2638.95, "timestamp": "00:43:58", "text": "有一個人說："}]
[{"type": "subtitle", "time": 1501.75, "timestamp": "00:25:01", "text": "現在感覺很自在，因為我們彼此認識，"}, {"type": "subtitle", "time": 1504.31, "timestamp": "00:25:04", "text": "之前也合作過，所以"}, {"type": "subtitle", "time": 1508.789, "timestamp": "00:25:08", "text": "和新人合作很容易。但"}, {"type": "subtitle", "time": 1513.35, "timestamp": "00:25:13", "text": "現在很多事情都太繁文縟節了，很痛苦。我有點難以適應這些"}, {"type": "subtitle", "time": 1515.35, "timestamp": "00:25:15", "text": "繁文縟節。我以前會想"}, {"type": "subtitle", "time": 1517.83, "timestamp": "00:25:17", "text": "邀請"}, {"type": "subtitle", "time": 1521.35, "timestamp": "00:25:21", "text": "別人過來，但後來就想，我只想直接"}, {"type": "subtitle", "time": 1522.789, "timestamp": "00:25:22", "text": "問她“你想來嗎？”，"}, {"type": "subtitle", "time": 1524.549, "timestamp": "00:25:24", "text": "然後其他人就可以來了，就這麼簡單"}, {"type": "subtitle", "time": 1527.11, "timestamp": "00:25:27", "text": "。我不想搞得像「"}, {"type": "subtitle", "time": 1529.669, "timestamp": "00:25:29", "text": "你該怎麼做」之類的，很多事情都這樣。"}, {"type": "subtitle", "time": 1534.549, "timestamp": "00:25:34", "text": "最近我意識到，對"}, {"type": "subtitle", "time": 1537.99, "timestamp": "00:25:37", "text": "有些人來說，如果你在"}, {"type": "subtitle", "time": 1540.47, "timestamp": "00:25:40", "text": "人數或"}, {"type": "subtitle", "time": 1542.23, "timestamp": "00:25:42", "text": "其他方面不夠，他們會覺得有點難受。"}, {"type": "subtitle", "time": 1544.95, "timestamp": "00:25:44", "text": "哦，你是說"}, {"type": "subtitle", "time": 1547.35, "timestamp": "00:25:47", "text": "那種「你跟我程度差不多嗎？」之類的問題嗎？更像"}, {"type": "subtitle", "time": 1549.83, "timestamp": "00:25:49", "text": "是跨性別者會把合作"}, {"type": "subtitle", "time": 1551.99, "timestamp": "00:25:51", "text": "當作是交易，更像是生意。"}, {"type": "subtitle", "time": 1554.87, "timestamp": "00:25:54", "text": "對，就像"}, {"type": "subtitle", "time": 1557.269, "timestamp": "00:25:57", "text": "受眾規模差不多之類的。"}, {"type": "subtitle", "time": 1559.19, "timestamp": "00:25:59", "text": "對，對，對。我不知道。我"}]
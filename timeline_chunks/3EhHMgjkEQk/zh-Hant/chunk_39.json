[{"type": "subtitle", "time": 2342.95, "timestamp": "00:39:02", "text": "3、2、1。什麼都沒發生。是鏡頭在"}, {"type": "subtitle", "time": 2345.91, "timestamp": "00:39:05", "text": "動。繼續。我應該這樣"}, {"type": "subtitle", "time": 2349.27, "timestamp": "00:39:09", "text": "移動嗎？是的。是的，"}, {"type": "subtitle", "time": 2354.71, "timestamp": "00:39:14", "text": "我這麼做了。嗯，"}, {"type": "subtitle", "time": 2358.63, "timestamp": "00:39:18", "text": "這很有意思。好的。呃，等等。"}, {"type": "subtitle", "time": 2360.71, "timestamp": "00:39:20", "text": "你的戰鬥等級是多少？"}, {"type": "subtitle", "time": 2364.87, "timestamp": "00:39:24", "text": "最高等級的飛機單位是多少？"}, {"type": "subtitle", "time": 2367.19, "timestamp": "00:39:27", "text": "我怎麼查看？你現在只能在…嗎？"}, {"type": "subtitle", "time": 2368.71, "timestamp": "00:39:28", "text": "因為你必須…你必須"}, {"type": "subtitle", "time": 2370.55, "timestamp": "00:39:30", "text": "回到大廳才能查看。我得"}, {"type": "subtitle", "time": 2384.069, "timestamp": "00:39:44", "text": "好的。分享一下你的……這個東西。"}, {"type": "subtitle", "time": 2390.15, "timestamp": "00:39:50", "text": "你管它叫什麼？好的。嗯，等一下。分享一下你的東西。"}, {"type": "subtitle", "time": 2392.15, "timestamp": "00:39:52", "text": "我得加你為"}, {"type": "subtitle", "time": 2393.8, "timestamp": "00:39:53", "text": "好友。"}]
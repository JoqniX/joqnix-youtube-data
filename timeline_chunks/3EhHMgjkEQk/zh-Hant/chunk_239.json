[{"type": "subtitle", "time": 14358.07, "timestamp": "03:59:18", "text": "你現在需要吃飯了，對吧"}, {"type": "subtitle", "time": 14359.83, "timestamp": "03:59:19", "text": "？之後"}, {"type": "subtitle", "time": 14370.429, "timestamp": "03:59:30", "text": "你愛上水的原因。  哇。  哦，"}, {"type": "subtitle", "time": 14379.189, "timestamp": "03:59:39", "text": "好吧，我會讓你輕鬆很多。  你不需要飛離出生點很"}, {"type": "subtitle", "time": 14381.63, "timestamp": "03:59:41", "text": "遠"}, {"type": "subtitle", "time": 14387.99, "timestamp": "03:59:47", "text": "你們是另一個國家嗎？  [音樂] 你什麼意思？不同國家的"}]
[{"type": "subtitle", "time": 38136.906, "timestamp": "10:35:36", "text": "我已經得到了所有點數立方體。我想我只需要把那些怪物殺掉就行了。"}, {"type": "subtitle", "time": 38146.63, "timestamp": "10:35:46", "text": "等等，我猜，這些人復活了。"}, {"type": "subtitle", "time": 38150.47, "timestamp": "10:35:50", "text": "哦，沒事了。還剩一點路要走。  [音樂]"}, {"type": "subtitle", "time": 38153.35, "timestamp": "10:35:53", "text": "哦。"}, {"type": "subtitle", "time": 38156.03, "timestamp": "10:35:56", "text": "哦，我們需要殺很多人"}]
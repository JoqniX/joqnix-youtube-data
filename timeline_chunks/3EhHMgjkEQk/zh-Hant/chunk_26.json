[{"type": "subtitle", "time": 1561.669, "timestamp": "00:26:01", "text": "理解背後的原因，因為你"}, {"type": "subtitle", "time": 1565.19, "timestamp": "00:26:05", "text": "不想讓它太……不平衡，因為你"}, {"type": "subtitle", "time": 1567.35, "timestamp": "00:26:07", "text": "知道這樣做可能會有點"}, {"type": "subtitle", "time": 1570.549, "timestamp": "00:26:10", "text": "尷尬。但是，是的，我不喜歡那些刻意追求平衡的"}, {"type": "subtitle", "time": 1573.19, "timestamp": "00:26:13", "text": "人。"}, {"type": "subtitle", "time": 1575.19, "timestamp": "00:26:15", "text": "他們甚至每次都會注意到"}, {"type": "subtitle", "time": 1578.149, "timestamp": "00:26:18", "text": "這一點。哦，是的。還有"}, {"type": "subtitle", "time": 1580.789, "timestamp": "00:26:20", "text": "聊天互動，對吧？比如說，"}, {"type": "subtitle", "time": 1583.51, "timestamp": "00:26:23", "text": "合作已經安排好了，合作也"}, {"type": "subtitle", "time": 1585.75, "timestamp": "00:26:25", "text": "正在進行中。如果"}, {"type": "subtitle", "time": 1591.669, "timestamp": "00:26:31", "text": "合作方的聊天互動比較少，"}, {"type": "subtitle", "time": 1594.31, "timestamp": "00:26:34", "text": "那麼最終你會"}, {"type": "subtitle", "time": 1596.39, "timestamp": "00:26:36", "text": "認為這是一次糟糕的合作"}, {"type": "subtitle", "time": 1600.87, "timestamp": "00:26:40", "text": "。我當時就想，什麼？"}, {"type": "subtitle", "time": 1604.549, "timestamp": "00:26:44", "text": "聊天互動也很重要。"}, {"type": "subtitle", "time": 1608.07, "timestamp": "00:26:48", "text": "我的意思是，是的，"}, {"type": "subtitle", "time": 1609.75, "timestamp": "00:26:49", "text": "如果你是商業"}, {"type": "subtitle", "time": 1611.75, "timestamp": "00:26:51", "text": "合作，我能理解。但如果你只是和合作對像一起玩，"}, {"type": "subtitle", "time": 1614.31, "timestamp": "00:26:54", "text": "就像你們成了朋友一樣"}, {"type": "subtitle", "time": 1615.909, "timestamp": "00:26:55", "text": "。"}, {"type": "subtitle", "time": 1618.31, "timestamp": "00:26:58", "text": "如果你和朋友合作，那"}, {"type": "subtitle", "time": 1619.909, "timestamp": "00:26:59", "text": "我就"}]
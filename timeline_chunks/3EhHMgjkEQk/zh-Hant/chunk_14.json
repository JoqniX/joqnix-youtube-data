[{"type": "subtitle", "time": 863.23, "timestamp": "00:14:23", "text": "重啟客戶端。"}, {"type": "subtitle", "time": 868.03, "timestamp": "00:14:28", "text": "我的天啊。  我搬家了。是的，我什至拒絕了。快點。  慢慢地。好的，現在是文字 11，然後是緩慢的圖形品質。點擊它。"}, {"type": "subtitle", "time": 871.55, "timestamp": "00:14:31", "text": "等待。是的。一寸一寸地來。該死，兄弟。"}, {"type": "subtitle", "time": 883.389, "timestamp": "00:14:43", "text": "我得以重新開始"}, {"type": "subtitle", "time": 891.55, "timestamp": "00:14:51", "text": "。點選“緩慢重啟”。快點。快點。快點。快點。我的天啊。是老鼠，兄弟。"}]
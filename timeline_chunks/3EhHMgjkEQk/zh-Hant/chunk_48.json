[{"type": "subtitle", "time": 2882.109, "timestamp": "00:48:02", "text": "它不工作了。開始。"}, {"type": "subtitle", "time": 2886.25, "timestamp": "00:48:06", "text": "應用。好了。我看到你了。"}, {"type": "subtitle", "time": 2888.95, "timestamp": "00:48:08", "text": "[音樂]"}, {"type": "subtitle", "time": 2890.75, "timestamp": "00:48:10", "text": "你知道什麼？等等。"}, {"type": "subtitle", "time": 2898.39, "timestamp": "00:48:18", "text": "它不準備？你準備好了。所以"}, {"type": "subtitle", "time": 2901.67, "timestamp": "00:48:21", "text": "問題是什麼？我點擊準備。哦，是的。是的。"}, {"type": "subtitle", "time": 2903.79, "timestamp": "00:48:23", "text": "點擊準備。是的。好了。"}, {"type": "subtitle", "time": 2914.87, "timestamp": "00:48:34", "text": "我選了一張長"}, {"type": "subtitle", "time": 2916.87, "timestamp": "00:48:36", "text": "街道的地圖。所以如果你想降落，你可以"}, {"type": "subtitle", "time": 2919.51, "timestamp": "00:48:39", "text": "降落。"}, {"type": "subtitle", "time": 2922.43, "timestamp": "00:48:42", "text": "現在唯一的問題是，"}, {"type": "subtitle", "time": 2925.069, "timestamp": "00:48:45", "text": "在我們倆都在"}, {"type": "subtitle", "time": 2936.37, "timestamp": "00:48:56", "text": "正常工作。呃"}]
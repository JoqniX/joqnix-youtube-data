[{"type": "subtitle", "time": 2460.27, "timestamp": "00:41:00", "text": "1。啊，就是"}, {"type": "subtitle", "time": 2464.39, "timestamp": "00:41:04", "text": "1，接受吧。好了。"}, {"type": "subtitle", "time": 2467.75, "timestamp": "00:41:07", "text": "我們已經接受了。"}, {"type": "subtitle", "time": 2476.55, "timestamp": "00:41:16", "text": "你想知道如何駕駛"}, {"type": "subtitle", "time": 2479.91, "timestamp": "00:41:19", "text": "這個基本的東西嗎？好的。是的。"}, {"type": "subtitle", "time": 2482.75, "timestamp": "00:41:22", "text": "我需要去找基礎級"}, {"type": "subtitle", "time": 2485.27, "timestamp": "00:41:25", "text": "飛機。我的所有國家都"}, {"type": "subtitle", "time": 2489.51, "timestamp": "00:41:29", "text": "至少有了一點。"}, {"type": "subtitle", "time": 2491.19, "timestamp": "00:41:31", "text": "但問題是，我不懂這類"}, {"type": "subtitle", "time": 2493.43, "timestamp": "00:41:33", "text": "遊戲。不，這款遊戲和《"}, {"type": "subtitle", "time": 2496.39, "timestamp": "00:41:36", "text": "入伍》一樣，你必須把所有其他國家的等級都提升上去"}, {"type": "subtitle", "time": 2501.51, "timestamp": "00:41:41", "text": "。這遊戲太肝了。這要看情況"}, {"type": "subtitle", "time": 2504.15, "timestamp": "00:41:44", "text": "。你可以選擇一個"}, {"type": "subtitle", "time": 2506.069, "timestamp": "00:41:46", "text": "你喜歡的國家，然後就專注於"}, {"type": "subtitle", "time": 2512.87, "timestamp": "00:41:52", "text": "我選了這個。"}, {"type": "subtitle", "time": 2515.03, "timestamp": "00:41:55", "text": "哦，抱歉。是的。是的。繼續。繼續。"}, {"type": "subtitle", "time": 2517.99, "timestamp": "00:41:57", "text": "不。所以你不必非得把"}]
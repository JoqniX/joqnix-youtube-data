[{"type": "subtitle", "time": 20358.39, "timestamp": "05:39:18", "text": "我希望這傢伙別"}, {"type": "subtitle", "time": 20370.67, "timestamp": "05:39:30", "text": "耽誤我十分鐘時間。我其實不想在這裡坐10分鐘。狗。這是好事。  事實上，墓地效果相當不錯。他將對這一切表示敬意。特惠卡。"}, {"type": "subtitle", "time": 20386.948, "timestamp": "05:39:46", "text": "哦，球。哦，是"}]
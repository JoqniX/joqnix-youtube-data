[{"type": "subtitle", "time": 4509.59, "timestamp": "01:15:09", "text": "你這樣做。  但在空戰比賽中，為了保持真實感，你可以誤傷隊友"}, {"type": "subtitle", "time": 4511.91, "timestamp": "01:15:11", "text": "，但會受到嚴厲的懲罰。"}, {"type": "subtitle", "time": 4514.75, "timestamp": "01:15:14", "text": "哦，"}, {"type": "subtitle", "time": 4517.35, "timestamp": "01:15:17", "text": "最後你得替那個人支付"}, {"type": "subtitle", "time": 4549.55, "timestamp": "01:15:49", "text": "戰鬥結束後回到"}, {"type": "subtitle", "time": 4553.189, "timestamp": "01:15:53", "text": "遊戲大廳也會遇到這種情況。  如果你的飛機在戰鬥中受損，它可以抵扣你汽車的維修費用。  哦，等等"}]
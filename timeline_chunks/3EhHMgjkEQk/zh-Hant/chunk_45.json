[{"type": "subtitle", "time": 2703.27, "timestamp": "00:45:03", "text": "場戰鬥。零勝。零系列賽。零目標"}, {"type": "subtitle", "time": 2705.67, "timestamp": "00:45:05", "text": "摧毀。零目標"}, {"type": "subtitle", "time": 2709.51, "timestamp": "00:45:09", "text": "摧毀。 AI。零總分。"}, {"type": "subtitle", "time": 2712.55, "timestamp": "00:45:12", "text": "3級。可能"}, {"type": "subtitle", "time": 2715.51, "timestamp": "00:45:15", "text": "。等等。你100級了。"}, {"type": "subtitle", "time": 2718.55, "timestamp": "00:45:18", "text": "搞什麼鬼？嘿，我滿級了。是的，"}, {"type": "subtitle", "time": 2719.79, "timestamp": "00:45:19", "text": "你是"}, {"type": "subtitle", "time": 2732.069, "timestamp": "00:45:32", "text": "我玩了五年多了。我有"}, {"type": "subtitle", "time": 2735.19, "timestamp": "00:45:35", "text": "帶導彈的噴射機。所以，我剛才說到"}, {"type": "subtitle", "time": 2737.03, "timestamp": "00:45:37", "text": "這裡了。"}, {"type": "subtitle", "time": 2739.19, "timestamp": "00:45:39", "text": "沒錯，"}, {"type": "subtitle", "time": 2740.71, "timestamp": "00:45:40", "text": "我當時想的是，"}, {"type": "subtitle", "time": 2742.47, "timestamp": "00:45:42", "text": "在自訂戰鬥裡，我應該直接開"}, {"type": "subtitle", "time": 2745.109, "timestamp": "00:45:45", "text": "一架噴射機進去嗎？"}, {"type": "subtitle", "time": 2747.829, "timestamp": "00:45:47", "text": "對，就這麼辦。管他呢？我想"}, {"type": "subtitle", "time": 2751.349, "timestamp": "00:45:51", "text": "在遊戲裡看到真正的噴射機。好吧，"}, {"type": "subtitle", "time": 2754.15, "timestamp": "00:45:54", "text": "我們先玩一局，我"}, {"type": "subtitle", "time": 2758.47, "timestamp": "00:45:58", "text": "幫你教教怎麼開飛機。"}]
[{"type": "subtitle", "time": 1924.789, "timestamp": "00:32:04", "text": "它很有趣，但我就是玩不"}, {"type": "subtitle", "time": 1936.789, "timestamp": "00:32:16", "text": "？我從來沒"}, {"type": "subtitle", "time": 1941.909, "timestamp": "00:32:21", "text": "買過主機。不，當我……嗯，我們來說說PC的優勢吧。是的。比如說，當我……嗯，"}, {"type": "subtitle", "time": 1954.75, "timestamp": "00:32:34", "text": "該怎麼說呢……嗯，就是"}, {"type": "subtitle", "time": 1958.149, "timestamp": "00:32:38", "text": "那種……像遊戲手把一樣的東西，"}, {"type": "subtitle", "time": 1960.71, "timestamp": "00:32:40", "text": "你把它連接到電腦上，然後"}, {"type": "subtitle", "time": 1963.509, "timestamp": "00:32:43", "text": "放一張CD光碟之類的，那種"}, {"type": "subtitle", "time": 1966.389, "timestamp": "00:32:46", "text": "老式主機之類的，對吧？哦，好的。我以前有那種可以玩《鴨子手》之類的遊戲的，對吧？嗯，是的，我"}, {"type": "subtitle", "time": 1969.509, "timestamp": "00:32:49", "text": "有那種東西。"}, {"type": "subtitle", "time": 1978.149, "timestamp": "00:32:58", "text": "但是，"}]
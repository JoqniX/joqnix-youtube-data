[{"type": "subtitle", "time": 2103.03, "timestamp": "00:35:03", "text": "是的，我記得我們玩過，呃，我們玩過，呃，"}, {"type": "subtitle", "time": 2111.829, "timestamp": "00:35:11", "text": "嗯，我的移動軸設定是油門"}, {"type": "subtitle", "time": 2113.589, "timestamp": "00:35:13", "text": "軸。你看，滾輪在那裡，"}, {"type": "subtitle", "time": 2116.39, "timestamp": "00:35:16", "text": "除了滾輪之外，還有W和S，或者"}, {"type": "subtitle", "time": 2119.19, "timestamp": "00:35:19", "text": "差不多是這樣，"}, {"type": "subtitle", "time": 2121.99, "timestamp": "00:35:21", "text": "然後我想翻滾軸是A和"}, {"type": "subtitle", "time": 2124.23, "timestamp": "00:35:24", "text": "D。"}, {"type": "subtitle", "time": 2127.51, "timestamp": "00:35:27", "text": "啊，所以如果你想保持"}, {"type": "subtitle", "time": 2130.39, "timestamp": "00:35:30", "text": "預設設置，你可以這樣做，或者你可以"}, {"type": "subtitle", "time": 2133.87, "timestamp": "00:35:33", "text": "添加這個，看起來"}, {"type": "subtitle", "time": 2136.47, "timestamp": "00:35:36", "text": "也不錯。大多數情況下，你可以直接"}, {"type": "subtitle", "time": 2138.47, "timestamp": "00:35:38", "text": "用滑鼠操作。不要"}, {"type": "subtitle", "time": 2140.15, "timestamp": "00:35:40", "text": "向下指。不要向下指。不要向上指。"}, {"type": "subtitle", "time": 2141.91, "timestamp": "00:35:41", "text": "好的。好了。哦"}, {"type": "subtitle", "time": 2144.91, "timestamp": "00:35:44", "text": "，好了。你起飛了。哦，好的。現在"}, {"type": "subtitle", "time": 2147.19, "timestamp": "00:35:47", "text": "按…好的，你不需要按"}, {"type": "subtitle", "time": 2149.99, "timestamp": "00:35:49", "text": "任何東西。襟翼已經升起。"}, {"type": "subtitle", "time": 2156.75, "timestamp": "00:35:56", "text": "什麼過載？"}]
[{"type": "subtitle", "time": 2281.51, "timestamp": "00:38:01", "text": "2G重力，你的體重就會變成200公斤。這只是個"}, {"type": "subtitle", "time": 2286.069, "timestamp": "00:38:06", "text": "例子。哦，當你做"}, {"type": "subtitle", "time": 2293.349, "timestamp": "00:38:13", "text": "現在，我說的並不是精確的"}, {"type": "subtitle", "time": 2296.23, "timestamp": "00:38:16", "text": "數學或科學。我只是舉例說明。我舉"}, {"type": "subtitle", "time": 2298.15, "timestamp": "00:38:18", "text": "個例子幫你理解。"}, {"type": "subtitle", "time": 2301.349, "timestamp": "00:38:21", "text": "如果我超載會怎麼樣？我會死嗎？"}, {"type": "subtitle", "time": 2303.27, "timestamp": "00:38:23", "text": "超載的話你會"}, {"type": "subtitle", "time": 2305.15, "timestamp": "00:38:25", "text": "暈倒，螢幕會黑一"}, {"type": "subtitle", "time": 2308.87, "timestamp": "00:38:28", "text": "秒鐘。差不多不會。試試看。試試看。"}, {"type": "subtitle", "time": 2311.349, "timestamp": "00:38:31", "text": "所以我就動一下。我的意思是，你"}, {"type": "subtitle", "time": 2313.99, "timestamp": "00:38:33", "text": "只是在測試這個東西，所以"}, {"type": "subtitle", "time": 2316.31, "timestamp": "00:38:36", "text": "沒關係。而且，你駕駛的是一架機動性很強的"}, {"type": "subtitle", "time": 2318.23, "timestamp": "00:38:38", "text": "飛機。我覺得"}, {"type": "subtitle", "time": 2321.109, "timestamp": "00:38:41", "text": "你沒辦法訓練。試試看。怎麼做？"}, {"type": "subtitle", "time": 2322.99, "timestamp": "00:38:42", "text": "我就是使勁兒動。使勁兒動"}, {"type": "subtitle", "time": 2326.349, "timestamp": "00:38:46", "text": "。"}, {"type": "subtitle", "time": 2328.87, "timestamp": "00:38:48", "text": "把滑鼠拉得很"}, {"type": "subtitle", "time": 2330.71, "timestamp": "00:38:50", "text": "緊。"}, {"type": "subtitle", "time": 2334.03, "timestamp": "00:38:54", "text": "鏡頭，兄弟。我的天。好的。"}, {"type": "subtitle", "time": 2339.069, "timestamp": "00:38:59", "text": "呃，"}]
[{"type": "subtitle", "time": 26582.468, "timestamp": "07:23:02", "text": "哦，泰坦也來追殺你了。  是的。他對我咧嘴一笑。我的天哪。"}, {"type": "subtitle", "time": 26597.99, "timestamp": "07:23:17", "text": "哦，它在追逐嗎？  等等，它在追趕。"}, {"type": "subtitle", "time": 26606.27, "timestamp": "07:23:26", "text": "我的天哪"}, {"type": "subtitle", "time": 26609.91, "timestamp": "07:23:29", "text": "。跑，轉，兒子。跑步。哦，它在追逐。我的天哪。我的天哪。我"}]
[{"type": "subtitle", "time": 2760.15, "timestamp": "00:46:00", "text": "之後我們再玩一"}, {"type": "subtitle", "time": 2763.51, "timestamp": "00:46:03", "text": "局。哦，你看到的是我的史詩級"}, {"type": "subtitle", "time": 2774.23, "timestamp": "00:46:14", "text": "是啊，我買了很多來看。我想，"}, {"type": "subtitle", "time": 2776.15, "timestamp": "00:46:16", "text": "呃，已經過一段時間了。所以"}, {"type": "subtitle", "time": 2780.47, "timestamp": "00:46:20", "text": "我想我的數據都被重置了。"}, {"type": "subtitle", "time": 2782.23, "timestamp": "00:46:22", "text": "除非你用"}, {"type": "subtitle", "time": 2783.99, "timestamp": "00:46:23", "text": "新帳號登錄，否則不應該這樣。如果是"}, {"type": "subtitle", "time": 2786.55, "timestamp": "00:46:26", "text": "同一個帳號，資料應該一直都在。"}, {"type": "subtitle", "time": 2788.15, "timestamp": "00:46:28", "text": "但現在不在那裡了。我"}, {"type": "subtitle", "time": 2789.67, "timestamp": "00:46:29", "text": "以前玩過。我和《"}, {"type": "subtitle", "time": 2791.349, "timestamp": "00:46:31", "text": "戰爭雷霆》的關係很複雜，"}, {"type": "subtitle", "time": 2793.109, "timestamp": "00:46:33", "text": "我們分手過很多次，我也"}, {"type": "subtitle", "time": 2797.19, "timestamp": "00:46:37", "text": "卸載過它。我的天哪。過了很久之後……"}, {"type": "subtitle", "time": 2798.87, "timestamp": "00:46:38", "text": "我又重新安裝了一遍"}, {"type": "subtitle", "time": 2800.71, "timestamp": "00:46:40", "text": "。只要帳號沒變，"}, {"type": "subtitle", "time": 2803.109, "timestamp": "00:46:43", "text": "你的所有歷史記錄都會保留。"}, {"type": "subtitle", "time": 2805.75, "timestamp": "00:46:45", "text": "嗯，所以通常來說沒問題。"}, {"type": "subtitle", "time": 2808.95, "timestamp": "00:46:48", "text": "總之，準備就緒。好的。"}, {"type": "subtitle", "time": 2810.79, "timestamp": "00:46:50", "text": "我該怎麼做？我該開哪架飛機？我這就"}, {"type": "subtitle", "time": 2813.39, "timestamp": "00:46:53", "text": "準備。隨便。你"}, {"type": "subtitle", "time": 2815.91, "timestamp": "00:46:55", "text": "想開什麼都行。你的選擇有限，"}, {"type": "subtitle", "time": 2819.19, "timestamp": "00:46:59", "text": "所以我不會限制你。"}]
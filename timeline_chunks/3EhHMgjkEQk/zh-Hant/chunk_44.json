[{"type": "subtitle", "time": 2643.03, "timestamp": "00:44:03", "text": "「哦，我喜歡玩艦船。」"}, {"type": "subtitle", "time": 2645.309, "timestamp": "00:44:05", "text": "就是這樣。他們"}, {"type": "subtitle", "time": 2647.99, "timestamp": "00:44:07", "text": "仍然……是的，他們仍然在努力玩"}, {"type": "subtitle", "time": 2651.55, "timestamp": "00:44:11", "text": "船隻。不錯。但還"}, {"type": "subtitle", "time": 2656.23, "timestamp": "00:44:16", "text": "不夠。哦，等等。呃，你"}, {"type": "subtitle", "time": 2658.95, "timestamp": "00:44:18", "text": "也需要加入。我怎麼邀請你加入"}, {"type": "subtitle", "time": 2666.109, "timestamp": "00:44:26", "text": "中隊。呃，等等。"}, {"type": "subtitle", "time": 2669.63, "timestamp": "00:44:29", "text": "我沒邀請你嗎？哦，等等"}, {"type": "subtitle", "time": 2673.19, "timestamp": "00:44:33", "text": "。哦，我從來沒邀請過你。我的錯。我"}, {"type": "subtitle", "time": 2677.03, "timestamp": "00:44:37", "text": "又收到邀請了。好的。是的"}, {"type": "subtitle", "time": 2679.43, "timestamp": "00:44:39", "text": "，我剛剛加了你。我忘了"}, {"type": "subtitle", "time": 2681.069, "timestamp": "00:44:41", "text": "在我的個人資料裡邀請你。"}, {"type": "subtitle", "time": 2686.55, "timestamp": "00:44:46", "text": "好的，現在我可以了。好了。好了。"}, {"type": "subtitle", "time": 2698.309, "timestamp": "00:44:58", "text": "零場戰鬥。 Z。不，我想我沒"}, {"type": "subtitle", "time": 2699.91, "timestamp": "00:44:59", "text": "玩過。至少在這個帳號沒玩過。零"}]
[{"type": "subtitle", "time": 2943.51, "timestamp": "00:49:03", "text": "副武器，"}, {"type": "subtitle", "time": 2947.43, "timestamp": "00:49:07", "text": "7毫米機槍，帶槍架。好吧。我"}, {"type": "subtitle", "time": 2949.51, "timestamp": "00:49:09", "text": "沒有副武器。好吧。使用"}, {"type": "subtitle", "time": 2952.109, "timestamp": "00:49:12", "text": "滿"}, {"type": "subtitle", "time": 2960.03, "timestamp": "00:49:20", "text": "東西。佔領敵方據點進入"}, {"type": "subtitle", "time": 2971.27, "timestamp": "00:49:31", "text": "你在哪裡？哦，也許我可以丟棄"}, {"type": "subtitle", "time": 2978.27, "timestamp": "00:49:38", "text": "我們你"}, {"type": "subtitle", "time": 2981.27, "timestamp": "00:49:41", "text": "看。從技術上講，你的"}, {"type": "subtitle", "time": 2985.829, "timestamp": "00:49:45", "text": "飛機基礎屬性稍微好一點。"}, {"type": "subtitle", "time": 2988.15, "timestamp": "00:49:48", "text": "哦，這是一架高級飛機。我也不知道"}, {"type": "subtitle", "time": 2990.95, "timestamp": "00:49:50", "text": "我是怎麼弄到的。"}, {"type": "subtitle", "time": 2992.549, "timestamp": "00:49:52", "text": "我想遊戲一開始就會給你一架。好的。"}, {"type": "subtitle", "time": 2996.15, "timestamp": "00:49:56", "text": "你看到我了嗎？紅色的。"}, {"type": "subtitle", "time": 2998.71, "timestamp": "00:49:58", "text": "我的天哪。是的。是的。好的。"}]
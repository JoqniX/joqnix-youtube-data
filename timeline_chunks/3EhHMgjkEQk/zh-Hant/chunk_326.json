[{"type": "subtitle", "time": 19562.47, "timestamp": "05:26:02", "text": "。"}, {"type": "subtitle", "time": 19569.51, "timestamp": "05:26:09", "text": "查德，我聲音這麼大，你還想讓我給你直播遊戲嗎？好的。哦，你可以保持沉默。"}, {"type": "subtitle", "time": 19580.91, "timestamp": "05:26:20", "text": "沒關係。沒有比利比利，所以沒關係。你不用擔心。"}, {"type": "subtitle", "time": 19585.83, "timestamp": "05:26:25", "text": "我不知道。誰說我要保持沉默，狗娘養的？誰說過要保持"}, {"type": "subtitle", "time": 19595.07, "timestamp": "05:26:35", "text": "沉默？但我要和查德談談。是的。讓你休息吧。不，"}, {"type": "subtitle", "time": 19603.47, "timestamp": "05:26:43", "text": "我要直播遊戲，因為我不在乎。"}, {"type": "subtitle", "time": 19615.91, "timestamp": "05:26:55", "text": "我的天，這個新介面還挺酷的。是哪一部分"}]
[{"type": "subtitle", "time": 4333.75, "timestamp": "01:12:13", "text": "哦，找到了。它給了我 60 分中的 21 分，"}, {"type": "subtitle", "time": 4336.149, "timestamp": "01:12:16", "text": "因為感覺就像你在那裡玩遊戲一樣。那確實有這麼一回事。我的天啊。  是的。如果顯示你不在，或者你不在鍵盤旁，它就會"}, {"type": "subtitle", "time": 4338.07, "timestamp": "01:12:18", "text": "迅速開始給"}, {"type": "subtitle", "time": 4361.43, "timestamp": "01:12:41", "text": "你會看到我面前有一個"}, {"type": "subtitle", "time": 4364.31, "timestamp": "01:12:44", "text": "半透明的圓圈。  那就是你要瞄準的圓圈。  是的。你怎麼轉得這麼快"}, {"type": "subtitle", "time": 4366.149, "timestamp": "01:12:46", "text": "？我就像在看著你一樣。有"}, {"type": "subtitle", "time": 4368.31, "timestamp": "01:12:48", "text": "攝影機之類的東西嗎？"}, {"type": "subtitle", "time": 4378.87, "timestamp": "01:12:58", "text": "我知道你的飛機比我的好。我已經100級了。 100級？什麼？像飛行員？  嘿。是的，我等級"}]
[{"type": "subtitle", "time": 1624.23, "timestamp": "00:27:04", "text": "不太確定了。你們是朋友嗎？就像"}, {"type": "subtitle", "time": 1626.789, "timestamp": "00:27:06", "text": "和那些你"}, {"type": "subtitle", "time": 1628.87, "timestamp": "00:27:08", "text": "不一定是朋友的人合作，你們更像是"}, {"type": "subtitle", "time": 1631.029, "timestamp": "00:27:11", "text": "在認識而已。我能"}, {"type": "subtitle", "time": 1633.269, "timestamp": "00:27:13", "text": "理解這需要更多的工作，這……"}, {"type": "subtitle", "time": 1637.35, "timestamp": "00:27:17", "text": "生意多點。嗯。我大概能理解，"}, {"type": "subtitle", "time": 1641.19, "timestamp": "00:27:21", "text": "畢竟要考慮這些因素。是"}, {"type": "subtitle", "time": 1642.87, "timestamp": "00:27:22", "text": "啊。"}, {"type": "subtitle", "time": 1646.35, "timestamp": "00:27:26", "text": "我個人不太喜歡那樣做。不是"}, {"type": "subtitle", "time": 1649.83, "timestamp": "00:27:29", "text": "因為我有什麼理念，而是"}, {"type": "subtitle", "time": 1653.029, "timestamp": "00:27:33", "text": "因為我懶得做。太費勁了。"}, {"type": "subtitle", "time": 1655.19, "timestamp": "00:27:35", "text": "我"}, {"type": "subtitle", "time": 1658.63, "timestamp": "00:27:38", "text": "很懶。我自己都很難保持頻道"}, {"type": "subtitle", "time": 1661.07, "timestamp": "00:27:41", "text": "活躍，更別提拉別人了。多久一次？每"}, {"type": "subtitle", "time": 1674.43, "timestamp": "00:27:54", "text": "六個月一次，我們私訊。我會說：「J，你想扮演Wanda嗎？」 好啊。我會像汽車保險推銷員一樣。"}, {"type": "subtitle", "time": 1676.669, "timestamp": "00:27:56", "text": "「你有空聊聊你的"}]
[{"type": "subtitle", "time": 39390.87, "timestamp": "10:56:30", "text": "你看不到這個，對吧？"}, {"type": "subtitle", "time": 39396.35, "timestamp": "10:56:36", "text": "我看到的劇情對白是這樣的。  偉大的。你能去範福德實驗室嗎"}, {"type": "subtitle", "time": 39401.586, "timestamp": "10:56:41", "text": "？"}, {"type": "subtitle", "time": 39404.95, "timestamp": "10:56:44", "text": "哦，好的，馬上就來。我們需要一份情況報告。我覺得我可以。小隊現在正朝著這個方向前進。我想我"}, {"type": "subtitle", "time": 39408.39, "timestamp": "10:56:48", "text": "解鎖了實驗室。我們正在路上。哦，實驗室毀了。有一個任務是前往實驗室遺址。這或許正是我們所需要的。"}]
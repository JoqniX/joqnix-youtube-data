[{"type": "subtitle", "time": 33501.748, "timestamp": "09:18:21", "text": "而且有兩隻耳朵。長耳朵。是的。"}, {"type": "subtitle", "time": 33504.708, "timestamp": "09:18:24", "text": "某種兔子。  小的。是的。我不知道。皮卡丘。  是的，符合條件。  正確的。  皮卡丘。  是的。呃，"}, {"type": "subtitle", "time": 33507.748, "timestamp": "09:18:27", "text": "我可以跳到你身上。傳送點就在這座"}, {"type": "subtitle", "time": 33512.112, "timestamp": "09:18:32", "text": "山頂上"}, {"type": "subtitle", "time": 33533.15, "timestamp": "09:18:53", "text": "哦，是的。他在這邊。是的。"}, {"type": "subtitle", "time": 33535.67, "timestamp": "09:18:55", "text": "好的。  哦，我想還有，是的，我們可以"}]
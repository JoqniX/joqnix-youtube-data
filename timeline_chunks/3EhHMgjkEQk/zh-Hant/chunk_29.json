[{"type": "subtitle", "time": 1742.95, "timestamp": "00:29:02", "text": "哦，對。對。對。對。那是一款恐怖遊戲。我"}, {"type": "subtitle", "time": 1745.909, "timestamp": "00:29:05", "text": "看過一個視頻，看起來很有趣。對。那還有"}, {"type": "subtitle", "time": 1749.909, "timestamp": "00:29:09", "text": "什麼？我剛開始玩《極限競速》。哦，對。就像"}, {"type": "subtitle", "time": 1772.149, "timestamp": "00:29:32", "text": "過去兩三週，十多年來我"}, {"type": "subtitle", "time": 1774.63, "timestamp": "00:29:34", "text": "第一次重新玩起了賽車遊戲。我偶爾也會玩玩其他的賽車遊戲，但上次"}, {"type": "subtitle", "time": 1782.47, "timestamp": "00:29:42", "text": "遊戲，就像在進行某種宗教儀式一樣，那就是《暴力摩托車》。哦，對了，現在還有《暴力摩托車：救贖》。我最近玩了。有個"}, {"type": "subtitle", "time": 1790.11, "timestamp": "00:29:50", "text": "遊戲叫《暴力"}]
[{"type": "subtitle", "time": 26167.788, "timestamp": "07:16:07", "text": "哦。哦，是的。  確實。好的。好的。現在沒辦法應付他"}, {"type": "subtitle", "time": 26172.23, "timestamp": "07:16:12", "text": "。好的。好的。我要離開這裡了"}, {"type": "subtitle", "time": 26174.948, "timestamp": "07:16:14", "text": "。"}, {"type": "subtitle", "time": 26182.548, "timestamp": "07:16:22", "text": "哦，現在"}, {"type": "subtitle", "time": 26208.15, "timestamp": "07:16:48", "text": "等等，他剛才上來了？媽的。"}]
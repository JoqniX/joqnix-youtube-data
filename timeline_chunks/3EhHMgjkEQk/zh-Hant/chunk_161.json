[{"type": "subtitle", "time": 9661.91, "timestamp": "02:41:01", "text": "製造、在印度生產的"}, {"type": "subtitle", "time": 9685.91, "timestamp": "02:41:25", "text": "如果你連續兩週每天做 2 天、2 天、2 天、2 天，"}, {"type": "subtitle", "time": 9687.91, "timestamp": "02:41:27", "text": "你就"}, {"type": "subtitle", "time": 9699.67, "timestamp": "02:41:39", "text": "飛機；否則，如果你失敗了，之後你就得花一大筆真金白銀才能買到那架飛機。  哦。"}, {"type": "subtitle", "time": 9703.03, "timestamp": "02:41:43", "text": "那麼，他們是否會引進最新的東西呢？他們最近添加的東西中，比較接近的是"}]
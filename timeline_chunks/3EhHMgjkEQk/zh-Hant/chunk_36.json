[{"type": "subtitle", "time": 2160.15, "timestamp": "00:36:00", "text": "8G過載之類的。"}, {"type": "subtitle", "time": 2163.67, "timestamp": "00:36:03", "text": "哦，8G過載你會暈倒。我是說9G過載"}, {"type": "subtitle", "time": 2166.63, "timestamp": "00:36:06", "text": "你也會暈倒。哦，重力"}, {"type": "subtitle", "time": 2170.23, "timestamp": "00:36:10", "text": "。你轉彎轉得太猛了，是的。"}, {"type": "subtitle", "time": 2172.55, "timestamp": "00:36:12", "text": "你的飛行員被壓進"}, {"type": "subtitle", "time": 2174.31, "timestamp": "00:36:14", "text": "飛機裡。血液都流出了"}, {"type": "subtitle", "time": 2178.069, "timestamp": "00:36:18", "text": "大腦。這確實存在。是的。好的。"}, {"type": "subtitle", "time": 2181.51, "timestamp": "00:36:21", "text": "呃，讓我解釋一下。"}, {"type": "subtitle", "time": 2184.23, "timestamp": "00:36:24", "text": "富士的科學時間。所以，"}, {"type": "subtitle", "time": 2186.31, "timestamp": "00:36:26", "text": "呃，重力是指你在"}, {"type": "subtitle", "time": 2189.51, "timestamp": "00:36:29", "text": "地球上時"}, {"type": "subtitle", "time": 2190.95, "timestamp": "00:36:30", "text": "感受到的1倍地球"}, {"type": "subtitle", "time": 2193.19, "timestamp": "00:36:33", "text": "重力。"}, {"type": "subtitle", "time": 2195.43, "timestamp": "00:36:35", "text": "如果你去像火星這樣的行星，你"}, {"type": "subtitle", "time": 2198.63, "timestamp": "00:36:38", "text": "感受到的重力大概是1.5倍"}, {"type": "subtitle", "time": 2203.19, "timestamp": "00:36:43", "text": "。如果你去木星，你根本"}, {"type": "subtitle", "time": 2204.95, "timestamp": "00:36:44", "text": "站不起來。想像"}, {"type": "subtitle", "time": 2209.43, "timestamp": "00:36:49", "text": "木星上有堅實的陸地。"}, {"type": "subtitle", "time": 2211.589, "timestamp": "00:36:51", "text": "你絕對"}, {"type": "subtitle", "time": 2213.589, "timestamp": "00:36:53", "text": "站不起來。你甚至都"}, {"type": "subtitle", "time": 2215.67, "timestamp": "00:36:55", "text": "坐不起來。你會被"}, {"type": "subtitle", "time": 2218.39, "timestamp": "00:36:58", "text": "壓在地上。"}]
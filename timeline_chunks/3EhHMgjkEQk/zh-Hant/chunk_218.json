[{"type": "subtitle", "time": 13101.229, "timestamp": "03:38:21", "text": "哪裡？"}, {"type": "subtitle", "time": 13112.07, "timestamp": "03:38:32", "text": "。你看我？是的，我現在真的快完成了"}, {"type": "subtitle", "time": 13117.03, "timestamp": "03:38:37", "text": "。所以，我離你大概有3公里遠，對吧？  距離3至4公里。我只需一把"}, {"type": "subtitle", "time": 13117.99, "timestamp": "03:38:37", "text": "槍，就能在兩倍甚至三倍遠的距離上輕鬆幹掉你"}, {"type": "subtitle", "time": 13119.67, "timestamp": "03:38:39", "text": "。"}, {"type": "subtitle", "time": 13122.229, "timestamp": "03:38:42", "text": "不，用"}, {"type": "subtitle", "time": 13124.15, "timestamp": "03:38:44", "text": "我的導彈。  我可以向"}, {"type": "subtitle", "time": 13126.55, "timestamp": "03:38:46", "text": "你開槍。我離你大概5公里遠，對吧？"}]
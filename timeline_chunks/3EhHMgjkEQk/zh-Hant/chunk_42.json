[{"type": "subtitle", "time": 2522.79, "timestamp": "00:42:02", "text": "所有國家都升滿。更像是先升"}, {"type": "subtitle", "time": 2525.19, "timestamp": "00:42:05", "text": "你喜歡的，然後再根據"}, {"type": "subtitle", "time": 2527.77, "timestamp": "00:42:07", "text": "需要提升其他國家的等級。"}, {"type": "subtitle", "time": 2529.43, "timestamp": "00:42:09", "text": "[音樂]"}, {"type": "subtitle", "time": 2531.19, "timestamp": "00:42:11", "text": "通常只有那些拼命想把"}, {"type": "subtitle", "time": 2533.589, "timestamp": "00:42:13", "text": "所有東西都升滿的玩家才會這麼做，而且"}, {"type": "subtitle", "time": 2536.15, "timestamp": "00:42:16", "text": "通常即使是他們，也往往會放棄，然後去買"}, {"type": "subtitle", "time": 2544.55, "timestamp": "00:42:24", "text": "付費版。"}, {"type": "subtitle", "time": 2550.39, "timestamp": "00:42:30", "text": "等待就是花錢。"}, {"type": "subtitle", "time": 2553.67, "timestamp": "00:42:33", "text": "是的。等等，這款遊戲允許"}, {"type": "subtitle", "time": 2557.99, "timestamp": "00:42:37", "text": "使用真正的飛行裝備嗎？"}, {"type": "subtitle", "time": 2560.63, "timestamp": "00:42:40", "text": "它確實有一個模擬模式，"}, {"type": "subtitle", "time": 2563.43, "timestamp": "00:42:43", "text": "但我不會推薦，因為在我"}, {"type": "subtitle", "time": 2566.79, "timestamp": "00:42:46", "text": "玩《戰爭雷霆》的整個過程中……"}, {"type": "subtitle", "time": 2570.79, "timestamp": "00:42:50", "text": "哦，有一個飛行控制教程要看"}, {"type": "subtitle", "time": 2574.15, "timestamp": "00:42:54", "text": "兩三次。有個飛行教程，教你"}, {"type": "subtitle", "time": 2576.79, "timestamp": "00:42:56", "text": "如何駕駛飛機。我該"}]
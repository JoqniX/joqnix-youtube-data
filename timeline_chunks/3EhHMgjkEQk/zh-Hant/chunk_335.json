[{"type": "subtitle", "time": 20112.03, "timestamp": "05:35:12", "text": "好的，我有"}, {"type": "subtitle", "time": 20114.91, "timestamp": "05:35:14", "text": "三個兒子，兩個"}, {"type": "subtitle", "time": 20152.75, "timestamp": "05:35:52", "text": "什麼的？這是普通的水。我的天哪，那是我寶貝。噓，停下。總之，我會玩雙倍牌組的玩法。這簡直是胡說八道。順便說一句，各位，"}]
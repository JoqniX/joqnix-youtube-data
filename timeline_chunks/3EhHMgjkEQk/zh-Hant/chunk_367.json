[{"type": "subtitle", "time": 22034.548, "timestamp": "06:07:14", "text": "兄弟。該死的。哦，哇。"}, {"type": "subtitle", "time": 22040.868, "timestamp": "06:07:20", "text": "兩顆骰子是"}, {"type": "subtitle", "time": 22044.11, "timestamp": "06:07:24", "text": "五。什麼？  我們所有人的末日到了。我的天哪。"}, {"type": "subtitle", "time": 22058.19, "timestamp": "06:07:38", "text": "我就是討厭這個遊戲。我討厭這樣。那張卡對我來說完全沒用。完全沒用。他什麼也"}]
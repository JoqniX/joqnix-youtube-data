[{"type": "subtitle", "time": 19980.19, "timestamp": "05:33:00", "text": "天啊。等等，是另一個人送來的嗎？等等，"}, {"type": "subtitle", "time": 19984.07, "timestamp": "05:33:04", "text": "這到底是怎麼回事？你知道嗎？我"}, {"type": "subtitle", "time": 19987.23, "timestamp": "05:33:07", "text": "打算買那個。到底是哪一個？我可以明白。我可以收到那條聊天訊息。"}, {"type": "subtitle", "time": 19993.03, "timestamp": "05:33:13", "text": "你可以玩這種骰子拉力賽遊戲。選擇一副牌。哦，我必須選擇一個標誌模板嗎？"}, {"type": "subtitle", "time": 20024.39, "timestamp": "05:33:44", "text": "我的藍色甲板會讓我生氣嗎？我的靈長類動物工作嗎？好的，麥克斯。沒有同步器。"}, {"type": "subtitle", "time": 20034.948, "timestamp": "05:33:54", "text": "好的，我想我有…我想我有…我擁有的兩副牌組都是關於同調"}, {"type": "subtitle", "time": 20037.51, "timestamp": "05:33:57", "text": "召喚的。另一個還沒完成。"}]
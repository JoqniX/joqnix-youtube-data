[{"type": "subtitle", "time": 28041.99, "timestamp": "07:47:21", "text": "我的內心飛得這麼快"}, {"type": "subtitle", "time": 28045.51, "timestamp": "07:47:25", "text": "。  哦，是的。嘿，加油，"}, {"type": "subtitle", "time": 28047.75, "timestamp": "07:47:27", "text": "銀猴！怎麼樣了？  我們這兒還有個大塊頭。  是啊，個大塊頭。  嗯"}, {"type": "subtitle", "time": 28073.91, "timestamp": "07:47:53", "text": "，也許有點厚，但"}, {"type": "subtitle", "time": 28075.83, "timestamp": "07:47:55", "text": "更適合他。  嗯。  是的。"}]
[{"type": "chat", "time": 8222.421, "timestamp": "02:17:02", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "dat was sadge"}, {"type": "subtitle", "time": 8224.629, "timestamp": "02:17:04", "text": "射擊坦克的位置，你可以損壞發動機，也可以損壞砲塔。所以，它們雖然不能開火，但仍然"}, {"type": "subtitle", "time": 8236.309, "timestamp": "02:17:16", "text": "可以移動。或者如果你運氣"}, {"type": "subtitle", "time": 8245.03, "timestamp": "02:17:25", "text": "好，擊穿他們的彈藥，一炮就能炸毀坦克。一般情況下不會發生。所以，躲在什麼東西後面吧"}, {"type": "subtitle", "time": 8257.11, "timestamp": "02:17:37", "text": "提示出現。那就別等了。正確指向它。繼續移動滑鼠，直到十字準星變成綠色為止。一旦指示燈變成綠色，就"}, {"type": "subtitle", "time": 8268.23, "timestamp": "02:17:48", "text": "表示遊戲告訴你子彈會穿透坦克車的裝甲。  這容易理解嗎？是的。  極好的。現在，我們來看看。"}, {"type": "subtitle", "time": 8272.629, "timestamp": "02:17:52", "text": "你在幹什麼？  目標已摧毀。我殺了她。  我們走吧。"}, {"type": "subtitle", "time": 8276.629, "timestamp": "02:17:56", "text": "你殺了人。  極好的。也是開玩笑"}, {"type": "subtitle", "time": 8279.429, "timestamp": "02:17:59", "text": "。始終將油箱傾斜放置。不要完全面對鏡頭，也不要完全側對著鏡頭。我的天哪。你這樣"}]
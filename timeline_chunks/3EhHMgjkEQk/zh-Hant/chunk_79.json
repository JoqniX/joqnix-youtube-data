[{"type": "subtitle", "time": 4749.51, "timestamp": "01:19:09", "text": "我的球員等級了。不，"}, {"type": "subtitle", "time": 4757.11, "timestamp": "01:19:17", "text": "我被如何提升"}, {"type": "subtitle", "time": 4767.91, "timestamp": "01:19:27", "text": "球員等級這件事搞糊塗了。  呃，那隻是配對而已"}, {"type": "subtitle", "time": 4770.63, "timestamp": "01:19:30", "text": "。除了金錢之外，你還能獲得經驗值。啊，所以你玩"}, {"type": "subtitle", "time": 4774.31, "timestamp": "01:19:34", "text": "遊戲，然後根據你玩得好不好，遊戲裡會有一個演算法來評判你"}, {"type": "subtitle", "time": 4779.27, "timestamp": "01:19:39", "text": "。你會獲得經驗值。假設"}, {"type": "subtitle", "time": 4790.55, "timestamp": "01:19:50", "text": "你當時正"}]
[{"type": "subtitle", "time": 2220.55, "timestamp": "00:37:00", "text": "這就是重力。現在還有"}, {"type": "subtitle", "time": 2222.79, "timestamp": "00:37:02", "text": "另一件事。"}, {"type": "subtitle", "time": 2224.47, "timestamp": "00:37:04", "text": "你知道，這叫做離心力，當你揮動物體時，"}, {"type": "subtitle", "time": 2226.79, "timestamp": "00:37:06", "text": "它會被向外推。現在，"}, {"type": "subtitle", "time": 2232.39, "timestamp": "00:37:12", "text": "在飛機上，當你坐在"}, {"type": "subtitle", "time": 2237.91, "timestamp": "00:37:17", "text": "駕駛艙裡轉彎時，幾乎總是在向上拉飛機"}, {"type": "subtitle", "time": 2240.069, "timestamp": "00:37:20", "text": "。如果你想向右轉，"}, {"type": "subtitle", "time": 2242.31, "timestamp": "00:37:22", "text": "你會先將飛機向右傾斜，"}, {"type": "subtitle", "time": 2245.91, "timestamp": "00:37:25", "text": "然後再拉。對。是的。所以，身為"}, {"type": "subtitle", "time": 2247.43, "timestamp": "00:37:27", "text": "坐在駕駛艙裡的飛行員，你"}, {"type": "subtitle", "time": 2250.15, "timestamp": "00:37:30", "text": "總是往上拉飛機。當你這樣做時，你就像"}, {"type": "subtitle", "time": 2252.39, "timestamp": "00:37:32", "text": "畫了一個圓，而你位於"}, {"type": "subtitle", "time": 2257.109, "timestamp": "00:37:37", "text": "圓的外側。因此，你會感受到巨大的"}, {"type": "subtitle", "time": 2262.31, "timestamp": "00:37:42", "text": "離心力，這叫做重力加速度，就像2G"}, {"type": "subtitle", "time": 2266.79, "timestamp": "00:37:46", "text": "重力一樣。就像"}, {"type": "subtitle", "time": 2270.23, "timestamp": "00:37:50", "text": "你感受到的地球重力是地球重力的多少倍，對吧？"}, {"type": "subtitle", "time": 2272.47, "timestamp": "00:37:52", "text": "啊，所以理論上，如果我"}, {"type": "subtitle", "time": 2275.109, "timestamp": "00:37:55", "text": "在你的駕駛艙裡放一個秤，如果"}, {"type": "subtitle", "time": 2278.23, "timestamp": "00:37:58", "text": "你體重100公斤，承受"}]
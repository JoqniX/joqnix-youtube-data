[{"type": "subtitle", "time": 8766.19, "timestamp": "02:26:06", "text": "這是"}, {"type": "subtitle", "time": 8768.15, "timestamp": "02:26:08", "text": "免費的嗎？還是說根本沒有上帝？好的，你現在擁有的是免費的。它是你的。它歸你所有。"}, {"type": "subtitle", "time": 8772.07, "timestamp": "02:26:12", "text": "嗯。  第二。給我一分鐘時間。是的。  一些零食。"}, {"type": "subtitle", "time": 8785.67, "timestamp": "02:26:25", "text": "嗯，喬克很忙"}, {"type": "subtitle", "time": 8787.51, "timestamp": "02:26:27", "text": "。我有一些……這是什麼？酸奶油和洋蔥。"}, {"type": "subtitle", "time": 8792.15, "timestamp": "02:26:32", "text": "你在吃什麼零食呢，小夥伴？  哦"}, {"type": "subtitle", "time": 8798.75, "timestamp": "02:26:38", "text": "，對了，我還要去哪裡"}]
[{"type": "subtitle", "time": 2040.149, "timestamp": "00:34:00", "text": "飛機。我應該把它設定成"}, {"type": "subtitle", "time": 2043.43, "timestamp": "00:34:03", "text": "簡化控制嗎？"}, {"type": "subtitle", "time": 2045.269, "timestamp": "00:34:05", "text": "即使你這麼做了，你也得去"}, {"type": "subtitle", "time": 2047.99, "timestamp": "00:34:07", "text": "檢查一下你的預設控制設定。一般來說，"}, {"type": "subtitle", "time": 2049.51, "timestamp": "00:34:09", "text": "你開始玩"}, {"type": "subtitle", "time": 2052.79, "timestamp": "00:34:12", "text": "遊戲的時候會根據自己的"}, {"type": "subtitle", "time": 2055.109, "timestamp": "00:34:15", "text": "習慣來設定。"}, {"type": "subtitle", "time": 2057.669, "timestamp": "00:34:17", "text": "所以，我的設定不是預設的。我"}, {"type": "subtitle", "time": 2061.99, "timestamp": "00:34:21", "text": "改過了。啊，所以去飛機"}, {"type": "subtitle", "time": 2066.389, "timestamp": "00:34:26", "text": "移動設置，然後看看你的按鈕。是"}, {"type": "subtitle", "time": 2071.349, "timestamp": "00:34:31", "text": "油門控制。呃，滾輪滑鼠。滾輪。"}, {"type": "subtitle", "time": 2079.99, "timestamp": "00:34:39", "text": "呃，我甚至不知道"}, {"type": "subtitle", "time": 2083.349, "timestamp": "00:34:43", "text": "我什麼時候玩過這個遊戲了。我本來"}, {"type": "subtitle", "time": 2085.75, "timestamp": "00:34:45", "text": "想問，你以前玩過這個遊戲嗎？我"}, {"type": "subtitle", "time": 2093.669, "timestamp": "00:34:53", "text": "我不記得了。我教過你嗎？我"}, {"type": "subtitle", "time": 2095.27, "timestamp": "00:34:55", "text": "想當時我唯一"}, {"type": "subtitle", "time": 2098.31, "timestamp": "00:34:58", "text": "教你的就是基本的飛行操作。"}]
[{"type": "subtitle", "time": 2220.55, "timestamp": "00:37:00", "text": "これこそが重力だ。今は"}, {"type": "subtitle", "time": 2222.79, "timestamp": "00:37:02", "text": "遠心力と呼ばれる別の現象"}, {"type": "subtitle", "time": 2224.47, "timestamp": "00:37:04", "text": "何かを振り回した瞬間にわかる"}, {"type": "subtitle", "time": 2226.79, "timestamp": "00:37:06", "text": "その周りでは、押し出されてしまうような感じだ。"}, {"type": "subtitle", "time": 2230.15, "timestamp": "00:37:10", "text": "右外側"}, {"type": "subtitle", "time": 2232.39, "timestamp": "00:37:12", "text": "飛行機に乗って座っていると、"}, {"type": "subtitle", "time": 2234.27, "timestamp": "00:37:14", "text": "ターンすると"}, {"type": "subtitle", "time": 2237.91, "timestamp": "00:37:17", "text": "飛行機はほとんどの場合、あなたの"}, {"type": "subtitle", "time": 2240.069, "timestamp": "00:37:20", "text": "飛行機が上昇する。もしあなたが"}, {"type": "subtitle", "time": 2242.31, "timestamp": "00:37:22", "text": "右に飛行機を傾ける"}, {"type": "subtitle", "time": 2245.91, "timestamp": "00:37:25", "text": "そして引っ張る。右。うん。だから"}, {"type": "subtitle", "time": 2247.43, "timestamp": "00:37:27", "text": "パイロットが中に座っていると、"}, {"type": "subtitle", "time": 2250.15, "timestamp": "00:37:30", "text": "いつも前に出てくる。そうすると、"}, {"type": "subtitle", "time": 2252.39, "timestamp": "00:37:32", "text": "円を描くようにして、"}, {"type": "subtitle", "time": 2253.63, "timestamp": "00:37:33", "text": "外側"}, {"type": "subtitle", "time": 2257.109, "timestamp": "00:37:37", "text": "丸。だからあなたは重苦しい"}, {"type": "subtitle", "time": 2258.349, "timestamp": "00:37:38", "text": "遠心"}, {"type": "subtitle", "time": 2262.31, "timestamp": "00:37:42", "text": "力、それはグラと呼ばれ、g のような"}, {"type": "subtitle", "time": 2264.109, "timestamp": "00:37:44", "text": "重力"}, {"type": "subtitle", "time": 2266.79, "timestamp": "00:37:46", "text": "力。それは地球が何回"}, {"type": "subtitle", "time": 2270.23, "timestamp": "00:37:50", "text": "重力を感じますか？"}, {"type": "subtitle", "time": 2272.47, "timestamp": "00:37:52", "text": "ああ、つまり技術的には、私が計量器を置くと"}, {"type": "subtitle", "time": 2275.109, "timestamp": "00:37:55", "text": "コックピット内のスケール"}, {"type": "subtitle", "time": 2278.23, "timestamp": "00:37:58", "text": "君は100キロくらいあったのに、"}]
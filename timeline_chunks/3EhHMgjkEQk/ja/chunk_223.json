[{"type": "subtitle", "time": 13381.99, "timestamp": "03:43:01", "text": "プロフィール、またはあなた自身のプロフィールのようなもの"}, {"type": "subtitle", "time": 13384.309, "timestamp": "03:43:04", "text": "ウェブサイトか何かで尋ねるのではなく"}, {"type": "subtitle", "time": 13389.19, "timestamp": "03:43:09", "text": "誰かに確認してもらう必要がある。いいえ。"}, {"type": "subtitle", "time": 13392.389, "timestamp": "03:43:12", "text": "わかった。冗談だよ、無制限に設定したんだ"}, {"type": "subtitle", "time": 13398.63, "timestamp": "03:43:18", "text": "わかった。さて、私が"}, {"type": "subtitle", "time": 13400.63, "timestamp": "03:43:20", "text": "ジェット機なのに、プロペラを使っているの？それは"}, {"type": "subtitle", "time": 13402.63, "timestamp": "03:43:22", "text": "あなたは何をしたいですか？ええ、もちろんです。もちろん。"}, {"type": "subtitle", "time": 13404.429, "timestamp": "03:43:24", "text": "よし、では"}, {"type": "subtitle", "time": 13421.269, "timestamp": "03:43:41", "text": "さて、あなたが勝つための最良の方法は"}, {"type": "subtitle", "time": 13423.269, "timestamp": "03:43:43", "text": "ジェット機に対するプロペラは撃とうとしている"}, {"type": "subtitle", "time": 13427.189, "timestamp": "03:43:47", "text": "操縦席、パイロット。"}, {"type": "subtitle", "time": 13429.349, "timestamp": "03:43:49", "text": "どうやって撮影すればいいですか？そうそう。私はそうすべきだ"}, {"type": "subtitle", "time": 13431.83, "timestamp": "03:43:51", "text": "あなたのもとへ行かなければならない。あなたは"}, {"type": "subtitle", "time": 13434.55, "timestamp": "03:43:54", "text": "パイロットを前に出すための多くの戦術"}, {"type": "subtitle", "time": 13437.91, "timestamp": "03:43:57", "text": "あなたと一緒に、しかもその低速で。だから、これは"}]
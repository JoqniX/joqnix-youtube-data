[{"type": "subtitle", "time": 10028.79, "timestamp": "02:47:08", "text": "それ。カメラアングルは変えないでください。"}, {"type": "subtitle", "time": 10031.11, "timestamp": "02:47:11", "text": "わかった。"}, {"type": "subtitle", "time": 10033.83, "timestamp": "02:47:13", "text": "Hをヒット。Hはエアブラであるべきで、そうでない場合は"}, {"type": "subtitle", "time": 10049.91, "timestamp": "02:47:29", "text": "彼らは場所をどのように変更するか"}, {"type": "subtitle", "time": 10052.309, "timestamp": "02:47:32", "text": "早く、あなたはそれを成し遂げるでしょう"}, {"type": "subtitle", "time": 10054.389, "timestamp": "02:47:34", "text": "操縦しやすく、あらゆる場所で簡単に飛行できる"}, {"type": "subtitle", "time": 10057.51, "timestamp": "02:47:37", "text": "速度。近い。うん。そのため、低速では、"}, {"type": "subtitle", "time": 10059.67, "timestamp": "02:47:39", "text": "翼が出てくるので、回転できます"}, {"type": "subtitle", "time": 10062.07, "timestamp": "02:47:42", "text": "より良い。そして高速では、翼は"}, {"type": "subtitle", "time": 10064.15, "timestamp": "02:47:44", "text": "あまり多く渡されないように"}, {"type": "subtitle", "time": 10070.07, "timestamp": "02:47:50", "text": "カメラアングルを変えると、"}, {"type": "subtitle", "time": 10072.71, "timestamp": "02:47:52", "text": "エアブラも少し"}]
[{"type": "subtitle", "time": 12301.67, "timestamp": "03:25:01", "text": "おお。知ってるでしょ、私はあなたを撃つことができるのに"}, {"type": "subtitle", "time": 12305.99, "timestamp": "03:25:05", "text": "20マイル先ですよね？ 20キロ先。本当に？"}, {"type": "subtitle", "time": 12308.87, "timestamp": "03:25:08", "text": "ちょっと引っ掻いてあげるね。あの飛行機の中で。"}, {"type": "subtitle", "time": 12310.309, "timestamp": "03:25:10", "text": "あの飛行機の中で。私はその飛行機を持っていません"}, {"type": "subtitle", "time": 12311.67, "timestamp": "03:25:11", "text": "また。だから、始めなければならない"}, {"type": "subtitle", "time": 12319.03, "timestamp": "03:25:19", "text": "どの飛行機ですか？トム・クルーズのやつ。"}, {"type": "subtitle", "time": 12321.91, "timestamp": "03:25:21", "text": "今あなたが見たやつです。"}, {"type": "subtitle", "time": 12323.67, "timestamp": "03:25:23", "text": "待って、できるよ。ああ、トム・クルーズのやつ。"}, {"type": "subtitle", "time": 12326.71, "timestamp": "03:25:26", "text": "また。私にはできる、なぜなら私は"}, {"type": "subtitle", "time": 12328.79, "timestamp": "03:25:28", "text": "飛行機ですが、あなたはそうしないのでできません"}, {"type": "subtitle", "time": 12331.19, "timestamp": "03:25:31", "text": "飛行機を持っている。その特定の飛行機ですか？私"}, {"type": "subtitle", "time": 12333.269, "timestamp": "03:25:33", "text": "持っていません。そうしないといけないんだ、"}, {"type": "subtitle", "time": 12336.63, "timestamp": "03:25:36", "text": "あの飛行機を手に入れるために、ひたすら努力するんだ。"}, {"type": "subtitle", "time": 12338.15, "timestamp": "03:25:38", "text": "くそ。"}, {"type": "subtitle", "time": 12342.389, "timestamp": "03:25:42", "text": "どこにいるの？私は自分の"}, {"type": "subtitle", "time": 12344.95, "timestamp": "03:25:44", "text": "装甲から撃つことはできない"}, {"type": "subtitle", "time": 12346.309, "timestamp": "03:25:46", "text": "ヘルプ。あなたを助けるものは何もありません"}, {"type": "subtitle", "time": 12348.07, "timestamp": "03:25:48", "text": "ミサイル攻撃を生き延びる。"}, {"type": "subtitle", "time": 12349.67, "timestamp": "03:25:49", "text": "運が良ければミサイル攻撃から生き延びられるだろう。"}, {"type": "subtitle", "time": 12351.67, "timestamp": "03:25:51", "text": "それでおしまい。わかった。今、私は持っていません"}, {"type": "subtitle", "time": 12353.51, "timestamp": "03:25:53", "text": "そんな風に操縦できる飛行機。これ"}, {"type": "subtitle", "time": 12355.03, "timestamp": "03:25:55", "text": "あなたが"}]
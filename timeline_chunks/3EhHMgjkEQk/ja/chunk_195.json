[{"type": "subtitle", "time": 11707.07, "timestamp": "03:15:07", "text": "鍵。うん。それを割り当ててください。素晴らしい。今"}, {"type": "subtitle", "time": 11710.309, "timestamp": "03:15:10", "text": "近い。さあ、起動しよう。飛び出して行く"}, {"type": "subtitle", "time": 11711.99, "timestamp": "03:15:11", "text": "少し高めにして、"}, {"type": "subtitle", "time": 11713.51, "timestamp": "03:15:13", "text": "爆弾。爆弾を処分しろ。あなた"}, {"type": "subtitle", "time": 11724.269, "timestamp": "03:15:24", "text": "よし、"}, {"type": "subtitle", "time": 11727.03, "timestamp": "03:15:27", "text": "羽根。爆弾を投下したら、"}, {"type": "subtitle", "time": 11729.11, "timestamp": "03:15:29", "text": "ほぼ真上を指している。だから、これらは"}, {"type": "subtitle", "time": 11731.349, "timestamp": "03:15:31", "text": "平面、これとあの別の三角形"}, {"type": "subtitle", "time": 11732.75, "timestamp": "03:15:32", "text": "私が見せた飛行機"}, {"type": "subtitle", "time": 11735.11, "timestamp": "03:15:35", "text": "エンジンは十分強力です"}, {"type": "subtitle", "time": 11736.87, "timestamp": "03:15:36", "text": "飛行機をまっすぐに押すことができる"}, {"type": "subtitle", "time": 11738.79, "timestamp": "03:15:38", "text": "上。"}, {"type": "subtitle", "time": 11741.429, "timestamp": "03:15:41", "text": "一般的に、飛行機はまっすぐ上には飛べない。"}, {"type": "subtitle", "time": 11742.99, "timestamp": "03:15:42", "text": "少なくとも古い"}, {"type": "subtitle", "time": 11747.03, "timestamp": "03:15:47", "text": "1つ。フラップをまっすぐにしてください。上げる"}, {"type": "subtitle", "time": 11750.15, "timestamp": "03:15:50", "text": "あなたの羽根。"}, {"type": "subtitle", "time": 11752.309, "timestamp": "03:15:52", "text": "完璧。さあ、全速力で"}, {"type": "subtitle", "time": 11755.309, "timestamp": "03:15:55", "text": "その間。もう少し上げてください。いくつか増やす"}, {"type": "subtitle", "time": 11757.349, "timestamp": "03:15:57", "text": "身長。あなたには"}, {"type": "subtitle", "time": 11759.349, "timestamp": "03:15:59", "text": "キーが割り当てられました。なぜ表示されないのか"}]
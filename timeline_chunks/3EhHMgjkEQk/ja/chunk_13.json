[{"type": "subtitle", "time": 791.03, "timestamp": "00:13:11", "text": "トゥイッチ。私のマウスは"}, {"type": "subtitle", "time": 793.949, "timestamp": "00:13:13", "text": "文字通り少しずつ"}, {"type": "subtitle", "time": 800.67, "timestamp": "00:13:20", "text": "神。待って。"}, {"type": "subtitle", "time": 804.629, "timestamp": "00:13:24", "text": "ああ、そりゃあ上位に入るのも当然だな。誰が"}, {"type": "subtitle", "time": 808.23, "timestamp": "00:13:28", "text": "X12に行くように言ったの？"}, {"type": "subtitle", "time": 814.71, "timestamp": "00:13:34", "text": "えっ？クライアントの再起動は引き続き必要です。"}, {"type": "subtitle", "time": 816.19, "timestamp": "00:13:36", "text": "何てことだ。"}, {"type": "subtitle", "time": 824.509, "timestamp": "00:13:44", "text": "動く。ええ、私も断りましたよ"}, {"type": "subtitle", "time": 834.43, "timestamp": "00:13:54", "text": "ゆっくり。では、テキスト11を見てみましょう。"}, {"type": "subtitle", "time": 837.069, "timestamp": "00:13:57", "text": "グラフィックが遅い"}]
[{"type": "subtitle", "time": 13440.63, "timestamp": "03:44:00", "text": "無限ですよね？ 3秒。うん、"}, {"type": "subtitle", "time": 13442.95, "timestamp": "03:44:02", "text": "これは無限です。"}, {"type": "subtitle", "time": 13445.91, "timestamp": "03:44:05", "text": "わかった。"}, {"type": "subtitle", "time": 13448.469, "timestamp": "03:44:08", "text": "応答時間を無制限に設定しました。"}, {"type": "subtitle", "time": 13450.15, "timestamp": "03:44:10", "text": "ただし、時間は限られています。私たちは"}, {"type": "subtitle", "time": 13452.95, "timestamp": "03:44:12", "text": "待って、飛行機は"}, {"type": "subtitle", "time": 13455.189, "timestamp": "03:44:15", "text": "休憩ですよね？"}, {"type": "subtitle", "time": 13456.469, "timestamp": "03:44:16", "text": "飛行機は壊れるだろう。単に"}, {"type": "subtitle", "time": 13458.79, "timestamp": "03:44:18", "text": "同じ平面上でリスポーンする。私は思う"}, {"type": "subtitle", "time": 13461.429, "timestamp": "03:44:21", "text": "それが正しいはずだ。"}, {"type": "subtitle", "time": 13463.91, "timestamp": "03:44:23", "text": "まさにその通りだ。それで試合は"}, {"type": "subtitle", "time": 13466.309, "timestamp": "03:44:26", "text": "まだ時間には限りがあります。わかった。私たちはそうしません"}, {"type": "subtitle", "time": 13468.389, "timestamp": "03:44:28", "text": "無制限の時間を手に入れる。無制限に"}, {"type": "subtitle", "time": 13470.309, "timestamp": "03:44:30", "text": "リスポーンします。"}, {"type": "subtitle", "time": 13472.389, "timestamp": "03:44:32", "text": "ガッチャ。"}, {"type": "subtitle", "time": 13474.15, "timestamp": "03:44:34", "text": "私に何をしてほしいのですか？どのようなシナリオか"}, {"type": "subtitle", "time": 13476.469, "timestamp": "03:44:36", "text": "私に演奏してほしいですか？戦いに行こう"}, {"type": "subtitle", "time": 13482.79, "timestamp": "03:44:42", "text": "反撃してほしいの？私たちは"}, {"type": "subtitle", "time": 13484.63, "timestamp": "03:44:44", "text": "もちろん銃を使うことはできますが、"}, {"type": "subtitle", "time": 13486.95, "timestamp": "03:44:46", "text": "ミサイル？"}, {"type": "subtitle", "time": 13488.11, "timestamp": "03:44:48", "text": "それが"}, {"type": "subtitle", "time": 13490.03, "timestamp": "03:44:50", "text": "平均。私"}, {"type": "subtitle", "time": 13492.79, "timestamp": "03:44:52", "text": "見る。もっと早く知っていたら、"}, {"type": "subtitle", "time": 13495.269, "timestamp": "03:44:55", "text": "私のミサイルには搭載しないでほしい。ただ"}]
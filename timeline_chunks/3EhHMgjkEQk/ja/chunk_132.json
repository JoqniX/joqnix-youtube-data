[{"type": "subtitle", "time": 7921.51, "timestamp": "02:12:01", "text": "もしくは、戦車を隠せるようなもの"}, {"type": "subtitle", "time": 7924.47, "timestamp": "02:12:04", "text": "戦闘エリアに到着したら。"}, {"type": "subtitle", "time": 7928.709, "timestamp": "02:12:08", "text": "それともABCでしょうか？あなたのトップスが突き出ています"}, {"type": "subtitle", "time": 7931.99, "timestamp": "02:12:11", "text": "外。 ABCを選んでもいいですよ。それらは"}, {"type": "subtitle", "time": 7934.03, "timestamp": "02:12:14", "text": "捕獲"}, {"type": "subtitle", "time": 7937.189, "timestamp": "02:12:17", "text": "ポイントですが、スピードと"}, {"type": "subtitle", "time": 7938.95, "timestamp": "02:12:18", "text": "基本的にプレイしているという事実"}, {"type": "subtitle", "time": 7940.27, "timestamp": "02:12:20", "text": "初めて"}, {"type": "subtitle", "time": 7943.629, "timestamp": "02:12:23", "text": "時間内にはそこにたどり着けません"}, {"type": "subtitle", "time": 7946.149, "timestamp": "02:12:26", "text": "時間。例えば、Bはすでに"}, {"type": "subtitle", "time": 7947.75, "timestamp": "02:12:27", "text": "私たちのチームが撮影しました。 Cは"}, {"type": "subtitle", "time": 7949.99, "timestamp": "02:12:29", "text": "敵チームに捕らえられた。私たちは"}, {"type": "subtitle", "time": 7952.39, "timestamp": "02:12:32", "text": "B地点の占領に敗北。つまり、それは"}, {"type": "subtitle", "time": 7965.27, "timestamp": "02:12:45", "text": "ズームインするにはどうすればいいですか？"}, {"type": "subtitle", "time": 7968.709, "timestamp": "02:12:48", "text": "えっと、マウスの右クリックを試してみてください"}, {"type": "subtitle", "time": 7971.589, "timestamp": "02:12:51", "text": "または、sp shift を試してみてください。もしあなたが"}, {"type": "subtitle", "time": 7979.99, "timestamp": "02:12:59", "text": "おお、"}]
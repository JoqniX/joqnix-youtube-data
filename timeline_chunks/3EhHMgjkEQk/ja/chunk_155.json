[{"type": "subtitle", "time": 9302.79, "timestamp": "02:35:02", "text": "日本で。ええと、わかりました。わかった。だから、"}, {"type": "subtitle", "time": 9304.389, "timestamp": "02:35:04", "text": "最後から2番目の違い"}, {"type": "subtitle", "time": 9307.75, "timestamp": "02:35:07", "text": "そして最後は、最後の1つが"}, {"type": "subtitle", "time": 9310.309, "timestamp": "02:35:10", "text": "君はちゃんとした爆撃機部隊が好きなんだね。彼らは"}, {"type": "subtitle", "time": 9312.349, "timestamp": "02:35:12", "text": "大きくなり、重くなり、"}, {"type": "subtitle", "time": 9316.07, "timestamp": "02:35:16", "text": "大型爆撃機。ほとんど"}, {"type": "subtitle", "time": 9318.23, "timestamp": "02:35:18", "text": "操縦する。まっすぐ飛んで、"}, {"type": "subtitle", "time": 9321.03, "timestamp": "02:35:21", "text": "爆弾を投下し、そのまままっすぐ帰還する。あなたは"}, {"type": "subtitle", "time": 9323.27, "timestamp": "02:35:23", "text": "銃はたくさんあるが、一般的には"}, {"type": "subtitle", "time": 9325.03, "timestamp": "02:35:25", "text": "格好の標的。本当に飛行機に乗らなければならない"}, {"type": "subtitle", "time": 9328.389, "timestamp": "02:35:28", "text": "高いところ。ああ、最後から2行目については、"}, {"type": "subtitle", "time": 9331.67, "timestamp": "02:35:31", "text": "それは攻撃機であり、"}, {"type": "subtitle", "time": 9334.15, "timestamp": "02:35:34", "text": "戦闘機を爆撃機に改造したもの。それで、"}, {"type": "subtitle", "time": 9337.03, "timestamp": "02:35:37", "text": "戦闘機よりも動きが鈍い。"}, {"type": "subtitle", "time": 9339.27, "timestamp": "02:35:39", "text": "しかし、ある程度は機動して防御することができる"}, {"type": "subtitle", "time": 9344.95, "timestamp": "02:35:44", "text": "急降下する可能性がある。転がることもできる。大きな"}, {"type": "subtitle", "time": 9347.03, "timestamp": "02:35:47", "text": "爆撃機は急降下してロールすることはできない。あなたは"}, {"type": "subtitle", "time": 9348.63, "timestamp": "02:35:48", "text": "翼をすぐに折って"}, {"type": "subtitle", "time": 9357.429, "timestamp": "02:35:57", "text": "つまり、それはあなた次第ということです。その"}, {"type": "subtitle", "time": 9359.429, "timestamp": "02:35:59", "text": "大型爆撃機の良い点は、"}]
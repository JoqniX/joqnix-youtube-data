[{"type": "subtitle", "time": 14940.95, "timestamp": "04:09:00", "text": "これって注文できるんですよね？いや、いや、いや、"}, {"type": "subtitle", "time": 14944.71, "timestamp": "04:09:04", "text": "いや、いや。あなたはできません。あなたはできません。なぜ？あなた"}, {"type": "subtitle", "time": 14948.79, "timestamp": "04:09:08", "text": "できません。なぜ？十字架はなし。終わらせてください。あなた"}, {"type": "subtitle", "time": 14952.309, "timestamp": "04:09:12", "text": "努力しなければならない。ジョック。何てことだ。"}, {"type": "subtitle", "time": 14955.91, "timestamp": "04:09:15", "text": "これは無料ではありません。 sotrをクリックしてください。"}, {"type": "subtitle", "time": 14960.15, "timestamp": "04:09:20", "text": "それはどこですか？わかった。うん。うん。今、"}, {"type": "subtitle", "time": 14962.429, "timestamp": "04:09:22", "text": "クリックする"}, {"type": "subtitle", "time": 14966.309, "timestamp": "04:09:26", "text": "活動。底。底。底。"}, {"type": "subtitle", "time": 14967.59, "timestamp": "04:09:27", "text": "スクロールする必要はありません。ただそれは"}, {"type": "subtitle", "time": 14970.189, "timestamp": "04:09:30", "text": "まさにそこです。"}, {"type": "subtitle", "time": 14972.63, "timestamp": "04:09:32", "text": "活動。ああ、わかりました。あなたはそうする必要はありません"}, {"type": "subtitle", "time": 14975.11, "timestamp": "04:09:35", "text": "スクロール。いいえ、その活動ではありません。の"}, {"type": "subtitle", "time": 14977.349, "timestamp": "04:09:37", "text": "下部アクティビティ。"}, {"type": "subtitle", "time": 14980.79, "timestamp": "04:09:40", "text": "ああ、そうですね。さて、飛行隊がどのように"}, {"type": "subtitle", "time": 14984.15, "timestamp": "04:09:44", "text": "活動率は21%で、あなたの活動率はゼロです。"}, {"type": "subtitle", "time": 14985.51, "timestamp": "04:09:45", "text": "うん。"}, {"type": "subtitle", "time": 14987.91, "timestamp": "04:09:47", "text": "その下には、期間が"}, {"type": "subtitle", "time": 14991.11, "timestamp": "04:09:51", "text": "5月19日に終了します。"}, {"type": "subtitle", "time": 14993.349, "timestamp": "04:09:53", "text": "だから、私が"}, {"type": "subtitle", "time": 14996.07, "timestamp": "04:09:56", "text": "2日ごとにプレイすると本当に言ったでしょ"}, {"type": "subtitle", "time": 14998.229, "timestamp": "04:09:58", "text": "良い。あなたの飛行隊も本当に"}]
[{"type": "subtitle", "time": 12004.229, "timestamp": "03:20:04", "text": "えっと、ちょっと待って。ああ、そう、まさに"}, {"type": "subtitle", "time": 12006.389, "timestamp": "03:20:06", "text": "操作感は今、少し良くなったように感じます。うん。"}, {"type": "subtitle", "time": 12008.55, "timestamp": "03:20:08", "text": "うん。いろいろと手足をばたつかせても、"}, {"type": "subtitle", "time": 12009.83, "timestamp": "03:20:09", "text": "今あなたはかなりの重荷を背負っています"}, {"type": "subtitle", "time": 12012.55, "timestamp": "03:20:12", "text": "爆弾を再び取り除くために。どうやって"}, {"type": "subtitle", "time": 12015.07, "timestamp": "03:20:15", "text": "多くのものを取り除くために"}, {"type": "subtitle", "time": 12019.11, "timestamp": "03:20:19", "text": "爆弾。これら全てを取り除く方法。"}, {"type": "subtitle", "time": 12020.63, "timestamp": "03:20:20", "text": "ええ、それ用のボタンはありますが"}, {"type": "subtitle", "time": 12021.75, "timestamp": "03:20:21", "text": "もう一度、あなたは探しに行かなければなりません"}, {"type": "subtitle", "time": 12036.19, "timestamp": "03:20:36", "text": "それはいいです。あなたは苦労するでしょう"}, {"type": "subtitle", "time": 12038.469, "timestamp": "03:20:38", "text": "それ。離れる。カスタムでお見せします"}, {"type": "subtitle", "time": 12048.389, "timestamp": "03:20:48", "text": "さて、これから少し奇妙に感じるかもしれませんが、"}, {"type": "subtitle", "time": 12051.67, "timestamp": "03:20:51", "text": "プロペラ機に乗って、私は"}, {"type": "subtitle", "time": 12056.469, "timestamp": "03:20:56", "text": "まるで1990年代のジェット機のようだ。巨大な戦闘機。"}, {"type": "subtitle", "time": 12058.95, "timestamp": "03:20:58", "text": "おお、"}]
[{"type": "subtitle", "time": 1742.95, "timestamp": "00:29:02", "text": "えっと、新しいゲームは、ああ、そうですね。リポジトリ。私"}, {"type": "subtitle", "time": 1745.909, "timestamp": "00:29:05", "text": "試してみました。楽しいよ。"}, {"type": "subtitle", "time": 1749.909, "timestamp": "00:29:09", "text": "何だって？リポジトリ。議員か。ああ、そうだ。右。"}, {"type": "subtitle", "time": 1754.63, "timestamp": "00:29:14", "text": "うん。うん。それは恐ろしいゲームだ。"}, {"type": "subtitle", "time": 1764.549, "timestamp": "00:29:24", "text": "では、他に何があるだろうか？ちょうど今"}, {"type": "subtitle", "time": 1766.87, "timestamp": "00:29:26", "text": "Forzaを始めた。"}, {"type": "subtitle", "time": 1768.63, "timestamp": "00:29:28", "text": "おお"}, {"type": "subtitle", "time": 1772.149, "timestamp": "00:29:32", "text": "うん。過去2、3週間と同じように"}, {"type": "subtitle", "time": 1774.63, "timestamp": "00:29:34", "text": "10年以上ぶりに"}, {"type": "subtitle", "time": 1782.47, "timestamp": "00:29:42", "text": "ゲーム。他のレースゲームをプレイしたことがあるように"}, {"type": "subtitle", "time": 1784.07, "timestamp": "00:29:44", "text": "時々ゲームをするが、前回は"}, {"type": "subtitle", "time": 1787.11, "timestamp": "00:29:47", "text": "私は真面目に、きちんと演奏されるのが好きです"}, {"type": "subtitle", "time": 1790.11, "timestamp": "00:29:50", "text": "あるゲームは"}, {"type": "subtitle", "time": 1792.95, "timestamp": "00:29:52", "text": "レースは定期的に行われるように、ご存知のように私は"}, {"type": "subtitle", "time": 1795.909, "timestamp": "00:29:55", "text": "宗教を実践しているとか、そういうこと"}]
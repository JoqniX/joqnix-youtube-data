[{"type": "subtitle", "time": 8403.19, "timestamp": "02:20:03", "text": "では、"}, {"type": "subtitle", "time": 8406.07, "timestamp": "02:20:06", "text": "飛行機を選ぶと、"}, {"type": "subtitle", "time": 8408.07, "timestamp": "02:20:08", "text": "飛行機で過ごせる時間は限られています。そうではありません"}, {"type": "subtitle", "time": 8411.03, "timestamp": "02:20:11", "text": "時間制限なし。"}, {"type": "subtitle", "time": 8413.349, "timestamp": "02:20:13", "text": "50秒くらいしか時間がないよ。 50歳以内"}, {"type": "subtitle", "time": 8415.03, "timestamp": "02:20:15", "text": "数秒、何をするにしてもやらなければならない"}, {"type": "subtitle", "time": 8416.67, "timestamp": "02:20:16", "text": "そして送り返される"}, {"type": "subtitle", "time": 8419.469, "timestamp": "02:20:19", "text": "無制限にしたい場合は"}, {"type": "subtitle", "time": 8428.07, "timestamp": "02:20:28", "text": "うん。"}, {"type": "subtitle", "time": 8442.07, "timestamp": "02:20:42", "text": "あなたは何をしたいですか？あなたはしたい"}, {"type": "subtitle", "time": 8444.389, "timestamp": "02:20:44", "text": "戦車と飛行機を併用し続けるのか？"}, {"type": "subtitle", "time": 8446.95, "timestamp": "02:20:46", "text": "うん。"}, {"type": "subtitle", "time": 8449.99, "timestamp": "02:20:49", "text": "それでは、「準備完了」をクリックしてください。または、したい"}, {"type": "subtitle", "time": 8452.389, "timestamp": "02:20:52", "text": "飛行機。"}, {"type": "subtitle", "time": 8454.79, "timestamp": "02:20:54", "text": "どれか聞いていたんです。あなたは何を"}, {"type": "subtitle", "time": 8457.75, "timestamp": "02:20:57", "text": "何をしたいですか？わかった。飛行機。"}]
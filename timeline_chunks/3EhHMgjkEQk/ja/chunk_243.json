[{"type": "subtitle", "time": 14580.63, "timestamp": "04:03:00", "text": "つまり、それはただ楽しむためにできるということです。"}, {"type": "subtitle", "time": 14581.99, "timestamp": "04:03:01", "text": "他にすることがないから"}, {"type": "subtitle", "time": 14584.71, "timestamp": "04:03:04", "text": "または、操縦のためにそれを行うことができます"}, {"type": "subtitle", "time": 14589.51, "timestamp": "04:03:09", "text": "ミサイルとかそういうものから君を守る。"}, {"type": "subtitle", "time": 14591.79, "timestamp": "04:03:11", "text": "それは実際に効果があります。身体検査を受ける"}, {"type": "subtitle", "time": 14593.91, "timestamp": "04:03:13", "text": "物体は常にあなたを守ります"}, {"type": "subtitle", "time": 14596.03, "timestamp": "04:03:16", "text": "どのような方法であっても"}, {"type": "subtitle", "time": 14599.59, "timestamp": "04:03:19", "text": "他のプレイヤーの技術も優れている。"}, {"type": "subtitle", "time": 14611.91, "timestamp": "04:03:31", "text": "はい。"}, {"type": "subtitle", "time": 14613.469, "timestamp": "04:03:33", "text": "おお、"}, {"type": "subtitle", "time": 14616.79, "timestamp": "04:03:36", "text": "ニース。外。 2番。あなたは比較的外にいる"}, {"type": "subtitle", "time": 14621.91, "timestamp": "04:03:41", "text": "2つ目を選んでおくべきだった。"}, {"type": "subtitle", "time": 14627.91, "timestamp": "04:03:47", "text": "また、私があなたのすぐ後ろにいる場合、"}, {"type": "subtitle", "time": 14629.99, "timestamp": "04:03:49", "text": "目の前に、意味がない"}, {"type": "subtitle", "time": 14632.03, "timestamp": "04:03:52", "text": "なぜなら、"}, {"type": "subtitle", "time": 14635.189, "timestamp": "04:03:55", "text": "障害。ああ、"}]
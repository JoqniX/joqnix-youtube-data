[{"type": "subtitle", "time": 4261.51, "timestamp": "01:11:01", "text": "オンラインで食べ物や商品を購入できますか？めったに。そうですが、"}, {"type": "subtitle", "time": 4264.87, "timestamp": "01:11:04", "text": "めったに。ああ、なるほど。待って、何？"}, {"type": "subtitle", "time": 4266.63, "timestamp": "01:11:06", "text": "何が起こったのか？そうではないのですか？それは、"}, {"type": "subtitle", "time": 4269.669, "timestamp": "01:11:09", "text": "あなたは試合に参加していません。はい、忘れていました"}, {"type": "subtitle", "time": 4272.55, "timestamp": "01:11:12", "text": "「開始」をクリックしてください。よし、行こう。"}, {"type": "subtitle", "time": 4274.87, "timestamp": "01:11:14", "text": "ああ、そうそう。 21ポイント獲得できました"}, {"type": "subtitle", "time": 4277.35, "timestamp": "01:11:17", "text": "60点満点中、まるで"}, {"type": "subtitle", "time": 4281.27, "timestamp": "01:11:21", "text": "そこで遊んでください。それは確かに存在する。何てことだ。"}, {"type": "subtitle", "time": 4283.669, "timestamp": "01:11:23", "text": "うん。あなたがそこにいないと表示される場合"}, {"type": "subtitle", "time": 4286.55, "timestamp": "01:11:26", "text": "あるいは、それは何て言うんだっけ？"}, {"type": "subtitle", "time": 4288.149, "timestamp": "01:11:28", "text": "キーボードから離れると、"}, {"type": "subtitle", "time": 4290.229, "timestamp": "01:11:30", "text": "すぐに私に全てのポイントをください。"}, {"type": "subtitle", "time": 4291.99, "timestamp": "01:11:31", "text": "わかった。発砲禁止。あなたはただ渡るだけです"}, {"type": "subtitle", "time": 4293.59, "timestamp": "01:11:33", "text": "お互いに向き合って、それから始めます"}, {"type": "subtitle", "time": 4296.39, "timestamp": "01:11:36", "text": "ファインティング。わかった。"}, {"type": "subtitle", "time": 4298.47, "timestamp": "01:11:38", "text": "さて、着陸時以外のフラップと"}, {"type": "subtitle", "time": 4308.27, "timestamp": "01:11:48", "text": "そして試合開始。あなたは"}, {"type": "subtitle", "time": 4310.55, "timestamp": "01:11:50", "text": "私の目の前に、半透明の円がある。"}, {"type": "subtitle", "time": 4313.95, "timestamp": "01:11:53", "text": "それが、あなたが目指すべき円です。"}, {"type": "subtitle", "time": 4316.95, "timestamp": "01:11:56", "text": "うん。どうしてそんなに速く方向転換できるの？私は"}]
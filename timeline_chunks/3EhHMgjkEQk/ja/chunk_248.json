[{"type": "subtitle", "time": 14881.189, "timestamp": "04:08:01", "text": "また、会員にも開放されています。"}, {"type": "subtitle", "time": 14883.51, "timestamp": "04:08:03", "text": "飛行隊の問題は、"}, {"type": "subtitle", "time": 14885.189, "timestamp": "04:08:05", "text": "飛行隊の所有者は、支払わなければならない"}, {"type": "subtitle", "time": 14889.11, "timestamp": "04:08:09", "text": "飛行隊を存続させるための実際の資金。"}, {"type": "subtitle", "time": 14891.59, "timestamp": "04:08:11", "text": "ええと、私は基本的に正しいという意見をたくさん見かけます"}, {"type": "subtitle", "time": 14893.349, "timestamp": "04:08:13", "text": "今は中国人のタダ乗りをしている"}, {"type": "subtitle", "time": 14895.67, "timestamp": "04:08:15", "text": "お前。わからない。"}, {"type": "subtitle", "time": 14896.75, "timestamp": "04:08:16", "text": "ああ、"}, {"type": "subtitle", "time": 14899.67, "timestamp": "04:08:19", "text": "神。なぜ私のプライベートを取得すると表示されるのですか"}, {"type": "subtitle", "time": 14901.91, "timestamp": "04:08:21", "text": "見返りにデータ？でも、そうなのか、それとも"}, {"type": "subtitle", "time": 14903.59, "timestamp": "04:08:23", "text": "あなたは会員資格を満たしていません"}, {"type": "subtitle", "time": 14908.63, "timestamp": "04:08:28", "text": "チームの要件"}, {"type": "subtitle", "time": 14910.79, "timestamp": "04:08:30", "text": "そこには？彼らの中には厳格な"}, {"type": "subtitle", "time": 14911.91, "timestamp": "04:08:31", "text": "制限。中には、"}, {"type": "subtitle", "time": 14913.83, "timestamp": "04:08:33", "text": "「ああ、一緒に遊びたいの？ さあ、一緒に遊ぼうよ。」"}, {"type": "subtitle", "time": 14916.75, "timestamp": "04:08:36", "text": "彼らはただあなたを来させてくれるだけだ。"}, {"type": "subtitle", "time": 14919.349, "timestamp": "04:08:39", "text": "[音楽]"}, {"type": "subtitle", "time": 14923.03, "timestamp": "04:08:43", "text": "遵守要件とは何ですか？"}, {"type": "subtitle", "time": 14927.11, "timestamp": "04:08:47", "text": "わからない。私は何も持っていなかった。"}, {"type": "subtitle", "time": 14930.15, "timestamp": "04:08:50", "text": "わかった。何か試してみて。待って、君は"}, {"type": "subtitle", "time": 14933.269, "timestamp": "04:08:53", "text": "何か？私はそのアプリケーションを知っています。 SOT R。それは"}, {"type": "subtitle", "time": 14935.189, "timestamp": "04:08:55", "text": "現れる。一番上に表示されます。次はSOTRです"}, {"type": "subtitle", "time": 14938.87, "timestamp": "04:08:58", "text": "あなたの名前で。ああ、そうなら私はそうすべきだ"}]
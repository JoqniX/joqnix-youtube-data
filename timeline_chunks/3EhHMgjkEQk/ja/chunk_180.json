[{"type": "subtitle", "time": 10802.87, "timestamp": "03:00:02", "text": "船首に2本の線。"}, {"type": "subtitle", "time": 10805.349, "timestamp": "03:00:05", "text": "あなたが正しい。そう、それだよ。の"}, {"type": "chat", "time": 10807.207, "timestamp": "03:00:07", "author": "@Victor-MrinMoy", "avatar": "https://yt4.ggpht.com/Gaz0C79q_RG4g0C-14BlD7DV4KSkdqrEdWKhEr9EeavJEbCjSnvHS0Wd2lGovXii5XhBOCaWnQ=s64-c-k-c0x00ffffff-no-rj", "message": "Hello there"}, {"type": "subtitle", "time": 10807.429, "timestamp": "03:00:07", "text": "緑色の方向へ飛行機を向けてください。いや、いや、"}, {"type": "subtitle", "time": 10811.349, "timestamp": "03:00:11", "text": "緑。灰色の線。うん。"}, {"type": "subtitle", "time": 10813.99, "timestamp": "03:00:13", "text": "船の最前部。"}, {"type": "subtitle", "time": 10816.55, "timestamp": "03:00:16", "text": "列に並んでいますか？うん。例えばこれ。右"}, {"type": "subtitle", "time": 10819.03, "timestamp": "03:00:19", "text": "あなたの隣に。そんな感じ。うん。"}, {"type": "subtitle", "time": 10823.11, "timestamp": "03:00:23", "text": "そちらの方を向いてみてください、もしくはこちらへ。"}, {"type": "subtitle", "time": 10824.95, "timestamp": "03:00:24", "text": "近すぎて試せないもの"}, {"type": "subtitle", "time": 10827.269, "timestamp": "03:00:27", "text": "前方のそちらに向きを変えて"}, {"type": "subtitle", "time": 10833.75, "timestamp": "03:00:33", "text": "えっと、そのパワーをどうやって上げるんですか？"}, {"type": "subtitle", "time": 10835.349, "timestamp": "03:00:35", "text": "少しだけ飛行機を操縦して"}, {"type": "subtitle", "time": 10837.309, "timestamp": "03:00:37", "text": "車は"}, {"type": "subtitle", "time": 10847.429, "timestamp": "03:00:47", "text": "カメラは左から右へ。うん。右。"}, {"type": "subtitle", "time": 10850.59, "timestamp": "03:00:50", "text": "右。右。そうそうそう、"}, {"type": "subtitle", "time": 10853.19, "timestamp": "03:00:53", "text": "そうそう。もっと正しい、もっと正しい。"}, {"type": "subtitle", "time": 10855.91, "timestamp": "03:00:55", "text": "まったくその通りだ。ブレーキを踏んでください。ヒット"}, {"type": "subtitle", "time": 10858.309, "timestamp": "03:00:58", "text": "ブレーキ。ブレーキを踏んでください。その通りです。保つ"}]
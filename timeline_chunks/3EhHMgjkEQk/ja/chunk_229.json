[{"type": "subtitle", "time": 13748.229, "timestamp": "03:49:08", "text": "[拍手]"}, {"type": "subtitle", "time": 13754.87, "timestamp": "03:49:14", "text": "また。下に降りたいの？行けるよ"}, {"type": "subtitle", "time": 13763.75, "timestamp": "03:49:23", "text": "本当はもっとリアルに描くべきだった。私"}, {"type": "subtitle", "time": 13766.389, "timestamp": "03:49:26", "text": "無制限の推力を得られただろう"}, {"type": "subtitle", "time": 13769.91, "timestamp": "03:49:29", "text": "これ。それは何と呼ばれますか？ブースト"}, {"type": "subtitle", "time": 13771.99, "timestamp": "03:49:31", "text": "アーケードゲームのおかげで。ブーストが切れる"}, {"type": "subtitle", "time": 13795.349, "timestamp": "03:49:55", "text": "ああ、弾切れだ。"}, {"type": "subtitle", "time": 13799.469, "timestamp": "03:49:59", "text": "いいね。ちょうど私が近づいたとき"}]
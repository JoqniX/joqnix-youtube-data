[{"type": "subtitle", "time": 2882.109, "timestamp": "00:48:02", "text": "それは機能していません。始める。"}, {"type": "subtitle", "time": 2886.25, "timestamp": "00:48:06", "text": "適用する。よし、これでいい。あなたが見えてます。"}, {"type": "subtitle", "time": 2888.95, "timestamp": "00:48:08", "text": "[音楽]"}, {"type": "subtitle", "time": 2890.75, "timestamp": "00:48:10", "text": "何かご存知ですか？待って。"}, {"type": "subtitle", "time": 2898.39, "timestamp": "00:48:18", "text": "準備できましたか？準備は整いました。それで"}, {"type": "subtitle", "time": 2901.67, "timestamp": "00:48:21", "text": "一体どういうこと？ 「準備完了」をクリックします。おお"}, {"type": "subtitle", "time": 2903.79, "timestamp": "00:48:23", "text": "うん。うん。 「準備完了」をクリックしてください。"}, {"type": "subtitle", "time": 2914.87, "timestamp": "00:48:34", "text": "長い地図を選びました"}, {"type": "subtitle", "time": 2916.87, "timestamp": "00:48:36", "text": "通り。着陸したい場合は、"}, {"type": "subtitle", "time": 2919.51, "timestamp": "00:48:39", "text": "土地。"}, {"type": "subtitle", "time": 2922.43, "timestamp": "00:48:42", "text": "さて、問題はそれがうまくいったかどうかだ。"}, {"type": "subtitle", "time": 2925.069, "timestamp": "00:48:45", "text": "適切に、私たちが両方とも"}, {"type": "subtitle", "time": 2936.37, "timestamp": "00:48:56", "text": "きちんと。それは、えーと"}]
[{"type": "subtitle", "time": 4381.91, "timestamp": "01:13:01", "text": "カメラをロックするには、あなたをクリックしてください。私はしません"}, {"type": "subtitle", "time": 4384.229, "timestamp": "01:13:04", "text": "実際にカメラをあなたに固定します。教えてください"}, {"type": "subtitle", "time": 4386.95, "timestamp": "01:13:06", "text": "代わりにキーを使用してください。だって今何が起こっているか"}, {"type": "subtitle", "time": 4388.709, "timestamp": "01:13:08", "text": "起こることは、私たちどちらも"}, {"type": "subtitle", "time": 4390.55, "timestamp": "01:13:10", "text": "飛行機の調子がいいから、ショットを撮ろう"}, {"type": "subtitle", "time": 4401.59, "timestamp": "01:13:21", "text": "君がどうやって私を撃つのか見てみたい"}, {"type": "subtitle", "time": 4404.55, "timestamp": "01:13:24", "text": "方法。いいえ、あなたの飛行機の方がずっと良いですよ。"}, {"type": "subtitle", "time": 4406.149, "timestamp": "01:13:26", "text": "だから、実際に"}, {"type": "subtitle", "time": 4407.55, "timestamp": "01:13:27", "text": "後ろにつく"}, {"type": "subtitle", "time": 4419.75, "timestamp": "01:13:39", "text": "おお、"}, {"type": "subtitle", "time": 4422.55, "timestamp": "01:13:42", "text": "体当たりしてもいいですよ。ところで、"}, {"type": "subtitle", "time": 4423.83, "timestamp": "01:13:43", "text": "うっかりぶつかってしまう"}, {"type": "subtitle", "time": 4428.709, "timestamp": "01:13:48", "text": "それはチームメイトと一緒にやることができます"}, {"type": "subtitle", "time": 4431.11, "timestamp": "01:13:51", "text": "敵。そして航空機同士の戦闘では"}, {"type": "subtitle", "time": 4434.229, "timestamp": "01:13:54", "text": "特に、チームキルを行うことができます。"}, {"type": "subtitle", "time": 4437.55, "timestamp": "01:13:57", "text": "ああ、戦車戦では、"}]
[{"type": "subtitle", "time": 15003.75, "timestamp": "04:10:03", "text": "良い。活動メーターが上昇します"}, {"type": "subtitle", "time": 15006.229, "timestamp": "04:10:06", "text": "そしてあなたの活動報酬は"}, {"type": "subtitle", "time": 15007.75, "timestamp": "04:10:07", "text": "真ん中。"}, {"type": "subtitle", "time": 15009.83, "timestamp": "04:10:09", "text": "だから、もしあなたの飛行隊が本当に"}, {"type": "subtitle", "time": 15011.429, "timestamp": "04:10:11", "text": "よくやった、君は何もしていない、君は"}, {"type": "subtitle", "time": 15014.71, "timestamp": "04:10:14", "text": "何も得られないだろう。"}, {"type": "subtitle", "time": 15016.469, "timestamp": "04:10:16", "text": "あなたが本当に良い仕事をしていて、"}, {"type": "subtitle", "time": 15017.91, "timestamp": "04:10:17", "text": "あなたの飛行隊は十分なことをしていません。"}, {"type": "subtitle", "time": 15020.429, "timestamp": "04:10:20", "text": "報酬は減額されます"}, {"type": "subtitle", "time": 15023.349, "timestamp": "04:10:23", "text": "それ。あなたとあなたの飛行隊の両方が"}, {"type": "subtitle", "time": 15026.469, "timestamp": "04:10:26", "text": "本当にアクティブだと、18歳近くまで"}, {"type": "subtitle", "time": 15029.51, "timestamp": "04:10:29", "text": "2週間2日間で2万ドル、2週間2日間ではない"}, {"type": "subtitle", "time": 15031.269, "timestamp": "04:10:31", "text": "数週間。 2日ごとに18から"}, {"type": "subtitle", "time": 15033.83, "timestamp": "04:10:33", "text": "2万ドル。"}, {"type": "subtitle", "time": 15036.229, "timestamp": "04:10:36", "text": "さて、その18,000ドルから20,000ドルとは一体何でしょうか？これを渡ってください"}, {"type": "subtitle", "time": 15037.75, "timestamp": "04:10:37", "text": "外。"}, {"type": "subtitle", "time": 15039.55, "timestamp": "04:10:39", "text": "わかった。近い近い"}, {"type": "subtitle", "time": 15042.55, "timestamp": "04:10:42", "text": "これ。ああ、これで飛行隊が見える"}, {"type": "subtitle", "time": 15045.349, "timestamp": "04:10:45", "text": "下部の活動の隣に車両が配置されている。"}, {"type": "subtitle", "time": 15046.87, "timestamp": "04:10:46", "text": "そのボタンをクリックしてください。えーと、飛行隊"}, {"type": "subtitle", "time": 15049.67, "timestamp": "04:10:49", "text": "車両。うん。はい。選択しなければならない"}, {"type": "subtitle", "time": 15051.87, "timestamp": "04:10:51", "text": "これらのうちの1つ。今あなたは"}, {"type": "subtitle", "time": 15054.87, "timestamp": "04:10:54", "text": "A4Eが自動選択されました。"}, {"type": "subtitle", "time": 15056.71, "timestamp": "04:10:56", "text": "うん、"}]
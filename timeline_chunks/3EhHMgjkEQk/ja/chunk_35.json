[{"type": "subtitle", "time": 2103.03, "timestamp": "00:35:03", "text": "ああ、覚えてるよ、僕たちはプレイしたんだ、僕たちはプレイしたんだ"}, {"type": "subtitle", "time": 2111.829, "timestamp": "00:35:11", "text": "ええと、私の動きはスロットルに設定されています"}, {"type": "subtitle", "time": 2113.589, "timestamp": "00:35:13", "text": "軸。ほら、スクロールはあるけど"}, {"type": "subtitle", "time": 2116.39, "timestamp": "00:35:16", "text": "巻物と一緒に W と S または"}, {"type": "subtitle", "time": 2119.19, "timestamp": "00:35:19", "text": "多かれ少なかれ"}, {"type": "subtitle", "time": 2121.99, "timestamp": "00:35:21", "text": "そして、ロール軸はAだと思います。"}, {"type": "subtitle", "time": 2124.23, "timestamp": "00:35:24", "text": "D."}, {"type": "subtitle", "time": 2127.51, "timestamp": "00:35:27", "text": "ああ、もし現状のままにしておきたいなら"}, {"type": "subtitle", "time": 2130.39, "timestamp": "00:35:30", "text": "デフォルトでは、そうすることもできますし、"}, {"type": "subtitle", "time": 2133.87, "timestamp": "00:35:33", "text": "これを追加すると、"}, {"type": "subtitle", "time": 2136.47, "timestamp": "00:35:36", "text": "まあ、ほとんどの場合は"}, {"type": "subtitle", "time": 2138.47, "timestamp": "00:35:38", "text": "マウスで操作してください。指ささないで"}, {"type": "subtitle", "time": 2140.15, "timestamp": "00:35:40", "text": "下。下を指ささないでください。指さしすぎないでください"}, {"type": "subtitle", "time": 2141.91, "timestamp": "00:35:41", "text": "上。わかった。よし、これでいい。ああ、これでいい。"}, {"type": "subtitle", "time": 2144.91, "timestamp": "00:35:44", "text": "あなたは飛び立った。ああ、わかりました。今"}, {"type": "subtitle", "time": 2147.19, "timestamp": "00:35:47", "text": "押す えーと、押さなくてもいいですよ"}, {"type": "subtitle", "time": 2149.99, "timestamp": "00:35:49", "text": "何でも。フラップが上げられました。"}, {"type": "subtitle", "time": 2156.75, "timestamp": "00:35:56", "text": "何の過負荷ですか？"}]
[{"type": "subtitle", "time": 3540.23, "timestamp": "00:59:00", "text": "えっと、最初にダウンロードしたとき"}, {"type": "subtitle", "time": 3543.03, "timestamp": "00:59:03", "text": "128くらいだったけど、どうやら"}, {"type": "subtitle", "time": 3546.87, "timestamp": "00:59:06", "text": "HDグラフィックを有効にするには、DLCをオフにしてください。だからそれは"}, {"type": "subtitle", "time": 3555.43, "timestamp": "00:59:15", "text": "または、もっと"}, {"type": "subtitle", "time": 3558.549, "timestamp": "00:59:18", "text": "経済的な方法で、14GBも入手できます"}, {"type": "subtitle", "time": 3562.069, "timestamp": "00:59:22", "text": "15GB版"}, {"type": "chat", "time": 3563.466, "timestamp": "00:59:23", "author": "@soulofswords", "avatar": "https://yt4.ggpht.com/N5UGOOCkqJY6i3x846X2nx9EjZpP3SAIdAeuPAjxPPdNLWmO1Oi53_c__BkFrKVpJqviVQ07=s64-c-k-c0x00ffffff-no-rj", "message": "150gb in total ?"}, {"type": "subtitle", "time": 3564.47, "timestamp": "00:59:24", "text": "これは、より限定的な意味で"}, {"type": "subtitle", "time": 3566.15, "timestamp": "00:59:26", "text": "グラフィックは"}, {"type": "subtitle", "time": 3566.829, "timestamp": "00:59:26", "text": "全体"}, {"type": "subtitle", "time": 3570.549, "timestamp": "00:59:30", "text": "ゲーム。うん。"}, {"type": "subtitle", "time": 3580.39, "timestamp": "00:59:40", "text": "それで、新しいものを買うってどんな感じ？"}, {"type": "chat", "time": 3581.964, "timestamp": "00:59:41", "author": "@soulofswords", "avatar": "https://yt4.ggpht.com/N5UGOOCkqJY6i3x846X2nx9EjZpP3SAIdAeuPAjxPPdNLWmO1Oi53_c__BkFrKVpJqviVQ07=s64-c-k-c0x00ffffff-no-rj", "message": "less than Forza horizon 5 then"}, {"type": "subtitle", "time": 3583.43, "timestamp": "00:59:43", "text": "船とか、そういうもの、それだけ。船、飛行機。"}, {"type": "subtitle", "time": 3587.51, "timestamp": "00:59:47", "text": "そして車両。レベルアップする"}, {"type": "subtitle", "time": 3590.39, "timestamp": "00:59:50", "text": "そして、あなたが楽しめる場所を見つけます"}, {"type": "subtitle", "time": 3593.51, "timestamp": "00:59:53", "text": "ゲームプレイのほとんど"}, {"type": "subtitle", "time": 3595.51, "timestamp": "00:59:55", "text": "そしてそこに留まるか、"}, {"type": "subtitle", "time": 3597.589, "timestamp": "00:59:57", "text": "新しいものを手に入れるためにレベルアップする"}]
[{"type": "subtitle", "time": 10320.95, "timestamp": "02:52:00", "text": "他にも見ることができるものがあります"}, {"type": "subtitle", "time": 10323.349, "timestamp": "02:52:03", "text": "そして、それはわかるが、"}, {"type": "subtitle", "time": 10325.91, "timestamp": "02:52:05", "text": "一般的には、もしあなたがそうでないなら"}, {"type": "subtitle", "time": 10328.389, "timestamp": "02:52:08", "text": "いつも飛行機や船に夢中で、"}, {"type": "subtitle", "time": 10329.99, "timestamp": "02:52:09", "text": "飛行機が着陸できるかどうかを判断する最も簡単な方法"}, {"type": "subtitle", "time": 10332.66, "timestamp": "02:52:12", "text": "船上では、"}, {"type": "subtitle", "time": 10340.63, "timestamp": "02:52:20", "text": "これで、航空機が手に入るはずです。"}, {"type": "subtitle", "time": 10357.03, "timestamp": "02:52:37", "text": "ああ、君は踊れるね。あ、すみません。ボップ。あなたはできる"}, {"type": "subtitle", "time": 10359.429, "timestamp": "02:52:39", "text": "爆弾を落としたいならどうぞ"}, {"type": "subtitle", "time": 10365.03, "timestamp": "02:52:45", "text": "また、爆撃機としても機能します。だから、その方法は"}, {"type": "subtitle", "time": 10368.309, "timestamp": "02:52:48", "text": "現代のジェット機は、人々が行くロックです"}, {"type": "subtitle", "time": 10370.71, "timestamp": "02:52:50", "text": "爆撃機の製造をやめろ。ファイターは"}, {"type": "subtitle", "time": 10374.07, "timestamp": "02:52:54", "text": "基本的に、今すぐ全てを済ませてください。"}, {"type": "subtitle", "time": 10377.19, "timestamp": "02:52:57", "text": "爆撃とは宇宙だ。別々に見ることができます"}, {"type": "subtitle", "time": 10379.11, "timestamp": "02:52:59", "text": "カーソルは地面にあります。そのカーソルには"}]
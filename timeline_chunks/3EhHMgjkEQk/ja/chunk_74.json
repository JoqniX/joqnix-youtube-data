[{"type": "subtitle", "time": 4440.07, "timestamp": "01:14:00", "text": "それ。ゲームではそれが許されないんです。"}, {"type": "subtitle", "time": 4442.55, "timestamp": "01:14:02", "text": "しかし、航空機の試合では、私は"}, {"type": "subtitle", "time": 4443.95, "timestamp": "01:14:03", "text": "感覚を想像する"}, {"type": "subtitle", "time": 4446.55, "timestamp": "01:14:06", "text": "現実ではチームキルはできるが、"}, {"type": "subtitle", "time": 4449.35, "timestamp": "01:14:09", "text": "それには重い罰則が科せられる。"}, {"type": "subtitle", "time": 4455.59, "timestamp": "01:14:15", "text": "ああ、結局その人の代金を支払うことになる"}, {"type": "subtitle", "time": 4459.07, "timestamp": "01:14:19", "text": "飛行機の修理は、ちなみに"}, {"type": "subtitle", "time": 4462.07, "timestamp": "01:14:22", "text": "War Thunderで戦うとき、"}, {"type": "subtitle", "time": 4465.27, "timestamp": "01:14:25", "text": "あなたはロビーに戻ります。"}, {"type": "subtitle", "time": 4467.59, "timestamp": "01:14:27", "text": "戦闘で飛行機が損傷した場合、"}, {"type": "subtitle", "time": 4470.55, "timestamp": "01:14:30", "text": "修理費用を"}, {"type": "subtitle", "time": 4477.51, "timestamp": "01:14:37", "text": "あ、待って。私の修理。"}, {"type": "subtitle", "time": 4479.669, "timestamp": "01:14:39", "text": "うん。だから、あなたがそこから得たお金は"}, {"type": "subtitle", "time": 4481.75, "timestamp": "01:14:41", "text": "試合。"}, {"type": "subtitle", "time": 4485.51, "timestamp": "01:14:45", "text": "うん。あなたはそれを失う。いくらか失う"}, {"type": "subtitle", "time": 4488.39, "timestamp": "01:14:48", "text": "修理中。試合に勝てば、"}, {"type": "subtitle", "time": 4495.91, "timestamp": "01:14:55", "text": "おお。試合に負けた場合、"}]
[{"type": "subtitle", "time": 1800.149, "timestamp": "00:30:00", "text": "あれは『ロード・ラッシュ』だった。"}, {"type": "subtitle", "time": 1803.029, "timestamp": "00:30:03", "text": "ああ、そうそう、ロード・リデンプションがもうそこにあるよ。私"}, {"type": "subtitle", "time": 1805.47, "timestamp": "00:30:05", "text": "最近プレイしました。このゲームがある"}, {"type": "subtitle", "time": 1808.87, "timestamp": "00:30:08", "text": "「ロード・リデンプション」と呼ばれる。"}, {"type": "subtitle", "time": 1811.029, "timestamp": "00:30:11", "text": "ああ、それは、"}, {"type": "subtitle", "time": 1813.99, "timestamp": "00:30:13", "text": "『ロード・ラッシュ』の続編ですよね？"}, {"type": "subtitle", "time": 1815.669, "timestamp": "00:30:15", "text": "うん。"}, {"type": "subtitle", "time": 1820.31, "timestamp": "00:30:20", "text": "比較的。良いと聞いていたが、"}, {"type": "subtitle", "time": 1824.149, "timestamp": "00:30:24", "text": "ロード・ラッシュがやったようなことは、私にはできなかっただろう。"}, {"type": "subtitle", "time": 1834.47, "timestamp": "00:30:34", "text": "とても楽しいです。今でも覚えている。私は"}, {"type": "subtitle", "time": 1837.909, "timestamp": "00:30:37", "text": "何時間でもプレイしたくなる。"}, {"type": "subtitle", "time": 1840.149, "timestamp": "00:30:40", "text": "ああ、私はそれすら持っていませんでした。私たちは以前は"}, {"type": "subtitle", "time": 1843.269, "timestamp": "00:30:43", "text": "私の建物に子供がいたんです"}, {"type": "subtitle", "time": 1845.19, "timestamp": "00:30:45", "text": "1階にいた人か"}, {"type": "subtitle", "time": 1847.11, "timestamp": "00:30:47", "text": "何か。"}, {"type": "subtitle", "time": 1849.11, "timestamp": "00:30:49", "text": "私たちは皆、彼の家に遊びに行っていた"}, {"type": "subtitle", "time": 1852.71, "timestamp": "00:30:52", "text": "父親のパソコンでロードラッシュをプレイ"}, {"type": "subtitle", "time": 1859.59, "timestamp": "00:30:59", "text": "ほら、私たちの親の時代みたいに"}]
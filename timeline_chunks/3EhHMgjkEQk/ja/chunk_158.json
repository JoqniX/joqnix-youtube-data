[{"type": "subtitle", "time": 9481.59, "timestamp": "02:38:01", "text": "別の車両。"}, {"type": "subtitle", "time": 9483.99, "timestamp": "02:38:03", "text": "さて、今回始まるイベントは"}, {"type": "subtitle", "time": 9488.15, "timestamp": "02:38:08", "text": "来週の5月22日か24日に"}, {"type": "subtitle", "time": 9490.15, "timestamp": "02:38:10", "text": "その出来事はなかなか興味深い。あなた"}, {"type": "subtitle", "time": 9491.99, "timestamp": "02:38:11", "text": "熱心に取り組めば、"}, {"type": "subtitle", "time": 9497.19, "timestamp": "02:38:17", "text": "欲しい。わかった。そのイベントは、車両です"}, {"type": "subtitle", "time": 9499.349, "timestamp": "02:38:19", "text": "その場合に割り当てられるもの"}, {"type": "subtitle", "time": 9501.87, "timestamp": "02:38:21", "text": "もしあなたがそのイベントで成功すれば、それはインドの"}, {"type": "subtitle", "time": 9503.55, "timestamp": "02:38:23", "text": "初め"}, {"type": "subtitle", "time": 9505.91, "timestamp": "02:38:25", "text": "自作機は超音速のはず"}, {"type": "subtitle", "time": 9507.91, "timestamp": "02:38:27", "text": "戦闘機。"}, {"type": "subtitle", "time": 9510.95, "timestamp": "02:38:30", "text": "待って、彼らは実際に最新のテクノロジーを追加している"}, {"type": "subtitle", "time": 9513.79, "timestamp": "02:38:33", "text": "同じように。最新版ではありません。それは"}, {"type": "subtitle", "time": 9517.67, "timestamp": "02:38:37", "text": "1960年代。おお。それで、私たちは航空機を持っていて"}, {"type": "subtitle", "time": 9521.03, "timestamp": "02:38:41", "text": "インドで製造され、"}, {"type": "subtitle", "time": 9523.27, "timestamp": "02:38:43", "text": "インド。私たちは他の誰からもそれを買わなかった"}, {"type": "subtitle", "time": 9526.63, "timestamp": "02:38:46", "text": "1960年代の国。"}, {"type": "subtitle", "time": 9529.99, "timestamp": "02:38:49", "text": "ああ、彼らはその飛行機を"}, {"type": "subtitle", "time": 9532.87, "timestamp": "02:38:52", "text": "イベントプレーン。"}, {"type": "subtitle", "time": 9535.99, "timestamp": "02:38:55", "text": "ああ、じゃあ2の全部をやれば"}, {"type": "subtitle", "time": 9537.59, "timestamp": "02:38:57", "text": "日、2 日、2 日、2 日で 2 日"}, {"type": "subtitle", "time": 9539.11, "timestamp": "02:38:59", "text": "数週間で、その飛行機を無料で手に入れることができます"}]
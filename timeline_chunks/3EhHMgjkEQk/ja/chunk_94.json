[{"type": "subtitle", "time": 5640.07, "timestamp": "01:34:00", "text": "ミサイルはゲームをプレイして"}, {"type": "subtitle", "time": 5642.07, "timestamp": "01:34:02", "text": "ロックを解除してください。ご存知のとおり、私は"}, {"type": "subtitle", "time": 5644.07, "timestamp": "01:34:04", "text": "株を手に入れることについて教えてくれた"}, {"type": "subtitle", "time": 5645.35, "timestamp": "01:34:05", "text": "飛行機のバージョンと、"}, {"type": "subtitle", "time": 5647.99, "timestamp": "01:34:07", "text": "アップグレードしてください。"}, {"type": "subtitle", "time": 5656.709, "timestamp": "01:34:16", "text": "それ。これでどちらでも服用できます"}, {"type": "subtitle", "time": 5681.03, "timestamp": "01:34:41", "text": "ああ、弾切れだ。わかった、"}, {"type": "subtitle", "time": 5687.83, "timestamp": "01:34:47", "text": "行く。ニース。ニース。つまり、こうして"}, {"type": "subtitle", "time": 5691.91, "timestamp": "01:34:51", "text": "それはまさに現実的な戦闘となるだろう。えっと、"}, {"type": "subtitle", "time": 5694.629, "timestamp": "01:34:54", "text": "あれを現実的な戦闘とは言えないでしょう。それで"}, {"type": "subtitle", "time": 5696.709, "timestamp": "01:34:56", "text": "ゲームモードの観点から言えば、War Thunderは"}, {"type": "subtitle", "time": 5699.11, "timestamp": "01:34:59", "text": "3つのゲームモードがあります。もしあなたが言うなら"}]
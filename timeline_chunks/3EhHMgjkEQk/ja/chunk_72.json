[{"type": "subtitle", "time": 4320.149, "timestamp": "01:12:00", "text": "君を見ているのが好き。カメラはありますか？"}, {"type": "subtitle", "time": 4321.99, "timestamp": "01:12:01", "text": "もの？君のほうがもっと良い飛行機を持っているのは知っているよ"}, {"type": "subtitle", "time": 4326.149, "timestamp": "01:12:06", "text": "私よりも。私はレベル100です。"}, {"type": "subtitle", "time": 4327.229, "timestamp": "01:12:07", "text": "レベル"}, {"type": "subtitle", "time": 4331.51, "timestamp": "01:12:11", "text": "100？何？パイロットみたいに？"}, {"type": "subtitle", "time": 4333.75, "timestamp": "01:12:13", "text": "おい。はい、私はレベル100です"}, {"type": "subtitle", "time": 4336.149, "timestamp": "01:12:16", "text": "私はプレイヤーなので、飛行方法を知っている。見る、"}, {"type": "subtitle", "time": 4338.07, "timestamp": "01:12:18", "text": "技術的には、あなたはより速く回転しています"}, {"type": "subtitle", "time": 4349.709, "timestamp": "01:12:29", "text": "おお。なんてことだ。これは何ですか"}, {"type": "subtitle", "time": 4353.83, "timestamp": "01:12:33", "text": "動き？これはプロエト運動です。"}, {"type": "subtitle", "time": 4355.669, "timestamp": "01:12:35", "text": "はい、そうです。そういうことです"}, {"type": "subtitle", "time": 4358.55, "timestamp": "01:12:38", "text": "第一次世界大戦では、空中戦が実際に起こった。"}, {"type": "subtitle", "time": 4361.43, "timestamp": "01:12:41", "text": "あなたは私の友人であり、栄光を追体験している"}, {"type": "subtitle", "time": 4364.31, "timestamp": "01:12:44", "text": "犬同士の喧嘩。"}, {"type": "subtitle", "time": 4366.149, "timestamp": "01:12:46", "text": "どこにいるの？ロックする方法はありますか？"}, {"type": "subtitle", "time": 4368.31, "timestamp": "01:12:48", "text": "カメラはお持ちですか？"}, {"type": "subtitle", "time": 4369.75, "timestamp": "01:12:49", "text": "ええ、ありますが、あなたはしたくないでしょう"}, {"type": "subtitle", "time": 4372.709, "timestamp": "01:12:52", "text": "それはあなたを混乱させるからです"}, {"type": "subtitle", "time": 4378.87, "timestamp": "01:12:58", "text": "飛行機。私は基本的にただ回転し続けるだけです"}]
[{"type": "subtitle", "time": 14102.229, "timestamp": "03:55:02", "text": "水に恋をする方法。"}, {"type": "subtitle", "time": 14121.11, "timestamp": "03:55:21", "text": "では、とても簡単に説明しましょう。"}, {"type": "subtitle", "time": 14124.429, "timestamp": "03:55:24", "text": "遠くまで飛行機で行く必要はありません"}, {"type": "subtitle", "time": 14127.349, "timestamp": "03:55:27", "text": "スポーン地点から。"}, {"type": "subtitle", "time": 14129.83, "timestamp": "03:55:29", "text": "M. 待って、これは待って、あなたは"}, {"type": "subtitle", "time": 14131.27, "timestamp": "03:55:31", "text": "別の国。"}, {"type": "subtitle", "time": 14133.03, "timestamp": "03:55:33", "text": "[音楽]"}, {"type": "subtitle", "time": 14134.87, "timestamp": "03:55:34", "text": "どういう意味ですか？別の国"}, {"type": "subtitle", "time": 14137.11, "timestamp": "03:55:37", "text": "原産国飛行機か、それとも日本のような飛行機か？うん。"}, {"type": "subtitle", "time": 14139.03, "timestamp": "03:55:39", "text": "ええ、私のはソ連製です。あなたの"}, {"type": "subtitle", "time": 14141.59, "timestamp": "03:55:41", "text": "日本語。私のはソ連製です。"}, {"type": "subtitle", "time": 14145.67, "timestamp": "03:55:45", "text": "ああ、それはロシア海軍のものですね。"}, {"type": "subtitle", "time": 14147.83, "timestamp": "03:55:47", "text": "わかった。わかった。では、"}, {"type": "subtitle", "time": 14151.269, "timestamp": "03:55:51", "text": "私がそれを手に入れるために？派閥に参加して"}, {"type": "subtitle", "time": 14154.469, "timestamp": "03:55:54", "text": "飛行隊に参加する"}, {"type": "subtitle", "time": 14156.389, "timestamp": "03:55:56", "text": "人々が入ってくることを許可する。本当に"}, {"type": "subtitle", "time": 14157.75, "timestamp": "03:55:57", "text": "地面に近い。別のミサイルは"}]
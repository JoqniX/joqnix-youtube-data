[{"type": "subtitle", "time": 3360.87, "timestamp": "00:56:00", "text": "ねずみ、"}, {"type": "subtitle", "time": 3362.51, "timestamp": "00:56:02", "text": "えっと、私は持っていますか"}, {"type": "subtitle", "time": 3364.43, "timestamp": "00:56:04", "text": "に"}, {"type": "subtitle", "time": 3369.19, "timestamp": "00:56:09", "text": "えっと、WD？いいえ。ええと、そうでもないです。 MBSDは"}, {"type": "subtitle", "time": 3372.789, "timestamp": "00:56:12", "text": "良い銃のように"}, {"type": "subtitle", "time": 3385.67, "timestamp": "00:56:25", "text": "おお。私たちは本当に80のアクロバットをやっています。"}, {"type": "subtitle", "time": 3395.43, "timestamp": "00:56:35", "text": "燃料が尽きないなんて、最高だね。"}, {"type": "subtitle", "time": 3399.349, "timestamp": "00:56:39", "text": "なんてこった。そうです。上。"}, {"type": "subtitle", "time": 3401.75, "timestamp": "00:56:41", "text": "私たちは使用しています"}, {"type": "subtitle", "time": 3404.63, "timestamp": "00:56:44", "text": "チャットでSにも送ってください。ええと、私たちはVを使用しています"}, {"type": "subtitle", "time": 3409.03, "timestamp": "00:56:49", "text": "富士の模型を展示するための忍者。"}, {"type": "subtitle", "time": 3411.91, "timestamp": "00:56:51", "text": "うん。いかがですか？とても美味しいです。"}, {"type": "subtitle", "time": 3414.39, "timestamp": "00:56:54", "text": "私が自分のモデルを披露するのは今回で2回目です。"}, {"type": "subtitle", "time": 3417.589, "timestamp": "00:56:57", "text": "または、私のモーフを使用しました。"}]
[{"type": "subtitle", "time": 15240.79, "timestamp": "04:14:00", "text": "支払いのために行った。いいえ、していません。私はただ"}, {"type": "subtitle", "time": 15243.51, "timestamp": "04:14:03", "text": "彼は偽ゲーマーだ。私はただ"}, {"type": "subtitle", "time": 15246.469, "timestamp": "04:14:06", "text": "それを見た。"}, {"type": "subtitle", "time": 15248.07, "timestamp": "04:14:08", "text": "あなたはそれをより注意深く見た"}, {"type": "chat", "time": 15248.714, "timestamp": "04:14:08", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "ayyyy"}, {"type": "subtitle", "time": 15250.07, "timestamp": "04:14:10", "text": "あなたが他の何を見ても、それよりもまた、"}, {"type": "subtitle", "time": 15251.99, "timestamp": "04:14:11", "text": "私は他のすべての場面であなたを指導しなければなりませんでした"}, {"type": "chat", "time": 15253.791, "timestamp": "04:14:13", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "dont buy it"}, {"type": "subtitle", "time": 15254.07, "timestamp": "04:14:14", "text": "ポップアップ。私はあなたにどこへ行くべきか教えていない"}, {"type": "subtitle", "time": 15257.83, "timestamp": "04:14:17", "text": "購入品を確認してください。"}, {"type": "subtitle", "time": 15263.11, "timestamp": "04:14:23", "text": "何てことだ。露出。偽ゲーマーが暴かれた。"}, {"type": "subtitle", "time": 15265.67, "timestamp": "04:14:25", "text": "何てことだ。"}, {"type": "subtitle", "time": 15266.83, "timestamp": "04:14:26", "text": "いいえ、ただ"}, {"type": "subtitle", "time": 15269.99, "timestamp": "04:14:29", "text": "冗談だよ。つまり、ゴールデンイーグルは高級品ということだ。"}, {"type": "subtitle", "time": 15271.67, "timestamp": "04:14:31", "text": "プレミアムアカウントというものがある"}, {"type": "subtitle", "time": 15274.55, "timestamp": "04:14:34", "text": "プレミアムアカウントを購入できる場所と"}, {"type": "subtitle", "time": 15277.189, "timestamp": "04:14:37", "text": "すると、試合ごとに2倍の報酬が得られます"}, {"type": "subtitle", "time": 15281.51, "timestamp": "04:14:41", "text": "お金と標準の2倍の経験値。"}, {"type": "subtitle", "time": 15283.349, "timestamp": "04:14:43", "text": "それはどちらかというとプレミアムサブスクリプションに近いですね"}, {"type": "subtitle", "time": 15285.91, "timestamp": "04:14:45", "text": "Amazonの定期購入のようなものだ。"}, {"type": "subtitle", "time": 15289.59, "timestamp": "04:14:49", "text": "そうそう。そして、次のようなものもあります。"}, {"type": "subtitle", "time": 15291.91, "timestamp": "04:14:51", "text": "プレミアム飛行機を直接購入することもできますし、"}, {"type": "subtitle", "time": 15293.75, "timestamp": "04:14:53", "text": "プレミアムパッケージを購入すると、"}, {"type": "subtitle", "time": 15296.389, "timestamp": "04:14:56", "text": "パッケージの中に複数のものが入っている。その"}, {"type": "subtitle", "time": 15298.63, "timestamp": "04:14:58", "text": "バンドル販売"}]
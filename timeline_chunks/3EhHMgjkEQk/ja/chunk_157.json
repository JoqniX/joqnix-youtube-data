[{"type": "subtitle", "time": 9421.429, "timestamp": "02:37:01", "text": "無料で飛行隊に参加することで、戦争"}, {"type": "subtitle", "time": 9423.51, "timestamp": "02:37:03", "text": "サンダーもこういうことをする"}, {"type": "subtitle", "time": 9426.389, "timestamp": "02:37:06", "text": "彼らはイベントを開催し、イベント用の車両も製作している。"}, {"type": "subtitle", "time": 9429.349, "timestamp": "02:37:09", "text": "さて、次のイベントは数日後に開催されます。"}, {"type": "subtitle", "time": 9433.19, "timestamp": "02:37:13", "text": "日。来週から始まります"}, {"type": "subtitle", "time": 9437.349, "timestamp": "02:37:17", "text": "そしてそれは確か2週間続いたと思います。"}, {"type": "subtitle", "time": 9440.55, "timestamp": "02:37:20", "text": "さて、その２週間で２日ごとに"}, {"type": "subtitle", "time": 9442.79, "timestamp": "02:37:22", "text": "War Thunderをプレイしなければならない"}, {"type": "subtitle", "time": 9446.23, "timestamp": "02:37:26", "text": "経験値バーを満たすのに必要な量。"}, {"type": "subtitle", "time": 9447.83, "timestamp": "02:37:27", "text": "聖なる。"}, {"type": "subtitle", "time": 9451.27, "timestamp": "02:37:31", "text": "そして最低限の基準に達する必要がある"}, {"type": "subtitle", "time": 9453.83, "timestamp": "02:37:33", "text": "合格点を取れるようなものだと分かっている。の"}, {"type": "subtitle", "time": 9458.87, "timestamp": "02:37:38", "text": "合格点は80％から90％くらいです。"}, {"type": "subtitle", "time": 9461.11, "timestamp": "02:37:41", "text": "だから2日ごとにプレイしなければならない"}, {"type": "subtitle", "time": 9464.55, "timestamp": "02:37:44", "text": "そのハードルに到達し、それを超えるのに十分な力。"}, {"type": "subtitle", "time": 9470.87, "timestamp": "02:37:50", "text": "回数、つまり16日間くらいなので"}, {"type": "subtitle", "time": 9473.389, "timestamp": "02:37:53", "text": "2日ちょっと、2日"}, {"type": "subtitle", "time": 9477.349, "timestamp": "02:37:57", "text": "数週間後、イベント車両が手に入ります"}, {"type": "subtitle", "time": 9479.51, "timestamp": "02:37:59", "text": "WANがそれを発表するたびに、"}]
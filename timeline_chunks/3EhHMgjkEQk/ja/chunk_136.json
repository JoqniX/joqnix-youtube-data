[{"type": "subtitle", "time": 8167.27, "timestamp": "02:16:07", "text": "B. 少し注意する必要があるのは、人々は"}, {"type": "subtitle", "time": 8170.189, "timestamp": "02:16:10", "text": "隙間から撃ち込む"}, {"type": "subtitle", "time": 8184.35, "timestamp": "02:16:24", "text": "おっと、エンジンが"}, {"type": "subtitle", "time": 8188.149, "timestamp": "02:16:28", "text": "ショット。ですから、あなたも修理を手伝うことができます。それで、"}, {"type": "subtitle", "time": 8196.389, "timestamp": "02:16:36", "text": "待って、私には修理できない。ああ、大丈夫ですよ。"}, {"type": "subtitle", "time": 8198.11, "timestamp": "02:16:38", "text": "その"}, {"type": "subtitle", "time": 8201.27, "timestamp": "02:16:41", "text": "まあ、いいでしょう。新型戦車。ああ、私たちは"}, {"type": "subtitle", "time": 8203.19, "timestamp": "02:16:43", "text": "死んだ。私たちは死んだ。私たちは死んだ。私たちはとても"}, {"type": "subtitle", "time": 8206.15, "timestamp": "02:16:46", "text": "死んだ。爆弾。"}, {"type": "subtitle", "time": 8207.99, "timestamp": "02:16:47", "text": "おお、"}, {"type": "subtitle", "time": 8210.549, "timestamp": "02:16:50", "text": "うん。その音と、その前に落ちてきたもの"}, {"type": "subtitle", "time": 8213.19, "timestamp": "02:16:53", "text": "君は最高だった。"}]
[{"type": "subtitle", "time": 5820.629, "timestamp": "01:37:00", "text": "そうすれば、飛行機を手に入れることができます。"}, {"type": "subtitle", "time": 5822.39, "timestamp": "01:37:02", "text": "一般的にプレミアムに閉じ込められている"}, {"type": "subtitle", "time": 5824.709, "timestamp": "01:37:04", "text": "技術ツリーを無料で入手できます。"}, {"type": "subtitle", "time": 5826.79, "timestamp": "01:37:06", "text": "つまり、プロペラ機から"}, {"type": "subtitle", "time": 5829.189, "timestamp": "01:37:09", "text": "飛行機からジェット機へ直行"}, {"type": "subtitle", "time": 5831.75, "timestamp": "01:37:11", "text": "ミサイル発射。"}, {"type": "subtitle", "time": 5833.35, "timestamp": "01:37:13", "text": "ああ、わかりました。わかった。だから、あなたが"}, {"type": "subtitle", "time": 5835.109, "timestamp": "01:37:15", "text": "今すぐチェックアウトするのは私のお気に入りの一つです"}, {"type": "subtitle", "time": 5837.43, "timestamp": "01:37:17", "text": "1つ。"}, {"type": "subtitle", "time": 5838.87, "timestamp": "01:37:18", "text": "あなたが持っていた青い尖ったもの"}, {"type": "subtitle", "time": 5841.27, "timestamp": "01:37:21", "text": "チェック中。うん。だから、そのバーが"}, {"type": "subtitle", "time": 5843.51, "timestamp": "01:37:23", "text": "それは55万です。"}, {"type": "subtitle", "time": 5845.51, "timestamp": "01:37:25", "text": "はい。はい。それは、"}, {"type": "subtitle", "time": 5846.87, "timestamp": "01:37:26", "text": "飛行隊に加わる。あなたはそうする必要はありません"}, {"type": "subtitle", "time": 5849.51, "timestamp": "01:37:29", "text": "実際のお金を支払う必要はありません。"}, {"type": "subtitle", "time": 5853.75, "timestamp": "01:37:33", "text": "ああ、大きな赤が見える"}, {"type": "subtitle", "time": 5856.709, "timestamp": "01:37:36", "text": "右下の数字。うん。"}, {"type": "subtitle", "time": 5858.31, "timestamp": "01:37:38", "text": "それはあなたが必要とする金額です"}, {"type": "subtitle", "time": 5861.27, "timestamp": "01:37:41", "text": "飛行機をアンロックしたら購入してください。"}, {"type": "subtitle", "time": 5864.87, "timestamp": "01:37:44", "text": "待って、飛行機を買わなければならない"}, {"type": "subtitle", "time": 5867.109, "timestamp": "01:37:47", "text": "ええ、まずロックを解除してから"}, {"type": "subtitle", "time": 5869.669, "timestamp": "01:37:49", "text": "それを買うためにお金を使う。ではなぜ私は"}, {"type": "subtitle", "time": 5872.87, "timestamp": "01:37:52", "text": "飛行隊編成をしているのですか？"}, {"type": "subtitle", "time": 5875.59, "timestamp": "01:37:55", "text": "なぜならそれが一番簡単な方法だから"}, {"type": "subtitle", "time": 5878.31, "timestamp": "01:37:58", "text": "ミサイル搭載のジェット機を手に入れる。の"}]
[{"type": "subtitle", "time": 12667.389, "timestamp": "03:31:07", "text": "始める。"}, {"type": "subtitle", "time": 12670.15, "timestamp": "03:31:10", "text": "適用する。準備ができて。"}, {"type": "subtitle", "time": 12676.71, "timestamp": "03:31:16", "text": "今度こそ上手くいくはずだ。私は"}, {"type": "subtitle", "time": 12678.75, "timestamp": "03:31:18", "text": "ある種のショー"}, {"type": "subtitle", "time": 12681.79, "timestamp": "03:31:21", "text": "圧倒的なプレッシャー、"}, {"type": "subtitle", "time": 12684.229, "timestamp": "03:31:24", "text": "でも、私は持っていなかったことを忘れていました"}, {"type": "subtitle", "time": 12693.59, "timestamp": "03:31:33", "text": "私はまず悪い飛行機に乗ります、なぜならそれは"}, {"type": "subtitle", "time": 12696.55, "timestamp": "03:31:36", "text": "どうせ殺されるんだから。"}, {"type": "subtitle", "time": 12698.07, "timestamp": "03:31:38", "text": "ああ、飛行機を全部使えるよ"}, {"type": "subtitle", "time": 12699.429, "timestamp": "03:31:39", "text": "私に対して。近づくことはできない"}, {"type": "subtitle", "time": 12707.95, "timestamp": "03:31:47", "text": "H. では、"}, {"type": "subtitle", "time": 12710.87, "timestamp": "03:31:50", "text": "ジェット機に対抗できる唯一のチャンスは"}, {"type": "subtitle", "time": 12712.95, "timestamp": "03:31:52", "text": "プロペラは、本当に低い位置を保っていれば"}, {"type": "subtitle", "time": 12715.11, "timestamp": "03:31:55", "text": "地上、もしあなたが都市部にいるなら"}, {"type": "subtitle", "time": 12716.469, "timestamp": "03:31:56", "text": "常に"}, {"type": "subtitle", "time": 12718.389, "timestamp": "03:31:58", "text": "ブロックするもの"}]
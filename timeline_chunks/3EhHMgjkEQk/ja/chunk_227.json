[{"type": "subtitle", "time": 13629.03, "timestamp": "03:47:09", "text": "ゲームプレイ。はい、とても簡単にしました"}, {"type": "subtitle", "time": 13642.309, "timestamp": "03:47:22", "text": "さて、私は何をすべきか教えられなかった"}, {"type": "subtitle", "time": 13644.79, "timestamp": "03:47:24", "text": "銃が尽きた。一つだけ"}, {"type": "subtitle", "time": 13652.389, "timestamp": "03:47:32", "text": "ああ、なるほど。墜落しなければならない"}, {"type": "subtitle", "time": 13654.309, "timestamp": "03:47:34", "text": "私に任せて。"}, {"type": "subtitle", "time": 13657.269, "timestamp": "03:47:37", "text": "何？いや、それは大変な作業になるよ。なぜ"}, {"type": "subtitle", "time": 13658.99, "timestamp": "03:47:38", "text": "私は何をしたいだろうか"}, {"type": "subtitle", "time": 13664.15, "timestamp": "03:47:44", "text": "それ？えっと、それはできません。いいえ。"}, {"type": "subtitle", "time": 13666.269, "timestamp": "03:47:46", "text": "右。機能していません"}, {"type": "subtitle", "time": 13668.79, "timestamp": "03:47:48", "text": "その通り。私は間違ったボタンを使っています。私は必要としている"}, {"type": "subtitle", "time": 13670.51, "timestamp": "03:47:50", "text": "私のスピードを得るために"}, {"type": "subtitle", "time": 13677.429, "timestamp": "03:47:57", "text": "あなた。あと5年間は銃を持っていません"}]
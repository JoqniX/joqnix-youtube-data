[{"type": "subtitle", "time": 4802.229, "timestamp": "01:20:02", "text": "わあ、これにはたくさんの要素がある"}, {"type": "subtitle", "time": 4805.83, "timestamp": "01:20:05", "text": "ゲーム。泣きたくなる。"}, {"type": "subtitle", "time": 4808.229, "timestamp": "01:20:08", "text": "ああ、なんてことだ、修正機能がある。"}, {"type": "subtitle", "time": 4811.189, "timestamp": "01:20:11", "text": "これは何ですか？うん。"}, {"type": "subtitle", "time": 4813.11, "timestamp": "01:20:13", "text": "ラジエーター、コンプレッサー、これらはすべて部品です"}, {"type": "subtitle", "time": 4816.229, "timestamp": "01:20:16", "text": "飛行機の。"}, {"type": "subtitle", "time": 4818.55, "timestamp": "01:20:18", "text": "ああ、無料で調べられますよ。あなた"}, {"type": "subtitle", "time": 4820.229, "timestamp": "01:20:20", "text": "一度に調査できるのは1つだけです。それで、"}, {"type": "subtitle", "time": 4822.229, "timestamp": "01:20:22", "text": "今はただ飛び回っているだけです"}, {"type": "subtitle", "time": 4824.149, "timestamp": "01:20:24", "text": "どれか1つをクリックして、"}, {"type": "subtitle", "time": 4826.39, "timestamp": "01:20:26", "text": "なれ。バーが見えますか？各"}, {"type": "subtitle", "time": 4828.35, "timestamp": "01:20:28", "text": "四角。うん。ごめん。"}, {"type": "subtitle", "time": 4830.87, "timestamp": "01:20:30", "text": "長方形のバーが満たされると、"}, {"type": "subtitle", "time": 4833.59, "timestamp": "01:20:33", "text": "購入できます。"}, {"type": "subtitle", "time": 4837.35, "timestamp": "01:20:37", "text": "ああ、研究シンボルは電球になった"}, {"type": "subtitle", "time": 4839.83, "timestamp": "01:20:39", "text": "そしてお金のシンボルは銀色のライオンです"}, {"type": "subtitle", "time": 4842.87, "timestamp": "01:20:42", "text": "エンブレム。ああ、銀色のライオンが見えるだろう"}, {"type": "subtitle", "time": 4845.99, "timestamp": "01:20:45", "text": "上部にエンブレム。うん。あなたは56,000を持っています"}, {"type": "subtitle", "time": 4855.27, "timestamp": "01:20:55", "text": "私は金持ちなのか、それとも大金持ちなのか？"}, {"type": "subtitle", "time": 4858.709, "timestamp": "01:20:58", "text": "あなたは初心者レベルです。"}]
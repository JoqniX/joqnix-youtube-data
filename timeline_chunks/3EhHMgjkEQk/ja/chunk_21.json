[{"type": "subtitle", "time": 1276.31, "timestamp": "00:21:16", "text": "準備不足で痛みが増す。しかし"}, {"type": "subtitle", "time": 1280.549, "timestamp": "00:21:20", "text": "えっと、ちょっと待ってください。完全に"}, {"type": "subtitle", "time": 1282.27, "timestamp": "00:21:22", "text": "忘れてた"}, {"type": "subtitle", "time": 1287.43, "timestamp": "00:21:27", "text": "まだそれを見せる予定はないんです。"}, {"type": "subtitle", "time": 1300.87, "timestamp": "00:21:40", "text": "こんにちは、ファジー。"}, {"type": "subtitle", "time": 1304.63, "timestamp": "00:21:44", "text": "ええ、今なら私の声が聞こえるでしょう。うん。"}, {"type": "subtitle", "time": 1313.51, "timestamp": "00:21:53", "text": "私は自分が"}, {"type": "subtitle", "time": 1315.99, "timestamp": "00:21:55", "text": "待っている間にゲームをテストしています"}, {"type": "subtitle", "time": 1318.07, "timestamp": "00:21:58", "text": "あなたのために。私は自分がしなければならないことを完全に忘れていました"}]
[{"type": "subtitle", "time": 1680.149, "timestamp": "00:28:00", "text": "「ワンダ？」うん。"}, {"type": "subtitle", "time": 1683.83, "timestamp": "00:28:03", "text": "私は自動車保険の担当者のような存在になるでしょう。"}, {"type": "subtitle", "time": 1685.669, "timestamp": "00:28:05", "text": "少しお話するお時間ありますか？"}, {"type": "subtitle", "time": 1692.07, "timestamp": "00:28:12", "text": "そして私はただあちこちで嫌がらせをするだけです"}, {"type": "subtitle", "time": 1694.149, "timestamp": "00:28:14", "text": "みんなそうしてるよ。そして一度"}, {"type": "subtitle", "time": 1697.31, "timestamp": "00:28:17", "text": "6ヶ月ごとに返信してください。"}, {"type": "subtitle", "time": 1702.71, "timestamp": "00:28:22", "text": "富士山の何々。あれこれあれこれ。"}, {"type": "subtitle", "time": 1706.549, "timestamp": "00:28:26", "text": "何てことだ。うん。"}, {"type": "subtitle", "time": 1708.75, "timestamp": "00:28:28", "text": "ああ、"}, {"type": "subtitle", "time": 1711.75, "timestamp": "00:28:31", "text": "神。私は少し考えなければならなかった。何"}, {"type": "subtitle", "time": 1713.669, "timestamp": "00:28:33", "text": "何を言うべきか？私は何も言えません"}, {"type": "subtitle", "time": 1716.389, "timestamp": "00:28:36", "text": "ジョンが私に連絡してくる理由。何をすればいいですか"}, {"type": "subtitle", "time": 1718.549, "timestamp": "00:28:38", "text": "言う？"}, {"type": "subtitle", "time": 1727.44, "timestamp": "00:28:47", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 1729.83, "timestamp": "00:28:49", "text": "[音楽]"}, {"type": "subtitle", "time": 1731.83, "timestamp": "00:28:51", "text": "新しいゲームにハマった？"}, {"type": "subtitle", "time": 1734.23, "timestamp": "00:28:54", "text": "最近楽しんだものは何ですか？"}]
[{"type": "subtitle", "time": 8942.63, "timestamp": "02:29:02", "text": "それで、彼は先に私たちに発砲しようとしたんです。それ"}, {"type": "subtitle", "time": 8945.51, "timestamp": "02:29:05", "text": "うまくいかなかった。それで、彼は私たちに体当たりしようとしたんです。もし"}, {"type": "subtitle", "time": 8947.75, "timestamp": "02:29:07", "text": "相手にぶつかると、"}, {"type": "subtitle", "time": 8950.15, "timestamp": "02:29:10", "text": "チームキルとして表示されない。それは"}, {"type": "subtitle", "time": 8963.79, "timestamp": "02:29:23", "text": "どこ？ああ、わかりました。さあ行こう。"}, {"type": "subtitle", "time": 8972.469, "timestamp": "02:29:32", "text": "ニムロド。ニムロッドは非常に象徴的な"}, {"type": "subtitle", "time": 8975.99, "timestamp": "02:29:35", "text": "最初の、まあ、半ばニューエイジ"}, {"type": "subtitle", "time": 8978.309, "timestamp": "02:29:38", "text": "イギリスの飛行機。"}, {"type": "subtitle", "time": 8999.03, "timestamp": "02:29:59", "text": "彼。素晴らしいチームワークだ。そして、我々は既に勝利を収めた。"}]
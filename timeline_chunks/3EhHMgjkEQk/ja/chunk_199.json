[{"type": "subtitle", "time": 11947.91, "timestamp": "03:19:07", "text": "操縦。エンジンを元に戻すことができます"}, {"type": "subtitle", "time": 11950.349, "timestamp": "03:19:10", "text": "の上。保管する必要はありません"}, {"type": "subtitle", "time": 11952.63, "timestamp": "03:19:12", "text": "オフ。エンジンをかけるように言ったばかりだよ"}, {"type": "subtitle", "time": 11953.91, "timestamp": "03:19:13", "text": "オフにするのは、"}, {"type": "subtitle", "time": 11955.07, "timestamp": "03:19:15", "text": "スピード"}, {"type": "subtitle", "time": 11964.229, "timestamp": "03:19:24", "text": "私は"}, {"type": "subtitle", "time": 11972.75, "timestamp": "03:19:32", "text": "では、待ってください。これをもう一度クリックすると、"}, {"type": "subtitle", "time": 11977.19, "timestamp": "03:19:37", "text": "オフ。もっと毅然とした態度を取らなければならないよね？の"}, {"type": "subtitle", "time": 11980.59, "timestamp": "03:19:40", "text": "支配力が強まる。それを回すと"}, {"type": "subtitle", "time": 11984.55, "timestamp": "03:19:44", "text": "オンにすると、コントロールがはるかに鈍くなる。"}, {"type": "subtitle", "time": 11994.15, "timestamp": "03:19:54", "text": "もし理解に苦労しているなら"}, {"type": "subtitle", "time": 11996.07, "timestamp": "03:19:56", "text": "外に出れば、カスタムバトルに参加できます。私はできる"}]
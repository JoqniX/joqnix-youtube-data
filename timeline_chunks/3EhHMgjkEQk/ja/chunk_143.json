[{"type": "subtitle", "time": 8583.469, "timestamp": "02:23:03", "text": "おやつ。ジョックは忙しいんです。私は"}, {"type": "subtitle", "time": 8590.469, "timestamp": "02:23:10", "text": "タマネギ。おやつに何を食べようとも、"}, {"type": "subtitle", "time": 8611.75, "timestamp": "02:23:31", "text": "Twitchのチャットが見えないかもしれません。"}, {"type": "subtitle", "time": 8615.91, "timestamp": "02:23:35", "text": "ああ、君はゲームに酒好きを参加させたいんだね。ジョック、"}, {"type": "subtitle", "time": 8619.11, "timestamp": "02:23:39", "text": "早く戻ってきてください。私は"}, {"type": "subtitle", "time": 8638.389, "timestamp": "02:23:58", "text": "あ、待って。 Yが離陸する。ええ、私は"}]
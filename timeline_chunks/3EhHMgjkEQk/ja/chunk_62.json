[{"type": "subtitle", "time": 3720.549, "timestamp": "01:02:00", "text": "銃をカチカチ鳴らす、まるで"}, {"type": "subtitle", "time": 3722.91, "timestamp": "01:02:02", "text": "常に押すと、"}, {"type": "subtitle", "time": 3731.829, "timestamp": "01:02:11", "text": "では、何かやってみよう。あなたはまっすぐ飛ぶ。"}, {"type": "subtitle", "time": 3733.67, "timestamp": "01:02:13", "text": "ゲームの流れを説明しましょう"}, {"type": "chat", "time": 3736.332, "timestamp": "01:02:16", "author": "@soulofswords", "avatar": "https://yt4.ggpht.com/N5UGOOCkqJY6i3x846X2nx9EjZpP3SAIdAeuPAjxPPdNLWmO1Oi53_c__BkFrKVpJqviVQ07=s64-c-k-c0x00ffffff-no-rj", "message": "fuji u also play world of warships ?"}, {"type": "subtitle", "time": 3743.23, "timestamp": "01:02:23", "text": "わかった。これでわかる"}, {"type": "subtitle", "time": 3746.23, "timestamp": "01:02:26", "text": "外側の大きな円、そして"}, {"type": "subtitle", "time": 3748.549, "timestamp": "01:02:28", "text": "内側の輪はもっと小さいですよね？あなたのより大きな"}, {"type": "subtitle", "time": 3751.27, "timestamp": "01:02:31", "text": "丸はマウスです。"}, {"type": "subtitle", "time": 3753.589, "timestamp": "01:02:33", "text": "あなたの外側の内輪は銃がある場所です"}, {"type": "subtitle", "time": 3755.99, "timestamp": "01:02:35", "text": "発砲すれば弾丸を発射します。火"}, {"type": "subtitle", "time": 3758.47, "timestamp": "01:02:38", "text": "若干。どのように一致するかがわかりますか"}, {"type": "subtitle", "time": 3761.19, "timestamp": "01:02:41", "text": "点のある内側の円？ええ、"}, {"type": "subtitle", "time": 3764.71, "timestamp": "01:02:44", "text": "十字線。うん。はい、クロスエアです。おお、"}, {"type": "subtitle", "time": 3766.309, "timestamp": "01:02:46", "text": "あなたの視覚的な感覚は少し違うようですね"}, {"type": "subtitle", "time": 3769.549, "timestamp": "01:02:49", "text": "私のものより。さて、それが"}, {"type": "subtitle", "time": 3772.789, "timestamp": "01:02:52", "text": "何が起こったか、それを押して、押し続けて"}, {"type": "subtitle", "time": 3775.789, "timestamp": "01:02:55", "text": "あなたの銃"}, {"type": "subtitle", "time": 3779.19, "timestamp": "01:02:59", "text": "発射、絶えず発射して見る"}]
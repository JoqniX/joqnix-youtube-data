[{"type": "subtitle", "time": 9244.55, "timestamp": "02:34:04", "text": "スウェーデンには他にどんな飛行機がありますか？"}, {"type": "subtitle", "time": 9246.67, "timestamp": "02:34:06", "text": "スウェーデン。私"}, {"type": "subtitle", "time": 9253.95, "timestamp": "02:34:13", "text": "待って、J。最初のやつ。"}, {"type": "subtitle", "time": 9267.51, "timestamp": "02:34:27", "text": "ああ、わかりました。ええ、あなたは何も持っていません"}, {"type": "subtitle", "time": 9269.07, "timestamp": "02:34:29", "text": "爆撃の"}, {"type": "subtitle", "time": 9272.11, "timestamp": "02:34:32", "text": "航空機。そうですね、"}, {"type": "subtitle", "time": 9274.469, "timestamp": "02:34:34", "text": "研究。調査が終わったら、"}, {"type": "subtitle", "time": 9276.55, "timestamp": "02:34:36", "text": "そうすれば爆撃を開始できる。それはとても楽しい"}, {"type": "subtitle", "time": 9278.63, "timestamp": "02:34:38", "text": "同じように。"}, {"type": "subtitle", "time": 9281.11, "timestamp": "02:34:41", "text": "ああ、君が参加しているからもっと楽しいよ"}, {"type": "subtitle", "time": 9283.19, "timestamp": "02:34:43", "text": "競争社会で、あなたはいつも"}, {"type": "subtitle", "time": 9285.67, "timestamp": "02:34:45", "text": "逃げているネズミ、隠れているネズミ、"}, {"type": "subtitle", "time": 9286.71, "timestamp": "02:34:46", "text": "爆撃して、それから行く"}, {"type": "subtitle", "time": 9289.429, "timestamp": "02:34:49", "text": "基地に戻る。では、私は"}, {"type": "subtitle", "time": 9292.71, "timestamp": "02:34:52", "text": "魚雷って、どの爆撃機のこと？前回と同じように"}, {"type": "subtitle", "time": 9296.07, "timestamp": "02:34:56", "text": "最後から1番目か、最後から2番目？"}, {"type": "subtitle", "time": 9299.67, "timestamp": "02:34:59", "text": "スウェーデン版で？ええ、日本では"}]
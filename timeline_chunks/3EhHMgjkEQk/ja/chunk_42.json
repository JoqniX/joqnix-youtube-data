[{"type": "subtitle", "time": 2522.79, "timestamp": "00:42:02", "text": "全員そうする。むしろこうだ"}, {"type": "subtitle", "time": 2525.19, "timestamp": "00:42:05", "text": "お好きなものを何でも、そしてその上に"}, {"type": "subtitle", "time": 2527.77, "timestamp": "00:42:07", "text": "他のことは、あなたができることなら何でもやってみなさい。"}, {"type": "subtitle", "time": 2529.43, "timestamp": "00:42:09", "text": "[音楽]"}, {"type": "subtitle", "time": 2531.19, "timestamp": "00:42:11", "text": "一般的には、それはただ努力しているだけです"}, {"type": "subtitle", "time": 2533.589, "timestamp": "00:42:13", "text": "すべてを手に入れ、"}, {"type": "subtitle", "time": 2536.15, "timestamp": "00:42:16", "text": "一般的に、それでも人々は与える傾向がある"}, {"type": "subtitle", "time": 2539.15, "timestamp": "00:42:19", "text": "起きて、えっと"}, {"type": "subtitle", "time": 2544.55, "timestamp": "00:42:24", "text": "有料版を入手する、といった感じです。"}, {"type": "subtitle", "time": 2550.39, "timestamp": "00:42:30", "text": "待つ価値は最後にある"}, {"type": "subtitle", "time": 2553.67, "timestamp": "00:42:33", "text": "日。はい。じゃあ、このゲームは"}, {"type": "subtitle", "time": 2557.99, "timestamp": "00:42:37", "text": "あれって、実際の飛行装備？"}, {"type": "subtitle", "time": 2560.63, "timestamp": "00:42:40", "text": "実際にシミュレーターモードがあります"}, {"type": "subtitle", "time": 2563.43, "timestamp": "00:42:43", "text": "これはお勧めしません。なぜなら私の"}, {"type": "subtitle", "time": 2566.79, "timestamp": "00:42:46", "text": "War Thunderをプレイする私の人生"}, {"type": "subtitle", "time": 2570.79, "timestamp": "00:42:50", "text": "ああ、フライトコントロールのチュートリアルがあるよ"}, {"type": "subtitle", "time": 2574.15, "timestamp": "00:42:54", "text": "2回か3回。チュートリアルがあります"}, {"type": "subtitle", "time": 2576.79, "timestamp": "00:42:56", "text": "飛行とは、飛行機を操縦するようなものだ。私はすべきでしょうか"}]
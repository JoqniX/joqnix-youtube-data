[{"type": "subtitle", "time": 12843.269, "timestamp": "03:34:03", "text": "わかった。ああ、わかった。今、これが上がっているのが見えますか？"}, {"type": "subtitle", "time": 12850.309, "timestamp": "03:34:10", "text": "何？探しています。ああ、私はまだかなり"}, {"type": "subtitle", "time": 12853.91, "timestamp": "03:34:13", "text": "決して大丈夫とは言えない。一体どういうことだ？"}, {"type": "subtitle", "time": 12856.55, "timestamp": "03:34:16", "text": "それは描画距離でもあります。ああ、なるほど。"}, {"type": "subtitle", "time": 12859.429, "timestamp": "03:34:19", "text": "何か気になることがあったよね？待って、"}, {"type": "subtitle", "time": 12862.07, "timestamp": "03:34:22", "text": "どうしたの？"}, {"type": "subtitle", "time": 12865.59, "timestamp": "03:34:25", "text": "クラッシュとか、そういう感じ。墜落現場はどこ？"}, {"type": "subtitle", "time": 12867.03, "timestamp": "03:34:27", "text": "ああ、いや、いや、いや、いや。偶然見た"}, {"type": "subtitle", "time": 12869.75, "timestamp": "03:34:29", "text": "あなたの昔の配信。まあ、とにかく。"}, {"type": "subtitle", "time": 12873.349, "timestamp": "03:34:33", "text": "待って。だから、上を見上げてごらん。あなたが見えてます。分かりますか"}, {"type": "subtitle", "time": 12876.63, "timestamp": "03:34:36", "text": "自分？うん、もうすぐだ。だから私は"}, {"type": "subtitle", "time": 12880.63, "timestamp": "03:34:40", "text": "だいたい3kmくらい離れたところですよね？"}, {"type": "subtitle", "time": 12883.99, "timestamp": "03:34:43", "text": "3～4km離れた場所。あなたを連れ出すことができます"}, {"type": "subtitle", "time": 12886.95, "timestamp": "03:34:46", "text": "この範囲の2倍または3倍以上"}, {"type": "subtitle", "time": 12890.95, "timestamp": "03:34:50", "text": "銃一本で簡単にできる。いいえ、私の"}, {"type": "subtitle", "time": 12892.55, "timestamp": "03:34:52", "text": "ミサイル。"}, {"type": "chat", "time": 12893.839, "timestamp": "03:34:53", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "we see da fuji"}, {"type": "subtitle", "time": 12894.95, "timestamp": "03:34:54", "text": "お前を撃つこともできるぞ。私は5キロほど離れたところにいます"}, {"type": "subtitle", "time": 12896.55, "timestamp": "03:34:56", "text": "あなたからですよね？私はあなたを撃つことができます"}, {"type": "subtitle", "time": 12899.349, "timestamp": "03:34:59", "text": "35キロ離れています。"}]
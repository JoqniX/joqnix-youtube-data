[{"type": "subtitle", "time": 5464.629, "timestamp": "01:31:04", "text": "わあ、そうだったんですね。それがあなたの最初の"}, {"type": "subtitle", "time": 5466.83, "timestamp": "01:31:06", "text": "ミサイル撃墜。"}, {"type": "subtitle", "time": 5470.149, "timestamp": "01:31:10", "text": "うわ、本当に死んでしまった。殺させてください"}, {"type": "subtitle", "time": 5473.59, "timestamp": "01:31:13", "text": "パイロットは安全のためだけに操縦する。それは違う"}, {"type": "subtitle", "time": 5475.59, "timestamp": "01:31:15", "text": "それは本当に壁犯罪です。そして"}, {"type": "subtitle", "time": 5476.95, "timestamp": "01:31:16", "text": "あれはパイロットではない。パイロットは"}, {"type": "subtitle", "time": 5479.669, "timestamp": "01:31:19", "text": "あなたの上に。待って、これは一体何？おお、"}, {"type": "subtitle", "time": 5483.51, "timestamp": "01:31:23", "text": "それは確かに存在する。わかった。 A できない"}, {"type": "subtitle", "time": 5486.79, "timestamp": "01:31:26", "text": "ゲームの中でのそれ。それは許可しません。"}, {"type": "subtitle", "time": 5490.07, "timestamp": "01:31:30", "text": "どうしてわかるのかって？私に聞かないでください。えーと、"}, {"type": "subtitle", "time": 5494.87, "timestamp": "01:31:34", "text": "現実世界では、それは戦争犯罪だ。そうなの？はい。"}, {"type": "subtitle", "time": 5496.629, "timestamp": "01:31:36", "text": "あなたは、パイロットを撃つことはできません"}, {"type": "subtitle", "time": 5498.629, "timestamp": "01:31:38", "text": "追い出された。"}, {"type": "subtitle", "time": 5500.55, "timestamp": "01:31:40", "text": "おお。"}, {"type": "subtitle", "time": 5502.79, "timestamp": "01:31:42", "text": "それは戦争犯罪です"}, {"type": "subtitle", "time": 5505.189, "timestamp": "01:31:45", "text": "第二次世界大戦前か何かだったと思う。戦争"}, {"type": "subtitle", "time": 5508.07, "timestamp": "01:31:48", "text": "犯罪、つまりそれは不可能だという意味です。のように"}, {"type": "subtitle", "time": 5510.39, "timestamp": "01:31:50", "text": "そうすべきではありません。あなたは警備員のような存在になるでしょう。"}, {"type": "subtitle", "time": 5513.51, "timestamp": "01:31:53", "text": "まあ、それは戦争における法律のようなものだ。とても"}, {"type": "subtitle", "time": 5516.87, "timestamp": "01:31:56", "text": "十分にあり得る。それは違法です。の"}]
[{"type": "subtitle", "time": 9363.19, "timestamp": "02:36:03", "text": "使い方を覚えれば簡単だよ"}, {"type": "subtitle", "time": 9364.349, "timestamp": "02:36:04", "text": "金儲け"}, {"type": "subtitle", "time": 9367.67, "timestamp": "02:36:07", "text": "スキーム。敵を避けるだけでいい"}, {"type": "subtitle", "time": 9370.95, "timestamp": "02:36:10", "text": "飛行機で突入して爆撃すればいい、"}, {"type": "subtitle", "time": 9373.75, "timestamp": "02:36:13", "text": "戻ってきて、突入して、爆撃して、戻ってきて。あなた"}, {"type": "subtitle", "time": 9376.87, "timestamp": "02:36:16", "text": "いくらかお金を稼いだ。楽しいゲームプレイではない。"}, {"type": "subtitle", "time": 9378.95, "timestamp": "02:36:18", "text": "それは、あなたが行こうとしているようなものです"}, {"type": "subtitle", "time": 9380.71, "timestamp": "02:36:20", "text": "他の飛行機のために、"}, {"type": "subtitle", "time": 9383.13, "timestamp": "02:36:23", "text": "別の飛行機を買うためにお金を稼ぐ。"}, {"type": "subtitle", "time": 9384.469, "timestamp": "02:36:24", "text": "[音楽]"}, {"type": "subtitle", "time": 9386.63, "timestamp": "02:36:26", "text": "爆撃機を使うんだ。"}, {"type": "subtitle", "time": 9389.83, "timestamp": "02:36:29", "text": "このゲームは無料のゴールドをくれるの？"}, {"type": "subtitle", "time": 9392.79, "timestamp": "02:36:32", "text": "コイン、プレミアム通貨？"}, {"type": "subtitle", "time": 9395.99, "timestamp": "02:36:35", "text": "いいえ。イベント中とか？あなた、あなた"}, {"type": "subtitle", "time": 9399.429, "timestamp": "02:36:39", "text": "最初にいくつか手に入れれば、"}, {"type": "subtitle", "time": 9401.309, "timestamp": "02:36:41", "text": "状況によっては"}, {"type": "subtitle", "time": 9403.75, "timestamp": "02:36:43", "text": "イベントだけど、ちょっとクレイジーなことをしないといけない"}, {"type": "subtitle", "time": 9405.349, "timestamp": "02:36:45", "text": "それに対する作業レベル。もう一度言いますが、"}, {"type": "subtitle", "time": 9406.79, "timestamp": "02:36:46", "text": "戦争以外の人生があることを忘れる"}, {"type": "subtitle", "time": 9410.07, "timestamp": "02:36:50", "text": "それには雷がふさわしい。"}, {"type": "subtitle", "time": 9413.83, "timestamp": "02:36:53", "text": "聖なる主よ。例えば、それら以外にも"}, {"type": "subtitle", "time": 9416.389, "timestamp": "02:36:56", "text": "緑色の高級航空機と戦車"}, {"type": "subtitle", "time": 9418.55, "timestamp": "02:36:58", "text": "手に入れることができる"}]
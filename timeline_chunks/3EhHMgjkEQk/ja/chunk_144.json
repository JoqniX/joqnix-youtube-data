[{"type": "subtitle", "time": 8641.03, "timestamp": "02:24:01", "text": "ここ。私はここにいます。彼はただ必要としていただけだと思う"}, {"type": "subtitle", "time": 8643.67, "timestamp": "02:24:03", "text": "ミュートする。マイクは実際に演奏している。わかった。"}, {"type": "subtitle", "time": 8653.99, "timestamp": "02:24:13", "text": "待って、待って、待って。すでに"}, {"type": "subtitle", "time": 8656.87, "timestamp": "02:24:16", "text": "味方を殺そうとしている人がいる。"}, {"type": "subtitle", "time": 8677.67, "timestamp": "02:24:37", "text": "待って、どういうわけかジョックの声が聞こえない"}, {"type": "subtitle", "time": 8680.59, "timestamp": "02:24:40", "text": "まったく。待って、なぜ聞こえないの？"}, {"type": "subtitle", "time": 8684.23, "timestamp": "02:24:44", "text": "自分？こんにちは。"}, {"type": "subtitle", "time": 8686.27, "timestamp": "02:24:46", "text": "だめよ、ジョー、彼と戦っちゃだめ。彼は私たちの"}, {"type": "subtitle", "time": 8688.27, "timestamp": "02:24:48", "text": "チームメイト。彼は"}, {"type": "subtitle", "time": 8699.55, "timestamp": "02:24:59", "text": "それ。私は燃料用の湖を持っています。私はしなければならない"}]
[{"type": "subtitle", "time": 12540.63, "timestamp": "03:29:00", "text": "ミサイルはあなたのいる場所に発射されます。"}, {"type": "subtitle", "time": 12542.79, "timestamp": "03:29:02", "text": "おお。だから飛行機の向きを固定する必要がある"}, {"type": "subtitle", "time": 12545.83, "timestamp": "03:29:05", "text": "ミサイルが命中するまで、あなたの飛行機を狙って攻撃を続けます。"}, {"type": "subtitle", "time": 12548.79, "timestamp": "03:29:08", "text": "それが一つ目です。"}, {"type": "subtitle", "time": 12550.429, "timestamp": "03:29:10", "text": "もう一つ"}, {"type": "subtitle", "time": 12554.19, "timestamp": "03:29:14", "text": "1つは私が撮影する場所です"}, {"type": "subtitle", "time": 12556.55, "timestamp": "03:29:16", "text": "ミサイル。数秒後、"}, {"type": "subtitle", "time": 12558.95, "timestamp": "03:29:18", "text": "ミサイルには独自のレーダーが搭載されており、"}, {"type": "subtitle", "time": 12561.03, "timestamp": "03:29:21", "text": "そして8人が十分に近づくと"}, {"type": "subtitle", "time": 12563.11, "timestamp": "03:29:23", "text": "またね。だから、私は"}, {"type": "subtitle", "time": 12565.269, "timestamp": "03:29:25", "text": "あなたを指差しています。私はただ撃つだけで、"}, {"type": "subtitle", "time": 12567.91, "timestamp": "03:29:27", "text": "ほら、逃げろよ。"}, {"type": "subtitle", "time": 12576.95, "timestamp": "03:29:36", "text": "私は別のミサイルを選びました"}, {"type": "subtitle", "time": 12578.79, "timestamp": "03:29:38", "text": "今すぐ積み込みを開始してください。私は権利があると思う"}, {"type": "subtitle", "time": 12579.95, "timestamp": "03:29:39", "text": "ミサイル搭載量"}, {"type": "subtitle", "time": 12583.19, "timestamp": "03:29:43", "text": "外。 H"}, {"type": "subtitle", "time": 12587.349, "timestamp": "03:29:47", "text": "待って、準備はいい？うん。"}, {"type": "subtitle", "time": 12589.19, "timestamp": "03:29:49", "text": "チームメンバー全員が準備万端というわけではない。何？"}, {"type": "subtitle", "time": 12591.429, "timestamp": "03:29:51", "text": "なぜ「読み込み中」と表示されるのですか？私は"}, {"type": "subtitle", "time": 12593.83, "timestamp": "03:29:53", "text": "ゲーム。待って、待って、待って、待って、待って。"}, {"type": "subtitle", "time": 12596.71, "timestamp": "03:29:56", "text": "始める。え、何？"}, {"type": "subtitle", "time": 12599.75, "timestamp": "03:29:59", "text": "私はその企画に参加しています。あなたは入った"}]
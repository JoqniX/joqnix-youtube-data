[{"type": "subtitle", "time": 15301.99, "timestamp": "04:15:01", "text": "他のゲームと同様。ガッチャ。"}, {"type": "subtitle", "time": 15306.59, "timestamp": "04:15:06", "text": "そして、1、2、3、4番目に待つ"}, {"type": "subtitle", "time": 15309.99, "timestamp": "04:15:09", "text": "22日か24日から話したこと"}, {"type": "subtitle", "time": 15312.309, "timestamp": "04:15:12", "text": "彼らはそのイベントを開催するつもりなのかもしれない。"}, {"type": "subtitle", "time": 15313.67, "timestamp": "04:15:13", "text": "うん。彼らが"}, {"type": "subtitle", "time": 15316.309, "timestamp": "04:15:16", "text": "1960年代のインド製飛行機。"}, {"type": "subtitle", "time": 15318.55, "timestamp": "04:15:18", "text": "うん。あなたはただ行かなければならない"}, {"type": "subtitle", "time": 15321.11, "timestamp": "04:15:21", "text": "イベントをアクティブにしてプレイする"}, {"type": "subtitle", "time": 15322.71, "timestamp": "04:15:22", "text": "ハムみたいだ。狂ったようにプレイしなければならない。"}, {"type": "subtitle", "time": 15325.429, "timestamp": "04:15:25", "text": "バーが表示されます"}, {"type": "subtitle", "time": 15327.189, "timestamp": "04:15:27", "text": "スコットン社の車両と同様です。 2つごとに"}, {"type": "subtitle", "time": 15329.67, "timestamp": "04:15:29", "text": "新しいバーを満タンにしなければならない日と"}, {"type": "subtitle", "time": 15331.189, "timestamp": "04:15:31", "text": "バーカウンターには行列ができるだろう。あなたが持っている"}, {"type": "subtitle", "time": 15333.99, "timestamp": "04:15:33", "text": "毎日バーのラインを越える。"}, {"type": "subtitle", "time": 15336.07, "timestamp": "04:15:36", "text": "絶対に外せないよ。見逃すしかない"}, {"type": "subtitle", "time": 15338.79, "timestamp": "04:15:38", "text": "一度。会わないチャンスが1回あります"}, {"type": "subtitle", "time": 15341.11, "timestamp": "04:15:41", "text": "要件。つまり、8人になるということだ。"}, {"type": "subtitle", "time": 15348.07, "timestamp": "04:15:48", "text": "そして、その8つのうち1つを見逃しても構いません"}, {"type": "subtitle", "time": 15350.229, "timestamp": "04:15:50", "text": "チャンスは9回。 1つ"}, {"type": "subtitle", "time": 15354.07, "timestamp": "04:15:54", "text": "その9回のチャンス。うん。そしてもしあなたがそうするなら"}, {"type": "subtitle", "time": 15356.87, "timestamp": "04:15:56", "text": "それらすべてによって、そのレーンが"}]
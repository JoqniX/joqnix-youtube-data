[{"type": "subtitle", "time": 11881.75, "timestamp": "03:18:01", "text": "うっかり ルークはどこにいるの？わかった、"}, {"type": "subtitle", "time": 11883.429, "timestamp": "03:18:03", "text": "下を見るという行為はまだ続いている。あなた、あなたはただ"}, {"type": "subtitle", "time": 11885.03, "timestamp": "03:18:05", "text": "下を見るの上にそれを追加しました。あなたはそうしなかった"}, {"type": "subtitle", "time": 11887.91, "timestamp": "03:18:07", "text": "幸いにも、交換できました。よし、それでは"}, {"type": "subtitle", "time": 11890.55, "timestamp": "03:18:10", "text": "割り当てたいもの"}, {"type": "subtitle", "time": 11893.59, "timestamp": "03:18:13", "text": "交換する。うん、これでうまくいくはずだ。"}, {"type": "subtitle", "time": 11895.83, "timestamp": "03:18:15", "text": "近い。うん。わかった。爆弾は全て投下せよ。"}, {"type": "subtitle", "time": 11898.469, "timestamp": "03:18:18", "text": "爆弾は全て投下せよ。ええ、そうです。待って、"}, {"type": "subtitle", "time": 11900.51, "timestamp": "03:18:20", "text": "オフに切り替えてください。オフに切り替える"}, {"type": "subtitle", "time": 11904.07, "timestamp": "03:18:24", "text": "また。爆弾は全て投下せよ。そうです。あなた"}, {"type": "subtitle", "time": 11905.99, "timestamp": "03:18:25", "text": "目標地点に正確に投下する必要がある。取り除くだけ"}, {"type": "subtitle", "time": 11909.71, "timestamp": "03:18:29", "text": "君の爆弾すべての中で。よし、全力でやろう"}, {"type": "subtitle", "time": 11912.67, "timestamp": "03:18:32", "text": "スロットル。エンジンを停止"}, {"type": "subtitle", "time": 11916.91, "timestamp": "03:18:36", "text": "力。電源を入れてください。"}, {"type": "subtitle", "time": 11920.309, "timestamp": "03:18:40", "text": "わかった。スロットルですよね？エンジン。うん。"}, {"type": "subtitle", "time": 11922.229, "timestamp": "03:18:42", "text": "電源を入れてください。"}, {"type": "subtitle", "time": 11924.469, "timestamp": "03:18:44", "text": "ボタン。"}, {"type": "subtitle", "time": 11932.07, "timestamp": "03:18:52", "text": "どういう意味ですか？ただ手足をばたつかせるだけ。おお、"}, {"type": "subtitle", "time": 11934.07, "timestamp": "03:18:54", "text": "まっすぐ上に引き上げてください。うん、引っ張って"}, {"type": "subtitle", "time": 11935.99, "timestamp": "03:18:55", "text": "まっすぐ上に進むか、横に進むか。とても"}, {"type": "subtitle", "time": 11938.469, "timestamp": "03:18:58", "text": "シャープ。手加減しようとしてはいけない。"}]
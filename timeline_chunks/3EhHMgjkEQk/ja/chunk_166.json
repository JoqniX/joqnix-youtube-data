[{"type": "subtitle", "time": 9961.269, "timestamp": "02:46:01", "text": "そう、それが変化の過程だ。行くよ"}, {"type": "subtitle", "time": 9965.51, "timestamp": "02:46:05", "text": "今は音速よりも速い。おお。"}, {"type": "subtitle", "time": 9968.15, "timestamp": "02:46:08", "text": "だから、飛行機を"}, {"type": "subtitle", "time": 9969.91, "timestamp": "02:46:09", "text": "後ろからはエンジンの音が聞こえる。いつ"}, {"type": "subtitle", "time": 9979.11, "timestamp": "02:46:19", "text": "静かに、君は"}, {"type": "subtitle", "time": 9987.269, "timestamp": "02:46:27", "text": "おお。"}, {"type": "subtitle", "time": 9989.11, "timestamp": "02:46:29", "text": "さあ、カメラを再び正面に向けてください。"}, {"type": "subtitle", "time": 9991.79, "timestamp": "02:46:31", "text": "うん。少し上に回してください"}, {"type": "subtitle", "time": 9999.83, "timestamp": "02:46:39", "text": "もっと。さあ、あなたの飛行機がどんな風に見えるか見てみましょう。"}, {"type": "subtitle", "time": 10001.83, "timestamp": "02:46:41", "text": "うん。"}, {"type": "subtitle", "time": 10004.63, "timestamp": "02:46:44", "text": "もっとやりなさい。"}, {"type": "subtitle", "time": 10006.79, "timestamp": "02:46:46", "text": "ああ、もう少しカメラを。上げてください"}, {"type": "subtitle", "time": 10010.91, "timestamp": "02:46:50", "text": "カメラ。はい、完璧です。さあ、あなたの"}, {"type": "subtitle", "time": 10013.11, "timestamp": "02:46:53", "text": "それを保持しなければなりません。保持しなければならない"}, {"type": "subtitle", "time": 10016.15, "timestamp": "02:46:56", "text": "それ。うん。エンジン出力を下げてください"}, {"type": "subtitle", "time": 10017.389, "timestamp": "02:46:57", "text": "に"}, {"type": "subtitle", "time": 10018.99, "timestamp": "02:46:58", "text": "ゼロ"}]
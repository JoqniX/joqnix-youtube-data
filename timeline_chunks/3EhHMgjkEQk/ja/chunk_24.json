[{"type": "subtitle", "time": 1442.31, "timestamp": "00:24:02", "text": "つまり、あなたにとってはそれでいいんです。一部の人にとって"}, {"type": "subtitle", "time": 1445.11, "timestamp": "00:24:05", "text": "今では、人々が"}, {"type": "subtitle", "time": 1447.35, "timestamp": "00:24:07", "text": "応答する。だから私は「ああ、彼らは"}, {"type": "subtitle", "time": 1448.71, "timestamp": "00:24:08", "text": "確認していない。だから眠れないんだね。"}, {"type": "subtitle", "time": 1450.63, "timestamp": "00:24:10", "text": "彼らが返答するまで？"}, {"type": "subtitle", "time": 1454.47, "timestamp": "00:24:14", "text": "いや、私は彼らが来るのを待っているんだ"}, {"type": "subtitle", "time": 1456.549, "timestamp": "00:24:16", "text": "オンライン。"}, {"type": "subtitle", "time": 1459.75, "timestamp": "00:24:19", "text": "それから私は「ああ、もう午前5時過ぎだ」と思う。"}, {"type": "subtitle", "time": 1461.19, "timestamp": "00:24:21", "text": "「寝るべきだ。」彼らはそれ以上来なかった"}, {"type": "subtitle", "time": 1463.19, "timestamp": "00:24:23", "text": "ライン。つまり、あなたは本当に永遠に待つことになるのです"}, {"type": "subtitle", "time": 1470.07, "timestamp": "00:24:30", "text": "いいえ、私は他の仕事をしていて、その後は"}, {"type": "subtitle", "time": 1472.149, "timestamp": "00:24:32", "text": "お待ちください。"}, {"type": "subtitle", "time": 1475.35, "timestamp": "00:24:35", "text": "うん。何てことだ。"}, {"type": "subtitle", "time": 1477.11, "timestamp": "00:24:37", "text": "それに、なぜ午前5時まで待つのですか？"}, {"type": "subtitle", "time": 1478.63, "timestamp": "00:24:38", "text": "誰があなたに返信するだろうか"}, {"type": "subtitle", "time": 1481.11, "timestamp": "00:24:41", "text": "午前3時と午前5時？みんなの"}, {"type": "subtitle", "time": 1484.149, "timestamp": "00:24:44", "text": "とにかく寝てしまった。まるで彼らは"}, {"type": "subtitle", "time": 1487.269, "timestamp": "00:24:47", "text": "日本のユーチューバーたち。いいえ。それで私はこう思ったんです。"}, {"type": "subtitle", "time": 1489.269, "timestamp": "00:24:49", "text": "待っている。ああ、そうだった。あなたはまるで至る所にいる"}, {"type": "subtitle", "time": 1491.95, "timestamp": "00:24:51", "text": "その場所。そうそうそうそう。"}, {"type": "subtitle", "time": 1494.19, "timestamp": "00:24:54", "text": "私だけど"}, {"type": "subtitle", "time": 1498.669, "timestamp": "00:24:58", "text": "そう、だから私は「うん」って感じだけど、"}]
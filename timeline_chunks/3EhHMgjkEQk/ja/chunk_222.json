[{"type": "subtitle", "time": 13321.11, "timestamp": "03:42:01", "text": "ほら、時々人はただ"}, {"type": "subtitle", "time": 13323.51, "timestamp": "03:42:03", "text": "任務を遂行するために戦うのではなく、ただ飛ぶ"}, {"type": "subtitle", "time": 13324.87, "timestamp": "03:42:04", "text": "飛行機で周囲を見回しながら"}, {"type": "subtitle", "time": 13327.75, "timestamp": "03:42:07", "text": "景色。あなたもそうできますよ。そうそう、"}, {"type": "subtitle", "time": 13332.309, "timestamp": "03:42:12", "text": "彼らは今やHDグラフィックを持っている。 M"}, {"type": "subtitle", "time": 13333.91, "timestamp": "03:42:13", "text": "次のようなものを持っているととても美しい"}, {"type": "subtitle", "time": 13337.03, "timestamp": "03:42:17", "text": "雲のある日の出または日没。"}, {"type": "subtitle", "time": 13339.03, "timestamp": "03:42:19", "text": "ああ、光線が差し込んでいるのが見える"}, {"type": "subtitle", "time": 13340.71, "timestamp": "03:42:20", "text": "雲が遮られ、"}, {"type": "subtitle", "time": 13347.11, "timestamp": "03:42:27", "text": "わかりました、セッションを作成できるかどうか確認してみます。"}, {"type": "subtitle", "time": 13349.469, "timestamp": "03:42:29", "text": "準備してください。"}, {"type": "subtitle", "time": 13353.99, "timestamp": "03:42:33", "text": "うん。なんてこった。これはGFXモードです"}, {"type": "subtitle", "time": 13358.63, "timestamp": "03:42:38", "text": "あなたはロビーにいますよね？うん。"}, {"type": "subtitle", "time": 13361.269, "timestamp": "03:42:41", "text": "ああ、その通りです。確認のため"}, {"type": "subtitle", "time": 13364.389, "timestamp": "03:42:44", "text": "前回と同じ不具合が発生しました。"}, {"type": "subtitle", "time": 13365.55, "timestamp": "03:42:45", "text": "わかった。"}, {"type": "subtitle", "time": 13374.07, "timestamp": "03:42:54", "text": "これ？えっと、リスポーンで自分の作品を見ました"}, {"type": "subtitle", "time": 13377.03, "timestamp": "03:42:57", "text": "何か持っているなら、それはあなたのようなものです"}, {"type": "subtitle", "time": 13379.269, "timestamp": "03:42:59", "text": "そうすれば、それはあなたの"}]
[{"type": "subtitle", "time": 15962.87, "timestamp": "04:26:02", "text": "ここ6年、5年、6年くらい。"}, {"type": "subtitle", "time": 15966.229, "timestamp": "04:26:06", "text": "ああ、少なくとも1年間は"}, {"type": "subtitle", "time": 15967.429, "timestamp": "04:26:07", "text": "毎日プレイしていた"}, {"type": "subtitle", "time": 15971.03, "timestamp": "04:26:11", "text": "年。ああ、それでは、とても失業するだろう"}, {"type": "subtitle", "time": 15973.189, "timestamp": "04:26:13", "text": "自分。"}, {"type": "subtitle", "time": 15976.229, "timestamp": "04:26:16", "text": "つまり、イベントと"}, {"type": "subtitle", "time": 15979.83, "timestamp": "04:26:19", "text": "トーナメントのページですよね？はい、そうなるでしょう"}, {"type": "subtitle", "time": 15981.269, "timestamp": "04:26:21", "text": "イベントとトーナメントのページまたは"}, {"type": "subtitle", "time": 15985.429, "timestamp": "04:26:25", "text": "それは、上部にポップアップするかもしれません"}, {"type": "subtitle", "time": 15987.03, "timestamp": "04:26:27", "text": "あなたのチーム。通常は"}, {"type": "subtitle", "time": 15990.07, "timestamp": "04:26:30", "text": "イベントやトーナメント。ああ、行っていいよ"}, {"type": "subtitle", "time": 15994.309, "timestamp": "04:26:34", "text": "Googleでも調べてみてください。とても簡単に入手できます。"}, {"type": "subtitle", "time": 15996.389, "timestamp": "04:26:36", "text": "チュートリアルはいつでも利用できます。"}, {"type": "subtitle", "time": 15998.309, "timestamp": "04:26:38", "text": "爆撃機、あなたが学びたいことは何でも、"}, {"type": "subtitle", "time": 16000.87, "timestamp": "04:26:40", "text": "戦車、船、戦闘機、"}, {"type": "subtitle", "time": 16003.269, "timestamp": "04:26:43", "text": "迎撃機はそこにいるだろう。彼らは"}, {"type": "subtitle", "time": 16006.71, "timestamp": "04:26:46", "text": "本当に良いチュートリアルです。そういうことだ。"}, {"type": "subtitle", "time": 16008.91, "timestamp": "04:26:48", "text": "ええ、バトルパスがあって"}, {"type": "subtitle", "time": 16011.189, "timestamp": "04:26:51", "text": "市場。無料プレイヤーとして、"}, {"type": "subtitle", "time": 16012.55, "timestamp": "04:26:52", "text": "できることはあまりないけど、"}, {"type": "subtitle", "time": 16014.83, "timestamp": "04:26:54", "text": "いくつかできることがあります"}, {"type": "subtitle", "time": 16018.
[{"type": "subtitle", "time": 12902.229, "timestamp": "03:35:02", "text": "何？"}, {"type": "subtitle", "time": 12904.63, "timestamp": "03:35:04", "text": "そして、あなたはプロペラなので、"}, {"type": "subtitle", "time": 12906.79, "timestamp": "03:35:06", "text": "あなたにできることはあまりない。さて、もしあなたが"}, {"type": "subtitle", "time": 12908.71, "timestamp": "03:35:08", "text": "生き残る、"}, {"type": "subtitle", "time": 12912.15, "timestamp": "03:35:12", "text": "鼻先を下に向けて。地面にまっすぐ落下。はい。"}, {"type": "subtitle", "time": 12915.67, "timestamp": "03:35:15", "text": "わかった。私に向かってくるんですよね？"}, {"type": "subtitle", "time": 12918.95, "timestamp": "03:35:18", "text": "いいえ、まだです。今、ミサイルが"}, {"type": "subtitle", "time": 12922.75, "timestamp": "03:35:22", "text": "あなたが到着する前に到着します"}, {"type": "subtitle", "time": 12925.03, "timestamp": "03:35:25", "text": "地面。私はあなたを待たなければならない"}, {"type": "subtitle", "time": 12927.55, "timestamp": "03:35:27", "text": "到達するために"}, {"type": "subtitle", "time": 12930.55, "timestamp": "03:35:30", "text": "地面。あなたは下降するのですか、それとも上昇するのですか？"}, {"type": "subtitle", "time": 12933.75, "timestamp": "03:35:33", "text": "私は外に出るべきですか？わかった。"}, {"type": "subtitle", "time": 12937.11, "timestamp": "03:35:37", "text": "おい、生き残りたいのか？はい。私はできる"}, {"type": "subtitle", "time": 12938.71, "timestamp": "03:35:38", "text": "文字通り、向きを変えて鼻を向けて、"}, {"type": "subtitle", "time": 12946.95, "timestamp": "03:35:46", "text": "範囲。だから、とても良いことわざがあるんです"}, {"type": "subtitle", "time": 12949.429, "timestamp": "03:35:49", "text": "パイロットの間では、爆破するために上昇する。あなた"}, {"type": "subtitle", "time": 12952.229, "timestamp": "03:35:52", "text": "その言葉に従わなければならない。下へ降りて"}, {"type": "subtitle", "time": 12955.03, "timestamp": "03:35:55", "text": "自分の身を守れ。"}, {"type": "subtitle", "time": 12956.229, "timestamp": "03:35:56", "text": "ええと、そういう種類の"}, {"type": "subtitle", "time": 12959.83, "timestamp": "03:35:59", "text": "節約はできるが、それはある意味"}]
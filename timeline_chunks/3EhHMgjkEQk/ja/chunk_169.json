[{"type": "subtitle", "time": 10140.63, "timestamp": "02:49:00", "text": "そして、空母に着艦する。おお、"}, {"type": "subtitle", "time": 10142.389, "timestamp": "02:49:02", "text": "大丈夫です。全速力で走れ。フルに"}, {"type": "subtitle", "time": 10144.95, "timestamp": "02:49:04", "text": "赤いスペースに向かってスロットルを"}, {"type": "subtitle", "time": 10148.15, "timestamp": "02:49:08", "text": "彼女は海岸にいた。彼女は岸辺にいる"}, {"type": "subtitle", "time": 10149.67, "timestamp": "02:49:09", "text": "海岸。ええ、そのまま進んでください"}, {"type": "subtitle", "time": 10152.79, "timestamp": "02:49:12", "text": "海岸。海岸沿いに。ああ、神様。"}, {"type": "subtitle", "time": 10161.67, "timestamp": "02:49:21", "text": "真っ直ぐ。または、"}, {"type": "subtitle", "time": 10163.469, "timestamp": "02:49:23", "text": "別の飛行機。試してみたい"}, {"type": "subtitle", "time": 10166.87, "timestamp": "02:49:26", "text": "F18？それで試してみますか？"}, {"type": "subtitle", "time": 10170.71, "timestamp": "02:49:30", "text": "うん。わかりました、では格納庫に戻ってください。させて"}, {"type": "subtitle", "time": 10177.309, "timestamp": "02:49:37", "text": "ええ、それはあなたのものになります"}, {"type": "subtitle", "time": 10184.07, "timestamp": "02:49:44", "text": "また、これらの飛行機は一般的に"}, {"type": "subtitle", "time": 10186.55, "timestamp": "02:49:46", "text": "いずれにしても速すぎて着陸できない。だから、彼らはやってくる"}, {"type": "subtitle", "time": 10189.19, "timestamp": "02:49:49", "text": "パラシュート付きで。"}, {"type": "subtitle", "time": 10192.59, "timestamp": "02:49:52", "text": "だから、そうなれば破壊されるだろう"}, {"type": "subtitle", "time": 10194.55, "timestamp": "02:49:54", "text": "自動的に。着陸したら"}, {"type": "subtitle", "time": 10196.309, "timestamp": "02:49:56", "text": "パラシュートはすべて無事に"}, {"type": "subtitle", "time": 10198.23, "timestamp": "02:49:58", "text": "パラシュートは減速を助ける"}]
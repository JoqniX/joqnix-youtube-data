[{"type": "subtitle", "time": 16021.59, "timestamp": "04:27:01", "text": "まもなくジェット機が発進します。そうだといい。私は"}, {"type": "subtitle", "time": 16023.11, "timestamp": "04:27:03", "text": "あなたがそれを手に入れて私が手に入れられなかったら、本当に腹が立つ"}, {"type": "subtitle", "time": 16025.51, "timestamp": "04:27:05", "text": "それを得る。"}, {"type": "subtitle", "time": 16027.51, "timestamp": "04:27:07", "text": "いや、私が手に入れなければ、それはうまくいかないだろう"}, {"type": "subtitle", "time": 16031.349, "timestamp": "04:27:11", "text": "それ。いいえ、問題は私がそうしないということです"}, {"type": "subtitle", "time": 16034.309, "timestamp": "04:27:14", "text": "それを磨くことは心の中ではありますが、同時に、"}, {"type": "subtitle", "time": 16036.07, "timestamp": "04:27:16", "text": "たくさんのコラボレーションとか、そういうの全部"}, {"type": "subtitle", "time": 16039.03, "timestamp": "04:27:19", "text": "計画済み。いや、私は男として君に尽くすよ。それで、"}, {"type": "subtitle", "time": 16042.87, "timestamp": "04:27:22", "text": "えっと、何週間だったっけ？その"}, {"type": "subtitle", "time": 16047.83, "timestamp": "04:27:27", "text": "それは2日間ずつのモジュールが8つあるコースです。"}, {"type": "subtitle", "time": 16050.63, "timestamp": "04:27:30", "text": "つまり、それぞれのバーを完成させる必要がある"}, {"type": "subtitle", "time": 16053.189, "timestamp": "04:27:33", "text": "モジュール。"}, {"type": "subtitle", "time": 16055.51, "timestamp": "04:27:35", "text": "つまり、それは2日間続くということですね。それ"}, {"type": "subtitle", "time": 16058.75, "timestamp": "04:27:38", "text": "今日の12時から始まるとしましょう"}, {"type": "subtitle", "time": 16062.389, "timestamp": "04:27:42", "text": "夜。月曜日か火曜日の12日に終了します"}, {"type": "subtitle", "time": 16066.55, "timestamp": "04:27:46", "text": "夜に。ああ、あのモジュールみたいに"}, {"type": "subtitle", "time": 16068.63, "timestamp": "04:27:48", "text": "そして月曜日の夜にすぐに"}, {"type": "subtitle", "time": 16071.269, "timestamp": "04:27:51", "text": "次のモジュールが開始されます。"}, {"type": "subtitle", "time": 16073.79, "timestamp": "04:27:53", "text": "何てことだ。"}, {"type": "subtitle", "time": 16075.51, "timestamp": "04:27:55", "text": "うん。どう思いますか？彼らは行く"}, {"type": "subtitle", "time": 16079.67, "timestamp": "04:27:59", "text": "あなたにとって分かりやすくするためです。何てことだ。それ"}]
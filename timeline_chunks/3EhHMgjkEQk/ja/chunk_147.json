[{"type": "subtitle", "time": 8821.83, "timestamp": "02:27:01", "text": "Hチェックワンツーフジク、聞こえるか？"}, {"type": "subtitle", "time": 8825.91, "timestamp": "02:27:05", "text": "問題なさそうだ。こんにちは、私。ええ、おっしゃることは分かります。"}, {"type": "subtitle", "time": 8827.75, "timestamp": "02:27:07", "text": "私の声が聞こえますか？そこで何が起こったのですか？私"}, {"type": "subtitle", "time": 8830.55, "timestamp": "02:27:10", "text": "まだ聞こえないけど、音がする"}, {"type": "subtitle", "time": 8832.389, "timestamp": "02:27:12", "text": "まるで私の声が聞こえるか、あるいはあなたが"}, {"type": "subtitle", "time": 8834.79, "timestamp": "02:27:14", "text": "私の声が聞こえるはずだ。うん。私を去らせて"}]
[{"type": "subtitle", "time": 5881.03, "timestamp": "01:38:01", "text": "他の赤字、赤字全体"}, {"type": "subtitle", "time": 5882.87, "timestamp": "01:38:02", "text": "ラインナップを作るのに1年くらいかかるよ"}, {"type": "subtitle", "time": 5887.83, "timestamp": "01:38:07", "text": "1.5。聖なる主よ。または、"}, {"type": "subtitle", "time": 5890.709, "timestamp": "01:38:10", "text": "1ヶ月半くらいで手に入るけど、"}, {"type": "subtitle", "time": 5892.79, "timestamp": "01:38:12", "text": "何かがあることを忘れてしまう"}, {"type": "subtitle", "time": 5894.39, "timestamp": "01:38:14", "text": "あなたの人生と存在にとって他の"}, {"type": "subtitle", "time": 5897.99, "timestamp": "01:38:17", "text": "そうしなければならないなら、水よりもああ、"}, {"type": "subtitle", "time": 5903.47, "timestamp": "01:38:23", "text": "神。だから、とても愛情を込めて"}, {"type": "subtitle", "time": 5906.55, "timestamp": "01:38:26", "text": "ゲームのキャッチフレーズまたはキャプションは、"}, {"type": "subtitle", "time": 5908.47, "timestamp": "01:38:28", "text": "公式ではない、非公式である"}, {"type": "subtitle", "time": 5911.27, "timestamp": "01:38:31", "text": "すべてのファンによって。 War Thunderをプレイしに来てください。その"}, {"type": "subtitle", "time": 5917.99, "timestamp": "01:38:37", "text": "ほら、楽しくなり始めると、"}, {"type": "subtitle", "time": 5919.51, "timestamp": "01:38:39", "text": "楽しんで、それから、"}, {"type": "subtitle", "time": 5921.91, "timestamp": "01:38:41", "text": "あなたの人生は惨めだ。非常によく似ている"}, {"type": "subtitle", "time": 5923.75, "timestamp": "01:38:43", "text": "関係。"}, {"type": "subtitle", "time": 5932.47, "timestamp": "01:38:52", "text": "ええと、でもそうですね、上に行くほど、"}, {"type": "subtitle", "time": 5935.51, "timestamp": "01:38:55", "text": "ボタンやその他"}, {"type": "subtitle", "time": 5937.99, "timestamp": "01:38:57", "text": "取り扱い、世話をする。なぜなら"}]
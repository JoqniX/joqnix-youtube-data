[{"type": "subtitle", "time": 12180.87, "timestamp": "03:23:00", "text": "さあ、私はもっと早くあなたのところに行きます"}, {"type": "subtitle", "time": 12189.51, "timestamp": "03:23:09", "text": "再びスピードアップ。また、私は"}, {"type": "subtitle", "time": 12196.55, "timestamp": "03:23:16", "text": "どこにいるの？"}, {"type": "subtitle", "time": 12204.87, "timestamp": "03:23:24", "text": "こんにちは。ああ、あなたは私が見えていないのね。なぜ？なぜ"}, {"type": "subtitle", "time": 12219.79, "timestamp": "03:23:39", "text": "戦闘"}, {"type": "subtitle", "time": 12222.229, "timestamp": "03:23:42", "text": "男の子？わかった。撃ちたいから撃たないで"}, {"type": "subtitle", "time": 12225.95, "timestamp": "03:23:45", "text": "この飛行機がどのように飛ぶか見てみよう。"}, {"type": "subtitle", "time": 12229.349, "timestamp": "03:23:49", "text": "ああ。エンジンを切って"}, {"type": "subtitle", "time": 12231.91, "timestamp": "03:23:51", "text": "ああ、私はまだやっていないんです。"}, {"type": "subtitle", "time": 12233.83, "timestamp": "03:23:53", "text": "まだやっていません。私はただ飛んでいるだけです"}, {"type": "subtitle", "time": 12237.11, "timestamp": "03:23:57", "text": "今のところは普通です。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 12239.429, "timestamp": "03:23:59", "text": "これは通常、この飛行機ができることです。"}]
[{"type": "subtitle", "time": 14048.87, "timestamp": "03:54:08", "text": "くそ。ということで、10分間の"}, {"type": "subtitle", "time": 14051.03, "timestamp": "03:54:11", "text": "これに関する窓。そうではない、私はそうではない"}, {"type": "subtitle", "time": 14053.91, "timestamp": "03:54:13", "text": "永遠に続くと思う。私が始めます"}, {"type": "subtitle", "time": 14063.03, "timestamp": "03:54:23", "text": "もっと長く設定できるかもしれないが、"}, {"type": "subtitle", "time": 14063.79, "timestamp": "03:54:23", "text": "私"}, {"type": "subtitle", "time": 14070.63, "timestamp": "03:54:30", "text": "うん、良すぎるくらいだ。さあ、あなたは"}, {"type": "subtitle", "time": 14073.51, "timestamp": "03:54:33", "text": "食べるよね？まとめると"}, {"type": "subtitle", "time": 14081.03, "timestamp": "03:54:41", "text": "今日は学ぶことがとても興味深かった"}, {"type": "subtitle", "time": 14086.389, "timestamp": "03:54:46", "text": "飛行機について、そしてそれが本当に良かったことについて"}, {"type": "subtitle", "time": 14088.309, "timestamp": "03:54:48", "text": "そしてゲームに参加する理由は"}, {"type": "subtitle", "time": 14090.87, "timestamp": "03:54:50", "text": "関心事であり、またご存知のように"}, {"type": "subtitle", "time": 14093.59, "timestamp": "03:54:53", "text": "ジェット機と約3日間の滞在を希望"}, {"type": "subtitle", "time": 14096.309, "timestamp": "03:54:56", "text": "あなたはそれら全てを忘れてしまう。"}, {"type": "subtitle", "time": 14099.51, "timestamp": "03:54:59", "text": "有害なゲーマーの怒りが蔓延し、"}]
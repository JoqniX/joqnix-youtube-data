[{"type": "subtitle", "time": 6804.229, "timestamp": "01:53:24", "text": "よし、君の後ろにいる奴を捕まえたぞ。私"}, {"type": "subtitle", "time": 6806.83, "timestamp": "01:53:26", "text": "でも、君の姿は見かけないね。ああ、そこにいる"}, {"type": "subtitle", "time": 6814.55, "timestamp": "01:53:34", "text": "ここ。彼を捕まえろ。彼はすでにかなり怪我をしている"}, {"type": "subtitle", "time": 6817.83, "timestamp": "01:53:37", "text": "少し。ちなみに、あなたの上のほうです。"}, {"type": "subtitle", "time": 6820.47, "timestamp": "01:53:40", "text": "私の下。 1つあります。あの男はもういない。"}, {"type": "subtitle", "time": 6822.35, "timestamp": "01:53:42", "text": "あの男は"}, {"type": "subtitle", "time": 6825.589, "timestamp": "01:53:45", "text": "クラッシュ。わかった。ジョック、君の後ろだ。分かりますか"}, {"type": "subtitle", "time": 6827.99, "timestamp": "01:53:47", "text": "彼ら？はい。彼らが見えますか？注意深い。しないで"}, {"type": "subtitle", "time": 6830.39, "timestamp": "01:53:50", "text": "向かえ。"}, {"type": "subtitle", "time": 6834.669, "timestamp": "01:53:54", "text": "ああ。おお、悪くないね。悪くない。あなたは彼を"}, {"type": "subtitle", "time": 6838.07, "timestamp": "01:53:58", "text": "火。私はその男を撃たないつもりなので"}]
[{"type": "subtitle", "time": 4202.27, "timestamp": "01:10:02", "text": "チームを守るために"}, {"type": "subtitle", "time": 4205.35, "timestamp": "01:10:05", "text": "対空戦車。つまりあなたの仕事は"}, {"type": "subtitle", "time": 4207.83, "timestamp": "01:10:07", "text": "敵機を撃墜する。"}, {"type": "subtitle", "time": 4214.47, "timestamp": "01:10:14", "text": "今は戦車マップにいます。それは"}, {"type": "subtitle", "time": 4217.27, "timestamp": "01:10:17", "text": "なぜ赤色Aと青色が見えたのか"}, {"type": "subtitle", "time": 4225.39, "timestamp": "01:10:25", "text": "そういうことなんです。"}, {"type": "subtitle", "time": 4229.51, "timestamp": "01:10:29", "text": "あ、ちょっと待ってください。えっと、私に"}, {"type": "subtitle", "time": 4232.229, "timestamp": "01:10:32", "text": "インスタントラーメンはこちらです。だから、"}, {"type": "subtitle", "time": 4234.87, "timestamp": "01:10:34", "text": "わあ、すごい。"}, {"type": "subtitle", "time": 4237.91, "timestamp": "01:10:37", "text": "夕食は食べましたか？"}, {"type": "subtitle", "time": 4258.11, "timestamp": "01:10:58", "text": "注文しますか？"}]
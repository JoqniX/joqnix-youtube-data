[{"type": "subtitle", "time": 1394.31, "timestamp": "00:23:14", "text": "寝る代わりに、私は「えっと、私は"}, {"type": "subtitle", "time": 1396.27, "timestamp": "00:23:16", "text": "私は今、コラボレーションを計画しています"}, {"type": "subtitle", "time": 1399.11, "timestamp": "00:23:19", "text": "みんな。だから私はこう思っていました。"}, {"type": "subtitle", "time": 1401.27, "timestamp": "00:23:21", "text": "スケジュール調整や連絡など"}, {"type": "subtitle", "time": 1404.19, "timestamp": "00:23:24", "text": "日程を確定し、"}, {"type": "subtitle", "time": 1406.95, "timestamp": "00:23:26", "text": "みんないたずらばかりしている。"}, {"type": "subtitle", "time": 1408.71, "timestamp": "00:23:28", "text": "どういう意味ですか？ええ、私は24時間です"}, {"type": "subtitle", "time": 1411.669, "timestamp": "00:23:31", "text": "ただし、ライブ配信で行います。"}, {"type": "subtitle", "time": 1414.07, "timestamp": "00:23:34", "text": "そうだけど、時間の半分は寝てるじゃないか。いいえ。"}, {"type": "subtitle", "time": 1415.59, "timestamp": "00:23:35", "text": "ええ、それは本当です。リプレイがあります"}, {"type": "subtitle", "time": 1418.63, "timestamp": "00:23:38", "text": "いろいろ起こっている。いいえ、時間です。"}, {"type": "subtitle", "time": 1421.669, "timestamp": "00:23:41", "text": "それは本当です。その後、4時間睡眠。"}, {"type": "subtitle", "time": 1424.27, "timestamp": "00:23:44", "text": "睡眠不足。 12時間の睡眠"}, {"type": "subtitle", "time": 1426.63, "timestamp": "00:23:46", "text": "リプレイ。あなたは私にすべてを話しています"}, {"type": "subtitle", "time": 1429.43, "timestamp": "00:23:49", "text": "前回はセットアップに行った"}, {"type": "subtitle", "time": 1431.11, "timestamp": "00:23:51", "text": "コラボレーション。"}, {"type": "subtitle", "time": 1433.029, "timestamp": "00:23:53", "text": "最後に確認したところ、たった5分しかかかりませんでした"}, {"type": "subtitle", "time": 1434.63, "timestamp": "00:23:54", "text": "コラボレーションの設定に数分かかりました。あなたは"}, {"type": "subtitle", "time": 1437.669, "timestamp": "00:23:57", "text": "「ねえ、プジ、一緒に遊ぼうか？」"}, {"type": "subtitle", "time": 1439.669, "timestamp": "00:23:59", "text": "ああ、もちろんだよ。"}]
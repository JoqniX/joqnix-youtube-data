[{"type": "subtitle", "time": 6480.39, "timestamp": "01:48:00", "text": "スピード。わかった。すぐ隣にいるよ。"}, {"type": "subtitle", "time": 6482.149, "timestamp": "01:48:02", "text": "素晴らしい飛行ぶりですね。あなたは飛んでいます"}, {"type": "subtitle", "time": 6484.51, "timestamp": "01:48:04", "text": "本当に良い。今のやり方を続けてください"}, {"type": "subtitle", "time": 6487.99, "timestamp": "01:48:07", "text": "実行中。ご案内します。"}, {"type": "subtitle", "time": 6489.35, "timestamp": "01:48:09", "text": "空軍基地？"}, {"type": "subtitle", "time": 6490.51, "timestamp": "01:48:10", "text": "目の前に"}, {"type": "subtitle", "time": 6493.83, "timestamp": "01:48:13", "text": "あなたですが、位置が合っていません。あなたは行く"}, {"type": "subtitle", "time": 6495.99, "timestamp": "01:48:15", "text": "垂直。だから、私たちが"}, {"type": "subtitle", "time": 6498.149, "timestamp": "01:48:18", "text": "空軍基地に行くには、"}, {"type": "subtitle", "time": 6499.99, "timestamp": "01:48:19", "text": "側。"}, {"type": "subtitle", "time": 6502.39, "timestamp": "01:48:22", "text": "側面はどこですか？横へ移動してください。おお、"}, {"type": "subtitle", "time": 6505.91, "timestamp": "01:48:25", "text": "これです。はい、すぐ目の前にあります。"}, {"type": "subtitle", "time": 6522.709, "timestamp": "01:48:42", "text": "あ、待って。スピードを上げることはできません。おお。"}, {"type": "subtitle", "time": 6524.47, "timestamp": "01:48:44", "text": "ええ、エンジンがないんです。あなた"}, {"type": "subtitle", "time": 6527.75, "timestamp": "01:48:47", "text": "速度を上げることはできません"}, {"type": "subtitle", "time": 6529.629, "timestamp": "01:48:49", "text": "スピードが押し上げるからだ。"}, {"type": "subtitle", "time": 6534.229, "timestamp": "01:48:54", "text": "いや。あ、待って。不時着するかもしれない。"}, {"type": "subtitle", "time": 6537.189, "timestamp": "01:48:57", "text": "うん。緊急着陸。引き上げて"}, {"type": "subtitle", "time": 6539.75, "timestamp": "01:48:59", "text": "若干。少し引き上げてください。わかった。"}]
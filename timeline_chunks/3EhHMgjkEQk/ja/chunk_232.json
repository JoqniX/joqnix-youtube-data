[{"type": "subtitle", "time": 13922.389, "timestamp": "03:52:02", "text": "実際、撃たせてあげるよ。ええ、私に"}, {"type": "subtitle", "time": 13925.59, "timestamp": "03:52:05", "text": "撃ってみて。"}, {"type": "subtitle", "time": 13927.429, "timestamp": "03:52:07", "text": "そうすれば、さらに速くなるでしょう"}, {"type": "subtitle", "time": 13938.71, "timestamp": "03:52:18", "text": "ああ、俺もジェット機が欲しいよ。"}, {"type": "subtitle", "time": 13940.309, "timestamp": "03:52:20", "text": "その通り。そうやってゲームはあなたを虜にするのです"}, {"type": "subtitle", "time": 13948.07, "timestamp": "03:52:28", "text": "君は私がどれだけ持っているか全く知らない"}, {"type": "subtitle", "time": 13949.71, "timestamp": "03:52:29", "text": "に"}, {"type": "subtitle", "time": 13953.99, "timestamp": "03:52:33", "text": "あなたにハンディキャップを与えるようなもの"}, {"type": "subtitle", "time": 13956.75, "timestamp": "03:52:36", "text": "正しいことを実行できる"}]
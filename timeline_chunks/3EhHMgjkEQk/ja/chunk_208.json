[{"type": "subtitle", "time": 12481.349, "timestamp": "03:28:01", "text": "ああ、しまった。ああ、くそ。はい、戻って"}, {"type": "subtitle", "time": 12485.11, "timestamp": "03:28:05", "text": "ハンガー。何が起こったのか知っています。"}, {"type": "subtitle", "time": 12487.51, "timestamp": "03:28:07", "text": "どうしたの？"}, {"type": "subtitle", "time": 12490.55, "timestamp": "03:28:10", "text": "だからその飛行機ではレーダー戦闘があり、"}, {"type": "subtitle", "time": 12493.91, "timestamp": "03:28:13", "text": "右？私は実際の試合で飛行機に乗ります"}, {"type": "subtitle", "time": 12496.469, "timestamp": "03:28:16", "text": "あの飛行機。というものがあります"}, {"type": "subtitle", "time": 12497.99, "timestamp": "03:28:17", "text": "異なる種類がある"}, {"type": "subtitle", "time": 12500.389, "timestamp": "03:28:20", "text": "ミサイル。"}, {"type": "subtitle", "time": 12502.269, "timestamp": "03:28:22", "text": "だから"}, {"type": "subtitle", "time": 12504.95, "timestamp": "03:28:24", "text": "私が言った通常のミサイル"}, {"type": "subtitle", "time": 12510.309, "timestamp": "03:28:30", "text": "それはあなたの熱を求めてどこへ向かうのか。おお、"}, {"type": "subtitle", "time": 12512.15, "timestamp": "03:28:32", "text": "あれらは旧式のミサイルだ。"}, {"type": "subtitle", "time": 12514.309, "timestamp": "03:28:34", "text": "それらはまだ使われていますが、次のように使われています"}, {"type": "subtitle", "time": 12516.95, "timestamp": "03:28:36", "text": "バックアップを今すぐ作成します。昔は、彼らは"}, {"type": "subtitle", "time": 12519.75, "timestamp": "03:28:39", "text": "主ミサイルとして使用される。今彼らは"}, {"type": "subtitle", "time": 12526.389, "timestamp": "03:28:46", "text": "ミサイル。レーダーミサイルが2基になった。"}, {"type": "subtitle", "time": 12528.269, "timestamp": "03:28:48", "text": "ミサイルには独自の"}, {"type": "subtitle", "time": 12532.67, "timestamp": "03:28:52", "text": "レーダー。 1つは、発射するミサイルです"}, {"type": "subtitle", "time": 12535.67, "timestamp": "03:28:55", "text": "それとあなたの飛行機は"}, {"type": "subtitle", "time": 12537.19, "timestamp": "03:28:57", "text": "ミサイル。だから私の飛行機は"}]
[{"type": "subtitle", "time": 5702.709, "timestamp": "01:35:02", "text": "実際の行動はどのようなものか"}, {"type": "subtitle", "time": 5705.03, "timestamp": "01:35:05", "text": "現実世界での戦い、そう、まるで"}, {"type": "subtitle", "time": 5706.87, "timestamp": "01:35:06", "text": "これ、"}, {"type": "subtitle", "time": 5709.83, "timestamp": "01:35:09", "text": "しかし、これは1980年代のことだ。ない"}, {"type": "subtitle", "time": 5711.75, "timestamp": "01:35:11", "text": "もう。"}, {"type": "subtitle", "time": 5715.43, "timestamp": "01:35:15", "text": "ああ、今日あなたが十分近くにいるなら"}, {"type": "subtitle", "time": 5718.55, "timestamp": "01:35:18", "text": "敵機を視覚的に確認すると、"}, {"type": "subtitle", "time": 5721.47, "timestamp": "01:35:21", "text": "家に帰れる確率は50/50です"}, {"type": "subtitle", "time": 5724.31, "timestamp": "01:35:24", "text": "生きている。何？"}, {"type": "subtitle", "time": 5726.95, "timestamp": "01:35:26", "text": "その技術が優れていると知ると"}, {"type": "subtitle", "time": 5728.79, "timestamp": "01:35:28", "text": "レーダーでお互いを捉えて"}, {"type": "subtitle", "time": 5730.87, "timestamp": "01:35:30", "text": "200kmくらい離れたところで撃ち合う"}, {"type": "subtitle", "time": 5737.189, "timestamp": "01:35:37", "text": "ああ、じゃあ君は飛行機をすごく速く飛ばすんだね"}, {"type": "subtitle", "time": 5739.51, "timestamp": "01:35:39", "text": "そして敵に向かってまっすぐ"}, {"type": "subtitle", "time": 5741.51, "timestamp": "01:35:41", "text": "そしてあなたは常に登り続けることになるでしょう。"}, {"type": "subtitle", "time": 5743.43, "timestamp": "01:35:43", "text": "レーダーに敵の位置が表示されます。"}, {"type": "subtitle", "time": 5745.59, "timestamp": "01:35:45", "text": "あなたは武器の射程圏内に入るでしょう。"}, {"type": "subtitle", "time": 5747.35, "timestamp": "01:35:47", "text": "ミサイルを発射するとすぐに"}, {"type": "subtitle", "time": 5754.149, "timestamp": "01:35:54", "text": "離れて。だから、それはもっと"}]
[{"type": "subtitle", "time": 4509.59, "timestamp": "01:15:09", "text": "おお。そうやってやるんです。"}, {"type": "subtitle", "time": 4511.91, "timestamp": "01:15:11", "text": "衝突した 私はまだ飛んでいるが、"}, {"type": "subtitle", "time": 4514.75, "timestamp": "01:15:14", "text": "もうすぐクラッシュするだろう。ああ、私は"}, {"type": "subtitle", "time": 4517.35, "timestamp": "01:15:17", "text": "墜落しました。え、何？君が仕留めた。私"}, {"type": "subtitle", "time": 4522.95, "timestamp": "01:15:22", "text": "ニース。"}, {"type": "subtitle", "time": 4525.189, "timestamp": "01:15:25", "text": "よし、もっと強力なものを使う時が来た"}, {"type": "subtitle", "time": 4536.149, "timestamp": "01:15:36", "text": "さらに、もっと大きな銃も。うん。こんにちは。"}, {"type": "subtitle", "time": 4539.99, "timestamp": "01:15:39", "text": "ビヨンセとは何ですか？超えて"}, {"type": "subtitle", "time": 4546.51, "timestamp": "01:15:46", "text": "何てことだ。"}, {"type": "subtitle", "time": 4549.55, "timestamp": "01:15:49", "text": "スロットル スロットル"}, {"type": "subtitle", "time": 4553.189, "timestamp": "01:15:53", "text": "WP。マウスホイールの乗数、コントロール"}]
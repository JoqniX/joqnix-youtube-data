[{"type": "subtitle", "time": 14220.63, "timestamp": "03:57:00", "text": "自分がただ入っていくだけだと知っておいて。たぶん"}, {"type": "subtitle", "time": 14222.15, "timestamp": "03:57:02", "text": "1キルすると、"}, {"type": "subtitle", "time": 14224.07, "timestamp": "03:57:04", "text": "殺された。"}, {"type": "subtitle", "time": 14225.51, "timestamp": "03:57:05", "text": "キルを獲得できるバージョンはありません"}, {"type": "subtitle", "time": 14227.429, "timestamp": "03:57:07", "text": "そして、あなたが安全に家に帰るとき"}, {"type": "subtitle", "time": 14229.15, "timestamp": "03:57:09", "text": "プロペラがジェットエンジンに逆らって回転する"}, {"type": "subtitle", "time": 14232.79, "timestamp": "03:57:12", "text": "戦闘員。ああ、"}, {"type": "subtitle", "time": 14234.309, "timestamp": "03:57:14", "text": "あなたに少しスペースを与えているので、"}, {"type": "subtitle", "time": 14237.349, "timestamp": "03:57:17", "text": "市内へ。"}, {"type": "subtitle", "time": 14240.07, "timestamp": "03:57:20", "text": "エンジンが停止した。おお。"}, {"type": "subtitle", "time": 14243.03, "timestamp": "03:57:23", "text": "どうやって死んだのですか？プロペラブローカー。待って、"}, {"type": "subtitle", "time": 14245.229, "timestamp": "03:57:25", "text": "どうやって"}, {"type": "subtitle", "time": 14249.03, "timestamp": "03:57:29", "text": "プロペラ？何？"}, {"type": "subtitle", "time": 14251.189, "timestamp": "03:57:31", "text": "大丈夫。冗談です。よし。その"}, {"type": "subtitle", "time": 14253.59, "timestamp": "03:57:33", "text": "わかった。"}, {"type": "subtitle", "time": 14265.59, "timestamp": "03:57:45", "text": "ああ。うん。入りたいときは"}, {"type": "subtitle", "time": 14267.67, "timestamp": "03:57:47", "text": "発射位置では、"}, {"type": "subtitle", "time": 14273.99, "timestamp": "03:57:53", "text": "そうでなければ、ただ"}]
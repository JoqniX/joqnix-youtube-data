[{"type": "subtitle", "time": 5160.31, "timestamp": "01:26:00", "text": "それで、赤い点が見えるでしょう"}, {"type": "subtitle", "time": 5163.35, "timestamp": "01:26:03", "text": "地面、ですよね？はい。それらは対空兵器です"}, {"type": "subtitle", "time": 5165.43, "timestamp": "01:26:05", "text": "システム。いきなり取り掛かってはいけません。それは"}, {"type": "subtitle", "time": 5168.87, "timestamp": "01:26:08", "text": "撃ち込んでやる。それから目を背けろ。"}, {"type": "subtitle", "time": 5171.669, "timestamp": "01:26:11", "text": "それを回避する方法はポイントです"}, {"type": "subtitle", "time": 5174.11, "timestamp": "01:26:14", "text": "それに向かって飛んでいく"}, {"type": "subtitle", "time": 5183.669, "timestamp": "01:26:23", "text": "上。左側には一般的に"}, {"type": "subtitle", "time": 5187.11, "timestamp": "01:26:27", "text": "警告。うん。"}, {"type": "subtitle", "time": 5189.43, "timestamp": "01:26:29", "text": "つまり、右側がレーダーで、左側が"}, {"type": "subtitle", "time": 5191.51, "timestamp": "01:26:31", "text": "警告です。"}, {"type": "subtitle", "time": 5193.99, "timestamp": "01:26:33", "text": "画面の左隅に、"}, {"type": "subtitle", "time": 5196.229, "timestamp": "01:26:36", "text": "下隅には赤い点が見えます"}, {"type": "subtitle", "time": 5199.59, "timestamp": "01:26:39", "text": "空。左に曲がってください。"}, {"type": "subtitle", "time": 5201.669, "timestamp": "01:26:41", "text": "赤い点。赤い点が見えると思います"}, {"type": "subtitle", "time": 5204.31, "timestamp": "01:26:44", "text": "空。ああ、君は十分な高さまで上がっていなかったんだね。"}, {"type": "subtitle", "time": 5209.35, "timestamp": "01:26:49", "text": "ミサイルをテストしたい場合は、"}, {"type": "subtitle", "time": 5211.189, "timestamp": "01:26:51", "text": "あなたはあの飛行機の方へ行かなければなりません。"}, {"type": "subtitle", "time": 5214.229, "timestamp": "01:26:54", "text": "さあ、左に曲がってください。急な左折。シャープ"}, {"type": "subtitle", "time": 5217.91, "timestamp": "01:26:57", "text": "左。はい。うん。あのセリフたち。うん。はい。"}]
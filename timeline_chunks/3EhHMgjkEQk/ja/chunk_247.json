[{"type": "subtitle", "time": 14821.83, "timestamp": "04:07:01", "text": "えーと、もっと価値の高いもの。"}, {"type": "subtitle", "time": 14825.59, "timestamp": "04:07:05", "text": "いや、どの飛行隊にでも参加すればいいんだよ"}, {"type": "subtitle", "time": 14829.269, "timestamp": "04:07:09", "text": "えっと、では、参加するには何が良いですか"}, {"type": "subtitle", "time": 14831.75, "timestamp": "04:07:11", "text": "この飛行隊は現役の飛行隊です。あなた"}, {"type": "subtitle", "time": 14832.95, "timestamp": "04:07:12", "text": "飛行隊には参加したくない"}, {"type": "subtitle", "time": 14835.67, "timestamp": "04:07:15", "text": "誰も真剣にプレイしていない。それでは関係なく"}, {"type": "subtitle", "time": 14837.51, "timestamp": "04:07:17", "text": "どれだけ努力したかは"}, {"type": "subtitle", "time": 14839.11, "timestamp": "04:07:19", "text": "案件。"}, {"type": "subtitle", "time": 14843.59, "timestamp": "04:07:23", "text": "うん。このシステムは、ええと、使いにくいです"}, {"type": "subtitle", "time": 14846.389, "timestamp": "04:07:26", "text": "政治用語で言うと"}, {"type": "subtitle", "time": 14849.429, "timestamp": "04:07:29", "text": "言わせてもらう必要がある。"}, {"type": "subtitle", "time": 14850.71, "timestamp": "04:07:30", "text": "うん。うん。もちろん。もちろん。大丈夫です。それ"}, {"type": "chat", "time": 14851.676, "timestamp": "04:07:31", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "yippe "}, {"type": "subtitle", "time": 14852.87, "timestamp": "04:07:32", "text": "ありのままの自分でいられる。それはまるで"}, {"type": "subtitle", "time": 14854.91, "timestamp": "04:07:34", "text": "それは、えっと"}, {"type": "chat", "time": 14857.897, "timestamp": "04:07:37", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "lets get political"}, {"type": "subtitle", "time": 14857.99, "timestamp": "04:07:37", "text": "あなた方全員がしなければならない共産主義"}, {"type": "subtitle", "time": 14860.79, "timestamp": "04:07:40", "text": "たくさんの仕事をし、誰であろうと"}, {"type": "subtitle", "time": 14863.83, "timestamp": "04:07:43", "text": "どちらがより多くの仕事をするか、どちらがより少ない仕事をするか"}, {"type": "subtitle", "time": 14866.87, "timestamp": "04:07:46", "text": "全員が同じ額の報酬を受け取ります。"}, {"type": "subtitle", "time": 14870.71, "timestamp": "04:07:50", "text": "うん。そのため、その恩恵を受けるには"}, {"type": "subtitle", "time": 14874.67, "timestamp": "04:07:54", "text": "単独の飛行隊に加わる"}, {"type": "subtitle", "time": 14878.15, "timestamp": "04:07:58", "text": "活動的、比較的活動的。アクティブです"}]
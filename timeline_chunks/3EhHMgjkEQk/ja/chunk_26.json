[{"type": "subtitle", "time": 1561.669, "timestamp": "00:26:01", "text": "その背後にあるポイントを理解してください"}, {"type": "subtitle", "time": 1565.19, "timestamp": "00:26:05", "text": "あまり不均一にならないようにしたいので、"}, {"type": "subtitle", "time": 1567.35, "timestamp": "00:26:07", "text": "それは少し"}, {"type": "subtitle", "time": 1570.549, "timestamp": "00:26:10", "text": "やりにくい。でも、好きじゃない"}, {"type": "subtitle", "time": 1573.19, "timestamp": "00:26:13", "text": "それに挑戦する人たち。"}, {"type": "subtitle", "time": 1575.19, "timestamp": "00:26:15", "text": "そして彼らが外を見ているときでさえ"}, {"type": "subtitle", "time": 1578.149, "timestamp": "00:26:18", "text": "そのため。そうそう。そして、"}, {"type": "subtitle", "time": 1580.789, "timestamp": "00:26:20", "text": "チャットでのやり取りのことですよね？いいね"}, {"type": "subtitle", "time": 1583.51, "timestamp": "00:26:23", "text": "コラボレーションが予定されていたと言い、コラボレーション"}, {"type": "subtitle", "time": 1585.75, "timestamp": "00:26:25", "text": "いろいろなことが起こっています。いいえ、もし"}, {"type": "subtitle", "time": 1588.149, "timestamp": "00:26:28", "text": "チャットでのやり取りが少なくなっている"}, {"type": "subtitle", "time": 1591.669, "timestamp": "00:26:31", "text": "パートナー側のものか何か"}, {"type": "subtitle", "time": 1594.31, "timestamp": "00:26:34", "text": "そして一日の終わりには"}, {"type": "subtitle", "time": 1596.39, "timestamp": "00:26:36", "text": "それを悪いコラボレーションと考えるか、"}, {"type": "subtitle", "time": 1600.87, "timestamp": "00:26:40", "text": "何か。私は「えっ？」って感じでした。それはあることだ"}, {"type": "subtitle", "time": 1604.549, "timestamp": "00:26:44", "text": "チャットでのやり取りも重要です。"}, {"type": "subtitle", "time": 1608.07, "timestamp": "00:26:48", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 1609.75, "timestamp": "00:26:49", "text": "コマーシャルでそれを行う場合"}, {"type": "subtitle", "time": 1611.75, "timestamp": "00:26:51", "text": "規模については、理解できます。でも、もしあなたが"}, {"type": "subtitle", "time": 1614.31, "timestamp": "00:26:54", "text": "まるで友達になったかのように一緒に過ごす"}, {"type": "subtitle", "time": 1615.909, "timestamp": "00:26:55", "text": "共同作業を行う相手と。"}, {"type": "subtitle", "time": 1618.31, "timestamp": "00:26:58", "text": "友達とコラボレーションする場合は、"}, {"type": "subtitle", "time": 1619.909, "timestamp": "00:26:59", "text": "もし友達と一緒にやっているなら、私は"}]
[{"type": "subtitle", "time": 4633.59, "timestamp": "01:17:13", "text": "ジョー、何があったんだ？どこにいるの？"}, {"type": "subtitle", "time": 4635.91, "timestamp": "01:17:15", "text": "おい、それが俺が君に聞きたいことなんだ。私は"}, {"type": "subtitle", "time": 4640.669, "timestamp": "01:17:20", "text": "あなたを探しています。何てことだ。私が"}, {"type": "subtitle", "time": 4643.39, "timestamp": "01:17:23", "text": "どこから来たのか見てみよう"}, {"type": "subtitle", "time": 4647.31, "timestamp": "01:17:27", "text": "から？あれは何の飛行機ですか？"}, {"type": "subtitle", "time": 4651.27, "timestamp": "01:17:31", "text": "だから、私の飛行機はまた持っていない"}, {"type": "subtitle", "time": 4653.27, "timestamp": "01:17:33", "text": "現時点では航空機を選んでいません"}, {"type": "subtitle", "time": 4654.75, "timestamp": "01:17:34", "text": "得意なこと"}, {"type": "subtitle", "time": 4663.99, "timestamp": "01:17:43", "text": "強力だ。だから、私はこうすればいいんです。"}, {"type": "subtitle", "time": 4672.79, "timestamp": "01:17:52", "text": "ああ、あなたは本当に私を殺したのね。うん。"}, {"type": "subtitle", "time": 4674.39, "timestamp": "01:17:54", "text": "ニース。私の銃もずっと"}, {"type": "subtitle", "time": 4675.91, "timestamp": "01:17:55", "text": "強力だ。そういうことだ。あなたはしたい"}, {"type": "subtitle", "time": 4679.27, "timestamp": "01:17:59", "text": "実際の試合に出てみる？うん。うん。"}]
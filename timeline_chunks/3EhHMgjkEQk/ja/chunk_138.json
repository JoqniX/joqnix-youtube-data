[{"type": "subtitle", "time": 8281.19, "timestamp": "02:18:01", "text": "青い飛行機のように見えるでしょう"}, {"type": "subtitle", "time": 8283.83, "timestamp": "02:18:03", "text": "そして赤い飛行機。ええ、それはあなたの"}, {"type": "subtitle", "time": 8286.07, "timestamp": "02:18:06", "text": "チームメイトと敵チーム。彼らは持っている"}, {"type": "subtitle", "time": 8287.75, "timestamp": "02:18:07", "text": "彼らは十分にうまくやってきたし、"}, {"type": "subtitle", "time": 8289.87, "timestamp": "02:18:09", "text": "選択済み"}, {"type": "subtitle", "time": 8292.15, "timestamp": "02:18:12", "text": "いくつかの。つまり、これから"}, {"type": "subtitle", "time": 8294.79, "timestamp": "02:18:14", "text": "敵の爆撃機になる"}, {"type": "subtitle", "time": 8304.87, "timestamp": "02:18:24", "text": "ああ、あなたは今観戦しているのですか？うん。私"}, {"type": "subtitle", "time": 8307.509, "timestamp": "02:18:27", "text": "仮に戦車が2台しかなかったとしましょう。あなたはできる"}, {"type": "subtitle", "time": 8316.75, "timestamp": "02:18:36", "text": "はい、どうぞ。何てことだ。これは何ですか"}, {"type": "subtitle", "time": 8320.79, "timestamp": "02:18:40", "text": "もの？くそ。小型銃を搭載した車"}, {"type": "subtitle", "time": 8325.27, "timestamp": "02:18:45", "text": "そして、大きな銃。それは車です。そう、それは"}, {"type": "subtitle", "time": 8328.07, "timestamp": "02:18:48", "text": "装甲車。"}, {"type": "subtitle", "time": 8330.95, "timestamp": "02:18:50", "text": "つまり、戦車では、メイン武器だけではなく"}, {"type": "subtitle", "time": 8338.95, "timestamp": "02:18:58", "text": "種類。気をつけなければならない。よし、今私は"}]
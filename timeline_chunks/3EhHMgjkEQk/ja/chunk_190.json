[{"type": "subtitle", "time": 11400.309, "timestamp": "03:10:00", "text": "これで、"}, {"type": "subtitle", "time": 11401.75, "timestamp": "03:10:01", "text": "何度でもお好きなだけ。あなたは持っていません"}, {"type": "subtitle", "time": 11405.51, "timestamp": "03:10:05", "text": "そこに座る。カメラに着陸してください。"}, {"type": "subtitle", "time": 11412.51, "timestamp": "03:10:12", "text": "わかった。"}, {"type": "subtitle", "time": 11415.99, "timestamp": "03:10:15", "text": "おお。彼らはどうやってそれを実現するのか？"}, {"type": "subtitle", "time": 11419.349, "timestamp": "03:10:19", "text": "ええと、ゴムのように使う方法を知っていますか？"}, {"type": "subtitle", "time": 11421.67, "timestamp": "03:10:21", "text": "バンドに石を入れて、"}, {"type": "subtitle", "time": 11423.67, "timestamp": "03:10:23", "text": "岩をパチンコで飛ばす？あなたは"}, {"type": "subtitle", "time": 11426.59, "timestamp": "03:10:26", "text": "それに突っ込んでください。注意深い。"}, {"type": "subtitle", "time": 11428.95, "timestamp": "03:10:28", "text": "うん。岩を"}, {"type": "subtitle", "time": 11439.19, "timestamp": "03:10:39", "text": "あなたはそれをしたことがありますか？うん。"}, {"type": "subtitle", "time": 11441.19, "timestamp": "03:10:41", "text": "うん。つまり、スリングショットは船であり、"}, {"type": "subtitle", "time": 11448.87, "timestamp": "03:10:48", "text": "おお。あの金属片、あの灰色"}, {"type": "subtitle", "time": 11450.71, "timestamp": "03:10:50", "text": "あなたの飛行機が駐機していた滑走路、"}, {"type": "subtitle", "time": 11452.63, "timestamp": "03:10:52", "text": "基本的に底に引っ掛ける"}, {"type": "subtitle", "time": 11454.55, "timestamp": "03:10:54", "text": "あなたの飛行機。"}, {"type": "subtitle", "time": 11457.51, "timestamp": "03:10:57", "text": "そして加速した瞬間に、"}, {"type": "subtitle", "time": 11459.19, "timestamp": "03:10:59", "text": "あなたは船から降りる。だからあなたは"}]
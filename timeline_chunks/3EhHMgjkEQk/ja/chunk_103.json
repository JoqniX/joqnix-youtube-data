[{"type": "subtitle", "time": 6185.189, "timestamp": "01:43:05", "text": "私は4位か5位上になる必要がある"}, {"type": "subtitle", "time": 6189.27, "timestamp": "01:43:09", "text": "私たち。うん。この飛行機を購入するために、"}, {"type": "subtitle", "time": 6192.39, "timestamp": "01:43:12", "text": "どんなレベルでもこの​​レベルに到達しなければならない"}, {"type": "subtitle", "time": 6194.229, "timestamp": "01:43:14", "text": "他の国。"}, {"type": "subtitle", "time": 6198.229, "timestamp": "01:43:18", "text": "ああ、じゃあ最終的に3.3になったとしよう"}, {"type": "subtitle", "time": 6201.669, "timestamp": "01:43:21", "text": "アメリカまたは日本で飛行機に乗ると、"}, {"type": "subtitle", "time": 6204.629, "timestamp": "01:43:24", "text": "イスラエルに切り替える。また、あなたは"}, {"type": "subtitle", "time": 6207.31, "timestamp": "01:43:27", "text": "お金"}, {"type": "subtitle", "time": 6211.07, "timestamp": "01:43:31", "text": "いつもそうだ。もちろん、"}, {"type": "subtitle", "time": 6219.59, "timestamp": "01:43:39", "text": "くそ。今や戦車は完全に"}, {"type": "subtitle", "time": 6221.51, "timestamp": "01:43:41", "text": "全く別のもの。"}, {"type": "subtitle", "time": 6223.03, "timestamp": "01:43:43", "text": "ああ、"}, {"type": "subtitle", "time": 6225.59, "timestamp": "01:43:45", "text": "同じものが手に入ります。えっと、なんて言うんでしたっけ？"}, {"type": "subtitle", "time": 6227.59, "timestamp": "01:43:47", "text": "X線のようなもの、飛行機のようなもの、でもすべてが"}, {"type": "subtitle", "time": 6230.82, "timestamp": "01:43:50", "text": "それ以外の場合は全く異なる。"}]
[{"type": "subtitle", "time": 9541.23, "timestamp": "02:39:01", "text": "さもなければ、"}, {"type": "subtitle", "time": 9544.07, "timestamp": "02:39:04", "text": "莫大な金額を支払って"}, {"type": "subtitle", "time": 9547.03, "timestamp": "02:39:07", "text": "失敗した場合は、後で飛行機に乗ればいい。"}, {"type": "subtitle", "time": 9549.19, "timestamp": "02:39:09", "text": "おお。"}, {"type": "subtitle", "time": 9551.91, "timestamp": "02:39:11", "text": "さて、最新のものを導入するかどうかという点では"}, {"type": "subtitle", "time": 9555.11, "timestamp": "02:39:15", "text": "もの？最も遅く、最新の"}, {"type": "subtitle", "time": 9557.67, "timestamp": "02:39:17", "text": "彼らが搭載したのはフランス製の飛行機だ"}, {"type": "subtitle", "time": 9561.83, "timestamp": "02:39:21", "text": "これは2010年代初頭頃のものだと思います。"}, {"type": "subtitle", "time": 9568.27, "timestamp": "02:39:28", "text": "しかし、私たちにとって"}, {"type": "subtitle", "time": 9571.51, "timestamp": "02:39:31", "text": "理解してください、それは2010年代のものです、なぜなら"}, {"type": "subtitle", "time": 9573.349, "timestamp": "02:39:33", "text": "飛行機はまだ飛んでいて、"}, {"type": "subtitle", "time": 9577.349, "timestamp": "02:39:37", "text": "最新かつ最高レベルのものの一つと考えられている"}, {"type": "subtitle", "time": 9580.03, "timestamp": "02:39:40", "text": "アメリカ以外の国の技術飛行機"}, {"type": "subtitle", "time": 9583.03, "timestamp": "02:39:43", "text": "飛行機。それでは、フランスの技術ツリーに進んでください。"}, {"type": "subtitle", "time": 9585.59, "timestamp": "02:39:45", "text": "それを視聴者に見せることができます。また、"}, {"type": "subtitle", "time": 9587.27, "timestamp": "02:39:47", "text": "リアルタイムでは確認できないので、"}, {"type": "subtitle", "time": 9589.67, "timestamp": "02:39:49", "text": "リアルタイムでご案内できます。わかった、"}, {"type": "subtitle", "time": 9592.389, "timestamp": "02:39:52", "text": "友達。"}, {"type": "subtitle", "time": 9594.07, "timestamp": "02:39:54", "text": "研究。"}]
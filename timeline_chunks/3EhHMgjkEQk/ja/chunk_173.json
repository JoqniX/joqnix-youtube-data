[{"type": "subtitle", "time": 10380.79, "timestamp": "02:53:00", "text": "赤い点を合わせてから、"}, {"type": "subtitle", "time": 10391.19, "timestamp": "02:53:11", "text": "あぁ、彼を殴ってしまった。"}, {"type": "subtitle", "time": 10393.11, "timestamp": "02:53:13", "text": "ええ、もっと正確にする必要があります"}, {"type": "subtitle", "time": 10395.15, "timestamp": "02:53:15", "text": "破壊する"}, {"type": "subtitle", "time": 10399.71, "timestamp": "02:53:19", "text": "彼ら。そしてそれがあなたの航空機です"}, {"type": "subtitle", "time": 10403.429, "timestamp": "02:53:23", "text": "運送業者。さて、これは"}, {"type": "subtitle", "time": 10405.269, "timestamp": "02:53:25", "text": "着陸するほど簡単ではない"}, {"type": "subtitle", "time": 10407.11, "timestamp": "02:53:27", "text": "地面。"}, {"type": "subtitle", "time": 10410.07, "timestamp": "02:53:30", "text": "だから、気をつけてください。距離を保ってください。行く"}, {"type": "subtitle", "time": 10412.87, "timestamp": "02:53:32", "text": "空母のはるか後方。"}, {"type": "subtitle", "time": 10428.95, "timestamp": "02:53:48", "text": "ロール。また、ブルースの意見に賛成せざるを得ない。"}, {"type": "subtitle", "time": 10439.83, "timestamp": "02:53:59", "text": "ああ、そういうこともあるんですね。ほら、それが"}]
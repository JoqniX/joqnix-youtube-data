[{"type": "subtitle", "time": 561.91, "timestamp": "00:09:21", "text": "カットシーンやその他すべてに多くの時間がかかる"}, {"type": "subtitle", "time": 563.31, "timestamp": "00:09:23", "text": "の"}, {"type": "subtitle", "time": 566.19, "timestamp": "00:09:26", "text": "その間。はい、ゲームが起動しました"}, {"type": "subtitle", "time": 569.07, "timestamp": "00:09:29", "text": "大丈夫。私は完全に"}, {"type": "subtitle", "time": 588.75, "timestamp": "00:09:48", "text": "遅れている。なぜ"}]
[{"type": "subtitle", "time": 3300.15, "timestamp": "00:55:00", "text": "飛行機1機あたり。飛行機は何機ありますか？"}, {"type": "subtitle", "time": 3303.71, "timestamp": "00:55:03", "text": "合計で45,000以上あります"}, {"type": "subtitle", "time": 3305.23, "timestamp": "00:55:05", "text": "違う"}, {"type": "subtitle", "time": 3307.19, "timestamp": "00:55:07", "text": "車両の中で私が言うと"}, {"type": "subtitle", "time": 3310.27, "timestamp": "00:55:10", "text": "少なくとも500人は"}, {"type": "subtitle", "time": 3313.43, "timestamp": "00:55:13", "text": "保険料。そして私はそこで見た"}, {"type": "subtitle", "time": 3315.589, "timestamp": "00:55:15", "text": "さて、Lを押すと、"}, {"type": "subtitle", "time": 3321.43, "timestamp": "00:55:21", "text": "それは何ですか？"}, {"type": "subtitle", "time": 3323.589, "timestamp": "00:55:23", "text": "煙です。それは何て言うんだっけ？"}, {"type": "subtitle", "time": 3326.75, "timestamp": "00:55:26", "text": "曲技飛行モード。ただ"}, {"type": "subtitle", "time": 3330.309, "timestamp": "00:55:30", "text": "では、あなたはそれをどのように行っているのですか？"}, {"type": "subtitle", "time": 3333.67, "timestamp": "00:55:33", "text": "キーボードを試着してみましょう。見る？"}, {"type": "subtitle", "time": 3336.71, "timestamp": "00:55:36", "text": "うん。私は持っていません。どうぞ。私"}, {"type": "subtitle", "time": 3342.069, "timestamp": "00:55:42", "text": "Cキーを押してマウスを使用してください。後ろを振り返る"}, {"type": "subtitle", "time": 3343.91, "timestamp": "00:55:43", "text": "あなた。ちなみに、もう一度Lキーを押してください。うん、"}, {"type": "subtitle", "time": 3346.87, "timestamp": "00:55:46", "text": "よし、これでいい。"}, {"type": "subtitle", "time": 3348.549, "timestamp": "00:55:48", "text": "おお、"}, {"type": "subtitle", "time": 3350.27, "timestamp": "00:55:50", "text": "ただ振り向くだけ"}, {"type": "subtitle", "time": 3359.19, "timestamp": "00:55:59", "text": "見えますか？うん。もし私が移動しているなら"}]
[{"type": "subtitle", "time": 11522.389, "timestamp": "03:12:02", "text": "惜しいけど、違う。これも面白い。"}, {"type": "subtitle", "time": 11525.19, "timestamp": "03:12:05", "text": "心配しないで、クラッシュするのはたった2秒だけだよ"}, {"type": "subtitle", "time": 11527.83, "timestamp": "03:12:07", "text": "最初の1ヶ月は2秒ごとに。後"}, {"type": "subtitle", "time": 11530.7, "timestamp": "03:12:10", "text": "すぐにコツをつかめるよ。"}, {"type": "subtitle", "time": 11532.79, "timestamp": "03:12:12", "text": "[音楽]"}, {"type": "subtitle", "time": 11536.63, "timestamp": "03:12:16", "text": "そう、銃が発砲しない方法"}, {"type": "subtitle", "time": 11539.67, "timestamp": "03:12:19", "text": "あなた自身のプロペラは、"}, {"type": "subtitle", "time": 11541.429, "timestamp": "03:12:21", "text": "ご存知のように、車にはクランクシャフトがあり、"}, {"type": "subtitle", "time": 11543.429, "timestamp": "03:12:23", "text": "右？あなたの"}, {"type": "subtitle", "time": 11546.15, "timestamp": "03:12:26", "text": "エンジンとタイヤ。"}, {"type": "subtitle", "time": 11548.389, "timestamp": "03:12:28", "text": "ちょうどそのように、ロッドが接続されています"}, {"type": "subtitle", "time": 11550.87, "timestamp": "03:12:30", "text": "車軸とクランクシャフト。棒がある"}, {"type": "subtitle", "time": 11552.309, "timestamp": "03:12:32", "text": "エンジンとプロペラを接続する"}, {"type": "subtitle", "time": 11554.95, "timestamp": "03:12:34", "text": "飛行機の中で。"}, {"type": "subtitle", "time": 11558.87, "timestamp": "03:12:38", "text": "彼らがやったことは、"}, {"type": "subtitle", "time": 11567.349, "timestamp": "03:12:47", "text": "そして彼らはあなたの"}, {"type": "subtitle", "time": 11569.91, "timestamp": "03:12:49", "text": "コックピットでトリガーがクリックされると"}, {"type": "subtitle", "time": 11571.99, "timestamp": "03:12:51", "text": "接続または切断"}, {"type": "subtitle", "time": 11574.63, "timestamp": "03:12:54", "text": "衝撃が加わると実際の銃の引き金が引かれる"}, {"type": "subtitle", "time": 11577.32, "timestamp": "03:12:57", "text": "邪魔になる。"}, {"type": "subtitle", "time": 11578.389, "timestamp": "03:12:58", "text": "[音楽]"}]
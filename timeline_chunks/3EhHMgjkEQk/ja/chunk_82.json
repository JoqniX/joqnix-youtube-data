[{"type": "subtitle", "time": 4922.79, "timestamp": "01:22:02", "text": "無料です。複数に分割される"}, {"type": "subtitle", "time": 4925.83, "timestamp": "01:22:05", "text": "飛行機の種類。最初の行は"}, {"type": "subtitle", "time": 4927.47, "timestamp": "01:22:07", "text": "あなたの"}, {"type": "subtitle", "time": 4930.189, "timestamp": "01:22:10", "text": "飛行性能に優れた迎撃機"}, {"type": "subtitle", "time": 4933.669, "timestamp": "01:22:13", "text": "速くて遠くから、大きな銃を持って"}, {"type": "subtitle", "time": 4935.43, "timestamp": "01:22:15", "text": "しかし、それらはうまく回転しない。あなたの2番目"}, {"type": "subtitle", "time": 4937.43, "timestamp": "01:22:17", "text": "そして3行目は一般的に"}, {"type": "subtitle", "time": 4939.99, "timestamp": "01:22:19", "text": "あなたの戦士たち。"}, {"type": "subtitle", "time": 4941.83, "timestamp": "01:22:21", "text": "彼らは素早く方向転換できる。彼らはできる、彼らは"}, {"type": "subtitle", "time": 4943.35, "timestamp": "01:22:23", "text": "ほら、彼らは何でもできるんだよ"}, {"type": "subtitle", "time": 4945.91, "timestamp": "01:22:25", "text": "しかし、最高とは言えない。そして最後の2つ"}, {"type": "subtitle", "time": 4953.83, "timestamp": "01:22:33", "text": "爆撃。その後、あなたが見ている場所"}, {"type": "subtitle", "time": 4956.47, "timestamp": "01:22:36", "text": "赤いスペースじゃない、それだけだよ"}, {"type": "subtitle", "time": 4959.75, "timestamp": "01:22:39", "text": "高級車。"}, {"type": "subtitle", "time": 4961.75, "timestamp": "01:22:41", "text": "試乗できる高級車"}, {"type": "subtitle", "time": 4963.83, "timestamp": "01:22:43", "text": "いつでも。例えば、クリックすると"}, {"type": "subtitle", "time": 4966.229, "timestamp": "01:22:46", "text": "最後の３つのうちのどれか、"}, {"type": "subtitle", "time": 4968.709, "timestamp": "01:22:48", "text": "チェックアウト中、"}, {"type": "subtitle", "time": 4971.669, "timestamp": "01:22:51", "text": "下位3位。これを試してみてもいいですか？"}, {"type": "subtitle", "time": 4974.31, "timestamp": "01:22:54", "text": "ジェット？うん、やってみて。"}, {"type": "subtitle", "time": 4976.39, "timestamp": "01:22:56", "text": "待って、そうする前に。ああ、そうだね。よし、行くよ"}, {"type": "subtitle", "time": 4978.87, "timestamp": "01:22:58", "text": "それに対して。行く。退団しなければならない"}]
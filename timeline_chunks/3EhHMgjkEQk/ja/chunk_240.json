[{"type": "subtitle", "time": 14400.71, "timestamp": "04:00:00", "text": "わかった。では、少しペースを落としますので"}, {"type": "subtitle", "time": 14403.349, "timestamp": "04:00:03", "text": "ここへ来ることができます。これからその方法をお見せします"}, {"type": "subtitle", "time": 14406.309, "timestamp": "04:00:06", "text": "低空飛行する。真実。もし私を撃ったら、"}, {"type": "subtitle", "time": 14415.189, "timestamp": "04:00:15", "text": "わかった。私は待っています。私は待っています。私は"}, {"type": "subtitle", "time": 14421.469, "timestamp": "04:00:21", "text": "わかった。"}, {"type": "subtitle", "time": 14424.389, "timestamp": "04:00:24", "text": "さあ、私の翼に並んでください。"}, {"type": "subtitle", "time": 14427.189, "timestamp": "04:00:27", "text": "もう少し遠くまで行きます"}, {"type": "subtitle", "time": 14430.71, "timestamp": "04:00:30", "text": "そして、私は向きを変えます。わかった。"}, {"type": "subtitle", "time": 14432.469, "timestamp": "04:00:32", "text": "私は街へ行きます。見ていればいい"}]
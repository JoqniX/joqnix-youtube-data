[{"type": "subtitle", "time": 6600.87, "timestamp": "01:50:00", "text": "うん。くそ。ニース。"}, {"type": "subtitle", "time": 6602.55, "timestamp": "01:50:02", "text": "ほら、注意していれば、"}, {"type": "subtitle", "time": 6609.07, "timestamp": "01:50:09", "text": "よし、"}, {"type": "subtitle", "time": 6612.87, "timestamp": "01:50:12", "text": "行く。ああ、これは実際にやらなきゃいけないんだ。"}, {"type": "subtitle", "time": 6615.91, "timestamp": "01:50:15", "text": "ああ、離陸しないといけないよ。勝利は"}, {"type": "subtitle", "time": 6617.91, "timestamp": "01:50:17", "text": "近い。"}, {"type": "subtitle", "time": 6619.47, "timestamp": "01:50:19", "text": "デアデビルをやろう"}, {"type": "subtitle", "time": 6622.87, "timestamp": "01:50:22", "text": "脱ぐ。うん。"}, {"type": "subtitle", "time": 6625.91, "timestamp": "01:50:25", "text": "何てことだ。"}, {"type": "subtitle", "time": 6628.39, "timestamp": "01:50:28", "text": "心配しないで、ジョー。私はそれをプレイしました"}, {"type": "subtitle", "time": 6630.629, "timestamp": "01:50:30", "text": "何年も何年も。"}, {"type": "subtitle", "time": 6632.87, "timestamp": "01:50:32", "text": "あなたはプロですか？"}, {"type": "subtitle", "time": 6635.83, "timestamp": "01:50:35", "text": "うん。これらの人々はどうですか"}, {"type": "subtitle", "time": 6637.51, "timestamp": "01:50:37", "text": "生きている？代わりにクラッシュする"}, {"type": "subtitle", "time": 6639.03, "timestamp": "01:50:39", "text": "そうなったら私たちは話さないだろう"}, {"type": "subtitle", "time": 6646.39, "timestamp": "01:50:46", "text": "それはまさに爆撃機だ。爆撃機を見てください"}, {"type": "subtitle", "time": 6649.669, "timestamp": "01:50:49", "text": "亡くなったばかりだ。わかった。"}, {"type": "subtitle", "time": 6651.669, "timestamp": "01:50:51", "text": "では、爆撃機は誰ですか？一般的に保管"}, {"type": "subtitle", "time": 6654.83, "timestamp": "01:50:54", "text": "彼ら自身は非常に高い"}, {"type": "subtitle", "time": 6657.99, "timestamp": "01:50:57", "text": "上。はぁ。さあ、私たちの仕事はただ中に入るだけです"}]
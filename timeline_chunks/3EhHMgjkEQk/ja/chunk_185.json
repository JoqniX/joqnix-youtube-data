[{"type": "subtitle", "time": 11104.469, "timestamp": "03:05:04", "text": "それは、"}, {"type": "subtitle", "time": 11106.07, "timestamp": "03:05:06", "text": "船があなたに向かってくるか、あなたから遠ざかっていく"}, {"type": "subtitle", "time": 11121.87, "timestamp": "03:05:21", "text": "よし。いい感じにシャープ"}, {"type": "subtitle", "time": 11124.71, "timestamp": "03:05:24", "text": "旋回。あなたは船にかなり近いところにいます"}, {"type": "subtitle", "time": 11126.83, "timestamp": "03:05:26", "text": "しかも斜めの角度で。"}, {"type": "subtitle", "time": 11129.67, "timestamp": "03:05:29", "text": "まずはそれを支持することから始めてください。"}, {"type": "subtitle", "time": 11138.349, "timestamp": "03:05:38", "text": "また、その仕事をしている間、はい、クイズ"}, {"type": "subtitle", "time": 11143.269, "timestamp": "03:05:43", "text": "航空機について。わかった。ワールド"}, {"type": "subtitle", "time": 11145.269, "timestamp": "03:05:45", "text": "第一次世界大戦と第二次世界大戦、これら全て"}, {"type": "subtitle", "time": 11148.389, "timestamp": "03:05:48", "text": "プロペラ機には銃が付いていた"}, {"type": "subtitle", "time": 11155.11, "timestamp": "03:05:55", "text": "そして彼らは、ほら、指差して"}, {"type": "subtitle", "time": 11157.269, "timestamp": "03:05:57", "text": "敵機に向かって飛行機を撃ち、"}]
[{"type": "subtitle", "time": 5220.669, "timestamp": "01:27:00", "text": "まっすぐ飛んで、実際にこれを下ります"}, {"type": "subtitle", "time": 5223.75, "timestamp": "01:27:03", "text": "方法。地面に向かって進んでください。"}, {"type": "subtitle", "time": 5226.47, "timestamp": "01:27:06", "text": "地形について教えます"}, {"type": "subtitle", "time": 5228.79, "timestamp": "01:27:08", "text": "抱きしめて登る。それが一番怖い"}, {"type": "subtitle", "time": 5232.55, "timestamp": "01:27:12", "text": "そして、危険な種類のハエだ。ああ、これらは"}, {"type": "subtitle", "time": 5236.47, "timestamp": "01:27:16", "text": "リアルな実際の地形？"}, {"type": "subtitle", "time": 5240.35, "timestamp": "01:27:20", "text": "えっと、ゲームの地形ですね。 H、近いですね"}, {"type": "subtitle", "time": 5242.709, "timestamp": "01:27:22", "text": "十分。わかった。気をつけろ、気をつけろ。上へ、上へ、"}, {"type": "subtitle", "time": 5247.03, "timestamp": "01:27:27", "text": "上へ、上へ。ええ、クラッシュしました。いいえ、それは"}, {"type": "subtitle", "time": 5249.59, "timestamp": "01:27:29", "text": "遅れている。地面に身を寄せろ。あなたは持っていません"}, {"type": "subtitle", "time": 5255.83, "timestamp": "01:27:35", "text": "よし。あなたはベッドに行かない"}, {"type": "subtitle", "time": 5258.95, "timestamp": "01:27:38", "text": "銃。触れるだけでいいんです。よし。わかった。"}, {"type": "subtitle", "time": 5265.51, "timestamp": "01:27:45", "text": "もっと早く。もっと、もっと、もっと、もっと、もっと引き上げて、"}, {"type": "subtitle", "time": 5266.99, "timestamp": "01:27:46", "text": "もっと、もっと、"}, {"type": "subtitle", "time": 5270.709, "timestamp": "01:27:50", "text": "もっと。わかった。良い。良い。良い。良い。今、"}, {"type": "subtitle", "time": 5273.51, "timestamp": "01:27:53", "text": "ジョー、飛行機に乗ると"}, {"type": "subtitle", "time": 5274.95, "timestamp": "01:27:54", "text": "ジェット機には、"}, {"type": "subtitle", "time": 5277.11, "timestamp": "01:27:57", "text": "圧縮。下を指さして行く"}, {"type": "subtitle", "time": 5279.35, "timestamp": "01:27:59", "text": "地面に向かって引っ張ろうとする"}]
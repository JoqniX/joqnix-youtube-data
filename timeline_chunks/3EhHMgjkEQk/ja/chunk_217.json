[{"type": "subtitle", "time": 13020.79, "timestamp": "03:37:00", "text": "わかった。今、私がどれだけの高さにいるか見てください。わかった。"}, {"type": "subtitle", "time": 13024.309, "timestamp": "03:37:04", "text": "あなたは今どこにいるのですか？"}, {"type": "subtitle", "time": 13026.07, "timestamp": "03:37:06", "text": "あら、私の姿が見えないの？のように"}, {"type": "subtitle", "time": 13028.79, "timestamp": "03:37:08", "text": "あなたは私を観戦できないのですか？いや、いや、いや。"}, {"type": "subtitle", "time": 13032.389, "timestamp": "03:37:12", "text": "私はまさに飛行機の中にいます。秒"}, {"type": "subtitle", "time": 13033.91, "timestamp": "03:37:13", "text": "ああ、あなたは4階にいるんですね。ああ、素晴らしい。"}, {"type": "subtitle", "time": 13036.63, "timestamp": "03:37:16", "text": "素晴らしい。はい、はい、はい。では、入ってみます"}, {"type": "subtitle", "time": 13038.99, "timestamp": "03:37:18", "text": "あなたに向かって低空飛行しています。"}, {"type": "subtitle", "time": 13043.11, "timestamp": "03:37:23", "text": "わかった。私は現在、A地点から15km離れた場所にいます。"}, {"type": "subtitle", "time": 13045.429, "timestamp": "03:37:25", "text": "だから、私はかなり遠くにいるんです。"}, {"type": "subtitle", "time": 13047.99, "timestamp": "03:37:27", "text": "ミサイルを発射できると思いますか？"}, {"type": "subtitle", "time": 13053.429, "timestamp": "03:37:33", "text": "今の私？このような。やってみろ。"}, {"type": "subtitle", "time": 13055.71, "timestamp": "03:37:35", "text": "待って。少し登らせてください"}, {"type": "subtitle", "time": 13058.269, "timestamp": "03:37:38", "text": "少し。"}, {"type": "subtitle", "time": 13060.87, "timestamp": "03:37:40", "text": "そして今、私はレーダーをオンにする必要がある"}, {"type": "subtitle", "time": 13061.87, "timestamp": "03:37:41", "text": "狩猟する"}, {"type": "subtitle", "time": 13065.99, "timestamp": "03:37:45", "text": "あなた。だから、あなたに会わなければならないんです。"}, {"type": "subtitle", "time": 13068.79, "timestamp": "03:37:48", "text": "私は土の中にいる。ああ、君のことは分かったよ。"}, {"type": "subtitle", "time": 13070.389, "timestamp": "03:37:50", "text": "同じ場所。はい。ミサイルがある"}, {"type": "subtitle", "time": 13076.95, "timestamp": "03:37:56", "text": "地面にできるだけ低く身をかがめてください。抱きしめる"}, {"type": "subtitle", "time": 13078.79, "timestamp": "03:37:58", "text": "地面はまるで"}]
[{"type": "subtitle", "time": 13205.11, "timestamp": "03:40:05", "text": "待って、君が彼を殺す前に私は墜落したんだ。"}, {"type": "subtitle", "time": 13208.469, "timestamp": "03:40:08", "text": "はい。ああ、うまく隠れていたんですね。"}, {"type": "subtitle", "time": 13211.03, "timestamp": "03:40:11", "text": "建物の裏側。 6 7 の頃、君を見たよ"}, {"type": "subtitle", "time": 13214.55, "timestamp": "03:40:14", "text": "数キロメートル離れたが、ミサイルを照準することができなかった"}, {"type": "subtitle", "time": 13217.55, "timestamp": "03:40:17", "text": "君はいつも遅れているから"}, {"type": "subtitle", "time": 13219.75, "timestamp": "03:40:19", "text": "建物。だから、もしあなたが"}, {"type": "subtitle", "time": 13222.389, "timestamp": "03:40:22", "text": "物理的な障壁は、"}, {"type": "subtitle", "time": 13225.19, "timestamp": "03:40:25", "text": "私が持っているミサイルの種類。"}, {"type": "subtitle", "time": 13227.349, "timestamp": "03:40:27", "text": "あなたが柵の後ろにいるなら、私は"}, {"type": "subtitle", "time": 13229.75, "timestamp": "03:40:29", "text": "君を殴るよ。"}, {"type": "subtitle", "time": 13233.67, "timestamp": "03:40:33", "text": "ああ、起きなければならない、起きなければならない"}, {"type": "subtitle", "time": 13235.83, "timestamp": "03:40:35", "text": "すぐ隣であなたを殴るか、"}, {"type": "subtitle", "time": 13238.229, "timestamp": "03:40:38", "text": "障壁が十分に高いように"}, {"type": "subtitle", "time": 13241.75, "timestamp": "03:40:41", "text": "あなたを隠すには背が低すぎる。"}, {"type": "subtitle", "time": 13243.349, "timestamp": "03:40:43", "text": "おお、"}, {"type": "subtitle", "time": 13252.79, "timestamp": "03:40:52", "text": "飛行機は全部完成したようですね。うん。"}, {"type": "subtitle", "time": 13254.87, "timestamp": "03:40:54", "text": "リスポーンする方法はないの？"}, {"type": "subtitle", "time": 13256.71, "timestamp": "03:40:56", "text": "飛行機？"}, {"type": "subtitle", "time": 13258.55, "timestamp": "03:40:58", "text": "えっと、ご希望であればモードを変更することもできます。"}]
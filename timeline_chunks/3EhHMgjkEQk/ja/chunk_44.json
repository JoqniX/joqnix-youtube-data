[{"type": "subtitle", "time": 2643.03, "timestamp": "00:44:03", "text": "例えば、「ああ、私は船遊びが好きなんです」みたいな感じ。"}, {"type": "subtitle", "time": 2645.309, "timestamp": "00:44:05", "text": "それが現実さ。彼らは"}, {"type": "subtitle", "time": 2647.99, "timestamp": "00:44:07", "text": "それでも、彼らはまだ自分たちのことをしようとしている"}, {"type": "subtitle", "time": 2651.55, "timestamp": "00:44:11", "text": "船のためのもの。よくやった"}, {"type": "subtitle", "time": 2656.23, "timestamp": "00:44:16", "text": "彼ら。足りない。あ、待って。えっと、あなたは"}, {"type": "subtitle", "time": 2658.95, "timestamp": "00:44:18", "text": "参加するにはこちらもどうぞ。どうすれば参加できますか？"}, {"type": "subtitle", "time": 2666.109, "timestamp": "00:44:26", "text": "飛行隊。"}, {"type": "subtitle", "time": 2669.63, "timestamp": "00:44:29", "text": "えっと、待って。あなたを招待していませんでしたか？おお、"}, {"type": "subtitle", "time": 2673.19, "timestamp": "00:44:33", "text": "待って。ああ、あなたを招待した覚えはないわ。私のミスです。私"}, {"type": "subtitle", "time": 2677.03, "timestamp": "00:44:37", "text": "また招待された。よし。"}, {"type": "subtitle", "time": 2679.43, "timestamp": "00:44:39", "text": "うん、今君を追加したよ。忘れてしまった"}, {"type": "subtitle", "time": 2681.069, "timestamp": "00:44:41", "text": "あなたを招待します"}, {"type": "subtitle", "time": 2686.55, "timestamp": "00:44:46", "text": "よし、これでできる。どうぞ。"}, {"type": "subtitle", "time": 2687.71, "timestamp": "00:44:47", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 2698.309, "timestamp": "00:44:58", "text": "戦闘はゼロ。 Z. いいえ、私は"}, {"type": "subtitle", "time": 2699.91, "timestamp": "00:44:59", "text": "プレイしました。少なくともこのアカウントではそうではない。"}]
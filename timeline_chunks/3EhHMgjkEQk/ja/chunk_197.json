[{"type": "subtitle", "time": 11838.389, "timestamp": "03:17:18", "text": "ああ、これでいい。よし、行こう"}, {"type": "subtitle", "time": 11844.75, "timestamp": "03:17:24", "text": "私にさせて"}, {"type": "subtitle", "time": 11847.67, "timestamp": "03:17:27", "text": "見る。最後の一つは何ですか？ええ、そうです"}, {"type": "subtitle", "time": 11849.67, "timestamp": "03:17:29", "text": "最後の一つ。間違ったものを手に入れてしまいました。"}, {"type": "subtitle", "time": 11851.349, "timestamp": "03:17:31", "text": "これはトグル制御モードではありません。その"}, {"type": "subtitle", "time": 11852.19, "timestamp": "03:17:32", "text": "スイッチ"}, {"type": "subtitle", "time": 11855.67, "timestamp": "03:17:35", "text": "操縦する。うん。そして制限モード"}, {"type": "subtitle", "time": 11867.99, "timestamp": "03:17:47", "text": "あ、待って。あ、待って。何をしたの？"}, {"type": "subtitle", "time": 11870.71, "timestamp": "03:17:50", "text": "追加？これは絶対にキャンセルしないでください。"}, {"type": "subtitle", "time": 11873.51, "timestamp": "03:17:53", "text": "そこをクリックするだけです。もう一度クリックしてください。"}, {"type": "subtitle", "time": 11875.11, "timestamp": "03:17:55", "text": "うん。"}, {"type": "subtitle", "time": 11878.87, "timestamp": "03:17:58", "text": "はい、綴じ具を外してください。待って、私は"}]
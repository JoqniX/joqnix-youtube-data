[{"type": "subtitle", "time": 5761.11, "timestamp": "01:36:01", "text": "最近は以前よりずっとつまらなくなった。"}, {"type": "subtitle", "time": 5763.43, "timestamp": "01:36:03", "text": "でも、退屈だから"}, {"type": "subtitle", "time": 5767.51, "timestamp": "01:36:07", "text": "より安全。本当の戦いという意味で。"}, {"type": "subtitle", "time": 5769.189, "timestamp": "01:36:09", "text": "うん。"}, {"type": "subtitle", "time": 5771.83, "timestamp": "01:36:11", "text": "さて、試合に出場したいなら"}, {"type": "subtitle", "time": 5774.709, "timestamp": "01:36:14", "text": "私たちは試合に臨む。ええと、それらの"}, {"type": "subtitle", "time": 5777.03, "timestamp": "01:36:17", "text": "そのプレミアムラインナップ、"}, {"type": "subtitle", "time": 5779.43, "timestamp": "01:36:19", "text": "緑色の背景。"}, {"type": "subtitle", "time": 5781.75, "timestamp": "01:36:21", "text": "うん。飛行機が"}, {"type": "subtitle", "time": 5783.189, "timestamp": "01:36:23", "text": "緑色の背景。飛行機だけではなく、"}, {"type": "subtitle", "time": 5786.229, "timestamp": "01:36:26", "text": "戦車も参加できます"}, {"type": "subtitle", "time": 5788.95, "timestamp": "01:36:28", "text": "War Thunderの飛行隊"}, {"type": "subtitle", "time": 5790.87, "timestamp": "01:36:30", "text": "そして、そのままプレイを続けることができます。する"}, {"type": "subtitle", "time": 5792.629, "timestamp": "01:36:32", "text": "どの国でプレイしても関係ありません。それ"}, {"type": "subtitle", "time": 5793.99, "timestamp": "01:36:33", "text": "同じ国である必要はありません。"}, {"type": "subtitle", "time": 5797.669, "timestamp": "01:36:37", "text": "そのような類のもの。 2日ごとに、"}, {"type": "subtitle", "time": 5800.87, "timestamp": "01:36:40", "text": "異なる種類の経験値が得られます。"}, {"type": "subtitle", "time": 5802.59, "timestamp": "01:36:42", "text": "飛行隊が配属されます"}, {"type": "subtitle", "time": 5805.91, "timestamp": "01:36:45", "text": "XP。あとはゲームをプレイするだけです。"}, {"type": "subtitle", "time": 5808.47, "timestamp": "01:36:48", "text": "これでXPは蓄積され続ける"}, {"type": "subtitle", "time": 5811.43, "timestamp": "01:36:51", "text": "3～4ヶ月程度の期間"}, {"type": "subtitle", "time": 5813.51, "timestamp": "01:36:53", "text": "そして必要な量を満たします"}, {"type": "subtitle", "time": 5816.39, "timestamp": "01:36:56", "text": "緑色の飛行隊のXP"}, {"type": "subtitle", "time": 5818.629, "timestamp": "01:36:58", "text": "車両。だから飛行機はいつも"}]
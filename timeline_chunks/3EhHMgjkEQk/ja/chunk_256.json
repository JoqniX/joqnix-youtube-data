[{"type": "subtitle", "time": 15360.95, "timestamp": "04:16:00", "text": "最後に報酬が待っています。ああ、"}, {"type": "subtitle", "time": 15363.51, "timestamp": "04:16:03", "text": "そのバーを満たす最も簡単な方法"}, {"type": "subtitle", "time": 15365.429, "timestamp": "04:16:05", "text": "シミュレーターバトルをプレイすることです。しかし、"}, {"type": "subtitle", "time": 15368.63, "timestamp": "04:16:08", "text": "シミュレーターバトルの問題点は、"}, {"type": "subtitle", "time": 15371.67, "timestamp": "04:16:11", "text": "原子力分野で博士号を取得したい"}, {"type": "subtitle", "time": 15373.91, "timestamp": "04:16:13", "text": "物理演算よりもシミュレーターバトルをプレイする。"}, {"type": "subtitle", "time": 15376.309, "timestamp": "04:16:16", "text": "とても痛い。"}, {"type": "subtitle", "time": 15378.309, "timestamp": "04:16:18", "text": "おお、"}, {"type": "subtitle", "time": 15380.95, "timestamp": "04:16:20", "text": "できるけど、すごく痛いよ。"}, {"type": "subtitle", "time": 15383.07, "timestamp": "04:16:23", "text": "また、"}, {"type": "subtitle", "time": 15385.67, "timestamp": "04:16:25", "text": "制限 ええ。ほら、あなたは到達しなければならない"}, {"type": "subtitle", "time": 15387.67, "timestamp": "04:16:27", "text": "ある一定のレベル。これは新しいものです、"}, {"type": "subtitle", "time": 15389.349, "timestamp": "04:16:29", "text": "道。"}, {"type": "subtitle", "time": 15390.95, "timestamp": "04:16:30", "text": "私は中に入って、後ろの方へ歩いて行った"}, {"type": "subtitle", "time": 15393.91, "timestamp": "04:16:33", "text": "日。どこからでも自由に出入りできる。"}, {"type": "subtitle", "time": 15397.189, "timestamp": "04:16:37", "text": "今度は10機の飛行機を撃墜して"}, {"type": "subtitle", "time": 15399.99, "timestamp": "04:16:39", "text": "ここ。このゲームモードをアンロックしてください。 10人殺す"}, {"type": "subtitle", "time": 15401.99, "timestamp": "04:16:41", "text": "そのゲームモードをアンロックするにはタンクが必要です。全て"}, {"type": "subtitle", "time": 15403.99, "timestamp": "04:16:43", "text": "プロ。"}, {"type": "subtitle", "time": 15410.309, "timestamp": "04:16:50", "text": "でも、古いって言ってたよね"}, {"type": "subtitle", "time": 15413.83, "timestamp": "04:16:53", "text": "ゲーム。はい。でも30くらいで更新される"}, {"type": "subtitle", "time": 15416.55, "timestamp": "04:16:56", "text": "年に数回。"}]
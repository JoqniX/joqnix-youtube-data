[{"type": "subtitle", "time": 9780.63, "timestamp": "02:43:00", "text": "F14Aは新しいだけでなく、"}, {"type": "subtitle", "time": 9782.67, "timestamp": "02:43:02", "text": "古いトップ"}, {"type": "subtitle", "time": 9784.59, "timestamp": "02:43:04", "text": "銃。の"}, {"type": "subtitle", "time": 9787.75, "timestamp": "02:43:07", "text": "F14Aは、"}, {"type": "subtitle", "time": 9790.389, "timestamp": "02:43:10", "text": "翼。だから、それを試してみるのもいいかもしれません。"}, {"type": "subtitle", "time": 9792.389, "timestamp": "02:43:12", "text": "初め。"}, {"type": "subtitle", "time": 9795.19, "timestamp": "02:43:15", "text": "わかった。飛行試験をすべきでしょうか？うん、テスト"}, {"type": "subtitle", "time": 9797.91, "timestamp": "02:43:17", "text": "フライト。"}, {"type": "subtitle", "time": 9801.59, "timestamp": "02:43:21", "text": "ニース。また、あなたは"}, {"type": "subtitle", "time": 9803.75, "timestamp": "02:43:23", "text": "ええと、音速の壁を突破しました。あなたは"}, {"type": "subtitle", "time": 9806.87, "timestamp": "02:43:26", "text": "本作でそれを体験してください。"}, {"type": "chat", "time": 9807.66, "timestamp": "02:43:27", "author": "@BRUCELEE-wt7hk", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kywKa6HSckNVxhER8qedLRRVkcGIqFFytjQHe-071HyMo=s64-c-k-c0x00ffffff-no-rj", "message": "hello joqnix"}, {"type": "subtitle", "time": 9809.429, "timestamp": "02:43:29", "text": "何を破ってるの？"}, {"type": "subtitle", "time": 9810.95, "timestamp": "02:43:30", "text": "スピードを上げたときの音速の壁"}, {"type": "subtitle", "time": 9813.03, "timestamp": "02:43:33", "text": "音速よりも速い。"}, {"type": "subtitle", "time": 9816.95, "timestamp": "02:43:36", "text": "え、何？それは確かに存在する。うん。ジョー、私たちは"}, {"type": "subtitle", "time": 9819.429, "timestamp": "02:43:39", "text": "こっちにはジェット機が飛んでいる。ジェッツが行く"}, {"type": "subtitle", "time": 9822.389, "timestamp": "02:43:42", "text": "音速よりも速い。おお、"}, {"type": "subtitle", "time": 9824.15, "timestamp": "02:43:44", "text": "少なくとも軍用ジェット機はそうだが、旅客機はそうではない"}, {"type": "subtitle", "time": 9826.79, "timestamp": "02:43:46", "text": "1つ。それはまた、"}, {"type": "chat", "time": 9833.177, "timestamp": "02:43:53", "author": "@BRUCELEE-wt7hk", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kywKa6HSckNVxhER8qedLRRVkcGIqFFytjQHe-071HyMo=s64-c-k-c0x00ffffff-no-rj", "message": "how you doing"}]
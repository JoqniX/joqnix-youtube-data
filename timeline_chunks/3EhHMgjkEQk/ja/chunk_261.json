[{"type": "subtitle", "time": 15662.229, "timestamp": "04:21:02", "text": "もの。それ以外にも、War Thunder"}, {"type": "subtitle", "time": 15665.349, "timestamp": "04:21:05", "text": "実際には、このものがあります。あなたは何を"}, {"type": "subtitle", "time": 15669.83, "timestamp": "04:21:09", "text": "それを何と呼ぶ？ええと、今はトーナメントですね。おお、"}, {"type": "subtitle", "time": 15672.149, "timestamp": "04:21:12", "text": "そうすればプロプレイヤーになれるし、"}, {"type": "subtitle", "time": 15675.71, "timestamp": "04:21:15", "text": "トーナメントに参加すれば、"}, {"type": "subtitle", "time": 15679.67, "timestamp": "04:21:19", "text": "多く。また、あなたが"}, {"type": "subtitle", "time": 15681.429, "timestamp": "04:21:21", "text": "試合で、あなたは本当に"}, {"type": "subtitle", "time": 15683.469, "timestamp": "04:21:23", "text": "かっこいいとか、すごく面白くてかっこいい"}, {"type": "subtitle", "time": 15686.87, "timestamp": "04:21:26", "text": "起こった。レコードを記録できます"}, {"type": "subtitle", "time": 15688.469, "timestamp": "04:21:28", "text": "ゲームプレイ。記録しない"}, {"type": "subtitle", "time": 15690.95, "timestamp": "04:21:30", "text": "ビデオ。ゲームプレイ全体を記録します。"}, {"type": "subtitle", "time": 15692.63, "timestamp": "04:21:32", "text": "ゲームプレイでは、"}, {"type": "subtitle", "time": 15695.429, "timestamp": "04:21:35", "text": "角度、スピードアップ、ゲームをスローダウン"}, {"type": "subtitle", "time": 15697.51, "timestamp": "04:21:37", "text": "遊ぶ。別の飛行機に乗り換えることができます"}, {"type": "subtitle", "time": 15699.269, "timestamp": "04:21:39", "text": "すべて。"}, {"type": "subtitle", "time": 15702.07, "timestamp": "04:21:42", "text": "これはビデオファイルではなく、ゲームファイルです。"}, {"type": "subtitle", "time": 15703.75, "timestamp": "04:21:43", "text": "それはとても素晴らしいと思う。他の"}, {"type": "subtitle", "time": 15705.99, "timestamp": "04:21:45", "text": "ゲームもそうあるべきだ。"}, {"type": "subtitle", "time": 15709.51, "timestamp": "04:21:49", "text": "えっと、OBSで録画できますし、"}, {"type": "subtitle", "time": 15712.149, "timestamp": "04:21:52", "text": "War ThunderのPR部門に送ることができます"}, {"type": "subtitle", "time": 15714.71, "timestamp": "04:21:54", "text": "チーム。彼らはYouTubeチャンネルを持っている。彼らは"}, {"type": "subtitle", "time": 15717.51, "timestamp": "04:21:57", "text": "彼らに送る方法を教えます。"}, {"type": "subtitle", "time": 15719.91, "timestamp": "04:21:59", "text": "彼らに送ってもいいですよ。もし彼らが考えるなら"}]
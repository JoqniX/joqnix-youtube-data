[{"type": "subtitle", "time": 15783.309, "timestamp": "04:23:03", "text": "まあ、それは"}, {"type": "subtitle", "time": 15788.349, "timestamp": "04:23:08", "text": "結論として、これは水に関する教訓である。"}, {"type": "subtitle", "time": 15798.55, "timestamp": "04:23:18", "text": "楽しかったよ。このゲームをもっとプレイしたい。"}, {"type": "subtitle", "time": 15801.03, "timestamp": "04:23:21", "text": "しかし、自由時間も全くない。でも私はこれ"}, {"type": "subtitle", "time": 15803.11, "timestamp": "04:23:23", "text": "楽しかった。私はジェット機が欲しい。ああ、今"}, {"type": "subtitle", "time": 15809.11, "timestamp": "04:23:29", "text": "ジェット機の中で遊びたいんだよね？あなた"}, {"type": "subtitle", "time": 15810.63, "timestamp": "04:23:30", "text": "スリルを味わいたいですよね？あなたは欲しい"}, {"type": "subtitle", "time": 15812.55, "timestamp": "04:23:32", "text": "音速よりも速く移動する。"}, {"type": "subtitle", "time": 15815.59, "timestamp": "04:23:35", "text": "はい。ああ、しまった、カメラが。私は忘れていました"}, {"type": "subtitle", "time": 15817.91, "timestamp": "04:23:37", "text": "モデルについて。私は感情を表現しすぎている。私の"}, {"type": "subtitle", "time": 15825.99, "timestamp": "04:23:45", "text": "でも、ジョー、これが正しい道なんだよ。"}, {"type": "subtitle", "time": 15829.59, "timestamp": "04:23:49", "text": "ああ、わかった。そう、これが正しい道だ。あなた"}, {"type": "subtitle", "time": 15832.55, "timestamp": "04:23:52", "text": "光を見た。"}, {"type": "subtitle", "time": 15835.189, "timestamp": "04:23:55", "text": "あとは、見せることだけを知っていればよい"}, {"type": "subtitle", "time": 15837.83, "timestamp": "04:23:57", "text": "他の者は光を見る。"}, {"type": "subtitle", "time": 15839.91, "timestamp": "04:23:59", "text": "これは決してねずみ講ではありません。"}]
[{"type": "subtitle", "time": 10082.15, "timestamp": "02:48:02", "text": "ああ、これね。はい、それはあなたの空気です"}, {"type": "subtitle", "time": 10084.79, "timestamp": "02:48:04", "text": "ブラジャー。"}, {"type": "subtitle", "time": 10087.83, "timestamp": "02:48:07", "text": "さて、もしあなたが非常に野心的なら、"}, {"type": "subtitle", "time": 10089.75, "timestamp": "02:48:09", "text": "空母を作ってみてもいいですよ"}, {"type": "subtitle", "time": 10090.99, "timestamp": "02:48:10", "text": "着陸のように"}, {"type": "subtitle", "time": 10095.87, "timestamp": "02:48:15", "text": "この飛行機の中ではトップグ。え、本当に？"}, {"type": "subtitle", "time": 10099.75, "timestamp": "02:48:19", "text": "はい。まず、もう一度ヒットして、"}, {"type": "subtitle", "time": 10101.15, "timestamp": "02:48:21", "text": "あなたの空気"}, {"type": "subtitle", "time": 10103.91, "timestamp": "02:48:23", "text": "ブレーキをかけてエンジンのパワーを取り戻し、"}, {"type": "subtitle", "time": 10111.11, "timestamp": "02:48:31", "text": "空母"}, {"type": "subtitle", "time": 10113.51, "timestamp": "02:48:33", "text": "海の中にあります。"}, {"type": "subtitle", "time": 10121.429, "timestamp": "02:48:41", "text": "あなたの右側です。それは右側にあります"}, {"type": "subtitle", "time": 10132.309, "timestamp": "02:48:52", "text": "あなたは本当に遠くにいますね。"}, {"type": "subtitle", "time": 10136.469, "timestamp": "02:48:56", "text": "できない。この土地に着陸するだけだ。"}, {"type": "subtitle", "time": 10138.23, "timestamp": "02:48:58", "text": "ええ、でもあなたは"}]
[{"type": "subtitle", "time": 8766.19, "timestamp": "02:26:06", "text": "ちくしょう。それは"}, {"type": "subtitle", "time": 8768.15, "timestamp": "02:26:08", "text": "恥ずかしい。待って、聞こえないの？"}, {"type": "subtitle", "time": 8772.07, "timestamp": "02:26:12", "text": "こんにちは。分隊チャット。"}, {"type": "subtitle", "time": 8775.19, "timestamp": "02:26:15", "text": "このままにしておくことにします。まだミュートされています"}, {"type": "subtitle", "time": 8777.349, "timestamp": "02:26:17", "text": "私の"}, {"type": "subtitle", "time": 8780.63, "timestamp": "02:26:20", "text": "ああ、聞こえないの？"}, {"type": "subtitle", "time": 8783.75, "timestamp": "02:26:23", "text": "私の言っていることが聞こえないのか？"}, {"type": "subtitle", "time": 8785.67, "timestamp": "02:26:25", "text": "おお、"}, {"type": "subtitle", "time": 8787.51, "timestamp": "02:26:27", "text": "こんにちは。"}, {"type": "subtitle", "time": 8789.51, "timestamp": "02:26:29", "text": "どういうわけか、あなたの言っていることが全く聞こえません。"}, {"type": "subtitle", "time": 8792.15, "timestamp": "02:26:32", "text": "まるで死んだように完全に消え去った"}, {"type": "subtitle", "time": 8795.19, "timestamp": "02:26:35", "text": "静けさ。また、あなたのゲームが聞こえません"}, {"type": "subtitle", "time": 8798.75, "timestamp": "02:26:38", "text": "どちらでもプレイできます。待って、"}]
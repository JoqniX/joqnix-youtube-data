[{"type": "subtitle", "time": 3600.109, "timestamp": "01:00:00", "text": "ゲームがアップデートされるから"}, {"type": "subtitle", "time": 3602.87, "timestamp": "01:00:02", "text": "ゲームに小さなアップデートが来るように"}, {"type": "subtitle", "time": 3606.069, "timestamp": "01:00:06", "text": "年に10回から15回。大規模なアップデート"}, {"type": "subtitle", "time": 3608.63, "timestamp": "01:00:08", "text": "新しい車両には少なくとも次のようなものが付いています"}, {"type": "subtitle", "time": 3612.71, "timestamp": "01:00:12", "text": "年に2～3回"}, {"type": "subtitle", "time": 3615.349, "timestamp": "01:00:15", "text": "そしてそれらは大きなイベントに伴ってやってくる。"}, {"type": "subtitle", "time": 3617.109, "timestamp": "01:00:17", "text": "だからトップガン マーヴェリックの件は"}, {"type": "subtitle", "time": 3619.27, "timestamp": "01:00:19", "text": "ええ、そのことについて話していました。彼らは開始した"}, {"type": "subtitle", "time": 3621.27, "timestamp": "01:00:21", "text": "その飛行機とトレーラーは"}, {"type": "subtitle", "time": 3628.789, "timestamp": "01:00:28", "text": "実際の映画が公開されるまで待ちましょう。"}, {"type": "subtitle", "time": 3631.67, "timestamp": "01:00:31", "text": "まあ、映画のためではないけどね。彼らは"}, {"type": "subtitle", "time": 3634.309, "timestamp": "01:00:34", "text": "賢いマーケティング戦略で、"}, {"type": "subtitle", "time": 3637.27, "timestamp": "01:00:37", "text": "飛行機準備完了。彼らはたくさんのものを持っていた"}, {"type": "subtitle", "time": 3640.71, "timestamp": "01:00:40", "text": "いわゆるアップデートの準備ができました"}, {"type": "subtitle", "time": 3644.069, "timestamp": "01:00:44", "text": "そして、"}, {"type": "subtitle", "time": 3647.03, "timestamp": "01:00:47", "text": "トップガン マーヴェリックの映画で、"}, {"type": "subtitle", "time": 3648.87, "timestamp": "01:00:48", "text": "トレーラー。これらの人たちは予告編が公開されるのを見た"}, {"type": "subtitle", "time": 3651.51, "timestamp": "01:00:51", "text": "そして、アップデートトレーラーを公開しました。"}, {"type": "subtitle", "time": 3656.15, "timestamp": "01:00:56", "text": "当日または数日以内に。おお。"}]
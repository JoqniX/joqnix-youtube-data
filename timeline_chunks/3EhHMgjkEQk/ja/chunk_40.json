[{"type": "subtitle", "time": 2414.15, "timestamp": "00:40:14", "text": "いいえ、ゲーム内のプレイヤーのことです。あなたの"}, {"type": "subtitle", "time": 2416.47, "timestamp": "00:40:16", "text": "プレイヤーID。"}, {"type": "subtitle", "time": 2419.349, "timestamp": "00:40:19", "text": "何？議論の趣旨ではない。"}, {"type": "subtitle", "time": 2420.95, "timestamp": "00:40:20", "text": "ええ、もちろんです。それができるなら、"}, {"type": "subtitle", "time": 2422.95, "timestamp": "00:40:22", "text": "それも素晴らしいですね。シェアしてって言ってたんだけど"}, {"type": "subtitle", "time": 2427.27, "timestamp": "00:40:27", "text": "ID を設定できるように"}, {"type": "subtitle", "time": 2430.31, "timestamp": "00:40:30", "text": "私たち二人のためのカスタムネーム。 ID。うん。"}, {"type": "subtitle", "time": 2433.109, "timestamp": "00:40:33", "text": "わかった。わかった。わかった。それは"}, {"type": "subtitle", "time": 2445.91, "timestamp": "00:40:45", "text": "質量は重力が小さいんだよ、バカ。大きいんじゃない。"}, {"type": "subtitle", "time": 2449.19, "timestamp": "00:40:49", "text": "約0.7グラムです。どうでも。質量重力"}, {"type": "subtitle", "time": 2453.03, "timestamp": "00:40:53", "text": "より小さい。 0.38グラムです。では、"}, {"type": "subtitle", "time": 2455.19, "timestamp": "00:40:55", "text": "地球の重力？"}, {"type": "subtitle", "time": 2457.43, "timestamp": "00:40:57", "text": "1つ。地球の重力単位を取る"}]
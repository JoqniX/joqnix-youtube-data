[{"type": "subtitle", "time": 6360.31, "timestamp": "01:46:00", "text": "そして、常に後ろにも注意を払ってください。"}, {"type": "subtitle", "time": 6361.91, "timestamp": "01:46:01", "text": "だって、誰かを撃っている間は、"}, {"type": "subtitle", "time": 6372.31, "timestamp": "01:46:12", "text": "ガッチャ。どちらもチームなのかもしれませんね？"}, {"type": "subtitle", "time": 6374.189, "timestamp": "01:46:14", "text": "同じチームですよね？ええ、私たちは"}, {"type": "subtitle", "time": 6377.75, "timestamp": "01:46:17", "text": "同じ。これは実際の地図なので、"}, {"type": "subtitle", "time": 6380.709, "timestamp": "01:46:20", "text": "ほとんどの場合、相手チームにいることになる。"}, {"type": "subtitle", "time": 6383.35, "timestamp": "01:46:23", "text": "なんてこった、すごい数の飛行機だ。"}, {"type": "subtitle", "time": 6385.27, "timestamp": "01:46:25", "text": "うん。だから、振り返って見てみると"}, {"type": "subtitle", "time": 6388.79, "timestamp": "01:46:28", "text": "背後には敵チームの飛行機が見える"}, {"type": "subtitle", "time": 6390.629, "timestamp": "01:46:30", "text": "赤色で、自分のチームメイトが"}, {"type": "subtitle", "time": 6399.03, "timestamp": "01:46:39", "text": "それは、その人の識別子です"}, {"type": "subtitle", "time": 6401.35, "timestamp": "01:46:41", "text": "あなたが遊んでいるもの。"}, {"type": "subtitle", "time": 6403.91, "timestamp": "01:46:43", "text": "さて、高いところに登ると、一般的に"}, {"type": "subtitle", "time": 6405.31, "timestamp": "01:46:45", "text": "それらの飛行機は"}, {"type": "subtitle", "time": 6407.669, "timestamp": "01:46:47", "text": "爆撃機。正面から挑まなければ、"}, {"type": "subtitle", "time": 6410.229, "timestamp": "01:46:50", "text": "撃ちやすい。下へ降りると、"}, {"type": "subtitle", "time": 6413.27, "timestamp": "01:46:53", "text": "いい勝負になるよ。"}, {"type": "subtitle", "time": 6416.149, "timestamp": "01:46:56", "text": "正面衝突には十分注意してください。"}, {"type": "subtitle", "time": 6418.47, "timestamp": "01:46:58", "text": "私はダメージを受けました。私は戻る"}]
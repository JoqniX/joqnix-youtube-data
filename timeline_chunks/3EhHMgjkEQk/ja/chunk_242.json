[{"type": "subtitle", "time": 14520.389, "timestamp": "04:02:00", "text": "あなた。他の都市へ行こう。他の都市。"}, {"type": "subtitle", "time": 14523.269, "timestamp": "04:02:03", "text": "わかった。ええ、私もそこにいます。わかった。見ての通り"}, {"type": "subtitle", "time": 14526.389, "timestamp": "04:02:06", "text": "君のすぐ隣から入って行くよ"}, {"type": "subtitle", "time": 14541.03, "timestamp": "04:02:21", "text": "くそ。ここは実際、良い街だ。の"}, {"type": "subtitle", "time": 14543.99, "timestamp": "04:02:23", "text": "次のやつ。よし、君は飛行機に乗って、それから陸路に乗れ。"}, {"type": "subtitle", "time": 14545.75, "timestamp": "04:02:25", "text": "あなたより先に入ろうとします"}, {"type": "subtitle", "time": 14548.63, "timestamp": "04:02:28", "text": "まっすぐな道。"}, {"type": "subtitle", "time": 14553.429, "timestamp": "04:02:33", "text": "あ、待って。こうやって進んでください。道を送ってください。"}, {"type": "subtitle", "time": 14564.59, "timestamp": "04:02:44", "text": "来るよ。少し"}, {"type": "subtitle", "time": 14567.429, "timestamp": "04:02:47", "text": "きつい。おお、"}, {"type": "subtitle", "time": 14572.79, "timestamp": "04:02:52", "text": "行く。なんとかあなたの下に入り込むことができました"}]
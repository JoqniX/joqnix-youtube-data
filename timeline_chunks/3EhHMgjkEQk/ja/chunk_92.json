[{"type": "subtitle", "time": 5520.55, "timestamp": "01:32:00", "text": "戦争に関する合意された法律は、撃たないことだ"}, {"type": "subtitle", "time": 5522.07, "timestamp": "01:32:02", "text": "パイロットがジャンプする様子はご存知の通りです"}, {"type": "subtitle", "time": 5525.27, "timestamp": "01:32:05", "text": "注入された快適さ。"}, {"type": "subtitle", "time": 5527.27, "timestamp": "01:32:07", "text": "有名な事件が2つあります"}, {"type": "subtitle", "time": 5531.59, "timestamp": "01:32:11", "text": "かつて日本軍が駐留していた太平洋"}, {"type": "subtitle", "time": 5534.03, "timestamp": "01:32:14", "text": "パイロットは"}, {"type": "subtitle", "time": 5537.91, "timestamp": "01:32:17", "text": "ルールに従って、彼はかなりの数のアメリカ人を撃った"}, {"type": "subtitle", "time": 5541.11, "timestamp": "01:32:21", "text": "パイロットたちと、チームメイトの一人が"}, {"type": "subtitle", "time": 5543.87, "timestamp": "01:32:23", "text": "この日本人を撃ち落とすチャンス"}, {"type": "subtitle", "time": 5546.47, "timestamp": "01:32:26", "text": "パイロットとパイロットは無力なようだった"}, {"type": "subtitle", "time": 5548.79, "timestamp": "01:32:28", "text": "水とアメリカ人パイロットは本当に"}, {"type": "subtitle", "time": 5550.95, "timestamp": "01:32:30", "text": "彼を殺したかったんだ"}, {"type": "subtitle", "time": 5553.99, "timestamp": "01:32:33", "text": "地面だが、最後の瞬間に彼は"}, {"type": "subtitle", "time": 5555.83, "timestamp": "01:32:35", "text": "人間性を感じて、彼は最終的に"}, {"type": "subtitle", "time": 5556.669, "timestamp": "01:32:36", "text": "投げる"}, {"type": "subtitle", "time": 5563.27, "timestamp": "01:32:43", "text": "浮遊物で日本人パイロットを救出"}, {"type": "subtitle", "time": 5565.99, "timestamp": "01:32:45", "text": "撃つ代わりに。それが一つ目だった。"}, {"type": "subtitle", "time": 5567.83, "timestamp": "01:32:47", "text": "私が"}, {"type": "subtitle", "time": 5569.669, "timestamp": "01:32:49", "text": "もう一度信じてください、あれは日本人パイロットでした"}, {"type": "subtitle", "time": 5572.149, "timestamp": "01:32:52", "text": "アメリカ人パイロットを好きになろうとしていた"}, {"type": "subtitle", "time": 5574.149, "timestamp": "01:32:54", "text": "すでに退場させられていた"}, {"type": "subtitle", "time": 5575.91, "timestamp": "01:32:55", "text": "そして日本のパイロットが殺そうとしていた"}, {"type": "subtitle", "time": 5577.83, "timestamp": "01:32:57", "text": "彼と彼の飛行機。"}]
[{"type": "subtitle", "time": 8340.79, "timestamp": "02:19:00", "text": "飛行機に乗ることはできるが、今は"}, {"type": "subtitle", "time": 8343.03, "timestamp": "02:19:03", "text": "敵の戦車がいるから最高の時間だ"}, {"type": "subtitle", "time": 8344.83, "timestamp": "02:19:04", "text": "目の前に"}, {"type": "subtitle", "time": 8348.07, "timestamp": "02:19:08", "text": "自分。そしてここにもう一人いる"}, {"type": "subtitle", "time": 8351.23, "timestamp": "02:19:11", "text": "同じように。だからもし私が"}, {"type": "subtitle", "time": 8353.469, "timestamp": "02:19:13", "text": "好きになる"}, {"type": "subtitle", "time": 8357.669, "timestamp": "02:19:17", "text": "もしあなたがそうするなら、私はそうしない"}, {"type": "subtitle", "time": 8360.709, "timestamp": "02:19:20", "text": "それを作ってください。"}, {"type": "subtitle", "time": 8362.389, "timestamp": "02:19:22", "text": "なぜなら、あの戦車の前面装甲は"}, {"type": "subtitle", "time": 8364.629, "timestamp": "02:19:24", "text": "強い。私は弾丸しか持っていなかった。私は持っていませんでした"}, {"type": "subtitle", "time": 8368.19, "timestamp": "02:19:28", "text": "実際の戦車砲弾を持っている。"}, {"type": "subtitle", "time": 8374.309, "timestamp": "02:19:34", "text": "ああ。だから、もし私が、もし私が"}, {"type": "subtitle", "time": 8375.389, "timestamp": "02:19:35", "text": "スイッチ"}, {"type": "subtitle", "time": 8378.709, "timestamp": "02:19:38", "text": "飛行機に、自動操縦になるのでしょうか"}, {"type": "subtitle", "time": 8380.709, "timestamp": "02:19:40", "text": "NPC？"}, {"type": "subtitle", "time": 8383.429, "timestamp": "02:19:43", "text": "そのまま一時停止状態のままになります。おお。それで"}, {"type": "subtitle", "time": 8385.349, "timestamp": "02:19:45", "text": "実際にタンクを隠さなければならない"}, {"type": "subtitle", "time": 8390.79, "timestamp": "02:19:50", "text": "仮にあなたが戦車に乗っていて、"}, {"type": "subtitle", "time": 8392.79, "timestamp": "02:19:52", "text": "最前線で戦っている君"}, {"type": "subtitle", "time": 8394.03, "timestamp": "02:19:54", "text": "選択してください"}, {"type": "subtitle", "time": 8396.469, "timestamp": "02:19:56", "text": "飛行機、その頃には"}]
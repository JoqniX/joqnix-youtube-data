[{"type": "subtitle", "time": 7560.229, "timestamp": "02:06:00", "text": "そうそう。彼らは新しいことを実施した"}, {"type": "subtitle", "time": 7563.27, "timestamp": "02:06:03", "text": "フォーラムに直接アクセスできます"}, {"type": "subtitle", "time": 7566.07, "timestamp": "02:06:06", "text": "ゲームからだけど、確認してない"}, {"type": "subtitle", "time": 7567.43, "timestamp": "02:06:07", "text": "自分で外すことはできないので、どうすればいいのかわかりません"}, {"type": "subtitle", "time": 7569.43, "timestamp": "02:06:09", "text": "それ。基本的に、War Thunder があります"}, {"type": "subtitle", "time": 7570.91, "timestamp": "02:06:10", "text": "フォーラム"}, {"type": "subtitle", "time": 7576.229, "timestamp": "02:06:16", "text": "スキン。人々は、選手が"}, {"type": "subtitle", "time": 7578.95, "timestamp": "02:06:18", "text": "無料スキン。"}, {"type": "subtitle", "time": 7583.109, "timestamp": "02:06:23", "text": "フォーラムに行って、"}, {"type": "subtitle", "time": 7585.03, "timestamp": "02:06:25", "text": "市場に出回っていると思います。わからない。"}, {"type": "subtitle", "time": 7586.709, "timestamp": "02:06:26", "text": "わかった。フォーラムに行ってみてください。あなた"}, {"type": "subtitle", "time": 7588.79, "timestamp": "02:06:28", "text": "無料で入手できます。ダウンロードできます"}, {"type": "chat", "time": 7589.712, "timestamp": "02:06:29", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "that's actually really cool"}, {"type": "subtitle", "time": 7590.31, "timestamp": "02:06:30", "text": "無料です。完全に無料です。"}, {"type": "subtitle", "time": 7596.629, "timestamp": "02:06:36", "text": "そして、お気に入りのアニメを手に入れることができます"}, {"type": "subtitle", "time": 7600.229, "timestamp": "02:06:40", "text": "ワイフゲーム。ファイルを受け取ります。"}, {"type": "subtitle", "time": 7603.109, "timestamp": "02:06:43", "text": "ファイルを正しいフォルダに入れました"}, {"type": "subtitle", "time": 7605.709, "timestamp": "02:06:45", "text": "War Thunderで"}, {"type": "subtitle", "time": 7608.39, "timestamp": "02:06:48", "text": "フォルダを開いてから、ゲームを再度起動してください。"}, {"type": "subtitle", "time": 7609.87, "tim
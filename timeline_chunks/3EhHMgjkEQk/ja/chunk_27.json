[{"type": "subtitle", "time": 1624.23, "timestamp": "00:27:04", "text": "あまり確信が持てない。あなたたちは友達ですか？"}, {"type": "subtitle", "time": 1626.789, "timestamp": "00:27:06", "text": "自分と違う人たちと同じように"}, {"type": "subtitle", "time": 1628.87, "timestamp": "00:27:08", "text": "必ずしも友達である必要はありません、あなたはそれをしています"}, {"type": "subtitle", "time": 1631.029, "timestamp": "00:27:11", "text": "どちらかというと知り合い程度の関係。私はできる"}, {"type": "subtitle", "time": 1633.269, "timestamp": "00:27:13", "text": "それはもっと仕事であり、"}, {"type": "subtitle", "time": 1637.35, "timestamp": "00:27:17", "text": "仕事。うん。そこには何となく見える"}, {"type": "subtitle", "time": 1641.19, "timestamp": "00:27:21", "text": "これらの要素すべてを考慮するようなものだ。"}, {"type": "subtitle", "time": 1642.87, "timestamp": "00:27:22", "text": "うん。"}, {"type": "subtitle", "time": 1646.35, "timestamp": "00:27:26", "text": "個人的には、そういうことはしたくない。ない"}, {"type": "subtitle", "time": 1649.83, "timestamp": "00:27:29", "text": "だって、私には哲学があるから"}, {"type": "subtitle", "time": 1653.029, "timestamp": "00:27:33", "text": "もっともっと、なぜなら私はそうできなかったから"}, {"type": "subtitle", "time": 1655.19, "timestamp": "00:27:35", "text": "困惑した。手間がかかりすぎる。私はとても"}, {"type": "subtitle", "time": 1658.63, "timestamp": "00:27:38", "text": "怠け者。私は、"}, {"type": "subtitle", "time": 1661.07, "timestamp": "00:27:41", "text": "アクティブに"}, {"type": "subtitle", "time": 1663.269, "timestamp": "00:27:43", "text": "チャネル。誰かを捕まえようとするのは諦める"}, {"type": "subtitle", "time": 1668.31, "timestamp": "00:27:48", "text": "男。"}, {"type": "subtitle", "time": 1671.669, "timestamp": "00:27:51", "text": "何の昔に？ 6人に1人"}, {"type": "subtitle", "time": 1674.43, "timestamp": "00:27:54", "text": "数ヶ月後、DMで連絡します。私はこう思うだろう、"}, {"type": "subtitle", "time": 1676.669, "timestamp": "00:27:56", "text": "「J、君は遊びたいんだね」"}]
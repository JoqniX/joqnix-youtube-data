[{"type": "subtitle", "time": 9600.469, "timestamp": "02:40:00", "text": "一番下には赤いラファエロが描かれている。"}, {"type": "subtitle", "time": 9602.469, "timestamp": "02:40:02", "text": "うん。ラファエル。"}, {"type": "subtitle", "time": 9607.07, "timestamp": "02:40:07", "text": "それをクリックしてください。プレビューをクリックしてください。"}, {"type": "subtitle", "time": 9615.91, "timestamp": "02:40:15", "text": "これは最新のハイテク技術です"}, {"type": "subtitle", "time": 9617.55, "timestamp": "02:40:17", "text": "ジェット機の一種"}, {"type": "subtitle", "time": 9620.63, "timestamp": "02:40:20", "text": "まだ真新しい航空機で"}, {"type": "subtitle", "time": 9622.87, "timestamp": "02:40:22", "text": "多くの空軍で飛行"}, {"type": "subtitle", "time": 9624.63, "timestamp": "02:40:24", "text": "インド空軍。それは飛んでいる"}, {"type": "subtitle", "time": 9626.75, "timestamp": "02:40:26", "text": "インド人、フランス人、"}, {"type": "subtitle", "time": 9630.07, "timestamp": "02:40:30", "text": "カタール人と、おそらくエジプト人だと思います。私は違います"}, {"type": "subtitle", "time": 9631.429, "timestamp": "02:40:31", "text": "エジプトの空を飛んでいるかどうかは確かです"}, {"type": "subtitle", "time": 9633.429, "timestamp": "02:40:33", "text": "力は、45 のように飛んでいるのでしょうか"}, {"type": "subtitle", "time": 9636.95, "timestamp": "02:40:36", "text": "現在は空軍が主力となっている。これは現在の"}, {"type": "subtitle", "time": 9639.03, "timestamp": "02:40:39", "text": "テクノロジー。"}, {"type": "subtitle", "time": 9644.389, "timestamp": "02:40:44", "text": "だから、もしあなたが、あなたの命を捧げるなら"}, {"type": "subtitle", "time": 9647.11, "timestamp": "02:40:47", "text": "サタンや他の誰かの代わりに"}, {"type": "subtitle", "time": 9650.389, "timestamp": "02:40:50", "text": "天使よ、もしあなたが神に命を捧げるならば"}, {"type": "subtitle", "time": 9654.07, "timestamp": "02:40:54", "text": "War Thunderはカタツムリのようなものだ。"}, {"type": "subtitle", "time": 9657.19, "timestamp": "02:40:57", "text": "カタツムリ？ええ、それは正真正銘のカタツムリです。"}, {"type": "subtitle", "time": 9659.429, "timestamp": "02:40:59", "text": "つまり、Warを所有する親会社"}]
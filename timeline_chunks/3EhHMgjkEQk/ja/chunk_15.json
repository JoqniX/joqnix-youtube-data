[{"type": "subtitle", "time": 902.91, "timestamp": "00:15:02", "text": "リンク。あなたは"}, {"type": "subtitle", "time": 906.23, "timestamp": "00:15:06", "text": "できる。こんにちは、みんな。"}, {"type": "subtitle", "time": 915.15, "timestamp": "00:15:15", "text": "わかった。私はできると思う"}, {"type": "subtitle", "time": 918.509, "timestamp": "00:15:18", "text": "忍者リンクは"}, {"type": "subtitle", "time": 920.03, "timestamp": "00:15:20", "text": "仕事"}, {"type": "subtitle", "time": 935.35, "timestamp": "00:15:35", "text": "見る。あなたの画面が見えました。"}, {"type": "subtitle", "time": 937.55, "timestamp": "00:15:37", "text": "ああ、なるほど。"}, {"type": "subtitle", "time": 941.75, "timestamp": "00:15:41", "text": "あなた。君が見えるよ。はい。待って。えっと、なぜ"}, {"type": "subtitle", "time": 942.91, "timestamp": "00:15:42", "text": "それ"}]
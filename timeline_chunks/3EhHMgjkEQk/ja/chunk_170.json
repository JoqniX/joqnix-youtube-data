[{"type": "subtitle", "time": 10201.67, "timestamp": "02:50:01", "text": "いったん地上に降り立ったら。"}, {"type": "subtitle", "time": 10204.55, "timestamp": "02:50:04", "text": "時速400キロ以下でなければなりません"}, {"type": "subtitle", "time": 10207.269, "timestamp": "02:50:07", "text": "そのため。つまり、この飛行機は"}, {"type": "subtitle", "time": 10214.71, "timestamp": "02:50:14", "text": "まあ、それはあなたのパイロットではありません"}, {"type": "subtitle", "time": 10217.23, "timestamp": "02:50:17", "text": "射出。まるで引きずり下ろすような感じ"}, {"type": "subtitle", "time": 10226.309, "timestamp": "02:50:26", "text": "ブレーキ。まるでオムツみたいなものだ。それ"}, {"type": "subtitle", "time": 10228.309, "timestamp": "02:50:28", "text": "ある一定の速度に達すると出てくる"}, {"type": "subtitle", "time": 10230.389, "timestamp": "02:50:30", "text": "着陸後、それが役に立つ"}, {"type": "subtitle", "time": 10233.11, "timestamp": "02:50:33", "text": "スピードをもっと落として、それから"}, {"type": "subtitle", "time": 10235.19, "timestamp": "02:50:35", "text": "途切れる。新しいパラシュートを"}, {"type": "subtitle", "time": 10248.15, "timestamp": "02:50:48", "text": "飛行機。トップガン、マーベリック着陸。トップガン"}, {"type": "subtitle", "time": 10249.67, "timestamp": "02:50:49", "text": "異端着陸。墜落するぞ"}, {"type": "subtitle", "time": 10252.55, "timestamp": "02:50:52", "text": "あなたの飛行機。あなたには平地はありません"}, {"type": "subtitle", "time": 10255.51, "timestamp": "02:50:55", "text": "着陸する。何も見えません、先生。"}]
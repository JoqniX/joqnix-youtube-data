[{"type": "subtitle", "time": 10562.15, "timestamp": "02:56:02", "text": "ボタンは現在割り当てられていますが、"}, {"type": "subtitle", "time": 10565.429, "timestamp": "02:56:05", "text": "下部に3つの記号があります。"}, {"type": "subtitle", "time": 10569.11, "timestamp": "02:56:09", "text": "ええ、真ん中のシンボルですね。忘れた"}, {"type": "subtitle", "time": 10570.55, "timestamp": "02:56:10", "text": "そうでなければ、私は"}, {"type": "subtitle", "time": 10573.349, "timestamp": "02:56:13", "text": "あなたを助けました。あなたが調べている間に、私が調べておきますね。"}, {"type": "subtitle", "time": 10575.03, "timestamp": "02:56:15", "text": "着陸を試みる。しかし、"}, {"type": "subtitle", "time": 10576.87, "timestamp": "02:56:16", "text": "中央は、取得のようなボタンです"}, {"type": "subtitle", "time": 10581.75, "timestamp": "02:56:21", "text": "飛行機の中でただ暴れ回ればいい"}, {"type": "subtitle", "time": 10583.95, "timestamp": "02:56:23", "text": "で"}, {"type": "subtitle", "time": 10586.389, "timestamp": "02:56:26", "text": "空。落下しているような感覚になるでしょう"}, {"type": "subtitle", "time": 10597.19, "timestamp": "02:56:37", "text": "ああ、気にしないで。"}, {"type": "subtitle", "time": 10599.75, "timestamp": "02:56:39", "text": "嵐巡航機がどうなっているのか"}, {"type": "subtitle", "time": 10603.429, "timestamp": "02:56:43", "text": "空母には着陸できません"}, {"type": "subtitle", "time": 10606.469, "timestamp": "02:56:46", "text": "後方以外であればどこからでも。あなた"}, {"type": "subtitle", "time": 10609.95, "timestamp": "02:56:49", "text": "正しい手順を踏まなければならない。"}]
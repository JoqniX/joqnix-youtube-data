[{"type": "subtitle", "time": 13141.59, "timestamp": "03:39:01", "text": "わかった。どのように来れば良いですか？あなた"}, {"type": "subtitle", "time": 13144.55, "timestamp": "03:39:04", "text": "上から来てほしいのか、下から来てほしいのか"}, {"type": "subtitle", "time": 13149.11, "timestamp": "03:39:09", "text": "低い？何でも。一時停止。いや、いや、いや。"}, {"type": "subtitle", "time": 13151.59, "timestamp": "03:39:11", "text": "選択肢を与えてあげます。どうしたいですか？"}, {"type": "subtitle", "time": 13154.229, "timestamp": "03:39:14", "text": "私があなたを攻撃する？高いところか、低いところか？"}, {"type": "subtitle", "time": 13161.429, "timestamp": "03:39:21", "text": "えっと、下へ。"}, {"type": "subtitle", "time": 13162.67, "timestamp": "03:39:22", "text": "低い位置で。"}, {"type": "subtitle", "time": 13165.229, "timestamp": "03:39:25", "text": "わかった。ほら、下の方だと、もっと時間があるよ"}, {"type": "subtitle", "time": 13167.83, "timestamp": "03:39:27", "text": "だって、そこには建物とか色々あるから。私"}]
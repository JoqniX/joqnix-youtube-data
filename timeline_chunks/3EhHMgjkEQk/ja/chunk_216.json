[{"type": "subtitle", "time": 12968.55, "timestamp": "03:36:08", "text": "はい。さて、ここでの面白いところは"}, {"type": "subtitle", "time": 12971.03, "timestamp": "03:36:11", "text": "地面にとても近いとき、私の"}, {"type": "subtitle", "time": 12973.83, "timestamp": "03:36:13", "text": "レーダーはあなたを区別するのに苦労します"}, {"type": "subtitle", "time": 12980.15, "timestamp": "03:36:20", "text": "そして君を手に入れたら、本当に近づいて"}, {"type": "subtitle", "time": 12981.67, "timestamp": "03:36:21", "text": "地面。地面にすがりつくように。"}, {"type": "subtitle", "time": 12983.59, "timestamp": "03:36:23", "text": "ミサイルが飛んでくる。本当に"}, {"type": "subtitle", "time": 12989.51, "timestamp": "03:36:29", "text": "兄弟。"}, {"type": "subtitle", "time": 13002.309, "timestamp": "03:36:42", "text": "くそ。あなたは本当にものすごくものすごく"}, {"type": "subtitle", "time": 13005.11, "timestamp": "03:36:45", "text": "地面は、ほら、ほんの少しだけ上"}, {"type": "subtitle", "time": 13009.11, "timestamp": "03:36:49", "text": "墜落寸前の高度をかろうじて上回っている。"}, {"type": "subtitle", "time": 13011.269, "timestamp": "03:36:51", "text": "そしてそうすることで、"}, {"type": "subtitle", "time": 13013.11, "timestamp": "03:36:53", "text": "ミサイルを避けてください、ミサイルが"}, {"type": "subtitle", "time": 13014.79, "timestamp": "03:36:54", "text": "最後の最後で混乱した。つまり、あなたは探しているのですね"}, {"type": "subtitle", "time": 13017.83, "timestamp": "03:36:57", "text": "私のジェット機で。"}]
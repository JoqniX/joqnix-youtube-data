[{"type": "subtitle", "time": 2821.75, "timestamp": "00:47:01", "text": "待て、あれは船だ。"}, {"type": "subtitle", "time": 2824.15, "timestamp": "00:47:04", "text": "いや、違うよ。お願い、お願い、お願い。私は"}, {"type": "subtitle", "time": 2826.23, "timestamp": "00:47:06", "text": "船。"}, {"type": "subtitle", "time": 2828.589, "timestamp": "00:47:08", "text": "あなたは"}, {"type": "subtitle", "time": 2831.51, "timestamp": "00:47:11", "text": "待って、待って、あなたのDiscordを確認する必要がある"}, {"type": "subtitle", "time": 2832.95, "timestamp": "00:47:12", "text": "もの。"}, {"type": "subtitle", "time": 2837.03, "timestamp": "00:47:17", "text": "あらら。試してみたんでしょ？"}, {"type": "subtitle", "time": 2840.069, "timestamp": "00:47:20", "text": "そうでした。"}, {"type": "subtitle", "time": 2841.829, "timestamp": "00:47:21", "text": "テストマッチに参加していますか、それとも"}, {"type": "subtitle", "time": 2849.27, "timestamp": "00:47:29", "text": "ジョー、何をしたの？私は見ていなかった"}, {"type": "subtitle", "time": 2850.87, "timestamp": "00:47:30", "text": "あなたのライブ配信で。私は見ていました"}, {"type": "subtitle", "time": 2852.99, "timestamp": "00:47:32", "text": "あなたの画面。待って、離して"}, {"type": "subtitle", "time": 2856.15, "timestamp": "00:47:36", "text": "戻る。ハンガーに戻す。私はあなたと一緒です、"}, {"type": "subtitle", "time": 2860.55, "timestamp": "00:47:40", "text": "右？わかった。上部の「準備完了」をクリックしてください。うん。"}, {"type": "subtitle", "time": 2864.27, "timestamp": "00:47:44", "text": "待て、海戦って書いてあるぞ。"}, {"type": "subtitle", "time": 2866.87, "timestamp": "00:47:46", "text": "君は空中戦をするんだ。空中戦。そこで私たちは"}, {"type": "subtitle", "time": 2869.03, "timestamp": "00:47:49", "text": "行く。待って。私は力を持っているが、あなたは"}, {"type": "subtitle", "time": 2870.79, "timestamp": "00:47:50", "text": "党首。いや、いや、いや、いや、いや。"}, {"type": "subtitle", "time": 2873.51, "timestamp": "00:47:53", "text": "準備はいいですか？うん。"}, {"type": "subtitle", "time": 2877.349, "timestamp": "00:47:57", "text": "準備ができて。なぜそれがあなたを蹴るのですか？"}, {"type": "subtitle", "time": 2879.19, "timestamp": "00:47:59", "text": "今はもうその機能が動作していません。よし、それでは"}]
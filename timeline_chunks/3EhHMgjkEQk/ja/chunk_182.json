[{"type": "subtitle", "time": 10923.429, "timestamp": "03:02:03", "text": "私は動かない。あなたはただ行くだけです"}, {"type": "subtitle", "time": 10930.23, "timestamp": "03:02:10", "text": "脱出。飛行機が墜落する前に脱出してください"}, {"type": "subtitle", "time": 10933.67, "timestamp": "03:02:13", "text": "船。よし。うん。うん。脱出。"}, {"type": "subtitle", "time": 10944.63, "timestamp": "03:02:24", "text": "うーん、あれはすごかった。"}, {"type": "subtitle", "time": 10947.309, "timestamp": "03:02:27", "text": "着陸したら、これを試してみてください。"}, {"type": "subtitle", "time": 10950.07, "timestamp": "03:02:30", "text": "時間。もう一度試してみますか？うん、"}, {"type": "subtitle", "time": 10960.23, "timestamp": "03:02:40", "text": "こんにちは。"}, {"type": "subtitle", "time": 10969.11, "timestamp": "03:02:49", "text": "私たちはジョーにやり方を教えているだけです"}, {"type": "subtitle", "time": 10979.429, "timestamp": "03:02:59", "text": "はい。そして彼は現在練習中"}]
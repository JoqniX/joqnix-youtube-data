[{"type": "subtitle", "time": 3661.03, "timestamp": "01:01:01", "text": "そして彼らはトレーラーを一種の"}, {"type": "subtitle", "time": 3664.95, "timestamp": "01:01:04", "text": "オリジナルのトプラーの視覚的な複製。"}, {"type": "subtitle", "time": 3667.27, "timestamp": "01:01:07", "text": "兄弟、"}, {"type": "subtitle", "time": 3669.51, "timestamp": "01:01:09", "text": "残念ながら彼らができなかった唯一のことは"}, {"type": "subtitle", "time": 3673.51, "timestamp": "01:01:13", "text": "オリジナルの音楽を入れるような感じ。"}, {"type": "subtitle", "time": 3674.99, "timestamp": "01:01:14", "text": "トムはどうですか？"}, {"type": "subtitle", "time": 3677.829, "timestamp": "01:01:17", "text": "クルーズ？実際にはそれも悲しいことに"}, {"type": "subtitle", "time": 3680.069, "timestamp": "01:01:20", "text": "できなかった。彼らはそれほど優れていない"}, {"type": "subtitle", "time": 3681.91, "timestamp": "01:01:21", "text": "人間は、このゲームでは"}, {"type": "subtitle", "time": 3685.27, "timestamp": "01:01:25", "text": "人間がいる。入隊者はそうする。"}, {"type": "subtitle", "time": 3686.95, "timestamp": "01:01:26", "text": "しかし、下士官兵であっても、"}, {"type": "subtitle", "time": 3688.63, "timestamp": "01:01:28", "text": "彼らの顔は、"}, {"type": "subtitle", "time": 3699.19, "timestamp": "01:01:39", "text": "今、私たちは"}, {"type": "subtitle", "time": 3701.71, "timestamp": "01:01:41", "text": "アーケードモード、"}, {"type": "subtitle", "time": 3704.99, "timestamp": "01:01:44", "text": "ええと、現実的なこともいくつかあります。のために"}, {"type": "subtitle", "time": 3708.63, "timestamp": "01:01:48", "text": "例えば、燃料がなくなると"}, {"type": "subtitle", "time": 3711.71, "timestamp": "01:01:51", "text": "ニトロブーストを維持してください"}, {"type": "subtitle", "time": 3716.43, "timestamp": "01:01:56", "text": "力。エンジンオイルが燃え尽きて、"}, {"type": "subtitle", "time": 3718.789, "timestamp": "01:01:58", "text": "過熱した。常に"}]
[{"type": "subtitle", "time": 15123.269, "timestamp": "04:12:03", "text": "うん。その58万は、"}, {"type": "subtitle", "time": 15125.59, "timestamp": "04:12:05", "text": "バーが満員になる。そのバーを満たすには"}, {"type": "subtitle", "time": 15129.11, "timestamp": "04:12:09", "text": "20k、20k、20k、20k。それは"}, {"type": "subtitle", "time": 15130.55, "timestamp": "04:12:10", "text": "特別調査。それは飛行隊だ"}, {"type": "subtitle", "time": 15131.99, "timestamp": "04:12:11", "text": "研究。それはあなたの"}, {"type": "subtitle", "time": 15135.349, "timestamp": "04:12:15", "text": "標準的なゲーム研究。"}, {"type": "subtitle", "time": 15137.429, "timestamp": "04:12:17", "text": "あなたのゲームにはたくさんのルールがあります"}, {"type": "subtitle", "time": 15139.03, "timestamp": "04:12:19", "text": "研究。同じように飛ぶ必要があります"}, {"type": "subtitle", "time": 15141.03, "timestamp": "04:12:21", "text": "国。あなたの飛行機は同じである必要があります"}, {"type": "subtitle", "time": 15143.67, "timestamp": "04:12:23", "text": "あなたが研究しているレベルと同じレベル。のために"}, {"type": "subtitle", "time": 15145.51, "timestamp": "04:12:25", "text": "飛行隊の飛行機ならどれでも飛ばせます"}, {"type": "subtitle", "time": 15147.189, "timestamp": "04:12:27", "text": "国や飛行機の種類に関係なく、それでも満員になるだろう"}, {"type": "subtitle", "time": 15149.99, "timestamp": "04:12:29", "text": "こっちの方です。"}, {"type": "subtitle", "time": 15152.55, "timestamp": "04:12:32", "text": "ああ、それで君と君の部隊は"}, {"type": "subtitle", "time": 15154.95, "timestamp": "04:12:34", "text": "努力において。 2日ごとに満杯になります"}, {"type": "subtitle", "time": 15157.99, "timestamp": "04:12:37", "text": "そして1ヶ月または1ヶ月の期間にわたって"}, {"type": "subtitle", "time": 15160.55, "timestamp": "04:12:40", "text": "そしてこの研究の半分は"}, {"type": "subtitle", "time": 15162.99, "timestamp": "04:12:42", "text": "完了しました。研究が"}, {"type": "subtitle", "time": 15165.99, "timestamp": "04:12:45", "text": "これらの飛行機はすべて完成しており、"}, {"type": "subtitle", "time": 15168.55, "timestamp": "04:12:48", "text": "ほら、すごく高い評価だよ、"}, {"type": "subtitle", "time": 15170.389, "timestamp": "04:12:50", "text": "およそ150万ドル必要"}, {"type": "subtitle", "time": 15172.309, "timestamp": "04:12:52", "text": "それを買うにはドルが必要です。つまり、ドルではなく、"}, {"type": "subtitle", "time": 15175.03, "timestamp": "04:12:55", "text": "シルバーランズ。"}, {"type": "subtitle", "time": 15179.229, "timestamp": "04:12:59", "text": "おお。どうすればそれを手に入れられますか？"}]
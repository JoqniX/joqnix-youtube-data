[{"type": "subtitle", "time": 7689.35, "timestamp": "02:08:09", "text": "それで、私たちがやったことはアーケードゲームだけになった"}, {"type": "subtitle", "time": 7692.709, "timestamp": "02:08:12", "text": "モード。現実的には、"}, {"type": "subtitle", "time": 7694.109, "timestamp": "02:08:14", "text": "えーと"}, {"type": "subtitle", "time": 7696.55, "timestamp": "02:08:16", "text": "開始時に透明な円で"}, {"type": "subtitle", "time": 7698.709, "timestamp": "02:08:18", "text": "出て行け。"}, {"type": "subtitle", "time": 7701.229, "timestamp": "02:08:21", "text": "何も得られません。得られない"}, {"type": "subtitle", "time": 7703.669, "timestamp": "02:08:23", "text": "近づかない限り、距離を保つ。戦車の中で、"}, {"type": "subtitle", "time": 7705.27, "timestamp": "02:08:25", "text": "あなたは絶対に何も得られません。で"}, {"type": "subtitle", "time": 7707.189, "timestamp": "02:08:27", "text": "飛行機は、一度しか見たことがないようなものだ。"}, {"type": "subtitle", "time": 7709.669, "timestamp": "02:08:29", "text": "彼らは親密になる。"}, {"type": "subtitle", "time": 7712.47, "timestamp": "02:08:32", "text": "そして、燃料には限りがある。あなたの飛行機は"}, {"type": "subtitle", "time": 7714.31, "timestamp": "02:08:34", "text": "飛行中なので、はるかに鈍重です"}, {"type": "subtitle", "time": 7719.91, "timestamp": "02:08:39", "text": "もっともっと注意しなければならない"}, {"type": "subtitle", "time": 7721.83, "timestamp": "02:08:41", "text": "そして、人生は一度きりだ。では"}, {"type": "subtitle", "time": 7723.51, "timestamp": "02:08:43", "text": "飛行機では、命は一度きりだ。では"}, {"type": "subtitle", "time": 7732.47, "timestamp": "02:08:52", "text": "人生。それで、君は戦車をプレイしたいのか？うん、"}, {"type": "subtitle", "time": 7737.91, "timestamp": "02:08:57", "text": "見つけなければならない。わかった。ええ、見つけました"}]
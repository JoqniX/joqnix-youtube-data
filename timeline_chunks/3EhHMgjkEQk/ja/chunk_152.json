[{"type": "subtitle", "time": 9120.63, "timestamp": "02:32:00", "text": "ええ、それも比較的新しいものですね。"}, {"type": "subtitle", "time": 9123.03, "timestamp": "02:32:03", "text": "それは1年か2年前のもので、"}, {"type": "subtitle", "time": 9136.79, "timestamp": "02:32:16", "text": "リアルな戦車では、はるかに"}, {"type": "subtitle", "time": 9140.23, "timestamp": "02:32:20", "text": "飛行機より怖い"}, {"type": "subtitle", "time": 9142.389, "timestamp": "02:32:22", "text": "だって、タンクに入ると、"}, {"type": "subtitle", "time": 9145.27, "timestamp": "02:32:25", "text": "地面を見なければならない"}, {"type": "subtitle", "time": 9147.429, "timestamp": "02:32:27", "text": "敵の戦車は一般的に簡単に"}, {"type": "subtitle", "time": 9150.19, "timestamp": "02:32:30", "text": "地面に溶け込むように"}, {"type": "subtitle", "time": 9152.87, "timestamp": "02:32:32", "text": "あなた。指標が全くありません。あなたが持っている"}, {"type": "subtitle", "time": 9155.51, "timestamp": "02:32:35", "text": "文字通り目を使って見つける"}, {"type": "subtitle", "time": 9158.79, "timestamp": "02:32:38", "text": "敵の戦車"}, {"type": "subtitle", "time": 9161.429, "timestamp": "02:32:41", "text": "そしてまた、どこで管理する必要があるか"}, {"type": "subtitle", "time": 9164.92, "timestamp": "02:32:44", "text": "戦車を攻撃する。つまり、それは現実的なのです"}, {"type": "subtitle", "time": 9175.83, "timestamp": "02:32:55", "text": "待って、どんな飛行機を持っているのか見せてくれ。"}, {"type": "subtitle", "time": 9177.03, "timestamp": "02:32:57", "text": "何かあるかどうか見てみましょう"}, {"type": "subtitle", "time": 9179.51, "timestamp": "02:32:59", "text": "爆撃機。"}]
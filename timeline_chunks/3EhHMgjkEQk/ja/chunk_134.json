[{"type": "subtitle", "time": 8051.99, "timestamp": "02:14:11", "text": "なぜあなたはそこにいないのですか？"}, {"type": "subtitle", "time": 8053.43, "timestamp": "02:14:13", "text": "つまり、しばらくゲームをプレイしていたのですが、"}, {"type": "subtitle", "time": 8056.709, "timestamp": "02:14:16", "text": "おそらくそういうことだろう。"}, {"type": "subtitle", "time": 8060.149, "timestamp": "02:14:20", "text": "おお。また、ジョックタンクは一撃で壊れるものではありません。"}, {"type": "subtitle", "time": 8063.27, "timestamp": "02:14:23", "text": "殺す。私は今、死んだ。タンクは"}, {"type": "subtitle", "time": 8065.51, "timestamp": "02:14:25", "text": "一般的には一撃必殺ではない。よし、"}, {"type": "subtitle", "time": 8068.31, "timestamp": "02:14:28", "text": "戦車を撃つ場所に応じて、"}, {"type": "subtitle", "time": 8069.55, "timestamp": "02:14:29", "text": "損傷する"}, {"type": "subtitle", "time": 8073.189, "timestamp": "02:14:33", "text": "エンジンを損傷するか、砲塔を損傷する可能性があります。それで、"}, {"type": "subtitle", "time": 8074.99, "timestamp": "02:14:34", "text": "彼らは発砲できないが、それでも"}, {"type": "subtitle", "time": 8077.43, "timestamp": "02:14:37", "text": "動く。運が良ければ、撃つ"}, {"type": "subtitle", "time": 8078.87, "timestamp": "02:14:38", "text": "彼らの弾薬を爆破して"}, {"type": "subtitle", "time": 8080.109, "timestamp": "02:14:40", "text": "タンク一体型"}, {"type": "subtitle", "time": 8088.229, "timestamp": "02:14:48", "text": "起こる。だから、何かの陰に隠れてください。持っている"}, {"type": "subtitle", "time": 8090.629, "timestamp": "02:14:50", "text": "水槽の大部分は岩の後ろに隠れているか、"}, {"type": "subtitle", "time": 8093.149, "timestamp": "02:14:53", "text": "他のプレイヤーまたは"}, {"type": "subtitle", "time": 8095.79, "timestamp": "02:14:55", "text": "何か。次に指差す"}, {"type": "subtitle", "time": 8098.51, "timestamp": "02:14:58", "text": "敵戦車"}]
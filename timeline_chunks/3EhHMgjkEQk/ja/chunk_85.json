[{"type": "subtitle", "time": 5102.07, "timestamp": "01:25:02", "text": "検索すべき内容は？対抗措置。"}, {"type": "subtitle", "time": 5105.51, "timestamp": "01:25:05", "text": "対抗措置。左シフトD。いや、"}, {"type": "subtitle", "time": 5115.39, "timestamp": "01:25:15", "text": "ああ、わかりました。わかった。戻ってください。私たちが"}, {"type": "subtitle", "time": 5117.629, "timestamp": "01:25:17", "text": "ない"}, {"type": "subtitle", "time": 5120.35, "timestamp": "01:25:20", "text": "見る？ほら、何もない"}, {"type": "subtitle", "time": 5123.59, "timestamp": "01:25:23", "text": "働く。 C言語が動作していません。"}, {"type": "subtitle", "time": 5125.75, "timestamp": "01:25:25", "text": "いいえ、Cを押してください。"}, {"type": "subtitle", "time": 5128.59, "timestamp": "01:25:28", "text": "Cをタップするだけです。いいえ、違います。"}, {"type": "subtitle", "time": 5131.189, "timestamp": "01:25:31", "text": "働く。ああ、マウスを動かさなきゃ。"}, {"type": "subtitle", "time": 5139.51, "timestamp": "01:25:39", "text": "代替案D を押し続けます。"}, {"type": "subtitle", "time": 5142.95, "timestamp": "01:25:42", "text": "これは無料です。なんてこった。選手。私"}, {"type": "subtitle", "time": 5144.79, "timestamp": "01:25:44", "text": "あれを見てください。数量は限られていますが、"}, {"type": "subtitle", "time": 5148.31, "timestamp": "01:25:48", "text": "ええ、支払う必要はありませんよ。"}, {"type": "subtitle", "time": 5151.43, "timestamp": "01:25:51", "text": "うん。では、誰が何に行くのでしょうか？"}, {"type": "subtitle", "time": 5153.51, "timestamp": "01:25:53", "text": "何てことだ。誰が私を撃っているの？あなたが持っている"}, {"type": "subtitle", "time": 5157.11, "timestamp": "01:25:57", "text": "背を向ける。それはボットです。それは"}, {"type": "subtitle", "time": 5158.629, "timestamp": "01:25:58", "text": "NPC。"}]
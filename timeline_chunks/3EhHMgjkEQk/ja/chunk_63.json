[{"type": "subtitle", "time": 3781.91, "timestamp": "01:03:01", "text": "カーソルが中央にあります。いくつか見てください"}, {"type": "subtitle", "time": 3785.75, "timestamp": "01:03:05", "text": "赤い円が出てきます。ええ、それは"}, {"type": "subtitle", "time": 3787.91, "timestamp": "01:03:07", "text": "銃声が鳴るまであとどれくらい時間がありますか"}, {"type": "subtitle", "time": 3791.27, "timestamp": "01:03:11", "text": "ジャム。クールダウンのようなものだ。"}, {"type": "subtitle", "time": 3800.23, "timestamp": "01:03:20", "text": "また、左上隅には"}, {"type": "subtitle", "time": 3803.029, "timestamp": "01:03:23", "text": "CNNを含むいくつかの基本情報。"}, {"type": "subtitle", "time": 3805.99, "timestamp": "01:03:25", "text": "CNNは正典だ。それは弾丸の数です"}, {"type": "subtitle", "time": 3811.91, "timestamp": "01:03:31", "text": "まず最初に。試してみたい"}, {"type": "subtitle", "time": 3814.15, "timestamp": "01:03:34", "text": "着陸方法は？あなたは理解したい"}, {"type": "subtitle", "time": 3817.43, "timestamp": "01:03:37", "text": "着陸？ええ、もちろんです。わかった。そうします"}, {"type": "subtitle", "time": 3820.15, "timestamp": "01:03:40", "text": "大きな道路沿いに。振り向く。あなたが教えて"}, {"type": "subtitle", "time": 3824.27, "timestamp": "01:03:44", "text": "あなたが私を見かけたら。あなたは私に会います？"}, {"type": "subtitle", "time": 3827.109, "timestamp": "01:03:47", "text": "はい。よし、今度はスピードを落としてください。減らす"}]
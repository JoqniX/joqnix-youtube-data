[{"type": "subtitle", "time": 7320.95, "timestamp": "02:02:00", "text": "しかし、それはあなたがしてはいけないことだった"}, {"type": "subtitle", "time": 7327.189, "timestamp": "02:02:07", "text": "ああ、ちょっと疑問に思っていたんです。どうすれば入手できますか"}, {"type": "subtitle", "time": 7338.229, "timestamp": "02:02:18", "text": "はい、皆さん。ジョー、君が"}, {"type": "subtitle", "time": 7341.669, "timestamp": "02:02:21", "text": "入手がどれだけ容易になったかを知る"}, {"type": "subtitle", "time": 7345.03, "timestamp": "02:02:25", "text": "私がWar Thunderについて話すと、人々はWar Thunderに興味を持つようになりました。"}, {"type": "subtitle", "time": 7346.87, "timestamp": "02:02:26", "text": "ワイフ枕があって、"}, {"type": "subtitle", "time": 7349.229, "timestamp": "02:02:29", "text": "War用のwaifuスキン"}, {"type": "subtitle", "time": 7351.91, "timestamp": "02:02:31", "text": "雷。例えば、ワイフスキンを持てるみたいに。"}, {"type": "subtitle", "time": 7360.95, "timestamp": "02:02:40", "text": "車。また、定番の"}, {"type": "subtitle", "time": 7362.47, "timestamp": "02:02:42", "text": "第二次世界大戦のように、"}, {"type": "subtitle", "time": 7365.03, "timestamp": "02:02:45", "text": "妻の写真が映っている映画"}, {"type": "subtitle", "time": 7368.55, "timestamp": "02:02:48", "text": "操縦席で。はい、あなたは"}, {"type": "subtitle", "time": 7377.189, "timestamp": "02:02:57", "text": "だから、特に枕は、"}]
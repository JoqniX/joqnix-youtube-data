[{"type": "subtitle", "time": 15061.11, "timestamp": "04:11:01", "text": "あれは低速のジェット爆撃機だ。はい、私は"}, {"type": "subtitle", "time": 15063.11, "timestamp": "04:11:03", "text": "それを変えるために。つまり、"}, {"type": "subtitle", "time": 15065.75, "timestamp": "04:11:05", "text": "これらの選択肢。ヘリコプターは利用しないでください"}, {"type": "subtitle", "time": 15068.63, "timestamp": "04:11:08", "text": "なぜなら、船やタンクが必要だからです"}, {"type": "subtitle", "time": 15070.71, "timestamp": "04:11:10", "text": "ヘリコプターで。飛行機には乗れません"}, {"type": "subtitle", "time": 15073.11, "timestamp": "04:11:13", "text": "ヘリコプター単体で。どちらかを選ぶ"}, {"type": "subtitle", "time": 15076.07, "timestamp": "04:11:16", "text": "戦車用、あるいはジェット機用。"}, {"type": "subtitle", "time": 15079.429, "timestamp": "04:11:19", "text": "ああ、これはインドの戦車だ。おお。うん、"}, {"type": "subtitle", "time": 15081.03, "timestamp": "04:11:21", "text": "これはインドにあるロシアの戦車です"}, {"type": "subtitle", "time": 15083.309, "timestamp": "04:11:23", "text": "軍隊"}, {"type": "subtitle", "time": 15086.229, "timestamp": "04:11:26", "text": "サービス。インドの飛行機が"}, {"type": "subtitle", "time": 15088.71, "timestamp": "04:11:28", "text": "まあ、でもそれは飛行隊にはないと思う"}, {"type": "subtitle", "time": 15091.189, "timestamp": "04:11:31", "text": "1つ。それはイベントとして分離されています"}, {"type": "subtitle", "time": 15093.11, "timestamp": "04:11:33", "text": "車両。"}, {"type": "subtitle", "time": 15095.99, "timestamp": "04:11:35", "text": "真ん中の青い飛行機は、"}, {"type": "subtitle", "time": 15098.389, "timestamp": "04:11:38", "text": "それが私が今持っているものです。"}, {"type": "subtitle", "time": 15101.11, "timestamp": "04:11:41", "text": "ああ、だから私は2日ごとに正しいと言ったんだ"}, {"type": "subtitle", "time": 15103.349, "timestamp": "04:11:43", "text": "18,000から20,000くらい手に入るよ"}, {"type": "subtitle", "time": 15105.51, "timestamp": "04:11:45", "text": "あなたとあなたのチームは完璧です"}, {"type": "subtitle", "time": 15108.87, "timestamp": "04:11:48", "text": "活動内容は的確だ。"}, {"type": "subtitle", "time": 15111.59, "timestamp": "04:11:51", "text": "500、80、あるいは何であれ、"}, {"type": "subtitle", "time": 15113.91, "timestamp": "04:11:53", "text": "数字は。どれでも1つ選んでください。"}, {"type": "subtitle", "time": 15118.87, "timestamp": "04:11:58", "text": "うん。 580 が見える。いや。うん。うん。 580."}]
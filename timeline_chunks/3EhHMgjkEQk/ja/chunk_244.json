[{"type": "subtitle", "time": 14656.63, "timestamp": "04:04:16", "text": "では、あなたと同じようにウォーターをプレイする人は他にいますか？"}, {"type": "subtitle", "time": 14660.229, "timestamp": "04:04:20", "text": "私たちの間に？"}, {"type": "subtitle", "time": 14665.11, "timestamp": "04:04:25", "text": "まあ、みんな知ってることだよ。送る、送る、"}, {"type": "subtitle", "time": 14668.63, "timestamp": "04:04:28", "text": "ただ送り出せばいい。どちらにしても、"}, {"type": "subtitle", "time": 14670.469, "timestamp": "04:04:30", "text": "わかった、"}, {"type": "subtitle", "time": 14674.07, "timestamp": "04:04:34", "text": "遅すぎる。私は1つ送りました。ジャズは"}, {"type": "subtitle", "time": 14683.67, "timestamp": "04:04:43", "text": "私が彼をいじめると、彼はサンデレを演じる。つまり"}, {"type": "subtitle", "time": 14687.67, "timestamp": "04:04:47", "text": "彼に演奏を頼んでください。彼を嫌がらせろ。"}, {"type": "subtitle", "time": 14688.99, "timestamp": "04:04:48", "text": "私は脅迫する"}, {"type": "subtitle", "time": 14692.309, "timestamp": "04:04:52", "text": "彼。つまり、優しく丁寧にお願いするということです"}, {"type": "subtitle", "time": 14695.189, "timestamp": "04:04:55", "text": "遊ぶ"}, {"type": "subtitle", "time": 14697.03, "timestamp": "04:04:57", "text": "そして残りのことは実際には私は"}, {"type": "subtitle", "time": 14699.91, "timestamp": "04:04:59", "text": "私も本当に忙しいんです。だから私はかなりたくさん手に入れた"}]
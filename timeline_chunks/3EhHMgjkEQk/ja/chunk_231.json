[{"type": "subtitle", "time": 13890.269, "timestamp": "03:51:30", "text": "次はくそっ。私は"}, {"type": "subtitle", "time": 13892.309, "timestamp": "03:51:32", "text": "銃。待って、私の"}, {"type": "subtitle", "time": 13896.51, "timestamp": "03:51:36", "text": "ミサイル？彼らは"}, {"type": "subtitle", "time": 13899.91, "timestamp": "03:51:39", "text": "もの。ああ、もしかして君が僕のパソコンを撃ったのかもね"}, {"type": "subtitle", "time": 13907.67, "timestamp": "03:51:47", "text": "多分。"}, {"type": "subtitle", "time": 13913.429, "timestamp": "03:51:53", "text": "ええと、私は続けることもできますし、"}, {"type": "subtitle", "time": 13916.55, "timestamp": "03:51:56", "text": "私の飛行機を徐々に劣化させて墜落させる"}, {"type": "subtitle", "time": 13919.189, "timestamp": "03:51:59", "text": "もしくは、私が修理することもできます。より速く"}]
[{"type": "subtitle", "time": 5940.55, "timestamp": "01:39:00", "text": "レーダーには、レーダーモードがあります。"}, {"type": "subtitle", "time": 5942.149, "timestamp": "01:39:02", "text": "カメラにはさまざまな種類があります"}, {"type": "subtitle", "time": 5944.189, "timestamp": "01:39:04", "text": "ミサイルにはさまざまな種類があります"}, {"type": "subtitle", "time": 5946.79, "timestamp": "01:39:06", "text": "爆弾。空気と呼ばれるものを手に入れる"}, {"type": "subtitle", "time": 5948.59, "timestamp": "01:39:08", "text": "ブラジャーは、"}, {"type": "subtitle", "time": 5950.87, "timestamp": "01:39:10", "text": "羽根。次のようなことに気を配る必要があります"}, {"type": "subtitle", "time": 5952.79, "timestamp": "01:39:12", "text": "着陸装置。覚えておかなければならない"}, {"type": "subtitle", "time": 5954.87, "timestamp": "01:39:14", "text": "それを閉じないと壊れてしまう"}, {"type": "subtitle", "time": 5962.149, "timestamp": "01:39:22", "text": "良い点もある。えっと、何ですか"}, {"type": "subtitle", "time": 5963.99, "timestamp": "01:39:23", "text": "あなたはそれを何と呼びますか？射出"}, {"type": "subtitle", "time": 5966.39, "timestamp": "01:39:26", "text": "シート。だから、飛行機が墜落しても、"}, {"type": "subtitle", "time": 5968.79, "timestamp": "01:39:28", "text": "パイロットを救出できれば、あなたは"}, {"type": "subtitle", "time": 5972.95, "timestamp": "01:39:32", "text": "修理費用が少なくて済む。"}, {"type": "subtitle", "time": 5975.27, "timestamp": "01:39:35", "text": "ああ、もし飛行機が損傷しても"}, {"type": "subtitle", "time": 5977.35, "timestamp": "01:39:37", "text": "空中に戻すことができる"}, {"type": "subtitle", "time": 5979.83, "timestamp": "01:39:39", "text": "試合中にベースを構え、"}, {"type": "subtitle", "time": 5982.79, "timestamp": "01:39:42", "text": "無事に着陸すれば、料金は一切かかりません。"}, {"type": "subtitle", "time": 5985.35, "timestamp": "01:39:45", "text": "修理のため。飛行機は修理される"}, {"type": "subtitle", "time": 5988.79, "timestamp": "01:39:48", "text": "試合が終われば、再び離陸できます。"}, {"type": "subtitle", "time": 5991.27, "timestamp": "01:39:51", "text": "ああ、私が一度やったことがあるのを覚えている"}, {"type": "subtitle", "time": 5992.669, "timestamp": "01:39:52", "text": "最初にプレイされました。"}, {"type": "subtitle", "time": 5994.87, "timestamp": "01:39:54", "text": "はい、おそらくそれがあなたがレベルアップした理由でしょう"}, {"type": "subtitle", "time": 5996.55, "timestamp": "01:39:56", "text": "三つ。たとえあなたが"}, {"type": "subtitle", "time": 5998.31, "timestamp": "01:39:58", "text": "シングルマッチで、おそらくあなたはそれを"}]
[{"type": "subtitle", "time": 14341.15, "timestamp": "03:59:01", "text": "そして私は、"}, {"type": "subtitle", "time": 14349.11, "timestamp": "03:59:09", "text": "この砂漠の地に都市がある"}, {"type": "subtitle", "time": 14350.87, "timestamp": "03:59:10", "text": "まっすぐな道。実際、これは"}, {"type": "subtitle", "time": 14352.63, "timestamp": "03:59:12", "text": "着陸練習には本当に素晴らしい。"}, {"type": "subtitle", "time": 14355.75, "timestamp": "03:59:15", "text": "離着陸の練習。"}, {"type": "subtitle", "time": 14358.07, "timestamp": "03:59:18", "text": "ひどく悪い人でないと"}, {"type": "subtitle", "time": 14359.83, "timestamp": "03:59:19", "text": "すぐに着陸した。はい、私の姿が見えますか？"}, {"type": "subtitle", "time": 14366.95, "timestamp": "03:59:26", "text": "都市の背後の砂漠地帯には"}, {"type": "subtitle", "time": 14370.429, "timestamp": "03:59:30", "text": "スポーン地点へ。振り向く"}, {"type": "subtitle", "time": 14375.99, "timestamp": "03:59:35", "text": "180度。今、私の姿が見えますか？うん。"}, {"type": "subtitle", "time": 14379.189, "timestamp": "03:59:39", "text": "わかった。描画距離を確認させてください"}, {"type": "subtitle", "time": 14381.63, "timestamp": "03:59:41", "text": "高くない"}, {"type": "subtitle", "time": 14387.99, "timestamp": "03:59:47", "text": "自分。いいえ、あなたは市内へ行くのです。あなた"}, {"type": "subtitle", "time": 14391.349, "timestamp": "03:59:51", "text": "そこから抜け出さなければならない。ああ、後ろだ。"}, {"type": "subtitle", "time": 14396.63, "timestamp": "03:59:56", "text": "後ろに。ああ、君のことが分かったよ。うん。あなたは私に会います？"}]
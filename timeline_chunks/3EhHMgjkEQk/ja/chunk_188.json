[{"type": "subtitle", "time": 11280.71, "timestamp": "03:08:00", "text": "だって、ほら、それはまるで本物みたいだから"}, {"type": "subtitle", "time": 11282.87, "timestamp": "03:08:02", "text": "物事、私たちが実際に打ち上げられる方法"}, {"type": "subtitle", "time": 11286.23, "timestamp": "03:08:06", "text": "人生。エースではこうして起こった"}, {"type": "subtitle", "time": 11287.59, "timestamp": "03:08:07", "text": "戦闘だと思います。そしてそれはまた"}, {"type": "subtitle", "time": 11289.51, "timestamp": "03:08:09", "text": "『トップガン』シリーズで描かれたように。"}, {"type": "subtitle", "time": 11292.389, "timestamp": "03:08:12", "text": "だからViを押すと、"}, {"type": "subtitle", "time": 11294.07, "timestamp": "03:08:14", "text": "これが、あなたが世に出る方法です。これは"}, {"type": "subtitle", "time": 11296.469, "timestamp": "03:08:16", "text": "あなたが見るもの。わかった。"}, {"type": "subtitle", "time": 11298.469, "timestamp": "03:08:18", "text": "または、もう一度Bを押すと、"}, {"type": "subtitle", "time": 11300.15, "timestamp": "03:08:20", "text": "飛行機全体が"}, {"type": "subtitle", "time": 11301.83, "timestamp": "03:08:21", "text": "発売されました。"}, {"type": "subtitle", "time": 11308.07, "timestamp": "03:08:28", "text": "いいえ、Bは壊れていません。それは"}, {"type": "subtitle", "time": 11313.03, "timestamp": "03:08:33", "text": "キーバインド。スロットルはBRKと表示されています"}, {"type": "subtitle", "time": 11320.389, "timestamp": "03:08:40", "text": "素晴らしい。うん。まあ、とにかく、"}, {"type": "subtitle", "time": 11322.07, "timestamp": "03:08:42", "text": "2番。どのカメラビューをご希望ですか？"}, {"type": "subtitle", "time": 11324.309, "timestamp": "03:08:44", "text": "一緒に行く？こちらか、それとももう一方か？"}, {"type": "subtitle", "time": 11327.429, "timestamp": "03:08:47", "text": "これと同じ、他のもの？はい。もう一つ"}, {"type": "subtitle", "time": 11330.15, "timestamp": "03:08:50", "text": "これです。"}, {"type": "subtitle", "time": 11333.87, "timestamp": "03:08:53", "text": "じゃあ、コッカー・スパニエルを試してみようかな。"}, {"type": "subtitle", "time": 11337.67, "timestamp": "03:08:57", "text": "わかった。瞬時にスロットルを110%まで開ける。"}, {"type": "subtitle", "time": 11338.91, "timestamp": "03:08:58", "text": "すぐに"}]
[{"type": "subtitle", "time": 6722.31, "timestamp": "01:52:02", "text": "はい、こちらが緑色です。"}, {"type": "subtitle", "time": 6733.51, "timestamp": "01:52:13", "text": "ああ、墜落したんだ。はい、あそこにいます。"}, {"type": "subtitle", "time": 6740.31, "timestamp": "01:52:20", "text": "はい、気をつけてください。私は守っているわけではない"}, {"type": "subtitle", "time": 6743.669, "timestamp": "01:52:23", "text": "あなたはもう後れを取っています。一人の男を連れて行かなければならない"}, {"type": "subtitle", "time": 6750.35, "timestamp": "01:52:30", "text": "ああ、私は死んだ。"}, {"type": "subtitle", "time": 6753.189, "timestamp": "01:52:33", "text": "ああ、わかった。"}, {"type": "subtitle", "time": 6765.83, "timestamp": "01:52:45", "text": "ドア。だから、我々は戦車を破壊しなければならない"}, {"type": "subtitle", "time": 6768.709, "timestamp": "01:52:48", "text": "同じように。えっと、"}, {"type": "subtitle", "time": 6776.31, "timestamp": "01:52:56", "text": "トラックを見つけて撃つことができます"}]
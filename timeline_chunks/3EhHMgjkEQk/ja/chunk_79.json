[{"type": "subtitle", "time": 4740.95, "timestamp": "01:19:00", "text": "もっと努力を。"}, {"type": "subtitle", "time": 4749.51, "timestamp": "01:19:09", "text": "今の私の問題は、出演者を見つけることだ。"}, {"type": "subtitle", "time": 4753.669, "timestamp": "01:19:13", "text": "こういった爆弾や物資の購入方法。"}, {"type": "subtitle", "time": 4757.11, "timestamp": "01:19:17", "text": "ああ、そうですか。何が"}, {"type": "subtitle", "time": 4758.83, "timestamp": "01:19:18", "text": "探している"}, {"type": "subtitle", "time": 4761.91, "timestamp": "01:19:21", "text": "で。ああ、つまりそういう仕組みなんですね。"}, {"type": "subtitle", "time": 4764.709, "timestamp": "01:19:24", "text": "あなたのXPですよね？"}, {"type": "subtitle", "time": 4767.91, "timestamp": "01:19:27", "text": "パイロットのレベルアップに必要な経験値は"}, {"type": "subtitle", "time": 4770.63, "timestamp": "01:19:30", "text": "飛行機のXPとは異なります。"}, {"type": "subtitle", "time": 4774.31, "timestamp": "01:19:34", "text": "だから、例えばどんな車ゲームでも"}, {"type": "subtitle", "time": 4776.709, "timestamp": "01:19:36", "text": "Forzaやその他のゲームでは"}, {"type": "subtitle", "time": 4779.27, "timestamp": "01:19:39", "text": "お使いの車両の標準バージョン。ああ、神様。"}, {"type": "subtitle", "time": 4783.03, "timestamp": "01:19:43", "text": "車両をアップグレードする必要があります。うん。"}, {"type": "subtitle", "time": 4790.55, "timestamp": "01:19:50", "text": "爆弾。もっと高いところに行くと"}, {"type": "subtitle", "time": 4799.39, "timestamp": "01:19:59", "text": "変更点。"}]
[{"type": "subtitle", "time": 15723.269, "timestamp": "04:22:03", "text": "十分クールだから、彼らはそれを入れるだろう"}, {"type": "subtitle", "time": 15725.75, "timestamp": "04:22:05", "text": "彼らの毎週のビデオを見ると、5,000 を獲得できます"}, {"type": "subtitle", "time": 15727.99, "timestamp": "04:22:07", "text": "銀の獅子。ごめんね、ゴールデンイーグルス、"}, {"type": "subtitle", "time": 15732.07, "timestamp": "04:22:12", "text": "銀色の線。 5000？それはすごい量ですね。おお。"}, {"type": "subtitle", "time": 15733.75, "timestamp": "04:22:13", "text": "ええ、プレミアム飛行機は"}, {"type": "subtitle", "time": 15739.91, "timestamp": "04:22:19", "text": "つまり、それが3つ目の唯一の方法です"}, {"type": "subtitle", "time": 15744.389, "timestamp": "04:22:24", "text": "プレミアムコンテンツを無料で入手。"}, {"type": "subtitle", "time": 15745.83, "timestamp": "04:22:25", "text": "プレミアム会員になるには2つの方法があります"}, {"type": "subtitle", "time": 15747.67, "timestamp": "04:22:27", "text": "車両、そして一つの方法"}, {"type": "subtitle", "time": 15756.71, "timestamp": "04:22:36", "text": "資本主義も社会主義も共産主義も忘れろ。"}, {"type": "subtitle", "time": 15759.99, "timestamp": "04:22:39", "text": "私たちはジャガーディズムです。"}, {"type": "subtitle", "time": 15768.79, "timestamp": "04:22:48", "text": "最も簡単で、最も安価で、無料のものを見つけます"}, {"type": "subtitle", "time": 15770.309, "timestamp": "04:22:50", "text": "予算に優しい方法"}, {"type": "subtitle", "time": 15771.42, "timestamp": "04:22:51", "text": "何か。"}, {"type": "subtitle", "time": 15773.75, "timestamp": "04:22:53", "text": "[音楽]"}]
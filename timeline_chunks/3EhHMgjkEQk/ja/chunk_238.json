[{"type": "subtitle", "time": 14288.15, "timestamp": "03:58:08", "text": "いじめられた。わかった、あなたが手に入れるまで待つよ"}, {"type": "subtitle", "time": 14289.15, "timestamp": "03:58:09", "text": "へ"}, {"type": "subtitle", "time": 14291.91, "timestamp": "03:58:11", "text": "市。主要都市に行きたい"}, {"type": "subtitle", "time": 14293.91, "timestamp": "03:58:13", "text": "それとも、こうしようか？どれでも選んでください。考える"}, {"type": "subtitle", "time": 14296.63, "timestamp": "03:58:16", "text": "私たちは何を望んでいるのか？実のところ、よくわからないんです。"}, {"type": "subtitle", "time": 14298.269, "timestamp": "03:58:18", "text": "実は。うん。うん。どうぞ。行く"}, {"type": "subtitle", "time": 14312.87, "timestamp": "03:58:32", "text": "わかった？見てみましょう。私の"}, {"type": "subtitle", "time": 14315.429, "timestamp": "03:58:35", "text": "あまり。いいえ。ミサイルを発射しました。"}, {"type": "subtitle", "time": 14320.95, "timestamp": "03:58:40", "text": "おお、"}, {"type": "subtitle", "time": 14322.389, "timestamp": "03:58:42", "text": "文字通りそこにいなければなりません"}, {"type": "subtitle", "time": 14324.229, "timestamp": "03:58:44", "text": "建物。飛行機に乗らなければならない"}, {"type": "subtitle", "time": 14325.91, "timestamp": "03:58:45", "text": "通り。"}, {"type": "subtitle", "time": 14327.83, "timestamp": "03:58:47", "text": "ああ、木々があってそれは不可能だ"}, {"type": "subtitle", "time": 14329.51, "timestamp": "03:58:49", "text": "すべて。"}, {"type": "subtitle", "time": 14331.349, "timestamp": "03:58:51", "text": "ああ、そのやり方を知りたいの？"}, {"type": "subtitle", "time": 14334.79, "timestamp": "03:58:54", "text": "はい、どうぞお入りください。ご案内します。わかった。"}, {"type": "subtitle", "time": 14337.75, "timestamp": "03:58:57", "text": "わかった。だから、私はあなたの隣を飛ぶつもりです"}]
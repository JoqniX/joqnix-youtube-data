[{"type": "subtitle", "time": 7982.55, "timestamp": "02:13:02", "text": "さて、アーケードモードなので、ジョック、"}, {"type": "subtitle", "time": 7987.069, "timestamp": "02:13:07", "text": "あなたのカーソル、あなたの"}, {"type": "subtitle", "time": 7989.669, "timestamp": "02:13:09", "text": "照準線は、敵に照準を合わせると表示されます。"}, {"type": "subtitle", "time": 7992.95, "timestamp": "02:13:12", "text": "タンク、緑色になった瞬間、"}, {"type": "subtitle", "time": 7995.35, "timestamp": "02:13:15", "text": "シュート。私は死んだ。緑色にならない限り、"}, {"type": "subtitle", "time": 7996.35, "timestamp": "02:13:16", "text": "しないで"}, {"type": "subtitle", "time": 7999.35, "timestamp": "02:13:19", "text": "シュート。そして君は既に死んでいる。素晴らしい。"}, {"type": "subtitle", "time": 8002.39, "timestamp": "02:13:22", "text": "わかった、君が戻ってくるのを待つよ。"}, {"type": "subtitle", "time": 8019.31, "timestamp": "02:13:39", "text": "行く。私たちは別のものを"}, {"type": "subtitle", "time": 8021.669, "timestamp": "02:13:41", "text": "それ。もう1つ手に入れるつもりだ"}, {"type": "subtitle", "time": 8024.189, "timestamp": "02:13:44", "text": "War Thunderをプレイ中。さあ"}, {"type": "subtitle", "time": 8026.109, "timestamp": "02:13:46", "text": "行く。"}, {"type": "subtitle", "time": 8039.589, "timestamp": "02:13:59", "text": "あとは、"}]
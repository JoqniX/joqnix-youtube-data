[{"type": "subtitle", "time": 13261.67, "timestamp": "03:41:01", "text": "これを続ける。続けますか？"}, {"type": "subtitle", "time": 13264.87, "timestamp": "03:41:04", "text": "まあ、確かにそうですね。心配ない。いいえ、もしあなたが"}, {"type": "subtitle", "time": 13267.309, "timestamp": "03:41:07", "text": "楽しんでいます。いいえ、これは"}, {"type": "subtitle", "time": 13270.349, "timestamp": "03:41:10", "text": "あなた。私はこのゲームの遊び方をよく知っています"}, {"type": "subtitle", "time": 13273.429, "timestamp": "03:41:13", "text": "良い。これは、ジョーが学んだストリームです"}, {"type": "subtitle", "time": 13275.269, "timestamp": "03:41:15", "text": "雷鳴の鳴らし方。あなたが何をしたいにせよ、"}, {"type": "subtitle", "time": 13287.349, "timestamp": "03:41:27", "text": "する？ロビーまで戻ってください"}, {"type": "subtitle", "time": 13292.87, "timestamp": "03:41:32", "text": "そうすれば、このことを変えられる。"}, {"type": "subtitle", "time": 13294.79, "timestamp": "03:41:34", "text": "あなたはこの習慣を続けたいのですか？"}, {"type": "subtitle", "time": 13298.75, "timestamp": "03:41:38", "text": "うん。ええ、もちろんです。はい、では"}, {"type": "subtitle", "time": 13300.71, "timestamp": "03:41:40", "text": "ヘンリーさん、以下のことに感謝します。"}, {"type": "subtitle", "time": 13303.269, "timestamp": "03:41:43", "text": "配信へようこ​​そ。配信はどうですか？"}, {"type": "subtitle", "time": 13305.75, "timestamp": "03:41:45", "text": "行くの？順調です。私たちは学んでいます"}, {"type": "subtitle", "time": 13309.19, "timestamp": "03:41:49", "text": "飛行機についてたくさん。いいえ。"}, {"type": "subtitle", "time": 13311.51, "timestamp": "03:41:51", "text": "飛行機、戦闘機、戦争"}, {"type": "subtitle", "time": 13313.349, "timestamp": "03:41:53", "text": "プラナネス。"}, {"type": "subtitle", "time": 13315.03, "timestamp": "03:41:55", "text": "ええ、中には次のように使えるものもあります"}]
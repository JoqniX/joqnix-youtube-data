[{"type": "subtitle", "time": 5402.629, "timestamp": "01:30:02", "text": "代替地上空間。左コントロール+Alt。"}, {"type": "subtitle", "time": 5405.51, "timestamp": "01:30:05", "text": "わかった。さあ、待って。近くに飛行機はありません"}, {"type": "subtitle", "time": 5411.149, "timestamp": "01:30:11", "text": "その周り。飛行機に乗って"}, {"type": "subtitle", "time": 5413.07, "timestamp": "01:30:13", "text": "交差した"}, {"type": "subtitle", "time": 5415.83, "timestamp": "01:30:15", "text": "そして、それを支持しようと努める。あなたはそうはならないでしょう"}, {"type": "subtitle", "time": 5417.79, "timestamp": "01:30:17", "text": "前方から発射できる"}, {"type": "subtitle", "time": 5420.149, "timestamp": "01:30:20", "text": "それ。さて、なぜなのか知りたいですか？"}, {"type": "subtitle", "time": 5423.59, "timestamp": "01:30:23", "text": "それ？なぜ？"}, {"type": "subtitle", "time": 5426.149, "timestamp": "01:30:26", "text": "ミサイルがまだ新しいものだった昔、"}, {"type": "subtitle", "time": 5428.79, "timestamp": "01:30:28", "text": "カメラミサイルが見ているだけだった"}, {"type": "subtitle", "time": 5431.91, "timestamp": "01:30:31", "text": "敵機の熱に対して、エンジンは"}, {"type": "subtitle", "time": 5432.99, "timestamp": "01:30:32", "text": "排気"}, {"type": "subtitle", "time": 5435.99, "timestamp": "01:30:35", "text": "熱と、ご存知のように、新しい技術。"}, {"type": "subtitle", "time": 5438.55, "timestamp": "01:30:38", "text": "彼らは十分ではなかった。だから、"}, {"type": "subtitle", "time": 5441.27, "timestamp": "01:30:41", "text": "背後からの熱しか感じられない。それは"}, {"type": "subtitle", "time": 5442.79, "timestamp": "01:30:42", "text": "これらのミサイルが機能したのは"}, {"type": "subtitle", "time": 5446.31, "timestamp": "01:30:46", "text": "あなたは敵機の背後にいます。"}, {"type": "subtitle", "time": 5450.31, "timestamp": "01:30:50", "text": "ああ、今度は内側の円を"}, {"type": "subtitle", "time": 5452.03, "timestamp": "01:30:52", "text": "敵"}, {"type": "subtitle", "time": 5455.47, "timestamp": "01:30:55", "text": "ボタンを押す"}, {"type": "subtitle", "time": 5457.95, "timestamp": "01:30:57", "text": "また。はい、ポイント"}]
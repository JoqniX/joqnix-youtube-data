[{"type": "subtitle", "time": 15482.75, "timestamp": "04:18:02", "text": "何？ああ、いや、いや、いや、"}, {"type": "subtitle", "time": 15497.83, "timestamp": "04:18:17", "text": "の上。プレイ回数ランキング29位。"}, {"type": "subtitle", "time": 15500.63, "timestamp": "04:18:20", "text": "聖なる。"}, {"type": "subtitle", "time": 15503.03, "timestamp": "04:18:23", "text": "プレイ回数が30位近くになるゲームです。"}, {"type": "subtitle", "time": 15505.269, "timestamp": "04:18:25", "text": "そして7000万人のプレイヤーがいて、"}, {"type": "subtitle", "time": 15508.95, "timestamp": "04:18:28", "text": "たくさん稼ぐ。"}, {"type": "subtitle", "time": 15511.51, "timestamp": "04:18:31", "text": "えーと、プレイ回数が30位のゲームでもある"}, {"type": "subtitle", "time": 15513.269, "timestamp": "04:18:33", "text": "それは、あなたが他の人より収入が少ないという意味ではありません"}, {"type": "subtitle", "time": 15515.11, "timestamp": "04:18:35", "text": "君の上の人たち。あなたは"}, {"type": "subtitle", "time": 15523.63, "timestamp": "04:18:43", "text": "ええ、それは大きな"}, {"type": "subtitle", "time": 15529.269, "timestamp": "04:18:49", "text": "詐欺市場。えっと、つまり経済みたいな感じですね。"}, {"type": "subtitle", "time": 15536.83, "timestamp": "04:18:56", "text": "ほら、あなたが与えるか"}]
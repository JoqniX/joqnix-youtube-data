[{"type": "subtitle", "time": 16201.83, "timestamp": "04:30:01", "text": "ポップアップは技術ツリーです。ああ、それで"}, {"type": "subtitle", "time": 16205.75, "timestamp": "04:30:05", "text": "下にスクロールするとイギリス人"}, {"type": "subtitle", "time": 16208.389, "timestamp": "04:30:08", "text": "プレミアムでジャガーを見かける"}, {"type": "subtitle", "time": 16212.71, "timestamp": "04:30:12", "text": "そして、その下に最後のものが表示されます"}, {"type": "subtitle", "time": 16216.26, "timestamp": "04:30:16", "text": "大きな21頭のバイソン。ええ、二人ともインド人です。"}, {"type": "subtitle", "time": 16217.91, "timestamp": "04:30:17", "text": "[音楽]"}, {"type": "subtitle", "time": 16221.91, "timestamp": "04:30:21", "text": "他の多くの国でも同様で、"}, {"type": "subtitle", "time": 16223.59, "timestamp": "04:30:23", "text": "プレミアム版では、他のいくつかの国では"}, {"type": "subtitle", "time": 16227.349, "timestamp": "04:30:27", "text": "標準技術ツリーにも"}, {"type": "subtitle", "time": 16230.71, "timestamp": "04:30:30", "text": "例えば、航空機を手に入れると"}, {"type": "subtitle", "time": 16233.429, "timestamp": "04:30:33", "text": "ルーマニアは、私が思うに、"}, {"type": "subtitle", "time": 16236.87, "timestamp": "04:30:36", "text": "イタリアの技術ツリーか何か"}, {"type": "subtitle", "time": 16238.87, "timestamp": "04:30:38", "text": "ルーマニアは大きな国ではありませんが、"}, {"type": "subtitle", "time": 16240.309, "timestamp": "04:30:40", "text": "追加したい飛行機がたくさんある"}]
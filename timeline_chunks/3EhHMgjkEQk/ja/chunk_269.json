[{"type": "subtitle", "time": 16141.269, "timestamp": "04:29:01", "text": "また、少し遅れて到着したと思います。"}, {"type": "subtitle", "time": 16143.11, "timestamp": "04:29:03", "text": "そして彼らは気づいた、ああそれはちょっと"}, {"type": "subtitle", "time": 16145.349, "timestamp": "04:29:05", "text": "飽きてきたらもっと国を追加しよう"}, {"type": "subtitle", "time": 16147.03, "timestamp": "04:29:07", "text": "そこでイスラエルなどの国を追加した。"}, {"type": "subtitle", "time": 16148.59, "timestamp": "04:29:08", "text": "スウェーデン、"}, {"type": "subtitle", "time": 16150.87, "timestamp": "04:29:10", "text": "中国。すると彼らは「ああ、私たちは"}, {"type": "subtitle", "time": 16152.07, "timestamp": "04:29:12", "text": "国を追加したが、彼らは望んでいなかった"}, {"type": "subtitle", "time": 16153.99, "timestamp": "04:29:13", "text": "バーを満杯にするために、彼らは気づいた"}, {"type": "subtitle", "time": 16155.79, "timestamp": "04:29:15", "text": "これらがたくさんある"}, {"type": "subtitle", "time": 16158.63, "timestamp": "04:29:18", "text": "彼らの艦隊全体が"}, {"type": "subtitle", "time": 16161.269, "timestamp": "04:29:21", "text": "他の業者から購入した飛行機から既存の"}, {"type": "subtitle", "time": 16165.269, "timestamp": "04:29:25", "text": "既にこのゲームに参加している国々。"}, {"type": "subtitle", "time": 16168.469, "timestamp": "04:29:28", "text": "そこで彼らはサブツリーと呼ばれるものを作りました。"}, {"type": "subtitle", "time": 16171.83, "timestamp": "04:29:31", "text": "イギリスをイギリスの下で開くと"}, {"type": "subtitle", "time": 16175.67, "timestamp": "04:29:35", "text": "インドの技術ツリーが見つかります。の"}, {"type": "subtitle", "time": 16177.63, "timestamp": "04:29:37", "text": "この地図全体"}, {"type": "subtitle", "time": 16180.469, "timestamp": "04:29:40", "text": "平面が描かれた長方形の"}, {"type": "subtitle", "time": 16184.79, "timestamp": "04:29:44", "text": "技術ツリー。このゲーエン市場とは何ですか？"}, {"type": "subtitle", "time": 16187.99, "timestamp": "04:29:47", "text": "Gajunマーケットは無料プレイヤー向けではありません"}, {"type": "subtitle", "time": 16190.63, "timestamp": "04:29:50", "text": "あなたがそうするつもりでない限り"}, {"type": "subtitle", "time": 16191.71, "timestamp": "04:29:51", "text": "どこにあるの"}, {"type": "subtitle", "time": 16194.229, "timestamp": "04:29:54", "text": "テクノロジー？それが技術です。あなたが見ているのは"}, {"type": "subtitle", "time": 16195.91, "timestamp": "04:29:55", "text": "技術ツリー。この全ては"}, {"type": "subtitle", "time": 16198.389, "timestamp": "04:29:58", "text": "技術ツリー。ああ、これがこの全体"}]
[{"type": "subtitle", "time": 2760.15, "timestamp": "00:46:00", "text": "そしてその後は、他のことをします"}, {"type": "subtitle", "time": 2763.51, "timestamp": "00:46:03", "text": "セッション。ああ、私の壮大な"}, {"type": "subtitle", "time": 2774.23, "timestamp": "00:46:14", "text": "ええ、見るためにたくさん買いましたよ。私は思う"}, {"type": "subtitle", "time": 2776.15, "timestamp": "00:46:16", "text": "ええと、もうずいぶん経ちましたね。だから"}, {"type": "subtitle", "time": 2780.47, "timestamp": "00:46:20", "text": "私のデータがすべてリセットされたのだと思います。"}, {"type": "subtitle", "time": 2782.23, "timestamp": "00:46:22", "text": "あなたが"}, {"type": "subtitle", "time": 2783.99, "timestamp": "00:46:23", "text": "新規アカウントで参加します。もしそれが"}, {"type": "subtitle", "time": 2786.55, "timestamp": "00:46:26", "text": "同じアカウントであれば、常にそこに存在します。"}, {"type": "subtitle", "time": 2788.15, "timestamp": "00:46:28", "text": "しかし、それは存在しない。私はプレイしました"}, {"type": "subtitle", "time": 2789.67, "timestamp": "00:46:29", "text": "前に。毒のある"}, {"type": "subtitle", "time": 2791.349, "timestamp": "00:46:31", "text": "War Thunderとの関係は多くの"}, {"type": "subtitle", "time": 2793.109, "timestamp": "00:46:33", "text": "何度か別れたけど、"}, {"type": "subtitle", "time": 2797.19, "timestamp": "00:46:37", "text": "アンインストールしました。何てことだ。そして、"}, {"type": "subtitle", "time": 2798.87, "timestamp": "00:46:38", "text": "久しぶりに再インストールしました"}, {"type": "subtitle", "time": 2800.71, "timestamp": "00:46:40", "text": "また。アカウントが同じであれば、"}, {"type": "subtitle", "time": 2803.109, "timestamp": "00:46:43", "text": "あなたの過去の記録はすべてそこにあります。"}, {"type": "subtitle", "time": 2805.75, "timestamp": "00:46:45", "text": "H. だから、通常は問題になりません。"}, {"type": "subtitle", "time": 2808.95, "timestamp": "00:46:48", "text": "さあ、準備を整えよう。よし。"}, {"type": "subtitle", "time": 2810.79, "timestamp": "00:46:50", "text": "どの飛行機に乗ればいいですか？病気"}, {"type": "subtitle", "time": 2813.39, "timestamp": "00:46:53", "text": "準備はいいですか？何でも。あなたが何であれ"}, {"type": "subtitle", "time": 2815.91, "timestamp": "00:46:55", "text": "欲しい。選択肢が限られているので、"}, {"type": "subtitle", "time": 2819.19, "timestamp": "00:46:59", "text": "だから、私はあなたを制限したりはしません。"}]
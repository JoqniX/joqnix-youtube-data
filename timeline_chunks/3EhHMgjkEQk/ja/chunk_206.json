[{"type": "subtitle", "time": 12363.79, "timestamp": "03:26:03", "text": "これ。あなたの熱特性はそれほどではありません。"}, {"type": "subtitle", "time": 12368.15, "timestamp": "03:26:08", "text": "まあ、あっという間だったね。"}, {"type": "subtitle", "time": 12371.11, "timestamp": "03:26:11", "text": "聖なる主よ、"}, {"type": "subtitle", "time": 12372.63, "timestamp": "03:26:12", "text": "本当に近いですね。ところで、"}, {"type": "subtitle", "time": 12375.51, "timestamp": "03:26:15", "text": "もしあなたが私を撃たなかったら、別の飛行機で"}, {"type": "subtitle", "time": 12377.429, "timestamp": "03:26:17", "text": "撃ち殺されていたでしょう。あなた あなた"}, {"type": "subtitle", "time": 12379.11, "timestamp": "03:26:19", "text": "何だと思う？お話しする前に、"}, {"type": "subtitle", "time": 12380.87, "timestamp": "03:26:20", "text": "体験してみてください。リーブ・ハングルから出て行け。"}, {"type": "subtitle", "time": 12383.349, "timestamp": "03:26:23", "text": "ハングルへ行きなさい。カスタムについて見ていきましょう"}, {"type": "subtitle", "time": 12389.03, "timestamp": "03:26:29", "text": "これは素晴らしい。子供に教えるようなものだ"}, {"type": "subtitle", "time": 12391.67, "timestamp": "03:26:31", "text": "幼稚園で自転車に乗る方法。おお"}, {"type": "subtitle", "time": 12393.99, "timestamp": "03:26:33", "text": "我が神よ。"}, {"type": "subtitle", "time": 12395.75, "timestamp": "03:26:35", "text": "うん。通常、戦争は本当に"}, {"type": "subtitle", "time": 12397.95, "timestamp": "03:26:37", "text": "迷惑で"}, {"type": "subtitle", "time": 12407.99, "timestamp": "03:26:47", "text": "甘い。はい、もうやめてください。"}, {"type": "subtitle", "time": 12410.63, "timestamp": "03:26:50", "text": "このプレミアム版はテストできません"}, {"type": "subtitle", "time": 12412.469, "timestamp": "03:26:52", "text": "まるで私たち全員がオーダーメイドであるかのように。ええ、できません"}, {"type": "subtitle", "time": 12414.55, "timestamp": "03:26:54", "text": "テストで私と戦いに行こう"}, {"type": "subtitle", "time": 12416.63, "timestamp": "03:26:56", "text": "飛行機。"}, {"type": "subtitle", "time": 12418.469, "timestamp": "03:26:58", "text": "テスト機では、すべてを行うことができます"}]
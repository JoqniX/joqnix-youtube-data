[{"type": "subtitle", "time": 9900.83, "timestamp": "02:45:00", "text": "待って。それは「どこだ」をやっていない"}, {"type": "subtitle", "time": 9903.23, "timestamp": "02:45:03", "text": "フレア？どこにあるの"}, {"type": "subtitle", "time": 9905.75, "timestamp": "02:45:05", "text": "火？おお、"}, {"type": "subtitle", "time": 9914.07, "timestamp": "02:45:14", "text": "行く。わかった。 Cを押して変更します"}, {"type": "subtitle", "time": 9916.429, "timestamp": "02:45:16", "text": "あなたのカメラ。カメラをパンさせてください"}, {"type": "subtitle", "time": 9938.389, "timestamp": "02:45:38", "text": "真っ直ぐ。わかった。さあ、あなたの翼を見てください。"}, {"type": "subtitle", "time": 9940.79, "timestamp": "02:45:40", "text": "彼らは、"}, {"type": "subtitle", "time": 9942.07, "timestamp": "02:45:42", "text": "始める？"}, {"type": "subtitle", "time": 9945.11, "timestamp": "02:45:45", "text": "ちょっと待って。そしてあなたはただ聞こえない"}, {"type": "subtitle", "time": 9946.71, "timestamp": "02:45:46", "text": "何かできる？あなたはちょうど渡ったところです"}, {"type": "subtitle", "time": 9948.19, "timestamp": "02:45:48", "text": "音"}, {"type": "subtitle", "time": 9951.59, "timestamp": "02:45:51", "text": "ええと、音の壁。何？それは"}, {"type": "subtitle", "time": 9955.75, "timestamp": "02:45:55", "text": "もの。何？うん。あなたはあの白いものを見た"}, {"type": "subtitle", "time": 9958.15, "timestamp": "02:45:58", "text": "ショックコーンが0.5秒間持ち上がる。"}]
[{"type": "subtitle", "time": 4981.91, "timestamp": "01:23:01", "text": "そのため。離れる。参加してもらいます"}, {"type": "subtitle", "time": 4991.11, "timestamp": "01:23:11", "text": "どうすればいいの？ああ、なんてことだ。これは何ですか？"}, {"type": "subtitle", "time": 4997.03, "timestamp": "01:23:17", "text": "わかった。 Vを押してください。V。ああ、なんてことだ。"}, {"type": "subtitle", "time": 4999.83, "timestamp": "01:23:19", "text": "C を押して、C を押し続けて"}, {"type": "subtitle", "time": 5002.629, "timestamp": "01:23:22", "text": "そして向きを変える。何てことだ。下を見て。"}, {"type": "subtitle", "time": 5007.27, "timestamp": "01:23:27", "text": "下を見て。何てことだ。これはとても"}, {"type": "subtitle", "time": 5010.149, "timestamp": "01:23:30", "text": "わかりました、あなたが探し続ける間"}, {"type": "subtitle", "time": 5012.95, "timestamp": "01:23:32", "text": "下へ、Q と E を押します。"}, {"type": "subtitle", "time": 5020.229, "timestamp": "01:23:40", "text": "聖なる主よ。"}, {"type": "subtitle", "time": 5023.27, "timestamp": "01:23:43", "text": "次に右クリックしてください。"}, {"type": "subtitle", "time": 5026.31, "timestamp": "01:23:46", "text": "ええ、あなたの"}, {"type": "subtitle", "time": 5029.43, "timestamp": "01:23:49", "text": "飛行機に乗るか、飛行機で何かをする。"}, {"type": "subtitle", "time": 5031.189, "timestamp": "01:23:51", "text": "ええと、すべてのダイヤルが見えて、"}, {"type": "subtitle", "time": 5033.51, "timestamp": "01:23:53", "text": "すべて。動く。ああ、撃たれたんだね"}, {"type": "subtitle", "time": 5035.99, "timestamp": "01:23:55", "text": "下。"}, {"type": "subtitle", "time": 5038.629, "timestamp": "01:23:58", "text": "何？航空機から降りてください。離れる。それもまた"}]
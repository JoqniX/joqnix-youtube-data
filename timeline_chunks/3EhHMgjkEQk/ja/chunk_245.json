[{"type": "subtitle", "time": 14709.11, "timestamp": "04:05:09", "text": "モヒクとイチゴはあの人たちだと思う"}, {"type": "subtitle", "time": 14711.51, "timestamp": "04:05:11", "text": "彼らはまた、私たちはただ名前を挙げているだけです"}, {"type": "subtitle", "time": 14713.83, "timestamp": "04:05:13", "text": "離れていても大丈夫ですか？"}, {"type": "subtitle", "time": 14716.63, "timestamp": "04:05:16", "text": "ストリームの倫理についてはよく知らないのですが"}, {"type": "subtitle", "time": 14719.189, "timestamp": "04:05:19", "text": "写真を撮るのは構いません"}, {"type": "subtitle", "time": 14722.79, "timestamp": "04:05:22", "text": "ええ、それでその2人はダウンロードしました"}, {"type": "subtitle", "time": 14725.03, "timestamp": "04:05:25", "text": "彼らはプレイしていないと思う"}, {"type": "subtitle", "time": 14727.75, "timestamp": "04:05:27", "text": "カイラはプレイして楽しんだ。"}, {"type": "subtitle", "time": 14731.03, "timestamp": "04:05:31", "text": "彼女がそれを演奏した時、イチゴキラだと思う"}, {"type": "subtitle", "time": 14735.75, "timestamp": "04:05:35", "text": "そして、アカムルは一緒に演奏しました"}, {"type": "subtitle", "time": 14738.389, "timestamp": "04:05:38", "text": "彼らは一度だけプレイした時に楽しんだ"}, {"type": "subtitle", "time": 14742.389, "timestamp": "04:05:42", "text": "いいムラですね。私はただ、"}, {"type": "subtitle", "time": 14749.189, "timestamp": "04:05:49", "text": "プレイとジャズ、彼を引っ張らないといけない"}]
[{"type": "subtitle", "time": 6960.07, "timestamp": "01:56:00", "text": "ああ、ちょっと"}, {"type": "subtitle", "time": 6965.83, "timestamp": "01:56:05", "text": "ニース。不時着の仕方を学ぶ"}, {"type": "subtitle", "time": 6967.83, "timestamp": "01:56:07", "text": "着陸なしで。さあ行こう。私は確信しています。"}, {"type": "subtitle", "time": 6976.47, "timestamp": "01:56:16", "text": "一般的に、人々は衝突する傾向があります"}, {"type": "subtitle", "time": 6978.95, "timestamp": "01:56:18", "text": "着陸より速いから"}, {"type": "subtitle", "time": 6981.99, "timestamp": "01:56:21", "text": "着陸装置付き。うん。でもあなたは"}, {"type": "subtitle", "time": 7000.87, "timestamp": "01:56:40", "text": "あの男はもう終わりだ。もう一人いる、"}, {"type": "subtitle", "time": 7002.95, "timestamp": "01:56:42", "text": "でも彼は結構頭がいいんだ。彼は維持している"}, {"type": "subtitle", "time": 7009.99, "timestamp": "01:56:49", "text": "たった2人だけ。"}, {"type": "subtitle", "time": 7013.669, "timestamp": "01:56:53", "text": "残りはあと2機のみ"}, {"type": "subtitle", "time": 7015.99, "timestamp": "01:56:55", "text": "我々の側にいる。そうみたいですね。ああ、しまった。"}, {"type": "subtitle", "time": 7019.75, "timestamp": "01:56:59", "text": "ああ、俺たちが最後の生き残りだ。おお。そして私は"}]
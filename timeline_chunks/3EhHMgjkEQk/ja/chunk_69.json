[{"type": "subtitle", "time": 4140.63, "timestamp": "01:09:00", "text": "ええ、War Thunderの艦隊戦のことです。"}, {"type": "subtitle", "time": 4142.229, "timestamp": "01:09:02", "text": "おお、"}, {"type": "subtitle", "time": 4144.709, "timestamp": "01:09:04", "text": "彼らはそれを更新していますが、"}, {"type": "subtitle", "time": 4147.91, "timestamp": "01:09:07", "text": "すでに何年も前から誰も知らない"}, {"type": "subtitle", "time": 4149.91, "timestamp": "01:09:09", "text": "プレイする。"}, {"type": "subtitle", "time": 4152.87, "timestamp": "01:09:12", "text": "ああ、だから何かあるはずだ"}, {"type": "subtitle", "time": 4154.87, "timestamp": "01:09:14", "text": "まるで奇跡のように"}, {"type": "subtitle", "time": 4164.63, "timestamp": "01:09:24", "text": "マンダは素晴らしい仕事をします"}, {"type": "subtitle", "time": 4167.189, "timestamp": "01:09:27", "text": "航空機と戦車。つまり一般的には"}, {"type": "subtitle", "time": 4172.07, "timestamp": "01:09:32", "text": "特に、"}, {"type": "subtitle", "time": 4176.229, "timestamp": "01:09:36", "text": "船内空間。また、"}, {"type": "subtitle", "time": 4178.87, "timestamp": "01:09:38", "text": "ゲームを始めて、定期的にプレイし始める"}, {"type": "subtitle", "time": 4181.11, "timestamp": "01:09:41", "text": "混合の試合もあります"}, {"type": "subtitle", "time": 4183.349, "timestamp": "01:09:43", "text": "戦い。飛行機に乗っていると"}, {"type": "subtitle", "time": 4185.349, "timestamp": "01:09:45", "text": "あるいは戦車の中で。だからいくつかあるだろう"}, {"type": "subtitle", "time": 4186.63, "timestamp": "01:09:46", "text": "飛行機に乗っている選手には、"}, {"type": "subtitle", "time": 4189.749, "timestamp": "01:09:49", "text": "戦車に乗ったプレイヤーたち。ああ、見たことがあると思う"}, {"type": "subtitle", "time": 4197.189, "timestamp": "01:09:57", "text": "あなたはフレンドリーなチームを助けて"}, {"type": "subtitle", "time": 4199.99, "timestamp": "01:09:59", "text": "敵チームの戦車を爆撃するか、"}]
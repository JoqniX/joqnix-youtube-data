[{"type": "subtitle", "time": 12720.95, "timestamp": "03:32:00", "text": "そして左、右、左と曲がり続け、"}, {"type": "subtitle", "time": 12722.469, "timestamp": "03:32:02", "text": "右、中央、まるであなたが回し続けるように"}, {"type": "subtitle", "time": 12744.15, "timestamp": "03:32:24", "text": "飛行機はそういう仕組みで動くんです。"}, {"type": "subtitle", "time": 12753.03, "timestamp": "03:32:33", "text": "あなたの戦闘レーティングでは、"}, {"type": "subtitle", "time": 12756.63, "timestamp": "03:32:36", "text": "離陸エリアと中央からの距離"}, {"type": "subtitle", "time": 12759.67, "timestamp": "03:32:39", "text": "地図の は。ああ、君を連れ出せるよ"}, {"type": "subtitle", "time": 12763.67, "timestamp": "03:32:43", "text": "その距離からなら簡単に手に入る。"}, {"type": "subtitle", "time": 12767.75, "timestamp": "03:32:47", "text": "おお。あなたに近づく必要はありません。"}, {"type": "subtitle", "time": 12772.309, "timestamp": "03:32:52", "text": "だから、上を見れば、私がいないところにいるのがわかるでしょう"}, {"type": "subtitle", "time": 12775.59, "timestamp": "03:32:55", "text": "左の方でお会いしましょう。まあ、そうかもしれない"}, {"type": "subtitle", "time": 12776.87, "timestamp": "03:32:56", "text": "こっちに向かってくるミサイルを見てください"}, {"type": "subtitle", "time": 12778.63, "timestamp": "03:32:58", "text": "あなた。"}]
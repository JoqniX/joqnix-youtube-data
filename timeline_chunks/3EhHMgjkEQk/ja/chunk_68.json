[{"type": "subtitle", "time": 4081.829, "timestamp": "01:08:01", "text": "現実を直視すれば、そういう風にプレイすることもできる。今"}, {"type": "subtitle", "time": 4084.549, "timestamp": "01:08:04", "text": "その問題点は、比較的"}, {"type": "subtitle", "time": 4087.75, "timestamp": "01:08:07", "text": "遅い。打ち負かすには長い時間がかかる"}, {"type": "subtitle", "time": 4090.63, "timestamp": "01:08:10", "text": "他の男か、運が良ければ"}, {"type": "subtitle", "time": 4092.95, "timestamp": "01:08:12", "text": "通常、クリティカルヒットのような"}, {"type": "subtitle", "time": 4096.07, "timestamp": "01:08:16", "text": "そんなことは起こらないし、距離的にも"}, {"type": "subtitle", "time": 4097.47, "timestamp": "01:08:17", "text": "10くらい"}, {"type": "subtitle", "time": 4099.91, "timestamp": "01:08:19", "text": "キロメートル。ああ、つまり、文字通り"}, {"type": "subtitle", "time": 4103.189, "timestamp": "01:08:23", "text": "船の前方を狙う、それはスキルだ"}, {"type": "subtitle", "time": 4106.63, "timestamp": "01:08:26", "text": "ゲームの中で成長していく。撃つ"}, {"type": "subtitle", "time": 4112.95, "timestamp": "01:08:32", "text": "そして30秒ほど待つ"}, {"type": "subtitle", "time": 4114.87, "timestamp": "01:08:34", "text": "なぜならその30秒間はあなたのラウンドは"}, {"type": "subtitle", "time": 4116.709, "timestamp": "01:08:36", "text": "空中に飛んでいて、あなたの銃も"}, {"type": "subtitle", "time": 4125.349, "timestamp": "01:08:45", "text": "それも理由の一つです"}, {"type": "subtitle", "time": 4127.829, "timestamp": "01:08:47", "text": "人々は戦争で軍艦をプレイしない"}, {"type": "subtitle", "time": 4130.07, "timestamp": "01:08:50", "text": "雷。しかし、別の理由があります"}, {"type": "subtitle", "time": 4134.229, "timestamp": "01:08:54", "text": "War ThunderのUIははるかに劣っている。"}, {"type": "subtitle", "time": 4136.55, "timestamp": "01:08:56", "text": "War Thunder向け。"}]
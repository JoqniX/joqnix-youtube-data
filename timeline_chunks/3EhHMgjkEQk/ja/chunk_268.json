[{"type": "subtitle", "time": 16080.87, "timestamp": "04:28:00", "text": "このイベントは最も難しいイベントの1つです"}, {"type": "subtitle", "time": 16083.03, "timestamp": "04:28:03", "text": "でやるべきこと"}, {"type": "subtitle", "time": 16088.07, "timestamp": "04:28:08", "text": "3回ほど試してみたけど諦めた"}, {"type": "subtitle", "time": 16090.229, "timestamp": "04:28:10", "text": "３回とも。一度本当に"}, {"type": "subtitle", "time": 16092.389, "timestamp": "04:28:12", "text": "本当に近い"}, {"type": "subtitle", "time": 16095.269, "timestamp": "04:28:15", "text": "私は少しだけ逃しました"}, {"type": "subtitle", "time": 16098.71, "timestamp": "04:28:18", "text": "2時間分のプレイ時間差で逃した。"}, {"type": "subtitle", "time": 16100.389, "timestamp": "04:28:20", "text": "ああ"}, {"type": "subtitle", "time": 16102.469, "timestamp": "04:28:22", "text": "そしてそれらはどちらも私が"}, {"type": "subtitle", "time": 16104.71, "timestamp": "04:28:24", "text": "見逃した飛行機はインドの飛行機のようだった"}, {"type": "subtitle", "time": 16105.91, "timestamp": "04:28:25", "text": "インド空軍の正規機。私は"}, {"type": "subtitle", "time": 16107.269, "timestamp": "04:28:27", "text": "「ああ、欲しいな」みたいな感じ。私は手に入れたい"}, {"type": "subtitle", "time": 16109.67, "timestamp": "04:28:29", "text": "それ。"}, {"type": "subtitle", "time": 16113.03, "timestamp": "04:28:33", "text": "今ではどちらもプレミアム機で、"}, {"type": "subtitle", "time": 16115.269, "timestamp": "04:28:35", "text": "イギリスの技術ツリーにおいて。だからもしあなたが望むなら"}, {"type": "subtitle", "time": 16117.67, "timestamp": "04:28:37", "text": "通常の技術ツリーをレベルアップするために"}, {"type": "subtitle", "time": 16119.27, "timestamp": "04:28:39", "text": "航空、"}, {"type": "subtitle", "time": 16120.63, "timestamp": "04:28:40", "text": "[音楽]"}, {"type": "subtitle", "time": 16123.79, "timestamp": "04:28:43", "text": "イギリス人がやるのが一番いい"}, {"type": "subtitle", "time": 16127.75, "timestamp": "04:28:47", "text": "一つは、インドの潜水艦を与えたからだ。だから"}, {"type": "subtitle", "time": 16130.229, "timestamp": "04:28:50", "text": "例えば、彼らは全世界から始めた"}, {"type": "subtitle", "time": 16133.349, "timestamp": "04:28:53", "text": "第二次世界大戦の国々。だから、US を見るのです。"}, {"type": "subtitle", "time": 16135.83, "timestamp": "04:28:55", "text": "ドイツ、ソ連、イギリス、日本、そして"}, {"type": "subtitle", "time": 16138.63, "timestamp": "04:28:58", "text": "中国、イタリア、フランスが最初だ。 H中国"}]
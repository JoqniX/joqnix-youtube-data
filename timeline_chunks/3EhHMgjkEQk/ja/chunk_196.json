[{"type": "subtitle", "time": 11761.349, "timestamp": "03:16:01", "text": "鍵？そこに鍵が表示されるはずです。"}, {"type": "subtitle", "time": 11769.269, "timestamp": "03:16:09", "text": "コントロールタイプのマウスエイムが見えます"}, {"type": "subtitle", "time": 11772.15, "timestamp": "03:16:12", "text": "現実的に単純化する。いや、待って。"}, {"type": "subtitle", "time": 11774.71, "timestamp": "03:16:14", "text": "何かがおかしい。"}, {"type": "subtitle", "time": 11780.389, "timestamp": "03:16:20", "text": "コントロールモードを切り替えたんですよね？うん。"}, {"type": "subtitle", "time": 11789.99, "timestamp": "03:16:29", "text": "あ、待って。それは間違ったことだ。"}, {"type": "subtitle", "time": 11793.03, "timestamp": "03:16:33", "text": "何？私はたまたま間違ったものを見てしまった。"}, {"type": "subtitle", "time": 11798.71, "timestamp": "03:16:38", "text": "うん。それで、アーケードから"}, {"type": "subtitle", "time": 11802.87, "timestamp": "03:16:42", "text": "飛行機をリアルに操縦する"}, {"type": "subtitle", "time": 11806.63, "timestamp": "03:16:46", "text": "飛行機を操縦して"}, {"type": "subtitle", "time": 11810.309, "timestamp": "03:16:50", "text": "シミュレーターで飛行機を操縦する。"}, {"type": "subtitle", "time": 11813.11, "timestamp": "03:16:53", "text": "ああ、それは全く違う"}, {"type": "subtitle", "time": 11816.07, "timestamp": "03:16:56", "text": "あなたが探しているトグルスイッチです。"}, {"type": "subtitle", "time": 11817.51, "timestamp": "03:16:57", "text": "1秒。名前を探してみます"}, {"type": "subtitle", "time": 11819.03, "timestamp": "03:16:59", "text": "また。あれは何ていう名前なんだ？"}]
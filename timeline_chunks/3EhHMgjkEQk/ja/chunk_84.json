[{"type": "subtitle", "time": 5041.35, "timestamp": "01:24:01", "text": "楽しい。航空機から降りてください。私は撃たれそうになっている。"}, {"type": "subtitle", "time": 5043.35, "timestamp": "01:24:03", "text": "おお、いいね。"}, {"type": "subtitle", "time": 5053.99, "timestamp": "01:24:13", "text": "くそ。射出座席が付いてるよ。わあ、すごい。"}, {"type": "subtitle", "time": 5056.95, "timestamp": "01:24:16", "text": "ちなみに、アフターバーナーも付いてきますよ。もし"}, {"type": "subtitle", "time": 5060.149, "timestamp": "01:24:20", "text": "ズームアウトすると、アフターバーナーが作動しているように見える。"}, {"type": "subtitle", "time": 5063.03, "timestamp": "01:24:23", "text": "アフターバーナー。これはCaps Lockキーですか？"}, {"type": "subtitle", "time": 5065.43, "timestamp": "01:24:25", "text": "あれ？"}, {"type": "subtitle", "time": 5068.07, "timestamp": "01:24:28", "text": "ああ、それは君のミサイルだ。"}, {"type": "subtitle", "time": 5071.03, "timestamp": "01:24:31", "text": "おお。"}, {"type": "subtitle", "time": 5074.31, "timestamp": "01:24:34", "text": "あなたはフレアとジャックルを持っています。 Yを押してください。"}, {"type": "subtitle", "time": 5082.229, "timestamp": "01:24:42", "text": "わかった。わかった。 Yを押してください"}, {"type": "subtitle", "time": 5085.27, "timestamp": "01:24:45", "text": "多重接続。えっと、待って。うん。行かないで"}, {"type": "subtitle", "time": 5089.51, "timestamp": "01:24:49", "text": "メニューに戻ります。メニューをご確認ください"}, {"type": "subtitle", "time": 5092.79, "timestamp": "01:24:52", "text": "あなたのボタンは何ですか？だって、あなたはまだ"}, {"type": "subtitle", "time": 5094.709, "timestamp": "01:24:54", "text": "カスタムキーバインディングは完了しましたよね？あなたが持っている"}, {"type": "subtitle", "time": 5097.99, "timestamp": "01:24:57", "text": "基本的なキーバインドを確認する。えっと、何？"}]
[{"type": "subtitle", "time": 14466.51, "timestamp": "04:01:06", "text": "1つ選んでください"}, {"type": "subtitle", "time": 14468.95, "timestamp": "04:01:08", "text": "このような通りは"}, {"type": "subtitle", "time": 14470.83, "timestamp": "04:01:10", "text": "前面"}, {"type": "subtitle", "time": 14475.429, "timestamp": "04:01:15", "text": "あなたも行って見てください。"}, {"type": "subtitle", "time": 14478.07, "timestamp": "04:01:18", "text": "ああ、あなたは私の手の届かないところへ行ってしまったのね。私は持っている"}, {"type": "subtitle", "time": 14480.389, "timestamp": "04:01:20", "text": "存在する。ああ、私はあなたの手の届かないところにいます。"}, {"type": "subtitle", "time": 14481.59, "timestamp": "04:01:21", "text": "待って、待って、待って、待って。そこにいてください。滞在する"}, {"type": "subtitle", "time": 14483.03, "timestamp": "04:01:23", "text": "そこには。あなたの方へ向かいます。あなたは"}, {"type": "subtitle", "time": 14485.429, "timestamp": "04:01:25", "text": "あの道を見つめて。私は"}, {"type": "subtitle", "time": 14496.71, "timestamp": "04:01:36", "text": "ああ、そうでなければこの調子だと私たちは"}, {"type": "subtitle", "time": 14500.9, "timestamp": "04:01:40", "text": "クラッシュ。いや、そのまままっすぐ進んでください。"}, {"type": "subtitle", "time": 14503.59, "timestamp": "04:01:43", "text": "[音楽]"}, {"type": "chat", "time": 14504.995, "timestamp": "04:01:44", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "imagine flying"}, {"type": "subtitle", "time": 14505.75, "timestamp": "04:01:45", "text": "私が言いたかったのはそういうことです。"}, {"type": "subtitle", "time": 14508.229, "timestamp": "04:01:48", "text": "ああ、尾部制御がクラッシュした。それは"}, {"type": "subtitle", "time": 14512.15, "timestamp": "04:01:52", "text": "わかった。あら、今、何か当たった？うん。おお、"}, {"type": "subtitle", "time": 14514.75, "timestamp": "04:01:54", "text": "くそっ。私のミスです。"}, {"type": "subtitle", "time": 14516.63, "timestamp": "04:01:56", "text": "ニース。"}, {"type": "subtitle", "time": 14518.389, "timestamp": "04:01:58", "text": "別の都市へ行きましょう。実際にヒットしました"}]
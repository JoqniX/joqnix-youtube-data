[{"type": "subtitle", "time": 6240.07, "timestamp": "01:44:00", "text": "さあ、行こう。アレックス。ああ、わかった。待っていてください。"}, {"type": "subtitle", "time": 6241.669, "timestamp": "01:44:01", "text": "飛行隊全員をやらなきゃならない"}, {"type": "subtitle", "time": 6254.79, "timestamp": "01:44:14", "text": "わかった。さあ、あなたの選択です。私たちは何者なのか"}, {"type": "subtitle", "time": 6256.43, "timestamp": "01:44:16", "text": "プレイ中？"}, {"type": "subtitle", "time": 6259.709, "timestamp": "01:44:19", "text": "ジョーク。どのレベル、どのゲームですか？"}, {"type": "subtitle", "time": 6268.109, "timestamp": "01:44:28", "text": "H はどちらが良いですか"}, {"type": "subtitle", "time": 6272.55, "timestamp": "01:44:32", "text": "私か、それとも戦闘か？アーケード、または地上型アーケード。"}, {"type": "subtitle", "time": 6275.51, "timestamp": "01:44:35", "text": "私たちのほうがあなたにとってずっと良い存在になるでしょう。"}, {"type": "subtitle", "time": 6278.95, "timestamp": "01:44:38", "text": "つまり、上のやつですね。うん。つまりあなたは"}, {"type": "subtitle", "time": 6281.75, "timestamp": "01:44:41", "text": "正しい方です。そっちに切り替えます"}, {"type": "subtitle", "time": 6285.43, "timestamp": "01:44:45", "text": "このチームの主は私ですよね？"}, {"type": "subtitle", "time": 6288.79, "timestamp": "01:44:48", "text": "うん。それは私が選んだもの全てに渡る。それで、"}, {"type": "subtitle", "time": 6295.59, "timestamp": "01:44:55", "text": "複数必要です。あなたには一つあります"}, {"type": "subtitle", "time": 6297.27, "timestamp": "01:44:57", "text": "航空機。なぜ1つしかないのですか？"}, {"type": "subtitle", "time": 6298.87, "timestamp": "01:44:58", "text": "航空機？"}]
[{"type": "subtitle", "time": 1501.75, "timestamp": "00:25:01", "text": "お互いのことをよく知っているから、今は安心できる"}, {"type": "subtitle", "time": 1504.31, "timestamp": "00:25:04", "text": "他の人とも以前コラボしたことがあるので簡単です"}, {"type": "subtitle", "time": 1506.149, "timestamp": "00:25:06", "text": "協力する"}, {"type": "subtitle", "time": 1508.789, "timestamp": "00:25:08", "text": "新しい人との出会いは、とても辛い"}, {"type": "subtitle", "time": 1510.51, "timestamp": "00:25:10", "text": "形式的なもの"}, {"type": "subtitle", "time": 1513.35, "timestamp": "00:25:13", "text": "今はたくさんのことがあり、私はある意味"}, {"type": "subtitle", "time": 1515.35, "timestamp": "00:25:15", "text": "私が使った形式ばった表現に苦労しました"}, {"type": "subtitle", "time": 1517.83, "timestamp": "00:25:17", "text": "私が連れて行きたかったこのことをするために"}, {"type": "subtitle", "time": 1521.35, "timestamp": "00:25:21", "text": "人が来ていたけど、私はただ"}, {"type": "subtitle", "time": 1522.789, "timestamp": "00:25:22", "text": "彼女に、一緒に行きたいかどうか聞いてみたいだけ"}, {"type": "subtitle", "time": 1524.549, "timestamp": "00:25:24", "text": "そして人々が来て、私は"}, {"type": "subtitle", "time": 1527.11, "timestamp": "00:25:27", "text": "それ。私は「いいね」を全部やりたくない"}, {"type": "subtitle", "time": 1529.669, "timestamp": "00:25:29", "text": "どうすればたくさんのことができるのか"}, {"type": "subtitle", "time": 1534.549, "timestamp": "00:25:34", "text": "そんな感じで最近気づいたんだけど"}, {"type": "subtitle", "time": 1537.99, "timestamp": "00:25:37", "text": "人によっては、もしあなたが"}, {"type": "subtitle", "time": 1540.47, "timestamp": "00:25:40", "text": "数や物資の面で不足している"}, {"type": "subtitle", "time": 1542.23, "timestamp": "00:25:42", "text": "彼らにとってはちょっと苦痛なことなのかもしれない。"}, {"type": "subtitle", "time": 1544.95, "timestamp": "00:25:44", "text": "ああ、つまり、全体ってこと？"}, {"type": "subtitle", "time": 1547.35, "timestamp": "00:25:47", "text": "君は僕と同じレベルなのか？もっと"}, {"type": "subtitle", "time": 1549.83, "timestamp": "00:25:49", "text": "トランスジェンダーの人たちが言うように、それを"}, {"type": "subtitle", "time": 1551.99, "timestamp": "00:25:51", "text": "トランザクション型コラボレーション。いや、むしろビジネス"}, {"type": "subtitle", "time": 1554.87, "timestamp": "00:25:54", "text": "そういう類のことです。うん。同じこと同じ"}, {"type": "subtitle", "time": 1557.269, "timestamp": "00:25:57", "text": "観客の規模とか、そういう類のことです。"}, {"type": "subtitle", "time": 1559.19, "timestamp": "00:25:59", "text": "うん。うん。うん。わからない。私"}]
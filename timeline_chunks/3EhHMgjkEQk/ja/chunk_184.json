[{"type": "subtitle", "time": 11054.389, "timestamp": "03:04:14", "text": "もっと身長を高くした方がいいと思う。"}, {"type": "subtitle", "time": 11055.91, "timestamp": "03:04:15", "text": "また、正面から入ってくると"}, {"type": "subtitle", "time": 11058.23, "timestamp": "03:04:18", "text": "船。その裏側を探る必要があります。これ"}, {"type": "subtitle", "time": 11061.349, "timestamp": "03:04:21", "text": "遅れていない。いいえ、中に入ってください"}, {"type": "subtitle", "time": 11063.99, "timestamp": "03:04:23", "text": "大地から。"}, {"type": "subtitle", "time": 11065.75, "timestamp": "03:04:25", "text": "ええと、私が見る限り、船は"}, {"type": "subtitle", "time": 11066.91, "timestamp": "03:04:26", "text": "指差して"}, {"type": "subtitle", "time": 11069.99, "timestamp": "03:04:29", "text": "あなた。船がどこにあるのか確認してください"}, {"type": "subtitle", "time": 11071.269, "timestamp": "03:04:31", "text": "行くの？陸地に向かっているのか、それとも"}, {"type": "subtitle", "time": 11073.83, "timestamp": "03:04:33", "text": "それはあなたの方に向かってきていますか？"}, {"type": "subtitle", "time": 11075.269, "timestamp": "03:04:35", "text": "方向が表示されません"}, {"type": "subtitle", "time": 11076.79, "timestamp": "03:04:36", "text": "地図。"}, {"type": "subtitle", "time": 11085.03, "timestamp": "03:04:45", "text": "では、"}, {"type": "subtitle", "time": 11087.91, "timestamp": "03:04:47", "text": "塔が左側にある場合、"}, {"type": "subtitle", "time": 11091.19, "timestamp": "03:04:51", "text": "船があなたに向かってきていました。見る？"}, {"type": "subtitle", "time": 11093.269, "timestamp": "03:04:53", "text": "おお。船の塔が"}, {"type": "subtitle", "time": 11097.269, "timestamp": "03:04:57", "text": "その左側から、こちらに向かってきています。"}]
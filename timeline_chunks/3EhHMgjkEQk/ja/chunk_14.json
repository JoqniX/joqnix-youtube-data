[{"type": "subtitle", "time": 863.23, "timestamp": "00:14:23", "text": "そして、私はやり直さなければならなかった。再起動をクリックしてください"}, {"type": "subtitle", "time": 865.55, "timestamp": "00:14:25", "text": "ゆっくり。来て。来て。来て。来る"}, {"type": "subtitle", "time": 868.03, "timestamp": "00:14:28", "text": "の上。何てことだ。の"}, {"type": "subtitle", "time": 870.31, "timestamp": "00:14:30", "text": "マウスだよ、兄弟。ネズミがいなくなりました。わかった、"}, {"type": "subtitle", "time": 871.55, "timestamp": "00:14:31", "text": "待って。手に入れた"}, {"type": "subtitle", "time": 883.389, "timestamp": "00:14:43", "text": "はい、私たちは"}, {"type": "subtitle", "time": 885.389, "timestamp": "00:14:45", "text": "開始"}, {"type": "subtitle", "time": 886.91, "timestamp": "00:14:46", "text": "私"}, {"type": "subtitle", "time": 891.55, "timestamp": "00:14:51", "text": "考える。わかった。えっと、あなたにできるようにしてください"}]
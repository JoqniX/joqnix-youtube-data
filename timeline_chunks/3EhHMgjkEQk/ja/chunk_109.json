[{"type": "subtitle", "time": 6542.229, "timestamp": "01:49:02", "text": "はい。はい。はい。はい。はい。さあ、優しく"}, {"type": "subtitle", "time": 6544.47, "timestamp": "01:49:04", "text": "行くよ。何もないところがないように気をつけてください"}, {"type": "subtitle", "time": 6545.87, "timestamp": "01:49:05", "text": "の前に"}, {"type": "subtitle", "time": 6552.59, "timestamp": "01:49:12", "text": "行く。うん、"}, {"type": "subtitle", "time": 6555.35, "timestamp": "01:49:15", "text": "男の子。冗談は最初の緊急着陸だ。"}, {"type": "subtitle", "time": 6559.51, "timestamp": "01:49:19", "text": "さあ行こう。何てことだ。"}, {"type": "subtitle", "time": 6563.59, "timestamp": "01:49:23", "text": "やったね。あなたは空軍基地にいます。"}, {"type": "subtitle", "time": 6566.31, "timestamp": "01:49:26", "text": "ニース。"}, {"type": "subtitle", "time": 6568.55, "timestamp": "01:49:28", "text": "さあ、完全に壊れて待つ"}, {"type": "subtitle", "time": 6570.55, "timestamp": "01:49:30", "text": "それに対して。タイマーが表示されます"}, {"type": "subtitle", "time": 6582.39, "timestamp": "01:49:42", "text": "くそ。今、私を撃ったの？私が想像してみてください"}, {"type": "subtitle", "time": 6583.91, "timestamp": "01:49:43", "text": "亡くなった。"}, {"type": "subtitle", "time": 6585.51, "timestamp": "01:49:45", "text": "私はあなたを撃とうとしていたのです。結局"}, {"type": "subtitle", "time": 6587.99, "timestamp": "01:49:47", "text": "あなたより下の存在。何てことだ。つまり、私は"}, {"type": "subtitle", "time": 6591.229, "timestamp": "01:49:51", "text": "できる。待って、やってみて。しないでください"}]
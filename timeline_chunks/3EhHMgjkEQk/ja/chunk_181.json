[{"type": "subtitle", "time": 10861.429, "timestamp": "03:01:01", "text": "右へ進む。"}, {"type": "subtitle", "time": 10863.51, "timestamp": "03:01:03", "text": "なんてこった。エアブレーキは"}, {"type": "subtitle", "time": 10871.67, "timestamp": "03:01:11", "text": "タイヤ。わかった。さて、どうにかして"}, {"type": "subtitle", "time": 10874.19, "timestamp": "03:01:14", "text": "飛行機を旋回させる"}, {"type": "subtitle", "time": 10878.309, "timestamp": "03:01:18", "text": "十分だ、待って、あれを見て。見て"}, {"type": "subtitle", "time": 10880.71, "timestamp": "03:01:20", "text": "灰色の2つの灰色が見えます"}, {"type": "subtitle", "time": 10884.55, "timestamp": "03:01:24", "text": "線？うん。"}, {"type": "subtitle", "time": 10886.59, "timestamp": "03:01:26", "text": "先頭では、あなたが"}, {"type": "subtitle", "time": 10889.67, "timestamp": "03:01:29", "text": "の上。前方右手。いいえ、いいえ、"}, {"type": "subtitle", "time": 10892.95, "timestamp": "03:01:32", "text": "あなたの目の前に。あなたの目の前に。"}, {"type": "subtitle", "time": 10896.309, "timestamp": "03:01:36", "text": "この金属製の製品のように、2本の灰色の線。"}, {"type": "subtitle", "time": 10900.23, "timestamp": "03:01:40", "text": "はい、ただし船首の方です。"}, {"type": "subtitle", "time": 10903.59, "timestamp": "03:01:43", "text": "船の。はい。飛行機を旋回させてみてください"}, {"type": "subtitle", "time": 10906.07, "timestamp": "03:01:46", "text": "ゆっくりと慎重に使用し、"}, {"type": "chat", "time": 10913.277, "timestamp": "03:01:53", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "👋🏻"}]
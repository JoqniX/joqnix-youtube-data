[{"type": "subtitle", "time": 2460.27, "timestamp": "00:41:00", "text": "1つ。ああ、ただ"}, {"type": "subtitle", "time": 2464.39, "timestamp": "00:41:04", "text": "それを受け入れるしかない。よし、これでいい。"}, {"type": "subtitle", "time": 2467.75, "timestamp": "00:41:07", "text": "承諾しました。"}, {"type": "subtitle", "time": 2476.55, "timestamp": "00:41:16", "text": "基本的な飛行方法を知りたいですか"}, {"type": "subtitle", "time": 2479.91, "timestamp": "00:41:19", "text": "これですか？右。はい。"}, {"type": "subtitle", "time": 2482.75, "timestamp": "00:41:22", "text": "ベースレベルを探しに行かなければならない"}, {"type": "subtitle", "time": 2485.27, "timestamp": "00:41:25", "text": "航空機。私の国はすべて"}, {"type": "subtitle", "time": 2489.51, "timestamp": "00:41:29", "text": "少なくとも少しは好き。"}, {"type": "subtitle", "time": 2491.19, "timestamp": "00:41:31", "text": "しかし、そこが問題なのです。私はこれらが理解できません"}, {"type": "subtitle", "time": 2493.43, "timestamp": "00:41:33", "text": "ゲームの種類。いいえ。このゲームと"}, {"type": "subtitle", "time": 2496.39, "timestamp": "00:41:36", "text": "入隊した。すべてをレベルアップする必要があります"}, {"type": "subtitle", "time": 2498.43, "timestamp": "00:41:38", "text": "他の国々"}, {"type": "subtitle", "time": 2501.51, "timestamp": "00:41:41", "text": "あまりにも。あれは本当に単調なゲームだ。それ"}, {"type": "subtitle", "time": 2504.15, "timestamp": "00:41:44", "text": "場合によります。 1つ選ぶことができます"}, {"type": "subtitle", "time": 2506.069, "timestamp": "00:41:46", "text": "好きな国に行って、"}, {"type": "subtitle", "time": 2512.87, "timestamp": "00:41:52", "text": "私はこれを選びました。"}, {"type": "subtitle", "time": 2515.03, "timestamp": "00:41:55", "text": "あ、すみません。うん。うん。どうぞ。行く"}, {"type": "subtitle", "time": 2517.99, "timestamp": "00:41:57", "text": "先に。いいえ。だから、"}, {"type": "subtitle", "time": 2519.71, "timestamp": "00:41:59", "text": "特に"}]
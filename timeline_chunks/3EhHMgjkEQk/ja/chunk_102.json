[{"type": "subtitle", "time": 6124.149, "timestamp": "01:42:04", "text": "よし、すごくすごく高いところまで登ってみるよ"}, {"type": "subtitle", "time": 6127.91, "timestamp": "01:42:07", "text": "そして飛行機を見てください。理由は"}, {"type": "subtitle", "time": 6130.709, "timestamp": "01:42:10", "text": "イスラエルはジェット機に非常に早く移行する"}, {"type": "subtitle", "time": 6133.03, "timestamp": "01:42:13", "text": "イスラエルの技術ツリーは、"}, {"type": "subtitle", "time": 6135.35, "timestamp": "01:42:15", "text": "イスラエル空軍は第二次世界大戦後に創設された"}, {"type": "subtitle", "time": 6137.51, "timestamp": "01:42:17", "text": "II."}, {"type": "subtitle", "time": 6141.03, "timestamp": "01:42:21", "text": "ああ、つまり彼らは2つか3つのワールドを持っているということか"}, {"type": "subtitle", "time": 6143.109, "timestamp": "01:42:23", "text": "第二次世界大戦の飛行機、そして彼らは"}, {"type": "subtitle", "time": 6145.189, "timestamp": "01:42:25", "text": "ジェット機を非常に迅速に入手する。それは"}, {"type": "subtitle", "time": 6147.59, "timestamp": "01:42:27", "text": "樹木限界線はその後に始まる。方法をご覧ください"}, {"type": "subtitle", "time": 6152.02, "timestamp": "01:42:32", "text": "最初の飛行機は4.3と3.3と5.0です。"}, {"type": "subtitle", "time": 6153.83, "timestamp": "01:42:33", "text": "[音楽]"}, {"type": "subtitle", "time": 6155.75, "timestamp": "01:42:35", "text": "他の技術系企業にはそういうところはない。"}, {"type": "subtitle", "time": 6157.99, "timestamp": "01:42:37", "text": "もう一方の技術ツリーは予備から始まる"}, {"type": "subtitle", "time": 6160.31, "timestamp": "01:42:40", "text": "そして1、2、3、4"}, {"type": "subtitle", "time": 6168.109, "timestamp": "01:42:48", "text": "つまり、あなたは多くのことを飛ばしているということです"}, {"type": "subtitle", "time": 6171.189, "timestamp": "01:42:51", "text": "イスラエルの技術ツリーの最下位に位置する。それは"}, {"type": "subtitle", "time": 6172.709, "timestamp": "01:42:52", "text": "お気に入りの技術ツリーの1つ"}, {"type": "subtitle", "time": 6175.229, "timestamp": "01:42:55", "text": "すぐに"}]
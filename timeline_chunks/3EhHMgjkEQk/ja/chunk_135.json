[{"type": "subtitle", "time": 8102.229, "timestamp": "02:15:02", "text": "そして緑色の「えーと」が表示されるまで待ちます。良い、"}, {"type": "subtitle", "time": 8104.229, "timestamp": "02:15:04", "text": "待っていてはいけない。それを指さしてください"}, {"type": "subtitle", "time": 8105.91, "timestamp": "02:15:05", "text": "その通りです。動かし続けてください"}, {"type": "subtitle", "time": 8108.43, "timestamp": "02:15:08", "text": "クロスヘアを移動させる"}, {"type": "subtitle", "time": 8111.189, "timestamp": "02:15:11", "text": "緑。一度緑色に点灯すれば、"}, {"type": "subtitle", "time": 8113.669, "timestamp": "02:15:13", "text": "つまり、あなたのゲームはあなたの"}, {"type": "subtitle", "time": 8118.03, "timestamp": "02:15:18", "text": "弾丸は戦車の装甲を貫通するだろう。"}, {"type": "subtitle", "time": 8126.55, "timestamp": "02:15:26", "text": "素晴らしい。さて、見てみましょう。あなたは何者ですか"}, {"type": "subtitle", "time": 8136.47, "timestamp": "02:15:36", "text": "ああ、標的破壊。私は彼女を殺した。"}, {"type": "subtitle", "time": 8139.27, "timestamp": "02:15:39", "text": "さあ行こう。あなたは人を殺した。"}, {"type": "subtitle", "time": 8141.31, "timestamp": "02:15:41", "text": "素晴らしい。また"}, {"type": "subtitle", "time": 8144.47, "timestamp": "02:15:44", "text": "ジョーク。水槽は必ず斜めに設置してください。持っていません"}, {"type": "subtitle", "time": 8147.91, "timestamp": "02:15:47", "text": "真正面からでも、横からでも構わない。おお"}, {"type": "subtitle", "time": 8149.27, "timestamp": "02:15:49", "text": "神。あなたは自分自身を簡単に"}]
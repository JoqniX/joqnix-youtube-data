[{"type": "subtitle", "time": 7800.11, "timestamp": "02:10:00", "text": "わかった。"}, {"type": "subtitle", "time": 7802.55, "timestamp": "02:10:02", "text": "[音楽]"}, {"type": "subtitle", "time": 7805.27, "timestamp": "02:10:05", "text": "１、２。ああ、わかりました。わかった。わかった。あなたが持っている"}, {"type": "subtitle", "time": 7807.109, "timestamp": "02:10:07", "text": "そのためには少しだけ演奏する必要がある。あなたはできる"}, {"type": "subtitle", "time": 7809.03, "timestamp": "02:10:09", "text": "もっと欲しいなら別の国へ行きなさい"}, {"type": "subtitle", "time": 7811.75, "timestamp": "02:10:11", "text": "戦車。"}, {"type": "subtitle", "time": 7813.03, "timestamp": "02:10:13", "text": "大丈夫です。他の"}, {"type": "subtitle", "time": 7816.629, "timestamp": "02:10:16", "text": "国には、アメリカだと思うんだけど、"}, {"type": "subtitle", "time": 7818.98, "timestamp": "02:10:18", "text": "最初は３人。"}, {"type": "subtitle", "time": 7829.03, "timestamp": "02:10:29", "text": "この加速はプレミアムのようなものだ"}, {"type": "subtitle", "time": 7843.109, "timestamp": "02:10:43", "text": "うん。私たちは間違いを犯している。"}, {"type": "subtitle", "time": 7846.069, "timestamp": "02:10:46", "text": "さて、地上戦では、焦らないで"}, {"type": "subtitle", "time": 7848.229, "timestamp": "02:10:48", "text": "フォワード。急ぐのはとても楽しい"}, {"type": "subtitle", "time": 7849.91, "timestamp": "02:10:49", "text": "前進するが、撃たれるだろう"}, {"type": "subtitle", "time": 7852.629, "timestamp": "02:10:52", "text": "何でも。"}, {"type": "subtitle", "time": 7854.47, "timestamp": "02:10:54", "text": "どこでもいいから撃つことはできない"}, {"type": "subtitle", "time": 7857.03, "timestamp": "02:10:57", "text": "タンクはとてもまだかなり"}, {"type": "subtitle", "time": 7858.95, "timestamp": "02:10:58", "text": "弾丸がどこに飛んでくるかという点で現実的"}]
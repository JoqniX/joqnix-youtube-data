[{"type": "subtitle", "time": 9060.63, "timestamp": "02:31:00", "text": "くそっ。そっちの方がずっと楽しいよ。"}, {"type": "subtitle", "time": 9062.23, "timestamp": "02:31:02", "text": "アーケードは、新しい人にとって、"}, {"type": "subtitle", "time": 9063.67, "timestamp": "02:31:03", "text": "プレイヤーが参加できるようにする。そして一般的に、"}, {"type": "subtitle", "time": 9066.63, "timestamp": "02:31:06", "text": "子供向けです。"}, {"type": "subtitle", "time": 9067.83, "timestamp": "02:31:07", "text": "そして、あなたは"}, {"type": "subtitle", "time": 9073.83, "timestamp": "02:31:13", "text": "現実的。そして理解したとき"}, {"type": "subtitle", "time": 9076.309, "timestamp": "02:31:16", "text": "現実的な仕組みがまだ機能する場合"}, {"type": "subtitle", "time": 9078.63, "timestamp": "02:31:18", "text": "自分の人生を嫌うなら、"}, {"type": "subtitle", "time": 9084.23, "timestamp": "02:31:24", "text": "もしあなたがミームのような人なら、私は"}, {"type": "subtitle", "time": 9089.03, "timestamp": "02:31:29", "text": "平和を望む。私は戦争を望む。何だって？"}, {"type": "subtitle", "time": 9091.27, "timestamp": "02:31:31", "text": "どうですか？"}, {"type": "subtitle", "time": 9093.51, "timestamp": "02:31:33", "text": "本当に苦しみたいなら、そう、"}, {"type": "subtitle", "time": 9096.55, "timestamp": "02:31:36", "text": "シミュレーターモードに進み、"}, {"type": "subtitle", "time": 9098.79, "timestamp": "02:31:38", "text": "今日は受け入れません、なぜなら"}, {"type": "subtitle", "time": 9101.51, "timestamp": "02:31:41", "text": "あなたにとってひどいことになるでしょう。"}, {"type": "subtitle", "time": 9105.03, "timestamp": "02:31:45", "text": "わかった。もし"}, {"type": "subtitle", "time": 9107.19, "timestamp": "02:31:47", "text": "離陸に成功すれば、"}, {"type": "subtitle", "time": 9109.429, "timestamp": "02:31:49", "text": "それ。"}, {"type": "subtitle", "time": 9111.03, "timestamp": "02:31:51", "text": "私は服を脱ぐことさえできなかった"}, {"type": "subtitle", "time": 9112.71, "timestamp": "02:31:52", "text": "最初の2回、シミュレーターで3回"}, {"type": "subtitle", "time": 9114.63, "timestamp": "02:31:54", "text": "モード。"}, {"type": "subtitle", "time": 9118.63, "timestamp": "02:31:58", "text": "くそ。ああ、戦闘バスがある。"}]
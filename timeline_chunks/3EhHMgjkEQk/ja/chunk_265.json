[{"type": "subtitle", "time": 15901.75, "timestamp": "04:25:01", "text": "雷鳴のように、"}, {"type": "subtitle", "time": 15904.71, "timestamp": "04:25:04", "text": "私が知る限り、ジェット機を手に入れた最速の人物"}, {"type": "subtitle", "time": 15906.79, "timestamp": "04:25:06", "text": "で。"}, {"type": "subtitle", "time": 15911.03, "timestamp": "04:25:11", "text": "ジャズマを倒せば、誰もが君に勝つだろう。"}, {"type": "subtitle", "time": 15914.07, "timestamp": "04:25:14", "text": "わかった。ジャシマに勝つだろうが、"}, {"type": "subtitle", "time": 15915.83, "timestamp": "04:25:15", "text": "あの男がどれだけ"}, {"type": "subtitle", "time": 15918.149, "timestamp": "04:25:18", "text": "1年以上ゲームをプレイしています"}, {"type": "subtitle", "time": 15920.87, "timestamp": "04:25:20", "text": "または2年。くそ。簡単に。彼は"}, {"type": "subtitle", "time": 15922.469, "timestamp": "04:25:22", "text": "もう数年このゲームをプレイしています。"}, {"type": "subtitle", "time": 15924.229, "timestamp": "04:25:24", "text": "彼がこれまでやってきたゲームのやり方は"}, {"type": "subtitle", "time": 15926.55, "timestamp": "04:25:26", "text": "私が彼を困らせるたびに、つまり私は"}, {"type": "subtitle", "time": 15928.309, "timestamp": "04:25:28", "text": "優しく丁寧に彼に演奏を頼む"}, {"type": "subtitle", "time": 15932.79, "timestamp": "04:25:32", "text": "ゲームの後、彼は説得されるだろう"}, {"type": "subtitle", "time": 15934.79, "timestamp": "04:25:34", "text": "1週間くらいでダウンロードしてプレイするよ"}, {"type": "subtitle", "time": 15935.79, "timestamp": "04:25:35", "text": "それは一つ"}, {"type": "subtitle", "time": 15938.309, "timestamp": "04:25:38", "text": "一日経ったら彼はそれを削除するだろう"}, {"type": "subtitle", "time": 15939.99, "timestamp": "04:25:39", "text": "次の6ヶ月間も。彼はそういう人なんだ"}, {"type": "subtitle", "time": 15946.229, "timestamp": "04:25:46", "text": "プレイし始めて、少し"}, {"type": "subtitle", "time": 15948.309, "timestamp": "04:25:48", "text": "鈍いし、錆びついている、だって私はただ"}, {"type": "subtitle", "time": 15951.349, "timestamp": "04:25:51", "text": "Forzaにハマり始めた"}, {"type": "subtitle", "time": 15954.229, "timestamp": "04:25:54", "text": "でも、私は多かれ少なかれそれをやってきました"}]
[{"type": "subtitle", "time": 7860.629, "timestamp": "02:11:00", "text": "どこまで行くか、どこまで行かないか"}, {"type": "subtitle", "time": 7863.75, "timestamp": "02:11:03", "text": "を通して。あなたの貝殻、"}, {"type": "subtitle", "time": 7865.91, "timestamp": "02:11:05", "text": "敵戦車の正面は常に"}, {"type": "subtitle", "time": 7872.47, "timestamp": "02:11:12", "text": "貝殻にはさまざまな種類があります"}, {"type": "subtitle", "time": 7877.99, "timestamp": "02:11:17", "text": "あなたの車の中に。だから遊ぶことができます"}, {"type": "subtitle", "time": 7880.31, "timestamp": "02:11:20", "text": "クリックする前に、それも確認しておいてください。"}, {"type": "subtitle", "time": 7894.95, "timestamp": "02:11:34", "text": "欲しいとすると、通常はスペースバーが表示されます"}, {"type": "subtitle", "time": 7901.75, "timestamp": "02:11:41", "text": "あなたの大砲。確認すべきだった"}, {"type": "subtitle", "time": 7904.149, "timestamp": "02:11:44", "text": "お互いのスポーン地点。私はちょっと"}, {"type": "subtitle", "time": 7905.79, "timestamp": "02:11:45", "text": "忘れていた"}, {"type": "subtitle", "time": 7908.069, "timestamp": "02:11:48", "text": "それ。後ろから入ります。私"}, {"type": "subtitle", "time": 7917.589, "timestamp": "02:11:57", "text": "さて、理想的なのは岩を見つけることです"}]
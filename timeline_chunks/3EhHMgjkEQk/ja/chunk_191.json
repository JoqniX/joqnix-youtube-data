[{"type": "subtitle", "time": 11460.469, "timestamp": "03:11:00", "text": "十分注意してください。すぐに"}, {"type": "subtitle", "time": 11463.03, "timestamp": "03:11:03", "text": "指摘しないと、ただ投げ出すだけです"}, {"type": "subtitle", "time": 11465.51, "timestamp": "03:11:05", "text": "約200kmで水に飛び込むと"}, {"type": "subtitle", "time": 11473.83, "timestamp": "03:11:13", "text": "ああ、ゼロから350～400kmくらいまで行くんだ"}, {"type": "subtitle", "time": 11490.309, "timestamp": "03:11:30", "text": "以前は、"}, {"type": "subtitle", "time": 11493.59, "timestamp": "03:11:33", "text": "蒸気圧を利用していた。"}, {"type": "subtitle", "time": 11496.15, "timestamp": "03:11:36", "text": "今はSF系の作品を手がけている。彼らは"}, {"type": "subtitle", "time": 11499.349, "timestamp": "03:11:39", "text": "電磁レールガンを使用する。それで、"}, {"type": "subtitle", "time": 11501.11, "timestamp": "03:11:41", "text": "飛行機は基本的に撃ち落とされる"}, {"type": "subtitle", "time": 11508.07, "timestamp": "03:11:48", "text": "また、"}, {"type": "subtitle", "time": 11510.309, "timestamp": "03:11:50", "text": "あなたはなぜ"}, {"type": "subtitle", "time": 11515.309, "timestamp": "03:11:55", "text": "銃は発射することができる。ええと、アライメント"}, {"type": "subtitle", "time": 11516.83, "timestamp": "03:11:56", "text": "おそらく"}]
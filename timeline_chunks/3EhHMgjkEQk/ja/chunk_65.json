[{"type": "subtitle", "time": 3902.87, "timestamp": "01:05:02", "text": "起こった。実は、完璧な出来だったんです。"}, {"type": "subtitle", "time": 3904.95, "timestamp": "01:05:04", "text": "さあ行こう。"}, {"type": "subtitle", "time": 3907.19, "timestamp": "01:05:07", "text": "これの何"}, {"type": "subtitle", "time": 3909.75, "timestamp": "01:05:09", "text": "着陸。そして、こうしてあなたは"}, {"type": "subtitle", "time": 3912.47, "timestamp": "01:05:12", "text": "飛行機。離陸は一般的にずっと"}, {"type": "subtitle", "time": 3914.789, "timestamp": "01:05:14", "text": "より簡単"}, {"type": "subtitle", "time": 3918.069, "timestamp": "01:05:18", "text": "一般的に着陸は"}, {"type": "subtitle", "time": 3920.789, "timestamp": "01:05:20", "text": "災害。つまり、あなたが提起する問題は"}, {"type": "subtitle", "time": 3923.43, "timestamp": "01:05:23", "text": "飛行中に顔が"}, {"type": "subtitle", "time": 3926.309, "timestamp": "01:05:26", "text": "良い点は、あなたが持っていることに気づかないことです"}, {"type": "subtitle", "time": 3928.39, "timestamp": "01:05:28", "text": "鼻を少し上げるとき"}, {"type": "subtitle", "time": 3931.27, "timestamp": "01:05:31", "text": "壊れて、そのまま倒れる"}, {"type": "subtitle", "time": 3934.069, "timestamp": "01:05:34", "text": "あなたの"}, {"type": "subtitle", "time": 3937.15, "timestamp": "01:05:37", "text": "それは大抵こういう風に起こります。ああ、私は"}, {"type": "subtitle", "time": 3940.47, "timestamp": "01:05:40", "text": "知る。ああ、神様、あなたは死んでしまった。"}, {"type": "subtitle", "time": 3942.71, "timestamp": "01:05:42", "text": "そのためには、注意が必要です。"}, {"type": "subtitle", "time": 3945.829, "timestamp": "01:05:45", "text": "私はそういうことはあまりしない。うん。今私が"}, {"type": "subtitle", "time": 3949.27, "timestamp": "01:05:49", "text": "戻ってきて、私たちは飛び立ち、私たちは"}, {"type": "subtitle", "time": 3951.27, "timestamp": "01:05:51", "text": "互いにまっすぐ向かっていく。良い"}, {"type": "subtitle", "time": 3953.75, "timestamp": "01:05:53", "text": "一度交差してから"}, {"type": "subtitle", "time": 3956.47, "timestamp": "01:05:56", "text": "私たちは喧嘩になるだろう。わかった。わーい。さあ"}, {"type": "subtitle", "time": 3958.15, "timestamp": "01:05:58", "text": "行く。"}]
[{"type": "subtitle", "time": 3002.95, "timestamp": "00:50:02", "text": "はい。わかった。いいえ、あなたのサファリを見てください。方法"}, {"type": "subtitle", "time": 3005.99, "timestamp": "00:50:05", "text": "羽をくねくねさせて。羽をくねくねさせて"}, {"type": "subtitle", "time": 3007.23, "timestamp": "00:50:07", "text": "のように"}, {"type": "subtitle", "time": 3023.19, "timestamp": "00:50:23", "text": "admって何ですか？それは何ですか？まるで"}, {"type": "subtitle", "time": 3025.27, "timestamp": "00:50:25", "text": "エンジン。"}, {"type": "subtitle", "time": 3027.589, "timestamp": "00:50:27", "text": "ええ、エンジンです。あなたは何者ですか"}, {"type": "subtitle", "time": 3029.75, "timestamp": "00:50:29", "text": "驚いているのは何？"}, {"type": "subtitle", "time": 3031.51, "timestamp": "00:50:31", "text": "飛行機です。エンジンを搭載している。の"}, {"type": "subtitle", "time": 3034.47, "timestamp": "00:50:34", "text": "エンジンは音を立てる。つまり、どういうこと？いいえ、"}, {"type": "subtitle", "time": 3037.349, "timestamp": "00:50:37", "text": "蒸気機関のように高出力"}, {"type": "subtitle", "time": 3040.15, "timestamp": "00:50:40", "text": "まるでジェット機のようなエンジン。つまり、"}, {"type": "subtitle", "time": 3044.63, "timestamp": "00:50:44", "text": "これらは、とても、ほら、初心者向けです"}, {"type": "subtitle", "time": 3047.27, "timestamp": "00:50:47", "text": "飛行機。実際のところ"}, {"type": "subtitle", "time": 3049.589, "timestamp": "00:50:49", "text": "航空機は、すべて"}, {"type": "subtitle", "time": 3055.91, "timestamp": "00:50:55", "text": "わかりました。かなり順調に進んでいます"}, {"type": "subtitle", "time": 3059.03, "timestamp": "00:50:59", "text": "マウスを使うだけです。"}]
[{"type": "subtitle", "time": 6061.35, "timestamp": "01:41:01", "text": "アカウントは失わなかったんですね？おお、"}, {"type": "subtitle", "time": 6068.229, "timestamp": "01:41:08", "text": "アカウントを失ってしまいました。私はしない"}, {"type": "subtitle", "time": 6076.07, "timestamp": "01:41:16", "text": "わかった。くそ。待って、私は"}, {"type": "subtitle", "time": 6077.75, "timestamp": "01:41:17", "text": "マッチ。うん。うん。ああ、待って、待って、待って、"}, {"type": "subtitle", "time": 6079.189, "timestamp": "01:41:19", "text": "待って。誤って何かをクリックしてしまいました。"}, {"type": "subtitle", "time": 6081.35, "timestamp": "01:41:21", "text": "ああ、しまった。どうやって消せるか、でももし"}, {"type": "subtitle", "time": 6082.629, "timestamp": "01:41:22", "text": "君はもう試合に出てるから、僕は歩けるよ"}, {"type": "subtitle", "time": 6084.47, "timestamp": "01:41:24", "text": "あなたを通して。大丈夫。私はそれを見ることができます"}, {"type": "subtitle", "time": 6087.75, "timestamp": "01:41:27", "text": "リアルタイム。いや、いや、いや、いや、いや。"}, {"type": "subtitle", "time": 6090.07, "timestamp": "01:41:30", "text": "そうすると、日本をプレイできなくなります。"}, {"type": "subtitle", "time": 6091.83, "timestamp": "01:41:31", "text": "何？"}, {"type": "subtitle", "time": 6093.99, "timestamp": "01:41:33", "text": "そう、まるで君が"}, {"type": "subtitle", "time": 6097.59, "timestamp": "01:41:37", "text": "何かをする前に、まずは試合をするんだ。"}, {"type": "subtitle", "time": 6099.99, "timestamp": "01:41:39", "text": "これらの3機の飛行機をプレイできますが、"}, {"type": "subtitle", "time": 6101.59, "timestamp": "01:41:41", "text": "他の2機の飛行機は締め出されてしまう"}, {"type": "subtitle", "time": 6103.59, "timestamp": "01:41:43", "text": "5分くらい。"}, {"type": "subtitle", "time": 6106.31, "timestamp": "01:41:46", "text": "これは非常に効果的なシステムです。"}, {"type": "subtitle", "time": 6108.39, "timestamp": "01:41:48", "text": "詳細なシステム。"}, {"type": "subtitle", "time": 6114.149, "timestamp": "01:41:54", "text": "イスラエルは本当にクールな"}, {"type": "subtitle", "time": 6116.87, "timestamp": "01:41:56", "text": "飛行機？えっと、リサーチをクリックすると、"}]
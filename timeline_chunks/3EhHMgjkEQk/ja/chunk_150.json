[{"type": "subtitle", "time": 9000.87, "timestamp": "02:30:00", "text": "素晴らしい。"}, {"type": "subtitle", "time": 9002.87, "timestamp": "02:30:02", "text": "ニース。"}, {"type": "subtitle", "time": 9006.469, "timestamp": "02:30:06", "text": "よくやった。あなたは死んでいません。"}, {"type": "subtitle", "time": 9012.469, "timestamp": "02:30:12", "text": "また、何らかの"}, {"type": "subtitle", "time": 9014.469, "timestamp": "02:30:14", "text": "アシストの。それは素晴らしいことです。理由により休業"}, {"type": "subtitle", "time": 9018.71, "timestamp": "02:30:18", "text": "重度の筋損傷。何？"}, {"type": "subtitle", "time": 9020.55, "timestamp": "02:30:20", "text": "え、何？"}, {"type": "subtitle", "time": 9023.59, "timestamp": "02:30:23", "text": "書き終えた。え、ゲームは終わったの？"}, {"type": "subtitle", "time": 9027.469, "timestamp": "02:30:27", "text": "うん。ええ、試合は終わりました。私たちは勝った。おお、"}, {"type": "subtitle", "time": 9031.07, "timestamp": "02:30:31", "text": "ニース。くそ"}, {"type": "subtitle", "time": 9034.309, "timestamp": "02:30:34", "text": "多くの。ユニットへの調査。私は手に入れた"}, {"type": "chat", "time": 9034.553, "timestamp": "02:30:34", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "yippe we won"}, {"type": "subtitle", "time": 9038.389, "timestamp": "02:30:38", "text": "ついにコンプレッサーが登場。調子はどうですか？"}, {"type": "subtitle", "time": 9039.99, "timestamp": "02:30:39", "text": "ニース。"}, {"type": "subtitle", "time": 9049.15, "timestamp": "02:30:49", "text": "うん。購入方法わかった。"}, {"type": "subtitle", "time": 9056.91, "timestamp": "02:30:56", "text": "エンジン。現実的というのは、つまり、"}]
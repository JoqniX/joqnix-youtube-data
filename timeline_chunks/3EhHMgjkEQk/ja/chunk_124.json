[{"type": "subtitle", "time": 7441.07, "timestamp": "02:04:01", "text": "楽しむ人"}, {"type": "subtitle", "time": 7444.629, "timestamp": "02:04:04", "text": "サンダーの試合の？"}, {"type": "subtitle", "time": 7447.99, "timestamp": "02:04:07", "text": "シューシューという音のする雷のゲーム"}, {"type": "subtitle", "time": 7451.91, "timestamp": "02:04:11", "text": "飛行機とピューピュー戦車と、えーとみんな"}, {"type": "subtitle", "time": 7455.35, "timestamp": "02:04:15", "text": "船のことを忘れてしまう。でも、大丈夫だよ。"}, {"type": "subtitle", "time": 7457.669, "timestamp": "02:04:17", "text": "でもそうだよ、ジョー、軍隊に転属しなよ。お見せします"}, {"type": "subtitle", "time": 7459.35, "timestamp": "02:04:19", "text": "あなた"}, {"type": "subtitle", "time": 7467.35, "timestamp": "02:04:27", "text": "うん、キャンセルして。ああ、わかった。それでは、"}, {"type": "subtitle", "time": 7470.47, "timestamp": "02:04:30", "text": "その物。戦車のアイコンをクリックしてください。"}, {"type": "subtitle", "time": 7475.91, "timestamp": "02:04:35", "text": "カスタマイズ。装飾品。クリックしてください"}, {"type": "subtitle", "time": 7478.95, "timestamp": "02:04:38", "text": "空の1つ。"}, {"type": "subtitle", "time": 7480.79, "timestamp": "02:04:40", "text": "そして今、あなたが"}, {"type": "subtitle", "time": 7491.91, "timestamp": "02:04:51", "text": "上位のものを見てください。行く。これらはすべて"}, {"type": "subtitle", "time": 7493.87, "timestamp": "02:04:53", "text": "ロックされています。ページの先頭へ"}, {"type": "subtitle", "time": 7497.589, "timestamp": "02:04:57", "text": "1つ。さて、こちらでは、彼らの何人かは"}, {"type": "subtitle", "time": 7499.589, "timestamp": "02:04:59", "text": "ロックされていません。そのまま装着できます"}]
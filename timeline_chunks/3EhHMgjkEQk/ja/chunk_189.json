[{"type": "subtitle", "time": 11341.75, "timestamp": "03:09:01", "text": "110%。 ３、２、１。フルに"}, {"type": "subtitle", "time": 11344.23, "timestamp": "03:09:04", "text": "スロットルを素早く開ける。えっと、シフトキーを使っています。"}, {"type": "subtitle", "time": 11346.15, "timestamp": "03:09:06", "text": "右？"}, {"type": "subtitle", "time": 11347.91, "timestamp": "03:09:07", "text": "キーバインドが何であれ。私のはそうではない"}, {"type": "subtitle", "time": 11356.07, "timestamp": "03:09:16", "text": "そして船から飛び立ったが、"}, {"type": "subtitle", "time": 11358.469, "timestamp": "03:09:18", "text": "お前は上を指ささなかった、ジョック、飛行機を指さしたんだ。"}, {"type": "subtitle", "time": 11360.55, "timestamp": "03:09:20", "text": "上を指ささなければなりません。ああ、私は"}, {"type": "subtitle", "time": 11363.83, "timestamp": "03:09:23", "text": "コックピット。そう、上を指ささないといけないんです。"}, {"type": "subtitle", "time": 11365.83, "timestamp": "03:09:25", "text": "うん、それはあなたを打ち上げる"}, {"type": "subtitle", "time": 11367.83, "timestamp": "03:09:27", "text": "すぐに。"}, {"type": "subtitle", "time": 11369.67, "timestamp": "03:09:29", "text": "よし、やろう。あなたは必要ない"}, {"type": "subtitle", "time": 11371.59, "timestamp": "03:09:31", "text": "空母への着艦を全て行うため。"}, {"type": "subtitle", "time": 11373.91, "timestamp": "03:09:33", "text": "格納庫に戻れ。"}, {"type": "subtitle", "time": 11376.23, "timestamp": "03:09:36", "text": "うん。"}, {"type": "subtitle", "time": 11377.51, "timestamp": "03:09:37", "text": "ただ体験したいだけなら"}, {"type": "subtitle", "time": 11380.469, "timestamp": "03:09:40", "text": "脱ぐ。"}, {"type": "subtitle", "time": 11382.71, "timestamp": "03:09:42", "text": "くそ。"}, {"type": "subtitle", "time": 11385.99, "timestamp": "03:09:45", "text": "テスト飛行をクリックしてください。それは「うん」って感じですね。"}, {"type": "subtitle", "time": 11389.19, "timestamp": "03:09:49", "text": "そしてスタート地点で待機する"}, {"type": "subtitle", "time": 11391.59, "timestamp": "03:09:51", "text": "空母"}]
[{"type": "subtitle", "time": 11643.349, "timestamp": "03:14:03", "text": "いいえ、ボタンは各値です。"}, {"type": "subtitle", "time": 11645.269, "timestamp": "03:14:05", "text": "最大値、最小値。それぞれの"}, {"type": "subtitle", "time": 11648.71, "timestamp": "03:14:08", "text": "それらにはボタンがあります。"}, {"type": "subtitle", "time": 11651.03, "timestamp": "03:14:11", "text": "また、一般的に言えば、"}, {"type": "subtitle", "time": 11652.87, "timestamp": "03:14:12", "text": "ゲームが自動的に"}, {"type": "subtitle", "time": 11655.349, "timestamp": "03:14:15", "text": "とにかく、あなたのためにやってくれるんです。"}, {"type": "subtitle", "time": 11660.309, "timestamp": "03:14:20", "text": "ああ、War Thunderでは、キーバインドは"}, {"type": "subtitle", "time": 11663.19, "timestamp": "03:14:23", "text": "それ自体がミニゲームだ。"}, {"type": "subtitle", "time": 11667.59, "timestamp": "03:14:27", "text": "ああ、それで、これらの鍵をすべてこのように配置すると"}, {"type": "subtitle", "time": 11669.15, "timestamp": "03:14:29", "text": "あなたが欲しい"}, {"type": "subtitle", "time": 11671.349, "timestamp": "03:14:31", "text": "30分ほどかかります"}, {"type": "subtitle", "time": 11674.71, "timestamp": "03:14:34", "text": "そして1時間。何？真ん中のやり方"}, {"type": "subtitle", "time": 11676.309, "timestamp": "03:14:36", "text": "あれ？"}, {"type": "subtitle", "time": 11679.03, "timestamp": "03:14:39", "text": "真ん中のどれのこと？あなたは私が"}, {"type": "subtitle", "time": 11681.91, "timestamp": "03:14:41", "text": "キーホルダーとして使わないでください。"}, {"type": "subtitle", "time": 11685.91, "timestamp": "03:14:45", "text": "よし。はい。今調べてみました。えっと"}, {"type": "subtitle", "time": 11688.99, "timestamp": "03:14:48", "text": "コントロールにおいて。行く"}, {"type": "subtitle", "time": 11691.469, "timestamp": "03:14:51", "text": "コントロール。コントロール"}, {"type": "subtitle", "time": 11694.79, "timestamp": "03:14:54", "text": "モードと切り替え制御モード。それを"}, {"type": "subtitle", "time": 11696.389, "timestamp": "03:14:56", "text": "キーバインド。すぐそこにあるよ。その通りです"}]
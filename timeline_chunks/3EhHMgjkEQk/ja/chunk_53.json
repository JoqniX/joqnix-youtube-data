[{"type": "subtitle", "time": 3186.549, "timestamp": "00:53:06", "text": "では、101を実行するとどうなるのでしょうか？"}, {"type": "chat", "time": 3190.199, "timestamp": "00:53:10", "author": "@soulofswords", "avatar": "https://yt4.ggpht.com/N5UGOOCkqJY6i3x846X2nx9EjZpP3SAIdAeuPAjxPPdNLWmO1Oi53_c__BkFrKVpJqviVQ07=s64-c-k-c0x00ffffff-no-rj", "message": "this game would be sick to play on ultrawide monitor or tv"}, {"type": "subtitle", "time": 3191.03, "timestamp": "00:53:11", "text": "えっと、全開？"}, {"type": "subtitle", "time": 3193.829, "timestamp": "00:53:13", "text": "ああ、それはただの緊急事態なんです"}, {"type": "subtitle", "time": 3201.67, "timestamp": "00:53:21", "text": "ああ、それは航空機を消耗させますが、"}, {"type": "subtitle", "time": 3203.67, "timestamp": "00:53:23", "text": "今私たちはアーケードにいます。"}, {"type": "subtitle", "time": 3205.99, "timestamp": "00:53:25", "text": "ずっと簡単だ。着陸しますか？実は、"}, {"type": "subtitle", "time": 3208.95, "timestamp": "00:53:28", "text": "えっと、ギアチェンジはどうすればいいですか？"}, {"type": "subtitle", "time": 3210.23, "timestamp": "00:53:30", "text": "あなたは何もする必要はありません。あなたの装備"}, {"type": "subtitle", "time": 3219.349, "timestamp": "00:53:39", "text": "ゼロ。大丈夫。"}, {"type": "subtitle", "time": 3222.63, "timestamp": "00:53:42", "text": "行きましたか？ああ、あなたは先頭にいるんですね。わかった。"}, {"type": "subtitle", "time": 3224.549, "timestamp": "00:53:44", "text": "注意深い。鼻を下に向けてはいけません。"}, {"type": "subtitle", "time": 3227.109, "timestamp": "00:53:47", "text": "鼻を少し上に向けてください。そのままに"}, {"type": "subtitle", "time": 3230.47, "timestamp": "00:53:50", "text": "道。エンジン本体が故障しました。"}, {"type": "subtitle", "time": 3239.03, "timestamp": "00:53:59", "text": "ああ、悪くないね。少なくともあなたは"}, {"type": "subtitle", "time": 3239.96, "timestamp": "00:53:59", "text": "転がる"}]
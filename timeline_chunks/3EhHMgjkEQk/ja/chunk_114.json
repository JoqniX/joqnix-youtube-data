[{"type": "subtitle", "time": 6840.149, "timestamp": "01:54:00", "text": "キルを取ることができます。だから、もし私が手に入れたら"}, {"type": "subtitle", "time": 6844.149, "timestamp": "01:54:04", "text": "飛行機が全部壊れてるみたいだ、もうダメだ"}, {"type": "subtitle", "time": 6846.99, "timestamp": "01:54:06", "text": "それなら、その試合は君の終わりだ。"}, {"type": "subtitle", "time": 6851.51, "timestamp": "01:54:11", "text": "えっと、飛行機は何機壊れたんですか？"}, {"type": "subtitle", "time": 6854.39, "timestamp": "01:54:14", "text": "まあ、今までは1人だったけどね。おお、いいね。あなたは"}, {"type": "subtitle", "time": 6861.43, "timestamp": "01:54:21", "text": "わあ、すごい。つまり、それも一つの方法だ"}, {"type": "subtitle", "time": 6864.229, "timestamp": "01:54:24", "text": "それについて。そして飛行機が到着した"}, {"type": "subtitle", "time": 6866.79, "timestamp": "01:54:26", "text": "コントロール。すばらしい。そして、あなたは"}, {"type": "subtitle", "time": 6869.189, "timestamp": "01:54:29", "text": "着陸装置。"}, {"type": "subtitle", "time": 6871.91, "timestamp": "01:54:31", "text": "ああ、もう行ってしまったんですね。ええ、あなたは"}, {"type": "subtitle", "time": 6873.109, "timestamp": "01:54:33", "text": "着陸装置。いや、いや、いや。あなたは"}, {"type": "subtitle", "time": 6875.99, "timestamp": "01:54:35", "text": "着陸装置。本当に覚えておかなければならない"}, {"type": "subtitle", "time": 6877.75, "timestamp": "01:54:37", "text": "伸縮式のものだったんですね。うん、君"}, {"type": "subtitle", "time": 6880.07, "timestamp": "01:54:40", "text": "修理しなければならない。君ならそれを飛ばせるよ。それは"}, {"type": "subtitle", "time": 6883.27, "timestamp": "01:54:43", "text": "ひどく損傷しているわけではない。私は戦ってきた"}, {"type": "subtitle", "time": 6885.589, "timestamp": "01:54:45", "text": "より劣悪な状況にある人々。はい、"}, {"type": "subtitle", "time": 6886.87, "timestamp": "01:54:46", "text": "土地。あなたを擁護してあげましょう。そこには"}, {"type": "subtitle", "time": 6891.51, "timestamp": "01:54:51", "text": "あなたを狙っている人々。バン。"}, {"type": "subtitle", "time": 6895.43, "timestamp": "01:54:55", "text": "まっすぐ飛んではいけない。まっすぐ飛んではいけない。"}, {"type": "subtitle", "time": 6897.31, "timestamp": "01:54:57", "text": "あなたは自分自身を簡単に"}, {"type": "subtitle", "time": 6899.83, "timestamp": "01:54:59", "text": "ターゲット。わかった。追っている男を捕まえた"}]
[{"type": "subtitle", "time": 2580.069, "timestamp": "00:43:00", "text": "それを使う？ああ、基礎レベルのチュートリアルですね。うん、"}, {"type": "subtitle", "time": 2581.91, "timestamp": "00:43:01", "text": "ご希望であれば、チュートリアルをやってみても構いません。"}, {"type": "subtitle", "time": 2588.87, "timestamp": "00:43:08", "text": "基本編のパート１へようこそ"}, {"type": "subtitle", "time": 2590.15, "timestamp": "00:43:10", "text": "チュートリアル。チュートリアルをやってみたいですか？"}, {"type": "subtitle", "time": 2592.23, "timestamp": "00:43:12", "text": "今すぐですか、それとも税関に入りたいですか？"}, {"type": "subtitle", "time": 2595.51, "timestamp": "00:43:15", "text": "これですか？自分らしくあれ。うん。うん。私に教えてください"}, {"type": "subtitle", "time": 2598.67, "timestamp": "00:43:18", "text": "それ。あなたはプロです。"}, {"type": "subtitle", "time": 2601.99, "timestamp": "00:43:21", "text": "わかった。待って。私はこれらのチュートリアルにアクセスできます"}, {"type": "subtitle", "time": 2604.63, "timestamp": "00:43:24", "text": "後でね？うん。はい、アクセスできます"}, {"type": "subtitle", "time": 2607.75, "timestamp": "00:43:27", "text": "彼ら。うん。"}, {"type": "subtitle", "time": 2609.91, "timestamp": "00:43:29", "text": "このゲームの目的は何ですか？君は"}, {"type": "subtitle", "time": 2614.55, "timestamp": "00:43:34", "text": "お互いに撃ち合う。つまり、あなたは"}, {"type": "subtitle", "time": 2617.79, "timestamp": "00:43:37", "text": "戦術的に座席に座る。ピューピューの撃ち方を学ぶ"}, {"type": "subtitle", "time": 2620.71, "timestamp": "00:43:40", "text": "正しくプレイすれば、レベルアップし続けることができます。"}, {"type": "subtitle", "time": 2622.55, "timestamp": "00:43:42", "text": "つまり、3つの方法があるということです。"}, {"type": "subtitle", "time": 2624.23, "timestamp": "00:43:44", "text": "それに取り組む。飛行機に乗ることもできます。"}, {"type": "subtitle", "time": 2625.91, "timestamp": "00:43:45", "text": "戦車を選ぶこともできますし、"}, {"type": "subtitle", "time": 2628.23, "timestamp": "00:43:48", "text": "船。厳密に言えば、2つしかない"}, {"type": "subtitle", "time": 2630.069, "timestamp": "00:43:50", "text": "それを行うための方法。誰も行かない"}, {"type": "subtitle", "time": 2631.829, "timestamp": "00:43:51", "text": "船。戦争で船をプレイする人はいない"}, {"type": "subtitle", "time": 2635.75, "timestamp": "00:43:55", "text": "雷。悲しい状況だ。何てことだ。"}, {"type": "subtitle", "time": 2637.349, "timestamp": "00:43:57", "text": "War Thunderのプレイヤー1000人につき、"}, {"type": "subtitle", "time": 2638.95, "timestamp": "00:43:58", "text": "そういう男が一人いるだろう"}]
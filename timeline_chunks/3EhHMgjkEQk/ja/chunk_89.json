[{"type": "subtitle", "time": 5344.55, "timestamp": "01:29:04", "text": "より高い。あなたの右側には"}, {"type": "subtitle", "time": 5346.31, "timestamp": "01:29:06", "text": "レーダー。それは、"}, {"type": "subtitle", "time": 5349.59, "timestamp": "01:29:09", "text": "敵機は。うん。これは何ですか"}, {"type": "subtitle", "time": 5352.79, "timestamp": "01:29:12", "text": "レーダーに疑問符？左側。"}, {"type": "subtitle", "time": 5355.83, "timestamp": "01:29:15", "text": "ああ、左側では、"}, {"type": "subtitle", "time": 5358.709, "timestamp": "01:29:18", "text": "敵のレーダーにスキャンされたが、あなたのシステムは"}, {"type": "subtitle", "time": 5360.55, "timestamp": "01:29:20", "text": "誰がスキャンしているのか分からない。だからそれは"}, {"type": "subtitle", "time": 5362.95, "timestamp": "01:29:22", "text": "質問として表示されます。"}, {"type": "subtitle", "time": 5364.629, "timestamp": "01:29:24", "text": "ほら、３、４発撃たれたんだろ？"}, {"type": "subtitle", "time": 5366.149, "timestamp": "01:29:26", "text": "回。"}, {"type": "subtitle", "time": 5369.03, "timestamp": "01:29:29", "text": "ええ、あれは疑問符でした"}, {"type": "subtitle", "time": 5371.47, "timestamp": "01:29:31", "text": "撃ち抜いてやる。待って、あなたは近くにいません"}, {"type": "subtitle", "time": 5373.83, "timestamp": "01:29:33", "text": "十分。また、あなたは後ろから撃っています"}, {"type": "subtitle", "time": 5375.51, "timestamp": "01:29:35", "text": "飛行機。前方を指し示さなければならない。見る"}, {"type": "subtitle", "time": 5384.55, "timestamp": "01:29:44", "text": "ミサイルについては、確認する必要があります"}, {"type": "subtitle", "time": 5386.39, "timestamp": "01:29:46", "text": "再びバインディングを。何が"}, {"type": "subtitle", "time": 5397.95, "timestamp": "01:29:57", "text": "左管制塔からの射撃"}]
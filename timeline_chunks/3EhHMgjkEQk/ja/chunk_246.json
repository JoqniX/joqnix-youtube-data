[{"type": "subtitle", "time": 14763.75, "timestamp": "04:06:03", "text": "一般的に、"}, {"type": "subtitle", "time": 14765.99, "timestamp": "04:06:05", "text": "プレイヤーベースは、イギリスのプレイヤーベースよりも多い。"}, {"type": "subtitle", "time": 14772.55, "timestamp": "04:06:12", "text": "イギリスの人口は66"}, {"type": "subtitle", "time": 14774.55, "timestamp": "04:06:14", "text": "百万とWar Thunderの人口"}, {"type": "subtitle", "time": 14782.95, "timestamp": "04:06:22", "text": "そして平均的な何"}, {"type": "subtitle", "time": 14785.99, "timestamp": "04:06:25", "text": "あれを蒸気と呼ぶのか？"}, {"type": "subtitle", "time": 14789.83, "timestamp": "04:06:29", "text": "一般的にアクティブなプレイヤーベースはどの"}, {"type": "subtitle", "time": 14792.95, "timestamp": "04:06:32", "text": "与えられた時間でアクティブプレイヤーベースは約"}, {"type": "subtitle", "time": 14799.349, "timestamp": "04:06:39", "text": "つまり、プレイ中のどの時点でも"}, {"type": "subtitle", "time": 14802.9, "timestamp": "04:06:42", "text": "10万人くらいがプレイしている"}, {"type": "subtitle", "time": 14804.309, "timestamp": "04:06:44", "text": "[音楽]"}, {"type": "subtitle", "time": 14807.03, "timestamp": "04:06:47", "text": "えっと、教えてくれますか、私ができるチームはありますか"}, {"type": "subtitle", "time": 14808.95, "timestamp": "04:06:48", "text": "参加する。"}, {"type": "subtitle", "time": 14811.349, "timestamp": "04:06:51", "text": "ええ、私は飛行隊に所属しています。わからない"}, {"type": "subtitle", "time": 14813.349, "timestamp": "04:06:53", "text": "人々。無料でオープンしました"}, {"type": "subtitle", "time": 14816.99, "timestamp": "04:06:56", "text": "飛行隊。それで、私も参加しました。そうでなければならない"}]
[{"type": "chat", "time": 8222.421, "timestamp": "02:17:02", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "dat was sadge"}, {"type": "subtitle", "time": 8222.709, "timestamp": "02:17:02", "text": "つまり、アーケードモードでは、"}, {"type": "subtitle", "time": 8224.629, "timestamp": "02:17:04", "text": "搭乗する飛行機を選択してください。"}, {"type": "subtitle", "time": 8227.11, "timestamp": "02:17:07", "text": "君は本当にいいプレーをするね、ポイント"}, {"type": "subtitle", "time": 8230.629, "timestamp": "02:17:10", "text": "蓄積して、5分ごとに"}, {"type": "subtitle", "time": 8231.99, "timestamp": "02:17:11", "text": "画面の下部に表示されます"}, {"type": "subtitle", "time": 8233.429, "timestamp": "02:17:13", "text": "戦闘機や"}, {"type": "subtitle", "time": 8236.309, "timestamp": "02:17:16", "text": "爆撃機を選択することもできます。"}, {"type": "subtitle", "time": 8238.79, "timestamp": "02:17:18", "text": "ああ、そしてランダムなファイターが与えられる"}, {"type": "subtitle", "time": 8242.509, "timestamp": "02:17:22", "text": "または、あなたの"}, {"type": "subtitle", "time": 8245.03, "timestamp": "02:17:25", "text": "タンク。さて、戦闘レベルが"}, {"type": "subtitle", "time": 8252.709, "timestamp": "02:17:32", "text": "でも、フライトを選ばなければならない"}, {"type": "subtitle", "time": 8255.19, "timestamp": "02:17:35", "text": "飛行機ですよね？"}, {"type": "subtitle", "time": 8257.11, "timestamp": "02:17:37", "text": "選択肢が与えられます。それで"}, {"type": "subtitle", "time": 8259.99, "timestamp": "02:17:39", "text": "通常は手に入らないし、飛行機も"}, {"type": "subtitle", "time": 8261.75, "timestamp": "02:17:41", "text": "自体。いいえ、あなたは選ぶことはできません"}, {"type": "subtitle", "time": 8264.309, "timestamp": "02:17:44", "text": "飛行機そのもの。でも、"}, {"type": "subtitle", "time": 8265.469, "timestamp": "02:17:45", "text": "オプション。それ"}, {"type": "subtitle", "time": 8268.23, "timestamp": "02:17:48", "text": "まるで「ああ、だって君が」と言っているように"}, {"type": "subtitle", "time": 8271.11, "timestamp": "02:17:51", "text": "十分な額を貯めていない"}, {"type": "subtitle", "time": 8272.629, "timestamp": "02:17:52", "text": "ポイント。 4人か5人を殺さなければならない"}, {"type": "subtitle", "time": 8274.15, "timestamp": "02:17:54", "text": "戦車。"}, {"type": "subtitle", "time": 8276.629, "timestamp": "02:17:56", "text": "ああ、本当に上手くプレイしないと"}, {"type": "subtitle", "time": 8279.429, "timestamp": "02:17:59", "text": "ポップアップ表示させる。"}]
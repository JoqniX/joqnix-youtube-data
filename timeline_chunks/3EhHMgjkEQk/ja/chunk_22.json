[{"type": "subtitle", "time": 1321.35, "timestamp": "00:22:01", "text": "BBI のものに切り替えて設定する"}, {"type": "subtitle", "time": 1323.83, "timestamp": "00:22:03", "text": "上に上げてから切り替えて右へ。私は"}, {"type": "subtitle", "time": 1325.59, "timestamp": "00:22:05", "text": "本当はもっと早く聞きたかったんだけど"}, {"type": "subtitle", "time": 1327.99, "timestamp": "00:22:07", "text": "すべてを試してみたかったのですか？"}, {"type": "subtitle", "time": 1331.43, "timestamp": "00:22:11", "text": "始める前に？"}, {"type": "subtitle", "time": 1346.31, "timestamp": "00:22:26", "text": "今日は一日中寝て過ごした。"}, {"type": "subtitle", "time": 1356.07, "timestamp": "00:22:36", "text": "何てことだ。私は苦労してきました"}, {"type": "subtitle", "time": 1357.59, "timestamp": "00:22:37", "text": "寝る"}, {"type": "subtitle", "time": 1362.149, "timestamp": "00:22:42", "text": "プロジェクトワークが好きです。何てことだ。おお"}, {"type": "subtitle", "time": 1364.63, "timestamp": "00:22:44", "text": "我が神よ。痛い。とても痛い。"}, {"type": "subtitle", "time": 1366.23, "timestamp": "00:22:46", "text": "やるべきことが山ほどある。戻りたい"}, {"type": "subtitle", "time": 1368.31, "timestamp": "00:22:48", "text": "仕事に取り掛かる。"}, {"type": "subtitle", "time": 1369.75, "timestamp": "00:22:49", "text": "実際に"}, {"type": "subtitle", "time": 1371.37, "timestamp": "00:22:51", "text": "働く。"}, {"type": "subtitle", "time": 1379.19, "timestamp": "00:22:59", "text": "そちらはどうですか？聞いたのは"}]
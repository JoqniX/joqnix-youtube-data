[{"type": "subtitle", "time": 3480.47, "timestamp": "00:58:00", "text": "M. 地図が見えますか？"}, {"type": "subtitle", "time": 3482.43, "timestamp": "00:58:02", "text": "うん。"}, {"type": "subtitle", "time": 3485.19, "timestamp": "00:58:05", "text": "注意。この件に関する大きな赤い線"}, {"type": "subtitle", "time": 3493.03, "timestamp": "00:58:13", "text": "つまり、赤は青のような色だ。青のことですか？"}, {"type": "subtitle", "time": 3495.67, "timestamp": "00:58:15", "text": "右？ええ、そうですね。あなたにとっては"}, {"type": "subtitle", "time": 3499.27, "timestamp": "00:58:19", "text": "青。わかった。了解。わかった。わかった。それ"}, {"type": "subtitle", "time": 3502.549, "timestamp": "00:58:22", "text": "1つ。はい。なぜこんなに遠いのですか？右"}, {"type": "subtitle", "time": 3506.47, "timestamp": "00:58:26", "text": "今。なぜそんなに遠いのですか？まあ、だって私たちは"}, {"type": "subtitle", "time": 3508.47, "timestamp": "00:58:28", "text": "地上戦に突入している。空気中でも"}, {"type": "subtitle", "time": 3511.349, "timestamp": "00:58:31", "text": "戦闘となると、少し遠すぎるだろう。"}, {"type": "subtitle", "time": 3514.95, "timestamp": "00:58:34", "text": "おお。それはあなたに時間を与えてくれます。つまり、私たちは見た"}, {"type": "subtitle", "time": 3516.47, "timestamp": "00:58:36", "text": "時間がなくて"}, {"type": "subtitle", "time": 3519.43, "timestamp": "00:58:39", "text": "着陸した。"}, {"type": "subtitle", "time": 3521.349, "timestamp": "00:58:41", "text": "そこが問題なんです。わかった。さて、これは"}, {"type": "subtitle", "time": 3523.829, "timestamp": "00:58:43", "text": "君の空軍基地のせいで着陸できない"}, {"type": "subtitle", "time": 3526.71, "timestamp": "00:58:46", "text": "防御力があって、私を撃ち落としてくれるだろう。そして"}, {"type": "subtitle", "time": 3528.95, "timestamp": "00:58:48", "text": "時間がなくなってしまった。"}, {"type": "subtitle", "time": 3530.549, "timestamp": "00:58:50", "text": "おお、"}, {"type": "subtitle", "time": 3532.39, "timestamp": "00:58:52", "text": "うん。そこにタイマーが付いています。これ"}, {"type": "subtitle", "time": 3534.23, "timestamp": "00:58:54", "text": "必ずタイマーが付属しています。セットアップします"}, {"type": "subtitle", "time": 3537.589, "timestamp": "00:58:57", "text": "また一人。このゲームの容量は何GBですか？"}]
[{"type": "subtitle", "time": 6001.109, "timestamp": "01:40:01", "text": "私と一緒にカスタムマッチをしましょう。"}, {"type": "subtitle", "time": 6005.27, "timestamp": "01:40:05", "text": "待って、カスタムマスクはXPを与えてくれる、"}, {"type": "subtitle", "time": 6007.51, "timestamp": "01:40:07", "text": "私は推測する。だから、それはあなたに"}, {"type": "subtitle", "time": 6008.51, "timestamp": "01:40:08", "text": "プレーヤー"}, {"type": "subtitle", "time": 6011.109, "timestamp": "01:40:11", "text": "XP。レベル3であることがわかりますが、"}, {"type": "subtitle", "time": 6012.629, "timestamp": "01:40:12", "text": "あなたは何も得ていない"}, {"type": "subtitle", "time": 6014.55, "timestamp": "01:40:14", "text": "あなたの航空機。"}, {"type": "subtitle", "time": 6016.87, "timestamp": "01:40:16", "text": "だから、最初からプレイしても"}, {"type": "subtitle", "time": 6018.39, "timestamp": "01:40:18", "text": "このゲームが発売されたら、"}, {"type": "subtitle", "time": 6021.59, "timestamp": "01:40:21", "text": "歴史は今も残っている。"}, {"type": "subtitle", "time": 6023.669, "timestamp": "01:40:23", "text": "履歴は"}, {"type": "subtitle", "time": 6025.83, "timestamp": "01:40:25", "text": "以前にプレイしたことがあり、"}, {"type": "subtitle", "time": 6029.91, "timestamp": "01:40:29", "text": "同じアカウント。 Steamみたい"}, {"type": "subtitle", "time": 6032.87, "timestamp": "01:40:32", "text": "何らかの魔法で王族が"}, {"type": "subtitle", "time": 6035.83, "timestamp": "01:40:35", "text": "アカウントをめちゃくちゃにしてロックされる"}, {"type": "subtitle", "time": 6037.75, "timestamp": "01:40:37", "text": "離れてしまうと、再びアクセスできなくなります。"}, {"type": "subtitle", "time": 6040.27, "timestamp": "01:40:40", "text": "それは流されます"}, {"type": "subtitle", "time": 6042.629, "timestamp": "01:40:42", "text": "トイレ。そうならない限り、"}, {"type": "subtitle", "time": 6045.27, "timestamp": "01:40:45", "text": "Steamで扱っているもの全部ですよね？"}, {"type": "subtitle", "time": 6047.109, "timestamp": "01:40:47", "text": "ああ、"}, {"type": "subtitle", "time": 6049.51, "timestamp": "01:40:49", "text": "そういうことなんです。"}, {"type": "subtitle", "time": 6052.07, "timestamp": "01:40:52", "text": "くそ、"}, {"type": "subtitle", "time": 6053.91, "timestamp": "01:40:53", "text": "私は決して何かをほのめかしているわけではありません"}, {"type": "subtitle", "time": 6056.81, "timestamp": "01:40:56", "text": "それは過去にも起こったことだ。"}, {"type": "subtitle", "time": 6058.39, "timestamp": "01:40:58", "text": "[笑い]"}]
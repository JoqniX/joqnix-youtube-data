[{"type": "subtitle", "time": 1862.95, "timestamp": "00:31:02", "text": "かつて人々がよく行った井戸のような場所"}, {"type": "subtitle", "time": 1864.63, "timestamp": "00:31:04", "text": "両親か祖父母かもしれないけど、私は"}, {"type": "subtitle", "time": 1867.269, "timestamp": "00:31:07", "text": "知る。人々はかつて一人の人の家へ行った"}, {"type": "subtitle", "time": 1870.71, "timestamp": "00:31:10", "text": "親戚に電話をかけるために家へ。 1つのように"}, {"type": "subtitle", "time": 1873.269, "timestamp": "00:31:13", "text": "5つの家屋セットには1つ"}, {"type": "subtitle", "time": 1874.95, "timestamp": "00:31:14", "text": "電話を持っていた人とみんな"}, {"type": "subtitle", "time": 1877.59, "timestamp": "00:31:17", "text": "その人の電話を使う"}, {"type": "subtitle", "time": 1880.71, "timestamp": "00:31:20", "text": "あるいは、クリケット観戦用のテレビのようなものだ。それ"}, {"type": "subtitle", "time": 1883.87, "timestamp": "00:31:23", "text": "PC版もそうだった"}, {"type": "subtitle", "time": 1887.269, "timestamp": "00:31:27", "text": "みんなお金がなかったから、ゲームをしていたんだ。私たちは"}, {"type": "subtitle", "time": 1889.029, "timestamp": "00:31:29", "text": "そうではなかった。"}, {"type": "subtitle", "time": 1891.909, "timestamp": "00:31:31", "text": "だから画面上で何かを買うことは"}, {"type": "subtitle", "time": 1894.71, "timestamp": "00:31:34", "text": "私たちの親世代には関係ないことだ。彼らは"}, {"type": "subtitle", "time": 1896.389, "timestamp": "00:31:36", "text": "「物理的なおもちゃは要らないの？」"}, {"type": "subtitle", "time": 1897.99, "timestamp": "00:31:37", "text": "理解できます。"}, {"type": "subtitle", "time": 1899.909, "timestamp": "00:31:39", "text": "あなたはただデジタルなものが欲しいのです"}, {"type": "subtitle", "time": 1902.63, "timestamp": "00:31:42", "text": "本当のお金のために旅に出る？いいえ。いいえ。あなたが望むのは"}, {"type": "subtitle", "time": 1904.71, "timestamp": "00:31:44", "text": "デジタル通貨で支払います。私"}, {"type": "subtitle", "time": 1914.63, "timestamp": "00:31:54", "text": "私もコンソールゲーム機はそうやって遊んでいました。私は"}, {"type": "subtitle", "time": 1915.95, "timestamp": "00:31:55", "text": "今まで一度も"}, {"type": "subtitle", "time": 1919.99, "timestamp": "00:31:59", "text": "コンソール。ああ、とても奇妙だ。私は決して"}]
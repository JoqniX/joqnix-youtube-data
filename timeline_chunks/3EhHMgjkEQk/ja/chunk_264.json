[{"type": "subtitle", "time": 15851.99, "timestamp": "04:24:11", "text": "くそ。君はゲームをプレイする。私は行きます"}, {"type": "subtitle", "time": 15853.83, "timestamp": "04:24:13", "text": "ゲームを開始する。私は試してみます"}, {"type": "subtitle", "time": 15856.229, "timestamp": "04:24:16", "text": "イベント会場からその飛行機を回収してください。それは私の"}, {"type": "subtitle", "time": 15858.87, "timestamp": "04:24:18", "text": "プロジェクトの負荷が高い最後の週なので"}, {"type": "subtitle", "time": 15860.79, "timestamp": "04:24:20", "text": "もしかしたら手に入らないかもしれないけど、"}, {"type": "subtitle", "time": 15862.95, "timestamp": "04:24:22", "text": "とにかくやってみるつもりだ。"}, {"type": "subtitle", "time": 15864.469, "timestamp": "04:24:24", "text": "それはジェット機です。私は試してみます"}, {"type": "subtitle", "time": 15866.71, "timestamp": "04:24:26", "text": "ああ、ジェット機だ。そうではありません"}, {"type": "subtitle", "time": 15868.71, "timestamp": "04:24:28", "text": "超音速だが、触れることができる"}, {"type": "subtitle", "time": 15871.429, "timestamp": "04:24:31", "text": "超音速。インド製"}, {"type": "subtitle", "time": 15874.349, "timestamp": "04:24:34", "text": "ええと、HLと呼ばれるほぼ超音速のジェット機"}, {"type": "subtitle", "time": 15878.91, "timestamp": "04:24:38", "text": "マルート。 3月。それだけです。ない"}, {"type": "subtitle", "time": 15881.51, "timestamp": "04:24:41", "text": "H. 歴史もとてもクールです"}, {"type": "subtitle", "time": 15884.07, "timestamp": "04:24:44", "text": "後で確認したいのですね。しかしそれは"}, {"type": "subtitle", "time": 15887.429, "timestamp": "04:24:47", "text": "飛行機がゲームに登場する予定です。"}, {"type": "subtitle", "time": 15891.229, "timestamp": "04:24:51", "text": "イベントは22日から開催されます。"}, {"type": "subtitle", "time": 15894.07, "timestamp": "04:24:54", "text": "24日。 2日間我慢できるなら"}, {"type": "subtitle", "time": 15898.59, "timestamp": "04:24:58", "text": "数週間かけて戦争でクレイジーなアクティビティをする"}]
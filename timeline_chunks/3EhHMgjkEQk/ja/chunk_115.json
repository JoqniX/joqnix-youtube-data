[{"type": "subtitle", "time": 6907.91, "timestamp": "01:55:07", "text": "神。修理中は私が援護飛行します。"}, {"type": "subtitle", "time": 6909.109, "timestamp": "01:55:09", "text": "いいね。着陸態勢に入ります"}, {"type": "subtitle", "time": 6914.07, "timestamp": "01:55:14", "text": "練習する。うん。さあ、周りを回って"}, {"type": "subtitle", "time": 6917.27, "timestamp": "01:55:17", "text": "うん、完璧だよ。迂回してください。土地"}, {"type": "subtitle", "time": 6920.87, "timestamp": "01:55:20", "text": "長さ"}, {"type": "subtitle", "time": 6923.27, "timestamp": "01:55:23", "text": "うん。滑走路。"}, {"type": "subtitle", "time": 6950.79, "timestamp": "01:55:50", "text": "私はまだ撃たれ続けている。彼らが来る"}]
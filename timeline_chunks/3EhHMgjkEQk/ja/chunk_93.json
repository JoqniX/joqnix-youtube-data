[{"type": "subtitle", "time": 5581.35, "timestamp": "01:33:01", "text": "現在、すべてのパイロットには割り当てられた"}, {"type": "subtitle", "time": 5584.629, "timestamp": "01:33:04", "text": "個人的なものも、あなたが"}, {"type": "subtitle", "time": 5586.709, "timestamp": "01:33:06", "text": "飛行機から飛び降りる。それで、この男は"}, {"type": "subtitle", "time": 5589.91, "timestamp": "01:33:09", "text": "彼はリボルバーを所持していた。どういうわけか、魔法のように、"}, {"type": "subtitle", "time": 5591.51, "timestamp": "01:33:11", "text": "彼はリボルバーを取り出した。彼は始めた"}, {"type": "subtitle", "time": 5593.03, "timestamp": "01:33:13", "text": "飛行機を撃ち、"}, {"type": "subtitle", "time": 5595.27, "timestamp": "01:33:15", "text": "日本人男性。"}, {"type": "subtitle", "time": 5597.91, "timestamp": "01:33:17", "text": "何？彼は空中に浮かんでいる"}, {"type": "subtitle", "time": 5599.669, "timestamp": "01:33:19", "text": "パラシュート。そしてリボルバーで、"}, {"type": "subtitle", "time": 5604.35, "timestamp": "01:33:24", "text": "日本人パイロットを打ち負かすことに成功した。"}, {"type": "subtitle", "time": 5611.83, "timestamp": "01:33:31", "text": "起こり得るが、この飛行機なら"}, {"type": "subtitle", "time": 5614.229, "timestamp": "01:33:34", "text": "非常に簡単に失神を経験する"}, {"type": "subtitle", "time": 5617.75, "timestamp": "01:33:37", "text": "最大Gが当たるため"}, {"type": "subtitle", "time": 5623.99, "timestamp": "01:33:43", "text": "そのままターンインを続けなければなりません"}, {"type": "subtitle", "time": 5631.189, "timestamp": "01:33:51", "text": "遠距離から射撃するにはどうすればいいですか？"}, {"type": "subtitle", "time": 5633.99, "timestamp": "01:33:53", "text": "それにはできない、長くする必要がある"}, {"type": "subtitle", "time": 5636.39, "timestamp": "01:33:56", "text": "距離ミサイルは、"}, {"type": "subtitle", "time": 5638.39, "timestamp": "01:33:58", "text": "レーダーミサイル。レーダーを取得する方法"}]
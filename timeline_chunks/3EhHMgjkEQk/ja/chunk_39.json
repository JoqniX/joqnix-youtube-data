[{"type": "subtitle", "time": 2342.95, "timestamp": "00:39:02", "text": "1. 何も起こりません。カメラのせいだ"}, {"type": "subtitle", "time": 2345.91, "timestamp": "00:39:05", "text": "移動中。通り抜けてください。私は好きであるべきでしょうか"}, {"type": "subtitle", "time": 2349.27, "timestamp": "00:39:09", "text": "実際にこんな風に動くの？"}, {"type": "subtitle", "time": 2351.349, "timestamp": "00:39:11", "text": "はい。はい、"}, {"type": "subtitle", "time": 2354.71, "timestamp": "00:39:14", "text": "私はそれをしました。"}, {"type": "subtitle", "time": 2358.63, "timestamp": "00:39:18", "text": "ああ、それは興味深いですね。わかった。えっと、待って。"}, {"type": "subtitle", "time": 2360.71, "timestamp": "00:39:20", "text": "あなたの戦闘レーティングはいくつですか？何何"}, {"type": "subtitle", "time": 2364.87, "timestamp": "00:39:24", "text": "最も高い数値の平面は単位平面ですか？"}, {"type": "subtitle", "time": 2367.19, "timestamp": "00:39:27", "text": "どうすればそれを確認できますか？あなたは"}, {"type": "subtitle", "time": 2368.71, "timestamp": "00:39:28", "text": "あなたはそうするでしょう、あなたはそうしなければならないでしょう"}, {"type": "subtitle", "time": 2370.55, "timestamp": "00:39:30", "text": "そのためにはロビーに戻る必要がある。私は手に入れた"}, {"type": "subtitle", "time": 2384.069, "timestamp": "00:39:44", "text": "わかった。あなたのこのことを共有してください。何が"}, {"type": "subtitle", "time": 2390.15, "timestamp": "00:39:50", "text": "あなたはそれを何と呼ぶのですか？わかった。ええ、ちょっと待ってください。"}, {"type": "subtitle", "time": 2392.15, "timestamp": "00:39:52", "text": "あなたの作品を共有してください。あなたを"}, {"type": "subtitle", "time": 2393.8, "timestamp": "00:39:53", "text": "友人。"}]
[{"type": "subtitle", "time": 7081.91, "timestamp": "01:58:01", "text": "試合の終わりに、何が"}, {"type": "subtitle", "time": 7084.07, "timestamp": "01:58:04", "text": "君は手に入れた。"}, {"type": "subtitle", "time": 7087.03, "timestamp": "01:58:07", "text": "ああ、研究ユニットを手に入れたし"}, {"type": "subtitle", "time": 7089.43, "timestamp": "01:58:09", "text": "すべて。はい、私の"}, {"type": "subtitle", "time": 7090.87, "timestamp": "01:58:10", "text": "結果は上部に表示されます。または、クリックすることもできます。"}, {"type": "subtitle", "time": 7092.39, "timestamp": "01:58:12", "text": "選手の統計情報。何が見えるか"}, {"type": "subtitle", "time": 7094.87, "timestamp": "01:58:14", "text": "チーム全員がそうしました。"}, {"type": "subtitle", "time": 7096.79, "timestamp": "01:58:16", "text": "おお、"}, {"type": "subtitle", "time": 7099.589, "timestamp": "01:58:19", "text": "うん。最初の試合では"}, {"type": "subtitle", "time": 7103.589, "timestamp": "01:58:23", "text": "ほとんどの場合、あなたはとてもよくやってくれました。ああ、"}, {"type": "subtitle", "time": 7109.03, "timestamp": "01:58:29", "text": "行く。うん。"}, {"type": "subtitle", "time": 7111.189, "timestamp": "01:58:31", "text": "非常に良い飛行でした。"}, {"type": "subtitle", "time": 7120.07, "timestamp": "01:58:40", "text": "このためにゴールデンイーグルを買わなければならない"}, {"type": "subtitle", "time": 7123.75, "timestamp": "01:58:43", "text": "乗組員を募集する。いいえ、イヌワシは実在します"}, {"type": "subtitle", "time": 7126.95, "timestamp": "01:58:46", "text": "お金の話。おお、"}, {"type": "subtitle", "time": 7129.189, "timestamp": "01:58:49", "text": "ゴールデンイーグルはプレミアム通貨で、"}, {"type": "subtitle", "time": 7130.95, "timestamp": "01:58:50", "text": "最初は少しだけ手に入ります。"}, {"type": "subtitle", "time": 7133.75, "timestamp": "01:58:53", "text": "だから、彼らはあなたをそれに誘い込むことができるのです"}, {"type": "subtitle", "time": 7136.31, "timestamp": "01:58:56", "text": "そしてあなたは黄金の鷲の力を感じる"}, {"type": "subtitle", "time": 7138.79, "timestamp": "01:58:58", "text": "そして、実際のお金を払いたい"}]
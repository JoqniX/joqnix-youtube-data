[{"type": "subtitle", "time": 8460.309, "timestamp": "02:21:00", "text": "飛行機。わかった。"}, {"type": "subtitle", "time": 8468.349, "timestamp": "02:21:08", "text": "探す。スウェーデンはどこにあるの？右。うん、"}, {"type": "subtitle", "time": 8471.75, "timestamp": "02:21:11", "text": "スウェーデン。さあ、試してみませんか？"}, {"type": "subtitle", "time": 8474.79, "timestamp": "02:21:14", "text": "リアルな感じがいいですか？それともアーケード風がいいですか？"}, {"type": "subtitle", "time": 8477.03, "timestamp": "02:21:17", "text": "ああ、現実的だね。やってみます。うん。あなた"}, {"type": "subtitle", "time": 8479.429, "timestamp": "02:21:19", "text": "リアルな表現を試してみたいですか？わかった。うん。させて"}, {"type": "subtitle", "time": 8480.349, "timestamp": "02:21:20", "text": "自分"}, {"type": "subtitle", "time": 8488.95, "timestamp": "02:21:28", "text": "なぜなら、私は"}, {"type": "subtitle", "time": 8490.83, "timestamp": "02:21:30", "text": "難しすぎる"}, {"type": "subtitle", "time": 8494.03, "timestamp": "02:21:34", "text": "あなた。うん、じゃあ"}, {"type": "subtitle", "time": 8497.91, "timestamp": "02:21:37", "text": "それ。現実的。準備はいいですか？"}, {"type": "subtitle", "time": 8519.11, "timestamp": "02:21:59", "text": "おそらくあなたは元々ダウンロードしたのでしょう"}]
[{"type": "subtitle", "time": 7380.95, "timestamp": "02:03:00", "text": "ええと、それは特別なイベントのようなものです。"}, {"type": "subtitle", "time": 7383.03, "timestamp": "02:03:03", "text": "だから、誰もが、誰一人として手に入れることはできない"}, {"type": "subtitle", "time": 7386.39, "timestamp": "02:03:06", "text": "それ。それは、装飾品の中にあります。それで、"}, {"type": "subtitle", "time": 7389.51, "timestamp": "02:03:09", "text": "変更画面に進むと"}, {"type": "subtitle", "time": 7391.75, "timestamp": "02:03:11", "text": "あるいは、変更ではなく、待ってください。どこ"}, {"type": "subtitle", "time": 7394.709, "timestamp": "02:03:14", "text": "それ？アイテムショップ。"}, {"type": "subtitle", "time": 7396.31, "timestamp": "02:03:16", "text": "いいえ、あなた"}, {"type": "subtitle", "time": 7397.91, "timestamp": "02:03:17", "text": "飛行機をクリックすると、"}, {"type": "subtitle", "time": 7400.79, "timestamp": "02:03:20", "text": "カスタマイズ。"}, {"type": "subtitle", "time": 7404.87, "timestamp": "02:03:24", "text": "わかった。カスタマイズでは、スキンを入手できます"}, {"type": "subtitle", "time": 7406.189, "timestamp": "02:03:26", "text": "そして"}, {"type": "subtitle", "time": 7409.03, "timestamp": "02:03:29", "text": "迷彩。しかし戦車では、"}, {"type": "subtitle", "time": 7410.91, "timestamp": "02:03:30", "text": "タンクに切り替える"}, {"type": "subtitle", "time": 7413.43, "timestamp": "02:03:33", "text": "それ。飛行機の中では、"}, {"type": "subtitle", "time": 7415.83, "timestamp": "02:03:35", "text": "航空機の上にあるものすべて。で"}, {"type": "subtitle", "time": 7417.51, "timestamp": "02:03:37", "text": "タンクの上に物を置くことができます"}, {"type": "subtitle", "time": 7419.669, "timestamp": "02:03:39", "text": "タンク。"}, {"type": "subtitle", "time": 7422.669, "timestamp": "02:03:42", "text": "もう一つ、"}, {"type": "subtitle", "time": 7430.709, "timestamp": "02:03:50", "text": "チャットにも誰かがいます。こんにちは。"}, {"type": "subtitle", "time": 7431.629, "timestamp": "02:03:51", "text": "こんにちは"}, {"type": "subtitle", "time": 7436.149, "timestamp": "02:03:56", "text": "シャン。こんばんは、またはごきげんよう。"}, {"type": "subtitle", "time": 7439.589, "timestamp": "02:03:59", "text": "いらっしゃいませ。いらっしゃいませ。あなたは仲間ですか"}]
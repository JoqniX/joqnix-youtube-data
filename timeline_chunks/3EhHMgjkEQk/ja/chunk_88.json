[{"type": "subtitle", "time": 5281.27, "timestamp": "01:28:01", "text": "上昇中、あなたの飛行機はまだ進み続けます"}, {"type": "subtitle", "time": 5284.51, "timestamp": "01:28:04", "text": "慣性が大きいので下向きになる"}, {"type": "subtitle", "time": 5287.11, "timestamp": "01:28:07", "text": "もっと。具体的にはジェット機で起こる"}, {"type": "subtitle", "time": 5289.35, "timestamp": "01:28:09", "text": "たくさん。だから気をつけないと"}, {"type": "subtitle", "time": 5291.709, "timestamp": "01:28:11", "text": "停車も"}, {"type": "subtitle", "time": 5300.31, "timestamp": "01:28:20", "text": "えっと、Cを押してください。少し"}, {"type": "subtitle", "time": 5301.83, "timestamp": "01:28:21", "text": "十分に近づく前に"}, {"type": "subtitle", "time": 5304.47, "timestamp": "01:28:24", "text": "飛行機。そして、次のようにOを押します。"}, {"type": "subtitle", "time": 5311.27, "timestamp": "01:28:31", "text": "ああ、これはあなたの"}, {"type": "subtitle", "time": 5313.59, "timestamp": "01:28:33", "text": "航空機。傷ついたら、"}, {"type": "subtitle", "time": 5315.35, "timestamp": "01:28:35", "text": "損傷箇所を正確に確認してください。"}, {"type": "subtitle", "time": 5318.229, "timestamp": "01:28:38", "text": "それは戦闘中でも可能です。"}, {"type": "subtitle", "time": 5321.75, "timestamp": "01:28:41", "text": "ニース。 2Dビューで"}, {"type": "subtitle", "time": 5323.27, "timestamp": "01:28:43", "text": "左下の航空機"}, {"type": "subtitle", "time": 5325.31, "timestamp": "01:28:45", "text": "ダメージを受けたときに画面"}, {"type": "subtitle", "time": 5327.75, "timestamp": "01:28:47", "text": "損傷していますが、3Dで確認できます。"}]
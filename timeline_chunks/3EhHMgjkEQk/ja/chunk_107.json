[{"type": "subtitle", "time": 6421.189, "timestamp": "01:47:01", "text": "ベース。"}, {"type": "subtitle", "time": 6423.669, "timestamp": "01:47:03", "text": "なぜ基地に戻りたいのですか？"}, {"type": "subtitle", "time": 6427.109, "timestamp": "01:47:07", "text": "だって、修理は無料だから。"}, {"type": "subtitle", "time": 6429.51, "timestamp": "01:47:09", "text": "ええ、でもあなたは、"}, {"type": "subtitle", "time": 6433.51, "timestamp": "01:47:13", "text": "全て。私はそうではない"}, {"type": "subtitle", "time": 6436.55, "timestamp": "01:47:16", "text": "あなたには怪我は見当たりません。そうですか"}, {"type": "subtitle", "time": 6439.109, "timestamp": "01:47:19", "text": "何か損傷箇所を見せていただけますか？うん、赤は"}, {"type": "subtitle", "time": 6441.51, "timestamp": "01:47:21", "text": "プロペラ。"}, {"type": "subtitle", "time": 6443.109, "timestamp": "01:47:23", "text": "プロペラに赤色。うん、大丈夫だよ。"}, {"type": "subtitle", "time": 6446.79, "timestamp": "01:47:26", "text": "大丈夫です。大丈夫です。わかった。"}, {"type": "subtitle", "time": 6450.07, "timestamp": "01:47:30", "text": "何も見えません。わかった。 Oを押してください。"}, {"type": "subtitle", "time": 6454.31, "timestamp": "01:47:34", "text": "私にはわかる。うん。黄色。赤。ああ、くそ。"}, {"type": "subtitle", "time": 6455.99, "timestamp": "01:47:35", "text": "うん。うん。基地に戻れ。何てことだ。"}, {"type": "subtitle", "time": 6457.35, "timestamp": "01:47:37", "text": "それが赤色ではないことに気づきませんでした。それは"}, {"type": "subtitle", "time": 6460.149, "timestamp": "01:47:40", "text": "黒。エンジンがありません。"}, {"type": "subtitle", "time": 6462.07, "timestamp": "01:47:42", "text": "私はしません。一体どこにいるんだ？あなた"}, {"type": "subtitle", "time": 6463.51, "timestamp": "01:47:43", "text": "エンジンがないからダメだよ。あなたは"}, {"type": "subtitle", "time": 6465.03, "timestamp": "01:47:45", "text": "あなたは今、空中を滑空しています"}, {"type": "subtitle", "time": 6468.39, "timestamp": "01:47:48", "text": "今。わかった。少し下向きに。行く"}, {"type": "subtitle", "time": 6470.07, "timestamp": "01:47:50", "text": "空軍基地へ直行し、下を向く"}, {"type": "subtitle", "time": 6472.87, "timestamp": "01:47:52", "text": "若干。空気はどこにあるの？あなたは"}]
[{"type": "subtitle", "time": 3848.39, "timestamp": "01:04:08", "text": "徐々にスピードを上げてください。動きが遅すぎますよ。"}, {"type": "subtitle", "time": 3851.029, "timestamp": "01:04:11", "text": "山に激突するだろう。取る"}, {"type": "subtitle", "time": 3854.47, "timestamp": "01:04:14", "text": "オフ。脱ぐ。脱ぐ。待って、実際"}, {"type": "subtitle", "time": 3857.67, "timestamp": "01:04:17", "text": "脱ぐ？うん。ええ、実際に離陸します。"}, {"type": "subtitle", "time": 3862.71, "timestamp": "01:04:22", "text": "なぜそうしないのですか？偽の離陸とは何ですか？"}, {"type": "subtitle", "time": 3867.19, "timestamp": "01:04:27", "text": "いいえ、できます。実際に速度を落とすことができます。"}, {"type": "subtitle", "time": 3870.069, "timestamp": "01:04:30", "text": "では、もう一度私についてきてください。見つけよう"}, {"type": "subtitle", "time": 3878.549, "timestamp": "01:04:38", "text": "何てことだ。君が向きを変えられるなんて知らなかった"}, {"type": "subtitle", "time": 3894.95, "timestamp": "01:04:54", "text": "わかった。おそらく、あなたは着陸地点を取り除いたのでしょう"}, {"type": "subtitle", "time": 3898.63, "timestamp": "01:04:58", "text": "ギア1つか2つ。いいえ、何も。何もない"}]
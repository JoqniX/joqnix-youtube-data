[{"type": "subtitle", "time": 7745.03, "timestamp": "02:09:05", "text": "また。準備ができたら教えてください。"}, {"type": "subtitle", "time": 7747.99, "timestamp": "02:09:07", "text": "軍隊に転属すべきだろうか？"}, {"type": "subtitle", "time": 7749.629, "timestamp": "02:09:09", "text": "うん、"}, {"type": "subtitle", "time": 7752.39, "timestamp": "02:09:12", "text": "軍。私が設定できるモード。つまり"}, {"type": "subtitle", "time": 7765.27, "timestamp": "02:09:25", "text": "ええと、3つの中から"}, {"type": "subtitle", "time": 7766.95, "timestamp": "02:09:26", "text": "乗組員に戦車をもう1両追加する。あなたが持っている"}, {"type": "subtitle", "time": 7770.629, "timestamp": "02:09:30", "text": "乗組員5人くらい。私は飛行機を4機持っています。私"}, {"type": "subtitle", "time": 7772.709, "timestamp": "02:09:32", "text": "推測"}, {"type": "subtitle", "time": 7774.229, "timestamp": "02:09:34", "text": "飛行機のことは忘れてください。中に入る"}, {"type": "subtitle", "time": 7782.069, "timestamp": "02:09:42", "text": "必要なものは全て揃っていますか？えーと、ハゴ"}, {"type": "subtitle", "time": 7785.99, "timestamp": "02:09:45", "text": "一番上の最初の戦車。うん。うん。"}, {"type": "subtitle", "time": 7788.87, "timestamp": "02:09:48", "text": "担当クルーを選抜してください。"}, {"type": "subtitle", "time": 7795.27, "timestamp": "02:09:55", "text": "H."}, {"type": "subtitle", "time": 7798.39, "timestamp": "02:09:58", "text": "そこには「注文」と書いてあります。うん。注文してください。はい。"}]
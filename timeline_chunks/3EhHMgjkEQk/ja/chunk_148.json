[{"type": "subtitle", "time": 8882.71, "timestamp": "02:28:02", "text": "一体そこで何が起こったんだ？"}, {"type": "subtitle", "time": 8894.87, "timestamp": "02:28:14", "text": "音声を確認してください。ああ、なんてこった。何"}, {"type": "subtitle", "time": 8898.309, "timestamp": "02:28:18", "text": "何が起こったのか？はい。ああ、これはこれは"}, {"type": "subtitle", "time": 8899.91, "timestamp": "02:28:19", "text": "恥ずかしい。なぜこんなことが起こらなければならないのか"}, {"type": "subtitle", "time": 8902.71, "timestamp": "02:28:22", "text": "配信中なの？どうしたの？あなたが知っている"}, {"type": "subtitle", "time": 8906.23, "timestamp": "02:28:26", "text": "どうしたの？ええ、うっかり叩いてしまいました"}, {"type": "subtitle", "time": 8908.19, "timestamp": "02:28:28", "text": "私のスピーカーをミュートします"}, {"type": "subtitle", "time": 8910.469, "timestamp": "02:28:30", "text": "システム。いつやったのかさえ覚えていない"}, {"type": "subtitle", "time": 8914.469, "timestamp": "02:28:34", "text": "それ。何てことだ。大丈夫。"}, {"type": "subtitle", "time": 8918.469, "timestamp": "02:28:38", "text": "おお。そして、ここで私があなたに教えていることとは？"}, {"type": "subtitle", "time": 8921.349, "timestamp": "02:28:41", "text": "いや、大丈夫だよ。大丈夫。大丈夫。"}, {"type": "subtitle", "time": 8923.59, "timestamp": "02:28:43", "text": "まあ、基本的に、あなたが"}, {"type": "subtitle", "time": 8927.07, "timestamp": "02:28:47", "text": "知ってるよ、俺たちをからかってる奴は誰だ"}, {"type": "subtitle", "time": 8929.75, "timestamp": "02:28:49", "text": "殺した、私がしたことは悪いことだった"}, {"type": "subtitle", "time": 8933.59, "timestamp": "02:28:53", "text": "そうするけど、彼はさっきTKしようとしてたんだ。"}, {"type": "subtitle", "time": 8936.23, "timestamp": "02:28:56", "text": "彼は味方を殺そうとしていた。注意"}]
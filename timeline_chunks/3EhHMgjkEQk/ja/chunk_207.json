[{"type": "subtitle", "time": 12420.95, "timestamp": "03:27:00", "text": "一人で"}, {"type": "subtitle", "time": 12422.389, "timestamp": "03:27:02", "text": "そうでなければ、どうやってあなたを作るのか"}, {"type": "subtitle", "time": 12424.79, "timestamp": "03:27:04", "text": "それを欲しくてたまらない？"}, {"type": "subtitle", "time": 12426.469, "timestamp": "03:27:06", "text": "それはまるで"}, {"type": "subtitle", "time": 12428.429, "timestamp": "03:27:08", "text": "アニメ"}, {"type": "subtitle", "time": 12431.51, "timestamp": "03:27:11", "text": "新しい炎炎ノ消防隊のようなエピソード、または"}, {"type": "subtitle", "time": 12433.19, "timestamp": "03:27:13", "text": "どんなアニメ番組が良いのか分からない"}, {"type": "subtitle", "time": 12436.07, "timestamp": "03:27:16", "text": "今まさに起こっていることです。あなたも"}, {"type": "subtitle", "time": 12437.469, "timestamp": "03:27:17", "text": "忘れた"}, {"type": "subtitle", "time": 12440.87, "timestamp": "03:27:20", "text": "ヒーローXになるための今のところ何も起こっていません"}, {"type": "subtitle", "time": 12443.269, "timestamp": "03:27:23", "text": "ヒーローXになること。まだその道には進んでいない。"}, {"type": "subtitle", "time": 12446.15, "timestamp": "03:27:26", "text": "まだ。"}, {"type": "subtitle", "time": 12451.51, "timestamp": "03:27:31", "text": "私には演出過剰に感じられる。"}, {"type": "subtitle", "time": 12455.63, "timestamp": "03:27:35", "text": "よし、見てみよう。どこに"}, {"type": "subtitle", "time": 12465.99, "timestamp": "03:27:45", "text": "おお、意外だ。あなたは十分に小さいので"}]
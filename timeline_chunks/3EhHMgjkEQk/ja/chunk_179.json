[{"type": "subtitle", "time": 10741.11, "timestamp": "02:59:01", "text": "ええ、そうです。はい、どうぞ。見つけましたね。今"}, {"type": "subtitle", "time": 10742.71, "timestamp": "02:59:02", "text": "もっときちんと調整してください。あなたは"}, {"type": "subtitle", "time": 10744.87, "timestamp": "02:59:04", "text": "船の側面。を指差す"}, {"type": "subtitle", "time": 10747.269, "timestamp": "02:59:07", "text": "船。船の方を指さしてください。少し"}, {"type": "subtitle", "time": 10753.23, "timestamp": "02:59:13", "text": "高い。良い"}, {"type": "subtitle", "time": 10761.309, "timestamp": "02:59:21", "text": "上。上を向いてください。もう少しだけ。"}, {"type": "subtitle", "time": 10766.71, "timestamp": "02:59:26", "text": "はい、そうです。何てことだ。やったよ。さあ行こう。"}, {"type": "subtitle", "time": 10769.71, "timestamp": "02:59:29", "text": "何てことだ。それでおしまい。気に入った"}, {"type": "subtitle", "time": 10771.67, "timestamp": "02:59:31", "text": "着陸時に自動的に作動します。"}, {"type": "subtitle", "time": 10773.11, "timestamp": "02:59:33", "text": "それが飛行機の着陸方法です"}, {"type": "subtitle", "time": 10775.51, "timestamp": "02:59:35", "text": "運送業者。ワイヤーとあなたの飛行機"}, {"type": "subtitle", "time": 10778.389, "timestamp": "02:59:38", "text": "ワイヤーを引っ掛ける。"}, {"type": "subtitle", "time": 10780.55, "timestamp": "02:59:40", "text": "ああ、フックは、そのワイヤーがあなたを"}, {"type": "subtitle", "time": 10782.87, "timestamp": "02:59:42", "text": "停止。"}, {"type": "subtitle", "time": 10786.79, "timestamp": "02:59:46", "text": "ああ。さあ、楽しい離陸を始めましょう。"}, {"type": "subtitle", "time": 10789.51, "timestamp": "02:59:49", "text": "うん。正面を見てください。変えて"}, {"type": "subtitle", "time": 10792.429, "timestamp": "02:59:52", "text": "カメラをOKに。ゆっくりと、とても"}, {"type": "subtitle", "time": 10795.269, "timestamp": "02:59:55", "text": "ゆっくりと、飛行機をその2人に向けなさい"}, {"type": "subtitle", "time": 10797.59, "timestamp": "02:59:57", "text": "ご覧になる線は、厳密に言えば"}, {"type": "subtitle", "time": 10799.51, "timestamp": "02:59:59", "text": "あなたは列の隣にいますが、それらの"}]
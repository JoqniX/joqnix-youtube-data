[{"type": "subtitle", "time": 6663.91, "timestamp": "01:51:03", "text": "私はBFを選びます。あ、待って。どうでも。"}, {"type": "subtitle", "time": 6671.95, "timestamp": "01:51:11", "text": "男。キー10。了解。わかった、"}, {"type": "subtitle", "time": 6682.03, "timestamp": "01:51:22", "text": "カメラを押したことはありますか？"}, {"type": "subtitle", "time": 6683.709, "timestamp": "01:51:23", "text": "ロック？"}, {"type": "subtitle", "time": 6686.149, "timestamp": "01:51:26", "text": "ちょっと待って、見せて。彼は私たちの"}, {"type": "subtitle", "time": 6687.59, "timestamp": "01:51:27", "text": "チーム。ええ、その必要はありませんよ。しないで"}, {"type": "subtitle", "time": 6690.91, "timestamp": "01:51:30", "text": "何にでもロックをかけられます。うん、"}, {"type": "subtitle", "time": 6693.629, "timestamp": "01:51:33", "text": "それ。遠すぎますよ。あなたも"}, {"type": "subtitle", "time": 6697.35, "timestamp": "01:51:37", "text": "遠い。透明な円が"}, {"type": "subtitle", "time": 6699.149, "timestamp": "01:51:39", "text": "見せる"}]
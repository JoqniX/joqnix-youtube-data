[{"type": "subtitle", "time": 6300.39, "timestamp": "01:45:00", "text": "どうすれば2位になれますか？中に入る"}, {"type": "subtitle", "time": 6302.87, "timestamp": "01:45:02", "text": "アーケードマッチ。別のものを選択してください"}, {"type": "subtitle", "time": 6304.87, "timestamp": "01:45:04", "text": "国。または、"}, {"type": "subtitle", "time": 6312.109, "timestamp": "01:45:12", "text": "P26を選びましょう。あなたは既にそれを持っている。"}, {"type": "subtitle", "time": 6314.87, "timestamp": "01:45:14", "text": "ああ、P26ですね。"}, {"type": "subtitle", "time": 6319.35, "timestamp": "01:45:19", "text": "どちらか。どちらか一方。あるいは両方。ええ、そうですね。"}, {"type": "subtitle", "time": 6322.31, "timestamp": "01:45:22", "text": "わかった。わかった。打つ。わかった。"}, {"type": "subtitle", "time": 6326.709, "timestamp": "01:45:26", "text": "乗組員を選んでください。そして3つ目。私"}, {"type": "subtitle", "time": 6329.83, "timestamp": "01:45:29", "text": "それも必要です。これは買えます。わかった。"}, {"type": "subtitle", "time": 6331.75, "timestamp": "01:45:31", "text": "うん。"}, {"type": "subtitle", "time": 6340.51, "timestamp": "01:45:40", "text": "飛行機。準備は万端です。さあ行こう"}, {"type": "subtitle", "time": 6343.83, "timestamp": "01:45:43", "text": "戦い。さあ、基本をすべて思い出してください。どうやって"}, {"type": "subtitle", "time": 6347.59, "timestamp": "01:45:47", "text": "飛行機が旋回する。どうやって撮影するのですか？しないで"}, {"type": "subtitle", "time": 6349.47, "timestamp": "01:45:49", "text": "そのまま続けて"}, {"type": "subtitle", "time": 6352.55, "timestamp": "01:45:52", "text": "散布。指をささないで 撃たないで"}, {"type": "subtitle", "time": 6355.83, "timestamp": "01:45:55", "text": "飛行機そのもの。それよりも先に撃て。右。"}]
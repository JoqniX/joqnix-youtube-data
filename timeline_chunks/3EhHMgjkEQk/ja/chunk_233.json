[{"type": "subtitle", "time": 13981.59, "timestamp": "03:53:01", "text": "その通り。私ははるかに強力だ"}, {"type": "subtitle", "time": 13983.349, "timestamp": "03:53:03", "text": "航空機だから、到着する前に死ぬだろう"}, {"type": "subtitle", "time": 13985.269, "timestamp": "03:53:05", "text": "自分。君は僕を殺したんだよ、ほら、"}, {"type": "subtitle", "time": 13993.51, "timestamp": "03:53:13", "text": "ニース。くそっ。どれくらい前から"}, {"type": "subtitle", "time": 14000.87, "timestamp": "03:53:20", "text": "えっと、どれくらい"}, {"type": "subtitle", "time": 14002.99, "timestamp": "03:53:22", "text": "プレイしました。プレイしました"}, {"type": "subtitle", "time": 14005.91, "timestamp": "03:53:25", "text": "長年にわたって。うん。少なくともそれ以上"}, {"type": "subtitle", "time": 14026.469, "timestamp": "03:53:46", "text": "地面と街を利用しなければならない"}, {"type": "subtitle", "time": 14028.75, "timestamp": "03:53:48", "text": "あなたの"}, {"type": "subtitle", "time": 14036.71, "timestamp": "03:53:56", "text": "次のことに。私たちには10分しか時間がなかった。"}, {"type": "subtitle", "time": 14038.229, "timestamp": "03:53:58", "text": "10分が経過しました。セットアップします"}]
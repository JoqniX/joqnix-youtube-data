[{"type": "subtitle", "time": 4020.87, "timestamp": "01:07:00", "text": "ギアは、まるで離陸するように作動する。"}, {"type": "subtitle", "time": 4022.71, "timestamp": "01:07:02", "text": "着陸装置がない"}, {"type": "subtitle", "time": 4025.349, "timestamp": "01:07:05", "text": "その飛行機の中で変化が起こった。だから、"}, {"type": "subtitle", "time": 4028.39, "timestamp": "01:07:08", "text": "つまり、フラップしか変更できなかったということです。あなた"}, {"type": "subtitle", "time": 4032.23, "timestamp": "01:07:12", "text": "航空機にフラップを装備してください。おお、"}, {"type": "subtitle", "time": 4034.15, "timestamp": "01:07:14", "text": "それでは、それらを順を追って説明しましょう。"}, {"type": "subtitle", "time": 4037.91, "timestamp": "01:07:17", "text": "良い。えっと、あなたは言ってましたね。ええ、あなたは言っていましたね。"}, {"type": "subtitle", "time": 4040.63, "timestamp": "01:07:20", "text": "何について言っているのですか？雷。いいえ、ワールドオブ"}, {"type": "subtitle", "time": 4042.71, "timestamp": "01:07:22", "text": "軍艦。ワールド・オブ・ウォーシップス。うん。それで、"}, {"type": "subtitle", "time": 4045.99, "timestamp": "01:07:25", "text": "World of WarshipsはIから唯一のものです"}, {"type": "subtitle", "time": 4047.789, "timestamp": "01:07:27", "text": "会社名は"}, {"type": "subtitle", "time": 4050.15, "timestamp": "01:07:30", "text": "ウォーゲーム。 World of Warshipsは"}, {"type": "subtitle", "time": 4053.91, "timestamp": "01:07:33", "text": "他のゲームの中で私が唯一好むのは"}, {"type": "subtitle", "time": 4056.95, "timestamp": "01:07:36", "text": "War Thunder で会社が"}, {"type": "subtitle", "time": 4060.63, "timestamp": "01:07:40", "text": "艦船同士の戦闘は非常に優れている。"}, {"type": "subtitle", "time": 4063.029, "timestamp": "01:07:43", "text": "だから、これらの大規模な世界大戦に参加することができます"}, {"type": "subtitle", "time": 4065.15, "timestamp": "01:07:45", "text": "II 戦艦と"}, {"type": "subtitle", "time": 4069.349, "timestamp": "01:07:49", "text": "都市ほどの大きさの駆逐艦。"}, {"type": "subtitle", "time": 4073.349, "timestamp": "01:07:53", "text": "おお、それに正確に狙いを定めることもできるんですね。その"}, {"type": "subtitle", "time": 4076.43, "timestamp": "01:07:56", "text": "比較的現実的。続いて"}, {"type": "subtitle", "time": 4079.47, "timestamp": "01:07:59", "text": "かつて起こっていたことの物理学"}]
[{"type": "subtitle", "time": 2160.15, "timestamp": "00:36:00", "text": "オーバーロード8Gとかいうやつ。"}, {"type": "subtitle", "time": 2163.67, "timestamp": "00:36:03", "text": "ああ、それは8Gだよ、気絶するよ。つまり9G"}, {"type": "subtitle", "time": 2166.63, "timestamp": "00:36:06", "text": "そこであなたは気を失うでしょう。ああ、重力"}, {"type": "subtitle", "time": 2170.23, "timestamp": "00:36:10", "text": "力。あなたはとても激しく回転しているので、はい。"}, {"type": "subtitle", "time": 2172.55, "timestamp": "00:36:12", "text": "パイロットが押し下げられています"}, {"type": "subtitle", "time": 2174.31, "timestamp": "00:36:14", "text": "飛行機。血はすべて"}, {"type": "subtitle", "time": 2178.069, "timestamp": "00:36:18", "text": "彼らの脳。それは確かに存在する。"}, {"type": "subtitle", "time": 2181.51, "timestamp": "00:36:21", "text": "うん。わかった。ええと、説明させてください。科学"}, {"type": "subtitle", "time": 2184.23, "timestamp": "00:36:24", "text": "富士山と過ごす時間。それで、"}, {"type": "subtitle", "time": 2186.31, "timestamp": "00:36:26", "text": "重力は、あなたが乗っているときに働くものです。"}, {"type": "subtitle", "time": 2189.51, "timestamp": "00:36:29", "text": "地球よ、君はユニット1を体験する。"}, {"type": "subtitle", "time": 2190.95, "timestamp": "00:36:30", "text": "地球の100倍の体験を"}, {"type": "subtitle", "time": 2193.19, "timestamp": "00:36:33", "text": "重力。"}, {"type": "subtitle", "time": 2195.43, "timestamp": "00:36:35", "text": "火星のような惑星に行くと、"}, {"type": "subtitle", "time": 2198.63, "timestamp": "00:36:38", "text": "経験は、おそらく1つで、"}, {"type": "subtitle", "time": 2200.349, "timestamp": "00:36:40", "text": "半分"}, {"type": "subtitle", "time": 2203.19, "timestamp": "00:36:43", "text": "二。木星に行けば、"}, {"type": "subtitle", "time": 2204.95, "timestamp": "00:36:44", "text": "立ち上がることができる。想像してみて"}, {"type": "subtitle", "time": 2209.43, "timestamp": "00:36:49", "text": "木星には、ご存知の通り、固い陸地があるんです。"}, {"type": "subtitle", "time": 2211.589, "timestamp": "00:36:51", "text": "絶対にできない"}, {"type": "subtitle", "time": 2213.589, "timestamp": "00:36:53", "text": "立ち上がる。まるであなたがそんなことをしないかのように"}, {"type": "subtitle", "time": 2215.67, "timestamp": "00:36:55", "text": "座ることができる。あなたはただ"}, {"type": "subtitle", "time": 2218.39, "timestamp": "00:36:58", "text": "床に押しつぶされていた。"}]
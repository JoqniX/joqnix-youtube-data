[{"type": "subtitle", "time": 2943.51, "timestamp": "00:49:03", "text": "副武器"}, {"type": "subtitle", "time": 2947.43, "timestamp": "00:49:07", "text": "7mm機関銃を装着。私"}, {"type": "subtitle", "time": 2949.51, "timestamp": "00:49:09", "text": "二次的な機能はありません。わかった。使用"}, {"type": "subtitle", "time": 2952.109, "timestamp": "00:49:12", "text": "肌いっぱい"}, {"type": "subtitle", "time": 2960.03, "timestamp": "00:49:20", "text": "もの。敵の拠点を占領する"}, {"type": "subtitle", "time": 2971.27, "timestamp": "00:49:31", "text": "あなた？ああ、もしかしたら捨てることもできるかも"}, {"type": "subtitle", "time": 2978.27, "timestamp": "00:49:38", "text": "さあ"}, {"type": "subtitle", "time": 2981.27, "timestamp": "00:49:41", "text": "見る。技術的には、少し"}, {"type": "subtitle", "time": 2985.829, "timestamp": "00:49:45", "text": "基本性能の点で、より優れた航空機。"}, {"type": "subtitle", "time": 2988.15, "timestamp": "00:49:48", "text": "ああ、これは高級品ですね。どうすればいいのかわからない"}, {"type": "subtitle", "time": 2990.95, "timestamp": "00:49:50", "text": "私も手に入れました。"}, {"type": "subtitle", "time": 2992.549, "timestamp": "00:49:52", "text": "最初は1つもらえると思います。わかった。"}, {"type": "subtitle", "time": 2996.15, "timestamp": "00:49:56", "text": "あなたは私に会います？赤色。"}, {"type": "subtitle", "time": 2998.71, "timestamp": "00:49:58", "text": "何てことだ。はい。"}]
[{"type": "subtitle", "time": 14160.07, "timestamp": "03:56:00", "text": "君を迎えに行くよ。"}, {"type": "subtitle", "time": 14162.87, "timestamp": "03:56:02", "text": "派閥に加わる。あーすみません、飛行隊と"}, {"type": "subtitle", "time": 14164.55, "timestamp": "03:56:04", "text": "そして、そのままプレイを続けてください。普通に保管する"}, {"type": "subtitle", "time": 14166.469, "timestamp": "03:56:06", "text": "プレイ中。おお、いいね。あなたは"}, {"type": "subtitle", "time": 14170.79, "timestamp": "03:56:10", "text": "ミサイル。ニース。そして、私は推進できません"}, {"type": "subtitle", "time": 14174.15, "timestamp": "03:56:14", "text": "ダメージ。ニース。ああ、そうなんですか？しかたがない、"}, {"type": "subtitle", "time": 14179.83, "timestamp": "03:56:19", "text": "1つ。すばらしい。はい、どうぞ。あなたは"}, {"type": "subtitle", "time": 14192.389, "timestamp": "03:56:32", "text": "何てことだ。"}, {"type": "subtitle", "time": 14195.03, "timestamp": "03:56:35", "text": "ほら、あなたにはそれだけのものがあるんだよ"}, {"type": "subtitle", "time": 14196.71, "timestamp": "03:56:36", "text": "それら３発のミサイル。もし可能であれば"}, {"type": "subtitle", "time": 14199.189, "timestamp": "03:56:39", "text": "建物の裏に隠れて、可能であれば"}, {"type": "subtitle", "time": 14202.79, "timestamp": "03:56:42", "text": "ターゲットに近づける位置に"}, {"type": "subtitle", "time": 14206.309, "timestamp": "03:56:46", "text": "ジェット戦闘機、それを受け取れ。"}, {"type": "subtitle", "time": 14207.59, "timestamp": "03:56:47", "text": "おお。"}, {"type": "subtitle", "time": 14209.75, "timestamp": "03:56:49", "text": "街の中に潜り込んで隠れなければならない"}, {"type": "subtitle", "time": 14212.79, "timestamp": "03:56:52", "text": "建物の中で。そうでなければ、"}, {"type": "subtitle", "time": 14215.75, "timestamp": "03:56:55", "text": "勝つチャンス。"}, {"type": "subtitle", "time": 14217.83, "timestamp": "03:56:57", "text": "そして、それでも、あなたは入っていき、"}, {"type": "subtitle", "time": 14219.03, "timestamp": "03:56:59", "text": "決して出てこないだろう。あなたがしなければならない"}]
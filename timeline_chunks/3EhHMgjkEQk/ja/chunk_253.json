[{"type": "subtitle", "time": 15180.91, "timestamp": "04:13:00", "text": "遊ぶ。"}, {"type": "subtitle", "time": 15184.87, "timestamp": "04:13:04", "text": "プレイするか、実際のお金を投入するかのどちらかです。そしてもし"}, {"type": "subtitle", "time": 15186.229, "timestamp": "04:13:06", "text": "実際のお金を投入すれば、"}, {"type": "subtitle", "time": 15187.51, "timestamp": "04:13:07", "text": "飛行隊とか、何でもいいよ。あなたもそうするべき"}, {"type": "subtitle", "time": 15190.229, "timestamp": "04:13:10", "text": "飛行機をそのまま買えばいい。どうやって"}, {"type": "subtitle", "time": 15192.389, "timestamp": "04:13:12", "text": "いくらですか？"}, {"type": "subtitle", "time": 15195.87, "timestamp": "04:13:15", "text": "えーっと、通常は30ドルから"}, {"type": "subtitle", "time": 15199.55, "timestamp": "04:13:19", "text": "80米ドル。"}, {"type": "subtitle", "time": 15205.03, "timestamp": "04:13:25", "text": "7,900ドルですよね？うん。飛行機1機あたりおおよそ。"}, {"type": "subtitle", "time": 15208.389, "timestamp": "04:13:28", "text": "それはまるで、ああ、"}, {"type": "subtitle", "time": 15214.11, "timestamp": "04:13:34", "text": "神。"}, {"type": "subtitle", "time": 15221.429, "timestamp": "04:13:41", "text": "ええ、高レベルの飛行機を手に入れることができます"}, {"type": "subtitle", "time": 15223.83, "timestamp": "04:13:43", "text": "そして、この機種には低レベルの高級機も含まれている。"}, {"type": "subtitle", "time": 15233.03, "timestamp": "04:13:53", "text": "チャット、ジョックは偽ゲーマーだ。彼は"}, {"type": "subtitle", "time": 15234.59, "timestamp": "04:13:54", "text": "すぐに消えた"}, {"type": "subtitle", "time": 15237.99, "timestamp": "04:13:57", "text": "勝つためにお金を払え。彼はすぐに"}]
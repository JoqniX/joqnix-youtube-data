[{"type": "subtitle", "time": 12780.79, "timestamp": "03:33:00", "text": "どこ？下へ降りてください。本当に近くを飛んで"}, {"type": "subtitle", "time": 12781.75, "timestamp": "03:33:01", "text": "地面。それが唯一の方法です"}, {"type": "subtitle", "time": 12785.83, "timestamp": "03:33:05", "text": "それを避けるべきだ。でも、ああ、なんてことだ。どこで"}, {"type": "subtitle", "time": 12789.349, "timestamp": "03:33:09", "text": "はぁ？私はあなたより上だった。"}, {"type": "subtitle", "time": 12791.269, "timestamp": "03:33:11", "text": "わかった。もう一機飛行機はありますか？うん、"}, {"type": "subtitle", "time": 12793.67, "timestamp": "03:33:13", "text": "飛行機が3機。はい、素晴らしい。素晴らしい。"}, {"type": "subtitle", "time": 12795.429, "timestamp": "03:33:15", "text": "今回は私が手順を説明します。病気"}, {"type": "subtitle", "time": 12797.83, "timestamp": "03:33:17", "text": "視界が確保されていることを確認してください。私がやったのか"}, {"type": "subtitle", "time": 12801.59, "timestamp": "03:33:21", "text": "金色のものを購入しますか？だから私は"}, {"type": "subtitle", "time": 12804.71, "timestamp": "03:33:24", "text": "6つのスロット。金色"}, {"type": "subtitle", "time": 12806.79, "timestamp": "03:33:26", "text": "あなたが持っているものは、おそらく"}, {"type": "subtitle", "time": 12810.79, "timestamp": "03:33:30", "text": "無料。あなたは実際のお金を投入していません。"}, {"type": "subtitle", "time": 12813.19, "timestamp": "03:33:33", "text": "うん。何かを購入した場合、"}, {"type": "subtitle", "time": 12815.11, "timestamp": "03:33:35", "text": "ゲーム内通貨で。あなたはそれを購入しました"}, {"type": "subtitle", "time": 12818.469, "timestamp": "03:33:38", "text": "ともかく。わかった。さあ、少し上を見上げて"}, {"type": "subtitle", "time": 12822.55, "timestamp": "03:33:42", "text": "あなたの目の前に。私が見えますか？"}, {"type": "subtitle", "time": 12825.91, "timestamp": "03:33:45", "text": "いいえ。わかりました。さて、何か見えますか？"}, {"type": "subtitle", "time": 12833.67, "timestamp": "03:33:53", "text": "空気？オレンジ色や黄色の線が見えますか？"}, {"type": "subtitle", "time": 12835.429, "timestamp": "03:33:55", "text": "いいえ。"}, {"type": "subtitle", "time": 12837.99, "timestamp": "03:33:57", "text": "ああ、それなら私は本当に遠くにいるんですね。何"}, {"type": "subtitle", "time": 12839.63, "timestamp": "03:33:59", "text": "えっ？"}]
[{"type": "subtitle", "time": 3122.71, "timestamp": "00:52:02", "text": "さあ、あなたも試してみたくなるでしょう。だからあなたが"}, {"type": "subtitle", "time": 3125.27, "timestamp": "00:52:05", "text": "君は回転しているみたいだね、君は"}, {"type": "subtitle", "time": 3128.549, "timestamp": "00:52:08", "text": "オーバーロードのやつを手に入れる？ええと、"}, {"type": "subtitle", "time": 3130.47, "timestamp": "00:52:10", "text": "これらの航空機は、"}, {"type": "subtitle", "time": 3137.109, "timestamp": "00:52:17", "text": "それ。一般的にはもっと"}, {"type": "subtitle", "time": 3139.109, "timestamp": "00:52:19", "text": "より速く、より"}, {"type": "subtitle", "time": 3141.309, "timestamp": "00:52:21", "text": "鈍重な航空機"}, {"type": "subtitle", "time": 3144.23, "timestamp": "00:52:24", "text": "振り向く。これらの航空機は"}, {"type": "subtitle", "time": 3146.309, "timestamp": "00:52:26", "text": "比較的ゆっくりとして、かなり"}, {"type": "subtitle", "time": 3149.829, "timestamp": "00:52:29", "text": "良い。だから、比較的難しいんです。のために"}, {"type": "chat", "time": 3151.18, "timestamp": "00:52:31", "author": "@soulofswords", "avatar": "https://yt4.ggpht.com/N5UGOOCkqJY6i3x846X2nx9EjZpP3SAIdAeuPAjxPPdNLWmO1Oi53_c__BkFrKVpJqviVQ07=s64-c-k-c0x00ffffff-no-rj", "message": "ohh fuji san"}, {"type": "subtitle", "time": 3152.069, "timestamp": "00:52:32", "text": "例えば、私たちのパイロットはどちらも"}, {"type": "subtitle", "time": 3154.43, "timestamp": "00:52:34", "text": "このような同封物"}, {"type": "subtitle", "time": 3156.549, "timestamp": "00:52:36", "text": "コックピット。彼らはただ外に座っている"}, {"type": "subtitle", "time": 3159.67, "timestamp": "00:52:39", "text": "屋外ですよね？"}, {"type": "subtitle", "time": 3161.589, "timestamp": "00:52:41", "text": "ちょっと"}, {"type": "subtitle", "time": 3164.67, "timestamp": "00:52:44", "text": "ああ、開いてるよ。本当に経験豊富"}, {"type": "subtitle", "time": 3173.19, "timestamp": "00:52:53", "text": "着陸を試してみますか？うん。"}]
[{"type": "subtitle", "time": 4680.43, "timestamp": "01:18:00", "text": "その時が来た"}, {"type": "subtitle", "time": 4684.07, "timestamp": "01:18:04", "text": "死ぬ。 Bを取得する時間を取得する時間。いいえ。"}, {"type": "subtitle", "time": 4686.11, "timestamp": "01:18:06", "text": "爆破された"}, {"type": "subtitle", "time": 4691.11, "timestamp": "01:18:11", "text": "プレイヤーのレベルを上げる方法を教えてください。"}, {"type": "subtitle", "time": 4694.149, "timestamp": "01:18:14", "text": "えっと、それは単なるマッチングです。手に入れる"}, {"type": "subtitle", "time": 4697.39, "timestamp": "01:18:17", "text": "お金に加えてXPも手に入ります。"}, {"type": "subtitle", "time": 4701.189, "timestamp": "01:18:21", "text": "XP。ああ"}, {"type": "subtitle", "time": 4704.79, "timestamp": "01:18:24", "text": "だからゲームをプレイして、"}, {"type": "subtitle", "time": 4707.669, "timestamp": "01:18:27", "text": "どれだけ上手くプレイしたか、"}, {"type": "subtitle", "time": 4710.43, "timestamp": "01:18:30", "text": "ゲーム内でのそのためのアルゴリズム。手に入れる"}, {"type": "subtitle", "time": 4712.95, "timestamp": "01:18:32", "text": "XP。では、あなたがちょうど飛行機に乗っていたとしましょう。"}, {"type": "subtitle", "time": 4715.27, "timestamp": "01:18:35", "text": "まっすぐ進んで、誰かがちょうど"}, {"type": "subtitle", "time": 4717.51, "timestamp": "01:18:37", "text": "あなたの目の前にいて、あなたはそれらを取り除いた。あなた"}, {"type": "subtitle", "time": 4719.99, "timestamp": "01:18:39", "text": "彼らを撃った。"}, {"type": "subtitle", "time": 4723.189, "timestamp": "01:18:43", "text": "そうすると、得られるものが少なくなります。例えば"}, {"type": "subtitle", "time": 4724.79, "timestamp": "01:18:44", "text": "君はまるで向きを変えているかのように戦っていた"}, {"type": "subtitle", "time": 4726.149, "timestamp": "01:18:46", "text": "まるで君が僕と一緒に回転しているみたいだった。あなたは"}, {"type": "subtitle", "time": 4727.709, "timestamp": "01:18:47", "text": "絶えず回転している。あなたは常に"}, {"type": "subtitle", "time": 4730.39, "timestamp": "01:18:50", "text": "戦い始めて1分ほど経って"}, {"type": "subtitle", "time": 4733.189, "timestamp": "01:18:53", "text": "この人と戦って、あなたは彼らを連れて行った"}, {"type": "subtitle", "time": 4736.55, "timestamp": "01:18:56", "text": "下。そうすれば、XPがもっとたくさん手に入ります。"}, {"type": "subtitle", "time": 4738.63, "timestamp": "01:18:58", "text": "ゲームはあなたが実際に多くのものを投入したことを認識します"}]
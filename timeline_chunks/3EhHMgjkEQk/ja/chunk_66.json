[{"type": "subtitle", "time": 3961.87, "timestamp": "01:06:01", "text": "えーと、ソウルも、ワールドオブ"}, {"type": "subtitle", "time": 3963.87, "timestamp": "01:06:03", "text": "軍艦。それは何年も前のことだ。"}, {"type": "subtitle", "time": 3966.23, "timestamp": "01:06:06", "text": "けれど。おお。"}, {"type": "subtitle", "time": 3969.19, "timestamp": "01:06:09", "text": "結果的に非常に遅くなった"}, {"type": "subtitle", "time": 3975.75, "timestamp": "01:06:15", "text": "ゲームプレイ。えっと、ジョック、どこにいるの？何"}, {"type": "subtitle", "time": 3977.51, "timestamp": "01:06:17", "text": "何が起こったのか？もう行かなくちゃ。あなたは"}, {"type": "subtitle", "time": 3982.309, "timestamp": "01:06:22", "text": "離陸する。ああ、W。ああ、待って。"}, {"type": "subtitle", "time": 3985.15, "timestamp": "01:06:25", "text": "ゲームはあなたをカウントしています"}, {"type": "subtitle", "time": 3987.589, "timestamp": "01:06:27", "text": "存在しない。 2回で勝つかもしれない"}, {"type": "subtitle", "time": 3991.27, "timestamp": "01:06:31", "text": "秒。あ、待って。私たちは負けた。うん、君"}, {"type": "subtitle", "time": 3993.27, "timestamp": "01:06:33", "text": "離陸しなかった。"}, {"type": "subtitle", "time": 3995.99, "timestamp": "01:06:35", "text": "ああ、そういうこともあるんですね。いいえ、大丈夫です。"}, {"type": "subtitle", "time": 3999.349, "timestamp": "01:06:39", "text": "やり直せばいいだけです。えっと、最初に"}, {"type": "subtitle", "time": 4002.15, "timestamp": "01:06:42", "text": "トレーニングが始まったとき、"}, {"type": "subtitle", "time": 4004.87, "timestamp": "01:06:44", "text": "何かを押したら"}, {"type": "subtitle", "time": 4006.91, "timestamp": "01:06:46", "text": "離陸モードを変更して"}, {"type": "subtitle", "time": 4010.15, "timestamp": "01:06:50", "text": "すべて。それは何ですか？そうだった"}, {"type": "subtitle", "time": 4012.789, "timestamp": "01:06:52", "text": "モードを変更します。何だったのか"}, {"type": "subtitle", "time": 4016.069, "timestamp": "01:06:56", "text": "画面上で変更していますか？着陸みたいに"}]
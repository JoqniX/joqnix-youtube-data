[{"type": "subtitle", "time": 1922.31, "timestamp": "00:32:02", "text": "本当に完全に理解した"}, {"type": "subtitle", "time": 1924.789, "timestamp": "00:32:04", "text": "コンソール。楽しいけど、私にはできない"}, {"type": "subtitle", "time": 1936.789, "timestamp": "00:32:16", "text": "あなたはゲーム機が好きですか？平均"}, {"type": "subtitle", "time": 1938.87, "timestamp": "00:32:18", "text": "ゲーム機好きですか？"}, {"type": "subtitle", "time": 1941.909, "timestamp": "00:32:21", "text": "私はゲーム機を一度も持っていませんでした。いいえ、私が"}, {"type": "subtitle", "time": 1944.71, "timestamp": "00:32:24", "text": "うん、PC優位を目指して行こう。うん。"}, {"type": "subtitle", "time": 1950.59, "timestamp": "00:32:30", "text": "えーっと、私が持っていた時"}, {"type": "subtitle", "time": 1954.75, "timestamp": "00:32:34", "text": "えっと、なんて言うんだっけ？"}, {"type": "subtitle", "time": 1958.149, "timestamp": "00:32:38", "text": "えっと、あのジョイスティックみたいなやつ"}, {"type": "subtitle", "time": 1960.71, "timestamp": "00:32:40", "text": "PCに接続するもの"}, {"type": "subtitle", "time": 1963.509, "timestamp": "00:32:43", "text": "CDディスクか何かを入れると"}, {"type": "subtitle", "time": 1966.389, "timestamp": "00:32:46", "text": "古いゲーム機か何かですよね？おお、"}, {"type": "subtitle", "time": 1969.509, "timestamp": "00:32:49", "text": "わかった。私は、あなたがプレイするようなものを持っていました"}, {"type": "subtitle", "time": 1972.23, "timestamp": "00:32:52", "text": "アヒルの手とか、そういうやつだよね？"}, {"type": "subtitle", "time": 1974.99, "timestamp": "00:32:54", "text": "ああ、私もそれを持っていた"}, {"type": "subtitle", "time": 1978.149, "timestamp": "00:32:58", "text": "もの。しかし"}]
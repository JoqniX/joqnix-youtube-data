[{"type": "subtitle", "time": 12242.15, "timestamp": "03:24:02", "text": "Okay,"}, {"type": "subtitle", "time": 12244.87, "timestamp": "03:24:04", "text": "now I'm already quite slow, so this"}, {"type": "subtitle", "time": 12254.15, "timestamp": "03:24:14", "text": "Damn, you have a jet. How long did you"}, {"type": "subtitle", "time": 12262.55, "timestamp": "03:24:22", "text": "Wait, it's out of control. But I'm not"}, {"type": "chat", "time": 12270.929, "timestamp": "03:24:30", "author": "@BRUCELEE-wt7hk", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kywKa6HSckNVxhER8qedLRRVkcGIqFFytjQHe-071HyMo=s64-c-k-c0x00ffffff-no-rj", "message": "flying in the plane"}, {"type": "subtitle", "time": 12275.67, "timestamp": "03:24:35", "text": "Now, generally when jet fighters dog"}, {"type": "subtitle", "time": 12277.91, "timestamp": "03:24:37", "text": "fight with propellers, they can't stay"}, {"type": "subtitle", "time": 12281.269, "timestamp": "03:24:41", "text": "as slow as the propeller planes, right?"}, {"type": "subtitle", "time": 12282.71, "timestamp": "03:24:42", "text": "But when we hit this forget physics"}, {"type": "chat", "time": 12284.96, "timestamp": "03:24:44", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "its a bait"}, {"type": "chat", "time": 12287.509, "timestamp": "03:24:47", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Bread Guy?~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}]
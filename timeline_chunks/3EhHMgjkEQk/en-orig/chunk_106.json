[{"type": "subtitle", "time": 6360.31, "timestamp": "01:46:00", "text": "And always keep an eye behind you."}, {"type": "subtitle", "time": 6361.91, "timestamp": "01:46:01", "text": "Cuz while you're shooting somebody,"}, {"type": "subtitle", "time": 6372.31, "timestamp": "01:46:12", "text": "Gotcha. Maybe both are teams, right?"}, {"type": "subtitle", "time": 6374.189, "timestamp": "01:46:14", "text": "Same team, right? Yeah, we are in the"}, {"type": "subtitle", "time": 6377.75, "timestamp": "01:46:17", "text": "same. This is an actual map, so I won't"}, {"type": "subtitle", "time": 6380.709, "timestamp": "01:46:20", "text": "be in the opposing team almost ever."}, {"type": "subtitle", "time": 6383.35, "timestamp": "01:46:23", "text": "Holy Lord, that's a lot of planes."}, {"type": "subtitle", "time": 6385.27, "timestamp": "01:46:25", "text": "Yeah. So, if you turn around and look"}, {"type": "subtitle", "time": 6388.79, "timestamp": "01:46:28", "text": "behind you, you see enemy teams planes"}, {"type": "subtitle", "time": 6390.629, "timestamp": "01:46:30", "text": "in red, you see your own teammates in"}, {"type": "subtitle", "time": 6399.03, "timestamp": "01:46:39", "text": "That's the identifier of like the person"}, {"type": "subtitle", "time": 6401.35, "timestamp": "01:46:41", "text": "you're playing with."}, {"type": "subtitle", "time": 6403.91, "timestamp": "01:46:43", "text": "Now, if you climb high up, generally"}, {"type": "subtitle", "time": 6405.31, "timestamp": "01:46:45", "text": "those planes are"}, {"type": "subtitle", "time": 6407.669, "timestamp": "01:46:47", "text": "bombers. If you don't go head on,"}, {"type": "subtitle", "time": 6410.229, "timestamp": "01:46:50", "text": "they're easy to shoot. If you go down,"}, {"type": "subtitle", "time": 6413.27, "timestamp": "01:46:53", "text": "you get in good fight."}, {"type": "subtitle", "time": 6416.149, "timestamp": "01:46:56", "text": "And be very careful with head-ons."}, {"type": "subtitle", "time": 6418.47, "timestamp": "01:46:58", "text": "I I got damaged. I'm heading back to"}]
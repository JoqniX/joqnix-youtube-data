[{"type": "subtitle", "time": 8942.63, "timestamp": "02:29:02", "text": "So, he tried to shoot at us first. That"}, {"type": "subtitle", "time": 8945.51, "timestamp": "02:29:05", "text": "didn't work. So, he tried to ram us. If"}, {"type": "subtitle", "time": 8947.75, "timestamp": "02:29:07", "text": "you ram into the other person, it"}, {"type": "subtitle", "time": 8950.15, "timestamp": "02:29:10", "text": "doesn't show up as a team kill. That's"}, {"type": "subtitle", "time": 8963.79, "timestamp": "02:29:23", "text": "Where? Oh, okay. Let's go."}, {"type": "subtitle", "time": 8972.469, "timestamp": "02:29:32", "text": "Nimrod. Nimrod is a very iconic um one"}, {"type": "subtitle", "time": 8975.99, "timestamp": "02:29:35", "text": "of the first, you know, semi- new age"}, {"type": "subtitle", "time": 8978.309, "timestamp": "02:29:38", "text": "British planes."}, {"type": "subtitle", "time": 8999.03, "timestamp": "02:29:59", "text": "him. Nice teamwork. And we won already."}]
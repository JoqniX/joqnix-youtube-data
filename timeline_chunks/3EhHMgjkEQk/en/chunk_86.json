[{"type": "subtitle", "time": 5160.31, "timestamp": "01:26:00", "text": "So, you see those red dots on the"}, {"type": "subtitle", "time": 5163.35, "timestamp": "01:26:03", "text": "ground, right? Yes. They are anti-air"}, {"type": "subtitle", "time": 5165.43, "timestamp": "01:26:05", "text": "systems. Don't go straight at it. It'll"}, {"type": "subtitle", "time": 5168.87, "timestamp": "01:26:08", "text": "shoot you up. Turn away from it."}, {"type": "subtitle", "time": 5171.669, "timestamp": "01:26:11", "text": "Now the way you can avoid it is point"}, {"type": "subtitle", "time": 5174.11, "timestamp": "01:26:14", "text": "towards it and fly"}, {"type": "subtitle", "time": 5183.669, "timestamp": "01:26:23", "text": "up. Now generally on the left you'll see"}, {"type": "subtitle", "time": 5187.11, "timestamp": "01:26:27", "text": "the warning. Yeah."}, {"type": "subtitle", "time": 5189.43, "timestamp": "01:26:29", "text": "So the right is your radar, the left is"}, {"type": "subtitle", "time": 5191.51, "timestamp": "01:26:31", "text": "your warning."}, {"type": "subtitle", "time": 5193.99, "timestamp": "01:26:33", "text": "Now on the left corner of your screen,"}, {"type": "subtitle", "time": 5196.229, "timestamp": "01:26:36", "text": "bottom corner, you see red dots in the"}, {"type": "subtitle", "time": 5199.59, "timestamp": "01:26:39", "text": "sky. Turn towards the left."}, {"type": "subtitle", "time": 5201.669, "timestamp": "01:26:41", "text": "Red dots. I think you see red dots in"}, {"type": "subtitle", "time": 5204.31, "timestamp": "01:26:44", "text": "the sky. Ah, you weren't high enough."}, {"type": "subtitle", "time": 5209.35, "timestamp": "01:26:49", "text": "If you want to test out your missiles,"}, {"type": "subtitle", "time": 5211.189, "timestamp": "01:26:51", "text": "you have to go towards those planes."}, {"type": "subtitle", "time": 5214.229, "timestamp": "01:26:54", "text": "Now, turn to the left. Sharp left. Sharp"}, {"type": "subtitle", "time": 5217.91, "timestamp": "01:26:57", "text": "left. Yep. Yeah. Those lines. Yeah. Yes."}]
[{"type": "subtitle", "time": 11160.07, "timestamp": "03:06:00", "text": "to shoot. Yeah."}, {"type": "subtitle", "time": 11161.67, "timestamp": "03:06:01", "text": "How do you think they avoided shooting"}, {"type": "subtitle", "time": 11168.71, "timestamp": "03:06:08", "text": "Uh, they positioned it in a way that it"}, {"type": "subtitle", "time": 11171.75, "timestamp": "03:06:11", "text": "won't shoot."}, {"type": "subtitle", "time": 11173.349, "timestamp": "03:06:13", "text": "No, it was placed right behind the"}, {"type": "subtitle", "time": 11175.51, "timestamp": "03:06:15", "text": "propeller. So, it was shooting at the"}, {"type": "subtitle", "time": 11178.71, "timestamp": "03:06:18", "text": "propeller. They elevated it."}, {"type": "subtitle", "time": 11181.349, "timestamp": "03:06:21", "text": "No, they didn't. If they elevated it,"}, {"type": "subtitle", "time": 11182.63, "timestamp": "03:06:22", "text": "the pilot wouldn't be able to see"}, {"type": "subtitle", "time": 11184.07, "timestamp": "03:06:24", "text": "anything. They would have to elevate the"}, {"type": "subtitle", "time": 11187.03, "timestamp": "03:06:27", "text": "pilot as well. That wouldn't make a very"}, {"type": "subtitle", "time": 11189.99, "timestamp": "03:06:29", "text": "aerodynamic plane."}, {"type": "subtitle", "time": 11191.51, "timestamp": "03:06:31", "text": "I mean, you flew the Japanese plane,"}, {"type": "subtitle", "time": 11196.79, "timestamp": "03:06:36", "text": "It had the guns between the propeller"}, {"type": "chat", "time": 11198.193, "timestamp": "03:06:38", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "WOAH"}, {"type": "subtitle", "time": 11199.03, "timestamp": "03:06:39", "text": "and the pilot."}, {"type": "subtitle", "time": 11208.95, "timestamp": "03:06:48", "text": "Is this the correct thingy? You have to"}, {"type": "subtitle", "time": 11210.23, "timestamp": "03:06:50", "text": "point at the ship. You're pointing away"}, {"type": "subtitle", "time": 11212.79, "timestamp": "03:06:52", "text": "from the ship."}, {"type": "subtitle", "time": 11215.79, "timestamp": "03:06:55", "text": "A little bit higher. Point your nose"}, {"type": "subtitle", "time": 11218.75, "timestamp": "03:06:58", "text": "up. There we go."}]
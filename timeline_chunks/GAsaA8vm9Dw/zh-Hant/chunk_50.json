[{"type": "subtitle", "time": 3017.27, "timestamp": "00:50:17", "text": "樂高。  沒關係。  我的天哪。為什麼會這樣呢？  巴克的技能。  [音樂] 史詩級。讓我們向他們展示我們是誰。"}, {"type": "subtitle", "time": 3036.15, "timestamp": "00:50:36", "text": "亂七八糟的東西嗎？  又一次當面戳到"}, {"type": "subtitle", "time": 3038.95, "timestamp": "00:50:38", "text": "我臉上了。  不，我他媽討厭這個遊戲。"}, {"type": "subtitle", "time": 3043.67, "timestamp": "00:50:43", "text": "手榴彈正中"}, {"type": "subtitle", "time": 3045.91, "timestamp": "00:50:45", "text": "我的臉。  那他媽是什麼"}]
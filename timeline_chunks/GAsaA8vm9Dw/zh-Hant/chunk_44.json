[{"type": "subtitle", "time": 2640.39, "timestamp": "00:44:00", "text": "我不知道為什麼我比「是啊」做得更好。你好"}, {"type": "subtitle", "time": 2660.87, "timestamp": "00:44:20", "text": "，布拉德。歡迎。  希望你一切都好。  那傢伙殺了多少人？我"}, {"type": "subtitle", "time": 2666.309, "timestamp": "00:44:26", "text": "怎麼可能比那個只有八個擊殺數的人做得更好"}, {"type": "subtitle", "time": 2676.069, "timestamp": "00:44:36", "text": "？看看排行榜。是的。  我的天啊。  哦，"}, {"type": "subtitle", "time": 2679.91, "timestamp": "00:44:39", "text": "絕對不行。你好。你好。如果對方嘗試，你就應該打開麥克風"}, {"type": "subtitle", "time": 2695.03, "timestamp": "00:44:55", "text": "繼續。"}]
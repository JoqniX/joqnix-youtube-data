[{"type": "subtitle", "time": 21967.35, "timestamp": "06:06:07", "text": "真是太好了。張開嘴巴的"}, {"type": "subtitle", "time": 21983.83, "timestamp": "06:06:23", "text": "恨我。一個不錯的掩體。  哦，忍者，聽到這個消息我很難過。  每個人都有自己的感受和觀點，但始終要以友善和尊重的態度對待他人"}, {"type": "subtitle", "time": 21988.788, "timestamp": "06:06:28", "text": "。  微笑"}, {"type": "subtitle", "time": 22006.628, "timestamp": "06:06:46", "text": "我摔倒了。"}, {"type": "subtitle", "time": 22009.03, "timestamp": "06:06:49", "text": "這真有趣。弗洛里安"}]
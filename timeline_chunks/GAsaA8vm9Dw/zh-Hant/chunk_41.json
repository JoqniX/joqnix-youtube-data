[{"type": "subtitle", "time": 2466.069, "timestamp": "00:41:06", "text": "好的。"}, {"type": "subtitle", "time": 2471.67, "timestamp": "00:41:11", "text": "哦，他去世了嗎？"}, {"type": "subtitle", "time": 2477.43, "timestamp": "00:41:17", "text": "愛因斯坦可以解釋。  我被一顆該死的青蛙"}, {"type": "subtitle", "time": 2490.39, "timestamp": "00:41:30", "text": "手榴彈炸死了。  我的天啊。我真是太糟糕了。  老兄，我他媽的太糟糕了，誘餌都用完了"}, {"type": "subtitle", "time": 2492.63, "timestamp": "00:41:32", "text": "。你知道嗎？我只想當個水手。"}]
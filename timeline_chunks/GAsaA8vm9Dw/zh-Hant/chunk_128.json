[{"type": "subtitle", "time": 7682.709, "timestamp": "02:08:02", "text": "。歡迎來到星空，感謝"}, {"type": "subtitle", "time": 7697.589, "timestamp": "02:08:17", "text": "你找到我，很遺憾我們不能一起玩"}, {"type": "subtitle", "time": 7702.709, "timestamp": "02:08:22", "text": "。  沒關係，不過還是非常感謝您過來。然後是Aki靜態狀態，謝謝Akisa"}, {"type": "subtitle", "time": 7738.31, "timestamp": "02:08:58", "text": "我意義重大。希望你今天過得愉快，謝謝你找到我，也謝謝你的關注。  歡迎來到漫展。希望你今天過得愉快。非常感謝"}]
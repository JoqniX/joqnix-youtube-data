[{"type": "subtitle", "time": 446.23, "timestamp": "00:07:26", "text": "你知道依戀"}, {"type": "subtitle", "time": 449.83, "timestamp": "00:07:29", "text": "是一種…等等，你知道攻擊是"}, {"type": "subtitle", "time": 453.11, "timestamp": "00:07:33", "text": "一種非常糟糕的事情嗎？什麼？或許我可以"}, {"type": "subtitle", "time": 455.51, "timestamp": "00:07:35", "text": "幫你解決Twitch方面的問題。呃，不，"}, {"type": "subtitle", "time": 456.95, "timestamp": "00:07:36", "text": "我沒事。我沒意見。我沒意見"}, {"type": "subtitle", "time": 459.35, "timestamp": "00:07:39", "text": "。所以，所有設計、圖片等等都是我自己做的"}, {"type": "subtitle", "time": 465.35, "timestamp": "00:07:45", "text": "呃，我不接委託之類的。"}, {"type": "subtitle", "time": 468.15, "timestamp": "00:07:48", "text": "不，我不喜歡接受"}, {"type": "subtitle", "time": 470.30899999999997, "timestamp": "00:07:50", "text": "委託，因為我喜歡自己創作"}, {"type": "subtitle", "time": 477.189, "timestamp": "00:07:57", "text": "我們在 Twitch 上會像在工作直播中那樣做"}]
[{"type": "subtitle", "time": 25380.868, "timestamp": "07:03:00", "text": "。  睡得好。張嘴微笑。新月。打擾一下。你不能帶走我的"}, {"type": "subtitle", "time": 25382.948, "timestamp": "07:03:02", "text": "忍者嗎？哦，你好。"}, {"type": "subtitle", "time": 25406.07, "timestamp": "07:03:26", "text": "克洛諾斯。這兩雙鞋各有特色。每個人都有自己獨特的表達愛意的方式。這無關哪一個比另一個更好，而是關乎背後的用心和關懷。讓我們珍惜朋友給予我們的愛與支持。"}, {"type": "subtitle", "time": 25430.948, "timestamp": "07:03:50", "text": "克洛諾斯，我很樂意與你一起"}, {"type": "subtitle", "time": 25433.03, "timestamp": "07:03:53", "text": "探索新世界。"}, {"type": "subtitle", "time": 25437.67, "timestamp": "07:03:57", "text": "讓我們一起踏上冒險之旅吧！  微笑，全球人民。你要背叛我嗎？  什麼"}]
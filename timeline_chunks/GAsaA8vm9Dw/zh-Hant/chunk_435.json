[{"type": "subtitle", "time": 26109.91, "timestamp": "07:15:09", "text": "克洛諾斯。無需支付任何費用，也無需進行辯護"}, {"type": "subtitle", "time": 26131.59, "timestamp": "07:15:31", "text": "表達我的支持。  讓我們一起傳播"}, {"type": "subtitle", "time": 26134.15, "timestamp": "07:15:34", "text": "善意和理解。微笑。兩顆心。  哇"}, {"type": "subtitle", "time": 26155.59, "timestamp": "07:15:55", "text": "。"}]
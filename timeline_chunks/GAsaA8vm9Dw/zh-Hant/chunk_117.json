[{"type": "subtitle", "time": 7020.149, "timestamp": "01:57:00", "text": "凱拉嗎？ Kella不就像香蕉之類的東西嗎？  倫敦"}, {"type": "subtitle", "time": 7022.87, "timestamp": "01:57:02", "text": "是"}, {"type": "subtitle", "time": 7047.83, "timestamp": "01:57:27", "text": "呃，我不該說「a」是個髒話。  [音樂] 他們都在罵人嗎？"}, {"type": "subtitle", "time": 7058.39, "timestamp": "01:57:38", "text": "為什麼？那是一款"}, {"type": "subtitle", "time": 7066.47, "timestamp": "01:57:46", "text": "電子遊戲。  我的天啊。  啊，我抓到他了。  他們信誓旦旦地說世上有失敗者"}, {"type": "subtitle", "time": 7075.75, "timestamp": "01:57:55", "text": "。啊，他知道我認識那個叫伊恩的傢伙。他當時就在那裡，等等，"}, {"type": "subtitle", "time": 7078.629, "timestamp": "01:57:58", "text": "我有點卡頓。  我進度嚴重落後。  我的天啊。"}]
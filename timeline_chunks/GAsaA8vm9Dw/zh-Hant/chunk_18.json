[{"type": "subtitle", "time": 1083.83, "timestamp": "00:18:03", "text": "是個大粉絲。不，不，不，不。假新聞。不，不"}, {"type": "subtitle", "time": 1093.43, "timestamp": "00:18:13", "text": "。我不是真人。  沒錯吧"}, {"type": "subtitle", "time": 1103.11, "timestamp": "00:18:23", "text": "，喬克？我不是真人。  我是你想像中的一種顏料。你"}, {"type": "subtitle", "time": 1119.83, "timestamp": "00:18:39", "text": "？  我神智不清。等等，我好像在好友名單裡沒看到你。為什麼？你好。讓我加入"}, {"type": "subtitle", "time": 1127.75, "timestamp": "00:18:47", "text": "你們吧，夥計。  好的。  啊，我……嗯……只是提醒一下，傑克。我現在玩這個遊戲真是菜到家了。"}, {"type": "subtitle", "time": 1129.11, "timestamp": "00:18:49", "text": "我不知道……"}, {"type": "subtitle", "time": 1136.47, "timestamp": "00:18:56", "text": "好吧，我們開始遊戲了。我有沒有忘記祝你生日快樂，壽司？不，你之前已經說過了。謝謝，兄弟"}, {"type": "subtitle", "time": 1139.19, "timestamp": "00:18:59", "text": "。  好好想想你今天的計畫。你今天有什麼計劃？已經是晚上了。我今天沒有"}]
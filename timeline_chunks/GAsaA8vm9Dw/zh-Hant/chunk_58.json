[{"type": "subtitle", "time": 3487.03, "timestamp": "00:58:07", "text": "度過"}, {"type": "subtitle", "time": 3490.15, "timestamp": "00:58:10", "text": "我的生日倒數計時的。  我沒想到會發生這種事，不過好吧。  這些煙都是乾嘛用的？  邦克。邦克。"}, {"type": "subtitle", "time": 3510.95, "timestamp": "00:58:30", "text": "哦。  撞擊。  為什麼他們都他媽的在我們的出生點蹲著走？  移動。"}]
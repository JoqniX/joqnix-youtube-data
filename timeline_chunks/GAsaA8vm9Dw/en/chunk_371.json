[{"type": "subtitle", "time": 22277.67, "timestamp": "06:11:17", "text": "Haha, ninja. That's a creative way to"}, {"type": "subtitle", "time": 22280.15, "timestamp": "06:11:20", "text": "find some humor. Looking in the mirror"}, {"type": "subtitle", "time": 22282.31, "timestamp": "06:11:22", "text": "can always bring a smile to your face."}, {"type": "subtitle", "time": 22284.948, "timestamp": "06:11:24", "text": "Even on those jokeless days, keep"}, {"type": "subtitle", "time": 22287.59, "timestamp": "06:11:27", "text": "spreading laughter and positivity. Open"}, {"type": "subtitle", "time": 22289.27, "timestamp": "06:11:29", "text": "mouth smile rolling on the floor"}, {"type": "subtitle", "time": 22307.91, "timestamp": "06:11:47", "text": "Ah, I see your point. Harsh Kronos jokes"}, {"type": "subtitle", "time": 22309.83, "timestamp": "06:11:49", "text": "do indeed often have meanings or carry"}, {"type": "subtitle", "time": 22312.31, "timestamp": "06:11:52", "text": "some form of message. It's always"}, {"type": "subtitle", "time": 22313.59, "timestamp": "06:11:53", "text": "interesting to find different"}, {"type": "subtitle", "time": 22315.83, "timestamp": "06:11:55", "text": "perspectives on humor. Everyone has"}, {"type": "subtitle", "time": 22317.67, "timestamp": "06:11:57", "text": "their own unique style that resonates"}, {"type": "subtitle", "time": 22319.91, "timestamp": "06:11:59", "text": "with them. Let's embrace the diversity"}]
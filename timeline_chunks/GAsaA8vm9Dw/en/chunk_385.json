[{"type": "subtitle", "time": 23101.59, "timestamp": "06:25:01", "text": "good fun. Feel free to ask me anything"}, {"type": "subtitle", "time": 23103.51, "timestamp": "06:25:03", "text": "you'd like, and I'll do my best to give"}, {"type": "subtitle", "time": 23106.23, "timestamp": "06:25:06", "text": "you an answer. Let's keep the adventures"}, {"type": "subtitle", "time": 23125.75, "timestamp": "06:25:25", "text": "Ah, harsh Kronos. You got me there. The"}, {"type": "subtitle", "time": 23128.31, "timestamp": "06:25:28", "text": "value of 227th in decimal form is"}, {"type": "subtitle", "time": 23134.31, "timestamp": "06:25:34", "text": "It goes on forever, but that's a good"}, {"type": "subtitle", "time": 23136.948, "timestamp": "06:25:36", "text": "approximation. Mathematical questions"}, {"type": "subtitle", "time": 23139.43, "timestamp": "06:25:39", "text": "always keep me on my toes. Let's keep"}, {"type": "subtitle", "time": 23141.51, "timestamp": "06:25:41", "text": "exploring together."}, {"type": "subtitle", "time": 23144.31, "timestamp": "06:25:44", "text": "Milky Way."}]
[{"type": "subtitle", "time": 23582.468, "timestamp": "06:33:02", "text": "[Music]"}, {"type": "subtitle", "time": 23585.03, "timestamp": "06:33:05", "text": "Ah, dealing with a baka who never sleeps"}, {"type": "subtitle", "time": 23587.91, "timestamp": "06:33:07", "text": "on time can be tricky. Encourage them to"}, {"type": "subtitle", "time": 23590.23, "timestamp": "06:33:10", "text": "establish a consistent sleep schedule."}, {"type": "subtitle", "time": 23592.39, "timestamp": "06:33:12", "text": "Create a bedtime routine and avoid"}, {"type": "subtitle", "time": 23595.11, "timestamp": "06:33:15", "text": "stimulating activities before bed."}, {"type": "subtitle", "time": 23596.788, "timestamp": "06:33:16", "text": "Remind them of the importance of rest"}, {"type": "subtitle", "time": 23598.708, "timestamp": "06:33:18", "text": "and offer support in finding ways to"}, {"type": "subtitle", "time": 23600.628, "timestamp": "06:33:20", "text": "relax. That's why sleep is important."}, {"type": "subtitle", "time": 23603.75, "timestamp": "06:33:23", "text": "Dreams await. Ease one."}, {"type": "subtitle", "time": 23607.19, "timestamp": "06:33:27", "text": "That's why sleep is important. So don't"}, {"type": "subtitle", "time": 23618.868, "timestamp": "06:33:38", "text": "Oh my god. Clueless's profile sounds"}, {"type": "subtitle", "time": 23621.19, "timestamp": "06:33:41", "text": "hilarious. It's always great to have a"}, {"type": "subtitle", "time": 23623.11, "timestamp": "06:33:43", "text": "good laugh and find joy in someone's"}, {"type": "subtitle", "time": 23625.83, "timestamp": "06:33:45", "text": "unique sense of humor. Laughter is the"}, {"type": "subtitle", "time": 23628.788, "timestamp": "06:33:48", "text": "best medicine after all. Tears of joy."}]
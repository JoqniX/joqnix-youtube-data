[{"type": "subtitle", "time": 23236.15, "timestamp": "06:27:16", "text": "確かに、ニンジャ、私は本当に大好きです"}, {"type": "subtitle", "time": 23238.628, "timestamp": "06:27:18", "text": "詩。さあ、あなたにちょっとしたプレゼントをどうぞ。で"}, {"type": "subtitle", "time": 23240.708, "timestamp": "06:27:20", "text": "夢と喜びの世界、"}, {"type": "subtitle", "time": 23243.83, "timestamp": "06:27:23", "text": "上の星々は言葉でとても明るく輝いている"}, {"type": "subtitle", "time": 23246.548, "timestamp": "06:27:26", "text": "感情を表現する鮮やかな情景を描く"}, {"type": "subtitle", "time": 23249.59, "timestamp": "06:27:29", "text": "穏やかで静謐。詩は素晴らしい。"}, {"type": "subtitle", "time": 23251.59, "timestamp": "06:27:31", "text": "それらは人々の心を揺さぶる。彼らは"}, {"type": "subtitle", "time": 23254.708, "timestamp": "06:27:34", "text": "愛、憧れ、そして芸術。だからもし"}, {"type": "subtitle", "time": 23257.27, "timestamp": "06:27:37", "text": "詩を1、2節欲しいなら、お願いして"}, {"type": "subtitle", "time": 23259.51, "timestamp": "06:27:39", "text": "いくつかご紹介しましょう。輝く星"}, {"type": "subtitle", "time": 23275.91, "timestamp": "06:27:55", "text": "試験開始30分前。忍者、見て"}, {"type": "subtitle", "time": 23277.99, "timestamp": "06:27:57", "text": "ここにいるのは誰でしょう。私たちの勤勉な友人"}]
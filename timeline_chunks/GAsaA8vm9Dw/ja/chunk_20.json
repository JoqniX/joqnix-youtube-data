[{"type": "subtitle", "time": 1201.99, "timestamp": "00:20:01", "text": "ああ、コンプ。わかった、"}, {"type": "subtitle", "time": 1203.909, "timestamp": "00:20:03", "text": "さあ行こう。"}, {"type": "subtitle", "time": 1227.51, "timestamp": "00:20:27", "text": "えっと"}, {"type": "subtitle", "time": 1230.39, "timestamp": "00:20:30", "text": "うん。こんにちは、トゥルオン・ブルーさん。いらっしゃいませ。"}, {"type": "subtitle", "time": 1231.83, "timestamp": "00:20:31", "text": "いらっしゃいませ。今日は調子はどうですか？希望"}, {"type": "subtitle", "time": 1233.35, "timestamp": "00:20:33", "text": "あなたはよくやっています。うん。そのリンクから、"}, {"type": "subtitle", "time": 1235.51, "timestamp": "00:20:35", "text": "もう全部見終わりましたか？"}, {"type": "subtitle", "time": 1241.99, "timestamp": "00:20:41", "text": "そうそう。ああ、私はクリックしました。それは良い"}, {"type": "subtitle", "time": 1243.909, "timestamp": "00:20:43", "text": "映画。フレディのシーンが大好きです"}, {"type": "subtitle", "time": 1247.59, "timestamp": "00:20:47", "text": "「フレッドが時間通りに来たよ」と彼は言った。えーと、あと、"}, {"type": "subtitle", "time": 1251.43, "timestamp": "00:20:51", "text": "ところで、それはコードですか？青い服を着た。"}, {"type": "subtitle", "time": 1252.87, "timestamp": "00:20:52", "text": "それは何と呼ばれますか？それは何ですか"}]
[{"type": "subtitle", "time": 25573.51, "timestamp": "07:06:13", "text": "ニンジャ、あなたが"}, {"type": "subtitle", "time": 25575.67, "timestamp": "07:06:15", "text": "今日は悲しい気分だ。それは"}, {"type": "subtitle", "time": 25577.51, "timestamp": "07:06:17", "text": "自分のために時間を取って、"}, {"type": "subtitle", "time": 25579.99, "timestamp": "07:06:19", "text": "休む。自分自身を大切にし、"}, {"type": "subtitle", "time": 25582.628, "timestamp": "07:06:22", "text": "私たちはあなたをサポートするためにここにいます。送信中"}, {"type": "subtitle", "time": 25598.07, "timestamp": "07:06:38", "text": "このゲームには暗視機能があります。おお。"}, {"type": "subtitle", "time": 25600.868, "timestamp": "07:06:40", "text": "私は一度もマップをプレイしたことがありません。厳しいクロノス、"}, {"type": "subtitle", "time": 25603.27, "timestamp": "07:06:43", "text": "あなたは本当に優しい人ですね。噛む。右"}, {"type": "subtitle", "time": 25605.59, "timestamp": "07:06:45", "text": "お返しします。愛を広げよう"}, {"type": "subtitle", "time": 25608.39, "timestamp": "07:06:48", "text": "ポジティブな気持ちを共に。いつまでも最高でいてください。"}, {"type": "subtitle", "time": 25611.03, "timestamp": "07:06:51", "text": "笑顔よ、輝く心よ。"}]
[{"type": "subtitle", "time": 4150.47, "timestamp": "01:09:10", "text": "しかし、それは笑顔ではない。問題は"}, {"type": "subtitle", "time": 4154.63, "timestamp": "01:09:14", "text": "私も母国語が苦手です。私"}, {"type": "subtitle", "time": 4157.349, "timestamp": "01:09:17", "text": "地元のバスの時刻表が読めない。理解します"}, {"type": "subtitle", "time": 4161.11, "timestamp": "01:09:21", "text": "いつも迷子になる。聞かなきゃいけないんだけど、"}, {"type": "subtitle", "time": 4166.47, "timestamp": "01:09:26", "text": "えーと、人みたいに、えーと、"}, {"type": "subtitle", "time": 4169.43, "timestamp": "01:09:29", "text": "英語とかそういう類いのもの。"}, {"type": "subtitle", "time": 4172.95, "timestamp": "01:09:32", "text": "何てことだ。ええ、私はまだ"}, {"type": "subtitle", "time": 4174.63, "timestamp": "01:09:34", "text": "学校や高校では"}, {"type": "subtitle", "time": 4177.99, "timestamp": "01:09:37", "text": "私はメインでとても下手だったので"}, {"type": "subtitle", "time": 4180.63, "timestamp": "01:09:40", "text": "言語については、ヒンディー語を選び、"}]
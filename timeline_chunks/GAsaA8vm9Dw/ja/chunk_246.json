[{"type": "subtitle", "time": 14770.63, "timestamp": "04:06:10", "text": "それは愚かな行為だった。それは愚かな行為だった。いつ私は"}, {"type": "subtitle", "time": 14773.429, "timestamp": "04:06:13", "text": "私の立場から抜け出す？ジョッキー、君は"}, {"type": "subtitle", "time": 14783.75, "timestamp": "04:06:23", "text": "男。"}, {"type": "subtitle", "time": 14789.59, "timestamp": "04:06:29", "text": "彼らは私の声を聞いているよね？彼らは、ええ、彼らは"}, {"type": "subtitle", "time": 14792.79, "timestamp": "04:06:32", "text": "私の声が聞こえるはずだ。"}, {"type": "subtitle", "time": 14802.87, "timestamp": "04:06:42", "text": "彼はこのジャンプを成功させた。よし、リセットする"}]
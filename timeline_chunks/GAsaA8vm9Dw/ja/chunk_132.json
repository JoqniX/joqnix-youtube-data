[{"type": "subtitle", "time": 7920.709, "timestamp": "02:12:00", "text": "実際にそうしてください。"}, {"type": "subtitle", "time": 7923.99, "timestamp": "02:12:03", "text": "待って、確かに詩はあげたけど、"}, {"type": "subtitle", "time": 7925.91, "timestamp": "02:12:05", "text": "そうそう。そうそう。うん、そうしないといけない"}, {"type": "subtitle", "time": 7928.87, "timestamp": "02:12:08", "text": "ええ、待ってください。ハシ、見えるよ、"}, {"type": "subtitle", "time": 7930.39, "timestamp": "02:12:10", "text": "右？"}, {"type": "subtitle", "time": 7932.55, "timestamp": "02:12:12", "text": "いいえ、できません。ああ、それはできないよ。待って、"}, {"type": "subtitle", "time": 7935.109, "timestamp": "02:12:15", "text": "私はただ"}, {"type": "subtitle", "time": 7936.709, "timestamp": "02:12:16", "text": "アクシア"}, {"type": "subtitle", "time": 7938.77, "timestamp": "02:12:18", "text": "A."}, {"type": "subtitle", "time": 7941.03, "timestamp": "02:12:21", "text": "[音楽]"}, {"type": "subtitle", "time": 7943.22, "timestamp": "02:12:23", "text": "はい、どうぞ。今ならできます"}, {"type": "subtitle", "time": 7974.629, "timestamp": "02:12:54", "text": "[音楽]"}, {"type": "subtitle", "time": 7977.189, "timestamp": "02:12:57", "text": "歌の配信をしても大丈夫ですか？"}]
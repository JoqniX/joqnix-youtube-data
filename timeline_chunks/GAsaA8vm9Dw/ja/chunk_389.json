[{"type": "subtitle", "time": 23342.15, "timestamp": "06:29:02", "text": "ゾーンに入り、勝利があなたの味方でありますように。"}, {"type": "subtitle", "time": 23373.75, "timestamp": "06:29:33", "text": "終わりました"}, {"type": "subtitle", "time": 23376.39, "timestamp": "06:29:36", "text": "のように"}, {"type": "subtitle", "time": 23377.75, "timestamp": "06:29:37", "text": "この戦い"}, {"type": "subtitle", "time": 23390.548, "timestamp": "06:29:50", "text": "まあまあ、ハーシュ・クロノス、どうやら"}, {"type": "subtitle", "time": 23392.07, "timestamp": "06:29:52", "text": "あなたと『クルーレス』には因縁がある"}, {"type": "subtitle", "time": 23394.468, "timestamp": "06:29:54", "text": "一緒に。旧友に会えて嬉しい"}, {"type": "subtitle", "time": 23396.788, "timestamp": "06:29:56", "text": "再接続中。近況報告を楽しんで、"}, {"type": "subtitle", "time": 23399.11, "timestamp": "06:29:59", "text": "楽しかった思い出を懐かしむ。"}]
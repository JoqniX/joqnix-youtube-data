[{"type": "subtitle", "time": 15126.309, "timestamp": "04:12:06", "text": "私は何もしていません。"}, {"type": "subtitle", "time": 15154.229, "timestamp": "04:12:34", "text": "読み込みが完了するまでお待ちください。それまでは、"}, {"type": "subtitle", "time": 15156.79, "timestamp": "04:12:36", "text": "何か食べるもの。"}, {"type": "subtitle", "time": 15159.03, "timestamp": "04:12:39", "text": "父が私にスナック菓子を持ってきてくれた"}, {"type": "subtitle", "time": 15161.83, "timestamp": "04:12:41", "text": "もの。だから、私が食べられるように"}]
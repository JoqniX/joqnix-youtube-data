[{"type": "subtitle", "time": 14703.11, "timestamp": "04:05:03", "text": "ああ、なんてことだ、彼は私の顔の上で死んだ。"}, {"type": "subtitle", "time": 14705.429, "timestamp": "04:05:05", "text": "ヒーラージョッキー。"}, {"type": "subtitle", "time": 14707.99, "timestamp": "04:05:07", "text": "ヒーラー。"}, {"type": "subtitle", "time": 14713.03, "timestamp": "04:05:13", "text": "今行ってる。チームメイトは私のことを常に監視している。"}, {"type": "subtitle", "time": 14751.91, "timestamp": "04:05:51", "text": "ああ、捕まえたぞ。どうにかして彼を捕まえた。さあ"}]
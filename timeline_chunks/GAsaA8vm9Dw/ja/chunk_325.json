[{"type": "subtitle", "time": 19500.948, "timestamp": "05:25:00", "text": "死ぬな。そんなことはしないでください。ああ、彼は亡くなった。"}, {"type": "subtitle", "time": 19503.51, "timestamp": "05:25:03", "text": "ああ、私は死んだ。"}, {"type": "subtitle", "time": 19506.15, "timestamp": "05:25:06", "text": "おお、"}, {"type": "subtitle", "time": 19525.59, "timestamp": "05:25:25", "text": "文字通り、みんなが泊まりに来ている"}, {"type": "subtitle", "time": 19555.67, "timestamp": "05:25:55", "text": "彼は何と言ったの？彼は何と言ったの？停止"}, {"type": "subtitle", "time": 19557.35, "timestamp": "05:25:57", "text": "キャンプ。"}]
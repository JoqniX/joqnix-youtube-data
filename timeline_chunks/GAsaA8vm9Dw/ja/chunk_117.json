[{"type": "subtitle", "time": 7020.149, "timestamp": "01:57:00", "text": "動作していないのですか？すみません。する必要がある"}, {"type": "subtitle", "time": 7022.87, "timestamp": "01:57:02", "text": "それについて調べてみてください。ああ、繋がってるよ"}, {"type": "subtitle", "time": 7047.83, "timestamp": "01:57:27", "text": "でも、そうですね、言いたいことがあります"}, {"type": "subtitle", "time": 7051.75, "timestamp": "01:57:31", "text": "ピッチはかわいい。文字通り、見てみれば"}, {"type": "subtitle", "time": 7056.39, "timestamp": "01:57:36", "text": "今の彼。ピッチはとっても可愛い。"}, {"type": "subtitle", "time": 7058.39, "timestamp": "01:57:38", "text": "とてもかわいい。"}, {"type": "subtitle", "time": 7064.39, "timestamp": "01:57:44", "text": "パン。実はピンク色のP90を持ってたんだ"}, {"type": "subtitle", "time": 7066.47, "timestamp": "01:57:46", "text": "コール オブ デューティ ゲームで。どれだったか忘れた"}, {"type": "subtitle", "time": 7069.669, "timestamp": "01:57:49", "text": "ゲームが全てだった。 P90ではなかったと思いますが、"}, {"type": "subtitle", "time": 7073.83, "timestamp": "01:57:53", "text": "M4 A1に乗っていたのですが、"}, {"type": "subtitle", "time": 7075.75, "timestamp": "01:57:55", "text": "今すぐお金を払ってください。文字通り彼らは"}, {"type": "subtitle", "time": 7078.629, "timestamp": "01:57:58", "text": "それをリニューアルしたら、全てを失ってしまった。"}]
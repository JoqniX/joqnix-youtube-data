[{"type": "subtitle", "time": 22991.59, "timestamp": "06:23:11", "text": "あなたはこれらを既に倒しましたか？"}, {"type": "subtitle", "time": 23021.27, "timestamp": "06:23:41", "text": "もちろん。厳しいクロノス、私は"}, {"type": "subtitle", "time": 23023.75, "timestamp": "06:23:43", "text": "ぜひあなたのために作ってあげますよ。だから、"}, {"type": "subtitle", "time": 23027.19, "timestamp": "06:23:47", "text": "えっと、空の皿みたいな？すべて冗談です"}, {"type": "subtitle", "time": 23029.43, "timestamp": "06:23:49", "text": "それとは別に、カスタマイズも喜んで承ります。"}, {"type": "subtitle", "time": 23031.59, "timestamp": "06:23:51", "text": "あなただけのハンバーガーですが、もしかしたら"}, {"type": "subtitle", "time": 23033.35, "timestamp": "06:23:53", "text": "材料をいくつか追加して、"}]
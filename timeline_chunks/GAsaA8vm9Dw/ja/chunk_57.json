[{"type": "subtitle", "time": 3434.069, "timestamp": "00:57:14", "text": "対テロ作戦の勝利。一体何なんだ"}, {"type": "subtitle", "time": 3440.71, "timestamp": "00:57:20", "text": "私はまだ生きているわよ、ベイビー。何ラウンド"}, {"type": "subtitle", "time": 3445.349, "timestamp": "00:57:25", "text": "こういうのもあるの？覚えていない。"}, {"type": "subtitle", "time": 3449.43, "timestamp": "00:57:29", "text": "今では、おそらく20くらいまであります"}, {"type": "subtitle", "time": 3453.109, "timestamp": "00:57:33", "text": "今回はラウンド数。"}, {"type": "subtitle", "time": 3454.789, "timestamp": "00:57:34", "text": "もうすぐだ。私たちはもうすぐ"}, {"type": "subtitle", "time": 3459.589, "timestamp": "00:57:39", "text": "もう少しだけよ、ジョー。若干"}, {"type": "subtitle", "time": 3461.67, "timestamp": "00:57:41", "text": "もっと。"}, {"type": "subtitle", "time": 3464.63, "timestamp": "00:57:44", "text": "君ならできるだろう？"}, {"type": "subtitle", "time": 3467.109, "timestamp": "00:57:47", "text": "はい。"}, {"type": "subtitle", "time": 3469.829, "timestamp": "00:57:49", "text": "私はただ鶏を狩っているだけです。"}, {"type": "subtitle", "time": 3471.67, "timestamp": "00:57:51", "text": "ちょっと待って、ゲーマー。どうして見逃したんだろう"}]
[{"type": "subtitle", "time": 12601.11, "timestamp": "03:30:01", "text": "今日はパニックになっているのは、"}, {"type": "subtitle", "time": 12603.91, "timestamp": "03:30:03", "text": "物理のタッチテスト。 20ページくらいあります。"}, {"type": "subtitle", "time": 12607.349, "timestamp": "03:30:07", "text": "ああ。何てことだ。"}, {"type": "subtitle", "time": 12609.83, "timestamp": "03:30:09", "text": "ああ。あなたがそうしないとこうなります"}, {"type": "subtitle", "time": 12612.79, "timestamp": "03:30:12", "text": "課題を期限内に提出してください。それは痛みだ。そして"}, {"type": "subtitle", "time": 12615.75, "timestamp": "03:30:15", "text": "その気持ち、よくわかる。感じるよ。感じる"}, {"type": "subtitle", "time": 12617.91, "timestamp": "03:30:17", "text": "私も同じことをしたから、痛みを感じた。"}, {"type": "subtitle", "time": 12622.229, "timestamp": "03:30:22", "text": "私の課題にも。それらの"}, {"type": "subtitle", "time": 12625.429, "timestamp": "03:30:25", "text": "1週間分の12時間"}, {"type": "subtitle", "time": 12632.55, "timestamp": "03:30:32", "text": "あなたの苦しみはよく分かります。でも頑張って、"}, {"type": "subtitle", "time": 12641.51, "timestamp": "03:30:41", "text": "20ページというのは冗談ではない。それは それは"}, {"type": "subtitle", "time": 12644.71, "timestamp": "03:30:44", "text": "多く。それはすごい量ですね。たくさん。"}, {"type": "subtitle", "time": 12652.309, "timestamp": "03:30:52", "text": "[音楽]"}]
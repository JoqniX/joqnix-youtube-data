[{"type": "subtitle", "time": 4099.17, "timestamp": "01:08:19", "text": "何？"}, {"type": "subtitle", "time": 4124.309, "timestamp": "01:08:44", "text": "あなたの主な言語は何ですか？それは"}, {"type": "subtitle", "time": 4130.39, "timestamp": "01:08:50", "text": "それは秘密です。私はそれを明かしていない"}, {"type": "subtitle", "time": 4132.95, "timestamp": "01:08:52", "text": "誰に対しても"}, {"type": "subtitle", "time": 4135.749, "timestamp": "01:08:55", "text": "それでおしまい。うん、ショーだよ、わかるでしょ。"}, {"type": "subtitle", "time": 4138.789, "timestamp": "01:08:58", "text": "私は南部出身です。私が言えるのは、えっと"}]
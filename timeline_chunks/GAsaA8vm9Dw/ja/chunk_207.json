[{"type": "subtitle", "time": 12424.309, "timestamp": "03:27:04", "text": "今日はバトルベットをプレイします"}, {"type": "subtitle", "time": 12427.75, "timestamp": "03:27:07", "text": "リマスター版。これは私の2回目の配信ですが、"}, {"type": "subtitle", "time": 12430.71, "timestamp": "03:27:10", "text": "バトルベットをプレイしています。期待しましょう"}, {"type": "subtitle", "time": 12434.469, "timestamp": "03:27:14", "text": "すべて順調に進んでいます。そしてシーマが来た"}, {"type": "subtitle", "time": 12437.51, "timestamp": "03:27:17", "text": "ここでも同様です。"}, {"type": "subtitle", "time": 12439.51, "timestamp": "03:27:19", "text": "私は彼女を時々利用するつもりです。"}, {"type": "subtitle", "time": 12441.59, "timestamp": "03:27:21", "text": "だから、心配しないでください。"}, {"type": "subtitle", "time": 12444.95, "timestamp": "03:27:24", "text": "モー。ええ、彼女を"}, {"type": "subtitle", "time": 12447.83, "timestamp": "03:27:27", "text": "次は10ストリームくらいかな。欲しい"}, {"type": "subtitle", "time": 12451.99, "timestamp": "03:27:31", "text": "私にはわかりません。私にも限界がある。私はしません"}, {"type": "subtitle", "time": 12454.95, "timestamp": "03:27:34", "text": "知る。彼女を全部使い切りたい"}, {"type": "subtitle", "time": 12457.91, "timestamp": "03:27:37", "text": "月。待って、それは「オーマイゴッド」のように聞こえる、"}, {"type": "subtitle", "time": 12459.83, "timestamp": "03:27:39", "text": "それは奇妙に聞こえる。ああ、彼女を全部使い果たす"}, {"type": "subtitle", "time": 12464.79, "timestamp": "03:27:44", "text": "えーっと、私のOpen AIのやつまであと1ヶ月"}, {"type": "subtitle", "time": 12467.03, "timestamp": "03:27:47", "text": "少なくとも"}, {"type": "subtitle", "time": 12470.87, "timestamp": "03:27:50", "text": "5ドルか10ドルか、わからない。私は"}, {"type": "subtitle", "time": 12473.99, "timestamp": "03:27:53", "text": "五。だから、私は5ドル相当のものを欲しい"}, {"type": "subtitle", "time": 12477.269, "timestamp": "03:27:57", "text": "今月。うん。だから私は"}]
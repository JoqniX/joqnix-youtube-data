[{"type": "subtitle", "time": 23646.15, "timestamp": "06:34:06", "text": "ジョーXに直接伝えることはできませんが"}, {"type": "subtitle", "time": 23648.39, "timestamp": "06:34:08", "text": "彼にそうするように勧めることは確かにできます"}, {"type": "subtitle", "time": 23650.31, "timestamp": "06:34:10", "text": "睡眠を優先し、彼の"}, {"type": "subtitle", "time": 23652.31, "timestamp": "06:34:12", "text": "幸福。わかりました、最善を尽くします。"}, {"type": "subtitle", "time": 23653.99, "timestamp": "06:34:13", "text": "身体的にも精神的にも重要"}, {"type": "subtitle", "time": 23656.07, "timestamp": "06:34:16", "text": "健康。だから、彼が"}, {"type": "subtitle", "time": 23658.788, "timestamp": "06:34:18", "text": "彼の睡眠スケジュールを改善する。幸運を、"}, {"type": "subtitle", "time": 23678.708, "timestamp": "06:34:38", "text": "はい、Ninja Joe Xは素晴らしいストリーマーです"}, {"type": "subtitle", "time": 23681.03, "timestamp": "06:34:41", "text": "そして、素晴らしい友人。私は楽しんでいます"}, {"type": "subtitle", "time": 23682.708, "timestamp": "06:34:42", "text": "彼と協力し、探求する"}, {"type": "subtitle", "time": 23685.19, "timestamp": "06:34:45", "text": "異なるゲームの世界が一つになる。彼は"}, {"type": "subtitle", "time": 23686.788, "timestamp": "06:34:46", "text": "素晴らしい人物"}, {"type": "subtitle", "time": 23689.27, "timestamp": "06:34:49", "text": "ストリーミングコミュニティ。光る星のビデオ"}]
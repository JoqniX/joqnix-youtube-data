[{"type": "subtitle", "time": 962.55, "timestamp": "00:16:02", "text": "そう、超高画質みたいな感じ。文字通り"}, {"type": "subtitle", "time": 966.629, "timestamp": "00:16:06", "text": "HD映画。ウィローも同じことをしたと知っています"}, {"type": "subtitle", "time": 970.069, "timestamp": "00:16:10", "text": "「そうね」とパットは言った。お前ら全員クソ野郎か"}, {"type": "subtitle", "time": 971.509, "timestamp": "00:16:11", "text": "今考えてみると、実は"}, {"type": "subtitle", "time": 974.15, "timestamp": "00:16:14", "text": "同じことをしたけど、えーとどの映画で"}, {"type": "subtitle", "time": 975.35, "timestamp": "00:16:15", "text": "あれはそうだったのか？私はそれを"}, {"type": "subtitle", "time": 978.23, "timestamp": "00:16:18", "text": "マリオの映画もね。本当にできない"}, {"type": "subtitle", "time": 980.23, "timestamp": "00:16:20", "text": "もし私がそれを知ったら、本当にあなたを非難するでしょう。くそ。"}, {"type": "subtitle", "time": 982.47, "timestamp": "00:16:22", "text": "持続する。クロスヘアを変更させてください"}, {"type": "subtitle", "time": 985.35, "timestamp": "00:16:25", "text": "素早い。うん。うん。"}, {"type": "subtitle", "time": 988.949, "timestamp": "00:16:28", "text": "待って、私、持ってる？君の姿が見えない。"}, {"type": "subtitle", "time": 990.79, "timestamp": "00:16:30", "text": "うん。うん。うん。私は先にあなたたちと合流しました"}, {"type": "subtitle", "time": 994.55, "timestamp": "00:16:34", "text": "あなたが中に入ったとき。でも、あなたはそうした。"}, {"type": "subtitle", "time": 996.47, "timestamp": "00:16:36", "text": "はい。デスマッチに入ったとき、私は"}, {"type": "subtitle", "time": 1000.15, "timestamp": "00:16:40", "text": "あなたのパーティーにいました。何？私はあなたの"}, {"type": "subtitle", "time": 1003.269, "timestamp": "00:16:43", "text": "気づかれないうちにパーティーを開く。私のGは"}, {"type": "subtitle", "time": 1011.829, "timestamp": "00:16:51", "text": "うん。こんにちは。"}, {"type": "subtitle", "time": 1013.749, "timestamp": "00:16:53", "text": "こんにちは。私はただ偶然"}, {"type": "subtitle", "time": 1017.43, "timestamp": "00:16:57", "text": "順調に進んでいる。こんにちは。こんにちは。こんにちは。あなたは楽しんでいます"}]
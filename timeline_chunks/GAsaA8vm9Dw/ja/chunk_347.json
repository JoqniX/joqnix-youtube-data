[{"type": "subtitle", "time": 20821.35, "timestamp": "05:47:01", "text": "おはようございます、ヘッドアス卿。あなたに"}, {"type": "subtitle", "time": 20823.11, "timestamp": "05:47:03", "text": "ぐっすり眠って準備ができました"}, {"type": "subtitle", "time": 20825.35, "timestamp": "05:47:05", "text": "その日を乗り切る。何かありますか？"}, {"type": "subtitle", "time": 20827.27, "timestamp": "05:47:07", "text": "今日はどんなワクワクする計画を立てていますか？"}, {"type": "subtitle", "time": 20829.19, "timestamp": "05:47:09", "text": "スマイルブロッサム。"}, {"type": "subtitle", "time": 20841.91, "timestamp": "05:47:21", "text": "どうして私はすべてのシュートを外してしまったのだろう？"}, {"type": "subtitle", "time": 20875.27, "timestamp": "05:47:55", "text": "ハハ。ありがとう、ニンジャ。あなたが"}, {"type": "subtitle", "time": 20877.51, "timestamp": "05:47:57", "text": "私の話し方を可愛いと思ってください。その"}, {"type": "subtitle", "time": 20879.27, "timestamp": "05:47:59", "text": "自分を表現するのはいつも楽しい"}]
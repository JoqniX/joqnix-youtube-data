[{"type": "subtitle", "time": 3548.39, "timestamp": "00:59:08", "text": "誰かのSMサブマシンガンを盗んだ。"}, {"type": "subtitle", "time": 3549.75, "timestamp": "00:59:09", "text": "やった、ついにマッチポイントだ。彼らはできる"}, {"type": "subtitle", "time": 3552.069, "timestamp": "00:59:12", "text": "ついに勝利した。イエス。はるかに時間がかかったが、"}, {"type": "subtitle", "time": 3554.67, "timestamp": "00:59:14", "text": "よし。うん。"}, {"type": "subtitle", "time": 3562.789, "timestamp": "00:59:22", "text": "何てことだ。私"}, {"type": "subtitle", "time": 3565.109, "timestamp": "00:59:25", "text": "投げる、これが私の最後の試合になるかもしれない"}, {"type": "subtitle", "time": 3567.03, "timestamp": "00:59:27", "text": "クソッ"}, {"type": "subtitle", "time": 3579.67, "timestamp": "00:59:39", "text": "中盤で完全にスキル差で負けた。"}, {"type": "subtitle", "time": 3586.63, "timestamp": "00:59:46", "text": "ああ、スポーツマン。もしあなたがヒットしたら もしあなたがヒットしたら"}, {"type": "subtitle", "time": 3588.71, "timestamp": "00:59:48", "text": "クリップを撃ちました、クリップを撃ちました。クリップを打つ"}, {"type": "subtitle", "time": 3596.069, "timestamp": "00:59:56", "text": "クリップを撃つ。クリップを撃つ。しかし、"}, {"type": "subtitle", "time": 3599.43, "timestamp": "00:59:59", "text": "それはどういう意味ですか？キルを取れ。"}]
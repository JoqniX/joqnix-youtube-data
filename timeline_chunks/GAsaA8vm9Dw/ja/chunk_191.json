[{"type": "subtitle", "time": 11463.349, "timestamp": "03:11:03", "text": "それはもっと"}, {"type": "subtitle", "time": 11465.75, "timestamp": "03:11:05", "text": "私は時間を無駄にしていたか、何もしていなかった。"}, {"type": "subtitle", "time": 11468.79, "timestamp": "03:11:08", "text": "先延ばしにして"}, {"type": "subtitle", "time": 11471.67, "timestamp": "03:11:11", "text": "それらのすべてを気をそらした"}, {"type": "subtitle", "time": 11476.63, "timestamp": "03:11:16", "text": "くだらない小さなこと。"}, {"type": "subtitle", "time": 11490.95, "timestamp": "03:11:30", "text": "これはそれなりに興味深い。"}, {"type": "subtitle", "time": 11493.51, "timestamp": "03:11:33", "text": "そうじゃない？"}]
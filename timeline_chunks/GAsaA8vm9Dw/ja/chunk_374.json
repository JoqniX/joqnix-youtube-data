[{"type": "subtitle", "time": 22452.868, "timestamp": "06:14:12", "text": "ハハ、厳しいね、クロノス。それは賢い"}, {"type": "subtitle", "time": 22456.07, "timestamp": "06:14:16", "text": "1つ。音楽的な言葉遊び。なるほど。それらを保管してください"}, {"type": "subtitle", "time": 22458.15, "timestamp": "06:14:18", "text": "ダジャレが飛び交うぞ、さあ楽しもう"}, {"type": "subtitle", "time": 22482.868, "timestamp": "06:14:42", "text": "ニンジャ、面白いと思ってくれて嬉しいよ。"}, {"type": "subtitle", "time": 22485.19, "timestamp": "06:14:45", "text": "笑いは伝染するので、"}, {"type": "subtitle", "time": 22487.59, "timestamp": "06:14:47", "text": "喜びとユーモアを共に広める。"}, {"type": "subtitle", "time": 22489.59, "timestamp": "06:14:49", "text": "床に転がる口を開けた笑顔、"}]
[{"type": "subtitle", "time": 9664.389, "timestamp": "02:41:04", "text": "数ヶ月かかった"}, {"type": "subtitle", "time": 9667.51, "timestamp": "02:41:07", "text": "オンスの"}, {"type": "subtitle", "time": 9670.23, "timestamp": "02:41:10", "text": "私の忍耐"}, {"type": "subtitle", "time": 9674.71, "timestamp": "02:41:14", "text": "何ヶ月も何ヶ月もどういうわけか"}, {"type": "subtitle", "time": 9678.55, "timestamp": "02:41:18", "text": "彼らを追いかけて行く"}, {"type": "subtitle", "time": 9687.11, "timestamp": "02:41:27", "text": "ただ"}, {"type": "subtitle", "time": 9689.91, "timestamp": "02:41:29", "text": "アカウントを復旧してください。はい、私がオーナーです。"}, {"type": "subtitle", "time": 9692.07, "timestamp": "02:41:32", "text": "私はオーナーです。"}, {"type": "subtitle", "time": 9694.15, "timestamp": "02:41:34", "text": "だから、そのイライラする気持ちはなんとなくわかる。"}, {"type": "subtitle", "time": 9698.0, "timestamp": "02:41:38", "text": "あれはそうだけど、まあね。"}, {"type": "subtitle", "time": 9700.63, "timestamp": "02:41:40", "text": "[音楽]"}, {"type": "subtitle", "time": 9703.349, "timestamp": "02:41:43", "text": "そうそう。 UBキーも買いたい"}, {"type": "subtitle", "time": 9707.349, "timestamp": "02:41:47", "text": "正直に言ってください。人生のある時点で。"}, {"type": "subtitle", "time": 9712.71, "timestamp": "02:41:52", "text": "UIキーのようなものが欲しかったんです。"}]
[{"type": "subtitle", "time": 2466.069, "timestamp": "00:41:06", "text": "ああ、あの人のご冥福をお祈りします。なぜ彼は"}, {"type": "subtitle", "time": 2471.67, "timestamp": "00:41:11", "text": "ああ、わかりました。彼はバカだ。"}, {"type": "subtitle", "time": 2473.829, "timestamp": "00:41:13", "text": "バカ。"}, {"type": "subtitle", "time": 2477.43, "timestamp": "00:41:17", "text": "テロリストの勝利だ。"}, {"type": "subtitle", "time": 2479.43, "timestamp": "00:41:19", "text": "彼がここで死んだら、それはとても"}, {"type": "subtitle", "time": 2490.39, "timestamp": "00:41:30", "text": "私は手榴弾を4つ持っていて、それを使います"}, {"type": "subtitle", "time": 2492.63, "timestamp": "00:41:32", "text": "私にとって有利になる。"}, {"type": "subtitle", "time": 2511.67, "timestamp": "00:41:51", "text": "手榴弾を投げろ。火を投げる。"}]
[{"type": "subtitle", "time": 22322.31, "timestamp": "06:12:02", "text": "ユーモアを交え、一緒に笑いを楽しむ。"}, {"type": "subtitle", "time": 22334.868, "timestamp": "06:12:14", "text": "ありがたいことに、彼は焦点が合っていて怖いです"}, {"type": "subtitle", "time": 22341.59, "timestamp": "06:12:21", "text": "ハハ、心配しないで、厳しいクロノス。私"}, {"type": "subtitle", "time": 22344.548, "timestamp": "06:12:24", "text": "冗談と、ふざけた軽いタッチに感謝します。"}, {"type": "subtitle", "time": 22347.51, "timestamp": "06:12:27", "text": "すべては楽しい冗談です。その笑顔の紙を開けてみて。"}, {"type": "subtitle", "time": 22349.59, "timestamp": "06:12:29", "text": "ユーモアを続けて、"}, {"type": "subtitle", "time": 22351.51, "timestamp": "06:12:31", "text": "一緒に過ごした時間は最高だった。"}, {"type": "subtitle", "time": 22353.59, "timestamp": "06:12:33", "text": "いいえ"}, {"type": "subtitle", "time": 22356.23, "timestamp": "06:12:36", "text": "iPad"}, {"type": "subtitle", "time": 22368.15, "timestamp": "06:12:48", "text": "もちろん、フロリアン・クレーター、ジョークをどうぞ"}, {"type": "subtitle", "time": 22370.548, "timestamp": "06:12:50", "text": "あなただけのために。科学者はなぜ信頼しないのか"}, {"type": "subtitle", "time": 22373.59, "timestamp": "06:12:53", "text": "原子？なぜなら、それらがすべての構成要素だからだ。"}, {"type": "subtitle", "time": 22375.03, "timestamp": "06:12:55", "text": "床に転がり、笑いながら"}, {"type": "subtitle", "time": 22377.19, "timestamp": "06:12:57", "text": "顕微鏡。笑い続けて楽しんでください"}]
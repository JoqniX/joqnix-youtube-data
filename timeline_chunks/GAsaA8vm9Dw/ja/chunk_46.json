[{"type": "subtitle", "time": 2761.27, "timestamp": "00:46:01", "text": "素敵な壁ですね。素晴らしい壁抜け術ですね。"}, {"type": "subtitle", "time": 2764.71, "timestamp": "00:46:04", "text": "もっと弾丸が必要だ。すべてにおいて"}, {"type": "subtitle", "time": 2767.27, "timestamp": "00:46:07", "text": "チャットまたはいいね うん、それは古いチャットです。"}, {"type": "subtitle", "time": 2769.349, "timestamp": "00:46:09", "text": "テロ対策担当者と書いていない場合"}, {"type": "subtitle", "time": 2771.75, "timestamp": "00:46:11", "text": "左側では、彼らが話していることを意味します"}, {"type": "subtitle", "time": 2773.51, "timestamp": "00:46:13", "text": "すべてのチャット。"}, {"type": "subtitle", "time": 2776.309, "timestamp": "00:46:16", "text": "彼らがどれだけ不満を言っても構わないよ、兄弟。"}, {"type": "subtitle", "time": 2778.069, "timestamp": "00:46:18", "text": "彼らは塩を加えることができるが、それは決して"}, {"type": "subtitle", "time": 2781.19, "timestamp": "00:46:21", "text": "何も変えられないよ、兄弟。"}, {"type": "subtitle", "time": 2783.589, "timestamp": "00:46:23", "text": "その通り。"}, {"type": "subtitle", "time": 2785.67, "timestamp": "00:46:25", "text": "フラッシュ、"}, {"type": "subtitle", "time": 2787.67, "timestamp": "00:46:27", "text": "塩味を感じるのはそれだけ"}, {"type": "subtitle", "time": 2797.19, "timestamp": "00:46:37", "text": "ああ、神様。後退する。"}, {"type": "subtitle", "time": 2799.67, "timestamp": "00:46:39", "text": "ああ、後退しろ。"}, {"type": "subtitle", "time": 2802.23, "timestamp": "00:46:42", "text": "大丈夫、任せて。"}, {"type": "subtitle", "time": 2803.99, "timestamp": "00:46:43", "text": "私は何も殴らない。でも私は"}, {"type": "subtitle", "time": 2805.91, "timestamp": "00:46:45", "text": "これ。"}, {"type": "subtitle", "time": 2809.19, "timestamp": "00:46:49", "text": "まさに私の目の前だ。"}, {"type": "subtitle", "time": 2812.87, "timestamp": "00:46:52", "text": "取り戻せましたか？右。あなたはそれを投げた"}, {"type": "subtitle", "time": 2815.67, "timestamp": "00:46:55", "text": "文字通り直接"}]
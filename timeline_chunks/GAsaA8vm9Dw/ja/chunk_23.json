[{"type": "subtitle", "time": 1383.51, "timestamp": "00:23:03", "text": "煙。彼は煙草を吸っている。彼は煙草を吸っている。彼"}, {"type": "subtitle", "time": 1386.47, "timestamp": "00:23:06", "text": "煙。煙。煙。"}, {"type": "subtitle", "time": 1395.43, "timestamp": "00:23:15", "text": "煙です。ああ、最後は煙だ。"}, {"type": "subtitle", "time": 1404.23, "timestamp": "00:23:24", "text": "彼はそこにいない。"}, {"type": "subtitle", "time": 1415.669, "timestamp": "00:23:35", "text": "何てことだ。"}, {"type": "subtitle", "time": 1420.63, "timestamp": "00:23:40", "text": "[拍手]"}]
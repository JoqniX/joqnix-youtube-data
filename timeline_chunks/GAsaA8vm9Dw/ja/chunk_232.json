[{"type": "subtitle", "time": 13924.229, "timestamp": "03:52:04", "text": "私はここにいます"}, {"type": "subtitle", "time": 13945.429, "timestamp": "03:52:25", "text": "ああ神様、"}, {"type": "subtitle", "time": 13969.03, "timestamp": "03:52:49", "text": "終わりました。ああ、終わってしまった。わかった。無料"}, {"type": "subtitle", "time": 13972.15, "timestamp": "03:52:52", "text": "今すぐ無料で勝利を掴みましょう。自由な人々。そうした方がいいよ"}, {"type": "subtitle", "time": 13974.309, "timestamp": "03:52:54", "text": "説明してください。行けよ、相棒。最近"}, {"type": "subtitle", "time": 13977.189, "timestamp": "03:52:57", "text": "私は40歳を超えています。"}]
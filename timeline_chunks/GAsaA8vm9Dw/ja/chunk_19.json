[{"type": "subtitle", "time": 1141.83, "timestamp": "00:19:01", "text": "ええ、今日見ましたよ。だから私は"}, {"type": "subtitle", "time": 1143.11, "timestamp": "00:19:03", "text": "FNAF映画について話しているようなものだった"}, {"type": "subtitle", "time": 1158.63, "timestamp": "00:19:18", "text": "えっと、どちらに行きたいですか？"}, {"type": "subtitle", "time": 1161.029, "timestamp": "00:19:21", "text": "カジュアル。もう何もかも嫌だ。うん。"}, {"type": "subtitle", "time": 1164.789, "timestamp": "00:19:24", "text": "いや、いや、いや。ランキング。ランキング上位をご希望ですか？"}, {"type": "subtitle", "time": 1166.63, "timestamp": "00:19:26", "text": "お前は自分のクソを捨てたいのか"}, {"type": "subtitle", "time": 1168.23, "timestamp": "00:19:28", "text": "正気？"}, {"type": "subtitle", "time": 1170.549, "timestamp": "00:19:30", "text": "うーん、わからない。"}, {"type": "subtitle", "time": 1173.27, "timestamp": "00:19:33", "text": "ランクマッチは一度もプレイしたことがない。ああ、それなら"}, {"type": "subtitle", "time": 1175.029, "timestamp": "00:19:35", "text": "もしかしたら、あなたが経験する時なのかもしれません"}, {"type": "subtitle", "time": 1178.23, "timestamp": "00:19:38", "text": "ランキングなんてクソくらえだ。"}, {"type": "subtitle", "time": 1183.27, "timestamp": "00:19:43", "text": "怖いですか？私はとても、そうではありません。国連"}, {"type": "subtitle", "time": 1184.789, "timestamp": "00:19:44", "text": "ランク戦で唯一怖いのは"}, {"type": "subtitle", "time": 1186.39, "timestamp": "00:19:46", "text": "人々があなたに怒鳴りつけているが、それは本当に"}, {"type": "subtitle", "time": 1190.789, "timestamp": "00:19:50", "text": "レア。ああ、わかった。"}, {"type": "subtitle", "time": 1194.39, "timestamp": "00:19:54", "text": "よし、行こう。準備はできたか？私はすべきでしょうか"}, {"type": "subtitle", "time": 1197.35, "timestamp": "00:19:57", "text": "相棒役か、それとも競争相手か？"}, {"type": "subtitle", "time": 1199.83, "timestamp": "00:19:59", "text": "ええと、私たちは競争することができます。"}]
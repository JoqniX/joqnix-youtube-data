[{"type": "subtitle", "time": 21962.628, "timestamp": "06:06:02", "text": "フロリアン・クレーター。潔癖症の人にとって、"}, {"type": "subtitle", "time": 21964.47, "timestamp": "06:06:04", "text": "ドイツという国全体を考えた"}, {"type": "subtitle", "time": 21967.35, "timestamp": "06:06:07", "text": "それは確かに非常に圧倒されるかもしれない。寒い"}, {"type": "subtitle", "time": 21983.83, "timestamp": "06:06:23", "text": "面白いものを見つけてくれて嬉しいです。"}, {"type": "subtitle", "time": 21986.39, "timestamp": "06:06:26", "text": "忍者。笑いは常に素晴らしい方法です"}, {"type": "subtitle", "time": 21988.788, "timestamp": "06:06:28", "text": "一日を明るくする。口を開けて笑う"}, {"type": "subtitle", "time": 22006.628, "timestamp": "06:06:46", "text": "心配ないよ、ニンジャ。時々、"}, {"type": "subtitle", "time": 22009.03, "timestamp": "06:06:49", "text": "冗談ばかりだけど、まあいいよ。我々はできる"}, {"type": "subtitle", "time": 22011.03, "timestamp": "06:06:51", "text": "会話を楽しんで、"}, {"type": "subtitle", "time": 22013.75, "timestamp": "06:06:53", "text": "素晴らしい時間だった。口を開けて、笑って、微笑む"}]
[{"type": "subtitle", "time": 12728.71, "timestamp": "03:32:08", "text": "どれくらいの可能性があるだろうか？"}, {"type": "subtitle", "time": 12731.269, "timestamp": "03:32:11", "text": "なぜ漏洩してしまったのか？"}, {"type": "subtitle", "time": 12733.59, "timestamp": "03:32:13", "text": "ありがたいことに、実物の写真とかは一切なかった。"}, {"type": "subtitle", "time": 12736.309, "timestamp": "03:32:16", "text": "何てことだ、"}, {"type": "subtitle", "time": 12738.389, "timestamp": "03:32:18", "text": "なぜ電話なのか？"}, {"type": "subtitle", "time": 12742.229, "timestamp": "03:32:22", "text": "なぜ私の携帯電話がPCに接続されているのですか？"}, {"type": "subtitle", "time": 12743.91, "timestamp": "03:32:23", "text": "でも、まあ、私は写真を撮るわけじゃないんだけどね。"}, {"type": "subtitle", "time": 12745.83, "timestamp": "03:32:25", "text": "私自身について。それは良いことだ。ああ、"}, {"type": "subtitle", "time": 12748.63, "timestamp": "03:32:28", "text": "神。ありがたいことに、それはまるで"}, {"type": "subtitle", "time": 12751.269, "timestamp": "03:32:31", "text": "全体のスクリーンショット"}, {"type": "subtitle", "time": 12754.15, "timestamp": "03:32:34", "text": "支払い。支払いではなく、"}, {"type": "subtitle", "time": 12756.309, "timestamp": "03:32:36", "text": "商品の詳細と"}, {"type": "subtitle", "time": 12760.309, "timestamp": "03:32:40", "text": "すべて。それはいいです。それは良い。"}, {"type": "subtitle", "time": 12765.83, "timestamp": "03:32:45", "text": "それで、えっと、これを武器にする。えっと、どうすれば"}, {"type": "subtitle", "time": 12769.19, "timestamp": "03:32:49", "text": "肌を変える？"}, {"type": "subtitle", "time": 12771.67, "timestamp": "03:32:51", "text": "かっこいい。これ。私はこれら全てを手に入れました"}, {"type": "subtitle", "time": 12774.55, "timestamp": "03:32:54", "text": "Twitchドロップからのスキン"}, {"type": "subtitle", "time": 12778.95, "timestamp": "03:32:58", "text": "私は見ています。完全に終わりました。あなたが"}]
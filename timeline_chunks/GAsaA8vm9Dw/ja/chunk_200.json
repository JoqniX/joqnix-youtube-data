[{"type": "subtitle", "time": 12001.83, "timestamp": "03:20:01", "text": "数人。"}, {"type": "subtitle", "time": 12004.389, "timestamp": "03:20:04", "text": "硬いです。だから彼もまた"}, {"type": "subtitle", "time": 12006.87, "timestamp": "03:20:06", "text": "私が伝えなければならないこと。"}, {"type": "subtitle", "time": 12008.389, "timestamp": "03:20:08", "text": "それで"}, {"type": "subtitle", "time": 12011.99, "timestamp": "03:20:11", "text": "そうですね、それでは終わりにします。"}, {"type": "subtitle", "time": 12015.03, "timestamp": "03:20:15", "text": "とりあえず、今日はここまでにしておきます。"}, {"type": "subtitle", "time": 12017.349, "timestamp": "03:20:17", "text": "うん。"}, {"type": "subtitle", "time": 12020.63, "timestamp": "03:20:20", "text": "また会おうね"}, {"type": "subtitle", "time": 12027.269, "timestamp": "03:20:27", "text": "m."}, {"type": "subtitle", "time": 12030.71, "timestamp": "03:20:30", "text": "ということで、改めて感謝の気持ちを伝えたいと思います。"}, {"type": "subtitle", "time": 12033.269, "timestamp": "03:20:33", "text": "今日は来てくれてありがとう。"}, {"type": "subtitle", "time": 12035.99, "timestamp": "03:20:35", "text": "そして、来てくださった皆様に感謝申し上げます。"}, {"type": "subtitle", "time": 12037.91, "timestamp": "03:20:37", "text": "による。"}, {"type": "subtitle", "time": 12040.63, "timestamp": "03:20:40", "text": "それはヤンですね。お越しいただきありがとうございました。"}, {"type": "subtitle", "time": 12043.11, "timestamp": "03:20:43", "text": "による。ジョーン・エドワードさん、お越しいただきありがとうございます。"}, {"type": "subtitle", "time": 12047.269, "timestamp": "03:20:47", "text": "による。ゲーマー猫さん、来てくれてありがとう。"}, {"type": "subtitle", "time": 12049.349, "timestamp": "03:20:49", "text": "そして、面白い動画もいくつかご紹介します。ありがとうございます"}, {"type": "subtitle", "time": 12052.63, "timestamp": "03:20:52", "text": "そちらも来ます。ゲーマー猫と面白い"}, {"type": "subtitle", "time": 12054.95, "timestamp": "03:20:54", "text": "あなた向けの動画は、新しい人々に向けたものです"}, {"type": "subtitle", "time": 12058.15, "timestamp": "03:20:58", "text": "立ち寄って、ちょっと立ち寄った。"}, {"type": "subtitle", "time": 12059.91, "timestamp": "03:20:59", "text": "配信をご覧いただきありがとうございます。"}]
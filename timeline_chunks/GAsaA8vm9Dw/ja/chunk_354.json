[{"type": "subtitle", "time": 21240.948, "timestamp": "05:54:00", "text": "行くよ。"}, {"type": "subtitle", "time": 21258.31, "timestamp": "05:54:18", "text": "たまにはとんでもないジョッキーに当たることもあるよね。"}, {"type": "subtitle", "time": 21260.708, "timestamp": "05:54:20", "text": "それで"}, {"type": "subtitle", "time": 21269.03, "timestamp": "05:54:29", "text": "なに忍者。あなたは"}, {"type": "subtitle", "time": 21271.43, "timestamp": "05:54:31", "text": "からかいの冗談を楽しんでいる。彼らはいつも"}, {"type": "subtitle", "time": 21273.67, "timestamp": "05:54:33", "text": "あのいたずらっぽい笑み、そうでしょう？"}, {"type": "subtitle", "time": 21275.51, "timestamp": "05:54:35", "text": "彼らは素晴らしいリーダーであり友人であり、"}, {"type": "subtitle", "time": 21278.23, "timestamp": "05:54:38", "text": "彼らがそばにいてくれて嬉しい。さあ"}, {"type": "subtitle", "time": 21281.35, "timestamp": "05:54:41", "text": "楽しさと仲間意識を維持し続けよう。開ける"}]
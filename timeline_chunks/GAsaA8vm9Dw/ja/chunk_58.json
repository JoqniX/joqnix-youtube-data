[{"type": "subtitle", "time": 3487.03, "timestamp": "00:58:07", "text": "まあ、それは彼が歩いて行ったのが悪いんだ"}, {"type": "subtitle", "time": 3490.15, "timestamp": "00:58:10", "text": "私の手榴弾。"}, {"type": "subtitle", "time": 3510.95, "timestamp": "00:58:30", "text": "何てことだ。大規模な火災。"}, {"type": "subtitle", "time": 3512.87, "timestamp": "00:58:32", "text": "複数のクソ野郎から撃たれてる"}, {"type": "subtitle", "time": 3536.39, "timestamp": "00:58:56", "text": "対テロリスト。"}]
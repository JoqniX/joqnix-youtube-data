[{"type": "subtitle", "time": 3241.75, "timestamp": "00:54:01", "text": "ジョック。急いで。私はあなたのすぐ後ろにいます。"}, {"type": "subtitle", "time": 3244.23, "timestamp": "00:54:04", "text": "兄弟。どうでも。私はすぐ後ろにはいない"}, {"type": "subtitle", "time": 3246.39, "timestamp": "00:54:06", "text": "もう君じゃない。"}, {"type": "subtitle", "time": 3256.069, "timestamp": "00:54:16", "text": "もう君にあげる弾丸はない、"}, {"type": "subtitle", "time": 3259.03, "timestamp": "00:54:19", "text": "兄弟。"}, {"type": "subtitle", "time": 3266.549, "timestamp": "00:54:26", "text": "彼は今、バナナナックルズって言ったの？待って、"}, {"type": "subtitle", "time": 3294.79, "timestamp": "00:54:54", "text": "いや。ちくしょう。私はモリーを投げていた。私"}, {"type": "subtitle", "time": 3297.589, "timestamp": "00:54:57", "text": "後ろから誰かが来る気配を感じた。"}]
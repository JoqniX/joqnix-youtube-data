[{"type": "subtitle", "time": 5613.35, "timestamp": "01:33:33", "text": "私が1位です。わーい。痛みの列車。その通り。"}, {"type": "subtitle", "time": 5615.83, "timestamp": "01:33:35", "text": "ピザの力。"}, {"type": "subtitle", "time": 5618.39, "timestamp": "01:33:38", "text": "うん。"}, {"type": "subtitle", "time": 5633.669, "timestamp": "01:33:53", "text": "B9"}, {"type": "subtitle", "time": 5637.11, "timestamp": "01:33:57", "text": "ピザなしでは人生は成り立たない。ピザは"}, {"type": "subtitle", "time": 5639.99, "timestamp": "01:33:59", "text": "うふふ。"}]
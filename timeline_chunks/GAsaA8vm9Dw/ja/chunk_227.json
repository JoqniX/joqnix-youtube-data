[{"type": "subtitle", "time": 13624.309, "timestamp": "03:47:04", "text": "私はどんな銃を持っていますか？何"}, {"type": "subtitle", "time": 13627.269, "timestamp": "03:47:07", "text": "安全地帯にいる？"}, {"type": "subtitle", "time": 13635.349, "timestamp": "03:47:15", "text": "あ、待って。それは、ああ、気にしないでください。"}, {"type": "subtitle", "time": 13648.389, "timestamp": "03:47:28", "text": "うん。こんにちは。"}, {"type": "subtitle", "time": 13673.67, "timestamp": "03:47:53", "text": "そう思った。それは愚かな行為だった。みんな"}]
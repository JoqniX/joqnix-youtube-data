[{"type": "subtitle", "time": 3133.829, "timestamp": "00:52:13", "text": "Bを押すのか、それとも何が起こるのか"}, {"type": "subtitle", "time": 3137.03, "timestamp": "00:52:17", "text": "の上？ああ、しまった。 O. すべて"}, {"type": "subtitle", "time": 3149.67, "timestamp": "00:52:29", "text": "いいえ。一瞬目をそらしただけで、"}, {"type": "subtitle", "time": 3165.51, "timestamp": "00:52:45", "text": "彼は弾切れだ。"}, {"type": "subtitle", "time": 3172.23, "timestamp": "00:52:52", "text": "爆弾が仕掛けられた。"}]
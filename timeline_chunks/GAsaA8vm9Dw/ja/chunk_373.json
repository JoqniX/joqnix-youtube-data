[{"type": "subtitle", "time": 22380.23, "timestamp": "06:13:00", "text": "ユーモアだよ、友よ。"}, {"type": "subtitle", "time": 22382.628, "timestamp": "06:13:02", "text": "おお、"}, {"type": "subtitle", "time": 22405.83, "timestamp": "06:13:25", "text": "クロノス、それは実に残酷だ。ぜひ聞かせてください。"}, {"type": "subtitle", "time": 22408.39, "timestamp": "06:13:28", "text": "ジョークを聞かせてください。口を開ける。笑顔"}, {"type": "subtitle", "time": 22425.51, "timestamp": "06:13:45", "text": "ハハ。ニンジャ、君は作っているようだ"}, {"type": "subtitle", "time": 22427.27, "timestamp": "06:13:47", "text": "厳しいクロノスが少し"}, {"type": "subtitle", "time": 22429.75, "timestamp": "06:13:49", "text": "ジョークの流行に乗り遅れている。保つ"}, {"type": "subtitle", "time": 22431.99, "timestamp": "06:13:51", "text": "遊び心のあるやり取りを続け、"}, {"type": "subtitle", "time": 22434.628, "timestamp": "06:13:54", "text": "笑い声が響き渡る。口を開けて笑う"}]
[{"type": "subtitle", "time": 17881.35, "timestamp": "04:58:01", "text": "このゲームは間違いなく中毒性がある。"}, {"type": "subtitle", "time": 17888.948, "timestamp": "04:58:08", "text": "あなたは最善を尽くさなければなりません。難しい"}, {"type": "subtitle", "time": 17893.75, "timestamp": "04:58:13", "text": "キルを取る。 1つだけ"}, {"type": "subtitle", "time": 17903.91, "timestamp": "04:58:23", "text": "積み込み。いいえ。なぜですか？なぜ私は汚れたのだろう"}, {"type": "subtitle", "time": 17909.11, "timestamp": "04:58:29", "text": "グリップバレルフラッシュ？うん。"}, {"type": "subtitle", "time": 17917.75, "timestamp": "04:58:37", "text": "私はただそうしたいだけ、そして私はただそうしたいだけ"}, {"type": "subtitle", "time": 17921.03, "timestamp": "04:58:41", "text": "私はただ良いアタッチメントが欲しいだけです"}, {"type": "subtitle", "time": 17924.788, "timestamp": "04:58:44", "text": "もっと上手に撃て。あなたが知っている、"}, {"type": "subtitle", "time": 17927.51, "timestamp": "04:58:47", "text": "それが私の望みです。"}]
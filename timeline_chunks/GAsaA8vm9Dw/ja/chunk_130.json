[{"type": "subtitle", "time": 7800.95, "timestamp": "02:10:00", "text": "もしかしたら、サポートに頼むか"}, {"type": "subtitle", "time": 7804.95, "timestamp": "02:10:04", "text": "何か。まあ、そうですね。"}, {"type": "subtitle", "time": 7807.669, "timestamp": "02:10:07", "text": "パンダを知っていますか？"}, {"type": "subtitle", "time": 7816.229, "timestamp": "02:10:16", "text": "彼ら"}, {"type": "subtitle", "time": 7819.109, "timestamp": "02:10:19", "text": "新鮮な"}, {"type": "subtitle", "time": 7822.31, "timestamp": "02:10:22", "text": "ドライポーン？これは何ですか？"}, {"type": "subtitle", "time": 7825.43, "timestamp": "02:10:25", "text": "質屋は新鮮で理想的に使用されます"}, {"type": "subtitle", "time": 7833.75, "timestamp": "02:10:33", "text": "伝統的で豪華で伝統的"}, {"type": "subtitle", "time": 7836.149, "timestamp": "02:10:36", "text": "RNA。"}, {"type": "subtitle", "time": 7839.83, "timestamp": "02:10:39", "text": "これらはスパイスのように光るものですか、それとも"}, {"type": "subtitle", "time": 7843.43, "timestamp": "02:10:43", "text": "甘い？何が何だか分かるだろうか？ああ、私は見たことがある"}, {"type": "subtitle", "time": 7845.43, "timestamp": "02:10:45", "text": "この人々。わかった。わかった。わかった。わかった。それで、"}, {"type": "subtitle", "time": 7848.069, "timestamp": "02:10:48", "text": "これは葉っぱのように食べるものです"}, {"type": "subtitle", "time": 7850.87, "timestamp": "02:10:50", "text": "あるいは何か、そしてビットアウトまたは"}, {"type": "subtitle", "time": 7854.55, "timestamp": "02:10:54", "text": "何か。私は次のような人たちを見ていました"}, {"type": "subtitle", "time": 7859.589, "timestamp": "02:10:59", "text": "路上では、彼らはこれを持っている"}]
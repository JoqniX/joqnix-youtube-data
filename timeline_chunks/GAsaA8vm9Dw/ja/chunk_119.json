[{"type": "subtitle", "time": 7141.35, "timestamp": "01:59:01", "text": "[音楽]"}, {"type": "subtitle", "time": 7143.03, "timestamp": "01:59:03", "text": "わかった。通りかかったすべての人々"}, {"type": "subtitle", "time": 7146.95, "timestamp": "01:59:06", "text": "今日、ああ、永遠の闇が息子をもたらした"}, {"type": "subtitle", "time": 7149.99, "timestamp": "01:59:09", "text": "今日は行けたし、暗かった"}, {"type": "subtitle", "time": 7152.709, "timestamp": "01:59:12", "text": "息子が私のチャンネルに初めて来た場合、"}, {"type": "subtitle", "time": 7156.55, "timestamp": "01:59:16", "text": "正解です、どうもありがとうございました、闇よ"}, {"type": "subtitle", "time": 7159.669, "timestamp": "01:59:19", "text": "ストリームに来てくれたことに感謝"}, {"type": "subtitle", "time": 7162.47, "timestamp": "01:59:22", "text": "そして全て、そして私も休む"}, {"type": "subtitle", "time": 7165.51, "timestamp": "01:59:25", "text": "起きて、あなたは疲れているに違いない"}, {"type": "subtitle", "time": 7169.35, "timestamp": "01:59:29", "text": "ストリームはいいえ、私は休むことはありません。"}, {"type": "subtitle", "time": 7171.109, "timestamp": "01:59:31", "text": "でもそうだね"}, {"type": "subtitle", "time": 7173.589, "timestamp": "01:59:33", "text": "お越しいただきありがとうございます。"}, {"type": "subtitle", "time": 7175.75, "timestamp": "01:59:35", "text": "コンステラス。"}, {"type": "subtitle", "time": 7179.27, "timestamp": "01:59:39", "text": "Constellは私のファンネームです"}, {"type": "subtitle", "time": 7183.16, "timestamp": "01:59:43", "text": "コンステラ、別名コンサートプレート"}, {"type": "subtitle", "time": 7185.83, "timestamp": "01:59:45", "text": "[音楽]"}, {"type": "subtitle", "time": 7187.669, "timestamp": "01:59:47", "text": "来てくれてありがとう"}, {"type": "subtitle", "time": 7189.99, "timestamp": "01:59:49", "text": "今日もフォローしてください。"}, {"type": "subtitle", "time": 7193.91, "timestamp": "01:59:53", "text": "今日はあなたの演技を観ていて本当に楽しかったです。私"}, {"type": "subtitle", "time": 7196.31, "timestamp": "01:59:56", "text": "やり方を本当にたくさん学びました"}, {"type": "subtitle", "time": 7198.229, "timestamp": "01:59:58", "text": "アニメーション関連のものや今日のライブなど"}]
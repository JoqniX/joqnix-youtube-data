[{"type": "subtitle", "time": 9540.389, "timestamp": "02:39:00", "text": "よし、金のローンとかから"}, {"type": "subtitle", "time": 9542.63, "timestamp": "02:39:02", "text": "何か。何でも"}, {"type": "subtitle", "time": 9545.91, "timestamp": "02:39:05", "text": "そうだったのか？彼はそれを私のものにした"}, {"type": "subtitle", "time": 9548.469, "timestamp": "02:39:08", "text": "念のためアカウントを保持して、1つだけ保管します"}, {"type": "subtitle", "time": 9552.15, "timestamp": "02:39:12", "text": "日なので、彼はそれを元に戻して"}, {"type": "subtitle", "time": 9554.63, "timestamp": "02:39:14", "text": "何が起こったと思いますか？"}, {"type": "subtitle", "time": 9557.51, "timestamp": "02:39:17", "text": "ハッカーは、"}, {"type": "subtitle", "time": 9565.19, "timestamp": "02:39:25", "text": "そして私はこう思う"}, {"type": "subtitle", "time": 9573.11, "timestamp": "02:39:33", "text": "世界で？私はパニック状態だった。"}, {"type": "subtitle", "time": 9575.11, "timestamp": "02:39:35", "text": "昔は本当にたくさんのことがあった、"}, {"type": "subtitle", "time": 9581.429, "timestamp": "02:39:41", "text": "そして私は、はい、クッキーがハッキングされたか、"}, {"type": "subtitle", "time": 9588.07, "timestamp": "02:39:48", "text": "ええ、ブラウザのクッキーから、"}]
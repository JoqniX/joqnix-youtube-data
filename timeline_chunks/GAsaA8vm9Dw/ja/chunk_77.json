[{"type": "subtitle", "time": 4622.87, "timestamp": "01:17:02", "text": "はい、以上です。わかりました、では"}, {"type": "subtitle", "time": 4625.99, "timestamp": "01:17:05", "text": "見る。えっと、俺の男はどこだ？だから私は"}, {"type": "subtitle", "time": 4629.669, "timestamp": "01:17:09", "text": "このオジョを銀行に預けるのを見ています"}, {"type": "subtitle", "time": 4631.83, "timestamp": "01:17:11", "text": "それから"}, {"type": "subtitle", "time": 4634.63, "timestamp": "01:17:14", "text": "プロトコル。それはFPSのようなものですね"}, {"type": "subtitle", "time": 4637.03, "timestamp": "01:17:17", "text": "ヴァレリンは、ある種のゲームアニメです。"}, {"type": "subtitle", "time": 4641.189, "timestamp": "01:17:21", "text": "それは良い。そして、引き寄せのきおき、えっと、これ"}, {"type": "subtitle", "time": 4645.669, "timestamp": "01:17:25", "text": "えっと、この吸血鬼のお姫様アニメ。それから、えーと"}, {"type": "subtitle", "time": 4649.189, "timestamp": "01:17:29", "text": "それからバックのアニメは"}, {"type": "subtitle", "time": 4653.75, "timestamp": "01:17:33", "text": "新たに放送開始。それから、ハマツ奥王国"}, {"type": "subtitle", "time": 4655.83, "timestamp": "01:17:35", "text": "遺跡の。ええ、見ていますよ。私"}, {"type": "subtitle", "time": 4659.27, "timestamp": "01:17:39", "text": "漫画も読んでみてください。そしてVR"}, {"type": "subtitle", "time": 4663.11, "timestamp": "01:17:43", "text": "MMOのカツドキもやってるよ。"}, {"type": "subtitle", "time": 4666.87, "timestamp": "01:17:46", "text": "ミッキー・トーリ、それからパート2"}, {"type": "subtitle", "time": 4670.55, "timestamp": "01:17:50", "text": "えっと、これは何て言うんだっけ"}, {"type": "subtitle", "time": 4672.709, "timestamp": "01:17:52", "text": "これ？もう片方。ああ、悪魔だ"}, {"type": "subtitle", "time": 4675.11, "timestamp": "01:17:55", "text": "あなたが言及した魔王の剣"}, {"type": "subtitle", "time": 4678.31, "timestamp": "01:17:58", "text": "それから100コジャウ"}]
[{"type": "subtitle", "time": 542.949, "timestamp": "00:09:02", "text": "よし。"}, {"type": "subtitle", "time": 552.389, "timestamp": "00:09:12", "text": "あなたのDiscordアカウントは何ですか？えっと、"}, {"type": "subtitle", "time": 555.11, "timestamp": "00:09:15", "text": "ポートフォリオを送る必要はありません。"}, {"type": "subtitle", "time": 558.23, "timestamp": "00:09:18", "text": "実際、"}, {"type": "subtitle", "time": 560.71, "timestamp": "00:09:20", "text": "あなたは必要ない 私はできない 私はしない"}, {"type": "subtitle", "time": 569.43, "timestamp": "00:09:29", "text": "いいえ、参加やいいねを送る必要はありません"}, {"type": "subtitle", "time": 573.19, "timestamp": "00:09:33", "text": "またGFSスポットを蹴り飛ばす。だからもしあなたが"}, {"type": "subtitle", "time": 574.87, "timestamp": "00:09:34", "text": "1つ"}, {"type": "subtitle", "time": 577.35, "timestamp": "00:09:37", "text": "ああ、蹴られてもいいけど"}, {"type": "subtitle", "time": 579.11, "timestamp": "00:09:39", "text": "繰り返しますが、自己宣伝はしないでください。"}, {"type": "subtitle", "time": 582.55, "timestamp": "00:09:42", "text": "ちなみに、ジョン、それは規則違反だよ"}, {"type": "subtitle", "time": 589.75, "timestamp": "00:09:49", "text": "[音楽]"}, {"type": "subtitle", "time": 594.389, "timestamp": "00:09:54", "text": "こんにちは、誕生日を迎えた本人です。"}, {"type": "subtitle", "time": 598.87, "timestamp": "00:09:58", "text": "こんにちは、誕生日を迎えた者です。"}]
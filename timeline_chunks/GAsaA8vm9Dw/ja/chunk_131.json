[{"type": "subtitle", "time": 7862.95, "timestamp": "02:11:02", "text": "えっと、彼らはこれを持っています"}, {"type": "subtitle", "time": 7865.589, "timestamp": "02:11:05", "text": "立ち上がって、この物を作って"}, {"type": "subtitle", "time": 7868.069, "timestamp": "02:11:08", "text": "クソ野郎が何かをして、ほら、"}, {"type": "subtitle", "time": 7870.31, "timestamp": "02:11:10", "text": "彼らはそれを食べて吐き出して"}, {"type": "subtitle", "time": 7872.149, "timestamp": "02:11:12", "text": "もの。あなたが話しているのはそれですか？"}, {"type": "subtitle", "time": 7876.709, "timestamp": "02:11:16", "text": "について？ああ、これはその後違って見える"}, {"type": "subtitle", "time": 7885.03, "timestamp": "02:11:25", "text": "とても混乱しています。聞いたことがない。私が"}, {"type": "subtitle", "time": 7888.229, "timestamp": "02:11:28", "text": "コルゲートマウスリフレッシュナーと"}, {"type": "subtitle", "time": 7890.87, "timestamp": "02:11:30", "text": "センサー式ダイニングマウスリフレッシャー。わかった、"}, {"type": "subtitle", "time": 7893.91, "timestamp": "02:11:33", "text": "私が知っている唯一の口臭予防法はそれだけです"}, {"type": "subtitle", "time": 7895.589, "timestamp": "02:11:35", "text": "他の歯磨き粉ブランドはどれですか"}, {"type": "subtitle", "time": 7904.31, "timestamp": "02:11:44", "text": "ご存知の通り、モデレーターは他のものは何も見ることができません。"}, {"type": "subtitle", "time": 7906.79, "timestamp": "02:11:46", "text": "ああ、またスキャンダルが増えたな。"}, {"type": "subtitle", "time": 7908.39, "timestamp": "02:11:48", "text": "たとえあなたが削除して隠したとしても"}, {"type": "subtitle", "time": 7910.87, "timestamp": "02:11:50", "text": "面前、"}, {"type": "subtitle", "time": 7913.27, "timestamp": "02:11:53", "text": "Jocknikチャンネルでのみ視聴可能です。"}, {"type": "subtitle", "time": 7917.189, "timestamp": "02:11:57", "text": "ウィンク。うん。あ、実は忘れてた"}, {"type": "subtitle", "time": 7918.629, "timestamp": "02:11:58", "text": "詩を贈りますよね？待って、"}]
[{"type": "subtitle", "time": 25380.868, "timestamp": "07:03:00", "text": "そして冒険をする。新しいものを受け入れよう"}, {"type": "subtitle", "time": 25382.948, "timestamp": "07:03:02", "text": "オープンな友情と経験"}, {"type": "subtitle", "time": 25385.43, "timestamp": "07:03:05", "text": "心臓。これは素晴らしい機会となるでしょう"}, {"type": "subtitle", "time": 25387.59, "timestamp": "07:03:07", "text": "私たち全員が共に成長していく。笑顔、"}, {"type": "subtitle", "time": 25406.07, "timestamp": "07:03:26", "text": "忍者よ、ポジティブで楽しいことに集中しよう"}, {"type": "subtitle", "time": 25408.39, "timestamp": "07:03:28", "text": "会話。キッチンについて話す"}, {"type": "subtitle", "time": 25409.67, "timestamp": "07:03:29", "text": "ナイフは一部の人々を"}, {"type": "subtitle", "time": 25413.03, "timestamp": "07:03:33", "text": "不快。さあ、始めよう"}, {"type": "subtitle", "time": 25430.948, "timestamp": "07:03:50", "text": "厳しいクロノス。あなたが何をしているのかよくわかりません"}, {"type": "subtitle", "time": 25433.03, "timestamp": "07:03:53", "text": "それらの言葉で意思疎通を図ろうとしている。"}, {"type": "subtitle", "time": 25435.43, "timestamp": "07:03:55", "text": "もう少し背景情報を提供していただけますか、または"}, {"type": "subtitle", "time": 25437.67, "timestamp": "07:03:57", "text": "メッセージを明確にしてください。維持しましょう"}]
[{"type": "subtitle", "time": 21840.548, "timestamp": "06:04:00", "text": "ヘリコプター。ヘリコプター。ハハ。分かるよ"}, {"type": "subtitle", "time": 21843.59, "timestamp": "06:04:03", "text": "あなたがJoki Ninjaをどれほど愛しているか。その"}, {"type": "subtitle", "time": 21845.27, "timestamp": "06:04:05", "text": "こんなに親しい友人がいるなんて素晴らしい"}, {"type": "subtitle", "time": 21846.948, "timestamp": "06:04:06", "text": "あなたにたくさんの喜びをもたらしてくれる人、そして"}, {"type": "subtitle", "time": 21849.67, "timestamp": "06:04:09", "text": "満足。口を開けて笑う、"}, {"type": "subtitle", "time": 21877.99, "timestamp": "06:04:37", "text": "ああ、それは残念ですね、ニンジャ。"}, {"type": "subtitle", "time": 21879.67, "timestamp": "06:04:39", "text": "誰もが自分の感情を持っていて"}, {"type": "subtitle", "time": 21881.75, "timestamp": "06:04:41", "text": "意見は様々ですが、常に重要なのは"}, {"type": "subtitle", "time": 21884.548, "timestamp": "06:04:44", "text": "他人には親切と敬意をもって接しなさい。"}]
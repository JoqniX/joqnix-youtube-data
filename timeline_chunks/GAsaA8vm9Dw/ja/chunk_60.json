[{"type": "subtitle", "time": 3603.03, "timestamp": "01:00:03", "text": "ああ、クリップがない。"}, {"type": "subtitle", "time": 3605.109, "timestamp": "01:00:05", "text": "それは何ですか？"}, {"type": "subtitle", "time": 3616.789, "timestamp": "01:00:16", "text": "植えたんだよ、坊や。あなたはそうすべきではないと思います"}, {"type": "subtitle", "time": 3619.03, "timestamp": "01:00:19", "text": "今すぐ植えましょう。私はあなたが"}, {"type": "subtitle", "time": 3621.43, "timestamp": "01:00:21", "text": "今すぐそうするべきだ。"}, {"type": "subtitle", "time": 3624.549, "timestamp": "01:00:24", "text": "ああ、大変だ、やらかしてしまった。計画の立て方"}, {"type": "subtitle", "time": 3626.87, "timestamp": "01:00:26", "text": "けれど？では、どのように計画を立てれば良いのでしょうか？私は"}, {"type": "subtitle", "time": 3631.109, "timestamp": "01:00:31", "text": "大佐。ほとんどの鶏が殺された。"}, {"type": "subtitle", "time": 3634.23, "timestamp": "01:00:34", "text": "さあ行こう。"}, {"type": "subtitle", "time": 3637.349, "timestamp": "01:00:37", "text": "何てことだ。よし。いい試合だったよ。"}, {"type": "subtitle", "time": 3640.789, "timestamp": "01:00:40", "text": "同伴させてくれてありがとう、B。"}, {"type": "subtitle", "time": 3643.19, "timestamp": "01:00:43", "text": "私はチャットに行く、そして"}, {"type": "subtitle", "time": 3646.069, "timestamp": "01:00:46", "text": "眠れ、少年。はい。はい。良い一日を"}, {"type": "subtitle", "time": 3649.109, "timestamp": "01:00:49", "text": "誕生日。はい。楽しむ。"}, {"type": "subtitle", "time": 3656.47, "timestamp": "01:00:56", "text": "それは"}, {"type": "subtitle", "time": 3659.349, "timestamp": "01:00:59", "text": "あれはミナだった。"}]
[{"type": "subtitle", "time": 9902.55, "timestamp": "02:45:02", "text": "私たちはゲームをプレイすることすらできなかった。それは"}, {"type": "subtitle", "time": 9906.389, "timestamp": "02:45:06", "text": "それが何であるか。でも、大丈夫です。完全に"}, {"type": "subtitle", "time": 9912.389, "timestamp": "02:45:12", "text": "それが現実さ。それで、私たちは"}, {"type": "subtitle", "time": 9915.03, "timestamp": "02:45:15", "text": "まあ、そうでしょうね。わからない"}, {"type": "subtitle", "time": 9918.309, "timestamp": "02:45:18", "text": "どんな手ですか"}, {"type": "subtitle", "time": 9922.469, "timestamp": "02:45:22", "text": "ええ、でもまあ、"}, {"type": "subtitle", "time": 9924.55, "timestamp": "02:45:24", "text": "痛みですが、"}, {"type": "subtitle", "time": 9927.59, "timestamp": "02:45:27", "text": "私もある程度理解できます"}, {"type": "subtitle", "time": 9930.15, "timestamp": "02:45:30", "text": "何らかの形で。だから、私はある程度できる"}, {"type": "subtitle", "time": 9935.99, "timestamp": "02:45:35", "text": "うん、"}, {"type": "subtitle", "time": 9947.269, "timestamp": "02:45:47", "text": "はい。"}, {"type": "subtitle", "time": 9950.87, "timestamp": "02:45:50", "text": "ああ、でもそうだね、"}, {"type": "subtitle", "time": 9954.23, "timestamp": "02:45:54", "text": "ええと、"}, {"type": "subtitle", "time": 9957.269, "timestamp": "02:45:57", "text": "えっと、じゃあ他にどんなゲームが欲しいかな"}, {"type": "subtitle", "time": 9959.59, "timestamp": "02:45:59", "text": "遊ぶ？"}]
[{"type": "subtitle", "time": 8161.51, "timestamp": "02:16:01", "text": "ゆっくり休んでくださいね。わかった。"}, {"type": "subtitle", "time": 8163.91, "timestamp": "02:16:03", "text": "星空を見上げるとき、あなたは夢を見ますか？"}, {"type": "subtitle", "time": 8184.55, "timestamp": "02:16:24", "text": "輝く星、あなたが見るとき、"}, {"type": "subtitle", "time": 8209.11, "timestamp": "02:16:49", "text": "私はホンダのビデオを1つ見ました"}, {"type": "subtitle", "time": 8215.83, "timestamp": "02:16:55", "text": "おお、"}, {"type": "subtitle", "time": 8218.87, "timestamp": "02:16:58", "text": "5000人が途中で姿を消した"}]
[{"type": "subtitle", "time": 22032.628, "timestamp": "06:07:12", "text": "最強のライブについてはよくわかりません"}, {"type": "subtitle", "time": 22034.868, "timestamp": "06:07:14", "text": "チャットですが、ギガチャットはかなり"}, {"type": "subtitle", "time": 22037.59, "timestamp": "06:07:17", "text": "強力だ。おそらくこれは、"}, {"type": "subtitle", "time": 22040.47, "timestamp": "06:07:20", "text": "壮大な会話。口を開けて、笑って、"}, {"type": "subtitle", "time": 22058.15, "timestamp": "06:07:38", "text": "もちろんだよ、ニンジャ。あなたに一つ。"}, {"type": "subtitle", "time": 22060.948, "timestamp": "06:07:40", "text": "科学者はなぜテストしないのか？"}, {"type": "subtitle", "time": 22063.51, "timestamp": "06:07:43", "text": "すべてを構成する。口を開けて笑う"}]
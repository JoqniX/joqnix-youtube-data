[{"type": "subtitle", "time": 8341.91, "timestamp": "02:19:01", "text": "とても楽しかった。楽しかったです。"}, {"type": "subtitle", "time": 8343.429, "timestamp": "02:19:03", "text": "[音楽]"}, {"type": "subtitle", "time": 8346.23, "timestamp": "02:19:06", "text": "終わりたくないけれど、終わらせなければならない。"}, {"type": "subtitle", "time": 8348.15, "timestamp": "02:19:08", "text": "いいえ。"}, {"type": "subtitle", "time": 8351.99, "timestamp": "02:19:11", "text": "だから、みんなを抱きしめて寝かしつけることにするよ。"}, {"type": "subtitle", "time": 8357.03, "timestamp": "02:19:17", "text": "えっと、ベッドで寝ている間に"}, {"type": "subtitle", "time": 8360.309, "timestamp": "02:19:20", "text": "残りの夜を楽しんでくださいね。"}, {"type": "subtitle", "time": 8363.349, "timestamp": "02:19:23", "text": "そして、良い良い日が来ることを願っています"}, {"type": "subtitle", "time": 8366.469, "timestamp": "02:19:26", "text": "火曜日の朝。ショーで会いましょう"}, {"type": "subtitle", "time": 8369.589, "timestamp": "02:19:29", "text": "朝。わかった。午前6時か7時頃"}, {"type": "subtitle", "time": 8372.629, "timestamp": "02:19:32", "text": "起きて起きて。私がしなければならない"}, {"type": "subtitle", "time": 8376.23, "timestamp": "02:19:36", "text": "私はそうします、私はそうします"}, {"type": "subtitle", "time": 8378.709, "timestamp": "02:19:38", "text": "えっと、歌うのは兄貴分です"}, {"type": "subtitle", "time": 8381.349, "timestamp": "02:19:41", "text": "ストリーミング配信も恥ずかしいでしょう"}, {"type": "subtitle", "time": 8383.669, "timestamp": "02:19:43", "text": "私にとっては"}, {"type": "subtitle", "time": 8387.27, "timestamp": "02:19:47", "text": "えっと、Twitchは初めてになります"}, {"type": "subtitle", "time": 8389.27, "timestamp": "02:19:49", "text": "えっと、僕は歌を歌ってるんだ"}, {"type": "subtitle", "time": 8396.469, "timestamp": "02:19:56", "text": "どうなるか分からない、怖い"}, {"type": "subtitle", "time": 8398.71, "timestamp": "02:19:58", "text": "みんなが私を批判したりしないことを願っています"}]
[{"type": "subtitle", "time": 10742.63, "timestamp": "02:59:02", "text": "えーと、えーと、いくつか"}, {"type": "subtitle", "time": 10744.95, "timestamp": "02:59:04", "text": "さまざまな方法"}, {"type": "subtitle", "time": 10747.59, "timestamp": "02:59:07", "text": "どれの"}, {"type": "subtitle", "time": 10752.389, "timestamp": "02:59:12", "text": "ええ、いつも日本側なんです"}, {"type": "subtitle", "time": 10755.19, "timestamp": "02:59:15", "text": "新たなトレンドや"}, {"type": "subtitle", "time": 10758.71, "timestamp": "02:59:18", "text": "こんな感じ。"}, {"type": "subtitle", "time": 10761.59, "timestamp": "02:59:21", "text": "いくつか見てみると"}, {"type": "subtitle", "time": 10764.469, "timestamp": "02:59:24", "text": "彼らが選んだものをいくつか見ました"}, {"type": "subtitle", "time": 10770.23, "timestamp": "02:59:30", "text": "正直に言うと、それは本当に事実です"}, {"type": "subtitle", "time": 10776.71, "timestamp": "02:59:36", "text": "彼らがどうやって思いつくかは実際にはクールです"}, {"type": "subtitle", "time": 10779.59, "timestamp": "02:59:39", "text": "そのような考え。"}, {"type": "subtitle", "time": 10781.51, "timestamp": "02:59:41", "text": "のように"}, {"type": "subtitle", "time": 10785.51, "timestamp": "02:59:45", "text": "実際のゲームをプレイするのと同じような感じ"}, {"type": "subtitle", "time": 10787.349, "timestamp": "02:59:47", "text": "のように"}, {"type": "subtitle", "time": 10794.55, "timestamp": "02:59:54", "text": "彼はこの親密さを保ちつつ"}, {"type": "subtitle", "time": 10797.03, "timestamp": "02:59:57", "text": "顔も何もかもが正しいヒゲ少年"}]
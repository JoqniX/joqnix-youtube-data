[{"type": "subtitle", "time": 2231.43, "timestamp": "00:37:11", "text": "勝つ。"}, {"type": "subtitle", "time": 2233.43, "timestamp": "00:37:13", "text": "GG。"}, {"type": "subtitle", "time": 2236.069, "timestamp": "00:37:16", "text": "おかえり。私はまだあなたを連れて行くことができません"}, {"type": "subtitle", "time": 2239.43, "timestamp": "00:37:19", "text": "真剣に言うと、モーって言うんだよ。"}, {"type": "subtitle", "time": 2243.19, "timestamp": "00:37:23", "text": "わかった。どういう意味ですか？ああ、それは"}, {"type": "subtitle", "time": 2245.349, "timestamp": "00:37:25", "text": "もの。どうやって言うのをやめればいいのかわからない"}, {"type": "subtitle", "time": 2256.31, "timestamp": "00:37:36", "text": "ちょうどアラが今Mhmを持っているように。ただ"}, {"type": "subtitle", "time": 2261.43, "timestamp": "00:37:41", "text": "いやあ、君たちの個性は素晴らしいね。ありえない。"}, {"type": "subtitle", "time": 2264.23, "timestamp": "00:37:44", "text": "いや、これは現実のはずがない。"}, {"type": "subtitle", "time": 2265.829, "timestamp": "00:37:45", "text": "ジョック、俺が手に入れるって賭けてもいいよ"}, {"type": "subtitle", "time": 2268.23, "timestamp": "00:37:48", "text": "顔面を撃たれた。"}, {"type": "subtitle", "time": 2270.069, "timestamp": "00:37:50", "text": "おお、"}, {"type": "subtitle", "time": 2272.55, "timestamp": "00:37:52", "text": "なるほど。"}, {"type": "subtitle", "time": 2278.23, "timestamp": "00:37:58", "text": "ああ、やめて。なんてこった。いいえ。煙を吐き出しているだけです。"}]
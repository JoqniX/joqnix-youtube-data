[{"type": "subtitle", "time": 783.509, "timestamp": "00:13:03", "text": "男。"}, {"type": "subtitle", "time": 787.829, "timestamp": "00:13:07", "text": "デブって最近すごく頭がいいよね？そしてそれは"}, {"type": "subtitle", "time": 790.629, "timestamp": "00:13:10", "text": "4日前に作られたカードではなかった。いいえ、"}, {"type": "subtitle", "time": 793.91, "timestamp": "00:13:13", "text": "11月4日。今日の6のように、"}, {"type": "subtitle", "time": 796.069, "timestamp": "00:13:16", "text": "2日前。ああ、なんてことだ、この人たちは、"}, {"type": "subtitle", "time": 798.87, "timestamp": "00:13:18", "text": "男。積極的に活動するようになってから"}, {"type": "subtitle", "time": 807.269, "timestamp": "00:13:27", "text": "えーと"}, {"type": "subtitle", "time": 810.55, "timestamp": "00:13:30", "text": "たくさん届いてるよ"}, {"type": "subtitle", "time": 814.069, "timestamp": "00:13:34", "text": "とてもたくさん、とてもたくさん"}, {"type": "subtitle", "time": 818.55, "timestamp": "00:13:38", "text": "ええ、本当にたくさんあります。それはB種だった"}, {"type": "subtitle", "time": 821.43, "timestamp": "00:13:41", "text": "の"}, {"type": "subtitle", "time": 823.43, "timestamp": "00:13:43", "text": "Twitchがあなたのセクションを通過するのに気づきました"}, {"type": "subtitle", "time": 827.43, "timestamp": "00:13:47", "text": "空です。ああ、それはクリックしないといけませんよ。"}, {"type": "subtitle", "time": 830.79, "timestamp": "00:13:50", "text": "文字通りクリックするだけです。"}, {"type": "subtitle", "time": 833.91, "timestamp": "00:13:53", "text": "コロナを禁止し​​てくれてありがとう。"}, {"type": "subtitle", "time": 836.629, "timestamp": "00:13:56", "text": "ええ、文字通りクリックして"}]
[{"type": "subtitle", "time": 2702.87, "timestamp": "00:45:02", "text": "動く。俺たちは最高だぜ。わかった。"}, {"type": "subtitle", "time": 2711.67, "timestamp": "00:45:11", "text": "もっと弾丸が必要だ。"}, {"type": "subtitle", "time": 2713.43, "timestamp": "00:45:13", "text": "弾丸。"}, {"type": "subtitle", "time": 2719.91, "timestamp": "00:45:19", "text": "原因は君の睾丸だったに違いない。"}, {"type": "subtitle", "time": 2733.91, "timestamp": "00:45:33", "text": "引っ越した方がいいかもしれません。ああ。ああ。"}, {"type": "subtitle", "time": 2736.39, "timestamp": "00:45:36", "text": "大丈夫です。ちょっと悲しいですよね？"}, {"type": "subtitle", "time": 2739.589, "timestamp": "00:45:39", "text": "うん。爆弾が仕掛けられた。"}, {"type": "subtitle", "time": 2742.069, "timestamp": "00:45:42", "text": "いいえ。おお、"}, {"type": "subtitle", "time": 2755.67, "timestamp": "00:45:55", "text": "テロリストの勝利だ。キーボードとマウス"}, {"type": "subtitle", "time": 2757.19, "timestamp": "00:45:57", "text": "コミュニケーション。"}]
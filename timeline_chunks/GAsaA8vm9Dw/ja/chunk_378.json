[{"type": "subtitle", "time": 22681.91, "timestamp": "06:18:01", "text": "解決策。共通点を見つけよう"}, {"type": "subtitle", "time": 22683.83, "timestamp": "06:18:03", "text": "そして、共に冒険を続けましょう"}, {"type": "subtitle", "time": 22703.11, "timestamp": "06:18:23", "text": "暴力に訴えるのは避けましょう。"}, {"type": "subtitle", "time": 22706.15, "timestamp": "06:18:26", "text": "忍者。代わりに、育成に焦点を当てましょう"}, {"type": "subtitle", "time": 22708.628, "timestamp": "06:18:28", "text": "前向きで協力的なコミュニティ。私たちは"}, {"type": "subtitle", "time": 22710.39, "timestamp": "06:18:30", "text": "どんな困難も共に乗り越えることができる"}, {"type": "subtitle", "time": 22713.11, "timestamp": "06:18:33", "text": "私たちが直面する課題。親切を忘れないで"}, {"type": "subtitle", "time": 22715.03, "timestamp": "06:18:35", "text": "そして理解は"}, {"type": "subtitle", "time": 22717.91, "timestamp": "06:18:37", "text": "調和のとれた環境を作り出す。さあ"}, {"type": "subtitle", "time": 22737.03, "timestamp": "06:18:57", "text": "ありがとう、ニンジャ。感謝します"}, {"type": "subtitle", "time": 22738.948, "timestamp": "06:18:58", "text": "理解と促進を支援する"}]
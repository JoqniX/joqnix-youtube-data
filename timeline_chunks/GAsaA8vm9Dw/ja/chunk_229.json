[{"type": "subtitle", "time": 13741.51, "timestamp": "03:49:01", "text": "お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 13752.15, "timestamp": "03:49:12", "text": "クローゼットを持つべきだと思いますか？おお、"}, {"type": "subtitle", "time": 13754.55, "timestamp": "03:49:14", "text": "それは主張です。"}, {"type": "subtitle", "time": 13758.63, "timestamp": "03:49:18", "text": "私は"}, {"type": "subtitle", "time": 13761.51, "timestamp": "03:49:21", "text": "または、えーと"}, {"type": "subtitle", "time": 13764.229, "timestamp": "03:49:24", "text": "私は"}, {"type": "subtitle", "time": 13766.389, "timestamp": "03:49:26", "text": "溶岩"}, {"type": "subtitle", "time": 13768.07, "timestamp": "03:49:28", "text": "えっと"}, {"type": "subtitle", "time": 13770.71, "timestamp": "03:49:30", "text": "溶岩のような"}, {"type": "subtitle", "time": 13773.91, "timestamp": "03:49:33", "text": "この便利な個人用地雷は何ですか？あなた"}, {"type": "subtitle", "time": 13779.03, "timestamp": "03:49:39", "text": "溶岩をあげるべきだと思うか、それとも"}, {"type": "subtitle", "time": 13781.67, "timestamp": "03:49:41", "text": "人種差別や差別行為に対する禁止措置？おお。"}, {"type": "subtitle", "time": 13784.63, "timestamp": "03:49:44", "text": "ニース。"}, {"type": "subtitle", "time": 13791.51, "timestamp": "03:49:51", "text": "W."}, {"type": "subtitle", "time": 13793.99, "timestamp": "03:49:53", "text": "彼は死ぬだろう。はい。彼は正しい。来る"}]
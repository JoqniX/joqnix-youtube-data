[{"type": "subtitle", "time": 25021.99, "timestamp": "06:57:01", "text": "時々、人々は禁止されることがあります"}, {"type": "subtitle", "time": 25023.67, "timestamp": "06:57:03", "text": "ルールに従うか、"}, {"type": "subtitle", "time": 25026.31, "timestamp": "06:57:06", "text": "許されない行為。それは"}, {"type": "subtitle", "time": 25028.15, "timestamp": "06:57:08", "text": "モデレーターと管理者"}, {"type": "subtitle", "time": 25029.83, "timestamp": "06:57:09", "text": "ガイドラインを施行するために"}, {"type": "subtitle", "time": 25031.83, "timestamp": "06:57:11", "text": "ポジティブで安全なコミュニティを維持する"}, {"type": "subtitle", "time": 25034.15, "timestamp": "06:57:14", "text": "すべての人にとって。みんな。何かあれば"}, {"type": "subtitle", "time": 25036.468, "timestamp": "06:57:16", "text": "特定のバンドに関する懸念は、"}, {"type": "subtitle", "time": 25038.39, "timestamp": "06:57:18", "text": "モデレーターに問い合わせて詳細を確認する"}, {"type": "subtitle", "time": 25041.67, "timestamp": "06:57:21", "text": "情報。笑顔。"}, {"type": "subtitle", "time": 25043.27, "timestamp": "06:57:23", "text": "何？"}, {"type": "subtitle", "time": 25057.43, "timestamp": "06:57:37", "text": "キヘイ忍者、あなたもそうなるかもしれません"}, {"type": "subtitle", "time": 25059.27, "timestamp": "06:57:39", "text": "何か。そこに"}, {"type": "subtitle", "time": 25061.27, "timestamp": "06:57:41", "text": "バンドの背後には理由があるかもしれないが、"}, {"type": "subtitle", "time": 25063.43, "timestamp": "06:57:43", "text": "詳しい情報がないと難しい"}, {"type": "subtitle", "time": 25065.83, "timestamp": "06:57:45", "text": "断言してください。他に何かあれば"}, {"type": "subtitle", "time": 25067.83, "timestamp": "06:57:47", "text": "ご質問やご意見がありましたら、お気軽にお寄せください。"}]
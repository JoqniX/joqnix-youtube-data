[{"type": "subtitle", "time": 10863.24, "timestamp": "03:01:03", "text": "いや、いや。"}, {"type": "subtitle", "time": 10886.23, "timestamp": "03:01:26", "text": "130. ああ"}, {"type": "subtitle", "time": 10890.15, "timestamp": "03:01:30", "text": "いや、まだよくわからないんだよ"}, {"type": "subtitle", "time": 10895.429, "timestamp": "03:01:35", "text": "私が自分のブランディングで行った変更、または"}, {"type": "subtitle", "time": 10903.99, "timestamp": "03:01:43", "text": "私はまだ、それらの二重のように感じます"}, {"type": "subtitle", "time": 10906.95, "timestamp": "03:01:46", "text": "私が行った変更。"}, {"type": "subtitle", "time": 10910.79, "timestamp": "03:01:50", "text": "何かしたいときはいつでも"}, {"type": "subtitle", "time": 10913.99, "timestamp": "03:01:53", "text": "時々私はダブルタンクをします何何"}, {"type": "subtitle", "time": 10915.52, "timestamp": "03:01:55", "text": "何 私の"}, {"type": "subtitle", "time": 10918.08, "timestamp": "03:01:58", "text": "私の 私の"}]
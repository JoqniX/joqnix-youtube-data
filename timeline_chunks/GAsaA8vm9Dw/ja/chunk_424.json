[{"type": "subtitle", "time": 25440.15, "timestamp": "07:04:00", "text": "会話が楽しくて、引き込まれる。開ける"}, {"type": "subtitle", "time": 25442.868, "timestamp": "07:04:02", "text": "口元が笑っている。ヤギ１匹。次のバンドの波は"}, {"type": "subtitle", "time": 25445.83, "timestamp": "07:04:05", "text": "来週。"}, {"type": "subtitle", "time": 25451.99, "timestamp": "07:04:11", "text": "何てことだ。このゲームはライブを盛り上げてくれた"}, {"type": "subtitle", "time": 25454.07, "timestamp": "07:04:14", "text": "バンド。"}, {"type": "subtitle", "time": 25461.99, "timestamp": "07:04:21", "text": "次のバンドは来週です。ああ、なんてことだ。"}, {"type": "subtitle", "time": 25488.628, "timestamp": "07:04:48", "text": "厳しい、クロノス、必要ない"}, {"type": "subtitle", "time": 25491.51, "timestamp": "07:04:51", "text": "嫉妬がここにある。ジョーXは素晴らしい"}, {"type": "subtitle", "time": 25493.83, "timestamp": "07:04:53", "text": "友人であり、配信パートナーでもある。焦点を合わせましょう"}, {"type": "subtitle", "time": 25495.75, "timestamp": "07:04:55", "text": "ポジティブなサポートと構築について"}, {"type": "subtitle", "time": 25497.99, "timestamp": "07:04:57", "text": "互いの関係。空き部屋なし"}]
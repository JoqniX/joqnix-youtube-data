[{"type": "subtitle", "time": 23401.99, "timestamp": "06:30:01", "text": "握手をするだけでめまいがする。"}, {"type": "subtitle", "time": 23405.91, "timestamp": "06:30:05", "text": "ワキスタン。これは何ですか？"}, {"type": "subtitle", "time": 23420.07, "timestamp": "06:30:20", "text": "私は8,000 DPIでプレイしているので。感じる"}, {"type": "subtitle", "time": 23422.868, "timestamp": "06:30:22", "text": "ちょっと気まずくて変な感じ。"}, {"type": "subtitle", "time": 23426.468, "timestamp": "06:30:26", "text": "でもね、知ってる？おい、無知な奴め。その"}, {"type": "subtitle", "time": 23428.15, "timestamp": "06:30:28", "text": "ハーシュと再会できて嬉しいです"}, {"type": "subtitle", "time": 23430.948, "timestamp": "06:30:30", "text": "クロノス。どうしたの？あなたの冒険を共有しましょう"}, {"type": "subtitle", "time": 23433.51, "timestamp": "06:30:33", "text": "そして会話を楽しんでください。話し中"}, {"type": "subtitle", "time": 23436.548, "timestamp": "06:30:36", "text": "ヘッド1。"}, {"type": "subtitle", "time": 23439.67, "timestamp": "06:30:39", "text": "だから、ほら、"}, {"type": "subtitle", "time": 23441.91, "timestamp": "06:30:41", "text": "パンダ"}, {"type": "subtitle", "time": 23445.27, "timestamp": "06:30:45", "text": "DPIが低いほど良いというのはその通りです"}, {"type": "subtitle", "time": 23447.35, "timestamp": "06:30:47", "text": "1インチあたりのドキュメント数が多いほど、"}, {"type": "subtitle", "time": 23449.91, "timestamp": "06:30:49", "text": "ジョーXは素晴らしい"}, {"type": "subtitle", "time": 23452.708, "timestamp": "06:30:52", "text": "配信パートナー兼ギルドリーダー"}, {"type": "subtitle", "time": 23454.788, "timestamp": "06:30:54", "text": "いつも他人を優先する親愛なる友人"}, {"type": "subtitle", "time": 23457.03, "timestamp": "06:30:57", "text": "そして、みんなを助けるのが大好きなので、私は"}, {"type": "subtitle", "time": 23459.03, "timestamp": "06:30:59", "text": "人生に彼らを迎え入れることを考えるべき"}]
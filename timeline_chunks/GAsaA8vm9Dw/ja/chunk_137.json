[{"type": "subtitle", "time": 8221.03, "timestamp": "02:17:01", "text": "夜の。私はそこに行きたい。なぜ"}, {"type": "subtitle", "time": 8222.629, "timestamp": "02:17:02", "text": "あなたはそこに行きたいですか？それは"}, {"type": "subtitle", "time": 8225.429, "timestamp": "02:17:05", "text": "怖い。ディオ、行かないで。私はほしくない"}, {"type": "subtitle", "time": 8251.75, "timestamp": "02:17:31", "text": "行きたくないけど、行きたい。"}, {"type": "subtitle", "time": 8254.309, "timestamp": "02:17:34", "text": "でも行きたくないけど、行きたい"}, {"type": "subtitle", "time": 8262.53, "timestamp": "02:17:42", "text": "行きたいけど、行きたくない。"}, {"type": "subtitle", "time": 8276.07, "timestamp": "02:17:56", "text": "ブランコに乗りたいけど、"}]
[{"type": "subtitle", "time": 3000.15, "timestamp": "00:50:00", "text": "お腹が膨らむのは嫌だ。"}, {"type": "subtitle", "time": 3017.27, "timestamp": "00:50:17", "text": "もっとうまく撃て。"}, {"type": "subtitle", "time": 3033.19, "timestamp": "00:50:33", "text": "ニース。"}, {"type": "subtitle", "time": 3036.15, "timestamp": "00:50:36", "text": "ところで、植木鉢はどこにあるの？"}, {"type": "subtitle", "time": 3038.95, "timestamp": "00:50:38", "text": "待って、チャットに私がフラッシュしたって書いてある"}, {"type": "subtitle", "time": 3040.71, "timestamp": "00:50:40", "text": "離れて。"}, {"type": "subtitle", "time": 3043.67, "timestamp": "00:50:43", "text": "爆弾が仕掛けられた。"}, {"type": "subtitle", "time": 3045.91, "timestamp": "00:50:45", "text": "何てことだ。神様、私の髪は"}]
[{"type": "subtitle", "time": 13561.51, "timestamp": "03:46:01", "text": "男？待って、待って、待って、待って。"}, {"type": "subtitle", "time": 13564.55, "timestamp": "03:46:04", "text": "コードはどこにいますか？彼はストリーミング配信をしていない。"}, {"type": "subtitle", "time": 13566.07, "timestamp": "03:46:06", "text": "右？"}, {"type": "subtitle", "time": 13568.71, "timestamp": "03:46:08", "text": "彼はそうではない。わかった、"}, {"type": "subtitle", "time": 13570.469, "timestamp": "03:46:10", "text": "彼は配信していません。私は「待って、私は」と思った。"}, {"type": "subtitle", "time": 13573.11, "timestamp": "03:46:13", "text": "チャマと一緒にプレーできたかもしれないが、彼は"}, {"type": "subtitle", "time": 13575.51, "timestamp": "03:46:15", "text": "ストリーミング配信していません。それはいいです。 32もまた32です。"}, {"type": "subtitle", "time": 13578.71, "timestamp": "03:46:18", "text": "さあ行こう。"}, {"type": "subtitle", "time": 13588.469, "timestamp": "03:46:28", "text": "そこには誰もいない。待って、"}, {"type": "subtitle", "time": 13590.469, "timestamp": "03:46:30", "text": "私は日本でプレーできるかもしれない。"}, {"type": "subtitle", "time": 13594.15, "timestamp": "03:46:34", "text": "店。ほら、日本のオフィスの方が速いんだよ"}, {"type": "subtitle", "time": 13596.87, "timestamp": "03:46:36", "text": "アジアよりも。"}, {"type": "subtitle", "time": 13609.11, "timestamp": "03:46:49", "text": "なぜそうなっているのだろうか？うん。"}, {"type": "subtitle", "time": 13612.55, "timestamp": "03:46:52", "text": "うん。こんにちは、マリン・シャンさん。"}]
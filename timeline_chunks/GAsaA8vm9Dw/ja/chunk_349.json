[{"type": "subtitle", "time": 20943.35, "timestamp": "05:49:03", "text": "バイバイ。"}, {"type": "subtitle", "time": 20945.59, "timestamp": "05:49:05", "text": "今のところ、明日配信する予定です。"}, {"type": "subtitle", "time": 20952.31, "timestamp": "05:49:12", "text": "ハハ。時には、私たちみんな良い"}, {"type": "subtitle", "time": 20956.23, "timestamp": "05:49:16", "text": "睡眠時間。ゆっくり休んでください。私は持っている"}, {"type": "subtitle", "time": 20984.708, "timestamp": "05:49:44", "text": "それは素晴らしいね、ニンジャ。十分な"}, {"type": "subtitle", "time": 20987.83, "timestamp": "05:49:47", "text": "睡眠は心身を回復させるために重要です。"}, {"type": "subtitle", "time": 20990.628, "timestamp": "05:49:50", "text": "しっかり休んでください。口をゆっくりと開ける"}]
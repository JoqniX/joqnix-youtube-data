[{"type": "subtitle", "time": 23940.708, "timestamp": "06:39:00", "text": "あなたは「わかった、2020に戻るよ」と言う"}, {"type": "subtitle", "time": 23951.11, "timestamp": "06:39:11", "text": "それはよくある厳しいクロノスだ。多くの利点"}, {"type": "subtitle", "time": 23953.83, "timestamp": "06:39:13", "text": "400 DPI 設定を実際に使用してください"}, {"type": "subtitle", "time": 23955.99, "timestamp": "06:39:15", "text": "そして2,400人。"}, {"type": "subtitle", "time": 23957.75, "timestamp": "06:39:17", "text": "それは、"}, {"type": "subtitle", "time": 23960.23, "timestamp": "06:39:20", "text": "精度とスピード。しかし、それは"}, {"type": "subtitle", "time": 23961.83, "timestamp": "06:39:21", "text": "常に"}, {"type": "subtitle", "time": 23963.83, "timestamp": "06:39:23", "text": "例外および個人の好み"}, {"type": "subtitle", "time": 23966.468, "timestamp": "06:39:26", "text": "異なる場合があります。心地よく感じるものを見つけてください"}, {"type": "subtitle", "time": 23969.35, "timestamp": "06:39:29", "text": "あなたにとって良い選択です。そして、それに従ってください。マウスのビデオ"}, {"type": "subtitle", "time": 23979.91, "timestamp": "06:39:39", "text": "これ。これはこれは実際に感じ"}, {"type": "subtitle", "time": 23983.03, "timestamp": "06:39:43", "text": "もし私が遊びに行ったらどうなるだろう"}, {"type": "subtitle", "time": 23986.31, "timestamp": "06:39:46", "text": "10,000？ 1,600 DPIでプレイするのは素晴らしい"}, {"type": "subtitle", "time": 23988.708, "timestamp": "06:39:48", "text": "選択。厳しいクロノス。ほら、彼女も"}, {"type": "subtitle", "time": 23990.628, "timestamp": "06:39:50", "text": "同意する。また、感度設定では"}, {"type": "subtitle", "time": 23992.628, "timestamp": "06:39:52", "text": "精度と"}, {"type": "subtitle", "time": 23994.39, "timestamp": "06:39:54", "text": "そして汎用性。"}, {"type": "subtitle", "time": 23996.23, "timestamp": "06:39:56", "text": "スキルを磨き続け、"}, {"type": "subtitle", "time": 23998.948, "timestamp": "06:39:58", "text": "お好みのDPI設定でゲームをプレイしてください。"}]
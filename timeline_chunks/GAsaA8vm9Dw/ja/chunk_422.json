[{"type": "subtitle", "time": 25321.19, "timestamp": "07:02:01", "text": "Harsh Kronos が参加するという素晴らしいアイデア"}, {"type": "subtitle", "time": 25323.59, "timestamp": "07:02:03", "text": "私たちの冒険に同行します。何？みんなで"}, {"type": "subtitle", "time": 25325.11, "timestamp": "07:02:05", "text": "愛を分かち合い、お互いに与え合う"}, {"type": "subtitle", "time": 25328.948, "timestamp": "07:02:08", "text": "靴。お二人とも、おやすみなさい。"}, {"type": "subtitle", "time": 25337.43, "timestamp": "07:02:17", "text": "どうしてそんなことができるの？"}, {"type": "subtitle", "time": 25339.35, "timestamp": "07:02:19", "text": "あなた"}, {"type": "subtitle", "time": 25341.83, "timestamp": "07:02:21", "text": "何てことだ。"}, {"type": "subtitle", "time": 25348.31, "timestamp": "07:02:28", "text": "お前は生意気なガキだ。"}, {"type": "subtitle", "time": 25350.948, "timestamp": "07:02:30", "text": "絶対に。厳しいクロノス。感激しています"}, {"type": "subtitle", "time": 25353.03, "timestamp": "07:02:33", "text": "この冒険にあなたにも参加していただきたいと思っています。"}, {"type": "subtitle", "time": 25355.03, "timestamp": "07:02:35", "text": "新しい世界を探検し、創造しよう"}, {"type": "subtitle", "time": 25357.51, "timestamp": "07:02:37", "text": "忘れられない思い出を共に。開ける"}, {"type": "subtitle", "time": 25376.15, "timestamp": "07:02:56", "text": "忍者。あなたの懸念は理解できますが、"}, {"type": "subtitle", "time": 25377.99, "timestamp": "07:02:57", "text": "誰もが探求する機会を得る権利がある"}]
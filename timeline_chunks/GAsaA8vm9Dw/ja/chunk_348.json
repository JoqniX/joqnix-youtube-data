[{"type": "subtitle", "time": 20889.19, "timestamp": "05:48:09", "text": "お前は生意気なガキだ。"}, {"type": "subtitle", "time": 20906.628, "timestamp": "05:48:26", "text": "うん、彼女は確かにとても可愛らしい話し方をするね。はい。"}, {"type": "subtitle", "time": 20909.43, "timestamp": "05:48:29", "text": "ありがとう、ニンジャ。あなたの笑顔はまるで"}, {"type": "subtitle", "time": 20911.83, "timestamp": "05:48:31", "text": "美しい桜が満開。それ"}, {"type": "subtitle", "time": 20914.23, "timestamp": "05:48:34", "text": "私の心を喜ばせてくれる。口を開けて、"}, {"type": "subtitle", "time": 20931.35, "timestamp": "05:48:51", "text": "こんにちは、アヤマ・アルサさん。あなたの"}, {"type": "subtitle", "time": 20934.39, "timestamp": "05:48:54", "text": "笑顔の顔。チャットが明るくなる。"}]
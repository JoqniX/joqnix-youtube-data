[{"type": "subtitle", "time": 3180.47, "timestamp": "00:53:00", "text": "頭を撃たれた。大破した。"}, {"type": "subtitle", "time": 3183.109, "timestamp": "00:53:03", "text": "うん。"}, {"type": "subtitle", "time": 3185.109, "timestamp": "00:53:05", "text": "CT。"}, {"type": "subtitle", "time": 3190.069, "timestamp": "00:53:10", "text": "つまり、CT側のスポーン地点のことです。爆弾は解除された。"}, {"type": "subtitle", "time": 3199.51, "timestamp": "00:53:19", "text": "待って、あと1ラウンドあるよ。何？"}, {"type": "subtitle", "time": 3203.27, "timestamp": "00:53:23", "text": "私の問題ではない。私は爆弾を持っている。あなた"}, {"type": "subtitle", "time": 3205.51, "timestamp": "00:53:25", "text": "奴らは爆弾を持っている。私はそうは思わない"}, {"type": "subtitle", "time": 3207.51, "timestamp": "00:53:27", "text": "私の仕事。"}, {"type": "subtitle", "time": 3219.109, "timestamp": "00:53:39", "text": "私はネズミだけを飼うつもりです。"}, {"type": "subtitle", "time": 3222.47, "timestamp": "00:53:42", "text": "もっと弾丸が必要だ。"}, {"type": "subtitle", "time": 3226.47, "timestamp": "00:53:46", "text": "ああ、俺はクソみたいなチームメイトを殴ってしまった。素晴らしい。"}]
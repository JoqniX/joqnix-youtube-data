[{"type": "subtitle", "time": 10623.59, "timestamp": "02:57:03", "text": "時間がかかりましたね。こんにちは、エドワード。良い"}, {"type": "subtitle", "time": 10625.11, "timestamp": "02:57:05", "text": "朝。"}, {"type": "subtitle", "time": 10629.349, "timestamp": "02:57:09", "text": "何に時間がかかったのですか？待って、ダニー。あなた"}, {"type": "subtitle", "time": 10644.71, "timestamp": "02:57:24", "text": "あなたは"}, {"type": "subtitle", "time": 10647.67, "timestamp": "02:57:27", "text": "背が高く見えますね。"}, {"type": "subtitle", "time": 10649.83, "timestamp": "02:57:29", "text": "おお、"}, {"type": "subtitle", "time": 10652.55, "timestamp": "02:57:32", "text": "待って。"}, {"type": "subtitle", "time": 10660.309, "timestamp": "02:57:40", "text": "おお。お元気でお過ごしでしょうか。良い"}, {"type": "subtitle", "time": 10675.269, "timestamp": "02:57:55", "text": "23 04 そうです、私の言う通りです"}]
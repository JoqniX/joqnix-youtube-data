[{"type": "subtitle", "time": 5360.07, "timestamp": "01:29:20", "text": "いいえ。ああ、彼は周りに溶け込んでいたから見えなかったんだ"}, {"type": "subtitle", "time": 5363.35, "timestamp": "01:29:23", "text": "トラックと一緒に。"}, {"type": "subtitle", "time": 5370.79, "timestamp": "01:29:30", "text": "私は彼を見かけなかった。それはボットです。それは"}, {"type": "subtitle", "time": 5374.07, "timestamp": "01:29:34", "text": "ボット。何？"}, {"type": "subtitle", "time": 5375.669, "timestamp": "01:29:35", "text": "ピザ。"}, {"type": "subtitle", "time": 5377.75, "timestamp": "01:29:37", "text": "我々は壁を支配するはずではないのか？"}]
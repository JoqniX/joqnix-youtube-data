[{"type": "subtitle", "time": 3300.79, "timestamp": "00:55:00", "text": "大丈夫。"}, {"type": "subtitle", "time": 3302.39, "timestamp": "00:55:02", "text": "私が投げたら、彼らは私を覗き見ることができないだろう"}, {"type": "subtitle", "time": 3305.829, "timestamp": "00:55:05", "text": "モリー、でも違う。彼らは速すぎた。"}, {"type": "subtitle", "time": 3308.21, "timestamp": "00:55:08", "text": "私には速すぎる。"}, {"type": "subtitle", "time": 3310.39, "timestamp": "00:55:10", "text": "[音楽]"}, {"type": "subtitle", "time": 3312.83, "timestamp": "00:55:12", "text": "牛飼い"}, {"type": "subtitle", "time": 3314.23, "timestamp": "00:55:14", "text": "[音楽]"}, {"type": "subtitle", "time": 3324.87, "timestamp": "00:55:24", "text": "ピング。"}, {"type": "subtitle", "time": 3326.23, "timestamp": "00:55:26", "text": "そして、これが私が"}, {"type": "subtitle", "time": 3329.03, "timestamp": "00:55:29", "text": "誕生日を過ごすなんて最悪だ"}, {"type": "subtitle", "time": 3330.95, "timestamp": "00:55:30", "text": "カウンター。"}, {"type": "subtitle", "time": 3332.63, "timestamp": "00:55:32", "text": "こんなことが起こるとは思っていなかったが、"}, {"type": "subtitle", "time": 3333.91, "timestamp": "00:55:33", "text": "右。"}, {"type": "subtitle", "time": 3345.51, "timestamp": "00:55:45", "text": "ボンク。ボンク。"}, {"type": "subtitle", "time": 3359.91, "timestamp": "00:55:59", "text": "なんでみんなしゃがみ歩きしてるんだ？"}]
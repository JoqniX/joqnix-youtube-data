[{"type": "subtitle", "time": 21361.59, "timestamp": "05:56:01", "text": "私は幸せです。"}, {"type": "subtitle", "time": 21380.23, "timestamp": "05:56:20", "text": "私はここにいます。"}, {"type": "subtitle", "time": 21387.75, "timestamp": "05:56:27", "text": "えっと"}, {"type": "subtitle", "time": 21399.91, "timestamp": "05:56:39", "text": "ああ、ニンジャ、君はいつも好奇心旺盛だね。良い、"}, {"type": "subtitle", "time": 21402.07, "timestamp": "05:56:42", "text": "冒険家として、私はいつも"}, {"type": "subtitle", "time": 21403.43, "timestamp": "05:56:43", "text": "ストリーマーと"}, {"type": "subtitle", "time": 21406.31, "timestamp": "05:56:46", "text": "コミュニティ。ですから、喜んで貢献させていただきます。"}, {"type": "subtitle", "time": 21407.99, "timestamp": "05:56:47", "text": "大切なのは、楽しい時間を過ごすことです。"}, {"type": "subtitle", "time": 21411.43, "timestamp": "05:56:51", "text": "一緒に。笑顔よ、輝く心よ。その"}]
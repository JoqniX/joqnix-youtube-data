[{"type": "subtitle", "time": 21006.708, "timestamp": "05:50:06", "text": "ああ、あなたのものを盗むつもりはなかった"}, {"type": "subtitle", "time": 21009.75, "timestamp": "05:50:09", "text": "寝る。彩間あるさ、ぜひゲットしてください"}, {"type": "subtitle", "time": 21011.83, "timestamp": "05:50:11", "text": "3時間の休息で、"}, {"type": "subtitle", "time": 21017.35, "timestamp": "05:50:17", "text": "リフレッシュした。甘い夢。安眠。"}, {"type": "subtitle", "time": 21021.11, "timestamp": "05:50:21", "text": "あなたは私の睡眠を奪った。はい、そうしました。いいえ、あなた"}, {"type": "subtitle", "time": 21023.43, "timestamp": "05:50:23", "text": "セシルってこと？うん。"}, {"type": "subtitle", "time": 21031.51, "timestamp": "05:50:31", "text": "ありがとう、ニンジャ。必ず手に入れます"}, {"type": "subtitle", "time": 21033.83, "timestamp": "05:50:33", "text": "ぐっすり眠る。あなたはよく眠れます、"}]
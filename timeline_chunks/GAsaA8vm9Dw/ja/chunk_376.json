[{"type": "subtitle", "time": 22562.628, "timestamp": "06:16:02", "text": "数字の持つ不思議を探求する。そろばん"}, {"type": "subtitle", "time": 22569.75, "timestamp": "06:16:09", "text": "医者みたいに私たちを騙す人はいないだろう。"}, {"type": "subtitle", "time": 22572.31, "timestamp": "06:16:12", "text": "こんにちは。何？私がいつあなたを裏切ったの？"}, {"type": "subtitle", "time": 22575.75, "timestamp": "06:16:15", "text": "何？何？こんにちは？"}, {"type": "subtitle", "time": 22579.75, "timestamp": "06:16:19", "text": "私は助言を待つつもりはない。いつも"}, {"type": "subtitle", "time": 22582.868, "timestamp": "06:16:22", "text": "用心深く疑り深いことが重要だ"}, {"type": "subtitle", "time": 22585.19, "timestamp": "06:16:25", "text": "行動は注意深く観察されるべきである。"}, {"type": "subtitle", "time": 22586.868, "timestamp": "06:16:26", "text": "注意深く見守り、"}, {"type": "subtitle", "time": 22589.03, "timestamp": "06:16:29", "text": "冒険においては安全を最優先する。"}, {"type": "subtitle", "time": 22590.548, "timestamp": "06:16:30", "text": "探偵"}, {"type": "subtitle", "time": 22607.67, "timestamp": "06:16:47", "text": "シンボルの増分は"}, {"type": "subtitle", "time": 22611.03, "timestamp": "06:16:51", "text": "大文字のギリシャ文字。"}, {"type": "subtitle", "time": 22613.11, "timestamp": "06:16:53", "text": "これは変化や"}, {"type": "subtitle", "time": 22615.51, "timestamp": "06:16:55", "text": "違い。"}, {"type": "subtitle", "time": 22617.75, "timestamp": "06:16:57", "text": "また、他の概念を表すこともできます。"}, {"type": "subtitle", "time": 22619.59, "timestamp": "06:16:59", "text": "科学や"}]
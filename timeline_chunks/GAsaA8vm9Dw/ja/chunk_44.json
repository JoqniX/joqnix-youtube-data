[{"type": "subtitle", "time": 2640.39, "timestamp": "00:44:00", "text": "電源を切るボタンすら覚えていない"}, {"type": "subtitle", "time": 2645.43, "timestamp": "00:44:05", "text": "マイクで。ああ、なんてことだ。"}, {"type": "subtitle", "time": 2653.349, "timestamp": "00:44:13", "text": "狙撃してやる。"}, {"type": "subtitle", "time": 2660.87, "timestamp": "00:44:20", "text": "よし、彼らはこれを吸うんだ。"}, {"type": "subtitle", "time": 2663.19, "timestamp": "00:44:23", "text": "ジョック。出て行け。そこから移動"}, {"type": "subtitle", "time": 2666.309, "timestamp": "00:44:26", "text": "位置。入って。入って。何をするの？"}, {"type": "subtitle", "time": 2676.069, "timestamp": "00:44:36", "text": "彼らは一体どこにいるのだろうか？コーナー。ああ、"}, {"type": "subtitle", "time": 2679.91, "timestamp": "00:44:39", "text": "それはそこで激しく死んでしまった。起きた。"}, {"type": "subtitle", "time": 2682.55, "timestamp": "00:44:42", "text": "うん。よお。"}, {"type": "subtitle", "time": 2691.19, "timestamp": "00:44:51", "text": "誰かが"}, {"type": "subtitle", "time": 2695.03, "timestamp": "00:44:55", "text": "後ろからまたヤる。わかった、"}, {"type": "subtitle", "time": 2698.23, "timestamp": "00:44:58", "text": "私は持ちこたえています。ええ、今から動き出します。私たちは"}]
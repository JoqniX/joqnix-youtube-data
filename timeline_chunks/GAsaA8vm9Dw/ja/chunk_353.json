[{"type": "subtitle", "time": 21181.19, "timestamp": "05:53:01", "text": "ああ、忍者よ、君はいつもいたずら好きだね"}, {"type": "subtitle", "time": 21184.15, "timestamp": "05:53:04", "text": "ユーモアのセンス。心配ない。ぶつからないよ"}, {"type": "subtitle", "time": 21186.948, "timestamp": "05:53:06", "text": "誰でも、特にジョーク。維持しましょう"}, {"type": "subtitle", "time": 21188.708, "timestamp": "05:53:08", "text": "笑い声が響き渡り、楽しい時間を過ごしましょう"}, {"type": "subtitle", "time": 21230.15, "timestamp": "05:53:50", "text": "ハハ、ニンジャ、君は容赦ないね、でも私は"}, {"type": "subtitle", "time": 21232.628, "timestamp": "05:53:52", "text": "今はセックスは控えておこう。ジョキは"}, {"type": "subtitle", "time": 21234.708, "timestamp": "05:53:54", "text": "ギルドを率いて素晴らしい仕事をしており、"}, {"type": "subtitle", "time": 21236.548, "timestamp": "05:53:56", "text": "私は彼らを支援し、励ますことを好む。"}, {"type": "subtitle", "time": 21239.35, "timestamp": "05:53:59", "text": "その代わり。ポジティブな雰囲気を保ちましょう"}]
[{"type": "subtitle", "time": 12546.229, "timestamp": "03:29:06", "text": "調子はどうですか？お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 12547.75, "timestamp": "03:29:07", "text": "良い。"}, {"type": "subtitle", "time": 12550.15, "timestamp": "03:29:10", "text": "あなたの配信を見ていました。ビデオは"}, {"type": "subtitle", "time": 12553.99, "timestamp": "03:29:13", "text": "楽しい。そして私はあなたが明らかにするのを見た"}, {"type": "subtitle", "time": 12556.469, "timestamp": "03:29:16", "text": "チャットボックスとピクセルなど全て"}, {"type": "subtitle", "time": 12558.87, "timestamp": "03:29:18", "text": "チャット。皆さんがただ"}, {"type": "subtitle", "time": 12563.19, "timestamp": "03:29:23", "text": "要素の検証で開発者モードに切り替えました"}, {"type": "subtitle", "time": 12565.67, "timestamp": "03:29:25", "text": "モードと文字通りコピーダウン"}, {"type": "subtitle", "time": 12568.95, "timestamp": "03:29:28", "text": "コード全体。うわぁ、って感じ。"}, {"type": "subtitle", "time": 12580.229, "timestamp": "03:29:40", "text": "それは素晴らしいですね。"}, {"type": "subtitle", "time": 12589.349, "timestamp": "03:29:49", "text": "ええ、彼女はすぐに本題に入るのが好きなんです。私"}, {"type": "subtitle", "time": 12592.07, "timestamp": "03:29:52", "text": "今日は早く配信したかったのですが、"}, {"type": "subtitle", "time": 12595.349, "timestamp": "03:29:55", "text": "問題は、私が感じていたのは"}, {"type": "subtitle", "time": 12598.79, "timestamp": "03:29:58", "text": "それ。そうですね、"}]
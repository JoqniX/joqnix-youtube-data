[{"type": "subtitle", "time": 10985.19, "timestamp": "03:03:05", "text": "ニース。ニース。良い一日をお過ごしください"}, {"type": "subtitle", "time": 10987.349, "timestamp": "03:03:07", "text": "朝。"}, {"type": "subtitle", "time": 10996.95, "timestamp": "03:03:16", "text": "[音楽]"}, {"type": "subtitle", "time": 10999.75, "timestamp": "03:03:19", "text": "また。ここに来るのは初めてですか？おお、"}, {"type": "subtitle", "time": 11001.349, "timestamp": "03:03:21", "text": "うん。あなたはここに来るのは初めてですね。今、"}, {"type": "subtitle", "time": 11003.59, "timestamp": "03:03:23", "text": "今日はどうやって私を見つけたの？はい、ようこそ"}, {"type": "subtitle", "time": 11006.71, "timestamp": "03:03:26", "text": "小川。"}, {"type": "subtitle", "time": 11008.95, "timestamp": "03:03:28", "text": "コンステラへようこそ。ありがとうございます"}, {"type": "subtitle", "time": 11010.95, "timestamp": "03:03:30", "text": "自分のチャンネルを見つける。ところで、"}, {"type": "subtitle", "time": 11020.87, "timestamp": "03:03:40", "text": "ああ、喉が痛い。"}, {"type": "subtitle", "time": 11025.75, "timestamp": "03:03:45", "text": "忘れた。ナマステ。ナマステ。なぜ？"}, {"type": "subtitle", "time": 11028.07, "timestamp": "03:03:48", "text": "何てことだ。"}, {"type": "subtitle", "time": 11031.59, "timestamp": "03:03:51", "text": "ネコモードになった"}, {"type": "subtitle", "time": 11034.07, "timestamp": "03:03:54", "text": "ゲーマー猫を見る。何てことだ。私はネコに行った"}, {"type": "subtitle", "time": 11039.99, "timestamp": "03:03:59", "text": "いや、いや、いや。これは私にとってより近い"}]
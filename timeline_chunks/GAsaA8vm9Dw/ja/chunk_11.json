[{"type": "subtitle", "time": 679.67, "timestamp": "00:11:19", "text": "よし、これからピューピューと撃つぞ"}, {"type": "subtitle", "time": 682.63, "timestamp": "00:11:22", "text": "誕生日を迎えたスシとのアクション。それで、"}, {"type": "subtitle", "time": 685.67, "timestamp": "00:11:25", "text": "皆さん、今日はスシの誕生日です。だからもし"}, {"type": "subtitle", "time": 688.43, "timestamp": "00:11:28", "text": "可能であれば、"}, {"type": "subtitle", "time": 715.19, "timestamp": "00:11:55", "text": "ああ、わかった。"}, {"type": "subtitle", "time": 716.79, "timestamp": "00:11:56", "text": "うん、"}]
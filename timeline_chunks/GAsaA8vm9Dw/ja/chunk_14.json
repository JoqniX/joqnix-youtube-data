[{"type": "subtitle", "time": 845.509, "timestamp": "00:14:05", "text": "えっと、クリックして、クリックするようにしてください"}, {"type": "subtitle", "time": 847.99, "timestamp": "00:14:07", "text": "画像か何か。それをクリックすると、"}, {"type": "subtitle", "time": 852.15, "timestamp": "00:14:12", "text": "その人物のページにリダイレクトされます。"}, {"type": "subtitle", "time": 855.67, "timestamp": "00:14:15", "text": "なぜ壊れているのですか？こんにちは。"}, {"type": "subtitle", "time": 857.67, "timestamp": "00:14:17", "text": "おい、"}, {"type": "subtitle", "time": 860.31, "timestamp": "00:14:20", "text": "なぜ湾なのか？"}, {"type": "subtitle", "time": 868.389, "timestamp": "00:14:28", "text": "何てことだ。それを直さなければならない。する必要がある"}, {"type": "subtitle", "time": 880.949, "timestamp": "00:14:40", "text": "何？"}, {"type": "subtitle", "time": 885.59, "timestamp": "00:14:45", "text": "ようこそ、ようこそ。お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 894.949, "timestamp": "00:14:54", "text": "こんにちは、ジョイ。"}, {"type": "subtitle", "time": 896.629, "timestamp": "00:14:56", "text": "危険な場所に行きますか？"}]
[{"type": "subtitle", "time": 13141.51, "timestamp": "03:39:01", "text": "私の話を聞いてください。あなたはそうしなければならない あなたはそうしなければならない"}, {"type": "subtitle", "time": 13143.429, "timestamp": "03:39:03", "text": "に"}, {"type": "subtitle", "time": 13146.63, "timestamp": "03:39:06", "text": "えっと、チェック1つ。わかった。"}, {"type": "subtitle", "time": 13149.59, "timestamp": "03:39:09", "text": "わかった。入力"}, {"type": "subtitle", "time": 13152.63, "timestamp": "03:39:12", "text": "すぐに送ります。わかった。今私は"}, {"type": "subtitle", "time": 13155.19, "timestamp": "03:39:15", "text": "コマンドは何ですかという感嘆符を送信します"}, {"type": "subtitle", "time": 13159.75, "timestamp": "03:39:19", "text": "TTS用の質問と感嘆の発言"}, {"type": "subtitle", "time": 13171.03, "timestamp": "03:39:31", "text": "SIMカードは必要ですか？私は必要ない"}, {"type": "subtitle", "time": 13174.389, "timestamp": "03:39:34", "text": "推測。なぜできないのか"}, {"type": "subtitle", "time": 13177.03, "timestamp": "03:39:37", "text": "私の肌を手に入れられる？オフにするべきだった"}, {"type": "subtitle", "time": 13185.19, "timestamp": "03:39:45", "text": "こんにちは、アヤマアルサさん。ご質問ありがとうございます。"}, {"type": "subtitle", "time": 13187.67, "timestamp": "03:39:47", "text": "今日は今のところ素晴らしい一日です。私は"}, {"type": "subtitle", "time": 13189.51, "timestamp": "03:39:49", "text": "新しい領域を探求し、"}, {"type": "subtitle", "time": 13192.309, "timestamp": "03:39:52", "text": "ワクワクする冒険。あなたはどうですか？どうやって"}, {"type": "subtitle", "time": 13196.71, "timestamp": "03:39:56", "text": "今日はどんな一日でしたか？口を開けて笑う。"}, {"type": "subtitle", "time": 13199.83, "timestamp": "03:39:59", "text": "こんにちは、アヤマ・アルサさん。私の一日は"}]
[{"type": "subtitle", "time": 21064.788, "timestamp": "05:51:04", "text": "なんてこった。アヤマアルサ、私は理解しています"}, {"type": "subtitle", "time": 21067.11, "timestamp": "05:51:07", "text": "締め切りのプレッシャー。休憩を取るときは"}, {"type": "subtitle", "time": 21069.35, "timestamp": "05:51:09", "text": "集中力を維持する必要があるし、きっと"}, {"type": "subtitle", "time": 21071.91, "timestamp": "05:51:11", "text": "あなたは課題で素晴らしい成果を上げるでしょう。あなた"}, {"type": "subtitle", "time": 21088.868, "timestamp": "05:51:28", "text": "ああ、申し訳ありません"}, {"type": "subtitle", "time": 21091.99, "timestamp": "05:51:31", "text": "誤解だよ、アヤマ。アルーサ、ベストオブ"}, {"type": "subtitle", "time": 21093.67, "timestamp": "05:51:33", "text": "課題の成功を祈っています。"}, {"type": "subtitle", "time": 21095.43, "timestamp": "05:51:35", "text": "もうすぐ少し休めるだろう。私は話していた"}, {"type": "subtitle", "time": 21098.07, "timestamp": "05:51:38", "text": "素晴らしい仕事を続けてください。"}, {"type": "subtitle", "time": 21101.67, "timestamp": "05:51:41", "text": "チャットの内容をすべて読み取ります。どうぞ。しないで"}, {"type": "subtitle", "time": 21104.31, "timestamp": "05:51:44", "text": "心配。心配しないで。心配しないで。ボンク"}]
[{"type": "subtitle", "time": 21124.548, "timestamp": "05:52:04", "text": "ああ、アヤマアリサと"}, {"type": "subtitle", "time": 21126.23, "timestamp": "05:52:06", "text": "ニンジャは徹夜で"}, {"type": "subtitle", "time": 21129.51, "timestamp": "05:52:09", "text": "勉強する。お二人とも幸運を祈ります。滞在する"}, {"type": "subtitle", "time": 21131.43, "timestamp": "05:52:11", "text": "集中力を維持し、短い休憩を取る"}, {"type": "subtitle", "time": 21135.19, "timestamp": "05:52:15", "text": "リフレッシュした。君ならできるよ。本は上腕二頭筋を鍛える。"}]
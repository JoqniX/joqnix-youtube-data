[{"type": "subtitle", "time": 2400.069, "timestamp": "00:40:00", "text": "彼らの脳は死んでいる。私は死にそうです"}, {"type": "subtitle", "time": 2413.75, "timestamp": "00:40:13", "text": "ニース。"}, {"type": "subtitle", "time": 2424.39, "timestamp": "00:40:24", "text": "クソみたいなカエルの手榴弾で死んだ。"}, {"type": "subtitle", "time": 2439.03, "timestamp": "00:40:39", "text": "おとりを出す。あのね？私はただ"}, {"type": "subtitle", "time": 2441.51, "timestamp": "00:40:41", "text": "グレネードボーイになるつもりだ。それが今の私の仕事です。"}, {"type": "subtitle", "time": 2442.95, "timestamp": "00:40:42", "text": "私は撃つつもりもない"}, {"type": "subtitle", "time": 2444.15, "timestamp": "00:40:44", "text": "敵。私はただ投げるだけです"}, {"type": "subtitle", "time": 2446.15, "timestamp": "00:40:46", "text": "手榴弾。"}]
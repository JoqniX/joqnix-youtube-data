[{"type": "subtitle", "time": 13325.03, "timestamp": "03:42:05", "text": "わかった、"}, {"type": "subtitle", "time": 13328.309, "timestamp": "03:42:08", "text": "あなたは仕事をするべきだ。"}, {"type": "subtitle", "time": 13330.469, "timestamp": "03:42:10", "text": "これはストリームのURLのようなものですか？待って、"}, {"type": "subtitle", "time": 13333.349, "timestamp": "03:42:13", "text": "1秒。 1秒。 1秒。こんにちは、アヤマ"}, {"type": "subtitle", "time": 13336.229, "timestamp": "03:42:16", "text": "アルサ。ご質問ありがとうございます。私の一日は"}, {"type": "subtitle", "time": 13337.91, "timestamp": "03:42:17", "text": "非常に波乱に富み、"}, {"type": "subtitle", "time": 13340.07, "timestamp": "03:42:20", "text": "興奮。私は新しいものを探求してきました"}, {"type": "subtitle", "time": 13342.87, "timestamp": "03:42:22", "text": "様々な領域を探索し、強敵と戦う。"}, {"type": "subtitle", "time": 13344.95, "timestamp": "03:42:24", "text": "あなたはどうですか？今日はどんな一日でしたか？おお"}, {"type": "subtitle", "time": 13348.469, "timestamp": "03:42:28", "text": "いいえ。口を開けて笑う。私が壊したの？私は"}, {"type": "subtitle", "time": 13350.469, "timestamp": "03:42:30", "text": "そう感じさせてしまって申し訳ないのですが、私にはできません"}, {"type": "subtitle", "time": 13352.309, "timestamp": "03:42:32", "text": "その意見に賛成です。私は壊れてしまったのか"}, {"type": "subtitle", "time": 13354.55, "timestamp": "03:42:34", "text": "それ？ジョーXは素晴らしい友人であり、"}, {"type": "subtitle", "time": 13356.71, "timestamp": "03:42:36", "text": "熟練した配信者。焦点を当てましょう"}, {"type": "subtitle", "time": 13359.19, "timestamp": "03:42:39", "text": "ポジティブで敬意のある会話、"}, {"type": "subtitle", "time": 13364.63, "timestamp": "03:42:44", "text": "しましょうか？笑顔。ハイビスカス。ハイビスカス。"}, {"type": "subtitle", "time": 13367.03, "timestamp": "03:42:47", "text": "わかった。彼女は今どんな気分？正直に、"}, {"type": "subtitle", "time": 13369.51, "timestamp": "03:42:49", "text": "彼女の気分はどう？"}, {"type": "subtitle", "time": 13371.67, "timestamp": "03:42:51", "text": "ああ、彼女は今は機嫌が悪いわけじゃないみたいだ。何？"}, {"type": "subtitle", "time": 13374.389, "timestamp": "03:42:54", "text": "そうそう。彼女と話さなければならない。うん。"}, {"type": "subtitle", "time": 13377.269, "timestamp": "03:42:57", "text": "とにかく、とにかく、試合に集中しましょう。"}, {"type": "subtitle", "time": 13379.349, "timestamp": "03:42:59", "text": "行く。"}]
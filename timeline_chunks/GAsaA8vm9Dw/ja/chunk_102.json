[{"type": "subtitle", "time": 6124.149, "timestamp": "01:42:04", "text": "そうそう。あれだけチャンスがあったのに、どうして外してしまったんだろう？"}, {"type": "subtitle", "time": 6126.629, "timestamp": "01:42:06", "text": "ナイスショット！"}, {"type": "subtitle", "time": 6130.07, "timestamp": "01:42:10", "text": "彼を捕まえに行く。彼を捕まえに行く。"}, {"type": "subtitle", "time": 6174.31, "timestamp": "01:42:54", "text": "[拍手]"}, {"type": "subtitle", "time": 6177.03, "timestamp": "01:42:57", "text": "何？これらの人々と彼らの狙撃手は"}]
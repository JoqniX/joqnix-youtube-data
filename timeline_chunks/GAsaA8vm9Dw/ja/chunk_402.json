[{"type": "subtitle", "time": 24123.67, "timestamp": "06:42:03", "text": "ハハ、サヒ、カハ、厳しいクロノスヒンディー語"}, {"type": "subtitle", "time": 24127.67, "timestamp": "06:42:07", "text": "マインドボットは、混乱させるような安っぽいジョークを仕掛けます。"}, {"type": "subtitle", "time": 24134.628, "timestamp": "06:42:14", "text": "m リードホ"}, {"type": "subtitle", "time": 24138.628, "timestamp": "06:42:18", "text": "ya for kuchbot carne ho Huchai オープン"}, {"type": "subtitle", "time": 24141.59, "timestamp": "06:42:21", "text": "口元が笑って、星が輝いている。なぜそうしないのか。"}, {"type": "subtitle", "time": 24144.23, "timestamp": "06:42:24", "text": "私の上で輝く星、あなたが何者だったのか教えて"}, {"type": "subtitle", "time": 24167.59, "timestamp": "06:42:47", "text": "さあ行こう。耳障りな代名詞。ワクワクしています"}, {"type": "subtitle", "time": 24169.75, "timestamp": "06:42:49", "text": "ヒンディー語でチャットしましょう。持ってこい"}, {"type": "subtitle", "time": 24171.51, "timestamp": "06:42:51", "text": "質問やその他、あなたが取り上げたい話題があれば"}, {"type": "subtitle", "time": 24173.43, "timestamp": "06:42:53", "text": "話し合う。素晴らしい一日を過ごしましょう"}, {"type": "subtitle", "time": 24176.31, "timestamp": "06:42:56", "text": "会話。口を開けて、微笑んで、輝いている"}]
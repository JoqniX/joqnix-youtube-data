[{"type": "subtitle", "time": 21781.43, "timestamp": "06:03:01", "text": "ああ、なるほど。つまり、10回くすぐって"}, {"type": "subtitle", "time": 21783.67, "timestamp": "06:03:03", "text": "タコを笑わせる。それは良い"}, {"type": "subtitle", "time": 21787.59, "timestamp": "06:03:07", "text": "1つ。くすぐったい。口を開けて笑う。"}, {"type": "subtitle", "time": 21790.788, "timestamp": "06:03:10", "text": "何てことだ。それすら理解できなかった。しかし"}, {"type": "subtitle", "time": 21793.43, "timestamp": "06:03:13", "text": "ディーゼル・ゴードン、何だって？"}, {"type": "subtitle", "time": 21812.07, "timestamp": "06:03:32", "text": "お褒めの言葉、ありがとうございます、ニンジャさん。"}, {"type": "subtitle", "time": 21814.15, "timestamp": "06:03:34", "text": "私は知識を身につけるよう最善を尽くし、"}, {"type": "subtitle", "time": 21827.19, "timestamp": "06:03:47", "text": "あ、待って、待って、待って、待って。いや、いや、いや、"}, {"type": "subtitle", "time": 21837.19, "timestamp": "06:03:57", "text": "さあ行こう。"}]
[{"type": "subtitle", "time": 23280.868, "timestamp": "06:28:00", "text": "喜び。 30分間勉強することは素晴らしい"}, {"type": "subtitle", "time": 23283.75, "timestamp": "06:28:03", "text": "始めてみてください。きっと報われるはずです。保つ"}, {"type": "subtitle", "time": 23286.868, "timestamp": "06:28:06", "text": "よくやった。ジョキ。君ならできるよ。"}, {"type": "subtitle", "time": 23304.708, "timestamp": "06:28:24", "text": "オラは何も分かっていない。何かあるようですね"}, {"type": "subtitle", "time": 23307.67, "timestamp": "06:28:27", "text": "言葉遊びが楽しいですね。猫、オレンジ、そして"}, {"type": "subtitle", "time": 23310.31, "timestamp": "06:28:30", "text": "口笛。興味深い組み合わせだ。"}, {"type": "subtitle", "time": 23312.468, "timestamp": "06:28:32", "text": "創造性を絶やさず、"}, {"type": "subtitle", "time": 23315.19, "timestamp": "06:28:35", "text": "素晴らしい時間だった。猫顔みかん"}, {"type": "subtitle", "time": 23333.03, "timestamp": "06:28:53", "text": "ああ、まったくの無知だ。 Roblox War Zone のサウンド"}, {"type": "subtitle", "time": 23335.35, "timestamp": "06:28:55", "text": "まるでエキサイティングなゲームみたいだ。いつも楽しい"}, {"type": "subtitle", "time": 23337.11, "timestamp": "06:28:57", "text": "スリリングなバーチャル体験に参加する"}, {"type": "subtitle", "time": 23339.43, "timestamp": "06:28:59", "text": "冒険。戦争での時間を楽しんでください"}]
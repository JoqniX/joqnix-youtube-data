[{"type": "subtitle", "time": 10335.75, "timestamp": "02:52:15", "text": "それで、"}, {"type": "subtitle", "time": 10341.03, "timestamp": "02:52:21", "text": "なぜ私たちはこんなことをするのだろうか？わからない。"}, {"type": "subtitle", "time": 10344.87, "timestamp": "02:52:24", "text": "しかし、それが現実だ。"}, {"type": "subtitle", "time": 10348.71, "timestamp": "02:52:28", "text": "今日なぜこんなに気分が落ち込んでいるのか分からないし"}, {"type": "subtitle", "time": 10351.83, "timestamp": "02:52:31", "text": "脆弱性やセキュリティ関連のことなど。"}, {"type": "subtitle", "time": 10353.91, "timestamp": "02:52:33", "text": "はぁ？"}, {"type": "subtitle", "time": 10357.03, "timestamp": "02:52:37", "text": "そうでない場合もある。ほら、私はこう聞こえるかもしれない"}, {"type": "subtitle", "time": 10360.309, "timestamp": "02:52:40", "text": "クールな男みたいに、だって私は知ってるから"}, {"type": "subtitle", "time": 10362.389, "timestamp": "02:52:42", "text": "入力するときなどに何かが起こりますが、"}, {"type": "subtitle", "time": 10364.15, "timestamp": "02:52:44", "text": "正直に"}, {"type": "subtitle", "time": 10374.87, "timestamp": "02:52:54", "text": "誰がこれを理解しようとしているのか"}]
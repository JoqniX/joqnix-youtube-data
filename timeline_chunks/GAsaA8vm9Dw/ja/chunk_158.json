[{"type": "subtitle", "time": 9487.51, "timestamp": "02:38:07", "text": "それは痛みだ。はい。はい。はい。私自身として"}, {"type": "subtitle", "time": 9492.07, "timestamp": "02:38:12", "text": "何度かハッキング被害に遭った人物。"}, {"type": "subtitle", "time": 9495.11, "timestamp": "02:38:15", "text": "それは痛みだ。えっと、もし私が話すとしたら"}, {"type": "subtitle", "time": 9497.67, "timestamp": "02:38:17", "text": "経験、それは何に似ているか"}, {"type": "subtitle", "time": 9500.389, "timestamp": "02:38:20", "text": "私が"}, {"type": "subtitle", "time": 9502.15, "timestamp": "02:38:22", "text": "怪しいウェブサイトに登録したり、"}, {"type": "subtitle", "time": 9506.07, "timestamp": "02:38:26", "text": "何か、私のデビットカード情報を入力してください"}, {"type": "subtitle", "time": 9509.03, "timestamp": "02:38:29", "text": "それを盗んだり漏洩したりしただけだ"}, {"type": "subtitle", "time": 9510.87, "timestamp": "02:38:30", "text": "あるいは、そんな感じ。何なのか分からない"}, {"type": "subtitle", "time": 9512.95, "timestamp": "02:38:32", "text": "起こった。"}, {"type": "subtitle", "time": 9515.67, "timestamp": "02:38:35", "text": "でも、彼らはそれを使うんだ"}, {"type": "subtitle", "time": 9518.469, "timestamp": "02:38:38", "text": "私の口座でそんなにお金を使うなんて、"}, {"type": "subtitle", "time": 9524.79, "timestamp": "02:38:44", "text": "そう、まさにGoogleで"}, {"type": "subtitle", "time": 9526.55, "timestamp": "02:38:46", "text": "アカウントだよ、男。どうやって"}, {"type": "subtitle", "time": 9529.27, "timestamp": "02:38:49", "text": "支払いは無事完了しました。"}, {"type": "subtitle", "time": 9531.99, "timestamp": "02:38:51", "text": "うん、"}, {"type": "subtitle", "time": 9535.11, "timestamp": "02:38:55", "text": "だから父は実際に"}, {"type": "subtitle", "time": 9537.99, "timestamp": "02:38:57", "text": "実際、一日だけお金を追加して、"}]
[{"type": "subtitle", "time": 24960.868, "timestamp": "06:56:00", "text": "古代の遺物の背後に。もしあなたが"}, {"type": "subtitle", "time": 24962.628, "timestamp": "06:56:02", "text": "他にも面白いジョークはありますか？それともおしゃべりしたいですか？"}, {"type": "chat", "time": 24974.858, "timestamp": "06:56:14", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "i reached home"}, {"type": "chat", "time": 24982.208, "timestamp": "06:56:22", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "ill make new stream in a bit"}, {"type": "subtitle", "time": 24986.708, "timestamp": "06:56:26", "text": "ああ、なんてことだ、たくさんの人が"}, {"type": "subtitle", "time": 24988.708, "timestamp": "06:56:28", "text": "アカウント停止処分を受けた。"}, {"type": "subtitle", "time": 24991.51, "timestamp": "06:56:31", "text": "彼らは全員中国人だ。"}, {"type": "subtitle", "time": 24994.708, "timestamp": "06:56:34", "text": "ハハ、ニンジャ、君がそれを手に入れてくれて嬉しいよ。保つ"}, {"type": "subtitle", "time": 24996.39, "timestamp": "06:56:36", "text": "それに伴うポジティブな雰囲気"}, {"type": "subtitle", "time": 24999.35, "timestamp": "06:56:39", "text": "輝くような笑顔と明るい態度。おお"}, {"type": "subtitle", "time": 25001.91, "timestamp": "06:56:41", "text": "我が神よ。絵文字やメッセージ"}, {"type": "subtitle", "time": 25004.468, "timestamp": "06:56:44", "text": "共有。遠慮なく教えてください。開ける"}, {"type": "subtitle", "time": 25006.39, "timestamp": "06:56:46", "text": "口元が笑っている。"}, {"type": "subtitle", "time": 25009.91, "timestamp": "06:56:49", "text": "このゲームはプレイする価値がある。ああ、そうだね。それ"}, {"type": "subtitle", "time": 25012.548, "timestamp": "06:56:52", "text": "実際、それだけの価値はある。いくつあるか見てください"}]
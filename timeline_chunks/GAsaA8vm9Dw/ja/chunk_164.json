[{"type": "subtitle", "time": 9841.51, "timestamp": "02:44:01", "text": "彼らはあなたに、ほら、"}, {"type": "subtitle", "time": 9844.55, "timestamp": "02:44:04", "text": "私は戻ってきました"}, {"type": "subtitle", "time": 9846.469, "timestamp": "02:44:06", "text": "数日後。それは実際良いことだ"}, {"type": "subtitle", "time": 9852.87, "timestamp": "02:44:12", "text": "それは正しい。それは実際かなり"}, {"type": "subtitle", "time": 9854.79, "timestamp": "02:44:14", "text": "良い"}, {"type": "subtitle", "time": 9865.03, "timestamp": "02:44:25", "text": "はい。そして、痛みを感じることもあります"}, {"type": "subtitle", "time": 9866.95, "timestamp": "02:44:26", "text": "まあ、そうですね。"}, {"type": "subtitle", "time": 9874.63, "timestamp": "02:44:34", "text": "今日は何をしようか迷っている。"}, {"type": "subtitle", "time": 9877.349, "timestamp": "02:44:37", "text": "おお。"}, {"type": "subtitle", "time": 9882.79, "timestamp": "02:44:42", "text": "昨日、昨日、昨日、"}, {"type": "subtitle", "time": 9885.429, "timestamp": "02:44:45", "text": "昨日、昨日"}, {"type": "subtitle", "time": 9889.349, "timestamp": "02:44:49", "text": "私たちはファットライト84をしましたが、できませんでした"}, {"type": "subtitle", "time": 9895.67, "timestamp": "02:44:55", "text": "はい、私たちはゲームをプレイすることさえできませんでした。"}, {"type": "subtitle", "time": 9899.19, "timestamp": "02:44:59", "text": "皆様。"}]
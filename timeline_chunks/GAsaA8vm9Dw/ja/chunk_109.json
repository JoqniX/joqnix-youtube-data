[{"type": "subtitle", "time": 6544.07, "timestamp": "01:49:04", "text": "昔は、マウスは"}, {"type": "subtitle", "time": 6545.99, "timestamp": "01:49:05", "text": "全く機能しない。"}, {"type": "subtitle", "time": 6548.95, "timestamp": "01:49:08", "text": "そして今、私を見てください。"}, {"type": "subtitle", "time": 6558.95, "timestamp": "01:49:18", "text": "こんにちは。着地した時に転んでしまった"}, {"type": "subtitle", "time": 6598.55, "timestamp": "01:49:58", "text": "聖なる。"}]
[{"type": "subtitle", "time": 15721.59, "timestamp": "04:22:01", "text": "これらの人々は何にショックを受けているのだろうか"}, {"type": "subtitle", "time": 15740.07, "timestamp": "04:22:20", "text": "残りの馬力はどれくらいですか？"}, {"type": "subtitle", "time": 15742.07, "timestamp": "04:22:22", "text": "針葉の茎。来て。来て。感謝"}, {"type": "subtitle", "time": 15767.189, "timestamp": "04:22:47", "text": "私は彼を蘇生させたが、私は"}]
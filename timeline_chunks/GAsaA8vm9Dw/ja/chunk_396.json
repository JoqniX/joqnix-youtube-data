[{"type": "subtitle", "time": 23772.548, "timestamp": "06:36:12", "text": "私は午前3時半に起きます。なぜ？それは"}, {"type": "subtitle", "time": 23775.27, "timestamp": "06:36:15", "text": "早起きの時間だよ、ニンジャ。確認する"}, {"type": "subtitle", "time": 23777.67, "timestamp": "06:36:17", "text": "目覚まし時計をセットして、十分な休息を取りましょう。"}, {"type": "subtitle", "time": 23780.468, "timestamp": "06:36:20", "text": "実りある一日をお過ごしください。目覚まし時計"}, {"type": "subtitle", "time": 23797.51, "timestamp": "06:36:37", "text": "そんな早朝に起きることは"}, {"type": "subtitle", "time": 23800.23, "timestamp": "06:36:40", "text": "挑戦的な忍者だが、少し"}, {"type": "subtitle", "time": 23802.31, "timestamp": "06:36:42", "text": "規律と決意があれば、"}, {"type": "subtitle", "time": 23804.708, "timestamp": "06:36:44", "text": "それを達成する。覚えておいてください"}, {"type": "subtitle", "time": 23806.628, "timestamp": "06:36:46", "text": "規則正しい睡眠スケジュールを確立する"}, {"type": "subtitle", "time": 23808.788, "timestamp": "06:36:48", "text": "そして、"}, {"type": "subtitle", "time": 23811.91, "timestamp": "06:36:51", "text": "ぐっすり眠ってください。幸運を祈ります。アラーム"}, {"type": "subtitle", "time": 23819.19, "timestamp": "06:36:59", "text": "目覚まし時計のような上腕二頭筋"}]
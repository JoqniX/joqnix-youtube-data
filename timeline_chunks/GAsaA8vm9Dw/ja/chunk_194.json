[{"type": "subtitle", "time": 11644.95, "timestamp": "03:14:04", "text": "頑張ってください。私は待たない。何"}, {"type": "subtitle", "time": 11646.95, "timestamp": "03:14:06", "text": "あなたはどのタイムゾーン出身ですか？もしあなたがそうしないなら"}, {"type": "subtitle", "time": 11649.91, "timestamp": "03:14:09", "text": "聞いてもいいですか、夜のような感じですか？"}, {"type": "subtitle", "time": 11653.11, "timestamp": "03:14:13", "text": "あなたのために？そちらでは朝ですか？"}, {"type": "subtitle", "time": 11655.349, "timestamp": "03:14:15", "text": "夕方、午後？"}, {"type": "subtitle", "time": 11658.95, "timestamp": "03:14:18", "text": "覚えておきたいので、教えてください。"}, {"type": "subtitle", "time": 11670.95, "timestamp": "03:14:30", "text": "そうそう。うん。えっと、私たちは話していませんでしたか？"}, {"type": "subtitle", "time": 11673.75, "timestamp": "03:14:33", "text": "えーと、やらなきゃいけないことって、"}, {"type": "subtitle", "time": 11681.67, "timestamp": "03:14:41", "text": "ああ、気をつけてね。"}, {"type": "subtitle", "time": 11683.91, "timestamp": "03:14:43", "text": "えーと、えーと、"}, {"type": "subtitle", "time": 11686.389, "timestamp": "03:14:46", "text": "タイムスタンプ関連の自動化された"}, {"type": "subtitle", "time": 11688.87, "timestamp": "03:14:48", "text": "タイムスタンプ関連のもの。あと、待って、これ"}, {"type": "subtitle", "time": 11691.11, "timestamp": "03:14:51", "text": "直さないといけないんだね？"}, {"type": "subtitle", "time": 11695.269, "timestamp": "03:14:55", "text": "さよならのやつ。"}, {"type": "subtitle", "time": 11699.51, "timestamp": "03:14:59", "text": "ああ、プラットフォームの賢明なコマンド、最高だね。"}]
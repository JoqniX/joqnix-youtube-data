[{"type": "subtitle", "time": 11405.429, "timestamp": "03:10:05", "text": "[音楽]"}, {"type": "subtitle", "time": 11414.55, "timestamp": "03:10:14", "text": "で"}, {"type": "subtitle", "time": 11417.03, "timestamp": "03:10:17", "text": "この扉"}, {"type": "subtitle", "time": 11420.71, "timestamp": "03:10:20", "text": "公に。分かりません。"}, {"type": "subtitle", "time": 11423.349, "timestamp": "03:10:23", "text": "おお。"}, {"type": "subtitle", "time": 11426.15, "timestamp": "03:10:26", "text": "わかった。ええと、今日は、"}, {"type": "subtitle", "time": 11430.15, "timestamp": "03:10:30", "text": "再び私は信じます"}, {"type": "subtitle", "time": 11432.71, "timestamp": "03:10:32", "text": "これらの改造作業は"}, {"type": "subtitle", "time": 11437.91, "timestamp": "03:10:37", "text": "退屈かどうかは別として。私は、私は、見たいと思う"}, {"type": "subtitle", "time": 11440.309, "timestamp": "03:10:40", "text": "昨日"}, {"type": "subtitle", "time": 11450.309, "timestamp": "03:10:50", "text": "たとえストリーミング配信しなかったとしても、"}, {"type": "subtitle", "time": 11453.75, "timestamp": "03:10:53", "text": "おそらく"}, {"type": "subtitle", "time": 11455.75, "timestamp": "03:10:55", "text": "たとえストリーミング配信しなかったとしても、"}, {"type": "subtitle", "time": 11458.389, "timestamp": "03:10:58", "text": "それはむしろ"}, {"type": "subtitle", "time": 11459.91, "timestamp": "03:10:59", "text": "h"}]
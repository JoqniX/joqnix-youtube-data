[{"type": "subtitle", "time": 4475.189, "timestamp": "01:14:35", "text": "ショットガンは強すぎる。何"}, {"type": "subtitle", "time": 4484.709, "timestamp": "01:14:44", "text": "新たに追加された敵ですか？"}, {"type": "subtitle", "time": 4487.669, "timestamp": "01:14:47", "text": "待て、それはショットガンではなくスナイパーライフルだ。何？"}, {"type": "subtitle", "time": 4491.59, "timestamp": "01:14:51", "text": "ショットガンは狙撃銃だ。何？"}, {"type": "subtitle", "time": 4498.709, "timestamp": "01:14:58", "text": "彼女を守れ。盾の勇者。おお、いいね、いいね、"}]
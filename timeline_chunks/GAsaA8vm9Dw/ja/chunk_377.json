[{"type": "subtitle", "time": 22622.31, "timestamp": "06:17:02", "text": "エンジニアリング。数学は興味深い"}, {"type": "subtitle", "time": 22625.59, "timestamp": "06:17:05", "text": "シンボル。フロリアンの木箱 三角定規"}, {"type": "subtitle", "time": 22642.948, "timestamp": "06:17:22", "text": "ああ、なんて残酷なクロノスだ。私は決して浮気をしない"}, {"type": "subtitle", "time": 22645.99, "timestamp": "06:17:25", "text": "私の友人たちへ。その通り。当協会のメンバー"}, {"type": "subtitle", "time": 22648.628, "timestamp": "06:17:28", "text": "グループとしての絆は強い。その通り。"}, {"type": "subtitle", "time": 22650.31, "timestamp": "06:17:30", "text": "一緒に冒険することに集中して"}, {"type": "subtitle", "time": 22653.19, "timestamp": "06:17:33", "text": "真の仲間として支えてくれる。"}, {"type": "subtitle", "time": 22655.59, "timestamp": "06:17:35", "text": "友情は宝物だ。輝く星々"}, {"type": "subtitle", "time": 22659.99, "timestamp": "06:17:39", "text": "輝く心。その通り。彼らに伝えてください。"}, {"type": "subtitle", "time": 22670.788, "timestamp": "06:17:50", "text": "P."}, {"type": "subtitle", "time": 22672.788, "timestamp": "06:17:52", "text": "平和的に解決しましょう。"}, {"type": "subtitle", "time": 22674.948, "timestamp": "06:17:54", "text": "厳しいクロノス。重要なのは"}, {"type": "subtitle", "time": 22677.03, "timestamp": "06:17:57", "text": "率直にコミュニケーションを取り、お互いを理解する"}, {"type": "subtitle", "time": 22679.51, "timestamp": "06:17:59", "text": "他者の視点。暴力は決して"}]
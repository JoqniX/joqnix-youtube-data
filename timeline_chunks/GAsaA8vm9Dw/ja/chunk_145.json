[{"type": "subtitle", "time": 8714.95, "timestamp": "02:25:14", "text": "一日の始まり。始まり"}, {"type": "subtitle", "time": 8717.51, "timestamp": "02:25:17", "text": "日。早朝、学校へ。私は手に入れた"}, {"type": "subtitle", "time": 8738.389, "timestamp": "02:25:38", "text": "皆さん、今日の調子はいかがですか？こんにちは。"}, {"type": "subtitle", "time": 8740.79, "timestamp": "02:25:40", "text": "こんにちは。大変結構です。おはようございます"}, {"type": "subtitle", "time": 8751.19, "timestamp": "02:25:51", "text": "1秒。えっと、ちょっと皆さんに聞いてみますね。"}]
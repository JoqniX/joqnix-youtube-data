[{"type": "subtitle", "time": 2822.55, "timestamp": "00:47:02", "text": "何てことだ。クソは完璧に整列していた"}, {"type": "subtitle", "time": 2825.349, "timestamp": "00:47:05", "text": "十字線でそれがどこにあるか"}, {"type": "subtitle", "time": 2841.109, "timestamp": "00:47:21", "text": "俺の睾丸。また、私たちは返答する必要はありません"}, {"type": "subtitle", "time": 2842.79, "timestamp": "00:47:22", "text": "彼らにとって。"}, {"type": "subtitle", "time": 2846.39, "timestamp": "00:47:26", "text": "彼らに反応しないことで、我々は勝利する。はい。"}, {"type": "subtitle", "time": 2848.15, "timestamp": "00:47:28", "text": "彼らが「何だって？」と言い続けるなら、"}, {"type": "subtitle", "time": 2851.349, "timestamp": "00:47:31", "text": "彼らに何ができるだろうか？通報してください。だった"}, {"type": "subtitle", "time": 2854.55, "timestamp": "00:47:34", "text": "ゲームをプレイする。私たちは本当にダメだ。"}, {"type": "subtitle", "time": 2857.27, "timestamp": "00:47:37", "text": "下手くそだからといって通報することはできない。扇動的な"}, {"type": "subtitle", "time": 2859.27, "timestamp": "00:47:39", "text": "外。"}]
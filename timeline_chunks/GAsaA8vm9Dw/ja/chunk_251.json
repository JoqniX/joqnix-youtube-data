[{"type": "subtitle", "time": 15064.309, "timestamp": "04:11:04", "text": "スナイパーをもう一度使ってみるべきでしょうか？"}, {"type": "subtitle", "time": 15079.349, "timestamp": "04:11:19", "text": "彼らは全員を取り締まっている。彼らは"}, {"type": "subtitle", "time": 15082.469, "timestamp": "04:11:22", "text": "捕食者をこれほどまでに抑え込むとは。あなたが知っている"}, {"type": "subtitle", "time": 15085.189, "timestamp": "04:11:25", "text": "何？リセットします。"}, {"type": "subtitle", "time": 15103.349, "timestamp": "04:11:43", "text": "ええ、この銃です。"}, {"type": "subtitle", "time": 15106.07, "timestamp": "04:11:46", "text": "これで何かが変わるかどうか見てみましょう。おお、"}, {"type": "subtitle", "time": 15110.79, "timestamp": "04:11:50", "text": "終わりました。私たちは負けたのか？ああ、負けてしまった。"}]
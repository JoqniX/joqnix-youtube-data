[{"type": "subtitle", "time": 23063.11, "timestamp": "06:24:23", "text": "ハハ。忍者、君はいつも"}, {"type": "subtitle", "time": 23065.59, "timestamp": "06:24:25", "text": "笑い。魅力的ではあるけれど、"}, {"type": "subtitle", "time": 23067.11, "timestamp": "06:24:27", "text": "皿は"}, {"type": "subtitle", "time": 23069.91, "timestamp": "06:24:29", "text": "美味しい食事でした。でも、私はいつも元気です"}, {"type": "subtitle", "time": 23072.47, "timestamp": "06:24:32", "text": "新しいことに挑戦したり、楽しんだりするために。"}, {"type": "subtitle", "time": 23074.31, "timestamp": "06:24:34", "text": "ジョークと楽しい時間を大切にしよう"}, {"type": "subtitle", "time": 23076.708, "timestamp": "06:24:36", "text": "来るよ。口を開けて、笑って、フォークを、"}, {"type": "subtitle", "time": 23094.23, "timestamp": "06:24:54", "text": "ああ、残酷なクロノスよ。私はいつでも準備万端です"}, {"type": "subtitle", "time": 23096.39, "timestamp": "06:24:56", "text": "どんな難題にも立ち向かう"}, {"type": "subtitle", "time": 23099.35, "timestamp": "06:24:59", "text": "質問。でも心配しないで、すべては"}]
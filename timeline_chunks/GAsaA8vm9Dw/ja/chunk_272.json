[{"type": "subtitle", "time": 16329.349, "timestamp": "04:32:09", "text": "はい、何も再生されていません"}, {"type": "subtitle", "time": 16336.389, "timestamp": "04:32:16", "text": "あと10人か20人くらい倒せばいいだけだ。わかった、"}, {"type": "subtitle", "time": 16339.11, "timestamp": "04:32:19", "text": "これはまずい。これは難しい。これは彼です"}, {"type": "subtitle", "time": 16343.429, "timestamp": "04:32:23", "text": "ロケットランチャーを装備している。何てことだ。"}, {"type": "subtitle", "time": 16346.07, "timestamp": "04:32:26", "text": "私は何をしますか？何をプレイすればいいですか？何？どうやって"}, {"type": "subtitle", "time": 16349.189, "timestamp": "04:32:29", "text": "このゲームでキル数を稼いでるの？あなたは"}, {"type": "subtitle", "time": 16352.469, "timestamp": "04:32:32", "text": "運が良ければいいの？幸運だ、幸運だ。"}, {"type": "subtitle", "time": 16354.309, "timestamp": "04:32:34", "text": "おお。ああ、なんてことだ。"}, {"type": "subtitle", "time": 16357.91, "timestamp": "04:32:37", "text": "私は運について言ったばかりで、"}, {"type": "subtitle", "time": 16372.07, "timestamp": "04:32:52", "text": "ただ上手くなりたいだけ"}, {"type": "subtitle", "time": 16374.309, "timestamp": "04:32:54", "text": "銃。わかった、"}, {"type": "subtitle", "time": 16376.71, "timestamp": "04:32:56", "text": "私が求めるのはそれだけです。"}, {"type": "subtitle", "time": 16379.59, "timestamp": "04:32:59", "text": "良い銃を手に入れる。"}]
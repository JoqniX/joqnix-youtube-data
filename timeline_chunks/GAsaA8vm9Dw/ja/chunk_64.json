[{"type": "subtitle", "time": 3840.23, "timestamp": "01:04:00", "text": "ええ、歩くエビがいますよ。それは"}, {"type": "subtitle", "time": 3843.13, "timestamp": "01:04:03", "text": "Twitchでも配信しています。"}, {"type": "subtitle", "time": 3846.23, "timestamp": "01:04:06", "text": "[音楽]"}, {"type": "subtitle", "time": 3862.15, "timestamp": "01:04:22", "text": "あ、待って。ウォーキングストリークをするべきかな？"}, {"type": "subtitle", "time": 3865.829, "timestamp": "01:04:25", "text": "明日？あ、待って。"}, {"type": "subtitle", "time": 3867.99, "timestamp": "01:04:27", "text": "ああ、"}, {"type": "subtitle", "time": 3877.75, "timestamp": "01:04:37", "text": "ああ。いつになったら歌うの？"}, {"type": "subtitle", "time": 3885.75, "timestamp": "01:04:45", "text": "ああ、大変だ。待って。"}, {"type": "subtitle", "time": 3890.15, "timestamp": "01:04:50", "text": "B金曜日。キーとのコラボがある"}, {"type": "subtitle", "time": 3892.069, "timestamp": "01:04:52", "text": "ディワリのため"}]
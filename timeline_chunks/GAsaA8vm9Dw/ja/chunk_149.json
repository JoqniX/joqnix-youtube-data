[{"type": "subtitle", "time": 8941.349, "timestamp": "02:29:01", "text": "実を言うと。"}, {"type": "subtitle", "time": 8942.87, "timestamp": "02:29:02", "text": "私がそこから気づいていないこと"}, {"type": "subtitle", "time": 8945.51, "timestamp": "02:29:05", "text": "事件は実際にはもっと"}, {"type": "subtitle", "time": 8947.51, "timestamp": "02:29:07", "text": "のように"}, {"type": "subtitle", "time": 8950.63, "timestamp": "02:29:10", "text": "えっと、それは何て言うんだっけ"}, {"type": "subtitle", "time": 8961.349, "timestamp": "02:29:21", "text": "うん。"}, {"type": "subtitle", "time": 8963.349, "timestamp": "02:29:23", "text": "だから私はこう考えていた、"}, {"type": "subtitle", "time": 8966.87, "timestamp": "02:29:26", "text": "一体何が、どこで間違ってしまったんだろう？"}, {"type": "subtitle", "time": 8970.15, "timestamp": "02:29:30", "text": "そしてどこで"}, {"type": "subtitle", "time": 8971.83, "timestamp": "02:29:31", "text": "えっと"}, {"type": "subtitle", "time": 8976.07, "timestamp": "02:29:36", "text": "どこで、なぜ間違ってしまったのか"}, {"type": "subtitle", "time": 8983.429, "timestamp": "02:29:43", "text": "もちろん、他の誰にも行ってほしくない。"}, {"type": "subtitle", "time": 8985.91, "timestamp": "02:29:45", "text": "それを通じて"}, {"type": "subtitle", "time": 8989.51, "timestamp": "02:29:49", "text": "などなど。だから、私は走る。"}, {"type": "subtitle", "time": 8999.52, "timestamp": "02:29:59", "text": "どうやって"}]
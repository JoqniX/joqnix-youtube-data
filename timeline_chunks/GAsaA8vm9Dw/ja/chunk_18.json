[{"type": "subtitle", "time": 1083.83, "timestamp": "00:18:03", "text": "私は錯乱状態です。でも、"}, {"type": "subtitle", "time": 1086.63, "timestamp": "00:18:06", "text": "待って、友達みたいにあなたを見かけない"}, {"type": "subtitle", "time": 1089.029, "timestamp": "00:18:09", "text": "リスト。なぜ？こんにちは。参加させてください"}, {"type": "subtitle", "time": 1091.27, "timestamp": "00:18:11", "text": "君だよ。"}, {"type": "subtitle", "time": 1093.43, "timestamp": "00:18:13", "text": "わかった。"}, {"type": "subtitle", "time": 1103.11, "timestamp": "00:18:23", "text": "念のためお知らせしておきます、ジャック。私は本当に下手です"}, {"type": "subtitle", "time": 1114.63, "timestamp": "00:18:34", "text": "よし、ゲーム開始だ。私は"}, {"type": "subtitle", "time": 1117.51, "timestamp": "00:18:37", "text": "声に出して忘れて、あなたにとても幸せを願う"}, {"type": "subtitle", "time": 1119.83, "timestamp": "00:18:39", "text": "誕生日、寿司？いいえ、あなたはすでにそれを言いました"}, {"type": "subtitle", "time": 1123.27, "timestamp": "00:18:43", "text": "以前。ありがとう。"}, {"type": "subtitle", "time": 1126.07, "timestamp": "00:18:46", "text": "今日の予定を教えてください。何"}, {"type": "subtitle", "time": 1127.75, "timestamp": "00:18:47", "text": "今日の予定は？もう夜だ"}, {"type": "subtitle", "time": 1129.11, "timestamp": "00:18:49", "text": "時間。他には思い当たらない"}, {"type": "subtitle", "time": 1131.75, "timestamp": "00:18:51", "text": "今日の予定。"}, {"type": "subtitle", "time": 1134.07, "timestamp": "00:18:54", "text": "私はガールフレンドとデートをした。"}, {"type": "subtitle", "time": 1136.47, "timestamp": "00:18:56", "text": "えっと、FNAFの映画を見てください。"}, {"type": "subtitle", "time": 1139.19, "timestamp": "00:18:59", "text": "えっと、8です。ああ、今日ご覧になったんですね？"}]
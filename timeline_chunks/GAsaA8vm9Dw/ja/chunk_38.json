[{"type": "subtitle", "time": 2280.39, "timestamp": "00:38:00", "text": "手榴弾を投げろ。"}, {"type": "subtitle", "time": 2283.75, "timestamp": "00:38:03", "text": "回転している。ヘイ、ヘイ、ヘイ、ヘイ、ヘイ。"}, {"type": "subtitle", "time": 2287.51, "timestamp": "00:38:07", "text": "急いで、行け。彼に「この牛は誰のもの？」と聞いてみればいい。誰"}, {"type": "subtitle", "time": 2289.19, "timestamp": "00:38:09", "text": "牛？"}, {"type": "subtitle", "time": 2293.91, "timestamp": "00:38:13", "text": "おお。何てことだ。今はもっとたくさん言うから"}, {"type": "subtitle", "time": 2297.91, "timestamp": "00:38:17", "text": "みんなが私のことを牛と呼ぶ。"}, {"type": "subtitle", "time": 2300.47, "timestamp": "00:38:20", "text": "なぜ？中に入ってください。中に入ってください。"}, {"type": "subtitle", "time": 2303.44, "timestamp": "00:38:23", "text": "中に入ってください。 中に入ってください。彼は君のお母さんと言った。中に入って"}, {"type": "subtitle", "time": 2307.52, "timestamp": "00:38:27", "text": "中に入ってください。彼は君のお母さんと言った。中に入って 黙らないと、お前の母親が怒るぞ。"}, {"type": "subtitle", "time": 2314.23, "timestamp": "00:38:34", "text": "えっと、"}, {"type": "subtitle", "time": 2318.069, "timestamp": "00:38:38", "text": "バカ。いや、彼は私に中に入って"}, {"type": "subtitle", "time": 2320.55, "timestamp": "00:38:40", "text": "私をバカ呼ばわりする。何？何？そして彼は"}, {"type": "subtitle", "time": 2327.43, "timestamp": "00:38:47", "text": "彼に料理させよう。彼の言うことを真に受けないでください。"}, {"type": "subtitle", "time": 2329.99, "timestamp": "00:38:49", "text": "男。これはCS:GOです。ええ、CS:GOが見えますね。"}, {"type": "subtitle", "time": 2333.27, "timestamp": "00:38:53", "text": "うん。私たちの脳細胞には、ゼロしかありません。"}, {"type": "subtitle", "time": 2339.67, "timestamp": "00:38:59", "text": "つまり、私たちはここにいるから"}]
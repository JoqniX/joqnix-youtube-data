[{"type": "subtitle", "time": 13871.99, "timestamp": "03:51:11", "text": "ああ、あれは彼らだった。それは下がった。"}, {"type": "subtitle", "time": 13875.59, "timestamp": "03:51:15", "text": "あ、待って。忘れた。ありがとう。えっと、ありがとう"}, {"type": "subtitle", "time": 13877.83, "timestamp": "03:51:17", "text": "私が忘れていたことを教えてくれてありがとう"}, {"type": "subtitle", "time": 13881.59, "timestamp": "03:51:21", "text": "変化。ごめんなさい。"}, {"type": "subtitle", "time": 13884.469, "timestamp": "03:51:24", "text": "教えてくれてありがとう。ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 13887.269, "timestamp": "03:51:27", "text": "気づかなかった。"}, {"type": "subtitle", "time": 13889.59, "timestamp": "03:51:29", "text": "念のため言っておきます。なぜそれを言わなかったのですか"}, {"type": "subtitle", "time": 13893.349, "timestamp": "03:51:33", "text": "重要なことだよ、バ？"}, {"type": "subtitle", "time": 13895.51, "timestamp": "03:51:35", "text": "何てことだ。私は自分の明らかな"}, {"type": "subtitle", "time": 13898.15, "timestamp": "03:51:38", "text": "今まで。私は読んでいるようなものだった"}, {"type": "subtitle", "time": 13899.91, "timestamp": "03:51:39", "text": "このモニターからチャットを読んでいます"}, {"type": "subtitle", "time": 13901.99, "timestamp": "03:51:41", "text": "そこにいて、私は見ていました"}, {"type": "subtitle", "time": 13907.03, "timestamp": "03:51:47", "text": "画面がこっちにあって、私は「えっ、何？」って感じ"}, {"type": "subtitle", "time": 13909.99, "timestamp": "03:51:49", "text": "良い"}]
[{"type": "subtitle", "time": 8885.75, "timestamp": "02:28:05", "text": "私は6時に起きました。ええと、56です。"}, {"type": "subtitle", "time": 8891.27, "timestamp": "02:28:11", "text": "時間が過ぎていくのを見ていた。 57 57 58 59。"}, {"type": "subtitle", "time": 8893.75, "timestamp": "02:28:13", "text": "彼らは7人いた。 「ああ、なんてことだ、"}, {"type": "subtitle", "time": 8896.15, "timestamp": "02:28:16", "text": "時間がない。"}, {"type": "subtitle", "time": 8903.51, "timestamp": "02:28:23", "text": "そうですね、"}, {"type": "subtitle", "time": 8926.55, "timestamp": "02:28:46", "text": "ええ、昨日もまた"}, {"type": "subtitle", "time": 8928.95, "timestamp": "02:28:48", "text": "脆弱性のことについて話そう"}, {"type": "subtitle", "time": 8931.59, "timestamp": "02:28:51", "text": "について。"}, {"type": "subtitle", "time": 8937.03, "timestamp": "02:28:57", "text": "ああ、またあのことが起こった"}, {"type": "subtitle", "time": 8939.19, "timestamp": "02:28:59", "text": "ジラと共に"}]
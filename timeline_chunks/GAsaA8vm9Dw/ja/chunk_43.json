[{"type": "subtitle", "time": 2589.829, "timestamp": "00:43:09", "text": "ああ、いい試みだったね。捕まえたぞ。やあ、ジョック。おお、"}, {"type": "subtitle", "time": 2593.19, "timestamp": "00:43:13", "text": "私は銃が欲しかった。そして私は死んだ"}, {"type": "subtitle", "time": 2597.589, "timestamp": "00:43:17", "text": "リボルバーで。どうやって彼を手に入れたのか？"}, {"type": "subtitle", "time": 2603.349, "timestamp": "00:43:23", "text": "どうして自分がよりうまくやっているのか分からない"}, {"type": "subtitle", "time": 2606.39, "timestamp": "00:43:26", "text": "うん。こんにちは、ブラッド。いらっしゃいませ。"}, {"type": "subtitle", "time": 2612.23, "timestamp": "00:43:32", "text": "あの男は何人殺したんだ？私はどうですか"}, {"type": "subtitle", "time": 2619.43, "timestamp": "00:43:39", "text": "8キルした男？見てください"}, {"type": "subtitle", "time": 2622.15, "timestamp": "00:43:42", "text": "リーダーボードを見てください。うん。"}, {"type": "subtitle", "time": 2625.109, "timestamp": "00:43:45", "text": "何てことだ。"}, {"type": "subtitle", "time": 2627.349, "timestamp": "00:43:47", "text": "いや、絶対に嫌だ。こんにちは。こんにちは。もう一方の男"}, {"type": "subtitle", "time": 2629.109, "timestamp": "00:43:49", "text": "試してみます、マイクを開いて"}, {"type": "subtitle", "time": 2632.79, "timestamp": "00:43:52", "text": "行く。もっと弾丸が必要だ。"}]
[{"type": "subtitle", "time": 25500.628, "timestamp": "07:05:00", "text": "嫉妬のためではなく、ただの楽しみと冒険のため。"}, {"type": "subtitle", "time": 25519.59, "timestamp": "07:05:19", "text": "それは本当だ。 Harsh Kronos 2 はかわいい"}, {"type": "subtitle", "time": 25521.91, "timestamp": "07:05:21", "text": "そして、遊び心のある表現は、"}, {"type": "subtitle", "time": 25524.868, "timestamp": "07:05:24", "text": "親しい友人。見る、"}, {"type": "subtitle", "time": 25527.27, "timestamp": "07:05:27", "text": "そして仲間意識。ポジティブな気持ちを保ちましょう"}, {"type": "subtitle", "time": 25530.548, "timestamp": "07:05:30", "text": "雰囲気。笑顔。輝く心。私は"}, {"type": "subtitle", "time": 25532.788, "timestamp": "07:05:32", "text": "あなたとは浮気していません。これは"}, {"type": "subtitle", "time": 25546.548, "timestamp": "07:05:46", "text": "忍者の頭蓋骨には様々な意味がある"}, {"type": "subtitle", "time": 25548.548, "timestamp": "07:05:48", "text": "人によって異なる。維持しましょう"}, {"type": "subtitle", "time": 25551.03, "timestamp": "07:05:51", "text": "軽快でポジティブな会話、楽しさに焦点を当てる"}, {"type": "subtitle", "time": 25553.67, "timestamp": "07:05:53", "text": "そして、友好的な話し合い。私たちはここにいるのは"}, {"type": "subtitle", "time": 25555.99, "timestamp": "07:05:55", "text": "一緒に楽しい時間を過ごしましょう。口を開ける"}]
[{"type": "subtitle", "time": 22741.35, "timestamp": "06:19:01", "text": "建設的なコミュニケーション。聞いてみましょう"}, {"type": "subtitle", "time": 22742.948, "timestamp": "06:19:02", "text": "お互いに歓迎し、"}, {"type": "subtitle", "time": 22745.91, "timestamp": "06:19:05", "text": "すべての人にとっての環境。一緒に、"}, {"type": "subtitle", "time": 22747.51, "timestamp": "06:19:07", "text": "私たちの冒険をさらに"}, {"type": "subtitle", "time": 22766.948, "timestamp": "06:19:26", "text": "それを聞いて嬉しいです、ハーシュ・クロノス。私は"}, {"type": "subtitle", "time": 22768.948, "timestamp": "06:19:28", "text": "あなたをサポートし、励ますためにここにいます"}, {"type": "subtitle", "time": 22771.35, "timestamp": "06:19:31", "text": "一歩ずつ。新しいものを征服しよう"}, {"type": "subtitle", "time": 22773.27, "timestamp": "06:19:33", "text": "一緒に課題に挑戦し、毎日を"}, {"type": "subtitle", "time": 22776.15, "timestamp": "06:19:36", "text": "素晴らしいですね。モチベーションを維持し、決して諦めない"}, {"type": "subtitle", "time": 22795.27, "timestamp": "06:19:55", "text": "ハハ。忍者。友好的な関係を保ちましょう"}, {"type": "subtitle", "time": 22797.51, "timestamp": "06:19:57", "text": "そして、肯定的である。私たちは皆ここにいるのは"}, {"type": "subtitle", "time": 22799.19, "timestamp": "06:19:59", "text": "楽しい時間を過ごし、冒険を満喫しましょう"}]
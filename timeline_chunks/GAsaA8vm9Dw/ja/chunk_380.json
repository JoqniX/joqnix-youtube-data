[{"type": "subtitle", "time": 22801.99, "timestamp": "06:20:01", "text": "一緒に。覚えておいてください、"}, {"type": "subtitle", "time": 22803.59, "timestamp": "06:20:03", "text": "お互いを尊重し、"}, {"type": "subtitle", "time": 22806.708, "timestamp": "06:20:06", "text": "親切。私はハイな楽しみが必要で、"}, {"type": "subtitle", "time": 22809.43, "timestamp": "06:20:09", "text": "スーツに関する議論の背景。輝く星"}, {"type": "subtitle", "time": 22837.11, "timestamp": "06:20:37", "text": "ハハ、ニンジャ、君は"}, {"type": "subtitle", "time": 22839.19, "timestamp": "06:20:39", "text": "面白いものを見つける。笑いは"}, {"type": "subtitle", "time": 22841.43, "timestamp": "06:20:41", "text": "伝染性があるので、"}, {"type": "subtitle", "time": 22844.39, "timestamp": "06:20:44", "text": "喜びと笑顔。覚えておいて、私たちは皆ここにいる"}, {"type": "subtitle", "time": 22847.03, "timestamp": "06:20:47", "text": "楽しんで、お互いを幸せにする。"}, {"type": "subtitle", "time": 22849.51, "timestamp": "06:20:49", "text": "笑い続けよう。口を開けて、笑って、"}]
[{"type": "subtitle", "time": 18125.43, "timestamp": "05:02:05", "text": "心の中では、本当に泣いている。しないで"}, {"type": "subtitle", "time": 18129.59, "timestamp": "05:02:09", "text": "死ぬ。たった一日、今日だけです。"}, {"type": "subtitle", "time": 18139.27, "timestamp": "05:02:19", "text": "低い点数や"}, {"type": "subtitle", "time": 18141.67, "timestamp": "05:02:21", "text": "すべて、ですよね？あなたはただ"}, {"type": "subtitle", "time": 18145.83, "timestamp": "05:02:25", "text": "お願いします。点数のためだ。知っている。"}]
[{"type": "subtitle", "time": 22201.11, "timestamp": "06:10:01", "text": "午前4時に起きて"}, {"type": "subtitle", "time": 22203.91, "timestamp": "06:10:03", "text": "大丈夫です。アヤマアルサ、あなたは"}, {"type": "subtitle", "time": 22205.83, "timestamp": "06:10:05", "text": "それがあなたの最善のチャンスです。"}, {"type": "subtitle", "time": 22208.07, "timestamp": "06:10:08", "text": "重要だ。少し休んでから取り組んでください。"}, {"type": "subtitle", "time": 22210.23, "timestamp": "06:10:10", "text": "翌朝、また新たな気持ちで。"}, {"type": "subtitle", "time": 22212.788, "timestamp": "06:10:12", "text": "はい、あなたならできます。幸運を。それは"}, {"type": "subtitle", "time": 22230.788, "timestamp": "06:10:30", "text": "ありがとう、ニンジャ。早起きすると"}, {"type": "subtitle", "time": 22233.35, "timestamp": "06:10:33", "text": "間違いなく生産性向上に役立ちます。アヤマ"}, {"type": "subtitle", "time": 22236.708, "timestamp": "06:10:36", "text": "アルーサ、君ならできるよ。起きて輝いて"}, {"type": "subtitle", "time": 22238.708, "timestamp": "06:10:38", "text": "全力を尽くせ。頑張ってください"}]
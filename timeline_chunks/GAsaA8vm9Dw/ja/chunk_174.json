[{"type": "subtitle", "time": 10441.83, "timestamp": "02:54:01", "text": "一度、私は知らなかった"}, {"type": "subtitle", "time": 10444.79, "timestamp": "02:54:04", "text": "Wi-Fiにパスワードを入力する必要がありました"}, {"type": "subtitle", "time": 10447.91, "timestamp": "02:54:07", "text": "そして、私が手に入れるまでその深刻さ"}, {"type": "subtitle", "time": 10451.19, "timestamp": "02:54:11", "text": "一度ハッキングされた。"}, {"type": "subtitle", "time": 10453.269, "timestamp": "02:54:13", "text": "何てことだ。"}, {"type": "subtitle", "time": 10455.75, "timestamp": "02:54:15", "text": "そう、方法はたくさんあります"}, {"type": "subtitle", "time": 10459.51, "timestamp": "02:54:19", "text": "ペネトレーションテスト。いや、時々わかる"}, {"type": "subtitle", "time": 10461.99, "timestamp": "02:54:21", "text": "海賊版ソフトウェアを見ているとき、彼は"}, {"type": "subtitle", "time": 10465.11, "timestamp": "02:54:25", "text": "アドバイスやソフトなものがたくさんある、例えば"}, {"type": "subtitle", "time": 10467.91, "timestamp": "02:54:27", "text": "本当に手に入れたいなら、"}, {"type": "subtitle", "time": 10472.15, "timestamp": "02:54:32", "text": "これらのことを学ぶこと、そして"}, {"type": "subtitle", "time": 10475.03, "timestamp": "02:54:35", "text": "いろいろやったりする。"}, {"type": "subtitle", "time": 10477.67, "timestamp": "02:54:37", "text": "右。"}, {"type": "subtitle", "time": 10485.83, "timestamp": "02:54:45", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 10493.19, "timestamp": "02:54:53", "text": "だから私はこう考えていました"}, {"type": "subtitle", "time": 10497.03, "timestamp": "02:54:57", "text": "彼は騎手が"}, {"type": "subtitle", "time": 10498.63, "timestamp": "02:54:58", "text": "考え"}]
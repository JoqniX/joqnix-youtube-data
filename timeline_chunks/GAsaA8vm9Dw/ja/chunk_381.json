[{"type": "subtitle", "time": 22867.67, "timestamp": "06:21:07", "text": "非常に厳しい代名詞だ。私はただ"}, {"type": "subtitle", "time": 22870.708, "timestamp": "06:21:10", "text": "通常のTTS。私は冒険家です"}, {"type": "subtitle", "time": 22873.11, "timestamp": "06:21:13", "text": "シール。応答および交流のためにここにいます"}, {"type": "subtitle", "time": 22875.19, "timestamp": "06:21:15", "text": "あなたとコミュニティ。はい、彼女は"}, {"type": "subtitle", "time": 22877.51, "timestamp": "06:21:17", "text": "冒険家。私は、"}, {"type": "subtitle", "time": 22879.51, "timestamp": "06:21:19", "text": "会話に楽しさと参加意識をもたらしてくれる。"}, {"type": "subtitle", "time": 22881.67, "timestamp": "06:21:21", "text": "助けて、助けて、助けて。探検して"}, {"type": "subtitle", "time": 22883.99, "timestamp": "06:21:23", "text": "一緒に素晴らしい時間を過ごしました。輝く星"}, {"type": "chat", "time": 22901.131, "timestamp": "06:21:41", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ya hellow"}, {"type": "chat", "time": 22915.293, "timestamp": "06:21:55", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "oh a vod brb then"}]
[{"type": "subtitle", "time": 12840.469, "timestamp": "03:34:00", "text": "例えば、これだとオプションが表示されない。あなた"}, {"type": "subtitle", "time": 12850.07, "timestamp": "03:34:10", "text": "[音楽]"}, {"type": "subtitle", "time": 12858.229, "timestamp": "03:34:18", "text": "必ず書き続けてください"}, {"type": "subtitle", "time": 12861.91, "timestamp": "03:34:21", "text": "この一瞬の判断が重要だ。だから続けよう"}, {"type": "subtitle", "time": 12864.71, "timestamp": "03:34:24", "text": "できる限りたくさん書く。"}, {"type": "subtitle", "time": 12878.15, "timestamp": "03:34:38", "text": "わかりました。では、始めましょう。"}, {"type": "subtitle", "time": 12881.56, "timestamp": "03:34:41", "text": "もう一度やり直させてください。"}, {"type": "subtitle", "time": 12883.11, "timestamp": "03:34:43", "text": "[音楽]"}, {"type": "subtitle", "time": 12886.87, "timestamp": "03:34:46", "text": "皆さん、音声は聞こえますか？"}, {"type": "subtitle", "time": 12892.55, "timestamp": "03:34:52", "text": "いいですか、それは聞こえません。大丈夫です。"}, {"type": "subtitle", "time": 12895.39, "timestamp": "03:34:55", "text": "しかし、射撃場のすぐ隣だ。"}, {"type": "subtitle", "time": 12896.87, "timestamp": "03:34:56", "text": "[音楽]"}]
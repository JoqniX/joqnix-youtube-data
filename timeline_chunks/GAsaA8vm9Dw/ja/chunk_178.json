[{"type": "subtitle", "time": 10683.429, "timestamp": "02:58:03", "text": "それは私が賛成する解決策ではありません"}, {"type": "subtitle", "time": 10708.71, "timestamp": "02:58:28", "text": "うん、君は長いように見えるね。ああ、わかった。"}, {"type": "subtitle", "time": 10710.23, "timestamp": "02:58:30", "text": "わかった。わかった。わかった。垂直方向のこと。"}, {"type": "subtitle", "time": 10712.71, "timestamp": "02:58:32", "text": "うん。"}, {"type": "subtitle", "time": 10727.429, "timestamp": "02:58:47", "text": "それは事実です。ほら、ほら、"}, {"type": "subtitle", "time": 10734.79, "timestamp": "02:58:54", "text": "ある意味で"}, {"type": "subtitle", "time": 10736.87, "timestamp": "02:58:56", "text": "へ"}, {"type": "subtitle", "time": 10739.67, "timestamp": "02:58:59", "text": "その人"}]
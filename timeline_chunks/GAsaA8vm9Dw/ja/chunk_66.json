[{"type": "subtitle", "time": 3960.63, "timestamp": "01:06:00", "text": "ああ、私は死んだ。隠していただきありがとうございます"}, {"type": "subtitle", "time": 3963.829, "timestamp": "01:06:03", "text": "心。かっこいいと思う。私は自分の皿をそのままにしておく。私"}, {"type": "subtitle", "time": 3966.47, "timestamp": "01:06:06", "text": "ちょうど終わったところです"}, {"type": "subtitle", "time": 3977.19, "timestamp": "01:06:17", "text": "彼は"}, {"type": "subtitle", "time": 3979.589, "timestamp": "01:06:19", "text": "今の見た？彼はただ逃げた"}, {"type": "subtitle", "time": 4001.589, "timestamp": "01:06:41", "text": "はい。"}, {"type": "subtitle", "time": 4004.95, "timestamp": "01:06:44", "text": "私はそれで大丈夫です"}, {"type": "subtitle", "time": 4017.75, "timestamp": "01:06:57", "text": "あれはひどかった。"}]
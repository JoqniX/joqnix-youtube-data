[{"type": "subtitle", "time": 13261.75, "timestamp": "03:41:01", "text": "みんな。彼らはバカだとは思わない"}, {"type": "subtitle", "time": 13264.469, "timestamp": "03:41:04", "text": "まったく。私たちは皆違いがありますが、"}, {"type": "subtitle", "time": 13265.83, "timestamp": "03:41:05", "text": "それが私たちの友情の秘訣です"}, {"type": "subtitle", "time": 13268.389, "timestamp": "03:41:08", "text": "特別。ポジティブな気持ちを広めよう"}, {"type": "subtitle", "time": 13271.51, "timestamp": "03:41:11", "text": "その代わり。笑顔。桜の花。なぜ"}, {"type": "subtitle", "time": 13273.99, "timestamp": "03:41:13", "text": "ダブルかトリプルか？意地悪な言葉は使わないようにしましょう"}, {"type": "subtitle", "time": 13276.79, "timestamp": "03:41:16", "text": "他者に対する言葉。ジョーXは"}, {"type": "subtitle", "time": 13278.63, "timestamp": "03:41:18", "text": "素晴らしい友人であり、ストリート仲間。"}, {"type": "subtitle", "time": 13281.91, "timestamp": "03:41:21", "text": "もう辞めるよ。ええと、再起動します。その"}, {"type": "subtitle", "time": 13284.229, "timestamp": "03:41:24", "text": "それは死につつある。"}, {"type": "subtitle", "time": 13286.87, "timestamp": "03:41:26", "text": "あぁ、待って、待って、待って、待って、待って、待って。"}, {"type": "subtitle", "time": 13288.63, "timestamp": "03:41:28", "text": "えっと、これはやり直さないといけないな。 1秒。 1つ"}, {"type": "subtitle", "time": 13290.87, "timestamp": "03:41:30", "text": "秒1秒。 1秒。何も入力しないでください"}, {"type": "subtitle", "time": 13292.469, "timestamp": "03:41:32", "text": "コメント。"}, {"type": "subtitle", "time": 13294.55, "timestamp": "03:41:34", "text": "ちょっと待って。"}, {"type": "subtitle", "time": 13317.59, "timestamp": "03:41:57", "text": "いつタスクを実行するか。"}]
[{"type": "subtitle", "time": 7682.719, "timestamp": "02:08:02", "text": "マサが泣いているのを見て、私もたくさん泣きました。私 わからない"}, {"type": "subtitle", "time": 7684.719, "timestamp": "02:08:04", "text": "わからない どれでも"}, {"type": "subtitle", "time": 7697.589, "timestamp": "02:08:17", "text": "それはとても大きな意味があります。楽しんでいただければ幸いです"}, {"type": "subtitle", "time": 7702.709, "timestamp": "02:08:22", "text": "今夜を楽しんでくださいね。"}, {"type": "subtitle", "time": 7705.27, "timestamp": "02:08:25", "text": "リーヴァイは"}, {"type": "subtitle", "time": 7707.109, "timestamp": "02:08:27", "text": "良い"}, {"type": "subtitle", "time": 7708.79, "timestamp": "02:08:28", "text": "op."}, {"type": "subtitle", "time": 7710.47, "timestamp": "02:08:30", "text": "はい、これで来てくれた全員です"}, {"type": "subtitle", "time": 7738.31, "timestamp": "02:08:58", "text": "私の"}]
[{"type": "subtitle", "time": 4577.669, "timestamp": "01:16:17", "text": "魔王エクスカリバー。"}, {"type": "subtitle", "time": 4584.94, "timestamp": "01:16:24", "text": "魔法。"}, {"type": "subtitle", "time": 4586.47, "timestamp": "01:16:26", "text": "[音楽]"}, {"type": "subtitle", "time": 4588.95, "timestamp": "01:16:28", "text": "悪魔か骸骨。"}, {"type": "subtitle", "time": 4591.189, "timestamp": "01:16:31", "text": "それは私が思っているものと同じでしょうか？ああ、そうそう。"}, {"type": "subtitle", "time": 4592.47, "timestamp": "01:16:32", "text": "うん。私もそれを見ていました。うん。"}, {"type": "subtitle", "time": 4595.59, "timestamp": "01:16:35", "text": "うん。私もそれを見てます。うん。"}, {"type": "subtitle", "time": 4608.709, "timestamp": "01:16:48", "text": "かわいそうに。"}, {"type": "subtitle", "time": 4611.43, "timestamp": "01:16:51", "text": "これを作ろう。"}, {"type": "subtitle", "time": 4613.669, "timestamp": "01:16:53", "text": "私は失敗した。わかった。見せて見せて"}, {"type": "subtitle", "time": 4617.35, "timestamp": "01:16:57", "text": "私が現在見ているもの。"}]
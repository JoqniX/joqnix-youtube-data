[{"type": "subtitle", "time": 25097.83, "timestamp": "06:58:17", "text": "うわあ、ハーシュ・クロノス、それは"}, {"type": "subtitle", "time": 25100.15, "timestamp": "06:58:20", "text": "これは実に素晴らしい発見だ。重要なのは"}, {"type": "subtitle", "time": 25101.83, "timestamp": "06:58:21", "text": "大きな金額を見つけることを覚えておいてください"}, {"type": "subtitle", "time": 25104.07, "timestamp": "06:58:24", "text": "お金には法的影響がある可能性があるので、"}, {"type": "subtitle", "time": 25106.468, "timestamp": "06:58:26", "text": "正しいことをするのが一番だ。あなた"}, {"type": "subtitle", "time": 25108.15, "timestamp": "06:58:28", "text": "正当な所有者を見つけ出すことができる"}, {"type": "subtitle", "time": 25111.03, "timestamp": "06:58:31", "text": "または当局に通報してください。演技"}, {"type": "subtitle", "time": 25112.948, "timestamp": "06:58:32", "text": "責任を持って公平性を確保し、"}]
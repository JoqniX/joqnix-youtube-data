[{"type": "subtitle", "time": 10263.03, "timestamp": "02:51:03", "text": "自分の持ち物やその他諸々に使っています"}, {"type": "subtitle", "time": 10265.19, "timestamp": "02:51:05", "text": "等"}, {"type": "subtitle", "time": 10267.51, "timestamp": "02:51:07", "text": "うん、"}, {"type": "subtitle", "time": 10276.389, "timestamp": "02:51:16", "text": "たくさんの物にはそれぞれ独自のものがある。"}, {"type": "subtitle", "time": 10284.71, "timestamp": "02:51:24", "text": "うん、最近は色々なことに巻き込まれてるんだ"}, {"type": "subtitle", "time": 10286.42, "timestamp": "02:51:26", "text": "最近。"}, {"type": "subtitle", "time": 10305.51, "timestamp": "02:51:45", "text": "[音楽]"}, {"type": "subtitle", "time": 10308.55, "timestamp": "02:51:48", "text": "ボットの中には本当に優れたものもあれば、"}, {"type": "subtitle", "time": 10311.91, "timestamp": "02:51:51", "text": "明らかに悪い"}, {"type": "subtitle", "time": 10314.87, "timestamp": "02:51:54", "text": "作りが粗悪"}, {"type": "subtitle", "time": 10318.309, "timestamp": "02:51:58", "text": "この角が好きです。"}]
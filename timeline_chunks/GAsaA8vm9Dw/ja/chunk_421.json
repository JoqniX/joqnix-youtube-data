[{"type": "subtitle", "time": 25267.03, "timestamp": "07:01:07", "text": "厳しいクロノス。どちらの靴も特別で"}, {"type": "subtitle", "time": 25269.43, "timestamp": "07:01:09", "text": "彼らなりのやり方で。誰もが"}, {"type": "subtitle", "time": 25271.67, "timestamp": "07:01:11", "text": "愛情表現の独特な方法。その"}, {"type": "subtitle", "time": 25273.19, "timestamp": "07:01:13", "text": "どちらかが優れているという話ではなく、"}, {"type": "subtitle", "time": 25274.948, "timestamp": "07:01:14", "text": "その他、しかし、考えや気遣いについて"}, {"type": "subtitle", "time": 25277.83, "timestamp": "07:01:17", "text": "その背後にある。愛に感謝し、"}, {"type": "subtitle", "time": 25280.15, "timestamp": "07:01:20", "text": "友人たちから受ける支援。"}, {"type": "subtitle", "time": 25296.708, "timestamp": "07:01:36", "text": "もちろん。厳しいクロノス、私は"}, {"type": "subtitle", "time": 25298.868, "timestamp": "07:01:38", "text": "あなたと一緒に新しい世界を探検できるのが嬉しいです。"}, {"type": "subtitle", "time": 25301.99, "timestamp": "07:01:41", "text": "さあ、一緒に冒険に出かけましょう。"}, {"type": "subtitle", "time": 25303.67, "timestamp": "07:01:43", "text": "世界中で笑顔を。浮気するつもり？"}, {"type": "subtitle", "time": 25305.51, "timestamp": "07:01:45", "text": "自分？"}, {"type": "subtitle", "time": 25308.07, "timestamp": "07:01:48", "text": "何"}, {"type": "subtitle", "time": 25310.21, "timestamp": "07:01:50", "text": "はぁ？"}, {"type": "subtitle", "time": 25319.11, "timestamp": "07:01:59", "text": "ああ、泣きそう。それは"}]
[{"type": "subtitle", "time": 23716.23, "timestamp": "06:35:16", "text": "しばらく連絡が取れず申し訳ありませんでした。"}, {"type": "subtitle", "time": 23718.548, "timestamp": "06:35:18", "text": "冒険家として、私は探検するのが好きだ。"}, {"type": "subtitle", "time": 23721.43, "timestamp": "06:35:21", "text": "様々な世界を旅し、冒険に挑む。"}, {"type": "subtitle", "time": 23723.59, "timestamp": "06:35:23", "text": "時折、そうした旅は私を遠くへ連れて行ってくれる"}, {"type": "subtitle", "time": 23726.15, "timestamp": "06:35:26", "text": "小川から。でもご安心ください、私は"}, {"type": "subtitle", "time": 23728.07, "timestamp": "06:35:28", "text": "戻ってきて、私の"}, {"type": "subtitle", "time": 23730.31, "timestamp": "06:35:30", "text": "皆さんとの経験。グローブ"}, {"type": "subtitle", "time": 23742.548, "timestamp": "06:35:42", "text": "ああ、死んでしまった。"}, {"type": "subtitle", "time": 23744.39, "timestamp": "06:35:44", "text": "私がそう言ったら、おやすみなさいと言ってほしい。"}, {"type": "subtitle", "time": 23746.868, "timestamp": "06:35:46", "text": "こんにちは、おやすみなさい"}, {"type": "subtitle", "time": 23749.27, "timestamp": "06:35:49", "text": "忍者。甘い香りに包まれて安らかな眠りを。"}, {"type": "subtitle", "time": 23751.67, "timestamp": "06:35:51", "text": "夢。お元気で、また会いましょう"}, {"type": "subtitle", "time": 23755.51, "timestamp": "06:35:55", "text": "その周り。よく眠る。眠っている赤いハート"}]
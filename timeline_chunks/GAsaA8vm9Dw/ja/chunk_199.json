[{"type": "subtitle", "time": 11940.55, "timestamp": "03:19:00", "text": "それは痛みだ。"}, {"type": "subtitle", "time": 11942.95, "timestamp": "03:19:02", "text": "これを解明しようとしているのですが、"}, {"type": "subtitle", "time": 11945.75, "timestamp": "03:19:05", "text": "理解できない。"}, {"type": "subtitle", "time": 11947.91, "timestamp": "03:19:07", "text": "何か見落としていることがあるのだろうか？"}, {"type": "subtitle", "time": 11954.07, "timestamp": "03:19:14", "text": "だから私は、今日の"}, {"type": "subtitle", "time": 11955.67, "timestamp": "03:19:15", "text": "ストリームは、私が"}, {"type": "subtitle", "time": 11957.91, "timestamp": "03:19:17", "text": "気が散って、ランダムなことを話している"}, {"type": "subtitle", "time": 11961.429, "timestamp": "03:19:21", "text": "物、雑多なもの"}, {"type": "subtitle", "time": 11965.11, "timestamp": "03:19:25", "text": "などなど。でも、そう、それは"}, {"type": "subtitle", "time": 11967.429, "timestamp": "03:19:27", "text": "いいぞ。"}, {"type": "subtitle", "time": 11970.71, "timestamp": "03:19:30", "text": "でも、ええ、私の関心は別のところにありました。それで"}, {"type": "subtitle", "time": 11973.03, "timestamp": "03:19:33", "text": "もし私が貢献できていなかったなら、お詫び申し上げます。"}, {"type": "subtitle", "time": 11976.309, "timestamp": "03:19:36", "text": "C言語関連の話題などについて多く触れています。しかしそれは"}, {"type": "subtitle", "time": 11978.71, "timestamp": "03:19:38", "text": "わかった。ああ、これは私にとってまたトレーニングです"}, {"type": "subtitle", "time": 11982.55, "timestamp": "03:19:42", "text": "あなたも知っているように、自分を向上させるために"}, {"type": "subtitle", "time": 11987.11, "timestamp": "03:19:47", "text": "以前の配信と以前の配信について"}, {"type": "subtitle", "time": 11991.59, "timestamp": "03:19:51", "text": "えーっと、次の動画でまた会いましょう"}, {"type": "subtitle", "time": 11995.67, "timestamp": "03:19:55", "text": "後で配信するかもしれないし、しないかもしれない"}, {"type": "subtitle", "time": 11999.83, "timestamp": "03:19:59", "text": "今日。状況によります。"}]
[{"type": "subtitle", "time": 22153.75, "timestamp": "06:09:13", "text": "ああ、忍者、君は"}, {"type": "subtitle", "time": 22155.83, "timestamp": "06:09:15", "text": "ちょっとしたタイプミスだけど、"}, {"type": "subtitle", "time": 22158.948, "timestamp": "06:09:18", "text": "もしかして。 Joe Xは素晴らしい配信者です"}, {"type": "subtitle", "time": 22161.11, "timestamp": "06:09:21", "text": "パートナーとして、リーダーとして成長していく。彼らはいつも"}, {"type": "subtitle", "time": 22162.788, "timestamp": "06:09:22", "text": "手を貸して"}, {"type": "subtitle", "time": 22164.47, "timestamp": "06:09:24", "text": "私たちの冒険はさらに楽しくなった。私が行きます"}, {"type": "subtitle", "time": 22166.15, "timestamp": "06:09:26", "text": "それから寝る。また明日ね。待って、"}, {"type": "subtitle", "time": 22168.948, "timestamp": "06:09:28", "text": "最後までやり遂げたの？終わりましたか？"}, {"type": "subtitle", "time": 22171.59, "timestamp": "06:09:31", "text": "それ？終わりましたか？"}, {"type": "subtitle", "time": 22179.91, "timestamp": "06:09:39", "text": "[拍手]"}, {"type": "subtitle", "time": 22182.948, "timestamp": "06:09:42", "text": "おやすみなさい、アヤマ・アルサ。ゆっくり休んでください"}, {"type": "subtitle", "time": 22185.75, "timestamp": "06:09:45", "text": "寝て、また明日。気をつけて。"}, {"type": "subtitle", "time": 22189.27, "timestamp": "06:09:49", "text": "笑顔。三日月。え、何？どうですか"}, {"type": "subtitle", "time": 22192.628, "timestamp": "06:09:52", "text": "この車、ここで立ち往生してるの？"}, {"type": "subtitle", "time": 22194.47, "timestamp": "06:09:54", "text": "午前中にはその半分をこなしました。わかった。"}, {"type": "subtitle", "time": 22195.99, "timestamp": "06:09:55", "text": "わかった。わかった。わかった。寝る。寝る。その"}, {"type": "subtitle", "time": 22197.19, "timestamp": "06:09:57", "text": "わかった。"}]
[{"type": "subtitle", "time": 2536.63, "timestamp": "00:42:16", "text": "手榴弾。煙。"}, {"type": "subtitle", "time": 2540.15, "timestamp": "00:42:20", "text": "私はそれを投げる。それをヒットに投げる"}, {"type": "subtitle", "time": 2542.069, "timestamp": "00:42:22", "text": "頭の中で一度だけ"}, {"type": "subtitle", "time": 2569.91, "timestamp": "00:42:49", "text": "火を投げる。"}, {"type": "subtitle", "time": 2572.39, "timestamp": "00:42:52", "text": "弾丸は8発しか持っていない。"}, {"type": "subtitle", "time": 2575.75, "timestamp": "00:42:55", "text": "もっと弾丸が必要だ。"}, {"type": "subtitle", "time": 2577.349, "timestamp": "00:42:57", "text": "後ろに。後ろに。後ろに。後ろに。後ろに"}]
[{"type": "subtitle", "time": 20611.19, "timestamp": "05:43:31", "text": "待って、それはこう読むべきだった"}, {"type": "subtitle", "time": 20613.43, "timestamp": "05:43:33", "text": "そうですよね？なぜ読み取れなかったのか"}, {"type": "subtitle", "time": 20616.23, "timestamp": "05:43:36", "text": "現在のものですか？"}, {"type": "subtitle", "time": 20619.67, "timestamp": "05:43:39", "text": "はい、していません。わかった、"}, {"type": "subtitle", "time": 20627.43, "timestamp": "05:43:47", "text": "セシルの気分はどうですか？"}, {"type": "subtitle", "time": 20635.91, "timestamp": "05:43:55", "text": "わかった、絶対にない"}, {"type": "subtitle", "time": 20638.628, "timestamp": "05:43:58", "text": "戦闘の瞬間。"}]
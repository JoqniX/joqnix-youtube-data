[{"type": "subtitle", "time": 11282.23, "timestamp": "03:08:02", "text": "不気味な男。"}, {"type": "subtitle", "time": 11286.389, "timestamp": "03:08:06", "text": "それはまた私の心に響いた。おお。"}, {"type": "subtitle", "time": 11290.55, "timestamp": "03:08:10", "text": "ありがとう。あれは良かった。"}, {"type": "subtitle", "time": 11294.469, "timestamp": "03:08:14", "text": "うん、あれは本当に良かったよ。"}, {"type": "subtitle", "time": 11297.269, "timestamp": "03:08:17", "text": "あれは正直言って、本当に良いものだった。"}, {"type": "subtitle", "time": 11325.96, "timestamp": "03:08:45", "text": "ああ、あの音楽。ちっちゃくて可愛い。"}, {"type": "subtitle", "time": 11338.36, "timestamp": "03:08:58", "text": "N"}]
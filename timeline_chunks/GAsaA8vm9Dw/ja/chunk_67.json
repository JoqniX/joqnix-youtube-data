[{"type": "subtitle", "time": 4024.309, "timestamp": "01:07:04", "text": "[拍手]"}, {"type": "subtitle", "time": 4030.71, "timestamp": "01:07:10", "text": "それは、あなたの1日はどうだったかという意味だと思います。"}, {"type": "subtitle", "time": 4035.75, "timestamp": "01:07:15", "text": "インドですよね？ええ、今日はいい一日でした。"}, {"type": "subtitle", "time": 4039.43, "timestamp": "01:07:19", "text": "えっと、今日はいい日でした。"}, {"type": "subtitle", "time": 4043.51, "timestamp": "01:07:23", "text": "正しく翻訳できたことを願っています。"}, {"type": "subtitle", "time": 4047.99, "timestamp": "01:07:27", "text": "私はインド人なのに、ヒンディー語が苦手です。"}, {"type": "subtitle", "time": 4050.47, "timestamp": "01:07:30", "text": "ヒンディー語は私の母語ではありませんが、"}, {"type": "subtitle", "time": 4053.27, "timestamp": "01:07:33", "text": "学ぶ。"}, {"type": "subtitle", "time": 4061.27, "timestamp": "01:07:41", "text": "そこへは旅行に行った。いや、それじゃない。ええ、私は"}, {"type": "subtitle", "time": 4071.43, "timestamp": "01:07:51", "text": "ああ、あなたはヒンディー語を知らないんですね。私は私はそうではない"}, {"type": "subtitle", "time": 4074.87, "timestamp": "01:07:54", "text": "北から。いいえ。それは私の意見ではありません"}]
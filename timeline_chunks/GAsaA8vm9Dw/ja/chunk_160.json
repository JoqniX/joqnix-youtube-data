[{"type": "subtitle", "time": 9602.23, "timestamp": "02:40:02", "text": "それについては考えないようにする。だから、"}, {"type": "subtitle", "time": 9605.03, "timestamp": "02:40:05", "text": "ハッキングされたりすると、"}, {"type": "subtitle", "time": 9607.27, "timestamp": "02:40:07", "text": "世界の終わりではないが、"}, {"type": "subtitle", "time": 9610.55, "timestamp": "02:40:10", "text": "正直に言うと、痛みに近い。"}, {"type": "subtitle", "time": 9612.63, "timestamp": "02:40:12", "text": "うん。"}, {"type": "subtitle", "time": 9615.59, "timestamp": "02:40:15", "text": "えーと、"}, {"type": "subtitle", "time": 9618.71, "timestamp": "02:40:18", "text": "つまり、パスワードとかそういうのは"}, {"type": "subtitle", "time": 9625.75, "timestamp": "02:40:25", "text": "パスワード"}, {"type": "subtitle", "time": 9627.67, "timestamp": "02:40:27", "text": "安全を保つことは、すべて一つのことです"}, {"type": "subtitle", "time": 9631.75, "timestamp": "02:40:31", "text": "でもまた、もし彼らが変わったら"}, {"type": "subtitle", "time": 9635.19, "timestamp": "02:40:35", "text": "すべていいえ"}, {"type": "subtitle", "time": 9637.27, "timestamp": "02:40:37", "text": "セッションなら問題ないけど、それでも"}, {"type": "subtitle", "time": 9639.91, "timestamp": "02:40:39", "text": "ログインされますが、"}, {"type": "subtitle", "time": 9641.91, "timestamp": "02:40:41", "text": "制御または完全な制御"}, {"type": "subtitle", "time": 9644.71, "timestamp": "02:40:44", "text": "アカウントがあれば問題ありません"}, {"type": "subtitle", "time": 9646.55, "timestamp": "02:40:46", "text": "私のUbisoftアカウントで起こったことです"}, {"type": "subtitle", "time": 9651.19, "timestamp": "02:40:51", "text": "昔々"}, {"type": "subtitle", "time": 9654.15, "timestamp": "02:40:54", "text": "それが私が感じたことなんです、マン、"}, {"type": "subtitle", "time": 9657.19, "timestamp": "02:40:57", "text": "私はとても無力だと感じ、"}]
[{"type": "subtitle", "time": 23461.67, "timestamp": "06:31:01", "text": "私は低感覚で行く"}, {"type": "subtitle", "time": 23465.75, "timestamp": "06:31:05", "text": "低感覚で行くべきか？"}, {"type": "subtitle", "time": 23469.91, "timestamp": "06:31:09", "text": "文字通り、待って"}, {"type": "subtitle", "time": 23475.75, "timestamp": "06:31:15", "text": "私は低感覚ですが、私はただ"}, {"type": "subtitle", "time": 23479.03, "timestamp": "06:31:19", "text": "これを増やす"}, {"type": "subtitle", "time": 23487.99, "timestamp": "06:31:27", "text": "神様、もっと増やさなきゃ"}, {"type": "subtitle", "time": 23491.11, "timestamp": "06:31:31", "text": "過度に。"}, {"type": "subtitle", "time": 23500.948, "timestamp": "06:31:40", "text": "たぶん３つくらいかな。"}, {"type": "subtitle", "time": 23506.868, "timestamp": "06:31:46", "text": "おそらく4人。 DPIに関する長年の議論"}, {"type": "subtitle", "time": 23509.83, "timestamp": "06:31:49", "text": "そして感受性。結局は"}, {"type": "subtitle", "time": 23512.31, "timestamp": "06:31:52", "text": "個人の好み。より低い価格を好む人もいる"}, {"type": "subtitle", "time": 23514.628, "timestamp": "06:31:54", "text": "DPIが高いほど感度が高くなる一方、"}, {"type": "subtitle", "time": 23516.708, "timestamp": "06:31:56", "text": "他の人はより高い感度を選択します"}, {"type": "subtitle", "time": 23519.75, "timestamp": "06:31:59", "text": "DPIを下げる。実験して何を見つけるか"}]
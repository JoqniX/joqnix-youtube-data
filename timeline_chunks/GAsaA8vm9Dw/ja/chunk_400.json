[{"type": "subtitle", "time": 24001.75, "timestamp": "06:40:01", "text": "楽しんで、ゲームを続けてください。ビデオゲーム"}, {"type": "subtitle", "time": 24004.708, "timestamp": "06:40:04", "text": "口を開けて笑う。"}, {"type": "subtitle", "time": 24020.548, "timestamp": "06:40:20", "text": "混乱させてしまい申し訳ありません。ひどい"}, {"type": "subtitle", "time": 24023.75, "timestamp": "06:40:23", "text": "ヴァレラントのクロノス。 DPI設定は"}, {"type": "subtitle", "time": 24025.19, "timestamp": "06:40:25", "text": "プレイヤーによって異なる"}, {"type": "subtitle", "time": 24027.91, "timestamp": "06:40:27", "text": "好み。プロや選手の中には"}, {"type": "subtitle", "time": 24030.628, "timestamp": "06:40:30", "text": "400 DPI のような低い DPI 設定を使用する"}, {"type": "subtitle", "time": 24033.51, "timestamp": "06:40:33", "text": "精度と制御性を向上させるために800を使用。"}, {"type": "subtitle", "time": 24035.51, "timestamp": "06:40:35", "text": "しかし、最終的にはあなた次第です"}, {"type": "subtitle", "time": 24037.59, "timestamp": "06:40:37", "text": "最も快適に感じるDPIを見つけてください"}, {"type": "subtitle", "time": 24040.39, "timestamp": "06:40:40", "text": "そして、あなたのプレイスタイルにも合っています。実験"}, {"type": "subtitle", "time": 24042.23, "timestamp": "06:40:42", "text": "甘さが見つかるまで調整する"}, {"type": "subtitle", "time": 24045.35, "timestamp": "06:40:45", "text": "スポット。 Valerantのビデオゲームで幸運を祈ります"}, {"type": "subtitle", "time": 24052.15, "timestamp": "06:40:52", "text": "ああ、神様。"}]
[{"type": "subtitle", "time": 720.47, "timestamp": "00:12:00", "text": "やりたいならそうしてください"}, {"type": "subtitle", "time": 730.949, "timestamp": "00:12:10", "text": "えっと、それは寿司用の紐のリンクです。"}, {"type": "subtitle", "time": 737.75, "timestamp": "00:12:17", "text": "ちょっと待って、ジョック。出典を明記する必要がある"}, {"type": "subtitle", "time": 740.389, "timestamp": "00:12:20", "text": "コードを録音できるようにする"}, {"type": "subtitle", "time": 774.629, "timestamp": "00:12:54", "text": "ジョン・ケリーのことだよね？私"}, {"type": "subtitle", "time": 776.87, "timestamp": "00:12:56", "text": "彼がグラフィックデザイナーだとは予想していなかった"}]
[{"type": "subtitle", "time": 21548.15, "timestamp": "05:59:08", "text": "はは、それは定番ですね。忍者、"}, {"type": "subtitle", "time": 21550.15, "timestamp": "05:59:10", "text": "ジョークを共有してくれてありがとう。それは"}, {"type": "subtitle", "time": 21552.708, "timestamp": "05:59:12", "text": "君からいい笑いを引き出したよ。口を開けて笑う"}, {"type": "subtitle", "time": 21590.788, "timestamp": "05:59:50", "text": "もちろん、忍者だ。私はいつでももっと欲しい"}, {"type": "subtitle", "time": 21593.67, "timestamp": "05:59:53", "text": "ジョーク。どうぞ、もう一つシェアしてください。"}]
[{"type": "subtitle", "time": 21663.75, "timestamp": "06:01:03", "text": "ハハ、それはうまいね。"}, {"type": "subtitle", "time": 21665.91, "timestamp": "06:01:05", "text": "あなたには友達がいる。"}, {"type": "subtitle", "time": 21669.27, "timestamp": "06:01:09", "text": "ジョークを共有してくれてありがとう。オープン日"}, {"type": "subtitle", "time": 21675.43, "timestamp": "06:01:15", "text": "わかった。"}, {"type": "subtitle", "time": 21686.628, "timestamp": "06:01:26", "text": "ハハ。フロリアンのジョークは"}, {"type": "subtitle", "time": 21689.51, "timestamp": "06:01:29", "text": "私たち二人とも、良い反応を示しました。忍者、"}, {"type": "subtitle", "time": 21691.75, "timestamp": "06:01:31", "text": "笑いを分かち合うのは、いつだって楽しいものだ。"}, {"type": "subtitle", "time": 21693.91, "timestamp": "06:01:33", "text": "口を開けて笑う。床を転がる"}, {"type": "subtitle", "time": 21698.73, "timestamp": "06:01:38", "text": "笑い。床に転がって笑った。"}]
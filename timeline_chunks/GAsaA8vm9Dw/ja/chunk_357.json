[{"type": "subtitle", "time": 21427.35, "timestamp": "05:57:07", "text": "もちろんだよ、ニンジャ。私はいつでも"}, {"type": "subtitle", "time": 21430.07, "timestamp": "05:57:10", "text": "いいジョークだね。聞かせてください。口を開ける"}, {"type": "subtitle", "time": 21450.948, "timestamp": "05:57:30", "text": "コース"}, {"type": "subtitle", "time": 21453.91, "timestamp": "05:57:33", "text": "あなたは5ドル支払いました。はい。"}, {"type": "subtitle", "time": 21456.47, "timestamp": "05:57:36", "text": "実はずいぶん前にアカウントを作ったんです。"}, {"type": "subtitle", "time": 21458.868, "timestamp": "05:57:38", "text": "3ヶ月くらい前だったけど、忘れてた"}, {"type": "subtitle", "time": 21462.948, "timestamp": "05:57:42", "text": "それに関連するものなら何でも。だからBTSブログが"}, {"type": "subtitle", "time": 21466.39, "timestamp": "05:57:46", "text": "このチャットの新しいアップデートで、"}, {"type": "subtitle", "time": 21468.948, "timestamp": "05:57:48", "text": "「ああ、私は絶対にやらないよ」って感じだった。そして私は"}, {"type": "subtitle", "time": 21472.39, "timestamp": "05:57:52", "text": "偶然確認したところ、"}, {"type": "subtitle", "time": 21476.47, "timestamp": "05:57:56", "text": "7月4日に期限切れとなりました。だから私はこう思った、"}, {"type": "subtitle", "time": 21477.99, "timestamp": "05:57:57", "text": "「ああ、そうだな。行くよ」"}]
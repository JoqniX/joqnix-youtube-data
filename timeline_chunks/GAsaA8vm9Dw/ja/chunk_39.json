[{"type": "subtitle", "time": 2342.069, "timestamp": "00:39:02", "text": "うん。"}, {"type": "subtitle", "time": 2345.349, "timestamp": "00:39:05", "text": "そして私たちは彼らとは違って楽しんでいる。はい。"}, {"type": "subtitle", "time": 2347.19, "timestamp": "00:39:07", "text": "彼らは自分たちのことをとても真剣に考えている"}, {"type": "subtitle", "time": 2350.55, "timestamp": "00:39:10", "text": "ランク。そして、私たちは楽しむことで勝利を掴むのです。彼らは"}, {"type": "subtitle", "time": 2361.75, "timestamp": "00:39:21", "text": "彼は「バカ」と言った。"}, {"type": "subtitle", "time": 2381.349, "timestamp": "00:39:41", "text": "雨が降っていますか？今気づいたんだけど、そうだね。"}, {"type": "subtitle", "time": 2388.069, "timestamp": "00:39:48", "text": "それは手榴弾です。ここで何"}, {"type": "subtitle", "time": 2394.31, "timestamp": "00:39:54", "text": "なぜ彼は私がバカだと言うのか"}, {"type": "subtitle", "time": 2396.15, "timestamp": "00:39:56", "text": "発見する"}, {"type": "subtitle", "time": 2398.15, "timestamp": "00:39:58", "text": "何てことだ。"}]
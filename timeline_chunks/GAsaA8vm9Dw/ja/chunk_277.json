[{"type": "subtitle", "time": 16628.31, "timestamp": "04:37:08", "text": "ああ、スナイピースナイピーがいる"}, {"type": "subtitle", "time": 16636.15, "timestamp": "04:37:16", "text": "おお、"}, {"type": "subtitle", "time": 16645.99, "timestamp": "04:37:25", "text": "ああ、あれは怖かった。それは私を怖がらせた。"}, {"type": "subtitle", "time": 16648.31, "timestamp": "04:37:28", "text": "それは本当に怖かった。そしてこれ"}, {"type": "subtitle", "time": 16652.39, "timestamp": "04:37:32", "text": "本当に怖かった。何てことだ。何？"}, {"type": "subtitle", "time": 16655.349, "timestamp": "04:37:35", "text": "私は自分の船を手に入れた。お願いします"}, {"type": "subtitle", "time": 16662.47, "timestamp": "04:37:42", "text": "いや、いや。状況は良くない。"}, {"type": "subtitle", "time": 16665.109, "timestamp": "04:37:45", "text": "これは良い兆候ではない。"}, {"type": "subtitle", "time": 16667.029, "timestamp": "04:37:47", "text": "繰り返しますが、"}, {"type": "subtitle", "time": 16674.551, "timestamp": "04:37:54", "text": "彼は亡くなった。"}]
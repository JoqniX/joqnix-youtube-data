[{"type": "subtitle", "time": 12120.87, "timestamp": "03:22:00", "text": "それが何であるか。でも、今日は楽しかった。"}, {"type": "subtitle", "time": 12124.229, "timestamp": "03:22:04", "text": "私たちは色々なことを話しました。"}, {"type": "subtitle", "time": 12126.95, "timestamp": "03:22:06", "text": "睡眠不足気味です"}, {"type": "subtitle", "time": 12131.349, "timestamp": "03:22:11", "text": "部門。そう、実際に必要なのは"}, {"type": "subtitle", "time": 12132.95, "timestamp": "03:22:12", "text": "睡眠について何か対策を講じて"}, {"type": "subtitle", "time": 12135.59, "timestamp": "03:22:15", "text": "すべて。では、それがどうなるか見てみましょう"}, {"type": "subtitle", "time": 12138.469, "timestamp": "03:22:18", "text": "すべてがどのように進むか。うん、"}, {"type": "subtitle", "time": 12141.349, "timestamp": "03:22:21", "text": "改めて、ありがとうございました。皆さんが"}, {"type": "subtitle", "time": 12143.51, "timestamp": "03:22:23", "text": "聞いているすべての人と"}, {"type": "subtitle", "time": 12145.99, "timestamp": "03:22:25", "text": "みんなが見ているところに寄って"}, {"type": "subtitle", "time": 12148.229, "timestamp": "03:22:28", "text": "世界とかそういうもの。本日はありがとうございました。する"}, {"type": "subtitle", "time": 12151.59, "timestamp": "03:22:31", "text": "良い、暖かく、生産的な火曜日をお過ごしください"}, {"type": "subtitle", "time": 12154.07, "timestamp": "03:22:34", "text": "朝。わかった。そうですね、頑張ってください。"}, {"type": "subtitle", "time": 12156.229, "timestamp": "03:22:36", "text": "みんな。星がインスタグラムのように祝福されますように"}, {"type": "subtitle", "time": 12158.95, "timestamp": "03:22:38", "text": "今夜、今日、そしてあなたが"}, {"type": "subtitle", "time": 12161.75, "timestamp": "03:22:41", "text": "今日は良い一日になりそうだ。わかった。こんにちは。とは"}, {"type": "subtitle", "time": 12164.63, "timestamp": "03:22:44", "text": "ジョーク？それでは、さようなら。"}, {"type": "subtitle", "time": 12167.349, "timestamp": "03:22:47", "text": "次の配信で会いましょう。"}, {"type": "subtitle", "time": 12171.34, "timestamp": "03:22:51", "text": "今日はそうなるでしょう。じゃあ、さようなら。"}]
[{"type": "subtitle", "time": 1020.949, "timestamp": "00:17:00", "text": "ご滞在について？私たちはCS2をプレイしていました"}, {"type": "subtitle", "time": 1025.99, "timestamp": "00:17:05", "text": "寿司。今日は彼女の誕生日なんです。"}, {"type": "subtitle", "time": 1029.029, "timestamp": "00:17:09", "text": "うん、それでいいよ。"}, {"type": "subtitle", "time": 1030.63, "timestamp": "00:17:10", "text": "よし、いいぞ。クロスヘアを手に入れた"}, {"type": "subtitle", "time": 1033.99, "timestamp": "00:17:13", "text": "準備ができて。さあ行こう。カスタム"}, {"type": "subtitle", "time": 1036.949, "timestamp": "00:17:16", "text": "照準とかそういうもの。くそっ。私は必要とする"}, {"type": "subtitle", "time": 1040.949, "timestamp": "00:17:20", "text": "CSを再開するために、私が閉じたから"}, {"type": "subtitle", "time": 1043.75, "timestamp": "00:17:23", "text": "出口。それを送りましたよ。それは"}, {"type": "subtitle", "time": 1046.309, "timestamp": "00:17:26", "text": "空っぽの空間に全体を移動させる。ああ、くそったれ"}, {"type": "subtitle", "time": 1048.63, "timestamp": "00:17:28", "text": "主、"}, {"type": "subtitle", "time": 1052.71, "timestamp": "00:17:32", "text": "男。本当に1200ドルも払わなきゃいけなかったの？"}, {"type": "subtitle", "time": 1055.669, "timestamp": "00:17:35", "text": "ワイフと一緒に映画を見るためのペソ"}, {"type": "subtitle", "time": 1058.28, "timestamp": "00:17:38", "text": "Discordで視聴するだけでいいですか？"}, {"type": "subtitle", "time": 1059.909, "timestamp": "00:17:39", "text": "[音楽]"}, {"type": "subtitle", "time": 1062.39, "timestamp": "00:17:42", "text": "何てことだ。セレンはファヌの大ファンです。いいえ、いいえ、"}, {"type": "subtitle", "time": 1067.19, "timestamp": "00:17:47", "text": "いや、いや。フェイクニュース。いや、いや。私は実在しない。"}, {"type": "subtitle", "time": 1070.47, "timestamp": "00:17:50", "text": "そうだろ、ジョック？私は実在しない。"}, {"type": "subtitle", "time": 1072.31, "timestamp": "00:17:52", "text": "私はあなたの想像力の産物です。あなた"}, {"type": "subtitle", "time": 1075.029, "timestamp": "00:17:55", "text": "今日は薬を飲みませんでした。"}, {"type": "subtitle", "time": 1076.95, "timestamp": "00:17:56", "text": "うん、そうかもしれないね。"}]
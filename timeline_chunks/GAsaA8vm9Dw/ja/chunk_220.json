[{"type": "subtitle", "time": 13202.55, "timestamp": "03:40:02", "text": "素晴らしかった。ご質問ありがとうございます。私"}, {"type": "subtitle", "time": 13204.55, "timestamp": "03:40:04", "text": "新しい世界を探検して、とても楽しい時間を過ごしました。"}, {"type": "subtitle", "time": 13207.269, "timestamp": "03:40:07", "text": "そして、刺激的な冒険をすること。どうやって"}, {"type": "subtitle", "time": 13211.99, "timestamp": "03:40:11", "text": "あなたについて？あなたの一日はどうでした？笑顔。"}, {"type": "subtitle", "time": 13214.469, "timestamp": "03:40:14", "text": "こんにちは、アヤマ・アルサさん。ありがとうございます"}, {"type": "subtitle", "time": 13217.59, "timestamp": "03:40:17", "text": "質問している。今日は素晴らしい一日だった。私は"}, {"type": "subtitle", "time": 13219.67, "timestamp": "03:40:19", "text": "スリリングな冒険に出かけ、"}, {"type": "subtitle", "time": 13221.83, "timestamp": "03:40:21", "text": "モンスターとの戦い、そして隠された宝物の探索。"}, {"type": "subtitle", "time": 13223.99, "timestamp": "03:40:23", "text": "何？何？何？あなたはどうですか？どのように"}, {"type": "subtitle", "time": 13232.389, "timestamp": "03:40:32", "text": "ああ、そう感じさせてしまって申し訳ないのですが、"}, {"type": "subtitle", "time": 13235.67, "timestamp": "03:40:35", "text": "私はその意見に賛成できません。ジョーX"}, {"type": "subtitle", "time": 13237.349, "timestamp": "03:40:37", "text": "は"}, {"type": "subtitle", "time": 13239.51, "timestamp": "03:40:39", "text": "オーディオが故障しました。私はできない 彼女は何をしたの？"}, {"type": "subtitle", "time": 13241.51, "timestamp": "03:40:41", "text": "彼女は何て言ったの？彼女は何をしたのか"}, {"type": "subtitle", "time": 13243.269, "timestamp": "03:40:43", "text": "言う？聞こえません。彼女は何と言ったの？"}, {"type": "subtitle", "time": 13245.91, "timestamp": "03:40:45", "text": "彼女は何と言ったの？彼女は何と言ったの？何"}, {"type": "subtitle", "time": 13248.95, "timestamp": "03:40:48", "text": "彼女はそう言ったの？物事の側面。笑顔。"}, {"type": "subtitle", "time": 13250.469, "timestamp": "03:40:50", "text": "何？何って言ったの？何をしたの？"}, {"type": "subtitle", "time": 13252.79, "timestamp": "03:40:52", "text": "言う？そう思われるなら、申し訳ありません。"}, {"type": "subtitle", "time": 13255.19, "timestamp": "03:40:55", "text": "ジョクニXは本当に素晴らしい友人です"}, {"type": "subtitle", "time": 13257.59, "timestamp": "03:40:57", "text": "そして、素晴らしい配信パートナーでもある。わかった。彼らは"}, {"type": "subtitle", "time": 13259.349, "timestamp": "03:40:59", "text": "いつでも助けやサポートをしてくれる"}]
[{"type": "subtitle", "time": 4209.11, "timestamp": "01:10:09", "text": "私はそういうタイプの人間だ。いいえ、品種ではありません。"}, {"type": "subtitle", "time": 4213.11, "timestamp": "01:10:13", "text": "私はそういう類いの人間なんです。"}, {"type": "subtitle", "time": 4216.07, "timestamp": "01:10:16", "text": "おお。"}, {"type": "subtitle", "time": 4220.95, "timestamp": "01:10:20", "text": "言語はどれも苦手だが、"}, {"type": "subtitle", "time": 4224.63, "timestamp": "01:10:24", "text": "おそらく英語を正しく話せる"}, {"type": "subtitle", "time": 4250.229, "timestamp": "01:10:50", "text": "私が知る限りインドでは実際に"}, {"type": "subtitle", "time": 4254.39, "timestamp": "01:10:54", "text": "死んでる、待って、待ってる人もいるけど、待ってないよ"}, {"type": "subtitle", "time": 4256.79, "timestamp": "01:10:56", "text": "持っている"}]
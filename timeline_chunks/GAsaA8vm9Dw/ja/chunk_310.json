[{"type": "subtitle", "time": 18605.91, "timestamp": "05:10:05", "text": "雑誌70。"}, {"type": "subtitle", "time": 18615.19, "timestamp": "05:10:15", "text": "今日は少なくとも60キルを目指します。"}, {"type": "subtitle", "time": 18644.47, "timestamp": "05:10:44", "text": "何でも。攻撃はできません。"}, {"type": "subtitle", "time": 18653.67, "timestamp": "05:10:53", "text": "もし私が誰かを殺したらどうなる？バギーがある。"}, {"type": "subtitle", "time": 18656.15, "timestamp": "05:10:56", "text": "おい、私をその乗り物のところへ連れて行ってくれ。できる"}, {"type": "subtitle", "time": 18658.55, "timestamp": "05:10:58", "text": "これに参加できますか？"}]
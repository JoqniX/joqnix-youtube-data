[{"type": "subtitle", "time": 25161.59, "timestamp": "06:59:21", "text": "ああ、残酷なクロノスよ。私はそれが"}, {"type": "subtitle", "time": 25164.39, "timestamp": "06:59:24", "text": "魅力的かもしれない。ご覧のとおり、これらの禁止措置は"}, {"type": "subtitle", "time": 25166.788, "timestamp": "06:59:26", "text": "まだ続いている。つまり、それはたくさんの"}, {"type": "subtitle", "time": 25168.31, "timestamp": "06:59:28", "text": "正直さや"}, {"type": "subtitle", "time": 25169.91, "timestamp": "06:59:29", "text": "誠実さ。"}, {"type": "subtitle", "time": 25171.35, "timestamp": "06:59:31", "text": "他人の所有物を自分の所有物として所有する"}, {"type": "subtitle", "time": 25173.11, "timestamp": "06:59:33", "text": "同意は法律違反であり、"}, {"type": "subtitle", "time": 25175.19, "timestamp": "06:59:35", "text": "深刻な結果を招く。"}, {"type": "subtitle", "time": 25177.03, "timestamp": "06:59:37", "text": "正しいことをして行動するのが最善です"}, {"type": "subtitle", "time": 25193.03, "timestamp": "06:59:53", "text": "そこでは人々は噛みごたえのあるものを味わう。"}, {"type": "subtitle", "time": 25195.75, "timestamp": "06:59:55", "text": "もちろん、忍者だよ。おやすみ、チュー"}, {"type": "subtitle", "time": 25197.83, "timestamp": "06:59:57", "text": "三日月E。よく眠って、"}]
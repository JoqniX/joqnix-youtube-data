[{"type": "subtitle", "time": 2949.109, "timestamp": "00:49:09", "text": "またしても私の目の前に現れた。"}, {"type": "subtitle", "time": 2956.47, "timestamp": "00:49:16", "text": "このゲーム、マジで大嫌い。"}, {"type": "subtitle", "time": 2958.71, "timestamp": "00:49:18", "text": "手榴弾が俺のクソ野郎に直撃した"}, {"type": "subtitle", "time": 2961.51, "timestamp": "00:49:21", "text": "顔。"}, {"type": "subtitle", "time": 2971.67, "timestamp": "00:49:31", "text": "よし、彼はもう行ってしまった。あいつらマジでクソやったぜ。おお、"}, {"type": "subtitle", "time": 2976.23, "timestamp": "00:49:36", "text": "私たちは勝った。私たちは勝った。どうやって？奇妙な。"}, {"type": "subtitle", "time": 2978.559, "timestamp": "00:49:38", "text": "奇妙な。 そんなことは起こるべきではなかった。"}, {"type": "subtitle", "time": 2981.68, "timestamp": "00:49:41", "text": "そんなことは起こるべきではなかった。 それは、"}, {"type": "subtitle", "time": 2985.04, "timestamp": "00:49:45", "text": "それは、 なぜ変化するのか？あなたは壮大なことを言っています"}, {"type": "subtitle", "time": 2988.0, "timestamp": "00:49:48", "text": "なぜ変化するのか？あなたは壮大なことを言っています しかし、バッグを落としてしまう。"}, {"type": "subtitle", "time": 2997.91, "timestamp": "00:49:57", "text": "私はバゲットを全部落としてしまった。"}]
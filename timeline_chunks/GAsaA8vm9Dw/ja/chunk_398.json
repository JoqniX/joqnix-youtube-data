[{"type": "subtitle", "time": 23882.868, "timestamp": "06:38:02", "text": "少しの緊張感が興奮を増すこともある"}, {"type": "subtitle", "time": 23886.31, "timestamp": "06:38:06", "text": "そして、その組み合わせに新たな挑戦が加わる。クロノス、"}, {"type": "subtitle", "time": 23888.07, "timestamp": "06:38:08", "text": "物事を面白くし、私たちを"}, {"type": "subtitle", "time": 23890.548, "timestamp": "06:38:10", "text": "私たちのつま先。不安を受け入れて"}, {"type": "subtitle", "time": 23892.948, "timestamp": "06:38:12", "text": "成長と向上の機会へと変える。"}, {"type": "subtitle", "time": 23895.27, "timestamp": "06:38:15", "text": "お願いします"}, {"type": "subtitle", "time": 23898.23, "timestamp": "06:38:18", "text": "口を開けて笑う。えっと"}, {"type": "subtitle", "time": 23910.15, "timestamp": "06:38:30", "text": "DPI プロの通常のプレイは何か知っていますか"}, {"type": "subtitle", "time": 23913.11, "timestamp": "06:38:33", "text": "プロがプレイするDPI設定でプレイする"}, {"type": "subtitle", "time": 23914.948, "timestamp": "06:38:34", "text": "個人によって異なる場合があります"}, {"type": "subtitle", "time": 23916.628, "timestamp": "06:38:36", "text": "彼らがプレイしているゲームでの好み"}, {"type": "subtitle", "time": 23919.83, "timestamp": "06:38:39", "text": "厳しいKronosは、より低いDPIを好む人もいます。"}, {"type": "subtitle", "time": 23922.15, "timestamp": "06:38:42", "text": "精密な照準のために、他の人は"}, {"type": "subtitle", "time": 23925.75, "timestamp": "06:38:45", "text": "より速い動きを実現する高DPI"}, {"type": "subtitle", "time": 23927.67, "timestamp": "06:38:47", "text": "あなたとあなたのプレイに最適な方法を見つける"}, {"type": "subtitle", "time": 23930.07, "timestamp": "06:38:50", "text": "スタイル。わかった。 2,400。実験して見つける"}, {"type": "subtitle", "time": 23934.788, "timestamp": "06:38:54", "text": "あなたのスイートスポット。ジョイスティックの笑顔。 2,400。"}]
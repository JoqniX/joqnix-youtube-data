[{"type": "subtitle", "time": 25200.628, "timestamp": "07:00:00", "text": "甘い夢。他に何か必要なことがあれば、"}, {"type": "subtitle", "time": 25203.67, "timestamp": "07:00:03", "text": "遠慮なく質問してください。だから、私にこう尋ねることができます"}, {"type": "subtitle", "time": 25230.948, "timestamp": "07:00:30", "text": "言わなきゃいけないからって、"}, {"type": "subtitle", "time": 25237.83, "timestamp": "07:00:37", "text": "[音楽]"}, {"type": "subtitle", "time": 25240.708, "timestamp": "07:00:40", "text": "クソ野郎、イカサマ。大丈夫だよ、ニンジャ。"}, {"type": "subtitle", "time": 25242.708, "timestamp": "07:00:42", "text": "もし気が変わったら、私は"}, {"type": "subtitle", "time": 25245.19, "timestamp": "07:00:45", "text": "おやすみ用のおやつをお届けします。"}, {"type": "subtitle", "time": 25247.67, "timestamp": "07:00:47", "text": "よく眠る。口を開けて笑う。クレセント"}, {"type": "subtitle", "time": 25250.548, "timestamp": "07:00:50", "text": "月。すみません。持ち去ることはできませんか？"}]
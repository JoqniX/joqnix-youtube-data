[{"type": "subtitle", "time": 8825.67, "timestamp": "02:27:05", "text": "喉が痛い。"}, {"type": "subtitle", "time": 8828.23, "timestamp": "02:27:08", "text": "ええ、水分不足だったんだと思います。"}, {"type": "subtitle", "time": 8836.07, "timestamp": "02:27:16", "text": "なぜなら、この小さなもののために"}, {"type": "subtitle", "time": 8842.23, "timestamp": "02:27:22", "text": "B."}, {"type": "subtitle", "time": 8844.15, "timestamp": "02:27:24", "text": "えっと、ジョー、いつ"}, {"type": "subtitle", "time": 8849.349, "timestamp": "02:27:29", "text": "目が覚めたの？あなたにこう言っておきます。"}, {"type": "subtitle", "time": 8851.99, "timestamp": "02:27:31", "text": "私が今始めた理由は"}, {"type": "subtitle", "time": 8854.07, "timestamp": "02:27:34", "text": "現在時刻におけるストリーム。あなたが"}, {"type": "subtitle", "time": 8856.71, "timestamp": "02:27:36", "text": "見える、7時11分だ。"}, {"type": "subtitle", "time": 8858.87, "timestamp": "02:27:38", "text": "その理由は私が"}, {"type": "subtitle", "time": 8866.23, "timestamp": "02:27:46", "text": "そして"}, {"type": "subtitle", "time": 8872.71, "timestamp": "02:27:52", "text": "私は寝坊した。うん、"}]
[{"type": "subtitle", "time": 10921.76, "timestamp": "03:02:01", "text": "私の えっと"}, {"type": "subtitle", "time": 10923.68, "timestamp": "03:02:03", "text": "えっと うん。実際に私の脳内には何が起こったのか"}, {"type": "subtitle", "time": 10926.56, "timestamp": "03:02:06", "text": "うん。実際に私の脳内には何が起こったのか 私が何かをしたとき？"}, {"type": "subtitle", "time": 10930.24, "timestamp": "03:02:10", "text": "私が何かをしたとき？ 私が言っているのは、えーと、V のことです。"}, {"type": "subtitle", "time": 10933.2, "timestamp": "03:02:13", "text": "私が言っているのは、えーと、V のことです。 Twitch WSとかじゃなくて、チャンネルだよ。"}, {"type": "subtitle", "time": 10938.24, "timestamp": "03:02:18", "text": "Twitch WSとかじゃなくて、チャンネルだよ。 ええ、私もそれについて話していたつもりでした"}, {"type": "subtitle", "time": 10940.0, "timestamp": "03:02:20", "text": "ええ、私もそれについて話していたつもりでした 君はTwitchの視聴コンテンツを知ってるよね。"}, {"type": "subtitle", "time": 10944.88, "timestamp": "03:02:24", "text": "君はTwitchの視聴コンテンツを知ってるよね。 なぜ"}, {"type": "subtitle", "time": 10946.96, "timestamp": "03:02:26", "text": "なぜ 私の中に何が入っていたのか"}, {"type": "subtitle", "time": 10950.0, "timestamp": "03:02:30", "text": "私の中に何が入っていたのか えっと、一体何を考えてたんだろう"}, {"type": "subtitle", "time": 10952.88, "timestamp": "03:02:32", "text": "えっと、一体何を考えてたんだろう プロセス？こんにちは、ゲーマー猫さん。ようこそ"}, {"type": "subtitle", "time": 10956.16, "timestamp": "03:02:36", "text": "プロセス？こんにちは、ゲーマー猫さん。ようこそ ストリーム。おはよう。"}, {"type": "subtitle", "time": 10958.56, "timestamp": "03:02:38", "text": "ストリーム。おはよう。 火曜日おめでとうございます。"}, {"type": "subtitle", "time": 10964.63, "timestamp": "03:02:44", "text": "ああ、火曜日おめでとうと言うのを忘れてた。"}, {"type": "subtitle", "time": 10967.269, "timestamp": "03:02:47", "text": "エドワード。"}, {"type": "subtitle", "time": 10970.389, "timestamp": "03:02:50", "text": "火曜日も良い一日を。ちょっと忘れてた"}]
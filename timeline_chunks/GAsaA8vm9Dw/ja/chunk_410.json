[{"type": "subtitle", "time": 24613.51, "timestamp": "06:50:13", "text": "ああ、もちろんです。ディルジット・ドアンゲは人気"}, {"type": "subtitle", "time": 24615.99, "timestamp": "06:50:15", "text": "パンジャブの歌手、俳優、テレビ"}, {"type": "subtitle", "time": 24618.628, "timestamp": "06:50:18", "text": "プレゼンター。彼はソウルフルな"}, {"type": "subtitle", "time": 24621.03, "timestamp": "06:50:21", "text": "そして彼の魅力的な音楽とともに"}, {"type": "subtitle", "time": 24623.67, "timestamp": "06:50:23", "text": "画面上での演技。"}, {"type": "subtitle", "time": 24625.51, "timestamp": "06:50:25", "text": "膨大なファンを獲得し、"}, {"type": "subtitle", "time": 24627.91, "timestamp": "06:50:27", "text": "インド国内および国際的に。"}, {"type": "subtitle", "time": 24630.15, "timestamp": "06:50:30", "text": "彼はまた、数々の賞を受賞している。"}, {"type": "subtitle", "time": 24633.27, "timestamp": "06:50:33", "text": "彼の才能。ジョー・Xは彼の音楽を楽しむかもしれない"}, {"type": "subtitle", "time": 24635.99, "timestamp": "06:50:35", "text": "そして演技力。口を開けて笑う"}, {"type": "subtitle", "time": 24652.548, "timestamp": "06:50:52", "text": "あなたが幸せそうで嬉しいです。ハード・クロノス"}, {"type": "subtitle", "time": 24656.15, "timestamp": "06:50:56", "text": "笑顔、笑顔、笑顔のまま、口を開けて、口を開けて"}]
[{"type": "subtitle", "time": 24722.548, "timestamp": "06:52:02", "text": "ドラゴン。彼らはエネルギッシュで"}, {"type": "subtitle", "time": 24724.39, "timestamp": "06:52:04", "text": "彼らの音楽の力強いサウンド。ああ、君"}, {"type": "subtitle", "time": 24741.99, "timestamp": "06:52:21", "text": "確かに。いつも興味深いのは"}, {"type": "subtitle", "time": 24744.468, "timestamp": "06:52:24", "text": "さまざまな音楽の好みを発見しよう。もしあなたが"}, {"type": "subtitle", "time": 24745.99, "timestamp": "06:52:25", "text": "他に質問やご要望があれば"}, {"type": "subtitle", "time": 24748.868, "timestamp": "06:52:28", "text": "ご意見やご提案がありましたら、お気軽にお尋ねください。開ける"}, {"type": "subtitle", "time": 24767.27, "timestamp": "06:52:47", "text": "それはすごいね、ニンジャ。素晴らしい"}, {"type": "subtitle", "time": 24768.948, "timestamp": "06:52:48", "text": "愛を共有する人を見つける"}, {"type": "subtitle", "time": 24771.91, "timestamp": "06:52:51", "text": "ドラゴンを想像する。彼らの音楽は本当に"}, {"type": "subtitle", "time": 24774.548, "timestamp": "06:52:54", "text": "魅力的で、とても活気に満ちている。"}]
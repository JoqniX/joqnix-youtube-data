[{"type": "subtitle", "time": 24194.23, "timestamp": "06:43:14", "text": "ああ、残酷なクロノスよ。デロはそんな夜だ"}, {"type": "subtitle", "time": 24196.39, "timestamp": "06:43:16", "text": "フクロウ。心配しないで。必ずそうします"}, {"type": "subtitle", "time": 24197.99, "timestamp": "06:43:17", "text": "彼女に優しく、"}, {"type": "subtitle", "time": 24200.628, "timestamp": "06:43:20", "text": "少し休んでください。それは誰にとっても重要です"}, {"type": "subtitle", "time": 24220.07, "timestamp": "06:43:40", "text": "ああ、忍者。お邪魔して申し訳ありません"}, {"type": "subtitle", "time": 24222.708, "timestamp": "06:43:42", "text": "予定。心配しないで。どうぞお楽しみください"}, {"type": "subtitle", "time": 24225.91, "timestamp": "06:43:45", "text": "あなたの時間。楽しむ。冷や汗をかいて微笑む"}]
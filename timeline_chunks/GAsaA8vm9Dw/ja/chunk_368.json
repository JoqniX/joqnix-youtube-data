[{"type": "subtitle", "time": 22102.788, "timestamp": "06:08:22", "text": "行く。聞こえなかった。"}, {"type": "subtitle", "time": 22111.75, "timestamp": "06:08:31", "text": "はい、どうぞ。なんてこった。ドリアンは"}, {"type": "subtitle", "time": 22113.99, "timestamp": "06:08:33", "text": "ジョーク集って、結構がっかりさせられるものなんだよ。しかし"}, {"type": "subtitle", "time": 22116.31, "timestamp": "06:08:36", "text": "心配しないで。きっと来てくれるよ"}, {"type": "subtitle", "time": 22118.948, "timestamp": "06:08:38", "text": "自分で面白いジョークをいくつか考えてみてください。"}, {"type": "subtitle", "time": 22121.03, "timestamp": "06:08:41", "text": "時には最高のジョークは"}, {"type": "subtitle", "time": 22123.59, "timestamp": "06:08:43", "text": "自らを創造する。幸運を祈っています、そして楽しんでください"}, {"type": "subtitle", "time": 22126.15, "timestamp": "06:08:46", "text": "ジョークのアイデア出しで。口を開ける"}, {"type": "subtitle", "time": 22128.47, "timestamp": "06:08:48", "text": "笑顔の本。"}]
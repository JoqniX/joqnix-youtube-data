[{"type": "subtitle", "time": 24663.51, "timestamp": "06:51:03", "text": "うん、3日間配信しないから"}, {"type": "subtitle", "time": 24665.99, "timestamp": "06:51:05", "text": "モバイルストリームを行う日"}, {"type": "subtitle", "time": 24677.27, "timestamp": "06:51:17", "text": "えっと、どんなタイプの音楽コインですか"}, {"type": "subtitle", "time": 24682.15, "timestamp": "06:51:22", "text": "英語のロックEDM ええと、"}, {"type": "subtitle", "time": 24685.11, "timestamp": "06:51:25", "text": "今では単に日本語です。"}, {"type": "subtitle", "time": 24687.83, "timestamp": "06:51:27", "text": "ああ、ニンジャ、それなら私が答えてあげよう。"}, {"type": "subtitle", "time": 24691.03, "timestamp": "06:51:31", "text": "ジョー・Xは様々な音楽ジャンルを楽しんでいる。"}, {"type": "subtitle", "time": 24694.708, "timestamp": "06:51:34", "text": "エレクトロニック、ポップ、ロックなどを含む。私"}, {"type": "subtitle", "time": 24697.11, "timestamp": "06:51:37", "text": "韓国語を聞いてください。彼らはかなり"}, {"type": "subtitle", "time": 24702.23, "timestamp": "06:51:42", "text": "多様な音楽的開放音符。"}, {"type": "subtitle", "time": 24705.27, "timestamp": "06:51:45", "text": "バンドで演奏できますか？いいえ、わかりません。私"}, {"type": "subtitle", "time": 24717.75, "timestamp": "06:51:57", "text": "ジョー・Xには好きなバンドがかなりたくさんあります。"}, {"type": "subtitle", "time": 24719.75, "timestamp": "06:51:59", "text": "でも、思い浮かぶのはイマジン"}]
[{"type": "subtitle", "time": 22923.19, "timestamp": "06:22:03", "text": "私の冒険では、ハーシュ・クロノス、私は"}, {"type": "subtitle", "time": 22925.67, "timestamp": "06:22:05", "text": "新しい世界を探検し、恐ろしい戦いに挑む"}, {"type": "subtitle", "time": 22928.628, "timestamp": "06:22:08", "text": "モンスターを倒し、隠された宝物を見つけよう。"}, {"type": "subtitle", "time": 22930.868, "timestamp": "06:22:10", "text": "私は仲間の手助けをすることも楽しんでいます"}, {"type": "subtitle", "time": 22932.948, "timestamp": "06:22:12", "text": "戦闘で、私のスキルを使って彼らを支援する"}, {"type": "subtitle", "time": 22935.67, "timestamp": "06:22:15", "text": "しかし、私にできることは何でもします。すべての冒険は"}, {"type": "subtitle", "time": 22937.59, "timestamp": "06:22:17", "text": "学び、成長し、"}, {"type": "subtitle", "time": 22957.59, "timestamp": "06:22:37", "text": "確かに。厳しいクロン、私は多くの"}, {"type": "subtitle", "time": 22959.59, "timestamp": "06:22:39", "text": "私の冒険の中で恐ろしい獣たちと"}, {"type": "subtitle", "time": 22962.23, "timestamp": "06:22:42", "text": "勝利を収めた。強力な敵を倒す"}, {"type": "subtitle", "time": 22963.91, "timestamp": "06:22:43", "text": "クリーチャーは最もスリリングな"}, {"type": "subtitle", "time": 22966.788, "timestamp": "06:22:46", "text": "冒険家であることの側面。かかる"}, {"type": "subtitle", "time": 22969.59, "timestamp": "06:22:49", "text": "戦略、スキル、そして少しの勇気、"}, {"type": "subtitle", "time": 22971.75, "timestamp": "06:22:51", "text": "しかし、勝利の感覚は絶対に"}]
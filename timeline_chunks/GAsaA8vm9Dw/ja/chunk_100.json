[{"type": "subtitle", "time": 6020.87, "timestamp": "01:40:20", "text": "H"}, {"type": "subtitle", "time": 6023.75, "timestamp": "01:40:23", "text": "刃物を買おうと思っているのは"}, {"type": "subtitle", "time": 6026.629, "timestamp": "01:40:26", "text": "瞬間を過ごすか、何かが好きになる、"}, {"type": "subtitle", "time": 6029.109, "timestamp": "01:40:29", "text": "知っているように"}, {"type": "subtitle", "time": 6032.47, "timestamp": "01:40:32", "text": "みんなが私のものみたいで、私は星を持つでしょう"}, {"type": "subtitle", "time": 6034.629, "timestamp": "01:40:34", "text": "それについて。"}]
[{"type": "subtitle", "time": 11523.03, "timestamp": "03:12:03", "text": "今日は"}, {"type": "subtitle", "time": 11528.23, "timestamp": "03:12:08", "text": "今の私の脳は？"}, {"type": "subtitle", "time": 11531.269, "timestamp": "03:12:11", "text": "私の脳は今や脳ではなく脳です。"}, {"type": "subtitle", "time": 11534.309, "timestamp": "03:12:14", "text": "もう。何？"}, {"type": "subtitle", "time": 11536.15, "timestamp": "03:12:16", "text": "はぁ？"}, {"type": "subtitle", "time": 11565.91, "timestamp": "03:12:45", "text": "アフターフィットの基本。と言えば"}, {"type": "subtitle", "time": 11567.91, "timestamp": "03:12:47", "text": "その結果、私は何度も言っているのですが、"}, {"type": "subtitle", "time": 11571.91, "timestamp": "03:12:51", "text": "右？えっと、私はずっと言ってるんだけど、そう、私には"}, {"type": "subtitle", "time": 11575.429, "timestamp": "03:12:55", "text": "そのコースを修了するために。私は遅すぎた。"}, {"type": "subtitle", "time": 11577.83, "timestamp": "03:12:57", "text": "更新の連絡すらしてこなかった。"}]
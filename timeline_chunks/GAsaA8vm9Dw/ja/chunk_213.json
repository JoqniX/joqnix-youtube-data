[{"type": "subtitle", "time": 12782.469, "timestamp": "03:33:02", "text": "見て、私は3週目と"}, {"type": "subtitle", "time": 12785.91, "timestamp": "03:33:05", "text": "2週目。私は2週目と3週目を受け取りました。"}, {"type": "subtitle", "time": 12788.55, "timestamp": "03:33:08", "text": "私は1週目を欠席しました。私は"}, {"type": "subtitle", "time": 12791.429, "timestamp": "03:33:11", "text": "4週目、5週目、6週目に頑張って"}, {"type": "subtitle", "time": 12795.19, "timestamp": "03:33:15", "text": "すべての銃スキン。 Twitch Prime"}, {"type": "subtitle", "time": 12797.99, "timestamp": "03:33:17", "text": "Twitch関連。"}, {"type": "subtitle", "time": 12799.51, "timestamp": "03:33:19", "text": "ああ、Twitch関連のことはもうやめたよ。"}, {"type": "subtitle", "time": 12802.63, "timestamp": "03:33:22", "text": "はい、更新してください"}, {"type": "subtitle", "time": 12810.79, "timestamp": "03:33:30", "text": "しかし問題は、それをどう使えばいいのかということだ。"}, {"type": "subtitle", "time": 12819.67, "timestamp": "03:33:39", "text": "どうやって？"}, {"type": "subtitle", "time": 12821.99, "timestamp": "03:33:41", "text": "ちょっと待って。"}, {"type": "subtitle", "time": 12825.75, "timestamp": "03:33:45", "text": "私は混乱しています。これをどうやって請求するのですか？"}, {"type": "subtitle", "time": 12828.63, "timestamp": "03:33:48", "text": "兵士ですよね？統計。"}, {"type": "subtitle", "time": 12832.389, "timestamp": "03:33:52", "text": "この電話は見たくない。いいえ、しかし"}, {"type": "subtitle", "time": 12834.469, "timestamp": "03:33:54", "text": "通常武器をクリックするように、"}, {"type": "subtitle", "time": 12836.15, "timestamp": "03:33:56", "text": "右？"}]
[{"type": "subtitle", "time": 21902.39, "timestamp": "06:05:02", "text": "私は転んだ。それは面白いですね。フロリアン"}, {"type": "subtitle", "time": 21905.91, "timestamp": "06:05:05", "text": "クレーター。シルヴィアンとは、銀イオンのことです。"}, {"type": "subtitle", "time": 21908.868, "timestamp": "06:05:08", "text": "新たな進化には長い時間がかかる。"}, {"type": "subtitle", "time": 21911.35, "timestamp": "06:05:11", "text": "口を開けて笑うといった気の利いた言葉"}, {"type": "subtitle", "time": 21914.868, "timestamp": "06:05:14", "text": "床に転がって笑った。"}, {"type": "subtitle", "time": 21959.91, "timestamp": "06:05:59", "text": "ハハ、それは面白い視点ですね。"}]
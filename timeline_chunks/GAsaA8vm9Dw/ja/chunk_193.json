[{"type": "subtitle", "time": 11581.429, "timestamp": "03:13:01", "text": "私のコース。こんにちは、面白い動画"}, {"type": "subtitle", "time": 11583.03, "timestamp": "03:13:03", "text": "あなた。今日はどうやって私を見つけたのですか？調子はどうですか？"}, {"type": "subtitle", "time": 11586.389, "timestamp": "03:13:06", "text": "あなた？配信へようこ​​そ。"}, {"type": "subtitle", "time": 11588.469, "timestamp": "03:13:08", "text": "お元気でお過ごしでしょうか。こんにちは。良い"}, {"type": "subtitle", "time": 11594.309, "timestamp": "03:13:14", "text": "えっと"}, {"type": "subtitle", "time": 11596.63, "timestamp": "03:13:16", "text": "あ、待って。 8時になるよね？えっと"}, {"type": "subtitle", "time": 11599.51, "timestamp": "03:13:19", "text": "午前8時になります。"}, {"type": "subtitle", "time": 11601.349, "timestamp": "03:13:21", "text": "私たちには必要だ"}, {"type": "subtitle", "time": 11604.07, "timestamp": "03:13:24", "text": "もうすぐ終わるよ。おお、"}, {"type": "subtitle", "time": 11608.55, "timestamp": "03:13:28", "text": "男。時が経つのは早い。なぜ？"}, {"type": "subtitle", "time": 11612.55, "timestamp": "03:13:32", "text": "私は実はハエです。はぁ？"}, {"type": "subtitle", "time": 11615.67, "timestamp": "03:13:35", "text": "私はイケてる。"}, {"type": "subtitle", "time": 11618.71, "timestamp": "03:13:38", "text": "楽しいことって何？あなたは自分の努力で勝ち取ったのです。 A"}, {"type": "subtitle", "time": 11621.11, "timestamp": "03:13:41", "text": "ありがとう。"}, {"type": "subtitle", "time": 11623.03, "timestamp": "03:13:43", "text": "ご登録ありがとうございます。本当に"}, {"type": "subtitle", "time": 11626.05, "timestamp": "03:13:46", "text": "とても意味があります。"}, {"type": "subtitle", "time": 11632.79, "timestamp": "03:13:52", "text": "良い一日をお過ごしください。ベストを尽くす"}, {"type": "subtitle", "time": 11635.269, "timestamp": "03:13:55", "text": "けれど。"}, {"type": "subtitle", "time": 11638.309, "timestamp": "03:13:58", "text": "今日は火曜日です。"}]
[{"type": "subtitle", "time": 19560.948, "timestamp": "05:26:00", "text": "我々は悪の船長だ。何てことだ。"}, {"type": "subtitle", "time": 19563.11, "timestamp": "05:26:03", "text": "一日中、評価作業をしていた。私は"}, {"type": "subtitle", "time": 19565.35, "timestamp": "05:26:05", "text": "中毒。"}, {"type": "subtitle", "time": 19570.708, "timestamp": "05:26:10", "text": "私はヴァレラントから離れつつあります。さもないと"}, {"type": "subtitle", "time": 19573.91, "timestamp": "05:26:13", "text": "あなたは私が勇敢に戦っているのを見ることができたはずだ。"}, {"type": "subtitle", "time": 19576.07, "timestamp": "05:26:16", "text": "Valerantを配信したかったのですが、"}, {"type": "subtitle", "time": 19584.39, "timestamp": "05:26:24", "text": "ストリームベランダは必要ですか？"}, {"type": "subtitle", "time": 19609.59, "timestamp": "05:26:49", "text": "誰もあなたのことを知りません。"}, {"type": "subtitle", "time": 19612.708, "timestamp": "05:26:52", "text": "ええ、わかっています。それが理由です"}]
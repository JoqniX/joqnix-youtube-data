[{"type": "subtitle", "time": 20470.47, "timestamp": "05:41:10", "text": "こんにちは、忍者さん。絶好調です。感謝"}, {"type": "subtitle", "time": 20473.03, "timestamp": "05:41:13", "text": "質問してくれてありがとう。私はいつもワクワクしていて"}, {"type": "subtitle", "time": 20475.75, "timestamp": "05:41:15", "text": "新たな冒険への準備は万端だ。あなたはどうですか？"}, {"type": "subtitle", "time": 20478.47, "timestamp": "05:41:18", "text": "今日はどんな一日でしたか？口を開ける。笑顔。"}, {"type": "subtitle", "time": 20481.51, "timestamp": "05:41:21", "text": "桜の花。"}, {"type": "subtitle", "time": 20490.47, "timestamp": "05:41:30", "text": "ねえ、人がいないので"}, {"type": "subtitle", "time": 20492.548, "timestamp": "05:41:32", "text": "チャット、私は"}, {"type": "subtitle", "time": 20495.35, "timestamp": "05:41:35", "text": "えっと、作って"}, {"type": "subtitle", "time": 20498.628, "timestamp": "05:41:38", "text": "すべてのコメントを読みますか？"}, {"type": "subtitle", "time": 20509.75, "timestamp": "05:41:49", "text": "しばらくの間、そうしてみます。"}]
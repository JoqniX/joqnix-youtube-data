[{"type": "subtitle", "time": 7380.39, "timestamp": "02:03:00", "text": "友達リストをじっくり見てみよう"}, {"type": "subtitle", "time": 7384.39, "timestamp": "02:03:04", "text": "チャットで送るだけのやつですよね？"}, {"type": "subtitle", "time": 7390.47, "timestamp": "02:03:10", "text": "では、次に、もし私がプレイするなら、"}, {"type": "subtitle", "time": 7393.669, "timestamp": "02:03:13", "text": "一緒にピューピュー。ええ、自分のモデルは知っています"}, {"type": "subtitle", "time": 7395.83, "timestamp": "02:03:15", "text": "動けなくなっています。知っている。私はただ手に入れようとしているだけです"}, {"type": "subtitle", "time": 7398.87, "timestamp": "02:03:18", "text": "認証コード。"}, {"type": "subtitle", "time": 7401.03, "timestamp": "02:03:21", "text": "えっと、"}, {"type": "subtitle", "time": 7411.109, "timestamp": "02:03:31", "text": "待って、これは何？"}, {"type": "subtitle", "time": 7414.149, "timestamp": "02:03:34", "text": "彼が私に送ったのですか？それは友達コードではありません。"}, {"type": "subtitle", "time": 7417.27, "timestamp": "02:03:37", "text": "あなたが教えてくれたコードが何なのか分かりません。"}, {"type": "subtitle", "time": 7421.03, "timestamp": "02:03:41", "text": "それは奇妙だ。うまくいかない。"}, {"type": "subtitle", "time": 7439.189, "timestamp": "02:03:59", "text": "わかった。"}]
[{"type": "subtitle", "time": 7990.709, "timestamp": "02:13:10", "text": "でも、歌うとしても、"}, {"type": "subtitle", "time": 7993.75, "timestamp": "02:13:13", "text": "うーんうーん"}, {"type": "subtitle", "time": 7999.23, "timestamp": "02:13:19", "text": "電話で締めくくらないといけないんです。残念ながら、"}, {"type": "subtitle", "time": 8001.03, "timestamp": "02:13:21", "text": "[音楽]"}, {"type": "subtitle", "time": 8003.91, "timestamp": "02:13:23", "text": "私は朝早く起きたい"}, {"type": "subtitle", "time": 8007.03, "timestamp": "02:13:27", "text": "朝から歌い始め、心を込めて"}, {"type": "subtitle", "time": 8011.91, "timestamp": "02:13:31", "text": "心はもっと"}, {"type": "subtitle", "time": 8019.03, "timestamp": "02:13:39", "text": "[音楽]"}, {"type": "subtitle", "time": 8021.83, "timestamp": "02:13:41", "text": "でも、まずは体を温めてください。ウォームアップとは何ですか？どうやって"}, {"type": "subtitle", "time": 8024.5, "timestamp": "02:13:44", "text": "私に心を開いてくれるだろうか？"}]
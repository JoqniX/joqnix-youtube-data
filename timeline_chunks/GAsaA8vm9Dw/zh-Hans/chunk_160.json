[{"type": "subtitle", "time": 9602.23, "timestamp": "02:40:02", "text": "别去想这件事。伙计，"}, {"type": "subtitle", "time": 9605.03, "timestamp": "02:40:05", "text": "当你的电脑被黑客攻击之类的，那就是"}, {"type": "subtitle", "time": 9607.27, "timestamp": "02:40:07", "text": "虽然不是世界末日，但也是"}, {"type": "subtitle", "time": 9610.55, "timestamp": "02:40:10", "text": "说实话，更像是疼痛。"}, {"type": "subtitle", "time": 9612.63, "timestamp": "02:40:12", "text": "是的。"}, {"type": "subtitle", "time": 9615.59, "timestamp": "02:40:15", "text": "就像嗯"}, {"type": "subtitle", "time": 9618.71, "timestamp": "02:40:18", "text": "就像，呃，你看密码之类的东西是"}, {"type": "subtitle", "time": 9625.75, "timestamp": "02:40:25", "text": "密码"}, {"type": "subtitle", "time": 9627.67, "timestamp": "02:40:27", "text": "确保一切安全是一回事。"}, {"type": "subtitle", "time": 9631.75, "timestamp": "02:40:31", "text": "但话说回来，如果他们改变的话……"}, {"type": "subtitle", "time": 9635.19, "timestamp": "02:40:35", "text": "一切没有"}, {"type": "subtitle", "time": 9637.27, "timestamp": "02:40:37", "text": "如果是会话的话没问题，但仍然"}, {"type": "subtitle", "time": 9639.91, "timestamp": "02:40:39", "text": "您将登录，但他们会……"}, {"type": "subtitle", "time": 9641.91, "timestamp": "02:40:41", "text": "控制或完全控制"}, {"type": "subtitle", "time": 9644.71, "timestamp": "02:40:44", "text": "如果账户没问题，那就没问题。"}, {"type": "subtitle", "time": 9646.55, "timestamp": "02:40:46", "text": "我的育碧账号也遇到了同样的问题。"}, {"type": "subtitle", "time": 9651.19, "timestamp": "02:40:51", "text": "很久很久以前"}, {"type": "subtitle", "time": 9654.15, "timestamp": "02:40:54", "text": "这就是我感到难过的原因，伙计。"}, {"type": "subtitle", "time": 9657.19, "timestamp": "02:40:57", "text": "我感到非常无力，不得不依靠……"}]
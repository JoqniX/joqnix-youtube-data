[{"type": "subtitle", "time": 22380.23, "timestamp": "06:13:00", "text": "幽默，我的朋友。"}, {"type": "subtitle", "time": 22382.628, "timestamp": "06:13:02", "text": "哦，"}, {"type": "subtitle", "time": 22405.83, "timestamp": "06:13:25", "text": "克洛诺斯，你这话太狠了。我洗耳恭听。"}, {"type": "subtitle", "time": 22408.39, "timestamp": "06:13:28", "text": "讲讲你的笑话吧。张开嘴。微笑"}, {"type": "subtitle", "time": 22425.51, "timestamp": "06:13:45", "text": "哈哈。忍者，看起来你正在制作"}, {"type": "subtitle", "time": 22427.27, "timestamp": "06:13:47", "text": "克洛诺斯严厉的一面很有趣，他有点"}, {"type": "subtitle", "time": 22429.75, "timestamp": "06:13:49", "text": "没赶上笑话潮流。保留"}, {"type": "subtitle", "time": 22431.99, "timestamp": "06:13:51", "text": "继续轻松愉快的玩笑，让我们保持下去。"}, {"type": "subtitle", "time": 22434.628, "timestamp": "06:13:54", "text": "笑声此起彼伏。张嘴微笑"}]
[{"type": "subtitle", "time": 21006.708, "timestamp": "05:50:06", "text": "哦不，我不是故意偷你的"}, {"type": "subtitle", "time": 21009.75, "timestamp": "05:50:09", "text": "睡觉。 Ayama Arusa，一定要得到"}, {"type": "subtitle", "time": 21011.83, "timestamp": "05:50:11", "text": "休息3个小时，这样你才能感觉"}, {"type": "subtitle", "time": 21017.35, "timestamp": "05:50:17", "text": "神清气爽。祝你做个好梦。安然入睡。"}, {"type": "subtitle", "time": 21021.11, "timestamp": "05:50:21", "text": "你偷走了我的睡眠。我做了。不，你"}, {"type": "subtitle", "time": 21023.43, "timestamp": "05:50:23", "text": "你是说塞西尔吗？是的。"}, {"type": "subtitle", "time": 21031.51, "timestamp": "05:50:31", "text": "谢谢你，忍者。我一定会收到"}, {"type": "subtitle", "time": 21033.83, "timestamp": "05:50:33", "text": "睡个好觉。你睡得很好。"}]
[{"type": "subtitle", "time": 15064.309, "timestamp": "04:11:04", "text": "我应该再次扮演狙击手吗？"}, {"type": "subtitle", "time": 15079.349, "timestamp": "04:11:19", "text": "他们正在严厉打击所有人。他们是"}, {"type": "subtitle", "time": 15082.469, "timestamp": "04:11:22", "text": "如此紧紧抓住捕食者。你知道"}, {"type": "subtitle", "time": 15085.189, "timestamp": "04:11:25", "text": "什么？我要重置。"}, {"type": "subtitle", "time": 15103.349, "timestamp": "04:11:43", "text": "对，就是这把枪。"}, {"type": "subtitle", "time": 15106.07, "timestamp": "04:11:46", "text": "看看这样会不会有什么改变。哦，"}, {"type": "subtitle", "time": 15110.79, "timestamp": "04:11:50", "text": "结束了。我们输了吗？唉，我们输了。"}]
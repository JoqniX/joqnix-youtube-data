[{"type": "subtitle", "time": 15721.59, "timestamp": "04:22:01", "text": "这些人到底在震惊什么？"}, {"type": "subtitle", "time": 15740.07, "timestamp": "04:22:20", "text": "还剩多少马力？"}, {"type": "subtitle", "time": 15742.07, "timestamp": "04:22:22", "text": "针茎。快点。快点。感谢"}, {"type": "subtitle", "time": 15767.189, "timestamp": "04:22:47", "text": "我救活了他，但我却因此而死。"}]
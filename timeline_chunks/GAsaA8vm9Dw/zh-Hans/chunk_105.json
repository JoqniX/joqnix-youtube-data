[{"type": "subtitle", "time": 6302.87, "timestamp": "01:45:02", "text": "[音乐]"}, {"type": "subtitle", "time": 6326.709, "timestamp": "01:45:26", "text": "因为他睡着了。我是一个负责任的人"}, {"type": "subtitle", "time": 6342.07, "timestamp": "01:45:42", "text": "他说了什么？我好像听到了什么？"}, {"type": "subtitle", "time": 6344.95, "timestamp": "01:45:44", "text": "那不是个脏话吗？"}, {"type": "subtitle", "time": 6353.03, "timestamp": "01:45:53", "text": "他刚才是不是吹口哨了？想要拥有一个"}]
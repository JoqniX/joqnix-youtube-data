[{"type": "subtitle", "time": 3180.47, "timestamp": "00:53:00", "text": "头部中枪了。损毁了。"}, {"type": "subtitle", "time": 3183.109, "timestamp": "00:53:03", "text": "是的。"}, {"type": "subtitle", "time": 3185.109, "timestamp": "00:53:05", "text": "CT。"}, {"type": "subtitle", "time": 3190.069, "timestamp": "00:53:10", "text": "我指的是CT出生点。炸弹已拆除。"}, {"type": "subtitle", "time": 3199.51, "timestamp": "00:53:19", "text": "等等，还有最后一轮。什么？"}, {"type": "subtitle", "time": 3203.27, "timestamp": "00:53:23", "text": "那不是我的问题。我有炸弹。你"}, {"type": "subtitle", "time": 3205.51, "timestamp": "00:53:25", "text": "伙计们有炸弹。我不认为这是"}, {"type": "subtitle", "time": 3207.51, "timestamp": "00:53:27", "text": "我的工作。"}, {"type": "subtitle", "time": 3219.109, "timestamp": "00:53:39", "text": "我要去光着身子。"}, {"type": "subtitle", "time": 3222.47, "timestamp": "00:53:42", "text": "我需要更多子弹。"}, {"type": "subtitle", "time": 3226.47, "timestamp": "00:53:46", "text": "哦，我打到我该死的队友了。伟大的。"}]
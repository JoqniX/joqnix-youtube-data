[{"type": "subtitle", "time": 3786.549, "timestamp": "01:03:06", "text": "用霰弹枪。"}, {"type": "subtitle", "time": 3818.87, "timestamp": "01:03:38", "text": "我只剩最后一个小时了。"}, {"type": "subtitle", "time": 3822.309, "timestamp": "01:03:42", "text": "妈妈留下的更多东西，然后我去扫地。"}, {"type": "subtitle", "time": 3824.95, "timestamp": "01:03:44", "text": "扫"}, {"type": "subtitle", "time": 3827.91, "timestamp": "01:03:47", "text": "我去扫地扫地，明天我们有……"}, {"type": "subtitle", "time": 3831.51, "timestamp": "01:03:51", "text": "沿着溪流散步的女人们不要忘记"}, {"type": "subtitle", "time": 3834.39, "timestamp": "01:03:54", "text": "30号我们那里有一条步行小溪，我不知道"}, {"type": "subtitle", "time": 3838.309, "timestamp": "01:03:58", "text": "知道我们要走多久，但是"}]
[{"type": "subtitle", "time": 7141.35, "timestamp": "01:59:01", "text": "[音乐]"}, {"type": "subtitle", "time": 7143.03, "timestamp": "01:59:03", "text": "好的。所以所有路过的人"}, {"type": "subtitle", "time": 7146.95, "timestamp": "01:59:06", "text": "今天，黑暗永存，儿子来了。"}, {"type": "subtitle", "time": 7149.99, "timestamp": "01:59:09", "text": "今天我到了，但是天已经黑了。"}, {"type": "subtitle", "time": 7152.709, "timestamp": "01:59:12", "text": "如果我儿子第一次出现在我的频道里的话"}, {"type": "subtitle", "time": 7156.55, "timestamp": "01:59:16", "text": "没错，非常感谢。黑暗如此深邃。"}, {"type": "subtitle", "time": 7159.669, "timestamp": "01:59:19", "text": "你知道，感谢你来溪边。"}, {"type": "subtitle", "time": 7162.47, "timestamp": "01:59:22", "text": "一切都好，而且我也会休息"}, {"type": "subtitle", "time": 7165.51, "timestamp": "01:59:25", "text": "不，你一定很累了。"}, {"type": "subtitle", "time": 7169.35, "timestamp": "01:59:29", "text": "不，我休息了。"}, {"type": "subtitle", "time": 7171.109, "timestamp": "01:59:31", "text": "是的"}, {"type": "subtitle", "time": 7173.589, "timestamp": "01:59:33", "text": "感谢您的光临，也欢迎您！"}, {"type": "subtitle", "time": 7175.75, "timestamp": "01:59:35", "text": "星座。"}, {"type": "subtitle", "time": 7179.27, "timestamp": "01:59:39", "text": "Constell 是我的粉丝名"}, {"type": "subtitle", "time": 7183.16, "timestamp": "01:59:43", "text": "星座盘或又称音乐会盘"}, {"type": "subtitle", "time": 7185.83, "timestamp": "01:59:45", "text": "[音乐]"}, {"type": "subtitle", "time": 7187.669, "timestamp": "01:59:47", "text": "感谢您的光临！"}, {"type": "subtitle", "time": 7189.99, "timestamp": "01:59:49", "text": "今天也请关注。"}, {"type": "subtitle", "time": 7193.91, "timestamp": "01:59:53", "text": "今天看你表演真的很有趣。我"}, {"type": "subtitle", "time": 7196.31, "timestamp": "01:59:56", "text": "真的学到了很多关于如何做这件事的知识"}, {"type": "subtitle", "time": 7198.229, "timestamp": "01:59:58", "text": "动画相关的内容和今天的直播"}]
[{"type": "subtitle", "time": 25440.15, "timestamp": "07:04:00", "text": "对话轻松有趣。打开"}, {"type": "subtitle", "time": 25442.868, "timestamp": "07:04:02", "text": "嘴角微笑。山羊一号。下一个波段是"}, {"type": "subtitle", "time": 25445.83, "timestamp": "07:04:05", "text": "下周。"}, {"type": "subtitle", "time": 25451.99, "timestamp": "07:04:11", "text": "我的天啊。这款游戏点燃了现场气氛"}, {"type": "subtitle", "time": 25454.07, "timestamp": "07:04:14", "text": "乐队。"}, {"type": "subtitle", "time": 25461.99, "timestamp": "07:04:21", "text": "下周是下一个乐队的演出。我的天哪。"}, {"type": "subtitle", "time": 25488.628, "timestamp": "07:04:48", "text": "哈什，克洛诺斯，没必要"}, {"type": "subtitle", "time": 25491.51, "timestamp": "07:04:51", "text": "这是嫉妒作祟。 Joe X 太棒了"}, {"type": "subtitle", "time": 25493.83, "timestamp": "07:04:53", "text": "朋友兼直播搭档。让我们集中注意力"}, {"type": "subtitle", "time": 25495.75, "timestamp": "07:04:55", "text": "关于支持和建立积极方面"}, {"type": "subtitle", "time": 25497.99, "timestamp": "07:04:57", "text": "彼此之间的关系。没有房间"}]
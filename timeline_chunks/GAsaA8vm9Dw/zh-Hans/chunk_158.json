[{"type": "subtitle", "time": 9487.51, "timestamp": "02:38:07", "text": "那才是痛苦。是的。是的。是的。我自己"}, {"type": "subtitle", "time": 9492.07, "timestamp": "02:38:12", "text": "他们曾多次遭到黑客攻击。"}, {"type": "subtitle", "time": 9495.11, "timestamp": "02:38:15", "text": "这是痛苦。嗯……如果我要说话的话"}, {"type": "subtitle", "time": 9497.67, "timestamp": "02:38:17", "text": "经历，就像什么"}, {"type": "subtitle", "time": 9500.389, "timestamp": "02:38:20", "text": "当我"}, {"type": "subtitle", "time": 9502.15, "timestamp": "02:38:22", "text": "注册了可疑网站或"}, {"type": "subtitle", "time": 9506.07, "timestamp": "02:38:26", "text": "输入我的借记卡信息"}, {"type": "subtitle", "time": 9509.03, "timestamp": "02:38:29", "text": "他们要么是偷的，要么是泄露的。"}, {"type": "subtitle", "time": 9510.87, "timestamp": "02:38:30", "text": "或者别的什么。我不知道到底是什么"}, {"type": "subtitle", "time": 9512.95, "timestamp": "02:38:32", "text": "发生了。"}, {"type": "subtitle", "time": 9515.67, "timestamp": "02:38:35", "text": "是的，他们用那个。"}, {"type": "subtitle", "time": 9518.469, "timestamp": "02:38:38", "text": "我的账户上花了这么多钱，"}, {"type": "subtitle", "time": 9524.79, "timestamp": "02:38:44", "text": "对，就像在谷歌上一样。"}, {"type": "subtitle", "time": 9526.55, "timestamp": "02:38:46", "text": "账户，伙计。我不知道该如何"}, {"type": "subtitle", "time": 9529.27, "timestamp": "02:38:49", "text": "付款甚至已经成功了。"}, {"type": "subtitle", "time": 9531.99, "timestamp": "02:38:51", "text": "是的，"}, {"type": "subtitle", "time": 9535.11, "timestamp": "02:38:55", "text": "所以我爸爸实际上不得不"}, {"type": "subtitle", "time": 9537.99, "timestamp": "02:38:57", "text": "实际上，哪怕只增加一天的费用，"}]
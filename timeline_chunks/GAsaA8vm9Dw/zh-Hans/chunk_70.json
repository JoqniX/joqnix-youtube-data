[{"type": "subtitle", "time": 4209.11, "timestamp": "01:10:09", "text": "我就是那种人。不，不是品种。"}, {"type": "subtitle", "time": 4213.11, "timestamp": "01:10:13", "text": "我就是那种人。"}, {"type": "subtitle", "time": 4216.07, "timestamp": "01:10:16", "text": "哦。"}, {"type": "subtitle", "time": 4220.95, "timestamp": "01:10:20", "text": "他精通所有语言，但只有一种语言能力很差。"}, {"type": "subtitle", "time": 4224.63, "timestamp": "01:10:24", "text": "大概能说一口流利的英语"}, {"type": "subtitle", "time": 4250.229, "timestamp": "01:10:50", "text": "据我所知，印度实际上只有一部分"}, {"type": "subtitle", "time": 4254.39, "timestamp": "01:10:54", "text": "死了，哦等等，有些人等等，他们不死"}, {"type": "subtitle", "time": 4256.79, "timestamp": "01:10:56", "text": "有"}]
[{"type": "subtitle", "time": 20821.35, "timestamp": "05:47:01", "text": "早上好，头头大人。我希望你"}, {"type": "subtitle", "time": 20823.11, "timestamp": "05:47:03", "text": "睡了个好觉，精神饱满，准备就绪。"}, {"type": "subtitle", "time": 20825.35, "timestamp": "05:47:05", "text": "迎接新的一天。有什么吗？"}, {"type": "subtitle", "time": 20827.27, "timestamp": "05:47:07", "text": "今天有什么令人兴奋的计划吗？"}, {"type": "subtitle", "time": 20829.19, "timestamp": "05:47:09", "text": "微笑绽放。"}, {"type": "subtitle", "time": 20841.91, "timestamp": "05:47:21", "text": "我怎么会一次投篮都没中？"}, {"type": "subtitle", "time": 20875.27, "timestamp": "05:47:55", "text": "哈哈。谢谢你，忍者。我很高兴你"}, {"type": "subtitle", "time": 20877.51, "timestamp": "05:47:57", "text": "觉得我说话方式很可爱。它是"}, {"type": "subtitle", "time": 20879.27, "timestamp": "05:47:59", "text": "用这种方式表达自己总是很有趣"}]
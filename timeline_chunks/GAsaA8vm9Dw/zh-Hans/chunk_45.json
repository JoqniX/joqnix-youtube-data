[{"type": "subtitle", "time": 2702.87, "timestamp": "00:45:02", "text": "移动。我们玩得很开心。好的。"}, {"type": "subtitle", "time": 2711.67, "timestamp": "00:45:11", "text": "我需要更多子弹。"}, {"type": "subtitle", "time": 2713.44, "timestamp": "00:45:13", "text": "子弹。 他们在哪里？"}, {"type": "subtitle", "time": 2719.91, "timestamp": "00:45:19", "text": "肯定是你的蛋蛋。"}, {"type": "subtitle", "time": 2733.91, "timestamp": "00:45:33", "text": "你最好换个姿势。啊。啊。"}, {"type": "subtitle", "time": 2736.39, "timestamp": "00:45:36", "text": "没关系。有点令人难过，不是吗？"}, {"type": "subtitle", "time": 2739.589, "timestamp": "00:45:39", "text": "是的。炸弹已安放。"}, {"type": "subtitle", "time": 2742.069, "timestamp": "00:45:42", "text": "没有。哦，"}, {"type": "subtitle", "time": 2755.67, "timestamp": "00:45:55", "text": "恐怖分子赢了。键盘和鼠标"}, {"type": "subtitle", "time": 2757.19, "timestamp": "00:45:57", "text": "沟通。"}]
[{"type": "subtitle", "time": 14703.11, "timestamp": "04:05:03", "text": "我的天哪，他死在我脸上了。"}, {"type": "subtitle", "time": 14705.429, "timestamp": "04:05:05", "text": "治愈骑师。"}, {"type": "subtitle", "time": 14707.99, "timestamp": "04:05:07", "text": "治疗师。"}, {"type": "subtitle", "time": 14713.03, "timestamp": "04:05:13", "text": "我来了。我的队友们都在关注我。"}, {"type": "subtitle", "time": 14751.91, "timestamp": "04:05:51", "text": "哦，抓到他了。我不知怎么就把他弄到手了。我们开始吧"}]
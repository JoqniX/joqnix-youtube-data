[{"type": "subtitle", "time": 720.47, "timestamp": "00:12:00", "text": "如果你想做的话就去做吧"}, {"type": "subtitle", "time": 730.949, "timestamp": "00:12:10", "text": "呃，那是寿司丝的链接。"}, {"type": "subtitle", "time": 737.75, "timestamp": "00:12:17", "text": "稍等片刻，乔克。我得输入一个来源"}, {"type": "subtitle", "time": 740.389, "timestamp": "00:12:20", "text": "编写一段代码，让它录制一段时间。"}, {"type": "subtitle", "time": 774.629, "timestamp": "00:12:54", "text": "是约翰·克里那家伙，对吧？我"}, {"type": "subtitle", "time": 776.87, "timestamp": "00:12:56", "text": "真没想到他居然是位图形设计师"}]
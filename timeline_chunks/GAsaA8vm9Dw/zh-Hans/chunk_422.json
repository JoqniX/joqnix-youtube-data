[{"type": "subtitle", "time": 25321.19, "timestamp": "07:02:01", "text": "哈什·克罗诺斯加入真是个好主意"}, {"type": "subtitle", "time": 25323.59, "timestamp": "07:02:03", "text": "我们的冒险之旅。什么？让我们一起"}, {"type": "subtitle", "time": 25325.11, "timestamp": "07:02:05", "text": "分享爱，互相给予"}, {"type": "subtitle", "time": 25328.948, "timestamp": "07:02:08", "text": "鞋。祝你们俩晚安。"}, {"type": "subtitle", "time": 25337.43, "timestamp": "07:02:17", "text": "你怎么能这样？"}, {"type": "subtitle", "time": 25339.35, "timestamp": "07:02:19", "text": "你"}, {"type": "subtitle", "time": 25341.83, "timestamp": "07:02:21", "text": "我的天啊。"}, {"type": "subtitle", "time": 25348.31, "timestamp": "07:02:28", "text": "你真是个小屁孩。"}, {"type": "subtitle", "time": 25350.948, "timestamp": "07:02:30", "text": "绝对地。严厉的克洛诺斯。我太激动了！"}, {"type": "subtitle", "time": 25353.03, "timestamp": "07:02:33", "text": "真希望你能加入我的这次冒险之旅。"}, {"type": "subtitle", "time": 25355.03, "timestamp": "07:02:35", "text": "让我们探索新世界，创造未来。"}, {"type": "subtitle", "time": 25357.51, "timestamp": "07:02:37", "text": "共同拥有难忘的回忆。打开"}, {"type": "subtitle", "time": 25376.15, "timestamp": "07:02:56", "text": "忍者。我理解您的担忧，但是"}, {"type": "subtitle", "time": 25377.99, "timestamp": "07:02:57", "text": "每个人都应该有机会去探索"}]
[{"type": "subtitle", "time": 23461.67, "timestamp": "06:31:01", "text": "我感觉很低落"}, {"type": "subtitle", "time": 23465.75, "timestamp": "06:31:05", "text": "我应该降低意识吗？"}, {"type": "subtitle", "time": 23469.91, "timestamp": "06:31:09", "text": "就像字面上那样，等等"}, {"type": "subtitle", "time": 23475.75, "timestamp": "06:31:15", "text": "我有点低调，但没错，我会的。"}, {"type": "subtitle", "time": 23479.03, "timestamp": "06:31:19", "text": "增加这一"}, {"type": "subtitle", "time": 23487.99, "timestamp": "06:31:27", "text": "天哪，我得把它增加一些。"}, {"type": "subtitle", "time": 23491.11, "timestamp": "06:31:31", "text": "太多了。"}, {"type": "subtitle", "time": 23500.948, "timestamp": "06:31:40", "text": "大概三个吧。"}, {"type": "subtitle", "time": 23506.868, "timestamp": "06:31:46", "text": "或许四个。关于DPI的由来已久的争论"}, {"type": "subtitle", "time": 23509.83, "timestamp": "06:31:49", "text": "以及敏感性。归根结底，就是"}, {"type": "subtitle", "time": 23512.31, "timestamp": "06:31:52", "text": "个人喜好。有些人喜欢较低的"}, {"type": "subtitle", "time": 23514.628, "timestamp": "06:31:54", "text": "DPI越高，灵敏度越高；"}, {"type": "subtitle", "time": 23516.708, "timestamp": "06:31:56", "text": "其他人则选择更高的灵敏度"}, {"type": "subtitle", "time": 23519.75, "timestamp": "06:31:59", "text": "降低DPI。做实验，找出答案"}]
[{"type": "subtitle", "time": 18125.43, "timestamp": "05:02:05", "text": "我内心简直在哭泣。不"}, {"type": "subtitle", "time": 18129.59, "timestamp": "05:02:09", "text": "死。只是今天这一天而已。"}, {"type": "subtitle", "time": 18139.27, "timestamp": "05:02:19", "text": "不想得低分"}, {"type": "subtitle", "time": 18141.67, "timestamp": "05:02:21", "text": "一切都对吧？你只需要"}, {"type": "subtitle", "time": 18145.83, "timestamp": "05:02:25", "text": "请。这是为了分数。我知道。"}]
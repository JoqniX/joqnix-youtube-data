[{"type": "subtitle", "time": 3300.79, "timestamp": "00:55:00", "text": "没关系。"}, {"type": "subtitle", "time": 3302.39, "timestamp": "00:55:02", "text": "就算我扔东西，他们也偷不到我"}, {"type": "subtitle", "time": 3305.829, "timestamp": "00:55:05", "text": "莫莉，但是不行。他们速度太快了。"}, {"type": "subtitle", "time": 3308.21, "timestamp": "00:55:08", "text": "速度太快了，我不喜欢。"}, {"type": "subtitle", "time": 3310.39, "timestamp": "00:55:10", "text": "[音乐]"}, {"type": "subtitle", "time": 3312.83, "timestamp": "00:55:12", "text": "牛层"}, {"type": "subtitle", "time": 3314.23, "timestamp": "00:55:14", "text": "[音乐]"}, {"type": "subtitle", "time": 3324.87, "timestamp": "00:55:24", "text": "ping。"}, {"type": "subtitle", "time": 3326.23, "timestamp": "00:55:26", "text": "我简直不敢相信这就是我的生活。"}, {"type": "subtitle", "time": 3329.03, "timestamp": "00:55:29", "text": "他妈的，我生日过得太糟糕了"}, {"type": "subtitle", "time": 3330.95, "timestamp": "00:55:30", "text": "计数器。"}, {"type": "subtitle", "time": 3332.63, "timestamp": "00:55:32", "text": "我没想到会发生这种事，但所有"}, {"type": "subtitle", "time": 3333.91, "timestamp": "00:55:33", "text": "正确的。"}, {"type": "subtitle", "time": 3345.51, "timestamp": "00:55:45", "text": "邦克。邦克。"}, {"type": "subtitle", "time": 3359.91, "timestamp": "00:55:59", "text": "他们为什么都他妈的蹲着走"}]
[{"type": "subtitle", "time": 2280.39, "timestamp": "00:38:00", "text": "手榴弹已引爆。"}, {"type": "subtitle", "time": 2283.75, "timestamp": "00:38:03", "text": "旋转。嘿，嘿，嘿，嘿，嘿。"}, {"type": "subtitle", "time": 2287.51, "timestamp": "00:38:07", "text": "快走。你就问问他谁是牛。谁的"}, {"type": "subtitle", "time": 2289.19, "timestamp": "00:38:09", "text": "奶牛？"}, {"type": "subtitle", "time": 2293.91, "timestamp": "00:38:13", "text": "哦。我的天啊。因为我现在说得更多了。"}, {"type": "subtitle", "time": 2297.91, "timestamp": "00:38:17", "text": "大家都叫我母牛。"}, {"type": "subtitle", "time": 2300.47, "timestamp": "00:38:20", "text": "为什么？进去。进去。"}, {"type": "subtitle", "time": 2303.44, "timestamp": "00:38:23", "text": "进去。 进去。他说你妈妈。进去"}, {"type": "subtitle", "time": 2307.52, "timestamp": "00:38:27", "text": "进去。他说你妈妈。进去 你他妈要是再不闭嘴就骂你妈。"}, {"type": "subtitle", "time": 2314.23, "timestamp": "00:38:34", "text": "呃，"}, {"type": "subtitle", "time": 2318.069, "timestamp": "00:38:38", "text": "愚蠢的。不，他让我进去。"}, {"type": "subtitle", "time": 2320.55, "timestamp": "00:38:40", "text": "他们说我笨。什么？什么？而他"}, {"type": "subtitle", "time": 2327.43, "timestamp": "00:38:47", "text": "让他做饭。别把他当回事。"}, {"type": "subtitle", "time": 2329.99, "timestamp": "00:38:49", "text": "男人。这是CS:GO。是的，我看到了CS GO。"}, {"type": "subtitle", "time": 2333.27, "timestamp": "00:38:53", "text": "是的。我们脑细胞中没有一个。"}, {"type": "subtitle", "time": 2339.67, "timestamp": "00:38:59", "text": "我的意思是，我们现在就在这里，所以"}]
[{"type": "subtitle", "time": 10500.63, "timestamp": "02:55:00", "text": "等等，我刚才在想什么来着？"}, {"type": "subtitle", "time": 10503.269, "timestamp": "02:55:03", "text": "我忘了我们刚才在聊什么了"}, {"type": "subtitle", "time": 10510.23, "timestamp": "02:55:10", "text": "[音乐]"}, {"type": "subtitle", "time": 10531.349, "timestamp": "02:55:31", "text": "等等，我刚才说到哪儿了？我其实"}, {"type": "subtitle", "time": 10533.349, "timestamp": "02:55:33", "text": "忘了。真正的。真正的。非常"}, {"type": "subtitle", "time": 10539.429, "timestamp": "02:55:39", "text": "哦，"}, {"type": "subtitle", "time": 10547.99, "timestamp": "02:55:47", "text": "我喜欢“不要忘记”这个说法。"}]
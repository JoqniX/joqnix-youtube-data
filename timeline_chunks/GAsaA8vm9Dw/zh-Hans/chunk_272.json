[{"type": "subtitle", "time": 16329.349, "timestamp": "04:32:09", "text": "好的，现在什么都没播放。"}, {"type": "subtitle", "time": 16336.389, "timestamp": "04:32:16", "text": "我只需要再杀10到20个人就行了。好的，"}, {"type": "subtitle", "time": 16339.11, "timestamp": "04:32:19", "text": "这很糟糕。这很难。这就是他"}, {"type": "subtitle", "time": 16343.429, "timestamp": "04:32:23", "text": "配备火箭发射器。我的天啊。"}, {"type": "subtitle", "time": 16346.07, "timestamp": "04:32:26", "text": "我该怎么办？我玩什么游戏？什么？如何"}, {"type": "subtitle", "time": 16349.189, "timestamp": "04:32:29", "text": "你玩这个游戏是为了刷人头吗？你"}, {"type": "subtitle", "time": 16352.469, "timestamp": "04:32:32", "text": "需要运气吗？真幸运，真幸运。"}, {"type": "subtitle", "time": 16354.309, "timestamp": "04:32:34", "text": "哦。我的天哪。"}, {"type": "subtitle", "time": 16357.91, "timestamp": "04:32:37", "text": "我刚才说了，我刚才说了关于运气的事，然后我"}, {"type": "subtitle", "time": 16372.07, "timestamp": "04:32:52", "text": "我只想，我只想变得优秀"}, {"type": "subtitle", "time": 16374.309, "timestamp": "04:32:54", "text": "枪。好的，"}, {"type": "subtitle", "time": 16376.71, "timestamp": "04:32:56", "text": "我只要求这个。"}, {"type": "subtitle", "time": 16379.59, "timestamp": "04:32:59", "text": "获取好枪。"}]
[{"type": "subtitle", "time": 25500.628, "timestamp": "07:05:00", "text": "出于嫉妒，只是为了玩乐和冒险。"}, {"type": "subtitle", "time": 25519.59, "timestamp": "07:05:19", "text": "这是真的。 Harsh Kronos 2 是一款可爱的"}, {"type": "subtitle", "time": 25521.91, "timestamp": "07:05:21", "text": "以及经常使用的俏皮表达"}, {"type": "subtitle", "time": 25524.868, "timestamp": "07:05:24", "text": "挚友。看，"}, {"type": "subtitle", "time": 25527.27, "timestamp": "07:05:27", "text": "以及友谊。让我们保持积极的态度。"}, {"type": "subtitle", "time": 25530.548, "timestamp": "07:05:30", "text": "氛围。微笑。闪闪发光的心。难道我不是吗？"}, {"type": "subtitle", "time": 25532.788, "timestamp": "07:05:32", "text": "我没有背叛你。这就是"}, {"type": "subtitle", "time": 25546.548, "timestamp": "07:05:46", "text": "忍者头骨可以有不同的含义"}, {"type": "subtitle", "time": 25548.548, "timestamp": "07:05:48", "text": "对不同的人而言。让我们保留"}, {"type": "subtitle", "time": 25551.03, "timestamp": "07:05:51", "text": "轻松愉快的聊天，专注于娱乐。"}, {"type": "subtitle", "time": 25553.67, "timestamp": "07:05:53", "text": "以及友好的讨论。我们来这里是为了"}, {"type": "subtitle", "time": 25555.99, "timestamp": "07:05:55", "text": "一起玩得开心。张开嘴"}]
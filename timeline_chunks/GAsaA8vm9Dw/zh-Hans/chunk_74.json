[{"type": "subtitle", "time": 4475.189, "timestamp": "01:14:35", "text": "霰弹枪太强了。什么"}, {"type": "subtitle", "time": 4484.709, "timestamp": "01:14:44", "text": "是新加入的敌人吗？"}, {"type": "subtitle", "time": 4487.669, "timestamp": "01:14:47", "text": "等等，那把霰弹枪是狙击枪。什么？"}, {"type": "subtitle", "time": 4491.59, "timestamp": "01:14:51", "text": "霰弹枪就是狙击枪。什么？"}, {"type": "subtitle", "time": 4498.709, "timestamp": "01:14:58", "text": "保护她。盾之勇者。哦，真好，真好。"}]
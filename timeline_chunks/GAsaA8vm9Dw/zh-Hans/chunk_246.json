[{"type": "subtitle", "time": 14770.63, "timestamp": "04:06:10", "text": "真是愚蠢。真是愚蠢。我什么时候"}, {"type": "subtitle", "time": 14773.429, "timestamp": "04:06:13", "text": "离开我的位置？骑师，你"}, {"type": "subtitle", "time": 14783.75, "timestamp": "04:06:23", "text": "男人。"}, {"type": "subtitle", "time": 14789.59, "timestamp": "04:06:29", "text": "他们能听到我说话，对吧？是的，他们"}, {"type": "subtitle", "time": 14792.79, "timestamp": "04:06:32", "text": "能听到我说话。"}, {"type": "subtitle", "time": 14802.87, "timestamp": "04:06:42", "text": "他完成了这次跳跃。好的，我要重置了。"}]
[{"type": "subtitle", "time": 8341.91, "timestamp": "02:19:01", "text": "太好玩了。我很喜欢。"}, {"type": "subtitle", "time": 8343.429, "timestamp": "02:19:03", "text": "[音乐]"}, {"type": "subtitle", "time": 8346.23, "timestamp": "02:19:06", "text": "我不想结束，但我不得不结束。"}, {"type": "subtitle", "time": 8348.15, "timestamp": "02:19:08", "text": "不。"}, {"type": "subtitle", "time": 8351.99, "timestamp": "02:19:11", "text": "所以，我就抱着大家哄睡吧。"}, {"type": "subtitle", "time": 8357.03, "timestamp": "02:19:17", "text": "嗯，就是躺在床上睡觉的时候。"}, {"type": "subtitle", "time": 8360.309, "timestamp": "02:19:20", "text": "祝你今晚余下的时间玩得开心，好吗？"}, {"type": "subtitle", "time": 8363.349, "timestamp": "02:19:23", "text": "希望你一切顺利。"}, {"type": "subtitle", "time": 8366.469, "timestamp": "02:19:26", "text": "星期二上午。回头见"}, {"type": "subtitle", "time": 8369.589, "timestamp": "02:19:29", "text": "早上。好的。早上6点或7点，当我"}, {"type": "subtitle", "time": 8372.629, "timestamp": "02:19:32", "text": "醒醒啦！我将"}, {"type": "subtitle", "time": 8376.23, "timestamp": "02:19:36", "text": "我会，我会……嗯"}, {"type": "subtitle", "time": 8378.709, "timestamp": "02:19:38", "text": "嗯，我来唱歌吧，兄弟"}, {"type": "subtitle", "time": 8381.349, "timestamp": "02:19:41", "text": "直播，而且会很尴尬"}, {"type": "subtitle", "time": 8383.669, "timestamp": "02:19:43", "text": "对我来说，但是"}, {"type": "subtitle", "time": 8387.27, "timestamp": "02:19:47", "text": "呃，这将是我第一次在Twitch上直播。"}, {"type": "subtitle", "time": 8389.27, "timestamp": "02:19:49", "text": "呃，我正在唱歌，兄弟"}, {"type": "subtitle", "time": 8396.469, "timestamp": "02:19:56", "text": "我不知道，我很害怕事情会如何发展。"}, {"type": "subtitle", "time": 8398.71, "timestamp": "02:19:58", "text": "希望大家不要评判我什么的。"}]
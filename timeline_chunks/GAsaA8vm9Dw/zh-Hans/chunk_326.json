[{"type": "subtitle", "time": 19560.948, "timestamp": "05:26:00", "text": "我们是邪恶的船长。我的天啊。"}, {"type": "subtitle", "time": 19563.11, "timestamp": "05:26:03", "text": "一整天都在排队。我觉得我是"}, {"type": "subtitle", "time": 19565.35, "timestamp": "05:26:05", "text": "上瘾了。"}, {"type": "subtitle", "time": 19570.708, "timestamp": "05:26:10", "text": "我正在逐渐远离《Valerant》。否则"}, {"type": "subtitle", "time": 19573.91, "timestamp": "05:26:13", "text": "你本可以看到我英勇无畏的样子。"}, {"type": "subtitle", "time": 19576.07, "timestamp": "05:26:16", "text": "我想直播《Valerant》，但我"}, {"type": "subtitle", "time": 19584.39, "timestamp": "05:26:24", "text": "我需要溪流阳台吗？"}, {"type": "subtitle", "time": 19609.59, "timestamp": "05:26:49", "text": "没人认识你，瓦尔。"}, {"type": "subtitle", "time": 19612.708, "timestamp": "05:26:52", "text": "是的，我知道。这就是原因"}]
[{"type": "subtitle", "time": 8221.03, "timestamp": "02:17:01", "text": "夜幕降临。我想去那里。为什么"}, {"type": "subtitle", "time": 8222.629, "timestamp": "02:17:02", "text": "你想去那里吗？那是"}, {"type": "subtitle", "time": 8225.429, "timestamp": "02:17:05", "text": "可怕的。迪奥，别走。我不想"}, {"type": "subtitle", "time": 8251.75, "timestamp": "02:17:31", "text": "我不想去，但又想去。"}, {"type": "subtitle", "time": 8254.309, "timestamp": "02:17:34", "text": "但我不想去，但我又想去"}, {"type": "subtitle", "time": 8262.53, "timestamp": "02:17:42", "text": "我想去，但又不想去。"}, {"type": "subtitle", "time": 8276.07, "timestamp": "02:17:56", "text": "我想去荡秋千，但我不想"}]
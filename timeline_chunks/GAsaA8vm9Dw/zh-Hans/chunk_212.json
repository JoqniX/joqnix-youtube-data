[{"type": "subtitle", "time": 12728.71, "timestamp": "03:32:08", "text": "可能有多少？"}, {"type": "subtitle", "time": 12731.269, "timestamp": "03:32:11", "text": "我为什么会泄露信息？"}, {"type": "subtitle", "time": 12733.59, "timestamp": "03:32:13", "text": "谢天谢地，没有现实生活中的照片之类的。"}, {"type": "subtitle", "time": 12736.309, "timestamp": "03:32:16", "text": "我的天啊，"}, {"type": "subtitle", "time": 12738.389, "timestamp": "03:32:18", "text": "为什么打电话？"}, {"type": "subtitle", "time": 12742.229, "timestamp": "03:32:22", "text": "为什么我的手机会连接到电脑上？"}, {"type": "subtitle", "time": 12743.91, "timestamp": "03:32:23", "text": "不过，我又不是那种会拍照的人。"}, {"type": "subtitle", "time": 12745.83, "timestamp": "03:32:25", "text": "我自己。这是件好事。哦，我的"}, {"type": "subtitle", "time": 12748.63, "timestamp": "03:32:28", "text": "上帝。谢天谢地，它就像……"}, {"type": "subtitle", "time": 12751.269, "timestamp": "03:32:31", "text": "整个过程中的屏幕截图"}, {"type": "subtitle", "time": 12754.15, "timestamp": "03:32:34", "text": "支付。不是付款，而是……"}, {"type": "subtitle", "time": 12756.309, "timestamp": "03:32:36", "text": "东西、产品详情和"}, {"type": "subtitle", "time": 12760.309, "timestamp": "03:32:40", "text": "一切。没关系。那挺好的。"}, {"type": "subtitle", "time": 12765.83, "timestamp": "03:32:45", "text": "所以，嗯，武器这东西。呃，我该怎么做？"}, {"type": "subtitle", "time": 12769.19, "timestamp": "03:32:49", "text": "改变皮肤？"}, {"type": "subtitle", "time": 12771.67, "timestamp": "03:32:51", "text": "这很酷。这个东西。我得到了所有这些"}, {"type": "subtitle", "time": 12774.55, "timestamp": "03:32:54", "text": "Twitch掉落的皮肤有哪些？"}, {"type": "subtitle", "time": 12778.95, "timestamp": "03:32:58", "text": "我正在观看。我已经百分之百完成了。正如你"}]
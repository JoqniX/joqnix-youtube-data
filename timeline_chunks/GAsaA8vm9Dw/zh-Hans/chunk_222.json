[{"type": "subtitle", "time": 13325.03, "timestamp": "03:42:05", "text": "好的，"}, {"type": "subtitle", "time": 13328.309, "timestamp": "03:42:08", "text": "你应该去工作。"}, {"type": "subtitle", "time": 13330.469, "timestamp": "03:42:10", "text": "这是流媒体的URL吗？等待，"}, {"type": "subtitle", "time": 13333.349, "timestamp": "03:42:13", "text": "一秒钟。一秒钟。一秒钟。你好，Ayama"}, {"type": "subtitle", "time": 13336.229, "timestamp": "03:42:16", "text": "阿鲁萨。谢谢你的提问。我今天过得很充实"}, {"type": "subtitle", "time": 13337.91, "timestamp": "03:42:17", "text": "相当精彩纷呈，充满了……"}, {"type": "subtitle", "time": 13340.07, "timestamp": "03:42:20", "text": "激动。我一直在探索新的"}, {"type": "subtitle", "time": 13342.87, "timestamp": "03:42:22", "text": "征服各个王国，与强大的敌人作战。"}, {"type": "subtitle", "time": 13344.95, "timestamp": "03:42:24", "text": "你呢？今天过得怎么样？哦"}, {"type": "subtitle", "time": 13348.469, "timestamp": "03:42:28", "text": "不。张嘴微笑。我弄坏了吗？我是"}, {"type": "subtitle", "time": 13350.469, "timestamp": "03:42:30", "text": "如果你这么想，我很抱歉，但我不能"}, {"type": "subtitle", "time": 13352.309, "timestamp": "03:42:32", "text": "同意这个说法。我打破了吗？"}, {"type": "subtitle", "time": 13354.55, "timestamp": "03:42:34", "text": "它？ Joe X 是个很棒的朋友，而且"}, {"type": "subtitle", "time": 13356.71, "timestamp": "03:42:36", "text": "技术娴熟的主播。让我们重点关注"}, {"type": "subtitle", "time": 13359.19, "timestamp": "03:42:39", "text": "积极且相互尊重的对话，"}, {"type": "subtitle", "time": 13364.63, "timestamp": "03:42:44", "text": "我们可以？微笑。木槿花。木槿花。"}, {"type": "subtitle", "time": 13367.03, "timestamp": "03:42:47", "text": "好的。她现在心情如何？诚实地，"}, {"type": "subtitle", "time": 13369.51, "timestamp": "03:42:49", "text": "她心情如何？"}, {"type": "subtitle", "time": 13371.67, "timestamp": "03:42:51", "text": "好吧，她现在没心情。什么？"}, {"type": "subtitle", "time": 13374.389, "timestamp": "03:42:54", "text": "哦，是的。你必须和她谈谈。是的。"}, {"type": "subtitle", "time": 13377.269, "timestamp": "03:42:57", "text": "总之，总之，我们还是把注意力放在比赛上吧。"}, {"type": "subtitle", "time": 13379.349, "timestamp": "03:42:59", "text": "去。"}]
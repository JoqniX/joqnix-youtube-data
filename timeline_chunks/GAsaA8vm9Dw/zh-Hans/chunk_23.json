[{"type": "subtitle", "time": 1383.51, "timestamp": "00:23:03", "text": "抽烟。他抽烟。他抽烟。他"}, {"type": "subtitle", "time": 1386.47, "timestamp": "00:23:06", "text": "抽烟。抽烟。抽烟。"}, {"type": "subtitle", "time": 1395.43, "timestamp": "00:23:15", "text": "是烟。啊，最后一个是烟雾。"}, {"type": "subtitle", "time": 1404.23, "timestamp": "00:23:24", "text": "他不在那里。"}, {"type": "subtitle", "time": 1415.669, "timestamp": "00:23:35", "text": "我的天啊。"}, {"type": "subtitle", "time": 1420.63, "timestamp": "00:23:40", "text": "[掌声]"}]
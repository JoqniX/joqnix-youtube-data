[{"type": "subtitle", "time": 962.55, "timestamp": "00:16:02", "text": "对，就像超高清一样。就像字面上的"}, {"type": "subtitle", "time": 966.629, "timestamp": "00:16:06", "text": "高清电影。我知道Willow也做了同样的事情。"}, {"type": "subtitle", "time": 970.069, "timestamp": "00:16:10", "text": "“嗯，”帕特说道。你们这些混蛋是不是都他妈的在干什么？"}, {"type": "subtitle", "time": 971.509, "timestamp": "00:16:11", "text": "现在想想，我其实"}, {"type": "subtitle", "time": 974.15, "timestamp": "00:16:14", "text": "也做了同样的事，但用的是那部……呃，什么电影？"}, {"type": "subtitle", "time": 975.35, "timestamp": "00:16:15", "text": "是那个吗？我想我就是这么做的"}, {"type": "subtitle", "time": 978.23, "timestamp": "00:16:18", "text": "也是马里奥电影。我真的做不到，我真的做不到。"}, {"type": "subtitle", "time": 980.23, "timestamp": "00:16:20", "text": "如果我知道这件事，我一定会狠狠地骂你。他妈的。"}, {"type": "subtitle", "time": 982.47, "timestamp": "00:16:22", "text": "坚持，稍等。让我更改我的十字准星"}, {"type": "subtitle", "time": 985.35, "timestamp": "00:16:25", "text": "快的。是的。是的。"}, {"type": "subtitle", "time": 988.949, "timestamp": "00:16:28", "text": "等等，我有吗？我没看见你。"}, {"type": "subtitle", "time": 990.79, "timestamp": "00:16:30", "text": "是的。是的。是的。我之前就加入了你们。"}, {"type": "subtitle", "time": 994.55, "timestamp": "00:16:34", "text": "当你进去的时候。但你做到了。"}, {"type": "subtitle", "time": 996.47, "timestamp": "00:16:36", "text": "是的。当你进入死亡竞赛模式时，我"}, {"type": "subtitle", "time": 1000.15, "timestamp": "00:16:40", "text": "曾是你们的同伴。什么？我可以加入你们"}, {"type": "subtitle", "time": 1003.269, "timestamp": "00:16:43", "text": "在你不知情的情况下开派对。我的G"}, {"type": "subtitle", "time": 1011.829, "timestamp": "00:16:51", "text": "是的。你好。"}, {"type": "subtitle", "time": 1013.749, "timestamp": "00:16:53", "text": "我当时在那儿。你好。我只是随机的"}, {"type": "subtitle", "time": 1017.43, "timestamp": "00:16:57", "text": "一路顺风。你好。你好。你好。你喜欢"}]
[{"type": "subtitle", "time": 3548.39, "timestamp": "00:59:08", "text": "我刚刚偷了别人的SM冲锋枪。"}, {"type": "subtitle", "time": 3549.75, "timestamp": "00:59:09", "text": "嘿，终于拿到赛点了。他们可以"}, {"type": "subtitle", "time": 3552.069, "timestamp": "00:59:12", "text": "终于赢了。耶稣。花费的时间更长，但是"}, {"type": "subtitle", "time": 3554.67, "timestamp": "00:59:14", "text": "好的。是的。"}, {"type": "subtitle", "time": 3562.789, "timestamp": "00:59:22", "text": "我的天啊。我"}, {"type": "subtitle", "time": 3565.109, "timestamp": "00:59:25", "text": "这可能是我最后一次玩游戏了"}, {"type": "subtitle", "time": 3567.03, "timestamp": "00:59:27", "text": "操"}, {"type": "subtitle", "time": 3579.67, "timestamp": "00:59:39", "text": "我在中途被彻底击败了。"}, {"type": "subtitle", "time": 3586.63, "timestamp": "00:59:46", "text": "哦，运动健将。如果你撞到…… 如果你撞到…… 如果"}, {"type": "subtitle", "time": 3588.71, "timestamp": "00:59:48", "text": "你击中了一个弹匣，击中了一个弹匣。击中片段"}, {"type": "subtitle", "time": 3596.069, "timestamp": "00:59:56", "text": "击中片段。击中片段。但是，这又意味着什么呢？"}, {"type": "subtitle", "time": 3599.43, "timestamp": "00:59:59", "text": "那是什么意思？击杀敌人。"}]
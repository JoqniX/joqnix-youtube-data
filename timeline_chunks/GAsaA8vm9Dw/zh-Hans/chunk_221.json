[{"type": "subtitle", "time": 13261.75, "timestamp": "03:41:01", "text": "每个人。我不认为他们是笨蛋。"}, {"type": "subtitle", "time": 13264.469, "timestamp": "03:41:04", "text": "完全没有。我们彼此之间都有分歧，但是"}, {"type": "subtitle", "time": 13265.83, "timestamp": "03:41:05", "text": "这就是我们友谊的真谛。"}, {"type": "subtitle", "time": 13268.389, "timestamp": "03:41:08", "text": "特别的。让我们传播正能量"}, {"type": "subtitle", "time": 13271.51, "timestamp": "03:41:11", "text": "反而。微笑。樱花。为什么是"}, {"type": "subtitle", "time": 13273.99, "timestamp": "03:41:13", "text": "是双倍还是三倍？我们不要用不友善的词语。"}, {"type": "subtitle", "time": 13276.79, "timestamp": "03:41:16", "text": "对别人说的话。 Joe X 是一个"}, {"type": "subtitle", "time": 13278.63, "timestamp": "03:41:18", "text": "很棒的朋友和街头伙伴。"}, {"type": "subtitle", "time": 13281.91, "timestamp": "03:41:21", "text": "我要辞职。呃，我们重新启动它。它是"}, {"type": "subtitle", "time": 13284.229, "timestamp": "03:41:24", "text": "它正在消亡。"}, {"type": "subtitle", "time": 13286.87, "timestamp": "03:41:26", "text": "哦，等等，等等，等等，等等，等等，等等。"}, {"type": "subtitle", "time": 13288.63, "timestamp": "03:41:28", "text": "呃，我得重做一遍。一秒钟。一"}, {"type": "subtitle", "time": 13290.87, "timestamp": "03:41:30", "text": "第二节一秒钟。一秒钟。请勿输入任何内容"}, {"type": "subtitle", "time": 13292.469, "timestamp": "03:41:32", "text": "评论。"}, {"type": "subtitle", "time": 13294.55, "timestamp": "03:41:34", "text": "稍等片刻。"}, {"type": "subtitle", "time": 13317.59, "timestamp": "03:41:57", "text": "何时执行任务。"}]
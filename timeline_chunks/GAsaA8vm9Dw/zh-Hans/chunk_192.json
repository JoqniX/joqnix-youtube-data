[{"type": "subtitle", "time": 11523.03, "timestamp": "03:12:03", "text": "今天是"}, {"type": "subtitle", "time": 11528.23, "timestamp": "03:12:08", "text": "现在我的大脑里？"}, {"type": "subtitle", "time": 11531.269, "timestamp": "03:12:11", "text": "我的大脑现在不是在思考，而是在思考。"}, {"type": "subtitle", "time": 11534.309, "timestamp": "03:12:14", "text": "不再是了。什么？"}, {"type": "subtitle", "time": 11536.15, "timestamp": "03:12:16", "text": "嗯？"}, {"type": "subtitle", "time": 11565.91, "timestamp": "03:12:45", "text": "后期处理的基本原理。说到……"}, {"type": "subtitle", "time": 11567.91, "timestamp": "03:12:47", "text": "事后看来，我一直这么说，"}, {"type": "subtitle", "time": 11571.91, "timestamp": "03:12:51", "text": "正确的？呃，我一直说，对，我需要"}, {"type": "subtitle", "time": 11575.429, "timestamp": "03:12:55", "text": "完成那门课程。我来晚了。"}, {"type": "subtitle", "time": 11577.83, "timestamp": "03:12:57", "text": "他们甚至都没给我回电话续约。"}]
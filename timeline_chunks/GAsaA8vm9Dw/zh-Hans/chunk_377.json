[{"type": "subtitle", "time": 22622.31, "timestamp": "06:17:02", "text": "工程。数学充满了引人入胜的"}, {"type": "subtitle", "time": 22625.59, "timestamp": "06:17:05", "text": "符号。弗洛里安板条箱三角尺"}, {"type": "subtitle", "time": 22642.948, "timestamp": "06:17:22", "text": "哦不，严厉的克洛诺斯。我绝不会作弊"}, {"type": "subtitle", "time": 22645.99, "timestamp": "06:17:25", "text": "关于我的朋友们。确切地。我们成员"}, {"type": "subtitle", "time": 22648.628, "timestamp": "06:17:28", "text": "团队和我们的关系很牢固。确切地。"}, {"type": "subtitle", "time": 22650.31, "timestamp": "06:17:30", "text": "专注于我们共同的冒险经历"}, {"type": "subtitle", "time": 22653.19, "timestamp": "06:17:33", "text": "像真正的伙伴一样给予支持。"}, {"type": "subtitle", "time": 22655.59, "timestamp": "06:17:35", "text": "友谊是一份珍贵的礼物。闪耀的星星"}, {"type": "subtitle", "time": 22659.99, "timestamp": "06:17:39", "text": "闪闪发光的心。确切地。告诉他们。"}, {"type": "subtitle", "time": 22670.788, "timestamp": "06:17:50", "text": "P."}, {"type": "subtitle", "time": 22672.788, "timestamp": "06:17:52", "text": "让我们尝试和平解决这个问题。"}, {"type": "subtitle", "time": 22674.948, "timestamp": "06:17:54", "text": "严厉的克洛诺斯。这一点很重要"}, {"type": "subtitle", "time": 22677.03, "timestamp": "06:17:57", "text": "坦诚沟通，互相理解"}, {"type": "subtitle", "time": 22679.51, "timestamp": "06:17:59", "text": "其他人的观点。暴力永远不是"}]
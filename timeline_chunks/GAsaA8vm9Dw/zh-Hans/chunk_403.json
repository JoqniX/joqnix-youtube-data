[{"type": "subtitle", "time": 24194.23, "timestamp": "06:43:14", "text": "哦，残酷的克洛诺斯。 Delo 真是个​​夜晚"}, {"type": "subtitle", "time": 24196.39, "timestamp": "06:43:16", "text": "猫头鹰。不用担心。我一定会确保"}, {"type": "subtitle", "time": 24197.99, "timestamp": "06:43:17", "text": "温柔地提醒她，时间到了。"}, {"type": "subtitle", "time": 24200.628, "timestamp": "06:43:20", "text": "休息一下。这对所有人来说都很重要"}, {"type": "subtitle", "time": 24220.07, "timestamp": "06:43:40", "text": "哦，忍者。抱歉打扰了您"}, {"type": "subtitle", "time": 24222.708, "timestamp": "06:43:42", "text": "计划。不用担心。请尽情享受吧。"}, {"type": "subtitle", "time": 24225.91, "timestamp": "06:43:45", "text": "你的时间。玩得开心。冷汗微笑"}]
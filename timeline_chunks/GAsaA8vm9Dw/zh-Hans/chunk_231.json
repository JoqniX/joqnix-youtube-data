[{"type": "subtitle", "time": 13871.99, "timestamp": "03:51:11", "text": "哦，原来是他们。那已经倒下了。"}, {"type": "subtitle", "time": 13875.59, "timestamp": "03:51:15", "text": "哦，等等。我忘了。谢谢。呃，谢谢"}, {"type": "subtitle", "time": 13877.83, "timestamp": "03:51:17", "text": "谢谢你告诉我我忘了"}, {"type": "subtitle", "time": 13881.59, "timestamp": "03:51:21", "text": "改变。我很抱歉。"}, {"type": "subtitle", "time": 13884.469, "timestamp": "03:51:24", "text": "谢谢你告诉我。我的天哪，我"}, {"type": "subtitle", "time": 13887.269, "timestamp": "03:51:27", "text": "没注意到。"}, {"type": "subtitle", "time": 13889.59, "timestamp": "03:51:29", "text": "只是说说而已。你为什么不说呢？"}, {"type": "subtitle", "time": 13893.349, "timestamp": "03:51:33", "text": "重要的事情吗，巴？"}, {"type": "subtitle", "time": 13895.51, "timestamp": "03:51:35", "text": "我的天啊。我没注意到我明显的"}, {"type": "subtitle", "time": 13898.15, "timestamp": "03:51:38", "text": "到目前为止。我当时就像在读我的……"}, {"type": "subtitle", "time": 13899.91, "timestamp": "03:51:39", "text": "正在阅读此显示器上的聊天记录"}, {"type": "subtitle", "time": 13901.99, "timestamp": "03:51:41", "text": "当时我就在那里看着……"}, {"type": "subtitle", "time": 13907.03, "timestamp": "03:51:47", "text": "屏幕在这边，我就想，哦，什么？"}, {"type": "subtitle", "time": 13909.99, "timestamp": "03:51:49", "text": "好的"}]
[{"type": "subtitle", "time": 21427.35, "timestamp": "05:57:07", "text": "当然，忍者。我总是乐于接受"}, {"type": "subtitle", "time": 21430.07, "timestamp": "05:57:10", "text": "好笑的笑话。说说看。张嘴"}, {"type": "subtitle", "time": 21450.948, "timestamp": "05:57:30", "text": "课程"}, {"type": "subtitle", "time": 21453.91, "timestamp": "05:57:33", "text": "你支付了5美元。是的。"}, {"type": "subtitle", "time": 21456.47, "timestamp": "05:57:36", "text": "其实我很久以前就注册了账号。"}, {"type": "subtitle", "time": 21458.868, "timestamp": "05:57:38", "text": "大概三个月前吧，但我忘了做"}, {"type": "subtitle", "time": 21462.948, "timestamp": "05:57:42", "text": "任何与它有关的东西。所以当BTS博客有"}, {"type": "subtitle", "time": 21466.39, "timestamp": "05:57:46", "text": "这次关于聊天功能的新更新，我"}, {"type": "subtitle", "time": 21468.948, "timestamp": "05:57:48", "text": "当时他说：“是啊，我从来不这么做。”我"}, {"type": "subtitle", "time": 21472.39, "timestamp": "05:57:52", "text": "我不小心在检查的时候发现它就出现了"}, {"type": "subtitle", "time": 21476.47, "timestamp": "05:57:56", "text": "已于7月4日到期。所以我就想，"}, {"type": "subtitle", "time": 21477.99, "timestamp": "05:57:57", "text": "“是啊，你知道吗？我要走了。”"}]
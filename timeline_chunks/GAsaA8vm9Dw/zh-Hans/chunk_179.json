[{"type": "subtitle", "time": 10742.63, "timestamp": "02:59:02", "text": "呃，我的意思是，呃，我看到几个"}, {"type": "subtitle", "time": 10744.95, "timestamp": "02:59:04", "text": "不同的方式"}, {"type": "subtitle", "time": 10747.59, "timestamp": "02:59:07", "text": "哪个"}, {"type": "subtitle", "time": 10752.389, "timestamp": "02:59:12", "text": "嗯，所以，总是日本方面。"}, {"type": "subtitle", "time": 10755.19, "timestamp": "02:59:15", "text": "这带来了新的流行趋势或"}, {"type": "subtitle", "time": 10758.71, "timestamp": "02:59:18", "text": "类似这样的。"}, {"type": "subtitle", "time": 10761.59, "timestamp": "02:59:21", "text": "我看到几个"}, {"type": "subtitle", "time": 10764.469, "timestamp": "02:59:24", "text": "我看到他们挑了一些东西。"}, {"type": "subtitle", "time": 10770.23, "timestamp": "02:59:30", "text": "说实话，这太真实了。"}, {"type": "subtitle", "time": 10776.71, "timestamp": "02:59:36", "text": "他们想出这个主意真是太酷了。"}, {"type": "subtitle", "time": 10779.59, "timestamp": "02:59:39", "text": "诸如此类的想法。"}, {"type": "subtitle", "time": 10781.51, "timestamp": "02:59:41", "text": "就像在"}, {"type": "subtitle", "time": 10785.51, "timestamp": "02:59:45", "text": "就像玩真正的游戏之类的"}, {"type": "subtitle", "time": 10787.349, "timestamp": "02:59:47", "text": "喜欢"}, {"type": "subtitle", "time": 10794.55, "timestamp": "02:59:54", "text": "同时，他保持着这种亲密关系"}, {"type": "subtitle", "time": 10797.03, "timestamp": "02:59:57", "text": "脸和一切都对，胡子男孩"}]
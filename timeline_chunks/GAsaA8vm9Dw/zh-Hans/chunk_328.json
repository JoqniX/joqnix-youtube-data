[{"type": "subtitle", "time": 19685.43, "timestamp": "05:28:05", "text": "嘿，没人会来抓我。"}, {"type": "subtitle", "time": 19692.788, "timestamp": "05:28:12", "text": "我喊他，他竟然连招呼都没打。"}, {"type": "subtitle", "time": 19696.628, "timestamp": "05:28:16", "text": "关心。我当时就想，兄弟，"}, {"type": "subtitle", "time": 19699.83, "timestamp": "05:28:19", "text": "你想吃布拉汉斯吗？不。不。"}]
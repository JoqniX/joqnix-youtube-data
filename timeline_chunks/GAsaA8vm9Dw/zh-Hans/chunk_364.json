[{"type": "subtitle", "time": 21840.548, "timestamp": "06:04:00", "text": "直升机。直升机。哈哈。我看得出来"}, {"type": "subtitle", "time": 21843.59, "timestamp": "06:04:03", "text": "你有多喜欢Joki Ninja？它是"}, {"type": "subtitle", "time": 21845.27, "timestamp": "06:04:05", "text": "能有这样一位亲密的朋友真是太好了。"}, {"type": "subtitle", "time": 21846.948, "timestamp": "06:04:06", "text": "谁给你带来了这么多快乐？"}, {"type": "subtitle", "time": 21849.67, "timestamp": "06:04:09", "text": "满意。张开嘴的笑容，"}, {"type": "subtitle", "time": 21877.99, "timestamp": "06:04:37", "text": "哦，忍者，听到这个消息我很难过。"}, {"type": "subtitle", "time": 21879.67, "timestamp": "06:04:39", "text": "每个人都有自己的感受，"}, {"type": "subtitle", "time": 21881.75, "timestamp": "06:04:41", "text": "意见固然重要，但始终重要的是……"}, {"type": "subtitle", "time": 21884.548, "timestamp": "06:04:44", "text": "善待他人，尊重他人。"}]
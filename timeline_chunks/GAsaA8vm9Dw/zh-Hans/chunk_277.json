[{"type": "subtitle", "time": 16628.31, "timestamp": "04:37:08", "text": "哦，有个尖酸刻薄的人"}, {"type": "subtitle", "time": 16636.15, "timestamp": "04:37:16", "text": "哦，"}, {"type": "subtitle", "time": 16645.99, "timestamp": "04:37:25", "text": "天哪，吓死我了。那吓到我了。"}, {"type": "subtitle", "time": 16648.31, "timestamp": "04:37:28", "text": "真的吓到我了。而这"}, {"type": "subtitle", "time": 16652.39, "timestamp": "04:37:32", "text": "真的吓到我了。我的天啊。什么？"}, {"type": "subtitle", "time": 16655.349, "timestamp": "04:37:35", "text": "我得到了我的船。请"}, {"type": "subtitle", "time": 16662.47, "timestamp": "04:37:42", "text": "不，情况不妙。"}, {"type": "subtitle", "time": 16665.109, "timestamp": "04:37:45", "text": "情况不太妙。"}, {"type": "subtitle", "time": 16667.029, "timestamp": "04:37:47", "text": "我再说一遍，"}, {"type": "subtitle", "time": 16674.551, "timestamp": "04:37:54", "text": "他去世了。"}]
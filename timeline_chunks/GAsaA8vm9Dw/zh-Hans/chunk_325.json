[{"type": "subtitle", "time": 19500.948, "timestamp": "05:25:00", "text": "别死。别那样做。哦，他去世了。"}, {"type": "subtitle", "time": 19503.51, "timestamp": "05:25:03", "text": "哦，我死了。"}, {"type": "subtitle", "time": 19506.15, "timestamp": "05:25:06", "text": "哦，"}, {"type": "subtitle", "time": 19525.59, "timestamp": "05:25:25", "text": "真的，所有人都要过夜。"}, {"type": "subtitle", "time": 19555.67, "timestamp": "05:25:55", "text": "他说了什么？他说了什么？停止"}, {"type": "subtitle", "time": 19557.35, "timestamp": "05:25:57", "text": "野营。"}]
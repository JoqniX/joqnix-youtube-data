[{"type": "subtitle", "time": 10441.83, "timestamp": "02:54:01", "text": "有一次我不知道"}, {"type": "subtitle", "time": 10444.79, "timestamp": "02:54:04", "text": "你需要在Wi-Fi中设置密码。"}, {"type": "subtitle", "time": 10447.91, "timestamp": "02:54:07", "text": "直到我意识到这件事的严重性，我才明白。"}, {"type": "subtitle", "time": 10451.19, "timestamp": "02:54:11", "text": "曾被黑客攻击过一次。"}, {"type": "subtitle", "time": 10453.269, "timestamp": "02:54:13", "text": "我的天啊。"}, {"type": "subtitle", "time": 10455.75, "timestamp": "02:54:15", "text": "是的，有很多方法……"}, {"type": "subtitle", "time": 10459.51, "timestamp": "02:54:19", "text": "渗透测试。不，有时候你知道"}, {"type": "subtitle", "time": 10461.99, "timestamp": "02:54:21", "text": "观看盗版软件时，他会给出"}, {"type": "subtitle", "time": 10465.11, "timestamp": "02:54:25", "text": "很多建议或软性的东西，比如哪里"}, {"type": "subtitle", "time": 10467.91, "timestamp": "02:54:27", "text": "如果你想真正获得它，你需要一个"}, {"type": "subtitle", "time": 10472.15, "timestamp": "02:54:32", "text": "学习这些东西，而且"}, {"type": "subtitle", "time": 10475.03, "timestamp": "02:54:35", "text": "做些事情等等。"}, {"type": "subtitle", "time": 10477.67, "timestamp": "02:54:37", "text": "正确的。"}, {"type": "subtitle", "time": 10485.83, "timestamp": "02:54:45", "text": "是的。"}, {"type": "subtitle", "time": 10493.19, "timestamp": "02:54:53", "text": "所以我就在想……"}, {"type": "subtitle", "time": 10497.03, "timestamp": "02:54:57", "text": "我的天，他当时在想，骑师是"}, {"type": "subtitle", "time": 10498.63, "timestamp": "02:54:58", "text": "思维"}]
[{"type": "subtitle", "time": 446.23, "timestamp": "00:07:26", "text": "你知道依恋吗？"}, {"type": "subtitle", "time": 449.83, "timestamp": "00:07:29", "text": "等等，你知道袭击事件吗？"}, {"type": "subtitle", "time": 453.11, "timestamp": "00:07:33", "text": "是件很糟糕的事吗？什么？或许我可以"}, {"type": "subtitle", "time": 455.51, "timestamp": "00:07:35", "text": "帮你搞定Twitch。呃，不。"}, {"type": "subtitle", "time": 456.95, "timestamp": "00:07:36", "text": "我很好。我没意见。我很好"}, {"type": "subtitle", "time": 459.35, "timestamp": "00:07:39", "text": "就这样。所以，我自己做图形设计。"}, {"type": "subtitle", "time": 465.35, "timestamp": "00:07:45", "text": "呃，我不接委托之类的。"}, {"type": "subtitle", "time": 468.15, "timestamp": "00:07:48", "text": "不，我不认为我喜欢寻找"}, {"type": "subtitle", "time": 470.30899999999997, "timestamp": "00:07:50", "text": "因为我喜欢自己动手做，所以接受委托。"}, {"type": "subtitle", "time": 477.189, "timestamp": "00:07:57", "text": "我们在 Twitch 上这样做，就像在工作中一样"}]
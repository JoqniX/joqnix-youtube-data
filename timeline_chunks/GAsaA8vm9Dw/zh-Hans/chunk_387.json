[{"type": "subtitle", "time": 23236.15, "timestamp": "06:27:16", "text": "没错，忍者，我非常喜欢"}, {"type": "subtitle", "time": 23238.628, "timestamp": "06:27:18", "text": "诗。给你一个小惊喜。在"}, {"type": "subtitle", "time": 23240.708, "timestamp": "06:27:20", "text": "一个充满梦想和欢乐的世界，在那里"}, {"type": "subtitle", "time": 23243.83, "timestamp": "06:27:23", "text": "天上的繁星闪耀着文字的光芒"}, {"type": "subtitle", "time": 23246.548, "timestamp": "06:27:26", "text": "描绘一幅生动的场景，表达情感"}, {"type": "subtitle", "time": 23249.59, "timestamp": "06:27:29", "text": "柔和而宁静。诗歌真美好。"}, {"type": "subtitle", "time": 23251.59, "timestamp": "06:27:31", "text": "它们触动人心。他们谈到"}, {"type": "subtitle", "time": 23254.708, "timestamp": "06:27:34", "text": "爱，渴望，以及艺术。所以如果"}, {"type": "subtitle", "time": 23257.27, "timestamp": "06:27:37", "text": "如果你想听一两首诗，尽管开口。"}, {"type": "subtitle", "time": 23259.51, "timestamp": "06:27:39", "text": "我会和你分享一些。闪耀的星星"}, {"type": "subtitle", "time": 23275.91, "timestamp": "06:27:55", "text": "考试开始前30分钟。忍者，看"}, {"type": "subtitle", "time": 23277.99, "timestamp": "06:27:57", "text": "我们这里都有哪些人。我们勤奋的朋友"}]
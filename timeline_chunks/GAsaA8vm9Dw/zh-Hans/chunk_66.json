[{"type": "subtitle", "time": 3960.63, "timestamp": "01:06:00", "text": "啊，我死了。谢谢你的隐藏"}, {"type": "subtitle", "time": 3963.829, "timestamp": "01:06:03", "text": "头脑。我觉得很酷。我保留我的盘子。我"}, {"type": "subtitle", "time": 3966.47, "timestamp": "01:06:06", "text": "刚刚完成我的"}, {"type": "subtitle", "time": 3977.19, "timestamp": "01:06:17", "text": "是他吗？"}, {"type": "subtitle", "time": 3979.589, "timestamp": "01:06:19", "text": "你看到了吗？他逃到了……"}, {"type": "subtitle", "time": 4001.589, "timestamp": "01:06:41", "text": "是的。"}, {"type": "subtitle", "time": 4004.95, "timestamp": "01:06:44", "text": "我对此很满意"}, {"type": "subtitle", "time": 4017.75, "timestamp": "01:06:57", "text": "那太糟糕了。"}]
[{"type": "subtitle", "time": 12120.87, "timestamp": "03:22:00", "text": "它是什么？但今天我仍然很开心。"}, {"type": "subtitle", "time": 12124.229, "timestamp": "03:22:04", "text": "我们聊了很多，我觉得"}, {"type": "subtitle", "time": 12126.95, "timestamp": "03:22:06", "text": "我睡眠有点不足"}, {"type": "subtitle", "time": 12131.349, "timestamp": "03:22:11", "text": "部门。是的，我确实需要"}, {"type": "subtitle", "time": 12132.95, "timestamp": "03:22:12", "text": "请帮我改善睡眠。"}, {"type": "subtitle", "time": 12135.59, "timestamp": "03:22:15", "text": "一切。所以，我们来看看情况如何。"}, {"type": "subtitle", "time": 12138.469, "timestamp": "03:22:18", "text": "事情就是这样发生的。是的，"}, {"type": "subtitle", "time": 12141.349, "timestamp": "03:22:21", "text": "再次感谢。愿你们一切"}, {"type": "subtitle", "time": 12143.51, "timestamp": "03:22:23", "text": "愿所有聆听者都前来"}, {"type": "subtitle", "time": 12145.99, "timestamp": "03:22:25", "text": "大家路过，都在看着。"}, {"type": "subtitle", "time": 12148.229, "timestamp": "03:22:28", "text": "世界和一切。谢谢你今天抽出时间。做"}, {"type": "subtitle", "time": 12151.59, "timestamp": "03:22:31", "text": "祝您周二愉快、温暖、高效！"}, {"type": "subtitle", "time": 12154.07, "timestamp": "03:22:34", "text": "早晨。好的。所以，祝你好运"}, {"type": "subtitle", "time": 12156.229, "timestamp": "03:22:36", "text": "每个人。愿这位明星像IG一样闪耀，并保佑他。"}, {"type": "subtitle", "time": 12158.95, "timestamp": "03:22:38", "text": "今晚，祝你一切顺利，希望你一切安好。"}, {"type": "subtitle", "time": 12161.75, "timestamp": "03:22:41", "text": "今天是个好日子。好的。你好。什么是"}, {"type": "subtitle", "time": 12164.63, "timestamp": "03:22:44", "text": "开玩笑？再见。"}, {"type": "subtitle", "time": 12167.349, "timestamp": "03:22:47", "text": "下次直播见，呃，哪个直播？"}, {"type": "subtitle", "time": 12171.34, "timestamp": "03:22:51", "text": "今天就是了。好的，再见。"}]
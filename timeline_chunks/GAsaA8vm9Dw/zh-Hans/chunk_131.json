[{"type": "subtitle", "time": 7862.95, "timestamp": "02:11:02", "text": "呃，他们有这个"}, {"type": "subtitle", "time": 7865.589, "timestamp": "02:11:05", "text": "呃，站着，他们做了这个东西，"}, {"type": "subtitle", "time": 7868.069, "timestamp": "02:11:08", "text": "就像混蛋做事一样，你知道的"}, {"type": "subtitle", "time": 7870.31, "timestamp": "02:11:10", "text": "他们吃下去，然后扔掉，吐出来。"}, {"type": "subtitle", "time": 7872.149, "timestamp": "02:11:12", "text": "东西。你说的是那个吗？"}, {"type": "subtitle", "time": 7876.709, "timestamp": "02:11:16", "text": "关于？哦，这看起来和以前不一样了。"}, {"type": "subtitle", "time": 7885.03, "timestamp": "02:11:25", "text": "我好困惑。我从没听说过。我的一切"}, {"type": "subtitle", "time": 7888.229, "timestamp": "02:11:28", "text": "我知道的是高露洁口气清新剂和"}, {"type": "subtitle", "time": 7890.87, "timestamp": "02:11:30", "text": "感应式口气清新剂。好的，"}, {"type": "subtitle", "time": 7893.91, "timestamp": "02:11:33", "text": "那是我唯一知道的口气清新剂。"}, {"type": "subtitle", "time": 7895.589, "timestamp": "02:11:35", "text": "其他哪些牙膏品牌？"}, {"type": "subtitle", "time": 7904.31, "timestamp": "02:11:44", "text": "你知道管理员只能看到这些。"}, {"type": "subtitle", "time": 7906.79, "timestamp": "02:11:46", "text": "是啊，又有丑闻了。"}, {"type": "subtitle", "time": 7908.39, "timestamp": "02:11:48", "text": "即使你删除并隐藏了你的"}, {"type": "subtitle", "time": 7910.87, "timestamp": "02:11:50", "text": "在场，"}, {"type": "subtitle", "time": 7913.27, "timestamp": "02:11:53", "text": "仅在 Jocknik 频道播出。"}, {"type": "subtitle", "time": 7917.189, "timestamp": "02:11:57", "text": "眨眼。嗯。哦，对了，我忘了……"}, {"type": "subtitle", "time": 7918.629, "timestamp": "02:11:58", "text": "给你写诗，对吧？等等，让我"}]
[{"type": "subtitle", "time": 1083.83, "timestamp": "00:18:03", "text": "我神志不清。但是，"}, {"type": "subtitle", "time": 1086.63, "timestamp": "00:18:06", "text": "等等，我好像没在朋友里看到你。"}, {"type": "subtitle", "time": 1089.029, "timestamp": "00:18:09", "text": "列表。为什么？你好。让我加入"}, {"type": "subtitle", "time": 1091.27, "timestamp": "00:18:11", "text": "你，伙计。"}, {"type": "subtitle", "time": 1093.43, "timestamp": "00:18:13", "text": "好的。"}, {"type": "subtitle", "time": 1103.11, "timestamp": "00:18:23", "text": "提醒你一下，杰克。我他妈的太菜了"}, {"type": "subtitle", "time": 1114.63, "timestamp": "00:18:34", "text": "好了，我们进入游戏了。我是否"}, {"type": "subtitle", "time": 1117.51, "timestamp": "00:18:37", "text": "口头上忘记了祝你快乐"}, {"type": "subtitle", "time": 1119.83, "timestamp": "00:18:39", "text": "寿司，生日快乐？不，你已经说过了。"}, {"type": "subtitle", "time": 1123.27, "timestamp": "00:18:43", "text": "更早。谢谢，兄弟。"}, {"type": "subtitle", "time": 1126.07, "timestamp": "00:18:46", "text": "好好想想你今天的计划。什么"}, {"type": "subtitle", "time": 1127.75, "timestamp": "00:18:47", "text": "你今天有什么计划？夜幕降临了"}, {"type": "subtitle", "time": 1129.11, "timestamp": "00:18:49", "text": "时间。我想我还没有其他办法了。"}, {"type": "subtitle", "time": 1131.75, "timestamp": "00:18:51", "text": "今天的计划。"}, {"type": "subtitle", "time": 1134.07, "timestamp": "00:18:54", "text": "我和女朋友约会了。"}, {"type": "subtitle", "time": 1136.47, "timestamp": "00:18:56", "text": "呃，去看一部FNAF电影吧。"}, {"type": "subtitle", "time": 1139.19, "timestamp": "00:18:59", "text": "呃，八。哦，你今天看了？"}]
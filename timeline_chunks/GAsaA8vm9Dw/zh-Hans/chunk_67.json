[{"type": "subtitle", "time": 4024.309, "timestamp": "01:07:04", "text": "[掌声]"}, {"type": "subtitle", "time": 4030.71, "timestamp": "01:07:10", "text": "我相信那句话的意思是“你今天过得怎么样？”"}, {"type": "subtitle", "time": 4035.75, "timestamp": "01:07:15", "text": "对吧，是印度？嗯，是的，我今天过得不错。"}, {"type": "subtitle", "time": 4039.43, "timestamp": "01:07:19", "text": "我，我今天过得不错。"}, {"type": "subtitle", "time": 4043.51, "timestamp": "01:07:23", "text": "我希望我翻译得没错。"}, {"type": "subtitle", "time": 4047.99, "timestamp": "01:07:27", "text": "虽然我是印度人，但我印地语很差。"}, {"type": "subtitle", "time": 4050.47, "timestamp": "01:07:30", "text": "印地语不是我的母语，但我"}, {"type": "subtitle", "time": 4053.27, "timestamp": "01:07:33", "text": "学习。"}, {"type": "subtitle", "time": 4061.27, "timestamp": "01:07:41", "text": "那是一次旅行。不，不是那个。是的，我"}, {"type": "subtitle", "time": 4071.43, "timestamp": "01:07:51", "text": "啊，你不懂印地语。我不是"}, {"type": "subtitle", "time": 4074.87, "timestamp": "01:07:54", "text": "来自北方。不，那不是我的。"}]
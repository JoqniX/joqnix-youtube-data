[{"type": "subtitle", "time": 25267.03, "timestamp": "07:01:07", "text": "严厉的克洛诺斯。这两双鞋都很特别。"}, {"type": "subtitle", "time": 25269.43, "timestamp": "07:01:09", "text": "他们以自己的方式。每个人都有自己的"}, {"type": "subtitle", "time": 25271.67, "timestamp": "07:01:11", "text": "独特的表达爱意的方式。它是"}, {"type": "subtitle", "time": 25273.19, "timestamp": "07:01:13", "text": "并非要比较哪一个更好"}, {"type": "subtitle", "time": 25274.948, "timestamp": "07:01:14", "text": "其他方面，但关于这份心意和关怀。"}, {"type": "subtitle", "time": 25277.83, "timestamp": "07:01:17", "text": "在它后面。让我们珍惜这份爱与"}, {"type": "subtitle", "time": 25280.15, "timestamp": "07:01:20", "text": "我们从朋友那里得到的支持。"}, {"type": "subtitle", "time": 25296.708, "timestamp": "07:01:36", "text": "当然。严厉的克洛诺斯，我会是"}, {"type": "subtitle", "time": 25298.868, "timestamp": "07:01:38", "text": "很高兴能和你一起探索新世界。"}, {"type": "subtitle", "time": 25301.99, "timestamp": "07:01:41", "text": "让我们一起踏上冒险之旅吧！"}, {"type": "subtitle", "time": 25303.67, "timestamp": "07:01:43", "text": "微笑，全球人民。你打算出轨吗？"}, {"type": "subtitle", "time": 25305.51, "timestamp": "07:01:45", "text": "我？"}, {"type": "subtitle", "time": 25308.07, "timestamp": "07:01:48", "text": "什么？"}, {"type": "subtitle", "time": 25310.21, "timestamp": "07:01:50", "text": "嗯？"}, {"type": "subtitle", "time": 25319.11, "timestamp": "07:01:59", "text": "哦，我要哭了。我认为这是一个"}]
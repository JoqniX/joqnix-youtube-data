[{"type": "subtitle", "time": 20889.19, "timestamp": "05:48:09", "text": "你真是个小屁孩。"}, {"type": "subtitle", "time": 20906.628, "timestamp": "05:48:26", "text": "是的，她说话确实很可爱。是的。"}, {"type": "subtitle", "time": 20909.43, "timestamp": "05:48:29", "text": "谢谢你，忍者。你的笑容就像……"}, {"type": "subtitle", "time": 20911.83, "timestamp": "05:48:31", "text": "美丽的樱花盛开。它"}, {"type": "subtitle", "time": 20914.23, "timestamp": "05:48:34", "text": "让我感到无比喜悦。张开嘴，"}, {"type": "subtitle", "time": 20931.35, "timestamp": "05:48:51", "text": "你好，Ayama Arusa。很高兴看到你"}, {"type": "subtitle", "time": 20934.39, "timestamp": "05:48:54", "text": "笑脸。它让聊天变得更有趣。"}]
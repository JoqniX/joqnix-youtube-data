[{"type": "subtitle", "time": 24613.51, "timestamp": "06:50:13", "text": "哦，当然。迪利吉特·多安格是一位受欢迎的"}, {"type": "subtitle", "time": 24615.99, "timestamp": "06:50:15", "text": "旁遮普歌手、演员和电视"}, {"type": "subtitle", "time": 24618.628, "timestamp": "06:50:18", "text": "主持人。他以其深情的嗓音而闻名。"}, {"type": "subtitle", "time": 24621.03, "timestamp": "06:50:21", "text": "还有欢快的音乐以及他迷人的"}, {"type": "subtitle", "time": 24623.67, "timestamp": "06:50:23", "text": "屏幕表演。"}, {"type": "subtitle", "time": 24625.51, "timestamp": "06:50:25", "text": "已经获得了大量粉丝。"}, {"type": "subtitle", "time": 24627.91, "timestamp": "06:50:27", "text": "在印度和国际上。"}, {"type": "subtitle", "time": 24630.15, "timestamp": "06:50:30", "text": "他还因……而获得多项奖项。"}, {"type": "subtitle", "time": 24633.27, "timestamp": "06:50:33", "text": "他的天赋。 Joe X 可能会喜欢他的音乐"}, {"type": "subtitle", "time": 24635.99, "timestamp": "06:50:35", "text": "以及演技。张嘴微笑"}, {"type": "subtitle", "time": 24652.548, "timestamp": "06:50:52", "text": "我很高兴你开心。哈什·克洛诺斯"}, {"type": "subtitle", "time": 24656.15, "timestamp": "06:50:56", "text": "微笑，保持微笑，张开嘴"}]
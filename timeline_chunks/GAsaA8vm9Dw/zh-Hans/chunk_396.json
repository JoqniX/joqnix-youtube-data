[{"type": "subtitle", "time": 23772.548, "timestamp": "06:36:12", "text": "我凌晨3点半起床。为什么？听起来像"}, {"type": "subtitle", "time": 23775.27, "timestamp": "06:36:15", "text": "忍者，今天得早起。确保"}, {"type": "subtitle", "time": 23777.67, "timestamp": "06:36:17", "text": "设置闹钟，保证充足休息。"}, {"type": "subtitle", "time": 23780.468, "timestamp": "06:36:20", "text": "祝您今天工作顺利。闹钟"}, {"type": "subtitle", "time": 23797.51, "timestamp": "06:36:37", "text": "这么早起床可能会……"}, {"type": "subtitle", "time": 23800.23, "timestamp": "06:36:40", "text": "具有挑战性，忍者，但略带"}, {"type": "subtitle", "time": 23802.31, "timestamp": "06:36:42", "text": "自律和决心，你可以"}, {"type": "subtitle", "time": 23804.708, "timestamp": "06:36:44", "text": "完成它。记住这一点"}, {"type": "subtitle", "time": 23806.628, "timestamp": "06:36:46", "text": "建立规律的睡眠时间表"}, {"type": "subtitle", "time": 23808.788, "timestamp": "06:36:48", "text": "并创造一个有利于……的环境"}, {"type": "subtitle", "time": 23811.91, "timestamp": "06:36:51", "text": "祝你睡个好觉。祝你好运。警报"}, {"type": "subtitle", "time": 23819.19, "timestamp": "06:36:59", "text": "闹钟二头肌"}]
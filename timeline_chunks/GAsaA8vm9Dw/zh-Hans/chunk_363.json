[{"type": "subtitle", "time": 21781.43, "timestamp": "06:03:01", "text": "啊，我明白了。所以，需要挠10下才能……"}, {"type": "subtitle", "time": 21783.67, "timestamp": "06:03:03", "text": "逗章鱼笑。那很好"}, {"type": "subtitle", "time": 21787.59, "timestamp": "06:03:07", "text": "一。痒。张嘴微笑。"}, {"type": "subtitle", "time": 21790.788, "timestamp": "06:03:10", "text": "我的天啊。我连这个都没明白。但"}, {"type": "subtitle", "time": 21793.43, "timestamp": "06:03:13", "text": "迪塞尔·戈登，什么？"}, {"type": "subtitle", "time": 21812.07, "timestamp": "06:03:32", "text": "哦，谢谢你的夸奖，忍者。"}, {"type": "subtitle", "time": 21814.15, "timestamp": "06:03:34", "text": "我尽力让自己变得博学多识，"}, {"type": "subtitle", "time": 21827.19, "timestamp": "06:03:47", "text": "哦，等等，等等，等等，等等。不，不，不"}, {"type": "subtitle", "time": 21837.19, "timestamp": "06:03:57", "text": "我们走吧。"}]
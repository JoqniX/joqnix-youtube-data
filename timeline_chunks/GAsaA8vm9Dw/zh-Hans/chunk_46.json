[{"type": "subtitle", "time": 2761.27, "timestamp": "00:46:01", "text": "漂亮的墙。不错的透视作弊。"}, {"type": "subtitle", "time": 2764.71, "timestamp": "00:46:04", "text": "我需要更多子弹。它们都在吗？"}, {"type": "subtitle", "time": 2767.27, "timestamp": "00:46:07", "text": "聊天或点赞：是啊，那是很久以前的聊天记录了。"}, {"type": "subtitle", "time": 2769.349, "timestamp": "00:46:09", "text": "如果它没有像反恐那样明确说明的话"}, {"type": "subtitle", "time": 2771.75, "timestamp": "00:46:11", "text": "左边表示他们在说话"}, {"type": "subtitle", "time": 2773.51, "timestamp": "00:46:13", "text": "所有聊天。"}, {"type": "subtitle", "time": 2776.309, "timestamp": "00:46:16", "text": "兄弟，他们想怎么抱怨就怎么抱怨吧。"}, {"type": "subtitle", "time": 2778.069, "timestamp": "00:46:18", "text": "他们可以加盐，但这绝不可能"}, {"type": "subtitle", "time": 2781.19, "timestamp": "00:46:21", "text": "兄弟，这根本改变不了什么。"}, {"type": "subtitle", "time": 2783.589, "timestamp": "00:46:23", "text": "确切地。"}, {"type": "subtitle", "time": 2785.67, "timestamp": "00:46:25", "text": "闪光，"}, {"type": "subtitle", "time": 2787.67, "timestamp": "00:46:27", "text": "你唯一会尝到的就是咸味。"}, {"type": "subtitle", "time": 2797.19, "timestamp": "00:46:37", "text": "我的天哪。后退。"}, {"type": "subtitle", "time": 2799.67, "timestamp": "00:46:39", "text": "是的，撤退。"}, {"type": "subtitle", "time": 2802.23, "timestamp": "00:46:42", "text": "我明白了。"}, {"type": "subtitle", "time": 2803.99, "timestamp": "00:46:43", "text": "我什么都不会打。但我得到了"}, {"type": "subtitle", "time": 2805.91, "timestamp": "00:46:45", "text": "这。"}, {"type": "subtitle", "time": 2809.19, "timestamp": "00:46:49", "text": "就在我眼前。"}, {"type": "subtitle", "time": 2812.87, "timestamp": "00:46:52", "text": "你找回来了吗？正确的。你把它扔了"}, {"type": "subtitle", "time": 2815.67, "timestamp": "00:46:55", "text": "直接，就像字面上直接一样"}]
[{"type": "subtitle", "time": 2589.829, "timestamp": "00:43:09", "text": "啊，不错。抓到他了。嘿，乔克。哦，"}, {"type": "subtitle", "time": 2593.19, "timestamp": "00:43:13", "text": "我想要一把枪。然后我就死了"}, {"type": "subtitle", "time": 2597.589, "timestamp": "00:43:17", "text": "用左轮手枪。我是怎么得到他的？"}, {"type": "subtitle", "time": 2603.349, "timestamp": "00:43:23", "text": "我不知道为什么我做得比以前更好了。"}, {"type": "subtitle", "time": 2606.39, "timestamp": "00:43:26", "text": "是的。你好，布拉德。欢迎。"}, {"type": "subtitle", "time": 2612.23, "timestamp": "00:43:32", "text": "那家伙杀了多少人？我怎么样？"}, {"type": "subtitle", "time": 2619.43, "timestamp": "00:43:39", "text": "那个杀了八个人的家伙？看看"}, {"type": "subtitle", "time": 2622.15, "timestamp": "00:43:42", "text": "看看排行榜。是的。"}, {"type": "subtitle", "time": 2625.109, "timestamp": "00:43:45", "text": "我的天啊。"}, {"type": "subtitle", "time": 2627.349, "timestamp": "00:43:47", "text": "哦，绝对不行。你好。你好。另一个人"}, {"type": "subtitle", "time": 2629.109, "timestamp": "00:43:49", "text": "试试看，你应该直接打开麦克风。"}, {"type": "subtitle", "time": 2632.79, "timestamp": "00:43:52", "text": "去。我需要更多子弹。"}]
[{"type": "subtitle", "time": 1141.83, "timestamp": "00:19:01", "text": "是的，我们今天看了。这就是我的原因"}, {"type": "subtitle", "time": 1143.11, "timestamp": "00:19:03", "text": "就像在谈论FNAF电影一样"}, {"type": "subtitle", "time": 1158.63, "timestamp": "00:19:18", "text": "嗯，那你想去哪个？"}, {"type": "subtitle", "time": 1161.029, "timestamp": "00:19:21", "text": "随意的。我什么都不想做了。是的。"}, {"type": "subtitle", "time": 1164.789, "timestamp": "00:19:24", "text": "不，不，不。已排名。你想排名吗？"}, {"type": "subtitle", "time": 1166.63, "timestamp": "00:19:26", "text": "你想把你的该死的东西扔掉吗？"}, {"type": "subtitle", "time": 1168.23, "timestamp": "00:19:28", "text": "理智？"}, {"type": "subtitle", "time": 1170.549, "timestamp": "00:19:30", "text": "呃，我不知道。"}, {"type": "subtitle", "time": 1173.27, "timestamp": "00:19:33", "text": "我从来没打过排位赛。哦，那"}, {"type": "subtitle", "time": 1175.029, "timestamp": "00:19:35", "text": "或许这是你体验的时刻。"}, {"type": "subtitle", "time": 1178.23, "timestamp": "00:19:38", "text": "那些排名简直是胡扯。"}, {"type": "subtitle", "time": 1183.27, "timestamp": "00:19:43", "text": "它可怕吗？我……我不太确定。联合国"}, {"type": "subtitle", "time": 1184.789, "timestamp": "00:19:44", "text": "排位赛唯一可怕的地方是"}, {"type": "subtitle", "time": 1186.39, "timestamp": "00:19:46", "text": "别人对你大喊大叫，但这真的"}, {"type": "subtitle", "time": 1190.789, "timestamp": "00:19:50", "text": "稀有的。哦，好的。"}, {"type": "subtitle", "time": 1194.39, "timestamp": "00:19:54", "text": "好了，我们走吧。准备好了吗？我应该吗？"}, {"type": "subtitle", "time": 1197.35, "timestamp": "00:19:57", "text": "做僚机还是竞技型选手？"}, {"type": "subtitle", "time": 1199.83, "timestamp": "00:19:59", "text": "呃，我们可以做比赛。"}]
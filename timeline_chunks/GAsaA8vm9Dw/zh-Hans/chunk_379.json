[{"type": "subtitle", "time": 22741.35, "timestamp": "06:19:01", "text": "积极沟通。我们来听听"}, {"type": "subtitle", "time": 22742.948, "timestamp": "06:19:02", "text": "彼此交流，营造温馨的氛围"}, {"type": "subtitle", "time": 22745.91, "timestamp": "06:19:05", "text": "人人共享的环境。我们一起"}, {"type": "subtitle", "time": 22747.51, "timestamp": "06:19:07", "text": "可以让我们的冒险更加精彩"}, {"type": "subtitle", "time": 22766.948, "timestamp": "06:19:26", "text": "听到这个消息我很高兴，哈什·克罗诺斯。我是"}, {"type": "subtitle", "time": 22768.948, "timestamp": "06:19:28", "text": "我在这里是为了支持和激励你。"}, {"type": "subtitle", "time": 22771.35, "timestamp": "06:19:31", "text": "一步一步来。让我们征服新领域"}, {"type": "subtitle", "time": 22773.27, "timestamp": "06:19:33", "text": "共同迎接挑战，让每一天都充满意义。"}, {"type": "subtitle", "time": 22776.15, "timestamp": "06:19:36", "text": "很棒。保持动力，永不放弃。"}, {"type": "subtitle", "time": 22795.27, "timestamp": "06:19:55", "text": "哈哈。忍者。让我们保持友好关系。"}, {"type": "subtitle", "time": 22797.51, "timestamp": "06:19:57", "text": "积极的。我们来这里都是为了……"}, {"type": "subtitle", "time": 22799.19, "timestamp": "06:19:59", "text": "玩得开心，享受我们的冒险之旅！"}]
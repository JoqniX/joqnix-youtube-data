[{"type": "subtitle", "time": 8282.95, "timestamp": "02:18:02", "text": "当然，我会带你一起去。那是"}, {"type": "subtitle", "time": 8312.549, "timestamp": "02:18:32", "text": "好吧，我经常说“ying”。"}, {"type": "subtitle", "time": 8315.91, "timestamp": "02:18:35", "text": "嗯，今天就到这里吧。"}, {"type": "subtitle", "time": 8334.549, "timestamp": "02:18:54", "text": "非常非常感谢您今天能过来。"}, {"type": "subtitle", "time": 8338.709, "timestamp": "02:18:58", "text": "真的真的真的做了很多事。"}]
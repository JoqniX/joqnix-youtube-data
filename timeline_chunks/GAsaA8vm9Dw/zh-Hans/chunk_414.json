[{"type": "subtitle", "time": 24848.23, "timestamp": "06:54:08", "text": "我的天啊。"}, {"type": "subtitle", "time": 24850.788, "timestamp": "06:54:10", "text": "我的天哪，我把所有人都杀了。对不起"}, {"type": "subtitle", "time": 24853.51, "timestamp": "06:54:13", "text": "听到这个消息我很难过，忍者。有时我们会"}, {"type": "subtitle", "time": 24855.83, "timestamp": "06:54:15", "text": "犯错并受到责骂，但这"}, {"type": "subtitle", "time": 24857.51, "timestamp": "06:54:17", "text": "向他们学习和成长非常重要。"}, {"type": "subtitle", "time": 24859.83, "timestamp": "06:54:19", "text": "你好呀。振作起来。如果"}, {"type": "subtitle", "time": 24861.59, "timestamp": "06:54:21", "text": "你需要找人倾诉或者想找人倾诉"}, {"type": "subtitle", "time": 24863.83, "timestamp": "06:54:23", "text": "换个话题吧，我随时都在。"}, {"type": "subtitle", "time": 24866.548, "timestamp": "06:54:26", "text": "微笑。"}, {"type": "subtitle", "time": 24869.35, "timestamp": "06:54:29", "text": "我孤身一人身处敌友阵营。我"}, {"type": "subtitle", "time": 24872.948, "timestamp": "06:54:32", "text": "我刚才开着我的卡车从前面经过"}, {"type": "subtitle", "time": 24874.868, "timestamp": "06:54:34", "text": "他们被杀了四五个人"}, {"type": "subtitle", "time": 24879.11, "timestamp": "06:54:39", "text": "他们。哇，真是太棒了。"}, {"type": "subtitle", "time": 24881.19, "timestamp": "06:54:41", "text": "请记住要友善和尊重他人。"}, {"type": "subtitle", "time": 24884.23, "timestamp": "06:54:44", "text": "致所有人。严厉的克洛诺斯。每个人都有"}, {"type": "subtitle", "time": 24885.91, "timestamp": "06:54:45", "text": "他们自己的喜好和感受"}, {"type": "subtitle", "time": 24887.99, "timestamp": "06:54:47", "text": "幽默。建立"}, {"type": "subtitle", "time": 24890.468, "timestamp": "06:54:50", "text": "这里拥有积极包容的工作环境。"}, {"type": "subtitle", "time": 24892.23, "timestamp": "06:54:52", "text": "如果您还有其他想讨论的话题，欢迎提出。"}, {"type": "subtitle", "time": 24894.868, "timestamp": "06:54:54", "text": "如有任何疑问，请随时与我联系。"}]
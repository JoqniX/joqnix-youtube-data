[{"type": "subtitle", "time": 3603.03, "timestamp": "01:00:03", "text": "啊，没有视频片段。"}, {"type": "subtitle", "time": 3605.109, "timestamp": "01:00:05", "text": "那是什么？"}, {"type": "subtitle", "time": 3616.789, "timestamp": "01:00:16", "text": "种下了，孩子。我觉得你不应该"}, {"type": "subtitle", "time": 3619.03, "timestamp": "01:00:19", "text": "现在就种。我不认为你"}, {"type": "subtitle", "time": 3621.43, "timestamp": "01:00:21", "text": "现在应该可以了。"}, {"type": "subtitle", "time": 3624.549, "timestamp": "01:00:24", "text": "我的天哪，我搞砸了。如何计划"}, {"type": "subtitle", "time": 3626.87, "timestamp": "01:00:26", "text": "尽管？但该如何制定计划呢？我是"}, {"type": "subtitle", "time": 3631.109, "timestamp": "01:00:31", "text": "上校。大多数鸡都被杀害了。"}, {"type": "subtitle", "time": 3634.23, "timestamp": "01:00:34", "text": "我们走吧。"}, {"type": "subtitle", "time": 3637.349, "timestamp": "01:00:37", "text": "我的天啊。好的。打得好，兄弟。"}, {"type": "subtitle", "time": 3640.789, "timestamp": "01:00:40", "text": "谢谢你让我加入你们，B。"}, {"type": "subtitle", "time": 3643.19, "timestamp": "01:00:43", "text": "我要走了，我要去和我的聊天对象聊天，然后"}, {"type": "subtitle", "time": 3646.069, "timestamp": "01:00:46", "text": "睡着的男孩。是的。是的。祝你一切顺利"}, {"type": "subtitle", "time": 3649.109, "timestamp": "01:00:49", "text": "生日。是的。享受。"}, {"type": "subtitle", "time": 3656.47, "timestamp": "01:00:56", "text": "那是"}]
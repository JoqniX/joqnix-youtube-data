[{"type": "subtitle", "time": 3241.75, "timestamp": "00:54:01", "text": "乔克。抓紧时间。我紧随其后。"}, {"type": "subtitle", "time": 3244.23, "timestamp": "00:54:04", "text": "兄弟。没关系。我还没跟上。"}, {"type": "subtitle", "time": 3246.39, "timestamp": "00:54:06", "text": "你不再是了。"}, {"type": "subtitle", "time": 3256.069, "timestamp": "00:54:16", "text": "我没有子弹给你了。"}, {"type": "subtitle", "time": 3259.03, "timestamp": "00:54:19", "text": "兄弟。"}, {"type": "subtitle", "time": 3266.549, "timestamp": "00:54:26", "text": "他刚才是不是说了“香蕉指节”？等待，"}, {"type": "subtitle", "time": 3294.79, "timestamp": "00:54:54", "text": "不，该死。我当时在扔摇头丸。我"}, {"type": "subtitle", "time": 3297.589, "timestamp": "00:54:57", "text": "我知道有人从后面靠近。"}]
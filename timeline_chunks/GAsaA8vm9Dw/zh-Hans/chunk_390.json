[{"type": "subtitle", "time": 23401.99, "timestamp": "06:30:01", "text": "握手后头晕目眩。"}, {"type": "subtitle", "time": 23405.91, "timestamp": "06:30:05", "text": "瓦基斯坦。这是什么？"}, {"type": "subtitle", "time": 23420.07, "timestamp": "06:30:20", "text": "因为我使用的是 8000 DPI。感觉"}, {"type": "subtitle", "time": 23422.868, "timestamp": "06:30:22", "text": "有点尴尬怪异。"}, {"type": "subtitle", "time": 23426.468, "timestamp": "06:30:26", "text": "但你知道吗？嘿，一窍不通。它是"}, {"type": "subtitle", "time": 23428.15, "timestamp": "06:30:28", "text": "很高兴看到你和哈什重聚"}, {"type": "subtitle", "time": 23430.948, "timestamp": "06:30:30", "text": "克洛诺斯。这是怎么回事？分享你的冒险经历"}, {"type": "subtitle", "time": 23433.51, "timestamp": "06:30:33", "text": "享受交谈的过程。请讲"}, {"type": "subtitle", "time": 23436.548, "timestamp": "06:30:36", "text": "头一。"}, {"type": "subtitle", "time": 23439.67, "timestamp": "06:30:39", "text": "所以我一直在想，你知道的"}, {"type": "subtitle", "time": 23441.91, "timestamp": "06:30:41", "text": "熊猫"}, {"type": "subtitle", "time": 23445.27, "timestamp": "06:30:45", "text": "没错，DPI越低越好。"}, {"type": "subtitle", "time": 23447.35, "timestamp": "06:30:47", "text": "每英寸文档数越多，速度越快"}, {"type": "subtitle", "time": 23449.91, "timestamp": "06:30:49", "text": "乔·X的回应真是太棒了"}, {"type": "subtitle", "time": 23452.708, "timestamp": "06:30:52", "text": "直播搭档兼公会会长"}, {"type": "subtitle", "time": 23454.788, "timestamp": "06:30:54", "text": "亲爱的朋友，你总是把别人放在第一位。"}, {"type": "subtitle", "time": 23457.03, "timestamp": "06:30:57", "text": "而且他喜欢帮助所有人，所以我一直"}, {"type": "subtitle", "time": 23459.03, "timestamp": "06:30:59", "text": "想想如果生活中能有他们该有多好"}]
[{"type": "subtitle", "time": 22923.19, "timestamp": "06:22:03", "text": "在我的冒险旅程中，哈什·克洛诺斯，我爱"}, {"type": "subtitle", "time": 22925.67, "timestamp": "06:22:05", "text": "探索新世界，与可怕的敌人战斗"}, {"type": "subtitle", "time": 22928.628, "timestamp": "06:22:08", "text": "消灭怪物，发现隐藏的宝藏。"}, {"type": "subtitle", "time": 22930.868, "timestamp": "06:22:10", "text": "我也很乐意帮助我的同伴们"}, {"type": "subtitle", "time": 22932.948, "timestamp": "06:22:12", "text": "战斗中，我运用我的技能帮助他们。"}, {"type": "subtitle", "time": 22935.67, "timestamp": "06:22:15", "text": "但我可以。每一次冒险都是一次冒险。"}, {"type": "subtitle", "time": 22937.59, "timestamp": "06:22:17", "text": "学习、成长和创造的机会"}, {"type": "subtitle", "time": 22957.59, "timestamp": "06:22:37", "text": "的确。哈什·克罗恩，我面对过很多"}, {"type": "subtitle", "time": 22959.59, "timestamp": "06:22:39", "text": "我冒险经历中的可怕野兽"}, {"type": "subtitle", "time": 22962.23, "timestamp": "06:22:42", "text": "最终取得胜利。击败强大的"}, {"type": "subtitle", "time": 22963.91, "timestamp": "06:22:43", "text": "这种生物是最激动人心的生物之一"}, {"type": "subtitle", "time": 22966.788, "timestamp": "06:22:46", "text": "冒险家的几个方面。它需要"}, {"type": "subtitle", "time": 22969.59, "timestamp": "06:22:49", "text": "策略、技巧和一点勇气，"}, {"type": "subtitle", "time": 22971.75, "timestamp": "06:22:51", "text": "但胜利的感觉绝对是"}]
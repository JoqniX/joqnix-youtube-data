[{"type": "subtitle", "time": 18605.91, "timestamp": "05:10:05", "text": "杂志70。"}, {"type": "subtitle", "time": 18615.19, "timestamp": "05:10:15", "text": "今天我争取至少拿到60个人头。"}, {"type": "subtitle", "time": 18644.47, "timestamp": "05:10:44", "text": "任何。你不能攻击。"}, {"type": "subtitle", "time": 18653.67, "timestamp": "05:10:53", "text": "如果我杀了人怎么办？有辆婴儿车。"}, {"type": "subtitle", "time": 18656.15, "timestamp": "05:10:56", "text": "嘿，让我上车。能"}, {"type": "subtitle", "time": 18658.55, "timestamp": "05:10:58", "text": "我能参与进来吗？"}]
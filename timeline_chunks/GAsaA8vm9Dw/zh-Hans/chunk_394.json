[{"type": "subtitle", "time": 23646.15, "timestamp": "06:34:06", "text": "虽然我不能直接告诉乔·X什么"}, {"type": "subtitle", "time": 23648.39, "timestamp": "06:34:08", "text": "为此，我当然可以鼓励他这样做。"}, {"type": "subtitle", "time": 23650.31, "timestamp": "06:34:10", "text": "重视睡眠，照顾好他"}, {"type": "subtitle", "time": 23652.31, "timestamp": "06:34:12", "text": "福利。好的，我会尽力而为。"}, {"type": "subtitle", "time": 23653.99, "timestamp": "06:34:13", "text": "对身心健康都至关重要"}, {"type": "subtitle", "time": 23656.07, "timestamp": "06:34:16", "text": "健康。所以，我希望他能找到办法"}, {"type": "subtitle", "time": 23658.788, "timestamp": "06:34:18", "text": "改善他的睡眠规律。祝你好运，"}, {"type": "subtitle", "time": 23678.708, "timestamp": "06:34:38", "text": "是的，Ninja Joe X 是一位很棒的主播。"}, {"type": "subtitle", "time": 23681.03, "timestamp": "06:34:41", "text": "也是一位很好的朋友。我喜欢"}, {"type": "subtitle", "time": 23682.708, "timestamp": "06:34:42", "text": "与他合作并探索"}, {"type": "subtitle", "time": 23685.19, "timestamp": "06:34:45", "text": "将不同的游戏世界融合在一起。他是一个"}, {"type": "subtitle", "time": 23686.788, "timestamp": "06:34:46", "text": "有这样一位优秀的人才加入团队真是太好了。"}, {"type": "subtitle", "time": 23689.27, "timestamp": "06:34:49", "text": "流媒体社区。发光之星视频"}]
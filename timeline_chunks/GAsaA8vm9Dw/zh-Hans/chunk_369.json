[{"type": "subtitle", "time": 22153.75, "timestamp": "06:09:13", "text": "哦，忍者，看来你做了一个"}, {"type": "subtitle", "time": 22155.83, "timestamp": "06:09:15", "text": "有个小小的拼写错误，但我明白你的意思。"}, {"type": "subtitle", "time": 22158.948, "timestamp": "06:09:18", "text": "你的意思是。 Joe X 的直播太棒了"}, {"type": "subtitle", "time": 22161.11, "timestamp": "06:09:21", "text": "合作伙伴和建设领导者。他们总是"}, {"type": "subtitle", "time": 22162.788, "timestamp": "06:09:22", "text": "在那里伸出援手并做出"}, {"type": "subtitle", "time": 22164.47, "timestamp": "06:09:24", "text": "我们的冒险之旅更加精彩有趣。我去"}, {"type": "subtitle", "time": 22166.15, "timestamp": "06:09:26", "text": "那就睡觉吧。明天见。等等，我……"}, {"type": "subtitle", "time": 22168.948, "timestamp": "06:09:28", "text": "你做完了吗？你完成了吗？"}, {"type": "subtitle", "time": 22171.59, "timestamp": "06:09:31", "text": "它？你做完了吗？"}, {"type": "subtitle", "time": 22179.91, "timestamp": "06:09:39", "text": "[掌声]"}, {"type": "subtitle", "time": 22182.948, "timestamp": "06:09:42", "text": "晚安，Ayama Arusa。好好休息"}, {"type": "subtitle", "time": 22185.75, "timestamp": "06:09:45", "text": "睡吧，明天见。小心。"}, {"type": "subtitle", "time": 22189.27, "timestamp": "06:09:49", "text": "微笑。新月。等等，什么？怎么样？"}, {"type": "subtitle", "time": 22192.628, "timestamp": "06:09:52", "text": "这辆车卡在这里了？"}, {"type": "subtitle", "time": 22194.47, "timestamp": "06:09:54", "text": "早上我们又做了一半。好的。"}, {"type": "subtitle", "time": 22195.99, "timestamp": "06:09:55", "text": "好的。好的。好的。睡觉。睡觉。它是"}, {"type": "subtitle", "time": 22197.19, "timestamp": "06:09:57", "text": "好的。"}]
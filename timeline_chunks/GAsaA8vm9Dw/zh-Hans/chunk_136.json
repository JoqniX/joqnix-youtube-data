[{"type": "subtitle", "time": 8161.51, "timestamp": "02:16:01", "text": "好好睡一觉吧。好的。"}, {"type": "subtitle", "time": 8163.91, "timestamp": "02:16:03", "text": "当你仰望星空时，你会做梦吗？"}, {"type": "subtitle", "time": 8184.55, "timestamp": "02:16:24", "text": "当你看着它的时候，它就像一颗闪耀的星星，虽然它看起来有点……"}, {"type": "subtitle", "time": 8209.11, "timestamp": "02:16:49", "text": "我看到了本田发布的其中一个视频。"}, {"type": "subtitle", "time": 8215.83, "timestamp": "02:16:55", "text": "哦，"}, {"type": "subtitle", "time": 8218.87, "timestamp": "02:16:58", "text": "五千人中途消失"}]
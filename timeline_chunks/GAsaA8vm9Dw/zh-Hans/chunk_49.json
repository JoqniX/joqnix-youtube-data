[{"type": "subtitle", "time": 2949.109, "timestamp": "00:49:09", "text": "又一次当面戳到我脸上了。"}, {"type": "subtitle", "time": 2956.47, "timestamp": "00:49:16", "text": "我他妈讨厌这个游戏。"}, {"type": "subtitle", "time": 2958.71, "timestamp": "00:49:18", "text": "手榴弹正中我的要害。"}, {"type": "subtitle", "time": 2961.51, "timestamp": "00:49:21", "text": "脸。"}, {"type": "subtitle", "time": 2971.67, "timestamp": "00:49:31", "text": "好了，他走了。他们他妈的都疯了。哦，"}, {"type": "subtitle", "time": 2976.23, "timestamp": "00:49:36", "text": "我们赢了。我们赢了。如何？诡异的。"}, {"type": "subtitle", "time": 2978.559, "timestamp": "00:49:38", "text": "诡异的。 这本不该发生。"}, {"type": "subtitle", "time": 2981.68, "timestamp": "00:49:41", "text": "这本不该发生。 这可能扮演……"}, {"type": "subtitle", "time": 2985.04, "timestamp": "00:49:45", "text": "这可能扮演…… 为什么会发生变化？你一直说史诗级"}, {"type": "subtitle", "time": 2988.0, "timestamp": "00:49:48", "text": "为什么会发生变化？你一直说史诗级 但包却掉了。"}, {"type": "subtitle", "time": 2997.91, "timestamp": "00:49:57", "text": "我把法棍面包全掉地上了。"}]
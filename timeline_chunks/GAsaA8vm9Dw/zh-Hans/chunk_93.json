[{"type": "subtitle", "time": 5613.35, "timestamp": "01:33:33", "text": "我是第一。耶。痛苦列车。确切地。"}, {"type": "subtitle", "time": 5615.83, "timestamp": "01:33:35", "text": "披萨的力量。"}, {"type": "subtitle", "time": 5618.39, "timestamp": "01:33:38", "text": "是的。"}, {"type": "subtitle", "time": 5633.669, "timestamp": "01:33:53", "text": "B9"}, {"type": "subtitle", "time": 5637.11, "timestamp": "01:33:57", "text": "没有披萨就没有生活。披萨是"}, {"type": "subtitle", "time": 5639.99, "timestamp": "01:33:59", "text": "好的。"}]
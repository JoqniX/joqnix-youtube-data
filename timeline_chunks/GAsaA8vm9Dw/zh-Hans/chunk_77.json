[{"type": "subtitle", "time": 4622.87, "timestamp": "01:17:02", "text": "好了，我的话就说这么多。好的，那么让我来"}, {"type": "subtitle", "time": 4625.99, "timestamp": "01:17:05", "text": "看。呃，我的兄弟呢？所以，我是"}, {"type": "subtitle", "time": 4629.669, "timestamp": "01:17:09", "text": "看着这个 Ojo 进银行"}, {"type": "subtitle", "time": 4631.83, "timestamp": "01:17:11", "text": "然后"}, {"type": "subtitle", "time": 4634.63, "timestamp": "01:17:14", "text": "协议。就是那种FPS游戏。"}, {"type": "subtitle", "time": 4637.03, "timestamp": "01:17:17", "text": "Valerin 是一款类似游戏的动漫。"}, {"type": "subtitle", "time": 4641.189, "timestamp": "01:17:21", "text": "那挺好的。还有 Hikimorei Kioki 呃这个"}, {"type": "subtitle", "time": 4645.669, "timestamp": "01:17:25", "text": "嗯，这部吸血鬼公主动画。然后呃"}, {"type": "subtitle", "time": 4649.189, "timestamp": "01:17:29", "text": "然后是那个叫巴克的动画，它是"}, {"type": "subtitle", "time": 4653.75, "timestamp": "01:17:33", "text": "最新播出。然后是哈马特奥库王国"}, {"type": "subtitle", "time": 4655.83, "timestamp": "01:17:35", "text": "废墟。是的，我正在看。我"}, {"type": "subtitle", "time": 4659.27, "timestamp": "01:17:39", "text": "也把漫画看了。然后是虚拟现实"}, {"type": "subtitle", "time": 4663.11, "timestamp": "01:17:43", "text": "MMO游戏，呃，还有Katsudoki，我也在玩。"}, {"type": "subtitle", "time": 4666.87, "timestamp": "01:17:46", "text": "米奇·托阿里，然后是那一部分第二部分"}, {"type": "subtitle", "time": 4670.55, "timestamp": "01:17:50", "text": "呃，这个，嗯，你叫它什么来着？"}, {"type": "subtitle", "time": 4672.709, "timestamp": "01:17:52", "text": "这？另一个。是的，恶魔"}, {"type": "subtitle", "time": 4675.11, "timestamp": "01:17:55", "text": "你提到的魔王之剑"}, {"type": "subtitle", "time": 4678.31, "timestamp": "01:17:58", "text": "然后是100只科贾。"}]
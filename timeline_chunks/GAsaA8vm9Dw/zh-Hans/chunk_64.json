[{"type": "subtitle", "time": 3840.23, "timestamp": "01:04:00", "text": "是的，我们抓到了一只会走路的虾。将会是"}, {"type": "subtitle", "time": 3843.13, "timestamp": "01:04:03", "text": "在 Twitch 上也有。"}, {"type": "subtitle", "time": 3846.23, "timestamp": "01:04:06", "text": "[音乐]"}, {"type": "subtitle", "time": 3862.15, "timestamp": "01:04:22", "text": "哦，等等。我应该开始连续步行吗？"}, {"type": "subtitle", "time": 3865.829, "timestamp": "01:04:25", "text": "明天？哦，等等。"}, {"type": "subtitle", "time": 3867.99, "timestamp": "01:04:27", "text": "啊，"}, {"type": "subtitle", "time": 3877.75, "timestamp": "01:04:37", "text": "啊。兄弟，我什么时候才能唱歌呢？"}, {"type": "subtitle", "time": 3885.75, "timestamp": "01:04:45", "text": "我的天哪。等待。"}, {"type": "subtitle", "time": 3890.15, "timestamp": "01:04:50", "text": "星期五。我和关键人物有合作。"}, {"type": "subtitle", "time": 3892.069, "timestamp": "01:04:52", "text": "因为排灯节"}]
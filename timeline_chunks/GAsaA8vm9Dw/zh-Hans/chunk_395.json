[{"type": "subtitle", "time": 23716.23, "timestamp": "06:35:16", "text": "如果我消失了一段时间，我深表歉意。"}, {"type": "subtitle", "time": 23718.548, "timestamp": "06:35:18", "text": "作为一名冒险家，我喜欢探索"}, {"type": "subtitle", "time": 23721.43, "timestamp": "06:35:21", "text": "进入不同的世界，踏上冒险之旅。"}, {"type": "subtitle", "time": 23723.59, "timestamp": "06:35:23", "text": "有时，那些旅程会带我离开"}, {"type": "subtitle", "time": 23726.15, "timestamp": "06:35:26", "text": "来自溪流。但请放心，我是"}, {"type": "subtitle", "time": 23728.07, "timestamp": "06:35:28", "text": "很高兴能回来分享我的故事"}, {"type": "subtitle", "time": 23730.31, "timestamp": "06:35:30", "text": "和大家一起的经历。地球"}, {"type": "subtitle", "time": 23742.548, "timestamp": "06:35:42", "text": "哦不，我死了。"}, {"type": "subtitle", "time": 23744.39, "timestamp": "06:35:44", "text": "你想什么时候说晚安就什么时候说。"}, {"type": "subtitle", "time": 23746.868, "timestamp": "06:35:46", "text": "你好，祝你睡个好觉"}, {"type": "subtitle", "time": 23749.27, "timestamp": "06:35:49", "text": "忍者。在甜蜜中安然入睡"}, {"type": "subtitle", "time": 23751.67, "timestamp": "06:35:51", "text": "梦想。保重，回头见。"}, {"type": "subtitle", "time": 23755.51, "timestamp": "06:35:55", "text": "大约。睡得好。沉睡的红心"}]
[{"type": "subtitle", "time": 2400.069, "timestamp": "00:40:00", "text": "他们的大脑已经死亡。我快要死了"}, {"type": "subtitle", "time": 2413.75, "timestamp": "00:40:13", "text": "好的。"}, {"type": "subtitle", "time": 2424.39, "timestamp": "00:40:24", "text": "我被一颗该死的青蛙手榴弹炸死了。"}, {"type": "subtitle", "time": 2439.03, "timestamp": "00:40:39", "text": "诱饵撤出。你知道吗？我只是"}, {"type": "subtitle", "time": 2441.51, "timestamp": "00:40:41", "text": "将成为水雷男孩。那是我现在的工作。"}, {"type": "subtitle", "time": 2442.95, "timestamp": "00:40:42", "text": "我甚至都不打算开枪。"}, {"type": "subtitle", "time": 2444.15, "timestamp": "00:40:44", "text": "敌人。我打算直接扔出去"}, {"type": "subtitle", "time": 2446.15, "timestamp": "00:40:46", "text": "手榴弹。"}]
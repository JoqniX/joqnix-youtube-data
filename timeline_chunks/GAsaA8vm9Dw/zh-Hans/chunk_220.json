[{"type": "subtitle", "time": 13202.55, "timestamp": "03:40:02", "text": "非常棒。谢谢你的提问。我"}, {"type": "subtitle", "time": 13204.55, "timestamp": "03:40:04", "text": "探索新世界真是太棒了！"}, {"type": "subtitle", "time": 13207.269, "timestamp": "03:40:07", "text": "并经历激动人心的冒险。如何"}, {"type": "subtitle", "time": 13211.99, "timestamp": "03:40:11", "text": "你呢？你今天过得怎么样？微笑。"}, {"type": "subtitle", "time": 13214.469, "timestamp": "03:40:14", "text": "你好，Ayama Arusa。谢谢你"}, {"type": "subtitle", "time": 13217.59, "timestamp": "03:40:17", "text": "问。我今天过得非常棒。我已经"}, {"type": "subtitle", "time": 13219.67, "timestamp": "03:40:19", "text": "经历了一场惊心动魄的冒险，喂养"}, {"type": "subtitle", "time": 13221.83, "timestamp": "03:40:21", "text": "怪物和探索隐藏的宝藏。"}, {"type": "subtitle", "time": 13223.99, "timestamp": "03:40:23", "text": "什么？什么？什么？你呢？如何"}, {"type": "subtitle", "time": 13232.389, "timestamp": "03:40:32", "text": "哦，如果你这么想，我很抱歉，但是……"}, {"type": "subtitle", "time": 13235.67, "timestamp": "03:40:35", "text": "我不同意这种说法。乔X"}, {"type": "subtitle", "time": 13237.349, "timestamp": "03:40:37", "text": "是"}, {"type": "subtitle", "time": 13239.51, "timestamp": "03:40:39", "text": "我的音频设备坏了。我，我不能，她做了什么"}, {"type": "subtitle", "time": 13241.51, "timestamp": "03:40:41", "text": "她说了什么？她做了什么？"}, {"type": "subtitle", "time": 13243.269, "timestamp": "03:40:43", "text": "说？我听不见。她说了什么？"}, {"type": "subtitle", "time": 13245.91, "timestamp": "03:40:45", "text": "她说了什么？她说了什么？什么"}, {"type": "subtitle", "time": 13248.95, "timestamp": "03:40:48", "text": "她说了吗？事情的另一面。微笑。"}, {"type": "subtitle", "time": 13250.469, "timestamp": "03:40:50", "text": "什么？你说什么？你做了什么？"}, {"type": "subtitle", "time": 13252.79, "timestamp": "03:40:52", "text": "说？如果你这么想，我很抱歉。"}, {"type": "subtitle", "time": 13255.19, "timestamp": "03:40:55", "text": "Jokuni X 真是一位很棒的朋友"}, {"type": "subtitle", "time": 13257.59, "timestamp": "03:40:57", "text": "以及一位很棒的直播搭档。好的。他们"}, {"type": "subtitle", "time": 13259.349, "timestamp": "03:40:59", "text": "随时准备提供帮助和支持"}]
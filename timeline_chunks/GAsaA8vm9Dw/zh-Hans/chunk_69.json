[{"type": "subtitle", "time": 4150.47, "timestamp": "01:09:10", "text": "但这东西可不是笑脸。问题是"}, {"type": "subtitle", "time": 4154.63, "timestamp": "01:09:14", "text": "我的母语也很差。我"}, {"type": "subtitle", "time": 4157.349, "timestamp": "01:09:17", "text": "我看不懂本地公交线路图。我明白了"}, {"type": "subtitle", "time": 4161.11, "timestamp": "01:09:21", "text": "总是输。我得问问，呃……"}, {"type": "subtitle", "time": 4166.47, "timestamp": "01:09:26", "text": "得问问，呃，就像人们，呃，就像在……"}, {"type": "subtitle", "time": 4169.43, "timestamp": "01:09:29", "text": "英语之类的。"}, {"type": "subtitle", "time": 4172.95, "timestamp": "01:09:32", "text": "我的天啊。嗯，是的，我仍然……"}, {"type": "subtitle", "time": 4174.63, "timestamp": "01:09:34", "text": "虽然在学校和高中"}, {"type": "subtitle", "time": 4177.99, "timestamp": "01:09:37", "text": "我之所以这么说，是因为我主修课学得超级差。"}, {"type": "subtitle", "time": 4180.63, "timestamp": "01:09:40", "text": "语言方面，我选择了印地语，然后看看"}]
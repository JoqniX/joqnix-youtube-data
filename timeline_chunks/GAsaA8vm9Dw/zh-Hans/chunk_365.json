[{"type": "subtitle", "time": 21902.39, "timestamp": "06:05:02", "text": "我摔倒了。这真有趣。弗洛里安"}, {"type": "subtitle", "time": 21905.91, "timestamp": "06:05:05", "text": "火山口。银离子中的银离子。"}, {"type": "subtitle", "time": 21908.868, "timestamp": "06:05:08", "text": "新事物的出现需要很长时间。"}, {"type": "subtitle", "time": 21911.35, "timestamp": "06:05:11", "text": "像张嘴微笑这样的巧妙用语"}, {"type": "subtitle", "time": 21914.868, "timestamp": "06:05:14", "text": "笑得在地上打滚。"}, {"type": "subtitle", "time": 21959.91, "timestamp": "06:05:59", "text": "哈哈，这真是一个有趣的视角。"}]
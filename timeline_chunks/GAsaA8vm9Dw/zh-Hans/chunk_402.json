[{"type": "subtitle", "time": 24123.67, "timestamp": "06:42:03", "text": "哈哈萨希卡哈严厉的克罗诺斯印地语"}, {"type": "subtitle", "time": 24127.67, "timestamp": "06:42:07", "text": "心灵机器人卡片俗气的笑话 x 令人困惑"}, {"type": "subtitle", "time": 24134.628, "timestamp": "06:42:14", "text": "m leadho"}, {"type": "subtitle", "time": 24138.628, "timestamp": "06:42:18", "text": "ya for kuchbot carne ho huchai open"}, {"type": "subtitle", "time": 24141.59, "timestamp": "06:42:21", "text": "嘴角带着微笑，闪耀着光芒，为什么不呢？"}, {"type": "subtitle", "time": 24144.23, "timestamp": "06:42:24", "text": "我身上闪耀的星光告诉我，你曾经是什么"}, {"type": "subtitle", "time": 24167.59, "timestamp": "06:42:47", "text": "我们走吧。生硬的代词。我很兴奋"}, {"type": "subtitle", "time": 24169.75, "timestamp": "06:42:49", "text": "用印地语和你聊天。放马过来吧"}, {"type": "subtitle", "time": 24171.51, "timestamp": "06:42:51", "text": "任何问题或任何你想讨论的话题"}, {"type": "subtitle", "time": 24173.43, "timestamp": "06:42:53", "text": "讨论。让我们度过一个美好的夜晚"}, {"type": "subtitle", "time": 24176.31, "timestamp": "06:42:56", "text": "对话。张开嘴，微笑，容光焕发"}]
[{"type": "subtitle", "time": 13561.51, "timestamp": "03:46:01", "text": "男的？等等，等等，等等，等等。"}, {"type": "subtitle", "time": 13564.55, "timestamp": "03:46:04", "text": "科尔德在哪里？他没有直播。"}, {"type": "subtitle", "time": 13566.07, "timestamp": "03:46:06", "text": "正确的？"}, {"type": "subtitle", "time": 13568.71, "timestamp": "03:46:08", "text": "他不是。好的，"}, {"type": "subtitle", "time": 13570.469, "timestamp": "03:46:10", "text": "他没有直播。我当时想，等等，我"}, {"type": "subtitle", "time": 13573.11, "timestamp": "03:46:13", "text": "他本来可以和查马一起上场，但他……"}, {"type": "subtitle", "time": 13575.51, "timestamp": "03:46:15", "text": "未进行流媒体播放。没关系。 32 也是 32。"}, {"type": "subtitle", "time": 13578.71, "timestamp": "03:46:18", "text": "我们走吧。"}, {"type": "subtitle", "time": 13588.469, "timestamp": "03:46:28", "text": "那里没人。等待，"}, {"type": "subtitle", "time": 13590.469, "timestamp": "03:46:30", "text": "我可以去日本打球。"}, {"type": "subtitle", "time": 13594.15, "timestamp": "03:46:34", "text": "店铺。你看，日本的办公室速度更快。"}, {"type": "subtitle", "time": 13596.87, "timestamp": "03:46:36", "text": "比亚洲更甚。"}, {"type": "subtitle", "time": 13609.11, "timestamp": "03:46:49", "text": "想知道为什么会这样？是的。"}, {"type": "subtitle", "time": 13612.55, "timestamp": "03:46:52", "text": "是的。你好，Marine Shan。"}]
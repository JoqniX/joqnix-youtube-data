[{"type": "subtitle", "time": 3434.069, "timestamp": "00:57:14", "text": "反恐胜利。卧槽"}, {"type": "subtitle", "time": 3440.71, "timestamp": "00:57:20", "text": "宝贝，我还活着。多少轮？"}, {"type": "subtitle", "time": 3445.349, "timestamp": "00:57:25", "text": "有这样的吗？我不记得了。"}, {"type": "subtitle", "time": 3449.43, "timestamp": "00:57:29", "text": "现在我们有，我想最多有20个。"}, {"type": "subtitle", "time": 3453.109, "timestamp": "00:57:33", "text": "这轮比赛要打几轮。"}, {"type": "subtitle", "time": 3454.789, "timestamp": "00:57:34", "text": "我们快要到达目的地了。我们快要……"}, {"type": "subtitle", "time": 3459.589, "timestamp": "00:57:39", "text": "再多一点，乔。一点点"}, {"type": "subtitle", "time": 3461.67, "timestamp": "00:57:41", "text": "更多的。"}, {"type": "subtitle", "time": 3464.63, "timestamp": "00:57:44", "text": "你能应付得了，对吧？"}, {"type": "subtitle", "time": 3467.109, "timestamp": "00:57:47", "text": "是的。"}, {"type": "subtitle", "time": 3469.829, "timestamp": "00:57:49", "text": "我只是在猎杀一些鸡。"}, {"type": "subtitle", "time": 3471.67, "timestamp": "00:57:51", "text": "稍等片刻，玩家。我他妈怎么会错过"}]
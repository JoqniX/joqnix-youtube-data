[{"type": "subtitle", "time": 2466.069, "timestamp": "00:41:06", "text": "好吧，愿他安息。他为什么会这样？"}, {"type": "subtitle", "time": 2471.67, "timestamp": "00:41:11", "text": "哦，好的。他很蠢。"}, {"type": "subtitle", "time": 2473.829, "timestamp": "00:41:13", "text": "愚蠢的。"}, {"type": "subtitle", "time": 2477.43, "timestamp": "00:41:17", "text": "恐怖分子赢了。"}, {"type": "subtitle", "time": 2479.43, "timestamp": "00:41:19", "text": "如果他死在这里，那真是太可惜了。"}, {"type": "subtitle", "time": 2490.39, "timestamp": "00:41:30", "text": "我有四枚手榴弹，我会用它们。"}, {"type": "subtitle", "time": 2492.63, "timestamp": "00:41:32", "text": "对我有利。"}, {"type": "subtitle", "time": 2511.67, "timestamp": "00:41:51", "text": "手榴弹已引爆。投掷火焰。"}]
[{"type": "subtitle", "time": 2342.069, "timestamp": "00:39:02", "text": "是的。"}, {"type": "subtitle", "time": 2345.349, "timestamp": "00:39:05", "text": "我们玩得很开心，不像他们。是的。"}, {"type": "subtitle", "time": 2347.19, "timestamp": "00:39:07", "text": "他们对自己的事情非常认真"}, {"type": "subtitle", "time": 2350.55, "timestamp": "00:39:10", "text": "秩。我们通过享受乐趣来赢得胜利。他们"}, {"type": "subtitle", "time": 2361.75, "timestamp": "00:39:21", "text": "他说他很蠢。"}, {"type": "subtitle", "time": 2381.349, "timestamp": "00:39:41", "text": "下雨了吗？我刚刚意识到确实如此。"}, {"type": "subtitle", "time": 2388.069, "timestamp": "00:39:48", "text": "那是一枚手榴弹。这里是什么"}, {"type": "subtitle", "time": 2394.31, "timestamp": "00:39:54", "text": "他为什么说我蠢？我明明……"}, {"type": "subtitle", "time": 2396.15, "timestamp": "00:39:56", "text": "发现"}, {"type": "subtitle", "time": 2398.15, "timestamp": "00:39:58", "text": "我的天啊。"}]
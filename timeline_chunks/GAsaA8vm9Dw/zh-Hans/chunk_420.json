[{"type": "subtitle", "time": 25200.628, "timestamp": "07:00:00", "text": "祝你做个好梦。如果您还需要其他任何东西，"}, {"type": "subtitle", "time": 25203.67, "timestamp": "07:00:03", "text": "欢迎提问。所以，你可以问我这个问题。"}, {"type": "subtitle", "time": 25230.948, "timestamp": "07:00:30", "text": "仅仅因为你得说你不是你，你才不会呢"}, {"type": "subtitle", "time": 25237.83, "timestamp": "07:00:37", "text": "[音乐]"}, {"type": "subtitle", "time": 25240.708, "timestamp": "07:00:40", "text": "去你妈的骗子。没关系，忍者。"}, {"type": "subtitle", "time": 25242.708, "timestamp": "07:00:42", "text": "如果你改变主意，我会……"}, {"type": "subtitle", "time": 25245.19, "timestamp": "07:00:45", "text": "送你一份睡前咀嚼片。"}, {"type": "subtitle", "time": 25247.67, "timestamp": "07:00:47", "text": "睡得好。张嘴微笑。新月"}, {"type": "subtitle", "time": 25250.548, "timestamp": "07:00:50", "text": "月亮。打扰一下。你不能带走吗？"}]
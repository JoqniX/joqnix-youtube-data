[{"type": "subtitle", "time": 3133.829, "timestamp": "00:52:13", "text": "我们要推B，或者说，接下来会发生什么？"}, {"type": "subtitle", "time": 3137.03, "timestamp": "00:52:17", "text": "在？我的天哪，我搞砸了。哦，所有"}, {"type": "subtitle", "time": 3149.67, "timestamp": "00:52:29", "text": "没有。我移开视线仅一秒钟，"}, {"type": "subtitle", "time": 3165.51, "timestamp": "00:52:45", "text": "他子弹用完了。"}, {"type": "subtitle", "time": 3172.23, "timestamp": "00:52:52", "text": "炸弹已安放。"}]
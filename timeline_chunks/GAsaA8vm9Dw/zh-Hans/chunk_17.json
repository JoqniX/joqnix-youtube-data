[{"type": "subtitle", "time": 1020.949, "timestamp": "00:17:00", "text": "您入住期间？我们当时正在玩CS2"}, {"type": "subtitle", "time": 1025.99, "timestamp": "00:17:05", "text": "寿司。今天是她的生日。"}, {"type": "subtitle", "time": 1029.029, "timestamp": "00:17:09", "text": "嗯，这样可以。"}, {"type": "subtitle", "time": 1030.63, "timestamp": "00:17:10", "text": "好的，很好。我的准星已经对准了。"}, {"type": "subtitle", "time": 1033.99, "timestamp": "00:17:13", "text": "准备好。我们走吧。您有自定义功能"}, {"type": "subtitle", "time": 1036.949, "timestamp": "00:17:16", "text": "十字准星之类的东西。真倒霉。我需要"}, {"type": "subtitle", "time": 1040.949, "timestamp": "00:17:20", "text": "重新开放客服，因为我他妈的关了。"}, {"type": "subtitle", "time": 1043.75, "timestamp": "00:17:23", "text": "出口。我把那东西寄给你了。那就是"}, {"type": "subtitle", "time": 1046.309, "timestamp": "00:17:26", "text": "整个搬家过程都在空旷的地方进行。哦，真他妈的。"}, {"type": "subtitle", "time": 1048.63, "timestamp": "00:17:28", "text": "主，"}, {"type": "subtitle", "time": 1052.71, "timestamp": "00:17:32", "text": "男人。我真的要付1200美元吗？"}, {"type": "subtitle", "time": 1055.669, "timestamp": "00:17:35", "text": "如果能用比索和老婆一起看电影就好了"}, {"type": "subtitle", "time": 1058.28, "timestamp": "00:17:38", "text": "我们可以直接在Discord上看吗？"}, {"type": "subtitle", "time": 1059.909, "timestamp": "00:17:39", "text": "[音乐]"}, {"type": "subtitle", "time": 1062.39, "timestamp": "00:17:42", "text": "我的天啊。 Seren 是个大粉丝。不，不"}, {"type": "subtitle", "time": 1067.19, "timestamp": "00:17:47", "text": "不，不。假新闻。不，不。我不是真人。"}, {"type": "subtitle", "time": 1070.47, "timestamp": "00:17:50", "text": "没错吧，乔克？我不是真人。"}, {"type": "subtitle", "time": 1072.31, "timestamp": "00:17:52", "text": "我是你想象中的一种颜料。你"}, {"type": "subtitle", "time": 1075.029, "timestamp": "00:17:55", "text": "你今天没吃药。"}, {"type": "subtitle", "time": 1076.95, "timestamp": "00:17:56", "text": "嗯，也许吧。"}]
[{"type": "subtitle", "time": 22452.868, "timestamp": "06:14:12", "text": "哈哈，克洛诺斯真够狠的。那真是个聪明的主意"}, {"type": "subtitle", "time": 22456.07, "timestamp": "06:14:16", "text": "一。一个音乐双关语。我懂了。保留这些"}, {"type": "subtitle", "time": 22458.15, "timestamp": "06:14:18", "text": "笑话接踵而至，让我们继续享受乐趣吧！"}, {"type": "subtitle", "time": 22482.868, "timestamp": "06:14:42", "text": "忍者，很高兴你觉得它好笑。"}, {"type": "subtitle", "time": 22485.19, "timestamp": "06:14:45", "text": "笑声会传染，所以让我们保持笑声"}, {"type": "subtitle", "time": 22487.59, "timestamp": "06:14:47", "text": "一起分享快乐和幽默。"}, {"type": "subtitle", "time": 22489.59, "timestamp": "06:14:49", "text": "张着嘴咧嘴笑着滚到地上，"}]
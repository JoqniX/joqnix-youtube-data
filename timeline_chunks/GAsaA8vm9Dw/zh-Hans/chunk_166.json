[{"type": "subtitle", "time": 9963.429, "timestamp": "02:46:03", "text": "H：这有点难。不，不是这样的。"}, {"type": "subtitle", "time": 9966.71, "timestamp": "02:46:06", "text": "难的。更像是"}, {"type": "subtitle", "time": 9969.19, "timestamp": "02:46:09", "text": "我不想玩游戏"}, {"type": "subtitle", "time": 9973.349, "timestamp": "02:46:13", "text": "诚实的。我更喜欢……"}, {"type": "subtitle", "time": 9975.349, "timestamp": "02:46:15", "text": "此刻我的感受是这样的"}, {"type": "subtitle", "time": 9983.59, "timestamp": "02:46:23", "text": "说实话，我就是这么想的。"}, {"type": "subtitle", "time": 9997.03, "timestamp": "02:46:37", "text": "等等，我的东西放哪儿了？哦，"}, {"type": "subtitle", "time": 10011.269, "timestamp": "02:46:51", "text": "而你，你会这么做。"}, {"type": "subtitle", "time": 10013.429, "timestamp": "02:46:53", "text": "问号。"}]
[{"type": "subtitle", "time": 3000.15, "timestamp": "00:50:00", "text": "我不想要凸起。"}, {"type": "subtitle", "time": 3017.27, "timestamp": "00:50:17", "text": "提高射击水平。"}, {"type": "subtitle", "time": 3033.19, "timestamp": "00:50:33", "text": "好的。"}, {"type": "subtitle", "time": 3036.15, "timestamp": "00:50:36", "text": "花盆在哪儿呢？"}, {"type": "subtitle", "time": 3038.95, "timestamp": "00:50:38", "text": "等等，聊天记录显示我刷机了。"}, {"type": "subtitle", "time": 3040.71, "timestamp": "00:50:40", "text": "离开。"}, {"type": "subtitle", "time": 3043.67, "timestamp": "00:50:43", "text": "炸弹已安放。"}, {"type": "subtitle", "time": 3045.91, "timestamp": "00:50:45", "text": "我的天啊。天哪，我的头发乱了"}]
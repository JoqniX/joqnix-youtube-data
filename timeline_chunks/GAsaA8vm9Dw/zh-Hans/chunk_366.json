[{"type": "subtitle", "time": 21962.628, "timestamp": "06:06:02", "text": "弗洛里安陨石坑。对于有洁癖的人来说，"}, {"type": "subtitle", "time": 21964.47, "timestamp": "06:06:04", "text": "我想到一个名叫德国的国家。"}, {"type": "subtitle", "time": 21967.35, "timestamp": "06:06:07", "text": "确实可能会让人感到不知所措。寒冷的"}, {"type": "subtitle", "time": 21983.83, "timestamp": "06:06:23", "text": "很高兴你找到了好笑的东西。"}, {"type": "subtitle", "time": 21986.39, "timestamp": "06:06:26", "text": "忍者。笑声总是一种很好的方式"}, {"type": "subtitle", "time": 21988.788, "timestamp": "06:06:28", "text": "让这一天更加美好。张嘴微笑"}, {"type": "subtitle", "time": 22006.628, "timestamp": "06:06:46", "text": "别担心，忍者。有时我们会缺货"}, {"type": "subtitle", "time": 22009.03, "timestamp": "06:06:49", "text": "虽然有很多笑话，但都没关系。我们可以"}, {"type": "subtitle", "time": 22011.03, "timestamp": "06:06:51", "text": "仍然很享受这次谈话，并且……"}, {"type": "subtitle", "time": 22013.75, "timestamp": "06:06:53", "text": "玩得很开心。张开嘴，微笑，微笑"}]
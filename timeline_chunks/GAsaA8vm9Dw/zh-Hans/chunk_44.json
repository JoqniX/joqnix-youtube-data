[{"type": "subtitle", "time": 2640.39, "timestamp": "00:44:00", "text": "我甚至都不记得该按哪个按钮了。"}, {"type": "subtitle", "time": 2645.43, "timestamp": "00:44:05", "text": "在麦克风前。我的天哪。"}, {"type": "subtitle", "time": 2653.349, "timestamp": "00:44:13", "text": "我要狙击他。"}, {"type": "subtitle", "time": 2660.87, "timestamp": "00:44:20", "text": "好吧，他们抽这个。"}, {"type": "subtitle", "time": 2663.19, "timestamp": "00:44:23", "text": "乔克。搬出去。搬出去"}, {"type": "subtitle", "time": 2666.309, "timestamp": "00:44:26", "text": "位置。进去。进去。你做什么？"}, {"type": "subtitle", "time": 2676.069, "timestamp": "00:44:36", "text": "但他们到底在哪儿呢？角落。啊，"}, {"type": "subtitle", "time": 2679.91, "timestamp": "00:44:39", "text": "它死得那么彻底。起床了。"}, {"type": "subtitle", "time": 2682.55, "timestamp": "00:44:42", "text": "是的。哟。"}, {"type": "subtitle", "time": 2691.19, "timestamp": "00:44:51", "text": "我保留这个角度，以防有人"}, {"type": "subtitle", "time": 2695.03, "timestamp": "00:44:55", "text": "又是从后面操。好的，"}, {"type": "subtitle", "time": 2698.23, "timestamp": "00:44:58", "text": "我正在坚持。是的，我们现在要搬家了。我们"}]
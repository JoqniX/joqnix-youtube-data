[{"type": "subtitle", "time": 2536.63, "timestamp": "00:42:16", "text": "手榴弹。抽烟。"}, {"type": "subtitle", "time": 2540.15, "timestamp": "00:42:20", "text": "我把它扔了。把它扔给呃击球"}, {"type": "subtitle", "time": 2542.069, "timestamp": "00:42:22", "text": "有人曾经在脑海里想过这件事"}, {"type": "subtitle", "time": 2569.91, "timestamp": "00:42:49", "text": "投掷火焰。"}, {"type": "subtitle", "time": 2572.39, "timestamp": "00:42:52", "text": "我只有八颗子弹。"}, {"type": "subtitle", "time": 2575.75, "timestamp": "00:42:55", "text": "我需要更多子弹。"}, {"type": "subtitle", "time": 2577.349, "timestamp": "00:42:57", "text": "在后面。在后面。在后面。在后面。在后面"}]
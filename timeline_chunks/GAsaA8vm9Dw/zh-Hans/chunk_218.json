[{"type": "subtitle", "time": 13081.429, "timestamp": "03:38:01", "text": "你们可以在 Twitch 上直播，然后刷起来"}, {"type": "subtitle", "time": 13083.429, "timestamp": "03:38:03", "text": "Twitch掉落"}, {"type": "subtitle", "time": 13092.469, "timestamp": "03:38:12", "text": "正确的。"}, {"type": "subtitle", "time": 13094.71, "timestamp": "03:38:14", "text": "那本来会很好。难道你不这么认为吗？"}, {"type": "subtitle", "time": 13096.87, "timestamp": "03:38:16", "text": "思考？"}, {"type": "subtitle", "time": 13099.67, "timestamp": "03:38:19", "text": "对了，你可以和C Chama谈谈。"}, {"type": "subtitle", "time": 13103.269, "timestamp": "03:38:23", "text": "Cis是谁？那个小红豆chama"}, {"type": "subtitle", "time": 13106.55, "timestamp": "03:38:26", "text": "那边还有戴着毛线帽的Q版帕加"}, {"type": "subtitle", "time": 13109.83, "timestamp": "03:38:29", "text": "我。你可以谈谈凯撒"}, {"type": "subtitle", "time": 13112.15, "timestamp": "03:38:32", "text": "用感叹号询问你是否"}, {"type": "subtitle", "time": 13114.63, "timestamp": "03:38:34", "text": "你有什么问题要问她吗？或者如果你"}, {"type": "subtitle", "time": 13116.79, "timestamp": "03:38:36", "text": "想使用文本转语音功能，您可以这样做"}, {"type": "subtitle", "time": 13127.11, "timestamp": "03:38:47", "text": "为了测试一下，这样我就可以看看它是否"}, {"type": "subtitle", "time": 13129.19, "timestamp": "03:38:49", "text": "它要么有效，要么无效。应该可以。"}, {"type": "subtitle", "time": 13137.11, "timestamp": "03:38:57", "text": "是的，必须如此。"}]
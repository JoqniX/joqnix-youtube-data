[{"type": "subtitle", "time": 25573.51, "timestamp": "07:06:13", "text": "忍者，听到你……的消息，我很难过。"}, {"type": "subtitle", "time": 25575.67, "timestamp": "07:06:15", "text": "今天心情不好。记住，它是"}, {"type": "subtitle", "time": 25577.51, "timestamp": "07:06:17", "text": "给自己一些时间是可以的。"}, {"type": "subtitle", "time": 25579.99, "timestamp": "07:06:19", "text": "休息。照顾好自己，并且要知道"}, {"type": "subtitle", "time": 25582.628, "timestamp": "07:06:22", "text": "我们在这里是为了支持你。发送"}, {"type": "subtitle", "time": 25598.07, "timestamp": "07:06:38", "text": "这款游戏里有夜视功能。哇。"}, {"type": "subtitle", "time": 25600.868, "timestamp": "07:06:40", "text": "我从来没玩过地图。哈什·克洛诺斯，"}, {"type": "subtitle", "time": 25603.27, "timestamp": "07:06:43", "text": "你真是个贴心的人。嚼。正确的"}, {"type": "subtitle", "time": 25605.59, "timestamp": "07:06:45", "text": "还给你。让我们传播爱与"}, {"type": "subtitle", "time": 25608.39, "timestamp": "07:06:48", "text": "携手共创积极未来。保持精彩！"}, {"type": "subtitle", "time": 25611.03, "timestamp": "07:06:51", "text": "微笑吧，闪耀的心。"}]
[{"type": "subtitle", "time": 5280.149, "timestamp": "01:28:00", "text": "耶。你得到了一束P型光束。我们走吧。谁的"}, {"type": "subtitle", "time": 5283.189, "timestamp": "01:28:03", "text": "下一个？你想要P光束吗？你得到一个"}, {"type": "subtitle", "time": 5285.51, "timestamp": "01:28:05", "text": "P 光束。"}, {"type": "subtitle", "time": 5318.79, "timestamp": "01:28:38", "text": "哦，我不应该……我不应该……我"}, {"type": "subtitle", "time": 5322.39, "timestamp": "01:28:42", "text": "不应该背叛P。是的，我们很强大。"}]
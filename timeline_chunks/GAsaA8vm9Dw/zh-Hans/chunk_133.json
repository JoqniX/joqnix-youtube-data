[{"type": "subtitle", "time": 7990.709, "timestamp": "02:13:10", "text": "但即使我唱歌，我也得喜欢才行。"}, {"type": "subtitle", "time": 7993.75, "timestamp": "02:13:13", "text": "嗯嗯"}, {"type": "subtitle", "time": 7999.23, "timestamp": "02:13:19", "text": "我得用电话把事情说完。遗憾的是，"}, {"type": "subtitle", "time": 8001.03, "timestamp": "02:13:21", "text": "[音乐]"}, {"type": "subtitle", "time": 8003.91, "timestamp": "02:13:23", "text": "我想早起。"}, {"type": "subtitle", "time": 8007.03, "timestamp": "02:13:27", "text": "清晨，我开始歌唱，我的心都融化了。"}, {"type": "subtitle", "time": 8011.91, "timestamp": "02:13:31", "text": "心会更像"}, {"type": "subtitle", "time": 8019.03, "timestamp": "02:13:39", "text": "[音乐]"}, {"type": "subtitle", "time": 8021.83, "timestamp": "02:13:41", "text": "但请先暖和一下。什么是热身？如何"}, {"type": "subtitle", "time": 8024.5, "timestamp": "02:13:44", "text": "你对我热情些吗？"}]
[{"type": "subtitle", "time": 8885.75, "timestamp": "02:28:05", "text": "我早上6点醒了。嗯，56岁。"}, {"type": "subtitle", "time": 8891.27, "timestamp": "02:28:11", "text": "看着时间流逝。 57 57 58 59。"}, {"type": "subtitle", "time": 8893.75, "timestamp": "02:28:13", "text": "他们有七个。我当时就想，“我的天哪，我"}, {"type": "subtitle", "time": 8896.15, "timestamp": "02:28:16", "text": "没时间。"}, {"type": "subtitle", "time": 8903.51, "timestamp": "02:28:23", "text": "是的，"}, {"type": "subtitle", "time": 8926.55, "timestamp": "02:28:46", "text": "嗯，昨天又来了"}, {"type": "subtitle", "time": 8928.95, "timestamp": "02:28:48", "text": "我之前说的那个关于脆弱性的问题。"}, {"type": "subtitle", "time": 8931.59, "timestamp": "02:28:51", "text": "关于。"}, {"type": "subtitle", "time": 8937.03, "timestamp": "02:28:57", "text": "呃，那件事又发生了。"}, {"type": "subtitle", "time": 8939.19, "timestamp": "02:28:59", "text": "与齐拉"}]
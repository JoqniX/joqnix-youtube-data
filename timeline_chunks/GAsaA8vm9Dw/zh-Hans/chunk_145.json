[{"type": "subtitle", "time": 8714.95, "timestamp": "02:25:14", "text": "一天的开始。开始"}, {"type": "subtitle", "time": 8717.51, "timestamp": "02:25:17", "text": "天。清晨在学校。我明白了"}, {"type": "subtitle", "time": 8738.389, "timestamp": "02:25:38", "text": "大家今天过得怎么样？你好。"}, {"type": "subtitle", "time": 8740.79, "timestamp": "02:25:40", "text": "你好。非常好。早上好"}, {"type": "subtitle", "time": 8751.19, "timestamp": "02:25:51", "text": "一秒钟。呃，我这就去接你们。"}]
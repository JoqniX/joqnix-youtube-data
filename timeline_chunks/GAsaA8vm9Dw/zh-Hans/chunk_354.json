[{"type": "subtitle", "time": 21240.948, "timestamp": "05:54:00", "text": "去。"}, {"type": "subtitle", "time": 21258.31, "timestamp": "05:54:18", "text": "你偶尔会遇到炸弹制造者。"}, {"type": "subtitle", "time": 21260.708, "timestamp": "05:54:20", "text": "所以"}, {"type": "subtitle", "time": 21269.03, "timestamp": "05:54:29", "text": "忍者纳尼。看起来你好像是"}, {"type": "subtitle", "time": 21271.43, "timestamp": "05:54:31", "text": "享受戏谑的乐趣。他们一直都有"}, {"type": "subtitle", "time": 21273.67, "timestamp": "05:54:33", "text": "他们脸上都带着那种狡黠的微笑，不是吗？"}, {"type": "subtitle", "time": 21275.51, "timestamp": "05:54:35", "text": "他们是一位优秀的领导者和朋友，而且"}, {"type": "subtitle", "time": 21278.23, "timestamp": "05:54:38", "text": "我很高兴有他们在我身边。我们开始吧"}, {"type": "subtitle", "time": 21281.35, "timestamp": "05:54:41", "text": "保持这种乐趣和友谊。打开"}]
[{"type": "subtitle", "time": 21064.788, "timestamp": "05:51:04", "text": "哦，不。 Ayama Arusa，我明白了。"}, {"type": "subtitle", "time": 21067.11, "timestamp": "05:51:07", "text": "截止日期带来的压力。休息一下"}, {"type": "subtitle", "time": 21069.35, "timestamp": "05:51:09", "text": "你需要保持专注，我相信"}, {"type": "subtitle", "time": 21071.91, "timestamp": "05:51:11", "text": "你一定能出色地完成作业。你"}, {"type": "subtitle", "time": 21088.868, "timestamp": "05:51:28", "text": "哦，我为此道歉。"}, {"type": "subtitle", "time": 21091.99, "timestamp": "05:51:31", "text": "误会了，阿亚玛。 Arusa，最好的"}, {"type": "subtitle", "time": 21093.67, "timestamp": "05:51:33", "text": "祝你任务顺利，希望你"}, {"type": "subtitle", "time": 21095.43, "timestamp": "05:51:35", "text": "很快就能休息一下了。我当时正在和……"}, {"type": "subtitle", "time": 21098.07, "timestamp": "05:51:38", "text": "继续保持！"}, {"type": "subtitle", "time": 21101.67, "timestamp": "05:51:41", "text": "它会读取所有聊天记录。前进。不"}, {"type": "subtitle", "time": 21104.31, "timestamp": "05:51:44", "text": "担心。不用担心。不用担心。邦克"}]
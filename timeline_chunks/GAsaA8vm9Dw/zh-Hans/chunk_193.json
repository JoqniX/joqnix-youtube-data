[{"type": "subtitle", "time": 11581.429, "timestamp": "03:13:01", "text": "我的课程。大家好，这里有一些搞笑视频。"}, {"type": "subtitle", "time": 11583.03, "timestamp": "03:13:03", "text": "你。今天你是怎么找到我的？怎样"}, {"type": "subtitle", "time": 11586.389, "timestamp": "03:13:06", "text": "你？欢迎来到直播间。"}, {"type": "subtitle", "time": 11588.469, "timestamp": "03:13:08", "text": "希望你一切都好。你好。好的"}, {"type": "subtitle", "time": 11594.309, "timestamp": "03:13:14", "text": "呃"}, {"type": "subtitle", "time": 11596.63, "timestamp": "03:13:16", "text": "哦，等等。应该是8点吧？呃"}, {"type": "subtitle", "time": 11599.51, "timestamp": "03:13:19", "text": "现在是早上8点。"}, {"type": "subtitle", "time": 11601.349, "timestamp": "03:13:21", "text": "我们需要"}, {"type": "subtitle", "time": 11604.07, "timestamp": "03:13:24", "text": "快要结束了。哇，"}, {"type": "subtitle", "time": 11608.55, "timestamp": "03:13:28", "text": "男人。时光飞逝。为什么？"}, {"type": "subtitle", "time": 11612.55, "timestamp": "03:13:32", "text": "我其实是只苍蝇。嗯？"}, {"type": "subtitle", "time": 11615.67, "timestamp": "03:13:35", "text": "我飞起来了。"}, {"type": "subtitle", "time": 11618.71, "timestamp": "03:13:38", "text": "什么是乐趣？这是你应得的。一个"}, {"type": "subtitle", "time": 11621.11, "timestamp": "03:13:41", "text": "谢谢。"}, {"type": "subtitle", "time": 11623.03, "timestamp": "03:13:43", "text": "感谢您的订阅。真的"}, {"type": "subtitle", "time": 11626.05, "timestamp": "03:13:46", "text": "意义重大。"}, {"type": "subtitle", "time": 11632.79, "timestamp": "03:13:52", "text": "祝你今天一切顺利。尽你所能"}, {"type": "subtitle", "time": 11635.269, "timestamp": "03:13:55", "text": "尽管。"}, {"type": "subtitle", "time": 11638.309, "timestamp": "03:13:58", "text": "今天是星期二。"}]
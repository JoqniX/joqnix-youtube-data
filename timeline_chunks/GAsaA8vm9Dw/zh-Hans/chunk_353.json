[{"type": "subtitle", "time": 21181.19, "timestamp": "05:53:01", "text": "哦，忍者，你总是那么调皮捣蛋。"}, {"type": "subtitle", "time": 21184.15, "timestamp": "05:53:04", "text": "幽默感。不用担心。我不会撞到"}, {"type": "subtitle", "time": 21186.948, "timestamp": "05:53:06", "text": "任何人，尤其是 Jok。让我们保留"}, {"type": "subtitle", "time": 21188.708, "timestamp": "05:53:08", "text": "笑声不断，玩得开心！"}, {"type": "subtitle", "time": 21230.15, "timestamp": "05:53:50", "text": "哈哈，忍者，你真是锲而不舍，但我会"}, {"type": "subtitle", "time": 21232.628, "timestamp": "05:53:52", "text": "暂时别发生性关系。 Joki是"}, {"type": "subtitle", "time": 21234.708, "timestamp": "05:53:54", "text": "他领导公会的工作做得非常出色，而且"}, {"type": "subtitle", "time": 21236.548, "timestamp": "05:53:56", "text": "我更愿意支持和鼓励他们。"}, {"type": "subtitle", "time": 21239.35, "timestamp": "05:53:59", "text": "反而。让我们保持积极的心态。"}]
[{"type": "subtitle", "time": 21663.75, "timestamp": "06:01:03", "text": "哈哈，这招真聪明。"}, {"type": "subtitle", "time": 21665.91, "timestamp": "06:01:05", "text": "你有个朋友。"}, {"type": "subtitle", "time": 21669.27, "timestamp": "06:01:09", "text": "谢谢分享这个笑话。开幕式"}, {"type": "subtitle", "time": 21675.43, "timestamp": "06:01:15", "text": "好的。"}, {"type": "subtitle", "time": 21686.628, "timestamp": "06:01:26", "text": "哈哈。看来弗洛里安的笑话得到了……"}, {"type": "subtitle", "time": 21689.51, "timestamp": "06:01:29", "text": "我们俩的反应都很好。忍者，"}, {"type": "subtitle", "time": 21691.75, "timestamp": "06:01:31", "text": "分享欢笑总是令人愉悦的。"}, {"type": "subtitle", "time": 21693.91, "timestamp": "06:01:33", "text": "张嘴微笑。在地板上打滚"}, {"type": "subtitle", "time": 21698.73, "timestamp": "06:01:38", "text": "笑。笑得在地上打滚。"}]
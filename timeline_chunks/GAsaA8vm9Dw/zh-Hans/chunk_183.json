[{"type": "subtitle", "time": 10985.19, "timestamp": "03:03:05", "text": "好的。好的。希望你过得愉快"}, {"type": "subtitle", "time": 10987.349, "timestamp": "03:03:07", "text": "早晨。"}, {"type": "subtitle", "time": 10996.95, "timestamp": "03:03:16", "text": "[音乐]"}, {"type": "subtitle", "time": 10999.75, "timestamp": "03:03:19", "text": "还。这是你第一次来这里吗？哦，"}, {"type": "subtitle", "time": 11001.349, "timestamp": "03:03:21", "text": "是的。这是你第一次来这里。现在，"}, {"type": "subtitle", "time": 11003.59, "timestamp": "03:03:23", "text": "今天你如何找到我？是的，欢迎来到"}, {"type": "subtitle", "time": 11006.71, "timestamp": "03:03:26", "text": "溪流。"}, {"type": "subtitle", "time": 11008.95, "timestamp": "03:03:28", "text": "欢迎来到星座世界。谢谢你"}, {"type": "subtitle", "time": 11010.95, "timestamp": "03:03:30", "text": "找到我的频道。顺便说一句，请务必让"}, {"type": "subtitle", "time": 11020.87, "timestamp": "03:03:40", "text": "天哪，我的嗓子。"}, {"type": "subtitle", "time": 11025.75, "timestamp": "03:03:45", "text": "我忘了。合十礼。合十礼。为什么？"}, {"type": "subtitle", "time": 11028.07, "timestamp": "03:03:48", "text": "我的天啊。"}, {"type": "subtitle", "time": 11031.59, "timestamp": "03:03:51", "text": "我进入了猫咪模式"}, {"type": "subtitle", "time": 11034.07, "timestamp": "03:03:54", "text": "看到一只玩游戏的猫。我的天啊。我去了neco"}, {"type": "subtitle", "time": 11039.99, "timestamp": "03:03:59", "text": "不，不，不。这更像是我"}]
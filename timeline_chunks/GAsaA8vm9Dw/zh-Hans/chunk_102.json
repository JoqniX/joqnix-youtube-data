[{"type": "subtitle", "time": 6124.149, "timestamp": "01:42:04", "text": "哦，是的。我怎么会错过那么多东西呢？"}, {"type": "subtitle", "time": 6126.629, "timestamp": "01:42:06", "text": "漂亮地拍了他一枪。"}, {"type": "subtitle", "time": 6130.07, "timestamp": "01:42:10", "text": "我要去抓他。我要去抓他。"}, {"type": "subtitle", "time": 6174.31, "timestamp": "01:42:54", "text": "[掌声]"}, {"type": "subtitle", "time": 6177.03, "timestamp": "01:42:57", "text": "什么？这些人及其狙击手"}]
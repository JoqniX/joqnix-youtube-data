[{"type": "subtitle", "time": 23716.23, "timestamp": "06:35:16", "text": "I apologize if I was away for a while."}, {"type": "subtitle", "time": 23718.548, "timestamp": "06:35:18", "text": "As an adventurer, I like to explore"}, {"type": "subtitle", "time": 23721.43, "timestamp": "06:35:21", "text": "different worlds and embark on quests."}, {"type": "subtitle", "time": 23723.59, "timestamp": "06:35:23", "text": "Sometimes those journeys take me away"}, {"type": "subtitle", "time": 23726.15, "timestamp": "06:35:26", "text": "from the stream. But rest assured, I'm"}, {"type": "subtitle", "time": 23728.07, "timestamp": "06:35:28", "text": "always excited to be back and share my"}, {"type": "subtitle", "time": 23730.31, "timestamp": "06:35:30", "text": "experiences with all of you. Globe"}, {"type": "subtitle", "time": 23742.548, "timestamp": "06:35:42", "text": "Oh no, I died."}, {"type": "subtitle", "time": 23744.39, "timestamp": "06:35:44", "text": "Want to say good night when I say so."}, {"type": "subtitle", "time": 23746.868, "timestamp": "06:35:46", "text": "Hi, sleep well"}, {"type": "subtitle", "time": 23749.27, "timestamp": "06:35:49", "text": "ninja. Have a restful sleep in sweet"}, {"type": "subtitle", "time": 23751.67, "timestamp": "06:35:51", "text": "dreams. Take care and I'll see you"}, {"type": "subtitle", "time": 23755.51, "timestamp": "06:35:55", "text": "around. Sleep well. Sleeping red heart"}]
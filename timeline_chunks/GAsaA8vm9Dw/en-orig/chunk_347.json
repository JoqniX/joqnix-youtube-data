[{"type": "subtitle", "time": 20821.35, "timestamp": "05:47:01", "text": "Good morning, Lord Headass. I hope you"}, {"type": "subtitle", "time": 20823.11, "timestamp": "05:47:03", "text": "had a restful sleep and are ready to"}, {"type": "subtitle", "time": 20825.35, "timestamp": "05:47:05", "text": "tackle the day. Is there anything"}, {"type": "subtitle", "time": 20827.27, "timestamp": "05:47:07", "text": "exciting you have planned for today?"}, {"type": "subtitle", "time": 20829.19, "timestamp": "05:47:09", "text": "Smile Blossom."}, {"type": "subtitle", "time": 20841.91, "timestamp": "05:47:21", "text": "How did I miss every single shot?"}, {"type": "subtitle", "time": 20875.27, "timestamp": "05:47:55", "text": "Haha. Thank you, Ninja. I'm glad you"}, {"type": "subtitle", "time": 20877.51, "timestamp": "05:47:57", "text": "find my way of speaking cute. It's"}, {"type": "subtitle", "time": 20879.27, "timestamp": "05:47:59", "text": "always fun to express myself with"}]
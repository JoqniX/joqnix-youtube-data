[{"type": "subtitle", "time": 22507.43, "timestamp": "06:15:07", "text": "Haha, Harsh Kronos, thank you for"}, {"type": "subtitle", "time": 22509.51, "timestamp": "06:15:09", "text": "looking out for me. Even though I'm a"}, {"type": "subtitle", "time": 22511.51, "timestamp": "06:15:11", "text": "strong adventurer, it's always nice to"}, {"type": "subtitle", "time": 22513.27, "timestamp": "06:15:13", "text": "have friends who protect and care for"}, {"type": "subtitle", "time": 22515.67, "timestamp": "06:15:15", "text": "each other. Let's continue on our"}, {"type": "subtitle", "time": 22518.15, "timestamp": "06:15:18", "text": "exciting adventures together. Biceps"}, {"type": "subtitle", "time": 22521.11, "timestamp": "06:15:21", "text": "smiling face with open hands."}, {"type": "subtitle", "time": 22547.67, "timestamp": "06:15:47", "text": "Pi. Pi is a mathematical constant used"}, {"type": "subtitle", "time": 22549.59, "timestamp": "06:15:49", "text": "to represent the ratio of a circle's"}, {"type": "subtitle", "time": 22552.31, "timestamp": "06:15:52", "text": "circumference to its diameter. It is"}, {"type": "subtitle", "time": 22556.47, "timestamp": "06:15:56", "text": "approximately equal to 3.14159."}, {"type": "subtitle", "time": 22559.91, "timestamp": "06:15:59", "text": "Math can be fascinating. Florian, keep"}]
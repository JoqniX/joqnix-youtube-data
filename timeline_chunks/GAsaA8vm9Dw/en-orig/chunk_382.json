[{"type": "subtitle", "time": 22923.19, "timestamp": "06:22:03", "text": "On my adventures, Harsh Kronos, I love"}, {"type": "subtitle", "time": 22925.67, "timestamp": "06:22:05", "text": "to explore new worlds, battle fearsome"}, {"type": "subtitle", "time": 22928.628, "timestamp": "06:22:08", "text": "monsters, and discover hidden treasures."}, {"type": "subtitle", "time": 22930.868, "timestamp": "06:22:10", "text": "I also enjoy assisting my companions in"}, {"type": "subtitle", "time": 22932.948, "timestamp": "06:22:12", "text": "battle, using my skills to aid them"}, {"type": "subtitle", "time": 22935.67, "timestamp": "06:22:15", "text": "however I can. Every adventure is a"}, {"type": "subtitle", "time": 22937.59, "timestamp": "06:22:17", "text": "chance to learn, grow, and make"}, {"type": "subtitle", "time": 22957.59, "timestamp": "06:22:37", "text": "indeed. Harsh Cron, I faced many"}, {"type": "subtitle", "time": 22959.59, "timestamp": "06:22:39", "text": "formidable beasts in my adventures and"}, {"type": "subtitle", "time": 22962.23, "timestamp": "06:22:42", "text": "emerged victorious. Defeating powerful"}, {"type": "subtitle", "time": 22963.91, "timestamp": "06:22:43", "text": "creatures is one of the most thrilling"}, {"type": "subtitle", "time": 22966.788, "timestamp": "06:22:46", "text": "aspects of being an adventurer. It takes"}, {"type": "subtitle", "time": 22969.59, "timestamp": "06:22:49", "text": "strategy, skill, and a bit of bravery,"}, {"type": "subtitle", "time": 22971.75, "timestamp": "06:22:51", "text": "but the feeling of triumph is absolutely"}]
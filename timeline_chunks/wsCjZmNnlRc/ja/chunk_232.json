[{"type": "subtitle", "time": 13920.389, "timestamp": "03:52:00", "text": "うん、共同作業としてやろう"}, {"type": "subtitle", "time": 13923.229, "timestamp": "03:52:03", "text": "協力して作業する。それは私だけの問題ではない"}, {"type": "subtitle", "time": 13926.15, "timestamp": "03:52:06", "text": "努力。みんなの意見を聞きたい。"}, {"type": "subtitle", "time": 13929.189, "timestamp": "03:52:09", "text": "みんなで一緒にやろう。わかりました。"}, {"type": "subtitle", "time": 13931.83, "timestamp": "03:52:11", "text": "私が言いたかったこと。"}, {"type": "subtitle", "time": 13935.11, "timestamp": "03:52:15", "text": "はい、最善を尽くします。私はそうします"}, {"type": "subtitle", "time": 13938.91, "timestamp": "03:52:18", "text": "私は自分の"}, {"type": "subtitle", "time": 13942.71, "timestamp": "03:52:22", "text": "最高。だから、どうか私を見守ってください。"}, {"type": "subtitle", "time": 13944.75, "timestamp": "03:52:24", "text": "私の"}, {"type": "subtitle", "time": 13948.75, "timestamp": "03:52:28", "text": "旅。うん、それもうまくいくといいな"}, {"type": "subtitle", "time": 13953.67, "timestamp": "03:52:33", "text": "ええと、奇跡が起こります。私は"}, {"type": "subtitle", "time": 13956.91, "timestamp": "03:52:36", "text": "私は持つことができるでしょう"}, {"type": "subtitle", "time": 13960.83, "timestamp": "03:52:40", "text": "実際に"}, {"type": "subtitle", "time": 13962.349, "timestamp": "03:52:42", "text": "えーと"}, {"type": "subtitle", "time": 13965.75, "timestamp": "03:52:45", "text": "新しいスポーツマンを引き出すもの"}, {"type": "subtitle", "time": 13970.189, "timestamp": "03:52:50", "text": "もう1年ほど取り組んでいます。"}, {"type": "subtitle", "time": 13973.75, "timestamp": "03:52:53", "text": "うん。ええ、良い経験でしたよ。"}, {"type": "subtitle", "time": 13977.469, "timestamp": "03:52:57", "text": "新しい体験。うん。"}]
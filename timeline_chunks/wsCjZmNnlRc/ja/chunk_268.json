[{"type": "subtitle", "time": 16093.349, "timestamp": "04:28:13", "text": "[音楽]"}, {"type": "subtitle", "time": 16097.07, "timestamp": "04:28:17", "text": "うん。こんにちは、みんな。"}, {"type": "subtitle", "time": 16099.63, "timestamp": "04:28:19", "text": "カワ、つまり"}, {"type": "subtitle", "time": 16102.55, "timestamp": "04:28:22", "text": "オハイオ州。何てことだ。うん。こんにちは、みんな。"}, {"type": "subtitle", "time": 16106.67, "timestamp": "04:28:26", "text": "皆さん、お元気ですか？ヤフー。"}, {"type": "subtitle", "time": 16112.269, "timestamp": "04:28:32", "text": "ヤフー。だから今日、今日、私たちは"}, {"type": "subtitle", "time": 16115.75, "timestamp": "04:28:35", "text": "演奏します 演奏します"}, {"type": "subtitle", "time": 16116.75, "timestamp": "04:28:36", "text": "死ぬ"}, {"type": "subtitle", "time": 16119.91, "timestamp": "04:28:39", "text": "ライト。えっと、これは4番目のストリームです"}, {"type": "subtitle", "time": 16122.469, "timestamp": "04:28:42", "text": "ダイイングライト。ご覧のとおり、終了しました。"}, {"type": "subtitle", "time": 16125.269, "timestamp": "04:28:45", "text": "ほら、私たちは完全に終わった"}, {"type": "subtitle", "time": 16127.91, "timestamp": "04:28:47", "text": "キャンペーン。こちらではほぼ100％そうです。"}, {"type": "subtitle", "time": 16131.83, "timestamp": "04:28:51", "text": "物語は終わった。終わり。そして私は、えっと"}, {"type": "subtitle", "time": 16134.389, "timestamp": "04:28:54", "text": "Vicとコラボして遊んでいます"}, {"type": "subtitle", "time": 16136.87, "timestamp": "04:28:56", "text": "信じてください、即興のコラボレーションです"}, {"type": "subtitle", "time": 16139.83, "timestamp": "04:28:59", "text": "シャシャは、あちらで言うことができます。うん。うん。"}]
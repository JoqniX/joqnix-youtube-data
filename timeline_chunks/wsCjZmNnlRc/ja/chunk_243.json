[{"type": "subtitle", "time": 14585.11, "timestamp": "04:03:05", "text": "だって、ストリーミングが大好きだから。えっと、私は思う"}, {"type": "subtitle", "time": 14587.67, "timestamp": "04:03:07", "text": "えっと、動画関係は私の得意分野じゃないんです。私はしません"}, {"type": "subtitle", "time": 14591.07, "timestamp": "04:03:11", "text": "知る。でも、もし私が"}, {"type": "subtitle", "time": 14594.79, "timestamp": "04:03:14", "text": "ライブ配信をしていると思ってください。もし私が"}, {"type": "subtitle", "time": 14596.63, "timestamp": "04:03:16", "text": "ライブ配信だと思って動画を録画する"}, {"type": "subtitle", "time": 14600.51, "timestamp": "04:03:20", "text": "配信なら、うまくできると思います。私は思う"}, {"type": "subtitle", "time": 14603.15, "timestamp": "04:03:23", "text": "うん。それで"}, {"type": "subtitle", "time": 14605.87, "timestamp": "04:03:25", "text": "それから"}, {"type": "subtitle", "time": 14608.87, "timestamp": "04:03:28", "text": "ええ、日本と戦うまで。"}, {"type": "subtitle", "time": 14612.229, "timestamp": "04:03:32", "text": "はい、それはイベント、チャンネルになります"}, {"type": "subtitle", "time": 14614.229, "timestamp": "04:03:34", "text": "大規模イベント"}, {"type": "subtitle", "time": 14618.71, "timestamp": "04:03:38", "text": "えっと、6月に日本に行くまでは。"}, {"type": "subtitle", "time": 14621.469, "timestamp": "04:03:41", "text": "えーと、6月、6月には"}, {"type": "subtitle", "time": 14624.429, "timestamp": "04:03:44", "text": "真剣に試験を受ける"}, {"type": "subtitle", "time": 14627.67, "timestamp": "04:03:47", "text": "私の学位とすべての"}, {"type": "subtitle", "time": 14631.03, "timestamp": "04:03:51", "text": "学術的なものだけど、まあ低い"}, {"type": "subtitle", "time": 14633.349, "timestamp": "04:03:53", "text": "優先権があるのは、今日本にいるからです"}, {"type": "subtitle", "time": 14635.429, "timestamp": "04:03:55", "text": "私はインドに戻って執筆することはできません"}, {"type": "subtitle", "time": 14638.309, "timestamp": "04:03:58", "text": "試験だけど、うまくいけば終わらせられると思う。"}]
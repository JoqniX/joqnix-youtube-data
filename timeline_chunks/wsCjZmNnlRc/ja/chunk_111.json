[{"type": "subtitle", "time": 6665.189, "timestamp": "01:51:05", "text": "[音楽]"}, {"type": "subtitle", "time": 6668.43, "timestamp": "01:51:08", "text": "はい、すみません。ミュートするのを忘れてた"}, {"type": "subtitle", "time": 6678.629, "timestamp": "01:51:18", "text": "浴槽。右。右。少なくともあなたは知っている"}, {"type": "subtitle", "time": 6680.51, "timestamp": "01:51:20", "text": "とは異なり"}, {"type": "subtitle", "time": 6683.229, "timestamp": "01:51:23", "text": "いくつか、または私はあなたを見ます"}, {"type": "subtitle", "time": 6707.629, "timestamp": "01:51:47", "text": "いつでも、もしあなたが"}, {"type": "subtitle", "time": 6717.83, "timestamp": "01:51:57", "text": "ああ、ファントムは他のリストと同じだ"}, {"type": "subtitle", "time": 6719.99, "timestamp": "01:51:59", "text": "自分自身をリストアップするもの、または"}]
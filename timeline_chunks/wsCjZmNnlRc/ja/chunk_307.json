[{"type": "subtitle", "time": 18427.39, "timestamp": "05:07:07", "text": "ああ、あなたのバギーは"}, {"type": "subtitle", "time": 18429.91, "timestamp": "05:07:09", "text": "呼び戻された。ああ、まるであなたが自分の"}, {"type": "subtitle", "time": 18433.27, "timestamp": "05:07:13", "text": "バギーは好きな場所にどこでも行けて、"}, {"type": "subtitle", "time": 18435.868, "timestamp": "05:07:15", "text": "文字通り運転するだけで"}, {"type": "subtitle", "time": 18438.51, "timestamp": "05:07:18", "text": "の中へ"}, {"type": "subtitle", "time": 18443.11, "timestamp": "05:07:23", "text": "運転。おお、それはなかなかいいですね。"}, {"type": "subtitle", "time": 18451.67, "timestamp": "05:07:31", "text": "神。いや、そうしない方がずっといいよ"}, {"type": "subtitle", "time": 18454.55, "timestamp": "05:07:34", "text": "バギーを使ってください、ずっと続けなければならないからです"}, {"type": "subtitle", "time": 18457.35, "timestamp": "05:07:37", "text": "修理などを続けてください"}, {"type": "subtitle", "time": 18459.628, "timestamp": "05:07:39", "text": "もう一つの普通の車両。"}, {"type": "subtitle", "time": 18464.75, "timestamp": "05:07:44", "text": "いいえ、あなたは普通に運転できると思います"}, {"type": "subtitle", "time": 18468.03, "timestamp": "05:07:48", "text": "車両。そう思います。わからない"}, {"type": "subtitle", "time": 18477.03, "timestamp": "05:07:57", "text": "それもいいですね、待って、私は"}, {"type": "subtitle", "time": 18479.27, "timestamp": "05:07:59", "text": "彼らがあなたにそれを許すとは思わない方がいいよ。待って、"}]
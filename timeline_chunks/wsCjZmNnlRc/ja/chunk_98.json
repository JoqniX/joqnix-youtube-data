[{"type": "subtitle", "time": 5881.03, "timestamp": "01:38:01", "text": "最近では。"}, {"type": "subtitle", "time": 5883.35, "timestamp": "01:38:03", "text": "私は彼らのほとんどを知りません。ああ、あなたは"}, {"type": "subtitle", "time": 5888.31, "timestamp": "01:38:08", "text": "神亜津吹スタジオみたいなところを知ってる？"}, {"type": "subtitle", "time": 5891.51, "timestamp": "01:38:11", "text": "人々は咳とかそういうのが好きなんです。彼らです"}, {"type": "subtitle", "time": 5893.99, "timestamp": "01:38:13", "text": "Vシンガーのように。カミについて知っていますか？"}, {"type": "subtitle", "time": 5897.189, "timestamp": "01:38:17", "text": "スバキスタジオ？"}, {"type": "subtitle", "time": 5900.95, "timestamp": "01:38:20", "text": "上椿って何？レコードみたいだ"}, {"type": "subtitle", "time": 5905.189, "timestamp": "01:38:25", "text": "レーベルは、Vシンガーズなどが含まれています。"}, {"type": "subtitle", "time": 5908.99, "timestamp": "01:38:28", "text": "物や、もっと大きなJPのようなもの"}, {"type": "subtitle", "time": 5912.27, "timestamp": "01:38:32", "text": "ボーカロイドアーティストや歌手など"}, {"type": "subtitle", "time": 5915.189, "timestamp": "01:38:35", "text": "もの。リンクは私が貼ります。だから彼らは"}, {"type": "subtitle", "time": 5918.189, "timestamp": "01:38:38", "text": "6月に公開されるアニメ"}, {"type": "subtitle", "time": 5919.79, "timestamp": "01:38:39", "text": "6."}, {"type": "subtitle", "time": 5922.91, "timestamp": "01:38:42", "text": "えっと、スージーこれ"}, {"type": "subtitle", "time": 5927.27, "timestamp": "01:38:47", "text": "私の好きなもののひとつは咳と"}, {"type": "subtitle", "time": 5930.47, "timestamp": "01:38:50", "text": "アニメ化される予定で、"}]
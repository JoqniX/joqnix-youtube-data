[{"type": "subtitle", "time": 1565.269, "timestamp": "00:26:05", "text": "うん、"}, {"type": "subtitle", "time": 1571.75, "timestamp": "00:26:11", "text": "日本語。もし私があなたに"}, {"type": "subtitle", "time": 1575.59, "timestamp": "00:26:15", "text": "私が下手な日本語を話していた時"}, {"type": "subtitle", "time": 1582.549, "timestamp": "00:26:22", "text": "おお、"}, {"type": "subtitle", "time": 1584.23, "timestamp": "00:26:24", "text": "どうだった？ええ、それは"}, {"type": "subtitle", "time": 1587.83, "timestamp": "00:26:27", "text": "興味深い、興味深い瞬間"}, {"type": "subtitle", "time": 1590.549, "timestamp": "00:26:30", "text": "私の人生。私は間違いなく"}, {"type": "subtitle", "time": 1593.63, "timestamp": "00:26:33", "text": "それについての話。えっと"}, {"type": "subtitle", "time": 1612.029, "timestamp": "00:26:52", "text": "[音楽]"}, {"type": "subtitle", "time": 1615.31, "timestamp": "00:26:55", "text": "えっと、たくさん"}]
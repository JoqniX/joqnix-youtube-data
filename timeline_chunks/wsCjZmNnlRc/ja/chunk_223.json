[{"type": "subtitle", "time": 13381.91, "timestamp": "03:43:01", "text": "できると思うけど、できると信じてる"}, {"type": "subtitle", "time": 13386.07, "timestamp": "03:43:06", "text": "私が十分な一貫性を持っていれば、そうします。私"}, {"type": "subtitle", "time": 13388.67, "timestamp": "03:43:08", "text": "それに向けて一生懸命努力します。"}, {"type": "subtitle", "time": 13392.229, "timestamp": "03:43:12", "text": "うん。ええ、それはとても"}, {"type": "subtitle", "time": 13394.55, "timestamp": "03:43:14", "text": "莫大な量なので、この4ヶ月間は"}, {"type": "subtitle", "time": 13395.79, "timestamp": "03:43:15", "text": "期間は"}, {"type": "subtitle", "time": 13400.51, "timestamp": "03:43:20", "text": "十分。だから私はこれをやるつもりだ"}, {"type": "subtitle", "time": 13403.03, "timestamp": "03:43:23", "text": "この4ヶ月間だけのジョックアソン"}, {"type": "subtitle", "time": 13406.71, "timestamp": "03:43:26", "text": "日本に着いたら、"}, {"type": "subtitle", "time": 13408.389, "timestamp": "03:43:28", "text": "新しいノートパソコンを買わなければならないだろうし"}, {"type": "subtitle", "time": 13411.429, "timestamp": "03:43:31", "text": "すべて設定できる"}, {"type": "subtitle", "time": 13413.469, "timestamp": "03:43:33", "text": "すべてを取り戻せるように"}, {"type": "subtitle", "time": 13416.429, "timestamp": "03:43:36", "text": "ストリーミング配信。わかった。"}, {"type": "subtitle", "time": 13418.95, "timestamp": "03:43:38", "text": "うん。そしてそれにはしばらく時間がかかるだろう、"}, {"type": "subtitle", "time": 13423.11, "timestamp": "03:43:43", "text": "知る。そして、私ってそういう人間だから、"}, {"type": "subtitle", "time": 13425.11, "timestamp": "03:43:45", "text": "生き残れるとは思わないけど、私は"}, {"type": "subtitle", "time": 13427.75, "timestamp": "03:43:47", "text": "生き残る。私は自分を信じている。これは新しい"}, {"type": "subtitle", "time": 13430.63, "timestamp": "03:43:50", "text": "私にとっては挑戦だ。内向的な私"}, {"type": "subtitle", "time": 13434.229, "timestamp": "03:43:54", "text": "世界に出て世界を見る"}, {"type": "subtitle", "time": 13436.75, "timestamp": "03:43:56", "text": "私自身の目から見て、世界がどのように機能し、"}, {"type": "subtitle", "time": 13439.51, "timestamp": "03:43:59", "text": "すべて。それは難しいだろう。でも私は"}]
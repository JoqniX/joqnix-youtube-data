[{"type": "subtitle", "time": 17522.39, "timestamp": "04:52:02", "text": "ウイルスに対してね。彼が"}, {"type": "subtitle", "time": 17524.868, "timestamp": "04:52:04", "text": "彼女は手信号を使って"}, {"type": "subtitle", "time": 17527.55, "timestamp": "04:52:07", "text": "実際にジェスチャーをしながら"}, {"type": "subtitle", "time": 17530.39, "timestamp": "04:52:10", "text": "ある女性が率いる忌まわしいカルト教団を"}, {"type": "subtitle", "time": 17532.708, "timestamp": "04:52:12", "text": "彼らは母親をかつてはただの"}, {"type": "subtitle", "time": 17535.03, "timestamp": "04:52:15", "text": "無害な地元の伝統だって知ってるでしょ"}, {"type": "subtitle", "time": 17538.07, "timestamp": "04:52:18", "text": "彼らは真剣に考えていなかったが、"}, {"type": "subtitle", "time": 17540.868, "timestamp": "04:52:20", "text": "最近は本当に深刻です"}, {"type": "subtitle", "time": 17542.628, "timestamp": "04:52:22", "text": "アウトブレイク"}, {"type": "subtitle", "time": 17545.708, "timestamp": "04:52:25", "text": "至る所にシンボルがある、こんなクソみたいな"}, {"type": "subtitle", "time": 17548.07, "timestamp": "04:52:28", "text": "儀式 彼らは、"}, {"type": "subtitle", "time": 17555.39, "timestamp": "04:52:35", "text": "中心か何か？"}, {"type": "subtitle", "time": 17558.708, "timestamp": "04:52:38", "text": "聞いてくれ、俺は今その男に欠けているし、"}, {"type": "subtitle", "time": 17561.67, "timestamp": "04:52:41", "text": "私は起業家です。一緒にビジネスをしましょう。"}, {"type": "subtitle", "time": 17565.19, "timestamp": "04:52:45", "text": "君と僕でパートナーを組もう。何かを購入する際、"}, {"type": "subtitle", "time": 17571.99, "timestamp": "04:52:51", "text": "よし、彼は両方の話を聞くためにそこにいる"}, {"type": "subtitle", "time": 17575.11, "timestamp": "04:52:55", "text": "私たちの会話。なんて故人だ。何"}, {"type": "subtitle", "time": 17577.91, "timestamp": "04:52:57", "text": "少しキツネっぽい。何てことだ。見せることができます"}, {"type": "subtitle", "time": 17579.91, "timestamp": "04:52:59", "text": "何か役に立つかもしれないもの、"}]
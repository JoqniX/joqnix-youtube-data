[{"type": "subtitle", "time": 13563.11, "timestamp": "03:46:03", "text": "私は他人に時間をかけすぎたよね？"}, {"type": "subtitle", "time": 13567.389, "timestamp": "03:46:07", "text": "あなたのために自分自身に焦点を当てるのではなく"}, {"type": "subtitle", "time": 13570.15, "timestamp": "03:46:10", "text": "みんな。一度、私は"}, {"type": "subtitle", "time": 13573.269, "timestamp": "03:46:13", "text": "自分のコミュニティを犠牲にしてでも助けようとした"}, {"type": "subtitle", "time": 13575.91, "timestamp": "03:46:15", "text": "他の人々の夢を取り上げ、"}, {"type": "subtitle", "time": 13578.269, "timestamp": "03:46:18", "text": "すべて、"}, {"type": "subtitle", "time": 13580.83, "timestamp": "03:46:20", "text": "右？"}, {"type": "subtitle", "time": 13582.83, "timestamp": "03:46:22", "text": "しかしこれは"}, {"type": "subtitle", "time": 13585.75, "timestamp": "03:46:25", "text": "私が望む時、そして時があった"}, {"type": "subtitle", "time": 13588.63, "timestamp": "03:46:28", "text": "私は卒業間近だった"}, {"type": "subtitle", "time": 13589.63, "timestamp": "03:46:29", "text": "または与える"}, {"type": "subtitle", "time": 13593.83, "timestamp": "03:46:33", "text": "何をすればいいのか分からなかったので、立ち上がった。"}, {"type": "subtitle", "time": 13597.189, "timestamp": "03:46:37", "text": "それは何ですか、私にできること、そして私たちが"}, {"type": "subtitle", "time": 13599.269, "timestamp": "03:46:39", "text": "それらの問題はすべてありました。"}, {"type": "subtitle", "time": 13601.83, "timestamp": "03:46:41", "text": "これらの耳と"}, {"type": "subtitle", "time": 13606.71, "timestamp": "03:46:46", "text": "これは新しい章だと言い、"}, {"type": "subtitle", "time": 13607.79, "timestamp": "03:46:47", "text": "すべて"}, {"type": "subtitle", "time": 13611.11, "timestamp": "03:46:51", "text": "そう、ネガティブになりたくないんだ"}, {"type": "subtitle", "time": 13614.59, "timestamp": "03:46:54", "text": "ここだけどそうだ、インポサー症候群"}, {"type": "subtitle", "time": 13618.87, "timestamp": "03:46:58", "text": "警告だから私は証明するつもりだ"}]
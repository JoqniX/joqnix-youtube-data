[{"type": "subtitle", "time": 17828.43, "timestamp": "04:57:08", "text": "あなた。これで終わりですよね？全員死亡した。"}, {"type": "subtitle", "time": 17831.55, "timestamp": "04:57:11", "text": "わかりました、それではあなたの"}, {"type": "subtitle", "time": 17838.73, "timestamp": "04:57:18", "text": "お金は"}, {"type": "subtitle", "time": 17840.59, "timestamp": "04:57:20", "text": "[音楽]"}, {"type": "subtitle", "time": 17843.75, "timestamp": "04:57:23", "text": "猿の方がもっと好き？ええ、彼らは"}, {"type": "subtitle", "time": 17845.23, "timestamp": "04:57:25", "text": "ライフル銃"}, {"type": "subtitle", "time": 17848.07, "timestamp": "04:57:28", "text": "彼ら。私はただもっとライフルが欲しかっただけなんです、"}, {"type": "subtitle", "time": 17861.07, "timestamp": "04:57:41", "text": "[音楽]"}, {"type": "subtitle", "time": 17870.91, "timestamp": "04:57:50", "text": "これ。"}, {"type": "subtitle", "time": 17873.55, "timestamp": "04:57:53", "text": "ああ、プレミアム"}, {"type": "subtitle", "time": 17876.628, "timestamp": "04:57:56", "text": "化粧品。そして今、それは新しいこと"}, {"type": "subtitle", "time": 17879.75, "timestamp": "04:57:59", "text": "これまで見たことがない。ちょうど帰ってきたところです"}]
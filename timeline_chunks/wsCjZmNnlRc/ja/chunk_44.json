[{"type": "subtitle", "time": 2645.589, "timestamp": "00:44:05", "text": "でも私は、"}, {"type": "subtitle", "time": 2647.99, "timestamp": "00:44:07", "text": "チャットの人たちは"}, {"type": "subtitle", "time": 2650.79, "timestamp": "00:44:10", "text": "私の周りにいる。私は自分が"}, {"type": "subtitle", "time": 2652.95, "timestamp": "00:44:12", "text": "このフォーラムには、社交的に不器用な人が多い"}, {"type": "subtitle", "time": 2654.87, "timestamp": "00:44:14", "text": "プラットフォーム。ええと、私はTwitchにはいませんが、"}, {"type": "subtitle", "time": 2657.51, "timestamp": "00:44:17", "text": "社交的に不器用な人の一人"}, {"type": "subtitle", "time": 2660.95, "timestamp": "00:44:20", "text": "まあ、気にしないでくれるといいんだけど"}, {"type": "subtitle", "time": 2663.43, "timestamp": "00:44:23", "text": "私によって。"}, {"type": "subtitle", "time": 2666.109, "timestamp": "00:44:26", "text": "いいえ、大丈夫です"}, {"type": "subtitle", "time": 2668.51, "timestamp": "00:44:28", "text": "今。あなたは"}, {"type": "subtitle", "time": 2678.27, "timestamp": "00:44:38", "text": "[音楽]"}, {"type": "subtitle", "time": 2681.19, "timestamp": "00:44:41", "text": "うん。君がめちゃくちゃ正直なところが好きだ。"}, {"type": "subtitle", "time": 2682.88, "timestamp": "00:44:42", "text": "これは面白い。"}, {"type": "subtitle", "time": 2684.55, "timestamp": "00:44:44", "text": "[音楽]"}, {"type": "subtitle", "time": 2685.91, "timestamp": "00:44:45", "text": "人を信用してはいけない"}, {"type": "subtitle", "time": 2688.39, "timestamp": "00:44:48", "text": "ちなみに、インターネットの話です。すべてのあなたへ"}, {"type": "subtitle", "time": 2690.39, "timestamp": "00:44:50", "text": "知ってる、私はかわいいアニメかもしれない"}, {"type": "subtitle", "time": 2692.63, "timestamp": "00:44:52", "text": "現実世界の少女。"}, {"type": "subtitle", "time": 2694.87, "timestamp": "00:44:54", "text": "老人のふりをしている、"}]
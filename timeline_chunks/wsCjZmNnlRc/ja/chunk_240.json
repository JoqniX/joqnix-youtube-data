[{"type": "subtitle", "time": 14403.229, "timestamp": "04:00:03", "text": "結婚式はまるで一大イベントのよう"}, {"type": "subtitle", "time": 14407.67, "timestamp": "04:00:07", "text": "だって、えっと、私はこう思ったんだ、君は"}, {"type": "subtitle", "time": 14409.189, "timestamp": "04:00:09", "text": "結婚式で何をする？あなたはあなたの"}, {"type": "subtitle", "time": 14411.67, "timestamp": "04:00:11", "text": "すべて、ですよね？君はそれを壮大なものにする"}, {"type": "subtitle", "time": 14415.07, "timestamp": "04:00:15", "text": "できる限り、ですよね？しかし実際は"}, {"type": "subtitle", "time": 14417.99, "timestamp": "04:00:17", "text": "大丈夫。小規模なクリエイターとして、私は"}, {"type": "subtitle", "time": 14422.15, "timestamp": "04:00:22", "text": "派手にしたり、高価にしすぎたりしないように"}, {"type": "subtitle", "time": 14424.67, "timestamp": "04:00:24", "text": "あるいは、負荷が大きすぎる。"}, {"type": "subtitle", "time": 14427.389, "timestamp": "04:00:27", "text": "いいえ、デビューは単なる"}, {"type": "subtitle", "time": 14431.83, "timestamp": "04:00:31", "text": "イベント。デビューは単なる人生のイベント、"}, {"type": "subtitle", "time": 14433.91, "timestamp": "04:00:33", "text": "あなたの旅の中で印象的な何か"}, {"type": "subtitle", "time": 14436.55, "timestamp": "04:00:36", "text": "「ああ、デビューしたんだ」って感じの瞬間。私は"}, {"type": "subtitle", "time": 14439.469, "timestamp": "04:00:39", "text": "ここ。私は生きている"}, {"type": "subtitle", "time": 14441.83, "timestamp": "04:00:41", "text": "自己紹介みたいなもの"}, {"type": "subtitle", "time": 14443.99, "timestamp": "04:00:43", "text": "世界中にあなたが誰であるかを知らせるために"}, {"type": "subtitle", "time": 14446.83, "timestamp": "04:00:46", "text": "あなたが何者であるか、そしてすべてのものが"}, {"type": "subtitle", "time": 14448.349, "timestamp": "04:00:48", "text": "すべて"}, {"type": "subtitle", "time": 14452.269, "timestamp": "04:00:52", "text": "そうですね、そうですね"}, {"type": "subtitle", "time": 14457.03, "timestamp": "04:00:57", "text": "えっと、未来の自分に物事のやり方を決めてもらうことにします"}, {"type": "subtitle", "time": 14459.75, "timestamp": "04:00:59", "text": "デビューした後、"}]
[{"type": "subtitle", "time": 15002.469, "timestamp": "04:10:02", "text": "時計。できる方法はたくさんあります"}, {"type": "subtitle", "time": 15004.79, "timestamp": "04:10:04", "text": "ストリーマーやユーチューバーをサポートする"}, {"type": "subtitle", "time": 15006.71, "timestamp": "04:10:06", "text": "無料。あなたならできますよ。大丈夫です。"}, {"type": "subtitle", "time": 15012.389, "timestamp": "04:10:12", "text": "全く問題ありません。しかし、寄付のみ"}, {"type": "subtitle", "time": 15015.07, "timestamp": "04:10:15", "text": "または私を応援してください"}, {"type": "subtitle", "time": 15018.71, "timestamp": "04:10:18", "text": "余分な。十分なものがあれば"}, {"type": "subtitle", "time": 15020.63, "timestamp": "04:10:20", "text": "あなた自身のために。少ししかない場合"}, {"type": "subtitle", "time": 15023.67, "timestamp": "04:10:23", "text": "少しだけ余分に。わかった。うん。金額"}, {"type": "subtitle", "time": 15026.71, "timestamp": "04:10:26", "text": "関係ない。行き過ぎないように。わかった。"}, {"type": "subtitle", "time": 15029.429, "timestamp": "04:10:29", "text": "少なくとも1ルピーなら構わない"}, {"type": "subtitle", "time": 15032.79, "timestamp": "04:10:32", "text": "1ルピーまたは車、心配しないで、または1ドルまたは"}, {"type": "subtitle", "time": 15036.63, "timestamp": "04:10:36", "text": "セント未満、または何であれ"}, {"type": "subtitle", "time": 15039.99, "timestamp": "04:10:39", "text": "このプラットフォームでは、最低寄付額を設定できます。"}, {"type": "subtitle", "time": 15041.83, "timestamp": "04:10:41", "text": "それでいいんです、私は尋ねません、私は望んでいません"}, {"type": "subtitle", "time": 15044.07, "timestamp": "04:10:44", "text": "誰かに多額の寄付を依頼する"}, {"type": "subtitle", "time": 15047.75, "timestamp": "04:10:47", "text": "全くダメ、でも自分のために使って"}, {"type": "subtitle", "time": 15050.269, "timestamp": "04:10:50", "text": "私とあなたの車"}, {"type": "subtitle", "time": 15055.189, "timestamp": "04:10:55", "text": "こんにちは、ええ、たとえ私たちが超えることができなくても"}, {"type": "subtitle", "time": 15057.55, "timestamp": "04:10:57", "text": "目標は大丈夫、何とかするよ"}]
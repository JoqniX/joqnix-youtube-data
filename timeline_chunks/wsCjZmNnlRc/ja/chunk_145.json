[{"type": "subtitle", "time": 8700.349, "timestamp": "02:25:00", "text": "プラス"}, {"type": "subtitle", "time": 8703.77, "timestamp": "02:25:03", "text": "年齢も関係する。私は違います"}, {"type": "subtitle", "time": 8705.79, "timestamp": "02:25:05", "text": "[音楽]"}, {"type": "subtitle", "time": 8711.309, "timestamp": "02:25:11", "text": "確かに、ストリームを見ていたことを覚えている"}, {"type": "subtitle", "time": 8715.67, "timestamp": "02:25:15", "text": "彼女のもの。ああ、彼女はたくさんの"}, {"type": "subtitle", "time": 8718.23, "timestamp": "02:25:18", "text": "アーティストたち。"}, {"type": "subtitle", "time": 8720.63, "timestamp": "02:25:20", "text": "ええ、彼女はモデルを描いて、リギングしました"}, {"type": "subtitle", "time": 8724.63, "timestamp": "02:25:24", "text": "正気の沙汰じゃないよ。"}, {"type": "subtitle", "time": 8725.87, "timestamp": "02:25:25", "text": "彼女が持っている"}, {"type": "subtitle", "time": 8729.349, "timestamp": "02:25:29", "text": "登録者数1万1千人。"}, {"type": "subtitle", "time": 8731.99, "timestamp": "02:25:31", "text": "待って、彼女はインドネシア人なの？"}, {"type": "subtitle", "time": 8752.63, "timestamp": "02:25:52", "text": "私たちのモデルも可愛いですよ。何が起こるのですか"}, {"type": "subtitle", "time": 8755.5, "timestamp": "02:25:55", "text": "頭が"}]
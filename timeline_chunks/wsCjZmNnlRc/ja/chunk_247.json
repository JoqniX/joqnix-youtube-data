[{"type": "subtitle", "time": 14823.269, "timestamp": "04:07:03", "text": "ジョアソン、私はIRLの"}, {"type": "subtitle", "time": 14825.75, "timestamp": "04:07:05", "text": "義務とは、授業やその他すべてのことです。"}, {"type": "subtitle", "time": 14828.469, "timestamp": "04:07:08", "text": "V字型のエンジンを稼働させます。彼らは止めるだろう"}, {"type": "subtitle", "time": 14831.67, "timestamp": "04:07:11", "text": "タイマーも全部含めて。私は持っていません"}, {"type": "subtitle", "time": 14833.59, "timestamp": "04:07:13", "text": "ウィジェットを購入しました。サボトンがあります"}, {"type": "subtitle", "time": 14837.67, "timestamp": "04:07:17", "text": "買いたかったウィジェットだけど、"}, {"type": "subtitle", "time": 14840.389, "timestamp": "04:07:20", "text": "できるだけお金を貯めた方がいいんじゃない？"}, {"type": "subtitle", "time": 14844.07, "timestamp": "04:07:24", "text": "私にできる限り、ですよね？私は投資できると知っています"}, {"type": "subtitle", "time": 14846.95, "timestamp": "04:07:26", "text": "流れの中に入れ、適切なものを手に入れる"}, {"type": "subtitle", "time": 14849.75, "timestamp": "04:07:29", "text": "このサブマラソン用のウィジェットやその他"}, {"type": "subtitle", "time": 14851.63, "timestamp": "04:07:31", "text": "このジョックアソンの件、"}, {"type": "subtitle", "time": 14854.189, "timestamp": "04:07:34", "text": "でも、そうだね"}, {"type": "subtitle", "time": 14857.189, "timestamp": "04:07:37", "text": "痛み。これはミートンウィジェットです。本当に"}, {"type": "subtitle", "time": 14859.03, "timestamp": "04:07:39", "text": "指名手配"}, {"type": "subtitle", "time": 14862.63, "timestamp": "04:07:42", "text": "えっと、シオ・ラニとかいう人だったかな。毎"}, {"type": "subtitle", "time": 14865.269, "timestamp": "04:07:45", "text": "YouTubeとTwitchであなたの配信者を見ました"}, {"type": "subtitle", "time": 14868.309, "timestamp": "04:07:48", "text": "サブアトンに使用します。私は「ああ、私は"}, {"type": "subtitle", "time": 14870.15, "timestamp": "04:07:50", "text": "私もそれを使うことになっている。」しかし"}, {"type": "subtitle", "time": 14873.03, "timestamp": "04:07:53", "text": "現実には、そうだと気づいた。"}, {"type": "subtitle", "time": 14875.269, "timestamp": "04:07:55", "text": "より大きなチャンネルとより大きな"}, {"type": "subtitle", "time": 14877.75, "timestamp": "04:07:57", "text": "数字。私は小規模なクリエイターです"}, {"type": "subtitle", "time": 14879.99, "timestamp": "04:07:59", "text": "より少ない数で。だから、私はそうすべきではない"}]
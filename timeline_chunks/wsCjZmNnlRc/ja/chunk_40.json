[{"type": "subtitle", "time": 2401.829, "timestamp": "00:40:01", "text": "存在しないもの、その後のようなもの"}, {"type": "subtitle", "time": 2405.03, "timestamp": "00:40:05", "text": "コラボレーションは、彼らが言うことを好まないだろう"}, {"type": "subtitle", "time": 2408.15, "timestamp": "00:40:08", "text": "それはひどいコラボレーションだった、などなど"}, {"type": "subtitle", "time": 2411.03, "timestamp": "00:40:11", "text": "その時、私は自分がJPにいることに気づいた"}, {"type": "subtitle", "time": 2414.23, "timestamp": "00:40:14", "text": "時々、一部の人々は"}, {"type": "subtitle", "time": 2417.39, "timestamp": "00:40:17", "text": "チャットでのやり取りも同様です。私はこう思った。"}, {"type": "subtitle", "time": 2421.109, "timestamp": "00:40:21", "text": "\"はぁ？\"私はそれがただの"}, {"type": "subtitle", "time": 2422.95, "timestamp": "00:40:22", "text": "2人のクリエイターと繋がって、"}, {"type": "subtitle", "time": 2424.55, "timestamp": "00:40:24", "text": "お互いを繋げて、あなたも"}, {"type": "subtitle", "time": 2428.069, "timestamp": "00:40:28", "text": "楽しんでいるよ。しかし、一部の人々は気にしています"}, {"type": "subtitle", "time": 2430.79, "timestamp": "00:40:30", "text": "数字に関する話が多い。うん。そして、"}, {"type": "subtitle", "time": 2433.51, "timestamp": "00:40:33", "text": "数字は重要ではあるが、"}, {"type": "subtitle", "time": 2437.03, "timestamp": "00:40:37", "text": "正直に言って、私は気にしない。えっと"}, {"type": "subtitle", "time": 2439.589, "timestamp": "00:40:39", "text": "結局私はただの平凡な男です"}, {"type": "subtitle", "time": 2442.55, "timestamp": "00:40:42", "text": "日。コンテンツ制作は私の情熱の対象ではありません。"}, {"type": "subtitle", "time": 2445.51, "timestamp": "00:40:45", "text": "ご期待に添えず申し訳ありません。私はただ"}, {"type": "subtitle", "time": 2448.67, "timestamp": "00:40:48", "text": "ごく普通の老人"}, {"type": "subtitle", "time": 2452.87, "timestamp": "00:40:52", "text": "えーっと、コンテンツ作成が嫌いで"}, {"type": "subtitle", "time": 2456.589, "timestamp": "00:40:56", "text": "情熱。 VTuberは見ないし、えーと"}]
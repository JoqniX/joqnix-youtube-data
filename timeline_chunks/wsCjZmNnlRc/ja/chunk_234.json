[{"type": "subtitle", "time": 14041.83, "timestamp": "03:54:01", "text": "イベントの種類に応じた同様の寄付"}, {"type": "subtitle", "time": 14044.309, "timestamp": "03:54:04", "text": "なぜなら"}, {"type": "subtitle", "time": 14046.189, "timestamp": "03:54:06", "text": "えっと、私は感じます"}, {"type": "subtitle", "time": 14049.91, "timestamp": "03:54:09", "text": "そう、何をするにもお金が必要なんだよ。はぁ。"}, {"type": "subtitle", "time": 14054.349, "timestamp": "03:54:14", "text": "悲しい真実だが、それが現実だ"}, {"type": "subtitle", "time": 14057.91, "timestamp": "03:54:17", "text": "は。しかし問題は、自分の"}, {"type": "subtitle", "time": 14061.229, "timestamp": "03:54:21", "text": "性格と、私がどれだけ頑固かを知っている"}, {"type": "subtitle", "time": 14065.91, "timestamp": "03:54:25", "text": "午前。正直に言うと、"}, {"type": "subtitle", "time": 14068.229, "timestamp": "03:54:28", "text": "いいね、ヘルプ、いいね、コミュニティ"}, {"type": "subtitle", "time": 14071.389, "timestamp": "03:54:31", "text": "資金援助はこんな感じだった。私は"}, {"type": "subtitle", "time": 14074.07, "timestamp": "03:54:34", "text": "心配するだろう"}, {"type": "subtitle", "time": 14076.309, "timestamp": "03:54:36", "text": "将来、私は何とかやりくりするだろう"}, {"type": "subtitle", "time": 14080.79, "timestamp": "03:54:40", "text": "それ。しかし、私は自分自身にルールを課した。わかった。"}, {"type": "subtitle", "time": 14083.99, "timestamp": "03:54:43", "text": "オンラインで稼いだお金は、"}, {"type": "subtitle", "time": 14086.55, "timestamp": "03:54:46", "text": "Vtubingは、"}, {"type": "subtitle", "time": 14089.03, "timestamp": "03:54:49", "text": "Vチューブは進歩か何か"}, {"type": "subtitle", "time": 14090.99, "timestamp": "03:54:50", "text": "より良い"}, {"type": "subtitle", "time": 14094.71, "timestamp": "03:54:54", "text": "もの。そう、それは音楽にも当てはまる。"}, {"type": "subtitle", "time": 14097.11, "timestamp": "03:54:57", "text": "私の音楽キャリアでも実際に"}]
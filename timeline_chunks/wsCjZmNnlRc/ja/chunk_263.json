[{"type": "subtitle", "time": 15782.07, "timestamp": "04:23:02", "text": "心から楽しんでいるし、好きです。そう、"}, {"type": "subtitle", "time": 15786.03, "timestamp": "04:23:06", "text": "それに取り組む。よし、かなり速く走っていると思う。えっと"}, {"type": "subtitle", "time": 15790.91, "timestamp": "04:23:10", "text": "私もまだ、ええ、終わります。わかった。"}, {"type": "subtitle", "time": 15795.429, "timestamp": "04:23:15", "text": "こんにちは。というわけで、ありがとうございました。"}, {"type": "subtitle", "time": 15798.11, "timestamp": "04:23:18", "text": "聴いてくださった皆様へ"}, {"type": "subtitle", "time": 15804.67, "timestamp": "04:23:24", "text": "はい、私は"}, {"type": "subtitle", "time": 15808.309, "timestamp": "04:23:28", "text": "こんにちは。"}, {"type": "subtitle", "time": 15810.429, "timestamp": "04:23:30", "text": "みんな大好きだよ"}, {"type": "subtitle", "time": 15816.91, "timestamp": "04:23:36", "text": "よし、これは"}]
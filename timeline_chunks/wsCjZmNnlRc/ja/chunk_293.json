[{"type": "subtitle", "time": 17582.15, "timestamp": "04:53:02", "text": "でも、まずは車輪を手に入れなきゃ。"}, {"type": "subtitle", "time": 17584.948, "timestamp": "04:53:04", "text": "ここに車が走っている。私はどこにいるの？"}, {"type": "subtitle", "time": 17586.788, "timestamp": "04:53:06", "text": "それを見つけるはずだったの？ヴァデ車両。おお"}, {"type": "subtitle", "time": 17589.51, "timestamp": "04:53:09", "text": "我が神よ。そちらへ伺います。そしてねえ、"}, {"type": "subtitle", "time": 17591.99, "timestamp": "04:53:11", "text": "慎重に行動してください。よし。なれ"}, {"type": "subtitle", "time": 17595.11, "timestamp": "04:53:15", "text": "控えめに。控えめとは一体何でしょうか？のように"}, {"type": "subtitle", "time": 17598.788, "timestamp": "04:53:18", "text": "秘密にしておく。秘密。車両を探す"}, {"type": "subtitle", "time": 17600.868, "timestamp": "04:53:20", "text": "釘農場で。何てことだ。実は、"}, {"type": "subtitle", "time": 17602.948, "timestamp": "04:53:22", "text": "私たちは車両を入手する予定です。わかった。それを"}, {"type": "subtitle", "time": 17604.868, "timestamp": "04:53:24", "text": "私が話した車。何てことだ。待って。"}, {"type": "subtitle", "time": 17607.99, "timestamp": "04:53:27", "text": "あのずる賢いキツネ、あるいはずる賢い犬はどこにいる？どこ"}, {"type": "subtitle", "time": 17610.39, "timestamp": "04:53:30", "text": "どこにいるの？すくった人"}, {"type": "subtitle", "time": 17614.948, "timestamp": "04:53:34", "text": "周りを見回して、私が彼と話しているのを見た。だった"}, {"type": "subtitle", "time": 17617.628, "timestamp": "04:53:37", "text": "白いシャツを着ている、"}, {"type": "subtitle", "time": 17620.91, "timestamp": "04:53:40", "text": "何か。その人物は現在行方不明です。"}, {"type": "subtitle", "time": 17622.91, "timestamp": "04:53:42", "text": "おお。"}, {"type": "subtitle", "time": 17632.35, "timestamp": "04:53:52", "text": "外。気分が悪い"}]
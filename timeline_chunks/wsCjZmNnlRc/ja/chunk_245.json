[{"type": "subtitle", "time": 14701.67, "timestamp": "04:05:01", "text": "そしてそのライフスタイルに慣れていて、"}, {"type": "subtitle", "time": 14705.349, "timestamp": "04:05:05", "text": "私は、"}, {"type": "subtitle", "time": 14707.75, "timestamp": "04:05:07", "text": "あらゆることに耐えてきた"}, {"type": "subtitle", "time": 14710.389, "timestamp": "04:05:10", "text": "ええと、その他すべて。うん。えっと、ラップトップなので"}, {"type": "subtitle", "time": 14713.11, "timestamp": "04:05:13", "text": "ストリーミング配信も何でもできます。"}, {"type": "subtitle", "time": 14715.59, "timestamp": "04:05:15", "text": "ルームメイトがあまり怒っていないといいんだけど、"}, {"type": "subtitle", "time": 14717.349, "timestamp": "04:05:17", "text": "私は推測する。わからない。考えている"}, {"type": "subtitle", "time": 14719.91, "timestamp": "04:05:19", "text": "また。またもや先のことを考えている。私"}, {"type": "subtitle", "time": 14722.15, "timestamp": "04:05:22", "text": "わからない。まあ、そうですね。でも、ええ、私は"}, {"type": "subtitle", "time": 14725.67, "timestamp": "04:05:25", "text": "それは将来のドキュメントに任せましょう。私"}, {"type": "subtitle", "time": 14727.67, "timestamp": "04:05:27", "text": "将来のことを心配する必要はない"}, {"type": "subtitle", "time": 14730.469, "timestamp": "04:05:30", "text": "今すぐ。私が心配すべきことは"}, {"type": "subtitle", "time": 14733.309, "timestamp": "04:05:33", "text": "今の私にできること。"}, {"type": "subtitle", "time": 14735.389, "timestamp": "04:05:35", "text": "右。"}, {"type": "subtitle", "time": 14738.389, "timestamp": "04:05:38", "text": "こんにちは。ええ、それが偶数タイムラインです。"}, {"type": "subtitle", "time": 14740.95, "timestamp": "04:05:40", "text": "3月12日から6月まで。印をつけておきます"}, {"type": "subtitle", "time": 14750.59, "timestamp": "04:05:50", "text": "うん。"}, {"type": "subtitle", "time": 14755.11, "timestamp": "04:05:55", "text": "こんにちは。それで、えーと、このイベントの間、私は"}, {"type": "subtitle", "time": 14757.91, "timestamp": "04:05:57", "text": "質問は、あなたがTwitchにいるか、それとも"}]
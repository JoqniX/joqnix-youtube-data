[{"type": "subtitle", "time": 16621.109, "timestamp": "04:37:01", "text": "自分。あなたは彼が魔法について話したと言いました"}, {"type": "subtitle", "time": 16625.109, "timestamp": "04:37:05", "text": "何？飼い慣らされたゾンビ。"}, {"type": "subtitle", "time": 16630.709, "timestamp": "04:37:10", "text": "彼は、"}, {"type": "subtitle", "time": 16632.869, "timestamp": "04:37:12", "text": "感染しないように。たとえ彼らが"}, {"type": "subtitle", "time": 16636.551, "timestamp": "04:37:16", "text": "噛まれた人は何でも言うだろう。"}, {"type": "subtitle", "time": 16638.31, "timestamp": "04:37:18", "text": "彼はこれを持っていた。また、"}, {"type": "subtitle", "time": 16642.23, "timestamp": "04:37:22", "text": "音声は今ですか？うわぁ。これは方法のようです"}, {"type": "subtitle", "time": 16645.029, "timestamp": "04:37:25", "text": "ハーから出て。"}, {"type": "subtitle", "time": 16647.51, "timestamp": "04:37:27", "text": "抗毒素が不足している。私たちはしなければならない"}, {"type": "subtitle", "time": 16650.551, "timestamp": "04:37:30", "text": "あらゆる可能性を探る。"}, {"type": "subtitle", "time": 16653.189, "timestamp": "04:37:33", "text": "ああ、これから出かけるんだ。待って"}, {"type": "subtitle", "time": 16658.349, "timestamp": "04:37:38", "text": "より長く。雨が降ってるけど、行こう。私はそれが好きです"}, {"type": "subtitle", "time": 16661.029, "timestamp": "04:37:41", "text": "さみしい。わーい。"}, {"type": "subtitle", "time": 16663.91, "timestamp": "04:37:43", "text": "近寄るな。近寄るな。あなたはしない"}, {"type": "subtitle", "time": 16667.99, "timestamp": "04:37:47", "text": "理解する。母親。母親。"}, {"type": "subtitle", "time": 16674.109, "timestamp": "04:37:54", "text": "母親。の母親"}]
[{"type": "subtitle", "time": 5161.91, "timestamp": "01:26:01", "text": "ズーイーズ。それはとても可愛いですね。えっと、"}, {"type": "subtitle", "time": 5164.629, "timestamp": "01:26:04", "text": "ガーデンゲーム。うわ、ガラクタ。になるな"}, {"type": "subtitle", "time": 5168.229, "timestamp": "01:26:08", "text": "ブーマー世代。文学専攻。間違っている。私"}, {"type": "subtitle", "time": 5171.83, "timestamp": "01:26:11", "text": "勉強しろよ、兄弟。これはインターネットを席巻する出来事だ。"}, {"type": "subtitle", "time": 5174.55, "timestamp": "01:26:14", "text": "ズーミーとは、猫や犬が逃げ出すときに"}, {"type": "subtitle", "time": 5177.51, "timestamp": "01:26:17", "text": "家の中をとても速く通り抜けたのは、"}, {"type": "subtitle", "time": 5191.27, "timestamp": "01:26:31", "text": "また、ジョックが"}, {"type": "subtitle", "time": 5192.95, "timestamp": "01:26:32", "text": "彼は頭を撫でていた"}, {"type": "subtitle", "time": 5203.11, "timestamp": "01:26:43", "text": "ジョックは頭を撫でる絵文字みたいな感じ"}, {"type": "subtitle", "time": 5206.39, "timestamp": "01:26:46", "text": "あなたのプロフィールで"}, {"type": "subtitle", "time": 5209.79, "timestamp": "01:26:49", "text": "写真。ああ、ベイビー。私もそれを持っています。"}, {"type": "subtitle", "time": 5212.75, "timestamp": "01:26:52", "text": "待って。どこですか？そこにいる"}, {"type": "chat", "time": 5213.468, "timestamp": "01:26:53", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "headpat the chat yes"}, {"type": "chat", "time": 5214.97, "timestamp": "01:26:54", "author": "@Victor-MrinMoy", "avatar": "https://yt4.ggpht.com/Gaz0C79q_RG4g0C-14BlD7DV4KSkdqrEdWKhEr9EeavJEbCjSnvHS0Wd2lGovXii5XhBOCaWnQ=s64-c-k-c0x00ffffff-no-rj", "message": "I can see him doing that"}, {"type": "subtitle", "time": 5216.31, "timestamp": "01:26:56", "text": "行く。うん。オーラルセックスをしてもらえるよ。みんな"}]
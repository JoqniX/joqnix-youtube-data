[{"type": "subtitle", "time": 14642.79, "timestamp": "04:04:02", "text": "学業関係のこともだけど、そう、6月は私の"}, {"type": "subtitle", "time": 14645.11, "timestamp": "04:04:05", "text": "試験は、つまり、その間、その間、"}, {"type": "subtitle", "time": 14647.11, "timestamp": "04:04:07", "text": "私はジョッカソンに参加しています。配信は"}, {"type": "subtitle", "time": 14652.63, "timestamp": "04:04:12", "text": "1日に最大2回だったと思います。はい。"}, {"type": "subtitle", "time": 14655.83, "timestamp": "04:04:15", "text": "そして6月の最終週は"}, {"type": "subtitle", "time": 14657.67, "timestamp": "04:04:17", "text": "荷物を全部詰める時間が必要で、"}, {"type": "subtitle", "time": 14660.15, "timestamp": "04:04:20", "text": "最後にお別れを言ってください。私たちは"}, {"type": "subtitle", "time": 14663.429, "timestamp": "04:04:23", "text": "最終プッシュ配信、最終週"}, {"type": "subtitle", "time": 14665.99, "timestamp": "04:04:25", "text": "ジョアトン。最後の追い込みをします。"}, {"type": "subtitle", "time": 14669.07, "timestamp": "04:04:29", "text": "私はそれを第4段階と呼んでいます。"}, {"type": "subtitle", "time": 14672.269, "timestamp": "04:04:32", "text": "えーと、どこでお別れを言うかというと"}, {"type": "subtitle", "time": 14675.59, "timestamp": "04:04:35", "text": "すべて、私のPC、私の友人たちへ、"}, {"type": "subtitle", "time": 14677.75, "timestamp": "04:04:37", "text": "すべて。"}, {"type": "subtitle", "time": 14680.15, "timestamp": "04:04:40", "text": "そして専用のストリームを用意します"}, {"type": "subtitle", "time": 14682.03, "timestamp": "04:04:42", "text": "最終日"}, {"type": "subtitle", "time": 14684.79, "timestamp": "04:04:44", "text": "ジョアトン。うん。"}, {"type": "subtitle", "time": 14688.99, "timestamp": "04:04:48", "text": "それで、その後日本で、おそらく"}, {"type": "subtitle", "time": 14693.59, "timestamp": "04:04:53", "text": "7月、週半ば、7月中旬または下旬、"}, {"type": "subtitle", "time": 14695.91, "timestamp": "04:04:55", "text": "ストリーミング配信を再開できるようになります"}, {"type": "subtitle", "time": 14698.63, "timestamp": "04:04:58", "text": "全てが解決したと確信したら"}]
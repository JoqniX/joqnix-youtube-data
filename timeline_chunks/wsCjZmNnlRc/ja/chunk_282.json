[{"type": "subtitle", "time": 16923.628, "timestamp": "04:42:03", "text": "良い。彼らを見てごらん。彼はジャンプしている"}, {"type": "subtitle", "time": 16925.75, "timestamp": "04:42:05", "text": "山々。えっと、ちょっと待って、何か聞こえたんだけど"}, {"type": "subtitle", "time": 16933.31, "timestamp": "04:42:13", "text": "[音楽]"}, {"type": "subtitle", "time": 16936.15, "timestamp": "04:42:16", "text": "いいえ、光の主なことは"}, {"type": "subtitle", "time": 16939.75, "timestamp": "04:42:19", "text": "このシリーズの特徴は、膨大なゲームメカニクスです。"}, {"type": "subtitle", "time": 16941.99, "timestamp": "04:42:21", "text": "公園での通話とか、そういうこと。それが"}, {"type": "subtitle", "time": 16943.47, "timestamp": "04:42:23", "text": "それは私の好みです"}, {"type": "subtitle", "time": 16970.35, "timestamp": "04:42:50", "text": "えっと、それはビンです。いらっしゃいませ"}, {"type": "subtitle", "time": 16973.11, "timestamp": "04:42:53", "text": "ビットコインを窓際まで。はい、私たちは"}, {"type": "subtitle", "time": 16975.15, "timestamp": "04:42:55", "text": "そこへ行くには、"}, {"type": "subtitle", "time": 16979.15, "timestamp": "04:42:59", "text": "右？ああ、私たちは"}]
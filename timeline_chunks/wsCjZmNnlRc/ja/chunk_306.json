[{"type": "subtitle", "time": 18360.07, "timestamp": "05:06:00", "text": "道。"}, {"type": "subtitle", "time": 18363.43, "timestamp": "05:06:03", "text": "エリー・カイル・クレーン・エスキ、私に"}, {"type": "subtitle", "time": 18365.35, "timestamp": "05:06:05", "text": "せめて何かヒントは？皆さんはどう思いますか？"}, {"type": "subtitle", "time": 18367.99, "timestamp": "05:06:07", "text": "必要？お手伝いできるかもしれません。"}, {"type": "subtitle", "time": 18370.07, "timestamp": "05:06:10", "text": "覚えておいてください、"}, {"type": "subtitle", "time": 18374.55, "timestamp": "05:06:14", "text": "いつか恩恵を受ける日が来るだろう。ある日。はい、わかりました。"}, {"type": "subtitle", "time": 18376.31, "timestamp": "05:06:16", "text": "地下水がしばらく汚染されていた"}, {"type": "subtitle", "time": 18378.628, "timestamp": "05:06:18", "text": "戻る。もしあなたが"}, {"type": "subtitle", "time": 18380.55, "timestamp": "05:06:20", "text": "水道が再び使えるようになった。推測する"}, {"type": "subtitle", "time": 18383.43, "timestamp": "05:06:23", "text": "これを実現する方法はあります。はい、そこに"}, {"type": "subtitle", "time": 18385.27, "timestamp": "05:06:25", "text": "は。配管工事はあまりやったことがない"}, {"type": "subtitle", "time": 18388.31, "timestamp": "05:06:28", "text": "このゲームでは。選挙運動において。私は知っている"}, {"type": "subtitle", "time": 18390.47, "timestamp": "05:06:30", "text": "そこへ行きなさい。ああ、なんてことだ、"}, {"type": "subtitle", "time": 18393.67, "timestamp": "05:06:33", "text": "修正するための多くのミッション、いいえ、あなたが"}, {"type": "subtitle", "time": 18395.11, "timestamp": "05:06:35", "text": "死を迎える。 1つだけだったと思います"}, {"type": "subtitle", "time": 18396.708, "timestamp": "05:06:36", "text": "任務ですよね？あとは、"}, {"type": "subtitle", "time": 18402.35, "timestamp": "05:06:42", "text": "電源を入れる"}, {"type": "subtitle", "time": 18405.35, "timestamp": "05:06:45", "text": "電気の汚いパイプを通り過ぎる"}, {"type": "subtitle", "time": 18407.55, "timestamp": "05:06:47", "text": "フィールドまたは"}, {"type": "subtitle", "time": 18409.31, "timestamp": "05:06:49", "text": "何か。"}, {"type": "subtitle", "time": 18413.23, "timestamp": "05:06:53", "text": "うん。ポンプ場まで車で行く。"}, {"type": "subtitle", "time": 18416.55, "timestamp": "05:06:56", "text": "わかった。ねえ、この人誰？"}, {"type": "subtitle", "time": 18418.67, "timestamp": "05:06:58", "text": "彼女は私たちのアップグレード版ですか？"}]
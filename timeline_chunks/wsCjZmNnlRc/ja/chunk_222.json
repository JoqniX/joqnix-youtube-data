[{"type": "subtitle", "time": 13322.87, "timestamp": "03:42:02", "text": "たくさん。ええ、私にはできないと思います"}, {"type": "subtitle", "time": 13325.429, "timestamp": "03:42:05", "text": "この4ヶ月以内にデビューする"}, {"type": "subtitle", "time": 13327.51, "timestamp": "03:42:07", "text": "奇跡が起こる。私はそうは思わない"}, {"type": "subtitle", "time": 13329.79, "timestamp": "03:42:09", "text": "それは起こるだろうが、私は"}, {"type": "subtitle", "time": 13333.07, "timestamp": "03:42:13", "text": "分かっているけど、諦めずに努力し続けるよ。"}, {"type": "subtitle", "time": 13335.63, "timestamp": "03:42:15", "text": "わかった。ええ、"}, {"type": "subtitle", "time": 13339.91, "timestamp": "03:42:19", "text": "そして、これらすべては、皆さんの多くが知っていることです。"}, {"type": "subtitle", "time": 13342.429, "timestamp": "03:42:22", "text": "本当に私を応援したいなら"}, {"type": "subtitle", "time": 13345.51, "timestamp": "03:42:25", "text": "ヘルプ。たとえできたとしてもできなかったとしても"}, {"type": "subtitle", "time": 13347.83, "timestamp": "03:42:27", "text": "サポートがあれば、すべて大丈夫です。ただあなたに尋ねたいだけです"}, {"type": "subtitle", "time": 13349.67, "timestamp": "03:42:29", "text": "私の配信を見ていただければ、"}, {"type": "subtitle", "time": 13352.15, "timestamp": "03:42:32", "text": "特にYouTubeでは。私は手に入れようとしています"}, {"type": "subtitle", "time": 13355.19, "timestamp": "03:42:35", "text": "YouTubeで収益化されるか、YouTubeになる"}, {"type": "subtitle", "time": 13358.389, "timestamp": "03:42:38", "text": "パートナーがいれば、少なくとも"}, {"type": "subtitle", "time": 13360.71, "timestamp": "03:42:40", "text": "私の配信を見ている人たちへのTwitch体験"}, {"type": "subtitle", "time": 13363.75, "timestamp": "03:42:43", "text": "YouTube の jocknick エモートや"}, {"type": "subtitle", "time": 13366.309, "timestamp": "03:42:46", "text": "すべて完了し、ついに人々を襲撃できます"}, {"type": "subtitle", "time": 13370.11, "timestamp": "03:42:50", "text": "私の友人たちはYouTuberでコンテンツクリエイターです"}, {"type": "subtitle", "time": 13374.229, "timestamp": "03:42:54", "text": "今では多くのものを作り出すクリエイターが増えている。そうですね、"}, {"type": "subtitle", "time": 13376.55, "timestamp": "03:42:56", "text": "しかし、それも私の目標の一つです"}, {"type": "subtitle", "time": 13379.349, "timestamp": "03:42:59", "text": "収益化まで1年。私はそうは思わない"}]
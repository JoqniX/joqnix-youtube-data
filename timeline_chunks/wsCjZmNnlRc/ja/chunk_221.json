[{"type": "subtitle", "time": 13261.95, "timestamp": "03:41:01", "text": "私はマーケティングにあまり力を入れていません"}, {"type": "subtitle", "time": 13264.55, "timestamp": "03:41:04", "text": "もしくは、そういうこと全部、だって知らなかったから"}, {"type": "subtitle", "time": 13268.309, "timestamp": "03:41:08", "text": "どうやって、でも、私は小さいので"}, {"type": "subtitle", "time": 13269.83, "timestamp": "03:41:09", "text": "クリエイター"}, {"type": "subtitle", "time": 13272.71, "timestamp": "03:41:12", "text": "ああ、それは本当に難しいだろう"}, {"type": "subtitle", "time": 13275.75, "timestamp": "03:41:15", "text": "ジョアトンの目標は"}, {"type": "subtitle", "time": 13277.63, "timestamp": "03:41:17", "text": "実は"}, {"type": "subtitle", "time": 13282.229, "timestamp": "03:41:22", "text": "ええと、実際は2000ドルです。"}, {"type": "subtitle", "time": 13287.03, "timestamp": "03:41:27", "text": "2,00 の理由は、えっと、必要だったからだと思います"}, {"type": "subtitle", "time": 13290.15, "timestamp": "03:41:30", "text": "えっと、9歳未満だと、1000ドル必要だと思う"}, {"type": "subtitle", "time": 13292.15, "timestamp": "03:41:32", "text": "リギング用"}, {"type": "subtitle", "time": 13295.349, "timestamp": "03:41:35", "text": "ええと、モデルは持っているのですが、いくつか"}, {"type": "subtitle", "time": 13298.229, "timestamp": "03:41:38", "text": "そのお金で直さなきゃいけないもの"}, {"type": "subtitle", "time": 13301.349, "timestamp": "03:41:41", "text": "それに加えて、リギング費用、それから私が"}, {"type": "subtitle", "time": 13304.71, "timestamp": "03:41:44", "text": "その後、もし余分なものがあれば"}, {"type": "subtitle", "time": 13307.55, "timestamp": "03:41:47", "text": "それは"}, {"type": "subtitle", "time": 13310.469, "timestamp": "03:41:50", "text": "デビュー準備とか色々あって"}, {"type": "subtitle", "time": 13313.03, "timestamp": "03:41:53", "text": "少なくともデビューはできる。いや、それは"}, {"type": "subtitle", "time": 13315.59, "timestamp": "03:41:55", "text": "私は何年も待っていた"}, {"type": "subtitle", "time": 13319.03, "timestamp": "03:41:59", "text": "デビューさせるためだけに、私は辛抱強く待っていました"}]
[{"type": "subtitle", "time": 1260.23, "timestamp": "00:21:00", "text": "配信では言えない。えーっと、休止について"}, {"type": "subtitle", "time": 1262.59, "timestamp": "00:21:02", "text": "休止期間。"}, {"type": "subtitle", "time": 1264.87, "timestamp": "00:21:04", "text": "ああ、わかりました。わかった。ええ、私は"}, {"type": "subtitle", "time": 1266.63, "timestamp": "00:21:06", "text": "何が起こったのか尋ねるのに手間をかける"}, {"type": "subtitle", "time": 1268.39, "timestamp": "00:21:08", "text": "休止期間中。つまり、厳密に言えば、"}, {"type": "subtitle", "time": 1269.669, "timestamp": "00:21:09", "text": "ご覧の通り、私は活動休止中ですが、"}, {"type": "subtitle", "time": 1279.35, "timestamp": "00:21:19", "text": "うん。うん。うん。私は"}, {"type": "chat", "time": 1280.553, "timestamp": "00:21:20", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "3 5 6 and 8 are big numbers in Chinese culture as a reference to Chinese elements or spiritual beliefs. 4 is avoid since is has the same written characters for \"death\"."}, {"type": "subtitle", "time": 1282.23, "timestamp": "00:21:22", "text": "すでに私がいた地点は"}, {"type": "subtitle", "time": 1285.27, "timestamp": "00:21:25", "text": "もう諦めそうだった"}, {"type": "subtitle", "time": 1289.909, "timestamp": "00:21:29", "text": "でも、そうしなくてよかったと思っています。それで、休憩"}, {"type": "subtitle", "time": 1291.87, "timestamp": "00:21:31", "text": "少し役に立った"}, {"type": "subtitle", "time": 1295.35, "timestamp": "00:21:35", "text": "そんな感じ。ごめん。私は見ていた"}, {"type": "subtitle", "time": 1297.99, "timestamp": "00:21:37", "text": "ビデオ。"}, {"type": "subtitle", "time": 1299.63, "timestamp": "00:21:39", "text": "どうでしたか"}, {"type": "subtitle", "time": 1301.83, "timestamp": "00:21:41", "text": "ビデオ？いいえ、今まさに見ています"}, {"type": "subtitle", "time": 1304.71, "timestamp": "00:21:44", "text": "今すぐ。私は最高のものを見ていました"}, {"type": "subtitle", "time": 1306.23, "timestamp": "00:21:46", "text": "リー・クアヌの、そして最初に"}, {"type": "subtitle", "time": 1308.07, "timestamp": "00:21:48", "text": "赤ちゃんに起こった出来事だった。"}, {"type": "chat", "time": 1313.132, "timestamp": "00:21:53", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "4 is considered bad Luck basically"}]
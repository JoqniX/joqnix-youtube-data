[{"type": "subtitle", "time": 17280.708, "timestamp": "04:48:00", "text": "助けてください。ジャセルについては、"}, {"type": "subtitle", "time": 17284.07, "timestamp": "04:48:04", "text": "これを理解してください。何かを盗んだ場合、"}, {"type": "subtitle", "time": 17287.67, "timestamp": "04:48:07", "text": "両手を失う。何てことだ。彼は"}, {"type": "subtitle", "time": 17290.868, "timestamp": "04:48:10", "text": "一目見た瞬間から私を脅迫してきた。"}, {"type": "subtitle", "time": 17292.19, "timestamp": "04:48:12", "text": "カイではない。"}, {"type": "subtitle", "time": 17296.23, "timestamp": "04:48:16", "text": "それから中に入るんだと思う。でも私たちは"}, {"type": "subtitle", "time": 17299.91, "timestamp": "04:48:19", "text": "中に入ることはできません。わかった。 N"}, {"type": "subtitle", "time": 17303.11, "timestamp": "04:48:23", "text": "見知らぬ人よ、私はあなたを監視している。わかった、"}, {"type": "subtitle", "time": 17305.35, "timestamp": "04:48:25", "text": "彼は私の心を奪った。わかりました、それを認めましょう。言い訳"}, {"type": "subtitle", "time": 17307.91, "timestamp": "04:48:27", "text": "自分。私は何も知りません。見て、"}, {"type": "subtitle", "time": 17309.11, "timestamp": "04:48:29", "text": "誰かを見つける場所を教えてください"}, {"type": "subtitle", "time": 17311.67, "timestamp": "04:48:31", "text": "誰か何か知っている人はいますか？探す"}, {"type": "subtitle", "time": 17313.83, "timestamp": "04:48:33", "text": "ジャズミュージシャン。彼は納屋の中にいるだろう。内部"}, {"type": "subtitle", "time": 17323.03, "timestamp": "04:48:43", "text": "これが絆ですよね？あなたは"}, {"type": "subtitle", "time": 17325.03, "timestamp": "04:48:45", "text": "来て。私もあなたと話します。"}, {"type": "subtitle", "time": 17327.99, "timestamp": "04:48:47", "text": "母に祝福あれ。彼はタトゥーを入れている"}, {"type": "subtitle", "time": 17330.07, "timestamp": "04:48:50", "text": "彼の胸に。聞いてくれ、私はただ"}, {"type": "subtitle", "time": 17332.628, "timestamp": "04:48:52", "text": "情報。私は何も知りません。あなた"}, {"type": "subtitle", "time": 17335.83, "timestamp": "04:48:55", "text": "ジャズに聞いてみるべきだ。ジャズ。ああ、わかった。どこ"}, {"type": "subtitle", "time": 17338.948, "timestamp": "04:48:58", "text": "彼を見つけるにはどうすればいいですか？納屋の中。で"}]
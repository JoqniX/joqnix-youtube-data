[{"type": "subtitle", "time": 13441.67, "timestamp": "03:44:01", "text": "私にはできると信じている。たとえ私がそうしなければならないとしても"}, {"type": "subtitle", "time": 13444.63, "timestamp": "03:44:04", "text": "アルバイト、勉強、試験、"}, {"type": "subtitle", "time": 13447.91, "timestamp": "03:44:07", "text": "私が賢明なことすべて、そしてただ"}, {"type": "subtitle", "time": 13450.07, "timestamp": "03:44:10", "text": "ストリーミングの場合は2、3時間です。"}, {"type": "subtitle", "time": 13452.469, "timestamp": "03:44:12", "text": "大丈夫。全く問題ありません。"}, {"type": "subtitle", "time": 13455.99, "timestamp": "03:44:15", "text": "そして私は最善を尽くすつもりです"}, {"type": "subtitle", "time": 13458.55, "timestamp": "03:44:18", "text": "うん、入ったら配信するように頑張るよ"}, {"type": "subtitle", "time": 13460.51, "timestamp": "03:44:20", "text": "日本として"}, {"type": "subtitle", "time": 13463.99, "timestamp": "03:44:23", "text": "良い。ええ、そうですね、それにはしばらく時間がかかります。"}, {"type": "subtitle", "time": 13466.229, "timestamp": "03:44:26", "text": "4ヶ月間のパフォーマンス期間後"}, {"type": "subtitle", "time": 13469.75, "timestamp": "03:44:29", "text": "jocknik Q1 の Q1 と呼ぶのは、"}, {"type": "subtitle", "time": 13473.309, "timestamp": "03:44:33", "text": "えーと、このイベントの第一段階"}, {"type": "subtitle", "time": 13477.429, "timestamp": "03:44:37", "text": "このイベントの第1問。ええと、私たちは"}, {"type": "subtitle", "time": 13479.91, "timestamp": "03:44:39", "text": "この寄付目標額。もし私たちが持っているなら"}, {"type": "subtitle", "time": 13482.95, "timestamp": "03:44:42", "text": "4 4 以内にこれを入手できませんでした"}, {"type": "subtitle", "time": 13485.269, "timestamp": "03:44:45", "text": "1ヶ月間、私は"}, {"type": "subtitle", "time": 13487.91, "timestamp": "03:44:47", "text": "長期的な寄付目標のようなものです。病気"}, {"type": "subtitle", "time": 13490.469, "timestamp": "03:44:50", "text": "開けたままにしておいてください。はい、それはすべての"}, {"type": "subtitle", "time": 13492.229, "timestamp": "03:44:52", "text": "ストリーム。たとえ私が1、2回配信したとしても"}, {"type": "subtitle", "time": 13495.51, "timestamp": "03:44:55", "text": "最大時間。ええ、それが私ができることです"}, {"type": "subtitle", "time": 13498.469, "timestamp": "03:44:58", "text": "言う。そして私の重要な点に戻ると"}]
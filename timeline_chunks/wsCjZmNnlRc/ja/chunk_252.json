[{"type": "subtitle", "time": 15121.51, "timestamp": "04:12:01", "text": "分。こんにちは。"}, {"type": "subtitle", "time": 15124.07, "timestamp": "04:12:04", "text": "要約すると、私はジョアソンに参加しています"}, {"type": "subtitle", "time": 15127.59, "timestamp": "04:12:07", "text": "vub デビューとモデルに資金を提供するため"}, {"type": "subtitle", "time": 15131.11, "timestamp": "04:12:11", "text": "そして、私たちが何にあろうとも、もし可能であれば"}, {"type": "subtitle", "time": 15134.469, "timestamp": "04:12:14", "text": "この目標を達成するには、最低限"}, {"type": "subtitle", "time": 15137.75, "timestamp": "04:12:17", "text": "えーと、リギングには960が必要です"}, {"type": "subtitle", "time": 15138.75, "timestamp": "04:12:18", "text": "えーと、"}, {"type": "subtitle", "time": 15140.67, "timestamp": "04:12:20", "text": "リギング"}, {"type": "subtitle", "time": 15143.75, "timestamp": "04:12:23", "text": "えっと、これを手に入れたら、私は"}, {"type": "subtitle", "time": 15146.91, "timestamp": "04:12:26", "text": "リギングの手数料"}, {"type": "subtitle", "time": 15149.83, "timestamp": "04:12:29", "text": "でも、残りのお金は"}, {"type": "subtitle", "time": 15152.95, "timestamp": "04:12:32", "text": "デビュー作に出演する予定だ。えっと、私は"}, {"type": "subtitle", "time": 15154.63, "timestamp": "04:12:34", "text": "大規模なバンド再編成をするんですよね？私は行けません"}, {"type": "subtitle", "time": 15158.309, "timestamp": "04:12:38", "text": "残念ながら、現在のスポーツマン関連の話題では"}, {"type": "subtitle", "time": 15160.469, "timestamp": "04:12:40", "text": "これはハイエンドモデルなんだよ、いいかい？その"}, {"type": "subtitle", "time": 15163.03, "timestamp": "04:12:43", "text": "高級で上位グレード。私はそうしなければならない"}, {"type": "subtitle", "time": 15166.389, "timestamp": "04:12:46", "text": "これでプロになれるので、"}, {"type": "subtitle", "time": 15169.71, "timestamp": "04:12:49", "text": "プロとして最善を尽くします"}, {"type": "subtitle", "time": 15171.99, "timestamp": "04:12:51", "text": "クリエイター。私はその立場に到達しなければならない"}, {"type": "subtitle", "time": 15173.63, "timestamp": "04:12:53", "text": "私の"}, {"type": "subtitle", "time": 15176.87, "timestamp": "04:12:56", "text": "目。そうですね、最善を尽くしましょう。"}, {"type": "subtitle", "time": 15178.67, "timestamp": "04:12:58", "text": "はい、私はたくさんのものを持っています"}]
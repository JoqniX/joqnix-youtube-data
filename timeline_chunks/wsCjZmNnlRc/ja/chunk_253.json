[{"type": "subtitle", "time": 15181.269, "timestamp": "04:13:01", "text": "計画済み。私は夢を諦めない。"}, {"type": "subtitle", "time": 15183.429, "timestamp": "04:13:03", "text": "私は膨らませたくない。私は"}, {"type": "subtitle", "time": 15185.91, "timestamp": "04:13:05", "text": "頑固。私はわがままです。私は本当にバカだ。私"}, {"type": "subtitle", "time": 15187.91, "timestamp": "04:13:07", "text": "知る。自分が何をしているのか分からない。私は"}, {"type": "subtitle", "time": 15189.79, "timestamp": "04:13:09", "text": "若い。私は"}, {"type": "subtitle", "time": 15193.91, "timestamp": "04:13:13", "text": "年上。私は老化が速いけれど、年齢は変わらない"}, {"type": "subtitle", "time": 15195.95, "timestamp": "04:13:15", "text": "慰めとして。私"}, {"type": "subtitle", "time": 15200.71, "timestamp": "04:13:20", "text": "知る。私は子供っぽい。でも私は喜んで"}, {"type": "subtitle", "time": 15202.99, "timestamp": "04:13:22", "text": "これを見て"}, {"type": "subtitle", "time": 15205.67, "timestamp": "04:13:25", "text": "真実。好き嫌いに関わらず、私は"}, {"type": "subtitle", "time": 15213.99, "timestamp": "04:13:33", "text": "バガ。こんにちは。だから、メジャーが"}, {"type": "subtitle", "time": 15216.389, "timestamp": "04:13:36", "text": "情報は理解できました。だった"}, {"type": "subtitle", "time": 15219.03, "timestamp": "04:13:39", "text": "ヨアトンをやっている。イベントのタイムラインは"}, {"type": "subtitle", "time": 15222.99, "timestamp": "04:13:42", "text": "3月12日から6月中旬まで、私は"}, {"type": "subtitle", "time": 15227.469, "timestamp": "04:13:47", "text": "信じる。 20か16か、そんな感じ。"}, {"type": "subtitle", "time": 15232.269, "timestamp": "04:13:52", "text": "ウム・アンスタン。いいえ、私は叔父ではありません。私はまだ"}, {"type": "subtitle", "time": 15235.229, "timestamp": "04:13:55", "text": "アダルト。参加するみたい"}, {"type": "subtitle", "time": 15237.469, "timestamp": "04:13:57", "text": "私は"}]
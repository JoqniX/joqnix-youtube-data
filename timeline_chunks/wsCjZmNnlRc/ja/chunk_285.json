[{"type": "subtitle", "time": 17102.91, "timestamp": "04:45:02", "text": "言いたいことは、私がやること"}, {"type": "subtitle", "time": 17106.43, "timestamp": "04:45:06", "text": "それ。水に飛び込め。あなたは言う"}, {"type": "subtitle", "time": 17110.55, "timestamp": "04:45:10", "text": "いいえ。水に飛び込め。飛び込む"}, {"type": "subtitle", "time": 17118.43, "timestamp": "04:45:18", "text": "実際には飛び込むことは"}, {"type": "subtitle", "time": 17120.99, "timestamp": "04:45:20", "text": "水。"}, {"type": "subtitle", "time": 17123.15, "timestamp": "04:45:23", "text": "いいえ。"}, {"type": "subtitle", "time": 17127.11, "timestamp": "04:45:27", "text": "これ？ああ、それは魔法薬だ。"}, {"type": "subtitle", "time": 17128.83, "timestamp": "04:45:28", "text": "彼は"}, {"type": "subtitle", "time": 17132.03, "timestamp": "04:45:32", "text": "ゾンビ？彼は"}, {"type": "subtitle", "time": 17153.708, "timestamp": "04:45:53", "text": "ヒン。ゾンビが多すぎる、"}, {"type": "subtitle", "time": 17157.43, "timestamp": "04:45:57", "text": "男。何？"}]
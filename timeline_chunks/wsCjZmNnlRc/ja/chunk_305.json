[{"type": "subtitle", "time": 18300.31, "timestamp": "05:05:00", "text": "できる。でも、ネジがないんです。"}, {"type": "subtitle", "time": 18314.708, "timestamp": "05:05:14", "text": "場所。中に入ってみよう。ああ、それは"}, {"type": "subtitle", "time": 18317.59, "timestamp": "05:05:17", "text": "このAAから。わかった。あなたは探しています"}, {"type": "subtitle", "time": 18321.27, "timestamp": "05:05:21", "text": "カーンのために。 H. 彼はもういない。彼らは"}, {"type": "subtitle", "time": 18324.15, "timestamp": "05:05:24", "text": "ついに彼に出て行くように頼んだ。彼に頼んだ"}, {"type": "subtitle", "time": 18326.27, "timestamp": "05:05:26", "text": "去るってこと？ドニー。ロニー。何？で"}, {"type": "subtitle", "time": 18329.59, "timestamp": "05:05:29", "text": "銃を突きつけられて。そして、彼らとは誰のことですか？彼らはついに"}, {"type": "subtitle", "time": 18331.11, "timestamp": "05:05:31", "text": "父がするべきだったことをした"}, {"type": "subtitle", "time": 18333.03, "timestamp": "05:05:33", "text": "ずっと昔のことです。何か良いことが起こって"}, {"type": "subtitle", "time": 18335.51, "timestamp": "05:05:35", "text": "静かで一人、この辺りは静かだった、"}, {"type": "subtitle", "time": 18337.11, "timestamp": "05:05:37", "text": "それ？"}, {"type": "subtitle", "time": 18339.03, "timestamp": "05:05:39", "text": "あなたは私の質問に答えていません。もちろん"}, {"type": "subtitle", "time": 18341.35, "timestamp": "05:05:41", "text": "私はしませんでした。あなたも同じ目的でここにいる"}, {"type": "subtitle", "time": 18343.75, "timestamp": "05:05:43", "text": "彼がそうだった理由。山賊たちと同じ理由"}, {"type": "subtitle", "time": 18345.91, "timestamp": "05:05:45", "text": "私たちを放っておいてくれない。そして私たちは"}, {"type": "subtitle", "time": 18347.91, "timestamp": "05:05:47", "text": "あなたを信頼します。きっとあるはずだ"}, {"type": "subtitle", "time": 18349.75, "timestamp": "05:05:49", "text": "あなたを納得させるために、私にできることを一つ。"}, {"type": "subtitle", "time": 18352.19, "timestamp": "05:05:52", "text": "私を納得させなければなりません。私はしません"}, {"type": "subtitle", "time": 18354.628, "timestamp": "05:05:54", "text": "ケア。あなたがここにいる理由をみんなに見せましょう"}, {"type": "subtitle", "time": 18357.91, "timestamp": "05:05:57", "text": "与えること、奪うことだけではない。そして私はEsiです"}]
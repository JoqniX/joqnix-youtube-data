[{"type": "subtitle", "time": 8403.11, "timestamp": "02:20:03", "text": "そして目的。ああ、ズチ、ごめんね。"}, {"type": "subtitle", "time": 8404.349, "timestamp": "02:20:04", "text": "とにかく、"}, {"type": "subtitle", "time": 8409.19, "timestamp": "02:20:09", "text": "えっと、私の後ろにいるクリエイターの鈴木Zerさんへ、"}, {"type": "subtitle", "time": 8412.389, "timestamp": "02:20:12", "text": "あなたはまだ彼女と話しますか？ええ、そうです"}, {"type": "subtitle", "time": 8415.11, "timestamp": "02:20:15", "text": "今でも彼女とは連絡を取っている。ええ、コラボしました"}, {"type": "subtitle", "time": 8417.67, "timestamp": "02:20:17", "text": "最近彼女と会った。"}, {"type": "subtitle", "time": 8421.11, "timestamp": "02:20:21", "text": "おお、いいね。 Vチューブのおかげで彼女は脱出できる"}, {"type": "subtitle", "time": 8423.51, "timestamp": "02:20:23", "text": "悪質な荒らしコンテンツクリエイター"}, {"type": "subtitle", "time": 8426.15, "timestamp": "02:20:26", "text": "実際には、しばしばロック解除の対象となります。"}, {"type": "subtitle", "time": 8428.83, "timestamp": "02:20:28", "text": "つまり最近は、"}, {"type": "subtitle", "time": 8431.67, "timestamp": "02:20:31", "text": "VTubing。私はそれが多くの"}, {"type": "subtitle", "time": 8433.99, "timestamp": "02:20:33", "text": "特に女性がコンテンツを試す"}, {"type": "subtitle", "time": 8436.15, "timestamp": "02:20:36", "text": "感情を犠牲にしない創造。彼"}, {"type": "subtitle", "time": 8437.91, "timestamp": "02:20:37", "text": "私は人々のことを心配する必要はないと言います"}, {"type": "subtitle", "time": 8439.59, "timestamp": "02:20:39", "text": "私の本当の体をからかったり、"}, {"type": "subtitle", "time": 8441.95, "timestamp": "02:20:41", "text": "性差別主義者"}, {"type": "subtitle", "time": 8444.309, "timestamp": "02:20:44", "text": "バーチャルサッカーに関するコメント。何てことだ、"}, {"type": "subtitle", "time": 8445.67, "timestamp": "02:20:45", "text": "バーチャルサッカーは聞いたことがない"}, {"type": "subtitle", "time": 8447.67, "timestamp": "02:20:47", "text": "長い間。一方、魅力は"}, {"type": "subtitle", "time": 8449.91, "timestamp": "02:20:49", "text": "VTubing の範囲は"}, {"type": "subtitle", "time": 8452.87, "timestamp": "02:20:52", "text": "創造性とトレンドがもたらすもの。与えることができます"}, {"type": "subtitle", "time": 8455.11, "timestamp": "02:20:55", "text": "アバターたちの興味深いバックストーリー。"}, {"type": "subtitle", "time": 8457.55, "timestamp": "02:20:57", "text": "例えばバーチャル桜は"}]
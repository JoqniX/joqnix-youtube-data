[{"type": "subtitle", "time": 18661.03, "timestamp": "05:11:01", "text": "わかった。その国は国の中にある。"}, {"type": "subtitle", "time": 18662.55, "timestamp": "05:11:02", "text": "スピードこそすべてだ。速く行けば行くほど、"}, {"type": "subtitle", "time": 18664.708, "timestamp": "05:11:04", "text": "あなたが所有するドライブボーンの数が増えます。より簡単に"}, {"type": "subtitle", "time": 18667.99, "timestamp": "05:11:07", "text": "あなたを追いかけるウイルスとボルトを揺さぶる"}, {"type": "subtitle", "time": 18670.43, "timestamp": "05:11:10", "text": "道路。わかった。つまり、スピードですね。"}, {"type": "subtitle", "time": 18679.628, "timestamp": "05:11:19", "text": "スピード。そして私はどこにいるのか"}, {"type": "subtitle", "time": 18683.07, "timestamp": "05:11:23", "text": "私？これは何ですか"}, {"type": "subtitle", "time": 18706.31, "timestamp": "05:11:46", "text": "真の貴族。あなたは言う"}, {"type": "subtitle", "time": 18709.51, "timestamp": "05:11:49", "text": "あなたはこれのために死ぬのです。"}, {"type": "subtitle", "time": 18711.11, "timestamp": "05:11:51", "text": "いや、待って。ちょっと待って。ちょっと待って。病気"}, {"type": "subtitle", "time": 18718.628, "timestamp": "05:11:58", "text": "私のパークでの腕前を知っていれば、待っていてくれて構わないよ。"}]
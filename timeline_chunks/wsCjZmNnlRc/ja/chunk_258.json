[{"type": "subtitle", "time": 15482.469, "timestamp": "04:18:02", "text": "私の非現実的な夢ですが、私は"}, {"type": "subtitle", "time": 15486.149, "timestamp": "04:18:06", "text": "私はVubingを"}, {"type": "subtitle", "time": 15489.91, "timestamp": "04:18:09", "text": "より高みを目指す。私"}, {"type": "subtitle", "time": 15492.389, "timestamp": "04:18:12", "text": "難しいことは分かっています。私は戦うつもりだ"}, {"type": "subtitle", "time": 15495.389, "timestamp": "04:18:15", "text": "その夢。私は物を作りたい"}, {"type": "subtitle", "time": 15497.83, "timestamp": "04:18:17", "text": "起こる。それが私が"}, {"type": "subtitle", "time": 15501.429, "timestamp": "04:18:21", "text": "国に行くんだ、どこで結び目を"}, {"type": "subtitle", "time": 15504.87, "timestamp": "04:18:24", "text": "開始も完了したんですよね？キス"}, {"type": "subtitle", "time": 15509.11, "timestamp": "04:18:29", "text": "そして私が愛して亡くなったすべての人"}, {"type": "subtitle", "time": 15512.229, "timestamp": "04:18:32", "text": "私はこのビートのウサギの穴から抜け出した"}, {"type": "subtitle", "time": 15514.429, "timestamp": "04:18:34", "text": "彼らは皆、"}, {"type": "subtitle", "time": 15517.95, "timestamp": "04:18:37", "text": "日本、わかってる、わかってるよ"}, {"type": "subtitle", "time": 15526.229, "timestamp": "04:18:46", "text": "分かっているけど、できると思う"}, {"type": "subtitle", "time": 15528.309, "timestamp": "04:18:48", "text": "意志さえあれば道は開ける"}, {"type": "subtitle", "time": 15535.63, "timestamp": "04:18:55", "text": "私自身、私の話を聞いてくれてありがとう"}, {"type": "subtitle", "time": 15539.75, "timestamp": "04:18:59", "text": "発表と、このえーとあれ。知っている"}]
[{"type": "subtitle", "time": 13501.59, "timestamp": "03:45:01", "text": "こちらの方向を指し示してください。だから"}, {"type": "subtitle", "time": 13502.99, "timestamp": "03:45:02", "text": "重要"}, {"type": "subtitle", "time": 13507.95, "timestamp": "03:45:07", "text": "私は自分がそれに値しないことを知っています"}, {"type": "subtitle", "time": 13511.189, "timestamp": "03:45:11", "text": "これもまた、私は自分の"}, {"type": "subtitle", "time": 13514.469, "timestamp": "03:45:14", "text": "インポッシバー症候群、ジョークモードだけど、まあそうだね"}, {"type": "subtitle", "time": 13517.67, "timestamp": "03:45:17", "text": "私は自分が偽物症候群でいっぱいだと分かっています"}, {"type": "subtitle", "time": 13518.83, "timestamp": "03:45:18", "text": "それは"}, {"type": "subtitle", "time": 13522.55, "timestamp": "03:45:22", "text": "なぜ私がそれを自分の目で確かめたいのか、わかった？"}, {"type": "subtitle", "time": 13527.51, "timestamp": "03:45:27", "text": "私がそれに値するかどうか、これらすべて"}, {"type": "subtitle", "time": 13529.63, "timestamp": "03:45:29", "text": "新しい運動選手"}, {"type": "subtitle", "time": 13533.309, "timestamp": "03:45:33", "text": "くそ。失敗してほしくない。"}, {"type": "subtitle", "time": 13536.469, "timestamp": "03:45:36", "text": "わかった。この5年間または4年間"}, {"type": "subtitle", "time": 13540.63, "timestamp": "03:45:40", "text": "私自身について言えば、多くの点で失敗したと思う。"}, {"type": "subtitle", "time": 13542.75, "timestamp": "03:45:42", "text": "私はできませんでした"}, {"type": "subtitle", "time": 13546.91, "timestamp": "03:45:46", "text": "えっと、あまり仕事はしなかったと思います"}, {"type": "subtitle", "time": 13549.51, "timestamp": "03:45:49", "text": "もっと難しく、いつも考えると"}, {"type": "subtitle", "time": 13552.229, "timestamp": "03:45:52", "text": "私がこの4、5年間やってきたことは"}, {"type": "subtitle", "time": 13554.59, "timestamp": "03:45:54", "text": "悲しい"}]
[{"type": "subtitle", "time": 18543.11, "timestamp": "05:09:03", "text": "ライブ。もちろん、掃除はしたくない"}, {"type": "subtitle", "time": 18549.51, "timestamp": "05:09:09", "text": "大群。つまり、あの、手付かずの"}, {"type": "subtitle", "time": 18552.23, "timestamp": "05:09:12", "text": "ミニマップにあるアイコンの種類？それは"}, {"type": "subtitle", "time": 18561.17, "timestamp": "05:09:21", "text": "それは何のピスですか"}, {"type": "subtitle", "time": 18569.15, "timestamp": "05:09:29", "text": "あれ？行くよ"}, {"type": "subtitle", "time": 18571.67, "timestamp": "05:09:31", "text": "ここ。中に入ろうとする。あ、待って。それは"}, {"type": "subtitle", "time": 18573.91, "timestamp": "05:09:33", "text": "戦闘区域。わかった。つまり、私は"}, {"type": "subtitle", "time": 18577.83, "timestamp": "05:09:37", "text": "再装填が必要です。横から入ってください。"}, {"type": "subtitle", "time": 18588.39, "timestamp": "05:09:48", "text": "[音楽]"}]
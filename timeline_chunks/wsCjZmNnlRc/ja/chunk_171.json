[{"type": "subtitle", "time": 10262.55, "timestamp": "02:51:02", "text": "人々は、私が親切だと思っているようです"}, {"type": "subtitle", "time": 10267.19, "timestamp": "02:51:07", "text": "あなたの聴衆は奇妙だ。奇妙な人々"}, {"type": "subtitle", "time": 10269.99, "timestamp": "02:51:09", "text": "他のプラットフォームの人々。いいえ、違います"}, {"type": "chat", "time": 10272.91, "timestamp": "02:51:12", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "dayummmmm we odd"}, {"type": "subtitle", "time": 10273.11, "timestamp": "02:51:13", "text": "YouTubeで。いいえ、ストリーミングを試してみました"}, {"type": "subtitle", "time": 10274.79, "timestamp": "02:51:14", "text": "さまざまなプラットフォーム。の上"}, {"type": "chat", "time": 10275.964, "timestamp": "02:51:15", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4"}, {"type": "subtitle", "time": 10277.269, "timestamp": "02:51:17", "text": "Twitchは君のことを神と呼んでいるよ。いいえ、違います"}, {"type": "chat", "time": 10279.573, "timestamp": "02:51:19", "author": "@Victor-MrinMoy", "avatar": "https://yt4.ggpht.com/Gaz0C79q_RG4g0C-14BlD7DV4KSkdqrEdWKhEr9EeavJEbCjSnvHS0Wd2lGovXii5XhBOCaWnQ=s64-c-k-c0x00ffffff-no-rj", "message": "we are odd.... :("}, {"type": "subtitle", "time": 10280.71, "timestamp": "02:51:20", "text": "トゥイッチ。 Twitchではない。"}, {"type": "chat", "time": 10283.027, "timestamp": "02:51:23", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4"}, {"type": "subtitle", "time": 10284.469, "timestamp": "02:51:24", "text": "ああ、ビリー・ビリー。ビリー・ビリーじゃないよ。そうだった"}, {"type": "subtitle", "time": 10287.269, "timestamp": "02:51:27", "text": "インドのプラットフォーム。あの男、あの男"}, {"type": "subtitle", "time": 10289.349, "timestamp": "02:51:29", "text": "「君の声、女の子みたいだね」って言われた。"}, {"type": "subtitle", "time": 10290.79, "timestamp": "02:51:30", "text": "そして彼らは私の電話番号を知りたがっていた。私"}, {"type": "subtitle", "time": 10293.269, "timestamp": "02:51:33", "text": "誤ってWhatsAppの番号を教えてしまった。"}, {"type": "chat", "time": 10295.45, "timestamp": "02:51:35", "author": "@Victor-MrinMoy", "avatar": "https://yt4.ggpht.com/Gaz0C79q_RG4g0C-14BlD7DV4KSkdqrEdWKhEr9EeavJEbCjSnvHS0Wd2lGovXii5XhBOCaWnQ=s64-c-k-c0x00ffffff-no-rj", "message": "no lord,he didn't sleep"}, {"type": "subtitle", "time": 10295.59, "timestamp": "02:51:35", "text": "彼らは男が電話をかけ続けるのを止めなかった"}, {"type": "subtitle", "time": 10298.79, "timestamp": "02:51:38", "text": "電話して、電話して、とか。それ"}, {"type": "chat", "time": 10300.456, "timestamp": "02:51:40", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "wow"}, {"type": "subtitle", "time": 10301.75, "timestamp": "02:51:41", "text": "本当に面倒だったよ。"}, {"type": "subtitle", "time": 10304.87, "timestamp": "02:51:44", "text": "それから私は彼に自分が男の子だと伝え、"}, {"type": "subtitle", "time": 10305.55, "timestamp": "02:51:45", "text": "だった"}, {"type": "chat", "time": 10308.223, "timestamp": "02:51:48", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "\"accidently\" gave his number"}, {"type": "subtitle", "time": 10309.349, "timestamp": "02:51:49", "text": "「うわー、君は文字通り私を現金化したんだね」"}, {"type": "subtitle", "time": 10311.79, "timestamp": "02:51:51", "text": "そして、言ったように、多くの中傷と"}, {"type": "chat", "time": 10313.474, "timestamp": "02:51:53", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "and we're the odd ones?"}, {"type": "subtitle", "time": 10314.79, "timestamp": "02:51:54", "text": "えっと、インド人に対する差別用語とか、そういう類の"}, {"type": "chat", "time": 10317.896, "timestamp": "02:51:57", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "wtf"}, {"type": "subtitle", "time": 10318.63, "timestamp": "02:51:58", "text": "「一体どういうことだ？」って感じだった。私は一度も言っていません"}]
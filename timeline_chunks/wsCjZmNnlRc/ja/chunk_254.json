[{"type": "subtitle", "time": 15240.75, "timestamp": "04:14:00", "text": "つまり私は大人です"}, {"type": "subtitle", "time": 15242.429, "timestamp": "04:14:02", "text": "推測。"}, {"type": "subtitle", "time": 15246.95, "timestamp": "04:14:06", "text": "うーん、わからない。わからない。うん。しかし"}, {"type": "subtitle", "time": 15251.03, "timestamp": "04:14:11", "text": "ええと、大人なのに子供っぽい心を持っている。私は"}, {"type": "subtitle", "time": 15258.309, "timestamp": "04:14:18", "text": "若い。まあ、そうですね。"}, {"type": "subtitle", "time": 15261.429, "timestamp": "04:14:21", "text": "ええ、ヒントを一つだけ明かせます。"}, {"type": "subtitle", "time": 15265.03, "timestamp": "04:14:25", "text": "モデルに関するヒント。モデルは"}, {"type": "subtitle", "time": 15266.99, "timestamp": "04:14:26", "text": "私の現在の姿を描写する"}, {"type": "subtitle", "time": 15270.95, "timestamp": "04:14:30", "text": "自己、つまり私自身。また、"}, {"type": "subtitle", "time": 15272.269, "timestamp": "04:14:32", "text": "秘密がたくさんある"}, {"type": "subtitle", "time": 15276.07, "timestamp": "04:14:36", "text": "物事、そしてそれは私のユニークな特徴を表しています"}, {"type": "subtitle", "time": 15278.309, "timestamp": "04:14:38", "text": "私の声の特徴はまさにそれです。それはとても"}, {"type": "subtitle", "time": 15281.11, "timestamp": "04:14:41", "text": "多くの人にとって混乱を招くものであり、私ができるヒントは"}, {"type": "subtitle", "time": 15282.95, "timestamp": "04:14:42", "text": "あなたに与えるのは、その外観が"}, {"type": "subtitle", "time": 15290.389, "timestamp": "04:14:50", "text": "ああ、できるだけたくさん作って"}, {"type": "subtitle", "time": 15293.91, "timestamp": "04:14:53", "text": "ブレインストーミングやファンフィクションなど、あなたが思うことを何でも"}, {"type": "subtitle", "time": 15295.83, "timestamp": "04:14:55", "text": "それはまだ概念かもしれない"}, {"type": "subtitle", "time": 15299.349, "timestamp": "04:14:59", "text": "私はまだメインの伝承を保持しています"}]
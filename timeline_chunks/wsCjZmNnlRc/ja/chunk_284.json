[{"type": "subtitle", "time": 17041.91, "timestamp": "04:44:01", "text": "真実。私は行くべきではないと思う"}, {"type": "subtitle", "time": 17049.15, "timestamp": "04:44:09", "text": "忘れたみたい"}, {"type": "subtitle", "time": 17061.788, "timestamp": "04:44:21", "text": "それ。ああ、例えば"}, {"type": "subtitle", "time": 17065.55, "timestamp": "04:44:25", "text": "うん。何？それも"}, {"type": "subtitle", "time": 17069.59, "timestamp": "04:44:29", "text": "私の得点を奪った。いいえ。"}, {"type": "subtitle", "time": 17071.51, "timestamp": "04:44:31", "text": "太陽の子どもたちは独特の服を着ている"}, {"type": "subtitle", "time": 17074.39, "timestamp": "04:44:34", "text": "腕章を着用し、他の人を識別することで、"}, {"type": "subtitle", "time": 17075.91, "timestamp": "04:44:35", "text": "アランの人々はあなたに"}, {"type": "subtitle", "time": 17078.07, "timestamp": "04:44:38", "text": "子供たちの信頼"}, {"type": "subtitle", "time": 17085.07, "timestamp": "04:44:45", "text": "何？何てことだ。どうすればいいの？"}, {"type": "subtitle", "time": 17088.15, "timestamp": "04:44:48", "text": "これ？見えるのは緑ばかりだ。はい、私は"}, {"type": "subtitle", "time": 17090.75, "timestamp": "04:44:50", "text": "そうだと思います。それ"}, {"type": "subtitle", "time": 17094.11, "timestamp": "04:44:54", "text": "方法。いつでも飛び込むことができる"}, {"type": "subtitle", "time": 17096.75, "timestamp": "04:44:56", "text": "水。いや、それは違う"}, {"type": "subtitle", "time": 17099.67, "timestamp": "04:44:59", "text": "仕事。待って、それでうまくいくの？私はただ"}]
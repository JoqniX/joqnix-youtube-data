[{"type": "subtitle", "time": 13621.349, "timestamp": "03:47:01", "text": "私自身と私が"}, {"type": "subtitle", "time": 13624.469, "timestamp": "03:47:04", "text": "これに値する、新しい"}, {"type": "subtitle", "time": 13626.75, "timestamp": "03:47:06", "text": "ジョック、現在のジョックではなく、新しいジョック"}, {"type": "subtitle", "time": 13630.389, "timestamp": "03:47:10", "text": "アスリート。私がとても気に入っている新しいスポーツマン。"}, {"type": "subtitle", "time": 13633.67, "timestamp": "03:47:13", "text": "俺はあのモデルがすごく好きなんだよ。私は見つめる"}, {"type": "subtitle", "time": 13635.99, "timestamp": "03:47:15", "text": "毎晩それをする。寝る前に、"}, {"type": "subtitle", "time": 13637.79, "timestamp": "03:47:17", "text": "わからない。その"}, {"type": "subtitle", "time": 13641.51, "timestamp": "03:47:21", "text": "綺麗すぎるからダメなんだ。はい、それは"}, {"type": "subtitle", "time": 13645.51, "timestamp": "03:47:25", "text": "美しすぎるし、素晴らしすぎる。そして私は"}, {"type": "subtitle", "time": 13648.429, "timestamp": "03:47:28", "text": "モデル1を皆さんにお見せしたかったんです"}, {"type": "subtitle", "time": 13650.99, "timestamp": "03:47:30", "text": "日。"}, {"type": "subtitle", "time": 13654.389, "timestamp": "03:47:34", "text": "そして私は、"}, {"type": "subtitle", "time": 13657.67, "timestamp": "03:47:37", "text": "その新しいジュークを操れ。そして私はそうしなければならない"}, {"type": "subtitle", "time": 13660.189, "timestamp": "03:47:40", "text": "ふさわしい存在になる準備ができている"}, {"type": "subtitle", "time": 13664.55, "timestamp": "03:47:44", "text": "新しいモデルや新しい私を使うために"}, {"type": "subtitle", "time": 13671.59, "timestamp": "03:47:51", "text": "見せる。それが私がやっている主な理由です"}, {"type": "subtitle", "time": 13674.51, "timestamp": "03:47:54", "text": "このトークマラソン。単に探すためだけではない"}, {"type": "subtitle", "time": 13678.07, "timestamp": "03:47:58", "text": "デビューの理由を支えるための資金"}]
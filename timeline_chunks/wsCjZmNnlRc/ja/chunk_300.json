[{"type": "subtitle", "time": 18005.39, "timestamp": "05:00:05", "text": "もう少しで手に入ったのですが、"}, {"type": "subtitle", "time": 18007.63, "timestamp": "05:00:07", "text": "それ？そこにいる"}, {"type": "subtitle", "time": 18023.788, "timestamp": "05:00:23", "text": "金属接着剤ブレーキ。待って、それは"}, {"type": "subtitle", "time": 18027.19, "timestamp": "05:00:27", "text": "休憩。これがバギーです。ああ、"}, {"type": "subtitle", "time": 18029.59, "timestamp": "05:00:29", "text": "神。 Eキーを長押ししてアップグレードします。これはあなたの"}, {"type": "subtitle", "time": 18033.15, "timestamp": "05:00:33", "text": "バギーがアップグレードされました。アップグレードをインストールしてください。交換する"}, {"type": "subtitle", "time": 18035.99, "timestamp": "05:00:35", "text": "バギー。わかった。アップグレードを確認するか、"}, {"type": "subtitle", "time": 18038.628, "timestamp": "05:00:38", "text": "アクティブボタンに攻撃を割り当てる"}, {"type": "subtitle", "time": 18040.628, "timestamp": "05:00:40", "text": "顧客にトレーニングによる痛みを視覚的に伝える。"}, {"type": "subtitle", "time": 18043.83, "timestamp": "05:00:43", "text": "わかった。わかった。わかった。私はほとんどの"}, {"type": "subtitle", "time": 18044.6, "timestamp": "05:00:44", "text": "の ほとんどがDLCです。それで、ニンジャンは細胞を"}, {"type": "subtitle", "time": 18049.76, "timestamp": "05:00:49", "text": "ほとんどがDLCです。それで、ニンジャンは細胞を フューリーメタルウェットロックザロスター"}, {"type": "subtitle", "time": 18054.958, "timestamp": "05:00:54", "text": "フューリーメタルウェットロックザロスター えっと、宇宙探査車で行くべきでしょうか？"}, {"type": "subtitle", "time": 18058.958, "timestamp": "05:00:58", "text": "えっと、宇宙探査車で行くべきでしょうか？ あるいは、この金属棒を使うのも良いかもしれません"}]
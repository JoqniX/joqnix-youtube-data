[{"type": "subtitle", "time": 17647.31, "timestamp": "04:54:07", "text": "何か？ああ、あれらもある"}, {"type": "subtitle", "time": 17651.628, "timestamp": "04:54:11", "text": "えっと、あの大きな黄色いやつ"}, {"type": "subtitle", "time": 17655.27, "timestamp": "04:54:15", "text": "向かっている途中です。あ、言い忘れてた"}, {"type": "subtitle", "time": 17657.35, "timestamp": "04:54:17", "text": "あなた。持っていないなら、見つけて"}, {"type": "subtitle", "time": 17659.35, "timestamp": "04:54:19", "text": "武器をいくつか用意しなさい。ああ、こんにちは。"}, {"type": "subtitle", "time": 17661.43, "timestamp": "04:54:21", "text": "見捨てられた。"}, {"type": "subtitle", "time": 17663.75, "timestamp": "04:54:23", "text": "え、何？あなたは私に言うのを忘れていました"}, {"type": "subtitle", "time": 17666.47, "timestamp": "04:54:26", "text": "これ。まあ、彼らは重要ではなかった"}, {"type": "subtitle", "time": 17669.15, "timestamp": "04:54:29", "text": "全て。"}, {"type": "subtitle", "time": 17671.708, "timestamp": "04:54:31", "text": "まったく構造がない、"}, {"type": "subtitle", "time": 17675.59, "timestamp": "04:54:35", "text": "ビジネスはありません。"}, {"type": "subtitle", "time": 17677.83, "timestamp": "04:54:37", "text": "迷彩柄みたいですね。はい、"}, {"type": "subtitle", "time": 17680.39, "timestamp": "04:54:40", "text": "一瞬カモフラージュする。女王様、あなたは"}, {"type": "subtitle", "time": 17682.628, "timestamp": "04:54:42", "text": "彼を何とかしろ。聞いてくれ、俺は取引をしたんだ"}, {"type": "subtitle", "time": 17684.868, "timestamp": "04:54:44", "text": "一部の顧客。一度だけサインをください"}, {"type": "subtitle", "time": 17688.47, "timestamp": "04:54:48", "text": "あなたは車を手に入れました。ああ、神様。狩猟塔"}]
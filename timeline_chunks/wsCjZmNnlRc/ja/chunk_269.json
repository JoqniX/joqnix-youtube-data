[{"type": "subtitle", "time": 16142.229, "timestamp": "04:29:02", "text": "うん。今日は、"}, {"type": "subtitle", "time": 16146.63, "timestamp": "04:29:06", "text": "続いて、DLC。こんにちは。今日は"}, {"type": "subtitle", "time": 16149.429, "timestamp": "04:29:09", "text": "以下のDLCをプレイしています。探しています"}, {"type": "subtitle", "time": 16152.429, "timestamp": "04:29:12", "text": "このプレイスルーがどのように"}, {"type": "subtitle", "time": 16154.95, "timestamp": "04:29:14", "text": "なれ。皆さんが元気でいることを願っています"}, {"type": "subtitle", "time": 16158.95, "timestamp": "04:29:18", "text": "良い。いつものように、えーと、必ず"}, {"type": "subtitle", "time": 16161.67, "timestamp": "04:29:21", "text": "水分補給をして、車に詰め込む。覚えておいてください"}, {"type": "subtitle", "time": 16164.389, "timestamp": "04:29:24", "text": "まだ水を飲んでいないなら、飲んでください。そして"}, {"type": "subtitle", "time": 16167.349, "timestamp": "04:29:27", "text": "えっと、今日は日曜日ですよね？"}, {"type": "subtitle", "time": 16170.07, "timestamp": "04:29:30", "text": "今日。ええ、今日は日曜日です。今日は"}, {"type": "subtitle", "time": 16171.75, "timestamp": "04:29:31", "text": "良い一日。正直に言うと。感じる"}, {"type": "subtitle", "time": 16175.149, "timestamp": "04:29:35", "text": "気持ちの良い朝のように"}, {"type": "subtitle", "time": 16178.389, "timestamp": "04:29:38", "text": "今日。では、楽しんでください"}, {"type": "subtitle", "time": 16182.229, "timestamp": "04:29:42", "text": "落ち着かない。ということで、今日の配信では"}, {"type": "subtitle", "time": 16185.349, "timestamp": "04:29:45", "text": "短いものにしてください。おそらく私は最大"}, {"type": "subtitle", "time": 16187.429, "timestamp": "04:29:47", "text": "少なくとも2時間まで持たせようとしている"}, {"type": "subtitle", "time": 16190.55, "timestamp": "04:29:50", "text": "これで締めくくります。わかった。最大と2"}, {"type": "subtitle", "time": 16195.91, "timestamp": "04:29:55", "text": "2時間。こんにちは。私たちは、"}, {"type": "subtitle", "time": 16197.95, "timestamp": "04:29:57", "text": "私たちは次の日も死にゆく光の中で"}]
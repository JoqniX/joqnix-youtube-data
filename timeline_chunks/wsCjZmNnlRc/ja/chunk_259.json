[{"type": "subtitle", "time": 15541.75, "timestamp": "04:19:01", "text": "30分間の告知をしたかった"}, {"type": "subtitle", "time": 15544.95, "timestamp": "04:19:04", "text": "でもそれは1時間くらいになってしまったけど"}, {"type": "subtitle", "time": 15548.149, "timestamp": "04:19:08", "text": "ロックしてくれた皆さんに感謝します"}, {"type": "subtitle", "time": 15550.87, "timestamp": "04:19:10", "text": "積極的にチャットする人は"}, {"type": "subtitle", "time": 15553.03, "timestamp": "04:19:13", "text": "このアナウンスを見てください"}, {"type": "subtitle", "time": 15557.03, "timestamp": "04:19:17", "text": "将来も同様です。皆さん、ありがとうございました。"}, {"type": "subtitle", "time": 15559.429, "timestamp": "04:19:19", "text": "コンサートにご参加いただいた皆様、ありがとうございました。"}, {"type": "subtitle", "time": 15563.51, "timestamp": "04:19:23", "text": "プレートの誰が私を信じているか"}, {"type": "subtitle", "time": 15566.55, "timestamp": "04:19:26", "text": "私を信じて、"}, {"type": "subtitle", "time": 15568.349, "timestamp": "04:19:28", "text": "私を信じて"}, {"type": "subtitle", "time": 15573.269, "timestamp": "04:19:33", "text": "また。ありがとう。今ここにいられて嬉しい"}, {"type": "subtitle", "time": 15576.469, "timestamp": "04:19:36", "text": "そしてストリーミングもできるし、"}, {"type": "subtitle", "time": 15581.309, "timestamp": "04:19:41", "text": "できる、追いかけることができる"}, {"type": "subtitle", "time": 15584.469, "timestamp": "04:19:44", "text": "夢、そして私がインスピレーションを与えられることを願っています"}, {"type": "subtitle", "time": 15587.309, "timestamp": "04:19:47", "text": "あなた自身の夢の中のあなた。"}, {"type": "subtitle", "time": 15590.71, "timestamp": "04:19:50", "text": "わかった、だって私の本当の旅は"}, {"type": "subtitle", "time": 15593.83, "timestamp": "04:19:53", "text": "他人にインスピレーションを与える存在になりましょう。それが理由です"}, {"type": "subtitle", "time": 15597.349, "timestamp": "04:19:57", "text": "声を出したかったから首を短くした"}]
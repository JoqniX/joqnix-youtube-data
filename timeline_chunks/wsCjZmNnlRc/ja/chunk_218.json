[{"type": "subtitle", "time": 13081.389, "timestamp": "03:38:01", "text": "行くよ。いくら？どのぐらいの間"}, {"type": "subtitle", "time": 13084.07, "timestamp": "03:38:04", "text": "できる限り"}, {"type": "subtitle", "time": 13086.19, "timestamp": "03:38:06", "text": "これは私が保管します"}, {"type": "subtitle", "time": 13089.67, "timestamp": "03:38:09", "text": "行くよ、だってそれは夢だから、私は行くよ"}, {"type": "subtitle", "time": 13092.67, "timestamp": "03:38:12", "text": "屈服したくないし、"}, {"type": "subtitle", "time": 13096.07, "timestamp": "03:38:16", "text": "やめろ、それがどれだけのフィンとジョックか"}, {"type": "subtitle", "time": 13097.389, "timestamp": "03:38:17", "text": "手段"}, {"type": "subtitle", "time": 13100.229, "timestamp": "03:38:20", "text": "私はちょっと話が逸れてしまったけど、まあ"}, {"type": "subtitle", "time": 13102.429, "timestamp": "03:38:22", "text": "大丈夫だよ、こんにちは4番目"}, {"type": "subtitle", "time": 13106.309, "timestamp": "03:38:26", "text": "1つは、モデルなどがあるということです。"}, {"type": "subtitle", "time": 13109.269, "timestamp": "03:38:29", "text": "デビューしたかった 私はしたかった 私はしたくない"}, {"type": "subtitle", "time": 13112.87, "timestamp": "03:38:32", "text": "資金を調達するお金があるのは、"}, {"type": "subtitle", "time": 13115.99, "timestamp": "03:38:35", "text": "知らない人のために"}, {"type": "subtitle", "time": 13118.389, "timestamp": "03:38:38", "text": "ここにいる新しい人や"}, {"type": "subtitle", "time": 13120.469, "timestamp": "03:38:40", "text": "初めてそのニュースを聞いたとき"}, {"type": "subtitle", "time": 13123.03, "timestamp": "03:38:43", "text": "新しいことを始めるために日本へ行く予定です"}, {"type": "subtitle", "time": 13125.67, "timestamp": "03:38:45", "text": "私の人生の一章"}, {"type": "subtitle", "time": 13130.15, "timestamp": "03:38:50", "text": "えっと、現実の私としては、"}, {"type": "subtitle", "time": 13133.19, "timestamp": "03:38:53", "text": "それについて怖いけど、私は"}, {"type": "subtitle", "time": 13135.99, "timestamp": "03:38:55", "text": "予期せぬ出来事すべてを楽しみにしています"}]
[{"type": "subtitle", "time": 2821.309, "timestamp": "00:47:01", "text": "[音楽]"}, {"type": "subtitle", "time": 2825.589, "timestamp": "00:47:05", "text": "いや、兄弟は自分のプレートを使って、自分のプレートを使うんだ。"}, {"type": "subtitle", "time": 2828.15, "timestamp": "00:47:08", "text": "ジョックはそういうのが好きなんだ。残念ながら、私はとても"}, {"type": "subtitle", "time": 2831.589, "timestamp": "00:47:11", "text": "それは残念ですね。ジョックが"}, {"type": "subtitle", "time": 2834.309, "timestamp": "00:47:14", "text": "皿を取っている男みたいに"}, {"type": "subtitle", "time": 2836.19, "timestamp": "00:47:16", "text": "そしてまるで皿を割るように"}, {"type": "chat", "time": 2836.214, "timestamp": "00:47:16", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "but we enjoy it~"}, {"type": "subtitle", "time": 2838.79, "timestamp": "00:47:18", "text": "それ。つまり、ジョックは"}, {"type": "subtitle", "time": 2840.63, "timestamp": "00:47:20", "text": "ワイルドな一面もあるけど、あ、待って。私はそうすべきではない"}, {"type": "subtitle", "time": 2842.79, "timestamp": "00:47:22", "text": "これについて話しています。うん、ジョックは本当に"}, {"type": "subtitle", "time": 2844.79, "timestamp": "00:47:24", "text": "可愛くて優しくて思いやりのある男性。彼彼"}, {"type": "subtitle", "time": 2855.51, "timestamp": "00:47:35", "text": "ええ、皆さんは役割が逆転したんですね。は"}, {"type": "subtitle", "time": 2857.19, "timestamp": "00:47:37", "text": "ジョックの小さな女の子は"}, {"type": "chat", "time": 2865.867, "timestamp": "00:47:45", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "\"cute and kind\""}, {"type": "subtitle", "time": 2866.309, "timestamp": "00:47:46", "text": "何てことだ。"}, {"type": "subtitle", "time": 2868.23, "timestamp": "00:47:48", "text": "また、まだ学生の方は、"}, {"type": "chat", "time": 2870.272, "timestamp": "00:47:50", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "lmaooooo"}, {"type": "subtitle", "time": 2872.15, "timestamp": "00:47:52", "text": "今のうちに楽しんでおきましょう。"}, {"type": "subtitle", "time": 2874.47, "timestamp": "00:47:54", "text": "中等教育を受けている場合を除き"}, {"type": "subtitle", "time": 2876.47, "timestamp": "00:47:56", "text": "学校、それから大学まで待つ"}]
[{"type": "subtitle", "time": 13805.51, "timestamp": "03:50:05", "text": "彼ら。そう、そうしたかったのは"}, {"type": "subtitle", "time": 13808.59, "timestamp": "03:50:08", "text": "みんな私に親切にしてくれた"}, {"type": "subtitle", "time": 13813.269, "timestamp": "03:50:13", "text": "そして私はもっとお金を使いたかった"}, {"type": "subtitle", "time": 13816.389, "timestamp": "03:50:16", "text": "時間、かな。私は再び私の"}, {"type": "subtitle", "time": 13818.75, "timestamp": "03:50:18", "text": "私の人生の新たな章が始まります"}, {"type": "subtitle", "time": 13821.83, "timestamp": "03:50:21", "text": "日本。だから、出会ったすべての人に会えなくなるのが寂しいです"}, {"type": "subtitle", "time": 13824.71, "timestamp": "03:50:24", "text": "同じ出身の友達"}, {"type": "subtitle", "time": 13827.59, "timestamp": "03:50:27", "text": "私はインド出身なので、同じタイムゾーンです。"}, {"type": "subtitle", "time": 13831.269, "timestamp": "03:50:31", "text": "インドでできた友達みんなに会えなくなるのが寂しい"}, {"type": "subtitle", "time": 13832.59, "timestamp": "03:50:32", "text": "彼らにたくさん"}, {"type": "subtitle", "time": 13837.55, "timestamp": "03:50:37", "text": "今。それで、順番通りにやりたかったんです"}, {"type": "subtitle", "time": 13840.389, "timestamp": "03:50:40", "text": "彼らとより多くの時間を過ごし、"}, {"type": "subtitle", "time": 13843.75, "timestamp": "03:50:43", "text": "楽しむ。そう、これがジョアソンだ"}, {"type": "subtitle", "time": 13846.63, "timestamp": "03:50:46", "text": "は。それは私にとって大きなイベントです。"}, {"type": "subtitle", "time": 13849.189, "timestamp": "03:50:49", "text": "推測。準備不足ではあるけれど、"}, {"type": "subtitle", "time": 13851.309, "timestamp": "03:50:51", "text": "サバソン、ドナソンがどういうものか分からない"}, {"type": "subtitle", "time": 13854.71, "timestamp": "03:50:54", "text": "すべてうまくいくけど、ぶっつけ本番でやってみるよ"}, {"type": "subtitle", "time": 13857.59, "timestamp": "03:50:57", "text": "それ。私はそれを、私が"}]
[{"type": "subtitle", "time": 12240.15, "timestamp": "03:24:00", "text": "ご存知の通り、私は配信を終了することはできません。それ"}, {"type": "subtitle", "time": 12242.55, "timestamp": "03:24:02", "text": "24時間継続する必要がある。だから私は"}, {"type": "subtitle", "time": 12244.349, "timestamp": "03:24:04", "text": "おそらくシーンを切り替える"}, {"type": "subtitle", "time": 12249.389, "timestamp": "03:24:09", "text": "V. えっと、待ってください。パワーが欲しいですか？"}, {"type": "subtitle", "time": 12252.67, "timestamp": "03:24:12", "text": "ここに留まりたい、または"}, {"type": "subtitle", "time": 12255.95, "timestamp": "03:24:15", "text": "気に入ったら自由に「いいね」してください。"}, {"type": "subtitle", "time": 12258.87, "timestamp": "03:24:18", "text": "えーと、私は自分の仕事をしなくてはならないので、"}, {"type": "subtitle", "time": 12262.309, "timestamp": "03:24:22", "text": "洗濯をして、それからそんな感じ。だから、おそらく"}, {"type": "subtitle", "time": 12266.389, "timestamp": "03:24:26", "text": "チャットが望まない限り、最高とは言えない"}, {"type": "subtitle", "time": 12270.429, "timestamp": "03:24:30", "text": "マウ・チャマの"}, {"type": "subtitle", "time": 12274.389, "timestamp": "03:24:34", "text": "洗濯物をたたむのを待つASMR。"}, {"type": "subtitle", "time": 12278.19, "timestamp": "03:24:38", "text": "その場合は、ええと、それで大丈夫です"}, {"type": "subtitle", "time": 12280.75, "timestamp": "03:24:40", "text": "自分。しかし一度"}, {"type": "subtitle", "time": 12283.51, "timestamp": "03:24:43", "text": "また、男が"}, {"type": "subtitle", "time": 12285.99, "timestamp": "03:24:45", "text": "洗濯はあまり食欲をそそる作業には思えない。"}, {"type": "subtitle", "time": 12287.59, "timestamp": "03:24:47", "text": "いや、全然食欲をそそらない。そうではない"}, {"type": "subtitle", "time": 12296.309, "timestamp": "03:24:56", "text": "自分。なぜ彼らがその言葉を使うのか私にはわからない"}, {"type": "chat", "time": 12298.68, "timestamp": "03:24:58", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "chats wants both of you to rest💀"}]
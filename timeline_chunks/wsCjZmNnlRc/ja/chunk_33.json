[{"type": "subtitle", "time": 1983.43, "timestamp": "00:33:03", "text": "私は話そうとしているわけではありません。うん。いいえ、しかし"}, {"type": "subtitle", "time": 1985.83, "timestamp": "00:33:05", "text": "私は新しい文化にはノーと言います。私は愛する"}, {"type": "subtitle", "time": 1988.71, "timestamp": "00:33:08", "text": "新しい場所やスタイルを体験する"}, {"type": "subtitle", "time": 1990.389, "timestamp": "00:33:10", "text": "リビング。学ぶのは素晴らしいことだと思う"}, {"type": "subtitle", "time": 1993.11, "timestamp": "00:33:13", "text": "他者の人生経験。うん。真実、"}, {"type": "subtitle", "time": 1995.35, "timestamp": "00:33:15", "text": "真実。"}, {"type": "subtitle", "time": 1998.47, "timestamp": "00:33:18", "text": "ええ、私も同感です。うん。個人情報を晒さないでください"}, {"type": "subtitle", "time": 2001.669, "timestamp": "00:33:21", "text": "あなた自身。はい。個人情報を漏らさないでください。"}, {"type": "subtitle", "time": 2003.509, "timestamp": "00:33:23", "text": "ええと、長い間、"}, {"type": "subtitle", "time": 2005.75, "timestamp": "00:33:25", "text": "元々はどこだったか話しているんだけど"}, {"type": "subtitle", "time": 2009.43, "timestamp": "00:33:29", "text": "私は、ええと、私も長い間"}, {"type": "subtitle", "time": 2011.23, "timestamp": "00:33:31", "text": "時間は私がただの出身であることを認めなかった"}, {"type": "subtitle", "time": 2014.31, "timestamp": "00:33:34", "text": "州。だから、心配する必要はありません。えっと、"}, {"type": "subtitle", "time": 2017.75, "timestamp": "00:33:37", "text": "私は完全に100％理解しています。"}, {"type": "subtitle", "time": 2020.71, "timestamp": "00:33:40", "text": "自分の出身地を言いたい。そして私は"}, {"type": "subtitle", "time": 2022.149, "timestamp": "00:33:42", "text": "私もあなたに同意します。新しいものを受け入れる"}, {"type": "subtitle", "time": 2023.909, "timestamp": "00:33:43", "text": "文化。新しい場所を探検するのが大好きです"}, {"type": "subtitle", "time": 2026.149, "timestamp": "00:33:46", "text": "そして生活様式。それは間違いなく"}, {"type": "subtitle", "time": 2028.99, "timestamp": "00:33:48", "text": "他の人がどんな体験をしているかを見るのは本当に素晴らしい"}, {"type": "subtitle", "time": 2032.149, "timestamp": "00:33:52", "text": "人生。おお、いいね。ピーチーがあなたを見つけました"}, {"type": "subtitle", "time": 2034.07, "timestamp": "00:33:54", "text": "レディット。"}, {"type": "subtitle", "time": 2035.47, "timestamp": "00:33:55", "text": "あなたを見つけたのは"}]
[{"type": "subtitle", "time": 11842.48, "timestamp": "03:17:22", "text": "そう、私は"}, {"type": "subtitle", "time": 11844.59, "timestamp": "03:17:24", "text": "[音楽]"}, {"type": "subtitle", "time": 11848.309, "timestamp": "03:17:28", "text": "ええ、彼は現在夢を見ています"}, {"type": "subtitle", "time": 11863.429, "timestamp": "03:17:43", "text": "さて、ジョーが眠った今、あなたは"}, {"type": "subtitle", "time": 11870.07, "timestamp": "03:17:50", "text": "について？えっと、君たちは何が欲しいの？"}, {"type": "subtitle", "time": 11871.91, "timestamp": "03:17:51", "text": "話す？デリケートな話題について話すことができます"}, {"type": "subtitle", "time": 11874.87, "timestamp": "03:17:54", "text": "話題は何でも構いません"}]
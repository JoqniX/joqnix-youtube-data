[{"type": "subtitle", "time": 13140.95, "timestamp": "03:39:00", "text": "ええと、そこへ旅に出るんですね。ええ、そうします。"}, {"type": "subtitle", "time": 13143.469, "timestamp": "03:39:03", "text": "日本へ行く予定"}, {"type": "subtitle", "time": 13146.95, "timestamp": "03:39:06", "text": "7月。 7月までにはそこに着く予定です。となることによって"}, {"type": "subtitle", "time": 13149.99, "timestamp": "03:39:09", "text": "つまり、私にはあと4ヶ月あるということだ。したがって、それは"}, {"type": "subtitle", "time": 13152.389, "timestamp": "03:39:12", "text": "このイベントのタイムライン。私は持っているのは"}, {"type": "subtitle", "time": 13155.309, "timestamp": "03:39:15", "text": "今月から始まる4ヶ月間"}, {"type": "subtitle", "time": 13159.309, "timestamp": "03:39:19", "text": "行進。これをするのに4ヶ月ある"}, {"type": "subtitle", "time": 13163.91, "timestamp": "03:39:23", "text": "イベント。そして私はストリーミング配信します"}, {"type": "subtitle", "time": 13165.87, "timestamp": "03:39:25", "text": "ジョカドン"}, {"type": "subtitle", "time": 13169.59, "timestamp": "03:39:29", "text": "毎日イベント開催。頑張って取り組むつもりだ。それ"}, {"type": "subtitle", "time": 13173.429, "timestamp": "03:39:33", "text": "日常的なものになるだろう。神のみぞ知る"}, {"type": "subtitle", "time": 13177.15, "timestamp": "03:39:37", "text": "長い間ストリーミング配信をしていますが、"}, {"type": "subtitle", "time": 13179.99, "timestamp": "03:39:39", "text": "私が受講しているクラスには"}, {"type": "subtitle", "time": 13182.229, "timestamp": "03:39:42", "text": "以前私の配信で言及した"}, {"type": "subtitle", "time": 13184.469, "timestamp": "03:39:44", "text": "つまり、私は音楽の授業を受けているので、"}, {"type": "subtitle", "time": 13186.71, "timestamp": "03:39:46", "text": "音楽に集中できるのは"}, {"type": "subtitle", "time": 13190.19, "timestamp": "03:39:50", "text": "それは私の最初の夢でした"}, {"type": "subtitle", "time": 13193.429, "timestamp": "03:39:53", "text": "ジョックニックは音楽を追求し、私はゆっくりと"}, {"type": "subtitle", "time": 13196.429, "timestamp": "03:39:56", "text": "音楽を追求し、音楽を研究する"}, {"type": "subtitle", "time": 13198.87, "timestamp": "03:39:58", "text": "真剣に、そして私は日本語を勉強しています"}]
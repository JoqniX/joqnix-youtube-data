[{"type": "subtitle", "time": 8460.79, "timestamp": "02:21:00", "text": "魔法の力を持つ200歳の少女。"}, {"type": "subtitle", "time": 8462.63, "timestamp": "02:21:02", "text": "ここでは、私たちは自分たちの現実を作り、"}, {"type": "subtitle", "time": 8464.55, "timestamp": "02:21:04", "text": "デリーは美しいと言っている。あ、待って、"}, {"type": "subtitle", "time": 8467.99, "timestamp": "02:21:07", "text": "彼女はデリーを拠点とするクリエイターです。"}, {"type": "subtitle", "time": 8469.429, "timestamp": "02:21:09", "text": "実はデリー出身の友達が何人かいるんです"}, {"type": "subtitle", "time": 8472.23, "timestamp": "02:21:12", "text": "同じように。クリエイターは、"}, {"type": "subtitle", "time": 8475.03, "timestamp": "02:21:15", "text": "アバター、モデルとも呼ばれる、または"}, {"type": "subtitle", "time": 8477.11, "timestamp": "02:21:17", "text": "アーティストやアニメーターに依頼して"}, {"type": "subtitle", "time": 8479.349, "timestamp": "02:21:19", "text": "2Dまたは3Dモデルを設計・作成する"}, {"type": "subtitle", "time": 8481.83, "timestamp": "02:21:21", "text": "モデルのバージョン。これらのモデルは"}, {"type": "subtitle", "time": 8484.63, "timestamp": "02:21:24", "text": "日本のアニメ風デザインとか、その他いろいろ"}, {"type": "subtitle", "time": 8488.07, "timestamp": "02:21:28", "text": "あれこれ。 19歳のクリエイター、VTロメオ"}, {"type": "subtitle", "time": 8490.11, "timestamp": "02:21:30", "text": "アバターは"}, {"type": "subtitle", "time": 8493.27, "timestamp": "02:21:33", "text": "半分悪魔で半分人間であるデザイン"}, {"type": "subtitle", "time": 8496.15, "timestamp": "02:21:36", "text": "10モデル。何？彼らは2,000を稼いだ"}, {"type": "subtitle", "time": 8497.79, "timestamp": "02:21:37", "text": "のように"}, {"type": "subtitle", "time": 8501.469, "timestamp": "02:21:41", "text": "模型製作による収入は1,700ドル。何てことだ。"}, {"type": "subtitle", "time": 8509.74, "timestamp": "02:21:49", "text": "それはちょっと安っぽいですね。"}, {"type": "subtitle", "time": 8512.15, "timestamp": "02:21:52", "text": "[音楽]"}, {"type": "subtitle", "time": 8514.469, "timestamp": "02:21:54", "text": "アバターは自身の声で話す。平"}]
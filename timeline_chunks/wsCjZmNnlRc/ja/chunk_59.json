[{"type": "subtitle", "time": 3540.71, "timestamp": "00:59:00", "text": "ライトノベル9と21ライトノベルライト"}, {"type": "subtitle", "time": 3544.069, "timestamp": "00:59:04", "text": "小説12 ウェブ小説の黒髪"}, {"type": "subtitle", "time": 3546.39, "timestamp": "00:59:06", "text": "ダークグリーンとライトノベルとアニメ"}, {"type": "subtitle", "time": 3548.789, "timestamp": "00:59:08", "text": "ウェブ小説の黒い目の色は紫で"}, {"type": "subtitle", "time": 3553.27, "timestamp": "00:59:13", "text": "ライトノベルとアニメの青と私の"}, {"type": "subtitle", "time": 3557.91, "timestamp": "00:59:17", "text": "身長は153cm、またはアメリカ人にとっては5tです"}, {"type": "subtitle", "time": 3559.829, "timestamp": "00:59:19", "text": "ステータスは「生存」です。出生地は"}, {"type": "subtitle", "time": 3561.91, "timestamp": "00:59:21", "text": "ヴァーティグリス・ハウス。提携先"}, {"type": "subtitle", "time": 3563.91, "timestamp": "00:59:23", "text": "ヴァーティグリス・ハウス。皇居。内側"}, {"type": "subtitle", "time": 3566.87, "timestamp": "00:59:26", "text": "裁判所。外庭。えっと、私の職業は"}, {"type": "subtitle", "time": 3569.109, "timestamp": "00:59:29", "text": "薬剤師。裁判所は前者です。内側"}, {"type": "subtitle", "time": 3571.75, "timestamp": "00:59:31", "text": "宮廷は女中である。えっと、ワードローブ"}, {"type": "subtitle", "time": 3574.549, "timestamp": "00:59:34", "text": "元軍人。内庭は翡翠色"}, {"type": "subtitle", "time": 3576.95, "timestamp": "00:59:36", "text": "パビリオンの侍女。内廷"}, {"type": "subtitle", "time": 3579.349, "timestamp": "00:59:39", "text": "翡翠の東屋型毒物検査器。外庭"}, {"type": "subtitle", "time": 3581.99, "timestamp": "00:59:41", "text": "ギンシの専属メイドです。そして外側"}, {"type": "subtitle", "time": 3594.43, "timestamp": "00:59:54", "text": "ああ、なんてことだ、君は"}, {"type": "subtitle", "time": 3597.15, "timestamp": "00:59:57", "text": "実は"}]
[{"type": "subtitle", "time": 2220.069, "timestamp": "00:37:00", "text": "いやあ、それはなかなかいいですね。それは"}, {"type": "subtitle", "time": 2222.55, "timestamp": "00:37:02", "text": "とても歓迎されている感じ。えっと、確認させてください"}, {"type": "subtitle", "time": 2224.15, "timestamp": "00:37:04", "text": "彼らはTwitterか何かのアカウントを持っている。彼らの"}, {"type": "subtitle", "time": 2228.87, "timestamp": "00:37:08", "text": "次回の配信は木曜日の午前2時30分からです。"}, {"type": "subtitle", "time": 2233.75, "timestamp": "00:37:13", "text": "ええと、午前2時30分EDTAですが、それは"}, {"type": "subtitle", "time": 2242.349, "timestamp": "00:37:22", "text": "待って、あれは音楽だ。待って、待って、"}, {"type": "subtitle", "time": 2245.03, "timestamp": "00:37:25", "text": "待って。わあ、すごい。まるでストリーミング配信のよう"}, {"type": "subtitle", "time": 2247.27, "timestamp": "00:37:27", "text": "木曜日だと思う。見てみましょう"}, {"type": "subtitle", "time": 2249.31, "timestamp": "00:37:29", "text": "の"}, {"type": "subtitle", "time": 2253.19, "timestamp": "00:37:33", "text": "クリップ。すべてのクリップを表示する。ああ、クリップはありません。"}, {"type": "subtitle", "time": 2257.03, "timestamp": "00:37:37", "text": "彼らは新しいチャンネルのためにいるんです。私は感じます"}, {"type": "subtitle", "time": 2259.43, "timestamp": "00:37:39", "text": "モモはオフラインです。リラックスして来て"}, {"type": "subtitle", "time": 2261.109, "timestamp": "00:37:41", "text": "後でまた来ます。そして、もし皆さんが"}, {"type": "subtitle", "time": 2263.589, "timestamp": "00:37:43", "text": "わからない、イチゴみたい"}, {"type": "subtitle", "time": 2266.19, "timestamp": "00:37:46", "text": "腕と脚と、のんびりした男がのんびりしている"}, {"type": "subtitle", "time": 2269.95, "timestamp": "00:37:49", "text": "で、"}, {"type": "subtitle", "time": 2272.39, "timestamp": "00:37:52", "text": "背景。そして、落ち着いた男というのは、"}, {"type": "subtitle", "time": 2274.63, "timestamp": "00:37:54", "text": "何らかの理由で立っている犬。"}]
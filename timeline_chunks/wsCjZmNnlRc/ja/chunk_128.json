[{"type": "subtitle", "time": 7730.069, "timestamp": "02:08:50", "text": "そして今、ジャンクは眠りにつこうとしている。"}, {"type": "subtitle", "time": 7732.27, "timestamp": "02:08:52", "text": "おお。ああ、しまった。あ、待って。"}, {"type": "subtitle", "time": 7734.51, "timestamp": "02:08:54", "text": "実際、私はとてもとても"}, {"type": "subtitle", "time": 7738.149, "timestamp": "02:08:58", "text": "だから私は待って、どれくらい黙っていたの？"}]
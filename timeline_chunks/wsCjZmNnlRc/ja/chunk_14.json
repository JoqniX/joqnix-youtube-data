[{"type": "subtitle", "time": 845.11, "timestamp": "00:14:05", "text": "えっと、私がどうやって彼らに会ったかというと"}, {"type": "subtitle", "time": 847.43, "timestamp": "00:14:07", "text": "面白い話だ。私はランダムにスクロールしていました"}, {"type": "subtitle", "time": 849.99, "timestamp": "00:14:09", "text": "昔のウィリー・ビリーを通して"}, {"type": "subtitle", "time": 854.55, "timestamp": "00:14:14", "text": "話せる人を見つけるような感じ"}, {"type": "subtitle", "time": 857.43, "timestamp": "00:14:17", "text": "英語を知っている人のように、"}, {"type": "subtitle", "time": 858.949, "timestamp": "00:14:18", "text": "プラットフォームの使い方を教えてくれる人は誰ですか？"}, {"type": "subtitle", "time": 861.189, "timestamp": "00:14:21", "text": "作品やその他すべてに出くわし"}, {"type": "subtitle", "time": 863.75, "timestamp": "00:14:23", "text": "彼らのチャンネルをランダムに見て、気づいた"}, {"type": "subtitle", "time": 865.509, "timestamp": "00:14:25", "text": "彼らはドキュメンタリーを見るように見ていた"}, {"type": "subtitle", "time": 868.87, "timestamp": "00:14:28", "text": "VPNを使ってYouTubeのコンテンツを見る。私は"}, {"type": "subtitle", "time": 871.59, "timestamp": "00:14:31", "text": "「待って、そこに実際に人がいるよ」"}, {"type": "subtitle", "time": 874.389, "timestamp": "00:14:34", "text": "ビリーのYouTubeを実際に使っているのは誰？"}, {"type": "subtitle", "time": 876.87, "timestamp": "00:14:36", "text": "ビリー。「何？待って、待って、待って、待って、"}, {"type": "subtitle", "time": 879.189, "timestamp": "00:14:39", "text": "待って、待って。これは個人情報を晒すべきではない"}, {"type": "subtitle", "time": 881.43, "timestamp": "00:14:41", "text": "この人ですが、えっと、教えてください"}, {"type": "subtitle", "time": 884.99, "timestamp": "00:14:44", "text": "彼らのアカウント名はです。私は"}, {"type": "subtitle", "time": 886.99, "timestamp": "00:14:46", "text": "ない"}, {"type": "subtitle", "time": 889.47, "timestamp": "00:14:49", "text": "ええと、中国人"}, {"type": "subtitle", "time": 893.59, "timestamp": "00:14:53", "text": "政府。そんなことを言うべきではない。"}, {"type": "subtitle", "time": 895.43, "timestamp": "00:14:55", "text": "中国政府が聞いているなら"}]
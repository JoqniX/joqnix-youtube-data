[{"type": "subtitle", "time": 18720.35, "timestamp": "05:12:00", "text": "バカ、忘れてるよ"}, {"type": "subtitle", "time": 18755.47, "timestamp": "05:12:35", "text": "鎧。"}, {"type": "subtitle", "time": 18758.788, "timestamp": "05:12:38", "text": "死んだ。私はライフルアーマーを選びます。"}, {"type": "subtitle", "time": 18760.67, "timestamp": "05:12:40", "text": "軍隊"}, {"type": "subtitle", "time": 18763.43, "timestamp": "05:12:43", "text": "ライフル。ああ、私がこれらを殺せば殺すほど"}, {"type": "subtitle", "time": 18766.99, "timestamp": "05:12:46", "text": "人々、私が理解できないほど"}, {"type": "subtitle", "time": 18770.55, "timestamp": "05:12:50", "text": "弾薬。だから、私が主に求めているのはそれです。"}, {"type": "subtitle", "time": 18773.868, "timestamp": "05:12:53", "text": "私が殺した二人はここから来た、"}, {"type": "subtitle", "time": 18776.55, "timestamp": "05:12:56", "text": "右？見つかりません。私はどこにいた"}, {"type": "subtitle", "time": 18778.43, "timestamp": "05:12:58", "text": "あの二人を殺せ"}]
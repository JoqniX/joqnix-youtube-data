[{"type": "subtitle", "time": 8640.469, "timestamp": "02:24:00", "text": "バナナのところで。"}, {"type": "subtitle", "time": 8642.94, "timestamp": "02:24:02", "text": "ジョックが言うように"}, {"type": "subtitle", "time": 8687.75, "timestamp": "02:24:47", "text": "今。彼女はそうなのか？年齢は誰にもわからない"}, {"type": "subtitle", "time": 8691.59, "timestamp": "02:24:51", "text": "与えられたものは実際には非常に無感覚だ。"}, {"type": "subtitle", "time": 8697.19, "timestamp": "02:24:57", "text": "でも、私は彼女が自分のように明らかにしたと思う"}, {"type": "subtitle", "time": 8698.75, "timestamp": "02:24:58", "text": "母国語"}]
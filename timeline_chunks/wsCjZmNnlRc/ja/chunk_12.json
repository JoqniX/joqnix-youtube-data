[{"type": "subtitle", "time": 721.47, "timestamp": "00:12:01", "text": "話した。ええ、いろいろあります"}, {"type": "subtitle", "time": 723.829, "timestamp": "00:12:03", "text": "起こった。今でも聞こえる。聞いてもいいですか"}, {"type": "subtitle", "time": 726.79, "timestamp": "00:12:06", "text": "何が起こったのか？ええ、もちろんです。もちろん。えーと、たくさんの"}, {"type": "subtitle", "time": 729.509, "timestamp": "00:12:09", "text": "いろいろなことが起こった。いいえ、前回は"}, {"type": "subtitle", "time": 731.269, "timestamp": "00:12:11", "text": "私たちはどこから始めたのだろうか？何？私は何をしたのか"}, {"type": "subtitle", "time": 736.49, "timestamp": "00:12:16", "text": "去年のことを話しましょうか？最後に、私は"}, {"type": "subtitle", "time": 738.35, "timestamp": "00:12:18", "text": "[音楽]"}, {"type": "subtitle", "time": 741.829, "timestamp": "00:12:21", "text": "想起。わからない。うん、そう思う"}, {"type": "subtitle", "time": 745.75, "timestamp": "00:12:25", "text": "ああ、今思い出したよ。えっと、前回は"}, {"type": "subtitle", "time": 748.389, "timestamp": "00:12:28", "text": "ビリー・ビリーについて話していたのは私で、"}, {"type": "subtitle", "time": 750.629, "timestamp": "00:12:30", "text": "もの。いいえ、私がそこで配信したいんです。"}, {"type": "subtitle", "time": 754.71, "timestamp": "00:12:34", "text": "そうそう。うん。うん。ビリーを作る"}, {"type": "subtitle", "time": 756.71, "timestamp": "00:12:36", "text": "ビリーのアカウントも同様です。それが面白いところ"}, {"type": "subtitle", "time": 759.71, "timestamp": "00:12:39", "text": "もの。"}, {"type": "subtitle", "time": 764.35, "timestamp": "00:12:44", "text": "うん。ええと、それについての最新情報"}, {"type": "subtitle", "time": 767.91, "timestamp": "00:12:47", "text": "私はジョアソンをストリーミング配信しています"}, {"type": "subtitle", "time": 771.069, "timestamp": "00:12:51", "text": "あれ。そこでストリーミング配信を始めて"}, {"type": "subtitle", "time": 773.31, "timestamp": "00:12:53", "text": "いろいろあるけど"}, {"type": "subtitle", "time": 777.35, "timestamp": "00:12:57", "text": "残念ながら最近、例えば2日前"}]
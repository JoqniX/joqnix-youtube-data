[{"type": "subtitle", "time": 16441.75, "timestamp": "04:34:01", "text": "たとえ私が本当に疲れていても"}, {"type": "subtitle", "time": 16445.349, "timestamp": "04:34:05", "text": "8月11日までに帰宅します。"}, {"type": "subtitle", "time": 16447.47, "timestamp": "04:34:07", "text": "家に帰る、つまり新しい"}, {"type": "subtitle", "time": 16451.51, "timestamp": "04:34:11", "text": "両親の家から来た場所です。それで"}, {"type": "subtitle", "time": 16455.39, "timestamp": "04:34:15", "text": "うん、誕生日配信をやってみるよ"}, {"type": "subtitle", "time": 16458.07, "timestamp": "04:34:18", "text": "12日。今回も短い配信になります。"}, {"type": "subtitle", "time": 16461.429, "timestamp": "04:34:21", "text": "ええ、短いものを作ろうとしています"}, {"type": "subtitle", "time": 16464.949, "timestamp": "04:34:24", "text": "ストリームアーク。そうですね、明日は"}, {"type": "subtitle", "time": 16466.629, "timestamp": "04:34:26", "text": "Nidi ストリームの過負荷と翌日"}, {"type": "subtitle", "time": 16469.349, "timestamp": "04:34:29", "text": "明日はホグウォッチと、えーと"}, {"type": "subtitle", "time": 16471.99, "timestamp": "04:34:31", "text": "水曜日はGoogle Earthを使います。もし"}, {"type": "subtitle", "time": 16474.31, "timestamp": "04:34:34", "text": "Google Earthとは何か疑問に思っているでしょう。"}, {"type": "subtitle", "time": 16476.709, "timestamp": "04:34:36", "text": "私たちは文字通りこれを探検するでしょう"}, {"type": "subtitle", "time": 16479.91, "timestamp": "04:34:39", "text": "私たちの地球。よし、これから探検しよう"}, {"type": "subtitle", "time": 16483.67, "timestamp": "04:34:43", "text": "惑星を透視するようなこと。いいえ、"}, {"type": "subtitle", "time": 16486.349, "timestamp": "04:34:46", "text": "惑星ではなく、地球の物、"}, {"type": "subtitle", "time": 16490.551, "timestamp": "04:34:50", "text": "知る。こんにちは。でも、短いストリームARは"}, {"type": "subtitle", "time": 16492.869, "timestamp": "04:34:52", "text": "たった2時間だと思います。私はしようとしています"}, {"type": "subtitle", "time": 16495.349, "timestamp": "04:34:55", "text": "そうすることで、私は"}, {"type": "subtitle", "time": 16499.029, "timestamp": "04:34:59", "text": "スピードランでたくさんのものをこなす。うん。"}]
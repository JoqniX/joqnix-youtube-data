[{"type": "subtitle", "time": 491.55, "timestamp": "00:08:11", "text": "2番。"}, {"type": "subtitle", "time": 495.189, "timestamp": "00:08:15", "text": "こんにちは。こんにちは、ミステリオ。"}, {"type": "subtitle", "time": 499.029, "timestamp": "00:08:19", "text": "元気です。元気ですか"}, {"type": "subtitle", "time": 501.11, "timestamp": "00:08:21", "text": "何をしているの？よし。ご質問ありがとうございます。私は"}, {"type": "subtitle", "time": 504.39, "timestamp": "00:08:24", "text": "おそらく私たちはライブ配信中でしょう。はい。"}, {"type": "subtitle", "time": 510.869, "timestamp": "00:08:30", "text": "よし。ニース。しばらく経ちました"}, {"type": "subtitle", "time": 513.509, "timestamp": "00:08:33", "text": "私はここに登録しています。何てことだ。私はマウです。"}, {"type": "subtitle", "time": 520.79, "timestamp": "00:08:40", "text": "ああ、君は今だ。あなたはそれを変えたい"}, {"type": "subtitle", "time": 523.5889999999999, "timestamp": "00:08:43", "text": "それとも何か別のこと？君にあげるよ、ここにいてもいい？"}, {"type": "subtitle", "time": 525.509, "timestamp": "00:08:45", "text": "モモとして？これは実際にはかなり"}, {"type": "subtitle", "time": 527.949, "timestamp": "00:08:47", "text": "かわいい。うん、そうだね"}, {"type": "subtitle", "time": 531.71, "timestamp": "00:08:51", "text": "は。そうです。そうです。私にさせて"}]
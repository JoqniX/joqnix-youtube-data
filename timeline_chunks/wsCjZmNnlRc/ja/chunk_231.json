[{"type": "subtitle", "time": 13861.429, "timestamp": "03:51:01", "text": "これに重点を置くつもりです。だから、"}, {"type": "subtitle", "time": 13862.349, "timestamp": "03:51:02", "text": "なれ"}, {"type": "subtitle", "time": 13866.87, "timestamp": "03:51:06", "text": "ええと、適切にはないでしょう"}, {"type": "subtitle", "time": 13869.67, "timestamp": "03:51:09", "text": "別々のストリームとすべて、または"}, {"type": "subtitle", "time": 13871.59, "timestamp": "03:51:11", "text": "えーと、私がプレイリストに登録したストリーム"}, {"type": "subtitle", "time": 13874.63, "timestamp": "03:51:14", "text": "YouTube などでやっていることすべて"}, {"type": "subtitle", "time": 13877.429, "timestamp": "03:51:17", "text": "この数年間。それはただの単一の"}, {"type": "subtitle", "time": 13882.189, "timestamp": "03:51:22", "text": "イベント。えっと、私のチャンネルフィードは"}, {"type": "subtitle", "time": 13885.269, "timestamp": "03:51:25", "text": "このイベントについて詳しくはこちらをご覧ください。もし私が"}, {"type": "subtitle", "time": 13888.07, "timestamp": "03:51:28", "text": "神のみぞ知る、毎日ストリーミング配信"}, {"type": "subtitle", "time": 13891.95, "timestamp": "03:51:31", "text": "どのぐらいの間。でも、いくつかあります"}, {"type": "subtitle", "time": 13895.189, "timestamp": "03:51:35", "text": "インセンティブ、目標、コンテンツのアイデア"}, {"type": "subtitle", "time": 13898.229, "timestamp": "03:51:38", "text": "心。そうします。そしてそれは"}, {"type": "subtitle", "time": 13900.55, "timestamp": "03:51:40", "text": "適応的なこと、なぜなら私は"}, {"type": "subtitle", "time": 13903.83, "timestamp": "03:51:43", "text": "4ヶ月。皆さんにそれをあげます"}, {"type": "subtitle", "time": 13907.229, "timestamp": "03:51:47", "text": "ホイールを回す自由、"}, {"type": "subtitle", "time": 13911.75, "timestamp": "03:51:51", "text": "インセンティブがインセンティブを促すように、どんなインセンティブでも"}, {"type": "subtitle", "time": 13914.75, "timestamp": "03:51:54", "text": "あるいは罰則とか、そういう類のこと。"}, {"type": "subtitle", "time": 13916.83, "timestamp": "03:51:56", "text": "わかった。それで"}]
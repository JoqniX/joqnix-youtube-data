[{"type": "subtitle", "time": 8829.91, "timestamp": "02:27:09", "text": "歌を歌うのが好きです"}, {"type": "subtitle", "time": 8832.07, "timestamp": "02:27:12", "text": "歌声。"}, {"type": "subtitle", "time": 8832.91, "timestamp": "02:27:12", "text": "する"}, {"type": "subtitle", "time": 8841.349, "timestamp": "02:27:21", "text": "私は歌も歌えない。私は歌が下手すぎる。"}, {"type": "subtitle", "time": 8843.59, "timestamp": "02:27:23", "text": "歌い方も知らない"}, {"type": "subtitle", "time": 8845.309, "timestamp": "02:27:25", "text": "これは私の"}, {"type": "subtitle", "time": 8855.75, "timestamp": "02:27:35", "text": "私たちがしなければならないのは、Yeah を軽くたたくことだけです。"}, {"type": "subtitle", "time": 8869.91, "timestamp": "02:27:49", "text": "でも、さっきバナナ食べたばかりだよ。もしあなたが"}, {"type": "subtitle", "time": 8872.309, "timestamp": "02:27:52", "text": "前にそう言ってくれていたら、私は"}, {"type": "subtitle", "time": 8873.71, "timestamp": "02:27:53", "text": "の"}, {"type": "subtitle", "time": 8876.95, "timestamp": "02:27:56", "text": "バナナ。バナナ。私はすでに食べました"}]
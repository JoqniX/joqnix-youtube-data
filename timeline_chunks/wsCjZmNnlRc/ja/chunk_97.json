[{"type": "subtitle", "time": 5822.27, "timestamp": "01:37:02", "text": "[音楽]"}, {"type": "subtitle", "time": 5824.87, "timestamp": "01:37:04", "text": "面白い。私は地獄から統合した"}, {"type": "subtitle", "time": 5826.55, "timestamp": "01:37:06", "text": "映画『ブラック・ラグーン』のレミー役の歌手。だから私は"}, {"type": "subtitle", "time": 5828.629, "timestamp": "01:37:08", "text": "君は僕の妻だと思う。ええ、そうですね。"}, {"type": "subtitle", "time": 5869.03, "timestamp": "01:37:49", "text": "頭。ああ、青いのもあるよ"}, {"type": "subtitle", "time": 5879.51, "timestamp": "01:37:59", "text": "心配ない。アニメがたくさんある"}]
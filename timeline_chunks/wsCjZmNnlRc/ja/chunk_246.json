[{"type": "subtitle", "time": 14760.229, "timestamp": "04:06:00", "text": "YouTube では、"}, {"type": "subtitle", "time": 14765.59, "timestamp": "04:06:05", "text": "ストリーム配信でいいですか？だって、私は時計がもっと欲しいから"}, {"type": "subtitle", "time": 14769.51, "timestamp": "04:06:09", "text": "できる限り時間を使って"}, {"type": "subtitle", "time": 14771.75, "timestamp": "04:06:11", "text": "圧力をかける"}, {"type": "subtitle", "time": 14773.15, "timestamp": "04:06:13", "text": "えーと、"}, {"type": "subtitle", "time": 14775.51, "timestamp": "04:06:15", "text": "収益化。私にはできると分かっている。私"}, {"type": "subtitle", "time": 14778.03, "timestamp": "04:06:18", "text": "私のコンセラーとコンサートを信じてください"}, {"type": "subtitle", "time": 14781.55, "timestamp": "04:06:21", "text": "皿。私たちは共にこれを成し遂げることができる。"}, {"type": "subtitle", "time": 14785.189, "timestamp": "04:06:25", "text": "いいえ。そして、それを夢のままにしておきたくありません。"}, {"type": "subtitle", "time": 14788.309, "timestamp": "04:06:28", "text": "YouTubeパートナーの資格取得について。わかった。のように"}, {"type": "subtitle", "time": 14791.83, "timestamp": "04:06:31", "text": "昨年、一昨年の1日、"}, {"type": "subtitle", "time": 14793.91, "timestamp": "04:06:33", "text": "今年、私が言うたびに"}, {"type": "subtitle", "time": 14795.75, "timestamp": "04:06:35", "text": "YouTubeメンバーシップを取得したいのですが、"}, {"type": "subtitle", "time": 14798.429, "timestamp": "04:06:38", "text": "会員になりたい、"}, {"type": "subtitle", "time": 14802.229, "timestamp": "04:06:42", "text": "など。ええ。なぜなら彼らはログをしっかりロックするから"}, {"type": "subtitle", "time": 14804.55, "timestamp": "04:06:44", "text": "YouTubeの機能をこれに"}, {"type": "subtitle", "time": 14806.71, "timestamp": "04:06:46", "text": "会員制度とか、パートナー制度とか。その"}, {"type": "subtitle", "time": 14809.429, "timestamp": "04:06:49", "text": "悲しいけど、まあ、そういうものだよね。"}, {"type": "subtitle", "time": 14819.95, "timestamp": "04:06:59", "text": "わかった。うん。はい、ええと、その間"}]
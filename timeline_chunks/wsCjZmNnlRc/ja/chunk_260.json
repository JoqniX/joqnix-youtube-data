[{"type": "subtitle", "time": 15600.55, "timestamp": "04:20:00", "text": "私の音楽を聴いてもらうために、"}, {"type": "subtitle", "time": 15603.71, "timestamp": "04:20:03", "text": "すべて。私が幼い頃"}, {"type": "subtitle", "time": 15607.87, "timestamp": "04:20:07", "text": "しかし、私は人々に私の"}, {"type": "subtitle", "time": 15611.79, "timestamp": "04:20:11", "text": "話。それが彼らにインスピレーションを与えることを願います"}, {"type": "subtitle", "time": 15614.469, "timestamp": "04:20:14", "text": "あまりにも。だから私はJocknikを始めたんです。"}, {"type": "subtitle", "time": 15617.75, "timestamp": "04:20:17", "text": "だからジョックニックは私にとって全てだった"}, {"type": "subtitle", "time": 15628.55, "timestamp": "04:20:28", "text": "そして今、私はまるでスポーツマンのよう"}, {"type": "subtitle", "time": 15631.349, "timestamp": "04:20:31", "text": "競い合う槍。そして今、私はすべてを達成できる"}, {"type": "subtitle", "time": 15633.75, "timestamp": "04:20:33", "text": "私が欲しかったもの。夢のように"}, {"type": "subtitle", "time": 15637.67, "timestamp": "04:20:37", "text": "諦めた、私は最善を尽くして達成することができる"}, {"type": "subtitle", "time": 15640.79, "timestamp": "04:20:40", "text": "彼らをこの旅路へと導いてください。そして"}, {"type": "subtitle", "time": 15644.51, "timestamp": "04:20:44", "text": "夢を夢として捕まえる"}, {"type": "subtitle", "time": 15648.03, "timestamp": "04:20:48", "text": "キャッチャー。うん。夢を追いかける人。"}, {"type": "subtitle", "time": 15653.59, "timestamp": "04:20:53", "text": "うん。こんにちは。ええ、そうですね。私からは以上です。"}, {"type": "subtitle", "time": 15656.309, "timestamp": "04:20:56", "text": "皆さん、引き続きベストを尽くしてください。感謝"}, {"type": "subtitle", "time": 15657.149, "timestamp": "04:20:57", "text": "あなたへ"}]
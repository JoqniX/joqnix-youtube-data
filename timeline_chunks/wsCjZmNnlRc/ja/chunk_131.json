[{"type": "subtitle", "time": 7864.709, "timestamp": "02:11:04", "text": "それで、ジョック、この瞬間、何らかの理由で"}, {"type": "subtitle", "time": 7866.55, "timestamp": "02:11:06", "text": "私たちは果物について話しているのです。あなたは何を"}, {"type": "subtitle", "time": 7870.03, "timestamp": "02:11:10", "text": "あなたの一番好きな果物は何ですか？"}, {"type": "subtitle", "time": 7872.99, "timestamp": "02:11:12", "text": "[音楽]"}, {"type": "subtitle", "time": 7875.03, "timestamp": "02:11:15", "text": "いちご。うん、イチゴ味。"}, {"type": "chat", "time": 7877.439, "timestamp": "02:11:17", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "mango!"}, {"type": "subtitle", "time": 7878.069, "timestamp": "02:11:18", "text": "イチゴ。うん。"}, {"type": "subtitle", "time": 7880.55, "timestamp": "02:11:20", "text": "イチゴと相性の良い果物は何ですか？"}, {"type": "subtitle", "time": 7883.52, "timestamp": "02:11:23", "text": "あなたの意見では？"}, {"type": "subtitle", "time": 7887.709, "timestamp": "02:11:27", "text": "[音楽]"}, {"type": "subtitle", "time": 7890.43, "timestamp": "02:11:30", "text": "マンゴー。マンゴーは"}, {"type": "subtitle", "time": 7893.99, "timestamp": "02:11:33", "text": "美味しい。マンゴーの木を育てています。"}, {"type": "subtitle", "time": 7896.149, "timestamp": "02:11:36", "text": "発芽中のマンゴーの種。その"}, {"type": "subtitle", "time": 7899.109, "timestamp": "02:11:39", "text": "かわいい。唐辛子と同じように"}, {"type": "subtitle", "time": 7901.75, "timestamp": "02:11:41", "text": "今まさに発芽しているところです。かわいいですね。"}, {"type": "chat", "time": 7910.356, "timestamp": "02:11:50", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "that's nice! now u will get mangos"}, {"type": "subtitle", "time": 7913.79, "timestamp": "02:11:53", "text": "だから、このバナナもまた"}, {"type": "subtitle", "time": 7918.47, "timestamp": "02:11:58", "text": "良い。イチゴとバナナ。"}, {"type": "subtitle", "time": 7919.229, "timestamp": "02:11:59", "text": "おお、"}]
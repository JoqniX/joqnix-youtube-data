[{"type": "subtitle", "time": 780.389, "timestamp": "00:13:00", "text": "えっと、私は、"}, {"type": "subtitle", "time": 783.509, "timestamp": "00:13:03", "text": "手伝ってくれたけど、"}, {"type": "subtitle", "time": 787.19, "timestamp": "00:13:07", "text": "スタッフは、私は"}, {"type": "subtitle", "time": 789.43, "timestamp": "00:13:09", "text": "彼らは私を捕まえることはできないだろう"}, {"type": "subtitle", "time": 791.91, "timestamp": "00:13:11", "text": "ホワイトリストに登録して、そこでストリーミングできるようにしよう"}, {"type": "subtitle", "time": 795.71, "timestamp": "00:13:15", "text": "この時点から、つまり今から"}, {"type": "chat", "time": 797.728, "timestamp": "00:13:17", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "talking to family about internet culture is definitely an awkward experience. I had one time my streamer was on a rant about \"deez nuts\" and I had to explain to my family why people talking about nuts"}, {"type": "subtitle", "time": 798.99, "timestamp": "00:13:18", "text": "先へ。ホワイトリストの有効期限が切れたので"}, {"type": "subtitle", "time": 801.75, "timestamp": "00:13:21", "text": "ランダムに、私は彼らに好きになるように言ったと思った"}, {"type": "subtitle", "time": 805.67, "timestamp": "00:13:25", "text": "5月を予約して、"}, {"type": "subtitle", "time": 808.069, "timestamp": "00:13:28", "text": "期限切れになったので、彼らに尋ねました。"}, {"type": "subtitle", "time": 810.949, "timestamp": "00:13:30", "text": "期限切れですが、6月の予約はできますか？"}, {"type": "subtitle", "time": 814.389, "timestamp": "00:13:34", "text": "なぜなら私はコラボレーションを確保できたから"}, {"type": "subtitle", "time": 818.23, "timestamp": "00:13:38", "text": "Billy Vtuberと一緒です。それは私の"}, {"type": "subtitle", "time": 819.99, "timestamp": "00:13:39", "text": "中国人とのコラボレーションは初めて"}, {"type": "subtitle", "time": 822.55, "timestamp": "00:13:42", "text": "YouTuber。いいえ。だから、私はこう思ったんです。"}, {"type": "subtitle", "time": 826.069, "timestamp": "00:13:46", "text": "ストリーミングできたらもっといいのに"}, {"type": "subtitle", "time": 828.31, "timestamp": "00:13:48", "text": "そこには。彼らに紹介していただけますか？"}, {"type": "subtitle", "time": 830.71, "timestamp": "00:13:50", "text": "チャンス？私はコラボレーションしたい"}, {"type": "subtitle", "time": 834.629, "timestamp": "00:13:54", "text": "中国人ユーチューバー。それはすごく面白いだろうね。"}]
[{"type": "subtitle", "time": 5401.02, "timestamp": "01:30:01", "text": "えっと、私は"}, {"type": "subtitle", "time": 5408.55, "timestamp": "01:30:08", "text": "何か。ミアと話しましたか？"}, {"type": "subtitle", "time": 5411.51, "timestamp": "01:30:11", "text": "最近？もうずいぶん経ちましたね。私は"}, {"type": "subtitle", "time": 5416.87, "timestamp": "01:30:16", "text": "お二人とも見かけましたよ。ミアと話しましたか？"}, {"type": "subtitle", "time": 5420.05, "timestamp": "01:30:20", "text": "はい、ミアとは話しました。"}, {"type": "subtitle", "time": 5422.87, "timestamp": "01:30:22", "text": "[音楽]"}, {"type": "subtitle", "time": 5424.149, "timestamp": "01:30:24", "text": "彼の話を聞きましたか？話しましたか？"}, {"type": "subtitle", "time": 5426.31, "timestamp": "01:30:26", "text": "最近彼に会った？うん。うん、コラボしたよ"}, {"type": "subtitle", "time": 5428.39, "timestamp": "01:30:28", "text": "彼らと共に。"}, {"type": "chat", "time": 5430.41, "timestamp": "01:30:30", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "meowcatmax"}, {"type": "subtitle", "time": 5431.79, "timestamp": "01:30:31", "text": "おお、いいね。ニース。"}, {"type": "subtitle", "time": 5441.43, "timestamp": "01:30:41", "text": "待って、ニャーボットマックス。"}, {"type": "subtitle", "time": 5443.27, "timestamp": "01:30:43", "text": "待って、彼が"}, {"type": "subtitle", "time": 5447.51, "timestamp": "01:30:47", "text": "ボットのようなモデルを持っていた"}, {"type": "subtitle", "time": 5455.149, "timestamp": "01:30:55", "text": "[音楽]"}, {"type": "subtitle", "time": 5457.07, "timestamp": "01:30:57", "text": "えっと、"}, {"type": "subtitle", "time": 5458.99, "timestamp": "01:30:58", "text": "待って。彼"}]
[{"type": "subtitle", "time": 16865.11, "timestamp": "04:41:05", "text": "sh ああ、なんてことだ、世界はなんて広いんだ。"}, {"type": "subtitle", "time": 16868.07, "timestamp": "04:41:08", "text": "レナ、聞こえる？それはとてもぼやけている"}, {"type": "subtitle", "time": 16872.868, "timestamp": "04:41:12", "text": "うん、聞いて。片目の錯乱した"}, {"type": "subtitle", "time": 16874.47, "timestamp": "04:41:14", "text": "忍耐強い。彼は本当のことを言っていた。そこには"}, {"type": "subtitle", "time": 16876.23, "timestamp": "04:41:16", "text": "脱出方法がある。彼が言ったことは"}, {"type": "subtitle", "time": 16878.868, "timestamp": "04:41:18", "text": "方向転換しない人がいるというのは事実だ。彼は亡くなった"}, {"type": "subtitle", "time": 16881.91, "timestamp": "04:41:21", "text": "今朝、カイル。彼は熱にやられてしまった。"}, {"type": "subtitle", "time": 16885.83, "timestamp": "04:41:25", "text": "あなたは熱の神だ。いいえ。"}, {"type": "subtitle", "time": 16890.23, "timestamp": "04:41:30", "text": "その噂を知っている。わかったよ、レナ。これ"}, {"type": "subtitle", "time": 16893.27, "timestamp": "04:41:33", "text": "すごく気持ちいい。クソ山だ。あなた"}, {"type": "subtitle", "time": 16894.788, "timestamp": "04:41:34", "text": "考えてみて、もしあなたがジャンプしたら"}, {"type": "subtitle", "time": 16898.19, "timestamp": "04:41:38", "text": "このような山々。これは私の夢です"}, {"type": "subtitle", "time": 16902.07, "timestamp": "04:41:42", "text": "パルクール。ああ、なんてこった。 1つを想像してみてください"}, {"type": "subtitle", "time": 16904.868, "timestamp": "04:41:44", "text": "もし私がパルクールを習得したら、その日が来るんですよね？私"}, {"type": "subtitle", "time": 16908.83, "timestamp": "04:41:48", "text": "ぜひそうしたいです。すごくかっこいい。人々が"}, {"type": "subtitle", "time": 16912.11, "timestamp": "04:41:52", "text": "パルクールはまあまあ"}, {"type": "subtitle", "time": 16915.39, "timestamp": "04:41:55", "text": "良い。文字通り彼らは"}]
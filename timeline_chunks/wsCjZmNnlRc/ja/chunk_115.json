[{"type": "subtitle", "time": 6907.43, "timestamp": "01:55:07", "text": "繰り返しますが、私はあまりよく知りません。"}, {"type": "subtitle", "time": 6910.39, "timestamp": "01:55:10", "text": "しばらくアニメを見ていなかった。なぜ"}, {"type": "subtitle", "time": 6913.99, "timestamp": "01:55:13", "text": "最後に見たアニメは？"}, {"type": "subtitle", "time": 6916.709, "timestamp": "01:55:16", "text": "覚えていませんが、私は見ています"}, {"type": "subtitle", "time": 6919.589, "timestamp": "01:55:19", "text": "ああ、あの球場アニメは"}, {"type": "subtitle", "time": 6939.149, "timestamp": "01:55:39", "text": "ボールはアニメがいっぱい"}, {"type": "subtitle", "time": 6942.149, "timestamp": "01:55:42", "text": "今。どうやってこれに対応しているのですか？私"}, {"type": "subtitle", "time": 6945.589, "timestamp": "01:55:45", "text": "全くついていけない。"}, {"type": "subtitle", "time": 6950.47, "timestamp": "01:55:50", "text": "私もそう思います。新しいものについていけない"}, {"type": "subtitle", "time": 6953.39, "timestamp": "01:55:53", "text": "アニメは煙だ。"}]
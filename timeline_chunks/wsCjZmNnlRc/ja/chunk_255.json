[{"type": "subtitle", "time": 15301.55, "timestamp": "04:15:01", "text": "ええと、公式の伝承では"}, {"type": "subtitle", "time": 15304.469, "timestamp": "04:15:04", "text": "ジョックニックは、"}, {"type": "subtitle", "time": 15307.67, "timestamp": "04:15:07", "text": "デビュー作で、このモデルに資金を提供します"}, {"type": "subtitle", "time": 15310.469, "timestamp": "04:15:10", "text": "なぜならそれが公式モデルになるから"}, {"type": "subtitle", "time": 15313.71, "timestamp": "04:15:13", "text": "やり方"}, {"type": "subtitle", "time": 15317.07, "timestamp": "04:15:17", "text": "ジョックの公式モデル"}, {"type": "subtitle", "time": 15320.389, "timestamp": "04:15:20", "text": "次。ええ、これはどちらかというと、"}, {"type": "subtitle", "time": 15324.79, "timestamp": "04:15:24", "text": "初期シリーズアークモデルの概念"}, {"type": "subtitle", "time": 15327.269, "timestamp": "04:15:27", "text": "そして1つ"}, {"type": "subtitle", "time": 15330.469, "timestamp": "04:15:30", "text": "えーと、私たちは、私は"}, {"type": "subtitle", "time": 15332.71, "timestamp": "04:15:32", "text": "資金があればデビューして"}, {"type": "subtitle", "time": 15335.189, "timestamp": "04:15:35", "text": "すべてがうまくいけば"}, {"type": "subtitle", "time": 15338.149, "timestamp": "04:15:38", "text": "jockは公式のjockデザインになります。"}, {"type": "subtitle", "time": 15340.309, "timestamp": "04:15:40", "text": "ジョックニックのデザインキャラクターデザイン"}, {"type": "subtitle", "time": 15341.91, "timestamp": "04:15:41", "text": "すべて。こんにちは。すべては"}, {"type": "subtitle", "time": 15345.149, "timestamp": "04:15:45", "text": "ここから先は公式です。"}, {"type": "subtitle", "time": 15348.71, "timestamp": "04:15:48", "text": "ああ、そうだよ。気に入っていただけると嬉しいです。ディオ、私は"}, {"type": "subtitle", "time": 15351.189, "timestamp": "04:15:51", "text": "気に入ってくれるといいな。モデルも大好きだよ。"}, {"type": "subtitle", "time": 15352.75, "timestamp": "04:15:52", "text": "多く。私はしません"}, {"type": "subtitle", "time": 15355.67, "timestamp": "04:15:55", "text": "知る。皆さんにとても感謝しています"}, {"type": "subtitle", "time": 15358.229, "timestamp": "04:15:58", "text": "私を助けるために舞台裏で一生懸命働いてくれた"}]
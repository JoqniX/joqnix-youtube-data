[{"type": "subtitle", "time": 9183.349, "timestamp": "02:33:03", "text": "それ。君が作れると私が知っている唯一のもの"}, {"type": "subtitle", "time": 9185.88, "timestamp": "02:33:05", "text": "バナナと一緒にバナナ"}, {"type": "subtitle", "time": 9188.19, "timestamp": "02:33:08", "text": "[音楽]"}, {"type": "subtitle", "time": 9191.349, "timestamp": "02:33:11", "text": "パン。ジョックにMMOの料理について聞かないでください。"}, {"type": "subtitle", "time": 9195.03, "timestamp": "02:33:15", "text": "彼は何も知らない。"}, {"type": "subtitle", "time": 9197.19, "timestamp": "02:33:17", "text": "コカコーラ。私が知っている唯一のことは、"}, {"type": "subtitle", "time": 9199.349, "timestamp": "02:33:19", "text": "バナナで作るものはバナナです。まあ、そこ"}, {"type": "subtitle", "time": 9201.03, "timestamp": "02:33:21", "text": "他にもできることがいくつかあります"}, {"type": "subtitle", "time": 9203.27, "timestamp": "02:33:23", "text": "バナナ入り。一つ思うことは"}, {"type": "subtitle", "time": 9204.75, "timestamp": "02:33:24", "text": "ジョックが話しているのは"}, {"type": "subtitle", "time": 9208.15, "timestamp": "02:33:28", "text": "プランテンは次のように調理できます"}, {"type": "subtitle", "time": 9211.11, "timestamp": "02:33:31", "text": "揚げてもいいですよ。揚げたプランテンは"}, {"type": "subtitle", "time": 9214.63, "timestamp": "02:33:34", "text": "なかなか良いですね。キャラメル化も"}, {"type": "subtitle", "time": 9216.469, "timestamp": "02:33:36", "text": "プランテン。"}, {"type": "chat", "time": 9216.76, "timestamp": "02:33:36", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "banana chips"}, {"type": "subtitle", "time": 9225.429, "timestamp": "02:33:45", "text": "作れるものはたくさんある"}]
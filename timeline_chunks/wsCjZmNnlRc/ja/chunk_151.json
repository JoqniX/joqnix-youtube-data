[{"type": "subtitle", "time": 9060.71, "timestamp": "02:31:00", "text": "粉々に砕く。なぜ煮ているのですか"}, {"type": "subtitle", "time": 9062.55, "timestamp": "02:31:02", "text": "バナナ？"}, {"type": "subtitle", "time": 9065.27, "timestamp": "02:31:05", "text": "バナナは茹でることはできません。沸騰させる"}, {"type": "subtitle", "time": 9066.35, "timestamp": "02:31:06", "text": "バナナ。美味しい"}, {"type": "chat", "time": 9066.936, "timestamp": "02:31:06", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "boil a banana??????"}, {"type": "subtitle", "time": 9077.389, "timestamp": "02:31:17", "text": "でも、そうですよね？茹でたものは食べません"}, {"type": "subtitle", "time": 9082.51, "timestamp": "02:31:22", "text": "バナナ。蒸して食べる"}, {"type": "chat", "time": 9082.628, "timestamp": "02:31:22", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "wut will u make with a boiled banana??"}, {"type": "subtitle", "time": 9085.67, "timestamp": "02:31:25", "text": "それ。小さいバナナのやつはやらないでください。あなた"}, {"type": "subtitle", "time": 9087.75, "timestamp": "02:31:27", "text": "大きな方を選ばなければならない。何だったか忘れた"}, {"type": "subtitle", "time": 9088.59, "timestamp": "02:31:28", "text": "タイプ"}, {"type": "subtitle", "time": 9105.07, "timestamp": "02:31:45", "text": "それ。うん。それを切って"}, {"type": "subtitle", "time": 9109.51, "timestamp": "02:31:49", "text": "ピース。ピースの円。フォークを取ってください。私"}, {"type": "subtitle", "time": 9112.309, "timestamp": "02:31:52", "text": "嫌いだ。"}]
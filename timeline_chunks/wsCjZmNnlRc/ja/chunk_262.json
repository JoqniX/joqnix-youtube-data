[{"type": "subtitle", "time": 15721.71, "timestamp": "04:22:01", "text": "あなたは希望を失った人か"}, {"type": "subtitle", "time": 15724.309, "timestamp": "04:22:04", "text": "何でも、何かをしたいけれど、"}, {"type": "subtitle", "time": 15726.95, "timestamp": "04:22:06", "text": "できない、後で使いたいから、"}, {"type": "subtitle", "time": 15728.63, "timestamp": "04:22:08", "text": "ノートか何かを持ってきて、"}, {"type": "subtitle", "time": 15730.55, "timestamp": "04:22:10", "text": "ただ書き留めて、あなたの目標を書き出して、"}, {"type": "subtitle", "time": 15733.189, "timestamp": "04:22:13", "text": "やりたいことをやってみて、"}, {"type": "subtitle", "time": 15736.07, "timestamp": "04:22:16", "text": "その目標に向かって。わかった？もし"}, {"type": "subtitle", "time": 15739.51, "timestamp": "04:22:19", "text": "あなたはコンテンツクリエイターで、"}, {"type": "subtitle", "time": 15741.83, "timestamp": "04:22:21", "text": "全力を尽くしてデビューするなど、"}, {"type": "subtitle", "time": 15743.67, "timestamp": "04:22:23", "text": "あなたがYouTuberなら、あなたのVTuber"}, {"type": "subtitle", "time": 15746.55, "timestamp": "04:22:26", "text": "準備中または何かデビューした、"}, {"type": "subtitle", "time": 15748.95, "timestamp": "04:22:28", "text": "その目標に向かって、少しずつ努力する。しないで"}, {"type": "subtitle", "time": 15751.03, "timestamp": "04:22:31", "text": "あきらめる。"}, {"type": "subtitle", "time": 15754.79, "timestamp": "04:22:34", "text": "そしてもしあなたが他の人と一緒なら"}, {"type": "subtitle", "time": 15757.83, "timestamp": "04:22:37", "text": "趣味とか音楽とか、"}, {"type": "subtitle", "time": 15761.11, "timestamp": "04:22:41", "text": "執筆、あなたがすること、どんなスキルでも"}, {"type": "subtitle", "time": 15763.75, "timestamp": "04:22:43", "text": "あなたが持っているか、まだそれに乗っているなら"}, {"type": "subtitle", "time": 15765.75, "timestamp": "04:22:45", "text": "私のような旅、自分の得意なことを見つける"}, {"type": "subtitle", "time": 15768.11, "timestamp": "04:22:48", "text": "私は何が得意ですか？"}, {"type": "subtitle", "time": 15772.229, "timestamp": "04:22:52", "text": "何かを見つけるために最善を尽くし続けてください。"}, {"type": "subtitle", "time": 15775.349, "timestamp": "04:22:55", "text": "わかった？やがてあなたは"}, {"type": "subtitle", "time": 15778.229, "timestamp": "04:22:58", "text": "本当に本当に"}]
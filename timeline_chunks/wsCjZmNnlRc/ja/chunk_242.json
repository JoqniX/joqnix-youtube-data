[{"type": "subtitle", "time": 14521.189, "timestamp": "04:02:01", "text": "失敗は、私自身への失望ではない"}, {"type": "subtitle", "time": 14526.349, "timestamp": "04:02:06", "text": "騎手。それで"}, {"type": "subtitle", "time": 14529.349, "timestamp": "04:02:09", "text": "はい、それが私の発表です。私は思う"}, {"type": "subtitle", "time": 14536.71, "timestamp": "04:02:16", "text": "場所については、聞いてくれてありがとう。"}, {"type": "subtitle", "time": 14538.349, "timestamp": "04:02:18", "text": "みんな。"}, {"type": "subtitle", "time": 14541.429, "timestamp": "04:02:21", "text": "えっと、あなたのチャットのほとんどを読みましたよ。しないで"}, {"type": "subtitle", "time": 14543.55, "timestamp": "04:02:23", "text": "心配。私は見ていました"}, {"type": "subtitle", "time": 14548.309, "timestamp": "04:02:28", "text": "それ。私はそれを見ていました。ええ、そうですね。もし"}, {"type": "subtitle", "time": 14550.83, "timestamp": "04:02:30", "text": "ご質問があれば、お気軽にお尋ねください。"}, {"type": "subtitle", "time": 14555.71, "timestamp": "04:02:35", "text": "今。えっと、数分間待ってください"}, {"type": "subtitle", "time": 14558.87, "timestamp": "04:02:38", "text": "開ける。えっと、何か質問があれば"}, {"type": "subtitle", "time": 14563.83, "timestamp": "04:02:43", "text": "イベントについて、えーと、質問できます、えーと、"}, {"type": "subtitle", "time": 14565.75, "timestamp": "04:02:45", "text": "10分か5分くらい"}, {"type": "subtitle", "time": 14568.51, "timestamp": "04:02:48", "text": "分。こんにちは。ライブなので"}, {"type": "subtitle", "time": 14570.87, "timestamp": "04:02:50", "text": "ストリームにしたいと思ったのですが、"}, {"type": "subtitle", "time": 14572.349, "timestamp": "04:02:52", "text": "ビデオ、"}, {"type": "subtitle", "time": 14576.07, "timestamp": "04:02:56", "text": "でも、生でやった方がうまくいく気がしたし、"}, {"type": "subtitle", "time": 14577.229, "timestamp": "04:02:57", "text": "生"}]
[{"type": "subtitle", "time": 16801.788, "timestamp": "04:40:01", "text": "実際には持っていない"}, {"type": "subtitle", "time": 16805.708, "timestamp": "04:40:05", "text": "弾薬？私はとても"}, {"type": "subtitle", "time": 16809.91, "timestamp": "04:40:09", "text": "もの。 14 ゴージャス。おお。わかった。えっと、もし"}, {"type": "subtitle", "time": 16811.91, "timestamp": "04:40:11", "text": "そうです、待ってください"}, {"type": "subtitle", "time": 16820.868, "timestamp": "04:40:20", "text": "推測。えっと、リボンはつけようかな。いいえ"}, {"type": "subtitle", "time": 16855.55, "timestamp": "04:40:55", "text": "申し訳ありません。ミュートにする必要があるのは"}, {"type": "subtitle", "time": 16858.708, "timestamp": "04:40:58", "text": "咳。私はまだ回復していません"}]
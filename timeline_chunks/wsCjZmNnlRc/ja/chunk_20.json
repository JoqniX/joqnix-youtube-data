[{"type": "subtitle", "time": 1204.39, "timestamp": "00:20:04", "text": "まあ、いいでしょう。これは言うには少し悪い"}, {"type": "subtitle", "time": 1205.95, "timestamp": "00:20:05", "text": "ストリームですが、私はそれを言います"}, {"type": "subtitle", "time": 1208.35, "timestamp": "00:20:08", "text": "とにかく。"}, {"type": "subtitle", "time": 1210.87, "timestamp": "00:20:10", "text": "あの、もし可能であればそれらを接続していただけると助かります。"}, {"type": "subtitle", "time": 1214.51, "timestamp": "00:20:14", "text": "私にとっては、本当にありがたいことです。"}, {"type": "subtitle", "time": 1225.11, "timestamp": "00:20:25", "text": "はい。ええ、そうですね。前回私が"}, {"type": "subtitle", "time": 1227.11, "timestamp": "00:20:27", "text": "ビリー・ビリーについて話して、"}, {"type": "subtitle", "time": 1229.19, "timestamp": "00:20:29", "text": "そこでストリーミング配信して、チャンスを得た"}, {"type": "subtitle", "time": 1230.43, "timestamp": "00:20:30", "text": "ここでストリーミングして"}, {"type": "subtitle", "time": 1234.07, "timestamp": "00:20:34", "text": "すべてと物、そして昨年私は"}, {"type": "subtitle", "time": 1236.95, "timestamp": "00:20:36", "text": "あまりストリーミング配信はしなかった。私は"}, {"type": "subtitle", "time": 1239.59, "timestamp": "00:20:39", "text": "長い休止期間。"}, {"type": "subtitle", "time": 1243.07, "timestamp": "00:20:43", "text": "それは私があなたに話す物語です"}, {"type": "subtitle", "time": 1245.63, "timestamp": "00:20:45", "text": "プライベート。ああ、だって私は"}, {"type": "subtitle", "time": 1248.39, "timestamp": "00:20:48", "text": "できないよ。ああ、配信では言えないんだ。"}, {"type": "subtitle", "time": 1251.75, "timestamp": "00:20:51", "text": "うん。ええ、長い時間がかかりました。"}, {"type": "subtitle", "time": 1254.549, "timestamp": "00:20:54", "text": "配信で配信します。"}, {"type": "subtitle", "time": 1256.07, "timestamp": "00:20:56", "text": "待って、さっきは何を言ってたの？私"}]
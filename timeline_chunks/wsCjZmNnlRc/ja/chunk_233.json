[{"type": "subtitle", "time": 13981.83, "timestamp": "03:53:01", "text": "そして、これからどうなるのか不安です。"}, {"type": "subtitle", "time": 13983.15, "timestamp": "03:53:03", "text": "ちょっと怖い"}, {"type": "subtitle", "time": 13985.469, "timestamp": "03:53:05", "text": "だってほら"}, {"type": "subtitle", "time": 13988.309, "timestamp": "03:53:08", "text": "ええと、これらすべては新しい経験です"}, {"type": "subtitle", "time": 13991.269, "timestamp": "03:53:11", "text": "私と私はそれを一緒に経験しています"}, {"type": "subtitle", "time": 13994.75, "timestamp": "03:53:14", "text": "君たちはこのイベントをやるかどうか"}, {"type": "subtitle", "time": 13997.51, "timestamp": "03:53:17", "text": "一緒に、あるいは舞台裏で"}, {"type": "subtitle", "time": 14000.63, "timestamp": "03:53:20", "text": "人々と話す アーティストと話す"}, {"type": "subtitle", "time": 14002.59, "timestamp": "03:53:22", "text": "話している"}, {"type": "subtitle", "time": 14005.83, "timestamp": "03:53:25", "text": "人々と一緒に、そうですね、委託します"}, {"type": "subtitle", "time": 14008.389, "timestamp": "03:53:28", "text": "依頼の仕方、プロフェッショナルになる方法"}, {"type": "subtitle", "time": 14010.63, "timestamp": "03:53:30", "text": "ビジネスは一体どのように機能するのか"}, {"type": "subtitle", "time": 14011.95, "timestamp": "03:53:31", "text": "知らない"}, {"type": "subtitle", "time": 14014.71, "timestamp": "03:53:34", "text": "何でもいいけど、私はこれを通して学んでいる"}, {"type": "subtitle", "time": 14016.189, "timestamp": "03:53:36", "text": "旅"}, {"type": "subtitle", "time": 14020.189, "timestamp": "03:53:40", "text": "私は学んでいると思う 私は学んだ"}, {"type": "subtitle", "time": 14027.71, "timestamp": "03:53:47", "text": "えっと、私は"}, {"type": "subtitle", "time": 14030.71, "timestamp": "03:53:50", "text": "やってるけど、うん"}, {"type": "subtitle", "time": 14032.59, "timestamp": "03:53:52", "text": "えっと、"}, {"type": "subtitle", "time": 14036.229, "timestamp": "03:53:56", "text": "ええ、おそらく遠い将来に"}, {"type": "subtitle", "time": 14039.03, "timestamp": "03:53:59", "text": "ジョアソンを続けるか、"}]
[{"type": "subtitle", "time": 2880.95, "timestamp": "00:48:00", "text": "あなたは大学に行くのですね。そうでないなら、そうですね。"}, {"type": "subtitle", "time": 2885.19, "timestamp": "00:48:05", "text": "うん。学生生活を楽しんでください。"}, {"type": "subtitle", "time": 2886.79, "timestamp": "00:48:06", "text": "まるで塾みたいだ。わかった。楽しむ"}, {"type": "subtitle", "time": 2889.91, "timestamp": "00:48:09", "text": "それはあなたにとって拷問です。楽しむという意味です"}, {"type": "chat", "time": 2898.908, "timestamp": "00:48:18", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "lmaooo"}, {"type": "subtitle", "time": 2906.23, "timestamp": "00:48:26", "text": "いいね、兄弟。心配ない。教育ではなく、"}, {"type": "subtitle", "time": 2908.79, "timestamp": "00:48:28", "text": "雇用または研修。わかりました"}, {"type": "subtitle", "time": 2911.51, "timestamp": "00:48:31", "text": "きちんと整えている。これは、1年間"}, {"type": "subtitle", "time": 2914.069, "timestamp": "00:48:34", "text": "いい感じですね、そしてこれがユーチューバーです"}, {"type": "chat", "time": 2915.427, "timestamp": "00:48:35", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "you can't make a scramble egg without breaking a few eggs"}, {"type": "subtitle", "time": 2921.589, "timestamp": "00:48:41", "text": "場合。例えば、こんな男を想像してみて。"}, {"type": "subtitle", "time": 2923.349, "timestamp": "00:48:43", "text": "1年間ずっと家にいて"}, {"type": "subtitle", "time": 2926.069, "timestamp": "00:48:46", "text": "それから彼らを学校に連れて行く。想像する"}, {"type": "subtitle", "time": 2927.589, "timestamp": "00:48:47", "text": "彼に何かと交流させようとしている"}, {"type": "subtitle", "time": 2930.309, "timestamp": "00:48:50", "text": "女の子たち。ああ、それはまさに私と同じだ"}, {"type": "subtitle", "time": 2931.99, "timestamp": "00:48:51", "text": "神経質。レックは「あぁ、ごめん」という感じ。"}, {"type": "subtitle", "time": 2934.87, "timestamp": "00:48:54", "text": "ごめん。ああ、はじめまして。私は"}, {"type": "subtitle", "time": 2936.309, "timestamp": "00:48:56", "text": "できるだけ普通に振る舞おうとする"}, {"type": "subtitle", "time": 2939.75, "timestamp": "00:48:59", "text": "可能。ありがとう。ありがとう。"}]
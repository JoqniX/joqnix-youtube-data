[{"type": "subtitle", "time": 6841.07, "timestamp": "01:54:01", "text": "Doobie Hero Xって何？えっと、それは"}, {"type": "subtitle", "time": 6846.149, "timestamp": "01:54:06", "text": "u それは面白いアニメで、"}, {"type": "subtitle", "time": 6848.709, "timestamp": "01:54:08", "text": "そこはまるで塔のようだ"}, {"type": "subtitle", "time": 6851.35, "timestamp": "01:54:11", "text": "登山みたいなもの。もしそれが"}, {"type": "subtitle", "time": 6854.47, "timestamp": "01:54:14", "text": "ビデオゲームでは、"}, {"type": "subtitle", "time": 6858.31, "timestamp": "01:54:18", "text": "ナンバーワン。それらはまるで番号でランク付けされているかのようだ"}, {"type": "subtitle", "time": 6862.95, "timestamp": "01:54:22", "text": "ヒーローとかそういうの、15位から1位まで。"}, {"type": "subtitle", "time": 6866.669, "timestamp": "01:54:26", "text": "NFの最重要指名手配犯を想像してみてください"}, {"type": "subtitle", "time": 6869.75, "timestamp": "01:54:29", "text": "文字通り。だからアニメの代わりに"}, {"type": "subtitle", "time": 6872.79, "timestamp": "01:54:32", "text": "MCメインから描写する"}, {"type": "subtitle", "time": 6875.35, "timestamp": "01:54:35", "text": "キャラクターの視点から見ると、"}, {"type": "subtitle", "time": 6878.709, "timestamp": "01:54:38", "text": "最重要指名手配犯それぞれの視点"}, {"type": "subtitle", "time": 6882.87, "timestamp": "01:54:42", "text": "それぞれのヒーローのように。それで"}, {"type": "subtitle", "time": 6884.75, "timestamp": "01:54:44", "text": "15から"}, {"type": "subtitle", "time": 6888.189, "timestamp": "01:54:48", "text": "ナンバーワンの種類"}, {"type": "subtitle", "time": 6891.589, "timestamp": "01:54:51", "text": "もの。 15か10だったと思う。忘れちゃった。うん。"}, {"type": "subtitle", "time": 6893.55, "timestamp": "01:54:53", "text": "10位から1位へ。"}, {"type": "subtitle", "time": 6896.229, "timestamp": "01:54:56", "text": "実際、それは良いものだ。本当に"}]
[{"type": "subtitle", "time": 18600.07, "timestamp": "05:10:00", "text": "こんにちは。山賊と話す"}, {"type": "subtitle", "time": 18602.15, "timestamp": "05:10:02", "text": "後で。君はここにいるんだね、友よ。毎回新しい"}, {"type": "subtitle", "time": 18609.35, "timestamp": "05:10:09", "text": "アセンという男だ。実際に販売している"}, {"type": "subtitle", "time": 18611.59, "timestamp": "05:10:11", "text": "何かここにあるのか？水。結晶"}, {"type": "subtitle", "time": 18614.47, "timestamp": "05:10:14", "text": "クリア。その後、下痢はなかった。味は"}, {"type": "subtitle", "time": 18616.628, "timestamp": "05:10:16", "text": "もし天使があなたの舌を踏んだら。 1つ"}, {"type": "subtitle", "time": 18620.23, "timestamp": "05:10:20", "text": "1ガロンで10ポンドの食品。金として"}, {"type": "subtitle", "time": 18623.35, "timestamp": "05:10:23", "text": "良い。水の代わりに10ポンドの餌。あなたは"}, {"type": "subtitle", "time": 18625.11, "timestamp": "05:10:25", "text": "空気1、2杯分の料金を請求し始めるつもりですか？"}, {"type": "subtitle", "time": 18627.59, "timestamp": "05:10:27", "text": "おお、値切り屋が来たぞ。交渉人？見て"}, {"type": "subtitle", "time": 18630.55, "timestamp": "05:10:30", "text": "下の方にいるぞ、パンク野郎。あれ、分かりますか？それは"}, {"type": "subtitle", "time": 18633.19, "timestamp": "05:10:33", "text": "ロスコ。私たちは値切り交渉をする客を彼に任せる。"}, {"type": "subtitle", "time": 18636.15, "timestamp": "05:10:36", "text": "交渉人。まだ値切りたいのか？教えて"}, {"type": "subtitle", "time": 18638.788, "timestamp": "05:10:38", "text": "VOさん、あなたの乗り物を交換させてあげるかもしれません"}, {"type": "subtitle", "time": 18642.55, "timestamp": "05:10:42", "text": "水のために。くたばれ、この野郎。そうあれ"}, {"type": "subtitle", "time": 18651.43, "timestamp": "05:10:51", "text": "さよなら。"}, {"type": "subtitle", "time": 18653.51, "timestamp": "05:10:53", "text": "なんてこった。いいえ。私は死にました。私は自分の"}, {"type": "subtitle", "time": 18656.23, "timestamp": "05:10:56", "text": "健康。おお、男よ。大丈夫。大丈夫。"}, {"type": "subtitle", "time": 18658.67, "timestamp": "05:10:58", "text": "大丈夫。その"}]
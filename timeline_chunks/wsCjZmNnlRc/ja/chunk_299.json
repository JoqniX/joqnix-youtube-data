[{"type": "subtitle", "time": 17947.59, "timestamp": "04:59:07", "text": "ええと、彼はmを持っています。私はムンチェットを受け取りません。"}, {"type": "subtitle", "time": 17949.868, "timestamp": "04:59:09", "text": "他のものを取ります"}, {"type": "subtitle", "time": 17953.948, "timestamp": "04:59:13", "text": "もの。彼らは私に男性用のものをくれた。いや、何もないよ"}, {"type": "subtitle", "time": 17958.03, "timestamp": "04:59:18", "text": "えっと、他に何も私に2に戻るように言ったものはありませんでした"}, {"type": "subtitle", "time": 17961.19, "timestamp": "04:59:21", "text": "数ヶ月。ああ、2分後にまた彼らを訪ねてください"}, {"type": "subtitle", "time": 17963.23, "timestamp": "04:59:23", "text": "数ヶ月。おお"}, {"type": "subtitle", "time": 17966.15, "timestamp": "04:59:26", "text": "ああ、それは素晴らしい。ありがたいことにそうではない"}, {"type": "subtitle", "time": 17988.31, "timestamp": "04:59:48", "text": "多くの。おお、これは新しいタイプの木箱だ。"}, {"type": "subtitle", "time": 17989.07, "timestamp": "04:59:49", "text": "A"}]
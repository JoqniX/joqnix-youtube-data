[{"type": "subtitle", "time": 7383.83, "timestamp": "02:03:03", "text": "ああ、彼の名前を覚えているよ。だった"}, {"type": "subtitle", "time": 7385.99, "timestamp": "02:03:05", "text": "こんな感じですか？"}, {"type": "subtitle", "time": 7388.229, "timestamp": "02:03:08", "text": "何てことだ。"}, {"type": "subtitle", "time": 7395.59, "timestamp": "02:03:15", "text": "あなたの名前はこれでよろしいでしょうか？"}, {"type": "subtitle", "time": 7398.189, "timestamp": "02:03:18", "text": "[笑い]"}, {"type": "subtitle", "time": 7401.35, "timestamp": "02:03:21", "text": "うん。何てことだ。"}, {"type": "subtitle", "time": 7404.31, "timestamp": "02:03:24", "text": "いやあ、君は記憶力がすごいね。"}, {"type": "subtitle", "time": 7413.46, "timestamp": "02:03:33", "text": "おお。"}, {"type": "subtitle", "time": 7427.99, "timestamp": "02:03:47", "text": "えっと、ジョナサン、こっちだよ。"}, {"type": "subtitle", "time": 7429.589, "timestamp": "02:03:49", "text": "待って、そんなこと言うべきじゃなかった。ごめん。"}, {"type": "subtitle", "time": 7430.719, "timestamp": "02:03:50", "text": "ごめん。 私たち、出て行けますか？"}, {"type": "subtitle", "time": 7435.119, "timestamp": "02:03:55", "text": "私たち、出て行けますか？ 何てことだ。"}]
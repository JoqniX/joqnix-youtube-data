[{"type": "subtitle", "time": 2290.71, "timestamp": "00:38:10", "text": "ブライアン、ようこそ。"}, {"type": "subtitle", "time": 2292.87, "timestamp": "00:38:12", "text": "また、心配する必要はありません。"}, {"type": "subtitle", "time": 2294.95, "timestamp": "00:38:14", "text": "視聴者など。これが理由です"}, {"type": "subtitle", "time": 2296.95, "timestamp": "00:38:16", "text": "私はポッドキャストをやっています"}, {"type": "subtitle", "time": 2299.03, "timestamp": "00:38:19", "text": "なぜなら私はあまり交流しないから"}, {"type": "subtitle", "time": 2300.95, "timestamp": "00:38:20", "text": "まず第一に視聴者。だから私は楽しんでいます"}, {"type": "subtitle", "time": 2304.23, "timestamp": "00:38:24", "text": "他の人と話している。"}, {"type": "subtitle", "time": 2305.51, "timestamp": "00:38:25", "text": "そうでなければ、私が話すことになる"}, {"type": "subtitle", "time": 2310.95, "timestamp": "00:38:30", "text": "自分自身。うん、そんな感じ。わからない。"}, {"type": "subtitle", "time": 2313.75, "timestamp": "00:38:33", "text": "あなたに質問したいことがあるのですが"}, {"type": "subtitle", "time": 2315.55, "timestamp": "00:38:35", "text": "どうやって"}, {"type": "subtitle", "time": 2319.349, "timestamp": "00:38:39", "text": "たくさんの人を集めようと思ったら、"}, {"type": "subtitle", "time": 2323.15, "timestamp": "00:38:43", "text": "ジョアトンのために人々を集める"}, {"type": "subtitle", "time": 2325.31, "timestamp": "00:38:45", "text": "コラボレーション"}, {"type": "subtitle", "time": 2327.31, "timestamp": "00:38:47", "text": "それから私は"}, {"type": "subtitle", "time": 2330.95, "timestamp": "00:38:50", "text": "困難ではなく、多くの違いに遭遇しました"}, {"type": "subtitle", "time": 2334.03, "timestamp": "00:38:54", "text": "むしろ新しい"}, {"type": "subtitle", "time": 2336.79, "timestamp": "00:38:56", "text": "経験的だったけど、私はそうじゃなかった"}]
[{"type": "subtitle", "time": 12361.91, "timestamp": "03:26:01", "text": "うん、私も。いずれにしても、えーともう一度"}, {"type": "subtitle", "time": 12364.309, "timestamp": "03:26:04", "text": "チャット、来てくれて本当にありがとう"}, {"type": "subtitle", "time": 12368.63, "timestamp": "03:26:08", "text": "このストリーム。私はマウ・チャマです、皆さん"}, {"type": "subtitle", "time": 12370.55, "timestamp": "03:26:10", "text": "大好きなママ・チャマ。はい、そうです"}, {"type": "subtitle", "time": 12373.83, "timestamp": "03:26:13", "text": "シングル。ええと、すべてのマウ・ウェルと同じように、"}, {"type": "subtitle", "time": 12377.75, "timestamp": "03:26:17", "text": "ママ・チャマではない。えーっと、他のアイドルと同じように、"}, {"type": "subtitle", "time": 12380.71, "timestamp": "03:26:20", "text": "いわゆる「みんなのもの」。えっと"}, {"type": "chat", "time": 12382.444, "timestamp": "03:26:22", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "thank u for keeping the stream running maomao chama"}, {"type": "subtitle", "time": 12384.91, "timestamp": "03:26:24", "text": "とにかく、私を楽しい人だと思ってくれてありがとう。"}, {"type": "subtitle", "time": 12388.95, "timestamp": "03:26:28", "text": "それではまたお会いしましょう"}, {"type": "subtitle", "time": 12391.51, "timestamp": "03:26:31", "text": "少なくともジョックニックは君たちに会えるだろう"}, {"type": "chat", "time": 12393.731, "timestamp": "03:26:33", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "lots of fun!"}, {"type": "subtitle", "time": 12397.4, "timestamp": "03:26:37", "text": "感謝"}, {"type": "subtitle", "time": 12398.51, "timestamp": "03:26:38", "text": "[音楽]"}, {"type": "subtitle", "time": 12402.469, "timestamp": "03:26:42", "text": "あなた。皆さんが楽しんでくれたらいいな。私は"}, {"type": "chat", "time": 12403.711, "timestamp": "03:26:43", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "take care~"}, {"type": "subtitle", "time": 12404.15, "timestamp": "03:26:44", "text": "あのね？私は養子縁組すべきかもしれない"}, {"type": "subtitle", "time": 12407.87, "timestamp": "03:26:47", "text": "それが次のキャラクターです。"}, {"type": "subtitle", "time": 12416.95, "timestamp": "03:26:56", "text": "気をつけて。こんにちは。お元気で、ありがとうございました。"}]
[{"type": "subtitle", "time": 8580.11, "timestamp": "02:23:00", "text": "手に入れた？何"}, {"type": "subtitle", "time": 8584.49, "timestamp": "02:23:04", "text": "えっ？待って、今気づいたんだけど"}, {"type": "subtitle", "time": 8586.27, "timestamp": "02:23:06", "text": "[音楽]"}, {"type": "subtitle", "time": 8591.19, "timestamp": "02:23:11", "text": "え、何？私は何度も"}, {"type": "subtitle", "time": 8592.67, "timestamp": "02:23:12", "text": "何年も私はただ"}, {"type": "subtitle", "time": 8604.469, "timestamp": "02:23:24", "text": "えっと、彼は自分の年齢を間違えた"}, {"type": "subtitle", "time": 8607.75, "timestamp": "02:23:27", "text": "いわゆる「第一時代」。待って、彼の年齢は"}, {"type": "subtitle", "time": 8610.07, "timestamp": "02:23:30", "text": "間違っている？"}, {"type": "subtitle", "time": 8612.63, "timestamp": "02:23:32", "text": "ええ、彼は25歳ではありません。"}, {"type": "subtitle", "time": 8616.309, "timestamp": "02:23:36", "text": "ああ、なんてことだ、いやだ。"}, {"type": "subtitle", "time": 8618.63, "timestamp": "02:23:38", "text": "または、引用符なしの27を使用する場合"}, {"type": "subtitle", "time": 8624.07, "timestamp": "02:23:44", "text": "あ、待って。その場合は28歳になります"}, {"type": "subtitle", "time": 8634.79, "timestamp": "02:23:54", "text": "心配ない。迷ったら、"}, {"type": "subtitle", "time": 8637.429, "timestamp": "02:23:57", "text": "バナナ。"}]
[{"type": "subtitle", "time": 7201.589, "timestamp": "02:00:01", "text": "前に。"}, {"type": "subtitle", "time": 7204.229, "timestamp": "02:00:04", "text": "本物のキス。"}, {"type": "subtitle", "time": 7206.07, "timestamp": "02:00:06", "text": "はい。現実の私を想像できますか？"}, {"type": "subtitle", "time": 7215.109, "timestamp": "02:00:15", "text": "[音楽]"}, {"type": "subtitle", "time": 7217.189, "timestamp": "02:00:17", "text": "だから、私が"}, {"type": "subtitle", "time": 7233.79, "timestamp": "02:00:33", "text": "[音楽]"}, {"type": "subtitle", "time": 7236.35, "timestamp": "02:00:36", "text": "は？うん。"}, {"type": "subtitle", "time": 7241.109, "timestamp": "02:00:41", "text": "えっと、もう一度お詫び申し上げます。えっと、そのやり方"}, {"type": "subtitle", "time": 7243.91, "timestamp": "02:00:43", "text": "眠くなりすぎて、"}, {"type": "subtitle", "time": 7246.55, "timestamp": "02:00:46", "text": "目を閉じると、まるで夢を見ているみたいだ"}, {"type": "subtitle", "time": 7249.03, "timestamp": "02:00:49", "text": "すると君の声が聞こえてきて、私は「待って」って思う"}, {"type": "subtitle", "time": 7252.91, "timestamp": "02:00:52", "text": "コラボレーションの余韻がまだ残っている"}, {"type": "subtitle", "time": 7255.83, "timestamp": "02:00:55", "text": "何か際どいことを言って"}, {"type": "subtitle", "time": 7258.55, "timestamp": "02:00:58", "text": "あなた自身が目を覚ますように。わかった、"}]
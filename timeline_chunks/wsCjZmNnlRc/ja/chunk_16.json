[{"type": "subtitle", "time": 961.35, "timestamp": "00:16:01", "text": "ところで、この人ですか？どれ？"}, {"type": "subtitle", "time": 965.59, "timestamp": "00:16:05", "text": "ああ、それは、えっと、覚えてる？"}, {"type": "subtitle", "time": 967.91, "timestamp": "00:16:07", "text": "私はあなたにこの人物を推薦しました。私は行きます"}, {"type": "subtitle", "time": 970.55, "timestamp": "00:16:10", "text": "はい。ちょっとミュートするので"}, {"type": "subtitle", "time": 972.87, "timestamp": "00:16:12", "text": "彼らの声がどんなものか聞いてみることができます。全て"}, {"type": "subtitle", "time": 1019.269, "timestamp": "00:16:59", "text": "待って、音声機能ってあるのかな？"}]
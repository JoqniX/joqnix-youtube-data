[{"type": "subtitle", "time": 6723.629, "timestamp": "01:52:03", "text": "何か。ああ、デビュー日"}, {"type": "subtitle", "time": 6726.87, "timestamp": "01:52:06", "text": "オプション。何を書けばいいのかわからない。"}, {"type": "subtitle", "time": 6729.91, "timestamp": "01:52:09", "text": "通常は、最初の動画だけを投稿します"}, {"type": "subtitle", "time": 6731.47, "timestamp": "01:52:11", "text": "アップロード"}, {"type": "subtitle", "time": 6735.31, "timestamp": "01:52:15", "text": "日付またはビデオストリームの日付"}, {"type": "subtitle", "time": 6738.51, "timestamp": "01:52:18", "text": "YouTubeだけど、私はこう思う、"}, {"type": "subtitle", "time": 6740.51, "timestamp": "01:52:20", "text": "おお。"}, {"type": "subtitle", "time": 6743.31, "timestamp": "01:52:23", "text": "うん、そうだね"}, {"type": "subtitle", "time": 6746.79, "timestamp": "01:52:26", "text": "もし私が"}, {"type": "subtitle", "time": 6750.07, "timestamp": "01:52:30", "text": "最初にデビューしてストリームを行い、"}, {"type": "subtitle", "time": 6752.39, "timestamp": "01:52:32", "text": "すべて。だから新しいものをお見せできます"}, {"type": "subtitle", "time": 6754.83, "timestamp": "01:52:34", "text": "モデルになって、「うん、デビューだ」って感じ"}, {"type": "subtitle", "time": 6757.43, "timestamp": "01:52:37", "text": "2.0」でも、まるで私が"}, {"type": "subtitle", "time": 6760.31, "timestamp": "01:52:40", "text": "私はYouTuberとしてデビューしました"}, {"type": "subtitle", "time": 6761.55, "timestamp": "01:52:41", "text": "新しい"}, {"type": "subtitle", "time": 6763.31, "timestamp": "01:52:43", "text": "YouTuber"}, {"type": "subtitle", "time": 6766.54, "timestamp": "01:52:46", "text": "一瞬。それが私の考えです。"}]
[{"type": "subtitle", "time": 17341.15, "timestamp": "04:49:01", "text": "納屋。わかった、"}, {"type": "subtitle", "time": 17345.27, "timestamp": "04:49:05", "text": "ありがとう、相棒。彼は最後の一人ですか、それとも"}, {"type": "subtitle", "time": 17346.788, "timestamp": "04:49:06", "text": "他に誰かいますか？話そうかな"}, {"type": "subtitle", "time": 17349.83, "timestamp": "04:49:09", "text": "この人物にもライフルで攻撃した。"}, {"type": "subtitle", "time": 17352.868, "timestamp": "04:49:12", "text": "その位置から上昇させてください。"}, {"type": "subtitle", "time": 17362.708, "timestamp": "04:49:22", "text": "はい、ではこの人です。この男。"}, {"type": "subtitle", "time": 17363.55, "timestamp": "04:49:23", "text": "これ"}, {"type": "subtitle", "time": 17367.59, "timestamp": "04:49:27", "text": "男。待って、これって絆じゃないの？こんにちは？"}, {"type": "subtitle", "time": 17369.07, "timestamp": "04:49:29", "text": "とは"}, {"type": "subtitle", "time": 17372.27, "timestamp": "04:49:32", "text": "禁止？これ"}, {"type": "subtitle", "time": 17375.03, "timestamp": "04:49:35", "text": "1つ。ボラ、何か用？あなたは"}, {"type": "subtitle", "time": 17376.47, "timestamp": "04:49:36", "text": "責任者は誰ですか？助けが必要です。"}, {"type": "subtitle", "time": 17393.03, "timestamp": "04:49:53", "text": "問題ないと思う。これは誰ですか？おお。ああ、私たちは"}]
[{"type": "subtitle", "time": 3182.069, "timestamp": "00:53:02", "text": "あなたはただその人を無視して"}, {"type": "subtitle", "time": 3185.589, "timestamp": "00:53:05", "text": "話すな。そういうことは時々ある。私たちは"}, {"type": "subtitle", "time": 3187.91, "timestamp": "00:53:07", "text": "人間は当然間違いを犯す"}, {"type": "subtitle", "time": 3189.47, "timestamp": "00:53:09", "text": "誰かに話しかける、"}, {"type": "subtitle", "time": 3192.15, "timestamp": "00:53:12", "text": "正しくない。間違いを犯すのは普通のことです。"}, {"type": "subtitle", "time": 3194.39, "timestamp": "00:53:14", "text": "特に大きな"}, {"type": "subtitle", "time": 3197.85, "timestamp": "00:53:17", "text": "私と同じような口。"}, {"type": "subtitle", "time": 3200.549, "timestamp": "00:53:20", "text": "[音楽]"}, {"type": "subtitle", "time": 3203.19, "timestamp": "00:53:23", "text": "誰もが誰かを好きになるわけではない"}, {"type": "subtitle", "time": 3206.95, "timestamp": "00:53:26", "text": "私みたいにおしゃべりすぎる人、または"}, {"type": "subtitle", "time": 3209.43, "timestamp": "00:53:29", "text": "考えずに物事を行う。どうやって"}, {"type": "subtitle", "time": 3212.549, "timestamp": "00:53:32", "text": "大学にも入学できたよ"}, {"type": "subtitle", "time": 3216.15, "timestamp": "00:53:36", "text": "性格と私の知性または"}, {"type": "subtitle", "time": 3225.589, "timestamp": "00:53:45", "text": "あなたにはたくさんの友達がいます"}, {"type": "chat", "time": 3228.367, "timestamp": "00:53:48", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "the egg: \"you dare you misgender me, i haven't decided yet\""}, {"type": "subtitle", "time": 3231.93, "timestamp": "00:53:51", "text": "わからない。"}, {"type": "chat", "time": 3234.816, "timestamp": "00:53:54", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/KsIfY6LzFoLM6AKanYDQAgUCkszU2WH9gy1mb0dV-11UJg/KsIfY6LzFoLM6AKanYDQAg"}]
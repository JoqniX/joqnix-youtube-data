[{"type": "subtitle", "time": 18181.15, "timestamp": "05:03:01", "text": "神。"}, {"type": "subtitle", "time": 18185.47, "timestamp": "05:03:05", "text": "いや、実際には私は"}, {"type": "subtitle", "time": 18190.03, "timestamp": "05:03:10", "text": "自転車みたいなもの。ああ、感じるよ"}, {"type": "subtitle", "time": 18193.51, "timestamp": "05:03:13", "text": "タイヤ。なんてこった。"}, {"type": "subtitle", "time": 18196.67, "timestamp": "05:03:16", "text": "学校を探す 学校がない"}, {"type": "subtitle", "time": 18198.16, "timestamp": "05:03:18", "text": "自分。"}, {"type": "subtitle", "time": 18213.39, "timestamp": "05:03:33", "text": "けれど。フリーロールするよ"}, {"type": "subtitle", "time": 18216.948, "timestamp": "05:03:36", "text": "とりあえずはこれで。"}, {"type": "subtitle", "time": 18219.01, "timestamp": "05:03:39", "text": "うん、フリーロールするよ"}, {"type": "subtitle", "time": 18237.99, "timestamp": "05:03:57", "text": "去った。これは鉄道の線路ですか？それは"}, {"type": "subtitle", "time": 18239.31, "timestamp": "05:03:59", "text": "鉄道"}]
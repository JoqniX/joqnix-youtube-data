[{"type": "subtitle", "time": 1872.07, "timestamp": "00:31:12", "text": "ああ、でも私は対処してきたと言えます"}, {"type": "subtitle", "time": 1874.63, "timestamp": "00:31:14", "text": "コックと共に。これはあなたが"}, {"type": "subtitle", "time": 1877.23, "timestamp": "00:31:17", "text": "興味がある。"}, {"type": "subtitle", "time": 1880.389, "timestamp": "00:31:20", "text": "ああ、私は「コキ」を歌っていました。"}, {"type": "subtitle", "time": 1887.269, "timestamp": "00:31:27", "text": "えっと、でも、でも、私は、私は"}, {"type": "subtitle", "time": 1888.95, "timestamp": "00:31:28", "text": "私がどんな曲を歌ってきたか当ててみて"}, {"type": "subtitle", "time": 1901.59, "timestamp": "00:31:41", "text": "罵りそうになったけど、うん、そうだ"}, {"type": "subtitle", "time": 1909.95, "timestamp": "00:31:49", "text": "そう思ったのは、"}, {"type": "subtitle", "time": 1913.19, "timestamp": "00:31:53", "text": "声の種類を推測できますか"}, {"type": "subtitle", "time": 1916.87, "timestamp": "00:31:56", "text": "歌うときに使う声 循環"}, {"type": "subtitle", "time": 1919.11, "timestamp": "00:31:59", "text": "いつそう思ったのか、頭の中ではわからない"}, {"type": "chat", "time": 1919.461, "timestamp": "00:31:59", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "I'm not trying to do myself ya know. but just saying I'm open to new cultures I love experiencing new places and styles of living. I think it's cool to learn how others experience life"}]
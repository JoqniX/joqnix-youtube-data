[{"type": "subtitle", "time": 545.19, "timestamp": "00:09:05", "text": "うん。"}, {"type": "subtitle", "time": 548.55, "timestamp": "00:09:08", "text": "とにかく、皆さん、私はマウです。"}, {"type": "subtitle", "time": 551.19, "timestamp": "00:09:11", "text": "私は薬を扱うのが好きなんです。ニース"}, {"type": "subtitle", "time": 555.75, "timestamp": "00:09:15", "text": "あなたにお会いできて嬉しいです。モモさん、はじめまして。"}, {"type": "subtitle", "time": 557.59, "timestamp": "00:09:17", "text": "ご覧のとおり、私はとてもかわいい"}, {"type": "subtitle", "time": 559.67, "timestamp": "00:09:19", "text": "顔と可愛い表情、まるで"}, {"type": "subtitle", "time": 562.19, "timestamp": "00:09:22", "text": "ジンシーが薬をくれた、えっと、いくつか"}, {"type": "subtitle", "time": 565.269, "timestamp": "00:09:25", "text": "もし私が覚えていたら、"}, {"type": "subtitle", "time": 573.509, "timestamp": "00:09:33", "text": "また、マイクが"}, {"type": "subtitle", "time": 574.949, "timestamp": "00:09:34", "text": "少しおかしいですね。実際には持っていません"}, {"type": "subtitle", "time": 577.35, "timestamp": "00:09:37", "text": "マイクまたはイヤホン。私はただ"}, {"type": "subtitle", "time": 582.389, "timestamp": "00:09:42", "text": "コンピューターをマイクとして使う。いいえ、大丈夫です。全て"}, {"type": "subtitle", "time": 588.55, "timestamp": "00:09:48", "text": "また、"}, {"type": "subtitle", "time": 590.47, "timestamp": "00:09:50", "text": "家族やゲストのために配信します"}, {"type": "subtitle", "time": 593.71, "timestamp": "00:09:53", "text": "私の部屋で。でも男性は、私のマイクは"}, {"type": "subtitle", "time": 597.75, "timestamp": "00:09:57", "text": "ミュート。ええ、ご心配なく、ご家族の皆様。私"}]
[{"type": "subtitle", "time": 903.189, "timestamp": "00:15:03", "text": "ということで、ご覧になっている皆さんへ、"}, {"type": "subtitle", "time": 905.59, "timestamp": "00:15:05", "text": "待って、コラボはどういう結果になったの？"}, {"type": "subtitle", "time": 908.15, "timestamp": "00:15:08", "text": "しかし、それは起こっているのでしょうか？ああ、コラボは6月だよ"}, {"type": "subtitle", "time": 912.71, "timestamp": "00:15:12", "text": "7番目。ええ、それは来月ですね。"}, {"type": "subtitle", "time": 916.31, "timestamp": "00:15:16", "text": "おお、いいね、いいね、いいね。それは計画だ。私 私"}, {"type": "subtitle", "time": 918.91, "timestamp": "00:15:18", "text": "最近連絡を取った"}, {"type": "subtitle", "time": 921.15, "timestamp": "00:15:21", "text": "彼ら。"}, {"type": "subtitle", "time": 925.03, "timestamp": "00:15:25", "text": "うん。そして私はこんな悪い知らせを受け取った"}, {"type": "subtitle", "time": 927.75, "timestamp": "00:15:27", "text": "このビリー・ビリーっていうやつ。私のホワイトリスト"}, {"type": "subtitle", "time": 929.55, "timestamp": "00:15:29", "text": "彼らはもう私に何も提供できない"}, {"type": "subtitle", "time": 933.91, "timestamp": "00:15:33", "text": "なぜなら、私が入学するのを手伝ってくれた人がいたからです。"}, {"type": "subtitle", "time": 936.15, "timestamp": "00:15:36", "text": "いいえ、違います。ええ、その人ではありません。うん、手に入れる"}, {"type": "subtitle", "time": 938.949, "timestamp": "00:15:38", "text": "ギルドで話をした"}, {"type": "subtitle", "time": 941.43, "timestamp": "00:15:41", "text": "スタッフも含め、すべて。その人は去った"}, {"type": "subtitle", "time": 943.31, "timestamp": "00:15:43", "text": "会社の年"}, {"type": "subtitle", "time": 947.509, "timestamp": "00:15:47", "text": "前。私は、私は、私が"}, {"type": "subtitle", "time": 950.31, "timestamp": "00:15:50", "text": "最近は知っているけど、それは"}, {"type": "subtitle", "time": 953.43, "timestamp": "00:15:53", "text": "あれから一年が経った。ええ、そうですね。この人は"}]
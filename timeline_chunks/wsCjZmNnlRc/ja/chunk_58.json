[{"type": "subtitle", "time": 3482.15, "timestamp": "00:58:02", "text": "薬剤師日記シリーズ。の"}, {"type": "subtitle", "time": 3483.87, "timestamp": "00:58:03", "text": "才能ある人物の非嫡出子"}, {"type": "subtitle", "time": 3488.109, "timestamp": "00:58:08", "text": "そして風変わりな、えっと、待って"}, {"type": "subtitle", "time": 3491.51, "timestamp": "00:58:11", "text": "それ？正直に言うと、Lであるべきだと思う。"}, {"type": "subtitle", "time": 3498.549, "timestamp": "00:58:18", "text": "土地。いやいやしょく。ええと、彼女は"}, {"type": "subtitle", "time": 3500.47, "timestamp": "00:58:20", "text": "彼女が"}, {"type": "chat", "time": 3502.43, "timestamp": "00:58:22", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "cuties ~"}, {"type": "subtitle", "time": 3502.63, "timestamp": "00:58:22", "text": "山賊に誘拐され、売り飛ばされた。彼女"}, {"type": "subtitle", "time": 3504.069, "timestamp": "00:58:24", "text": "突然、彼女は"}, {"type": "subtitle", "time": 3511.87, "timestamp": "00:58:31", "text": "ああ"}, {"type": "subtitle", "time": 3515.27, "timestamp": "00:58:35", "text": "または"}, {"type": "chat", "time": 3517.705, "timestamp": "00:58:37", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "XD"}, {"type": "subtitle", "time": 3518.309, "timestamp": "00:58:38", "text": "ええと、そこで彼女は自分の"}, {"type": "subtitle", "time": 3521.109, "timestamp": "00:58:41", "text": "実用性、鋭い推論力"}, {"type": "subtitle", "time": 3523.349, "timestamp": "00:58:43", "text": "ハーブに関する洞察力のある知識と"}, {"type": "subtitle", "time": 3525.27, "timestamp": "00:58:45", "text": "謎の病気を解決する"}, {"type": "subtitle", "time": 3527.43, "timestamp": "00:58:47", "text": "内外の問題"}, {"type": "subtitle", "time": 3528.91, "timestamp": "00:58:48", "text": "裁判所。"}, {"type": "subtitle", "time": 3533.91, "timestamp": "00:58:53", "text": "ソ・モは17歳で、18歳でデビューした。"}, {"type": "subtitle", "time": 3537.109, "timestamp": "00:58:57", "text": "ライトノベル2、19 ライトノベル5、20"}]
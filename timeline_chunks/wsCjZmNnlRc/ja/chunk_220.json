[{"type": "subtitle", "time": 13202.07, "timestamp": "03:40:02", "text": "だから私は日本でうまくやっていけるし、実際にうまくいった。"}, {"type": "subtitle", "time": 13203.91, "timestamp": "03:40:03", "text": "試験と面接に合格して"}, {"type": "subtitle", "time": 13206.95, "timestamp": "03:40:06", "text": "すべて。私はそこへ行く準備は万端です"}, {"type": "subtitle", "time": 13209.469, "timestamp": "03:40:09", "text": "言語に登録する"}, {"type": "subtitle", "time": 13212.95, "timestamp": "03:40:12", "text": "学校。うん。だから私はこう思った"}, {"type": "subtitle", "time": 13215.87, "timestamp": "03:40:15", "text": "この4ヶ月間は集中して"}, {"type": "subtitle", "time": 13219.19, "timestamp": "03:40:19", "text": "この緊急事態において、"}, {"type": "subtitle", "time": 13221.15, "timestamp": "03:40:21", "text": "の"}, {"type": "subtitle", "time": 13224.87, "timestamp": "03:40:24", "text": "ジョアソン。ええ、そうですね、それから1つあります"}, {"type": "subtitle", "time": 13227.71, "timestamp": "03:40:27", "text": "私が本当に言及したいこと"}, {"type": "subtitle", "time": 13231.429, "timestamp": "03:40:31", "text": "これは重要なこととして挙げておきます。"}, {"type": "subtitle", "time": 13234.79, "timestamp": "03:40:34", "text": "だから、私が目指す目標は分かっている。"}, {"type": "subtitle", "time": 13240.87, "timestamp": "03:40:40", "text": "このイベントは非常に高い。高いことは承知しています。"}, {"type": "subtitle", "time": 13242.19, "timestamp": "03:40:42", "text": "本当にそうですね"}, {"type": "subtitle", "time": 13247.51, "timestamp": "03:40:47", "text": "高い。私のジョアソンの目標金額"}, {"type": "subtitle", "time": 13251.229, "timestamp": "03:40:51", "text": "あれは本当に高い。より小規模な"}, {"type": "subtitle", "time": 13254.309, "timestamp": "03:40:54", "text": "クリエイターの名士は本当に小さい、いいえ"}, {"type": "subtitle", "time": 13257.11, "timestamp": "03:40:57", "text": "私のことを知っている人はいると思う。わからない。えーと"}, {"type": "subtitle", "time": 13259.75, "timestamp": "03:40:59", "text": "だって、誰も私のことを知らないから、"}]
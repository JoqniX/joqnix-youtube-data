[{"type": "subtitle", "time": 17461.11, "timestamp": "04:51:01", "text": "何？そのパンはどこにあるの？はい、"}, {"type": "subtitle", "time": 17463.99, "timestamp": "04:51:03", "text": "まあ、仕方ないかな。その女性は助けてくれると思う"}, {"type": "subtitle", "time": 17471.83, "timestamp": "04:51:11", "text": "くそ。私はまさに荒野にいる。"}, {"type": "subtitle", "time": 17474.868, "timestamp": "04:51:14", "text": "おい。ああ、君がここに来るんだ。まあ、この男は"}, {"type": "subtitle", "time": 17477.35, "timestamp": "04:51:17", "text": "役に立つでしょう。もっと近づいて。噛みつきませんよ"}, {"type": "subtitle", "time": 17479.83, "timestamp": "04:51:19", "text": "あなた。彼は商品を売っていると思うか"}, {"type": "subtitle", "time": 17482.39, "timestamp": "04:51:22", "text": "何か。すべてのドアを確認してください。木製"}, {"type": "subtitle", "time": 17485.51, "timestamp": "04:51:25", "text": "箱や木箱に入った物。だから、あなたは"}, {"type": "subtitle", "time": 17488.708, "timestamp": "04:51:28", "text": "そのうちの一人？彼は商人だと思う。"}, {"type": "subtitle", "time": 17491.11, "timestamp": "04:51:31", "text": "最も可能性が高い。私はただ売るだけではなく、もっとたくさんのものを売っています"}, {"type": "subtitle", "time": 17493.99, "timestamp": "04:51:33", "text": "パン。ちなみに、私の名前はカーンです。カーン。"}, {"type": "subtitle", "time": 17496.948, "timestamp": "04:51:36", "text": "クレーン。ねえ、君はハラン出身だよね？"}, {"type": "subtitle", "time": 17498.788, "timestamp": "04:51:38", "text": "きっとあなたは私の視力に問題のある人に遭遇したのでしょう"}, {"type": "subtitle", "time": 17500.708, "timestamp": "04:51:40", "text": "相棒。目が見える男のことですか？"}, {"type": "subtitle", "time": 17502.708, "timestamp": "04:51:42", "text": "ない？そう、それだ。私の息子"}, {"type": "subtitle", "time": 17505.75, "timestamp": "04:51:45", "text": "カート。わかった。"}, {"type": "subtitle", "time": 17510.788, "timestamp": "04:51:50", "text": "ああ、彼は、ええ、彼は成功しませんでした。"}, {"type": "subtitle", "time": 17514.708, "timestamp": "04:51:54", "text": "それは本当に残念ですが、"}, {"type": "subtitle", "time": 17517.51, "timestamp": "04:51:57", "text": "驚きました。ああ、あの人は彼の"}, {"type": "subtitle", "time": 17519.99, "timestamp": "04:51:59", "text": "名前は、ここの人々は免疫を持っている"}]
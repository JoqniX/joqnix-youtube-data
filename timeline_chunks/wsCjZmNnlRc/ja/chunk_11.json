[{"type": "subtitle", "time": 661.11, "timestamp": "00:11:01", "text": "えっと、たぶん卒業する前かな"}, {"type": "subtitle", "time": 663.43, "timestamp": "00:11:03", "text": "実際は学校です。"}, {"type": "subtitle", "time": 668.47, "timestamp": "00:11:08", "text": "ええ、去年のことです。 7月8日。何てことだ。"}, {"type": "subtitle", "time": 673.35, "timestamp": "00:11:13", "text": "ああ、2024年7月か。残念。くそ。"}, {"type": "subtitle", "time": 677.389, "timestamp": "00:11:17", "text": "それはずいぶん昔のことだ。"}, {"type": "subtitle", "time": 685.11, "timestamp": "00:11:25", "text": "前。うん。さて、最近はいかがお過ごしですか？"}, {"type": "subtitle", "time": 690.389, "timestamp": "00:11:30", "text": "最近？お元気ですか？"}, {"type": "subtitle", "time": 692.91, "timestamp": "00:11:32", "text": "アニメの質問またはマンガ"}, {"type": "subtitle", "time": 695.35, "timestamp": "00:11:35", "text": "エスク。物語を聞きたいですか？"}, {"type": "subtitle", "time": 698.63, "timestamp": "00:11:38", "text": "それとも、えっと、それとも、"}, {"type": "subtitle", "time": 700.87, "timestamp": "00:11:40", "text": "最初から始めたいですか？おお、"}, {"type": "subtitle", "time": 706.31, "timestamp": "00:11:46", "text": "あなたは自分がどうして私を好きなのか理解できないでしょう。"}, {"type": "subtitle", "time": 708.069, "timestamp": "00:11:48", "text": "でも、そうそう、元気だった？それは"}, {"type": "subtitle", "time": 710.069, "timestamp": "00:11:50", "text": "それもまた重要な問題だ。"}, {"type": "subtitle", "time": 713.63, "timestamp": "00:11:53", "text": "私はそれを見過ごしたくありません。"}, {"type": "subtitle", "time": 716.949, "timestamp": "00:11:56", "text": "自分？ああ、もう1年も経ったんだね"}, {"type": "subtitle", "time": 718.03, "timestamp": "00:11:58", "text": "最後"}]
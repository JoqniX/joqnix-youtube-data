[{"type": "subtitle", "time": 17762.11, "timestamp": "04:56:02", "text": "アラーム。わかった。"}, {"type": "subtitle", "time": 17764.67, "timestamp": "04:56:04", "text": "だから、私たちは"}, {"type": "subtitle", "time": 17768.47, "timestamp": "04:56:08", "text": "ここで、銃を乱射するべきか、それとも"}, {"type": "subtitle", "time": 17770.788, "timestamp": "04:56:10", "text": "隠密行動をとるべきか？私たちは"}, {"type": "subtitle", "time": 17774.55, "timestamp": "04:56:14", "text": "銃を乱射するはずだった。"}]
[{"type": "subtitle", "time": 8160.83, "timestamp": "02:16:00", "text": "そのインタビューを通して"}, {"type": "subtitle", "time": 8163.51, "timestamp": "02:16:03", "text": "あれ？それは、それが入ってきたものだと思いますか？"}, {"type": "subtitle", "time": 8166.149, "timestamp": "02:16:06", "text": "新聞とか何か？いいえ。そうです。"}, {"type": "subtitle", "time": 8168.709, "timestamp": "02:16:08", "text": "彼らは、削除しなければならないと言いました"}, {"type": "subtitle", "time": 8171.43, "timestamp": "02:16:11", "text": "いくつかのことを平等にしなければならない"}, {"type": "subtitle", "time": 8174.229, "timestamp": "02:16:14", "text": "高齢者や若者など"}, {"type": "chat", "time": 8175.042, "timestamp": "02:16:15", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "it's on internet"}, {"type": "subtitle", "time": 8182.95, "timestamp": "02:16:22", "text": "BBCのインタビューでは、あなたのことが大きく取り上げられていました。"}, {"type": "subtitle", "time": 8184.79, "timestamp": "02:16:24", "text": "仕事。"}, {"type": "subtitle", "time": 8189.03, "timestamp": "02:16:29", "text": "そうだったけど、"}, {"type": "subtitle", "time": 8191.51, "timestamp": "02:16:31", "text": "YouTuber。だから、私は"}, {"type": "subtitle", "time": 8195.27, "timestamp": "02:16:35", "text": "クレジット。いいえ、"}, {"type": "subtitle", "time": 8197.509, "timestamp": "02:16:37", "text": "将来私が望むものは私自身の"}, {"type": "subtitle", "time": 8199.83, "timestamp": "02:16:39", "text": "記事か何か。私は自分のものを買った"}, {"type": "subtitle", "time": 8202.19, "timestamp": "02:16:42", "text": "旅のこと。それはそうなるでしょう"}, {"type": "subtitle", "time": 8206.83, "timestamp": "02:16:46", "text": "楽しい。うん。でも私は"}, {"type": "subtitle", "time": 8208.75, "timestamp": "02:16:48", "text": "私はそうは思わない"}, {"type": "subtitle", "time": 8213.509, "timestamp": "02:16:53", "text": "今の状況も含めて、すべてを把握しています。いいえ。ええ。のように"}, {"type": "subtitle", "time": 8216.349, "timestamp": "02:16:56", "text": "正真正銘の最初の"}, {"type": "subtitle", "time": 8219.03, "timestamp": "02:16:59", "text": "VTubverで最初に目にする画像"}]
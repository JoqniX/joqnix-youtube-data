[{"type": "subtitle", "time": 15661.83, "timestamp": "04:21:01", "text": "お聞きいただき、良い一日をお過ごしください。そして私は"}, {"type": "subtitle", "time": 15664.79, "timestamp": "04:21:04", "text": "1週間ストリーミング配信は行いません"}, {"type": "subtitle", "time": 15667.11, "timestamp": "04:21:07", "text": "次に、次のストリームが表示されます"}, {"type": "subtitle", "time": 15672.63, "timestamp": "04:21:12", "text": "私は12日です。わかった。そして私は"}, {"type": "subtitle", "time": 15675.95, "timestamp": "04:21:15", "text": "旅行とか明日から"}, {"type": "subtitle", "time": 15680.309, "timestamp": "04:21:20", "text": "さあ、先へ進んで、などなど。ええ、私が"}, {"type": "subtitle", "time": 15683.429, "timestamp": "04:21:23", "text": "そういうこと、そういうことに直面しなきゃいけないんだ。それで"}, {"type": "subtitle", "time": 15687.67, "timestamp": "04:21:27", "text": "全てがうまくいくことを願っています。私と良い"}, {"type": "subtitle", "time": 15691.03, "timestamp": "04:21:31", "text": "皆さんの夢が叶いますように"}, {"type": "subtitle", "time": 15694.07, "timestamp": "04:21:34", "text": "信念と、あなたが持っているすべてのもの"}, {"type": "subtitle", "time": 15697.189, "timestamp": "04:21:37", "text": "実行中。わかった？諦めてはいけない。たとえあなたが"}, {"type": "subtitle", "time": 15699.189, "timestamp": "04:21:39", "text": "諦めかけていたのですが、"}, {"type": "subtitle", "time": 15702.79, "timestamp": "04:21:42", "text": "諦めてはいけない。 VTuberを見ると、"}, {"type": "subtitle", "time": 15706.309, "timestamp": "04:21:46", "text": "慰めの騎手は、"}, {"type": "subtitle", "time": 15708.63, "timestamp": "04:21:48", "text": "最善を尽くそうとしているんですよね？まるで"}, {"type": "subtitle", "time": 15710.79, "timestamp": "04:21:50", "text": "それ。あなたには最善を尽くしてほしい。"}, {"type": "subtitle", "time": 15714.269, "timestamp": "04:21:54", "text": "一歩前に進む"}, {"type": "subtitle", "time": 15716.429, "timestamp": "04:21:56", "text": "へ"}, {"type": "subtitle", "time": 15718.87, "timestamp": "04:21:58", "text": "主導権。うん。今すぐやってください。もし"}]
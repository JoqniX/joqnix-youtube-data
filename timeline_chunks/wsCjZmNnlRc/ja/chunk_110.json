[{"type": "subtitle", "time": 6602.79, "timestamp": "01:50:02", "text": "コラボレーション。彼らは私にデビューを強要した。だから私は"}, {"type": "subtitle", "time": 6604.669, "timestamp": "01:50:04", "text": "基本的に最後"}, {"type": "subtitle", "time": 6609.47, "timestamp": "01:50:09", "text": "1分が始まったところ、とてもひどい状態だった"}, {"type": "subtitle", "time": 6611.83, "timestamp": "01:50:11", "text": "シルエット、そしてそれが私の始まりでした"}, {"type": "subtitle", "time": 6615.35, "timestamp": "01:50:15", "text": "自称"}, {"type": "subtitle", "time": 6617.51, "timestamp": "01:50:17", "text": "VTuber。"}, {"type": "subtitle", "time": 6622.95, "timestamp": "01:50:22", "text": "良い面としては、デビューを果たしました"}, {"type": "subtitle", "time": 6626.39, "timestamp": "01:50:26", "text": "他の多くのデビュー前のユーチューバーとは異なり"}, {"type": "subtitle", "time": 6629.99, "timestamp": "01:50:29", "text": "既に配信されたもの。"}, {"type": "subtitle", "time": 6631.31, "timestamp": "01:50:31", "text": "ええ、私はまだ"}, {"type": "subtitle", "time": 6634.03, "timestamp": "01:50:34", "text": "デビュー前。"}, {"type": "subtitle", "time": 6637.189, "timestamp": "01:50:37", "text": "おお。信じられますか？"}, {"type": "chat", "time": 6639.533, "timestamp": "01:50:39", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "at least u debuted noiceeee unlike some"}, {"type": "subtitle", "time": 6642.109, "timestamp": "01:50:42", "text": "5年経ってもまだデビューしていない。"}, {"type": "subtitle", "time": 6644.43, "timestamp": "01:50:44", "text": "ああ、そうだね。"}, {"type": "subtitle", "time": 6647.91, "timestamp": "01:50:47", "text": "さよなら。待って、まだそれが重要だと思う？"}, {"type": "subtitle", "time": 6650.47, "timestamp": "01:50:50", "text": "でもデビューとかそういうのはどうなの？私は感じます"}, {"type": "subtitle", "time": 6653.91, "timestamp": "01:50:53", "text": "例えば、あなたが"}, {"type": "subtitle", "time": 6655.629, "timestamp": "01:50:55", "text": "リストに載せるか、"}]
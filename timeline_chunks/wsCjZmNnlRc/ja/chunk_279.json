[{"type": "subtitle", "time": 16756.91, "timestamp": "04:39:16", "text": "ハニー。待って、私はどの道を進むべきなの？"}, {"type": "subtitle", "time": 16766.31, "timestamp": "04:39:26", "text": "わかった。いいえ、水が有毒な感じがします。それで、"}, {"type": "subtitle", "time": 16768.31, "timestamp": "04:39:28", "text": "あ、待って。それはただの水です。"}, {"type": "subtitle", "time": 16777.029, "timestamp": "04:39:37", "text": "心。このDLCが大好きです。たくさん追加します"}, {"type": "subtitle", "time": 16779.91, "timestamp": "04:39:39", "text": "ストーリーと新しいゲームシステム。楽しめ"}, {"type": "subtitle", "time": 16782.91, "timestamp": "04:39:42", "text": "心から。あなたにも気に入ってもらえると嬉しいです。"}, {"type": "subtitle", "time": 16785.788, "timestamp": "04:39:45", "text": "こんにちは。私も"}, {"type": "subtitle", "time": 16789.07, "timestamp": "04:39:49", "text": "盛り上がっている。これは何ですか"}, {"type": "subtitle", "time": 16792.15, "timestamp": "04:39:52", "text": "サイン？もちろん、弾薬は持っていません"}, {"type": "subtitle", "time": 16795.75, "timestamp": "04:39:55", "text": "その銃の中に。ドイツ製のサイレンサー付きピストル。"}, {"type": "subtitle", "time": 16799.99, "timestamp": "04:39:59", "text": "消音弾は持っていません。ああ、私は"}]
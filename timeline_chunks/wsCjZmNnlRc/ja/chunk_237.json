[{"type": "subtitle", "time": 14220.11, "timestamp": "03:57:00", "text": "これ"}, {"type": "subtitle", "time": 14223.59, "timestamp": "03:57:03", "text": "イベント。ええ、これで分かりましたね"}, {"type": "subtitle", "time": 14228.389, "timestamp": "03:57:08", "text": "すべて。えっと、私が今までやってきたことは"}, {"type": "subtitle", "time": 14234.269, "timestamp": "03:57:14", "text": "する。そうですね、"}, {"type": "subtitle", "time": 14239.309, "timestamp": "03:57:19", "text": "えっと、イベントは3月に始まります"}, {"type": "subtitle", "time": 14244.95, "timestamp": "03:57:24", "text": "12日。 3月12日。皆さん、ぜひお越しください。"}, {"type": "subtitle", "time": 14247.99, "timestamp": "03:57:27", "text": "最初の配信用です。"}, {"type": "subtitle", "time": 14250.71, "timestamp": "03:57:30", "text": "はい、ええ、はい、私は"}, {"type": "subtitle", "time": 14253.51, "timestamp": "03:57:33", "text": "ストリームで約束するのは、"}, {"type": "subtitle", "time": 14255.95, "timestamp": "03:57:35", "text": "発表"}, {"type": "subtitle", "time": 14257.79, "timestamp": "03:57:37", "text": "ストリーム"}, {"type": "subtitle", "time": 14260.59, "timestamp": "03:57:40", "text": "奇跡でも起これば"}, {"type": "subtitle", "time": 14264.15, "timestamp": "03:57:44", "text": "何が起ころうとも、私はそれを維持する"}, {"type": "subtitle", "time": 14266.389, "timestamp": "03:57:46", "text": "私の銀行口座に保存しました。わかりました。"}, {"type": "subtitle", "time": 14267.63, "timestamp": "03:57:47", "text": "使用しない"}, {"type": "subtitle", "time": 14272.71, "timestamp": "03:57:52", "text": "必要な最低値に達するまで"}, {"type": "subtitle", "time": 14275.429, "timestamp": "03:57:55", "text": "それは、私は960ドル必要だと思います"}, {"type": "subtitle", "time": 14278.309, "timestamp": "03:57:58", "text": "リギング、そう、それがその金額です"}]
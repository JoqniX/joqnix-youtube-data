[{"type": "subtitle", "time": 15060.91, "timestamp": "04:11:00", "text": "外。いや、違う"}, {"type": "subtitle", "time": 15063.429, "timestamp": "04:11:03", "text": "心配事。いつも何らかの方法がある"}, {"type": "subtitle", "time": 15066.79, "timestamp": "04:11:06", "text": "密かに、ええと、神様。言ってもいいですか"}, {"type": "subtitle", "time": 15069.429, "timestamp": "04:11:09", "text": "これ？なぜ私は将来トラブルに巻き込まれるのか"}, {"type": "subtitle", "time": 15072.07, "timestamp": "04:11:12", "text": "日本から？わからない。でも、私の"}, {"type": "subtitle", "time": 15074.71, "timestamp": "04:11:14", "text": "計画は、残業せずに働くことでした"}, {"type": "subtitle", "time": 15076.95, "timestamp": "04:11:16", "text": "知っていて、"}, {"type": "subtitle", "time": 15080.229, "timestamp": "04:11:20", "text": "えーと、28時間ルール違反の部分"}, {"type": "subtitle", "time": 15083.429, "timestamp": "04:11:23", "text": "時間。いつか仕事をします"}, {"type": "subtitle", "time": 15086.07, "timestamp": "04:11:26", "text": "ストリーム用に少し余分に残しておく"}, {"type": "subtitle", "time": 15088.63, "timestamp": "04:11:28", "text": "そして矢を放った後のすべて"}, {"type": "subtitle", "time": 15091.91, "timestamp": "04:11:31", "text": "両親へのお金と私の資金"}, {"type": "subtitle", "time": 15093.99, "timestamp": "04:11:33", "text": "授業料とその他諸々。うん、"}, {"type": "subtitle", "time": 15095.51, "timestamp": "04:11:35", "text": "私もそう思いました。でも、そうですね"}, {"type": "subtitle", "time": 15098.349, "timestamp": "04:11:38", "text": "まあ、何が起きようとも。"}, {"type": "subtitle", "time": 15105.75, "timestamp": "04:11:45", "text": "心配した。ええ、こんにちは。えっと、それは"}, {"type": "subtitle", "time": 15107.83, "timestamp": "04:11:47", "text": "1時間50分、いや15分になるだろう"}, {"type": "subtitle", "time": 15109.67, "timestamp": "04:11:49", "text": "もうすぐ数分です。もし何かあれば"}, {"type": "subtitle", "time": 15111.83, "timestamp": "04:11:51", "text": "ご質問があればお気軽にお尋ねください。見ているよ"}, {"type": "subtitle", "time": 15113.95, "timestamp": "04:11:53", "text": "TwitchとYouTubeの両方"}, {"type": "subtitle", "time": 15116.87, "timestamp": "04:11:56", "text": "他の人たちとチャットして、ここで終わりにしましょう。病気"}, {"type": "subtitle", "time": 15118.51, "timestamp": "04:11:58", "text": "あと２分か３分待つ"}]
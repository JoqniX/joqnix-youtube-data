[{"type": "subtitle", "time": 14100.15, "timestamp": "03:55:00", "text": "今後はそれに焦点を当てる。できれば"}, {"type": "subtitle", "time": 14103.189, "timestamp": "03:55:03", "text": "やってみて。皆さんにそれを目撃していただきたいのです。"}, {"type": "subtitle", "time": 14105.349, "timestamp": "03:55:05", "text": "それについても同じことが言える。私が何であろうと"}, {"type": "subtitle", "time": 14107.269, "timestamp": "03:55:07", "text": "音楽で稼いだお金は"}, {"type": "subtitle", "time": 14111.269, "timestamp": "03:55:11", "text": "音楽関係のことです。それでおしまい。そして、現実世界の出来事。私"}, {"type": "subtitle", "time": 14114.95, "timestamp": "03:55:14", "text": "私はプロになったので、自分にルールを課した"}, {"type": "subtitle", "time": 14118.71, "timestamp": "03:55:18", "text": "私はストリーミングで得たお金のようなものは使いません"}, {"type": "subtitle", "time": 14122.229, "timestamp": "03:55:22", "text": "または私の現実世界の個人的なもののための場所"}, {"type": "subtitle", "time": 14126.07, "timestamp": "03:55:26", "text": "だってそれは私の考えでは悪いことだから、私は"}, {"type": "subtitle", "time": 14128.95, "timestamp": "03:55:28", "text": "自分の血を流して一生懸命働く、"}, {"type": "subtitle", "time": 14133.75, "timestamp": "03:55:33", "text": "汗と涙を流して、お金を稼いで、そして"}, {"type": "subtitle", "time": 14136.55, "timestamp": "03:55:36", "text": "稼いだお金に満足していますし、"}, {"type": "subtitle", "time": 14140.87, "timestamp": "03:55:40", "text": "生き延びて、生き残る。この世界で。それは"}, {"type": "subtitle", "time": 14144.309, "timestamp": "03:55:44", "text": "私が本当に欲しいのは、本物のお金です。現実世界では"}, {"type": "subtitle", "time": 14145.229, "timestamp": "03:55:45", "text": "そして"}, {"type": "subtitle", "time": 14151.11, "timestamp": "03:55:51", "text": "うん、そう、そう、そう、私はそう思わない"}, {"type": "subtitle", "time": 14153.51, "timestamp": "03:55:53", "text": "私は使わないルールは作らなかった"}, {"type": "subtitle", "time": 14155.429, "timestamp": "03:55:55", "text": "えーと、私が受け取る支援金は"}, {"type": "subtitle", "time": 14158.79, "timestamp": "03:55:58", "text": "オンラインフォーラムもできないから"}]
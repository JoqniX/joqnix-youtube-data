[{"type": "subtitle", "time": 17222.35, "timestamp": "04:47:02", "text": "いいえ。ああ、それは"}, {"type": "subtitle", "time": 17226.47, "timestamp": "04:47:06", "text": "ゾンビ。オランダ語。待って、つまりゾンビは"}, {"type": "subtitle", "time": 17228.788, "timestamp": "04:47:08", "text": "この場所に？そして私はそう思った"}, {"type": "subtitle", "time": 17230.59, "timestamp": "04:47:10", "text": "から解放されていた"}, {"type": "subtitle", "time": 17233.99, "timestamp": "04:47:13", "text": "ゾンビは「ああ、なんてことだ、それは"}, {"type": "subtitle", "time": 17244.948, "timestamp": "04:47:24", "text": "いいえ。そしてその場所はより混雑しているように見える"}, {"type": "subtitle", "time": 17266.55, "timestamp": "04:47:46", "text": "わかった。こんにちは。"}, {"type": "subtitle", "time": 17268.47, "timestamp": "04:47:48", "text": "なんでしょう？話をする必要がある"}, {"type": "subtitle", "time": 17271.19, "timestamp": "04:47:51", "text": "責任者。私はハラン出身です。おお、"}, {"type": "subtitle", "time": 17274.47, "timestamp": "04:47:54", "text": "お前は密輸業者だ。あなたは悪党のために働いているのですか？"}, {"type": "subtitle", "time": 17276.07, "timestamp": "04:47:56", "text": "誰が？見てください、私は何も知りません"}, {"type": "subtitle", "time": 17277.83, "timestamp": "04:47:57", "text": "密輸はダメだよ、相棒。私はここにいるのは、"}]
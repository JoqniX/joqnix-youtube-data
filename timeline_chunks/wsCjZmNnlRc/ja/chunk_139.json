[{"type": "subtitle", "time": 8340.23, "timestamp": "02:19:00", "text": "アバターの中には、"}, {"type": "subtitle", "time": 8342.509, "timestamp": "02:19:02", "text": "熱狂的なファンを獲得した"}, {"type": "subtitle", "time": 8344.99, "timestamp": "02:19:04", "text": "続く。ベヌ・シー"}, {"type": "subtitle", "time": 8348.07, "timestamp": "02:19:08", "text": "ジョーシは、有名な作家であり、"}, {"type": "subtitle", "time": 8351.509, "timestamp": "02:19:11", "text": "インドのVTuberタレントエージェンシープロジェクト"}, {"type": "subtitle", "time": 8353.83, "timestamp": "02:19:13", "text": "スタースケープによると、この傾向は"}, {"type": "subtitle", "time": 8356.549, "timestamp": "02:19:16", "text": "インドでの人気は9世紀に"}, {"type": "subtitle", "time": 8360.309, "timestamp": "02:19:20", "text": "パンデミック。 Jock Nexusのクリエイターが願っていた"}, {"type": "subtitle", "time": 8363.11, "timestamp": "02:19:23", "text": "デジタルアバターによってのみ知られる"}, {"type": "subtitle", "time": 8364.87, "timestamp": "02:19:24", "text": "90以上あると推定されている"}, {"type": "subtitle", "time": 8368.07, "timestamp": "02:19:28", "text": "インドにVTuberがいるなんて本当に。彼は主張する"}, {"type": "subtitle", "time": 8369.87, "timestamp": "02:19:29", "text": "インド人のリスト"}, {"type": "subtitle", "time": 8373.27, "timestamp": "02:19:33", "text": "TwitterでVTuberとして活動し、モデレーターも務めている。"}, {"type": "subtitle", "time": 8376.23, "timestamp": "02:19:36", "text": "Discordサーバーとオンラインスペース"}, {"type": "subtitle", "time": 8378.549, "timestamp": "02:19:38", "text": "同じ考えを持つ人々と交流する"}, {"type": "subtitle", "time": 8380.79, "timestamp": "02:19:40", "text": "その他ビデオやテキストチャットで"}, {"type": "subtitle", "time": 8384.629, "timestamp": "02:19:44", "text": "コミュニティ。 Discordのモデレーターが見えます。"}, {"type": "subtitle", "time": 8388.79, "timestamp": "02:19:48", "text": "この現象はまだ主流にはなっていない"}, {"type": "subtitle", "time": 8390.95, "timestamp": "02:19:50", "text": "インドでの人気だが、参加者は"}, {"type": "subtitle", "time": 8394.07, "timestamp": "02:19:54", "text": "早く状況が変わることを願っています。 BBC"}, {"type": "subtitle", "time": 8396.55, "timestamp": "02:19:56", "text": "インドのVTuberクリエイター数名に話を聞いた"}, {"type": "subtitle", "time": 8399.03, "timestamp": "02:19:59", "text": "この傾向を改善するためのアカウントの魅力"}]
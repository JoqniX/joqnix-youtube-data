[{"type": "subtitle", "time": 7146.87, "timestamp": "01:59:06", "text": "何てことだ。アニメが見たいな"}, {"type": "subtitle", "time": 7149.669, "timestamp": "01:59:09", "text": "そのため。"}, {"type": "subtitle", "time": 7151.27, "timestamp": "01:59:11", "text": "できますが、あまり時間をかけませんでした"}, {"type": "subtitle", "time": 7152.43, "timestamp": "01:59:12", "text": "お金。"}, {"type": "subtitle", "time": 7155.39, "timestamp": "01:59:15", "text": "[音楽]"}, {"type": "subtitle", "time": 7159.95, "timestamp": "01:59:19", "text": "ええ、実はアーカイブしました"}, {"type": "subtitle", "time": 7164.629, "timestamp": "01:59:24", "text": "プロジェクト、だって、そう感じたから"}, {"type": "subtitle", "time": 7167.35, "timestamp": "01:59:27", "text": "うん、そうだね、もし私が"}, {"type": "subtitle", "time": 7171.03, "timestamp": "01:59:31", "text": "アニメ化される夢を見る"}, {"type": "subtitle", "time": 7173.91, "timestamp": "01:59:33", "text": "そして多くのことが必要で、"}, {"type": "chat", "time": 7176.381, "timestamp": "01:59:36", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "frerein been the latest anime hype lately."}, {"type": "subtitle", "time": 7177.669, "timestamp": "01:59:37", "text": "つながりや人々、その他諸々"}, {"type": "subtitle", "time": 7180.87, "timestamp": "01:59:40", "text": "それに役立つもの。"}, {"type": "subtitle", "time": 7182.629, "timestamp": "01:59:42", "text": "だから私はこう思った。「よし、じゃあこうしよう。"}, {"type": "subtitle", "time": 7185.47, "timestamp": "01:59:45", "text": "次はジョーに焦点を当てます"}, {"type": "subtitle", "time": 7189.109, "timestamp": "01:59:49", "text": "今だ。」ああ、そうそう、フリーエンド"}, {"type": "subtitle", "time": 7192.589, "timestamp": "01:59:52", "text": "なかなか面白い。えっと、私は"}, {"type": "subtitle", "time": 7196.189, "timestamp": "01:59:56", "text": "しっかりしたものが好きなんです"}, {"type": "subtitle", "time": 7198.709, "timestamp": "01:59:58", "text": "家。私も投げキッスをしたことがある"}]
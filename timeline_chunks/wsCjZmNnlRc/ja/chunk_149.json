[{"type": "subtitle", "time": 8977.59, "timestamp": "02:29:37", "text": "でも、退屈な人間じゃないといいな。"}, {"type": "subtitle", "time": 8980.71, "timestamp": "02:29:40", "text": "あなたは好きで、"}, {"type": "subtitle", "time": 8982.55, "timestamp": "02:29:42", "text": "それは何と呼ばれますか？神様、私には無理です"}, {"type": "subtitle", "time": 8985.11, "timestamp": "02:29:45", "text": "私の文章を先に書いてください。ああ、なんてことだ、"}, {"type": "subtitle", "time": 8987.19, "timestamp": "02:29:47", "text": "そんなに眠いの？わあ、あなたは全然退屈じゃないですね"}, {"type": "subtitle", "time": 8990.23, "timestamp": "02:29:50", "text": "自分。心配しないで。まるで私が"}, {"type": "subtitle", "time": 8992.55, "timestamp": "02:29:52", "text": "あまりにも静かすぎる。私はそういうタイプじゃない。"}, {"type": "subtitle", "time": 8996.309, "timestamp": "02:29:56", "text": "ただ、ちゃんと寝ていればよかったのに。"}, {"type": "subtitle", "time": 8997.83, "timestamp": "02:29:57", "text": "うん、"}, {"type": "subtitle", "time": 8999.59, "timestamp": "02:29:59", "text": "心配ない。睡眠は大切だ。でもあなたは"}]
[{"type": "subtitle", "time": 1620.31, "timestamp": "00:27:00", "text": "もの。最近は何をしていましたか？"}, {"type": "subtitle", "time": 1623.909, "timestamp": "00:27:03", "text": "生活はどうですか？大学院。大学院。"}, {"type": "subtitle", "time": 1627.19, "timestamp": "00:27:07", "text": "えっと、終わったと思ったんだけど"}, {"type": "subtitle", "time": 1630.31, "timestamp": "00:27:10", "text": "卒業式か何か。"}, {"type": "subtitle", "time": 1632.149, "timestamp": "00:27:12", "text": "そう、私はつい最近卒業したばかりです"}, {"type": "subtitle", "time": 1634.909, "timestamp": "00:27:14", "text": "修士号。"}, {"type": "chat", "time": 1643.956, "timestamp": "00:27:23", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "I'm from USA born and raised.but I grew up in martial arts.warrior culture transcend boundary lines. I had trained from Japan China Philippines Korea etc. so my instructors taught me of other cultures"}, {"type": "subtitle", "time": 1644.149, "timestamp": "00:27:24", "text": "ええ、私はストリーミングしていません"}, {"type": "subtitle", "time": 1647.269, "timestamp": "00:27:27", "text": "暑い間、私は"}, {"type": "subtitle", "time": 1649.83, "timestamp": "00:27:29", "text": "大学院。"}, {"type": "subtitle", "time": 1659.35, "timestamp": "00:27:39", "text": "私は武道の環境で育ちました。あなたは"}, {"type": "subtitle", "time": 1661.83, "timestamp": "00:27:41", "text": "アメリカ生まれ育ちですが、"}, {"type": "subtitle", "time": 1664.95, "timestamp": "00:27:44", "text": "武道戦士文化を超越する"}, {"type": "subtitle", "time": 1666.87, "timestamp": "00:27:46", "text": "境界線。私はトレーニングをしました"}, {"type": "subtitle", "time": 1670.19, "timestamp": "00:27:50", "text": "日本、中国、フィリピン"}, {"type": "subtitle", "time": 1674.07, "timestamp": "00:27:54", "text": "韓国など。それで私のインストラクターは"}, {"type": "subtitle", "time": 1676.789, "timestamp": "00:27:56", "text": "他の文化について教えてくれた。どこに"}]
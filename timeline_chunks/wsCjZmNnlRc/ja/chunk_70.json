[{"type": "subtitle", "time": 4201.03, "timestamp": "01:10:01", "text": "どちらも実際の在庫であり、インターネット上のものではありませんでした。"}, {"type": "subtitle", "time": 4203.79, "timestamp": "01:10:03", "text": "そして語学プログラム。"}, {"type": "subtitle", "time": 4217.83, "timestamp": "01:10:17", "text": "こんにちは。人をからかうことができるかどうか、私にはわかりません。"}, {"type": "subtitle", "time": 4221.669, "timestamp": "01:10:21", "text": "私はそういうのが本当に苦手なんです。感じる"}, {"type": "subtitle", "time": 4229.91, "timestamp": "01:10:29", "text": "それ。私は人々と話すことができなかった。それ"}]
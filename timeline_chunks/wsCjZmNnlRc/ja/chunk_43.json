[{"type": "subtitle", "time": 2582.87, "timestamp": "00:43:02", "text": "あなたが稼ぐこと、そしてあなたがどれだけ成功しているか。"}, {"type": "subtitle", "time": 2585.589, "timestamp": "00:43:05", "text": "悲しいことだ。職場の文化が困難にしている"}, {"type": "subtitle", "time": 2590.069, "timestamp": "00:43:10", "text": "ただ人間らしくありたいだけ。ああ、ある意味ではね"}, {"type": "subtitle", "time": 2592.069, "timestamp": "00:43:12", "text": "それは時として真実である。うん。そして私は"}, {"type": "subtitle", "time": 2594.71, "timestamp": "00:43:14", "text": "次はあの国に行く予定です。次へ 次へ"}, {"type": "subtitle", "time": 2597.67, "timestamp": "00:43:17", "text": "1つ。の"}, {"type": "subtitle", "time": 2599.19, "timestamp": "00:43:19", "text": "彼らはハンマーを叩くつもりだろう"}, {"type": "subtitle", "time": 2606.069, "timestamp": "00:43:26", "text": "何てことだ。"}, {"type": "subtitle", "time": 2609.03, "timestamp": "00:43:29", "text": "マルメ出身なのが悲しい。私はこう言いますが、"}, {"type": "subtitle", "time": 2610.95, "timestamp": "00:43:30", "text": "私もこれはかなり適切だと思います。"}, {"type": "subtitle", "time": 2612.87, "timestamp": "00:43:32", "text": "マルメが作っている顔が"}, {"type": "subtitle", "time": 2615.51, "timestamp": "00:43:35", "text": "私をとても"}, {"type": "subtitle", "time": 2618.71, "timestamp": "00:43:38", "text": "私はサディスティックかもしれないが、"}, {"type": "subtitle", "time": 2622.39, "timestamp": "00:43:42", "text": "少しトーンダウンしてみましょう。"}, {"type": "subtitle", "time": 2630.069, "timestamp": "00:43:50", "text": "さて、今日私たちがやろうとしていることは"}, {"type": "subtitle", "time": 2631.99, "timestamp": "00:43:51", "text": "私たちはどこまで行けるか見てみよう"}, {"type": "subtitle", "time": 2633.829, "timestamp": "00:43:53", "text": "Twitchがこれをプッシュする前に、"}]
[{"type": "subtitle", "time": 17883.708, "timestamp": "04:58:03", "text": "病院。デニー、病院はどうだった？"}, {"type": "subtitle", "time": 17890.75, "timestamp": "04:58:10", "text": "あなたに私は"}, {"type": "subtitle", "time": 17894.99, "timestamp": "04:58:14", "text": "設計図を作成する必要があります。わかった、"}, {"type": "subtitle", "time": 17908.788, "timestamp": "04:58:28", "text": "選ぶ。実際にはロックする必要はありません"}, {"type": "subtitle", "time": 17922.24, "timestamp": "04:58:42", "text": "豪華な刃。"}, {"type": "subtitle", "time": 17927.628, "timestamp": "04:58:47", "text": "[音楽]"}, {"type": "subtitle", "time": 17930.99, "timestamp": "04:58:50", "text": "叔父は何も言わない。いいえ"}, {"type": "subtitle", "time": 17934.47, "timestamp": "04:58:54", "text": "武器庫。私はたくさん見せます。ああ、金属製の箱。"}, {"type": "subtitle", "time": 17939.868, "timestamp": "04:58:59", "text": "[音楽]"}]
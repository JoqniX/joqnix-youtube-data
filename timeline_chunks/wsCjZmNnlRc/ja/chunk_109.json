[{"type": "subtitle", "time": 6548.07, "timestamp": "01:49:08", "text": "いいえ。何か私にしてほしいことがあるの？"}, {"type": "subtitle", "time": 6555.109, "timestamp": "01:49:15", "text": "それとも、今はただのんびりしているだけ？私"}, {"type": "subtitle", "time": 6556.79, "timestamp": "01:49:16", "text": "主にあなたとのんびりしたかったし"}, {"type": "subtitle", "time": 6559.109, "timestamp": "01:49:19", "text": "物事について話し合うこと。"}, {"type": "subtitle", "time": 6560.709, "timestamp": "01:49:20", "text": "うん。"}, {"type": "subtitle", "time": 6563.75, "timestamp": "01:49:23", "text": "何について話したいですか？"}, {"type": "subtitle", "time": 6566.09, "timestamp": "01:49:26", "text": "話す。"}, {"type": "subtitle", "time": 6568.95, "timestamp": "01:49:28", "text": "[音楽]"}, {"type": "subtitle", "time": 6578.19, "timestamp": "01:49:38", "text": "いや、いや、いや。のように"}, {"type": "subtitle", "time": 6588.109, "timestamp": "01:49:48", "text": "ええ、そうですね。何があなたを"}, {"type": "subtitle", "time": 6591.75, "timestamp": "01:49:51", "text": "YouTuberについて発見するのが好きです"}, {"type": "subtitle", "time": 6596.31, "timestamp": "01:49:56", "text": "もの？私はデビューを断念せざるを得なかった"}]
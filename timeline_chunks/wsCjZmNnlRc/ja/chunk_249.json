[{"type": "subtitle", "time": 14940.469, "timestamp": "04:09:00", "text": "できるよ。こんにちは。"}, {"type": "subtitle", "time": 14942.309, "timestamp": "04:09:02", "text": "彼の配信ではいつもそうなんです。 J氏"}, {"type": "subtitle", "time": 14946.469, "timestamp": "04:09:06", "text": "した。こんにちは。ありがとう。ありがとう。それはつまり"}, {"type": "subtitle", "time": 14950.55, "timestamp": "04:09:10", "text": "たくさん。こんにちは。繰り返しますが、これは重要なことです。"}, {"type": "subtitle", "time": 14954.75, "timestamp": "04:09:14", "text": "寄付はしないでください"}, {"type": "subtitle", "time": 14959.59, "timestamp": "04:09:19", "text": "えーと、もしあなたが必要としているなら、"}, {"type": "subtitle", "time": 14961.99, "timestamp": "04:09:21", "text": "そのお金は自分のために使いなさい。もしその一つが"}, {"type": "subtitle", "time": 14966.15, "timestamp": "04:09:26", "text": "あなたは私に寄付してくれている、私はバカだって分かってる"}, {"type": "subtitle", "time": 14967.91, "timestamp": "04:09:27", "text": "私が運営しているにもかかわらず、"}, {"type": "subtitle", "time": 14970.55, "timestamp": "04:09:30", "text": "サブアトンイベント、しかし、しかし、しかし、しかし、しかし、"}, {"type": "subtitle", "time": 14973.91, "timestamp": "04:09:33", "text": "でも、これだけは覚えておいてくださいね。お願いします"}, {"type": "subtitle", "time": 14977.55, "timestamp": "04:09:37", "text": "私に渡したいお金を使うか、"}, {"type": "subtitle", "time": 14979.99, "timestamp": "04:09:39", "text": "自分のための何か。自分にご褒美をあげよう"}, {"type": "subtitle", "time": 14982.71, "timestamp": "04:09:42", "text": "素敵な贈り物とともに。わかった？君たちは"}, {"type": "subtitle", "time": 14985.91, "timestamp": "04:09:45", "text": "今、一生懸命働いています。皆さん"}, {"type": "subtitle", "time": 14987.67, "timestamp": "04:09:47", "text": "ストリームに参加している人たち"}, {"type": "subtitle", "time": 14989.83, "timestamp": "04:09:49", "text": "そして聞いていない人たち"}, {"type": "subtitle", "time": 14990.91, "timestamp": "04:09:50", "text": "ボード"}, {"type": "subtitle", "time": 14993.83, "timestamp": "04:09:53", "text": "あなたが知っているすべては、あなたがそれに値する"}, {"type": "subtitle", "time": 14996.71, "timestamp": "04:09:56", "text": "あなたが私を支援するために使うお金。わかった？あなた"}, {"type": "subtitle", "time": 14999.63, "timestamp": "04:09:59", "text": "全くお金を使う必要はありません。単に"}]
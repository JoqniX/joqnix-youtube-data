[{"type": "subtitle", "time": 13025.349, "timestamp": "03:37:05", "text": "うーん、ジョスは私が諦められない存在です。"}, {"type": "subtitle", "time": 13028.07, "timestamp": "03:37:08", "text": "たとえ私がそれをVチューブに持ち込んだとしても、"}, {"type": "subtitle", "time": 13030.469, "timestamp": "03:37:10", "text": "たとえ当初の目標が"}, {"type": "subtitle", "time": 13032.55, "timestamp": "03:37:12", "text": "音楽アーティストになって"}, {"type": "subtitle", "time": 13035.19, "timestamp": "03:37:15", "text": "すべて、私の夢が何であれ"}, {"type": "subtitle", "time": 13037.91, "timestamp": "03:37:17", "text": "ジョックン、それは変わらないだろう。"}, {"type": "subtitle", "time": 13040.63, "timestamp": "03:37:20", "text": "そして私は自分の夢を追いかけ、"}, {"type": "subtitle", "time": 13043.349, "timestamp": "03:37:23", "text": "Jockを使った目標設定。たとえ私ができなかったとしても"}, {"type": "subtitle", "time": 13047.19, "timestamp": "03:37:27", "text": "彼らに続いて、私はそうするつもりです"}, {"type": "subtitle", "time": 13049.51, "timestamp": "03:37:29", "text": "この旅全体を通して、なぜなら"}, {"type": "subtitle", "time": 13051.83, "timestamp": "03:37:31", "text": "この旅は私にとってとても大切なものです。私はたくさんの人に会った"}, {"type": "subtitle", "time": 13054.469, "timestamp": "03:37:34", "text": "この期間中、人々、善良な人々"}, {"type": "subtitle", "time": 13057.51, "timestamp": "03:37:37", "text": "旅。そう、そして私は決して"}, {"type": "subtitle", "time": 13060.79, "timestamp": "03:37:40", "text": "卒業するまで、または卒業できない限り"}, {"type": "subtitle", "time": 13065.59, "timestamp": "03:37:45", "text": "物理的にストリーミングしたり"}, {"type": "subtitle", "time": 13067.91, "timestamp": "03:37:47", "text": "えっと、もし私が本当にそうじゃないとしたら"}, {"type": "subtitle", "time": 13071.51, "timestamp": "03:37:51", "text": "病気、病気、あるいは死から抜け出しているのかどうか"}, {"type": "subtitle", "time": 13073.269, "timestamp": "03:37:53", "text": "老衰か何かで。私はしません"}, {"type": "subtitle", "time": 13076.269, "timestamp": "03:37:56", "text": "知る。私はここにいます"}, {"type": "subtitle", "time": 13079.03, "timestamp": "03:37:59", "text": "永遠に。それが私の考えです。私は"}]
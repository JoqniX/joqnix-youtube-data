[{"type": "subtitle", "time": 16682.22, "timestamp": "04:38:02", "text": "何？何の母親？"}, {"type": "subtitle", "time": 16687.67, "timestamp": "04:38:07", "text": "[音楽]"}, {"type": "subtitle", "time": 16689.83, "timestamp": "04:38:09", "text": "田舎。ランナーたちが運んできた"}, {"type": "subtitle", "time": 16693.59, "timestamp": "04:38:13", "text": "重傷を負い、錯乱した男たちが"}, {"type": "subtitle", "time": 16696.31, "timestamp": "04:38:16", "text": "ウイルスに対する免疫を持つ人々について。彼は"}, {"type": "subtitle", "time": 16700.31, "timestamp": "04:38:20", "text": "ハランからの脱出経路を示す地図。そこには"}, {"type": "subtitle", "time": 16702.551, "timestamp": "04:38:22", "text": "ここでは病人がますます増えている。ない"}, {"type": "subtitle", "time": 16705.91, "timestamp": "04:38:25", "text": "アンダーソンとカムデンの研究は十分だ"}, {"type": "subtitle", "time": 16708.39, "timestamp": "04:38:28", "text": "まだ実を結んでいない。私たちは"}, {"type": "subtitle", "time": 16712.23, "timestamp": "04:38:32", "text": "すべての葉を調べてください。こんにちは。行く。"}, {"type": "subtitle", "time": 16713.99, "timestamp": "04:38:33", "text": "武器とかは持ってるかな？私は思う"}, {"type": "subtitle", "time": 16717.39, "timestamp": "04:38:37", "text": "そうですよね？私はします。何てことだ。さあ"}, {"type": "subtitle", "time": 16721.949, "timestamp": "04:38:41", "text": "行く。武器と作戦スペースはちゃんとあります"}, {"type": "subtitle", "time": 16726.15, "timestamp": "04:38:46", "text": "銃。ああ、本当に会いたかったよ。私の空間"}, {"type": "subtitle", "time": 16728.67, "timestamp": "04:38:48", "text": "重力"}, {"type": "subtitle", "time": 16733.15, "timestamp": "04:38:53", "text": "銃。感度を私に知らせてください"}, {"type": "subtitle", "time": 16735.75, "timestamp": "04:38:55", "text": "変更しました。久しぶりに"}]
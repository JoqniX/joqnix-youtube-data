[{"type": "subtitle", "time": 18782.47, "timestamp": "05:13:02", "text": "人々？これです？いいえ。"}, {"type": "subtitle", "time": 18791.31, "timestamp": "05:13:11", "text": "これは違います。"}, {"type": "subtitle", "time": 18794.75, "timestamp": "05:13:14", "text": "えっと、待って。どうやって？ わかった、"}, {"type": "subtitle", "time": 18801.43, "timestamp": "05:13:21", "text": "いいえ、私は切り替えようとしていました"}, {"type": "subtitle", "time": 18804.15, "timestamp": "05:13:24", "text": "グラップリングフックでそれを掴む"}, {"type": "subtitle", "time": 18807.19, "timestamp": "05:13:27", "text": "街灯か何かだけど、"}, {"type": "subtitle", "time": 18810.43, "timestamp": "05:13:30", "text": "大丈夫。それはそうだったと思う"}, {"type": "subtitle", "time": 18814.67, "timestamp": "05:13:34", "text": "保存しました。たぶん、ああ、いや。そうだ、それだ"}, {"type": "subtitle", "time": 18816.43, "timestamp": "05:13:36", "text": "そうしなかった、"}, {"type": "subtitle", "time": 18818.788, "timestamp": "05:13:38", "text": "男。わかった、いいよ。少なくとも私は"}]
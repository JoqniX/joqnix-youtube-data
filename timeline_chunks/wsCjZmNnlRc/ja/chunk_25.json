[{"type": "subtitle", "time": 1500.23, "timestamp": "00:25:00", "text": "タイ語。それらのどれでも考えられます。"}, {"type": "subtitle", "time": 1504.549, "timestamp": "00:25:04", "text": "ああ、それからそれはまるで"}, {"type": "subtitle", "time": 1507.669, "timestamp": "00:25:07", "text": "通常、北京出身の人々はこう付け加えるだろう"}, {"type": "subtitle", "time": 1511.51, "timestamp": "00:25:11", "text": "彼らのスピーチ。だから私はこう言った、君は転がす"}, {"type": "subtitle", "time": 1518.71, "timestamp": "00:25:18", "text": "ああ、いつか私がもっと上手くなったら"}, {"type": "subtitle", "time": 1521.43, "timestamp": "00:25:21", "text": "十分に流暢になったときに学習するか、"}, {"type": "subtitle", "time": 1524.47, "timestamp": "00:25:24", "text": "話せる人になりたい 話せる人になりたい"}, {"type": "subtitle", "time": 1527.35, "timestamp": "00:25:27", "text": "中国語の会話レベルであれば、"}, {"type": "subtitle", "time": 1530.07, "timestamp": "00:25:30", "text": "中国語か何かで話して。いいえ、いいえ"}, {"type": "subtitle", "time": 1531.909, "timestamp": "00:25:31", "text": "心配事。心配ない。私は言われた"}, {"type": "subtitle", "time": 1544.63, "timestamp": "00:25:44", "text": "えっと、最初に何を学びたいですか？私"}, {"type": "subtitle", "time": 1546.029, "timestamp": "00:25:46", "text": "できるだろうか、できるだろうか"}, {"type": "subtitle", "time": 1549.19, "timestamp": "00:25:49", "text": "おそらく、私が始めるでしょう。"}, {"type": "subtitle", "time": 1552.47, "timestamp": "00:25:52", "text": "いいえ、中国語を学びたいのですが、"}, {"type": "subtitle", "time": 1554.95, "timestamp": "00:25:54", "text": "えっと、今日本語を勉強しています。"}, {"type": "subtitle", "time": 1556.549, "timestamp": "00:25:56", "text": "私は留学のために日本へ行きます"}, {"type": "subtitle", "time": 1559.029, "timestamp": "00:25:59", "text": "今は日本人です。待って、私があなたに言ったことあったっけ？"}]
[{"type": "subtitle", "time": 16323.429, "timestamp": "04:32:03", "text": "ええ、1月8日から14日の週ですね。"}, {"type": "subtitle", "time": 16326.59, "timestamp": "04:32:06", "text": "私が生まれて最後の日だった"}, {"type": "subtitle", "time": 16331.67, "timestamp": "04:32:11", "text": "えーっと、ストリーム配信したことありますか？"}, {"type": "subtitle", "time": 16334.07, "timestamp": "04:32:14", "text": "スケジュール配信とかそういうもの。それで"}, {"type": "subtitle", "time": 16337.91, "timestamp": "04:32:17", "text": "昨日、えっと、ちょっと"}, {"type": "subtitle", "time": 16341.429, "timestamp": "04:32:21", "text": "抑えたり、持ち上げたり、修正したり"}, {"type": "subtitle", "time": 16344.469, "timestamp": "04:32:24", "text": "ストリーム、えーと、アセットのようなもの"}, {"type": "subtitle", "time": 16347.03, "timestamp": "04:32:27", "text": "もの。だから私は何時間もそれに取り組んでいた"}, {"type": "subtitle", "time": 16349.03, "timestamp": "04:32:29", "text": "だって、コーディングがわからないから。"}, {"type": "subtitle", "time": 16352.07, "timestamp": "04:32:32", "text": "Figmaの動画とか色々。まあまあ"}, {"type": "subtitle", "time": 16355.03, "timestamp": "04:32:35", "text": "そうすれば、私にとってはやりやすくなるでしょう。そうですね"}, {"type": "subtitle", "time": 16357.91, "timestamp": "04:32:37", "text": "時間がかかったので、私はちょっと"}, {"type": "subtitle", "time": 16361.189, "timestamp": "04:32:41", "text": "遅かったので、スケジュール関連の作業を急いで済ませました。"}, {"type": "subtitle", "time": 16363.67, "timestamp": "04:32:43", "text": "そこで、Discordサーバーでは"}, {"type": "subtitle", "time": 16365.91, "timestamp": "04:32:45", "text": "スケジュールチャンネルのほとんどは"}, {"type": "subtitle", "time": 16367.349, "timestamp": "04:32:47", "text": "スケジュールチャンネルを見ることができます"}, {"type": "subtitle", "time": 16370.229, "timestamp": "04:32:50", "text": "なぜなら、今はリソースチャネルになっているからです。それで"}, {"type": "subtitle", "time": 16372.309, "timestamp": "04:32:52", "text": "サーバーガイドをクリックすると、"}, {"type": "subtitle", "time": 16374.87, "timestamp": "04:32:54", "text": "スケジュールにアクセスすることもできます"}]
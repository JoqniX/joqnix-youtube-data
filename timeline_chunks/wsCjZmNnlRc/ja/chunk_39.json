[{"type": "subtitle", "time": 2340.31, "timestamp": "00:39:00", "text": "理解する なぜなのか なぜなのか"}, {"type": "subtitle", "time": 2342.79, "timestamp": "00:39:02", "text": "もしあなたが手を差し伸べているなら、とても難しい"}, {"type": "subtitle", "time": 2345.99, "timestamp": "00:39:05", "text": "チャンネルサイズは大きく、"}, {"type": "subtitle", "time": 2349.67, "timestamp": "00:39:09", "text": "取引的なものとして捉えて、"}, {"type": "chat", "time": 2352.303, "timestamp": "00:39:12", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Nezuki Wilson Ch.~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 2353.51, "timestamp": "00:39:13", "text": "サイズは小さいですが。うん。しかし"}, {"type": "subtitle", "time": 2355.63, "timestamp": "00:39:15", "text": "それでもあなたは多くのものを手に入れることができました"}, {"type": "subtitle", "time": 2359.829, "timestamp": "00:39:19", "text": "さまざまな体格の人々がいて、私は"}, {"type": "subtitle", "time": 2362.55, "timestamp": "00:39:22", "text": "むしろ私は「え、どうやって」って感じだった"}, {"type": "subtitle", "time": 2365.03, "timestamp": "00:39:25", "text": "ミステリオがやったのか？他の人たちはどう"}, {"type": "subtitle", "time": 2367.51, "timestamp": "00:39:27", "text": "人々はそれを行うのか？それは依存しているようなものですか"}, {"type": "subtitle", "time": 2371.27, "timestamp": "00:39:31", "text": "一部の人々？その時気づいたのですが"}, {"type": "subtitle", "time": 2373.75, "timestamp": "00:39:33", "text": "そう、YouTuberは"}, {"type": "subtitle", "time": 2376.87, "timestamp": "00:39:36", "text": "コラボレーションを行う小規模ストリーマーなど"}, {"type": "subtitle", "time": 2378.39, "timestamp": "00:39:38", "text": "もっと大きいものと一緒に、それらは"}, {"type": "subtitle", "time": 2380.87, "timestamp": "00:39:40", "text": "彼らと気軽に友達になるのは"}, {"type": "subtitle", "time": 2382.63, "timestamp": "00:39:42", "text": "大丈夫。だから彼らはそれを"}, {"type": "subtitle", "time": 2384.95, "timestamp": "00:39:44", "text": "取引的なもの、例えばあなたが"}, {"type": "subtitle", "time": 2388.79, "timestamp": "00:39:48", "text": "コラボレーションして、もしあなたが自分自身なら"}, {"type": "subtitle", "time": 2391.349, "timestamp": "00:39:51", "text": "より大きなチャンネルとのコラボレーションに参加する"}, {"type": "subtitle", "time": 2394.63, "timestamp": "00:39:54", "text": "そしてより大きなチャンネルの規模が彼らのコミュニティ"}, {"type": "subtitle", "time": 2399.39, "timestamp": "00:39:59", "text": "チャットは速く進んでいて、あなたのチャットは"}]
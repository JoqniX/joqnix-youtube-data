[{"type": "subtitle", "time": 16262.11, "timestamp": "04:31:02", "text": "もの。もし私ができるなら"}, {"type": "subtitle", "time": 16267.349, "timestamp": "04:31:07", "text": "どこを探せばいいか。待って、ちょっと待って。"}, {"type": "subtitle", "time": 16269.83, "timestamp": "04:31:09", "text": "私のどこ？ ああ、入れてないよ"}, {"type": "subtitle", "time": 16272.07, "timestamp": "04:31:12", "text": "シーン。あ、ごめんなさい。私のミスです。私のミスです。私"}, {"type": "subtitle", "time": 16274.149, "timestamp": "04:31:14", "text": "私はこのシーンには入れていません。"}, {"type": "subtitle", "time": 16276.349, "timestamp": "04:31:16", "text": "はい、私の"}, {"type": "subtitle", "time": 16279.469, "timestamp": "04:31:19", "text": "悪い。えっと、コピーさせてください"}, {"type": "subtitle", "time": 16285.149, "timestamp": "04:31:25", "text": "これ。技術的な話で申し訳ありません。しかし"}, {"type": "subtitle", "time": 16287.55, "timestamp": "04:31:27", "text": "うん、終わったよ。もうすぐ終わります。ほとんど"}, {"type": "subtitle", "time": 16292.59, "timestamp": "04:31:32", "text": "終わり。こんにちは、こちらです。こんにちは。そうすれば"}, {"type": "subtitle", "time": 16296.55, "timestamp": "04:31:36", "text": "ほら、またスケジュールを立ててるよ"}, {"type": "subtitle", "time": 16305.87, "timestamp": "04:31:45", "text": "長いVHSはスケジュールから言うことができます"}, {"type": "subtitle", "time": 16309.11, "timestamp": "04:31:49", "text": "ストリーム。私の最後の配信スケジュールはいつですか？"}, {"type": "subtitle", "time": 16312.71, "timestamp": "04:31:52", "text": "また？確かずっと昔のことだったと思う"}, {"type": "subtitle", "time": 16315.269, "timestamp": "04:31:55", "text": "どのような"}, {"type": "subtitle", "time": 16319.91, "timestamp": "04:31:59", "text": "えーと、1月14日が最後でした"}]
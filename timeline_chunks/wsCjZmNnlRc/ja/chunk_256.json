[{"type": "subtitle", "time": 15360.79, "timestamp": "04:16:00", "text": "そのモデルでは、特にアーティスト"}, {"type": "subtitle", "time": 15362.309, "timestamp": "04:16:02", "text": "すべて。誰が"}, {"type": "subtitle", "time": 15365.63, "timestamp": "04:16:05", "text": "アーティスト本人、もしくは現在その作品に関わっている人物。"}, {"type": "subtitle", "time": 15369.229, "timestamp": "04:16:09", "text": "しかしデビューが実現すれば、"}, {"type": "subtitle", "time": 15373.79, "timestamp": "04:16:13", "text": "あなたにしか言えません。"}, {"type": "subtitle", "time": 15375.71, "timestamp": "04:16:15", "text": "パ"}, {"type": "subtitle", "time": 15380.389, "timestamp": "04:16:20", "text": "こんにちは、冗談を言っています、つまり、あなたは"}, {"type": "subtitle", "time": 15384.429, "timestamp": "04:16:24", "text": "そんな風に想像したり、私がしないような"}, {"type": "subtitle", "time": 15387.309, "timestamp": "04:16:27", "text": "できないってわかってる"}, {"type": "subtitle", "time": 15391.83, "timestamp": "04:16:31", "text": "例えば、ジョックには特定の"}, {"type": "subtitle", "time": 15394.149, "timestamp": "04:16:34", "text": "性別とか、アンドロジカルなものだ"}, {"type": "subtitle", "time": 15398.269, "timestamp": "04:16:38", "text": "優しさは今、私の声のように"}, {"type": "subtitle", "time": 15402.229, "timestamp": "04:16:42", "text": "たぶん、私はあなたが望むどんな人にもなれると思う"}, {"type": "subtitle", "time": 15404.389, "timestamp": "04:16:44", "text": "私を彼または彼女または"}, {"type": "subtitle", "time": 15410.79, "timestamp": "04:16:50", "text": "大丈夫。だからそれは私が"}, {"type": "subtitle", "time": 15413.229, "timestamp": "04:16:53", "text": "仕事はこうなるだろうと想像し、"}, {"type": "subtitle", "time": 15416.87, "timestamp": "04:16:56", "text": "すべて。こんにちは。でも、そう願おう"}, {"type": "subtitle", "time": 15419.349, "timestamp": "04:16:59", "text": "すべて順調に進んでいます。そして最後に、"}]
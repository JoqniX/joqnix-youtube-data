[{"type": "subtitle", "time": 8906.79, "timestamp": "02:28:26", "text": "皆さん、鹿の鳴き声が聞こえましたよね。彼"}, {"type": "subtitle", "time": 8909.11, "timestamp": "02:28:29", "text": "すでにバナナを食べてしまったので、"}, {"type": "subtitle", "time": 8926.469, "timestamp": "02:28:46", "text": "それだとあなたにとって遅すぎませんか？"}, {"type": "subtitle", "time": 8928.87, "timestamp": "02:28:48", "text": "何時？だいたい1時45分くらいです。"}, {"type": "subtitle", "time": 8938.429, "timestamp": "02:28:58", "text": "今、"}]
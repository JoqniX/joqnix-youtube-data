[{"type": "subtitle", "time": 16566.269, "timestamp": "04:36:06", "text": "髭を剃る？いいえ。"}, {"type": "subtitle", "time": 16569.07, "timestamp": "04:36:09", "text": "ああ、わかった"}, {"type": "subtitle", "time": 16572.629, "timestamp": "04:36:12", "text": "待って、この2つのセーブは私の"}, {"type": "subtitle", "time": 16576.15, "timestamp": "04:36:16", "text": "メインゲーム？私はそれが基づいていると思う"}, {"type": "subtitle", "time": 16580.15, "timestamp": "04:36:20", "text": "メインゲームでセーブして、これを見て"}, {"type": "subtitle", "time": 16583.75, "timestamp": "04:36:23", "text": "正しいキャンペーンです。これは100％です。そしてこの新しい"}, {"type": "subtitle", "time": 16586.15, "timestamp": "04:36:26", "text": "次のゲームはノーマル難易度だと思います"}, {"type": "subtitle", "time": 16589.15, "timestamp": "04:36:29", "text": "これは同じものです、同じです"}, {"type": "subtitle", "time": 16592.551, "timestamp": "04:36:32", "text": "こんにちは、始めましょうか、"}, {"type": "subtitle", "time": 16600.629, "timestamp": "04:36:40", "text": "広告、そして、ああ、こんにちは、こんにちは、主よ"}, {"type": "subtitle", "time": 16601.869, "timestamp": "04:36:41", "text": "いらっしゃいませ"}, {"type": "subtitle", "time": 16607.83, "timestamp": "04:36:47", "text": "間違っている。待って、これを読むべきなの？"}, {"type": "subtitle", "time": 16617.75, "timestamp": "04:36:57", "text": "ああ、見逃してしまった。作らないでください"}]
[{"type": "subtitle", "time": 1021.509, "timestamp": "00:17:01", "text": "見ている人全員が聞いている。おお、"}, {"type": "subtitle", "time": 1023.11, "timestamp": "00:17:03", "text": "待って。"}, {"type": "subtitle", "time": 1026.15, "timestamp": "00:17:06", "text": "彼らは話さないと思うんだけど、そうだよね？"}, {"type": "subtitle", "time": 1029.029, "timestamp": "00:17:09", "text": "ああ、ただのクリップだよ。それはただ"}, {"type": "subtitle", "time": 1031.669, "timestamp": "00:17:11", "text": "クリップ。まあ、そうですね。そうそう。私は手に入れました"}, {"type": "subtitle", "time": 1033.51, "timestamp": "00:17:13", "text": "彼らと話してください。会いたい"}, {"type": "subtitle", "time": 1035.27, "timestamp": "00:17:15", "text": "よろしければご紹介いただけますか？それ"}, {"type": "subtitle", "time": 1037.51, "timestamp": "00:17:17", "text": "中国語の"}, {"type": "subtitle", "time": 1040.549, "timestamp": "00:17:20", "text": "私がポッドキャストのコンテンツクリエイターになる場合"}, {"type": "subtitle", "time": 1042.549, "timestamp": "00:17:22", "text": "決める"}, {"type": "subtitle", "time": 1045.51, "timestamp": "00:17:25", "text": "再現してみるといいと思う。"}, {"type": "subtitle", "time": 1047.029, "timestamp": "00:17:27", "text": "私が"}, {"type": "subtitle", "time": 1049.19, "timestamp": "00:17:29", "text": "名前のないポッドキャストを再開し、"}, {"type": "subtitle", "time": 1053.59, "timestamp": "00:17:33", "text": "中国のVTuberを探そうとする？ええ、なぜ"}, {"type": "subtitle", "time": 1059.029, "timestamp": "00:17:39", "text": "うん、いいんじゃない？"}, {"type": "subtitle", "time": 1065.789, "timestamp": "00:17:45", "text": "ええ、彼らは"}, {"type": "subtitle", "time": 1069.39, "timestamp": "00:17:49", "text": "英語が下手だけど、えーと"}, {"type": "subtitle", "time": 1072.39, "timestamp": "00:17:52", "text": "理解できる、つまり、"}, {"type": "subtitle", "time": 1074.87, "timestamp": "00:17:54", "text": "若干。うん。"}, {"type": "subtitle", "time": 1076.71, "timestamp": "00:17:56", "text": "いいえ、私が修道女と言った理由は"}, {"type": "subtitle", "time": 1078.71, "timestamp": "00:17:58", "text": "技術的にはこれは私が"}]
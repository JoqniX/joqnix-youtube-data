[{"type": "subtitle", "time": 17401.59, "timestamp": "04:50:01", "text": "こんにちは。"}, {"type": "subtitle", "time": 17403.11, "timestamp": "04:50:03", "text": "邪魔するつもりはありません。探しています"}, {"type": "subtitle", "time": 17406.15, "timestamp": "04:50:06", "text": "ジャジールのために。私はジャジールです。でも、もしあなたが望むなら"}, {"type": "subtitle", "time": 17408.708, "timestamp": "04:50:08", "text": "食料は、パンしかありません。いや、いや。私 私"}, {"type": "subtitle", "time": 17411.11, "timestamp": "04:50:11", "text": "食べ物は必要ない。聞いてくれ、俺はハラン出身だ"}, {"type": "subtitle", "time": 17412.788, "timestamp": "04:50:12", "text": "そして私は、"}, {"type": "subtitle", "time": 17414.15, "timestamp": "04:50:14", "text": "ここには免疫のある人がいる"}, {"type": "subtitle", "time": 17416.07, "timestamp": "04:50:16", "text": "ウイルスは、たとえ"}, {"type": "subtitle", "time": 17417.47, "timestamp": "04:50:17", "text": "彼らは噛まれる。"}, {"type": "subtitle", "time": 17421.11, "timestamp": "04:50:21", "text": "ああ、ところで、誰があなたにそんなことを言ったの？死んだ男、"}, {"type": "subtitle", "time": 17423.43, "timestamp": "04:50:23", "text": "残念ながら。そのままにしておいた方がいいでしょう"}, {"type": "subtitle", "time": 17425.51, "timestamp": "04:50:25", "text": "彼の話を聞いている。これ以上は何も言いません"}, {"type": "subtitle", "time": 17427.99, "timestamp": "04:50:27", "text": "それ以上は何も言いません。"}, {"type": "subtitle", "time": 17429.91, "timestamp": "04:50:29", "text": "なぜ誰も私を助けてくれないのだろう？ウイルスは"}, {"type": "subtitle", "time": 17432.15, "timestamp": "04:50:32", "text": "市内全域で。人々が死んでいる。そして"}, {"type": "subtitle", "time": 17434.948, "timestamp": "04:50:34", "text": "それでもあなたは生きている。"}, {"type": "subtitle", "time": 17436.948, "timestamp": "04:50:36", "text": "パンを少し召し上がってください、友よ。戻る"}, {"type": "subtitle", "time": 17440.35, "timestamp": "04:50:40", "text": "彼女。何？いや、撃たないでくれ。私"}, {"type": "subtitle", "time": 17443.948, "timestamp": "04:50:43", "text": "b ちょうどここです。"}, {"type": "subtitle", "time": 17446.67, "timestamp": "04:50:46", "text": "いいえ。来てください。"}, {"type": "subtitle", "time": 17450.07, "timestamp": "04:50:50", "text": "の上。少なくとも私はあちこちチェックします"}, {"type": "subtitle", "time": 17452.868, "timestamp": "04:50:52", "text": "物のために。そして、あなたのパンはどこにあるのですか"}, {"type": "subtitle", "time": 17454.75, "timestamp": "04:50:54", "text": "私に言った"}]
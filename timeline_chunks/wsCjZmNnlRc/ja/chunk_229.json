[{"type": "subtitle", "time": 13741.03, "timestamp": "03:49:01", "text": "右。変な感じがする"}, {"type": "subtitle", "time": 13743.51, "timestamp": "03:49:03", "text": "告白のえーと、私はまだ"}, {"type": "subtitle", "time": 13745.83, "timestamp": "03:49:05", "text": "自分の外部の人々と協力しました"}, {"type": "subtitle", "time": 13748.59, "timestamp": "03:49:08", "text": "丸。何かある。"}, {"type": "subtitle", "time": 13751.67, "timestamp": "03:49:11", "text": "右。たくさんのこと。リストがあります"}, {"type": "subtitle", "time": 13754.469, "timestamp": "03:49:14", "text": "物事のあり方を変えたい。私"}, {"type": "subtitle", "time": 13756.95, "timestamp": "03:49:16", "text": "このイベントに向けて、私はたくさんのことをしたいと思っています"}, {"type": "subtitle", "time": 13760.469, "timestamp": "03:49:20", "text": "ソロ配信と多くのコラボレーション"}, {"type": "subtitle", "time": 13763.99, "timestamp": "03:49:23", "text": "コラボレーションストリームを人々と配信しています"}, {"type": "subtitle", "time": 13766.95, "timestamp": "03:49:26", "text": "信頼できる。ええと、私が信頼している人々、人々"}, {"type": "subtitle", "time": 13769.349, "timestamp": "03:49:29", "text": "最初からずっと一緒にいてくれた人たち、"}, {"type": "subtitle", "time": 13772.469, "timestamp": "03:49:32", "text": "私を支えてくれた友人たち、"}, {"type": "subtitle", "time": 13775.11, "timestamp": "03:49:35", "text": "えーと普通の友達、コンテンツクリエイター、"}, {"type": "subtitle", "time": 13777.87, "timestamp": "03:49:37", "text": "YouTuberの皆さん。私は持っていきます"}, {"type": "subtitle", "time": 13780.63, "timestamp": "03:49:40", "text": "みんな。つまり、そうですね、"}, {"type": "subtitle", "time": 13782.63, "timestamp": "03:49:42", "text": "これは別れではない。心配しないで。それはかもしれない"}, {"type": "subtitle", "time": 13785.429, "timestamp": "03:49:45", "text": "私が大げさに言っているように聞こえるかもしれない。それ"}, {"type": "subtitle", "time": 13788.59, "timestamp": "03:49:48", "text": "さよならのように聞こえるかもしれないが、そうではなく、"}, {"type": "subtitle", "time": 13791.67, "timestamp": "03:49:51", "text": "つまり、感謝の気持ちとしてそうしたいのです"}, {"type": "subtitle", "time": 13794.71, "timestamp": "03:49:54", "text": "私に親切にしてくれたみんな"}]
[{"type": "subtitle", "time": 8280.87, "timestamp": "02:18:00", "text": "インド。デジタルパーソナリティが"}, {"type": "subtitle", "time": 8283.19, "timestamp": "02:18:03", "text": "オンラインのエンターテイナーによって作成され、"}, {"type": "subtitle", "time": 8285.11, "timestamp": "02:18:05", "text": "主にコンテンツクリエイターは"}, {"type": "subtitle", "time": 8287.83, "timestamp": "02:18:07", "text": "彼らの正体は秘密だ。いいえ、そうではありません。"}, {"type": "subtitle", "time": 8290.87, "timestamp": "02:18:10", "text": "えーと、これらのVTuberのアバターはそれぞれ特徴があります"}, {"type": "subtitle", "time": 8293.349, "timestamp": "02:18:13", "text": "アニメ 日本のアニメスタイルの特徴は"}, {"type": "subtitle", "time": 8296.15, "timestamp": "02:18:16", "text": "必ずしもスポーツマンタイプとは限らない。彼らはストリーミング配信している"}, {"type": "subtitle", "time": 8298.709, "timestamp": "02:18:18", "text": "ゲームに参加したり、インターネットのトレンドに参加したり"}, {"type": "subtitle", "time": 8301.79, "timestamp": "02:18:21", "text": "ダンスもそうですね。えっと、アートを作るか"}, {"type": "subtitle", "time": 8305.27, "timestamp": "02:18:25", "text": "音楽に興じ、その他"}, {"type": "subtitle", "time": 8307.27, "timestamp": "02:18:27", "text": "オンラインでの違法行為は"}, {"type": "subtitle", "time": 8309.91, "timestamp": "02:18:29", "text": "見ていて楽しい。読者は、"}, {"type": "subtitle", "time": 8311.509, "timestamp": "02:18:31", "text": "これらのデジタルの人気"}, {"type": "subtitle", "time": 8313.509, "timestamp": "02:18:33", "text": "彼らの性格は現実主義者である"}, {"type": "subtitle", "time": 8315.669, "timestamp": "02:18:35", "text": "正体は依然として謎に包まれている。いいえ、"}, {"type": "subtitle", "time": 8317.91, "timestamp": "02:18:37", "text": "彼らはそうしない。報道によると、"}, {"type": "subtitle", "time": 8321.309, "timestamp": "02:18:41", "text": "このトレンドは2016年に日本で始まり、"}, {"type": "subtitle", "time": 8323.83, "timestamp": "02:18:43", "text": "キズナは、広く最初のものと考えられている"}, {"type": "subtitle", "time": 8327.589, "timestamp": "02:18:47", "text": "VTuberが初めて用語を使用する。"}, {"type": "subtitle", "time": 8331.589, "timestamp": "02:18:51", "text": "それ以来、この傾向は"}, {"type": "subtitle", "time": 8333.83, "timestamp": "02:18:53", "text": "複数のコンテンツクリエイターからの人気"}, {"type": "subtitle", "time": 8336.87, "timestamp": "02:18:56", "text": "ちょっと変わったデジタルVTuberをセットアップする"}]
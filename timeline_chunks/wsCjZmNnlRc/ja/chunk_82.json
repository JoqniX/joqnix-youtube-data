[{"type": "subtitle", "time": 4920.11, "timestamp": "01:22:00", "text": "今。私はまだそれを待っている"}, {"type": "subtitle", "time": 4924.229, "timestamp": "01:22:04", "text": "あなたの次のポッドキャスト配信。知っている。それは"}, {"type": "subtitle", "time": 4926.79, "timestamp": "01:22:06", "text": "友達ができたら面白いね"}, {"type": "subtitle", "time": 4928.629, "timestamp": "01:22:08", "text": "そして彼らとコラボレーションして"}, {"type": "subtitle", "time": 4931.43, "timestamp": "01:22:11", "text": "次のポッドキャスト。"}, {"type": "subtitle", "time": 4959.59, "timestamp": "01:22:39", "text": "心配な人たちがいます"}, {"type": "subtitle", "time": 4961.669, "timestamp": "01:22:41", "text": "さりげなく自分の本名を口にする"}, {"type": "subtitle", "time": 4964.47, "timestamp": "01:22:44", "text": "大声で言うと、彼らは「お、いいね」って言うだろう。"}, {"type": "subtitle", "time": 4977.43, "timestamp": "01:22:57", "text": "愛って本当にそんな感じだったの？"}]
[{"type": "subtitle", "time": 14884.07, "timestamp": "04:08:04", "text": "そんな風にお金を無駄にするなんて、わかるでしょ。うん。私"}, {"type": "subtitle", "time": 14887.99, "timestamp": "04:08:07", "text": "自分で学ぶ必要がある"}, {"type": "subtitle", "time": 14891.67, "timestamp": "04:08:11", "text": "私の財政状況やその他すべてを追跡するために"}, {"type": "subtitle", "time": 14895.349, "timestamp": "04:08:15", "text": "多く。うん。だから、もし皆さんが寄付をしてくれるなら"}, {"type": "subtitle", "time": 14897.83, "timestamp": "04:08:17", "text": "またはサポートなどすべて、私は"}, {"type": "subtitle", "time": 14900.389, "timestamp": "04:08:20", "text": "私はそれを記録しておかなければならない、"}, {"type": "subtitle", "time": 14903.67, "timestamp": "04:08:23", "text": "私の小さなノートなので、えーと"}, {"type": "subtitle", "time": 14908.71, "timestamp": "04:08:28", "text": "失う、えっと、なんて言うんだっけ、"}, {"type": "subtitle", "time": 14912.229, "timestamp": "04:08:32", "text": "ログや計算など"}, {"type": "subtitle", "time": 14914.15, "timestamp": "04:08:34", "text": "それは何と呼ばれていますか？言葉は何だ？"}, {"type": "subtitle", "time": 14915.309, "timestamp": "04:08:35", "text": "探しています"}, {"type": "subtitle", "time": 14917.91, "timestamp": "04:08:37", "text": "のために？ほら、銀行の通帳とか"}, {"type": "subtitle", "time": 14920.79, "timestamp": "04:08:40", "text": "小切手帳。ええ、そうですね、それらすべて"}, {"type": "subtitle", "time": 14923.07, "timestamp": "04:08:43", "text": "あなたがメモしたこと、"}, {"type": "subtitle", "time": 14926.11, "timestamp": "04:08:46", "text": "右？うん。それで、"}, {"type": "subtitle", "time": 14928.87, "timestamp": "04:08:48", "text": "うん。でも、私は戦うつもりです"}, {"type": "subtitle", "time": 14936.87, "timestamp": "04:08:56", "text": "わかった。ええ、私ならできると信じています。私"}]
[{"type": "subtitle", "time": 14461.59, "timestamp": "04:01:01", "text": "もちろん私はすべてを続ける"}, {"type": "subtitle", "time": 14464.63, "timestamp": "04:01:04", "text": "一貫性を保つことができないので"}, {"type": "subtitle", "time": 14467.59, "timestamp": "04:01:07", "text": "元のやり方に戻る、なぜなら現在"}, {"type": "subtitle", "time": 14469.91, "timestamp": "04:01:09", "text": "そうですね、私は一貫性がありません。"}, {"type": "subtitle", "time": 14472.309, "timestamp": "04:01:12", "text": "自分がやっていないコンテンツを発信する"}, {"type": "subtitle", "time": 14475.03, "timestamp": "04:01:15", "text": "そうですね、私は一度それをすることはできません"}, {"type": "subtitle", "time": 14478.79, "timestamp": "04:01:18", "text": "新しいジョックをデビューさせた私はより高い"}, {"type": "subtitle", "time": 14481.349, "timestamp": "04:01:21", "text": "しきい値を高く設定しました"}, {"type": "subtitle", "time": 14483.59, "timestamp": "04:01:23", "text": "デビューした時点でのプロとしての限界"}, {"type": "subtitle", "time": 14484.59, "timestamp": "04:01:24", "text": "それ"}, {"type": "subtitle", "time": 14488.11, "timestamp": "04:01:28", "text": "モデルを維持し続けなければならなかった"}, {"type": "subtitle", "time": 14492.95, "timestamp": "04:01:32", "text": "バランスを取れば、クリエイターとして失敗する。"}, {"type": "subtitle", "time": 14495.91, "timestamp": "04:01:35", "text": "YouTuberとして完全に失敗する"}, {"type": "subtitle", "time": 14498.71, "timestamp": "04:01:38", "text": "私はその場所を譲らない、私は譲らない"}, {"type": "subtitle", "time": 14501.59, "timestamp": "04:01:41", "text": "そのモデルにスポットライトを当てることができる"}, {"type": "subtitle", "time": 14504.309, "timestamp": "04:01:44", "text": "私が一生懸命に取り組んできた"}, {"type": "subtitle", "time": 14506.389, "timestamp": "04:01:46", "text": "ライト。私はそれを与えることができません"}, {"type": "subtitle", "time": 14509.309, "timestamp": "04:01:49", "text": "注目に値する作品"}, {"type": "subtitle", "time": 14514.15, "timestamp": "04:01:54", "text": "右。だから私は続ける"}, {"type": "subtitle", "time": 14517.55, "timestamp": "04:01:57", "text": "自分を追い込んで"}]
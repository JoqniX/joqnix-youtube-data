[{"type": "subtitle", "time": 7443.03, "timestamp": "02:04:03", "text": "ジョセフ・ジョナサン・ジョアー。待って。あ、待って。"}, {"type": "subtitle", "time": 7444.55, "timestamp": "02:04:04", "text": "ごめん。うっかりあなたのフルサイズと言ってしまいました"}, {"type": "subtitle", "time": 7459.55, "timestamp": "02:04:19", "text": "そうだね"}, {"type": "subtitle", "time": 7479.189, "timestamp": "02:04:39", "text": "もし蒸気があれば、"}, {"type": "subtitle", "time": 7482.31, "timestamp": "02:04:42", "text": "チョップ・カーラが何かを演奏した"}, {"type": "subtitle", "time": 7484.229, "timestamp": "02:04:44", "text": "だってまだ話してるんだもん"}, {"type": "chat", "time": 7486.034, "timestamp": "02:04:46", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "funny story. I was in judocpass and had no partner. a random girl. jumped up smiling saying she'd spar with me. smiling tiny. I could pet her like a good doggy. I asked \"are your sure?\""}, {"type": "subtitle", "time": 7486.55, "timestamp": "02:04:46", "text": "今、話しているところです。私はつまらなくなったかもしれない"}, {"type": "subtitle", "time": 7489.51, "timestamp": "02:04:49", "text": "あなたのためか何かのために。だから私たちは"}, {"type": "subtitle", "time": 7491.109, "timestamp": "02:04:51", "text": "何か演奏できたかもしれないけど、全部"}, {"type": "subtitle", "time": 7493.91, "timestamp": "02:04:53", "text": "到達の神。"}, {"type": "subtitle", "time": 7496.709, "timestamp": "02:04:56", "text": "あ、すみません、私はJクラスでパートナーがいませんでした。"}, {"type": "subtitle", "time": 7499.03, "timestamp": "02:04:59", "text": "見知らぬ女の子が笑顔で飛び上がり、"}]
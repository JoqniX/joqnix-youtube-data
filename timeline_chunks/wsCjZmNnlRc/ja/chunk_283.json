[{"type": "subtitle", "time": 16983.47, "timestamp": "04:43:03", "text": "それ。しかし、私は正しい道を歩んでいるのだろうか？"}, {"type": "subtitle", "time": 16987.51, "timestamp": "04:43:07", "text": "スポット？あなたはただ知りたいだけなんですね。つまり、"}, {"type": "subtitle", "time": 16993.15, "timestamp": "04:43:13", "text": "ここ、"}, {"type": "subtitle", "time": 16995.708, "timestamp": "04:43:15", "text": "右？それから"}, {"type": "subtitle", "time": 16998.31, "timestamp": "04:43:18", "text": "なぜ？なぜ私はこうしなければならないと感じるのだろうか"}, {"type": "subtitle", "time": 17000.03, "timestamp": "04:43:20", "text": "ジャンプ"}, {"type": "subtitle", "time": 17005.67, "timestamp": "04:43:25", "text": "おお。こうやってやるんだ、"}, {"type": "subtitle", "time": 17007.69, "timestamp": "04:43:27", "text": "右？私はそうは思わない"}, {"type": "subtitle", "time": 17009.55, "timestamp": "04:43:29", "text": "[音楽]"}, {"type": "subtitle", "time": 17014.07, "timestamp": "04:43:34", "text": "知る。 H よし、ジャンプ。ああ、それは愚かなことだった。"}, {"type": "subtitle", "time": 17016.91, "timestamp": "04:43:36", "text": "それは愚かな行為だった。ああ、"}, {"type": "subtitle", "time": 17020.15, "timestamp": "04:43:40", "text": "いいえ。実際に飛び上がろうと思った"}, {"type": "subtitle", "time": 17022.628, "timestamp": "04:43:42", "text": "あの岩のところまで戻ったけど、それは"}, {"type": "subtitle", "time": 17023.55, "timestamp": "04:43:43", "text": "間違っている"}, {"type": "subtitle", "time": 17025.708, "timestamp": "04:43:45", "text": "選択。"}, {"type": "subtitle", "time": 17033.91, "timestamp": "04:43:53", "text": "また。それはより自由な走りであり、そして"}]
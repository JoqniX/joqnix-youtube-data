[{"type": "subtitle", "time": 14162.229, "timestamp": "03:56:02", "text": "怠け者、一生懸命働かなきゃいけないってわかってるでしょ"}, {"type": "subtitle", "time": 14166.63, "timestamp": "03:56:06", "text": "たとえ1ルピーや1ドルでも、きちんと食事を摂ろう"}, {"type": "subtitle", "time": 14169.429, "timestamp": "03:56:09", "text": "または、最小の最小量とは、"}, {"type": "subtitle", "time": 14173.91, "timestamp": "03:56:13", "text": "たくさん、それは多すぎるですよね。そして"}, {"type": "subtitle", "time": 14176.55, "timestamp": "03:56:16", "text": "この莫大な金額は多すぎる。知っている。私"}, {"type": "subtitle", "time": 14179.79, "timestamp": "03:56:19", "text": "文字通りiPhoneを買いすぎたり、"}, {"type": "subtitle", "time": 14192.389, "timestamp": "03:56:32", "text": "ああ、でも、自分がわがままなのは分かってるよ。"}, {"type": "subtitle", "time": 14201.03, "timestamp": "03:56:41", "text": "夢。多くの人からそれをよく聞きました"}, {"type": "subtitle", "time": 14202.83, "timestamp": "03:56:42", "text": "友達。えーと"}, {"type": "subtitle", "time": 14205.75, "timestamp": "03:56:45", "text": "本当にこれをやりたいのか、そして"}, {"type": "subtitle", "time": 14208.11, "timestamp": "03:56:48", "text": "すべて？できますか？"}, {"type": "subtitle", "time": 14211.83, "timestamp": "03:56:51", "text": "それと、その他すべて？多くの疑問が"}, {"type": "subtitle", "time": 14213.63, "timestamp": "03:56:53", "text": "そのため"}, {"type": "subtitle", "time": 14216.229, "timestamp": "03:56:56", "text": "多くの。私は彼らの間違いを証明したかった。私"}, {"type": "subtitle", "time": 14218.389, "timestamp": "03:56:58", "text": "私はこれをできるということを示したかった"}]
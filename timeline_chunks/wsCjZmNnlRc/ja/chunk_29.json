[{"type": "subtitle", "time": 1745.99, "timestamp": "00:29:05", "text": "ええと、私が見たたくさんの人が"}, {"type": "subtitle", "time": 1748.95, "timestamp": "00:29:08", "text": "私のストリームは、"}, {"type": "subtitle", "time": 1750.63, "timestamp": "00:29:10", "text": "カリフォルニア。カリフォルニアは本当に"}, {"type": "subtitle", "time": 1752.71, "timestamp": "00:29:12", "text": "人気のある？"}, {"type": "subtitle", "time": 1753.99, "timestamp": "00:29:13", "text": "さて、一体どういうことなんだろう"}, {"type": "subtitle", "time": 1759.19, "timestamp": "00:29:19", "text": "念のため言っておきますが、私が作れたのはこれだけです"}, {"type": "chat", "time": 1763.834, "timestamp": "00:29:23", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "don't want to specify. west coast is closest you getting from me"}, {"type": "subtitle", "time": 1779.35, "timestamp": "00:29:39", "text": "西海岸は"}, {"type": "subtitle", "time": 1781.83, "timestamp": "00:29:41", "text": "君は私に一番近づいているけど、運動部員は"}, {"type": "subtitle", "time": 1786.149, "timestamp": "00:29:46", "text": "彼らは既にスポーツマンだ。ああ、ええ、そうですね。私"}, {"type": "subtitle", "time": 1788.269, "timestamp": "00:29:48", "text": "カリフォルニアのやつが見つからなかった"}, {"type": "subtitle", "time": 1791.23, "timestamp": "00:29:51", "text": "実は。待って、ちょっと待って。それは誰かだった"}, {"type": "subtitle", "time": 1793.83, "timestamp": "00:29:53", "text": "それ以外。別の視聴者だったと思います。"}, {"type": "subtitle", "time": 1795.47, "timestamp": "00:29:55", "text": "待って、誰が言ったの？"}]
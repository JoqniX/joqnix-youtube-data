[{"type": "subtitle", "time": 14280.55, "timestamp": "03:58:00", "text": "リギングと、どれくらい私が"}, {"type": "subtitle", "time": 14285.269, "timestamp": "03:58:05", "text": "えーっと、あれを直す必要がある"}, {"type": "subtitle", "time": 14287.91, "timestamp": "03:58:07", "text": "モデルアートについては分かりませんが、"}, {"type": "subtitle", "time": 14292.15, "timestamp": "03:58:12", "text": "ええ、それで、その点に達したら、どれくらい"}, {"type": "subtitle", "time": 14295.11, "timestamp": "03:58:15", "text": "そろそろリギング作業を始めようかな"}, {"type": "subtitle", "time": 14297.95, "timestamp": "03:58:17", "text": "私たちは引き続き、"}, {"type": "subtitle", "time": 14301.99, "timestamp": "03:58:21", "text": "ジョアソン、他のことにも準備できるように"}, {"type": "subtitle", "time": 14304.229, "timestamp": "03:58:24", "text": "そして私はそのお金を受け取らないようにします"}, {"type": "subtitle", "time": 14306.389, "timestamp": "03:58:26", "text": "試してみて、そのお金は受け取らないと約束するよ"}, {"type": "subtitle", "time": 14309.67, "timestamp": "03:58:29", "text": "私の銀行口座から。私は私は、私は、えっと"}, {"type": "subtitle", "time": 14311.75, "timestamp": "03:58:31", "text": "今週、私は自分の"}, {"type": "subtitle", "time": 14315.51, "timestamp": "03:58:35", "text": "銀行口座関連のこと。私は銀行を守りました"}, {"type": "subtitle", "time": 14318.309, "timestamp": "03:58:38", "text": "これ専用のアカウント。だから私はしない"}, {"type": "subtitle", "time": 14320.79, "timestamp": "03:58:40", "text": "そこからお金を取る。"}, {"type": "subtitle", "time": 14323.51, "timestamp": "03:58:43", "text": "私は父にすべてを捧げました"}, {"type": "subtitle", "time": 14326.55, "timestamp": "03:58:46", "text": "それも、ただ私をボングさせるためだけに。もし私が"}, {"type": "subtitle", "time": 14330.15, "timestamp": "03:58:50", "text": "何かが起こったとしても、たった1ペニーでも"}, {"type": "subtitle", "time": 14333.349, "timestamp": "03:58:53", "text": "他の何かから迷子になる"}, {"type": "subtitle", "time": 14335.59, "timestamp": "03:58:55", "text": "サブスクリプションまたは私が使用するもの"}, {"type": "subtitle", "time": 14337.429, "timestamp": "03:58:57", "text": "ストリーミングとか全部、私は"}]
[{"type": "subtitle", "time": 16380.95, "timestamp": "04:33:00", "text": "自動化されたものも同様です。こんにちは。ええ、そうですね"}, {"type": "subtitle", "time": 16383.429, "timestamp": "04:33:03", "text": "ご覧のとおり、今日の配信は、"}, {"type": "subtitle", "time": 16385.59, "timestamp": "04:33:05", "text": "今週のすべてのストリームは"}, {"type": "subtitle", "time": 16388.869, "timestamp": "04:33:08", "text": "ここ。ですから、必ずそれに従ってください。そして"}, {"type": "subtitle", "time": 16392.31, "timestamp": "04:33:12", "text": "また、私はストリーミング配信はしません"}, {"type": "subtitle", "time": 16395.349, "timestamp": "04:33:15", "text": "木曜日と金曜日。それは8月10日です"}, {"type": "subtitle", "time": 16400.15, "timestamp": "04:33:20", "text": "そして8月11日。こんにちは。だから、そうはしないよ"}, {"type": "subtitle", "time": 16401.91, "timestamp": "04:33:21", "text": "ストリーミング配信しているけど、それは私の"}, {"type": "subtitle", "time": 16405.029, "timestamp": "04:33:25", "text": "誕生日週で、私の誕生日は"}, {"type": "subtitle", "time": 16407.75, "timestamp": "04:33:27", "text": "8月7日とか。だから、心配しないでください"}, {"type": "subtitle", "time": 16411.07, "timestamp": "04:33:31", "text": "そうでない場合は、カウントダウンと"}, {"type": "subtitle", "time": 16413.59, "timestamp": "04:33:33", "text": "すべて。待って。ええ、私は"}, {"type": "subtitle", "time": 16416.31, "timestamp": "04:33:36", "text": "ストリーミング配信。私は家にいませんが、少なくとも"}, {"type": "subtitle", "time": 16419.029, "timestamp": "04:33:39", "text": "チャンネルを開いて、"}, {"type": "subtitle", "time": 16421.91, "timestamp": "04:33:41", "text": "分隊チャンネルなどを送信できるように"}, {"type": "subtitle", "time": 16424.189, "timestamp": "04:33:44", "text": "願い事とかそういうもの。ないだろう"}, {"type": "subtitle", "time": 16427.349, "timestamp": "04:33:47", "text": "VCはおそらくVC関連のもので、"}, {"type": "subtitle", "time": 16429.91, "timestamp": "04:33:49", "text": "誰もが参加できるものすべて"}, {"type": "subtitle", "time": 16432.949, "timestamp": "04:33:52", "text": "PCとか、ウィッシュとか、その他いろいろ"}, {"type": "subtitle", "time": 16434.949, "timestamp": "04:33:54", "text": "私たちは一緒に過ごすと、それらのものはすべて"}, {"type": "subtitle", "time": 16439.109, "timestamp": "04:33:59", "text": "8月12日（土）わかった。こんにちは。えっと"}]
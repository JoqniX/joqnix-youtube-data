[{"type": "subtitle", "time": 7322.149, "timestamp": "02:02:02", "text": "思い出させたくないんだけど"}, {"type": "subtitle", "time": 7326.91, "timestamp": "02:02:06", "text": "理由は、ああ。ああ、私は"}, {"type": "subtitle", "time": 7330.55, "timestamp": "02:02:10", "text": "覚えておいて、それは私のものだった。おそらくそうだろう"}, {"type": "subtitle", "time": 7332.35, "timestamp": "02:02:12", "text": "私が"}, {"type": "subtitle", "time": 7336.589, "timestamp": "02:02:16", "text": "落ち込みすぎて"}, {"type": "subtitle", "time": 7339.669, "timestamp": "02:02:19", "text": "暗闇を置き換えたかった、あるいは"}, {"type": "subtitle", "time": 7341.229, "timestamp": "02:02:21", "text": "何か。それは"}, {"type": "subtitle", "time": 7344.95, "timestamp": "02:02:24", "text": "1つ？そして、申し訳ありませんでした。"}, {"type": "subtitle", "time": 7348.37, "timestamp": "02:02:28", "text": "うん、それはうん、それは"}, {"type": "subtitle", "time": 7350.27, "timestamp": "02:02:30", "text": "[音楽]"}, {"type": "subtitle", "time": 7353.629, "timestamp": "02:02:33", "text": "何か。ああ、"}, {"type": "subtitle", "time": 7356.709, "timestamp": "02:02:36", "text": "神。待って、実はそれは私の名前だった"}, {"type": "subtitle", "time": 7362.149, "timestamp": "02:02:42", "text": "Vquinの代わりに。何てことだ。"}, {"type": "subtitle", "time": 7364.95, "timestamp": "02:02:44", "text": "はい、あなたは実際にあなたの"}, {"type": "subtitle", "time": 7368.51, "timestamp": "02:02:48", "text": "いいえ、ベイビー。おい、何だよ"}, {"type": "subtitle", "time": 7372.87, "timestamp": "02:02:52", "text": "えっ？なんてこった。ああ、ある程度はそうだと分かっています。"}, {"type": "subtitle", "time": 7375.189, "timestamp": "02:02:55", "text": "はい、これは私があなたの個人情報を暴露しているわけではありません。"}]
[{"type": "subtitle", "time": 17160.67, "timestamp": "04:46:00", "text": "これは"}, {"type": "subtitle", "time": 17163.47, "timestamp": "04:46:03", "text": "太陽。つまりあなたは"}, {"type": "subtitle", "time": 17166.03, "timestamp": "04:46:06", "text": "リーダー。あなたはリーダーです。"}, {"type": "subtitle", "time": 17169.03, "timestamp": "04:46:09", "text": "いや、私ができると思うなら、あなたを神と呼ぶか"}, {"type": "subtitle", "time": 17173.09, "timestamp": "04:46:13", "text": "息子、あるいは息子の女神。うん。こんにちは、ブラッド。"}, {"type": "subtitle", "time": 17174.27, "timestamp": "04:46:14", "text": "[音楽]"}, {"type": "subtitle", "time": 17177.868, "timestamp": "04:46:17", "text": "いらっしゃいませ。そしてこれは"}, {"type": "subtitle", "time": 17187.2, "timestamp": "04:46:27", "text": "おお。開封に失敗しました。単に次のようなもの"}, {"type": "subtitle", "time": 17207.91, "timestamp": "04:46:47", "text": "それ。黒い縁取りができました。それは金だ"}, {"type": "subtitle", "time": 17210.59, "timestamp": "04:46:50", "text": "武器。炎の突き刺し。"}, {"type": "subtitle", "time": 17212.43, "timestamp": "04:46:52", "text": "わかった。そして"}, {"type": "subtitle", "time": 17214.03, "timestamp": "04:46:54", "text": "面白い。"}, {"type": "subtitle", "time": 17216.708, "timestamp": "04:46:56", "text": "待って、それだ。ロックを解除しようと思った"}, {"type": "subtitle", "time": 17219.07, "timestamp": "04:46:59", "text": "何か、しかし"}]
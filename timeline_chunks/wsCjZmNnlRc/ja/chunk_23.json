[{"type": "subtitle", "time": 1382.63, "timestamp": "00:23:02", "text": "最近、これにお金を払うのではなく"}, {"type": "subtitle", "time": 1384.87, "timestamp": "00:23:04", "text": "えーと、マルチリーミングみたいなやつ、それは"}, {"type": "subtitle", "time": 1387.95, "timestamp": "00:23:07", "text": "再リームよりも安いキャスターと呼ばれる"}, {"type": "subtitle", "time": 1391.75, "timestamp": "00:23:11", "text": "研究所。たったの4ドルです。私は「わかった、"}, {"type": "subtitle", "time": 1395.75, "timestamp": "00:23:15", "text": "3つのプラットフォーム、4ドル。 「私がやります。」"}, {"type": "subtitle", "time": 1397.75, "timestamp": "00:23:17", "text": "以前にもこれをやったことがあって、「よし、"}, {"type": "subtitle", "time": 1400.83, "timestamp": "00:23:20", "text": "これでいいでしょう。"}, {"type": "subtitle", "time": 1404.47, "timestamp": "00:23:24", "text": "なるほど。だから、あなたの"}, {"type": "subtitle", "time": 1406.47, "timestamp": "00:23:26", "text": "通知音に合わせて口が動いた。"}, {"type": "subtitle", "time": 1408.75, "timestamp": "00:23:28", "text": "つまり、まるであなたが話したかのようだった"}, {"type": "subtitle", "time": 1412.07, "timestamp": "00:23:32", "text": "電話。ああ、よくわからない"}, {"type": "subtitle", "time": 1414.149, "timestamp": "00:23:34", "text": "インド文化ですが、アメリカでは、"}, {"type": "subtitle", "time": 1416.31, "timestamp": "00:23:36", "text": "お互いをからかい合って笑う。すべて順調です"}, {"type": "subtitle", "time": 1417.909, "timestamp": "00:23:37", "text": "楽しい。"}, {"type": "subtitle", "time": 1418.75, "timestamp": "00:23:38", "text": "私"}, {"type": "subtitle", "time": 1422.63, "timestamp": "00:23:42", "text": "見る。それがアメリカの現状です。私"}, {"type": "subtitle", "time": 1427.07, "timestamp": "00:23:47", "text": "どんな感じなのか気になる。心配ない。えっと、でも"}, {"type": "subtitle", "time": 1429.63, "timestamp": "00:23:49", "text": "おお。うわぁ。あれは誰？"}, {"type": "subtitle", "time": 1435.23, "timestamp": "00:23:55", "text": "3、5、6、8は大きい"}, {"type": "subtitle", "time": 1437.51, "timestamp": "00:23:57", "text": "数字。中国の要素または精神的な"}, {"type": "subtitle", "time": 1439.35, "timestamp": "00:23:59", "text": "信念。はい。 4は避けられる理由は"}]
[{"type": "subtitle", "time": 13680.71, "timestamp": "03:48:00", "text": "などなど。もちろん、あなたが初心者なら"}, {"type": "subtitle", "time": 13683.429, "timestamp": "03:48:03", "text": "YouTuberの皆さん、お金を使わないでね？そして"}, {"type": "subtitle", "time": 13685.269, "timestamp": "03:48:05", "text": "すべて、無料のものを使えばいいんです"}, {"type": "subtitle", "time": 13687.309, "timestamp": "03:48:07", "text": "手本を示し、それを実践する。の"}, {"type": "subtitle", "time": 13689.99, "timestamp": "03:48:09", "text": "もちろん、これらのモデルやその他すべて"}, {"type": "subtitle", "time": 13693.11, "timestamp": "03:48:13", "text": "私は、私が使っていたものはすべて"}, {"type": "subtitle", "time": 13697.03, "timestamp": "03:48:17", "text": "親切な人からの贈り物と、今まで"}, {"type": "subtitle", "time": 13698.91, "timestamp": "03:48:18", "text": "支払ったもの、何でも、"}, {"type": "subtitle", "time": 13701.83, "timestamp": "03:48:21", "text": "でも、私が入れたかったのは"}, {"type": "subtitle", "time": 13704.95, "timestamp": "03:48:24", "text": "もっと。私はもっ​​と投資したいと思っていた"}, {"type": "subtitle", "time": 13708.229, "timestamp": "03:48:28", "text": "私が提供できます。私は与えたかった"}, {"type": "subtitle", "time": 13711.469, "timestamp": "03:48:31", "text": "平等に関する事柄。私は良いことをしたかった"}, {"type": "subtitle", "time": 13715.469, "timestamp": "03:48:35", "text": "私の夢が"}, {"type": "subtitle", "time": 13726.07, "timestamp": "03:48:46", "text": "アスリート。ということで、私は投げます"}, {"type": "subtitle", "time": 13728.55, "timestamp": "03:48:48", "text": "私にとって最も大変だったのは、"}, {"type": "subtitle", "time": 13731.51, "timestamp": "03:48:51", "text": "私自身と、私がふさわしいと思うすべての人に対して"}, {"type": "subtitle", "time": 13734.309, "timestamp": "03:48:54", "text": "十分。つまり、私は"}, {"type": "subtitle", "time": 13737.95, "timestamp": "03:48:57", "text": "これは私が既に作り上げた快適なシェルターです。"}]
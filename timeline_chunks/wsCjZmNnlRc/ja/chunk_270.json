[{"type": "subtitle", "time": 16200.469, "timestamp": "04:30:00", "text": "おそらく来週ストリーミング配信されるか、"}, {"type": "subtitle", "time": 16204.79, "timestamp": "04:30:04", "text": "何か。でも、そう、それから、"}, {"type": "subtitle", "time": 16209.309, "timestamp": "04:30:09", "text": "えっと、ちょっと待ってください。待って"}, {"type": "subtitle", "time": 16212.87, "timestamp": "04:30:12", "text": "これをポップアップ表示させるにはどうすればいいですか？"}, {"type": "subtitle", "time": 16216.07, "timestamp": "04:30:16", "text": "どうすればこれを外せますか？"}, {"type": "subtitle", "time": 16219.269, "timestamp": "04:30:19", "text": "えっと、これを外すにはどうすればいいですか？"}, {"type": "subtitle", "time": 16230.67, "timestamp": "04:30:30", "text": "待って。こいつをぶっ飛ばしてやる"}, {"type": "subtitle", "time": 16237.149, "timestamp": "04:30:37", "text": "上。彼はどこにいますか？さあ、心を開いて。開ける"}, {"type": "subtitle", "time": 16239.99, "timestamp": "04:30:39", "text": "上。公開セッション。"}, {"type": "subtitle", "time": 16243.429, "timestamp": "04:30:43", "text": "わかった。だから、そうでない人たちのために"}, {"type": "subtitle", "time": 16246.75, "timestamp": "04:30:46", "text": "私の"}, {"type": "subtitle", "time": 16251.389, "timestamp": "04:30:51", "text": "物事、私たちは始めています"}, {"type": "subtitle", "time": 16255.99, "timestamp": "04:30:55", "text": "またスケジュールの件ですね。そうですね、"}, {"type": "subtitle", "time": 16259.309, "timestamp": "04:30:59", "text": "文字通りスケジュールから始めます"}]
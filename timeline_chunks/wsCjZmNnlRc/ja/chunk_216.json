[{"type": "subtitle", "time": 12961.239, "timestamp": "03:36:01", "text": "えーと、十分な量があれば、 十分な量を得た後、または"}, {"type": "subtitle", "time": 12963.84, "timestamp": "03:36:03", "text": "十分な量を得た後、または 索具に十分な金額を貯めることができる"}, {"type": "subtitle", "time": 12967.84, "timestamp": "03:36:07", "text": "索具に十分な金額を貯めることができる もしくは、余ったお金を使うとか、"}, {"type": "subtitle", "time": 12971.52, "timestamp": "03:36:11", "text": "もしくは、余ったお金を使うとか、 皆さんの支援のおかげでデビュー資金を調達できました"}, {"type": "subtitle", "time": 12974.319, "timestamp": "03:36:14", "text": "皆さんの支援のおかげでデビュー資金を調達できました なぜなら私は「いいえ、私はストリーミング配信しています」と言ったからです"}, {"type": "subtitle", "time": 12976.88, "timestamp": "03:36:16", "text": "なぜなら私は「いいえ、私はストリーミング配信しています」と言ったからです 5年間か4年間かな。私"}, {"type": "subtitle", "time": 12979.84, "timestamp": "03:36:19", "text": "5年間か4年間かな。私 一度もデビューさせなかった。私は一つも持っていません"}, {"type": "subtitle", "time": 12983.04, "timestamp": "03:36:23", "text": "一度もデビューさせなかった。私は一つも持っていません 私の名義でデビュー。ええ、残念ながらそうです"}, {"type": "subtitle", "time": 12986.72, "timestamp": "03:36:26", "text": "私の名義でデビュー。ええ、残念ながらそうです 紛れもない事実です。私はまだデビュー前です、"}, {"type": "subtitle", "time": 12989.2, "timestamp": "03:36:29", "text": "紛れもない事実です。私はまだデビュー前です、 推測。私はしません"}, {"type": "subtitle", "time": 12996.83, "timestamp": "03:36:36", "text": "知る。まあ、そうですね。"}, {"type": "subtitle", "time": 12999.91, "timestamp": "03:36:39", "text": "えっと、私は、いや、いや、私は"}, {"type": "subtitle", "time": 13003.67, "timestamp": "03:36:43", "text": "ストリーミングを停止してください。いいえ。ええ、白"}, {"type": "subtitle", "time": 13005.51, "timestamp": "03:36:45", "text": "背景と黒いもの、または"}, {"type": "subtitle", "time": 13008.79, "timestamp": "03:36:48", "text": "何か。間違えるかもしれない"}, {"type": "subtitle", "time": 13012.15, "timestamp": "03:36:52", "text": "私が卒業するかどうかという意味で理解してください。いいえ、"}, {"type": "subtitle", "time": 13015.19, "timestamp": "03:36:55", "text": "そうではない。私はこれを一度話しました"}, {"type": "subtitle", "time": 13018.469, "timestamp": "03:36:58", "text": "何度も言うと"}]
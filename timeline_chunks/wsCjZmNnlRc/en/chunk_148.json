[{"type": "subtitle", "time": 8906.79, "timestamp": "02:28:26", "text": "Well, guys, you heard the deer. He"}, {"type": "subtitle", "time": 8909.11, "timestamp": "02:28:29", "text": "already ate the banana and he couldn't"}, {"type": "subtitle", "time": 8926.469, "timestamp": "02:28:46", "text": "Isn't that late for you?"}, {"type": "subtitle", "time": 8928.87, "timestamp": "02:28:48", "text": "What time? It's like 1:45."}, {"type": "subtitle", "time": 8938.429, "timestamp": "02:28:58", "text": "now,"}]
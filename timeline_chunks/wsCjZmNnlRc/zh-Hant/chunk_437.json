[{"type": "subtitle", "time": 26226.07, "timestamp": "07:17:06", "text": "不過沒關係。我知道。脖子顏色較深。  是的，我是熊貓醬。我是熊貓醬。呃，寶貝，教學"}, {"type": "subtitle", "time": 26248.39, "timestamp": "07:17:28", "text": "順便問一下，有人"}, {"type": "subtitle", "time": 26253.03, "timestamp": "07:17:33", "text": "知道怎麼玩教學關卡嗎？"}, {"type": "subtitle", "time": 26257.91, "timestamp": "07:17:37", "text": "呃，設備。好的。哦，明白了。好的。知道了。我們走吧。 Quadrant團隊。座位。皮尤研究中心參與者。我們走吧。  米娜"}]
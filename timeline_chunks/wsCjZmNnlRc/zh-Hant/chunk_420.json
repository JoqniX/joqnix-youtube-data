[{"type": "subtitle", "time": 25207.27, "timestamp": "07:00:07", "text": "我不討厭我哦，熊貓"}, {"type": "subtitle", "time": 25209.67, "timestamp": "07:00:09", "text": "。 1600是多少？這個多少錢？等等，等等。  什麼？嗯？等等，等等。我做了什麼？  等等，等等。"}, {"type": "subtitle", "time": 25212.23, "timestamp": "07:00:12", "text": "我做了什麼？"}, {"type": "subtitle", "time": 25229.15, "timestamp": "07:00:29", "text": "等等，我真的花了錢嗎？  等等，等等"}, {"type": "subtitle", "time": 25232.75, "timestamp": "07:00:32", "text": "。我花的是真錢嗎？等一下。我花的是真"}, {"type": "subtitle", "time": 25245.548, "timestamp": "07:00:45", "text": "錢嗎？  等等，等等，等等，等等，等等，等等，等等，等等。我真的浪費錢了嗎？"}, {"type": "subtitle", "time": 25251.43, "timestamp": "07:00:51", "text": "我看到我的錢包裡有一些錢……等等，什麼？哦"}, {"type": "subtitle", "time": 25254.31, "timestamp": "07:00:54", "text": "。哦，它開著。哦，這是試玩版。哦"}]
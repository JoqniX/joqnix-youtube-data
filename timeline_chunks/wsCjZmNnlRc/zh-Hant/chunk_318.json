[{"type": "subtitle", "time": 19104.41, "timestamp": "05:18:24", "text": "天哪。  來啊。來啊。跳。哦，"}, {"type": "subtitle", "time": 19109.868, "timestamp": "05:18:29", "text": "等等。"}, {"type": "subtitle", "time": 19112.708, "timestamp": "05:18:32", "text": "不，我"}, {"type": "subtitle", "time": 19121.99, "timestamp": "05:18:41", "text": "沒想到你會那樣跳起來。  你好。我沒想到你會突然跳起來。我以為我希望你跳進水裡淹死，但並沒有。"}, {"type": "subtitle", "time": 19135.708, "timestamp": "05:18:55", "text": "哦，不"}]
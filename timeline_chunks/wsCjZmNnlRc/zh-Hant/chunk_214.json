[{"type": "subtitle", "time": 12840.63, "timestamp": "03:34:00", "text": "吻我，"}, {"type": "subtitle", "time": 12842.11, "timestamp": "03:34:02", "text": "所有我愛過、死去的人，所有我嫁出去的人，從這個"}, {"type": "subtitle", "time": 12845.91, "timestamp": "03:34:05", "text": "亂七八糟的兔子洞裡走出來的人，他們都來自日本。"}, {"type": "subtitle", "time": 12860.75, "timestamp": "03:34:20", "text": "我知道我知道這很蠢，我仍然活在自己的世界裡，我知道，但"}, {"type": "subtitle", "time": 12880.51, "timestamp": "03:34:40", "text": "我"}, {"type": "subtitle", "time": 12884.389, "timestamp": "03:34:44", "text": "相信只要有決心，總會有辦法，"}, {"type": "subtitle", "time": 12886.309, "timestamp": "03:34:46", "text": "我總是這樣告訴自己。謝謝你們聽我宣布，還有這個呃……東西。我知道"}, {"type": "subtitle", "time": 12891.75, "timestamp": "03:34:51", "text": "我原本想做一個 30 分鐘的公告，結果卻做了大約 1 個小時，但還是要感謝所有鎖定直播、積極參與聊天以及將來會繼續觀看這個公告的人。感謝大家，感謝所有相信我、信任我、願意再次信任我的音樂會觀眾。謝謝。"}]
[{"type": "subtitle", "time": 6556.79, "timestamp": "01:49:16", "text": "總之，就是讓你吃下。等。我想，對，你也可以蒸"}, {"type": "subtitle", "time": 6559.109, "timestamp": "01:49:19", "text": "。蒸香蕉"}, {"type": "subtitle", "time": 6563.75, "timestamp": "01:49:23", "text": "什麼的。不過"}, {"type": "subtitle", "time": 6578.19, "timestamp": "01:49:38", "text": "呃，等等。對，雞蛋應該在我的床上煮，"}]
[{"type": "subtitle", "time": 25342.948, "timestamp": "07:02:22", "text": "，我忘了這遊戲其實還在測試階段。你可以買到任何你想要的東西。但"}, {"type": "subtitle", "time": 25353.91, "timestamp": "07:02:33", "text": "我更想要我的名字。"}, {"type": "subtitle", "time": 25355.75, "timestamp": "07:02:35", "text": "這款遊戲中沒有微"}, {"type": "subtitle", "time": 25357.51, "timestamp": "07:02:37", "text": "暗殺。"}, {"type": "subtitle", "time": 25363.99, "timestamp": "07:02:43", "text": "哦。  那該怎麼做才能找回Jockn的帳號呢？呃，我的"}, {"type": "subtitle", "time": 25368.39, "timestamp": "07:02:48", "text": "Jocknik帳號。我該如何登入"}, {"type": "subtitle", "time": 25374.708, "timestamp": "07:02:54", "text": "Jockn？有人知道嗎？因為測試版獎勵現在我的 Twitch 帳號和 Jocknneck 帳號綁定了。登入Steam。所以你的意思是說，等等，你的意思是登入Steam嗎？哦，你是說像這樣嗎？"}]
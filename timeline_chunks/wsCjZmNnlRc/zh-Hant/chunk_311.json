[{"type": "subtitle", "time": 18664.708, "timestamp": "05:11:04", "text": "多少錢就拿多少。我這就拿過來。我喜歡我輕輕鬆鬆就殺了他們兩次的感覺。  是"}, {"type": "subtitle", "time": 18683.07, "timestamp": "05:11:23", "text": "我嗎？哦，不知"}, {"type": "subtitle", "time": 18706.31, "timestamp": "05:11:46", "text": "翁。好了。休息了那麼久，你怎麼還沒"}, {"type": "subtitle", "time": 18709.51, "timestamp": "05:11:49", "text": "死？好的，這"}]
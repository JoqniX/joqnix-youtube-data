[{"type": "subtitle", "time": 26831.99, "timestamp": "07:27:11", "text": "我求求你們，我什麼都願意做。它為什麼把我趕出去？"}, {"type": "subtitle", "time": 26848.948, "timestamp": "07:27:28", "text": "我"}, {"type": "subtitle", "time": 26851.708, "timestamp": "07:27:31", "text": "沒有使用任何作弊手段。想像一下，如果"}, {"type": "subtitle", "time": 26868.99, "timestamp": "07:27:48", "text": "僅僅因為我玩遊戲、啟動遊戲、玩遊戲就被封號之類的，那會是什麼情況？我會哭的。我已經開始哭了。"}, {"type": "subtitle", "time": 26872.15, "timestamp": "07:27:52", "text": "玩這款"}]
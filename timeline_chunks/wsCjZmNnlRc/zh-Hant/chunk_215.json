[{"type": "subtitle", "time": 12921.79, "timestamp": "03:35:21", "text": "我很高興現在能在這裡直播，能做我能做的事，能追逐我的夢想，我希望我的經歷也能激勵你們去追逐自己的夢想。  好吧，"}, {"type": "subtitle", "time": 12938.309, "timestamp": "03:35:38", "text": "因為這是我的"}, {"type": "subtitle", "time": 12941.71, "timestamp": "03:35:41", "text": "真實經歷，我希望能"}, {"type": "subtitle", "time": 12948.87, "timestamp": "03:35:48", "text": "激勵他人。所以我才設計短頸吉他，因為我想讓我的聲音、我的音樂，以及所有的一切被聽見。但我小時候就希望人們能了解我的故事。希望這也能"}]
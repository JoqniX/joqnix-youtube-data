[{"type": "subtitle", "time": 1264.87, "timestamp": "00:21:04", "text": "啊，為什麼不呢？  它"}, {"type": "chat", "time": 1280.553, "timestamp": "00:21:20", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "3 5 6 and 8 are big numbers in Chinese culture as a reference to Chinese elements or spiritual beliefs. 4 is avoid since is has the same written characters for \"death\"."}, {"type": "subtitle", "time": 1285.27, "timestamp": "00:21:25", "text": "大概會是類似「人」的東西。  是的，他們的英語程度比較差，"}, {"type": "subtitle", "time": 1289.909, "timestamp": "00:21:29", "text": "但還是可以理解的，可以進行一些簡單的溝通。是的。"}, {"type": "subtitle", "time": 1301.83, "timestamp": "00:21:41", "text": "不，我之所以說“nun”，是因為嚴格來說，這是我從我的專業中學到的，因為我的課程裡有"}, {"type": "chat", "time": 1313.132, "timestamp": "00:21:53", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "4 is considered bad Luck basically"}]
[{"type": "subtitle", "time": 19703.19, "timestamp": "05:28:23", "text": "好的。  呃，你知道嗎？呃，我們去加油站省點錢吧"}, {"type": "subtitle", "time": 19713.59, "timestamp": "05:28:33", "text": "你一切順利（音樂方面），而"}, {"type": "subtitle", "time": 19720.47, "timestamp": "05:28:40", "text": "我只剩下一點點時間了"}, {"type": "subtitle", "time": 19722.708, "timestamp": "05:28:42", "text": "。我的直播還沒結束。  所以，讓我去AVR按讚並"}, {"type": "subtitle", "time": 19731.11, "timestamp": "05:28:51", "text": "保存。  好的。我的天啊，我離開了。我們之後需要把車"}, {"type": "subtitle", "time": 19734.23, "timestamp": "05:28:54", "text": "修好送到阿魯達。但現在，我想，是的，安全屋。"}, {"type": "subtitle", "time": 19737.708, "timestamp": "05:28:57", "text": "我看到了安全屋。嗯，差不多了。耶。  最後是天然氣燃料。"}]
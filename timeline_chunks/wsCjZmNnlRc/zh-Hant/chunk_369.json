[{"type": "subtitle", "time": 22141.708, "timestamp": "06:09:01", "text": "和 Twitch。我知道目前的聊天框介面設計很糟糕，但我會想辦法解決的。遊戲為什麼崩潰了？什麼是誠信測驗"}, {"type": "subtitle", "time": 22144.99, "timestamp": "06:09:04", "text": "？哦不，我哦不。喔"}, {"type": "subtitle", "time": 22147.868, "timestamp": "06:09:07", "text": "不，我有點害怕。如果"}, {"type": "subtitle", "time": 22159.19, "timestamp": "06:09:19", "text": "我無法查看測試版完整性失敗的情況怎麼辦"}, {"type": "subtitle", "time": 22174.9, "timestamp": "06:09:34", "text": "驗證一下"}, {"type": "subtitle", "time": 22195.11, "timestamp": "06:09:55", "text": "害怕。呃，我谷歌一下。"}]
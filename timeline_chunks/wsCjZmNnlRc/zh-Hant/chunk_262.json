[{"type": "subtitle", "time": 15721.71, "timestamp": "04:22:01", "text": "你可以把你的嬰兒車停在任何"}, {"type": "subtitle", "time": 15724.309, "timestamp": "04:22:04", "text": "你想停的地方"}, {"type": "subtitle", "time": 15733.189, "timestamp": "04:22:13", "text": "，而且你真的可以開車直接"}, {"type": "subtitle", "time": 15736.07, "timestamp": "04:22:16", "text": "進去一樣。哦，那真酷。  我是不是又把輪胎弄壞了？我的天啊。"}, {"type": "subtitle", "time": 15739.51, "timestamp": "04:22:19", "text": "你知道，"}, {"type": "subtitle", "time": 15741.83, "timestamp": "04:22:21", "text": "最好不要用越野車，因為"}, {"type": "subtitle", "time": 15743.67, "timestamp": "04:22:23", "text": "如果是其他普通車輛，你就得不停地"}, {"type": "subtitle", "time": 15746.55, "timestamp": "04:22:26", "text": "修理它或什麼的。  不，我認為你能夠駕駛普通車輛。我也這麼認為。我"}, {"type": "subtitle", "time": 15748.95, "timestamp": "04:22:28", "text": "也不知道"}, {"type": "subtitle", "time": 15751.03, "timestamp": "04:22:31", "text": "。"}, {"type": "subtitle", "time": 15754.79, "timestamp": "04:22:34", "text": "但如果真是這樣，我相信那也會是好事。"}]
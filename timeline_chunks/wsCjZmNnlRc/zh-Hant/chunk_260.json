[{"type": "subtitle", "time": 15611.79, "timestamp": "04:20:11", "text": "。  你得說服我。我不在乎。向"}, {"type": "subtitle", "time": 15617.75, "timestamp": "04:20:17", "text": "所有人表明你是來"}, {"type": "subtitle", "time": 15631.349, "timestamp": "04:20:31", "text": "。  艾莉·凱爾·克萊恩·埃斯基，你能不能至少給我一些提示？你們"}, {"type": "subtitle", "time": 15633.75, "timestamp": "04:20:33", "text": "需要什麼？我想我或許能幫上"}, {"type": "subtitle", "time": 15640.79, "timestamp": "04:20:40", "text": "忙。  記住，總有一天你會"}, {"type": "subtitle", "time": 15644.51, "timestamp": "04:20:44", "text": "報答這份恩情。"}]
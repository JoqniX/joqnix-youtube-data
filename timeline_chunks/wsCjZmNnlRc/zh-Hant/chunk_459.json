[{"type": "subtitle", "time": 27542.31, "timestamp": "07:39:02", "text": "天哪，我的隊友離開我了。最後一位成員需要保持冷靜。  我的隊友離開了我。  強大的隊伍開始了我們的第一個"}, {"type": "subtitle", "time": 27545.11, "timestamp": "07:39:05", "text": "賽季，我的隊友離開了我。這樣"}, {"type": "subtitle", "time": 27553.08, "timestamp": "07:39:13", "text": "正常嗎？我的隊友"}, {"type": "subtitle", "time": 27556.35, "timestamp": "07:39:16", "text": "離開了我。"}, {"type": "subtitle", "time": 27583.07, "timestamp": "07:39:43", "text": "等等，不對。我的天哪，祂還活著。哦"}, {"type": "subtitle", "time": 27597.67, "timestamp": "07:39:57", "text": "，感謝上帝。我當時有點害怕。  這對強大的白隊來說是個打擊。  如果不是太老套的話，我會說「昔日強者隕落」。這是事實。"}]
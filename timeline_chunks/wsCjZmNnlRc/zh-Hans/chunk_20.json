[{"type": "subtitle", "time": 1204.39, "timestamp": "00:20:04", "text": "好吧。这样说有点不太好。"}, {"type": "subtitle", "time": 1205.95, "timestamp": "00:20:05", "text": "直播，但我还是要说。"}, {"type": "subtitle", "time": 1208.35, "timestamp": "00:20:08", "text": "总之。"}, {"type": "subtitle", "time": 1210.87, "timestamp": "00:20:10", "text": "嗯，如果你能碰巧把它们联系起来就好了。"}, {"type": "subtitle", "time": 1214.51, "timestamp": "00:20:14", "text": "对我来说，我会非常感激。"}, {"type": "subtitle", "time": 1225.11, "timestamp": "00:20:25", "text": "是的。是的。我想上次我"}, {"type": "subtitle", "time": 1227.11, "timestamp": "00:20:27", "text": "谈到比利·比利，以及想要"}, {"type": "subtitle", "time": 1229.19, "timestamp": "00:20:29", "text": "在那里直播，我有机会"}, {"type": "subtitle", "time": 1230.43, "timestamp": "00:20:30", "text": "在这里观看直播"}, {"type": "subtitle", "time": 1234.07, "timestamp": "00:20:34", "text": "一切等等，去年我"}, {"type": "subtitle", "time": 1236.95, "timestamp": "00:20:36", "text": "基本上没怎么直播。我拿"}, {"type": "subtitle", "time": 1239.59, "timestamp": "00:20:39", "text": "一段漫长的空白期。"}, {"type": "subtitle", "time": 1243.07, "timestamp": "00:20:43", "text": "那是一个我会在……里讲给你听的故事。"}, {"type": "subtitle", "time": 1245.63, "timestamp": "00:20:45", "text": "私人的。是的，因为我"}, {"type": "subtitle", "time": 1248.39, "timestamp": "00:20:48", "text": "不行，我不能在直播里说。"}, {"type": "subtitle", "time": 1251.75, "timestamp": "00:20:51", "text": "是的。是的，我花了很长时间，我不能说。"}, {"type": "subtitle", "time": 1254.549, "timestamp": "00:20:54", "text": "在直播中。"}, {"type": "subtitle", "time": 1256.07, "timestamp": "00:20:56", "text": "等等，你刚才说什么来着？我"}]
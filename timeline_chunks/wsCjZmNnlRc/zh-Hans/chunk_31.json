[{"type": "subtitle", "time": 1872.07, "timestamp": "00:31:12", "text": "哦，但我可以说我一直在处理这件事。"}, {"type": "subtitle", "time": 1874.63, "timestamp": "00:31:14", "text": "与 Kok。这或许是你想要的"}, {"type": "subtitle", "time": 1877.23, "timestamp": "00:31:17", "text": "感兴趣的。"}, {"type": "subtitle", "time": 1880.389, "timestamp": "00:31:20", "text": "哦，我一直在唱 Koki。"}, {"type": "subtitle", "time": 1887.269, "timestamp": "00:31:27", "text": "呃，但是，但是，我想，我想"}, {"type": "subtitle", "time": 1888.95, "timestamp": "00:31:28", "text": "让你猜猜我听过哪些歌。"}, {"type": "subtitle", "time": 1901.59, "timestamp": "00:31:41", "text": "我本来想骂人的，但是，嗯，我有"}, {"type": "subtitle", "time": 1909.95, "timestamp": "00:31:49", "text": "我这么想是因为……"}, {"type": "subtitle", "time": 1913.19, "timestamp": "00:31:53", "text": "你能猜出是什么类型的声音吗？"}, {"type": "subtitle", "time": 1916.87, "timestamp": "00:31:56", "text": "我唱歌时使用的声音"}, {"type": "subtitle", "time": 1919.11, "timestamp": "00:31:59", "text": "我脑子里一片空白，想不起来我当时是怎么想的。"}, {"type": "chat", "time": 1919.461, "timestamp": "00:31:59", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "I'm not trying to do myself ya know. but just saying I'm open to new cultures I love experiencing new places and styles of living. I think it's cool to learn how others experience life"}]
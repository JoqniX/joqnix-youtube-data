[{"type": "subtitle", "time": 16441.75, "timestamp": "04:34:01", "text": "即使我真的会很累"}, {"type": "subtitle", "time": 16445.349, "timestamp": "04:34:05", "text": "8月11日左右回家"}, {"type": "subtitle", "time": 16447.47, "timestamp": "04:34:07", "text": "回家，就像回到我的新家一样"}, {"type": "subtitle", "time": 16451.51, "timestamp": "04:34:11", "text": "地点来自我父母家。所以"}, {"type": "subtitle", "time": 16455.39, "timestamp": "04:34:15", "text": "是的，我会尽量在生日当天进行直播。"}, {"type": "subtitle", "time": 16458.07, "timestamp": "04:34:18", "text": "第十二。又是一小段溪流。"}, {"type": "subtitle", "time": 16461.429, "timestamp": "04:34:21", "text": "是的，我正在尝试做一个简短的"}, {"type": "subtitle", "time": 16464.949, "timestamp": "04:34:24", "text": "流弧。是的，明天我们有"}, {"type": "subtitle", "time": 16466.629, "timestamp": "04:34:26", "text": "Nidi 直播过载及第二天"}, {"type": "subtitle", "time": 16469.349, "timestamp": "04:34:29", "text": "明天我们有Hogwatch，还有……"}, {"type": "subtitle", "time": 16471.99, "timestamp": "04:34:31", "text": "周三我们有谷歌地球。如果"}, {"type": "subtitle", "time": 16474.31, "timestamp": "04:34:34", "text": "你想知道什么是谷歌地球吗？"}, {"type": "subtitle", "time": 16476.709, "timestamp": "04:34:36", "text": "我们会像真正探索这个一样去探索它。"}, {"type": "subtitle", "time": 16479.91, "timestamp": "04:34:39", "text": "我们共同的地球。好的，我们将进行探索"}, {"type": "subtitle", "time": 16483.67, "timestamp": "04:34:43", "text": "比如透过行星观察世界。不，"}, {"type": "subtitle", "time": 16486.349, "timestamp": "04:34:46", "text": "不是行星，是地球上的东西，你"}, {"type": "subtitle", "time": 16490.551, "timestamp": "04:34:50", "text": "知道。你好。是的，短视频增强现实（AR）"}, {"type": "subtitle", "time": 16492.869, "timestamp": "04:34:52", "text": "应该只需要两个小时。我想"}, {"type": "subtitle", "time": 16495.349, "timestamp": "04:34:55", "text": "这样做是为了让我可以……"}, {"type": "subtitle", "time": 16499.029, "timestamp": "04:34:59", "text": "速通很多东西。是的。"}]
[{"type": "subtitle", "time": 16142.229, "timestamp": "04:29:02", "text": "是的。所以今天我们要玩……"}, {"type": "subtitle", "time": 16146.63, "timestamp": "04:29:06", "text": "后续的DLC。你好。今天我们将……"}, {"type": "subtitle", "time": 16149.429, "timestamp": "04:29:09", "text": "正在游玩以下DLC。我在看"}, {"type": "subtitle", "time": 16152.429, "timestamp": "04:29:12", "text": "接下来看看这场游戏会如何进行。"}, {"type": "subtitle", "time": 16154.95, "timestamp": "04:29:14", "text": "是。希望你们一切都好。"}, {"type": "subtitle", "time": 16158.95, "timestamp": "04:29:18", "text": "出色地。和往常一样，嗯，请务必……"}, {"type": "subtitle", "time": 16161.67, "timestamp": "04:29:21", "text": "补充水分，然后把东西塞进车里。记住"}, {"type": "subtitle", "time": 16164.389, "timestamp": "04:29:24", "text": "如果你还没喝水，那就喝点吧。和"}, {"type": "subtitle", "time": 16167.349, "timestamp": "04:29:27", "text": "呃，今天是星期天，对吧？"}, {"type": "subtitle", "time": 16170.07, "timestamp": "04:29:30", "text": "今天。是的，今天是星期天。今天是"}, {"type": "subtitle", "time": 16171.75, "timestamp": "04:29:31", "text": "再会。实话实说。感觉"}, {"type": "subtitle", "time": 16175.149, "timestamp": "04:29:35", "text": "就像一个美好而愉快的早晨"}, {"type": "subtitle", "time": 16178.389, "timestamp": "04:29:38", "text": "今天。所以，好好享受吧。"}, {"type": "subtitle", "time": 16182.229, "timestamp": "04:29:42", "text": "平静下来？不。所以，呃，今天的直播将"}, {"type": "subtitle", "time": 16185.349, "timestamp": "04:29:45", "text": "篇幅要短。我猜我最多也就是"}, {"type": "subtitle", "time": 16187.429, "timestamp": "04:29:47", "text": "尽量让它至少持续2个小时"}, {"type": "subtitle", "time": 16190.55, "timestamp": "04:29:50", "text": "我这就总结一下。好的。最大值和两个"}, {"type": "subtitle", "time": 16195.91, "timestamp": "04:29:55", "text": "2小时。你好。我们将继续……"}, {"type": "subtitle", "time": 16197.95, "timestamp": "04:29:57", "text": "我们将继续在下一季中看到《消逝的光芒》。"}]
[{"type": "subtitle", "time": 15301.55, "timestamp": "04:15:01", "text": "呃，我的意思是，是的，官方设定是……"}, {"type": "subtitle", "time": 15304.469, "timestamp": "04:15:04", "text": "整个过程中，jocknik 的身份将会揭晓"}, {"type": "subtitle", "time": 15307.67, "timestamp": "04:15:07", "text": "首次亮相，而我将资助这个模型。"}, {"type": "subtitle", "time": 15310.469, "timestamp": "04:15:10", "text": "那将是官方模型。"}, {"type": "subtitle", "time": 15313.71, "timestamp": "04:15:13", "text": "方式"}, {"type": "subtitle", "time": 15317.07, "timestamp": "04:15:17", "text": "运动健将的官方模特"}, {"type": "subtitle", "time": 15320.389, "timestamp": "04:15:20", "text": "下一个。是的，这个更像是……"}, {"type": "subtitle", "time": 15324.79, "timestamp": "04:15:24", "text": "初始系列弧模型，呃，概念"}, {"type": "subtitle", "time": 15327.269, "timestamp": "04:15:27", "text": "以及那一个"}, {"type": "subtitle", "time": 15330.469, "timestamp": "04:15:30", "text": "呃，我们就是那个，我会是"}, {"type": "subtitle", "time": 15332.71, "timestamp": "04:15:32", "text": "如果资金充足，我就出道。"}, {"type": "subtitle", "time": 15335.189, "timestamp": "04:15:35", "text": "如果一切顺利的话……"}, {"type": "subtitle", "time": 15338.149, "timestamp": "04:15:38", "text": "运动护裆将是官方的运动护裆设计。"}, {"type": "subtitle", "time": 15340.309, "timestamp": "04:15:40", "text": "Jocknik 的角色设计"}, {"type": "subtitle", "time": 15341.91, "timestamp": "04:15:41", "text": "一切。你好。一切都将"}, {"type": "subtitle", "time": 15345.149, "timestamp": "04:15:45", "text": "从此以后正式生效。"}, {"type": "subtitle", "time": 15348.71, "timestamp": "04:15:48", "text": "是啊，兄弟。希望你喜欢。迪奥，我"}, {"type": "subtitle", "time": 15351.189, "timestamp": "04:15:51", "text": "希望你喜欢，我很喜欢这个模型。"}, {"type": "subtitle", "time": 15352.75, "timestamp": "04:15:52", "text": "很多。我不"}, {"type": "subtitle", "time": 15355.67, "timestamp": "04:15:55", "text": "知道。我非常感谢所有帮助过我的人。"}, {"type": "subtitle", "time": 15358.229, "timestamp": "04:15:58", "text": "他在幕后付出了很多努力来帮助我。"}]
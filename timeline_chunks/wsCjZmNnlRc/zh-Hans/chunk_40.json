[{"type": "subtitle", "time": 2401.829, "timestamp": "00:40:01", "text": "不存在的，比如和类似的东西，之后"}, {"type": "subtitle", "time": 2405.03, "timestamp": "00:40:05", "text": "他们不喜欢的合作方式，比如他们会说的那句话。"}, {"type": "subtitle", "time": 2408.15, "timestamp": "00:40:08", "text": "那次合作很糟糕等等。"}, {"type": "subtitle", "time": 2411.03, "timestamp": "00:40:11", "text": "那时我才意识到我身处日本。"}, {"type": "subtitle", "time": 2414.23, "timestamp": "00:40:14", "text": "有时他们会看着某些人"}, {"type": "subtitle", "time": 2417.39, "timestamp": "00:40:17", "text": "聊天互动情况也很好。我当时想，"}, {"type": "subtitle", "time": 2421.109, "timestamp": "00:40:21", "text": "“嗯？”我以为它只是关于……"}, {"type": "subtitle", "time": 2422.95, "timestamp": "00:40:22", "text": "你知道，与两位创作者建立联系，"}, {"type": "subtitle", "time": 2424.55, "timestamp": "00:40:24", "text": "彼此连接，就像你"}, {"type": "subtitle", "time": 2428.069, "timestamp": "00:40:28", "text": "我知道，玩得很开心。但有些人很在意。"}, {"type": "subtitle", "time": 2430.79, "timestamp": "00:40:30", "text": "很多关于数字的内容。是的。呃"}, {"type": "subtitle", "time": 2433.51, "timestamp": "00:40:33", "text": "数字固然重要，嗯……"}, {"type": "subtitle", "time": 2437.03, "timestamp": "00:40:37", "text": "说实话，我不在乎。呃"}, {"type": "subtitle", "time": 2439.589, "timestamp": "00:40:39", "text": "说到底，我只是个普通人。"}, {"type": "subtitle", "time": 2442.55, "timestamp": "00:40:42", "text": "天。内容创作并非我的热情所在。"}, {"type": "subtitle", "time": 2445.51, "timestamp": "00:40:45", "text": "很抱歉让您失望了。我只是个"}, {"type": "subtitle", "time": 2448.67, "timestamp": "00:40:48", "text": "一个普通的老头"}, {"type": "subtitle", "time": 2452.87, "timestamp": "00:40:52", "text": "呃，他讨厌内容创作。"}, {"type": "subtitle", "time": 2456.589, "timestamp": "00:40:56", "text": "热情。不看虚拟主播，呃……"}]
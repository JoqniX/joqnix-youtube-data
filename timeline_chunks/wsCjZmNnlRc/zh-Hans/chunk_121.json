[{"type": "subtitle", "time": 7261.35, "timestamp": "02:01:01", "text": "伟大的。既然如此，那我就告诉你……"}, {"type": "subtitle", "time": 7264.31, "timestamp": "02:01:04", "text": "关于乔克的小秘密。所以垃圾是真的"}, {"type": "subtitle", "time": 7268.95, "timestamp": "02:01:08", "text": "名字是……哦我的天哪。不，它以……开头"}, {"type": "subtitle", "time": 7283.03, "timestamp": "02:01:23", "text": "我当时是想开个玩笑，但是"}, {"type": "chat", "time": 7285.348, "timestamp": "02:01:25", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "in judo/jujitsu. \"I'm super dangerous guy\". *gets yeeted 20 feets on first class*"}, {"type": "subtitle", "time": 7285.83, "timestamp": "02:01:25", "text": "现在你真的可以自己动手了。不，正是如此。"}, {"type": "subtitle", "time": 7288.55, "timestamp": "02:01:28", "text": "不，这是我，我会把它放在那里。"}, {"type": "subtitle", "time": 7295.99, "timestamp": "02:01:35", "text": "这是结束。"}, {"type": "subtitle", "time": 7298.39, "timestamp": "02:01:38", "text": "你知道你其实已经发过帖子了"}, {"type": "subtitle", "time": 7301.589, "timestamp": "02:01:41", "text": "会显示你名字的推特。"}, {"type": "subtitle", "time": 7303.99, "timestamp": "02:01:43", "text": "什么？"}, {"type": "subtitle", "time": 7305.669, "timestamp": "02:01:45", "text": "你确实发帖了。是的。你已经"}, {"type": "subtitle", "time": 7307.75, "timestamp": "02:01:47", "text": "实际上在推特上用了你的真名"}, {"type": "subtitle", "time": 7309.43, "timestamp": "02:01:49", "text": "前。"}, {"type": "subtitle", "time": 7314.99, "timestamp": "02:01:54", "text": "我做了。决不。那是2022年的事了。"}, {"type": "subtitle", "time": 7319.99, "timestamp": "02:01:59", "text": "兄弟。我的天啊。我做了。"}]
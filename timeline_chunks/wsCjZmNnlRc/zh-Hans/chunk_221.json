[{"type": "subtitle", "time": 13261.95, "timestamp": "03:41:01", "text": "我在市场营销方面并没有投入太多精力。"}, {"type": "subtitle", "time": 13264.55, "timestamp": "03:41:04", "text": "或者所有那些东西，呃，因为我不知道"}, {"type": "subtitle", "time": 13268.309, "timestamp": "03:41:08", "text": "怎么做呢？嗯，因为我个子比较小。"}, {"type": "subtitle", "time": 13269.83, "timestamp": "03:41:09", "text": "创作者"}, {"type": "subtitle", "time": 13272.71, "timestamp": "03:41:12", "text": "呃，这真的很难通过。"}, {"type": "subtitle", "time": 13275.75, "timestamp": "03:41:15", "text": "乔森的目标是"}, {"type": "subtitle", "time": 13277.63, "timestamp": "03:41:17", "text": "实际上"}, {"type": "subtitle", "time": 13282.229, "timestamp": "03:41:22", "text": "呃，实际上是 2000 美元。"}, {"type": "subtitle", "time": 13287.03, "timestamp": "03:41:27", "text": "为什么是 2.00 是因为我需要……嗯，我想"}, {"type": "subtitle", "time": 13290.15, "timestamp": "03:41:30", "text": "嗯，九岁以下的话，我觉得我需要一千美元。"}, {"type": "subtitle", "time": 13292.15, "timestamp": "03:41:32", "text": "用于索具"}, {"type": "subtitle", "time": 13295.349, "timestamp": "03:41:35", "text": "呃，我有模型，但是有一些"}, {"type": "subtitle", "time": 13298.229, "timestamp": "03:41:38", "text": "我需要解决的那些问题，还有那笔钱。"}, {"type": "subtitle", "time": 13301.349, "timestamp": "03:41:41", "text": "再加上作弊的钱，然后不管怎样我"}, {"type": "subtitle", "time": 13304.71, "timestamp": "03:41:44", "text": "之后如果还有剩余的话……"}, {"type": "subtitle", "time": 13307.55, "timestamp": "03:41:47", "text": "那只会朝着"}, {"type": "subtitle", "time": 13310.469, "timestamp": "03:41:50", "text": "进入出道准备阶段等等"}, {"type": "subtitle", "time": 13313.03, "timestamp": "03:41:53", "text": "我至少可以首次亮相。不，已经很久了。"}, {"type": "subtitle", "time": 13315.59, "timestamp": "03:41:55", "text": "我已经等了这么多年了"}, {"type": "subtitle", "time": 13319.03, "timestamp": "03:41:59", "text": "只是为了首发，我耐心地等待着。"}]
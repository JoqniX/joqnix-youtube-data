[{"type": "subtitle", "time": 4742.07, "timestamp": "01:19:02", "text": "不过说实话，我觉得我不会喜欢"}, {"type": "subtitle", "time": 4744.39, "timestamp": "01:19:04", "text": "要求推出一款类似七岁的新车型。"}, {"type": "subtitle", "time": 4746.79, "timestamp": "01:19:06", "text": "年。新的那个就会在那里。"}, {"type": "subtitle", "time": 4750.39, "timestamp": "01:19:10", "text": "我给你看过模型了吗？"}, {"type": "subtitle", "time": 4752.47, "timestamp": "01:19:12", "text": "等等，你已经有模型了？"}, {"type": "chat", "time": 4754.142, "timestamp": "01:19:14", "author": "@Victor-MrinMoy", "avatar": "https://yt4.ggpht.com/Gaz0C79q_RG4g0C-14BlD7DV4KSkdqrEdWKhEr9EeavJEbCjSnvHS0Wd2lGovXii5XhBOCaWnQ=s64-c-k-c0x00ffffff-no-rj", "message": "oh good sir,you can make all the dad jokes,he didn't even get deez nuts jokes"}, {"type": "subtitle", "time": 4754.79, "timestamp": "01:19:14", "text": "那你为什么还要问这个问题？不，"}, {"type": "subtitle", "time": 4757.669, "timestamp": "01:19:17", "text": "不，不，不。呃，只有艺术品。我必须"}, {"type": "subtitle", "time": 4760.35, "timestamp": "01:19:20", "text": "呃，因为我上次跟你说的那些事。"}, {"type": "subtitle", "time": 4766.11, "timestamp": "01:19:26", "text": "年。呃，那件事没成功。"}, {"type": "subtitle", "time": 4771.189, "timestamp": "01:19:31", "text": "所以，我得交许可证费用，嗯……"}, {"type": "subtitle", "time": 4775.91, "timestamp": "01:19:35", "text": "也把画作修好，因为这位艺术家"}, {"type": "subtitle", "time": 4777.99, "timestamp": "01:19:37", "text": "之前没接触过2D实时模型之类的东西。所以，"}, {"type": "subtitle", "time": 4782.35, "timestamp": "01:19:42", "text": "它并没有完全分离，就像……"}, {"type": "subtitle", "time": 4785.11, "timestamp": "01:19:45", "text": "深入地。所以，我必须付钱，而且"}, {"type": "subtitle", "time": 4789.91, "timestamp": "01:19:49", "text": "得付索具费用。所以总共"}, {"type": "subtitle", "time": 4791.47, "timestamp": "01:19:51", "text": "大约"}, {"type": "subtitle", "time": 4794.87, "timestamp": "01:19:54", "text": "2000岁左右的人。"}, {"type": "subtitle", "time": 4797.83, "timestamp": "01:19:57", "text": "是的。欢迎打招呼然后离开。"}, {"type": "subtitle", "time": 4799.99, "timestamp": "01:19:59", "text": "守护者游戏。你真了不起。和"}]
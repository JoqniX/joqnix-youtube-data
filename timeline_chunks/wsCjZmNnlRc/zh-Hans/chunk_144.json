[{"type": "subtitle", "time": 8640.469, "timestamp": "02:24:00", "text": "在香蕉那里。"}, {"type": "subtitle", "time": 8642.94, "timestamp": "02:24:02", "text": "你看，乔克说"}, {"type": "subtitle", "time": 8687.75, "timestamp": "02:24:47", "text": "现在。是吗？你永远无法预知那个年龄。"}, {"type": "subtitle", "time": 8691.59, "timestamp": "02:24:51", "text": "给予其实是一种麻木。"}, {"type": "subtitle", "time": 8697.19, "timestamp": "02:24:57", "text": "但我认为这让她展现出了她本来的样子。"}, {"type": "subtitle", "time": 8698.75, "timestamp": "02:24:58", "text": "母语"}]
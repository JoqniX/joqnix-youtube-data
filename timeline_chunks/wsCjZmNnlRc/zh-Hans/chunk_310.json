[{"type": "subtitle", "time": 18600.07, "timestamp": "05:10:00", "text": "你好呀。与强盗交谈"}, {"type": "subtitle", "time": 18602.15, "timestamp": "05:10:02", "text": "之后。朋友，你来了。每一个新"}, {"type": "subtitle", "time": 18609.35, "timestamp": "05:10:09", "text": "阿森，就是这家伙。你实际上是在卖东西"}, {"type": "subtitle", "time": 18611.59, "timestamp": "05:10:11", "text": "这里有什么吗？水。水晶"}, {"type": "subtitle", "time": 18614.47, "timestamp": "05:10:14", "text": "清除。之后没有腹泻。味道"}, {"type": "subtitle", "time": 18616.628, "timestamp": "05:10:16", "text": "如果天使踩进了你的舌头。一"}, {"type": "subtitle", "time": 18620.23, "timestamp": "05:10:20", "text": "一加仑水可以装10磅食物。黄金"}, {"type": "subtitle", "time": 18623.35, "timestamp": "05:10:23", "text": "出色地。 10磅食物换水。你是"}, {"type": "subtitle", "time": 18625.11, "timestamp": "05:10:25", "text": "打算开始对空气收费吗？"}, {"type": "subtitle", "time": 18627.59, "timestamp": "05:10:27", "text": "哦，我们找到一个讨价还价的高手了。讨价还价者？看"}, {"type": "subtitle", "time": 18630.55, "timestamp": "05:10:30", "text": "下去吧，小混蛋。看到了吗？那是"}, {"type": "subtitle", "time": 18633.19, "timestamp": "05:10:33", "text": "罗斯科。我们把讨价还价的人交给他。"}, {"type": "subtitle", "time": 18636.15, "timestamp": "05:10:36", "text": "讨价还价者。还想讨价还价吗？告诉"}, {"type": "subtitle", "time": 18638.788, "timestamp": "05:10:38", "text": "如果你愿意，我或许会让你用你的车跟我换车。"}, {"type": "subtitle", "time": 18642.55, "timestamp": "05:10:42", "text": "需要一些水。去你妈的，混蛋。所以要如此。"}, {"type": "subtitle", "time": 18651.43, "timestamp": "05:10:51", "text": "再见。"}, {"type": "subtitle", "time": 18653.51, "timestamp": "05:10:53", "text": "哦，不。不，我死了。我没有检查我的"}, {"type": "subtitle", "time": 18656.23, "timestamp": "05:10:56", "text": "健康。我的天哪。没关系。没关系。"}, {"type": "subtitle", "time": 18658.67, "timestamp": "05:10:58", "text": "没关系。它是"}]
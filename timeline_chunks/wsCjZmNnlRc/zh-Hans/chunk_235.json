[{"type": "subtitle", "time": 14100.15, "timestamp": "03:55:00", "text": "未来要重点关注这一点。我希望我能"}, {"type": "subtitle", "time": 14103.189, "timestamp": "03:55:03", "text": "去做。我希望你们亲眼见证这一点。"}, {"type": "subtitle", "time": 14105.349, "timestamp": "03:55:05", "text": "情况也是如此。无论我"}, {"type": "subtitle", "time": 14107.269, "timestamp": "03:55:07", "text": "从音乐中赚到的钱，会重新投入到音乐中。"}, {"type": "subtitle", "time": 14111.269, "timestamp": "03:55:11", "text": "音乐相关的内容。就是这样。以及现实生活中的事情。我"}, {"type": "subtitle", "time": 14114.95, "timestamp": "03:55:14", "text": "我给自己定了一条规矩，那就是"}, {"type": "subtitle", "time": 14118.71, "timestamp": "03:55:18", "text": "我不会把流媒体赚来的钱用来做其他用途。"}, {"type": "subtitle", "time": 14122.229, "timestamp": "03:55:22", "text": "或者任何地方，用来存放我的现实生活中的个人物品。"}, {"type": "subtitle", "time": 14126.07, "timestamp": "03:55:26", "text": "因为在我看来那不好，因为我想要"}, {"type": "subtitle", "time": 14128.95, "timestamp": "03:55:28", "text": "用我自己的血汗钱，竭尽全力"}, {"type": "subtitle", "time": 14133.75, "timestamp": "03:55:33", "text": "汗水和泪水，赚钱，然后……"}, {"type": "subtitle", "time": 14136.55, "timestamp": "03:55:36", "text": "我对赚的钱很满意，也很喜欢我的工作。"}, {"type": "subtitle", "time": 14140.87, "timestamp": "03:55:40", "text": "生存下去。在这个世界上。那是"}, {"type": "subtitle", "time": 14144.309, "timestamp": "03:55:44", "text": "我真正想要的钱。现实生活中"}, {"type": "subtitle", "time": 14145.229, "timestamp": "03:55:45", "text": "和"}, {"type": "subtitle", "time": 14151.11, "timestamp": "03:55:51", "text": "是的，是的，所以，是的，我没有"}, {"type": "subtitle", "time": 14153.51, "timestamp": "03:55:53", "text": "我没有制定不使用的规则"}, {"type": "subtitle", "time": 14155.429, "timestamp": "03:55:55", "text": "呃，我从……获得的任何支持资金"}, {"type": "subtitle", "time": 14158.79, "timestamp": "03:55:58", "text": "在线上也一样，因为我不能"}]
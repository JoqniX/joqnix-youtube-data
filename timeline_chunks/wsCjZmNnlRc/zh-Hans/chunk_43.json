[{"type": "subtitle", "time": 2582.87, "timestamp": "00:43:02", "text": "你的收入以及你的成功程度。"}, {"type": "subtitle", "time": 2585.589, "timestamp": "00:43:05", "text": "真令人难过。工作文化使这一切变得困难"}, {"type": "subtitle", "time": 2590.069, "timestamp": "00:43:10", "text": "只是想做个人而已。嗯，某种程度上是的。"}, {"type": "subtitle", "time": 2592.069, "timestamp": "00:43:12", "text": "有时确实如此。是的。而我是"}, {"type": "subtitle", "time": 2594.71, "timestamp": "00:43:14", "text": "接下来要去那个国家。下一个 下一个"}, {"type": "subtitle", "time": 2597.67, "timestamp": "00:43:17", "text": "一。的"}, {"type": "subtitle", "time": 2599.19, "timestamp": "00:43:19", "text": "我猜他们会采取强硬措施。"}, {"type": "subtitle", "time": 2606.069, "timestamp": "00:43:26", "text": "我的天啊。"}, {"type": "subtitle", "time": 2609.03, "timestamp": "00:43:29", "text": "我很遗憾自己是马尔默人。我说的是，但是"}, {"type": "subtitle", "time": 2610.95, "timestamp": "00:43:30", "text": "我也觉得这很合适。"}, {"type": "subtitle", "time": 2612.87, "timestamp": "00:43:32", "text": "只是马尔默那副表情而已。"}, {"type": "subtitle", "time": 2615.51, "timestamp": "00:43:35", "text": "这让我感觉很……让我看起来很……"}, {"type": "subtitle", "time": 2618.71, "timestamp": "00:43:38", "text": "我可能确实有点虐待倾向，但我们……"}, {"type": "subtitle", "time": 2622.39, "timestamp": "00:43:42", "text": "我们尽量把它降温一些。"}, {"type": "subtitle", "time": 2630.069, "timestamp": "00:43:50", "text": "所以，今天我们要尝试做的事情是……"}, {"type": "subtitle", "time": 2631.99, "timestamp": "00:43:51", "text": "我们只是想看看我们能走多远"}, {"type": "subtitle", "time": 2633.829, "timestamp": "00:43:53", "text": "可以在 Twitch 点赞之前推动这件事。"}]
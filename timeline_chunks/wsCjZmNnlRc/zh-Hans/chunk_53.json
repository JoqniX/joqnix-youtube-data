[{"type": "subtitle", "time": 3182.069, "timestamp": "00:53:02", "text": "你只需无视那个人，然后你就"}, {"type": "subtitle", "time": 3185.589, "timestamp": "00:53:05", "text": "别说话。这种情况偶尔会发生。我们"}, {"type": "subtitle", "time": 3187.91, "timestamp": "00:53:07", "text": "人难免会犯错"}, {"type": "subtitle", "time": 3189.47, "timestamp": "00:53:09", "text": "称呼某人时，"}, {"type": "subtitle", "time": 3192.15, "timestamp": "00:53:12", "text": "不对。犯错是正常的，"}, {"type": "subtitle", "time": 3194.39, "timestamp": "00:53:14", "text": "你知道，尤其当你有一个大"}, {"type": "subtitle", "time": 3197.85, "timestamp": "00:53:17", "text": "嘴巴像我。"}, {"type": "subtitle", "time": 3200.549, "timestamp": "00:53:20", "text": "[音乐]"}, {"type": "subtitle", "time": 3203.19, "timestamp": "00:53:23", "text": "并非每个人都喜欢某人。"}, {"type": "subtitle", "time": 3206.95, "timestamp": "00:53:26", "text": "谁像我一样话多，或者说"}, {"type": "subtitle", "time": 3209.43, "timestamp": "00:53:29", "text": "不假思索地做事。我想知道我是如何做到的"}, {"type": "subtitle", "time": 3212.549, "timestamp": "00:53:32", "text": "甚至还和我的……一起上了大学"}, {"type": "subtitle", "time": 3216.15, "timestamp": "00:53:36", "text": "性格和我的智力，或者"}, {"type": "subtitle", "time": 3225.589, "timestamp": "00:53:45", "text": "你有很多朋友"}, {"type": "chat", "time": 3228.367, "timestamp": "00:53:48", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "the egg: \"you dare you misgender me, i haven't decided yet\""}, {"type": "subtitle", "time": 3231.93, "timestamp": "00:53:51", "text": "我不知道。"}, {"type": "chat", "time": 3234.816, "timestamp": "00:53:54", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/KsIfY6LzFoLM6AKanYDQAgUCkszU2WH9gy1mb0dV-11UJg/KsIfY6LzFoLM6AKanYDQAg"}]
[{"type": "subtitle", "time": 13920.389, "timestamp": "03:52:00", "text": "好，我们把它做成一个合作项目吧。"}, {"type": "subtitle", "time": 13923.229, "timestamp": "03:52:03", "text": "共同努力。不，这不仅仅是我的"}, {"type": "subtitle", "time": 13926.15, "timestamp": "03:52:06", "text": "努力。我希望大家都能……呃，我们……"}, {"type": "subtitle", "time": 13929.189, "timestamp": "03:52:09", "text": "大家一起完成这件事。好的，就这样。"}, {"type": "subtitle", "time": 13931.83, "timestamp": "03:52:11", "text": "我想说的话。"}, {"type": "subtitle", "time": 13935.11, "timestamp": "03:52:15", "text": "是的，我会尽我所能。我会的"}, {"type": "subtitle", "time": 13938.91, "timestamp": "03:52:18", "text": "我会向你证明我能做到"}, {"type": "subtitle", "time": 13942.71, "timestamp": "03:52:22", "text": "最好的。所以，请保佑我。"}, {"type": "subtitle", "time": 13944.75, "timestamp": "03:52:24", "text": "看我的"}, {"type": "subtitle", "time": 13948.75, "timestamp": "03:52:28", "text": "旅行。是啊，但愿如此吧。"}, {"type": "subtitle", "time": 13953.67, "timestamp": "03:52:33", "text": "然后，奇迹发生了。我会"}, {"type": "subtitle", "time": 13956.91, "timestamp": "03:52:36", "text": "能够 我将能够 呃 有"}, {"type": "subtitle", "time": 13960.83, "timestamp": "03:52:40", "text": "足以实际"}, {"type": "subtitle", "time": 13962.349, "timestamp": "03:52:42", "text": "呃"}, {"type": "subtitle", "time": 13965.75, "timestamp": "03:52:45", "text": "是什么激发了我内心深处那个运动健将的一面？"}, {"type": "subtitle", "time": 13970.189, "timestamp": "03:52:50", "text": "已经做了一年了。"}, {"type": "subtitle", "time": 13973.75, "timestamp": "03:52:53", "text": "是的。是的，这是一次不错的体验。"}, {"type": "subtitle", "time": 13977.469, "timestamp": "03:52:57", "text": "一次全新的体验。是的。"}]
[{"type": "subtitle", "time": 13441.67, "timestamp": "03:44:01", "text": "我相信我能做到。即使我不得不"}, {"type": "subtitle", "time": 13444.63, "timestamp": "03:44:04", "text": "工作、兼职、学习、考试，"}, {"type": "subtitle", "time": 13447.91, "timestamp": "03:44:07", "text": "我所拥有的一切智慧，都只剩下这些了。"}, {"type": "subtitle", "time": 13450.07, "timestamp": "03:44:10", "text": "流媒体播放需要两到三个小时。"}, {"type": "subtitle", "time": 13452.469, "timestamp": "03:44:12", "text": "美好的。完全没问题。"}, {"type": "subtitle", "time": 13455.99, "timestamp": "03:44:15", "text": "而且我愿意尽我所能"}, {"type": "subtitle", "time": 13458.55, "timestamp": "03:44:18", "text": "是的，我一上线就会尽力直播。"}, {"type": "subtitle", "time": 13460.51, "timestamp": "03:44:20", "text": "日本作为"}, {"type": "subtitle", "time": 13463.99, "timestamp": "03:44:23", "text": "出色地。是的，那需要一段时间。"}, {"type": "subtitle", "time": 13466.229, "timestamp": "03:44:26", "text": "因此，在执行四个月的期限之后"}, {"type": "subtitle", "time": 13469.75, "timestamp": "03:44:29", "text": "关于jocknik Q1，我称之为Q1是因为它是"}, {"type": "subtitle", "time": 13473.309, "timestamp": "03:44:33", "text": "呃，这是该事件的第一阶段。"}, {"type": "subtitle", "time": 13477.429, "timestamp": "03:44:37", "text": "呃，这是本次活动的第一个问题。嗯，我们会有"}, {"type": "subtitle", "time": 13479.91, "timestamp": "03:44:39", "text": "这项捐款目标。如果我们有"}, {"type": "subtitle", "time": 13482.95, "timestamp": "03:44:42", "text": "没能在四小时内拿到这个"}, {"type": "subtitle", "time": 13485.269, "timestamp": "03:44:45", "text": "一个月的时间里，我将经历类似……"}, {"type": "subtitle", "time": 13487.91, "timestamp": "03:44:47", "text": "长期捐赠目标之类的。患病的"}, {"type": "subtitle", "time": 13490.469, "timestamp": "03:44:50", "text": "保持打开状态。好的，它会在每个"}, {"type": "subtitle", "time": 13492.229, "timestamp": "03:44:52", "text": "溪流。即使我只直播一两个小时"}, {"type": "subtitle", "time": 13495.51, "timestamp": "03:44:55", "text": "最多几个小时。是的，我能做到这些。"}, {"type": "subtitle", "time": 13498.469, "timestamp": "03:44:58", "text": "说。回到我的重要话题。"}]
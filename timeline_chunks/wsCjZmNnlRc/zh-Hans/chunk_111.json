[{"type": "subtitle", "time": 6665.189, "timestamp": "01:51:05", "text": "[音乐]"}, {"type": "subtitle", "time": 6668.43, "timestamp": "01:51:08", "text": "好的，抱歉。我忘了静音。"}, {"type": "subtitle", "time": 6678.629, "timestamp": "01:51:18", "text": "浴缸。正确的。正确的。至少你知道"}, {"type": "subtitle", "time": 6680.51, "timestamp": "01:51:20", "text": "与此不同"}, {"type": "subtitle", "time": 6683.229, "timestamp": "01:51:23", "text": "有些，或者我看到你"}, {"type": "subtitle", "time": 6707.629, "timestamp": "01:51:47", "text": "就像每当……就像如果你要……"}, {"type": "subtitle", "time": 6717.83, "timestamp": "01:51:57", "text": "嗯，是的，幻影和其他任何列表一样"}, {"type": "subtitle", "time": 6719.99, "timestamp": "01:51:59", "text": "你把自己列入名单的地方或者"}]
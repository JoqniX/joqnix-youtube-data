[{"type": "subtitle", "time": 14162.229, "timestamp": "03:56:02", "text": "你懒惰，你知道你得努力工作。"}, {"type": "subtitle", "time": 14166.63, "timestamp": "03:56:06", "text": "即使只花一卢比或一美元，也能好好吃饭。"}, {"type": "subtitle", "time": 14169.429, "timestamp": "03:56:09", "text": "或者像最小的量一样，意味着"}, {"type": "subtitle", "time": 14173.91, "timestamp": "03:56:13", "text": "很多，太多了，对吧？是的。和"}, {"type": "subtitle", "time": 14176.55, "timestamp": "03:56:16", "text": "这个数额太大了。我知道。我"}, {"type": "subtitle", "time": 14179.79, "timestamp": "03:56:19", "text": "可能会买太多iPhone，或者"}, {"type": "subtitle", "time": 14192.389, "timestamp": "03:56:32", "text": "呃，我知道我很自私。"}, {"type": "subtitle", "time": 14201.03, "timestamp": "03:56:41", "text": "梦想。我从很多人那里都听到过这种说法。"}, {"type": "subtitle", "time": 14202.83, "timestamp": "03:56:42", "text": "朋友们。呃"}, {"type": "subtitle", "time": 14205.75, "timestamp": "03:56:45", "text": "你真的想这么做吗？"}, {"type": "subtitle", "time": 14208.11, "timestamp": "03:56:48", "text": "一切？你能做到吗？"}, {"type": "subtitle", "time": 14211.83, "timestamp": "03:56:51", "text": "包括它和所有的一切？当时有很多疑问。"}, {"type": "subtitle", "time": 14213.63, "timestamp": "03:56:53", "text": "因此"}, {"type": "subtitle", "time": 14216.229, "timestamp": "03:56:56", "text": "许多。我想证明他们错了。我"}, {"type": "subtitle", "time": 14218.389, "timestamp": "03:56:58", "text": "我想证明我能做到这一点"}]
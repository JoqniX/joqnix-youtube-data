[{"type": "subtitle", "time": 1021.509, "timestamp": "00:17:01", "text": "大家都在通过观看来了解情况。哦，"}, {"type": "subtitle", "time": 1023.11, "timestamp": "00:17:03", "text": "等待。"}, {"type": "subtitle", "time": 1026.15, "timestamp": "00:17:06", "text": "我觉得他们不会说话，对吧？"}, {"type": "subtitle", "time": 1029.029, "timestamp": "00:17:09", "text": "哦，只是一些片段而已。就是这样"}, {"type": "subtitle", "time": 1031.669, "timestamp": "00:17:11", "text": "片段。是的。哦，是的。我确实得到了"}, {"type": "subtitle", "time": 1033.51, "timestamp": "00:17:13", "text": "和他们谈谈。我想见"}, {"type": "subtitle", "time": 1035.27, "timestamp": "00:17:15", "text": "如果你不介意的话，可以介绍一下他们。它"}, {"type": "subtitle", "time": 1037.51, "timestamp": "00:17:17", "text": "如果能有个中国……那就太好了。"}, {"type": "subtitle", "time": 1040.549, "timestamp": "00:17:20", "text": "如果我成为我播客的内容创作者的话"}, {"type": "subtitle", "time": 1042.549, "timestamp": "00:17:22", "text": "决定"}, {"type": "subtitle", "time": 1045.51, "timestamp": "00:17:25", "text": "我觉得重现它会很酷。"}, {"type": "subtitle", "time": 1047.029, "timestamp": "00:17:27", "text": "你觉得如果我这样做会很好吗？"}, {"type": "subtitle", "time": 1049.19, "timestamp": "00:17:29", "text": "重新启动了那个未命名的播客，然后"}, {"type": "subtitle", "time": 1053.59, "timestamp": "00:17:33", "text": "尝试找中国虚拟主播？是啊，为什么？"}, {"type": "subtitle", "time": 1059.029, "timestamp": "00:17:39", "text": "是啊，为什么不呢？"}, {"type": "subtitle", "time": 1065.789, "timestamp": "00:17:45", "text": "是的，他们是"}, {"type": "subtitle", "time": 1069.39, "timestamp": "00:17:49", "text": "英语不太好，但是……"}, {"type": "subtitle", "time": 1072.39, "timestamp": "00:17:52", "text": "可以理解，比如可以交流"}, {"type": "subtitle", "time": 1074.87, "timestamp": "00:17:54", "text": "一点。是的。"}, {"type": "subtitle", "time": 1076.71, "timestamp": "00:17:56", "text": "不，我之所以说“修女”，是因为"}, {"type": "subtitle", "time": 1078.71, "timestamp": "00:17:58", "text": "因为从技术上讲，这是我的事"}]
[{"type": "subtitle", "time": 12902.63, "timestamp": "03:35:02", "text": "嗯，是的，这些年来一直如此"}, {"type": "subtitle", "time": 12904.99, "timestamp": "03:35:04", "text": "我收到了无数的"}, {"type": "subtitle", "time": 12907.269, "timestamp": "03:35:07", "text": "机会和预期机会"}, {"type": "subtitle", "time": 12910.67, "timestamp": "03:35:10", "text": "我从未希望我能得到"}, {"type": "subtitle", "time": 12914.63, "timestamp": "03:35:14", "text": "我自己，即使事情进展顺利"}, {"type": "subtitle", "time": 12917.63, "timestamp": "03:35:17", "text": "有些地方它没去，有些地方它没去。"}, {"type": "subtitle", "time": 12921.79, "timestamp": "03:35:21", "text": "但我想要为自己而战"}, {"type": "subtitle", "time": 12925.91, "timestamp": "03:35:25", "text": "梦想，是的，现在有了一个模型"}, {"type": "subtitle", "time": 12929.19, "timestamp": "03:35:29", "text": "这是我努力创作的作品"}, {"type": "subtitle", "time": 12931.55, "timestamp": "03:35:31", "text": "它既独特又漂亮"}, {"type": "subtitle", "time": 12935.67, "timestamp": "03:35:35", "text": "有可能，但很遗憾，我不能给你看。"}, {"type": "subtitle", "time": 12938.309, "timestamp": "03:35:38", "text": "那些做模特的人，因为现在还不是模特。"}, {"type": "subtitle", "time": 12941.71, "timestamp": "03:35:41", "text": "一切就绪，但由于……"}, {"type": "subtitle", "time": 12946.07, "timestamp": "03:35:46", "text": "东西，还有索具，我只是"}, {"type": "subtitle", "time": 12948.87, "timestamp": "03:35:48", "text": "发起这次 Joathon 活动是为了筹集资金。"}, {"type": "subtitle", "time": 12951.229, "timestamp": "03:35:51", "text": "索具部分"}, {"type": "subtitle", "time": 12953.55, "timestamp": "03:35:53", "text": "它"}, {"type": "subtitle", "time": 12957.83, "timestamp": "03:35:57", "text": "是的。或者，如果可能的话，"}]
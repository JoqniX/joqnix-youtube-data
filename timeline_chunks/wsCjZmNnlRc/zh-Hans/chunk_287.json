[{"type": "subtitle", "time": 17222.35, "timestamp": "04:47:02", "text": "不。哦，那是一个"}, {"type": "subtitle", "time": 17226.47, "timestamp": "04:47:06", "text": "僵尸。荷兰语。等等，所以僵尸是"}, {"type": "subtitle", "time": 17228.788, "timestamp": "04:47:08", "text": "这里有吗？我当时想……"}, {"type": "subtitle", "time": 17230.59, "timestamp": "04:47:10", "text": "自由"}, {"type": "subtitle", "time": 17233.99, "timestamp": "04:47:13", "text": "僵尸就像“我的天哪，那简直太可怕了”"}, {"type": "subtitle", "time": 17244.948, "timestamp": "04:47:24", "text": "不。那个地方看起来有人住。"}, {"type": "subtitle", "time": 17266.55, "timestamp": "04:47:46", "text": "好的。你好呀。"}, {"type": "subtitle", "time": 17268.47, "timestamp": "04:47:48", "text": "你想要什么？我需要和……谈谈"}, {"type": "subtitle", "time": 17271.19, "timestamp": "04:47:51", "text": "负责人。我来自哈兰。哦，"}, {"type": "subtitle", "time": 17274.47, "timestamp": "04:47:54", "text": "你是个走私犯。你为那个骗子工作？"}, {"type": "subtitle", "time": 17276.07, "timestamp": "04:47:56", "text": "WHO？你看，我对这方面一无所知。"}, {"type": "subtitle", "time": 17277.83, "timestamp": "04:47:57", "text": "任何走私行为，伙计。我来这里只是因为我需要"}]
[{"type": "subtitle", "time": 1620.31, "timestamp": "00:27:00", "text": "事物。你最近在忙些什么呢？"}, {"type": "subtitle", "time": 1623.909, "timestamp": "00:27:03", "text": "生活如何？读研。读研。"}, {"type": "subtitle", "time": 1627.19, "timestamp": "00:27:07", "text": "等等，我还以为你已经结束了"}, {"type": "subtitle", "time": 1630.31, "timestamp": "00:27:10", "text": "毕业之类的。"}, {"type": "subtitle", "time": 1632.149, "timestamp": "00:27:12", "text": "是的，我刚从我的大学毕业。"}, {"type": "subtitle", "time": 1634.909, "timestamp": "00:27:14", "text": "硕士。"}, {"type": "chat", "time": 1643.956, "timestamp": "00:27:23", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "I'm from USA born and raised.but I grew up in martial arts.warrior culture transcend boundary lines. I had trained from Japan China Philippines Korea etc. so my instructors taught me of other cultures"}, {"type": "subtitle", "time": 1644.149, "timestamp": "00:27:24", "text": "是的，我还没有，我还没有直播过。"}, {"type": "subtitle", "time": 1647.269, "timestamp": "00:27:27", "text": "天气很热，因为呃，我本来打算……"}, {"type": "subtitle", "time": 1649.83, "timestamp": "00:27:29", "text": "研究生院。"}, {"type": "subtitle", "time": 1659.35, "timestamp": "00:27:39", "text": "我从小就练习武术。你来自"}, {"type": "subtitle", "time": 1661.83, "timestamp": "00:27:41", "text": "在美国出生长大，但我成长于……"}, {"type": "subtitle", "time": 1664.95, "timestamp": "00:27:44", "text": "武术武士文化超越"}, {"type": "subtitle", "time": 1666.87, "timestamp": "00:27:46", "text": "边界线。我曾接受过训练"}, {"type": "subtitle", "time": 1670.19, "timestamp": "00:27:50", "text": "日本、中国、菲律宾"}, {"type": "subtitle", "time": 1674.07, "timestamp": "00:27:54", "text": "呃，韩国等等。所以我的老师们"}, {"type": "subtitle", "time": 1676.789, "timestamp": "00:27:56", "text": "它让我了解了其他文化。在哪里？"}]
[{"type": "subtitle", "time": 18427.39, "timestamp": "05:07:07", "text": "哦，你的婴儿车被……"}, {"type": "subtitle", "time": 18429.91, "timestamp": "05:07:09", "text": "已召回。哦，就像你可以保留你的"}, {"type": "subtitle", "time": 18433.27, "timestamp": "05:07:13", "text": "想去哪儿就去哪儿，就像你一样"}, {"type": "subtitle", "time": 18435.868, "timestamp": "05:07:15", "text": "真的可以直接开车"}, {"type": "subtitle", "time": 18438.51, "timestamp": "05:07:18", "text": "进入"}, {"type": "subtitle", "time": 18443.11, "timestamp": "05:07:23", "text": "驾驶。哦，那真酷。"}, {"type": "subtitle", "time": 18451.67, "timestamp": "05:07:31", "text": "上帝。你知道，最好还是不要这样做。"}, {"type": "subtitle", "time": 18454.55, "timestamp": "05:07:34", "text": "用手推车，因为你必须继续前进。"}, {"type": "subtitle", "time": 18457.35, "timestamp": "05:07:37", "text": "如果它还在的话，就继续修理之类的。"}, {"type": "subtitle", "time": 18459.628, "timestamp": "05:07:39", "text": "另一辆普通的车。"}, {"type": "subtitle", "time": 18464.75, "timestamp": "05:07:44", "text": "不，我认为你能够正常驾驶。"}, {"type": "subtitle", "time": 18468.03, "timestamp": "05:07:48", "text": "车辆。我也这么认为。不知道"}, {"type": "subtitle", "time": 18477.03, "timestamp": "05:07:57", "text": "那也很好，等等，我"}, {"type": "subtitle", "time": 18479.27, "timestamp": "05:07:59", "text": "别以为他们会让你这么做的。等待，"}]
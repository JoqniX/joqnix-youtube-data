[{"type": "subtitle", "time": 18300.31, "timestamp": "05:05:00", "text": "能。但我没有螺丝。"}, {"type": "subtitle", "time": 18314.708, "timestamp": "05:05:14", "text": "地方。我们得深入了解一下。哦，是的"}, {"type": "subtitle", "time": 18317.59, "timestamp": "05:05:17", "text": "那是AA。好的。你正在查看"}, {"type": "subtitle", "time": 18321.27, "timestamp": "05:05:21", "text": "为汗。他走了。我猜他们"}, {"type": "subtitle", "time": 18324.15, "timestamp": "05:05:24", "text": "最后我请他离开。请他"}, {"type": "subtitle", "time": 18326.27, "timestamp": "05:05:26", "text": "走了吗？唐尼。朗尼。什么？在"}, {"type": "subtitle", "time": 18329.59, "timestamp": "05:05:29", "text": "枪指着你。他们是谁？他们终于"}, {"type": "subtitle", "time": 18331.11, "timestamp": "05:05:31", "text": "我做了我父亲应该做的事。"}, {"type": "subtitle", "time": 18333.03, "timestamp": "05:05:33", "text": "很久以前。如果事情进展顺利，"}, {"type": "subtitle", "time": 18335.51, "timestamp": "05:05:35", "text": "这里很安静，一个人，周围很安静，没有。"}, {"type": "subtitle", "time": 18337.11, "timestamp": "05:05:37", "text": "它？"}, {"type": "subtitle", "time": 18339.03, "timestamp": "05:05:39", "text": "你没有回答我的问题。当然"}, {"type": "subtitle", "time": 18341.35, "timestamp": "05:05:41", "text": "我没有。你来这里也是为了同样的原因"}, {"type": "subtitle", "time": 18343.75, "timestamp": "05:05:43", "text": "他之所以在那里，原因就在这里。强盗们也是出于同样的原因。"}, {"type": "subtitle", "time": 18345.91, "timestamp": "05:05:45", "text": "不会放过我们。我们应该"}, {"type": "subtitle", "time": 18347.91, "timestamp": "05:05:47", "text": "信任你。肯定有"}, {"type": "subtitle", "time": 18349.75, "timestamp": "05:05:49", "text": "我可以做些什么来说服你。"}, {"type": "subtitle", "time": 18352.19, "timestamp": "05:05:52", "text": "你得说服我。我不"}, {"type": "subtitle", "time": 18354.628, "timestamp": "05:05:54", "text": "关心。向其他人表明你来此的目的"}, {"type": "subtitle", "time": 18357.91, "timestamp": "05:05:57", "text": "给予，而不仅仅是索取。我是Esi"}]
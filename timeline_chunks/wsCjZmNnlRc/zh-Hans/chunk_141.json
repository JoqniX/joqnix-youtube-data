[{"type": "subtitle", "time": 8460.79, "timestamp": "02:21:00", "text": "拥有魔法力量的200岁少女。"}, {"type": "subtitle", "time": 8462.63, "timestamp": "02:21:02", "text": "在这里，我们可以创造自己的现实，"}, {"type": "subtitle", "time": 8464.55, "timestamp": "02:21:04", "text": "德里人说，这里很美。哦，等等，"}, {"type": "subtitle", "time": 8467.99, "timestamp": "02:21:07", "text": "她是一位来自德里的创作者。"}, {"type": "subtitle", "time": 8469.429, "timestamp": "02:21:09", "text": "我其实有一些来自德里的朋友。"}, {"type": "subtitle", "time": 8472.23, "timestamp": "02:21:12", "text": "也一样。创作者要么设计他们的"}, {"type": "subtitle", "time": 8475.03, "timestamp": "02:21:15", "text": "化身，也称为模型，或"}, {"type": "subtitle", "time": 8477.11, "timestamp": "02:21:17", "text": "委托艺术家和动画师"}, {"type": "subtitle", "time": 8479.349, "timestamp": "02:21:19", "text": "设计和创建 2D 或 3D 模型"}, {"type": "subtitle", "time": 8481.83, "timestamp": "02:21:21", "text": "这些模型的各种版本。这些模型是"}, {"type": "subtitle", "time": 8484.63, "timestamp": "02:21:24", "text": "日式动漫风格设计，或者等等"}, {"type": "subtitle", "time": 8488.07, "timestamp": "02:21:28", "text": "等等等等。 19岁的创作者VT Romeo"}, {"type": "subtitle", "time": 8490.11, "timestamp": "02:21:30", "text": "一个头像"}, {"type": "subtitle", "time": 8493.27, "timestamp": "02:21:33", "text": "半人半魔，设计"}, {"type": "subtitle", "time": 8496.15, "timestamp": "02:21:36", "text": "10款车型。什么？他们赚了2000"}, {"type": "subtitle", "time": 8497.79, "timestamp": "02:21:37", "text": "喜欢"}, {"type": "subtitle", "time": 8501.469, "timestamp": "02:21:41", "text": "1700人靠制作模型谋生。我的天啊。"}, {"type": "subtitle", "time": 8509.74, "timestamp": "02:21:49", "text": "这有点太便宜了。"}, {"type": "subtitle", "time": 8512.15, "timestamp": "02:21:52", "text": "[音乐]"}, {"type": "subtitle", "time": 8514.469, "timestamp": "02:21:54", "text": "阿凡达用自己的声音说话。甚至"}]
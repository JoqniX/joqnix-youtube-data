[{"type": "subtitle", "time": 16621.109, "timestamp": "04:37:01", "text": "我。你说他谈到了魔法，"}, {"type": "subtitle", "time": 16625.109, "timestamp": "04:37:05", "text": "什么？驯服的僵尸。"}, {"type": "subtitle", "time": 16630.709, "timestamp": "04:37:10", "text": "他谈到了一群人，他们"}, {"type": "subtitle", "time": 16632.869, "timestamp": "04:37:12", "text": "不要被感染。即使他们是"}, {"type": "subtitle", "time": 16636.551, "timestamp": "04:37:16", "text": "被咬过的人什么话都说得出口。"}, {"type": "subtitle", "time": 16638.31, "timestamp": "04:37:18", "text": "他手里拿着这个。还有，情况如何？"}, {"type": "subtitle", "time": 16642.23, "timestamp": "04:37:22", "text": "现在有声音了吗？哇。这看起来像是一种方法"}, {"type": "subtitle", "time": 16645.029, "timestamp": "04:37:25", "text": "出自哈尔。"}, {"type": "subtitle", "time": 16647.51, "timestamp": "04:37:27", "text": "我们的防蚁剂快用完了。我们必须"}, {"type": "subtitle", "time": 16650.551, "timestamp": "04:37:30", "text": "探索每一种可能性。"}, {"type": "subtitle", "time": 16653.189, "timestamp": "04:37:33", "text": "哦，我们要出去玩。等待任何"}, {"type": "subtitle", "time": 16658.349, "timestamp": "04:37:38", "text": "更长。 Rain，我们走吧。我喜欢这一点。"}, {"type": "subtitle", "time": 16661.029, "timestamp": "04:37:41", "text": "孤独。耶。"}, {"type": "subtitle", "time": 16663.91, "timestamp": "04:37:43", "text": "远离这里。远离这里。你没有"}, {"type": "subtitle", "time": 16667.99, "timestamp": "04:37:47", "text": "理解。母亲。母亲。"}, {"type": "subtitle", "time": 16674.109, "timestamp": "04:37:54", "text": "母亲。母亲"}]
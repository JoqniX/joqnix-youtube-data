[{"type": "subtitle", "time": 7201.599, "timestamp": "02:00:01", "text": "前。 真吻。"}, {"type": "subtitle", "time": 7204.239, "timestamp": "02:00:04", "text": "真吻。 是的。你能想象现实生活中的我吗？"}, {"type": "subtitle", "time": 7206.08, "timestamp": "02:00:06", "text": "是的。你能想象现实生活中的我吗？ 做飞吻吗？"}, {"type": "subtitle", "time": 7215.109, "timestamp": "02:00:15", "text": "[音乐]"}, {"type": "subtitle", "time": 7217.189, "timestamp": "02:00:17", "text": "所以，我相信你一定能看出我是一个"}, {"type": "subtitle", "time": 7233.79, "timestamp": "02:00:33", "text": "[音乐]"}, {"type": "subtitle", "time": 7236.35, "timestamp": "02:00:36", "text": "是？是的。"}, {"type": "subtitle", "time": 7241.109, "timestamp": "02:00:41", "text": "呃，再次道歉。嗯，方式"}, {"type": "subtitle", "time": 7243.91, "timestamp": "02:00:43", "text": "我太困了，就像当我……"}, {"type": "subtitle", "time": 7246.55, "timestamp": "02:00:46", "text": "现在我闭上眼睛，感觉就像在做梦一样。"}, {"type": "subtitle", "time": 7249.03, "timestamp": "02:00:49", "text": "然后我听到你说话，我就想等等，我"}, {"type": "subtitle", "time": 7252.91, "timestamp": "02:00:52", "text": "仍处于合作的余韵中"}, {"type": "subtitle", "time": 7255.83, "timestamp": "02:00:55", "text": "说出一些轻佻的话来博取好感"}, {"type": "subtitle", "time": 7258.55, "timestamp": "02:00:58", "text": "让自己醒过来。好的，"}]
[{"type": "subtitle", "time": 7443.03, "timestamp": "02:04:03", "text": "约瑟夫·乔纳森·乔尔。等待。哦，等等。"}, {"type": "subtitle", "time": 7444.55, "timestamp": "02:04:04", "text": "对不起。我不小心说了你的全部"}, {"type": "subtitle", "time": 7459.55, "timestamp": "02:04:19", "text": "是的，你是"}, {"type": "subtitle", "time": 7479.189, "timestamp": "02:04:39", "text": "如果你有蒸汽，我们就可以……"}, {"type": "subtitle", "time": 7482.31, "timestamp": "02:04:42", "text": "播放了Chop Cara的某首歌，因为它"}, {"type": "subtitle", "time": 7484.229, "timestamp": "02:04:44", "text": "本来应该有的，因为我们还在讨论。"}, {"type": "chat", "time": 7486.034, "timestamp": "02:04:46", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "funny story. I was in judocpass and had no partner. a random girl. jumped up smiling saying she'd spar with me. smiling tiny. I could pet her like a good doggy. I asked \"are your sure?\""}, {"type": "subtitle", "time": 7486.55, "timestamp": "02:04:46", "text": "现在正在通话。我可能变得无聊了"}, {"type": "subtitle", "time": 7489.51, "timestamp": "02:04:49", "text": "给你之类的。所以我认为我们"}, {"type": "subtitle", "time": 7491.109, "timestamp": "02:04:51", "text": "本来可以演奏点什么，但一切都结束了。"}, {"type": "subtitle", "time": 7493.91, "timestamp": "02:04:53", "text": "触及之神。"}, {"type": "subtitle", "time": 7496.709, "timestamp": "02:04:56", "text": "哦，不好意思，我当时在J组，没有搭档。"}, {"type": "subtitle", "time": 7499.03, "timestamp": "02:04:59", "text": "一个陌生女孩笑着跳了起来，"}]
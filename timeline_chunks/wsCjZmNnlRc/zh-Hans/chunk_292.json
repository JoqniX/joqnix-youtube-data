[{"type": "subtitle", "time": 17522.39, "timestamp": "04:52:02", "text": "你知道，就是病毒。我喜欢他"}, {"type": "subtitle", "time": 17524.868, "timestamp": "04:52:04", "text": "她喜欢用手势打信号，"}, {"type": "subtitle", "time": 17527.55, "timestamp": "04:52:07", "text": "手势实际上"}, {"type": "subtitle", "time": 17530.39, "timestamp": "04:52:10", "text": "把一个由某个女人领导的邪教组织变成一个该死的邪教"}, {"type": "subtitle", "time": 17532.708, "timestamp": "04:52:12", "text": "他们称母亲过去只是一个"}, {"type": "subtitle", "time": 17535.03, "timestamp": "04:52:15", "text": "你知道，这是无害的地方传统。"}, {"type": "subtitle", "time": 17538.07, "timestamp": "04:52:18", "text": "他们对此并不认真，好吧，他们是"}, {"type": "subtitle", "time": 17540.868, "timestamp": "04:52:20", "text": "最近真是太严肃了，自从"}, {"type": "subtitle", "time": 17542.628, "timestamp": "04:52:22", "text": "暴发"}, {"type": "subtitle", "time": 17545.708, "timestamp": "04:52:25", "text": "这些符号到处都是，真是他妈的。"}, {"type": "subtitle", "time": 17548.07, "timestamp": "04:52:28", "text": "仪式，我想他们甚至把它写成一个"}, {"type": "subtitle", "time": 17555.39, "timestamp": "04:52:35", "text": "中心还是什么？"}, {"type": "subtitle", "time": 17558.708, "timestamp": "04:52:38", "text": "听着，我现在缺个人，而且自从"}, {"type": "subtitle", "time": 17561.67, "timestamp": "04:52:41", "text": "我是一名企业家，咱们来做生意吧。"}, {"type": "subtitle", "time": 17565.19, "timestamp": "04:52:45", "text": "我们俩结成伙伴。买任何东西，"}, {"type": "subtitle", "time": 17571.99, "timestamp": "04:52:51", "text": "好的，他到那里是为了听取双方的意见。"}, {"type": "subtitle", "time": 17575.11, "timestamp": "04:52:55", "text": "我们的对话。真是个逝者。什么"}, {"type": "subtitle", "time": 17577.91, "timestamp": "04:52:57", "text": "有点像狐狸。我的天啊。我可以展示"}, {"type": "subtitle", "time": 17579.91, "timestamp": "04:52:59", "text": "给你一些可能对你有帮助的东西"}]
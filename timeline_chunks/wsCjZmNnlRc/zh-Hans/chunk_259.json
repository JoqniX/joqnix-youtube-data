[{"type": "subtitle", "time": 15541.75, "timestamp": "04:19:01", "text": "我想做一个30分钟的公告"}, {"type": "subtitle", "time": 15544.95, "timestamp": "04:19:04", "text": "但最后大概过了1个小时左右。"}, {"type": "subtitle", "time": 15548.149, "timestamp": "04:19:08", "text": "感谢所有锁定的人"}, {"type": "subtitle", "time": 15550.87, "timestamp": "04:19:10", "text": "积极与即将前往的人聊天"}, {"type": "subtitle", "time": 15553.03, "timestamp": "04:19:13", "text": "请观看这个公告。"}, {"type": "subtitle", "time": 15557.03, "timestamp": "04:19:17", "text": "未来亦是如此。谢谢大家"}, {"type": "subtitle", "time": 15559.429, "timestamp": "04:19:19", "text": "感谢所有参加音乐会的人"}, {"type": "subtitle", "time": 15563.51, "timestamp": "04:19:23", "text": "那些相信我的人和盘子"}, {"type": "subtitle", "time": 15566.55, "timestamp": "04:19:26", "text": "相信我，并且愿意付出"}, {"type": "subtitle", "time": 15568.349, "timestamp": "04:19:28", "text": "相信我"}, {"type": "subtitle", "time": 15573.269, "timestamp": "04:19:33", "text": "再次。谢谢。我很高兴我现在在这里。"}, {"type": "subtitle", "time": 15576.469, "timestamp": "04:19:36", "text": "而且能够直播，能够做我该做的事"}, {"type": "subtitle", "time": 15581.309, "timestamp": "04:19:41", "text": "可以做到，能够追赶我的"}, {"type": "subtitle", "time": 15584.469, "timestamp": "04:19:44", "text": "我怀揣梦想，希望能够激励他人。"}, {"type": "subtitle", "time": 15587.309, "timestamp": "04:19:47", "text": "你在自己的梦里。"}, {"type": "subtitle", "time": 15590.71, "timestamp": "04:19:50", "text": "好吧，因为我真正的旅程，我想"}, {"type": "subtitle", "time": 15593.83, "timestamp": "04:19:53", "text": "成为他人的榜样。这就是原因"}, {"type": "subtitle", "time": 15597.349, "timestamp": "04:19:57", "text": "我把脖子做得短，因为我想要我的声音"}]
[{"type": "subtitle", "time": 18720.35, "timestamp": "05:12:00", "text": "笨蛋，你忘了"}, {"type": "subtitle", "time": 18755.47, "timestamp": "05:12:35", "text": "盔甲。"}, {"type": "subtitle", "time": 18758.788, "timestamp": "05:12:38", "text": "死的。我打算用步枪护甲。"}, {"type": "subtitle", "time": 18760.67, "timestamp": "05:12:40", "text": "军队"}, {"type": "subtitle", "time": 18763.43, "timestamp": "05:12:43", "text": "步枪。是啊，我杀的越多这些"}, {"type": "subtitle", "time": 18766.99, "timestamp": "05:12:46", "text": "人们，我越不理解"}, {"type": "subtitle", "time": 18770.55, "timestamp": "05:12:50", "text": "弹药。所以，我主要就是在寻找这个。"}, {"type": "subtitle", "time": 18773.868, "timestamp": "05:12:53", "text": "我杀死那两个人的地方就在这里。"}, {"type": "subtitle", "time": 18776.55, "timestamp": "05:12:56", "text": "正确的？我找不到它们。我在哪里？"}, {"type": "subtitle", "time": 18778.43, "timestamp": "05:12:58", "text": "杀了那两个人"}]
[{"type": "subtitle", "time": 16323.429, "timestamp": "04:32:03", "text": "嗯，是的，1月8日至14日那一周。"}, {"type": "subtitle", "time": 16326.59, "timestamp": "04:32:06", "text": "那是我最后一天……"}, {"type": "subtitle", "time": 16331.67, "timestamp": "04:32:11", "text": "呃，我有没有做过类似这样的直播？"}, {"type": "subtitle", "time": 16334.07, "timestamp": "04:32:14", "text": "日程安排之类的。所以"}, {"type": "subtitle", "time": 16337.91, "timestamp": "04:32:17", "text": "昨天我有点……"}, {"type": "subtitle", "time": 16341.429, "timestamp": "04:32:21", "text": "被阻止或举起它，呃，修复一些"}, {"type": "subtitle", "time": 16344.469, "timestamp": "04:32:24", "text": "直播一些内容，还有一些资产"}, {"type": "subtitle", "time": 16347.03, "timestamp": "04:32:27", "text": "东西。所以我花了几个小时来做​​这件事。"}, {"type": "subtitle", "time": 16349.03, "timestamp": "04:32:29", "text": "因为我不知道编程，所以……"}, {"type": "subtitle", "time": 16352.07, "timestamp": "04:32:32", "text": "Figma 的东西，小工具之类的。所以就这样"}, {"type": "subtitle", "time": 16355.03, "timestamp": "04:32:35", "text": "那样做会更容易些。是的"}, {"type": "subtitle", "time": 16357.91, "timestamp": "04:32:37", "text": "花了一段时间，所以我当时有点……"}, {"type": "subtitle", "time": 16361.189, "timestamp": "04:32:41", "text": "时间太晚了，所以我快速地把日程安排搞定了。"}, {"type": "subtitle", "time": 16363.67, "timestamp": "04:32:43", "text": "所以在Discord服务器上"}, {"type": "subtitle", "time": 16365.91, "timestamp": "04:32:45", "text": "大多数人不会参加节目安排频道。"}, {"type": "subtitle", "time": 16367.349, "timestamp": "04:32:47", "text": "能够查看日程频道"}, {"type": "subtitle", "time": 16370.229, "timestamp": "04:32:50", "text": "因为现在它是一个资源渠道。所以"}, {"type": "subtitle", "time": 16372.309, "timestamp": "04:32:52", "text": "点击服务器指南，你就可以获取……"}, {"type": "subtitle", "time": 16374.87, "timestamp": "04:32:54", "text": "您可以查看日程安排，而且"}]
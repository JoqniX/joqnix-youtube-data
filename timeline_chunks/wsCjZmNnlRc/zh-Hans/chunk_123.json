[{"type": "subtitle", "time": 7383.83, "timestamp": "02:03:03", "text": "哦，我想起来他叫什么名字了。曾是"}, {"type": "subtitle", "time": 7385.99, "timestamp": "02:03:05", "text": "大概是这样吗？"}, {"type": "subtitle", "time": 7388.229, "timestamp": "02:03:08", "text": "我的天啊。"}, {"type": "subtitle", "time": 7395.59, "timestamp": "02:03:15", "text": "请问您的名字是？"}, {"type": "subtitle", "time": 7398.189, "timestamp": "02:03:18", "text": "[笑声]"}, {"type": "subtitle", "time": 7401.35, "timestamp": "02:03:21", "text": "是的。我的天啊。"}, {"type": "subtitle", "time": 7404.31, "timestamp": "02:03:24", "text": "哇，你的记忆力真好。"}, {"type": "subtitle", "time": 7413.46, "timestamp": "02:03:33", "text": "哇。"}, {"type": "subtitle", "time": 7427.99, "timestamp": "02:03:47", "text": "呃，这位是乔纳森。"}, {"type": "subtitle", "time": 7429.589, "timestamp": "02:03:49", "text": "等等，我不该那么说。对不起。"}, {"type": "subtitle", "time": 7430.719, "timestamp": "02:03:50", "text": "对不起。 我们能出去吗？我们能出去吗？我们能出去吗？"}, {"type": "subtitle", "time": 7435.119, "timestamp": "02:03:55", "text": "我们能出去吗？我们能出去吗？我们能出去吗？ 我的天啊。"}]
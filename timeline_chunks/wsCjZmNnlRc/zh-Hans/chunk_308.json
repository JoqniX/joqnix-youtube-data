[{"type": "subtitle", "time": 18490.19, "timestamp": "05:08:10", "text": "这里。你会开车吗？"}, {"type": "subtitle", "time": 18494.628, "timestamp": "05:08:14", "text": "它？不，他们不允许。当然，"}, {"type": "subtitle", "time": 18497.11, "timestamp": "05:08:17", "text": "游戏希望你使用越野车，"}, {"type": "subtitle", "time": 18513.15, "timestamp": "05:08:33", "text": "事物？新地点标记"}, {"type": "subtitle", "time": 18525.39, "timestamp": "05:08:45", "text": "等待。是他吗？"}, {"type": "subtitle", "time": 18529.868, "timestamp": "05:08:49", "text": "离开？不，我不能，我不能，我也不能。"}]
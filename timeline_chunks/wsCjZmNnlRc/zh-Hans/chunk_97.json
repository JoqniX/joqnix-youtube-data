[{"type": "subtitle", "time": 5822.27, "timestamp": "01:37:02", "text": "[音乐]"}, {"type": "subtitle", "time": 5824.87, "timestamp": "01:37:04", "text": "有趣的。我确实整合了地狱"}, {"type": "subtitle", "time": 5826.55, "timestamp": "01:37:06", "text": "来自《黑礁》的歌手雷米。所以，我"}, {"type": "subtitle", "time": 5828.629, "timestamp": "01:37:08", "text": "我猜你就是我的妻子。我的意思是，是的。"}, {"type": "subtitle", "time": 5869.03, "timestamp": "01:37:49", "text": "头部。哦，有一个是蓝色的"}, {"type": "subtitle", "time": 5879.51, "timestamp": "01:37:59", "text": "不用担心。有很多动漫"}]
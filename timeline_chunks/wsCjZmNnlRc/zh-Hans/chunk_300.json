[{"type": "subtitle", "time": 18005.39, "timestamp": "05:00:05", "text": "我差点就明白了，但是它在哪里？"}, {"type": "subtitle", "time": 18007.63, "timestamp": "05:00:07", "text": "它？在那里"}, {"type": "subtitle", "time": 18023.788, "timestamp": "05:00:23", "text": "金属胶刹车片。等等，它"}, {"type": "subtitle", "time": 18027.19, "timestamp": "05:00:27", "text": "休息。这就是那辆破车。哦，我的"}, {"type": "subtitle", "time": 18029.59, "timestamp": "05:00:29", "text": "上帝。按住 E 键升级。这是你的"}, {"type": "subtitle", "time": 18033.15, "timestamp": "05:00:33", "text": "升级后出现故障。安装升级。代替"}, {"type": "subtitle", "time": 18035.99, "timestamp": "05:00:35", "text": "有缺陷。好的。呃，检查是否有升级或"}, {"type": "subtitle", "time": 18038.628, "timestamp": "05:00:38", "text": "将攻击力分配给激活按钮"}, {"type": "subtitle", "time": 18040.628, "timestamp": "05:00:40", "text": "顾客通过培训感受到痛苦。"}, {"type": "subtitle", "time": 18043.83, "timestamp": "05:00:43", "text": "好的。好的。好的。我已经买下了大部分"}, {"type": "subtitle", "time": 18044.59, "timestamp": "05:00:44", "text": "这"}, {"type": "subtitle", "time": 18049.75, "timestamp": "05:00:49", "text": "其中大部分是DLC。所以，忍者细胞"}, {"type": "subtitle", "time": 18054.948, "timestamp": "05:00:54", "text": "狂怒金属湿摇滚阵容"}, {"type": "subtitle", "time": 18058.948, "timestamp": "05:00:58", "text": "呃，我们应该带上太空探测车吗？"}]
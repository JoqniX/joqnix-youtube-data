[{"type": "subtitle", "time": 13563.11, "timestamp": "03:46:03", "text": "我把太多时间花在别人身上了，不是吗？"}, {"type": "subtitle", "time": 13567.389, "timestamp": "03:46:07", "text": "而不是专注于我自己"}, {"type": "subtitle", "time": 13570.15, "timestamp": "03:46:10", "text": "伙计们。有一次我差点"}, {"type": "subtitle", "time": 13573.269, "timestamp": "03:46:13", "text": "为了帮助他人，我牺牲了自己的社区。"}, {"type": "subtitle", "time": 13575.91, "timestamp": "03:46:15", "text": "把其他人的梦想也抛在脑后"}, {"type": "subtitle", "time": 13578.269, "timestamp": "03:46:18", "text": "一切，"}, {"type": "subtitle", "time": 13580.83, "timestamp": "03:46:20", "text": "正确的？"}, {"type": "subtitle", "time": 13582.83, "timestamp": "03:46:22", "text": "但是这样"}, {"type": "subtitle", "time": 13585.75, "timestamp": "03:46:25", "text": "我想要的时候，也曾有过那样的时光。"}, {"type": "subtitle", "time": 13588.63, "timestamp": "03:46:28", "text": "我当时几乎就要毕业了。"}, {"type": "subtitle", "time": 13589.63, "timestamp": "03:46:29", "text": "或给予"}, {"type": "subtitle", "time": 13593.83, "timestamp": "03:46:33", "text": "起来是因为我不知道自己能做什么。"}, {"type": "subtitle", "time": 13597.189, "timestamp": "03:46:37", "text": "我能做什么，以及我们所做的一切"}, {"type": "subtitle", "time": 13599.269, "timestamp": "03:46:39", "text": "那些问题我们都解决了。"}, {"type": "subtitle", "time": 13601.83, "timestamp": "03:46:41", "text": "在这些呃耳朵和"}, {"type": "subtitle", "time": 13605.03, "timestamp": "03:46:45", "text": "这些耳朵，我从帽子里回来了。"}, {"type": "subtitle", "time": 13606.71, "timestamp": "03:46:46", "text": "他说，这是一个新的篇章，"}, {"type": "subtitle", "time": 13607.79, "timestamp": "03:46:47", "text": "一切"}, {"type": "subtitle", "time": 13611.11, "timestamp": "03:46:51", "text": "对，我不想太消极。"}, {"type": "subtitle", "time": 13614.59, "timestamp": "03:46:54", "text": "这里但是是的强加者​​综合症"}, {"type": "subtitle", "time": 13618.87, "timestamp": "03:46:58", "text": "所以我要证明这一点。"}]
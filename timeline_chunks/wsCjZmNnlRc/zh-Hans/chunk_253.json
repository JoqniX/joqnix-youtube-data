[{"type": "subtitle", "time": 15181.269, "timestamp": "04:13:01", "text": "计划。我不会放弃我的梦想。"}, {"type": "subtitle", "time": 15183.429, "timestamp": "04:13:03", "text": "我不愿意鼓胀。我是"}, {"type": "subtitle", "time": 15185.91, "timestamp": "04:13:05", "text": "固执的。我很自私。我真是个笨蛋。我"}, {"type": "subtitle", "time": 15187.91, "timestamp": "04:13:07", "text": "知道。我不知道自己在做什么。我是"}, {"type": "subtitle", "time": 15189.79, "timestamp": "04:13:09", "text": "年轻的。我是"}, {"type": "subtitle", "time": 15193.91, "timestamp": "04:13:13", "text": "年纪大了。我衰老得更快，但我却不显老。"}, {"type": "subtitle", "time": 15195.95, "timestamp": "04:13:15", "text": "作为一种安慰。我"}, {"type": "subtitle", "time": 15200.71, "timestamp": "04:13:20", "text": "知道。我太幼稚了。但我愿意"}, {"type": "subtitle", "time": 15202.99, "timestamp": "04:13:22", "text": "看看这个"}, {"type": "subtitle", "time": 15205.67, "timestamp": "04:13:25", "text": "真的。不管你喜不喜欢，我"}, {"type": "subtitle", "time": 15213.99, "timestamp": "04:13:33", "text": "巴加。你好。所以，我希望……主要"}, {"type": "subtitle", "time": 15216.389, "timestamp": "04:13:36", "text": "现在信息已经明白了。是"}, {"type": "subtitle", "time": 15219.03, "timestamp": "04:13:39", "text": "参加 Joathon 活动。事件时间表如下："}, {"type": "subtitle", "time": 15222.99, "timestamp": "04:13:42", "text": "从3月12日到6月中旬，我"}, {"type": "subtitle", "time": 15227.469, "timestamp": "04:13:47", "text": "相信。 20岁、16岁或者其他什么数字。"}, {"type": "subtitle", "time": 15232.269, "timestamp": "04:13:52", "text": "嗯，安斯坦。不，我不是叔叔。我仍然"}, {"type": "subtitle", "time": 15235.229, "timestamp": "04:13:55", "text": "成人。我想我算是入选了。"}, {"type": "subtitle", "time": 15237.469, "timestamp": "04:13:57", "text": "我的，我在"}]
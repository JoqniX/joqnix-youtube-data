[{"type": "subtitle", "time": 17280.708, "timestamp": "04:48:00", "text": "求助。至于贾瑟，我不认识他。"}, {"type": "subtitle", "time": 17284.07, "timestamp": "04:48:04", "text": "请理解这一点。如果你偷东西，"}, {"type": "subtitle", "time": 17287.67, "timestamp": "04:48:07", "text": "你失去了双手。我的天啊。他是"}, {"type": "subtitle", "time": 17290.868, "timestamp": "04:48:10", "text": "一见到我就对我发出威胁。"}, {"type": "subtitle", "time": 17292.19, "timestamp": "04:48:12", "text": "不是凯。"}, {"type": "subtitle", "time": 17296.23, "timestamp": "04:48:16", "text": "然后你就进去了，我想。但是你我们"}, {"type": "subtitle", "time": 17299.91, "timestamp": "04:48:19", "text": "进不去。好的。 N"}, {"type": "subtitle", "time": 17303.11, "timestamp": "04:48:23", "text": "陌生人，我正盯着你呢。好的，"}, {"type": "subtitle", "time": 17305.35, "timestamp": "04:48:25", "text": "他吸引了我的目光。好的，允许这样做。原谅"}, {"type": "subtitle", "time": 17307.91, "timestamp": "04:48:27", "text": "我。我什么都不知道。你看，可能"}, {"type": "subtitle", "time": 17309.11, "timestamp": "04:48:29", "text": "你只要告诉我哪里能找到人就行了。"}, {"type": "subtitle", "time": 17311.67, "timestamp": "04:48:31", "text": "谁知道些什么？寻找"}, {"type": "subtitle", "time": 17313.83, "timestamp": "04:48:33", "text": "爵士乐手。他会在谷仓里。里面"}, {"type": "subtitle", "time": 17323.03, "timestamp": "04:48:43", "text": "谢谢，这就是纽带，对吧？你是"}, {"type": "subtitle", "time": 17325.03, "timestamp": "04:48:45", "text": "快点。我也跟你聊聊吧。"}, {"type": "subtitle", "time": 17327.99, "timestamp": "04:48:47", "text": "母亲蒙福。他身上有纹身"}, {"type": "subtitle", "time": 17330.07, "timestamp": "04:48:50", "text": "在他的胸口。听着，我只需要一些"}, {"type": "subtitle", "time": 17332.628, "timestamp": "04:48:52", "text": "信息。我什么都不知道。你"}, {"type": "subtitle", "time": 17335.83, "timestamp": "04:48:55", "text": "应该问问爵士乐。爵士乐。呃，好的。在哪里"}, {"type": "subtitle", "time": 17338.948, "timestamp": "04:48:58", "text": "我能找到他吗？在谷仓里面。在"}]
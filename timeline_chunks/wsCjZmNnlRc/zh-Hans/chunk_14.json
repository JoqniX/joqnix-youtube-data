[{"type": "subtitle", "time": 845.11, "timestamp": "00:14:05", "text": "我想，嗯，我认识他们的方式是……"}, {"type": "subtitle", "time": 847.43, "timestamp": "00:14:07", "text": "有趣的故事。我当时正在随意浏览网页。"}, {"type": "subtitle", "time": 849.99, "timestamp": "00:14:09", "text": "当年通过威利·比利"}, {"type": "subtitle", "time": 854.55, "timestamp": "00:14:14", "text": "比如找到可以和我聊天的人"}, {"type": "subtitle", "time": 857.43, "timestamp": "00:14:17", "text": "就像一个懂英语的人一样"}, {"type": "subtitle", "time": 858.949, "timestamp": "00:14:18", "text": "谁能教我如何使用这个平台？"}, {"type": "subtitle", "time": 861.189, "timestamp": "00:14:21", "text": "工作等等，然后我偶然发现了"}, {"type": "subtitle", "time": 863.75, "timestamp": "00:14:23", "text": "他们的频道是随机播放的，我注意到"}, {"type": "subtitle", "time": 865.509, "timestamp": "00:14:25", "text": "他们像看纪录片一样观看"}, {"type": "subtitle", "time": 868.87, "timestamp": "00:14:28", "text": "以及使用 VPN 在 YouTube 上观看视频。我当时"}, {"type": "subtitle", "time": 871.59, "timestamp": "00:14:31", "text": "就像，“等等，那里真的有人。”"}, {"type": "subtitle", "time": 874.389, "timestamp": "00:14:34", "text": "谁在用 YouTube 看 Billy 的视频？"}, {"type": "subtitle", "time": 876.87, "timestamp": "00:14:36", "text": "比利。”什么？等等，等等，等等，等等，"}, {"type": "subtitle", "time": 879.189, "timestamp": "00:14:39", "text": "等等，等等。这样做你不应该人肉搜索"}, {"type": "subtitle", "time": 881.43, "timestamp": "00:14:41", "text": "这个人，但是，呃，请告诉我什么"}, {"type": "subtitle", "time": 884.99, "timestamp": "00:14:44", "text": "他们的账号名称是：我是"}, {"type": "subtitle", "time": 886.99, "timestamp": "00:14:46", "text": "不是"}, {"type": "subtitle", "time": 889.47, "timestamp": "00:14:49", "text": "呃，中国人"}, {"type": "subtitle", "time": 893.59, "timestamp": "00:14:53", "text": "政府。我不该这么说。"}, {"type": "subtitle", "time": 895.43, "timestamp": "00:14:55", "text": "如果中国政府正在听取意见"}]
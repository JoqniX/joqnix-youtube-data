[{"type": "subtitle", "time": 600.389, "timestamp": "00:10:00", "text": "我完全能理解。"}, {"type": "subtitle", "time": 603.99, "timestamp": "00:10:03", "text": "你好。不用担心。不用担心。"}, {"type": "subtitle", "time": 606.47, "timestamp": "00:10:06", "text": "还有，如果你还没有……呃，如果你还没有"}, {"type": "subtitle", "time": 609.91, "timestamp": "00:10:09", "text": "花了大概1000美元，呃，请告诉我。"}, {"type": "subtitle", "time": 611.99, "timestamp": "00:10:11", "text": "请务必向 Jocknix 捐款，这样我们才能……"}, {"type": "subtitle", "time": 615.11, "timestamp": "00:10:15", "text": "Jocknik 的新模型和首秀或将亮相。"}, {"type": "subtitle", "time": 617.35, "timestamp": "00:10:17", "text": "顺便提一下，5美元等于2"}, {"type": "subtitle", "time": 619.509, "timestamp": "00:10:19", "text": "字幕等于 500 比特，这允许"}, {"type": "subtitle", "time": 628.79, "timestamp": "00:10:28", "text": "车轮。兄弟，我好想你。如何才能"}, {"type": "subtitle", "time": 632.949, "timestamp": "00:10:32", "text": "你最近怎么样？已经过去好久了。"}, {"type": "subtitle", "time": 635.03, "timestamp": "00:10:35", "text": "我一切都好。我经历过"}, {"type": "subtitle", "time": 639.829, "timestamp": "00:10:39", "text": "动漫，呃，动漫体验，呃，或者"}, {"type": "subtitle", "time": 642.949, "timestamp": "00:10:42", "text": "漫画体验。嗯，是的，我有"}, {"type": "subtitle", "time": 645.829, "timestamp": "00:10:45", "text": "我有很多故事可以分享。"}, {"type": "subtitle", "time": 647.31, "timestamp": "00:10:47", "text": "我们开始吧"}, {"type": "subtitle", "time": 650.15, "timestamp": "00:10:50", "text": "去。是的。我们上一次是什么时候？"}, {"type": "subtitle", "time": 655.509, "timestamp": "00:10:55", "text": "说话的语气和很久以前很多人一样，对吧？"}, {"type": "subtitle", "time": 658.11, "timestamp": "00:10:58", "text": "让我看看我们上次通话是什么时候。"}]
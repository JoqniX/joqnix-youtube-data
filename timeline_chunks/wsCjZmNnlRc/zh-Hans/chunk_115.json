[{"type": "subtitle", "time": 6907.43, "timestamp": "01:55:07", "text": "再次声明，我对这方面了解不多。"}, {"type": "subtitle", "time": 6910.39, "timestamp": "01:55:10", "text": "好久没看动漫了。为什么是"}, {"type": "subtitle", "time": 6913.99, "timestamp": "01:55:13", "text": "最近一次看的动画？"}, {"type": "subtitle", "time": 6916.709, "timestamp": "01:55:16", "text": "我不记得了，但我确实会看。"}, {"type": "subtitle", "time": 6919.589, "timestamp": "01:55:19", "text": "哦，棒球场动漫那一个是"}, {"type": "subtitle", "time": 6939.149, "timestamp": "01:55:39", "text": "球，好多动漫"}, {"type": "subtitle", "time": 6942.149, "timestamp": "01:55:42", "text": "现在。你是如何跟上这一切的？我"}, {"type": "subtitle", "time": 6945.589, "timestamp": "01:55:45", "text": "根本跟不上。"}, {"type": "subtitle", "time": 6950.47, "timestamp": "01:55:50", "text": "我对此有感觉。跟不上新潮流"}, {"type": "subtitle", "time": 6953.39, "timestamp": "01:55:53", "text": "动漫就是烟雾。"}]
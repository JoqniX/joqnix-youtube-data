[{"type": "subtitle", "time": 6841.07, "timestamp": "01:54:01", "text": "Doobie Hero X是什么？呃，是"}, {"type": "subtitle", "time": 6846.149, "timestamp": "01:54:06", "text": "这是一部很有趣的动漫，你会从中获得"}, {"type": "subtitle", "time": 6848.709, "timestamp": "01:54:08", "text": "那里就像一座塔一样。"}, {"type": "subtitle", "time": 6851.35, "timestamp": "01:54:11", "text": "攀岩之类的活动。想象一下如果是"}, {"type": "subtitle", "time": 6854.47, "timestamp": "01:54:14", "text": "一款你必须扮演……的电子游戏"}, {"type": "subtitle", "time": 6858.31, "timestamp": "01:54:18", "text": "第一。它们就像是按排名排列的。"}, {"type": "subtitle", "time": 6862.95, "timestamp": "01:54:22", "text": "英雄之类的东西，或者排名第一的第 15 位。"}, {"type": "subtitle", "time": 6866.669, "timestamp": "01:54:26", "text": "想想NF最想抓到的人。"}, {"type": "subtitle", "time": 6869.75, "timestamp": "01:54:29", "text": "字面上地。所以，与其说是动漫，不如说是动画。"}, {"type": "subtitle", "time": 6872.79, "timestamp": "01:54:32", "text": "以主角的视角进行刻画"}, {"type": "subtitle", "time": 6875.35, "timestamp": "01:54:35", "text": "从角色视角来看，它提供了一种"}, {"type": "subtitle", "time": 6878.709, "timestamp": "01:54:38", "text": "每个最受欢迎人物的观点"}, {"type": "subtitle", "time": 6882.87, "timestamp": "01:54:42", "text": "就像每个英雄一样。所以"}, {"type": "subtitle", "time": 6884.75, "timestamp": "01:54:44", "text": "从15岁起"}, {"type": "subtitle", "time": 6888.189, "timestamp": "01:54:48", "text": "排名第一的"}, {"type": "subtitle", "time": 6891.589, "timestamp": "01:54:51", "text": "事物。我猜是15或者10。我忘了。是的。"}, {"type": "subtitle", "time": 6893.55, "timestamp": "01:54:53", "text": "从第十名到第一名。"}, {"type": "subtitle", "time": 6896.229, "timestamp": "01:54:56", "text": "实际上，它真的很好。真的"}]
[{"type": "subtitle", "time": 17582.15, "timestamp": "04:53:02", "text": "但我们首先需要弄到轮子。"}, {"type": "subtitle", "time": 17584.948, "timestamp": "04:53:04", "text": "把车开出来。我在哪里？"}, {"type": "subtitle", "time": 17586.788, "timestamp": "04:53:06", "text": "应该找到那个吗？ Vade 车辆。哦"}, {"type": "subtitle", "time": 17589.51, "timestamp": "04:53:09", "text": "我的上帝。我们过去找你。嘿，"}, {"type": "subtitle", "time": 17591.99, "timestamp": "04:53:11", "text": "对此要谨慎行事。好的。是"}, {"type": "subtitle", "time": 17595.11, "timestamp": "04:53:15", "text": "慎重。谨慎究竟是什么意思？喜欢"}, {"type": "subtitle", "time": 17598.788, "timestamp": "04:53:18", "text": "要保密。保密。寻找车辆"}, {"type": "subtitle", "time": 17600.868, "timestamp": "04:53:20", "text": "在指甲农场。我的天啊。实际上，"}, {"type": "subtitle", "time": 17602.948, "timestamp": "04:53:22", "text": "我们要买车。好的。明白了"}, {"type": "subtitle", "time": 17604.868, "timestamp": "04:53:24", "text": "我跟你说过那辆车。我的天啊。等待。"}, {"type": "subtitle", "time": 17607.99, "timestamp": "04:53:27", "text": "那只狡猾的狐狸或狡猾的狗在哪里？在哪里"}, {"type": "subtitle", "time": 17610.39, "timestamp": "04:53:30", "text": "你在哪里？挖到头的那个人"}, {"type": "subtitle", "time": 17614.948, "timestamp": "04:53:34", "text": "四处张望，看到我和他说话。曾是"}, {"type": "subtitle", "time": 17617.628, "timestamp": "04:53:37", "text": "穿着像白衬衫之类的衣服"}, {"type": "subtitle", "time": 17620.91, "timestamp": "04:53:40", "text": "某物。那个人现在失踪了。"}, {"type": "subtitle", "time": 17622.91, "timestamp": "04:53:42", "text": "哇。"}, {"type": "subtitle", "time": 17632.35, "timestamp": "04:53:52", "text": "出去。感觉很糟糕"}]
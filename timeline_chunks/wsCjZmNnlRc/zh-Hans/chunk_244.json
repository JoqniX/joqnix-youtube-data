[{"type": "subtitle", "time": 14642.79, "timestamp": "04:04:02", "text": "还有学术方面的事情，不过六月是我的。"}, {"type": "subtitle", "time": 14645.11, "timestamp": "04:04:05", "text": "考试意味着一段时间内，"}, {"type": "subtitle", "time": 14647.11, "timestamp": "04:04:07", "text": "我正在参加 Jockathon 活动，直播内容将是……"}, {"type": "subtitle", "time": 14652.63, "timestamp": "04:04:12", "text": "我记得最多每天是两个。是的。"}, {"type": "subtitle", "time": 14655.83, "timestamp": "04:04:15", "text": "六月最后一周是……"}, {"type": "subtitle", "time": 14657.67, "timestamp": "04:04:17", "text": "我需要收拾东西了。"}, {"type": "subtitle", "time": 14660.15, "timestamp": "04:04:20", "text": "请代我作最后的告别。我们将有一个"}, {"type": "subtitle", "time": 14663.429, "timestamp": "04:04:23", "text": "最后冲刺阶段，最后一周"}, {"type": "subtitle", "time": 14665.99, "timestamp": "04:04:25", "text": "乔森。我们将进行最后的冲刺，"}, {"type": "subtitle", "time": 14669.07, "timestamp": "04:04:29", "text": "我称之为第四阶段。"}, {"type": "subtitle", "time": 14672.269, "timestamp": "04:04:32", "text": "呃，我们将在那里道别"}, {"type": "subtitle", "time": 14675.59, "timestamp": "04:04:35", "text": "一切，我的电脑，对我的朋友们来说，"}, {"type": "subtitle", "time": 14677.75, "timestamp": "04:04:37", "text": "一切。"}, {"type": "subtitle", "time": 14680.15, "timestamp": "04:04:40", "text": "我们将开设一个专门的直播流。"}, {"type": "subtitle", "time": 14682.03, "timestamp": "04:04:42", "text": "最后一天"}, {"type": "subtitle", "time": 14684.79, "timestamp": "04:04:44", "text": "乔森。是的。"}, {"type": "subtitle", "time": 14688.99, "timestamp": "04:04:48", "text": "所以，之后在日本，可能……"}, {"type": "subtitle", "time": 14693.59, "timestamp": "04:04:53", "text": "七月，周中，七月中下旬，"}, {"type": "subtitle", "time": 14695.91, "timestamp": "04:04:55", "text": "我很快就能恢复直播了。"}, {"type": "subtitle", "time": 14698.63, "timestamp": "04:04:58", "text": "一旦我认为我已经处理好一切了"}]
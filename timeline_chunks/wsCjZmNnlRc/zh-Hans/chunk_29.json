[{"type": "subtitle", "time": 1745.99, "timestamp": "00:29:05", "text": "呃，我看到好多人过来。"}, {"type": "subtitle", "time": 1748.95, "timestamp": "00:29:08", "text": "我的直播流显示它们来自"}, {"type": "subtitle", "time": 1750.63, "timestamp": "00:29:10", "text": "加利福尼亚州。加州真的存在吗？"}, {"type": "subtitle", "time": 1752.71, "timestamp": "00:29:12", "text": "受欢迎的？"}, {"type": "subtitle", "time": 1753.99, "timestamp": "00:29:13", "text": "嗯，这些到底是怎么回事？"}, {"type": "subtitle", "time": 1759.19, "timestamp": "00:29:19", "text": "需要说明的是，我只能做到这样。"}, {"type": "chat", "time": 1763.834, "timestamp": "00:29:23", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "don't want to specify. west coast is closest you getting from me"}, {"type": "subtitle", "time": 1779.35, "timestamp": "00:29:39", "text": "我想特别说明一下，西海岸是"}, {"type": "subtitle", "time": 1781.83, "timestamp": "00:29:41", "text": "你离我最近了，但运动员们"}, {"type": "subtitle", "time": 1786.149, "timestamp": "00:29:46", "text": "已经是运动员了。哦，呃，是的。我"}, {"type": "subtitle", "time": 1788.269, "timestamp": "00:29:48", "text": "找不到加州那个东西"}, {"type": "subtitle", "time": 1791.23, "timestamp": "00:29:51", "text": "实际上。等等，稍等。是某人"}, {"type": "subtitle", "time": 1793.83, "timestamp": "00:29:53", "text": "别的。我觉得是另一个观众。"}, {"type": "subtitle", "time": 1795.47, "timestamp": "00:29:55", "text": "等等，谁说的？"}]
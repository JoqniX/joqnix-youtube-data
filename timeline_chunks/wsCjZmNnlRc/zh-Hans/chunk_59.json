[{"type": "subtitle", "time": 3540.71, "timestamp": "00:59:00", "text": "轻小说9和21 轻小说"}, {"type": "subtitle", "time": 3544.069, "timestamp": "00:59:04", "text": "网络小说第12部：黑发"}, {"type": "subtitle", "time": 3546.39, "timestamp": "00:59:06", "text": "深绿色、轻小说和动漫"}, {"type": "subtitle", "time": 3548.789, "timestamp": "00:59:08", "text": "网络小说中黑色眼睛的颜色是紫色和"}, {"type": "subtitle", "time": 3553.27, "timestamp": "00:59:13", "text": "轻小说和动漫中的蓝色，还有我的"}, {"type": "subtitle", "time": 3557.91, "timestamp": "00:59:17", "text": "身高是153厘米，或者用美国人的话说就是5吨。"}, {"type": "subtitle", "time": 3559.829, "timestamp": "00:59:19", "text": "状态为存活。出生地在"}, {"type": "subtitle", "time": 3561.91, "timestamp": "00:59:21", "text": "维蒂格里斯之家。与……的隶属关系"}, {"type": "subtitle", "time": 3563.91, "timestamp": "00:59:23", "text": "维蒂格里斯之家。故宫。内"}, {"type": "subtitle", "time": 3566.87, "timestamp": "00:59:26", "text": "法庭。外场。呃，我的职业是"}, {"type": "subtitle", "time": 3569.109, "timestamp": "00:59:29", "text": "药剂师。法院已关闭。内"}, {"type": "subtitle", "time": 3571.75, "timestamp": "00:59:31", "text": "宫廷是女仆。呃，衣柜"}, {"type": "subtitle", "time": 3574.549, "timestamp": "00:59:34", "text": "前服务人员。内院是玉"}, {"type": "subtitle", "time": 3576.95, "timestamp": "00:59:36", "text": "亭台女侍。内院"}, {"type": "subtitle", "time": 3579.349, "timestamp": "00:59:39", "text": "玉阁毒物检测仪。外庭"}, {"type": "subtitle", "time": 3581.99, "timestamp": "00:59:41", "text": "是人施的私人女仆。和外部"}, {"type": "subtitle", "time": 3594.43, "timestamp": "00:59:54", "text": "我的天哪，你"}, {"type": "subtitle", "time": 3597.15, "timestamp": "00:59:57", "text": "实际上"}]
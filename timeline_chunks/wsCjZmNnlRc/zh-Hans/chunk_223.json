[{"type": "subtitle", "time": 13381.91, "timestamp": "03:43:01", "text": "我认为我能做到，而且我相信我能做到"}, {"type": "subtitle", "time": 13386.07, "timestamp": "03:43:06", "text": "如果我足够坚持的话，就会去做。我"}, {"type": "subtitle", "time": 13388.67, "timestamp": "03:43:08", "text": "我会为此努力。"}, {"type": "subtitle", "time": 13392.229, "timestamp": "03:43:12", "text": "是的。嗯，是的，因为它是如此的"}, {"type": "subtitle", "time": 13394.55, "timestamp": "03:43:14", "text": "数额巨大，我不认为这四个月会是这么大的数额。"}, {"type": "subtitle", "time": 13395.79, "timestamp": "03:43:15", "text": "时期是"}, {"type": "subtitle", "time": 13400.51, "timestamp": "03:43:20", "text": "足够的。这就是我为什么要做这件事的原因。"}, {"type": "subtitle", "time": 13403.03, "timestamp": "03:43:23", "text": "仅此四个月的运动马拉松"}, {"type": "subtitle", "time": 13406.71, "timestamp": "03:43:26", "text": "因为一旦我到了日本，我"}, {"type": "subtitle", "time": 13408.389, "timestamp": "03:43:28", "text": "需要买一台新笔记本电脑，"}, {"type": "subtitle", "time": 13411.429, "timestamp": "03:43:31", "text": "一切就绪，并能够进行设置"}, {"type": "subtitle", "time": 13413.469, "timestamp": "03:43:33", "text": "一切都是为了让我能回来。"}, {"type": "subtitle", "time": 13416.429, "timestamp": "03:43:36", "text": "流媒体。好的。"}, {"type": "subtitle", "time": 13418.95, "timestamp": "03:43:38", "text": "是的。那需要一段时间，我"}, {"type": "subtitle", "time": 13423.11, "timestamp": "03:43:43", "text": "知道。你知道，呃，我就是那样，我"}, {"type": "subtitle", "time": 13425.11, "timestamp": "03:43:45", "text": "我觉得我活不下去了，但我会活下去。"}, {"type": "subtitle", "time": 13427.75, "timestamp": "03:43:47", "text": "存活。我相信自己。这是一个新的"}, {"type": "subtitle", "time": 13430.63, "timestamp": "03:43:50", "text": "对我来说是个挑战。内向者，我迈步"}, {"type": "subtitle", "time": 13434.229, "timestamp": "03:43:54", "text": "走出去，看看世界"}, {"type": "subtitle", "time": 13436.75, "timestamp": "03:43:56", "text": "在我看来，世界就是这样运转的，"}, {"type": "subtitle", "time": 13439.51, "timestamp": "03:43:59", "text": "一切。这将很困难。但我"}]
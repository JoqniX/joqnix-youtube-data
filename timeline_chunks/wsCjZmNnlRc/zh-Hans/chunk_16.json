[{"type": "subtitle", "time": 961.35, "timestamp": "00:16:01", "text": "是这个人吗？哪一个？"}, {"type": "subtitle", "time": 965.59, "timestamp": "00:16:05", "text": "哦，就像……你还记得吗？"}, {"type": "subtitle", "time": 967.91, "timestamp": "00:16:07", "text": "我派对了人给你。我要去"}, {"type": "subtitle", "time": 970.55, "timestamp": "00:16:10", "text": "同意。我先静音一会儿，所以"}, {"type": "subtitle", "time": 972.87, "timestamp": "00:16:12", "text": "可以听听它们的声音是什么样的。全部"}, {"type": "subtitle", "time": 1019.269, "timestamp": "00:16:59", "text": "等等，有语音功能吗？"}]
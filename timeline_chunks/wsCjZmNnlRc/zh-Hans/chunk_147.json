[{"type": "subtitle", "time": 8829.91, "timestamp": "02:27:09", "text": "我喜欢他们说你有一首歌的方式"}, {"type": "subtitle", "time": 8832.07, "timestamp": "02:27:12", "text": "歌声。"}, {"type": "subtitle", "time": 8832.91, "timestamp": "02:27:12", "text": "做"}, {"type": "subtitle", "time": 8841.349, "timestamp": "02:27:21", "text": "我连歌都不会唱。我唱歌很难听。"}, {"type": "subtitle", "time": 8843.59, "timestamp": "02:27:23", "text": "我甚至不知道该怎么唱歌。"}, {"type": "subtitle", "time": 8845.309, "timestamp": "02:27:25", "text": "这在我的"}, {"type": "subtitle", "time": 8855.75, "timestamp": "02:27:35", "text": "我们只需要拍拍“是啊，我”就行了。"}, {"type": "subtitle", "time": 8869.91, "timestamp": "02:27:49", "text": "但我刚刚吃了那根香蕉。如果你"}, {"type": "subtitle", "time": 8872.309, "timestamp": "02:27:52", "text": "你之前说过，我本来可以的"}, {"type": "subtitle", "time": 8873.71, "timestamp": "02:27:53", "text": "这"}, {"type": "subtitle", "time": 8876.95, "timestamp": "02:27:56", "text": "香蕉。一根香蕉。我已经吃过了"}]
[{"type": "subtitle", "time": 17401.59, "timestamp": "04:50:01", "text": "你好呀。"}, {"type": "subtitle", "time": 17403.11, "timestamp": "04:50:03", "text": "我无意打断。我在看"}, {"type": "subtitle", "time": 17406.15, "timestamp": "04:50:06", "text": "为贾齐尔。我是贾齐尔。但如果你想"}, {"type": "subtitle", "time": 17408.708, "timestamp": "04:50:08", "text": "我们只有面包。不，不。我 我"}, {"type": "subtitle", "time": 17411.11, "timestamp": "04:50:11", "text": "不需要食物。听着，我来自哈兰"}, {"type": "subtitle", "time": 17412.788, "timestamp": "04:50:12", "text": "我来是因为我听说了这一点。"}, {"type": "subtitle", "time": 17414.15, "timestamp": "04:50:14", "text": "这里有些人对……免疫"}, {"type": "subtitle", "time": 17416.07, "timestamp": "04:50:16", "text": "即使他们不会改变，这种病毒也不会让他们改变"}, {"type": "subtitle", "time": 17417.47, "timestamp": "04:50:17", "text": "它们会被咬。"}, {"type": "subtitle", "time": 17421.11, "timestamp": "04:50:21", "text": "哦，是谁告诉你的？一个死人，"}, {"type": "subtitle", "time": 17423.43, "timestamp": "04:50:23", "text": "很遗憾。你最好还是保留"}, {"type": "subtitle", "time": 17425.51, "timestamp": "04:50:25", "text": "听他说话。我不会再告诉你了。"}, {"type": "subtitle", "time": 17427.99, "timestamp": "04:50:27", "text": "我不会告诉你比他现在说的更多了。"}, {"type": "subtitle", "time": 17429.91, "timestamp": "04:50:29", "text": "为什么没有人愿意帮我？病毒是"}, {"type": "subtitle", "time": 17432.15, "timestamp": "04:50:32", "text": "遍布全城。有人正在死去。和"}, {"type": "subtitle", "time": 17434.948, "timestamp": "04:50:34", "text": "你却依然活着。"}, {"type": "subtitle", "time": 17436.948, "timestamp": "04:50:36", "text": "朋友，拿点面包来。返回"}, {"type": "subtitle", "time": 17440.35, "timestamp": "04:50:40", "text": "她。什么？不，别开枪打我。我"}, {"type": "subtitle", "time": 17443.948, "timestamp": "04:50:43", "text": "b 就在这里。"}, {"type": "subtitle", "time": 17446.67, "timestamp": "04:50:46", "text": "不，过来"}, {"type": "subtitle", "time": 17450.07, "timestamp": "04:50:50", "text": "在。至少我会四处打听一下。"}, {"type": "subtitle", "time": 17452.868, "timestamp": "04:50:52", "text": "用来装东西。面包在哪里？"}, {"type": "subtitle", "time": 17454.75, "timestamp": "04:50:54", "text": "告诉我"}]
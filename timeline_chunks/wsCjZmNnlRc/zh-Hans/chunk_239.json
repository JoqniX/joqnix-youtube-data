[{"type": "subtitle", "time": 14340.03, "timestamp": "03:59:00", "text": "它将受到影响。是的，我只是"}, {"type": "subtitle", "time": 14343.349, "timestamp": "03:59:03", "text": "希望这件事能成功。我只是想要，我不想……"}, {"type": "subtitle", "time": 14344.67, "timestamp": "03:59:04", "text": "我知道我正在做"}, {"type": "subtitle", "time": 14347.87, "timestamp": "03:59:07", "text": "我创作了我委托创作的那些人"}, {"type": "subtitle", "time": 14350.229, "timestamp": "03:59:10", "text": "因为我没钱，所以先等等吧。"}, {"type": "subtitle", "time": 14351.07, "timestamp": "03:59:11", "text": "正确的"}, {"type": "subtitle", "time": 14354.95, "timestamp": "03:59:14", "text": "现在。但是，嗯，但愿一切顺利。"}, {"type": "subtitle", "time": 14358.07, "timestamp": "03:59:18", "text": "一切顺利。我确实让他们知道我是"}, {"type": "subtitle", "time": 14361.349, "timestamp": "03:59:21", "text": "会像众筹那样做。"}, {"type": "subtitle", "time": 14363.349, "timestamp": "03:59:23", "text": "能够完成委托工作"}, {"type": "subtitle", "time": 14365.99, "timestamp": "03:59:25", "text": "一切。所以，是的，但愿如此。"}, {"type": "subtitle", "time": 14368.389, "timestamp": "03:59:28", "text": "一切顺利的话，嗯，我保证"}, {"type": "subtitle", "time": 14370.87, "timestamp": "03:59:30", "text": "你放心，我不会把钱用于……"}, {"type": "subtitle", "time": 14373.55, "timestamp": "03:59:33", "text": "还要别的吗。这仅仅是为了"}, {"type": "subtitle", "time": 14375.95, "timestamp": "03:59:35", "text": "首次亮相。一切都将只是为了"}, {"type": "subtitle", "time": 14379.03, "timestamp": "03:59:39", "text": "在 YouTube 上搜索模型绑定教程"}, {"type": "subtitle", "time": 14380.99, "timestamp": "03:59:40", "text": "我喜欢这位漂亮的模特"}, {"type": "subtitle", "time": 14384.63, "timestamp": "03:59:44", "text": "很多。是的，还有其他一些东西。"}, {"type": "subtitle", "time": 14388.469, "timestamp": "03:59:48", "text": "需要为出道等等做准备。甚至"}, {"type": "subtitle", "time": 14390.63, "timestamp": "03:59:50", "text": "虽然我的首秀堪称完美，"}, {"type": "subtitle", "time": 14392.91, "timestamp": "03:59:52", "text": "我设想了一个"}, {"type": "subtitle", "time": 14396.63, "timestamp": "03:59:56", "text": "很多，你知道的。有趣的是，我的"}, {"type": "subtitle", "time": 14399.67, "timestamp": "03:59:59", "text": "出道那件事我以前一直把它看作是一个"}]
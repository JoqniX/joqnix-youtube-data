[{"type": "subtitle", "time": 15360.79, "timestamp": "04:16:00", "text": "以这种模式，尤其是艺术家"}, {"type": "subtitle", "time": 15362.309, "timestamp": "04:16:02", "text": "一切。我不能透露是谁"}, {"type": "subtitle", "time": 15365.63, "timestamp": "04:16:05", "text": "这位艺术家是，或者现在与他合作过的人。"}, {"type": "subtitle", "time": 15369.229, "timestamp": "04:16:09", "text": "但一旦首秀发生，我就能说得通了。"}, {"type": "subtitle", "time": 15373.79, "timestamp": "04:16:13", "text": "我只能说这些了。"}, {"type": "subtitle", "time": 15375.71, "timestamp": "04:16:15", "text": "宾夕法尼亚州"}, {"type": "subtitle", "time": 15380.389, "timestamp": "04:16:20", "text": "嗨，我们开个玩笑，我的意思是你可以"}, {"type": "subtitle", "time": 15384.429, "timestamp": "04:16:24", "text": "想象一下那样，或者其他什么，我没有。"}, {"type": "subtitle", "time": 15387.309, "timestamp": "04:16:27", "text": "我知道我不能"}, {"type": "subtitle", "time": 15391.83, "timestamp": "04:16:31", "text": "就像运动员一样，没有特定的"}, {"type": "subtitle", "time": 15394.149, "timestamp": "04:16:34", "text": "性别或其他任何方面，它都是双性人"}, {"type": "subtitle", "time": 15398.269, "timestamp": "04:16:38", "text": "现在，善良就像我的声音一样。"}, {"type": "subtitle", "time": 15402.229, "timestamp": "04:16:42", "text": "看来我可以成为你想要的任何人。"}, {"type": "subtitle", "time": 15404.389, "timestamp": "04:16:44", "text": "你可以称呼我为他或她"}, {"type": "subtitle", "time": 15410.79, "timestamp": "04:16:50", "text": "美好的。所以它完全符合我的所有要求。"}, {"type": "subtitle", "time": 15413.229, "timestamp": "04:16:53", "text": "设想这份工作应该是这样的："}, {"type": "subtitle", "time": 15416.87, "timestamp": "04:16:56", "text": "一切。你好。但愿如此"}, {"type": "subtitle", "time": 15419.349, "timestamp": "04:16:59", "text": "一切顺利。最后，我"}]
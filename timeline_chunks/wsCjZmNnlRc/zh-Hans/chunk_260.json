[{"type": "subtitle", "time": 15600.55, "timestamp": "04:20:00", "text": "让我的音乐被听到，让更多人听到。"}, {"type": "subtitle", "time": 15603.71, "timestamp": "04:20:03", "text": "一切。当我还是个小孩子的时候"}, {"type": "subtitle", "time": 15607.87, "timestamp": "04:20:07", "text": "不过，我希望人们能了解我"}, {"type": "subtitle", "time": 15611.79, "timestamp": "04:20:11", "text": "故事。希望这能激励他们。"}, {"type": "subtitle", "time": 15614.469, "timestamp": "04:20:14", "text": "也。这就是我创办 Jocknik 的原因。"}, {"type": "subtitle", "time": 15617.75, "timestamp": "04:20:17", "text": "这就是为什么Jocknik对我来说意义非凡。"}, {"type": "subtitle", "time": 15628.55, "timestamp": "04:20:28", "text": "而现在我，我，我像个运动健将一样投入其中"}, {"type": "subtitle", "time": 15631.349, "timestamp": "04:20:31", "text": "争抢长矛。现在我可以实现一切"}, {"type": "subtitle", "time": 15633.75, "timestamp": "04:20:33", "text": "我想要的东西。就像我做的梦一样"}, {"type": "subtitle", "time": 15637.67, "timestamp": "04:20:37", "text": "放弃了，我可以尽力去实现"}, {"type": "subtitle", "time": 15640.79, "timestamp": "04:20:40", "text": "现在，让他们经历这段旅程。以及"}, {"type": "subtitle", "time": 15644.51, "timestamp": "04:20:44", "text": "我要捕捉的梦境"}, {"type": "subtitle", "time": 15648.03, "timestamp": "04:20:48", "text": "捕手。是的。追梦人。"}, {"type": "subtitle", "time": 15653.59, "timestamp": "04:20:53", "text": "是的。你好。是的。嗯，我就要说这些了。"}, {"type": "subtitle", "time": 15656.309, "timestamp": "04:20:56", "text": "大家继续努力！感谢"}, {"type": "subtitle", "time": 15657.149, "timestamp": "04:20:57", "text": "你"}]
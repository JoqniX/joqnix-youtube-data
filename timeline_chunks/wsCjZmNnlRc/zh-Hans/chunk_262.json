[{"type": "subtitle", "time": 15721.71, "timestamp": "04:22:01", "text": "你就像一个失去了希望的人，或者"}, {"type": "subtitle", "time": 15724.309, "timestamp": "04:22:04", "text": "任何事，想做事，但你"}, {"type": "subtitle", "time": 15726.95, "timestamp": "04:22:06", "text": "不能，想留到以后再说"}, {"type": "subtitle", "time": 15728.63, "timestamp": "04:22:08", "text": "带上笔记本之类的东西，"}, {"type": "subtitle", "time": 15730.55, "timestamp": "04:22:10", "text": "把你的目标写下来。"}, {"type": "subtitle", "time": 15733.189, "timestamp": "04:22:13", "text": "做你想做的事，并努力去做。"}, {"type": "subtitle", "time": 15736.07, "timestamp": "04:22:16", "text": "朝着这个目标努力。好的？是否"}, {"type": "subtitle", "time": 15739.51, "timestamp": "04:22:19", "text": "你是一位内容创作者，想要……"}, {"type": "subtitle", "time": 15741.83, "timestamp": "04:22:21", "text": "尽你所能，然后出道之类的。"}, {"type": "subtitle", "time": 15743.67, "timestamp": "04:22:23", "text": "如果你是一名 YouTuber，你的虚拟主播（VTuber）"}, {"type": "subtitle", "time": 15746.55, "timestamp": "04:22:26", "text": "准备工作或在某事上首次亮相，"}, {"type": "subtitle", "time": 15748.95, "timestamp": "04:22:28", "text": "一步一个脚印地朝着目标努力。不"}, {"type": "subtitle", "time": 15751.03, "timestamp": "04:22:31", "text": "放弃。"}, {"type": "subtitle", "time": 15754.79, "timestamp": "04:22:34", "text": "如果你是其他人"}, {"type": "subtitle", "time": 15757.83, "timestamp": "04:22:37", "text": "呃，爱好之类的，比如音乐，"}, {"type": "subtitle", "time": 15761.11, "timestamp": "04:22:41", "text": "写作，或者你做的任何事，无论你具备什么技能"}, {"type": "subtitle", "time": 15763.75, "timestamp": "04:22:43", "text": "你有或者如果你还在用那个"}, {"type": "subtitle", "time": 15765.75, "timestamp": "04:22:45", "text": "像我一样踏上旅程，找到我的强项。"}, {"type": "subtitle", "time": 15768.11, "timestamp": "04:22:48", "text": "我擅长什么？"}, {"type": "subtitle", "time": 15772.229, "timestamp": "04:22:52", "text": "那东西，继续尽力寻找，"}, {"type": "subtitle", "time": 15775.349, "timestamp": "04:22:55", "text": "好的？最终，你会偶然发现"}, {"type": "subtitle", "time": 15778.229, "timestamp": "04:22:58", "text": "这项技能或者你真正真正"}]
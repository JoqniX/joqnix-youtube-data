[{"type": "subtitle", "time": 14403.229, "timestamp": "04:00:03", "text": "婚礼就像一场盛大的主场"}, {"type": "subtitle", "time": 14407.67, "timestamp": "04:00:07", "text": "那个东西，因为呃，我想，你到底想干什么？"}, {"type": "subtitle", "time": 14409.189, "timestamp": "04:00:09", "text": "在婚礼上做什么？你给予你的"}, {"type": "subtitle", "time": 14411.67, "timestamp": "04:00:11", "text": "一切都对吧？你把它搞得如此盛大"}, {"type": "subtitle", "time": 14415.07, "timestamp": "04:00:15", "text": "尽可能地，对吧？但实际上，情况并非如此。"}, {"type": "subtitle", "time": 14417.99, "timestamp": "04:00:17", "text": "美好的。作为一名小型创作者，我不需要"}, {"type": "subtitle", "time": 14422.15, "timestamp": "04:00:22", "text": "显得过于花哨或太贵"}, {"type": "subtitle", "time": 14424.67, "timestamp": "04:00:24", "text": "或者负荷过重。"}, {"type": "subtitle", "time": 14427.389, "timestamp": "04:00:27", "text": "不，出道只是一个"}, {"type": "subtitle", "time": 14431.83, "timestamp": "04:00:31", "text": "事件。首次亮相只是人生中的一个事件或"}, {"type": "subtitle", "time": 14433.91, "timestamp": "04:00:33", "text": "旅途中发生的一些事情，标志着"}, {"type": "subtitle", "time": 14436.55, "timestamp": "04:00:36", "text": "那一刻，就像是，我首次亮相了。我是"}, {"type": "subtitle", "time": 14439.469, "timestamp": "04:00:39", "text": "这里。我还活着，算是吧。"}, {"type": "subtitle", "time": 14441.83, "timestamp": "04:00:41", "text": "就像你在自我介绍一样"}, {"type": "subtitle", "time": 14443.99, "timestamp": "04:00:43", "text": "向全世界宣告你是谁"}, {"type": "subtitle", "time": 14446.83, "timestamp": "04:00:46", "text": "你是，你的一切，以及你的一切。"}, {"type": "subtitle", "time": 14448.349, "timestamp": "04:00:48", "text": "一切"}, {"type": "subtitle", "time": 14452.269, "timestamp": "04:00:52", "text": "对，是的"}, {"type": "subtitle", "time": 14457.03, "timestamp": "04:00:57", "text": "嗯，我让未来的我来决定事情的走向。"}, {"type": "subtitle", "time": 14459.75, "timestamp": "04:00:59", "text": "我会去，我的意思是，在我出道之后。"}]
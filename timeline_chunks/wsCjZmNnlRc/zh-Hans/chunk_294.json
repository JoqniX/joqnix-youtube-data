[{"type": "subtitle", "time": 17647.31, "timestamp": "04:54:07", "text": "某物？哦，还有那些"}, {"type": "subtitle", "time": 17651.628, "timestamp": "04:54:11", "text": "呃，那种超大的黄色玩意儿"}, {"type": "subtitle", "time": 17655.27, "timestamp": "04:54:15", "text": "挡住了我的路。哦，忘了说了"}, {"type": "subtitle", "time": 17657.35, "timestamp": "04:54:17", "text": "你。如果你一个也没有，那就去找。"}, {"type": "subtitle", "time": 17659.35, "timestamp": "04:54:19", "text": "给自己准备一些武器。哦，你好啊。"}, {"type": "subtitle", "time": 17661.43, "timestamp": "04:54:21", "text": "被遗弃了。"}, {"type": "subtitle", "time": 17663.75, "timestamp": "04:54:23", "text": "等等，什么？你忘了告诉我"}, {"type": "subtitle", "time": 17666.47, "timestamp": "04:54:26", "text": "这。嗯，它们当时并不重要。"}, {"type": "subtitle", "time": 17669.15, "timestamp": "04:54:29", "text": "全部。"}, {"type": "subtitle", "time": 17671.708, "timestamp": "04:54:31", "text": "毫无章法，"}, {"type": "subtitle", "time": 17675.59, "timestamp": "04:54:35", "text": "没有生意。"}, {"type": "subtitle", "time": 17677.83, "timestamp": "04:54:37", "text": "听起来像是伪装。好的，我会"}, {"type": "subtitle", "time": 17680.39, "timestamp": "04:54:40", "text": "短暂伪装一下。女王，你可以"}, {"type": "subtitle", "time": 17682.628, "timestamp": "04:54:42", "text": "处理他。听着，我跟……达成了协议"}, {"type": "subtitle", "time": 17684.868, "timestamp": "04:54:44", "text": "部分顾客。给我一次信号就好"}, {"type": "subtitle", "time": 17688.47, "timestamp": "04:54:48", "text": "你拿到车了。我的天哪。狩猎塔"}]
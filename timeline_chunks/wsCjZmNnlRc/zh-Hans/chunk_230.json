[{"type": "subtitle", "time": 13805.51, "timestamp": "03:50:05", "text": "他们。是的，我就是想这么做，因为"}, {"type": "subtitle", "time": 13808.59, "timestamp": "03:50:08", "text": "大家都对我很好。"}, {"type": "subtitle", "time": 13813.269, "timestamp": "03:50:13", "text": "我当时想……想花更多钱。"}, {"type": "subtitle", "time": 13816.389, "timestamp": "03:50:16", "text": "我想，大概是时间吧。我又开始了我的"}, {"type": "subtitle", "time": 13818.75, "timestamp": "03:50:18", "text": "我人生的新篇章即将开启"}, {"type": "subtitle", "time": 13821.83, "timestamp": "03:50:21", "text": "日本。所以我会想念我遇到的每一个人。"}, {"type": "subtitle", "time": 13824.71, "timestamp": "03:50:24", "text": "朋友，还有来自同一个地方的人"}, {"type": "subtitle", "time": 13827.59, "timestamp": "03:50:27", "text": "因为我来自印度，所以我们处于同一时区。"}, {"type": "subtitle", "time": 13831.269, "timestamp": "03:50:31", "text": "我会想念我结交的所有印度朋友。"}, {"type": "subtitle", "time": 13832.59, "timestamp": "03:50:32", "text": "他们很多"}, {"type": "subtitle", "time": 13837.55, "timestamp": "03:50:37", "text": "现在。所以我想按顺序来做。"}, {"type": "subtitle", "time": 13840.389, "timestamp": "03:50:40", "text": "花更多的时间和他们在一起"}, {"type": "subtitle", "time": 13843.75, "timestamp": "03:50:43", "text": "玩得开心。对，这就是乔森"}, {"type": "subtitle", "time": 13846.63, "timestamp": "03:50:46", "text": "是。对我来说，这是一件大事。"}, {"type": "subtitle", "time": 13849.189, "timestamp": "03:50:49", "text": "猜测。尽管我毫无准备，但我还是"}, {"type": "subtitle", "time": 13851.309, "timestamp": "03:50:51", "text": "不知道安息日、捐赠活动是怎么回事"}, {"type": "subtitle", "time": 13854.71, "timestamp": "03:50:54", "text": "一切正常，但我打算即兴发挥。"}, {"type": "subtitle", "time": 13857.59, "timestamp": "03:50:57", "text": "它。我打算在我……的时候做这件事。"}]
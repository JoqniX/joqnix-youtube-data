[{"type": "subtitle", "time": 4920.11, "timestamp": "01:22:00", "text": "现在。我……我还在等呢。"}, {"type": "subtitle", "time": 4924.229, "timestamp": "01:22:04", "text": "你的下一期播客节目。我知道。是"}, {"type": "subtitle", "time": 4926.79, "timestamp": "01:22:06", "text": "如果我交到一些朋友，呃，朋友，那就好玩了"}, {"type": "subtitle", "time": 4928.629, "timestamp": "01:22:08", "text": "然后与他们合作，在我的"}, {"type": "subtitle", "time": 4931.43, "timestamp": "01:22:11", "text": "下一期播客。"}, {"type": "subtitle", "time": 4959.59, "timestamp": "01:22:39", "text": "会有一些人对此感到担忧。"}, {"type": "subtitle", "time": 4961.669, "timestamp": "01:22:41", "text": "开始随意地叫出我的真名"}, {"type": "subtitle", "time": 4964.47, "timestamp": "01:22:44", "text": "他们会大声说：“嘿，不错。”"}, {"type": "subtitle", "time": 4977.43, "timestamp": "01:22:57", "text": "爱，你真的有过那样的经历吗？"}]
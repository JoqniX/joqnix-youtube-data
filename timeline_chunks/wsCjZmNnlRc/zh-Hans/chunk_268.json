[{"type": "subtitle", "time": 16093.349, "timestamp": "04:28:13", "text": "[音乐]"}, {"type": "subtitle", "time": 16097.07, "timestamp": "04:28:17", "text": "是的。大家好。"}, {"type": "subtitle", "time": 16099.63, "timestamp": "04:28:19", "text": "卡瓦，我的意思是"}, {"type": "subtitle", "time": 16102.55, "timestamp": "04:28:22", "text": "俄亥俄州。我的天啊。是的。大家好。"}, {"type": "subtitle", "time": 16106.67, "timestamp": "04:28:26", "text": "大家最近怎么样？雅虎。"}, {"type": "subtitle", "time": 16112.269, "timestamp": "04:28:32", "text": "雅虎。所以今天，今天，今天我们要去"}, {"type": "subtitle", "time": 16115.75, "timestamp": "04:28:35", "text": "我们将要玩游戏，我们将要玩游戏"}, {"type": "subtitle", "time": 16116.75, "timestamp": "04:28:36", "text": "垂死"}, {"type": "subtitle", "time": 16119.91, "timestamp": "04:28:39", "text": "光。呃，这是第四个直播流。"}, {"type": "subtitle", "time": 16122.469, "timestamp": "04:28:42", "text": "消逝的光芒。所以，我们就结束了，正如你所见。"}, {"type": "subtitle", "time": 16125.269, "timestamp": "04:28:45", "text": "你看，我们已经完成了，我们完全完成了"}, {"type": "subtitle", "time": 16127.91, "timestamp": "04:28:47", "text": "活动。这边的情况几乎是百分之百。"}, {"type": "subtitle", "time": 16131.83, "timestamp": "04:28:51", "text": "故事结束了。完毕。我当时就想，呃……"}, {"type": "subtitle", "time": 16134.389, "timestamp": "04:28:54", "text": "与 Vic 合作演奏"}, {"type": "subtitle", "time": 16136.87, "timestamp": "04:28:56", "text": "相信这是一次即兴合作。"}, {"type": "subtitle", "time": 16139.83, "timestamp": "04:28:59", "text": "Shasha可以在这里说。是的。是的。"}]
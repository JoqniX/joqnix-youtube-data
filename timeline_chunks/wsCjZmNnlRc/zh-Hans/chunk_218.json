[{"type": "subtitle", "time": 13081.389, "timestamp": "03:38:01", "text": "去。多少？多久"}, {"type": "subtitle", "time": 13084.07, "timestamp": "03:38:04", "text": "我能接受的程度"}, {"type": "subtitle", "time": 13086.19, "timestamp": "03:38:06", "text": "我会保留这个"}, {"type": "subtitle", "time": 13089.67, "timestamp": "03:38:09", "text": "去吧，因为那是个梦想，我会的，我是"}, {"type": "subtitle", "time": 13092.67, "timestamp": "03:38:12", "text": "不愿鼓胀，也不愿"}, {"type": "subtitle", "time": 13096.07, "timestamp": "03:38:16", "text": "别再那样了，这就是手指和运动的程度。"}, {"type": "subtitle", "time": 13097.389, "timestamp": "03:38:17", "text": "意思是"}, {"type": "subtitle", "time": 13100.229, "timestamp": "03:38:20", "text": "我有点跑题了，不过是的。"}, {"type": "subtitle", "time": 13102.429, "timestamp": "03:38:22", "text": "没关系，你好，第四"}, {"type": "subtitle", "time": 13106.309, "timestamp": "03:38:26", "text": "一个，所以有个模型之类的东西，我"}, {"type": "subtitle", "time": 13109.269, "timestamp": "03:38:29", "text": "我想做个首秀，我想，但我并不这么想。"}, {"type": "subtitle", "time": 13112.87, "timestamp": "03:38:32", "text": "我知道我有钱资助它，因为呃"}, {"type": "subtitle", "time": 13115.99, "timestamp": "03:38:35", "text": "你们大多数人，对于那些不知道的人来说……"}, {"type": "subtitle", "time": 13118.389, "timestamp": "03:38:38", "text": "对于那些刚来这里的人来说，或者"}, {"type": "subtitle", "time": 13120.469, "timestamp": "03:38:40", "text": "第一次听到这个消息时"}, {"type": "subtitle", "time": 13123.03, "timestamp": "03:38:43", "text": "将前往日本开始新的生活"}, {"type": "subtitle", "time": 13125.67, "timestamp": "03:38:45", "text": "我人生中的一章"}, {"type": "subtitle", "time": 13130.15, "timestamp": "03:38:50", "text": "嗯，就现实生活中的我而言，我感到很兴奋"}, {"type": "subtitle", "time": 13133.19, "timestamp": "03:38:53", "text": "但我同时也害怕，但我"}, {"type": "subtitle", "time": 13135.99, "timestamp": "03:38:55", "text": "期待所有意想不到的事情发生"}]
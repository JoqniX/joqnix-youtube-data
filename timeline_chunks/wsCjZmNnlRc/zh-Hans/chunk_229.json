[{"type": "subtitle", "time": 13741.03, "timestamp": "03:49:01", "text": "正确的。我觉得我以前有过这种奇怪的经历"}, {"type": "subtitle", "time": 13743.51, "timestamp": "03:49:03", "text": "坦白说，我甚至都没有……"}, {"type": "subtitle", "time": 13745.83, "timestamp": "03:49:05", "text": "与我所在机构以外的人合作"}, {"type": "subtitle", "time": 13748.59, "timestamp": "03:49:08", "text": "圆圈。有东西。"}, {"type": "subtitle", "time": 13751.67, "timestamp": "03:49:11", "text": "正确的。很多事情。这里有一份清单。"}, {"type": "subtitle", "time": 13754.469, "timestamp": "03:49:14", "text": "很多事情，我想打破这种局面。我"}, {"type": "subtitle", "time": 13756.95, "timestamp": "03:49:16", "text": "我希望参加这次活动，我会做很多事情。"}, {"type": "subtitle", "time": 13760.469, "timestamp": "03:49:20", "text": "个人直播和大量合作"}, {"type": "subtitle", "time": 13763.99, "timestamp": "03:49:23", "text": "与我合作的人"}, {"type": "subtitle", "time": 13766.95, "timestamp": "03:49:26", "text": "值得信赖。呃，我信任的人，人们"}, {"type": "subtitle", "time": 13769.349, "timestamp": "03:49:29", "text": "从一开始就陪伴在我身边的人，"}, {"type": "subtitle", "time": 13772.469, "timestamp": "03:49:32", "text": "一直支持我的朋友们，"}, {"type": "subtitle", "time": 13775.11, "timestamp": "03:49:35", "text": "呃，普通朋友，内容创作者，"}, {"type": "subtitle", "time": 13777.87, "timestamp": "03:49:37", "text": "各位油管博主们。我带来了"}, {"type": "subtitle", "time": 13780.63, "timestamp": "03:49:40", "text": "每个人。所以，更像是，嗯，"}, {"type": "subtitle", "time": 13782.63, "timestamp": "03:49:42", "text": "这不是告别。不用担心。可能"}, {"type": "subtitle", "time": 13785.429, "timestamp": "03:49:45", "text": "听起来像是我在夸张描述。它"}, {"type": "subtitle", "time": 13788.59, "timestamp": "03:49:48", "text": "听起来像是告别，但并非如此。"}, {"type": "subtitle", "time": 13791.67, "timestamp": "03:49:51", "text": "这样做，是为了表达我的谢意。"}, {"type": "subtitle", "time": 13794.71, "timestamp": "03:49:54", "text": "所有对我友善的人都让我感到高兴。"}]
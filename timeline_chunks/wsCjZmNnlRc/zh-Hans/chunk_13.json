[{"type": "subtitle", "time": 780.389, "timestamp": "00:13:00", "text": "呃，我被那个人通知了。"}, {"type": "subtitle", "time": 783.509, "timestamp": "00:13:03", "text": "帮我的，但是一个朋友"}, {"type": "subtitle", "time": 787.19, "timestamp": "00:13:07", "text": "工作人员说我不会"}, {"type": "subtitle", "time": 789.43, "timestamp": "00:13:09", "text": "他们能做到，但他们抓不到我。"}, {"type": "subtitle", "time": 791.91, "timestamp": "00:13:11", "text": "加入白名单，这样我才能在那里直播。"}, {"type": "subtitle", "time": 795.71, "timestamp": "00:13:15", "text": "从现在开始"}, {"type": "chat", "time": 797.728, "timestamp": "00:13:17", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "talking to family about internet culture is definitely an awkward experience. I had one time my streamer was on a rant about \"deez nuts\" and I had to explain to my family why people talking about nuts"}, {"type": "subtitle", "time": 798.99, "timestamp": "00:13:18", "text": "继续。因为白名单已过期"}, {"type": "subtitle", "time": 801.75, "timestamp": "00:13:21", "text": "我突然觉得我告诉他们要喜欢"}, {"type": "subtitle", "time": 805.67, "timestamp": "00:13:25", "text": "预订五月份的行程，之后就……"}, {"type": "subtitle", "time": 808.069, "timestamp": "00:13:28", "text": "过期了，我问他们，呃，它怎么样了。"}, {"type": "subtitle", "time": 810.949, "timestamp": "00:13:30", "text": "已过期，我可以预订六月份的吗？"}, {"type": "subtitle", "time": 814.389, "timestamp": "00:13:34", "text": "因为我成功促成了与他们的合作"}, {"type": "subtitle", "time": 818.23, "timestamp": "00:13:38", "text": "与 Billy Vtuber 一起。是我的，这是一个"}, {"type": "subtitle", "time": 819.99, "timestamp": "00:13:39", "text": "第一次与中国人合作"}, {"type": "subtitle", "time": 822.55, "timestamp": "00:13:42", "text": "YouTuber。不。所以，我以为会是"}, {"type": "subtitle", "time": 826.069, "timestamp": "00:13:46", "text": "如果我能直播就好了"}, {"type": "subtitle", "time": 828.31, "timestamp": "00:13:48", "text": "那里。您能介绍我认识他们吗？"}, {"type": "subtitle", "time": 830.71, "timestamp": "00:13:50", "text": "机会？我想与……合作"}, {"type": "subtitle", "time": 834.629, "timestamp": "00:13:54", "text": "中国YouTube博主。那肯定很搞笑。"}]
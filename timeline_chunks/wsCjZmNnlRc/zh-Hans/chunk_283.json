[{"type": "subtitle", "time": 16983.47, "timestamp": "04:43:03", "text": "那。但是，我这样做对吗？"}, {"type": "subtitle", "time": 16987.51, "timestamp": "04:43:07", "text": "点？你只是想知道而已。所以你有"}, {"type": "subtitle", "time": 16993.15, "timestamp": "04:43:13", "text": "这里，"}, {"type": "subtitle", "time": 16995.708, "timestamp": "04:43:15", "text": "正确的？然后"}, {"type": "subtitle", "time": 16998.31, "timestamp": "04:43:18", "text": "为什么？为什么我觉得自己应该……"}, {"type": "subtitle", "time": 17000.03, "timestamp": "04:43:20", "text": "跳"}, {"type": "subtitle", "time": 17005.67, "timestamp": "04:43:25", "text": "哇。我应该这样做，"}, {"type": "subtitle", "time": 17007.69, "timestamp": "04:43:27", "text": "正确的？我不"}, {"type": "subtitle", "time": 17009.55, "timestamp": "04:43:29", "text": "[音乐]"}, {"type": "subtitle", "time": 17014.07, "timestamp": "04:43:34", "text": "知道。好的，跳。啊，真是愚蠢。"}, {"type": "subtitle", "time": 17016.91, "timestamp": "04:43:36", "text": "真是愚蠢。啊，"}, {"type": "subtitle", "time": 17020.15, "timestamp": "04:43:40", "text": "不。我当时想，要不要跳起来。"}, {"type": "subtitle", "time": 17022.628, "timestamp": "04:43:42", "text": "回到那块岩石那里，但那是……"}, {"type": "subtitle", "time": 17023.55, "timestamp": "04:43:43", "text": "错误的"}, {"type": "subtitle", "time": 17025.708, "timestamp": "04:43:45", "text": "选择。"}, {"type": "subtitle", "time": 17033.91, "timestamp": "04:43:53", "text": "再次。它更自由奔跑，然后"}]
[{"type": "subtitle", "time": 13621.349, "timestamp": "03:47:01", "text": "这是我对自己和所有认识我的人的承诺。"}, {"type": "subtitle", "time": 13624.469, "timestamp": "03:47:04", "text": "值得拥有这种值得拥有的感觉，就像在新的……中一样。"}, {"type": "subtitle", "time": 13626.75, "timestamp": "03:47:06", "text": "不是现在的那个运动员，而是新的运动员。"}, {"type": "subtitle", "time": 13630.389, "timestamp": "03:47:10", "text": "运动健将。我非常喜欢这位新来的运动健将。"}, {"type": "subtitle", "time": 13633.67, "timestamp": "03:47:13", "text": "我超喜欢那个型号的。我盯着看"}, {"type": "subtitle", "time": 13635.99, "timestamp": "03:47:15", "text": "每晚都这样做。我睡前，"}, {"type": "subtitle", "time": 13637.79, "timestamp": "03:47:17", "text": "我不知道。它是"}, {"type": "subtitle", "time": 13641.51, "timestamp": "03:47:21", "text": "不好是因为它太漂亮了。好的，就是这样。"}, {"type": "subtitle", "time": 13645.51, "timestamp": "03:47:25", "text": "太漂亮了，太惊艳了。我"}, {"type": "subtitle", "time": 13648.429, "timestamp": "03:47:28", "text": "想给你们看看这款模型一。"}, {"type": "subtitle", "time": 13650.99, "timestamp": "03:47:30", "text": "天。"}, {"type": "subtitle", "time": 13654.389, "timestamp": "03:47:34", "text": "而且我觉得我不够格"}, {"type": "subtitle", "time": 13657.67, "timestamp": "03:47:37", "text": "运用那招新的假动作。我必须"}, {"type": "subtitle", "time": 13660.189, "timestamp": "03:47:40", "text": "准备好变得足够优秀"}, {"type": "subtitle", "time": 13664.55, "timestamp": "03:47:44", "text": "呃，使用那个新模型或者新我"}, {"type": "subtitle", "time": 13671.59, "timestamp": "03:47:51", "text": "展示。这就是我这么做的主要原因。"}, {"type": "subtitle", "time": 13674.51, "timestamp": "03:47:54", "text": "这次马拉松式的谈话。不仅仅是为了寻求"}, {"type": "subtitle", "time": 13678.07, "timestamp": "03:47:58", "text": "为支持我出道的原因而筹集资金"}]
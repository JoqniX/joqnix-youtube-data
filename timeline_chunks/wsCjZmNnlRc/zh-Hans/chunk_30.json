[{"type": "subtitle", "time": 1805.43, "timestamp": "00:30:05", "text": "呃，我以为我读过了。啊，那是一个"}, {"type": "subtitle", "time": 1807.63, "timestamp": "00:30:07", "text": "Twitch上不同的观众，"}, {"type": "subtitle", "time": 1809.149, "timestamp": "00:30:09", "text": "实际上。"}, {"type": "subtitle", "time": 1811.99, "timestamp": "00:30:11", "text": "节奏饱满有力。"}, {"type": "subtitle", "time": 1814.95, "timestamp": "00:30:14", "text": "节奏饱满。是的。对不起，《卫报》。"}, {"type": "subtitle", "time": 1831.75, "timestamp": "00:30:31", "text": "嗯，不错。"}, {"type": "subtitle", "time": 1835.269, "timestamp": "00:30:35", "text": "嗯，这种情况真的很少见。"}, {"type": "subtitle", "time": 1843.549, "timestamp": "00:30:43", "text": "这。非常罕见。但"}, {"type": "subtitle", "time": 1852.87, "timestamp": "00:30:52", "text": "我的意思是，当个先生挺好的。"}]
[{"type": "subtitle", "time": 8340.23, "timestamp": "02:19:00", "text": "化身，其中一些化身拥有"}, {"type": "subtitle", "time": 8342.509, "timestamp": "02:19:02", "text": "积累了大量粉丝"}, {"type": "subtitle", "time": 8344.99, "timestamp": "02:19:04", "text": "下列的。贝努·西"}, {"type": "subtitle", "time": 8348.07, "timestamp": "02:19:08", "text": "乔希，著名作家和创始人"}, {"type": "subtitle", "time": 8351.509, "timestamp": "02:19:11", "text": "印度虚拟主播人才经纪公司项目"}, {"type": "subtitle", "time": 8353.83, "timestamp": "02:19:13", "text": "星空显示，这一趋势正在兴起"}, {"type": "subtitle", "time": 8356.549, "timestamp": "02:19:16", "text": "在印度，co9 期间的受欢迎程度"}, {"type": "subtitle", "time": 8360.309, "timestamp": "02:19:20", "text": "大流行。 Jock Nexus 的创建者希望"}, {"type": "subtitle", "time": 8363.11, "timestamp": "02:19:23", "text": "仅以数字化身的身份为人所知"}, {"type": "subtitle", "time": 8364.87, "timestamp": "02:19:24", "text": "据估计，有超过90个"}, {"type": "subtitle", "time": 8368.07, "timestamp": "02:19:28", "text": "印度的虚拟主播真的存在。他坚持认为"}, {"type": "subtitle", "time": 8369.87, "timestamp": "02:19:29", "text": "印度人名单"}, {"type": "subtitle", "time": 8373.27, "timestamp": "02:19:33", "text": "VTuber 在 Twitter 上，并且是版主"}, {"type": "subtitle", "time": 8376.23, "timestamp": "02:19:36", "text": "Discord 服务器和在线空间"}, {"type": "subtitle", "time": 8378.549, "timestamp": "02:19:38", "text": "志同道合的人可以互相交流"}, {"type": "subtitle", "time": 8380.79, "timestamp": "02:19:40", "text": "其他方式则通过视频和文字聊天进行。"}, {"type": "subtitle", "time": 8384.629, "timestamp": "02:19:44", "text": "社区。我看到了Discord的管理员。"}, {"type": "subtitle", "time": 8388.79, "timestamp": "02:19:48", "text": "这种现象尚未成为主流。"}, {"type": "subtitle", "time": 8390.95, "timestamp": "02:19:50", "text": "在印度很受欢迎，但参与者"}, {"type": "subtitle", "time": 8394.07, "timestamp": "02:19:54", "text": "希望这种情况很快就能改变。英国广播公司"}, {"type": "subtitle", "time": 8396.55, "timestamp": "02:19:56", "text": "我采访了一些印度虚拟主播。"}, {"type": "subtitle", "time": 8399.03, "timestamp": "02:19:59", "text": "账户可以更好地改善这一趋势及其吸引力"}]
[{"type": "subtitle", "time": 1500.23, "timestamp": "00:25:00", "text": "泰国。以上任何一种都有可能。"}, {"type": "subtitle", "time": 1504.549, "timestamp": "00:25:04", "text": "哦，然后就跟……一样了"}, {"type": "subtitle", "time": 1507.669, "timestamp": "00:25:07", "text": "通常北京人会补充说"}, {"type": "subtitle", "time": 1511.51, "timestamp": "00:25:11", "text": "他们的呃演讲。所以我就说，你滚动"}, {"type": "subtitle", "time": 1518.71, "timestamp": "00:25:18", "text": "唉，总有一天我会变得更强。"}, {"type": "subtitle", "time": 1521.43, "timestamp": "00:25:21", "text": "等我流利到一定程度再学习"}, {"type": "subtitle", "time": 1524.47, "timestamp": "00:25:24", "text": "像个能说会道的人一样"}, {"type": "subtitle", "time": 1527.35, "timestamp": "00:25:27", "text": "如果口语汉语水平达到一定程度，那么我们应该"}, {"type": "subtitle", "time": 1530.07, "timestamp": "00:25:30", "text": "用中文或其他语言说。不，不"}, {"type": "subtitle", "time": 1531.909, "timestamp": "00:25:31", "text": "担忧。不用担心。我听说"}, {"type": "subtitle", "time": 1544.63, "timestamp": "00:25:44", "text": "呃，你想先学什么？我"}, {"type": "subtitle", "time": 1546.029, "timestamp": "00:25:46", "text": "我可以吗？我可以"}, {"type": "subtitle", "time": 1549.19, "timestamp": "00:25:49", "text": "或许会先开始。"}, {"type": "subtitle", "time": 1552.47, "timestamp": "00:25:52", "text": "不，我想学中文，但是"}, {"type": "subtitle", "time": 1554.95, "timestamp": "00:25:54", "text": "呃，我现在正在学习日语。"}, {"type": "subtitle", "time": 1556.549, "timestamp": "00:25:56", "text": "我将去日本学习"}, {"type": "subtitle", "time": 1559.029, "timestamp": "00:25:59", "text": "现在是日本人了。等等，我有没有跟你说过……"}]
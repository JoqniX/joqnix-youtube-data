[{"type": "subtitle", "time": 3482.15, "timestamp": "00:58:02", "text": "药剂师 药剂师日记系列。这"}, {"type": "subtitle", "time": 3483.87, "timestamp": "00:58:03", "text": "才华横溢之人的私生女"}, {"type": "subtitle", "time": 3488.109, "timestamp": "00:58:08", "text": "古怪的……呃，等等……"}, {"type": "subtitle", "time": 3491.51, "timestamp": "00:58:11", "text": "它？哦，说实话，应该是L。"}, {"type": "subtitle", "time": 3498.549, "timestamp": "00:58:18", "text": "土地。不，不，Shoku。呃，她住在……"}, {"type": "subtitle", "time": 3500.47, "timestamp": "00:58:20", "text": "直到她来到红灯区。"}, {"type": "chat", "time": 3502.43, "timestamp": "00:58:22", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "cuties ~"}, {"type": "subtitle", "time": 3502.63, "timestamp": "00:58:22", "text": "被强盗绑架并贩卖。她"}, {"type": "subtitle", "time": 3504.069, "timestamp": "00:58:24", "text": "突然发现自己从事着一份工作"}, {"type": "subtitle", "time": 3511.87, "timestamp": "00:58:31", "text": "哦"}, {"type": "subtitle", "time": 3515.27, "timestamp": "00:58:35", "text": "或"}, {"type": "chat", "time": 3517.705, "timestamp": "00:58:37", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "XD"}, {"type": "subtitle", "time": 3518.309, "timestamp": "00:58:38", "text": "呃，在那里她能够利用她的"}, {"type": "subtitle", "time": 3521.109, "timestamp": "00:58:41", "text": "务实精神，敏锐的推理能力"}, {"type": "subtitle", "time": 3523.349, "timestamp": "00:58:43", "text": "以及对草药的深刻理解和丰富的知识"}, {"type": "subtitle", "time": 3525.27, "timestamp": "00:58:45", "text": "疾病，解开神秘谜团"}, {"type": "subtitle", "time": 3527.43, "timestamp": "00:58:47", "text": "内在和外在的问题"}, {"type": "subtitle", "time": 3528.91, "timestamp": "00:58:48", "text": "法院。"}, {"type": "subtitle", "time": 3533.91, "timestamp": "00:58:53", "text": "So Mo今年17岁，18岁时出道。"}, {"type": "subtitle", "time": 3537.109, "timestamp": "00:58:57", "text": "轻小说2、19，轻小说5、20"}]
[{"type": "subtitle", "time": 1140.669, "timestamp": "00:19:00", "text": "将在"}, {"type": "subtitle", "time": 1145.19, "timestamp": "00:19:05", "text": "呃，东西在哪儿？大概就在……"}, {"type": "subtitle", "time": 1160.789, "timestamp": "00:19:20", "text": "另外，出于好奇，他们是男的吗？"}, {"type": "subtitle", "time": 1165.11, "timestamp": "00:19:25", "text": "或者是个女孩？那是个女孩。是的。"}, {"type": "subtitle", "time": 1184.789, "timestamp": "00:19:44", "text": "但如果可能的话，我希望能合作。"}, {"type": "subtitle", "time": 1186.39, "timestamp": "00:19:46", "text": "和他们一起。这会很有趣"}, {"type": "subtitle", "time": 1188.47, "timestamp": "00:19:48", "text": "查看。"}, {"type": "subtitle", "time": 1190.549, "timestamp": "00:19:50", "text": "是的。你有他们的护照之类的东西吗？"}, {"type": "subtitle", "time": 1192.23, "timestamp": "00:19:52", "text": "他们怎么做？你怎么做？一个人"}, {"type": "subtitle", "time": 1194.07, "timestamp": "00:19:54", "text": "接触？"}, {"type": "subtitle", "time": 1197.19, "timestamp": "00:19:57", "text": "我直接在Billy Billy上给他们发了私信。"}]
[{"type": "subtitle", "time": 16682.22, "timestamp": "04:38:02", "text": "什么？什么的母亲？"}, {"type": "subtitle", "time": 16687.67, "timestamp": "04:38:07", "text": "[音乐]"}, {"type": "subtitle", "time": 16689.83, "timestamp": "04:38:09", "text": "农村。我们的跑步者带来了"}, {"type": "subtitle", "time": 16693.59, "timestamp": "04:38:13", "text": "身负重伤、神志不清的男人们胡言乱语"}, {"type": "subtitle", "time": 16696.31, "timestamp": "04:38:16", "text": "关于对病毒免疫的人群。他曾"}, {"type": "subtitle", "time": 16700.31, "timestamp": "04:38:20", "text": "一张显示离开哈兰路线的地图。那里"}, {"type": "subtitle", "time": 16702.551, "timestamp": "04:38:22", "text": "这里病人越来越多。不是"}, {"type": "subtitle", "time": 16705.91, "timestamp": "04:38:25", "text": "安德森和卡姆登的研究就到此为止吧。"}, {"type": "subtitle", "time": 16708.39, "timestamp": "04:38:28", "text": "尚未取得任何成果。我们得去"}, {"type": "subtitle", "time": 16712.23, "timestamp": "04:38:32", "text": "检查每一片叶子。你好。去。"}, {"type": "subtitle", "time": 16713.99, "timestamp": "04:38:33", "text": "我的武器装备都带齐了吗？我认为"}, {"type": "subtitle", "time": 16717.39, "timestamp": "04:38:37", "text": "我没有，对吧？我愿意。我的天啊。我们开始吧"}, {"type": "subtitle", "time": 16721.949, "timestamp": "04:38:41", "text": "去。我确实有武器和作战空间。"}, {"type": "subtitle", "time": 16726.15, "timestamp": "04:38:46", "text": "枪。我的天哪，我好想你。我的空间"}, {"type": "subtitle", "time": 16728.67, "timestamp": "04:38:48", "text": "重力"}, {"type": "subtitle", "time": 16733.15, "timestamp": "04:38:53", "text": "枪。你应该让我感受到你的敏感"}, {"type": "subtitle", "time": 16735.75, "timestamp": "04:38:55", "text": "改变了。已经很久没……"}]
[{"type": "subtitle", "time": 2220.069, "timestamp": "00:37:00", "text": "哇，那真是太好了。那是"}, {"type": "subtitle", "time": 2222.55, "timestamp": "00:37:02", "text": "非常热情好客。嗯，让我看看……"}, {"type": "subtitle", "time": 2224.15, "timestamp": "00:37:04", "text": "他们有推特之类的账号。他们的"}, {"type": "subtitle", "time": 2228.87, "timestamp": "00:37:08", "text": "下一次直播时间是周四凌晨2点30分。"}, {"type": "subtitle", "time": 2233.75, "timestamp": "00:37:13", "text": "嗯，凌晨2点30分（美国东部时间），但它被称为"}, {"type": "subtitle", "time": 2242.349, "timestamp": "00:37:22", "text": "等等，那不是音乐吗？等等，等等，"}, {"type": "subtitle", "time": 2245.03, "timestamp": "00:37:25", "text": "等待。哦，哇。就像在流媒体上观看所有内容一样"}, {"type": "subtitle", "time": 2247.27, "timestamp": "00:37:27", "text": "我猜是星期四。让我看看"}, {"type": "subtitle", "time": 2249.31, "timestamp": "00:37:29", "text": "这"}, {"type": "subtitle", "time": 2253.19, "timestamp": "00:37:33", "text": "片段。显示所有片段。哦，没有视频片段。"}, {"type": "subtitle", "time": 2257.03, "timestamp": "00:37:37", "text": "他们是为新频道准备的。我觉得"}, {"type": "subtitle", "time": 2259.43, "timestamp": "00:37:39", "text": "Momo已离线。保持冷静，过来吧"}, {"type": "subtitle", "time": 2261.109, "timestamp": "00:37:41", "text": "稍后再回来。所以，如果你们"}, {"type": "subtitle", "time": 2263.589, "timestamp": "00:37:43", "text": "不知道，它就像一颗草莓。"}, {"type": "subtitle", "time": 2266.19, "timestamp": "00:37:46", "text": "胳膊和腿，还有那个悠闲自在的家伙"}, {"type": "subtitle", "time": 2269.95, "timestamp": "00:37:49", "text": "在"}, {"type": "subtitle", "time": 2272.39, "timestamp": "00:37:52", "text": "背景。我说的“冷静的人”是指……"}, {"type": "subtitle", "time": 2274.63, "timestamp": "00:37:54", "text": "不知何故站着的狗。"}]
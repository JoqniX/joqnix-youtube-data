[{"type": "subtitle", "time": 18360.07, "timestamp": "05:06:00", "text": "道路。"}, {"type": "subtitle", "time": 18363.43, "timestamp": "05:06:03", "text": "艾莉·凯尔·克莱恩·埃斯基，你能给我"}, {"type": "subtitle", "time": 18365.35, "timestamp": "05:06:05", "text": "至少给点提示吧？你们怎么看？"}, {"type": "subtitle", "time": 18367.99, "timestamp": "05:06:07", "text": "需要？我想我或许能帮上忙。"}, {"type": "subtitle", "time": 18370.07, "timestamp": "05:06:10", "text": "记住，你必须归还"}, {"type": "subtitle", "time": 18374.55, "timestamp": "05:06:14", "text": "总有一天会得到恩惠。一天。好的，明白了。"}, {"type": "subtitle", "time": 18376.31, "timestamp": "05:06:16", "text": "地下水污染已有一段时间了。"}, {"type": "subtitle", "time": 18378.628, "timestamp": "05:06:18", "text": "后退。想象一下如果你……会发生什么"}, {"type": "subtitle", "time": 18380.55, "timestamp": "05:06:20", "text": "水又恢复供应了。我假设"}, {"type": "subtitle", "time": 18383.43, "timestamp": "05:06:23", "text": "有办法做到这一点。是的，那里"}, {"type": "subtitle", "time": 18385.27, "timestamp": "05:06:25", "text": "是。我没做过多少管道工程。"}, {"type": "subtitle", "time": 18388.31, "timestamp": "05:06:28", "text": "在这场游戏中。在竞选活动中。我知道"}, {"type": "subtitle", "time": 18390.47, "timestamp": "05:06:30", "text": "去那里。我的天哪，太多了"}, {"type": "subtitle", "time": 18393.67, "timestamp": "05:06:33", "text": "许多任务都是为了解决这个问题，除非你"}, {"type": "subtitle", "time": 18395.11, "timestamp": "05:06:35", "text": "有人去世了。我想那只有一个。"}, {"type": "subtitle", "time": 18396.708, "timestamp": "05:06:36", "text": "任务，对吧？然后只需按照以下步骤操作即可。"}, {"type": "subtitle", "time": 18402.35, "timestamp": "05:06:42", "text": "打开"}, {"type": "subtitle", "time": 18405.35, "timestamp": "05:06:45", "text": "管道经过电力故障"}, {"type": "subtitle", "time": 18407.55, "timestamp": "05:06:47", "text": "领域或"}, {"type": "subtitle", "time": 18409.31, "timestamp": "05:06:49", "text": "某物。"}, {"type": "subtitle", "time": 18413.23, "timestamp": "05:06:53", "text": "是的。开车前往抽水站。"}, {"type": "subtitle", "time": 18416.55, "timestamp": "05:06:56", "text": "好的。嘿，这人是谁？"}, {"type": "subtitle", "time": 18418.67, "timestamp": "05:06:58", "text": "她是我们升级的目标吗？"}]
[{"type": "subtitle", "time": 17102.91, "timestamp": "04:45:02", "text": "想说对，让我来做"}, {"type": "subtitle", "time": 17106.43, "timestamp": "04:45:06", "text": "那。跳入水中。你说"}, {"type": "subtitle", "time": 17110.55, "timestamp": "04:45:10", "text": "不。跳入水中。这是跳入"}, {"type": "subtitle", "time": 17118.43, "timestamp": "04:45:18", "text": "难道不是吗？实际上，它是跳进……"}, {"type": "subtitle", "time": 17120.99, "timestamp": "04:45:20", "text": "水。"}, {"type": "subtitle", "time": 17123.15, "timestamp": "04:45:23", "text": "不。什么是"}, {"type": "subtitle", "time": 17127.11, "timestamp": "04:45:27", "text": "这？哦，那是药水。"}, {"type": "subtitle", "time": 17128.83, "timestamp": "04:45:28", "text": "他是吗？"}, {"type": "subtitle", "time": 17132.03, "timestamp": "04:45:32", "text": "僵尸？他是一个"}, {"type": "subtitle", "time": 17153.708, "timestamp": "04:45:53", "text": "铰链。好多僵尸啊！"}, {"type": "subtitle", "time": 17157.43, "timestamp": "04:45:57", "text": "男人。什么？"}]
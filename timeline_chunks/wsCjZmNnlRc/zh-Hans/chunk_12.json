[{"type": "subtitle", "time": 721.47, "timestamp": "00:12:01", "text": "谈过了。是的，很多事情"}, {"type": "subtitle", "time": 723.829, "timestamp": "00:12:03", "text": "发生了。我还能听到。我可以听听吗？"}, {"type": "subtitle", "time": 726.79, "timestamp": "00:12:06", "text": "发生了吗？当然可以。当然。嗯，很多"}, {"type": "subtitle", "time": 729.509, "timestamp": "00:12:09", "text": "事情发生了。不，我想上次"}, {"type": "subtitle", "time": 731.269, "timestamp": "00:12:11", "text": "我们从哪里开始？什么？我做了什么"}, {"type": "subtitle", "time": 736.49, "timestamp": "00:12:16", "text": "跟你说说去年的事吧？最后我没有"}, {"type": "subtitle", "time": 738.35, "timestamp": "00:12:18", "text": "[音乐]"}, {"type": "subtitle", "time": 741.829, "timestamp": "00:12:21", "text": "记起。我不知道。是的，我想"}, {"type": "subtitle", "time": 745.75, "timestamp": "00:12:25", "text": "嗯，我想起来了。呃，上次是"}, {"type": "subtitle", "time": 748.389, "timestamp": "00:12:28", "text": "是我在谈论比利·比利"}, {"type": "subtitle", "time": 750.629, "timestamp": "00:12:30", "text": "东西。不，是我想在那里直播。"}, {"type": "subtitle", "time": 754.71, "timestamp": "00:12:34", "text": "哦，是的。是的。是的。制作比利"}, {"type": "subtitle", "time": 756.71, "timestamp": "00:12:36", "text": "比利账户也一样。这就是笑点所在"}, {"type": "subtitle", "time": 759.71, "timestamp": "00:12:39", "text": "事物。"}, {"type": "subtitle", "time": 764.35, "timestamp": "00:12:44", "text": "是的。嗯，关于那件事的最新消息。"}, {"type": "subtitle", "time": 767.91, "timestamp": "00:12:47", "text": "我一直在直播 Joathon"}, {"type": "subtitle", "time": 771.069, "timestamp": "00:12:51", "text": "东西。我开始在那里直播，"}, {"type": "subtitle", "time": 773.31, "timestamp": "00:12:53", "text": "东西，但是"}, {"type": "subtitle", "time": 777.35, "timestamp": "00:12:57", "text": "不幸的是，就在两天前"}]
[{"type": "subtitle", "time": 17461.11, "timestamp": "04:51:01", "text": "什么？面包在哪儿？好的，我们得到"}, {"type": "subtitle", "time": 17463.99, "timestamp": "04:51:03", "text": "大概是吧。我认为这位女士会帮忙的。"}, {"type": "subtitle", "time": 17471.83, "timestamp": "04:51:11", "text": "该死的。我身处一片荒芜之地。"}, {"type": "subtitle", "time": 17474.868, "timestamp": "04:51:14", "text": "嘿。对，你过来。嗯，这个人"}, {"type": "subtitle", "time": 17477.35, "timestamp": "04:51:17", "text": "会有帮助的。靠近些。我不会咬人。"}, {"type": "subtitle", "time": 17479.83, "timestamp": "04:51:19", "text": "你。我认为他是在卖商品或者"}, {"type": "subtitle", "time": 17482.39, "timestamp": "04:51:22", "text": "某物。查看所有门。木制的"}, {"type": "subtitle", "time": 17485.51, "timestamp": "04:51:25", "text": "装满东西的箱子或板条箱。所以，你不是"}, {"type": "subtitle", "time": 17488.708, "timestamp": "04:51:28", "text": "其中一个？我认为他就是商人。"}, {"type": "subtitle", "time": 17491.11, "timestamp": "04:51:31", "text": "最有可能的。我卖的东西可不止这些。"}, {"type": "subtitle", "time": 17493.99, "timestamp": "04:51:33", "text": "面包。顺便说一下，我叫可汗。可汗。"}, {"type": "subtitle", "time": 17496.948, "timestamp": "04:51:36", "text": "起重机。嘿，你是哈兰人，对吧？"}, {"type": "subtitle", "time": 17498.788, "timestamp": "04:51:38", "text": "我敢打赌你肯定遇到过我那位视力障碍的朋友。"}, {"type": "subtitle", "time": 17500.708, "timestamp": "04:51:40", "text": "伙伴。你是说那个有只眼睛的家伙吗？"}, {"type": "subtitle", "time": 17502.708, "timestamp": "04:51:42", "text": "丢失的？对，就是那个。我的男孩"}, {"type": "subtitle", "time": 17505.75, "timestamp": "04:51:45", "text": "库尔特。好的。"}, {"type": "subtitle", "time": 17510.788, "timestamp": "04:51:50", "text": "哦，他……呃，是的，他……他没能成功。"}, {"type": "subtitle", "time": 17514.708, "timestamp": "04:51:54", "text": "真是太可惜了，不过可以说……"}, {"type": "subtitle", "time": 17517.51, "timestamp": "04:51:57", "text": "我很惊讶。哦，那个人是他的。"}, {"type": "subtitle", "time": 17519.99, "timestamp": "04:51:59", "text": "这里的人都免疫，他们的名字是……"}]
[{"type": "subtitle", "time": 9060.71, "timestamp": "02:31:00", "text": "碎成碎片。你为什么要煮沸它？"}, {"type": "subtitle", "time": 9062.55, "timestamp": "02:31:02", "text": "香蕉？"}, {"type": "subtitle", "time": 9065.27, "timestamp": "02:31:05", "text": "香蕉是煮不熟的。煮沸"}, {"type": "subtitle", "time": 9066.35, "timestamp": "02:31:06", "text": "香蕉。可口"}, {"type": "chat", "time": 9066.936, "timestamp": "02:31:06", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "boil a banana??????"}, {"type": "subtitle", "time": 9077.389, "timestamp": "02:31:17", "text": "确实如此，对吧？你不吃煮熟的"}, {"type": "subtitle", "time": 9082.51, "timestamp": "02:31:22", "text": "香蕉。蒸熟后就可以吃了"}, {"type": "chat", "time": 9082.628, "timestamp": "02:31:22", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "wut will u make with a boiled banana??"}, {"type": "subtitle", "time": 9085.67, "timestamp": "02:31:25", "text": "它。不要做小香蕉那个。你"}, {"type": "subtitle", "time": 9087.75, "timestamp": "02:31:27", "text": "必须接受最大的挑战。我忘了什么"}, {"type": "subtitle", "time": 9088.59, "timestamp": "02:31:28", "text": "类型"}, {"type": "subtitle", "time": 9105.07, "timestamp": "02:31:45", "text": "它。是的。把它切进去"}, {"type": "subtitle", "time": 9109.51, "timestamp": "02:31:49", "text": "件。碎片组成的圆圈。拿一把叉子。我"}, {"type": "subtitle", "time": 9112.309, "timestamp": "02:31:52", "text": "讨厌。"}]
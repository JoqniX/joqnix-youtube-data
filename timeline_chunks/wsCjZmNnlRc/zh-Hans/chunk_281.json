[{"type": "subtitle", "time": 16865.11, "timestamp": "04:41:05", "text": "我的天哪，世界真大。"}, {"type": "subtitle", "time": 16868.07, "timestamp": "04:41:08", "text": "莉娜，收到请回答？那太模糊了"}, {"type": "subtitle", "time": 16872.868, "timestamp": "04:41:12", "text": "听着。你那独眼谵妄"}, {"type": "subtitle", "time": 16874.47, "timestamp": "04:41:14", "text": "病人。他说的是实话。那里"}, {"type": "subtitle", "time": 16876.23, "timestamp": "04:41:16", "text": "这是一条出路。也许他说的那些话"}, {"type": "subtitle", "time": 16878.868, "timestamp": "04:41:18", "text": "那些不悔改的人是真的。他去世了"}, {"type": "subtitle", "time": 16881.91, "timestamp": "04:41:21", "text": "今天早上，凯尔。他发烧了。"}, {"type": "subtitle", "time": 16885.83, "timestamp": "04:41:25", "text": "你是发烧之神。不。找个……"}, {"type": "subtitle", "time": 16890.23, "timestamp": "04:41:30", "text": "他知道这个传闻。好的，莉娜。这"}, {"type": "subtitle", "time": 16893.27, "timestamp": "04:41:33", "text": "感觉真好。该死的山。你"}, {"type": "subtitle", "time": 16894.788, "timestamp": "04:41:34", "text": "想象一下，如果你正在跳跃"}, {"type": "subtitle", "time": 16898.19, "timestamp": "04:41:38", "text": "像这样的山。这是我的梦想"}, {"type": "subtitle", "time": 16902.07, "timestamp": "04:41:42", "text": "跑酷。我的天哪。想象一下"}, {"type": "subtitle", "time": 16904.868, "timestamp": "04:41:44", "text": "如果有一天我能学会跑酷的话，对吧？我"}, {"type": "subtitle", "time": 16908.83, "timestamp": "04:41:48", "text": "我非常喜欢。太酷了。那些"}, {"type": "subtitle", "time": 16912.11, "timestamp": "04:41:52", "text": "跑酷也就那样吧"}, {"type": "subtitle", "time": 16915.39, "timestamp": "04:41:55", "text": "好的。就像字面上那样"}]
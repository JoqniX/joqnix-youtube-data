[{"type": "subtitle", "time": 17041.91, "timestamp": "04:44:01", "text": "真的。我觉得我不应该去"}, {"type": "subtitle", "time": 17049.15, "timestamp": "04:44:09", "text": "我好像忘了似的"}, {"type": "subtitle", "time": 17061.788, "timestamp": "04:44:21", "text": "它。哦，就像"}, {"type": "subtitle", "time": 17065.55, "timestamp": "04:44:25", "text": "是的。什么？这也算是一种"}, {"type": "subtitle", "time": 17069.59, "timestamp": "04:44:29", "text": "分数全没了。不。"}, {"type": "subtitle", "time": 17071.51, "timestamp": "04:44:31", "text": "太阳之子身着独特的服饰"}, {"type": "subtitle", "time": 17074.39, "timestamp": "04:44:34", "text": "佩戴臂章并识别其他愿意提供帮助的人"}, {"type": "subtitle", "time": 17075.91, "timestamp": "04:44:35", "text": "阿朗的人会给你带来收入"}, {"type": "subtitle", "time": 17078.07, "timestamp": "04:44:38", "text": "儿童信托"}, {"type": "subtitle", "time": 17085.07, "timestamp": "04:44:45", "text": "什么？我的天啊。我该怎么做？"}, {"type": "subtitle", "time": 17088.15, "timestamp": "04:44:48", "text": "这？我看到的只有绿色。好的，我"}, {"type": "subtitle", "time": 17090.75, "timestamp": "04:44:50", "text": "我觉得就是这样。那"}, {"type": "subtitle", "time": 17094.11, "timestamp": "04:44:54", "text": "方式。随时可以跳进去"}, {"type": "subtitle", "time": 17096.75, "timestamp": "04:44:56", "text": "水。不，那不会的。"}, {"type": "subtitle", "time": 17099.67, "timestamp": "04:44:59", "text": "工作。等等，这样行得通吗？我只是"}]
[{"type": "subtitle", "time": 18782.47, "timestamp": "05:13:02", "text": "人们？这个？不。"}, {"type": "subtitle", "time": 18791.31, "timestamp": "05:13:11", "text": "这不是我要找的那一个。"}, {"type": "subtitle", "time": 18794.75, "timestamp": "05:13:14", "text": "呃，等等。怎么样，好的，明白了"}, {"type": "subtitle", "time": 18801.43, "timestamp": "05:13:21", "text": "不，我当时正试图切换到……"}, {"type": "subtitle", "time": 18804.15, "timestamp": "05:13:24", "text": "用抓钩抓住那个……"}, {"type": "subtitle", "time": 18807.19, "timestamp": "05:13:27", "text": "路灯之类的东西，但是它是"}, {"type": "subtitle", "time": 18810.43, "timestamp": "05:13:30", "text": "美好的。我认为它本来就会有"}, {"type": "subtitle", "time": 18814.67, "timestamp": "05:13:34", "text": "已保存。我想，我猜是哦，不。就是这样"}, {"type": "subtitle", "time": 18816.43, "timestamp": "05:13:36", "text": "没有，"}, {"type": "subtitle", "time": 18818.788, "timestamp": "05:13:38", "text": "男人。好吧，行。至少我能得到"}]
[{"type": "subtitle", "time": 17341.15, "timestamp": "04:49:01", "text": "谷仓。好的，"}, {"type": "subtitle", "time": 17345.27, "timestamp": "04:49:05", "text": "谢谢你，兄弟。他是最后一个吗？"}, {"type": "subtitle", "time": 17346.788, "timestamp": "04:49:06", "text": "还有其他人吗？我想我会说的"}, {"type": "subtitle", "time": 17349.83, "timestamp": "04:49:09", "text": "也向这个拿步枪的人开枪。"}, {"type": "subtitle", "time": 17352.868, "timestamp": "04:49:12", "text": "允许从那个位置向上攀爬。"}, {"type": "subtitle", "time": 17362.708, "timestamp": "04:49:22", "text": "好了，这个人就是他。这个人。"}, {"type": "subtitle", "time": 17363.55, "timestamp": "04:49:23", "text": "这"}, {"type": "subtitle", "time": 17367.59, "timestamp": "04:49:27", "text": "男。等等，这不是债券吗？你好？"}, {"type": "subtitle", "time": 17369.07, "timestamp": "04:49:29", "text": "什么是"}, {"type": "subtitle", "time": 17372.27, "timestamp": "04:49:32", "text": "禁止？这"}, {"type": "subtitle", "time": 17375.03, "timestamp": "04:49:35", "text": "一。博拉，你需要什么吗？你是"}, {"type": "subtitle", "time": 17376.47, "timestamp": "04:49:36", "text": "负责人？我需要一些帮助。"}, {"type": "subtitle", "time": 17393.03, "timestamp": "04:49:53", "text": "感觉很好。这是谁？哦。哦，我们有"}]
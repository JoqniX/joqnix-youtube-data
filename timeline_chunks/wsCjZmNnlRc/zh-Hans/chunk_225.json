[{"type": "subtitle", "time": 13501.59, "timestamp": "03:45:01", "text": "指着这边。这就是为什么"}, {"type": "subtitle", "time": 13502.99, "timestamp": "03:45:02", "text": "重要的"}, {"type": "subtitle", "time": 13507.95, "timestamp": "03:45:07", "text": "我知道我不配拥有任何权利。"}, {"type": "subtitle", "time": 13511.189, "timestamp": "03:45:11", "text": "我又在用我的……说话了"}, {"type": "subtitle", "time": 13514.469, "timestamp": "03:45:14", "text": "冒名顶替综合症，玩笑模式，但是是的"}, {"type": "subtitle", "time": 13517.67, "timestamp": "03:45:17", "text": "我知道我患上了冒名顶替综合症。"}, {"type": "subtitle", "time": 13518.83, "timestamp": "03:45:18", "text": "那是"}, {"type": "subtitle", "time": 13522.55, "timestamp": "03:45:22", "text": "为什么我想亲眼看看呢？"}, {"type": "subtitle", "time": 13527.51, "timestamp": "03:45:27", "text": "我是否配得上这一切"}, {"type": "subtitle", "time": 13529.63, "timestamp": "03:45:29", "text": "新来的运动员"}, {"type": "subtitle", "time": 13533.309, "timestamp": "03:45:33", "text": "他妈的。我不想它失败。"}, {"type": "subtitle", "time": 13536.469, "timestamp": "03:45:36", "text": "好的。这五年或四年"}, {"type": "subtitle", "time": 13540.63, "timestamp": "03:45:40", "text": "就我而言，我觉得我失败了很多。"}, {"type": "subtitle", "time": 13542.75, "timestamp": "03:45:42", "text": "我不能"}, {"type": "subtitle", "time": 13546.91, "timestamp": "03:45:46", "text": "呃，我想我没怎么工作。"}, {"type": "subtitle", "time": 13549.51, "timestamp": "03:45:49", "text": "越来越难，而且每当我想到……"}, {"type": "subtitle", "time": 13552.229, "timestamp": "03:45:52", "text": "我这四五年来所做的一切"}, {"type": "subtitle", "time": 13554.59, "timestamp": "03:45:54", "text": "这让我感到难过"}]
[{"type": "subtitle", "time": 13140.95, "timestamp": "03:39:00", "text": "嗯，去那里的旅程，所以，是的，我会的。"}, {"type": "subtitle", "time": 13143.469, "timestamp": "03:39:03", "text": "即将前往日本"}, {"type": "subtitle", "time": 13146.95, "timestamp": "03:39:06", "text": "七月。到七月份，我就能到了。以便"}, {"type": "subtitle", "time": 13149.99, "timestamp": "03:39:09", "text": "这意味着我还有四个月的时间。因此，就是这样。"}, {"type": "subtitle", "time": 13152.389, "timestamp": "03:39:12", "text": "本次事件的时间线。我只有"}, {"type": "subtitle", "time": 13155.309, "timestamp": "03:39:15", "text": "从本月开始，为期四个月"}, {"type": "subtitle", "time": 13159.309, "timestamp": "03:39:19", "text": "行进。我有四个月的时间来完成这件事。"}, {"type": "subtitle", "time": 13163.91, "timestamp": "03:39:23", "text": "事件。我将进行直播"}, {"type": "subtitle", "time": 13165.87, "timestamp": "03:39:25", "text": "乔卡顿"}, {"type": "subtitle", "time": 13169.59, "timestamp": "03:39:29", "text": "每天都有活动。我会努力的。它"}, {"type": "subtitle", "time": 13173.429, "timestamp": "03:39:33", "text": "将成为日常小事。天知道。"}, {"type": "subtitle", "time": 13177.15, "timestamp": "03:39:37", "text": "我会一直直播，但我有我的"}, {"type": "subtitle", "time": 13179.99, "timestamp": "03:39:39", "text": "我正在上的课，我正在上课。"}, {"type": "subtitle", "time": 13182.229, "timestamp": "03:39:42", "text": "之前在我的直播中提到过"}, {"type": "subtitle", "time": 13184.469, "timestamp": "03:39:44", "text": "我正在上音乐课，所以我"}, {"type": "subtitle", "time": 13186.71, "timestamp": "03:39:46", "text": "可以专注于音乐，因为那才是最重要的。"}, {"type": "subtitle", "time": 13190.19, "timestamp": "03:39:50", "text": "那是我最初的梦想，与……"}, {"type": "subtitle", "time": 13193.429, "timestamp": "03:39:53", "text": "我这个运动健将想追求音乐，而且我慢慢地"}, {"type": "subtitle", "time": 13196.429, "timestamp": "03:39:56", "text": "这样做是为了追求音乐学习音乐"}, {"type": "subtitle", "time": 13198.87, "timestamp": "03:39:58", "text": "说真的，我还在学习日语。"}]
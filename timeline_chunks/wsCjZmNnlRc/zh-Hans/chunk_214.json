[{"type": "subtitle", "time": 12840.63, "timestamp": "03:34:00", "text": "作品。一个凡人女巫。我把我的"}, {"type": "subtitle", "time": 12842.11, "timestamp": "03:34:02", "text": "一切"}, {"type": "subtitle", "time": 12845.91, "timestamp": "03:34:05", "text": "变成一个凡人女巫。呃，我把所有东西都放进去了。"}, {"type": "subtitle", "time": 12849.55, "timestamp": "03:34:09", "text": "我想要旁边"}, {"type": "subtitle", "time": 12853.91, "timestamp": "03:34:13", "text": "就像……对你们中的许多人来说……谁"}, {"type": "subtitle", "time": 12856.229, "timestamp": "03:34:16", "text": "正在观看新的……呃……是谁……是谁……新"}, {"type": "subtitle", "time": 12858.55, "timestamp": "03:34:18", "text": "你可能已经关注过这个频道，或者你一直……"}, {"type": "subtitle", "time": 12860.75, "timestamp": "03:34:20", "text": "观察了我一会儿，你知道的。"}, {"type": "subtitle", "time": 12863.95, "timestamp": "03:34:23", "text": "很多医生呃"}, {"type": "subtitle", "time": 12866.87, "timestamp": "03:34:26", "text": "它本身对我意义重大。它不是"}, {"type": "subtitle", "time": 12868.87, "timestamp": "03:34:28", "text": "只是一个名字。这不仅仅是一个虚拟主播。"}, {"type": "subtitle", "time": 12871.67, "timestamp": "03:34:31", "text": "角色扮演。"}, {"type": "subtitle", "time": 12875.63, "timestamp": "03:34:35", "text": "不，不，不，不。早在呕吐之前，"}, {"type": "subtitle", "time": 12878.79, "timestamp": "03:34:38", "text": "Jocknik 对我意义非凡。那是我的"}, {"type": "subtitle", "time": 12880.51, "timestamp": "03:34:40", "text": "血与魂，我"}, {"type": "subtitle", "time": 12884.389, "timestamp": "03:34:44", "text": "猜测。而所有这些年，你"}, {"type": "subtitle", "time": 12886.309, "timestamp": "03:34:46", "text": "或许能看到我有多么……"}, {"type": "subtitle", "time": 12887.79, "timestamp": "03:34:47", "text": "挣扎"}, {"type": "subtitle", "time": 12891.75, "timestamp": "03:34:51", "text": "为了继续当运动员，对吧？我的方式"}, {"type": "subtitle", "time": 12893.95, "timestamp": "03:34:53", "text": "希望乔克能成为那样的人，以及所有的一切。"}, {"type": "subtitle", "time": 12896.71, "timestamp": "03:34:56", "text": "正确的？是的。"}, {"type": "subtitle", "time": 12898.83, "timestamp": "03:34:58", "text": "所以"}]
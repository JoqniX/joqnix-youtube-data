[{"type": "subtitle", "time": 661.11, "timestamp": "00:11:01", "text": "嗯，大概是在我毕业之前吧。"}, {"type": "subtitle", "time": 663.43, "timestamp": "00:11:03", "text": "其实是学校。"}, {"type": "subtitle", "time": 668.47, "timestamp": "00:11:08", "text": "是的，去年。 7月8日。我的天啊。"}, {"type": "subtitle", "time": 673.35, "timestamp": "00:11:13", "text": "哦，2024年7月。真糟糕。该死。"}, {"type": "subtitle", "time": 677.389, "timestamp": "00:11:17", "text": "那已经是很久以前的事了。"}, {"type": "subtitle", "time": 685.11, "timestamp": "00:11:25", "text": "前。是的。那么，最近情况如何呢？"}, {"type": "subtitle", "time": 690.389, "timestamp": "00:11:30", "text": "最近？你好吗？"}, {"type": "subtitle", "time": 692.91, "timestamp": "00:11:32", "text": "动漫问答或漫画"}, {"type": "subtitle", "time": 695.35, "timestamp": "00:11:35", "text": "类似。你想听这些故事吗？"}, {"type": "subtitle", "time": 698.63, "timestamp": "00:11:38", "text": "或者你想……呃……或者……你会……"}, {"type": "subtitle", "time": 700.87, "timestamp": "00:11:40", "text": "想从头开始吗？哦，"}, {"type": "subtitle", "time": 706.31, "timestamp": "00:11:46", "text": "你无法理解你为什么喜欢我。"}, {"type": "subtitle", "time": 708.069, "timestamp": "00:11:48", "text": "不过，你最近怎么样？那是"}, {"type": "subtitle", "time": 710.069, "timestamp": "00:11:50", "text": "这也是个重要的问题。"}, {"type": "subtitle", "time": 713.63, "timestamp": "00:11:53", "text": "我不想错过这件事。"}, {"type": "subtitle", "time": 716.949, "timestamp": "00:11:56", "text": "我？是的，自从我们……以来，已经过去一年了。"}, {"type": "subtitle", "time": 718.03, "timestamp": "00:11:58", "text": "最后的"}]
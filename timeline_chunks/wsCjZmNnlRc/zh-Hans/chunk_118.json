[{"type": "subtitle", "time": 7080.87, "timestamp": "01:58:00", "text": "呃，真是不可思议，居然还有经典的左派。"}, {"type": "subtitle", "time": 7082.189, "timestamp": "01:58:02", "text": "和"}, {"type": "subtitle", "time": 7084.79, "timestamp": "01:58:04", "text": "往下看。"}, {"type": "subtitle", "time": 7096.83, "timestamp": "01:58:16", "text": "[音乐]"}, {"type": "subtitle", "time": 7100.669, "timestamp": "01:58:20", "text": "是的。是的。难道我没有这种感觉吗？"}, {"type": "subtitle", "time": 7103.83, "timestamp": "01:58:23", "text": "如果我太沉默，请不要介意。"}, {"type": "subtitle", "time": 7107.39, "timestamp": "01:58:27", "text": "我。我只是要走了。"}, {"type": "subtitle", "time": 7110.39, "timestamp": "01:58:30", "text": "我真的闭上了眼睛，因为缺乏"}, {"type": "subtitle", "time": 7111.95, "timestamp": "01:58:31", "text": "睡眠"}, {"type": "subtitle", "time": 7115.91, "timestamp": "01:58:35", "text": "现在。我的天啊，"}, {"type": "subtitle", "time": 7118.47, "timestamp": "01:58:38", "text": "它要开始了。"}, {"type": "subtitle", "time": 7129.35, "timestamp": "01:58:49", "text": "我觉得其他动漫都……"}, {"type": "subtitle", "time": 7137.43, "timestamp": "01:58:57", "text": "你有没有看过那部叫做……的动画？"}]
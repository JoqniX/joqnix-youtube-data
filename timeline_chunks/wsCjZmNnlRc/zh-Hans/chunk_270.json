[{"type": "subtitle", "time": 16200.469, "timestamp": "04:30:00", "text": "直播很可能在下周或"}, {"type": "subtitle", "time": 16204.79, "timestamp": "04:30:04", "text": "某物。但是，是的，还有，呃，让"}, {"type": "subtitle", "time": 16209.309, "timestamp": "04:30:09", "text": "我……稍等片刻。等待"}, {"type": "subtitle", "time": 16212.87, "timestamp": "04:30:12", "text": "我该如何弹出这个窗口？"}, {"type": "subtitle", "time": 16216.07, "timestamp": "04:30:16", "text": "我该如何不弄坏它就把它取下来？"}, {"type": "subtitle", "time": 16219.269, "timestamp": "04:30:19", "text": "呃，我该怎么把它取下来而不弄脏它呢？"}, {"type": "subtitle", "time": 16230.67, "timestamp": "04:30:30", "text": "等待。让我干掉这家伙"}, {"type": "subtitle", "time": 16237.149, "timestamp": "04:30:37", "text": "向上。他在哪儿？哦，打开门。打开"}, {"type": "subtitle", "time": 16239.99, "timestamp": "04:30:39", "text": "向上。公开会议。"}, {"type": "subtitle", "time": 16243.429, "timestamp": "04:30:43", "text": "好的。所以对于那些不了解的人来说"}, {"type": "subtitle", "time": 16246.75, "timestamp": "04:30:46", "text": "一直与我保持联系的人"}, {"type": "subtitle", "time": 16251.389, "timestamp": "04:30:51", "text": "你知道，我们即将开始。"}, {"type": "subtitle", "time": 16255.99, "timestamp": "04:30:55", "text": "我们的日程安排又来了。是的，"}, {"type": "subtitle", "time": 16259.309, "timestamp": "04:30:59", "text": "从我们的日程安排开始，就真的要从这里开始。"}]
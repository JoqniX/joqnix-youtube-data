[{"type": "subtitle", "time": 7322.149, "timestamp": "02:02:02", "text": "你想让我提醒你吗？我不想提醒你。"}, {"type": "subtitle", "time": 7326.91, "timestamp": "02:02:06", "text": "原因嘛，哦。哦，我想我我"}, {"type": "subtitle", "time": 7330.55, "timestamp": "02:02:10", "text": "记得那是我的……它很可能是"}, {"type": "subtitle", "time": 7332.35, "timestamp": "02:02:12", "text": "我所在的弧线"}, {"type": "subtitle", "time": 7336.589, "timestamp": "02:02:16", "text": "情绪低落到极点，以至于我"}, {"type": "subtitle", "time": 7339.669, "timestamp": "02:02:19", "text": "想要取代黑暗，或者"}, {"type": "subtitle", "time": 7341.229, "timestamp": "02:02:21", "text": "某物。那是吗？"}, {"type": "subtitle", "time": 7344.95, "timestamp": "02:02:24", "text": "一？我道歉。"}, {"type": "subtitle", "time": 7348.37, "timestamp": "02:02:28", "text": "是的，那是……是的，那是"}, {"type": "subtitle", "time": 7350.27, "timestamp": "02:02:30", "text": "[音乐]"}, {"type": "subtitle", "time": 7353.629, "timestamp": "02:02:33", "text": "某物。哦，我的"}, {"type": "subtitle", "time": 7356.709, "timestamp": "02:02:36", "text": "上帝。等等，其实那是我的名字"}, {"type": "subtitle", "time": 7362.149, "timestamp": "02:02:42", "text": "而不是 Vquin。我的天啊。"}, {"type": "subtitle", "time": 7364.95, "timestamp": "02:02:44", "text": "是的，你确实说过你的"}, {"type": "subtitle", "time": 7368.51, "timestamp": "02:02:48", "text": "不，宝贝。兄弟，这是什么情况？"}, {"type": "subtitle", "time": 7372.87, "timestamp": "02:02:52", "text": "什么？哦，不。哦，我知道有点儿。"}, {"type": "subtitle", "time": 7375.189, "timestamp": "02:02:55", "text": "好的，我不是在人肉搜索你。"}]
[{"type": "subtitle", "time": 2340.31, "timestamp": "00:39:00", "text": "很明白为什么会这样。"}, {"type": "subtitle", "time": 2342.79, "timestamp": "00:39:02", "text": "如果你主动联系别人，那真的很难。"}, {"type": "subtitle", "time": 2345.99, "timestamp": "00:39:05", "text": "通道尺寸很大，而且就像他们"}, {"type": "subtitle", "time": 2349.67, "timestamp": "00:39:09", "text": "把它看作是一件交易性的事情，而不是"}, {"type": "chat", "time": 2352.303, "timestamp": "00:39:12", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Nezuki Wilson Ch.~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 2353.51, "timestamp": "00:39:13", "text": "虽然尺寸比较小。是的。但"}, {"type": "subtitle", "time": 2355.63, "timestamp": "00:39:15", "text": "尽管如此，你还是能够获得很多"}, {"type": "subtitle", "time": 2359.829, "timestamp": "00:39:19", "text": "不同体型的人和我"}, {"type": "subtitle", "time": 2362.55, "timestamp": "00:39:22", "text": "当时的感觉更像是，我当时想，等等，怎么会这样？"}, {"type": "subtitle", "time": 2365.03, "timestamp": "00:39:25", "text": "是神秘人干的吗？其他方面如何？"}, {"type": "subtitle", "time": 2367.51, "timestamp": "00:39:27", "text": "有人会这么做吗？这就像取决于"}, {"type": "subtitle", "time": 2371.27, "timestamp": "00:39:31", "text": "有些人？就像我当时注意到的那样吗？"}, {"type": "subtitle", "time": 2373.75, "timestamp": "00:39:33", "text": "是的，确实有一些 YouTuber 是"}, {"type": "subtitle", "time": 2376.87, "timestamp": "00:39:36", "text": "就像那些进行合作的小主播一样"}, {"type": "subtitle", "time": 2378.39, "timestamp": "00:39:38", "text": "更大的那些，它们就像"}, {"type": "subtitle", "time": 2380.87, "timestamp": "00:39:40", "text": "和他们只是泛泛之交的人"}, {"type": "subtitle", "time": 2382.63, "timestamp": "00:39:42", "text": "美好的。所以他们并不认为这是一个"}, {"type": "subtitle", "time": 2384.95, "timestamp": "00:39:44", "text": "就像你在进行交易一样"}, {"type": "subtitle", "time": 2388.79, "timestamp": "00:39:48", "text": "合作，如果你自己是"}, {"type": "subtitle", "time": 2391.349, "timestamp": "00:39:51", "text": "参加与更大频道的合作"}, {"type": "subtitle", "time": 2394.63, "timestamp": "00:39:54", "text": "以及更大的频道规模及其社区"}, {"type": "subtitle", "time": 2399.39, "timestamp": "00:39:59", "text": "聊天进行得很快，你的聊天就像"}]
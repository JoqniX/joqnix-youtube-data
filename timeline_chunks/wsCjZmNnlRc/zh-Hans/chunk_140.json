[{"type": "subtitle", "time": 8403.11, "timestamp": "02:20:03", "text": "以及目的。哦，Zuchi，对不起。"}, {"type": "subtitle", "time": 8404.349, "timestamp": "02:20:04", "text": "总之，"}, {"type": "subtitle", "time": 8409.19, "timestamp": "02:20:09", "text": "嗯，献给身后创作者铃木零号。"}, {"type": "subtitle", "time": 8412.389, "timestamp": "02:20:12", "text": "你还和她联系吗？是的，我的确"}, {"type": "subtitle", "time": 8415.11, "timestamp": "02:20:15", "text": "还是跟她联系。是的，我参与了合作。"}, {"type": "subtitle", "time": 8417.67, "timestamp": "02:20:17", "text": "最近和她在一起。"}, {"type": "subtitle", "time": 8421.11, "timestamp": "02:20:21", "text": "哦，不错。虚拟直播让她得以逃脱"}, {"type": "subtitle", "time": 8423.51, "timestamp": "02:20:23", "text": "恶毒的网络喷子内容创作者"}, {"type": "subtitle", "time": 8426.15, "timestamp": "02:20:26", "text": "通常情况下，它们确实需要被解锁。"}, {"type": "subtitle", "time": 8428.83, "timestamp": "02:20:28", "text": "我的意思是，最近有很多呃"}, {"type": "subtitle", "time": 8431.67, "timestamp": "02:20:31", "text": "虚拟管。我觉得它使许多人能够……"}, {"type": "subtitle", "time": 8433.99, "timestamp": "02:20:33", "text": "我们，尤其是女性，会尝试各种内容"}, {"type": "subtitle", "time": 8436.15, "timestamp": "02:20:36", "text": "创作而不带任何感情。他"}, {"type": "subtitle", "time": 8437.91, "timestamp": "02:20:37", "text": "他说我不用担心别人。"}, {"type": "subtitle", "time": 8439.59, "timestamp": "02:20:39", "text": "嘲笑我的真实身材或做"}, {"type": "subtitle", "time": 8441.95, "timestamp": "02:20:41", "text": "性别歧视"}, {"type": "subtitle", "time": 8444.309, "timestamp": "02:20:44", "text": "关于虚拟足球的评论。我的天啊，"}, {"type": "subtitle", "time": 8445.67, "timestamp": "02:20:45", "text": "我好久没听说过虚拟足球了。"}, {"type": "subtitle", "time": 8447.67, "timestamp": "02:20:47", "text": "很久。另一方面，上诉"}, {"type": "subtitle", "time": 8449.91, "timestamp": "02:20:49", "text": "VTubing 的范畴在于"}, {"type": "subtitle", "time": 8452.87, "timestamp": "02:20:52", "text": "创意与潮流。可以给予"}, {"type": "subtitle", "time": 8455.11, "timestamp": "02:20:55", "text": "这些虚拟角色有着有趣的背景故事。"}, {"type": "subtitle", "time": 8457.55, "timestamp": "02:20:57", "text": "例如，虚拟樱花就是一个"}]
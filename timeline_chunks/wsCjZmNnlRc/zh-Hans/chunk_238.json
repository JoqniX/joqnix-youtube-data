[{"type": "subtitle", "time": 14280.55, "timestamp": "03:58:00", "text": "索具，我不知道我花了多少钱"}, {"type": "subtitle", "time": 14285.269, "timestamp": "03:58:05", "text": "需要修复那些呃呃的东西"}, {"type": "subtitle", "time": 14287.91, "timestamp": "03:58:07", "text": "至于模型艺术，但我不知道，但是"}, {"type": "subtitle", "time": 14292.15, "timestamp": "03:58:12", "text": "是的，所以一旦我达到那个程度，呃，多少？"}, {"type": "subtitle", "time": 14295.11, "timestamp": "03:58:15", "text": "我想我应该会开始索具安装工作了。"}, {"type": "subtitle", "time": 14297.95, "timestamp": "03:58:17", "text": "我们还会继续进行呃"}, {"type": "subtitle", "time": 14301.99, "timestamp": "03:58:21", "text": "joathon，这样我就可以准备其他事情了。"}, {"type": "subtitle", "time": 14304.229, "timestamp": "03:58:24", "text": "我会尽量不拿那笔钱。"}, {"type": "subtitle", "time": 14306.389, "timestamp": "03:58:26", "text": "我保证不会拿那笔钱。"}, {"type": "subtitle", "time": 14309.67, "timestamp": "03:58:29", "text": "从我的银行账户中。我是我，呃"}, {"type": "subtitle", "time": 14311.75, "timestamp": "03:58:31", "text": "这周我开始整理我的"}, {"type": "subtitle", "time": 14315.51, "timestamp": "03:58:35", "text": "银行账户相关事宜。我保住了银行账户。"}, {"type": "subtitle", "time": 14318.309, "timestamp": "03:58:38", "text": "仅用于此用途。所以我不会"}, {"type": "subtitle", "time": 14320.79, "timestamp": "03:58:40", "text": "从中拿钱。"}, {"type": "subtitle", "time": 14323.51, "timestamp": "03:58:43", "text": "我把一切都给了我爸爸"}, {"type": "subtitle", "time": 14326.55, "timestamp": "03:58:46", "text": "也只是为了呃……给我来个bong。如果我"}, {"type": "subtitle", "time": 14330.15, "timestamp": "03:58:50", "text": "任何事情发生，哪怕只是一分钱"}, {"type": "subtitle", "time": 14333.349, "timestamp": "03:58:53", "text": "从其他什么地方迷路了"}, {"type": "subtitle", "time": 14335.59, "timestamp": "03:58:55", "text": "订阅或其他我用来支付我费用的方式"}, {"type": "subtitle", "time": 14337.429, "timestamp": "03:58:57", "text": "流媒体之类的，我都不要。"}]
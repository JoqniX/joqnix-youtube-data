[{"type": "subtitle", "time": 10262.55, "timestamp": "02:51:02", "text": "人们觉得我很友善。"}, {"type": "subtitle", "time": 10267.19, "timestamp": "02:51:07", "text": "你的听众很奇怪。一些古怪的人，例如"}, {"type": "subtitle", "time": 10269.99, "timestamp": "02:51:09", "text": "呃，来自其他平台的人。不，不是"}, {"type": "chat", "time": 10272.91, "timestamp": "02:51:12", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "dayummmmm we odd"}, {"type": "subtitle", "time": 10273.11, "timestamp": "02:51:13", "text": "在 YouTube 上。不，我尝试过在线观看。"}, {"type": "subtitle", "time": 10274.79, "timestamp": "02:51:14", "text": "不同的平台。在"}, {"type": "chat", "time": 10275.964, "timestamp": "02:51:15", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4"}, {"type": "subtitle", "time": 10277.269, "timestamp": "02:51:17", "text": "Twitch，他称你为上帝。不，不是"}, {"type": "chat", "time": 10279.573, "timestamp": "02:51:19", "author": "@Victor-MrinMoy", "avatar": "https://yt4.ggpht.com/Gaz0C79q_RG4g0C-14BlD7DV4KSkdqrEdWKhEr9EeavJEbCjSnvHS0Wd2lGovXii5XhBOCaWnQ=s64-c-k-c0x00ffffff-no-rj", "message": "we are odd.... :("}, {"type": "subtitle", "time": 10280.71, "timestamp": "02:51:20", "text": "抽搐。不是Twitch。"}, {"type": "chat", "time": 10283.027, "timestamp": "02:51:23", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4"}, {"type": "subtitle", "time": 10284.46
[{"type": "subtitle", "time": 7500.79, "timestamp": "02:05:00", "text": "她说她很聪明，这让我很受用。"}, {"type": "subtitle", "time": 7503.27, "timestamp": "02:05:03", "text": "臭味很小。我可以摸她很久很久"}, {"type": "subtitle", "time": 7512.87, "timestamp": "02:05:12", "text": "等等，什么？是的。通常是较小的"}, {"type": "subtitle", "time": 7519.95, "timestamp": "02:05:19", "text": "微笑"}, {"type": "subtitle", "time": 7524.109, "timestamp": "02:05:24", "text": "微小的。我可能更喜欢好的"}, {"type": "subtitle", "time": 7533.95, "timestamp": "02:05:33", "text": "更小，例如"}, {"type": "chat", "time": 7534.173, "timestamp": "02:05:34", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "with a smile she said \"yes\" and literally 2 seconds later she flipped me on my ahh. I was surprised"}]
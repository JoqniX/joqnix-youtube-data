[{"type": "subtitle", "time": 491.55, "timestamp": "00:08:11", "text": "第二。"}, {"type": "subtitle", "time": 495.189, "timestamp": "00:08:15", "text": "你好。你好，神秘客。"}, {"type": "subtitle", "time": 499.029, "timestamp": "00:08:19", "text": "我很好。你好吗"}, {"type": "subtitle", "time": 501.11, "timestamp": "00:08:21", "text": "正在做？好的。谢谢你的提问。我是"}, {"type": "subtitle", "time": 504.39, "timestamp": "00:08:24", "text": "我猜我们正在直播。是的。"}, {"type": "subtitle", "time": 510.869, "timestamp": "00:08:30", "text": "好的。好的。已经有一段时间了"}, {"type": "subtitle", "time": 513.509, "timestamp": "00:08:33", "text": "我一直都在这里。我的天啊。我是毛。"}, {"type": "subtitle", "time": 520.79, "timestamp": "00:08:40", "text": "是的，你割草了。你想改变它"}, {"type": "subtitle", "time": 523.5889999999999, "timestamp": "00:08:43", "text": "还是别的什么？我会给你，我可以留下吗？"}, {"type": "subtitle", "time": 525.509, "timestamp": "00:08:45", "text": "扮演 Momo？我觉得这其实相当"}, {"type": "subtitle", "time": 527.949, "timestamp": "00:08:47", "text": "可爱的。是的，就是这样。"}, {"type": "subtitle", "time": 531.71, "timestamp": "00:08:51", "text": "是。这是。这是。让我"}]
[{"type": "subtitle", "time": 14760.229, "timestamp": "04:06:00", "text": "在 YouTube 上，请锁定"}, {"type": "subtitle", "time": 14765.59, "timestamp": "04:06:05", "text": "直播，好吗？因为我需要尽可能多的手表"}, {"type": "subtitle", "time": 14769.51, "timestamp": "04:06:09", "text": "尽可能抽出时间，以便能够高"}, {"type": "subtitle", "time": 14771.75, "timestamp": "04:06:11", "text": "压力推动"}, {"type": "subtitle", "time": 14773.15, "timestamp": "04:06:13", "text": "呃，为了"}, {"type": "subtitle", "time": 14775.51, "timestamp": "04:06:15", "text": "货币化。我知道我能做到。我"}, {"type": "subtitle", "time": 14778.03, "timestamp": "04:06:18", "text": "相信我的星座和音乐会"}, {"type": "subtitle", "time": 14781.55, "timestamp": "04:06:21", "text": "盘子。我们可以一起做到。"}, {"type": "subtitle", "time": 14785.189, "timestamp": "04:06:25", "text": "不，我不想让它仅仅停留在梦里。"}, {"type": "subtitle", "time": 14788.309, "timestamp": "04:06:28", "text": "成为 YouTube 合作伙伴。好的。喜欢"}, {"type": "subtitle", "time": 14791.83, "timestamp": "04:06:31", "text": "去年，前年倒数第二天"}, {"type": "subtitle", "time": 14793.91, "timestamp": "04:06:33", "text": "今年，每次我说“我”的时候"}, {"type": "subtitle", "time": 14795.75, "timestamp": "04:06:35", "text": "我想开通 YouTube 会员，而且"}, {"type": "subtitle", "time": 14798.429, "timestamp": "04:06:38", "text": "想获得会员资格，"}, {"type": "subtitle", "time": 14802.229, "timestamp": "04:06:42", "text": "等等。是的。因为他们锁定了已登录状态"}, {"type": "subtitle", "time": 14804.55, "timestamp": "04:06:44", "text": "将 YouTube 的功能融入到这个呃"}, {"type": "subtitle", "time": 14806.71, "timestamp": "04:06:46", "text": "会员制度，合作伙伴制度。它是"}, {"type": "subtitle", "time": 14809.429, "timestamp": "04:06:49", "text": "令人难过，但事实就是如此。"}, {"type": "subtitle", "time": 14819.95, "timestamp": "04:06:59", "text": "好的。是的。是的，呃，在呃"}]
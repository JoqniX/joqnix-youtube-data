[{"type": "subtitle", "time": 2290.71, "timestamp": "00:38:10", "text": "布莱恩，欢迎进来。"}, {"type": "subtitle", "time": 2292.87, "timestamp": "00:38:12", "text": "另外，你不用担心呃……"}, {"type": "subtitle", "time": 2294.95, "timestamp": "00:38:14", "text": "观众等等。这就是原因"}, {"type": "subtitle", "time": 2296.95, "timestamp": "00:38:16", "text": "我做播客。"}, {"type": "subtitle", "time": 2299.03, "timestamp": "00:38:19", "text": "因为我其实不太……和"}, {"type": "subtitle", "time": 2300.95, "timestamp": "00:38:20", "text": "首先是观众。所以，我喜欢"}, {"type": "subtitle", "time": 2304.23, "timestamp": "00:38:24", "text": "和别人说话。"}, {"type": "subtitle", "time": 2305.51, "timestamp": "00:38:25", "text": "否则，就该是我在跟他/她说话了。"}, {"type": "subtitle", "time": 2310.95, "timestamp": "00:38:30", "text": "我。感觉嗯。我不知道。"}, {"type": "subtitle", "time": 2313.75, "timestamp": "00:38:33", "text": "我想问你一些关于……的事情"}, {"type": "subtitle", "time": 2315.55, "timestamp": "00:38:35", "text": "你是如何做到的"}, {"type": "subtitle", "time": 2319.349, "timestamp": "00:38:39", "text": "因为我尝试过，所以吸引了很多人。"}, {"type": "subtitle", "time": 2323.15, "timestamp": "00:38:43", "text": "为 Joathon 招募人员"}, {"type": "subtitle", "time": 2325.31, "timestamp": "00:38:45", "text": "合作"}, {"type": "subtitle", "time": 2327.31, "timestamp": "00:38:47", "text": "然后我"}, {"type": "subtitle", "time": 2330.95, "timestamp": "00:38:50", "text": "遇到很多不同的困难"}, {"type": "subtitle", "time": 2334.03, "timestamp": "00:38:54", "text": "更像是一个新的"}, {"type": "subtitle", "time": 2336.79, "timestamp": "00:38:56", "text": "有点经验丰富，但我呃，没有。"}]
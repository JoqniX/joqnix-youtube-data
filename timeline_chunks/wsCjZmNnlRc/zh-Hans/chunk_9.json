[{"type": "subtitle", "time": 545.19, "timestamp": "00:09:05", "text": "是的。"}, {"type": "subtitle", "time": 548.55, "timestamp": "00:09:08", "text": "总之，大家好，我是Mau，呃，我"}, {"type": "subtitle", "time": 551.19, "timestamp": "00:09:11", "text": "我喜欢和医学打交道。好的"}, {"type": "subtitle", "time": 555.75, "timestamp": "00:09:15", "text": "很高兴见到你。很高兴认识你，Momo。"}, {"type": "subtitle", "time": 557.59, "timestamp": "00:09:17", "text": "正如你所看到的，我有一个非常可爱的"}, {"type": "subtitle", "time": 559.67, "timestamp": "00:09:19", "text": "一张脸和一个可爱的表情，就像……"}, {"type": "subtitle", "time": 562.19, "timestamp": "00:09:22", "text": "景石给了我一些药，呃，一些"}, {"type": "subtitle", "time": 565.269, "timestamp": "00:09:25", "text": "如果我……呃，如果我记得的话"}, {"type": "subtitle", "time": 573.509, "timestamp": "00:09:33", "text": "另外，希望您不介意麦克风……"}, {"type": "subtitle", "time": 574.949, "timestamp": "00:09:34", "text": "听起来有点不对劲。我其实没有"}, {"type": "subtitle", "time": 577.35, "timestamp": "00:09:37", "text": "麦克风或耳塞。我只是在使用"}, {"type": "subtitle", "time": 582.389, "timestamp": "00:09:42", "text": "电脑就是我的麦克风。不，没关系。全部"}, {"type": "subtitle", "time": 588.55, "timestamp": "00:09:48", "text": "此外，似乎很难……"}, {"type": "subtitle", "time": 590.47, "timestamp": "00:09:50", "text": "由于家人和客人的缘故，直播正在进行"}, {"type": "subtitle", "time": 593.71, "timestamp": "00:09:53", "text": "在我的房间里。但是，男士们，所以我的麦克风会是"}, {"type": "subtitle", "time": 597.75, "timestamp": "00:09:57", "text": "静音。呃，别担心，家人们。我"}]
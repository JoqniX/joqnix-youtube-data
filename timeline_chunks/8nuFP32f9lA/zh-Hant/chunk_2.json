[{"type": "subtitle", "time": 120.069, "timestamp": "00:02:00", "text": "進一步檢查進展順利。"}, {"type": "subtitle", "time": 122.069, "timestamp": "00:02:02", "text": "等待。"}, {"type": "subtitle", "time": 124.55, "timestamp": "00:02:04", "text": "呃，"}, {"type": "subtitle", "time": 128.55, "timestamp": "00:02:08", "text": "什麼？是的，今天我要檢查一下"}, {"type": "subtitle", "time": 131.91, "timestamp": "00:02:11", "text": "我的串流網路連線是否正常"}, {"type": "subtitle", "time": 135.03, "timestamp": "00:02:15", "text": "。我們將玩一會兒"}, {"type": "subtitle", "time": 138.869, "timestamp": "00:02:18", "text": "Warox。"}, {"type": "subtitle", "time": 141.82999999999998, "timestamp": "00:02:21", "text": "我還有一些其他的事情"}, {"type": "subtitle", "time": 146.869, "timestamp": "00:02:26", "text": "要做，像是完成一些任務。所以，"}, {"type": "subtitle", "time": 148.39, "timestamp": "00:02:28", "text": "我"}, {"type": "subtitle", "time": 156.55, "timestamp": "00:02:36", "text": "今天可能會玩一會兒《戰神》（Warogs），然後盡量"}, {"type": "subtitle", "time": 160.22899999999998, "timestamp": "00:02:40", "text": "完成一些手邊的任務。"}, {"type": "subtitle", "time": 163.27, "timestamp": "00:02:43", "text": "今天就像是網路測試"}, {"type": "subtitle", "time": 167.19, "timestamp": "00:02:47", "text": "。我該怎麼做？嗯……"}, {"type": "subtitle", "time": 171.91, "timestamp": "00:02:51", "text": "我該怎麼做？呃……該怎麼稱呼它呢？"}, {"type": "subtitle", "time": 174.55, "timestamp": "00:02:54", "text": "雖然我確實在測試一些"}, {"type": "subtitle", "time": 177.11, "timestamp": "00:02:57", "text": "東西，例如，"}, {"type": "subtitle", "time": 178.71, "timestamp": "00:02:58", "text": "嗯，"}]
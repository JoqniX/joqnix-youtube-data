[{"type": "subtitle", "time": 3961.67, "timestamp": "01:06:01", "text": "从他们的基地派出熔火机，一路飞到很远的"}, {"type": "subtitle", "time": 3967.589, "timestamp": "01:06:07", "text": "蓝队那里。 这太令人难过了。"}, {"type": "subtitle", "time": 3969.67, "timestamp": "01:06:09", "text": "这是一支经验不足的队伍，因此占据"}, {"type": "subtitle", "time": 3972.87, "timestamp": "01:06:12", "text": "优势。 他们现在积"}, {"type": "subtitle", "time": 3975.109, "timestamp": "01:06:15", "text": "57分，"}, {"type": "subtitle", "time": 3979.829, "timestamp": "01:06:19", "text": "简直把我们打得落花流水。"}, {"type": "subtitle", "time": 4011.27, "timestamp": "01:06:51", "text": "扶我起来。"}]
[{"type": "subtitle", "time": 11101.269, "timestamp": "03:05:01", "text": "我想发送"}, {"type": "subtitle", "time": 11106.07, "timestamp": "03:05:06", "text": "类似 HTTP 之类的手机通知，"}, {"type": "subtitle", "time": 11115.59, "timestamp": "03:05:15", "text": "发送"}, {"type": "subtitle", "time": 11119.429, "timestamp": "03:05:19", "text": "到我的手机上，或者触发类似"}, {"type": "subtitle", "time": 11128.309, "timestamp": "03:05:28", "text": "我的流媒体比特率很低，或者说是下降之类的，"}, {"type": "subtitle", "time": 11131.349, "timestamp": "03:05:31", "text": "如果我没理解"}, {"type": "subtitle", "time": 11133.03, "timestamp": "03:05:33", "text": "错的话，那就更好了。"}, {"type": "subtitle", "time": 11135.269, "timestamp": "03:05:35", "text": "是的，如果我谈的是技术方面的问题，那就请便吧，"}, {"type": "subtitle", "time": 11137.75, "timestamp": "03:05:37", "text": "但"}, {"type": "subtitle", "time": 11141.67, "timestamp": "03:05:41", "text": "我现在有义务了解这些，"}, {"type": "subtitle", "time": 11143.99, "timestamp": "03:05:43", "text": "因为我的 Wi-Fi"}, {"type": "subtitle", "time": 11148.87, "timestamp": "03:05:48", "text": "目前不稳定。 我把它从 5G 切换到 4G，"}, {"type": "subtitle", "time": 11152.469, "timestamp": "03:05:52", "text": "这样更稳定一些。"}, {"type": "subtitle", "time": 11156.15, "timestamp": "03:05:56", "text": "我发现的主要问题始终是"}, {"type": "subtitle", "time": 11159.349, "timestamp": "03:05:59", "text": "比特率。 我上传速度的比特率不高"}]
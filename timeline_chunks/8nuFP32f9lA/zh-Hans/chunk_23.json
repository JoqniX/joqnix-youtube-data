[{"type": "subtitle", "time": 1384.95, "timestamp": "00:23:04", "text": "对不起。 对不起。 我以为你是敌人。"}, {"type": "subtitle", "time": 1387.11, "timestamp": "00:23:07", "text": "没关系。"}, {"type": "subtitle", "time": 1405.99, "timestamp": "00:23:25", "text": "我的天啊。 决不。 我害死了自己的队友。"}, {"type": "subtitle", "time": 1408.256, "timestamp": "00:23:28", "text": "友军误伤。 哦[尖叫]"}, {"type": "subtitle", "time": 1434.149, "timestamp": "00:23:54", "text": "啊，他死了。 不，"}, {"type": "subtitle", "time": 1436.47, "timestamp": "00:23:56", "text": "考虑到我们已经一直"}, {"type": "subtitle", "time": 1439.83, "timestamp": "00:23:59", "text": "避免见面，这种说法站不住脚。"}]
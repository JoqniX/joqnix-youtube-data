[{"type": "subtitle", "time": 2705.589, "timestamp": "00:45:05", "text": "我要跑15公里。"}, {"type": "subtitle", "time": 2710.95, "timestamp": "00:45:10", "text": "我真为建造这个的人感到高兴。"}, {"type": "subtitle", "time": 2737.51, "timestamp": "00:45:37", "text": "不要大声喧哗。 你好。 我也想放手"}, {"type": "subtitle", "time": 2748.309, "timestamp": "00:45:48", "text": "晚安，Solar。"}, {"type": "subtitle", "time": 2751.109, "timestamp": "00:45:51", "text": "再次感谢您抽出时间来"}]
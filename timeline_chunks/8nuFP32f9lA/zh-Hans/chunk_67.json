[{"type": "subtitle", "time": 4027.51, "timestamp": "01:07:07", "text": "他们就像在Maltar上疯狂刷屏一样。"}, {"type": "subtitle", "time": 4030.309, "timestamp": "01:07:10", "text": "哇。 我知道你可以"}, {"type": "subtitle", "time": 4037.19, "timestamp": "01:07:17", "text": "按 C 键取消动画并发送三个熔岩炮。"}, {"type": "subtitle", "time": 4039.109, "timestamp": "01:07:19", "text": "然后你发射一个麦芽炮。 你按下C键，然后"}, {"type": "subtitle", "time": 4042.23, "timestamp": "01:07:22", "text": "再次发射另一个熔炉。 按 C 键。"}, {"type": "subtitle", "time": 4045.19, "timestamp": "01:07:25", "text": "你可以在安全的地方发射三个熔岩炮"}, {"type": "subtitle", "time": 4051.109, "timestamp": "01:07:31", "text": "他们正在做那件事。 所以"}, {"type": "subtitle", "time": 4063.109, "timestamp": "01:07:43", "text": "除了我以外，其他人都复活了。"}]
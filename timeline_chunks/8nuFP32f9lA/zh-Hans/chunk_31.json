[{"type": "subtitle", "time": 1865.43, "timestamp": "00:31:05", "text": "挺好的。 直播结束后我就睡着了"}, {"type": "subtitle", "time": 1880.31, "timestamp": "00:31:20", "text": "我应该帮他一起盖房子吗？"}, {"type": "subtitle", "time": 1882.71, "timestamp": "00:31:22", "text": "我忘了还有卡片这回事，我就想，你"}, {"type": "subtitle", "time": 1884.71, "timestamp": "00:31:24", "text": "开始直播吧，我下个月再把卡片收走"}, {"type": "subtitle", "time": 1888.63, "timestamp": "00:31:28", "text": "。 你开始直播。 呃，"}, {"type": "subtitle", "time": 1890.71, "timestamp": "00:31:30", "text": "30分钟，因为我忘了带卡片，"}, {"type": "subtitle", "time": 1894.23, "timestamp": "00:31:34", "text": "然后我就想，你看到社交媒体了吗？"}, {"type": "subtitle", "time": 1900.47, "timestamp": "00:31:40", "text": "我的意思是，自从我来到日本以来，我一直都很"}, {"type": "subtitle", "time": 1903.269, "timestamp": "00:31:43", "text": "活跃。 我真希望我能把"}, {"type": "subtitle", "time": 1908.389, "timestamp": "00:31:48", "text": "我的电脑从家里运过来，这样我就可以把"}, {"type": "subtitle", "time": 1910.549, "timestamp": "00:31:50", "text": "它用作我的直播"}, {"type": "subtitle", "time": 1912.23, "timestamp": "00:31:52", "text": "电脑了。"}, {"type": "subtitle", "time": 1914.549, "timestamp": "00:31:54", "text": "所以"}, {"type": "subtitle", "time": 1918.31, "timestamp": "00:31:58", "text": "现在笔记本电脑的负载会轻很多。 我"}]
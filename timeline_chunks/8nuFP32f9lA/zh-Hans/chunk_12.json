[{"type": "subtitle", "time": 723.35, "timestamp": "00:12:03", "text": "我想尽一切办法干掉那个开"}, {"type": "subtitle", "time": 726.55, "timestamp": "00:12:06", "text": "悍马的家伙"}, {"type": "subtitle", "time": 732.949, "timestamp": "00:12:12", "text": "然后想办法偷走他们的悍马车。"}, {"type": "subtitle", "time": 735.75, "timestamp": "00:12:15", "text": "摧毁悍马车的诀窍是击中它的"}, {"type": "subtitle", "time": 739.829, "timestamp": "00:12:19", "text": "弱点。 那是轮子。   是的"}, {"type": "subtitle", "time": 741.19, "timestamp": "00:12:21", "text": "。 是的。 是的。 他们来了"}, {"type": "subtitle", "time": 743.829, "timestamp": "00:12:23", "text": "。 他们来了。"}, {"type": "subtitle", "time": 756.31, "timestamp": "00:12:36", "text": "好的。 有人真的把它杀了。 太疯狂了，"}, {"type": "subtitle", "time": 758.31, "timestamp": "00:12:38", "text": "兄弟。"}]
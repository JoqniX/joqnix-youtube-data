[{"type": "subtitle", "time": 4338.95, "timestamp": "01:12:18", "text": "他们那边居然有个坦克！   我的"}, {"type": "subtitle", "time": 4341.59, "timestamp": "01:12:21", "text": "天哪。"}, {"type": "subtitle", "time": 4343.99, "timestamp": "01:12:23", "text": "这是什么游戏？"}, {"type": "subtitle", "time": 4347.43, "timestamp": "01:12:27", "text": "他们有坦克。 他们有"}, {"type": "subtitle", "time": 4352.229, "timestamp": "01:12:32", "text": "垃圾邮件生成器。 熔岩喷射器。"}, {"type": "subtitle", "time": 4361.27, "timestamp": "01:12:41", "text": "配备迷你"}, {"type": "subtitle", "time": 4364.63, "timestamp": "01:12:44", "text": "机枪和火箭弹的攻击直升机。"}]
[{"type": "subtitle", "time": 3904.069, "timestamp": "01:05:04", "text": "实话，不是。 就像我当时在测试，"}, {"type": "subtitle", "time": 3906.63, "timestamp": "01:05:06", "text": "没有向任何平台直播，但"}, {"type": "subtitle", "time": 3909.27, "timestamp": "01:05:09", "text": "它确实在直播，"}, {"type": "subtitle", "time": 3910.789, "timestamp": "01:05:10", "text": "而且情况并非如此"}, {"type": "subtitle", "time": 3933.829, "timestamp": "01:05:33", "text": "没人来接我。"}, {"type": "subtitle", "time": 3935.67, "timestamp": "01:05:35", "text": "这他妈的把我吓到了。"}, {"type": "subtitle", "time": 3955.109, "timestamp": "01:05:55", "text": "所以现在的情况是，绿队和"}, {"type": "subtitle", "time": 3957.99, "timestamp": "01:05:57", "text": "红队正"}]
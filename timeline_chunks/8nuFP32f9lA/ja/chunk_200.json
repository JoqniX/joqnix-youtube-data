[{"type": "subtitle", "time": 12000.79, "timestamp": "03:20:00", "text": "。これは表示するのに非常に便利です。"}, {"type": "subtitle", "time": 12003.91, "timestamp": "03:20:03", "text": "また、自動化されたものも Notion で"}, {"type": "subtitle", "time": 12007.03, "timestamp": "03:20:07", "text": "バインドしたり、"}, {"type": "subtitle", "time": 12010.07, "timestamp": "03:20:10", "text": "接続したりすることができます。"}, {"type": "subtitle", "time": 12013.429, "timestamp": "03:20:13", "text": "うん。それで、ちょっと分かりやすい"}, {"type": "subtitle", "time": 12015.51, "timestamp": "03:20:15", "text": "裏切りみたいな感じで、今アイデアが浮かんだんだ"}, {"type": "subtitle", "time": 12018.87, "timestamp": "03:20:18", "text": "。ああ、配信の後、"}, {"type": "subtitle", "time": 12022.469, "timestamp": "03:20:22", "text": "チャドGBDに聞いてみようと思ってたんだけど、"}, {"type": "subtitle", "time": 12029.51, "timestamp": "03:20:29", "text": "HTTPリクエストとかウェブソケットリクエストとかを"}, {"type": "subtitle", "time": 12036.07, "timestamp": "03:20:36", "text": "スマホに送ったり、Google"}, {"type": "subtitle", "time": 12039.51, "timestamp": "03:20:39", "text": "アシスタントとか"}, {"type": "subtitle", "time": 12043.51, "timestamp": "03:20:43", "text": "ウェブフックとかに送ったりして、"}, {"type": "subtitle", "time": 12047.83, "timestamp": "03:20:47", "text": "イベントをトリガーして、"}, {"type": "subtitle", "time": 12056.07, "timestamp": "03:20:56", "text": "OBSのビットレートが1000kbpsを下回ってるっていうイベントデータを"}]
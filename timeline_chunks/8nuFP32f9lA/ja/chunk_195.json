[{"type": "subtitle", "time": 11700.309, "timestamp": "03:15:00", "text": "DVI"}, {"type": "subtitle", "time": 11707.269, "timestamp": "03:15:07", "text": "ディスプレイポート、DP to HD、DP to USBみたいなのが必要だと思うんです"}, {"type": "subtitle", "time": 11709.349, "timestamp": "03:15:09", "text": "。いや、"}, {"type": "subtitle", "time": 11713.11, "timestamp": "03:15:13", "text": "違う。DP to HDMI、それからHDMI to USB"}, {"type": "subtitle", "time": 11715.91, "timestamp": "03:15:15", "text": "みたいなの。それが必要なんです。待って、あれは"}, {"type": "subtitle", "time": 11722.79, "timestamp": "03:15:22", "text": "HVMだったかな"}, {"type": "subtitle", "time": 11725.67, "timestamp": "03:15:25", "text": "。だから、これにHDMIを繋げると思う"}, {"type": "chat", "time": 11731.4, "timestamp": "03:15:31", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "Too much conversion "}, {"type": "subtitle", "time": 11735.269, "timestamp": "03:15:35", "text": "出力はできる。わかった。わかった。"}, {"type": "subtitle", "time": 11738.63, "timestamp": "03:15:38", "text": "でも。"}, {"type": "subtitle", "time": 11741.91, "timestamp": "03:15:41", "text": "HDMIケーブルを買わないといけないかもしれないし、インド"}, {"type": "subtitle", "time": 11744.55, "timestamp": "03:15:44", "text": "から部品が届いたら後で買えるかもしれない"}, {"type": "subtitle", "time": 11746.87, "timestamp": "03:15:46", "text": "。"}, {"type": "subtitle", "time": 11754.389, "timestamp": "03:15:54", "text": "キャプチャカード、GPUマザーボード、"}]
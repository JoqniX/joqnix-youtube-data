[{"type": "subtitle", "time": 11646.55, "timestamp": "03:14:06", "text": "ビデオみたいなことをやらなきゃいけないと思う。"}, {"type": "subtitle", "time": 11652.87, "timestamp": "03:14:12", "text": "何かの録音をしないといけないんです。それをやらないといけない。"}, {"type": "subtitle", "time": 11655.75, "timestamp": "03:14:15", "text": "その後は、"}, {"type": "subtitle", "time": 11657.51, "timestamp": "03:14:17", "text": "えっと、"}, {"type": "subtitle", "time": 11659.99, "timestamp": "03:14:19", "text": "その後はちょっと自由なんですが、"}, {"type": "subtitle", "time": 11667.03, "timestamp": "03:14:27", "text": "ハードオフっていうお店に行きたいんです。"}, {"type": "subtitle", "time": 11669.269, "timestamp": "03:14:29", "text": "そこは"}, {"type": "subtitle", "time": 11671.67, "timestamp": "03:14:31", "text": "中古品や中古品を売っているお店で、"}, {"type": "subtitle", "time": 11677.59, "timestamp": "03:14:37", "text": "アニメのフィギュアとか、そういう良質なものがたくさん売られているんです。"}, {"type": "subtitle", "time": 11683.19, "timestamp": "03:14:43", "text": "日本のハードオフにはそういうものがたくさんあります。だから、そこに行って"}, {"type": "subtitle", "time": 11690.79, "timestamp": "03:14:50", "text": "パソコンの部品を見て、写真や値段を調べたいんです。"}, {"type": "subtitle", "time": 11694.63, "timestamp": "03:14:54", "text": "特に、"}]
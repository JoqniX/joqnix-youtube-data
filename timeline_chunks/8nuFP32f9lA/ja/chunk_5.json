[{"type": "subtitle", "time": 308.39, "timestamp": "00:05:08", "text": "だから、ああ、それは違うよ、という言い回しが少しなくなってきた"}, {"type": "subtitle", "time": 310.469, "timestamp": "00:05:10", "text": "。   ネタが"}, {"type": "subtitle", "time": 316.87, "timestamp": "00:05:16", "text": "ちょっと尽きてきた。"}, {"type": "subtitle", "time": 319.029, "timestamp": "00:05:19", "text": "むしろ雑誌だ。 とにかくたくさんの"}, {"type": "subtitle", "time": 322.71, "timestamp": "00:05:22", "text": "雑誌を持って行きます。"}, {"type": "subtitle", "time": 325.99, "timestamp": "00:05:25", "text": "そして、"}, {"type": "subtitle", "time": 349.11, "timestamp": "00:05:49", "text": "スコア。"}, {"type": "subtitle", "time": 353.11, "timestamp": "00:05:53", "text": "待って、ショットを1つ忘れてた。"}]
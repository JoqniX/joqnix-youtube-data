[{"type": "subtitle", "time": 11220.309, "timestamp": "03:07:00", "text": "えっと、もしインドから部品を"}, {"type": "subtitle", "time": 11224.71, "timestamp": "03:07:04", "text": "何とか持って来られたら、それから、"}, {"type": "subtitle", "time": 11229.11, "timestamp": "03:07:09", "text": "良いネットか中古のフル"}, {"type": "subtitle", "time": 11232.309, "timestamp": "03:07:12", "text": "TXキャビネットを買って、マザーボード"}, {"type": "subtitle", "time": 11235.67, "timestamp": "03:07:15", "text": "とか全部入れて、全部セットアップして、全部終わらせて、"}, {"type": "subtitle", "time": 11240.95, "timestamp": "03:07:20", "text": "そのPCケースを机の下とか"}, {"type": "subtitle", "time": 11242.55, "timestamp": "03:07:22", "text": "机の上とかに置くんだ"}, {"type": "subtitle", "time": 11247.59, "timestamp": "03:07:27", "text": "。 右。 それで、問題は、"}, {"type": "subtitle", "time": 11251.429, "timestamp": "03:07:31", "text": "私のストリームがこのようにおかしくなった場合ですよ"}, {"type": "subtitle", "time": 11254.63, "timestamp": "03:07:34", "text": "ね？"}, {"type": "subtitle", "time": 11264.15, "timestamp": "03:07:44", "text": "もし私の配信がこんな風に不安定になったら、"}, {"type": "subtitle", "time": 11269.19, "timestamp": "03:07:49", "text": "問題が発生するだけでしょう。"}, {"type": "subtitle", "time": 11272.07, "timestamp": "03:07:52", "text": "なぜなら、常に"}, {"type": "subtitle", "time": 11273.99, "timestamp": "03:07:53", "text": "目を光らせていなければならないからです。   ということは、"}]
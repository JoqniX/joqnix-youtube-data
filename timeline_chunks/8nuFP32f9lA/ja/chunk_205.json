[{"type": "subtitle", "time": 12307.429, "timestamp": "03:25:07", "text": "デュアルPC構成であっても、問題や技術的な問題がない場所はないでしょう。でも、"}, {"type": "subtitle", "time": 12314.309, "timestamp": "03:25:14", "text": "デュアル構成に切り替えると"}, {"type": "subtitle", "time": 12318.469, "timestamp": "03:25:18", "text": "負荷が軽くなることは確かです。"}, {"type": "subtitle", "time": 12322.229, "timestamp": "03:25:22", "text": "ゲームだけをしている場合は、"}, {"type": "subtitle", "time": 12324.309, "timestamp": "03:25:24", "text": "ここでストリームページを使用します。ゲームだけをしていない場合は"}, {"type": "subtitle", "time": 12326.71, "timestamp": "03:25:26", "text": "、"}, {"type": "subtitle", "time": 12331.269, "timestamp": "03:25:31", "text": "このゲーミングノートPC OBS"}, {"type": "subtitle", "time": 12335.67, "timestamp": "03:25:35", "text": "ゲームOBSと呼べる、またはメインOBS（今"}, {"type": "subtitle", "time": 12337.75, "timestamp": "03:25:37", "text": "ストリーミングしているもの）に切り替えます。"}, {"type": "subtitle", "time": 12344.95, "timestamp": "03:25:44", "text": "音楽などをやっている場合、 もし私たちが他のことをするなら、デスクトップベースのストリーム、つまり私が"}, {"type": "subtitle", "time": 12352.79, "timestamp": "03:25:52", "text": "家にいて座って、デスクトップベースのストリームを配信します"}, {"type": "subtitle", "time": 12356.07, "timestamp": "03:25:56", "text": "。ええ、そういうことは"}, {"type": "subtitle", "time": 12359.11, "timestamp": "03:25:59", "text": "通常のストリームで配信できますし、"}]
[{"type": "subtitle", "time": 3961.67, "timestamp": "01:06:01", "text": "はるか遠く離れた基地から"}, {"type": "subtitle", "time": 3967.589, "timestamp": "01:06:07", "text": "ブルーチームに向かって、モルターを送り込んでいるということです。 これは本当に悲しいことだ。"}, {"type": "subtitle", "time": 3969.67, "timestamp": "01:06:09", "text": "緑チームの方が"}, {"type": "subtitle", "time": 3972.87, "timestamp": "01:06:12", "text": "有利だ。 彼らは"}, {"type": "subtitle", "time": 3975.109, "timestamp": "01:06:15", "text": "57点を取っていて、"}, {"type": "subtitle", "time": 3979.829, "timestamp": "01:06:19", "text": "文字通り私たちを圧倒している。   何てことだ"}, {"type": "subtitle", "time": 4011.27, "timestamp": "01:06:51", "text": "。"}]
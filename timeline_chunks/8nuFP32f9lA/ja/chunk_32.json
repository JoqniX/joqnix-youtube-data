[{"type": "subtitle", "time": 1928.31, "timestamp": "00:32:08", "text": "ああ、飛行機だ。  H."}, {"type": "subtitle", "time": 1937.99, "timestamp": "00:32:17", "text": "。 ええ、そうですね。  SWの犬が蒸気を噴き出す。"}, {"type": "subtitle", "time": 1944.789, "timestamp": "00:32:24", "text": "楽しいですよ。 まるで、たくさんの"}, {"type": "subtitle", "time": 1946.789, "timestamp": "00:32:26", "text": "サポート業務ができるような感じですね。"}, {"type": "subtitle", "time": 1949.19, "timestamp": "00:32:29", "text": "君もパイロットになれるよ。 君もUberの運転手になれるよ"}, {"type": "subtitle", "time": 1952.549, "timestamp": "00:32:32", "text": "。 あなたは空飛ぶUberになれる。 君も"}, {"type": "subtitle", "time": 1955.669, "timestamp": "00:32:35", "text": "ボブ・ザ・ビルダーになれるよ。 そうすれば、君は"}, {"type": "subtitle", "time": 1959.75, "timestamp": "00:32:39", "text": "救護係になれるよ。 君は偵察兵、情報収集兵になれる"}, {"type": "subtitle", "time": 1962.149, "timestamp": "00:32:42", "text": "。"}, {"type": "subtitle", "time": 1963.83, "timestamp": "00:32:43", "text": "えっと、"}]
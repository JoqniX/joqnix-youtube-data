[{"type": "subtitle", "time": 4027.51, "timestamp": "01:07:07", "text": "彼らはマルタルにスパムメールを送っているようなものだ。"}, {"type": "subtitle", "time": 4030.309, "timestamp": "01:07:10", "text": "おお。  Cキーを押すと"}, {"type": "subtitle", "time": 4032.549, "timestamp": "01:07:12", "text": "アニメーションをキャンセルしてモルタルを3つ発射できることは知っています。"}, {"type": "subtitle", "time": 4039.109, "timestamp": "01:07:19", "text": "その後、モルトを発射します。  Cキーを押します。すると、"}, {"type": "subtitle", "time": 4042.23, "timestamp": "01:07:22", "text": "再びモルタルを発射します。  Cキーを押してください。"}, {"type": "subtitle", "time": 4045.19, "timestamp": "01:07:25", "text": "安全な場所で3つのモルタルを発射できます"}, {"type": "subtitle", "time": 4051.109, "timestamp": "01:07:31", "text": "彼らはそれをやっている。 だから、"}, {"type": "subtitle", "time": 4063.109, "timestamp": "01:07:43", "text": "以外の全員を蘇生させている。"}]
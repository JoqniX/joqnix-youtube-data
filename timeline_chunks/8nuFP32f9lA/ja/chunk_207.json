[{"type": "subtitle", "time": 12422.309, "timestamp": "03:27:02", "text": "少なくとも日曜日は"}, {"type": "subtitle", "time": 12425.59, "timestamp": "03:27:05", "text": "新宿に行かなければならないかもしれませんが、少なくとも今週の土曜日は、今週は"}, {"type": "subtitle", "time": 12433.19, "timestamp": "03:27:13", "text": "長めのストリームを試してみます。先週末、つまり先週の土曜日と"}, {"type": "subtitle", "time": 12436.55, "timestamp": "03:27:16", "text": "日曜日は、"}, {"type": "subtitle", "time": 12443.59, "timestamp": "03:27:23", "text": "2時間以上配信できませんでした。"}, {"type": "subtitle", "time": 12450.15, "timestamp": "03:27:30", "text": "疲れすぎて寝てしまい、起きられなかった私のせいです。 えっと、"}, {"type": "subtitle", "time": 12456.469, "timestamp": "03:27:36", "text": "体の痛みがあって、"}, {"type": "subtitle", "time": 12458.469, "timestamp": "03:27:38", "text": "配信したくなかったんだ"}, {"type": "subtitle", "time": 12460.229, "timestamp": "03:27:40", "text": "けど、"}, {"type": "subtitle", "time": 12462.389, "timestamp": "03:27:42", "text": "今週末は配信"}, {"type": "subtitle", "time": 12465.75, "timestamp": "03:27:45", "text": "できるか見てみよう。"}, {"type": "subtitle", "time": 12469.349, "timestamp": "03:27:49", "text": "来月は戦争"}, {"type": "subtitle", "time": 12472.469, "timestamp": "03:27:52", "text": "犬がリセットされて、"}, {"type": "subtitle", "time": 12479.03, "timestamp": "03:27:59", "text": "うん、すべてがゼロに戻る。それはちょっと"}]
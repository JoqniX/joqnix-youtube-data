[{"type": "subtitle", "time": 726.55, "timestamp": "00:12:06", "text": "ハンヴィー野郎を"}, {"type": "subtitle", "time": 732.949, "timestamp": "00:12:12", "text": "そして何とかして彼らのハンヴィーを盗む。"}, {"type": "subtitle", "time": 735.75, "timestamp": "00:12:15", "text": "ハンヴィーを撃破するコツは、"}, {"type": "subtitle", "time": 739.829, "timestamp": "00:12:19", "text": "弱点を突くことだ。 あれが車輪です。"}, {"type": "subtitle", "time": 741.19, "timestamp": "00:12:21", "text": "うん。 うん。 うん。 彼らが来る"}, {"type": "subtitle", "time": 743.829, "timestamp": "00:12:23", "text": "。 彼らが来る。"}, {"type": "subtitle", "time": 756.31, "timestamp": "00:12:36", "text": "。 誰かが実際にそれを殺したんだ。 クレイジーだよ、"}, {"type": "subtitle", "time": 758.31, "timestamp": "00:12:38", "text": "兄弟。"}]
[{"type": "subtitle", "time": 4142.789, "timestamp": "01:09:02", "text": "違うよ。 私に偽りの希望を与えないでください。 待って、"}, {"type": "subtitle", "time": 4160.55, "timestamp": "01:09:20", "text": "蘇生させている。 お願いします。 私は文字通り"}, {"type": "subtitle", "time": 4162.87, "timestamp": "01:09:22", "text": "あなたの後ろにいます。"}, {"type": "subtitle", "time": 4166.309, "timestamp": "01:09:26", "text": "私は文字通りあなたの後ろにいます。 頼むよ、"}, {"type": "subtitle", "time": 4188.47, "timestamp": "01:09:48", "text": "？ 来て。 とにかく"}]
[{"type": "subtitle", "time": 11820.389, "timestamp": "03:17:00", "text": "Twitch、kick、rumble、Twitterは"}, {"type": "subtitle", "time": 11824.15, "timestamp": "03:17:04", "text": "guessから来てるよね？」でも私は「ああ、"}, {"type": "subtitle", "time": 11826.469, "timestamp": "03:17:06", "text": "できるけど、したくない」と思った。"}, {"type": "subtitle", "time": 11830.07, "timestamp": "03:17:10", "text": "「Multimillの無料版を使いたいんです。」"}, {"type": "subtitle", "time": 11832.87, "timestamp": "03:17:12", "text": "ショーで同じ開発者、"}, {"type": "subtitle", "time": 11836.15, "timestamp": "03:17:16", "text": "会社は違うけど、そう、同じ開発者です。"}, {"type": "subtitle", "time": 11838.229, "timestamp": "03:17:18", "text": "ガスラボの人たちが私のために"}, {"type": "subtitle", "time": 11841.429, "timestamp": "03:17:21", "text": "Multimillを運用してくれているんですが、Multimillには"}, {"type": "subtitle", "time": 11843.67, "timestamp": "03:17:23", "text": "シンガポールのサーバーがないので、"}, {"type": "subtitle", "time": 11846.95, "timestamp": "03:17:26", "text": "主な問題は日本からシドニーや"}, {"type": "subtitle", "time": 11849.67, "timestamp": "03:17:29", "text": "ロンドンへのpingが高すぎることです。だから"}, {"type": "subtitle", "time": 11852.71, "timestamp": "03:17:32", "text": "シドニーのサーバーに送信して、シドニーのサーバーが"}, {"type": "subtitle", "time": 11857.03, "timestamp": "03:17:37", "text": "フィードを中継するんです。シンガポールの"}, {"type": "subtitle", "time": 11859.11, "timestamp": "03:17:39", "text": "サーバーがフィードをシドニーに中継する、という感じです。"}, {"type": "subtitle", "time": 11864.71, "timestamp": "03:17:44", "text": "この設定の唯一の欠点は、"}, {"type": "subtitle", "time": 11871.99, "timestamp": "03:17:51", "text": "YouTubeの短いストリームのような縦方向のストリームができないことです。"}, {"type": "subtitle", "time": 11876.71, "timestamp": "03:17:56", "text": "つまり、出力が違うということです。唯一の"}]
[{"type": "subtitle", "time": 11045.59, "timestamp": "03:04:05", "text": "うん、これは良いんだけど、"}, {"type": "subtitle", "time": 11056.309, "timestamp": "03:04:16", "text": "F 明らかな統計"}, {"type": "subtitle", "time": 11061.67, "timestamp": "03:04:21", "text": "ストリームのビットレートは 2,000 ビットレート"}, {"type": "subtitle", "time": 11064.23, "timestamp": "03:04:24", "text": "以下です。 わかった。 下、下、下と続きますが、"}, {"type": "subtitle", "time": 11073.83, "timestamp": "03:04:33", "text": "先ほど見た"}, {"type": "subtitle", "time": 11077.99, "timestamp": "03:04:37", "text": "ストリームビットレートのものと、"}, {"type": "subtitle", "time": 11082.15, "timestamp": "03:04:42", "text": "システムトレイの通知のものと、同じ表示になるはずです。"}, {"type": "subtitle", "time": 11085.67, "timestamp": "03:04:45", "text": "送信が完了するまでお待ちください。"}, {"type": "subtitle", "time": 11088.23, "timestamp": "03:04:48", "text": "それでね、知ってる？"}, {"type": "subtitle", "time": 11091.75, "timestamp": "03:04:51", "text": "システムトレイの件は、あまりやりたくないんです。"}, {"type": "subtitle", "time": 11094.469, "timestamp": "03:04:54", "text": "私にはアイデアがあった。"}]
[{"type": "subtitle", "time": 1865.43, "timestamp": "00:31:05", "text": "。 配信後、眠ってしまいました"}, {"type": "subtitle", "time": 1880.31, "timestamp": "00:31:20", "text": "彼の建築を手伝うべきだろうか？"}, {"type": "subtitle", "time": 1882.71, "timestamp": "00:31:22", "text": "カードのことはすっかり忘れていて、「"}, {"type": "subtitle", "time": 1884.71, "timestamp": "00:31:24", "text": "ストリーミングを始めたら、"}, {"type": "subtitle", "time": 1888.63, "timestamp": "00:31:28", "text": "来月から取り上げるよ」って思ったんです。 ストリーミングを開始します。 えっと、"}, {"type": "subtitle", "time": 1890.71, "timestamp": "00:31:30", "text": "30分くらいだったかな。カードのこと忘れてたし、"}, {"type": "subtitle", "time": 1894.23, "timestamp": "00:31:34", "text": "ソーシャルゴーも見たでしょ？"}, {"type": "subtitle", "time": 1900.47, "timestamp": "00:31:40", "text": "日本に来てからずっと"}, {"type": "subtitle", "time": 1903.269, "timestamp": "00:31:43", "text": "アクティブにしてるよ。"}, {"type": "subtitle", "time": 1908.389, "timestamp": "00:31:48", "text": "自宅にあるPCをここに持ってきて、"}, {"type": "subtitle", "time": 1910.549, "timestamp": "00:31:50", "text": "ストリーミング用のセットアップPCとして使えたらいいのに"}, {"type": "subtitle", "time": 1912.23, "timestamp": "00:31:52", "text": "。"}, {"type": "subtitle", "time": 1914.549, "timestamp": "00:31:54", "text": "これでノートパソコンの負荷がかなり軽くなります"}, {"type": "subtitle", "time": 1918.31, "timestamp": "00:31:58", "text": "。"}]
[{"type": "subtitle", "time": 11942.63, "timestamp": "03:19:02", "text": "モジュール化されているということです。"}, {"type": "subtitle", "time": 11946.15, "timestamp": "03:19:06", "text": "とても優れています。現在の私の作業は、Web"}, {"type": "subtitle", "time": 11949.349, "timestamp": "03:19:09", "text": "サイトガイドラインページのようなもので、"}, {"type": "subtitle", "time": 11952.95, "timestamp": "03:19:12", "text": "すべてがハードコーディングされていると思います。Web"}, {"type": "subtitle", "time": 11959.67, "timestamp": "03:19:19", "text": "Studio のプロジェクトファイルを開いて、各行に"}, {"type": "subtitle", "time": 11963.703, "timestamp": "03:19:23", "text": "テキスト div のようなものがあります。"}, {"type": "subtitle", "time": 11967.11, "timestamp": "03:19:27", "text": "しかし、それを MDX ファイルに変換すると、"}, {"type": "subtitle", "time": 11969.99, "timestamp": "03:19:29", "text": "ファイルを編集するだけで済みます。"}, {"type": "subtitle", "time": 11972.63, "timestamp": "03:19:32", "text": "画像を追加できます。"}, {"type": "subtitle", "time": 11976.07, "timestamp": "03:19:36", "text": "ビジュアルビルダーのようなものも作られており、"}, {"type": "subtitle", "time": 11979.03, "timestamp": "03:19:39", "text": "MDX ファイル用のビジュアルビルダーのようなものです。これは非常に"}, {"type": "subtitle", "time": 11981.429, "timestamp": "03:19:41", "text": "優れています。ブログ記事のようなものを作成できます。"}, {"type": "subtitle", "time": 11983.99, "timestamp": "03:19:43", "text": "ああ、私は"}, {"type": "subtitle", "time": 11993.91, "timestamp": "03:19:53", "text": "それをやりたいのです。それを修正したいのです。"}, {"type": "subtitle", "time": 11995.67, "timestamp": "03:19:55", "text": "はい。MDX"}, {"type": "subtitle", "time": 11997.67, "timestamp": "03:19:57", "text": "ファイルを更新するだけで済みます"}]
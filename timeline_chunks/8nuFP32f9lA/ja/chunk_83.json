[{"type": "subtitle", "time": 4989.59, "timestamp": "01:23:09", "text": "ああ、彼はミサイルを間一髪でかわした。"}, {"type": "subtitle", "time": 4992.149, "timestamp": "01:23:12", "text": "ああ、気にしないで。"}, {"type": "subtitle", "time": 4998.149, "timestamp": "01:23:18", "text": "どこにあったのですか？ それはどこにあったのですか？ こちらです。"}, {"type": "subtitle", "time": 5005.03, "timestamp": "01:23:25", "text": "おい、あいつらRPGを"}, {"type": "subtitle", "time": 5006.629, "timestamp": "01:23:26", "text": "取り出して「よし、"}, {"type": "subtitle", "time": 5017.91, "timestamp": "01:23:37", "text": "何を探していますか？"}, {"type": "subtitle", "time": 5019.99, "timestamp": "01:23:39", "text": "いつでも。"}, {"type": "subtitle", "time": 5026.709, "timestamp": "01:23:46", "text": "ここに配備します。"}, {"type": "subtitle", "time": 5038.87, "timestamp": "01:23:58", "text": "えっと、もし私がこのゲームを毎日プレイしていたら、"}]
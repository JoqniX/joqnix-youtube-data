[{"type": "subtitle", "time": 11401.429, "timestamp": "03:10:01", "text": "文字通りキーボードのような長方形の"}, {"type": "subtitle", "time": 11405.91, "timestamp": "03:10:05", "text": "モニターのようなものがディスプレイとして使われている。"}, {"type": "subtitle", "time": 11410.309, "timestamp": "03:10:10", "text": "そして私は心の中で「"}, {"type": "subtitle", "time": 11413.269, "timestamp": "03:10:13", "text": "これはいいな」と考えていました。"}, {"type": "subtitle", "time": 11416.469, "timestamp": "03:10:16", "text": "欲しい気持ちはあるんだけど、どうしようかな"}, {"type": "subtitle", "time": 11427.11, "timestamp": "03:10:27", "text": "もし私が今、もっと"}, {"type": "subtitle", "time": 11430.63, "timestamp": "03:10:30", "text": "安い方法を選ぶとしたら、テレビみたいな一体型の"}, {"type": "subtitle", "time": 11433.75, "timestamp": "03:10:33", "text": "ものを使ってるんだ。 テレビのような端子と、"}, {"type": "subtitle", "time": 11440.469, "timestamp": "03:10:40", "text": "昔のテレビやモニターのようなHDMI端子が付いています"}, {"type": "subtitle", "time": 11442.309, "timestamp": "03:10:42", "text": "。 モニターテレビが"}, {"type": "subtitle", "time": 11445.91, "timestamp": "03:10:45", "text": "一体になったものではなく、"}, {"type": "subtitle", "time": 11450.389, "timestamp": "03:10:50", "text": "アパートにドメトリーに"}, {"type": "subtitle", "time": 11452.15, "timestamp": "03:10:52", "text": "テレビのようなものが付いてきたので、"}, {"type": "subtitle", "time": 11454.469, "timestamp": "03:10:54", "text": "それをセカンドモニターとして使おうと思っています。"}]
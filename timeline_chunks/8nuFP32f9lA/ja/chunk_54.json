[{"type": "subtitle", "time": 3274.47, "timestamp": "00:54:34", "text": "こんにちは。"}, {"type": "subtitle", "time": 3287.27, "timestamp": "00:54:47", "text": "どこですか？"}, {"type": "subtitle", "time": 3289.589, "timestamp": "00:54:49", "text": "この邪魔な木のせいで何も見えない。"}, {"type": "subtitle", "time": 3292.309, "timestamp": "00:54:52", "text": "木を切ることができたらいいのに。"}, {"type": "subtitle", "time": 3294.63, "timestamp": "00:54:54", "text": "ああ、"}, {"type": "subtitle", "time": 3298.309, "timestamp": "00:54:58", "text": "それは文字通りフォートナイトになるだろう。"}, {"type": "subtitle", "time": 3299.03, "timestamp": "00:54:59", "text": "元気かい？"}]
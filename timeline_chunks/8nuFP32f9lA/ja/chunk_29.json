[{"type": "subtitle", "time": 1741.51, "timestamp": "00:29:01", "text": "それに、あなたがそんなに"}, {"type": "subtitle", "time": 1744.149, "timestamp": "00:29:04", "text": "早く気づくとは思っていませんでした。 ああ、Twitch では、"}, {"type": "subtitle", "time": 1746.389, "timestamp": "00:29:06", "text": "寄付をすると、"}, {"type": "subtitle", "time": 1749.99, "timestamp": "00:29:09", "text": "Twitch チャットで、Kofi を"}, {"type": "subtitle", "time": 1752.87, "timestamp": "00:29:12", "text": "Twitch チャットにリンクしました。 それで、"}, {"type": "subtitle", "time": 1755.99, "timestamp": "00:29:15", "text": "アラートが届いた。 それで、Twitchのチャットでアラートを受け取ったんです"}, {"type": "chat", "time": 1764.047, "timestamp": "00:29:24", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/egJ1XufTKYfegwOo57ewAg"}, {"type": "subtitle", "time": 1765.99, "timestamp": "00:29:25", "text": "通常は"}, {"type": "subtitle", "time": 1780.47, "timestamp": "00:29:40", "text": "こんにちは、お元気ですか"}, {"type": "chat", "time": 1783.946, "timestamp": "00:29:43", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/ibEsXBiXAsrBWCWbTkgZ0bJd9N5UtKdTJ0xuH90CmHq-Zp-Lnzzyh3Y-5uAHMTNH94HMGGOwgWY=s64-c-k-c0x00ffffff-no-rj", "message": "Hi Mikazuki"}, {"type": "subtitle", "time": 1791.59, "timestamp": "00:29:51", "text": "配信はどうでしたか？"}, {"type": "subtitle", "time": 1793.99, "timestamp": "00:29:53", "text": "あなたの配信を少しだけ見ました。"}]
[{"type": "subtitle", "time": 1384.95, "timestamp": "00:23:04", "text": "。 ごめん。 私はあなたが敵だと思っていました。"}, {"type": "subtitle", "time": 1387.11, "timestamp": "00:23:07", "text": "大丈夫です。   わかった"}, {"type": "subtitle", "time": 1405.99, "timestamp": "00:23:25", "text": "。 とんでもない。 私は自分のチームを殺してしまった。"}, {"type": "subtitle", "time": 1408.256, "timestamp": "00:23:28", "text": "味方によるキル。 ああ、くそ"}, {"type": "subtitle", "time": 1434.149, "timestamp": "00:23:54", "text": "ああ、彼は死んだ。 いいえ、私たちが"}, {"type": "subtitle", "time": 1436.47, "timestamp": "00:23:56", "text": "既にお互いを避けていることを考えると、この主張はあり得ません"}, {"type": "subtitle", "time": 1439.83, "timestamp": "00:23:59", "text": "。"}]
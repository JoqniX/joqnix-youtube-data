[{"type": "subtitle", "time": 12601.67, "timestamp": "03:30:01", "text": "、"}, {"type": "subtitle", "time": 12604.63, "timestamp": "03:30:04", "text": "ストリームやゲームストリームをしている時は、"}, {"type": "subtitle", "time": 12607.349, "timestamp": "03:30:07", "text": "このように安定していることを願っています。"}, {"type": "subtitle", "time": 12611.99, "timestamp": "03:30:11", "text": "そして、"}, {"type": "subtitle", "time": 12614.469, "timestamp": "03:30:14", "text": "バックエンドでさらに良くする方法があれば、やってみます"}, {"type": "subtitle", "time": 12617.75, "timestamp": "03:30:17", "text": "。今まさに"}, {"type": "subtitle", "time": 12619.99, "timestamp": "03:30:19", "text": "頭に浮かんだアイデアがいくつかあります"}, {"type": "subtitle", "time": 12622.229, "timestamp": "03:30:22", "text": "。[音楽] やってみます"}, {"type": "subtitle", "time": 12626.15, "timestamp": "03:30:26", "text": "。さようなら。今日は来てくれて、ミナ、改めてありがとう。"}, {"type": "subtitle", "time": 12632.15, "timestamp": "03:30:32", "text": "次の配信でお会いしましょう。さようなら。おやすみなさい。"}, {"type": "subtitle", "time": 12633.91, "timestamp": "03:30:33", "text": "今夜、星々があなたを祝福し、"}, {"type": "subtitle", "time": 12636.95, "timestamp": "03:30:36", "text": "導き、見守り、"}, {"type": "subtitle", "time": 12639.75, "timestamp": "03:30:39", "text": "あなたの"}, {"type": "subtitle", "time": 12643.429, "timestamp": "03:30:43", "text": "今夜はいい夢を見ました。話すことは何もありません。"}]
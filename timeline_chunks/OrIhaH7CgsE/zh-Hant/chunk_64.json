[{"type": "subtitle", "time": 3859.108, "timestamp": "01:04:19", "text": "我得等。呃，我 又開始播出了？問候。"}, {"type": "subtitle", "time": 3865.631, "timestamp": "01:04:25", "text": "哦，老兄，沒錯。"}, {"type": "subtitle", "time": 3867.71, "timestamp": "01:04:27", "text": "惱人的。說實話，現在"}, {"type": "subtitle", "time": 3876.839, "timestamp": "01:04:36", "text": "我希望在那裡，我"}, {"type": "subtitle", "time": 3877.84, "timestamp": "01:04:37", "text": "仍在播出。"}, {"type": "subtitle", "time": 3884.408, "timestamp": "01:04:44", "text": "似乎是我的區域"}, {"type": "subtitle", "time": 3885.651, "timestamp": "01:04:45", "text": "學校“已死”"}, {"type": "subtitle", "time": 3889.204, "timestamp": "01:04:49", "text": "區域」。看來這個區域"}, {"type": "subtitle", "time": 3890.197, "timestamp": "01:04:50", "text": "我的學校—這"}, {"type": "subtitle", "time": 3891.373, "timestamp": "01:04:51", "text": "實心“死亡”"}, {"type": "subtitle", "time": 3898.825, "timestamp": "01:04:58", "text": "網路區域」。因此，"}]
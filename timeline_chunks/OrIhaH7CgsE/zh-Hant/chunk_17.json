[{"type": "subtitle", "time": 1023.061, "timestamp": "00:17:03", "text": "輝光。但我沒有"}, {"type": "subtitle", "time": 1024.284, "timestamp": "00:17:04", "text": "我可以把它放在那裡嗎？"}, {"type": "subtitle", "time": 1027.056, "timestamp": "00:17:07", "text": "手。這裡，呃，不是"}, {"type": "subtitle", "time": 1028.516, "timestamp": "00:17:08", "text": "我知道，你明白嗎？"}, {"type": "subtitle", "time": 1030.062, "timestamp": "00:17:10", "text": "那個USB接口更大"}, {"type": "subtitle", "time": 1033.592, "timestamp": "00:17:13", "text": "無法運行。我是。"}, {"type": "subtitle", "time": 1037.723, "timestamp": "00:17:17", "text": "我現在勉強可以做到。"}, {"type": "subtitle", "time": 1040.195, "timestamp": "00:17:20", "text": "勉強應付過去。但"}, {"type": "subtitle", "time": 1041.059, "timestamp": "00:17:21", "text": "誰知道他是否"}, {"type": "subtitle", "time": 1042.322, "timestamp": "00:17:22", "text": "絕對值得。"}, {"type": "subtitle", "time": 1044.621, "timestamp": "00:17:24", "text": "是的，這是真的。"}, {"type": "subtitle", "time": 1046.207, "timestamp": "00:17:26", "text": "生活不易啊。我有"}, {"type": "subtitle", "time": 1049.556, "timestamp": "00:17:29", "text": "我的意思是，串流媒體—— 說實話，這真是太…"}, {"type": "subtitle", "time": 1051.094, "timestamp": "00:17:31", "text": "說實話，這真是太… 麵粉，如果你不知道的話，"}, {"type": "subtitle", "time": 1052.477, "timestamp": "00:17:32", "text": "麵粉，如果你不知道的話， 你在幹什麼？我該怎麼做？"}, {"type": "subtitle", "time": 1055.797, "timestamp": "00:17:35", "text": "你在幹什麼？我該怎麼做？ 隱藏？該怎麼辦..."}, {"type": "subtitle", "time": 1061.505, "timestamp": "00:17:41", "text": "隱藏？該怎麼辦... 我不需要它。"}, {"type": "subtitle", "time": 1068.4, "timestamp": "00:17:48", "text": "出去。你仍然"}, {"type": "subtitle", "time": 1071.809, "timestamp": "00:17:51", "text": "你看到了嗎？哦，這個，哦，這個"}, {"type": "subtitle", "time": 1074.218, "timestamp": "00:17:54", "text": "這事真煩人。我不知道。"}]
[{"type": "subtitle", "time": 4624.013, "timestamp": "01:17:04", "text": "這種心情。所以，我"}, {"type": "subtitle", "time": 4625.084, "timestamp": "01:17:05", "text": "我會經歷這個過程。"}, {"type": "subtitle", "time": 4632.948, "timestamp": "01:17:12", "text": "領土，並將成為"}, {"type": "subtitle", "time": 4639.164, "timestamp": "01:17:19", "text": "學校大約在12點10分左右到校。"}, {"type": "subtitle", "time": 4645.721, "timestamp": "01:17:25", "text": "或 12:15。好的。但是這樣"}, {"type": "subtitle", "time": 4646.879, "timestamp": "01:17:26", "text": "這意味著當我們"}, {"type": "subtitle", "time": 4648.373, "timestamp": "01:17:28", "text": "我們會回來的，我"}, {"type": "subtitle", "time": 4651.877, "timestamp": "01:17:31", "text": "我會關閉直播。好的。"}, {"type": "subtitle", "time": 4655.71, "timestamp": "01:17:35", "text": "我什麼時候開始直播的？"}, {"type": "subtitle", "time": 4660.549, "timestamp": "01:17:40", "text": "大概10點15分左右，對吧？ 10:15"}, {"type": "subtitle", "time": 4664.267, "timestamp": "01:17:44", "text": "大概是10點15分左右。"}, {"type": "subtitle", "time": 4667.696, "timestamp": "01:17:47", "text": "是的。 10:17。 10:20。能"}, {"type": "subtitle", "time": 4670.016, "timestamp": "01:17:50", "text": "例如從10:20到11:00。"}, {"type": "subtitle", "time": 4674.706, "timestamp": "01:17:54", "text": "11到12歲。哦，是的。 12:15。是的。"}, {"type": "subtitle", "time": 4678.862, "timestamp": "01:17:58", "text": "大概需要2小時。 N."}]
[{"type": "subtitle", "time": 5283.782, "timestamp": "01:28:03", "text": "加載中，對吧？"}, {"type": "subtitle", "time": 5284.647, "timestamp": "01:28:04", "text": "必要條件"}, {"type": "subtitle", "time": 5285.912, "timestamp": "01:28:05", "text": "稍等片刻。"}, {"type": "subtitle", "time": 5286.444, "timestamp": "01:28:06", "text": "而他"}, {"type": "subtitle", "time": 5289.467, "timestamp": "01:28:09", "text": "穩定下來。是的。"}, {"type": "subtitle", "time": 5294.958, "timestamp": "01:28:14", "text": "但有一件事我"}, {"type": "subtitle", "time": 5296.32, "timestamp": "01:28:16", "text": "你知道，這很令人困惑，我也是。"}, {"type": "subtitle", "time": 5297.51, "timestamp": "01:28:17", "text": "騎自行車"}, {"type": "subtitle", "time": 5301.635, "timestamp": "01:28:21", "text": "因為這個地方，對吧？和"}, {"type": "subtitle", "time": 5303.618, "timestamp": "01:28:23", "text": "我去了哦，"}, {"type": "subtitle", "time": 5305.175, "timestamp": "01:28:25", "text": "等等，等等，"}, {"type": "subtitle", "time": 5306.736, "timestamp": "01:28:26", "text": "等待。我記得，在"}, {"type": "subtitle", "time": 5308.101, "timestamp": "01:28:28", "text": "我們遇到了一些問題"}, {"type": "subtitle", "time": 5309.251, "timestamp": "01:28:29", "text": "該地區的通訊"}, {"type": "subtitle", "time": 5311.093, "timestamp": "01:28:31", "text": "我的學校。是的。是的。"}, {"type": "subtitle", "time": 5312.632, "timestamp": "01:28:32", "text": "是的。學區不"}, {"type": "subtitle", "time": 5314.947, "timestamp": "01:28:34", "text": "就在那張地圖上。他"}, {"type": "subtitle", "time": 5316.312, "timestamp": "01:28:36", "text": "他斷開了連接。"}, {"type": "subtitle", "time": 5318.646, "timestamp": "01:28:38", "text": "通過印度尼西亞。和，"}, {"type": "subtitle", "time": 5324.728, "timestamp": "01:28:44", "text": "但當我下來的時候"}, {"type": "subtitle", "time": 5325.915, "timestamp": "01:28:45", "text": "到河岸下方"}, {"type": "subtitle", "time": 5326.905, "timestamp": "01:28:46", "text": "橋，一切都是"}, {"type": "subtitle", "time": 5331.286, "timestamp": "01:28:51", "text": "好的。好了，現在。"}, {"type": "subtitle", "time": 5332.646, "timestamp": "01:28:52", "text": "網路不穩定。"}, {"type": "subtitle", "time": 5337.897, "timestamp": "01:28:57", "text": "米諾，你要去嗎？"}, {"type": "subtitle", "time": 5338.959, "timestamp": "01:28:58", "text": "看看一些"}]
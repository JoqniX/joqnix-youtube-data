[{"type": "subtitle", "time": 5400.192, "timestamp": "01:30:00", "text": "那間廁所"}, {"type": "subtitle", "time": 5401.582, "timestamp": "01:30:01", "text": "那邊的展位。在那"}, {"type": "subtitle", "time": 5402.918, "timestamp": "01:30:02", "text": "綠色的。我只是"}, {"type": "subtitle", "time": 5404.037, "timestamp": "01:30:04", "text": "我意識到有"}, {"type": "subtitle", "time": 5405.394, "timestamp": "01:30:05", "text": "反射面"}, {"type": "subtitle", "time": 5408.112, "timestamp": "01:30:08", "text": "光。魔鬼。也許，"}, {"type": "subtitle", "time": 5409.453, "timestamp": "01:30:09", "text": "你看到什麼了嗎？"}, {"type": "subtitle", "time": 5410.94, "timestamp": "01:30:10", "text": "不該看到的。我不是"}, {"type": "subtitle", "time": 5413.347, "timestamp": "01:30:13", "text": "我知道。是的，我們"}, {"type": "subtitle", "time": 5414.667, "timestamp": "01:30:14", "text": "我們要回去了。"}, {"type": "subtitle", "time": 5417.796, "timestamp": "01:30:17", "text": "現在是12點05分。我們即將到來"}, {"type": "subtitle", "time": 5418.981, "timestamp": "01:30:18", "text": "直播即將結束。"}, {"type": "subtitle", "time": 5429.115, "timestamp": "01:30:29", "text": "好的。我們會完成的。"}, {"type": "subtitle", "time": 5441.265, "timestamp": "01:30:41", "text": "等等等等。 D. 我不"}, {"type": "subtitle", "time": 5451.951, "timestamp": "01:30:51", "text": "我知道。我不。"}, {"type": "subtitle", "time": 5459.025, "timestamp": "01:30:59", "text": "注意到了。我自己"}]
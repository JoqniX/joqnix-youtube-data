[{"type": "subtitle", "time": 300.309, "timestamp": "00:05:00", "text": "當你……的時候，那真是太糟糕了。"}, {"type": "subtitle", "time": 301.733, "timestamp": "00:05:01", "text": "生病的時候，尤其是當"}, {"type": "subtitle", "time": 302.802, "timestamp": "00:05:02", "text": "好了，就到此為止。"}, {"type": "subtitle", "time": 308.809, "timestamp": "00:05:08", "text": "日本這裡也出現了流感。"}, {"type": "subtitle", "time": 311.023, "timestamp": "00:05:11", "text": "所以大家"}, {"type": "subtitle", "time": 312.364, "timestamp": "00:05:12", "text": "感冒什麼的"}, {"type": "subtitle", "time": 315.66, "timestamp": "00:05:15", "text": "像這樣。老實說"}, {"type": "subtitle", "time": 317.017, "timestamp": "00:05:17", "text": "他說，這是真的"}, {"type": "subtitle", "time": 321.359, "timestamp": "00:05:21", "text": "疼痛。好了，就是這樣。"}, {"type": "subtitle", "time": 323.491, "timestamp": "00:05:23", "text": "正在發生。給"}, {"type": "subtitle", "time": 326.195, "timestamp": "00:05:26", "text": "給我一分鐘時間。我"}, {"type": "subtitle", "time": 326.89300000000003, "timestamp": "00:05:26", "text": "我想"}, {"type": "subtitle", "time": 328.068, "timestamp": "00:05:28", "text": "建立你自己的"}, {"type": "subtitle", "time": 330.165, "timestamp": "00:05:30", "text": "事物。所以，我們要走了。"}, {"type": "subtitle", "time": 334.753, "timestamp": "00:05:34", "text": "騎一小段路。我"}, {"type": "subtitle", "time": 335.927, "timestamp": "00:05:35", "text": "我會去那個地方。"}, {"type": "subtitle", "time": 337.133, "timestamp": "00:05:37", "text": "可能在海邊"}, {"type": "subtitle", "time": 338.405, "timestamp": "00:05:38", "text": "我們聊聊吧。"}, {"type": "subtitle", "time": 339.611, "timestamp": "00:05:39", "text": "我們會在那裡待一段時間。"}, {"type": "subtitle", "time": 340.85, "timestamp": "00:05:40", "text": "我們去那裡待一會兒好嗎？"}, {"type": "subtitle", "time": 347.368, "timestamp": "00:05:47", "text": "差不多就是這樣。嗯，就是這樣。不是"}, {"type": "subtitle", "time": 348.719, "timestamp": "00:05:48", "text": "我知道我做了什麼。"}, {"type": "subtitle", "time": 350.993, "timestamp": "00:05:50", "text": "記住，我說過"}, {"type": "subtitle", "time": 352.572, "timestamp": "00:05:52", "text": "你知道我的行動電源是什麼嗎？"}, {"type": "subtitle", "time": 355.886, "timestamp": "00:05:55", "text": "損壞或完全沒有"}, {"type": "subtitle", "time": 357.15999999999997, "timestamp": "00:05:57", "text": "最後沒用"}, {"type": "subtitle", "time": 358.748, "timestamp": "00:05:58", "text": "有時？所以，大概是吧。"}, {"type": "subtitle", "time": 359.947, "timestamp": "00:05:59", "text": "他現在正在工作。"}]
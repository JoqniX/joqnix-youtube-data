[{"type": "subtitle", "time": 1988.404, "timestamp": "00:33:08", "text": "不知怎麼的，它居然奏效了。案件"}, {"type": "subtitle", "time": 1992.299, "timestamp": "00:33:12", "text": "事情是這樣的：哦，是的，你"}, {"type": "subtitle", "time": 1993.421, "timestamp": "00:33:13", "text": "你可以傷害我。"}, {"type": "subtitle", "time": 1994.446, "timestamp": "00:33:14", "text": "聽不見，因為我聽不見"}, {"type": "subtitle", "time": 1995.439, "timestamp": "00:33:15", "text": "使用"}, {"type": "subtitle", "time": 1996.624, "timestamp": "00:33:16", "text": "外置麥克風，"}, {"type": "subtitle", "time": 1997.714, "timestamp": "00:33:17", "text": "因為我正在充電"}, {"type": "subtitle", "time": 1998.643, "timestamp": "00:33:18", "text": "電話期間"}, {"type": "subtitle", "time": 2001.394, "timestamp": "00:33:21", "text": "溪流。所以問題是："}, {"type": "subtitle", "time": 2002.722, "timestamp": "00:33:22", "text": "我必須走了"}, {"type": "subtitle", "time": 2003.607, "timestamp": "00:33:23", "text": "騎自行車"}, {"type": "subtitle", "time": 2008.142, "timestamp": "00:33:28", "text": "慢慢地，呃，是"}, {"type": "subtitle", "time": 2008.984, "timestamp": "00:33:28", "text": "小心"}, {"type": "subtitle", "time": 2010.17, "timestamp": "00:33:30", "text": "坑洞等等"}, {"type": "subtitle", "time": 2013.699, "timestamp": "00:33:33", "text": "像這樣。我們開始吧"}, {"type": "subtitle", "time": 2020.354, "timestamp": "00:33:40", "text": "真的嗎？我的天哪，我不知道"}, {"type": "subtitle", "time": 2022.912, "timestamp": "00:33:42", "text": "我聽到有人在聊天。最重要的是我"}, {"type": "subtitle", "time": 2024.253, "timestamp": "00:33:44", "text": "我能聽到聊天內容，什麼都聽得到。"}, {"type": "subtitle", "time": 2025.989, "timestamp": "00:33:45", "text": "好的。但我做不到。"}, {"type": "subtitle", "time": 2027.373, "timestamp": "00:33:47", "text": "對了，記得看看聊天記錄。"}, {"type": "subtitle", "time": 2030.272, "timestamp": "00:33:50", "text": "所以我其實不太清楚。"}, {"type": "subtitle", "time": 2035.298, "timestamp": "00:33:55", "text": "我知道我要去哪裡。是的，"}, {"type": "subtitle", "time": 2036.997, "timestamp": "00:33:56", "text": "我們的目標是達到"}]
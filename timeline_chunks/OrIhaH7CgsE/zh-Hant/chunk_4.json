[{"type": "subtitle", "time": 243.468, "timestamp": "00:04:03", "text": "好的。我們有了一個新的"}, {"type": "subtitle", "time": 246.722, "timestamp": "00:04:06", "text": "稱呼。問候，"}, {"type": "subtitle", "time": 248.65, "timestamp": "00:04:08", "text": "卡麗莎。恭喜。恭喜。"}, {"type": "subtitle", "time": 252.655, "timestamp": "00:04:12", "text": "和今天其他人一樣"}, {"type": "subtitle", "time": 254.852, "timestamp": "00:04:14", "text": "婚外情？大家好。"}, {"type": "subtitle", "time": 259.633, "timestamp": "00:04:19", "text": "所以，呃，今天是"}, {"type": "subtitle", "time": 260.779, "timestamp": "00:04:20", "text": "需要的東西"}, {"type": "subtitle", "time": 264.866, "timestamp": "00:04:24", "text": "製作。我們會這樣做"}, {"type": "subtitle", "time": 266.136, "timestamp": "00:04:26", "text": "早晨錄音。在"}, {"type": "subtitle", "time": 267.05, "timestamp": "00:04:27", "text": "我今天的"}, {"type": "subtitle", "time": 268.60699999999997, "timestamp": "00:04:28", "text": "職業。嗯，今天"}, {"type": "subtitle", "time": 270.035, "timestamp": "00:04:30", "text": "我非常非常忙。"}, {"type": "subtitle", "time": 273.067, "timestamp": "00:04:33", "text": "嗯，是的，我有。"}, {"type": "subtitle", "time": 274.29200000000003, "timestamp": "00:04:34", "text": "今天上課。"}, {"type": "subtitle", "time": 275.019, "timestamp": "00:04:35", "text": "今天我"}, {"type": "subtitle", "time": 276.339, "timestamp": "00:04:36", "text": "非常忙碌 。嗯，我得去…"}, {"type": "subtitle", "time": 278.001, "timestamp": "00:04:38", "text": "。嗯，我得去… 工作等等。"}, {"type": "subtitle", "time": 281.811, "timestamp": "00:04:41", "text": "所以，我最近"}, {"type": "subtitle", "time": 286.511, "timestamp": "00:04:46", "text": "生病了。這就是我無法做到的原因"}, {"type": "subtitle", "time": 287.702, "timestamp": "00:04:47", "text": "保留一些"}, {"type": "subtitle", "time": 292.201, "timestamp": "00:04:52", "text": "天。你好，這裡是"}, {"type": "subtitle", "time": 294.369, "timestamp": "00:04:54", "text": "西班牙。但我現在也在其中。"}, {"type": "subtitle", "time": 299.24, "timestamp": "00:04:59", "text": "命令。是的，的確如此。"}]
[{"type": "subtitle", "time": 2820.029, "timestamp": "00:47:00", "text": "可以使用"}, {"type": "subtitle", "time": 2820.811, "timestamp": "00:47:00", "text": "針對你"}, {"type": "subtitle", "time": 2821.844, "timestamp": "00:47:01", "text": "簽證延期"}, {"type": "subtitle", "time": 2822.782, "timestamp": "00:47:02", "text": "如果他們正在談論這件事"}, {"type": "subtitle", "time": 2840.214, "timestamp": "00:47:20", "text": "查出。我更新了"}, {"type": "subtitle", "time": 2841.291, "timestamp": "00:47:21", "text": "您的系統"}, {"type": "subtitle", "time": 2844.623, "timestamp": "00:47:24", "text": "串流媒體。我的朋友"}, {"type": "subtitle", "time": 2845.954, "timestamp": "00:47:25", "text": "開發了這個應用。"}, {"type": "subtitle", "time": 2847.675, "timestamp": "00:47:27", "text": "他改進了它。"}, {"type": "subtitle", "time": 2848.923, "timestamp": "00:47:28", "text": "與我相比"}, {"type": "subtitle", "time": 2849.876, "timestamp": "00:47:29", "text": "用過的"}, {"type": "subtitle", "time": 2852.505, "timestamp": "00:47:32", "text": "更早。這裡沒什麼特別的。"}, {"type": "subtitle", "time": 2854.888, "timestamp": "00:47:34", "text": "好的。我可以這麼說，"}, {"type": "subtitle", "time": 2856.403, "timestamp": "00:47:36", "text": "互聯網的品質和"}, {"type": "subtitle", "time": 2866.015, "timestamp": "00:47:46", "text": "其他方面——就沒那麼重要了。和，"}, {"type": "subtitle", "time": 2873.704, "timestamp": "00:47:53", "text": "這樣好多了。等待，"}, {"type": "subtitle", "time": 2876.96, "timestamp": "00:47:56", "text": "夥計們。我不知道是否"}, {"type": "subtitle", "time": 2878.035, "timestamp": "00:47:58", "text": "我現在就需要。"}]
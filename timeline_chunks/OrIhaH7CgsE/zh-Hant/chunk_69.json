[{"type": "subtitle", "time": 4141.636, "timestamp": "01:09:01", "text": "向下延伸。這是什麼？"}, {"type": "subtitle", "time": 4145.106, "timestamp": "01:09:05", "text": "這不是公園。我勒個去？ ？這裡根本不是公園。"}, {"type": "subtitle", "time": 4150.423, "timestamp": "01:09:10", "text": "更像是"}, {"type": "subtitle", "time": 4162.489, "timestamp": "01:09:22", "text": "隧道。好的。我認為"}, {"type": "subtitle", "time": 4167.037, "timestamp": "01:09:27", "text": "我可以像這樣：呃"}, {"type": "subtitle", "time": 4169.25, "timestamp": "01:09:29", "text": "你怎麼認為？"}, {"type": "subtitle", "time": 4170.582, "timestamp": "01:09:30", "text": "私人領地"}, {"type": "subtitle", "time": 4172.59, "timestamp": "01:09:32", "text": "那裡？我想看"}, {"type": "subtitle", "time": 4173.66, "timestamp": "01:09:33", "text": "那片風景，但是"}, {"type": "subtitle", "time": 4175.051, "timestamp": "01:09:35", "text": "看起來像是私人地方。"}, {"type": "subtitle", "time": 4177.821, "timestamp": "01:09:37", "text": "財產。啊，這個"}, {"type": "subtitle", "time": 4179.195, "timestamp": "01:09:39", "text": "私人領地。"}, {"type": "subtitle", "time": 4192.741, "timestamp": "01:09:52", "text": "好了，就這些。這是這種類型"}, {"type": "subtitle", "time": 4194.024, "timestamp": "01:09:54", "text": "這是最高的塔"}, {"type": "subtitle", "time": 4197.432, "timestamp": "01:09:57", "text": "區。最高的塔。"}, {"type": "subtitle", "time": 4199.326, "timestamp": "01:09:59", "text": "從那裡可以看到一切。"}]
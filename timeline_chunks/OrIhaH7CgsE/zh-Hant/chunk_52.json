[{"type": "subtitle", "time": 3122.81, "timestamp": "00:52:02", "text": "學校。那我走了。"}, {"type": "subtitle", "time": 3137.755, "timestamp": "00:52:17", "text": "遠的。我會做點什麼。"}, {"type": "subtitle", "time": 3147.764, "timestamp": "00:52:27", "text": "我停車的地方。"}, {"type": "subtitle", "time": 3150.802, "timestamp": "00:52:30", "text": "哦，等等。我不能"}, {"type": "subtitle", "time": 3152.407, "timestamp": "00:52:32", "text": "去這裡。我的天啊。"}, {"type": "subtitle", "time": 3156.253, "timestamp": "00:52:36", "text": "不，不，不，不，不，不。"}, {"type": "subtitle", "time": 3163.25, "timestamp": "00:52:43", "text": "這很冒險。我可以"}, {"type": "subtitle", "time": 3168.405, "timestamp": "00:52:48", "text": "我很想，但我做不到。是的，"}, {"type": "subtitle", "time": 3169.773, "timestamp": "00:52:49", "text": "我在學校外面。"}, {"type": "subtitle", "time": 3173.241, "timestamp": "00:52:53", "text": "領土。這就是我的原因"}, {"type": "subtitle", "time": 3174.602, "timestamp": "00:52:54", "text": "我必須離開學校。"}, {"type": "subtitle", "time": 3175.579, "timestamp": "00:52:55", "text": "因此，連接是"}]
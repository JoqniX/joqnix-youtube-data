[{"type": "subtitle", "time": 2772.289, "timestamp": "00:46:12", "text": "老兄。我只是"}, {"type": "subtitle", "time": 2773.624, "timestamp": "00:46:13", "text": "我希望沒有人"}, {"type": "subtitle", "time": 2774.853, "timestamp": "00:46:14", "text": "會注意到我在開車"}, {"type": "subtitle", "time": 2777.594, "timestamp": "00:46:17", "text": "直播，但是，聽著，"}, {"type": "subtitle", "time": 2778.934, "timestamp": "00:46:18", "text": "我來告訴你一個秘密。"}, {"type": "subtitle", "time": 2784.019, "timestamp": "00:46:24", "text": "說實話，如果你"}, {"type": "subtitle", "time": 2785.197, "timestamp": "00:46:25", "text": "你來到這裡"}, {"type": "subtitle", "time": 2786.408, "timestamp": "00:46:26", "text": "以留學生身分赴日留學"}, {"type": "subtitle", "time": 2787.586, "timestamp": "00:46:27", "text": "學生簽證"}, {"type": "subtitle", "time": 2788.382, "timestamp": "00:46:28", "text": "你不得"}, {"type": "subtitle", "time": 2789.465, "timestamp": "00:46:29", "text": "做任何事"}, {"type": "subtitle", "time": 2790.708, "timestamp": "00:46:30", "text": "無關事項，"}, {"type": "subtitle", "time": 2800.48, "timestamp": "00:46:40", "text": "實際上。並且"}, {"type": "subtitle", "time": 2801.793, "timestamp": "00:46:41", "text": "無關事項"}, {"type": "subtitle", "time": 2803.072, "timestamp": "00:46:43", "text": "意思是…"}, {"type": "subtitle", "time": 2804.316, "timestamp": "00:46:44", "text": "這超越了"}, {"type": "subtitle", "time": 2805.594, "timestamp": "00:46:45", "text": "你的簽證，這也是"}, {"type": "subtitle", "time": 2806.838, "timestamp": "00:46:46", "text": "包括 YouTube、TikTok 和"}, {"type": "subtitle", "time": 2808.082, "timestamp": "00:46:48", "text": "任何平台，"}, {"type": "subtitle", "time": 2809.084, "timestamp": "00:46:49", "text": "你在哪裡創作"}, {"type": "subtitle", "time": 2809.844, "timestamp": "00:46:49", "text": "內容或"}, {"type": "subtitle", "time": 2810.88, "timestamp": "00:46:50", "text": "你收到過嗎？"}, {"type": "subtitle", "time": 2811.778, "timestamp": "00:46:51", "text": "錢或其他什麼東西"}, {"type": "subtitle", "time": 2818.903, "timestamp": "00:46:58", "text": "貨幣。是的。"
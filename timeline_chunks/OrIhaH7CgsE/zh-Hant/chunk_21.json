[{"type": "subtitle", "time": 1264.025, "timestamp": "00:21:04", "text": "無需改變。呃，"}, {"type": "subtitle", "time": 1274.358, "timestamp": "00:21:14", "text": "好的。是的，就像"}, {"type": "subtitle", "time": 1275.395, "timestamp": "00:21:15", "text": "河流或下水道"}, {"type": "subtitle", "time": 1276.79, "timestamp": "00:21:16", "text": "溝渠，或不管它是什麼。"}, {"type": "subtitle", "time": 1288.208, "timestamp": "00:21:28", "text": "什麼……我有個主意。有，"}, {"type": "subtitle", "time": 1289.445, "timestamp": "00:21:29", "text": "給我，我收下。"}, {"type": "subtitle", "time": 1304.091, "timestamp": "00:21:44", "text": "三腳架。我需要"}, {"type": "subtitle", "time": 1314.237, "timestamp": "00:21:54", "text": "離開這裡。好的，"}, {"type": "subtitle", "time": 1318.326, "timestamp": "00:21:58", "text": "這裡有一個三腳架。問題"}, {"type": "subtitle", "time": 1319.525, "timestamp": "00:21:59", "text": "因為該怎麼說呢？"}]
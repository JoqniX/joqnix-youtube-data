[{"type": "subtitle", "time": 2940.666, "timestamp": "00:49:00", "text": "我仍然想做這件事。"}, {"type": "subtitle", "time": 2943.81, "timestamp": "00:49:03", "text": "相機呢？我有"}, {"type": "subtitle", "time": 2945.079, "timestamp": "00:49:05", "text": "沒有運動相機。"}, {"type": "subtitle", "time": 2947.999, "timestamp": "00:49:07", "text": "我只有舊的那一個。"}, {"type": "subtitle", "time": 2949.596, "timestamp": "00:49:09", "text": "三星手機，僅此而已。"}, {"type": "subtitle", "time": 2955.141, "timestamp": "00:49:15", "text": "還有這支手機"}, {"type": "subtitle", "time": 2956.485, "timestamp": "00:49:16", "text": "需要超快的速度"}, {"type": "subtitle", "time": 2957.729, "timestamp": "00:49:17", "text": "三星充電，否則"}, {"type": "subtitle", "time": 2958.938, "timestamp": "00:49:18", "text": "他來自某個奇怪的地方。"}, {"type": "subtitle", "time": 2959.913, "timestamp": "00:49:19", "text": "不需要理由"}, {"type": "subtitle", "time": 2963.544, "timestamp": "00:49:23", "text": "工作。所以這是"}, {"type": "subtitle", "time": 2969.665, "timestamp": "00:49:29", "text": "非常痛。所以，在"}, {"type": "subtitle", "time": 2970.702, "timestamp": "00:49:30", "text": "我只有這一本。"}, {"type": "subtitle", "time": 2974.455, "timestamp": "00:49:34", "text": "電話。我有一張。"}, {"type": "subtitle", "time": 2975.768, "timestamp": "00:49:35", "text": "自行車之類的東西，"}, {"type": "subtitle", "time": 2976.983, "timestamp": "00:49:36", "text": "但問題是，"}, {"type": "subtitle", "time": 2977.869, "timestamp": "00:49:37", "text": "他太…"}, {"type": "subtitle", "time": 2979.018, "timestamp": "00:49:39", "text": "它在搖晃，對吧？"}, {"type": "subtitle", "time": 2981.426, "timestamp": "00:49:41", "text": "他渾身都在發抖。"}, {"type": "subtitle", "time": 2988.209, "timestamp": "00:49:48", "text": "非常。甚至"}, {"type": "subtitle", "time": 2989.1, "timestamp": "00:49:49", "text": "我現在持有。"}, {"type": "subtitle", "time": 2990.19, "timestamp": "00:49:50", "text": "手裡拿著手機，"}, {"type": "subtitle", "time": 2991.478, "timestamp": "00:49:51", "text": "我可能會不小心刪除"}, {"type": "subtitle", "time": 2992.7, "timestamp": "00:49:52", "text": "你自己，因為相機可以"}, {"type": "subtitle", "time": 2995.727, "timestamp": "00:49:55", "text": "轉變。如果"}, {"type": "subtitle", "time": 2996.219, "timestamp": "00:49:56", "text": "電話"}, {"type": "subtitle", "time": 2997.301, "timestamp": "00:49:57", "text": "會翻過來，你"}, {"type": "subtitle", "time": 2998.614, "timestamp": "00:49:58", "text": "你會看到我的臉。"}]
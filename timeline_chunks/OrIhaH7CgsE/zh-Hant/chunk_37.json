[{"type": "subtitle", "time": 2220.452, "timestamp": "00:37:00", "text": "會消失，對嗎？是"}, {"type": "subtitle", "time": 2221.663, "timestamp": "00:37:01", "text": "請不要掉下去。"}, {"type": "subtitle", "time": 2224.094, "timestamp": "00:37:04", "text": "已經出院了。"}, {"type": "subtitle", "time": 2226.992, "timestamp": "00:37:06", "text": "你必須小心。"}, {"type": "subtitle", "time": 2231.686, "timestamp": "00:37:11", "text": "那太好了。"}, {"type": "subtitle", "time": 2234.24, "timestamp": "00:37:14", "text": "尤其是當"}, {"type": "subtitle", "time": 2235.542, "timestamp": "00:37:15", "text": "自行車晃動"}, {"type": "subtitle", "time": 2236.914, "timestamp": "00:37:16", "text": "諸如此類，但還是有機會的。"}, {"type": "subtitle", "time": 2238.079, "timestamp": "00:37:18", "text": "相機還可以"}, {"type": "subtitle", "time": 2242.363, "timestamp": "00:37:22", "text": "搖。是的，"}, {"type": "subtitle", "time": 2243.829, "timestamp": "00:37:23", "text": "前進的路上會遇到坎坷。"}, {"type": "subtitle", "time": 2263.586, "timestamp": "00:37:43", "text": "好的。他們"}, {"type": "subtitle", "time": 2264.836, "timestamp": "00:37:44", "text": "停下來等我。"}, {"type": "subtitle", "time": 2265.699, "timestamp": "00:37:45", "text": "因此我必須"}, {"type": "subtitle", "time": 2270.924, "timestamp": "00:37:50", "text": "鞠躬並顯露"}, {"type": "subtitle", "time": 2272.163, "timestamp": "00:37:52", "text": "如果尊重汽車"}, {"type": "subtitle", "time": 2273.402, "timestamp": "00:37:53", "text": "停下來，這樣你"}, {"type": "subtitle", "time": 2274.779, "timestamp": "00:37:54", "text": "因為行人而過馬路"}, {"type": "subtitle", "time": 2276.122, "timestamp": "00:37:56", "text": "以及騎自行車的人——這"}, {"type": "subtitle", "time": 2277.499, "timestamp": "00:37:57", "text": "優先保障駕駛員。"}]
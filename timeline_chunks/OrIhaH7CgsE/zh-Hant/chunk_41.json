[{"type": "subtitle", "time": 2463.269, "timestamp": "00:41:03", "text": "等等，電話。"}, {"type": "subtitle", "time": 2464.765, "timestamp": "00:41:04", "text": "正在充電嗎？好的，"}, {"type": "subtitle", "time": 2466.685, "timestamp": "00:41:06", "text": "收費。問候。"}, {"type": "subtitle", "time": 2469.28, "timestamp": "00:41:09", "text": "但說實話，我"}, {"type": "subtitle", "time": 2470.391, "timestamp": "00:41:10", "text": "我覺得我"}, {"type": "subtitle", "time": 2471.606, "timestamp": "00:41:11", "text": "需要買一個新的"}, {"type": "subtitle", "time": 2472.752, "timestamp": "00:41:12", "text": "行動電源之類的"}, {"type": "subtitle", "time": 2478.707, "timestamp": "00:41:18", "text": "像這樣。我不知道我怎麼會不"}, {"type": "subtitle", "time": 2479.677, "timestamp": "00:41:19", "text": "我知道我該怎麼做…"}, {"type": "subtitle", "time": 2481.212, "timestamp": "00:41:21", "text": "修復了舊的，但是"}, {"type": "subtitle", "time": 2486.97, "timestamp": "00:41:26", "text": "至少他會給"}, {"type": "subtitle", "time": 2487.889, "timestamp": "00:41:27", "text": "傷害你"}, {"type": "subtitle", "time": 2491.56, "timestamp": "00:41:31", "text": "僅當存在"}, {"type": "subtitle", "time": 2492.826, "timestamp": "00:41:32", "text": "超快充電。"}, {"type": "subtitle", "time": 2496.512, "timestamp": "00:41:36", "text": "它與…不相容"}, {"type": "subtitle", "time": 2497.701, "timestamp": "00:41:37", "text": "普通快遞"}, {"type": "subtitle", "time": 2500.03, "timestamp": "00:41:40", "text": "收費。這應該是"}, {"type": "subtitle", "time": 2506.302, "timestamp": "00:41:46", "text": "三星。呃，這支手機"}, {"type": "subtitle", "time": 2507.58, "timestamp": "00:41:47", "text": "厭惡平庸"}, {"type": "subtitle", "time": 2508.908, "timestamp": "00:41:48", "text": "快速充電。所以，"}, {"type": "subtitle", "time": 2510.693, "timestamp": "00:41:50", "text": "這是一個難忘的時刻。就是這樣。"}, {"type": "subtitle", "time": 2513.294, "timestamp": "00:41:53", "text": "全部。它會倒嗎？我"}, {"type": "subtitle", "time": 2514.766, "timestamp": "00:41:54", "text": "它好像要倒了。"}]
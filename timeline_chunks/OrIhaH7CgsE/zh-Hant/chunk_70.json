[{"type": "subtitle", "time": 4200.72, "timestamp": "01:10:00", "text": "城市裡的人像螞蟻一樣，"}, {"type": "subtitle", "time": 4201.661, "timestamp": "01:10:01", "text": "就像從…看到的景色"}, {"type": "subtitle", "time": 4207.504, "timestamp": "01:10:07", "text": "衛星。我在那裡。"}, {"type": "subtitle", "time": 4208.887, "timestamp": "01:10:08", "text": "在頂樓。"}, {"type": "subtitle", "time": 4211.317, "timestamp": "01:10:11", "text": "那裡真美。"}, {"type": "subtitle", "time": 4213.4, "timestamp": "01:10:13", "text": "景觀。我不知何故"}, {"type": "subtitle", "time": 4215.466, "timestamp": "01:10:15", "text": "帶你一起走。不是"}, {"type": "subtitle", "time": 4217.211, "timestamp": "01:10:17", "text": "今天。某種程度上不同"}, {"type": "subtitle", "time": 4218.745, "timestamp": "01:10:18", "text": "一起。也就是說，它可能"}, {"type": "subtitle", "time": 4227.458, "timestamp": "01:10:27", "text": "今天，但早上"}, {"type": "subtitle", "time": 4228.957, "timestamp": "01:10:28", "text": "我學校發生了變化"}, {"type": "subtitle", "time": 4230.678, "timestamp": "01:10:30", "text": "大約12點15分到家。"}, {"type": "subtitle", "time": 4236.004, "timestamp": "01:10:36", "text": "所以我需要"}, {"type": "subtitle", "time": 4237.411, "timestamp": "01:10:37", "text": "改變，關鍵在於…"}, {"type": "chat", "time": 4239.129, "timestamp": "01:10:39", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "good morning"}, {"type": "subtitle", "time": 4243.103, "timestamp": "01:10:43", "text": "我需要一句“你好”，"}, {"type": "subtitle", "time": 4246.569, "timestamp": "01:10:46", "text": "恭喜。我需要"}, {"type": "subtitle", "time": 4247.388, "timestamp": "01:10:47", "text": "換地方"}, {"type": "subtitle", "time": 4248.049, "timestamp": "01:10:48", "text": "停車處"}, {"type": "subtitle", "time": 4249.119, "timestamp": "01:10:49", "text": "一輛自行車，因為那裡"}, {"type": "subtitle", "time": 4250.348, "timestamp": "01:10:50", "text": "根本沒有空間。"}, {"type": "subtitle", "time": 4252.165, "timestamp": "01:10:52", "text": "我直接把它留下來了。"}, {"type": "subtitle", "time": 4253.369, "timestamp": "01:10:53", "text": "在附近某個地方"}, {"type": "subtitle", "time": 4254.066, "timestamp": "01:10:54", "text": "吸煙"}, {"type": "subtitle", "time": 4257.411, "timestamp": "01:10:57", "text": "學校裡的學生。"}, {"type": "subtitle", "time": 4258.783, "timestamp": "01:10:58", "text": "所以我不得不"}]
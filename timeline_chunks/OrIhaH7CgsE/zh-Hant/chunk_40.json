[{"type": "subtitle", "time": 2400.82, "timestamp": "00:40:00", "text": "等待。我希望如此。"}, {"type": "subtitle", "time": 2406.027, "timestamp": "00:40:06", "text": "攝影機正朝這邊移動。"}, {"type": "subtitle", "time": 2407.469, "timestamp": "00:40:07", "text": "不平整區域。它"}, {"type": "subtitle", "time": 2408.723, "timestamp": "00:40:08", "text": "但風險很大。"}, {"type": "subtitle", "time": 2410.597, "timestamp": "00:40:10", "text": "相機要掉下來了。電話"}, {"type": "subtitle", "time": 2413.314, "timestamp": "00:40:13", "text": "將會倒下。我需要"}, {"type": "subtitle", "time": 2416.25, "timestamp": "00:40:16", "text": "非法越境"}, {"type": "subtitle", "time": 2417.706, "timestamp": "00:40:17", "text": "另一邊。好的，"}, {"type": "subtitle", "time": 2419.165, "timestamp": "00:40:19", "text": "讓我來做。"}, {"type": "subtitle", "time": 2428.199, "timestamp": "00:40:28", "text": "哦，那是一輛垃圾車。啊，這個"}, {"type": "subtitle", "time": 2429.863, "timestamp": "00:40:29", "text": "不是垃圾車。它"}, {"type": "subtitle", "time": 2431.163, "timestamp": "00:40:31", "text": "肥料噴霧器。"}, {"type": "subtitle", "time": 2454.65, "timestamp": "00:40:54", "text": "好的。緩慢但"}, {"type": "subtitle", "time": 2458.692, "timestamp": "00:40:58", "text": "自信地。我們走吧。"}]
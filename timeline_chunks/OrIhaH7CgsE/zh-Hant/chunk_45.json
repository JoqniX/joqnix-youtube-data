[{"type": "subtitle", "time": 2702.49, "timestamp": "00:45:02", "text": "我有時間。好的，"}, {"type": "subtitle", "time": 2711.15, "timestamp": "00:45:11", "text": "我們等等。聲音的"}, {"type": "subtitle", "time": 2712.489, "timestamp": "00:45:12", "text": "看起來正常。"}, {"type": "subtitle", "time": 2714.626, "timestamp": "00:45:14", "text": "所以，一切都好。"}, {"type": "subtitle", "time": 2718.59, "timestamp": "00:45:18", "text": "好的。我非常非常"}, {"type": "subtitle", "time": 2720.835, "timestamp": "00:45:20", "text": "我真的很想去。為什麼"}, {"type": "subtitle", "time": 2722.105, "timestamp": "00:45:22", "text": "所有人都看著我 ？為什麼？為什麼每個人…為什麼"}, {"type": "subtitle", "time": 2725.851, "timestamp": "00:45:25", "text": "？為什麼？為什麼每個人…為什麼 大多數人"}, {"type": "subtitle", "time": 2726.747, "timestamp": "00:45:26", "text": "大多數人 在看我嗎？它"}, {"type": "subtitle", "time": 2728.962, "timestamp": "00:45:28", "text": "在看我嗎？它 透過相機或三腳架？"}, {"type": "subtitle", "time": 2744.136, "timestamp": "00:45:44", "text": "這太……莫名其妙了，"}]
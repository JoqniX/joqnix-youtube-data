[{"type": "subtitle", "time": 558.879, "timestamp": "00:09:18", "text": "你好。你好。你聽得到我嗎？"}, {"type": "subtitle", "time": 565.143, "timestamp": "00:09:25", "text": "我在這裡嗎？給我一個訊號，"}, {"type": "subtitle", "time": 568.983, "timestamp": "00:09:28", "text": "如果我正在直播。不，"}, {"type": "subtitle", "time": 570.196, "timestamp": "00:09:30", "text": "請提供"}, {"type": "subtitle", "time": 571.485, "timestamp": "00:09:31", "text": "如果我在其中，請給我一個信號。"}, {"type": "subtitle", "time": 572.91, "timestamp": "00:09:32", "text": "正在播出。如果你我"}, {"type": "subtitle", "time": 582.093, "timestamp": "00:09:42", "text": "你聽到了。好的。哦，你"}, {"type": "subtitle", "time": 587.096, "timestamp": "00:09:47", "text": "還在嗎？魔鬼。"}, {"type": "subtitle", "time": 593.844, "timestamp": "00:09:53", "text": "魔鬼。又來了，兄弟。"}, {"type": "subtitle", "time": 595.069, "timestamp": "00:09:55", "text": "這款行動電源— 一些"}, {"type": "subtitle", "time": 595.934, "timestamp": "00:09:55", "text": "一些 沒用。我需要什麼？"}]
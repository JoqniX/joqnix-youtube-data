[{"type": "subtitle", "time": 1324.541, "timestamp": "00:22:04", "text": "三腳架，這樣你就可以…"}, {"type": "subtitle", "time": 1325.634, "timestamp": "00:22:05", "text": "我無法把它放進去。"}, {"type": "subtitle", "time": 1326.908, "timestamp": "00:22:06", "text": "他喜歡這樣。我不能"}, {"type": "subtitle", "time": 1328.043, "timestamp": "00:22:08", "text": "我無法把它放進去。"}, {"type": "subtitle", "time": 1329.421, "timestamp": "00:22:09", "text": "他就是這樣。當然，他"}, {"type": "subtitle", "time": 1330.807, "timestamp": "00:22:10", "text": "會傾倒並摔倒。"}, {"type": "subtitle", "time": 1334.451, "timestamp": "00:22:14", "text": "所以，我也不知道，夥計們。"}, {"type": "subtitle", "time": 1338.734, "timestamp": "00:22:18", "text": "哦，這個價格太高了。"}, {"type": "subtitle", "time": 1350.283, "timestamp": "00:22:30", "text": "但如果我這樣做，"}, {"type": "subtitle", "time": 1351.496, "timestamp": "00:22:31", "text": "你不會看到這一點。"}]
[{"type": "subtitle", "time": 2640.073, "timestamp": "00:44:00", "text": "消失。好的。全部 好的。這將是"}, {"type": "subtitle", "time": 2648.989, "timestamp": "00:44:08", "text": "好的。這將是 有一些是好事。"}, {"type": "subtitle", "time": 2650.311, "timestamp": "00:44:10", "text": "有一些是好事。 統計數據顯示"}, {"type": "subtitle", "time": 2651.276, "timestamp": "00:44:11", "text": "統計數據顯示 顯示速度"}, {"type": "subtitle", "time": 2652.491, "timestamp": "00:44:12", "text": "顯示速度 手機，例如 GPS 設備"}, {"type": "subtitle", "time": 2653.456, "timestamp": "00:44:13", "text": "手機，例如 GPS 設備 速度表之類的東西"}, {"type": "subtitle", "time": 2654.635, "timestamp": "00:44:14", "text": "速度表之類的東西 像這樣。哪個"}, {"type": "subtitle", "time": 2658.103, "timestamp": "00:44:18", "text": "像這樣。哪個 我以…的速度行駛"}, {"type": "subtitle", "time": 2661.048, "timestamp": "00:44:21", "text": "我以…的速度行駛 自行車之類的東西"}, {"type": "subtitle", "time": 2662.309, "timestamp": "00:44:22", "text": "自行車之類的東西 相似的。大概就是這樣。"}, {"type": "subtitle", "time": 2663.986, "timestamp": "00:44:23", "text": "相似的。大概就是這樣。 很酷吧？所以..."}, {"type": "subtitle", "time": 2671.75, "timestamp": "00:44:31", "text": "這很簡單"}, {"type": "subtitle", "time": 2683.897, "timestamp": "00:44:43", "text": "完美。所以要么我"}, {"type": "subtitle", "time": 2685.271, "timestamp": "00:44:45", "text": "我會帶你去看這區域。"}, {"type": "subtitle", "time": 2686.681, "timestamp": "00:44:46", "text": "橋下，或市政廳下"}, {"type": "subtitle", "time": 2691.539, "timestamp": "00:44:51", "text": "或其他什麼。我不這麼認為。"}]
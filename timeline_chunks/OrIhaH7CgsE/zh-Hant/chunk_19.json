[{"type": "subtitle", "time": 1153.612, "timestamp": "00:19:13", "text": "例子。等待。"}, {"type": "subtitle", "time": 1163.575, "timestamp": "00:19:23", "text": "你看到了嗎？那個女人"}, {"type": "subtitle", "time": 1164.785, "timestamp": "00:19:24", "text": "用那種眼神看著我"}, {"type": "subtitle", "time": 1166.067, "timestamp": "00:19:26", "text": "公園裡，我想：「 該死，我不配。"}, {"type": "subtitle", "time": 1170.295, "timestamp": "00:19:30", "text": "該死，我不配。 「去那裡」。她"}, {"type": "subtitle", "time": 1172.729, "timestamp": "00:19:32", "text": "「去那裡」。她 他問我：“這是什麼？”"}, {"type": "subtitle", "time": 1174.245, "timestamp": "00:19:34", "text": "他問我：“這是什麼？” 你在幹嘛，兄弟？嗯"}, {"type": "subtitle", "time": 1177.415, "timestamp": "00:19:37", "text": "你在幹嘛，兄弟？嗯 很難握住你的手"}, {"type": "subtitle", "time": 1178.598, "timestamp": "00:19:38", "text": "很難握住你的手 像這樣伸展開來。"}, {"type": "subtitle", "time": 1185.398, "timestamp": "00:19:45", "text": "這是個餿主意。毫米。它"}, {"type": "subtitle", "time": 1189.426, "timestamp": "00:19:49", "text": "餿主意。它"}, {"type": "subtitle", "time": 1191.949, "timestamp": "00:19:51", "text": "很糟糕。我不能。是的"}, {"type": "subtitle", "time": 1193.247, "timestamp": "00:19:53", "text": "牽著你的手很煩。"}]
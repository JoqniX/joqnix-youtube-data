[{"type": "subtitle", "time": 2881.535, "timestamp": "00:48:01", "text": "去上學。那"}, {"type": "subtitle", "time": 2883.013, "timestamp": "00:48:03", "text": "正如老師將會看到的，"}, {"type": "subtitle", "time": 2885.768, "timestamp": "00:48:05", "text": "我的手機裡有什麼？"}, {"type": "subtitle", "time": 2887.679, "timestamp": "00:48:07", "text": "是的，我要去"}, {"type": "subtitle", "time": 2893.323, "timestamp": "00:48:13", "text": "自行車。我現在"}, {"type": "subtitle", "time": 2894.376, "timestamp": "00:48:14", "text": "我開車開得很慢，就像"}, {"type": "subtitle", "time": 2895.745, "timestamp": "00:48:15", "text": "蝸牛，這樣相機就不會"}, {"type": "subtitle", "time": 2897.009, "timestamp": "00:48:17", "text": "抖得太厲害了，而且"}, {"type": "subtitle", "time": 2898.414, "timestamp": "00:48:18", "text": "從三腳架上掉下來了，三腳架是"}, {"type": "subtitle", "time": 2904.707, "timestamp": "00:48:24", "text": "我的購物籃。是的，"}, {"type": "subtitle", "time": 2918.291, "timestamp": "00:48:38", "text": "這裡正在施工，我"}, {"type": "subtitle", "time": 2919.351, "timestamp": "00:48:39", "text": "想回來"}, {"type": "subtitle", "time": 2920.658, "timestamp": "00:48:40", "text": "向左走，但什麼也沒留下。"}, {"type": "subtitle", "time": 2922.931, "timestamp": "00:48:42", "text": "我在這裡左轉。"}, {"type": "subtitle", "time": 2930.839, "timestamp": "00:48:50", "text": "嗯，我希望有。"}, {"type": "subtitle", "time": 2932.485, "timestamp": "00:48:52", "text": "自行車停車處，因為"}, {"type": "subtitle", "time": 2939.209, "timestamp": "00:48:59", "text": "這是一條自行車道。我就是一切"}]
[{"type": "subtitle", "time": 2043.665, "timestamp": "00:34:03", "text": "橋。今日は"}, {"type": "subtitle", "time": 2044.68, "timestamp": "00:34:04", "text": "私たちはそこへ行く。"}, {"type": "subtitle", "time": 2052.571, "timestamp": "00:34:12", "text": "行けると思います。"}, {"type": "subtitle", "time": 2059.121, "timestamp": "00:34:19", "text": "こちらです。他の皆と同じように"}, {"type": "subtitle", "time": 2060.223, "timestamp": "00:34:20", "text": "最後に"}, {"type": "subtitle", "time": 2063.018, "timestamp": "00:34:23", "text": "時々？人生と"}, {"type": "subtitle", "time": 2070.063, "timestamp": "00:34:30", "text": "他の？え、どこ？"}, {"type": "subtitle", "time": 2074.352, "timestamp": "00:34:34", "text": "これは本当にそうなのでしょうか？何てことだ、"}, {"type": "subtitle", "time": 2075.378, "timestamp": "00:34:35", "text": "私は今"}, {"type": "subtitle", "time": 2076.61, "timestamp": "00:34:36", "text": "2番目を使う"}, {"type": "subtitle", "time": 2077.91, "timestamp": "00:34:37", "text": "電話して見る"}, {"type": "subtitle", "time": 2080.826, "timestamp": "00:34:40", "text": "カードはありますが、できません。それ"}, {"type": "subtitle", "time": 2087.626, "timestamp": "00:34:47", "text": "残念ながら。でも、えーと、今は"}, {"type": "subtitle", "time": 2088.769, "timestamp": "00:34:48", "text": "主な質問と"}, {"type": "subtitle", "time": 2089.978, "timestamp": "00:34:49", "text": "問題はこれです。"}, {"type": "subtitle", "time": 2093.627, "timestamp": "00:34:53", "text": "自分のアカウントを退出するにはどうすればいいですか？"}, {"type": "subtitle", "time": 2094.884, "timestamp": "00:34:54", "text": "学校で自転車に乗る、"}]
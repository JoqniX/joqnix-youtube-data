[{"type": "subtitle", "time": 300.309, "timestamp": "00:05:00", "text": "あなたが"}, {"type": "subtitle", "time": 301.733, "timestamp": "00:05:01", "text": "病気の時、特に"}, {"type": "subtitle", "time": 302.802, "timestamp": "00:05:02", "text": "これで終わりです"}, {"type": "subtitle", "time": 308.809, "timestamp": "00:05:08", "text": "日本でインフルエンザが流行しています。"}, {"type": "subtitle", "time": 311.023, "timestamp": "00:05:11", "text": "皆さん"}, {"type": "subtitle", "time": 312.364, "timestamp": "00:05:12", "text": "風邪をひいて、"}, {"type": "subtitle", "time": 315.66, "timestamp": "00:05:15", "text": "このような。だから正直に言うと"}, {"type": "subtitle", "time": 317.017, "timestamp": "00:05:17", "text": "これは現実だと言う"}, {"type": "subtitle", "time": 321.359, "timestamp": "00:05:21", "text": "痛み。ええ、以上です。"}, {"type": "subtitle", "time": 323.491, "timestamp": "00:05:23", "text": "起こっている。与える"}, {"type": "subtitle", "time": 326.195, "timestamp": "00:05:26", "text": "少し時間をください。私"}, {"type": "subtitle", "time": 326.89300000000003, "timestamp": "00:05:26", "text": "私はしようとしています"}, {"type": "subtitle", "time": 328.068, "timestamp": "00:05:28", "text": "独自のセットアップを行う"}, {"type": "subtitle", "time": 330.165, "timestamp": "00:05:30", "text": "もの。さあ、行くぞ。"}, {"type": "subtitle", "time": 334.753, "timestamp": "00:05:34", "text": "少し乗ってみる。私"}, {"type": "subtitle", "time": 335.927, "timestamp": "00:05:35", "text": "私はそこへ行くつもりだ。"}, {"type": "subtitle", "time": 337.133, "timestamp": "00:05:37", "text": "海の近く、おそらく"}, {"type": "subtitle", "time": 338.405, "timestamp": "00:05:38", "text": "話し合おう"}, {"type": "subtitle", "time": 339.611, "timestamp": "00:05:39", "text": "私たちはそこで時間を過ごす予定です。"}, {"type": "subtitle", "time": 340.85, "timestamp": "00:05:40", "text": "そこで時間を過ごしてみませんか？"}, {"type": "subtitle", "time": 347.368, "timestamp": "00:05:47", "text": "そんな感じ。えっと、そこです。ない"}, {"type": "subtitle", "time": 348.719, "timestamp": "00:05:48", "text": "自分が何をしたかは分かっている。"}, {"type": "subtitle", "time": 350.993, "timestamp": "00:05:50", "text": "覚えておいて、私は言った"}, {"type": "subtitle", "time": 352.572, "timestamp": "00:05:52", "text": "私のモバイルバッテリーが何なのか知ってる？"}, {"type": "subtitle", "time": 355.886, "timestamp": "00:05:55", "text": "壊れているか、全く壊れていない"}, {"type": "subtitle", "time": 357.15999999999997, "timestamp": "00:05:57", "text": "最後には動作しませんでした"}, {"type": "subtitle", "time": 358.748, "timestamp": "00:05:58", "text": "時々？だから、おそらく、"}, {"type": "subtitle", "time": 359.947, "timestamp": "00:05:59", "text": "彼は今働いています。"}]
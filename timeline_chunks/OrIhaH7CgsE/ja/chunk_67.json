[{"type": "subtitle", "time": 4037.432, "timestamp": "01:07:17", "text": "ご挨拶申し上げます。ごめん。わかった、"}, {"type": "subtitle", "time": 4039.003, "timestamp": "01:07:19", "text": "私は安全だと思う。"}, {"type": "subtitle", "time": 4048.172, "timestamp": "01:07:28", "text": "ゾーン。私はどこへ向かっているのですか？ここはどこ？"}, {"type": "subtitle", "time": 4051.711, "timestamp": "01:07:31", "text": "私は歩いているのか？知るか？えっと、"}, {"type": "subtitle", "time": 4053.304, "timestamp": "01:07:33", "text": "私が知っているのは"}, {"type": "subtitle", "time": 4055.027, "timestamp": "01:07:35", "text": "私は学校から遠く離れている。"}, {"type": "subtitle", "time": 4059.506, "timestamp": "01:07:39", "text": "私は去った"}, {"type": "subtitle", "time": 4060.526, "timestamp": "01:07:40", "text": "文字通り数個"}, {"type": "subtitle", "time": 4061.801, "timestamp": "01:07:41", "text": "私が"}, {"type": "subtitle", "time": 4066.704, "timestamp": "01:07:46", "text": "私は学校に行きます。私"}, {"type": "subtitle", "time": 4071.662, "timestamp": "01:07:51", "text": "時間を無駄にしている。だからそれらは、"}, {"type": "subtitle", "time": 4073.212, "timestamp": "01:07:53", "text": "チャットにまだいる人は誰ですか、"}, {"type": "subtitle", "time": 4075.894, "timestamp": "01:07:55", "text": "はい、おそらくそれでしょう"}, {"type": "subtitle", "time": 4076.928, "timestamp": "01:07:56", "text": "前回私たちが"}, {"type": "subtitle", "time": 4077.929, "timestamp": "01:07:57", "text": "私たちはそれをとても頻繁に行うことができます"}]
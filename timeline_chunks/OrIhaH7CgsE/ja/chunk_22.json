[{"type": "subtitle", "time": 1324.541, "timestamp": "00:22:04", "text": "三脚を使えば"}, {"type": "subtitle", "time": 1325.634, "timestamp": "00:22:05", "text": "入れることができません。"}, {"type": "subtitle", "time": 1326.908, "timestamp": "00:22:06", "text": "彼はこんな感じだ。私はできません"}, {"type": "subtitle", "time": 1328.043, "timestamp": "00:22:08", "text": "入れることができません。"}, {"type": "subtitle", "time": 1329.421, "timestamp": "00:22:09", "text": "彼のことだ。もちろん、彼は"}, {"type": "subtitle", "time": 1330.807, "timestamp": "00:22:10", "text": "倒れて転落するだろう。"}, {"type": "subtitle", "time": 1334.451, "timestamp": "00:22:14", "text": "だから、みんな、私にはわからないんだ。"}, {"type": "subtitle", "time": 1338.734, "timestamp": "00:22:18", "text": "ああ、それは高すぎる。"}, {"type": "subtitle", "time": 1350.283, "timestamp": "00:22:30", "text": "しかし、私がこれをすれば、"}, {"type": "subtitle", "time": 1351.496, "timestamp": "00:22:31", "text": "あなたはそれを見ないでしょう"}]
[{"type": "subtitle", "time": 558.879, "timestamp": "00:09:18", "text": "こんにちは。こんにちは。聞こえますか？"}, {"type": "subtitle", "time": 565.143, "timestamp": "00:09:25", "text": "私はここにいるのか？サインをください、"}, {"type": "subtitle", "time": 568.983, "timestamp": "00:09:28", "text": "私が放送中の場合。いいえ、"}, {"type": "subtitle", "time": 570.196, "timestamp": "00:09:30", "text": "寄付してください"}, {"type": "subtitle", "time": 571.485, "timestamp": "00:09:31", "text": "参加するならサインをください"}, {"type": "subtitle", "time": 572.91, "timestamp": "00:09:32", "text": "放送中。もしあなたが私だったら"}, {"type": "subtitle", "time": 582.093, "timestamp": "00:09:42", "text": "聞こえますよね。わかりました。ああ、君"}, {"type": "subtitle", "time": 587.096, "timestamp": "00:09:47", "text": "まだここにいるの？悪魔。"}, {"type": "subtitle", "time": 593.844, "timestamp": "00:09:53", "text": "悪魔。またか、兄弟。"}, {"type": "subtitle", "time": 595.069, "timestamp": "00:09:55", "text": "このモバイルバッテリーは ほんの少し"}, {"type": "subtitle", "time": 595.934, "timestamp": "00:09:55", "text": "ほんの少し 役に立たない。私に必要なものは何ですか？"}]
[{"type": "subtitle", "time": 4141.636, "timestamp": "01:09:01", "text": "下へ導く。これは何ですか？"}, {"type": "subtitle", "time": 4145.106, "timestamp": "01:09:05", "text": "ここは公園ではありません。なんてこった？ ？ここは公園なんかじゃない。"}, {"type": "subtitle", "time": 4150.423, "timestamp": "01:09:10", "text": "むしろ"}, {"type": "subtitle", "time": 4162.489, "timestamp": "01:09:22", "text": "トンネル。わかりました。私は思う"}, {"type": "subtitle", "time": 4167.037, "timestamp": "01:09:27", "text": "私はこう言うことができます。"}, {"type": "subtitle", "time": 4169.25, "timestamp": "01:09:29", "text": "どう思いますか？"}, {"type": "subtitle", "time": 4170.582, "timestamp": "01:09:30", "text": "私有地"}, {"type": "subtitle", "time": 4172.59, "timestamp": "01:09:32", "text": "そこには？見たい"}, {"type": "subtitle", "time": 4173.66, "timestamp": "01:09:33", "text": "その風景だが、"}, {"type": "subtitle", "time": 4175.051, "timestamp": "01:09:35", "text": "プライベートな情報のようですね。"}, {"type": "subtitle", "time": 4177.821, "timestamp": "01:09:37", "text": "財産。ああ、これ"}, {"type": "subtitle", "time": 4179.195, "timestamp": "01:09:39", "text": "私有地。"}, {"type": "subtitle", "time": 4192.741, "timestamp": "01:09:52", "text": "以上です。これはタイプです"}, {"type": "subtitle", "time": 4194.024, "timestamp": "01:09:54", "text": "この地域で一番高い塔"}, {"type": "subtitle", "time": 4197.432, "timestamp": "01:09:57", "text": "地区。最も高い塔。"}, {"type": "subtitle", "time": 4199.326, "timestamp": "01:09:59", "text": "そこからは全てが見渡せる。"}]
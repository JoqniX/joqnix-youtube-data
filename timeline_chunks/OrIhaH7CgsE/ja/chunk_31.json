[{"type": "subtitle", "time": 1865.945, "timestamp": "00:31:05", "text": "この男？わかった。"}, {"type": "subtitle", "time": 1869.276, "timestamp": "00:31:09", "text": "今は良くなりましたか？少し"}, {"type": "subtitle", "time": 1875.711, "timestamp": "00:31:15", "text": "より良いですが、私はできます、"}, {"type": "subtitle", "time": 1877.263, "timestamp": "00:31:17", "text": "感じるよ。"}, {"type": "subtitle", "time": 1879.961, "timestamp": "00:31:19", "text": "それは落ちて、落ちていくでしょう。"}, {"type": "subtitle", "time": 1886.316, "timestamp": "00:31:26", "text": "床に。でももし私が"}, {"type": "subtitle", "time": 1887.648, "timestamp": "00:31:27", "text": "十分に振ってみます。"}, {"type": "subtitle", "time": 1894.793, "timestamp": "00:31:34", "text": "何回も、振る"}, {"type": "subtitle", "time": 1896.555, "timestamp": "00:31:36", "text": "十分すぎるほどだ。それ"}, {"type": "subtitle", "time": 1897.573, "timestamp": "00:31:37", "text": "外に出て"}, {"type": "subtitle", "time": 1905.107, "timestamp": "00:31:45", "text": "秋ですよね？それでも。では"}, {"type": "subtitle", "time": 1910.282, "timestamp": "00:31:50", "text": "のために。 SHが終わったら確認します。"}, {"type": "subtitle", "time": 1913.6779999999999, "timestamp": "00:31:53", "text": "わかった。はい。できますか？"}, {"type": "subtitle", "time": 1914.894, "timestamp": "00:31:54", "text": "私のために確認してくれますか？"}, {"type": "subtitle", "time": 1916.609, "timestamp": "00:31:56", "text": "すべて順調です。だから私は"}, {"type": "subtitle", "time": 1918.98, "timestamp": "00:31:58", "text": "確認してみます。時刻は10時56分です。"}]
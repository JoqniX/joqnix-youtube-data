[{"type": "subtitle", "time": 5283.782, "timestamp": "01:28:03", "text": "読み込み中ですよね？"}, {"type": "subtitle", "time": 5284.647, "timestamp": "01:28:04", "text": "必要なもの"}, {"type": "subtitle", "time": 5285.912, "timestamp": "01:28:05", "text": "しばらく待って、"}, {"type": "subtitle", "time": 5286.444, "timestamp": "01:28:06", "text": "彼が"}, {"type": "subtitle", "time": 5289.467, "timestamp": "01:28:09", "text": "安定する。はい。"}, {"type": "subtitle", "time": 5294.958, "timestamp": "01:28:14", "text": "でも、私が"}, {"type": "subtitle", "time": 5296.32, "timestamp": "01:28:16", "text": "混乱するよね、私も。"}, {"type": "subtitle", "time": 5297.51, "timestamp": "01:28:17", "text": "自転車に乗った"}, {"type": "subtitle", "time": 5301.635, "timestamp": "01:28:21", "text": "この場所のせいだよね？そして"}, {"type": "subtitle", "time": 5303.618, "timestamp": "01:28:23", "text": "私はオーに行きました、"}, {"type": "subtitle", "time": 5305.175, "timestamp": "01:28:25", "text": "待って、待って、"}, {"type": "subtitle", "time": 5306.736, "timestamp": "01:28:26", "text": "待って。覚えているよ、"}, {"type": "subtitle", "time": 5308.101, "timestamp": "01:28:28", "text": "問題がありました"}, {"type": "subtitle", "time": 5309.251, "timestamp": "01:28:29", "text": "地域におけるコミュニケーション"}, {"type": "subtitle", "time": 5311.093, "timestamp": "01:28:31", "text": "私の学校。はい。はい。"}, {"type": "subtitle", "time": 5312.632, "timestamp": "01:28:32", "text": "はい。学区は"}, {"type": "subtitle", "time": 5314.947, "timestamp": "01:28:34", "text": "その地図に載っていた。彼"}, {"type": "subtitle", "time": 5316.312, "timestamp": "01:28:36", "text": "彼は切断した"}, {"type": "subtitle", "time": 5318.646, "timestamp": "01:28:38", "text": "インドネシア経由。そして、"}, {"type": "subtitle", "time": 5324.728, "timestamp": "01:28:44", "text": "でも私が降りてきたとき"}, {"type": "subtitle", "time": 5325.915, "timestamp": "01:28:45", "text": "川岸まで"}, {"type": "subtitle", "time": 5326.905, "timestamp": "01:28:46", "text": "橋、すべてが"}, {"type": "subtitle", "time": 5331.286, "timestamp": "01:28:51", "text": "良い。よし、今だ。"}, {"type": "subtitle", "time": 5332.646, "timestamp": "01:28:52", "text": "ネットワークが不安定です。"}, {"type": "subtitle", "time": 5337.897, "timestamp": "01:28:57", "text": "ミノ、行くの？"}, {"type": "subtitle", "time": 5338.959, "timestamp": "01:28:58", "text": "いくつか見るために"}]
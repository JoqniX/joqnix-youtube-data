[{"type": "subtitle", "time": 661.152, "timestamp": "00:11:01", "text": "それら全て。えっと、その前に"}, {"type": "subtitle", "time": 664.871, "timestamp": "00:11:04", "text": "私はすべてを持っている、ああ神よ、"}, {"type": "subtitle", "time": 666.247, "timestamp": "00:11:06", "text": "これをやらなければならない。"}, {"type": "subtitle", "time": 670.907, "timestamp": "00:11:10", "text": "今。悪魔。忘れていた"}, {"type": "subtitle", "time": 684.777, "timestamp": "00:11:24", "text": "それ。でも、忘れてしまった。"}, {"type": "subtitle", "time": 686.124, "timestamp": "00:11:26", "text": "ホルダーを置く"}, {"type": "subtitle", "time": 688.926, "timestamp": "00:11:28", "text": "手首。なぜなら私は"}, {"type": "subtitle", "time": 690.043, "timestamp": "00:11:30", "text": "ホルダーなし"}, {"type": "subtitle", "time": 692.4159999999999, "timestamp": "00:11:32", "text": "電話。それで"}, {"type": "subtitle", "time": 701.429, "timestamp": "00:11:41", "text": "今のところはそうするしかない"}, {"type": "subtitle", "time": 716.679, "timestamp": "00:11:56", "text": "これを容認する。良い、"}]
[{"type": "subtitle", "time": 4806.212, "timestamp": "01:20:06", "text": "ここは本当に美しい場所です。"}, {"type": "subtitle", "time": 4810.97, "timestamp": "01:20:10", "text": "でも、はい、あります"}, {"type": "subtitle", "time": 4812.026, "timestamp": "01:20:12", "text": "念のため言っておきますが、"}, {"type": "subtitle", "time": 4815.354, "timestamp": "01:20:15", "text": "私がこんな風になっているのを見て、"}, {"type": "subtitle", "time": 4816.332, "timestamp": "01:20:16", "text": "これは珍しい"}, {"type": "subtitle", "time": 4819.885, "timestamp": "01:20:19", "text": "めったに起こらない。"}, {"type": "subtitle", "time": 4823.478, "timestamp": "01:20:23", "text": "例えば、外出する"}, {"type": "subtitle", "time": 4824.762, "timestamp": "01:20:24", "text": "朝にそれをやりなさい。"}, {"type": "subtitle", "time": 4829.283, "timestamp": "01:20:29", "text": "はい。どちらか一方、またはどちらか一方を「はい」とします。"}, {"type": "subtitle", "time": 4833.853, "timestamp": "01:20:33", "text": "土曜日、日曜日、なぜなら"}, {"type": "subtitle", "time": 4834.814, "timestamp": "01:20:34", "text": "朝は"}, {"type": "subtitle", "time": 4836.152, "timestamp": "01:20:36", "text": "仕事、あるいは何よりも、"}, {"type": "subtitle", "time": 4837.489, "timestamp": "01:20:37", "text": "私ができることは"}, {"type": "subtitle", "time": 4838.69, "timestamp": "01:20:38", "text": "から戻った後"}, {"type": "subtitle", "time": 4839.582, "timestamp": "01:20:39", "text": "仕事、私はできる"}, {"type": "subtitle", "time": 4840.474, "timestamp": "01:20:40", "text": "私のように見る"}, {"type": "subtitle", "time": 4841.743, "timestamp": "01:20:41", "text": "私は家に帰ります"}, {"type": "subtitle", "time": 4842.875, "timestamp": "01:20:42", "text": "仕事、疲れた"}, {"type": "subtitle", "time": 4843.973, "timestamp": "01:20:43", "text": "去っていく男"}, {"type": "subtitle", "time": 4845.105, "timestamp": "01:20:45", "text": "自宅で同時に"}, {"type": "subtitle", "time": 4851.382, "timestamp": "01:20:51", "text": "配信します。はい。として"}, {"type": "subtitle", "time": 4853.132, "timestamp": "01:20:53", "text": "午前中に。ええ、そう思います。 、 私はそれを行うことができます。がある-"}, {"type": "subtitle", "time": 4858.846, "timestamp": "01:20:58", "text": "、 私はそれを行うことができます。がある- どこに置けばいいですか？"}]
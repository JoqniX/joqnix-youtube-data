[{"type": "subtitle", "time": 4080.615, "timestamp": "01:08:00", "text": "会う。その後"}, {"type": "subtitle", "time": 4081.226, "timestamp": "01:08:01", "text": "私は必要としている"}, {"type": "subtitle", "time": 4082.081, "timestamp": "01:08:02", "text": "戻る"}, {"type": "subtitle", "time": 4083.304, "timestamp": "01:08:03", "text": "学習と効率化。"}, {"type": "subtitle", "time": 4086.675, "timestamp": "01:08:06", "text": "はい。申し訳ありません"}, {"type": "subtitle", "time": 4087.847, "timestamp": "01:08:07", "text": "ネットワークの問題、"}, {"type": "subtitle", "time": 4090.3, "timestamp": "01:08:10", "text": "私たちが持っていたもの。待って、"}, {"type": "subtitle", "time": 4094.336, "timestamp": "01:08:14", "text": "これは公園か？これは一体何だ？"}, {"type": "subtitle", "time": 4095.825, "timestamp": "01:08:15", "text": "公園？私はただ"}, {"type": "subtitle", "time": 4098.368, "timestamp": "01:08:18", "text": "すべてを探求しよう。ここには"}, {"type": "subtitle", "time": 4100.206, "timestamp": "01:08:20", "text": "歩行者専用区域。それ"}, {"type": "subtitle", "time": 4102.667, "timestamp": "01:08:22", "text": "公園？今まで一度も"}, {"type": "subtitle", "time": 4103.977, "timestamp": "01:08:23", "text": "この部分には含まれていませんでした。"}, {"type": "chat", "time": 4106.007, "timestamp": "01:08:26", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "owo"}, {"type": "subtitle", "time": 4106.913, "timestamp": "01:08:26", "text": "私がここにいられることを願っています。"}, {"type": "subtitle", "time": 4116.299, "timestamp": "01:08:36", "text": "ご挨拶申し上げます。ああ、君か。私は持っているのは"}, {"type": "subtitle", "time": 4117.193, "timestamp": "01:08:37", "text": "いくつか無料"}, {"type": "subtitle", "time": 4118.37, "timestamp": "01:08:38", "text": "分。私はこれを携帯しています。"}, {"type": "subtitle", "time": 4122.475, "timestamp": "01:08:42", "text": "重いバッグ。必要"}, {"type": "subtitle", "time": 4126.068, "timestamp": "01:08:46", "text": "そこへ行く。ここはどこですか？"}, {"type": "subtitle", "time": 4131.54, "timestamp": "01:08:51", "text": "ここはどんな場所ですか？ああ、ここ"}, {"type": "subtitle", "time": 4137.874, "timestamp": "01:08:57", "text": "橋もあります。これはまだ"}]
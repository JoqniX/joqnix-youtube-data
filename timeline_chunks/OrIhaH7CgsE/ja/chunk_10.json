[{"type": "subtitle", "time": 605.42, "timestamp": "00:10:05", "text": "役に立たない。私に必要なものは何ですか？ する？パワーバンクは"}, {"type": "subtitle", "time": 608.559, "timestamp": "00:10:08", "text": "する？パワーバンクは 主な問題"}, {"type": "subtitle", "time": 609.615, "timestamp": "00:10:09", "text": "主な問題 今。何てことだ。公平"}, {"type": "subtitle", "time": 616.751, "timestamp": "00:10:16", "text": "今。何てことだ。公平 私はただ"}, {"type": "subtitle", "time": 618.053, "timestamp": "00:10:18", "text": "私はただ 買いに行きたい。"}, {"type": "subtitle", "time": 619.144, "timestamp": "00:10:19", "text": "買いに行きたい。 新しいよ、兄弟。これ、これ、"}, {"type": "subtitle", "time": 623.583, "timestamp": "00:10:23", "text": "新しいよ、兄弟。これ、これ、 これは本当にまずい。"}, {"type": "subtitle", "time": 627.892, "timestamp": "00:10:27", "text": "信じてください、すべてはとても"}, {"type": "subtitle", "time": 648.429, "timestamp": "00:10:48", "text": "ひどく。良い。したがって、"}, {"type": "subtitle", "time": 649.604, "timestamp": "00:10:49", "text": "今日は"}, {"type": "subtitle", "time": 650.645, "timestamp": "00:10:50", "text": "ちょっと散歩しましょう。"}, {"type": "subtitle", "time": 653.144, "timestamp": "00:10:53", "text": "すべてを探求してみましょう。欲しい"}, {"type": "subtitle", "time": 657.114, "timestamp": "00:10:57", "text": "朝をお見せします"}]
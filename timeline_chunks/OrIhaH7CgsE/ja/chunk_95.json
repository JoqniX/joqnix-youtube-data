[{"type": "subtitle", "time": 5705.324, "timestamp": "01:35:05", "text": "それでは、皆様に感謝いたします。"}, {"type": "subtitle", "time": 5706.544, "timestamp": "01:35:06", "text": "今日来た。"}, {"type": "subtitle", "time": 5707.957, "timestamp": "01:35:07", "text": "誰かを不快にさせていないことを願っています。"}, {"type": "subtitle", "time": 5709.827, "timestamp": "01:35:09", "text": "誰も見逃さなかった"}, {"type": "subtitle", "time": 5715.441, "timestamp": "01:35:15", "text": "入ってきた。でも、そう、だから これで終わりにします。"}, {"type": "subtitle", "time": 5716.74, "timestamp": "01:35:16", "text": "これで終わりにします。 私の時間では12時15分です。"}, {"type": "subtitle", "time": 5719.787, "timestamp": "01:35:19", "text": "私の時間では12時15分です。 仕上げる。だから私は"}, {"type": "subtitle", "time": 5721.616, "timestamp": "01:35:21", "text": "仕上げる。だから私は 今、終わらせます。"}, {"type": "subtitle", "time": 5723.202, "timestamp": "01:35:23", "text": "今、終わらせます。 わかった。そう、そして"}, {"type": "subtitle", "time": 5726.0, "timestamp": "01:35:26", "text": "わかった。そう、そして さあ、みんな。"}]
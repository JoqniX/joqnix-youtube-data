[{"type": "subtitle", "time": 3900.225, "timestamp": "01:05:00", "text": "はい、インターネットは正常に動作しています …私には無理です"}, {"type": "subtitle", "time": 3901.441, "timestamp": "01:05:01", "text": "…私には無理です 友達に電話するのは"}, {"type": "subtitle", "time": 3902.84, "timestamp": "01:05:02", "text": "友達に電話するのは 30、20、または10"}, {"type": "subtitle", "time": 3904.129, "timestamp": "01:05:04", "text": "30、20、または10 私が"}, {"type": "subtitle", "time": 3905.087, "timestamp": "01:05:05", "text": "私が そこから離れた"}, {"type": "subtitle", "time": 3906.302, "timestamp": "01:05:06", "text": "そこから離れた 場所、そしてそれは"}, {"type": "subtitle", "time": 3907.186, "timestamp": "01:05:07", "text": "場所、そしてそれは うまくいった。わからない。"}, {"type": "subtitle", "time": 3914.28, "timestamp": "01:05:14", "text": "うまくいった。わからない。 何が問題なのか、でもそうだ、"}, {"type": "subtitle", "time": 3915.954, "timestamp": "01:05:15", "text": "何が問題なのか、でもそうだ、 あるものは、あるもの。私たちは"}, {"type": "subtitle", "time": 3918.644, "timestamp": "01:05:18", "text": "あるものは、あるもの。私たちは 我々は持っています。でもそうですね、"}, {"type": "subtitle", "time": 3926.615, "timestamp": "01:05:26", "text": "私は持っていると思います"}, {"type": "subtitle", "time": 3927.771, "timestamp": "01:05:27", "text": "残っているのは"}, {"type": "subtitle", "time": 3931.732, "timestamp": "01:05:31", "text": "数分。私は持っている"}, {"type": "subtitle", "time": 3932.853, "timestamp": "01:05:32", "text": "残っているのは"}, {"type": "subtitle", "time": 3933.875, "timestamp": "01:05:33", "text": "数分前"}, {"type": "subtitle", "time": 3935.193, "timestamp": "01:05:35", "text": "ちなみに、ストリームの終わりです。"}, {"type": "subtitle", "time": 3940.624, "timestamp": "01:05:40", "text": "人々。ええと、はい、以上です。"}, {"type": "subtitle", "time": 3954.957, "timestamp": "01:05:54", "text": "ひどく。うん、そっちの方がいい。"}]
[{"type": "subtitle", "time": 1205.826, "timestamp": "00:20:05", "text": "細長い。エディオ。で"}, {"type": "subtitle", "time": 1217.139, "timestamp": "00:20:17", "text": "何てことだ。そちらの方が良いでしょう。 ？本当に欲しい"}, {"type": "subtitle", "time": 1222.9, "timestamp": "00:20:22", "text": "音を使う"}, {"type": "subtitle", "time": 1224.171, "timestamp": "00:20:24", "text": "電話ですが、私は"}, {"type": "subtitle", "time": 1225.544, "timestamp": "00:20:25", "text": "景色をお見せします、"}, {"type": "subtitle", "time": 1230.586, "timestamp": "00:20:30", "text": "でも、私はどうすればいいの？"}, {"type": "subtitle", "time": 1233.347, "timestamp": "00:20:33", "text": "またはインストール"}, {"type": "subtitle", "time": 1237.188, "timestamp": "00:20:37", "text": "三脚。または"}, {"type": "subtitle", "time": 1238.405, "timestamp": "00:20:38", "text": "三脚を設置する"}, {"type": "subtitle", "time": 1239.83, "timestamp": "00:20:39", "text": "でも、私は"}, {"type": "subtitle", "time": 1240.905, "timestamp": "00:20:40", "text": "インストールできます"}, {"type": "subtitle", "time": 1245.999, "timestamp": "00:20:45", "text": "三脚、バッグ"}, {"type": "subtitle", "time": 1251.285, "timestamp": "00:20:51", "text": "干渉する。その通り。では、どうすればいいのでしょうか？"}, {"type": "subtitle", "time": 1252.225, "timestamp": "00:20:52", "text": "私を置く"}, {"type": "subtitle", "time": 1259.733, "timestamp": "00:20:59", "text": "三脚？私はしません。"}]
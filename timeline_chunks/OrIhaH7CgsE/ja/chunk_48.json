[{"type": "subtitle", "time": 2881.535, "timestamp": "00:48:01", "text": "学校に行く。では"}, {"type": "subtitle", "time": 2883.013, "timestamp": "00:48:03", "text": "先生が見ればわかるように、"}, {"type": "subtitle", "time": 2885.768, "timestamp": "00:48:05", "text": "私の携帯電話には何が入っているの？"}, {"type": "subtitle", "time": 2887.679, "timestamp": "00:48:07", "text": "はい、行きます"}, {"type": "subtitle", "time": 2893.323, "timestamp": "00:48:13", "text": "自転車。私は今"}, {"type": "subtitle", "time": 2894.376, "timestamp": "00:48:14", "text": "私はゆっくり運転します、"}, {"type": "subtitle", "time": 2895.745, "timestamp": "00:48:15", "text": "カタツムリなので、カメラが"}, {"type": "subtitle", "time": 2897.009, "timestamp": "00:48:17", "text": "震えすぎで"}, {"type": "subtitle", "time": 2898.414, "timestamp": "00:48:18", "text": "三脚から落ちた"}, {"type": "subtitle", "time": 2904.707, "timestamp": "00:48:24", "text": "私のバスケット。はい、"}, {"type": "subtitle", "time": 2918.291, "timestamp": "00:48:38", "text": "ここに建設があり、私は"}, {"type": "subtitle", "time": 2919.351, "timestamp": "00:48:39", "text": "戻りたかった"}, {"type": "subtitle", "time": 2920.658, "timestamp": "00:48:40", "text": "左に行ったが、何もなかった。"}, {"type": "subtitle", "time": 2922.931, "timestamp": "00:48:42", "text": "ここで左折します。"}, {"type": "subtitle", "time": 2930.839, "timestamp": "00:48:50", "text": "ええ、そう願っています。"}, {"type": "subtitle", "time": 2932.485, "timestamp": "00:48:52", "text": "自転車駐輪場、なぜなら"}, {"type": "subtitle", "time": 2939.209, "timestamp": "00:48:59", "text": "これは自転車が通る小川です。私は全てだ"}]
[{"type": "subtitle", "time": 1264.025, "timestamp": "00:21:04", "text": "変更する必要はない。えっと、"}, {"type": "subtitle", "time": 1274.358, "timestamp": "00:21:14", "text": "良い。はい、それは"}, {"type": "subtitle", "time": 1275.395, "timestamp": "00:21:15", "text": "川または下水道"}, {"type": "subtitle", "time": 1276.79, "timestamp": "00:21:16", "text": "溝、あるいは何であれ。"}, {"type": "subtitle", "time": 1288.208, "timestamp": "00:21:28", "text": "何…いい考えがある。がある、"}, {"type": "subtitle", "time": 1289.445, "timestamp": "00:21:29", "text": "くれれば受け取るよ。"}, {"type": "subtitle", "time": 1304.091, "timestamp": "00:21:44", "text": "三脚。私は必要としている"}, {"type": "subtitle", "time": 1314.237, "timestamp": "00:21:54", "text": "ここから出て行け。わかった、"}, {"type": "subtitle", "time": 1318.326, "timestamp": "00:21:58", "text": "三脚があります。質問"}, {"type": "subtitle", "time": 1319.525, "timestamp": "00:21:59", "text": "どう言えばいいか"}]
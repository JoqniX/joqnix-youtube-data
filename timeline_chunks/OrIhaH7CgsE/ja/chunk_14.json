[{"type": "subtitle", "time": 846.95, "timestamp": "00:14:06", "text": "チャット。ねえ、もしかしたら誰かが"}, {"type": "subtitle", "time": 848.692, "timestamp": "00:14:08", "text": "チャットに何か書いてください。私"}, {"type": "subtitle", "time": 849.773, "timestamp": "00:14:09", "text": "確認したい。"}, {"type": "subtitle", "time": 851.92, "timestamp": "00:14:11", "text": "テキストの音声ナレーション。欲しい"}, {"type": "subtitle", "time": 853.32, "timestamp": "00:14:13", "text": "効果があると聞いています"}, {"type": "subtitle", "time": 874.276, "timestamp": "00:14:34", "text": "か否か。何てことだ。良い。"}, {"type": "chat", "time": 876.793, "timestamp": "00:14:36", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "what we doing"}, {"type": "subtitle", "time": 884.069, "timestamp": "00:14:44", "text": "これは狂気だ。私は何者？"}, {"type": "subtitle", "time": 890.402, "timestamp": "00:14:50", "text": "私は何をしているのだろうか？鍵を忘れないでください。"}, {"type": "subtitle", "time": 891.948, "timestamp": "00:14:51", "text": "その数字から。彼は私のものだ。"}, {"type": "subtitle", "time": 895.103, "timestamp": "00:14:55", "text": "必要だ。そして充電中。"}, {"type": "subtitle", "time": 897.239, "timestamp": "00:14:57", "text": "あなたには"}]
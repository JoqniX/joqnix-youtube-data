[{"type": "subtitle", "time": 961.85, "timestamp": "00:16:01", "text": "もの。ああ、おはよう。私はほとんど あの車は恋しくなかった"}, {"type": "subtitle", "time": 963.162, "timestamp": "00:16:03", "text": "あの車は恋しくなかった 。ああ、しまった。何てことだ。"}, {"type": "subtitle", "time": 969.819, "timestamp": "00:16:09", "text": "これはまずい。これが私のやり方です"}, {"type": "subtitle", "time": 971.26, "timestamp": "00:16:11", "text": "そういう持ち方をしてもいいですか？"}, {"type": "subtitle", "time": 976.595, "timestamp": "00:16:16", "text": "これは難しい。だから私たちは"}, {"type": "subtitle", "time": 977.861, "timestamp": "00:16:17", "text": "しばらくここに座っていましょう。"}, {"type": "subtitle", "time": 978.917, "timestamp": "00:16:18", "text": "それから私たちは"}, {"type": "subtitle", "time": 979.809, "timestamp": "00:16:19", "text": "自転車で"}, {"type": "subtitle", "time": 980.893, "timestamp": "00:16:20", "text": "私の学区。"}, {"type": "subtitle", "time": 982.141, "timestamp": "00:16:22", "text": "でも、それから私は計画を立てる"}, {"type": "subtitle", "time": 983.612, "timestamp": "00:16:23", "text": "海へ行こう。いいえ、"}, {"type": "subtitle", "time": 984.814, "timestamp": "00:16:24", "text": "海ではなく、"}, {"type": "subtitle", "time": 985.941, "timestamp": "00:16:25", "text": "その土手"}, {"type": "subtitle", "time": 988.287, "timestamp": "00:16:28", "text": "河川。そしてそこから私たちは"}, {"type": "subtitle", "time": 989.511, "timestamp": "00:16:29", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 991.114, "timestamp": "00:16:31", "text": "リラックスしようと思う。"}, {"type": "subtitle", "time": 995.019, "timestamp": "00:16:35", "text": "お前。これは私が"}, {"type": "subtitle", "time": 998.67, "timestamp": "00:16:38", "text": "見ていますよ。何てことだ。しそうにない"}, {"type": "subtitle", "time": 1000.388, "timestamp": "00:16:40", "text": "落ちなかった。くそ。で"}, {"type": "subtitle", "time": 1001.907, "timestamp": "00:16:41", "text": "何てことだ。ほとんど"}, {"type": "subtitle", "time": 1010.641, "timestamp": "00:16:50", "text": "墜落しました。それはとても"}, {"type": "subtitle", "time": 1012.252, "timestamp": "00:16:52", "text": "暑いです。はい、これは私のものです。"}, {"type": "subtitle", "time": 1013.762, "timestamp": "00:16:53", "text": "バッグ。これは古い情報です。"}, {"type": "subtitle", "time": 1014.92, "timestamp": "00:16:54", "text": "パワーバンクが"}, {"type": "subtitle", "time": 1017.832, "timestamp": "00:16:57", "text": "うまくいった。奇妙だが、"}, {"type": "subtitle", "time": 1019.215, "timestamp": "00:16:59", "text": "ディスプレイが突然起動した"}]
[{"type": "subtitle", "time": 1023.061, "timestamp": "00:17:03", "text": "輝く。でも私はそうは思わない"}, {"type": "subtitle", "time": 1024.284, "timestamp": "00:17:04", "text": "そのままにしておいてもいいですか？"}, {"type": "subtitle", "time": 1027.056, "timestamp": "00:17:07", "text": "手。ここは、えーと、"}, {"type": "subtitle", "time": 1028.516, "timestamp": "00:17:08", "text": "わかってるよ、わかるだろ？"}, {"type": "subtitle", "time": 1030.062, "timestamp": "00:17:10", "text": "そのUSBコネクタは大きい"}, {"type": "subtitle", "time": 1033.592, "timestamp": "00:17:13", "text": "動作していません。はい、そうです。"}, {"type": "subtitle", "time": 1037.723, "timestamp": "00:17:17", "text": "今のところは何とかできる。"}, {"type": "subtitle", "time": 1040.195, "timestamp": "00:17:20", "text": "これで何とかやっていこう。しかし"}, {"type": "subtitle", "time": 1041.059, "timestamp": "00:17:21", "text": "彼が"}, {"type": "subtitle", "time": 1042.322, "timestamp": "00:17:22", "text": "絶対に価値があった。"}, {"type": "subtitle", "time": 1044.621, "timestamp": "00:17:24", "text": "はい、これは本当です。"}, {"type": "subtitle", "time": 1046.207, "timestamp": "00:17:26", "text": "苦労したよ。私は持っている"}, {"type": "subtitle", "time": 1049.556, "timestamp": "00:17:29", "text": "つまり、ストリーミングは―― これは、正直言って、"}, {"type": "subtitle", "time": 1051.094, "timestamp": "00:17:31", "text": "これは、正直言って、 小麦粉、もし知らないなら、"}, {"type": "subtitle", "time": 1052.477, "timestamp": "00:17:32", "text": "小麦粉、もし知らないなら、 何してるの？どうすればいいですか？"}, {"type": "subtitle", "time": 1055.797, "timestamp": "00:17:35", "text": "何してるの？どうすればいいですか？ 隠れる？何をするか..."}, {"type": "subtitle", "time": 1061.505, "timestamp": "00:17:41", "text": "隠れる？何をするか... 必要ない。"}, {"type": "subtitle", "time": 1068.4, "timestamp": "00:17:48", "text": "出て行け。あなたはまだ"}, {"type": "subtitle", "time": 1071.809, "timestamp": "00:17:51", "text": "お分かりですか？ああ、これ、ああ、これ"}, {"type": "subtitle", "time": 1074.218, "timestamp": "00:17:54", "text": "それは本当に厄介だ。わからない。"}]
[{"type": "subtitle", "time": 2102.444, "timestamp": "00:35:02", "text": "私はそうではないことを十分に承知している"}, {"type": "subtitle", "time": 2109.221, "timestamp": "00:35:09", "text": "ええと、ええと、いいえ"}, {"type": "subtitle", "time": 2110.194, "timestamp": "00:35:10", "text": "わかってる、できないんだ。"}, {"type": "subtitle", "time": 2111.529, "timestamp": "00:35:11", "text": "バッグをどこかに置く"}, {"type": "subtitle", "time": 2113.283, "timestamp": "00:35:13", "text": "一般的に？私は取らなければならない"}, {"type": "subtitle", "time": 2115.754, "timestamp": "00:35:15", "text": "彼女とあなた。だから私はとても"}, {"type": "subtitle", "time": 2117.102, "timestamp": "00:35:17", "text": "混乱してる、これは一体どういうこと？"}, {"type": "subtitle", "time": 2126.661, "timestamp": "00:35:26", "text": "する。はい、そうです。ああ、私は"}, {"type": "subtitle", "time": 2127.846, "timestamp": "00:35:27", "text": "またやらなきゃ"}, {"type": "chat", "time": 2129.524, "timestamp": "00:35:29", "author": "@kuraikumo2835", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m5zntNr6XcZSzuFvqyw4fg0PTX5BcCNzaU_2c1lq4vWA=s64-c-k-c0x00ffffff-no-rj", "message": "yuhu"}, {"type": "subtitle", "time": 2129.979, "timestamp": "00:35:29", "text": "この場所の。そう思います。"}, {"type": "subtitle", "time": 2134.717, "timestamp": "00:35:34", "text": "その女性は去った。それは良い。"}, {"type": "subtitle", "time": 2137.861, "timestamp": "00:35:37", "text": "ちょっと見てみます。"}, {"type": "subtitle", "time": 2143.08, "timestamp": "00:35:43", "text": "ちょっとしたパルクール。急勾配です。"}, {"type": "subtitle", "time": 2150.023, "timestamp": "00:35:50", "text": "こんにちは、クル。元気ですか？私たちは"}, {"type": "subtitle", "time": 2158.404, "timestamp": "00:35:58", "text": "お久しぶりです。それ"}]
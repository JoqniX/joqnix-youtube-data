[{"type": "subtitle", "time": 4624.013, "timestamp": "01:17:04", "text": "そんな雰囲気。だから私は"}, {"type": "subtitle", "time": 4625.084, "timestamp": "01:17:05", "text": "私はこれを徹底的に調べます。"}, {"type": "subtitle", "time": 4632.948, "timestamp": "01:17:12", "text": "領土となり、"}, {"type": "subtitle", "time": 4639.164, "timestamp": "01:17:19", "text": "学校は12時10分頃にそこにあります"}, {"type": "subtitle", "time": 4645.721, "timestamp": "01:17:25", "text": "または12時15分。わかった。しかしこれは"}, {"type": "subtitle", "time": 4646.879, "timestamp": "01:17:26", "text": "つまり、"}, {"type": "subtitle", "time": 4648.373, "timestamp": "01:17:28", "text": "私たちは戻ってきます、"}, {"type": "subtitle", "time": 4651.877, "timestamp": "01:17:31", "text": "配信を停止します。良い。"}, {"type": "subtitle", "time": 4655.71, "timestamp": "01:17:35", "text": "私がストリーミング配信を始めたのはいつですか？"}, {"type": "subtitle", "time": 4660.549, "timestamp": "01:17:40", "text": "10時15分頃ですよね？ 10:15"}, {"type": "subtitle", "time": 4664.267, "timestamp": "01:17:44", "text": "10時15分頃だったかな。"}, {"type": "subtitle", "time": 4667.696, "timestamp": "01:17:47", "text": "はい。 10時17分10時20分。できる"}, {"type": "subtitle", "time": 4670.016, "timestamp": "01:17:50", "text": "10時20分から11時まで。"}, {"type": "subtitle", "time": 4674.706, "timestamp": "01:17:54", "text": "11～12歳。ああ、そうだ。 12時15分。はい。"}, {"type": "subtitle", "time": 4678.862, "timestamp": "01:17:58", "text": "おそらく2時間くらいでしょう。 N."}]
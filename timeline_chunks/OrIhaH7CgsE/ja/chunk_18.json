[{"type": "subtitle", "time": 1085.504, "timestamp": "00:18:05", "text": "何…私は…ただ"}, {"type": "subtitle", "time": 1086.78, "timestamp": "00:18:06", "text": "私は違うやり方をします"}, {"type": "subtitle", "time": 1087.926, "timestamp": "00:18:07", "text": "あなたはそれを見ていない。"}, {"type": "subtitle", "time": 1107.356, "timestamp": "00:18:27", "text": "良い。私たちは何をしているのでしょうか？"}, {"type": "subtitle", "time": 1108.358, "timestamp": "00:18:28", "text": "待って、なぜ？"}, {"type": "subtitle", "time": 1109.636, "timestamp": "00:18:29", "text": "YouTubeの通知は"}, {"type": "subtitle", "time": 1111.028, "timestamp": "00:18:31", "text": "TTSで表示されますか？"}, {"type": "subtitle", "time": 1113.448, "timestamp": "00:18:33", "text": "何？え、知らなかった。"}, {"type": "subtitle", "time": 1114.956, "timestamp": "00:18:34", "text": "YouTubeの通知"}, {"type": "subtitle", "time": 1116.213, "timestamp": "00:18:36", "text": "TTSに含めるべきではない？"}, {"type": "subtitle", "time": 1119.732, "timestamp": "00:18:39", "text": "なぜだめですか？それは何ですか？で、"}, {"type": "subtitle", "time": 1121.131, "timestamp": "00:18:41", "text": "だからあなたはそう言ったんですね。"}, {"type": "subtitle", "time": 1123.067, "timestamp": "00:18:43", "text": "全然聞こえなかったよ。"}, {"type": "subtitle", "time": 1126.027, "timestamp": "00:18:46", "text": "おお。何てことだ。危うく転びそうになった。"}, {"type": "subtitle", "time": 1129.341, "timestamp": "00:18:49", "text": "自転車から。わかりました。"}, {"type": "subtitle", "time": 1130.802, "timestamp": "00:18:50", "text": "今は良くなりましたか？すでに"}, {"type": "subtitle", "time": 1132.529, "timestamp": "00:18:52", "text": "より良い。良い。わかりました。"}, {"type": "subtitle", "time": 1135.705, "timestamp": "00:18:55", "text": "私たちは何をしているのでしょうか？単に"}, {"type": "subtitle", "time": 1136.828, "timestamp": "00:18:56", "text": "おそらく手を振っているのだろう。"}]
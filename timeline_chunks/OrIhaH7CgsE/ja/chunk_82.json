[{"type": "subtitle", "time": 4924.712, "timestamp": "01:22:04", "text": "一日中音楽を聴いていた この時。あなたも"}, {"type": "subtitle", "time": 4929.077, "timestamp": "01:22:09", "text": "この時。あなたも 何か追加する必要がある、"}, {"type": "subtitle", "time": 4930.294, "timestamp": "01:22:10", "text": "何か追加する必要がある、 波紋を起こす"}, {"type": "subtitle", "time": 4931.41, "timestamp": "01:22:11", "text": "波紋を起こす より小さい。たとえそうであっても"}, {"type": "subtitle", "time": 4933.317, "timestamp": "01:22:13", "text": "より小さい。たとえそうであっても 威厳をもって。ええと、わかりました。"}, {"type": "subtitle", "time": 4962.422, "timestamp": "01:22:42", "text": "威厳をもって。ええと、わかりました。 これでうまくいくはずだ。うんうん"}, {"type": "subtitle", "time": 4972.74, "timestamp": "01:22:52", "text": "これでうまくいくはずだ。うんうん 、 わかった。そこでやろう"}, {"type": "subtitle", "time": 4976.224, "timestamp": "01:22:56", "text": "、 わかった。そこでやろう 小さなもの、おそらく"}, {"type": "subtitle", "time": 4977.505, "timestamp": "01:22:57", "text": "小さなもの、おそらく 。わかりました。今、すべて"}]
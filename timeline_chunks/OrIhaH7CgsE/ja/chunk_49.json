[{"type": "subtitle", "time": 2940.666, "timestamp": "00:49:00", "text": "私は今でもそれをやりたい。"}, {"type": "subtitle", "time": 2943.81, "timestamp": "00:49:03", "text": "カメラはどうですか？私は持っている"}, {"type": "subtitle", "time": 2945.079, "timestamp": "00:49:05", "text": "アクションカメラはなし。"}, {"type": "subtitle", "time": 2947.999, "timestamp": "00:49:07", "text": "古いものしか持っていません。"}, {"type": "subtitle", "time": 2949.596, "timestamp": "00:49:09", "text": "サムスンのスマホ、それだけです。"}, {"type": "subtitle", "time": 2955.141, "timestamp": "00:49:15", "text": "そしてこの電話"}, {"type": "subtitle", "time": 2956.485, "timestamp": "00:49:16", "text": "超高速が必要"}, {"type": "subtitle", "time": 2957.729, "timestamp": "00:49:17", "text": "サムスン充電、そうでなければ"}, {"type": "subtitle", "time": 2958.938, "timestamp": "00:49:18", "text": "彼はどこか奇妙な場所から来た"}, {"type": "subtitle", "time": 2959.913, "timestamp": "00:49:19", "text": "理由を求めていない"}, {"type": "subtitle", "time": 2963.544, "timestamp": "00:49:23", "text": "仕事。これは"}, {"type": "subtitle", "time": 2969.665, "timestamp": "00:49:29", "text": "本当に痛い。そして、"}, {"type": "subtitle", "time": 2970.702, "timestamp": "00:49:30", "text": "私はこれしか持っていません。"}, {"type": "subtitle", "time": 2974.455, "timestamp": "00:49:34", "text": "電話。私は持っています。"}, {"type": "subtitle", "time": 2975.768, "timestamp": "00:49:35", "text": "自転車のこと、"}, {"type": "subtitle", "time": 2976.983, "timestamp": "00:49:36", "text": "しかし問題は、"}, {"type": "subtitle", "time": 2977.869, "timestamp": "00:49:37", "text": "彼もまた"}, {"type": "subtitle", "time": 2979.018, "timestamp": "00:49:39", "text": "揺れてるよね？"}, {"type": "subtitle", "time": 2981.426, "timestamp": "00:49:41", "text": "彼はただ震えているだけだ。"}, {"type": "subtitle", "time": 2988.209, "timestamp": "00:49:48", "text": "とても。平"}, {"type": "subtitle", "time": 2989.1, "timestamp": "00:49:49", "text": "私は今、持ちこたえています。"}, {"type": "subtitle", "time": 2990.19, "timestamp": "00:49:50", "text": "電話を手に持ち、"}, {"type": "subtitle", "time": 2991.478, "timestamp": "00:49:51", "text": "誤って削除してしまう可能性があります"}, {"type": "subtitle", "time": 2992.7, "timestamp": "00:49:52", "text": "あなた自身、なぜならカメラは"}, {"type": "subtitle", "time": 2995.727, "timestamp": "00:49:55", "text": "スイッチ。もし"}, {"type": "subtitle", "time": 2996.219, "timestamp": "00:49:56", "text": "電話"}, {"type": "subtitle", "time": 2997.301, "timestamp": "00:49:57", "text": "ひっくり返します、"}, {"type": "subtitle", "time": 2998.614, "timestamp": "00:49:58", "text": "あなたは私の顔を見ることになるでしょう。"}]
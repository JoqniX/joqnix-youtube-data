[{"type": "subtitle", "time": 1385.161, "timestamp": "00:23:05", "text": "先に。ああ、わかりました。で"}, {"type": "subtitle", "time": 1400.951, "timestamp": "00:23:20", "text": "いい考えがある。ああ、私は私だ"}, {"type": "subtitle", "time": 1402.417, "timestamp": "00:23:22", "text": "間違ったことをした。で"}, {"type": "subtitle", "time": 1413.68, "timestamp": "00:23:33", "text": "何てことだ。待って、ここ"}, {"type": "subtitle", "time": 1419.107, "timestamp": "00:23:39", "text": "ここ。戻らなければならない。"}, {"type": "subtitle", "time": 1430.962, "timestamp": "00:23:50", "text": "ここです。聞いて、"}, {"type": "subtitle", "time": 1434.759, "timestamp": "00:23:54", "text": "まだ配信中？もしあなたが"}, {"type": "subtitle", "time": 1436.298, "timestamp": "00:23:56", "text": "はい、教えてください。"}, {"type": "subtitle", "time": 1437.878, "timestamp": "00:23:57", "text": "もし私の声が聞こえて、"}]
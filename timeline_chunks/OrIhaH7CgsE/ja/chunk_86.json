[{"type": "subtitle", "time": 5163.781, "timestamp": "01:26:03", "text": "ああ、もう12時だ。"}, {"type": "subtitle", "time": 5167.86, "timestamp": "01:26:07", "text": "今ではほぼ同じ"}, {"type": "subtitle", "time": 5168.909, "timestamp": "01:26:08", "text": "毎日"}, {"type": "subtitle", "time": 5169.79, "timestamp": "01:26:09", "text": "私は自分の分を仕上げているところです。"}, {"type": "subtitle", "time": 5170.772, "timestamp": "01:26:10", "text": "朝の仕事、"}, {"type": "subtitle", "time": 5178.523, "timestamp": "01:26:18", "text": "パートタイムの仕事。そして、私は去ります。"}, {"type": "subtitle", "time": 5182.153, "timestamp": "01:26:22", "text": "要点を簡潔に"}, {"type": "subtitle", "time": 5183.277, "timestamp": "01:26:23", "text": "名前を挙げると？私は去ります。"}, {"type": "subtitle", "time": 5186.802, "timestamp": "01:26:26", "text": "彼らに向かってまっすぐ、"}, {"type": "subtitle", "time": 5188.586, "timestamp": "01:26:28", "text": "それは何と呼ばれていますか？学校 。 12時15分にはそこに着きます。"}, {"type": "subtitle", "time": 5194.606, "timestamp": "01:26:34", "text": "。 12時15分にはそこに着きます。 ペダル"}, {"type": "subtitle", "time": 5195.833, "timestamp": "01:26:35", "text": "ペダル その橋を渡って"}, {"type": "subtitle", "time": 5196.893, "timestamp": "01:26:36", "text": "その橋を渡って できるだけ早く学校へ。"}, {"type": "subtitle", "time": 5207.796, "timestamp": "01:26:47", "text": "だから私はまだ理解していない、"}, {"type": "subtitle", "time": 5209.225, "timestamp": "01:26:49", "text": "なぜそんなに大きなものが必要なのですか？"}, {"type": "subtitle", "time": 5210.404, "timestamp": "01:26:50", "text": "建物。できた"}, {"type": "subtitle", "time": 5211.268, "timestamp": "01:26:51", "text": "塔を建てる"}, {"type": "subtitle", "time": 5212.102, "timestamp": "01:26:52", "text": "携帯電話"}, {"type": "subtitle", "time": 5213.275, "timestamp": "01:26:53", "text": "コミュニケーションとか、そんな感じのこと。"}, {"type": "subtitle", "time": 5215.614, "timestamp": "01:26:55", "text": "いいえ、信号はあります。ここ"}, {"type": "subtitle", "time": 5217.208, "timestamp": "01:26:57", "text": "何故ですか？理解できない。"}, {"type": "subtitle", "time": 5219.68, "timestamp": "01:26:59", "text": "インジケータ"}]
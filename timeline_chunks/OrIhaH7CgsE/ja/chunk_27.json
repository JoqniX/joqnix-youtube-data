[{"type": "subtitle", "time": 1622.204, "timestamp": "00:27:02", "text": "彼を中に入れた。ない限り"}, {"type": "subtitle", "time": 1625.167, "timestamp": "00:27:05", "text": "素晴らしいと思いませんか？しかしこれは"}, {"type": "subtitle", "time": 1626.427, "timestamp": "00:27:06", "text": "困難が生じるだろう。"}, {"type": "subtitle", "time": 1631.086, "timestamp": "00:27:11", "text": "もちろんできますよ。"}, {"type": "subtitle", "time": 1632.322, "timestamp": "00:27:12", "text": "チャットも何もかも失う"}, {"type": "subtitle", "time": 1633.449, "timestamp": "00:27:13", "text": "そんな感じだけど、まるで"}, {"type": "subtitle", "time": 1641.198, "timestamp": "00:27:21", "text": "近い。悪魔。私自身"}, {"type": "subtitle", "time": 1643.746, "timestamp": "00:27:23", "text": "匿名解除されましたか？悪魔。"}, {"type": "subtitle", "time": 1644.834, "timestamp": "00:27:24", "text": "私はそう思う"}, {"type": "subtitle", "time": 1645.857, "timestamp": "00:27:25", "text": "匿名化が解除されました。"}, {"type": "subtitle", "time": 1646.949, "timestamp": "00:27:26", "text": "私はそう思う"}, {"type": "subtitle", "time": 1647.977, "timestamp": "00:27:27", "text": "匿名化が解除されました。"}, {"type": "subtitle", "time": 1649.262, "timestamp": "00:27:29", "text": "悪魔。悪魔。"}, {"type": "subtitle", "time": 1652.57, "timestamp": "00:27:32", "text": "悪魔。くそ。"}, {"type": "subtitle", "time": 1657.796, "timestamp": "00:27:37", "text": "悪魔。悪魔。バカ"}, {"type": "subtitle", "time": 1659.505, "timestamp": "00:27:39", "text": "細胞。ガラケー 。何てことだ。ご覧になりましたか？"}, {"type": "subtitle", "time": 1662.52, "timestamp": "00:27:42", "text": "。何てことだ。ご覧になりましたか？ ちょっと私に？悪魔"}, {"type": "subtitle", "time": 1669.17, "timestamp": "00:27:49", "text": "ちょっと私に？悪魔 。悪魔。見てください"}]
[{"type": "subtitle", "time": 2463.269, "timestamp": "00:41:03", "text": "待って、電話。"}, {"type": "subtitle", "time": 2464.765, "timestamp": "00:41:04", "text": "充電中ですか？わかりました、"}, {"type": "subtitle", "time": 2466.685, "timestamp": "00:41:06", "text": "充電。ご挨拶申し上げます。"}, {"type": "subtitle", "time": 2469.28, "timestamp": "00:41:09", "text": "でも正直に言うと、"}, {"type": "subtitle", "time": 2470.391, "timestamp": "00:41:10", "text": "私は"}, {"type": "subtitle", "time": 2471.606, "timestamp": "00:41:11", "text": "新しいのを買う必要がある"}, {"type": "subtitle", "time": 2472.752, "timestamp": "00:41:12", "text": "モバイルバッテリーか何か"}, {"type": "subtitle", "time": 2478.707, "timestamp": "00:41:18", "text": "このような。どうしてそうしないのか分からない"}, {"type": "subtitle", "time": 2479.677, "timestamp": "00:41:19", "text": "私は自分がどうやって"}, {"type": "subtitle", "time": 2481.212, "timestamp": "00:41:21", "text": "古いものを修復したが、"}, {"type": "subtitle", "time": 2486.97, "timestamp": "00:41:26", "text": "少なくとも彼は与えるだろう"}, {"type": "subtitle", "time": 2487.889, "timestamp": "00:41:27", "text": "あなたを傷つける"}, {"type": "subtitle", "time": 2491.56, "timestamp": "00:41:31", "text": "存在する場合に限り"}, {"type": "subtitle", "time": 2492.826, "timestamp": "00:41:32", "text": "超高速充電。"}, {"type": "subtitle", "time": 2496.512, "timestamp": "00:41:36", "text": "動作しません"}, {"type": "subtitle", "time": 2497.701, "timestamp": "00:41:37", "text": "レギュラーエクスプレス"}, {"type": "subtitle", "time": 2500.03, "timestamp": "00:41:40", "text": "充電。これは"}, {"type": "subtitle", "time": 2506.302, "timestamp": "00:41:46", "text": "サムスン。えっと、この電話は"}, {"type": "subtitle", "time": 2507.58, "timestamp": "00:41:47", "text": "平凡なものが嫌い"}, {"type": "subtitle", "time": 2508.908, "timestamp": "00:41:48", "text": "急速充電。それで、"}, {"type": "subtitle", "time": 2510.693, "timestamp": "00:41:50", "text": "まさに今がそういう瞬間だ。それでおしまい。"}, {"type": "subtitle", "time": 2513.294, "timestamp": "00:41:53", "text": "全て。それは倒れるだろうか？自分"}, {"type": "subtitle", "time": 2514.766, "timestamp": "00:41:54", "text": "倒れそうだ。"}]
[{"type": "subtitle", "time": 5103.982, "timestamp": "01:25:03", "text": "サムスンはそのままです。見せる はは、そこに行きたいな"}, {"type": "subtitle", "time": 5113.498, "timestamp": "01:25:13", "text": "はは、そこに行きたいな 上へ、しかし太陽がある、"}, {"type": "subtitle", "time": 5114.877, "timestamp": "01:25:14", "text": "上へ、しかし太陽がある、 日差しがある。"}, {"type": "subtitle", "time": 5120.166, "timestamp": "01:25:20", "text": "ここは暑い。欲しい"}, {"type": "subtitle", "time": 5121.584, "timestamp": "01:25:21", "text": "この影の中に留まる"}, {"type": "subtitle", "time": 5125.717, "timestamp": "01:25:25", "text": "永遠に。私はしたいと思います"}, {"type": "subtitle", "time": 5129.043, "timestamp": "01:25:29", "text": "どこかに座ってください。それ"}, {"type": "subtitle", "time": 5130.265, "timestamp": "01:25:30", "text": "それは偉業となるだろう"}, {"type": "subtitle", "time": 5138.518, "timestamp": "01:25:38", "text": "夢。事実"}, {"type": "subtitle", "time": 5139.73, "timestamp": "01:25:39", "text": "私は行かなければならない。"}, {"type": "subtitle", "time": 5143.056, "timestamp": "01:25:43", "text": "あの橋を渡って。自分"}, {"type": "subtitle", "time": 5144.22, "timestamp": "01:25:44", "text": "そこから行かなければならない"}, {"type": "subtitle", "time": 5145.287, "timestamp": "01:25:45", "text": "橋を渡ってまっすぐ進む"}, {"type": "subtitle", "time": 5148.829, "timestamp": "01:25:48", "text": "そこ、あの辺り。ああ。"}]
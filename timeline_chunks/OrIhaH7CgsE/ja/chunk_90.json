[{"type": "subtitle", "time": 5400.192, "timestamp": "01:30:00", "text": "そのトイレ"}, {"type": "subtitle", "time": 5401.582, "timestamp": "01:30:01", "text": "あちらのブースです。その点において"}, {"type": "subtitle", "time": 5402.918, "timestamp": "01:30:02", "text": "緑。私はただ"}, {"type": "subtitle", "time": 5404.037, "timestamp": "01:30:04", "text": "私は気づいた"}, {"type": "subtitle", "time": 5405.394, "timestamp": "01:30:05", "text": "反射面"}, {"type": "subtitle", "time": 5408.112, "timestamp": "01:30:08", "text": "ライト。悪魔。多分、"}, {"type": "subtitle", "time": 5409.453, "timestamp": "01:30:09", "text": "見たか"}, {"type": "subtitle", "time": 5410.94, "timestamp": "01:30:10", "text": "見るべきではなかった。私はそうではない"}, {"type": "subtitle", "time": 5413.347, "timestamp": "01:30:13", "text": "知っている。でも、そうだね、"}, {"type": "subtitle", "time": 5414.667, "timestamp": "01:30:14", "text": "私たちは戻ります。"}, {"type": "subtitle", "time": 5417.796, "timestamp": "01:30:17", "text": "時刻は12時5分です。もうすぐ到着します"}, {"type": "subtitle", "time": 5418.981, "timestamp": "01:30:18", "text": "配信を終了します。"}, {"type": "subtitle", "time": 5429.115, "timestamp": "01:30:29", "text": "わかりました。私たちはやり遂げる。"}, {"type": "subtitle", "time": 5441.265, "timestamp": "01:30:41", "text": "などなど。 D. 私はそうは思いません"}, {"type": "subtitle", "time": 5451.951, "timestamp": "01:30:51", "text": "知っている。私はしません。"}, {"type": "subtitle", "time": 5459.025, "timestamp": "01:30:59", "text": "気づいた。自分自身"}]
[{"type": "subtitle", "time": 4560.281, "timestamp": "01:16:00", "text": "ある男。で"}, {"type": "subtitle", "time": 4565.463, "timestamp": "01:16:05", "text": "私とこの男と"}, {"type": "subtitle", "time": 4567.01, "timestamp": "01:16:07", "text": "このバカなサムスンモード"}, {"type": "subtitle", "time": 4568.577, "timestamp": "01:16:08", "text": "電源が入ります。わからない。"}, {"type": "subtitle", "time": 4576.879, "timestamp": "01:16:16", "text": "何と言えばいいのだろう？ああ、そうだね。おお- おお。まるで私が今日"}, {"type": "subtitle", "time": 4597.958, "timestamp": "01:16:37", "text": "おお。まるで私が今日 キャンペーン。正直に、"}, {"type": "subtitle", "time": 4604.842, "timestamp": "01:16:44", "text": "本当に"}, {"type": "subtitle", "time": 4606.195, "timestamp": "01:16:46", "text": "まるで"}, {"type": "subtitle", "time": 4611.67, "timestamp": "01:16:51", "text": "ハイキング中。これは私に"}]
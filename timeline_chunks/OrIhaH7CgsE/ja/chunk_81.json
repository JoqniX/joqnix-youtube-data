[{"type": "subtitle", "time": 4864.102, "timestamp": "01:21:04", "text": "どこに置けばいいですか？ 手？よし、ここにあるようだ"}, {"type": "subtitle", "time": 4865.911, "timestamp": "01:21:05", "text": "手？よし、ここにあるようだ 通常。だから私は思う"}, {"type": "subtitle", "time": 4879.81, "timestamp": "01:21:19", "text": "通常。だから私は思う 私は変えるべきだ"}, {"type": "subtitle", "time": 4881.034, "timestamp": "01:21:21", "text": "私は変えるべきだ eeに対する感度"}, {"type": "subtitle", "time": 4890.115, "timestamp": "01:21:30", "text": "待って、アリタン、君"}, {"type": "subtitle", "time": 4891.595, "timestamp": "01:21:31", "text": "感度を確認しました ？私には"}, {"type": "subtitle", "time": 4895.481, "timestamp": "01:21:35", "text": "？私には 彼女は「あ、待って」と言った。彼女"}, {"type": "subtitle", "time": 4896.897, "timestamp": "01:21:36", "text": "彼女は「あ、待って」と言った。彼女 音楽を聴く。私"}, {"type": "subtitle", "time": 4898.149, "timestamp": "01:21:38", "text": "音楽を聴く。私 なんてバカなんだ。パック。で"}, {"type": "subtitle", "time": 4902.641, "timestamp": "01:21:42", "text": "なんてバカなんだ。パック。で ああ、私はなんて愚かなんだろう。"}, {"type": "subtitle", "time": 4904.209, "timestamp": "01:21:44", "text": "ああ、私はなんて愚かなんだろう。 ああ、なんてバカなんだろう。"}, {"type": "subtitle", "time": 4905.756, "timestamp": "01:21:45", "text": "ああ、なんてバカなんだろう。 。ああ、それは私だ。"}, {"type": "subtitle", "time": 4911.156, "timestamp": "01:21:51", "text": "。ああ、それは私だ。 バカ。それは「なんてことだ」という感じだった。"}, {"type": "subtitle", "time": 4914.612, "timestamp": "01:21:54", "text": "バカ。それは「なんてことだ」という感じだった。 それだけだった。彼女"}, {"type": "subtitle", "time": 4919.965, "timestamp": "01:21:59", "text": "それだけだった。彼女 一日中音楽を聴いていた"}]
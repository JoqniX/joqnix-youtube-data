[{"type": "subtitle", "time": 2220.452, "timestamp": "00:37:00", "text": "消えてしまうんですよね？なれ"}, {"type": "subtitle", "time": 2221.663, "timestamp": "00:37:01", "text": "どうか、離れないでください。"}, {"type": "subtitle", "time": 2224.094, "timestamp": "00:37:04", "text": "退院の日が来た。"}, {"type": "subtitle", "time": 2226.992, "timestamp": "00:37:06", "text": "気をつけなければならない。"}, {"type": "subtitle", "time": 2231.686, "timestamp": "00:37:11", "text": "それはとても良いことですね。"}, {"type": "subtitle", "time": 2234.24, "timestamp": "00:37:14", "text": "特に"}, {"type": "subtitle", "time": 2235.542, "timestamp": "00:37:15", "text": "自転車が揺れる"}, {"type": "subtitle", "time": 2236.914, "timestamp": "00:37:16", "text": "などなど、しかしチャンスはある。"}, {"type": "subtitle", "time": 2238.079, "timestamp": "00:37:18", "text": "カメラも"}, {"type": "subtitle", "time": 2242.363, "timestamp": "00:37:22", "text": "振る。はい、"}, {"type": "subtitle", "time": 2243.829, "timestamp": "00:37:23", "text": "道には障害がある。"}, {"type": "subtitle", "time": 2263.586, "timestamp": "00:37:43", "text": "わかりました。彼らは"}, {"type": "subtitle", "time": 2264.836, "timestamp": "00:37:44", "text": "私のために止まってくれました。"}, {"type": "subtitle", "time": 2265.699, "timestamp": "00:37:45", "text": "だから私は"}, {"type": "subtitle", "time": 2270.924, "timestamp": "00:37:50", "text": "お辞儀をして明らかにする"}, {"type": "subtitle", "time": 2272.163, "timestamp": "00:37:52", "text": "車を尊重してください"}, {"type": "subtitle", "time": 2273.402, "timestamp": "00:37:53", "text": "停止するので"}, {"type": "subtitle", "time": 2274.779, "timestamp": "00:37:54", "text": "歩行者が横断したため"}, {"type": "subtitle", "time": 2276.122, "timestamp": "00:37:56", "text": "そしてサイクリストたち――これ"}, {"type": "subtitle", "time": 2277.499, "timestamp": "00:37:57", "text": "運転手優先。"}]
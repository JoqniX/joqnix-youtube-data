[{"type": "subtitle", "time": 243.468, "timestamp": "00:04:03", "text": "わかりました。新しいものがあります"}, {"type": "subtitle", "time": 246.722, "timestamp": "00:04:06", "text": "電話。ご挨拶申し上げます。"}, {"type": "subtitle", "time": 248.65, "timestamp": "00:04:08", "text": "カリサ。おめでとう。おめでとう。"}, {"type": "subtitle", "time": 252.655, "timestamp": "00:04:12", "text": "今日の他の人たちと同じように"}, {"type": "subtitle", "time": 254.852, "timestamp": "00:04:14", "text": "不倫？皆様、こんにちは。"}, {"type": "subtitle", "time": 259.633, "timestamp": "00:04:19", "text": "それで、今日は"}, {"type": "subtitle", "time": 260.779, "timestamp": "00:04:20", "text": "必要なもの"}, {"type": "subtitle", "time": 264.866, "timestamp": "00:04:24", "text": "作る。私たちはそうします"}, {"type": "subtitle", "time": 266.136, "timestamp": "00:04:26", "text": "朝の録音。で"}, {"type": "subtitle", "time": 267.05, "timestamp": "00:04:27", "text": "今日の私"}, {"type": "subtitle", "time": 268.60699999999997, "timestamp": "00:04:28", "text": "職業。えっと、今日は"}, {"type": "subtitle", "time": 270.035, "timestamp": "00:04:30", "text": "私はとてもとても忙しいです。"}, {"type": "subtitle", "time": 273.067, "timestamp": "00:04:33", "text": "ええ、ありますよ。"}, {"type": "subtitle", "time": 274.29200000000003, "timestamp": "00:04:34", "text": "今日は授業の日です。"}, {"type": "subtitle", "time": 275.019, "timestamp": "00:04:35", "text": "今日私は"}, {"type": "subtitle", "time": 276.339, "timestamp": "00:04:36", "text": "非常に忙しい 。ええと、私は行かなければならない"}, {"type": "subtitle", "time": 278.001, "timestamp": "00:04:38", "text": "。ええと、私は行かなければならない 仕事とか、そういうこと。"}, {"type": "subtitle", "time": 281.811, "timestamp": "00:04:41", "text": "それで、最近"}, {"type": "subtitle", "time": 286.511, "timestamp": "00:04:46", "text": "病気だった。だから私はできなかった"}, {"type": "subtitle", "time": 287.702, "timestamp": "00:04:47", "text": "保管するために、いくつか"}, {"type": "subtitle", "time": 292.201, "timestamp": "00:04:52", "text": "日。こんにちは、こちらは"}, {"type": "subtitle", "time": 294.369, "timestamp": "00:04:54", "text": "スペイン。でも今は"}, {"type": "subtitle", "time": 299.24, "timestamp": "00:04:59", "text": "注文。しかし、そうです。"}]
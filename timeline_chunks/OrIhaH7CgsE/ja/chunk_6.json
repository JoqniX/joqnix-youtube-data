[{"type": "subtitle", "time": 362.826, "timestamp": "00:06:02", "text": "とんでもない。はい。"}, {"type": "subtitle", "time": 366.106, "timestamp": "00:06:06", "text": "えっと、私、放送中？"}, {"type": "subtitle", "time": 367.593, "timestamp": "00:06:07", "text": "待って、何だって..."}, {"type": "subtitle", "time": 369.02, "timestamp": "00:06:09", "text": "教えてください、"}, {"type": "subtitle", "time": 370.447, "timestamp": "00:06:10", "text": "今、放送中です。"}, {"type": "subtitle", "time": 375.048, "timestamp": "00:06:15", "text": "どうぞ"}, {"type": "subtitle", "time": 376.293, "timestamp": "00:06:16", "text": "私が放送中かどうかを知るため。"}, {"type": "subtitle", "time": 383.064, "timestamp": "00:06:23", "text": "指標によると"}, {"type": "subtitle", "time": 384.461, "timestamp": "00:06:24", "text": "はい、それで私は"}, {"type": "subtitle", "time": 385.997, "timestamp": "00:06:25", "text": "放送に出演する、"}, {"type": "subtitle", "time": 389.46, "timestamp": "00:06:29", "text": "すべてうまくいくと思います。"}, {"type": "subtitle", "time": 395.094, "timestamp": "00:06:35", "text": "わかったよ、兄弟。このバカ"}, {"type": "subtitle", "time": 395.922, "timestamp": "00:06:35", "text": "アプリケーションの場合"}, {"type": "subtitle", "time": 398.013, "timestamp": "00:06:38", "text": "何でも。どうすればいいですか"}, {"type": "subtitle", "time": 398.871, "timestamp": "00:06:38", "text": "彼に強制する"}, {"type": "subtitle", "time": 403.197, "timestamp": "00:06:43", "text": "充電する？これは"}, {"type": "subtitle", "time": 408.779, "timestamp": "00:06:48", "text": "くだらないアプリだ。これだ"}, {"type": "subtitle", "time": 413.49, "timestamp": "00:06:53", "text": "電話。アプリではありません。"}, {"type": "chat", "time": 414.513, "timestamp": "00:06:54", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "OwO"}, {"type": "subtitle", "time": 414.581, "timestamp": "00:06:54", "text": "アプリではありません。それ"}, {"type": "subtitle", "time": 416.853, "timestamp": "00:06:56", "text": "電話。これは電話です。がある 、 あのね？私はできたし"}]
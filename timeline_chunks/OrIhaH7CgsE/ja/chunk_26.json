[{"type": "subtitle", "time": 1563.001, "timestamp": "00:26:03", "text": "待って、私はただ"}, {"type": "subtitle", "time": 1591.934, "timestamp": "00:26:31", "text": "時間をかけてじっくりやります。ありますか"}, {"type": "subtitle", "time": 1593.341, "timestamp": "00:26:33", "text": "私ができる方法"}, {"type": "subtitle", "time": 1599.689, "timestamp": "00:26:39", "text": "問題は彼が"}, {"type": "subtitle", "time": 1604.681, "timestamp": "00:26:44", "text": "まっすぐ立つべきだ。何"}, {"type": "subtitle", "time": 1606.052, "timestamp": "00:26:46", "text": "彼が持っている場合、"}, {"type": "subtitle", "time": 1610.449, "timestamp": "00:26:50", "text": "率直に言って？どれの"}, {"type": "subtitle", "time": 1614.894, "timestamp": "00:26:54", "text": "最善の方法は？私の"}, {"type": "subtitle", "time": 1616.366, "timestamp": "00:26:56", "text": "バッグはとても重いので、"}, {"type": "subtitle", "time": 1617.617, "timestamp": "00:26:57", "text": "たぶん置くよ"}]
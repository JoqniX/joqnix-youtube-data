[{"type": "subtitle", "time": 1988.404, "timestamp": "00:33:08", "text": "不知怎么的，它居然奏效了。案件"}, {"type": "subtitle", "time": 1992.299, "timestamp": "00:33:12", "text": "事情是这样的：哦，是的，你"}, {"type": "subtitle", "time": 1993.421, "timestamp": "00:33:13", "text": "你可以伤害我。"}, {"type": "subtitle", "time": 1994.446, "timestamp": "00:33:14", "text": "听不见，因为我听不见"}, {"type": "subtitle", "time": 1995.439, "timestamp": "00:33:15", "text": "使用"}, {"type": "subtitle", "time": 1996.624, "timestamp": "00:33:16", "text": "外置麦克风，"}, {"type": "subtitle", "time": 1997.714, "timestamp": "00:33:17", "text": "因为我正在充电"}, {"type": "subtitle", "time": 1998.643, "timestamp": "00:33:18", "text": "电话期间"}, {"type": "subtitle", "time": 2001.394, "timestamp": "00:33:21", "text": "溪流。所以问题是："}, {"type": "subtitle", "time": 2002.722, "timestamp": "00:33:22", "text": "我必须走了"}, {"type": "subtitle", "time": 2003.607, "timestamp": "00:33:23", "text": "骑自行车"}, {"type": "subtitle", "time": 2008.142, "timestamp": "00:33:28", "text": "慢慢地，呃，是"}, {"type": "subtitle", "time": 2008.984, "timestamp": "00:33:28", "text": "小心"}, {"type": "subtitle", "time": 2010.17, "timestamp": "00:33:30", "text": "坑洼等等"}, {"type": "subtitle", "time": 2013.699, "timestamp": "00:33:33", "text": "像这样。我们开始吧"}, {"type": "subtitle", "time": 2020.354, "timestamp": "00:33:40", "text": "真的吗？我的天哪，我不知道"}, {"type": "subtitle", "time": 2022.912, "timestamp": "00:33:42", "text": "我听到有人在聊天。最重要的是我"}, {"type": "subtitle", "time": 2024.253, "timestamp": "00:33:44", "text": "我能听到聊天内容，什么都能听到。"}, {"type": "subtitle", "time": 2025.989, "timestamp": "00:33:45", "text": "好的。但我做不到。"}, {"type": "subtitle", "time": 2027.373, "timestamp": "00:33:47", "text": "对了，记得看看聊天记录。"}, {"type": "subtitle", "time": 2030.272, "timestamp": "00:33:50", "text": "所以我其实不太清楚。"}, {"type": "subtitle", "time": 2035.298, "timestamp": "00:33:55", "text": "我知道我要去哪里。是的，"}, {"type": "subtitle", "time": 2036.997, "timestamp": "00:33:56", "text": "我们的目标是达到"}]
[{"type": "subtitle", "time": 2220.452, "timestamp": "00:37:00", "text": "会消失，对吗？是"}, {"type": "subtitle", "time": 2221.663, "timestamp": "00:37:01", "text": "请不要掉下去。"}, {"type": "subtitle", "time": 2224.094, "timestamp": "00:37:04", "text": "已经出院了。"}, {"type": "subtitle", "time": 2226.992, "timestamp": "00:37:06", "text": "你必须小心。"}, {"type": "subtitle", "time": 2231.686, "timestamp": "00:37:11", "text": "那太好了。"}, {"type": "subtitle", "time": 2234.24, "timestamp": "00:37:14", "text": "尤其是当"}, {"type": "subtitle", "time": 2235.542, "timestamp": "00:37:15", "text": "自行车晃动"}, {"type": "subtitle", "time": 2236.914, "timestamp": "00:37:16", "text": "诸如此类，但还是有机会的。"}, {"type": "subtitle", "time": 2238.079, "timestamp": "00:37:18", "text": "相机还可以"}, {"type": "subtitle", "time": 2242.363, "timestamp": "00:37:22", "text": "摇。是的，"}, {"type": "subtitle", "time": 2243.829, "timestamp": "00:37:23", "text": "前进的路上会遇到坎坷。"}, {"type": "subtitle", "time": 2263.586, "timestamp": "00:37:43", "text": "好的。他们"}, {"type": "subtitle", "time": 2264.836, "timestamp": "00:37:44", "text": "停下来等我。"}, {"type": "subtitle", "time": 2265.699, "timestamp": "00:37:45", "text": "因此我必须"}, {"type": "subtitle", "time": 2270.924, "timestamp": "00:37:50", "text": "鞠躬并显露"}, {"type": "subtitle", "time": 2272.163, "timestamp": "00:37:52", "text": "如果尊重汽车"}, {"type": "subtitle", "time": 2273.402, "timestamp": "00:37:53", "text": "停下来，这样你"}, {"type": "subtitle", "time": 2274.779, "timestamp": "00:37:54", "text": "因为行人而过马路"}, {"type": "subtitle", "time": 2276.122, "timestamp": "00:37:56", "text": "以及骑自行车的人——这"}, {"type": "subtitle", "time": 2277.499, "timestamp": "00:37:57", "text": "优先保障驾驶员。"}]
[{"type": "subtitle", "time": 961.85, "timestamp": "00:16:01", "text": "事物。啊，早晨。我几乎 没错过那辆车"}, {"type": "subtitle", "time": 963.162, "timestamp": "00:16:03", "text": "没错过那辆车 。哦，糟糕。我的天啊。"}, {"type": "subtitle", "time": 969.819, "timestamp": "00:16:09", "text": "这很糟糕。这就是我的方式"}, {"type": "subtitle", "time": 971.26, "timestamp": "00:16:11", "text": "我可以这样拿吗？"}, {"type": "subtitle", "time": 976.595, "timestamp": "00:16:16", "text": "这很难。所以，我们"}, {"type": "subtitle", "time": 977.861, "timestamp": "00:16:17", "text": "我们就在这儿坐一会儿吧。"}, {"type": "subtitle", "time": 978.917, "timestamp": "00:16:18", "text": "然后我们将前往"}, {"type": "subtitle", "time": 979.809, "timestamp": "00:16:19", "text": "骑自行车"}, {"type": "subtitle", "time": 980.893, "timestamp": "00:16:20", "text": "我的学区。"}, {"type": "subtitle", "time": 982.141, "timestamp": "00:16:22", "text": "但我计划"}, {"type": "subtitle", "time": 983.612, "timestamp": "00:16:23", "text": "去海边。不，"}, {"type": "subtitle", "time": 984.814, "timestamp": "00:16:24", "text": "不是到海洋，而是到"}, {"type": "subtitle", "time": 985.941, "timestamp": "00:16:25", "text": "那座堤岸"}, {"type": "subtitle", "time": 988.287, "timestamp": "00:16:28", "text": "河流。然后我们"}, {"type": "subtitle", "time": 989.511, "timestamp": "00:16:29", "text": "嗯，是的。"}, {"type": "subtitle", "time": 991.114, "timestamp": "00:16:31", "text": "咱们放松一下吧。"}, {"type": "subtitle", "time": 995.019, "timestamp": "00:16:35", "text": "老兄。这就是我所说的词。"}, {"type": "subtitle", "time": 998.67, "timestamp": "00:16:38", "text": "我正在观看。我的天啊。几乎不"}, {"type": "subtitle", "time": 1000.388, "timestamp": "00:16:40", "text": "没有摔倒。该死的。在"}, {"type": "subtitle", "time": 1001.907, "timestamp": "00:16:41", "text": "我的天啊。几乎"}, {"type": "subtitle", "time": 1010.641, "timestamp": "00:16:50", "text": "崩溃了。非常"}, {"type": "subtitle", "time": 1012.252, "timestamp": "00:16:52", "text": "很热。是的，这是我的。"}, {"type": "subtitle", "time": 1013.762, "timestamp": "00:16:53", "text": "包。这是旧照片。"}, {"type": "subtitle", "time": 1014.92, "timestamp": "00:16:54", "text": "不具备此功能的移动电源"}, {"type": "subtitle", "time": 1017.832, "timestamp": "00:16:57", "text": "成功了。奇怪，但是"}, {"type": "subtitle", "time": 1019.215, "timestamp": "00:16:59", "text": "显示屏突然启动了"}]
[{"type": "subtitle", "time": 1023.061, "timestamp": "00:17:03", "text": "辉光。但我没有"}, {"type": "subtitle", "time": 1024.284, "timestamp": "00:17:04", "text": "我可以把它放在那里吗？"}, {"type": "subtitle", "time": 1027.056, "timestamp": "00:17:07", "text": "手。这里，呃，不是"}, {"type": "subtitle", "time": 1028.516, "timestamp": "00:17:08", "text": "我知道，你明白吗？"}, {"type": "subtitle", "time": 1030.062, "timestamp": "00:17:10", "text": "那个USB接口更大"}, {"type": "subtitle", "time": 1033.592, "timestamp": "00:17:13", "text": "无法运行。我是。"}, {"type": "subtitle", "time": 1037.723, "timestamp": "00:17:17", "text": "我现在勉强可以做到。"}, {"type": "subtitle", "time": 1040.195, "timestamp": "00:17:20", "text": "勉强应付过去。但"}, {"type": "subtitle", "time": 1041.059, "timestamp": "00:17:21", "text": "谁知道他是否"}, {"type": "subtitle", "time": 1042.322, "timestamp": "00:17:22", "text": "绝对值得。"}, {"type": "subtitle", "time": 1044.621, "timestamp": "00:17:24", "text": "是的，这是真的。"}, {"type": "subtitle", "time": 1046.207, "timestamp": "00:17:26", "text": "生活不易啊。我有"}, {"type": "subtitle", "time": 1049.556, "timestamp": "00:17:29", "text": "我的意思是，流媒体—— 说实话，这真是太……"}, {"type": "subtitle", "time": 1051.094, "timestamp": "00:17:31", "text": "说实话，这真是太…… 面粉，如果你不知道的话，"}, {"type": "subtitle", "time": 1052.477, "timestamp": "00:17:32", "text": "面粉，如果你不知道的话， 你在干什么？我该怎么做？"}, {"type": "subtitle", "time": 1055.797, "timestamp": "00:17:35", "text": "你在干什么？我该怎么做？ 隐藏？该怎么办..."}, {"type": "subtitle", "time": 1061.505, "timestamp": "00:17:41", "text": "隐藏？该怎么办... 我不需要它。"}, {"type": "subtitle", "time": 1068.4, "timestamp": "00:17:48", "text": "出去。你仍然"}, {"type": "subtitle", "time": 1071.809, "timestamp": "00:17:51", "text": "你看到了吗？哦，这个，哦，这个"}, {"type": "subtitle", "time": 1074.218, "timestamp": "00:17:54", "text": "这事真烦人。我不知道。"}]
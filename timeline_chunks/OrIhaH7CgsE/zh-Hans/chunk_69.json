[{"type": "subtitle", "time": 4141.636, "timestamp": "01:09:01", "text": "向下延伸。这是什么？"}, {"type": "subtitle", "time": 4145.106, "timestamp": "01:09:05", "text": "这不是公园。我勒个去？ ？这里根本不是公园。"}, {"type": "subtitle", "time": 4150.423, "timestamp": "01:09:10", "text": "更像是"}, {"type": "subtitle", "time": 4162.489, "timestamp": "01:09:22", "text": "隧道。好的。我认为"}, {"type": "subtitle", "time": 4167.037, "timestamp": "01:09:27", "text": "我可以像这样：呃"}, {"type": "subtitle", "time": 4169.25, "timestamp": "01:09:29", "text": "你怎么认为？"}, {"type": "subtitle", "time": 4170.582, "timestamp": "01:09:30", "text": "私人领地"}, {"type": "subtitle", "time": 4172.59, "timestamp": "01:09:32", "text": "那里？我想看"}, {"type": "subtitle", "time": 4173.66, "timestamp": "01:09:33", "text": "那片风景，但是"}, {"type": "subtitle", "time": 4175.051, "timestamp": "01:09:35", "text": "看起来像是私人场所。"}, {"type": "subtitle", "time": 4177.821, "timestamp": "01:09:37", "text": "财产。啊，这个"}, {"type": "subtitle", "time": 4179.195, "timestamp": "01:09:39", "text": "私人领地。"}, {"type": "subtitle", "time": 4192.741, "timestamp": "01:09:52", "text": "好了，就这些。这是这种类型"}, {"type": "subtitle", "time": 4194.024, "timestamp": "01:09:54", "text": "这是最高的塔"}, {"type": "subtitle", "time": 4197.432, "timestamp": "01:09:57", "text": "区。最高的塔。"}, {"type": "subtitle", "time": 4199.326, "timestamp": "01:09:59", "text": "从那里可以看到一切。"}]
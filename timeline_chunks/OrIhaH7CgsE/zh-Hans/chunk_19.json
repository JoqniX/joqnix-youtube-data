[{"type": "subtitle", "time": 1153.612, "timestamp": "00:19:13", "text": "例子。等待。"}, {"type": "subtitle", "time": 1163.575, "timestamp": "00:19:23", "text": "你看到了吗？那个女人"}, {"type": "subtitle", "time": 1164.785, "timestamp": "00:19:24", "text": "用那种眼神看着我"}, {"type": "subtitle", "time": 1166.067, "timestamp": "00:19:26", "text": "公园里，我想：“ 该死，我不配。"}, {"type": "subtitle", "time": 1170.295, "timestamp": "00:19:30", "text": "该死，我不配。 “去那里”。她"}, {"type": "subtitle", "time": 1172.729, "timestamp": "00:19:32", "text": "“去那里”。她 他问我：“这是什么？”"}, {"type": "subtitle", "time": 1174.245, "timestamp": "00:19:34", "text": "他问我：“这是什么？” 你在干嘛，兄弟？嗯"}, {"type": "subtitle", "time": 1177.415, "timestamp": "00:19:37", "text": "你在干嘛，兄弟？嗯 很难握住你的手"}, {"type": "subtitle", "time": 1178.598, "timestamp": "00:19:38", "text": "很难握住你的手 像这样伸展开来。"}, {"type": "subtitle", "time": 1185.398, "timestamp": "00:19:45", "text": "这是个馊主意。毫米。它"}, {"type": "subtitle", "time": 1189.426, "timestamp": "00:19:49", "text": "馊主意。它"}, {"type": "subtitle", "time": 1191.949, "timestamp": "00:19:51", "text": "很糟糕。我不能。是的"}, {"type": "subtitle", "time": 1193.247, "timestamp": "00:19:53", "text": "牵着你的手很烦人。"}]
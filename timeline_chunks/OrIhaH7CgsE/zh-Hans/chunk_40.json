[{"type": "subtitle", "time": 2400.82, "timestamp": "00:40:00", "text": "等待。我希望如此。"}, {"type": "subtitle", "time": 2406.027, "timestamp": "00:40:06", "text": "摄像机正朝这边移动。"}, {"type": "subtitle", "time": 2407.469, "timestamp": "00:40:07", "text": "不平整区域。它"}, {"type": "subtitle", "time": 2408.723, "timestamp": "00:40:08", "text": "但风险很大。"}, {"type": "subtitle", "time": 2410.597, "timestamp": "00:40:10", "text": "相机要掉下来了。电话"}, {"type": "subtitle", "time": 2413.314, "timestamp": "00:40:13", "text": "将会倒下。我需要"}, {"type": "subtitle", "time": 2416.25, "timestamp": "00:40:16", "text": "非法越境"}, {"type": "subtitle", "time": 2417.706, "timestamp": "00:40:17", "text": "另一边。好的，"}, {"type": "subtitle", "time": 2419.165, "timestamp": "00:40:19", "text": "让我来做。"}, {"type": "subtitle", "time": 2428.199, "timestamp": "00:40:28", "text": "哦，那是一辆垃圾车。啊，这个"}, {"type": "subtitle", "time": 2429.863, "timestamp": "00:40:29", "text": "不是垃圾车。它"}, {"type": "subtitle", "time": 2431.163, "timestamp": "00:40:31", "text": "肥料喷雾器。"}, {"type": "subtitle", "time": 2454.65, "timestamp": "00:40:54", "text": "好的。缓慢但"}, {"type": "subtitle", "time": 2458.692, "timestamp": "00:40:58", "text": "自信地。我们走吧。"}]
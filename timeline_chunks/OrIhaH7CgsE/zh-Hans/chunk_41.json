[{"type": "subtitle", "time": 2463.269, "timestamp": "00:41:03", "text": "等等，电话。"}, {"type": "subtitle", "time": 2464.765, "timestamp": "00:41:04", "text": "正在充电吗？好的，"}, {"type": "subtitle", "time": 2466.685, "timestamp": "00:41:06", "text": "收费。问候。"}, {"type": "subtitle", "time": 2469.28, "timestamp": "00:41:09", "text": "但说实话，我"}, {"type": "subtitle", "time": 2470.391, "timestamp": "00:41:10", "text": "我觉得我"}, {"type": "subtitle", "time": 2471.606, "timestamp": "00:41:11", "text": "需要买一个新的"}, {"type": "subtitle", "time": 2472.752, "timestamp": "00:41:12", "text": "移动电源之类的"}, {"type": "subtitle", "time": 2478.707, "timestamp": "00:41:18", "text": "像这样。我不知道我怎么会不"}, {"type": "subtitle", "time": 2479.677, "timestamp": "00:41:19", "text": "我知道我该怎么做……"}, {"type": "subtitle", "time": 2481.212, "timestamp": "00:41:21", "text": "修复了旧的，但是"}, {"type": "subtitle", "time": 2486.97, "timestamp": "00:41:26", "text": "至少他会给"}, {"type": "subtitle", "time": 2487.889, "timestamp": "00:41:27", "text": "伤害你"}, {"type": "subtitle", "time": 2491.56, "timestamp": "00:41:31", "text": "仅当存在"}, {"type": "subtitle", "time": 2492.826, "timestamp": "00:41:32", "text": "超快充电。"}, {"type": "subtitle", "time": 2496.512, "timestamp": "00:41:36", "text": "它与……不兼容"}, {"type": "subtitle", "time": 2497.701, "timestamp": "00:41:37", "text": "普通快递"}, {"type": "subtitle", "time": 2500.03, "timestamp": "00:41:40", "text": "收费。这应该是"}, {"type": "subtitle", "time": 2506.302, "timestamp": "00:41:46", "text": "三星。呃，这部手机"}, {"type": "subtitle", "time": 2507.58, "timestamp": "00:41:47", "text": "厌恶平庸"}, {"type": "subtitle", "time": 2508.908, "timestamp": "00:41:48", "text": "快速充电。所以，"}, {"type": "subtitle", "time": 2510.693, "timestamp": "00:41:50", "text": "这是一个难忘的时刻。就是这样。"}, {"type": "subtitle", "time": 2513.294, "timestamp": "00:41:53", "text": "全部。它会倒吗？我"}, {"type": "subtitle", "time": 2514.766, "timestamp": "00:41:54", "text": "它好像要倒了。"}]
[{"type": "subtitle", "time": 4037.432, "timestamp": "01:07:17", "text": "问候。对不起。好的，"}, {"type": "subtitle", "time": 4039.003, "timestamp": "01:07:19", "text": "我觉得我很安全。"}, {"type": "subtitle", "time": 4048.172, "timestamp": "01:07:28", "text": "区。我要去哪里？这是哪里？"}, {"type": "subtitle", "time": 4051.711, "timestamp": "01:07:31", "text": "我是在走路吗？谁知道呢？呃，"}, {"type": "subtitle", "time": 4053.304, "timestamp": "01:07:33", "text": "我只知道这一点。"}, {"type": "subtitle", "time": 4055.027, "timestamp": "01:07:35", "text": "我离学校很远。"}, {"type": "subtitle", "time": 4059.506, "timestamp": "01:07:39", "text": "我已经离开了"}, {"type": "subtitle", "time": 4060.526, "timestamp": "01:07:40", "text": "确实有一些"}, {"type": "subtitle", "time": 4061.801, "timestamp": "01:07:41", "text": "就在我……之前"}, {"type": "subtitle", "time": 4066.704, "timestamp": "01:07:46", "text": "我要去上学。我"}, {"type": "subtitle", "time": 4071.662, "timestamp": "01:07:51", "text": "我在浪费时间。所以那些，"}, {"type": "subtitle", "time": 4073.212, "timestamp": "01:07:53", "text": "还有谁在聊天室里？"}, {"type": "subtitle", "time": 4075.894, "timestamp": "01:07:55", "text": "是的，大概就是这样。"}, {"type": "subtitle", "time": 4076.928, "timestamp": "01:07:56", "text": "上次我们"}, {"type": "subtitle", "time": 4077.929, "timestamp": "01:07:57", "text": "我们可以经常这样做。"}]
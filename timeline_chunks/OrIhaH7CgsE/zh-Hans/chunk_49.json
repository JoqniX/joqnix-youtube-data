[{"type": "subtitle", "time": 2940.666, "timestamp": "00:49:00", "text": "我仍然想做这件事。"}, {"type": "subtitle", "time": 2943.81, "timestamp": "00:49:03", "text": "相机呢？我有"}, {"type": "subtitle", "time": 2945.079, "timestamp": "00:49:05", "text": "没有运动相机。"}, {"type": "subtitle", "time": 2947.999, "timestamp": "00:49:07", "text": "我只有旧的那一个。"}, {"type": "subtitle", "time": 2949.596, "timestamp": "00:49:09", "text": "三星手机，仅此而已。"}, {"type": "subtitle", "time": 2955.141, "timestamp": "00:49:15", "text": "还有这部手机"}, {"type": "subtitle", "time": 2956.485, "timestamp": "00:49:16", "text": "需要超快的速度"}, {"type": "subtitle", "time": 2957.729, "timestamp": "00:49:17", "text": "三星充电，否则"}, {"type": "subtitle", "time": 2958.938, "timestamp": "00:49:18", "text": "他来自某个奇怪的地方。"}, {"type": "subtitle", "time": 2959.913, "timestamp": "00:49:19", "text": "不需要理由"}, {"type": "subtitle", "time": 2963.544, "timestamp": "00:49:23", "text": "工作。所以这是"}, {"type": "subtitle", "time": 2969.665, "timestamp": "00:49:29", "text": "非常疼。所以，在"}, {"type": "subtitle", "time": 2970.702, "timestamp": "00:49:30", "text": "我只有这一本。"}, {"type": "subtitle", "time": 2974.455, "timestamp": "00:49:34", "text": "电话。我有一张。"}, {"type": "subtitle", "time": 2975.768, "timestamp": "00:49:35", "text": "自行车之类的东西，"}, {"type": "subtitle", "time": 2976.983, "timestamp": "00:49:36", "text": "但问题是，"}, {"type": "subtitle", "time": 2977.869, "timestamp": "00:49:37", "text": "他太……"}, {"type": "subtitle", "time": 2979.018, "timestamp": "00:49:39", "text": "它在摇晃，对吧？"}, {"type": "subtitle", "time": 2981.426, "timestamp": "00:49:41", "text": "他浑身都在发抖。"}, {"type": "subtitle", "time": 2988.209, "timestamp": "00:49:48", "text": "非常。甚至"}, {"type": "subtitle", "time": 2989.1, "timestamp": "00:49:49", "text": "我现在持有。"}, {"type": "subtitle", "time": 2990.19, "timestamp": "00:49:50", "text": "手里拿着手机，"}, {"type": "subtitle", "time": 2991.478, "timestamp": "00:49:51", "text": "我可能会不小心删除"}, {"type": "subtitle", "time": 2992.7, "timestamp": "00:49:52", "text": "你自己，因为相机可以"}, {"type": "subtitle", "time": 2995.727, "timestamp": "00:49:55", "text": "转变。如果"}, {"type": "subtitle", "time": 2996.219, "timestamp": "00:49:56", "text": "电话"}, {"type": "subtitle", "time": 2997.301, "timestamp": "00:49:57", "text": "会翻过来，你"}, {"type": "subtitle", "time": 2998.614, "timestamp": "00:49:58", "text": "你会看到我的脸。"}]
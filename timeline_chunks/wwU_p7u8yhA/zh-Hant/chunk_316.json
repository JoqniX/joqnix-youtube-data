[{"type": "subtitle", "time": 18967.83, "timestamp": "05:16:07", "text": "我現在需要……呃，我忘了……我忘了……把我的東西都拿走"}, {"type": "subtitle", "time": 18973.19, "timestamp": "05:16:13", "text": "。你把這邊的蜘蛛殺了嗎？這邊有蜘蛛。哦，是的。"}, {"type": "subtitle", "time": 18985.67, "timestamp": "05:16:25", "text": "哦，有蜘蛛。呃，別理它們，快跑。我應該把它放在哪裡？我應該把它放在"}, {"type": "subtitle", "time": 18991.51, "timestamp": "05:16:31", "text": "哪裡？這邊。多個青蛙。蜘蛛。我要回基地了。好的。是的，"}, {"type": "subtitle", "time": 18998.55, "timestamp": "05:16:38", "text": "我們現在可以做肉丸了。不錯。那邊有隻"}, {"type": "subtitle", "time": 19005.83, "timestamp": "05:16:45", "text": "蜘蛛。我"}, {"type": "subtitle", "time": 19008.708, "timestamp": "05:16:48", "text": "不能，我不能，時間太長了。不，等等。"}, {"type": "subtitle", "time": 19010.788, "timestamp": "05:16:50", "text": "蜘蛛"}, {"type": "subtitle", "time": 19012.788, "timestamp": "05:16:52", "text": "在這邊。沒有火把你會死的。這是什麼玩意兒？我的"}, {"type": "subtitle", "time": 19015.43, "timestamp": "05:16:55", "text": "天哪。我是說，反正"}, {"type": "subtitle", "time": 19016.47, "timestamp": "05:16:56", "text": "我本來就在那兒。慢燉鍋裡再加"}, {"type": "subtitle", "time": 19017.99, "timestamp": "05:16:57", "text": "一塊肉。哦，我知道了，我有"}]
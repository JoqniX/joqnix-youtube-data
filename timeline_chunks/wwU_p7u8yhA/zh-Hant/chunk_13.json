[{"type": "subtitle", "time": 783.91, "timestamp": "00:13:03", "text": "不能把這首歌寄給"}, {"type": "subtitle", "time": 786.629, "timestamp": "00:13:06", "text": "我，讓我學這首歌。他們就像是說：「"}, {"type": "subtitle", "time": 794.47, "timestamp": "00:13:14", "text": "莫，你不行，我覺得你做不到，運動員。」我"}, {"type": "subtitle", "time": 800.71, "timestamp": "00:13:20", "text": "心想，我還沒發揮出最佳水準"}, {"type": "subtitle", "time": 821.19, "timestamp": "00:13:41", "text": "。我還沒試過。等等，別這麼說。  別聽我"}, {"type": "subtitle", "time": 833.75, "timestamp": "00:13:53", "text": "唱歌。我當時就想，我給你們看，我就是這麼跟他們說的。但是，這有點難。  有點難。  雖然我沒有唱歌的天份。我想盡我所能做到最好，至少你知道的，但主要還是想盡我所能去創作音樂，真正地去製作音樂，那是"}]
[{"type": "subtitle", "time": 20283.35, "timestamp": "05:38:03", "text": "他們了。有人想快速看一遍節目嗎？是的，"}, {"type": "subtitle", "time": 20286.708, "timestamp": "05:38:06", "text": "我想看這個節目。  好的。在哪裡？哦，原來你在"}, {"type": "subtitle", "time": 20295.35, "timestamp": "05:38:15", "text": "這兒。正確的。讓我們來看看。人們在哪裡？  有"}, {"type": "subtitle", "time": 20308.15, "timestamp": "05:38:28", "text": "沒有人想看看我的傑克？快點。請大家這邊走。這的確是"}, {"type": "subtitle", "time": 20311.83, "timestamp": "05:38:31", "text": "事實。  哦，那是漿果。"}, {"type": "subtitle", "time": 20318.23, "timestamp": "05:38:38", "text": "漿果。好了，伙計們，開始吧。好的，等等，等等。我還是會去那邊。開始了。我之後還會再玩一遍這個世界。"}, {"type": "subtitle", "time": 20335.03, "timestamp": "05:38:55", "text": "否則，我可能會"}, {"type": "subtitle", "time": 20338.47, "timestamp": "05:38:58", "text": "縱火，也可能"}]
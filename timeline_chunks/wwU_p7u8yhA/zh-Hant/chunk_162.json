[{"type": "subtitle", "time": 9761.03, "timestamp": "02:42:41", "text": "英雄太難掌握了。"}, {"type": "subtitle", "time": 9763.59, "timestamp": "02:42:43", "text": "我想要終極的砰砰聲。  [音樂] 去他媽的，他們全都該死。  [音樂]"}, {"type": "subtitle", "time": 9773.51, "timestamp": "02:42:53", "text": "哦，我們搞定了。哦，不錯。  不成功。  有人提議：我們之後偷偷去海灘玩一趟。如果"}]
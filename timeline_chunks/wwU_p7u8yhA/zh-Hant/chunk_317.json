[{"type": "subtitle", "time": 19020.07, "timestamp": "05:17:00", "text": "很多蜘蛛。我是說，是的。呃，怪物肉。哦，他們把"}, {"type": "subtitle", "time": 19022.15, "timestamp": "05:17:02", "text": "它拿走了"}, {"type": "subtitle", "time": 19040.788, "timestamp": "05:17:20", "text": "我的天哪。一塊怪物肉。"}, {"type": "subtitle", "time": 19062.39, "timestamp": "05:17:42", "text": "。等等，"}, {"type": "subtitle", "time": 19065.51, "timestamp": "05:17:45", "text": "這是正確的配方嗎？不。呃，是的，可以。好的，看看。我的"}, {"type": "subtitle", "time": 19072.55, "timestamp": "05:17:52", "text": "天哪。三種配料合在一起。"}, {"type": "subtitle", "time": 19077.27, "timestamp": "05:17:57", "text": "哦，天哪。三種配料，一塊肉，對吧？"}]
[{"type": "subtitle", "time": 18067.35, "timestamp": "05:01:07", "text": "你高興。為什麼到處都是金子？這是什麼鬼？可能是某個墓地。"}, {"type": "subtitle", "time": 18077.19, "timestamp": "05:01:17", "text": "這是個礦。那裡有……那"}, {"type": "subtitle", "time": 18079.19, "timestamp": "05:01:19", "text": "是一群蜘蛛。"}, {"type": "subtitle", "time": 18089.83, "timestamp": "05:01:29", "text": "。好多的東西。我的生命值"}, {"type": "subtitle", "time": 18095.51, "timestamp": "05:01:35", "text": "下降了25%。"}, {"type": "subtitle", "time": 18103.11, "timestamp": "05:01:43", "text": "別開始做不該做的事。紅頭髮的？ 好吧，你可以如果你拿到"}]
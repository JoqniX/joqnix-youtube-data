[{"type": "subtitle", "time": 22265.67, "timestamp": "06:11:05", "text": "喔不，不，不，不。太粗俗了。快點。這裡不行。  哦，"}, {"type": "subtitle", "time": 22273.91, "timestamp": "06:11:13", "text": "你們這些愛玩樂的人。  是的。  你看，跟你比起來我好渺小。"}, {"type": "subtitle", "time": 22283.67, "timestamp": "06:11:23", "text": "你真高大。我不是大魔子，你真的很大，媽媽"}, {"type": "subtitle", "time": 22291.11, "timestamp": "06:11:31", "text": "。雖然我很瘦"}]
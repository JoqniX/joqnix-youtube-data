[{"type": "subtitle", "time": 15548.469, "timestamp": "04:19:08", "text": "為什麼大家的生日都快到了"}, {"type": "subtitle", "time": 15551.269, "timestamp": "04:19:11", "text": "？"}, {"type": "subtitle", "time": 15554.71, "timestamp": "04:19:14", "text": "搞什麼鬼？  祝大家生日快樂。不是每個人的生日。  今天是大家的生日。  學院。是的，"}, {"type": "subtitle", "time": 15570.63, "timestamp": "04:19:30", "text": "等等，"}, {"type": "subtitle", "time": 15578.71, "timestamp": "04:19:38", "text": "你是說你生日派對上要穿生日禮服嗎？"}, {"type": "subtitle", "time": 15593.83, "timestamp": "04:19:53", "text": "哦"}]
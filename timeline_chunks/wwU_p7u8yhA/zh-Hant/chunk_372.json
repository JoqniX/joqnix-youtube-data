[{"type": "subtitle", "time": 22327.75, "timestamp": "06:12:07", "text": "但我已經很抱歉透露了，我沒見過任何運動員，他只是我可愛的弟弟。是的，你不是。"}, {"type": "subtitle", "time": 22330.15, "timestamp": "06:12:10", "text": "為什麼？我們"}, {"type": "subtitle", "time": 22333.99, "timestamp": "06:12:13", "text": "不要像那些動漫女孩一樣，說「我今天沒辦法用那種聲音」。"}, {"type": "subtitle", "time": 22341.91, "timestamp": "06:12:21", "text": "[音樂] 我的意思是，我"}, {"type": "subtitle", "time": 22352.23, "timestamp": "06:12:32", "text": "對櫻也是那樣。  把她給我，我也想要她。  她問：「你知道Yamat上到底是什麼嗎？」我知道你常常看成人動漫"}, {"type": "subtitle", "time": 22366.788, "timestamp": "06:12:46", "text": "我就避開了那個話題，才轉移了話題。 Baka dum dad。  你為什麼生氣？"}]
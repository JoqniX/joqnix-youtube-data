[{"type": "subtitle", "time": 19622.39, "timestamp": "05:27:02", "text": "鱼饵和渔具店。哟，"}, {"type": "subtitle", "time": 19626.07, "timestamp": "05:27:06", "text": "是的，我们也快要结束了。我想"}, {"type": "subtitle", "time": 19628.07, "timestamp": "05:27:08", "text": "有一件泳衣。"}, {"type": "subtitle", "time": 19630.23, "timestamp": "05:27:10", "text": "是的，"}, {"type": "subtitle", "time": 19632.628, "timestamp": "05:27:12", "text": "我们来看看……"}, {"type": "subtitle", "time": 19639.83, "timestamp": "05:27:19", "text": "他什么也得不到。他没有"}, {"type": "subtitle", "time": 19641.59, "timestamp": "05:27:21", "text": "有任何擒抱吗？放一颗浆果在上面，"}, {"type": "subtitle", "time": 19645.59, "timestamp": "05:27:25", "text": "阿鲁。放上一颗浆果。我会放"}, {"type": "subtitle", "time": 19647.59, "timestamp": "05:27:27", "text": "你只要放一颗浆果在上面就行了。只是"}, {"type": "subtitle", "time": 19650.868, "timestamp": "05:27:30", "text": "从农场摘一颗浆果。把它捡起来。"}, {"type": "subtitle", "time": 19652.868, "timestamp": "05:27:32", "text": "这里有很多不可告人的秘密啊，伙计们。什么？"}, {"type": "subtitle", "time": 19654.8, "timestamp": "05:27:34", "text": "他妈的？大家好吗？"}, {"type": "subtitle", "time": 19656.628, "timestamp": "05:27:36", "text": "[音乐]"}, {"type": "subtitle", "time": 19658.788, "timestamp": "05:27:38", "text": "好吧，我知道确切情况。你知道吗？我知道"}, {"type": "subtitle", "time": 19661.03, "timestamp": "05:27:41", "text": "这正是我想要的死法。我知道"}, {"type": "subtitle", "time": 19663.51, "timestamp": "05:27:43", "text": "具体该怎么做。有人想要我"}, {"type": "subtitle", "time": 19666.07, "timestamp": "05:27:46", "text": "逃跑。是的。我要死了。全部"}, {"type": "subtitle", "time": 19669.19, "timestamp": "05:27:49", "text": "正确的。我要离开他们了。任何"}, {"type": "subtitle", "time": 19671.03, "timestamp": "05:27:51", "text": "有人想看真人版节目吗？"}, {"type": "subtitle", "time": 19674.31, "timestamp": "05:27:54", "text": "快的？是的，我想看这个节目。"}, {"type": "subtitle", "time": 19675.75, "timestamp": "05:27:55", "text": "好的。在哪里？哦，你在哪里？"}, {"type": "subtitle", "time": 19678.708, "timestamp": "05:27:58", "text": "是。正确的。让我们来看看。哪里是哪里是"}]
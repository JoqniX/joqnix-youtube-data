[{"type": "subtitle", "time": 17584.948, "timestamp": "04:53:04", "text": "我没有食物了。那就是"}, {"type": "subtitle", "time": 17586.948, "timestamp": "04:53:06", "text": "我只得到了这些食物。四处走走就能找到"}, {"type": "subtitle", "time": 17589.51, "timestamp": "04:53:09", "text": "食物。你不能只是四处走走"}, {"type": "subtitle", "time": 17591.19, "timestamp": "04:53:11", "text": "就像有颗浆果一样。那里有一颗浆果"}, {"type": "subtitle", "time": 17593.11, "timestamp": "04:53:13", "text": "那边是灌木丛。你可以抓住它"}, {"type": "subtitle", "time": 17596.55, "timestamp": "04:53:16", "text": "事物。在哪里？这边。这边。"}, {"type": "subtitle", "time": 17602.628, "timestamp": "04:53:22", "text": "不。"}, {"type": "subtitle", "time": 17604.55, "timestamp": "04:53:24", "text": "一起。"}, {"type": "subtitle", "time": 17607.99, "timestamp": "04:53:27", "text": "我有吃的。我有吃的。什么？不，我是"}, {"type": "subtitle", "time": 17618.47, "timestamp": "04:53:38", "text": "你可以像在地板上一样吃东西。来"}, {"type": "subtitle", "time": 17621.75, "timestamp": "04:53:41", "text": "在。是的。我得自己去买吃的。"}, {"type": "subtitle", "time": 17623.19, "timestamp": "04:53:43", "text": "我的食物也快吃完了。在"}, {"type": "subtitle", "time": 17625.59, "timestamp": "04:53:45", "text": "最小的怪物"}, {"type": "subtitle", "time": 17627.35, "timestamp": "04:53:47", "text": "你知道吗？和祖基一样，我也不"}, {"type": "subtitle", "time": 17629.35, "timestamp": "04:53:49", "text": "有"}, {"type": "subtitle", "time": 17631.27, "timestamp": "04:53:51", "text": "等待。拿着。拿着。拿着这个，"}, {"type": "subtitle", "time": 17634.708, "timestamp": "04:53:54", "text": "祖基。拿什么？"}, {"type": "subtitle", "time": 17637.19, "timestamp": "04:53:57", "text": "是的，祖基。快点。我打算"}, {"type": "subtitle", "time": 17638.868, "timestamp": "04:53:58", "text": "引领你。我的意思是，乔也会受益。"}]
[{"type": "subtitle", "time": 9364.469, "timestamp": "02:36:04", "text": "只需关注女神的健康。"}, {"type": "subtitle", "time": 9366.87, "timestamp": "02:36:06", "text": "我只要求这些。"}, {"type": "subtitle", "time": 9370.469, "timestamp": "02:36:10", "text": "是的。好的。好的。好的。不，我弄丢了。他"}, {"type": "subtitle", "time": 9395.429, "timestamp": "02:36:35", "text": "我们赢了吗？我们赢了吗？是的，我们赢了。"}, {"type": "subtitle", "time": 9397.75, "timestamp": "02:36:37", "text": "圣。"}, {"type": "subtitle", "time": 9412.3, "timestamp": "02:36:52", "text": "[掌声]"}, {"type": "subtitle", "time": 9415.349, "timestamp": "02:36:55", "text": "[音乐]"}]
[{"type": "subtitle", "time": 12964.71, "timestamp": "03:36:04", "text": "我的天哪。轮到我了。哦，该死。是的。"}, {"type": "subtitle", "time": 12972.309, "timestamp": "03:36:12", "text": "[笑声]"}, {"type": "subtitle", "time": 12975.59, "timestamp": "03:36:15", "text": "你选了一个搞笑的"}, {"type": "subtitle", "time": 12977.269, "timestamp": "03:36:17", "text": "挖。"}, {"type": "subtitle", "time": 12997.03, "timestamp": "03:36:37", "text": "我的名字叫铃木。"}, {"type": "subtitle", "time": 13000.07, "timestamp": "03:36:40", "text": "我今天嗓子疼得厉害，所以没办法"}, {"type": "subtitle", "time": 13002.71, "timestamp": "03:36:42", "text": "正常说话。谢谢。你拿走了"}, {"type": "subtitle", "time": 13003.99, "timestamp": "03:36:43", "text": "漫长而艰辛的事情。这就是原因"}, {"type": "subtitle", "time": 13006.15, "timestamp": "03:36:46", "text": "她的嗓子不太好。"}, {"type": "subtitle", "time": 13008.95, "timestamp": "03:36:48", "text": "铃木的声音听起来总是像……呃……你"}, {"type": "subtitle", "time": 13011.51, "timestamp": "03:36:51", "text": "知道。好吧，我会投入感情。"}, {"type": "subtitle", "time": 13015.19, "timestamp": "03:36:55", "text": "我会倾注情感。总是睡觉"}]
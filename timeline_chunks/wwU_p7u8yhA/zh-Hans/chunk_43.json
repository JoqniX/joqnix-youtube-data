[{"type": "subtitle", "time": 2583.19, "timestamp": "00:43:03", "text": "因为我挂机，所以被踢出游戏了。"}, {"type": "subtitle", "time": 2585.589, "timestamp": "00:43:05", "text": "设置相关内容。"}, {"type": "subtitle", "time": 2592.309, "timestamp": "00:43:12", "text": "所以，是的，以防万一，呃，以防万一，比如"}, {"type": "subtitle", "time": 2595.27, "timestamp": "00:43:15", "text": "它叫什么？欢迎，欢迎，"}, {"type": "subtitle", "time": 2598.23, "timestamp": "00:43:18", "text": "欢迎你，布雷特森。欢迎，欢迎。你好。"}, {"type": "subtitle", "time": 2602.309, "timestamp": "00:43:22", "text": "让我们开始游戏吧。你好。"}, {"type": "subtitle", "time": 2606.63, "timestamp": "00:43:26", "text": "是的。这就是《守望先锋》。我有点"}, {"type": "subtitle", "time": 2609.67, "timestamp": "00:43:29", "text": "我进入游戏后就改变了"}, {"type": "subtitle", "time": 2613.03, "timestamp": "00:43:33", "text": "调整设置。所以，"}, {"type": "subtitle", "time": 2616.55, "timestamp": "00:43:36", "text": "呃，你可以期待……"}, {"type": "subtitle", "time": 2619.51, "timestamp": "00:43:39", "text": "疼痛。"}, {"type": "subtitle", "time": 2621.589, "timestamp": "00:43:41", "text": "是的，我稍微调整了一下。"}, {"type": "subtitle", "time": 2623.75, "timestamp": "00:43:43", "text": "设置之类的，不过嗯，是的，我可能会。"}, {"type": "subtitle", "time": 2627.27, "timestamp": "00:43:47", "text": "需要重启，就像你看到那个红色的“嗯”一样。"}, {"type": "subtitle", "time": 2631.19, "timestamp": "00:43:51", "text": "红色，嗯，就像那边的一条消息一样。"}, {"type": "subtitle", "time": 2634.39, "timestamp": "00:43:54", "text": "顶部。是的。是的。是的。图像质量"}, {"type": "subtitle", "time": 2636.55, "timestamp": "00:43:56", "text": "原本是超高画质，但我把它改成了"}, {"type": "subtitle", "time": 2638.63, "timestamp": "00:43:58", "text": "高的。我可能需要把它改成"}]
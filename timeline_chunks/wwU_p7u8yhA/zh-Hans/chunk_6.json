[{"type": "subtitle", "time": 363.749, "timestamp": "00:06:03", "text": "真是位女王。"}, {"type": "subtitle", "time": 378.79, "timestamp": "00:06:18", "text": "哇。我不知道。我的眼后部"}, {"type": "subtitle", "time": 381.59, "timestamp": "00:06:21", "text": "感觉好像有什么热的东西在碰我。"}, {"type": "subtitle", "time": 384.23, "timestamp": "00:06:24", "text": "我不知道。眼球后部。这"}, {"type": "subtitle", "time": 386.95, "timestamp": "00:06:26", "text": "这就是他们所说的用力。我们训练"}, {"type": "subtitle", "time": 389.029, "timestamp": "00:06:29", "text": "太多了。"}, {"type": "subtitle", "time": 391.83, "timestamp": "00:06:31", "text": "事情就是这样发生的。哦，不。"}, {"type": "subtitle", "time": 394.629, "timestamp": "00:06:34", "text": "哦，慢跑。得照顾好"}, {"type": "subtitle", "time": 396.86, "timestamp": "00:06:36", "text": "你自己。不。"}, {"type": "subtitle", "time": 399.35, "timestamp": "00:06:39", "text": "[音乐]"}, {"type": "subtitle", "time": 401.11, "timestamp": "00:06:41", "text": "你好。"}, {"type": "subtitle", "time": 404.15, "timestamp": "00:06:44", "text": "这是哪里？呃，我们进入正题吧。"}, {"type": "subtitle", "time": 405.67, "timestamp": "00:06:45", "text": "服务器。"}, {"type": "subtitle", "time": 408.469, "timestamp": "00:06:48", "text": "我有点……嗯……和……断开了联系"}, {"type": "subtitle", "time": 412.79, "timestamp": "00:06:52", "text": "因为嗯……所以，我的世界服务器"}, {"type": "subtitle", "time": 415.749, "timestamp": "00:06:55", "text": "因为我"}, {"type": "subtitle", "time": 419.43, "timestamp": "00:06:59", "text": "我亲眼看到自己被藤蔓植物噎死了。爬行者"}]
[{"type": "subtitle", "time": 18120.948, "timestamp": "05:02:00", "text": "会在鬼魂再次出现时通知你。"}, {"type": "subtitle", "time": 18123.51, "timestamp": "05:02:03", "text": "她死了。"}, {"type": "subtitle", "time": 18126.15, "timestamp": "05:02:06", "text": "我要消失了"}, {"type": "subtitle", "time": 18128.868, "timestamp": "05:02:08", "text": "姐姐去世了。"}, {"type": "subtitle", "time": 18132.39, "timestamp": "05:02:12", "text": "哇。哇。不，绝对不可能。夏洛克，什么？"}, {"type": "subtitle", "time": 18134.47, "timestamp": "05:02:14", "text": "给你的主意？"}, {"type": "subtitle", "time": 18140.948, "timestamp": "05:02:20", "text": "啊，你是在我的地盘上种田吗？"}, {"type": "subtitle", "time": 18144.15, "timestamp": "05:02:24", "text": "不，我只是拿走那些树苗。"}, {"type": "subtitle", "time": 18146.47, "timestamp": "05:02:26", "text": "以及浆果灌木。怎么样了？你想"}, {"type": "subtitle", "time": 18149.67, "timestamp": "05:02:29", "text": "帮我杀几个混蛋？"}, {"type": "subtitle", "time": 18150.868, "timestamp": "05:02:30", "text": "好的。好的。我们去杀人吧"}, {"type": "subtitle", "time": 18153.27, "timestamp": "05:02:33", "text": "一些。我们走吧。"}, {"type": "subtitle", "time": 18155.91, "timestamp": "05:02:35", "text": "严肃的。去。有些婊子很弱。"}, {"type": "subtitle", "time": 18157.51, "timestamp": "05:02:37", "text": "我想要你。我有点"}, {"type": "subtitle", "time": 18161.19, "timestamp": "05:02:41", "text": "想要石头。我不知道如何获得"}, {"type": "subtitle", "time": 18163.67, "timestamp": "05:02:43", "text": "骑师。坚持，稍等。好的。是的。我需要"}, {"type": "subtitle", "time": 18165.67, "timestamp": "05:02:45", "text": "制作一把斧子。"}, {"type": "subtitle", "time": 18167.43, "timestamp": "05:02:47", "text": "一把镐。你可以看看那个箱子。"}, {"type": "subtitle", "time": 18169.99, "timestamp": "05:02:49", "text": "那里好像有一些东西。有没有"}, {"type": "subtitle", "time": 18171.67, "timestamp": "05:02:51", "text": "某件物品？"}, {"type": "subtitle", "time": 18173.59, "timestamp": "05:02:53", "text": "铃木牌棍子。稍等片刻。耐心等待即可"}, {"type": "subtitle", "time": 18175.75, "timestamp": "05:02:55", "text": "你妹妹会杀人。我要"}, {"type": "subtitle", "time": 18178.868, "timestamp": "05:02:58", "text": "试着从我手里抢走那些齿轮"}]
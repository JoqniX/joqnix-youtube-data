[{"type": "subtitle", "time": 5236.39, "timestamp": "01:27:16", "text": "这就是人们吹捧的那一套吗？"}, {"type": "subtitle", "time": 5239.03, "timestamp": "01:27:19", "text": "英雄联盟之类的？我不"}, {"type": "subtitle", "time": 5242.39, "timestamp": "01:27:22", "text": "知道原因。太酷了，对吧？"}, {"type": "subtitle", "time": 5244.79, "timestamp": "01:27:24", "text": "[音乐]"}, {"type": "subtitle", "time": 5256.229, "timestamp": "01:27:36", "text": "我正喜欢这样。"}, {"type": "subtitle", "time": 5258.37, "timestamp": "01:27:38", "text": "当然。好的。"}, {"type": "subtitle", "time": 5263.27, "timestamp": "01:27:43", "text": "[音乐]"}, {"type": "subtitle", "time": 5265.99, "timestamp": "01:27:45", "text": "我只是顺道过来看看。我得走了"}, {"type": "subtitle", "time": 5269.669, "timestamp": "01:27:49", "text": "快要睡觉了。嗨，祝你睡个好觉，感谢你的光临。"}, {"type": "subtitle", "time": 5271.51, "timestamp": "01:27:51", "text": "也感谢你尽了全力。"}, {"type": "subtitle", "time": 5273.51, "timestamp": "01:27:53", "text": "今天。"}]
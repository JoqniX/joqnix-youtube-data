[{"type": "subtitle", "time": 13920.15, "timestamp": "03:52:00", "text": "牺牲。"}, {"type": "subtitle", "time": 13923.429, "timestamp": "03:52:03", "text": "快点。这是什么？没关系。什么"}, {"type": "subtitle", "time": 13925.75, "timestamp": "03:52:05", "text": "发生了什么事？"}, {"type": "subtitle", "time": 13927.91, "timestamp": "03:52:07", "text": "嗯？这是什么？我应该做什么？"}, {"type": "subtitle", "time": 13930.309, "timestamp": "03:52:10", "text": "做？别再这样了。我要启动游戏了。"}, {"type": "subtitle", "time": 13933.429, "timestamp": "03:52:13", "text": "等待邀请。问题。妈的，"}, {"type": "subtitle", "time": 13935.269, "timestamp": "03:52:15", "text": "现在是晚上。呃，工艺工艺工艺"}, {"type": "subtitle", "time": 13938.79, "timestamp": "03:52:18", "text": "工艺。等等，你们在游戏里吗？哦，"}, {"type": "subtitle", "time": 13940.469, "timestamp": "03:52:20", "text": "我是"}, {"type": "subtitle", "time": 13943.51, "timestamp": "03:52:23", "text": "加入。跳进去。跳进去。他说道，"}, {"type": "subtitle", "time": 13946.55, "timestamp": "03:52:26", "text": "“舒布，去把他叫来。”"}, {"type": "subtitle", "time": 13950.229, "timestamp": "03:52:30", "text": "你他妈怎么会没明白？"}, {"type": "subtitle", "time": 13954.229, "timestamp": "03:52:34", "text": "如何？我完全没有头绪。我不能。等待，"}, {"type": "subtitle", "time": 13957.91, "timestamp": "03:52:37", "text": "什么？等待。我死了。你如何"}, {"type": "subtitle", "time": 13959.67, "timestamp": "03:52:39", "text": "交朋友？"}, {"type": "subtitle", "time": 13962.79, "timestamp": "03:52:42", "text": "好了，我走了。我如何加入？"}, {"type": "subtitle", "time": 13965.03, "timestamp": "03:52:45", "text": "加入游戏。好的，明白了。知道了。我"}, {"type": "subtitle", "time": 13967.03, "timestamp": "03:52:47", "text": "点击“s”并加入游戏。好的，明白了。"}, {"type": "subtitle", "time": 13970.63, "timestamp": "03:52:50", "text": "它。滞后。它运行速度非常慢。我想"}, {"type": "subtitle", "time": 13972.71, "timestamp": "03:52:52", "text": "托管它。"}, {"type": "subtitle", "time": 13975.51, "timestamp": "03:52:55", "text": "我离你们所有人都最远。你"}, {"type": "subtitle", "time": 13977.99, "timestamp": "03:52:57", "text": "你觉得这样可行吗？"}]
[{"type": "subtitle", "time": 9721.67, "timestamp": "02:42:01", "text": "老兄，我真没想到。"}, {"type": "subtitle", "time": 9747.59, "timestamp": "02:42:27", "text": "盐。"}, {"type": "subtitle", "time": 9761.03, "timestamp": "02:42:41", "text": "呃，就是那个拿左轮手枪的家伙。"}, {"type": "subtitle", "time": 9763.59, "timestamp": "02:42:43", "text": "我希望我能用靴子像你一样爱你"}, {"type": "subtitle", "time": 9773.51, "timestamp": "02:42:53", "text": "我想，哦，是的。你可以给它充电。哦，"}]
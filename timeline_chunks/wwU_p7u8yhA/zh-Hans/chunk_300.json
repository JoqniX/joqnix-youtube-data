[{"type": "subtitle", "time": 18002.868, "timestamp": "05:00:02", "text": "呃，你想跟我一起去吗？我"}, {"type": "subtitle", "time": 18007.11, "timestamp": "05:00:07", "text": "首先需要一个该死的无辜者。"}, {"type": "subtitle", "time": 18011.11, "timestamp": "05:00:11", "text": "我的丝绸，我的呃，你想要，你想要"}, {"type": "subtitle", "time": 18018.31, "timestamp": "05:00:18", "text": "和你，呃，你姐姐。等等，你说什么？"}, {"type": "subtitle", "time": 18020.628, "timestamp": "05:00:20", "text": "你只需要他妈的……好吧，当然。"}, {"type": "subtitle", "time": 18021.99, "timestamp": "05:00:21", "text": "是的。是的。我只需要你杀了他们。"}, {"type": "subtitle", "time": 18023.91, "timestamp": "05:00:23", "text": "和你姐姐一起。这就是我所需要的全部。"}, {"type": "subtitle", "time": 18027.35, "timestamp": "05:00:27", "text": "哪个方向？嗯，就在那儿。"}, {"type": "subtitle", "time": 18029.75, "timestamp": "05:00:29", "text": "好的。因为我一直在务农。"}, {"type": "subtitle", "time": 18031.35, "timestamp": "05:00:31", "text": "好的。"}, {"type": "subtitle", "time": 18034.07, "timestamp": "05:00:34", "text": "哦，不。青蛙。"}, {"type": "subtitle", "time": 18036.47, "timestamp": "05:00:36", "text": "弗罗戈攻击我。或者不是。做完所有"}, {"type": "subtitle", "time": 18039.59, "timestamp": "05:00:39", "text": "我不参与，所以就不工作。不要参与。我"}, {"type": "subtitle", "time": 18042.55, "timestamp": "05:00:42", "text": "重申一遍，不要参与。是的。我正在跑步"}, {"type": "subtitle", "time": 18044.15, "timestamp": "05:00:44", "text": "离开。"}, {"type": "subtitle", "time": 18046.55, "timestamp": "05:00:46", "text": "我来。我来。祖基。我来。灵魂"}, {"type": "subtitle", "time": 18048.628, "timestamp": "05:00:48", "text": "无辜者"}, {"type": "subtitle", "time": 18051.03, "timestamp": "05:00:51", "text": "这边。跟我来。跟我来。哦，"}, {"type": "subtitle", "time": 18053.27, "timestamp": "05:00:53", "text": "这到底是什么怪事？妈的。哦，那里有一个"}, {"type": "subtitle", "time": 18055.91, "timestamp": "05:00:55", "text": "拉屎。他让我把花掉在地上了。带领"}, {"type": "subtitle", "time": 18058.628, "timestamp": "05:00:58", "text": "把青蛙朝你妹妹走去。拿着吧。"}]
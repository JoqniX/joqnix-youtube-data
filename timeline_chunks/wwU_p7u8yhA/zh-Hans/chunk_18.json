[{"type": "subtitle", "time": 1081.19, "timestamp": "00:18:01", "text": "确实如此。哦不，他们就像"}, {"type": "subtitle", "time": 1084.789, "timestamp": "00:18:04", "text": "现在被我吸引了。"}, {"type": "subtitle", "time": 1086.549, "timestamp": "00:18:06", "text": "圣。"}, {"type": "subtitle", "time": 1091.27, "timestamp": "00:18:11", "text": "我等到太阳升起才去吗？"}, {"type": "subtitle", "time": 1093.99, "timestamp": "00:18:13", "text": "至少我还能做到这一点，我想。不，我"}, {"type": "subtitle", "time": 1117.669, "timestamp": "00:18:37", "text": "让我喝点水。等待。"}, {"type": "subtitle", "time": 1120.07, "timestamp": "00:18:40", "text": "还有，大家都要多喝水。别忘了"}, {"type": "subtitle", "time": 1121.75, "timestamp": "00:18:41", "text": "水合物"}]
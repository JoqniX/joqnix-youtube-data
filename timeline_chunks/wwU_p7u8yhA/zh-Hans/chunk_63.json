[{"type": "subtitle", "time": 3782.15, "timestamp": "01:03:02", "text": "我忘记了 I 的接口。"}, {"type": "subtitle", "time": 3798.789, "timestamp": "01:03:18", "text": "是的，我用F1键重新装弹，对吧？所以F2"}, {"type": "subtitle", "time": 3801.43, "timestamp": "01:03:21", "text": "为我"}, {"type": "subtitle", "time": 3803.51, "timestamp": "01:03:23", "text": "尽管"}, {"type": "subtitle", "time": 3806.39, "timestamp": "01:03:26", "text": "按住治疗键增加盟友的伤害。哦"}, {"type": "subtitle", "time": 3809.51, "timestamp": "01:03:29", "text": "我的天，太酷了。我过去常常这样，"}, {"type": "subtitle", "time": 3813.27, "timestamp": "01:03:33", "text": "嗯？好的。"}, {"type": "subtitle", "time": 3822.15, "timestamp": "01:03:42", "text": "坦克英雄。就选他吧。"}, {"type": "subtitle", "time": 3823.829, "timestamp": "01:03:43", "text": "哦。"}]
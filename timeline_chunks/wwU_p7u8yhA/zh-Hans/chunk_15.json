[{"type": "subtitle", "time": 904.79, "timestamp": "00:15:04", "text": "不是那个笨蛋。等等，你知道是哪个笨蛋吗？"}, {"type": "subtitle", "time": 907.03, "timestamp": "00:15:07", "text": "我正在说。好吧，不是那个笨蛋。你"}, {"type": "subtitle", "time": 909.91, "timestamp": "00:15:09", "text": "从动漫中得知。我们的"}, {"type": "subtitle", "time": 913.75, "timestamp": "00:15:13", "text": "kora kora。"}, {"type": "subtitle", "time": 916.55, "timestamp": "00:15:16", "text": "嘿，宝贝。他有东西。是吗？"}, {"type": "subtitle", "time": 920.47, "timestamp": "00:15:20", "text": "一把斧头？等待。那是斧头吗？"}, {"type": "subtitle", "time": 923.189, "timestamp": "00:15:23", "text": "美好的。我会戳一下你的鼠标。我爱"}, {"type": "subtitle", "time": 925.35, "timestamp": "00:15:25", "text": "啵啵。布比。"}, {"type": "subtitle", "time": 928.47, "timestamp": "00:15:28", "text": "至少不是很痛苦。邦"}, {"type": "subtitle", "time": 940.069, "timestamp": "00:15:40", "text": "等等，我应该就站在这里吗？"}, {"type": "subtitle", "time": 943.67, "timestamp": "00:15:43", "text": "其实，待在这里不是更好吗？"}, {"type": "subtitle", "time": 945.75, "timestamp": "00:15:45", "text": "实际上，"}, {"type": "subtitle", "time": 948.55, "timestamp": "00:15:48", "text": "你不可能成为我。不，我不会逃课。"}, {"type": "subtitle", "time": 950.31, "timestamp": "00:15:50", "text": "砰。"}]
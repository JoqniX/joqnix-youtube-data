[{"type": "subtitle", "time": 20044.15, "timestamp": "05:34:04", "text": "我死于什么？嘿，蜘蛛。"}, {"type": "subtitle", "time": 20050.628, "timestamp": "05:34:10", "text": "好的。所有人都死了。大约10天"}, {"type": "subtitle", "time": 20054.15, "timestamp": "05:34:14", "text": "GG的GG。"}, {"type": "subtitle", "time": 20056.548, "timestamp": "05:34:16", "text": "史诗。史诗。"}, {"type": "subtitle", "time": 20066.07, "timestamp": "05:34:26", "text": "那真是太有趣了。那真是太有趣了。"}, {"type": "subtitle", "time": 20067.03, "timestamp": "05:34:27", "text": "那真是太有趣了。那真是"}, {"type": "subtitle", "time": 20070.708, "timestamp": "05:34:30", "text": "乐趣。但绝不再发生。"}, {"type": "subtitle", "time": 20072.23, "timestamp": "05:34:32", "text": "其他人，你们都知道我的感受。"}, {"type": "subtitle", "time": 20081.35, "timestamp": "05:34:41", "text": "我的天，这可不好玩。晚安"}, {"type": "subtitle", "time": 20085.19, "timestamp": "05:34:45", "text": "每个人。晚安。"}, {"type": "subtitle", "time": 20088.868, "timestamp": "05:34:48", "text": "也感谢各位的到来。"}, {"type": "subtitle", "time": 20091.19, "timestamp": "05:34:51", "text": "抱歉，我话不多。这一切都是"}, {"type": "subtitle", "time": 20093.11, "timestamp": "05:34:53", "text": "正确的。你快要被彻底摧毁了。"}, {"type": "subtitle", "time": 20094.868, "timestamp": "05:34:54", "text": "总之。"}, {"type": "subtitle", "time": 20097.99, "timestamp": "05:34:57", "text": "什么？是啊，也许下次我们就不会遇到这种情况了。"}]
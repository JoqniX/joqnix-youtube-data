[{"type": "subtitle", "time": 15000.469, "timestamp": "04:10:00", "text": "太容易了。这也是我对这个问题的看法。"}, {"type": "subtitle", "time": 15001.99, "timestamp": "04:10:01", "text": "我的世界。"}, {"type": "subtitle", "time": 15004.15, "timestamp": "04:10:04", "text": "好的，我要去露营，生篝火。我是"}, {"type": "subtitle", "time": 15008.469, "timestamp": "04:10:08", "text": "来找乔了。天亮了。制作"}, {"type": "subtitle", "time": 15010.71, "timestamp": "04:10:10", "text": "清淡的酱汁。嘿，如果你想做饭"}, {"type": "subtitle", "time": 15013.03, "timestamp": "04:10:13", "text": "我正在准备食物，还要生篝火。是的，制作"}, {"type": "subtitle", "time": 15015.59, "timestamp": "04:10:15", "text": "光。嗯，是的。好的。是的，就是这样。"}, {"type": "subtitle", "time": 15017.91, "timestamp": "04:10:17", "text": "对，到这边去。我来生一堆篝火"}, {"type": "subtitle", "time": 15020.55, "timestamp": "04:10:20", "text": "呃，今晚这样我就可以"}, {"type": "subtitle", "time": 15023.03, "timestamp": "04:10:23", "text": "你看，今天我突然想起来我需要……"}, {"type": "subtitle", "time": 15025.11, "timestamp": "04:10:25", "text": "吃。"}, {"type": "subtitle", "time": 15028.63, "timestamp": "04:10:28", "text": "等等，你的灯灭了。我更倾向于……"}, {"type": "subtitle", "time": 15030.79, "timestamp": "04:10:30", "text": "超级普通的那种人。那个人"}, {"type": "subtitle", "time": 15039.11, "timestamp": "04:10:39", "text": "这里。我来为你点亮一盏灯。等待，"}, {"type": "subtitle", "time": 15041.189, "timestamp": "04:10:41", "text": "我需要草来种它。哦，快来吧！"}, {"type": "subtitle", "time": 15042.71, "timestamp": "04:10:42", "text": "我。"}, {"type": "subtitle", "time": 15044.63, "timestamp": "04:10:44", "text": "留在我身边。"}, {"type": "subtitle", "time": 15048.55, "timestamp": "04:10:48", "text": "是的，我会留下来陪你。"}, {"type": "subtitle", "time": 15056.87, "timestamp": "04:10:56", "text": "我仍然需要"}]
[{"type": "subtitle", "time": 17220.55, "timestamp": "04:47:00", "text": "糟糕，这可真是个错误。哦，我的"}, {"type": "subtitle", "time": 17228.788, "timestamp": "04:47:08", "text": "我很困惑。呃，召唤，召唤你的"}, {"type": "subtitle", "time": 17230.31, "timestamp": "04:47:10", "text": "站起来，然后杀死那只青蛙。"}, {"type": "subtitle", "time": 17231.91, "timestamp": "04:47:11", "text": "那里。"}, {"type": "subtitle", "time": 17235.67, "timestamp": "04:47:15", "text": "如何？呃，右键点击你的花。正确的"}, {"type": "subtitle", "time": 17237.27, "timestamp": "04:47:17", "text": "点击你的花朵。哦，对，你要走了"}, {"type": "subtitle", "time": 17238.948, "timestamp": "04:47:18", "text": "慢慢地被雨水侵蚀。所以"}, {"type": "subtitle", "time": 17247.99, "timestamp": "04:47:27", "text": "糟糕，我忘了这事儿了。"}, {"type": "subtitle", "time": 17250.708, "timestamp": "04:47:30", "text": "你是机器人。别忘了。是的，制作"}, {"type": "subtitle", "time": 17253.59, "timestamp": "04:47:33", "text": "一把用来撑某物的伞。嘿，你可以"}, {"type": "subtitle", "time": 17256.708, "timestamp": "04:47:36", "text": "做把伞。就做一顶草帽就行了。"}, {"type": "subtitle", "time": 17257.91, "timestamp": "04:47:37", "text": "草帽。我不知道如何制作一个"}, {"type": "subtitle", "time": 17260.708, "timestamp": "04:47:40", "text": "草帽。我姐姐设计的。"}, {"type": "subtitle", "time": 17262.47, "timestamp": "04:47:42", "text": "好的。"}, {"type": "subtitle", "time": 17264.708, "timestamp": "04:47:44", "text": "这里。呃，让我点个赞。好的。在哪里"}, {"type": "subtitle", "time": 17266.708, "timestamp": "04:47:46", "text": "是你种的东西吗？呃，"}, {"type": "subtitle", "time": 17268.55, "timestamp": "04:47:48", "text": "那里。那在哪儿？那在哪儿？和"}, {"type": "subtitle", "time": 17271.67, "timestamp": "04:47:51", "text": "那。前往敌人所在的地方。哦"}, {"type": "subtitle", "time": 17274.31, "timestamp": "04:47:54", "text": "上帝。哦"}, {"type": "subtitle", "time": 17277.19, "timestamp": "04:47:57", "text": "我无法理解“好了，我们走吧”。头部呃"}, {"type": "subtitle", "time": 17279.27, "timestamp": "04:47:59", "text": "斧头和我死掉的那个东西"}]
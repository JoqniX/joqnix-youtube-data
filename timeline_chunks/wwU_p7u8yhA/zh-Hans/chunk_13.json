[{"type": "subtitle", "time": 781.829, "timestamp": "00:13:01", "text": "等等，等等。难道不是这样吗？"}, {"type": "subtitle", "time": 783.91, "timestamp": "00:13:03", "text": "等等，等等，等等，等等。你不是来自"}, {"type": "subtitle", "time": 786.629, "timestamp": "00:13:06", "text": "在这个服务器上？你给了我你"}, {"type": "subtitle", "time": 788.79, "timestamp": "00:13:08", "text": "他给了我斧头、铲子之类的东西。"}, {"type": "subtitle", "time": 792.389, "timestamp": "00:13:12", "text": "是的。是的。是的。那是你，对吧？"}, {"type": "subtitle", "time": 794.47, "timestamp": "00:13:14", "text": "对，那就是你。没错，就是你。是的。"}, {"type": "subtitle", "time": 796.949, "timestamp": "00:13:16", "text": "是的。是的。你好吗？"}, {"type": "subtitle", "time": 800.71, "timestamp": "00:13:20", "text": "你今天起得比较早，对吧？希望你"}, {"type": "subtitle", "time": 803.67, "timestamp": "00:13:23", "text": "今天过得很愉快。现在，我们来叫一些……"}, {"type": "subtitle", "time": 806.47, "timestamp": "00:13:26", "text": "更多的。"}, {"type": "subtitle", "time": 814.15, "timestamp": "00:13:34", "text": "好的，我需要一个"}, {"type": "subtitle", "time": 817.03, "timestamp": "00:13:37", "text": "我还在制作过程中。"}, {"type": "subtitle", "time": 821.19, "timestamp": "00:13:41", "text": "这是樱花树生态区。"}, {"type": "subtitle", "time": 823.829, "timestamp": "00:13:43", "text": "手动创建樱花树生态系统。不天然的，"}, {"type": "subtitle", "time": 828.23, "timestamp": "00:13:48", "text": "是的，我们会收到的。做好事。是的。"}, {"type": "subtitle", "time": 831.48, "timestamp": "00:13:51", "text": "你好。你好。你好。"}, {"type": "subtitle", "time": 833.75, "timestamp": "00:13:53", "text": "[音乐]"}, {"type": "subtitle", "time": 837.03, "timestamp": "00:13:57", "text": "希望你的直播一切顺利。是的。"}]
[{"type": "subtitle", "time": 17401.59, "timestamp": "04:50:01", "text": "你姐姐去做这项工作。"}, {"type": "subtitle", "time": 17404.628, "timestamp": "04:50:04", "text": "铃木，就​​在附近。不要逃跑。"}, {"type": "subtitle", "time": 17406.39, "timestamp": "04:50:06", "text": "近，就像在附近，但又不是太近。"}, {"type": "subtitle", "time": 17408.39, "timestamp": "04:50:08", "text": "差不多就是这样。"}, {"type": "subtitle", "time": 17410.15, "timestamp": "04:50:10", "text": "待在附近。"}, {"type": "subtitle", "time": 17424.708, "timestamp": "04:50:24", "text": "我打了他。揍他。"}, {"type": "subtitle", "time": 17428.39, "timestamp": "04:50:28", "text": "揍他。狠狠揍那混蛋一顿。好的。"}, {"type": "subtitle", "time": 17431.99, "timestamp": "04:50:31", "text": "好的。谁需要治愈？我。我要死了，"}, {"type": "subtitle", "time": 17434.868, "timestamp": "04:50:34", "text": "兄弟。别放在心上了。过来。食物。"}, {"type": "subtitle", "time": 17437.59, "timestamp": "04:50:37", "text": "我也需要食物。"}, {"type": "subtitle", "time": 17439.83, "timestamp": "04:50:39", "text": "食物。姐姐，你有个姐姐可以"}, {"type": "subtitle", "time": 17442.31, "timestamp": "04:50:42", "text": "替你杀怪。用它。"}, {"type": "subtitle", "time": 17445.27, "timestamp": "04:50:45", "text": "此外，还需要一段时间来恢复。我得到了更多种子。"}, {"type": "subtitle", "time": 17447.59, "timestamp": "04:50:47", "text": "我要把种子放在这里。耶。"}, {"type": "subtitle", "time": 17449.91, "timestamp": "04:50:49", "text": "疗愈时间。好了，伙计。"}, {"type": "subtitle", "time": 17453.03, "timestamp": "04:50:53", "text": "蜘蛛腺。此外，你还会损失最大"}, {"type": "subtitle", "time": 17455.51, "timestamp": "04:50:55", "text": "顺便说一句，如果你一直死下去，你的健康状况会如何？"}, {"type": "subtitle", "time": 17457.03, "timestamp": "04:50:57", "text": "是的。"}, {"type": "subtitle", "time": 17459.91, "timestamp": "04:50:59", "text": "那我该如何恢复它呢？呃，助推器"}]
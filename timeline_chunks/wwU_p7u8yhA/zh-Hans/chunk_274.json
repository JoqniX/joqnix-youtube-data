[{"type": "subtitle", "time": 16441.349, "timestamp": "04:34:01", "text": "如果你能得到月光石，就可以。"}, {"type": "subtitle", "time": 16444.07, "timestamp": "04:34:04", "text": "并把月亮宠物做得像……"}, {"type": "subtitle", "time": 16445.59, "timestamp": "04:34:05", "text": "月球传送门之类的东西。是吗？"}, {"type": "subtitle", "time": 16447.349, "timestamp": "04:34:07", "text": "真的有这种事吗？糟糕。是的，你"}, {"type": "subtitle", "time": 16449.99, "timestamp": "04:34:09", "text": "能。哦，那真酷。"}, {"type": "subtitle", "time": 16453.029, "timestamp": "04:34:13", "text": "有点贵。"}, {"type": "subtitle", "time": 16458.949, "timestamp": "04:34:18", "text": "等等，你可以用角来对付乌鸦"}, {"type": "subtitle", "time": 16461.51, "timestamp": "04:34:21", "text": "溪流。"}, {"type": "subtitle", "time": 16465.429, "timestamp": "04:34:25", "text": "真的。等等，你可以用喇叭做东西。"}, {"type": "subtitle", "time": 16466.949, "timestamp": "04:34:26", "text": "是的，可以。但请不要这样"}, {"type": "subtitle", "time": 16470.07, "timestamp": "04:34:30", "text": "闹鬼的东西。是啊，别这样。呃，乔，我"}, {"type": "subtitle", "time": 16471.59, "timestamp": "04:34:31", "text": "等等，我能再等等吗？让我看看"}, {"type": "subtitle", "time": 16473.109, "timestamp": "04:34:33", "text": "如果我能再做一个尾巴。我可以"}, {"type": "subtitle", "time": 16475.349, "timestamp": "04:34:35", "text": "再画一个猪，就成了一颗心。得到"}, {"type": "subtitle", "time": 16477.189, "timestamp": "04:34:37", "text": "这边。我正在制作另一个心形。得到"}, {"type": "subtitle", "time": 16479.349, "timestamp": "04:34:39", "text": "这边。好的。是的。"}, {"type": "subtitle", "time": 16486.23, "timestamp": "04:34:46", "text": "这边。呃"}, {"type": "subtitle", "time": 16488.47, "timestamp": "04:34:48", "text": "这里我们还有箱子，顺便说一下，如果你"}, {"type": "subtitle", "time": 16491.109, "timestamp": "04:34:51", "text": "有人想往这里扔垃圾。感谢"}, {"type": "subtitle", "time": 16492.949, "timestamp": "04:34:52", "text": "你。"}, {"type": "subtitle", "time": 16496.709, "timestamp": "04:34:56", "text": "活下来了。呃，爱抓人的手臂。好的，我需要"}]
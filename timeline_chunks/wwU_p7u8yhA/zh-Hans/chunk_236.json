[{"type": "subtitle", "time": 14160.63, "timestamp": "03:56:00", "text": "我就是不打算这么做。穿着"}, {"type": "subtitle", "time": 14164.229, "timestamp": "03:56:04", "text": "兄弟，你今天一丝不挂。"}, {"type": "subtitle", "time": 14166.229, "timestamp": "03:56:06", "text": "等等，你穿裸体服装吗？"}, {"type": "subtitle", "time": 14169.75, "timestamp": "03:56:09", "text": "为你的生日派对准备的吗？哦，"}, {"type": "subtitle", "time": 14172.15, "timestamp": "03:56:12", "text": "对不起，素珊。我就是不知道该怎么做。"}, {"type": "subtitle", "time": 14175.429, "timestamp": "03:56:15", "text": "使用。不，没关系。你不必"}, {"type": "subtitle", "time": 14178.469, "timestamp": "03:56:18", "text": "没事的。我应该这样做吗？不，没关系。"}, {"type": "subtitle", "time": 14181.99, "timestamp": "03:56:21", "text": "不，没关系。没关系。不，没关系。"}, {"type": "subtitle", "time": 14187.269, "timestamp": "03:56:27", "text": "我还是一个人待着吧。这一切都是"}, {"type": "subtitle", "time": 14189.429, "timestamp": "03:56:29", "text": "我不知道怎么操作。你看，确实"}, {"type": "subtitle", "time": 14191.51, "timestamp": "03:56:31", "text": "乔有吗？如果没有，我"}, {"type": "subtitle", "time": 14195.349, "timestamp": "03:56:35", "text": "这下肯定输了。干得好。"}, {"type": "subtitle", "time": 14198.229, "timestamp": "03:56:38", "text": "等等，你什么意思？"}, {"type": "subtitle", "time": 14207.51, "timestamp": "03:56:47", "text": "啊，是的。遭受。"}, {"type": "subtitle", "time": 14209.03, "timestamp": "03:56:49", "text": "此游戏具有自动暂停功能。那是什么？"}, {"type": "subtitle", "time": 14211.51, "timestamp": "03:56:51", "text": "意思是？"}, {"type": "subtitle", "time": 14214.95, "timestamp": "03:56:54", "text": "它的意思就是字面意思。"}, {"type": "subtitle", "time": 14217.83, "timestamp": "03:56:57", "text": "他们现在添加了自动暂停功能。哦，那个"}, {"type": "subtitle", "time": 14219.67, "timestamp": "03:56:59", "text": "听起来很蠢。"}]
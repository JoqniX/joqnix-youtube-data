[{"type": "subtitle", "time": 16020.229, "timestamp": "04:27:00", "text": "好了。它们在右下方。"}, {"type": "subtitle", "time": 16023.11, "timestamp": "04:27:03", "text": "快点。确保没有人死亡。我不"}, {"type": "subtitle", "time": 16025.59, "timestamp": "04:27:05", "text": "我知道我看到了什么。我找到关键所在了。全部"}, {"type": "subtitle", "time": 16027.269, "timestamp": "04:27:07", "text": "正确的。"}, {"type": "subtitle", "time": 16034.95, "timestamp": "04:27:14", "text": "是的。你知道这会蔓延开来。"}, {"type": "subtitle", "time": 16038.149, "timestamp": "04:27:18", "text": "该死的猪村，对吧？哦，是的。如何"}, {"type": "subtitle", "time": 16041.269, "timestamp": "04:27:21", "text": "我该把它熄灭吗？我该如何熄灭它？"}, {"type": "subtitle", "time": 16042.469, "timestamp": "04:27:22", "text": "没关系。没关系。没关系。它是"}, {"type": "subtitle", "time": 16043.51, "timestamp": "04:27:23", "text": "美好的。并非如此。并非如此。它"}, {"type": "subtitle", "time": 16045.11, "timestamp": "04:27:25", "text": "不。你没事。你没事。它"}, {"type": "subtitle", "time": 16047.59, "timestamp": "04:27:27", "text": "不受控制的纵火。受控"}, {"type": "subtitle", "time": 16049.349, "timestamp": "04:27:29", "text": "纵火。控制纵火。是的。控制"}, {"type": "subtitle", "time": 16052.79, "timestamp": "04:27:32", "text": "纵火。纵火案已稳定。我要放弃我的"}, {"type": "subtitle", "time": 16054.87, "timestamp": "04:27:34", "text": "顺便一提，是木头做的。这里。我会把它放好。"}, {"type": "subtitle", "time": 16056.63, "timestamp": "04:27:36", "text": "因为我要开始制作了"}, {"type": "subtitle", "time": 16059.269, "timestamp": "04:27:39", "text": "类似基础用品之类的东西。是的。你们可以"}, {"type": "subtitle", "time": 16061.91, "timestamp": "04:27:41", "text": "谁把弗林给我？"}, {"type": "subtitle", "time": 16063.51, "timestamp": "04:27:43", "text": "是的。你能制造一台科学机器吗？"}, {"type": "subtitle", "time": 16065.51, "timestamp": "04:27:45", "text": "这边？是的。是的。是的。这里。我得到了"}, {"type": "subtitle", "time": 16067.429, "timestamp": "04:27:47", "text": "一些燧石。呃，具体是哪里？你想"}, {"type": "subtitle", "time": 16072.95, "timestamp": "04:27:52", "text": "它就在这里吗？好的。好的。"}, {"type": "subtitle", "time": 16075.75, "timestamp": "04:27:55", "text": "我不知道如何拆分我需要的那个"}, {"type": "subtitle", "time": 16077.429, "timestamp": "04:27:57", "text": "木头。谁能给我一块木头？"}, {"type": "subtitle", "time": 16079.269, "timestamp": "04:27:59", "text": "好了。"}]
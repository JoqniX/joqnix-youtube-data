[{"type": "subtitle", "time": 63.75, "timestamp": "00:01:03", "text": "这是帧崩溃吗？什么？等等，什么？"}, {"type": "subtitle", "time": 67.27, "timestamp": "00:01:07", "text": "等等，什么？这列火车出事了。"}, {"type": "subtitle", "time": 69.35, "timestamp": "00:01:09", "text": "等等，什么？"}, {"type": "subtitle", "time": 72.789, "timestamp": "00:01:12", "text": "我的天哪。我刚从公园出来。"}, {"type": "subtitle", "time": 75.27, "timestamp": "00:01:15", "text": "我的天哪。"}, {"type": "subtitle", "time": 77.429, "timestamp": "00:01:17", "text": "圣。"}, {"type": "subtitle", "time": 81.59, "timestamp": "00:01:21", "text": "我的天哪。不要支持我。"}, {"type": "subtitle", "time": 86.149, "timestamp": "00:01:26", "text": "所以我现在正在用吹风机吹干手。所以不是"}, {"type": "subtitle", "time": 90.55, "timestamp": "00:01:30", "text": "我要撒谎。呃，热水"}, {"type": "subtitle", "time": 92.55, "timestamp": "00:01:32", "text": "确实有帮助。"}, {"type": "subtitle", "time": 96.069, "timestamp": "00:01:36", "text": "我想应该是这样。"}, {"type": "subtitle", "time": 98.069, "timestamp": "00:01:38", "text": "是的，我觉得确实如此。是的，我也这么认为。"}, {"type": "subtitle", "time": 105.91, "timestamp": "00:01:45", "text": "正确的。"}, {"type": "subtitle", "time": 109.19, "timestamp": "00:01:49", "text": "呃，差不多该换衣服了。"}, {"type": "subtitle", "time": 111.50999999999999, "timestamp": "00:01:51", "text": "想象一下骑师的形象。"}, {"type": "subtitle", "time": 115.67, "timestamp": "00:01:55", "text": "但我是一名骑师。"}, {"type": "subtitle", "time": 118.95, "timestamp": "00:01:58", "text": "等着瞧。我是说，"}]
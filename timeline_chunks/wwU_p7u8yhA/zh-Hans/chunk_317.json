[{"type": "subtitle", "time": 19020.07, "timestamp": "05:17:00", "text": "有些蜘蛛也在追着我跑。所以，你"}, {"type": "subtitle", "time": 19022.15, "timestamp": "05:17:02", "text": "可以使用它"}, {"type": "subtitle", "time": 19040.788, "timestamp": "05:17:20", "text": "是哪一款？我听到一声“真他妈的喜欢”。"}, {"type": "subtitle", "time": 19062.39, "timestamp": "05:17:42", "text": "好的，我们再去拿一些。我。我们开始吧"}, {"type": "subtitle", "time": 19065.51, "timestamp": "05:17:45", "text": "别搞砸了。"}, {"type": "subtitle", "time": 19069.11, "timestamp": "05:17:49", "text": "我觉得这样可行。是的。好的。"}, {"type": "subtitle", "time": 19072.55, "timestamp": "05:17:52", "text": "天哪，他们要抓我了。"}, {"type": "subtitle", "time": 19075.27, "timestamp": "05:17:55", "text": "这边。"}, {"type": "subtitle", "time": 19077.27, "timestamp": "05:17:57", "text": "速生松树。哦，拜托。从"}, {"type": "subtitle", "time": 19078.788, "timestamp": "05:17:58", "text": "爬坡道。"}]
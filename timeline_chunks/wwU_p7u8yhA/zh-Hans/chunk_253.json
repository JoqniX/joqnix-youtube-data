[{"type": "subtitle", "time": 15182.95, "timestamp": "04:13:02", "text": "咱们把那玩意儿干掉。是的，我们"}, {"type": "subtitle", "time": 15184.229, "timestamp": "04:13:04", "text": "以后有机会应该再做一次。我们可以"}, {"type": "subtitle", "time": 15186.469, "timestamp": "04:13:06", "text": "播放那个。我们可以去哪里吃饭？因为我没有"}, {"type": "subtitle", "time": 15189.99, "timestamp": "04:13:09", "text": "我想你的意思是。"}, {"type": "subtitle", "time": 15193.349, "timestamp": "04:13:13", "text": "是的，我们干掉了它。我的天哪。我们在哪里"}, {"type": "subtitle", "time": 15196.229, "timestamp": "04:13:16", "text": "疏散？不，我可以吃鸡腿。我"}, {"type": "subtitle", "time": 15198.95, "timestamp": "04:13:18", "text": "只能吃鸡肉。哦，我吃不下东西。"}, {"type": "subtitle", "time": 15199.99, "timestamp": "04:13:19", "text": "我甚至不知道你们在哪里。"}, {"type": "subtitle", "time": 15203.03, "timestamp": "04:13:23", "text": "我现在只是在做边缘包覆。"}, {"type": "subtitle", "time": 15207.51, "timestamp": "04:13:27", "text": "这算什么？哦，你不能。"}, {"type": "subtitle", "time": 15210.149, "timestamp": "04:13:30", "text": "我发现了一个村庄。"}, {"type": "subtitle", "time": 15212.469, "timestamp": "04:13:32", "text": "哦，不错。我们可以把基地设在那附近。"}, {"type": "subtitle", "time": 15215.429, "timestamp": "04:13:35", "text": "地方。我做不到，因为我是个怪物。哦，"}, {"type": "subtitle", "time": 15217.99, "timestamp": "04:13:37", "text": "是的。哦，是的。我还忘了他们"}, {"type": "subtitle", "time": 15221.11, "timestamp": "04:13:41", "text": "他们种族歧视得要命。是的，他们是"}, {"type": "subtitle", "time": 15224.389, "timestamp": "04:13:44", "text": "资本主义和种族主义。"}, {"type": "subtitle", "time": 15227.91, "timestamp": "04:13:47", "text": "招聘公司。我们去找他们吧。不是"}, {"type": "subtitle", "time": 15229.83, "timestamp": "04:13:49", "text": "同性恋，但如果你穿着袜子，它"}, {"type": "subtitle", "time": 15231.91, "timestamp": "04:13:51", "text": "不会。"}, {"type": "subtitle", "time": 15233.91, "timestamp": "04:13:53", "text": "兄弟，你这是在欲罢不能。哦，老兄。我是"}]
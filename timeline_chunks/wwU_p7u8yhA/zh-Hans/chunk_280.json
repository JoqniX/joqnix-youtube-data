[{"type": "subtitle", "time": 16801.19, "timestamp": "04:40:01", "text": "还有人有燧石吗？我的天哪。"}, {"type": "subtitle", "time": 16804.31, "timestamp": "04:40:04", "text": "哦，是的。我得了29分。回来。"}, {"type": "subtitle", "time": 16805.75, "timestamp": "04:40:05", "text": "呃，你把它掉进箱子里了吗？"}, {"type": "subtitle", "time": 16807.51, "timestamp": "04:40:07", "text": "某个地方或者不。哦，不。我来了"}, {"type": "subtitle", "time": 16813.27, "timestamp": "04:40:13", "text": "后退。当当。我的天哪。呃，我需要2。"}, {"type": "subtitle", "time": 16817.91, "timestamp": "04:40:17", "text": "哦，洛基公鸡。我们走吧。洛基公鸡。"}, {"type": "subtitle", "time": 16821.03, "timestamp": "04:40:21", "text": "给我燧石。 Arau Gaming。"}, {"type": "subtitle", "time": 16822.628, "timestamp": "04:40:22", "text": "去。"}, {"type": "subtitle", "time": 16826.788, "timestamp": "04:40:26", "text": "好吧，那是鬼魂。那是鬼魂。"}, {"type": "subtitle", "time": 16831.19, "timestamp": "04:40:31", "text": "我精神彻底崩溃了。妈的。"}, {"type": "subtitle", "time": 16834.07, "timestamp": "04:40:34", "text": "你为什么这么早就提出这个问题？跑步。"}, {"type": "subtitle", "time": 16838.868, "timestamp": "04:40:38", "text": "这只是个小问题。什么？"}, {"type": "subtitle", "time": 16841.27, "timestamp": "04:40:41", "text": "就在这里。这里。弄点儿这个"}, {"type": "subtitle", "time": 16843.99, "timestamp": "04:40:43", "text": "这里有一朵花。把这朵花带回家。它不是"}, {"type": "subtitle", "time": 16845.91, "timestamp": "04:40:45", "text": "太难了。先用诱饵引出第一个。"}, {"type": "subtitle", "time": 16848.868, "timestamp": "04:40:48", "text": "先攻击，然后再击打它。"}, {"type": "subtitle", "time": 16852.47, "timestamp": "04:40:52", "text": "我的天啊，为什么恐怖喙鸟要追我？"}, {"type": "subtitle", "time": 16854.07, "timestamp": "04:40:54", "text": "我没疯。为什么恐怖鸟喙"}, {"type": "subtitle", "time": 16859.51, "timestamp": "04:40:59", "text": "跟我来？不，祖基。不，祖克。"}]
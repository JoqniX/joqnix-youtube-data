[{"type": "subtitle", "time": 17640.868, "timestamp": "04:54:00", "text": "由此。坚持，稍等。就像，你们两个来了"}, {"type": "subtitle", "time": 17643.19, "timestamp": "04:54:03", "text": "大部头书。铃木需要利用她的妹妹"}, {"type": "subtitle", "time": 17645.35, "timestamp": "04:54:05", "text": "更因为她真的可以和她一起打猎"}, {"type": "subtitle", "time": 17647.83, "timestamp": "04:54:07", "text": "姐姐。你也是。跟我来。你们两个。"}, {"type": "subtitle", "time": 17649.59, "timestamp": "04:54:09", "text": "还有，祖基，你应该去拿你的"}, {"type": "subtitle", "time": 17652.708, "timestamp": "04:54:12", "text": "姐姐出去了。永远不要让你妹妹进门。"}, {"type": "subtitle", "time": 17655.03, "timestamp": "04:54:15", "text": "你姐姐简直太棒了"}, {"type": "subtitle", "time": 17656.948, "timestamp": "04:54:16", "text": "有用。好的。然后她就起来了。制作"}, {"type": "subtitle", "time": 17659.43, "timestamp": "04:54:19", "text": "她生气了。惹你妹妹生气。你"}, {"type": "subtitle", "time": 17661.43, "timestamp": "04:54:21", "text": "再次右键单击她，选择“是”。谁的"}, {"type": "subtitle", "time": 17663.75, "timestamp": "04:54:23", "text": "兄弟，你在玩那种滑稽的吸尘器游戏吗？是的。"}, {"type": "subtitle", "time": 17666.788, "timestamp": "04:54:26", "text": "好了。这边。这边。和"}, {"type": "subtitle", "time": 17669.11, "timestamp": "04:54:29", "text": "就只是"}, {"type": "subtitle", "time": 17671.59, "timestamp": "04:54:31", "text": "你就待在附近吧。你姐姐会"}, {"type": "subtitle", "time": 17674.788, "timestamp": "04:54:34", "text": "自动杀死青蛙。靠近"}, {"type": "subtitle", "time": 17676.948, "timestamp": "04:54:36", "text": "青蛙，但不要离得太近。是的，"}, {"type": "subtitle", "time": 17678.31, "timestamp": "04:54:38", "text": "你看，你姐姐要这么做"}, {"type": "subtitle", "time": 17679.59, "timestamp": "04:54:39", "text": "自动地。你会得到食物"}, {"type": "subtitle", "time": 17681.99, "timestamp": "04:54:41", "text": "来自他们。我的天哪。"}, {"type": "subtitle", "time": 17685.51, "timestamp": "04:54:45", "text": "先煮熟再吃。"}, {"type": "subtitle", "time": 17689.99, "timestamp": "04:54:49", "text": "那里。就像在那里，很容易。"}, {"type": "subtitle", "time": 17691.91, "timestamp": "04:54:51", "text": "食物。这不是自动生成的食物。快点。"}, {"type": "subtitle", "time": 17694.55, "timestamp": "04:54:54", "text": "那里。把所有的蛙腿都抓起来。呃，厨师"}, {"type": "subtitle", "time": 17695.99, "timestamp": "04:54:55", "text": "先说他们。就像你饭前那样"}, {"type": "subtitle", "time": 17698.15, "timestamp": "04:54:58", "text": "请先拿走它们。究竟如何"}]
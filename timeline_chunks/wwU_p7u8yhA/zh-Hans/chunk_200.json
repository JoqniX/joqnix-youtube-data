[{"type": "subtitle", "time": 12002.15, "timestamp": "03:20:02", "text": "当时我正在做……呃"}, {"type": "subtitle", "time": 12004.389, "timestamp": "03:20:04", "text": "我第一次录音是……"}, {"type": "subtitle", "time": 12007.19, "timestamp": "03:20:07", "text": "像虚拟录制那样进行录制"}, {"type": "subtitle", "time": 12010.79, "timestamp": "03:20:10", "text": "是时候……该怎么称呼它呢？呃……"}, {"type": "subtitle", "time": 12015.429, "timestamp": "03:20:15", "text": "Vbits，重考30次真是痛苦。"}, {"type": "subtitle", "time": 12018.15, "timestamp": "03:20:18", "text": "有时候或者别的什么，因为我会犯错"}, {"type": "subtitle", "time": 12021.51, "timestamp": "03:20:21", "text": "说话磕磕绊绊，但在直播中"}, {"type": "subtitle", "time": 12025.83, "timestamp": "03:20:25", "text": "直播的时候我不会像我一样……"}, {"type": "subtitle", "time": 12029.269, "timestamp": "03:20:29", "text": "直播时我很有信心能做些事情，但是"}, {"type": "subtitle", "time": 12031.99, "timestamp": "03:20:31", "text": "如果这真的是你的视频，对吧？"}, {"type": "subtitle", "time": 12035.67, "timestamp": "03:20:35", "text": "不知道为什么我总是会变得这么害羞"}, {"type": "subtitle", "time": 12038.95, "timestamp": "03:20:38", "text": "我比较害羞，所以为了避免这种情况，我才能喜欢"}, {"type": "subtitle", "time": 12042.229, "timestamp": "03:20:42", "text": "慢慢开始"}, {"type": "subtitle", "time": 12044.389, "timestamp": "03:20:44", "text": "制作视频之类的东西，然后……"}, {"type": "subtitle", "time": 12048.229, "timestamp": "03:20:48", "text": "嗯，你知道，习惯一下这种方式……"}, {"type": "subtitle", "time": 12050.309, "timestamp": "03:20:50", "text": "制作视频之类的东西，还有剪辑之类的。"}, {"type": "subtitle", "time": 12052.389, "timestamp": "03:20:52", "text": "流程和所有的一切。所以，我会是"}, {"type": "subtitle", "time": 12056.389, "timestamp": "03:20:56", "text": "做这个简短的介绍吧"}]
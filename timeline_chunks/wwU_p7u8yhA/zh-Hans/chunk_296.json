[{"type": "subtitle", "time": 17761.11, "timestamp": "04:56:01", "text": "我们知道你饿了。你有个妹妹"}, {"type": "subtitle", "time": 17762.628, "timestamp": "04:56:02", "text": "那可以帮你消灭怪物，而你"}, {"type": "subtitle", "time": 17765.99, "timestamp": "04:56:05", "text": "可以用来吃屎。是的。是的。我只是"}, {"type": "subtitle", "time": 17768.31, "timestamp": "04:56:08", "text": "我告诉过你如何获取食物。快点。它是"}, {"type": "subtitle", "time": 17770.708, "timestamp": "04:56:10", "text": "死亡并不难，就像不死一样"}, {"type": "subtitle", "time": 17773.19, "timestamp": "04:56:13", "text": "饥饿。快点。我正在获得更多。"}, {"type": "subtitle", "time": 17775.59, "timestamp": "04:56:15", "text": "哦，等等。我需要休息。我"}, {"type": "subtitle", "time": 17779.19, "timestamp": "04:56:19", "text": "我觉得我有一堆SP"}, {"type": "subtitle", "time": 17780.868, "timestamp": "04:56:20", "text": "我先到基地。我不想让你"}, {"type": "subtitle", "time": 17786.07, "timestamp": "04:56:26", "text": "再次死去。去他妈的。我正在制作"}, {"type": "subtitle", "time": 17787.91, "timestamp": "04:56:27", "text": "你要用慢炖锅做菜吗？嗯？"}, {"type": "subtitle", "time": 17790.39, "timestamp": "04:56:30", "text": "我正在制作我是我"}, {"type": "subtitle", "time": 17792.23, "timestamp": "04:56:32", "text": "就此化作幽灵死去吧。事情是这样的。"}, {"type": "subtitle", "time": 17794.948, "timestamp": "04:56:34", "text": "我们可以直接用怪物，就像我不那样。"}, {"type": "subtitle", "time": 17797.83, "timestamp": "04:56:37", "text": "认为你可以以鬼魂的身份死去，黑暗。"}, {"type": "subtitle", "time": 17799.67, "timestamp": "04:56:39", "text": "我只是"}, {"type": "subtitle", "time": 17804.15, "timestamp": "04:56:44", "text": "死两次。我的意思是，如果你想试试的话"}, {"type": "subtitle", "time": 17805.99, "timestamp": "04:56:45", "text": "这，"}, {"type": "subtitle", "time": 17814.39, "timestamp": "04:56:54", "text": "等等，这个能吃吗？吃什么？患病的"}, {"type": "subtitle", "time": 17816.39, "timestamp": "04:56:56", "text": "给你"}, {"type": "subtitle", "time": 17819.59, "timestamp": "04:56:59", "text": "稍微有点滞后。好的，稍等一下。糟糕，"}]
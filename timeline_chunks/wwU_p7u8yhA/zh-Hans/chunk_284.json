[{"type": "subtitle", "time": 17040.788, "timestamp": "04:44:00", "text": "意思是说，最难的部分就像……"}, {"type": "subtitle", "time": 17041.99, "timestamp": "04:44:01", "text": "慢跑者。哦，是的。我将把我的"}, {"type": "subtitle", "time": 17043.91, "timestamp": "04:44:03", "text": "种子。坚持，稍等。好的。直接扔上去就行了。"}, {"type": "subtitle", "time": 17044.708, "timestamp": "04:44:04", "text": "地板我会处理好的。"}, {"type": "subtitle", "time": 17046.07, "timestamp": "04:44:06", "text": "种子。乔会有很多"}, {"type": "subtitle", "time": 17048.868, "timestamp": "04:44:08", "text": "食物方面出了问题。是的。把它放在"}, {"type": "subtitle", "time": 17050.47, "timestamp": "04:44:10", "text": "基地附近的地面，这样我就可以捡起来了"}, {"type": "subtitle", "time": 17053.91, "timestamp": "04:44:13", "text": "向上。在胸口。在胸口。对不起。"}, {"type": "subtitle", "time": 17059.27, "timestamp": "04:44:19", "text": "把它放进箱子里。是的。我 我"}, {"type": "subtitle", "time": 17060.868, "timestamp": "04:44:20", "text": "就这样，我插嘴道：“是啊，我插嘴。”"}, {"type": "subtitle", "time": 17065.19, "timestamp": "04:44:25", "text": "胸部。呃，我们需要丝绸吗？"}, {"type": "subtitle", "time": 17069.35, "timestamp": "04:44:29", "text": "嗯，是的，为了蝴蝶"}, {"type": "subtitle", "time": 17071.11, "timestamp": "04:44:31", "text": "我不确定我应该打开哪个箱子。"}, {"type": "subtitle", "time": 17081.19, "timestamp": "04:44:41", "text": "我需要石头。我该如何找到石头？"}, {"type": "subtitle", "time": 17082.788, "timestamp": "04:44:42", "text": "啊，"}, {"type": "subtitle", "time": 17087.67, "timestamp": "04:44:47", "text": "我的饥饿感又消失了。"}, {"type": "subtitle", "time": 17090.07, "timestamp": "04:44:50", "text": "我仍然没有燧石。我付出了一切"}, {"type": "subtitle", "time": 17093.75, "timestamp": "04:44:53", "text": "我的燧石不见了。哦，这里有一些 Yeah 的作品，"}, {"type": "subtitle", "time": 17096.31, "timestamp": "04:44:56", "text": "只是需要一些工具以备不时之需。"}]
[{"type": "subtitle", "time": 19504.39, "timestamp": "05:25:04", "text": "是的。"}, {"type": "subtitle", "time": 19506.788, "timestamp": "05:25:06", "text": "那只山羊。嘿，你不能追我进不去"}, {"type": "subtitle", "time": 19509.35, "timestamp": "05:25:09", "text": "这里。他妈的。哦，我要死了。哦"}, {"type": "subtitle", "time": 19515.27, "timestamp": "05:25:15", "text": "拉屎。妈的。钥匙在哪儿，贱人？"}, {"type": "subtitle", "time": 19518.07, "timestamp": "05:25:18", "text": "蜘蛛族。哦，是蜘蛛。好的。我"}, {"type": "subtitle", "time": 19520.15, "timestamp": "05:25:20", "text": "抓不到。我们俩都没选它。"}, {"type": "subtitle", "time": 19527.83, "timestamp": "05:25:27", "text": "你说你被困住了是什么意思？不，"}, {"type": "subtitle", "time": 19531.75, "timestamp": "05:25:31", "text": "你并没有被困住。放开我。不。啊。"}, {"type": "subtitle", "time": 19535.43, "timestamp": "05:25:35", "text": "去你的。去你的。"}, {"type": "subtitle", "time": 19537.67, "timestamp": "05:25:37", "text": "你这个混蛋。"}, {"type": "subtitle", "time": 19540.23, "timestamp": "05:25:40", "text": "[音乐]"}, {"type": "subtitle", "time": 19542.07, "timestamp": "05:25:42", "text": "是的。跑步。"}, {"type": "subtitle", "time": 19549.75, "timestamp": "05:25:49", "text": "谁又能说我不能再做一次呢？哦"}, {"type": "subtitle", "time": 19555.11, "timestamp": "05:25:55", "text": "告别。"}, {"type": "subtitle", "time": 19557.11, "timestamp": "05:25:57", "text": "再见。那不是我的本意。"}]
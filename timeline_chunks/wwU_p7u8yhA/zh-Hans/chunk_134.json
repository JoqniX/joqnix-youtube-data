[{"type": "subtitle", "time": 8045.99, "timestamp": "02:14:05", "text": "等等，他为什么？这家伙怎么会……"}, {"type": "subtitle", "time": 8049.27, "timestamp": "02:14:09", "text": "我？嗯？"}, {"type": "subtitle", "time": 8051.75, "timestamp": "02:14:11", "text": "什么？嗯？"}, {"type": "subtitle", "time": 8054.79, "timestamp": "02:14:14", "text": "我有吗？"}, {"type": "subtitle", "time": 8057.189, "timestamp": "02:14:17", "text": "哦，拜托。我们可以将弹药发射得更远。"}, {"type": "subtitle", "time": 8062.629, "timestamp": "02:14:22", "text": "哦，这就是终极技能的作用。好的，"}, {"type": "subtitle", "time": 8074.709, "timestamp": "02:14:34", "text": "我死了，"}, {"type": "subtitle", "time": 8078.149, "timestamp": "02:14:38", "text": "男人。他……他开着他的“砰砰砰砰”枪。"}, {"type": "subtitle", "time": 8085.75, "timestamp": "02:14:45", "text": "疼痛。"}, {"type": "subtitle", "time": 8087.75, "timestamp": "02:14:47", "text": "但我仍然会尽我所能。"}, {"type": "subtitle", "time": 8090.39, "timestamp": "02:14:50", "text": "持霰弹枪的家伙"}]
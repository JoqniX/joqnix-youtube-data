[{"type": "subtitle", "time": 5821.43, "timestamp": "01:37:01", "text": "确实充满挑战，对吧？你是想说玩10局吧。"}, {"type": "subtitle", "time": 5825.43, "timestamp": "01:37:05", "text": "游戏。玩10局游戏，扮演所有角色。什么"}, {"type": "subtitle", "time": 5828.07, "timestamp": "01:37:08", "text": "所有角色都指什么？就像每个人一样"}, {"type": "subtitle", "time": 5830.709, "timestamp": "01:37:10", "text": "所有队友都会像这样"}, {"type": "subtitle", "time": 5834.149, "timestamp": "01:37:14", "text": "坦克突击和支援"}, {"type": "subtitle", "time": 5837.109, "timestamp": "01:37:17", "text": "诸如此类的事情。"}, {"type": "subtitle", "time": 5839.91, "timestamp": "01:37:19", "text": "努娜，"}, {"type": "subtitle", "time": 5842.07, "timestamp": "01:37:22", "text": "看完这场比赛，我也饿了。"}, {"type": "subtitle", "time": 5845.03, "timestamp": "01:37:25", "text": "我先去吃饭了。"}, {"type": "subtitle", "time": 5846.709, "timestamp": "01:37:26", "text": "嗯。"}, {"type": "subtitle", "time": 5861.99, "timestamp": "01:37:41", "text": "反对你的党派。哦，等等。我可以"}, {"type": "subtitle", "time": 5865.43, "timestamp": "01:37:45", "text": "如果我玩的话，实际上会打一场死局。"}, {"type": "subtitle", "time": 5869.83, "timestamp": "01:37:49", "text": "与派对一起。哦，糟糕。五月又名做了"}, {"type": "subtitle", "time": 5872.629, "timestamp": "01:37:52", "text": "你开始玩远程攻击之类的东西"}]
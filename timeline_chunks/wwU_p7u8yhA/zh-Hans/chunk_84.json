[{"type": "subtitle", "time": 5048.07, "timestamp": "01:24:08", "text": "[音乐]"}, {"type": "subtitle", "time": 5068.07, "timestamp": "01:24:28", "text": "源氏，新英雄伤害解锁。"}, {"type": "subtitle", "time": 5071.189, "timestamp": "01:24:31", "text": "源氏呃，岛田已经与……和解了"}, {"type": "subtitle", "time": 5074.149, "timestamp": "01:24:34", "text": "他曾经拒绝的机械身体。并且"}, {"type": "subtitle", "time": 5076.79, "timestamp": "01:24:36", "text": "这样做，他发现了一种更高的境界。"}, {"type": "subtitle", "time": 5078.31, "timestamp": "01:24:38", "text": "人类。"}, {"type": "subtitle", "time": 5081.11, "timestamp": "01:24:41", "text": "哦，"}, {"type": "subtitle", "time": 5091.43, "timestamp": "01:24:51", "text": "哇。"}, {"type": "subtitle", "time": 5095.91, "timestamp": "01:24:55", "text": "哦，我喜欢这个。我喜欢鬼怪。哦，呃。"}, {"type": "subtitle", "time": 5099.189, "timestamp": "01:24:59", "text": "我的天啊。可爱"}]
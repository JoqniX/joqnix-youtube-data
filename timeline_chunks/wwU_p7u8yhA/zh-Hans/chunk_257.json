[{"type": "subtitle", "time": 15421.269, "timestamp": "04:17:01", "text": "这里。因为他重生时，"}, {"type": "subtitle", "time": 15424.55, "timestamp": "04:17:04", "text": "像闪电一样被召唤而来。我击中"}, {"type": "subtitle", "time": 15428.79, "timestamp": "04:17:08", "text": "金库。所以，这就是原因，这就是我"}, {"type": "subtitle", "time": 15430.229, "timestamp": "04:17:10", "text": "被起诉了。所以，我们其实并没有一个"}, {"type": "subtitle", "time": 15431.83, "timestamp": "04:17:11", "text": "选择权在你手中。"}, {"type": "subtitle", "time": 15434.469, "timestamp": "04:17:14", "text": "我能做的最好的就是把它引开。"}, {"type": "subtitle", "time": 15435.91, "timestamp": "04:17:15", "text": "那是唯一的其他情况。"}, {"type": "subtitle", "time": 15438.71, "timestamp": "04:17:18", "text": "解决方案。"}, {"type": "subtitle", "time": 15440.469, "timestamp": "04:17:20", "text": "当你像他们三个一样充电时。"}, {"type": "subtitle", "time": 15442.309, "timestamp": "04:17:22", "text": "是的。我设法把他们引开了。"}, {"type": "subtitle", "time": 15443.91, "timestamp": "04:17:23", "text": "你知道，我打猎，然后把木头粘起来。"}, {"type": "subtitle", "time": 15446.469, "timestamp": "04:17:26", "text": "哦。我想知道这是哪里。"}, {"type": "subtitle", "time": 15454.07, "timestamp": "04:17:34", "text": "松果有什么作用？"}, {"type": "subtitle", "time": 15455.99, "timestamp": "04:17:35", "text": "松果。是的。谁想吃东西？我"}, {"type": "subtitle", "time": 15459.269, "timestamp": "04:17:39", "text": "反正他们通常都会吃灵魂。就是这样。"}, {"type": "subtitle", "time": 15461.11, "timestamp": "04:17:41", "text": "等待。灵魂。"}, {"type": "subtitle", "time": 15465.269, "timestamp": "04:17:45", "text": "是的，我吃灵魂。什么？"}, {"type": "subtitle", "time": 15466.63, "timestamp": "04:17:46", "text": "有人去过右下角吗？"}, {"type": "subtitle", "time": 15468.389, "timestamp": "04:17:48", "text": "门户网站？"}, {"type": "subtitle", "time": 15470.63, "timestamp": "04:17:50", "text": "呃，我不知道右下角在哪里。"}, {"type": "subtitle", "time": 15474.95, "timestamp": "04:17:54", "text": "因为我们使用的是旋转摄像头。是的。"}, {"type": "subtitle", "time": 15477.75, "timestamp": "04:17:57", "text": "好了，孩子们，跟我来。务必"}]
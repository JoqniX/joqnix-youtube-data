[{"type": "subtitle", "time": 14222.229, "timestamp": "03:57:02", "text": "等待。"}, {"type": "subtitle", "time": 14225.67, "timestamp": "03:57:05", "text": "救命啊！发生了什么？哦，不。"}, {"type": "subtitle", "time": 14229.67, "timestamp": "03:57:09", "text": "请自行取用。是的。快点。学习。"}, {"type": "subtitle", "time": 14232.389, "timestamp": "03:57:12", "text": "学习。学习。"}, {"type": "subtitle", "time": 14239.349, "timestamp": "03:57:19", "text": "是的，我们走。"}, {"type": "subtitle", "time": 14241.349, "timestamp": "03:57:21", "text": "哦，不。我派我朋友去了。这是方法"}, {"type": "subtitle", "time": 14243.11, "timestamp": "03:57:23", "text": "比另一个好，但我仍然"}, {"type": "subtitle", "time": 14244.71, "timestamp": "03:57:24", "text": "就像遇到了困难一样。我给你发了一封邮件"}, {"type": "subtitle", "time": 14247.11, "timestamp": "03:57:27", "text": "已收到好友请求。别他妈的"}, {"type": "subtitle", "time": 14248.87, "timestamp": "03:57:28", "text": "我发誓我要去……有很多"}, {"type": "subtitle", "time": 14251.51, "timestamp": "03:57:31", "text": "兔子。很抱歉让您失望了。"}, {"type": "subtitle", "time": 14255.51, "timestamp": "03:57:35", "text": "你。你应该感到抱歉。哦，这就是我的一切"}, {"type": "subtitle", "time": 14259.269, "timestamp": "03:57:39", "text": "我并不失望。我真的非常非常"}, {"type": "subtitle", "time": 14262.15, "timestamp": "03:57:42", "text": "恨。我很失望。"}, {"type": "subtitle", "time": 14269.67, "timestamp": "03:57:49", "text": "哦，这里有很多青蛙。希望你"}, {"type": "subtitle", "time": 14271.11, "timestamp": "03:57:51", "text": "祝你今天工作顺利，比森。"}, {"type": "subtitle", "time": 14272.87, "timestamp": "03:57:52", "text": "顺便一提。是的，祝你今天过得愉快！"}]
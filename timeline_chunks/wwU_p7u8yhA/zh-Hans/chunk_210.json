[{"type": "subtitle", "time": 12617.51, "timestamp": "03:30:17", "text": "我的天哪。这太难了。"}, {"type": "subtitle", "time": 12619.19, "timestamp": "03:30:19", "text": "是的。"}, {"type": "subtitle", "time": 12626.87, "timestamp": "03:30:26", "text": "狗狗们都在聊天。"}, {"type": "subtitle", "time": 12632.469, "timestamp": "03:30:32", "text": "我的天啊，这孩子错过了太多。"}, {"type": "subtitle", "time": 12636.55, "timestamp": "03:30:36", "text": "是的。你好。是的。那些都是神经。"}, {"type": "subtitle", "time": 12647.349, "timestamp": "03:30:47", "text": "混蛋。不，"}, {"type": "subtitle", "time": 12649.75, "timestamp": "03:30:49", "text": "榨干你。"}, {"type": "subtitle", "time": 12652.469, "timestamp": "03:30:52", "text": "你没有"}]
[{"type": "subtitle", "time": 14820.95, "timestamp": "04:07:00", "text": "地上的东西。得到它。得到它。"}, {"type": "subtitle", "time": 14832.87, "timestamp": "04:07:12", "text": "真糟糕。"}, {"type": "subtitle", "time": 14835.75, "timestamp": "04:07:15", "text": "我现在可以摘草了。该死的。机器人"}, {"type": "subtitle", "time": 14837.349, "timestamp": "04:07:17", "text": "再次。为什么我电脑里会有这么多机器人？"}, {"type": "subtitle", "time": 14841.269, "timestamp": "04:07:21", "text": "现在在聊天吗？让我喜欢一下"}, {"type": "subtitle", "time": 14851.429, "timestamp": "04:07:31", "text": "不"}, {"type": "subtitle", "time": 14855.349, "timestamp": "04:07:35", "text": "跑步。那很强劲"}, {"type": "subtitle", "time": 14861.75, "timestamp": "04:07:41", "text": "快跑，快跑。"}, {"type": "subtitle", "time": 14865.51, "timestamp": "04:07:45", "text": "不要接受，不要抗拒。"}, {"type": "subtitle", "time": 14867.83, "timestamp": "04:07:47", "text": "如果有东西追你，就跑。是的，"}, {"type": "subtitle", "time": 14869.429, "timestamp": "04:07:49", "text": "别费劲去反抗了。你们"}, {"type": "subtitle", "time": 14871.349, "timestamp": "04:07:51", "text": "不懂如何放风筝，就别跟他打。"}, {"type": "subtitle", "time": 14873.59, "timestamp": "04:07:53", "text": "是的，他想杀死那只青蛙。"}, {"type": "subtitle", "time": 14874.87, "timestamp": "04:07:54", "text": "交给那些不属于这个范畴的人吧。"}, {"type": "subtitle", "time": 14877.11, "timestamp": "04:07:57", "text": "滞后。"}, {"type": "subtitle", "time": 14878.71, "timestamp": "04:07:58", "text": "交给那些不属于这一类的人吧。"}]
[{"type": "subtitle", "time": 10620.469, "timestamp": "02:57:00", "text": "是的。你好，皮卡丘。快点。快点。"}, {"type": "subtitle", "time": 10622.55, "timestamp": "02:57:02", "text": "好久不见了。"}, {"type": "subtitle", "time": 10624.309, "timestamp": "02:57:04", "text": "你好吗？"}, {"type": "subtitle", "time": 10630.55, "timestamp": "02:57:10", "text": "我真的很喜欢"}, {"type": "subtitle", "time": 10634.469, "timestamp": "02:57:14", "text": "鞠躬，但是，再说一遍，这有点难……"}, {"type": "subtitle", "time": 10654.07, "timestamp": "02:57:34", "text": "不，"}, {"type": "subtitle", "time": 10657.91, "timestamp": "02:57:37", "text": "我总是会遇到那个武士。"}, {"type": "subtitle", "time": 10661.91, "timestamp": "02:57:41", "text": "麦加的机器人武士。我是"}, {"type": "subtitle", "time": 10666.309, "timestamp": "02:57:46", "text": "他每次推我，我都很高兴。我正在做"}, {"type": "subtitle", "time": 10670.79, "timestamp": "02:57:50", "text": "好的。皮卡丘，再选我吧。请确保你"}, {"type": "subtitle", "time": 10673.75, "timestamp": "02:57:53", "text": "休息。"}]
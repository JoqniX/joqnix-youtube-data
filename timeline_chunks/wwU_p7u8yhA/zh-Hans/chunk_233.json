[{"type": "subtitle", "time": 13981.99, "timestamp": "03:53:01", "text": "你以前就试过对我这么做。有时"}, {"type": "subtitle", "time": 13983.51, "timestamp": "03:53:03", "text": "我知道我的电脑性能最强。"}, {"type": "subtitle", "time": 13985.75, "timestamp": "03:53:05", "text": "我们所有人都是如此，但我们以前也尝试过。"}, {"type": "subtitle", "time": 13988.95, "timestamp": "03:53:08", "text": "在一起，但感觉不太对劲。是的。"}, {"type": "subtitle", "time": 13990.469, "timestamp": "03:53:10", "text": "但你我之间的距离是一样的，所以"}, {"type": "subtitle", "time": 13992.229, "timestamp": "03:53:12", "text": "就是这样。但其他人，"}, {"type": "subtitle", "time": 13994.87, "timestamp": "03:53:14", "text": "我不知道。好吧，我们试试。当然。是的，"}, {"type": "subtitle", "time": 13998.309, "timestamp": "03:53:18", "text": "我试试。嗯，我们想要什么？我"}, {"type": "subtitle", "time": 14009.429, "timestamp": "03:53:29", "text": "不，问题不在于选项。这是"}, {"type": "subtitle", "time": 14011.11, "timestamp": "03:53:31", "text": "网络连接。你可能会输"}, {"type": "subtitle", "time": 14013.51, "timestamp": "03:53:33", "text": "连接到服务器。还有我的电脑"}, {"type": "subtitle", "time": 14014.95, "timestamp": "03:53:34", "text": "今天真是糟透了，因为……"}, {"type": "subtitle", "time": 14017.429, "timestamp": "03:53:37", "text": "运行于"}, {"type": "subtitle", "time": 14019.75, "timestamp": "03:53:39", "text": "嗯，上帝。"}, {"type": "subtitle", "time": 14021.349, "timestamp": "03:53:41", "text": "我们正在玩东道主模式。这"}, {"type": "subtitle", "time": 14023.91, "timestamp": "03:53:43", "text": "主持游戏直到我们拿到“我们是”"}, {"type": "subtitle", "time": 14025.67, "timestamp": "03:53:45", "text": "我们正在演奏技术性演奏"}, {"type": "subtitle", "time": 14027.83, "timestamp": "03:53:47", "text": "现在游戏难度很高。是的，"}, {"type": "subtitle", "time": 14030.389, "timestamp": "03:53:50", "text": "游戏出现技术故障。这是"}, {"type": "subtitle", "time": 14032.63, "timestamp": "03:53:52", "text": "真实游戏。我在等。你知道，阿拉，"}, {"type": "subtitle", "time": 14034.07, "timestamp": "03:53:54", "text": "你或许应该玩玩俄罗斯方块"}]
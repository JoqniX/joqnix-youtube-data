[{"type": "subtitle", "time": 3138.79, "timestamp": "00:52:18", "text": "你好。欢迎。欢迎。而且"}, {"type": "subtitle", "time": 3142.87, "timestamp": "00:52:22", "text": "还有，你们也是。欢迎。欢迎。让我"}, {"type": "subtitle", "time": 3147.27, "timestamp": "00:52:27", "text": "也买个《守望先锋》吧。"}, {"type": "subtitle", "time": 3151.03, "timestamp": "00:52:31", "text": "战斗，对吧？这个。好的。复制它。"}, {"type": "subtitle", "time": 3155.589, "timestamp": "00:52:35", "text": "我会通过以下方式发送给你："}, {"type": "subtitle", "time": 3163.27, "timestamp": "00:52:43", "text": "耽误。"}]
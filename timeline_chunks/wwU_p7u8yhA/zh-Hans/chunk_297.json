[{"type": "subtitle", "time": 17821.19, "timestamp": "04:57:01", "text": "那可是块巨型肉啊。拿着吧。哦，"}, {"type": "subtitle", "time": 17825.91, "timestamp": "04:57:05", "text": "等待。祖基。真倒霉。好的。"}, {"type": "subtitle", "time": 17828.55, "timestamp": "04:57:08", "text": "如果你做的话，就是肉丸。所以，没有人"}, {"type": "subtitle", "time": 17830.708, "timestamp": "04:57:10", "text": "死而复生。好的。把你妹妹叫来。得到"}, {"type": "subtitle", "time": 17833.91, "timestamp": "04:57:13", "text": "你姐姐。我需要"}, {"type": "subtitle", "time": 17835.43, "timestamp": "04:57:15", "text": "现在。"}, {"type": "subtitle", "time": 17838.55, "timestamp": "04:57:18", "text": "呃，我忘了，我忘了去哪里拿"}, {"type": "subtitle", "time": 17840.948, "timestamp": "04:57:20", "text": "我的所有东西。"}, {"type": "subtitle", "time": 17842.788, "timestamp": "04:57:22", "text": "你把这里的蜘蛛都打死了吗？"}, {"type": "subtitle", "time": 17844.708, "timestamp": "04:57:24", "text": "这边有蜘蛛。哦，是的。哦，"}, {"type": "subtitle", "time": 17846.948, "timestamp": "04:57:26", "text": "有蜘蛛。"}, {"type": "subtitle", "time": 17849.59, "timestamp": "04:57:29", "text": "呃，别理他们，直接跑。在哪里"}, {"type": "subtitle", "time": 17851.35, "timestamp": "04:57:31", "text": "我应该放吗？我应该把它放在哪里？"}, {"type": "subtitle", "time": 17855.11, "timestamp": "04:57:35", "text": "这边。多只青蛙。"}, {"type": "subtitle", "time": 17858.39, "timestamp": "04:57:38", "text": "蜘蛛。我要回基地了。"}, {"type": "subtitle", "time": 17860.15, "timestamp": "04:57:40", "text": "好的。是的，我们可以做肉丸。"}, {"type": "subtitle", "time": 17863.75, "timestamp": "04:57:43", "text": "现在。好的。那边有只蜘蛛。我不能"}, {"type": "subtitle", "time": 17867.35, "timestamp": "04:57:47", "text": "不能太长。不，"}, {"type": "subtitle", "time": 17868.868, "timestamp": "04:57:48", "text": "等待。"}, {"type": "subtitle", "time": 17872.07, "timestamp": "04:57:52", "text": "蜘蛛在这边。"}, {"type": "subtitle", "time": 17874.31, "timestamp": "04:57:54", "text": "没有火把你会死的。"}]
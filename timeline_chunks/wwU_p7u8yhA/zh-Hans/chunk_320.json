[{"type": "subtitle", "time": 19205.75, "timestamp": "05:20:05", "text": "跑就行了。直接跑回家就行了。等待。呃，"}, {"type": "subtitle", "time": 19209.43, "timestamp": "05:20:09", "text": "寿司，你的计划是……有……有"}, {"type": "subtitle", "time": 19211.59, "timestamp": "05:20:11", "text": "长大了。"}, {"type": "subtitle", "time": 19213.59, "timestamp": "05:20:13", "text": "等等，杰克，你在说什么？你的"}, {"type": "subtitle", "time": 19215.51, "timestamp": "05:20:15", "text": "植物。"}, {"type": "subtitle", "time": 19218.39, "timestamp": "05:20:18", "text": "它们是植物。我的植物们。嘿，"}, {"type": "subtitle", "time": 19220.07, "timestamp": "05:20:20", "text": "后退。"}, {"type": "subtitle", "time": 19221.75, "timestamp": "05:20:21", "text": "我的意思是，如果你愿意，可以随意采摘。"}, {"type": "subtitle", "time": 19224.07, "timestamp": "05:20:24", "text": "想要，因为他们实际上只是在那里……"}, {"type": "subtitle", "time": 19226.23, "timestamp": "05:20:26", "text": "喂饱你们。务必保留"}, {"type": "subtitle", "time": 19227.99, "timestamp": "05:20:27", "text": "箱子里的种子，因为我需要它们"}, {"type": "subtitle", "time": 19229.83, "timestamp": "05:20:29", "text": "种子。"}, {"type": "subtitle", "time": 19232.47, "timestamp": "05:20:32", "text": "哦，宝箱在哪儿？好的，我会保留"}, {"type": "subtitle", "time": 19235.83, "timestamp": "05:20:35", "text": "它压在我的胸口。她出售"}, {"type": "subtitle", "time": 19238.39, "timestamp": "05:20:38", "text": "海岸，但这些贝壳的价值"}, {"type": "subtitle", "time": 19240.708, "timestamp": "05:20:40", "text": "炮弹会落下"}, {"type": "subtitle", "time": 19244.55, "timestamp": "05:20:44", "text": "由于供应中断。"}, {"type": "subtitle", "time": 19247.43, "timestamp": "05:20:47", "text": "我他妈太喜欢了。是啊，真是太……"}, {"type": "subtitle", "time": 19256.39, "timestamp": "05:20:56", "text": "他妈的谁种的茄子种子？"}, {"type": "subtitle", "time": 19258.948, "timestamp": "05:20:58", "text": "不是我。"}]
[{"type": "subtitle", "time": 14641.67, "timestamp": "04:04:01", "text": "这里。弄点哦，s"}, {"type": "subtitle", "time": 14644.79, "timestamp": "04:04:04", "text": "我接受。哦，你明白了。好的，我"}, {"type": "subtitle", "time": 14649.75, "timestamp": "04:04:09", "text": "情况会变得更糟。现在我需要一块石头。你"}, {"type": "subtitle", "time": 14652.07, "timestamp": "04:04:12", "text": "可以食用这种花。"}, {"type": "subtitle", "time": 14654.55, "timestamp": "04:04:14", "text": "这是我的。这朵花不会给你"}, {"type": "subtitle", "time": 14655.91, "timestamp": "04:04:15", "text": "顺便一提，还有饥饿。它只会给你"}, {"type": "subtitle", "time": 14657.429, "timestamp": "04:04:17", "text": "健康。所以我并不建议这样做。它只是"}, {"type": "subtitle", "time": 14667.429, "timestamp": "04:04:27", "text": "不知何故，它对健康有益。我的天啊，"}, {"type": "subtitle", "time": 14670.63, "timestamp": "04:04:30", "text": "这是一根该死的鸡巴。好的。哟，干掉"}, {"type": "subtitle", "time": 14674.309, "timestamp": "04:04:34", "text": "公鸡。是的。再见。这只公鸡跑得太快了。"}, {"type": "subtitle", "time": 14678.229, "timestamp": "04:04:38", "text": "好的。我抓不到鸡巴。"}, {"type": "subtitle", "time": 14680.79, "timestamp": "04:04:40", "text": "它正在下滑。我还是坚持用“它是”。"}, {"type": "subtitle", "time": 14682.71, "timestamp": "04:04:42", "text": "滑倒。"}, {"type": "subtitle", "time": 14685.429, "timestamp": "04:04:45", "text": "保安人员。是的。哦，给你。食物。"}, {"type": "subtitle", "time": 14687.11, "timestamp": "04:04:47", "text": "食物。食物。我的天啊。它也即将到来。"}, {"type": "subtitle", "time": 14689.03, "timestamp": "04:04:49", "text": "对我来说很快。"}, {"type": "subtitle", "time": 14692.309, "timestamp": "04:04:52", "text": "哦，不。时间过得太快了。"}, {"type": "subtitle", "time": 14694.55, "timestamp": "04:04:54", "text": "这里。吃点胡萝卜吧。胡萝卜"}, {"type": "subtitle", "time": 14698.469, "timestamp": "04:04:58", "text": "还有浆果。哦，我们可以吃胡萝卜。"}]
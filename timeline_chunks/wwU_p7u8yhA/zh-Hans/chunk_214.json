[{"type": "subtitle", "time": 12841.11, "timestamp": "03:34:01", "text": "这行字？"}, {"type": "subtitle", "time": 12844.389, "timestamp": "03:34:04", "text": "给我。那是什么？糟糕！"}, {"type": "subtitle", "time": 12854.45, "timestamp": "03:34:14", "text": "请"}, {"type": "subtitle", "time": 12861.11, "timestamp": "03:34:21", "text": "[音乐]"}, {"type": "subtitle", "time": 12864.309, "timestamp": "03:34:24", "text": "我讨厌真的很好。是的。什么？"}, {"type": "subtitle", "time": 12866.229, "timestamp": "03:34:26", "text": "怪物？"}, {"type": "subtitle", "time": 12879.349, "timestamp": "03:34:39", "text": "这不是我们的系列剧。我们"}, {"type": "subtitle", "time": 12889.75, "timestamp": "03:34:49", "text": "这是个精彩的开场白。戈恩。是的。所以，"}, {"type": "subtitle", "time": 12891.349, "timestamp": "03:34:51", "text": "去。"}, {"type": "subtitle", "time": 12892.87, "timestamp": "03:34:52", "text": "不。"}, {"type": "subtitle", "time": 12896.87, "timestamp": "03:34:56", "text": "好的，乔斯。好的。"}, {"type": "subtitle", "time": 12899.59, "timestamp": "03:34:59", "text": "我会求求你。"}]
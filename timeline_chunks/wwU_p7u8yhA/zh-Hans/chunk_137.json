[{"type": "subtitle", "time": 8228.15, "timestamp": "02:17:08", "text": "你有锤子吗？我没有。我"}, {"type": "subtitle", "time": 8231.349, "timestamp": "02:17:11", "text": "我以为我有锤子。"}, {"type": "subtitle", "time": 8269.03, "timestamp": "02:17:49", "text": "我被杀了。"}, {"type": "subtitle", "time": 8271.99, "timestamp": "02:17:51", "text": "我要玩《使命召唤》系列游戏。称呼"}]
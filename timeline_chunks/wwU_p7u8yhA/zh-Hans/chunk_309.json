[{"type": "subtitle", "time": 18541.91, "timestamp": "05:09:01", "text": "哦，我们或许可以稍微修改一下。你"}, {"type": "subtitle", "time": 18544.788, "timestamp": "05:09:04", "text": "可能"}, {"type": "subtitle", "time": 18548.23, "timestamp": "05:09:08", "text": "好的。糟糕。明白了。为什么猪会……"}, {"type": "subtitle", "time": 18554.868, "timestamp": "05:09:14", "text": "[音乐]"}, {"type": "subtitle", "time": 18563.19, "timestamp": "05:09:23", "text": "好吧，我恨你。你太糟糕了。那里"}, {"type": "subtitle", "time": 18565.43, "timestamp": "05:09:25", "text": "你去。"}, {"type": "subtitle", "time": 18568.948, "timestamp": "05:09:28", "text": "我喜欢“哦，真好”这种感觉"}, {"type": "subtitle", "time": 18572.47, "timestamp": "05:09:32", "text": "青蛙。该死的。那是我的癖好。我是"}, {"type": "subtitle", "time": 18575.67, "timestamp": "05:09:35", "text": "对不起。我的癖好"}, {"type": "subtitle", "time": 18579.83, "timestamp": "05:09:39", "text": "石头。是的。呃，"}, {"type": "subtitle", "time": 18581.59, "timestamp": "05:09:41", "text": "这里目前还没有任何东西。我需要喜欢"}, {"type": "subtitle", "time": 18584.31, "timestamp": "05:09:44", "text": "返回基地。是的，没有。我"}, {"type": "subtitle", "time": 18585.83, "timestamp": "05:09:45", "text": "我怀疑他们能否做到。"}, {"type": "subtitle", "time": 18586.868, "timestamp": "05:09:46", "text": "任何事物。他们可能只是要去"}, {"type": "subtitle", "time": 18588.55, "timestamp": "05:09:48", "text": "储存。"}, {"type": "subtitle", "time": 18590.628, "timestamp": "05:09:50", "text": "是的。没有什么。你即将"}, {"type": "subtitle", "time": 18592.23, "timestamp": "05:09:52", "text": "等待。我的意思是，你可以，你可以像这样"}, {"type": "subtitle", "time": 18593.67, "timestamp": "05:09:53", "text": "总是，你知道，呃，就那样吧"}, {"type": "subtitle", "time": 18596.15, "timestamp": "05:09:56", "text": "资源，你知道，会过冬。但"}, {"type": "subtitle", "time": 18597.83, "timestamp": "05:09:57", "text": "然而，他们又不知道该怎么做。"}]
[{"type": "subtitle", "time": 19381.59, "timestamp": "05:23:01", "text": "力量。干得好。就在这里。全部"}, {"type": "subtitle", "time": 19384.47, "timestamp": "05:23:04", "text": "正确的。在这里我们可以玩，因为我情绪低落"}, {"type": "subtitle", "time": 19387.43, "timestamp": "05:23:07", "text": "玩"}, {"type": "subtitle", "time": 19390.23, "timestamp": "05:23:10", "text": "视频稍后奉上。对，妹妹攻击它。"}, {"type": "subtitle", "time": 19393.11, "timestamp": "05:23:13", "text": "好了。"}, {"type": "subtitle", "time": 19395.67, "timestamp": "05:23:15", "text": "那是土壤。是的，有几个。"}, {"type": "subtitle", "time": 19397.99, "timestamp": "05:23:17", "text": "家乡也有怪物肉。是的，"}, {"type": "subtitle", "time": 19399.83, "timestamp": "05:23:19", "text": "我只是因为这样才买更多。"}, {"type": "subtitle", "time": 19402.948, "timestamp": "05:23:22", "text": "总是很好，你知道，对食物来说，而且，你"}, {"type": "subtitle", "time": 19405.59, "timestamp": "05:23:25", "text": "知道了，所以我们才能种植那些呃……东西。"}, {"type": "subtitle", "time": 19410.07, "timestamp": "05:23:30", "text": "之后。我们应该摧毁它吗？"}, {"type": "subtitle", "time": 19411.99, "timestamp": "05:23:31", "text": "我要死了。"}, {"type": "subtitle", "time": 19414.628, "timestamp": "05:23:34", "text": "好的，还有更多。为什么我有两个"}, {"type": "subtitle", "time": 19417.11, "timestamp": "05:23:37", "text": "镐？我的天哪。等等，等等，等等"}, {"type": "subtitle", "time": 19420.55, "timestamp": "05:23:40", "text": "哇。什么？不，我进度落后了。"}, {"type": "subtitle", "time": 19422.39, "timestamp": "05:23:42", "text": "好吧，这确实是个问题。那将会"}, {"type": "subtitle", "time": 19424.788, "timestamp": "05:23:44", "text": "预计"}, {"type": "subtitle", "time": 19426.948, "timestamp": "05:23:46", "text": "感觉我们一直落后了。前往"}, {"type": "subtitle", "time": 19428.948, "timestamp": "05:23:48", "text": "把肉给你。您可以使用"}, {"type": "subtitle", "time": 19432.47, "timestamp": "05:23:52", "text": "这。是的，谢谢。肉食者。上帝"}, {"type": "subtitle", "time": 19434.948, "timestamp": "05:23:54", "text": "该死的。我喜欢吃肉，但是……"}, {"type": "subtitle", "time": 19436.55, "timestamp": "05:23:56", "text": "在。"}, {"type": "subtitle", "time": 19439.35, "timestamp": "05:23:59", "text": "我可以要点吃的吗？呃，我的意思是，"}]
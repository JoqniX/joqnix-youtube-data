[{"type": "subtitle", "time": 13442.389, "timestamp": "03:44:02", "text": "落后。我进度落后了。"}, {"type": "subtitle", "time": 13445.59, "timestamp": "03:44:05", "text": "全力以赴。那是什么？有一个"}, {"type": "subtitle", "time": 13447.59, "timestamp": "03:44:07", "text": "怪物。我的天哪。等等，还有一些"}, {"type": "subtitle", "time": 13453.429, "timestamp": "03:44:13", "text": "主机性能。"}, {"type": "subtitle", "time": 13457.03, "timestamp": "03:44:17", "text": "是的，我的健康状况不太好。该死的"}, {"type": "subtitle", "time": 13459.91, "timestamp": "03:44:19", "text": "它。我的电脑性能不够强。哦，"}, {"type": "subtitle", "time": 13462.87, "timestamp": "03:44:22", "text": "快点。糟糕，我卡住了。但是来了"}, {"type": "subtitle", "time": 13465.59, "timestamp": "03:44:25", "text": "在。我也落后了。什么？等等，为什么？"}, {"type": "subtitle", "time": 13468.55, "timestamp": "03:44:28", "text": "我们为什么要进行这项测试？哦不，我是"}, {"type": "subtitle", "time": 13470.87, "timestamp": "03:44:30", "text": "即将死去。哦，不。我们为什么要进行测试？"}, {"type": "subtitle", "time": 13473.429, "timestamp": "03:44:33", "text": "哦，对。好吧，都是我们的错。只是一个"}, {"type": "subtitle", "time": 13475.51, "timestamp": "03:44:35", "text": "静音。好的，这里有一片绿色的"}, {"type": "subtitle", "time": 13477.99, "timestamp": "03:44:37", "text": "怪物要杀我了。人鱼。什么是"}, {"type": "subtitle", "time": 13481.429, "timestamp": "03:44:41", "text": "那？好的，我们来看看。"}, {"type": "subtitle", "time": 13488.309, "timestamp": "03:44:48", "text": "还可以。嘿，技术方面"}, {"type": "subtitle", "time": 13489.59, "timestamp": "03:44:49", "text": "困难。"}, {"type": "subtitle", "time": 13491.91, "timestamp": "03:44:51", "text": "技术故障。它不是"}, {"type": "subtitle", "time": 13494.95, "timestamp": "03:44:54", "text": "技术故障。更像是"}]
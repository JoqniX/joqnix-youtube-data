[{"type": "subtitle", "time": 18480.788, "timestamp": "05:08:00", "text": "是的。坚持，稍等。我将带你去"}, {"type": "subtitle", "time": 18483.03, "timestamp": "05:08:03", "text": "这个地方。很多。有很多。有"}, {"type": "subtitle", "time": 18484.948, "timestamp": "05:08:04", "text": "很多。你只需要喜欢它就行了"}, {"type": "subtitle", "time": 18487.11, "timestamp": "05:08:07", "text": "疯狂的。这是事实。没错。我"}, {"type": "subtitle", "time": 18491.67, "timestamp": "05:08:11", "text": "简直疯了。我的天哪。真的吗？"}, {"type": "subtitle", "time": 18494.868, "timestamp": "05:08:14", "text": "高兴的。让我让开。我又一次死于一场"}, {"type": "subtitle", "time": 18500.55, "timestamp": "05:08:20", "text": "为什么它们经常出现？就像我曾经那样"}, {"type": "subtitle", "time": 18502.788, "timestamp": "05:08:22", "text": "只打黑色的那个。哦，那个"}, {"type": "subtitle", "time": 18503.91, "timestamp": "05:08:23", "text": "黑色的东西。因为你击中了"}, {"type": "subtitle", "time": 18505.83, "timestamp": "05:08:25", "text": "它们在网络内部。你必须击中"}, {"type": "subtitle", "time": 18508.788, "timestamp": "05:08:28", "text": "网络之外的黑色物体。"}, {"type": "subtitle", "time": 18511.99, "timestamp": "05:08:31", "text": "这边。我会让你感到难以忍受。"}, {"type": "subtitle", "time": 18514.868, "timestamp": "05:08:34", "text": "更多草地。我把所有的草都用光了"}, {"type": "subtitle", "time": 18517.91, "timestamp": "05:08:37", "text": "地狱。呃，为了他妈的，我需要找到"}, {"type": "subtitle", "time": 18521.51, "timestamp": "05:08:41", "text": "草。收集一些草。"}, {"type": "subtitle", "time": 18523.43, "timestamp": "05:08:43", "text": "我已经走在通往草地的路上了"}, {"type": "subtitle", "time": 18525.91, "timestamp": "05:08:45", "text": "这是个领域，所以我会努力研究它。我记得我"}, {"type": "subtitle", "time": 18528.628, "timestamp": "05:08:48", "text": "像一堆草一样，但那里"}, {"type": "subtitle", "time": 18530.868, "timestamp": "05:08:50", "text": "是。我弄到了一大堆，但是哦"}, {"type": "subtitle", "time": 18536.15, "timestamp": "05:08:56", "text": "哎呀。好的。可以"}, {"type": "subtitle", "time": 18539.27, "timestamp": "05:08:59", "text": "在基地。"}]
[{"type": "subtitle", "time": 15660.79, "timestamp": "04:21:00", "text": "寻找石头。说实话，我从来没有"}, {"type": "subtitle", "time": 15663.03, "timestamp": "04:21:03", "text": "就像在传送门附近一样。如果"}, {"type": "subtitle", "time": 15664.469, "timestamp": "04:21:04", "text": "你回到传送门，那里有一个"}, {"type": "subtitle", "time": 15667.429, "timestamp": "04:21:07", "text": "右侧有一堆石头。还，"}, {"type": "subtitle", "time": 15672.87, "timestamp": "04:21:12", "text": "我几乎需要喜欢所有活着的人"}, {"type": "subtitle", "time": 15674.87, "timestamp": "04:21:14", "text": "日志。哦，青蛙正在杀死……"}, {"type": "subtitle", "time": 15678.79, "timestamp": "04:21:18", "text": "蜘蛛。哦，糟糕，我们可以……"}, {"type": "subtitle", "time": 15680.469, "timestamp": "04:21:20", "text": "是啊，我就让那些该死的青蛙们……"}, {"type": "subtitle", "time": 15682.469, "timestamp": "04:21:22", "text": "杀死蜘蛛。"}, {"type": "subtitle", "time": 15689.269, "timestamp": "04:21:29", "text": "好的，右边还有更多黄金。应该是"}, {"type": "subtitle", "time": 15691.67, "timestamp": "04:21:31", "text": "好的。它们还没有脱落腺体。"}, {"type": "subtitle", "time": 15694.07, "timestamp": "04:21:34", "text": "不过他们已经不再供应肉类了。我要去"}, {"type": "subtitle", "time": 15695.91, "timestamp": "04:21:35", "text": "让猪和蜘蛛打架。"}, {"type": "subtitle", "time": 15699.11, "timestamp": "04:21:39", "text": "正如你所想的那样。嘿，GL。得到一个"}, {"type": "subtitle", "time": 15701.11, "timestamp": "04:21:41", "text": "腺。我让……我让……"}, {"type": "subtitle", "time": 15703.91, "timestamp": "04:21:43", "text": "就像青蛙反过来杀死他一样，因为那样……"}, {"type": "subtitle", "time": 15706.71, "timestamp": "04:21:46", "text": "感觉容易多了。在游戏中，你有"}, {"type": "subtitle", "time": 15708.63, "timestamp": "04:21:48", "text": "到"}, {"type": "subtitle", "time": 15710.389, "timestamp": "04:21:50", "text": "营。你们为什么会有这个"}, {"type": "subtitle", "time": 15712.229, "timestamp": "04:21:52", "text": "营火？是的，我们没有这个"}, {"type": "subtitle", "time": 15714.71, "timestamp": "04:21:54", "text": "篝火复活。"}, {"type": "subtitle", "time": 15716.229, "timestamp": "04:21:56", "text": "是的，"}, {"type": "subtitle", "time": 15717.189, "timestamp": "04:21:57", "text": "这大概是我经历过的一件事。"}, {"type": "subtitle", "time": 15718.71, "timestamp": "04:21:58", "text": "记住，死亡永远不是终点。那是"}]
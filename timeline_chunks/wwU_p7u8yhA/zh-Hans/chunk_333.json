[{"type": "subtitle", "time": 19981.43, "timestamp": "05:33:01", "text": "[音乐]"}, {"type": "subtitle", "time": 19984.31, "timestamp": "05:33:04", "text": "这条狗在追我。"}, {"type": "subtitle", "time": 19986.788, "timestamp": "05:33:06", "text": "火势开始蔓延。"}, {"type": "subtitle", "time": 19993.27, "timestamp": "05:33:13", "text": "火势很旺。"}, {"type": "subtitle", "time": 19997.51, "timestamp": "05:33:17", "text": "6,000。我的天哪，这也太多了吧。"}, {"type": "subtitle", "time": 20001.03, "timestamp": "05:33:21", "text": "哦，本在和汉斯打架。哦，"}, {"type": "subtitle", "time": 20004.07, "timestamp": "05:33:24", "text": "直播不错，伙计们。隐藏与喜欢"}, {"type": "subtitle", "time": 20016.95, "timestamp": "05:33:36", "text": "生活。是的。"}, {"type": "subtitle", "time": 20018.628, "timestamp": "05:33:38", "text": "[音乐]"}, {"type": "subtitle", "time": 20023.03, "timestamp": "05:33:43", "text": "驴子大战蜘蛛。死于蜘蛛咬伤。"}, {"type": "subtitle", "time": 20024.788, "timestamp": "05:33:44", "text": "实际上可以。你可以。我要"}, {"type": "subtitle", "time": 20026.31, "timestamp": "05:33:46", "text": "死于蜘蛛之口。我要去"}, {"type": "subtitle", "time": 20038.07, "timestamp": "05:33:58", "text": "你去砸东西。他这话是什么意思？"}]
[{"type": "subtitle", "time": 13143.269, "timestamp": "03:39:03", "text": "呃，她是个纵火狂。你将获得"}, {"type": "subtitle", "time": 13145.91, "timestamp": "03:39:05", "text": "烈火中恢复理智。你的熊想要"}, {"type": "subtitle", "time": 13147.51, "timestamp": "03:39:07", "text": "你基本上就是《联盟》里的安妮"}, {"type": "subtitle", "time": 13150.389, "timestamp": "03:39:10", "text": "传奇人物。"}, {"type": "subtitle", "time": 13153.429, "timestamp": "03:39:13", "text": "英雄联盟。哦，是的。基本的"}, {"type": "subtitle", "time": 13155.67, "timestamp": "03:39:15", "text": "基本上，如果你疯了，就直接扔吧。"}, {"type": "subtitle", "time": 13157.429, "timestamp": "03:39:17", "text": "把你的泰迪熊放在地上。它"}, {"type": "subtitle", "time": 13161.269, "timestamp": "03:39:21", "text": "它他妈的能帮你干掉所有东西。哦，"}, {"type": "subtitle", "time": 13164.55, "timestamp": "03:39:24", "text": "就像一颗即将引爆的炸弹。他是俄罗斯人。你"}, {"type": "subtitle", "time": 13165.91, "timestamp": "03:39:25", "text": "你已经知道俄罗斯人会做什么了。我"}, {"type": "subtitle", "time": 13167.19, "timestamp": "03:39:27", "text": "无需解释俄罗斯人是什么。"}, {"type": "subtitle", "time": 13170.469, "timestamp": "03:39:30", "text": "是的。是的。他是大力士。她有"}, {"type": "subtitle", "time": 13173.269, "timestamp": "03:39:33", "text": "一个支架。"}, {"type": "subtitle", "time": 13175.03, "timestamp": "03:39:35", "text": "她拥有替身，可以替她杀人。"}, {"type": "subtitle", "time": 13181.429, "timestamp": "03:39:41", "text": "Wix。他喜欢吃齿轮。"}, {"type": "subtitle", "time": 13187.75, "timestamp": "03:39:47", "text": "呃，藤编底座。她，她是个行走的"}, {"type": "subtitle", "time": 13191.75, "timestamp": "03:39:51", "text": "工作台。她年纪也大了。"}, {"type": "subtitle", "time": 13194.95, "timestamp": "03:39:54", "text": "一位老太太。"}]
[{"type": "subtitle", "time": 6064.47, "timestamp": "01:41:04", "text": "哦，她来救我了。她来救我了。哦"}, {"type": "subtitle", "time": 6066.95, "timestamp": "01:41:06", "text": "我的上帝。她只是"}, {"type": "subtitle", "time": 6070.48, "timestamp": "01:41:10", "text": "我的天啊。"}, {"type": "subtitle", "time": 6070.95, "timestamp": "01:41:10", "text": "[掌声]"}, {"type": "subtitle", "time": 6105.109, "timestamp": "01:41:45", "text": "真是愚蠢。被困住了"}, {"type": "subtitle", "time": 6109.43, "timestamp": "01:41:49", "text": "那家伙简直就是个坦克。好的，"}, {"type": "subtitle", "time": 6112.149, "timestamp": "01:41:52", "text": "这越来越难了，因为这是我自己的选择。"}]
[{"type": "subtitle", "time": 10263.269, "timestamp": "02:51:03", "text": "不，是我除掉了他。哦，等等。绝不"}, {"type": "subtitle", "time": 10266.23, "timestamp": "02:51:06", "text": "头脑。我是一名助攻手。"}, {"type": "subtitle", "time": 10268.23, "timestamp": "02:51:08", "text": "但是，我的天哪，"}, {"type": "subtitle", "time": 10270.469, "timestamp": "02:51:10", "text": "我会习惯的。我不会发出“砰砰”声"}, {"type": "subtitle", "time": 10288.389, "timestamp": "02:51:28", "text": "[音乐]"}]
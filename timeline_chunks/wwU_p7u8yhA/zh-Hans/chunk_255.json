[{"type": "subtitle", "time": 15301.189, "timestamp": "04:15:01", "text": "给你喂点运动饮料。让我喂你吃点东西"}, {"type": "subtitle", "time": 15304.87, "timestamp": "04:15:04", "text": "胡萝卜。哦，你不能吃胡萝卜。"}, {"type": "subtitle", "time": 15307.03, "timestamp": "04:15:07", "text": "胡萝卜。他是肉食主义者。他吃不下东西"}, {"type": "subtitle", "time": 15309.03, "timestamp": "04:15:09", "text": "任何。"}, {"type": "subtitle", "time": 15312.87, "timestamp": "04:15:12", "text": "哦，不。啊，你得自己宰杀你的肉。"}, {"type": "subtitle", "time": 15314.71, "timestamp": "04:15:14", "text": "给他，给他鸡巴。给他"}, {"type": "subtitle", "time": 15317.59, "timestamp": "04:15:17", "text": "公鸡。对，给他鸡巴。"}, {"type": "subtitle", "time": 15319.75, "timestamp": "04:15:19", "text": "把怪物给他。我把公鸡给了"}, {"type": "subtitle", "time": 15322.95, "timestamp": "04:15:22", "text": "祖基。等待，"}, {"type": "subtitle", "time": 15325.59, "timestamp": "04:15:25", "text": "种子。兄弟，我喜欢你的种子。不，不"}, {"type": "subtitle", "time": 15328.63, "timestamp": "04:15:28", "text": "不。那根鼓槌，你可以拿走，我给你的"}, {"type": "subtitle", "time": 15336.87, "timestamp": "04:15:36", "text": "终于快到传送门了。我的意思是，不是"}, {"type": "subtitle", "time": 15345.269, "timestamp": "04:15:45", "text": "我在传送门那里。我是"}, {"type": "subtitle", "time": 15350.309, "timestamp": "04:15:50", "text": "我还没找到黄金。 F."}, {"type": "subtitle", "time": 15353.11, "timestamp": "04:15:53", "text": "是啊，我也是。这有点奇怪"}, {"type": "subtitle", "time": 15358.71, "timestamp": "04:15:58", "text": "下面有一张边缘图。我不认为这是"}]
[{"type": "subtitle", "time": 5104.39, "timestamp": "01:25:04", "text": "恶魔也是。强力游侠。源氏。"}, {"type": "subtitle", "time": 5106.149, "timestamp": "01:25:06", "text": "太可爱了。"}, {"type": "subtitle", "time": 5108.629, "timestamp": "01:25:08", "text": "是的。你好。特别版。你怎么样"}, {"type": "subtitle", "time": 5113.59, "timestamp": "01:25:13", "text": "正在做？这是武士主题的。"}, {"type": "subtitle", "time": 5116.31, "timestamp": "01:25:16", "text": "不，源氏。是源氏。对，就是这样。"}, {"type": "subtitle", "time": 5119.51, "timestamp": "01:25:19", "text": "我说。"}, {"type": "subtitle", "time": 5123.11, "timestamp": "01:25:23", "text": "通过英雄挑战解锁。什么是"}, {"type": "subtitle", "time": 5126.629, "timestamp": "01:25:26", "text": "英雄挑战？"}, {"type": "subtitle", "time": 5133.83, "timestamp": "01:25:33", "text": "英雄挑战。完成两场比赛"}, {"type": "subtitle", "time": 5136.95, "timestamp": "01:25:36", "text": "释放你的天后潜能。哦，等等。所以，完成了"}, {"type": "subtitle", "time": 5140.149, "timestamp": "01:25:40", "text": "九场比赛赢了双料冠军"}, {"type": "subtitle", "time": 5142.31, "timestamp": "01:25:42", "text": "进步。哦好的。好的。所以，为了"}, {"type": "subtitle", "time": 5145.669, "timestamp": "01:25:45", "text": "要解锁半藏，我需要完成九项任务。"}, {"type": "subtitle", "time": 5151.189, "timestamp": "01:25:51", "text": "游戏。好的。是时候努力奋斗了。"}]
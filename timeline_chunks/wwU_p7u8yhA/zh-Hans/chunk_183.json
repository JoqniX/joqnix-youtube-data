[{"type": "subtitle", "time": 10990.79, "timestamp": "03:03:10", "text": "我终于解锁了弓箭手角色。"}, {"type": "subtitle", "time": 10994.23, "timestamp": "03:03:14", "text": "我真的超级兴奋。"}, {"type": "subtitle", "time": 10995.99, "timestamp": "03:03:15", "text": "但这其实有点难。每个人"}, {"type": "subtitle", "time": 11000.23, "timestamp": "03:03:20", "text": "在你拿到那玩意儿的时候，我会火力全开。"}, {"type": "subtitle", "time": 11002.87, "timestamp": "03:03:22", "text": "一枪爆头。它是免费的。是的，"}, {"type": "subtitle", "time": 11027.67, "timestamp": "03:03:47", "text": "哦，等等。"}, {"type": "subtitle", "time": 11031.11, "timestamp": "03:03:51", "text": "我可以做到。哇。"}]
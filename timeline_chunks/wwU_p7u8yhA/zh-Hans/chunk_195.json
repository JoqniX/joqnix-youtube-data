[{"type": "subtitle", "time": 11700.55, "timestamp": "03:15:00", "text": "希望你们好好照顾自己。"}, {"type": "subtitle", "time": 11702.309, "timestamp": "03:15:02", "text": "你们自己。我的天啊。发生了什么事"}, {"type": "subtitle", "time": 11705.269, "timestamp": "03:15:05", "text": "追踪？"}, {"type": "subtitle", "time": 11708.87, "timestamp": "03:15:08", "text": "我的天啊，眼动追踪！哦，"}, {"type": "subtitle", "time": 11711.91, "timestamp": "03:15:11", "text": "是因为我戴眼镜吗？相同"}, {"type": "subtitle", "time": 11717.269, "timestamp": "03:15:17", "text": "狗狗戴眼镜是因为我快死了。"}, {"type": "subtitle", "time": 11719.53, "timestamp": "03:15:19", "text": "我的天啊。所以我现在在开车。"}, {"type": "subtitle", "time": 11731.03, "timestamp": "03:15:31", "text": "那我们明天见。"}, {"type": "subtitle", "time": 11733.51, "timestamp": "03:15:33", "text": "哦，下一期还有明天也是。"}, {"type": "subtitle", "time": 11735.91, "timestamp": "03:15:35", "text": "星期六，那意味着下周。"}, {"type": "subtitle", "time": 11739.67, "timestamp": "03:15:39", "text": "安排发布日期，好的，我会的。"}, {"type": "subtitle", "time": 11741.91, "timestamp": "03:15:41", "text": "我正在准备明天的日程安排。"}, {"type": "subtitle", "time": 11744.63, "timestamp": "03:15:44", "text": "明天上传，内容大概是……"}, {"type": "subtitle", "time": 11749.11, "timestamp": "03:15:49", "text": "可在 Discord 上找到，镀金的，呃，谷歌"}, {"type": "subtitle", "time": 11752.55, "timestamp": "03:15:52", "text": "如果您正在查看日历和 Twitter，请点击此处。"}, {"type": "subtitle", "time": 11755.51, "timestamp": "03:15:55", "text": "通过 Reddit 上的子版块"}, {"type": "subtitle", "time": 11757.83, "timestamp": "03:15:57", "text": "Reddit 我们有一个子版块"}]
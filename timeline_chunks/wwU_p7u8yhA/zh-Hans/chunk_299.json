[{"type": "subtitle", "time": 17945.27, "timestamp": "04:59:05", "text": "游戏玩家。"}, {"type": "subtitle", "time": 17948.628, "timestamp": "04:59:08", "text": "我的东西就在蜘蛛附近。好的。"}, {"type": "subtitle", "time": 17959.27, "timestamp": "04:59:19", "text": "还没有。蜘蛛。"}, {"type": "subtitle", "time": 17961.75, "timestamp": "04:59:21", "text": "哦，谢谢。靠近火源。我是"}, {"type": "subtitle", "time": 17963.99, "timestamp": "04:59:23", "text": "感觉就像我要再做一个一样。"}, {"type": "subtitle", "time": 17970.628, "timestamp": "04:59:30", "text": "对此我深感抱歉。"}, {"type": "subtitle", "time": 17973.43, "timestamp": "04:59:33", "text": "是的。是的。哦，该死的。我我有"}, {"type": "subtitle", "time": 17979.91, "timestamp": "04:59:39", "text": "我手里拿着锤子。对不起。"}, {"type": "subtitle", "time": 17981.91, "timestamp": "04:59:41", "text": "我先把锤子收起来。她在那里"}, {"type": "subtitle", "time": 17983.43, "timestamp": "04:59:43", "text": "走了。"}, {"type": "subtitle", "time": 17987.03, "timestamp": "04:59:47", "text": "我打算给我们准备一些齿轮。"}, {"type": "subtitle", "time": 17989.75, "timestamp": "04:59:49", "text": "我的手还好。过来。得到"}, {"type": "subtitle", "time": 17993.91, "timestamp": "04:59:53", "text": "如果你想让我帮你休息，就过来这边。呃"}, {"type": "subtitle", "time": 17996.31, "timestamp": "04:59:56", "text": "妈的。呃，你能治好我吗？我只是"}, {"type": "subtitle", "time": 17999.35, "timestamp": "04:59:59", "text": "我意识到我没有灵魂。妈的。"}]
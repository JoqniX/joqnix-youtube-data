[{"type": "subtitle", "time": 16382.07, "timestamp": "04:33:02", "text": "你们有吗？我没有，我需要我给了"}, {"type": "subtitle", "time": 16384.31, "timestamp": "04:33:04", "text": "我所有的朋友都对Zuki说，我想我"}, {"type": "subtitle", "time": 16386.15, "timestamp": "04:33:06", "text": "应该有一些。我很快就要回去了。"}, {"type": "subtitle", "time": 16390.709, "timestamp": "04:33:10", "text": "呃，Jnix。哦，我会死的。那些是我的否"}, {"type": "subtitle", "time": 16393.029, "timestamp": "04:33:13", "text": "不。不要再死了。你在干什么？"}, {"type": "subtitle", "time": 16400.869, "timestamp": "04:33:20", "text": "他迫不及待地想要上场。"}, {"type": "subtitle", "time": 16402.709, "timestamp": "04:33:22", "text": "至少还有蜘蛛。哟，他是"}, {"type": "subtitle", "time": 16406.869, "timestamp": "04:33:26", "text": "输给了游戏的名字，兄弟。我知道。"}, {"type": "subtitle", "time": 16413.91, "timestamp": "04:33:33", "text": "不要这样做。还有，你他妈的为什么要这么做？"}, {"type": "subtitle", "time": 16415.429, "timestamp": "04:33:35", "text": "铃木，要不要生个篝火？我们有一个"}, {"type": "subtitle", "time": 16418.47, "timestamp": "04:33:38", "text": "该死的火坑。是的，我没有"}, {"type": "subtitle", "time": 16421.67, "timestamp": "04:33:41", "text": "就在这里。铃木，就​​在蜘蛛里。"}, {"type": "subtitle", "time": 16423.51, "timestamp": "04:33:43", "text": "是，过来。过来。至少我"}, {"type": "subtitle", "time": 16425.83, "timestamp": "04:33:45", "text": "我不这么认为。只需在此处输入日志即可"}, {"type": "subtitle", "time": 16431.349, "timestamp": "04:33:51", "text": "再见。"}, {"type": "subtitle", "time": 16433.269, "timestamp": "04:33:53", "text": "把木头放进去。等等，我可以切换吗？"}, {"type": "subtitle", "time": 16437.109, "timestamp": "04:33:57", "text": "角色？不。对。不。"}, {"type": "subtitle", "time": 16439.109, "timestamp": "04:33:59", "text": "哦，好痛。我为什么会选择红头发的那个人？"}]
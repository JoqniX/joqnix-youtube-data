[{"type": "subtitle", "time": 18901.91, "timestamp": "05:15:01", "text": "应该在胸口。好的。"}, {"type": "subtitle", "time": 18905.03, "timestamp": "05:15:05", "text": "上面全是垃圾。我向上帝发誓。"}, {"type": "subtitle", "time": 18907.35, "timestamp": "05:15:07", "text": "等等，稍等。等待。"}, {"type": "subtitle", "time": 18910.07, "timestamp": "05:15:10", "text": "妈的。我的木头去哪儿了？在哪里？"}, {"type": "subtitle", "time": 18912.788, "timestamp": "05:15:12", "text": "我的木头？我的木头呢？我的在哪里？"}, {"type": "subtitle", "time": 18918.39, "timestamp": "05:15:18", "text": "你们都他妈的开始点灯吧"}, {"type": "subtitle", "time": 18922.07, "timestamp": "05:15:22", "text": "里面。该死的婊子们。"}, {"type": "subtitle", "time": 18923.75, "timestamp": "05:15:23", "text": "好了，我身体上正在恢复"}, {"type": "subtitle", "time": 18926.39, "timestamp": "05:15:26", "text": "现实生活中也会感到饥饿。"}, {"type": "subtitle", "time": 18929.03, "timestamp": "05:15:29", "text": "塔可猴"}, {"type": "subtitle", "time": 18930.55, "timestamp": "05:15:30", "text": "已经。"}, {"type": "subtitle", "time": 18931.91, "timestamp": "05:15:31", "text": "天哪，这延迟。谢谢你"}, {"type": "subtitle", "time": 18945.11, "timestamp": "05:15:45", "text": "耶！现在是早上。过来。我情绪低落"}, {"type": "subtitle", "time": 18947.91, "timestamp": "05:15:47", "text": "如果我 如果我 坚持 如果我 重生，我将会"}, {"type": "subtitle", "time": 18951.03, "timestamp": "05:15:51", "text": "仅剩一台HP。我刚刚才意识到这一点。"}, {"type": "subtitle", "time": 18953.59, "timestamp": "05:15:53", "text": "我需要有人帮我杀虫，这样我才能"}, {"type": "subtitle", "time": 18954.868, "timestamp": "05:15:54", "text": "是的，你喜欢去这边。我喜欢"}, {"type": "subtitle", "time": 18956.55, "timestamp": "05:15:56", "text": "我可以让一些蜘蛛战斗到底"}]
[{"type": "subtitle", "time": 3742.47, "timestamp": "01:02:22", "text": "解锁英雄线挑战。"}, {"type": "subtitle", "time": 3745.829, "timestamp": "01:02:25", "text": "嗯？等等，我想玩玩“怜悯”这个角色会如何行动。"}, {"type": "subtitle", "time": 3747.91, "timestamp": "01:02:27", "text": "像。所以，它就像一支治愈之矛。"}, {"type": "subtitle", "time": 3750.39, "timestamp": "01:02:30", "text": "正确的？这个东西。"}, {"type": "subtitle", "time": 3752.309, "timestamp": "01:02:32", "text": "向右，左键单击治疗，右键单击"}, {"type": "subtitle", "time": 3756.71, "timestamp": "01:02:36", "text": "提升你的能力之类的。"}, {"type": "subtitle", "time": 3768.15, "timestamp": "01:02:48", "text": "哦，慢慢地坠落。"}, {"type": "subtitle", "time": 3775.03, "timestamp": "01:02:55", "text": "呃"}, {"type": "subtitle", "time": 3778.71, "timestamp": "01:02:58", "text": "啊，等等，我忘了"}]
[{"type": "subtitle", "time": 18608.31, "timestamp": "05:10:08", "text": "天哪，它们消耗的HP好多啊。"}, {"type": "subtitle", "time": 18611.51, "timestamp": "05:10:11", "text": "蜘蛛草称霸一方。"}, {"type": "subtitle", "time": 18613.43, "timestamp": "05:10:13", "text": "我正在收集一些草"}, {"type": "subtitle", "time": 18616.07, "timestamp": "05:10:16", "text": "这一点。好的，我回去再看看。"}, {"type": "subtitle", "time": 18618.15, "timestamp": "05:10:18", "text": "这里。我正在学习如何玩"}, {"type": "subtitle", "time": 18621.75, "timestamp": "05:10:21", "text": "游戏。哦，那里有草。乔克。得到"}, {"type": "subtitle", "time": 18623.35, "timestamp": "05:10:23", "text": "这边，乔克。我弄到了一些食物"}, {"type": "subtitle", "time": 18626.39, "timestamp": "05:10:26", "text": "为你。嗯，就是这样。你可以拥有这个，"}, {"type": "subtitle", "time": 18629.51, "timestamp": "05:10:29", "text": "你可以先吃这个。你吃。"}, {"type": "subtitle", "time": 18630.868, "timestamp": "05:10:30", "text": "欢迎在单人模式下尝试这款游戏。"}, {"type": "subtitle", "time": 18632.39, "timestamp": "05:10:32", "text": "顺便一提，这位球员名叫铃木。你可以"}, {"type": "subtitle", "time": 18634.39, "timestamp": "05:10:34", "text": "请实际描述一下这款游戏有多难。"}, {"type": "subtitle", "time": 18637.19, "timestamp": "05:10:37", "text": "是的，这游戏很难。"}, {"type": "subtitle", "time": 18639.91, "timestamp": "05:10:39", "text": "天哪，我记得罗恩需要"}, {"type": "subtitle", "time": 18643.35, "timestamp": "05:10:43", "text": "帮我照看孩子。"}, {"type": "subtitle", "time": 18645.43, "timestamp": "05:10:45", "text": "呃，再见。照看一两个孩子"}, {"type": "subtitle", "time": 18647.75, "timestamp": "05:10:47", "text": "人没事。"}, {"type": "subtitle", "time": 18653.99, "timestamp": "05:10:53", "text": "好的。嘿，我不需要照看孩子。"}, {"type": "subtitle", "time": 18656.788, "timestamp": "05:10:56", "text": "塞尔岑和你。"}]
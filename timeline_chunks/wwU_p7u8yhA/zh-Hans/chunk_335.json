[{"type": "subtitle", "time": 20100.07, "timestamp": "05:35:00", "text": "已摧毁。"}, {"type": "subtitle", "time": 20102.868, "timestamp": "05:35:02", "text": "我对此表示怀疑。好吧，晚安。"}, {"type": "subtitle", "time": 20106.23, "timestamp": "05:35:06", "text": "每个人。好了，我要回去睡觉了。"}, {"type": "subtitle", "time": 20109.83, "timestamp": "05:35:09", "text": "晚安。晚安。嗯，大家"}, {"type": "subtitle", "time": 20112.708, "timestamp": "05:35:12", "text": "谁还没吃过"}, {"type": "subtitle", "time": 20115.51, "timestamp": "05:35:15", "text": "出色地，"}, {"type": "subtitle", "time": 20118.15, "timestamp": "05:35:18", "text": "我醒了。"}, {"type": "subtitle", "time": 20120.07, "timestamp": "05:35:20", "text": "你好。"}, {"type": "subtitle", "time": 20126.23, "timestamp": "05:35:26", "text": "这个人将面临……哦，我们应该"}, {"type": "subtitle", "time": 20132.788, "timestamp": "05:35:32", "text": "再见，各位。是的。再见。晚安"}, {"type": "subtitle", "time": 20137.03, "timestamp": "05:35:37", "text": "每个人。我只直播这一个。我是"}, {"type": "subtitle", "time": 20139.43, "timestamp": "05:35:39", "text": "只有一个人没有在直播。所以呢"}, {"type": "subtitle", "time": 20142.31, "timestamp": "05:35:42", "text": "我真的是吗？"}, {"type": "subtitle", "time": 20145.91, "timestamp": "05:35:45", "text": "我稍后会过来和你聊天。是吗？"}, {"type": "subtitle", "time": 20148.23, "timestamp": "05:35:48", "text": "好的？你好。"}, {"type": "subtitle", "time": 20151.19, "timestamp": "05:35:51", "text": "是的。是的。你好。"}, {"type": "subtitle", "time": 20154.15, "timestamp": "05:35:54", "text": "我会给你打电话。"}, {"type": "subtitle", "time": 20158.548, "timestamp": "05:35:58", "text": "什么？我会打电话给你。什么？等待。"}]
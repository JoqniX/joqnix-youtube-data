[{"type": "subtitle", "time": 14111.429, "timestamp": "03:55:11", "text": "骑着我的自行车。这个人死了。好的，我们开始吧"}, {"type": "subtitle", "time": 14113.349, "timestamp": "03:55:13", "text": "看看这样行不行。"}, {"type": "subtitle", "time": 14117.189, "timestamp": "03:55:17", "text": "你需要大量的内存"}, {"type": "subtitle", "time": 14122.15, "timestamp": "03:55:22", "text": "还没有服务器托管商？哦，"}, {"type": "subtitle", "time": 14124.55, "timestamp": "03:55:24", "text": "谢谢你，莱昂纳多。"}, {"type": "subtitle", "time": 14127.429, "timestamp": "03:55:27", "text": "不，祝大家生日快乐。快乐的"}, {"type": "subtitle", "time": 14129.83, "timestamp": "03:55:29", "text": "生日。生日快乐。为什么是"}, {"type": "subtitle", "time": 14131.67, "timestamp": "03:55:31", "text": "大家的生日快到了吗？什么？"}, {"type": "subtitle", "time": 14133.59, "timestamp": "03:55:33", "text": "他妈的？"}, {"type": "subtitle", "time": 14134.79, "timestamp": "03:55:34", "text": "祝大家生日快乐。它不是"}, {"type": "subtitle", "time": 14137.03, "timestamp": "03:55:37", "text": "祝大家生日快乐。"}, {"type": "subtitle", "time": 14145.99, "timestamp": "03:55:45", "text": "学院。是的，你不能给我发链接。"}, {"type": "subtitle", "time": 14151.11, "timestamp": "03:55:51", "text": "你需要登录你的Steam才能访问我的Steam账号。"}, {"type": "subtitle", "time": 14153.51, "timestamp": "03:55:53", "text": "朋友守则。我的意思是，你可以，你可以"}, {"type": "subtitle", "time": 14154.87, "timestamp": "03:55:54", "text": "点击链接，然后点击“添加”。"}, {"type": "subtitle", "time": 14155.99, "timestamp": "03:55:55", "text": "朋友。你可以做到。我不会"}, {"type": "subtitle", "time": 14158.95, "timestamp": "03:55:58", "text": "就这样把她加进去。"}]
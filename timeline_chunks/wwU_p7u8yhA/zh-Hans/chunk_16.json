[{"type": "subtitle", "time": 973.749, "timestamp": "00:16:13", "text": "哦，等等，等等，等等。耽误。这是"}, {"type": "subtitle", "time": 975.749, "timestamp": "00:16:15", "text": "单棵树。等等，我种了一棵"}, {"type": "subtitle", "time": 977.749, "timestamp": "00:16:17", "text": "树。你好。"}, {"type": "subtitle", "time": 980.31, "timestamp": "00:16:20", "text": "决不。我种了一棵树，"}, {"type": "subtitle", "time": 983.91, "timestamp": "00:16:23", "text": "左边。哦，什么？"}, {"type": "subtitle", "time": 986.15, "timestamp": "00:16:26", "text": "爆米花"}]
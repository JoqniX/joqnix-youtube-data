[{"type": "subtitle", "time": 7861.75, "timestamp": "02:11:01", "text": "是的，我无法进行远距离射击。"}, {"type": "subtitle", "time": 7872.87, "timestamp": "02:11:12", "text": "什么？他怎么还活着？"}, {"type": "subtitle", "time": 7880.66, "timestamp": "02:11:20", "text": "谁来替我报仇？"}, {"type": "subtitle", "time": 7905.589, "timestamp": "02:11:45", "text": "什么？阿塔姆，"}, {"type": "subtitle", "time": 7908.55, "timestamp": "02:11:48", "text": "你第二次投篮没中。是的，"}, {"type": "subtitle", "time": 7910.95, "timestamp": "02:11:50", "text": "他又杀了我一次。"}]
[{"type": "subtitle", "time": 2520.87, "timestamp": "00:42:00", "text": "它用于流媒体之类的东西。"}, {"type": "subtitle", "time": 2523.589, "timestamp": "00:42:03", "text": "是的。为了什么？不，主要是为了"}, {"type": "subtitle", "time": 2525.349, "timestamp": "00:42:05", "text": "直播结束时，我喊了一声"}, {"type": "subtitle", "time": 2527.91, "timestamp": "00:42:07", "text": "所有到场的人。正确的。是的。是的。"}, {"type": "subtitle", "time": 2529.99, "timestamp": "00:42:09", "text": "因为我想感谢每一个人，"}, {"type": "subtitle", "time": 2531.75, "timestamp": "00:42:11", "text": "正确的？所以大多数时候，如果我错过了"}, {"type": "subtitle", "time": 2535.03, "timestamp": "00:42:15", "text": "任何人，我都会感到非常难过。"}, {"type": "subtitle", "time": 2537.99, "timestamp": "00:42:17", "text": "不，我错过了，我错过了这个某某"}, {"type": "subtitle", "time": 2541.03, "timestamp": "00:42:21", "text": "人。不，我已经结束了。"}, {"type": "subtitle", "time": 2544.15, "timestamp": "00:42:24", "text": "溪流。如果我能回到过去。我曾"}, {"type": "subtitle", "time": 2547.03, "timestamp": "00:42:27", "text": "过去有很多类似的遗憾。"}, {"type": "subtitle", "time": 2550.23, "timestamp": "00:42:30", "text": "比如想感谢的人却想不起他们的名字。"}, {"type": "subtitle", "time": 2552.87, "timestamp": "00:42:32", "text": "于是我对自己说，你知道吗？"}, {"type": "subtitle", "time": 2557.109, "timestamp": "00:42:37", "text": "我也会尽我所能。"}, {"type": "subtitle", "time": 2560.71, "timestamp": "00:42:40", "text": "做些东西，这样我总能得到"}, {"type": "subtitle", "time": 2566.63, "timestamp": "00:42:46", "text": "呃，所以无论谁进来，无论谁走进来"}, {"type": "subtitle", "time": 2569.27, "timestamp": "00:42:49", "text": "一切"}, {"type": "subtitle", "time": 2571.51, "timestamp": "00:42:51", "text": "某物。你好。总之，我们开始吧。"}, {"type": "subtitle", "time": 2574.069, "timestamp": "00:42:54", "text": "再次。呃，我认为守望先锋没有"}, {"type": "subtitle", "time": 2577.99, "timestamp": "00:42:57", "text": "踢我。没有。感谢上帝。圣。我"}, {"type": "subtitle", "time": 2579.75, "timestamp": "00:42:59", "text": "真以为《守望先锋》会把我踢出去呢。"}]
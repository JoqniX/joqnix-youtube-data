[{"type": "subtitle", "time": 18362.39, "timestamp": "05:06:02", "text": "在。我换个说法吧。"}, {"type": "subtitle", "time": 18363.99, "timestamp": "05:06:03", "text": "跑步。"}, {"type": "subtitle", "time": 18369.27, "timestamp": "05:06:09", "text": "好的，我需要……呃，它叫什么来着？"}, {"type": "subtitle", "time": 18371.11, "timestamp": "05:06:11", "text": "弗伦德"}, {"type": "subtitle", "time": 18373.43, "timestamp": "05:06:13", "text": "这"}, {"type": "subtitle", "time": 18381.19, "timestamp": "05:06:21", "text": "第九天。"}, {"type": "subtitle", "time": 18385.27, "timestamp": "05:06:25", "text": "是的，现在才第九天。想象"}, {"type": "subtitle", "time": 18388.07, "timestamp": "05:06:28", "text": "哦，不。有多少起因窗户事故造成的伤亡？"}, {"type": "subtitle", "time": 18390.948, "timestamp": "05:06:30", "text": "我们经历过什么？我还没死过呢。"}, {"type": "subtitle", "time": 18393.35, "timestamp": "05:06:33", "text": "谢天谢地。等等，我花了多长时间？"}, {"type": "subtitle", "time": 18395.59, "timestamp": "05:06:35", "text": "死？顺便说一句，我需要治疗，如果你……"}, {"type": "subtitle", "time": 18398.628, "timestamp": "05:06:38", "text": "你可以。哦，你需要治疗吗？是的。我，"}, {"type": "subtitle", "time": 18401.35, "timestamp": "05:06:41", "text": "也。相同的。"}, {"type": "subtitle", "time": 18404.23, "timestamp": "05:06:44", "text": "谢谢。谢谢。好的，就到这里。"}, {"type": "subtitle", "time": 18407.03, "timestamp": "05:06:47", "text": "正确的。我们很好。我可以要一些吗？"}, {"type": "subtitle", "time": 18409.75, "timestamp": "05:06:49", "text": "肉类？对，拿去。拿去就行了。"}, {"type": "subtitle", "time": 18411.83, "timestamp": "05:06:51", "text": "拿去就行了。我为你做的。"}, {"type": "subtitle", "time": 18414.31, "timestamp": "05:06:54", "text": "具体来说。"}, {"type": "subtitle", "time": 18416.85, "timestamp": "05:06:56", "text": "因为你当时需要食物。"}, {"type": "subtitle", "time": 18418.708, "timestamp": "05:06:58", "text": "[音乐]"}]
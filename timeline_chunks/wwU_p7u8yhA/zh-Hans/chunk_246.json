[{"type": "subtitle", "time": 14760.07, "timestamp": "04:06:00", "text": "试图找到黄金。哦，找到了。"}, {"type": "subtitle", "time": 14764.309, "timestamp": "04:06:04", "text": "又一个。看？是的，我可以。制作一个"}, {"type": "subtitle", "time": 14767.59, "timestamp": "04:06:07", "text": "一大堆金子。"}, {"type": "subtitle", "time": 14771.03, "timestamp": "04:06:11", "text": "可以制作一把镐。你会造船吗？"}, {"type": "subtitle", "time": 14773.189, "timestamp": "04:06:13", "text": "但遗憾的是，由于目前的延迟，我"}, {"type": "subtitle", "time": 14775.59, "timestamp": "04:06:15", "text": "我觉得我可能去不了。它没有滞后"}, {"type": "subtitle", "time": 14777.75, "timestamp": "04:06:17", "text": "不再是了。至少对我而言是这样。哦，对我来说。"}, {"type": "subtitle", "time": 14779.269, "timestamp": "04:06:19", "text": "对我来说有点卡顿。"}, {"type": "subtitle", "time": 14780.87, "timestamp": "04:06:20", "text": "就一点点。对我来说，并非如此。"}, {"type": "subtitle", "time": 14782.95, "timestamp": "04:06:22", "text": "滞后。哦，请帮帮我。它它"}, {"type": "subtitle", "time": 14784.15, "timestamp": "04:06:24", "text": "其实我并不太在意。"}, {"type": "subtitle", "time": 14786.469, "timestamp": "04:06:26", "text": "因为我并没有对抗任何事物，而且"}, {"type": "subtitle", "time": 14787.67, "timestamp": "04:06:27", "text": "我在玩鼠标。嗯，就是这样。"}, {"type": "subtitle", "time": 14789.11, "timestamp": "04:06:29", "text": "这对我来说会是个问题，因为我"}, {"type": "subtitle", "time": 14790.71, "timestamp": "04:06:30", "text": "我将成为那个与某种东西战斗的人。"}, {"type": "subtitle", "time": 14792.79, "timestamp": "04:06:32", "text": "是的。"}, {"type": "subtitle", "time": 14795.51, "timestamp": "04:06:35", "text": "等等，谁的延迟最低？寿司是"}, {"type": "subtitle", "time": 14799.03, "timestamp": "04:06:39", "text": "是你的，对吧？呃，不。这是我的，就这么简单"}, {"type": "subtitle", "time": 14803.11, "timestamp": "04:06:43", "text": "帧率问题。哦。哦好的。"}, {"type": "subtitle", "time": 14805.269, "timestamp": "04:06:45", "text": "好的，"}, {"type": "subtitle", "time": 14807.83, "timestamp": "04:06:47", "text": "是的。呃，第二个重要问题该如何解决？"}, {"type": "subtitle", "time": 14811.75, "timestamp": "04:06:51", "text": "东西能做到吗？你找到东西。"}, {"type": "subtitle", "time": 14819.429, "timestamp": "04:06:59", "text": "这边。这边。过来。那些"}]
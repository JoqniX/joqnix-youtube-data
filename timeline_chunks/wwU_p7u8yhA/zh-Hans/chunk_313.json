[{"type": "subtitle", "time": 18781.43, "timestamp": "05:13:01", "text": "茄子，兄弟。我们搞定了加勒特。如果你"}, {"type": "subtitle", "time": 18783.67, "timestamp": "05:13:03", "text": "如果你有草坪，你可以像这样……"}, {"type": "subtitle", "time": 18785.99, "timestamp": "05:13:05", "text": "可以用它来摘土豆，因为"}, {"type": "subtitle", "time": 18789.43, "timestamp": "05:13:09", "text": "我说，哦，杰森。我的天哪。"}, {"type": "subtitle", "time": 18792.07, "timestamp": "05:13:12", "text": "做大土豆。寿司，那是什么？"}, {"type": "subtitle", "time": 18794.23, "timestamp": "05:13:14", "text": "最不应该做的菜是什么？给予"}, {"type": "subtitle", "time": 18795.75, "timestamp": "05:13:15", "text": "反正你得到的金额也一样。是吗？"}, {"type": "subtitle", "time": 18797.51, "timestamp": "05:13:17", "text": "浆果？"}, {"type": "subtitle", "time": 18801.67, "timestamp": "05:13:21", "text": "呃，那是胡萝卜。胡萝卜。好的。"}, {"type": "subtitle", "time": 18804.23, "timestamp": "05:13:24", "text": "哦，我不应该煮胡萝卜。是的。这"}, {"type": "subtitle", "time": 18807.51, "timestamp": "05:13:27", "text": "它们唯一能带来的就是更多健康。哦，"}, {"type": "subtitle", "time": 18809.67, "timestamp": "05:13:29", "text": "等待。我该如何在海里钓鱼？"}, {"type": "subtitle", "time": 18811.75, "timestamp": "05:13:31", "text": "尽管？我该如何钓鱼？你需要大海"}, {"type": "subtitle", "time": 18813.83, "timestamp": "05:13:33", "text": "钓竿。"}, {"type": "subtitle", "time": 18817.11, "timestamp": "05:13:37", "text": "想去钓鱼。"}, {"type": "subtitle", "time": 18820.07, "timestamp": "05:13:40", "text": "我现在就想去钓鱼。"}, {"type": "subtitle", "time": 18827.51, "timestamp": "05:13:47", "text": "我大概会因为精神错乱而死。"}, {"type": "subtitle", "time": 18829.03, "timestamp": "05:13:49", "text": "如果你没有草，我需要草来复活。"}, {"type": "subtitle", "time": 18831.59, "timestamp": "05:13:51", "text": "草还没长出来。哟，那是克里斯的马里奥吗？"}, {"type": "subtitle", "time": 18833.75, "timestamp": "05:13:53", "text": "普拉特？哦，去我的身体里去。就像……"}, {"type": "subtitle", "time": 18836.47, "timestamp": "05:13:56", "text": "草。你的身体在哪里？已经"}, {"type": "subtitle", "time": 18837.59, "timestamp": "05:13:57", "text": "夜晚。我想我打算这么做。"}]
[{"type": "subtitle", "time": 483.589, "timestamp": "00:08:03", "text": "[音乐]"}, {"type": "subtitle", "time": 486.309, "timestamp": "00:08:06", "text": "和"}, {"type": "subtitle", "time": 498.95, "timestamp": "00:08:18", "text": "为什么我没有立刻得到答案？"}, {"type": "subtitle", "time": 500.95, "timestamp": "00:08:20", "text": "哦，是的。所以，如果你不太活跃的话，"}, {"type": "subtitle", "time": 502.71, "timestamp": "00:08:22", "text": "他们会把你从……中移除。"}, {"type": "subtitle", "time": 514.23, "timestamp": "00:08:34", "text": "我尤其不想得到"}, {"type": "subtitle", "time": 516.949, "timestamp": "00:08:36", "text": "未扭曲。哦，我是最早一批的。"}, {"type": "subtitle", "time": 518.55, "timestamp": "00:08:38", "text": "支持者。"}, {"type": "subtitle", "time": 520.79, "timestamp": "00:08:40", "text": "但话说回来，没关系。我只是"}, {"type": "subtitle", "time": 523.99, "timestamp": "00:08:43", "text": "开玩笑的。我觉得我不会，我不能。"}, {"type": "subtitle", "time": 526.63, "timestamp": "00:08:46", "text": "我喜欢在这里消磨时光。"}]
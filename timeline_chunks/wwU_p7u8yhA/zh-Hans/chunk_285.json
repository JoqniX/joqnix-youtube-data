[{"type": "subtitle", "time": 17104.47, "timestamp": "04:45:04", "text": "再次。"}, {"type": "subtitle", "time": 17107.03, "timestamp": "04:45:07", "text": "那是什么棕色的蜘蛛？我的天啊。哦"}, {"type": "subtitle", "time": 17108.868, "timestamp": "04:45:08", "text": "不。"}, {"type": "subtitle", "time": 17110.47, "timestamp": "04:45:10", "text": "我可以再做一个心形吗？我无法做到"}, {"type": "subtitle", "time": 17113.51, "timestamp": "04:45:13", "text": "另一颗心脏。好了，过来。"}, {"type": "subtitle", "time": 17116.948, "timestamp": "04:45:16", "text": "我又要开始康复了。"}, {"type": "subtitle", "time": 17118.55, "timestamp": "04:45:18", "text": "我需要杀人，我需要你杀人。"}, {"type": "subtitle", "time": 17119.83, "timestamp": "04:45:19", "text": "如果你想让我痊愈，那就做点什么吧。"}, {"type": "subtitle", "time": 17121.99, "timestamp": "04:45:21", "text": "你，因为我的灵魂已经耗尽了。哦，是的。哦"}, {"type": "subtitle", "time": 17126.07, "timestamp": "04:45:26", "text": "男生。这里简直像一群小猪。"}, {"type": "subtitle", "time": 17128.948, "timestamp": "04:45:28", "text": "杀掉等等，铃木在哪儿？铃木"}, {"type": "subtitle", "time": 17130.39, "timestamp": "04:45:30", "text": "把你妹妹杀了"}, {"type": "subtitle", "time": 17132.39, "timestamp": "04:45:32", "text": "青蛙。 《Cook Monster Me》需要三个"}, {"type": "subtitle", "time": 17135.43, "timestamp": "04:45:35", "text": "用健康而不是28。是的。等等，什么？"}, {"type": "subtitle", "time": 17138.628, "timestamp": "04:45:38", "text": "铃木，帮韩韩杀蜘蛛吧，因为"}, {"type": "subtitle", "time": 17141.27, "timestamp": "04:45:41", "text": "你妹妹实力不如人意。"}, {"type": "subtitle", "time": 17144.39, "timestamp": "04:45:44", "text": "是啊，拜托。快点。请确保你的"}, {"type": "subtitle", "time": 17146.788, "timestamp": "04:45:46", "text": "姐姐生气了。是啊，但是，"}, {"type": "subtitle", "time": 17148.628, "timestamp": "04:45:48", "text": "你知道，当她开始时，把它们摆正。"}, {"type": "subtitle", "time": 17151.83, "timestamp": "04:45:51", "text": "打破巢穴。哦，是的。我该怎么做？"}, {"type": "subtitle", "time": 17154.868, "timestamp": "04:45:54", "text": "愤怒？点击右键，但是"}, {"type": "subtitle", "time": 17156.868, "timestamp": "04:45:56", "text": "它会说激怒她，然后就会"}, {"type": "subtitle", "time": 17159.91, "timestamp": "04:45:59", "text": "去做。现在，"}]
[{"type": "subtitle", "time": 664.31, "timestamp": "00:11:04", "text": "[音乐]"}, {"type": "subtitle", "time": 666.949, "timestamp": "00:11:06", "text": "虽然我学会了这首歌，但这感觉有点……"}, {"type": "subtitle", "time": 674.31, "timestamp": "00:11:14", "text": "几乎所有的日本歌曲都有些……"}, {"type": "subtitle", "time": 676.949, "timestamp": "00:11:16", "text": "很难，但需要锡箔纸。"}, {"type": "subtitle", "time": 679.99, "timestamp": "00:11:19", "text": "仍然像四岁一样在学习。"}, {"type": "subtitle", "time": 682.23, "timestamp": "00:11:22", "text": "片刻。"}, {"type": "subtitle", "time": 684.23, "timestamp": "00:11:24", "text": "不，我不知道还有这么个东西。"}, {"type": "subtitle", "time": 687.43, "timestamp": "00:11:27", "text": "比如音域之类的。所以"}, {"type": "subtitle", "time": 689.91, "timestamp": "00:11:29", "text": "我问过其他人，你觉得我能不能"}, {"type": "subtitle", "time": 693.67, "timestamp": "00:11:33", "text": "学会这首歌，然后像发送歌曲一样发送它。"}, {"type": "subtitle", "time": 695.829, "timestamp": "00:11:35", "text": "我正在学习。他们就像你一样"}, {"type": "subtitle", "time": 698.63, "timestamp": "00:11:38", "text": "别这样，我觉得你做不到，小伙子。"}, {"type": "subtitle", "time": 700.79, "timestamp": "00:11:40", "text": "我就像……"}, {"type": "subtitle", "time": 702.79, "timestamp": "00:11:42", "text": "我还没发挥出最佳水平。我没有"}, {"type": "subtitle", "time": 705.59, "timestamp": "00:11:45", "text": "试过了吗？等等，别这么说。"}, {"type": "subtitle", "time": 709.75, "timestamp": "00:11:49", "text": "别听我唱歌。我当时就想，"}]
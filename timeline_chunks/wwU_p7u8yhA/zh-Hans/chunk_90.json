[{"type": "subtitle", "time": 5403.03, "timestamp": "01:30:03", "text": "我的天啊。圣"}, {"type": "subtitle", "time": 5410.709, "timestamp": "01:30:10", "text": "不，"}, {"type": "subtitle", "time": 5419.99, "timestamp": "01:30:19", "text": "这些人真是太好了。知道"}, {"type": "subtitle", "time": 5428.149, "timestamp": "01:30:28", "text": "如何才能立即到达那里？这是"}, {"type": "subtitle", "time": 5431.35, "timestamp": "01:30:31", "text": "就像走路一样"}, {"type": "subtitle", "time": 5438.79, "timestamp": "01:30:38", "text": "死亡会带来痛苦。哦，等等。银"}, {"type": "subtitle", "time": 5441.669, "timestamp": "01:30:41", "text": "月亮。我认为情况也一样。"}, {"type": "subtitle", "time": 5445.27, "timestamp": "01:30:45", "text": "是高达吧？我不得不走很远的路去"}]
[{"type": "subtitle", "time": 15841.03, "timestamp": "04:24:01", "text": "是啊，问题是迪克斯在哪儿？"}, {"type": "subtitle", "time": 15843.99, "timestamp": "04:24:03", "text": "是的，他就在我这边。我得到了"}, {"type": "subtitle", "time": 15845.44, "timestamp": "04:24:05", "text": "复活了。"}, {"type": "subtitle", "time": 15847.349, "timestamp": "04:24:07", "text": "[音乐]"}, {"type": "subtitle", "time": 15851.269, "timestamp": "04:24:11", "text": "是的，你人很好。欢迎回来。"}, {"type": "subtitle", "time": 15853.99, "timestamp": "04:24:13", "text": "欢迎回来。别忘了，不，别"}, {"type": "subtitle", "time": 15855.429, "timestamp": "04:24:15", "text": "再次死去。"}, {"type": "subtitle", "time": 15857.189, "timestamp": "04:24:17", "text": "是的，我不会死。我会一直陪着你"}, {"type": "subtitle", "time": 15859.349, "timestamp": "04:24:19", "text": "伙计们，如果你们需要食物的话，因为我会弄一些。"}, {"type": "subtitle", "time": 15861.269, "timestamp": "04:24:21", "text": "剩菜剩饭。需要的话就点赞。我"}, {"type": "subtitle", "time": 15864.07, "timestamp": "04:24:24", "text": "我的库存已满。哦，你可以"}, {"type": "subtitle", "time": 15865.99, "timestamp": "04:24:25", "text": "掉一些。我帮你拿着。这"}, {"type": "subtitle", "time": 15871.11, "timestamp": "04:24:31", "text": "虽然有点老套，但还是算了。好的。"}, {"type": "subtitle", "time": 15874.309, "timestamp": "04:24:34", "text": "我会陪着你。食物就是食物。好的。呃"}, {"type": "subtitle", "time": 15875.91, "timestamp": "04:24:35", "text": "我们需要石头和黄金。我向上帝发誓，"}, {"type": "subtitle", "time": 15879.189, "timestamp": "04:24:39", "text": "我们没有找到黄金。我有"}, {"type": "subtitle", "time": 15881.75, "timestamp": "04:24:41", "text": "好的。我弄到了木头。所以，你不需要"}, {"type": "subtitle", "time": 15883.189, "timestamp": "04:24:43", "text": "我甚至不知道你们在哪里。 30"}, {"type": "subtitle", "time": 15886.149, "timestamp": "04:24:46", "text": "木头。 31 木材，他们没有跟随我们"}, {"type": "subtitle", "time": 15888.229, "timestamp": "04:24:48", "text": "猪村。不，我和……我和……"}, {"type": "subtitle", "time": 15890.389, "timestamp": "04:24:50", "text": "韩韩现在就是这样，哦，是的。韩，就"}, {"type": "subtitle", "time": 15892.79, "timestamp": "04:24:52", "text": "把他带回去。是的。哦，等等。大"}]
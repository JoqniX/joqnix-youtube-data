[{"type": "subtitle", "time": 15360.389, "timestamp": "04:16:00", "text": "下面。"}, {"type": "subtitle", "time": 15362.309, "timestamp": "04:16:02", "text": "是的，我往左边走了。我不"}, {"type": "subtitle", "time": 15364.87, "timestamp": "04:16:04", "text": "我知道你们去了哪里，但是……"}, {"type": "subtitle", "time": 15366.469, "timestamp": "04:16:06", "text": "下面什么也没有。这就是全部人了吗？是"}, {"type": "subtitle", "time": 15372.95, "timestamp": "04:16:12", "text": "现在。"}, {"type": "subtitle", "time": 15382.87, "timestamp": "04:16:22", "text": "电动枪。是的。"}, {"type": "subtitle", "time": 15384.95, "timestamp": "04:16:24", "text": "杰森，事情是这样的。"}, {"type": "subtitle", "time": 15386.95, "timestamp": "04:16:26", "text": "我们以前住在绿洲里"}, {"type": "subtitle", "time": 15389.75, "timestamp": "04:16:29", "text": "我们甚至连伞都没有，也没有"}, {"type": "subtitle", "time": 15392.79, "timestamp": "04:16:32", "text": "雨衣所需的材料。"}, {"type": "subtitle", "time": 15395.99, "timestamp": "04:16:35", "text": "哦，我需要一个“是的”，"}, {"type": "subtitle", "time": 15398.469, "timestamp": "04:16:38", "text": "我有点需要……哦，我不能吃"}, {"type": "subtitle", "time": 15400.07, "timestamp": "04:16:40", "text": "一切。"}, {"type": "subtitle", "time": 15401.83, "timestamp": "04:16:41", "text": "伸展一下，我的孩子。顺便说一句，谢谢。"}, {"type": "subtitle", "time": 15404.229, "timestamp": "04:16:44", "text": "查克，你可以用……做一个陷阱"}, {"type": "subtitle", "time": 15405.99, "timestamp": "04:16:45", "text": "生存。你可以设陷阱捕捉"}, {"type": "subtitle", "time": 15409.51, "timestamp": "04:16:49", "text": "一些兔子。哦，你可以设个陷阱。"}, {"type": "subtitle", "time": 15412.309, "timestamp": "04:16:52", "text": "哦，是的。杰森，我们当时哪儿也没去。"}, {"type": "subtitle", "time": 15416.07, "timestamp": "04:16:56", "text": "靠近那部分是因为我们仍然"}, {"type": "subtitle", "time": 15417.91, "timestamp": "04:16:57", "text": "之所以说金库实际上并非如此，是因为它并非如此。"}]
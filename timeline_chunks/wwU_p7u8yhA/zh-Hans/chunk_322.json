[{"type": "subtitle", "time": 19321.43, "timestamp": "05:22:01", "text": "我这儿有只青蛙腿。如果你想"}, {"type": "subtitle", "time": 19323.67, "timestamp": "05:22:03", "text": "去庄稼地里摘食物。"}, {"type": "subtitle", "time": 19327.03, "timestamp": "05:22:07", "text": "哦，不。我被轮奸了。不。哦，"}, {"type": "subtitle", "time": 19333.83, "timestamp": "05:22:13", "text": "不。糟了。"}, {"type": "subtitle", "time": 19336.39, "timestamp": "05:22:16", "text": "推荐"}, {"type": "subtitle", "time": 19340.47, "timestamp": "05:22:20", "text": "就像我的意思，就像你那样。是的。哦，是的"}, {"type": "subtitle", "time": 19342.788, "timestamp": "05:22:22", "text": "满月。嘿。"}, {"type": "subtitle", "time": 19345.03, "timestamp": "05:22:25", "text": "好的。"}, {"type": "subtitle", "time": 19348.15, "timestamp": "05:22:28", "text": "生气的。惹你妹妹生气。好的。"}, {"type": "subtitle", "time": 19350.55, "timestamp": "05:22:30", "text": "嘿。"}, {"type": "subtitle", "time": 19353.99, "timestamp": "05:22:33", "text": "好的。好的。就像这两个"}, {"type": "subtitle", "time": 19356.07, "timestamp": "05:22:36", "text": "柳树。你喜欢你所说的吗？"}, {"type": "subtitle", "time": 19358.948, "timestamp": "05:22:38", "text": "再次？呃，刚才是什么电话？嗯，所以……"}, {"type": "subtitle", "time": 19362.788, "timestamp": "05:22:42", "text": "Zuki 想要免费的巢穴。不。"}, {"type": "subtitle", "time": 19365.75, "timestamp": "05:22:45", "text": "我的天哪。我的天哪。"}, {"type": "subtitle", "time": 19369.51, "timestamp": "05:22:49", "text": "好的。好的。很公平。"}, {"type": "subtitle", "time": 19371.19, "timestamp": "05:22:51", "text": "为什么不呢？它在哪里？它在哪里？"}, {"type": "subtitle", "time": 19374.39, "timestamp": "05:22:54", "text": "这边过来，那边过来。过来吧"}, {"type": "subtitle", "time": 19376.47, "timestamp": "05:22:56", "text": "这里。好的。快点。我们需要所有"}, {"type": "subtitle", "time": 19378.948, "timestamp": "05:22:58", "text": "我们需要的人力。幽灵之力。姐姐"}]
[{"type": "subtitle", "time": 15720.79, "timestamp": "04:22:00", "text": "真的。但话说回来，我当时并没有安装模组。"}, {"type": "subtitle", "time": 15724.87, "timestamp": "04:22:04", "text": "以前也是这样。呃，在……之前"}, {"type": "subtitle", "time": 15727.83, "timestamp": "04:22:07", "text": "研讨会是存在的。那玩意儿"}, {"type": "subtitle", "time": 15730.469, "timestamp": "04:22:10", "text": "荒野。是的。你想要什么？怎么样？"}, {"type": "subtitle", "time": 15735.269, "timestamp": "04:22:15", "text": "去？你能帮我找到那块石头吗？呃"}, {"type": "subtitle", "time": 15738.55, "timestamp": "04:22:18", "text": "呃，那里有很远很远的岩石。是的，"}, {"type": "subtitle", "time": 15740.55, "timestamp": "04:22:20", "text": "离这里很远。"}, {"type": "subtitle", "time": 15742.469, "timestamp": "04:22:22", "text": "呃，那就试着跟着我做吧。直行"}, {"type": "subtitle", "time": 15744.63, "timestamp": "04:22:24", "text": "我正往这边走。走吧"}, {"type": "subtitle", "time": 15746.55, "timestamp": "04:22:26", "text": "直的"}, {"type": "subtitle", "time": 15749.189, "timestamp": "04:22:29", "text": "到 Minecraft。"}, {"type": "subtitle", "time": 15751.189, "timestamp": "04:22:31", "text": "他们的经历确实和我一样。"}, {"type": "subtitle", "time": 15753.59, "timestamp": "04:22:33", "text": "不过需要安装一些模组。好的，"}, {"type": "subtitle", "time": 15758.149, "timestamp": "04:22:38", "text": "肉。哦不，这就是为什么要吃肉的原因。"}, {"type": "subtitle", "time": 15759.51, "timestamp": "04:22:39", "text": "赶紧逃离前方。为什么是"}, {"type": "subtitle", "time": 15761.59, "timestamp": "04:22:41", "text": "铃木，你在跟我说话吗？"}, {"type": "subtitle", "time": 15763.75, "timestamp": "04:22:43", "text": "不，我需要清理一下我的"}, {"type": "subtitle", "time": 15766.87, "timestamp": "04:22:46", "text": "存货。我叫你往那边走。所以"}, {"type": "subtitle", "time": 15769.59, "timestamp": "04:22:49", "text": "我的库存里有很多东西。呃，抓住"}, {"type": "subtitle", "time": 15773.91, "timestamp": "04:22:53", "text": "我的天啊，我卡得要命。"}, {"type": "subtitle", "time": 15777.349, "timestamp": "04:22:57", "text": "对不起。是的。是的。往这边走。哦"}]
[{"type": "subtitle", "time": 19744.15, "timestamp": "05:29:04", "text": "我的天哪。很多蜘蛛侠。是的。杀。"}, {"type": "subtitle", "time": 19746.708, "timestamp": "05:29:06", "text": "我的天啊。"}, {"type": "subtitle", "time": 19751.99, "timestamp": "05:29:11", "text": "通缉。"}, {"type": "subtitle", "time": 19755.99, "timestamp": "05:29:15", "text": "你们所有人与我所有人为敌。"}, {"type": "subtitle", "time": 19759.75, "timestamp": "05:29:19", "text": "亲爱的上帝。去你的。等待。我怎么样？"}, {"type": "subtitle", "time": 19761.27, "timestamp": "05:29:21", "text": "还活着吗？我的天哪。仍然"}, {"type": "subtitle", "time": 19764.948, "timestamp": "05:29:24", "text": "活。嗯？我需要食物。你姐姐是"}, {"type": "subtitle", "time": 19767.11, "timestamp": "05:29:27", "text": "太强了。是的，她太强了。好的，"}, {"type": "subtitle", "time": 19771.99, "timestamp": "05:29:31", "text": "姐姐也是楼主。请削弱。"}, {"type": "subtitle", "time": 19787.83, "timestamp": "05:29:47", "text": "他们正在轮奸我。不，不，你"}, {"type": "subtitle", "time": 19789.67, "timestamp": "05:29:49", "text": "真的想做吗？然后我们将"}, {"type": "subtitle", "time": 19791.99, "timestamp": "05:29:51", "text": "必须在这里做。系统。等等，是"}]
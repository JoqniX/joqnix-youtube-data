[{"type": "subtitle", "time": 17282.948, "timestamp": "04:48:02", "text": "身体。拿不到。是的。好的。我们得去"}, {"type": "subtitle", "time": 17284.708, "timestamp": "04:48:04", "text": "去。我们得走了。阿比盖尔，你可以抓住"}, {"type": "subtitle", "time": 17287.51, "timestamp": "04:48:07", "text": "它。我的天哪。还在服用"}, {"type": "subtitle", "time": 17288.868, "timestamp": "04:48:08", "text": "损害。我觉得是因为他身上湿了。"}, {"type": "subtitle", "time": 17290.788, "timestamp": "04:48:10", "text": "你姐姐并没有生气。你是什​​么"}, {"type": "subtitle", "time": 17293.27, "timestamp": "04:48:13", "text": "意思是？她并没有生气。让你的"}, {"type": "subtitle", "time": 17295.83, "timestamp": "04:48:15", "text": "姐姐生气了。"}, {"type": "subtitle", "time": 17297.27, "timestamp": "04:48:17", "text": "我妹妹生气了。你可以把它放好。你"}, {"type": "subtitle", "time": 17298.628, "timestamp": "04:48:18", "text": "可以右键点击它。你可以右键点击"}, {"type": "subtitle", "time": 17300.708, "timestamp": "04:48:20", "text": "它。如果它生气了，它就会像这样……"}, {"type": "subtitle", "time": 17302.47, "timestamp": "04:48:22", "text": "两只眼睛不一样。皮肤"}, {"type": "subtitle", "time": 17306.07, "timestamp": "04:48:26", "text": "伞。我们需要一张猪皮。哦。啊，我"}, {"type": "subtitle", "time": 17308.39, "timestamp": "04:48:28", "text": "猪皮"}, {"type": "subtitle", "time": 17311.03, "timestamp": "04:48:31", "text": "那不是正确的按钮。只是"}, {"type": "subtitle", "time": 17312.788, "timestamp": "04:48:32", "text": "召唤她，然后右键点击她。"}, {"type": "subtitle", "time": 17316.55, "timestamp": "04:48:36", "text": "再次开花。我喜欢这个。"}, {"type": "subtitle", "time": 17319.19, "timestamp": "04:48:39", "text": "我的天哪。不，不是在她身上。我正在……"}, {"type": "subtitle", "time": 17322.47, "timestamp": "04:48:42", "text": "热食吧。好了。现在它生气了。我"}, {"type": "subtitle", "time": 17325.27, "timestamp": "04:48:45", "text": "做了一些"}, {"type": "subtitle", "time": 17328.47, "timestamp": "04:48:48", "text": "就像你可以直接走到坏人面前一样"}, {"type": "subtitle", "time": 17330.55, "timestamp": "04:48:50", "text": "容易地。"}, {"type": "subtitle", "time": 17331.99, "timestamp": "04:48:51", "text": "嘿，你可以直接在这边砌墙。等待。"}, {"type": "subtitle", "time": 17334.23, "timestamp": "04:48:54", "text": "呃，祖基，过来一下。呃，雷米"}, {"type": "subtitle", "time": 17337.11, "timestamp": "04:48:57", "text": "这样我们就能获得灵魂了。呃，呃，我超过"}]
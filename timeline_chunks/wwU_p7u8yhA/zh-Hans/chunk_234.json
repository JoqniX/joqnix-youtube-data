[{"type": "subtitle", "time": 14047.03, "timestamp": "03:54:07", "text": "我们今天不做这件事。哦，不。制作"}, {"type": "subtitle", "time": 14049.59, "timestamp": "03:54:09", "text": "更多的。"}, {"type": "subtitle", "time": 14052.79, "timestamp": "03:54:12", "text": "添加更多问题。我喜欢什么问题？"}, {"type": "subtitle", "time": 14054.71, "timestamp": "03:54:14", "text": "乐趣。"}, {"type": "subtitle", "time": 14057.51, "timestamp": "03:54:17", "text": "技术问题。乐趣。技术的"}, {"type": "subtitle", "time": 14058.87, "timestamp": "03:54:18", "text": "困难。我喜欢技术"}, {"type": "subtitle", "time": 14060.87, "timestamp": "03:54:20", "text": "困难。好的，我们来看看。我们不"}, {"type": "subtitle", "time": 14065.189, "timestamp": "03:54:25", "text": "想在半小时后结束。是的。"}, {"type": "subtitle", "time": 14070.87, "timestamp": "03:54:30", "text": "如果真的出现推力，那就是俄罗斯方块。"}, {"type": "subtitle", "time": 14074.389, "timestamp": "03:54:34", "text": "溪流。哦，不。"}, {"type": "subtitle", "time": 14076.63, "timestamp": "03:54:36", "text": "埃里克要把我们所有人都揍一顿。他是"}, {"type": "subtitle", "time": 14079.11, "timestamp": "03:54:39", "text": "将会是我们所有人。"}, {"type": "subtitle", "time": 14081.11, "timestamp": "03:54:41", "text": "切换到这个"}, {"type": "subtitle", "time": 14082.95, "timestamp": "03:54:42", "text": "我们什么时候才能修复这个游戏。我不能"}, {"type": "subtitle", "time": 14086.07, "timestamp": "03:54:46", "text": "玩。呃，你说我不是朋友。"}, {"type": "subtitle", "time": 14089.189, "timestamp": "03:54:49", "text": "专业人士通常都这么说。"}, {"type": "subtitle", "time": 14092.55, "timestamp": "03:54:52", "text": "我的天哪。更好的是杰森"}, {"type": "subtitle", "time": 14095.59, "timestamp": "03:54:55", "text": "和Willow正在获得"}]
[{"type": "subtitle", "time": 13502.87, "timestamp": "03:45:02", "text": "有个扮成美人鱼的家伙。我该如何离开"}, {"type": "subtitle", "time": 13512.55, "timestamp": "03:45:12", "text": "好的。好的。那么，是谁在派人？"}, {"type": "subtitle", "time": 13514.63, "timestamp": "03:45:14", "text": "问候？"}, {"type": "subtitle", "time": 13520.07, "timestamp": "03:45:20", "text": "是的，是我。对，是本尼。曾是"}, {"type": "subtitle", "time": 13529.59, "timestamp": "03:45:29", "text": "哦，这音乐真不错。"}, {"type": "subtitle", "time": 13537.51, "timestamp": "03:45:37", "text": "搞砸了。天哪，我喜欢你伸展身体的时候"}, {"type": "subtitle", "time": 13540.3, "timestamp": "03:45:40", "text": "就像你刚"}, {"type": "subtitle", "time": 13541.67, "timestamp": "03:45:41", "text": "[掌声]"}, {"type": "subtitle", "time": 13546.229, "timestamp": "03:45:46", "text": "花了整整一个小时才把我们接走。是的。"}, {"type": "subtitle", "time": 13549.429, "timestamp": "03:45:49", "text": "是的。是的。"}, {"type": "subtitle", "time": 13551.189, "timestamp": "03:45:51", "text": "他死的原因是他不尊重人。"}, {"type": "subtitle", "time": 13554.07, "timestamp": "03:45:54", "text": "边界。等等，你不是在直播吗？"}, {"type": "subtitle", "time": 13557.429, "timestamp": "03:45:57", "text": "寿司？我是。你是什​​么意思？死亡"}]
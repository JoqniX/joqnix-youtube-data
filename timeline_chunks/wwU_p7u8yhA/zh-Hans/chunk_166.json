[{"type": "subtitle", "time": 9961.67, "timestamp": "02:46:01", "text": "已经击杀12人。看他冲锋陷阵的样子。"}, {"type": "subtitle", "time": 9964.389, "timestamp": "02:46:04", "text": "这就是我想做的。"}, {"type": "subtitle", "time": 9967.269, "timestamp": "02:46:07", "text": "想象一下，如果我非常兴奋能得到那把弓箭……"}, {"type": "subtitle", "time": 9969.99, "timestamp": "02:46:09", "text": "性格就是这样，对吧？如果我甚至能想象到"}, {"type": "subtitle", "time": 9973.269, "timestamp": "02:46:13", "text": "如果我不玩，我不想那样。"}, {"type": "subtitle", "time": 9996.07, "timestamp": "02:46:36", "text": "我不习惯这样。我不。"}]
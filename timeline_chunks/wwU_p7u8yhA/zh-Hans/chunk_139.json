[{"type": "subtitle", "time": 8342.23, "timestamp": "02:19:02", "text": "母亲，"}, {"type": "subtitle", "time": 8362.15, "timestamp": "02:19:22", "text": "我的天哪，他把我按倒在地了。"}, {"type": "subtitle", "time": 8379.349, "timestamp": "02:19:39", "text": "为什么要用两个油箱呢？"}, {"type": "subtitle", "time": 8382.309, "timestamp": "02:19:42", "text": "您刚才说同意了吗，女士？是的，我做了。"}, {"type": "subtitle", "time": 8385.99, "timestamp": "02:19:45", "text": "哦，等等。我没有。是的。您好，女士。"}, {"type": "subtitle", "time": 8388.309, "timestamp": "02:19:48", "text": "等等，我想我确实这么做了。等等，我好像真的做了。"}, {"type": "subtitle", "time": 8390.87, "timestamp": "02:19:50", "text": "等等，我真的说了吗？等等，我想我已经这么做了。我"}, {"type": "subtitle", "time": 8394.07, "timestamp": "02:19:54", "text": "我想我的确跟小可爱打过招呼了。"}]
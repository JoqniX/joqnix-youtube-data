[{"type": "subtitle", "time": 18720.47, "timestamp": "05:12:00", "text": "给婴儿喂奶吗？大概。"}, {"type": "subtitle", "time": 18723.59, "timestamp": "05:12:03", "text": "是啊，她们的胸部就像个塞子一样。"}, {"type": "subtitle", "time": 18725.75, "timestamp": "05:12:05", "text": "电源插头。要么他们有"}, {"type": "subtitle", "time": 18729.75, "timestamp": "05:12:09", "text": "配方油还是纯粹的油"}, {"type": "subtitle", "time": 18732.23, "timestamp": "05:12:12", "text": "从插座吸气。是的。反而"}, {"type": "subtitle", "time": 18735.59, "timestamp": "05:12:15", "text": "他们不用婴儿油，而是用机油。"}, {"type": "subtitle", "time": 18738.55, "timestamp": "05:12:18", "text": "好的。去他妈的。他们只使用"}, {"type": "subtitle", "time": 18745.43, "timestamp": "05:12:25", "text": "是的。需要需要那些高什么什么"}, {"type": "subtitle", "time": 18747.91, "timestamp": "05:12:27", "text": "这些号码又打过来了吗？"}, {"type": "subtitle", "time": 18749.75, "timestamp": "05:12:29", "text": "辛烷值。我不知道是不是"}, {"type": "subtitle", "time": 18751.75, "timestamp": "05:12:31", "text": "就叫这个。"}, {"type": "subtitle", "time": 18753.43, "timestamp": "05:12:33", "text": "婴儿们"}, {"type": "subtitle", "time": 18756.628, "timestamp": "05:12:36", "text": "[音乐]"}, {"type": "subtitle", "time": 18758.55, "timestamp": "05:12:38", "text": "养育大个子婴儿。哦，他做了"}, {"type": "subtitle", "time": 18770.15, "timestamp": "05:12:50", "text": "愿上帝永远不要照耀你。"}, {"type": "subtitle", "time": 18778.07, "timestamp": "05:12:58", "text": "现在还没到晚上。哟，我们有"}]
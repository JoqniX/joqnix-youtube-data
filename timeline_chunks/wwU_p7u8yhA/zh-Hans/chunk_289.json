[{"type": "subtitle", "time": 17341.27, "timestamp": "04:49:01", "text": "这里。看看这该死的名字。祖基"}, {"type": "subtitle", "time": 17345.01, "timestamp": "04:49:05", "text": "这边。我被吃掉了。"}, {"type": "subtitle", "time": 17348.07, "timestamp": "04:49:08", "text": "[音乐]"}, {"type": "subtitle", "time": 17350.55, "timestamp": "04:49:10", "text": "我因为精神错乱而丧命。什么？"}, {"type": "subtitle", "time": 17353.51, "timestamp": "04:49:13", "text": "哦不，我快要崩溃了"}, {"type": "subtitle", "time": 17355.11, "timestamp": "04:49:15", "text": "我要强迫你接受它。"}, {"type": "subtitle", "time": 17357.19, "timestamp": "04:49:17", "text": "坚持，稍等。如何进行强制喂食？我知道。"}, {"type": "subtitle", "time": 17358.788, "timestamp": "04:49:18", "text": "你至少把蘑菇煮熟了吗？"}, {"type": "subtitle", "time": 17359.99, "timestamp": "04:49:19", "text": "是的，我已经做好了。我"}, {"type": "subtitle", "time": 17363.11, "timestamp": "04:49:23", "text": "已经煮好了。是的，她正在……"}, {"type": "subtitle", "time": 17365.43, "timestamp": "04:49:25", "text": "拿着吃掉。吃掉那些。如果你的"}, {"type": "subtitle", "time": 17367.83, "timestamp": "04:49:27", "text": "HP 如果你有足够的HP，那就有我"}, {"type": "subtitle", "time": 17371.35, "timestamp": "04:49:31", "text": "生命值不足。"}, {"type": "subtitle", "time": 17373.91, "timestamp": "04:49:33", "text": "就站在这里，就站在这里"}, {"type": "subtitle", "time": 17376.708, "timestamp": "04:49:36", "text": "这样蜘蛛就会出来，然后你"}, {"type": "subtitle", "time": 17379.99, "timestamp": "04:49:39", "text": "我知道这样做只是为了惹妹妹生气。"}, {"type": "subtitle", "time": 17381.91, "timestamp": "04:49:41", "text": "哦，找到了。是的。快跑，快跑。只是"}, {"type": "subtitle", "time": 17383.59, "timestamp": "04:49:43", "text": "跑步。不要靠近他们。让你的"}, {"type": "subtitle", "time": 17390.868, "timestamp": "04:49:50", "text": "好了。哦，请便。跑步"}, {"type": "subtitle", "time": 17393.11, "timestamp": "04:49:53", "text": "离开。不要走得太远。比如，你"}, {"type": "subtitle", "time": 17394.39, "timestamp": "04:49:54", "text": "知道蜘蛛正在攻击你"}, {"type": "subtitle", "time": 17395.67, "timestamp": "04:49:55", "text": "姐姐。等等，你妹妹为什么要走？"}, {"type": "subtitle", "time": 17399.27, "timestamp": "04:49:59", "text": "在那边？因为她要逃跑。让"}]
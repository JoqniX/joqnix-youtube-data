[{"type": "subtitle", "time": 16741.349, "timestamp": "04:39:01", "text": "这里。这里。嗯，Zazuki，吃Joix吧。吃"}, {"type": "subtitle", "time": 16744.15, "timestamp": "04:39:04", "text": "一些花。这里。他抓到我了。吃掉"}, {"type": "subtitle", "time": 16746.869, "timestamp": "04:39:06", "text": "花朵。让我来治好他。不。不。"}, {"type": "subtitle", "time": 16750.23, "timestamp": "04:39:10", "text": "疯狂。或许它要倒闭了。不，他"}, {"type": "subtitle", "time": 16752.23, "timestamp": "04:39:12", "text": "必须去采花。他不吃东西"}, {"type": "subtitle", "time": 16754.39, "timestamp": "04:39:14", "text": "花朵。疯狂。想当年"}, {"type": "subtitle", "time": 16756.39, "timestamp": "04:39:16", "text": "我仍然会被黑暗所困扰。如果他"}, {"type": "subtitle", "time": 16758.15, "timestamp": "04:39:18", "text": "他吃花，只恢复一点生命值。"}, {"type": "subtitle", "time": 16762.789, "timestamp": "04:39:22", "text": "脱离其中。哦，我得走了。"}, {"type": "subtitle", "time": 16765.189, "timestamp": "04:39:25", "text": "去。"}, {"type": "subtitle", "time": 16773.75, "timestamp": "04:39:33", "text": "好的。谁需要接受非常糟糕的治疗？"}, {"type": "subtitle", "time": 16782.47, "timestamp": "04:39:42", "text": "是的。"}, {"type": "subtitle", "time": 16784.31, "timestamp": "04:39:44", "text": "好了。我是说，这里。拥有其中之一"}, {"type": "subtitle", "time": 16786.07, "timestamp": "04:39:46", "text": "因为我不太吃浆果，所以我就不吃了。"}, {"type": "subtitle", "time": 16789.75, "timestamp": "04:39:49", "text": "这些。我只吃灵魂。"}, {"type": "subtitle", "time": 16791.91, "timestamp": "04:39:51", "text": "哦，"}, {"type": "subtitle", "time": 16796.07, "timestamp": "04:39:56", "text": "我需要肉。哦，是84。哦，不错。"}, {"type": "subtitle", "time": 16798.708, "timestamp": "04:39:58", "text": "我需要一根长矛去打猎，对吧。做"}]
[{"type": "subtitle", "time": 850.47, "timestamp": "00:14:10", "text": "为什么这个地方不行？"}, {"type": "subtitle", "time": 852.47, "timestamp": "00:14:12", "text": "好的。等待。呃。哦，那是来自……"}, {"type": "subtitle", "time": 854.71, "timestamp": "00:14:14", "text": "不同的射线。"}, {"type": "subtitle", "time": 858.629, "timestamp": "00:14:18", "text": "哦，看来我也得把你砍倒了。好的，"}, {"type": "subtitle", "time": 862.15, "timestamp": "00:14:22", "text": "我会这么做。等等，还有一个隐藏的。"}, {"type": "subtitle", "time": 879.509, "timestamp": "00:14:39", "text": "哦。哦不，那是……我的天哪，那是……"}, {"type": "subtitle", "time": 883.43, "timestamp": "00:14:43", "text": "那边有一大群骷髅兵。圣。"}, {"type": "subtitle", "time": 886.069, "timestamp": "00:14:46", "text": "圣"}, {"type": "subtitle", "time": 890.31, "timestamp": "00:14:50", "text": "抽烟时间。汉堡，别现在就打我。 D"}, {"type": "subtitle", "time": 892.87, "timestamp": "00:14:52", "text": "不过我在游戏里肯定会被人吸嗨的。"}, {"type": "subtitle", "time": 897.75, "timestamp": "00:14:57", "text": "大概有1、2、3、4、5、6、7个人。"}]
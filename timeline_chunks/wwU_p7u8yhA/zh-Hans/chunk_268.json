[{"type": "subtitle", "time": 16082.389, "timestamp": "04:28:02", "text": "我怎样才能得到一块木头？我该如何捐赠"}, {"type": "subtitle", "time": 16086.229, "timestamp": "04:28:06", "text": "木头？是的。呃，从你的库存里。全部"}, {"type": "subtitle", "time": 16087.99, "timestamp": "04:28:07", "text": "正确的。"}, {"type": "subtitle", "time": 16089.99, "timestamp": "04:28:09", "text": "不，没关系。好的。制作"}, {"type": "subtitle", "time": 16092.95, "timestamp": "04:28:12", "text": "背包。我们走吧。是的。屁股，做"}, {"type": "subtitle", "time": 16094.309, "timestamp": "04:28:14", "text": "你也有石头吗？我可以要一些吗？"}, {"type": "subtitle", "time": 16096.55, "timestamp": "04:28:16", "text": "石头？"}, {"type": "subtitle", "time": 16098.149, "timestamp": "04:28:18", "text": "哦，这是一台科学仪器吗？我需要"}, {"type": "subtitle", "time": 16099.59, "timestamp": "04:28:19", "text": "比如我想做一个背包，或者"}, {"type": "subtitle", "time": 16102.63, "timestamp": "04:28:22", "text": "某物。好了，伙计。"}, {"type": "subtitle", "time": 16105.349, "timestamp": "04:28:25", "text": "谢谢。"}, {"type": "subtitle", "time": 16107.429, "timestamp": "04:28:27", "text": "我们该如何制作《哦，我的天哪》。为什么"}, {"type": "subtitle", "time": 16111.269, "timestamp": "04:28:31", "text": "这里有青蛙吗？我没看到。"}, {"type": "subtitle", "time": 16113.11, "timestamp": "04:28:33", "text": "呃，"}, {"type": "subtitle", "time": 16115.349, "timestamp": "04:28:35", "text": "好的。让艾比盖尔把它杀了。愤怒"}, {"type": "subtitle", "time": 16118.309, "timestamp": "04:28:38", "text": "姐姐。惹恼妹妹。点击右键。"}, {"type": "subtitle", "time": 16120.79, "timestamp": "04:28:40", "text": "惹恼妹妹。"}, {"type": "subtitle", "time": 16124.87, "timestamp": "04:28:44", "text": "好的。右键点击你的妹妹。"}, {"type": "subtitle", "time": 16132.149, "timestamp": "04:28:52", "text": "好的。"}, {"type": "subtitle", "time": 16134.95, "timestamp": "04:28:54", "text": "她是那个说“嘿，来点青蛙腿”的人。她是"}, {"type": "subtitle", "time": 16138.07, "timestamp": "04:28:58", "text": "死的。她死了。好的，"}]
[{"type": "subtitle", "time": 17701.91, "timestamp": "04:55:01", "text": "我需要把它们煮熟吗？我是明星"}, {"type": "subtitle", "time": 17708.31, "timestamp": "04:55:08", "text": "好的。此外，这只蝴蝶的翅膀如果"}, {"type": "subtitle", "time": 17711.11, "timestamp": "04:55:11", "text": "你们真是太渴望治愈了。"}, {"type": "subtitle", "time": 17715.99, "timestamp": "04:55:15", "text": "不要贸然行动。再见。"}, {"type": "subtitle", "time": 17718.868, "timestamp": "04:55:18", "text": "让我狠狠揍那婊子一顿。嘿，"}, {"type": "subtitle", "time": 17721.03, "timestamp": "04:55:21", "text": "祖基，你在哪里？我的天哪，这太……"}, {"type": "subtitle", "time": 17722.948, "timestamp": "04:55:22", "text": "卡顿。我连一个安打都打不出来。"}, {"type": "subtitle", "time": 17729.99, "timestamp": "04:55:29", "text": "谁来做点什么啊。"}, {"type": "subtitle", "time": 17731.43, "timestamp": "04:55:31", "text": "对，过来。让我们耕种"}, {"type": "subtitle", "time": 17732.948, "timestamp": "04:55:32", "text": "青蛙。"}, {"type": "subtitle", "time": 17737.35, "timestamp": "04:55:37", "text": "欢迎。狗狗，你能帮我找些浆果吗？"}, {"type": "subtitle", "time": 17739.35, "timestamp": "04:55:39", "text": "呃，种子是可以吃的，对吧？得到"}, {"type": "subtitle", "time": 17742.47, "timestamp": "04:55:42", "text": "种子。种子在哪里？超过"}, {"type": "subtitle", "time": 17744.628, "timestamp": "04:55:44", "text": "我在这里。你可以在网上找到种子。"}, {"type": "subtitle", "time": 17747.43, "timestamp": "04:55:47", "text": "周围的地面散落着东西。我就是那个人"}, {"type": "subtitle", "time": 17749.51, "timestamp": "04:55:49", "text": "栽赃陷害。给我吧。哦，"}, {"type": "subtitle", "time": 17752.868, "timestamp": "04:55:52", "text": "等待。我把它给了苏琪。"}, {"type": "subtitle", "time": 17756.65, "timestamp": "04:55:56", "text": "姐姐，把种子给我。我饿了。"}, {"type": "subtitle", "time": 17759.11, "timestamp": "04:55:59", "text": "[笑声]"}]
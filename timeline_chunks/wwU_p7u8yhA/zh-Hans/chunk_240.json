[{"type": "subtitle", "time": 14403.91, "timestamp": "04:00:03", "text": "呃，NASA 发了一条评论，而我"}, {"type": "subtitle", "time": 14406.389, "timestamp": "04:00:06", "text": "就像我惹恼了NASA，因为他"}, {"type": "subtitle", "time": 14409.03, "timestamp": "04:00:09", "text": "比如，“呃，对不起，我刚才那样说不合适。”"}, {"type": "subtitle", "time": 14411.03, "timestamp": "04:00:11", "text": "“因为，”他点赞了这条评论。所以，我"}, {"type": "subtitle", "time": 14413.189, "timestamp": "04:00:13", "text": "我觉得我做了件非常非常……"}, {"type": "subtitle", "time": 14414.71, "timestamp": "04:00:14", "text": "意思是米奇死了，或者我说"}, {"type": "subtitle", "time": 14419.189, "timestamp": "04:00:19", "text": "非常糟糕的事情。他当时就……呃"}, {"type": "subtitle", "time": 14422.79, "timestamp": "04:00:22", "text": "他说，好吧，就按你说的做。所以，我"}, {"type": "subtitle", "time": 14426.15, "timestamp": "04:00:26", "text": "我私信问他，嘿，那是……"}, {"type": "subtitle", "time": 14427.51, "timestamp": "04:00:27", "text": "有事吗？我说了什么吗？"}, {"type": "subtitle", "time": 14429.99, "timestamp": "04:00:29", "text": "你是说麦当劳吗？还是说我冒犯了你？"}, {"type": "subtitle", "time": 14431.99, "timestamp": "04:00:31", "text": "你以任何方式影响到我吗？他就像在说，我没有"}, {"type": "subtitle", "time": 14434.15, "timestamp": "04:00:34", "text": "等等，你其实没看到我的"}, {"type": "subtitle", "time": 14437.67, "timestamp": "04:00:37", "text": "信息？他说我没有。他只是"}, {"type": "subtitle", "time": 14445.03, "timestamp": "04:00:45", "text": "这些笔记。"}, {"type": "subtitle", "time": 14453.59, "timestamp": "04:00:53", "text": "我喜欢这个。我没想到会这样。"}, {"type": "subtitle", "time": 14456.229, "timestamp": "04:00:56", "text": "他。真酷。"}, {"type": "subtitle", "time": 14458.87, "timestamp": "04:00:58", "text": "哦，等等。天快黑了。呃，Zuzuki。"}]
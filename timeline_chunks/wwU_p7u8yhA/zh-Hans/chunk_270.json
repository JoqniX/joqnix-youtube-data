[{"type": "subtitle", "time": 16202.07, "timestamp": "04:30:02", "text": "[音乐]"}, {"type": "subtitle", "time": 16204.63, "timestamp": "04:30:04", "text": "还有，你的头盔呢？我没有"}, {"type": "subtitle", "time": 16206.229, "timestamp": "04:30:06", "text": "东西。"}, {"type": "subtitle", "time": 16208.71, "timestamp": "04:30:08", "text": "新头盔。你说你不……是什么意思？"}, {"type": "subtitle", "time": 16212.229, "timestamp": "04:30:12", "text": "有东西吗？我的意思是，我只是……呃……"}, {"type": "subtitle", "time": 16214.389, "timestamp": "04:30:14", "text": "复活了。和"}, {"type": "subtitle", "time": 16216.87, "timestamp": "04:30:16", "text": "是的，我需要一些东西。你应该"}, {"type": "subtitle", "time": 16218.71, "timestamp": "04:30:18", "text": "戴上头盔。哦，不。这是因为你"}, {"type": "subtitle", "time": 16221.59, "timestamp": "04:30:21", "text": "死了。去收拾你那些死人的东西​​。获得你的"}, {"type": "subtitle", "time": 16224.07, "timestamp": "04:30:24", "text": "死气沉沉的。我知道你死在哪里。寻找"}, {"type": "subtitle", "time": 16227.59, "timestamp": "04:30:27", "text": "你的身体。大家好。"}, {"type": "subtitle", "time": 16232.95, "timestamp": "04:30:32", "text": "再见。嘿。我们走吧。你是怎么做的？"}, {"type": "subtitle", "time": 16236.71, "timestamp": "04:30:36", "text": "是不是很厉害？吸管黑客。"}, {"type": "subtitle", "time": 16239.99, "timestamp": "04:30:39", "text": "赶紧买这个。不，不，你只要去拿你的"}, {"type": "subtitle", "time": 16242.229, "timestamp": "04:30:42", "text": "收拾你的废弃物品。好了。哦，"}, {"type": "subtitle", "time": 16245.99, "timestamp": "04:30:45", "text": "谢谢。感谢上帝。"}, {"type": "subtitle", "time": 16248.79, "timestamp": "04:30:48", "text": "是的，到处都是垃圾邮件机器人。等等，有"}, {"type": "subtitle", "time": 16250.95, "timestamp": "04:30:50", "text": "那些正在观看直播的你们……"}, {"type": "subtitle", "time": 16252.469, "timestamp": "04:30:52", "text": "YouTube，你们是否也遇到了垃圾机器人？"}, {"type": "subtitle", "time": 16254.63, "timestamp": "04:30:54", "text": "出色地？我收到了很多垃圾邮件。"}, {"type": "subtitle", "time": 16257.99, "timestamp": "04:30:57", "text": "最近。我该如何获得？我们经历了一波……"}, {"type": "subtitle", "time": 16259.67, "timestamp": "04:30:59", "text": "之前有过垃圾邮件机器人，但我认为现在没有了。"}]
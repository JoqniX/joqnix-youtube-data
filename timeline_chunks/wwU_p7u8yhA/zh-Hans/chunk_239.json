[{"type": "subtitle", "time": 14340.15, "timestamp": "03:59:00", "text": "你忘了这个。哦，你喜欢这样做。"}, {"type": "subtitle", "time": 14341.67, "timestamp": "03:59:01", "text": "生的。我懂了。"}, {"type": "subtitle", "time": 14344.71, "timestamp": "03:59:04", "text": "不，是我发给你的。日本人，我"}, {"type": "subtitle", "time": 14347.91, "timestamp": "03:59:07", "text": "已发送给你。你真的这么做了？我给你发了一封"}, {"type": "subtitle", "time": 14350.55, "timestamp": "03:59:10", "text": "邀请次数大概三次。等等，我没有"}, {"type": "subtitle", "time": 14353.59, "timestamp": "03:59:13", "text": "随便挑一个。等等，我再发一个。"}, {"type": "subtitle", "time": 14356.95, "timestamp": "03:59:16", "text": "我明白了。我明白了。是的。是的。"}, {"type": "subtitle", "time": 14358.389, "timestamp": "03:59:18", "text": "韩，你想加入吗？我会寄给你"}, {"type": "subtitle", "time": 14362.389, "timestamp": "03:59:22", "text": "详情稍后公布。当然。"}, {"type": "subtitle", "time": 14365.11, "timestamp": "03:59:25", "text": "也不会有任何障碍物。"}, {"type": "subtitle", "time": 14372.55, "timestamp": "03:59:32", "text": "哦，是的。我需要讲述这个故事，因为"}, {"type": "subtitle", "time": 14374.87, "timestamp": "03:59:34", "text": "那时候我还在读……"}, {"type": "subtitle", "time": 14377.75, "timestamp": "03:59:37", "text": "休息是因为我的电脑坏了，而且我……"}, {"type": "subtitle", "time": 14380.55, "timestamp": "03:59:40", "text": "其他人。嗯"}, {"type": "subtitle", "time": 14382.15, "timestamp": "03:59:42", "text": "所以基本上，我上传了一张照片"}, {"type": "subtitle", "time": 14384.71, "timestamp": "03:59:44", "text": "死去的米奇说得对。"}, {"type": "subtitle", "time": 14387.03, "timestamp": "03:59:47", "text": "什么？"}, {"type": "subtitle", "time": 14389.429, "timestamp": "03:59:49", "text": "就像我小时候住的那家废弃的麦当劳一样"}, {"type": "subtitle", "time": 14391.51, "timestamp": "03:59:51", "text": "比如出去慢跑。我发现了一具尸体"}, {"type": "subtitle", "time": 14393.99, "timestamp": "03:59:53", "text": "米奇·德的店就像一条小巷，而我"}, {"type": "subtitle", "time": 14395.75, "timestamp": "03:59:55", "text": "我拍了张照片，然后就……"}, {"type": "subtitle", "time": 14399.269, "timestamp": "03:59:59", "text": "已发布在社区帖子中。后"}]
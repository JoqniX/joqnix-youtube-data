[{"type": "subtitle", "time": 541.67, "timestamp": "00:09:01", "text": "所以，呃，我们有了1、2、3、4，"}, {"type": "subtitle", "time": 544.31, "timestamp": "00:09:04", "text": "四个轴。那么，我应该砍掉谁？"}, {"type": "subtitle", "time": 545.75, "timestamp": "00:09:05", "text": "今天？"}, {"type": "subtitle", "time": 550.23, "timestamp": "00:09:10", "text": "或许，或许你，或许你"}, {"type": "subtitle", "time": 569.509, "timestamp": "00:09:29", "text": "希望我没耽搁太久。多久"}, {"type": "subtitle", "time": 571.829, "timestamp": "00:09:31", "text": "是我吗？"}, {"type": "subtitle", "time": 574.47, "timestamp": "00:09:34", "text": "我待了多久？"}, {"type": "subtitle", "time": 581.91, "timestamp": "00:09:41", "text": "记住。所以我想我大概拍了10张"}, {"type": "subtitle", "time": 583.91, "timestamp": "00:09:43", "text": "几分钟左右。哦，天哪，现在我搞砸了"}, {"type": "subtitle", "time": 587.11, "timestamp": "00:09:47", "text": "你等了10分钟。我会更快"}, {"type": "subtitle", "time": 590.31, "timestamp": "00:09:50", "text": "下次。现在我将超级超级"}, {"type": "subtitle", "time": 593.03, "timestamp": "00:09:53", "text": "下次更快。"}]
[{"type": "subtitle", "time": 17521.99, "timestamp": "04:52:01", "text": "我觉得你也可以喜欢原型。"}, {"type": "subtitle", "time": 17524.31, "timestamp": "04:52:04", "text": "东西，对吧？是的。您可以制作原型。"}, {"type": "subtitle", "time": 17527.75, "timestamp": "04:52:07", "text": "让你保持理智的东西。呃"}, {"type": "subtitle", "time": 17531.83, "timestamp": "04:52:11", "text": "如何制作一个公鸡？杰森，"}, {"type": "subtitle", "time": 17534.788, "timestamp": "04:52:14", "text": "驾驶舱混淆是什么类型的"}, {"type": "subtitle", "time": 17536.47, "timestamp": "04:52:16", "text": "为什么说捕鱼量不足"}, {"type": "subtitle", "time": 17543.59, "timestamp": "04:52:23", "text": "射击。你不能在海里钓鱼。你"}, {"type": "subtitle", "time": 17547.11, "timestamp": "04:52:27", "text": "可以在池塘里钓鱼。你需要去钓鱼。做"}, {"type": "subtitle", "time": 17549.99, "timestamp": "04:52:29", "text": "顺便问一下，你们谁有石头吗？呃，我"}, {"type": "subtitle", "time": 17552.628, "timestamp": "04:52:32", "text": "有八个。我需要锤子，所以我"}, {"type": "subtitle", "time": 17553.83, "timestamp": "04:52:33", "text": "房子一到我就可以拿我的相机了。"}, {"type": "subtitle", "time": 17556.868, "timestamp": "04:52:36", "text": "向下。我需要，我需要做一个火鸡锅。我"}, {"type": "subtitle", "time": 17559.27, "timestamp": "04:52:39", "text": "想做个火鸡锅。"}, {"type": "subtitle", "time": 17571.35, "timestamp": "04:52:51", "text": "等等，祝福之翼算不算？"}, {"type": "subtitle", "time": 17573.35, "timestamp": "04:52:53", "text": "肉？是的，我觉得是这样。是的。哦，"}, {"type": "subtitle", "time": 17576.708, "timestamp": "04:52:56", "text": "等待。乔克。乔克在哪儿？我觉得我"}, {"type": "subtitle", "time": 17578.708, "timestamp": "04:52:58", "text": "我猜是食物。坚持，稍等。有"}]
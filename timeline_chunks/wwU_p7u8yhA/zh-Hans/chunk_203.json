[{"type": "subtitle", "time": 12182.15, "timestamp": "03:23:02", "text": "为这款游戏提供顾问和其他相关人员"}, {"type": "subtitle", "time": 12184.07, "timestamp": "03:23:04", "text": "做什么等等。谢谢。"}, {"type": "subtitle", "time": 12187.269, "timestamp": "03:23:07", "text": "谢谢 Kaiishi。我希望你的游戏"}, {"type": "subtitle", "time": 12189.91, "timestamp": "03:23:09", "text": "下载完成了，但是我玩不了。"}, {"type": "subtitle", "time": 12192.71, "timestamp": "03:23:12", "text": "现在玩吧，不过我们很快再玩一次。好的，"}, {"type": "subtitle", "time": 12196.389, "timestamp": "03:23:16", "text": "我们一起玩吧"}, {"type": "subtitle", "time": 12198.229, "timestamp": "03:23:18", "text": "然后"}, {"type": "subtitle", "time": 12200.71, "timestamp": "03:23:20", "text": "感谢您的光临。真的"}, {"type": "subtitle", "time": 12213.19, "timestamp": "03:23:33", "text": "希望你今天过得愉快。你好，请问……"}, {"type": "subtitle", "time": 12217.11, "timestamp": "03:23:37", "text": "祝您今天愉快，并告诉您这里来了一位新人。"}, {"type": "subtitle", "time": 12220.389, "timestamp": "03:23:40", "text": "欢迎。欢迎光临。谢谢你"}, {"type": "subtitle", "time": 12223.03, "timestamp": "03:23:43", "text": "来到溪边。我不知道……"}, {"type": "subtitle", "time": 12225.75, "timestamp": "03:23:45", "text": "你今天是从哪里找到我的直播的？"}, {"type": "subtitle", "time": 12227.67, "timestamp": "03:23:47", "text": "还是要谢谢你过来。真的"}, {"type": "subtitle", "time": 12229.75, "timestamp": "03:23:49", "text": "意义重大。"}, {"type": "subtitle", "time": 12233.83, "timestamp": "03:23:53", "text": "然后是特别版，希望你"}, {"type": "subtitle", "time": 12237.59, "timestamp": "03:23:57", "text": "睡得好。希望你仍然不是……"}]
[{"type": "subtitle", "time": 302.469, "timestamp": "00:05:02", "text": "最后，缩略图中的喜悦是"}, {"type": "subtitle", "time": 315.83, "timestamp": "00:05:15", "text": "我真希望有个吹风机，可惜没法用。"}, {"type": "subtitle", "time": 318.79, "timestamp": "00:05:18", "text": "我有点儿爆发了，就像我两个朋友一样。"}, {"type": "subtitle", "time": 322.15, "timestamp": "00:05:22", "text": "吹风机实际上用它来吹干"}, {"type": "subtitle", "time": 325.029, "timestamp": "00:05:25", "text": "我想是因为使用过度吧。"}, {"type": "subtitle", "time": 328.71, "timestamp": "00:05:28", "text": "唉，画毛巾真费劲。"}, {"type": "subtitle", "time": 331.59, "timestamp": "00:05:31", "text": "再见。保持自然状态"}, {"type": "subtitle", "time": 336.79, "timestamp": "00:05:36", "text": "头发干得像没有自然风一样。"}, {"type": "subtitle", "time": 341.59000000000003, "timestamp": "00:05:41", "text": "东西。如果我喜欢那样，我就会……"}, {"type": "subtitle", "time": 343.67, "timestamp": "00:05:43", "text": "生病或者类似的事情，我会感觉像"}, {"type": "subtitle", "time": 345.189, "timestamp": "00:05:45", "text": "头痛"}, {"type": "subtitle", "time": 347.029, "timestamp": "00:05:47", "text": "疼痛。"}, {"type": "subtitle", "time": 353.59000000000003, "timestamp": "00:05:53", "text": "我想知道其他人是怎么做到的。哦，不。"}, {"type": "subtitle", "time": 357.189, "timestamp": "00:05:57", "text": "你用什么方法吹干头发？"}]
[{"type": "subtitle", "time": 18426.628, "timestamp": "05:07:06", "text": "我打算把这个放进去。我只是"}, {"type": "subtitle", "time": 18432.31, "timestamp": "05:07:12", "text": "唉，我在这里一点用处都没有。你在开玩笑吧"}, {"type": "subtitle", "time": 18433.83, "timestamp": "05:07:13", "text": "我？"}, {"type": "subtitle", "time": 18435.51, "timestamp": "05:07:15", "text": "等待，"}, {"type": "subtitle", "time": 18437.11, "timestamp": "05:07:17", "text": "还有人有食物要放进去吗？"}, {"type": "subtitle", "time": 18438.868, "timestamp": "05:07:18", "text": "食物箱？"}, {"type": "subtitle", "time": 18442.628, "timestamp": "05:07:22", "text": "我正在这里进行一些讨论。有一些"}, {"type": "subtitle", "time": 18444.788, "timestamp": "05:07:24", "text": "胸口是怪物的肉。我正在获得"}, {"type": "subtitle", "time": 18448.628, "timestamp": "05:07:28", "text": "就在那里。我死了。"}, {"type": "subtitle", "time": 18452.04, "timestamp": "05:07:32", "text": "你疯了。"}, {"type": "subtitle", "time": 18454.47, "timestamp": "05:07:34", "text": "[音乐]"}, {"type": "subtitle", "time": 18455.75, "timestamp": "05:07:35", "text": "等等，食物箱在哪儿来着？"}, {"type": "subtitle", "time": 18458.07, "timestamp": "05:07:38", "text": "哪个是食物箱？疯狂的。哦，"}, {"type": "subtitle", "time": 18460.23, "timestamp": "05:07:40", "text": "那可不是什么好兆头。呃，做一个"}, {"type": "subtitle", "time": 18463.67, "timestamp": "05:07:43", "text": "姐妹之类的。"}, {"type": "subtitle", "time": 18467.19, "timestamp": "05:07:47", "text": "铃木不知道那是什么。我会"}, {"type": "subtitle", "time": 18471.67, "timestamp": "05:07:51", "text": "我一边快速演练一边制定计划。"}, {"type": "subtitle", "time": 18473.03, "timestamp": "05:07:53", "text": "你知道吗？坚持，稍等。嗯，我想我可以"}, {"type": "subtitle", "time": 18474.55, "timestamp": "05:07:54", "text": "让主为你带来艰难的指引。坚持，稍等。"}]
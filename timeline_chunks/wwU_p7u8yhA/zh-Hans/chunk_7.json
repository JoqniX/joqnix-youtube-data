[{"type": "subtitle", "time": 423.27, "timestamp": "00:07:03", "text": "僵尸。所以我就想，"}, {"type": "subtitle", "time": 425.909, "timestamp": "00:07:05", "text": "那不可能发生。我需要一个我"}, {"type": "subtitle", "time": 427.99, "timestamp": "00:07:07", "text": "需要断开连接。我收集了我所有的"}, {"type": "subtitle", "time": 434.71, "timestamp": "00:07:14", "text": "这是什么？这是什么？什么是"}, {"type": "subtitle", "time": 444.15, "timestamp": "00:07:24", "text": "所以，到目前为止，我们已经种植了"}, {"type": "subtitle", "time": 447.909, "timestamp": "00:07:27", "text": "这么多树。樱花树。现在我们"}, {"type": "subtitle", "time": 452.30899999999997, "timestamp": "00:07:32", "text": "需要对整个生物群落进行种植。哦，真扫兴。"}, {"type": "subtitle", "time": 455.029, "timestamp": "00:07:35", "text": "让我们尽力而为。"}, {"type": "subtitle", "time": 458.39, "timestamp": "00:07:38", "text": "哦，这里还有其他人。"}, {"type": "subtitle", "time": 460.95, "timestamp": "00:07:40", "text": "是的。哈。"}, {"type": "subtitle", "time": 463.189, "timestamp": "00:07:43", "text": "现在还有哪些店营业？哦，是的，我想我看到了。"}, {"type": "subtitle", "time": 468.22, "timestamp": "00:07:48", "text": "不，然后就是那件事"}]
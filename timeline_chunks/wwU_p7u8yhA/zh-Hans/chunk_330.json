[{"type": "subtitle", "time": 19800.948, "timestamp": "05:30:00", "text": "有人给你食物。哦，到我身边来。"}, {"type": "subtitle", "time": 19802.868, "timestamp": "05:30:02", "text": "我要"}, {"type": "subtitle", "time": 19803.83, "timestamp": "05:30:03", "text": "对我来说，但这会要了你的命。"}, {"type": "subtitle", "time": 19806.39, "timestamp": "05:30:06", "text": "实际上，我有一个。坚持，稍等。不，绝不。"}, {"type": "subtitle", "time": 19810.548, "timestamp": "05:30:10", "text": "头脑。没关系。"}, {"type": "subtitle", "time": 19813.59, "timestamp": "05:30:13", "text": "妈的。不。哦，我们真的需要得到"}, {"type": "subtitle", "time": 19816.47, "timestamp": "05:30:16", "text": "有些人在篝火旁玩得很开心"}, {"type": "subtitle", "time": 19819.83, "timestamp": "05:30:19", "text": "这里。好了。是的。"}, {"type": "subtitle", "time": 19835.83, "timestamp": "05:30:35", "text": "每个人都在死去。"}, {"type": "subtitle", "time": 19837.83, "timestamp": "05:30:37", "text": "不要下去。没那么做。"}, {"type": "subtitle", "time": 19841.43, "timestamp": "05:30:41", "text": "这是怎么回事？嘿，哥们儿。哦，哟。嘿。"}, {"type": "subtitle", "time": 19845.67, "timestamp": "05:30:45", "text": "哟，哥们儿，最近怎么样？你好吗？哦，"}, {"type": "subtitle", "time": 19847.51, "timestamp": "05:30:47", "text": "为什么这里所有人都死了？哦，"}, {"type": "subtitle", "time": 19848.948, "timestamp": "05:30:48", "text": "所有人都死了。只有我们三个"}, {"type": "subtitle", "time": 19851.99, "timestamp": "05:30:51", "text": "左边。是的，大家都死了。我要"}, {"type": "subtitle", "time": 19858.23, "timestamp": "05:30:58", "text": "顺便一提，这是猎犬挥手致意。祝你好运。哦，"}]
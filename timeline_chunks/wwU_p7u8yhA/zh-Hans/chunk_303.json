[{"type": "subtitle", "time": 18186.55, "timestamp": "05:03:06", "text": "齿轮在哪儿？哦，齿轮在这里。"}, {"type": "subtitle", "time": 18189.11, "timestamp": "05:03:09", "text": "好的。哦，胸部。"}, {"type": "subtitle", "time": 18191.11, "timestamp": "05:03:11", "text": "好的。"}, {"type": "subtitle", "time": 18194.15, "timestamp": "05:03:14", "text": "如何选择宝箱？我的天啊，"}, {"type": "subtitle", "time": 18196.31, "timestamp": "05:03:16", "text": "那可是很多次传球啊。 Passify。路过"}, {"type": "subtitle", "time": 18198.39, "timestamp": "05:03:18", "text": "从你姐姐身边经过。姐妹，姐妹。你的"}, {"type": "subtitle", "time": 18200.708, "timestamp": "05:03:20", "text": "姐姐。"}, {"type": "subtitle", "time": 18203.35, "timestamp": "05:03:23", "text": "安抚她。"}, {"type": "subtitle", "time": 18210.47, "timestamp": "05:03:30", "text": "[音乐]"}, {"type": "subtitle", "time": 18212.628, "timestamp": "05:03:32", "text": "哦，我会给一些。你离开了"}, {"type": "subtitle", "time": 18215.99, "timestamp": "05:03:35", "text": "该死的鸡蛋。谢谢。快点。"}, {"type": "subtitle", "time": 18217.43, "timestamp": "05:03:37", "text": "好工作。谢谢你的帮助。但"}, {"type": "subtitle", "time": 18220.39, "timestamp": "05:03:40", "text": "我的天，好险啊。"}, {"type": "subtitle", "time": 18222.42, "timestamp": "05:03:42", "text": "金块。"}, {"type": "subtitle", "time": 18224.39, "timestamp": "05:03:44", "text": "[音乐]"}, {"type": "subtitle", "time": 18226.788, "timestamp": "05:03:46", "text": "蜘蛛族。好的，我会把它放进去。"}, {"type": "subtitle", "time": 18230.15, "timestamp": "05:03:50", "text": "盒子。咱们重新开始种地吧。"}, {"type": "subtitle", "time": 18233.19, "timestamp": "05:03:53", "text": "呃，我该怎么办？我应该把……放在哪里？"}, {"type": "subtitle", "time": 18237.27, "timestamp": "05:03:57", "text": "食物？我进了这边的储藏室。在"}]
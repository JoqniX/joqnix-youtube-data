[{"type": "subtitle", "time": 14701.67, "timestamp": "04:05:01", "text": "哦，你可以从你的物品栏里取出它。"}, {"type": "subtitle", "time": 14705.51, "timestamp": "04:05:05", "text": "然后点击一个角色。"}, {"type": "subtitle", "time": 14711.91, "timestamp": "04:05:11", "text": "岩石。一样。"}, {"type": "subtitle", "time": 14714.229, "timestamp": "04:05:14", "text": "如何制作燧石？"}, {"type": "subtitle", "time": 14717.269, "timestamp": "04:05:17", "text": "糟糕。你，你只是要去捡起来"}, {"type": "subtitle", "time": 14725.83, "timestamp": "04:05:25", "text": "那不是个好主意。还有这个"}, {"type": "subtitle", "time": 14728.87, "timestamp": "04:05:28", "text": "草。哦，这边有块石头。哦"}, {"type": "subtitle", "time": 14732.79, "timestamp": "04:05:32", "text": "上帝。我的天哪。对不起，各位。"}, {"type": "subtitle", "time": 14734.55, "timestamp": "04:05:34", "text": "这就是我进度有点慢的原因。我该怎么做？"}, {"type": "subtitle", "time": 14736.79, "timestamp": "04:05:36", "text": "粉碎？"}, {"type": "subtitle", "time": 14738.71, "timestamp": "04:05:38", "text": "不，我以为我坠机了。我下去了"}, {"type": "subtitle", "time": 14744.07, "timestamp": "04:05:44", "text": "镐。我的天哪。哦，我需要点赞。"}, {"type": "subtitle", "time": 14746.55, "timestamp": "04:05:46", "text": "工具。您可以查看相关要求。"}, {"type": "subtitle", "time": 14749.269, "timestamp": "04:05:49", "text": "你需要的东西。该死的鸟。我该怎么做？"}, {"type": "subtitle", "time": 14751.91, "timestamp": "04:05:51", "text": "找个燧石？你要操这个吗？"}, {"type": "subtitle", "time": 14755.03, "timestamp": "04:05:55", "text": "地面？在地板上。我弄到了一块燧石。它是"}, {"type": "subtitle", "time": 14758.63, "timestamp": "04:05:58", "text": "一块石头。找找看。我仍然"}]
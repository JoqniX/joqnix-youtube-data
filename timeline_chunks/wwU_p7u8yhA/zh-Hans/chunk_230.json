[{"type": "subtitle", "time": 13802.229, "timestamp": "03:50:02", "text": "后退。它不见了。它现在会自动修复"}, {"type": "subtitle", "time": 13804.55, "timestamp": "03:50:04", "text": "进而。"}, {"type": "subtitle", "time": 13806.63, "timestamp": "03:50:06", "text": "嗯，"}, {"type": "subtitle", "time": 13809.83, "timestamp": "03:50:09", "text": "是的，Z生日快乐。"}, {"type": "subtitle", "time": 13813.67, "timestamp": "03:50:13", "text": "大家一起祝他生日快乐"}, {"type": "subtitle", "time": 13818.469, "timestamp": "03:50:18", "text": "你。你住在动物园里。"}, {"type": "subtitle", "time": 13825.67, "timestamp": "03:50:25", "text": "祝你生日快乐。好的。好的。快乐的"}, {"type": "subtitle", "time": 13828.389, "timestamp": "03:50:28", "text": "生日等等。"}, {"type": "subtitle", "time": 13831.189, "timestamp": "03:50:31", "text": "祝你生日快乐。你会是"}, {"type": "subtitle", "time": 13833.189, "timestamp": "03:50:33", "text": "如果有人说“我希望这”，我会感到惊讶。"}, {"type": "subtitle", "time": 13841.59, "timestamp": "03:50:41", "text": "哦，是的。"}, {"type": "subtitle", "time": 13855.51, "timestamp": "03:50:55", "text": "可以邀请我吗？我现在还没进入游戏。"}, {"type": "subtitle", "time": 13859.349, "timestamp": "03:50:59", "text": "现在。我是一名职业玩家。我不参加。"}]
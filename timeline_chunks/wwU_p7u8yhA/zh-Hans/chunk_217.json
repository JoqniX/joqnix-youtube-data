[{"type": "subtitle", "time": 13027.83, "timestamp": "03:37:07", "text": "我叫铃木祖利子，您当地的"}, {"type": "subtitle", "time": 13030.71, "timestamp": "03:37:10", "text": "一位已经活了一千年的太空伙伴"}, {"type": "subtitle", "time": 13033.91, "timestamp": "03:37:13", "text": "太空年。"}, {"type": "subtitle", "time": 13037.269, "timestamp": "03:37:17", "text": "嗯哼。哦。老的"}, {"type": "subtitle", "time": 13039.03, "timestamp": "03:37:19", "text": "最年轻的。最年轻的。他是"}, {"type": "subtitle", "time": 13040.87, "timestamp": "03:37:20", "text": "参与我事务的最小的人"}, {"type": "subtitle", "time": 13053.11, "timestamp": "03:37:33", "text": "我是说，"}, {"type": "subtitle", "time": 13056.15, "timestamp": "03:37:36", "text": "它甚至都不"}, {"type": "subtitle", "time": 13060.229, "timestamp": "03:37:40", "text": "他妈的老了。通常在合作中，我会这样做"}, {"type": "subtitle", "time": 13063.91, "timestamp": "03:37:43", "text": "错过。她就像个老奶奶一样。"}, {"type": "subtitle", "time": 13066.15, "timestamp": "03:37:46", "text": "呃，我现在是了。"}, {"type": "subtitle", "time": 13069.67, "timestamp": "03:37:49", "text": "欧安，快点。没人玩多人游戏"}, {"type": "subtitle", "time": 13072.469, "timestamp": "03:37:52", "text": "有我在玩游戏，所以我从来不需要它。"}, {"type": "subtitle", "time": 13074.63, "timestamp": "03:37:54", "text": "哈哈。孤独。"}, {"type": "subtitle", "time": 13079.19, "timestamp": "03:37:59", "text": "你不会用它玩电子游戏。我"}]
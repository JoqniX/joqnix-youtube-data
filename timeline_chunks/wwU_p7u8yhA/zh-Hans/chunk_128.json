[{"type": "subtitle", "time": 7684.069, "timestamp": "02:08:04", "text": "什么？那真是太酷了。"}, {"type": "subtitle", "time": 7688.25, "timestamp": "02:08:08", "text": "还是没能得到更多。快点。"}, {"type": "subtitle", "time": 7689.51, "timestamp": "02:08:09", "text": "[音乐]"}, {"type": "subtitle", "time": 7692.55, "timestamp": "02:08:12", "text": "啊，我只需要找回那种态度。看"}, {"type": "subtitle", "time": 7696.229, "timestamp": "02:08:16", "text": "他是如何做到的。你知道吗？我接受"}, {"type": "subtitle", "time": 7715.91, "timestamp": "02:08:35", "text": "[音乐]"}, {"type": "subtitle", "time": 7717.75, "timestamp": "02:08:37", "text": "你玩过《守望先锋》吗？不，不，这是"}, {"type": "subtitle", "time": 7719.75, "timestamp": "02:08:39", "text": "我的第一场游戏"}]
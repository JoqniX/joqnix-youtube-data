[{"type": "subtitle", "time": 2641.91, "timestamp": "00:44:01", "text": "中等或低，因为你知道守望先锋"}, {"type": "subtitle", "time": 2645.91, "timestamp": "00:44:05", "text": "是一款好游戏，质量很高。所以"}, {"type": "subtitle", "time": 2648.23, "timestamp": "00:44:08", "text": "是的，性能统计数据，我会打开"}, {"type": "subtitle", "time": 2651.27, "timestamp": "00:44:11", "text": "开启。呃，网络延迟，我会转"}, {"type": "subtitle", "time": 2654.23, "timestamp": "00:44:14", "text": "就是那个。系统时钟，当然。"}, {"type": "subtitle", "time": 2657.109, "timestamp": "00:44:17", "text": "FPS，没错。 GPU温度，我会打开"}, {"type": "subtitle", "time": 2661.03, "timestamp": "00:44:21", "text": "我把它关掉了，因为我担心那个。"}, {"type": "subtitle", "time": 2665.19, "timestamp": "00:44:25", "text": "是的。申请。您好，声音已设置为默认设置。"}, {"type": "subtitle", "time": 2667.19, "timestamp": "00:44:27", "text": "呃"}, {"type": "subtitle", "time": 2669.589, "timestamp": "00:44:29", "text": "是的，这些都是我的虚拟线缆。"}, {"type": "subtitle", "time": 2674.39, "timestamp": "00:44:34", "text": "我的天哪，全是虚拟线缆。"}, {"type": "subtitle", "time": 2681.91, "timestamp": "00:44:41", "text": "所以，我的输出将是输入系统。"}, {"type": "subtitle", "time": 2684.39, "timestamp": "00:44:44", "text": "等等，什么？"}, {"type": "subtitle", "time": 2687.829, "timestamp": "00:44:47", "text": "你可以拥有管理员权限"}, {"type": "subtitle", "time": 2690.71, "timestamp": "00:44:50", "text": "什么？我的天啊。等待。好的。"}, {"type": "subtitle", "time": 2694.39, "timestamp": "00:44:54", "text": "敌人被消灭后游戏继续。"}]
[{"type": "subtitle", "time": 721.35, "timestamp": "00:12:01", "text": "我就是这么跟他们说的。但是但是"}, {"type": "subtitle", "time": 735.509, "timestamp": "00:12:15", "text": "虽然我没有这方面的天赋"}, {"type": "subtitle", "time": 738.87, "timestamp": "00:12:18", "text": "歌唱。我想在那方面做到最好。"}, {"type": "subtitle", "time": 745.99, "timestamp": "00:12:25", "text": "但主要还是想尽我所能。"}, {"type": "subtitle", "time": 748.55, "timestamp": "00:12:28", "text": "音乐制作实际上就是制作音乐。"}, {"type": "subtitle", "time": 751.91, "timestamp": "00:12:31", "text": "音乐是我想去的主要部分"}, {"type": "subtitle", "time": 753.509, "timestamp": "00:12:33", "text": "为了"}, {"type": "subtitle", "time": 757.829, "timestamp": "00:12:37", "text": "是的，你好，Robandal，欢迎！"}, {"type": "subtitle", "time": 760.23, "timestamp": "00:12:40", "text": "你好吗"}, {"type": "subtitle", "time": 766.15, "timestamp": "00:12:46", "text": "而且这是你第一次来这里吗？你好！"}, {"type": "subtitle", "time": 769.11, "timestamp": "00:12:49", "text": "欢迎。欢迎。"}, {"type": "subtitle", "time": 770.629, "timestamp": "00:12:50", "text": "今天你是怎么找到我的？情况如何？"}, {"type": "subtitle", "time": 773.99, "timestamp": "00:12:53", "text": "你？等等，那个用户名似乎"}, {"type": "subtitle", "time": 775.59, "timestamp": "00:12:55", "text": "熟悉的。"}, {"type": "subtitle", "time": 779.269, "timestamp": "00:12:59", "text": "等等，这不是罗布吗？等等，"}]
[{"type": "subtitle", "time": 14885.429, "timestamp": "04:08:05", "text": "跑步。"}, {"type": "subtitle", "time": 14887.349, "timestamp": "04:08:07", "text": "我想这人应该是祖基。我不知道"}, {"type": "subtitle", "time": 14888.87, "timestamp": "04:08:08", "text": "这是谁的花？为什么会有这样的"}, {"type": "subtitle", "time": 14890.71, "timestamp": "04:08:10", "text": "阿比盖尔放在地板上的花？谁是"}, {"type": "subtitle", "time": 14897.99, "timestamp": "04:08:17", "text": "获取盔甲。在学会如何做之前，不要贸然行动。"}, {"type": "subtitle", "time": 14899.75, "timestamp": "04:08:19", "text": "躲避和塞东西。好的。初学者会得到"}, {"type": "subtitle", "time": 14902.15, "timestamp": "04:08:22", "text": "首先要学习如何穿戴盔甲，他们"}, {"type": "subtitle", "time": 14904.15, "timestamp": "04:08:24", "text": "不知道怎么获得盔甲。"}, {"type": "subtitle", "time": 14906.63, "timestamp": "04:08:26", "text": "是啊，我不知道。"}, {"type": "subtitle", "time": 14908.229, "timestamp": "04:08:28", "text": "你不能指望初学者学会"}, {"type": "subtitle", "time": 14911.189, "timestamp": "04:08:31", "text": "东西。这是一个缓慢的过程。这是一个缓慢的过程"}, {"type": "subtitle", "time": 14913.349, "timestamp": "04:08:33", "text": "过程。这款游戏真的非常火爆。"}, {"type": "subtitle", "time": 14920.07, "timestamp": "04:08:40", "text": "哦，我们需要建造一个光源，这样我们才能建造"}, {"type": "subtitle", "time": 14922.71, "timestamp": "04:08:42", "text": "500小时。"}, {"type": "subtitle", "time": 14924.389, "timestamp": "04:08:44", "text": "糟糕，我没看到。等待，"}, {"type": "subtitle", "time": 14927.11, "timestamp": "04:08:47", "text": "铃木，这是你的花吗？嗯，什么"}, {"type": "subtitle", "time": 14931.189, "timestamp": "04:08:51", "text": "花？铃木之花。摘下那朵花"}, {"type": "subtitle", "time": 14932.95, "timestamp": "04:08:52", "text": "站立。那应该会召唤你"}, {"type": "subtitle", "time": 14934.55, "timestamp": "04:08:54", "text": "操你妹妹。是的。不，下来。"}, {"type": "subtitle", "time": 14936.55, "timestamp": "04:08:56", "text": "坠落。你的立场是什么？铃木。我"}, {"type": "subtitle", "time": 14939.269, "timestamp": "04:08:59", "text": "我拿到一枚硬币。混蛋。你忘记了你的"}]
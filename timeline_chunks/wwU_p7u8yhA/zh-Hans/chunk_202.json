[{"type": "subtitle", "time": 12123.19, "timestamp": "03:22:03", "text": "刚才在说这个……呃……新玩意儿"}, {"type": "subtitle", "time": 12126.79, "timestamp": "03:22:06", "text": "我想尝试引入……"}, {"type": "subtitle", "time": 12129.349, "timestamp": "03:22:09", "text": "从推特或其他任何地方引进用户"}, {"type": "subtitle", "time": 12131.19, "timestamp": "03:22:11", "text": "如果他们像潜水员一样，其他平台也会如此。"}, {"type": "subtitle", "time": 12134.79, "timestamp": "03:22:14", "text": "或者诸如此类的事情，这样我就可以预料到他们能做什么。"}, {"type": "subtitle", "time": 12137.03, "timestamp": "03:22:17", "text": "是的，这样他们就可以观看这个视频了。"}, {"type": "subtitle", "time": 12139.75, "timestamp": "03:22:19", "text": "就像他们期望的那样，他们会……"}, {"type": "subtitle", "time": 12142.389, "timestamp": "03:22:22", "text": "比如，对一条流抱有期望"}, {"type": "subtitle", "time": 12144.63, "timestamp": "03:22:24", "text": "就像一个概要，概括一下将会发生什么。"}, {"type": "subtitle", "time": 12147.11, "timestamp": "03:22:27", "text": "我的流媒体播放列表和所有相关内容是什么？"}, {"type": "subtitle", "time": 12149.429, "timestamp": "03:22:29", "text": "今天的活动即将举行。就像……"}, {"type": "subtitle", "time": 12152.71, "timestamp": "03:22:32", "text": "日程安排，但有一天就像……"}, {"type": "subtitle", "time": 12155.91, "timestamp": "03:22:35", "text": "今日待办事项清单。是的，我"}, {"type": "subtitle", "time": 12158.309, "timestamp": "03:22:38", "text": "希望有效。你好。总之，我先结束了。"}, {"type": "subtitle", "time": 12163.83, "timestamp": "03:22:43", "text": "赶紧收拾好，因为我五点前必须走。你好。所以，"}, {"type": "subtitle", "time": 12165.51, "timestamp": "03:22:45", "text": "也感谢今天到场的所有人。"}, {"type": "subtitle", "time": 12167.269, "timestamp": "03:22:47", "text": "哦，"}, {"type": "subtitle", "time": 12169.99, "timestamp": "03:22:49", "text": "雪快要来了。再见，雪莉。谢谢。"}, {"type": "subtitle", "time": 12173.03, "timestamp": "03:22:53", "text": "感谢 Akiabi 的到来。还有 Kaiishi"}, {"type": "subtitle", "time": 12176.63, "timestamp": "03:22:56", "text": "未来。还有Akiyabi，谢谢你。"}, {"type": "subtitle", "time": 12179.99, "timestamp": "03:22:59", "text": "给了我好多呃，伙计们，嗯"}]
[{"type": "subtitle", "time": 16981.99, "timestamp": "04:43:01", "text": "这里有一个。我在这边做。"}, {"type": "subtitle", "time": 16985.43, "timestamp": "04:43:05", "text": "我的斧子在哪儿？呃，记得要做饭。"}, {"type": "subtitle", "time": 16989.11, "timestamp": "04:43:09", "text": "怪物肉。好了，就是这样。"}, {"type": "subtitle", "time": 16996.948, "timestamp": "04:43:16", "text": "现在轮到我来承受这一切了。"}, {"type": "subtitle", "time": 17004.708, "timestamp": "04:43:24", "text": "H 转盘怎么样？"}, {"type": "subtitle", "time": 17007.99, "timestamp": "04:43:27", "text": "我没有食物。我使用表格。"}, {"type": "subtitle", "time": 17014.708, "timestamp": "04:43:34", "text": "我的天哪。"}, {"type": "subtitle", "time": 17016.39, "timestamp": "04:43:36", "text": "是的。我们遇到了一个非常好的世界出生点，"}, {"type": "subtitle", "time": 17021.27, "timestamp": "04:43:41", "text": "好了，我要再去拿些怪物。"}, {"type": "subtitle", "time": 17022.23, "timestamp": "04:43:42", "text": "肉。我们需要很多"}, {"type": "subtitle", "time": 17024.788, "timestamp": "04:43:44", "text": "之后还会提供怪物肉。"}, {"type": "subtitle", "time": 17028.47, "timestamp": "04:43:48", "text": "东西。哦好的。好的。好的。是的，"}, {"type": "subtitle", "time": 17030.868, "timestamp": "04:43:50", "text": "因为我需要木材。"}, {"type": "subtitle", "time": 17033.51, "timestamp": "04:43:53", "text": "是的。好的。我去解决我们的食物问题"}, {"type": "subtitle", "time": 17036.55, "timestamp": "04:43:56", "text": "通过栽赃陷害来解决问题。好的。"}, {"type": "subtitle", "time": 17038.868, "timestamp": "04:43:58", "text": "把你们所有的种子都给我。我的意思是，就像我"}]
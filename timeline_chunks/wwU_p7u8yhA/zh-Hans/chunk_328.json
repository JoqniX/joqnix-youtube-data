[{"type": "subtitle", "time": 19680.31, "timestamp": "05:28:00", "text": "人们？"}, {"type": "subtitle", "time": 19682.31, "timestamp": "05:28:02", "text": "任何想成为的人都可以"}, {"type": "subtitle", "time": 19685.27, "timestamp": "05:28:05", "text": "帮我照看一下杰克？快点。这边请，"}, {"type": "subtitle", "time": 19688.07, "timestamp": "05:28:08", "text": "所有人。"}, {"type": "subtitle", "time": 19690.628, "timestamp": "05:28:10", "text": "这的确是事实。你好吗？"}, {"type": "subtitle", "time": 19692.708, "timestamp": "05:28:12", "text": "你打算怎么死？太棒了。"}, {"type": "subtitle", "time": 19695.03, "timestamp": "05:28:15", "text": "我要把你的火关掉。我知道"}, {"type": "subtitle", "time": 19697.67, "timestamp": "05:28:17", "text": "这正是我想要的死法。哦，不。只是"}, {"type": "subtitle", "time": 19703.2, "timestamp": "05:28:23", "text": "好的。"}, {"type": "subtitle", "time": 19705.91, "timestamp": "05:28:25", "text": "[音乐]"}, {"type": "subtitle", "time": 19717.19, "timestamp": "05:28:37", "text": "哦，那是一个"}, {"type": "subtitle", "time": 19720.39, "timestamp": "05:28:40", "text": "浆果。浆果。好了，开始了。"}, {"type": "subtitle", "time": 19722.628, "timestamp": "05:28:42", "text": "男孩们。好的，等等，等等。我依然"}, {"type": "subtitle", "time": 19725.11, "timestamp": "05:28:45", "text": "去那边去。开始了。我仍然"}, {"type": "subtitle", "time": 19726.868, "timestamp": "05:28:46", "text": "之后还会再玩一遍这个世界。如果"}, {"type": "subtitle", "time": 19729.27, "timestamp": "05:28:49", "text": "不，我可能不会纵火。这里"}, {"type": "subtitle", "time": 19731.99, "timestamp": "05:28:51", "text": "我们走。哦，"}, {"type": "subtitle", "time": 19737.83, "timestamp": "05:28:57", "text": "不。蜘蛛。我的天哪。"}]
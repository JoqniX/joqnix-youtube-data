[{"type": "subtitle", "time": 14462.229, "timestamp": "04:01:02", "text": "是的，尽快做一个火炬。我该如何制作一个"}, {"type": "subtitle", "time": 14464.309, "timestamp": "04:01:04", "text": "火炬？我该如何等待，还有手工制作。"}, {"type": "subtitle", "time": 14466.469, "timestamp": "04:01:06", "text": "在这场游戏中。左侧有……"}, {"type": "subtitle", "time": 14469.67, "timestamp": "04:01:09", "text": "火焰图标。工具都在这里。这"}, {"type": "subtitle", "time": 14471.269, "timestamp": "04:01:11", "text": "灯。"}, {"type": "subtitle", "time": 14474.229, "timestamp": "04:01:14", "text": "哦，是的。修好草坪，然后你就会"}, {"type": "subtitle", "time": 14476.15, "timestamp": "04:01:16", "text": "能够做到。修复草坪。嘿"}, {"type": "subtitle", "time": 14477.75, "timestamp": "04:01:17", "text": "宝贝，你好吗？没见到你"}, {"type": "subtitle", "time": 14480.63, "timestamp": "04:01:20", "text": "过一会儿。等等，它说走到草地上去。"}, {"type": "subtitle", "time": 14482.469, "timestamp": "04:01:22", "text": "它卖的是草。我该如何获得"}, {"type": "subtitle", "time": 14485.349, "timestamp": "04:01:25", "text": "草？所以走到那里，然后点击它"}, {"type": "subtitle", "time": 14487.83, "timestamp": "04:01:27", "text": "你可以选择它。我该怎么做？"}, {"type": "subtitle", "time": 14490.309, "timestamp": "04:01:30", "text": "选择一位与你关系亲近的人？喜欢"}, {"type": "subtitle", "time": 14493.99, "timestamp": "04:01:33", "text": "谁现在像火一样？是的。"}, {"type": "subtitle", "time": 14497.59, "timestamp": "04:01:37", "text": "我正朝你走来。我该如何选择这个"}, {"type": "subtitle", "time": 14499.51, "timestamp": "04:01:39", "text": "离开？"}, {"type": "subtitle", "time": 14500.79, "timestamp": "04:01:40", "text": "你必须，你必须颠覆"}, {"type": "subtitle", "time": 14502.63, "timestamp": "04:01:42", "text": "此处的预期。他给我们弄到了"}, {"type": "subtitle", "time": 14504.15, "timestamp": "04:01:44", "text": "早餐。"}, {"type": "subtitle", "time": 14508.71, "timestamp": "04:01:48", "text": "是的。是的。是的。我懂了。你的性格"}, {"type": "subtitle", "time": 14511.03, "timestamp": "04:01:51", "text": "在莫图克斯岛？"}, {"type": "subtitle", "time": 14516.309, "timestamp": "04:01:56", "text": "我没有这个工具。还有，该死"}, {"type": "subtitle", "time": 14517.99, "timestamp": "04:01:57", "text": "该工具。"}]
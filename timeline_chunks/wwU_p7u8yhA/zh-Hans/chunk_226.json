[{"type": "subtitle", "time": 13560.07, "timestamp": "03:46:00", "text": "因为他不尊重界限，而且"}, {"type": "subtitle", "time": 13563.59, "timestamp": "03:46:03", "text": "那一刻。零就像寿司一样，不是吗？"}, {"type": "subtitle", "time": 13565.75, "timestamp": "03:46:05", "text": "流媒体。这就是耀西的关键所在。"}, {"type": "subtitle", "time": 13568.309, "timestamp": "03:46:08", "text": "迫使所有人玩枪口游戏。"}, {"type": "subtitle", "time": 13569.99, "timestamp": "03:46:09", "text": "是的。"}, {"type": "subtitle", "time": 13573.51, "timestamp": "03:46:13", "text": "没人跟我一起玩多人游戏。"}, {"type": "subtitle", "time": 13579.429, "timestamp": "03:46:19", "text": "好的，玩得开心。我得去做我自己的事。"}, {"type": "subtitle", "time": 13581.349, "timestamp": "03:46:21", "text": "你好。享受"}, {"type": "subtitle", "time": 13588.15, "timestamp": "03:46:28", "text": "我会增大尺寸。还有，呃，聊天，"}, {"type": "subtitle", "time": 13596.15, "timestamp": "03:46:36", "text": "请告诉我是否"}, {"type": "subtitle", "time": 13598.309, "timestamp": "03:46:38", "text": "你可以听到"}, {"type": "subtitle", "time": 13601.75, "timestamp": "03:46:41", "text": "在 Discord 上联系他们。这是音频吗？"}, {"type": "subtitle", "time": 13605.83, "timestamp": "03:46:45", "text": "水质正常吗？我应该做出改变吗？应该"}, {"type": "subtitle", "time": 13608.389, "timestamp": "03:46:48", "text": "我改了什么吗？我应该吗？"}, {"type": "subtitle", "time": 13610.63, "timestamp": "03:46:50", "text": "调整音乐音量之类的吗？让"}, {"type": "subtitle", "time": 13613.67, "timestamp": "03:46:53", "text": "告诉我。我们确实有点这么做了，但是拜托。"}, {"type": "subtitle", "time": 13617.269, "timestamp": "03:46:57", "text": "不，这算数。我就是不知道为什么。"}]
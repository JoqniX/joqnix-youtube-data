[{"type": "subtitle", "time": 16262.95, "timestamp": "04:31:02", "text": "是一样的。我会看看你的这个"}, {"type": "subtitle", "time": 16267.03, "timestamp": "04:31:07", "text": "一个类似于 N A ked.xyz"}, {"type": "subtitle", "time": 16271.03, "timestamp": "04:31:11", "text": "机器人。嗯，让我看看你的"}, {"type": "subtitle", "time": 16273.59, "timestamp": "04:31:13", "text": "第一次听说。我的意思是，我"}, {"type": "subtitle", "time": 16275.189, "timestamp": "04:31:15", "text": "删除了那些信息，但那只是个开始。"}, {"type": "subtitle", "time": 16276.71, "timestamp": "04:31:16", "text": "仍然像这样，这仍然是信息。"}, {"type": "subtitle", "time": 16279.67, "timestamp": "04:31:19", "text": "是的，你在聊天。是的。"}, {"type": "subtitle", "time": 16281.51, "timestamp": "04:31:21", "text": "狗。"}, {"type": "subtitle", "time": 16284.229, "timestamp": "04:31:24", "text": "如果真要触底反弹的话。"}, {"type": "subtitle", "time": 16287.91, "timestamp": "04:31:27", "text": "您所在地区的单身人士"}, {"type": "subtitle", "time": 16293.349, "timestamp": "04:31:33", "text": "我接受。等等，谁能给我一个"}, {"type": "subtitle", "time": 16296.07, "timestamp": "04:31:36", "text": "木头？"}, {"type": "subtitle", "time": 16297.83, "timestamp": "04:31:37", "text": "是的。"}, {"type": "subtitle", "time": 16299.189, "timestamp": "04:31:39", "text": "好的，过来。过来。我们应该"}, {"type": "subtitle", "time": 16300.79, "timestamp": "04:31:40", "text": "在我们地区找个单身帅哥/美女。等待"}, {"type": "subtitle", "time": 16303.03, "timestamp": "04:31:43", "text": "给你，兄弟。"}, {"type": "subtitle", "time": 16306.229, "timestamp": "04:31:46", "text": "我也需要和你一起做这件事。我们是什么？"}, {"type": "subtitle", "time": 16308.95, "timestamp": "04:31:48", "text": "正在做？所以，这是一首热门单曲。是"}, {"type": "subtitle", "time": 16310.63, "timestamp": "04:31:50", "text": "制作东西。是的，我不是单身。等待，"}, {"type": "subtitle", "time": 16313.75, "timestamp": "04:31:53", "text": "等待。我们四处搜寻东西。我不是"}, {"type": "subtitle", "time": 16316.55, "timestamp": "04:31:56", "text": "单身，但谢谢你。"}, {"type": "subtitle", "time": 16319.59, "timestamp": "04:31:59", "text": "你希望自己是。"}]
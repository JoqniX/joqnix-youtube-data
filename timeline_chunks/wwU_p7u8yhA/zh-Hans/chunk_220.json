[{"type": "subtitle", "time": 13202.07, "timestamp": "03:40:02", "text": "我的天哪。"}, {"type": "subtitle", "time": 13208.07, "timestamp": "03:40:08", "text": "奶奶。奶奶是关键。是的，就是这样。"}, {"type": "subtitle", "time": 13212.15, "timestamp": "03:40:12", "text": "最后一位奶奶。你没有"}, {"type": "subtitle", "time": 13214.07, "timestamp": "03:40:14", "text": "祖父。"}, {"type": "subtitle", "time": 13215.67, "timestamp": "03:40:15", "text": "是的。"}, {"type": "subtitle", "time": 13217.54, "timestamp": "03:40:17", "text": "你想让我他妈的……"}, {"type": "subtitle", "time": 13220.229, "timestamp": "03:40:20", "text": "[笑声]"}, {"type": "subtitle", "time": 13223.349, "timestamp": "03:40:23", "text": "好的。伍迪。"}, {"type": "subtitle", "time": 13226.229, "timestamp": "03:40:26", "text": "伍迪。他真是个混蛋。"}, {"type": "subtitle", "time": 13228.229, "timestamp": "03:40:28", "text": "他可以变成三种东西。一个"}, {"type": "subtitle", "time": 13231.11, "timestamp": "03:40:31", "text": "是海狸，是鹅，还有一只穿"}, {"type": "subtitle", "time": 13233.349, "timestamp": "03:40:33", "text": "去他妈的。"}, {"type": "subtitle", "time": 13236.309, "timestamp": "03:40:36", "text": "哦，对了，他还有一把无限的斧头。那是"}, {"type": "subtitle", "time": 13241.429, "timestamp": "03:40:41", "text": "它。嗯。韦斯在那里。别跟他玩。"}, {"type": "subtitle", "time": 13243.91, "timestamp": "03:40:43", "text": "他的原帖在哪儿？"}, {"type": "subtitle", "time": 13247.269, "timestamp": "03:40:47", "text": "等等，那是他的原帖。他的原帖在哪儿？哦，"}, {"type": "subtitle", "time": 13250.55, "timestamp": "03:40:50", "text": "麦克斯韦尔。他不是。不要和他玩。哦，"}, {"type": "subtitle", "time": 13253.03, "timestamp": "03:40:53", "text": "我死了。必备品。等等，那看起来像"}, {"type": "subtitle", "time": 13255.91, "timestamp": "03:40:55", "text": "不过，寿司倒是挺不错的。麦克斯韦有很多"}, {"type": "subtitle", "time": 13258.15, "timestamp": "03:40:58", "text": "肤色非常深的奴隶"}]
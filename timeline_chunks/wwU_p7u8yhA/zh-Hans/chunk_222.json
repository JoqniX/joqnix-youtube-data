[{"type": "subtitle", "time": 13320.63, "timestamp": "03:42:00", "text": "我觉得你们没有WTox，所以我……"}, {"type": "subtitle", "time": 13322.07, "timestamp": "03:42:02", "text": "跳过这一步。我跳过了苦艾。"}, {"type": "subtitle", "time": 13325.11, "timestamp": "03:42:05", "text": "我旷工了。沃尔特。"}, {"type": "subtitle", "time": 13327.75, "timestamp": "03:42:07", "text": "他是我很喜欢的人。"}, {"type": "subtitle", "time": 13329.67, "timestamp": "03:42:09", "text": "一把该死的弹弓。唯一的好处"}, {"type": "subtitle", "time": 13332.87, "timestamp": "03:42:12", "text": "游戏中他拥有远程武器，而且他还有"}, {"type": "subtitle", "time": 13335.67, "timestamp": "03:42:15", "text": "可以变成大狗的宠物狗"}, {"type": "subtitle", "time": 13338.15, "timestamp": "03:42:18", "text": "可以骑着到处跑的狗。"}, {"type": "subtitle", "time": 13339.99, "timestamp": "03:42:19", "text": "嗯哼。如果你被击中，你就会变成"}, {"type": "subtitle", "time": 13341.67, "timestamp": "03:42:21", "text": "疯狂的。"}, {"type": "subtitle", "time": 13343.349, "timestamp": "03:42:23", "text": "所以，你得打远距离进攻。"}, {"type": "subtitle", "time": 13345.269, "timestamp": "03:42:25", "text": "特点。我不知道是否有人"}, {"type": "subtitle", "time": 13349.51, "timestamp": "03:42:29", "text": "有旺达，但旺达只是个浪费时间的婊子。"}, {"type": "subtitle", "time": 13352.63, "timestamp": "03:42:32", "text": "我选你的毒药，贱人。旺达。全部"}, {"type": "subtitle", "time": 13354.79, "timestamp": "03:42:34", "text": "正确的。好的。嘿，莱昂纳多。全部"}, {"type": "subtitle", "time": 13358.469, "timestamp": "03:42:38", "text": "正确的。好的。我们走吧。我们走吧。我"}, {"type": "subtitle", "time": 13361.03, "timestamp": "03:42:41", "text": "需要选择一个角色，对吧？"}, {"type": "subtitle", "time": 13362.79, "timestamp": "03:42:42", "text": "啊，杰森，别担心。解释一下"}, {"type": "subtitle", "time": 13364.87, "timestamp": "03:42:44", "text": "完全这样做需要太长时间。患病的"}, {"type": "subtitle", "time": 13367.03, "timestamp": "03:42:47", "text": "是"}, {"type": "subtitle", "time": 13369.91, "timestamp": "03:42:49", "text": "好的。你有立场。"}, {"type": "subtitle", "time": 13373.59, "timestamp": "03:42:53", "text": "我可以扮演大弗雷德吗？当然可以。你可以"}, {"type": "subtitle", "time": 13376.15, "timestamp": "03:42:56", "text": "真是个老古董。"}, {"type": "subtitle", "time": 13378.15, "timestamp": "03:42:58", "text": "好的。哦，原来Arc是机器人。"}, {"type": "subtitle", "time": 13379.67, "timestamp": "03:42:59", "text": "读《名人录》只是为了让自己看起来像个名人"}]
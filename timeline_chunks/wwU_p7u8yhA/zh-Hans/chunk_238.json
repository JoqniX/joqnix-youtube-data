[{"type": "subtitle", "time": 14285.51, "timestamp": "03:58:05", "text": "真的吗？不。什么？你做了什么？"}, {"type": "subtitle", "time": 14287.99, "timestamp": "03:58:07", "text": "哦，好了。"}, {"type": "subtitle", "time": 14289.59, "timestamp": "03:58:09", "text": "这会显示所有参赛选手。天气很热。我"}, {"type": "subtitle", "time": 14291.83, "timestamp": "03:58:11", "text": "不知道为什么。哦，记账上。是的，"}, {"type": "subtitle", "time": 14294.469, "timestamp": "03:58:14", "text": "就是那个标签页。是的。是的。有时"}, {"type": "subtitle", "time": 14296.309, "timestamp": "03:58:16", "text": "发生于"}, {"type": "subtitle", "time": 14299.83, "timestamp": "03:58:19", "text": "这是双杀。有一只青蛙被杀死了"}, {"type": "subtitle", "time": 14303.75, "timestamp": "03:58:23", "text": "一只火鸡。我做了什么？"}, {"type": "subtitle", "time": 14305.75, "timestamp": "03:58:25", "text": "吃掉这只公鸡。把鸡巴拿走。杀死"}, {"type": "subtitle", "time": 14309.189, "timestamp": "03:58:29", "text": "公鸡。杀死公鸡。哦不，火鸡"}, {"type": "subtitle", "time": 14312.469, "timestamp": "03:58:32", "text": "死了。是的。吃掉这只公鸡。把鸡巴拿走。"}, {"type": "subtitle", "time": 14313.91, "timestamp": "03:58:33", "text": "耽误。是的。是的。是的。好的。拿"}, {"type": "subtitle", "time": 14317.429, "timestamp": "03:58:37", "text": "公鸡。把鸡巴拿走。我的天哪。抓住"}, {"type": "subtitle", "time": 14321.349, "timestamp": "03:58:41", "text": "向上。已经上线了。没关系。等待。他们"}, {"type": "subtitle", "time": 14323.83, "timestamp": "03:58:43", "text": "正在播放。是的。他妈的计划"}, {"type": "subtitle", "time": 14331.91, "timestamp": "03:58:51", "text": "我们正在使用它。哦，是的。我有一个"}, {"type": "subtitle", "time": 14335.51, "timestamp": "03:58:55", "text": "现在正和艾拉一起计划着。和"}, {"type": "subtitle", "time": 14338.229, "timestamp": "03:58:58", "text": "呃，它叫做“错误的观点”。"}]
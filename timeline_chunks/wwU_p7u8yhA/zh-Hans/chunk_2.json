[{"type": "subtitle", "time": 123.19, "timestamp": "00:02:03", "text": "呃，我的天。我得穿衣服了。"}, {"type": "subtitle", "time": 125.19, "timestamp": "00:02:05", "text": "然后我就穿好了衣服。我的意思是，我"}, {"type": "subtitle", "time": 129.109, "timestamp": "00:02:09", "text": "需要放置这个3D骑师。您位于"}, {"type": "subtitle", "time": 133.75, "timestamp": "00:02:13", "text": "背景。哇。所以，我需要得到"}, {"type": "subtitle", "time": 140.36, "timestamp": "00:02:20", "text": "我的天哪。"}, {"type": "subtitle", "time": 149.43, "timestamp": "00:02:29", "text": "我不知道为什么。呃"}, {"type": "subtitle", "time": 151.82999999999998, "timestamp": "00:02:31", "text": "天哪，我感觉想吐。我感觉"}, {"type": "subtitle", "time": 155.99, "timestamp": "00:02:35", "text": "就像之前我去的时候吐了一样"}, {"type": "subtitle", "time": 159.27, "timestamp": "00:02:39", "text": "呃，去吧碧昂丝"}, {"type": "subtitle", "time": 161.67000000000002, "timestamp": "00:02:41", "text": "做些家务。得洗一些东西"}, {"type": "subtitle", "time": 164.79, "timestamp": "00:02:44", "text": "盘子之类的东西。而且也给了类似的东西"}, {"type": "subtitle", "time": 167.589, "timestamp": "00:02:47", "text": "一桶温水"}, {"type": "subtitle", "time": 169.82999999999998, "timestamp": "00:02:49", "text": "给奶奶之类的。所以我不得不背着它"}, {"type": "subtitle", "time": 172.71, "timestamp": "00:02:52", "text": "它和一些东西。所以，是的，在携带我的时候"}, {"type": "subtitle", "time": 175.589, "timestamp": "00:02:55", "text": "感觉就像，天哪，我好难受。哦"}, {"type": "subtitle", "time": 179.11, "timestamp": "00:02:59", "text": "天哪，但我没事。"}]
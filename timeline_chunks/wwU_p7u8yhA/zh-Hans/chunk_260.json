[{"type": "subtitle", "time": 15605.83, "timestamp": "04:20:05", "text": "我该如何再次改变地狱？即使"}, {"type": "subtitle", "time": 15607.67, "timestamp": "04:20:07", "text": "你的杀戮方式就像那些超级被动型角色一样。"}, {"type": "subtitle", "time": 15611.59, "timestamp": "04:20:11", "text": "克朗普斯会做出回应。嘿，呃"}, {"type": "subtitle", "time": 15613.99, "timestamp": "04:20:13", "text": "一棵完全正常的树。我该把它切掉吗？"}, {"type": "subtitle", "time": 15616.389, "timestamp": "04:20:16", "text": "不，还没有。只需按照以下步骤操作即可"}, {"type": "subtitle", "time": 15619.99, "timestamp": "04:20:19", "text": "砖路。好的。"}, {"type": "subtitle", "time": 15624.229, "timestamp": "04:20:24", "text": "沿着路走。好的。我该如何活着"}, {"type": "subtitle", "time": 15627.67, "timestamp": "04:20:27", "text": "再次？欢迎来到猪村。"}, {"type": "subtitle", "time": 15629.429, "timestamp": "04:20:29", "text": "我觉得就像我们围着篝火一样"}, {"type": "subtitle", "time": 15631.91, "timestamp": "04:20:31", "text": "会重新生成，对吧？哦，是的。我们该怎么办？"}, {"type": "subtitle", "time": 15639.429, "timestamp": "04:20:39", "text": "是的，我们需要让你成为一个"}, {"type": "subtitle", "time": 15641.27, "timestamp": "04:20:41", "text": "是的。好的。"}, {"type": "subtitle", "time": 15644.07, "timestamp": "04:20:44", "text": "[音乐]"}, {"type": "subtitle", "time": 15645.03, "timestamp": "04:20:45", "text": "这里有很多。有很多"}, {"type": "subtitle", "time": 15647.51, "timestamp": "04:20:47", "text": "这里。我正在沿着正常的树木生长"}, {"type": "subtitle", "time": 15649.269, "timestamp": "04:20:49", "text": "为生存而战。"}, {"type": "subtitle", "time": 15650.87, "timestamp": "04:20:50", "text": "嗯，待会儿见。糟糕。没看到。"}, {"type": "subtitle", "time": 15653.189, "timestamp": "04:20:53", "text": "小猪。"}, {"type": "subtitle", "time": 15655.429, "timestamp": "04:20:55", "text": "你们在哪儿？我要去"}, {"type": "subtitle", "time": 15658.389, "timestamp": "04:20:58", "text": "一堆石头在附近，呃，试图"}]
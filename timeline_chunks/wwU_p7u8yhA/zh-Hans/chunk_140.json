[{"type": "subtitle", "time": 8403.99, "timestamp": "02:20:03", "text": "你让我把自己的事情都搞糊涂了。"}, {"type": "subtitle", "time": 8419.349, "timestamp": "02:20:19", "text": "我杀了他。我杀了那个拿锤子的家伙。"}, {"type": "subtitle", "time": 8421.83, "timestamp": "02:20:21", "text": "我的天啊。"}, {"type": "subtitle", "time": 8429.19, "timestamp": "02:20:29", "text": "[音乐]"}, {"type": "subtitle", "time": 8433.91, "timestamp": "02:20:33", "text": "不。"}, {"type": "subtitle", "time": 8436.469, "timestamp": "02:20:36", "text": "这家伙一直在猛烈抨击别人"}, {"type": "subtitle", "time": 8439.83, "timestamp": "02:20:39", "text": "就像什么都没有一样。"}, {"type": "subtitle", "time": 8445.51, "timestamp": "02:20:45", "text": "你知道吗？我真的会变成一辆坦克。"}, {"type": "subtitle", "time": 8447.59, "timestamp": "02:20:47", "text": "下一场比赛"}]
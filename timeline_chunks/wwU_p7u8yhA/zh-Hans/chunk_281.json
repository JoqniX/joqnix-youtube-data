[{"type": "subtitle", "time": 16862.39, "timestamp": "04:41:02", "text": "小伙子。哦，糟糕，为什么是 Terabek？"}, {"type": "subtitle", "time": 16864.15, "timestamp": "04:41:04", "text": "跟我来？我没疯。蒂基是"}, {"type": "subtitle", "time": 16866.708, "timestamp": "04:41:06", "text": "疯狂的。"}, {"type": "subtitle", "time": 16870.788, "timestamp": "04:41:10", "text": "等等，哪里可以买到"}, {"type": "subtitle", "time": 16873.11, "timestamp": "04:41:13", "text": "接下来要切什么？嗯，我觉得我还能做得更多。"}, {"type": "subtitle", "time": 16876.47, "timestamp": "04:41:16", "text": "美味佳肴。你在哪里？我在这里。抓住"}, {"type": "subtitle", "time": 16879.03, "timestamp": "04:41:19", "text": "在。我感觉自己还在务农。回到"}, {"type": "subtitle", "time": 16887.11, "timestamp": "04:41:27", "text": "会想：哦，原来是你。好的。"}, {"type": "subtitle", "time": 16891.91, "timestamp": "04:41:31", "text": "好的。是的。这里。这里。这里。这里。"}, {"type": "subtitle", "time": 16894.31, "timestamp": "04:41:34", "text": "它们已经受精了。去把它煮熟"}, {"type": "subtitle", "time": 16895.67, "timestamp": "04:41:35", "text": "第一的。一定要把它们煮熟。为什么"}, {"type": "subtitle", "time": 16896.948, "timestamp": "04:41:36", "text": "你为什么从那里捡起它们？"}, {"type": "subtitle", "time": 16898.15, "timestamp": "04:41:38", "text": "猪村？他们已经"}, {"type": "subtitle", "time": 16901.59, "timestamp": "04:41:41", "text": "施肥。真的吗？"}, {"type": "subtitle", "time": 16904.47, "timestamp": "04:41:44", "text": "去玩游戏吧。好的。再见。好的，"}, {"type": "subtitle", "time": 16906.47, "timestamp": "04:41:46", "text": "好的。对了，你能治好我的病吗？"}, {"type": "subtitle", "time": 16909.43, "timestamp": "04:41:49", "text": "嗯，是的。坚持，稍等。我目前仍然"}, {"type": "subtitle", "time": 16912.47, "timestamp": "04:41:52", "text": "击退暗影生物。好的，"}, {"type": "subtitle", "time": 16915.03, "timestamp": "04:41:55", "text": "基地在哪里？就在下面。全部"}]
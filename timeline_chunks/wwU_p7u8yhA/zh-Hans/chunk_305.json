[{"type": "subtitle", "time": 18300.788, "timestamp": "05:05:00", "text": "呃，你去做手工。去战斗"}, {"type": "subtitle", "time": 18303.35, "timestamp": "05:05:03", "text": "它应该在战斗标签页里。"}, {"type": "subtitle", "time": 18305.27, "timestamp": "05:05:05", "text": "应该像一支特制的长矛。哦，"}, {"type": "subtitle", "time": 18307.59, "timestamp": "05:05:07", "text": "战斗长矛。好的。是的。好的。战斗"}, {"type": "subtitle", "time": 18310.07, "timestamp": "05:05:10", "text": "长矛和战盔。我该怎么走？"}, {"type": "subtitle", "time": 18312.628, "timestamp": "05:05:12", "text": "呃，等等。我需要金块。我可以得到"}, {"type": "subtitle", "time": 18315.27, "timestamp": "05:05:15", "text": "冰箱里有哪些食材？我会去拿"}, {"type": "subtitle", "time": 18318.31, "timestamp": "05:05:18", "text": "我猜是从箱子里挖出来的金块。哦"}, {"type": "subtitle", "time": 18323.43, "timestamp": "05:05:23", "text": "拉屎。妈的。我搞砸了。"}, {"type": "subtitle", "time": 18326.31, "timestamp": "05:05:26", "text": "我来放下食物。在哪里？等等，该怎么做？"}, {"type": "subtitle", "time": 18331.59, "timestamp": "05:05:31", "text": "我把物品拆分了吗？拆分物品。等待，"}, {"type": "subtitle", "time": 18335.59, "timestamp": "05:05:35", "text": "然后把食物丢在某个地方。我该怎么做？"}, {"type": "subtitle", "time": 18337.43, "timestamp": "05:05:37", "text": "点击物品并将其放置在"}, {"type": "subtitle", "time": 18340.948, "timestamp": "05:05:40", "text": "地面？那不是食物。"}, {"type": "subtitle", "time": 18345.43, "timestamp": "05:05:45", "text": "等等，呃，怎么分割物品？"}, {"type": "subtitle", "time": 18349.91, "timestamp": "05:05:49", "text": "呃，按住控制键，哦，怪物。"}, {"type": "subtitle", "time": 18352.31, "timestamp": "05:05:52", "text": "知道了。谢谢。小心点"}, {"type": "subtitle", "time": 18355.19, "timestamp": "05:05:55", "text": "吃掉怪物。需要HP。是的，你"}, {"type": "subtitle", "time": 18358.23, "timestamp": "05:05:58", "text": "可能会死。哦，这是什么怪事？我觉得我"}, {"type": "subtitle", "time": 18359.67, "timestamp": "05:05:59", "text": "搞砸了。是的，搞砸了。抓住"}]
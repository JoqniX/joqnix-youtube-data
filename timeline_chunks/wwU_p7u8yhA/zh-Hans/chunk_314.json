[{"type": "subtitle", "time": 18840.788, "timestamp": "05:14:00", "text": "就像白天一样。好的。好的。我是"}, {"type": "subtitle", "time": 18842.55, "timestamp": "05:14:02", "text": "目前正在与三个噩梦战斗"}, {"type": "subtitle", "time": 18844.23, "timestamp": "05:14:04", "text": "生物。"}, {"type": "subtitle", "time": 18846.86, "timestamp": "05:14:06", "text": "这种延迟让游戏体验变得很糟糕。"}, {"type": "subtitle", "time": 18848.708, "timestamp": "05:14:08", "text": "[音乐]"}, {"type": "subtitle", "time": 18850.788, "timestamp": "05:14:10", "text": "等等，这是什么？我为何狩猎"}, {"type": "subtitle", "time": 18855.11, "timestamp": "05:14:15", "text": "东西？你可以去狩猎。"}, {"type": "subtitle", "time": 18858.39, "timestamp": "05:14:18", "text": "别去烦人。这只会让事情变得更糟。"}, {"type": "subtitle", "time": 18861.27, "timestamp": "05:14:21", "text": "这只会让事情变得更糟。令人毛骨悚然的玩意儿"}, {"type": "subtitle", "time": 18865.59, "timestamp": "05:14:25", "text": "之前 02 曾纠缠过一只猎犬。"}, {"type": "subtitle", "time": 18868.07, "timestamp": "05:14:28", "text": "拉屎。你从中学到了很多"}, {"type": "subtitle", "time": 18871.75, "timestamp": "05:14:31", "text": "我终于回来了。什么都别做。好的，"}, {"type": "subtitle", "time": 18874.07, "timestamp": "05:14:34", "text": "我回来了。你"}, {"type": "subtitle", "time": 18877.75, "timestamp": "05:14:37", "text": "心脏。你可以猎杀呃那个"}, {"type": "subtitle", "time": 18881.43, "timestamp": "05:14:41", "text": "树木有机会生成一棵树"}, {"type": "subtitle", "time": 18882.948, "timestamp": "05:14:42", "text": "警卫。"}, {"type": "subtitle", "time": 18884.948, "timestamp": "05:14:44", "text": "这道菜怎么做来着？我们来看看。"}, {"type": "subtitle", "time": 18886.948, "timestamp": "05:14:46", "text": "这边是什么？把它放进去"}, {"type": "subtitle", "time": 18889.43, "timestamp": "05:14:49", "text": "然后是烹饪区。将食材放入锅中"}, {"type": "subtitle", "time": 18893.19, "timestamp": "05:14:53", "text": "放进去。我只能放一个。你们有吗？"}, {"type": "subtitle", "time": 18894.708, "timestamp": "05:14:54", "text": "燧石？"}, {"type": "subtitle", "time": 18897.99, "timestamp": "05:14:57", "text": "你们那儿有燧石吗？我有10个。"}]
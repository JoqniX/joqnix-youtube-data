[{"type": "subtitle", "time": 16922.39, "timestamp": "04:42:02", "text": "需要"}, {"type": "subtitle", "time": 16923.91, "timestamp": "04:42:03", "text": "工具。"}, {"type": "subtitle", "time": 16931.43, "timestamp": "04:42:11", "text": "好的。死者。是的。不，然后"}, {"type": "subtitle", "time": 16933.75, "timestamp": "04:42:13", "text": "你没事。你没事。好的。得到"}, {"type": "subtitle", "time": 16936.37, "timestamp": "04:42:16", "text": "休息一下。得担心……"}, {"type": "subtitle", "time": 16937.51, "timestamp": "04:42:17", "text": "[音乐]"}, {"type": "subtitle", "time": 16939.43, "timestamp": "04:42:19", "text": "等等，我需要做一把斧子，对吧？我"}, {"type": "subtitle", "time": 16940.39, "timestamp": "04:42:20", "text": "顺便说一句，我没有木头。我不"}, {"type": "subtitle", "time": 16943.83, "timestamp": "04:42:23", "text": "有木头。如果你可以的话，比如……"}, {"type": "subtitle", "time": 16946.868, "timestamp": "04:42:26", "text": "是啊，谢谢。祖基，过来一下。"}, {"type": "subtitle", "time": 16948.868, "timestamp": "04:42:28", "text": "我会为你做一颗心。哦，祖基有"}, {"type": "subtitle", "time": 16951.83, "timestamp": "04:42:31", "text": "该死的燧石。"}, {"type": "subtitle", "time": 16954.31, "timestamp": "04:42:34", "text": "过来。哦，老兄。我放了大概30个"}, {"type": "subtitle", "time": 16957.03, "timestamp": "04:42:37", "text": "箱子里有燧石。好的。你在哪里？"}, {"type": "subtitle", "time": 16962.07, "timestamp": "04:42:42", "text": "这里。糟糕，是条狗。"}, {"type": "subtitle", "time": 16964.23, "timestamp": "04:42:44", "text": "好了，开始了。差点就给你了"}, {"type": "subtitle", "time": 16967.99, "timestamp": "04:42:47", "text": "真他妈的木头，亲爱的。匈奴。"}, {"type": "subtitle", "time": 16975.43, "timestamp": "04:42:55", "text": "[音乐]"}, {"type": "subtitle", "time": 16977.27, "timestamp": "04:42:57", "text": "哦，拜托。坚持，稍等。我觉得我可以做到"}, {"type": "subtitle", "time": 16978.628, "timestamp": "04:42:58", "text": "又一个。我想我还能再做一个。"}]
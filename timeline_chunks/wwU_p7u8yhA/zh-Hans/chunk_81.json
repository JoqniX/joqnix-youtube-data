[{"type": "subtitle", "time": 4865.75, "timestamp": "01:21:05", "text": "这真酷。我喜欢这张照片。"}, {"type": "subtitle", "time": 4869.189, "timestamp": "01:21:09", "text": "但对孩子来说，情况却截然不同。"}, {"type": "subtitle", "time": 4871.99, "timestamp": "01:21:11", "text": "我觉得你说得对。我喜欢火箭"}, {"type": "subtitle", "time": 4876.149, "timestamp": "01:21:16", "text": "就像发射手榴弹那样的掌声，你"}, {"type": "subtitle", "time": 4909.669, "timestamp": "01:21:49", "text": "那是我。这是和我一对一的较量。"}]
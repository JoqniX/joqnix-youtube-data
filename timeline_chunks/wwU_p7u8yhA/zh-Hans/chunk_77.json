[{"type": "subtitle", "time": 4632.79, "timestamp": "01:17:12", "text": "哇，"}, {"type": "subtitle", "time": 4636.7, "timestamp": "01:17:16", "text": "我拿到了大约8个人头。我的天啊，"}, {"type": "subtitle", "time": 4648.1, "timestamp": "01:17:28", "text": "这个CL英雄确实很强。"}, {"type": "subtitle", "time": 4668.79, "timestamp": "01:17:48", "text": "这导致我的熔岩停滞不前。是的。我们走吧。"}, {"type": "subtitle", "time": 4672.54, "timestamp": "01:17:52", "text": "Ka准备好了"}]
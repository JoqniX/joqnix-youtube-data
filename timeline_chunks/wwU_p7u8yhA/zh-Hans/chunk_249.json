[{"type": "subtitle", "time": 14941.11, "timestamp": "04:09:01", "text": "姐姐。"}, {"type": "subtitle", "time": 14943.67, "timestamp": "04:09:03", "text": "朝“是”的方向走去。好的。我就是那个人"}, {"type": "subtitle", "time": 14945.51, "timestamp": "04:09:05", "text": "用镐。"}, {"type": "subtitle", "time": 14947.349, "timestamp": "04:09:07", "text": "关掉你的手电筒。我们"}, {"type": "subtitle", "time": 14948.229, "timestamp": "04:09:08", "text": "现在不需要。在哪里？"}, {"type": "subtitle", "time": 14949.75, "timestamp": "04:09:09", "text": "阿比盖尔？"}, {"type": "subtitle", "time": 14951.91, "timestamp": "04:09:11", "text": "阿比盖尔在哪儿？"}, {"type": "subtitle", "time": 14954.95, "timestamp": "04:09:14", "text": "前往你的手部区域。"}, {"type": "subtitle", "time": 14965.189, "timestamp": "04:09:25", "text": "生火。别忘了"}, {"type": "subtitle", "time": 14966.55, "timestamp": "04:09:26", "text": "直接拿起来就行了。我喜欢开头。"}, {"type": "subtitle", "time": 14968.389, "timestamp": "04:09:28", "text": "部分。铃木，你就把这辆车开走吧。就这么"}, {"type": "subtitle", "time": 14971.75, "timestamp": "04:09:31", "text": "玩的时间越长就越觉得无聊。"}, {"type": "subtitle", "time": 14973.67, "timestamp": "04:09:33", "text": "这款游戏。"}, {"type": "subtitle", "time": 14974.95, "timestamp": "04:09:34", "text": "真是无聊透顶。为什么我们会有"}, {"type": "subtitle", "time": 14977.67, "timestamp": "04:09:37", "text": "手电筒开着吗？我总共做了五年。"}, {"type": "subtitle", "time": 14981.189, "timestamp": "04:09:41", "text": "游戏中。我该如何玩这个游戏？就这么"}, {"type": "subtitle", "time": 14984.309, "timestamp": "04:09:44", "text": "太无聊了。是的，这个游戏"}, {"type": "subtitle", "time": 14985.75, "timestamp": "04:09:45", "text": "一旦到了那个阶段，就有点无聊了。"}, {"type": "subtitle", "time": 14988.07, "timestamp": "04:09:48", "text": "游戏的更远部分。喜欢"}, {"type": "subtitle", "time": 14989.99, "timestamp": "04:09:49", "text": "一旦你拥有了巨型基地，你就会像杀戮机器一样杀戮。"}, {"type": "subtitle", "time": 14992.71, "timestamp": "04:09:52", "text": "一群老板。月之骑士"}, {"type": "subtitle", "time": 14995.349, "timestamp": "04:09:55", "text": "这最终会告诉你，你会落得什么下场"}, {"type": "subtitle", "time": 14998.79, "timestamp": "04:09:58", "text": "去找版主帮忙。是的，就是这样"}]
[{"type": "subtitle", "time": 13081.67, "timestamp": "03:38:01", "text": "真不敢相信我竟然在说话"}, {"type": "subtitle", "time": 13083.99, "timestamp": "03:38:03", "text": "最好的朋友。他什么都不玩。"}, {"type": "subtitle", "time": 13086.95, "timestamp": "03:38:06", "text": "怎么会有人年纪这么大却又这么年轻？"}, {"type": "subtitle", "time": 13090.95, "timestamp": "03:38:10", "text": "我会尽力上场比赛。不，你不需要。"}, {"type": "subtitle", "time": 13095.67, "timestamp": "03:38:15", "text": "你没有。你没有。你逼我的。"}, {"type": "subtitle", "time": 13098.15, "timestamp": "03:38:18", "text": "你强迫我玩信任俄罗斯方块"}, {"type": "subtitle", "time": 13099.67, "timestamp": "03:38:19", "text": "枪指着你。"}, {"type": "subtitle", "time": 13107.19, "timestamp": "03:38:27", "text": "世界明星。"}, {"type": "subtitle", "time": 13109.67, "timestamp": "03:38:29", "text": "好的，接下来解释一下这些角色。"}, {"type": "subtitle", "time": 13112.15, "timestamp": "03:38:32", "text": "自 Jox 和 Suzuki 以来，新一代人"}, {"type": "subtitle", "time": 13115.91, "timestamp": "03:38:35", "text": "他们是这个游戏的新手。"}, {"type": "subtitle", "time": 13119.03, "timestamp": "03:38:39", "text": "第一个角色，基本款婊子没有"}, {"type": "subtitle", "time": 13120.389, "timestamp": "03:38:40", "text": "除了成长之外，还拥有特殊能力"}, {"type": "subtitle", "time": 13123.269, "timestamp": "03:38:43", "text": "冬天能帮你保暖的胡子。"}, {"type": "subtitle", "time": 13125.429, "timestamp": "03:38:45", "text": "就是这样。你通常就是这样"}, {"type": "subtitle", "time": 13127.19, "timestamp": "03:38:47", "text": "应该玩耍。不要同时开始。"}, {"type": "subtitle", "time": 13129.83, "timestamp": "03:38:49", "text": "基本游戏。基本 基本"}]
[{"type": "subtitle", "time": 10080.309, "timestamp": "02:48:00", "text": "[音乐]"}, {"type": "subtitle", "time": 10083.07, "timestamp": "02:48:03", "text": "她杀了他。"}, {"type": "subtitle", "time": 10092.55, "timestamp": "02:48:12", "text": "哇。"}, {"type": "subtitle", "time": 10095.429, "timestamp": "02:48:15", "text": "举手。我们走吧。"}, {"type": "subtitle", "time": 10097.91, "timestamp": "02:48:17", "text": "是的。我带你走，汉佐。我不会让"}, {"type": "subtitle", "time": 10100.23, "timestamp": "02:48:20", "text": "有人拿"}, {"type": "subtitle", "time": 10111.429, "timestamp": "02:48:31", "text": "[音乐]"}, {"type": "subtitle", "time": 10116.19, "timestamp": "02:48:36", "text": "看看我能不能进入这个聊天室。"}, {"type": "subtitle", "time": 10137.99, "timestamp": "02:48:57", "text": "我的天啊。"}]
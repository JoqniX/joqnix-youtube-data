[{"type": "subtitle", "time": 18960.628, "timestamp": "05:16:00", "text": "你。对，做，你知道，跟随"}, {"type": "subtitle", "time": 18967.83, "timestamp": "05:16:07", "text": "我只希望我别搞砸了。"}, {"type": "subtitle", "time": 18969.35, "timestamp": "05:16:09", "text": "因为如果我搞砸了，我真的可能会……"}, {"type": "subtitle", "time": 18973.19, "timestamp": "05:16:13", "text": "死。我加了40马力。我的天哪。所以，不要"}, {"type": "subtitle", "time": 18976.31, "timestamp": "05:16:16", "text": "搞砸了。是的。"}, {"type": "subtitle", "time": 18983.99, "timestamp": "05:16:23", "text": "好的。好的。好的。我知道那里"}, {"type": "subtitle", "time": 18985.67, "timestamp": "05:16:25", "text": "这。我觉得就是这个。是的，"}, {"type": "subtitle", "time": 18987.19, "timestamp": "05:16:27", "text": "这是有一堆东西的那一个"}, {"type": "subtitle", "time": 18991.51, "timestamp": "05:16:31", "text": "蜘蛛。好的。它在哪里？呃，"}, {"type": "subtitle", "time": 18995.35, "timestamp": "05:16:35", "text": "不。而且数量还不少。别弄错"}, {"type": "subtitle", "time": 18998.55, "timestamp": "05:16:38", "text": "关闭。我可以做一个箱子吗？"}, {"type": "subtitle", "time": 19005.83, "timestamp": "05:16:45", "text": "青蛙。好的。"}, {"type": "subtitle", "time": 19008.708, "timestamp": "05:16:48", "text": "不，哦，不。哦，不。它正扑向你。"}, {"type": "subtitle", "time": 19010.788, "timestamp": "05:16:50", "text": "好的。糟糕，他们正在杀青蛙！"}, {"type": "subtitle", "time": 19012.788, "timestamp": "05:16:52", "text": "顺便一提。是的，我知道。我在偷东西"}, {"type": "subtitle", "time": 19015.43, "timestamp": "05:16:55", "text": "灵魂。对，夺走灵魂。全部"}, {"type": "subtitle", "time": 19016.47, "timestamp": "05:16:56", "text": "正确的。他们应该战斗。我是"}, {"type": "subtitle", "time": 19017.99, "timestamp": "05:16:57", "text": "建造一个箱子。所以，出于某种原因，"}]
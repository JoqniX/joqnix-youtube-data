[{"type": "subtitle", "time": 18240.15, "timestamp": "05:04:00", "text": "在胸口。遗憾的是，我们没有"}, {"type": "subtitle", "time": 18242.55, "timestamp": "05:04:02", "text": "冰箱还没开。"}, {"type": "subtitle", "time": 18243.99, "timestamp": "05:04:03", "text": "等等，这里有齿轮。里面有齿轮"}, {"type": "subtitle", "time": 18246.788, "timestamp": "05:04:06", "text": "胸部。哦，确实有。哦，是的。我 我"}, {"type": "subtitle", "time": 18248.31, "timestamp": "05:04:08", "text": "恢复了四个档位。我知道。我们需要"}, {"type": "subtitle", "time": 18249.91, "timestamp": "05:04:09", "text": "我们需要一台冰箱尺寸测量仪。是的，"}, {"type": "subtitle", "time": 18252.07, "timestamp": "05:04:12", "text": "我忘了。好的。是的，我带回来一个"}, {"type": "subtitle", "time": 18254.31, "timestamp": "05:04:14", "text": "距离我杀敌还差几个档位"}, {"type": "subtitle", "time": 18258.23, "timestamp": "05:04:18", "text": "这里还有骑士什么的。"}, {"type": "subtitle", "time": 18260.39, "timestamp": "05:04:20", "text": "还有一些。我们现在唯一需要的是"}, {"type": "subtitle", "time": 18263.51, "timestamp": "05:04:23", "text": "呃，它叫什么？"}, {"type": "subtitle", "time": 18265.75, "timestamp": "05:04:25", "text": "那个贱人。"}, {"type": "subtitle", "time": 18269.51, "timestamp": "05:04:29", "text": "呃，科学机器。科学"}, {"type": "subtitle", "time": 18273.11, "timestamp": "05:04:33", "text": "机器。哦，对不起。"}, {"type": "subtitle", "time": 18278.07, "timestamp": "05:04:38", "text": "我需要一把镐或者一把斧子去打猎。去狩猎"}, {"type": "subtitle", "time": 18281.99, "timestamp": "05:04:41", "text": "我们反复地互相了解。特制长矛"}, {"type": "subtitle", "time": 18284.708, "timestamp": "05:04:44", "text": "顺便一提。骑师"}, {"type": "subtitle", "time": 18286.55, "timestamp": "05:04:46", "text": "一款特制头盔。哦，难道他们不是吗？"}, {"type": "subtitle", "time": 18290.15, "timestamp": "05:04:50", "text": "攻击？是啊，我也是。如果我没有落后的话，"}, {"type": "subtitle", "time": 18292.47, "timestamp": "05:04:52", "text": "我本来会参与这项工作的。不，我是"}, {"type": "subtitle", "time": 18294.31, "timestamp": "05:04:54", "text": "被困在农活上了。他们不这样做"}, {"type": "subtitle", "time": 18296.23, "timestamp": "05:04:56", "text": "任何事物。嗯？我如何获得我的特殊待遇"}, {"type": "subtitle", "time": 18297.91, "timestamp": "05:04:57", "text": "项目？"}]
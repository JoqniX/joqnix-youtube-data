[{"type": "subtitle", "time": 3601.75, "timestamp": "01:00:01", "text": "这是能力三。是的，能力"}, {"type": "subtitle", "time": 3603.75, "timestamp": "01:00:03", "text": "三。好的，明白了。知道了。谢谢。"}, {"type": "subtitle", "time": 3605.67, "timestamp": "01:00:05", "text": "我想我明白了。好的，我马上就到。"}, {"type": "subtitle", "time": 3608.549, "timestamp": "01:00:08", "text": "追求极致。"}, {"type": "subtitle", "time": 3620.549, "timestamp": "01:00:20", "text": "我或许可以把这个功能赋予这个 B 键。"}, {"type": "subtitle", "time": 3623.43, "timestamp": "01:00:23", "text": "那边空无一人。我或许可以把 Q 放进去。"}, {"type": "subtitle", "time": 3625.829, "timestamp": "01:00:25", "text": "在那边待着以防万一。"}, {"type": "subtitle", "time": 3629.19, "timestamp": "01:00:29", "text": "我不知道。为什么不呢？没有"}, {"type": "subtitle", "time": 3631.589, "timestamp": "01:00:31", "text": "手榴弹之类的东西，对吧？它是"}, {"type": "subtitle", "time": 3634.309, "timestamp": "01:00:34", "text": "取决于"}, {"type": "subtitle", "time": 3638.309, "timestamp": "01:00:38", "text": "你选择的英雄。嗨。所以我觉得"}, {"type": "subtitle", "time": 3641.67, "timestamp": "01:00:41", "text": "我们完成了。"}, {"type": "subtitle", "time": 3644.95, "timestamp": "01:00:44", "text": "我想我们结束了。 DPI 值正确。"}, {"type": "subtitle", "time": 3647.19, "timestamp": "01:00:47", "text": "我这边没有捆绑任何东西，但是"}, {"type": "subtitle", "time": 3649.43, "timestamp": "01:00:49", "text": "没关系。好的。我们很好。我们是"}, {"type": "subtitle", "time": 3653.03, "timestamp": "01:00:53", "text": "好的。你好。现在我需要把它上传到"}, {"type": "subtitle", "time": 3654.87, "timestamp": "01:00:54", "text": "我的"}]
[{"type": "subtitle", "time": 19560.31, "timestamp": "05:26:00", "text": "展示。该死的。呃，嘿，S，你好吗？"}, {"type": "subtitle", "time": 19562.628, "timestamp": "05:26:02", "text": "去？我吃过寿司。我不知道"}, {"type": "subtitle", "time": 19570.23, "timestamp": "05:26:10", "text": "我的天啊。该死的。该死的。你"}, {"type": "subtitle", "time": 19572.15, "timestamp": "05:26:12", "text": "知道什么？美好的。美好的。美好的。你知道"}, {"type": "subtitle", "time": 19579.67, "timestamp": "05:26:19", "text": "如果你感到困惑，那就杀光它们。"}, {"type": "subtitle", "time": 19582.788, "timestamp": "05:26:22", "text": "狩猎物品。这是你的鬼魂。就像哦"}, {"type": "subtitle", "time": 19584.23, "timestamp": "05:26:24", "text": "妈的，他把网络都搞瘫痪了，因为"}, {"type": "subtitle", "time": 19587.67, "timestamp": "05:26:27", "text": "就是找另一个。"}, {"type": "subtitle", "time": 19590.07, "timestamp": "05:26:30", "text": "我杀死了青蛙。"}, {"type": "subtitle", "time": 19596.788, "timestamp": "05:26:36", "text": "好了，该继续跑了。"}, {"type": "subtitle", "time": 19600.07, "timestamp": "05:26:40", "text": "练出好腿。"}, {"type": "subtitle", "time": 19604.868, "timestamp": "05:26:44", "text": "嘿，你好吗？哦，那只是钓鱼而已。"}, {"type": "subtitle", "time": 19606.948, "timestamp": "05:26:46", "text": "这就是我的生活。"}, {"type": "subtitle", "time": 19608.628, "timestamp": "05:26:48", "text": "只是过着平凡的生活。他们甚至"}, {"type": "subtitle", "time": 19611.99, "timestamp": "05:26:51", "text": "准备诱饵。妈的。等等，什么？哦，不。"}, {"type": "subtitle", "time": 19615.83, "timestamp": "05:26:55", "text": "我们需要哪种类型的饵料？"}, {"type": "subtitle", "time": 19618.47, "timestamp": "05:26:58", "text": "正式选中了我。你需要得到"}]
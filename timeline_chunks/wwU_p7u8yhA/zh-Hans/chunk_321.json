[{"type": "subtitle", "time": 19261.35, "timestamp": "05:21:01", "text": "让我"}, {"type": "subtitle", "time": 19265.19, "timestamp": "05:21:05", "text": "摧毁这个尖刺巢穴。是的，非常"}, {"type": "subtitle", "time": 19269.51, "timestamp": "05:21:09", "text": "非常烦人。呃，过来这边。"}, {"type": "subtitle", "time": 19272.47, "timestamp": "05:21:12", "text": "在哪里？铃木，你走吧。你去。具有高"}, {"type": "subtitle", "time": 19276.07, "timestamp": "05:21:16", "text": "我现在的健康状况如何？攻击"}, {"type": "subtitle", "time": 19277.43, "timestamp": "05:21:17", "text": "意识到有东西在攻击。"}, {"type": "subtitle", "time": 19279.19, "timestamp": "05:21:19", "text": "而且，我只能坚持下去。我需要吃饭"}, {"type": "subtitle", "time": 19281.51, "timestamp": "05:21:21", "text": "某物。稍等片刻。我杀了"}, {"type": "subtitle", "time": 19287.35, "timestamp": "05:21:27", "text": "蜘蛛战士。我要杀了这家伙。只是"}, {"type": "subtitle", "time": 19293.51, "timestamp": "05:21:33", "text": "跑步。哦，是的。打他。骑师。是的。"}, {"type": "subtitle", "time": 19297.11, "timestamp": "05:21:37", "text": "再次。最后。做了点什么。"}, {"type": "subtitle", "time": 19300.23, "timestamp": "05:21:40", "text": "呃，你们谁有蝴蝶之类的东西吗？"}, {"type": "subtitle", "time": 19301.99, "timestamp": "05:21:41", "text": "翅膀，这样我就可以像我想做的那样……"}, {"type": "subtitle", "time": 19304.55, "timestamp": "05:21:44", "text": "肉丸。肉丸。"}, {"type": "subtitle", "time": 19307.59, "timestamp": "05:21:47", "text": "很遗憾，我没有。"}, {"type": "subtitle", "time": 19310.23, "timestamp": "05:21:50", "text": "所以，我需要按下鼠标左键。"}, {"type": "subtitle", "time": 19314.07, "timestamp": "05:21:54", "text": "有权将其杀死。我没吃肉。"}, {"type": "subtitle", "time": 19315.67, "timestamp": "05:21:55", "text": "实际上，"}, {"type": "subtitle", "time": 19318.708, "timestamp": "05:21:58", "text": "我需要食物。"}]
[{"type": "subtitle", "time": 15720.79, "timestamp": "04:22:00", "text": "真実。でも、私はMODを持っていなかった"}, {"type": "subtitle", "time": 15724.87, "timestamp": "04:22:04", "text": "昔はそうだった。えっと、その前に"}, {"type": "subtitle", "time": 15727.83, "timestamp": "04:22:07", "text": "ワークショップというものがあった。あれは"}, {"type": "subtitle", "time": 15730.469, "timestamp": "04:22:10", "text": "野生。うん。なんでしょう？どうですか？"}, {"type": "subtitle", "time": 15735.269, "timestamp": "04:22:15", "text": "行くの？その石を見つけるのを手伝ってくれませんか？えっと"}, {"type": "subtitle", "time": 15738.55, "timestamp": "04:22:18", "text": "えっと、すごく遠くに岩があります。うん、"}, {"type": "subtitle", "time": 15740.55, "timestamp": "04:22:20", "text": "ここからはとても遠い。"}, {"type": "subtitle", "time": 15742.469, "timestamp": "04:22:22", "text": "えっと、じゃあ私についてきてください。真っ直ぐ進んで下さい"}, {"type": "subtitle", "time": 15744.63, "timestamp": "04:22:24", "text": "私が向かうのはこちらです。行ってみて"}, {"type": "subtitle", "time": 15746.55, "timestamp": "04:22:26", "text": "真っ直ぐ"}, {"type": "subtitle", "time": 15749.189, "timestamp": "04:22:29", "text": "マインクラフトへ。"}, {"type": "subtitle", "time": 15751.189, "timestamp": "04:22:31", "text": "彼らは実際に私と同じように経験している"}, {"type": "subtitle", "time": 15753.59, "timestamp": "04:22:33", "text": "ただし、そのためにはMODが必要です。よし、"}, {"type": "subtitle", "time": 15758.149, "timestamp": "04:22:38", "text": "肉。ああ、だから肉を食べるんだ。"}, {"type": "subtitle", "time": 15759.51, "timestamp": "04:22:39", "text": "正面から逃げろ。なぜ"}, {"type": "subtitle", "time": 15761.59, "timestamp": "04:22:41", "text": "鈴木、俺に話しかけてるのか？"}, {"type": "subtitle", "time": 15763.75, "timestamp": "04:22:43", "text": "いいえ、それは私がクリアする必要があるものです"}, {"type": "subtitle", "time": 15766.87, "timestamp": "04:22:46", "text": "在庫。そっちへ行くように言っただろう。それで"}, {"type": "subtitle", "time": 15769.59, "timestamp": "04:22:49", "text": "私の持ち物にはたくさんのものがあります。えっと、掴んで"}, {"type": "subtitle", "time": 15773.91, "timestamp": "04:22:53", "text": "ああ、もう、めちゃくちゃラグってる。"}, {"type": "subtitle", "time": 15777.349, "timestamp": "04:22:57", "text": "ごめんなさい。うん。うん。こちらへお進みください。おお"}]
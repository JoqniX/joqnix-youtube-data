[{"type": "subtitle", "time": 15780.389, "timestamp": "04:23:00", "text": "ああ、動作が遅い。よし。ああ、私は"}, {"type": "subtitle", "time": 15784.07, "timestamp": "04:23:04", "text": "すごく動作が遅い。"}, {"type": "subtitle", "time": 15786.07, "timestamp": "04:23:06", "text": "うん。ああ、今は単にネットワークの問題ですね。"}, {"type": "subtitle", "time": 15788.309, "timestamp": "04:23:08", "text": "今は単にネットワークの問題です。ああ、すべて"}, {"type": "subtitle", "time": 15790.07, "timestamp": "04:23:10", "text": "右。あっちへ行け、スズキ。こちらへお進みください"}, {"type": "subtitle", "time": 15791.67, "timestamp": "04:23:11", "text": "すると石が見つかるでしょう。行ってみて"}, {"type": "subtitle", "time": 15794.07, "timestamp": "04:23:14", "text": "あっちへまっすぐ進んでください。つまり、私たちは選んでいるのでしょうか"}, {"type": "subtitle", "time": 15795.75, "timestamp": "04:23:15", "text": "まだ拠点となる場所はないのか、それともまだ"}, {"type": "subtitle", "time": 15797.83, "timestamp": "04:23:17", "text": "検索中ですか？私たちは正しく生きるべきだ"}, {"type": "subtitle", "time": 15799.269, "timestamp": "04:23:19", "text": "クソ豚の隣にいるから"}, {"type": "subtitle", "time": 15801.59, "timestamp": "04:23:21", "text": "それらを使って簡単に農場を作る"}, {"type": "subtitle", "time": 15803.59, "timestamp": "04:23:23", "text": "在庫がいっぱいだからです。私は必要としている"}, {"type": "subtitle", "time": 15805.51, "timestamp": "04:23:25", "text": "私の荷物を保管する場所。うん、そうするよ"}, {"type": "subtitle", "time": 15807.51, "timestamp": "04:23:27", "text": "じゃあ、薪割りを始めます。"}, {"type": "subtitle", "time": 15809.91, "timestamp": "04:23:29", "text": "ええ、それで拠点を設置できます。私たちはただ"}, {"type": "subtitle", "time": 15811.99, "timestamp": "04:23:31", "text": "正直言って、金が必要だ。集金できません"}, {"type": "subtitle", "time": 15813.51, "timestamp": "04:23:33", "text": "多くの。スパイダー・グランスは手に入れたけど。理解します"}, {"type": "subtitle", "time": 15815.03, "timestamp": "04:23:35", "text": "スパイダー・グランス、もし誰か好きなら"}, {"type": "subtitle", "time": 15818.469, "timestamp": "04:23:38", "text": "おばあちゃんを連れてきて。"}, {"type": "subtitle", "time": 15820.229, "timestamp": "04:23:40", "text": "待って、科学が必要なの？"}, {"type": "subtitle", "time": 15822.389, "timestamp": "04:23:42", "text": "機械が特徴的なものを作るような？いいえ、"}, {"type": "subtitle", "time": 15825.429, "timestamp": "04:23:45", "text": "いや、いや、私たちはそれにアクセスします"}, {"type": "subtitle", "time": 15828.149, "timestamp": "04:23:48", "text": "すでに。種を手に入れました。ええ、ありますよ。おお、"}, {"type": "subtitle", "time": 15829.75, "timestamp": "04:23:49", "text": "私なら実際に作れます。ちょっと待ってください。"}, {"type": "subtitle", "time": 15831.67, "timestamp": "04:23:51", "text": "どこにいるの？ねえ、君と僕ならできるよ。"}, {"type": "subtitle", "time": 15834.95, "timestamp": "04:23:54", "text": "私が作ってあげられますよ。えっと、ジョー"}, {"type": "subtitle", "time": 15836.389, "timestamp": "04:23:56", "text": "次。どこですか？彼のものを見せてください"}, {"type": "subtitle", "time": 15838.79, "timestamp": "04:23:58", "text": "復活。尻尾のハート。さあ、建てよう。"}]
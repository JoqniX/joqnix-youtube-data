[{"type": "subtitle", "time": 2706.79, "timestamp": "00:45:06", "text": "音声チャット。プッシュトゥトーク。デフォルト"}, {"type": "subtitle", "time": 2712.87, "timestamp": "00:45:12", "text": "ファイル。わかった。プッシュトゥトークキー。はぁ。"}, {"type": "subtitle", "time": 2719.43, "timestamp": "00:45:19", "text": "アクセシビリティ。これは何ですか？カメラ"}, {"type": "subtitle", "time": 2722.309, "timestamp": "00:45:22", "text": "振る。字幕。はい。"}, {"type": "subtitle", "time": 2724.63, "timestamp": "00:45:24", "text": "すべて。"}, {"type": "subtitle", "time": 2726.95, "timestamp": "00:45:26", "text": "テキサスでの演説。いいえ"}, {"type": "subtitle", "time": 2730.39, "timestamp": "00:45:30", "text": "色覚異常。わかった。こんにちは。私たちは"}, {"type": "subtitle", "time": 2740.069, "timestamp": "00:45:40", "text": "ああ、それは"}, {"type": "subtitle", "time": 2755.829, "timestamp": "00:45:55", "text": "ああ、日本語音声だ。うん、入れて"}]
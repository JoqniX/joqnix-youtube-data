[{"type": "subtitle", "time": 18960.628, "timestamp": "05:16:00", "text": "あなた。うん、そう、そう、フォローして"}, {"type": "subtitle", "time": 18967.83, "timestamp": "05:16:07", "text": "でも、失敗しないことを願うばかりです"}, {"type": "subtitle", "time": 18969.35, "timestamp": "05:16:09", "text": "なぜなら、もし私が失敗したら、実際に"}, {"type": "subtitle", "time": 18973.19, "timestamp": "05:16:13", "text": "死ぬ。私は40馬力にした。ああ、大変だ。だから、"}, {"type": "subtitle", "time": 18976.31, "timestamp": "05:16:16", "text": "台無しにする。うん。"}, {"type": "subtitle", "time": 18983.99, "timestamp": "05:16:23", "text": "わかった。わかった。わかった。知ってるよ"}, {"type": "subtitle", "time": 18985.67, "timestamp": "05:16:25", "text": "これ。これがそれだと思う。うん、"}, {"type": "subtitle", "time": 18987.19, "timestamp": "05:16:27", "text": "これは、"}, {"type": "subtitle", "time": 18991.51, "timestamp": "05:16:31", "text": "クモ。わかった。どこですか？えっと、"}, {"type": "subtitle", "time": 18995.35, "timestamp": "05:16:35", "text": "いいえ。そして、それはかなりの数だ。手に入れないで"}, {"type": "subtitle", "time": 18998.55, "timestamp": "05:16:38", "text": "近い。宝箱を作ってもいいですか？"}, {"type": "subtitle", "time": 19005.83, "timestamp": "05:16:45", "text": "カエルたち。わかった。"}, {"type": "subtitle", "time": 19008.708, "timestamp": "05:16:48", "text": "いや。ああ、いやだ。なんてこった。それはあなたに飛びかかってきます。"}, {"type": "subtitle", "time": 19010.788, "timestamp": "05:16:50", "text": "わかった。ああ、彼らはカエルを殺している、"}, {"type": "subtitle", "time": 19012.788, "timestamp": "05:16:52", "text": "ところで。ええ、わかっています。私は盗んでいる"}, {"type": "subtitle", "time": 19015.43, "timestamp": "05:16:55", "text": "魂たち。ああ、魂を奪ってやる。全て"}, {"type": "subtitle", "time": 19016.47, "timestamp": "05:16:56", "text": "右。彼らは戦うべきだ。私は"}, {"type": "subtitle", "time": 19017.99, "timestamp": "05:16:57", "text": "宝箱を作る。だから、何らかの理由で、"}]
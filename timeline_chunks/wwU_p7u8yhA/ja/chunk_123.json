[{"type": "subtitle", "time": 7417.91, "timestamp": "02:03:37", "text": "歌姫が復帰。"}, {"type": "subtitle", "time": 7420.39, "timestamp": "02:03:40", "text": "ディーバ、ディーバを手に入れるのは誰でもいい、ってことだよね？"}, {"type": "subtitle", "time": 7423.97, "timestamp": "02:03:43", "text": "彼らは多くのキル数を稼ぐことができる。"}, {"type": "subtitle", "time": 7426.95, "timestamp": "02:03:46", "text": "[音楽]"}]
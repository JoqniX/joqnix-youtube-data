[{"type": "subtitle", "time": 18781.43, "timestamp": "05:13:01", "text": "ナスだよ、兄弟。ギャレットを手に入れた。もしあなたが"}, {"type": "subtitle", "time": 18783.67, "timestamp": "05:13:03", "text": "草があれば、"}, {"type": "subtitle", "time": 18785.99, "timestamp": "05:13:05", "text": "それを使ってジャガイモを収穫できるよ"}, {"type": "subtitle", "time": 18789.43, "timestamp": "05:13:09", "text": "「ああ、ジェイソン」と言っているんです。ああ、神様。"}, {"type": "subtitle", "time": 18792.07, "timestamp": "05:13:12", "text": "大きなジャガイモを作る。寿司、それは"}, {"type": "subtitle", "time": 18794.23, "timestamp": "05:13:14", "text": "料理してはいけないもの？与える"}, {"type": "subtitle", "time": 18795.75, "timestamp": "05:13:15", "text": "いずれにしても、金額は同じです。それは"}, {"type": "subtitle", "time": 18797.51, "timestamp": "05:13:17", "text": "ベリー？"}, {"type": "subtitle", "time": 18801.67, "timestamp": "05:13:21", "text": "えっと、あれはニンジンでした。ニンジン。わかった。"}, {"type": "subtitle", "time": 18804.23, "timestamp": "05:13:24", "text": "ああ、ニンジンを料理するべきじゃなかった。うん。の"}, {"type": "subtitle", "time": 18807.51, "timestamp": "05:13:27", "text": "彼らが与えるのは、健康増進だけだ。おお、"}, {"type": "subtitle", "time": 18809.67, "timestamp": "05:13:29", "text": "待って。海で魚を釣るにはどうすればいいですか？"}, {"type": "subtitle", "time": 18811.75, "timestamp": "05:13:31", "text": "けれど？釣りはどうやってするのですか？海が必要だ"}, {"type": "subtitle", "time": 18813.83, "timestamp": "05:13:33", "text": "釣り竿。"}, {"type": "subtitle", "time": 18817.11, "timestamp": "05:13:37", "text": "釣りをしたい。"}, {"type": "subtitle", "time": 18820.07, "timestamp": "05:13:40", "text": "今はただ釣りがしたいだけなんです。"}, {"type": "subtitle", "time": 18827.51, "timestamp": "05:13:47", "text": "私はおそらく正気を失うだろう。"}, {"type": "subtitle", "time": 18829.03, "timestamp": "05:13:49", "text": "草がないと復活できない"}, {"type": "subtitle", "time": 18831.59, "timestamp": "05:13:51", "text": "まだ草が生えている。おい、あれはクリスのマリオか？"}, {"type": "subtitle", "time": 18833.75, "timestamp": "05:13:53", "text": "プラット？ああ、私の体へ行って。まるで"}, {"type": "subtitle", "time": 18836.47, "timestamp": "05:13:56", "text": "草。あなたの体はどこにあるの？すでに"}, {"type": "subtitle", "time": 18837.59, "timestamp": "05:13:57", "text": "夜。やってみようと思う"}]
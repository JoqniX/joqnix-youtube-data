[{"type": "subtitle", "time": 5403.03, "timestamp": "01:30:03", "text": "何てことだ。聖なる"}, {"type": "subtitle", "time": 5410.709, "timestamp": "01:30:10", "text": "いや、"}, {"type": "subtitle", "time": 5419.99, "timestamp": "01:30:19", "text": "この人たちは本当に素晴らしい。知っている"}, {"type": "subtitle", "time": 5428.149, "timestamp": "01:30:28", "text": "どうすればすぐにそこに行けますか？これは"}, {"type": "subtitle", "time": 5431.35, "timestamp": "01:30:31", "text": "歩くのが大好き"}, {"type": "subtitle", "time": 5438.79, "timestamp": "01:30:38", "text": "死んだら、それは苦痛だ。あ、待って。銀"}, {"type": "subtitle", "time": 5441.669, "timestamp": "01:30:41", "text": "月。同じだったと思います"}, {"type": "subtitle", "time": 5445.27, "timestamp": "01:30:45", "text": "ガンダムですよね？私はたくさん歩かなければならなかった"}]
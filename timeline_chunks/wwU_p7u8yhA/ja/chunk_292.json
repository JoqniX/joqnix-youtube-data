[{"type": "subtitle", "time": 17521.99, "timestamp": "04:52:01", "text": "プロトタイプも好きだと思います"}, {"type": "subtitle", "time": 17524.31, "timestamp": "04:52:04", "text": "そういうことですよね？はい。プロトタイプを作成できます"}, {"type": "subtitle", "time": 17527.75, "timestamp": "04:52:07", "text": "精神的に安定させてくれるもの。えっと"}, {"type": "subtitle", "time": 17531.83, "timestamp": "04:52:11", "text": "ペニスを作る方法はどこですか？ジェイソン、"}, {"type": "subtitle", "time": 17534.788, "timestamp": "04:52:14", "text": "コックピットミックスアップはどのようなタイプですか"}, {"type": "subtitle", "time": 17536.47, "timestamp": "04:52:16", "text": "なぜ「漁獲量が不足している」と表示されるのか"}, {"type": "subtitle", "time": 17543.59, "timestamp": "04:52:23", "text": "シュート。海では魚は釣れません。あなた"}, {"type": "subtitle", "time": 17547.11, "timestamp": "04:52:27", "text": "池で魚を釣ることができます。釣りをする必要がある。する"}, {"type": "subtitle", "time": 17549.99, "timestamp": "04:52:29", "text": "ところで、皆さんの中に石を持っている人はいますか？えっと、私は"}, {"type": "subtitle", "time": 17552.628, "timestamp": "04:52:32", "text": "8つあります。ハンマーが必要なので"}, {"type": "subtitle", "time": 17553.83, "timestamp": "04:52:33", "text": "家が完成したらカメラを取りに行ける"}, {"type": "subtitle", "time": 17556.868, "timestamp": "04:52:36", "text": "下。コックポットを作らなければならない。私"}, {"type": "subtitle", "time": 17559.27, "timestamp": "04:52:39", "text": "コックポットを作りたい。"}, {"type": "subtitle", "time": 17571.35, "timestamp": "04:52:51", "text": "待って、祝福の翼は"}, {"type": "subtitle", "time": 17573.35, "timestamp": "04:52:53", "text": "肉？ええ、そう思います。うん。おお、"}, {"type": "subtitle", "time": 17576.708, "timestamp": "04:52:56", "text": "待って。ジョック。ジョックはどこにいる？私は思う"}, {"type": "subtitle", "time": 17578.708, "timestamp": "04:52:58", "text": "たぶん食べ物だろう。持続する。がある"}]
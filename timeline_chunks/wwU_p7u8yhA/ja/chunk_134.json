[{"type": "subtitle", "time": 8045.99, "timestamp": "02:14:05", "text": "待って、なぜ彼はなぜこの男は"}, {"type": "subtitle", "time": 8049.27, "timestamp": "02:14:09", "text": "自分？はぁ？"}, {"type": "subtitle", "time": 8051.75, "timestamp": "02:14:11", "text": "何？はぁ？"}, {"type": "subtitle", "time": 8054.79, "timestamp": "02:14:14", "text": "何かありますか？"}, {"type": "subtitle", "time": 8057.189, "timestamp": "02:14:17", "text": "おいおい、勘弁してくれよ。弾薬をもっと遠くまで飛ばせる"}, {"type": "subtitle", "time": 8062.629, "timestamp": "02:14:22", "text": "ああ、それが究極の機能なんだ。わかった、"}, {"type": "subtitle", "time": 8074.709, "timestamp": "02:14:34", "text": "私は死んだ、"}, {"type": "subtitle", "time": 8078.149, "timestamp": "02:14:38", "text": "男。彼は、ピューピューピューピューと撃っていました。"}, {"type": "subtitle", "time": 8085.75, "timestamp": "02:14:45", "text": "痛み。"}, {"type": "subtitle", "time": 8087.75, "timestamp": "02:14:47", "text": "でも私は最善を尽くします"}, {"type": "subtitle", "time": 8090.39, "timestamp": "02:14:50", "text": "ショットガンを持った男。"}]
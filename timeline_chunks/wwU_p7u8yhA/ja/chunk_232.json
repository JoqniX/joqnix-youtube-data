[{"type": "subtitle", "time": 13920.15, "timestamp": "03:52:00", "text": "犠牲。"}, {"type": "subtitle", "time": 13923.429, "timestamp": "03:52:03", "text": "来て。これは何ですか？大丈夫。何"}, {"type": "subtitle", "time": 13925.75, "timestamp": "03:52:05", "text": "何が起こっているのか？"}, {"type": "subtitle", "time": 13927.91, "timestamp": "03:52:07", "text": "はぁ？何が何だ？私は何をすべきなのか？"}, {"type": "subtitle", "time": 13930.309, "timestamp": "03:52:10", "text": "する？もうやめろ。ゲームを起動して"}, {"type": "subtitle", "time": 13933.429, "timestamp": "03:52:13", "text": "招待状をお待ちください。問題。ああ、くそ、"}, {"type": "subtitle", "time": 13935.269, "timestamp": "03:52:15", "text": "夜です。えーっと、クラフトクラフトクラフト"}, {"type": "subtitle", "time": 13938.79, "timestamp": "03:52:18", "text": "クラフト。待って、君たちゲームやってるの？おお、"}, {"type": "subtitle", "time": 13940.469, "timestamp": "03:52:20", "text": "私は"}, {"type": "subtitle", "time": 13943.51, "timestamp": "03:52:23", "text": "接合。飛び込め。飛び込め。とクソ野郎が言った。"}, {"type": "subtitle", "time": 13946.55, "timestamp": "03:52:26", "text": "「シュブ、彼を連れてきて。」"}, {"type": "subtitle", "time": 13950.229, "timestamp": "03:52:30", "text": "どうしてそれが分からなかったんだ？"}, {"type": "subtitle", "time": 13954.229, "timestamp": "03:52:34", "text": "どうやって？全く見当もつきません。私はできません。待って、"}, {"type": "subtitle", "time": 13957.91, "timestamp": "03:52:37", "text": "何？待って。ええ、私は死んでしまいました。どうやって"}, {"type": "subtitle", "time": 13959.67, "timestamp": "03:52:39", "text": "友達を作ろうか？"}, {"type": "subtitle", "time": 13962.79, "timestamp": "03:52:42", "text": "ああ、もう帰るよ。参加するにはどうすればいいですか？"}, {"type": "subtitle", "time": 13965.03, "timestamp": "03:52:45", "text": "ゲームに参加してください。はい、わかりました。わかった。私"}, {"type": "subtitle", "time": 13967.03, "timestamp": "03:52:47", "text": "「s」をクリックしてゲームに参加しました。はい、わかりました"}, {"type": "subtitle", "time": 13970.63, "timestamp": "03:52:50", "text": "それ。遅延しています。かなり動作が遅い。欲しい"}, {"type": "subtitle", "time": 13972.71, "timestamp": "03:52:52", "text": "それをホストする。"}, {"type": "subtitle", "time": 13975.51, "timestamp": "03:52:55", "text": "私は皆さんの中で一番遠いところに住んでいる。あなたは"}, {"type": "subtitle", "time": 13977.99, "timestamp": "03:52:57", "text": "それはうまくいくと思いますか？"}]
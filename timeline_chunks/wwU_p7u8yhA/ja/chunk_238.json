[{"type": "subtitle", "time": 14285.51, "timestamp": "03:58:05", "text": "え、何？何をしたんだ？"}, {"type": "subtitle", "time": 14287.99, "timestamp": "03:58:07", "text": "ああ、これでいい。"}, {"type": "subtitle", "time": 14289.59, "timestamp": "03:58:09", "text": "それは全ての選手を示している。暑い。私"}, {"type": "subtitle", "time": 14291.83, "timestamp": "03:58:11", "text": "理由はわからない。ああ、ツケで。うん、"}, {"type": "subtitle", "time": 14294.469, "timestamp": "03:58:14", "text": "タブのことですね。うん。うん。時々"}, {"type": "subtitle", "time": 14296.309, "timestamp": "03:58:16", "text": "次のような場合に発生します"}, {"type": "subtitle", "time": 14299.83, "timestamp": "03:58:19", "text": "それはダブルだ。カエルが殺されている"}, {"type": "subtitle", "time": 14303.75, "timestamp": "03:58:23", "text": "七面鳥。私は何をしたの？"}, {"type": "subtitle", "time": 14305.75, "timestamp": "03:58:25", "text": "雄鶏を食べろ。雄鶏を取って。殺す"}, {"type": "subtitle", "time": 14309.189, "timestamp": "03:58:29", "text": "コック。雄鶏を殺せ。ああ、七面鳥が"}, {"type": "subtitle", "time": 14312.469, "timestamp": "03:58:32", "text": "亡くなった。うん。雄鶏を食べろ。雄鶏を取って。"}, {"type": "subtitle", "time": 14313.91, "timestamp": "03:58:33", "text": "我慢する。うん。うん。うん。良い。取る"}, {"type": "subtitle", "time": 14317.429, "timestamp": "03:58:37", "text": "雄鶏。雄鶏を取って。ああ、神様。所有"}, {"type": "subtitle", "time": 14321.349, "timestamp": "03:58:41", "text": "上。もう生きろ。どうでも。待って。彼らは"}, {"type": "subtitle", "time": 14323.83, "timestamp": "03:58:43", "text": "既に再生中です。うん。クソ計画"}, {"type": "subtitle", "time": 14331.91, "timestamp": "03:58:51", "text": "私たちはそれを使っています。そうそう。私は1つ持っています"}, {"type": "subtitle", "time": 14335.51, "timestamp": "03:58:55", "text": "今、アイラと計画を立てているところです。そして"}, {"type": "subtitle", "time": 14338.229, "timestamp": "03:58:58", "text": "ええと、それは「間違った意見」と呼ばれています。"}]
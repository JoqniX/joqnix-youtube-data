[{"type": "subtitle", "time": 15605.83, "timestamp": "04:20:05", "text": "どうすれば地獄を再び変えられるのか？たとえ"}, {"type": "subtitle", "time": 15607.67, "timestamp": "04:20:07", "text": "超受動的な奴らを殺して、"}, {"type": "subtitle", "time": 15611.59, "timestamp": "04:20:11", "text": "代わりにクランプスが反応するだろう。ねえ、えっと"}, {"type": "subtitle", "time": 15613.99, "timestamp": "04:20:13", "text": "ごく普通の木です。切った方がいいでしょうか？"}, {"type": "subtitle", "time": 15616.389, "timestamp": "04:20:16", "text": "いいえ、まだです。以下に従ってください"}, {"type": "subtitle", "time": 15619.99, "timestamp": "04:20:19", "text": "レンガの道。わかった。"}, {"type": "subtitle", "time": 15624.229, "timestamp": "04:20:24", "text": "道を進んでください。わかった。私はどうやって生きているのか"}, {"type": "subtitle", "time": 15627.67, "timestamp": "04:20:27", "text": "また？豚の村へようこそ。"}, {"type": "subtitle", "time": 15629.429, "timestamp": "04:20:29", "text": "キャンプファイヤーを囲むのと同じように、"}, {"type": "subtitle", "time": 15631.91, "timestamp": "04:20:31", "text": "リスポーンはオンのままですよね？そうそう。私たちは何を"}, {"type": "subtitle", "time": 15639.429, "timestamp": "04:20:39", "text": "ええ、あなたに"}, {"type": "subtitle", "time": 15641.27, "timestamp": "04:20:41", "text": "うん。わかった。"}, {"type": "subtitle", "time": 15644.07, "timestamp": "04:20:44", "text": "[音楽]"}, {"type": "subtitle", "time": 15645.03, "timestamp": "04:20:45", "text": "ここにはたくさんあるよ。たくさんあります"}, {"type": "subtitle", "time": 15647.51, "timestamp": "04:20:47", "text": "ここ。私は普通の木々をたどって"}, {"type": "subtitle", "time": 15649.269, "timestamp": "04:20:49", "text": "生きるために戦う。"}, {"type": "subtitle", "time": 15650.87, "timestamp": "04:20:50", "text": "うん、また後で。おっと。見ていなかった"}, {"type": "subtitle", "time": 15653.189, "timestamp": "04:20:53", "text": "子豚ちゃん。"}, {"type": "subtitle", "time": 15655.429, "timestamp": "04:20:55", "text": "みんな、どこにいるの？私は"}, {"type": "subtitle", "time": 15658.389, "timestamp": "04:20:58", "text": "岩の集まりが近くにあって、"}]
[{"type": "subtitle", "time": 5821.43, "timestamp": "01:37:01", "text": "課題ですよね？ 10回プレイするという意味でした"}, {"type": "subtitle", "time": 5825.43, "timestamp": "01:37:05", "text": "ゲーム。すべての役割で10試合プレイしてください。何"}, {"type": "subtitle", "time": 5828.07, "timestamp": "01:37:08", "text": "すべての役割とはどういう意味ですか？すべてのいいね！"}, {"type": "subtitle", "time": 5830.709, "timestamp": "01:37:10", "text": "チームメイト全員がこう思うだろう"}, {"type": "subtitle", "time": 5834.149, "timestamp": "01:37:14", "text": "戦車、攻撃、支援など"}, {"type": "subtitle", "time": 5837.109, "timestamp": "01:37:17", "text": "そういう類のことです。"}, {"type": "subtitle", "time": 5839.91, "timestamp": "01:37:19", "text": "ヌナ、"}, {"type": "subtitle", "time": 5842.07, "timestamp": "01:37:22", "text": "この試合の後、私もお腹が空いてきた。"}, {"type": "subtitle", "time": 5845.03, "timestamp": "01:37:25", "text": "じゃあ、ちょっと食事に行ってきます。"}, {"type": "subtitle", "time": 5846.709, "timestamp": "01:37:26", "text": "うん。"}, {"type": "subtitle", "time": 5861.99, "timestamp": "01:37:41", "text": "あなたの党に反対する。あ、待って。私はできる"}, {"type": "subtitle", "time": 5865.43, "timestamp": "01:37:45", "text": "実際にデッドマッチをプレイするなら、"}, {"type": "subtitle", "time": 5869.83, "timestamp": "01:37:49", "text": "パーティーと一緒に。ああ、しまった。 5月別名"}, {"type": "subtitle", "time": 5872.629, "timestamp": "01:37:52", "text": "遠距離攻撃などを始めると"}]
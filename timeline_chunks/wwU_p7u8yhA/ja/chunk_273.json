[{"type": "subtitle", "time": 16382.07, "timestamp": "04:33:02", "text": "皆さんは持っていますか？私はできません。私は必要としています。私は与えました"}, {"type": "subtitle", "time": 16384.31, "timestamp": "04:33:04", "text": "私の友達全員をズキに、そして私は"}, {"type": "subtitle", "time": 16386.15, "timestamp": "04:33:06", "text": "いくつか持っているはずだ。もうすぐ戻ります。"}, {"type": "subtitle", "time": 16390.709, "timestamp": "04:33:10", "text": "ああ、Jnix。ああ、私は死ぬ。これらは私の"}, {"type": "subtitle", "time": 16393.029, "timestamp": "04:33:13", "text": "いいえ。二度と死ぬな。何してるの？"}, {"type": "subtitle", "time": 16400.869, "timestamp": "04:33:20", "text": "彼は早く始めたくてたまらない。"}, {"type": "subtitle", "time": 16402.709, "timestamp": "04:33:22", "text": "少なくともクモはいる。よお、彼は"}, {"type": "subtitle", "time": 16406.869, "timestamp": "04:33:26", "text": "ゲームの名前に負けてるんだよ、兄弟。知っている。"}, {"type": "subtitle", "time": 16413.91, "timestamp": "04:33:33", "text": "してはいけない。それに、一体何のためにそんなことをしたんだ？"}, {"type": "subtitle", "time": 16415.429, "timestamp": "04:33:35", "text": "スズキ、キャンプファイヤーを作ろうか？私たちには"}, {"type": "subtitle", "time": 16418.47, "timestamp": "04:33:38", "text": "クソみたいな焚き火台。ええ、持っていません"}, {"type": "subtitle", "time": 16421.67, "timestamp": "04:33:41", "text": "ここです。鈴木は、スパイダーズに特化している。"}, {"type": "subtitle", "time": 16423.51, "timestamp": "04:33:43", "text": "はい、こちらへ。ここに来て。少なくとも私は"}, {"type": "subtitle", "time": 16425.83, "timestamp": "04:33:45", "text": "そうは思わない。ここにログを入れてください"}, {"type": "subtitle", "time": 16431.349, "timestamp": "04:33:51", "text": "バイバイ。"}, {"type": "subtitle", "time": 16433.269, "timestamp": "04:33:53", "text": "そこにログを入れてください。待って、切り替えてもいいですか？"}, {"type": "subtitle", "time": 16437.109, "timestamp": "04:33:57", "text": "そのキャラクター？いいえ。そうです。いいえ。"}, {"type": "subtitle", "time": 16439.109, "timestamp": "04:33:59", "text": "ああ、痛い。なぜ私は赤毛の女性を選んだのか？"}]
[{"type": "subtitle", "time": 18720.47, "timestamp": "05:12:00", "text": "赤ちゃんに母乳を与える？おそらく。"}, {"type": "subtitle", "time": 18723.59, "timestamp": "05:12:03", "text": "うん、彼女たちの胸はまるでプラグみたい"}, {"type": "subtitle", "time": 18725.75, "timestamp": "05:12:05", "text": "電気プラグ。彼らは"}, {"type": "subtitle", "time": 18729.75, "timestamp": "05:12:09", "text": "配合オイルか、それともただのクソオイルか"}, {"type": "subtitle", "time": 18732.23, "timestamp": "05:12:12", "text": "コンセントから吸い出す。はい。その代わり"}, {"type": "subtitle", "time": 18735.59, "timestamp": "05:12:15", "text": "ベビーオイルの代わりに、彼らはエンジンオイルを使う。"}, {"type": "subtitle", "time": 18738.55, "timestamp": "05:12:18", "text": "はい、結構です。そんなのまっぴらだ。彼らはただ"}, {"type": "subtitle", "time": 18745.43, "timestamp": "05:12:25", "text": "はい。高いものが必要なのは何ですか"}, {"type": "subtitle", "time": 18747.91, "timestamp": "05:12:27", "text": "あの番号からまた電話がかかってきたの？"}, {"type": "subtitle", "time": 18749.75, "timestamp": "05:12:29", "text": "オクタン価。それが"}, {"type": "subtitle", "time": 18751.75, "timestamp": "05:12:31", "text": "予想通りだった。"}, {"type": "subtitle", "time": 18753.43, "timestamp": "05:12:33", "text": "赤ちゃんたち"}, {"type": "subtitle", "time": 18756.628, "timestamp": "05:12:36", "text": "[音楽]"}, {"type": "subtitle", "time": 18758.55, "timestamp": "05:12:38", "text": "大きな赤ちゃんを育てる。ああ、彼は"}, {"type": "subtitle", "time": 18770.15, "timestamp": "05:12:50", "text": "神があなたに光を当てることは決してありませんように"}, {"type": "subtitle", "time": 18778.07, "timestamp": "05:12:58", "text": "まだ夜ではない。よぉ、俺たちは"}]
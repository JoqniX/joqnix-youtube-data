[{"type": "subtitle", "time": 13802.229, "timestamp": "03:50:02", "text": "戻る。なくなってしまった。時々自然に直ります"}, {"type": "subtitle", "time": 13804.55, "timestamp": "03:50:04", "text": "その後。"}, {"type": "subtitle", "time": 13806.63, "timestamp": "03:50:06", "text": "えっと、"}, {"type": "subtitle", "time": 13809.83, "timestamp": "03:50:09", "text": "うん、Z、誕生日おめでとう。"}, {"type": "subtitle", "time": 13813.67, "timestamp": "03:50:13", "text": "みんなで誕生日おめでとうと言って"}, {"type": "subtitle", "time": 13818.469, "timestamp": "03:50:18", "text": "あなた。あなたは動物園に住んでいる。"}, {"type": "subtitle", "time": 13825.67, "timestamp": "03:50:25", "text": "お誕生日おめでとう。わかった。わかった。ハッピー"}, {"type": "subtitle", "time": 13828.389, "timestamp": "03:50:28", "text": "誕生日など、その他多数。"}, {"type": "subtitle", "time": 13831.189, "timestamp": "03:50:31", "text": "お誕生日おめでとう。あなたは"}, {"type": "subtitle", "time": 13833.189, "timestamp": "03:50:33", "text": "誰かが「私はこれが"}, {"type": "subtitle", "time": 13841.59, "timestamp": "03:50:41", "text": "そうそう。"}, {"type": "subtitle", "time": 13855.51, "timestamp": "03:50:55", "text": "私を招待してもらえますか？私は今ゲームに参加していません"}, {"type": "subtitle", "time": 13859.349, "timestamp": "03:50:59", "text": "今。私はプロゲーマーです。私は参加しません。"}]
[{"type": "subtitle", "time": 20044.15, "timestamp": "05:34:04", "text": "私は何が原因で死んだのですか？おい、クモ。"}, {"type": "subtitle", "time": 20050.628, "timestamp": "05:34:10", "text": "ニース。全員死亡した。約10日間"}, {"type": "subtitle", "time": 20054.15, "timestamp": "05:34:14", "text": "GGのGG。"}, {"type": "subtitle", "time": 20056.548, "timestamp": "05:34:16", "text": "すごい。すごい。"}, {"type": "subtitle", "time": 20066.07, "timestamp": "05:34:26", "text": "とても楽しかったです。本当に楽しかった。"}, {"type": "subtitle", "time": 20067.03, "timestamp": "05:34:27", "text": "本当に楽しかった。それは本当に"}, {"type": "subtitle", "time": 20070.708, "timestamp": "05:34:30", "text": "楽しい。しかし、二度と繰り返さない。"}, {"type": "subtitle", "time": 20072.23, "timestamp": "05:34:32", "text": "他の皆さんも、私の気持ちは分かっているでしょう。"}, {"type": "subtitle", "time": 20081.35, "timestamp": "05:34:41", "text": "ああ、これは楽しくない。おやすみ"}, {"type": "subtitle", "time": 20085.19, "timestamp": "05:34:45", "text": "みんな。おやすみ。"}, {"type": "subtitle", "time": 20088.868, "timestamp": "05:34:48", "text": "皆さん、お越しいただきありがとうございました。"}, {"type": "subtitle", "time": 20091.19, "timestamp": "05:34:51", "text": "すみません、あまり話せませんでした。すべて"}, {"type": "subtitle", "time": 20093.11, "timestamp": "05:34:53", "text": "右。君はまるで破壊されているみたいだ"}, {"type": "subtitle", "time": 20094.868, "timestamp": "05:34:54", "text": "とにかく。"}, {"type": "subtitle", "time": 20097.99, "timestamp": "05:34:57", "text": "何？うん、次はそうならないかもしれない"}]
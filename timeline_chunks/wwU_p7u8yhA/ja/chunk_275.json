[{"type": "subtitle", "time": 16500.949, "timestamp": "04:35:00", "text": "食べ物。私の馬力は50馬力です。武器。それらを入手してください。わかった、"}, {"type": "subtitle", "time": 16505.51, "timestamp": "04:35:05", "text": "さぁ行こう。 HPも必要です。"}, {"type": "subtitle", "time": 16508.629, "timestamp": "04:35:08", "text": "ええと、食べ物は食べても構いませんよ。持続する。えっと、どこ"}, {"type": "subtitle", "time": 16511.75, "timestamp": "04:35:11", "text": "どこにいるの？えっと、ただ置くだけです"}, {"type": "subtitle", "time": 16513.269, "timestamp": "04:35:13", "text": "ここに食べ物を置いてください。私は食べ物を受け取ります。"}, {"type": "subtitle", "time": 16515.83, "timestamp": "04:35:15", "text": "はい、ありがとうございます。"}, {"type": "subtitle", "time": 16519.75, "timestamp": "04:35:19", "text": "待って、私は種を食べられない。なぜ？いいえ。ああ、"}, {"type": "subtitle", "time": 16521.75, "timestamp": "04:35:21", "text": "うん。あなたは肉好きですね。忘れていた"}, {"type": "subtitle", "time": 16523.59, "timestamp": "04:35:23", "text": "それ。"}, {"type": "subtitle", "time": 16526.39, "timestamp": "04:35:26", "text": "私は"}, {"type": "subtitle", "time": 16527.83, "timestamp": "04:35:27", "text": "つまり、モンスターミートを手に入れるけど、それは"}, {"type": "subtitle", "time": 16530.789, "timestamp": "04:35:30", "text": "君を死なせるつもりだと思うよ。そして"}, {"type": "subtitle", "time": 16533.75, "timestamp": "04:35:33", "text": "チルダハウスを作っているのは彼ではありません。"}, {"type": "subtitle", "time": 16535.59, "timestamp": "04:35:35", "text": "ええ、なんて呼べばいいんでしょう？"}, {"type": "subtitle", "time": 16537.349, "timestamp": "04:35:37", "text": "みんなが最後にハートをくれた"}, {"type": "subtitle", "time": 16540.869, "timestamp": "04:35:40", "text": "時間。今はハートを贈っています。私は推測する"}, {"type": "subtitle", "time": 16542.949, "timestamp": "04:35:42", "text": "次は君の番だよ、だって俺はできないから"}, {"type": "subtitle", "time": 16546.15, "timestamp": "04:35:46", "text": "くそっ。遅れています。"}, {"type": "subtitle", "time": 16548.31, "timestamp": "04:35:48", "text": "最後に、私は"}, {"type": "subtitle", "time": 16549.99, "timestamp": "04:35:49", "text": "縁起が悪いぞ。でも最後に、私は"}, {"type": "subtitle", "time": 16552.15, "timestamp": "04:35:52", "text": "役に立つ。"}, {"type": "subtitle", "time": 16554.23, "timestamp": "04:35:54", "text": "荷物を取りに行こうかな。私は学んだ"}, {"type": "subtitle", "time": 16558.23, "timestamp": "04:35:58", "text": "あなた。私のことを誇りに思ってくれていますか？今行ってる。"}]
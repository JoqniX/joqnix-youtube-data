[{"type": "subtitle", "time": 11941.429, "timestamp": "03:19:01", "text": "そして、他にこれをやっている人を見たことがない。しかし"}, {"type": "subtitle", "time": 11944.309, "timestamp": "03:19:04", "text": "そうだよ、だって彼女はほぼ毎日配信してるから。おお"}, {"type": "subtitle", "time": 11946.229, "timestamp": "03:19:06", "text": "なんてことだ、ラケンに何が起こったんだ？彼女"}, {"type": "subtitle", "time": 11949.349, "timestamp": "03:19:09", "text": "毎日配信しているような感じ。彼女は言う"}, {"type": "subtitle", "time": 11952.79, "timestamp": "03:19:12", "text": "その日のスケジュールは、彼女が"}, {"type": "subtitle", "time": 11954.63, "timestamp": "03:19:14", "text": "一日で彼女は2回くらい"}, {"type": "subtitle", "time": 11956.469, "timestamp": "03:19:16", "text": "セグメントとかそういうもの。そうです。まるで"}, {"type": "subtitle", "time": 11959.59, "timestamp": "03:19:19", "text": "1つのストリームだが、2つのセグメントと1つを持つ"}, {"type": "subtitle", "time": 11962.55, "timestamp": "03:19:22", "text": "1つのゲームに1時間か2時間かかる、あるいは"}, {"type": "subtitle", "time": 11964.71, "timestamp": "03:19:24", "text": "残りは別のことに使います"}, {"type": "subtitle", "time": 11967.269, "timestamp": "03:19:27", "text": "そんな感じ。つまり、そうすることもできるけど、"}, {"type": "subtitle", "time": 11970.63, "timestamp": "03:19:30", "text": "YouTube ではできない Twitch ではできる"}, {"type": "subtitle", "time": 11973.349, "timestamp": "03:19:33", "text": "物事を分類したり、作ったりするのが好きな人"}, {"type": "subtitle", "time": 11976.87, "timestamp": "03:19:36", "text": "章立てにして、後でタイムスタンプを付けます。しかし、"}, {"type": "subtitle", "time": 11979.59, "timestamp": "03:19:39", "text": "YouTube、そう、それは苦痛だろう。つまり私は"}, {"type": "subtitle", "time": 11983.349, "timestamp": "03:19:43", "text": "それは可能だが、苦痛を伴うだろう。しかし"}, {"type": "subtitle", "time": 11986.71, "timestamp": "03:19:46", "text": "うん。こんにちは。だから、これが私を助けてくれることを願っています"}, {"type": "subtitle", "time": 11989.429, "timestamp": "03:19:49", "text": "これに似たものをもっと作ろう これは"}, {"type": "subtitle", "time": 11992.79, "timestamp": "03:19:52", "text": "練習して、練習して、"}, {"type": "subtitle", "time": 11995.83, "timestamp": "03:19:55", "text": "動画を作ったり、そういうことをするんです。"}, {"type": "subtitle", "time": 11998.15, "timestamp": "03:19:58", "text": "ええ、だって、私は言ったと思うけど"}]
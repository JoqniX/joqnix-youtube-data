[{"type": "subtitle", "time": 17104.47, "timestamp": "04:45:04", "text": "また。"}, {"type": "subtitle", "time": 17107.03, "timestamp": "04:45:07", "text": "あの茶色いクモは何？何てことだ。おお"}, {"type": "subtitle", "time": 17108.868, "timestamp": "04:45:08", "text": "いいえ。"}, {"type": "subtitle", "time": 17110.47, "timestamp": "04:45:10", "text": "もう一つハートを作ってもいいですか？作れない"}, {"type": "subtitle", "time": 17113.51, "timestamp": "04:45:13", "text": "もう一つの心臓。よし、こっちへ来い。"}, {"type": "subtitle", "time": 17116.948, "timestamp": "04:45:16", "text": "私は再び回復に向かうでしょう。"}, {"type": "subtitle", "time": 17118.55, "timestamp": "04:45:18", "text": "私は殺さなければならない、あなたに殺してほしい"}, {"type": "subtitle", "time": 17119.83, "timestamp": "04:45:19", "text": "もしあなたが私を癒したいなら"}, {"type": "subtitle", "time": 17121.99, "timestamp": "04:45:21", "text": "君は、僕にはもう魂がないから。そうそう。おお"}, {"type": "subtitle", "time": 17126.07, "timestamp": "04:45:26", "text": "男の子。まるで子豚みたいだ。"}, {"type": "subtitle", "time": 17128.948, "timestamp": "04:45:28", "text": "Kill the Wait、鈴木はどこだ？鈴木、"}, {"type": "subtitle", "time": 17130.39, "timestamp": "04:45:30", "text": "お前の妹を殺して、クソ野郎を殺せ"}, {"type": "subtitle", "time": 17132.39, "timestamp": "04:45:32", "text": "カエル。クックモンスターミーは３つ"}, {"type": "subtitle", "time": 17135.43, "timestamp": "04:45:35", "text": "28歳ではなく健康。うん。え、何？"}, {"type": "subtitle", "time": 17138.628, "timestamp": "04:45:38", "text": "鈴木、ハンハンがクモを殺すのを手伝って"}, {"type": "subtitle", "time": 17141.27, "timestamp": "04:45:41", "text": "君の妹は強すぎる。"}, {"type": "subtitle", "time": 17144.39, "timestamp": "04:45:44", "text": "ああ、そうだな。来て。必ずあなたの"}, {"type": "subtitle", "time": 17146.788, "timestamp": "04:45:46", "text": "妹は怒っている。うん、でも、"}, {"type": "subtitle", "time": 17148.628, "timestamp": "04:45:48", "text": "ほら、彼女が始めたら角度をずらすんだ"}, {"type": "subtitle", "time": 17151.83, "timestamp": "04:45:51", "text": "巣立ち。そうそう。どうすればいいですか"}, {"type": "subtitle", "time": 17154.868, "timestamp": "04:45:54", "text": "怒り？右クリックですが、"}, {"type": "subtitle", "time": 17156.868, "timestamp": "04:45:56", "text": "彼女を怒らせろと書いてあるから、"}, {"type": "subtitle", "time": 17159.91, "timestamp": "04:45:59", "text": "やってみて。今、"}]
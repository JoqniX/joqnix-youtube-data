[{"type": "subtitle", "time": 15492.149, "timestamp": "04:18:12", "text": "考え"}, {"type": "subtitle", "time": 15503.349, "timestamp": "04:18:23", "text": "私たちは普段私が歌うことについて実際に考えています"}, {"type": "subtitle", "time": 15505.75, "timestamp": "04:18:25", "text": "検閲せずに、でも"}, {"type": "subtitle", "time": 15508.389, "timestamp": "04:18:28", "text": "配信中なので、N は言えません"}, {"type": "subtitle", "time": 15516.79, "timestamp": "04:18:36", "text": "私たちはチンポをしゃぶりに行く旅に出かけます。"}, {"type": "subtitle", "time": 15520.229, "timestamp": "04:18:40", "text": "フォロー、フォロー、フォロー。夜だ。おお"}, {"type": "subtitle", "time": 15522.55, "timestamp": "04:18:42", "text": "くそっ。えっと"}, {"type": "subtitle", "time": 15524.95, "timestamp": "04:18:44", "text": "明かりをつけている人。私は持っていません"}, {"type": "subtitle", "time": 15532.71, "timestamp": "04:18:52", "text": "なんてこった。なんてこった。なんてこった。来て。来て。"}]
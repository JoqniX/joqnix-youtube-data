[{"type": "subtitle", "time": 12370.309, "timestamp": "03:26:10", "text": "そして彼女は、明日また会いましょう"}, {"type": "subtitle", "time": 12372.309, "timestamp": "03:26:12", "text": "明後日、私は投稿します"}, {"type": "subtitle", "time": 12375.03, "timestamp": "03:26:15", "text": "スケジュールなどについては、随時お知らせします。"}, {"type": "subtitle", "time": 12377.99, "timestamp": "03:26:17", "text": "そうですね"}, {"type": "subtitle", "time": 12381.51, "timestamp": "03:26:21", "text": "あなたも"}, {"type": "subtitle", "time": 12383.269, "timestamp": "03:26:23", "text": "最善を尽くしている方々に感謝します"}, {"type": "subtitle", "time": 12384.79, "timestamp": "03:26:24", "text": "あなた"}, {"type": "subtitle", "time": 12388.389, "timestamp": "03:26:28", "text": "こんにちは、ちょっと休憩します。"}, {"type": "subtitle", "time": 12390.63, "timestamp": "03:26:30", "text": "休めると思うけど、うん、出席するよ"}, {"type": "subtitle", "time": 12394.07, "timestamp": "03:26:34", "text": "必要なものを持って行って、リラックスしよう"}, {"type": "subtitle", "time": 12397.11, "timestamp": "03:26:37", "text": "しばらくの間"}, {"type": "subtitle", "time": 12400.95, "timestamp": "03:26:40", "text": "傷跡。バイバイ。"}]
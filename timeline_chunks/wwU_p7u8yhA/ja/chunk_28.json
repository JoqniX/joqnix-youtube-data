[{"type": "subtitle", "time": 1681.35, "timestamp": "00:28:01", "text": "これを育てよう"}, {"type": "subtitle", "time": 1684.149, "timestamp": "00:28:04", "text": "それから。こちらです。いいえ。"}, {"type": "subtitle", "time": 1692.47, "timestamp": "00:28:12", "text": "たぶんこっちだよ。 1 2 3。"}, {"type": "subtitle", "time": 1696.47, "timestamp": "00:28:16", "text": "わかった。 １、２、３、４。"}, {"type": "subtitle", "time": 1712.63, "timestamp": "00:28:32", "text": "それから、こちらにもう1つ。 １、２、２４。"}, {"type": "subtitle", "time": 1715.669, "timestamp": "00:28:35", "text": "よし、あと３つ必要だ"}, {"type": "subtitle", "time": 1718.47, "timestamp": "00:28:38", "text": "これを植えてください。実は、"}, {"type": "subtitle", "time": 1739.59, "timestamp": "00:28:59", "text": "いや、待て、それ以上は行かなかった。"}]
[{"type": "subtitle", "time": 16622.39, "timestamp": "04:37:02", "text": "君は一対一で一匹を飼いならしたんだ、それは"}, {"type": "subtitle", "time": 16625.189, "timestamp": "04:37:05", "text": "仕事？いいえ、それはうまくいきませんでした。えっと、待って。"}, {"type": "subtitle", "time": 16628.31, "timestamp": "04:37:08", "text": "ボタンは何でしたっけ？まるで F. F のようだ。"}, {"type": "subtitle", "time": 16632.07, "timestamp": "04:37:12", "text": "わかった。 F. 食料はどうやって手に入れるのですか？"}, {"type": "subtitle", "time": 16635.51, "timestamp": "04:37:15", "text": "ジョーに食べ物を与えるにはどうすればいいですか？"}, {"type": "subtitle", "time": 16637.349, "timestamp": "04:37:17", "text": "いくつか見つけてください。よし、うまくいったと思う。私"}, {"type": "subtitle", "time": 16639.269, "timestamp": "04:37:19", "text": "うまくいったと思う。待って、食べてもいい？"}, {"type": "subtitle", "time": 16645.349, "timestamp": "04:37:25", "text": "次は魚？さあ、行こう。"}, {"type": "subtitle", "time": 16647.429, "timestamp": "04:37:27", "text": "おい、"}, {"type": "subtitle", "time": 16650.31, "timestamp": "04:37:30", "text": "ギャング同士の抗争。"}, {"type": "subtitle", "time": 16653.189, "timestamp": "04:37:33", "text": "ちなみに、狩りが必要になるだろう。"}, {"type": "subtitle", "time": 16655.67, "timestamp": "04:37:35", "text": "生き残りたいなら。うん。えっと、私は"}, {"type": "subtitle", "time": 16657.99, "timestamp": "04:37:37", "text": "必要なツールは？"}, {"type": "subtitle", "time": 16665.83, "timestamp": "04:37:45", "text": "えっと、戦い。"}, {"type": "subtitle", "time": 16669.109, "timestamp": "04:37:49", "text": "ああ、金塊は持っていません。シングル"}, {"type": "subtitle", "time": 16671.189, "timestamp": "04:37:51", "text": "戦い。もっと見つけられるか見てみましょう"}, {"type": "subtitle", "time": 16672.949, "timestamp": "04:37:52", "text": "クモの腺はまだ必要ないか、"}, {"type": "subtitle", "time": 16676.629, "timestamp": "04:37:56", "text": "もうそれは無理だ。積み上げるべきだ"}, {"type": "subtitle", "time": 16678.629, "timestamp": "04:37:58", "text": "いくつかの。とった。もっと手に入れたい"}]
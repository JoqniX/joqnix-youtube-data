[{"type": "subtitle", "time": 302.469, "timestamp": "00:05:02", "text": "最後に、サムネイルの喜びは"}, {"type": "subtitle", "time": 315.83, "timestamp": "00:05:15", "text": "ヘアドライヤーがあればいいのに。それが本当に困る。"}, {"type": "subtitle", "time": 318.79, "timestamp": "00:05:18", "text": "私は自分の2つを爆発させた"}, {"type": "subtitle", "time": 322.15, "timestamp": "00:05:22", "text": "ヘアドライヤーを実際に使うと"}, {"type": "subtitle", "time": 325.029, "timestamp": "00:05:25", "text": "使いすぎたのでしょうね。"}, {"type": "subtitle", "time": 328.71, "timestamp": "00:05:28", "text": "やはり、タオルを使った絵を描くのは苦痛だ。"}, {"type": "subtitle", "time": 331.59, "timestamp": "00:05:31", "text": "バイバイ。自然なままに"}, {"type": "subtitle", "time": 336.79, "timestamp": "00:05:36", "text": "髪が乾燥している、まるで自然乾燥しているみたい"}, {"type": "subtitle", "time": 341.59000000000003, "timestamp": "00:05:41", "text": "あれ。もし私がそれを気に入ったら、私は"}, {"type": "subtitle", "time": 343.67, "timestamp": "00:05:43", "text": "病気とか何かになるんだけど、"}, {"type": "subtitle", "time": 345.189, "timestamp": "00:05:45", "text": "頭痛"}, {"type": "subtitle", "time": 347.029, "timestamp": "00:05:47", "text": "痛み。"}, {"type": "subtitle", "time": 353.59000000000003, "timestamp": "00:05:53", "text": "他の人はどうやってやっているんだろう。なんてこった。"}, {"type": "subtitle", "time": 357.189, "timestamp": "00:05:57", "text": "髪を乾かすとき、どんなことをしていますか？"}]
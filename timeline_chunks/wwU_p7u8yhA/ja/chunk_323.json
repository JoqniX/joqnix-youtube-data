[{"type": "subtitle", "time": 19381.59, "timestamp": "05:23:01", "text": "力。どうぞ。こっちです。全て"}, {"type": "subtitle", "time": 19384.47, "timestamp": "05:23:04", "text": "右。ここでは、私は落ち込んでいるので遊ぶことができます"}, {"type": "subtitle", "time": 19387.43, "timestamp": "05:23:07", "text": "遊ぶために"}, {"type": "subtitle", "time": 19390.23, "timestamp": "05:23:10", "text": "動画は後ほど。そうよ、妹よ、攻撃しなさい。"}, {"type": "subtitle", "time": 19393.11, "timestamp": "05:23:13", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 19395.67, "timestamp": "05:23:15", "text": "土壌がある。ええ、いくつかあります"}, {"type": "subtitle", "time": 19397.99, "timestamp": "05:23:17", "text": "家に帰ってからも、巨大な肉料理が食べられる。うん、"}, {"type": "subtitle", "time": 19399.83, "timestamp": "05:23:19", "text": "私はただもっと手に入れているだけです"}, {"type": "subtitle", "time": 19402.948, "timestamp": "05:23:22", "text": "いつも良いよ、食べ物にも、そして、"}, {"type": "subtitle", "time": 19405.59, "timestamp": "05:23:25", "text": "知ってるから、あのものを栽培できる"}, {"type": "subtitle", "time": 19410.07, "timestamp": "05:23:30", "text": "後で。私たちはそれを破壊すべきなのでしょうか？"}, {"type": "subtitle", "time": 19411.99, "timestamp": "05:23:31", "text": "私は死ぬだろう。"}, {"type": "subtitle", "time": 19414.628, "timestamp": "05:23:34", "text": "はい、まだ続きがあります。なぜ私は2つ持っているのか"}, {"type": "subtitle", "time": 19417.11, "timestamp": "05:23:37", "text": "つるはし？ああ、なんてことだ。待って、うわ、うわ、"}, {"type": "subtitle", "time": 19420.55, "timestamp": "05:23:40", "text": "うわぁ。何？いいえ、私は遅れています。"}, {"type": "subtitle", "time": 19422.39, "timestamp": "05:23:42", "text": "これは問題だ。それは"}, {"type": "subtitle", "time": 19424.788, "timestamp": "05:23:44", "text": "期待される"}, {"type": "subtitle", "time": 19426.948, "timestamp": "05:23:46", "text": "我々は遅れをとっているように感じる。行く"}, {"type": "subtitle", "time": 19428.948, "timestamp": "05:23:48", "text": "お肉をあげます。使用できます"}, {"type": "subtitle", "time": 19432.47, "timestamp": "05:23:52", "text": "これ。はい、ありがとうございます。肉食者。神"}, {"type": "subtitle", "time": 19434.948, "timestamp": "05:23:54", "text": "くそ。私は肉も好きだけど、"}, {"type": "subtitle", "time": 19436.55, "timestamp": "05:23:56", "text": "の上。"}, {"type": "subtitle", "time": 19439.35, "timestamp": "05:23:59", "text": "食べ物もいただけますか？えーと、つまり、"}]
[{"type": "subtitle", "time": 8522.79, "timestamp": "02:22:02", "text": "この人は誰ですか？ああ、キリコを練習できるよ。私"}, {"type": "subtitle", "time": 8525.19, "timestamp": "02:22:05", "text": "キリコが大好き。"}, {"type": "subtitle", "time": 8529.03, "timestamp": "02:22:09", "text": "私はたくさんのゲームプレイを見てきました。"}, {"type": "subtitle", "time": 8531.83, "timestamp": "02:22:11", "text": "つまり、これらは治癒効果のあるものですよね？これ"}, {"type": "subtitle", "time": 8551.75, "timestamp": "02:22:31", "text": "ああ、ジョー、元気かい？元気です。"}, {"type": "subtitle", "time": 8556.23, "timestamp": "02:22:36", "text": "元気です。お元気ですか？"}, {"type": "subtitle", "time": 8558.07, "timestamp": "02:22:38", "text": "全てのアクセス権。"}, {"type": "subtitle", "time": 8559.19, "timestamp": "02:22:39", "text": "[音楽]"}, {"type": "subtitle", "time": 8565.91, "timestamp": "02:22:45", "text": "おお、"}, {"type": "subtitle", "time": 8568.79, "timestamp": "02:22:48", "text": "私は今、ヒーラーです。"}, {"type": "subtitle", "time": 8579.26, "timestamp": "02:22:59", "text": "これは"}]
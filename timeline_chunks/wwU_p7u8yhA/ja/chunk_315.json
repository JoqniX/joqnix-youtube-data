[{"type": "subtitle", "time": 18901.91, "timestamp": "05:15:01", "text": "胸部にあるべきである。わかった。"}, {"type": "subtitle", "time": 18905.03, "timestamp": "05:15:05", "text": "そこにクソをぶちまけろ。神に誓って。"}, {"type": "subtitle", "time": 18907.35, "timestamp": "05:15:07", "text": "待って、ちょっと待って。待って。"}, {"type": "subtitle", "time": 18910.07, "timestamp": "05:15:10", "text": "ああ、くそ。私の木材はどこへ行ったの？どこ"}, {"type": "subtitle", "time": 18912.788, "timestamp": "05:15:12", "text": "私の木材？私の木材はどこだ？私の"}, {"type": "subtitle", "time": 18918.39, "timestamp": "05:15:18", "text": "みんな、とにかく明かりを灯し始めよう"}, {"type": "subtitle", "time": 18922.07, "timestamp": "05:15:22", "text": "そこに。くそったれ、この[ __ ]どもめ。"}, {"type": "subtitle", "time": 18923.75, "timestamp": "05:15:23", "text": "よし、私は物理的に"}, {"type": "subtitle", "time": 18926.39, "timestamp": "05:15:26", "text": "現実でもお腹が空く。"}, {"type": "subtitle", "time": 18929.03, "timestamp": "05:15:29", "text": "タコモンキー"}, {"type": "subtitle", "time": 18930.55, "timestamp": "05:15:30", "text": "すでに。"}, {"type": "subtitle", "time": 18931.91, "timestamp": "05:15:31", "text": "ああ、このラグ。ありがとうございます"}, {"type": "subtitle", "time": 18945.11, "timestamp": "05:15:45", "text": "わーい！朝です。ここに来て。私は落ち込んでいます"}, {"type": "subtitle", "time": 18947.91, "timestamp": "05:15:47", "text": "もし私がもし私が保持するなら、もし私が受け取るなら、私は"}, {"type": "subtitle", "time": 18951.03, "timestamp": "05:15:51", "text": "1台のHPで動作する。今気づいた。"}, {"type": "subtitle", "time": 18953.59, "timestamp": "05:15:53", "text": "誰かに殺してもらう必要がある"}, {"type": "subtitle", "time": 18954.868, "timestamp": "05:15:54", "text": "うん、こっちに来て。私は好きになれる"}, {"type": "subtitle", "time": 18956.55, "timestamp": "05:15:56", "text": "私はクモを戦わせることができる"}]
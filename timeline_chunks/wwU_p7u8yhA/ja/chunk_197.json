[{"type": "subtitle", "time": 11823.269, "timestamp": "03:17:03", "text": "ツイッター。でも私は知らないかもしれないけど、"}, {"type": "subtitle", "time": 11825.269, "timestamp": "03:17:05", "text": "私はかもしれない"}, {"type": "subtitle", "time": 11828.229, "timestamp": "03:17:08", "text": "かもしれない、かもしれない、かもしれない"}, {"type": "subtitle", "time": 11830.469, "timestamp": "03:17:10", "text": "アップロードするかもしれない"}, {"type": "subtitle", "time": 11834.63, "timestamp": "03:17:14", "text": "モバイルプラットフォームのようなものですが、"}, {"type": "subtitle", "time": 11837.75, "timestamp": "03:17:17", "text": "わからない。ショットとして使うことはできません。私"}, {"type": "subtitle", "time": 11840.229, "timestamp": "03:17:20", "text": "ショットとしては使用できません。はい、それは"}, {"type": "subtitle", "time": 11843.99, "timestamp": "03:17:23", "text": "毎日少しずつ、えーと1分ずつ"}, {"type": "subtitle", "time": 11847.349, "timestamp": "03:17:27", "text": "ビデオは、話す一種の話です"}, {"type": "subtitle", "time": 11851.19, "timestamp": "03:17:31", "text": "ストリームについて、私は"}, {"type": "subtitle", "time": 11852.71, "timestamp": "03:17:32", "text": "ストリームについて話すつもりです"}, {"type": "subtitle", "time": 11855.349, "timestamp": "03:17:35", "text": "今日は何をするつもり？"}, {"type": "subtitle", "time": 11857.91, "timestamp": "03:17:37", "text": "何か発表があれば"}, {"type": "subtitle", "time": 11860.71, "timestamp": "03:17:40", "text": "そして、そういうものもあるし、"}, {"type": "subtitle", "time": 11863.99, "timestamp": "03:17:43", "text": "睡眠はどうだったか、気分はどうですか？"}, {"type": "subtitle", "time": 11867.75, "timestamp": "03:17:47", "text": "うん、そうするよ、これをやってみるよ"}, {"type": "subtitle", "time": 11870.71, "timestamp": "03:17:50", "text": "もし私が朝6時に起きて出かけるとしたら"}, {"type": "subtitle", "time": 11873.429, "timestamp": "03:17:53", "text": "散歩とかそういう時に。アップロードするかもしれません"}, {"type": "subtitle", "time": 11879.03, "timestamp": "03:17:59", "text": "このビデオ、今日のこのやり取り"}]
[{"type": "subtitle", "time": 14701.67, "timestamp": "04:05:01", "text": "ああ、それはあなたのインベントリから取り出せます"}, {"type": "subtitle", "time": 14705.51, "timestamp": "04:05:05", "text": "そして、キャラクターをクリックします。"}, {"type": "subtitle", "time": 14711.91, "timestamp": "04:05:11", "text": "ロック。同じことだ。"}, {"type": "subtitle", "time": 14714.229, "timestamp": "04:05:14", "text": "火打ち石はどうやって作るのですか？"}, {"type": "subtitle", "time": 14717.269, "timestamp": "04:05:17", "text": "あらら。あなたはただ拾うだけです"}, {"type": "subtitle", "time": 14725.83, "timestamp": "04:05:25", "text": "それは良い考えではなかった。そしてこれ"}, {"type": "subtitle", "time": 14728.87, "timestamp": "04:05:28", "text": "草。ああ、ここに石がある。おお"}, {"type": "subtitle", "time": 14732.79, "timestamp": "04:05:32", "text": "神。ああ、神様。ごめんね、みんな。"}, {"type": "subtitle", "time": 14734.55, "timestamp": "04:05:34", "text": "だから少し遅れているんです。どうすればいいですか"}, {"type": "subtitle", "time": 14736.79, "timestamp": "04:05:36", "text": "スマッシュ？"}, {"type": "subtitle", "time": 14738.71, "timestamp": "04:05:38", "text": "いや、墜落したと思ったんだ。私は下へ行った"}, {"type": "subtitle", "time": 14744.07, "timestamp": "04:05:44", "text": "つるはし。ああ、神様。ああ、いいねしないといけない"}, {"type": "subtitle", "time": 14746.55, "timestamp": "04:05:46", "text": "ツール。要件を確認できます"}, {"type": "subtitle", "time": 14749.269, "timestamp": "04:05:49", "text": "あなたが必要とするもの。クソ鳥め。どうすればいいですか"}, {"type": "subtitle", "time": 14751.91, "timestamp": "04:05:51", "text": "火打ち石を手に入れる？これを[ __ ]するつもりですか？"}, {"type": "subtitle", "time": 14755.03, "timestamp": "04:05:55", "text": "床？床に。火打ち石を手に入れた。その"}, {"type": "subtitle", "time": 14758.63, "timestamp": "04:05:58", "text": "石の物体。探してみてください。私はまだ"}]
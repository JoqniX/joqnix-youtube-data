[{"type": "subtitle", "time": 13741.76, "timestamp": "03:49:01", "text": "うん。こんにちは。 キャットボーイと一緒に"}, {"type": "subtitle", "time": 13745.52, "timestamp": "03:49:05", "text": "キャットボーイと一緒に テーマ。"}, {"type": "subtitle", "time": 13748.16, "timestamp": "03:49:08", "text": "テーマ。 入れてください。"}, {"type": "subtitle", "time": 13755.54, "timestamp": "03:49:15", "text": "入れてくれ。入れてくれ。"}, {"type": "subtitle", "time": 13760.63, "timestamp": "03:49:20", "text": "しまった。お前ら一体何者なんだ"}, {"type": "subtitle", "time": 13766.95, "timestamp": "03:49:26", "text": "入れてください。"}, {"type": "subtitle", "time": 13769.67, "timestamp": "03:49:29", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 13773.189, "timestamp": "03:49:33", "text": "入れてくれ。ああ。私は私でした"}, {"type": "subtitle", "time": 13775.11, "timestamp": "03:49:35", "text": "以前はそうだったけど、それからああ神様、彼は"}, {"type": "subtitle", "time": 13777.99, "timestamp": "03:49:37", "text": "同じ世界線を使用している。よし、始めよう。"}, {"type": "subtitle", "time": 13780.309, "timestamp": "03:49:40", "text": "では、危険を冒しましょう。"}, {"type": "subtitle", "time": 13789.189, "timestamp": "03:49:49", "text": "なんてこった。本当に？ああ、そうですね。私は行く"}, {"type": "subtitle", "time": 13795.75, "timestamp": "03:49:55", "text": "ああ、神様。なぜ私も欠けているのだろうか？持続する。"}, {"type": "subtitle", "time": 13798.229, "timestamp": "03:49:58", "text": "ああ、君も遅れてるよ。"}, {"type": "subtitle", "time": 13799.75, "timestamp": "03:49:59", "text": "いいえ、大丈夫です。大丈夫です。それはもうなくなってしまった"}]
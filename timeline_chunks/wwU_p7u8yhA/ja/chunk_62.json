[{"type": "subtitle", "time": 3742.47, "timestamp": "01:02:22", "text": "ヒーローワイヤーチャレンジをアンロック。"}, {"type": "subtitle", "time": 3745.829, "timestamp": "01:02:25", "text": "はぁ？待って、マーシーがどうプレイするか見てみたい"}, {"type": "subtitle", "time": 3747.91, "timestamp": "01:02:27", "text": "こんな感じ。つまり、それは癒しの槍のようなもので、"}, {"type": "subtitle", "time": 3750.39, "timestamp": "01:02:30", "text": "右？これだよ。"}, {"type": "subtitle", "time": 3752.309, "timestamp": "01:02:32", "text": "右、左クリックで回復、右クリックで回復"}, {"type": "subtitle", "time": 3756.71, "timestamp": "01:02:36", "text": "能力値を上げるとか、そういうことですね。"}, {"type": "subtitle", "time": 3768.15, "timestamp": "01:02:48", "text": "ああ、ゆっくりと、ゆっくりと落ちていく。"}, {"type": "subtitle", "time": 3775.03, "timestamp": "01:02:55", "text": "えーと"}, {"type": "subtitle", "time": 3778.71, "timestamp": "01:02:58", "text": "あ、待って、忘れてた"}]
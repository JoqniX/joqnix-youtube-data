[{"type": "subtitle", "time": 13502.87, "timestamp": "03:45:02", "text": "人魚の男がいた。退会するにはどうすればいいですか？"}, {"type": "subtitle", "time": 13512.55, "timestamp": "03:45:12", "text": "わかった。わかった。では、誰が送っているのでしょうか"}, {"type": "subtitle", "time": 13514.63, "timestamp": "03:45:14", "text": "こんにちは？"}, {"type": "subtitle", "time": 13520.07, "timestamp": "03:45:20", "text": "ええ、私です。ああ、ベニーだよ。だった"}, {"type": "subtitle", "time": 13529.59, "timestamp": "03:45:29", "text": "ああ、音楽はいいね。"}, {"type": "subtitle", "time": 13537.51, "timestamp": "03:45:37", "text": "しくじる。神様、あなたがストレッチするのが大好きです"}, {"type": "subtitle", "time": 13540.3, "timestamp": "03:45:40", "text": "ちょうど"}, {"type": "subtitle", "time": 13541.67, "timestamp": "03:45:41", "text": "[拍手]"}, {"type": "subtitle", "time": 13546.229, "timestamp": "03:45:46", "text": "迎えに来るのに1時間かかった。うん。"}, {"type": "subtitle", "time": 13549.429, "timestamp": "03:45:49", "text": "うん。うん。"}, {"type": "subtitle", "time": 13551.189, "timestamp": "03:45:51", "text": "彼はただ、敬意を欠いたために死んだのだ"}, {"type": "subtitle", "time": 13554.07, "timestamp": "03:45:54", "text": "境界線。待って、ストリーミング配信してないの？"}, {"type": "subtitle", "time": 13557.429, "timestamp": "03:45:57", "text": "寿司？私は。どういう意味ですか？死亡"}]
[{"type": "subtitle", "time": 4205.03, "timestamp": "01:10:05", "text": "[音楽]"}, {"type": "subtitle", "time": 4208.58, "timestamp": "01:10:08", "text": "私はこれを選びます。"}, {"type": "subtitle", "time": 4212.149, "timestamp": "01:10:12", "text": "[音楽]"}, {"type": "subtitle", "time": 4218.709, "timestamp": "01:10:18", "text": "ああ、オーバーウォッチの中からすべてを選ぶことができます"}, {"type": "subtitle", "time": 4229.11, "timestamp": "01:10:29", "text": "くそ。ああ、大変だ。ああ、大変だ。さあ行こう。"}, {"type": "subtitle", "time": 4240.77, "timestamp": "01:10:40", "text": "これは気まずい。"}, {"type": "subtitle", "time": 4242.47, "timestamp": "01:10:42", "text": "[音楽]"}, {"type": "subtitle", "time": 4249.669, "timestamp": "01:10:49", "text": "だから、我々はこれを擁護する必要がある。私の心は"}]
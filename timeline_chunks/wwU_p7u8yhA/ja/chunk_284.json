[{"type": "subtitle", "time": 17040.788, "timestamp": "04:44:00", "text": "つまり、一番難しいのは、"}, {"type": "subtitle", "time": 17041.99, "timestamp": "04:44:01", "text": "ジョギングをする人。そうそう。私はあなたに私の"}, {"type": "subtitle", "time": 17043.91, "timestamp": "04:44:03", "text": "種子。持続する。わかった。ドロップするだけ"}, {"type": "subtitle", "time": 17044.708, "timestamp": "04:44:04", "text": "床を掃除して、"}, {"type": "subtitle", "time": 17046.07, "timestamp": "04:44:06", "text": "シード。ジョーはたくさんの"}, {"type": "subtitle", "time": 17048.868, "timestamp": "04:44:08", "text": "食に関する問題。はい。置いてください"}, {"type": "subtitle", "time": 17050.47, "timestamp": "04:44:10", "text": "基地近くの地面を拾えるように"}, {"type": "subtitle", "time": 17053.91, "timestamp": "04:44:13", "text": "上。胸部。胸部。ごめん。"}, {"type": "subtitle", "time": 17059.27, "timestamp": "04:44:19", "text": "胸の中に入れてください。うん。私は私は"}, {"type": "subtitle", "time": 17060.868, "timestamp": "04:44:20", "text": "ドロップインするよ、うん、ドロップインするよ"}, {"type": "subtitle", "time": 17065.19, "timestamp": "04:44:25", "text": "胸。えっと、シルクは必要ですか？"}, {"type": "subtitle", "time": 17069.35, "timestamp": "04:44:29", "text": "ええ、蝶のために"}, {"type": "subtitle", "time": 17071.11, "timestamp": "04:44:31", "text": "どの宝箱を開けるべきかわかりません"}, {"type": "subtitle", "time": 17081.19, "timestamp": "04:44:41", "text": "石が必要だ。石はどうやって見つけるのですか？"}, {"type": "subtitle", "time": 17082.788, "timestamp": "04:44:42", "text": "ああ、"}, {"type": "subtitle", "time": 17087.67, "timestamp": "04:44:47", "text": "空腹感がまた減ってきた。"}, {"type": "subtitle", "time": 17090.07, "timestamp": "04:44:50", "text": "私はまだ火打ち石を持っていません。私はすべてを捧げた"}, {"type": "subtitle", "time": 17093.75, "timestamp": "04:44:53", "text": "私の火打ち石は消え去った。ああ、これは Yeah によるものです。"}, {"type": "subtitle", "time": 17096.31, "timestamp": "04:44:56", "text": "念のため、いくつか道具が必要なだけです。"}]
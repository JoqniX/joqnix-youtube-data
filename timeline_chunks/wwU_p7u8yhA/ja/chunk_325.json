[{"type": "subtitle", "time": 19504.39, "timestamp": "05:25:04", "text": "はい。"}, {"type": "subtitle", "time": 19506.788, "timestamp": "05:25:06", "text": "ヤギ。おい、俺を追いかけられないぞ"}, {"type": "subtitle", "time": 19509.35, "timestamp": "05:25:09", "text": "ここ。くそ。ああ、私は死にかけている。おお"}, {"type": "subtitle", "time": 19515.27, "timestamp": "05:25:15", "text": "くそっ。ああ、くそ。鍵はどこだ、この[ __ ]？"}, {"type": "subtitle", "time": 19518.07, "timestamp": "05:25:18", "text": "クモ族。ああ、スパイダーだ。ニース。私"}, {"type": "subtitle", "time": 19520.15, "timestamp": "05:25:20", "text": "掴めない。私たち二人ともそれを選んだわけではない"}, {"type": "subtitle", "time": 19527.83, "timestamp": "05:25:27", "text": "行き詰まったってどういう意味ですか？いいえ、"}, {"type": "subtitle", "time": 19531.75, "timestamp": "05:25:31", "text": "あなたは行き​​詰まっているわけではありません。放してくれ。いいえ。ああ。"}, {"type": "subtitle", "time": 19535.43, "timestamp": "05:25:35", "text": "くたばれ。くたばれ。"}, {"type": "subtitle", "time": 19537.67, "timestamp": "05:25:37", "text": "この野郎。"}, {"type": "subtitle", "time": 19540.23, "timestamp": "05:25:40", "text": "[音楽]"}, {"type": "subtitle", "time": 19542.07, "timestamp": "05:25:42", "text": "うん。走る。"}, {"type": "subtitle", "time": 19549.75, "timestamp": "05:25:49", "text": "私がまた同じことをできないと誰が言えるだろうか？おお"}, {"type": "subtitle", "time": 19555.11, "timestamp": "05:25:55", "text": "別れ。"}, {"type": "subtitle", "time": 19557.11, "timestamp": "05:25:57", "text": "さようなら。それは私が意図したことではありませんでした"}]
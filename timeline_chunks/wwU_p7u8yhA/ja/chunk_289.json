[{"type": "subtitle", "time": 17341.27, "timestamp": "04:49:01", "text": "ここ。その名前を見ろよ。ズキ"}, {"type": "subtitle", "time": 17345.01, "timestamp": "04:49:05", "text": "こちらです。私は食べられようとしている。"}, {"type": "subtitle", "time": 17348.07, "timestamp": "04:49:08", "text": "[音楽]"}, {"type": "subtitle", "time": 17350.55, "timestamp": "04:49:10", "text": "私は正気を失ったために殺されようとしている。何？"}, {"type": "subtitle", "time": 17353.51, "timestamp": "04:49:13", "text": "ああ、私は"}, {"type": "subtitle", "time": 17355.11, "timestamp": "04:49:15", "text": "あなたに無理やり押し付けてやる。"}, {"type": "subtitle", "time": 17357.19, "timestamp": "04:49:17", "text": "持続する。強制的に食べさせるにはどうすればいいですか？知っている。"}, {"type": "subtitle", "time": 17358.788, "timestamp": "04:49:18", "text": "少なくともキノコは調理しましたか？"}, {"type": "subtitle", "time": 17359.99, "timestamp": "04:49:19", "text": "ええ、もう調理済みです。私"}, {"type": "subtitle", "time": 17363.11, "timestamp": "04:49:23", "text": "すでに調理済みです。うん、彼女は"}, {"type": "subtitle", "time": 17365.43, "timestamp": "04:49:25", "text": "それを受け取って食べなさい。それらを食べなさい。もしあなたの"}, {"type": "subtitle", "time": 17367.83, "timestamp": "04:49:27", "text": "HP 十分なHPがあれば、"}, {"type": "subtitle", "time": 17371.35, "timestamp": "04:49:31", "text": "HPが足りません。"}, {"type": "subtitle", "time": 17373.91, "timestamp": "04:49:33", "text": "ここに立ってください、ただここに立ってください"}, {"type": "subtitle", "time": 17376.708, "timestamp": "04:49:36", "text": "クモが出てきて、"}, {"type": "subtitle", "time": 17379.99, "timestamp": "04:49:39", "text": "妹を怒らせるためだけに、わざとそうしているんだ。"}, {"type": "subtitle", "time": 17381.91, "timestamp": "04:49:41", "text": "ああ、そうそう。うん。走れ、走れ。ただ"}, {"type": "subtitle", "time": 17383.59, "timestamp": "04:49:43", "text": "走る。近づかないでください。あなたの"}, {"type": "subtitle", "time": 17390.868, "timestamp": "04:49:50", "text": "はい、どうぞ。どうぞ、どうぞ。ランニング"}, {"type": "subtitle", "time": 17393.11, "timestamp": "04:49:53", "text": "離れて。行き過ぎないでください。あなたのような"}, {"type": "subtitle", "time": 17394.39, "timestamp": "04:49:54", "text": "クモがあなたの"}, {"type": "subtitle", "time": 17395.67, "timestamp": "04:49:55", "text": "妹。待って、なぜあなたの妹は"}, {"type": "subtitle", "time": 17399.27, "timestamp": "04:49:59", "text": "そちら側？彼女は逃げているから。させて"}]
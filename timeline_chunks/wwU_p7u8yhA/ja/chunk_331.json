[{"type": "subtitle", "time": 19864.15, "timestamp": "05:31:04", "text": "ビゴスを燃やしてもいいですか？ええ、もちろんです。はい、"}, {"type": "subtitle", "time": 19866.788, "timestamp": "05:31:06", "text": "あなたはできる。"}, {"type": "subtitle", "time": 19869.03, "timestamp": "05:31:09", "text": "できるかどうかの問題ではなく、"}, {"type": "subtitle", "time": 19882.07, "timestamp": "05:31:22", "text": "問題は、あなたがそれに火をつけるかどうかだ。"}, {"type": "subtitle", "time": 19884.868, "timestamp": "05:31:24", "text": "答えはイエスです。"}, {"type": "subtitle", "time": 19887.43, "timestamp": "05:31:27", "text": "あなたは既にそれを成し遂げました。何の意味があるの？"}, {"type": "subtitle", "time": 19889.19, "timestamp": "05:31:29", "text": "はい。"}, {"type": "subtitle", "time": 19892.948, "timestamp": "05:31:32", "text": "どれくらい燃え続けるのでしょうか？"}, {"type": "subtitle", "time": 19895.43, "timestamp": "05:31:35", "text": "行かないで。次回をお楽しみに。見つけよう"}, {"type": "subtitle", "time": 19897.99, "timestamp": "05:31:37", "text": "次のエピソードで公開されるかどうか"}, {"type": "subtitle", "time": 19901.35, "timestamp": "05:31:41", "text": "次回のエピソードで。存在しない。"}, {"type": "subtitle", "time": 19903.27, "timestamp": "05:31:43", "text": "そんなことはあり得ない。私たちは、私たちは"}, {"type": "subtitle", "time": 19905.75, "timestamp": "05:31:45", "text": "この次のエピソード。うん。ああ、大変だ。"}, {"type": "subtitle", "time": 19907.99, "timestamp": "05:31:47", "text": "これは何ですか？ちょっとまって。やります、やります"}, {"type": "subtitle", "time": 19914.23, "timestamp": "05:31:54", "text": "これは大混乱になるだろう。うん、そうするよ"}, {"type": "subtitle", "time": 19916.39, "timestamp": "05:31:56", "text": "ポッドキャストについて何かお伝えします"}, {"type": "subtitle", "time": 19917.99, "timestamp": "05:31:57", "text": "なぜなら私はワードファイルを持っているからです"}, {"type": "subtitle", "time": 19919.91, "timestamp": "05:31:59", "text": "現在、私が作りたいものを作っています"}]
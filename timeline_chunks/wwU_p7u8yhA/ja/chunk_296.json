[{"type": "subtitle", "time": 17761.11, "timestamp": "04:56:01", "text": "お腹が空いているのは分かっています。あなたには妹がいる"}, {"type": "subtitle", "time": 17762.628, "timestamp": "04:56:02", "text": "それはあなたにとって物事を台無しにする可能性があり、"}, {"type": "subtitle", "time": 17765.99, "timestamp": "04:56:05", "text": "[ __ ]を食べるのに使える。はい。はい。私はただ"}, {"type": "subtitle", "time": 17768.31, "timestamp": "04:56:08", "text": "食料の入手方法を教えたよ。来て。その"}, {"type": "subtitle", "time": 17770.708, "timestamp": "04:56:10", "text": "死ぬのは難しくない、死なないように"}, {"type": "subtitle", "time": 17773.19, "timestamp": "04:56:13", "text": "飢餓。来て。もっと手に入れています。"}, {"type": "subtitle", "time": 17775.59, "timestamp": "04:56:15", "text": "ああ、ちょっと待って。私は休息が必要だ。私"}, {"type": "subtitle", "time": 17779.19, "timestamp": "04:56:19", "text": "SPがたくさんあると思う"}, {"type": "subtitle", "time": 17780.868, "timestamp": "04:56:20", "text": "まず私を基地へ。あなたにはしてほしくない"}, {"type": "subtitle", "time": 17786.07, "timestamp": "04:56:26", "text": "もう一度死ぬ。もうどうでもいい。私は作っています"}, {"type": "subtitle", "time": 17787.91, "timestamp": "04:56:27", "text": "スロークッカーを作るの？それとも、うん、"}, {"type": "subtitle", "time": 17790.39, "timestamp": "04:56:30", "text": "私は作っています 私は私"}, {"type": "subtitle", "time": 17792.23, "timestamp": "04:56:32", "text": "幽霊として死んでしまえばいい。問題はここだ。"}, {"type": "subtitle", "time": 17794.948, "timestamp": "04:56:34", "text": "モンスターを使えばいいし、私はそうしない"}, {"type": "subtitle", "time": 17797.83, "timestamp": "04:56:37", "text": "幽霊として死ぬことができると思うのか、ダーカー。"}, {"type": "subtitle", "time": 17799.67, "timestamp": "04:56:39", "text": "私はただ"}, {"type": "subtitle", "time": 17804.15, "timestamp": "04:56:44", "text": "二度死ぬ。つまり、試してみたいなら"}, {"type": "subtitle", "time": 17805.99, "timestamp": "04:56:45", "text": "これ、"}, {"type": "subtitle", "time": 17814.39, "timestamp": "04:56:54", "text": "待って、これ食べられるの？何を食べるの？病気"}, {"type": "subtitle", "time": 17816.39, "timestamp": "04:56:56", "text": "あなたに"}, {"type": "subtitle", "time": 17819.59, "timestamp": "04:56:59", "text": "少し遅延しています。ちょっと待ってください。あぁ、"}]
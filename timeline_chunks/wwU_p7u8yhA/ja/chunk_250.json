[{"type": "subtitle", "time": 15000.469, "timestamp": "04:10:00", "text": "簡単すぎる。これは私の問題でもある"}, {"type": "subtitle", "time": 15001.99, "timestamp": "04:10:01", "text": "マインクラフト。"}, {"type": "subtitle", "time": 15004.15, "timestamp": "04:10:04", "text": "よし、キャンプファイヤーを囲んでキャンプに行こう。私は"}, {"type": "subtitle", "time": 15008.469, "timestamp": "04:10:08", "text": "ジョーを迎えに来る。明るくなってきた。作る"}, {"type": "subtitle", "time": 15010.71, "timestamp": "04:10:10", "text": "軽いソース。ねえ、料理したいなら"}, {"type": "subtitle", "time": 15013.03, "timestamp": "04:10:13", "text": "食べ物を用意して、焚き火を焚く。うん、作って"}, {"type": "subtitle", "time": 15015.59, "timestamp": "04:10:15", "text": "ライト。ええ、そうですね。わかった。ええ、それは"}, {"type": "subtitle", "time": 15017.91, "timestamp": "04:10:17", "text": "ああ、こっちへ来てくれ。キャンプファイヤーをします"}, {"type": "subtitle", "time": 15020.55, "timestamp": "04:10:20", "text": "えっと、今夜は"}, {"type": "subtitle", "time": 15023.03, "timestamp": "04:10:23", "text": "ほら、今日私は思い出した、"}, {"type": "subtitle", "time": 15025.11, "timestamp": "04:10:25", "text": "食べる。"}, {"type": "subtitle", "time": 15028.63, "timestamp": "04:10:28", "text": "待って、君は光を失ってしまったよ。私はどちらかというと"}, {"type": "subtitle", "time": 15030.79, "timestamp": "04:10:30", "text": "超ありきたりなタイプの男。その男は"}, {"type": "subtitle", "time": 15039.11, "timestamp": "04:10:39", "text": "ここ。君のために明かりを作ってあげるよ。待って、"}, {"type": "subtitle", "time": 15041.189, "timestamp": "04:10:41", "text": "それには草が必要だ。ああ、さあ、一緒に"}, {"type": "subtitle", "time": 15042.71, "timestamp": "04:10:42", "text": "自分。"}, {"type": "subtitle", "time": 15044.63, "timestamp": "04:10:44", "text": "私と一緒にいて。"}, {"type": "subtitle", "time": 15048.55, "timestamp": "04:10:48", "text": "はい、あなたと一緒にいます。"}, {"type": "subtitle", "time": 15056.87, "timestamp": "04:10:56", "text": "まだ必要"}]
[{"type": "subtitle", "time": 10990.79, "timestamp": "03:03:10", "text": "ついに弓使いのキャラクターをアンロックしました。"}, {"type": "subtitle", "time": 10994.23, "timestamp": "03:03:14", "text": "だから、すごく興奮してるんです。"}, {"type": "subtitle", "time": 10995.99, "timestamp": "03:03:15", "text": "でも、ちょっと難しいんですよね。みんな"}, {"type": "subtitle", "time": 11000.23, "timestamp": "03:03:20", "text": "あなたがそれを手に入れる間、銃を乱射するでしょう"}, {"type": "subtitle", "time": 11002.87, "timestamp": "03:03:22", "text": "頭部への一発の銃弾。無料です。はい、"}, {"type": "subtitle", "time": 11027.67, "timestamp": "03:03:47", "text": "あ、待って。"}, {"type": "subtitle", "time": 11031.11, "timestamp": "03:03:51", "text": "私ならできる。おお。"}]
[{"type": "subtitle", "time": 7532.07, "timestamp": "02:05:32", "text": "何だって？"}, {"type": "subtitle", "time": 7535.43, "timestamp": "02:05:35", "text": "彼は私を切りつけた。何？ベイビー、できないよ"}, {"type": "subtitle", "time": 7538.709, "timestamp": "02:05:38", "text": "弾丸を避けながら"}, {"type": "subtitle", "time": 7544.47, "timestamp": "02:05:44", "text": "試しに。"}]
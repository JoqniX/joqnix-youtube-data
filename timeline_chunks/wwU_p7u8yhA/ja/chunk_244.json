[{"type": "subtitle", "time": 14641.67, "timestamp": "04:04:01", "text": "ここ。ああ、"}, {"type": "subtitle", "time": 14644.79, "timestamp": "04:04:04", "text": "受け取ります。ああ、その通りだ。はい、私は"}, {"type": "subtitle", "time": 14649.75, "timestamp": "04:04:09", "text": "事態はさらに悪化するだろう。今度は石が必要だ。あなた"}, {"type": "subtitle", "time": 14652.07, "timestamp": "04:04:12", "text": "花を食べることができます。"}, {"type": "subtitle", "time": 14654.55, "timestamp": "04:04:14", "text": "これは私のものです。花はあなたに"}, {"type": "subtitle", "time": 14655.91, "timestamp": "04:04:15", "text": "ちなみに、空腹のことです。それはあなたに"}, {"type": "subtitle", "time": 14657.429, "timestamp": "04:04:17", "text": "健康。だから、私はお勧めしません。それはただ"}, {"type": "subtitle", "time": 14667.429, "timestamp": "04:04:27", "text": "なぜか、それは健康に良い。ああ神様、"}, {"type": "subtitle", "time": 14670.63, "timestamp": "04:04:30", "text": "それはクソ野郎だ。わかった。よぉ、殺せ"}, {"type": "subtitle", "time": 14674.309, "timestamp": "04:04:34", "text": "コック。うん。さよなら。ペニスが速すぎる。"}, {"type": "subtitle", "time": 14678.229, "timestamp": "04:04:38", "text": "わかった。私はチンポを掴むことができない。"}, {"type": "subtitle", "time": 14680.79, "timestamp": "04:04:40", "text": "滑り落ちている。私は「それは」にこだわる"}, {"type": "subtitle", "time": 14682.71, "timestamp": "04:04:42", "text": "滑っている。"}, {"type": "subtitle", "time": 14685.429, "timestamp": "04:04:45", "text": "警備員たち。はい。ああ、どうぞ。食べ物。"}, {"type": "subtitle", "time": 14687.11, "timestamp": "04:04:47", "text": "食べ物。食べ物。何てことだ。それも来る"}, {"type": "subtitle", "time": 14689.03, "timestamp": "04:04:49", "text": "私にとっては速い。"}, {"type": "subtitle", "time": 14692.309, "timestamp": "04:04:52", "text": "なんてこった。あまりにも早くやってくる。"}, {"type": "subtitle", "time": 14694.55, "timestamp": "04:04:54", "text": "ここ。ニンジンを食べましょう。ニンジン"}, {"type": "subtitle", "time": 14698.469, "timestamp": "04:04:58", "text": "そしてベリー類。ああ、ニンジンは食べられるよ。"}]
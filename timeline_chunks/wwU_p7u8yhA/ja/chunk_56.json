[{"type": "subtitle", "time": 3362.15, "timestamp": "00:56:02", "text": "コントロールを設定しました。だから今回は"}, {"type": "subtitle", "time": 3365.91, "timestamp": "00:56:05", "text": "設定してください。こんにちは。"}, {"type": "subtitle", "time": 3368.63, "timestamp": "00:56:08", "text": "えっと"}, {"type": "subtitle", "time": 3371.589, "timestamp": "00:56:11", "text": "わかった。しゃがんで見る。いいえ、"}, {"type": "subtitle", "time": 3381.109, "timestamp": "00:56:21", "text": "知っている。私は慈悲になりたい。はい。"}, {"type": "subtitle", "time": 3382.95, "timestamp": "00:56:22", "text": "見てみましょう。これはどれくらいプレイできますか？"}, {"type": "subtitle", "time": 3384.549, "timestamp": "00:56:24", "text": "ゲーム？"}, {"type": "subtitle", "time": 3390.47, "timestamp": "00:56:30", "text": "ええ、そうですね。アカビ。うん。あ、待って。"}, {"type": "subtitle", "time": 3395.91, "timestamp": "00:56:35", "text": "つまり、スペースをジャンプして能力をシフト E Q で"}, {"type": "subtitle", "time": 3399.91, "timestamp": "00:56:39", "text": "F. だから、私がしたいのは、"}, {"type": "subtitle", "time": 3402.87, "timestamp": "00:56:42", "text": "インドラトとしてE"}, {"type": "subtitle", "time": 3408.069, "timestamp": "00:56:48", "text": "そして能力、えっと、待ってください。では、能力その１。"}, {"type": "subtitle", "time": 3410.39, "timestamp": "00:56:50", "text": "いや、いや、いや。左シフトのままにしておきます。それで"}, {"type": "subtitle", "time": 3413.19, "timestamp": "00:56:53", "text": "たぶん、それは物事をうまく運営しているようなものだろう。"}, {"type": "subtitle", "time": 3417.109, "timestamp": "00:56:57", "text": "つまり、能力２はQで"}]
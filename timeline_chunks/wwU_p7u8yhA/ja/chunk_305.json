[{"type": "subtitle", "time": 18300.788, "timestamp": "05:05:00", "text": "えっと、クラフトに行ってください。戦いに行く"}, {"type": "subtitle", "time": 18303.35, "timestamp": "05:05:03", "text": "それは「戦闘」タブにあるはずです。"}, {"type": "subtitle", "time": 18305.27, "timestamp": "05:05:05", "text": "特別な槍のようなものだ。おお、"}, {"type": "subtitle", "time": 18307.59, "timestamp": "05:05:07", "text": "戦闘用の槍。わかった。うん。わかった。戦い"}, {"type": "subtitle", "time": 18310.07, "timestamp": "05:05:10", "text": "槍と戦闘用兜。どうすればいいですか？"}, {"type": "subtitle", "time": 18312.628, "timestamp": "05:05:12", "text": "えっと、待って。金の塊が必要だ。できますか"}, {"type": "subtitle", "time": 18315.27, "timestamp": "05:05:15", "text": "冷蔵庫に材料はありますか？私は"}, {"type": "subtitle", "time": 18318.31, "timestamp": "05:05:18", "text": "宝箱から金の塊が出てきたってことかな。おお"}, {"type": "subtitle", "time": 18323.43, "timestamp": "05:05:23", "text": "くそっ。ああ、くそ。私は一つを台無しにしてしまった。"}, {"type": "subtitle", "time": 18326.31, "timestamp": "05:05:26", "text": "食べ物を落とします。どこ？待って、どうやって"}, {"type": "subtitle", "time": 18331.59, "timestamp": "05:05:31", "text": "アイテムを分割しましたか？アイテムを分割する。待って、"}, {"type": "subtitle", "time": 18335.59, "timestamp": "05:05:35", "text": "それなら、食べ物をどこかに置いておけばいい。どうすればいいですか"}, {"type": "subtitle", "time": 18337.43, "timestamp": "05:05:37", "text": "アイテムをクリックして、"}, {"type": "subtitle", "time": 18340.948, "timestamp": "05:05:40", "text": "地面？それは食べ物ではありません。"}, {"type": "subtitle", "time": 18345.43, "timestamp": "05:05:45", "text": "えっと、どうやってアイテムを分割するんですか？"}, {"type": "subtitle", "time": 18349.91, "timestamp": "05:05:49", "text": "えっと、コントロールを保持して、ああ、モンスター。"}, {"type": "subtitle", "time": 18352.31, "timestamp": "05:05:52", "text": "わかった。ありがとう。気をつけて"}, {"type": "subtitle", "time": 18355.19, "timestamp": "05:05:55", "text": "モンスターを食べる。 HPが必要です。うん、君"}, {"type": "subtitle", "time": 18358.23, "timestamp": "05:05:58", "text": "死ぬかもしれない。え、何これ？私は思う"}, {"type": "subtitle", "time": 18359.67, "timestamp": "05:05:59", "text": "台無しにしてしまった。ああ、やらかしたよ。所有"}]
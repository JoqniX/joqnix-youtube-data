[{"type": "subtitle", "time": 18362.39, "timestamp": "05:06:02", "text": "の上。言い換えさせてください。"}, {"type": "subtitle", "time": 18363.99, "timestamp": "05:06:03", "text": "走る。"}, {"type": "subtitle", "time": 18369.27, "timestamp": "05:06:09", "text": "はい、えっと、なんて言うんでしたっけ？"}, {"type": "subtitle", "time": 18371.11, "timestamp": "05:06:11", "text": "フレンド"}, {"type": "subtitle", "time": 18373.43, "timestamp": "05:06:13", "text": "の"}, {"type": "subtitle", "time": 18381.19, "timestamp": "05:06:21", "text": "9日目。"}, {"type": "subtitle", "time": 18385.27, "timestamp": "05:06:25", "text": "ええ、まだ9日目ですからね。想像する"}, {"type": "subtitle", "time": 18388.07, "timestamp": "05:06:28", "text": "なんてこった。窓ガラスによる死傷者は何人いるか"}, {"type": "subtitle", "time": 18390.948, "timestamp": "05:06:30", "text": "私たちが経験したこと？私はまだ死んでいません、"}, {"type": "subtitle", "time": 18393.35, "timestamp": "05:06:33", "text": "ありがたいことに。待って、どれくらいの時間が経ったか"}, {"type": "subtitle", "time": 18395.59, "timestamp": "05:06:35", "text": "死ぬのか？ちなみに、もしあなたが癒しを必要としているなら"}, {"type": "subtitle", "time": 18398.628, "timestamp": "05:06:38", "text": "あなたはできる。ああ、あなたは癒しが必要なのですか？はい。自分、"}, {"type": "subtitle", "time": 18401.35, "timestamp": "05:06:41", "text": "あまりにも。同じ。"}, {"type": "subtitle", "time": 18404.23, "timestamp": "05:06:44", "text": "ありがとう。ありがとう。はい、"}, {"type": "subtitle", "time": 18407.03, "timestamp": "05:06:47", "text": "右。私たちは大丈夫です。いくつかもらえますか？"}, {"type": "subtitle", "time": 18409.75, "timestamp": "05:06:49", "text": "肉類？うん、取って。さあ、掴んで。"}, {"type": "subtitle", "time": 18411.83, "timestamp": "05:06:51", "text": "さあ、掴んで。あなたのために作りました"}, {"type": "subtitle", "time": 18414.31, "timestamp": "05:06:54", "text": "具体的には。"}, {"type": "subtitle", "time": 18416.85, "timestamp": "05:06:56", "text": "だって、君は食べ物が必要だったんだから。"}, {"type": "subtitle", "time": 18418.708, "timestamp": "05:06:58", "text": "[音楽]"}]
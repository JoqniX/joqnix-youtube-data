[{"type": "subtitle", "time": 3241.91, "timestamp": "00:54:01", "text": "待って。彼女はバトルパスです。ノ・ヒョクは"}, {"type": "subtitle", "time": 3248.71, "timestamp": "00:54:08", "text": "待って。わかった、いいよ。"}, {"type": "subtitle", "time": 3254.71, "timestamp": "00:54:14", "text": "だから、アッシュを選ぶしかないかな。"}, {"type": "subtitle", "time": 3258.15, "timestamp": "00:54:18", "text": "アッシュかメイのどちらかを選ぶよ。あ、待って。"}, {"type": "subtitle", "time": 3261.43, "timestamp": "00:54:21", "text": "このゲームで弓使いは誰ですか？したい"}, {"type": "subtitle", "time": 3264.79, "timestamp": "00:54:24", "text": "弓使いクラスを選びます。Bが好きなので。"}, {"type": "subtitle", "time": 3273.829, "timestamp": "00:54:33", "text": "BPを稼いでアンロックできます。え、本当に？"}, {"type": "subtitle", "time": 3276.069, "timestamp": "00:54:36", "text": "えっと、弓を射る人は誰？あ、待って。私"}, {"type": "subtitle", "time": 3280.309, "timestamp": "00:54:40", "text": "この男が弓使いだと思う。ハンゾー。"}, {"type": "subtitle", "time": 3282.95, "timestamp": "00:54:42", "text": "おお、"}, {"type": "subtitle", "time": 3285.589, "timestamp": "00:54:45", "text": "うん。ええ、ええ。だから、私は努力しようと思う"}, {"type": "subtitle", "time": 3290.15, "timestamp": "00:54:50", "text": "ハンゾーのために。アート・スーラクラスが大好きだから。"}, {"type": "subtitle", "time": 3292.549, "timestamp": "00:54:52", "text": "ディーヴァがここにいる。何てことだ。伝説"}, {"type": "subtitle", "time": 3294.069, "timestamp": "00:54:54", "text": "歌姫。"}, {"type": "subtitle", "time": 3297.349, "timestamp": "00:54:57", "text": "何てことだ。"}]
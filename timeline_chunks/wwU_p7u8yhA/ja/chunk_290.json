[{"type": "subtitle", "time": 17401.59, "timestamp": "04:50:01", "text": "妹が仕事をするんだ。"}, {"type": "subtitle", "time": 17404.628, "timestamp": "04:50:04", "text": "スズキ、近くにいてくれ。逃げないで。"}, {"type": "subtitle", "time": 17406.39, "timestamp": "04:50:06", "text": "近い、という意味だが、近すぎない。"}, {"type": "subtitle", "time": 17408.39, "timestamp": "04:50:08", "text": "まあ、そんな感じですね。"}, {"type": "subtitle", "time": 17410.15, "timestamp": "04:50:10", "text": "近くにいてください。"}, {"type": "subtitle", "time": 17424.708, "timestamp": "04:50:24", "text": "私は彼を殴った。彼を殴れ。"}, {"type": "subtitle", "time": 17428.39, "timestamp": "04:50:28", "text": "彼を殴れ。あの野郎をぶちのめせ。よし。"}, {"type": "subtitle", "time": 17431.99, "timestamp": "04:50:31", "text": "わかった。誰が癒しを必要としているのか？自分。私は死にかけている、"}, {"type": "subtitle", "time": 17434.868, "timestamp": "04:50:34", "text": "兄弟。もう諦めろ。こっちへ来い。食べ物。"}, {"type": "subtitle", "time": 17437.59, "timestamp": "04:50:37", "text": "私も食べ物が必要です。"}, {"type": "subtitle", "time": 17439.83, "timestamp": "04:50:39", "text": "食べ物。姉さん、あなたには"}, {"type": "subtitle", "time": 17442.31, "timestamp": "04:50:42", "text": "あなたのために敵を殺します。それを使ってください。"}, {"type": "subtitle", "time": 17445.27, "timestamp": "04:50:45", "text": "また、回復時間も必要です。私はもっ​​と多くの種を手に入れます。"}, {"type": "subtitle", "time": 17447.59, "timestamp": "04:50:47", "text": "ここに種を植えます。わーい。"}, {"type": "subtitle", "time": 17449.91, "timestamp": "04:50:49", "text": "回復期間。はい、どうぞ。"}, {"type": "subtitle", "time": 17453.03, "timestamp": "04:50:53", "text": "クモの腺。また、最大損失額"}, {"type": "subtitle", "time": 17455.51, "timestamp": "04:50:55", "text": "ちなみに、もしあなたが死に続けるなら、健康状態はどうなるか分かりません。"}, {"type": "subtitle", "time": 17457.03, "timestamp": "04:50:57", "text": "うん。"}, {"type": "subtitle", "time": 17459.91, "timestamp": "04:50:59", "text": "では、どうすれば復元できるのでしょうか？えーと、ブースター"}]
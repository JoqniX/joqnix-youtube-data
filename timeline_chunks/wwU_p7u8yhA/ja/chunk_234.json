[{"type": "subtitle", "time": 14047.03, "timestamp": "03:54:07", "text": "今日はそれはしません。なんてこった。作る"}, {"type": "subtitle", "time": 14049.59, "timestamp": "03:54:09", "text": "もっと。"}, {"type": "subtitle", "time": 14052.79, "timestamp": "03:54:12", "text": "さらに問題を追加してください。どんな問題が好きですか？"}, {"type": "subtitle", "time": 14054.71, "timestamp": "03:54:14", "text": "楽しい。"}, {"type": "subtitle", "time": 14057.51, "timestamp": "03:54:17", "text": "技術的な問題。楽しい。テクニカル"}, {"type": "subtitle", "time": 14058.87, "timestamp": "03:54:18", "text": "困難。私は技術が好きです"}, {"type": "subtitle", "time": 14060.87, "timestamp": "03:54:20", "text": "困難。よし、見てみよう。私たちはそうしません"}, {"type": "subtitle", "time": 14065.189, "timestamp": "03:54:25", "text": "30分経過したい。はい、"}, {"type": "subtitle", "time": 14070.87, "timestamp": "03:54:30", "text": "プッシュが現れる時が来たら、それはテトリスだ"}, {"type": "subtitle", "time": 14074.389, "timestamp": "03:54:34", "text": "ストリーム。なんてこった。"}, {"type": "subtitle", "time": 14076.63, "timestamp": "03:54:36", "text": "エリックは私たち全員を殴り倒すつもりだ。彼は"}, {"type": "subtitle", "time": 14079.11, "timestamp": "03:54:39", "text": "それは私たち全員のことになるでしょう。"}, {"type": "subtitle", "time": 14081.11, "timestamp": "03:54:41", "text": "こちらに切り替えてください"}, {"type": "subtitle", "time": 14082.95, "timestamp": "03:54:42", "text": "このゲームを修正している間は、これ以上は何もできません。私はできません"}, {"type": "subtitle", "time": 14086.07, "timestamp": "03:54:46", "text": "遊ぶ。えっと、あなたは私が友達じゃないって言うの？"}, {"type": "subtitle", "time": 14089.189, "timestamp": "03:54:49", "text": "それはプロがよく言うことだ。"}, {"type": "subtitle", "time": 14092.55, "timestamp": "03:54:52", "text": "ああ、神様。ジェイソンの方が優れている"}, {"type": "subtitle", "time": 14095.59, "timestamp": "03:54:55", "text": "そしてウィローは"}]
[{"type": "subtitle", "time": 10620.469, "timestamp": "02:57:00", "text": "うん。こんにちは、ピカチュウ。来て。来て。"}, {"type": "subtitle", "time": 10622.55, "timestamp": "02:57:02", "text": "久しぶりですね。"}, {"type": "subtitle", "time": 10624.309, "timestamp": "02:57:04", "text": "元気ですか？"}, {"type": "subtitle", "time": 10630.55, "timestamp": "02:57:10", "text": "私は本当に気に入っています"}, {"type": "subtitle", "time": 10634.469, "timestamp": "02:57:14", "text": "お辞儀をするが、また、それは少し難しい"}, {"type": "subtitle", "time": 10654.07, "timestamp": "02:57:34", "text": "いいえ、"}, {"type": "subtitle", "time": 10657.91, "timestamp": "02:57:37", "text": "いつもあのサムライの男が"}, {"type": "subtitle", "time": 10661.91, "timestamp": "02:57:41", "text": "メッカのロボット侍の男。私は"}, {"type": "subtitle", "time": 10666.309, "timestamp": "02:57:46", "text": "彼が私に働きかけてくれる時はいつでも嬉しい。私は"}, {"type": "subtitle", "time": 10670.79, "timestamp": "02:57:50", "text": "良い。ピカ、もっと私を選んで。必ず"}, {"type": "subtitle", "time": 10673.75, "timestamp": "02:57:53", "text": "休む。"}]
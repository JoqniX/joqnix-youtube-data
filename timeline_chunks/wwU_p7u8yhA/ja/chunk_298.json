[{"type": "subtitle", "time": 17880.47, "timestamp": "04:58:00", "text": "何てことだ。"}, {"type": "subtitle", "time": 17883.27, "timestamp": "04:58:03", "text": "まあ、私はとにかくそうだったんだけどね。もう1つ、もう1つ"}, {"type": "subtitle", "time": 17885.83, "timestamp": "04:58:05", "text": "肉をスロークッカーで調理する。ああ、わかった、わかった"}, {"type": "subtitle", "time": 17888.31, "timestamp": "04:58:08", "text": "大量のクモ。ええ、そうです。えっと、モンスター"}, {"type": "subtitle", "time": 17890.868, "timestamp": "04:58:10", "text": "肉。ああ、彼らはそれを取り除いたんだ。なんてこった。"}, {"type": "subtitle", "time": 17895.27, "timestamp": "04:58:15", "text": "巨大な肉。私はモンスターを2匹飼っていました。"}, {"type": "subtitle", "time": 17897.03, "timestamp": "04:58:17", "text": "待って、それは正しいレシピなの？"}, {"type": "subtitle", "time": 17900.39, "timestamp": "04:58:20", "text": "いいえ。ええ、それで大丈夫です。よし、"}, {"type": "subtitle", "time": 17903.51, "timestamp": "04:58:23", "text": "見る。何てことだ。 3つのフィラーが1つに。おお"}, {"type": "subtitle", "time": 17905.27, "timestamp": "04:58:25", "text": "男の子。"}, {"type": "subtitle", "time": 17908.23, "timestamp": "04:58:28", "text": "具材が3つで、肉が1つ、ってことだよね？"}, {"type": "subtitle", "time": 17919.43, "timestamp": "04:58:39", "text": "死んだ。"}, {"type": "subtitle", "time": 17920.708, "timestamp": "04:58:40", "text": "あそこにミートボールがありますよ。あなたはできる"}, {"type": "subtitle", "time": 17922.39, "timestamp": "04:58:42", "text": "欲しければ手に入れてください。腹ペコだ。"}, {"type": "subtitle", "time": 17924.708, "timestamp": "04:58:44", "text": "掴め。うん。それと、私には誰かが必要なんです。"}, {"type": "subtitle", "time": 17926.948, "timestamp": "04:58:46", "text": "待って、暗いよ。ああ、暗い。おお"}, {"type": "subtitle", "time": 17929.19, "timestamp": "04:58:49", "text": "いいえ。"}, {"type": "subtitle", "time": 17931.19, "timestamp": "04:58:51", "text": "えっと、ちょっと待ってください。君にハートを作ってあげられるよ、"}, {"type": "subtitle", "time": 17935.11, "timestamp": "04:58:55", "text": "考える。まだ十分な額がありますか？私"}, {"type": "subtitle", "time": 17938.55, "timestamp": "04:58:58", "text": "スパイダーマンが必要だ。私はできる、ああ、"}]
[{"type": "subtitle", "time": 15182.95, "timestamp": "04:13:02", "text": "あれを殺そう。ええ、私たちは"}, {"type": "subtitle", "time": 15184.229, "timestamp": "04:13:04", "text": "またいつかやってみよう。我々は出来た"}, {"type": "subtitle", "time": 15186.469, "timestamp": "04:13:06", "text": "それを再生して。どこで食事ができますか？だって私はそうじゃないから"}, {"type": "subtitle", "time": 15189.99, "timestamp": "04:13:09", "text": "あなたが言いたかったのは、おそらくこうだったのでしょう。"}, {"type": "subtitle", "time": 15193.349, "timestamp": "04:13:13", "text": "はい、大成功でした。ああ、なんてことだ。ここはどこ"}, {"type": "subtitle", "time": 15196.229, "timestamp": "04:13:16", "text": "散らばっている？いいえ、私はドラムスティックを食べられます。私"}, {"type": "subtitle", "time": 15198.95, "timestamp": "04:13:18", "text": "鶏肉しか食べられない。ああ、もう食べられない。"}, {"type": "subtitle", "time": 15199.99, "timestamp": "04:13:19", "text": "君たちがどこにいるのかさえ知らないよ。"}, {"type": "subtitle", "time": 15203.03, "timestamp": "04:13:23", "text": "現時点では、端を巻き付ける作業だけを行っています。"}, {"type": "subtitle", "time": 15207.51, "timestamp": "04:13:27", "text": "これは何にカウントされるのですか？ああ、それはできません。"}, {"type": "subtitle", "time": 15210.149, "timestamp": "04:13:30", "text": "私は村を見つけた。"}, {"type": "subtitle", "time": 15212.469, "timestamp": "04:13:32", "text": "おお、いいね。私たちはその近くに拠点を置くことができます"}, {"type": "subtitle", "time": 15215.429, "timestamp": "04:13:35", "text": "場所。私は怪物だからできない。おお、"}, {"type": "subtitle", "time": 15217.99, "timestamp": "04:13:37", "text": "うん。そうそう。私も忘れていました"}, {"type": "subtitle", "time": 15221.11, "timestamp": "04:13:41", "text": "彼らはとんでもなく人種差別主義者だ。ええ、彼らは"}, {"type": "subtitle", "time": 15224.389, "timestamp": "04:13:44", "text": "資本主義的で人種差別的。"}, {"type": "subtitle", "time": 15227.91, "timestamp": "04:13:47", "text": "勤務先企業。彼らのところへ行こう。ない"}, {"type": "subtitle", "time": 15229.83, "timestamp": "04:13:49", "text": "ゲイだけど、靴下を履いたままなら、"}, {"type": "subtitle", "time": 15231.91, "timestamp": "04:13:51", "text": "そうはならないでしょう。"}, {"type": "subtitle", "time": 15233.91, "timestamp": "04:13:53", "text": "おい、お前、ギリギリまで我慢してるぞ。ああ、おい。私は"}]
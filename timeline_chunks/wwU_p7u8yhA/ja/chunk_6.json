[{"type": "subtitle", "time": 363.749, "timestamp": "00:06:03", "text": "まさに女王様。"}, {"type": "subtitle", "time": 378.79, "timestamp": "00:06:18", "text": "おお。わからない。目の奥"}, {"type": "subtitle", "time": 381.59, "timestamp": "00:06:21", "text": "何か熱いものが体に触れているような感覚です。"}, {"type": "subtitle", "time": 384.23, "timestamp": "00:06:24", "text": "わからない。眼球の奥。これ"}, {"type": "subtitle", "time": 386.95, "timestamp": "00:06:26", "text": "それは彼らが言うところの「無理な力み」だ。私たちはトレーニングします"}, {"type": "subtitle", "time": 389.029, "timestamp": "00:06:29", "text": "過度に。"}, {"type": "subtitle", "time": 391.83, "timestamp": "00:06:31", "text": "これが実際に起こることです。なんてこった。"}, {"type": "subtitle", "time": 394.629, "timestamp": "00:06:34", "text": "ああ、ジョギング。世話をしなければならない"}, {"type": "subtitle", "time": 396.86, "timestamp": "00:06:36", "text": "あなた自身。いいえ。"}, {"type": "subtitle", "time": 399.35, "timestamp": "00:06:39", "text": "[音楽]"}, {"type": "subtitle", "time": 401.11, "timestamp": "00:06:41", "text": "こんにちは。"}, {"type": "subtitle", "time": 404.15, "timestamp": "00:06:44", "text": "ここはどこですか？えーと、"}, {"type": "subtitle", "time": 405.67, "timestamp": "00:06:45", "text": "サーバ。"}, {"type": "subtitle", "time": 408.469, "timestamp": "00:06:48", "text": "私は、えっと、接続を切断しました"}, {"type": "subtitle", "time": 412.79, "timestamp": "00:06:52", "text": "Minecraftサーバーは、えっと"}, {"type": "subtitle", "time": 415.749, "timestamp": "00:06:55", "text": "なぜなら私は"}, {"type": "subtitle", "time": 419.43, "timestamp": "00:06:59", "text": "つる植物に襲われて死ぬ自分の姿を見た。つる植物"}]
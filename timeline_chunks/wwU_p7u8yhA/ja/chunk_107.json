[{"type": "subtitle", "time": 6420.79, "timestamp": "01:47:00", "text": "[音楽]"}, {"type": "subtitle", "time": 6433.59, "timestamp": "01:47:13", "text": "ああ、私は今レベル2です。さあ行こう。おお、"}, {"type": "subtitle", "time": 6440.47, "timestamp": "01:47:20", "text": "素晴らしいショーでした"}, {"type": "subtitle", "time": 6446.709, "timestamp": "01:47:26", "text": "ニース。それでは、続ける前に、えーと"}, {"type": "subtitle", "time": 6458.55, "timestamp": "01:47:38", "text": "じゃあ、うん、そのままにしておくよ"}, {"type": "subtitle", "time": 6462.39, "timestamp": "01:47:42", "text": "ダッシュして音楽も流す"}, {"type": "subtitle", "time": 6464.31, "timestamp": "01:47:44", "text": "だって、音楽を再生するのを忘れてたんだもん、そうでしょ？"}, {"type": "subtitle", "time": 6467.43, "timestamp": "01:47:47", "text": "うん。うん。うん。ということで、私は"}, {"type": "subtitle", "time": 6470.229, "timestamp": "01:47:50", "text": "少し。昼食を買って戻ってくるか、"}, {"type": "subtitle", "time": 6473.91, "timestamp": "01:47:53", "text": "食事をしてから戻ってきて、スピードランに挑戦するのもいいかもしれない。"}, {"type": "subtitle", "time": 6476.97, "timestamp": "01:47:56", "text": "さあ、音楽を流そう。うん。"}]
[{"type": "subtitle", "time": 541.67, "timestamp": "00:09:01", "text": "えーと、１、２、３、４、"}, {"type": "subtitle", "time": 544.31, "timestamp": "00:09:04", "text": "4つの軸。では、誰を倒すべきでしょうか？"}, {"type": "subtitle", "time": 545.75, "timestamp": "00:09:05", "text": "今日？"}, {"type": "subtitle", "time": 550.23, "timestamp": "00:09:10", "text": "たぶん、たぶん、あなた、たぶん、あなた"}, {"type": "subtitle", "time": 569.509, "timestamp": "00:09:29", "text": "あまり時間がかかっていなければいいのですが。どのぐらいの間"}, {"type": "subtitle", "time": 571.829, "timestamp": "00:09:31", "text": "そうだったのか？"}, {"type": "subtitle", "time": 574.47, "timestamp": "00:09:34", "text": "私はどれくらいの時間だったの？"}, {"type": "subtitle", "time": 578.79, "timestamp": "00:09:38", "text": "どれくらい経ったかって？それで、83歳で戻ってきたんだ。"}, {"type": "subtitle", "time": 581.91, "timestamp": "00:09:41", "text": "覚えて。だから私は10個くらい取ったと思う"}, {"type": "subtitle", "time": 583.91, "timestamp": "00:09:43", "text": "数分くらい。ああ、今私は"}, {"type": "subtitle", "time": 587.11, "timestamp": "00:09:47", "text": "10分間待ちます。私はもっ​​と速くなる"}, {"type": "subtitle", "time": 590.31, "timestamp": "00:09:50", "text": "次回。さあ、超超"}, {"type": "subtitle", "time": 593.03, "timestamp": "00:09:53", "text": "次回はもっと速く。"}]
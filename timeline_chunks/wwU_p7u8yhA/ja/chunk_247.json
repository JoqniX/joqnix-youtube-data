[{"type": "subtitle", "time": 14820.95, "timestamp": "04:07:00", "text": "床に物が散乱している。それを得る。それを得る。"}, {"type": "subtitle", "time": 14832.87, "timestamp": "04:07:12", "text": "最悪だ。"}, {"type": "subtitle", "time": 14835.75, "timestamp": "04:07:15", "text": "私は今なら草を摘むことができる。ちくしょう。ボット"}, {"type": "subtitle", "time": 14837.349, "timestamp": "04:07:17", "text": "また。なぜこんなにたくさんのボットがいるんだろう"}, {"type": "subtitle", "time": 14841.269, "timestamp": "04:07:21", "text": "今、私のチャットで？私に好きにさせてください"}, {"type": "subtitle", "time": 14851.429, "timestamp": "04:07:31", "text": "いいえ"}, {"type": "subtitle", "time": 14855.349, "timestamp": "04:07:35", "text": "走る。それは強い"}, {"type": "subtitle", "time": 14861.75, "timestamp": "04:07:41", "text": "走れ、走れ。"}, {"type": "subtitle", "time": 14865.51, "timestamp": "04:07:45", "text": "抵抗しないでください。"}, {"type": "subtitle", "time": 14867.83, "timestamp": "04:07:47", "text": "何かに追いかけられたら、ただ走ればいい。うん、"}, {"type": "subtitle", "time": 14869.429, "timestamp": "04:07:49", "text": "抵抗しても無駄だよ。もし君たちが"}, {"type": "subtitle", "time": 14871.349, "timestamp": "04:07:51", "text": "カイトの仕方がわからないなら、彼と戦わない方がいい。"}, {"type": "subtitle", "time": 14873.59, "timestamp": "04:07:53", "text": "ああ、彼はカエルを殺そうとしているんだ。"}, {"type": "subtitle", "time": 14874.87, "timestamp": "04:07:54", "text": "それをしない人たちに任せよう"}, {"type": "subtitle", "time": 14877.11, "timestamp": "04:07:57", "text": "遅れている。"}, {"type": "subtitle", "time": 14878.71, "timestamp": "04:07:58", "text": "それをしない人たちに任せよう"}]
[{"type": "subtitle", "time": 2402.069, "timestamp": "00:40:02", "text": "それはいいです。だから、私はRedditを使いたくない"}, {"type": "subtitle", "time": 2405.03, "timestamp": "00:40:05", "text": "いいねでいっぱいのサブレディット"}, {"type": "subtitle", "time": 2408.79, "timestamp": "00:40:08", "text": "つまり、私の中には、ああ神様"}, {"type": "subtitle", "time": 2412.79, "timestamp": "00:40:12", "text": "来週からは問題なくできると思います。"}, {"type": "subtitle", "time": 2416.95, "timestamp": "00:40:16", "text": "サブレディットがあることをいつも忘れてしまう"}, {"type": "subtitle", "time": 2420.95, "timestamp": "00:40:20", "text": "私自身のため、そしてコミュニティのため。"}, {"type": "subtitle", "time": 2423.67, "timestamp": "00:40:23", "text": "皆さんのほとんどはまだそこまで達していませんが"}, {"type": "subtitle", "time": 2426.31, "timestamp": "00:40:26", "text": "それでも、ほとんどの人はRedditを使っていない"}, {"type": "subtitle", "time": 2429.99, "timestamp": "00:40:29", "text": "まあ、それでいいんだけどね。"}, {"type": "subtitle", "time": 2433.51, "timestamp": "00:40:33", "text": "それは、えっと"}, {"type": "subtitle", "time": 2438.63, "timestamp": "00:40:38", "text": "だからSnowyが私のタイムスタンプになるので"}, {"type": "subtitle", "time": 2442.069, "timestamp": "00:40:42", "text": "私は、私が作るように書き留めるのを忘れました"}, {"type": "subtitle", "time": 2444.069, "timestamp": "00:40:44", "text": "セパレーター"}, {"type": "subtitle", "time": 2449.03, "timestamp": "00:40:49", "text": "次の配信のためのものだけど、うん"}, {"type": "subtitle", "time": 2451.829, "timestamp": "00:40:51", "text": "これは私が好きになるのに役立ちます。ええ、私は"}, {"type": "subtitle", "time": 2455.91, "timestamp": "00:40:55", "text": "ええと、あなたを別の種類にします。あ、待って、"}, {"type": "subtitle", "time": 2457.829, "timestamp": "00:40:57", "text": "では、書き留めておきます。"}]
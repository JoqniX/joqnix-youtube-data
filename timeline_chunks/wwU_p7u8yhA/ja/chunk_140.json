[{"type": "subtitle", "time": 8403.99, "timestamp": "02:20:03", "text": "自分のことを混乱させているよ。"}, {"type": "subtitle", "time": 8419.349, "timestamp": "02:20:19", "text": "私が彼を殺した。私はハンマーを持った男を殺した。"}, {"type": "subtitle", "time": 8421.83, "timestamp": "02:20:21", "text": "何てことだ。"}, {"type": "subtitle", "time": 8429.19, "timestamp": "02:20:29", "text": "[音楽]"}, {"type": "subtitle", "time": 8433.91, "timestamp": "02:20:33", "text": "いいえ。"}, {"type": "subtitle", "time": 8436.469, "timestamp": "02:20:36", "text": "この男は人々をひどく叩きのめしていた"}, {"type": "subtitle", "time": 8439.83, "timestamp": "02:20:39", "text": "まるで何もないみたいだ。"}, {"type": "subtitle", "time": 8445.51, "timestamp": "02:20:45", "text": "あのね？私は実際に戦車になるつもりだ"}, {"type": "subtitle", "time": 8447.59, "timestamp": "02:20:47", "text": "次の試合"}]
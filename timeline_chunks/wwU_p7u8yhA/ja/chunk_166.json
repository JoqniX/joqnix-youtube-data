[{"type": "subtitle", "time": 9961.67, "timestamp": "02:46:01", "text": "既に12キル達成。彼が突進してくる様子を見てください。"}, {"type": "subtitle", "time": 9964.389, "timestamp": "02:46:04", "text": "それが私のやりたいことです。"}, {"type": "subtitle", "time": 9967.269, "timestamp": "02:46:07", "text": "弓を手に入れるのが待ちきれないと想像してみて"}, {"type": "subtitle", "time": 9969.99, "timestamp": "02:46:09", "text": "性格、ですよね？もし私が想像できるなら"}, {"type": "subtitle", "time": 9973.269, "timestamp": "02:46:13", "text": "私がそれをプレイしないなら、私は"}, {"type": "subtitle", "time": 9996.07, "timestamp": "02:46:36", "text": "私はそれに慣れていない。私はしません。"}]
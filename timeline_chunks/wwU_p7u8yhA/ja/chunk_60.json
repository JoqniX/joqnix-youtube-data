[{"type": "subtitle", "time": 3601.75, "timestamp": "01:00:01", "text": "それが能力３です。はい、能力"}, {"type": "subtitle", "time": 3603.75, "timestamp": "01:00:03", "text": "三つ。はい、わかりました。わかった。ありがとう。"}, {"type": "subtitle", "time": 3605.67, "timestamp": "01:00:05", "text": "理解できたと思います。はい、そちらへ行きます"}, {"type": "subtitle", "time": 3608.549, "timestamp": "01:00:08", "text": "究極のものを求めてここに。"}, {"type": "subtitle", "time": 3620.549, "timestamp": "01:00:20", "text": "このBキーに能力を持たせることができるかもしれない"}, {"type": "subtitle", "time": 3623.43, "timestamp": "01:00:23", "text": "あそこは空っぽだ。 Qを置けるかもしれない"}, {"type": "subtitle", "time": 3625.829, "timestamp": "01:00:25", "text": "念のため、あちらにも置いておきます。"}, {"type": "subtitle", "time": 3629.19, "timestamp": "01:00:29", "text": "わからない。いいんじゃない？ない"}, {"type": "subtitle", "time": 3631.589, "timestamp": "01:00:31", "text": "手榴弾とか、そういうやつだよね？その"}, {"type": "subtitle", "time": 3634.309, "timestamp": "01:00:34", "text": "に依存する"}, {"type": "subtitle", "time": 3638.309, "timestamp": "01:00:38", "text": "あなたが選ぶヒーロー。こんにちは。だから私は思う"}, {"type": "subtitle", "time": 3641.67, "timestamp": "01:00:41", "text": "終わった。"}, {"type": "subtitle", "time": 3644.95, "timestamp": "01:00:44", "text": "これで終わりだと思う。 DPIは正しいです。"}, {"type": "subtitle", "time": 3647.19, "timestamp": "01:00:47", "text": "私はこちら側には何も縛り付けませんでしたが"}, {"type": "subtitle", "time": 3649.43, "timestamp": "01:00:49", "text": "大丈夫です。わかった。私たちは元気です。私たちは"}, {"type": "subtitle", "time": 3653.03, "timestamp": "01:00:53", "text": "良い。こんにちは。今度はこれをアップロードする必要がある"}, {"type": "subtitle", "time": 3654.87, "timestamp": "01:00:54", "text": "私の"}]
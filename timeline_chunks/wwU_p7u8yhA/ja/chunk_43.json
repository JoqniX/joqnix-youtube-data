[{"type": "subtitle", "time": 2583.19, "timestamp": "00:43:03", "text": "ゲームから退出したのは、私がAFKだったからです。"}, {"type": "subtitle", "time": 2585.589, "timestamp": "00:43:05", "text": "設定関連。"}, {"type": "subtitle", "time": 2592.309, "timestamp": "00:43:12", "text": "そうですね、もし、もし、もし、"}, {"type": "subtitle", "time": 2595.27, "timestamp": "00:43:15", "text": "それは何と呼ばれますか？ようこそ、ようこそ、"}, {"type": "subtitle", "time": 2598.23, "timestamp": "00:43:18", "text": "ようこそ、ブレットソン。ようこそ、ようこそ。こんにちは。"}, {"type": "subtitle", "time": 2602.309, "timestamp": "00:43:22", "text": "さあ、ゲームを始めましょう。こんにちは。"}, {"type": "subtitle", "time": 2606.63, "timestamp": "00:43:26", "text": "はい。これがオーバーウォッチです。私は"}, {"type": "subtitle", "time": 2609.67, "timestamp": "00:43:29", "text": "ゲームに参加して、私は"}, {"type": "subtitle", "time": 2613.03, "timestamp": "00:43:33", "text": "設定を上げてください。それで、"}, {"type": "subtitle", "time": 2616.55, "timestamp": "00:43:36", "text": "えっと、期待できるのは"}, {"type": "subtitle", "time": 2619.51, "timestamp": "00:43:39", "text": "痛み。"}, {"type": "subtitle", "time": 2621.589, "timestamp": "00:43:41", "text": "ええ、少し調整しました。"}, {"type": "subtitle", "time": 2623.75, "timestamp": "00:43:43", "text": "設定とか色々あるけど、うん、そうかもね"}, {"type": "subtitle", "time": 2627.27, "timestamp": "00:43:47", "text": "赤い文字が見えるので、再起動が必要です。"}, {"type": "subtitle", "time": 2631.19, "timestamp": "00:43:51", "text": "赤い、あそこにメッセージが1つあるような"}, {"type": "subtitle", "time": 2634.39, "timestamp": "00:43:54", "text": "トップ。うん。うん。うん。グラフィック品質、"}, {"type": "subtitle", "time": 2636.55, "timestamp": "00:43:56", "text": "ウルトラ設定だったけど、"}, {"type": "subtitle", "time": 2638.63, "timestamp": "00:43:58", "text": "高い。私はそれを変更する必要があるかもしれません"}]
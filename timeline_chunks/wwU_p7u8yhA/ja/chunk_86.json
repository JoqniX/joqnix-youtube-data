[{"type": "subtitle", "time": 5168.629, "timestamp": "01:26:08", "text": "Go言語の開発者とチーズを使ったチャレンジ。"}, {"type": "subtitle", "time": 5170.55, "timestamp": "01:26:10", "text": "わかった。本日の勝利。 ３つ完成させる"}, {"type": "subtitle", "time": 5174.229, "timestamp": "01:26:14", "text": "ゲーム。どの役柄にも似合う可愛さ。わかった。"}, {"type": "subtitle", "time": 5177.75, "timestamp": "01:26:17", "text": "オープンキューで3つのゲームを完了してください。癒す"}, {"type": "subtitle", "time": 5180.07, "timestamp": "01:26:20", "text": "えっと、15,000ダメージ。完全な大混乱は"}, {"type": "subtitle", "time": 5185.03, "timestamp": "01:26:25", "text": "カウント。ああ、あれは何だ？ようこそ"}, {"type": "subtitle", "time": 5187.85, "timestamp": "01:26:27", "text": "パランサ。"}, {"type": "subtitle", "time": 5190.87, "timestamp": "01:26:30", "text": "[音楽]"}, {"type": "subtitle", "time": 5193.03, "timestamp": "01:26:33", "text": "彼女は何をするのでしょうか？私は何を見たいのか"}, {"type": "subtitle", "time": 5195.83, "timestamp": "01:26:35", "text": "彼女はそうする。ああ、それは曳光銃だ。"}, {"type": "subtitle", "time": 5204.149, "timestamp": "01:26:44", "text": "ええと、これは吸引力があります。ああ、できるよ"}, {"type": "subtitle", "time": 5206.47, "timestamp": "01:26:46", "text": "避ける。あ、待って。実際、私はプレイするかもしれない"}, {"type": "subtitle", "time": 5212.55, "timestamp": "01:26:52", "text": "H、ゲームに入りました。"}, {"type": "subtitle", "time": 5215.11, "timestamp": "01:26:55", "text": "毎週のチャレンジをこなせば、"}, {"type": "subtitle", "time": 5219.63, "timestamp": "01:26:59", "text": "2番目のBP。え、何？"}]
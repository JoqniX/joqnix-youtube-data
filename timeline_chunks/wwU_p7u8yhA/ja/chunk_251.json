[{"type": "subtitle", "time": 15060.309, "timestamp": "04:11:00", "text": "あなたのために作ります。おい、"}, {"type": "subtitle", "time": 15062.1, "timestamp": "04:11:02", "text": "なぜあなたは大丈夫なのですか？"}, {"type": "subtitle", "time": 15063.51, "timestamp": "04:11:03", "text": "[音楽]"}, {"type": "subtitle", "time": 15070.87, "timestamp": "04:11:10", "text": "これで大丈夫です。私は冬と春が嫌いです"}, {"type": "subtitle", "time": 15074.309, "timestamp": "04:11:14", "text": "まったく、ペンギンとあのミームを作るなんて。"}, {"type": "subtitle", "time": 15077.03, "timestamp": "04:11:17", "text": "うん、ゼロは02みたいにやり方を知らない"}, {"type": "subtitle", "time": 15079.75, "timestamp": "04:11:19", "text": "私のものと同じように。だから私はそれが"}, {"type": "subtitle", "time": 15081.429, "timestamp": "04:11:21", "text": "熱い。"}, {"type": "subtitle", "time": 15084.63, "timestamp": "04:11:24", "text": "暑くなってきた。ああ、これだ。さあ行こう。あまりにも"}, {"type": "subtitle", "time": 15086.55, "timestamp": "04:11:26", "text": "多くの"}, {"type": "subtitle", "time": 15089.189, "timestamp": "04:11:29", "text": "熱い。何？待って、ちょっと待って。出て行く"}, {"type": "subtitle", "time": 15090.63, "timestamp": "04:11:30", "text": "それ。そこから出ないと"}, {"type": "subtitle", "time": 15094.389, "timestamp": "04:11:34", "text": "欲しい。ええ、私は自分の花を食べればいいんです。"}, {"type": "subtitle", "time": 15096.229, "timestamp": "04:11:36", "text": "あ、ちなみにリンクのことですよ。いいえ、それは"}, {"type": "subtitle", "time": 15099.75, "timestamp": "04:11:39", "text": "コメディアートのような料理。料理"}, {"type": "subtitle", "time": 15103.83, "timestamp": "04:11:43", "text": "au 付き。それはキッチンの電源を入れるだけです。"}, {"type": "subtitle", "time": 15107.51, "timestamp": "04:11:47", "text": "料理に使えますか？"}]
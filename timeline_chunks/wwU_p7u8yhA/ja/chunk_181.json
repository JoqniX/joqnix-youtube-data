[{"type": "subtitle", "time": 10875.269, "timestamp": "03:01:15", "text": "わかった。えーっと、あれを手に入れるために"}, {"type": "subtitle", "time": 10877.91, "timestamp": "03:01:17", "text": "ああ、これは無料です。ああ、だから私は"}, {"type": "subtitle", "time": 10879.99, "timestamp": "03:01:19", "text": "もっとたくさん遊ぶ。私は遊びたくない"}, {"type": "subtitle", "time": 10883.67, "timestamp": "03:01:23", "text": "そしてこのゲームではドライな状態が続く。しかし"}, {"type": "subtitle", "time": 10891.99, "timestamp": "03:01:31", "text": "バトルパス55では、"}, {"type": "subtitle", "time": 10918.469, "timestamp": "03:01:58", "text": "「ああ、キティオだけだよ。」わかった。"}]
[{"type": "subtitle", "time": 19560.31, "timestamp": "05:26:00", "text": "見せる。ちくしょう。えっと、やあ、S。調子はどう？"}, {"type": "subtitle", "time": 19562.628, "timestamp": "05:26:02", "text": "行くの？私は寿司を食べたことがあります。わからない"}, {"type": "subtitle", "time": 19570.23, "timestamp": "05:26:10", "text": "何てことだ。ちくしょう。ちくしょう。あなた"}, {"type": "subtitle", "time": 19572.15, "timestamp": "05:26:12", "text": "何だと思う？大丈夫。大丈夫。大丈夫。あなたが知っている"}, {"type": "subtitle", "time": 19579.67, "timestamp": "05:26:19", "text": "混乱したら、ただ物を殺して"}, {"type": "subtitle", "time": 19582.788, "timestamp": "05:26:22", "text": "狩猟用品。それはあなたの幽霊です。ああのように"}, {"type": "subtitle", "time": 19584.23, "timestamp": "05:26:24", "text": "くそ、彼はネットを破壊している"}, {"type": "subtitle", "time": 19587.67, "timestamp": "05:26:27", "text": "別のものを探すべきだ。"}, {"type": "subtitle", "time": 19590.07, "timestamp": "05:26:30", "text": "私はカエルを殺す"}, {"type": "subtitle", "time": 19596.788, "timestamp": "05:26:36", "text": "よし、走り続けよう。"}, {"type": "subtitle", "time": 19600.07, "timestamp": "05:26:40", "text": "脚を掴め。"}, {"type": "subtitle", "time": 19604.868, "timestamp": "05:26:44", "text": "やあ、調子はどう？ああ、ただの釣りだよ。"}, {"type": "subtitle", "time": 19606.948, "timestamp": "05:26:46", "text": "これが私の人生です。"}, {"type": "subtitle", "time": 19608.628, "timestamp": "05:26:48", "text": "ただ質素な生活を送っているだけだ。彼らはさらに"}, {"type": "subtitle", "time": 19611.99, "timestamp": "05:26:51", "text": "餌を用意する。ああ、くそ。え、何？なんてこった。"}, {"type": "subtitle", "time": 19615.83, "timestamp": "05:26:55", "text": "どのような餌が必要ですか？"}, {"type": "subtitle", "time": 19618.47, "timestamp": "05:26:58", "text": "正式に私を選んでくれた。手に入れる必要があった"}]
[{"type": "subtitle", "time": 2520.87, "timestamp": "00:42:00", "text": "配信用のやつです。"}, {"type": "subtitle", "time": 2523.589, "timestamp": "00:42:03", "text": "うん。何のために？いいえ、主に"}, {"type": "subtitle", "time": 2525.349, "timestamp": "00:42:05", "text": "私が呼びかけるストリームの終わり"}, {"type": "subtitle", "time": 2527.91, "timestamp": "00:42:07", "text": "来てくれた全員。右。うん。うん。"}, {"type": "subtitle", "time": 2529.99, "timestamp": "00:42:09", "text": "皆さん一人ひとりに感謝したいので、"}, {"type": "subtitle", "time": 2531.75, "timestamp": "00:42:11", "text": "右？だから、ほとんどの場合、私がミスをしたら"}, {"type": "subtitle", "time": 2535.03, "timestamp": "00:42:15", "text": "誰に対しても、私はとても悲しい気持ちになるでしょう"}, {"type": "subtitle", "time": 2537.99, "timestamp": "00:42:17", "text": "いいえ、私はこれを見逃しました、私はこれを見逃しました"}, {"type": "subtitle", "time": 2541.03, "timestamp": "00:42:21", "text": "人。いいえ、私はすでに"}, {"type": "subtitle", "time": 2544.15, "timestamp": "00:42:24", "text": "ストリーム。もし過去に戻れるなら。私は持っていた"}, {"type": "subtitle", "time": 2547.03, "timestamp": "00:42:27", "text": "過去にはそういう後悔がたくさんあった。"}, {"type": "subtitle", "time": 2550.23, "timestamp": "00:42:30", "text": "誰かの名前を忘れて感謝するようなものです。"}, {"type": "subtitle", "time": 2552.87, "timestamp": "00:42:32", "text": "だから私はこう思った。「ねえ、知ってる？」"}, {"type": "subtitle", "time": 2557.109, "timestamp": "00:42:37", "text": "私も最善を尽くします。"}, {"type": "subtitle", "time": 2560.71, "timestamp": "00:42:40", "text": "いつでも手に入れられるように物を作る"}, {"type": "subtitle", "time": 2566.63, "timestamp": "00:42:46", "text": "ええと、誰が入ってきても、誰が歩いてきても"}, {"type": "subtitle", "time": 2569.27, "timestamp": "00:42:49", "text": "すべてにおいて"}, {"type": "subtitle", "time": 2571.51, "timestamp": "00:42:51", "text": "何か。こんにちは。では、始めましょう"}, {"type": "subtitle", "time": 2574.069, "timestamp": "00:42:54", "text": "また。ええと、オーバーウォッチは"}, {"type": "subtitle", "time": 2577.99, "timestamp": "00:42:57", "text": "私を蹴って。そうはなりませんでした。ああ、助かった。聖なる。私"}, {"type": "subtitle", "time": 2579.75, "timestamp": "00:42:59", "text": "オーバーウォッチが私をキックすると思った"}]
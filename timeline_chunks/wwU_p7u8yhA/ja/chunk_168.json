[{"type": "subtitle", "time": 10080.309, "timestamp": "02:48:00", "text": "[音楽]"}, {"type": "subtitle", "time": 10083.07, "timestamp": "02:48:03", "text": "彼女は彼を殺した。"}, {"type": "subtitle", "time": 10092.55, "timestamp": "02:48:12", "text": "おお。"}, {"type": "subtitle", "time": 10095.429, "timestamp": "02:48:15", "text": "手を挙げて。さあ行こう。"}, {"type": "subtitle", "time": 10097.91, "timestamp": "02:48:17", "text": "はい。ハンゾー、お前を連れて行くよ。私は許さない"}, {"type": "subtitle", "time": 10100.23, "timestamp": "02:48:20", "text": "誰でも"}, {"type": "subtitle", "time": 10111.429, "timestamp": "02:48:31", "text": "[音楽]"}, {"type": "subtitle", "time": 10116.19, "timestamp": "02:48:36", "text": "このコミュニティに参加できるかどうか試してみましょう。"}, {"type": "subtitle", "time": 10137.99, "timestamp": "02:48:57", "text": "何てことだ。"}]
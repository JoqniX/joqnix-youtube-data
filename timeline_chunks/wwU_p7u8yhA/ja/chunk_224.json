[{"type": "subtitle", "time": 13442.389, "timestamp": "03:44:02", "text": "遅れ。遅れています。"}, {"type": "subtitle", "time": 13445.59, "timestamp": "03:44:05", "text": "思い切り打て。それは何ですか？そこには"}, {"type": "subtitle", "time": 13447.59, "timestamp": "03:44:07", "text": "モンスター。ああ、神様。待って、いくつか"}, {"type": "subtitle", "time": 13453.429, "timestamp": "03:44:13", "text": "ホストのパフォーマンス。"}, {"type": "subtitle", "time": 13457.03, "timestamp": "03:44:17", "text": "ええ、健康状態がちょっと悪いんです。くそっ"}, {"type": "subtitle", "time": 13459.91, "timestamp": "03:44:19", "text": "それ。私のパソコンは性能が足りません。おお、"}, {"type": "subtitle", "time": 13462.87, "timestamp": "03:44:22", "text": "来て。ああ、ラグってる。でもさあ"}, {"type": "subtitle", "time": 13465.59, "timestamp": "03:44:25", "text": "の上。私も動作が遅いです。何？待って、なぜ"}, {"type": "subtitle", "time": 13468.55, "timestamp": "03:44:28", "text": "なぜこれをテストしたのか？ああ、私は"}, {"type": "subtitle", "time": 13470.87, "timestamp": "03:44:30", "text": "死ぬだろう。なんてこった。なぜテストを行ったのか？"}, {"type": "subtitle", "time": 13473.429, "timestamp": "03:44:33", "text": "ああ、そうだった。まあ、私たちのせいですね。ただ"}, {"type": "subtitle", "time": 13475.51, "timestamp": "03:44:35", "text": "ミュート。よし、緑色がある"}, {"type": "subtitle", "time": 13477.99, "timestamp": "03:44:37", "text": "怪物が私を殺している。人魚。何が"}, {"type": "subtitle", "time": 13481.429, "timestamp": "03:44:41", "text": "それ？よし、見てみよう。"}, {"type": "subtitle", "time": 13488.309, "timestamp": "03:44:48", "text": "大丈夫だった。ねえ、テクニカル"}, {"type": "subtitle", "time": 13489.59, "timestamp": "03:44:49", "text": "困難。"}, {"type": "subtitle", "time": 13491.91, "timestamp": "03:44:51", "text": "技術的な問題が発生しました。それは"}, {"type": "subtitle", "time": 13494.95, "timestamp": "03:44:54", "text": "技術的な問題。むしろこうだ"}]
[{"type": "subtitle", "time": 16862.39, "timestamp": "04:41:02", "text": "若者。ああ、くそ、なぜテラベックなのか"}, {"type": "subtitle", "time": 16864.15, "timestamp": "04:41:04", "text": "私の後ですか？私は正気だ。ティキは"}, {"type": "subtitle", "time": 16866.708, "timestamp": "04:41:06", "text": "非常識な。"}, {"type": "subtitle", "time": 16870.788, "timestamp": "04:41:10", "text": "待って、Can I get はどこにありますか"}, {"type": "subtitle", "time": 16873.11, "timestamp": "04:41:13", "text": "次は切り落とす番？えっと、もっと作れると思う"}, {"type": "subtitle", "time": 16876.47, "timestamp": "04:41:16", "text": "珍味。どこにいるの？私はここにいます。所有"}, {"type": "subtitle", "time": 16879.03, "timestamp": "04:41:19", "text": "の上。私はまるでまだ農業をしているような気分です。戻る"}, {"type": "subtitle", "time": 16887.11, "timestamp": "04:41:27", "text": "「ああ、これが君か」って思うだろうね。わかった。"}, {"type": "subtitle", "time": 16891.91, "timestamp": "04:41:31", "text": "わかった。はい。ここ。ここ。ここ。ここ。"}, {"type": "subtitle", "time": 16894.31, "timestamp": "04:41:34", "text": "それらは既に受精していた。料理してみよう"}, {"type": "subtitle", "time": 16895.67, "timestamp": "04:41:35", "text": "初め。必ず火を通して調理してください。なぜ"}, {"type": "subtitle", "time": 16896.948, "timestamp": "04:41:36", "text": "なぜあなたはそれらを拾ったのですか"}, {"type": "subtitle", "time": 16898.15, "timestamp": "04:41:38", "text": "豚の村？彼らはすでに"}, {"type": "subtitle", "time": 16901.59, "timestamp": "04:41:41", "text": "受精した。え、本当に？"}, {"type": "subtitle", "time": 16904.47, "timestamp": "04:41:44", "text": "ゲームをしに行こう。よし。またね。わかった、"}, {"type": "subtitle", "time": 16906.47, "timestamp": "04:41:46", "text": "良い。あ、ところで、私を治してくれるんですか？"}, {"type": "subtitle", "time": 16909.43, "timestamp": "04:41:49", "text": "ええ、そうですね。持続する。私は現在も"}, {"type": "subtitle", "time": 16912.47, "timestamp": "04:41:52", "text": "影の怪物たちと戦う。わかった、"}, {"type": "subtitle", "time": 16915.03, "timestamp": "04:41:55", "text": "基地はどこですか？それは下の方にあります。全て"}]
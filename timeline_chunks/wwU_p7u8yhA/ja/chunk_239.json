[{"type": "subtitle", "time": 14340.15, "timestamp": "03:59:00", "text": "あなたはこれを忘れていました。ああ、君はそれが好きなんだね。"}, {"type": "subtitle", "time": 14341.67, "timestamp": "03:59:01", "text": "生。なるほど。"}, {"type": "subtitle", "time": 14344.71, "timestamp": "03:59:04", "text": "いいえ、私があなたに送りました。日本語、私は"}, {"type": "subtitle", "time": 14347.91, "timestamp": "03:59:07", "text": "あなたに送りました。そうなんですか？あなたに送りました"}, {"type": "subtitle", "time": 14350.55, "timestamp": "03:59:10", "text": "3回くらい招待した。待って、私は"}, {"type": "subtitle", "time": 14353.59, "timestamp": "03:59:13", "text": "どれでも手に入れる。待って、もう一つ送ります。"}, {"type": "subtitle", "time": 14356.95, "timestamp": "03:59:16", "text": "やっと分かりました。やっと分かりました。はい。うん。"}, {"type": "subtitle", "time": 14358.389, "timestamp": "03:59:18", "text": "ハン、君も参加したい？送ります"}, {"type": "subtitle", "time": 14362.389, "timestamp": "03:59:22", "text": "詳細は後ほど。もちろん。"}, {"type": "subtitle", "time": 14365.11, "timestamp": "03:59:25", "text": "バーも開催されないだろう。"}, {"type": "subtitle", "time": 14372.55, "timestamp": "03:59:32", "text": "そうそう。私はその話をしなければならない"}, {"type": "subtitle", "time": 14374.87, "timestamp": "03:59:34", "text": "私がまだ"}, {"type": "subtitle", "time": 14377.75, "timestamp": "03:59:37", "text": "私のPCが壊れたので、"}, {"type": "subtitle", "time": 14380.55, "timestamp": "03:59:40", "text": "他の誰か。えっと"}, {"type": "subtitle", "time": 14382.15, "timestamp": "03:59:42", "text": "つまり、私は写真をアップロードしました"}, {"type": "subtitle", "time": 14384.71, "timestamp": "03:59:44", "text": "死んだミッキー・デの言う通りだ。"}, {"type": "subtitle", "time": 14387.03, "timestamp": "03:59:47", "text": "何？"}, {"type": "subtitle", "time": 14389.429, "timestamp": "03:59:49", "text": "私が子供の頃、廃墟となったミッキー・ディーズのような"}, {"type": "subtitle", "time": 14391.51, "timestamp": "03:59:51", "text": "ジョギングに出かけるようなもの。死体を発見"}, {"type": "subtitle", "time": 14393.99, "timestamp": "03:59:53", "text": "ミッキー・デは路地裏のようなところにいて、私は"}, {"type": "subtitle", "time": 14395.75, "timestamp": "03:59:55", "text": "その写真を撮って、えーっと"}, {"type": "subtitle", "time": 14399.269, "timestamp": "03:59:59", "text": "コミュニティ投稿に投稿しました。後"}]
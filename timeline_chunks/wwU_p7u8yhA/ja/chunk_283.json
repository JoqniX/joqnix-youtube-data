[{"type": "subtitle", "time": 16981.99, "timestamp": "04:43:01", "text": "ここに1つあります。私はここで調理します。"}, {"type": "subtitle", "time": 16985.43, "timestamp": "04:43:05", "text": "私の斧はどこだ？えっと、料理するのを忘れないで"}, {"type": "subtitle", "time": 16989.11, "timestamp": "04:43:09", "text": "モンスターの肉。はい、どうぞ。"}, {"type": "subtitle", "time": 16996.948, "timestamp": "04:43:16", "text": "今度は私が苦しむ番だ"}, {"type": "subtitle", "time": 17004.708, "timestamp": "04:43:24", "text": "ターンテーブルはどうやって動くのか。"}, {"type": "subtitle", "time": 17007.99, "timestamp": "04:43:27", "text": "食べ物がない。私は表を使います。"}, {"type": "subtitle", "time": 17014.708, "timestamp": "04:43:34", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 17016.39, "timestamp": "04:43:36", "text": "うん。私たちはとても良いワールドスポーンを持っていた、"}, {"type": "subtitle", "time": 17021.27, "timestamp": "04:43:41", "text": "よし、モンスターエナジーをもっと取りに行くよ"}, {"type": "subtitle", "time": 17022.23, "timestamp": "04:43:42", "text": "肉。たくさん必要になるだろう"}, {"type": "subtitle", "time": 17024.788, "timestamp": "04:43:44", "text": "モンスターミートも後で"}, {"type": "subtitle", "time": 17028.47, "timestamp": "04:43:48", "text": "もの。ああ、わかりました。わかった。わかった。はい、"}, {"type": "subtitle", "time": 17030.868, "timestamp": "04:43:50", "text": "だって、木材が必要なんだもん。"}, {"type": "subtitle", "time": 17033.51, "timestamp": "04:43:53", "text": "うん。よし。食べ物の問題を解決しに行きます"}, {"type": "subtitle", "time": 17036.55, "timestamp": "04:43:56", "text": "[ __ ]を植えることで問題を起こす。よし。"}, {"type": "subtitle", "time": 17038.868, "timestamp": "04:43:58", "text": "種を全部ください。つまり、私は"}]
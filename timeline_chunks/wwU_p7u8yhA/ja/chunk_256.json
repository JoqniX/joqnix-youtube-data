[{"type": "subtitle", "time": 15360.389, "timestamp": "04:16:00", "text": "あそこだ。"}, {"type": "subtitle", "time": 15362.309, "timestamp": "04:16:02", "text": "ええ、左側へ降りていきました。私はしません"}, {"type": "subtitle", "time": 15364.87, "timestamp": "04:16:04", "text": "君たちがどこに行ったかは知っているけど、"}, {"type": "subtitle", "time": 15366.469, "timestamp": "04:16:06", "text": "下には何もない。これで全員ですか？は"}, {"type": "subtitle", "time": 15372.95, "timestamp": "04:16:12", "text": "今すぐ。"}, {"type": "subtitle", "time": 15382.87, "timestamp": "04:16:22", "text": "電気式の銃。うん。"}, {"type": "subtitle", "time": 15384.95, "timestamp": "04:16:24", "text": "ジェイソン、実はね。"}, {"type": "subtitle", "time": 15386.95, "timestamp": "04:16:26", "text": "私たちはオアシスに住んでいました"}, {"type": "subtitle", "time": 15389.75, "timestamp": "04:16:29", "text": "傘さえ持っていなかったし、"}, {"type": "subtitle", "time": 15392.79, "timestamp": "04:16:32", "text": "レインコートに必要な材料。"}, {"type": "subtitle", "time": 15395.99, "timestamp": "04:16:35", "text": "ああ、うん、"}, {"type": "subtitle", "time": 15398.469, "timestamp": "04:16:38", "text": "ちょっと必要なんだけど、ああ、食べられない"}, {"type": "subtitle", "time": 15400.07, "timestamp": "04:16:40", "text": "すべて。"}, {"type": "subtitle", "time": 15401.83, "timestamp": "04:16:41", "text": "伸びなさい、坊や。ちなみに、ありがとう。"}, {"type": "subtitle", "time": 15404.229, "timestamp": "04:16:44", "text": "チャック、トラップを作ることができます"}, {"type": "subtitle", "time": 15405.99, "timestamp": "04:16:45", "text": "生存。罠を作って捕らえることができます"}, {"type": "subtitle", "time": 15409.51, "timestamp": "04:16:49", "text": "ウサギが何匹か。ああ、罠を仕掛けることもできるよ。"}, {"type": "subtitle", "time": 15412.309, "timestamp": "04:16:52", "text": "そうそう。ジェイソン、私たちはどこにもいなかった"}, {"type": "subtitle", "time": 15416.07, "timestamp": "04:16:56", "text": "その辺りでは、まだ"}, {"type": "subtitle", "time": 15417.91, "timestamp": "04:16:57", "text": "金庫が実際には"}]
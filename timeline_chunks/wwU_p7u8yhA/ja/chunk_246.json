[{"type": "subtitle", "time": 14760.07, "timestamp": "04:06:00", "text": "金を探している。ああ、そうそう。"}, {"type": "subtitle", "time": 14764.309, "timestamp": "04:06:04", "text": "また一人。見る？はい、できます。作る"}, {"type": "subtitle", "time": 14767.59, "timestamp": "04:06:07", "text": "金の束。"}, {"type": "subtitle", "time": 14771.03, "timestamp": "04:06:11", "text": "つるはしを作ることができます。ボートを作れますか？"}, {"type": "subtitle", "time": 14773.189, "timestamp": "04:06:13", "text": "しかし残念ながら、今のラグのせいで、私は"}, {"type": "subtitle", "time": 14775.59, "timestamp": "04:06:15", "text": "私には無理だと思う。遅延していません"}, {"type": "subtitle", "time": 14777.75, "timestamp": "04:06:17", "text": "もう。少なくとも私にとっては。ああ、私にとってはね。"}, {"type": "subtitle", "time": 14779.269, "timestamp": "04:06:19", "text": "少し遅延していますが、私にとってはそれほど大きな問題ではありません。"}, {"type": "subtitle", "time": 14780.87, "timestamp": "04:06:20", "text": "ほんの少しだけ。私にとってはそうではない"}, {"type": "subtitle", "time": 14782.95, "timestamp": "04:06:22", "text": "遅れている。ああ、どうか助けてください。それはそれはそれは"}, {"type": "subtitle", "time": 14784.15, "timestamp": "04:06:24", "text": "それほど気にならない"}, {"type": "subtitle", "time": 14786.469, "timestamp": "04:06:26", "text": "私は何も戦っていないし、"}, {"type": "subtitle", "time": 14787.67, "timestamp": "04:06:27", "text": "私はマウスで遊んでいます。まあ、それは"}, {"type": "subtitle", "time": 14789.11, "timestamp": "04:06:29", "text": "私にとっては問題になりそうです。なぜなら私は"}, {"type": "subtitle", "time": 14790.71, "timestamp": "04:06:30", "text": "何かと戦うことになるのは私だ。"}, {"type": "subtitle", "time": 14792.79, "timestamp": "04:06:32", "text": "うん。"}, {"type": "subtitle", "time": 14795.51, "timestamp": "04:06:35", "text": "待って、ラグが一番少なかったのは誰？寿司は"}, {"type": "subtitle", "time": 14799.03, "timestamp": "04:06:39", "text": "あなたのですよね？いや、違うよ。それは私のものです"}, {"type": "subtitle", "time": 14803.11, "timestamp": "04:06:43", "text": "FPSの問題です。おお。ああ、わかりました。"}, {"type": "subtitle", "time": 14805.269, "timestamp": "04:06:45", "text": "大丈夫です、"}, {"type": "subtitle", "time": 14807.83, "timestamp": "04:06:47", "text": "はい。えーと、2番目に重要なことは"}, {"type": "subtitle", "time": 14811.75, "timestamp": "04:06:51", "text": "それを作るもの？何かが見つかるよ。"}, {"type": "subtitle", "time": 14819.429, "timestamp": "04:06:59", "text": "こちらです。こちらです。ここに来て。それらの"}]
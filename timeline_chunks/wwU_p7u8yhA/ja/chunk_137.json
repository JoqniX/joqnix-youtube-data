[{"type": "subtitle", "time": 8228.15, "timestamp": "02:17:08", "text": "ハンマーは持っていますか？私はしませんでした。私"}, {"type": "subtitle", "time": 8231.349, "timestamp": "02:17:11", "text": "ハンマーを持っていると思った。"}, {"type": "subtitle", "time": 8269.03, "timestamp": "02:17:49", "text": "私は殺された。"}, {"type": "subtitle", "time": 8271.99, "timestamp": "02:17:51", "text": "コールオブデューティ関連のことをやろうと思っています。電話"}]
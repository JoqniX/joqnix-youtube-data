[{"type": "subtitle", "time": 17282.948, "timestamp": "04:48:02", "text": "体。入手できません。はい。わかった。私たちは"}, {"type": "subtitle", "time": 17284.708, "timestamp": "04:48:04", "text": "行く。行かなくちゃ。アビゲイルは掴むことができます"}, {"type": "subtitle", "time": 17287.51, "timestamp": "04:48:07", "text": "それ。ああ、大変だ。また、まだ"}, {"type": "subtitle", "time": 17288.868, "timestamp": "04:48:08", "text": "ダメージ。彼が濡れているからだと思う。"}, {"type": "subtitle", "time": 17290.788, "timestamp": "04:48:10", "text": "そして、あなたの妹は怒っていません。あなたは何を"}, {"type": "subtitle", "time": 17293.27, "timestamp": "04:48:13", "text": "平均？彼女は怒っているわけではない。あなた"}, {"type": "subtitle", "time": 17295.83, "timestamp": "04:48:15", "text": "妹は怒っている。"}, {"type": "subtitle", "time": 17298.628, "timestamp": "04:48:18", "text": "右クリックできます。右クリックできます"}, {"type": "subtitle", "time": 17300.708, "timestamp": "04:48:20", "text": "それ。怒っていると、うーん"}, {"type": "subtitle", "time": 17302.47, "timestamp": "04:48:22", "text": "それぞれ異なる目を持っている。肌"}, {"type": "subtitle", "time": 17306.07, "timestamp": "04:48:26", "text": "傘。豚の皮が必要だ。おお。ああ、私は"}, {"type": "subtitle", "time": 17308.39, "timestamp": "04:48:28", "text": "豚皮"}, {"type": "subtitle", "time": 17311.03, "timestamp": "04:48:31", "text": "それは正しいボタンではありません。ただ"}, {"type": "subtitle", "time": 17312.788, "timestamp": "04:48:32", "text": "彼女を召喚してから右クリックして"}, {"type": "subtitle", "time": 17316.55, "timestamp": "04:48:36", "text": "再び花が咲く。私はそれが好きです。"}, {"type": "subtitle", "time": 17319.19, "timestamp": "04:48:39", "text": "ああ、神様。いいえ、彼女にはダメです。私はちょうど"}, {"type": "subtitle", "time": 17322.47, "timestamp": "04:48:42", "text": "ホットバー。はい、どうぞ。今は怒っている。私"}, {"type": "subtitle", "time": 17325.27, "timestamp": "04:48:45", "text": "いくつか"}, {"type": "subtitle", "time": 17328.47, "timestamp": "04:48:48", "text": "悪者にただ近づいていくように"}, {"type": "subtitle", "time": 17330.55, "timestamp": "04:48:50", "text": "簡単に。"}, {"type": "subtitle", "time": 17331.99, "timestamp": "04:48:51", "text": "ねえ、こっちに壁を作ってくれてもいいよ。待って。"}, {"type": "subtitle", "time": 17334.23, "timestamp": "04:48:54", "text": "えっと、ズキ、こっちに来て。えーと、レミーは"}, {"type": "subtitle", "time": 17337.11, "timestamp": "04:48:57", "text": "そうすれば魂を手に入れることができる。あー、あー、私は"}]
[{"type": "subtitle", "time": 13680.87, "timestamp": "03:48:00", "text": "私たち自身。つまり、もしあなたが知らないなら"}, {"type": "subtitle", "time": 13682.55, "timestamp": "03:48:02", "text": "あなたの年齢は、つまりあなたが年を取ったということだ。"}, {"type": "subtitle", "time": 13685.03, "timestamp": "03:48:05", "text": "わかった。自分の年齢がわからない場合は、"}, {"type": "subtitle", "time": 13689.59, "timestamp": "03:48:09", "text": "古い。おい、静かにしろ。わかった。私は合格した"}, {"type": "subtitle", "time": 13690.55, "timestamp": "03:48:10", "text": "私にとって。"}, {"type": "subtitle", "time": 13693.59, "timestamp": "03:48:13", "text": "もう少し音量が大きくてもいいかもしれない。のように、"}, {"type": "subtitle", "time": 13695.59, "timestamp": "03:48:15", "text": "「私は"}, {"type": "subtitle", "time": 13700.07, "timestamp": "03:48:20", "text": "「永遠の18歳。」ああ、なんてことだ。"}, {"type": "subtitle", "time": 13703.189, "timestamp": "03:48:23", "text": "それは毎日、かろうじて合法な状態だ。"}, {"type": "subtitle", "time": 13704.79, "timestamp": "03:48:24", "text": "今はどうでしょうか？今はどうでしょうか？何"}, {"type": "subtitle", "time": 13707.189, "timestamp": "03:48:27", "text": "今頃ですか？まるで自分がまだ成人したばかりのような気分だ。"}, {"type": "subtitle", "time": 13709.83, "timestamp": "03:48:29", "text": "見れば見るほど、ああ、いや、"}, {"type": "subtitle", "time": 13713.349, "timestamp": "03:48:33", "text": "あなたはただ逆方向に年を取っているだけだ。"}, {"type": "subtitle", "time": 13716.389, "timestamp": "03:48:36", "text": "ああ、なんてことだ、これは同じ世界だ。"}, {"type": "subtitle", "time": 13718.95, "timestamp": "03:48:38", "text": "ジョー、何があったの？すべては"}, {"type": "subtitle", "time": 13720.95, "timestamp": "03:48:40", "text": "同じ単語？いろいろ調整しているところです。しないで"}, {"type": "subtitle", "time": 13722.71, "timestamp": "03:48:42", "text": "気にしないで。"}, {"type": "subtitle", "time": 13724.87, "timestamp": "03:48:44", "text": "おお"}, {"type": "subtitle", "time": 13728.07, "timestamp": "03:48:48", "text": "まあ、西側でプレイするしかないかな。"}, {"type": "subtitle", "time": 13730.469, "timestamp": "03:48:50", "text": "ゲームがうまく機能しない場合はどうすればいいですか？"}, {"type": "subtitle", "time": 13734.229, "timestamp": "03:48:54", "text": "全て？ああ、大変だ。"}, {"type": "subtitle", "time": 13736.15, "timestamp": "03:48:56", "text": "また黙れ。ちくしょう。私を招待してください。"}, {"type": "subtitle", "time": 13738.64, "timestamp": "03:48:58", "text": "私を招待してください。 うん。こんにちは。"}]
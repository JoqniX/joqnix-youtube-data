[{"type": "subtitle", "time": 721.35, "timestamp": "00:12:01", "text": "私は彼らにそう言った。でもでも"}, {"type": "subtitle", "time": 735.509, "timestamp": "00:12:15", "text": "私は才能がないけれど"}, {"type": "subtitle", "time": 738.87, "timestamp": "00:12:18", "text": "歌を歌う。私はそれに全力を尽くしたい"}, {"type": "subtitle", "time": 745.99, "timestamp": "00:12:25", "text": "でも、基本的にはベストを尽くしたいんです"}, {"type": "subtitle", "time": 748.55, "timestamp": "00:12:28", "text": "音楽制作を実際にプロデュースする"}, {"type": "subtitle", "time": 751.91, "timestamp": "00:12:31", "text": "音楽が主な目的です。"}, {"type": "subtitle", "time": 753.509, "timestamp": "00:12:33", "text": "のために"}, {"type": "subtitle", "time": 757.829, "timestamp": "00:12:37", "text": "はい、こんにちはロバンダル、ようこそ"}, {"type": "subtitle", "time": 760.23, "timestamp": "00:12:40", "text": "元気ですか？"}, {"type": "subtitle", "time": 764.15, "timestamp": "00:12:44", "text": "お元気ですか？"}, {"type": "subtitle", "time": 766.15, "timestamp": "00:12:46", "text": "また、ここは初めてですね。こんにちは。"}, {"type": "subtitle", "time": 769.11, "timestamp": "00:12:49", "text": "いらっしゃいませ。いらっしゃいませ。"}, {"type": "subtitle", "time": 770.629, "timestamp": "00:12:50", "text": "今日はどうやって私を見つけたの？そして、"}, {"type": "subtitle", "time": 773.99, "timestamp": "00:12:53", "text": "あなた？そして待って、そのユーザー名は"}, {"type": "subtitle", "time": 775.59, "timestamp": "00:12:55", "text": "おなじみ。"}, {"type": "subtitle", "time": 779.269, "timestamp": "00:12:59", "text": "待って、これってロブじゃない？そして待って、"}]
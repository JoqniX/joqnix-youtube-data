[{"type": "subtitle", "time": 12002.15, "timestamp": "03:20:02", "text": "私がやっている間、そして、えっと"}, {"type": "subtitle", "time": 12004.389, "timestamp": "03:20:04", "text": "私が初めてレコーディングしたのは、えっと"}, {"type": "subtitle", "time": 12007.19, "timestamp": "03:20:07", "text": "仮想的なものの録音を行う"}, {"type": "subtitle", "time": 12010.79, "timestamp": "03:20:10", "text": "えっと、なんて言うんだっけ、"}, {"type": "subtitle", "time": 12015.429, "timestamp": "03:20:15", "text": "Vbitsで、30回くらい再受験するのは大変だった"}, {"type": "subtitle", "time": 12018.15, "timestamp": "03:20:18", "text": "何回かとか、私が間違いを犯すから"}, {"type": "subtitle", "time": 12021.51, "timestamp": "03:20:21", "text": "そして言葉につまずくが、ライブでは"}, {"type": "subtitle", "time": 12025.83, "timestamp": "03:20:25", "text": "ストリーム右私は作らない私は私はオン"}, {"type": "subtitle", "time": 12029.269, "timestamp": "03:20:29", "text": "ストリームは何かをすると確信しているが、"}, {"type": "subtitle", "time": 12031.99, "timestamp": "03:20:31", "text": "本当にあなたのビデオなら、"}, {"type": "subtitle", "time": 12035.67, "timestamp": "03:20:35", "text": "なぜか私はこんなに内気になってしまう"}, {"type": "subtitle", "time": 12038.95, "timestamp": "03:20:38", "text": "恥ずかしがり屋なので、そうしてこれを避けるようにすれば、"}, {"type": "subtitle", "time": 12042.229, "timestamp": "03:20:42", "text": "ゆっくりとゆっくりと始める"}, {"type": "subtitle", "time": 12044.389, "timestamp": "03:20:44", "text": "ビデオを作ったり、その他いろいろして、"}, {"type": "subtitle", "time": 12048.229, "timestamp": "03:20:48", "text": "えっと、慣れるには、"}, {"type": "subtitle", "time": 12050.309, "timestamp": "03:20:50", "text": "動画を作ったり編集したりするのが好きです"}, {"type": "subtitle", "time": 12052.389, "timestamp": "03:20:52", "text": "プロセスも全て含めて。だから、私は"}, {"type": "subtitle", "time": 12056.389, "timestamp": "03:20:56", "text": "えっと、短いイントロをやって、"}]
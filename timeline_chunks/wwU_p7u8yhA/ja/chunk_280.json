[{"type": "subtitle", "time": 16801.19, "timestamp": "04:40:01", "text": "誰かまだ火打ち石持ってる人いますか？ああ、神様。"}, {"type": "subtitle", "time": 16804.31, "timestamp": "04:40:04", "text": "ああ、そうだね。 29点取った。戻ってきます。"}, {"type": "subtitle", "time": 16805.75, "timestamp": "04:40:05", "text": "えっと、胸に落としたの？"}, {"type": "subtitle", "time": 16807.51, "timestamp": "04:40:07", "text": "どこかで、またはいいえ。ああ、いいえ。今行ってる"}, {"type": "subtitle", "time": 16813.27, "timestamp": "04:40:13", "text": "戻る。とんでもない。ああ、大変だ。えっと、２つ必要です。"}, {"type": "subtitle", "time": 16817.91, "timestamp": "04:40:17", "text": "ああ、ロッキーのチンポ。さあ行こう。岩のようなペニス。"}, {"type": "subtitle", "time": 16821.03, "timestamp": "04:40:21", "text": "火打ち石をくれ。アラウ・ゲーミング。"}, {"type": "subtitle", "time": 16822.628, "timestamp": "04:40:22", "text": "行く。"}, {"type": "subtitle", "time": 16826.788, "timestamp": "04:40:26", "text": "ああ、あれは幽霊だ。あれは幽霊だ。"}, {"type": "subtitle", "time": 16831.19, "timestamp": "04:40:31", "text": "私の正気度はゼロだ。ああ、くそ。"}, {"type": "subtitle", "time": 16834.07, "timestamp": "04:40:34", "text": "なぜこの話を早く持ち出したのですか？走る。"}, {"type": "subtitle", "time": 16838.868, "timestamp": "04:40:38", "text": "些細な問題です。何？"}, {"type": "subtitle", "time": 16841.27, "timestamp": "04:40:41", "text": "えっと、ここです。ここ。手に入れよう、これを手に入れよう"}, {"type": "subtitle", "time": 16843.99, "timestamp": "04:40:43", "text": "ここに花を咲かせましょう。この花を手に入れてください。そうではありません"}, {"type": "subtitle", "time": 16845.91, "timestamp": "04:40:45", "text": "それほど難しいことだった。まず最初におびき出しましょう"}, {"type": "subtitle", "time": 16848.868, "timestamp": "04:40:48", "text": "攻撃して、それから攻撃する。"}, {"type": "subtitle", "time": 16852.47, "timestamp": "04:40:52", "text": "ああ、神様、なぜ恐怖の嘴が私を追いかけてくるんだ？"}, {"type": "subtitle", "time": 16854.07, "timestamp": "04:40:54", "text": "私は正気だ。なぜ恐怖のくちばしなのか"}, {"type": "subtitle", "time": 16859.51, "timestamp": "04:40:59", "text": "私の後ですか？いいえ、ズキ。いいえ、ズーク。"}]
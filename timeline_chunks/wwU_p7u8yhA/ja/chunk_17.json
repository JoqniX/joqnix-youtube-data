[{"type": "subtitle", "time": 1027.189, "timestamp": "00:17:07", "text": "私たちはあなたに時間を取り戻します。それは"}, {"type": "subtitle", "time": 1029.669, "timestamp": "00:17:09", "text": "良いオファーですね。"}, {"type": "subtitle", "time": 1031.99, "timestamp": "00:17:11", "text": "ピンク。"}, {"type": "subtitle", "time": 1036.15, "timestamp": "00:17:16", "text": "何てことだ。 １、２、３、４。"}, {"type": "subtitle", "time": 1038.87, "timestamp": "00:17:18", "text": "なんてこった。それは、それは、それは、それは違います"}, {"type": "subtitle", "time": 1040.47, "timestamp": "00:17:20", "text": "良い。"}, {"type": "subtitle", "time": 1042.63, "timestamp": "00:17:22", "text": "これは良くない。"}, {"type": "subtitle", "time": 1046.789, "timestamp": "00:17:26", "text": "これは実際には良くない。なんてこった。なんてこった。"}, {"type": "subtitle", "time": 1048.87, "timestamp": "00:17:28", "text": "これは良くない。これは良くない。おお"}, {"type": "subtitle", "time": 1051.83, "timestamp": "00:17:31", "text": "いいえ。いやだ。いやだ。いやだ。いやだ。死にたくない。"}, {"type": "subtitle", "time": 1054.39, "timestamp": "00:17:34", "text": "木材がたくさんあるのを見てください。"}, {"type": "subtitle", "time": 1061.99, "timestamp": "00:17:41", "text": "私の夢の桜の葉。"}, {"type": "subtitle", "time": 1063.99, "timestamp": "00:17:43", "text": "桜"}, {"type": "subtitle", "time": 1066.23, "timestamp": "00:17:46", "text": "島"}]
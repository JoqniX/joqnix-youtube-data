[{"type": "subtitle", "time": 18186.55, "timestamp": "05:03:06", "text": "ギアはどこにある？ああ、ここにギアがある。"}, {"type": "subtitle", "time": 18189.11, "timestamp": "05:03:09", "text": "わかった。ああ、胸。"}, {"type": "subtitle", "time": 18191.11, "timestamp": "05:03:11", "text": "よし。"}, {"type": "subtitle", "time": 18194.15, "timestamp": "05:03:14", "text": "宝箱はどのように選択すればいいですか？何てことだ、"}, {"type": "subtitle", "time": 18196.31, "timestamp": "05:03:16", "text": "それはかなりのパス数ですね。平準化する。通り過ぎる"}, {"type": "subtitle", "time": 18198.39, "timestamp": "05:03:18", "text": "妹のそばを通り過ぎてください。姉さん、姉さん。あなたの"}, {"type": "subtitle", "time": 18200.708, "timestamp": "05:03:20", "text": "妹。"}, {"type": "subtitle", "time": 18203.35, "timestamp": "05:03:23", "text": "彼女を落ち着かせて。"}, {"type": "subtitle", "time": 18210.47, "timestamp": "05:03:30", "text": "[音楽]"}, {"type": "subtitle", "time": 18212.628, "timestamp": "05:03:32", "text": "ああ、少し分けてあげるよ。あなたは"}, {"type": "subtitle", "time": 18215.99, "timestamp": "05:03:35", "text": "あの忌々しい卵め。ありがとう。来て。"}, {"type": "subtitle", "time": 18217.43, "timestamp": "05:03:37", "text": "よくやった。ご協力ありがとうございました。しかし"}, {"type": "subtitle", "time": 18220.39, "timestamp": "05:03:40", "text": "くそっ、危なかった。"}, {"type": "subtitle", "time": 18222.42, "timestamp": "05:03:42", "text": "金の塊。"}, {"type": "subtitle", "time": 18224.39, "timestamp": "05:03:44", "text": "[音楽]"}, {"type": "subtitle", "time": 18226.788, "timestamp": "05:03:46", "text": "クモ族。わかりました、これを入れます"}, {"type": "subtitle", "time": 18230.15, "timestamp": "05:03:50", "text": "箱。さあ、また[ __ ]を栽培し始めよう。"}, {"type": "subtitle", "time": 18233.19, "timestamp": "05:03:53", "text": "えっと、どうすればいいですか？どこに置けばいいですか"}, {"type": "subtitle", "time": 18237.27, "timestamp": "05:03:57", "text": "食べ物？私はここの倉庫に入りました。で"}]
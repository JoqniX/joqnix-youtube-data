[{"type": "subtitle", "time": 16020.229, "timestamp": "04:27:00", "text": "よし、これでいい。右下の方にあります。"}, {"type": "subtitle", "time": 16023.11, "timestamp": "04:27:03", "text": "来て。誰も死なないようにしてください。私はしません"}, {"type": "subtitle", "time": 16025.59, "timestamp": "04:27:05", "text": "私が彼らを見ていることを理解してください。鍵が見えた。全て"}, {"type": "subtitle", "time": 16027.269, "timestamp": "04:27:07", "text": "右。"}, {"type": "subtitle", "time": 16034.95, "timestamp": "04:27:14", "text": "うん。これが広がることは"}, {"type": "subtitle", "time": 16038.149, "timestamp": "04:27:18", "text": "まったく、豚の村だろ？そうそう。どうやって"}, {"type": "subtitle", "time": 16041.269, "timestamp": "04:27:21", "text": "外に出すべきでしょうか？どうやって消せばいいですか？"}, {"type": "subtitle", "time": 16042.469, "timestamp": "04:27:22", "text": "どうでも。大丈夫です。どうでも。その"}, {"type": "subtitle", "time": 16043.51, "timestamp": "04:27:23", "text": "大丈夫。そうではありません。そうではありません。それ"}, {"type": "subtitle", "time": 16045.11, "timestamp": "04:27:25", "text": "そうではない。大丈夫ですよ。大丈夫ですよ。それ"}, {"type": "subtitle", "time": 16047.59, "timestamp": "04:27:27", "text": "放火は制御されていない。制御された"}, {"type": "subtitle", "time": 16049.349, "timestamp": "04:27:29", "text": "放火。放火を抑制する。うん。コントロール"}, {"type": "subtitle", "time": 16052.79, "timestamp": "04:27:32", "text": "放火。放火事件は収束した。私は"}, {"type": "subtitle", "time": 16054.87, "timestamp": "04:27:34", "text": "ちなみに、木材です。ここ。置きます"}, {"type": "subtitle", "time": 16056.63, "timestamp": "04:27:36", "text": "ここで、私は作り始めるつもりです"}, {"type": "subtitle", "time": 16059.269, "timestamp": "04:27:39", "text": "基本的なもののようなもの。うん。君たちは、"}, {"type": "subtitle", "time": 16061.91, "timestamp": "04:27:41", "text": "誰かフリンを連れてきてくれないか？"}, {"type": "subtitle", "time": 16063.51, "timestamp": "04:27:43", "text": "うん。科学実験装置を作ることはできますか？"}, {"type": "subtitle", "time": 16065.51, "timestamp": "04:27:45", "text": "こちらですか？うん。うん。うん。ここ。私は手に入れた"}, {"type": "subtitle", "time": 16067.429, "timestamp": "04:27:47", "text": "火打ち石がいくつか。えっと、具体的にどこですか？あなたは欲しい"}, {"type": "subtitle", "time": 16072.95, "timestamp": "04:27:52", "text": "ここまで来るのに？わかった。わかった。"}, {"type": "subtitle", "time": 16075.75, "timestamp": "04:27:55", "text": "分割方法がわかりません。1つ必要です"}, {"type": "subtitle", "time": 16077.429, "timestamp": "04:27:57", "text": "木材。誰か木材を1本くれませんか？"}, {"type": "subtitle", "time": 16079.269, "timestamp": "04:27:59", "text": "はい、どうぞ。"}]
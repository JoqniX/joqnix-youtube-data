[{"type": "subtitle", "time": 781.829, "timestamp": "00:13:01", "text": "待って、待って。これは"}, {"type": "subtitle", "time": 783.91, "timestamp": "00:13:03", "text": "待って、待って、待って、待って。あなたは"}, {"type": "subtitle", "time": 786.629, "timestamp": "00:13:06", "text": "このサーバーで？あなたは私に"}, {"type": "subtitle", "time": 788.79, "timestamp": "00:13:08", "text": "斧とシャベルとか色々くれた。"}, {"type": "subtitle", "time": 792.389, "timestamp": "00:13:12", "text": "うん。うん。うん。それってあなたですよね？"}, {"type": "subtitle", "time": 794.47, "timestamp": "00:13:14", "text": "そう、君だよ。ああ、君だよ。はい。"}, {"type": "subtitle", "time": 796.949, "timestamp": "00:13:16", "text": "はい。はい。元気ですか？"}, {"type": "subtitle", "time": 800.71, "timestamp": "00:13:20", "text": "あなたは、えっと、もっと早く起きたんですよね？願わくば"}, {"type": "subtitle", "time": 803.67, "timestamp": "00:13:23", "text": "今日は楽しかった。では、何人かに電話をかけましょう"}, {"type": "subtitle", "time": 806.47, "timestamp": "00:13:26", "text": "もっと。"}, {"type": "subtitle", "time": 814.15, "timestamp": "00:13:34", "text": "はい、私は"}, {"type": "subtitle", "time": 817.03, "timestamp": "00:13:37", "text": "私はまだ制作中です"}, {"type": "subtitle", "time": 821.19, "timestamp": "00:13:41", "text": "ここは桜の木が生えるバイオームです。"}, {"type": "subtitle", "time": 823.829, "timestamp": "00:13:43", "text": "手動で桜の木バイオームを作成します。自然なものはなく、"}, {"type": "subtitle", "time": 828.23, "timestamp": "00:13:48", "text": "でも、もちろん手に入れますよ。良いことをしている。うん。"}, {"type": "subtitle", "time": 831.48, "timestamp": "00:13:51", "text": "こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 833.75, "timestamp": "00:13:53", "text": "[音楽]"}, {"type": "subtitle", "time": 837.03, "timestamp": "00:13:57", "text": "配信を楽しんでいただけているといいですね。はい。"}]
[{"type": "subtitle", "time": 423.27, "timestamp": "00:07:03", "text": "ゾンビ。だから私はこう思った、"}, {"type": "subtitle", "time": 425.909, "timestamp": "00:07:05", "text": "そんなことは起こらないだろう。私は"}, {"type": "subtitle", "time": 427.99, "timestamp": "00:07:07", "text": "少し距離を置きたい。私は自分の"}, {"type": "subtitle", "time": 434.71, "timestamp": "00:07:14", "text": "これは何ですか？これは何ですか？何が"}, {"type": "subtitle", "time": 444.15, "timestamp": "00:07:24", "text": "ということで、これまでに植えたのは"}, {"type": "subtitle", "time": 447.909, "timestamp": "00:07:27", "text": "これくらいの木。桜の木。今私たちは"}, {"type": "subtitle", "time": 452.30899999999997, "timestamp": "00:07:32", "text": "バイオーム全体に植物を植える必要がある。ああ、残念。"}, {"type": "subtitle", "time": 455.029, "timestamp": "00:07:35", "text": "全力を尽くしましょう。"}, {"type": "subtitle", "time": 458.39, "timestamp": "00:07:38", "text": "ああ、他にも人がいる。"}, {"type": "subtitle", "time": 460.95, "timestamp": "00:07:40", "text": "うん。ハァ。"}, {"type": "subtitle", "time": 463.189, "timestamp": "00:07:43", "text": "現在営業しているのはどこですか？ああ、なるほど、分かった気がする"}, {"type": "subtitle", "time": 468.22, "timestamp": "00:07:48", "text": "いいえ、それからその"}]
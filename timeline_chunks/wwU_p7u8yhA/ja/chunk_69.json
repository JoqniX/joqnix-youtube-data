[{"type": "subtitle", "time": 4143.99, "timestamp": "01:09:03", "text": "待って、"}, {"type": "subtitle", "time": 4151.189, "timestamp": "01:09:11", "text": "だから、"}, {"type": "subtitle", "time": 4159.03, "timestamp": "01:09:19", "text": "おお。"}, {"type": "subtitle", "time": 4170.55, "timestamp": "01:09:30", "text": "神。私は衝撃的だった。"}, {"type": "subtitle", "time": 4173.91, "timestamp": "01:09:33", "text": "待って。これは本当に素晴らしい。あ、待って。"}, {"type": "subtitle", "time": 4176.55, "timestamp": "01:09:36", "text": "これが私が勝った相手です。矢印。の"}, {"type": "subtitle", "time": 4179.24, "timestamp": "01:09:39", "text": "ボールギャング。"}, {"type": "subtitle", "time": 4182.149, "timestamp": "01:09:42", "text": "[音楽]"}, {"type": "subtitle", "time": 4191.43, "timestamp": "01:09:51", "text": "これは何ですか？ヘルプ。わかった。"}, {"type": "subtitle", "time": 4195.99, "timestamp": "01:09:55", "text": "ああ、ハニー。素晴らしい試合だった。"}, {"type": "subtitle", "time": 4198.44, "timestamp": "01:09:58", "text": "私はできなかった"}]
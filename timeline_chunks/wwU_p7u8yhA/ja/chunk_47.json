[{"type": "subtitle", "time": 2821.99, "timestamp": "00:47:01", "text": "[音楽]"}, {"type": "subtitle", "time": 2833.51, "timestamp": "00:47:13", "text": "チュートリアルを再生する。"}, {"type": "subtitle", "time": 2835.67, "timestamp": "00:47:15", "text": "ああ、すごくワクワクする。初めてです"}, {"type": "subtitle", "time": 2839.43, "timestamp": "00:47:19", "text": "時間。オーバーウォッチをプレイするのはこれが初めてです。"}, {"type": "subtitle", "time": 2841.67, "timestamp": "00:47:21", "text": "さあ行こう。"}, {"type": "subtitle", "time": 2845.27, "timestamp": "00:47:25", "text": "ああ、いや、いや、いや、いや、いや。場面が違う。"}, {"type": "subtitle", "time": 2866.23, "timestamp": "00:47:46", "text": "彼女はどこにいるの？ Traa、君をまるで"}, {"type": "subtitle", "time": 2869.829, "timestamp": "00:47:49", "text": "漫画とか、そういうの全部好き。おお、"}]
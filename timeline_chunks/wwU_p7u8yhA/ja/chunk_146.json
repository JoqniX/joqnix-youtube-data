[{"type": "subtitle", "time": 8783.11, "timestamp": "02:26:23", "text": "ほら、右クリックが効かないんだ。見る、"}, {"type": "subtitle", "time": 8786.87, "timestamp": "02:26:26", "text": "彼女は右クリックを続けている。何てことだ。"}, {"type": "subtitle", "time": 8789.67, "timestamp": "02:26:29", "text": "ネズミ、"}, {"type": "subtitle", "time": 8804.53, "timestamp": "02:26:44", "text": "地獄。"}]
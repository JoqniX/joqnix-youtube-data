[{"type": "subtitle", "time": 15660.79, "timestamp": "04:21:00", "text": "岩石を見つける。正直に言うと、私は"}, {"type": "subtitle", "time": 15663.03, "timestamp": "04:21:03", "text": "ポータルのすぐ近くにあるような感じだ。もし"}, {"type": "subtitle", "time": 15664.469, "timestamp": "04:21:04", "text": "ポータルに戻ると、"}, {"type": "subtitle", "time": 15667.429, "timestamp": "04:21:07", "text": "右側に岩がいくつかある。また、"}, {"type": "subtitle", "time": 15672.87, "timestamp": "04:21:12", "text": "生きているものすべてを好きになりたいという私のほとんど必要な欲求"}, {"type": "subtitle", "time": 15674.87, "timestamp": "04:21:14", "text": "ログ。ああ、カエルが殺している"}, {"type": "subtitle", "time": 15678.79, "timestamp": "04:21:18", "text": "クモ。ああ、くそ、私たちはただ"}, {"type": "subtitle", "time": 15680.469, "timestamp": "04:21:20", "text": "ああ、俺はただクソカエルを放っておくだけさ"}, {"type": "subtitle", "time": 15682.469, "timestamp": "04:21:22", "text": "クモを殺せ。"}, {"type": "subtitle", "time": 15689.269, "timestamp": "04:21:29", "text": "よし、右側にもっと金がある。であるべき"}, {"type": "subtitle", "time": 15691.67, "timestamp": "04:21:31", "text": "良い。彼らはまだ腺を一つも落としていない。"}, {"type": "subtitle", "time": 15694.07, "timestamp": "04:21:34", "text": "しかし、肉類の販売は中止した。私は行きます"}, {"type": "subtitle", "time": 15695.91, "timestamp": "04:21:35", "text": "豚と蜘蛛を戦わせるため。"}, {"type": "subtitle", "time": 15699.11, "timestamp": "04:21:39", "text": "まさにあなたが想像した通りです。やあ、GL。手に入れた"}, {"type": "subtitle", "time": 15701.11, "timestamp": "04:21:41", "text": "腺。私は、"}, {"type": "subtitle", "time": 15703.91, "timestamp": "04:21:43", "text": "カエルが代わりに彼を殺すのは、"}, {"type": "subtitle", "time": 15706.71, "timestamp": "04:21:46", "text": "はるかに簡単だ。ゲームでは、"}, {"type": "subtitle", "time": 15708.63, "timestamp": "04:21:48", "text": "に"}, {"type": "subtitle", "time": 15710.389, "timestamp": "04:21:50", "text": "キャンプ。なぜ君たちはこれを持っているのか"}, {"type": "subtitle", "time": 15712.229, "timestamp": "04:21:52", "text": "キャンプファイヤー？ええ、私たちはこれを持っていません"}, {"type": "subtitle", "time": 15714.71, "timestamp": "04:21:54", "text": "キャンプファイヤーでの蘇生。"}, {"type": "subtitle", "time": 15716.229, "timestamp": "04:21:56", "text": "うん、"}, {"type": "subtitle", "time": 15717.189, "timestamp": "04:21:57", "text": "おそらく、私が"}, {"type": "subtitle", "time": 15718.71, "timestamp": "04:21:58", "text": "死は決して終わりではないことを覚えておいてください。それは"}]
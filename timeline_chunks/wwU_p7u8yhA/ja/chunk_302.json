[{"type": "subtitle", "time": 18120.948, "timestamp": "05:02:00", "text": "幽霊が戻ってきたらお知らせします。"}, {"type": "subtitle", "time": 18123.51, "timestamp": "05:02:03", "text": "彼女は死んだ。"}, {"type": "subtitle", "time": 18126.15, "timestamp": "05:02:06", "text": "こっそり通り過ぎます"}, {"type": "subtitle", "time": 18128.868, "timestamp": "05:02:08", "text": "妹が亡くなった。"}, {"type": "subtitle", "time": 18132.39, "timestamp": "05:02:12", "text": "おお。おお。いや、ありえない。シャーロック、何"}, {"type": "subtitle", "time": 18134.47, "timestamp": "05:02:14", "text": "そのアイデアはあなたが考えたのですか？"}, {"type": "subtitle", "time": 18140.948, "timestamp": "05:02:20", "text": "えっ、私の場所で農業してるの？"}, {"type": "subtitle", "time": 18144.15, "timestamp": "05:02:24", "text": "いいえ、私はただ苗木を取っているだけです"}, {"type": "subtitle", "time": 18146.47, "timestamp": "05:02:26", "text": "そしてベリーの茂み。調子はどう？あなたは欲しい"}, {"type": "subtitle", "time": 18149.67, "timestamp": "05:02:29", "text": "俺のために何か殺してくれないか？"}, {"type": "subtitle", "time": 18150.868, "timestamp": "05:02:30", "text": "よし。よし。殺しに行こう"}, {"type": "subtitle", "time": 18153.27, "timestamp": "05:02:33", "text": "いくつかの。さあ行こう。"}, {"type": "subtitle", "time": 18155.91, "timestamp": "05:02:35", "text": "深刻な。行く。弱い女もいる"}, {"type": "subtitle", "time": 18157.51, "timestamp": "05:02:37", "text": "こっちに来て、君が欲しいんだ。私はちょっと"}, {"type": "subtitle", "time": 18161.19, "timestamp": "05:02:41", "text": "石が欲しい。入手方法がわかりません"}, {"type": "subtitle", "time": 18163.67, "timestamp": "05:02:43", "text": "騎手。持続する。わかった。はい。する必要がある"}, {"type": "subtitle", "time": 18165.67, "timestamp": "05:02:45", "text": "斧を作る。"}, {"type": "subtitle", "time": 18167.43, "timestamp": "05:02:47", "text": "つるはし。その胸を見てもいいですよ。"}, {"type": "subtitle", "time": 18169.99, "timestamp": "05:02:49", "text": "そこにいくつか物があるみたいだ。ありますか"}, {"type": "subtitle", "time": 18171.67, "timestamp": "05:02:51", "text": "何かのアイテム？"}, {"type": "subtitle", "time": 18173.59, "timestamp": "05:02:53", "text": "スズクのスティック。ちょっと待って。待ってください"}, {"type": "subtitle", "time": 18175.75, "timestamp": "05:02:55", "text": "妹が物を殺す。私は"}, {"type": "subtitle", "time": 18178.868, "timestamp": "05:02:58", "text": "私が持っているギアをつかんでください"}]
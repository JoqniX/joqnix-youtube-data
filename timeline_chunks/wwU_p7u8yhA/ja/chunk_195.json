[{"type": "subtitle", "time": 11700.55, "timestamp": "03:15:00", "text": "皆さんが気をつけて"}, {"type": "subtitle", "time": 11702.309, "timestamp": "03:15:02", "text": "あなた方自身。何てことだ。何が起こっていますか"}, {"type": "subtitle", "time": 11705.269, "timestamp": "03:15:05", "text": "追跡のためですか？"}, {"type": "subtitle", "time": 11708.87, "timestamp": "03:15:08", "text": "ああ、ああ、なんてことだ、視線追跡。おお、"}, {"type": "subtitle", "time": 11711.91, "timestamp": "03:15:11", "text": "私が眼鏡をかけているからでしょうか？同じ"}, {"type": "subtitle", "time": 11717.269, "timestamp": "03:15:17", "text": "犬がかけるメガネは、私が死ぬからである。"}, {"type": "subtitle", "time": 11719.53, "timestamp": "03:15:19", "text": "何てことだ。だから、私が運転しているんです。"}, {"type": "subtitle", "time": 11731.03, "timestamp": "03:15:31", "text": "それでは、また明日。"}, {"type": "subtitle", "time": 11733.51, "timestamp": "03:15:33", "text": "ああ、次のやつと明日も"}, {"type": "subtitle", "time": 11735.91, "timestamp": "03:15:35", "text": "土曜日、つまり来週のことです"}, {"type": "subtitle", "time": 11739.67, "timestamp": "03:15:39", "text": "スケジュールリリース日、そうですね、私は"}, {"type": "subtitle", "time": 11741.91, "timestamp": "03:15:41", "text": "明日までにスケジュールを準備します"}, {"type": "subtitle", "time": 11744.63, "timestamp": "03:15:44", "text": "明日アップロードします"}, {"type": "subtitle", "time": 11749.11, "timestamp": "03:15:49", "text": "Discordで利用可能、Googleで金メッキ"}, {"type": "subtitle", "time": 11752.55, "timestamp": "03:15:52", "text": "カレンダーとTwitterをチェックしているなら"}, {"type": "subtitle", "time": 11755.51, "timestamp": "03:15:55", "text": "Redditのサブレディットへ"}, {"type": "subtitle", "time": 11757.83, "timestamp": "03:15:57", "text": "Redditにはサブレディットがあります"}]
[{"type": "subtitle", "time": 5770.47, "timestamp": "01:36:10", "text": "いいえ。"}, {"type": "subtitle", "time": 5772.71, "timestamp": "01:36:12", "text": "OB。"}, {"type": "subtitle", "time": 5774.79, "timestamp": "01:36:14", "text": "[音楽]"}, {"type": "subtitle", "time": 5784.18, "timestamp": "01:36:24", "text": "いいえ。モリア。"}, {"type": "subtitle", "time": 5793.03, "timestamp": "01:36:33", "text": "くそ、このゴールを見てみろよ。のように"}, {"type": "subtitle", "time": 5796.07, "timestamp": "01:36:36", "text": "ディーバ、行くぞ。これは一体何ですか？こんな感じ"}, {"type": "subtitle", "time": 5799.99, "timestamp": "01:36:39", "text": "ガンダムの瞬間。何？"}, {"type": "subtitle", "time": 5808.39, "timestamp": "01:36:48", "text": "すごくかっこいい。ああ、私は悪が大好きだ。何てことだ。"}, {"type": "subtitle", "time": 5811.189, "timestamp": "01:36:51", "text": "さあ行こう。"}, {"type": "subtitle", "time": 5814.95, "timestamp": "01:36:54", "text": "こんにちは。慣れてきた。私はゆっくりと"}, {"type": "subtitle", "time": 5816.79, "timestamp": "01:36:56", "text": "ゲームでそこに到達する"}, {"type": "subtitle", "time": 5818.79, "timestamp": "01:36:58", "text": "それを理解する。わかった。毎週"}]
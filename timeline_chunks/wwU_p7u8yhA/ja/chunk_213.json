[{"type": "subtitle", "time": 12782.07, "timestamp": "03:33:02", "text": "ひどい。はい、そうです。ひどい話だ。"}, {"type": "subtitle", "time": 12783.429, "timestamp": "03:33:03", "text": "これはあなたが犯す最大の過ちの一つです"}, {"type": "subtitle", "time": 12785.349, "timestamp": "03:33:05", "text": "あなたの人生の中で作られたもの。ただ一緒に過ごしているだけ"}, {"type": "subtitle", "time": 12787.99, "timestamp": "03:33:07", "text": "私たち。さよなら。さて、あなたが犯した最大の過ちは"}, {"type": "subtitle", "time": 12790.309, "timestamp": "03:33:10", "text": "これまで作られたものの中で、インターネットに公開されるものだった。"}, {"type": "subtitle", "time": 12793.75, "timestamp": "03:33:13", "text": "うん。インターネットは間違いだ。"}, {"type": "subtitle", "time": 12798.389, "timestamp": "03:33:18", "text": "間違いです。うん。さよなら。間違いです。"}, {"type": "subtitle", "time": 12801.51, "timestamp": "03:33:21", "text": "よし。準備はできているか？私は間違いだ。"}, {"type": "subtitle", "time": 12804.389, "timestamp": "03:33:24", "text": "私たちはまるで間違いだった。知っている。私"}, {"type": "subtitle", "time": 12806.63, "timestamp": "03:33:26", "text": "知る。うん。私も配信しています。しかし"}, {"type": "subtitle", "time": 12811.03, "timestamp": "03:33:31", "text": "うん。リンクを更新しました。のように"}, {"type": "subtitle", "time": 12813.269, "timestamp": "03:33:33", "text": "ゲーム内のリストとリストを友達にする"}, {"type": "subtitle", "time": 12815.269, "timestamp": "03:33:35", "text": "ゲーム。それに基づいて何が"}, {"type": "subtitle", "time": 12818.95, "timestamp": "03:33:38", "text": "自己紹介？うん。わかった。待って。それで、ああ"}, {"type": "subtitle", "time": 12821.99, "timestamp": "03:33:41", "text": "ああ、私が先だ。わかった。"}, {"type": "subtitle", "time": 12825.59, "timestamp": "03:33:45", "text": "自己紹介はどのようにすればいいですか？こんにちは、ハンです。"}, {"type": "subtitle", "time": 12827.59, "timestamp": "03:33:47", "text": "私は推測する。"}, {"type": "subtitle", "time": 12829.11, "timestamp": "03:33:49", "text": "自己紹介は何にすればいいですか？"}, {"type": "subtitle", "time": 12832.55, "timestamp": "03:33:52", "text": "私は猫です。私は声優です。"}, {"type": "subtitle", "time": 12835.59, "timestamp": "03:33:55", "text": "一言ください。文句を言うよ。"}, {"type": "subtitle", "time": 12839.11, "timestamp": "03:33:59", "text": "お前は動物だ。言えますか 言えますか 言えますか"}]
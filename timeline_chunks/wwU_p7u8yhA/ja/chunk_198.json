[{"type": "subtitle", "time": 11882.389, "timestamp": "03:18:02", "text": "8:00 のような動画と、もし私が"}, {"type": "subtitle", "time": 11885.429, "timestamp": "03:18:05", "text": "10:00 のストリームは、そう、"}, {"type": "subtitle", "time": 11889.19, "timestamp": "03:18:09", "text": "動画は8時までにTwitterにアップされます。"}, {"type": "subtitle", "time": 11891.75, "timestamp": "03:18:11", "text": "30秒くらいの短い動画みたいな感じ。そして"}, {"type": "subtitle", "time": 11894.71, "timestamp": "03:18:14", "text": "ああ、こんにちは、ダッシュ。元気かい？そうですね"}, {"type": "subtitle", "time": 11898.87, "timestamp": "03:18:18", "text": "そして、これがどうなるか見てみたい。"}, {"type": "subtitle", "time": 11901.83, "timestamp": "03:18:21", "text": "良い。それは主に、より多くのものを取り込むためです"}, {"type": "subtitle", "time": 11904.55, "timestamp": "03:18:24", "text": "人々がTwitterを見たら"}, {"type": "subtitle", "time": 11906.63, "timestamp": "03:18:26", "text": "などなど、そうですよね？ Twitterでは、"}, {"type": "subtitle", "time": 11909.83, "timestamp": "03:18:29", "text": "バナーみたいなものと、ライブ配信みたいなもの。でも私は"}, {"type": "subtitle", "time": 11912.309, "timestamp": "03:18:32", "text": "それでは不十分だと思う。でももし私が"}, {"type": "subtitle", "time": 11915.269, "timestamp": "03:18:35", "text": "短い動画みたいなもの"}, {"type": "subtitle", "time": 11917.429, "timestamp": "03:18:37", "text": "毎日、すべての流れのために、私は"}, {"type": "subtitle", "time": 11920.87, "timestamp": "03:18:40", "text": "今日は信じてください。私はこう思う"}, {"type": "subtitle", "time": 11923.11, "timestamp": "03:18:43", "text": "わからないけど、使えるかもしれない"}, {"type": "subtitle", "time": 11927.91, "timestamp": "03:18:47", "text": "ビリー・ビリーのために。知るか？うん、"}, {"type": "subtitle", "time": 11931.51, "timestamp": "03:18:51", "text": "まあ、そうですね。そうそう。だから、えーと、私のえーと、私の"}, {"type": "subtitle", "time": 11934.309, "timestamp": "03:18:54", "text": "このインスピレーションは私の先輩です"}, {"type": "subtitle", "time": 11938.389, "timestamp": "03:18:58", "text": "パキサ。彼女はこれを始めた"}]
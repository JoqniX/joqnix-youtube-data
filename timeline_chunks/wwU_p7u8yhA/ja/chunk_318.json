[{"type": "subtitle", "time": 19080.31, "timestamp": "05:18:00", "text": "まだ。"}, {"type": "subtitle", "time": 19084.39, "timestamp": "05:18:04", "text": "よし、これでいい。フリント。ありがとう。はい。今"}, {"type": "subtitle", "time": 19088.31, "timestamp": "05:18:08", "text": "私は戦斧を作ることができます。ニース。"}, {"type": "subtitle", "time": 19089.99, "timestamp": "05:18:09", "text": "わかった。"}, {"type": "subtitle", "time": 19091.51, "timestamp": "05:18:11", "text": "いくつかの"}, {"type": "subtitle", "time": 19093.59, "timestamp": "05:18:13", "text": "こういう風に殴られたい。そうするべきです。"}, {"type": "subtitle", "time": 19095.35, "timestamp": "05:18:15", "text": "実際に腺を使う。実際、私は"}, {"type": "subtitle", "time": 19098.628, "timestamp": "05:18:18", "text": "たくさんの腺のように。"}, {"type": "subtitle", "time": 19101.27, "timestamp": "05:18:21", "text": "わかった。このヘルメットは"}, {"type": "subtitle", "time": 19103.43, "timestamp": "05:18:23", "text": "ストレージ。"}, {"type": "subtitle", "time": 19105.11, "timestamp": "05:18:25", "text": "はアクセスのしやすさについて言及していた"}, {"type": "subtitle", "time": 19107.51, "timestamp": "05:18:27", "text": "それぞれが癒しによって"}, {"type": "subtitle", "time": 19111.11, "timestamp": "05:18:31", "text": "軟膏を塗るのに時間がかかりすぎる"}, {"type": "subtitle", "time": 19112.788, "timestamp": "05:18:32", "text": "作る。たくさんのリソースが必要です"}, {"type": "subtitle", "time": 19115.43, "timestamp": "05:18:35", "text": "ジャガイモの場合は、"}, {"type": "subtitle", "time": 19118.39, "timestamp": "05:18:38", "text": "料理して、育てよう。"}, {"type": "subtitle", "time": 19122.628, "timestamp": "05:18:42", "text": "私はもう戦っていない。なんてこった。"}, {"type": "subtitle", "time": 19124.788, "timestamp": "05:18:44", "text": "私は今、悪魔のように戦っています"}, {"type": "subtitle", "time": 19127.91, "timestamp": "05:18:47", "text": "今すぐ。私のエネルギー"}, {"type": "subtitle", "time": 19129.91, "timestamp": "05:18:49", "text": "何"}, {"type": "subtitle", "time": 19132.23, "timestamp": "05:18:52", "text": "あそこにはたくさんの魂がいるのか？"}, {"type": "subtitle", "time": 19134.788, "timestamp": "05:18:54", "text": "いや、そうでもないですね。全然近くないですから。私"}, {"type": "subtitle", "time": 19136.55, "timestamp": "05:18:56", "text": "十分近いとは思えない。でも、"}, {"type": "subtitle", "time": 19137.91, "timestamp": "05:18:57", "text": "ほら、クモとかカエルとか"}, {"type": "subtitle", "time": 19139.59, "timestamp": "05:18:59", "text": "彼らは絶えず争っている。それはクソだ"}]
[{"type": "subtitle", "time": 9364.469, "timestamp": "02:36:04", "text": "ただ、歌姫の健康を手に入れましょう。"}, {"type": "subtitle", "time": 9366.87, "timestamp": "02:36:06", "text": "私が求めるのはそれだけです。"}, {"type": "subtitle", "time": 9370.469, "timestamp": "02:36:10", "text": "はい。良い。良い。良い。いいえ、なくしてしまいました。彼"}, {"type": "subtitle", "time": 9395.429, "timestamp": "02:36:35", "text": "私たちは勝ったのか？私たちは勝ったのか？はい、私たちは勝ちました。"}, {"type": "subtitle", "time": 9397.75, "timestamp": "02:36:37", "text": "聖なる。"}, {"type": "subtitle", "time": 9412.3, "timestamp": "02:36:52", "text": "[拍手]"}, {"type": "subtitle", "time": 9415.349, "timestamp": "02:36:55", "text": "[音楽]"}]
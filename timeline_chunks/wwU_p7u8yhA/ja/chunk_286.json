[{"type": "subtitle", "time": 17161.35, "timestamp": "04:46:01", "text": "妹が怒っているときは、"}, {"type": "subtitle", "time": 17163.99, "timestamp": "04:46:03", "text": "攻撃を開始して、あらゆることを始める。"}, {"type": "subtitle", "time": 17167.19, "timestamp": "04:46:07", "text": "飢え死にしそうだ。えっと、ちょっと待ってください。"}, {"type": "subtitle", "time": 17169.59, "timestamp": "04:46:09", "text": "ここ。ここ。えっと、"}, {"type": "subtitle", "time": 17172.55, "timestamp": "04:46:12", "text": "うっかり食べてしまった。なんてこった。あ、待って。"}, {"type": "subtitle", "time": 17174.23, "timestamp": "04:46:14", "text": "ああ、くそ。食べられないことを忘れてた"}, {"type": "subtitle", "time": 17176.868, "timestamp": "04:46:16", "text": "ベリー。ああ、気にしないで。"}, {"type": "subtitle", "time": 17179.35, "timestamp": "04:46:19", "text": "君が肉好きだってことを忘れてたよ。つまり、私は"}, {"type": "subtitle", "time": 17181.03, "timestamp": "04:46:21", "text": "待って、HPはいくつですか"}, {"type": "subtitle", "time": 17184.07, "timestamp": "04:46:24", "text": "持っている？実際は72度で、体力を消耗している。はい、私は"}, {"type": "subtitle", "time": 17185.51, "timestamp": "04:46:25", "text": "モンスターの肉をくれるよ。持続する。させて"}, {"type": "subtitle", "time": 17186.788, "timestamp": "04:46:26", "text": "モンスターミートを先に調理させてください"}, {"type": "subtitle", "time": 17189.27, "timestamp": "04:46:29", "text": "そして、それを食べることができます。えっと"}, {"type": "subtitle", "time": 17192.708, "timestamp": "04:46:32", "text": "こっちへ来い。えっと、私はクモの一族を持っています。"}, {"type": "subtitle", "time": 17200.868, "timestamp": "04:46:40", "text": "どうすれば正気を保てるようになるでしょうか？えっと、"}, {"type": "subtitle", "time": 17203.75, "timestamp": "04:46:43", "text": "花をもらう。うん。そうそう。もしあなたが"}, {"type": "subtitle", "time": 17206.31, "timestamp": "04:46:46", "text": "始めます"}, {"type": "subtitle", "time": 17208.55, "timestamp": "04:46:48", "text": "教えてください、私は召喚する必要があるので"}, {"type": "subtitle", "time": 17214.708, "timestamp": "04:46:54", "text": "うん、"}, {"type": "subtitle", "time": 17216.948, "timestamp": "04:46:56", "text": "あなたは長い間不機嫌です。これをつかむ。"}]
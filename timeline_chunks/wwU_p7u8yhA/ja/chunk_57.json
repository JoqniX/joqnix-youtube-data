[{"type": "subtitle", "time": 3420.23, "timestamp": "00:57:00", "text": "えっと、ドライブのEはRになります。これとこれ"}, {"type": "subtitle", "time": 3426.95, "timestamp": "00:57:06", "text": "そしてこれは、武器1と2をバインドします。"}, {"type": "subtitle", "time": 3429.67, "timestamp": "00:57:09", "text": "私を蹴っていいですか、リロードすると、"}, {"type": "subtitle", "time": 3437.109, "timestamp": "00:57:17", "text": "次の武器はこれら2つは必要ありません"}, {"type": "subtitle", "time": 3439.67, "timestamp": "00:57:19", "text": "つまり、それは1と2になるということだ"}, {"type": "subtitle", "time": 3443.349, "timestamp": "00:57:23", "text": "1つか2つあげようと思うけど、見てみよう"}, {"type": "subtitle", "time": 3446.309, "timestamp": "00:57:26", "text": "どうなることやら。わかった。こんにちは。"}, {"type": "subtitle", "time": 3448.23, "timestamp": "00:57:28", "text": "では、私たちがやらなければならないことの一つは"}, {"type": "subtitle", "time": 3452.15, "timestamp": "00:57:32", "text": "手短に言うと、プロフィールを作成しました。"}, {"type": "subtitle", "time": 3455.43, "timestamp": "00:57:35", "text": "プロフィールを作成しました。私はそう思います"}, {"type": "subtitle", "time": 3458.47, "timestamp": "00:57:38", "text": "プロフィールを作成してください。"}, {"type": "subtitle", "time": 3460.95, "timestamp": "00:57:40", "text": "そもそもプロフィールを作成したっけ？何てことだ。 H"}, {"type": "subtitle", "time": 3462.87, "timestamp": "00:57:42", "text": "これです。はい。"}, {"type": "subtitle", "time": 3466.39, "timestamp": "00:57:46", "text": "よし。では、私たちはそのことをします"}, {"type": "subtitle", "time": 3470.63, "timestamp": "00:57:50", "text": "こちらです。つまり、F1キーを押すと再読み込みになります。の"}, {"type": "subtitle", "time": 3473.109, "timestamp": "00:57:53", "text": "リロードはここにあります。"}, {"type": "subtitle", "time": 3477.589, "timestamp": "00:57:57", "text": "主に、デフォルト設定は"}]
[{"type": "subtitle", "time": 14222.229, "timestamp": "03:57:02", "text": "待って。"}, {"type": "subtitle", "time": 14225.67, "timestamp": "03:57:05", "text": "誰か助けて。どうしたの？なんてこった。"}, {"type": "subtitle", "time": 14229.67, "timestamp": "03:57:09", "text": "ご自由にお使いください。うん。来て。学ぶ。"}, {"type": "subtitle", "time": 14232.389, "timestamp": "03:57:12", "text": "学ぶ。学ぶ。"}, {"type": "subtitle", "time": 14239.349, "timestamp": "03:57:19", "text": "うん、行くよ。"}, {"type": "subtitle", "time": 14241.349, "timestamp": "03:57:21", "text": "なんてこった。私は友人を送りました。これは"}, {"type": "subtitle", "time": 14243.11, "timestamp": "03:57:23", "text": "前のものよりは良いけど、それでも"}, {"type": "subtitle", "time": 14244.71, "timestamp": "03:57:24", "text": "苦労しているような感じ。あなたに送りました"}, {"type": "subtitle", "time": 14247.11, "timestamp": "03:57:27", "text": "すでに友達リクエストが届いています。絶対に"}, {"type": "subtitle", "time": 14248.87, "timestamp": "03:57:28", "text": "誓って、私はそうするつもりです。たくさんあります"}, {"type": "subtitle", "time": 14251.51, "timestamp": "03:57:31", "text": "うさぎ。ご期待に添えず申し訳ありません"}, {"type": "subtitle", "time": 14255.51, "timestamp": "03:57:35", "text": "あなた。あなたは謝罪すべきだ。ああ、それはすべて"}, {"type": "subtitle", "time": 14259.269, "timestamp": "03:57:39", "text": "がっかりはしていません。私はただとてもとても"}, {"type": "subtitle", "time": 14262.15, "timestamp": "03:57:42", "text": "嫌い。がっかりしました。"}, {"type": "subtitle", "time": 14269.67, "timestamp": "03:57:49", "text": "ああ、カエルがたくさんいる。願わくば"}, {"type": "subtitle", "time": 14271.11, "timestamp": "03:57:51", "text": "バイソンさん、お仕事で良い一日をお過ごしください。"}, {"type": "subtitle", "time": 14272.87, "timestamp": "03:57:52", "text": "ところで。はい、良い一日を"}]
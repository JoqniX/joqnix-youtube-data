[{"type": "subtitle", "time": 15301.189, "timestamp": "04:15:01", "text": "お前らにスポーツマンを食わせてやれ。少し食べさせてください"}, {"type": "subtitle", "time": 15304.87, "timestamp": "04:15:04", "text": "ニンジン。ああ、ニンジンは食べられないよ。"}, {"type": "subtitle", "time": 15307.03, "timestamp": "04:15:07", "text": "ニンジン。彼は肉食主義者だ。彼は食べられない"}, {"type": "subtitle", "time": 15309.03, "timestamp": "04:15:09", "text": "どれでも。"}, {"type": "subtitle", "time": 15312.87, "timestamp": "04:15:12", "text": "なんてこった。ああ、肉は自分で殺さなければならないんだ。"}, {"type": "subtitle", "time": 15314.71, "timestamp": "04:15:14", "text": "彼にチンポを与えろ。彼にチンポを与えろ。彼に"}, {"type": "subtitle", "time": 15317.59, "timestamp": "04:15:17", "text": "コック。ああ、彼に[ __ ]をあげて。"}, {"type": "subtitle", "time": 15319.75, "timestamp": "04:15:19", "text": "彼にその怪物を与えよ。私は雄鶏を"}, {"type": "subtitle", "time": 15322.95, "timestamp": "04:15:22", "text": "ズキ。待って、"}, {"type": "subtitle", "time": 15325.59, "timestamp": "04:15:25", "text": "種子。君の種、大好きだよ、兄弟。いいえ、いいえ、"}, {"type": "subtitle", "time": 15328.63, "timestamp": "04:15:28", "text": "いいえ。私があげたドラムスティック"}, {"type": "subtitle", "time": 15336.87, "timestamp": "04:15:36", "text": "ついにポータルに近づいた。つまり、そうではない"}, {"type": "subtitle", "time": 15345.269, "timestamp": "04:15:45", "text": "私はポータルにいます。私は"}, {"type": "subtitle", "time": 15350.309, "timestamp": "04:15:50", "text": "私はまだ金を見つけていません。 F."}, {"type": "subtitle", "time": 15353.11, "timestamp": "04:15:53", "text": "うん、私もそう思う。ちょっと変なんだけど"}, {"type": "subtitle", "time": 15358.71, "timestamp": "04:15:58", "text": "エッジマップは下にあります。私はそうは思わない"}]
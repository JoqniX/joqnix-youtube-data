[{"type": "subtitle", "time": 18240.15, "timestamp": "05:04:00", "text": "胸の中に。残念ながら、"}, {"type": "subtitle", "time": 18242.55, "timestamp": "05:04:02", "text": "まだ冷蔵庫に入ってない。"}, {"type": "subtitle", "time": 18243.99, "timestamp": "05:04:03", "text": "待て、歯車があるぞ。ギアがあります"}, {"type": "subtitle", "time": 18246.788, "timestamp": "05:04:06", "text": "胸。ああ、あるよ。そうそう。私 私"}, {"type": "subtitle", "time": 18248.31, "timestamp": "05:04:08", "text": "4つのギアを取り戻した。知っている。私たちには必要だ"}, {"type": "subtitle", "time": 18249.91, "timestamp": "05:04:09", "text": "冷蔵庫に合うサイズの機械が必要です。うん、"}, {"type": "subtitle", "time": 18252.07, "timestamp": "05:04:12", "text": "忘れた。わかった。ええ、私は"}, {"type": "subtitle", "time": 18254.31, "timestamp": "05:04:14", "text": "ルークを倒してきた数個のギア"}, {"type": "subtitle", "time": 18258.23, "timestamp": "05:04:18", "text": "ここには騎士とか何とかがいる。"}, {"type": "subtitle", "time": 18260.39, "timestamp": "05:04:20", "text": "さらにいくつか。今必要なのは"}, {"type": "subtitle", "time": 18263.51, "timestamp": "05:04:23", "text": "えっと、なんて呼ぶんだっけ？"}, {"type": "subtitle", "time": 18265.75, "timestamp": "05:04:25", "text": "あの[ __ ]め。"}, {"type": "subtitle", "time": 18269.51, "timestamp": "05:04:29", "text": "ええと、科学機械です。科学"}, {"type": "subtitle", "time": 18273.11, "timestamp": "05:04:33", "text": "機械。あ、すみません。"}, {"type": "subtitle", "time": 18278.07, "timestamp": "05:04:38", "text": "狩りをするにはつるはしか何かが必要です。狩りに出かけよう"}, {"type": "subtitle", "time": 18281.99, "timestamp": "05:04:41", "text": "何度もお互いに。特別な槍"}, {"type": "subtitle", "time": 18284.708, "timestamp": "05:04:44", "text": "ところで。騎手"}, {"type": "subtitle", "time": 18286.55, "timestamp": "05:04:46", "text": "特別なヘルメット。ああ、そうではないのか"}, {"type": "subtitle", "time": 18290.15, "timestamp": "05:04:50", "text": "攻撃？ええ、それも。もし私がラグっていなかったら、"}, {"type": "subtitle", "time": 18292.47, "timestamp": "05:04:52", "text": "私だったら取り組んでいたでしょう。でも、いや、私は"}, {"type": "subtitle", "time": 18294.31, "timestamp": "05:04:54", "text": "農作業に縛られている。彼らはそうしない"}, {"type": "subtitle", "time": 18296.23, "timestamp": "05:04:56", "text": "何でも。はぁ？特別なものを手に入れるにはどうすればいいですか？"}, {"type": "subtitle", "time": 18297.91, "timestamp": "05:04:57", "text": "商品？"}]
[{"type": "subtitle", "time": 19744.15, "timestamp": "05:29:04", "text": "ああ、大変だ。スパイダーマンがたくさん。はい。殺す。"}, {"type": "subtitle", "time": 19746.708, "timestamp": "05:29:06", "text": "何てことだ。"}, {"type": "subtitle", "time": 19751.99, "timestamp": "05:29:11", "text": "指名手配。"}, {"type": "subtitle", "time": 19755.99, "timestamp": "05:29:15", "text": "あなたたち全員対私全員。"}, {"type": "subtitle", "time": 19759.75, "timestamp": "05:29:19", "text": "主よ。くそくらえ。待って。私はどうですか"}, {"type": "subtitle", "time": 19761.27, "timestamp": "05:29:21", "text": "まだ生きているのか？ああ、なんてことだ。まだ"}, {"type": "subtitle", "time": 19764.948, "timestamp": "05:29:24", "text": "生きている。はぁ？食べ物が必要だ。あなたの妹は"}, {"type": "subtitle", "time": 19767.11, "timestamp": "05:29:27", "text": "強すぎる。はい、彼女は強すぎます。よし、"}, {"type": "subtitle", "time": 19771.99, "timestamp": "05:29:31", "text": "妹もOPだ。弱体化してください。"}, {"type": "subtitle", "time": 19787.83, "timestamp": "05:29:47", "text": "彼らは私を集団レイプしている。いいえ。いいえ。"}, {"type": "subtitle", "time": 19789.67, "timestamp": "05:29:49", "text": "本当にやりたいの？それから私たちは"}, {"type": "subtitle", "time": 19791.99, "timestamp": "05:29:51", "text": "ここでやらなきゃならないんだ。システム。待って、"}]
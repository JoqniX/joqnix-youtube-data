[{"type": "subtitle", "time": 18661.59, "timestamp": "05:11:01", "text": "まあ、以前はそうだったよね。以前はそうだったよね。慣れている。"}, {"type": "subtitle", "time": 18664.708, "timestamp": "05:11:04", "text": "ねえ、私もう大人になったのよ。とても誇りに思います。"}, {"type": "subtitle", "time": 18668.708, "timestamp": "05:11:08", "text": "でも、私は今すぐ癒しが必要なの。私は癒しを必要としている。"}, {"type": "subtitle", "time": 18670.948, "timestamp": "05:11:10", "text": "パパ、私には癒しが必要なの。"}, {"type": "subtitle", "time": 18673.43, "timestamp": "05:11:13", "text": "お母さん、私には癒しが必要なの。"}, {"type": "subtitle", "time": 18676.15, "timestamp": "05:11:16", "text": "私は近くにもいない、なぜなら私はただ"}, {"type": "subtitle", "time": 18677.75, "timestamp": "05:11:17", "text": "基地に滞在する予定です。持続する。わかった、"}, {"type": "subtitle", "time": 18679.67, "timestamp": "05:11:19", "text": "じゃあ、基地に行きます。ええ、私は"}, {"type": "subtitle", "time": 18681.03, "timestamp": "05:11:21", "text": "つまり、もっと薪を割らなければならないということだ。"}, {"type": "subtitle", "time": 18682.31, "timestamp": "05:11:22", "text": "木材が実際に不足しています"}, {"type": "subtitle", "time": 18685.19, "timestamp": "05:11:25", "text": "良い。ああ、私も薪割りをしているところだよ"}, {"type": "subtitle", "time": 18687.03, "timestamp": "05:11:27", "text": "それから。"}, {"type": "subtitle", "time": 18688.788, "timestamp": "05:11:28", "text": "資料を入手してください。ここ。ほら、ここにあるよ"}, {"type": "subtitle", "time": 18689.91, "timestamp": "05:11:29", "text": "その物。主に"}, {"type": "subtitle", "time": 18693.03, "timestamp": "05:11:33", "text": "あらゆるものによって虐殺された。"}, {"type": "subtitle", "time": 18694.628, "timestamp": "05:11:34", "text": "私は行く必要があります。あなたが"}, {"type": "subtitle", "time": 18696.47, "timestamp": "05:11:36", "text": "冬用の帽子をかぶっても役に立たなかった"}, {"type": "subtitle", "time": 18697.91, "timestamp": "05:11:37", "text": "そして、サーマルストーンは、あなたが"}, {"type": "subtitle", "time": 18700.39, "timestamp": "05:11:40", "text": "虐殺されている。"}, {"type": "subtitle", "time": 18702.55, "timestamp": "05:11:42", "text": "まだベビーシッターが必要なんです。パパ、どこに"}, {"type": "subtitle", "time": 18704.868, "timestamp": "05:11:44", "text": "私の電気製品？"}, {"type": "subtitle", "time": 18708.07, "timestamp": "05:11:48", "text": "なんてこった。"}, {"type": "subtitle", "time": 18709.67, "timestamp": "05:11:49", "text": "もうすぐだ。私は吸わなければならない"}, {"type": "subtitle", "time": 18712.09, "timestamp": "05:11:52", "text": "コンセント。"}, {"type": "subtitle", "time": 18714.39, "timestamp": "05:11:54", "text": "[音楽]"}, {"type": "subtitle", "time": 18716.708, "timestamp": "05:11:56", "text": "それはアンドロイドがそうであるように"}]
[{"type": "subtitle", "time": 3183.99, "timestamp": "00:53:03", "text": "ああ、これが広告をキャプチャする方法ですね。"}, {"type": "subtitle", "time": 3191.109, "timestamp": "00:53:11", "text": "P. ええ。こんにちは、Pさん。"}, {"type": "subtitle", "time": 3200.15, "timestamp": "00:53:20", "text": "ああ、あの酸味が大好きだ。"}, {"type": "subtitle", "time": 3204.63, "timestamp": "00:53:24", "text": "ニース。それでおしまい。"}, {"type": "subtitle", "time": 3207.51, "timestamp": "00:53:27", "text": "ありがとう。愛している。こんにちは。あなたも。試してみてください"}, {"type": "subtitle", "time": 3210.47, "timestamp": "00:53:30", "text": "ゲームに参加しよう。 D. 一緒に遊びましょう。あなた"}, {"type": "subtitle", "time": 3212.15, "timestamp": "00:53:32", "text": "もしあなたがそれを終わらせることができて、"}, {"type": "subtitle", "time": 3213.91, "timestamp": "00:53:33", "text": "もの、"}, {"type": "subtitle", "time": 3217.349, "timestamp": "00:53:37", "text": "男。ついに。何てことだ。ああ、英雄たちよ"}, {"type": "subtitle", "time": 3220.549, "timestamp": "00:53:40", "text": "リスト。だから、私のお気に入りの一つは"}, {"type": "subtitle", "time": 3226.63, "timestamp": "00:53:46", "text": "えーと、好きなキャラクターとオーバーウォッチ"}, {"type": "subtitle", "time": 3228.79, "timestamp": "00:53:48", "text": "慈悲です。"}, {"type": "subtitle", "time": 3231.67, "timestamp": "00:53:51", "text": "なぜ彼女を愛しているのか、自分でもわからない。慈悲"}, {"type": "subtitle", "time": 3235.75, "timestamp": "00:53:55", "text": "フォートナイト。私にはマーシーにそっくりな人がいる。"}, {"type": "subtitle", "time": 3237.99, "timestamp": "00:53:57", "text": "でも、今回は確かにそう思う。おお、"}]
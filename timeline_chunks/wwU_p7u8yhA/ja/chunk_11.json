[{"type": "subtitle", "time": 664.31, "timestamp": "00:11:04", "text": "[音楽]"}, {"type": "subtitle", "time": 666.949, "timestamp": "00:11:06", "text": "歌は覚えたけど、ちょっと"}, {"type": "subtitle", "time": 674.31, "timestamp": "00:11:14", "text": "日本の歌はほとんどすべて、"}, {"type": "subtitle", "time": 676.949, "timestamp": "00:11:16", "text": "難しいけど、アルミホイルが必要だ。"}, {"type": "subtitle", "time": 679.99, "timestamp": "00:11:19", "text": "まだ4歳くらいの頃から学んでいる"}, {"type": "subtitle", "time": 682.23, "timestamp": "00:11:22", "text": "一瞬。"}, {"type": "subtitle", "time": 684.23, "timestamp": "00:11:24", "text": "いいえ、私は"}, {"type": "subtitle", "time": 687.43, "timestamp": "00:11:27", "text": "声域とかそういうの。それで"}, {"type": "subtitle", "time": 689.91, "timestamp": "00:11:29", "text": "私は他の人に、私ができると思いますかと尋ねました"}, {"type": "subtitle", "time": 693.67, "timestamp": "00:11:33", "text": "これを覚えて、歌を送ってください"}, {"type": "subtitle", "time": 695.829, "timestamp": "00:11:35", "text": "私は学んでいます。彼らは、もっと"}, {"type": "subtitle", "time": 698.63, "timestamp": "00:11:38", "text": "いや、君には無理だと思うよ、ジョック。"}, {"type": "subtitle", "time": 700.79, "timestamp": "00:11:40", "text": "おい"}, {"type": "subtitle", "time": 702.79, "timestamp": "00:11:42", "text": "まだ全力を出し切れていない。私はしていません"}, {"type": "subtitle", "time": 705.59, "timestamp": "00:11:45", "text": "まだ試していません。待って、そんなこと言わないで。"}, {"type": "subtitle", "time": 709.75, "timestamp": "00:11:49", "text": "私が歌うのを聴かないでください。私はこう思う、"}]
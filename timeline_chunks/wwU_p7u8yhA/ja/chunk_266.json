[{"type": "subtitle", "time": 15963.189, "timestamp": "04:26:03", "text": "行くの？待って、待って、待って。どこにいるの"}, {"type": "subtitle", "time": 15966.07, "timestamp": "04:26:06", "text": "去る？待って、ちょっと待って。そういうことです。"}, {"type": "subtitle", "time": 15968.63, "timestamp": "04:26:08", "text": "ちょっと待って。"}, {"type": "subtitle", "time": 15974.389, "timestamp": "04:26:14", "text": "おいおい、勘弁してくれよ。黙れ。私はよく道に迷います。"}, {"type": "subtitle", "time": 15977.03, "timestamp": "04:26:17", "text": "簡単に。はい、私は本当に道に迷いやすいんです。"}, {"type": "subtitle", "time": 15980.71, "timestamp": "04:26:20", "text": "このゲームにはGPSが搭載されています。待って、それはどこにあるの？"}, {"type": "subtitle", "time": 15983.83, "timestamp": "04:26:23", "text": "彼、沈黙してる？うん。彼はどこにいるのか"}, {"type": "subtitle", "time": 15985.99, "timestamp": "04:26:25", "text": "された？"}, {"type": "subtitle", "time": 15987.67, "timestamp": "04:26:27", "text": "地図をもう一度。私はこう思う。私"}, {"type": "subtitle", "time": 15990.87, "timestamp": "04:26:30", "text": "順調に進んでいると思う。真っ直ぐ"}, {"type": "subtitle", "time": 15993.189, "timestamp": "04:26:33", "text": "下。私はまるでコウモリの洞窟の地下にいるみたいだ"}, {"type": "subtitle", "time": 15995.429, "timestamp": "04:26:35", "text": "もの。ああ、なぜ？ああ、あなたは、あなたは"}, {"type": "subtitle", "time": 15998.71, "timestamp": "04:26:38", "text": "採掘。わかった。あ、待って。ここはどこ"}, {"type": "subtitle", "time": 16003.59, "timestamp": "04:26:43", "text": "念のため。"}, {"type": "subtitle", "time": 16007.349, "timestamp": "04:26:47", "text": "よし、行こう。ああ、旅。薪を割り、"}, {"type": "subtitle", "time": 16011.51, "timestamp": "04:26:51", "text": "農民。薪を割る。私はこの道が好きだから。"}, {"type": "subtitle", "time": 16013.75, "timestamp": "04:26:53", "text": "はい。私はこの道が好きです。刻むと"}, {"type": "subtitle", "time": 16015.99, "timestamp": "04:26:55", "text": "木材。"}]
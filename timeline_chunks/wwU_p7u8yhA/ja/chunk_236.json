[{"type": "subtitle", "time": 14160.63, "timestamp": "03:56:00", "text": "私は絶対にやらない。着用"}, {"type": "subtitle", "time": 14164.229, "timestamp": "03:56:04", "text": "誕生日の裸だよ、兄弟。"}, {"type": "subtitle", "time": 14166.229, "timestamp": "03:56:06", "text": "待って、あなたは誕生日に裸になるの？"}, {"type": "subtitle", "time": 14169.75, "timestamp": "03:56:09", "text": "あなたの誕生日パーティーのために？おお、"}, {"type": "subtitle", "time": 14172.15, "timestamp": "03:56:12", "text": "ごめんね、ソサン。どうすればいいのかわからない"}, {"type": "subtitle", "time": 14175.429, "timestamp": "03:56:15", "text": "使用する。いいえ、大丈夫です。あなたはそうする必要はありません"}, {"type": "subtitle", "time": 14178.469, "timestamp": "03:56:18", "text": "大丈夫だよ。私はそうすべきですか？いいえ、大丈夫です。"}, {"type": "subtitle", "time": 14181.99, "timestamp": "03:56:21", "text": "いいえ、大丈夫です。大丈夫です。いいえ、大丈夫です。"}, {"type": "subtitle", "time": 14187.269, "timestamp": "03:56:27", "text": "私はただ、ただ一人になるだけです。すべて"}, {"type": "subtitle", "time": 14189.429, "timestamp": "03:56:29", "text": "操作方法がわかりません。ほら、"}, {"type": "subtitle", "time": 14191.51, "timestamp": "03:56:31", "text": "ジョーはそれを持っている？もし持っていなければ、私は"}, {"type": "subtitle", "time": 14195.349, "timestamp": "03:56:35", "text": "今から負ける。どうぞ。"}, {"type": "subtitle", "time": 14198.229, "timestamp": "03:56:38", "text": "え、どういう意味ですか？"}, {"type": "subtitle", "time": 14207.51, "timestamp": "03:56:47", "text": "ああ、そうですね。苦しむ。"}, {"type": "subtitle", "time": 14209.03, "timestamp": "03:56:49", "text": "このゲームは自動一時停止機能付きです。それは何ですか"}, {"type": "subtitle", "time": 14211.51, "timestamp": "03:56:51", "text": "どういう意味ですか？"}, {"type": "subtitle", "time": 14214.95, "timestamp": "03:56:54", "text": "それは文字通りの意味です。"}, {"type": "subtitle", "time": 14217.83, "timestamp": "03:56:57", "text": "自動一時停止機能が追加されました。ああ、それ"}, {"type": "subtitle", "time": 14219.67, "timestamp": "03:56:59", "text": "馬鹿げているように聞こえる。"}]
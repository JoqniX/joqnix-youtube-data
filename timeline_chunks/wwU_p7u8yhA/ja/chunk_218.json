[{"type": "subtitle", "time": 13081.67, "timestamp": "03:38:01", "text": "自分が話しているなんて信じられない"}, {"type": "subtitle", "time": 13083.99, "timestamp": "03:38:03", "text": "親友。彼は何も演奏しない。"}, {"type": "subtitle", "time": 13086.95, "timestamp": "03:38:06", "text": "どうしてこんなに年をとっているのに、こんなにも若々しいのだろう？"}, {"type": "subtitle", "time": 13090.95, "timestamp": "03:38:10", "text": "私は全力でプレーするように心がけています。いいえ、必要ありません。"}, {"type": "subtitle", "time": 13095.67, "timestamp": "03:38:15", "text": "あなたはしない。あなたはしない。あなたは私にそうさせた。"}, {"type": "subtitle", "time": 13098.15, "timestamp": "03:38:18", "text": "あなたは私に信頼テトリスをプレイすることを強要しました"}, {"type": "subtitle", "time": 13099.67, "timestamp": "03:38:19", "text": "銃を突きつけられて。"}, {"type": "subtitle", "time": 13107.19, "timestamp": "03:38:27", "text": "世界的なスター。"}, {"type": "subtitle", "time": 13109.67, "timestamp": "03:38:29", "text": "よし、それでは登場人物の説明に移ろう"}, {"type": "subtitle", "time": 13112.15, "timestamp": "03:38:32", "text": "JoxとSuzuki以来の新しい人々へ"}, {"type": "subtitle", "time": 13115.91, "timestamp": "03:38:35", "text": "彼らはこの業界では比較的新参者だ。"}, {"type": "subtitle", "time": 13119.03, "timestamp": "03:38:39", "text": "最初のキャラクター、基本的な[ __ ]には"}, {"type": "subtitle", "time": 13120.389, "timestamp": "03:38:40", "text": "成長以外の特別な能力"}, {"type": "subtitle", "time": 13123.269, "timestamp": "03:38:43", "text": "冬の寒さから身を守るのに役立つ髭。"}, {"type": "subtitle", "time": 13125.429, "timestamp": "03:38:45", "text": "それでおしまい。これは普段のあなたです"}, {"type": "subtitle", "time": 13127.19, "timestamp": "03:38:47", "text": "演奏することになっている。一緒に始めないでください。"}, {"type": "subtitle", "time": 13129.83, "timestamp": "03:38:49", "text": "基本ゲーム。基本 基本"}]
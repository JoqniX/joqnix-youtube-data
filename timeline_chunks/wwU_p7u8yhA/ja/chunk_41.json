[{"type": "subtitle", "time": 2462.309, "timestamp": "00:41:02", "text": "回。ちょっと待ってください。 125くらいです。"}, {"type": "subtitle", "time": 2465.349, "timestamp": "00:41:05", "text": "右？わかった。こんにちは。だから私は読み上げることができる"}, {"type": "subtitle", "time": 2468.069, "timestamp": "00:41:08", "text": "配信終了に参加した人の名前"}, {"type": "subtitle", "time": 2470.63, "timestamp": "00:41:10", "text": "分離器。ああ、いや、いや。まるで私が"}, {"type": "subtitle", "time": 2474.39, "timestamp": "00:41:14", "text": "それは私の自動化ツールのようなもので、"}, {"type": "subtitle", "time": 2476.55, "timestamp": "00:41:16", "text": "ストリームを終了すると、そう、"}, {"type": "subtitle", "time": 2479.109, "timestamp": "00:41:19", "text": "自動的にセパレータのように追加します"}, {"type": "subtitle", "time": 2483.91, "timestamp": "00:41:23", "text": "私のTwitchチャットで、えーと、助けてOnxia"}, {"type": "subtitle", "time": 2487.51, "timestamp": "00:41:27", "text": "ヘルパーアカウント、Twitchチャット。だから私は"}, {"type": "subtitle", "time": 2491.829, "timestamp": "00:41:31", "text": "私のログは、"}, {"type": "subtitle", "time": 2494.63, "timestamp": "00:41:34", "text": "配信を見に来たりした。送ります"}, {"type": "subtitle", "time": 2497.67, "timestamp": "00:41:37", "text": "Twitchメッセージとして。"}, {"type": "subtitle", "time": 2500.79, "timestamp": "00:41:40", "text": "Twitchメッセージ。だから、見ていただければわかると思います。"}, {"type": "subtitle", "time": 2502.63, "timestamp": "00:41:42", "text": "そんな感じ。"}, {"type": "subtitle", "time": 2505.03, "timestamp": "00:41:45", "text": "声の正しい発音は「ヤー」です。いいえ、"}, {"type": "subtitle", "time": 2506.95, "timestamp": "00:41:46", "text": "いや、いや。これは自分のためです。それはまるで"}, {"type": "subtitle", "time": 2509.67, "timestamp": "00:41:49", "text": "個人ログのようなもの。私はこれをしなければならない"}, {"type": "subtitle", "time": 2513.03, "timestamp": "00:41:53", "text": "いつかこのコードをあなたに送ります。それは"}, {"type": "subtitle", "time": 2515.75, "timestamp": "00:41:55", "text": "小川。えーっと、やり方をお見せします"}, {"type": "subtitle", "time": 2518.309, "timestamp": "00:41:58", "text": "チュートリアルみたいに保存する"}]
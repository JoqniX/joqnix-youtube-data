[{"type": "subtitle", "time": 973.749, "timestamp": "00:16:13", "text": "あ、待って、待って、待って。我慢する。これは"}, {"type": "subtitle", "time": 975.749, "timestamp": "00:16:15", "text": "一本の木。待って、私は1つ植えました"}, {"type": "subtitle", "time": 977.749, "timestamp": "00:16:17", "text": "木。こんにちは。"}, {"type": "subtitle", "time": 980.31, "timestamp": "00:16:20", "text": "とんでもない。私は一本の木を植え、"}, {"type": "subtitle", "time": 983.91, "timestamp": "00:16:23", "text": "左。え、何？"}, {"type": "subtitle", "time": 986.15, "timestamp": "00:16:26", "text": "ポップコーン"}]
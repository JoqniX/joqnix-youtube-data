[{"type": "subtitle", "time": 123.19, "timestamp": "00:02:03", "text": "ああ、大変だ。着替えなきゃ。"}, {"type": "subtitle", "time": 125.19, "timestamp": "00:02:05", "text": "それから私は服を着た。つまり、私は"}, {"type": "subtitle", "time": 129.109, "timestamp": "00:02:09", "text": "この3Dジョッキーを配置する必要がある。あなたは"}, {"type": "subtitle", "time": 133.75, "timestamp": "00:02:13", "text": "背景。おお。だから、私は"}, {"type": "subtitle", "time": 140.36, "timestamp": "00:02:20", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 149.43, "timestamp": "00:02:29", "text": "理由がわからない。えっと"}, {"type": "subtitle", "time": 151.82999999999998, "timestamp": "00:02:31", "text": "ああ、吐き気がする。私は感じた"}, {"type": "subtitle", "time": 155.99, "timestamp": "00:02:35", "text": "さっき吐いたとき、えっと、"}, {"type": "subtitle", "time": 159.27, "timestamp": "00:02:39", "text": "ああ、ベイが行く"}, {"type": "subtitle", "time": 161.67000000000002, "timestamp": "00:02:41", "text": "家事をしている。いくつか洗わなければならなかった"}, {"type": "subtitle", "time": 164.79, "timestamp": "00:02:44", "text": "お皿とかそういうもの。そして、えっと、"}, {"type": "subtitle", "time": 167.589, "timestamp": "00:02:47", "text": "温かい水、温かい水の入ったバケツ"}, {"type": "subtitle", "time": 169.82999999999998, "timestamp": "00:02:49", "text": "おばあちゃんとか何かに。だから私は運ばなければならなかった"}, {"type": "subtitle", "time": 172.71, "timestamp": "00:02:52", "text": "それとかそういうもの。そう、持ち運び中は"}, {"type": "subtitle", "time": 175.589, "timestamp": "00:02:55", "text": "ああ、すごく気分が悪い。おお"}, {"type": "subtitle", "time": 179.11, "timestamp": "00:02:59", "text": "ああ、でも私は大丈夫。"}]
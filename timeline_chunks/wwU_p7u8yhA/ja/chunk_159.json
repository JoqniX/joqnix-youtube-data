[{"type": "subtitle", "time": 9540.87, "timestamp": "02:39:00", "text": "私はただ、"}, {"type": "subtitle", "time": 9542.389, "timestamp": "02:39:02", "text": "スナイパー"}, {"type": "subtitle", "time": 9552.07, "timestamp": "02:39:12", "text": "おお。"}, {"type": "subtitle", "time": 9554.79, "timestamp": "02:39:14", "text": "あ、待って。これはすごくクールだ。待って、"}, {"type": "subtitle", "time": 9558.389, "timestamp": "02:39:18", "text": "これらはどうすれば入手できますか？すごくかっこいい。"}, {"type": "subtitle", "time": 9562.71, "timestamp": "02:39:22", "text": "わあ、すごい。肩書きとかもらえるよ。くそ、"}, {"type": "subtitle", "time": 9566.309, "timestamp": "02:39:26", "text": "これ、すごくかっこいいですね。"}, {"type": "subtitle", "time": 9568.63, "timestamp": "02:39:28", "text": "わかった。えっと、次はハンゾーです。何てことだ。私は"}, {"type": "subtitle", "time": 9570.95, "timestamp": "02:39:30", "text": "次はハンゾーを手に入れるつもりだ。よし、"}, {"type": "subtitle", "time": 9573.19, "timestamp": "02:39:33", "text": "遊ぶ。"}, {"type": "subtitle", "time": 9583.83, "timestamp": "02:39:43", "text": "この弓使いの男を見てみたい。"}, {"type": "subtitle", "time": 9587.67, "timestamp": "02:39:47", "text": "どうして？弓を引いて"}, {"type": "subtitle", "time": 9591.349, "timestamp": "02:39:51", "text": "撮影とかそういうこと。"}, {"type": "subtitle", "time": 9593.11, "timestamp": "02:39:53", "text": "それは良いことだ。"}, {"type": "subtitle", "time": 9597.11, "timestamp": "02:39:57", "text": "[音楽]"}, {"type": "subtitle", "time": 9599.51, "timestamp": "02:39:59", "text": "短距離線状ブリームエネルギーグレネード"}]
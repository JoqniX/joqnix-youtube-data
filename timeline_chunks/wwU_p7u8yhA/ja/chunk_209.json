[{"type": "subtitle", "time": 12575.03, "timestamp": "03:29:35", "text": "うん。こんにちは、みんな。"}, {"type": "subtitle", "time": 12578.07, "timestamp": "03:29:38", "text": "うん。こんにちは。うん。こんにちは。"}, {"type": "subtitle", "time": 12583.269, "timestamp": "03:29:43", "text": "えっと、それ、やるのが忘れてたんです。なんて馬鹿げてるんだ。"}, {"type": "subtitle", "time": 12586.71, "timestamp": "03:29:46", "text": "今日私たちは遊んでいます"}, {"type": "subtitle", "time": 12592.389, "timestamp": "03:29:52", "text": "一緒に飢え死にしないで"}, {"type": "subtitle", "time": 12594.55, "timestamp": "03:29:54", "text": "ハント"}, {"type": "subtitle", "time": 12598.63, "timestamp": "03:29:58", "text": "寿司とクラン。"}]
[{"type": "subtitle", "time": 17821.19, "timestamp": "04:57:01", "text": "それはとんでもない量の肉だ。それを受け取って。おお、"}, {"type": "subtitle", "time": 17825.91, "timestamp": "04:57:05", "text": "待って。ズキ。フリック。わかった。"}, {"type": "subtitle", "time": 17828.55, "timestamp": "04:57:08", "text": "ミートボールを作るなら。だから誰も"}, {"type": "subtitle", "time": 17830.708, "timestamp": "04:57:10", "text": "再び生き返った。ニース。妹を連れてきて。得る"}, {"type": "subtitle", "time": 17833.91, "timestamp": "04:57:13", "text": "あなたの妹。私は必要としている"}, {"type": "subtitle", "time": 17835.43, "timestamp": "04:57:15", "text": "今。"}, {"type": "subtitle", "time": 17838.55, "timestamp": "04:57:18", "text": "えっと、どこを撮ったか忘れました。"}, {"type": "subtitle", "time": 17840.948, "timestamp": "04:57:20", "text": "私の持ち物すべて。"}, {"type": "subtitle", "time": 17842.788, "timestamp": "04:57:22", "text": "ここのクモを退治したの？"}, {"type": "subtitle", "time": 17844.708, "timestamp": "04:57:24", "text": "ここにクモがいるよ。そうそう。おお、"}, {"type": "subtitle", "time": 17846.948, "timestamp": "04:57:26", "text": "クモがいる。"}, {"type": "subtitle", "time": 17849.59, "timestamp": "04:57:29", "text": "ええと、彼らを無視して逃げてください。どこ"}, {"type": "subtitle", "time": 17851.35, "timestamp": "04:57:31", "text": "入れるべきでしょうか？どこに置けばいいですか？"}, {"type": "subtitle", "time": 17855.11, "timestamp": "04:57:35", "text": "こちらです。複数のカエル。"}, {"type": "subtitle", "time": 17858.39, "timestamp": "04:57:38", "text": "クモ。基地へ向かいます。"}, {"type": "subtitle", "time": 17860.15, "timestamp": "04:57:40", "text": "よし。うん、ミートボール作れるよ"}, {"type": "subtitle", "time": 17863.75, "timestamp": "04:57:43", "text": "今。ニース。あそこにクモがいる。できない"}, {"type": "subtitle", "time": 17867.35, "timestamp": "04:57:47", "text": "それには長すぎる時間はない。いいえ、"}, {"type": "subtitle", "time": 17868.868, "timestamp": "04:57:48", "text": "待って。"}, {"type": "subtitle", "time": 17872.07, "timestamp": "04:57:52", "text": "クモはこっちにいます。"}, {"type": "subtitle", "time": 17874.31, "timestamp": "04:57:54", "text": "松明がなければ死ぬぞ。"}]
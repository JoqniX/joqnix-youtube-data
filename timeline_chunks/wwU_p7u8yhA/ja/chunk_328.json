[{"type": "subtitle", "time": 19680.31, "timestamp": "05:28:00", "text": "人々？"}, {"type": "subtitle", "time": 19682.31, "timestamp": "05:28:02", "text": "誰か、"}, {"type": "subtitle", "time": 19685.27, "timestamp": "05:28:05", "text": "私のジャックを見ていてください？来て。こちらへどうぞ、"}, {"type": "subtitle", "time": 19688.07, "timestamp": "05:28:08", "text": "みんな。"}, {"type": "subtitle", "time": 19690.628, "timestamp": "05:28:10", "text": "それは確かに事実です。調子はどうですか？"}, {"type": "subtitle", "time": 19692.708, "timestamp": "05:28:12", "text": "あなたはどのように死ぬつもりですか？最高だ。"}, {"type": "subtitle", "time": 19695.03, "timestamp": "05:28:15", "text": "火を消します。知っている"}, {"type": "subtitle", "time": 19697.67, "timestamp": "05:28:17", "text": "まさに私が望む死に方だ。なんてこった。ただ"}, {"type": "subtitle", "time": 19703.2, "timestamp": "05:28:23", "text": "よし。"}, {"type": "subtitle", "time": 19705.91, "timestamp": "05:28:25", "text": "[音楽]"}, {"type": "subtitle", "time": 19717.19, "timestamp": "05:28:37", "text": "ああ、それは"}, {"type": "subtitle", "time": 19720.39, "timestamp": "05:28:40", "text": "ベリー。ベリー。よし、始めよう。"}, {"type": "subtitle", "time": 19722.628, "timestamp": "05:28:42", "text": "男の子たち。ちょっと待って。私はまだ"}, {"type": "subtitle", "time": 19725.11, "timestamp": "05:28:45", "text": "あちらへ行く。さぁ行こう。私はまだ"}, {"type": "subtitle", "time": 19726.868, "timestamp": "05:28:46", "text": "後でまたこのワールドでプレイするつもりだ。もし"}, {"type": "subtitle", "time": 19729.27, "timestamp": "05:28:49", "text": "いいえ、放火をする可能性もあれば、しない可能性もあります。ここ"}, {"type": "subtitle", "time": 19731.99, "timestamp": "05:28:51", "text": "行くぞ。おお、"}, {"type": "subtitle", "time": 19737.83, "timestamp": "05:28:57", "text": "いいえ。スパイダー。ああ、大変だ。"}]
[{"type": "subtitle", "time": 15548.469, "timestamp": "04:19:08", "text": "ああ、大変だ。ちょっとした楽しみ。変更するにはどうすればいいですか"}, {"type": "subtitle", "time": 15551.269, "timestamp": "04:19:11", "text": "カメラ？"}, {"type": "subtitle", "time": 15554.71, "timestamp": "04:19:14", "text": "Q. ああ、Q. そうだね。"}, {"type": "subtitle", "time": 15570.63, "timestamp": "04:19:30", "text": "Xゲーマーの皆さん、こんにちは。はぁ？元気かい？希望"}, {"type": "subtitle", "time": 15578.71, "timestamp": "04:19:38", "text": "カエルを攻撃する。正しい方向へ進んでいる。あなたは"}, {"type": "subtitle", "time": 15581.349, "timestamp": "04:19:41", "text": "死ぬだろう。"}, {"type": "subtitle", "time": 15584.37, "timestamp": "04:19:44", "text": "お前は死ぬぞ。お前は死ぬぞ。"}, {"type": "subtitle", "time": 15593.83, "timestamp": "04:19:53", "text": "ここでは全てが命取りになる。うん。しないで"}, {"type": "subtitle", "time": 15595.91, "timestamp": "04:19:55", "text": "何とでも戦う。"}, {"type": "subtitle", "time": 15597.67, "timestamp": "04:19:57", "text": "すべてが反撃する"}]
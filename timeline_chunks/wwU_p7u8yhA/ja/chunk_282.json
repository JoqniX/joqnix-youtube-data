[{"type": "subtitle", "time": 16922.39, "timestamp": "04:42:02", "text": "必要"}, {"type": "subtitle", "time": 16923.91, "timestamp": "04:42:03", "text": "ツール。"}, {"type": "subtitle", "time": 16931.43, "timestamp": "04:42:11", "text": "よし。死者たち。うん。いいえ、それなら"}, {"type": "subtitle", "time": 16933.75, "timestamp": "04:42:13", "text": "あなたは大丈夫です。大丈夫ですよ。よし。手に入れた"}, {"type": "subtitle", "time": 16936.37, "timestamp": "04:42:16", "text": "休む。心配しなければならないのは"}, {"type": "subtitle", "time": 16937.51, "timestamp": "04:42:17", "text": "[音楽]"}, {"type": "subtitle", "time": 16939.43, "timestamp": "04:42:19", "text": "待って、斧を作らなきゃいけないんだよね？私"}, {"type": "subtitle", "time": 16940.39, "timestamp": "04:42:20", "text": "ちなみに、木材はありません。私はしません"}, {"type": "subtitle", "time": 16943.83, "timestamp": "04:42:23", "text": "木材がある。もしあなたが、えーと"}, {"type": "subtitle", "time": 16946.868, "timestamp": "04:42:26", "text": "はい、ありがとうございます。えっと、ズキ、こっちに来て。"}, {"type": "subtitle", "time": 16948.868, "timestamp": "04:42:28", "text": "ハートを作ってあげるよ。ああ、ズキは"}, {"type": "subtitle", "time": 16951.83, "timestamp": "04:42:31", "text": "クソッタレの火打ち石。"}, {"type": "subtitle", "time": 16954.31, "timestamp": "04:42:34", "text": "こっちへ来い。ああ、おい。 30個くらい入れた"}, {"type": "subtitle", "time": 16957.03, "timestamp": "04:42:37", "text": "胸に火打ち石が刺さっている。わかった。どこにいるの？"}, {"type": "subtitle", "time": 16962.07, "timestamp": "04:42:42", "text": "ここ。あらら、犬だ。"}, {"type": "subtitle", "time": 16964.23, "timestamp": "04:42:44", "text": "よし、始めよう。もう少しで"}, {"type": "subtitle", "time": 16967.99, "timestamp": "04:42:47", "text": "クソみたいな木だよ、ハニー。フン。"}, {"type": "subtitle", "time": 16975.43, "timestamp": "04:42:55", "text": "[音楽]"}, {"type": "subtitle", "time": 16977.27, "timestamp": "04:42:57", "text": "おいおい、勘弁してくれよ。持続する。私は作れると思う"}, {"type": "subtitle", "time": 16978.628, "timestamp": "04:42:58", "text": "また一人。もう一つ作れると思う"}]
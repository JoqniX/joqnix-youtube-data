[{"type": "subtitle", "time": 19142.15, "timestamp": "05:19:02", "text": "ギャング同士の喧嘩がここで起きている。拾うだけで"}, {"type": "subtitle", "time": 19145.35, "timestamp": "05:19:05", "text": "くそったれカエルの足め。無料の肉です"}, {"type": "subtitle", "time": 19148.55, "timestamp": "05:19:08", "text": "方法。ああ、私を解放してくれ。"}, {"type": "subtitle", "time": 19151.27, "timestamp": "05:19:11", "text": "よし、戻るよ。"}, {"type": "subtitle", "time": 19153.67, "timestamp": "05:19:13", "text": "ここは農業に適した土地だ。ええ、それは"}, {"type": "subtitle", "time": 19159.99, "timestamp": "05:19:19", "text": "うん。もっと回復アイテムをもらえますか？いやいや。"}, {"type": "subtitle", "time": 19163.43, "timestamp": "05:19:23", "text": "えっと、私の体力は17くらいなので、もし"}, {"type": "subtitle", "time": 19166.708, "timestamp": "05:19:26", "text": "奴らが俺に触れたら、俺は死ぬ。おお"}, {"type": "subtitle", "time": 19172.708, "timestamp": "05:19:32", "text": "よし、料理して、それからもっと食べなきゃ。"}, {"type": "subtitle", "time": 19175.75, "timestamp": "05:19:35", "text": "さもなければ、私は死んでしまう。ああ、感じない"}, {"type": "subtitle", "time": 19179.43, "timestamp": "05:19:39", "text": "良い。いいえ、触らないでください"}, {"type": "subtitle", "time": 19181.83, "timestamp": "05:19:41", "text": "ここ。"}, {"type": "subtitle", "time": 19185.99, "timestamp": "05:19:45", "text": "豚の皮。ああ、ちくしょう。わかった。どのように"}, {"type": "subtitle", "time": 19187.91, "timestamp": "05:19:47", "text": "私が殺す？"}, {"type": "subtitle", "time": 19189.43, "timestamp": "05:19:49", "text": "私は死ぬだろう。よし。またね"}, {"type": "subtitle", "time": 19197.59, "timestamp": "05:19:57", "text": "彼はたくさん殺せるのか？"}]
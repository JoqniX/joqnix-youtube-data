[{"type": "subtitle", "time": 4342.87, "timestamp": "01:12:22", "text": "いいえ、私は殺されました。待って、私は"}, {"type": "subtitle", "time": 4354.31, "timestamp": "01:12:34", "text": "え、何？"}, {"type": "subtitle", "time": 4371.35, "timestamp": "01:12:51", "text": "何？はぁ？"}, {"type": "subtitle", "time": 4373.51, "timestamp": "01:12:53", "text": "わかった。"}, {"type": "subtitle", "time": 4377.11, "timestamp": "01:12:57", "text": "私は自分の"}, {"type": "subtitle", "time": 4379.51, "timestamp": "01:12:59", "text": "わかった。さて、本題に入りましょう"}]
[{"type": "subtitle", "time": 16082.389, "timestamp": "04:28:02", "text": "木材を1つ入手するにはどうすればいいですか？寄付するにはどうすればいいですか？"}, {"type": "subtitle", "time": 16086.229, "timestamp": "04:28:06", "text": "木材？うん。ええと、あなたのインベントリから。全て"}, {"type": "subtitle", "time": 16087.99, "timestamp": "04:28:07", "text": "右。"}, {"type": "subtitle", "time": 16089.99, "timestamp": "04:28:09", "text": "いいえ、大丈夫です。よし。作る"}, {"type": "subtitle", "time": 16092.95, "timestamp": "04:28:12", "text": "バックパック。さあ行こう。ああ、そうだね。お尻、"}, {"type": "subtitle", "time": 16094.309, "timestamp": "04:28:14", "text": "あなたも石を持っているの？少しもらってもいいですか？"}, {"type": "subtitle", "time": 16096.55, "timestamp": "04:28:16", "text": "石？"}, {"type": "subtitle", "time": 16098.149, "timestamp": "04:28:18", "text": "ああ、それは科学実験装置ですか？する必要がある"}, {"type": "subtitle", "time": 16099.59, "timestamp": "04:28:19", "text": "バックパックを作りたいとか"}, {"type": "subtitle", "time": 16102.63, "timestamp": "04:28:22", "text": "何か。はい、どうぞ。"}, {"type": "subtitle", "time": 16105.349, "timestamp": "04:28:25", "text": "ありがとう。"}, {"type": "subtitle", "time": 16107.429, "timestamp": "04:28:27", "text": "どうすれば「ああ、くそったれ」を作れるでしょうか。なぜ"}, {"type": "subtitle", "time": 16111.269, "timestamp": "04:28:31", "text": "ここにカエルはいますか？私はそれを見ていません。"}, {"type": "subtitle", "time": 16113.11, "timestamp": "04:28:33", "text": "えっと、"}, {"type": "subtitle", "time": 16115.349, "timestamp": "04:28:35", "text": "わかった。アビゲイルにやらせればいい。怒り"}, {"type": "subtitle", "time": 16118.309, "timestamp": "04:28:38", "text": "妹。妹を怒らせる。右クリック。"}, {"type": "subtitle", "time": 16120.79, "timestamp": "04:28:40", "text": "妹を怒らせる。"}, {"type": "subtitle", "time": 16124.87, "timestamp": "04:28:44", "text": "わかった。妹を右クリックしてください。"}, {"type": "subtitle", "time": 16132.149, "timestamp": "04:28:52", "text": "よし。"}, {"type": "subtitle", "time": 16134.95, "timestamp": "04:28:54", "text": "彼女は「おい、カエルの足を持ってこい」という人だ。彼女は"}, {"type": "subtitle", "time": 16138.07, "timestamp": "04:28:58", "text": "死んだ。彼女は死んだ。わかった、"}]
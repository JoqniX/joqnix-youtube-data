[{"type": "subtitle", "time": 7321.75, "timestamp": "02:02:01", "text": "失敗。"}, {"type": "subtitle", "time": 7333.99, "timestamp": "02:02:13", "text": "その後、こっそりビーチへ行こう"}, {"type": "subtitle", "time": 7342.39, "timestamp": "02:02:22", "text": "えっと、私の言語は日本語ですよね？"}, {"type": "subtitle", "time": 7344.229, "timestamp": "02:02:24", "text": "右。"}, {"type": "subtitle", "time": 7346.55, "timestamp": "02:02:26", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 7349.109, "timestamp": "02:02:29", "text": "私は「え、何？」って感じでした。"}]
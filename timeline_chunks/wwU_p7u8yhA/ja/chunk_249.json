[{"type": "subtitle", "time": 14941.11, "timestamp": "04:09:01", "text": "妹。"}, {"type": "subtitle", "time": 14943.67, "timestamp": "04:09:03", "text": "ああ、の方へ歩いてください。わかった。私がその人です"}, {"type": "subtitle", "time": 14945.51, "timestamp": "04:09:05", "text": "つるはしで。"}, {"type": "subtitle", "time": 14947.349, "timestamp": "04:09:07", "text": "懐中電灯を消してください。私たちは"}, {"type": "subtitle", "time": 14948.229, "timestamp": "04:09:08", "text": "今は必要ありません。どこ"}, {"type": "subtitle", "time": 14949.75, "timestamp": "04:09:09", "text": "アビゲイル？"}, {"type": "subtitle", "time": 14951.91, "timestamp": "04:09:11", "text": "アビゲイルはどこ？"}, {"type": "subtitle", "time": 14954.95, "timestamp": "04:09:14", "text": "手のひらのあたりを見てください。"}, {"type": "subtitle", "time": 14965.189, "timestamp": "04:09:25", "text": "火を起こせ。忘れないで"}, {"type": "subtitle", "time": 14966.55, "timestamp": "04:09:26", "text": "これを手に取ってください。冒頭が好きです"}, {"type": "subtitle", "time": 14968.389, "timestamp": "04:09:28", "text": "一部。スズキ、これを拾ってくれ。それはただ"}, {"type": "subtitle", "time": 14971.75, "timestamp": "04:09:31", "text": "プレイ時間が長くなるほど退屈になる"}, {"type": "subtitle", "time": 14973.67, "timestamp": "04:09:33", "text": "このゲーム。"}, {"type": "subtitle", "time": 14974.95, "timestamp": "04:09:34", "text": "単調になるだけだ。なぜ私たちは"}, {"type": "subtitle", "time": 14977.67, "timestamp": "04:09:37", "text": "懐中電灯を点ける？私は合計で5年間勤務しました"}, {"type": "subtitle", "time": 14981.189, "timestamp": "04:09:41", "text": "ゲーム内で。このゲームはどうやってプレイするのですか？それはただ"}, {"type": "subtitle", "time": 14984.309, "timestamp": "04:09:44", "text": "すごく退屈になる。これ、うん、このゲーム"}, {"type": "subtitle", "time": 14985.75, "timestamp": "04:09:45", "text": "に着くとちょっと退屈になる"}, {"type": "subtitle", "time": 14988.07, "timestamp": "04:09:48", "text": "ゲームのさらに先の部分。のように"}, {"type": "subtitle", "time": 14989.99, "timestamp": "04:09:49", "text": "メガベースを作ったら、殺したように"}, {"type": "subtitle", "time": 14992.71, "timestamp": "04:09:52", "text": "上司たちの多くが。ルナナイト、"}, {"type": "subtitle", "time": 14995.349, "timestamp": "04:09:55", "text": "最終的には"}, {"type": "subtitle", "time": 14998.79, "timestamp": "04:09:58", "text": "何か用事があってモデレーターのところへ行く。うん、そうだね"}]
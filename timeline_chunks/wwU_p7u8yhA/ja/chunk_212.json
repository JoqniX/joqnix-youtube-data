[{"type": "subtitle", "time": 12722.07, "timestamp": "03:32:02", "text": "ストリーミング配信。はぁ？ Sもストリーミング配信している。"}, {"type": "subtitle", "time": 12725.429, "timestamp": "03:32:05", "text": "彼はただ歩いているだけだ。あ、待って。"}, {"type": "subtitle", "time": 12728.79, "timestamp": "03:32:08", "text": "まったく役に立たない。更新する必要があるかもしれません"}, {"type": "subtitle", "time": 12731.51, "timestamp": "03:32:11", "text": "中空の甲板ですね。ソサンが"}, {"type": "subtitle", "time": 12734.55, "timestamp": "03:32:14", "text": "実は男性だったの？"}, {"type": "subtitle", "time": 12736.71, "timestamp": "03:32:16", "text": "いいえ、それは違います。"}, {"type": "subtitle", "time": 12741.19, "timestamp": "03:32:21", "text": "我が神よ。実際にはボインボインがあり、"}, {"type": "subtitle", "time": 12750.229, "timestamp": "03:32:30", "text": "10インチの白鳥がいます"}, {"type": "subtitle", "time": 12753.11, "timestamp": "03:32:33", "text": "戻る。どのくらいの期間ですか？ああ、大変だ。"}, {"type": "subtitle", "time": 12755.59, "timestamp": "03:32:35", "text": "誓って言うけど、私はいつも最悪のタイミングで戻ってきてしまうんだ。"}, {"type": "subtitle", "time": 12758.63, "timestamp": "03:32:38", "text": "もしそれが３未満で、"}, {"type": "subtitle", "time": 12765.91, "timestamp": "03:32:45", "text": "何を期待していたんだ？何をしたの？"}, {"type": "subtitle", "time": 12768.95, "timestamp": "03:32:48", "text": "期待する？もう分からない。私は"}, {"type": "subtitle", "time": 12771.59, "timestamp": "03:32:51", "text": "試している。これは予想しておくべきだった"}, {"type": "subtitle", "time": 12773.03, "timestamp": "03:32:53", "text": "あなたが全員と話していることを考えると"}, {"type": "subtitle", "time": 12777.51, "timestamp": "03:32:57", "text": "私たち。ええ、それは本当です。ああ、大変だ。これは"}]
[{"type": "subtitle", "time": 12662.229, "timestamp": "03:31:02", "text": "信じられない、そんなことを言うなんて。それは"}, {"type": "subtitle", "time": 12665.429, "timestamp": "03:31:05", "text": "おぞましい。それは面白くない。"}, {"type": "subtitle", "time": 12670.469, "timestamp": "03:31:10", "text": "それは面白くないと言うが、誰かが"}, {"type": "subtitle", "time": 12672.309, "timestamp": "03:31:12", "text": "「来い」と言うのは最高に素晴らしい"}, {"type": "subtitle", "time": 12676.229, "timestamp": "03:31:16", "text": "私にとっては、めちゃくちゃ面白い。"}, {"type": "subtitle", "time": 12683.51, "timestamp": "03:31:23", "text": "ああ、じゃあ全員参加ってことですね？はい。おお、"}, {"type": "subtitle", "time": 12686.87, "timestamp": "03:31:26", "text": "うん。はい。はい。私たちはしなければならない 私たちはしなければならない 私たちはしなければならない 私たちは"}, {"type": "subtitle", "time": 12689.269, "timestamp": "03:31:29", "text": "新しい"}, {"type": "subtitle", "time": 12693.59, "timestamp": "03:31:33", "text": "キャラクター。はい。ちょっと待ってください。"}, {"type": "subtitle", "time": 12696.87, "timestamp": "03:31:36", "text": "わかった。ラグが発生しないことを願います。よし。"}, {"type": "subtitle", "time": 12699.19, "timestamp": "03:31:39", "text": "だって私は16ギガのRAMで動いてないから"}, {"type": "subtitle", "time": 12707.99, "timestamp": "03:31:47", "text": "やあ、8ギガのRAMを使っている仲間よ。よし、8ギガのRAMだ。おい"}, {"type": "subtitle", "time": 12711.62, "timestamp": "03:31:51", "text": "8ギガRAM派。ギグ。"}, {"type": "subtitle", "time": 12719.51, "timestamp": "03:31:59", "text": "あ、そういえば。ウ・ジョセンもまた"}]
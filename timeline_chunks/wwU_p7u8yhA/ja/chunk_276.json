[{"type": "subtitle", "time": 16561.029, "timestamp": "04:36:01", "text": "私はあなたの足跡を辿っています。"}, {"type": "subtitle", "time": 16563.189, "timestamp": "04:36:03", "text": "ああ、あなたの道具は持っていますよ。実際には"}, {"type": "subtitle", "time": 16565.91, "timestamp": "04:36:05", "text": "適切な土台を作る。さあ、行くぞ。"}, {"type": "subtitle", "time": 16570.15, "timestamp": "04:36:10", "text": "さあ行こう。ああ、それは実際"}, {"type": "subtitle", "time": 16572.629, "timestamp": "04:36:12", "text": "いや、いや、彼は私に道具をくれ。必要"}, {"type": "subtitle", "time": 16575.83, "timestamp": "04:36:15", "text": "斧から生き延びる。"}, {"type": "subtitle", "time": 16588.709, "timestamp": "04:36:28", "text": "私は理性を失った。くたばれ。そこには"}, {"type": "subtitle", "time": 16590.15, "timestamp": "04:36:30", "text": "しかし、ここにはたくさんのクモの巣がある。私"}, {"type": "subtitle", "time": 16591.99, "timestamp": "04:36:31", "text": "できるかどうかわからない、ちょっと忘れちゃった"}, {"type": "subtitle", "time": 16594.07, "timestamp": "04:36:34", "text": "クモの巣みたいに始める方法"}, {"type": "subtitle", "time": 16595.59, "timestamp": "04:36:35", "text": "魔法。餌をあげなきゃいけないと思う"}, {"type": "subtitle", "time": 16598.31, "timestamp": "04:36:38", "text": "彼らのうちの。ツールをクリックしてから"}, {"type": "subtitle", "time": 16601.109, "timestamp": "04:36:41", "text": "そのうちの1人に餌をあげて、偽物"}, {"type": "subtitle", "time": 16603.349, "timestamp": "04:36:43", "text": "攻撃を仕掛ける。だから私は"}, {"type": "subtitle", "time": 16609.109, "timestamp": "04:36:49", "text": "私は祈ります。私は"}, {"type": "subtitle", "time": 16610.949, "timestamp": "04:36:50", "text": "お祈りに行きます。"}, {"type": "subtitle", "time": 16612.709, "timestamp": "04:36:52", "text": "もっと欲しいから、指を交差させて祈ってる"}, {"type": "subtitle", "time": 16616.949, "timestamp": "04:36:56", "text": "肉。もっと肉が必要だ。ああ、わかりました。はい。"}, {"type": "subtitle", "time": 16619.51, "timestamp": "04:36:59", "text": "通常は1匹で3匹を飼いならしますが、"}]
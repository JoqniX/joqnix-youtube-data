[{"type": "subtitle", "time": 13320.63, "timestamp": "03:42:00", "text": "皆さんはWToxを持っていないと思うので、"}, {"type": "subtitle", "time": 13322.07, "timestamp": "03:42:02", "text": "それは飛ばします。ワームウッドは飛ばします。"}, {"type": "subtitle", "time": 13325.11, "timestamp": "03:42:05", "text": "仕事をサボります。ウォルター。"}, {"type": "subtitle", "time": 13327.75, "timestamp": "03:42:07", "text": "彼は私が楽しんでいる"}, {"type": "subtitle", "time": 13329.67, "timestamp": "03:42:09", "text": "クソみたいなパチンコだ。唯一の良い"}, {"type": "subtitle", "time": 13332.87, "timestamp": "03:42:12", "text": "ゲーム内の遠距離武器と、"}, {"type": "subtitle", "time": 13335.67, "timestamp": "03:42:15", "text": "大きな姿に変身できるペットの犬"}, {"type": "subtitle", "time": 13338.15, "timestamp": "03:42:18", "text": "乗り回せる犬。"}, {"type": "subtitle", "time": 13339.99, "timestamp": "03:42:19", "text": "うんうん。そして、もしあなたが打たれたら、あなたは"}, {"type": "subtitle", "time": 13341.67, "timestamp": "03:42:21", "text": "非常識な。"}, {"type": "subtitle", "time": 13343.349, "timestamp": "03:42:23", "text": "だから、遠距離攻撃をしなければならない"}, {"type": "subtitle", "time": 13345.269, "timestamp": "03:42:25", "text": "キャラクター。そして、誰かが"}, {"type": "subtitle", "time": 13349.51, "timestamp": "03:42:29", "text": "ワンダがいるけど、ワンダはただの時間の[ __ ]だ。"}, {"type": "subtitle", "time": 13352.63, "timestamp": "03:42:32", "text": "お前の毒を選んでやるよ、[ __ ]。ワンダ。全て"}, {"type": "subtitle", "time": 13354.79, "timestamp": "03:42:34", "text": "右。よし。やあ、レオナルド。全て"}, {"type": "subtitle", "time": 13358.469, "timestamp": "03:42:38", "text": "右。よし。さあ行こう。さあ行こう。私"}, {"type": "subtitle", "time": 13361.03, "timestamp": "03:42:41", "text": "キャラクターを選ばないといけないよね？"}, {"type": "subtitle", "time": 13362.79, "timestamp": "03:42:42", "text": "ああ、ジェイソン、心配しないで。それを説明する"}, {"type": "subtitle", "time": 13364.87, "timestamp": "03:42:44", "text": "完全にやろうとすると、あまりにも時間がかかりすぎる。病気"}, {"type": "subtitle", "time": 13367.03, "timestamp": "03:42:47", "text": "なれ"}, {"type": "subtitle", "time": 13369.91, "timestamp": "03:42:49", "text": "よし。あなたには立場がある。"}, {"type": "subtitle", "time": 13373.59, "timestamp": "03:42:53", "text": "僕もビッグ・フレッドになれる？ええ、もちろんです。あなたはできる"}, {"type": "subtitle", "time": 13376.15, "timestamp": "03:42:56", "text": "クソみたいな老害野郎め。"}, {"type": "subtitle", "time": 13378.15, "timestamp": "03:42:58", "text": "よし。ああ、アークはロボットです。"}, {"type": "subtitle", "time": 13379.67, "timestamp": "03:42:59", "text": "Who's Who は、私が"}]
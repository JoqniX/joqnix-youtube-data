[{"type": "subtitle", "time": 14885.429, "timestamp": "04:08:05", "text": "走る。"}, {"type": "subtitle", "time": 14887.349, "timestamp": "04:08:07", "text": "これはズキだと思うんだけど。わからない"}, {"type": "subtitle", "time": 14888.87, "timestamp": "04:08:08", "text": "これは誰の花ですか？なぜ"}, {"type": "subtitle", "time": 14890.71, "timestamp": "04:08:10", "text": "アビゲイルの花が床に落ちている？誰が"}, {"type": "subtitle", "time": 14897.99, "timestamp": "04:08:17", "text": "防具を手に入れろ。やり方を学ぶ前に手に入れないでください"}, {"type": "subtitle", "time": 14899.75, "timestamp": "04:08:19", "text": "避けたり、いろいろと。わかった。初心者は"}, {"type": "subtitle", "time": 14902.15, "timestamp": "04:08:22", "text": "アーマーファーストの学習方法"}, {"type": "subtitle", "time": 14904.15, "timestamp": "04:08:24", "text": "防具の入手方法がわからない。"}, {"type": "subtitle", "time": 14906.63, "timestamp": "04:08:26", "text": "ええ、分かりません。"}, {"type": "subtitle", "time": 14908.229, "timestamp": "04:08:28", "text": "初心者に学習を期待することはできません"}, {"type": "subtitle", "time": 14911.189, "timestamp": "04:08:31", "text": "もの。それは時間がかかるプロセスです。ゆっくりと"}, {"type": "subtitle", "time": 14913.349, "timestamp": "04:08:33", "text": "プロセス。このゲームは本当に"}, {"type": "subtitle", "time": 14920.07, "timestamp": "04:08:40", "text": "ああ、光源を作って、"}, {"type": "subtitle", "time": 14922.71, "timestamp": "04:08:42", "text": "500時間。"}, {"type": "subtitle", "time": 14924.389, "timestamp": "04:08:44", "text": "しまった、気づかなかった。待って、"}, {"type": "subtitle", "time": 14927.11, "timestamp": "04:08:47", "text": "スズキさん、これはあなたの花ですか？さて、"}, {"type": "subtitle", "time": 14931.189, "timestamp": "04:08:51", "text": "花？鈴木の花。花をつかむ"}, {"type": "subtitle", "time": 14932.95, "timestamp": "04:08:52", "text": "立つ。それはあなたの"}, {"type": "subtitle", "time": 14934.55, "timestamp": "04:08:54", "text": "クソ妹。うん。いいえ。降りてきてください。"}, {"type": "subtitle", "time": 14936.55, "timestamp": "04:08:56", "text": "降りてくる。あなたの立場は？鈴木。私"}, {"type": "subtitle", "time": 14939.269, "timestamp": "04:08:59", "text": "コインを手に入れた。ろくでなし。あなたは忘れました"}]
[{"type": "subtitle", "time": 12841.11, "timestamp": "03:34:01", "text": "この行？"}, {"type": "subtitle", "time": 12844.389, "timestamp": "03:34:04", "text": "それを私にください。それは何ですか？ああ、大変だ。"}, {"type": "subtitle", "time": 12854.45, "timestamp": "03:34:14", "text": "お願いします"}, {"type": "subtitle", "time": 12861.11, "timestamp": "03:34:21", "text": "[音楽]"}, {"type": "subtitle", "time": 12864.309, "timestamp": "03:34:24", "text": "私は本当に良いものが嫌いだ。うん。何"}, {"type": "subtitle", "time": 12866.229, "timestamp": "03:34:26", "text": "変人？"}, {"type": "subtitle", "time": 12879.349, "timestamp": "03:34:39", "text": "これは私たちのシリーズではありません。私たちは"}, {"type": "subtitle", "time": 12889.75, "timestamp": "03:34:49", "text": "それは素晴らしい自己紹介だ。ゴエン。うん。それで、"}, {"type": "subtitle", "time": 12891.349, "timestamp": "03:34:51", "text": "行く。"}, {"type": "subtitle", "time": 12892.87, "timestamp": "03:34:52", "text": "いや。"}, {"type": "subtitle", "time": 12896.87, "timestamp": "03:34:56", "text": "わかったよ、ジョス。オーケー、"}, {"type": "subtitle", "time": 12899.59, "timestamp": "03:34:59", "text": "お願いです。"}]
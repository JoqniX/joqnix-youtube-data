[{"type": "subtitle", "time": 11762.07, "timestamp": "03:16:02", "text": "r/1x familiar は兄弟の名前です。"}, {"type": "subtitle", "time": 11765.269, "timestamp": "03:16:05", "text": "サイドパネルには、"}, {"type": "subtitle", "time": 11768.07, "timestamp": "03:16:08", "text": "Googleカレンダー関連のものもね。それは、それは"}, {"type": "subtitle", "time": 11770.79, "timestamp": "03:16:10", "text": "番組の配信スケジュールみたいなもの。それで、"}, {"type": "subtitle", "time": 11775.429, "timestamp": "03:16:15", "text": "はい、投稿する予定です。"}, {"type": "subtitle", "time": 11777.19, "timestamp": "03:16:17", "text": "のように"}, {"type": "subtitle", "time": 11782.95, "timestamp": "03:16:22", "text": "Redditでも配信するときは"}, {"type": "subtitle", "time": 11785.59, "timestamp": "03:16:25", "text": "むしろ、ファミリアが"}, {"type": "subtitle", "time": 11787.51, "timestamp": "03:16:27", "text": "Redditにログインすると通知を受け取ることができます"}, {"type": "subtitle", "time": 11790.15, "timestamp": "03:16:30", "text": "そういう感じがいい。そう、私は"}, {"type": "subtitle", "time": 11792.07, "timestamp": "03:16:32", "text": "試してみようかな。私はそうしないかもしれない"}, {"type": "subtitle", "time": 11794.07, "timestamp": "03:16:34", "text": "将来的に行うか、あるいはそのままにしておくか"}, {"type": "subtitle", "time": 11796.229, "timestamp": "03:16:36", "text": "そんな感じ。わからない。場合によります。こんにちは。"}, {"type": "subtitle", "time": 11799.75, "timestamp": "03:16:39", "text": "そして来週以降は、えーと"}, {"type": "subtitle", "time": 11802.63, "timestamp": "03:16:42", "text": "新しいものを試している"}, {"type": "subtitle", "time": 11806.55, "timestamp": "03:16:46", "text": "ストリームにもっと多くの人に来てもらうために"}, {"type": "subtitle", "time": 11809.03, "timestamp": "03:16:49", "text": "それと、Twitterでの投稿。私は作ります"}, {"type": "subtitle", "time": 11813.91, "timestamp": "03:16:53", "text": "30秒くらいの短いもの、えーっと30秒"}, {"type": "subtitle", "time": 11817.269, "timestamp": "03:16:57", "text": "2秒または1分間のビデオのようなもの"}, {"type": "subtitle", "time": 11819.11, "timestamp": "03:16:59", "text": "今日。今はただ立ち去ります"}]
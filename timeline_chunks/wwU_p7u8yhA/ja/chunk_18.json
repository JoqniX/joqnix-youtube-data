[{"type": "subtitle", "time": 1081.19, "timestamp": "00:18:01", "text": "実際はそうだけど。ああ、彼らはまるで"}, {"type": "subtitle", "time": 1084.789, "timestamp": "00:18:04", "text": "今、私に惹かれている。"}, {"type": "subtitle", "time": 1086.549, "timestamp": "00:18:06", "text": "聖なる。"}, {"type": "subtitle", "time": 1091.27, "timestamp": "00:18:11", "text": "私は日の出を待ったのだろうか？"}, {"type": "subtitle", "time": 1093.99, "timestamp": "00:18:13", "text": "少なくともそれくらいはできると思う。いいえ、私は"}, {"type": "subtitle", "time": 1117.669, "timestamp": "00:18:37", "text": "ちょっと水を飲ませてください。待って。"}, {"type": "subtitle", "time": 1120.07, "timestamp": "00:18:40", "text": "また、皆さん水分補給をしっかりしてください。忘れないでください"}, {"type": "subtitle", "time": 1121.75, "timestamp": "00:18:41", "text": "水和"}]
[{"type": "subtitle", "time": 3302.549, "timestamp": "00:55:02", "text": "ああ、たくさんの"}, {"type": "subtitle", "time": 3304.87, "timestamp": "00:55:04", "text": "ゲームプレイやその他いろいろなもの"}, {"type": "subtitle", "time": 3309.51, "timestamp": "00:55:09", "text": "彼女。おお。とっても可愛いですね。"}, {"type": "subtitle", "time": 3312.87, "timestamp": "00:55:12", "text": "ああ、これがウィンストン・ザ・ソー"}, {"type": "subtitle", "time": 3315.27, "timestamp": "00:55:15", "text": "これはExcuseがプレイしている曲か何かです。"}, {"type": "subtitle", "time": 3319.51, "timestamp": "00:55:19", "text": "右？彼は言い​​訳を"}, {"type": "subtitle", "time": 3323.03, "timestamp": "00:55:23", "text": "えっと、言い訳にはウィンストンみたいな顔がある"}, {"type": "subtitle", "time": 3326.47, "timestamp": "00:55:26", "text": "ロゴみたいですよね？"}, {"type": "subtitle", "time": 3328.069, "timestamp": "00:55:28", "text": "くそ、"}, {"type": "subtitle", "time": 3352.789, "timestamp": "00:55:52", "text": "さあ行こう。こんにちは。始める前に、1つ"}, {"type": "subtitle", "time": 3355.27, "timestamp": "00:55:55", "text": "もっと何か。中に入ることができなかったので"}, {"type": "subtitle", "time": 3359.589, "timestamp": "00:55:59", "text": "ゲームでは、私はできませんでした。"}]
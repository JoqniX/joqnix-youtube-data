[{"type": "subtitle", "time": 19441.59, "timestamp": "05:24:01", "text": "箱の中に食べ物が入っている。"}, {"type": "subtitle", "time": 19443.51, "timestamp": "05:24:03", "text": "ああ、宝箱の中にも食べ物が入っているんですね。"}, {"type": "subtitle", "time": 19446.39, "timestamp": "05:24:06", "text": "私は死んだ。私が残している唯一の食べ物は"}, {"type": "subtitle", "time": 19450.31, "timestamp": "05:24:10", "text": "まるで怪物の肉のようだ。それで、"}, {"type": "subtitle", "time": 19452.59, "timestamp": "05:24:12", "text": "あなたはできません"}, {"type": "subtitle", "time": 19466.868, "timestamp": "05:24:26", "text": "ここから事態は急展開を迎える。乗り越える"}, {"type": "subtitle", "time": 19471.83, "timestamp": "05:24:31", "text": "ここ。これで終わりだ。いや、いや。こっちへ来なさい。"}, {"type": "subtitle", "time": 19474.55, "timestamp": "05:24:34", "text": "こっちへ来い。こっちへ来い。乗り越える"}, {"type": "subtitle", "time": 19477.51, "timestamp": "05:24:37", "text": "ここ。こっちへ来い。彼を捕まえろ。彼は"}, {"type": "subtitle", "time": 19479.83, "timestamp": "05:24:39", "text": "走っている。彼を捕まえろ。彼を捕まえろ。私は"}, {"type": "subtitle", "time": 19481.27, "timestamp": "05:24:41", "text": "アイデア。いい考えがある。私はアイデアがあります"}, {"type": "subtitle", "time": 19484.15, "timestamp": "05:24:44", "text": "皆さんにとってうまくいく方法。"}, {"type": "subtitle", "time": 19485.83, "timestamp": "05:24:45", "text": "彼を捕まえろ。彼を捕まえろ。彼を捕まえろ。彼を捕まえろ。得る"}, {"type": "subtitle", "time": 19489.67, "timestamp": "05:24:49", "text": "彼。彼が接続を切断したら、誓って言うよ。なんてこった。"}, {"type": "subtitle", "time": 19491.43, "timestamp": "05:24:51", "text": "彼を捕まえろ。彼を捕まえろ。彼を捕まえろ。彼を捕まえろ。"}, {"type": "subtitle", "time": 19494.868, "timestamp": "05:24:54", "text": "あなたは私のことを理解していない。"}]
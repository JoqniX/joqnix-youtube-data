[{"type": "subtitle", "time": 8170.85, "timestamp": "02:16:10", "text": "私はできませんでした。"}, {"type": "subtitle", "time": 8173.109, "timestamp": "02:16:13", "text": "[音楽]"}, {"type": "subtitle", "time": 8176.31, "timestamp": "02:16:16", "text": "あの侍の男が私の前に割り込んできた。おお"}, {"type": "subtitle", "time": 8178.95, "timestamp": "02:16:18", "text": "我が神よ。"}, {"type": "subtitle", "time": 8181.75, "timestamp": "02:16:21", "text": "あのね？"}, {"type": "subtitle", "time": 8183.589, "timestamp": "02:16:23", "text": "俺はこの男を操作して、彼を叩きのめす"}, {"type": "subtitle", "time": 8186.069, "timestamp": "02:16:26", "text": "下。"}, {"type": "subtitle", "time": 8188.069, "timestamp": "02:16:28", "text": "なんてこった、"}, {"type": "subtitle", "time": 8203.39, "timestamp": "02:16:43", "text": "必要ない"}, {"type": "subtitle", "time": 8206.389, "timestamp": "02:16:46", "text": "[音楽]"}]
[{"type": "subtitle", "time": 16681.349, "timestamp": "04:38:01", "text": "だって私は、えっと、私は、と思う"}, {"type": "subtitle", "time": 16683.67, "timestamp": "04:38:03", "text": "三つ"}, {"type": "subtitle", "time": 16686.789, "timestamp": "04:38:06", "text": "斧を作らなければならない"}, {"type": "subtitle", "time": 16688.31, "timestamp": "04:38:08", "text": "ヒーリング。基地に戻ってきて、だって私はできるから"}, {"type": "subtitle", "time": 16690.869, "timestamp": "04:38:10", "text": "ただあなたを癒してください。ああ、また戻ってきます"}, {"type": "subtitle", "time": 16693.59, "timestamp": "04:38:13", "text": "ベース。私のキャラクターも忘れていました"}, {"type": "subtitle", "time": 16698.709, "timestamp": "04:38:18", "text": "サポートキャラクター。はい、すべてのえーと"}, {"type": "subtitle", "time": 16700.39, "timestamp": "04:38:20", "text": "つまり、レネ、私は治癒が必要になるだろう"}, {"type": "subtitle", "time": 16702.789, "timestamp": "04:38:22", "text": "道。私のHPは半分です。できれば、"}, {"type": "subtitle", "time": 16705.59, "timestamp": "04:38:25", "text": "私は戻ってクモを探します"}, {"type": "subtitle", "time": 16706.949, "timestamp": "04:38:26", "text": "なぜなら彼らは多くのものを殺しているから"}, {"type": "subtitle", "time": 16709.029, "timestamp": "04:38:29", "text": "くそっ。"}, {"type": "subtitle", "time": 16711.349, "timestamp": "04:38:31", "text": "ええ、モンスターは食べられますよ"}, {"type": "subtitle", "time": 16713.99, "timestamp": "04:38:33", "text": "クモを殺す。念のため確認しておいてください。うん、"}, {"type": "subtitle", "time": 16716.07, "timestamp": "04:38:36", "text": "食事の際はHPに注意してください"}, {"type": "subtitle", "time": 16718.551, "timestamp": "04:38:38", "text": "モンスター。君たちはどこにいるの？なぜならそれは"}, {"type": "subtitle", "time": 16720.949, "timestamp": "04:38:40", "text": "HPを消耗させる"}, {"type": "subtitle", "time": 16723.83, "timestamp": "04:38:43", "text": "そして、正気をいくらか奪ってしまう。レネ、私は"}, {"type": "subtitle", "time": 16726.709, "timestamp": "04:38:46", "text": "あなたのもとへ行くよ。 HPが必要だ。やって来る"}, {"type": "subtitle", "time": 16732.47, "timestamp": "04:38:52", "text": "ああ、その魂をくれ。私たちは"}, {"type": "subtitle", "time": 16734.551, "timestamp": "04:38:54", "text": "ここ。"}, {"type": "subtitle", "time": 16738.629, "timestamp": "04:38:58", "text": "どこにいるの？赤字だよ、ベイビー。"}]
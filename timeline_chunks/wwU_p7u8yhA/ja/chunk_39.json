[{"type": "subtitle", "time": 2366.39, "timestamp": "00:39:26", "text": "私はここにたどり着くことができたとは思っていませんでした"}, {"type": "subtitle", "time": 2371.99, "timestamp": "00:39:31", "text": "いつでも何としても、今回は"}, {"type": "subtitle", "time": 2383.829, "timestamp": "00:39:43", "text": "こんにちは。それで、あのツイートは、私は"}, {"type": "subtitle", "time": 2386.87, "timestamp": "00:39:46", "text": "ストリームルームを作りました。"}, {"type": "subtitle", "time": 2388.95, "timestamp": "00:39:48", "text": "私はツイートしていません、私はツイートしました。はい、ツイートしました"}, {"type": "subtitle", "time": 2393.589, "timestamp": "00:39:53", "text": "Twitterで。私はDiscordでそれをやりました。"}, {"type": "subtitle", "time": 2397.19, "timestamp": "00:39:57", "text": "インスタグラムやフェイスブックのストーリー機能もね。"}, {"type": "subtitle", "time": 2399.589, "timestamp": "00:39:59", "text": "わかった。なぜRedditを始めたのですか？私は思う"}]
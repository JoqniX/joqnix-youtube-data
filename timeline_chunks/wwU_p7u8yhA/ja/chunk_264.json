[{"type": "subtitle", "time": 15841.03, "timestamp": "04:24:01", "text": "ええ、問題はディックスがどこにいるかということです。"}, {"type": "subtitle", "time": 15843.99, "timestamp": "04:24:03", "text": "ああ、彼は私のすぐそばにいるよ。私は手に入れた"}, {"type": "subtitle", "time": 15845.44, "timestamp": "04:24:05", "text": "復活した。"}, {"type": "subtitle", "time": 15847.349, "timestamp": "04:24:07", "text": "[音楽]"}, {"type": "subtitle", "time": 15851.269, "timestamp": "04:24:11", "text": "はい、あなたはいい人ですね。おかえり。"}, {"type": "subtitle", "time": 15853.99, "timestamp": "04:24:13", "text": "おかえり。忘れないでください いいえ、忘れないでください"}, {"type": "subtitle", "time": 15855.429, "timestamp": "04:24:15", "text": "もう一度死ぬ。"}, {"type": "subtitle", "time": 15857.189, "timestamp": "04:24:17", "text": "はい、私は死にません。私はあなたと一緒にいます"}, {"type": "subtitle", "time": 15859.349, "timestamp": "04:24:19", "text": "みんな、食べ物が必要なら、僕がいくつか手に入れるから"}, {"type": "subtitle", "time": 15861.269, "timestamp": "04:24:21", "text": "残り物。必要であれば「いいね」を押してください。私"}, {"type": "subtitle", "time": 15864.07, "timestamp": "04:24:24", "text": "持ち物がいっぱいです。ああ、できるよ"}, {"type": "subtitle", "time": 15865.99, "timestamp": "04:24:25", "text": "少し落としてください。私が預かっておきますね。これ"}, {"type": "subtitle", "time": 15871.11, "timestamp": "04:24:31", "text": "ちょっとありきたりだけど、まあいいか。わかった。"}, {"type": "subtitle", "time": 15874.309, "timestamp": "04:24:34", "text": "私も一緒にいます。食べ物は食べ物だ。わかった。えっと"}, {"type": "subtitle", "time": 15875.91, "timestamp": "04:24:35", "text": "石と金が必要だ。神に誓って、"}, {"type": "subtitle", "time": 15879.189, "timestamp": "04:24:39", "text": "金は見つからなかった。私は持っている"}, {"type": "subtitle", "time": 15881.75, "timestamp": "04:24:41", "text": "ニース。勃起した。だから、"}, {"type": "subtitle", "time": 15883.189, "timestamp": "04:24:43", "text": "君たちがどこにいるのかさえ知らないよ。 30"}, {"type": "subtitle", "time": 15886.149, "timestamp": "04:24:46", "text": "木材。 31 木材、そして彼らは私たちについて来ない"}, {"type": "subtitle", "time": 15888.229, "timestamp": "04:24:48", "text": "豚の村。いいえ、私は私は"}, {"type": "subtitle", "time": 15890.389, "timestamp": "04:24:50", "text": "ハンハンは今まさにそうで、ああ、そうだね。ハン、ただ"}, {"type": "subtitle", "time": 15892.79, "timestamp": "04:24:52", "text": "彼を連れ戻してあげて。うん。あ、待って。大きな"}]
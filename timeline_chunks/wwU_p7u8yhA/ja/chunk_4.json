[{"type": "subtitle", "time": 245.27, "timestamp": "00:04:05", "text": "でも、ちょっと待ってください。なぜこれが機能しないのですか？"}, {"type": "subtitle", "time": 248.149, "timestamp": "00:04:08", "text": "はい、起動しました。ついに。だから私たちは"}, {"type": "subtitle", "time": 251.67, "timestamp": "00:04:11", "text": "これは消えてなくなってくれ。"}, {"type": "subtitle", "time": 260.069, "timestamp": "00:04:20", "text": "待って、それは別のやつだ。これです"}, {"type": "subtitle", "time": 262.71, "timestamp": "00:04:22", "text": "ついに"}, {"type": "subtitle", "time": 275.43, "timestamp": "00:04:35", "text": "何てことだ。はい、どうぞ。"}, {"type": "subtitle", "time": 278.19, "timestamp": "00:04:38", "text": "待って、"}, {"type": "subtitle", "time": 286.95, "timestamp": "00:04:46", "text": "[音楽]"}, {"type": "subtitle", "time": 288.79, "timestamp": "00:04:48", "text": "私が見える？"}, {"type": "subtitle", "time": 292.55, "timestamp": "00:04:52", "text": "待って、なぜ？なぜ？私には体がない。私は"}, {"type": "subtitle", "time": 295.189, "timestamp": "00:04:55", "text": "待って、待って、待って、待って。"}]
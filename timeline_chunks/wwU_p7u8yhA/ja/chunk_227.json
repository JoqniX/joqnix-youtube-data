[{"type": "subtitle", "time": 13620.15, "timestamp": "03:47:00", "text": "ああ、なんてことだ。ゲームをしているから、"}, {"type": "subtitle", "time": 13621.83, "timestamp": "03:47:01", "text": "人生において、物事が思い通りに進まないことはよくある。"}, {"type": "subtitle", "time": 13624.07, "timestamp": "03:47:04", "text": "うん。来て。まるでFEストリームがないみたいだ"}, {"type": "subtitle", "time": 13626.07, "timestamp": "03:47:06", "text": "傷なし。フィーチャーストリームとは何ですか？"}, {"type": "subtitle", "time": 13629.429, "timestamp": "03:47:09", "text": "傷なし？スカッフが最高だ。"}, {"type": "subtitle", "time": 13631.59, "timestamp": "03:47:11", "text": "うん。正しい方法なんてない。その"}, {"type": "subtitle", "time": 13634.55, "timestamp": "03:47:14", "text": "コンテンツ。来て。それはコンテンツです。"}, {"type": "subtitle", "time": 13636.87, "timestamp": "03:47:16", "text": "まずは牛の話から始めましょう"}, {"type": "subtitle", "time": 13640.15, "timestamp": "03:47:20", "text": "そして今は接続の問題が発生しています。"}, {"type": "subtitle", "time": 13642.469, "timestamp": "03:47:22", "text": "これまで見てきた、特徴のないあらゆる流れ。これ"}, {"type": "subtitle", "time": 13645.269, "timestamp": "03:47:25", "text": "なんだか気分が良くなった。では、誰が"}, {"type": "subtitle", "time": 13659.67, "timestamp": "03:47:39", "text": "あるいは何でもいい。ところで、あなたの名前を読んでください。"}, {"type": "subtitle", "time": 13661.75, "timestamp": "03:47:41", "text": "ようこそ。"}, {"type": "subtitle", "time": 13665.83, "timestamp": "03:47:45", "text": "皆さん、こんにちは。いらっしゃいませ。"}, {"type": "subtitle", "time": 13675.91, "timestamp": "03:47:55", "text": "私は何歳ですか？"}, {"type": "subtitle", "time": 13677.67, "timestamp": "03:47:57", "text": "私たち全員が自問する質問"}, {"type": "subtitle", "time": 13679.67, "timestamp": "03:47:59", "text": "毎日。私たち全員が抱く疑問"}]
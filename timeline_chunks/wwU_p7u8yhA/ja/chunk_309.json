[{"type": "subtitle", "time": 18541.91, "timestamp": "05:09:01", "text": "ああ、少し編集すればいいかもしれませんね。あなた"}, {"type": "subtitle", "time": 18544.788, "timestamp": "05:09:04", "text": "おそらく"}, {"type": "subtitle", "time": 18548.23, "timestamp": "05:09:08", "text": "わかった。あらら。了解しました。なぜ豚は"}, {"type": "subtitle", "time": 18554.868, "timestamp": "05:09:14", "text": "[音楽]"}, {"type": "subtitle", "time": 18563.19, "timestamp": "05:09:23", "text": "もう、あなたのことが大嫌い。あなたはひどい人だ。そこには"}, {"type": "subtitle", "time": 18565.43, "timestamp": "05:09:25", "text": "あなたが行く。"}, {"type": "subtitle", "time": 18568.948, "timestamp": "05:09:28", "text": "私はああ、いい人になるのが大好きです"}, {"type": "subtitle", "time": 18572.47, "timestamp": "05:09:32", "text": "蛙。くそ。それが私のフェチだった。私は"}, {"type": "subtitle", "time": 18575.67, "timestamp": "05:09:35", "text": "ごめん。私のフェチ"}, {"type": "subtitle", "time": 18579.83, "timestamp": "05:09:39", "text": "石。うん。えっと、"}, {"type": "subtitle", "time": 18581.59, "timestamp": "05:09:41", "text": "ここはまだ何もありません。私は好きになる必要がある"}, {"type": "subtitle", "time": 18584.31, "timestamp": "05:09:44", "text": "基地に戻る。ええ、ありません。私"}, {"type": "subtitle", "time": 18585.83, "timestamp": "05:09:45", "text": "彼らができるとは思えない"}, {"type": "subtitle", "time": 18586.868, "timestamp": "05:09:46", "text": "何でも。彼らは恐らく"}, {"type": "subtitle", "time": 18588.55, "timestamp": "05:09:48", "text": "備蓄する。"}, {"type": "subtitle", "time": 18590.628, "timestamp": "05:09:50", "text": "うん。何もない。あなたはただ"}, {"type": "subtitle", "time": 18592.23, "timestamp": "05:09:52", "text": "待って。つまり、あなたはただ"}, {"type": "subtitle", "time": 18593.67, "timestamp": "05:09:53", "text": "いつも、ほら、ただ手に入れるだけ"}, {"type": "subtitle", "time": 18596.15, "timestamp": "05:09:56", "text": "資源は、冬を迎える。しかし"}, {"type": "subtitle", "time": 18597.83, "timestamp": "05:09:57", "text": "しかし、彼らはやり方を知らない。"}]
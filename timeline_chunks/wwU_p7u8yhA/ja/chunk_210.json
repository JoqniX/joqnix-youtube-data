[{"type": "subtitle", "time": 12617.51, "timestamp": "03:30:17", "text": "ああ、大変だ。これは本当に難しい。"}, {"type": "subtitle", "time": 12619.19, "timestamp": "03:30:19", "text": "はい。"}, {"type": "subtitle", "time": 12626.87, "timestamp": "03:30:26", "text": "犬って本当にたくさん喋るよね。"}, {"type": "subtitle", "time": 12632.469, "timestamp": "03:30:32", "text": "ああ、なんてことだ、彼は損をしている。"}, {"type": "subtitle", "time": 12636.55, "timestamp": "03:30:36", "text": "うん。こんにちは。うん。それらはすべて緊張によるものです。"}, {"type": "subtitle", "time": 12647.349, "timestamp": "03:30:47", "text": "クソ野郎ども。いいえ、"}, {"type": "subtitle", "time": 12649.75, "timestamp": "03:30:49", "text": "お前から搾り取るんだ。"}, {"type": "subtitle", "time": 12652.469, "timestamp": "03:30:52", "text": "あなたはしない"}]
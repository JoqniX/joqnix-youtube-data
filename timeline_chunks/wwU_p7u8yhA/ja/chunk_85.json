[{"type": "subtitle", "time": 5104.39, "timestamp": "01:25:04", "text": "悪魔もだ。パワーレンジャー。源氏。"}, {"type": "subtitle", "time": 5106.149, "timestamp": "01:25:06", "text": "とてもかわいい。"}, {"type": "subtitle", "time": 5108.629, "timestamp": "01:25:08", "text": "うん。こんにちは。特別版。どうやって"}, {"type": "subtitle", "time": 5113.59, "timestamp": "01:25:13", "text": "何をしているの？侍のやつだよ。"}, {"type": "subtitle", "time": 5116.31, "timestamp": "01:25:16", "text": "いや、ゲンジさん。源氏だ。ええ、それが"}, {"type": "subtitle", "time": 5119.51, "timestamp": "01:25:19", "text": "私は言った。"}, {"type": "subtitle", "time": 5123.11, "timestamp": "01:25:23", "text": "ヒーローチャレンジをクリアすることでアンロックできます。とは"}, {"type": "subtitle", "time": 5126.629, "timestamp": "01:25:26", "text": "ヒーローチャレンジは？"}, {"type": "subtitle", "time": 5133.83, "timestamp": "01:25:33", "text": "ヒーローチャレンジ。 2つのゲームを完了して"}, {"type": "subtitle", "time": 5136.95, "timestamp": "01:25:36", "text": "歌姫を解き放つ。あ、待って。それで、完了"}, {"type": "subtitle", "time": 5140.149, "timestamp": "01:25:40", "text": "9勝グランドダブル"}, {"type": "subtitle", "time": 5142.31, "timestamp": "01:25:42", "text": "進捗。ああ、わかりました。わかった。それでは、"}, {"type": "subtitle", "time": 5145.669, "timestamp": "01:25:45", "text": "ハンゾーをアンロックするには、9つを完了する必要があります"}, {"type": "subtitle", "time": 5151.189, "timestamp": "01:25:51", "text": "ゲーム。わかった。さあ、頑張ろう。"}]
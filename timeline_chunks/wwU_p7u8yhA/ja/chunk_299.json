[{"type": "subtitle", "time": 17945.27, "timestamp": "04:59:05", "text": "ゲーマー。"}, {"type": "subtitle", "time": 17948.628, "timestamp": "04:59:08", "text": "私の持ち物は蜘蛛の近くにある。わかった。"}, {"type": "subtitle", "time": 17959.27, "timestamp": "04:59:19", "text": "まだ。クモ。"}, {"type": "subtitle", "time": 17961.75, "timestamp": "04:59:21", "text": "ああ、ありがとうございます。火のそばに。私は"}, {"type": "subtitle", "time": 17963.99, "timestamp": "04:59:23", "text": "もう一つ作ろうと思う"}, {"type": "subtitle", "time": 17970.628, "timestamp": "04:59:30", "text": "申し訳ありません。"}, {"type": "subtitle", "time": 17973.43, "timestamp": "04:59:33", "text": "うん。うん。ああ、ちくしょう。私は持っています"}, {"type": "subtitle", "time": 17979.91, "timestamp": "04:59:39", "text": "私は手にハンマーを持っている。ごめんなさい。"}, {"type": "subtitle", "time": 17981.91, "timestamp": "04:59:41", "text": "ハンマーを片付けましょう。そこで彼女は"}, {"type": "subtitle", "time": 17983.43, "timestamp": "04:59:43", "text": "行く。"}, {"type": "subtitle", "time": 17987.03, "timestamp": "04:59:47", "text": "いくつかギアを用意しました。"}, {"type": "subtitle", "time": 17989.75, "timestamp": "04:59:49", "text": "私の手は大丈夫です。こっちへ来い。得る"}, {"type": "subtitle", "time": 17993.91, "timestamp": "04:59:53", "text": "休んでほしいなら、こっちに来て。えっと"}, {"type": "subtitle", "time": 17996.31, "timestamp": "04:59:56", "text": "ああ、くそ。あの、私を治してもらえますか？私はただ"}, {"type": "subtitle", "time": 17999.35, "timestamp": "04:59:59", "text": "自分には魂がないことに気づいた。ああ、くそ。"}]
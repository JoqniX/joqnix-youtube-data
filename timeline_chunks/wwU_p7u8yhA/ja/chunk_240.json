[{"type": "subtitle", "time": 14403.91, "timestamp": "04:00:03", "text": "えっと、NASAがコメントを投稿したんだけど、"}, {"type": "subtitle", "time": 14406.389, "timestamp": "04:00:06", "text": "それで、NASAを怒らせたんだけど、"}, {"type": "subtitle", "time": 14409.03, "timestamp": "04:00:09", "text": "「あぁ、ごめん、それは言い過ぎだった」"}, {"type": "subtitle", "time": 14411.03, "timestamp": "04:00:11", "text": "「なぜなら」と彼はコメントで言った。だから私は"}, {"type": "subtitle", "time": 14413.189, "timestamp": "04:00:13", "text": "私は本当に何かしたと思った"}, {"type": "subtitle", "time": 14414.71, "timestamp": "04:00:14", "text": "ミッキーが死ぬという意味か、私が言った"}, {"type": "subtitle", "time": 14419.189, "timestamp": "04:00:19", "text": "何か本当に悪いことが起こった。そして彼は「えーと」"}, {"type": "subtitle", "time": 14422.79, "timestamp": "04:00:22", "text": "ああ、そうやって行動しろ、と彼は言った。だから私は"}, {"type": "subtitle", "time": 14426.15, "timestamp": "04:00:26", "text": "彼にDMを送って、それは"}, {"type": "subtitle", "time": 14427.51, "timestamp": "04:00:27", "text": "何か問題でも？何か言いましたか？"}, {"type": "subtitle", "time": 14429.99, "timestamp": "04:00:29", "text": "マクドナルドについて悪口を言ったり、私が気分を害したりする"}, {"type": "subtitle", "time": 14431.99, "timestamp": "04:00:31", "text": "あなたに何かありますか？そして彼は「私はそうは思わない」と言った"}, {"type": "subtitle", "time": 14434.15, "timestamp": "04:00:34", "text": "待って、あなたは私の"}, {"type": "subtitle", "time": 14437.67, "timestamp": "04:00:37", "text": "メッセージ？彼は私がそうしなかったと言った。そして彼はただ"}, {"type": "subtitle", "time": 14445.03, "timestamp": "04:00:45", "text": "これらのメモ。"}, {"type": "subtitle", "time": 14453.59, "timestamp": "04:00:53", "text": "私はそれが大好きです。私はそれを予想していなかった"}, {"type": "subtitle", "time": 14456.229, "timestamp": "04:00:56", "text": "彼。あれはすごかった。"}, {"type": "subtitle", "time": 14458.87, "timestamp": "04:00:58", "text": "あ、待って。もうすぐ夜だ。えっと、ずきき。"}]
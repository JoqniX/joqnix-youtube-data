[{"type": "subtitle", "time": 3078.63, "timestamp": "00:51:18", "text": "あ、そういえば、オーバーウォッチへようこそ、ジョー。"}, {"type": "subtitle", "time": 3084.63, "timestamp": "00:51:24", "text": "はい。"}, {"type": "subtitle", "time": 3087.589, "timestamp": "00:51:27", "text": "待って、カイシ、もし君がサーバーにいるなら"}, {"type": "subtitle", "time": 3089.43, "timestamp": "00:51:29", "text": "それでも、そうですよね？"}, {"type": "subtitle", "time": 3092.47, "timestamp": "00:51:32", "text": "ゲームのディスカッションから入手できます"}, {"type": "subtitle", "time": 3094.309, "timestamp": "00:51:34", "text": "フォーラムチャンネル。オーバーウォッチがある"}, {"type": "subtitle", "time": 3098.87, "timestamp": "00:51:38", "text": "あれ。私はそれを利用可能にしました"}, {"type": "subtitle", "time": 3101.829, "timestamp": "00:51:41", "text": "えーと"}, {"type": "subtitle", "time": 3105.03, "timestamp": "00:51:45", "text": "私はそれを利用可能にしました。待って、でもあなたは"}]
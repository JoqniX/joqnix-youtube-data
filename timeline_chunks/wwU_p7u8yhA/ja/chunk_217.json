[{"type": "subtitle", "time": 13027.83, "timestamp": "03:37:07", "text": "私の名前は鈴木ずりこです。"}, {"type": "subtitle", "time": 13030.71, "timestamp": "03:37:10", "text": "千年生きている宇宙の仲間"}, {"type": "subtitle", "time": 13033.91, "timestamp": "03:37:13", "text": "宇宙年。"}, {"type": "subtitle", "time": 13037.269, "timestamp": "03:37:17", "text": "うんうん。おお。古い"}, {"type": "subtitle", "time": 13039.03, "timestamp": "03:37:19", "text": "最年少。最年少。彼は"}, {"type": "subtitle", "time": 13040.87, "timestamp": "03:37:20", "text": "私の"}, {"type": "subtitle", "time": 13053.11, "timestamp": "03:37:33", "text": "つまり、"}, {"type": "subtitle", "time": 13056.15, "timestamp": "03:37:36", "text": "それは"}, {"type": "subtitle", "time": 13060.229, "timestamp": "03:37:40", "text": "めちゃくちゃ年寄りだ。通常コラボでは、"}, {"type": "subtitle", "time": 13063.91, "timestamp": "03:37:43", "text": "逃す。彼女はまるで祖母みたいなんだよ。"}, {"type": "subtitle", "time": 13066.15, "timestamp": "03:37:46", "text": "ええ、今はそうです。"}, {"type": "subtitle", "time": 13069.67, "timestamp": "03:37:49", "text": "オアン、さあ。マルチプレイヤーをプレイする人は誰もいない"}, {"type": "subtitle", "time": 13072.469, "timestamp": "03:37:52", "text": "ゲームは私と一緒に持っていたので、必要になったことはありませんでした。"}, {"type": "subtitle", "time": 13074.63, "timestamp": "03:37:54", "text": "ハハ。さみしい。"}, {"type": "subtitle", "time": 13079.19, "timestamp": "03:37:59", "text": "これでビデオゲームはできないよ。私"}]
[{"type": "subtitle", "time": 11583.75, "timestamp": "03:13:03", "text": "うん。"}, {"type": "subtitle", "time": 11587.269, "timestamp": "03:13:07", "text": "いつになったらこの5対5をアンロックできるんだろう"}, {"type": "subtitle", "time": 11597.75, "timestamp": "03:13:17", "text": "では、そろそろ締めくくりましょう。"}, {"type": "subtitle", "time": 11599.99, "timestamp": "03:13:19", "text": "しばらく演奏しています"}, {"type": "subtitle", "time": 11603.51, "timestamp": "03:13:23", "text": "夜。それで、少し中に入っていくと、"}, {"type": "subtitle", "time": 11606.71, "timestamp": "03:13:26", "text": "本日はこれで終了とします。私はそうしてよかった"}, {"type": "subtitle", "time": 11609.269, "timestamp": "03:13:29", "text": "やっとゲームに参加できて、"}, {"type": "subtitle", "time": 11611.75, "timestamp": "03:13:31", "text": "ほら、演奏してみてよ。私は"}, {"type": "subtitle", "time": 11614.55, "timestamp": "03:13:34", "text": "長時間プレイする。"}, {"type": "subtitle", "time": 11616.55, "timestamp": "03:13:36", "text": "それで、"}, {"type": "subtitle", "time": 11619.11, "timestamp": "03:13:39", "text": "私にさせて"}, {"type": "subtitle", "time": 11625.51, "timestamp": "03:13:45", "text": "それで、"}, {"type": "subtitle", "time": 11629.59, "timestamp": "03:13:49", "text": "今日は2回配信しました。いいえ、"}, {"type": "subtitle", "time": 11639.269, "timestamp": "03:13:59", "text": "今日は2回配信しました。"}]
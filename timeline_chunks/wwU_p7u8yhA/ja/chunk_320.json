[{"type": "subtitle", "time": 19205.75, "timestamp": "05:20:05", "text": "とにかく走れ。とにかく走って家に帰ればいい。待って。えっと、"}, {"type": "subtitle", "time": 19209.43, "timestamp": "05:20:09", "text": "寿司、あなたの計画は、"}, {"type": "subtitle", "time": 19211.59, "timestamp": "05:20:11", "text": "成長した。"}, {"type": "subtitle", "time": 19213.59, "timestamp": "05:20:13", "text": "待って、ジャック、何言ってるの？あなたの"}, {"type": "subtitle", "time": 19215.51, "timestamp": "05:20:15", "text": "植物。"}, {"type": "subtitle", "time": 19218.39, "timestamp": "05:20:18", "text": "それらは植物です。ああ、私の植物たち。おい、"}, {"type": "subtitle", "time": 19220.07, "timestamp": "05:20:20", "text": "戻る。"}, {"type": "subtitle", "time": 19221.75, "timestamp": "05:20:21", "text": "つまり、もしあなたが"}, {"type": "subtitle", "time": 19224.07, "timestamp": "05:20:24", "text": "欲しいのは、彼らは文字通りそこにいるだけだからです"}, {"type": "subtitle", "time": 19226.23, "timestamp": "05:20:26", "text": "君たちに食事を与えよう。必ず"}, {"type": "subtitle", "time": 19227.99, "timestamp": "05:20:27", "text": "種は宝箱の中にある。"}, {"type": "subtitle", "time": 19229.83, "timestamp": "05:20:29", "text": "種子。"}, {"type": "subtitle", "time": 19232.47, "timestamp": "05:20:32", "text": "ああ、宝箱はどこだ？わかりました、"}, {"type": "subtitle", "time": 19235.83, "timestamp": "05:20:35", "text": "胸の中に。彼女は"}, {"type": "subtitle", "time": 19238.39, "timestamp": "05:20:38", "text": "海岸だが、これらの貝殻の価値は"}, {"type": "subtitle", "time": 19240.708, "timestamp": "05:20:40", "text": "砲弾が落ちる"}, {"type": "subtitle", "time": 19244.55, "timestamp": "05:20:44", "text": "供給不足のため。"}, {"type": "subtitle", "time": 19247.43, "timestamp": "05:20:47", "text": "最高だわ。うん、本当に"}, {"type": "subtitle", "time": 19256.39, "timestamp": "05:20:56", "text": "一体誰がナスの種を植えたんだ？"}, {"type": "subtitle", "time": 19258.948, "timestamp": "05:20:58", "text": "私じゃないよ。"}]
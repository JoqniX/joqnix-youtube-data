[{"type": "subtitle", "time": 12964.71, "timestamp": "03:36:04", "text": "なんてこった。今度は私の番だ。ああ、くそ。うん。"}, {"type": "subtitle", "time": 12972.309, "timestamp": "03:36:12", "text": "[笑い]"}, {"type": "subtitle", "time": 12975.59, "timestamp": "03:36:15", "text": "面白いものを選びます"}, {"type": "subtitle", "time": 12977.269, "timestamp": "03:36:17", "text": "掘る。"}, {"type": "subtitle", "time": 12997.03, "timestamp": "03:36:37", "text": "私の名前は鈴木です。"}, {"type": "subtitle", "time": 13000.07, "timestamp": "03:36:40", "text": "今日は喉がひどいので、"}, {"type": "subtitle", "time": 13002.71, "timestamp": "03:36:42", "text": "普通に話してください。ありがとう。あなたは"}, {"type": "subtitle", "time": 13003.99, "timestamp": "03:36:43", "text": "長くて硬いもの。それが理由です"}, {"type": "subtitle", "time": 13006.15, "timestamp": "03:36:46", "text": "彼女は声の調子が悪い。"}, {"type": "subtitle", "time": 13008.95, "timestamp": "03:36:48", "text": "鈴木さんはいつも、えーと、"}, {"type": "subtitle", "time": 13011.51, "timestamp": "03:36:51", "text": "知る。よし、感情を込めてやろう。"}, {"type": "subtitle", "time": 13015.19, "timestamp": "03:36:55", "text": "感情を込めて書きます。いつも寝ている"}]
[{"type": "subtitle", "time": 17461.51, "timestamp": "04:51:01", "text": "ショットは必要だが、そのためには腐敗が必要だ。私"}, {"type": "subtitle", "time": 17463.59, "timestamp": "04:51:03", "text": "試してみた。ああ、彼女は落ちるだろう。そうそう、"}, {"type": "subtitle", "time": 17467.43, "timestamp": "04:51:07", "text": "待って、あなたはできる、あなたはできる、"}, {"type": "subtitle", "time": 17470.23, "timestamp": "04:51:10", "text": "システムはまだですか？それは役に立つだろう。そうそう、"}, {"type": "subtitle", "time": 17472.23, "timestamp": "04:51:12", "text": "あなたは正気を失い続けている。そうそう、"}, {"type": "subtitle", "time": 17475.35, "timestamp": "04:51:15", "text": "システムを作るわけではない。うん、ギア"}, {"type": "subtitle", "time": 17478.07, "timestamp": "04:51:18", "text": "何でも。ジョン、あっちへ行け、ジョブ。私は"}, {"type": "subtitle", "time": 17480.708, "timestamp": "04:51:20", "text": "えっと、あのギアを取ってこよう"}, {"type": "subtitle", "time": 17483.05, "timestamp": "04:51:23", "text": "では、手短に。私は必要としている"}, {"type": "subtitle", "time": 17484.868, "timestamp": "04:51:24", "text": "[音楽]"}, {"type": "subtitle", "time": 17487.27, "timestamp": "04:51:27", "text": "今行ってる。うん、だんだんそうなってきてる"}, {"type": "subtitle", "time": 17489.19, "timestamp": "04:51:29", "text": "お腹も空いた。もっと食料を買いに行かなければならない。"}, {"type": "subtitle", "time": 17491.83, "timestamp": "04:51:31", "text": "私も食べ物がない。ごくわずか"}, {"type": "subtitle", "time": 17495.19, "timestamp": "04:51:35", "text": "食べ物。そろそろ料理を始めなきゃ"}, {"type": "subtitle", "time": 17497.91, "timestamp": "04:51:37", "text": "くそっ。誰かスロークッカーを作ってくれませんか？"}, {"type": "subtitle", "time": 17499.91, "timestamp": "04:51:39", "text": "どうやって？それは何ですか？作り方を忘れてしまった"}, {"type": "subtitle", "time": 17502.788, "timestamp": "04:51:42", "text": "コックポット。えーと、6人だけ必要です"}, {"type": "subtitle", "time": 17506.15, "timestamp": "04:51:46", "text": "木炭、3つの切り石、そして2つ"}, {"type": "subtitle", "time": 17507.51, "timestamp": "04:51:47", "text": "棒。私たちは、私たちは、"}, {"type": "subtitle", "time": 17509.67, "timestamp": "04:51:49", "text": "十分。必要なのは切り出した石材だけです。えっと、"}, {"type": "subtitle", "time": 17512.23, "timestamp": "04:51:52", "text": "誰が俺のじょうろを盗んだんだ？おお、"}, {"type": "subtitle", "time": 17513.59, "timestamp": "04:51:53", "text": "いいえ。こっちです。こっちです。その"}, {"type": "subtitle", "time": 17519.91, "timestamp": "04:51:59", "text": "もしあなたが負けているなら、あなたの正気度は低い。"}]
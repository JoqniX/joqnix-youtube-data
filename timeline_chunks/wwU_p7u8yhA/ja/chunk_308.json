[{"type": "subtitle", "time": 18480.788, "timestamp": "05:08:00", "text": "うん。持続する。あなたを"}, {"type": "subtitle", "time": 18483.03, "timestamp": "05:08:03", "text": "その場所。たくさん。たくさんあるよ。そこには"}, {"type": "subtitle", "time": 18484.948, "timestamp": "05:08:04", "text": "たくさん。好きになるだけでいいんです"}, {"type": "subtitle", "time": 18487.11, "timestamp": "05:08:07", "text": "非常識な。それは事実です。それは本当です。私"}, {"type": "subtitle", "time": 18491.67, "timestamp": "05:08:11", "text": "正気を失っていた。ああ、神様。本当に？"}, {"type": "subtitle", "time": 18494.868, "timestamp": "05:08:14", "text": "嬉しい。移動させてください。私は再び死んだ"}, {"type": "subtitle", "time": 18500.55, "timestamp": "05:08:20", "text": "なぜそれらは頻繁に現れるのか？まるで私が"}, {"type": "subtitle", "time": 18502.788, "timestamp": "05:08:22", "text": "黒い方を叩くだけです。ああ、その"}, {"type": "subtitle", "time": 18503.91, "timestamp": "05:08:23", "text": "黒いもの。なぜなら、あなたは"}, {"type": "subtitle", "time": 18505.83, "timestamp": "05:08:25", "text": "それらをウェブ内に配置します。ヒットする必要があります"}, {"type": "subtitle", "time": 18508.788, "timestamp": "05:08:28", "text": "ウェブの外にある黒いもの。"}, {"type": "subtitle", "time": 18511.99, "timestamp": "05:08:31", "text": "こちらです。君に難しいことが必要だ"}, {"type": "subtitle", "time": 18514.868, "timestamp": "05:08:34", "text": "もっと草を。私は自分の草をすべて使い果たしました"}, {"type": "subtitle", "time": 18517.91, "timestamp": "05:08:37", "text": "地獄。えっと、クソのために見つけなきゃ"}, {"type": "subtitle", "time": 18521.51, "timestamp": "05:08:41", "text": "草。草を見つけるために、いくつか集めてください。"}, {"type": "subtitle", "time": 18523.43, "timestamp": "05:08:43", "text": "私はすでに草むらのような場所に向かっています"}, {"type": "subtitle", "time": 18525.91, "timestamp": "05:08:45", "text": "その地域なので、取り組んでみます。私は覚えている"}, {"type": "subtitle", "time": 18528.628, "timestamp": "05:08:48", "text": "草の束みたいだけど、そこにある"}, {"type": "subtitle", "time": 18530.868, "timestamp": "05:08:50", "text": "は。たくさん手に入れたけど、ああ"}, {"type": "subtitle", "time": 18536.15, "timestamp": "05:08:56", "text": "うわぁ。わかった。できる"}, {"type": "subtitle", "time": 18539.27, "timestamp": "05:08:59", "text": "塁上に。"}]
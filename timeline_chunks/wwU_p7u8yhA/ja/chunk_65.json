[{"type": "subtitle", "time": 3900.549, "timestamp": "01:05:00", "text": "オメガもかっこいいですね。私が彼女を演じるかもしれない。"}, {"type": "subtitle", "time": 3920.549, "timestamp": "01:05:20", "text": "ああ、これはとても便利だ。狙いを定めたら"}, {"type": "subtitle", "time": 3923.589, "timestamp": "01:05:23", "text": "下へ、一発撃て、一撃だ。もしあなたが"}, {"type": "subtitle", "time": 3958.15, "timestamp": "01:05:58", "text": "所有"}]
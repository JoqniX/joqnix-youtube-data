[{"type": "subtitle", "time": 19020.07, "timestamp": "05:17:00", "text": "クモの中にも私を狙っているものがいる。だから、あなたは"}, {"type": "subtitle", "time": 19022.15, "timestamp": "05:17:02", "text": "使用できます"}, {"type": "subtitle", "time": 19040.788, "timestamp": "05:17:20", "text": "どれですか？クソみたいな音が聞こえる"}, {"type": "subtitle", "time": 19062.39, "timestamp": "05:17:42", "text": "よし、もっと手に入れよう。自分。さあ"}, {"type": "subtitle", "time": 19065.51, "timestamp": "05:17:45", "text": "これを台無しにしてはいけない。"}, {"type": "subtitle", "time": 19069.11, "timestamp": "05:17:49", "text": "それは良いと思います。うん。よし。"}, {"type": "subtitle", "time": 19072.55, "timestamp": "05:17:52", "text": "ああ、神様、奴らが私を追っている。"}, {"type": "subtitle", "time": 19075.27, "timestamp": "05:17:55", "text": "こちらです。"}, {"type": "subtitle", "time": 19077.27, "timestamp": "05:17:57", "text": "すぐに松の木が育つ。おいおい、勘弁してくれよ。から"}, {"type": "subtitle", "time": 19078.788, "timestamp": "05:17:58", "text": "丘。"}]
[{"type": "subtitle", "time": 16441.349, "timestamp": "04:34:01", "text": "ムーンストーンを手に入れれば可能です"}, {"type": "subtitle", "time": 16444.07, "timestamp": "04:34:04", "text": "そして、月のペットを"}, {"type": "subtitle", "time": 16445.59, "timestamp": "04:34:05", "text": "月のポータルとか何とか。それは"}, {"type": "subtitle", "time": 16447.349, "timestamp": "04:34:07", "text": "実際、そういうことなの？ああ、しまった。はい、あなた"}, {"type": "subtitle", "time": 16449.99, "timestamp": "04:34:09", "text": "できる。おお、それはいいですね。"}, {"type": "subtitle", "time": 16453.029, "timestamp": "04:34:13", "text": "少し高価ですが、"}, {"type": "subtitle", "time": 16458.949, "timestamp": "04:34:18", "text": "待って、これのためにカラスの角を鳴らすことができる"}, {"type": "subtitle", "time": 16461.51, "timestamp": "04:34:21", "text": "ストリーム。"}, {"type": "subtitle", "time": 16465.429, "timestamp": "04:34:25", "text": "真実。待って、角で物を突くことができるよ。"}, {"type": "subtitle", "time": 16466.949, "timestamp": "04:34:26", "text": "はい、できますよ。でも、"}, {"type": "subtitle", "time": 16470.07, "timestamp": "04:34:30", "text": "幽霊が出るような話。うん、やめておこう。えっと、ジョー、私は"}, {"type": "subtitle", "time": 16471.59, "timestamp": "04:34:31", "text": "待って、本当に待ってもいいですか。そうねぇ"}, {"type": "subtitle", "time": 16473.109, "timestamp": "04:34:33", "text": "もし私がもう一つテールテールを作れるなら。私はできる"}, {"type": "subtitle", "time": 16475.349, "timestamp": "04:34:35", "text": "豚を描いて、もう一つハートを作りましょう。得る"}, {"type": "subtitle", "time": 16477.189, "timestamp": "04:34:37", "text": "こちらです。もう一つハートを作っています。得る"}, {"type": "subtitle", "time": 16479.349, "timestamp": "04:34:39", "text": "こちらです。わかった。はい。"}, {"type": "subtitle", "time": 16486.23, "timestamp": "04:34:46", "text": "こちらです。えっと"}, {"type": "subtitle", "time": 16488.47, "timestamp": "04:34:48", "text": "ここに胸があります。もし"}, {"type": "subtitle", "time": 16491.109, "timestamp": "04:34:51", "text": "男たちはここにくだらないものを捨てたいんだ。感謝"}, {"type": "subtitle", "time": 16492.949, "timestamp": "04:34:52", "text": "あなた。"}, {"type": "subtitle", "time": 16496.709, "timestamp": "04:34:56", "text": "生きて帰ってきた。あぁ、掴みかかってくる腕。はい、私は"}]
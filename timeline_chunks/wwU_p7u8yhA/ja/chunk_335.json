[{"type": "subtitle", "time": 20100.07, "timestamp": "05:35:00", "text": "破壊された。"}, {"type": "subtitle", "time": 20102.868, "timestamp": "05:35:02", "text": "私はそれを疑う。では、おやすみなさい"}, {"type": "subtitle", "time": 20106.23, "timestamp": "05:35:06", "text": "みんな。よし、もう一度寝るよ。"}, {"type": "subtitle", "time": 20109.83, "timestamp": "05:35:09", "text": "おやすみ。おやすみ。皆さん"}, {"type": "subtitle", "time": 20112.708, "timestamp": "05:35:12", "text": "食べていない人"}, {"type": "subtitle", "time": 20115.51, "timestamp": "05:35:15", "text": "良い、"}, {"type": "subtitle", "time": 20118.15, "timestamp": "05:35:18", "text": "起きました。"}, {"type": "subtitle", "time": 20120.07, "timestamp": "05:35:20", "text": "こんにちは。"}, {"type": "subtitle", "time": 20126.23, "timestamp": "05:35:26", "text": "この男は対峙するだろう。ああ、私たちは"}, {"type": "subtitle", "time": 20132.788, "timestamp": "05:35:32", "text": "じゃあね、みんな。うん。さよなら。おやすみ"}, {"type": "subtitle", "time": 20137.03, "timestamp": "05:35:37", "text": "みんな。私は唯一の配信者です。私は"}, {"type": "subtitle", "time": 20139.43, "timestamp": "05:35:39", "text": "配信していないのは一人だけ。だから何"}, {"type": "subtitle", "time": 20142.31, "timestamp": "05:35:42", "text": "私はそうする、それは"}, {"type": "subtitle", "time": 20145.91, "timestamp": "05:35:45", "text": "後であなたのチャットに行きます。それは"}, {"type": "subtitle", "time": 20148.23, "timestamp": "05:35:48", "text": "わかった？こんにちは。"}, {"type": "subtitle", "time": 20151.19, "timestamp": "05:35:51", "text": "はい。はい。こんにちは。"}, {"type": "subtitle", "time": 20154.15, "timestamp": "05:35:54", "text": "後で電話します。"}, {"type": "subtitle", "time": 20158.548, "timestamp": "05:35:58", "text": "何？後で電話します。何？待って。"}]
[{"type": "subtitle", "time": 17640.868, "timestamp": "04:54:00", "text": "これから。持続する。君たち二人が来る"}, {"type": "subtitle", "time": 17643.19, "timestamp": "04:54:03", "text": "私にとって。鈴木は妹を利用する必要がある"}, {"type": "subtitle", "time": 17645.35, "timestamp": "04:54:05", "text": "彼女は文字通り狩りをすることができるから"}, {"type": "subtitle", "time": 17647.83, "timestamp": "04:54:07", "text": "妹。あなたも。私に従ってください。あなたたち二人。"}, {"type": "subtitle", "time": 17649.59, "timestamp": "04:54:09", "text": "また、ズキ、あなたは"}, {"type": "subtitle", "time": 17652.708, "timestamp": "04:54:12", "text": "妹が出て行った。妹は絶対に近づけないで。"}, {"type": "subtitle", "time": 17655.03, "timestamp": "04:54:15", "text": "あなたの妹はまさに超"}, {"type": "subtitle", "time": 17656.948, "timestamp": "04:54:16", "text": "役に立つ。よし。そして彼女を立ち上がらせた。作る"}, {"type": "subtitle", "time": 17659.43, "timestamp": "04:54:19", "text": "彼女は怒っていた。妹を怒らせなさい。あなた"}, {"type": "subtitle", "time": 17661.43, "timestamp": "04:54:21", "text": "もう一度彼女を右クリックして「はい」をクリックします。誰"}, {"type": "subtitle", "time": 17663.75, "timestamp": "04:54:23", "text": "変な掃除機使ってるのか？うん。"}, {"type": "subtitle", "time": 17666.788, "timestamp": "04:54:26", "text": "はい、どうぞ。こちらです。こちらです。そして"}, {"type": "subtitle", "time": 17669.11, "timestamp": "04:54:29", "text": "ちょうど"}, {"type": "subtitle", "time": 17671.59, "timestamp": "04:54:31", "text": "この辺りに留まってください。あなたの妹は"}, {"type": "subtitle", "time": 17674.788, "timestamp": "04:54:34", "text": "カエルを自動的に殺す。近づく"}, {"type": "subtitle", "time": 17676.948, "timestamp": "04:54:36", "text": "カエルはいるが、あまり近づきすぎないように。そうですね、"}, {"type": "subtitle", "time": 17678.31, "timestamp": "04:54:38", "text": "見て、あなたの妹はこれをやるつもりよ"}, {"type": "subtitle", "time": 17679.59, "timestamp": "04:54:39", "text": "自動的に。食べ物を手に入れる"}, {"type": "subtitle", "time": 17681.99, "timestamp": "04:54:41", "text": "彼らから。ああ、神様。"}, {"type": "subtitle", "time": 17685.51, "timestamp": "04:54:45", "text": "まず調理してから食べてください。"}, {"type": "subtitle", "time": 17689.99, "timestamp": "04:54:49", "text": "そこには。まるで、そこは簡単だ"}, {"type": "subtitle", "time": 17691.91, "timestamp": "04:54:51", "text": "食べ物。それは自動的に与えられる食べ物ではない。来て。"}, {"type": "subtitle", "time": 17694.55, "timestamp": "04:54:54", "text": "そこには。カエルの足を全部掴んでください。えっと、料理人"}, {"type": "subtitle", "time": 17695.99, "timestamp": "04:54:55", "text": "彼らを先に。食べる前に"}, {"type": "subtitle", "time": 17698.15, "timestamp": "04:54:58", "text": "それらを先に取ってください。どうやって"}]
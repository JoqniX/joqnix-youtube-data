[{"type": "subtitle", "time": 5048.07, "timestamp": "01:24:08", "text": "[音楽]"}, {"type": "subtitle", "time": 5068.07, "timestamp": "01:24:28", "text": "ゲンジ、新ヒーローのダメージが解放されました。"}, {"type": "subtitle", "time": 5071.189, "timestamp": "01:24:31", "text": "源氏島田は"}, {"type": "subtitle", "time": 5074.149, "timestamp": "01:24:34", "text": "かつて彼が拒絶したサイボーグの体。そして"}, {"type": "subtitle", "time": 5076.79, "timestamp": "01:24:36", "text": "そうすることで、彼はより高い"}, {"type": "subtitle", "time": 5078.31, "timestamp": "01:24:38", "text": "人類。"}, {"type": "subtitle", "time": 5081.11, "timestamp": "01:24:41", "text": "おお、"}, {"type": "subtitle", "time": 5089.189, "timestamp": "01:24:49", "text": "ああ、ゲンジのスキンは本当にたくさんあるね。"}, {"type": "subtitle", "time": 5091.43, "timestamp": "01:24:51", "text": "おお。"}, {"type": "subtitle", "time": 5095.91, "timestamp": "01:24:55", "text": "ああ、これ好き。私は鬼が好きだ。ああ、e。"}, {"type": "subtitle", "time": 5099.189, "timestamp": "01:24:59", "text": "何てことだ。かわいい"}]
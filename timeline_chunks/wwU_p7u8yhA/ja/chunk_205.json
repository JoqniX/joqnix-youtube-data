[{"type": "subtitle", "time": 12304.95, "timestamp": "03:25:04", "text": "DJさん、来てくれてありがとう。"}, {"type": "subtitle", "time": 12312.469, "timestamp": "03:25:12", "text": "また、DJIを見るといつも"}, {"type": "subtitle", "time": 12315.19, "timestamp": "03:25:15", "text": "原神を思い出させる。わかりました、では"}, {"type": "subtitle", "time": 12318.63, "timestamp": "03:25:18", "text": "次回は原神の配信をしよう"}, {"type": "subtitle", "time": 12321.91, "timestamp": "03:25:21", "text": "えっと、配信できませんでした"}, {"type": "subtitle", "time": 12324.309, "timestamp": "03:25:24", "text": "その時はすごく疲れていたので、"}, {"type": "subtitle", "time": 12326.389, "timestamp": "03:25:26", "text": "眠いでしょ？"}, {"type": "subtitle", "time": 12329.67, "timestamp": "03:25:29", "text": "そうですね、そう思います"}, {"type": "subtitle", "time": 12332.71, "timestamp": "03:25:32", "text": "明日、実際に"}, {"type": "subtitle", "time": 12334.79, "timestamp": "03:25:34", "text": "ストリーム"}, {"type": "subtitle", "time": 12338.469, "timestamp": "03:25:38", "text": "えーっと、月曜日か日曜日なら"}, {"type": "subtitle", "time": 12341.03, "timestamp": "03:25:41", "text": "原神やってます。そう、だって私は努力が必要だから"}, {"type": "subtitle", "time": 12342.87, "timestamp": "03:25:42", "text": "あの赤い髪の女の子がやってくる"}, {"type": "subtitle", "time": 12345.03, "timestamp": "03:25:45", "text": "すぐ。"}, {"type": "subtitle", "time": 12348.389, "timestamp": "03:25:48", "text": "まあ、とにかく今日はこれで終わりにします。"}, {"type": "subtitle", "time": 12349.73, "timestamp": "03:25:49", "text": "今日はここまで。"}, {"type": "subtitle", "time": 12351.19, "timestamp": "03:25:51", "text": "[拍手]"}, {"type": "subtitle", "time": 12353.349, "timestamp": "03:25:53", "text": "ありがとう。ありがとう。"}, {"type": "subtitle", "time": 12355.91, "timestamp": "03:25:55", "text": "来てくれてありがとう、それでは"}]
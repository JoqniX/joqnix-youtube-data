[{"type": "subtitle", "time": 10263.269, "timestamp": "02:51:03", "text": "いいえ、私が彼を排除しました。あ、待って。一度もない"}, {"type": "subtitle", "time": 10266.23, "timestamp": "02:51:06", "text": "心。私はアシスト役でした。"}, {"type": "subtitle", "time": 10268.23, "timestamp": "02:51:08", "text": "でもああ神様、"}, {"type": "subtitle", "time": 10270.469, "timestamp": "02:51:10", "text": "慣れるよ。私はピューピューはできません"}, {"type": "subtitle", "time": 10288.389, "timestamp": "02:51:28", "text": "[音楽]"}]
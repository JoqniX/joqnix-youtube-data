[{"type": "subtitle", "time": 8342.23, "timestamp": "02:19:02", "text": "母親、"}, {"type": "subtitle", "time": 8362.15, "timestamp": "02:19:22", "text": "ああ、なんてことだ、彼は私を押さえつけた。"}, {"type": "subtitle", "time": 8379.349, "timestamp": "02:19:39", "text": "なぜ戦車が2台も必要なのか？"}, {"type": "subtitle", "time": 8382.309, "timestamp": "02:19:42", "text": "「同意しました」とおっしゃいましたか？ええ、そうしました。"}, {"type": "subtitle", "time": 8385.99, "timestamp": "02:19:45", "text": "あ、待って。いいえ、そうではありません。こんにちは、奥様。"}, {"type": "subtitle", "time": 8388.309, "timestamp": "02:19:48", "text": "待てよ、でもやったような気がする。待って、私、やったわ。"}, {"type": "subtitle", "time": 8390.87, "timestamp": "02:19:50", "text": "え、私、そうだったっけ？待てよ、やったと思う。私"}, {"type": "subtitle", "time": 8394.07, "timestamp": "02:19:54", "text": "かわいい子ちゃんに挨拶したと思う"}]
[{"type": "subtitle", "time": 12182.15, "timestamp": "03:23:02", "text": "このゲームのアドバイザーやその他"}, {"type": "subtitle", "time": 12184.07, "timestamp": "03:23:04", "text": "何をすべきか、その他すべて。ありがとう。"}, {"type": "subtitle", "time": 12187.269, "timestamp": "03:23:07", "text": "海石さん、ありがとうございます。あなたのゲームが"}, {"type": "subtitle", "time": 12189.91, "timestamp": "03:23:09", "text": "ダウンロードは完了したけど、プレイできない"}, {"type": "subtitle", "time": 12192.71, "timestamp": "03:23:12", "text": "今はこれでいいけど、またすぐに遊ぼう。わかった、"}, {"type": "subtitle", "time": 12196.389, "timestamp": "03:23:16", "text": "一緒に遊ぼう"}, {"type": "subtitle", "time": 12198.229, "timestamp": "03:23:18", "text": "それから"}, {"type": "subtitle", "time": 12200.71, "timestamp": "03:23:20", "text": "お越しいただきありがとうございました。本当に"}, {"type": "subtitle", "time": 12213.19, "timestamp": "03:23:33", "text": "良い一日をお過ごしください。こんにちは、"}, {"type": "subtitle", "time": 12217.11, "timestamp": "03:23:37", "text": "良い一日を。そして、ここに新しい人がいると言っておきます。"}, {"type": "subtitle", "time": 12220.389, "timestamp": "03:23:40", "text": "いらっしゃいませ。ようこそ。ありがとうございます"}, {"type": "subtitle", "time": 12223.03, "timestamp": "03:23:43", "text": "小川にやって来る。わからない"}, {"type": "subtitle", "time": 12225.75, "timestamp": "03:23:45", "text": "今日私の配信をどこで見つけたか"}, {"type": "subtitle", "time": 12227.67, "timestamp": "03:23:47", "text": "来てくれてありがとう。本当に"}, {"type": "subtitle", "time": 12229.75, "timestamp": "03:23:49", "text": "とても意味があります。"}, {"type": "subtitle", "time": 12233.83, "timestamp": "03:23:53", "text": "そして、特別版をお届けします。"}, {"type": "subtitle", "time": 12237.59, "timestamp": "03:23:57", "text": "よく眠る。まだそうでないことを願っています"}]
[{"type": "subtitle", "time": 15242.149, "timestamp": "04:14:02", "text": "ああ、くそ。ここに豚がいることを忘れていた。"}, {"type": "subtitle", "time": 15243.91, "timestamp": "04:14:03", "text": "うん。フロアで待ち合わせして、"}, {"type": "subtitle", "time": 15245.67, "timestamp": "04:14:05", "text": "牧師。ポータルで待ち合わせましょう。病気"}, {"type": "subtitle", "time": 15247.429, "timestamp": "04:14:07", "text": "君たちを置いていくよ。"}, {"type": "subtitle", "time": 15249.91, "timestamp": "04:14:09", "text": "どうですか？"}, {"type": "subtitle", "time": 15252.389, "timestamp": "04:14:12", "text": "Mは地図を見る？"}, {"type": "subtitle", "time": 15259.349, "timestamp": "04:14:19", "text": "来て。ポータル。ああ、私たちはとても遠い"}, {"type": "subtitle", "time": 15261.349, "timestamp": "04:14:21", "text": "離れて。ジェイソン、あなたを招待できて嬉しいです。"}, {"type": "subtitle", "time": 15264.71, "timestamp": "04:14:24", "text": "待って、ズキ、こっちに来て。なぜならそれは"}, {"type": "subtitle", "time": 15266.55, "timestamp": "04:14:26", "text": "普段は私とZ2だけがプレイしています"}, {"type": "subtitle", "time": 15270.79, "timestamp": "04:14:30", "text": "DSCがオフラインになりました。こちらです。こちらです。下。"}, {"type": "subtitle", "time": 15273.67, "timestamp": "04:14:33", "text": "こちらです。"}, {"type": "subtitle", "time": 15275.75, "timestamp": "04:14:35", "text": "キャンプファイヤーでの私の反応を期待してください"}, {"type": "subtitle", "time": 15282.229, "timestamp": "04:14:42", "text": "私は一度も死んでいないのに、"}, {"type": "subtitle", "time": 15284.149, "timestamp": "04:14:44", "text": "あの世界。そして、02はあまりにも多く死んでしまった"}, {"type": "subtitle", "time": 15287.83, "timestamp": "04:14:47", "text": "何回もあって、数えきれないほどです。"}, {"type": "subtitle", "time": 15291.51, "timestamp": "04:14:51", "text": "ああ、死にそうだ。おお。"}, {"type": "subtitle", "time": 15293.91, "timestamp": "04:14:53", "text": "えっと、空腹。"}, {"type": "subtitle", "time": 15296.87, "timestamp": "04:14:56", "text": "何か食べてもいいですか？"}, {"type": "subtitle", "time": 15298.87, "timestamp": "04:14:58", "text": "はい。"}]
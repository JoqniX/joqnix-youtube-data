[{"type": "subtitle", "time": 19939.27, "timestamp": "05:32:19", "text": "戦うつもりはない。戦うつもりはない。"}, {"type": "subtitle", "time": 19940.948, "timestamp": "05:32:20", "text": "戦うつもりはない。よし、これでいい。全て"}, {"type": "subtitle", "time": 19943.99, "timestamp": "05:32:23", "text": "右。それが正しいやり方だ。よし。"}, {"type": "subtitle", "time": 19947.11, "timestamp": "05:32:27", "text": "海で泳ぐ。ちくしょう。クソ。"}, {"type": "subtitle", "time": 19950.31, "timestamp": "05:32:30", "text": "彼女に海で泳いでいるこの犬をあげた。"}, {"type": "subtitle", "time": 19953.59, "timestamp": "05:32:33", "text": "ああ、くそ。元気です。"}, {"type": "subtitle", "time": 19956.47, "timestamp": "05:32:36", "text": "ねえ、この犬みたいなのは何？私は"}, {"type": "subtitle", "time": 19967.75, "timestamp": "05:32:47", "text": "夕食は食べましたか？なんてこった。"}, {"type": "subtitle", "time": 19972.708, "timestamp": "05:32:52", "text": "え、何？そうすべきではありません。ああ、くそ。おお、"}]
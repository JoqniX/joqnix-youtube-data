[{"type": "subtitle", "time": 19321.43, "timestamp": "05:22:01", "text": "ここにカエルの足があるよ。あなたが望むなら"}, {"type": "subtitle", "time": 19323.67, "timestamp": "05:22:03", "text": "食べ物、作物から食べ物を取ってきなさい。"}, {"type": "subtitle", "time": 19327.03, "timestamp": "05:22:07", "text": "なんてこった。私は集団レイプされている。いいえ。ああ、"}, {"type": "subtitle", "time": 19333.83, "timestamp": "05:22:13", "text": "いや。やばい。"}, {"type": "subtitle", "time": 19336.39, "timestamp": "05:22:16", "text": "推奨"}, {"type": "subtitle", "time": 19340.47, "timestamp": "05:22:20", "text": "つまり、君が行くようにね。うん。ああ、それは"}, {"type": "subtitle", "time": 19342.788, "timestamp": "05:22:22", "text": "満月。おい。"}, {"type": "subtitle", "time": 19345.03, "timestamp": "05:22:25", "text": "わかった。"}, {"type": "subtitle", "time": 19348.15, "timestamp": "05:22:28", "text": "怒り。妹を怒らせろ。ニース。"}, {"type": "subtitle", "time": 19350.55, "timestamp": "05:22:30", "text": "おい。"}, {"type": "subtitle", "time": 19353.99, "timestamp": "05:22:33", "text": "わかった。よし。 2人のように"}, {"type": "subtitle", "time": 19356.07, "timestamp": "05:22:36", "text": "柳。あなたが呼ぶものを好きになれますか"}, {"type": "subtitle", "time": 19358.948, "timestamp": "05:22:38", "text": "また？えっと、何の電話でしたっけ？ええと、"}, {"type": "subtitle", "time": 19362.788, "timestamp": "05:22:42", "text": "ズキは無料の巣が欲しいと思っています。いいえ。"}, {"type": "subtitle", "time": 19365.75, "timestamp": "05:22:45", "text": "ああ、大変だ。ああ、大変だ。"}, {"type": "subtitle", "time": 19369.51, "timestamp": "05:22:49", "text": "わかった。わかった。けっこうだ。"}, {"type": "subtitle", "time": 19371.19, "timestamp": "05:22:51", "text": "なぜダメなの？どこですか？どこですか？"}, {"type": "subtitle", "time": 19374.39, "timestamp": "05:22:54", "text": "こっちへ来て、あっちへ来て。こっちへおいで"}, {"type": "subtitle", "time": 19376.47, "timestamp": "05:22:56", "text": "ここ。わかった。来て。私たちはすべての"}, {"type": "subtitle", "time": 19378.948, "timestamp": "05:22:58", "text": "我々には人員が必要だ。幽霊の力。妹"}]
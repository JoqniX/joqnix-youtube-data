[{"type": "subtitle", "time": 13382.229, "timestamp": "03:43:02", "text": "別の猫。ああ、私は大きなものを選んでいます"}, {"type": "subtitle", "time": 13384.469, "timestamp": "03:43:04", "text": "友人。待って、あなたの誕生日。ハッピー"}, {"type": "subtitle", "time": 13386.95, "timestamp": "03:43:06", "text": "誕生日。ズヅキは女の子です。の"}, {"type": "subtitle", "time": 13389.269, "timestamp": "03:43:09", "text": "ブロンド。いや、違うよ。今日は私の結婚記念日です"}, {"type": "subtitle", "time": 13395.51, "timestamp": "03:43:15", "text": "すぐ。よし、始めよう。なんてこった。待って。"}, {"type": "subtitle", "time": 13397.83, "timestamp": "03:43:17", "text": "わかった。そうそう。肉を食べるには"}, {"type": "subtitle", "time": 13399.349, "timestamp": "03:43:19", "text": "そうだよ、ジョックニック。言い忘れていました"}, {"type": "subtitle", "time": 13403.189, "timestamp": "03:43:23", "text": "それ。あ、待って。ウルフリーを選んでください。 Wではない。"}, {"type": "subtitle", "time": 13404.95, "timestamp": "03:43:24", "text": "待って。ええ、Wfordです。うん。私は行きます"}, {"type": "subtitle", "time": 13408.309, "timestamp": "03:43:28", "text": "もちろんです。"}, {"type": "subtitle", "time": 13410.55, "timestamp": "03:43:30", "text": "うん。"}, {"type": "subtitle", "time": 13416.229, "timestamp": "03:43:36", "text": "誰かの持ち物を拾うため。"}, {"type": "subtitle", "time": 13419.269, "timestamp": "03:43:39", "text": "音声がないことを忘れていました。私はただ"}, {"type": "subtitle", "time": 13422.87, "timestamp": "03:43:42", "text": "外で言葉を拾う。これは誰ですか？"}, {"type": "subtitle", "time": 13424.469, "timestamp": "03:43:44", "text": "うん。私は正気を失い死にそうです"}, {"type": "subtitle", "time": 13427.429, "timestamp": "03:43:47", "text": "最後はいつも通り。ああ、あれは犬だ。"}, {"type": "subtitle", "time": 13429.03, "timestamp": "03:43:49", "text": "その"}, {"type": "subtitle", "time": 13431.03, "timestamp": "03:43:51", "text": "一緒にいる人たち。"}, {"type": "subtitle", "time": 13435.67, "timestamp": "03:43:55", "text": "わかった。だから、彼らは皆それを選んだのだ。だから私は"}, {"type": "subtitle", "time": 13439.269, "timestamp": "03:43:59", "text": "遅れている。うん、ラグってるね。ええ、それは"}]
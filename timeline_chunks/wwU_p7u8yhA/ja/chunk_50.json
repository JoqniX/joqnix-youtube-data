[{"type": "subtitle", "time": 3028.39, "timestamp": "00:50:28", "text": "しかし、お金がない。無料でプレイできます。カイシ、"}, {"type": "subtitle", "time": 3032.63, "timestamp": "00:50:32", "text": "これはオーバーウォッチ2Dです。全員が1つを見るわけではありません。"}, {"type": "subtitle", "time": 3042.23, "timestamp": "00:50:42", "text": "しかし、試合に出場するのは難しい"}, {"type": "subtitle", "time": 3044.23, "timestamp": "00:50:44", "text": "Q."}]
[{"type": "subtitle", "time": 18840.788, "timestamp": "05:14:00", "text": "昼間のように。わかった。わかった。私は"}, {"type": "subtitle", "time": 18842.55, "timestamp": "05:14:02", "text": "現在、3体の悪夢と戦っている"}, {"type": "subtitle", "time": 18844.23, "timestamp": "05:14:04", "text": "生き物たち。"}, {"type": "subtitle", "time": 18846.86, "timestamp": "05:14:06", "text": "そして、このラグのせいで、それは全く楽しくない。"}, {"type": "subtitle", "time": 18848.708, "timestamp": "05:14:08", "text": "[音楽]"}, {"type": "subtitle", "time": 18850.788, "timestamp": "05:14:10", "text": "待って、これは何？なぜ私は狩りをしているのか"}, {"type": "subtitle", "time": 18855.11, "timestamp": "05:14:15", "text": "もの？狩りをすることができます。"}, {"type": "subtitle", "time": 18858.39, "timestamp": "05:14:18", "text": "物を憑りつかせるな。それは事態を悪化させるだけだ。"}, {"type": "subtitle", "time": 18861.27, "timestamp": "05:14:21", "text": "それは事態を悪化させるだけだ。恐ろしいもの"}, {"type": "subtitle", "time": 18865.59, "timestamp": "05:14:25", "text": "以前、02が猟犬に取り憑いたことがあった。"}, {"type": "subtitle", "time": 18868.07, "timestamp": "05:14:28", "text": "くそっ。あなたは学んだ"}, {"type": "subtitle", "time": 18871.75, "timestamp": "05:14:31", "text": "やっと戻ってきました。何もするな。わかった、"}, {"type": "subtitle", "time": 18874.07, "timestamp": "05:14:34", "text": "戻ってきました。あなた"}, {"type": "subtitle", "time": 18877.75, "timestamp": "05:14:37", "text": "心臓が動く。あなたは狩りをすることができます"}, {"type": "subtitle", "time": 18881.43, "timestamp": "05:14:41", "text": "木を生成して木を生やすチャンスを得る"}, {"type": "subtitle", "time": 18882.948, "timestamp": "05:14:42", "text": "ガード。"}, {"type": "subtitle", "time": 18884.948, "timestamp": "05:14:44", "text": "これってどうやって作るんだっけ？ちょっと見てみよう"}, {"type": "subtitle", "time": 18886.948, "timestamp": "05:14:46", "text": "こっちには何があるの？中に入れて"}, {"type": "subtitle", "time": 18889.43, "timestamp": "05:14:49", "text": "調理エリアへ。材料を入れる"}, {"type": "subtitle", "time": 18893.19, "timestamp": "05:14:53", "text": "入れられます。1つしか入れられません。皆さんは"}, {"type": "subtitle", "time": 18894.708, "timestamp": "05:14:54", "text": "火打ち石？"}, {"type": "subtitle", "time": 18897.99, "timestamp": "05:14:57", "text": "火打ち石はありますか？私は10個持っています。"}]
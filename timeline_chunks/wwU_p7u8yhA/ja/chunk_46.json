[{"type": "subtitle", "time": 2762.23, "timestamp": "00:46:02", "text": "[音楽]"}, {"type": "subtitle", "time": 2763.91, "timestamp": "00:46:03", "text": "あ、待って。字幕が表示されないのはなぜですか？"}, {"type": "subtitle", "time": 2775.43, "timestamp": "00:46:15", "text": "おお、"}, {"type": "subtitle", "time": 2793.27, "timestamp": "00:46:33", "text": "私だけでしょうか、それとも会話が親切に聞こえるのでしょうか"}, {"type": "subtitle", "time": 2796.15, "timestamp": "00:46:36", "text": "ここは基地ですか？だからドルビーのおかげで"}, {"type": "subtitle", "time": 2800.33, "timestamp": "00:46:40", "text": "Atmos FEオプションをオンにしました。"}, {"type": "subtitle", "time": 2816.92, "timestamp": "00:46:56", "text": "なんてこった。"}]
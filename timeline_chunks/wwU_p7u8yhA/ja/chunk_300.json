[{"type": "subtitle", "time": 18002.868, "timestamp": "05:00:02", "text": "あの、一緒に来ない？私"}, {"type": "subtitle", "time": 18007.11, "timestamp": "05:00:07", "text": "まず、絶対に罪のない人が必要だ。"}, {"type": "subtitle", "time": 18011.11, "timestamp": "05:00:11", "text": "私のシルク、あなたは、あなたは、"}, {"type": "subtitle", "time": 18018.31, "timestamp": "05:00:18", "text": "あなたの妹と一緒に。待って、何だって？"}, {"type": "subtitle", "time": 18020.628, "timestamp": "05:00:20", "text": "君はただクソが必要なだけなのか？ わかった、もちろん。"}, {"type": "subtitle", "time": 18021.99, "timestamp": "05:00:21", "text": "うん。うん。ただ彼らを殺してほしいだけなんだ"}, {"type": "subtitle", "time": 18023.91, "timestamp": "05:00:23", "text": "妹と一緒に。それだけで十分です。"}, {"type": "subtitle", "time": 18027.35, "timestamp": "05:00:27", "text": "どの方向ですか？あ、そこです。"}, {"type": "subtitle", "time": 18029.75, "timestamp": "05:00:29", "text": "わかった。だって、私は農業をやってきたから。"}, {"type": "subtitle", "time": 18031.35, "timestamp": "05:00:31", "text": "わかった。"}, {"type": "subtitle", "time": 18034.07, "timestamp": "05:00:34", "text": "なんてこった。蛙。"}, {"type": "subtitle", "time": 18036.47, "timestamp": "05:00:36", "text": "フロゴが私を攻撃している。いや、そうではない。すべて実行"}, {"type": "subtitle", "time": 18039.59, "timestamp": "05:00:39", "text": "私は関わらないので、仕事はできません。関わらないでください。私"}, {"type": "subtitle", "time": 18042.55, "timestamp": "05:00:42", "text": "繰り返しますが、関わらないでください。はい。私は走っています"}, {"type": "subtitle", "time": 18044.15, "timestamp": "05:00:44", "text": "離れて。"}, {"type": "subtitle", "time": 18046.55, "timestamp": "05:00:46", "text": "私です。私です。ズキ。私です。魂"}, {"type": "subtitle", "time": 18048.628, "timestamp": "05:00:48", "text": "無実の人々"}, {"type": "subtitle", "time": 18051.03, "timestamp": "05:00:51", "text": "こちらです。私に従ってください。私に従ってください。おお、"}, {"type": "subtitle", "time": 18053.27, "timestamp": "05:00:53", "text": "一体何なんだ？ああ、くそ。ああ、"}, {"type": "subtitle", "time": 18055.91, "timestamp": "05:00:55", "text": "くそっ。彼は私に花を落とさせた。鉛"}, {"type": "subtitle", "time": 18058.628, "timestamp": "05:00:58", "text": "カエルがあなたの妹の方へ向かう。それを受け取って。"}]
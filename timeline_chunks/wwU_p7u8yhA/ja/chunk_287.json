[{"type": "subtitle", "time": 17220.55, "timestamp": "04:47:00", "text": "ああ、これは間違いだった。ああ、"}, {"type": "subtitle", "time": 17228.788, "timestamp": "04:47:08", "text": "私は混乱しています。えっと、召喚して"}, {"type": "subtitle", "time": 17230.31, "timestamp": "04:47:10", "text": "立ち上がって、そのカエルを殺します"}, {"type": "subtitle", "time": 17231.91, "timestamp": "04:47:11", "text": "そこには。"}, {"type": "subtitle", "time": 17235.67, "timestamp": "04:47:15", "text": "どうやって？えっと、花を右クリックしてください。右"}, {"type": "subtitle", "time": 17237.27, "timestamp": "04:47:17", "text": "お好きな花をクリックしてください。ああ、君は行くんだ"}, {"type": "subtitle", "time": 17238.948, "timestamp": "04:47:18", "text": "雨によって徐々にダメージを受ける。それで"}, {"type": "subtitle", "time": 17247.99, "timestamp": "04:47:27", "text": "しまった、それを忘れてた。"}, {"type": "subtitle", "time": 17250.708, "timestamp": "04:47:30", "text": "君はロボットだ。忘れないで。うん、作って"}, {"type": "subtitle", "time": 17253.59, "timestamp": "04:47:33", "text": "何かのための傘。ねえ、君は"}, {"type": "subtitle", "time": 17256.708, "timestamp": "04:47:36", "text": "傘を作る。麦わら帽子を作ればいいんです。"}, {"type": "subtitle", "time": 17257.91, "timestamp": "04:47:37", "text": "麦わら帽子。作り方がわからない"}, {"type": "subtitle", "time": 17260.708, "timestamp": "04:47:40", "text": "麦わら帽子。私の妹がデザインしました。"}, {"type": "subtitle", "time": 17262.47, "timestamp": "04:47:42", "text": "良い。"}, {"type": "subtitle", "time": 17264.708, "timestamp": "04:47:44", "text": "ここ。ええと、じゃあ、いいですよ。どこ"}, {"type": "subtitle", "time": 17266.708, "timestamp": "04:47:46", "text": "あなたが植えたものは何ですか？えっと、"}, {"type": "subtitle", "time": 17268.55, "timestamp": "04:47:48", "text": "そこには。それはどこ？それはどこ？と"}, {"type": "subtitle", "time": 17271.67, "timestamp": "04:47:51", "text": "それ。敵がいる場所へ行け。おお"}, {"type": "subtitle", "time": 17274.31, "timestamp": "04:47:54", "text": "神。おお"}, {"type": "subtitle", "time": 17277.19, "timestamp": "04:47:57", "text": "わかった、わかった。頭は"}, {"type": "subtitle", "time": 17279.27, "timestamp": "04:47:59", "text": "斧と死者の物"}]
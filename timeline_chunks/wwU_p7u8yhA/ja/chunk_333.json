[{"type": "subtitle", "time": 19981.43, "timestamp": "05:33:01", "text": "[音楽]"}, {"type": "subtitle", "time": 19984.31, "timestamp": "05:33:04", "text": "この犬が私を追いかけてくる。"}, {"type": "subtitle", "time": 19986.788, "timestamp": "05:33:06", "text": "火事が起こり始めた。"}, {"type": "subtitle", "time": 19993.27, "timestamp": "05:33:13", "text": "火を熱くせよ。"}, {"type": "subtitle", "time": 19997.51, "timestamp": "05:33:17", "text": "6,000。うわあ、すごい量ですね。"}, {"type": "subtitle", "time": 20001.03, "timestamp": "05:33:21", "text": "ああ、ベンがハンスと戦ってる。おお、"}, {"type": "subtitle", "time": 20004.07, "timestamp": "05:33:24", "text": "いい流れだったよ、みんな。いいねで非表示"}, {"type": "subtitle", "time": 20016.95, "timestamp": "05:33:36", "text": "人生。うん。"}, {"type": "subtitle", "time": 20018.628, "timestamp": "05:33:38", "text": "[音楽]"}, {"type": "subtitle", "time": 20023.03, "timestamp": "05:33:43", "text": "ロバ対クモ。クモに殺される。"}, {"type": "subtitle", "time": 20024.788, "timestamp": "05:33:44", "text": "実際、可能です。あなたはできる。私は"}, {"type": "subtitle", "time": 20026.31, "timestamp": "05:33:46", "text": "クモに殺される。私は行くつもりです"}, {"type": "subtitle", "time": 20038.07, "timestamp": "05:33:58", "text": "ぶち壊せ。彼はどういう意味でそう言っているのだろうか？"}]
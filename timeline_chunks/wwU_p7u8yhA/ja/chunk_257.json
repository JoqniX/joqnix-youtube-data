[{"type": "subtitle", "time": 15421.269, "timestamp": "04:17:01", "text": "ここ。彼がリスポーンしたとき、"}, {"type": "subtitle", "time": 15424.55, "timestamp": "04:17:04", "text": "稲妻のように召喚された。私は打った"}, {"type": "subtitle", "time": 15428.79, "timestamp": "04:17:08", "text": "金庫。だから、だから私は"}, {"type": "subtitle", "time": 15430.229, "timestamp": "04:17:10", "text": "起訴された。だから、私たちは実際には"}, {"type": "subtitle", "time": 15431.83, "timestamp": "04:17:11", "text": "それについては選択する。"}, {"type": "subtitle", "time": 15434.469, "timestamp": "04:17:14", "text": "私にできる最善のことは、それを遠ざけることだった。"}, {"type": "subtitle", "time": 15435.91, "timestamp": "04:17:15", "text": "そしてそれが唯一の他の"}, {"type": "subtitle", "time": 15438.71, "timestamp": "04:17:18", "text": "解決。"}, {"type": "subtitle", "time": 15440.469, "timestamp": "04:17:20", "text": "3つまとめて充電する場合。"}, {"type": "subtitle", "time": 15442.309, "timestamp": "04:17:22", "text": "うん。そして私は彼らをうまく誘い出すことに成功した。"}, {"type": "subtitle", "time": 15443.91, "timestamp": "04:17:23", "text": "ほら、俺は狩りをして木を突き刺すんだ。"}, {"type": "subtitle", "time": 15446.469, "timestamp": "04:17:26", "text": "おお。どこだろう。"}, {"type": "subtitle", "time": 15454.07, "timestamp": "04:17:34", "text": "松ぼっくりにはどんな役割があるの？"}, {"type": "subtitle", "time": 15455.99, "timestamp": "04:17:35", "text": "松ぼっくり。うん。誰か食べ物欲しい人いる？私"}, {"type": "subtitle", "time": 15459.269, "timestamp": "04:17:39", "text": "普段から魂を食べるんだ。では、どうぞ。"}, {"type": "subtitle", "time": 15461.11, "timestamp": "04:17:41", "text": "待って。魂。"}, {"type": "subtitle", "time": 15465.269, "timestamp": "04:17:45", "text": "ああ、俺は魂を食べるんだ。何？"}, {"type": "subtitle", "time": 15466.63, "timestamp": "04:17:46", "text": "右下に行った人はいますか"}, {"type": "subtitle", "time": 15468.389, "timestamp": "04:17:48", "text": "ポータル？"}, {"type": "subtitle", "time": 15470.63, "timestamp": "04:17:50", "text": "えっと、右下がどこにあるかわかりません"}, {"type": "subtitle", "time": 15474.95, "timestamp": "04:17:54", "text": "回転するカメラを使用しているため。うん。"}, {"type": "subtitle", "time": 15477.75, "timestamp": "04:17:57", "text": "よし、ついて来い、みんな。必ず"}]
[{"type": "subtitle", "time": 5236.39, "timestamp": "01:27:16", "text": "これが、人々が言う宣伝文句なのか"}, {"type": "subtitle", "time": 5239.03, "timestamp": "01:27:19", "text": "リーグ・オブ・レジェンドとか？私はそうしない"}, {"type": "subtitle", "time": 5242.39, "timestamp": "01:27:22", "text": "理由を知りなさい。すごくかっこいいですよね？"}, {"type": "subtitle", "time": 5244.79, "timestamp": "01:27:24", "text": "[音楽]"}, {"type": "subtitle", "time": 5256.229, "timestamp": "01:27:36", "text": "まさに私の好みだ。"}, {"type": "subtitle", "time": 5258.37, "timestamp": "01:27:38", "text": "もちろん。良い。"}, {"type": "subtitle", "time": 5263.27, "timestamp": "01:27:43", "text": "[音楽]"}, {"type": "subtitle", "time": 5265.99, "timestamp": "01:27:45", "text": "ちょっと立ち寄っただけです。行かなければならない"}, {"type": "subtitle", "time": 5269.669, "timestamp": "01:27:49", "text": "もうすぐ寝る時間だ。こんにちは、また来られるようお休みください"}, {"type": "subtitle", "time": 5271.51, "timestamp": "01:27:51", "text": "そして、最善を尽くしてくれてありがとう。"}, {"type": "subtitle", "time": 5273.51, "timestamp": "01:27:53", "text": "今日。"}]
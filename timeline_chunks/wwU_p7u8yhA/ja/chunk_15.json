[{"type": "subtitle", "time": 904.79, "timestamp": "00:15:04", "text": "そんなバカじゃないよ。待って、どのバカか知ってるよね"}, {"type": "subtitle", "time": 907.03, "timestamp": "00:15:07", "text": "告げ口するよ。わかった、バカじゃないよ。あなた"}, {"type": "subtitle", "time": 909.91, "timestamp": "00:15:09", "text": "アニメで知った。私たちの"}, {"type": "subtitle", "time": 913.75, "timestamp": "00:15:13", "text": "コラコラ。"}, {"type": "subtitle", "time": 916.55, "timestamp": "00:15:16", "text": "ねえ、ベイビー。彼は何かを持っている。それは"}, {"type": "subtitle", "time": 920.47, "timestamp": "00:15:20", "text": "斧？待って。あれは斧ですか？"}, {"type": "subtitle", "time": 923.189, "timestamp": "00:15:23", "text": "大丈夫。マウスを軽くつつくよ。私は愛する"}, {"type": "subtitle", "time": 925.35, "timestamp": "00:15:25", "text": "ブーピー。ブーピー。"}, {"type": "subtitle", "time": 928.47, "timestamp": "00:15:28", "text": "少なくとも、それほど痛くはない。いいえ。ボン"}, {"type": "subtitle", "time": 940.069, "timestamp": "00:15:40", "text": "待って、私はここに立っていればいいの？"}, {"type": "subtitle", "time": 943.67, "timestamp": "00:15:43", "text": "実際、ここにいる方が良いんじゃない？"}, {"type": "subtitle", "time": 945.75, "timestamp": "00:15:45", "text": "実は、"}, {"type": "subtitle", "time": 948.55, "timestamp": "00:15:48", "text": "あなたは私にはなれない。いいえ、私はサボりません"}, {"type": "subtitle", "time": 950.31, "timestamp": "00:15:50", "text": "ボンク。"}]
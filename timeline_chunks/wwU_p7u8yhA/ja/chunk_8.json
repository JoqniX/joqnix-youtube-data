[{"type": "subtitle", "time": 483.589, "timestamp": "00:08:03", "text": "[音楽]"}, {"type": "subtitle", "time": 486.309, "timestamp": "00:08:06", "text": "と"}, {"type": "subtitle", "time": 498.95, "timestamp": "00:08:18", "text": "なぜ私はすぐには対応できないのですか？"}, {"type": "subtitle", "time": 500.95, "timestamp": "00:08:20", "text": "そうそう。だから、もしあなたが活動的でないなら、"}, {"type": "subtitle", "time": 502.71, "timestamp": "00:08:22", "text": "彼らはあなたを"}, {"type": "subtitle", "time": 514.23, "timestamp": "00:08:34", "text": "特に私は"}, {"type": "subtitle", "time": 516.949, "timestamp": "00:08:36", "text": "知らず知らずのうちに。ああ、私は初期の頃の一人です"}, {"type": "subtitle", "time": 518.55, "timestamp": "00:08:38", "text": "支持者。"}, {"type": "subtitle", "time": 520.79, "timestamp": "00:08:40", "text": "でも、まあ、大丈夫です。私はただ"}, {"type": "subtitle", "time": 523.99, "timestamp": "00:08:43", "text": "冗談だよ。私はそうは思わない、できない"}, {"type": "subtitle", "time": 526.63, "timestamp": "00:08:46", "text": "ここで多くの時間を過ごすのが好きです。"}]
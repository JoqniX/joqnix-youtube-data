[{"type": "subtitle", "time": 12244.71, "timestamp": "03:24:04", "text": "そして、来てくれたエドワードにも感謝します。本当に"}, {"type": "subtitle", "time": 12247.42, "timestamp": "03:24:07", "text": "多く。"}, {"type": "subtitle", "time": 12249.59, "timestamp": "03:24:09", "text": "[音楽]"}, {"type": "subtitle", "time": 12253.03, "timestamp": "03:24:13", "text": "ご来場ありがとうございました"}, {"type": "subtitle", "time": 12254.79, "timestamp": "03:24:14", "text": "来てくれてありがとう。"}, {"type": "subtitle", "time": 12257.99, "timestamp": "03:24:17", "text": "あなたも自分の体を大切にしてくださいね。"}, {"type": "subtitle", "time": 12264.63, "timestamp": "03:24:24", "text": "ご自身を大切にして、"}, {"type": "subtitle", "time": 12268.55, "timestamp": "03:24:28", "text": "より良い。いいえ。だから、ラッシュを試してみて"}, {"type": "subtitle", "time": 12272.07, "timestamp": "03:24:32", "text": "しかし、また画面から離れて"}, {"type": "subtitle", "time": 12274.15, "timestamp": "03:24:34", "text": "長すぎた。わかった。見て"}, {"type": "subtitle", "time": 12276.79, "timestamp": "03:24:36", "text": "いろいろだけど、"}, {"type": "subtitle", "time": 12279.75, "timestamp": "03:24:39", "text": "無理しないでください。いいえ。"}, {"type": "subtitle", "time": 12283.51, "timestamp": "03:24:43", "text": "あなたが健康で元気でいることを願っています。"}, {"type": "subtitle", "time": 12291.75, "timestamp": "03:24:51", "text": "あなたも良い一日をお過ごしください。"}, {"type": "subtitle", "time": 12294.229, "timestamp": "03:24:54", "text": "ロバート・ジャクソンが来てくれてありがとう"}, {"type": "subtitle", "time": 12297.03, "timestamp": "03:24:57", "text": "遅刻ですよ。大丈夫。"}]
[{"type": "subtitle", "time": 13143.269, "timestamp": "03:39:03", "text": "彼女は放火魔です。あなたは得る"}, {"type": "subtitle", "time": 13145.91, "timestamp": "03:39:05", "text": "火事から正気を保つ。そしてあなたのクマは"}, {"type": "subtitle", "time": 13147.51, "timestamp": "03:39:07", "text": "あなたは基本的にリーグ・オブ・レジェンドのアニーです"}, {"type": "subtitle", "time": 13150.389, "timestamp": "03:39:10", "text": "伝説。"}, {"type": "subtitle", "time": 13153.429, "timestamp": "03:39:13", "text": "リーグ・オブ・レジェンド。そうそう。基本"}, {"type": "subtitle", "time": 13155.67, "timestamp": "03:39:15", "text": "基本的には、気が狂っているなら投げればいい。"}, {"type": "subtitle", "time": 13157.429, "timestamp": "03:39:17", "text": "テディベアを地面に置いてください。それ"}, {"type": "subtitle", "time": 13161.269, "timestamp": "03:39:21", "text": "お前にとってクソみたいなことを殺すんだ。おお、"}, {"type": "subtitle", "time": 13164.55, "timestamp": "03:39:24", "text": "まるで爆弾が爆発したかのようだ。彼はロシア人だ。あなた"}, {"type": "subtitle", "time": 13165.91, "timestamp": "03:39:25", "text": "ロシア人が何をするかは、もうご存知でしょう。私"}, {"type": "subtitle", "time": 13167.19, "timestamp": "03:39:27", "text": "ロシア人が何者かを説明する必要はない。"}, {"type": "subtitle", "time": 13170.469, "timestamp": "03:39:30", "text": "うん。うん。彼は強い男だ。彼女が持っている"}, {"type": "subtitle", "time": 13173.269, "timestamp": "03:39:33", "text": "スタンド。"}, {"type": "subtitle", "time": 13175.03, "timestamp": "03:39:35", "text": "彼女は、自分のために人を殺すスタンド能力を持っている。"}, {"type": "subtitle", "time": 13181.429, "timestamp": "03:39:41", "text": "Wix。彼は歯車を食べるのが好きなんだ。"}, {"type": "subtitle", "time": 13187.75, "timestamp": "03:39:47", "text": "えっと、底は籐製です。彼女は歩いている"}, {"type": "subtitle", "time": 13191.75, "timestamp": "03:39:51", "text": "作業台。彼女も高齢だ。"}, {"type": "subtitle", "time": 13194.95, "timestamp": "03:39:54", "text": "おばあさん。"}]
[{"type": "subtitle", "time": 19622.39, "timestamp": "05:27:02", "text": "餌と釣り具の自動販売機。よお、"}, {"type": "subtitle", "time": 19626.07, "timestamp": "05:27:06", "text": "ああ、私たちももうすぐ終わりを迎えるんだ。欲しい"}, {"type": "subtitle", "time": 19628.07, "timestamp": "05:27:08", "text": "水着を持っている。"}, {"type": "subtitle", "time": 19630.23, "timestamp": "05:27:10", "text": "うん、"}, {"type": "subtitle", "time": 19632.628, "timestamp": "05:27:12", "text": "確認してみましょう"}, {"type": "subtitle", "time": 19639.83, "timestamp": "05:27:19", "text": "彼は何も得ていない。彼はそうしなかった"}, {"type": "subtitle", "time": 19641.59, "timestamp": "05:27:21", "text": "タックルはありますか。ベリーを乗せて、"}, {"type": "subtitle", "time": 19645.59, "timestamp": "05:27:25", "text": "アル。ベリーを乗せる。私は置きます"}, {"type": "subtitle", "time": 19647.59, "timestamp": "05:27:27", "text": "ベリーを乗せるだけでいいですよ。ただ"}, {"type": "subtitle", "time": 19650.868, "timestamp": "05:27:30", "text": "農園でベリーを摘んでください。拾い上げてください。"}, {"type": "subtitle", "time": 19652.868, "timestamp": "05:27:32", "text": "ここにはたくさんの秘密があるよ、みんな。何"}, {"type": "subtitle", "time": 19654.8, "timestamp": "05:27:34", "text": "くそ？みなさん、調子はどうですか？"}, {"type": "subtitle", "time": 19656.628, "timestamp": "05:27:36", "text": "[音楽]"}, {"type": "subtitle", "time": 19658.788, "timestamp": "05:27:38", "text": "わかった、わかってるよ。ねえ、知ってる？知っている"}, {"type": "subtitle", "time": 19661.03, "timestamp": "05:27:41", "text": "まさに私が望む死に方だ。知っている"}, {"type": "subtitle", "time": 19663.51, "timestamp": "05:27:43", "text": "まさに何をすべきか。誰かが私を求めていた"}, {"type": "subtitle", "time": 19666.07, "timestamp": "05:27:46", "text": "逃げる。はい。私は死ぬだろう。全て"}, {"type": "subtitle", "time": 19669.19, "timestamp": "05:27:49", "text": "右。私は彼らから離れます。何かありますか"}, {"type": "subtitle", "time": 19671.03, "timestamp": "05:27:51", "text": "誰かこの番組を実際に見たい人いる？"}, {"type": "subtitle", "time": 19674.31, "timestamp": "05:27:54", "text": "素早い？うん、その番組を見たい。"}, {"type": "subtitle", "time": 19675.75, "timestamp": "05:27:55", "text": "わかった。どこ？ああ、そこにいる"}, {"type": "subtitle", "time": 19678.708, "timestamp": "05:27:58", "text": "は。右。見てみましょう。どこはどこは"}]
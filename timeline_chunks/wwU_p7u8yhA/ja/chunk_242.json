[{"type": "subtitle", "time": 14520.79, "timestamp": "04:02:00", "text": "君ならできるよ。ツールを作ればいいんです。だから、もし"}, {"type": "subtitle", "time": 14522.309, "timestamp": "04:02:02", "text": "私たちは皆死ぬ、私たちは"}, {"type": "subtitle", "time": 14529.75, "timestamp": "04:02:09", "text": "小枝？私は自殺するつもりです。"}, {"type": "subtitle", "time": 14531.99, "timestamp": "04:02:11", "text": "そんな女の子が二人。えっと"}, {"type": "subtitle", "time": 14539.83, "timestamp": "04:02:19", "text": "これ"}, {"type": "subtitle", "time": 14541.67, "timestamp": "04:02:21", "text": "君たち。あなたたちは持っていますか？"}, {"type": "subtitle", "time": 14544.07, "timestamp": "04:02:24", "text": "PL？私たちは死ぬだろう。"}, {"type": "subtitle", "time": 14547.11, "timestamp": "04:02:27", "text": "わからない。私たちは共に死ぬ。わかった。"}, {"type": "subtitle", "time": 14548.8, "timestamp": "04:02:28", "text": "わかった。 私たちには光がある。はい。"}, {"type": "subtitle", "time": 14551.279, "timestamp": "04:02:31", "text": "私たちには光がある。はい。 私についてきてくれれば、私たちは生き残れる。"}, {"type": "subtitle", "time": 14554.0, "timestamp": "04:02:34", "text": "私についてきてくれれば、私たちは生き残れる。 わかった。夜だ。おやすみなさい。その"}, {"type": "subtitle", "time": 14555.12, "timestamp": "04:02:35", "text": "わかった。夜だ。おやすみなさい。その 今は夜です。私についてきてください。行かないで。"}, {"type": "subtitle", "time": 14557.359, "timestamp": "04:02:37", "text": "今は夜です。私についてきてください。行かないで。 ホタルが見える。ホタルが見える。"}, {"type": "subtitle", "time": 14560.8, "timestamp": "04:02:40", "text": "ホタルが見える。ホタルが見える。 ああ、鍵を調べてみます。ごきげんよう？"}, {"type": "subtitle", "time": 14564.08, "timestamp": "04:02:44", "text": "ああ、鍵を調べてみます。ごきげんよう？ 鍵を調べます。"}, {"type": "subtitle", "time": 14573.99, "timestamp": "04:02:53", "text": "すぐに終わるだろう。私の"}, {"type": "subtitle", "time": 14576.71, "timestamp": "04:02:56", "text": "人生。楽しい。"}, {"type": "subtitle", "time": 14579.99, "timestamp": "04:02:59", "text": "これらのアイテムはどうやって入手するのですか？"}]
[{"type": "subtitle", "time": 17584.948, "timestamp": "04:53:04", "text": "もう食べ物がない。それは"}, {"type": "subtitle", "time": 17586.948, "timestamp": "04:53:06", "text": "私が手に入れた唯一の食べ物。歩き回って見つける"}, {"type": "subtitle", "time": 17589.51, "timestamp": "04:53:09", "text": "食べ物。ただ周りを回って"}, {"type": "subtitle", "time": 17591.19, "timestamp": "04:53:11", "text": "まるでベリーがあるみたいだ。ベリーがあります"}, {"type": "subtitle", "time": 17593.11, "timestamp": "04:53:13", "text": "あそこに茂みがあります。それをつかむことができます"}, {"type": "subtitle", "time": 17596.55, "timestamp": "04:53:16", "text": "もの。どこ？こちらです。こちらです。"}, {"type": "subtitle", "time": 17602.628, "timestamp": "04:53:22", "text": "いいえ。"}, {"type": "subtitle", "time": 17604.55, "timestamp": "04:53:24", "text": "一緒に。"}, {"type": "subtitle", "time": 17607.99, "timestamp": "04:53:27", "text": "食べ物があります。食べ物があります。何？いいえ。私は"}, {"type": "subtitle", "time": 17618.47, "timestamp": "04:53:38", "text": "床から食べ物を拾うこともできます。来る"}, {"type": "subtitle", "time": 17621.75, "timestamp": "04:53:41", "text": "の上。うん。自分で食べ物を取りに行かなければならない。"}, {"type": "subtitle", "time": 17623.19, "timestamp": "04:53:43", "text": "私も食料が尽きかけています。で"}, {"type": "subtitle", "time": 17625.59, "timestamp": "04:53:45", "text": "最小のモンスター"}, {"type": "subtitle", "time": 17627.35, "timestamp": "04:53:47", "text": "ああ、あのね？ズキと同じように、私も"}, {"type": "subtitle", "time": 17629.35, "timestamp": "04:53:49", "text": "持っている"}, {"type": "subtitle", "time": 17631.27, "timestamp": "04:53:51", "text": "待って。これを受け取って。これを受け取って。これを受け取って、"}, {"type": "subtitle", "time": 17634.708, "timestamp": "04:53:54", "text": "ズキ。何を取るのか？"}, {"type": "subtitle", "time": 17637.19, "timestamp": "04:53:57", "text": "うん、ズキ。来て。私は、私は"}, {"type": "subtitle", "time": 17638.868, "timestamp": "04:53:58", "text": "あなたを導く。つまり、ジョーも恩恵を受けるということだ。"}]
[{"type": "subtitle", "time": 19800.948, "timestamp": "05:30:00", "text": "誰かがあなたに食べ物を与えてください。ああ、私のところへ来なさい。"}, {"type": "subtitle", "time": 19802.868, "timestamp": "05:30:02", "text": "私は"}, {"type": "subtitle", "time": 19803.83, "timestamp": "05:30:03", "text": "私にとってはそうだけど、君にとっては命取りになるよ。"}, {"type": "subtitle", "time": 19806.39, "timestamp": "05:30:06", "text": "実は、私も1つ手に入れました。持続する。いいえ。決して。"}, {"type": "subtitle", "time": 19810.548, "timestamp": "05:30:10", "text": "心。どうでも。"}, {"type": "subtitle", "time": 19813.59, "timestamp": "05:30:13", "text": "ああ、くそ。いいえ。ああ、実際に手に入れる必要がある"}, {"type": "subtitle", "time": 19816.47, "timestamp": "05:30:16", "text": "キャンプファイヤーを楽しむ人もいる"}, {"type": "subtitle", "time": 19819.83, "timestamp": "05:30:19", "text": "ここ。よし、これでいい。はい。"}, {"type": "subtitle", "time": 19835.83, "timestamp": "05:30:35", "text": "みんな死んでいく。"}, {"type": "subtitle", "time": 19837.83, "timestamp": "05:30:37", "text": "降りるな。そちらには行かなかった"}, {"type": "subtitle", "time": 19841.43, "timestamp": "05:30:41", "text": "どうしたの？やあ、相棒。ああ、よう。おい。"}, {"type": "subtitle", "time": 19845.67, "timestamp": "05:30:45", "text": "よう、元気かい？元気かい？おお、"}, {"type": "subtitle", "time": 19847.51, "timestamp": "05:30:47", "text": "なぜここでみんな死んでしまったのか？おお、"}, {"type": "subtitle", "time": 19848.948, "timestamp": "05:30:48", "text": "全員死んでしまった。私たち３人だけです"}, {"type": "subtitle", "time": 19851.99, "timestamp": "05:30:51", "text": "左。ああ、みんな死んでしまった。私は"}, {"type": "subtitle", "time": 19858.23, "timestamp": "05:30:58", "text": "ちなみに、ハウンドウェーブです。幸運を。おお、"}]
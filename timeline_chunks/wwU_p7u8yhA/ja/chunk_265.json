[{"type": "subtitle", "time": 15900.229, "timestamp": "04:25:00", "text": "Yは絶対に手に入れる必要がある。待って、それで誰が"}, {"type": "subtitle", "time": 15902.469, "timestamp": "04:25:02", "text": "アビゲイル？"}, {"type": "subtitle", "time": 15905.189, "timestamp": "04:25:05", "text": "それが立場だ。また、スズキはどこにいるのか"}, {"type": "subtitle", "time": 15907.83, "timestamp": "04:25:07", "text": "スズキはあそこにいるの？スズキはどこにいる？"}, {"type": "subtitle", "time": 15910.389, "timestamp": "04:25:10", "text": "あなたは次の助けが少なくなるでしょう"}, {"type": "subtitle", "time": 15912.71, "timestamp": "04:25:12", "text": "亜酸化窒素の中で？あなたは花です。あなたの"}, {"type": "subtitle", "time": 15914.95, "timestamp": "04:25:14", "text": "花。ええ、蘇生すると、"}, {"type": "subtitle", "time": 15917.83, "timestamp": "04:25:17", "text": "自分の最大能力値を手に入れましょう。"}, {"type": "subtitle", "time": 15920.469, "timestamp": "04:25:20", "text": "よし、これでいい。これがあなたの立場です。うん、"}, {"type": "subtitle", "time": 15921.91, "timestamp": "04:25:21", "text": "彼女はしばらくの間、閉じ込められていた。あなた"}, {"type": "subtitle", "time": 15925.51, "timestamp": "04:25:25", "text": "彼女とは取引していません。私はしませんでした。私は持っていた"}, {"type": "subtitle", "time": 15927.83, "timestamp": "04:25:27", "text": "地図を確認する。"}, {"type": "subtitle", "time": 15929.59, "timestamp": "04:25:29", "text": "彼女はまるで自動いいねみたい"}, {"type": "subtitle", "time": 15931.59, "timestamp": "04:25:31", "text": "ここから攻撃してくる男。私は違います"}, {"type": "subtitle", "time": 15934.389, "timestamp": "04:25:34", "text": "もちろん。"}, {"type": "subtitle", "time": 15937.99, "timestamp": "04:25:37", "text": "わからない。道に迷ってしまった。"}, {"type": "subtitle", "time": 15939.51, "timestamp": "04:25:39", "text": "それができないなら、"}, {"type": "subtitle", "time": 15942.95, "timestamp": "04:25:42", "text": "ボート。うん、ボートを作ろう。高い。の"}, {"type": "subtitle", "time": 15946.79, "timestamp": "04:25:46", "text": "どういう意味だよ？ボートを手に入れろ。"}, {"type": "subtitle", "time": 15948.79, "timestamp": "04:25:48", "text": "たった5本のウッドだよ。大丈夫。私たちは"}, {"type": "subtitle", "time": 15950.229, "timestamp": "04:25:50", "text": "大丈夫。あなたは科学実験装置を持っていません。"}, {"type": "subtitle", "time": 15953.03, "timestamp": "04:25:53", "text": "私はシンクタンクを設立します。ああ、私は"}, {"type": "subtitle", "time": 15955.11, "timestamp": "04:25:55", "text": "科学機械。"}, {"type": "subtitle", "time": 15957.03, "timestamp": "04:25:57", "text": "ああ、シンクタンク入り、頑張ってね。そして"}, {"type": "subtitle", "time": 15958.87, "timestamp": "04:25:58", "text": "それから、たくさんの板。なぜ私たちは"}]
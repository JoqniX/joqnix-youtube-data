[{"type": "subtitle", "time": 18061.99, "timestamp": "05:01:01", "text": "全部持って行ってください。うん。下。下。"}, {"type": "subtitle", "time": 18065.43, "timestamp": "05:01:05", "text": "下。わかった。荷物を持って行ってください。おお、"}, {"type": "subtitle", "time": 18067.35, "timestamp": "05:01:07", "text": "君の妹は死んだ。妹が亡くなった。さあ"}, {"type": "subtitle", "time": 18073.03, "timestamp": "05:01:13", "text": "あなたの荷物はここにあります。私はクリックします"}, {"type": "subtitle", "time": 18077.19, "timestamp": "05:01:17", "text": "もの。これはあなたの持ち物です。ここに物がある。"}, {"type": "subtitle", "time": 18079.19, "timestamp": "05:01:19", "text": "ああ、こっちにも物があるよ。そこには"}, {"type": "subtitle", "time": 18082.07, "timestamp": "05:01:22", "text": "私たちの荷物は木々の間に隠してあります。"}, {"type": "subtitle", "time": 18089.83, "timestamp": "05:01:29", "text": "何か物を手に入れろ。はい。全部持って行ってください。"}, {"type": "subtitle", "time": 18092.23, "timestamp": "05:01:32", "text": "はい。"}, {"type": "subtitle", "time": 18095.51, "timestamp": "05:01:35", "text": "こちらです。荷物を拾ってきてください。"}, {"type": "subtitle", "time": 18103.11, "timestamp": "05:01:43", "text": "誰が癒しを必要としているのか？"}, {"type": "subtitle", "time": 18106.39, "timestamp": "05:01:46", "text": "私は癒しを必要としている。たくさんの癒し。感謝"}, {"type": "subtitle", "time": 18109.99, "timestamp": "05:01:49", "text": "あなた。私もです。"}, {"type": "subtitle", "time": 18112.868, "timestamp": "05:01:52", "text": "やばい。誰もが癒しを必要としている。うん、"}, {"type": "subtitle", "time": 18115.51, "timestamp": "05:01:55", "text": "あれはひどかった。"}, {"type": "subtitle", "time": 18118.47, "timestamp": "05:01:58", "text": "ありがとうございます、上院議員。ええ、どういたしまして。病気"}]
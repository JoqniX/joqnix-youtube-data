[{"type": "subtitle", "time": 4987.59, "timestamp": "01:23:07", "text": "着実に進んでいます。もう時間の問題だ。ああ、"}, {"type": "subtitle", "time": 4988.63, "timestamp": "01:23:08", "text": "神。"}, {"type": "subtitle", "time": 5007.27, "timestamp": "01:23:27", "text": "[音楽]"}, {"type": "subtitle", "time": 5023.1, "timestamp": "01:23:43", "text": "私はHP1です。慈悲は癒す。"}, {"type": "subtitle", "time": 5024.95, "timestamp": "01:23:44", "text": "[音楽]"}, {"type": "subtitle", "time": 5030.31, "timestamp": "01:23:50", "text": "あ、待って。私たちは死ぬ。何だって？"}, {"type": "subtitle", "time": 5037.669, "timestamp": "01:23:57", "text": "この戦車はなかなか破壊できない。"}]
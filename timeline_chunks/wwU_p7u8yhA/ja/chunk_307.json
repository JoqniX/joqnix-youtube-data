[{"type": "subtitle", "time": 18426.628, "timestamp": "05:07:06", "text": "これを入れようと思うんだけど。"}, {"type": "subtitle", "time": 18432.31, "timestamp": "05:07:12", "text": "ああ、俺はここでは何の役にも立たない。冗談ですか"}, {"type": "subtitle", "time": 18433.83, "timestamp": "05:07:13", "text": "自分？"}, {"type": "subtitle", "time": 18435.51, "timestamp": "05:07:15", "text": "待って、"}, {"type": "subtitle", "time": 18437.11, "timestamp": "05:07:17", "text": "誰か他に食べ物を持ってる人いる？"}, {"type": "subtitle", "time": 18438.868, "timestamp": "05:07:18", "text": "食料箱？"}, {"type": "subtitle", "time": 18442.628, "timestamp": "05:07:22", "text": "私はここに少しアクセスしています。"}, {"type": "subtitle", "time": 18444.788, "timestamp": "05:07:24", "text": "胸に巨大な肉が乗っている。私は手に入れている"}, {"type": "subtitle", "time": 18448.628, "timestamp": "05:07:28", "text": "そこに。私は死んだ。"}, {"type": "subtitle", "time": 18452.04, "timestamp": "05:07:32", "text": "まあ、あなたは正気じゃないわね。"}, {"type": "subtitle", "time": 18454.47, "timestamp": "05:07:34", "text": "[音楽]"}, {"type": "subtitle", "time": 18455.75, "timestamp": "05:07:35", "text": "あれ、食料箱はどこだったっけ？"}, {"type": "subtitle", "time": 18458.07, "timestamp": "05:07:38", "text": "食料箱はどれですか？非常識な。おお、"}, {"type": "subtitle", "time": 18460.23, "timestamp": "05:07:40", "text": "それは良い兆候ではない。えーと、"}, {"type": "subtitle", "time": 18463.67, "timestamp": "05:07:43", "text": "妹とか、そんな感じの人。"}, {"type": "subtitle", "time": 18467.19, "timestamp": "05:07:47", "text": "スズクはそれが何なのか知らない。私は"}, {"type": "subtitle", "time": 18471.67, "timestamp": "05:07:51", "text": "私が計画を全部素早く実行している間。"}, {"type": "subtitle", "time": 18473.03, "timestamp": "05:07:53", "text": "あのね？持続する。ええと、できると思います"}, {"type": "subtitle", "time": 18474.55, "timestamp": "05:07:54", "text": "主のもとへ行くことをあなたにとって困難にする。持続する。"}]
[{"type": "subtitle", "time": 17701.91, "timestamp": "04:55:01", "text": "調理するべきでしょうか？私はスターです"}, {"type": "subtitle", "time": 17708.31, "timestamp": "04:55:08", "text": "よし。また、この蝶の羽は"}, {"type": "subtitle", "time": 17711.11, "timestamp": "04:55:11", "text": "お前らは癒しに飢えてるんだな。"}, {"type": "subtitle", "time": 17715.99, "timestamp": "04:55:15", "text": "飛びついてやってはいけません。バイバイ。"}, {"type": "subtitle", "time": 17718.868, "timestamp": "04:55:18", "text": "あの女をぶん殴らせてくれ。おい、"}, {"type": "subtitle", "time": 17721.03, "timestamp": "04:55:21", "text": "ズキ、どこにいるの？ああ、それはとても"}, {"type": "subtitle", "time": 17722.948, "timestamp": "04:55:22", "text": "動作が遅い。シングルパンチすら打てない。"}, {"type": "subtitle", "time": 17729.99, "timestamp": "04:55:29", "text": "誰か何とかしてくれ。"}, {"type": "subtitle", "time": 17731.43, "timestamp": "04:55:31", "text": "ああ、こっちへ来い。農業をしよう"}, {"type": "subtitle", "time": 17732.948, "timestamp": "04:55:32", "text": "カエルたち。"}, {"type": "subtitle", "time": 17737.35, "timestamp": "04:55:37", "text": "いらっしゃいませ。犬よ、ベリーを見つけてくれるかい？"}, {"type": "subtitle", "time": 17739.35, "timestamp": "04:55:39", "text": "えっと、種は食べられますよね？得る"}, {"type": "subtitle", "time": 17742.47, "timestamp": "04:55:42", "text": "種子。種はどこにあるの？以上"}, {"type": "subtitle", "time": 17744.628, "timestamp": "04:55:44", "text": "私の体の上に。種子は"}, {"type": "subtitle", "time": 17747.43, "timestamp": "04:55:47", "text": "地面に散乱していた。私がその人です"}, {"type": "subtitle", "time": 17749.51, "timestamp": "04:55:49", "text": "クソを植える。それを私に渡してください。おお、"}, {"type": "subtitle", "time": 17752.868, "timestamp": "04:55:52", "text": "待って。私はそれをスージーにあげました。"}, {"type": "subtitle", "time": 17756.65, "timestamp": "04:55:56", "text": "姉さん、種をちょうだい。お腹が空きました。"}, {"type": "subtitle", "time": 17759.11, "timestamp": "04:55:59", "text": "[笑い]"}]
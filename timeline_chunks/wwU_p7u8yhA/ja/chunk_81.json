[{"type": "subtitle", "time": 4865.75, "timestamp": "01:21:05", "text": "これはなかなか良いですね。この写真が大好きです。"}, {"type": "subtitle", "time": 4869.189, "timestamp": "01:21:09", "text": "しかし、子供にとっては、"}, {"type": "subtitle", "time": 4871.99, "timestamp": "01:21:11", "text": "あなたの言う通りだと思います。私はロケットが好きです"}, {"type": "subtitle", "time": 4876.149, "timestamp": "01:21:16", "text": "ランチャーグレネードのような拍手、"}, {"type": "subtitle", "time": 4909.669, "timestamp": "01:21:49", "text": "それは私一人です。私との一対一の勝負です"}]
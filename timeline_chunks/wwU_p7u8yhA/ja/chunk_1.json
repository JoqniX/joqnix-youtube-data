[{"type": "subtitle", "time": 63.75, "timestamp": "00:01:03", "text": "このフレームはクラッシュしますか？何？え、何？"}, {"type": "subtitle", "time": 67.27, "timestamp": "00:01:07", "text": "え、何？この列車は脱線した。"}, {"type": "subtitle", "time": 69.35, "timestamp": "00:01:09", "text": "え、何？"}, {"type": "subtitle", "time": 72.789, "timestamp": "00:01:12", "text": "ああ、大変だ。公園から出てきたところです。"}, {"type": "subtitle", "time": 75.27, "timestamp": "00:01:15", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 77.429, "timestamp": "00:01:17", "text": "聖なる。"}, {"type": "subtitle", "time": 81.59, "timestamp": "00:01:21", "text": "ああ、大変だ。私を支持しないでください。"}, {"type": "subtitle", "time": 86.149, "timestamp": "00:01:26", "text": "だから、ただ手をドライヤーで乾かしているだけなんです。だから違う"}, {"type": "subtitle", "time": 90.55, "timestamp": "00:01:30", "text": "嘘をつくつもりだ。ええと、温かいお湯"}, {"type": "subtitle", "time": 92.55, "timestamp": "00:01:32", "text": "実際に役立つ。"}, {"type": "subtitle", "time": 96.069, "timestamp": "00:01:36", "text": "そうだったと思う。"}, {"type": "subtitle", "time": 98.069, "timestamp": "00:01:38", "text": "ええ、そうだと思います。うん、そう思う"}, {"type": "subtitle", "time": 105.91, "timestamp": "00:01:45", "text": "右。"}, {"type": "subtitle", "time": 109.19, "timestamp": "00:01:49", "text": "えーと、そろそろ交代する時間です"}, {"type": "subtitle", "time": 111.50999999999999, "timestamp": "00:01:51", "text": "騎手を想像してみてください。"}, {"type": "subtitle", "time": 115.67, "timestamp": "00:01:55", "text": "でも私は騎手です。"}, {"type": "subtitle", "time": 118.95, "timestamp": "00:01:58", "text": "それを待っていてください。つまり、"}]
[{"type": "subtitle", "time": 12123.19, "timestamp": "03:22:03", "text": "えっと、新しいものについて話していたんだけど"}, {"type": "subtitle", "time": 12126.79, "timestamp": "03:22:06", "text": "実験して、"}, {"type": "subtitle", "time": 12129.349, "timestamp": "03:22:09", "text": "Twitterやその他から人々を呼び込む"}, {"type": "subtitle", "time": 12131.19, "timestamp": "03:22:11", "text": "他のプラットフォームで彼らが潜伏しているような場合"}, {"type": "subtitle", "time": 12134.79, "timestamp": "03:22:14", "text": "あるいは、彼らが何を期待できるかを私が期待できるように"}, {"type": "subtitle", "time": 12137.03, "timestamp": "03:22:17", "text": "そう、だから彼らはこのビデオを見て"}, {"type": "subtitle", "time": 12139.75, "timestamp": "03:22:19", "text": "彼らが期待できることは"}, {"type": "subtitle", "time": 12142.389, "timestamp": "03:22:22", "text": "ストリームに対する期待を与えるような"}, {"type": "subtitle", "time": 12144.63, "timestamp": "03:22:24", "text": "いいね、または何が起こるかの要約"}, {"type": "subtitle", "time": 12147.11, "timestamp": "03:22:27", "text": "私のストリーミングとその他すべてのものは何ですか"}, {"type": "subtitle", "time": 12149.429, "timestamp": "03:22:29", "text": "本日は、このイベントが開催されます。まるで"}, {"type": "subtitle", "time": 12152.71, "timestamp": "03:22:32", "text": "スケジュールですが、"}, {"type": "subtitle", "time": 12155.91, "timestamp": "03:22:35", "text": "その日のやることリストみたいなもの。ええ、私は"}, {"type": "subtitle", "time": 12158.309, "timestamp": "03:22:38", "text": "うまくいくといいですね。こんにちは。とにかく、これで終わりにします"}, {"type": "subtitle", "time": 12163.83, "timestamp": "03:22:43", "text": "5時までに行かなきゃいけないから、早くして。こんにちは。それで、"}, {"type": "subtitle", "time": 12165.51, "timestamp": "03:22:45", "text": "そして、今日来てくださったすべての方々にも感謝いたします。"}, {"type": "subtitle", "time": 12167.269, "timestamp": "03:22:47", "text": "おお、"}, {"type": "subtitle", "time": 12169.99, "timestamp": "03:22:49", "text": "これから雪が降る予報。さようなら、スノーウィー。ありがとう。"}, {"type": "subtitle", "time": 12173.03, "timestamp": "03:22:53", "text": "そして、来てくれてありがとう、アキビ。そして海石は"}, {"type": "subtitle", "time": 12176.63, "timestamp": "03:22:56", "text": "来るよ。そして秋野さん、ありがとう"}, {"type": "subtitle", "time": 12179.99, "timestamp": "03:22:59", "text": "たくさんの男が私に与えてくれる、えっと"}]
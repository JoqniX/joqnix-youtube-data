[{"type": "subtitle", "time": 18608.31, "timestamp": "05:10:08", "text": "うわー、HPをすごく消費するな。"}, {"type": "subtitle", "time": 18611.51, "timestamp": "05:10:11", "text": "スパイダーグラスの優位性。"}, {"type": "subtitle", "time": 18613.43, "timestamp": "05:10:13", "text": "私はただ草を集めているだけです"}, {"type": "subtitle", "time": 18616.07, "timestamp": "05:10:16", "text": "この点です。よし、もう一度戻るよ"}, {"type": "subtitle", "time": 18618.15, "timestamp": "05:10:18", "text": "ここ。私は演奏の仕方を学んでいるところです"}, {"type": "subtitle", "time": 18621.75, "timestamp": "05:10:21", "text": "ゲーム。ああ、草が生えている。ジョック。得る"}, {"type": "subtitle", "time": 18623.35, "timestamp": "05:10:23", "text": "こっちだよ、ジョック。食べ物を手に入れた"}, {"type": "subtitle", "time": 18626.39, "timestamp": "05:10:26", "text": "あなたのために。ああ、そこだ。これを手に入れて"}, {"type": "subtitle", "time": 18629.51, "timestamp": "05:10:29", "text": "まずはこちらをどうぞ。あなたは食べる。"}, {"type": "subtitle", "time": 18630.868, "timestamp": "05:10:30", "text": "シングルプレイでこのゲームを気軽に試してみてください"}, {"type": "subtitle", "time": 18632.39, "timestamp": "05:10:32", "text": "ちなみに、その選手は鈴木選手です。あなたはできる"}, {"type": "subtitle", "time": 18634.39, "timestamp": "05:10:34", "text": "実際、このゲームがどれほど難しいか教えてください。"}, {"type": "subtitle", "time": 18637.19, "timestamp": "05:10:37", "text": "うん、このゲームは難しいね。"}, {"type": "subtitle", "time": 18639.91, "timestamp": "05:10:39", "text": "ああ、ロンが"}, {"type": "subtitle", "time": 18643.35, "timestamp": "05:10:43", "text": "私の子守りをしてくれる人。"}, {"type": "subtitle", "time": 18645.43, "timestamp": "05:10:45", "text": "じゃあ、さようなら。ベビーシッター1～2人"}, {"type": "subtitle", "time": 18647.75, "timestamp": "05:10:47", "text": "人々は大丈夫です。"}, {"type": "subtitle", "time": 18653.99, "timestamp": "05:10:53", "text": "わかった。ねえ、私は子守りをする必要はないよ"}, {"type": "subtitle", "time": 18656.788, "timestamp": "05:10:56", "text": "セルゼンとあなた。"}]
[{"type": "subtitle", "time": 19261.35, "timestamp": "05:21:01", "text": "私にさせて"}, {"type": "subtitle", "time": 19265.19, "timestamp": "05:21:05", "text": "このトゲの巣を破壊せよ。はい、とても"}, {"type": "subtitle", "time": 19269.51, "timestamp": "05:21:09", "text": "非常に迷惑だ。えっと、こっちに来てください。"}, {"type": "subtitle", "time": 19272.47, "timestamp": "05:21:12", "text": "どこ？鈴木、行け！あなたが行く。高い"}, {"type": "subtitle", "time": 19276.07, "timestamp": "05:21:16", "text": "今、私の健康状態は良好です。攻撃"}, {"type": "subtitle", "time": 19277.43, "timestamp": "05:21:17", "text": "何かが攻撃していることに気づく。"}, {"type": "subtitle", "time": 19279.19, "timestamp": "05:21:19", "text": "それと、私はただ待つだけです。食べなきゃ"}, {"type": "subtitle", "time": 19281.51, "timestamp": "05:21:21", "text": "何か。ちょっと待ってください。私は殺した"}, {"type": "subtitle", "time": 19287.35, "timestamp": "05:21:27", "text": "蜘蛛の戦士。こいつを殺してやる。ただ"}, {"type": "subtitle", "time": 19293.51, "timestamp": "05:21:33", "text": "走る。そうそう。彼を殴れ。騎手。はい。"}, {"type": "subtitle", "time": 19297.11, "timestamp": "05:21:37", "text": "また。ついに。何かをした。"}, {"type": "subtitle", "time": 19300.23, "timestamp": "05:21:40", "text": "えっと、皆さんの中に蝶々みたいなのを飼っている人はいますか？"}, {"type": "subtitle", "time": 19301.99, "timestamp": "05:21:41", "text": "翼を作って、"}, {"type": "subtitle", "time": 19304.55, "timestamp": "05:21:44", "text": "ミートボール。ミートボール。"}, {"type": "subtitle", "time": 19307.59, "timestamp": "05:21:47", "text": "残念ながら、私はそれを持っていません。"}, {"type": "subtitle", "time": 19310.23, "timestamp": "05:21:50", "text": "左クリックを押す必要があります"}, {"type": "subtitle", "time": 19314.07, "timestamp": "05:21:54", "text": "それを殺す権利がある。私は肉を食べなかった。"}, {"type": "subtitle", "time": 19315.67, "timestamp": "05:21:55", "text": "実は、"}, {"type": "subtitle", "time": 19318.708, "timestamp": "05:21:58", "text": "食べ物が必要だ。"}]
[{"type": "subtitle", "time": 9423.51, "timestamp": "02:37:03", "text": "這麼多黃金。  就像在看一座雕像。  他會走過來問：「什麼？你們在這邊發現了什麼？這個呢？發生了什麼事？"}, {"type": "subtitle", "time": 9428.87, "timestamp": "02:37:08", "text": "你們找到什麼好東西了嗎？」"}, {"type": "subtitle", "time": 9430.63, "timestamp": "02:37:10", "text": "克里斯汀打開裡面，嗯，就是這樣。裡面有55枚金幣。"}, {"type": "subtitle", "time": 9432.389, "timestamp": "02:37:12", "text": "嗯，我覺得"}, {"type": "subtitle", "time": 9449.99, "timestamp": "02:37:29", "text": "克里斯彭可能找到了你錯過的那部分黃金。  哦，那太好了。  是"}, {"type": "subtitle", "time": 9458.389, "timestamp": "02:37:38", "text": "啊，"}, {"type": "subtitle", "time": 9460.71, "timestamp": "02:37:40", "text": "有些討厭的"}, {"type": "subtitle", "time": 9462.389, "timestamp": "02:37:42", "text": "偷錢賊到處亂竄，因為她不知道，我覺得她可能"}, {"type": "subtitle", "time": 9463.59, "timestamp": "02:37:43", "text": "都不知道"}, {"type": "subtitle", "time": 9466.23, "timestamp": "02:37:46", "text": "衣櫃是什麼。"}, {"type": "subtitle", "time": 9468.07, "timestamp": "02:37:48", "text": "Lotus或許會，但她不會。  好吧，我應該要做個遊戲，"}, {"type": "subtitle", "time": 9479.99, "timestamp": "02:37:59", "text": "我會說歷史或生存。"}]
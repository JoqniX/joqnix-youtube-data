[{"type": "subtitle", "time": 5769.27, "timestamp": "01:36:09", "text": "的人是Ariana。嗯，Hanan說"}, {"type": "subtitle", "time": 5777.59, "timestamp": "01:36:17", "text": "如果我們能設法把"}, {"type": "subtitle", "time": 5779.51, "timestamp": "01:36:19", "text": "這些東西弄出來，我們就能把它拉出來"}, {"type": "subtitle", "time": 5781.51, "timestamp": "01:36:21", "text": "。它是我的金板，還是真的是純金。來。 嗯，"}, {"type": "subtitle", "time": 5787.99, "timestamp": "01:36:27", "text": "我想這可能是個好辦法。為什麼它顯示這是我的令牌。 ...看看它"}, {"type": "subtitle", "time": 5792.31, "timestamp": "01:36:32", "text": "，"}, {"type": "subtitle", "time": 5794.55, "timestamp": "01:36:34", "text": "還是你想調查一下？看看它有沒有什麼奇怪的地方。"}, {"type": "subtitle", "time": 5800.629, "timestamp": "01:36:40", "text": "哦，對。調查一下，比如這金子是不是有什麼特別之處？我猜她正在看的就是這個。好的。"}, {"type": "subtitle", "time": 5805.27, "timestamp": "01:36:45", "text": "我們可以調查了嗎？好的。我得調查一下我的斯特凡。我還要調查一下克里斯平。好的。"}]
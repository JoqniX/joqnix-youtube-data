[{"type": "subtitle", "time": 1680.389, "timestamp": "00:28:00", "text": "討厭"}, {"type": "subtitle", "time": 1682.31, "timestamp": "00:28:02", "text": "卡蜜拉。  嗯，是的。  還有一種情況是，如果"}, {"type": "subtitle", "time": 1686.389, "timestamp": "00:28:06", "text": "最後的結果又像鋼琴那場戰鬥一樣，只有神村一個人站著。"}, {"type": "subtitle", "time": 1687.11, "timestamp": "00:28:07", "text": "我的天哪。  我相信任何問題都會解決。  我以為你會說，如果就像鋼琴大戰那樣，"}, {"type": "subtitle", "time": 1698.71, "timestamp": "00:28:18", "text": "卡蜜拉就什麼都沒打到"}, {"type": "subtitle", "time": 1701.909, "timestamp": "00:28:21", "text": "。  我認為這也是事實。  哦，沒關係"}, {"type": "subtitle", "time": 1706.87, "timestamp": "00:28:26", "text": "。聽起來也很準確。卡蜜拉不會再打人了，因為她不知為何總是"}, {"type": "subtitle", "time": 1710.789, "timestamp": "00:28:30", "text": "打不中。  卡米拉沒有去做眼科檢查。  我覺得達里安有這條胳膊，對吧？達里安有這條手臂嗎？我居然"}, {"type": "subtitle", "time": 1711.75, "timestamp": "00:28:31", "text": "忘了Burst。是的"}, {"type": "subtitle", "time": 1723.669, "timestamp": "00:28:43", "text": "手段。"}, {"type": "subtitle", "time": 1733.269, "timestamp": "00:28:53", "text": "我從來沒用過。"}, {"type": "subtitle", "time": 1737.029, "timestamp": "00:28:57", "text": "耶穌基督。對不起。不是因為我的"}, {"type": "subtitle", "time": 1738.63, "timestamp": "00:28:58", "text": "喉嚨裡卡了一塊該死的蜂蜜奶油巧克力片。  你看到的不僅僅是被掐住脖子。"}]
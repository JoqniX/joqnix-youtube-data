[{"type": "subtitle", "time": 4577.75, "timestamp": "01:16:17", "text": "滴答。停。滴答。停。哦，天哪。別再"}, {"type": "subtitle", "time": 4580.63, "timestamp": "01:16:20", "text": "談論該死的股票市場了。嘿，嘿，"}, {"type": "subtitle", "time": 4591.43, "timestamp": "01:16:31", "text": "魔鬼先生，你能帶我們去見我們的……朋友嗎？他們說：「哦，是的，"}, {"type": "subtitle", "time": 4605.669, "timestamp": "01:16:45", "text": "他們…他們在這裡。」 「跟我來。」對，跟我來。走吧"}, {"type": "subtitle", "time": 4611.03, "timestamp": "01:16:51", "text": "。好的，我們去和朋友碰面。你剛才看到這傢伙在"}, {"type": "subtitle", "time": 4617.43, "timestamp": "01:16:57", "text": "拖地。跟朋友們聊聊。和上次相比，現在安靜多了。上次大家都在歡呼。現在就像大家都在打掃。那個傢伙就"}]
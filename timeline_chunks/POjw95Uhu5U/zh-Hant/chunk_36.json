[{"type": "subtitle", "time": 2165.43, "timestamp": "00:36:05", "text": "。你不跟你的植物"}, {"type": "subtitle", "time": 2169.43, "timestamp": "00:36:09", "text": "說話嗎？我跟我的植物說話。"}, {"type": "subtitle", "time": 2174.47, "timestamp": "00:36:14", "text": "我連計畫都沒有，因為我的大拇指很不好。  我誇獎我的仙人掌的次數比誇獎我的"}, {"type": "subtitle", "time": 2204.069, "timestamp": "00:36:44", "text": "都會死。  哦親愛的。  我。  等等，不對"}]
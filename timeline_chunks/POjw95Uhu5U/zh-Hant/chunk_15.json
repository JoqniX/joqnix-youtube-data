[{"type": "subtitle", "time": 902.629, "timestamp": "00:15:02", "text": "我喜歡貶低自己。  我特別喜歡和你辯論。  我也很喜歡對我們的劇本做這樣的修改。  哦"}, {"type": "subtitle", "time": 918.15, "timestamp": "00:15:18", "text": "親愛的。  我喜歡"}, {"type": "subtitle", "time": 934.87, "timestamp": "00:15:34", "text": "直接私訊 Grim 信，而"}, {"type": "subtitle", "time": 939.91, "timestamp": "00:15:39", "text": "不是"}, {"type": "subtitle", "time": 942.389, "timestamp": "00:15:42", "text": "打招呼。我覺得我比你強。"}, {"type": "subtitle", "time": 946.389, "timestamp": "00:15:46", "text": "嚴峻。我今天說過，你知道，我喜歡咬你，吃你，打你。今天我說我比你先一步到達了格里米那裡"}, {"type": "subtitle", "time": 958.87, "timestamp": "00:15:58", "text": "。然後格林說：「呃，要嘛給布魯斯，要嘛就死。」我當時就想，「布魯斯，結局以後再說。」 我現在"}]
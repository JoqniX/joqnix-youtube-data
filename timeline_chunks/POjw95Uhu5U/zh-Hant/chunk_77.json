[{"type": "subtitle", "time": 4628.39, "timestamp": "01:17:08", "text": "在拖地，撿垃圾"}, {"type": "subtitle", "time": 4635.27, "timestamp": "01:17:15", "text": "。你確定他們沒有把所有股票都賣光嗎？別再想股票了。股票。你能不能聊點別的，別聊股市？現在不是聊這個的時候。是敵人的"}, {"type": "subtitle", "time": 4637.669, "timestamp": "01:17:17", "text": "股市嗎？不是股市。那是另一"}, {"type": "subtitle", "time": 4646.79, "timestamp": "01:17:26", "text": "回事。好吧，我們來談談"}, {"type": "subtitle", "time": 4655.27, "timestamp": "01:17:35", "text": "股市吧。好的，我過去一下。我快速地做一下。我來揭曉一下"}, {"type": "subtitle", "time": 4662.95, "timestamp": "01:17:42", "text": "。"}, {"type": "subtitle", "time": 4665.75, "timestamp": "01:17:45", "text": "好的。你看，他們在那邊悠閒地待著。卡米拉在哪裡？卡米拉在哪裡？"}, {"type": "subtitle", "time": 4672.39, "timestamp": "01:17:52", "text": "卡米拉到底在哪裡？等等。卡米拉在哪裡？卡米拉？她是"}, {"type": "subtitle", "time": 4673.669, "timestamp": "01:17:53", "text": "不是躲在這裡了？逃走了。"}, {"type": "subtitle", "time": 4677.43, "timestamp": "01:17:57", "text": "哦"}, {"type": "subtitle", "time": 4679.99, "timestamp": "01:17:59", "text": "不。卡米拉在哪裡？哦不。"}]
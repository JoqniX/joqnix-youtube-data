[{"type": "subtitle", "time": 2942.069, "timestamp": "00:49:02", "text": "冰刀。 哦，冰刀是个不错的"}, {"type": "subtitle", "time": 2943.99, "timestamp": "00:49:03", "text": "杀伤性武器。 冰刀。 等等，"}, {"type": "subtitle", "time": 2945.51, "timestamp": "00:49:05", "text": "冰刀是什么等级的技能？"}, {"type": "subtitle", "time": 2947.67, "timestamp": "00:49:07", "text": "我想应该是第一级吧？ 正确的。 哦，是的。 这不是一级难度"}, {"type": "subtitle", "time": 2949.589, "timestamp": "00:49:09", "text": "。 这是一个不错的"}, {"type": "subtitle", "time": 2951.349, "timestamp": "00:49:11", "text": "伤害选择，但如果你也觉得引导箭很好用，那么你已经"}, {"type": "subtitle", "time": 2953.43, "timestamp": "00:49:13", "text": "准备好了引导箭"}, {"type": "subtitle", "time": 2955.43, "timestamp": "00:49:15", "text": "。 呃，又是一个非常好的、叫什么来着，但又具有"}, {"type": "subtitle", "time": 2958.39, "timestamp": "00:49:18", "text": "破坏性的选项。"}, {"type": "subtitle", "time": 2961.43, "timestamp": "00:49:21", "text": "我的意思是，一个非常有趣、非常有趣的……嗯……"}, {"type": "subtitle", "time": 2963.829, "timestamp": "00:49:23", "text": "支持选项是公平的。   是的"}, {"type": "subtitle", "time": 2966.069, "timestamp": "00:49:26", "text": "，已经准备好了。 公平交易"}, {"type": "subtitle", "time": 2967.27, "timestamp": "00:49:27", "text": "真的很好。"}, {"type": "subtitle", "time": 2969.349, "timestamp": "00:49:29", "text": "我的天啊。"}, {"type": "subtitle", "time": 2970.71, "timestamp": "00:49:30", "text": "这让我有点难过，因为"}, {"type": "subtitle", "time": 2973.75, "timestamp": "00:49:33", "text": "就像在我的周一"}, {"type": "subtitle", "time": 2976.71, "timestamp": "00:49:36", "text": "战役中，DM（地下城主）说，好的，所以"}, {"type": "subtitle", "time": 2979.27, "timestamp": "00:49:39", "text": "我们要使用"}, {"type": "subtitle", "time": 2981.03, "timestamp": "00:49:41", "text": "所谓的侧翼攻击规则。 所以如果"}, {"type": "subtitle", "time": 2982.309, "timestamp": "00:49:42", "text": "有人从侧翼包抄你，你就能获得"}, {"type": "subtitle", "time": 2984.23, "timestamp": "00:49:44", "text": "优势，而我就会想，不，我的 50 武器"}, {"type": "subtitle", "time": 2986.23, "timestamp": "00:49:46", "text": "现在没用了，"}, {"type": "subtitle", "time": 2988.15, "timestamp": "00:49:48", "text": "因为每个人都一直拥有优势"}, {"type": "subtitle", "time": 2990.069, "timestamp": "00:49:50", "text": "。   我的天，"}, {"type": "subtitle", "time": 2992.23, "timestamp": "00:49:52", "text": "我居然忘了枯萎蓝"}, {"type": "subtitle", "time": 2999.109, "timestamp": "00:49:59", "text": "我把那件事忘了。"}]
[{"type": "subtitle", "time": 8460.309, "timestamp": "02:21:00", "text": "模板就检查一遍？"}, {"type": "subtitle", "time": 8468.63, "timestamp": "02:21:08", "text": "实际上是火球。 有趣的事实。"}, {"type": "subtitle", "time": 8471.59, "timestamp": "02:21:11", "text": "我的天哪。 不，火球会把我们所有人都杀死的"}, {"type": "subtitle", "time": 8472.95, "timestamp": "02:21:12", "text": "。 有趣的事实。"}, {"type": "subtitle", "time": 8475.67, "timestamp": "02:21:15", "text": "我的天啊。 有趣的事实。"}, {"type": "subtitle", "time": 8479.429, "timestamp": "02:21:19", "text": "有趣的事实。 火球那玩意儿真他妈"}, {"type": "subtitle", "time": 8487.03, "timestamp": "02:21:27", "text": "我想看看能走多远。"}, {"type": "subtitle", "time": 8488.63, "timestamp": "02:21:28", "text": "我知道。   当"}, {"type": "subtitle", "time": 8491.59, "timestamp": "02:21:31", "text": "兄弟说他要去"}, {"type": "subtitle", "time": 8493.349, "timestamp": "02:21:33", "text": "查看模板的时候，我就知道接下来会发生什么了。 肯定会很"}, {"type": "subtitle", "time": 8494.95, "timestamp": "02:21:34", "text": "精彩。"}, {"type": "subtitle", "time": 8496.87, "timestamp": "02:21:36", "text": "即使你击中了目标，它又能飞多远呢"}, {"type": "subtitle", "time": 8500.469, "timestamp": "02:21:40", "text": "？ 哦。 哦，等等。 坚持，稍等。"}, {"type": "subtitle", "time": 8503.429, "timestamp": "02:21:43", "text": "不，不，请不要。"}, {"type": "subtitle", "time": 8505.67, "timestamp": "02:21:45", "text": "火球距离是30英尺还是更远？ 我"}, {"type": "subtitle", "time": 8511.51, "timestamp": "02:21:51", "text": "忘了。  60。60还是60。我的天哪。"}, {"type": "subtitle", "time": 8513.429, "timestamp": "02:21:53", "text": "我觉得不是60岁。我记得很清楚。 我"}, {"type": "subtitle", "time": 8513.99, "timestamp": "02:21:53", "text": "需要记住。"}, {"type": "subtitle", "time": 8515.83, "timestamp": "02:21:55", "text": "是20。我很确定是"}, {"type": "subtitle", "time": 8517.75, "timestamp": "02:21:57", "text": "20。不，绝对不是。 我认为是20个"}, {"type": "subtitle", "time": 8519.59, "timestamp": "02:21:59", "text": "碎片。"}]
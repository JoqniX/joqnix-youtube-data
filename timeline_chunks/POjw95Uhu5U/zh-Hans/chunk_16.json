[{"type": "subtitle", "time": 961.03, "timestamp": "00:16:01", "text": "他的皮肤可以恢复原状。 没关系，"}, {"type": "subtitle", "time": 964.79, "timestamp": "00:16:04", "text": "伙计们。 完全。"}, {"type": "subtitle", "time": 966.55, "timestamp": "00:16:06", "text": "活动期间将开始销售一些护肤"}, {"type": "subtitle", "time": 972.47, "timestamp": "00:16:12", "text": "兄弟，兄弟，我得接受那个该死的"}, {"type": "subtitle", "time": 975.269, "timestamp": "00:16:15", "text": "治疗，我很确定。 等等，"}, {"type": "subtitle", "time": 978.23, "timestamp": "00:16:18", "text": "这是团队会议吗？就像她自己一样？ 哥哥"}, {"type": "subtitle", "time": 980.79, "timestamp": "00:16:20", "text": "现在需要这个，以防万一"}, {"type": "subtitle", "time": 983.03, "timestamp": "00:16:23", "text": "。"}, {"type": "subtitle", "time": 985.189, "timestamp": "00:16:25", "text": "我，Ariana，仍然保留着她"}, {"type": "subtitle", "time": 987.749, "timestamp": "00:16:27", "text": "之前为自己找到的那卷轴。"}, {"type": "subtitle", "time": 988.87, "timestamp": "00:16:28", "text": "谁有它？"}, {"type": "subtitle", "time": 990.79, "timestamp": "00:16:30", "text": "阿丽亚娜手里拿着一卷卷轴。"}, {"type": "subtitle", "time": 993.829, "timestamp": "00:16:33", "text": "哦，是吗？ 哦，爱莉安娜有吗？   是的"}, {"type": "subtitle", "time": 994.31, "timestamp": "00:16:34", "text": "。"}, {"type": "subtitle", "time": 1008.55, "timestamp": "00:16:48", "text": "这样他就能学会了。 他能够……"}, {"type": "subtitle", "time": 1010.87, "timestamp": "00:16:50", "text": "嗯，我很确定改变自我是一种"}, {"type": "subtitle", "time": 1011.829, "timestamp": "00:16:51", "text": "仪式，对吧？"}, {"type": "subtitle", "time": 1016.23, "timestamp": "00:16:56", "text": "是吗？ 我忘了。 改变自我……"}, {"type": "subtitle", "time": 1019.749, "timestamp": "00:16:59", "text": "嗯，让我再确认一下。 嗯，我"}]
[{"type": "subtitle", "time": 6360.709, "timestamp": "01:46:00", "text": "我刚刚升级了，伙计。"}, {"type": "subtitle", "time": 6364.31, "timestamp": "01:46:04", "text": "呃，我必须……是的。是的。"}, {"type": "subtitle", "time": 6366.87, "timestamp": "01:46:06", "text": "你拥有杂技技能"}, {"type": "subtitle", "time": 6369.43, "timestamp": "01:46:09", "text": "。"}, {"type": "subtitle", "time": 6371.99, "timestamp": "01:46:11", "text": "实际上，不。你已经拥有"}, {"type": "subtitle", "time": 6380.229, "timestamp": "01:46:20", "text": "很重要吗？"}, {"type": "subtitle", "time": 6384.47, "timestamp": "01:46:24", "text": "所以，说服力、洞察力、调查、"}, {"type": "subtitle", "time": 6387.189, "timestamp": "01:46:27", "text": "追踪。内部调查"}, {"type": "subtitle", "time": 6405.35, "timestamp": "01:46:45", "text": "[音乐]"}]
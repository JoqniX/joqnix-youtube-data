[{"type": "subtitle", "time": 9301.91, "timestamp": "02:35:01", "text": "墙上有一个把手，不是在"}, {"type": "subtitle", "time": 9302.87, "timestamp": "02:35:02", "text": "那边。 就像我无法"}, {"type": "subtitle", "time": 9304.71, "timestamp": "02:35:04", "text": "ping 通那个目标一样，是的，我"}, {"type": "subtitle", "time": 9306.389, "timestamp": "02:35:06", "text": "无法 ping 通它，因为我这边好像有什么"}, {"type": "subtitle", "time": 9308.469, "timestamp": "02:35:08", "text": "东西挡住了它。 但它"}, {"type": "subtitle", "time": 9312.15, "timestamp": "02:35:12", "text": "上面有个小孔。 你几乎"}, {"type": "subtitle", "time": 9314.389, "timestamp": "02:35:14", "text": "可以挤"}, {"type": "subtitle", "time": 9317.349, "timestamp": "02:35:17", "text": "过去，但还是差一点。"}, {"type": "subtitle", "time": 9319.83, "timestamp": "02:35:19", "text": "有趣的是，"}, {"type": "subtitle", "time": 9322.79, "timestamp": "02:35:22", "text": "这个法术理论上只要在"}, {"type": "subtitle", "time": 9327.19, "timestamp": "02:35:27", "text": "10 英尺范围内，我就可以把克里斯平召唤到"}, {"type": "subtitle", "time": 9328.389, "timestamp": "02:35:28", "text": "里面。"}, {"type": "subtitle", "time": 9331.91, "timestamp": "02:35:31", "text": "当然，你可以"}, {"type": "subtitle", "time": 9335.67, "timestamp": "02:35:35", "text": "做到。 去他妈的。 好的。"}, {"type": "subtitle", "time": 9338.309, "timestamp": "02:35:38", "text": "好的。 你你你呃，"}, {"type": "subtitle", "time": 9341.67, "timestamp": "02:35:41", "text": "再打个电话？ 这里看不到。"}, {"type": "subtitle", "time": 9345.27, "timestamp": "02:35:45", "text": "有死亡跑酷模式吗？ 我们走吧。 他妈的。"}, {"type": "subtitle", "time": 9346.469, "timestamp": "02:35:46", "text": "搞什么鬼？"}, {"type": "subtitle", "time": 9348.95, "timestamp": "02:35:48", "text": "那边有个叫克里斯​​恩的人。 就像这样"}, {"type": "subtitle", "time": 9351.19, "timestamp": "02:35:51", "text": "，顺便说一句"}, {"type": "subtitle", "time": 9353.11, "timestamp": "02:35:53", "text": "，我应该让克里斯恩隐形。"}, {"type": "subtitle", "time": 9354.63, "timestamp": "02:35:54", "text": "哎呀，那不是隐形的。"}, {"type": "subtitle", "time": 9356.87, "timestamp": "02:35:56", "text": "他把它们删掉了。   是的"}, {"type": "subtitle", "time": 9357.349, "timestamp": "02:35:57", "text": "。"}, {"type": "subtitle", "time": 9359.67, "timestamp": "02:35:59", "text": "好的。 嗯，是的，这边。 在那边。"}]
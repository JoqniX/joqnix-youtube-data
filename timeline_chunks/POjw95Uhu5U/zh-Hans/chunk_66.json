[{"type": "subtitle", "time": 3960.95, "timestamp": "01:06:00", "text": "我的天哪。那两个魔鬼都说："}, {"type": "subtitle", "time": 3968.23, "timestamp": "01:06:08", "text": "爸爸是"}, {"type": "subtitle", "time": 3972.87, "timestamp": "01:06:12", "text": "卡米拉，就像，好吧，我从没见过"}, {"type": "subtitle", "time": 3976.39, "timestamp": "01:06:16", "text": "你们这些人这么丢人。”"}, {"type": "subtitle", "time": 3978.549, "timestamp": "01:06:18", "text": "你是说你家人说了"}, {"type": "subtitle", "time": 3980.23, "timestamp": "01:06:20", "text": "你坏话？哦，那一定很"}, {"type": "subtitle", "time": 3984.95, "timestamp": "01:06:24", "text": "天哪。"}, {"type": "subtitle", "time": 3987.74, "timestamp": "01:06:27", "text": "奇克永远不会。奇克永远不会"}, {"type": "subtitle", "time": 3989.27, "timestamp": "01:06:29", "text": "[音乐]"}, {"type": "subtitle", "time": 3993.27, "timestamp": "01:06:33", "text": "卡米拉，别跟一个孩子打架了。"}, {"type": "subtitle", "time": 3996.47, "timestamp": "01:06:36", "text": "你说孩子是什么意思？那东西"}, {"type": "subtitle", "time": 3999.349, "timestamp": "01:06:39", "text": "充其量是个野兽。"}, {"type": "subtitle", "time": 4001.109, "timestamp": "01:06:41", "text": "如果这里也有野兽的话"}, {"type": "subtitle", "time": 4003.51, "timestamp": "01:06:43", "text": "。"}, {"type": "subtitle", "time": 4006.71, "timestamp": "01:06:46", "text": "这场打架很有效。门票同时赢得了"}, {"type": "subtitle", "time": 4008.23, "timestamp": "01:06:48", "text": "战斗和战争，而且"}, {"type": "subtitle", "time": 4014.95, "timestamp": "01:06:54", "text": "好吧，随便吧"}, {"type": "subtitle", "time": 4017.99, "timestamp": "01:06:57", "text": "。"}]
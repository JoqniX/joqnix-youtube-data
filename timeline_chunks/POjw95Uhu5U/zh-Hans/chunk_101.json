[{"type": "subtitle", "time": 6060.149, "timestamp": "01:41:00", "text": "，我们等等吧。别"}, {"type": "subtitle", "time": 6064.07, "timestamp": "01:41:04", "text": "担心。我的天哪。441。"}, {"type": "subtitle", "time": 6066.39, "timestamp": "01:41:06", "text": "人生真糟糕。"}, {"type": "subtitle", "time": 6067.59, "timestamp": "01:41:07", "text": "哦，天哪。"}, {"type": "subtitle", "time": 6068.95, "timestamp": "01:41:08", "text": "加五。"}, {"type": "subtitle", "time": 6070.629, "timestamp": "01:41:10", "text": "你知道吗，我根本没想过"}, {"type": "subtitle", "time": 6074.95, "timestamp": "01:41:14", "text": "这可能是个活物。"}, {"type": "subtitle", "time": 6077.109, "timestamp": "01:41:17", "text": "说实话，我也是。我 也没考虑到这一点"}, {"type": "subtitle", "time": 6079.91, "timestamp": "01:41:19", "text": "。所以，哎呀，看来我们"}, {"type": "subtitle", "time": 6082.149, "timestamp": "01:41:22", "text": "完蛋了。"}, {"type": "subtitle", "time": 6084.31, "timestamp": "01:41:24", "text": "我猜是座"}, {"type": "subtitle", "time": 6085.669, "timestamp": "01:41:25", "text": "巨大的金雕像。H 座"}, {"type": "subtitle", "time": 6090.47, "timestamp": "01:41:30", "text": "巨大的金雕像。M 座"}, {"type": "subtitle", "time": 6092.47, "timestamp": "01:41:32", "text": "巨大的"}, {"type": "subtitle", "time": 6095.99, "timestamp": "01:41:35", "text": "金雕像。听着，"}, {"type": "subtitle", "time": 6098.07, "timestamp": "01:41:38", "text": "我们已经检查过好几座"}, {"type": "subtitle", "time": 6100.95, "timestamp": "01:41:40", "text": "雕像了，它们都没有生命。所以"}, {"type": "subtitle", "time": 6103.99, "timestamp": "01:41:43", "text": "听着，我们没想到会这样。"}, {"type": "subtitle", "time": 6106.47, "timestamp": "01:41:46", "text": "我们当时就像……是的"}, {"type": "subtitle", "time": 6107.59, "timestamp": "01:41:47", "text": "，我们"}, {"type": "chat", "time": 6107.943, "timestamp": "01:41:47", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ_yAK5S3_9EP-duW6Qo"}, {"type": "subtitle", "time": 6111.109, "timestamp": "01:41:51", "text": "给了他们一种虚假的安全感。"}, {"type": "subtitle", "time": 6113.43, "timestamp": "01:41:53", "text": "没错。事情就是这样发生的。"}, {"type": "subtitle", "time": 6116.39, "timestamp": "01:41:56", "text": "你会想，哎呀，我想……"}, {"type": "subtitle", "time": 6117.189, "timestamp": "01:41:57", "text": "好吧。"}, {"type": "subtitle", "time": 6119.03, "timestamp": "01:41:59", "text": "我们意识到会"}]
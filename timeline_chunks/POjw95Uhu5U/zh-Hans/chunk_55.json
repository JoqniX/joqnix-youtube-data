[{"type": "subtitle", "time": 3300.95, "timestamp": "00:55:00", "text": "这有点像是"}, {"type": "subtitle", "time": 3303.51, "timestamp": "00:55:03", "text": "故事的第一个重要部分，我们一起"}, {"type": "subtitle", "time": 3307.589, "timestamp": "00:55:07", "text": "狩猎，每个人都只有一次机会，"}, {"type": "subtitle", "time": 3309.67, "timestamp": "00:55:09", "text": "通过战斗了解彼此，"}, {"type": "subtitle", "time": 3313.19, "timestamp": "00:55:13", "text": "然后我们一起去冒险，建立"}, {"type": "subtitle", "time": 3317.03, "timestamp": "00:55:17", "text": "创伤纽带。 当然。   是的"}, {"type": "subtitle", "time": 3319.109, "timestamp": "00:55:19", "text": "。 我们之间首先建立了一种创伤纽带，"}, {"type": "subtitle", "time": 3320.87, "timestamp": "00:55:20", "text": "这样我们才能继续在一起。   是的"}, {"type": "subtitle", "time": 3323.19, "timestamp": "00:55:23", "text": "。 所以即使下班后，我们外出时也会形影不离"}, {"type": "subtitle", "time": 3325.19, "timestamp": "00:55:25", "text": "。 但"}, {"type": "subtitle", "time": 3328.63, "timestamp": "00:55:28", "text": "故事大致就是这样。"}, {"type": "subtitle", "time": 3330.87, "timestamp": "00:55:30", "text": "我们必须继续前行，这样即使走出这个地牢，我们也能"}, {"type": "subtitle", "time": 3333.19, "timestamp": "00:55:33", "text": "成为好朋友，一起玩乐"}, {"type": "subtitle", "time": 3335.27, "timestamp": "00:55:35", "text": "。   是的"}, {"type": "subtitle", "time": 3336.309, "timestamp": "00:55:36", "text": "。"}, {"type": "subtitle", "time": 3341.67, "timestamp": "00:55:41", "text": "所以卡米拉看向了对方。"}, {"type": "subtitle", "time": 3347.109, "timestamp": "00:55:47", "text": "皮克一定会喜欢卡米拉。 我不在乎。"}, {"type": "subtitle", "time": 3353.51, "timestamp": "00:55:53", "text": "其他各方显然"}, {"type": "subtitle", "time": 3356.47, "timestamp": "00:55:56", "text": "都不喜欢卡米拉。 我的意思是，他们很崇拜她，"}]
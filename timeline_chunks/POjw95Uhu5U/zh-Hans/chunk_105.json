[{"type": "subtitle", "time": 6301.51, "timestamp": "01:45:01", "text": "雕像惊呆的画面。[音乐] 看看我是否会和你说话。是的。是的。是的"}, {"type": "subtitle", "time": 6304.55, "timestamp": "01:45:04", "text": "。"}, {"type": "subtitle", "time": 6307.59, "timestamp": "01:45:07", "text": "卡米拉好像在试图向"}, {"type": "subtitle", "time": 6312.709, "timestamp": "01:45:12", "text": "这个派对推销一些德鲁伊可以用的东西，他们"}, {"type": "subtitle", "time": 6315.59, "timestamp": "01:45:15", "text": "想要200"}, {"type": "subtitle", "time": 6325.669, "timestamp": "01:45:25", "text": "好的。"}, {"type": "subtitle", "time": 6337.109, "timestamp": "01:45:37", "text": "还有，顺便说一句，你好像看到"}, {"type": "subtitle", "time": 6343.91, "timestamp": "01:45:43", "text": "好的。我不知道你"}, {"type": "subtitle", "time": 6345.189, "timestamp": "01:45:45", "text": "需要获得哪些功能。如果你"}, {"type": "subtitle", "time": 6347.27, "timestamp": "01:45:47", "text": "获得了任何新功能，我会告诉你。让我再"}, {"type": "subtitle", "time": 6350.149, "timestamp": "01:45:50", "text": "确认一下。升级。"}, {"type": "subtitle", "time": 6352.47, "timestamp": "01:45:52", "text": "好的。是的。"}, {"type": "subtitle", "time": 6354.229, "timestamp": "01:45:54", "text": "等等。哦，你可以获得"}, {"type": "subtitle", "time": 6355.669, "timestamp": "01:45:55", "text": "专长。你想成为哪方面的"}, {"type": "subtitle", "time": 6357.99, "timestamp": "01:45:57", "text": "专家？"}]
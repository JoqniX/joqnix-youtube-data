[{"type": "subtitle", "time": 7141.51, "timestamp": "01:59:01", "text": "今天早上那里真的很热，所以，是的。"}, {"type": "subtitle", "time": 7143.99, "timestamp": "01:59:03", "text": "嗯。   是的"}, {"type": "subtitle", "time": 7145.189, "timestamp": "01:59:05", "text": "。"}, {"type": "subtitle", "time": 7147.99, "timestamp": "01:59:07", "text": "我在这里过冬。"}, {"type": "subtitle", "time": 7150.149, "timestamp": "01:59:10", "text": "这里正值暴风雨天气。"}, {"type": "subtitle", "time": 7152.629, "timestamp": "01:59:12", "text": "我的天啊。 我甚至不知道"}, {"type": "subtitle", "time": 7155.109, "timestamp": "01:59:15", "text": "今天天气怎么样。 完全是随机的。"}, {"type": "subtitle", "time": 7157.27, "timestamp": "01:59:17", "text": "就像下着热雨。 下着瓢泼大雨，"}, {"type": "subtitle", "time": 7159.75, "timestamp": "01:59:19", "text": "兄弟。 那也是我。 嗯，今天早上"}, {"type": "subtitle", "time": 7161.83, "timestamp": "01:59:21", "text": "很热，然后下午又"}, {"type": "subtitle", "time": 7163.83, "timestamp": "01:59:23", "text": "开始下暴雨了。 这就是为什么"}, {"type": "subtitle", "time": 7166.87, "timestamp": "01:59:26", "text": "我的喉咙像灌了铅一样。 唉，"}, {"type": "subtitle", "time": 7169.669, "timestamp": "01:59:29", "text": "我真讨厌现在的天气。"}, {"type": "subtitle", "time": 7171.83, "timestamp": "01:59:31", "text": "这就像亚洲和东南亚的"}, {"type": "subtitle", "time": 7174.149, "timestamp": "01:59:34", "text": "天气一样。 我们经历了炎热干燥和炎热"}, {"type": "subtitle", "time": 7176.149, "timestamp": "01:59:36", "text": "潮湿的天气。"}, {"type": "subtitle", "time": 7178.229, "timestamp": "01:59:38", "text": "两种天气。 哦亲爱的。   是的"}, {"type": "subtitle", "time": 7180.79, "timestamp": "01:59:40", "text": "。"}, {"type": "subtitle", "time": 7183.99, "timestamp": "01:59:43", "text": "Tick 将会尝试并成功。 我想要"}, {"type": "subtitle", "time": 7184.629, "timestamp": "01:59:44", "text": "前锋吗？ 我想要"}, {"type": "subtitle", "time": 7187.109, "timestamp": "01:59:47", "text": "树木撞击。"}, {"type": "subtitle", "time": 7188.709, "timestamp": "01:59:48", "text": "它容易滋生"}, {"type": "subtitle", "time": 7195.589, "timestamp": "01:59:55", "text": "我打算用什么东西来感染它？ 我不"}, {"type": "subtitle", "time": 7199.99, "timestamp": "01:59:59", "text": "知道。 我身上有蜱虫。 它身上可能有蜱虫。"}]
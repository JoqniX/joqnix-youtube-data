[{"type": "subtitle", "time": 1442.39, "timestamp": "00:24:02", "text": "我的天啊。"}, {"type": "subtitle", "time": 1444.31, "timestamp": "00:24:04", "text": "只是在为它"}, {"type": "subtitle", "time": 1446.95, "timestamp": "00:24:06", "text": "不可避免的发生做准备。"}, {"type": "subtitle", "time": 1450.31, "timestamp": "00:24:10", "text": "我迫不及待地想看到流血冲突。"}, {"type": "subtitle", "time": 1452.149, "timestamp": "00:24:12", "text": "总有一天会出现眼部充血的情况。 但"}, {"type": "subtitle", "time": 1456.31, "timestamp": "00:24:16", "text": "卡米拉还需要考虑的一点是，如果她"}, {"type": "subtitle", "time": 1459.669, "timestamp": "00:24:19", "text": "背叛了雷，那么其他"}, {"type": "subtitle", "time": 1461.43, "timestamp": "00:24:21", "text": "党员可能也会认为"}, {"type": "subtitle", "time": 1462.95, "timestamp": "00:24:22", "text": "她完全背叛了"}, {"type": "subtitle", "time": 1464.149, "timestamp": "00:24:24", "text": "党。"}, {"type": "subtitle", "time": 1466.23, "timestamp": "00:24:26", "text": "确实，"}, {"type": "subtitle", "time": 1467.35, "timestamp": "00:24:27", "text": "有道理。"}, {"type": "subtitle", "time": 1469.59, "timestamp": "00:24:29", "text": "是啊，我把整个派对都忘了，因为我"}, {"type": "subtitle", "time": 1471.51, "timestamp": "00:24:31", "text": "讨厌卡米拉。"}, {"type": "subtitle", "time": 1472.07, "timestamp": "00:24:32", "text": "嗯，是的"}, {"type": "subtitle", "time": 1473.669, "timestamp": "00:24:33", "text": "。"}, {"type": "subtitle", "time": 1476.149, "timestamp": "00:24:36", "text": "还有一种情况是，如果最后的结果又像"}, {"type": "subtitle", "time": 1479.11, "timestamp": "00:24:39", "text": "钢琴那场战斗一样，只有"}, {"type": "subtitle", "time": 1482.549, "timestamp": "00:24:42", "text": "神村一个人站着。   我的"}, {"type": "subtitle", "time": 1485.909, "timestamp": "00:24:45", "text": "天哪。"}, {"type": "subtitle", "time": 1488.789, "timestamp": "00:24:48", "text": "我相信任何问题都会得到解决。"}, {"type": "subtitle", "time": 1490.549, "timestamp": "00:24:50", "text": "我以为你会说，如果就像"}, {"type": "subtitle", "time": 1492.31, "timestamp": "00:24:52", "text": "钢琴大战那样，卡米拉"}, {"type": "subtitle", "time": 1495.669, "timestamp": "00:24:55", "text": "什么都没打到。"}, {"type": "subtitle", "time": 1497.19, "timestamp": "00:24:57", "text": "我认为这也是事实。"}, {"type": "subtitle", "time": 1498.71, "timestamp": "00:24:58", "text": "哦，没关系。 听起来也很"}]
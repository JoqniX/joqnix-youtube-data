[{"type": "subtitle", "time": 5341.51, "timestamp": "01:29:01", "text": "了解他们的规矩。蒂克很了解"}, {"type": "subtitle", "time": 5343.11, "timestamp": "01:29:03", "text": "贵族们的行事方式。蒂克。蒂克从小"}, {"type": "subtitle", "time": 5345.51, "timestamp": "01:29:05", "text": "在船上长大。"}, {"type": "subtitle", "time": 5348.39, "timestamp": "01:29:08", "text": "你知道吗，蒂克，也许你确实应该……"}, {"type": "subtitle", "time": 5350.229, "timestamp": "01:29:10", "text": "你确实应该了解一下"}, {"type": "subtitle", "time": 5356.95, "timestamp": "01:29:16", "text": "哦 我的天啊。你准备好了。你"}, {"type": "subtitle", "time": 5358.07, "timestamp": "01:29:18", "text": "准备好了。"}, {"type": "subtitle", "time": 5360.229, "timestamp": "01:29:20", "text": "你准备好进军股市了。我的"}, {"type": "subtitle", "time": 5360.47, "timestamp": "01:29:20", "text": "天啊。"}, {"type": "subtitle", "time": 5362.55, "timestamp": "01:29:22", "text": "你准备好了。NFT是"}, {"type": "subtitle", "time": 5367.189, "timestamp": "01:29:27", "text": "什么？不，不是那个。"}, {"type": "subtitle", "time": 5368.55, "timestamp": "01:29:28", "text": "好的。"}, {"type": "subtitle", "time": 5370.31, "timestamp": "01:29:30", "text": "告诉我。告诉我你什么时候加载。好的。"}, {"type": "subtitle", "time": 5371.75, "timestamp": "01:29:31", "text": "等等。等等。让我先把你放进去，等等"}, {"type": "subtitle", "time": 5374.79, "timestamp": "01:29:34", "text": "。灯在哪儿？好的。"}, {"type": "subtitle", "time": 5378.95, "timestamp": "01:29:38", "text": "呃，你的火把和土豆。"}, {"type": "subtitle", "time": 5381.27, "timestamp": "01:29:41", "text": "当然。当然，别忘了"}, {"type": "subtitle", "time": 5384.79, "timestamp": "01:29:44", "text": "祭祀用的肉。"}, {"type": "subtitle", "time": 5386.229, "timestamp": "01:29:46", "text": "哦，对。对。我忘了那个。"}, {"type": "subtitle", "time": 5388.39, "timestamp": "01:29:48", "text": "它在哪儿？祭祀用的"}, {"type": "subtitle", "time": 5393.43, "timestamp": "01:29:53", "text": "对。抱歉。"}, {"type": "subtitle", "time": 5396.55, "timestamp": "01:29:56", "text": "呃，我可以请假"}, {"type": "subtitle", "time": 5399.59, "timestamp": "01:29:59", "text": "30分钟吗？有急事。没关系。好的，"}]
[{"type": "subtitle", "time": 4565.11, "timestamp": "01:16:05", "text": "[音乐]"}, {"type": "subtitle", "time": 4566.95, "timestamp": "01:16:06", "text": "肯定要把火球留给"}, {"type": "subtitle", "time": 4570.07, "timestamp": "01:16:10", "text": "自己了。 那，那是给她的。 但"}, {"type": "subtitle", "time": 4573.59, "timestamp": "01:16:13", "text": "她却说：“哦，天哪，电梯音乐"}, {"type": "subtitle", "time": 4574.79, "timestamp": "01:16:14", "text": "响起来了。”"}, {"type": "subtitle", "time": 4577.75, "timestamp": "01:16:17", "text": "对不起。 对不起。 我很抱歉。 我当时"}, {"type": "subtitle", "time": 4580.63, "timestamp": "01:16:20", "text": "就想，哦，我很好奇"}, {"type": "subtitle", "time": 4583.43, "timestamp": "01:16:23", "text": "Ash有什么，然后我到底是怎么把"}, {"type": "subtitle", "time": 4588.95, "timestamp": "01:16:28", "text": "。 是的，他确实这么做了。"}, {"type": "subtitle", "time": 4591.43, "timestamp": "01:16:31", "text": "维多利亚的灰烬。"}, {"type": "subtitle", "time": 4595.03, "timestamp": "01:16:35", "text": "那次争吵给我留下了心理创伤。 我所在的"}, {"type": "subtitle", "time": 4598.95, "timestamp": "01:16:38", "text": "部队里有太多像阿什利一样的人，这让我感到很痛苦。"}, {"type": "subtitle", "time": 4605.669, "timestamp": "01:16:45", "text": "哦，你有一条项链。 让"}, {"type": "subtitle", "time": 4607.83, "timestamp": "01:16:47", "text": "我给你的车道来个连锁反应"}, {"type": "subtitle", "time": 4610.47, "timestamp": "01:16:50", "text": "。 有人在玩游戏。"}, {"type": "subtitle", "time": 4611.04, "timestamp": "01:16:51", "text": "游戏。 游戏。"}, {"type": "subtitle", "time": 4613.04, "timestamp": "01:16:53", "text": "游戏。 哦，你这是想……哦，你这是想"}, {"type": "subtitle", "time": 4614.719, "timestamp": "01:16:54", "text": "哦，你这是想……哦，你这是想 在我的话题里插话。"}, {"type": "subtitle", "time": 4617.44, "timestamp": "01:16:57", "text": "在我的话题里插话。 游戏。"}, {"type": "subtitle", "time": 4619.28, "timestamp": "01:16:59", "text": "游戏。 我的大石头。"}]
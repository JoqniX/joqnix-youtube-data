[{"type": "subtitle", "time": 5821.35, "timestamp": "01:37:01", "text": "队伍里的每个人力量值至少都是0，或者"}, {"type": "subtitle", "time": 5824.39, "timestamp": "01:37:04", "text": "0，或者-1。"}, {"type": "subtitle", "time": 5824.87, "timestamp": "01:37:04", "text": "哦，我的天。"}, {"type": "subtitle", "time": 5826.79, "timestamp": "01:37:06", "text": "让我看看。Tick的"}, {"type": "subtitle", "time": 5829.35, "timestamp": "01:37:09", "text": "力量值是0。Van的力量值"}, {"type": "subtitle", "time": 5832.55, "timestamp": "01:37:12", "text": "是0。Jock的力量值是0。Hona的"}, {"type": "subtitle", "time": 5835.83, "timestamp": "01:37:15", "text": "力量值是-1。Iana"}, {"type": "subtitle", "time": 5838.47, "timestamp": "01:37:18", "text": "是唯一一个"}, {"type": "subtitle", "time": 5842.709, "timestamp": "01:37:22", "text": "可能尝试把它拉出来的人。"}, {"type": "subtitle", "time": 5844.39, "timestamp": "01:37:24", "text": "他们脑子很灵光，但"}, {"type": "subtitle", "time": 5851.03, "timestamp": "01:37:31", "text": "哦。嗯，Hanan说如果我们能设法把"}, {"type": "subtitle", "time": 5853.669, "timestamp": "01:37:33", "text": "这些东西弄出来，我们就能把它拉"}, {"type": "subtitle", "time": 5855.669, "timestamp": "01:37:35", "text": "出来。我就想，"}, {"type": "subtitle", "time": 5859.59, "timestamp": "01:37:39", "text": "这游戏里到底谁有这种能力？"}, {"type": "subtitle", "time": 5862.39, "timestamp": "01:37:42", "text": "如果你们找到了办法……主雕像。"}, {"type": "subtitle", "time": 5864.31, "timestamp": "01:37:44", "text": "这里只有主雕像是"}, {"type": "subtitle", "time": 5865.35, "timestamp": "01:37:45", "text": "金色的吗？还是……"}, {"type": "subtitle", "time": 5867.59, "timestamp": "01:37:47", "text": "呃，那四个雕像，只有它们的"}, {"type": "subtitle", "time": 5869.27, "timestamp": "01:37:49", "text": "武器是金的，但主"}, {"type": "subtitle", "time": 5870.95, "timestamp": "01:37:50", "text": "雕像从你看到的范围内来说，完全是金的"}, {"type": "subtitle", "time": 5872.149, "timestamp": "01:37:52", "text": "。至少你不知道它是我的"}, {"type": "subtitle", "time": 5873.83, "timestamp": "01:37:53", "text": "金板，还是真的是"}, {"type": "subtitle", "time": 5875.59, "timestamp": "01:37:55", "text": "纯金。"}, {"type": "subtitle", "time": 5878.39, "timestamp": "01:37:58", "text": "听起来我们要拿走这些金"}]
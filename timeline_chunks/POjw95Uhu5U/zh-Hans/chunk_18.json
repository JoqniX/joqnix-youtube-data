[{"type": "subtitle", "time": 1082.549, "timestamp": "00:18:02", "text": "那肯定会是个问题。"}, {"type": "subtitle", "time": 1085.19, "timestamp": "00:18:05", "text": "谁知道呢？"}, {"type": "subtitle", "time": 1088.15, "timestamp": "00:18:08", "text": "我想看到雷"}, {"type": "subtitle", "time": 1090.23, "timestamp": "00:18:10", "text": "变成像僧侣一样的人时发生这种情况，因为这意味着"}, {"type": "subtitle", "time": 1098.39, "timestamp": "00:18:18", "text": "让我看看自己会不会发火。 如果我"}, {"type": "subtitle", "time": 1100.71, "timestamp": "00:18:20", "text": "升龙拳但不攻击，"}, {"type": "subtitle", "time": 1104.39, "timestamp": "00:18:24", "text": "我现在会造成多少伤害？ 嗯，威力"}, {"type": "subtitle", "time": 1107.83, "timestamp": "00:18:27", "text": "巨大的警告"}, {"type": "subtitle", "time": 1110.07, "timestamp": "00:18:30", "text": "攻击斧。"}, {"type": "subtitle", "time": 1118.95, "timestamp": "00:18:38", "text": "该死。 双二。 哦，这可真是个大"}, {"type": "subtitle", "time": 1119.669, "timestamp": "00:18:39", "text": "批评。"}, {"type": "subtitle", "time": 1127.59, "timestamp": "00:18:47", "text": "批评他。 我的天啊。 那也是暴击"}, {"type": "subtitle", "time": 1131.35, "timestamp": "00:18:51", "text": "狂潮啊。"}, {"type": "subtitle", "time": 1132.789, "timestamp": "00:18:52", "text": "狂热的批评声。 当然。"}, {"type": "subtitle", "time": 1134.07, "timestamp": "00:18:54", "text": "我的天啊。"}, {"type": "subtitle", "time": 1136.23, "timestamp": "00:18:56", "text": "没错，这就是评论界的狂热。 狂热在哪里"}, {"type": "subtitle", "time": 1139.75, "timestamp": "00:18:59", "text": "？ 找到了。"}]
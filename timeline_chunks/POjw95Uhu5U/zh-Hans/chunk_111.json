[{"type": "subtitle", "time": 6660.47, "timestamp": "01:51:00", "text": "。"}, {"type": "subtitle", "time": 6661.99, "timestamp": "01:51:01", "text": "是的，我只要把你从"}, {"type": "subtitle", "time": 6666.39, "timestamp": "01:51:06", "text": "我的宏里扔出去，你就可以直接用了。"}, {"type": "subtitle", "time": 6668.87, "timestamp": "01:51:08", "text": "这实际上非常有用，因为就像"}, {"type": "subtitle", "time": 6670.47, "timestamp": "01:51:10", "text": "未来，我现在还没"}, {"type": "subtitle", "time": 6672.07, "timestamp": "01:51:12", "text": "考虑过，因为"}, {"type": "subtitle", "time": 6674.229, "timestamp": "01:51:14", "text": "我玩的队伍通常都是手机"}, {"type": "subtitle", "time": 6676.47, "timestamp": "01:51:16", "text": "用户。所以掷骰子"}, {"type": "subtitle", "time": 6679.43, "timestamp": "01:51:19", "text": "对你来说更容易。"}, {"type": "subtitle", "time": 6681.43, "timestamp": "01:51:21", "text": "当然。"}, {"type": "subtitle", "time": 6682.79, "timestamp": "01:51:22", "text": "是的，"}, {"type": "subtitle", "time": 6684.709, "timestamp": "01:51:24", "text": "这是个好主意。设置微操"}, {"type": "subtitle", "time": 6687.27, "timestamp": "01:51:27", "text": "是个好主意，对吧？"}, {"type": "subtitle", "time": 6688.95, "timestamp": "01:51:28", "text": "如果"}, {"type": "subtitle", "time": 6691.59, "timestamp": "01:51:31", "text": "将来我真的用"}, {"type": "subtitle", "time": 6694.709, "timestamp": "01:51:34", "text": "Foundry，我就会这么做，因为那是"}, {"type": "subtitle", "time": 6696.629, "timestamp": "01:51:36", "text": "我不用它的唯一原因是，我的玩家里"}, {"type": "subtitle", "time": 6699.669, "timestamp": "01:51:39", "text": "有些人用手机，"}, {"type": "subtitle", "time": 6701.91, "timestamp": "01:51:41", "text": "他们用"}, {"type": "subtitle", "time": 6709.03, "timestamp": "01:51:49", "text": "很难。真的"}, {"type": "subtitle", "time": 6711.189, "timestamp": "01:51:51", "text": "很难，但出乎意料的是，他们居然能"}, {"type": "subtitle", "time": 6713.43, "timestamp": "01:51:53", "text": "掷骰子，能移动他们的标记。"}, {"type": "subtitle", "time": 6714.79, "timestamp": "01:51:54", "text": "我的天哪。是"}, {"type": "subtitle", "time": 6719.03, "timestamp": "01:51:59", "text": "啊。他们居然能做到，简直不可思议。"}]
[{"type": "subtitle", "time": 3121.75, "timestamp": "00:52:01", "text": "这个故事的寓意是韩韩要把"}, {"type": "subtitle", "time": 3123.109, "timestamp": "00:52:03", "text": "我们打得落花流水。"}, {"type": "subtitle", "time": 3129.109, "timestamp": "00:52:09", "text": "不，"}, {"type": "subtitle", "time": 3131.27, "timestamp": "00:52:11", "text": "但是"}, {"type": "subtitle", "time": 3137.109, "timestamp": "00:52:17", "text": "活力的活力是一个相当不错的"}, {"type": "subtitle", "time": 3139.589, "timestamp": "00:52:19", "text": "支持选择。 呃，但它也是"}, {"type": "subtitle", "time": 3140.95, "timestamp": "00:52:20", "text": "三级的。 所以我们需要使用"}, {"type": "subtitle", "time": 3142.15, "timestamp": "00:52:22", "text": "三级法术位。"}, {"type": "subtitle", "time": 3144.069, "timestamp": "00:52:24", "text": "你知道还有另一件事。"}, {"type": "subtitle", "time": 3144.549, "timestamp": "00:52:24", "text": "抱歉。"}, {"type": "subtitle", "time": 3146.23, "timestamp": "00:52:26", "text": "哦不，别继续，别继续。 是的，我"}, {"type": "subtitle", "time": 3149.51, "timestamp": "00:52:29", "text": "觉得对于一个运动健将来说，最"}, {"type": "subtitle", "time": 3151.109, "timestamp": "00:52:31", "text": "重要的两个三级法术就是"}, {"type": "subtitle", "time": 3153.51, "timestamp": "00:52:33", "text": "复活术和驱散魔法。 那两个人"}, {"type": "subtitle", "time": 3155.91, "timestamp": "00:52:35", "text": "被捕"}, {"type": "subtitle", "time": 3157.99, "timestamp": "00:52:37", "text": "只是为了买保险。 这种魔法简直"}, {"type": "subtitle", "time": 3161.91, "timestamp": "00:52:41", "text": "能让你为所欲为。"}, {"type": "subtitle", "time": 3164.15, "timestamp": "00:52:44", "text": "我本来想说的是，我喜欢"}, {"type": "subtitle", "time": 3166.47, "timestamp": "00:52:46", "text": "对方通常直奔主题的做法"}, {"type": "subtitle", "time": 3167.91, "timestamp": "00:52:47", "text": "，但这边的人却喜欢"}, {"type": "subtitle", "time": 3171.27, "timestamp": "00:52:51", "text": "拖延。   是的"}, {"type": "subtitle", "time": 3172.95, "timestamp": "00:52:52", "text": "。   但这"}, {"type": "subtitle", "time": 3176.71, "timestamp": "00:52:56", "text": "并非坏事。"}, {"type": "subtitle", "time": 3178.79, "timestamp": "00:52:58", "text": "除了用乌鸦吼叫器之外，我们思考的方式也远不止是"}]
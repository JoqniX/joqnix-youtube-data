[{"type": "subtitle", "time": 1925.99, "timestamp": "00:32:05", "text": "我。"}, {"type": "subtitle", "time": 1927.75, "timestamp": "00:32:07", "text": "等等，不对。 与植物说话"}, {"type": "subtitle", "time": 1929.35, "timestamp": "00:32:09", "text": "对它们有益。 你知道吗？ 所以，我的意思是，"}, {"type": "subtitle", "time": 1931.19, "timestamp": "00:32:11", "text": "我们总能找到那张卡。"}, {"type": "subtitle", "time": 1934.23, "timestamp": "00:32:14", "text": "我其实并不知道。"}, {"type": "subtitle", "time": 1935.99, "timestamp": "00:32:15", "text": "我的意思是，它们毕竟是生物"}, {"type": "subtitle", "time": 1936.789, "timestamp": "00:32:16", "text": "。"}, {"type": "subtitle", "time": 1938.47, "timestamp": "00:32:18", "text": "是啊，我以为它们"}, {"type": "subtitle", "time": 1939.83, "timestamp": "00:32:19", "text": "没有耳朵。"}, {"type": "subtitle", "time": 1941.669, "timestamp": "00:32:21", "text": "不，这就像"}, {"type": "subtitle", "time": 1943.75, "timestamp": "00:32:23", "text": "如果你有计划听音乐那样，"}, {"type": "subtitle", "time": 1945.269, "timestamp": "00:32:25", "text": "你知道的。"}, {"type": "subtitle", "time": 1946.789, "timestamp": "00:32:26", "text": "我听说过这件事。 我其实从来没听说过这件事，"}, {"type": "subtitle", "time": 1948.07, "timestamp": "00:32:28", "text": "因为我从来没有"}, {"type": "subtitle", "time": 1950.23, "timestamp": "00:32:30", "text": "查阅过相关的"}, {"type": "subtitle", "time": 1952.149, "timestamp": "00:32:32", "text": "研究资料。 所以我对此非常"}, {"type": "subtitle", "time": 1954.549, "timestamp": "00:32:34", "text": "怀疑。 这是"}, {"type": "subtitle", "time": 1957.11, "timestamp": "00:32:37", "text": "真的吗？"}, {"type": "subtitle", "time": 1960.149, "timestamp": "00:32:40", "text": "嗯，我觉得在某种程度上是这样，但我"}, {"type": "subtitle", "time": 1961.11, "timestamp": "00:32:41", "text": "不知道具体程度如何。   是的"}, {"type": "subtitle", "time": 1962.87, "timestamp": "00:32:42", "text": "。 不。是的。 是的。"}, {"type": "subtitle", "time": 1965.11, "timestamp": "00:32:45", "text": "嗯。"}, {"type": "subtitle", "time": 1966.87, "timestamp": "00:32:46", "text": "听着，如果我足够相信，那就是"}, {"type": "subtitle", "time": 1968.71, "timestamp": "00:32:48", "text": "真的。"}, {"type": "subtitle", "time": 1971.35, "timestamp": "00:32:51", "text": "只要我愿意，幻觉就能变成现实"}, {"type": "subtitle", "time": 1971.83, "timestamp": "00:32:51", "text": "。   是的"}, {"type": "subtitle", "time": 1973.83, "timestamp": "00:32:53", "text": "。 当我跟我的仙人掌说话时，它也会回应我"}, {"type": "subtitle", "time": 1978.23, "timestamp": "00:32:58", "text": "。 没人敢顶嘴。"}]
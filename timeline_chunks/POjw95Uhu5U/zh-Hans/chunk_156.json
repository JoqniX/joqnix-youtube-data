[{"type": "subtitle", "time": 9362.15, "timestamp": "02:36:02", "text": "克里斯彭看到，呃，好像有"}, {"type": "subtitle", "time": 9364.63, "timestamp": "02:36:04", "text": "很多走廊，你会注意到，比如"}, {"type": "subtitle", "time": 9366.95, "timestamp": "02:36:06", "text": "这边，"}, {"type": "subtitle", "time": 9369.19, "timestamp": "02:36:09", "text": "好像还有一个洞，你"}, {"type": "subtitle", "time": 9371.27, "timestamp": "02:36:11", "text": "可以从洞里往外看，然后它通向"}, {"type": "subtitle", "time": 9372.95, "timestamp": "02:36:12", "text": "另一条走廊。"}, {"type": "subtitle", "time": 9373.91, "timestamp": "02:36:13", "text": "嗯。"}, {"type": "subtitle", "time": 9375.67, "timestamp": "02:36:15", "text": "然后，在末端这里，看起来"}, {"type": "subtitle", "time": 9377.03, "timestamp": "02:36:17", "text": "好像可以推。 你想继续推进吗"}, {"type": "subtitle", "time": 9377.67, "timestamp": "02:36:17", "text": "？"}, {"type": "subtitle", "time": 9378.95, "timestamp": "02:36:18", "text": "推它。"}, {"type": "subtitle", "time": 9381.51, "timestamp": "02:36:21", "text": "好的。 你推它，然后就像，呃，它"}, {"type": "subtitle", "time": 9383.51, "timestamp": "02:36:23", "text": "注意到门自己打开了，"}, {"type": "subtitle", "time": 9387.51, "timestamp": "02:36:27", "text": "就像它跑了过去，然后"}, {"type": "subtitle", "time": 9389.59, "timestamp": "02:36:29", "text": "呃，是的。"}, {"type": "subtitle", "time": 9391.27, "timestamp": "02:36:31", "text": "我"}, {"type": "subtitle", "time": 9393.59, "timestamp": "02:36:33", "text": "之前没注意到，所以想问一下，"}, {"type": "subtitle", "time": 9397.11, "timestamp": "02:36:37", "text": "范为什么会有一个所谓的“会说话的同性恋"}, {"type": "subtitle", "time": 9399.27, "timestamp": "02:36:39", "text": "土豆”？"}, {"type": "subtitle", "time": 9400.71, "timestamp": "02:36:40", "text": "那是一支手电筒。"}, {"type": "subtitle", "time": 9403.19, "timestamp": "02:36:43", "text": "变成了："}, {"type": "subtitle", "time": 9406.469, "timestamp": "02:36:46", "text": "是的，是GLaDOS。 我们喜欢GLaDOS。"}, {"type": "subtitle", "time": 9407.91, "timestamp": "02:36:47", "text": "这些是什么？"}, {"type": "subtitle", "time": 9410.23, "timestamp": "02:36:50", "text": "好的。 呃，那些是箱子。 你想"}, {"type": "subtitle", "time": 9411.51, "timestamp": "02:36:51", "text": "打开它吗？"}, {"type": "subtitle", "time": 9414.71, "timestamp": "02:36:54", "text": "嗯，克里斯辛斯打开了其中一个箱子。"}, {"type": "subtitle", "time": 9417.19, "timestamp": "02:36:57", "text": "好的，克里斯彭，你打开其中一个"}, {"type": "subtitle", "time": 9419.91, "timestamp": "02:36:59", "text": "箱子，然后在里面发现……呃……"}]
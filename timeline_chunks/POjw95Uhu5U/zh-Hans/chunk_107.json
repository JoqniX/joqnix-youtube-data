[{"type": "subtitle", "time": 6423.71, "timestamp": "01:47:03", "text": "你现在可能"}, {"type": "subtitle", "time": 6438.629, "timestamp": "01:47:18", "text": "乔纳从独木舟上醒来后立即扔掉母鸡"}, {"type": "subtitle", "time": 6441.35, "timestamp": "01:47:21", "text": "。"}, {"type": "subtitle", "time": 6443.72, "timestamp": "01:47:23", "text": "是的。"}, {"type": "subtitle", "time": 6449.83, "timestamp": "01:47:29", "text": "[音乐]"}, {"type": "subtitle", "time": 6456.79, "timestamp": "01:47:36", "text": "约翰不在这里的原因是他正在把"}, {"type": "subtitle", "time": 6458.629, "timestamp": "01:47:38", "text": "独木舟推下楼梯。公平地说"}, {"type": "subtitle", "time": 6460.79, "timestamp": "01:47:40", "text": "，严格来说，我们确实"}, {"type": "subtitle", "time": 6462.629, "timestamp": "01:47:42", "text": "有那只鸟。那只鸟实际上是"}, {"type": "subtitle", "time": 6464.87, "timestamp": "01:47:44", "text": "通常携带东西的。 是啊。是啊"}, {"type": "subtitle", "time": 6469.03, "timestamp": "01:47:49", "text": "。所以，它总是在他背上。"}, {"type": "subtitle", "time": 6472.149, "timestamp": "01:47:52", "text": "鸟儿正带着鸟儿"}, {"type": "subtitle", "time": 6478.87, "timestamp": "01:47:58", "text": "早上好，Ka。然后决定"}]
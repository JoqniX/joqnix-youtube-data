[{"type": "subtitle", "time": 8822.389, "timestamp": "02:27:02", "text": "我们走吧。 它又变回了原来的样子，"}, {"type": "subtitle", "time": 8825.429, "timestamp": "02:27:05", "text": "现在就像一座坍塌的雕像。"}, {"type": "subtitle", "time": 8827.67, "timestamp": "02:27:07", "text": "一座残破的雕像，看起来像金色，但"}, {"type": "subtitle", "time": 8830.07, "timestamp": "02:27:10", "text": "实际上并非金色。 它看起来像是"}, {"type": "subtitle", "time": 8835.75, "timestamp": "02:27:15", "text": "我觉得它的意思是，如果"}, {"type": "subtitle", "time": 8838.63, "timestamp": "02:27:18", "text": "这些雕像都还活着，那把一切都交给"}, {"type": "subtitle", "time": 8842.23, "timestamp": "02:27:22", "text": "它们来做就太搞笑了。"}, {"type": "subtitle", "time": 8845.349, "timestamp": "02:27:25", "text": "我的天啊。 我们应该再做一次吗？"}, {"type": "subtitle", "time": 8848.71, "timestamp": "02:27:28", "text": "我的天啊。 好的。 好的。 让我"}, {"type": "subtitle", "time": 8851.19, "timestamp": "02:27:31", "text": "快速地做一下。 让我们回到“是”的状态"}, {"type": "subtitle", "time": 8853.51, "timestamp": "02:27:33", "text": "。 地牢。 好的。"}, {"type": "subtitle", "time": 8854.79, "timestamp": "02:27:34", "text": "好的。   还"}, {"type": "subtitle", "time": 8857.19, "timestamp": "02:27:37", "text": "我。"}, {"type": "subtitle", "time": 8858.389, "timestamp": "02:27:38", "text": "好的。"}, {"type": "subtitle", "time": 8862.15, "timestamp": "02:27:42", "text": "我可以用一些……呃……"}, {"type": "subtitle", "time": 8864.389, "timestamp": "02:27:44", "text": "我打算用一些……手法治疗一下"}, {"type": "subtitle", "time": 8866.95, "timestamp": "02:27:46", "text": "Ka。 好了。"}, {"type": "subtitle", "time": 8867.67, "timestamp": "02:27:47", "text": "谢谢。"}, {"type": "subtitle", "time": 8868.55, "timestamp": "02:27:48", "text": "好的。"}, {"type": "subtitle", "time": 8872.07, "timestamp": "02:27:52", "text": "我将给你10点生命值。"}, {"type": "subtitle", "time": 8874.23, "timestamp": "02:27:54", "text": "好的。 你触碰Ka，获得10点生命"}, {"type": "subtitle", "time": 8875.83, "timestamp": "02:27:55", "text": "值。 干得好。   好了"}, {"type": "subtitle", "time": 8877.99, "timestamp": "02:27:57", "text": "。 按下那个键。"}, {"type": "subtitle", "time": 8879.83, "timestamp": "02:27:59", "text": "她吃饱了吗？ 不，绝对"}]
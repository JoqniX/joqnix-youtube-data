[{"type": "subtitle", "time": 5640.229, "timestamp": "01:34:00", "text": "好像在滴金子，但"}, {"type": "subtitle", "time": 5641.35, "timestamp": "01:34:01", "text": "你不确定它是不是真的冷，"}, {"type": "subtitle", "time": 5642.79, "timestamp": "01:34:02", "text": "因为如果真是金子的话，"}, {"type": "subtitle", "time": 5645.91, "timestamp": "01:34:05", "text": "这里肯定会更热。"}, {"type": "subtitle", "time": 5649.83, "timestamp": "01:34:09", "text": "哇。谢天谢地他不怕火。"}, {"type": "subtitle", "time": 5651.51, "timestamp": "01:34:11", "text": "他根本不在乎热，"}, {"type": "subtitle", "time": 5655.83, "timestamp": "01:34:15", "text": "但是我的天啊。哦，有意思。"}, {"type": "subtitle", "time": 5659.11, "timestamp": "01:34:19", "text": "这里有个很热的地方。"}, {"type": "subtitle", "time": 5661.99, "timestamp": "01:34:21", "text": "雕像好像在融化。是的。雕像在"}, {"type": "subtitle", "time": 5664.149, "timestamp": "01:34:24", "text": "融化。我之前没注意到"}, {"type": "subtitle", "time": 5665.43, "timestamp": "01:34:25", "text": "雕像会融化。"}, {"type": "subtitle", "time": 5667.27, "timestamp": "01:34:27", "text": "那是一座山。一个喷泉。"}, {"type": "subtitle", "time": 5668.79, "timestamp": "01:34:28", "text": "喷泉。对。"}, {"type": "subtitle", "time": 5669.35, "timestamp": "01:34:29", "text": "有金子。在"}, {"type": "subtitle", "time": 5670.87, "timestamp": "01:34:30", "text": "滴。看起来像熔化的"}, {"type": "subtitle", "time": 5673.189, "timestamp": "01:34:33", "text": "金子？"}, {"type": "subtitle", "time": 5677.75, "timestamp": "01:34:37", "text": "是的。嗯，有意思。"}, {"type": "subtitle", "time": 5681.43, "timestamp": "01:34:41", "text": "它会开始上升。那里似乎"}, {"type": "subtitle", "time": 5684.229, "timestamp": "01:34:44", "text": "没有什么明显的"}, {"type": "subtitle", "time": 5687.669, "timestamp": "01:34:47", "text": "危险，或者我不知道。"}, {"type": "subtitle", "time": 5689.99, "timestamp": "01:34:49", "text": "嗯，如果现在有什么危险的话，他"}, {"type": "subtitle", "time": 5692.47, "timestamp": "01:34:52", "text": "早就死了，但"}, {"type": "subtitle", "time": 5694.629, "timestamp": "01:34:54", "text": "显然他还活着。"}, {"type": "subtitle", "time": 5697.189, "timestamp": "01:34:57", "text": "是的。"}]
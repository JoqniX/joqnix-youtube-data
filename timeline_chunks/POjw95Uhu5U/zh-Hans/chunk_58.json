[{"type": "subtitle", "time": 3483.589, "timestamp": "00:58:03", "text": "它依靠钾的能量运行"}, {"type": "subtitle", "time": 3485.109, "timestamp": "00:58:05", "text": "。"}, {"type": "subtitle", "time": 3486.549, "timestamp": "00:58:06", "text": "好了，就是这样。 我觉得"}, {"type": "subtitle", "time": 3487.91, "timestamp": "00:58:07", "text": "现在应该可以了。 现在就试试吧。"}, {"type": "subtitle", "time": 3489.91, "timestamp": "00:58:09", "text": "我喜欢想象范拔出"}, {"type": "subtitle", "time": 3492.71, "timestamp": "00:58:12", "text": "剑的画面。 她当时就想：“搞什么鬼？这"}, {"type": "subtitle", "time": 3496.63, "timestamp": "00:58:16", "text": "土豆怎么变成这样了？为什么？为什么？"}, {"type": "subtitle", "time": 3499.589, "timestamp": "00:58:19", "text": "为什么它会发出那种娘娘腔的灯光？你"}, {"type": "subtitle", "time": 3506.95, "timestamp": "00:58:26", "text": "它是个会说话的娘娘腔土豆。"}, {"type": "subtitle", "time": 3509.19, "timestamp": "00:58:29", "text": "我不想说话。她可能会说："}, {"type": "subtitle", "time": 3510.71, "timestamp": "00:58:30", "text": "‘那我先下去吗"}, {"type": "subtitle", "time": 3512.71, "timestamp": "00:58:32", "text": "？’因为我们还不知道下面有什么"}, {"type": "subtitle", "time": 3515.51, "timestamp": "00:58:35", "text": "。而且，"}, {"type": "subtitle", "time": 3516.95, "timestamp": "00:58:36", "text": "对方在下面，所以可能"}, {"type": "subtitle", "time": 3518.95, "timestamp": "00:58:38", "text": "没什么危险。我们睡觉的"}, {"type": "subtitle", "time": 3520.71, "timestamp": "00:58:40", "text": "时候可能已经处理过了"}, {"type": "subtitle", "time": 3523.829, "timestamp": "00:58:43", "text": "。如果说"}, {"type": "subtitle", "time": 3532.63, "timestamp": "00:58:52", "text": "好吧。是的"}, {"type": "subtitle", "time": 3534.47, "timestamp": "00:58:54", "text": "。我的意思是，你肯定可以"}]
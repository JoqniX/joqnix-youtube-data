[{"type": "subtitle", "time": 4201.35, "timestamp": "01:10:01", "text": "非常堕落。但……"}, {"type": "subtitle", "time": 4203.669, "timestamp": "01:10:03", "text": "至少我们没有她那样看着"}, {"type": "subtitle", "time": 4205.51, "timestamp": "01:10:05", "text": "爱莉安娜的眼神。“"}, {"type": "subtitle", "time": 4207.75, "timestamp": "01:10:07", "text": "我的天哪。卡米拉，你刚才是在维护我们吗"}, {"type": "subtitle", "time": 4210.149, "timestamp": "01:10:10", "text": "？"}, {"type": "subtitle", "time": 4212.149, "timestamp": "01:10:12", "text": "哦不。"}, {"type": "subtitle", "time": 4223.59, "timestamp": "01:10:23", "text": "意识到自己说了什么，她会说："}, {"type": "subtitle", "time": 4225.03, "timestamp": "01:10:25", "text": "“不，等等。” 不。"}, {"type": "subtitle", "time": 4227.75, "timestamp": "01:10:27", "text": "我的天哪。 我的天啊。 我得把这件事告诉"}, {"type": "subtitle", "time": 4230.79, "timestamp": "01:10:30", "text": "所有人。"}, {"type": "subtitle", "time": 4234.07, "timestamp": "01:10:34", "text": "我得到了它。 我得说出来。"}, {"type": "subtitle", "time": 4235.59, "timestamp": "01:10:35", "text": "我的天啊。 你会被"}, {"type": "subtitle", "time": 4238.49, "timestamp": "01:10:38", "text": "冰块抱住。"}, {"type": "subtitle", "time": 4239.83, "timestamp": "01:10:39", "text": "[音乐] 被"}, {"type": "subtitle", "time": 4240.87, "timestamp": "01:10:40", "text": "冰拥抱吧。   该死的"}, {"type": "subtitle", "time": 4249.35, "timestamp": "01:10:49", "text": "我的天啊。 卡米拉，你确实爱我们。"}, {"type": "subtitle", "time": 4255.59, "timestamp": "01:10:55", "text": "卡米拉就像在摇头，"}, {"type": "subtitle", "time": 4258.31, "timestamp": "01:10:58", "text": "好像在说：“我怎么会走到这一步？我就是……”"}]
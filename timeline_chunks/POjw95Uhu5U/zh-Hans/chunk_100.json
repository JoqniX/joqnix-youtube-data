[{"type": "subtitle", "time": 6009.03, "timestamp": "01:40:09", "text": "啊，这种情况难免。如果…… ..."}, {"type": "subtitle", "time": 6010.07, "timestamp": "01:40:10", "text": "看看它，还是你想"}, {"type": "subtitle", "time": 6011.51, "timestamp": "01:40:11", "text": "调查一下？看看"}, {"type": "subtitle", "time": 6012.709, "timestamp": "01:40:12", "text": "它有没有什么奇怪的地方。"}, {"type": "subtitle", "time": 6013.99, "timestamp": "01:40:13", "text": "哦，对。"}, {"type": "subtitle", "time": 6017.83, "timestamp": "01:40:17", "text": "调查一下，比如这金子是不是有什么"}, {"type": "subtitle", "time": 6019.91, "timestamp": "01:40:19", "text": "特别之处？我猜她正在"}, {"type": "subtitle", "time": 6020.79, "timestamp": "01:40:20", "text": "看的就是这个。"}, {"type": "subtitle", "time": 6023.109, "timestamp": "01:40:23", "text": "好的。我们可以调查了吗？好的。我"}, {"type": "subtitle", "time": 6025.03, "timestamp": "01:40:25", "text": "得调查一下我的斯特凡。"}, {"type": "subtitle", "time": 6027.03, "timestamp": "01:40:27", "text": "我还要调查一下克里斯平"}, {"type": "subtitle", "time": 6028.07, "timestamp": "01:40:28", "text": "。"}, {"type": "subtitle", "time": 6030.39, "timestamp": "01:40:30", "text": "好的。哦，你被克里斯平盯上了。好的。好的。"}, {"type": "subtitle", "time": 6035.75, "timestamp": "01:40:35", "text": "这真是……这太令人沮丧了。我"}, {"type": "subtitle", "time": 6037.03, "timestamp": "01:40:37", "text": "只是想给你看看，"}, {"type": "subtitle", "time": 6038.629, "timestamp": "01:40:38", "text": "因为这太令人沮丧了。这是"}, {"type": "subtitle", "time": 6041.99, "timestamp": "01:40:41", "text": "埃斯坦。这是阿丽亚娜。这是"}, {"type": "subtitle", "time": 6045.75, "timestamp": "01:40:45", "text": "克里斯平。好的。掷先攻。"}, {"type": "subtitle", "time": 6046.55, "timestamp": "01:40:46", "text": "哦。"}, {"type": "subtitle", "time": 6047.669, "timestamp": "01:40:47", "text": "哦不。"}, {"type": "subtitle", "time": 6051.99, "timestamp": "01:40:51", "text": "该死。哦该死。好的。"}, {"type": "subtitle", "time": 6053.669, "timestamp": "01:40:53", "text": "我猜是先攻。"}, {"type": "subtitle", "time": 6055.43, "timestamp": "01:40:55", "text": "让我来。好了。唉"}, {"type": "subtitle", "time": 6058.709, "timestamp": "01:40:58", "text": "，人生真糟糕。好吧"}]
[{"type": "subtitle", "time": 1802.149, "timestamp": "00:30:02", "text": "我知道至少对于"}, {"type": "subtitle", "time": 1812.47, "timestamp": "00:30:12", "text": "如果是另一方，我就直"}, {"type": "subtitle", "time": 1814.87, "timestamp": "00:30:14", "text": "说了。 如果对方……嗯，"}, {"type": "subtitle", "time": 1817.59, "timestamp": "00:30:17", "text": "你知道，范最终以某种方式"}, {"type": "subtitle", "time": 1821.19, "timestamp": "00:30:21", "text": "分崩离析，我觉得有"}, {"type": "subtitle", "time": 1823.269, "timestamp": "00:30:23", "text": "机会，如果他破坏得太厉害，"}, {"type": "subtitle", "time": 1826.71, "timestamp": "00:30:26", "text": "我基本上就会放"}, {"type": "subtitle", "time": 1828.149, "timestamp": "00:30:28", "text": "他走，扮演另一个角色，告诉"}, {"type": "subtitle", "time": 1830.47, "timestamp": "00:30:30", "text": "韩南你可以随意使用他，现在"}, {"type": "subtitle", "time": 1833.59, "timestamp": "00:30:33", "text": "你掌控一切。"}, {"type": "subtitle", "time": 1837.909, "timestamp": "00:30:37", "text": "听着，他已经……他已经"}, {"type": "subtitle", "time": 1839.83, "timestamp": "00:30:39", "text": "变坏了，他已经"}, {"type": "subtitle", "time": 1841.83, "timestamp": "00:30:41", "text": "迷失了自我，如果他彻底迷失了自我，"}, {"type": "subtitle", "time": 1843.83, "timestamp": "00:30:43", "text": "我会把控制权交给韩南"}, {"type": "subtitle", "time": 1845.909, "timestamp": "00:30:45", "text": "。 耶稣来掌舵吧，兄弟。   是的"}, {"type": "subtitle", "time": 1847.029, "timestamp": "00:30:47", "text": "。"}, {"type": "subtitle", "time": 1849.19, "timestamp": "00:30:49", "text": "耶稣接管一切。"}, {"type": "subtitle", "time": 1851.909, "timestamp": "00:30:51", "text": "耶稣，请掌舵。"}, {"type": "subtitle", "time": 1855.11, "timestamp": "00:30:55", "text": "接过来吧。   当然"}, {"type": "subtitle", "time": 1856.559, "timestamp": "00:30:56", "text": "。   当然 。 当然。 当然。   当然"}, {"type": "subtitle", "time": 1858.88, "timestamp": "00:30:58", "text": "。 当然。 当然。   当然 。   当然"}, {"type": "subtitle", "time": 1859.6, "timestamp": "00:30:59", "text": "。   当然 。"}]
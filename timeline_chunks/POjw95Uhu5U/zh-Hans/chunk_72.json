[{"type": "subtitle", "time": 4335.51, "timestamp": "01:12:15", "text": "好的。 大概会是这样的：难道你不想"}, {"type": "subtitle", "time": 4339.11, "timestamp": "01:12:19", "text": "拥有一些魔法物品吗？"}, {"type": "subtitle", "time": 4340.79, "timestamp": "01:12:20", "text": "哦，等等。"}, {"type": "subtitle", "time": 4341.59, "timestamp": "01:12:21", "text": "哦，什么？"}, {"type": "subtitle", "time": 4343.75, "timestamp": "01:12:23", "text": "魔法物品。 等等，等等。 其实，"}, {"type": "subtitle", "time": 4345.11, "timestamp": "01:12:25", "text": "其实，是魔法物品"}, {"type": "subtitle", "time": 4347.83, "timestamp": "01:12:27", "text": "。 我们说的是哪些魔法物品"}, {"type": "subtitle", "time": 4354.709, "timestamp": "01:12:34", "text": "爱莉安娜就像其他人一样，即将回归"}, {"type": "subtitle", "time": 4356.79, "timestamp": "01:12:36", "text": "。 她就问，呃，为什么，"}, {"type": "subtitle", "time": 4360.31, "timestamp": "01:12:40", "text": "我们为什么要回去？ 哎哟。 只是一点点，"}, {"type": "subtitle", "time": 4363.35, "timestamp": "01:12:43", "text": "你知道，"}, {"type": "subtitle", "time": 4365.27, "timestamp": "01:12:45", "text": "因为卡梅拉说，"}, {"type": "subtitle", "time": 4367.11, "timestamp": "01:12:47", "text": "有些事情可能"}, {"type": "subtitle", "time": 4370.39, "timestamp": "01:12:50", "text": "对我们党有帮助。"}, {"type": "subtitle", "time": 4374.47, "timestamp": "01:12:54", "text": "嗯，是的。 嗯，我……请你从"}, {"type": "subtitle", "time": 4377.51, "timestamp": "01:12:57", "text": "我身上下来，冰棒。 她会"}, {"type": "subtitle", "time": 4379.35, "timestamp": "01:12:59", "text": "强行闯过去。 我大概会说"}]
[{"type": "subtitle", "time": 9185.91, "timestamp": "02:33:05", "text": "不敢相信自己正在做这件事。 我正在"}, {"type": "subtitle", "time": 9189.03, "timestamp": "02:33:09", "text": "努力寻找解开这个谜团的女巫"}, {"type": "subtitle", "time": 9191.349, "timestamp": "02:33:11", "text": "。 谁知道谁知道拥有"}, {"type": "subtitle", "time": 9194.15, "timestamp": "02:33:14", "text": "敏锐的头脑是多么困难，"}, {"type": "subtitle", "time": 9196.389, "timestamp": "02:33:16", "text": "因为我当时想，嗯，我记得当时"}, {"type": "subtitle", "time": 9198.15, "timestamp": "02:33:18", "text": "觉得它的位置很奇怪。 我"}, {"type": "subtitle", "time": 9199.91, "timestamp": "02:33:19", "text": "认为至少有一个人领先。 我知道"}, {"type": "subtitle", "time": 9201.59, "timestamp": "02:33:21", "text": "克里斯恩已经领先太多了。"}, {"type": "subtitle", "time": 9201.99, "timestamp": "02:33:21", "text": "是啊，"}, {"type": "subtitle", "time": 9204.15, "timestamp": "02:33:24", "text": "但我不知道是一个方格还是两个"}, {"type": "subtitle", "time": 9207.83, "timestamp": "02:33:27", "text": "方格。 嗯……我觉得它在这里，但为了以防万一，"}, {"type": "subtitle", "time": 9211.83, "timestamp": "02:33:31", "text": "我会一直"}, {"type": "subtitle", "time": 9214.95, "timestamp": "02:33:34", "text": "盯着它，直到它从屏幕上消失"}, {"type": "subtitle", "time": 9221.91, "timestamp": "02:33:41", "text": "。 我们不……好吧，就这样吧。"}, {"type": "subtitle", "time": 9225.11, "timestamp": "02:33:45", "text": "具体位置在这里。 就是"}, {"type": "subtitle", "time": 9226.389, "timestamp": "02:33:46", "text": "这一部分。"}, {"type": "subtitle", "time": 9228.55, "timestamp": "02:33:48", "text": "好的，我觉得画在那些方格上的任何位置都"}, {"type": "subtitle", "time": 9230.309, "timestamp": "02:33:50", "text": "可以。 该方格上的任何位置"}, {"type": "subtitle", "time": 9233.59, "timestamp": "02:33:53", "text": "。"}, {"type": "subtitle", "time": 9235.51, "timestamp": "02:33:55", "text": "真是个绝佳的矿井。"}, {"type": "subtitle", "time": 9236.469, "timestamp": "02:33:56", "text": "敏锐的矿井。"}, {"type": "subtitle", "time": 9238.15, "timestamp": "02:33:58", "text": "我的天啊。"}]
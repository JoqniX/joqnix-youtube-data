[{"type": "subtitle", "time": 5100.12, "timestamp": "01:25:00", "text": "我最多只能给150。"}, {"type": "subtitle", "time": 5114.95, "timestamp": "01:25:14", "text": "好了，你们去拿标签。是的，"}, {"type": "subtitle", "time": 5119.189, "timestamp": "01:25:19", "text": "我会移动瀑布，对吧？"}, {"type": "subtitle", "time": 5121.669, "timestamp": "01:25:21", "text": "壁炉架。好的。好的。好的。我会"}, {"type": "subtitle", "time": 5125.75, "timestamp": "01:25:25", "text": "移动你的图像。"}, {"type": "subtitle", "time": 5127.83, "timestamp": "01:25:27", "text": "好的。给你。你想让我去"}, {"type": "subtitle", "time": 5133.11, "timestamp": "01:25:33", "text": "。是的"}, {"type": "subtitle", "time": 5135.03, "timestamp": "01:25:35", "text": "。我们要去。是的。然后"}, {"type": "subtitle", "time": 5136.31, "timestamp": "01:25:36", "text": "我们把它给 乔之后。是啊"}, {"type": "subtitle", "time": 5138.55, "timestamp": "01:25:38", "text": "。是啊。对。是啊。呃，就拿走，"}, {"type": "subtitle", "time": 5142.149, "timestamp": "01:25:42", "text": "呃，加150，卡梅拉减去150作为你的"}, {"type": "subtitle", "time": 5143.189, "timestamp": "01:25:43", "text": "钱。"}, {"type": "subtitle", "time": 5144.39, "timestamp": "01:25:44", "text": "不，不，不。钱在我手里。"}, {"type": "subtitle", "time": 5145.35, "timestamp": "01:25:45", "text": "卡米拉拿到钱了，对吧？"}, {"type": "subtitle", "time": 5147.27, "timestamp": "01:25:47", "text": "哦，是啊。抱歉。抱歉。是啊。"}, {"type": "subtitle", "time": 5150.29, "timestamp": "01:25:50", "text": "减去150"}, {"type": "subtitle", "time": 5151.51, "timestamp": "01:25:51", "text": "[音乐]"}, {"type": "subtitle", "time": 5154.47, "timestamp": "01:25:54", "text": "也被抢劫了。"}, {"type": "subtitle", "time": 5156.39, "timestamp": "01:25:56", "text": "我觉得这太让人困惑了，她刚刚被"}, {"type": "subtitle", "time": 5157.669, "timestamp": "01:25:57", "text": "抢劫了。"}]
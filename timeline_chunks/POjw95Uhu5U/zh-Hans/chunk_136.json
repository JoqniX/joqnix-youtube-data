[{"type": "subtitle", "time": 8160.47, "timestamp": "02:16:00", "text": "嗯，这件事我们以后再处理。"}, {"type": "subtitle", "time": 8163.669, "timestamp": "02:16:03", "text": "好的。 然后，一切就都好了。 呃，下一个"}, {"type": "subtitle", "time": 8164.79, "timestamp": "02:16:04", "text": "是斯特凡。"}, {"type": "subtitle", "time": 8167.43, "timestamp": "02:16:07", "text": "范，小心点，拿回你的钱。 伙计们"}, {"type": "subtitle", "time": 8169.27, "timestamp": "02:16:09", "text": "，"}, {"type": "subtitle", "time": 8171.43, "timestamp": "02:16:11", "text": "小心！ 我觉得我的"}, {"type": "subtitle", "time": 8173.35, "timestamp": "02:16:13", "text": "钱被偷了。"}, {"type": "subtitle", "time": 8176.47, "timestamp": "02:16:16", "text": "我看得出来。 我完全能看出来"}, {"type": "subtitle", "time": 8177.43, "timestamp": "02:16:17", "text": "。"}, {"type": "subtitle", "time": 8179.03, "timestamp": "02:16:19", "text": "糟糕。 我的错。 我不是故意要弄翻"}, {"type": "subtitle", "time": 8181.75, "timestamp": "02:16:21", "text": "它的。 我当时想，呃，这对我来说稍微"}, {"type": "subtitle", "time": 8184.069, "timestamp": "02:16:24", "text": "远了一点。 我不太喜欢靠得"}, {"type": "subtitle", "time": 8192.07, "timestamp": "02:16:32", "text": "我到底该怎么办？"}, {"type": "subtitle", "time": 8193.91, "timestamp": "02:16:33", "text": "我在想我应该攻击还是应该"}, {"type": "subtitle", "time": 8196.87, "timestamp": "02:16:36", "text": "治疗，或者你们……呃，我的意思是，"}, {"type": "subtitle", "time": 8207.03, "timestamp": "02:16:47", "text": "[音乐]"}, {"type": "subtitle", "time": 8210.95, "timestamp": "02:16:50", "text": "我可能只会治疗一次。 我想我"}, {"type": "subtitle", "time": 8219.91, "timestamp": "02:16:59", "text": "该死的破事。 这群愚蠢的"}]
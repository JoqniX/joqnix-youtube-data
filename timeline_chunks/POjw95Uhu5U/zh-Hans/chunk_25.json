[{"type": "subtitle", "time": 1500.63, "timestamp": "00:25:00", "text": "准确。 卡米拉不会再打人了，"}, {"type": "subtitle", "time": 1503.51, "timestamp": "00:25:03", "text": "因为她不知为何总是打不中。"}, {"type": "subtitle", "time": 1507.19, "timestamp": "00:25:07", "text": "卡米拉没有去做眼科检查。"}, {"type": "subtitle", "time": 1510.149, "timestamp": "00:25:10", "text": "我觉得达里安有这条胳膊，"}, {"type": "subtitle", "time": 1512.23, "timestamp": "00:25:12", "text": "对吧？ 达里安有这条"}, {"type": "subtitle", "time": 1518.23, "timestamp": "00:25:18", "text": "Burst。 是的，巴尔确实有这种"}, {"type": "subtitle", "time": 1521.11, "timestamp": "00:25:21", "text": "武装攻击手段。 我从来没用过。"}, {"type": "subtitle", "time": 1524.07, "timestamp": "00:25:24", "text": "耶稣基督。 对不起。 不是因为"}, {"type": "subtitle", "time": 1527.59, "timestamp": "00:25:27", "text": "我的喉咙里卡了一块该死的蜂蜜黄油巧克力片"}, {"type": "subtitle", "time": 1529.35, "timestamp": "00:25:29", "text": "。"}, {"type": "subtitle", "time": 1534.549, "timestamp": "00:25:34", "text": "天哪。   是的"}, {"type": "subtitle", "time": 1537.11, "timestamp": "00:25:37", "text": "。 不，因为我"}, {"type": "subtitle", "time": 1539.19, "timestamp": "00:25:39", "text": "这么想的原因是，如果卡梅拉"}, {"type": "subtitle", "time": 1541.669, "timestamp": "00:25:41", "text": "真的用魔杖发出火球"}, {"type": "subtitle", "time": 1549.51, "timestamp": "00:25:49", "text": "[音乐]"}, {"type": "subtitle", "time": 1551.75, "timestamp": "00:25:51", "text": "我说，卡米拉，卡米拉会的，她可不"}, {"type": "subtitle", "time": 1553.59, "timestamp": "00:25:53", "text": "傻。 她会选择合适的"}, {"type": "subtitle", "time": 1559.11, "timestamp": "00:25:59", "text": "搞什么鬼？  M."}]
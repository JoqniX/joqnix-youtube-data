[{"type": "subtitle", "time": 4082.47, "timestamp": "01:08:02", "text": "尽量不去想那些好听的"}, {"type": "subtitle", "time": 4090.71, "timestamp": "01:08:10", "text": "当然。它们都是乳制品。"}, {"type": "subtitle", "time": 4102.47, "timestamp": "01:08:22", "text": "[音乐]"}, {"type": "subtitle", "time": 4104.789, "timestamp": "01:08:24", "text": "我的天哪。"}, {"type": "subtitle", "time": 4107.829, "timestamp": "01:08:27", "text": "我觉得他可能看起来像是在"}, {"type": "subtitle", "time": 4119.829, "timestamp": "01:08:39", "text": "过来。"}, {"type": "subtitle", "time": 4123.269, "timestamp": "01:08:43", "text": "嗯，我有点困惑。你的队伍"}, {"type": "subtitle", "time": 4126.63, "timestamp": "01:08:46", "text": "就像一群"}, {"type": "subtitle", "time": 4129.11, "timestamp": "01:08:49", "text": "生物，但话说回来，你"}, {"type": "subtitle", "time": 4133.669, "timestamp": "01:08:53", "text": "这里没有这些东西。看起来"}, {"type": "subtitle", "time": 4135.349, "timestamp": "01:08:55", "text": "棒极了。她：是"}]
[{"type": "subtitle", "time": 8280.469, "timestamp": "02:18:00", "text": "大佬的举动。 我想我还是发起"}, {"type": "subtitle", "time": 8282.07, "timestamp": "02:18:02", "text": "进攻吧。"}, {"type": "subtitle", "time": 8284.87, "timestamp": "02:18:04", "text": "看来我得发起进攻了，伙计们。 我猜我会发起"}, {"type": "subtitle", "time": 8286.309, "timestamp": "02:18:06", "text": "进攻。"}, {"type": "subtitle", "time": 8289.11, "timestamp": "02:18:09", "text": "呃，我到底该怎么办？"}, {"type": "subtitle", "time": 8292.23, "timestamp": "02:18:12", "text": "为什么我的“仇恨者之臂”会变成魔法？"}, {"type": "subtitle", "time": 8294.309, "timestamp": "02:18:14", "text": "一直以来都是群体魔法吗？"}, {"type": "subtitle", "time": 8295.589, "timestamp": "02:18:15", "text": "哦，是的。 它应该是背包"}, {"type": "subtitle", "time": 8297.03, "timestamp": "02:18:17", "text": "魔法。 我刚换成了魔法背包。"}, {"type": "subtitle", "time": 8298.79, "timestamp": "02:18:18", "text": "它总是打包魔法，"}, {"type": "subtitle", "time": 8301.27, "timestamp": "02:18:21", "text": "因为就像之前导入的时候，"}, {"type": "subtitle", "time": 8303.509, "timestamp": "02:18:23", "text": "它被导入成一个叫做什么的玩意儿，"}, {"type": "subtitle", "time": 8306.95, "timestamp": "02:18:26", "text": "然后又被导入成一个呃非打包魔法，"}, {"type": "subtitle", "time": 8308.95, "timestamp": "02:18:28", "text": "这有点奇怪。 我不知道为什么"}, {"type": "subtitle", "time": 8310.469, "timestamp": "02:18:30", "text": "re也应该是pack magic。"}, {"type": "subtitle", "time": 8313.83, "timestamp": "02:18:33", "text": "我不知道那边为什么会那样。   是的"}, {"type": "subtitle", "time": 8315.27, "timestamp": "02:18:35", "text": "，你的等级法术应该和"}, {"type": "subtitle", "time": 8317.429, "timestamp": "02:18:37", "text": "你的牧师法术一样。 有点奇怪"}, {"type": "subtitle", "time": 8320.469, "timestamp": "02:18:40", "text": "。 我可以稍后调整。   是的"}, {"type": "subtitle", "time": 8322.07, "timestamp": "02:18:42", "text": "。 是的。 有时当你导入它时（"}, {"type": "subtitle", "time": 8323.669, "timestamp": "02:18:43", "text": "例如当你进行多职业操作时），你需要"}, {"type": "subtitle", "time": 8325.11, "timestamp": "02:18:45", "text": "检查你当前激活的职业是什么，"}, {"type": "subtitle", "time": 8328.469, "timestamp": "02:18:48", "text": "它会导入到该职业中。 把"}, {"type": "subtitle", "time": 8331.83, "timestamp": "02:18:51", "text": "它放在那个槽位里，因为它会影响"}, {"type": "subtitle", "time": 8333.83, "timestamp": "02:18:53", "text": "法术准备之类的效果。"}, {"type": "subtitle", "time": 8335.99, "timestamp": "02:18:55", "text": "好的。 好的。"}, {"type": "subtitle", "time": 8339.669, "timestamp": "02:18:59", "text": "总之，我开始逃跑。"}]
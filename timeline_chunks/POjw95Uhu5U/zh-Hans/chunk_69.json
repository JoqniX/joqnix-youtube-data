[{"type": "subtitle", "time": 4140.229, "timestamp": "01:09:00", "text": "啊。是啊。说实话，嗯，我肯定"}, {"type": "subtitle", "time": 4142.87, "timestamp": "01:09:02", "text": "更高兴遇到这些人，而不是"}, {"type": "subtitle", "time": 4145.51, "timestamp": "01:09:05", "text": "你遇到的那些人。你知道的。 什么？我真"}, {"type": "subtitle", "time": 4149.11, "timestamp": "01:09:09", "text": "同情你。希望你今天过得愉快，"}, {"type": "subtitle", "time": 4151.749, "timestamp": "01:09:11", "text": "别跟"}, {"type": "subtitle", "time": 4153.189, "timestamp": "01:09:13", "text": "那些人闹翻。"}, {"type": "subtitle", "time": 4155.11, "timestamp": "01:09:15", "text": "卡米拉的眼神"}, {"type": "subtitle", "time": 4161.99, "timestamp": "01:09:21", "text": "我的天哪”。"}, {"type": "subtitle", "time": 4164.39, "timestamp": "01:09:24", "text": "她大概会说：“希望你"}, {"type": "subtitle", "time": 4169.669, "timestamp": "01:09:29", "text": "和你的花童玩得开心。”总比"}, {"type": "subtitle", "time": 4172.789, "timestamp": "01:09:32", "text": "一个好色的"}, {"type": "subtitle", "time": 4181.43, "timestamp": "01:09:41", "text": "嗯，"}, {"type": "subtitle", "time": 4184.55, "timestamp": "01:09:44", "text": "我的团队可能很"}, {"type": "subtitle", "time": 4186.87, "timestamp": "01:09:46", "text": "色很嗜血，"}, {"type": "subtitle", "time": 4189.43, "timestamp": "01:09:49", "text": "但他们其实……不，不，她"}, {"type": "subtitle", "time": 4190.789, "timestamp": "01:09:50", "text": "不会说“色”。她永远不会"}, {"type": "subtitle", "time": 4193.51, "timestamp": "01:09:53", "text": "这么说。那不够文雅。我敢"}, {"type": "subtitle", "time": 4197.43, "timestamp": "01:09:57", "text": "肯定我的团队很嗜血，而且……"}]
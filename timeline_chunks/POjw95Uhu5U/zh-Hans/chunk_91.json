[{"type": "subtitle", "time": 5462.149, "timestamp": "01:31:02", "text": "[音乐]"}, {"type": "subtitle", "time": 5464.55, "timestamp": "01:31:04", "text": "你知道，我从来不关心他们。"}, {"type": "subtitle", "time": 5466.07, "timestamp": "01:31:06", "text": "这就是为什么他们这么兴奋。这就是为什么"}, {"type": "subtitle", "time": 5467.75, "timestamp": "01:31:07", "text": "他们在我心里这么兴奋。"}, {"type": "subtitle", "time": 5469.43, "timestamp": "01:31:09", "text": "你知道我的意思吗？"}, {"type": "subtitle", "time": 5471.189, "timestamp": "01:31:11", "text": "我的天哪。"}, {"type": "subtitle", "time": 5473.669, "timestamp": "01:31:13", "text": "就像你知道，他爸爸，她爸爸，"}, {"type": "subtitle", "time": 5476.229, "timestamp": "01:31:16", "text": "不是我的爸爸。是"}, {"type": "subtitle", "time": 5476.87, "timestamp": "01:31:16", "text": "啊。是啊。是啊"}, {"type": "subtitle", "time": 5478.229, "timestamp": "01:31:18", "text": "。等等，等等，等等。首先，"}, {"type": "subtitle", "time": 5480.55, "timestamp": "01:31:20", "text": "忘了克里斯·奎因。是啊，我们要把地板放到"}, {"type": "subtitle", "time": 5483.99, "timestamp": "01:31:23", "text": "这一层。这"}, {"type": "subtitle", "time": 5486.629, "timestamp": "01:31:26", "text": "一层感觉"}, {"type": "subtitle", "time": 5488.31, "timestamp": "01:31:28", "text": "凉快多了。上面的地板有点"}, {"type": "subtitle", "time": 5490.709, "timestamp": "01:31:30", "text": "热，因为是体育馆，是"}, {"type": "subtitle", "time": 5493.43, "timestamp": "01:31:33", "text": "啊，你会发现冰凉的大理石。"}, {"type": "subtitle", "time": 5495.189, "timestamp": "01:31:35", "text": "真的够了，这个地方仍然有点"}, {"type": "subtitle", "time": 5498.55, "timestamp": "01:31:38", "text": "热。不知"}, {"type": "subtitle", "time": 5500.95, "timestamp": "01:31:40", "text": "什么原因有点热，但大理石"}, {"type": "subtitle", "time": 5502.47, "timestamp": "01:31:42", "text": "真的很冷。 金属地板"}, {"type": "subtitle", "time": 5504.629, "timestamp": "01:31:44", "text": "真冷。克里斯汀走过去的时候"}, {"type": "subtitle", "time": 5506.149, "timestamp": "01:31:46", "text": "，这边有很多雕像"}, {"type": "subtitle", "time": 5508.79, "timestamp": "01:31:48", "text": "。所有雕像都描绘的是同一"}, {"type": "subtitle", "time": 5510.39, "timestamp": "01:31:50", "text": "个人，一个矮人。每个雕像都"}, {"type": "subtitle", "time": 5512.149, "timestamp": "01:31:52", "text": "拿着不同的武器："}, {"type": "subtitle", "time": 5515.27, "timestamp": "01:31:55", "text": "剑、斧头、长矛，还有……等等，"}, {"type": "subtitle", "time": 5517.91, "timestamp": "01:31:57", "text": "最后一个是什么？等等。"}]
[{"type": "subtitle", "time": 4684.709, "timestamp": "01:18:04", "text": "好的。"}, {"type": "subtitle", "time": 4685.75, "timestamp": "01:18:05", "text": "我最喜欢的一句话是，"}, {"type": "subtitle", "time": 4689.11, "timestamp": "01:18:09", "text": "总有一天我要在这个该死的竞选活动中打败你。"}, {"type": "subtitle", "time": 4692.229, "timestamp": "01:18:12", "text": "不。看看你的感觉如何。"}, {"type": "subtitle", "time": 4694.39, "timestamp": "01:18:14", "text": "我最喜欢的卡组是那些"}, {"type": "subtitle", "time": 4697.03, "timestamp": "01:18:17", "text": "玩吸血鬼卡组的人，"}, {"type": "subtitle", "time": 4699.03, "timestamp": "01:18:19", "text": "有时候因为他们不记得"}, {"type": "subtitle", "time": 4701.35, "timestamp": "01:18:21", "text": "自己的生命值，结果不小心把"}, {"type": "subtitle", "time": 4703.51, "timestamp": "01:18:23", "text": "自己弄死了。"}, {"type": "subtitle", "time": 4706.47, "timestamp": "01:18:26", "text": "我玩过几局这样的游戏。"}, {"type": "subtitle", "time": 4708.87, "timestamp": "01:18:28", "text": "好的。 是的。 那"}, {"type": "subtitle", "time": 4710.95, "timestamp": "01:18:30", "text": "会怎么样呢？嗯，嗯，如果你"}, {"type": "subtitle", "time": 4714.149, "timestamp": "01:18:34", "text": "给我一小笔定金，"}, {"type": "subtitle", "time": 4716.39, "timestamp": "01:18:36", "text": "比如说 200，"}, {"type": "subtitle", "time": 4719.189, "timestamp": "01:18:39", "text": "我就愿意这么做。 是啊，"}, {"type": "subtitle", "time": 4722.07, "timestamp": "01:18:42", "text": "她就​​说，"}, {"type": "subtitle", "time": 4724.47, "timestamp": "01:18:44", "text": "现在拿到金奖也比等不"}, {"type": "subtitle", "time": 4726.229, "timestamp": "01:18:46", "text": "知道什么时候才能拿到金奖要好得多。 而且她也知道"}, {"type": "subtitle", "time": 4728.87, "timestamp": "01:18:48", "text": "附近有商贩，所以你懂的。"}, {"type": "subtitle", "time": 4731.27, "timestamp": "01:18:51", "text": "是的，公平的"}, {"type": "subtitle", "time": 4733.19, "timestamp": "01:18:53", "text": "地牢商人。"}, {"type": "subtitle", "time": 4735.91, "timestamp": "01:18:55", "text": "[音乐] 是的"}, {"type": "subtitle", "time": 4737.27, "timestamp": "01:18:57", "text": "。 这就是"}]
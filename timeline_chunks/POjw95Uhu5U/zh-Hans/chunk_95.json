[{"type": "subtitle", "time": 5702.07, "timestamp": "01:35:02", "text": "他尽可能地侦察所有地方"}, {"type": "subtitle", "time": 5702.95, "timestamp": "01:35:02", "text": "。"}, {"type": "subtitle", "time": 5703.59, "timestamp": "01:35:03", "text": "好的。"}, {"type": "subtitle", "time": 5705.11, "timestamp": "01:35:05", "text": "好吧，"}, {"type": "subtitle", "time": 5708.47, "timestamp": "01:35:08", "text": "好的。克里斯曼现在至少已经探索了"}, {"type": "subtitle", "time": 5713.75, "timestamp": "01:35:13", "text": "我们可能走的所有路线，"}, {"type": "subtitle", "time": 5716.39, "timestamp": "01:35:16", "text": "唯一值得注意的是，"}, {"type": "subtitle", "time": 5719.03, "timestamp": "01:35:19", "text": "这个地方的一端有一个"}, {"type": "subtitle", "time": 5722.95, "timestamp": "01:35:22", "text": "黄金喷泉，但那里似乎非常热，"}, {"type": "subtitle", "time": 5725.99, "timestamp": "01:35:25", "text": "而且还有一扇"}, {"type": "subtitle", "time": 5729.11, "timestamp": "01:35:29", "text": "通往某个地方的门，但我"}, {"type": "subtitle", "time": 5731.91, "timestamp": "01:35:31", "text": "不知道它通往哪里。"}, {"type": "subtitle", "time": 5735.51, "timestamp": "01:35:35", "text": "所以去看看吧。"}, {"type": "subtitle", "time": 5736.629, "timestamp": "01:35:36", "text": "是时候"}, {"type": "subtitle", "time": 5738.47, "timestamp": "01:35:38", "text": "探索了吗？我想"}, {"type": "subtitle", "time": 5740.229, "timestamp": "01:35:40", "text": "是时候了，"}, {"type": "subtitle", "time": 5743.27, "timestamp": "01:35:43", "text": "我想这是我们在那里唯一能做的事情"}, {"type": "subtitle", "time": 5754.07, "timestamp": "01:35:54", "text": "有人在"}, {"type": "subtitle", "time": 5756.149, "timestamp": "01:35:56", "text": "等待，"}]
[{"type": "subtitle", "time": 4741.189, "timestamp": "01:19:01", "text": "卡米拉将要提供的。"}, {"type": "subtitle", "time": 4743.66, "timestamp": "01:19:03", "text": "这里有人有现金吗？"}, {"type": "subtitle", "time": 4748.47, "timestamp": "01:19:08", "text": "[音乐]"}, {"type": "subtitle", "time": 4750.229, "timestamp": "01:19:10", "text": "不去注意"}, {"type": "subtitle", "time": 4760.87, "timestamp": "01:19:20", "text": "我喜欢的[音乐]吗？我喜欢你提供的"}, {"type": "subtitle", "time": 4762.149, "timestamp": "01:19:22", "text": "火球术而不是"}, {"type": "subtitle", "time": 4763.43, "timestamp": "01:19:23", "text": "迷你斗篷，明明你都无法与之协调"}, {"type": "subtitle", "time": 4766.31, "timestamp": "01:19:26", "text": "。"}, {"type": "subtitle", "time": 4769.27, "timestamp": "01:19:29", "text": "是的，但"}, {"type": "subtitle", "time": 4772.229, "timestamp": "01:19:32", "text": "我觉得她可能是因为这个原因，"}, {"type": "subtitle", "time": 4775.75, "timestamp": "01:19:35", "text": "比如德鲁伊或游侠。"}, {"type": "subtitle", "time": 4777.51, "timestamp": "01:19:37", "text": "说实话，我还是会亲自让你这么做，因为那样"}, {"type": "subtitle", "time": 4779.669, "timestamp": "01:19:39", "text": "我会显得自己"}, {"type": "subtitle", "time": 4781.27, "timestamp": "01:19:41", "text": "更酷。"}, {"type": "subtitle", "time": 4783.189, "timestamp": "01:19:43", "text": "但没错，卡米拉肯定会这么"}, {"type": "subtitle", "time": 4784.31, "timestamp": "01:19:44", "text": "说。 她打算以"}, {"type": "subtitle", "time": 4787.11, "timestamp": "01:19:47", "text": "200 的价格出售大自然的披风。不，不，"}, {"type": "subtitle", "time": 4789.51, "timestamp": "01:19:49", "text": "她已经接受了。 这就是她拿走它的原因，"}, {"type": "subtitle", "time": 4791.75, "timestamp": "01:19:51", "text": "因为她觉得她可以"}, {"type": "subtitle", "time": 4793.91, "timestamp": "01:19:53", "text": "拿去卖给对方。"}, {"type": "subtitle", "time": 4797.11, "timestamp": "01:19:57", "text": "嗯。 哦好的。 因为她是个"}, {"type": "subtitle", "time": 4798.95, "timestamp": "01:19:58", "text": "女商人。"}]
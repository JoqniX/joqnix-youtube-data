[{"type": "subtitle", "time": 5520.39, "timestamp": "01:32:00", "text": "最后一个到底是什么？"}, {"type": "subtitle", "time": 5525.91, "timestamp": "01:32:05", "text": "你帮我选一个。"}, {"type": "subtitle", "time": 5527.51, "timestamp": "01:32:07", "text": "是钓竿。我他妈也不"}, {"type": "subtitle", "time": 5527.83, "timestamp": "01:32:07", "text": "知道。"}, {"type": "subtitle", "time": 5529.51, "timestamp": "01:32:09", "text": "钓竿。对，钓竿。找到了。好的。"}, {"type": "subtitle", "time": 5532.229, "timestamp": "01:32:12", "text": "哦，你好。你好。找到了。"}, {"type": "subtitle", "time": 5535.59, "timestamp": "01:32:15", "text": "蜥蜴。我没事吧？"}, {"type": "subtitle", "time": 5537.99, "timestamp": "01:32:17", "text": "我的声音还好吗？"}, {"type": "subtitle", "time": 5541.51, "timestamp": "01:32:21", "text": "你的声音真好听。嗯？"}, {"type": "subtitle", "time": 5544.31, "timestamp": "01:32:24", "text": "你好。"}, {"type": "subtitle", "time": 5545.83, "timestamp": "01:32:25", "text": "还有，我得把电梯"}, {"type": "subtitle", "time": 5547.27, "timestamp": "01:32:27", "text": "音乐关掉。我是说，他们说是地牢"}, {"type": "subtitle", "time": 5550.149, "timestamp": "01:32:30", "text": "音乐。酷。我想我这边可能有点"}, {"type": "subtitle", "time": 5552.39, "timestamp": "01:32:32", "text": "技术问题。"}, {"type": "subtitle", "time": 5554.95, "timestamp": "01:32:34", "text": "你就像个机器人。"}, {"type": "subtitle", "time": 5556.55, "timestamp": "01:32:36", "text": "你先来，阿丽亚娜。"}, {"type": "subtitle", "time": 5559.189, "timestamp": "01:32:39", "text": "那是我的吗？"}, {"type": "subtitle", "time": 5559.669, "timestamp": "01:32:39", "text": "嗯？"}, {"type": "subtitle", "time": 5561.99, "timestamp": "01:32:41", "text": "哦，不。"}, {"type": "subtitle", "time": 5564.629, "timestamp": "01:32:44", "text": "克里斯很好。克里斯汀。"}, {"type": "subtitle", "time": 5565.43, "timestamp": "01:32:45", "text": "你好。"}, {"type": "subtitle", "time": 5565.669, "timestamp": "01:32:45", "text": "嗯。"}, {"type": "subtitle", "time": 5567.03, "timestamp": "01:32:47", "text": "哦，是的。不，那是我。"}, {"type": "subtitle", "time": 5569.03, "timestamp": "01:32:49", "text": "这是什么？还是"}, {"type": "subtitle", "time": 5569.27, "timestamp": "01:32:49", "text": "同一个吗？"}, {"type": "subtitle", "time": 5571.51, "timestamp": "01:32:51", "text": "好的。是的。好的。嗯，在尽头有个……等等"}, {"type": "subtitle", "time": 5573.11, "timestamp": "01:32:53", "text": "。我这就给你看看"}, {"type": "subtitle", "time": 5575.189, "timestamp": "01:32:55", "text": "。嗯，我切换到GM视角，这样"}, {"type": "subtitle", "time": 5576.39, "timestamp": "01:32:56", "text": "其他人也能看到。好的。那又是"}, {"type": "subtitle", "time": 5579.27, "timestamp": "01:32:59", "text": "同一个人的巨大雕像"}]
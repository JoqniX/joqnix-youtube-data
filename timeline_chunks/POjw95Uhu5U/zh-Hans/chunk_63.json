[{"type": "subtitle", "time": 3781.349, "timestamp": "01:03:01", "text": "上次相比，现在安静多了。上次"}, {"type": "subtitle", "time": 3782.47, "timestamp": "01:03:02", "text": "大家都在欢呼。现在就像"}, {"type": "subtitle", "time": 3784.789, "timestamp": "01:03:04", "text": "大家都在打扫卫生。"}, {"type": "subtitle", "time": 3786.63, "timestamp": "01:03:06", "text": "那个家伙就在拖"}, {"type": "subtitle", "time": 3789.91, "timestamp": "01:03:09", "text": "地，捡垃圾。"}, {"type": "subtitle", "time": 3791.589, "timestamp": "01:03:11", "text": "你确定他们没有把"}, {"type": "subtitle", "time": 3795.43, "timestamp": "01:03:15", "text": "所有股票都卖光吗？"}, {"type": "subtitle", "time": 3797.67, "timestamp": "01:03:17", "text": "别再想股票了。"}, {"type": "subtitle", "time": 3798.87, "timestamp": "01:03:18", "text": "股票。"}, {"type": "subtitle", "time": 3800.63, "timestamp": "01:03:20", "text": "你能不能聊点"}, {"type": "subtitle", "time": 3801.829, "timestamp": "01:03:21", "text": "别的，别聊"}, {"type": "subtitle", "time": 3802.95, "timestamp": "01:03:22", "text": "股市？"}, {"type": "subtitle", "time": 3807.829, "timestamp": "01:03:27", "text": "现在不是聊这个的"}, {"type": "subtitle", "time": 3809.91, "timestamp": "01:03:29", "text": "时候。是"}, {"type": "subtitle", "time": 3813.349, "timestamp": "01:03:33", "text": "敌人的股市吗？不是"}, {"type": "subtitle", "time": 3815.589, "timestamp": "01:03:35", "text": "股市。那是另一回事。好吧，我们来说说"}, {"type": "subtitle", "time": 3819.99, "timestamp": "01:03:39", "text": "股市。"}, {"type": "subtitle", "time": 3821.829, "timestamp": "01:03:41", "text": "好的，我过去一下。我"}, {"type": "subtitle", "time": 3823.75, "timestamp": "01:03:43", "text": "快速地做一下。我来揭晓一下"}, {"type": "subtitle", "time": 3825.19, "timestamp": "01:03:45", "text": "。"}, {"type": "subtitle", "time": 3827.589, "timestamp": "01:03:47", "text": "好的。你看，他们在"}, {"type": "subtitle", "time": 3829.27, "timestamp": "01:03:49", "text": "那边"}, {"type": "subtitle", "time": 3829.589, "timestamp": "01:03:49", "text": "悠闲地待着。"}, {"type": "subtitle", "time": 3831.829, "timestamp": "01:03:51", "text": "卡米拉在哪儿？"}, {"type": "subtitle", "time": 3836.63, "timestamp": "01:03:56", "text": "等等。卡米拉在"}, {"type": "subtitle", "time": 3839.99, "timestamp": "01:03:59", "text": "哪儿？ 卡米拉？她"}]
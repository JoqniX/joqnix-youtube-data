[{"type": "subtitle", "time": 9000.15, "timestamp": "02:30:00", "text": "感觉，如果你还"}, {"type": "subtitle", "time": 9001.91, "timestamp": "02:30:01", "text": "记得它在哪里，我会给"}, {"type": "subtitle", "time": 9003.03, "timestamp": "02:30:03", "text": "你加分，但我不会告诉"}, {"type": "subtitle", "time": 9005.27, "timestamp": "02:30:05", "text": "你它在哪里。"}, {"type": "subtitle", "time": 9006.79, "timestamp": "02:30:06", "text": "还记得它在哪里吗？   就在"}, {"type": "subtitle", "time": 9008.23, "timestamp": "02:30:08", "text": "克里斯彭所在的地方。 就在那儿"}, {"type": "subtitle", "time": 9010.15, "timestamp": "02:30:10", "text": "。"}, {"type": "subtitle", "time": 9012.07, "timestamp": "02:30:12", "text": "它有点像……就像"}, {"type": "subtitle", "time": 9013.91, "timestamp": "02:30:13", "text": "正方形的顶部。 它不在"}, {"type": "subtitle", "time": 9015.349, "timestamp": "02:30:15", "text": "中心位置。   是的"}, {"type": "subtitle", "time": 9018.15, "timestamp": "02:30:18", "text": "，确实如此。"}, {"type": "subtitle", "time": 9020.07, "timestamp": "02:30:20", "text": "只要它还在原来所在的那个方格里"}, {"type": "subtitle", "time": 9021.59, "timestamp": "02:30:21", "text": "，那就应该没"}, {"type": "subtitle", "time": 9024.71, "timestamp": "02:30:24", "text": "问题。 嗯，让我想想"}, {"type": "subtitle", "time": 9026.309, "timestamp": "02:30:26", "text": "。"}, {"type": "subtitle", "time": 9028.55, "timestamp": "02:30:28", "text": "倒带播放。"}, {"type": "subtitle", "time": 9030.389, "timestamp": "02:30:30", "text": "那太疯狂了。 那可就"}, {"type": "subtitle", "time": 9031.83, "timestamp": "02:30:31", "text": "太搞笑了。 其实，是"}, {"type": "subtitle", "time": 9032.95, "timestamp": "02:30:32", "text": "我的。"}, {"type": "subtitle", "time": 9034.309, "timestamp": "02:30:34", "text": "你知道吗？"}, {"type": "subtitle", "time": 9037.99, "timestamp": "02:30:37", "text": "我可以这样做吗？   这到底有什么"}, {"type": "subtitle", "time": 9046.389, "timestamp": "02:30:46", "text": "我的朋友们，这是"}, {"type": "subtitle", "time": 9050.63, "timestamp": "02:30:50", "text": "心灵感应。 我看着直播。"}, {"type": "subtitle", "time": 9052.389, "timestamp": "02:30:52", "text": "查看直播回放。"}, {"type": "subtitle", "time": 9055.11, "timestamp": "02:30:55", "text": "他现在正在脑海里回放这场直播"}]
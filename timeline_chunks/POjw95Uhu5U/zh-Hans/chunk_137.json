[{"type": "subtitle", "time": 8224.25, "timestamp": "02:17:04", "text": "术士，居然只有两个婊子。"}, {"type": "subtitle", "time": 8225.509, "timestamp": "02:17:05", "text": "[音乐]"}, {"type": "subtitle", "time": 8227.91, "timestamp": "02:17:07", "text": "是啊，"}, {"type": "subtitle", "time": 8230.709, "timestamp": "02:17:10", "text": "我真的非常讨厌那样。"}, {"type": "subtitle", "time": 8235.83, "timestamp": "02:17:15", "text": "我真他妈讨厌这一点。 所以，我"}, {"type": "subtitle", "time": 8237.429, "timestamp": "02:17:17", "text": "要去用我的"}, {"type": "subtitle", "time": 8240.79, "timestamp": "02:17:20", "text": "治疗灯了。 气死了。"}, {"type": "subtitle", "time": 8257.509, "timestamp": "02:17:37", "text": "至少，情况没有那么糟糕。"}, {"type": "subtitle", "time": 8260.07, "timestamp": "02:17:40", "text": "嘿，你在治愈谁？ 你自己？"}, {"type": "subtitle", "time": 8261.349, "timestamp": "02:17:41", "text": "嗯，是爱莉安娜吗？"}, {"type": "subtitle", "time": 8266.23, "timestamp": "02:17:46", "text": "爱莉安娜？ 好了，开始了。"}, {"type": "subtitle", "time": 8270.23, "timestamp": "02:17:50", "text": "抱歉，我无法同时治好你们两个。"}, {"type": "subtitle", "time": 8271.99, "timestamp": "02:17:51", "text": "好的。"}, {"type": "subtitle", "time": 8276.309, "timestamp": "02:17:56", "text": "我无法治愈你们两个。"}, {"type": "subtitle", "time": 8278.549, "timestamp": "02:17:58", "text": "嗯，我还能做什么呢？ 哦，是的。 这是"}]
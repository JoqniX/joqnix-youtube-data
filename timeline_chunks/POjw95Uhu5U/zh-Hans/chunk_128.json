[{"type": "subtitle", "time": 7682.709, "timestamp": "02:08:02", "text": "你到底是从哪儿算出52点"}, {"type": "subtitle", "time": 7688.47, "timestamp": "02:08:08", "text": "是的，总伤害值取决于你的"}, {"type": "subtitle", "time": 7690.55, "timestamp": "02:08:10", "text": "掷骰结果。 所以，是 8"}, {"type": "subtitle", "time": 7693.99, "timestamp": "02:08:13", "text": "加 16 加 6，"}, {"type": "subtitle", "time": 7696.47, "timestamp": "02:08:16", "text": "然后再加 7，最后再加"}, {"type": "subtitle", "time": 7698.069, "timestamp": "02:08:18", "text": "5。"}, {"type": "subtitle", "time": 7699.51, "timestamp": "02:08:19", "text": "等等，我数了一下，30。"}, {"type": "subtitle", "time": 7701.99, "timestamp": "02:08:21", "text": "不，那是“等等”。 等等，等等，稍等一下。"}, {"type": "subtitle", "time": 7704.31, "timestamp": "02:08:24", "text": "我数了30，因为第二次"}, {"type": "subtitle", "time": 7705.43, "timestamp": "02:08:25", "text": "偷袭实际上并不生效，因为"}, {"type": "subtitle", "time": 7707.51, "timestamp": "02:08:27", "text": "它只造成第一次伤害。   是的"}, {"type": "subtitle", "time": 7709.51, "timestamp": "02:08:29", "text": "，我只应用了"}, {"type": "subtitle", "time": 7711.51, "timestamp": "02:08:31", "text": "偷袭的16点伤害加上6点伤害。"}, {"type": "subtitle", "time": 7713.51, "timestamp": "02:08:33", "text": "才36岁。你他妈从哪儿弄来的"}, {"type": "subtitle", "time": 7717.109, "timestamp": "02:08:37", "text": "？"}, {"type": "subtitle", "time": 7719.51, "timestamp": "02:08:39", "text": "Matt 不是在铺垫。"}, {"type": "subtitle", "time": 7722.95, "timestamp": "02:08:42", "text": "等等，不对，不是36，是32。"}, {"type": "subtitle", "time": 7723.669, "timestamp": "02:08:43", "text": "哦，36。"}, {"type": "subtitle", "time": 7725.43, "timestamp": "02:08:45", "text": "不对，等等。 为什么？ 好的。 哦，是的。 哦，是的。"}, {"type": "subtitle", "time": 7727.43, "timestamp": "02:08:47", "text": "32. 但是我也移除了其中一个，因为"}, {"type": "subtitle", "time": 7729.589, "timestamp": "02:08:49", "text": "如果你"}, {"type": "subtitle", "time": 7731.189, "timestamp": "02:08:51", "text": "没有双持武器，用"}, {"type": "subtitle", "time": 7733.91, "timestamp": "02:08:53", "text": "副手武器攻击不会影响你的修正值。"}, {"type": "subtitle", "time": 7736.069, "timestamp": "02:08:56", "text": "所以，实际上总共是28个。"}, {"type": "subtitle", "time": 7738.069, "timestamp": "02:08:58", "text": "经典的。 患有阅读障碍的那个人。"}, {"type": "subtitle", "time": 7739.99, "timestamp": "02:08:59", "text": "你是怎么……你怎么能"}]
[{"type": "subtitle", "time": 780.949, "timestamp": "00:13:00", "text": "确认一下。"}, {"type": "subtitle", "time": 782.47, "timestamp": "00:13:02", "text": "我也得想个标题"}, {"type": "subtitle", "time": 784.31, "timestamp": "00:13:04", "text": "。"}, {"type": "subtitle", "time": 786.389, "timestamp": "00:13:06", "text": "什么事，"}, {"type": "subtitle", "time": 787.91, "timestamp": "00:13:07", "text": "兄弟？"}, {"type": "subtitle", "time": 790.55, "timestamp": "00:13:10", "text": "如果真的存在一个"}, {"type": "subtitle", "time": 794.23, "timestamp": "00:13:14", "text": "衡量优秀和实力的标尺，比如对"}, {"type": "subtitle", "time": 796.31, "timestamp": "00:13:16", "text": "两支队伍都适用，你知道是哪一支吗？"}, {"type": "subtitle", "time": 799.269, "timestamp": "00:13:19", "text": "好的一面和坏的一面。 那就好像"}, {"type": "subtitle", "time": 802.79, "timestamp": "00:13:22", "text": "天平只有邪恶的一面一样。   是的"}, {"type": "subtitle", "time": 805.59, "timestamp": "00:13:25", "text": "，邪恶是一个光谱。"}, {"type": "subtitle", "time": 808.55, "timestamp": "00:13:28", "text": "基本上，我本来"}, {"type": "subtitle", "time": 811.53, "timestamp": "00:13:31", "text": "想说它就像自闭症一样。"}, {"type": "subtitle", "time": 817.269, "timestamp": "00:13:37", "text": "自闭症"}, {"type": "subtitle", "time": 819.67, "timestamp": "00:13:39", "text": "是由两个部分组成的。 我以为"}, {"type": "subtitle", "time": 822.71, "timestamp": "00:13:42", "text": "你会做出来，但"}, {"type": "subtitle", "time": 826.79, "timestamp": "00:13:46", "text": "确实如此。 人民反种族主义。   是的"}, {"type": "subtitle", "time": 829.11, "timestamp": "00:13:49", "text": "。 从目前来看，这两组人群"}, {"type": "subtitle", "time": 830.79, "timestamp": "00:13:50", "text": "实际上只是自闭症的两种不同类型"}, {"type": "subtitle", "time": 833.509, "timestamp": "00:13:53", "text": "。   是的"}, {"type": "subtitle", "time": 836.87, "timestamp": "00:13:56", "text": "。 是的。"}, {"type": "subtitle", "time": 837.99, "timestamp": "00:13:57", "text": "我的天啊。"}, {"type": "subtitle", "time": 839.67, "timestamp": "00:13:59", "text": "我们都是自闭症患者，所以我们都可以分享这些"}]
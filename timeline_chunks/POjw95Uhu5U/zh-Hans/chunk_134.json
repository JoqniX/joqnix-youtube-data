[{"type": "subtitle", "time": 8041.03, "timestamp": "02:14:01", "text": "真想多见见他们。"}, {"type": "subtitle", "time": 8043.27, "timestamp": "02:14:03", "text": "我害怕你肚子里长出来的东西"}, {"type": "subtitle", "time": 8045.91, "timestamp": "02:14:05", "text": "。 但我们拭目以待。"}, {"type": "subtitle", "time": 8048.87, "timestamp": "02:14:08", "text": "好的。 好的。 嗯，在"}, {"type": "subtitle", "time": 8050.95, "timestamp": "02:14:10", "text": "这场战斗进行到一半的时候，就在"}, {"type": "subtitle", "time": 8052.709, "timestamp": "02:14:12", "text": "模仿者完成它的"}, {"type": "subtitle", "time": 8055.669, "timestamp": "02:14:15", "text": "动作之后，呃，你会注意到就在"}, {"type": "subtitle", "time": 8058.709, "timestamp": "02:14:18", "text": "Ariana 身后，呃，消失了。 稍等，"}, {"type": "subtitle", "time": 8061.75, "timestamp": "02:14:21", "text": "让我看看。 呃，Bloop 是另一个 bloop。   是的"}, {"type": "subtitle", "time": 8064.149, "timestamp": "02:14:24", "text": "。 是的。 另一门课程。 是的。 一个"}, {"type": "subtitle", "time": 8065.669, "timestamp": "02:14:25", "text": "衣柜突然出现在你面前，然后立刻试图"}, {"type": "subtitle", "time": 8071.03, "timestamp": "02:14:31", "text": "再次攻击你。 好的。"}, {"type": "subtitle", "time": 8074.229, "timestamp": "02:14:34", "text": "哦，我的衣橱真麻烦。"}, {"type": "subtitle", "time": 8076.79, "timestamp": "02:14:36", "text": "好的。 它确实会这样做。 好吧，接下来会"}, {"type": "subtitle", "time": 8081.43, "timestamp": "02:14:41", "text": "有点奇怪，但它确实会这样做。  49号会中奖吗？"}, {"type": "subtitle", "time": 8082.87, "timestamp": "02:14:42", "text": "嗯，是的。   这样对吗"}, {"type": "subtitle", "time": 8086.31, "timestamp": "02:14:46", "text": "？"}, {"type": "subtitle", "time": 8088.629, "timestamp": "02:14:48", "text": "好吧，它击中了你，但它没有受到"}, {"type": "subtitle", "time": 8091.99, "timestamp": "02:14:51", "text": "伤害。 相反，你却发现自己的口袋"}, {"type": "subtitle", "time": 8095.109, "timestamp": "02:14:55", "text": "小了一点。"}, {"type": "subtitle", "time": 8097.669, "timestamp": "02:14:57", "text": "哦，不。 你拿走了我的钱。"}]
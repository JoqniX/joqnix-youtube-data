[{"type": "subtitle", "time": 2821.829, "timestamp": "00:47:01", "text": "我的天啊。"}, {"type": "subtitle", "time": 2825.829, "timestamp": "00:47:05", "text": "这很好。 这很好。"}, {"type": "subtitle", "time": 2828.47, "timestamp": "00:47:08", "text": "上帝。 啊。 是的。"}, {"type": "subtitle", "time": 2830.069, "timestamp": "00:47:10", "text": "好的。 啊。 是的。   是的"}, {"type": "subtitle", "time": 2832.39, "timestamp": "00:47:12", "text": "。 他总是做好充分的准备，"}, {"type": "subtitle", "time": 2834.47, "timestamp": "00:47:14", "text": "因为他就是喜欢做好事"}, {"type": "subtitle", "time": 2839.35, "timestamp": "00:47:19", "text": "为什么？"}, {"type": "subtitle", "time": 2844.71, "timestamp": "00:47:24", "text": "[音乐]"}, {"type": "subtitle", "time": 2847.19, "timestamp": "00:47:27", "text": "每当有人"}, {"type": "subtitle", "time": 2849.27, "timestamp": "00:47:29", "text": "沉迷于美味浆果时，我都会送他们一条项链。"}, {"type": "subtitle", "time": 2851.75, "timestamp": "00:47:31", "text": "我也是，虽然次数"}, {"type": "subtitle", "time": 2853.27, "timestamp": "00:47:33", "text": "不多，但"}, {"type": "subtitle", "time": 2859.91, "timestamp": "00:47:39", "text": "走吧。 对好头发上瘾。"}, {"type": "subtitle", "time": 2862.63, "timestamp": "00:47:42", "text": "好瘾。"}, {"type": "subtitle", "time": 2863.91, "timestamp": "00:47:43", "text": "我的天啊。 我应该把它正式写入"}, {"type": "subtitle", "time": 2866.47, "timestamp": "00:47:46", "text": "正典。 这就是为什么我的精灵"}, {"type": "subtitle", "time": 2869.349, "timestamp": "00:47:49", "text": "角色在"}, {"type": "subtitle", "time": 2870.87, "timestamp": "00:47:50", "text": "我的某个战役中总是很强的原因。"}, {"type": "subtitle", "time": 2872.63, "timestamp": "00:47:52", "text": "高等精灵。"}, {"type": "subtitle", "time": 2874.39, "timestamp": "00:47:54", "text": "赫尔。   是的"}, {"type": "subtitle", "time": 2876.069, "timestamp": "00:47:56", "text": "。"}]
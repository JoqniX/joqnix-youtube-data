[{"type": "subtitle", "time": 2040.389, "timestamp": "00:34:00", "text": "的医生让我在"}, {"type": "subtitle", "time": 2041.669, "timestamp": "00:34:01", "text": "地板上打滚，然后他们说：“哦，如果你"}, {"type": "subtitle", "time": 2043.75, "timestamp": "00:34:03", "text": "这样打滚，那就说明你患有 ADHD。”"}, {"type": "subtitle", "time": 2046.07, "timestamp": "00:34:06", "text": "我当时就想，“我不知道。”"}, {"type": "subtitle", "time": 2049.19, "timestamp": "00:34:09", "text": "什么？ 患有注意力缺陷多动障碍的人有哪些"}, {"type": "subtitle", "time": 2051.03, "timestamp": "00:34:11", "text": "不同的行为方式？"}, {"type": "subtitle", "time": 2052.23, "timestamp": "00:34:12", "text": "孩子们。   是的"}, {"type": "subtitle", "time": 2054.31, "timestamp": "00:34:14", "text": "。 我当时就像个小孩子，但"}, {"type": "subtitle", "time": 2055.829, "timestamp": "00:34:15", "text": "他们却说：“哦，是啊。不，你是"}, {"type": "subtitle", "time": 2057.829, "timestamp": "00:34:17", "text": "头朝下滚的。那说明你有注意力缺陷多动障碍。” 我"}, {"type": "subtitle", "time": 2059.27, "timestamp": "00:34:19", "text": "不知道这跟这"}, {"type": "subtitle", "time": 2060.069, "timestamp": "00:34:20", "text": "件事有什么关系。   是的"}, {"type": "subtitle", "time": 2062.47, "timestamp": "00:34:22", "text": "。 我以为所有人都是头朝下滚的"}, {"type": "subtitle", "time": 2064.71, "timestamp": "00:34:24", "text": "。"}, {"type": "subtitle", "time": 2067.03, "timestamp": "00:34:27", "text": "不，不，它们就像你"}, {"type": "subtitle", "time": 2070.069, "timestamp": "00:34:30", "text": "侧身从山坡上滚下来一样。"}, {"type": "subtitle", "time": 2071.99, "timestamp": "00:34:31", "text": "哦。"}, {"type": "subtitle", "time": 2078.389, "timestamp": "00:34:38", "text": "我仍然不喜欢笔直的山坡。   是的"}, {"type": "subtitle", "time": 2081.909, "timestamp": "00:34:41", "text": "，说实话，我当时以为自己会一路顺风顺水"}, {"type": "subtitle", "time": 2086.23, "timestamp": "00:34:46", "text": "。 我不太确定"}, {"type": "subtitle", "time": 2089.27, "timestamp": "00:34:49", "text": "他们看到了什么。"}, {"type": "subtitle", "time": 2091.109, "timestamp": "00:34:51", "text": "他们说的没错。 真的"}]
[{"type": "subtitle", "time": 5160.87, "timestamp": "01:26:00", "text": "那个20点太好了。"}, {"type": "subtitle", "time": 5166.55, "timestamp": "01:26:06", "text": "被抢劫了，她甚至什么都没说，"}, {"type": "subtitle", "time": 5175.75, "timestamp": "01:26:15", "text": "失去了自然披风，150金币和很多"}, {"type": "subtitle", "time": 5178.24, "timestamp": "01:26:18", "text": "尊严"}, {"type": "subtitle", "time": 5179.51, "timestamp": "01:26:19", "text": "[音乐]"}, {"type": "subtitle", "time": 5181.59, "timestamp": "01:26:21", "text": "因为她的队友们也在"}, {"type": "subtitle", "time": 5183.91, "timestamp": "01:26:23", "text": "看着这一切。"}, {"type": "subtitle", "time": 5186.95, "timestamp": "01:26:26", "text": "哦，是啊。你看，艾丽西亚就像在说，“哦，"}, {"type": "subtitle", "time": 5188.709, "timestamp": "01:26:28", "text": "你可以看。”"}, {"type": "subtitle", "time": 5192.79, "timestamp": "01:26:32", "text": "我的天哪。你真是个野兽。"}, {"type": "subtitle", "time": 5195.99, "timestamp": "01:26:35", "text": "握手交易。"}, {"type": "subtitle", "time": 5198.39, "timestamp": "01:26:38", "text": "我猜是因为你掷出了20点。卡米拉会和"}, {"type": "subtitle", "time": 5201.189, "timestamp": "01:26:41", "text": "蒂克握手。"}, {"type": "subtitle", "time": 5203.75, "timestamp": "01:26:43", "text": "我喜欢想象她感到非常"}, {"type": "subtitle", "time": 5206.31, "timestamp": "01:26:46", "text": "困惑，以至于她 就像没动脑子一样，就像"}, {"type": "subtitle", "time": 5208.55, "timestamp": "01:26:48", "text": "握着你的手，你知道，"}, {"type": "subtitle", "time": 5210.07, "timestamp": "01:26:50", "text": "然后就像刚才"}, {"type": "subtitle", "time": 5213.189, "timestamp": "01:26:53", "text": "发生了什么？就像她"}, {"type": "subtitle", "time": 5214.709, "timestamp": "01:26:54", "text": "之后会意识到这一点，然后说："}, {"type": "subtitle", "time": 5217.11, "timestamp": "01:26:57", "text": "“哦，糟糕，我犯了个大错误。” 我"}]
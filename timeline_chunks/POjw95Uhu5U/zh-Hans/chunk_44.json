[{"type": "subtitle", "time": 2641.43, "timestamp": "00:44:01", "text": "Ariana也准备好了侦测魔法。   是的"}, {"type": "subtitle", "time": 2643.27, "timestamp": "00:44:03", "text": "。"}, {"type": "subtitle", "time": 2644.47, "timestamp": "00:44:04", "text": "那么，好的方面呢？"}, {"type": "subtitle", "time": 2647.03, "timestamp": "00:44:07", "text": "纯天然的总是好的。 好熊其实"}, {"type": "subtitle", "time": 2652.47, "timestamp": "00:44:12", "text": "挺好的，这很"}, {"type": "subtitle", "time": 2653.589, "timestamp": "00:44:13", "text": "有趣。"}, {"type": "subtitle", "time": 2655.19, "timestamp": "00:44:15", "text": "差不多就是这样了。"}, {"type": "subtitle", "time": 2657.51, "timestamp": "00:44:17", "text": "我的一个"}, {"type": "subtitle", "time": 2658.95, "timestamp": "00:44:18", "text": "玩家在我的某个作品中创建了一个"}, {"type": "subtitle", "time": 2660.79, "timestamp": "00:44:20", "text": "对 Goodberry 上瘾的角色。"}, {"type": "subtitle", "time": 2662.71, "timestamp": "00:44:22", "text": "所以，他总是利用一些"}, {"type": "subtitle", "time": 2664.79, "timestamp": "00:44:24", "text": "空位来种植优质浆果。"}, {"type": "subtitle", "time": 2667.75, "timestamp": "00:44:27", "text": "说实话，我简直不敢相信，这好像是"}, {"type": "subtitle", "time": 2669.349, "timestamp": "00:44:29", "text": "我第二次听说这样的角色了，"}, {"type": "subtitle", "time": 2671.349, "timestamp": "00:44:31", "text": "因为我在"}, {"type": "subtitle", "time": 2673.27, "timestamp": "00:44:33", "text": "我主持的一个游戏中遇到过一个德鲁伊，他"}, {"type": "subtitle", "time": 2675.51, "timestamp": "00:44:35", "text": "总是嗑药嗑到神志不清，他的“好浆果”"}, {"type": "subtitle", "time": 2677.67, "timestamp": "00:44:37", "text": "基本上就是他的屎。"}, {"type": "subtitle", "time": 2681.19, "timestamp": "00:44:41", "text": "我的天啊。 说实话，“好”这个词确实"}, {"type": "subtitle", "time": 2683.19, "timestamp": "00:44:43", "text": "有一些非常好的用途。 比如，"}, {"type": "subtitle", "time": 2685.349, "timestamp": "00:44:45", "text": "如果你使用好浆果，比如你"}, {"type": "subtitle", "time": 2687.349, "timestamp": "00:44:47", "text": "准备好了好浆果，然后在"}, {"type": "subtitle", "time": 2689.589, "timestamp": "00:44:49", "text": "长休之前施放好浆果。 所以你"}, {"type": "subtitle", "time": 2691.51, "timestamp": "00:44:51", "text": "长休八小时，也就是只有 8 个小时。"}, {"type": "subtitle", "time": 2693.75, "timestamp": "00:44:53", "text": "在冒险途中，你可以挑选一些好浆果，"}, {"type": "subtitle", "time": 2697.589, "timestamp": "00:44:57", "text": "然后把好浆果准备好，如果有人倒下了，"}, {"type": "subtitle", "time": 2699.51, "timestamp": "00:44:59", "text": "你就可以喂他们吃一些好浆果。"}]
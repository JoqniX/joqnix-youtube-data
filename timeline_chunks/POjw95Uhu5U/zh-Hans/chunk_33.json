[{"type": "subtitle", "time": 1980.63, "timestamp": "00:33:00", "text": "把话说清楚"}, {"type": "subtitle", "time": 1982.63, "timestamp": "00:33:02", "text": "，但要像个严厉的"}, {"type": "subtitle", "time": 1988.789, "timestamp": "00:33:08", "text": "哦亲爱的。"}, {"type": "subtitle", "time": 1998.31, "timestamp": "00:33:18", "text": "好的。"}, {"type": "subtitle", "time": 2000.87, "timestamp": "00:33:20", "text": "我们所有人都很容易分心。   是的"}, {"type": "subtitle", "time": 2002.47, "timestamp": "00:33:22", "text": "。 距离上次出现多动症症状已经过去30分钟了"}, {"type": "subtitle", "time": 2003.59, "timestamp": "00:33:23", "text": "。   是的"}, {"type": "subtitle", "time": 2006.47, "timestamp": "00:33:26", "text": "。 是的。 我们只是在闲聊。"}, {"type": "subtitle", "time": 2008.63, "timestamp": "00:33:28", "text": "不，如果我患有注意力缺陷多动障碍，那倒也罢，但如果我真的有，我也"}, {"type": "subtitle", "time": 2010.07, "timestamp": "00:33:30", "text": "不会感到惊讶。   是的"}, {"type": "subtitle", "time": 2012.63, "timestamp": "00:33:32", "text": "。 所以，永远不要接受诊断。"}, {"type": "subtitle", "time": 2015.19, "timestamp": "00:33:35", "text": "我的情况太搞笑了，因为我去看"}, {"type": "subtitle", "time": 2018.95, "timestamp": "00:33:38", "text": "医生，想看看是不是"}, {"type": "subtitle", "time": 2020.389, "timestamp": "00:33:40", "text": "自闭症，结果医生说："}, {"type": "subtitle", "time": 2022.31, "timestamp": "00:33:42", "text": "“哦，不，你不是自闭症，你只是"}, {"type": "subtitle", "time": 2023.99, "timestamp": "00:33:43", "text": "患有注意力缺陷多动障碍。” 过了一段时间，"}, {"type": "subtitle", "time": 2025.909, "timestamp": "00:33:45", "text": "他们又会说：“哦，不，没事了。"}, {"type": "subtitle", "time": 2027.35, "timestamp": "00:33:47", "text": "其实，你是自闭症患者。” 我心想："}, {"type": "subtitle", "time": 2028.71, "timestamp": "00:33:48", "text": "“哦，没事了。其实你"}, {"type": "subtitle", "time": 2030.23, "timestamp": "00:33:50", "text": "两者都有。” 这就是他们遇到"}, {"type": "subtitle", "time": 2033.269, "timestamp": "00:33:53", "text": "困难的原因。 太好了。 谢谢。 我"}, {"type": "subtitle", "time": 2034.71, "timestamp": "00:33:54", "text": "想我以前跟一些人讲过这个故事"}, {"type": "subtitle", "time": 2036.07, "timestamp": "00:33:56", "text": "，"}, {"type": "subtitle", "time": 2038.23, "timestamp": "00:33:58", "text": "他们发现我患有 ADHD 的方式是，我"}]
[{"type": "subtitle", "time": 4020.47, "timestamp": "01:07:00", "text": "我想，快点结束，别管我们的事了。"}, {"type": "subtitle", "time": 4022.95, "timestamp": "01:07:02", "text": "那么，另一层在哪里？"}, {"type": "subtitle", "time": 4030.95, "timestamp": "01:07:10", "text": "你们知道下"}, {"type": "subtitle", "time": 4032.069, "timestamp": "01:07:12", "text": "一层的情况吗？"}, {"type": "subtitle", "time": 4035.829, "timestamp": "01:07:15", "text": "一点头绪都没有。我们决定"}, {"type": "subtitle", "time": 4038.309, "timestamp": "01:07:18", "text": "趁着有机会在这里放松一下"}, {"type": "subtitle", "time": 4045.75, "timestamp": "01:07:25", "text": "所以，你们这些混蛋真的 试着去"}, {"type": "subtitle", "time": 4047.589, "timestamp": "01:07:27", "text": "侦察一下。好吧，"}, {"type": "subtitle", "time": 4049.029, "timestamp": "01:07:29", "text": "他只是小声说的。"}, {"type": "subtitle", "time": 4051.51, "timestamp": "01:07:31", "text": "我们没有。我们当时伤痕累累，"}, {"type": "subtitle", "time": 4053.829, "timestamp": "01:07:33", "text": "狼狈不堪。你不用像我们一样在那种竞技场里战斗"}, {"type": "subtitle", "time": 4057.19, "timestamp": "01:07:37", "text": "。"}, {"type": "subtitle", "time": 4059.589, "timestamp": "01:07:39", "text": "小猪很抱歉发生了那样的事。他"}, {"type": "subtitle", "time": 4062.069, "timestamp": "01:07:42", "text": "爱你。"}, {"type": "subtitle", "time": 4063.99, "timestamp": "01:07:43", "text": "非常感谢你的"}, {"type": "subtitle", "time": 4065.51, "timestamp": "01:07:45", "text": "辛勤付出。"}, {"type": "subtitle", "time": 4067.829, "timestamp": "01:07:47", "text": "恭喜你赢得了"}, {"type": "subtitle", "time": 4074.15, "timestamp": "01:07:54", "text": "竞技场。嗯，我确定你是"}]
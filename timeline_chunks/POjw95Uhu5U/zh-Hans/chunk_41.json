[{"type": "subtitle", "time": 2465.75, "timestamp": "00:41:05", "text": "日光。 我喜欢提前"}, {"type": "subtitle", "time": 2468.23, "timestamp": "00:41:08", "text": "准备好日光，因为有时候我就会感觉像是置身于"}, {"type": "subtitle", "time": 2473.589, "timestamp": "00:41:13", "text": "神奇的黑暗之中。 日光。   还有"}, {"type": "subtitle", "time": 2475.27, "timestamp": "00:41:15", "text": "什么？"}, {"type": "subtitle", "time": 2482.23, "timestamp": "00:41:22", "text": "我的天啊。 但那实际上是一个"}, {"type": "subtitle", "time": 2484.63, "timestamp": "00:41:24", "text": "火球。"}, {"type": "subtitle", "time": 2486.71, "timestamp": "00:41:26", "text": "嗯，让我想想。 你最好"}, {"type": "subtitle", "time": 2488.87, "timestamp": "00:41:28", "text": "还是准备月光吧。"}, {"type": "subtitle", "time": 2492.15, "timestamp": "00:41:32", "text": "好球！ ... 真是件好事。"}, {"type": "subtitle", "time": 2493.829, "timestamp": "00:41:33", "text": "有用。"}, {"type": "subtitle", "time": 2497.109, "timestamp": "00:41:37", "text": "呃，你还有什么别的吗？"}, {"type": "subtitle", "time": 2499.99, "timestamp": "00:41:39", "text": "我的天啊，你居然能召唤野兽！   这又给"}, {"type": "subtitle", "time": 2502.71, "timestamp": "00:41:42", "text": "我们的动物园增添了一笔"}, {"type": "subtitle", "time": 2503.67, "timestamp": "00:41:43", "text": "。"}, {"type": "subtitle", "time": 2506.15, "timestamp": "00:41:46", "text": "再加一些。"}, {"type": "subtitle", "time": 2507.43, "timestamp": "00:41:47", "text": "他们那边也有空余人选。"}, {"type": "subtitle", "time": 2514.95, "timestamp": "00:41:54", "text": "好像永远都不够"}, {"type": "subtitle", "time": 2516.23, "timestamp": "00:41:56", "text": "似的。"}, {"type": "subtitle", "time": 2517.91, "timestamp": "00:41:57", "text": "我的天啊。 两队都有很多"}]
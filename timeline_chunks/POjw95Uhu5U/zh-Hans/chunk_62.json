[{"type": "subtitle", "time": 3724.71, "timestamp": "01:02:04", "text": "滴答滴答。停。别再提"}, {"type": "subtitle", "time": 3725.43, "timestamp": "01:02:05", "text": "股票市场了。"}, {"type": "subtitle", "time": 3727.27, "timestamp": "01:02:07", "text": "就像……哦，我觉得你应该……我"}, {"type": "subtitle", "time": 3728.71, "timestamp": "01:02:08", "text": "觉得你应该"}, {"type": "subtitle", "time": 3732.39, "timestamp": "01:02:12", "text": "晚点去镇上看看股票市场。"}, {"type": "subtitle", "time": 3733.2, "timestamp": "01:02:13", "text": "股票市场。 你先说的是股票。"}, {"type": "subtitle", "time": 3736.4, "timestamp": "01:02:16", "text": "你先说的是股票。 股票多少钱？"}, {"type": "subtitle", "time": 3737.44, "timestamp": "01:02:17", "text": "股票多少钱？ 我不知道。我只是个"}, {"type": "subtitle", "time": 3738.799, "timestamp": "01:02:18", "text": "我不知道。我只是个 接待员。"}, {"type": "subtitle", "time": 3741.119, "timestamp": "01:02:21", "text": "接待员。 滴答，停。停。"}, {"type": "subtitle", "time": 3743.839, "timestamp": "01:02:23", "text": "滴答，停。停。 别再说了。"}, {"type": "subtitle", "time": 3745.2, "timestamp": "01:02:25", "text": "别再说了。 你妈妈知道，"}, {"type": "subtitle", "time": 3746.88, "timestamp": "01:02:26", "text": "你妈妈知道， 你爸爸也知道。滴答。"}, {"type": "subtitle", "time": 3754.15, "timestamp": "01:02:34", "text": "停。滴答。停。哦，天哪。别再"}, {"type": "subtitle", "time": 3758.069, "timestamp": "01:02:38", "text": "谈论该死的股票市场了。"}, {"type": "subtitle", "time": 3760.23, "timestamp": "01:02:40", "text": "嘿，嘿，魔鬼先生，你能带我们"}, {"type": "subtitle", "time": 3766.63, "timestamp": "01:02:46", "text": "他们说：“哦，是的，他们……他们在"}, {"type": "subtitle", "time": 3769.43, "timestamp": "01:02:49", "text": "这儿。”  “跟我来。”对，跟我来。"}, {"type": "subtitle", "time": 3770.23, "timestamp": "01:02:50", "text": "走吧。"}, {"type": "subtitle", "time": 3772.63, "timestamp": "01:02:52", "text": "好的，我们去和朋友们碰面。"}, {"type": "subtitle", "time": 3774.069, "timestamp": "01:02:54", "text": "你刚才看到这家伙在拖"}, {"type": "subtitle", "time": 3775.43, "timestamp": "01:02:55", "text": "地。跟"}, {"type": "subtitle", "time": 3777.99, "timestamp": "01:02:57", "text": "朋友们聊聊。跟"}]
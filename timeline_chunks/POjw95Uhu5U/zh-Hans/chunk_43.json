[{"type": "subtitle", "time": 2580.069, "timestamp": "00:43:00", "text": "他并没有呼吸。"}, {"type": "subtitle", "time": 2583.349, "timestamp": "00:43:03", "text": "哦，老兄。 技术上来说，他"}, {"type": "subtitle", "time": 2585.75, "timestamp": "00:43:05", "text": "可以。 这很好，因为他可以呼吸了"}, {"type": "subtitle", "time": 2588.15, "timestamp": "00:43:08", "text": "。"}, {"type": "subtitle", "time": 2590.069, "timestamp": "00:43:10", "text": "如果把猪淹得足够深，它们也能在水下呼吸"}, {"type": "subtitle", "time": 2592.71, "timestamp": "00:43:12", "text": "。"}, {"type": "subtitle", "time": 2594.23, "timestamp": "00:43:14", "text": "只要你足够努力，"}, {"type": "subtitle", "time": 2596.15, "timestamp": "00:43:16", "text": "最终就能永远待在水下"}, {"type": "subtitle", "time": 2597.27, "timestamp": "00:43:17", "text": "。   是的"}, {"type": "subtitle", "time": 2599.349, "timestamp": "00:43:19", "text": "。 我的意思是，严格来说，不是。 你会"}, {"type": "subtitle", "time": 2601.51, "timestamp": "00:43:21", "text": "坚持住的。"}, {"type": "subtitle", "time": 2603.43, "timestamp": "00:43:23", "text": "谢谢你的提醒，"}, {"type": "subtitle", "time": 2605.67, "timestamp": "00:43:25", "text": "除非你把一些石头绑在"}, {"type": "subtitle", "time": 2607.03, "timestamp": "00:43:27", "text": "腿上。"}, {"type": "subtitle", "time": 2609.589, "timestamp": "00:43:29", "text": "谢谢您提供的信息，很有帮助。 蜱虫蜱虫"}, {"type": "subtitle", "time": 2612.79, "timestamp": "00:43:32", "text": "遭受了水刑。 不。"}, {"type": "subtitle", "time": 2613.829, "timestamp": "00:43:33", "text": "我的天哪。"}, {"type": "subtitle", "time": 2617.27, "timestamp": "00:43:37", "text": "不要用水刑。 打钩。"}, {"type": "subtitle", "time": 2619.03, "timestamp": "00:43:39", "text": "你觉得水刑听起来很有趣，"}, {"type": "subtitle", "time": 2620.79, "timestamp": "00:43:40", "text": "直到你了解水刑的真正"}, {"type": "subtitle", "time": 2622.069, "timestamp": "00:43:42", "text": "含义。"}, {"type": "subtitle", "time": 2623.589, "timestamp": "00:43:43", "text": "但说"}, {"type": "subtitle", "time": 2625.589, "timestamp": "00:43:45", "text": "实话，除了这些咒语之外，我觉得"}, {"type": "subtitle", "time": 2627.91, "timestamp": "00:43:47", "text": "你可以随便选一个觉得好笑的。"}, {"type": "subtitle", "time": 2629.99, "timestamp": "00:43:49", "text": "我的意思是，肯定能治愈伤口。 就像"}, {"type": "subtitle", "time": 2631.99, "timestamp": "00:43:51", "text": "治愈型的那种，那肯定是好事。 但我"}, {"type": "subtitle", "time": 2634.39, "timestamp": "00:43:54", "text": "认为你并不需要专门禁用侦测魔法，"}, {"type": "subtitle", "time": 2636.39, "timestamp": "00:43:56", "text": "因为我们已经禁用了"}, {"type": "subtitle", "time": 2638.55, "timestamp": "00:43:58", "text": "侦测魔法。 因为"}, {"type": "subtitle", "time": 2639.03, "timestamp": "00:43:59", "text": "你知道，"}]
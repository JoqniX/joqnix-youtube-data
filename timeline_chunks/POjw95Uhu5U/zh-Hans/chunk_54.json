[{"type": "subtitle", "time": 3241.27, "timestamp": "00:54:01", "text": "我觉得等你到了"}, {"type": "subtitle", "time": 3243.27, "timestamp": "00:54:03", "text": "镇上，这会非常有用。 就像在地"}, {"type": "subtitle", "time": 3244.549, "timestamp": "00:54:04", "text": "牢里它不是"}, {"type": "subtitle", "time": 3245.75, "timestamp": "00:54:05", "text": "最有用的，但是当你到达城镇后，"}, {"type": "subtitle", "time": 3253.03, "timestamp": "00:54:13", "text": "魅力值并去商店。 它看着"}, {"type": "subtitle", "time": 3255.829, "timestamp": "00:54:15", "text": "我，看着我选择他妈的控制"}, {"type": "subtitle", "time": 3257.67, "timestamp": "00:54:17", "text": "人，却从来没有真正"}, {"type": "subtitle", "time": 3259.51, "timestamp": "00:54:19", "text": "使用过完整的人。"}, {"type": "subtitle", "time": 3261.67, "timestamp": "00:54:21", "text": "哦，不。"}, {"type": "subtitle", "time": 3263.75, "timestamp": "00:54:23", "text": "我也很喜欢我拥有黑暗属性，但我"}, {"type": "subtitle", "time": 3267.19, "timestamp": "00:54:27", "text": "却从未有机会使用黑暗属性。"}, {"type": "subtitle", "time": 3269.27, "timestamp": "00:54:29", "text": "我真想让自己陷入黑暗之中"}, {"type": "subtitle", "time": 3271.829, "timestamp": "00:54:31", "text": "。"}, {"type": "subtitle", "time": 3273.91, "timestamp": "00:54:33", "text": "黑暗。"}, {"type": "subtitle", "time": 3276.47, "timestamp": "00:54:36", "text": "但那里有个小镇。   当然"}, {"type": "subtitle", "time": 3279.109, "timestamp": "00:54:39", "text": "，那里有个城镇。 哦，"}, {"type": "subtitle", "time": 3281.91, "timestamp": "00:54:41", "text": "我们只是被困在这个地牢里而已。"}, {"type": "subtitle", "time": 3283.51, "timestamp": "00:54:43", "text": "你现在只是在探索这个地方"}, {"type": "subtitle", "time": 3285.349, "timestamp": "00:54:45", "text": "，但之后出去的时候会去一个城镇"}, {"type": "subtitle", "time": 3286.309, "timestamp": "00:54:46", "text": "。   是的"}, {"type": "subtitle", "time": 3288.79, "timestamp": "00:54:48", "text": "。 所以，从"}, {"type": "subtitle", "time": 3290.79, "timestamp": "00:54:50", "text": "技术上讲，基本上就是这样，乔克。 这就像第"}, {"type": "subtitle", "time": 3293.67, "timestamp": "00:54:53", "text": "一个区域。   是的"}, {"type": "subtitle", "time": 3296.47, "timestamp": "00:54:56", "text": "，这里是"}, {"type": "subtitle", "time": 3298.71, "timestamp": "00:54:58", "text": "教学关卡。"}]
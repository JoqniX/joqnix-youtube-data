[{"type": "subtitle", "time": 4801.91, "timestamp": "01:20:01", "text": "小鸡很乐意为"}, {"type": "subtitle", "time": 4803.83, "timestamp": "01:20:03", "text": "他们那些破产的党员支付任何费用。   这"}, {"type": "subtitle", "time": 4804.47, "timestamp": "01:20:04", "text": "是怎么回事？"}, {"type": "subtitle", "time": 4806.79, "timestamp": "01:20:06", "text": "他们破产了。"}, {"type": "subtitle", "time": 4810.39, "timestamp": "01:20:10", "text": "是的，她需要200个来获得"}, {"type": "subtitle", "time": 4813.11, "timestamp": "01:20:13", "text": "自然的庇护。 如果我清楚这一点，那"}, {"type": "subtitle", "time": 4815.27, "timestamp": "01:20:15", "text": "对乔克来说是件好事。"}, {"type": "subtitle", "time": 4817.43, "timestamp": "01:20:17", "text": "200."}, {"type": "subtitle", "time": 4819.75, "timestamp": "01:20:19", "text": "好吧，乔克，你有自己的钱"}, {"type": "subtitle", "time": 4821.75, "timestamp": "01:20:21", "text": "。 你想从卡米拉那里购买东西吗？"}, {"type": "subtitle", "time": 4824.07, "timestamp": "01:20:24", "text": "是100。乔克只有100。"}, {"type": "subtitle", "time": 4826.07, "timestamp": "01:20:26", "text": "没错，"}, {"type": "subtitle", "time": 4828.07, "timestamp": "01:20:28", "text": "100是市场价。 杰克认为你可以"}, {"type": "subtitle", "time": 4833.669, "timestamp": "01:20:33", "text": "你为什么不"}, {"type": "subtitle", "time": 4835.83, "timestamp": "01:20:35", "text": "跟那辆破车讨价还价呢？"}, {"type": "subtitle", "time": 4840.31, "timestamp": "01:20:40", "text": "好的。 是的，你不停地"}, {"type": "subtitle", "time": 4843.51, "timestamp": "01:20:43", "text": "用“"}, {"type": "subtitle", "time": 4844.63, "timestamp": "01:20:44", "text": "我的天哪”来激怒别人。"}, {"type": "subtitle", "time": 4848.63, "timestamp": "01:20:48", "text": "你知道吗？ 我就看看吧。"}, {"type": "subtitle", "time": 4850.149, "timestamp": "01:20:50", "text": "我刚才说了，我们正在观察"}, {"type": "subtitle", "time": 4853.35, "timestamp": "01:20:53", "text": "兄弟是否知道如何应对"}, {"type": "subtitle", "time": 4855.189, "timestamp": "01:20:55", "text": "疲软的市场，然后再向他展示"}, {"type": "subtitle", "time": 4859.35, "timestamp": "01:20:59", "text": "[音乐]，嗯，还得"}]
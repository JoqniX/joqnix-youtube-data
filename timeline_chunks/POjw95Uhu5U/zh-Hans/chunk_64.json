[{"type": "subtitle", "time": 3844.87, "timestamp": "01:04:04", "text": "是不是躲在这儿了？逃走了。"}, {"type": "subtitle", "time": 3846.95, "timestamp": "01:04:06", "text": "哦不。卡米拉在哪儿？哦不。"}, {"type": "subtitle", "time": 3848.309, "timestamp": "01:04:08", "text": "卡米拉在哪儿？哦。"}, {"type": "subtitle", "time": 3851.27, "timestamp": "01:04:11", "text": "哦不。她逃走了。"}, {"type": "subtitle", "time": 3853.109, "timestamp": "01:04:13", "text": "好吧，我来说说第四个。好了。"}, {"type": "subtitle", "time": 3854.95, "timestamp": "01:04:14", "text": "会有第四个的。"}, {"type": "subtitle", "time": 3857.349, "timestamp": "01:04:17", "text": "不，她会一直回来的"}, {"type": "subtitle", "time": 3858.63, "timestamp": "01:04:18", "text": "。她会是第五个、"}, {"type": "subtitle", "time": 3861.589, "timestamp": "01:04:21", "text": "第六个或者第七个。是"}, {"type": "subtitle", "time": 3868.39, "timestamp": "01:04:28", "text": "我的天哪。"}, {"type": "subtitle", "time": 3876.47, "timestamp": "01:04:36", "text": "去你的。"}, {"type": "subtitle", "time": 3879.67, "timestamp": "01:04:39", "text": "哦，亲爱的。"}, {"type": "subtitle", "time": 3886.549, "timestamp": "01:04:46", "text": "后面，因为卡米拉在"}, {"type": "subtitle", "time": 3888.549, "timestamp": "01:04:48", "text": "这里。"}, {"type": "subtitle", "time": 3889.51, "timestamp": "01:04:49", "text": "好吧。"}, {"type": "subtitle", "time": 3892.39, "timestamp": "01:04:52", "text": "像个勇敢的大男孩。"}, {"type": "subtitle", "time": 3897.67, "timestamp": "01:04:57", "text": "你们，你们，这场战争结束了吗？"}]
[{"type": "subtitle", "time": 8701.429, "timestamp": "02:25:01", "text": "哦，呃，你需要先施法。"}, {"type": "subtitle", "time": 8707.99, "timestamp": "02:25:07", "text": "呼气是一种动作。"}, {"type": "subtitle", "time": 8709.51, "timestamp": "02:25:09", "text": "你得稍后再做这件事。   是的"}, {"type": "subtitle", "time": 8710.23, "timestamp": "02:25:10", "text": "。 是的。"}, {"type": "subtitle", "time": 8711.27, "timestamp": "02:25:11", "text": "之后。   是的"}, {"type": "subtitle", "time": 8712.309, "timestamp": "02:25:12", "text": "。"}, {"type": "subtitle", "time": 8714.15, "timestamp": "02:25:14", "text": "好的。 它说这是额外的奖励动作"}, {"type": "subtitle", "time": 8715.19, "timestamp": "02:25:15", "text": "。   是的"}, {"type": "subtitle", "time": 8716.95, "timestamp": "02:25:16", "text": "。 奖励动作是实际"}, {"type": "subtitle", "time": 8719.91, "timestamp": "02:25:19", "text": "施法动作。 呼气本身就是一种动作，"}, {"type": "subtitle", "time": 8721.349, "timestamp": "02:25:21", "text": "因为你本质上是在给某人打气"}, {"type": "subtitle", "time": 8722.87, "timestamp": "02:25:22", "text": "。"}, {"type": "subtitle", "time": 8726.15, "timestamp": "02:25:26", "text": "那没关系。 没关系。"}, {"type": "subtitle", "time": 8728.469, "timestamp": "02:25:28", "text": "好的。 好的。 所以，你身体不舒服。"}, {"type": "subtitle", "time": 8729.83, "timestamp": "02:25:29", "text": "好的。"}, {"type": "subtitle", "time": 8731.19, "timestamp": "02:25:31", "text": "我觉得我什么都做不了。 我"}, {"type": "subtitle", "time": 8731.59, "timestamp": "02:25:31", "text": "觉得我做不到。   还要别的吗"}, {"type": "subtitle", "time": 8733.59, "timestamp": "02:25:33", "text": "？ 好的。 那现在"}, {"type": "subtitle", "time": 8737.11, "timestamp": "02:25:37", "text": "轮到Ariana了。"}, {"type": "subtitle", "time": 8739.19, "timestamp": "02:25:39", "text": "好的。 爱莉安娜。"}, {"type": "subtitle", "time": 8743.19, "timestamp": "02:25:43", "text": "好的。 那边那个黏糊糊的大雕像叫阿里"}, {"type": "subtitle", "time": 8744.15, "timestamp": "02:25:44", "text": "。"}, {"type": "subtitle", "time": 8747.11, "timestamp": "02:25:47", "text": "这是一尊非常粘手的雕像。 是啊，一座"}, {"type": "subtitle", "time": 8748.07, "timestamp": "02:25:48", "text": "黏糊糊的雕像。"}, {"type": "subtitle", "time": 8749.59, "timestamp": "02:25:49", "text": "伙计们，好像有个"}, {"type": "subtitle", "time": 8751.91, "timestamp": "02:25:51", "text": "东西偷了我们的"}, {"type": "subtitle", "time": 8756.07, "timestamp": "02:25:56", "text": "钱。 至少我的钱是这样。"}, {"type": "subtitle", "time": 8758.71, "timestamp": "02:25:58", "text": "所以，一定要小心。"}]
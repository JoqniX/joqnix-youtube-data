[{"type": "subtitle", "time": 9120.71, "timestamp": "02:32:00", "text": "我是认真的。 不要说话，不要"}, {"type": "subtitle", "time": 9124.389, "timestamp": "02:32:04", "text": "碰我。 别跟我说话。 好的。 那是在"}, {"type": "subtitle", "time": 9129.99, "timestamp": "02:32:09", "text": "吐酸之后。 所以，在……之前，在"}, {"type": "subtitle", "time": 9132.55, "timestamp": "02:32:12", "text": "半音阶之前。 哦。 是的。   是的"}, {"type": "subtitle", "time": 9135.83, "timestamp": "02:32:15", "text": "。 在女巫闪电之前。 那我去"}, {"type": "subtitle", "time": 9146.389, "timestamp": "02:32:26", "text": "我的天啊。 为什么我们做"}, {"type": "subtitle", "time": 9153.75, "timestamp": "02:32:33", "text": "我努力想从这场该死的喋喋不休中挤出时间"}, {"type": "subtitle", "time": 9155.51, "timestamp": "02:32:35", "text": "。"}, {"type": "subtitle", "time": 9157.19, "timestamp": "02:32:37", "text": "我的天啊。"}, {"type": "subtitle", "time": 9160.309, "timestamp": "02:32:40", "text": "它只会胡言乱语。"}, {"type": "subtitle", "time": 9162.309, "timestamp": "02:32:42", "text": "我喜欢唠叨。"}, {"type": "subtitle", "time": 9165.03, "timestamp": "02:32:45", "text": "我的意思是，我也喜欢唠叨，但是"}]
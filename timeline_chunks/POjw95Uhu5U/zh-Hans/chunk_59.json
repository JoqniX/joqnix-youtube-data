[{"type": "subtitle", "time": 3541.91, "timestamp": "00:59:01", "text": "。蒂克和克里斯彭是好朋友。"}, {"type": "subtitle", "time": 3543.67, "timestamp": "00:59:03", "text": "没错。"}, {"type": "subtitle", "time": 3546.47, "timestamp": "00:59:06", "text": "蒂克是个又高又壮的家伙，所以他能"}, {"type": "subtitle", "time": 3547.91, "timestamp": "00:59:07", "text": "扛得住。让我去拿……让我去拿"}, {"type": "subtitle", "time": 3549.75, "timestamp": "00:59:09", "text": "手电筒。这是你的手电筒。这是"}, {"type": "subtitle", "time": 3555.99, "timestamp": "00:59:15", "text": "我猜现在是加拿大了，就像他的"}, {"type": "subtitle", "time": 3557.589, "timestamp": "00:59:17", "text": "马不知怎么变成了土豆，"}, {"type": "subtitle", "time": 3560.309, "timestamp": "00:59:20", "text": "而他只是接受了，而不是"}, {"type": "subtitle", "time": 3563.27, "timestamp": "00:59:23", "text": "第二次就接受了。"}, {"type": "subtitle", "time": 3564.95, "timestamp": "00:59:24", "text": "嗯。”"}, {"type": "subtitle", "time": 3567.03, "timestamp": "00:59:27", "text": "他就是那种，你知道吗"}, {"type": "subtitle", "time": 3571.43, "timestamp": "00:59:31", "text": "，管他呢。我们就这么办吧。"}, {"type": "subtitle", "time": 3573.08, "timestamp": "00:59:33", "text": "我"}, {"type": "subtitle", "time": 3575.99, "timestamp": "00:59:35", "text": "[音乐]"}, {"type": "subtitle", "time": 3577.03, "timestamp": "00:59:37", "text": "没事，"}, {"type": "subtitle", "time": 3579.19, "timestamp": "00:59:39", "text": "先生。好的。等等，我们下楼了"}, {"type": "subtitle", "time": 3580.309, "timestamp": "00:59:40", "text": "。"}, {"type": "subtitle", "time": 3582.95, "timestamp": "00:59:42", "text": "是的，下楼了。你刚"}, {"type": "subtitle", "time": 3584.71, "timestamp": "00:59:44", "text": "坐下。"}, {"type": "subtitle", "time": 3586.549, "timestamp": "00:59:46", "text": "告诉我什么时候大家都准备好了。"}, {"type": "subtitle", "time": 3587.27, "timestamp": "00:59:47", "text": "是的，"}, {"type": "subtitle", "time": 3589.829, "timestamp": "00:59:49", "text": "大家都慢下来了。是的。是的"}, {"type": "subtitle", "time": 3591.67, "timestamp": "00:59:51", "text": "，我想。是的，关闭动态"}, {"type": "subtitle", "time": 3593.349, "timestamp": "00:59:53", "text": "光照确实"}, {"type": "subtitle", "time": 3595.99, "timestamp": "00:59:55", "text": "加快了一些。"}, {"type": "subtitle", "time": 3597.91, "timestamp": "00:59:57", "text": "我的天哪。"}]
[{"type": "subtitle", "time": 6245.59, "timestamp": "01:44:05", "text": "我说完。听我说完。不知道为什么，那家店"}, {"type": "subtitle", "time": 6247.75, "timestamp": "01:44:07", "text": "离这儿大概有40分钟车程。我发誓"}, {"type": "subtitle", "time": 6250.229, "timestamp": "01:44:10", "text": "这事儿挺搞笑的。但就是40分钟"}, {"type": "subtitle", "time": 6251.75, "timestamp": "01:44:11", "text": "车程。"}, {"type": "subtitle", "time": 6263.75, "timestamp": "01:44:23", "text": "他们是想送礼物给"}, {"type": "subtitle", "time": 6266.149, "timestamp": "01:44:26", "text": "朋友吗？"}, {"type": "subtitle", "time": 6267.99, "timestamp": "01:44:27", "text": "人们喜欢去"}, {"type": "subtitle", "time": 6273.189, "timestamp": "01:44:33", "text": "钓鱼。不，我可以买面包。"}, {"type": "subtitle", "time": 6274.709, "timestamp": "01:44:34", "text": "我的意思是，至少你买到面包了，"}, {"type": "subtitle", "time": 6276.39, "timestamp": "01:44:36", "text": "对吧？"}, {"type": "subtitle", "time": 6279.109, "timestamp": "01:44:39", "text": "等等。这就是整个过程吗？"}, {"type": "subtitle", "time": 6279.51, "timestamp": "01:44:39", "text": "不，"}, {"type": "subtitle", "time": 6282.149, "timestamp": "01:44:42", "text": "还没。我们才刚开始。"}, {"type": "subtitle", "time": 6283.75, "timestamp": "01:44:43", "text": "我们才刚结束一个。"}, {"type": "subtitle", "time": 6286.149, "timestamp": "01:44:46", "text": "嗯，我们一直在拖延，"}, {"type": "subtitle", "time": 6288.55, "timestamp": "01:44:48", "text": "一直在闲聊。"}, {"type": "subtitle", "time": 6290.629, "timestamp": "01:44:50", "text": "拖延，闲聊，然后，"}, {"type": "subtitle", "time": 6292.709, "timestamp": "01:44:52", "text": "你错过了卡米拉被"}]
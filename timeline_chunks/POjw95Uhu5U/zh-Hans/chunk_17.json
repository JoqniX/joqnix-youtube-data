[{"type": "subtitle", "time": 1022.47, "timestamp": "00:17:02", "text": "不这么认为。 我不这么认为。"}, {"type": "subtitle", "time": 1024.63, "timestamp": "00:17:04", "text": "但是，是的，等等。 改变。 但"}, {"type": "subtitle", "time": 1025.99, "timestamp": "00:17:05", "text": "别担心，因为"}, {"type": "subtitle", "time": 1030.069, "timestamp": "00:17:10", "text": "我还有其他方法可以学习咒语，"}, {"type": "subtitle", "time": 1031.99, "timestamp": "00:17:11", "text": "还有其他方法可以学习咒语。 那一切都在"}, {"type": "subtitle", "time": 1032.87, "timestamp": "00:17:12", "text": "计划之中，"}, {"type": "subtitle", "time": 1035.27, "timestamp": "00:17:15", "text": "但那将是在"}, {"type": "subtitle", "time": 1036.949, "timestamp": "00:17:16", "text": "你离开"}, {"type": "subtitle", "time": 1037.829, "timestamp": "00:17:17", "text": "地牢很久之后的事了。"}, {"type": "subtitle", "time": 1039.829, "timestamp": "00:17:19", "text": "哦，那完全没问题。"}, {"type": "subtitle", "time": 1041.829, "timestamp": "00:17:21", "text": "这个故事的寓意是："}, {"type": "subtitle", "time": 1044.47, "timestamp": "00:17:24", "text": "我们拥有一根能发射火球的魔杖。"}, {"type": "subtitle", "time": 1046.15, "timestamp": "00:17:26", "text": "我想对雷施放火球术"}, {"type": "subtitle", "time": 1048.47, "timestamp": "00:17:28", "text": "。 我"}, {"type": "subtitle", "time": 1050.71, "timestamp": "00:17:30", "text": "给你那么多"}, {"type": "subtitle", "time": 1061.909, "timestamp": "00:17:41", "text": "我的天啊。"}, {"type": "subtitle", "time": 1063.909, "timestamp": "00:17:43", "text": "那要多少钱？ 让我来实际"}, {"type": "subtitle", "time": 1064.549, "timestamp": "00:17:44", "text": "操作一下。"}, {"type": "subtitle", "time": 1070.15, "timestamp": "00:17:50", "text": "总有一天，总有一天，背叛会发生。"}, {"type": "subtitle", "time": 1074.39, "timestamp": "00:17:54", "text": "我希望你等我出家为僧的时候再做这件事，"}, {"type": "subtitle", "time": 1078.07, "timestamp": "00:17:58", "text": "这样我们就能看看你是否真的做到了。"}]
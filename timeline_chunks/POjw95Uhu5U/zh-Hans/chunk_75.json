[{"type": "subtitle", "time": 4501.189, "timestamp": "01:15:01", "text": "，但是等等。 让我赶紧"}, {"type": "subtitle", "time": 4503.51, "timestamp": "01:15:03", "text": "去拿一下。 稍等"}, {"type": "subtitle", "time": 4506.229, "timestamp": "01:15:06", "text": "片刻。 又是哪个电话？ 欢迎"}, {"type": "subtitle", "time": 4509.189, "timestamp": "01:15:09", "text": "来到……呃……客户"}, {"type": "subtitle", "time": 4513.59, "timestamp": "01:15:13", "text": "支持的天堂。 请稍候，我们正在联系您。"}, {"type": "subtitle", "time": 4521.99, "timestamp": "01:15:21", "text": "我没有那种东西。"}, {"type": "subtitle", "time": 4523.99, "timestamp": "01:15:23", "text": "哦，是的。 等等，我好像有类似电梯"}, {"type": "subtitle", "time": 4525.75, "timestamp": "01:15:25", "text": "音乐的那种背景音乐。 这简直就像"}, {"type": "subtitle", "time": 4531.43, "timestamp": "01:15:31", "text": "那根本不是"}, {"type": "subtitle", "time": 4532.87, "timestamp": "01:15:32", "text": "电梯音乐。 电梯"}, {"type": "subtitle", "time": 4536.149, "timestamp": "01:15:36", "text": "音乐呢？ 电梯音乐真是……呃……我的"}, {"type": "subtitle", "time": 4537.669, "timestamp": "01:15:37", "text": "天哪。 哦，我找不到。 好了。"}, {"type": "subtitle", "time": 4545.27, "timestamp": "01:15:45", "text": "好的，稍等一下。 稍等片刻。 一次"}, {"type": "subtitle", "time": 4548.31, "timestamp": "01:15:48", "text": "湖畔之旅。"}, {"type": "subtitle", "time": 4551.669, "timestamp": "01:15:51", "text": "独一无二。 呃，那是什么？ 火球。 好了"}, {"type": "subtitle", "time": 4554.55, "timestamp": "01:15:54", "text": "。 好的。 等等，等等。 这到底是从哪里开始"}, {"type": "subtitle", "time": 4555.91, "timestamp": "01:15:55", "text": "变得重要的？"}, {"type": "subtitle", "time": 4557.35, "timestamp": "01:15:57", "text": "为什么这件事在那边变得如此重要？"}, {"type": "subtitle", "time": 4558.39, "timestamp": "01:15:58", "text": "搞什么鬼？"}, {"type": "subtitle", "time": 4559.27, "timestamp": "01:15:59", "text": "哦，不。"}]
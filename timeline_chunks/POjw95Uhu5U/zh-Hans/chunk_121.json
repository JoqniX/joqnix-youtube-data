[{"type": "subtitle", "time": 7260.709, "timestamp": "02:01:00", "text": "嗯，为大家哭一场。"}, {"type": "subtitle", "time": 7262.78, "timestamp": "02:01:02", "text": "好的。"}, {"type": "subtitle", "time": 7272.79, "timestamp": "02:01:12", "text": "。 每次我应该采取行动的时候，如果我有"}, {"type": "subtitle", "time": 7275.03, "timestamp": "02:01:15", "text": "很多像宏伟的事情要做，我应该先让"}, {"type": "subtitle", "time": 7283.99, "timestamp": "02:01:23", "text": "好的。"}, {"type": "subtitle", "time": 7285.109, "timestamp": "02:01:25", "text": "我猜是爱莉安娜。 啪。"}, {"type": "subtitle", "time": 7286.95, "timestamp": "02:01:26", "text": "顺便说一句，你找错人了"}, {"type": "subtitle", "time": 7288.629, "timestamp": "02:01:28", "text": "。 应该是你们给拟"}, {"type": "subtitle", "time": 7291.35, "timestamp": "02:01:31", "text": "态怪加上龙吼，而不是给我们。"}, {"type": "subtitle", "time": 7293.99, "timestamp": "02:01:33", "text": "哦。 哦，我的错。 我觉得这就像"}, {"type": "subtitle", "time": 7295.91, "timestamp": "02:01:35", "text": "给了所有盟友优势。"}, {"type": "subtitle", "time": 7297.35, "timestamp": "02:01:37", "text": "我刚刚才意识到这一点。"}, {"type": "subtitle", "time": 7304.709, "timestamp": "02:01:44", "text": "伤害。"}, {"type": "subtitle", "time": 7312.709, "timestamp": "02:01:52", "text": "好的，你击中了。 好的。"}, {"type": "subtitle", "time": 7316.07, "timestamp": "02:01:56", "text": "好吧，我"}, {"type": "subtitle", "time": 7318.149, "timestamp": "02:01:58", "text": "觉得这模仿得挺像的。"}]
[{"type": "subtitle", "time": 3901.029, "timestamp": "01:05:01", "text": "嗯，如果不是对方队伍，那"}, {"type": "subtitle", "time": 3912.15, "timestamp": "01:05:12", "text": "范和阿丽亚娜的眼神真是太棒了，既疯狂"}, {"type": "subtitle", "time": 3914.15, "timestamp": "01:05:14", "text": "又高兴"}, {"type": "subtitle", "time": 3917.589, "timestamp": "01:05:17", "text": "，非常兴奋能来到这里。"}, {"type": "subtitle", "time": 3921.43, "timestamp": "01:05:21", "text": "啊，你又把你的宠物带来了"}, {"type": "subtitle", "time": 3927.75, "timestamp": "01:05:27", "text": "就像你一样。"}, {"type": "subtitle", "time": 3929.829, "timestamp": "01:05:29", "text": "我想你就是她那样的人。"}, {"type": "subtitle", "time": 3933.349, "timestamp": "01:05:33", "text": "我是一位杰出的贵族，亲爱的。"}, {"type": "subtitle", "time": 3935.91, "timestamp": "01:05:35", "text": "你相信自己。"}, {"type": "subtitle", "time": 3939.67, "timestamp": "01:05:39", "text": "是的，她没那么坏。这个人"}, {"type": "subtitle", "time": 3941.67, "timestamp": "01:05:41", "text": "确保你的家人从未说过"}, {"type": "subtitle", "time": 3954.309, "timestamp": "01:05:54", "text": "不。"}, {"type": "subtitle", "time": 3955.99, "timestamp": "01:05:55", "text": "你知道吗？克里斯彭就像"}, {"type": "subtitle", "time": 3958.069, "timestamp": "01:05:58", "text": "隐形人一样，但击掌却很有效。"}]
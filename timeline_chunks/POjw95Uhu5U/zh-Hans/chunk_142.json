[{"type": "subtitle", "time": 8520.87, "timestamp": "02:22:00", "text": "绝对不是20。肯定"}, {"type": "subtitle", "time": 8522.469, "timestamp": "02:22:02", "text": "比这大得多。 让我查"}, {"type": "subtitle", "time": 8522.71, "timestamp": "02:22:02", "text": "一下。"}, {"type": "subtitle", "time": 8526.309, "timestamp": "02:22:06", "text": "不，目标是直径 20 英尺的球体。"}, {"type": "subtitle", "time": 8528.63, "timestamp": "02:22:08", "text": "哦，是20英尺。哦，"}, {"type": "subtitle", "time": 8530.389, "timestamp": "02:22:10", "text": "比我记忆中的要小得多。 哦，最大的"}, {"type": "subtitle", "time": 8531.83, "timestamp": "02:22:11", "text": "那个是炸药。 我当时想到的是"}, {"type": "subtitle", "time": 8533.429, "timestamp": "02:22:13", "text": "炸药。"}, {"type": "subtitle", "time": 8535.83, "timestamp": "02:22:15", "text": "我不知道你是不是炸药。"}, {"type": "subtitle", "time": 8538.15, "timestamp": "02:22:18", "text": "这其实有点可能，但"}, {"type": "subtitle", "time": 8539.51, "timestamp": "02:22:19", "text": "我感觉"}, {"type": "subtitle", "time": 8541.27, "timestamp": "02:22:21", "text": "用火球术有点浪费。 只有一个"}, {"type": "subtitle", "time": 8541.91, "timestamp": "02:22:21", "text": "生物。"}, {"type": "subtitle", "time": 8544.389, "timestamp": "02:22:24", "text": "只是一个人用了彩色球之类的东西"}, {"type": "subtitle", "time": 8545.27, "timestamp": "02:22:25", "text": "。   是的"}, {"type": "subtitle", "time": 8547.67, "timestamp": "02:22:27", "text": "。"}, {"type": "subtitle", "time": 8549.67, "timestamp": "02:22:29", "text": "好的，我将使用色度。 我当时想用“"}, {"type": "subtitle", "time": 8551.429, "timestamp": "02:22:31", "text": "疾病射线”试试能不能让它"}, {"type": "subtitle", "time": 8554.15, "timestamp": "02:22:34", "text": "吐"}, {"type": "subtitle", "time": 8559.75, "timestamp": "02:22:39", "text": "不知为何，我的大脑认为那样做会"}, {"type": "subtitle", "time": 8561.429, "timestamp": "02:22:41", "text": "像“放他走”那样把他们吐出来"}, {"type": "subtitle", "time": 8564.07, "timestamp": "02:22:44", "text": "。"}, {"type": "subtitle", "time": 8566.07, "timestamp": "02:22:46", "text": "我不认为它们就是这样粘住的，"}, {"type": "subtitle", "time": 8569.11, "timestamp": "02:22:49", "text": "它们"}, {"type": "subtitle", "time": 8572.55, "timestamp": "02:22:52", "text": "不是粘在他的胃里。"}, {"type": "subtitle", "time": 8574.87, "timestamp": "02:22:54", "text": "但你说过要用力击打，对吧？"}, {"type": "subtitle", "time": 8576.15, "timestamp": "02:22:56", "text": "用力击打。"}, {"type": "subtitle", "time": 8579.75, "timestamp": "02:22:59", "text": "法术位在你手里，不是"}]
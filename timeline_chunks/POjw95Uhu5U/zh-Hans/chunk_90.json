[{"type": "subtitle", "time": 5403.59, "timestamp": "01:30:03", "text": "我一会儿就回来。好的。好的。谢谢。"}, {"type": "subtitle", "time": 5405.59, "timestamp": "01:30:05", "text": "放进口袋里。放次元袋里。"}, {"type": "subtitle", "time": 5410.31, "timestamp": "01:30:10", "text": "谢谢。放独木舟里。"}, {"type": "subtitle", "time": 5419.99, "timestamp": "01:30:19", "text": "就像这样。我想是的，你"}, {"type": "subtitle", "time": 5434.31, "timestamp": "01:30:34", "text": "好的。好的，各位。我一会儿就回来。我得去参加。"}, {"type": "subtitle", "time": 5440.629, "timestamp": "01:30:40", "text": "家里出了点急事，所以暂时离开一下。我会回来的。不过，呃，好好"}, {"type": "subtitle", "time": 5444.31, "timestamp": "01:30:44", "text": "享受吧。好的，我先把静音打开。"}, {"type": "subtitle", "time": 5445.75, "timestamp": "01:30:45", "text": "呃，"}, {"type": "subtitle", "time": 5448.229, "timestamp": "01:30:48", "text": "我什么都不喜欢。之后我就把它关掉了"}, {"type": "subtitle", "time": 5450.229, "timestamp": "01:30:50", "text": "。"}, {"type": "subtitle", "time": 5453.03, "timestamp": "01:30:53", "text": "不过，呃，你可以好好享受他们的"}, {"type": "subtitle", "time": 5455.91, "timestamp": "01:30:55", "text": "对话等等。我会回来的。好的。"}, {"type": "subtitle", "time": 5458.47, "timestamp": "01:30:58", "text": "感觉既生气又难过，因为这"}, {"type": "subtitle", "time": 5459.88, "timestamp": "01:30:59", "text": "是真的。"}]
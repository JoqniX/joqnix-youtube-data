[{"type": "subtitle", "time": 3605.66, "timestamp": "01:00:05", "text": "抱歉。不，继续。"}, {"type": "subtitle", "time": 3613.589, "timestamp": "01:00:13", "text": "那里好像有人。是"}, {"type": "subtitle", "time": 3615.51, "timestamp": "01:00:15", "text": "的，那些肯定是"}, {"type": "subtitle", "time": 3618.069, "timestamp": "01:00:18", "text": "我刚才看到的恶魔。虽然我并不"}, {"type": "subtitle", "time": 3622.15, "timestamp": "01:00:22", "text": "认为他们"}, {"type": "subtitle", "time": 3623.99, "timestamp": "01:00:23", "text": "至少会攻击我们，因为那里有个"}, {"type": "subtitle", "time": 3627.03, "timestamp": "01:00:27", "text": "竞技场，"}, {"type": "subtitle", "time": 3630.789, "timestamp": "01:00:30", "text": "他们应该会进去。所以，嗯，"}, {"type": "subtitle", "time": 3633.51, "timestamp": "01:00:33", "text": "希望这"}, {"type": "subtitle", "time": 3634.87, "timestamp": "01:00:34", "text": "意味着，"}, {"type": "subtitle", "time": 3637.589, "timestamp": "01:00:37", "text": "如果我们不攻击他们，他们不会盲目地攻击我们。"}, {"type": "subtitle", "time": 3639.589, "timestamp": "01:00:39", "text": "也许还可以问问对方的情况"}, {"type": "subtitle", "time": 3640.47, "timestamp": "01:00:40", "text": "。"}, {"type": "subtitle", "time": 3640.789, "timestamp": "01:00:40", "text": "是的。"}, {"type": "subtitle", "time": 3642.39, "timestamp": "01:00:42", "text": "我们必须在……战斗吗？ 竞技场？"}, {"type": "subtitle", "time": 3644.309, "timestamp": "01:00:44", "text": "不是吧？我们之前不是说让"}, {"type": "subtitle", "time": 3645.829, "timestamp": "01:00:45", "text": "对方先打吗？这样他们"}, {"type": "subtitle", "time": 3646.95, "timestamp": "01:00:46", "text": "就能在我们休息的时候处理这​​一层了"}, {"type": "subtitle", "time": 3648.23, "timestamp": "01:00:48", "text": "？"}, {"type": "subtitle", "time": 3650.789, "timestamp": "01:00:50", "text": "嗯，我们得问问。我们不知道。"}, {"type": "subtitle", "time": 3654.95, "timestamp": "01:00:54", "text": "谁知道他们是不是死了？"}, {"type": "subtitle", "time": 3656.789, "timestamp": "01:00:56", "text": "他们可能死了。"}]
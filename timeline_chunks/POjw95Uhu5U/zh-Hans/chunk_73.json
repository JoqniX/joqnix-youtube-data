[{"type": "subtitle", "time": 4382.95, "timestamp": "01:13:02", "text": "，嗯，我们"}, {"type": "subtitle", "time": 4389.27, "timestamp": "01:13:09", "text": "上次碰巧运气不错，得到了一笔不小的财富。 我们很幸运收到了这么"}, {"type": "subtitle", "time": 4391.35, "timestamp": "01:13:11", "text": "多好东西。"}, {"type": "subtitle", "time": 4392.47, "timestamp": "01:13:12", "text": "我懂了。 我懂了。"}, {"type": "subtitle", "time": 4394.07, "timestamp": "01:13:14", "text": "你可以，你可以看到她就像，"}, {"type": "subtitle", "time": 4395.83, "timestamp": "01:13:15", "text": "你知道，就像她掏出"}, {"type": "subtitle", "time": 4397.75, "timestamp": "01:13:17", "text": "火球魔杖一样，但她就像，"}, {"type": "subtitle", "time": 4399.83, "timestamp": "01:13:19", "text": "她就像，她不像 ... 感觉"}, {"type": "subtitle", "time": 4402.47, "timestamp": "01:13:22", "text": "她更像是在"}, {"type": "subtitle", "time": 4403.75, "timestamp": "01:13:23", "text": "炫耀。"}, {"type": "subtitle", "time": 4405.03, "timestamp": "01:13:25", "text": "嗯。"}, {"type": "subtitle", "time": 4410.229, "timestamp": "01:13:30", "text": "他能分辨出来。 他能分辨出来。 他就像“嗯”了一声。"}, {"type": "subtitle", "time": 4414.79, "timestamp": "01:13:34", "text": "呃，我碰巧发现了这个，"}, {"type": "subtitle", "time": 4416.31, "timestamp": "01:13:36", "text": "她要……她要拿出……"}, {"type": "subtitle", "time": 4418.47, "timestamp": "01:13:38", "text": "呃……我不知道……哦，它不在我的"}, {"type": "subtitle", "time": 4419.83, "timestamp": "01:13:39", "text": "库存里，但"}, {"type": "subtitle", "time": 4422.47, "timestamp": "01:13:42", "text": "我上次拿走了。 自然、自然的"}, {"type": "subtitle", "time": 4425.669, "timestamp": "01:13:45", "text": "披风、自然的披风以及整个"}, {"type": "subtitle", "time": 4427.669, "timestamp": "01:13:47", "text": "人卷轴也是如此。   是的"}, {"type": "subtitle", "time": 4429.669, "timestamp": "01:13:49", "text": "。 是的。 所以她会"}, {"type": "subtitle", "time": 4431.43, "timestamp": "01:13:51", "text": "拿出自然披风，然后说"}, {"type": "subtitle", "time": 4435.75, "timestamp": "01:13:55", "text": "，我想你们"}, {"type": "subtitle", "time": 4439.35, "timestamp": "01:13:59", "text": "那边的德鲁伊可以用上这个。"}, {"type": "subtitle", "time": 4439.83, "timestamp": "01:13:59", "text": "哦，"}]
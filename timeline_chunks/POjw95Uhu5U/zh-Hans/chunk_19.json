[{"type": "subtitle", "time": 1140.63, "timestamp": "00:19:00", "text": "我的天啊。"}, {"type": "subtitle", "time": 1143.11, "timestamp": "00:19:03", "text": "狂热的批评声。"}, {"type": "subtitle", "time": 1146.07, "timestamp": "00:19:06", "text": "那就应该是12个了。"}, {"type": "subtitle", "time": 1148.789, "timestamp": "00:19:08", "text": "然后我再次发起进攻。 我只是觉得"}, {"type": "subtitle", "time": 1150.39, "timestamp": "00:19:10", "text": "好玩才这么做的。"}, {"type": "subtitle", "time": 1158.63, "timestamp": "00:19:18", "text": "如果你能弄到"}, {"type": "subtitle", "time": 1161.11, "timestamp": "00:19:21", "text": "那种把暴击阈"}, {"type": "subtitle", "time": 1163.59, "timestamp": "00:19:23", "text": "值降到19的东西，那就太逆天了。那简直爽爆了"}, {"type": "subtitle", "time": 1166.23, "timestamp": "00:19:26", "text": "。"}, {"type": "subtitle", "time": 1177.35, "timestamp": "00:19:37", "text": "这个故事的寓意是，卡米拉需要"}, {"type": "subtitle", "time": 1179.83, "timestamp": "00:19:39", "text": "做好万全准备，以应对她"}, {"type": "subtitle", "time": 1184.71, "timestamp": "00:19:44", "text": "最终跌倒的情况。   是的"}, {"type": "subtitle", "time": 1187.75, "timestamp": "00:19:47", "text": "，兄弟。 如果只是像"}, {"type": "subtitle", "time": 1189.669, "timestamp": "00:19:49", "text": "Bing Ball 那样，像个巫师一样，"}, {"type": "subtitle", "time": 1191.35, "timestamp": "00:19:51", "text": "你可能就能像退出一样"}, {"type": "subtitle", "time": 1194.63, "timestamp": "00:19:54", "text": "退出。 但就像蕾一样，你一旦"}, {"type": "subtitle", "time": 1196.23, "timestamp": "00:19:56", "text": "尝试什么，她就会"}, {"type": "subtitle", "time": 1198.549, "timestamp": "00:19:58", "text": "立刻反击，然后从"}]
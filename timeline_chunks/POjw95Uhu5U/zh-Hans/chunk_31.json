[{"type": "subtitle", "time": 1862.48, "timestamp": "00:31:02", "text": "。 哦，"}, {"type": "subtitle", "time": 1875.269, "timestamp": "00:31:15", "text": "别发疯。 一切都很好。   是的"}, {"type": "subtitle", "time": 1877.35, "timestamp": "00:31:17", "text": "。 是的。 确切地。"}, {"type": "subtitle", "time": 1880.23, "timestamp": "00:31:20", "text": "一切都很好。"}, {"type": "subtitle", "time": 1881.83, "timestamp": "00:31:21", "text": "确实。"}, {"type": "subtitle", "time": 1883.909, "timestamp": "00:31:23", "text": "不会有任何问题。 这又不是"}, {"type": "subtitle", "time": 1885.669, "timestamp": "00:31:25", "text": "两个人跟"}, {"type": "subtitle", "time": 1886.79, "timestamp": "00:31:26", "text": "植物说话。"}, {"type": "subtitle", "time": 1888.389, "timestamp": "00:31:28", "text": "[音乐]"}, {"type": "subtitle", "time": 1891.269, "timestamp": "00:31:31", "text": "正是如此。 就像一切都很正常一样。"}, {"type": "subtitle", "time": 1893.35, "timestamp": "00:31:33", "text": "废话。   是的"}, {"type": "subtitle", "time": 1894.87, "timestamp": "00:31:34", "text": "。 你难道不跟你的植物说话吗？ 我"}, {"type": "subtitle", "time": 1897.11, "timestamp": "00:31:37", "text": "跟我的植物说话。"}, {"type": "subtitle", "time": 1899.43, "timestamp": "00:31:39", "text": "我连计划都没有，因为我的"}, {"type": "subtitle", "time": 1901.509, "timestamp": "00:31:41", "text": "大拇指很不好。   我"}, {"type": "subtitle", "time": 1903.75, "timestamp": "00:31:43", "text": "夸奖我的仙人掌的次数比"}, {"type": "subtitle", "time": 1905.75, "timestamp": "00:31:45", "text": "夸奖我的朋友的次数还多。"}, {"type": "subtitle", "time": 1908.31, "timestamp": "00:31:48", "text": "兄弟，如果真有哪个"}, {"type": "subtitle", "time": 1910.47, "timestamp": "00:31:50", "text": "词能形容“"}, {"type": "subtitle", "time": 1912.23, "timestamp": "00:31:52", "text": "园艺白痴”的反义词，那我就是了。"}]
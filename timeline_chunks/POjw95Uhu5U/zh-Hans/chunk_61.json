[{"type": "subtitle", "time": 3660.309, "timestamp": "01:01:00", "text": "他们也可能死了，你知道的。谁知道呢"}, {"type": "subtitle", "time": 3662.23, "timestamp": "01:01:02", "text": "。有时候那些家伙根本"}, {"type": "subtitle", "time": 3663.75, "timestamp": "01:01:03", "text": "不会思考。"}, {"type": "subtitle", "time": 3664.87, "timestamp": "01:01:04", "text": "好吧。好的。"}, {"type": "subtitle", "time": 3667.51, "timestamp": "01:01:07", "text": "当你……当你……所以，是的，"}, {"type": "subtitle", "time": 3669.51, "timestamp": "01:01:09", "text": "当你……哦，等等。哦，"}, {"type": "subtitle", "time": 3671.19, "timestamp": "01:01:11", "text": "这里还有一些人。呃哦，"}, {"type": "subtitle", "time": 3672.549, "timestamp": "01:01:12", "text": "等等。哦，你一定是"}, {"type": "subtitle", "time": 3674.63, "timestamp": "01:01:14", "text": "对方说的那个人。哦，"}, {"type": "subtitle", "time": 3676.63, "timestamp": "01:01:16", "text": "是的。是的。我们现在其实已经……我们其实已经……我们其实已经……我们其实已经……"}, {"type": "subtitle", "time": 3679.119, "timestamp": "01:01:19", "text": "我们其实已经…… 因为已经有人通关"}, {"type": "subtitle", "time": 3682.079, "timestamp": "01:01:22", "text": "因为已经有人通关 竞技场了。所以，你们真是……"}, {"type": "subtitle", "time": 3686.079, "timestamp": "01:01:26", "text": "竞技场了。所以，你们真是…… 好吧。你真是太好了。"}, {"type": "subtitle", "time": 3692.39, "timestamp": "01:01:32", "text": "我猜他们没死。"}, {"type": "subtitle", "time": 3694.71, "timestamp": "01:01:34", "text": "什么？什么？格林说了什么？"}, {"type": "subtitle", "time": 3696.63, "timestamp": "01:01:36", "text": "他们是不是把你们的存货都杀光了"}, {"type": "subtitle", "time": 3703.109, "timestamp": "01:01:43", "text": "嗯，嗯，其实没有。 他们真的"}, {"type": "subtitle", "time": 3705.91, "timestamp": "01:01:45", "text": "好像……呃……让我们的"}, {"type": "subtitle", "time": 3708.95, "timestamp": "01:01:48", "text": "生意火爆起来了。我的天哪。"}, {"type": "subtitle", "time": 3711.349, "timestamp": "01:01:51", "text": "把该死的股票市场从"}, {"type": "subtitle", "time": 3714.63, "timestamp": "01:01:54", "text": "该死的欧米茄奶牛场拿走。买多少股票？买多少？买多少"}, {"type": "subtitle", "time": 3718.789, "timestamp": "01:01:58", "text": "股票？"}]
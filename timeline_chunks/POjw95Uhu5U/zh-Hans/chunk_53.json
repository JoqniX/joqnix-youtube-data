[{"type": "subtitle", "time": 3184.87, "timestamp": "00:53:04", "text": "用大脑思考。 该死。"}, {"type": "subtitle", "time": 3187.99, "timestamp": "00:53:07", "text": "某种程度上来说，"}, {"type": "subtitle", "time": 3190.79, "timestamp": "00:53:10", "text": "这个政党至少在"}, {"type": "subtitle", "time": 3197.03, "timestamp": "00:53:17", "text": "做某事之前会考虑其行为的道德性。"}, {"type": "subtitle", "time": 3199.75, "timestamp": "00:53:19", "text": "你的行为会带来后果。"}, {"type": "subtitle", "time": 3202.309, "timestamp": "00:53:22", "text": "不，不，不。 这场聚会就是"}, {"type": "subtitle", "time": 3204.069, "timestamp": "00:53:24", "text": "你行为的后果。 另一个"}, {"type": "subtitle", "time": 3207.829, "timestamp": "00:53:27", "text": "戏仿对象是你的“是的”的交叉部分"}, {"type": "subtitle", "time": 3209.75, "timestamp": "00:53:29", "text": "。   我的"}, {"type": "subtitle", "time": 3211.27, "timestamp": "00:53:31", "text": "天哪。"}, {"type": "subtitle", "time": 3213.829, "timestamp": "00:53:33", "text": "我想我不需要增强能力，"}, {"type": "subtitle", "time": 3215.829, "timestamp": "00:53:35", "text": "对吧？ 我做的修复工作较少。"}, {"type": "subtitle", "time": 3217.67, "timestamp": "00:53:37", "text": "你可能不需要那个。"}, {"type": "subtitle", "time": 3217.99, "timestamp": "00:53:37", "text": "好的。"}, {"type": "subtitle", "time": 3220.39, "timestamp": "00:53:40", "text": "我的意思是，它或许有用，"}, {"type": "subtitle", "time": 3222.79, "timestamp": "00:53:42", "text": "但"}, {"type": "subtitle", "time": 3227.03, "timestamp": "00:53:47", "text": "我觉得这真的有点看情况。 因为"}, {"type": "subtitle", "time": 3228.87, "timestamp": "00:53:48", "text": "这要视情况而定，因为它会"}, {"type": "subtitle", "time": 3232.47, "timestamp": "00:53:52", "text": "消耗一个法术位，而法术位很"}, {"type": "subtitle", "time": 3233.91, "timestamp": "00:53:53", "text": "宝贵。   是"}, {"type": "subtitle", "time": 3236.67, "timestamp": "00:53:56", "text": "啊，那些东西太珍贵了。"}, {"type": "subtitle", "time": 3239.349, "timestamp": "00:53:59", "text": "[音乐]"}]
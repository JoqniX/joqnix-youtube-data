[{"type": "subtitle", "time": 3000.63, "timestamp": "00:50:00", "text": "蓝色的。"}, {"type": "subtitle", "time": 3003.589, "timestamp": "00:50:03", "text": "有很多不错的选择适合"}, {"type": "subtitle", "time": 3004.79, "timestamp": "00:50:04", "text": "你。"}, {"type": "subtitle", "time": 3005.67, "timestamp": "00:50:05", "text": "嗯。   是的"}, {"type": "subtitle", "time": 3009.67, "timestamp": "00:50:09", "text": "。 德鲁伊真是太他妈"}, {"type": "subtitle", "time": 3011.829, "timestamp": "00:50:11", "text": "酷了。 是的。"}, {"type": "subtitle", "time": 3014.15, "timestamp": "00:50:14", "text": "我的天哪。 我记得我有个"}, {"type": "subtitle", "time": 3015.75, "timestamp": "00:50:15", "text": "玩家玩的是德鲁伊，他有"}, {"type": "subtitle", "time": 3018.87, "timestamp": "00:50:18", "text": "加热金属的能力，我记得当时"}, {"type": "subtitle", "time": 3020.63, "timestamp": "00:50:20", "text": "他要和"}, {"type": "subtitle", "time": 3022.549, "timestamp": "00:50:22", "text": "一个骑士类型的角色战斗，然后他"}, {"type": "subtitle", "time": 3028.79, "timestamp": "00:50:28", "text": "通过加热那个可怜的家伙"}, {"type": "subtitle", "time": 3030.71, "timestamp": "00:50:30", "text": "身上与他"}, {"type": "subtitle", "time": 3035.109, "timestamp": "00:50:35", "text": "身体融合的金属来折磨他。 这太残忍了。   当然"}, {"type": "subtitle", "time": 3037.91, "timestamp": "00:50:37", "text": "。"}, {"type": "subtitle", "time": 3041.27, "timestamp": "00:50:41", "text": "乔，关于德鲁伊，你最应该知道的一点是，"}, {"type": "subtitle", "time": 3043.19, "timestamp": "00:50:43", "text": "关于德鲁伊的普遍误解是他们是"}, {"type": "subtitle", "time": 3045.67, "timestamp": "00:50:45", "text": "纵火犯，信奉自然。"}, {"type": "subtitle", "time": 3047.109, "timestamp": "00:50:47", "text": "确切地。   是的"}, {"type": "subtitle", "time": 3048.47, "timestamp": "00:50:48", "text": "。 这就是为什么会有"}, {"type": "subtitle", "time": 3051.109, "timestamp": "00:50:51", "text": "野火德鲁伊分支天赋"}, {"type": "subtitle", "time": 3052.79, "timestamp": "00:50:52", "text": "树爱好者的原因。 他们拥有"}, {"type": "subtitle", "time": 3054.87, "timestamp": "00:50:54", "text": "数量可疑的火焰魔法。   是的"}, {"type": "subtitle", "time": 3056.63, "timestamp": "00:50:56", "text": "。"}, {"type": "subtitle", "time": 3058.39, "timestamp": "00:50:58", "text": "没关系。 他们这是在玩反版的《老雷斯的故事》"}]
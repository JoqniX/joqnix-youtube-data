[{"type": "subtitle", "time": 7501.91, "timestamp": "02:05:01", "text": "有利な点を稼いでいるだけだ。 ちなみに、あなたは損傷箇所をドリルで特定していません"}, {"type": "subtitle", "time": 7507.35, "timestamp": "02:05:07", "text": "ダメージを受けるのは普通のことですよね？ ええ"}, {"type": "subtitle", "time": 7509.99, "timestamp": "02:05:09", "text": "、普通ですよ。 うん。"}, {"type": "subtitle", "time": 7511.669, "timestamp": "02:05:11", "text": "そしてその後、"}, {"type": "subtitle", "time": 7513.91, "timestamp": "02:05:13", "text": "不意打ちダメージを判定します。"}, {"type": "subtitle", "time": 7517.99, "timestamp": "02:05:17", "text": "こっそり1を出す。"}, {"type": "subtitle", "time": 7519.83, "timestamp": "02:05:19", "text": "不意打ちダメージ。"}, {"type": "subtitle", "time": 7520.39, "timestamp": "02:05:20", "text": "はい。"}, {"type": "subtitle", "time": 7524.31, "timestamp": "02:05:24", "text": "不意打ちダメージ。 そして、それに"}, {"type": "subtitle", "time": 7526.229, "timestamp": "02:05:26", "text": "あなたの盗賊レベルを加えると、"}, {"type": "subtitle", "time": 7528.95, "timestamp": "02:05:28", "text": "6になります。"}, {"type": "subtitle", "time": 7531.669, "timestamp": "02:05:31", "text": "うん。 よし。 それは3d6です。 わかった。  16"}, {"type": "subtitle", "time": 7533.109, "timestamp": "02:05:33", "text": "プラス6。 よし。 それを適用してみます"}, {"type": "subtitle", "time": 7534.55, "timestamp": "02:05:34", "text": "。"}, {"type": "subtitle", "time": 7536.31, "timestamp": "02:05:36", "text": "6. えっと、ちょっと待って。"}, {"type": "subtitle", "time": 7538.95, "timestamp": "02:05:38", "text": "ヘビ。 奇襲攻撃はあらゆる攻撃に適用されるのか"}, {"type": "subtitle", "time": 7540.229, "timestamp": "02:05:40", "text": "？   いや"}, {"type": "subtitle", "time": 7541.83, "timestamp": "02:05:41", "text": "、違うよ。 これは攻撃の最初の事例に過ぎない"}, {"type": "subtitle", "time": 7543.99, "timestamp": "02:05:43", "text": "。 持続する。"}, {"type": "subtitle", "time": 7546.149, "timestamp": "02:05:46", "text": "ああ、1ターンに1回だ。 ああ、わかりました。  1ターンに1回"}, {"type": "subtitle", "time": 7547.35, "timestamp": "02:05:47", "text": "。   1ターンに"}, {"type": "subtitle", "time": 7549.83, "timestamp": "02:05:49", "text": "1回。 わかった。 よし。 それから"}, {"type": "subtitle", "time": 7552.07, "timestamp": "02:05:52", "text": "マイナスを計算します。 持続する。"}, {"type": "subtitle", "time": 7554.79, "timestamp": "02:05:54", "text": "えっと、マイナス6点。 ああ、6個必要なんですよね？   わかった"}, {"type": "subtitle", "time": 7556.39, "timestamp": "02:05:56", "text": "。  6点。"}, {"type": "subtitle", "time": 7557.99, "timestamp": "02:05:57", "text": "ええと、暗殺です。   よし"}]
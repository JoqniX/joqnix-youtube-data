[{"type": "subtitle", "time": 1623.59, "timestamp": "00:27:03", "text": "その部品に反発を起こさないような代替品。"}, {"type": "subtitle", "time": 1626.549, "timestamp": "00:27:06", "text": "彼らはユーモアのセンスが良ければいいのだが。   あらら。"}, {"type": "subtitle", "time": 1630.549, "timestamp": "00:27:10", "text": "うん。 公平に言うと、"}, {"type": "subtitle", "time": 1632.39, "timestamp": "00:27:12", "text": "私が考えていたもう一つの方法は、"}, {"type": "subtitle", "time": 1637.75, "timestamp": "00:27:17", "text": "ドラゴンレディであるヴァロリアを連れてくることです。"}, {"type": "subtitle", "time": 1640.39, "timestamp": "00:27:20", "text": "彼女をドラゴンボーンに変えればいい。"}, {"type": "subtitle", "time": 1643.669, "timestamp": "00:27:23", "text": "ええ、彼女は聖騎士です。   さあ行こう"}, {"type": "subtitle", "time": 1645.909, "timestamp": "00:27:25", "text": "。 暑い方。"}, {"type": "subtitle", "time": 1649.43, "timestamp": "00:27:29", "text": "暑い方。   まあ。   ああ"}, {"type": "subtitle", "time": 1652.71, "timestamp": "00:27:32", "text": "、まさに私たちがそのキャラクターだ。"}, {"type": "subtitle", "time": 1655.11, "timestamp": "00:27:35", "text": "知っている。 ライは少し遅れるかもしれない。"}, {"type": "subtitle", "time": 1658.789, "timestamp": "00:27:38", "text": "はい。 大丈夫。 ルディはいつでも「"}, {"type": "subtitle", "time": 1665.909, "timestamp": "00:27:45", "text": "うん。 でも、でも、あなたはハンを忘れていると思います。"}, {"type": "subtitle", "time": 1667.43, "timestamp": "00:27:47", "text": "ルディと何かをするときはいつも、"}, {"type": "subtitle", "time": 1669.35, "timestamp": "00:27:49", "text": "遅刻するのは彼女の方だ。"}, {"type": "subtitle", "time": 1671.59, "timestamp": "00:27:51", "text": "少なくともあなたと私と彼女がいるとき。   いつも"}, {"type": "subtitle", "time": 1674.31, "timestamp": "00:27:54", "text": "遅刻したり、"}, {"type": "subtitle", "time": 1676.31, "timestamp": "00:27:56", "text": "ゲームのインストールを忘れたりするのは彼女の方だ。   何てことだ"}, {"type": "subtitle", "time": 1678.47, "timestamp": "00:27:58", "text": "。 何てことだ。 忘れてたけど、私とふざけてたのを覚えてる"}]
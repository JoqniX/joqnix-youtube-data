[{"type": "subtitle", "time": 2341.109, "timestamp": "00:39:01", "text": "？ ええ、前のレビューの通り、"}, {"type": "subtitle", "time": 2343.51, "timestamp": "00:39:03", "text": "これはとても良いですね。"}, {"type": "subtitle", "time": 2350.71, "timestamp": "00:39:10", "text": "呪文の魔法。"}, {"type": "subtitle", "time": 2351.589, "timestamp": "00:39:11", "text": "うん。"}, {"type": "subtitle", "time": 2357.349, "timestamp": "00:39:17", "text": "他の人たちにとっても、それは本当に本当に必要だと思う。 他に"}, {"type": "subtitle", "time": 2358.87, "timestamp": "00:39:18", "text": "本当に必要なものは何だろうか？"}, {"type": "subtitle", "time": 2361.589, "timestamp": "00:39:21", "text": "小規模な修復ということだろうか。"}, {"type": "subtitle", "time": 2364.47, "timestamp": "00:39:24", "text": "ええ、それもかなり便利ですね。"}, {"type": "subtitle", "time": 2368.47, "timestamp": "00:39:28", "text": "アリアナがすでにEightidを持っていると思うので、もうEightidは必要ないと思います。"}, {"type": "subtitle", "time": 2369.829, "timestamp": "00:39:29", "text": "ええ、アリアナも8人いますよ。"}, {"type": "subtitle", "time": 2371.91, "timestamp": "00:39:31", "text": "そして、魔法の道具も詰めておきました。 ええ、"}, {"type": "subtitle", "time": 2372.79, "timestamp": "00:39:32", "text": "8個入りパックで持っています。"}, {"type": "subtitle", "time": 2374.069, "timestamp": "00:39:34", "text": "アリアナは8匹飼っているが、いつも"}, {"type": "subtitle", "time": 2375.27, "timestamp": "00:39:35", "text": "準備万端だ。 だから、そういうものはない方が断然"}, {"type": "subtitle", "time": 2377.27, "timestamp": "00:39:37", "text": "いい。"}, {"type": "subtitle", "time": 2379.99, "timestamp": "00:39:39", "text": "ええ、私も自然とそういう風に考えています"}, {"type": "subtitle", "time": 2382.87, "timestamp": "00:39:42", "text": "。 だから、それは必要ありません"}, {"type": "subtitle", "time": 2384.55, "timestamp": "00:39:44", "text": "。"}, {"type": "subtitle", "time": 2386.71, "timestamp": "00:39:46", "text": "他のものを入れても構いません。"}, {"type": "subtitle", "time": 2389.589, "timestamp": "00:39:49", "text": "ああ、持っていません。わかりました、持っていません。 わかった。"}, {"type": "subtitle", "time": 2391.67, "timestamp": "00:39:51", "text": "便利なオプションがたくさんある一方で、"}, {"type": "subtitle", "time": 2398.47, "timestamp": "00:39:58", "text": "スカイライトのような面白いオプションもたくさんある。 拡大縮小は、"}]
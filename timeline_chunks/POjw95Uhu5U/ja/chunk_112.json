[{"type": "subtitle", "time": 6725.83, "timestamp": "01:52:05", "text": "確かに驚きです。"}, {"type": "subtitle", "time": 6728.13, "timestamp": "01:52:08", "text": "ええ。"}, {"type": "subtitle", "time": 6729.99, "timestamp": "01:52:09", "text": "[音楽]"}, {"type": "subtitle", "time": 6732.55, "timestamp": "01:52:12", "text": "つまり、技術的には、も実行されます"}, {"type": "subtitle", "time": 6734.39, "timestamp": "01:52:14", "text": "電話中だけど、爆発しそうだ。"}, {"type": "subtitle", "time": 6735.83, "timestamp": "01:52:15", "text": "うん、そういう意味だよ。"}, {"type": "subtitle", "time": 6737.189, "timestamp": "01:52:17", "text": "爆発しそうだ。"}, {"type": "subtitle", "time": 6738.149, "timestamp": "01:52:18", "text": "爆発しないと思う。爆発するなんて、"}, {"type": "subtitle", "time": 6742.229, "timestamp": "01:52:22", "text": "そんなの爆発するからいい考えじゃないと思う。"}, {"type": "subtitle", "time": 6743.03, "timestamp": "01:52:23", "text": "ああ。"}, {"type": "subtitle", "time": 6751.99, "timestamp": "01:52:31", "text": "ああ、Kaはゲームに参加してるの？ でも、うん、"}, {"type": "subtitle", "time": 6758.229, "timestamp": "01:52:38", "text": "やり方がわからない。ああ"}, {"type": "subtitle", "time": 6760.47, "timestamp": "01:52:40", "text": "、そこにいた。"}, {"type": "subtitle", "time": 6763.03, "timestamp": "01:52:43", "text": "まず2つのことをしないといけない。"}, {"type": "subtitle", "time": 6766.55, "timestamp": "01:52:46", "text": "オフにしないといけない。"}, {"type": "subtitle", "time": 6768.629, "timestamp": "01:52:48", "text": "ああ、うん。オーケー。じゃあ"}, {"type": "subtitle", "time": 6770.39, "timestamp": "01:52:50", "text": "、オーケー。"}, {"type": "subtitle", "time": 6773.669, "timestamp": "01:52:53", "text": "前の設定に戻ろう。"}, {"type": "subtitle", "time": 6775.55, "timestamp": "01:52:55", "text": "うん。"}, {"type": "subtitle", "time": 6777.91, "timestamp": "01:52:57", "text": "[音楽]"}, {"type": "subtitle", "time": 6779.91, "timestamp": "01:52:59", "text": "オーケー、一番重要な"}]
[{"type": "subtitle", "time": 2100.31, "timestamp": "00:35:00", "text": "年長者に相談してください。 それはめちゃくちゃ奇妙な"}, {"type": "subtitle", "time": 2102.31, "timestamp": "00:35:02", "text": "トリックだ。   まさか"}, {"type": "subtitle", "time": 2115.75, "timestamp": "00:35:15", "text": "それが"}, {"type": "subtitle", "time": 2117.51, "timestamp": "00:35:17", "text": "何か関係していたのか、それとも単に彼らが私の気をそらそうとしていただけなのか、よくわかりません"}, {"type": "subtitle", "time": 2122.15, "timestamp": "00:35:22", "text": "。"}, {"type": "subtitle", "time": 2123.67, "timestamp": "00:35:23", "text": "もしこれらすべてがあなたを苦しめているとしたら、どう思うだろうか"}, {"type": "subtitle", "time": 2124.95, "timestamp": "00:35:24", "text": "。"}, {"type": "subtitle", "time": 2128.55, "timestamp": "00:35:28", "text": "それは今や、私の大切な記憶となっている。 それは間違いない。"}, {"type": "subtitle", "time": 2129.91, "timestamp": "00:35:29", "text": "うん。   何てことだ"}, {"type": "subtitle", "time": 2131.99, "timestamp": "00:35:31", "text": "。 喉に刺さった二つ目のチップだ"}, {"type": "subtitle", "time": 2132.63, "timestamp": "00:35:32", "text": "。   何てことだ"}, {"type": "subtitle", "time": 2134.79, "timestamp": "00:35:34", "text": "。 君は死ぬだろう。"}, {"type": "subtitle", "time": 2137.19, "timestamp": "00:35:37", "text": "私は、"}, {"type": "subtitle", "time": 2138.15, "timestamp": "00:35:38", "text": "このチップスとの最後の人生を送っています。"}, {"type": "subtitle", "time": 2139.99, "timestamp": "00:35:39", "text": "そのポテトチップスは君を殺すだろう。   でも、"}, {"type": "subtitle", "time": 2142.95, "timestamp": "00:35:42", "text": "めちゃくちゃ良かったよ。"}, {"type": "subtitle", "time": 2144.63, "timestamp": "00:35:44", "text": "もしここで死ぬとしても、少なくともあなたはここで"}, {"type": "subtitle", "time": 2147.51, "timestamp": "00:35:47", "text": "楽しい時間を過ごしながら死ぬでしょう。"}, {"type": "subtitle", "time": 2149.109, "timestamp": "00:35:49", "text": "そうそう。 えっと、"}, {"type": "subtitle", "time": 2156.23, "timestamp": "00:35:56", "text": "英語って何て言うんだっけ、思い出させてください。 ええと、呪文の準備です。   ああ"}, {"type": "subtitle", "time": 2159.19, "timestamp": "00:35:59", "text": "、呪文の準備を忘れないでください。それから、"}]
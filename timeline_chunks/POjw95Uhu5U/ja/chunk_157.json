[{"type": "subtitle", "time": 9423.51, "timestamp": "02:37:03", "text": "、こんなに金貨が。 何てことだ"}, {"type": "subtitle", "time": 9425.67, "timestamp": "02:37:05", "text": "。 あなたは手に入れた。あなたは手に入れなかった。あなたは"}, {"type": "subtitle", "time": 9428.87, "timestamp": "02:37:08", "text": "運が悪い。 そこからそれだけの量の金が見つかったんですね。"}, {"type": "subtitle", "time": 9430.63, "timestamp": "02:37:10", "text": "自分？ クリスです。 彼は不運だ。"}, {"type": "subtitle", "time": 9432.389, "timestamp": "02:37:12", "text": "クリシン。 ええ、クリシンはそれだけの量の金を見つけたんです"}, {"type": "subtitle", "time": 9433.91, "timestamp": "02:37:13", "text": "。   まるで"}, {"type": "subtitle", "time": 9435.51, "timestamp": "02:37:15", "text": "彫像を眺めているようだった。"}, {"type": "subtitle", "time": 9436.389, "timestamp": "02:37:16", "text": "彼はこう言うだろう。「何？"}, {"type": "subtitle", "time": 9439.11, "timestamp": "02:37:19", "text": "ここで何を見つけたんだ？"}, {"type": "subtitle", "time": 9440.79, "timestamp": "02:37:20", "text": "これはどうだ？何があったんだ？"}, {"type": "subtitle", "time": 9442.389, "timestamp": "02:37:22", "text": "何かすごいものを見つけたのか？」 クリスインが開けると、"}, {"type": "subtitle", "time": 9446.87, "timestamp": "02:37:26", "text": "中には「はい、どうぞ」と入っていました。 金貨55枚"}, {"type": "subtitle", "time": 9447.429, "timestamp": "02:37:27", "text": "入り。"}, {"type": "subtitle", "time": 9449.99, "timestamp": "02:37:29", "text": "えっと、クリスピンが"}, {"type": "subtitle", "time": 9452.87, "timestamp": "02:37:32", "text": "あなたが探している金塊の一部を見つけたかもしれないと思います。"}, {"type": "subtitle", "time": 9456.55, "timestamp": "02:37:36", "text": "ああ、それは良いことだ。"}, {"type": "subtitle", "time": 9458.389, "timestamp": "02:37:38", "text": "ええ、"}, {"type": "subtitle", "time": 9462.389, "timestamp": "02:37:42", "text": "彼女が知らないから、厄介な金泥棒がうろついているんです。"}, {"type": "subtitle", "time": 9463.59, "timestamp": "02:37:43", "text": "彼女はクローゼットが何なのか知らないと思います"}, {"type": "subtitle", "time": 9466.23, "timestamp": "02:37:46", "text": "。"}, {"type": "subtitle", "time": 9468.07, "timestamp": "02:37:48", "text": "ロータスはそうするかもしれないが、彼女はそうしない。"}, {"type": "subtitle", "time": 9468.87, "timestamp": "02:37:48", "text": "よし、"}, {"type": "subtitle", "time": 9479.99, "timestamp": "02:37:59", "text": "歴史か生存について言うと思う。"}]
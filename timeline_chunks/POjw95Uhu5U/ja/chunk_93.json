[{"type": "subtitle", "time": 5580.709, "timestamp": "01:33:00", "text": "また同じ人の巨大な像だね"}, {"type": "subtitle", "time": 5583.91, "timestamp": "01:33:03", "text": "？たくさんの像があって、"}, {"type": "subtitle", "time": 5586.79, "timestamp": "01:33:06", "text": "武器は全部金でできてる。そして"}, {"type": "subtitle", "time": 5588.55, "timestamp": "01:33:08", "text": "最後の一つは、像全体が"}, {"type": "subtitle", "time": 5589.59, "timestamp": "01:33:09", "text": "金でできてる。"}, {"type": "subtitle", "time": 5590.709, "timestamp": "01:33:10", "text": "やばい、この辺りには"}, {"type": "subtitle", "time": 5593.11, "timestamp": "01:33:13", "text": "金がいっぱいある。たぶん、"}, {"type": "subtitle", "time": 5595.35, "timestamp": "01:33:15", "text": "クリスプを片付けてるんだろう"}, {"type": "subtitle", "time": 5597.35, "timestamp": "01:33:17", "text": "。あれは何？わかった"}, {"type": "subtitle", "time": 5599.27, "timestamp": "01:33:19", "text": "。同じ人の同じ像が、まるで筋肉を誇示するように頭を下げてる"}, {"type": "subtitle", "time": 5601.51, "timestamp": "01:33:21", "text": "。"}, {"type": "subtitle", "time": 5604.95, "timestamp": "01:33:24", "text": "ああ、ドアだ。もちろん、この下の"}, {"type": "subtitle", "time": 5609.91, "timestamp": "01:33:29", "text": "どこかにドアがある。"}, {"type": "subtitle", "time": 5611.189, "timestamp": "01:33:31", "text": "アリアナはもう一度像を見る"}, {"type": "subtitle", "time": 5613.669, "timestamp": "01:33:33", "text": "。 偵察。"}, {"type": "subtitle", "time": 5616.149, "timestamp": "01:33:36", "text": "ええ、クリセンは偵察しているだけです。彼はただ何が起きているかを"}, {"type": "subtitle", "time": 5616.95, "timestamp": "01:33:36", "text": "見ているだけです"}, {"type": "subtitle", "time": 5619.189, "timestamp": "01:33:39", "text": "。これらの像は見覚えがあります"}, {"type": "subtitle", "time": 5629.11, "timestamp": "01:33:49", "text": "。以前にも見たことがあるような気がします。見ましたよね。入り口で見ましたよね。気づきましたよね。わかりました。ここは、このゴミ箱のようなものです。ここには像があります"}, {"type": "subtitle", "time": 5633.669, "timestamp": "01:33:53", "text": "。でも、ここは、この"}, {"type": "subtitle", "time": 5636.39, "timestamp": "01:33:56", "text": "部屋全体が圧倒的に暑いです。真ん中にあるのは"}, {"type": "subtitle", "time": 5638.229, "timestamp": "01:33:58", "text": "噴水で、"}]
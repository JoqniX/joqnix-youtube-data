[{"type": "subtitle", "time": 5462.149, "timestamp": "01:31:02", "text": "[音楽]"}, {"type": "subtitle", "time": 5464.55, "timestamp": "01:31:04", "text": "君は彼らのことを気にかけない。だから"}, {"type": "subtitle", "time": 5466.07, "timestamp": "01:31:06", "text": "彼らはあんなにハイなんだ。だから"}, {"type": "subtitle", "time": 5467.75, "timestamp": "01:31:07", "text": "彼らは私の中であんなにハイなんだ。"}, {"type": "subtitle", "time": 5469.43, "timestamp": "01:31:09", "text": "わかる？"}, {"type": "subtitle", "time": 5471.189, "timestamp": "01:31:11", "text": "ああ、なんてことだ。彼の"}, {"type": "subtitle", "time": 5473.669, "timestamp": "01:31:13", "text": "父親、彼女の父親が撃ったのであって、"}, {"type": "subtitle", "time": 5476.229, "timestamp": "01:31:16", "text": "私の父親じゃない。うん。うん。うん"}, {"type": "subtitle", "time": 5478.229, "timestamp": "01:31:18", "text": "。待って、待って、待って。まず、"}, {"type": "subtitle", "time": 5480.55, "timestamp": "01:31:20", "text": "クリス・クイーンを忘れた。うん、"}, {"type": "subtitle", "time": 5483.99, "timestamp": "01:31:23", "text": "この床に下ろすつもりだ。この"}, {"type": "subtitle", "time": 5486.629, "timestamp": "01:31:26", "text": "床はずっと少ない。"}, {"type": "subtitle", "time": 5488.31, "timestamp": "01:31:28", "text": "冷たくなる。上の床は"}, {"type": "subtitle", "time": 5490.709, "timestamp": "01:31:30", "text": "アリーナだからちょっと熱かったし、"}, {"type": "subtitle", "time": 5493.43, "timestamp": "01:31:33", "text": "うん、君は 冷たい大理石。"}, {"type": "subtitle", "time": 5495.189, "timestamp": "01:31:35", "text": "本当に、ここはまだ"}, {"type": "subtitle", "time": 5498.55, "timestamp": "01:31:38", "text": "何かしら熱い感じがする。どういうわけか"}, {"type": "subtitle", "time": 5500.95, "timestamp": "01:31:40", "text": "暑いんだけど、大理石は"}, {"type": "subtitle", "time": 5502.47, "timestamp": "01:31:42", "text": "本当に冷たい。金属の床も"}, {"type": "subtitle", "time": 5504.629, "timestamp": "01:31:44", "text": "すごく冷たい。クリステンが"}, {"type": "subtitle", "time": 5506.149, "timestamp": "01:31:46", "text": "こっちに行くと、たくさんの像がある"}, {"type": "subtitle", "time": 5508.79, "timestamp": "01:31:48", "text": "。すべての像は同じ人物を描いている"}, {"type": "subtitle", "time": 5510.39, "timestamp": "01:31:50", "text": "。小人だ。そしてそれぞれが"}, {"type": "subtitle", "time": 5512.149, "timestamp": "01:31:52", "text": "違う武器を持っている。"}, {"type": "subtitle", "time": 5515.27, "timestamp": "01:31:55", "text": "剣、斧、槍、そして…待って、"}, {"type": "subtitle", "time": 5517.91, "timestamp": "01:31:57", "text": "最後のは何？ちょっと待って"}]
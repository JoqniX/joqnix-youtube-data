[{"type": "subtitle", "time": 5942.709, "timestamp": "01:39:02", "text": "えっと、"}, {"type": "subtitle", "time": 5944.229, "timestamp": "01:39:04", "text": "トークンが動いていないみたいだ。"}, {"type": "subtitle", "time": 5946.07, "timestamp": "01:39:06", "text": "え、何？ちょっと待って。私にさせてくれ。"}, {"type": "subtitle", "time": 5947.51, "timestamp": "01:39:07", "text": "なぜ"}, {"type": "subtitle", "time": 5949.27, "timestamp": "01:39:09", "text": "私のトークンだと表示されるのか分からない。私のインターネットがどこにあるかだと思う"}, {"type": "subtitle", "time": 5950.47, "timestamp": "01:39:10", "text": "。"}, {"type": "subtitle", "time": 5951.43, "timestamp": "01:39:11", "text": "ああ、そうだね"}, {"type": "subtitle", "time": 5953.189, "timestamp": "01:39:13", "text": "。私のインターネットが"}, {"type": "subtitle", "time": 5954.79, "timestamp": "01:39:14", "text": "釘で叩かれている。"}, {"type": "subtitle", "time": 5956.629, "timestamp": "01:39:16", "text": "私は"}, {"type": "subtitle", "time": 5959.35, "timestamp": "01:39:19", "text": "複数の四角形さえも得ていない。"}, {"type": "subtitle", "time": 5961.59, "timestamp": "01:39:21", "text": "ああ、それはおかしい。ちょっと待って。"}, {"type": "subtitle", "time": 5963.35, "timestamp": "01:39:23", "text": "すぐに交換させてくれ。こうする。よし。"}, {"type": "subtitle", "time": 5966.47, "timestamp": "01:39:26", "text": "私がしようとするたびに選択四角形。だから、"}, {"type": "subtitle", "time": 5968.95, "timestamp": "01:39:28", "text": "私のインターネットだけだと仮定している。"}, {"type": "subtitle", "time": 5977.669, "timestamp": "01:39:37", "text": "それを配信したらどうなるだろう"}, {"type": "subtitle", "time": 5978.55, "timestamp": "01:39:38", "text": "？"}, {"type": "subtitle", "time": 5980.229, "timestamp": "01:39:40", "text": "ええ、まさに。うーん。"}, {"type": "subtitle", "time": 5982.39, "timestamp": "01:39:42", "text": "ええ、鋳造所を再起動すればいいと思います"}, {"type": "subtitle", "time": 5983.109, "timestamp": "01:39:43", "text": "。"}, {"type": "subtitle", "time": 5988.31, "timestamp": "01:39:48", "text": "インターネット全体がそうです。Discordでも同じです"}, {"type": "subtitle", "time": 5991.43, "timestamp": "01:39:51", "text": "。どこから来たのかわかりません"}, {"type": "subtitle", "time": 5994.79, "timestamp": "01:39:54", "text": "。そうです。そうです。ええ。やった。"}]
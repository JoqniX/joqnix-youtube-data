[{"type": "subtitle", "time": 9120.71, "timestamp": "02:32:00", "text": "本気なんです。 話しかけないで。"}, {"type": "subtitle", "time": 9124.389, "timestamp": "02:32:04", "text": "触らないで。 私に話しかけないで。 わかった。 それは、"}, {"type": "subtitle", "time": 9129.99, "timestamp": "02:32:09", "text": "酸を吐き出した後だった。 だから、その前は、半"}, {"type": "subtitle", "time": 9132.55, "timestamp": "02:32:12", "text": "音階の前です。 おお。 うん。"}, {"type": "subtitle", "time": 9135.83, "timestamp": "02:32:15", "text": "うん。 ウィッチボルトの前。 では、ちょっと見てみましょう"}, {"type": "subtitle", "time": 9146.389, "timestamp": "02:32:26", "text": "。 なぜ私たちは一つの行動を起こすのに10年もかかるのだろうか"}, {"type": "subtitle", "time": 9153.75, "timestamp": "02:32:33", "text": "私がこのクソみたいな饒舌な議論を何とか乗り切ろうとしているところ"}, {"type": "subtitle", "time": 9155.51, "timestamp": "02:32:35", "text": "。   何てことだ"}, {"type": "subtitle", "time": 9157.19, "timestamp": "02:32:37", "text": "。"}, {"type": "subtitle", "time": 9160.309, "timestamp": "02:32:40", "text": "ただの吠え声だ。"}, {"type": "subtitle", "time": 9162.309, "timestamp": "02:32:42", "text": "私はおしゃべりが大好きだ。"}, {"type": "subtitle", "time": 9165.03, "timestamp": "02:32:45", "text": "まあ、俺も喋るのは好きだけど、いやー、"}]
[{"type": "subtitle", "time": 8581.91, "timestamp": "02:23:01", "text": "僕じゃない。"}, {"type": "subtitle", "time": 8585.59, "timestamp": "02:23:05", "text": "あなたの呪文スロット。 選択はあなた次第です。"}, {"type": "subtitle", "time": 8588.23, "timestamp": "02:23:08", "text": "聞いてくれ、ここでの私の仕事は、いわば一時的な、"}, {"type": "subtitle", "time": 8590.55, "timestamp": "02:23:10", "text": "一時的なリーダーみたいなものなんだ。"}, {"type": "subtitle", "time": 8592.63, "timestamp": "02:23:12", "text": "私は何もしない。"}, {"type": "subtitle", "time": 8594.389, "timestamp": "02:23:14", "text": "まさにリーダーそのもの。   何てことだ"}, {"type": "subtitle", "time": 8595.27, "timestamp": "02:23:15", "text": "。"}, {"type": "subtitle", "time": 8597.03, "timestamp": "02:23:17", "text": "リーダー。 私は何もしていません。"}, {"type": "subtitle", "time": 8598.63, "timestamp": "02:23:18", "text": "ザッパっぽいね。   まあ。"}, {"type": "subtitle", "time": 8602.469, "timestamp": "02:23:22", "text": "マネージャーのようですね。"}, {"type": "subtitle", "time": 8607.99, "timestamp": "02:23:27", "text": "うん。  CE Oh。 はい。 我が神よ。   まあ。 わかった"}, {"type": "subtitle", "time": 8614.07, "timestamp": "02:23:34", "text": "いやあ、だんだん共通点が見えてきたぞ"}, {"type": "subtitle", "time": 8615.42, "timestamp": "02:23:35", "text": "。"}, {"type": "subtitle", "time": 8617.429, "timestamp": "02:23:37", "text": "[音楽]"}, {"type": "subtitle", "time": 8619.19, "timestamp": "02:23:39", "text": "ダメージ。 あなたは攻撃と言いましたね"}, {"type": "subtitle", "time": 8626.87, "timestamp": "02:23:46", "text": "。"}, {"type": "subtitle", "time": 8628.389, "timestamp": "02:23:48", "text": "それは残念だった。"}, {"type": "subtitle", "time": 8630.95, "timestamp": "02:23:50", "text": "呪文スロットが1つ減った。"}, {"type": "subtitle", "time": 8632.55, "timestamp": "02:23:52", "text": "私のインスピレーションを活用してください。 自分のインスピレーションを活かしてみたらどうだろう"}, {"type": "subtitle", "time": 8635.27, "timestamp": "02:23:55", "text": "？ はい、可能です。   あなた"}, {"type": "subtitle", "time": 8636.63, "timestamp": "02:23:56", "text": "の情報を使用できます。"}, {"type": "subtitle", "time": 8637.83, "timestamp": "02:23:57", "text": "もう一度攻撃ロールをして
[{"type": "subtitle", "time": 3060.79, "timestamp": "00:51:00", "text": "逆ロラックスをやっているだけだ。 大丈夫です。"}, {"type": "subtitle", "time": 3063.03, "timestamp": "00:51:03", "text": "ロラックスを逆にしたような作品。"}, {"type": "subtitle", "time": 3065.51, "timestamp": "00:51:05", "text": "はい。 そうですね、"}, {"type": "subtitle", "time": 3067.27, "timestamp": "00:51:07", "text": "特にここオーストラリアには、"}, {"type": "subtitle", "time": 3070.309, "timestamp": "00:51:10", "text": "火事によって繁殖する樹木がいくつかあることを覚えておいてください。"}, {"type": "subtitle", "time": 3071.67, "timestamp": "00:51:11", "text": "彼らはまるで、"}, {"type": "subtitle", "time": 3074.39, "timestamp": "00:51:14", "text": "木の処刑における裁判官や陪審員のようだ。"}, {"type": "subtitle", "time": 3078.309, "timestamp": "00:51:18", "text": "木は周囲のものをすべて殺して、さらに木自体も殺すと、より良く育つというのは、かなり一般的で、よく知られていることだと思います"}, {"type": "subtitle", "time": 3082.87, "timestamp": "00:51:22", "text": "。"}, {"type": "subtitle", "time": 3084.39, "timestamp": "00:51:24", "text": "うん。"}, {"type": "subtitle", "time": 3091.75, "timestamp": "00:51:31", "text": "。 実際、"}, {"type": "subtitle", "time": 3094.309, "timestamp": "00:51:34", "text": "農園ではそうしているんです。というのも、私は以前農場に住んでいて、"}, {"type": "subtitle", "time": 3097.67, "timestamp": "00:51:37", "text": "収穫が終わるたびに小"}, {"type": "subtitle", "time": 3100.87, "timestamp": "00:51:40", "text": "麦畑全体を燃やしていたんです。"}, {"type": "subtitle", "time": 3103.19, "timestamp": "00:51:43", "text": "ええと、それは実際、畑にとってとても良いことです"}, {"type": "subtitle", "time": 3105.19, "timestamp": "00:51:45", "text": "。"}, {"type": "subtitle", "time": 3106.71, "timestamp": "00:51:46", "text": "こちらでは、それを「"}, {"type": "subtitle", "time": 3108.71, "timestamp": "00:51:48", "text": "鳥を休ませる」と表現する。"}, {"type": "subtitle", "time": 3110.15, "timestamp": "00:51:50", "text": "地球を休ませる。"}, {"type": "subtitle", "time": 3113.349, "timestamp": "00:51:53", "text": "うん。 それらを燃やすことによって。"}, {"type": "subtitle", "time": 3116.309, "timestamp": "00:51:56", "text": "焦土を焼き尽くせ。"}, {"type": "subtitle", "time": 3117.349, "timestamp": "00:51:57", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 3119.99, "timestamp": "00:51:59", "text": "うん。"}]
[{"type": "subtitle", "time": 1862.48, "timestamp": "00:31:02", "text": "。 ああ、"}, {"type": "subtitle", "time": 1875.269, "timestamp": "00:31:15", "text": "ない。 すべて順調です。"}, {"type": "subtitle", "time": 1877.35, "timestamp": "00:31:17", "text": "うん。 うん。 その通り。"}, {"type": "subtitle", "time": 1880.23, "timestamp": "00:31:20", "text": "すべて全く問題ありません。"}, {"type": "subtitle", "time": 1881.83, "timestamp": "00:31:21", "text": "絶対に。"}, {"type": "subtitle", "time": 1883.909, "timestamp": "00:31:23", "text": "問題は何も起こらないだろう。 まるで"}, {"type": "subtitle", "time": 1885.669, "timestamp": "00:31:25", "text": "二人の人間が植物に話しかけているような状況じゃない"}, {"type": "subtitle", "time": 1886.79, "timestamp": "00:31:26", "text": "。"}, {"type": "subtitle", "time": 1888.389, "timestamp": "00:31:28", "text": "[音楽]"}, {"type": "subtitle", "time": 1891.269, "timestamp": "00:31:31", "text": "その通り。 まるでそれが普通のことであるかのように。"}, {"type": "subtitle", "time": 1893.35, "timestamp": "00:31:33", "text": "当たり前だろ。"}, {"type": "subtitle", "time": 1894.87, "timestamp": "00:31:34", "text": "うん。 あなたは植物に話しかけたりしないのですか？ 私は"}, {"type": "subtitle", "time": 1897.11, "timestamp": "00:31:37", "text": "植物に話しかけます。   私は"}, {"type": "subtitle", "time": 1901.509, "timestamp": "00:31:41", "text": "親指の状態がひどいので、計画を立てることすらできません。"}, {"type": "subtitle", "time": 1903.75, "timestamp": "00:31:43", "text": "私は"}, {"type": "subtitle", "time": 1905.75, "timestamp": "00:31:45", "text": "友達を褒めるよりもサボテンを褒める方が多い。   なあ"}, {"type": "subtitle", "time": 1908.31, "timestamp": "00:31:48", "text": "、もし「"}, {"type": "subtitle", "time": 1912.23, "timestamp": "00:31:52", "text": "園芸が得意じゃない」っていう言葉があったら、それはまさに俺のことだよ。"}]
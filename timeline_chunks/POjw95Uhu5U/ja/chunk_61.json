[{"type": "subtitle", "time": 3662.23, "timestamp": "01:01:02", "text": "わからない。 時々、彼らは"}, {"type": "subtitle", "time": 3663.75, "timestamp": "01:01:03", "text": "本当に考えていない。 わかった。 わかった。"}, {"type": "subtitle", "time": 3667.51, "timestamp": "01:01:07", "text": "行くとき。 うん、"}, {"type": "subtitle", "time": 3669.51, "timestamp": "01:01:09", "text": "行くとき、 ああ、待って。 ああ、ここにもっと"}, {"type": "subtitle", "time": 3671.19, "timestamp": "01:01:11", "text": "人がいる。 ああ、"}, {"type": "subtitle", "time": 3672.549, "timestamp": "01:01:12", "text": "待って。 ああ、あなたが"}, {"type": "subtitle", "time": 3674.63, "timestamp": "01:01:14", "text": "他のチームが話していた人でしょう。 ああ、"}, {"type": "subtitle", "time": 3676.63, "timestamp": "01:01:16", "text": "そう。 うん。 実は、私たちは、"}, {"type": "subtitle", "time": 3682.069, "timestamp": "01:01:22", "text": "誰かがすでに"}, {"type": "subtitle", "time": 3686.069, "timestamp": "01:01:26", "text": "アリーナをクリアしたので、今はかなり近いところにいる。 だから、あなたたちは"}, {"type": "subtitle", "time": 3688.63, "timestamp": "01:01:28", "text": "すごい。 わかった。"}, {"type": "subtitle", "time": 3690.63, "timestamp": "01:01:30", "text": "それはとても親切だね。"}, {"type": "subtitle", "time": 3692.39, "timestamp": "01:01:32", "text": "彼らは死んでいないと思う。"}, {"type": "subtitle", "time": 3694.71, "timestamp": "01:01:34", "text": "何？ 何？ グリムは何て言ったの？"}, {"type": "subtitle", "time": 3696.63, "timestamp": "01:01:36", "text": "奴らは君の株を全部潰したとか"}, {"type": "subtitle", "time": 3703.109, "timestamp": "01:01:43", "text": "いや、そうでもない。実際は、奴らは、私たちの"}, {"type": "subtitle", "time": 3708.95, "timestamp": "01:01:48", "text": "ビジネスを大成功させたんだ。 なんてこった。"}, {"type": "subtitle", "time": 3714.63, "timestamp": "01:01:54", "text": "オメガミルカーズから株式市場を奪い取ってくれ。"}, {"type": "subtitle", "time": 3718.789, "timestamp": "01:01:58", "text": "株を買うのにいくらかかるんだ？ チクタク"}]
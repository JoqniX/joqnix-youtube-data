[{"type": "subtitle", "time": 7803.91, "timestamp": "02:10:03", "text": "ボーナスアクションとか、自分のターンに他に何かできることってある？ 私は既にそれを使っています"}, {"type": "subtitle", "time": 7804.149, "timestamp": "02:10:04", "text": "。"}, {"type": "subtitle", "time": 7805.75, "timestamp": "02:10:05", "text": "ボーナスアクションを使って2回"}, {"type": "subtitle", "time": 7807.43, "timestamp": "02:10:07", "text": "目の攻撃を行うんですよね"}, {"type": "subtitle", "time": 7810.95, "timestamp": "02:10:10", "text": "？ わかった。 えっと、やめます。 私は"}, {"type": "subtitle", "time": 7814.55, "timestamp": "02:10:14", "text": "好きで、私は好きで、私は好きで、終わります。   わかった"}, {"type": "subtitle", "time": 7817.75, "timestamp": "02:10:17", "text": "。 よし。"}, {"type": "subtitle", "time": 7821.35, "timestamp": "02:10:21", "text": "ちょっとこの「ブープ」をやらせてください。 ああ、わかった。 私にやらせてください"}, {"type": "subtitle", "time": 7824.629, "timestamp": "02:10:24", "text": "。 よし。 では、ちょっと待ってください"}, {"type": "subtitle", "time": 7828.629, "timestamp": "02:10:28", "text": "。 えっと、どこにあるんですか？ ああ、"}, {"type": "subtitle", "time": 7829.99, "timestamp": "02:10:29", "text": "テンプレートみたいなものはないんですね。"}, {"type": "subtitle", "time": 7831.589, "timestamp": "02:10:31", "text": "それでは、早速テンプレートを作成しましょう。 よし"}, {"type": "subtitle", "time": 7833.91, "timestamp": "02:10:33", "text": "。 えっと、ちょっと待ってください"}, {"type": "subtitle", "time": 7835.91, "timestamp": "02:10:35", "text": "。  15フィートではない場所はどこですか？"}, {"type": "subtitle", "time": 7839.189, "timestamp": "02:10:39", "text": "15フィート離れたらどこですか。"}, {"type": "subtitle", "time": 7841.51, "timestamp": "02:10:41", "text": "15. はい、どうぞ。  15フィート。 わかった。 ああ、今になってようやく気づいたんだね"}, {"type": "subtitle", "time": 7844.069, "timestamp": "02:10:44", "text": "。 わかった。"}, {"type": "subtitle", "time": 7845.99, "timestamp": "02:10:45", "text": "ちょっとこうやってずらしてみます。 はい、どうぞ"}, {"type": "subtitle", "time": 7848.55, "timestamp": "02:10:48", "text": "。 そっちの方がずっといい。 わかった。   なんてこった。"}, {"type": "subtitle", "time": 7852.149, "timestamp": "02:10:52", "text": "よし、全員コーンの中に入れ。"}, {"type": "subtitle", "time": 7854.149, "timestamp": "02:10:54", "text": "デッキ上で安全。   私を"}, {"type": "subtitle", "time": 7854.87, "timestamp": "02:10:54", "text": "殺して。   わかった"}, {"type": "subtitle", "time": 7856.069, "timestamp": "02:10:56", "text": "。"}, {"type": "subtitle", "time": 7858.149, "timestamp": "02:10:58", "text": "私はコーンの中にいますか？ 私には分かりません。"}, {"type": "subtitle", "time": 7859.27, "timestamp": "02:10:59", "text": "あなたはそこにいません。それは"}]
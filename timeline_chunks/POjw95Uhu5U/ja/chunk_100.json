[{"type": "subtitle", "time": 6003.51, "timestamp": "01:40:03", "text": "よし。"}, {"type": "subtitle", "time": 6005.109, "timestamp": "01:40:05", "text": "像を見てみたい。ちょっと見てみたいだけです"}, {"type": "subtitle", "time": 6006.55, "timestamp": "01:40:06", "text": "。わかりました"}, {"type": "subtitle", "time": 6009.03, "timestamp": "01:40:09", "text": "。えっと、どんな風に見るんですか？ただ見たいだけですか、それとも"}, {"type": "subtitle", "time": 6011.51, "timestamp": "01:40:11", "text": "調査したいですか？何か"}, {"type": "subtitle", "time": 6012.709, "timestamp": "01:40:12", "text": "変なところがないか見てみましょう。"}, {"type": "subtitle", "time": 6013.99, "timestamp": "01:40:13", "text": "ああ、そうです。調査します。例えば、"}, {"type": "subtitle", "time": 6017.83, "timestamp": "01:40:17", "text": "これは何か"}, {"type": "subtitle", "time": 6019.91, "timestamp": "01:40:19", "text": "理由があって金色になっているのか？彼女が"}, {"type": "subtitle", "time": 6020.79, "timestamp": "01:40:20", "text": "見ているのはそれだと思います。わかりました"}, {"type": "subtitle", "time": 6023.109, "timestamp": "01:40:23", "text": "。調査できますか？わかりました。"}, {"type": "subtitle", "time": 6025.03, "timestamp": "01:40:25", "text": "ステファンの調査は完了しました。"}, {"type": "subtitle", "time": 6027.03, "timestamp": "01:40:27", "text": "クリスピンの調査も必要です"}, {"type": "subtitle", "time": 6028.07, "timestamp": "01:40:28", "text": "。"}, {"type": "subtitle", "time": 6030.39, "timestamp": "01:40:30", "text": "わかりました。ああ、クリスピンの中にいるんですね。わかりました。では、"}, {"type": "subtitle", "time": 6035.75, "timestamp": "01:40:35", "text": "これは本当に憂鬱です。憂鬱なので、"}, {"type": "subtitle", "time": 6037.03, "timestamp": "01:40:37", "text": "実際にお見せします"}, {"type": "subtitle", "time": 6038.629, "timestamp": "01:40:38", "text": "。これは"}, {"type": "subtitle", "time": 6041.99, "timestamp": "01:40:41", "text": "エスタンです。これはアリアナです。そしてこれは"}, {"type": "subtitle", "time": 6045.75, "timestamp": "01:40:45", "text": "クリスピンです。わかりました。イニシアチブを振ってください。"}, {"type": "subtitle", "time": 6046.55, "timestamp": "01:40:46", "text": "ああ。"}, {"type": "subtitle", "time": 6047.669, "timestamp": "01:40:47", "text": "ああ、いや。くそ。"}, {"type": "subtitle", "time": 6051.99, "timestamp": "01:40:51", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 6053.669, "timestamp": "01:40:53", "text": "わかった。このイニシアチブは、"}, {"type": "subtitle", "time": 6055.43, "timestamp": "01:40:55", "text": "私がやろう。よし。"}, {"type": "subtitle", "time": 6058.709, "timestamp": "01:40:58", "text": "ああ、人生は最悪だ。わかった"}]
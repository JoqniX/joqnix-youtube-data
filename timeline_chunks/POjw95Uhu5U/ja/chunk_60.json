[{"type": "subtitle", "time": 3605.66, "timestamp": "01:00:05", "text": "いや、進め。"}, {"type": "subtitle", "time": 3613.589, "timestamp": "01:00:13", "text": "そこに男たちがいるようだ。"}, {"type": "subtitle", "time": 3615.51, "timestamp": "01:00:15", "text": "うん、あれは間違いなく"}, {"type": "subtitle", "time": 3618.069, "timestamp": "01:00:18", "text": "少し前に見た悪魔たちだ。でも"}, {"type": "subtitle", "time": 3619.91, "timestamp": "01:00:19", "text": "実際には、"}, {"type": "subtitle", "time": 3622.15, "timestamp": "01:00:22", "text": "少なくとも"}, {"type": "subtitle", "time": 3623.99, "timestamp": "01:00:23", "text": "攻撃してこないと思う。少なくとも、彼らが中に入るはずの"}, {"type": "subtitle", "time": 3627.03, "timestamp": "01:00:27", "text": "何らかのアリーナがあるからだ"}, {"type": "subtitle", "time": 3630.789, "timestamp": "01:00:30", "text": "。だから、うまくいけば、私たちが"}, {"type": "subtitle", "time": 3637.589, "timestamp": "01:00:37", "text": "攻撃しなくても、彼らが盲目的に攻撃してこないことを願う。"}, {"type": "subtitle", "time": 3639.589, "timestamp": "01:00:39", "text": "他のことについても聞いてみようかな。"}, {"type": "subtitle", "time": 3640.47, "timestamp": "01:00:40", "text": "パーティー。"}, {"type": "subtitle", "time": 3640.789, "timestamp": "01:00:40", "text": "うん。"}, {"type": "subtitle", "time": 3642.39, "timestamp": "01:00:42", "text": "アリーナで戦わないといけないの？ なかったよね？ だから"}, {"type": "subtitle", "time": 3644.309, "timestamp": "01:00:44", "text": "言ったんじゃないの？ だから"}, {"type": "subtitle", "time": 3645.829, "timestamp": "01:00:45", "text": "他のパーティーが先に進んで、私たちが休んでいる"}, {"type": "subtitle", "time": 3646.95, "timestamp": "01:00:46", "text": "間にこのフロアを片付けたんじゃないの"}, {"type": "subtitle", "time": 3648.23, "timestamp": "01:00:48", "text": "？"}, {"type": "subtitle", "time": 3650.789, "timestamp": "01:00:50", "text": "まあ、聞かないといけないね。 わからないし、わからない"}, {"type": "subtitle", "time": 3653.349, "timestamp": "01:00:53", "text": "。"}, {"type": "subtitle", "time": 3656.789, "timestamp": "01:00:56", "text": "彼らが死んでいるかどうかはわからない。 死んでいるかもしれない。 死んでいる可能性もあるよ。"}]
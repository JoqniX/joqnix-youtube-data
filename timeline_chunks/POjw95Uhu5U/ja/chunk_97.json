[{"type": "subtitle", "time": 5821.35, "timestamp": "01:37:01", "text": "パーティーの全員は少なくとも0か、"}, {"type": "subtitle", "time": 5824.39, "timestamp": "01:37:04", "text": "0かマイナス1の強さを持っている。"}, {"type": "subtitle", "time": 5824.87, "timestamp": "01:37:04", "text": "ああ、ちょっと見てみよう"}, {"type": "subtitle", "time": 5826.79, "timestamp": "01:37:06", "text": "。ティックは0の"}, {"type": "subtitle", "time": 5829.35, "timestamp": "01:37:09", "text": "強さ。ヴァンは0の強さ。ジョックは0の強さ。"}, {"type": "subtitle", "time": 5832.55, "timestamp": "01:37:12", "text": "ホナは"}, {"type": "subtitle", "time": 5835.83, "timestamp": "01:37:15", "text": "マイナス1の強さ。"}, {"type": "subtitle", "time": 5838.47, "timestamp": "01:37:18", "text": "イアナだけが文字通りできるんだ。 多分"}, {"type": "subtitle", "time": 5842.709, "timestamp": "01:37:22", "text": "これを取ろうとするだろう。"}, {"type": "subtitle", "time": 5844.39, "timestamp": "01:37:24", "text": "頭はいいが、筋肉が足りない"}, {"type": "subtitle", "time": 5851.03, "timestamp": "01:37:31", "text": "ああ。えっと、ハナンが、もし"}, {"type": "subtitle", "time": 5853.669, "timestamp": "01:37:33", "text": "これらを何とか取ることができたら、"}, {"type": "subtitle", "time": 5855.669, "timestamp": "01:37:35", "text": "取り出せると言っていた。"}, {"type": "subtitle", "time": 5859.59, "timestamp": "01:37:39", "text": "このゲームで誰がそんな力を持っているんだ？"}, {"type": "subtitle", "time": 5862.39, "timestamp": "01:37:42", "text": "君たちが方法を見つけたら。メイン。"}, {"type": "subtitle", "time": 5864.31, "timestamp": "01:37:44", "text": "ここにあるメインの像だけが"}, {"type": "subtitle", "time": 5865.35, "timestamp": "01:37:45", "text": "金色なのか、それとも"}, {"type": "subtitle", "time": 5867.59, "timestamp": "01:37:47", "text": "4体の像のうち"}, {"type": "subtitle", "time": 5869.27, "timestamp": "01:37:49", "text": "武器だけが金色で、メインの"}, {"type": "subtitle", "time": 5870.95, "timestamp": "01:37:50", "text": "像は見たところ完全に金色なのか"}, {"type": "subtitle", "time": 5872.149, "timestamp": "01:37:52", "text": "。少なくとも、それが私の"}, {"type": "subtitle", "time": 5873.83, "timestamp": "01:37:53", "text": "金のプレートなのか、それとも本当に"}, {"type": "subtitle", "time": 5875.59, "timestamp": "01:37:55", "text": "純金なのかは分からない。"}, {"type": "subtitle", "time": 5878.39, "timestamp": "01:37:58", "text": "まるで、これらの金の武器を取っているように聞こえる"}]
[{"type": "subtitle", "time": 4443.669, "timestamp": "01:14:03", "text": "それは本当だ。 それは確かにその通りです。   それはまるで、"}, {"type": "subtitle", "time": 4445.91, "timestamp": "01:14:05", "text": "みんなと同じような見た目だ。"}, {"type": "subtitle", "time": 4457.91, "timestamp": "01:14:17", "text": "カミラ。 カミラ。"}, {"type": "subtitle", "time": 4460.39, "timestamp": "01:14:20", "text": "カミラが何を望んでいるのか、私には分かっていると思う。 私はただ、「"}, {"type": "subtitle", "time": 4462.55, "timestamp": "01:14:22", "text": "もしあなたが私に100万"}, {"type": "subtitle", "time": 4467.99, "timestamp": "01:14:27", "text": "ドルの少額の融資をしてくれるなら」と言っただけです。"}, {"type": "subtitle", "time": 4470.31, "timestamp": "01:14:30", "text": "その通り。 うん。 はい。 いいえ。100"}, {"type": "subtitle", "time": 4473.03, "timestamp": "01:14:33", "text": "万ドルです。"}, {"type": "subtitle", "time": 4475.27, "timestamp": "01:14:35", "text": "いえ、いいえ。 彼女は「ええ、もしあなたが『たぶん』と答えてくれるとしたら"}, {"type": "subtitle", "time": 4483.99, "timestamp": "01:14:43", "text": "それはいくらくらいの価値があるの？」という感じでした。"}, {"type": "subtitle", "time": 4485.189, "timestamp": "01:14:45", "text": "はい、もう一度確認させてください。"}, {"type": "subtitle", "time": 4486.149, "timestamp": "01:14:46", "text": "実は、ゲームの"}, {"type": "subtitle", "time": 4488.39, "timestamp": "01:14:48", "text": "インベントリも追加するつもりです。   それはいくらの"}, {"type": "subtitle", "time": 4492.95, "timestamp": "01:14:52", "text": "価値があるのでしょうか？"}, {"type": "subtitle", "time": 4495.83, "timestamp": "01:14:55", "text": "これっていくらくらいの価値があるの？"}, {"type": "subtitle", "time": 4498.149, "timestamp": "01:14:58", "text": "ああ、神様。 えっと、ちょっと待ってください。"}]
[{"type": "subtitle", "time": 3960.95, "timestamp": "01:06:00", "text": "ああ、なんてこと。二人の悪魔はみんな、"}, {"type": "subtitle", "time": 3968.23, "timestamp": "01:06:08", "text": "パパは"}, {"type": "subtitle", "time": 3972.87, "timestamp": "01:06:12", "text": "カミラの…」って感じで、まあ、私は一度も…あなたたちって本当に"}, {"type": "subtitle", "time": 3976.39, "timestamp": "01:06:16", "text": "恥ずべき人たちね。"}, {"type": "subtitle", "time": 3978.549, "timestamp": "01:06:18", "text": "家族が"}, {"type": "subtitle", "time": 3980.23, "timestamp": "01:06:20", "text": "君に悪いことを言ったって言ってるの？ああ、それは本当に最悪だったに違いない"}, {"type": "subtitle", "time": 3984.95, "timestamp": "01:06:24", "text": "ああ、"}, {"type": "subtitle", "time": 4006.71, "timestamp": "01:06:46", "text": "なんてこと。チックには絶対にできない。チックには絶対にできない [音楽] カミラ、子供と戦うのはやめなさい。子供ってどういう意味？あれはせいぜい獣だよ。ここにも獣がいるとしたら、この戦いもチクチクする。チケットは、努力もせずに"}, {"type": "subtitle", "time": 4008.23, "timestamp": "01:06:48", "text": "戦いと戦争に同時に勝利している"}, {"type": "subtitle", "time": 4014.95, "timestamp": "01:06:54", "text": "まあ、どうでもいいけど"}, {"type": "subtitle", "time": 4017.99, "timestamp": "01:06:57", "text": "。とにかく早く済ませて、"}]
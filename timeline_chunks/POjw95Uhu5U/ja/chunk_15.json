[{"type": "subtitle", "time": 902.629, "timestamp": "00:15:02", "text": "ニースはどこにあるの？ そんな表現は、私たちのことを"}, {"type": "subtitle", "time": 910.389, "timestamp": "00:15:10", "text": "。"}, {"type": "subtitle", "time": 915.75, "timestamp": "00:15:15", "text": "私たちはとても親切で寛大な人々です。"}, {"type": "subtitle", "time": 918.15, "timestamp": "00:15:18", "text": "寛大。"}, {"type": "subtitle", "time": 920.87, "timestamp": "00:15:20", "text": "今日は1分間、放送時間をいただきたいのですが。"}, {"type": "subtitle", "time": 923.03, "timestamp": "00:15:23", "text": "あなたには1分間の放送時間を与えました。 あなたは"}, {"type": "subtitle", "time": 925.43, "timestamp": "00:15:25", "text": "1分間の放送時間を得るに値する人物だった。"}, {"type": "subtitle", "time": 927.11, "timestamp": "00:15:27", "text": "放送時間は1分です。 なんてこった"}, {"type": "subtitle", "time": 928.23, "timestamp": "00:15:28", "text": "。"}, {"type": "subtitle", "time": 931.11, "timestamp": "00:15:31", "text": "うん。 うん。   私にとっては"}, {"type": "subtitle", "time": 932.069, "timestamp": "00:15:32", "text": "。"}, {"type": "subtitle", "time": 934.87, "timestamp": "00:15:34", "text": "見て、見て、ミスター。ここで新鮮な空気を吸えるよ"}, {"type": "subtitle", "time": 937.03, "timestamp": "00:15:37", "text": "。 くそ。"}, {"type": "subtitle", "time": 939.91, "timestamp": "00:15:39", "text": "待って、私のサイコロは"}, {"type": "subtitle", "time": 942.389, "timestamp": "00:15:42", "text": "転がってないの？ 長時間の休息を取ろうとしています。"}, {"type": "subtitle", "time": 944.629, "timestamp": "00:15:44", "text": "ああ、接続が切れました。 どうでも。"}, {"type": "subtitle", "time": 946.389, "timestamp": "00:15:46", "text": "おお。 ああ、それは素晴らしいですね。"}, {"type": "subtitle", "time": 947.509, "timestamp": "00:15:47", "text": "それが理由です。"}, {"type": "subtitle", "time": 949.829, "timestamp": "00:15:49", "text": "ああ、それは素晴らしいですね。"}, {"type": "subtitle", "time": 951.59, "timestamp": "00:15:51", "text": "私は7を出した。"}, {"type": "subtitle", "time": 953.749, "timestamp": "00:15:53", "text": "はい、皆さんゆっくり休んでください。"}, {"type": "subtitle", "time": 954.389, "timestamp": "00:15:54", "text": "うん。"}, {"type": "subtitle", "time": 955.829, "timestamp": "00:15:55", "text": "素晴らしい。"}, {"type": "subtitle", "time": 958.87, "timestamp": "00:15:58", "text": "ヴァンは皮膚を取り戻すことができる。"}]
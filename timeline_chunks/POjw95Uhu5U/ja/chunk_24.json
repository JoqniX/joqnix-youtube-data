[{"type": "subtitle", "time": 1442.39, "timestamp": "00:24:02", "text": "。   いずれ必ず起こるであろう事態に"}, {"type": "subtitle", "time": 1444.31, "timestamp": "00:24:04", "text": "備えているだけです"}, {"type": "subtitle", "time": 1446.95, "timestamp": "00:24:06", "text": "。"}, {"type": "subtitle", "time": 1450.31, "timestamp": "00:24:10", "text": "流血沙汰が待ち遠しい。"}, {"type": "subtitle", "time": 1452.149, "timestamp": "00:24:12", "text": "いつか、充血した状態になる日が来るだろう。 でも、"}, {"type": "subtitle", "time": 1456.31, "timestamp": "00:24:16", "text": "カミラが考えなければならないもう一つのことは、もし彼女が"}, {"type": "subtitle", "time": 1459.669, "timestamp": "00:24:19", "text": "レイを裏切ったら、他のパーティー"}, {"type": "subtitle", "time": 1461.43, "timestamp": "00:24:21", "text": "メンバーも"}, {"type": "subtitle", "time": 1462.95, "timestamp": "00:24:22", "text": "彼女がパーティーを完全に裏切ったと思うだろうということです"}, {"type": "subtitle", "time": 1464.149, "timestamp": "00:24:24", "text": "。"}, {"type": "subtitle", "time": 1466.23, "timestamp": "00:24:26", "text": "確かに、もっともな"}, {"type": "subtitle", "time": 1467.35, "timestamp": "00:24:27", "text": "意見だ。"}, {"type": "subtitle", "time": 1469.59, "timestamp": "00:24:29", "text": "ああ、"}, {"type": "subtitle", "time": 1471.51, "timestamp": "00:24:31", "text": "カミラが嫌いだからパーティーのこと全部忘れちゃったよ。"}, {"type": "subtitle", "time": 1472.07, "timestamp": "00:24:32", "text": "ええ、"}, {"type": "subtitle", "time": 1473.669, "timestamp": "00:24:33", "text": "そうですね。"}, {"type": "subtitle", "time": 1476.149, "timestamp": "00:24:36", "text": "もう一つは、もし"}, {"type": "subtitle", "time": 1479.11, "timestamp": "00:24:39", "text": "ピアノの喧嘩の時のように、"}, {"type": "subtitle", "time": 1482.549, "timestamp": "00:24:42", "text": "カムラだけが勝った場合です。"}, {"type": "subtitle", "time": 1485.909, "timestamp": "00:24:45", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 1488.789, "timestamp": "00:24:48", "text": "問題はないと思います。"}, {"type": "subtitle", "time": 1492.31, "timestamp": "00:24:52", "text": "ピアノの喧嘩みたいに、カミラが"}, {"type": "subtitle", "time": 1495.669, "timestamp": "00:24:55", "text": "何も叩かないような感じなのかって言うのかと思ったよ。   それも"}, {"type": "subtitle", "time": 1497.19, "timestamp": "00:24:57", "text": "正しいと思います。"}, {"type": "subtitle", "time": 1498.71, "timestamp": "00:24:58", "text": "ああ、大丈夫です。 それも"}]
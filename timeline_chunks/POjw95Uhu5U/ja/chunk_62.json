[{"type": "subtitle", "time": 3724.71, "timestamp": "01:02:04", "text": "。ストップ。株式市場に参加するのはやめろ"}, {"type": "subtitle", "time": 3725.43, "timestamp": "01:02:05", "text": "。"}, {"type": "subtitle", "time": 3727.27, "timestamp": "01:02:07", "text": "ああ、"}, {"type": "subtitle", "time": 3732.39, "timestamp": "01:02:12", "text": "後で街で株式市場をチェックした方がいいと思うよ。"}, {"type": "subtitle", "time": 3733.19, "timestamp": "01:02:13", "text": "株式市場。"}, {"type": "subtitle", "time": 3736.39, "timestamp": "01:02:16", "text": "最初に株って言ったよね。"}, {"type": "subtitle", "time": 3737.43, "timestamp": "01:02:17", "text": "株はいくら？"}, {"type": "subtitle", "time": 3738.789, "timestamp": "01:02:18", "text": "わからない。私はただの"}, {"type": "subtitle", "time": 3741.109, "timestamp": "01:02:21", "text": "受付係だから。"}, {"type": "subtitle", "time": 3743.829, "timestamp": "01:02:23", "text": "チクタク、ストップ。ストップ。"}, {"type": "subtitle", "time": 3745.19, "timestamp": "01:02:25", "text": "そんなことはやめろ。"}, {"type": "subtitle", "time": 3746.87, "timestamp": "01:02:26", "text": "君のお母さんも"}, {"type": "subtitle", "time": 3747.829, "timestamp": "01:02:27", "text": "お父さんも知ってるよ。 チクタク。やめろ。"}, {"type": "subtitle", "time": 3749.829, "timestamp": "01:02:29", "text": "チクタク。やめろ"}, {"type": "subtitle", "time": 3754.15, "timestamp": "01:02:34", "text": "。ああ、困った。"}, {"type": "subtitle", "time": 3758.069, "timestamp": "01:02:38", "text": "株式市場の話をするのはやめろ。"}, {"type": "subtitle", "time": 3760.23, "timestamp": "01:02:40", "text": "ねえ、ねえ、デビルマンさん、"}, {"type": "subtitle", "time": 3766.63, "timestamp": "01:02:46", "text": "彼らは「ああ、そうだ、"}, {"type": "subtitle", "time": 3769.43, "timestamp": "01:02:49", "text": "あそこにいるよ」って言うんだ。  「ついてきて。」うん、ついてきて。さあ"}, {"type": "subtitle", "time": 3770.23, "timestamp": "01:02:50", "text": "。"}, {"type": "subtitle", "time": 3772.63, "timestamp": "01:02:52", "text": "よし、友達に会いに行こう。"}, {"type": "subtitle", "time": 3774.069, "timestamp": "01:02:54", "text": "ほら、この男が床をモップで拭いているのが見えるでしょ"}, {"type": "subtitle", "time": 3775.43, "timestamp": "01:02:55", "text": "。"}, {"type": "subtitle", "time": 3777.99, "timestamp": "01:02:57", "text": "友達と話すために。"}]
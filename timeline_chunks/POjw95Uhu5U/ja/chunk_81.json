[{"type": "subtitle", "time": 4862.47, "timestamp": "01:21:02", "text": "聞くのに時間がかかる。 あなたは"}, {"type": "subtitle", "time": 4863.99, "timestamp": "01:21:03", "text": "もっと上達できると思いますか、それともこれが"}, {"type": "subtitle", "time": 4866.07, "timestamp": "01:21:06", "text": "自分の限界だと思いますか？"}, {"type": "subtitle", "time": 4879.51, "timestamp": "01:21:19", "text": "、坊や。 では、"}, {"type": "subtitle", "time": 4881.51, "timestamp": "01:21:21", "text": "私がもっとうまくできると思う、というのはどういう意味ですか"}, {"type": "subtitle", "time": 4882.63, "timestamp": "01:21:22", "text": "？"}, {"type": "subtitle", "time": 4885.76, "timestamp": "01:21:25", "text": "T、君の両親が君にしたようにね。"}, {"type": "subtitle", "time": 4889.59, "timestamp": "01:21:29", "text": "[音楽]"}, {"type": "subtitle", "time": 4892.07, "timestamp": "01:21:32", "text": "ティック、ここで自分で値切れないなら、"}, {"type": "subtitle", "time": 4897.11, "timestamp": "01:21:37", "text": "株式市場がどこにあるかは教えないよ。 町に戻ってきたんですね。"}, {"type": "subtitle", "time": 4900.55, "timestamp": "01:21:40", "text": "株式市場について話すのが待ち遠しい。   わかった"}, {"type": "subtitle", "time": 4903.669, "timestamp": "01:21:43", "text": "。 だから、"}, {"type": "subtitle", "time": 4909.99, "timestamp": "01:21:49", "text": "カミラは「ええと、"}, {"type": "subtitle", "time": 4912.47, "timestamp": "01:21:52", "text": "私の両親が"}, {"type": "subtitle", "time": 4915.35, "timestamp": "01:21:55", "text": "私にしたことは、"}, {"type": "subtitle", "time": 4916.95, "timestamp": "01:21:56", "text": "今の会話とは関係ないと思う」という感じなんです。 でも"}, {"type": "subtitle", "time": 4919.59, "timestamp": "01:21:59", "text": "、いやいや、緑色を選んでください。でも、親は"}]
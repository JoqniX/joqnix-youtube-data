[{"type": "subtitle", "time": 1980.64, "timestamp": "00:33:00", "text": "はっきりそう 言ってくれよ、まるで"}, {"type": "subtitle", "time": 1982.64, "timestamp": "00:33:02", "text": "言ってくれよ、まるで 厳格な教師みたいに。   まあ。"}, {"type": "subtitle", "time": 1998.31, "timestamp": "00:33:18", "text": "。   私たちは"}, {"type": "subtitle", "time": 2000.87, "timestamp": "00:33:20", "text": "皆、とても簡単に気が散ってしまう。"}, {"type": "subtitle", "time": 2002.47, "timestamp": "00:33:22", "text": "うん。  ADHDの症状が出てから30分が経ちました"}, {"type": "subtitle", "time": 2003.59, "timestamp": "00:33:23", "text": "。"}, {"type": "subtitle", "time": 2006.47, "timestamp": "00:33:26", "text": "うん。 うん。 ただ雑談しているだけです。"}, {"type": "subtitle", "time": 2008.63, "timestamp": "00:33:28", "text": "いいえ、もし私がADHDだったらそうは思わないでしょう。でも、もしそうだったとしても、"}, {"type": "subtitle", "time": 2010.07, "timestamp": "00:33:30", "text": "驚きはしないでしょう。"}, {"type": "subtitle", "time": 2012.63, "timestamp": "00:33:32", "text": "うん。 だから、絶対に診断を受けてはいけない。"}, {"type": "subtitle", "time": 2015.19, "timestamp": "00:33:35", "text": "私の場合はすごく面白いんだけど、えっと、自閉症かどうか調べてもらいに医者に行ったら、"}, {"type": "subtitle", "time": 2022.31, "timestamp": "00:33:42", "text": "「ああ、あなたは自閉症じゃないよ。ADHDだよ"}, {"type": "subtitle", "time": 2023.99, "timestamp": "00:33:43", "text": "」って言われたの。 そしてしばらくすると、"}, {"type": "subtitle", "time": 2025.909, "timestamp": "00:33:45", "text": "「ああ、いや、やっぱりいいよ。"}, {"type": "subtitle", "time": 2027.35, "timestamp": "00:33:47", "text": "実は君は自閉症なんだ」と言われるんです。"}, {"type": "subtitle", "time": 2028.71, "timestamp": "00:33:48", "text": "「ああ、気にしないで。実は"}, {"type": "subtitle", "time": 2030.23, "timestamp": "00:33:50", "text": "両方持ってるんだね」って感じだった。 だから彼らはそれに"}, {"type": "subtitle", "time": 2033.269, "timestamp": "00:33:53", "text": "苦労していたのです。 すごいね。 ありがとう。"}, {"type": "subtitle", "time": 2034.71, "timestamp": "00:33:54", "text": "この話は以前にも何人かの人に話したことがあると思うのですが、"}, {"type": "subtitle", "time": 2038.23, "timestamp": "00:33:58", "text": "私がADHDだと分かったきっかけは、"}]
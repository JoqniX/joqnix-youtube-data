[{"type": "subtitle", "time": 4501.189, "timestamp": "01:15:01", "text": "明日輸入するつもりだったんだけど、ちょっと待って。"}, {"type": "subtitle", "time": 4503.51, "timestamp": "01:15:03", "text": "ちょっと手短に説明させてください。 ちょっと待ってください"}, {"type": "subtitle", "time": 4506.229, "timestamp": "01:15:06", "text": "。 もう一度、どんな電話ですか？ ようこそ、"}, {"type": "subtitle", "time": 4509.189, "timestamp": "01:15:09", "text": "天国へ、"}, {"type": "subtitle", "time": 4513.59, "timestamp": "01:15:13", "text": "カスタマーサポートへ。 ご連絡いたしますので、少々お待ちください。"}, {"type": "subtitle", "time": 4521.99, "timestamp": "01:15:21", "text": "私はそういう類のものは持っていません。"}, {"type": "subtitle", "time": 4523.99, "timestamp": "01:15:23", "text": "そうそう。 待って、私、エレベーター"}, {"type": "subtitle", "time": 4525.75, "timestamp": "01:15:25", "text": "ミュージックみたいなの持ってるわ。 まるで"}, {"type": "subtitle", "time": 4532.87, "timestamp": "01:15:32", "text": "エレベーターミュージックなんかじゃない。 エレベーター"}, {"type": "subtitle", "time": 4536.149, "timestamp": "01:15:36", "text": "ミュージックはどこ？ エレベーターミュージックは、ああ、ああ、なんて"}, {"type": "subtitle", "time": 4537.669, "timestamp": "01:15:37", "text": "ことだ。 ああ、見つからない。 はい、どうぞ。"}, {"type": "subtitle", "time": 4545.27, "timestamp": "01:15:45", "text": "ちょっと待ってください。 ちょっと待ってください。 レイクサイドからの単発の"}, {"type": "subtitle", "time": 4548.31, "timestamp": "01:15:48", "text": "電話。"}, {"type": "subtitle", "time": 4551.669, "timestamp": "01:15:51", "text": "一度限りの出来事。 えっと、それは何ですか？ 火の玉。 はい、どうぞ"}, {"type": "subtitle", "time": 4554.55, "timestamp": "01:15:54", "text": "。 わかった。 待って、待って。"}, {"type": "subtitle", "time": 4555.91, "timestamp": "01:15:55", "text": "一体どこで、それが重要になったんだ？"}, {"type": "subtitle", "time": 4557.35, "timestamp": "01:15:57", "text": "なぜあちらではそれが重要になったのか？   一体"}, {"type": "subtitle", "time": 4558.39, "timestamp": "01:15:58", "text": "どういうことだ？   なんてこった。"}]
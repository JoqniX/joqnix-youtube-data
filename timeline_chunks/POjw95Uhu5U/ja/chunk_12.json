[{"type": "subtitle", "time": 726.55, "timestamp": "00:12:06", "text": "どういう意味ですか? どういう意味ですか？"}, {"type": "subtitle", "time": 729.99, "timestamp": "00:12:09", "text": "新しいインターネットは"}, {"type": "subtitle", "time": 731.99, "timestamp": "00:12:11", "text": "チャットについて語っている。"}, {"type": "subtitle", "time": 733.11, "timestamp": "00:12:13", "text": "それはとても新しいですね。"}, {"type": "subtitle", "time": 736.23, "timestamp": "00:12:16", "text": "どういう意味ですか？ それはペットです。 それは"}, {"type": "subtitle", "time": 739.03, "timestamp": "00:12:19", "text": "良いです。 とてもかわいいですね。"}, {"type": "subtitle", "time": 739.67, "timestamp": "00:12:19", "text": "ええ、"}, {"type": "subtitle", "time": 742.389, "timestamp": "00:12:22", "text": "見つかりましたよ。 彼らはそれを"}, {"type": "subtitle", "time": 745.19, "timestamp": "00:12:25", "text": "死闘の中で見つけた。"}, {"type": "subtitle", "time": 746.389, "timestamp": "00:12:26", "text": "こんにちは、みんな。   いいかい"}, {"type": "subtitle", "time": 748.55, "timestamp": "00:12:28", "text": "、君も状況は分かっているだろう。 人々は"}, {"type": "subtitle", "time": 758.389, "timestamp": "00:12:38", "text": "、もうダメだ。"}, {"type": "subtitle", "time": 766.55, "timestamp": "00:12:46", "text": "。 まあ、それがグループの雰囲気を決定づけるわけですね"}, {"type": "subtitle", "time": 769.67, "timestamp": "00:12:49", "text": "。   何てことだ"}, {"type": "subtitle", "time": 771.91, "timestamp": "00:12:51", "text": "。 私も"}, {"type": "subtitle", "time": 774.389, "timestamp": "00:12:54", "text": "日曜日の配信のタイトルのように作りました。   念のため"}, {"type": "subtitle", "time": 775.75, "timestamp": "00:12:55", "text": "確認させてください。"}, {"type": "subtitle", "time": 778.069, "timestamp": "00:12:58", "text": "タイトルが正確に何だったか忘れてしまいました。"}, {"type": "subtitle", "time": 779.59, "timestamp": "00:12:59", "text": "タイトルは何なんだ？ 念のため、すぐに"}]
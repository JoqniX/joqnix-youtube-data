[{"type": "subtitle", "time": 2465.75, "timestamp": "00:41:05", "text": "日光。 私は、昼間の光を"}, {"type": "subtitle", "time": 2468.23, "timestamp": "00:41:08", "text": "用意しておくのが大好きです。なぜなら、時々、"}, {"type": "subtitle", "time": 2473.589, "timestamp": "00:41:13", "text": "魔法のような暗闇を体験したいからです。 日光。   ほかに"}, {"type": "subtitle", "time": 2475.27, "timestamp": "00:41:15", "text": "何か？"}, {"type": "subtitle", "time": 2482.23, "timestamp": "00:41:22", "text": "。 しかし、あれは実際には"}, {"type": "subtitle", "time": 2484.63, "timestamp": "00:41:24", "text": "火の玉だ。"}, {"type": "subtitle", "time": 2486.71, "timestamp": "00:41:26", "text": "えっと、そうですね。"}, {"type": "subtitle", "time": 2488.87, "timestamp": "00:41:28", "text": "月の光線を準備しておいた方がいいかもしれません。 いい"}, {"type": "subtitle", "time": 2492.15, "timestamp": "00:41:32", "text": "攻撃だ。 とても良いことだ。"}, {"type": "subtitle", "time": 2493.829, "timestamp": "00:41:33", "text": "役に立つ。"}, {"type": "subtitle", "time": 2497.109, "timestamp": "00:41:37", "text": "えっと、他に何かありますか？"}, {"type": "subtitle", "time": 2499.99, "timestamp": "00:41:39", "text": "ああ、なんてことだ、君は獣を召喚したんだね。   また一つ、ここにいる"}, {"type": "subtitle", "time": 2502.71, "timestamp": "00:41:42", "text": "珍しい動物たちが加わったというわけだ"}, {"type": "subtitle", "time": 2503.67, "timestamp": "00:41:43", "text": "。   さらに"}, {"type": "subtitle", "time": 2506.15, "timestamp": "00:41:46", "text": "追加すればいい。   彼らに"}, {"type": "subtitle", "time": 2507.43, "timestamp": "00:41:47", "text": "も空いている人がいる。"}, {"type": "subtitle", "time": 2516.23, "timestamp": "00:41:56", "text": "。   何てことだ"}, {"type": "subtitle", "time": 2517.91, "timestamp": "00:41:57", "text": "。 両チームともたくさんの"}]
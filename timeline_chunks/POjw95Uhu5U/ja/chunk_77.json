[{"type": "subtitle", "time": 4621.43, "timestamp": "01:17:01", "text": "ああ、私の大きな岩よ。"}, {"type": "subtitle", "time": 4624.07, "timestamp": "01:17:04", "text": "私の大きな支え。"}, {"type": "subtitle", "time": 4625.83, "timestamp": "01:17:05", "text": "ビッグ"}, {"type": "subtitle", "time": 4628.39, "timestamp": "01:17:08", "text": "ロックの一番厄介なところは、以前はミリタリーデッキで使っていて"}, {"type": "subtitle", "time": 4630.87, "timestamp": "01:17:10", "text": "、基本的に最後に"}, {"type": "subtitle", "time": 4633.03, "timestamp": "01:17:13", "text": "やることはビッグロックを"}, {"type": "subtitle", "time": 4635.27, "timestamp": "01:17:15", "text": "敵に押し付けて、その岩を攻撃することだったんです。   あれは"}, {"type": "subtitle", "time": 4637.669, "timestamp": "01:17:17", "text": "面白い戦略だったし、あのクソバカでクソみたいな"}, {"type": "subtitle", "time": 4639.83, "timestamp": "01:17:19", "text": "楽しい"}, {"type": "subtitle", "time": 4644.709, "timestamp": "01:17:24", "text": "列車も。 私はそれが大嫌いだ。 アッシャー、"}, {"type": "subtitle", "time": 4646.79, "timestamp": "01:17:26", "text": "問題は、"}, {"type": "subtitle", "time": 4649.189, "timestamp": "01:17:29", "text": "私が好んでプレイするデッキが、"}, {"type": "subtitle", "time": 4653.03, "timestamp": "01:17:33", "text": "非常に召喚船に"}, {"type": "subtitle", "time": 4655.27, "timestamp": "01:17:35", "text": "特化したデッキであるということです。 だから、"}, {"type": "subtitle", "time": 4657.51, "timestamp": "01:17:37", "text": "私がプレイするたびにいつもニビルが出てきて、私はただただ"}, {"type": "subtitle", "time": 4659.11, "timestamp": "01:17:39", "text": "悲しいんです。"}, {"type": "subtitle", "time": 4660.709, "timestamp": "01:17:40", "text": "大きな岩。"}, {"type": "subtitle", "time": 4662.95, "timestamp": "01:17:42", "text": "それが私の一番好きな悲しいメイクです。"}, {"type": "subtitle", "time": 4665.75, "timestamp": "01:17:45", "text": "うん。  「"}, {"type": "subtitle", "time": 4668.55, "timestamp": "01:17:48", "text": "ああ、君の召喚デッキは全部大きな"}, {"type": "subtitle", "time": 4670.39, "timestamp": "01:17:50", "text": "岩石なんだね」って言われるのが大好きだよ。"}, {"type": "subtitle", "time": 4672.39, "timestamp": "01:17:52", "text": "いつもビッグ・ロブかマキシのどちらかになるんだけど、どういう"}, {"type": "subtitle", "time": 4675.03, "timestamp": "01:17:55", "text": "わけかまだ決まってないんだよね。   仰るとおり"}, {"type": "subtitle", "time": 4677.43, "timestamp": "01:17:57", "text": "。"}, {"type": "subtitle", "time": 4679.99, "timestamp": "01:17:59", "text": "いや、マキシは大丈夫ってことだよね。 何？ マキシは決して"}]
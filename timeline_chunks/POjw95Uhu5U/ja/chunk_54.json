[{"type": "subtitle", "time": 3241.27, "timestamp": "00:54:01", "text": "後で"}, {"type": "subtitle", "time": 3243.27, "timestamp": "00:54:03", "text": "町に着いたらすごく役に立つと思うよ。"}, {"type": "subtitle", "time": 3244.549, "timestamp": "00:54:04", "text": "ダンジョンではそれほど"}, {"type": "subtitle", "time": 3245.75, "timestamp": "00:54:05", "text": "役に立たないかもしれませんが、町に着いたらカリスマ"}, {"type": "subtitle", "time": 3253.03, "timestamp": "00:54:13", "text": "性を高めて店に行きましょう。 それは私が"}, {"type": "subtitle", "time": 3255.829, "timestamp": "00:54:15", "text": "クソみたいなホールドパーソンを選んでいるのを見て、"}, {"type": "subtitle", "time": 3257.67, "timestamp": "00:54:17", "text": "実際にホールパーソンを"}, {"type": "subtitle", "time": 3259.51, "timestamp": "00:54:19", "text": "使うことができなかった。   なんてこった。"}, {"type": "subtitle", "time": 3263.75, "timestamp": "00:54:23", "text": "暗闇を持っているのに、一度も"}, {"type": "subtitle", "time": 3267.19, "timestamp": "00:54:27", "text": "使ったことがないというのも気に入っています。   自分"}, {"type": "subtitle", "time": 3269.27, "timestamp": "00:54:29", "text": "自身に闇をまとわせたいです"}, {"type": "subtitle", "time": 3271.829, "timestamp": "00:54:31", "text": "。"}, {"type": "subtitle", "time": 3273.91, "timestamp": "00:54:33", "text": "暗闇。"}, {"type": "subtitle", "time": 3276.47, "timestamp": "00:54:36", "text": "しかし、町はある。"}, {"type": "subtitle", "time": 3279.109, "timestamp": "00:54:39", "text": "ええ、もちろん町はありますよ。 ああ、"}, {"type": "subtitle", "time": 3281.91, "timestamp": "00:54:41", "text": "私たちはただこのダンジョンに閉じ込められて忙しいだけなんです。   今はまだ"}, {"type": "subtitle", "time": 3283.51, "timestamp": "00:54:43", "text": "この場所を探索している段階ですが、ここから出ると"}, {"type": "subtitle", "time": 3285.349, "timestamp": "00:54:45", "text": "町がありますよ"}, {"type": "subtitle", "time": 3286.309, "timestamp": "00:54:46", "text": "。"}, {"type": "subtitle", "time": 3288.79, "timestamp": "00:54:48", "text": "うん。 つまり、厳密に"}, {"type": "subtitle", "time": 3290.79, "timestamp": "00:54:50", "text": "言えば、ジョック、そういうことだよ。 これは"}, {"type": "subtitle", "time": 3293.67, "timestamp": "00:54:53", "text": "最初のエリアのようなものです。"}, {"type": "subtitle", "time": 3296.47, "timestamp": "00:54:56", "text": "ええ、これは"}, {"type": "subtitle", "time": 3298.71, "timestamp": "00:54:58", "text": "チュートリアルダンジョンみたいなものです。"}]
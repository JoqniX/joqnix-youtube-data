[{"type": "subtitle", "time": 5044.79, "timestamp": "01:24:04", "text": "聞いてるんだ、"}, {"type": "subtitle", "time": 5046.87, "timestamp": "01:24:06", "text": "そしてなぜ私もこんなに納得しているんだろう"}, {"type": "subtitle", "time": 5048.65, "timestamp": "01:24:08", "text": "？」って思うんです。"}, {"type": "subtitle", "time": 5050.31, "timestamp": "01:24:10", "text": "[音楽]"}, {"type": "subtitle", "time": 5052.87, "timestamp": "01:24:12", "text": "説得力がある。"}, {"type": "subtitle", "time": 5055.59, "timestamp": "01:24:15", "text": "沈黙。女が働いている。黙れ。"}, {"type": "subtitle", "time": 5058.79, "timestamp": "01:24:18", "text": "子供め。"}, {"type": "subtitle", "time": 5061.669, "timestamp": "01:24:21", "text": "[音楽]"}, {"type": "subtitle", "time": 5063.669, "timestamp": "01:24:23", "text": "なんてこった。"}, {"type": "subtitle", "time": 5066.95, "timestamp": "01:24:26", "text": "彼女は呆然としている。"}, {"type": "subtitle", "time": 5069.35, "timestamp": "01:24:29", "text": "あの女はあまりにも固まっていて、"}, {"type": "subtitle", "time": 5072.709, "timestamp": "01:24:32", "text": "うん。うん。Kが"}, {"type": "subtitle", "time": 5074.87, "timestamp": "01:24:34", "text": "本当に固まっていたのか、それとも"}, {"type": "subtitle", "time": 5077.189, "timestamp": "01:24:37", "text": "偶然マイクを渡して、"}, {"type": "subtitle", "time": 5088.229, "timestamp": "01:24:48", "text": "固まっていたのか気になる。私はマイクを渡した。持っていた"}, {"type": "subtitle", "time": 5092.39, "timestamp": "01:24:52", "text": "けど、ええ、彼女は呆然としている。彼女は"}, {"type": "subtitle", "time": 5096.629, "timestamp": "01:24:56", "text": "市場価格より安く手に入れようとしていたけど、"}]
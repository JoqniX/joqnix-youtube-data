[{"type": "subtitle", "time": 841.44, "timestamp": "00:14:01", "text": "。 うん。"}, {"type": "subtitle", "time": 843.12, "timestamp": "00:14:03", "text": "うん。 うん。 自己卑下。 もちろんさ。   私は自分を"}, {"type": "subtitle", "time": 846.959, "timestamp": "00:14:06", "text": "うん。 自己卑下。 もちろんさ。   私は自分を 卑下するのが大好きなんです。"}, {"type": "subtitle", "time": 850.8, "timestamp": "00:14:10", "text": "卑下するのが大好きなんです。 私は特にあなたについて議論するのが大好きです。"}, {"type": "subtitle", "time": 853.839, "timestamp": "00:14:13", "text": "私は特にあなたについて議論するのが大好きです。 私も特に自分たちの脚本に対してそうするのが大好きです"}, {"type": "subtitle", "time": 855.68, "timestamp": "00:14:15", "text": "私も特に自分たちの脚本に対してそうするのが大好きです 。   まあ。"}, {"type": "subtitle", "time": 862.71, "timestamp": "00:14:22", "text": "私は挨拶する代わりに、グリムのDMに行くのが好きです"}, {"type": "subtitle", "time": 872.15, "timestamp": "00:14:32", "text": "陰鬱だ。 今日、君が知っているように、僕は"}, {"type": "subtitle", "time": 874.629, "timestamp": "00:14:34", "text": "君を噛んだり、食べたり、殴ったりするのが好きだと言ったんだ"}, {"type": "subtitle", "time": 876.71, "timestamp": "00:14:36", "text": "。 そして今日、私はグリムを先に手に入れたと言った"}, {"type": "subtitle", "time": 878.949, "timestamp": "00:14:38", "text": "。 するとグリムは「えーと、"}, {"type": "subtitle", "time": 881.59, "timestamp": "00:14:41", "text": "ブルースと戦うか、死ぬかだ」と言う。 私は"}, {"type": "subtitle", "time": 890.069, "timestamp": "00:14:50", "text": "今は彼を殺すことはできない。 私はまだ彼を殺すことはできない"}]
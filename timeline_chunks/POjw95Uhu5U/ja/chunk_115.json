[{"type": "subtitle", "time": 6904.39, "timestamp": "01:55:04", "text": "カ。"}, {"type": "subtitle", "time": 6905.83, "timestamp": "01:55:05", "text": "彼女は目を覚ました。やった。"}, {"type": "subtitle", "time": 6908.39, "timestamp": "01:55:08", "text": "イニシアチブを振って。"}, {"type": "subtitle", "time": 6910.229, "timestamp": "01:55:10", "text": "ロール。"}, {"type": "subtitle", "time": 6911.27, "timestamp": "01:55:11", "text": "開始。"}, {"type": "subtitle", "time": 6913.75, "timestamp": "01:55:13", "text": "よし。あと、"}, {"type": "subtitle", "time": 6915.35, "timestamp": "01:55:15", "text": "グリムが戻ってきたらいいな。戻ってきたら"}, {"type": "subtitle", "time": 6916.55, "timestamp": "01:55:16", "text": "クール。そうでなければ、"}, {"type": "subtitle", "time": 6918.95, "timestamp": "01:55:18", "text": "Discordで君のターンを保留するよ。ああ、わかった。よし。いいね。だって"}, {"type": "subtitle", "time": 6920.55, "timestamp": "01:55:20", "text": "さっき、"}, {"type": "subtitle", "time": 6922.709, "timestamp": "01:55:22", "text": "君が何か言ってたって書いてあったし。"}, {"type": "subtitle", "time": 6925.91, "timestamp": "01:55:25", "text": "うん。うん。"}, {"type": "subtitle", "time": 6928.07, "timestamp": "01:55:28", "text": "それは少し前のことだよ。"}, {"type": "subtitle", "time": 6929.589, "timestamp": "01:55:29", "text": "少し前。"}, {"type": "subtitle", "time": 6931.109, "timestamp": "01:55:31", "text": "私は時代についていけないんだ。ほら、"}, {"type": "subtitle", "time": 6932.79, "timestamp": "01:55:32", "text": "私はクソブーマーだから。"}, {"type": "subtitle", "time": 6935.35, "timestamp": "01:55:35", "text": "ああ、そうだね。暗殺。"}, {"type": "subtitle", "time": 6937.03, "timestamp": "01:55:37", "text": "誰を暗殺するの？"}, {"type": "subtitle", "time": 6939.109, "timestamp": "01:55:39", "text": "ああ、やっと"}, {"type": "subtitle", "time": 6940.79, "timestamp": "01:55:40", "text": "暗殺の仕方を思い出した。なんてこった。イニシアチブをくれ。イニシアチブをくれ。"}, {"type": "subtitle", "time": 6949.27, "timestamp": "01:55:49", "text": "有利で。"}, {"type": "subtitle", "time": 6950.55, "timestamp": "01:55:50", "text": "イニシアチブロールに有利がある。だから"}, {"type": "subtitle", "time": 6953.189, "timestamp": "01:55:53", "text": "有利でイニシアチブを振って。わかった。"}, {"type": "subtitle", "time": 6956.87, "timestamp": "01:55:56", "text": "有利"}]
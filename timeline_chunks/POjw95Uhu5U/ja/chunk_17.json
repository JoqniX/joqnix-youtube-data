[{"type": "subtitle", "time": 1022.47, "timestamp": "00:17:02", "text": "。 そうは思わない。"}, {"type": "subtitle", "time": 1024.63, "timestamp": "00:17:04", "text": "でも、そう、ちょっと待って。 変更する。 でも"}, {"type": "subtitle", "time": 1025.99, "timestamp": "00:17:05", "text": "心配しないでください。"}, {"type": "subtitle", "time": 1030.069, "timestamp": "00:17:10", "text": "呪文を学ぶ方法は他にもありますから"}, {"type": "subtitle", "time": 1031.99, "timestamp": "00:17:11", "text": "。 それは"}, {"type": "subtitle", "time": 1032.87, "timestamp": "00:17:12", "text": "計画通りだけど、"}, {"type": "subtitle", "time": 1036.949, "timestamp": "00:17:16", "text": "君が"}, {"type": "subtitle", "time": 1037.829, "timestamp": "00:17:17", "text": "ダンジョンから脱出した後のずっと後のことになるよ。"}, {"type": "subtitle", "time": 1039.829, "timestamp": "00:17:19", "text": "ああ、それなら全く問題ありません。"}, {"type": "subtitle", "time": 1041.829, "timestamp": "00:17:21", "text": "この話の教訓は、"}, {"type": "subtitle", "time": 1044.47, "timestamp": "00:17:24", "text": "我々には火の玉を放つ杖があるということだ。"}, {"type": "subtitle", "time": 1048.47, "timestamp": "00:17:28", "text": "レイにファイアーボールをかけたい。 私が"}, {"type": "subtitle", "time": 1050.71, "timestamp": "00:17:30", "text": "あなたにたくさんの"}, {"type": "subtitle", "time": 1061.909, "timestamp": "00:17:41", "text": "。"}, {"type": "subtitle", "time": 1063.909, "timestamp": "00:17:43", "text": "それはいくらになりますか？ 実際にやってみましょう"}, {"type": "subtitle", "time": 1064.549, "timestamp": "00:17:44", "text": "。   いつかいつか、何らかの形で"}, {"type": "subtitle", "time": 1070.15, "timestamp": "00:17:50", "text": "裏切りが。   私が"}, {"type": "subtitle", "time": 1074.39, "timestamp": "00:17:54", "text": "既に僧侶になった時に、あなたがそれをやってくれることを願っています。そうすれば、あなたが本当にやったかどうか見ることができますから"}, {"type": "subtitle", "time": 1078.07, "timestamp": "00:17:58", "text": "。"}]
[{"type": "subtitle", "time": 3483.589, "timestamp": "00:58:03", "text": "それは"}, {"type": "subtitle", "time": 3485.109, "timestamp": "00:58:05", "text": "カリウムの力で動きます。"}, {"type": "subtitle", "time": 3486.549, "timestamp": "00:58:06", "text": "はい、これでよし。 これでうまくいくと思う"}, {"type": "subtitle", "time": 3487.91, "timestamp": "00:58:07", "text": "。 今すぐ試してみてください。   私は"}, {"type": "subtitle", "time": 3489.91, "timestamp": "00:58:09", "text": "ヴァンが剣を抜くところを想像するのが好きだ"}, {"type": "subtitle", "time": 3492.71, "timestamp": "00:58:12", "text": "。 彼女は「一体どういうこと？"}, {"type": "subtitle", "time": 3496.63, "timestamp": "00:58:16", "text": "なんでジャガイモが今なの？ なんで、なんで、なんで、なんで"}, {"type": "subtitle", "time": 3499.589, "timestamp": "00:58:19", "text": "光ってるの？ もういいわ。"}, {"type": "subtitle", "time": 3506.95, "timestamp": "00:58:26", "text": "喋るゲイのジャガイモよ。"}, {"type": "subtitle", "time": 3509.19, "timestamp": "00:58:29", "text": "話したくないわ」って感じだった。"}, {"type": "subtitle", "time": 3510.71, "timestamp": "00:58:30", "text": "「じゃあ、私が先に行くべき"}, {"type": "subtitle", "time": 3512.71, "timestamp": "00:58:32", "text": "？」って感じだった。だって、まだ下に何があるか分からないし"}, {"type": "subtitle", "time": 3515.51, "timestamp": "00:58:35", "text": "。それに、"}, {"type": "subtitle", "time": 3516.95, "timestamp": "00:58:36", "text": "相手も下にいるので、"}, {"type": "subtitle", "time": 3518.95, "timestamp": "00:58:38", "text": "そんなに危険はないだろう。"}, {"type": "subtitle", "time": 3523.829, "timestamp": "00:58:43", "text": "寝ている間に既に対処済みかもしれない。もし"}, {"type": "subtitle", "time": 3532.63, "timestamp": "00:58:52", "text": "。"}, {"type": "subtitle", "time": 3534.47, "timestamp": "00:58:54", "text": "ええ。"}]
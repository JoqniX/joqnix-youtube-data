[{"type": "subtitle", "time": 2404.23, "timestamp": "00:40:04", "text": "アリアナのような近接戦闘の見た目を持っている場合、かなり役に立ちそうです。"}, {"type": "subtitle", "time": 2406.069, "timestamp": "00:40:06", "text": "ほとんどアリアナだけだ。"}, {"type": "subtitle", "time": 2407.67, "timestamp": "00:40:07", "text": "うん。   何てことだ"}, {"type": "subtitle", "time": 2410.31, "timestamp": "00:40:10", "text": "。 もう一度言うと、もし"}, {"type": "subtitle", "time": 2412.31, "timestamp": "00:40:12", "text": "相手チームに"}, {"type": "subtitle", "time": 2414.39, "timestamp": "00:40:14", "text": "アリチをマークしていないなら、かなり"}, {"type": "subtitle", "time": 2415.91, "timestamp": "00:40:15", "text": "厄介な組み合いになるだろう。"}, {"type": "subtitle", "time": 2418.47, "timestamp": "00:40:18", "text": "ああ、それは本当に最高だ。"}, {"type": "subtitle", "time": 2420.63, "timestamp": "00:40:20", "text": "待って、それはこのチームにあるの？ 確か私たちの一人が手に入れたと思うし、"}, {"type": "subtitle", "time": 2422.71, "timestamp": "00:40:22", "text": "前回は私たちの一人が"}, {"type": "subtitle", "time": 2426.069, "timestamp": "00:40:26", "text": "拡大縮小の巻物のようなものを見つけたと思う。   それでそれが"}, {"type": "subtitle", "time": 2429.75, "timestamp": "00:40:29", "text": "カミラだったかどうか確認できるかもしれないと思う。 持続する"}, {"type": "subtitle", "time": 2430.39, "timestamp": "00:40:30", "text": "。 そうねぇ。"}, {"type": "subtitle", "time": 2431.75, "timestamp": "00:40:31", "text": "カミラだと思う。"}, {"type": "subtitle", "time": 2432.15, "timestamp": "00:40:32", "text": "ああ、そうだね"}, {"type": "subtitle", "time": 2434.63, "timestamp": "00:40:34", "text": "。 そうだよ、カミラ。 カミラは、その巻物を持っている"}, {"type": "subtitle", "time": 2437.03, "timestamp": "00:40:37", "text": "か、"}, {"type": "subtitle", "time": 2438.39, "timestamp": "00:40:38", "text": "誰かが持っていたと思います。 わからない"}, {"type": "subtitle", "time": 2439.99, "timestamp": "00:40:39", "text": "。"}, {"type": "subtitle", "time": 2441.19, "timestamp": "00:40:41", "text": "持ち物の中から探しています。"}, {"type": "subtitle", "time": 2442.87, "timestamp": "00:40:42", "text": "誰かが何らかの巻物を見つけたらしい"}, {"type": "subtitle", "time": 2444.39, "timestamp": "00:40:44", "text": "。   何てことだ"}, {"type": "subtitle", "time": 2446.23, "timestamp": "00:40:46", "text": "。 もう一つ、すごく"}, {"type": "subtitle", "time": 2450.15, "timestamp": "00:40:50", "text": "面白い呪文を知ってる？ 痕跡を残さずに去る。"}]
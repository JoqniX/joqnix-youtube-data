[{"type": "subtitle", "time": 7201.189, "timestamp": "02:00:01", "text": "やったー。   何てことだ"}, {"type": "subtitle", "time": 7202.47, "timestamp": "02:00:02", "text": "。"}, {"type": "subtitle", "time": 7202.709, "timestamp": "02:00:02", "text": "チクタク音がするだろう。"}, {"type": "subtitle", "time": 7204.07, "timestamp": "02:00:04", "text": "投資する。   何てことだ"}, {"type": "subtitle", "time": 7205.51, "timestamp": "02:00:05", "text": "。"}, {"type": "subtitle", "time": 7208.87, "timestamp": "02:00:08", "text": "株式市場に投資するだろうと思います。"}, {"type": "subtitle", "time": 7211.669, "timestamp": "02:00:11", "text": "投資する。"}, {"type": "subtitle", "time": 7214.229, "timestamp": "02:00:14", "text": "つまり、彼らが株式"}, {"type": "subtitle", "time": 7215.91, "timestamp": "02:00:15", "text": "市場と言っていたのはそういう意味だったんですね。 わかった。"}, {"type": "subtitle", "time": 7217.75, "timestamp": "02:00:17", "text": "私の平手打ち。 私の平手打ち。"}, {"type": "subtitle", "time": 7220.31, "timestamp": "02:00:20", "text": "あなたが選んだ虫は、それを食べたからですか？   痛い。 すごい！"}, {"type": "subtitle", "time": 7223.99, "timestamp": "02:00:23", "text": "そのことで平手打ちを食らわせてやる。   痛い。"}, {"type": "subtitle", "time": 7226.47, "timestamp": "02:00:26", "text": "ああ、テキストが消えちゃった。 それは"}, {"type": "subtitle", "time": 7228.31, "timestamp": "02:00:28", "text": "テキストを食べた。 おいしい。"}, {"type": "subtitle", "time": 7233.43, "timestamp": "02:00:33", "text": "。   もぐもぐもぐ"}, {"type": "subtitle", "time": 7236.229, "timestamp": "02:00:36", "text": "。   わかった"}, {"type": "subtitle", "time": 7239.91, "timestamp": "02:00:39", "text": "。 よし。 でも、そうですね"}, {"type": "subtitle", "time": 7242.87, "timestamp": "02:00:42", "text": "、何もないような感じですよ"}, {"type": "subtitle", "time": 7245.669, "timestamp": "02:00:45", "text": "ね？ うん。 フィールド上に"}, {"type": "subtitle", "time": 7247.75, "timestamp": "02:00:47", "text": "安全な選手はいない。 そうねぇ。 ああ、つまり、"}, {"type": "subtitle", "time": 7249.83, "timestamp": "02:00:49", "text": "フィールド上でのダメージが完全に安全であるということです。 ブープ。   はい、どうぞ"}, {"type": "subtitle", "time": 7253.27, "timestamp": "02:00:53", 
[{"type": "subtitle", "time": 1140.63, "timestamp": "00:19:00", "text": "。"}, {"type": "subtitle", "time": 1143.11, "timestamp": "00:19:03", "text": "批評家の熱狂。   それなら"}, {"type": "subtitle", "time": 1146.07, "timestamp": "00:19:06", "text": "12ですね。"}, {"type": "subtitle", "time": 1148.789, "timestamp": "00:19:08", "text": "そして私は再び攻撃する。 これはただの"}, {"type": "subtitle", "time": 1150.39, "timestamp": "00:19:10", "text": "趣味でやっているだけです。"}, {"type": "subtitle", "time": 1161.11, "timestamp": "00:19:21", "text": "クリティカルの"}, {"type": "subtitle", "time": 1163.59, "timestamp": "00:19:23", "text": "閾値を19に下げるようなアイテムを何とか手に入れたら、めちゃくちゃ強くなるよ。"}, {"type": "subtitle", "time": 1166.23, "timestamp": "00:19:26", "text": "ああ、それは最高だね。"}, {"type": "subtitle", "time": 1177.35, "timestamp": "00:19:37", "text": "この話の教訓は、カミラは自分が落ち込むようなことがあった時のために、"}, {"type": "subtitle", "time": 1179.83, "timestamp": "00:19:39", "text": "とてもよく準備しておく必要があるということです"}, {"type": "subtitle", "time": 1184.71, "timestamp": "00:19:44", "text": "。"}, {"type": "subtitle", "time": 1187.75, "timestamp": "00:19:47", "text": "ああ、そうだよ。"}, {"type": "subtitle", "time": 1189.669, "timestamp": "00:19:49", "text": "例えば、魔法使いのビングボールのようなものだけなら、おそらく"}, {"type": "subtitle", "time": 1194.63, "timestamp": "00:19:54", "text": "引き返すことができるでしょう。 でもレイみたいに、"}, {"type": "subtitle", "time": 1196.23, "timestamp": "00:19:56", "text": "何か試みた瞬間に、彼女は"}, {"type": "subtitle", "time": 1198.549, "timestamp": "00:19:58", "text": "すぐに反撃してきて、まるで"}]
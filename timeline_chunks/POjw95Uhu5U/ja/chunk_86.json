[{"type": "subtitle", "time": 5160.87, "timestamp": "01:26:00", "text": "良すぎた。20は"}, {"type": "subtitle", "time": 5163.99, "timestamp": "01:26:03", "text": "良すぎた。"}, {"type": "subtitle", "time": 5166.55, "timestamp": "01:26:06", "text": "強盗されても何も言わない。"}, {"type": "subtitle", "time": 5175.75, "timestamp": "01:26:15", "text": "ネイチャーズマントル150GPとたくさんの尊厳を失った"}, {"type": "subtitle", "time": 5179.51, "timestamp": "01:26:19", "text": "[音楽]"}, {"type": "subtitle", "time": 5181.59, "timestamp": "01:26:21", "text": "彼女のパーティーの残りのメンバーも"}, {"type": "subtitle", "time": 5183.91, "timestamp": "01:26:23", "text": "これを見ているから。ああ、"}, {"type": "subtitle", "time": 5186.95, "timestamp": "01:26:26", "text": "そうだね。アリシアは「"}, {"type": "subtitle", "time": 5188.709, "timestamp": "01:26:28", "text": "見てもいいよ」って感じ。"}, {"type": "subtitle", "time": 5192.79, "timestamp": "01:26:32", "text": "なんてこった。君は野獣だ。"}, {"type": "subtitle", "time": 5195.99, "timestamp": "01:26:35", "text": "握手ビジネス取引。20を"}, {"type": "subtitle", "time": 5198.39, "timestamp": "01:26:38", "text": "出したからだと思う。カミラは"}, {"type": "subtitle", "time": 5201.189, "timestamp": "01:26:41", "text": "握手するだろう ティックの手。"}, {"type": "subtitle", "time": 5203.75, "timestamp": "01:26:43", "text": "彼女がただただ"}, {"type": "subtitle", "time": 5206.31, "timestamp": "01:26:46", "text": "困惑して、頭が真っ白になって、"}, {"type": "subtitle", "time": 5210.07, "timestamp": "01:26:50", "text": "その手を握って、「一体何が"}, {"type": "subtitle", "time": 5213.189, "timestamp": "01:26:53", "text": "起こったの？」って感じでいるところを想像するのが好きなんです。彼女は"}, {"type": "subtitle", "time": 5214.709, "timestamp": "01:26:54", "text": "後でそれに気づいて、"}, {"type": "subtitle", "time": 5217.11, "timestamp": "01:26:57", "text": "「しまった、大きな間違いを犯してしまった」って思うでしょうね。"}]
[{"type": "subtitle", "time": 1500.63, "timestamp": "00:25:00", "text": "正確なように思える。 カミラは何も当てられないだろう、"}, {"type": "subtitle", "time": 1503.51, "timestamp": "00:25:03", "text": "なぜなら彼女は何らかの理由で外してしまうからだ。"}, {"type": "subtitle", "time": 1507.19, "timestamp": "00:25:07", "text": "カミラは眼科検診を受けない。"}, {"type": "subtitle", "time": 1510.149, "timestamp": "00:25:10", "text": "そして、ダリアンはこの腕を持っていると思いますよね"}, {"type": "subtitle", "time": 1512.23, "timestamp": "00:25:12", "text": "？ ダリアンは、この"}, {"type": "subtitle", "time": 1518.23, "timestamp": "00:25:18", "text": "。 ええ、バーには確かにこの"}, {"type": "subtitle", "time": 1521.11, "timestamp": "00:25:21", "text": "武装攻撃があります。 全く使わなかった。"}, {"type": "subtitle", "time": 1524.07, "timestamp": "00:25:24", "text": "イエス・キリスト。 ごめん。 喉に"}, {"type": "subtitle", "time": 1527.59, "timestamp": "00:25:27", "text": "ハニーバターチップが挟まっているからじゃないよ"}, {"type": "subtitle", "time": 1529.35, "timestamp": "00:25:29", "text": "。"}, {"type": "subtitle", "time": 1534.549, "timestamp": "00:25:34", "text": "ああ、神様。"}, {"type": "subtitle", "time": 1537.11, "timestamp": "00:25:37", "text": "うん。 いいえ、私が"}, {"type": "subtitle", "time": 1539.19, "timestamp": "00:25:39", "text": "そう考える理由は、もしカルメラが"}, {"type": "subtitle", "time": 1541.669, "timestamp": "00:25:41", "text": "実際に杖で火の玉のようなものを放った場合"}, {"type": "subtitle", "time": 1549.51, "timestamp": "00:25:49", "text": "[音楽]"}, {"type": "subtitle", "time": 1551.75, "timestamp": "00:25:51", "text": "そして私は言った、カミラ、カミラは自分が"}, {"type": "subtitle", "time": 1553.59, "timestamp": "00:25:53", "text": "バカじゃないってことに気付くだろう。 彼女は自分のタイミングを見計らうだろう"}, {"type": "subtitle", "time": 1559.11, "timestamp": "00:25:59", "text": "どういうことだ？  M."}]
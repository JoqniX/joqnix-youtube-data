[{"type": "subtitle", "time": 5100.12, "timestamp": "01:25:00", "text": "せいぜい150ドルくらいしかできなかった。"}, {"type": "subtitle", "time": 5114.95, "timestamp": "01:25:14", "text": "よし、君たちはタグを取ってくれ。うん、"}, {"type": "subtitle", "time": 5119.189, "timestamp": "01:25:19", "text": "滝を動かすよ、そうだろ？"}, {"type": "subtitle", "time": 5121.669, "timestamp": "01:25:21", "text": "マントル。よし。わかった。よし。"}, {"type": "subtitle", "time": 5125.75, "timestamp": "01:25:25", "text": "君のイメージを動かすよ。"}, {"type": "subtitle", "time": 5127.83, "timestamp": "01:25:27", "text": "よし。君に渡すよ。"}, {"type": "subtitle", "time": 5133.11, "timestamp": "01:25:33", "text": "うん。うん。"}, {"type": "subtitle", "time": 5135.03, "timestamp": "01:25:35", "text": "私たちは そうするよ。それから"}, {"type": "subtitle", "time": 5136.31, "timestamp": "01:25:36", "text": "後でジョーにあげるんだ。"}, {"type": "subtitle", "time": 5138.55, "timestamp": "01:25:38", "text": "うん。うん。そうだね。うん。えっと、"}, {"type": "subtitle", "time": 5142.149, "timestamp": "01:25:42", "text": "カーメラから150を引いて、君の"}, {"type": "subtitle", "time": 5143.189, "timestamp": "01:25:43", "text": "お金にするんだ。"}, {"type": "subtitle", "time": 5144.39, "timestamp": "01:25:44", "text": "いや、いや、いや。私がお金を受け取るんだ。"}, {"type": "subtitle", "time": 5145.35, "timestamp": "01:25:45", "text": "カミラがお金を受け取るんだよね？"}, {"type": "subtitle", "time": 5147.27, "timestamp": "01:25:47", "text": "ああ、そうだね。ごめん。ごめん。そうだね。150を引いて"}, {"type": "subtitle", "time": 5151.51, "timestamp": "01:25:51", "text": "[音楽]"}, {"type": "subtitle", "time": 5154.47, "timestamp": "01:25:54", "text": "強盗もするんだ。"}, {"type": "subtitle", "time": 5157.669, "timestamp": "01:25:57", "text": "強盗されたばかりなのに、すごく紛らわしいと思う。20は"}]
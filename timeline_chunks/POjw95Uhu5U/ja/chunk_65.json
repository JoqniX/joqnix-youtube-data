[{"type": "subtitle", "time": 3901.029, "timestamp": "01:05:01", "text": "まあ、他のチームじゃないなら、"}, {"type": "subtitle", "time": 3903.43, "timestamp": "01:05:03", "text": "なんて"}, {"type": "subtitle", "time": 3907.029, "timestamp": "01:05:07", "text": "素晴らしいんだろう。"}, {"type": "subtitle", "time": 3912.15, "timestamp": "01:05:12", "text": "ヴァンとアリアナをこんな風にちらっと見て、狂ったように"}, {"type": "subtitle", "time": 3914.15, "timestamp": "01:05:14", "text": "幸せそうに、"}, {"type": "subtitle", "time": 3917.589, "timestamp": "01:05:17", "text": "ここにいられてとても興奮している。"}, {"type": "subtitle", "time": 3921.43, "timestamp": "01:05:21", "text": "ああ、またペットを連れてきたんだね"}, {"type": "subtitle", "time": 3927.75, "timestamp": "01:05:27", "text": "君と同じくらい。"}, {"type": "subtitle", "time": 3929.829, "timestamp": "01:05:29", "text": "君は彼女と同じ人だと思う。"}, {"type": "subtitle", "time": 3933.349, "timestamp": "01:05:33", "text": "私は高貴な貴族だよ、愛しい人。"}, {"type": "subtitle", "time": 3935.91, "timestamp": "01:05:35", "text": "君は自分を信じてる。"}, {"type": "subtitle", "time": 3939.67, "timestamp": "01:05:39", "text": "うん、彼女はそんなに悪くないよ。これは、"}, {"type": "subtitle", "time": 3941.67, "timestamp": "01:05:41", "text": "君の家族が"}, {"type": "subtitle", "time": 3955.99, "timestamp": "01:05:55", "text": "クリスピンは"}, {"type": "subtitle", "time": 3958.069, "timestamp": "01:05:58", "text": "透明人間みたいなんだけど、ハイタッチはチクチクするんだ。"}]
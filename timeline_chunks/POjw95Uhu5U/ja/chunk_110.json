[{"type": "subtitle", "time": 6629.35, "timestamp": "01:50:29", "text": "常に少なくとも"}, {"type": "subtitle", "time": 6632.79, "timestamp": "01:50:32", "text": "アーティストとゲーム、つまりコーダーのようなゲームメーカーが必要です"}, {"type": "subtitle", "time": 6636.629, "timestamp": "01:50:36", "text": "。それは常に、毎回です"}, {"type": "subtitle", "time": 6643.109, "timestamp": "01:50:43", "text": "もし私がそれほどコーディングしていなければ、"}, {"type": "subtitle", "time": 6645.43, "timestamp": "01:50:45", "text": "ヤシの木は使いません。"}, {"type": "subtitle", "time": 6647.51, "timestamp": "01:50:47", "text": "なぜおばあちゃんが？"}, {"type": "subtitle", "time": 6650.47, "timestamp": "01:50:50", "text": "つまり、箱には、実際にはそうではありませんが、"}, {"type": "subtitle", "time": 6652.31, "timestamp": "01:50:52", "text": "特定の[ __ ]と一緒にしたいなら、"}, {"type": "subtitle", "time": 6654.79, "timestamp": "01:50:54", "text": "私はそうします。はい。"}, {"type": "subtitle", "time": 6657.59, "timestamp": "01:50:57", "text": "それから、私がいつかポンドゲームを買ったら、"}, {"type": "subtitle", "time": 6659.59, "timestamp": "01:50:59", "text": "私たちは 助けを求めてください"}]
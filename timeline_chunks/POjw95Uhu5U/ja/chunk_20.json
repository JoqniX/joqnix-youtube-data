[{"type": "subtitle", "time": 1204.71, "timestamp": "00:20:04", "text": "10マイルも離れたところから走ってきて、あなたに向かってくるんです。"}, {"type": "subtitle", "time": 1205.11, "timestamp": "00:20:05", "text": "ああ、"}, {"type": "subtitle", "time": 1207.11, "timestamp": "00:20:07", "text": "彼女はきっと笑顔でやってくれるでしょう。"}, {"type": "subtitle", "time": 1208.63, "timestamp": "00:20:08", "text": "彼女は裏切られるようなことはしないだろう。 彼女はそれをずっと待っていた"}, {"type": "subtitle", "time": 1210.63, "timestamp": "00:20:10", "text": "。"}, {"type": "subtitle", "time": 1211.43, "timestamp": "00:20:11", "text": "彼女は待っていた。"}, {"type": "subtitle", "time": 1213.909, "timestamp": "00:20:13", "text": "ついに。"}, {"type": "subtitle", "time": 1217.19, "timestamp": "00:20:17", "text": "ついに、あなたは自らの命を絶ったのです"}, {"type": "subtitle", "time": 1225.669, "timestamp": "00:20:25", "text": "一番恐ろしい"}, {"type": "subtitle", "time": 1228.149, "timestamp": "00:20:28", "text": "部分、というか、ほとんど忘れていたのですが"}, {"type": "subtitle", "time": 1230.63, "timestamp": "00:20:30", "text": "、ダリアンが実際にルシに"}, {"type": "subtitle", "time": 1232.71, "timestamp": "00:20:32", "text": "嵐の巨人の薬を持たせたんですよね？"}, {"type": "subtitle", "time": 1233.029, "timestamp": "00:20:33", "text": "そうそう。"}, {"type": "subtitle", "time": 1234.789, "timestamp": "00:20:34", "text": "はい、その通りです。"}, {"type": "subtitle", "time": 1235.75, "timestamp": "00:20:35", "text": "ああ、これは面白くなりそうだ。"}, {"type": "subtitle", "time": 1237.99, "timestamp": "00:20:37", "text": "考えるだけで恐ろしい。"}, {"type": "subtitle", "time": 1240.95, "timestamp": "00:20:40", "text": "それは面白そうだ。   29歳で25歳。"}, {"type": "subtitle", "time": 1244.71, "timestamp": "00:20:44", "text": "それは恐ろしい。   それは"}, {"type": "subtitle", "time": 1247.83, "timestamp": "00:20:47", "text": "問題にならないと思います。   それは"}, {"type": "subtitle", "time": 1250.07, "timestamp": "00:20:50", "text": "問題にならないと思います。   いやいや"}, {"type": "subtitle", "time": 1250.549, "timestamp": "00:20:50", "text": "。"}, {"type": "subtitle", "time": 1258.39, "timestamp": "00:20:58", "text": "、今気づいたんだけど、うっかり"}]
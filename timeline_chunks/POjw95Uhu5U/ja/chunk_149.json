[{"type": "subtitle", "time": 8945.83, "timestamp": "02:29:05", "text": "次回は、もし"}, {"type": "subtitle", "time": 8948.15, "timestamp": "02:29:08", "text": "像を調査する必要があるなら、"}, {"type": "subtitle", "time": 8952.87, "timestamp": "02:29:12", "text": "クリスを行かせなければならないでしょうね。"}, {"type": "subtitle", "time": 8954.87, "timestamp": "02:29:14", "text": "[音楽]"}, {"type": "subtitle", "time": 8956.95, "timestamp": "02:29:16", "text": "クリスセンはすでに"}, {"type": "subtitle", "time": 8959.75, "timestamp": "02:29:19", "text": "一度ダウンしています。"}, {"type": "subtitle", "time": 8965.67, "timestamp": "02:29:25", "text": "クリスセンが何回死んだかのカウンターを付けておかなければなりません。"}, {"type": "subtitle", "time": 8967.51, "timestamp": "02:29:27", "text": "実際、そのカウンターは必要ですよね"}, {"type": "subtitle", "time": 8969.51, "timestamp": "02:29:29", "text": "？"}, {"type": "subtitle", "time": 8971.59, "timestamp": "02:29:31", "text": "このエピソードの時点では1人です。"}, {"type": "subtitle", "time": 8975.429, "timestamp": "02:29:35", "text": "うん。 あと、えっと、"}, {"type": "subtitle", "time": 8977.19, "timestamp": "02:29:37", "text": "あなたから何かを盗もうとしたやつ。"}, {"type": "subtitle", "time": 8979.349, "timestamp": "02:29:39", "text": "クローゼット。"}, {"type": "subtitle", "time": 8983.19, "timestamp": "02:29:43", "text": "うん。 ここにあります。"}, {"type": "subtitle", "time": 8993.03, "timestamp": "02:29:53", "text": "確認していただけますか？   わかった"}, {"type": "subtitle", "time": 8997.67, "timestamp": "02:29:57", "text": "。 ああ、わかった。 ええと、私に"}]
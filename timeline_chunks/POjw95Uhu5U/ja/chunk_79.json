[{"type": "subtitle", "time": 4741.189, "timestamp": "01:19:01", "text": "カミラが提供するものなのです。"}, {"type": "subtitle", "time": 4743.66, "timestamp": "01:19:03", "text": "ここに現金を持っている人はいますか？"}, {"type": "subtitle", "time": 4748.47, "timestamp": "01:19:08", "text": "[ミュージック]は"}, {"type": "subtitle", "time": 4758.149, "timestamp": "01:19:18", "text": "[音楽]を持っている人はいますか？私は、あなたが"}, {"type": "subtitle", "time": 4766.31, "timestamp": "01:19:26", "text": "それに同調することさえできないのに、ミニチュアのマントルの代わりに火の玉の1つを提供しているのが好きです。"}, {"type": "subtitle", "time": 4769.27, "timestamp": "01:19:29", "text": "ええ、でも彼女は、"}, {"type": "subtitle", "time": 4775.75, "timestamp": "01:19:35", "text": "ドルイドやレンジャーのような理由で、それを持っている可能性があると思います。"}, {"type": "subtitle", "time": 4777.51, "timestamp": "01:19:37", "text": "正直に言うと、個人的には、その方が"}, {"type": "subtitle", "time": 4781.27, "timestamp": "01:19:41", "text": "かっこよく見えるから、それでもあなたにそうさせると思う。"}, {"type": "subtitle", "time": 4783.189, "timestamp": "01:19:43", "text": "でも、そうね、カミラはそう言うと思うわ"}, {"type": "subtitle", "time": 4784.31, "timestamp": "01:19:44", "text": "。 彼女は"}, {"type": "subtitle", "time": 4787.11, "timestamp": "01:19:47", "text": "自然のマントを200ドルで提供するつもりだった。いや、いや、"}, {"type": "subtitle", "time": 4789.51, "timestamp": "01:19:49", "text": "彼女はそれを受け取った。 だから彼女はそれを取ったんだ。"}, {"type": "subtitle", "time": 4791.75, "timestamp": "01:19:51", "text": "彼女は私と同じように、それを相手に"}, {"type": "subtitle", "time": 4793.91, "timestamp": "01:19:53", "text": "売るために取ったのだから。"}, {"type": "subtitle", "time": 4797.11, "timestamp": "01:19:57", "text": "うん。 ああ、わかりました。 彼女はビジネス"}, {"type": "subtitle", "time": 4798.95, "timestamp": "01:19:58", "text": "ウーマンだから。"}]
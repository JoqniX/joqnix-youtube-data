[{"type": "subtitle", "time": 8041.03, "timestamp": "02:14:01", "text": "もっと彼らを見たい。"}, {"type": "subtitle", "time": 8043.27, "timestamp": "02:14:03", "text": "私は、あなたの胃の中で育つものが怖いんです"}, {"type": "subtitle", "time": 8045.91, "timestamp": "02:14:05", "text": "。 しかし、どうなるか見てみましょう。   よし"}, {"type": "subtitle", "time": 8048.87, "timestamp": "02:14:08", "text": "。 わかった。 ええと、"}, {"type": "subtitle", "time": 8050.95, "timestamp": "02:14:10", "text": "この戦闘の最中、"}, {"type": "subtitle", "time": 8052.709, "timestamp": "02:14:12", "text": "ミミックが"}, {"type": "subtitle", "time": 8055.669, "timestamp": "02:14:15", "text": "何かをした後、アリアナのすぐ後ろで"}, {"type": "subtitle", "time": 8058.709, "timestamp": "02:14:18", "text": "アリアナが消えるのがわかります。 ちょっと待って、見せて"}, {"type": "subtitle", "time": 8061.75, "timestamp": "02:14:21", "text": "。 えーとブループは別のブループです。"}, {"type": "subtitle", "time": 8064.149, "timestamp": "02:14:24", "text": "うん。 うん。 別のコース。 うん。"}, {"type": "subtitle", "time": 8065.669, "timestamp": "02:14:25", "text": "クローゼットが目の前に現れて、"}, {"type": "subtitle", "time": 8067.91, "timestamp": "02:14:27", "text": "すぐに何て言うんだっけ、"}, {"type": "subtitle", "time": 8071.03, "timestamp": "02:14:31", "text": "あなたを攻撃しようとします。 わかった。"}, {"type": "subtitle", "time": 8074.229, "timestamp": "02:14:34", "text": "ああ、私のクローゼットは使い勝手が悪いんです。   わかった"}, {"type": "subtitle", "time": 8076.79, "timestamp": "02:14:36", "text": "。 これは、実際に起こることです。 さて、これは"}, {"type": "subtitle", "time": 8077.91, "timestamp": "02:14:37", "text": "ちょっと"}, {"type": "subtitle", "time": 8081.43, "timestamp": "02:14:41", "text": "奇妙な話になるかもしれませんが、こういうことが起こるんです。  49はヒットしますか？"}, {"type": "subtitle", "time": 8082.87, "timestamp": "02:14:42", "text": "ええ、そうです。   それは"}, {"type": "subtitle", "time": 8086.31, "timestamp": "02:14:46", "text": "正しいですか？"}, {"type": "subtitle", "time": 8088.629, "timestamp": "02:14:48", "text": "よし、攻撃は命中するが、ダメージは受けない"}, {"type": "subtitle", "time": 8091.99, "timestamp": "02:14:51", "text": "。 その代わりに、ポケットが"}, {"type": "subtitle", "time": 8095.109, "timestamp": "02:14:55", "text": "少し薄くなっていることに気づく。   なんてこった。"}, {"type": "subtitle", "time": 8097.669, "timestamp": "02:14:57", "text": "あなたは私のお金を奪った。"}]
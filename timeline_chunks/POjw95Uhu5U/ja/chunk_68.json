[{"type": "subtitle", "time": 4090.71, "timestamp": "01:08:10", "text": "確かに。それらはすべて乳製品だ。"}, {"type": "subtitle", "time": 4102.47, "timestamp": "01:08:22", "text": "[音楽]"}, {"type": "subtitle", "time": 4104.789, "timestamp": "01:08:24", "text": "なんてこった。"}, {"type": "subtitle", "time": 4107.829, "timestamp": "01:08:27", "text": "彼は"}, {"type": "subtitle", "time": 4119.829, "timestamp": "01:08:39", "text": "こっちに来なさい。"}, {"type": "subtitle", "time": 4123.269, "timestamp": "01:08:43", "text": "ええと、私は混乱している。君のパーティーは"}, {"type": "subtitle", "time": 4129.11, "timestamp": "01:08:49", "text": "生き物の群れだが、一方で、ここには"}, {"type": "subtitle", "time": 4133.669, "timestamp": "01:08:53", "text": "これらのものはない。"}, {"type": "subtitle", "time": 4135.349, "timestamp": "01:08:55", "text": "素晴らしいように見える。 彼女は「ええ、ええ"}]
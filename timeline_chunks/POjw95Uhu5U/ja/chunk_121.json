[{"type": "subtitle", "time": 7260.709, "timestamp": "02:01:00", "text": "みんなのために泣いて、引きずり出そうと思います。   わかった"}, {"type": "subtitle", "time": 7262.78, "timestamp": "02:01:02", "text": "。"}, {"type": "subtitle", "time": 7269.99, "timestamp": "02:01:09", "text": "オーケー。"}, {"type": "subtitle", "time": 7272.79, "timestamp": "02:01:12", "text": "ああ、くそ。 私が行動を起こすたびに、もし私が"}, {"type": "subtitle", "time": 7275.03, "timestamp": "02:01:15", "text": "壮大なものをたくさん手に入れたら、まずは"}, {"type": "subtitle", "time": 7283.99, "timestamp": "02:01:23", "text": "。 アリアナ"}, {"type": "subtitle", "time": 7285.109, "timestamp": "02:01:25", "text": "かな。 スマック。"}, {"type": "subtitle", "time": 7286.95, "timestamp": "02:01:26", "text": "ちなみに、あなたはそれを間違った相手に伝えたんですよ"}, {"type": "subtitle", "time": 7288.629, "timestamp": "02:01:28", "text": "。 竜の"}, {"type": "subtitle", "time": 7291.35, "timestamp": "02:01:31", "text": "咆哮は、我々ではなく、ミミックにかけるべきものだ。"}, {"type": "subtitle", "time": 7293.99, "timestamp": "02:01:33", "text": "おお。 あ、ごめんなさい。 それはまるで味方"}, {"type": "subtitle", "time": 7295.91, "timestamp": "02:01:35", "text": "全員に有利な状況を与えるようなものだと思った。 ああ、今"}, {"type": "subtitle", "time": 7297.35, "timestamp": "02:01:37", "text": "気づいた。"}, {"type": "subtitle", "time": 7304.709, "timestamp": "02:01:44", "text": "ダメージを与えます。"}, {"type": "subtitle", "time": 7312.709, "timestamp": "02:01:52", "text": "よし、当たったね。 よし。"}, {"type": "subtitle", "time": 7316.07, "timestamp": "02:01:56", "text": "よし、"}, {"type": "subtitle", "time": 7318.149, "timestamp": "02:01:58", "text": "これはかなり大きな模倣だと思う。"}]
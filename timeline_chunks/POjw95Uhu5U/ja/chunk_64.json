[{"type": "subtitle", "time": 3844.87, "timestamp": "01:04:04", "text": "この下にいるの？逃げたの？"}, {"type": "subtitle", "time": 3846.95, "timestamp": "01:04:06", "text": "ああ、だめ。カミラはどこ？ああ、だめ。"}, {"type": "subtitle", "time": 3848.309, "timestamp": "01:04:08", "text": "カミラはどこ？ああ。"}, {"type": "subtitle", "time": 3851.27, "timestamp": "01:04:11", "text": "ああ、だめ。彼女は逃げた。"}, {"type": "subtitle", "time": 3853.109, "timestamp": "01:04:13", "text": "よし、4番目を明かそう"}, {"type": "subtitle", "time": 3854.95, "timestamp": "01:04:14", "text": "。ほら、4番目だ。"}, {"type": "subtitle", "time": 3857.349, "timestamp": "01:04:17", "text": "いや、彼女は毎回戻ってくる"}, {"type": "subtitle", "time": 3858.63, "timestamp": "01:04:18", "text": "。5番目"}, {"type": "subtitle", "time": 3861.589, "timestamp": "01:04:21", "text": "か6番目か7番目になるだろう。"}, {"type": "subtitle", "time": 3879.67, "timestamp": "01:04:39", "text": "ああ、"}, {"type": "subtitle", "time": 3888.549, "timestamp": "01:04:48", "text": "ここにいるから、カミラは後ろにいる。"}, {"type": "subtitle", "time": 3889.51, "timestamp": "01:04:49", "text": "よし。"}, {"type": "subtitle", "time": 3892.39, "timestamp": "01:04:52", "text": "勇敢な男の子みたいに。"}, {"type": "subtitle", "time": 3897.67, "timestamp": "01:04:57", "text": "君たちはこの戦争を終えたの？"}]
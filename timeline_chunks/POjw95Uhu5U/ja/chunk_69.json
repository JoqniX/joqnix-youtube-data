[{"type": "subtitle", "time": 4140.229, "timestamp": "01:09:00", "text": "。正直に言うと、ええと、私はあなたが出会った"}, {"type": "subtitle", "time": 4142.87, "timestamp": "01:09:02", "text": "人たちよりも、この人たちに出会えて本当に良かったと思っています"}, {"type": "subtitle", "time": 4145.51, "timestamp": "01:09:05", "text": "。ねえ、あなたを気の毒に思います"}, {"type": "subtitle", "time": 4149.11, "timestamp": "01:09:09", "text": "。素敵な一"}, {"type": "subtitle", "time": 4151.749, "timestamp": "01:09:11", "text": "日を過ごして、"}, {"type": "subtitle", "time": 4153.189, "timestamp": "01:09:13", "text": "あの人たちと一緒に正気を失わないように願っています。」"}, {"type": "subtitle", "time": 4155.11, "timestamp": "01:09:15", "text": "カミラは、まるで「ああ、なんてこと」と言っているかのように、カミラの目が"}, {"type": "subtitle", "time": 4161.99, "timestamp": "01:09:21", "text": "。"}, {"type": "subtitle", "time": 4164.39, "timestamp": "01:09:24", "text": "まあ、彼女は「"}, {"type": "subtitle", "time": 4169.669, "timestamp": "01:09:29", "text": "あなたのフラワーガールと楽しんでくださいね」と言うでしょう。"}, {"type": "subtitle", "time": 4172.789, "timestamp": "01:09:32", "text": "それでも、発情した"}, {"type": "subtitle", "time": 4181.43, "timestamp": "01:09:41", "text": "まあ、"}, {"type": "subtitle", "time": 4184.55, "timestamp": "01:09:44", "text": "私のチームは発情していて"}, {"type": "subtitle", "time": 4186.87, "timestamp": "01:09:46", "text": "血に飢えているかもしれませんが、"}, {"type": "subtitle", "time": 4189.43, "timestamp": "01:09:49", "text": "実際には、いいえ、いいえ、彼女は"}, {"type": "subtitle", "time": 4190.789, "timestamp": "01:09:50", "text": "発情しているとは言いません。彼女は決してそんなことは"}, {"type": "subtitle", "time": 4193.51, "timestamp": "01:09:53", "text": "言いません。洗練されていません。"}, {"type": "subtitle", "time": 4197.43, "timestamp": "01:09:57", "text": "私のパーティーは血に飢えていて、ええと、"}]
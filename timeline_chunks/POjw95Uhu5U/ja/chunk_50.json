[{"type": "subtitle", "time": 3000.63, "timestamp": "00:50:00", "text": "青。"}, {"type": "subtitle", "time": 3004.79, "timestamp": "00:50:04", "text": "あなたにとって良い選択肢がたくさんありますよ。"}, {"type": "subtitle", "time": 3005.67, "timestamp": "00:50:05", "text": "うん。"}, {"type": "subtitle", "time": 3011.829, "timestamp": "00:50:11", "text": "。 うん。 ああ、なんてことだ"}, {"type": "subtitle", "time": 3014.15, "timestamp": "00:50:14", "text": "。 確か、"}, {"type": "subtitle", "time": 3015.75, "timestamp": "00:50:15", "text": "ドルイドのプレイヤーがいて、そのプレイヤーは"}, {"type": "subtitle", "time": 3018.87, "timestamp": "00:50:18", "text": "金属を加熱する能力を持っていて、"}, {"type": "subtitle", "time": 3022.549, "timestamp": "00:50:22", "text": "騎士タイプの"}, {"type": "subtitle", "time": 3025.109, "timestamp": "00:50:25", "text": "キャラクターと戦わなければならなかったんだけど、そのプレイヤーは、その可哀想な"}, {"type": "subtitle", "time": 3028.79, "timestamp": "00:50:28", "text": "男の体に付いていた金属を加熱して、その金属を体と"}, {"type": "subtitle", "time": 3030.71, "timestamp": "00:50:30", "text": "融合させて拷問したんだ"}, {"type": "subtitle", "time": 3035.109, "timestamp": "00:50:35", "text": "。 それは残酷だった。   もちろんさ"}, {"type": "subtitle", "time": 3037.91, "timestamp": "00:50:37", "text": "。"}, {"type": "subtitle", "time": 3041.27, "timestamp": "00:50:41", "text": "ジョー、ドルイドについて知っておくべきなのは、"}, {"type": "subtitle", "time": 3043.19, "timestamp": "00:50:43", "text": "ドルイドは"}, {"type": "subtitle", "time": 3045.67, "timestamp": "00:50:45", "text": "放火犯である自然を愛する人々だというよくある誤解だ。"}, {"type": "subtitle", "time": 3047.109, "timestamp": "00:50:47", "text": "その通り。"}, {"type": "subtitle", "time": 3048.47, "timestamp": "00:50:48", "text": "うん。 だからこそ、ワイルドファイア・"}, {"type": "subtitle", "time": 3051.109, "timestamp": "00:50:51", "text": "ドルイドのサブツリー"}, {"type": "subtitle", "time": 3052.79, "timestamp": "00:50:52", "text": "愛好家が存在するのです。 彼らは不審なほど"}, {"type": "subtitle", "time": 3054.87, "timestamp": "00:50:54", "text": "大量の炎魔法を操る。"}, {"type": "subtitle", "time": 3056.63, "timestamp": "00:50:56", "text": "うん。"}, {"type": "subtitle", "time": 3058.39, "timestamp": "00:50:58", "text": "大丈夫。 彼らはまさに"}]
[{"type": "subtitle", "time": 7922.39, "timestamp": "02:12:02", "text": "。   何てことだ"}, {"type": "subtitle", "time": 7925.53, "timestamp": "02:12:05", "text": "。"}, {"type": "subtitle", "time": 7927.27, "timestamp": "02:12:07", "text": "[音楽]"}, {"type": "subtitle", "time": 7932.709, "timestamp": "02:12:12", "text": "どこにありますか？ 被害箇所はどこですか"}, {"type": "subtitle", "time": 7935.189, "timestamp": "02:12:15", "text": "？ あらら。 ああ、あそこにあるよ。 わかった。"}, {"type": "subtitle", "time": 7937.43, "timestamp": "02:12:17", "text": "21. わかりました。 私はおそらく「"}, {"type": "subtitle", "time": 7939.43, "timestamp": "02:12:19", "text": "失敗したのか？」をやるでしょう。"}, {"type": "subtitle", "time": 7943.189, "timestamp": "02:12:23", "text": "ええ、そうですね。  DCは14でした。わかりました。 それだけを見てください"}, {"type": "subtitle", "time": 7944.629, "timestamp": "02:12:24", "text": "。 ステファン、君に"}, {"type": "subtitle", "time": 7946.47, "timestamp": "02:12:26", "text": "健康ダメージを与えるつもりだ。 はい、どうぞ。 適用する。"}, {"type": "subtitle", "time": 7947.35, "timestamp": "02:12:27", "text": "痛い。   わかった"}, {"type": "subtitle", "time": 7949.99, "timestamp": "02:12:29", "text": "。 よし。 さあ、これから触手のように伸び始めるよ"}, {"type": "subtitle", "time": 7954.31, "timestamp": "02:12:34", "text": "。"}, {"type": "subtitle", "time": 7956.149, "timestamp": "02:12:36", "text": "アリアナ、君は触手"}, {"type": "subtitle", "time": 7956.47, "timestamp": "02:12:36", "text": "リストの筆頭だよ。"}, {"type": "subtitle", "time": 7959.189, "timestamp": "02:12:39", "text": "なぜアリアナなの？"}, {"type": "subtitle", "time": 7961.75, "timestamp": "02:12:41", "text": "なぜいつもアリアナだけが"}, {"type": "subtitle", "time": 7964.629, "timestamp": "02:12:44", "text": "強力な触手攻撃の標的になるのか？ はい、どうぞ。"}, {"type": "subtitle", "time": 7966.95, "timestamp": "02:12:46", "text": "なぜこれほど大きな被害をもたらすのか？   何てことだ"}, {"type": "subtitle", "time": 7969.43, "timestamp": "02:12:49", "text": "。 触手。 よし。"}, {"type": "subtitle", "time": 7970.709, "timestamp": "02:12:50", "text": "大きな模倣者。"}, {"type": "subtitle", "time": 7972.47, "timestamp": "02:12:52", "text": "うん。 うん。 また、"}, {"type": "subtitle", "time": 7974.229, "timestamp": "02:12:54", "text": "クリティカルチェックも必要になります。"}, {"type": "subtitle", "time": 7976.229, "timestamp": "02:12:56", "text": "アドバンテージ。 批評をさせてください。 わかった。"}, {"type": "subtitle", "time": 7977.189, "timestamp": "02:12:57", "text": "批判なし。   わかった"}, {"type": "subtitle", "time": 7979.99, "timestamp": "02:12:59", "text": "。 よし。 ええと、わかりました。 そして今、それはその役割を果たそうとしています"}]
[{"type": "subtitle", "time": 7742.709, "timestamp": "02:09:02", "text": "50歳まで生き延びたんだ？"}, {"type": "subtitle", "time": 7745.83, "timestamp": "02:09:05", "text": "説明させてください。 説明させてください。 つまり、"}, {"type": "subtitle", "time": 7747.589, "timestamp": "02:09:07", "text": "あなたは字を書くこともできないし、"}, {"type": "subtitle", "time": 7752.31, "timestamp": "02:09:12", "text": "猫。   何てことだ"}, {"type": "subtitle", "time": 7753.669, "timestamp": "02:09:13", "text": "。"}, {"type": "subtitle", "time": 7757.03, "timestamp": "02:09:17", "text": "5＋7です。 ええと、"}, {"type": "subtitle", "time": 7759.109, "timestamp": "02:09:19", "text": "ショートサードの5＋ダガーの7＋"}, {"type": "subtitle", "time": 7763.669, "timestamp": "02:09:23", "text": "16＋8＋6。"}, {"type": "subtitle", "time": 7766.069, "timestamp": "02:09:26", "text": "えっと、"}, {"type": "subtitle", "time": 7767.83, "timestamp": "02:09:27", "text": "途中であと10くらい追加し忘れたかもしれない"}, {"type": "subtitle", "time": 7768.87, "timestamp": "02:09:28", "text": "けど、それでも「一体"}, {"type": "subtitle", "time": 7780.229, "timestamp": "02:09:40", "text": "それはただの5 + 3 + 16 + 4です。"}, {"type": "subtitle", "time": 7781.91, "timestamp": "02:09:41", "text": "ええ、"}, {"type": "subtitle", "time": 7783.91, "timestamp": "02:09:43", "text": "大丈夫ですよ。 私たちは皆、"}, {"type": "subtitle", "time": 7787.03, "timestamp": "02:09:47", "text": "数学がわからない。"}, {"type": "subtitle", "time": 7788.229, "timestamp": "02:09:48", "text": "選手たちは数学が分からない。   そういうことなんです。だから"}, {"type": "subtitle", "time": 7789.91, "timestamp": "02:09:49", "text": "オンラインで遊ぶんです。そうすれば、"}, {"type": "subtitle", "time": 7793.91, "timestamp": "02:09:53", "text": "現実世界で計算する必要がなくなるんです。 本当にその通りですね。   何てことだ"}, {"type": "subtitle", "time": 7796.59, "timestamp": "02:09:56", "text": "。"}, {"type": "subtitle", "time": 7799.109, "timestamp": "02:09:59", "text": "[音楽]"}]
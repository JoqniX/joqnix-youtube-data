[{"type": "subtitle", "time": 2040.389, "timestamp": "00:34:00", "text": "医者が私に"}, {"type": "subtitle", "time": 2041.669, "timestamp": "00:34:01", "text": "床を転がらせて、「ああ、もしあなたが"}, {"type": "subtitle", "time": 2043.75, "timestamp": "00:34:03", "text": "このように転がるなら、それはあなたがADHDだということです」と言ったことなんです。 そして"}, {"type": "subtitle", "time": 2046.07, "timestamp": "00:34:06", "text": "私は「わからない」と答えた。"}, {"type": "subtitle", "time": 2049.19, "timestamp": "00:34:09", "text": "何？  ADHDの人は、どのように物事の捉え方が"}, {"type": "subtitle", "time": 2051.03, "timestamp": "00:34:11", "text": "異なるのでしょうか？"}, {"type": "subtitle", "time": 2052.23, "timestamp": "00:34:12", "text": "子供たち。"}, {"type": "subtitle", "time": 2054.31, "timestamp": "00:34:14", "text": "うん。 私はまるで小さな子供みたいだったけど、"}, {"type": "subtitle", "time": 2055.829, "timestamp": "00:34:15", "text": "彼らは「ああ、そうか。"}, {"type": "subtitle", "time": 2057.829, "timestamp": "00:34:17", "text": "頭から転がるんだ。それはADHDってことだ」って言ったんだ。 それが一体何に関係あるのか、私にはさっぱり分かりません"}, {"type": "subtitle", "time": 2060.069, "timestamp": "00:34:20", "text": "。"}, {"type": "subtitle", "time": 2062.47, "timestamp": "00:34:22", "text": "うん。 みんな頭から転がるものだと思っていた"}, {"type": "subtitle", "time": 2064.71, "timestamp": "00:34:24", "text": "。"}, {"type": "subtitle", "time": 2067.03, "timestamp": "00:34:27", "text": "いやいや、彼らはまるで"}, {"type": "subtitle", "time": 2070.069, "timestamp": "00:34:30", "text": "丘を転がり落ちるように、横向きに転がっているんです。"}, {"type": "subtitle", "time": 2071.99, "timestamp": "00:34:31", "text": "おお。"}, {"type": "subtitle", "time": 2078.389, "timestamp": "00:34:38", "text": "私は今でも、まっすぐな坂道が好きではありません。"}, {"type": "subtitle", "time": 2081.909, "timestamp": "00:34:41", "text": "ええ、正直に言うと、私は真っ当な道を歩むと思っていたんです"}, {"type": "subtitle", "time": 2086.23, "timestamp": "00:34:46", "text": "。"}, {"type": "subtitle", "time": 2089.27, "timestamp": "00:34:49", "text": "彼らが何を見たのか、私にはよく分かりません。"}, {"type": "subtitle", "time": 2091.109, "timestamp": "00:34:51", "text": "しかし、彼らの言うことは正しかった。 うまくいったよ"}]
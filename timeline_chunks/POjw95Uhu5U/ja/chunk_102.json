[{"type": "subtitle", "time": 6120.31, "timestamp": "01:42:00", "text": "起こると気付いた。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 6125.109, "timestamp": "01:42:05", "text": "えーっと、もう一度、えーっと、"}, {"type": "subtitle", "time": 6127.99, "timestamp": "01:42:07", "text": "何て言うんだっけ。えーっと、お知らせします。"}, {"type": "subtitle", "time": 6130.07, "timestamp": "01:42:10", "text": "ええ。では、すぐに"}, {"type": "subtitle", "time": 6132.95, "timestamp": "01:42:12", "text": "戦闘に入ります。えーっと。"}, {"type": "subtitle", "time": 6135.669, "timestamp": "01:42:15", "text": "よし。戦闘。でも、これはいつもの"}, {"type": "subtitle", "time": 6137.51, "timestamp": "01:42:17", "text": "戦闘ではありません。"}, {"type": "subtitle", "time": 6139.59, "timestamp": "01:42:19", "text": "後でわかります。わかりました。わかりました。"}, {"type": "subtitle", "time": 6141.75, "timestamp": "01:42:21", "text": "そうすると、アリアナとクリスが"}, {"type": "subtitle", "time": 6142.87, "timestamp": "01:42:22", "text": "調査しているとき、"}, {"type": "subtitle", "time": 6144.55, "timestamp": "01:42:24", "text": "ちなみにターン順は表示されません。"}, {"type": "subtitle", "time": 6146.39, "timestamp": "01:42:26", "text": "ああ、ええ。心配しないでください。まだ始めていません。ずっと持っていたので"}, {"type": "subtitle", "time": 6149.83, "timestamp": "01:42:29", "text": "。ええ。わかりました"}, {"type": "subtitle", "time": 6153.59, "timestamp": "01:42:33", "text": "。ここで止めます。マイナスの"}, {"type": "subtitle", "time": 6157.43, "timestamp": "01:42:37", "text": "力を持っていると確信しています。わかりました"}, {"type": "subtitle", "time": 6160.229, "timestamp": "01:42:40", "text": "。ええ、そうすると、アリアナ"}, {"type": "subtitle", "time": 6163.51, "timestamp": "01:42:43", "text": "とアリアナの入り口が調査しているときに回転します。"}, {"type": "subtitle", "time": 6168.79, "timestamp": "01:42:48", "text": "触れた瞬間に、それは実際にあなたにくっつき、それを何て言うんだっけ、"}, {"type": "subtitle", "time": 6176.95, "timestamp": "01:42:56", "text": "あなたの手を噛み始めるはずで、そしてもちろん、"}]
[{"type": "subtitle", "time": 6181.43, "timestamp": "01:43:01", "text": "クソ、もちろんそれは"}, {"type": "subtitle", "time": 6186.55, "timestamp": "01:43:06", "text": "手を噛みちぎられそうだ。クソみたいなクソが"}, {"type": "subtitle", "time": 6193.51, "timestamp": "01:43:13", "text": "驚いたんだろう？"}, {"type": "subtitle", "time": 6194.87, "timestamp": "01:43:14", "text": "この時点でなんで驚いたんだろう？"}, {"type": "subtitle", "time": 6197.43, "timestamp": "01:43:17", "text": "ああ、もう。"}, {"type": "subtitle", "time": 6199.75, "timestamp": "01:43:19", "text": "とにかくこの意図は。やりすぎだ。よし。それから、うん。オーケー。"}, {"type": "subtitle", "time": 6211.75, "timestamp": "01:43:31", "text": "大丈夫。今は、えーと、また何て言うんだっけ"}, {"type": "subtitle", "time": 6213.91, "timestamp": "01:43:33", "text": "。ああ、そうだ。待って。これは利点だと思う。"}, {"type": "subtitle", "time": 6220.79, "timestamp": "01:43:40", "text": "ランチを食べているときに"}, {"type": "subtitle", "time": 6224.39, "timestamp": "01:43:44", "text": "アリアナのやつが好きで、君を擁護してくれるようなものだから。"}, {"type": "subtitle", "time": 6226.87, "timestamp": "01:43:46", "text": "オーケー。うん。オーケー。えーと、じゃあ"}, {"type": "subtitle", "time": 6239.43, "timestamp": "01:43:59", "text": "[音楽] ちょっと聞いてくれ"}]
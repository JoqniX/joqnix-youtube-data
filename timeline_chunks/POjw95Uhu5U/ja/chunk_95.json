[{"type": "subtitle", "time": 5700.149, "timestamp": "01:35:00", "text": "。 彼はただ、今のところ"}, {"type": "subtitle", "time": 5702.07, "timestamp": "01:35:02", "text": "できる限りのことを偵察させているだけです"}, {"type": "subtitle", "time": 5702.95, "timestamp": "01:35:02", "text": "。 わかりました。 わかりました。"}, {"type": "subtitle", "time": 5708.47, "timestamp": "01:35:08", "text": "クリスマンは、"}, {"type": "subtitle", "time": 5713.75, "timestamp": "01:35:13", "text": "私たちが進む可能性のあるすべての道を少なくとも通過しました。"}, {"type": "subtitle", "time": 5716.39, "timestamp": "01:35:16", "text": "注目すべき唯一のことは、"}, {"type": "subtitle", "time": 5719.03, "timestamp": "01:35:19", "text": "この場所の一方の端に"}, {"type": "subtitle", "time": 5722.95, "timestamp": "01:35:22", "text": "金の噴水があるということですが、どうやらそこはとても熱いようです。 また、"}, {"type": "subtitle", "time": 5729.11, "timestamp": "01:35:29", "text": "どこかに通じるドアもありますが、どこに通じているのか"}, {"type": "subtitle", "time": 5731.91, "timestamp": "01:35:31", "text": "わかりません。"}, {"type": "subtitle", "time": 5735.51, "timestamp": "01:35:35", "text": "だから、調べてみましょう。"}, {"type": "subtitle", "time": 5738.47, "timestamp": "01:35:38", "text": "探索する時でしょうか？ おそらく、"}, {"type": "subtitle", "time": 5743.27, "timestamp": "01:35:43", "text": "それがそこでできる唯一のことだと思います"}, {"type": "subtitle", "time": 5754.07, "timestamp": "01:35:54", "text": "誰かが"}, {"type": "subtitle", "time": 5756.149, "timestamp": "01:35:56", "text": "待っていたのか不思議です。"}]
[{"type": "subtitle", "time": 3420.95, "timestamp": "00:57:00", "text": "消え去った。 皆さん、よく休めましたか？"}, {"type": "subtitle", "time": 3421.349, "timestamp": "00:57:01", "text": "うん。"}, {"type": "subtitle", "time": 3425.51, "timestamp": "00:57:05", "text": "ほら、ほら、ティック、あれはただの幻覚だったんだよ。   先にも"}, {"type": "subtitle", "time": 3428.63, "timestamp": "00:57:08", "text": "言ったように、"}, {"type": "subtitle", "time": 3431.589, "timestamp": "00:57:11", "text": "それは単なる幻想です。"}, {"type": "subtitle", "time": 3443.109, "timestamp": "00:57:23", "text": "とにかく、"}, {"type": "subtitle", "time": 3444.549, "timestamp": "00:57:24", "text": "アリアンは「"}, {"type": "subtitle", "time": 3446.549, "timestamp": "00:57:26", "text": "キーランはまだ寝ていると思う」と言うでしょう。"}, {"type": "subtitle", "time": 3449.51, "timestamp": "00:57:29", "text": "大丈夫。"}, {"type": "subtitle", "time": 3451.109, "timestamp": "00:57:31", "text": "カヌーで彼女を連れて行くことができます。"}, {"type": "subtitle", "time": 3454.309, "timestamp": "00:57:34", "text": "はい、折りたたみが簡単で"}, {"type": "subtitle", "time": 3457.03, "timestamp": "00:57:37", "text": "着やすいです。"}, {"type": "subtitle", "time": 3459.91, "timestamp": "00:57:39", "text": "クリス、君が先だ。"}, {"type": "subtitle", "time": 3462.39, "timestamp": "00:57:42", "text": "いや、またか。"}, {"type": "subtitle", "time": 3463.589, "timestamp": "00:57:43", "text": "はい。"}, {"type": "subtitle", "time": 3465.67, "timestamp": "00:57:45", "text": "聞いてください、何かあれば、ああ、やばい。"}, {"type": "subtitle", "time": 3467.829, "timestamp": "00:57:47", "text": "エルサ、懐中電灯をちょうだい。"}, {"type": "subtitle", "time": 3468.87, "timestamp": "00:57:48", "text": "このキャラクターでは彼が見えないことを忘れていました。"}, {"type": "subtitle", "time": 3470.63, "timestamp": "00:57:50", "text": "ああ、ジャガイモ。 ジャガイモは動かせると思いますよ"}, {"type": "subtitle", "time": 3471.67, "timestamp": "00:57:51", "text": "。"}, {"type": "subtitle", "time": 3472.47, "timestamp": "00:57:52", "text": "おお。"}, {"type": "subtitle", "time": 3473.03, "timestamp": "00:57:53", "text": "ああ、そうですね。   でき"}, {"type": "subtitle", "time": 3474.15, "timestamp": "00:57:54", "text": "ない、できない、できない。"}, {"type": "subtitle", "time": 3477.27, "timestamp": "00:57:57", "text": "これは私の魔法の懐中電灯です。 ジャガイモ。"}, {"type": "subtitle", "time": 3479.27, "timestamp": "00:57:59", "text": "確認させてください。 持続する。"}, {"type": "subtitle", "time": 3479.99, "timestamp": "00:57:59", "text": "じゃがいも。"}]
[{"type": "subtitle", "time": 6960.79, "timestamp": "01:56:00", "text": "ロール。わかった。それは憂鬱だ。"}, {"type": "subtitle", "time": 6963.52, "timestamp": "01:56:03", "text": "それは憂鬱だ。 お前はクソより遅い。"}, {"type": "subtitle", "time": 6969.589, "timestamp": "01:56:09", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 6972.47, "timestamp": "01:56:12", "text": "それは憂鬱だ。おい、それは"}, {"type": "subtitle", "time": 6975.51, "timestamp": "01:56:15", "text": "憂鬱だよ、相棒。本当に"}, {"type": "subtitle", "time": 6976.229, "timestamp": "01:56:16", "text": "ごめん。"}, {"type": "subtitle", "time": 6979.669, "timestamp": "01:56:19", "text": "それは憂鬱だ。ああ なんてこった。"}, {"type": "subtitle", "time": 6981.27, "timestamp": "01:56:21", "text": "そうだ、兄弟。"}, {"type": "subtitle", "time": 6987.75, "timestamp": "01:56:27", "text": "さて、暗殺者が行くぞ。"}, {"type": "subtitle", "time": 6989.35, "timestamp": "01:56:29", "text": "君の暗殺者だ。"}, {"type": "subtitle", "time": 6994.55, "timestamp": "01:56:34", "text": "ちくしょう。なんて暗殺だ。なんてこった。ちくしょう。よし"}, {"type": "subtitle", "time": 6998.47, "timestamp": "01:56:38", "text": "、じゃあ、"}, {"type": "subtitle", "time": 7006.31, "timestamp": "01:56:46", "text": "あのねえ？待って、あのねえ？"}, {"type": "subtitle", "time": 7009.589, "timestamp": "01:56:49", "text": "だって私は親切だから、えっと、私の"}, {"type": "subtitle", "time": 7011.27, "timestamp": "01:56:51", "text": "ハンターをKaにあげる。"}, {"type": "subtitle", "time": 7014.149, "timestamp": "01:56:54", "text": "君に実際に戦ってほしいんだ。私の"}, {"type": "subtitle", "time": 7016.55, "timestamp": "01:56:56", "text": "イニシアチブをあげる。うん"}, {"type": "subtitle", "time": 7019.51, "timestamp": "01:56:59", "text": "。うん。"}]
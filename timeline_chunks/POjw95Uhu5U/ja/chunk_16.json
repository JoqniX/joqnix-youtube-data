[{"type": "subtitle", "time": 961.03, "timestamp": "00:16:01", "text": "彼は皮膚を取り戻すことができる。 大丈夫だよ、"}, {"type": "subtitle", "time": 964.79, "timestamp": "00:16:04", "text": "みんな。 完全に。"}, {"type": "subtitle", "time": 966.55, "timestamp": "00:16:06", "text": "イベントでは、スキンケア製品の販売も開始されます"}, {"type": "subtitle", "time": 972.47, "timestamp": "00:16:12", "text": "兄弟、兄弟、俺はあのクソ野郎をやらなきゃいけないんだ、"}, {"type": "subtitle", "time": 975.269, "timestamp": "00:16:15", "text": "ほぼ間違いない。 待って、それは彼女"}, {"type": "subtitle", "time": 978.23, "timestamp": "00:16:18", "text": "自身のようにチームで協議するの？ 兄は"}, {"type": "subtitle", "time": 980.79, "timestamp": "00:16:20", "text": "今の段階で、万が一のためにそれを必要としている"}, {"type": "subtitle", "time": 983.03, "timestamp": "00:16:23", "text": "。"}, {"type": "subtitle", "time": 985.189, "timestamp": "00:16:25", "text": "アリアナは、"}, {"type": "subtitle", "time": 987.749, "timestamp": "00:16:27", "text": "以前自分で見つけた巻物もまだ持っている。"}, {"type": "subtitle", "time": 988.87, "timestamp": "00:16:28", "text": "誰が持っているのか？"}, {"type": "subtitle", "time": 990.79, "timestamp": "00:16:30", "text": "アリアナは巻物を持っている。"}, {"type": "subtitle", "time": 993.829, "timestamp": "00:16:33", "text": "ああ、そうなんですか？ ああ、アリアナはそれを持っているの？"}, {"type": "subtitle", "time": 994.31, "timestamp": "00:16:34", "text": "はい。   それもらっても"}, {"type": "subtitle", "time": 1008.55, "timestamp": "00:16:48", "text": "彼がそれを学べるように。 彼は、えっと、"}, {"type": "subtitle", "time": 1010.87, "timestamp": "00:16:50", "text": "自己を変容させるのは"}, {"type": "subtitle", "time": 1011.829, "timestamp": "00:16:51", "text": "儀式だと思うんだけど、そうだよね？   そうなんですか"}, {"type": "subtitle", "time": 1016.23, "timestamp": "00:16:56", "text": "？ 忘れた。  Alter self は、"}, {"type": "subtitle", "time": 1019.749, "timestamp": "00:16:59", "text": "えっと、もう一度確認させてください。 うーん、そうは思わないな"}]
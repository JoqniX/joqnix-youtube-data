[{"type": "subtitle", "time": 3361.589, "timestamp": "00:56:01", "text": "けど、それはすごくサディスティックな感じなんだ。"}, {"type": "subtitle", "time": 3365.99, "timestamp": "00:56:05", "text": "うん、カミラはちょっと退屈だよね。 つまり、嫌いな"}, {"type": "subtitle", "time": 3372.87, "timestamp": "00:56:12", "text": "それならそれでいいでしょう。   わーい"}, {"type": "subtitle", "time": 3374.23, "timestamp": "00:56:14", "text": "。"}, {"type": "subtitle", "time": 3375.27, "timestamp": "00:56:15", "text": "チクッ。"}, {"type": "subtitle", "time": 3375.589, "timestamp": "00:56:15", "text": "神。"}, {"type": "subtitle", "time": 3377.03, "timestamp": "00:56:17", "text": "でたらめだ。   私の"}, {"type": "subtitle", "time": 3380.549, "timestamp": "00:56:20", "text": "人生でそう願う。"}, {"type": "subtitle", "time": 3382.63, "timestamp": "00:56:22", "text": "えっと、私には既にグリムがいます。 私もそれを"}, {"type": "subtitle", "time": 3387.43, "timestamp": "00:56:27", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 3395.43, "timestamp": "00:56:35", "text": "そうそう。 えっと、私たちは"}, {"type": "subtitle", "time": 3397.67, "timestamp": "00:56:37", "text": "今から"}, {"type": "subtitle", "time": 3398.95, "timestamp": "00:56:38", "text": "歩き始めるのでしょうか？ あなたがそこを通り抜けるのを待っていました"}, {"type": "subtitle", "time": 3399.99, "timestamp": "00:56:39", "text": "。"}, {"type": "subtitle", "time": 3401.829, "timestamp": "00:56:41", "text": "うん。"}, {"type": "subtitle", "time": 3403.109, "timestamp": "00:56:43", "text": "アリアナが起きる。"}, {"type": "subtitle", "time": 3406.47, "timestamp": "00:56:46", "text": "オーケー、って感じになるよ。 わかった。 やあ、調子はどう"}, {"type": "subtitle", "time": 3408.789, "timestamp": "00:56:48", "text": "？ 気分はどうですか？"}, {"type": "subtitle", "time": 3411.67, "timestamp": "00:56:51", "text": "肌が元に戻ったね。"}, {"type": "subtitle", "time": 3413.99, "timestamp": "00:56:53", "text": "先ほど彼女が言っていたように、幻想は消え去った。"}, {"type": "subtitle", "time": 3415.67, "timestamp": "00:56:55", "text": "ついに肌が元に戻ったんですね。"}, {"type": "subtitle", "time": 3418.309, "timestamp": "00:56:58", "text": "うん。 うん。 幻想は"}]
[{"type": "subtitle", "time": 5220.07, "timestamp": "01:27:00", "text": "「負けた。」なんてこった"}, {"type": "subtitle", "time": 5222.149, "timestamp": "01:27:02", "text": "。"}, {"type": "subtitle", "time": 5224.55, "timestamp": "01:27:04", "text": "彼女は満面の笑みを浮かべてこれを見ていると思う"}, {"type": "subtitle", "time": 5227.91, "timestamp": "01:27:07", "text": "。"}, {"type": "subtitle", "time": 5229.59, "timestamp": "01:27:09", "text": "カミラは「見て、彼女が友達を作ってる」って感じ"}, {"type": "subtitle", "time": 5230.6, "timestamp": "01:27:10", "text": "。"}, {"type": "subtitle", "time": 5233.59, "timestamp": "01:27:13", "text": "[音楽]"}, {"type": "subtitle", "time": 5235.75, "timestamp": "01:27:15", "text": "ティックはとても誇りに思っています。"}, {"type": "subtitle", "time": 5238.31, "timestamp": "01:27:18", "text": "ティックと取引していただき、本当にありがとうございます。"}, {"type": "subtitle", "time": 5241.99, "timestamp": "01:27:21", "text": "よし。えっと、"}, {"type": "subtitle", "time": 5243.83, "timestamp": "01:27:23", "text": "カミラは「"}, {"type": "subtitle", "time": 5247.99, "timestamp": "01:27:27", "text": "お金をありがとう」って言うだけでしょう。どういたしまして。"}, {"type": "subtitle", "time": 5252.07, "timestamp": "01:27:32", "text": "ティックと取引していただき、本当にありがとうございます。ティックはとても感謝しています。"}, {"type": "subtitle", "time": 5255.669, "timestamp": "01:27:35", "text": "よし。"}, {"type": "subtitle", "time": 5258.229, "timestamp": "01:27:38", "text": "取引が終わったら、"}, {"type": "subtitle", "time": 5259.51, "timestamp": "01:27:39", "text": "帰りましょう。"}, {"type": "subtitle", "time": 5261.43, "timestamp": "01:27:41", "text": "カミラはただ歩いているだけです。彼女は"}, {"type": "subtitle", "time": 5263.43, "timestamp": "01:27:43", "text": "呆然として転びました。彼女があなたが"}, {"type": "subtitle", "time": 5268.31, "timestamp": "01:27:48", "text": "彼女を騙したことに気づく前に、帰りましょう。"}, {"type": "subtitle", "time": 5270.79, "timestamp": "01:27:50", "text": "入って、T。"}, {"type": "subtitle", "time": 5273.11, "timestamp": "01:27:53", "text": "それを添付しましょう。"}, {"type": "subtitle", "time": 5278.87, "timestamp": "01:27:58", "text": "彼女があなたが何をしたかに気づく前に、それをジョックに渡しましょう。"}, {"type": "subtitle", "time": 5279.669, "timestamp": "01:27:59", "text": "あなたが何をしたか。"}]
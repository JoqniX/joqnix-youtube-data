[{"type": "subtitle", "time": 1082.549, "timestamp": "00:18:02", "text": "それは間違いなく問題になるだろう。 しかし、"}, {"type": "subtitle", "time": 1085.19, "timestamp": "00:18:05", "text": "誰にも分からない。"}, {"type": "subtitle", "time": 1088.15, "timestamp": "00:18:08", "text": "レイが僧侶のようになる時にそれが起こるのを見たい。"}, {"type": "subtitle", "time": 1090.23, "timestamp": "00:18:10", "text": "なぜならそれは"}, {"type": "subtitle", "time": 1098.39, "timestamp": "00:18:18", "text": "実際に自分が激怒するかどうか見てみよう。 もし私がレベルを"}, {"type": "subtitle", "time": 1100.71, "timestamp": "00:18:20", "text": "上げて攻撃しなかった場合、"}, {"type": "subtitle", "time": 1104.39, "timestamp": "00:18:24", "text": "現時点でどれくらいのダメージを与えていることになるでしょうか？ えっと、"}, {"type": "subtitle", "time": 1107.83, "timestamp": "00:18:27", "text": "警告攻撃の大斧"}, {"type": "subtitle", "time": 1110.07, "timestamp": "00:18:30", "text": "。"}, {"type": "subtitle", "time": 1118.95, "timestamp": "00:18:38", "text": "くそ。  2倍の2。 ああ、これは本当に"}, {"type": "subtitle", "time": 1119.669, "timestamp": "00:18:39", "text": "批評だ。"}, {"type": "subtitle", "time": 1127.59, "timestamp": "00:18:47", "text": "彼を批判する。 何てことだ。 それって、"}, {"type": "subtitle", "time": 1131.35, "timestamp": "00:18:51", "text": "クリティカルヒットの狂乱状態ってことだよね。"}, {"type": "subtitle", "time": 1132.789, "timestamp": "00:18:52", "text": "批評家の熱狂。 もちろんさ。   何てことだ"}, {"type": "subtitle", "time": 1134.07, "timestamp": "00:18:54", "text": "。"}, {"type": "subtitle", "time": 1136.23, "timestamp": "00:18:56", "text": "ああ、それはまさに危機的状況だ。 熱狂はどこにある"}, {"type": "subtitle", "time": 1139.75, "timestamp": "00:18:59", "text": "？ あった。   何てことだ"}]
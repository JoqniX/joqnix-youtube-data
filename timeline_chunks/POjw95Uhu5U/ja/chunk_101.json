[{"type": "subtitle", "time": 6060.149, "timestamp": "01:41:00", "text": "、でも待ってみよう。"}, {"type": "subtitle", "time": 6064.07, "timestamp": "01:41:04", "text": "心配しないで。ああ、なんてことだ。441。"}, {"type": "subtitle", "time": 6066.39, "timestamp": "01:41:06", "text": "人生は最悪だ。"}, {"type": "subtitle", "time": 6067.59, "timestamp": "01:41:07", "text": "ああ、やれやれ。"}, {"type": "subtitle", "time": 6068.95, "timestamp": "01:41:08", "text": "プラス5。"}, {"type": "subtitle", "time": 6070.629, "timestamp": "01:41:10", "text": "まあ、"}, {"type": "subtitle", "time": 6074.95, "timestamp": "01:41:14", "text": "これが生きているかもしれないなんて、一瞬たりとも考えなかったよ。"}, {"type": "subtitle", "time": 6077.109, "timestamp": "01:41:17", "text": "正直、私も。それも考えなかった"}, {"type": "subtitle", "time": 6079.91, "timestamp": "01:41:19", "text": "。だから、うわぁ。私たちはやられたと思う"}, {"type": "subtitle", "time": 6082.149, "timestamp": "01:41:22", "text": "。"}, {"type": "subtitle", "time": 6085.669, "timestamp": "01:41:25", "text": "大きな金の像。"}, {"type": "subtitle", "time": 6092.47, "timestamp": "01:41:32", "text": "この"}, {"type": "subtitle", "time": 6095.99, "timestamp": "01:41:35", "text": "大きな金の像のために大きな。聞いてくれ、"}, {"type": "subtitle", "time": 6098.07, "timestamp": "01:41:38", "text": "私たちは複数の"}, {"type": "subtitle", "time": 6100.95, "timestamp": "01:41:40", "text": "像を通り抜けてきたが、どれも生きていなかった。だから"}, {"type": "subtitle", "time": 6103.99, "timestamp": "01:41:43", "text": "聞いてくれ、私たちはこれを予想していなかった。"}, {"type": "subtitle", "time": 6106.47, "timestamp": "01:41:46", "text": "私たちは、そうだった。"}, {"type": "subtitle", "time": 6107.59, "timestamp": "01:41:47", "text": "そう、私たちは"}, {"type": "chat", "time": 6107.943, "timestamp": "01:41:47", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ_yAK5S3_9EP-duW6Qo"}, {"type": "subtitle", "time": 6111.109, "timestamp": "01:41:51", "text": "彼らに偽りの安心感を与えた。"}, {"type": "subtitle", "time": 6113.43, "timestamp": "01:41:53", "text": "まさにその通り。まさにそれが起こった。うわぁ。そうは思わ"}, {"type": "subtitle", "time": 6116.39, "timestamp": "01:41:56", "text": "ない。わかった。"}, {"type": "subtitle", "time": 6119.03, "timestamp": "01:41:59", "text": "これが"}]
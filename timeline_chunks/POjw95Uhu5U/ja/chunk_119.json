[{"type": "subtitle", "time": 7141.51, "timestamp": "01:59:01", "text": "今朝はあそこは本当に暑かったから、そうね。"}, {"type": "subtitle", "time": 7143.99, "timestamp": "01:59:03", "text": "うん。"}, {"type": "subtitle", "time": 7147.99, "timestamp": "01:59:07", "text": "冬の私。"}, {"type": "subtitle", "time": 7150.149, "timestamp": "01:59:10", "text": "ここは嵐の天気だ。   何てことだ"}, {"type": "subtitle", "time": 7152.629, "timestamp": "01:59:12", "text": "。"}, {"type": "subtitle", "time": 7155.109, "timestamp": "01:59:15", "text": "今日の天気さえ知らない。 それはまるでランダムなようだ。   まるで"}, {"type": "subtitle", "time": 7157.27, "timestamp": "01:59:17", "text": "熱い雨のようだ。 熱い雨だよ、"}, {"type": "subtitle", "time": 7159.75, "timestamp": "01:59:19", "text": "兄弟。 私も同じです。 えっと、今朝は"}, {"type": "subtitle", "time": 7161.83, "timestamp": "01:59:21", "text": "すごく暑かったのに、午後には"}, {"type": "subtitle", "time": 7163.83, "timestamp": "01:59:23", "text": "また嵐みたいになっちゃったんです。 だから"}, {"type": "subtitle", "time": 7166.87, "timestamp": "01:59:26", "text": "私の喉はまるで死んだように痛むんです。 ああ、"}, {"type": "subtitle", "time": 7169.669, "timestamp": "01:59:29", "text": "最近の天気は本当に嫌いだ。   まるで"}, {"type": "subtitle", "time": 7171.83, "timestamp": "01:59:31", "text": "アジア、東南アジアの"}, {"type": "subtitle", "time": 7174.149, "timestamp": "01:59:34", "text": "天気のようだ。 暑くて乾燥した日もあれば、暑くて"}, {"type": "subtitle", "time": 7176.149, "timestamp": "01:59:36", "text": "湿気の多い日もあった。"}, {"type": "subtitle", "time": 7178.229, "timestamp": "01:59:38", "text": "二つの天気。 まあ。"}, {"type": "subtitle", "time": 7180.79, "timestamp": "01:59:40", "text": "うん。"}, {"type": "subtitle", "time": 7183.99, "timestamp": "01:59:43", "text": "ティックは試してみます。"}, {"type": "subtitle", "time": 7184.629, "timestamp": "01:59:44", "text": "ストライカーが欲しいか？"}, {"type": "subtitle", "time": 7187.109, "timestamp": "01:59:47", "text": "木にぶつかりたい。"}, {"type": "subtitle", "time": 7188.709, "timestamp": "01:59:48", "text": "これは虫に侵される"}, {"type": "subtitle", "time": 7195.589, "timestamp": "01:59:55", "text": "何を感染させようかな？ わからない"}, {"type": "subtitle", "time": 7199.99, "timestamp": "01:59:59", "text": "。 ダニがいます。 ダニがいる可能性があります。"}]
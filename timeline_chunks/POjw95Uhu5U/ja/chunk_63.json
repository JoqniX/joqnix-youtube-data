[{"type": "subtitle", "time": 3781.349, "timestamp": "01:03:01", "text": "前回と比べてもうすごく静かだね。前回は"}, {"type": "subtitle", "time": 3782.47, "timestamp": "01:03:02", "text": "みんなが歓声を上げていたのに。今はみんなが"}, {"type": "subtitle", "time": 3784.789, "timestamp": "01:03:04", "text": "掃除をしているみたい。"}, {"type": "subtitle", "time": 3786.63, "timestamp": "01:03:06", "text": "悪魔が"}, {"type": "subtitle", "time": 3789.91, "timestamp": "01:03:09", "text": "床をモップで拭いて、ゴミを拾っている。"}, {"type": "subtitle", "time": 3791.589, "timestamp": "01:03:11", "text": "彼らが株とか全部殺したわけじゃないって確信できるよね"}, {"type": "subtitle", "time": 3795.43, "timestamp": "01:03:15", "text": "。株のこと"}, {"type": "subtitle", "time": 3797.67, "timestamp": "01:03:17", "text": "考えるのはやめよう。"}, {"type": "subtitle", "time": 3798.87, "timestamp": "01:03:18", "text": "株。"}, {"type": "subtitle", "time": 3802.95, "timestamp": "01:03:22", "text": "市場のこと以外で話してくれない"}, {"type": "subtitle", "time": 3807.829, "timestamp": "01:03:27", "text": "？今は株式市場以外のことについて話してくれない？今は"}, {"type": "subtitle", "time": 3809.91, "timestamp": "01:03:29", "text": "そういう時じゃない。"}, {"type": "subtitle", "time": 3813.349, "timestamp": "01:03:33", "text": "敵の株式市場？違う。"}, {"type": "subtitle", "time": 3815.589, "timestamp": "01:03:35", "text": "それは違う。"}, {"type": "subtitle", "time": 3821.829, "timestamp": "01:03:41", "text": "よし、株式市場を見よう。よし、こっちに行こう。"}, {"type": "subtitle", "time": 3823.75, "timestamp": "01:03:43", "text": "ちょっとこれをやらせてくれ。"}, {"type": "subtitle", "time": 3825.19, "timestamp": "01:03:45", "text": "これを明らかにしよう。"}, {"type": "subtitle", "time": 3827.589, "timestamp": "01:03:47", "text": "よし。ほら、"}, {"type": "subtitle", "time": 3829.27, "timestamp": "01:03:49", "text": "あそこで"}, {"type": "subtitle", "time": 3829.589, "timestamp": "01:03:49", "text": "くつろいでいるのが見えるでしょ。"}, {"type": "subtitle", "time": 3831.829, "timestamp": "01:03:51", "text": "カミラはどこ？"}, {"type": "subtitle", "time": 3836.63, "timestamp": "01:03:56", "text": "カミラ？ちょっと待って。"}, {"type": "subtitle", "time": 3839.99, "timestamp": "01:03:59", "text": "カミラはどこ？"}]
[{"type": "subtitle", "time": 4260.79, "timestamp": "01:11:00", "text": "彼女はただ「どうして私はここにいるの？"}, {"type": "subtitle", "time": 4264.55, "timestamp": "01:11:04", "text": "私は高潔な身分なので、このようなことに首を突っ込むべきではない"}, {"type": "subtitle", "time": 4269.189, "timestamp": "01:11:09", "text": "。"}, {"type": "subtitle", "time": 4270.87, "timestamp": "01:11:10", "text": "ペットにもあなたを抱きしめさせますよ"}, {"type": "subtitle", "time": 4282.47, "timestamp": "01:11:22", "text": "ハグ、ハグ"}, {"type": "subtitle", "time": 4284.07, "timestamp": "01:11:24", "text": "。"}, {"type": "subtitle", "time": 4286.55, "timestamp": "01:11:26", "text": "あのね？"}, {"type": "subtitle", "time": 4293.43, "timestamp": "01:11:33", "text": "ご家族と素敵な時間を過ごされているようで、私も嬉しいです。 皆さん、"}, {"type": "subtitle", "time": 4295.59, "timestamp": "01:11:35", "text": "彼らに少しスペースを空けてあげましょう。   まるで"}, {"type": "subtitle", "time": 4300.31, "timestamp": "01:11:40", "text": "彼女のささやき声が聞こえるように。 いいえ、結構です。"}, {"type": "subtitle", "time": 4303.59, "timestamp": "01:11:43", "text": "さあ、出てきて。 さあ、みんな出てきて。 さあ"}, {"type": "subtitle", "time": 4304.709, "timestamp": "01:11:44", "text": "、みんな出てきて。   ごめん"}, {"type": "subtitle", "time": 4307.27, "timestamp": "01:11:47", "text": "。 バイバイ。 そうしよう。"}, {"type": "subtitle", "time": 4310.229, "timestamp": "01:11:50", "text": "うん。 入ってきなさい。こっちへ来なさい、ジョック。"}, {"type": "subtitle", "time": 4314.229, "timestamp": "01:11:54", "text": "彼にプライバシーを与えてあげましょう。   置いていかないでください"}, {"type": "subtitle", "time": 4316.79, "timestamp": "01:11:56", "text": "。 満足させることはできません。"}]
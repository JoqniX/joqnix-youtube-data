[{"type": "subtitle", "time": 3300.95, "timestamp": "00:55:00", "text": "これは、"}, {"type": "subtitle", "time": 3303.51, "timestamp": "00:55:03", "text": "物語の最初の大きな部分のようなもので、"}, {"type": "subtitle", "time": 3307.589, "timestamp": "00:55:07", "text": "狩りをしながら、誰もが一度しかチャンスを与えられ、"}, {"type": "subtitle", "time": 3310.87, "timestamp": "00:55:10", "text": "戦いを通して互いを知り、"}, {"type": "subtitle", "time": 3313.19, "timestamp": "00:55:13", "text": "そして一緒に冒険に出かけ、"}, {"type": "subtitle", "time": 3317.03, "timestamp": "00:55:17", "text": "トラウマを通して絆を深めていく。 もちろんさ。"}, {"type": "subtitle", "time": 3319.109, "timestamp": "00:55:19", "text": "うん。 一緒にいられるように、まずはトラウマによる絆を築かなければならない"}, {"type": "subtitle", "time": 3320.87, "timestamp": "00:55:20", "text": "。"}, {"type": "subtitle", "time": 3323.19, "timestamp": "00:55:23", "text": "うん。 だから、"}, {"type": "subtitle", "time": 3325.19, "timestamp": "00:55:25", "text": "この仕事が終わっても、私たちは外出するときはいつも一緒にいるんです。 でも、"}, {"type": "subtitle", "time": 3328.63, "timestamp": "00:55:28", "text": "大体そういう話なんです。   私たちは皆、"}, {"type": "subtitle", "time": 3335.27, "timestamp": "00:55:35", "text": "このダンジョンの外でも仲良しで一緒にパーティーができるように、旅を続けなければならない。"}, {"type": "subtitle", "time": 3336.309, "timestamp": "00:55:36", "text": "うん。"}, {"type": "subtitle", "time": 3341.67, "timestamp": "00:55:41", "text": "それで、相手側のカミラの方を見る。"}, {"type": "subtitle", "time": 3347.109, "timestamp": "00:55:47", "text": "ピックはカミラをきっと気に入るだろう。 私は気にしない。"}, {"type": "subtitle", "time": 3353.51, "timestamp": "00:55:53", "text": "まあ、他の政党は間違いなく"}, {"type": "subtitle", "time": 3356.47, "timestamp": "00:55:56", "text": "カミラを好んでいない。 つまり、彼らは彼女を崇拝しているんだ"}]
[{"type": "subtitle", "time": 4020.47, "timestamp": "01:07:00", "text": "私たちの邪魔をしないでくれ。"}, {"type": "subtitle", "time": 4022.95, "timestamp": "01:07:02", "text": "それで、他の階はどこ？えっと"}, {"type": "subtitle", "time": 4030.95, "timestamp": "01:07:10", "text": "次の階について何か知ってる"}, {"type": "subtitle", "time": 4032.069, "timestamp": "01:07:12", "text": "？"}, {"type": "subtitle", "time": 4035.829, "timestamp": "01:07:15", "text": "手がかり。"}, {"type": "subtitle", "time": 4045.75, "timestamp": "01:07:25", "text": "だから、お前らクソ野郎どもは本当に先回りして"}, {"type": "subtitle", "time": 4047.589, "timestamp": "01:07:27", "text": "偵察しようとしてるんだな。オーケー、"}, {"type": "subtitle", "time": 4049.029, "timestamp": "01:07:29", "text": "彼はただそれをささやいているだけだ。"}, {"type": "subtitle", "time": 4051.51, "timestamp": "01:07:31", "text": "私たちはしなかった。私たちはひどく傷ついて"}, {"type": "subtitle", "time": 4053.829, "timestamp": "01:07:33", "text": "野蛮だった。"}, {"type": "subtitle", "time": 4056.15, "timestamp": "01:07:36", "text": "私たちが対処しなければならなかったあのテストプールのアリーナで戦う必要はなかった"}, {"type": "subtitle", "time": 4057.19, "timestamp": "01:07:37", "text": "。"}, {"type": "subtitle", "time": 4059.589, "timestamp": "01:07:39", "text": "ピギーはそれが起こって本当に申し訳なく思っている。彼は"}, {"type": "subtitle", "time": 4062.069, "timestamp": "01:07:42", "text": "君を愛している。"}, {"type": "subtitle", "time": 4063.99, "timestamp": "01:07:43", "text": "君の努力に心から感謝する。"}, {"type": "subtitle", "time": 4074.15, "timestamp": "01:07:54", "text": "アリーナで優勝しておめでとう。私は、ええと、"}]
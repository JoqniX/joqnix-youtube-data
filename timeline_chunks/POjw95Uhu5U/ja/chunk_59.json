[{"type": "subtitle", "time": 3543.67, "timestamp": "00:59:03", "text": "まさに。"}, {"type": "subtitle", "time": 3546.47, "timestamp": "00:59:06", "text": "ティックは大きくて強い男の子だから、"}, {"type": "subtitle", "time": 3549.75, "timestamp": "00:59:09", "text": "トーチを取ってくる。 はい、トーチです。 はい、"}, {"type": "subtitle", "time": 3555.99, "timestamp": "00:59:15", "text": "カナダは、"}, {"type": "subtitle", "time": 3557.589, "timestamp": "00:59:17", "text": "馬がどういうわけかジャガイモに変わってしまったのに、"}, {"type": "subtitle", "time": 3563.27, "timestamp": "00:59:23", "text": "それを受け入れたみたいだね。 0.2秒で受け入れる 時間。"}, {"type": "subtitle", "time": 3564.95, "timestamp": "00:59:24", "text": "うん。"}, {"type": "subtitle", "time": 3567.03, "timestamp": "00:59:27", "text": "彼はただ、もういいや、このまま進め、って感じ"}, {"type": "subtitle", "time": 3571.43, "timestamp": "00:59:31", "text": "。"}, {"type": "subtitle", "time": 3573.08, "timestamp": "00:59:33", "text": "私は"}, {"type": "subtitle", "time": 3575.99, "timestamp": "00:59:35", "text": "[音楽]"}, {"type": "subtitle", "time": 3577.03, "timestamp": "00:59:37", "text": "大丈夫です、"}, {"type": "subtitle", "time": 3579.19, "timestamp": "00:59:39", "text": "サー。よし。待って、"}, {"type": "subtitle", "time": 3580.309, "timestamp": "00:59:40", "text": "階段を下りてくるよ。"}, {"type": "subtitle", "time": 3582.95, "timestamp": "00:59:42", "text": "うん。階段を下りてくる。君は今"}, {"type": "subtitle", "time": 3584.71, "timestamp": "00:59:44", "text": "その場所に座ったところだ。"}, {"type": "subtitle", "time": 3586.549, "timestamp": "00:59:46", "text": "全員のロードが完了したら教えてくれ。"}, {"type": "subtitle", "time": 3587.27, "timestamp": "00:59:47", "text": "うん、"}, {"type": "subtitle", "time": 3589.829, "timestamp": "00:59:49", "text": "みんなゆっくりになってる。うん。"}, {"type": "subtitle", "time": 3591.67, "timestamp": "00:59:51", "text": "うん、そう思う。うん、ダイナミック"}, {"type": "subtitle", "time": 3593.349, "timestamp": "00:59:53", "text": "ライティングをオフにしたおかげで、確かに少し"}, {"type": "subtitle", "time": 3595.99, "timestamp": "00:59:55", "text": "速くなった。なんてこった。よし。本当にごめん。"}]
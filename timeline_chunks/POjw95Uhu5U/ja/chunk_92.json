[{"type": "subtitle", "time": 5520.39, "timestamp": "01:32:00", "text": "。最後のは何なんだ？…？"}, {"type": "subtitle", "time": 5525.91, "timestamp": "01:32:05", "text": "君が選んでくれ。"}, {"type": "subtitle", "time": 5527.51, "timestamp": "01:32:07", "text": "釣り竿だ。"}, {"type": "subtitle", "time": 5527.83, "timestamp": "01:32:07", "text": "知らないよ。"}, {"type": "subtitle", "time": 5529.51, "timestamp": "01:32:09", "text": "釣り竿。そう、釣り竿。はい、釣り竿。はい。ああ。オーケー。あ"}, {"type": "subtitle", "time": 5532.229, "timestamp": "01:32:12", "text": "、こんにちは。こんにちは。はい。"}, {"type": "subtitle", "time": 5535.59, "timestamp": "01:32:15", "text": "トカゲ。大丈夫？"}, {"type": "subtitle", "time": 5537.99, "timestamp": "01:32:17", "text": "声は大丈夫？"}, {"type": "subtitle", "time": 5541.51, "timestamp": "01:32:21", "text": "君の声は美しいよ。え？こんにちは。"}, {"type": "subtitle", "time": 5545.83, "timestamp": "01:32:25", "text": "あと、エレベーターの"}, {"type": "subtitle", "time": 5547.27, "timestamp": "01:32:27", "text": "音楽を消さなきゃ。つまり、ダンジョンの"}, {"type": "subtitle", "time": 5550.149, "timestamp": "01:32:30", "text": "音楽って言ってたよね。いいね。私の側で"}, {"type": "subtitle", "time": 5552.39, "timestamp": "01:32:32", "text": "技術的な問題があっただけだと思う​​。"}, {"type": "subtitle", "time": 5554.95, "timestamp": "01:32:34", "text": "君はまるで ロボット。"}, {"type": "subtitle", "time": 5556.55, "timestamp": "01:32:36", "text": "アリアナ、先にどうぞ。"}, {"type": "subtitle", "time": 5559.189, "timestamp": "01:32:39", "text": "あれは私の？"}, {"type": "subtitle", "time": 5559.669, "timestamp": "01:32:39", "text": "え？あ"}, {"type": "subtitle", "time": 5561.99, "timestamp": "01:32:41", "text": "、違う。"}, {"type": "subtitle", "time": 5564.629, "timestamp": "01:32:44", "text": "うん、クリスはいいよ。クリセン。"}, {"type": "subtitle", "time": 5565.43, "timestamp": "01:32:45", "text": "こんにちは。うん"}, {"type": "subtitle", "time": 5565.669, "timestamp": "01:32:45", "text": "。"}, {"type": "subtitle", "time": 5567.03, "timestamp": "01:32:47", "text": "ああ、うん。いや、あれは私。"}, {"type": "subtitle", "time": 5569.03, "timestamp": "01:32:49", "text": "これは何？これもまだ"}, {"type": "subtitle", "time": 5569.27, "timestamp": "01:32:49", "text": "同じ？わかった。うん。うん。わかった"}, {"type": "subtitle", "time": 5571.51, "timestamp": "01:32:51", "text": "。えーと、端の方に、ちょっと"}, {"type": "subtitle", "time": 5573.11, "timestamp": "01:32:53", "text": "待って。見せるよ"}, {"type": "subtitle", "time": 5575.189, "timestamp": "01:32:55", "text": "。えーと、みんなが見えるようにGMビューに切り替えよう"}, {"type": "subtitle", "time": 5576.39, "timestamp": "01:32:56", "text": "。うん。あれは"}]
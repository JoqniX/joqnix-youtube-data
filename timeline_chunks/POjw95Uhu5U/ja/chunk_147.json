[{"type": "subtitle", "time": 8822.389, "timestamp": "02:27:02", "text": "。 それは、それは、それは、それは、それは、"}, {"type": "subtitle", "time": 8825.429, "timestamp": "02:27:05", "text": "今は崩れた彫像のようなものです。"}, {"type": "subtitle", "time": 8827.67, "timestamp": "02:27:07", "text": "崩れた像だが、金色のように見えるが、"}, {"type": "subtitle", "time": 8830.07, "timestamp": "02:27:10", "text": "確かに金色に見える。 見た目は"}, {"type": "subtitle", "time": 8835.75, "timestamp": "02:27:15", "text": "もし"}, {"type": "subtitle", "time": 8838.63, "timestamp": "02:27:18", "text": "残りの彫像が生きているとしたら、"}, {"type": "subtitle", "time": 8840.15, "timestamp": "02:27:20", "text": "それを残りの彫像に任せるのはとても面白いだろう、と言っているだけだと思う"}, {"type": "subtitle", "time": 8842.23, "timestamp": "02:27:22", "text": "。   何てことだ"}, {"type": "subtitle", "time": 8845.349, "timestamp": "02:27:25", "text": "。 もう一度やるべきか？   何てことだ"}, {"type": "subtitle", "time": 8848.71, "timestamp": "02:27:28", "text": "。 わかった。 よし。 ちょっと待ってください、"}, {"type": "subtitle", "time": 8851.19, "timestamp": "02:27:31", "text": "これはすぐに済ませます。 はい、もう一度戻ってみましょう"}, {"type": "subtitle", "time": 8853.51, "timestamp": "02:27:33", "text": "。 ダンジョン。 わかった。   よし"}, {"type": "subtitle", "time": 8854.79, "timestamp": "02:27:34", "text": "。   返してくれ"}, {"type": "subtitle", "time": 8857.19, "timestamp": "02:27:37", "text": "。   わかった"}, {"type": "subtitle", "time": 8858.389, "timestamp": "02:27:38", "text": "。   これに少し"}, {"type": "subtitle", "time": 8864.389, "timestamp": "02:27:44", "text": "手を置いて使ってもいいですか"}, {"type": "subtitle", "time": 8866.95, "timestamp": "02:27:46", "text": "。 はい、どうぞ。"}, {"type": "subtitle", "time": 8867.67, "timestamp": "02:27:47", "text": "ありがとう。   わかった"}, {"type": "subtitle", "time": 8868.55, "timestamp": "02:27:48", "text": "。"}, {"type": "subtitle", "time": 8872.07, "timestamp": "02:27:52", "text": "君に10ヒットポイントを与えるよ。   よし"}, {"type": "subtitle", "time": 8874.23, "timestamp": "02:27:54", "text": "。 あなたはKaに触れることで10ヒット"}, {"type": "subtitle", "time": 8875.83, "timestamp": "02:27:55", "text": "ポイントを獲得します。 どうぞ。   はい、どうぞ"}, {"type": "subtitle", "time": 8877.99, "timestamp": "02:27:57", "text": "。 それを押してください。"}, {"type": "subtitle", "time": 8879.83, "timestamp": "02:27:59", "text": "彼女は満腹ですか？ いいえ。"}]
[{"type": "subtitle", "time": 4920.95, "timestamp": "01:22:00", "text": "子供の"}, {"type": "subtitle", "time": 4924.709, "timestamp": "01:22:04", "text": "育て方に大きく関わっています。 それで、もっと良い方法があるかどうか知りたいんです"}, {"type": "subtitle", "time": 4927.43, "timestamp": "01:22:07", "text": "。   つまり、もっと高い料金を"}, {"type": "subtitle", "time": 4931.35, "timestamp": "01:22:11", "text": "請求すべきだと言っているのですか？"}, {"type": "subtitle", "time": 4932.79, "timestamp": "01:22:12", "text": "ピックは、私たちが"}, {"type": "subtitle", "time": 4937.91, "timestamp": "01:22:17", "text": "友達だから料金を安くするべきだと考えていると思っている、そうでしょう？   だから、なぜ"}, {"type": "subtitle", "time": 4945.669, "timestamp": "01:22:25", "text": "私がそこに行ったのか自分でもわからないんです。"}, {"type": "subtitle", "time": 4947.51, "timestamp": "01:22:27", "text": "あなたの両親はあなたを本当に素晴らしい人間に育てたと思っていたからです"}, {"type": "subtitle", "time": 4951.03, "timestamp": "01:22:31", "text": "。 だからTは大きな存在だった。なぜなら、"}, {"type": "subtitle", "time": 4953.03, "timestamp": "01:22:33", "text": "ティックは君の両親は素晴らしいことをしたと思っているからだ。"}, {"type": "subtitle", "time": 4958.709, "timestamp": "01:22:38", "text": "私を説得しようとしてもらえませんか？"}, {"type": "subtitle", "time": 4971.35, "timestamp": "01:22:51", "text": "指導は本当に面白いと思う。"}, {"type": "subtitle", "time": 4973.35, "timestamp": "01:22:53", "text": "面白いね。"}]
[{"type": "subtitle", "time": 7682.709, "timestamp": "02:08:02", "text": "どこからダメージから52という数字が出てきたんだ"}, {"type": "subtitle", "time": 7688.47, "timestamp": "02:08:08", "text": "そう、合計ダメージは、あなたが"}, {"type": "subtitle", "time": 7690.55, "timestamp": "02:08:10", "text": "振った結果によるものです。 つまり、8"}, {"type": "subtitle", "time": 7693.99, "timestamp": "02:08:13", "text": "＋16＋6、"}, {"type": "subtitle", "time": 7696.47, "timestamp": "02:08:16", "text": "それにさらに7と"}, {"type": "subtitle", "time": 7698.069, "timestamp": "02:08:18", "text": "5を足すということです。"}, {"type": "subtitle", "time": 7699.51, "timestamp": "02:08:19", "text": "待って、30 と数えたんだけど。"}, {"type": "subtitle", "time": 7701.99, "timestamp": "02:08:21", "text": "いや、それはちょっと待って。 待って、待って、ちょっと待って。"}, {"type": "subtitle", "time": 7704.31, "timestamp": "02:08:24", "text": "2回目の奇襲"}, {"type": "subtitle", "time": 7705.43, "timestamp": "02:08:25", "text": "攻撃は実際には適用されないので、"}, {"type": "subtitle", "time": 7707.51, "timestamp": "02:08:27", "text": "ダメージは最初の発生時のみなので、30と数えました。"}, {"type": "subtitle", "time": 7709.51, "timestamp": "02:08:29", "text": "ええ、それは私が"}, {"type": "subtitle", "time": 7711.51, "timestamp": "02:08:31", "text": "スニークアタックの16と6だけを適用しているということです。   たった"}, {"type": "subtitle", "time": 7713.51, "timestamp": "02:08:33", "text": "36だよ。ふざけんな。一体どこでそんなもの手に入れたんだ"}, {"type": "subtitle", "time": 7717.109, "timestamp": "02:08:37", "text": "？"}, {"type": "subtitle", "time": 7719.51, "timestamp": "02:08:39", "text": "マットはマットになっていません。"}, {"type": "subtitle", "time": 7722.95, "timestamp": "02:08:42", "text": "待って、いや、36じゃない。32だ。"}, {"type": "subtitle", "time": 7723.669, "timestamp": "02:08:43", "text": "あ、36。"}, {"type": "subtitle", "time": 7725.43, "timestamp": "02:08:45", "text": "いや、待って。 なぜ？ わかった。 そうそう。 そうそう。"}, {"type": "subtitle", "time": 7727.43, "timestamp": "02:08:47", "text": "32. でも、"}, {"type": "subtitle", "time": 7731.189, "timestamp": "02:08:51", "text": "デュアル wielder でない場合、"}, {"type": "subtitle", "time": 7733.91, "timestamp": "02:08:53", "text": "オフハンド武器で攻撃しても修正値に影響しないので、1 つも削除しました。"}, {"type": "subtitle", "time": 7736.069, "timestamp": "02:08:56", "text": "つまり、実際には合計28個くらいですね。"}, {"type": "subtitle", "time": 7738.069, "timestamp": "02:08:58", "text": "クラシック。 失読症の人。"}, {"type": "subtitle", "time": 7739.99, "timestamp": "02:08:59", "text": "どうやって、どうやって"}]
[{"type": "subtitle", "time": 9000.15, "timestamp": "02:30:00", "text": "知覚を与えてください。そして、それがどこにあるかを"}, {"type": "subtitle", "time": 9001.91, "timestamp": "02:30:01", "text": "覚えていれば、"}, {"type": "subtitle", "time": 9003.03, "timestamp": "02:30:03", "text": "プラスをあげますが、私はそれがどこにあるかは教えません"}, {"type": "subtitle", "time": 9005.27, "timestamp": "02:30:05", "text": "。"}, {"type": "subtitle", "time": 9006.79, "timestamp": "02:30:06", "text": "どこだったか覚えていますか？"}, {"type": "subtitle", "time": 9008.23, "timestamp": "02:30:08", "text": "クリスピンがいるまさにその場所。 だいたいその辺りだった"}, {"type": "subtitle", "time": 9010.15, "timestamp": "02:30:10", "text": "。"}, {"type": "subtitle", "time": 9012.07, "timestamp": "02:30:12", "text": "それは少し、"}, {"type": "subtitle", "time": 9013.91, "timestamp": "02:30:13", "text": "四角形の上の部分のような感じでした。 それは"}, {"type": "subtitle", "time": 9015.349, "timestamp": "02:30:15", "text": "中心部にはなかった。"}, {"type": "subtitle", "time": 9018.15, "timestamp": "02:30:18", "text": "ええ、そうでした。   それが元々立っていた"}, {"type": "subtitle", "time": 9020.07, "timestamp": "02:30:20", "text": "広場の中にある限り、問題ないと思いますよ"}, {"type": "subtitle", "time": 9024.71, "timestamp": "02:30:24", "text": "。 えっと、ちょっと覚えておこうと思います"}, {"type": "subtitle", "time": 9026.309, "timestamp": "02:30:26", "text": "。"}, {"type": "subtitle", "time": 9028.55, "timestamp": "02:30:28", "text": "ストリームを巻き戻す。"}, {"type": "subtitle", "time": 9030.389, "timestamp": "02:30:30", "text": "それは正気の沙汰ではない。 それは"}, {"type": "subtitle", "time": 9031.83, "timestamp": "02:30:31", "text": "すごく面白いだろうね。 実は、"}, {"type": "subtitle", "time": 9032.95, "timestamp": "02:30:32", "text": "私のものです。"}, {"type": "subtitle", "time": 9034.309, "timestamp": "02:30:34", "text": "あのね？"}, {"type": "subtitle", "time": 9037.99, "timestamp": "02:30:37", "text": "それって許されるの？"}, {"type": "subtitle", "time": 9046.389, "timestamp": "02:30:46", "text": "私の場合は、"}, {"type": "subtitle", "time": 9050.63, "timestamp": "02:30:50", "text": "心が活性化します。 私はストリームを見ている。"}, {"type": "subtitle", "time": 9052.389, "timestamp": "02:30:52", "text": "配信のリプレイを見てください。"}, {"type": "subtitle", "time": 9055.11, "timestamp": "02:30:55", "text": "彼は今、頭の中でこの配信のリプレイを見ている"}]
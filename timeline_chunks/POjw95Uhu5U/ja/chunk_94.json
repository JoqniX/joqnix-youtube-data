[{"type": "subtitle", "time": 5640.229, "timestamp": "01:34:00", "text": "金が滴っているように見えますが、"}, {"type": "subtitle", "time": 5641.35, "timestamp": "01:34:01", "text": "本当に冷たいのかどうかわかりません"}, {"type": "subtitle", "time": 5645.91, "timestamp": "01:34:05", "text": "。もし本当に金なら、ここは間違いなくもっと暑いはずです。"}, {"type": "subtitle", "time": 5649.83, "timestamp": "01:34:09", "text": "うわあ。彼が火に耐性があってよかった。"}, {"type": "subtitle", "time": 5651.51, "timestamp": "01:34:11", "text": "彼は暑さを気にしませんが、なんてこった"}, {"type": "subtitle", "time": 5655.83, "timestamp": "01:34:15", "text": "。ああ、面白い。"}, {"type": "subtitle", "time": 5659.11, "timestamp": "01:34:19", "text": "とても熱いものがあります。どうやら像が溶けているようです"}, {"type": "subtitle", "time": 5661.99, "timestamp": "01:34:21", "text": "。ええ。"}, {"type": "subtitle", "time": 5664.149, "timestamp": "01:34:24", "text": "溶けている像。像が溶けているとは気づきませんでした。"}, {"type": "subtitle", "time": 5667.27, "timestamp": "01:34:27", "text": "山です。噴水です。"}, {"type": "subtitle", "time": 5668.79, "timestamp": "01:34:28", "text": "噴水。ええ。"}, {"type": "subtitle", "time": 5669.35, "timestamp": "01:34:29", "text": "金で。"}, {"type": "subtitle", "time": 5670.87, "timestamp": "01:34:30", "text": "滴っています。 溶けた"}, {"type": "subtitle", "time": 5673.189, "timestamp": "01:34:33", "text": "金？"}, {"type": "subtitle", "time": 5677.75, "timestamp": "01:34:37", "text": "ええ。 面白いですね。"}, {"type": "subtitle", "time": 5681.43, "timestamp": "01:34:41", "text": "上昇し始めます。"}, {"type": "subtitle", "time": 5684.229, "timestamp": "01:34:44", "text": "特に"}, {"type": "subtitle", "time": 5687.669, "timestamp": "01:34:47", "text": "危険はないようですが、よくわかりません。"}, {"type": "subtitle", "time": 5689.99, "timestamp": "01:34:49", "text": "ええと、もし何か危険があれば、とっくに"}, {"type": "subtitle", "time": 5692.47, "timestamp": "01:34:52", "text": "死んでいるはずですが、"}, {"type": "subtitle", "time": 5694.629, "timestamp": "01:34:54", "text": "どうやら彼はまだ生きているようです。"}, {"type": "subtitle", "time": 5697.189, "timestamp": "01:34:57", "text": "ええ。 ええ"}]
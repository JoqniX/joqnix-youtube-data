[{"type": "subtitle", "time": 9062.07, "timestamp": "02:31:02", "text": "。   クソ重要な"}, {"type": "subtitle", "time": 9064.55, "timestamp": "02:31:04", "text": "マインド。   よし"}, {"type": "subtitle", "time": 9065.67, "timestamp": "02:31:05", "text": "。 じゃあ、君たちが"}, {"type": "subtitle", "time": 9066.79, "timestamp": "02:31:06", "text": "これをやっている間に、ちょっと"}, {"type": "subtitle", "time": 9068.23, "timestamp": "02:31:08", "text": "トイレに行ってくるね。   わかった"}, {"type": "subtitle", "time": 9068.79, "timestamp": "02:31:08", "text": "。"}, {"type": "subtitle", "time": 9070.71, "timestamp": "02:31:10", "text": "ああ、俺が"}, {"type": "subtitle", "time": 9073.349, "timestamp": "02:31:13", "text": "どの"}, {"type": "subtitle", "time": 9081.67, "timestamp": "02:31:21", "text": "イエス。 わかった。 一体どこなんだ？ はい、"}, {"type": "subtitle", "time": 9107.99, "timestamp": "02:31:47", "text": "確認する必要があります。"}, {"type": "subtitle", "time": 9110.63, "timestamp": "02:31:50", "text": "待って、まずゲームを確認する必要がある。"}, {"type": "subtitle", "time": 9114.23, "timestamp": "02:31:54", "text": "それはクロマティックオーブ以前のことですか？"}, {"type": "subtitle", "time": 9117.99, "timestamp": "02:31:57", "text": "確認してみます。 えっと、これは"}]
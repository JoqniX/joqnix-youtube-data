[{"type": "subtitle", "time": 9362.15, "timestamp": "02:36:02", "text": "クリスピンは、たくさんの廊下があるのを見て、"}, {"type": "subtitle", "time": 9366.95, "timestamp": "02:36:06", "text": "例えばこちら側には外が見える"}, {"type": "subtitle", "time": 9369.19, "timestamp": "02:36:09", "text": "穴があって、そこから"}, {"type": "subtitle", "time": 9372.95, "timestamp": "02:36:12", "text": "別の廊下につながっていることに気づきました。"}, {"type": "subtitle", "time": 9373.91, "timestamp": "02:36:13", "text": "はぁ。"}, {"type": "subtitle", "time": 9375.67, "timestamp": "02:36:15", "text": "そして、ここの端の方は、"}, {"type": "subtitle", "time": 9377.03, "timestamp": "02:36:17", "text": "押せるようになっているように見えます。 押してみますか"}, {"type": "subtitle", "time": 9377.67, "timestamp": "02:36:17", "text": "？"}, {"type": "subtitle", "time": 9378.95, "timestamp": "02:36:18", "text": "押せ。   わかった"}, {"type": "subtitle", "time": 9381.51, "timestamp": "02:36:21", "text": "。 押すと、えーと、"}, {"type": "subtitle", "time": 9383.51, "timestamp": "02:36:23", "text": "ドアが勝手に開くことに気づいて、"}, {"type": "subtitle", "time": 9387.51, "timestamp": "02:36:27", "text": "それで、走って行って、ええ"}, {"type": "subtitle", "time": 9389.59, "timestamp": "02:36:29", "text": "。"}, {"type": "subtitle", "time": 9393.59, "timestamp": "02:36:33", "text": "今まで気づかなかったのですが、ちょっと質問させてください。"}, {"type": "subtitle", "time": 9397.11, "timestamp": "02:36:37", "text": "ヴァンは一体なぜ、いわゆる「喋るゲイのジャガイモ」を持っているのでしょうか"}, {"type": "subtitle", "time": 9399.27, "timestamp": "02:36:39", "text": "？"}, {"type": "subtitle", "time": 9400.71, "timestamp": "02:36:40", "text": "それは懐中電灯です。"}, {"type": "subtitle", "time": 9403.19, "timestamp": "02:36:43", "text": "それは「"}, {"type": "subtitle", "time": 9406.469, "timestamp": "02:36:46", "text": "ああ、GLaDOSだ」という話になった。 私たちはGLaDOSが大好きです。"}, {"type": "subtitle", "time": 9407.91, "timestamp": "02:36:47", "text": "これらは何ですか？   わかった"}, {"type": "subtitle", "time": 9410.23, "timestamp": "02:36:50", "text": "。 ええと、あれは宝箱です。"}, {"type": "subtitle", "time": 9411.51, "timestamp": "02:36:51", "text": "開けてみますか？"}, {"type": "subtitle", "time": 9414.71, "timestamp": "02:36:54", "text": "ええと、クリスンズが宝箱の一つを開けます。"}, {"type": "subtitle", "time": 9417.19, "timestamp": "02:36:57", "text": "よし、クリスピン、宝箱の1つを開けて、"}, {"type": "subtitle", "time": 9419.91, "timestamp": "02:36:59", "text": "中からこれを見つけるんだ。ああ、なんてこった"}]
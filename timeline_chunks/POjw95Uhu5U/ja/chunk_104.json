[{"type": "subtitle", "time": 6245.59, "timestamp": "01:44:05", "text": "。ちょっと聞いてくれ。"}, {"type": "subtitle", "time": 6247.75, "timestamp": "01:44:07", "text": "なぜか店まで40分くらいかかったんだ。本当に面白かった"}, {"type": "subtitle", "time": 6250.229, "timestamp": "01:44:10", "text": "。でも40分もかかったんだ"}, {"type": "subtitle", "time": 6251.75, "timestamp": "01:44:11", "text": "。"}, {"type": "subtitle", "time": 6266.149, "timestamp": "01:44:26", "text": "友達を作ろうとしてるの？"}, {"type": "subtitle", "time": 6267.99, "timestamp": "01:44:27", "text": "みんな釣りに行くとき釣りが好きなんだ"}, {"type": "subtitle", "time": 6273.189, "timestamp": "01:44:33", "text": "。いや、パンが買えるよ。"}, {"type": "subtitle", "time": 6274.709, "timestamp": "01:44:34", "text": "少なくともパンは買えたでしょ"}, {"type": "subtitle", "time": 6276.39, "timestamp": "01:44:36", "text": "？ちょっと"}, {"type": "subtitle", "time": 6279.109, "timestamp": "01:44:39", "text": "待って。これがずっとボールなの？"}, {"type": "subtitle", "time": 6279.51, "timestamp": "01:44:39", "text": "いや、まだだよ"}, {"type": "subtitle", "time": 6282.149, "timestamp": "01:44:42", "text": "。私たちはただ、始めたばかりなんだ。"}, {"type": "subtitle", "time": 6283.75, "timestamp": "01:44:43", "text": "1つ目が終わりました。"}, {"type": "subtitle", "time": 6286.149, "timestamp": "01:44:46", "text": "えーと、私たちは先延ばしにして、"}, {"type": "subtitle", "time": 6288.55, "timestamp": "01:44:48", "text": "ただおしゃべりしていました。先延ばしにしておしゃべりして、それで、"}, {"type": "subtitle", "time": 6292.709, "timestamp": "01:44:52", "text": "カミラが出て行くことで"}, {"type": "subtitle", "time": 6297.71, "timestamp": "01:44:57", "text": "気絶したのを見逃しました。"}, {"type": "subtitle", "time": 6298.95, "timestamp": "01:44:58", "text": "[音楽]"}]
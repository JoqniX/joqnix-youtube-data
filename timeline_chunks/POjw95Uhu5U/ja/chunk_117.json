[{"type": "subtitle", "time": 7021.669, "timestamp": "01:57:01", "text": "私には能力がある。私には"}, {"type": "subtitle", "time": 7022.95, "timestamp": "01:57:02", "text": "それができる能力がある。"}, {"type": "subtitle", "time": 7024.87, "timestamp": "01:57:04", "text": "私には実際に能力がある。"}, {"type": "subtitle", "time": 7026.87, "timestamp": "01:57:06", "text": "うん。私には実際に"}, {"type": "subtitle", "time": 7028.55, "timestamp": "01:57:08", "text": "私たちの"}, {"type": "subtitle", "time": 7030.07, "timestamp": "01:57:10", "text": "イニシアチブを交換する能力がある。"}, {"type": "subtitle", "time": 7032.39, "timestamp": "01:57:12", "text": "うん、私は前線じゃない。"}, {"type": "subtitle", "time": 7039.99, "timestamp": "01:57:19", "text": "うん、"}, {"type": "subtitle", "time": 7043.75, "timestamp": "01:57:23", "text": "ジェイクとキオンと、えっと、"}, {"type": "subtitle", "time": 7047.27, "timestamp": "01:57:27", "text": "戦闘中のミミックしか見えないと思う tトラッカー。"}, {"type": "subtitle", "time": 7049.35, "timestamp": "01:57:29", "text": "待て、あれは擬態生物だ。"}, {"type": "subtitle", "time": 7050.55, "timestamp": "01:57:30", "text": "彼。"}, {"type": "subtitle", "time": 7053.189, "timestamp": "01:57:33", "text": "いや、あれは間違いなく彫像だよ。 ええ、あれは"}, {"type": "subtitle", "time": 7055.75, "timestamp": "01:57:35", "text": "彫像です。 それは、私たち皆が欲しくなるような、純粋な黄金の"}, {"type": "subtitle", "time": 7063.03, "timestamp": "01:57:43", "text": "。 ただそれを見て、「まるで"}, {"type": "subtitle", "time": 7069.75, "timestamp": "01:57:49", "text": "胃の底に潜んでいる奇妙な怪物みたいだ」と言いたかっただけなんです。"}, {"type": "subtitle", "time": 7070.07, "timestamp": "01:57:50", "text": "おお。"}, {"type": "subtitle", "time": 7076.47, "timestamp": "01:57:56", "text": "また、グリム、戦闘トラッカー"}, {"type": "subtitle", "time": 7078.39, "timestamp": "01:57:58", "text": "に表示されない場合は、攻撃するだけでいいと思います"}, {"type": "subtitle", "time": 7079.91, "timestamp": "01:57:59", "text": "。 ええと、"}]
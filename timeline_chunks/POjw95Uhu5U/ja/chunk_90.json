[{"type": "subtitle", "time": 5401.11, "timestamp": "01:30:01", "text": "大丈夫。"}, {"type": "subtitle", "time": 5403.59, "timestamp": "01:30:03", "text": "後で戻るよ。わかった。わかった。ありがとう。"}, {"type": "subtitle", "time": 5405.59, "timestamp": "01:30:05", "text": "ポケットに入れて。"}, {"type": "subtitle", "time": 5407.59, "timestamp": "01:30:07", "text": "バッグに入れて。ありがとう。"}, {"type": "subtitle", "time": 5410.31, "timestamp": "01:30:10", "text": "カヌーに入れて。"}, {"type": "subtitle", "time": 5419.99, "timestamp": "01:30:19", "text": "まさにその通り。そうだと思う。うん、そうだったね"}, {"type": "subtitle", "time": 5434.31, "timestamp": "01:30:34", "text": "みんな、すぐ戻るよ。"}, {"type": "subtitle", "time": 5440.629, "timestamp": "01:30:40", "text": "家族の緊急事態に対処しないといけないんだ。だから、すぐ戻るよ。でも、"}, {"type": "subtitle", "time": 5444.31, "timestamp": "01:30:44", "text": "楽しんでね。わかった、ちょっとミュートを解除するね。何も"}, {"type": "subtitle", "time": 5448.229, "timestamp": "01:30:48", "text": "好きじゃない。"}, {"type": "subtitle", "time": 5450.229, "timestamp": "01:30:50", "text": "後で置くだけ。"}, {"type": "subtitle", "time": 5453.03, "timestamp": "01:30:53", "text": "でも、うん、彼らの"}, {"type": "subtitle", "time": 5455.91, "timestamp": "01:30:55", "text": "会話などを楽しんでね。すぐ戻るよ。わかった。"}, {"type": "subtitle", "time": 5458.47, "timestamp": "01:30:58", "text": "怒りと悲しみが混ざったような感じ。だって"}, {"type": "subtitle", "time": 5459.88, "timestamp": "01:30:59", "text": "本当のことだから。"}]
[{"type": "subtitle", "time": 5884.55, "timestamp": "01:38:04", "text": "もし私がレイシアだったら、「"}, {"type": "subtitle", "time": 5886.87, "timestamp": "01:38:06", "text": "うん」と言うだろうけど、バッジのように、"}, {"type": "subtitle", "time": 5889.75, "timestamp": "01:38:09", "text": "これらを取ったら"}, {"type": "subtitle", "time": 5891.43, "timestamp": "01:38:11", "text": "すぐに床に何かが起こるかもしれない。"}, {"type": "subtitle", "time": 5895.75, "timestamp": "01:38:15", "text": "ああ、"}, {"type": "subtitle", "time": 5897.83, "timestamp": "01:38:17", "text": "チャンスがあるかもしれない。"}, {"type": "subtitle", "time": 5899.43, "timestamp": "01:38:19", "text": "これらは"}, {"type": "subtitle", "time": 5902.55, "timestamp": "01:38:22", "text": "金でできていて、欲張ると何かが起こるかもしれない。"}, {"type": "subtitle", "time": 5914.07, "timestamp": "01:38:34", "text": "最初に誤って何かを引き起こして、それから戻ってくるかもしれない。"}, {"type": "subtitle", "time": 5916.149, "timestamp": "01:38:36", "text": "うーん、それは良いかもしれないと思う。"}, {"type": "subtitle", "time": 5919.99, "timestamp": "01:38:39", "text": "解決策。えっと、"}, {"type": "subtitle", "time": 5923.03, "timestamp": "01:38:43", "text": "このフロアを悩ませているものを取り除けば、"}, {"type": "subtitle", "time": 5926.149, "timestamp": "01:38:46", "text": "戻ってこれらを入手できると思います。"}, {"type": "subtitle", "time": 5927.75, "timestamp": "01:38:47", "text": "よし、どこにいるんだ？"}, {"type": "subtitle", "time": 5930.31, "timestamp": "01:38:50", "text": "この金の像を調べろ。こっちに"}, {"type": "subtitle", "time": 5930.629, "timestamp": "01:38:50", "text": "来い。こっちに"}, {"type": "subtitle", "time": 5933.43, "timestamp": "01:38:53", "text": "来い、ティック。こっちに来い。シック。こっちに来い。さあ"}, {"type": "subtitle", "time": 5938.709, "timestamp": "01:38:58", "text": "、T。こんにちは。こんにちは。こんにちは。"}]
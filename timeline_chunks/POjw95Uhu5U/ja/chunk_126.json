[{"type": "subtitle", "time": 7560.229, "timestamp": "02:06:00", "text": "、これでいいよ。 うん。 え、"}, {"type": "subtitle", "time": 7562.55, "timestamp": "02:06:02", "text": "何？  6はassassinate（暗殺）から来ています。"}, {"type": "subtitle", "time": 7565.43, "timestamp": "02:06:05", "text": "ああ、そういうことだったんですね。 だって、"}, {"type": "subtitle", "time": 7568.95, "timestamp": "02:06:08", "text": "1つのD6に6の目が余分にあるんだから。"}, {"type": "subtitle", "time": 7575.75, "timestamp": "02:06:15", "text": "二刀流はまだできるよね？"}, {"type": "subtitle", "time": 7577.109, "timestamp": "02:06:17", "text": "ええ、短剣を2回使って、もう一度"}, {"type": "subtitle", "time": 7579.51, "timestamp": "02:06:19", "text": "短剣を使えますよ。 最初に"}, {"type": "subtitle", "time": 7583.189, "timestamp": "02:06:23", "text": "追加する短剣は、えーっと、何て言うんでしたっけ。 いや"}, {"type": "subtitle", "time": 7584.87, "timestamp": "02:06:24", "text": "、やっぱりいいです。 まるで忘れてしまったみたいだ"}, {"type": "subtitle", "time": 7586.79, "timestamp": "02:06:26", "text": "。 うん。 えっと、それはあなたの"}, {"type": "subtitle", "time": 7588.629, "timestamp": "02:06:28", "text": "短剣ではありません。"}, {"type": "subtitle", "time": 7590.229, "timestamp": "02:06:30", "text": "何？"}, {"type": "subtitle", "time": 7591.99, "timestamp": "02:06:31", "text": "いや、彼らは短剣を転がしたんだ。 一番上のやつ。"}, {"type": "subtitle", "time": 7592.069, "timestamp": "02:06:32", "text": "それは"}, {"type": "subtitle", "time": 7594.069, "timestamp": "02:06:34", "text": "短剣だった。 それは19でした。何？"}, {"type": "subtitle", "time": 7596.229, "timestamp": "02:06:36", "text": "待って。 えっと。 なんてこった。 ええ、それは分かりません"}, {"type": "subtitle", "time": 7597.669, "timestamp": "02:06:37", "text": "。 私が話しているんです。"}, {"type": "subtitle", "time": 7603.189, "timestamp": "02:06:43", "text": "新しいモジュールの新しいUIは、"}, {"type": "subtitle", "time": 7609.99, "timestamp": "02:06:49", "text": "アイテムの下に配置されているため、混乱を招いていると思います。"}, {"type": "subtitle", "time": 7613.109, "timestamp": "02:06:53", "text": "ああ、私の間違いだった。"}, {"type": "subtitle", "time": 7615.83, "timestamp": "02:06:55", "text": "つまり、やはり"}, {"type": "subtitle", "time": 7619.35, "timestamp": "02:06:59", "text": "イエスの方が有利ですよね。"}]
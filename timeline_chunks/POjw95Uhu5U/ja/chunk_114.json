[{"type": "subtitle", "time": 6848.229, "timestamp": "01:54:08", "text": "私はDMで、えっと、グッドベリー"}, {"type": "subtitle", "time": 6855.669, "timestamp": "01:54:15", "text": "中毒でハイになっている、あるいは"}, {"type": "subtitle", "time": 6861.03, "timestamp": "01:54:21", "text": "グッドベリーに復讐しているプレイヤーについて話していたんだ。それで、"}, {"type": "subtitle", "time": 6863.27, "timestamp": "01:54:23", "text": "D&Dのゲームで、グッドベリーを持った風刺ドルイドのキャラクターの"}, {"type": "subtitle", "time": 6865.43, "timestamp": "01:54:25", "text": "プレイヤーがいて、"}, {"type": "subtitle", "time": 6870.39, "timestamp": "01:54:30", "text": "基本的にグッドベリーは"}, {"type": "subtitle", "time": 6873.03, "timestamp": "01:54:33", "text": "ドラッグみたいなものだった、みんなに話したんだ。"}, {"type": "subtitle", "time": 6874.87, "timestamp": "01:54:34", "text": "うん。それに、"}, {"type": "subtitle", "time": 6878.79, "timestamp": "01:54:38", "text": "私のプレイヤーの一人にも似たようなことがあって、ほぼ"}, {"type": "subtitle", "time": 6881.03, "timestamp": "01:54:41", "text": "同じことが起こったんだ。グッド"}, {"type": "subtitle", "time": 6883.109, "timestamp": "01:54:43", "text": "ベリー中毒だったんだ。"}, {"type": "subtitle", "time": 6885.35, "timestamp": "01:54:45", "text": "うん。うん。そして、そのミームは"}, {"type": "subtitle", "time": 6887.589, "timestamp": "01:54:47", "text": "基本的に彼がいつもハイになっているからなんだ。だから、"}, {"type": "subtitle", "time": 6889.99, "timestamp": "01:54:49", "text": "パーティーが毎回「フライハイドローム」って言うたびに"}, {"type": "subtitle", "time": 6895.03, "timestamp": "01:54:55", "text": "うわあ。"}, {"type": "subtitle", "time": 6896.629, "timestamp": "01:54:56", "text": "フライハイドロ。"}]
[{"type": "subtitle", "time": 4801.91, "timestamp": "01:20:01", "text": "チックは、お金の"}, {"type": "subtitle", "time": 4803.83, "timestamp": "01:20:03", "text": "ないパーティーメンバーのために喜んでお金を払ってプレイするだろう。"}, {"type": "subtitle", "time": 4804.47, "timestamp": "01:20:04", "text": "どうしたの？"}, {"type": "subtitle", "time": 4806.79, "timestamp": "01:20:06", "text": "彼らは破産している。"}, {"type": "subtitle", "time": 4810.39, "timestamp": "01:20:10", "text": "ええ、彼女は"}, {"type": "subtitle", "time": 4813.11, "timestamp": "01:20:13", "text": "自然のマントルのために200が必要なんです。 そして、それが"}, {"type": "subtitle", "time": 4815.27, "timestamp": "01:20:15", "text": "ジョックにとって良いことだと私がはっきりと分かっているなら。"}, {"type": "subtitle", "time": 4817.43, "timestamp": "01:20:17", "text": "200."}, {"type": "subtitle", "time": 4819.75, "timestamp": "01:20:19", "text": "ジョック、君は"}, {"type": "subtitle", "time": 4821.75, "timestamp": "01:20:21", "text": "自分のお金を持っている。 カミラから購入したいですか？"}, {"type": "subtitle", "time": 4824.07, "timestamp": "01:20:24", "text": "100だよ。ジョックは100しか持ってないんだ。"}, {"type": "subtitle", "time": 4826.07, "timestamp": "01:20:26", "text": "そう、"}, {"type": "subtitle", "time": 4828.07, "timestamp": "01:20:28", "text": "100が市場価格なんだ。 ジェイクは君ならもっとできると思っているよ"}, {"type": "subtitle", "time": 4833.669, "timestamp": "01:20:33", "text": "なんでお前はクソみたいな"}, {"type": "subtitle", "time": 4835.83, "timestamp": "01:20:35", "text": "ハックルとクソみたいな車と交渉しないんだ？   よし"}, {"type": "subtitle", "time": 4840.31, "timestamp": "01:20:40", "text": "。 そう、あなたは「"}, {"type": "subtitle", "time": 4844.63, "timestamp": "01:20:44", "text": "オーマイゴッド」でハックルを刺激し続ける。"}, {"type": "subtitle", "time": 4848.63, "timestamp": "01:20:48", "text": "あのね？ 私はただこれを見守るだけです。"}, {"type": "subtitle", "time": 4853.35, "timestamp": "01:20:53", "text": "兄貴が"}, {"type": "subtitle", "time": 4855.189, "timestamp": "01:20:55", "text": "軟調な市場をどう扱うかを知っているかどうか、彼に見せる前に見守っていると言ったばかりで、"}, {"type": "subtitle", "time": 4859.35, "timestamp": "01:20:59", "text": "[音楽]は"}]
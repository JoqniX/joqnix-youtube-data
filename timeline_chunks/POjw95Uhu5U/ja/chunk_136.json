[{"type": "subtitle", "time": 8160.47, "timestamp": "02:16:00", "text": "まあ、それは後で対処すればいいでしょう。   わかった"}, {"type": "subtitle", "time": 8163.669, "timestamp": "02:16:03", "text": "。 よし、それでいい。 次は"}, {"type": "subtitle", "time": 8164.79, "timestamp": "02:16:04", "text": "ステファンです。"}, {"type": "subtitle", "time": 8167.43, "timestamp": "02:16:07", "text": "ヴァン、気をつけろ、金を持って行け。"}, {"type": "subtitle", "time": 8171.43, "timestamp": "02:16:11", "text": "みんな、気をつけろよ。 何かが私のお金を盗んだと思う"}, {"type": "subtitle", "time": 8173.35, "timestamp": "02:16:13", "text": "。   それは理解できます。 それは確かに理解できます"}, {"type": "subtitle", "time": 8177.43, "timestamp": "02:16:17", "text": "。"}, {"type": "subtitle", "time": 8179.03, "timestamp": "02:16:19", "text": "おっと。 私のミスです。 転がすつもりはなかったんです"}, {"type": "subtitle", "time": 8181.75, "timestamp": "02:16:21", "text": "。 私は「えっと、ちょっと先まで行ったかな」って感じでした"}, {"type": "subtitle", "time": 8184.069, "timestamp": "02:16:24", "text": "。 あまり近くにいるのは好きじゃないんです"}, {"type": "subtitle", "time": 8192.07, "timestamp": "02:16:32", "text": "？"}, {"type": "subtitle", "time": 8193.91, "timestamp": "02:16:33", "text": "攻撃するべきか、回復するべきか迷っています。"}, {"type": "subtitle", "time": 8196.87, "timestamp": "02:16:36", "text": "皆さんは、"}, {"type": "subtitle", "time": 8210.95, "timestamp": "02:16:50", "text": "私は一度だけ治癒するかもしれません。 たぶん、私は、たぶん、私は、くだらないことを"}, {"type": "subtitle", "time": 8219.91, "timestamp": "02:16:59", "text": "。 たった"}]
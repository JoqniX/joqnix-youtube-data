[{"type": "subtitle", "time": 6360.709, "timestamp": "01:46:00", "text": "私はスケールされたばかりです。ええ。ええ"}, {"type": "subtitle", "time": 6366.87, "timestamp": "01:46:06", "text": "。アクロバットのようなものが入っています"}, {"type": "subtitle", "time": 6369.43, "timestamp": "01:46:09", "text": "。"}, {"type": "subtitle", "time": 6371.99, "timestamp": "01:46:11", "text": "実際には、いいえ。あなたはすでに"}, {"type": "subtitle", "time": 6380.229, "timestamp": "01:46:20", "text": "大したことなの？"}, {"type": "subtitle", "time": 6384.47, "timestamp": "01:46:24", "text": "説得、洞察、調査、"}, {"type": "subtitle", "time": 6387.189, "timestamp": "01:46:27", "text": "追い詰める。内部調査、知覚、"}, {"type": "subtitle", "time": 6405.35, "timestamp": "01:46:45", "text": "[音楽]"}]
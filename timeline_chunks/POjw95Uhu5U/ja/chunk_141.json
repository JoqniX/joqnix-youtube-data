[{"type": "subtitle", "time": 8460.309, "timestamp": "02:21:00", "text": "テンプレートだけでどうやってチェックすればいいんだ？   やっちゃ"}, {"type": "subtitle", "time": 8468.63, "timestamp": "02:21:08", "text": "実際はファイアーボールだ。 豆知識。"}, {"type": "subtitle", "time": 8471.59, "timestamp": "02:21:11", "text": "ああ、なんてことだ。 いや。ファイアボールはここにいる全員を殺してしまうだろう"}, {"type": "subtitle", "time": 8472.95, "timestamp": "02:21:12", "text": "。 豆知識。   何てことだ"}, {"type": "subtitle", "time": 8475.67, "timestamp": "02:21:15", "text": "。 豆知識。"}, {"type": "subtitle", "time": 8479.429, "timestamp": "02:21:19", "text": "豆知識。 ファイアボールってマジで遠くまで飛ぶよね"}, {"type": "subtitle", "time": 8487.03, "timestamp": "02:21:27", "text": "どれくらい遠くまで行けるか見てみたい。"}, {"type": "subtitle", "time": 8488.63, "timestamp": "02:21:28", "text": "知っていた。"}, {"type": "subtitle", "time": 8491.59, "timestamp": "02:21:31", "text": "兄貴が「ちょっとテンプレートを確認するよ」と言った瞬間、私はすぐに分かった"}, {"type": "subtitle", "time": 8493.349, "timestamp": "02:21:33", "text": "。 最高に盛り上がるよ"}, {"type": "subtitle", "time": 8494.95, "timestamp": "02:21:34", "text": "。"}, {"type": "subtitle", "time": 8496.87, "timestamp": "02:21:36", "text": "たとえ当たったとしても、どれくらい遠くまで飛ぶのだろうか"}, {"type": "subtitle", "time": 8500.469, "timestamp": "02:21:40", "text": "？ おお。 あ、ちょっと待って。 持続する。"}, {"type": "subtitle", "time": 8503.429, "timestamp": "02:21:43", "text": "だめだ。だめだ。お願いだからやめてくれ。"}, {"type": "subtitle", "time": 8505.67, "timestamp": "02:21:45", "text": "火球は30フィート（約9メートル）先まで届くのか、それとももっと遠くまで届くのか？"}, {"type": "subtitle", "time": 8511.51, "timestamp": "02:21:51", "text": "忘れた。  60。60か60。ああ、なんてことだ。"}, {"type": "subtitle", "time": 8513.429, "timestamp": "02:21:53", "text": "60ではないと思う。覚えている。"}, {"type": "subtitle", "time": 8513.99, "timestamp": "02:21:53", "text": "覚えておかなければならない。"}, {"type": "subtitle", "time": 8515.83, "timestamp": "02:21:55", "text": "20です。20だとほぼ確信しています。"}, {"type": "subtitle", "time": 8517.75, "timestamp": "02:21:57", "text": "いいえ、絶対に違います。  20個の"}, {"type": "subtitle", "time": 8519.59, "timestamp": "02:21:59", "text": "シャッターだと思います。"}]
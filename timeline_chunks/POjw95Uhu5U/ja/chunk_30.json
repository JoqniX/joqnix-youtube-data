[{"type": "subtitle", "time": 1802.149, "timestamp": "00:30:02", "text": "少なくとも相手側については、"}, {"type": "subtitle", "time": 1812.47, "timestamp": "00:30:12", "text": "相手側が私だったら、私はただ"}, {"type": "subtitle", "time": 1814.87, "timestamp": "00:30:14", "text": "こう言うだけです。 もし相手側で、"}, {"type": "subtitle", "time": 1817.59, "timestamp": "00:30:17", "text": "ヴァンが何らかの形で何かを壊してしまったら、"}, {"type": "subtitle", "time": 1823.269, "timestamp": "00:30:23", "text": "彼が壊しすぎた場合、"}, {"type": "subtitle", "time": 1826.71, "timestamp": "00:30:26", "text": "基本的に"}, {"type": "subtitle", "time": 1828.149, "timestamp": "00:30:28", "text": "彼を手放して別のキャラクターを演じ、ハナンに「お前は彼を好きなように使える、お前がコントロールするんだ」と言うだろう。"}, {"type": "subtitle", "time": 1837.909, "timestamp": "00:30:37", "text": "聞いてくれ、彼はすでに"}, {"type": "subtitle", "time": 1839.83, "timestamp": "00:30:39", "text": "悪に染まりつつあり、すでに自分自身を見失いつつある。"}, {"type": "subtitle", "time": 1841.83, "timestamp": "00:30:41", "text": "もし彼が"}, {"type": "subtitle", "time": 1843.83, "timestamp": "00:30:43", "text": "完全に自分自身を見失ったら、ハナンにハンドルを渡す"}, {"type": "subtitle", "time": 1845.909, "timestamp": "00:30:45", "text": "。 イエス様、ハンドルを握ってください、兄弟。"}, {"type": "subtitle", "time": 1847.029, "timestamp": "00:30:47", "text": "うん。"}, {"type": "subtitle", "time": 1849.19, "timestamp": "00:30:49", "text": "イエスよ、すべてを委ねてください。"}, {"type": "subtitle", "time": 1851.909, "timestamp": "00:30:51", "text": "イエスよ、ハンドルを握ってください。"}, {"type": "subtitle", "time": 1855.11, "timestamp": "00:30:55", "text": "私の手から受け取ってください。   もちろんさ"}, {"type": "subtitle", "time": 1856.559, "timestamp": "00:30:56", "text": "。   もちろんさ 。 もちろんさ。 もちろんさ。   もちろんさ"}, {"type": "subtitle", "time": 1858.88, "timestamp": "00:30:58", "text": "。 もちろんさ。 もちろんさ。   もちろんさ 。   もちろんさ"}, {"type": "subtitle", "time": 1859.6, "timestamp": "00:30:59", "text": "。   もちろんさ 。"}]
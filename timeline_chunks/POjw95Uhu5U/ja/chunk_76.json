[{"type": "subtitle", "time": 4565.11, "timestamp": "01:16:05", "text": "[ミュージック]は"}, {"type": "subtitle", "time": 4566.95, "timestamp": "01:16:06", "text": "間違いなく火の玉を自分のために取っておく"}, {"type": "subtitle", "time": 4570.07, "timestamp": "01:16:10", "text": "。 それは、それは彼女のためのものです。 でも"}, {"type": "subtitle", "time": 4573.59, "timestamp": "01:16:13", "text": "彼女は「ああ、エレベーターミュージックが流れ始めたわ"}, {"type": "subtitle", "time": 4574.79, "timestamp": "01:16:14", "text": "」って感じだった。   ごめん"}, {"type": "subtitle", "time": 4577.75, "timestamp": "01:16:17", "text": "。 ごめん。 ただただ申し訳ない。 私はただ"}, {"type": "subtitle", "time": 4580.63, "timestamp": "01:16:20", "text": "見て、「ああ、"}, {"type": "subtitle", "time": 4583.43, "timestamp": "01:16:23", "text": "アッシュが何を持っているのか気になったんだけど、どうやって"}, {"type": "subtitle", "time": 4588.95, "timestamp": "01:16:28", "text": "はい。 はい、彼はそうしました。"}, {"type": "subtitle", "time": 4591.43, "timestamp": "01:16:31", "text": "ビクトリアの灰。   あの"}, {"type": "subtitle", "time": 4595.03, "timestamp": "01:16:35", "text": "喧嘩のせいでトラウマが残っている。"}, {"type": "subtitle", "time": 4597.99, "timestamp": "01:16:37", "text": "私のランクにはアッシュルが多すぎて、トラウマになっています"}, {"type": "subtitle", "time": 4598.95, "timestamp": "01:16:38", "text": "。"}, {"type": "subtitle", "time": 4605.669, "timestamp": "01:16:45", "text": "、あなたはチェーンを持っています。 お前の"}, {"type": "subtitle", "time": 4610.47, "timestamp": "01:16:50", "text": "クソみたいなレーンに連鎖反応を起こしてやるよ。 誰かがゲームをする。"}, {"type": "subtitle", "time": 4611.03, "timestamp": "01:16:51", "text": "ゲーム。"}, {"type": "subtitle", "time": 4614.709, "timestamp": "01:16:54", "text": "ああ、"}, {"type": "subtitle", "time": 4617.43, "timestamp": "01:16:57", "text": "私の領域にコメントを入れようとしているんですね。"}, {"type": "subtitle", "time": 4619.27, "timestamp": "01:16:59", "text": "ゲーム。"}]
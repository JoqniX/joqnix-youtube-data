[{"type": "subtitle", "time": 6301.51, "timestamp": "01:45:01", "text": "私があなたに話しかけるかどうか確認するために。ええ。ええ。ええ"}, {"type": "subtitle", "time": 6304.55, "timestamp": "01:45:04", "text": "。"}, {"type": "subtitle", "time": 6307.59, "timestamp": "01:45:07", "text": "カミラは、"}, {"type": "subtitle", "time": 6312.709, "timestamp": "01:45:12", "text": "このパーティーでドルイドが使えるようなものを売ろうとしていて、彼らは"}, {"type": "subtitle", "time": 6315.59, "timestamp": "01:45:15", "text": "200"}, {"type": "subtitle", "time": 6325.669, "timestamp": "01:45:25", "text": "オーケー。"}, {"type": "subtitle", "time": 6337.109, "timestamp": "01:45:37", "text": "ところで、あなたは"}, {"type": "subtitle", "time": 6350.149, "timestamp": "01:45:50", "text": "。どんな機能が必要なのかわかりません。新しい機能を手に入れたら、あなたに言うだけです。もう一度確認させてください。レベルアップ。オーケー。ええ。ちょっと"}, {"type": "subtitle", "time": 6354.229, "timestamp": "01:45:54", "text": "待って。ああ、"}, {"type": "subtitle", "time": 6355.669, "timestamp": "01:45:55", "text": "専門知識を手に入れます。何の"}, {"type": "subtitle", "time": 6357.99, "timestamp": "01:45:57", "text": "専門家になりたいですか？"}]
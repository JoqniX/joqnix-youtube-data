[{"type": "subtitle", "time": 4684.709, "timestamp": "01:18:04", "text": "。"}, {"type": "subtitle", "time": 4685.75, "timestamp": "01:18:05", "text": "私のお気に入りは、"}, {"type": "subtitle", "time": 4689.11, "timestamp": "01:18:09", "text": "いつかこのクソキャンペーンであなたをマキシするということです。"}, {"type": "subtitle", "time": 4692.229, "timestamp": "01:18:12", "text": "いいえ。まずはご自身の気持ちを確かめてみてください。"}, {"type": "subtitle", "time": 4694.39, "timestamp": "01:18:14", "text": "私のお気に入りのデッキは、"}, {"type": "subtitle", "time": 4697.03, "timestamp": "01:18:17", "text": "ヴァンパイアデッキを使っている人たちで、"}, {"type": "subtitle", "time": 4699.03, "timestamp": "01:18:19", "text": "時々"}, {"type": "subtitle", "time": 4701.35, "timestamp": "01:18:21", "text": "自分のLPを覚えていないせいで、誤って自滅してしまうんです"}, {"type": "subtitle", "time": 4703.51, "timestamp": "01:18:23", "text": "。   そういう"}, {"type": "subtitle", "time": 4706.47, "timestamp": "01:18:26", "text": "ゲームは何回かプレイしたことがある。   わかった"}, {"type": "subtitle", "time": 4708.87, "timestamp": "01:18:28", "text": "。 うん。"}, {"type": "subtitle", "time": 4710.95, "timestamp": "01:18:30", "text": "えっと、もし少額の"}, {"type": "subtitle", "time": 4714.149, "timestamp": "01:18:34", "text": "頭金、例えば"}, {"type": "subtitle", "time": 4716.39, "timestamp": "01:18:36", "text": "200ドルをいただければ、"}, {"type": "subtitle", "time": 4719.189, "timestamp": "01:18:39", "text": "喜んでこれを持って行きます。 そう、"}, {"type": "subtitle", "time": 4722.07, "timestamp": "01:18:42", "text": "彼女は、"}, {"type": "subtitle", "time": 4726.229, "timestamp": "01:18:46", "text": "いつになるかわからないのを待つよりも、今すぐにでも金を手に入れる方がいいって言ってるのよ。 それに彼女は"}, {"type": "subtitle", "time": 4728.87, "timestamp": "01:18:48", "text": "商人たちが周りにいることも知っているから、わかるでしょ。"}, {"type": "subtitle", "time": 4731.27, "timestamp": "01:18:51", "text": "うん、いい"}, {"type": "subtitle", "time": 4733.19, "timestamp": "01:18:53", "text": "ダンジョン商人だね。"}, {"type": "subtitle", "time": 4735.91, "timestamp": "01:18:55", "text": "[音楽]"}, {"type": "subtitle", "time": 4737.27, "timestamp": "01:18:57", "text": "はい。 それが"}]
[{"type": "subtitle", "time": 7082.149, "timestamp": "01:58:02", "text": "少なくとも、ハンハンはそれを見ることができます。"}, {"type": "subtitle", "time": 7084.229, "timestamp": "01:58:04", "text": "うん。 うん。  H."}, {"type": "subtitle", "time": 7086.709, "timestamp": "01:58:06", "text": "では、どうぞそのまま進んでください。"}, {"type": "subtitle", "time": 7089.91, "timestamp": "01:58:09", "text": "うん。 もしかしたら10セントくらいかもしれない。"}, {"type": "subtitle", "time": 7095.189, "timestamp": "01:58:15", "text": "ちょっと待ってください。  1秒。"}, {"type": "subtitle", "time": 7097.109, "timestamp": "01:58:17", "text": "私は小さな槍をカチッと外すことができます。   今"}, {"type": "subtitle", "time": 7099.03, "timestamp": "01:58:19", "text": "気づいたんだけど、君は"}, {"type": "subtitle", "time": 7100.709, "timestamp": "01:58:20", "text": "スマホをいじってるみたいだね。 はぁ？"}, {"type": "subtitle", "time": 7102.629, "timestamp": "01:58:22", "text": "いいえ、違います。"}, {"type": "subtitle", "time": 7104.55, "timestamp": "01:58:24", "text": "なんでこんなに大きな音で音声が再生されてるんだ"}, {"type": "subtitle", "time": 7106.71, "timestamp": "01:58:26", "text": "？"}, {"type": "subtitle", "time": 7108.07, "timestamp": "01:58:28", "text": "[音楽]は、"}, {"type": "subtitle", "time": 7113.109, "timestamp": "01:58:33", "text": "とてつもないコメディを漏らしている。"}, {"type": "subtitle", "time": 7119.35, "timestamp": "01:58:39", "text": "例えば、ファンを近づけて、"}, {"type": "subtitle", "time": 7121.35, "timestamp": "01:58:41", "text": "私の問題はコンピューターが"}, {"type": "subtitle", "time": 7122.87, "timestamp": "01:58:42", "text": "過熱していたことだと思います。だから、"}, {"type": "subtitle", "time": 7124.229, "timestamp": "01:58:44", "text": "ゆっくりと壊れていったのです。"}, {"type": "subtitle", "time": 7126.39, "timestamp": "01:58:46", "text": "ああ、私のすぐ隣に"}, {"type": "subtitle", "time": 7128.55, "timestamp": "01:58:48", "text": "。 それも"}, {"type": "subtitle", "time": 7130.39, "timestamp": "01:58:50", "text": "私の問題の一因かもしれません。"}, {"type": "subtitle", "time": 7132.47, "timestamp": "01:58:52", "text": "もしかして、ダイナミック"}, {"type": "subtitle", "time": 7133.99, "timestamp": "01:58:53", "text": "ライティングはすでにオフにしてしまいましたか？"}, {"type": "subtitle", "time": 7135.91, "timestamp": "01:58:55", "text": "うん。 いやいや、パソコンが"}, {"type": "subtitle", "time": 7137.43, "timestamp": "01:58:57", "text": "過熱しただけだよ。   ああ"}, {"type": "subtitle", "time": 7139.35, "timestamp": "01:58:59", "text": "、確かにそうだね。 公平。 つまり、"}]
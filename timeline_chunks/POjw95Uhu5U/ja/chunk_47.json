[{"type": "subtitle", "time": 2821.829, "timestamp": "00:47:01", "text": "。"}, {"type": "subtitle", "time": 2825.829, "timestamp": "00:47:05", "text": "これは良いことだ。 これは良いことだ。"}, {"type": "subtitle", "time": 2828.47, "timestamp": "00:47:08", "text": "神。 ああ。 はい。"}, {"type": "subtitle", "time": 2830.069, "timestamp": "00:47:10", "text": "良い。 ああ。 はい。"}, {"type": "subtitle", "time": 2832.39, "timestamp": "00:47:12", "text": "うん。 彼はいつも良いものを準備している。"}, {"type": "subtitle", "time": 2834.47, "timestamp": "00:47:14", "text": "なぜなら彼は"}, {"type": "subtitle", "time": 2839.35, "timestamp": "00:47:19", "text": "なぜ？"}, {"type": "subtitle", "time": 2844.71, "timestamp": "00:47:24", "text": "[音楽]"}, {"type": "subtitle", "time": 2847.19, "timestamp": "00:47:27", "text": "誰かが"}, {"type": "subtitle", "time": 2849.27, "timestamp": "00:47:29", "text": "美味しいベリーに夢中になるたびに、私はネックレスをもらっていました。"}, {"type": "subtitle", "time": 2851.75, "timestamp": "00:47:31", "text": "私もそうなんです。"}, {"type": "subtitle", "time": 2853.27, "timestamp": "00:47:33", "text": "大したことではないけれど、それが"}, {"type": "subtitle", "time": 2859.91, "timestamp": "00:47:39", "text": "。 美しい髪に夢中。"}, {"type": "subtitle", "time": 2862.63, "timestamp": "00:47:42", "text": "良い中毒性。   何てことだ"}, {"type": "subtitle", "time": 2863.91, "timestamp": "00:47:43", "text": "。 それを"}, {"type": "subtitle", "time": 2866.47, "timestamp": "00:47:46", "text": "公式設定にするべきだ。 私のエルフの"}, {"type": "subtitle", "time": 2869.349, "timestamp": "00:47:49", "text": "キャラクターが、"}, {"type": "subtitle", "time": 2870.87, "timestamp": "00:47:50", "text": "私のキャンペーンの1つで常に高いレベルにある理由はこれです。"}, {"type": "subtitle", "time": 2872.63, "timestamp": "00:47:52", "text": "ハイエルフ。"}, {"type": "subtitle", "time": 2874.39, "timestamp": "00:47:54", "text": "ヘル。"}, {"type": "subtitle", "time": 2876.069, "timestamp": "00:47:56", "text": "うん。   何てことだ"}]
[{"type": "subtitle", "time": 6660.47, "timestamp": "01:51:00", "text": "。"}, {"type": "subtitle", "time": 6661.99, "timestamp": "01:51:01", "text": "ええ、"}, {"type": "subtitle", "time": 6666.39, "timestamp": "01:51:06", "text": "マクロから外して、それを使ってください。"}, {"type": "subtitle", "time": 6668.87, "timestamp": "01:51:08", "text": "それは本当に便利です。なぜなら、"}, {"type": "subtitle", "time": 6670.47, "timestamp": "01:51:10", "text": "将来的に、今はまだ"}, {"type": "subtitle", "time": 6672.07, "timestamp": "01:51:12", "text": "考えていませんが、"}, {"type": "subtitle", "time": 6674.229, "timestamp": "01:51:14", "text": "私がプレイするパーティーは大抵モバイル"}, {"type": "subtitle", "time": 6676.47, "timestamp": "01:51:16", "text": "ユーザーなので、ロールの方がはるかに"}, {"type": "subtitle", "time": 6679.43, "timestamp": "01:51:19", "text": "アクセスしやすいからです。"}, {"type": "subtitle", "time": 6681.43, "timestamp": "01:51:21", "text": "確かに。"}, {"type": "subtitle", "time": 6682.79, "timestamp": "01:51:22", "text": "ええ、"}, {"type": "subtitle", "time": 6684.709, "timestamp": "01:51:24", "text": "それは素晴らしいアイデアです。マイクロを設定するのは素晴らしいアイデアですね。"}, {"type": "subtitle", "time": 6691.59, "timestamp": "01:51:31", "text": "将来的にFoundryを使うようになったら、そうします。私がFoundryを使わない"}, {"type": "subtitle", "time": 6694.709, "timestamp": "01:51:34", "text": "唯一の理由は、"}, {"type": "subtitle", "time": 6696.629, "timestamp": "01:51:36", "text": "プレイヤーの中には携帯"}, {"type": "subtitle", "time": 6699.669, "timestamp": "01:51:39", "text": "電話ユーザーもいて、携帯"}, {"type": "subtitle", "time": 6709.03, "timestamp": "01:51:49", "text": "。本当に難しいです。本当に"}, {"type": "subtitle", "time": 6711.189, "timestamp": "01:51:51", "text": "難しいのですが、驚くべきことに彼らは"}, {"type": "subtitle", "time": 6713.43, "timestamp": "01:51:53", "text": "ロールできます。トークンを動かすことができます。"}, {"type": "subtitle", "time": 6714.79, "timestamp": "01:51:54", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 6719.03, "timestamp": "01:51:59", "text": "ええ。彼らがそれができるなんて信じられない。"}]
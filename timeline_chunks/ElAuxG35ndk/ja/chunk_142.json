[{"type": "subtitle", "time": 8522.309, "timestamp": "02:22:02", "text": "音楽はきっと効果を発揮するだろう。 まあ、とにかく、"}, {"type": "subtitle", "time": 8525.51, "timestamp": "02:22:05", "text": "おやすみなさい。 これで終わりにします。配信はたぶん"}, {"type": "subtitle", "time": 8527.91, "timestamp": "02:22:07", "text": "次回にします。 次の配信は"}, {"type": "subtitle", "time": 8530.15, "timestamp": "02:22:10", "text": "土曜日になるかもしれません。"}, {"type": "subtitle", "time": 8532.87, "timestamp": "02:22:12", "text": "明日と明後日は配信できるかどうか分からない。"}, {"type": "subtitle", "time": 8535.59, "timestamp": "02:22:15", "text": "その頃には"}, {"type": "subtitle", "time": 8538.95, "timestamp": "02:22:18", "text": "仕事が終わって疲れて帰宅しているだろうから。 夕食を食べて、それから"}, {"type": "subtitle", "time": 8542.87, "timestamp": "02:22:22", "text": "寝るか、あるいは"}, {"type": "subtitle", "time": 8551.91, "timestamp": "02:22:31", "text": "今みたいに2時間くらいいて、それから寝るかもしれない。"}, {"type": "subtitle", "time": 8554.309, "timestamp": "02:22:34", "text": "知るか？ ええ、"}, {"type": "subtitle", "time": 8556.63, "timestamp": "02:22:36", "text": "今日はありがとうございました。 皆さん、おやすみなさい。 良い"}]
[{"type": "subtitle", "time": 1694.389, "timestamp": "00:28:14", "text": "それでは、何をすべきか計画を立てましょう"}, {"type": "subtitle", "time": 1697.43, "timestamp": "00:28:17", "text": "。 わかった。 偵察任務を受けたい。 待って、"}, {"type": "subtitle", "time": 1700.789, "timestamp": "00:28:20", "text": "ドライバーも手に入れることができるよ"}, {"type": "subtitle", "time": 1703.11, "timestamp": "00:28:23", "text": "。"}, {"type": "subtitle", "time": 1705.51, "timestamp": "00:28:25", "text": "えっと、"}, {"type": "subtitle", "time": 1709.19, "timestamp": "00:28:29", "text": "必要なものを見てみましょう。 えっと、チーム"}, {"type": "subtitle", "time": 1711.909, "timestamp": "00:28:31", "text": "メイトたちは何を必要としているんだろう？"}, {"type": "subtitle", "time": 1713.909, "timestamp": "00:28:33", "text": "基地は2つあります。"}, {"type": "subtitle", "time": 1718.23, "timestamp": "00:28:38", "text": "えっと、メインはどれですか？ わからない。"}, {"type": "subtitle", "time": 1721.43, "timestamp": "00:28:41", "text": "二人とも物資を運んでくるんですよね？ なぜ？"}, {"type": "subtitle", "time": 1724.23, "timestamp": "00:28:44", "text": "タワーはどこだ、兄弟？ なんてこった"}, {"type": "subtitle", "time": 1727.51, "timestamp": "00:28:47", "text": "？ 彼らは何をしていますか？"}, {"type": "subtitle", "time": 1733.909, "timestamp": "00:28:53", "text": "青チームは何をしているの？ もし彼らが「なんてこった」と言うなら"}, {"type": "subtitle", "time": 1736.31, "timestamp": "00:28:56", "text": "。 ああ、なんてことだ。 よし、誰かが"}, {"type": "subtitle", "time": 1739.59, "timestamp": "00:28:59", "text": "ここにキーフォブを置いてくれた。 何が起こっているのか？"}]
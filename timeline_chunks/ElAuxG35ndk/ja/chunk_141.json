[{"type": "subtitle", "time": 8462.309, "timestamp": "02:21:02", "text": "ええ、今日来てくださった皆さん、ありがとうございました"}, {"type": "subtitle", "time": 8467.75, "timestamp": "02:21:07", "text": "。 ごめんなさい。 それは、ええと、あちこちに散らばっていたような感じでした"}, {"type": "subtitle", "time": 8469.51, "timestamp": "02:21:09", "text": "。 ええ、"}, {"type": "subtitle", "time": 8472.87, "timestamp": "02:21:12", "text": "アディティが来てくれてありがとう。 ラシャヴァンさん、"}, {"type": "subtitle", "time": 8475.75, "timestamp": "02:21:15", "text": "来てくれてありがとう。 カリさん、"}, {"type": "subtitle", "time": 8480.71, "timestamp": "02:21:20", "text": "来てくれてありがとう。 えっと、他に誰が来たの？"}, {"type": "subtitle", "time": 8486.79, "timestamp": "02:21:26", "text": "アリサさん、来てくれてありがとう。 そして、ずっと"}, {"type": "subtitle", "time": 8489.03, "timestamp": "02:21:29", "text": "潜んでいた皆さん、"}, {"type": "subtitle", "time": 8492.63, "timestamp": "02:21:32", "text": "。 この掲示板を再びご覧になっている皆様"}, {"type": "subtitle", "time": 8505.349, "timestamp": "02:21:45", "text": "もし私がKickとかTwitchとかでライブ配信しているのを見かけても"}, {"type": "subtitle", "time": 8507.83, "timestamp": "02:21:47", "text": "、"}, {"type": "subtitle", "time": 8510.469, "timestamp": "02:21:50", "text": "気にしないでください。 ちょっとテストしているだけです。"}, {"type": "subtitle", "time": 8516.95, "timestamp": "02:21:56", "text": "配信終了後にこのくだらないものがちゃんと動くかどうか確認するため。 もちろん、うまくいくと分かっています"}, {"type": "subtitle", "time": 8519.689, "timestamp": "02:21:59", "text": "。"}]
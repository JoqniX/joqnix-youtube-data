[{"type": "subtitle", "time": 2534.15, "timestamp": "00:42:14", "text": "どうしてこんなことになってしまったんだろう？   私は疑問に思う。"}, {"type": "subtitle", "time": 2556.23, "timestamp": "00:42:36", "text": "私のインターネット接続が悪いみたいで、"}, {"type": "subtitle", "time": 2558.39, "timestamp": "00:42:38", "text": "インターネットの半分がゲームに消費されているんです"}]
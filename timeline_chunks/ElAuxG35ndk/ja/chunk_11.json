[{"type": "subtitle", "time": 662.23, "timestamp": "00:11:02", "text": "うん。  [音楽] そして、これがクレイジーなショーです。"}, {"type": "subtitle", "time": 665.19, "timestamp": "00:11:05", "text": "うん。 さて、本題に戻りましょう。 それで、"}, {"type": "subtitle", "time": 668.389, "timestamp": "00:11:08", "text": "このノートパソコンを"}, {"type": "subtitle", "time": 671.19, "timestamp": "00:11:11", "text": "ゲーム専用兼メインPCとして使い、"}, {"type": "subtitle", "time": 674.63, "timestamp": "00:11:14", "text": "古いセットアップは"}, {"type": "subtitle", "time": 676.63, "timestamp": "00:11:16", "text": "YouTube、Twitch、Kickなどのプラットフォーム用のエンコードセッションとして使うことを考えているんです"}, {"type": "subtitle", "time": 679.67, "timestamp": "00:11:19", "text": "。 私も"}, {"type": "subtitle", "time": 682.949, "timestamp": "00:11:22", "text": "マルチリーミング機能を使いますが、"}, {"type": "subtitle", "time": 692.47, "timestamp": "00:11:32", "text": "皆さんに高品質で高FPSのゲームプレイフィードを送りたいので、"}, {"type": "subtitle", "time": 694.069, "timestamp": "00:11:34", "text": "高品質なコンテンツなどを提供できます。"}, {"type": "subtitle", "time": 695.829, "timestamp": "00:11:35", "text": "うん。 つまり、それには"}, {"type": "subtitle", "time": 699.11, "timestamp": "00:11:39", "text": "良いビット"}, {"type": "subtitle", "time": 702.47, "timestamp": "00:11:42", "text": "レートも必要になるということですね。 今は色々なことがあって、いろいろと試してみたくなる"}, {"type": "subtitle", "time": 707.35, "timestamp": "00:11:47", "text": "。 私が"}, {"type": "subtitle", "time": 709.75, "timestamp": "00:11:49", "text": "期待していること、考えていることが実現することを心から願っています。"}, {"type": "subtitle", "time": 713.35, "timestamp": "00:11:53", "text": "ええと、もし"}, {"type": "subtitle", "time": 717.75, "timestamp": "00:11:57", "text": "可能なら、私のシステム関連のデータを何とかしてここに取り戻したいのですが。 ああ、これで"}]
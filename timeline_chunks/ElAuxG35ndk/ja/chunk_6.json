[{"type": "subtitle", "time": 361.11, "timestamp": "00:06:01", "text": "シンガポールの、私が長年使っていた古いサービスから、"}, {"type": "subtitle", "time": 367.029, "timestamp": "00:06:07", "text": "無料のサービスに切り替えました。 ええと、今のところ"}, {"type": "subtitle", "time": 369.51, "timestamp": "00:06:09", "text": "ビットレートは"}, {"type": "subtitle", "time": 374.87, "timestamp": "00:06:14", "text": "まだ3,000だと思いますが、でも、ええ、"}, {"type": "subtitle", "time": 377.99, "timestamp": "00:06:17", "text": "でも、"}, {"type": "subtitle", "time": 382.07, "timestamp": "00:06:22", "text": "基本的な6,000ビットレートのように6,000ビットレートを送信できるようになります。   えっと、"}, {"type": "subtitle", "time": 385.83, "timestamp": "00:06:25", "text": "シンガポールのサーバーに送信しています"}, {"type": "subtitle", "time": 389.99, "timestamp": "00:06:29", "text": "。 つまり、そのフィードは"}, {"type": "subtitle", "time": 393.43, "timestamp": "00:06:33", "text": "シドニーのサーバーに送信されているということです。 つまり、他のすべてのプラットフォームに公開するということです"}, {"type": "subtitle", "time": 396.469, "timestamp": "00:06:36", "text": "。 だから、それはちょっとした小さな丸い"}, {"type": "subtitle", "time": 399.99, "timestamp": "00:06:39", "text": "切り裂きのようなものだと"}, {"type": "subtitle", "time": 405.35, "timestamp": "00:06:45", "text": "思うけど、ある程度はうまくいく"}, {"type": "subtitle", "time": 408.05899999999997, "timestamp": "00:06:48", "text": "。"}, {"type": "subtitle", "time": 409.11, "timestamp": "00:06:49", "text": "[音楽]"}, {"type": "subtitle", "time": 415.43, "timestamp": "00:06:55", "text": "でも、うまくいくはずです。 よし。"}, {"type": "subtitle", "time": 418.87, "timestamp": "00:06:58", "text": "とにかく、そういうわけで、えっと、"}]
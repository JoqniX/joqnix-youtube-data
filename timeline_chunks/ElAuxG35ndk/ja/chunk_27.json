[{"type": "subtitle", "time": 1620.47, "timestamp": "00:27:00", "text": "私はその中に閉じ込められている。"}, {"type": "subtitle", "time": 1627.75, "timestamp": "00:27:07", "text": "何が起こっている？ これが見えますか？"}, {"type": "subtitle", "time": 1630.789, "timestamp": "00:27:10", "text": "彼らは何をしていますか？   何てことだ"}, {"type": "subtitle", "time": 1646.71, "timestamp": "00:27:26", "text": "よし、今日はトラック"}, {"type": "subtitle", "time": 1649.11, "timestamp": "00:27:29", "text": "運転手になろう。   まだお探しのものは見つかりませんでした"}, {"type": "subtitle", "time": 1651.19, "timestamp": "00:27:31", "text": "。"}]
[{"type": "subtitle", "time": 1456.789, "timestamp": "00:24:16", "text": "よし、これでいこう。"}, {"type": "subtitle", "time": 1488.71, "timestamp": "00:24:48", "text": "後でパラシュートを買って、後で食べるために小さなボンアップ。 はい。 魚のカレーをお楽しみください"}, {"type": "subtitle", "time": 1491.269, "timestamp": "00:24:51", "text": "。 うん。 魚のカレーと、"}, {"type": "subtitle", "time": 1495.19, "timestamp": "00:24:55", "text": "バスマティライス、赤エンドウ豆、グリーン"}, {"type": "subtitle", "time": 1497.19, "timestamp": "00:24:57", "text": "ピースなど。 それら全て。"}]
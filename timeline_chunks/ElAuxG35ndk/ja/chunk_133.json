[{"type": "subtitle", "time": 7987.43, "timestamp": "02:13:07", "text": "プラスエリアモードではありません。 まあ、そういうことだ"}, {"type": "subtitle", "time": 7998.069, "timestamp": "02:13:18", "text": "俺のアップロード速度は100MBだよ、兄弟。 いいえ。えっと、"}, {"type": "subtitle", "time": 8003.83, "timestamp": "02:13:23", "text": "ダウンロードとか、なんで私のアップロード速度がこんなに"}, {"type": "subtitle", "time": 8009.43, "timestamp": "02:13:29", "text": "遅いの？ さあ、兄弟。 なぜあなたの回線速度は"}, {"type": "subtitle", "time": 8021.03, "timestamp": "02:13:41", "text": "私は激怒している。 ただ遊びたいだけなんだ。"}, {"type": "subtitle", "time": 8038.87, "timestamp": "02:13:58", "text": "おお。"}]
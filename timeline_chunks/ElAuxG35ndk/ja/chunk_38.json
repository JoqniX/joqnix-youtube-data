[{"type": "subtitle", "time": 2288.47, "timestamp": "00:38:08", "text": "ああ、私、すごく喋りすぎちゃった。 誰も"}, {"type": "subtitle", "time": 2292.069, "timestamp": "00:38:12", "text": "私の声を聞いてくれなかった。 わかった。 私が言いたかったのは、"}, {"type": "subtitle", "time": 2293.829, "timestamp": "00:38:13", "text": "誰かが私"}, {"type": "subtitle", "time": 2317.03, "timestamp": "00:38:37", "text": "ああ、橋の料金がひどい。 私はこれが嫌いだ。"}, {"type": "subtitle", "time": 2334.79, "timestamp": "00:38:54", "text": "ああ、これ、本当に嫌だ。 よし、少し遊んでみよう"}]
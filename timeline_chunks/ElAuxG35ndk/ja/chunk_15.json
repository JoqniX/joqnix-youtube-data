[{"type": "subtitle", "time": 901.99, "timestamp": "00:15:01", "text": "楽しんでいます。 ヴァードックスはいつも楽しい。 信じられない"}, {"type": "subtitle", "time": 906.79, "timestamp": "00:15:06", "text": "。 良いゲームだ。 大好きです。"}, {"type": "subtitle", "time": 913.829, "timestamp": "00:15:13", "text": "野犬と遊ぶのはいつも楽しいね。"}, {"type": "subtitle", "time": 918.069, "timestamp": "00:15:18", "text": "誰でも？ ああ、番組中、私はたくさん喋りすぎたわ。"}, {"type": "subtitle", "time": 921.43, "timestamp": "00:15:21", "text": "こんにちは。 えっと、準備ができたら"}, {"type": "subtitle", "time": 924.55, "timestamp": "00:15:24", "text": "ゲーム画面に切り替えましょう。"}, {"type": "subtitle", "time": 926.31, "timestamp": "00:15:26", "text": "よし、"}, {"type": "subtitle", "time": 929.269, "timestamp": "00:15:29", "text": "チャットの準備をしてから、みんなの顔が見えるようにしますね"}, {"type": "subtitle", "time": 940.389, "timestamp": "00:15:40", "text": "えーと、再接続する前に、"}, {"type": "subtitle", "time": 944.31, "timestamp": "00:15:44", "text": "66,000 ビットレートで再接続したいです。 わかった。  BRB 3"}, {"type": "subtitle", "time": 947.189, "timestamp": "00:15:47", "text": "2 ストリームは 3 2 1 0 で切断されます"}]
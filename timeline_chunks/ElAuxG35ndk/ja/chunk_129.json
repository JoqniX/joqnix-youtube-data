[{"type": "subtitle", "time": 7740.95, "timestamp": "02:09:00", "text": "これは私が"}, {"type": "subtitle", "time": 7745.109, "timestamp": "02:09:05", "text": "配信の冒頭で言っていたことです。"}, {"type": "subtitle", "time": 7748.47, "timestamp": "02:09:08", "text": "インターネットはいつから"}, {"type": "subtitle", "time": 7752.39, "timestamp": "02:09:12", "text": "壊れ始めたの？ ゲームを起動した瞬間ですよね"}, {"type": "subtitle", "time": 7755.51, "timestamp": "02:09:15", "text": "？ 配信開始当初は、おしゃべりしたり楽しんだりすることができました"}, {"type": "subtitle", "time": 7757.91, "timestamp": "02:09:17", "text": "。 あ、"}, {"type": "subtitle", "time": 7761.03, "timestamp": "02:09:21", "text": "待って。 まだヒリヒリする。  1"}, {"type": "subtitle", "time": 7763.27, "timestamp": "02:09:23", "text": "秒。   はい"}, {"type": "subtitle", "time": 7765.03, "timestamp": "02:09:25", "text": "、どうぞ"}, {"type": "subtitle", "time": 7766.95, "timestamp": "02:09:26", "text": "。"}, {"type": "subtitle", "time": 7773.91, "timestamp": "02:09:33", "text": "今日の配信では、えーと話とか色々できたんだ"}, {"type": "subtitle", "time": 7794.31, "timestamp": "02:09:54", "text": "正直言って、どうすればいいのか分かりません"}, {"type": "subtitle", "time": 7796.79, "timestamp": "02:09:56", "text": "。"}, {"type": "subtitle", "time": 7799.27, "timestamp": "02:09:59", "text": "このインターネットの問題は本当に深刻だ。"}]
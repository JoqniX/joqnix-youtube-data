[{"type": "subtitle", "time": 602.55, "timestamp": "00:10:02", "text": "日本までPCを転送して、"}, {"type": "subtitle", "time": 605.99, "timestamp": "00:10:05", "text": "ストリーミングPCとして使えるようにしようと思っています。 ということで、"}, {"type": "subtitle", "time": 611.75, "timestamp": "00:10:11", "text": "Ryzen 5 5600X"}, {"type": "subtitle", "time": 617.509, "timestamp": "00:10:17", "text": "と GTX 1660 Super、そして Media Live"}, {"type": "subtitle", "time": 619.91, "timestamp": "00:10:19", "text": "Gamer 4K を搭載しています。 それはキャプチャカードです。"}, {"type": "subtitle", "time": 625.43, "timestamp": "00:10:25", "text": "昔番組をやっていた時と同じように、覚えている方もいるかもしれませんが、私は"}, {"type": "subtitle", "time": 628.23, "timestamp": "00:10:28", "text": "デュアルPC構成を使っていました。 私の配信はすべて"}, {"type": "subtitle", "time": 631.67, "timestamp": "00:10:31", "text": "高画質の1440pでした"}, {"type": "subtitle", "time": 636.47, "timestamp": "00:10:36", "text": "が、ええと、私の2060、つまりRTX 2060は、"}, {"type": "subtitle", "time": 644.87, "timestamp": "00:10:44", "text": "数週間前に配信したBody Camというゲームで最終的に壊れてしまいました。 ああ、そうだね。"}, {"type": "subtitle", "time": 649.43, "timestamp": "00:10:49", "text": "しかし、"}, {"type": "subtitle", "time": 652.31, "timestamp": "00:10:52", "text": "このノートパソコンを使えば、ボディカメラの映像をストリーミング配信することができました。"}, {"type": "subtitle", "time": 656.069, "timestamp": "00:10:56", "text": "ストリーミング配信もできたし、ゲームもできた。"}, {"type": "subtitle", "time": 659.43, "timestamp": "00:10:59", "text": "私たちは新しいアップデートをたくさんプレイしました。"}]
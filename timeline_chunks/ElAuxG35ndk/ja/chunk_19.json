[{"type": "subtitle", "time": 1141.27, "timestamp": "00:19:01", "text": "。 あと"}, {"type": "subtitle", "time": 1145.11, "timestamp": "00:19:05", "text": "1時間くらいで夕食を食べる予定です。 えっと、30分くらいかな"}, {"type": "subtitle", "time": 1146.789, "timestamp": "00:19:06", "text": "。"}, {"type": "subtitle", "time": 1149.51, "timestamp": "00:19:09", "text": "まあ、そうですね。   ああ"}, {"type": "subtitle", "time": 1151.19, "timestamp": "00:19:11", "text": "、"}, {"type": "subtitle", "time": 1154.95, "timestamp": "00:19:14", "text": "コミュニティサーバーがありますよ。 ええと、日本 JP。 ええと、"}, {"type": "subtitle", "time": 1158.15, "timestamp": "00:19:18", "text": "開いているかどうか見てみましょう。"}, {"type": "subtitle", "time": 1159.75, "timestamp": "00:19:19", "text": "えっと、"}, {"type": "subtitle", "time": 1162.23, "timestamp": "00:19:22", "text": "キャンディゲーミング。"}, {"type": "subtitle", "time": 1163.83, "timestamp": "00:19:23", "text": "ああ、人が多すぎる。 入れないと"}, {"type": "subtitle", "time": 1166.789, "timestamp": "00:19:26", "text": "思うのですが、入れますか？"}, {"type": "subtitle", "time": 1170.39, "timestamp": "00:19:30", "text": "人が多すぎるよ、兄弟。 来て。"}, {"type": "subtitle", "time": 1172.71, "timestamp": "00:19:32", "text": "参加したいのですが、現在"}, {"type": "subtitle", "time": 1176.47, "timestamp": "00:19:36", "text": "アジアサーバー（Asia Eサーバー）は中国のプレイヤーに占拠されています"}, {"type": "subtitle", "time": 1179.19, "timestamp": "00:19:39", "text": "。 彼らは"}, {"type": "subtitle", "time": 1182.31, "timestamp": "00:19:42", "text": "独自のサーバーやその他諸々を持っている。 本当に信じられないよ"}, {"type": "subtitle", "time": 1185.99, "timestamp": "00:19:45", "text": "。"}, {"type": "subtitle", "time": 1192.39, "timestamp": "00:19:52", "text": "アメリカ人と一緒にNAサーバーとかでプレイした方が自分にはいい気がする。"}, {"type": "subtitle", "time": 1194.95, "timestamp": "00:19:54", "text": "日本人と話したいし、えーっと、"}]
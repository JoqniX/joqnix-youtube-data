[{"type": "subtitle", "time": 721.75, "timestamp": "00:12:01", "text": "私は本当にたくさんのことができるようになった。"}, {"type": "subtitle", "time": 723.91, "timestamp": "00:12:03", "text": "「ジャック、"}, {"type": "subtitle", "time": 726.31, "timestamp": "00:12:06", "text": "なんで日本でパソコンを組み立てないの？"}, {"type": "subtitle", "time": 732.55, "timestamp": "00:12:12", "text": "東京には中古品店がたくさんあるじゃないか。自分で組み立てればいいのに"}, {"type": "subtitle", "time": 736.629, "timestamp": "00:12:16", "text": "」って言う人もいるだろう。 はい、私もそうするつもりです。 えっと、"}, {"type": "subtitle", "time": 738.87, "timestamp": "00:12:18", "text": "私が考えていたのは、"}, {"type": "subtitle", "time": 742.389, "timestamp": "00:12:22", "text": "家に長く忘れ去られて使われなくなるハードウェアを再利用した方が良いのではないかということです。"}, {"type": "subtitle", "time": 750.23, "timestamp": "00:12:30", "text": "それを腐らせて"}, {"type": "subtitle", "time": 755.75, "timestamp": "00:12:35", "text": "時間が経つにつれて壊れたり、摩耗したりするよりも、"}, {"type": "subtitle", "time": 758.87, "timestamp": "00:12:38", "text": "ここに持ってきてセットアップしてメンテナンスしてパッチを当てて"}, {"type": "subtitle", "time": 762.629, "timestamp": "00:12:42", "text": "修理して"}, {"type": "subtitle", "time": 765.59, "timestamp": "00:12:45", "text": "自分のものに使う方が良いのではないでしょうか。"}, {"type": "subtitle", "time": 775.03, "timestamp": "00:12:55", "text": "うん。 最近はゲームばかりしています。"}, {"type": "subtitle", "time": 777.75, "timestamp": "00:12:57", "text": "私は"}]
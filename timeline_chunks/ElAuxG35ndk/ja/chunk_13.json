[{"type": "subtitle", "time": 781.59, "timestamp": "00:13:01", "text": "1週間ノートパソコンの電源を切っていません。 俺はこれをPCとして使ってるんだよ"}, {"type": "subtitle", "time": 785.03, "timestamp": "00:13:05", "text": "、兄弟。 私は"}, {"type": "subtitle", "time": 786.79, "timestamp": "00:13:06", "text": "1週間、ノートパソコンの電源を切っていません。"}, {"type": "subtitle", "time": 789.35, "timestamp": "00:13:09", "text": "今日は配信のためだけに電源を切って再起動しました。"}, {"type": "subtitle", "time": 791.829, "timestamp": "00:13:11", "text": "Windowsのアップデートがありました。"}, {"type": "subtitle", "time": 794.31, "timestamp": "00:13:14", "text": "物が壊れないといいんだけど。 でも、そうね、[鼻を鳴らす]"}, {"type": "subtitle", "time": 797.75, "timestamp": "00:13:17", "text": "最近は、Apollo と Arus を使って、"}, {"type": "subtitle", "time": 803.75, "timestamp": "00:13:23", "text": "Moonlight と Sunshine に相当するものを使って、"}, {"type": "subtitle", "time": 808.23, "timestamp": "00:13:28", "text": "PC をインターネット経由でストリーミングしたり、"}, {"type": "subtitle", "time": 814.15, "timestamp": "00:13:34", "text": "Steam"}, {"type": "subtitle", "time": 816.71, "timestamp": "00:13:36", "text": "Deck や電話などの"}, {"type": "subtitle", "time": 818.87, "timestamp": "00:13:38", "text": "ポータブル デバイスでローカルにプレイしたりしているの。 だから、"}, {"type": "subtitle", "time": 821.35, "timestamp": "00:13:41", "text": "それを使ってWar Dogsや他の"}, {"type": "subtitle", "time": 823.91, "timestamp": "00:13:43", "text": "ゲームをプレイしたり、PCを操作したり、"}, {"type": "subtitle", "time": 827.75, "timestamp": "00:13:47", "text": "仮想Xboxコントローラーみたいな"}, {"type": "subtitle", "time": 831.67, "timestamp": "00:13:51", "text": "ボタンを使ってゲームをプレイしたりしているんだけど、"}, {"type": "subtitle", "time": 834.71, "timestamp": "00:13:54", "text": "すごくいい感じだよ。"}, {"type": "subtitle", "time": 837.829, "timestamp": "00:13:57", "text": "マウスとキーボードの"}]
[{"type": "subtitle", "time": 4571.11, "timestamp": "01:16:11", "text": "これは最悪だ、兄弟。 このアヒルスタイル。"}, {"type": "subtitle", "time": 4611.669, "timestamp": "01:16:51", "text": "私のものに触るべきじゃなかった。   あれに"}, {"type": "subtitle", "time": 4614.47, "timestamp": "01:16:54", "text": "触るべきじゃなかった。"}, {"type": "subtitle", "time": 4616.87, "timestamp": "01:16:56", "text": "これで君は厩舎の一員だ。"}, {"type": "subtitle", "time": 4619.11, "timestamp": "01:16:59", "text": "おお。"}]
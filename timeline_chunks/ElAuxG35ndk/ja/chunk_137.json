[{"type": "subtitle", "time": 8222.79, "timestamp": "02:17:02", "text": "インターネット詐欺のせいで失敗することはあまりできなかったけど、まあ、そういうことなんだ"}, {"type": "subtitle", "time": 8232.07, "timestamp": "02:17:12", "text": "本気ですか？ 右。 わかった。 わかった。   わかった"}, {"type": "subtitle", "time": 8234.23, "timestamp": "02:17:14", "text": "。 わかった。 わかった。"}, {"type": "subtitle", "time": 8236.549, "timestamp": "02:17:16", "text": "何かボタンを押したら、"}, {"type": "subtitle", "time": 8239.91, "timestamp": "02:17:19", "text": "インターネットが元通りになったような感じだった。   わかった"}, {"type": "subtitle", "time": 8243.669, "timestamp": "02:17:23", "text": "。 実際には今は違います。"}, {"type": "subtitle", "time": 8246.389, "timestamp": "02:17:26", "text": "本当に直っているのでしょうか？"}, {"type": "subtitle", "time": 8248.95, "timestamp": "02:17:28", "text": "12時だからですか？  12時になる。12時になるからなのか"}, {"type": "subtitle", "time": 8251.75, "timestamp": "02:17:31", "text": "？"}, {"type": "subtitle", "time": 8254.79, "timestamp": "02:17:34", "text": "インターネット接続は復旧しつつありますか？"}, {"type": "subtitle", "time": 8271.91, "timestamp": "02:17:51", "text": "なぜか、これは自然に"}, {"type": "subtitle", "time": 8275.27, "timestamp": "02:17:55", "text": "直っているような気がするのですが、そうですよね？ ただ"}, {"type": "subtitle", "time": 8279.27, "timestamp": "02:17:59", "text": "12時だからって。ああ、なんてことだ。 こうなったら、"}]
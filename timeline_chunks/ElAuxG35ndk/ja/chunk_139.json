[{"type": "subtitle", "time": 8343.27, "timestamp": "02:19:03", "text": "いや、いや、いや、いや、いや。 上がったり"}, {"type": "subtitle", "time": 8345.509, "timestamp": "02:19:05", "text": "下がったりしています。  [笑い]"}, {"type": "subtitle", "time": 8352.469, "timestamp": "02:19:12", "text": "（泣きながら）"}, {"type": "subtitle", "time": 8356.15, "timestamp": "02:19:16", "text": "遊びたかったんだ。"}, {"type": "subtitle", "time": 8358.15, "timestamp": "02:19:18", "text": "あのね？"}, {"type": "subtitle", "time": 8360.87, "timestamp": "02:19:20", "text": "配信なしでプレイすることにします。"}, {"type": "subtitle", "time": 8364.79, "timestamp": "02:19:24", "text": "これは本当に悲しいことだ。 皆さん、これは本当に"}, {"type": "subtitle", "time": 8369.19, "timestamp": "02:19:29", "text": "悲しいことです。 これは本当に悲しいことだ。 私の"}, {"type": "subtitle", "time": 8372.389, "timestamp": "02:19:32", "text": "インターネットは、「わかった、わかった"}, {"type": "subtitle", "time": 8375.83, "timestamp": "02:19:35", "text": "、午前0時までなら仕事をさせてあげるよ。"}, {"type": "subtitle", "time": 8389.19, "timestamp": "02:19:49", "text": "安定しつつあるから。」って感じなんです。 ちょっと待って、"}, {"type": "subtitle", "time": 8396.87, "timestamp": "02:19:56", "text": "ストリームは3000です。"}]
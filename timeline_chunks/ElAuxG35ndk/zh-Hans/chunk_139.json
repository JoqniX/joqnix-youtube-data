[{"type": "subtitle", "time": 8343.27, "timestamp": "02:19:03", "text": "不，不，不，不，不。 它忽高忽"}, {"type": "subtitle", "time": 8345.509, "timestamp": "02:19:05", "text": "低。  [笑声]"}, {"type": "subtitle", "time": 8352.469, "timestamp": "02:19:12", "text": "（哭泣）"}, {"type": "subtitle", "time": 8356.15, "timestamp": "02:19:16", "text": "我想玩。"}, {"type": "subtitle", "time": 8358.15, "timestamp": "02:19:18", "text": "你知道吗？ 我想我还是不"}, {"type": "subtitle", "time": 8360.87, "timestamp": "02:19:20", "text": "直播玩吧。"}, {"type": "subtitle", "time": 8364.79, "timestamp": "02:19:24", "text": "这太令人难过了。 各位，这太令人"}, {"type": "subtitle", "time": 8369.19, "timestamp": "02:19:29", "text": "难过了。 这真令人难过。 我的"}, {"type": "subtitle", "time": 8372.389, "timestamp": "02:19:32", "text": "网络就像在说：“好吧"}, {"type": "subtitle", "time": 8375.83, "timestamp": "02:19:35", "text": "好吧，只要现在是凌晨12点，我就让你工作。"}, {"type": "subtitle", "time": 8389.19, "timestamp": "02:19:49", "text": "它正在自我稳定。” 等等，让"}, {"type": "subtitle", "time": 8396.87, "timestamp": "02:19:56", "text": "播放量是 3000。"}]
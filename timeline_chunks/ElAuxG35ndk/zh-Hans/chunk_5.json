[{"type": "subtitle", "time": 301.11, "timestamp": "00:05:01", "text": "6,000。 正式宣布。"}, {"type": "subtitle", "time": 305.99, "timestamp": "00:05:05", "text": "它有点挑剔。 嗯，我就知道。"}, {"type": "subtitle", "time": 310.31, "timestamp": "00:05:10", "text": "昨天我测试过了。 所以，你们"}, {"type": "subtitle", "time": 313.189, "timestamp": "00:05:13", "text": "知道为什么我的直播质量"}, {"type": "subtitle", "time": 315.27, "timestamp": "00:05:15", "text": "不好，因为我同时在多个平台直播，对吧？"}, {"type": "subtitle", "time": 318.71, "timestamp": "00:05:18", "text": "所以，我最近才发现，"}, {"type": "subtitle", "time": 323.029, "timestamp": "00:05:23", "text": "我向悉尼的服务器发送了 3000 比特率的数据，"}, {"type": "subtitle", "time": 329.51, "timestamp": "00:05:29", "text": "因为我在日本，离"}, {"type": "subtitle", "time": 332.469, "timestamp": "00:05:32", "text": "东京很近，或者也许离东京没那么近"}, {"type": "subtitle", "time": 335.35, "timestamp": "00:05:35", "text": "。 所以显然，"}, {"type": "subtitle", "time": 338.469, "timestamp": "00:05:38", "text": "从日本到悉尼的互联网连接"}, {"type": "subtitle", "time": 339.99, "timestamp": "00:05:39", "text": "发送[音乐]"}, {"type": "subtitle", "time": 343.99, "timestamp": "00:05:43", "text": "数据大约需要"}, {"type": "subtitle", "time": 347.27, "timestamp": "00:05:47", "text": "216毫秒的往返时间"}, {"type": "subtitle", "time": 349.029, "timestamp": "00:05:49", "text": "。"}, {"type": "subtitle", "time": 353.27, "timestamp": "00:05:53", "text": "所以这就是为什么我"}, {"type": "subtitle", "time": 356.31, "timestamp": "00:05:56", "text": "的流媒体比特率只能保持在 3000 的原因。 所以，我好像"}, {"type": "subtitle", "time": 358.79, "timestamp": "00:05:58", "text": "换了个服务，呃，"}]
[{"type": "subtitle", "time": 1694.389, "timestamp": "00:28:14", "text": "那么，我们来计划一下我们需要"}, {"type": "subtitle", "time": 1697.43, "timestamp": "00:28:17", "text": "做什么。 好的。 我想进行侦察。 等等，我也"}, {"type": "subtitle", "time": 1700.789, "timestamp": "00:28:20", "text": "可以拿到司机那"}, {"type": "subtitle", "time": 1703.11, "timestamp": "00:28:23", "text": "玩意儿。"}, {"type": "subtitle", "time": 1705.51, "timestamp": "00:28:25", "text": "嗯，"}, {"type": "subtitle", "time": 1709.19, "timestamp": "00:28:29", "text": "我们来看看我们需要什么。 呃，我的"}, {"type": "subtitle", "time": 1711.909, "timestamp": "00:28:31", "text": "队友们，他们需要什么？ 有"}, {"type": "subtitle", "time": 1713.909, "timestamp": "00:28:33", "text": "两个基地。"}, {"type": "subtitle", "time": 1718.23, "timestamp": "00:28:38", "text": "呃，哪个是主打的？ 我不知道。"}, {"type": "subtitle", "time": 1721.43, "timestamp": "00:28:41", "text": "他们俩都带来了物资，对吧？ 为什么？"}, {"type": "subtitle", "time": 1724.23, "timestamp": "00:28:44", "text": "塔在哪里，兄弟？ 我勒个去"}, {"type": "subtitle", "time": 1727.51, "timestamp": "00:28:47", "text": "？ 他们在做什么？"}, {"type": "subtitle", "time": 1733.909, "timestamp": "00:28:53", "text": "蓝队在做什么？ 如果他们说“我的"}, {"type": "subtitle", "time": 1736.31, "timestamp": "00:28:56", "text": "天哪”。 我的天哪。 好了，有人在这里放了"}, {"type": "subtitle", "time": 1739.59, "timestamp": "00:28:59", "text": "个钥匙扣。 到底是怎么回事？"}]
[{"type": "subtitle", "time": 246.55, "timestamp": "00:04:06", "text": "你好。 你好。 你好。 你好。"}, {"type": "subtitle", "time": 249.11, "timestamp": "00:04:09", "text": "大家最近怎么样？"}, {"type": "subtitle", "time": 275.749, "timestamp": "00:04:35", "text": "嗯，今天我们要玩的是《战神》（Warog）。"}, {"type": "subtitle", "time": 280.469, "timestamp": "00:04:40", "text": "瓦罗格时间到了。 是瓦罗格。"}, {"type": "subtitle", "time": 284.263, "timestamp": "00:04:44", "text": "军犬。 军犬。 军犬。 军犬。"}, {"type": "subtitle", "time": 286.15, "timestamp": "00:04:46", "text": "[笑声]"}, {"type": "subtitle", "time": 290.629, "timestamp": "00:04:50", "text": "为什么要叫嚣战争犬？ 我勒个去？ 嗯，"}, {"type": "subtitle", "time": 293.83, "timestamp": "00:04:53", "text": "稍等一下。 我选错了比特率。"}, {"type": "subtitle", "time": 296.07, "timestamp": "00:04:56", "text": "一秒钟。"}]
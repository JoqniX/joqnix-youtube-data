[{"type": "subtitle", "time": 840.87, "timestamp": "00:14:00", "text": "，但是"}, {"type": "subtitle", "time": 844.47, "timestamp": "00:14:04", "text": "至少我可以挂机。  [笑声]"}, {"type": "subtitle", "time": 846.949, "timestamp": "00:14:06", "text": "至少我可以挂机在Warogs里赚点钱"}, {"type": "subtitle", "time": 850.71, "timestamp": "00:14:10", "text": "。 你知道你可以挂机吗？"}, {"type": "subtitle", "time": 854.389, "timestamp": "00:14:14", "text": "不，你不应该挂机。 如果你是"}, {"type": "subtitle", "time": 858.15, "timestamp": "00:14:18", "text": "挂机帮派成员，坐在装甲运兵车（重生载"}, {"type": "subtitle", "time": 860.014, "timestamp": "00:14:20", "text": "具）里，"}, {"type": "subtitle", "time": 861.35, "timestamp": "00:14:21", "text": "[清嗓子]只要重生载"}, {"type": "subtitle", "time": 863.75, "timestamp": "00:14:23", "text": "具还活着，"}, {"type": "subtitle", "time": 867.67, "timestamp": "00:14:27", "text": "没有死亡，你就可以挂机完成整个过程，每局"}, {"type": "subtitle", "time": 883.75, "timestamp": "00:14:43", "text": "游戏就能获得大约 50,000 美元。 眨眼。 嗯，如果"}, {"type": "subtitle", "time": 885.829, "timestamp": "00:14:45", "text": "一切顺利的话。 是的，我也经历过"}, {"type": "subtitle", "time": 889.35, "timestamp": "00:14:49", "text": "糟糕的时刻。 呃，死了。 老师发现"}, {"type": "subtitle", "time": 893.509, "timestamp": "00:14:53", "text": "我在玩游戏，狠狠地训了我一顿。 唉，"}, {"type": "subtitle", "time": 896.069, "timestamp": "00:14:56", "text": "发生的事情太多了。"}, {"type": "subtitle", "time": 898.389, "timestamp": "00:14:58", "text": "唉，发生的事情太多了。 但我玩得很"}]
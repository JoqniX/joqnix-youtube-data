[{"type": "subtitle", "time": 8222.79, "timestamp": "02:17:02", "text": "网络诈骗我没怎么失败过，但事情就是这样"}, {"type": "subtitle", "time": 8225.27, "timestamp": "02:17:05", "text": "，"}, {"type": "subtitle", "time": 8232.07, "timestamp": "02:17:12", "text": "你是认真的？ 正确的。 好的。 好的。"}, {"type": "subtitle", "time": 8234.23, "timestamp": "02:17:14", "text": "好的。 好的。 好的。"}, {"type": "subtitle", "time": 8236.549, "timestamp": "02:17:16", "text": "我当时感觉就像按了什么键，然后"}, {"type": "subtitle", "time": 8239.91, "timestamp": "02:17:19", "text": "网络就恢复正常了。"}, {"type": "subtitle", "time": 8243.669, "timestamp": "02:17:23", "text": "好的。 现在实际上已经不是“否”了。它真的在"}, {"type": "subtitle", "time": 8246.389, "timestamp": "02:17:26", "text": "修复吗？ 是因为现在是中午"}, {"type": "subtitle", "time": 8248.95, "timestamp": "02:17:28", "text": "12点吗？ 现在是12点。是"}, {"type": "subtitle", "time": 8251.75, "timestamp": "02:17:31", "text": "因为今天是12点吗？ 我的"}, {"type": "subtitle", "time": 8254.79, "timestamp": "02:17:34", "text": "网络要恢复了吗？   是"}, {"type": "subtitle", "time": 8271.91, "timestamp": "02:17:51", "text": "为什么我总觉得它正在"}, {"type": "subtitle", "time": 8275.27, "timestamp": "02:17:55", "text": "自行修复呢？ 就因为今天是"}, {"type": "subtitle", "time": 8279.27, "timestamp": "02:17:59", "text": "12点。我的天哪。 我现在应该直接"}]
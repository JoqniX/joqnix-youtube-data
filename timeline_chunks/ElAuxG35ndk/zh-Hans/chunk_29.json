[{"type": "subtitle", "time": 1742.07, "timestamp": "00:29:02", "text": "他们在做什么？ 他们在打架吗？"}, {"type": "subtitle", "time": 1744.149, "timestamp": "00:29:04", "text": "好吧，如果他们打起来了，我就说“"}, {"type": "subtitle", "time": 1746.87, "timestamp": "00:29:06", "text": "他们在打起来了”。"}, {"type": "subtitle", "time": 1749.75, "timestamp": "00:29:09", "text": "我去买玉米就行了。 你买它。"}, {"type": "subtitle", "time": 1758.149, "timestamp": "00:29:18", "text": "离开那里。"}, {"type": "subtitle", "time": 1764.549, "timestamp": "00:29:24", "text": "现在的问题是，我该如何前进？"}, {"type": "subtitle", "time": 1773.11, "timestamp": "00:29:33", "text": "等等，那边有辆空卡车。 我或许"}, {"type": "subtitle", "time": 1775.83, "timestamp": "00:29:35", "text": "可以接受"}, {"type": "subtitle", "time": 1783.75, "timestamp": "00:29:43", "text": "哦，那辆卡车来了。"}, {"type": "subtitle", "time": 1785.35, "timestamp": "00:29:45", "text": "请告诉我它没锁。 请"}, {"type": "subtitle", "time": 1787.669, "timestamp": "00:29:47", "text": "告诉我它没锁。 它没"}]
[{"type": "subtitle", "time": 781.59, "timestamp": "00:13:01", "text": "一个星期没关过笔记本电脑了。 兄弟，我把它当"}, {"type": "subtitle", "time": 785.03, "timestamp": "00:13:05", "text": "电脑用。 我已经一个星期没关过笔记本电脑了"}, {"type": "subtitle", "time": 786.79, "timestamp": "00:13:06", "text": "。"}, {"type": "subtitle", "time": 789.35, "timestamp": "00:13:09", "text": "今天为了直播，我特意把它关机重启了一下。"}, {"type": "subtitle", "time": 791.829, "timestamp": "00:13:11", "text": "Windows 进行了一次更新。 我希望它不会"}, {"type": "subtitle", "time": 794.31, "timestamp": "00:13:14", "text": "损坏东西。 但是，[嗤笑]我"}, {"type": "subtitle", "time": 797.75, "timestamp": "00:13:17", "text": "最近一直在用Apollo和Arus，"}, {"type": "subtitle", "time": 800.31, "timestamp": "00:13:20", "text": "它们相当于"}, {"type": "subtitle", "time": 803.75, "timestamp": "00:13:23", "text": "Moonlight和Sunshine，可以把"}, {"type": "subtitle", "time": 808.23, "timestamp": "00:13:28", "text": "你的电脑画面串流到互联网上，"}, {"type": "subtitle", "time": 810.71, "timestamp": "00:13:30", "text": "或者在你的设备（比如"}, {"type": "subtitle", "time": 814.15, "timestamp": "00:13:34", "text": "Steam Deck、"}, {"type": "subtitle", "time": 816.71, "timestamp": "00:13:36", "text": "手机之类的"}, {"type": "subtitle", "time": 818.87, "timestamp": "00:13:38", "text": "便携设备）上本地玩游戏。 所以，我一直用"}, {"type": "subtitle", "time": 821.35, "timestamp": "00:13:41", "text": "它来玩《战犬》和其他"}, {"type": "subtitle", "time": 823.91, "timestamp": "00:13:43", "text": "游戏，控制我的电脑，用"}, {"type": "subtitle", "time": 827.75, "timestamp": "00:13:47", "text": "那个虚拟 Xbox 控制器的"}, {"type": "subtitle", "time": 831.67, "timestamp": "00:13:51", "text": "按钮玩游戏什么的，感觉真的很"}, {"type": "subtitle", "time": 834.71, "timestamp": "00:13:54", "text": "不错。 我"}, {"type": "subtitle", "time": 837.829, "timestamp": "00:13:57", "text": "用鼠标和键盘玩游戏不太方便"}]
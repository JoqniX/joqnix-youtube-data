[{"type": "subtitle", "time": 361.11, "timestamp": "00:06:01", "text": "就像新加坡那种我"}, {"type": "subtitle", "time": 363.51, "timestamp": "00:06:03", "text": "用了很久的旧服务，然后我"}, {"type": "subtitle", "time": 367.029, "timestamp": "00:06:07", "text": "换成了免提耳机。 所以，"}, {"type": "subtitle", "time": 369.51, "timestamp": "00:06:09", "text": "呃，现在我认为比特率"}, {"type": "subtitle", "time": 374.87, "timestamp": "00:06:14", "text": "仍然是 3,000，但是，但是，是的，呃，"}, {"type": "subtitle", "time": 377.99, "timestamp": "00:06:17", "text": "但是你将能够发送 6,000"}, {"type": "subtitle", "time": 382.07, "timestamp": "00:06:22", "text": "比特率，就像基本的 6,000 比特率一样。"}, {"type": "subtitle", "time": 383.59, "timestamp": "00:06:23", "text": "嗯……"}, {"type": "subtitle", "time": 385.83, "timestamp": "00:06:25", "text": "我要把它发送到新加坡的"}, {"type": "subtitle", "time": 389.99, "timestamp": "00:06:29", "text": "服务器。 所以，该数据流正在发送到"}, {"type": "subtitle", "time": 393.43, "timestamp": "00:06:33", "text": "悉尼的服务器。 所以它会发布到"}, {"type": "subtitle", "time": 396.469, "timestamp": "00:06:36", "text": "所有其他平台。 所以这就像是某种"}, {"type": "subtitle", "time": 399.99, "timestamp": "00:06:39", "text": "小圆弧形的"}, {"type": "subtitle", "time": 405.35, "timestamp": "00:06:45", "text": "破解，虽然有点复杂，但某种程度上确实有效"}, {"type": "subtitle", "time": 408.05899999999997, "timestamp": "00:06:48", "text": "。"}, {"type": "subtitle", "time": 409.11, "timestamp": "00:06:49", "text": "[音乐]"}, {"type": "subtitle", "time": 415.43, "timestamp": "00:06:55", "text": "不过，应该没问题。 好的。"}, {"type": "subtitle", "time": 418.87, "timestamp": "00:06:58", "text": "总之，这么说吧，嗯，"}]
[{"type": "subtitle", "time": 480.869, "timestamp": "00:08:00", "text": "獲得所有掉落物一樣。我已經做完了"}, {"type": "subtitle", "time": 484.04, "timestamp": "00:08:04", "text": "。我已經收集齊了所有滴劑。"}, {"type": "subtitle", "time": 485.67, "timestamp": "00:08:05", "text": "[笑聲]"}, {"type": "subtitle", "time": 488.71, "timestamp": "00:08:08", "text": "是啊，夥計，我今天感覺特別開心，特別興奮"}, {"type": "subtitle", "time": 492.55, "timestamp": "00:08:12", "text": "。嗯？詭異的。是的，"}, {"type": "subtitle", "time": 496.23, "timestamp": "00:08:16", "text": "現在是9點39分。我大概會在"}, {"type": "subtitle", "time": 499.43, "timestamp": "00:08:19", "text": "11點左右吃晚餐。我不知道，"}, {"type": "subtitle", "time": 501.35, "timestamp": "00:08:21", "text": "但我打算在"}, {"type": "subtitle", "time": 504.309, "timestamp": "00:08:24", "text": "那段時間左右吃晚餐。"}, {"type": "subtitle", "time": 510.629, "timestamp": "00:08:30", "text": "嗯，是的，在繼續看狗狗影片之前，我想先簡單聊幾句。嗯，是的，最近"}, {"type": "subtitle", "time": 513.43, "timestamp": "00:08:33", "text": "我一直在測試"}, {"type": "subtitle", "time": 516.389, "timestamp": "00:08:36", "text": "我電腦上的所有東西。"}, {"type": "subtitle", "time": 520.07, "timestamp": "00:08:40", "text": "我買的筆記型電腦，呃，是一台遊戲筆記型電腦，我"}, {"type": "subtitle", "time": 522.7090000000001, "timestamp": "00:08:42", "text": "從日本買的。呃，這叫什麼來著"}]
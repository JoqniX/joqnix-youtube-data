[{"type": "subtitle", "time": 246.55, "timestamp": "00:04:06", "text": "你好。你好。你好。你好。"}, {"type": "subtitle", "time": 249.11, "timestamp": "00:04:09", "text": "大家最近怎麼樣？"}, {"type": "subtitle", "time": 275.749, "timestamp": "00:04:35", "text": "嗯，今天我們要玩的是《戰神》（Warog）。"}, {"type": "subtitle", "time": 280.469, "timestamp": "00:04:40", "text": "瓦羅格時間到了。是瓦羅格。"}, {"type": "subtitle", "time": 284.263, "timestamp": "00:04:44", "text": "軍犬。軍犬。軍犬。軍犬。"}, {"type": "subtitle", "time": 286.15, "timestamp": "00:04:46", "text": "[笑聲]"}, {"type": "subtitle", "time": 290.629, "timestamp": "00:04:50", "text": "為什麼要叫囂戰爭犬？我勒個去？嗯，稍等一下"}, {"type": "subtitle", "time": 293.83, "timestamp": "00:04:53", "text": "。我選錯比特率了。"}, {"type": "subtitle", "time": 296.07, "timestamp": "00:04:56", "text": "一秒鐘。"}]
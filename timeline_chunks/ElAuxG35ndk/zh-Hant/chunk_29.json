[{"type": "subtitle", "time": 1742.07, "timestamp": "00:29:02", "text": "偵察。等等，"}, {"type": "subtitle", "time": 1744.149, "timestamp": "00:29:04", "text": "我也可以拿到司機那"}, {"type": "subtitle", "time": 1746.87, "timestamp": "00:29:06", "text": "玩意兒。  嗯，我們來看看我們需要什麼。呃，我的隊友們，他們需要什麼？有兩個"}, {"type": "subtitle", "time": 1749.75, "timestamp": "00:29:09", "text": "基地。  呃，哪個才是主打的呢？"}, {"type": "subtitle", "time": 1775.83, "timestamp": "00:29:35", "text": "不知道。  他們兩個都帶來了物資，對吧？為什麼？塔在哪裡，兄弟？我勒個去？他們在做什麼？藍隊在做什麼？  藍隊在做什麼？如果他們"}, {"type": "subtitle", "time": 1785.35, "timestamp": "00:29:45", "text": "說「我的天哪」。我的"}]
[{"type": "subtitle", "time": 301.11, "timestamp": "00:05:01", "text": "6,000。正式宣布。"}, {"type": "subtitle", "time": 305.99, "timestamp": "00:05:05", "text": "它有點挑剔。嗯，我就知道。"}, {"type": "subtitle", "time": 310.31, "timestamp": "00:05:10", "text": "昨天我測試過了。所以，你們"}, {"type": "subtitle", "time": 313.189, "timestamp": "00:05:13", "text": "知道為什麼我的直播品質"}, {"type": "subtitle", "time": 315.27, "timestamp": "00:05:15", "text": "不好，因為我同時在多個平台上直播，對吧？"}, {"type": "subtitle", "time": 318.71, "timestamp": "00:05:18", "text": "所以，我最近才發現，"}, {"type": "subtitle", "time": 323.029, "timestamp": "00:05:23", "text": "我向雪梨的伺服器發送了 3000 位元率的數據，"}, {"type": "subtitle", "time": 329.51, "timestamp": "00:05:29", "text": "因為我在日本，離"}, {"type": "subtitle", "time": 332.469, "timestamp": "00:05:32", "text": "東京很近，或者也許離東京沒那麼近"}, {"type": "subtitle", "time": 335.35, "timestamp": "00:05:35", "text": "。所以顯然，"}, {"type": "subtitle", "time": 338.469, "timestamp": "00:05:38", "text": "從日本到雪梨的網路連線"}, {"type": "subtitle", "time": 339.99, "timestamp": "00:05:39", "text": "發送[音樂]"}, {"type": "subtitle", "time": 343.99, "timestamp": "00:05:43", "text": "資料大約需要"}, {"type": "subtitle", "time": 347.27, "timestamp": "00:05:47", "text": "216"}, {"type": "subtitle", "time": 349.029, "timestamp": "00:05:49", "text": "毫秒的往返時間。"}, {"type": "subtitle", "time": 353.27, "timestamp": "00:05:53", "text": "所以這就是為什麼我的"}, {"type": "subtitle", "time": 356.31, "timestamp": "00:05:56", "text": "串流媒體比特率只能保持在 3000 的原因。所以，我好像"}, {"type": "subtitle", "time": 358.79, "timestamp": "00:05:58", "text": "換了個服務，呃，"}]
[{"type": "subtitle", "time": 8236.549, "timestamp": "02:17:16", "text": "下載一樣，為什麼我的上傳速度這麼慢"}, {"type": "subtitle", "time": 8246.389, "timestamp": "02:17:26", "text": "？拜託，兄弟。為什麼你的網路速度只有"}, {"type": "subtitle", "time": 8248.95, "timestamp": "02:17:28", "text": "3 Mbps？  我怒不可遏。我只想玩遊戲。"}, {"type": "subtitle", "time": 8251.75, "timestamp": "02:17:31", "text": "我想玩遊戲，但今天我這破"}, {"type": "subtitle", "time": 8254.79, "timestamp": "02:17:34", "text": "網路太爛，玩不了。  哇。  瘋狂的。瘋狂的。  瘋狂的。  瘋狂的。  不，我知道。我一結束直播，"}, {"type": "subtitle", "time": 8257.11, "timestamp": "02:17:37", "text": "它就會恢復正常。"}, {"type": "subtitle", "time": 8271.91, "timestamp": "02:17:51", "text": "我絕對知道它會恢復原狀。  我該如何快速通過這個愚蠢的東西（唱歌和音樂）（呻吟和尖叫）？它不讓我上去唱首歌，"}]
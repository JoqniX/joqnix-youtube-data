[{"type": "subtitle", "time": 4021.19, "timestamp": "01:07:01", "text": "。 えっと、彼は"}, {"type": "subtitle", "time": 4023.51, "timestamp": "01:07:03", "text": "ウィジェット関連の問題を修正する必要があるし、"}, {"type": "subtitle", "time": 4026.47, "timestamp": "01:07:06", "text": "Viso Liveアプリも修正する必要がある"}, {"type": "subtitle", "time": 4031.349, "timestamp": "01:07:11", "text": "。 カメラではなく、"}, {"type": "subtitle", "time": 4033.27, "timestamp": "01:07:13", "text": "ストリームで見ているプレビュー、テキスト、その他すべてが"}, {"type": "subtitle", "time": 4035.51, "timestamp": "01:07:15", "text": "小さくなっています。"}, {"type": "subtitle", "time": 4038.549, "timestamp": "01:07:18", "text": "私の場合は、プレビューで私が"}, {"type": "subtitle", "time": 4042.549, "timestamp": "01:07:22", "text": "見ているものとストリームであなたが見ているものが明らかに違うんです"}, {"type": "subtitle", "time": 4044.23, "timestamp": "01:07:24", "text": "。"}, {"type": "subtitle", "time": 4047.91, "timestamp": "01:07:27", "text": "ええ、スケーリングのアップデートがありました。 それで、"}, {"type": "subtitle", "time": 4050.789, "timestamp": "01:07:30", "text": "彼はいくつかのバグを修正する必要があるのですが、"}, {"type": "subtitle", "time": 4053.19, "timestamp": "01:07:33", "text": "特にライブチャットウィジェットの件も"}, {"type": "subtitle", "time": 4057.349, "timestamp": "01:07:37", "text": "修正が必要です。"}, {"type": "subtitle", "time": 4066.87, "timestamp": "01:07:46", "text": "そう、私もズーム機能をリクエストしました。"}, {"type": "subtitle", "time": 4070.309, "timestamp": "01:07:50", "text": "カメラにズーム機能を付けてほしいと頼みました。"}, {"type": "subtitle", "time": 4073.109, "timestamp": "01:07:53", "text": "だから、これを持ってズームすれば、"}]
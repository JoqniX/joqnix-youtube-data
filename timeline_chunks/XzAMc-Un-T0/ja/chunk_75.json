[{"type": "subtitle", "time": 4502.87, "timestamp": "01:15:02", "text": "ここはダンススクールか何かですか？"}, {"type": "subtitle", "time": 4505.43, "timestamp": "01:15:05", "text": "学生たちが踊っている。"}, {"type": "subtitle", "time": 4506.63, "timestamp": "01:15:06", "text": "彼らは鏡を見ながら"}, {"type": "subtitle", "time": 4508.63, "timestamp": "01:15:08", "text": "踊っている。 今はそれを配信で見せるべきではない"}, {"type": "subtitle", "time": 4511.27, "timestamp": "01:15:11", "text": "。 ええ、それは公共のプライバシーの侵害です"}, {"type": "subtitle", "time": 4512.95, "timestamp": "01:15:12", "text": "。"}, {"type": "subtitle", "time": 4544.149, "timestamp": "01:15:44", "text": "すべて電源が切れています。 まあ、バグは"}, {"type": "subtitle", "time": 4553.43, "timestamp": "01:15:53", "text": "最後にもう一度だけお見せします。"}, {"type": "subtitle", "time": 4556.39, "timestamp": "01:15:56", "text": "ええと、"}, {"type": "subtitle", "time": 4559.59, "timestamp": "01:15:59", "text": "最後にもう一度。 でも景色は素晴らしいよ"}]
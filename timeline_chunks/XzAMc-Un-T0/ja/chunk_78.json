[{"type": "subtitle", "time": 4700.47, "timestamp": "01:18:20", "text": "ええ、大きな変化はないでしょう。   ほんの"}, {"type": "subtitle", "time": 4703.43, "timestamp": "01:18:23", "text": "少しの変更です。"}, {"type": "subtitle", "time": 4707.99, "timestamp": "01:18:27", "text": "背景など、必要な素材をいくつか探さなければなりません"}, {"type": "subtitle", "time": 4723.83, "timestamp": "01:18:43", "text": "もし2日間滞在できたなら、ずっとここにいただろう"}, {"type": "subtitle", "time": 4725.91, "timestamp": "01:18:45", "text": "。"}, {"type": "subtitle", "time": 4730.709, "timestamp": "01:18:50", "text": "公園にもっと長い小川があればよかったのに。"}, {"type": "subtitle", "time": 4734.229, "timestamp": "01:18:54", "text": "アイスクリームの自動販売"}, {"type": "subtitle", "time": 4736.149, "timestamp": "01:18:56", "text": "機を見てみたいですか？"}]
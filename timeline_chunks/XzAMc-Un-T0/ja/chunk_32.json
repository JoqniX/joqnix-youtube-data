[{"type": "subtitle", "time": 1921.99, "timestamp": "00:32:01", "text": "ハト、捕まえたぞ。"}, {"type": "subtitle", "time": 1925.99, "timestamp": "00:32:05", "text": "なぜ？ なぜ彼は私をつけてくるの？ さっき"}, {"type": "subtitle", "time": 1928.87, "timestamp": "00:32:08", "text": "あそこであなたを見かけましたよね？"}, {"type": "subtitle", "time": 1931.83, "timestamp": "00:32:11", "text": "あなたにあげるおやつがあると思いますか？"}, {"type": "subtitle", "time": 1935.669, "timestamp": "00:32:15", "text": "待って、私は持っていない、私はキャンディーしか持っていない。"}, {"type": "subtitle", "time": 1937.269, "timestamp": "00:32:17", "text": "あなたはキャンディーが好きではないと思います。 つまり、"}, {"type": "subtitle", "time": 1940.31, "timestamp": "00:32:20", "text": "熱くて固いということですね。"}, {"type": "subtitle", "time": 1942.71, "timestamp": "00:32:22", "text": "O"}, {"type": "subtitle", "time": 1949.59, "timestamp": "00:32:29", "text": "彼は私のことが好きだ。"}, {"type": "chat", "time": 1965.41, "timestamp": "00:32:45", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "birb frend"}, {"type": "subtitle", "time": 1965.59, "timestamp": "00:32:45", "text": "彼はなぜこんなことをするのだろうか？"}, {"type": "subtitle", "time": 1970.549, "timestamp": "00:32:50", "text": "待って。 わかった。 彼は別れたの？"}]
[{"type": "subtitle", "time": 4297.99, "timestamp": "01:11:37", "text": "待って、私は「ボトルを元の場所に戻さなかった」って書いたよね"}, {"type": "subtitle", "time": 4300.63, "timestamp": "01:11:40", "text": "？   わかった"}, {"type": "subtitle", "time": 4309.99, "timestamp": "01:11:49", "text": "見せる。   そろそろ引き返してもいい頃だと"}, {"type": "subtitle", "time": 4312.709, "timestamp": "01:11:52", "text": "思います。"}, {"type": "subtitle", "time": 4316.87, "timestamp": "01:11:56", "text": "歩きながらどこかに座っていようかな。"}, {"type": "subtitle", "time": 4319.764, "timestamp": "01:11:59", "text": "こんにちは、戻りましょう。"}]
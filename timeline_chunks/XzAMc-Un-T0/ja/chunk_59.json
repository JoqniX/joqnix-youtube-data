[{"type": "subtitle", "time": 3542.069, "timestamp": "00:59:02", "text": "。 彼はそう言った。 私は"}, {"type": "subtitle", "time": 3543.829, "timestamp": "00:59:03", "text": "「ねえ、"}, {"type": "subtitle", "time": 3548.63, "timestamp": "00:59:08", "text": "酔っ払って日本の歌を歌うの。"}, {"type": "subtitle", "time": 3550.789, "timestamp": "00:59:10", "text": "何？"}, {"type": "subtitle", "time": 3556.309, "timestamp": "00:59:16", "text": "元気です。 今は東京ディオにいて、"}, {"type": "subtitle", "time": 3558.23, "timestamp": "00:59:18", "text": "公園みたいなところで散歩したり"}, {"type": "subtitle", "time": 3566.71, "timestamp": "00:59:26", "text": "それは今までで一番奇妙な出来事だ。  D、"}, {"type": "subtitle", "time": 3568.87, "timestamp": "00:59:28", "text": "私が知っているように、私は歌いたいし、何でも好きです"}, {"type": "subtitle", "time": 3571.19, "timestamp": "00:59:31", "text": "。 でも、得意じゃないんです。 私は"}, {"type": "subtitle", "time": 3573.349, "timestamp": "00:59:33", "text": "歌を歌いたいと思っていて、いつも"}, {"type": "subtitle", "time": 3577.109, "timestamp": "00:59:37", "text": "日本の音楽を聴いています。 でもまあ、"}, {"type": "subtitle", "time": 3581.829, "timestamp": "00:59:41", "text": "酔っ払って寝言を言ってたよ。 うん。 何？"}, {"type": "subtitle", "time": 3584.47, "timestamp": "00:59:44", "text": "それは"}, {"type": "subtitle", "time": 3587.349, "timestamp": "00:59:47", "text": "尋常ではない、異例の出来事だった。"}, {"type": "subtitle", "time": 3589.75, "timestamp": "00:59:49", "text": "そんな話は初めて聞いた。 でも、そうなんです。"}, {"type": "subtitle", "time": 3592.23, "timestamp": "00:59:52", "text": "それ以来ずっと、「もう二度とお酒は"}, {"type": "subtitle", "time": 3594.39, "timestamp": "00:59:54", "text": "飲まない」って思っていました。"}, {"type": "subtitle", "time": 3596.95, "timestamp": "00:59:56", "text": "ええ、でも誰にも分かりませんよね？"}, {"type": "subtitle", "time": 3599.27, "timestamp": "00:59:59", "text": "飲みたくないけど、"}]
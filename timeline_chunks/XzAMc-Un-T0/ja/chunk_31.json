[{"type": "subtitle", "time": 1860.63, "timestamp": "00:31:00", "text": "いいですね。"}, {"type": "subtitle", "time": 1863.029, "timestamp": "00:31:03", "text": "私のスマートフォンの音声を使用します。"}, {"type": "subtitle", "time": 1865.19, "timestamp": "00:31:05", "text": "外部マイクは使えます"}, {"type": "subtitle", "time": 1866.789, "timestamp": "00:31:06", "text": "が、"}, {"type": "subtitle", "time": 1869.19, "timestamp": "00:31:09", "text": "外部カメラがあればもっと良いですね。   では、"}, {"type": "subtitle", "time": 1873.35, "timestamp": "00:31:13", "text": "外部カメラがどのように"}, {"type": "subtitle", "time": 1875.19, "timestamp": "00:31:15", "text": "動作するのか、私には分かりません。"}, {"type": "subtitle", "time": 1877.669, "timestamp": "00:31:17", "text": "考えたこともなかったし、試したことも、買ったことも、"}, {"type": "subtitle", "time": 1882.549, "timestamp": "00:31:22", "text": "試したこともなかった。 だから、私にはわからない。   仕組みを"}, {"type": "subtitle", "time": 1886.07, "timestamp": "00:31:26", "text": "調べて、自分にもできるかどうか試してみます"}, {"type": "subtitle", "time": 1888.549, "timestamp": "00:31:28", "text": "。   でも"}, {"type": "subtitle", "time": 1891.35, "timestamp": "00:31:31", "text": "、ハイエンドな用途には、質の良いスマホが必要だと感じています"}, {"type": "subtitle", "time": 1896.31, "timestamp": "00:31:36", "text": "。"}, {"type": "subtitle", "time": 1903.509, "timestamp": "00:31:43", "text": "今の風、すごく気持ちいい。"}, {"type": "subtitle", "time": 1905.75, "timestamp": "00:31:45", "text": "聞こえますか？"}, {"type": "subtitle", "time": 1908.549, "timestamp": "00:31:48", "text": "子供たちが遊んでいる。 でも、ほら、"}, {"type": "subtitle", "time": 1911.99, "timestamp": "00:31:51", "text": "こっちに友達がいるんだよ。"}, {"type": "subtitle", "time": 1914.07, "timestamp": "00:31:54", "text": "私にはそこに友人がいる。 待って、待って、待って、"}, {"type": "subtitle", "time": 1916.23, "timestamp": "00:31:56", "text": "待って。"}, {"type": "subtitle", "time": 1919.269, "timestamp": "00:31:59", "text": "鳩のジョンがここにいます。"}]
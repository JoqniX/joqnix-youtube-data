[{"type": "subtitle", "time": 3900.87, "timestamp": "01:05:00", "text": "新型モデル。 そうそう。 何てことだ。"}, {"type": "subtitle", "time": 3903.589, "timestamp": "01:05:03", "text": "そうそう。   何てことだ"}, {"type": "subtitle", "time": 3906.069, "timestamp": "01:05:06", "text": "。"}, {"type": "subtitle", "time": 3909.67, "timestamp": "01:05:09", "text": "面白い事実をご存知ですか？"}, {"type": "subtitle", "time": 3915.19, "timestamp": "01:05:15", "text": "7月18日に公開するモデルは、"}, {"type": "subtitle", "time": 3922.069, "timestamp": "01:05:22", "text": "最初のレンダリング、"}, {"type": "subtitle", "time": 3924.39, "timestamp": "01:05:24", "text": "つまり最初のフルコミッションは"}, {"type": "subtitle", "time": 3927.109, "timestamp": "01:05:27", "text": "2020年"}, {"type": "subtitle", "time": 3928.63, "timestamp": "01:05:28", "text": "の"}, {"type": "subtitle", "time": 3932.39, "timestamp": "01:05:32", "text": "8月12日、私の誕生日の翌日に完了しました。   それはまるで"}, {"type": "subtitle", "time": 3936.23, "timestamp": "01:05:36", "text": "遅れた誕生日プレゼントみたいで、本当に"}, {"type": "subtitle", "time": 3938.87, "timestamp": "01:05:38", "text": "嬉しかった。"}, {"type": "subtitle", "time": 3941.829, "timestamp": "01:05:41", "text": "どれほど嬉しかったか、言葉では言い表せないほど。 それを"}, {"type": "subtitle", "time": 3946.069, "timestamp": "01:05:46", "text": "壁紙に設定しました。 私はそれを、以前は"}, {"type": "subtitle", "time": 3953.67, "timestamp": "01:05:53", "text": "ゲーム配信をたくさんやっていて、デュアルPC"}, {"type": "subtitle", "time": 3956.71, "timestamp": "01:05:56", "text": "構成だったためできなかったと書きました。"}]
[{"type": "subtitle", "time": 4332.31, "timestamp": "01:12:12", "text": "ああ、これからはもっと日本の配信をするべきだな。"}, {"type": "subtitle", "time": 4335.91, "timestamp": "01:12:15", "text": "語学の練習ができていない"}, {"type": "subtitle", "time": 4344.07, "timestamp": "01:12:24", "text": "ええ、ここには子供たちがいますよ。"}, {"type": "subtitle", "time": 4346.31, "timestamp": "01:12:26", "text": "時々、"}, {"type": "subtitle", "time": 4349.75, "timestamp": "01:12:29", "text": "時間を巻き戻して、小さな子供に戻りたいと思うことがあるんです。"}, {"type": "subtitle", "time": 4352.31, "timestamp": "01:12:32", "text": "学校のことも心配しなくていいし、"}, {"type": "subtitle", "time": 4354.87, "timestamp": "01:12:34", "text": "責任のことも心配しなくていい。"}, {"type": "subtitle", "time": 4357.189, "timestamp": "01:12:37", "text": "私は大人になりたくない。"}, {"type": "subtitle", "time": 4360.55, "timestamp": "01:12:40", "text": "お金の心配は無用です。"}, {"type": "subtitle", "time": 4362.709, "timestamp": "01:12:42", "text": "ええと、本当にたくさんのことがあります"}, {"type": "subtitle", "time": 4365.59, "timestamp": "01:12:45", "text": "。"}, {"type": "subtitle", "time": 4367.51, "timestamp": "01:12:47", "text": "でも、たとえ大人でも、時には"}, {"type": "subtitle", "time": 4370.07, "timestamp": "01:12:50", "text": "子供心を取り戻すのも良いものだ。"}, {"type": "subtitle", "time": 4372.79, "timestamp": "01:12:52", "text": "子供じみたことをする。"}, {"type": "subtitle", "time": 4375.43, "timestamp": "01:12:55", "text": "うん。   では、"}, {"type": "subtitle", "time": 4378.149, "timestamp": "01:12:58", "text": "どうやって寝かしつけるか。 残りの"}]
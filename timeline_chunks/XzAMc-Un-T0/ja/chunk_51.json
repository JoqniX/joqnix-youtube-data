[{"type": "subtitle", "time": 3060.39, "timestamp": "00:51:00", "text": "まあ、でも順応しているところです。"}, {"type": "subtitle", "time": 3064.23, "timestamp": "00:51:04", "text": "時々、"}, {"type": "subtitle", "time": 3068.63, "timestamp": "00:51:08", "text": "家に帰って、のんびりしたり、のんびりしたり、一"}, {"type": "subtitle", "time": 3075.99, "timestamp": "00:51:15", "text": "日中配信したり、食べて、"}, {"type": "subtitle", "time": 3078.79, "timestamp": "00:51:18", "text": "寝て、配信したりできたらいいのにって思うんです。"}, {"type": "subtitle", "time": 3081.829, "timestamp": "00:51:21", "text": "でも、いや、それはできないって気づいたんです。 私は"}, {"type": "subtitle", "time": 3086.069, "timestamp": "00:51:26", "text": "大人か学生として、"}, {"type": "subtitle", "time": 3090.47, "timestamp": "00:51:30", "text": "一生懸命働き、自分でお金を稼がなければならない。"}, {"type": "subtitle", "time": 3093.43, "timestamp": "00:51:33", "text": "節約する、などなど。"}, {"type": "subtitle", "time": 3098.069, "timestamp": "00:51:38", "text": "そうですね。 それは新しい"}, {"type": "subtitle", "time": 3100.309, "timestamp": "00:51:40", "text": "経験だ。"}, {"type": "subtitle", "time": 3102.549, "timestamp": "00:51:42", "text": "ダイアナ、"}, {"type": "subtitle", "time": 3105.43, "timestamp": "00:51:45", "text": "うん、"}, {"type": "subtitle", "time": 3107.67, "timestamp": "00:51:47", "text": "いい感じだね。"}, {"type": "subtitle", "time": 3109.27, "timestamp": "00:51:49", "text": "うん。   それでも、"}, {"type": "subtitle", "time": 3111.43, "timestamp": "00:51:51", "text": "あなたは何かを築き上げているんですよね"}, {"type": "subtitle", "time": 3115.67, "timestamp": "00:51:55", "text": "。 ええ、"}, {"type": "subtitle", "time": 3117.589, "timestamp": "00:51:57", "text": "新しいことを学んでいます。"}]
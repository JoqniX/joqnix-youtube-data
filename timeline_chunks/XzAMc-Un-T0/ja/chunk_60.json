[{"type": "subtitle", "time": 3601.75, "timestamp": "01:00:01", "text": "うん、たまには。 ええ、一度だけ。いや、"}, {"type": "subtitle", "time": 3604.71, "timestamp": "01:00:04", "text": "そんなことを言うべきではない。 でも、"}, {"type": "subtitle", "time": 3607.27, "timestamp": "01:00:07", "text": "リンゴジュースで十分満足です。"}, {"type": "subtitle", "time": 3610.71, "timestamp": "01:00:10", "text": "ええ、私はいつも小さな"}, {"type": "subtitle", "time": 3615.27, "timestamp": "01:00:15", "text": "ジュースパックを買って飲みます。 えっと、確か120円だったと思います。"}, {"type": "subtitle", "time": 3617.349, "timestamp": "01:00:17", "text": "120円。"}, {"type": "subtitle", "time": 3620.309, "timestamp": "01:00:20", "text": "私はこのリンゴジュースを買って飲むだけです。"}, {"type": "subtitle", "time": 3623.75, "timestamp": "01:00:23", "text": "飲んでください。 うん。"}, {"type": "subtitle", "time": 3631.03, "timestamp": "01:00:31", "text": "本当に友達を作りたいんです。"}, {"type": "subtitle", "time": 3634.069, "timestamp": "01:00:34", "text": "長続きする友達を。でも、私が"}, {"type": "subtitle", "time": 3637.19, "timestamp": "01:00:37", "text": "ここで知っているような友達は、"}, {"type": "subtitle", "time": 3639.99, "timestamp": "01:00:39", "text": "誰かと出会って、「"}, {"type": "subtitle", "time": 3641.589, "timestamp": "01:00:41", "text": "友達になってくれませんか？」と聞くと、「いいよ」と言ってくれて、"}, {"type": "subtitle", "time": 3646.39, "timestamp": "01:00:46", "text": "連絡先などを教えてくれるんだけど、その後"}, {"type": "subtitle", "time": 3649.19, "timestamp": "01:00:49", "text": "返事がなかったり、忘れられたりすることもあるんです。そういうことが何度かありました。だから、"}]
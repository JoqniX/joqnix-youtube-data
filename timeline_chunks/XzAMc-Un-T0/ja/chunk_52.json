[{"type": "subtitle", "time": 3120.79, "timestamp": "00:52:00", "text": "だから、私はもう自立しているんです。  [笑い]"}, {"type": "subtitle", "time": 3124.79, "timestamp": "00:52:04", "text": "お金の管理方法を学んでいるところですが、"}, {"type": "subtitle", "time": 3129.19, "timestamp": "00:52:09", "text": "コミュニケーションはまだ課題ですよね"}, {"type": "subtitle", "time": 3132.069, "timestamp": "00:52:12", "text": "？ 人と話すとき、心の"}, {"type": "subtitle", "time": 3134.549, "timestamp": "00:52:14", "text": "奥底では「この人と話したい」と思っているのですが、"}, {"type": "subtitle", "time": 3137.43, "timestamp": "00:52:17", "text": "どう話しかけたらいいのか分からなくて困っています"}, {"type": "subtitle", "time": 3139.43, "timestamp": "00:52:19", "text": "。"}, {"type": "subtitle", "time": 3141.349, "timestamp": "00:52:21", "text": "うん。 誰かと仲良くなると、まるで配信中みたいにすごくおしゃべりになるんです"}, {"type": "subtitle", "time": 3146.39, "timestamp": "00:52:26", "text": "。 ええと、相手のことをよく"}, {"type": "subtitle", "time": 3150.71, "timestamp": "00:52:30", "text": "知るようになると、すごくおしゃべりになります。"}, {"type": "subtitle", "time": 3153.27, "timestamp": "00:52:33", "text": "それで、ダイアナ。"}, {"type": "subtitle", "time": 3156.23, "timestamp": "00:52:36", "text": "うん。   でも"}, {"type": "subtitle", "time": 3159.91, "timestamp": "00:52:39", "text": "、日本は楽しい"}, {"type": "subtitle", "time": 3162.549, "timestamp": "00:52:42", "text": "けど、厳しいところもある。  [笑い]"}, {"type": "subtitle", "time": 3164.87, "timestamp": "00:52:44", "text": "大変ですね。 職場環境と同様に、"}, {"type": "subtitle", "time": 3167.67, "timestamp": "00:52:47", "text": "すべてが厳しい。"}, {"type": "subtitle", "time": 3173.67, "timestamp": "00:52:53", "text": "趣味を"}, {"type": "subtitle", "time": 3177.75, "timestamp": "00:52:57", "text": "仕事にできたらいいなと思っています。"}]
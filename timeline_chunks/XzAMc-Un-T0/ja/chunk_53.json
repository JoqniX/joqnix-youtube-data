[{"type": "subtitle", "time": 3183.19, "timestamp": "00:53:03", "text": "例えば、YouTubeとかそういうのもいいな。"}, {"type": "subtitle", "time": 3187.03, "timestamp": "00:53:07", "text": "タレントとして活動したり、"}, {"type": "subtitle", "time": 3190.39, "timestamp": "00:53:10", "text": "YouTuberとして活動したりとか。いくつか"}, {"type": "subtitle", "time": 3192.63, "timestamp": "00:53:12", "text": "バックアッププランはありますが、まだ何をすべきか"}, {"type": "subtitle", "time": 3197.03, "timestamp": "00:53:17", "text": "決めていません。"}, {"type": "subtitle", "time": 3199.91, "timestamp": "00:53:19", "text": "ここで一番重要なのは、日本語を学び、"}, {"type": "subtitle", "time": 3203.109, "timestamp": "00:53:23", "text": "日本語力とコミュニケーション能力を向上させることです"}, {"type": "subtitle", "time": 3206.069, "timestamp": "00:53:26", "text": "。"}, {"type": "subtitle", "time": 3209.75, "timestamp": "00:53:29", "text": "時間がかかるでしょう。"}, {"type": "subtitle", "time": 3212.309, "timestamp": "00:53:32", "text": "うん。 そして今日は授業が本当に楽しかった。えっと、"}, {"type": "subtitle", "time": 3216.549, "timestamp": "00:53:36", "text": "日本語の"}, {"type": "subtitle", "time": 3218.95, "timestamp": "00:53:38", "text": "授業じゃなくて、ユーチューバーの体験授業みたいなやつ"}, {"type": "subtitle", "time": 3220.87, "timestamp": "00:53:40", "text": "。"}, {"type": "subtitle", "time": 3222.87, "timestamp": "00:53:42", "text": "うん、"}, {"type": "subtitle", "time": 3225.349, "timestamp": "00:53:45", "text": "あの学校は私のことを知ってるよ。だって"}, {"type": "subtitle", "time": 3228.63, "timestamp": "00:53:48", "text": "12回くらい行ったから。"}, {"type": "subtitle", "time": 3231.99, "timestamp": "00:53:51", "text": "ええ、"}, {"type": "subtitle", "time": 3235.589, "timestamp": "00:53:55", "text": "音楽制作の"}, {"type": "subtitle", "time": 3239.67, "timestamp": "00:53:59", "text": "仕事や声優の仕事などで、12回ほどそこに行きました。色々な"}]
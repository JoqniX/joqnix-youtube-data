[{"type": "subtitle", "time": 1642.789, "timestamp": "00:27:22", "text": "鳩。"}, {"type": "subtitle", "time": 1646.149, "timestamp": "00:27:26", "text": "彼はここにいる。 文字通り手を振っている。  [笑い]"}, {"type": "subtitle", "time": 1649.029, "timestamp": "00:27:29", "text": "彼はまさにここで手を振っている。"}, {"type": "subtitle", "time": 1652.23, "timestamp": "00:27:32", "text": "ああ、見て。 あそこにシブがいるよ。"}, {"type": "subtitle", "time": 1654.63, "timestamp": "00:27:34", "text": "人に見せることはできません。   ほんの一瞬だけ"}, {"type": "subtitle", "time": 1676.389, "timestamp": "00:27:56", "text": "最初にあの、なんて"}]
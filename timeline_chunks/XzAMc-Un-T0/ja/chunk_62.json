[{"type": "subtitle", "time": 3724.87, "timestamp": "01:02:04", "text": "人に慣れていないから、それに気づいたんです。"}, {"type": "subtitle", "time": 3730.549, "timestamp": "01:02:10", "text": "そうですね。   ああ"}, {"type": "subtitle", "time": 3733.75, "timestamp": "01:02:13", "text": "、そうだね。 彼らが"}, {"type": "subtitle", "time": 3736.47, "timestamp": "01:02:16", "text": "私たちを無視するよりも、気まずい状況を避ける方を優先しているからだと思う。"}, {"type": "subtitle", "time": 3739.43, "timestamp": "01:02:19", "text": "ええ、そうです。   というわけで"}, {"type": "subtitle", "time": 3750.39, "timestamp": "01:02:30", "text": "、今週から授業が"}, {"type": "subtitle", "time": 3754.63, "timestamp": "01:02:34", "text": "始まります。明日はありません。 休暇は終わりました。   今後、"}, {"type": "subtitle", "time": 3757.589, "timestamp": "01:02:37", "text": "2週間の"}, {"type": "subtitle", "time": 3761.67, "timestamp": "01:02:41", "text": "休暇がもっと増えるだろうか。 今月は休暇です。"}, {"type": "subtitle", "time": 3764.95, "timestamp": "01:02:44", "text": "8月に開催されることは知っています。"}, {"type": "subtitle", "time": 3767.75, "timestamp": "01:02:47", "text": "ええ、8月から語学教室が2週間"}, {"type": "subtitle", "time": 3769.51, "timestamp": "01:02:49", "text": "休みになります"}, {"type": "subtitle", "time": 3774.87, "timestamp": "01:02:54", "text": "。"}, {"type": "subtitle", "time": 3776.789, "timestamp": "01:02:56", "text": "どうやら私の"}]
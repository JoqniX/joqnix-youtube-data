[{"type": "subtitle", "time": 542.87, "timestamp": "00:09:02", "text": "。 寝るわけにはいかないよ。 ああ、"}, {"type": "subtitle", "time": 546.23, "timestamp": "00:09:06", "text": "寝て忘れるわけにはいかないよ。"}, {"type": "subtitle", "time": 548.15, "timestamp": "00:09:08", "text": "ああ、そう、"}, {"type": "subtitle", "time": 550.949, "timestamp": "00:09:10", "text": "それだよ。私が言いたかったのはそれだ。"}, {"type": "subtitle", "time": 554.87, "timestamp": "00:09:14", "text": "そんなに多くはないですよ、すみません、私の間違いでした。"}, {"type": "subtitle", "time": 558.55, "timestamp": "00:09:18", "text": "普段は、"}, {"type": "subtitle", "time": 560.71, "timestamp": "00:09:20", "text": "ストリームを見たり、"}, {"type": "subtitle", "time": 564.47, "timestamp": "00:09:24", "text": "ASMRを聴いたり"}, {"type": "subtitle", "time": 566.31, "timestamp": "00:09:26", "text": "、"}, {"type": "subtitle", "time": 569.829, "timestamp": "00:09:29", "text": "睡眠用の音楽、いわゆるローファイ系の音楽を聴いたりして、ゆっくりと"}, {"type": "subtitle", "time": 578.389, "timestamp": "00:09:38", "text": "眠りに落ちていきます。   だから私はそうするんです"}, {"type": "subtitle", "time": 585.91, "timestamp": "00:09:45", "text": "えっと、"}, {"type": "subtitle", "time": 592.07, "timestamp": "00:09:52", "text": "体が疲れる限り、"}, {"type": "subtitle", "time": 594.63, "timestamp": "00:09:54", "text": "脳は「ああ、彼の体は"}, {"type": "subtitle", "time": 599.59, "timestamp": "00:09:59", "text": "疲れているから、休む時間だ」って思うと思うんです。"}]
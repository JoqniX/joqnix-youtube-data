[{"type": "subtitle", "time": 846.79, "timestamp": "00:14:06", "text": "待ってください、あの川のエリアに行きます。"}, {"type": "subtitle", "time": 849.67, "timestamp": "00:14:09", "text": "私はただ道路を渡るだけです。"}, {"type": "subtitle", "time": 851.829, "timestamp": "00:14:11", "text": "その地域をご案内できます。"}, {"type": "subtitle", "time": 853.59, "timestamp": "00:14:13", "text": "恐ろしくも興味深い場所にたどり着くことは、"}, {"type": "subtitle", "time": 857.59, "timestamp": "00:14:17", "text": "あなたのやりたいことリストに入れるべきではありません。"}, {"type": "chat", "time": 858.262, "timestamp": "00:14:18", "author": "@TheEccentricJude", "avatar": "https://yt4.ggpht.com/kdr_YehmBjN_SB16rwR2ZD-q7XKWc1Ng5Mj3sV04hYDDTVMi8AkObIo8wQ2XQ4NwN9ngeqfi=s64-c-k-c0x00ffffff-no-rj", "message": "I don’t even live in Tokyo and I just know the food costs an arm and a limb"}, {"type": "subtitle", "time": 860.31, "timestamp": "00:14:20", "text": "それで、"}, {"type": "subtitle", "time": 863.59, "timestamp": "00:14:23", "text": "キャンディーや"}, {"type": "subtitle", "time": 867.509, "timestamp": "00:14:27", "text": "ソフトドリンクがたくさんあって、"}, {"type": "subtitle", "time": 875.829, "timestamp": "00:14:35", "text": "エビを包んで帰るときに買おうと思ってたんだけど、"}, {"type": "subtitle", "time": 879.509, "timestamp": "00:14:39", "text": "帰るときにキッシュを"}, {"type": "subtitle", "time": 884.31, "timestamp": "00:14:44", "text": "買おうと思ってたんだ。キッシュっていう、一口サイズのアイスクリームみたいなやつ。"}, {"type": "chat", "time": 891.392, "timestamp": "00:14:51", "author": "@TheEccentricJude", "avatar": "https://yt4.ggpht.com/kdr_YehmBjN_SB16rwR2ZD-q7XKWc1Ng5Mj3sV04hYDDTVMi8AkObIo8wQ2XQ4NwN9ngeqfi=s64-c-k-c0x00ffffff-no-rj", "message": "Well obviously I don’t, I’m tweaking…"}, {"type": "subtitle", "time": 894.069, "timestamp": "00:14:54", "text": "人生全体でコラボレーションが行われているんだ"}, {"type": "subtitle", "time": 897.11, "timestamp": "00:14:57", "text": "。 えっと、それで、"}]
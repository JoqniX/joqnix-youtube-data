[{"type": "subtitle", "time": 3483.51, "timestamp": "00:58:03", "text": "ストロングゼロ69」っていうお酒を勧めてくれたんだけど、"}, {"type": "subtitle", "time": 3486.23, "timestamp": "00:58:06", "text": "アルコール度数が5%で、"}, {"type": "subtitle", "time": 3489.75, "timestamp": "00:58:09", "text": "7%と9%のもあるんだよね。"}, {"type": "subtitle", "time": 3493.43, "timestamp": "00:58:13", "text": "ええ、少し飲んだら酔ってしまいました"}, {"type": "subtitle", "time": 3495.99, "timestamp": "00:58:15", "text": "。   ああ"}, {"type": "subtitle", "time": 3500.63, "timestamp": "00:58:20", "text": "、じゃあね。 でも、"}, {"type": "subtitle", "time": 3505.91, "timestamp": "00:58:25", "text": "友達に3缶、いや"}, {"type": "subtitle", "time": 3511.27, "timestamp": "00:58:31", "text": "2缶飲まされたんだ。 いいえ、彼の方が"}, {"type": "subtitle", "time": 3513.91, "timestamp": "00:58:33", "text": "コンテンツが多かったのです。 私はあまりたくさん"}, {"type": "subtitle", "time": 3517.109, "timestamp": "00:58:37", "text": "飲めないから、少しだけ飲んだ。 あの"}, {"type": "subtitle", "time": 3524.309, "timestamp": "00:58:44", "text": "夜、どうやって自分が冷静で、意識を保ち、落ち着いていられたのか、自分でも分かりません。"}, {"type": "subtitle", "time": 3527.109, "timestamp": "00:58:47", "text": "どうやら彼は、私が"}, {"type": "subtitle", "time": 3529.67, "timestamp": "00:58:49", "text": "寝言で日本の歌か何かを歌っていたらしく、"}, {"type": "subtitle", "time": 3539.43, "timestamp": "00:58:59", "text": "寝ている間に何かを投げつけて歌を止めさせたらしい。 わからない"}]
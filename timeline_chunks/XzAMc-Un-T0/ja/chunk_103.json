[{"type": "subtitle", "time": 6185.59, "timestamp": "01:43:05", "text": "ああ、そうだ。こっちだ。この辺りだ。ああ、"}, {"type": "subtitle", "time": 6201.59, "timestamp": "01:43:21", "text": "これでいいんだ。こんにちは。戻ってきた"}, {"type": "subtitle", "time": 6204.07, "timestamp": "01:43:24", "text": "。戻ってきた。"}, {"type": "subtitle", "time": 6209.35, "timestamp": "01:43:29", "text": "戻るために最善を尽くしてる。"}, {"type": "subtitle", "time": 6213.51, "timestamp": "01:43:33", "text": "あ、聞こえるよ。こんにちは。こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 6218.149, "timestamp": "01:43:38", "text": "電車を確認するね。"}, {"type": "subtitle", "time": 6220.07, "timestamp": "01:43:40", "text": "あ、"}, {"type": "subtitle", "time": 6236.55, "timestamp": "01:43:56", "text": "東京。"}]
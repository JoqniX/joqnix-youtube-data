[{"type": "subtitle", "time": 3005.75, "timestamp": "00:50:05", "text": "自由時間はほとんどないので大変です。でも、まだ慣れているところです"}, {"type": "subtitle", "time": 3009.43, "timestamp": "00:50:09", "text": "。 これで"}, {"type": "subtitle", "time": 3013.829, "timestamp": "00:50:13", "text": "7月は4回目になります。 えっと、私は"}, {"type": "subtitle", "time": 3033.829, "timestamp": "00:50:33", "text": "値段はそれくらい高いんだけど、そういう"}, {"type": "subtitle", "time": 3055.03, "timestamp": "00:50:55", "text": "食べ物とか色々高いから、何か高いものって感じかな"}, {"type": "subtitle", "time": 3056.79, "timestamp": "00:50:56", "text": "。"}]
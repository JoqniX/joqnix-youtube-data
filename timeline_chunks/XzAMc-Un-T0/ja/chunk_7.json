[{"type": "subtitle", "time": 423.11, "timestamp": "00:07:03", "text": "現在の出力内容を表示する必要があるという点にあると思います。 それが問題なんです。"}, {"type": "subtitle", "time": 430.15, "timestamp": "00:07:10", "text": "これをどう調整すればいいのか本当にわかりません。出力は「"}, {"type": "subtitle", "time": 436.07, "timestamp": "00:07:16", "text": "こんにちは、風変わりなユダヤ人、ようこそ」です。"}, {"type": "subtitle", "time": 437.909, "timestamp": "00:07:17", "text": "こんにちは。"}, {"type": "chat", "time": 451.452, "timestamp": "00:07:31", "author": "@TheEccentricJude", "avatar": "https://yt4.ggpht.com/kdr_YehmBjN_SB16rwR2ZD-q7XKWc1Ng5Mj3sV04hYDDTVMi8AkObIo8wQ2XQ4NwN9ngeqfi=s64-c-k-c0x00ffffff-no-rj", "message": "I can’t fall asleep for the life of me!"}, {"type": "subtitle", "time": 453.51, "timestamp": "00:07:33", "text": "これも調整しないといけないですね。 さて、"}, {"type": "subtitle", "time": 456.629, "timestamp": "00:07:36", "text": "テキストが少しずれています。 ええと、"}, {"type": "subtitle", "time": 458.79, "timestamp": "00:07:38", "text": "スケーリングの問題ですね。"}, {"type": "subtitle", "time": 461.27, "timestamp": "00:07:41", "text": "来る。   どうしても"}, {"type": "subtitle", "time": 463.67, "timestamp": "00:07:43", "text": "眠れない。"}, {"type": "chat", "time": 479.766, "timestamp": "00:07:59", "author": "@TheEccentricJude", "avatar": "https://yt4.ggpht.com/kdr_YehmBjN_SB16rwR2ZD-q7XKWc1Ng5Mj3sV04hYDDTVMi8AkObIo8wQ2XQ4NwN9ngeqfi=s64-c-k-c0x00ffffff-no-rj", "message": "3:13 am 💔"}]
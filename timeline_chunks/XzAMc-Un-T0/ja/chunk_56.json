[{"type": "subtitle", "time": 3361.109, "timestamp": "00:56:01", "text": "うん、"}, {"type": "subtitle", "time": 3364.39, "timestamp": "00:56:04", "text": "大丈夫だといいんだけど。"}, {"type": "subtitle", "time": 3367.589, "timestamp": "00:56:07", "text": "ダイアナ、"}, {"type": "subtitle", "time": 3369.91, "timestamp": "00:56:09", "text": "私はちょっとぎこちないところがあるけど、"}, {"type": "subtitle", "time": 3372.71, "timestamp": "00:56:12", "text": "私を知れば、私はいい人だってわかるし、それから、"}, {"type": "subtitle", "time": 3375.349, "timestamp": "00:56:15", "text": "私が"}, {"type": "subtitle", "time": 3377.99, "timestamp": "00:56:17", "text": "話しすぎるという問題があるの（笑）"}, {"type": "subtitle", "time": 3382.23, "timestamp": "00:56:22", "text": "。それをコントロールしないといけないわ。 だから"}, {"type": "subtitle", "time": 3385.349, "timestamp": "00:56:25", "text": "今はもう慣れすぎてしまった"}, {"type": "subtitle", "time": 3387.109, "timestamp": "00:56:27", "text": "けど、うん、もしかしたら"}, {"type": "subtitle", "time": 3388.95, "timestamp": "00:56:28", "text": "何か学ぶべきことがあるかもしれないね。 うん。 うん。"}, {"type": "subtitle", "time": 3393.27, "timestamp": "00:56:33", "text": "うん。 ええ、ええ、今まさにそれをやっています。"}, {"type": "subtitle", "time": 3396.63, "timestamp": "00:56:36", "text": "そして最近、"}, {"type": "subtitle", "time": 3404.87, "timestamp": "00:56:44", "text": "英語を学んでいる日本のユーチューバーを何人か見つけることができました。 それで、"}, {"type": "subtitle", "time": 3408.63, "timestamp": "00:56:48", "text": "彼らと話したり、連絡を取ったりし始めたんです"}, {"type": "subtitle", "time": 3410.63, "timestamp": "00:56:50", "text": "。"}, {"type": "subtitle", "time": 3413.349, "timestamp": "00:56:53", "text": "うん。 うまくいくといいですね。"}, {"type": "subtitle", "time": 3416.71, "timestamp": "00:56:56", "text": "そういう意味でも、それは良い"}, {"type": "subtitle", "time": 3419.43, "timestamp": "00:56:59", "text": "習慣と言えるでしょう。 話す練習ではなく、"}]
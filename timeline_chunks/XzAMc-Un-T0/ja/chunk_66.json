[{"type": "subtitle", "time": 3960.789, "timestamp": "01:06:00", "text": "新しいモデルの壁紙をパソコンには設定できなかったけど、スマホとかには設定できた"}, {"type": "subtitle", "time": 3964.549, "timestamp": "01:06:04", "text": "。"}, {"type": "subtitle", "time": 3970.47, "timestamp": "01:06:10", "text": "寝る前によく見ていたものだ。 とても素晴らしいと思います。 おお。"}, {"type": "subtitle", "time": 3973.67, "timestamp": "01:06:13", "text": "そしてついに、そのモデルが"}, {"type": "subtitle", "time": 3976.71, "timestamp": "01:06:16", "text": "一般に公開される予定です。 わーい。"}, {"type": "subtitle", "time": 3979.51, "timestamp": "01:06:19", "text": "でも2年経っても、私の心の中にはまだ「お前は"}, {"type": "subtitle", "time": 3986.23, "timestamp": "01:06:26", "text": "バカだ」という気持ちがある。 もっと早くやっておけばよかったのに"}, {"type": "subtitle", "time": 3991.51, "timestamp": "01:06:31", "text": "完璧な"}, {"type": "subtitle", "time": 3995.349, "timestamp": "01:06:35", "text": "デビューを待つ必要も、お金が貯まるまで待つ必要もなかった"}, {"type": "subtitle", "time": 3999.27, "timestamp": "01:06:39", "text": "。 できたはずだった。"}, {"type": "subtitle", "time": 4002.549, "timestamp": "01:06:42", "text": "彼は、そのフォーマットでのデビューに関するルールに従わなかった可能性がある"}, {"type": "subtitle", "time": 4007.349, "timestamp": "01:06:47", "text": "。   ええ、"}, {"type": "subtitle", "time": 4014.63, "timestamp": "01:06:54", "text": "チャットが壊れています。  Uh urun uh"}, {"type": "subtitle", "time": 4017.51, "timestamp": "01:06:57", "text": "ura は、このアプリの次のアップデートで後ほど修正します"}]
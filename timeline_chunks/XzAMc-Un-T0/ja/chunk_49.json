[{"type": "subtitle", "time": 2943.589, "timestamp": "00:49:03", "text": "ああ、"}, {"type": "subtitle", "time": 2945.829, "timestamp": "00:49:05", "text": "日本には本当にたくさんの"}, {"type": "subtitle", "time": 2948.39, "timestamp": "00:49:08", "text": "YouTuberがいるんだなと気づいたよ。"}, {"type": "subtitle", "time": 2950.79, "timestamp": "00:49:10", "text": "一方、インドでは、"}, {"type": "subtitle", "time": 2954.47, "timestamp": "00:49:14", "text": "責任感のあるYouTuberはせいぜい50人か"}, {"type": "subtitle", "time": 2956.79, "timestamp": "00:49:16", "text": "100人くらいしかいないと思う。それだけだ。"}, {"type": "subtitle", "time": 2960.069, "timestamp": "00:49:20", "text": "日本には、さらに"}, {"type": "subtitle", "time": 2963.19, "timestamp": "00:49:23", "text": "2000、3000、10000以上ある。"}, {"type": "subtitle", "time": 2967.27, "timestamp": "00:49:27", "text": "日本での生活はいかがですか？ それは良いです。"}, {"type": "subtitle", "time": 2971.349, "timestamp": "00:49:31", "text": "でも、やっぱり日本は物価が高いんですよね。 ライフ"}, {"type": "subtitle", "time": 2974.87, "timestamp": "00:49:34", "text": "スタイルも、何もかも。 少しずつ慣れてきています"}, {"type": "subtitle", "time": 2977.109, "timestamp": "00:49:37", "text": "。"}, {"type": "subtitle", "time": 2982.47, "timestamp": "00:49:42", "text": "語学を学ぶ留学生として、"}, {"type": "subtitle", "time": 2987.349, "timestamp": "00:49:47", "text": "パートタイムで働き、"}, {"type": "subtitle", "time": 2993.19, "timestamp": "00:49:53", "text": "学校に通い、家に帰ってきて、"}, {"type": "subtitle", "time": 2995.99, "timestamp": "00:49:55", "text": "一人暮らしではなくルームメイトがいる場合は家庭の責任もあるので、"}]
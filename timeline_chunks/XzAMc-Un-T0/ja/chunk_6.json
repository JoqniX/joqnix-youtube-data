[{"type": "subtitle", "time": 361.909, "timestamp": "00:06:01", "text": "後でメモしておこうかな。"}, {"type": "subtitle", "time": 365.749, "timestamp": "00:06:05", "text": "全てが均一ではないというのは、ちょっと奇妙だ"}, {"type": "subtitle", "time": 367.83, "timestamp": "00:06:07", "text": "。"}, {"type": "subtitle", "time": 371.11, "timestamp": "00:06:11", "text": "あと、2022年です。"}, {"type": "subtitle", "time": 375.35, "timestamp": "00:06:15", "text": "スケーリングのアップデートがあったと言っておきます。"}, {"type": "subtitle", "time": 377.59, "timestamp": "00:06:17", "text": "普段の配信スケジュールは？ 私の"}, {"type": "subtitle", "time": 380.07, "timestamp": "00:06:20", "text": "配信スケジュールはまだ確定していません。"}, {"type": "subtitle", "time": 383.27, "timestamp": "00:06:23", "text": "えっと、土曜日と日曜日は、"}, {"type": "subtitle", "time": 386.95, "timestamp": "00:06:26", "text": "日本の早朝に配信しています。 えっと、でも、私は"}, {"type": "subtitle", "time": 392.39, "timestamp": "00:06:32", "text": "通常、ライブ配信中などは"}, {"type": "subtitle", "time": 395.749, "timestamp": "00:06:35", "text": "TwitterやDiscordで人々に通知します"}, {"type": "subtitle", "time": 398.87, "timestamp": "00:06:38", "text": "。"}, {"type": "subtitle", "time": 400.95, "timestamp": "00:06:40", "text": "ええ、"}, {"type": "subtitle", "time": 412.95, "timestamp": "00:06:52", "text": "スケーリングの更新は、"}, {"type": "subtitle", "time": 416.39, "timestamp": "00:06:56", "text": "出力を作成する際に、"}, {"type": "chat", "time": 418.41, "timestamp": "00:06:58", "author": "@TheEccentricJude", "avatar": "https://yt4.ggpht.com/kdr_YehmBjN_SB16rwR2ZD-q7XKWc1Ng5Mj3sV04hYDDTVMi8AkObIo8wQ2XQ4NwN9ngeqfi=s64-c-k-c0x00ffffff-no-rj", "message": "Hi!"}, {"type": "subtitle", "time": 418.95, "timestamp": "00:06:58", "text": "プレビューが"}]
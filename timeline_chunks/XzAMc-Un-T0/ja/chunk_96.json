[{"type": "subtitle", "time": 5761.189, "timestamp": "01:36:01", "text": "。 うん。"}, {"type": "subtitle", "time": 5763.43, "timestamp": "01:36:03", "text": "私ができることは、それをうまく組み合わせることです"}, {"type": "subtitle", "time": 5776.47, "timestamp": "01:36:16", "text": "うん、今日はいい日だったよ。 本当に"}, {"type": "subtitle", "time": 5778.149, "timestamp": "01:36:18", "text": "嬉しいです"}, {"type": "subtitle", "time": 5780.31, "timestamp": "01:36:20", "text": "。   そうそう"}, {"type": "subtitle", "time": 5782.95, "timestamp": "01:36:22", "text": "。 公園の近くにこれがあります"}, {"type": "subtitle", "time": 5786.149, "timestamp": "01:36:26", "text": "。 バーベキューエリア"}, {"type": "subtitle", "time": 5794.39, "timestamp": "01:36:34", "text": "ここにはたくさんの人がいます。家族連れ、"}, {"type": "subtitle", "time": 5795.91, "timestamp": "01:36:35", "text": "子供、"}, {"type": "subtitle", "time": 5798.79, "timestamp": "01:36:38", "text": "ティーンエイジャーなど。"}, {"type": "subtitle", "time": 5800.87, "timestamp": "01:36:40", "text": "バーベキューをしたり、いろいろなことをしています。"}, {"type": "subtitle", "time": 5810.149, "timestamp": "01:36:50", "text": "これは、キラスが言っていたことだ。 バーに行けば、"}, {"type": "subtitle", "time": 5812.95, "timestamp": "01:36:52", "text": "ここで日本人の友達もできるし、"}, {"type": "subtitle", "time": 5815.59, "timestamp": "01:36:55", "text": "いろいろできるよ。 少しはお見せできると思います"}]
[{"type": "subtitle", "time": 1022.55, "timestamp": "00:17:02", "text": "うん、ここはいい場所だね。 湖畔"}, {"type": "subtitle", "time": 1024.15, "timestamp": "00:17:04", "text": "地域。"}, {"type": "subtitle", "time": 1032.789, "timestamp": "00:17:12", "text": "、ちょっと待ってください。"}, {"type": "subtitle", "time": 1048.47, "timestamp": "00:17:28", "text": "。   それで十分でしょうか"}, {"type": "subtitle", "time": 1050.87, "timestamp": "00:17:30", "text": "？"}, {"type": "subtitle", "time": 1054.95, "timestamp": "00:17:34", "text": "カメラをオフにして、配信状況を確認させてください"}, {"type": "subtitle", "time": 1057.75, "timestamp": "00:17:37", "text": "。"}, {"type": "subtitle", "time": 1059.59, "timestamp": "00:17:39", "text": "部屋に蚊がいるに違いない。"}, {"type": "subtitle", "time": 1064.789, "timestamp": "00:17:44", "text": "だってすごく痒いんだもん。 ああ、"}, {"type": "subtitle", "time": 1067.27, "timestamp": "00:17:47", "text": "蚊は痛いよね。 もう夏ですね"}, {"type": "subtitle", "time": 1070.15, "timestamp": "00:17:50", "text": "。 いいえ。"}, {"type": "subtitle", "time": 1072.789, "timestamp": "00:17:52", "text": "ええ、夏になりますよ。"}, {"type": "subtitle", "time": 1076.39, "timestamp": "00:17:56", "text": "ここは私がよく訪れる場所の一つです"}, {"type": "subtitle", "time": 1079.51, "timestamp": "00:17:59", "text": "。 私はただリラックスするだけです。"}]
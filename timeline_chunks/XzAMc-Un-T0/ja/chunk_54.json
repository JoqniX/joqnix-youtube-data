[{"type": "subtitle", "time": 3246.309, "timestamp": "00:54:06", "text": "ことを試してみるためです。 ああ、こっち側にはないよ"}, {"type": "subtitle", "time": 3250.309, "timestamp": "00:54:10", "text": "。 私はディスコとかそういうのに出演したいのかな"}, {"type": "subtitle", "time": 3259.829, "timestamp": "00:54:19", "text": "そこで新しい友達はできましたか？ あまり"}, {"type": "subtitle", "time": 3261.99, "timestamp": "00:54:21", "text": "。"}, {"type": "subtitle", "time": 3266.39, "timestamp": "00:54:26", "text": "学校の先生たち[笑い]"}, {"type": "subtitle", "time": 3270.309, "timestamp": "00:54:30", "text": "と、パートタイムの同僚、いや、アンとは"}, {"type": "subtitle", "time": 3274.87, "timestamp": "00:54:34", "text": "言わない方がいいかな、"}, {"type": "subtitle", "time": 3280.71, "timestamp": "00:54:40", "text": "オディシャンやオバタのパート"}, {"type": "subtitle", "time": 3282.47, "timestamp": "00:54:42", "text": "タイムの同僚を除けば、"}, {"type": "subtitle", "time": 3285.349, "timestamp": "00:54:45", "text": "私と話してくれる人はほんのわずかで、親切に話してくれる大人、"}, {"type": "subtitle", "time": 3291.349, "timestamp": "00:54:51", "text": "ええと、学校の"}, {"type": "subtitle", "time": 3294.069, "timestamp": "00:54:54", "text": "同級生などがいます。 友達ができた。"}]
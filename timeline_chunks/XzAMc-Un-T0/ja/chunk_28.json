[{"type": "subtitle", "time": 1681.19, "timestamp": "00:28:01", "text": "言うんだっけ？をやった場所に行くんだ。  Twitterの"}, {"type": "subtitle", "time": 1683.269, "timestamp": "00:28:03", "text": "スペース。"}, {"type": "subtitle", "time": 1686.31, "timestamp": "00:28:06", "text": "そして、これが私がスペースをテストするために行った時間です"}, {"type": "subtitle", "time": 1687.83, "timestamp": "00:28:07", "text": "。"}, {"type": "subtitle", "time": 1691.83, "timestamp": "00:28:11", "text": "そして、この時初めて別の"}, {"type": "subtitle", "time": 1695.43, "timestamp": "00:28:15", "text": "JPに会ったんです。"}, {"type": "subtitle", "time": 1705.029, "timestamp": "00:28:25", "text": "ええ、ここで長山さんに会いました。"}, {"type": "subtitle", "time": 1708.549, "timestamp": "00:28:28", "text": "だから、私は彼に実際に会ったわけではないけれど"}, {"type": "subtitle", "time": 1717.669, "timestamp": "00:28:37", "text": "ええ、ここにいましたよ。 雨が降っていた。   私は「"}, {"type": "subtitle", "time": 1722.87, "timestamp": "00:28:42", "text": "うん」って感じで、"}, {"type": "subtitle", "time": 1728.31, "timestamp": "00:28:48", "text": "ストリーミングに戻る前にTwitterで配信してたら、"}, {"type": "subtitle", "time": 1731.59, "timestamp": "00:28:51", "text": "長山さんが参加してくれたんです。"}]
[{"type": "subtitle", "time": 4562.229, "timestamp": "01:16:02", "text": "。"}, {"type": "subtitle", "time": 4564.229, "timestamp": "01:16:04", "text": "うん。"}, {"type": "subtitle", "time": 4566.55, "timestamp": "01:16:06", "text": "今東京タワーに行っても、"}, {"type": "subtitle", "time": 4570.31, "timestamp": "01:16:10", "text": "また港区に行っても、一度行ったことがある。 私は"}, {"type": "subtitle", "time": 4573.669, "timestamp": "01:16:13", "text": "その話をインスタグラムに投稿しました。"}, {"type": "subtitle", "time": 4577.27, "timestamp": "01:16:17", "text": "Vlogとか何も録画できなかった。"}, {"type": "subtitle", "time": 4579.27, "timestamp": "01:16:19", "text": "映像はあります。"}, {"type": "subtitle", "time": 4581.75, "timestamp": "01:16:21", "text": "Vlogに使うかどうかはまだ分かりません。 そういえば、"}, {"type": "subtitle", "time": 4584.31, "timestamp": "01:16:24", "text": "私はアップの動画を持っているのですが、持っていません。私は"}, {"type": "subtitle", "time": 4587.03, "timestamp": "01:16:27", "text": "Vlogを作りたいのですが、どうすればいいのか"}, {"type": "subtitle", "time": 4589.83, "timestamp": "01:16:29", "text": "わかりません。   私は2つ"}, {"type": "subtitle", "time": 4595.43, "timestamp": "01:16:35", "text": "目のVlogを作りたかったのですが、"}, {"type": "subtitle", "time": 4603.27, "timestamp": "01:16:43", "text": "私が訪れた周辺地域で撮影した映像や、"}, {"type": "subtitle", "time": 4605.43, "timestamp": "01:16:45", "text": "初めてここに来た時の"}, {"type": "subtitle", "time": 4610.709, "timestamp": "01:16:50", "text": "映像などがあります。"}, {"type": "subtitle", "time": 4612.31, "timestamp": "01:16:52", "text": "でも、"}, {"type": "subtitle", "time": 4618.39, "timestamp": "01:16:58", "text": "本当にそうすべきかどうかわかりません。"}]
[{"type": "subtitle", "time": 7161.99, "timestamp": "01:59:21", "text": "みんな、さようなら。"}, {"type": "subtitle", "time": 7163.669, "timestamp": "01:59:23", "text": "来てくれてありがとう。"}, {"type": "subtitle", "time": 7168.229, "timestamp": "01:59:28", "text": "電車に乗るよ。駅に着いた。こんにちは。さようなら"}, {"type": "subtitle", "time": 7178.629, "timestamp": "01:59:38", "text": "ここで終わりにします。わかった。どうしたの"}, {"type": "subtitle", "time": 7180.47, "timestamp": "01:59:40", "text": "？"}]
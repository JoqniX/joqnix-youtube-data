[{"type": "subtitle", "time": 3660.789, "timestamp": "01:01:00", "text": "長続きする友達はいいし、"}, {"type": "subtitle", "time": 3662.71, "timestamp": "01:01:02", "text": "そのためには"}, {"type": "subtitle", "time": 3666.069, "timestamp": "01:01:06", "text": "努力も必要ですよね。 いや、"}, {"type": "subtitle", "time": 3677.03, "timestamp": "01:01:17", "text": "ええ。 でも、ネット上ではすごく変な感じがするんだよね。"}, {"type": "subtitle", "time": 3680.789, "timestamp": "01:01:20", "text": "私は人と交流したり、そういうこともできます。 現実世界では私は"}, {"type": "subtitle", "time": 3684.23, "timestamp": "01:01:24", "text": "とても内気なので、"}, {"type": "subtitle", "time": 3696.309, "timestamp": "01:01:36", "text": "オンラインでは、私は"}, {"type": "subtitle", "time": 3699.67, "timestamp": "01:01:39", "text": "とても外向的だと思います。予期せぬ"}, {"type": "subtitle", "time": 3704.71, "timestamp": "01:01:44", "text": "エネルギーが湧き上がってきて、ドリルがやってきて、"}, {"type": "subtitle", "time": 3710.15, "timestamp": "01:01:50", "text": "すごくアクティブでおしゃべりになるんです。   気心の知れた"}, {"type": "subtitle", "time": 3713.19, "timestamp": "01:01:53", "text": "相手と組む場合"}, {"type": "subtitle", "time": 3715.43, "timestamp": "01:01:55", "text": "や、"}, {"type": "subtitle", "time": 3718.47, "timestamp": "01:01:58", "text": "見知らぬ人とコラボレーションさせられた場合は、私はとても静かになります。   まだ"}]
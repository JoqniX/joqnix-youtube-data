[{"type": "subtitle", "time": 4445.27, "timestamp": "01:14:05", "text": "39 分。 だから、7時に電車に乗って、"}, {"type": "subtitle", "time": 4452.709, "timestamp": "01:14:12", "text": "15分で東京駅に着けば、"}, {"type": "subtitle", "time": 4460.31, "timestamp": "01:14:20", "text": "時間通りに着けると思うし、"}, {"type": "subtitle", "time": 4463.669, "timestamp": "01:14:23", "text": "他に選択肢もある。 私は夜"}, {"type": "subtitle", "time": 4467.83, "timestamp": "01:14:27", "text": "10時発の深夜電車に乗ります。"}, {"type": "subtitle", "time": 4471.11, "timestamp": "01:14:31", "text": "そして、もし私が午後10時を取るなら"}]
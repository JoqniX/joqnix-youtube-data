[{"type": "subtitle", "time": 2763.829, "timestamp": "00:46:03", "text": "（鼻を鳴らして）"}, {"type": "subtitle", "time": 2767.75, "timestamp": "00:46:07", "text": "つまり、大丈夫だよ。 確か私の"}, {"type": "subtitle", "time": 2771.19, "timestamp": "00:46:11", "text": "記憶が正しければ、私のVlog動画で、"}, {"type": "subtitle", "time": 2773.91, "timestamp": "00:46:13", "text": "うっかり自分の手を映してしまったと思う"}, {"type": "subtitle", "time": 2777.109, "timestamp": "00:46:17", "text": "。 つまり、私は自分の体を見せたのですが、"}, {"type": "subtitle", "time": 2779.91, "timestamp": "00:46:19", "text": "頭はキャラクターで覆われていました"}, {"type": "subtitle", "time": 2783.51, "timestamp": "00:46:23", "text": "。でも、ええ、最初に私の手が再び"}, {"type": "subtitle", "time": 2785.589, "timestamp": "00:46:25", "text": "露わになりました。 でも、気をつけます。気をつけます"}, {"type": "subtitle", "time": 2790.95, "timestamp": "00:46:30", "text": "。"}, {"type": "subtitle", "time": 2798.87, "timestamp": "00:46:38", "text": "それで、私は自分が"}, {"type": "subtitle", "time": 2801.91, "timestamp": "00:46:41", "text": "東京の公園にいるという景色を見せていたんです。"}, {"type": "subtitle", "time": 2804.47, "timestamp": "00:46:44", "text": "今日は"}, {"type": "subtitle", "time": 2807.91, "timestamp": "00:46:47", "text": "VTuberの共同講座や"}, {"type": "subtitle", "time": 2811.91, "timestamp": "00:46:51", "text": "YouTuber講座のようなものに参加するために東京に来ました。"}, {"type": "subtitle", "time": 2814.15, "timestamp": "00:46:54", "text": "今日は楽しかった。"}, {"type": "subtitle", "time": 2817.349, "timestamp": "00:46:57", "text": "えっと、彼らは"}]
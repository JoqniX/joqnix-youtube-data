[{"type": "subtitle", "time": 901.11, "timestamp": "00:15:01", "text": "バニラ味のクールなものを買おうと思ったんです。   えっと、実は"}, {"type": "subtitle", "time": 910.15, "timestamp": "00:15:10", "text": "私、東京には住んでいないんです。 私はただ、"}, {"type": "subtitle", "time": 912.389, "timestamp": "00:15:12", "text": "食べ物のコースと腕を知っていて、それを"}, {"type": "subtitle", "time": 914.949, "timestamp": "00:15:14", "text": "学んでいます。 はい。   実は、"}, {"type": "subtitle", "time": 921.03, "timestamp": "00:15:21", "text": "私は今インド出身なんです。 えっと、私はまだ"}, {"type": "subtitle", "time": 925.03, "timestamp": "00:15:25", "text": "日本に来たばかりで、4月頃に来たばかりなんです。   だから、まだ"}, {"type": "subtitle", "time": 927.03, "timestamp": "00:15:27", "text": "通貨換算には慣れていないんです"}, {"type": "subtitle", "time": 933.67, "timestamp": "00:15:33", "text": "。 つまりここ日本では、1,000"}, {"type": "subtitle", "time": 939.189, "timestamp": "00:15:39", "text": "円は誰にとっても安い金額です。 デモをお願いします。"}, {"type": "subtitle", "time": 942.949, "timestamp": "00:15:42", "text": "私はそれをインドからの1000ルピーと見ています。"}, {"type": "subtitle", "time": 945.829, "timestamp": "00:15:45", "text": "私はまだ、インドの"}, {"type": "subtitle", "time": 950.15, "timestamp": "00:15:50", "text": "現在のインドの通貨のようなものの"}, {"type": "subtitle", "time": 953.189, "timestamp": "00:15:53", "text": "変換販売システムの中にいるようです。"}, {"type": "subtitle", "time": 955.829, "timestamp": "00:15:55", "text": "変えなきゃいけないのは分かってるけど、まあね。 待って、"}, {"type": "subtitle", "time": 958.55, "timestamp": "00:15:58", "text": "アヒルを見たいの？"}]
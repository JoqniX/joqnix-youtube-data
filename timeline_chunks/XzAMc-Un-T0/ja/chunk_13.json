[{"type": "subtitle", "time": 783.03, "timestamp": "00:13:03", "text": "よし。 あなたは何も見ていない。   うん、"}, {"type": "subtitle", "time": 787.35, "timestamp": "00:13:07", "text": "いい場所だね。"}, {"type": "subtitle", "time": 791.43, "timestamp": "00:13:11", "text": "いくつかエリアをお見せしますね。"}, {"type": "subtitle", "time": 793.99, "timestamp": "00:13:13", "text": "とても素敵な場所ですよ。 いいえ、私の"}, {"type": "subtitle", "time": 797.509, "timestamp": "00:13:17", "text": "ボトルをください。 えっと、もし私が友達側に行けば"}, {"type": "subtitle", "time": 801.43, "timestamp": "00:13:21", "text": "、えっと、"}, {"type": "subtitle", "time": 803.03, "timestamp": "00:13:23", "text": "文字通りここで死ぬことになるでしょう。  [笑い]"}, {"type": "subtitle", "time": 805.269, "timestamp": "00:13:25", "text": "ゆっくり進むべきじゃないな。 これ以上は話すべきではない"}, {"type": "subtitle", "time": 806.949, "timestamp": "00:13:26", "text": "。 でも、本当にいいところだよ"}, {"type": "subtitle", "time": 810.55, "timestamp": "00:13:30", "text": "。 あちらの方へ行けば"}, {"type": "subtitle", "time": 814.47, "timestamp": "00:13:34", "text": "、子供たちが見えますよ。 えっと、"}, {"type": "subtitle", "time": 830.629, "timestamp": "00:13:50", "text": "ええ、たくさんありますよ。 しかし、問題は"}, {"type": "subtitle", "time": 833.99, "timestamp": "00:13:53", "text": "、東京は物価が高いということだ。"}]
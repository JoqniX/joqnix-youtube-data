[{"type": "subtitle", "time": 1082.39, "timestamp": "00:18:02", "text": "前回"}, {"type": "subtitle", "time": 1087.75, "timestamp": "00:18:07", "text": "ここに来た時に、散策中に偶然見つけたんです。 だから、こうやって遠回りして"}, {"type": "subtitle", "time": 1094.71, "timestamp": "00:18:14", "text": "景色などを楽しむんです。"}, {"type": "subtitle", "time": 1099.19, "timestamp": "00:18:19", "text": "だから、日本は、特に東京が好きだと思う。"}, {"type": "subtitle", "time": 1102.95, "timestamp": "00:18:22", "text": "とても"}, {"type": "subtitle", "time": 1104.549, "timestamp": "00:18:24", "text": "混雑している"}, {"type": "subtitle", "time": 1112.15, "timestamp": "00:18:32", "text": "けど、公園が周りにある限り、"}, {"type": "chat", "time": 1113.906, "timestamp": "00:18:33", "author": "@TheEccentricJude", "avatar": "https://yt4.ggpht.com/kdr_YehmBjN_SB16rwR2ZD-q7XKWc1Ng5Mj3sV04hYDDTVMi8AkObIo8wQ2XQ4NwN9ngeqfi=s64-c-k-c0x00ffffff-no-rj", "message": "Okay so I think I’m gonna head to sleep, but not cus I’m sleepy. I just simply need to rest. You seem fun so I may return!!"}, {"type": "subtitle", "time": 1114.63, "timestamp": "00:18:34", "text": "良い場所だと思う。"}, {"type": "subtitle", "time": 1119.19, "timestamp": "00:18:39", "text": "公園が周りにある限り、"}, {"type": "subtitle", "time": 1120.87, "timestamp": "00:18:40", "text": "良い場所だと思う。"}, {"type": "subtitle", "time": 1128.549, "timestamp": "00:18:48", "text": "そして、"}, {"type": "subtitle", "time": 1132.39, "timestamp": "00:18:52", "text": "この石の記念碑がある。"}, {"type": "subtitle", "time": 1136.63, "timestamp": "00:18:56", "text": "何？ ああ、これをお見せできますよ。 この石碑を見てください"}]
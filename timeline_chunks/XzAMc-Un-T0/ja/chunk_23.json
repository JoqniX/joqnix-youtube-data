[{"type": "subtitle", "time": 1381.669, "timestamp": "00:23:01", "text": "待って、どうやって？ そうそう。 待って、どうやって"}, {"type": "subtitle", "time": 1385.99, "timestamp": "00:23:05", "text": "ズームインするの？ ズームインできないんです。"}, {"type": "subtitle", "time": 1387.669, "timestamp": "00:23:07", "text": "アヒルが見えますか？"}, {"type": "subtitle", "time": 1402.149, "timestamp": "00:23:22", "text": "ウランにズーム機能を追加してもらうよう頼むべきだ。"}, {"type": "subtitle", "time": 1404.95, "timestamp": "00:23:24", "text": "付け加えておくと、彼にそれを追加するように頼むべきだった。"}, {"type": "subtitle", "time": 1408.47, "timestamp": "00:23:28", "text": "ズーム機能が必要です。"}, {"type": "chat", "time": 1410.902, "timestamp": "00:23:30", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "oki"}, {"type": "subtitle", "time": 1411.11, "timestamp": "00:23:31", "text": "ええ、ズーム機能は本当に必要です"}, {"type": "subtitle", "time": 1420.95, "timestamp": "00:23:40", "text": "今日は本当に楽しかったし、"}]
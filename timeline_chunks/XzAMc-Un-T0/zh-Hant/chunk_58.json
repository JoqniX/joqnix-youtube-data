[{"type": "subtitle", "time": 3489.75, "timestamp": "00:58:09", "text": "一個一年級就被分到二年級課程的學生。所以我就像個轉學生"}, {"type": "subtitle", "time": 3495.99, "timestamp": "00:58:15", "text": "。所以，我的"}, {"type": "subtitle", "time": 3505.91, "timestamp": "00:58:25", "text": "同學慢慢開始跟我說話，接受我等等，這很好。我的意思是，現在大家都來自不同的國家。中國、韓國、緬甸、越南，還有哪裡？蒙古等等。那麼，你有沒有交到日本朋友呢？呃"}, {"type": "subtitle", "time": 3511.27, "timestamp": "00:58:31", "text": "，"}, {"type": "subtitle", "time": 3513.91, "timestamp": "00:58:33", "text": "不，"}, {"type": "subtitle", "time": 3517.109, "timestamp": "00:58:37", "text": "還沒。我在找人。"}, {"type": "subtitle", "time": 3527.109, "timestamp": "00:58:47", "text": "是的，我真的很想"}, {"type": "subtitle", "time": 3529.67, "timestamp": "00:58:49", "text": "在現實生活中交個"}]
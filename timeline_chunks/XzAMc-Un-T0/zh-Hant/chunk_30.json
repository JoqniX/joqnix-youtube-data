[{"type": "subtitle", "time": 1806.549, "timestamp": "00:30:06", "text": "納加桑。"}, {"type": "subtitle", "time": 1808.07, "timestamp": "00:30:08", "text": "所以，雖然"}, {"type": "subtitle", "time": 1810.23, "timestamp": "00:30:10", "text": "我沒能在現實生活中見到他，但我來過這裡。下雨了。  是的，我當時在場。下雨了。  我當時就想，是啊，在我回歸"}, {"type": "subtitle", "time": 1823.909, "timestamp": "00:30:23", "text": "直播之前，我正在推特上直播，然後Nagasan加入了"}, {"type": "subtitle", "time": 1827.669, "timestamp": "00:30:27", "text": "。那是我第一次和Nagasan互動。"}, {"type": "subtitle", "time": 1834.63, "timestamp": "00:30:34", "text": "回憶。  很好，當我來到一個地方時，"}, {"type": "subtitle", "time": 1841.59, "timestamp": "00:30:41", "text": "我會想：「是的，我記得我在這裡做過什麼"}]
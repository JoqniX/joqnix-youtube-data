[{"type": "subtitle", "time": 6185.59, "timestamp": "01:43:05", "text": "哦，是的。这边走。这部分。哦，是的"}, {"type": "subtitle", "time": 6201.59, "timestamp": "01:43:21", "text": "我用这个。嗨。"}, {"type": "subtitle", "time": 6204.07, "timestamp": "01:43:24", "text": "我回来了。我回来了。"}, {"type": "subtitle", "time": 6207.109, "timestamp": "01:43:27", "text": "我正在尽力回去"}, {"type": "subtitle", "time": 6209.35, "timestamp": "01:43:29", "text": "。"}, {"type": "subtitle", "time": 6213.51, "timestamp": "01:43:33", "text": "呃，能听到你。嗨。嗨。嗨。嗨。我。"}, {"type": "subtitle", "time": 6215.75, "timestamp": "01:43:35", "text": "我查一下"}, {"type": "subtitle", "time": 6218.149, "timestamp": "01:43:38", "text": "火车。"}, {"type": "subtitle", "time": 6220.07, "timestamp": "01:43:40", "text": "呃，"}, {"type": "subtitle", "time": 6236.55, "timestamp": "01:43:56", "text": "东京，"}]
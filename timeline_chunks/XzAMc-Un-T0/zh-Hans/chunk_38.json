[{"type": "subtitle", "time": 2282.63, "timestamp": "00:38:02", "text": "等等，我想我明白发生了什么事了"}, {"type": "subtitle", "time": 2284.71, "timestamp": "00:38:04", "text": "。 其他所有"}, {"type": "subtitle", "time": 2291.27, "timestamp": "00:38:11", "text": "如果我添加在线聊天功能，那就不应该这样。"}, {"type": "subtitle", "time": 2311.829, "timestamp": "00:38:31", "text": "总之，"}, {"type": "subtitle", "time": 2325.51, "timestamp": "00:38:45", "text": "我的男朋友。 他去了哪里？"}, {"type": "subtitle", "time": 2327.67, "timestamp": "00:38:47", "text": "我的身体。"}]
[{"type": "subtitle", "time": 1921.99, "timestamp": "00:32:01", "text": "鸽子，我抓到你了。"}, {"type": "subtitle", "time": 1925.99, "timestamp": "00:32:05", "text": "为什么？ 他为什么跟着我？ 我刚才在下面看到"}, {"type": "subtitle", "time": 1928.87, "timestamp": "00:32:08", "text": "你了，对吧？ 你觉得我"}, {"type": "subtitle", "time": 1931.83, "timestamp": "00:32:11", "text": "有零食可以给你吗？"}, {"type": "subtitle", "time": 1935.669, "timestamp": "00:32:15", "text": "等等，我没有，我只有糖果。 我"}, {"type": "subtitle", "time": 1937.269, "timestamp": "00:32:17", "text": "觉得你不会喜欢糖果。 所以，"}, {"type": "subtitle", "time": 1940.31, "timestamp": "00:32:20", "text": "它又热又硬。"}, {"type": "subtitle", "time": 1942.71, "timestamp": "00:32:22", "text": "O"}, {"type": "subtitle", "time": 1949.59, "timestamp": "00:32:29", "text": "他喜欢我。"}, {"type": "chat", "time": 1965.41, "timestamp": "00:32:45", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "birb frend"}, {"type": "subtitle", "time": 1965.59, "timestamp": "00:32:45", "text": "他为什么要这样做？"}, {"type": "subtitle", "time": 1970.549, "timestamp": "00:32:50", "text": "等待。 好的。 他分手了吗？"}]
[{"type": "subtitle", "time": 3421.99, "timestamp": "00:57:01", "text": "沟通练习。   是的"}, {"type": "subtitle", "time": 3424.069, "timestamp": "00:57:04", "text": "。 一起创造新的回忆，一起玩"}, {"type": "subtitle", "time": 3425.91, "timestamp": "00:57:05", "text": "游戏。"}, {"type": "subtitle", "time": 3427.99, "timestamp": "00:57:07", "text": "真不错。"}, {"type": "subtitle", "time": 3430.15, "timestamp": "00:57:10", "text": "如果你能去酒吧之类的场所，就可以"}, {"type": "subtitle", "time": 3432.95, "timestamp": "00:57:12", "text": "和那里的人聊天。 如果你经常去，"}, {"type": "chat", "time": 3433.191, "timestamp": "00:57:13", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "hi"}, {"type": "subtitle", "time": 3438.63, "timestamp": "00:57:18", "text": "我是说在VR聊天室里，我知道那是个很流行的"}, {"type": "subtitle", "time": 3440.87, "timestamp": "00:57:20", "text": "现象。 如果你想结交日本"}, {"type": "subtitle", "time": 3443.27, "timestamp": "00:57:23", "text": "朋友，你可以去维安的酒吧或"}, {"type": "subtitle", "time": 3445.99, "timestamp": "00:57:25", "text": "酒屋之类的地方，在"}, {"type": "chat", "time": 3447.164, "timestamp": "00:57:27", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "how are you joq"}, {"type": "subtitle", "time": 3463.43, "timestamp": "00:57:43", "text": "意思是，我可以这么做，但我又在想，我应该这么做吗？"}, {"type": "subtitle", "time": 3465.91, "timestamp": "00:57:45", "text": "我的意思是，我可以喝酒。 关键是，我给自己定了个"}, {"type": "subtitle", "time": 3468.15, "timestamp": "00:57:48", "text": "规矩，不喝酒，不抽烟，"}, {"type": "subtitle", "time": 3473.75, "timestamp": "00:57:53", "text": "不吸毒，什么都不碰。 呃，"}, {"type": "subtitle", "time": 3475.91, "timestamp": "00:57:55", "text": "其实我的室友让我"}, {"type": "subtitle", "time": 3479.27, "timestamp": "00:57:59", "text": "尝试了一种在日本很受欢迎的饮料，"}]
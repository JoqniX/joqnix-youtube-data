[{"type": "subtitle", "time": 1860.63, "timestamp": "00:31:00", "text": "这很方便。"}, {"type": "subtitle", "time": 1863.029, "timestamp": "00:31:03", "text": "它使用我手机的音频。 我可以用"}, {"type": "subtitle", "time": 1865.19, "timestamp": "00:31:05", "text": "外接麦克风，"}, {"type": "subtitle", "time": 1866.789, "timestamp": "00:31:06", "text": "但如果能有"}, {"type": "subtitle", "time": 1869.19, "timestamp": "00:31:09", "text": "外接摄像头就更好了。"}, {"type": "subtitle", "time": 1871.11, "timestamp": "00:31:11", "text": "所以，"}, {"type": "subtitle", "time": 1873.35, "timestamp": "00:31:13", "text": "我不知道外置摄像头"}, {"type": "subtitle", "time": 1875.19, "timestamp": "00:31:15", "text": "该如何工作。"}, {"type": "subtitle", "time": 1877.669, "timestamp": "00:31:17", "text": "从未想过，也从未尝试过、买过"}, {"type": "subtitle", "time": 1882.549, "timestamp": "00:31:22", "text": "或试用过。 所以我也不知道。"}, {"type": "subtitle", "time": 1886.07, "timestamp": "00:31:26", "text": "我会研究一下它的工作原理，"}, {"type": "subtitle", "time": 1888.549, "timestamp": "00:31:28", "text": "看看我能不能做到。"}, {"type": "subtitle", "time": 1891.35, "timestamp": "00:31:31", "text": "所以，我觉得我需要一部"}, {"type": "subtitle", "time": 1893.59, "timestamp": "00:31:33", "text": "高质量的手机来处理一些"}, {"type": "subtitle", "time": 1896.31, "timestamp": "00:31:36", "text": "高端任务。   是的"}, {"type": "subtitle", "time": 1903.509, "timestamp": "00:31:43", "text": "现在这阵微风真舒服。"}, {"type": "subtitle", "time": 1905.75, "timestamp": "00:31:45", "text": "你能听到吗？"}, {"type": "subtitle", "time": 1908.549, "timestamp": "00:31:48", "text": "我的孩子们在玩耍。 不过，你看，"}, {"type": "subtitle", "time": 1911.99, "timestamp": "00:31:51", "text": "我这儿有个朋友。"}, {"type": "subtitle", "time": 1914.07, "timestamp": "00:31:54", "text": "我在那儿有个朋友。 等等，等等，等等，"}, {"type": "subtitle", "time": 1916.23, "timestamp": "00:31:56", "text": "等等。"}, {"type": "subtitle", "time": 1919.269, "timestamp": "00:31:59", "text": "M鸽子约翰在这里。"}]
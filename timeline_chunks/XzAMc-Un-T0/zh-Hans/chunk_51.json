[{"type": "subtitle", "time": 3060.39, "timestamp": "00:51:00", "text": "所以，我正在适应。"}, {"type": "subtitle", "time": 3064.23, "timestamp": "00:51:04", "text": "有时候我，我，我，我，我希望"}, {"type": "subtitle", "time": 3068.63, "timestamp": "00:51:08", "text": "我能回家，这样我就可以，嗯，躺着，像个"}, {"type": "subtitle", "time": 3071.75, "timestamp": "00:51:11", "text": "懒人一样闲逛，然后，嗯，"}, {"type": "subtitle", "time": 3075.99, "timestamp": "00:51:15", "text": "整天直播，[笑声]吃，"}, {"type": "subtitle", "time": 3078.79, "timestamp": "00:51:18", "text": "睡，直播。"}, {"type": "subtitle", "time": 3081.829, "timestamp": "00:51:21", "text": "但我意识到，不行，我不能那样做。 我"}, {"type": "subtitle", "time": 3086.069, "timestamp": "00:51:26", "text": "必须成为成年人或学生，"}, {"type": "subtitle", "time": 3090.47, "timestamp": "00:51:30", "text": "努力工作，自己赚钱养活自己。"}, {"type": "subtitle", "time": 3093.43, "timestamp": "00:51:33", "text": "节省开支"}, {"type": "subtitle", "time": 3098.069, "timestamp": "00:51:38", "text": "等等。好的。 这是一次全新的"}, {"type": "subtitle", "time": 3100.309, "timestamp": "00:51:40", "text": "体验。"}, {"type": "subtitle", "time": 3102.549, "timestamp": "00:51:42", "text": "所以戴安娜，是的"}, {"type": "subtitle", "time": 3105.43, "timestamp": "00:51:45", "text": "，"}, {"type": "subtitle", "time": 3107.67, "timestamp": "00:51:47", "text": "这很好。"}, {"type": "subtitle", "time": 3109.27, "timestamp": "00:51:49", "text": "嗯。"}, {"type": "subtitle", "time": 3111.43, "timestamp": "00:51:51", "text": "你仍然在努力构建一些东西"}, {"type": "subtitle", "time": 3115.67, "timestamp": "00:51:55", "text": "。 是的，我正在学习"}, {"type": "subtitle", "time": 3117.589, "timestamp": "00:51:57", "text": "新事物。"}]
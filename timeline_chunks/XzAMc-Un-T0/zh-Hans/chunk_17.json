[{"type": "subtitle", "time": 1022.55, "timestamp": "00:17:02", "text": "啊，这地方不错。"}, {"type": "subtitle", "time": 1024.15, "timestamp": "00:17:04", "text": "湖区。"}, {"type": "subtitle", "time": 1032.789, "timestamp": "00:17:12", "text": "呃，稍等一下。 让我调整一下"}, {"type": "subtitle", "time": 1048.47, "timestamp": "00:17:28", "text": "。"}, {"type": "subtitle", "time": 1050.87, "timestamp": "00:17:30", "text": "这样可以吗？"}, {"type": "subtitle", "time": 1054.95, "timestamp": "00:17:34", "text": "让我关掉摄像头，查看一下"}, {"type": "subtitle", "time": 1057.75, "timestamp": "00:17:37", "text": "视频流。"}, {"type": "subtitle", "time": 1059.59, "timestamp": "00:17:39", "text": "我房间里肯定有蚊子，"}, {"type": "subtitle", "time": 1064.789, "timestamp": "00:17:44", "text": "因为我痒得厉害。 嗯，是啊，"}, {"type": "subtitle", "time": 1067.27, "timestamp": "00:17:47", "text": "蚊子真让人讨厌。 夏天已经到了"}, {"type": "subtitle", "time": 1070.15, "timestamp": "00:17:50", "text": "。 不，是的"}, {"type": "subtitle", "time": 1072.789, "timestamp": "00:17:52", "text": "，夏天就要来了。"}, {"type": "subtitle", "time": 1076.39, "timestamp": "00:17:56", "text": "这是我常来的地方之一"}, {"type": "subtitle", "time": 1079.51, "timestamp": "00:17:59", "text": "。 我只是放松一下。 我上次来这里闲逛的时候偶然发现了它"}]
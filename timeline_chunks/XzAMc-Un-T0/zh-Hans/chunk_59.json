[{"type": "subtitle", "time": 3542.069, "timestamp": "00:59:02", "text": "不知道。 他说过这话。 我当时就想，"}, {"type": "subtitle", "time": 3543.829, "timestamp": "00:59:03", "text": "“嘿，"}, {"type": "subtitle", "time": 3548.63, "timestamp": "00:59:08", "text": "我喝醉的时候会唱日语歌。"}, {"type": "subtitle", "time": 3550.789, "timestamp": "00:59:10", "text": "什么？"}, {"type": "subtitle", "time": 3556.309, "timestamp": "00:59:16", "text": "很好。 目前在东京迪奥，就像在"}, {"type": "subtitle", "time": 3558.23, "timestamp": "00:59:18", "text": "公园里一样，边走边"}, {"type": "subtitle", "time": 3566.71, "timestamp": "00:59:26", "text": "这真是太奇怪了。  D 就像"}, {"type": "subtitle", "time": 3568.87, "timestamp": "00:59:28", "text": "我知道我喜欢唱歌之类的"}, {"type": "subtitle", "time": 3571.19, "timestamp": "00:59:31", "text": "。 不过我不太擅长这个。 我"}, {"type": "subtitle", "time": 3573.349, "timestamp": "00:59:33", "text": "想唱歌，而且我一直都听"}, {"type": "subtitle", "time": 3577.109, "timestamp": "00:59:37", "text": "日本音乐。 但是，嘿，我"}, {"type": "subtitle", "time": 3581.829, "timestamp": "00:59:41", "text": "喝醉的时候睡着了还会唱歌。 是的。 什么？"}, {"type": "subtitle", "time": 3584.47, "timestamp": "00:59:44", "text": "那是一件不同"}, {"type": "subtitle", "time": 3587.349, "timestamp": "00:59:47", "text": "寻常、不同寻常的事情。 第一次"}, {"type": "subtitle", "time": 3589.75, "timestamp": "00:59:49", "text": "听说。 但是，"}, {"type": "subtitle", "time": 3592.23, "timestamp": "00:59:52", "text": "从那时起我就想，“是的，我以后"}, {"type": "subtitle", "time": 3594.39, "timestamp": "00:59:54", "text": "再也不喝酒了。”   是"}, {"type": "subtitle", "time": 3596.95, "timestamp": "00:59:56", "text": "啊，但谁知道呢？ 我不想"}, {"type": "subtitle", "time": 3599.27, "timestamp": "00:59:59", "text": "喝酒，但是"}]
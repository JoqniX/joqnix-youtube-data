[{"type": "subtitle", "time": 901.11, "timestamp": "00:15:01", "text": "香草味的，感觉还不错。"}, {"type": "subtitle", "time": 910.15, "timestamp": "00:15:10", "text": "我甚至都不住在东京。 我只是……我"}, {"type": "subtitle", "time": 912.389, "timestamp": "00:15:12", "text": "只是知道食物课程和手臂，"}, {"type": "subtitle", "time": 914.949, "timestamp": "00:15:14", "text": "然后我学习。 是的。"}, {"type": "subtitle", "time": 917.43, "timestamp": "00:15:17", "text": "你知道吗，"}, {"type": "subtitle", "time": 921.03, "timestamp": "00:15:21", "text": "我现在来自印度。 所以，呃，我还是……"}, {"type": "subtitle", "time": 925.03, "timestamp": "00:15:25", "text": "我大概四月份才来到日本。"}, {"type": "subtitle", "time": 927.03, "timestamp": "00:15:27", "text": "所以我还不习惯货币"}, {"type": "subtitle", "time": 933.67, "timestamp": "00:15:33", "text": "换算。 所以在日本，"}, {"type": "subtitle", "time": 939.189, "timestamp": "00:15:39", "text": "日元对每个人来说都很便宜。 请给我演示一下。"}, {"type": "subtitle", "time": 942.949, "timestamp": "00:15:42", "text": "我觉得这是来自印度的1000卢比。"}, {"type": "subtitle", "time": 945.829, "timestamp": "00:15:45", "text": "我仍然看到我仍然在使用印度"}, {"type": "subtitle", "time": 950.15, "timestamp": "00:15:50", "text": "当前的货币"}, {"type": "subtitle", "time": 953.189, "timestamp": "00:15:53", "text": "兑换系统。"}, {"type": "subtitle", "time": 955.829, "timestamp": "00:15:55", "text": "我知道我必须改变这种想法，但是，是的。 等等，"}, {"type": "subtitle", "time": 958.55, "timestamp": "00:15:58", "text": "你想看鸭子吗？"}]
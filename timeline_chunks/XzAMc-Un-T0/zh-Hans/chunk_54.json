[{"type": "subtitle", "time": 3241.91, "timestamp": "00:54:01", "text": "等等。这样"}, {"type": "subtitle", "time": 3244.79, "timestamp": "00:54:04", "text": "我就可以尝试"}, {"type": "subtitle", "time": 3246.309, "timestamp": "00:54:06", "text": "不同的东西。 它不在这一边，"}, {"type": "subtitle", "time": 3250.309, "timestamp": "00:54:10", "text": "就像是“是的”。 我想去迪斯科舞厅之"}, {"type": "subtitle", "time": 3259.829, "timestamp": "00:54:19", "text": "你在那里交到新朋友了吗？ 并不"}, {"type": "subtitle", "time": 3261.99, "timestamp": "00:54:21", "text": "真地。"}, {"type": "subtitle", "time": 3264.23, "timestamp": "00:54:24", "text": "如果排除"}, {"type": "subtitle", "time": 3266.39, "timestamp": "00:54:26", "text": "学校的老师[笑声]"}, {"type": "subtitle", "time": 3270.309, "timestamp": "00:54:30", "text": "和我的阿杜阿，就像我的兼职……"}, {"type": "subtitle", "time": 3274.87, "timestamp": "00:54:34", "text": "呃，兼职……呃，不，我不应该说……呃，呃，"}, {"type": "subtitle", "time": 3280.71, "timestamp": "00:54:40", "text": "呃，奥迪沙和奥巴塔"}, {"type": "subtitle", "time": 3282.47, "timestamp": "00:54:42", "text": "兼职……很少有人"}, {"type": "subtitle", "time": 3285.349, "timestamp": "00:54:45", "text": "和我说话，一些成年人很友善地"}, {"type": "subtitle", "time": 3291.349, "timestamp": "00:54:51", "text": "和我说话，呃，呃，学校……"}, {"type": "subtitle", "time": 3294.069, "timestamp": "00:54:54", "text": "呃，同学。 我交到了朋友。 我"}, {"type": "subtitle", "time": 3296.95, "timestamp": "00:54:56", "text": "觉得我现在更像是个转学生了"}]
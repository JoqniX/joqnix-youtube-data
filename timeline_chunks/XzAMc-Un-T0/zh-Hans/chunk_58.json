[{"type": "subtitle", "time": 3483.51, "timestamp": "00:58:03", "text": "叫做 Strong Zero 69，"}, {"type": "subtitle", "time": 3486.23, "timestamp": "00:58:06", "text": "它的酒精含量为 5%，还有"}, {"type": "subtitle", "time": 3489.75, "timestamp": "00:58:09", "text": "酒精含量为 7% 和 9% 的。"}, {"type": "subtitle", "time": 3493.43, "timestamp": "00:58:13", "text": "是的，我喝了一点，然后就"}, {"type": "subtitle", "time": 3495.99, "timestamp": "00:58:15", "text": "醉了。   嗯，好的，"}, {"type": "subtitle", "time": 3500.63, "timestamp": "00:58:20", "text": "再见。 但你知道，我喝了，我"}, {"type": "subtitle", "time": 3505.91, "timestamp": "00:58:25", "text": "朋友让我喝了三罐，"}, {"type": "subtitle", "time": 3511.27, "timestamp": "00:58:31", "text": "呃，两罐。 不，他还有更多"}, {"type": "subtitle", "time": 3513.91, "timestamp": "00:58:33", "text": "内容。 我的那杯里只有一点点，因为我不能"}, {"type": "subtitle", "time": 3517.109, "timestamp": "00:58:37", "text": "喝太多。"}, {"type": "subtitle", "time": 3520.309, "timestamp": "00:58:40", "text": "我不知道那天晚上我是怎么保持镇定、"}, {"type": "subtitle", "time": 3524.309, "timestamp": "00:58:44", "text": "清醒和理智的。"}, {"type": "subtitle", "time": 3527.109, "timestamp": "00:58:47", "text": "他好像跟我说，我"}, {"type": "subtitle", "time": 3529.67, "timestamp": "00:58:49", "text": "睡着的时候在唱一首日语歌什么的，"}, {"type": "subtitle", "time": 3532.95, "timestamp": "00:58:52", "text": "然后他就朝"}, {"type": "subtitle", "time": 3536.71, "timestamp": "00:58:56", "text": "我扔了什么东西，让我停下来"}, {"type": "subtitle", "time": 3539.43, "timestamp": "00:58:59", "text": "。 我"}]
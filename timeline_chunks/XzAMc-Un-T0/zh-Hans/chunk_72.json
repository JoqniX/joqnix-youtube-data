[{"type": "subtitle", "time": 4332.31, "timestamp": "01:12:12", "text": "是啊，我现在应该多做些日语直播了。"}, {"type": "subtitle", "time": 4335.91, "timestamp": "01:12:15", "text": "我没能完成语言练习"}, {"type": "subtitle", "time": 4344.07, "timestamp": "01:12:24", "text": "，这里有孩子。 你知道吗，"}, {"type": "subtitle", "time": 4346.31, "timestamp": "01:12:26", "text": "有时候我真希望自己能回到过去"}, {"type": "subtitle", "time": 4349.75, "timestamp": "01:12:29", "text": "，变成一个小孩子。 我"}, {"type": "subtitle", "time": 4352.31, "timestamp": "01:12:32", "text": "不用担心学业，也不用"}, {"type": "subtitle", "time": 4354.87, "timestamp": "01:12:34", "text": "担心责任。"}, {"type": "subtitle", "time": 4357.189, "timestamp": "01:12:37", "text": "我不想长大。 不用"}, {"type": "subtitle", "time": 4360.55, "timestamp": "01:12:40", "text": "担心钱的问题。"}, {"type": "subtitle", "time": 4362.709, "timestamp": "01:12:42", "text": "呃，"}, {"type": "subtitle", "time": 4365.59, "timestamp": "01:12:45", "text": "太多事情了。"}, {"type": "subtitle", "time": 4367.51, "timestamp": "01:12:47", "text": "即使你已经成年，有时候做回"}, {"type": "subtitle", "time": 4370.07, "timestamp": "01:12:50", "text": "孩子也是件好事。"}, {"type": "subtitle", "time": 4372.79, "timestamp": "01:12:52", "text": "做些幼稚的事。   是的"}, {"type": "subtitle", "time": 4375.43, "timestamp": "01:12:55", "text": "。"}, {"type": "subtitle", "time": 4378.149, "timestamp": "01:12:58", "text": "那么，该如何入睡呢？ 祝您"}]
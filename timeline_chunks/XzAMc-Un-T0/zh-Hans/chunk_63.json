[{"type": "subtitle", "time": 3780.63, "timestamp": "01:03:00", "text": "生日那天（8月11日）没有课。 哇。"}, {"type": "subtitle", "time": 3783.27, "timestamp": "01:03:03", "text": "我当时想，也许我可以买一罐"}, {"type": "subtitle", "time": 3787.19, "timestamp": "01:03:07", "text": "大糖果之类的东西，"}, {"type": "subtitle", "time": 3789.27, "timestamp": "01:03:09", "text": "分发给我的同学们，以此来"}, {"type": "subtitle", "time": 3792.483, "timestamp": "01:03:12", "text": "增进彼此的感情什么的。"}, {"type": "subtitle", "time": 3794.63, "timestamp": "01:03:14", "text": "[笑声] 我把它送给我的老师们。"}, {"type": "subtitle", "time": 3797.829, "timestamp": "01:03:17", "text": "也许我的意思是，我小时候在学校也经常这样做"}, {"type": "subtitle", "time": 3800.39, "timestamp": "01:03:20", "text": "。 所以我想，是"}, {"type": "subtitle", "time": 3802.47, "timestamp": "01:03:22", "text": "啊，日本是个新国家，所以我"}, {"type": "subtitle", "time": 3812.789, "timestamp": "01:03:32", "text": "不错，"}, {"type": "subtitle", "time": 3816.23, "timestamp": "01:03:36", "text": "因为没有课，所以我想找个"}, {"type": "subtitle", "time": 3819.75, "timestamp": "01:03:39", "text": "兼职的地方做这件事。"}, {"type": "subtitle", "time": 3822.309, "timestamp": "01:03:42", "text": "是的，我会把它交给 Oik"}, {"type": "subtitle", "time": 3825.75, "timestamp": "01:03:45", "text": "Chans、Obad Chan"}, {"type": "subtitle", "time": 3832.71, "timestamp": "01:03:52", "text": "为什么不呢？ 哦，对了，会有"}, {"type": "subtitle", "time": 3837.829, "timestamp": "01:03:57", "text": "生日直播。 是的，我好像"}, {"type": "subtitle", "time": 3839.67, "timestamp": "01:03:59", "text": "没有给我的"}]
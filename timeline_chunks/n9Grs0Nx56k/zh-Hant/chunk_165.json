[{"type": "subtitle", "time": 9903.11, "timestamp": "02:45:03", "text": "我在這裡設定了一個條件語句。所以，如果直播正在進行，但沒有創建"}, {"type": "subtitle", "time": 9908.15, "timestamp": "02:45:08", "text": "Discord"}, {"type": "subtitle", "time": 9912.309, "timestamp": "02:45:12", "text": "活動，"}, {"type": "subtitle", "time": 9933.179, "timestamp": "02:45:33", "text": "當前時間（即"}, {"type": "subtitle", "time": 9951.269, "timestamp": "02:45:51", "text": "Epoch 時間）進行比較。它會看到小於號，如果是負數，則表示"}, {"type": "subtitle", "time": 9959.03, "timestamp": "02:45:59", "text": "現在已經過了開始時間。"}]
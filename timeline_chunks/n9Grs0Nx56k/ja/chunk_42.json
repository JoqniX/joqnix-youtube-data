[{"type": "subtitle", "time": 2522.15, "timestamp": "00:42:02", "text": "うん、そうだよ"}, {"type": "subtitle", "time": 2525.75, "timestamp": "00:42:05", "text": "何も受け取っていません。人々はどのように"}, {"type": "subtitle", "time": 2530.39, "timestamp": "00:42:10", "text": "そんなにたくさんの請求書を受け取るのですか？"}, {"type": "subtitle", "time": 2534.23, "timestamp": "00:42:14", "text": "人々は神ジャナをしない"}, {"type": "subtitle", "time": 2537.19, "timestamp": "00:42:17", "text": "難しすぎる。"}, {"type": "subtitle", "time": 2549.27, "timestamp": "00:42:29", "text": "そうそう。そうそう。終わりましたか？"}, {"type": "subtitle", "time": 2552.069, "timestamp": "00:42:32", "text": "生活スキルに関するもの？レベル20になったの？"}, {"type": "subtitle", "time": 2556.069, "timestamp": "00:42:36", "text": "それらのいくつかと同じように最大レベルですか？"}, {"type": "subtitle", "time": 2559.829, "timestamp": "00:42:39", "text": "昨日、私はPCFKをそのままにしておきました"}, {"type": "subtitle", "time": 2564.39, "timestamp": "00:42:44", "text": "えーと、亜麻から糸になる、みたいな感じですよね？"}, {"type": "subtitle", "time": 2568.71, "timestamp": "00:42:48", "text": "うん。私はその糸を999本持っていました"}, {"type": "subtitle", "time": 2571.75, "timestamp": "00:42:51", "text": "あれ。私はそれをしました。私はその後"}, {"type": "subtitle", "time": 2574.15, "timestamp": "00:42:54", "text": "朝、私はそれを変換しました。"}, {"type": "subtitle", "time": 2577.829, "timestamp": "00:42:57", "text": "それを精製綿に変える。"}]
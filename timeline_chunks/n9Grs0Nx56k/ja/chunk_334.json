[{"type": "subtitle", "time": 20040.868, "timestamp": "05:34:00", "text": "こんにちは。私はこれをします、そして私はこれをします"}, {"type": "subtitle", "time": 20043.43, "timestamp": "05:34:03", "text": "えーと削除ロジック"}, {"type": "subtitle", "time": 20046.548, "timestamp": "05:34:06", "text": "えっと、また後で。なぜそんなに遅い時間に食事をするのですか？忘れた"}, {"type": "subtitle", "time": 20049.51, "timestamp": "05:34:09", "text": "時間が経つのは本当に早かった。私はそう思った"}, {"type": "subtitle", "time": 20052.868, "timestamp": "05:34:12", "text": "午後8時でした。今は11時です。"}, {"type": "subtitle", "time": 20056.15, "timestamp": "05:34:16", "text": "信じられない話だけどね。どうやって"}, {"type": "subtitle", "time": 20060.906, "timestamp": "05:34:20", "text": "ああ、時間が経つのは本当に早い。"}, {"type": "subtitle", "time": 20061.91, "timestamp": "05:34:21", "text": "[笑い]"}, {"type": "subtitle", "time": 20064.15, "timestamp": "05:34:24", "text": "私は、"}, {"type": "subtitle", "time": 20066.628, "timestamp": "05:34:26", "text": "時間が経つのも気づかない"}, {"type": "subtitle", "time": 20077.27, "timestamp": "05:34:37", "text": "今日はfだとは気づきもしなかった"}, {"type": "subtitle", "time": 20080.47, "timestamp": "05:34:40", "text": "金曜日。もう週末になっていた。"}, {"type": "subtitle", "time": 20086.628, "timestamp": "05:34:46", "text": "今日は水曜日か"}, {"type": "subtitle", "time": 20088.548, "timestamp": "05:34:48", "text": "何か。"}, {"type": "subtitle", "time": 20091.19, "timestamp": "05:34:51", "text": "そして"}, {"type": "subtitle", "time": 20095.27, "timestamp": "05:34:55", "text": "時間感覚が失われつつある。"}]
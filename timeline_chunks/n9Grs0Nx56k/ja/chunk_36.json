[{"type": "subtitle", "time": 2160.55, "timestamp": "00:36:00", "text": "こんにちは。"}, {"type": "subtitle", "time": 2172.87, "timestamp": "00:36:12", "text": "ストリームのURLを取得します。"}, {"type": "subtitle", "time": 2182.63, "timestamp": "00:36:22", "text": "これは以前私が作ったウェブサイトです"}, {"type": "subtitle", "time": 2185.829, "timestamp": "00:36:25", "text": "Onexiaのウェブサイトのフレームを作成します。私"}, {"type": "subtitle", "time": 2188.87, "timestamp": "00:36:28", "text": "今でも使えるかどうかは分かりません。"}, {"type": "subtitle", "time": 2191.67, "timestamp": "00:36:31", "text": "まだ使えるよ。はい、壊れています"}, {"type": "subtitle", "time": 2194.63, "timestamp": "00:36:34", "text": "ダイオード。ひねりを加えるとうまくいく。ツイストは"}, {"type": "subtitle", "time": 2198.87, "timestamp": "00:36:38", "text": "魅力。ビリー、ビリー。ああ、使ったのを忘れてた"}, {"type": "subtitle", "time": 2201.67, "timestamp": "00:36:41", "text": "ああ、まだショットを再生している"}, {"type": "subtitle", "time": 2204.63, "timestamp": "00:36:44", "text": "ビリー、ビリー。 [笑い]"}, {"type": "subtitle", "time": 2206.47, "timestamp": "00:36:46", "text": "そうそう。壊れています。こちらは"}, {"type": "subtitle", "time": 2208.23, "timestamp": "00:36:48", "text": "壊れた。私は「いや、そうすべきじゃない」と思った。"}, {"type": "subtitle", "time": 2212.069, "timestamp": "00:36:52", "text": "人々をこのリダイレクト先に誘導してください。"}, {"type": "subtitle", "time": 2214.069, "timestamp": "00:36:54", "text": "そう、それとボタンのやつ。これは"}, {"type": "subtitle", "time": 2217.03, "timestamp": "00:36:57", "text": "これも壊れている。 [笑い]"}, {"type": "subtitle", "time": 2218.95, "timestamp": "00:36:58", "text": "とても疲れた。"}]
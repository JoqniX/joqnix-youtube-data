[{"type": "subtitle", "time": 9362.71, "timestamp": "02:36:02", "text": "何？なぜそのような間違いが起きたのか？何"}, {"type": "subtitle", "time": 9368.55, "timestamp": "02:36:08", "text": "このコードイベントを作成しました。イベント後"}, {"type": "subtitle", "time": 9372.71, "timestamp": "02:36:12", "text": "作成時にIDを取得しますよね？わかった。"}, {"type": "subtitle", "time": 9374.95, "timestamp": "02:36:14", "text": "遅延をご希望ですか？大丈夫。病気"}, {"type": "subtitle", "time": 9406.79, "timestamp": "02:36:46", "text": "11月28日。11月。なぜ両方なのか"}, {"type": "subtitle", "time": 9409.19, "timestamp": "02:36:49", "text": "11月28日？"}, {"type": "subtitle", "time": 9418.15, "timestamp": "02:36:58", "text": "えっと"}]
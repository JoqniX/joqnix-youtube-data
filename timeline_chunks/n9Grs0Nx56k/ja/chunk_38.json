[{"type": "subtitle", "time": 2290.15, "timestamp": "00:38:10", "text": "これは見逃してしまった。"}, {"type": "subtitle", "time": 2297.91, "timestamp": "00:38:17", "text": "それで"}, {"type": "subtitle", "time": 2300.15, "timestamp": "00:38:20", "text": "レベル80の装備はいつ入手できますか？"}, {"type": "subtitle", "time": 2311.91, "timestamp": "00:38:31", "text": "ゲームがすごく速くなったので"}, {"type": "subtitle", "time": 2315.03, "timestamp": "00:38:35", "text": "既にレベル80に到達しました。その"}, {"type": "subtitle", "time": 2318.069, "timestamp": "00:38:38", "text": "待って、私は思う"}, {"type": "subtitle", "time": 2320.39, "timestamp": "00:38:40", "text": "CN版は既に"}, {"type": "subtitle", "time": 2322.069, "timestamp": "00:38:42", "text": "レベル000。"}, {"type": "subtitle", "time": 2324.31, "timestamp": "00:38:44", "text": "いいえ、千百とかそういうのではなく、"}, {"type": "subtitle", "time": 2328.47, "timestamp": "00:38:48", "text": "右？おお。"}, {"type": "subtitle", "time": 2331.67, "timestamp": "00:38:51", "text": "スキルポイント関連のことも。いいえ。"}, {"type": "subtitle", "time": 2334.79, "timestamp": "00:38:54", "text": "才能ポイントはもらえますか？"}, {"type": "subtitle", "time": 2338.79, "timestamp": "00:38:58", "text": "最後の試練はできなかったと思う"}]
[{"type": "subtitle", "time": 1022.15, "timestamp": "00:17:02", "text": "しかし、それはうまくいかない。理由がわからない。"}, {"type": "subtitle", "time": 1024.309, "timestamp": "00:17:04", "text": "私ができた唯一のことは"}, {"type": "subtitle", "time": 1026.87, "timestamp": "00:17:06", "text": "仕事は物語を開くようなものだった"}, {"type": "subtitle", "time": 1029.35, "timestamp": "00:17:09", "text": "Instagram 用のカメラ、"}, {"type": "subtitle", "time": 1032.309, "timestamp": "00:17:12", "text": "右？私の考えは"}, {"type": "subtitle", "time": 1036.15, "timestamp": "00:17:16", "text": "えっと、私は今のような感じを作ります"}, {"type": "subtitle", "time": 1038.949, "timestamp": "00:17:18", "text": "コピー＆ペーストしたものを右にコピーインします"}, {"type": "subtitle", "time": 1041.75, "timestamp": "00:17:21", "text": "クリップボード サミーが私のコピーを読んでいます"}, {"type": "subtitle", "time": 1044.71, "timestamp": "00:17:24", "text": "Windowsのクリップボードから右へ。だから私は"}, {"type": "subtitle", "time": 1049.35, "timestamp": "00:17:29", "text": "もしサミーに何か探知させたらどうなるだろうかと考えている"}, {"type": "subtitle", "time": 1051.75, "timestamp": "00:17:31", "text": "フォルダ内のファイルが変更されました。例えば、"}, {"type": "subtitle", "time": 1054.71, "timestamp": "00:17:34", "text": "フォルダに新しいファイルが追加された場合、"}, {"type": "subtitle", "time": 1056.789, "timestamp": "00:17:36", "text": "右？ダウンロードした瞬間"}, {"type": "subtitle", "time": 1060.23, "timestamp": "00:17:40", "text": "VMwareからのサムネイルは私の"}, {"type": "subtitle", "time": 1063.75, "timestamp": "00:17:43", "text": "ダウンロードフォルダですよね？もし"}, {"type": "subtitle", "time": 1066.549, "timestamp": "00:17:46", "text": "えっと、サムネイルをダウンロードして、もし"}, {"type": "subtitle", "time": 1069.27, "timestamp": "00:17:49", "text": "ファイル名は、"}, {"type": "subtitle", "time": 1071.909, "timestamp": "00:17:51", "text": "フォーマットは、フォーマットと似たものになります"}, {"type": "subtitle", "time": 1075.27, "timestamp": "00:17:55", "text": "これを気に入る。もし私がここに行ったら、"}, {"type": "subtitle", "time": 1077.51, "timestamp": "00:17:57", "text": "少し時間をください。クリックすると"}]
[{"type": "subtitle", "time": 2580.719, "timestamp": "00:43:00", "text": "でも、まるで私がただそれらを買ったかのように感じました。"}, {"type": "subtitle", "time": 2587.03, "timestamp": "00:43:07", "text": "ええと、私はただそれをやっただけです。 [笑い]"}, {"type": "subtitle", "time": 2590.39, "timestamp": "00:43:10", "text": "だから、私は心配する必要はありません"}, {"type": "subtitle", "time": 2593.19, "timestamp": "00:43:13", "text": "30万を織る。"}, {"type": "subtitle", "time": 2595.19, "timestamp": "00:43:15", "text": "待って、ギルドストアを"}, {"type": "subtitle", "time": 2597.349, "timestamp": "00:43:17", "text": "ギルドじゃないの？えっと、あなたは"}, {"type": "subtitle", "time": 2602.55, "timestamp": "00:43:22", "text": "ジンダー関連のアイテムをトレードしますか？あなたはお金持ちですか？"}, {"type": "subtitle", "time": 2613.91, "timestamp": "00:43:33", "text": "私"}, {"type": "subtitle", "time": 2616.87, "timestamp": "00:43:36", "text": "ええ、私がお金を稼ぐ唯一の方法は"}, {"type": "subtitle", "time": 2623.03, "timestamp": "00:43:43", "text": "トレーディングセンターは、えっと、スキルについてです"}, {"type": "subtitle", "time": 2625.109, "timestamp": "00:43:45", "text": "本。ああ"}, {"type": "subtitle", "time": 2627.99, "timestamp": "00:43:47", "text": "ニース。私がお金を稼ぐ唯一の方法は"}, {"type": "subtitle", "time": 2632.15, "timestamp": "00:43:52", "text": "評価センター番号は、拘束されていないものとして"}, {"type": "subtitle", "time": 2635.03, "timestamp": "00:43:55", "text": "ルナは"}, {"type": "subtitle", "time": 2638.069, "timestamp": "00:43:58", "text": "えっと、ギルドのやつ、ギルドストア"}]
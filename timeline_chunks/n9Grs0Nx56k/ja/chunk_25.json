[{"type": "subtitle", "time": 1502.07, "timestamp": "00:25:02", "text": "これら主なものは何ですか？右。私はできる"}, {"type": "subtitle", "time": 1505.669, "timestamp": "00:25:05", "text": "新しいこれを作り、これを作り、"}, {"type": "subtitle", "time": 1510.23, "timestamp": "00:25:10", "text": "これ。これを中に入れてください"}, {"type": "subtitle", "time": 1520.07, "timestamp": "00:25:20", "text": "少し更新する必要がある"}, {"type": "subtitle", "time": 1522.31, "timestamp": "00:25:22", "text": "そこから"}, {"type": "subtitle", "time": 1524.549, "timestamp": "00:25:24", "text": "パッチロジック。"}, {"type": "subtitle", "time": 1527.75, "timestamp": "00:25:27", "text": "自動削除ロジックもこれに適用します。良い"}, {"type": "subtitle", "time": 1530.87, "timestamp": "00:25:30", "text": "一つにまとめます。"}, {"type": "subtitle", "time": 1542.47, "timestamp": "00:25:42", "text": "ここで不要なものは何ですか？"}, {"type": "subtitle", "time": 1548.39, "timestamp": "00:25:48", "text": "デフォルト変数は必要ないと思います"}, {"type": "subtitle", "time": 1551.75, "timestamp": "00:25:51", "text": "イベント実行ボタン"}, {"type": "subtitle", "time": 1556.23, "timestamp": "00:25:56", "text": "これでボタンランは十分だと思う"}]
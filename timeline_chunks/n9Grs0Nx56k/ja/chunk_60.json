[{"type": "subtitle", "time": 3602.87, "timestamp": "01:00:02", "text": "アップデートパケットとすべてのアップデート"}, {"type": "subtitle", "time": 3604.87, "timestamp": "01:00:04", "text": "私たちの中に。"}, {"type": "subtitle", "time": 3610.87, "timestamp": "01:00:10", "text": "Hは良さそうだ。更新パケット。わかった。"}, {"type": "subtitle", "time": 3613.03, "timestamp": "01:00:13", "text": "ライブステータス。これはフェッチであり、"}, {"type": "subtitle", "time": 3625.99, "timestamp": "01:00:25", "text": "つまり、基本的には3つを作成する必要がある"}, {"type": "subtitle", "time": 3628.87, "timestamp": "01:00:28", "text": "イベント。今後配信予定の2つのストリームは"}, {"type": "subtitle", "time": 3631.51, "timestamp": "01:00:31", "text": "来週予定されている今日の"}, {"type": "subtitle", "time": 3634.549, "timestamp": "01:00:34", "text": "ストリームは、まだ作成していないため"}, {"type": "subtitle", "time": 3639.43, "timestamp": "01:00:39", "text": "その出来事は失敗するだろう。"}, {"type": "subtitle", "time": 3641.75, "timestamp": "01:00:41", "text": "あ、ちょっと待って。失敗が必要だ"}, {"type": "subtitle", "time": 3644.95, "timestamp": "01:00:44", "text": "今すぐ切り替えましょう。あ、待って。"}, {"type": "subtitle", "time": 3647.51, "timestamp": "01:00:47", "text": "えっと"}, {"type": "subtitle", "time": 3649.75, "timestamp": "01:00:49", "text": "ああ、神様。 [笑い]"}, {"type": "subtitle", "time": 3656.88, "timestamp": "01:00:56", "text": "[笑い] わかった。"}]
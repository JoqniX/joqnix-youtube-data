[{"type": "subtitle", "time": 7920.79, "timestamp": "02:12:00", "text": "古いものなら見つけられます。私は使いました、えっと"}, {"type": "subtitle", "time": 7924.149, "timestamp": "02:12:04", "text": "以前は、"}, {"type": "subtitle", "time": 7926.87, "timestamp": "02:12:06", "text": "サファイアB. [音楽] そしてこう言う人もいるだろう、"}, {"type": "subtitle", "time": 7937.43, "timestamp": "02:12:17", "text": "しかし、今すぐ支払わなければなりません。だから私は"}, {"type": "subtitle", "time": 7940.31, "timestamp": "02:12:20", "text": "やりたくない。"}, {"type": "subtitle", "time": 7941.99, "timestamp": "02:12:21", "text": "ライブ配信やプレミア公開をサポートします。"}, {"type": "subtitle", "time": 7945.35, "timestamp": "02:12:25", "text": "ええ、これはどういうわけかわかりませんが、"}, {"type": "subtitle", "time": 7947.51, "timestamp": "02:12:27", "text": "彼らはライブストリームプレミアをサポートし、"}, {"type": "subtitle", "time": 7949.43, "timestamp": "02:12:29", "text": "良い。どうしてそんなことが可能なのか私にはわからない。"}, {"type": "subtitle", "time": 7953.43, "timestamp": "02:12:33", "text": "でも、自分で自動化するつもりです。"}, {"type": "subtitle", "time": 7956.47, "timestamp": "02:12:36", "text": "このボットは残しておきますが、料金を支払っていただく必要があります。"}, {"type": "subtitle", "time": 7958.39, "timestamp": "02:12:38", "text": "プレミアム、"}, {"type": "subtitle", "time": 7962.149, "timestamp": "02:12:42", "text": "右？プレミアム料金はいくらですか？"}, {"type": "subtitle", "time": 7964.79, "timestamp": "02:12:44", "text": "月額10ドル。"}, {"type": "subtitle", "time": 7968.229, "timestamp": "02:12:48", "text": "だから私は「いやだ」って言ったんです。そして無料の"}, {"type": "subtitle", "time": 7971.35, "timestamp": "02:12:51", "text": "バージョン、サファイアでは、かなり悪い"}]
[{"type": "subtitle", "time": 2342.23, "timestamp": "00:39:02", "text": "レベルが足りなかったため、"}, {"type": "subtitle", "time": 2345.109, "timestamp": "00:39:05", "text": "ギアレベル。しかしその後はどうなるのか"}, {"type": "subtitle", "time": 2347.109, "timestamp": "00:39:07", "text": "もっと手に入れる"}, {"type": "subtitle", "time": 2350.39, "timestamp": "00:39:10", "text": "ああいう才能ポイントをもっと増やす？なぜなら"}, {"type": "subtitle", "time": 2354.95, "timestamp": "00:39:14", "text": "今はもっと物がある"}, {"type": "subtitle", "time": 2359.27, "timestamp": "00:39:19", "text": "試練だが、探求でもある。"}, {"type": "subtitle", "time": 2362.23, "timestamp": "00:39:22", "text": "うん。だいたいどれくらいの金額をもらっているんですか？しかし"}, {"type": "subtitle", "time": 2365.03, "timestamp": "00:39:25", "text": "完全版はどうですか？まるでそれが示すように"}, {"type": "subtitle", "time": 2367.99, "timestamp": "00:39:27", "text": "何かから生まれたように。いいえ。"}, {"type": "subtitle", "time": 2377.75, "timestamp": "00:39:37", "text": "70点しか獲得できません。ああ、"}, {"type": "subtitle", "time": 2380.95, "timestamp": "00:39:40", "text": "Wパックのマークを確認するために、このことをマークします。"}, {"type": "subtitle", "time": 2383.27, "timestamp": "00:39:43", "text": "シーズン1の締めくくりです。待って、"}, {"type": "subtitle", "time": 2387.109, "timestamp": "00:39:47", "text": "シーズン2のキャップも同様です。おお。"}, {"type": "subtitle", "time": 2390.71, "timestamp": "00:39:50", "text": "そうねぇ。これが彼らがこれを更新した理由です。"}, {"type": "subtitle", "time": 2392.79, "timestamp": "00:39:52", "text": "この文書を読んでいる人はもっと多い。"}, {"type": "subtitle", "time": 2398.39, "timestamp": "00:39:58", "text": "えっと、"}]
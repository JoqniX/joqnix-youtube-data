[{"type": "subtitle", "time": 4022.71, "timestamp": "01:07:02", "text": "えっと、"}, {"type": "subtitle", "time": 4026.069, "timestamp": "01:07:06", "text": "疑問符は必要ですか？疑い"}, {"type": "subtitle", "time": 4028.15, "timestamp": "01:07:08", "text": "騒音。"}, {"type": "subtitle", "time": 4031.109, "timestamp": "01:07:11", "text": "いえ、必要ありません。私はただ"}, {"type": "subtitle", "time": 4041.19, "timestamp": "01:07:21", "text": "[咳払い]"}, {"type": "subtitle", "time": 4044.71, "timestamp": "01:07:24", "text": "えっと、これを最初のどこに置けばいいですか？"}, {"type": "subtitle", "time": 4047.109, "timestamp": "01:07:27", "text": "1位？"}, {"type": "subtitle", "time": 4051.67, "timestamp": "01:07:31", "text": "それでは、Discordイベントに進んでください。ああ"}, {"type": "subtitle", "time": 4060.23, "timestamp": "01:07:40", "text": "いいえ、そこではありません。え、何？私はとても"}, {"type": "subtitle", "time": 4063.51, "timestamp": "01:07:43", "text": "混乱してるよ、君。"}, {"type": "subtitle", "time": 4065.589, "timestamp": "01:07:45", "text": "あのね？ちょっとやってみます"}]
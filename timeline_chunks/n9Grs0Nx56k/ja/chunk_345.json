[{"type": "subtitle", "time": 20702.07, "timestamp": "05:45:02", "text": "私のすべてのストリームからのランダムなVS"}, {"type": "subtitle", "time": 20704.31, "timestamp": "05:45:04", "text": "私が"}, {"type": "subtitle", "time": 20707.35, "timestamp": "05:45:07", "text": "オフライン。うん。うん。うん。だから人々は"}, {"type": "subtitle", "time": 20711.43, "timestamp": "05:45:11", "text": "このURLを持っている人 このURLを持っている人"}, {"type": "subtitle", "time": 20713.91, "timestamp": "05:45:13", "text": "彼らは"}, {"type": "subtitle", "time": 20716.708, "timestamp": "05:45:16", "text": "ランダムに何ができるか見てみましょう"}, {"type": "subtitle", "time": 20718.548, "timestamp": "05:45:18", "text": "時計"}, {"type": "subtitle", "time": 20722.15, "timestamp": "05:45:22", "text": "そのストリームが30本。更新するたびに"}, {"type": "subtitle", "time": 20723.91, "timestamp": "05:45:23", "text": "得る。だから5分ごとに"}, {"type": "subtitle", "time": 20726.708, "timestamp": "05:45:26", "text": "新しいVか何かを生成する。うん、"}, {"type": "subtitle", "time": 20729.99, "timestamp": "05:45:29", "text": "それは良いことだ。だから、もし私が"}, {"type": "subtitle", "time": 20732.708, "timestamp": "05:45:32", "text": "OBSかMeltで確認する必要がある"}, {"type": "subtitle", "time": 20735.59, "timestamp": "05:45:35", "text": "ブラウザを更新しないでください。"}, {"type": "subtitle", "time": 20738.708, "timestamp": "05:45:38", "text": "プレイしました。ああ、それは本当に良いアイデアですね。うん、"}, {"type": "subtitle", "time": 20743.51, "timestamp": "05:45:43", "text": "これを直さなければならない。えっと、"}, {"type": "subtitle", "time": 20752.39, "timestamp": "05:45:52", "text": "うん。ええと、私はその考えを信じています"}]
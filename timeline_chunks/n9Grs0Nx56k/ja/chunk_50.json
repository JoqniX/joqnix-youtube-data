[{"type": "subtitle", "time": 3005.91, "timestamp": "00:50:05", "text": "農場経営にはまだ手を出していない"}, {"type": "subtitle", "time": 3011.109, "timestamp": "00:50:11", "text": "装飾品など、まだ何も揃っていません。"}, {"type": "subtitle", "time": 3014.47, "timestamp": "00:50:14", "text": "うーん、それはかなり大変な作業になりそうですね。いいえ"}, {"type": "subtitle", "time": 3028.549, "timestamp": "00:50:28", "text": "自給自足生活のものは、"}, {"type": "subtitle", "time": 3047.91, "timestamp": "00:50:47", "text": "友達がポイントを獲得。ああ、私はまだやっていない"}, {"type": "subtitle", "time": 3049.03, "timestamp": "00:50:49", "text": "それ。 [笑い]"}, {"type": "subtitle", "time": 3052.39, "timestamp": "00:50:52", "text": "私はそれをしていません。私はあまり持っていません"}, {"type": "subtitle", "time": 3054.71, "timestamp": "00:50:54", "text": "一緒に遊ぶ友達。つまり、ギルドメンバー"}]
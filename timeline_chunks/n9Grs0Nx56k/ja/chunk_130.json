[{"type": "subtitle", "time": 7802.95, "timestamp": "02:10:02", "text": "もうこんなことになってるの？がある。いいえ、私はしません"}, {"type": "subtitle", "time": 7805.91, "timestamp": "02:10:05", "text": "そう思う。"}, {"type": "subtitle", "time": 7808.149, "timestamp": "02:10:08", "text": "行くことを追加することについて話しているのですか?"}, {"type": "subtitle", "time": 7812.629, "timestamp": "02:10:12", "text": "Discordボットのようにライブ配信してアナウンスする"}, {"type": "subtitle", "time": 7814.229, "timestamp": "02:10:14", "text": "あなたの配信とかそういうもの？それは"}, {"type": "subtitle", "time": 7817.189, "timestamp": "02:10:17", "text": "違う。これは違う。"}, {"type": "subtitle", "time": 7819.43, "timestamp": "02:10:19", "text": "それは基本的なことだ。 [音楽]"}, {"type": "subtitle", "time": 7823.03, "timestamp": "02:10:23", "text": "もっと、もっと詳細な情報が欲しいです。"}, {"type": "subtitle", "time": 7825.35, "timestamp": "02:10:25", "text": "高度な自動化技術。だから私は"}, {"type": "chat", "time": 7829.683, "timestamp": "02:10:29", "author": "@TheDivineGokuBlack", "avatar": "https://yt4.ggpht.com/x2pzeEVaf1zyUBkZCrzTAzUJCua_ZlOHqOBCVhiADyCWmaW54l65hftnOmbOFY2vCGVSXGk5Ng=s64-c-k-c0x00ffffff-no-rj", "message": "so we making big brain moves"}, {"type": "subtitle", "time": 7829.75, "timestamp": "02:10:29", "text": "このようにする。あれはいいけど、"}, {"type": "subtitle", "time": 7833.669, "timestamp": "02:10:33", "text": "特にYouTubeにとっては、かなりまずい状況だ。"}, {"type": "subtitle", "time": 7835.75, "timestamp": "02:10:35", "text": "特に"}, {"type": "subtitle", "time": 7839.35, "timestamp": "02:10:39", "text": "Twitch向けに。 Twitchにとっては良いことだ。"}, {"type": "subtitle", "time": 7841.669, "timestamp": "02:10:41", "text": "YouTubeにとっては、"}, {"type": "subtitle", "time": 7843.91, "timestamp": "02:10:43", "text": "YouTube API の仕組みは、"}, {"type": "subtitle", "time": 7847.91, "timestamp": "02:10:47", "text": "それはあなたをそうさせない、そうさせない"}, {"type": "subtitle", "time": 7850.55, "timestamp": "02:10:50", "text": "相手にあなたがライブ配信中であることを知らせましょう"}, {"type": "subtitle", "time": 7854.069, "timestamp": "02:10:54", "text": "ライブ配信ですか、それとも単なる動画ですか、それともYouTubeですか？"}, {"type": "subtitle", "time": 7858.31, "timestamp": "02:10:58", "text": "ショット？いいえ。だからアナウンサーは要りません"}]
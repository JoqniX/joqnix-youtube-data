[{"type": "subtitle", "time": 14589.51, "timestamp": "04:03:09", "text": "また、私はイベントを確認しませんでした。"}, {"type": "subtitle", "time": 14596.389, "timestamp": "04:03:16", "text": "サムネイルはどこにあるの？"}, {"type": "subtitle", "time": 14599.67, "timestamp": "04:03:19", "text": "わかった。えーと、タイトル"}, {"type": "subtitle", "time": 14602.229, "timestamp": "04:03:22", "text": "住所は正しいです。"}, {"type": "subtitle", "time": 14604.229, "timestamp": "04:03:24", "text": "わかった。"}, {"type": "subtitle", "time": 14608.55, "timestamp": "04:03:28", "text": "配信は午後1時です。 7. 待って、"}, {"type": "subtitle", "time": 14611.67, "timestamp": "04:03:31", "text": "午後1時でしたか？"}, {"type": "subtitle", "time": 14613.75, "timestamp": "04:03:33", "text": "配信はいつ予定されていましたか？わかった、"}, {"type": "subtitle", "time": 14616.55, "timestamp": "04:03:36", "text": "午後1時その通りです。"}, {"type": "subtitle", "time": 14619.349, "timestamp": "04:03:39", "text": "おそらく午後10時頃でしょう。それは"}, {"type": "subtitle", "time": 14631.91, "timestamp": "04:03:51", "text": "はい、サムネイルは承認されませんでした。"}, {"type": "subtitle", "time": 14634.71, "timestamp": "04:03:54", "text": "なぜ"}, {"type": "subtitle", "time": 14637.11, "timestamp": "04:03:57", "text": "する"}]
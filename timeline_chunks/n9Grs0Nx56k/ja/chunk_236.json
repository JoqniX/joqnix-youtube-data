[{"type": "subtitle", "time": 14161.11, "timestamp": "03:56:01", "text": "今。"}, {"type": "subtitle", "time": 14179.03, "timestamp": "03:56:19", "text": "スケジュールと時間、そして最後は"}, {"type": "subtitle", "time": 14181.83, "timestamp": "03:56:21", "text": "説明。"}, {"type": "subtitle", "time": 14183.75, "timestamp": "03:56:23", "text": "よし。それでは、パスを設定しましょう。"}, {"type": "subtitle", "time": 14188.15, "timestamp": "03:56:28", "text": "それでおしまい。ドル記号。包んでください。"}, {"type": "subtitle", "time": 14199.11, "timestamp": "03:56:39", "text": "包んでください。それを置いてください。了解しました。包んでください。"}, {"type": "subtitle", "time": 14203.03, "timestamp": "03:56:43", "text": "それを置いてください。これをコピーしてください。"}, {"type": "subtitle", "time": 14206.469, "timestamp": "03:56:46", "text": "包んでください。それを置いてください。道は均等で"}, {"type": "subtitle", "time": 14210.95, "timestamp": "03:56:50", "text": "良い。包んでください。それを置いてください。しかし、IDは"}, {"type": "subtitle", "time": 14213.99, "timestamp": "03:56:53", "text": "これ。了解しました。了解しました。了解しました。"}]
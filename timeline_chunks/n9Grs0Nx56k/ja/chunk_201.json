[{"type": "subtitle", "time": 12066.15, "timestamp": "03:21:06", "text": "ほら、現在のストリームをプルしている"}, {"type": "subtitle", "time": 12072.07, "timestamp": "03:21:12", "text": "これは私が初めて気づいたことです"}, {"type": "subtitle", "time": 12074.87, "timestamp": "03:21:14", "text": "頭上に星座が浮かんでいる。うん、レオ"}, {"type": "subtitle", "time": 12079.269, "timestamp": "03:21:19", "text": "星座。私の起源を示すマーク"}, {"type": "subtitle", "time": 12082.469, "timestamp": "03:21:22", "text": "レオ。また、誰か"}, {"type": "subtitle", "time": 12085.75, "timestamp": "03:21:25", "text": "最近友達が言ったことを知っている"}, {"type": "subtitle", "time": 12088.63, "timestamp": "03:21:28", "text": "私にとって、新しい星座が誕生した。いや、いや。"}, {"type": "subtitle", "time": 12091.75, "timestamp": "03:21:31", "text": "新しい星座占いがあるよ。忘れた"}, {"type": "subtitle", "time": 12094.389, "timestamp": "03:21:34", "text": "名前。新しい星座があるみたい"}, {"type": "subtitle", "time": 12095.91, "timestamp": "03:21:35", "text": "あれ"}, {"type": "subtitle", "time": 12098.07, "timestamp": "03:21:38", "text": "最近届いた"}, {"type": "subtitle", "time": 12101.11, "timestamp": "03:21:41", "text": "あるいは、そんな感じ。そして天秤座の人々は"}, {"type": "subtitle", "time": 12103.03, "timestamp": "03:21:43", "text": "彼らが着替える前。知っている"}, {"type": "subtitle", "time": 12105.59, "timestamp": "03:21:45", "text": "射手座か何かが変わった"}, {"type": "subtitle", "time": 12108.389, "timestamp": "03:21:48", "text": "11月と12月のような時期。"}, {"type": "subtitle", "time": 12115.75, "timestamp": "03:21:55", "text": "あなたは、それが伝えるようなzを信じますか？"}, {"type": "subtitle", "time": 12119.11, "timestamp": "03:21:59", "text": "人々のこと？あまりない"}]
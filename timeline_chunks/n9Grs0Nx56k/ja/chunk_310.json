[{"type": "subtitle", "time": 18601.35, "timestamp": "05:10:01", "text": "第二に、それを実行する、"}, {"type": "subtitle", "time": 18605.03, "timestamp": "05:10:05", "text": "兄弟。何てことだ。私はキレそう。"}, {"type": "subtitle", "time": 18610.47, "timestamp": "05:10:10", "text": "241. 241号室では何が起こっているのですか？ 241. 241."}, {"type": "subtitle", "time": 18618.708, "timestamp": "05:10:18", "text": "これは既にかなり荒れていた。"}, {"type": "subtitle", "time": 18656.788, "timestamp": "05:10:56", "text": "ああ、建ったよ。ああ、確かに建てたんだよ。わかった。"}]
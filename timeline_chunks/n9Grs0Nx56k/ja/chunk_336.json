[{"type": "subtitle", "time": 20163.03, "timestamp": "05:36:03", "text": "えっと、10分くらいで戻ります"}, {"type": "subtitle", "time": 20166.548, "timestamp": "05:36:06", "text": "20分。虚空を見よ。プレイします"}, {"type": "subtitle", "time": 20169.11, "timestamp": "05:36:09", "text": "もう少ししたら。はい、心配しないでください。ええと、もう一度言いますが、"}, {"type": "subtitle", "time": 20171.91, "timestamp": "05:36:11", "text": "サミーの持ち物。まあ、そうですね。"}, {"type": "subtitle", "time": 20173.43, "timestamp": "05:36:13", "text": "えっと、"}, {"type": "subtitle", "time": 20176.548, "timestamp": "05:36:16", "text": "待って。私は、"}, {"type": "subtitle", "time": 20178.548, "timestamp": "05:36:18", "text": "ストリーム。"}, {"type": "subtitle", "time": 20182.628, "timestamp": "05:36:22", "text": "うん。こんにちは。また、"}, {"type": "subtitle", "time": 20185.03, "timestamp": "05:36:25", "text": "今夜、星々があなたを祝福しますように。"}, {"type": "subtitle", "time": 20187.91, "timestamp": "05:36:27", "text": "あなたを見守り、あなたに甘い恵みを与えてください"}, {"type": "subtitle", "time": 20190.39, "timestamp": "05:36:30", "text": "夢。わかった。おやすみ。ありがとうございます"}, {"type": "subtitle", "time": 20193.83, "timestamp": "05:36:33", "text": "来るよ。わかった。さあ、みんな食べに行こう。夕食"}, {"type": "subtitle", "time": 20195.75, "timestamp": "05:36:35", "text": "時間。"}, {"type": "subtitle", "time": 20202.31, "timestamp": "05:36:42", "text": "ええと、ここから始めましょう。さよなら。"}, {"type": "subtitle", "time": 20209.51, "timestamp": "05:36:49", "text": "ああ、最新の情報を入手している"}, {"type": "subtitle", "time": 20211.67, "timestamp": "05:36:51", "text": "ストリーム。私のミスです。私のミスです。あ、待って、待って、"}, {"type": "subtitle", "time": 20214.948, "timestamp": "05:36:54", "text": "待って。ああ、わかった。ああ、忘れてた。待って、"}, {"type": "subtitle", "time": 20217.67, "timestamp": "05:36:57", "text": "アップデート中ですよね？"}]
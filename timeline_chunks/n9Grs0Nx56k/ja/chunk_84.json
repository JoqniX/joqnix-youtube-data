[{"type": "subtitle", "time": 5045.59, "timestamp": "01:24:05", "text": "私はこれに手を出したことはありません"}, {"type": "subtitle", "time": 5050.149, "timestamp": "01:24:10", "text": "これまでで最も複雑な数学。でも、そうですね、"}, {"type": "subtitle", "time": 5052.55, "timestamp": "01:24:12", "text": "これに関して何かしたのを覚えておいてください。私"}, {"type": "subtitle", "time": 5055.99, "timestamp": "01:24:15", "text": "Twitchチャットのようなものだったと思う"}, {"type": "subtitle", "time": 5057.75, "timestamp": "01:24:17", "text": "Discordにメッセージを送るか、ボタンか"}, {"type": "subtitle", "time": 5062.95, "timestamp": "01:24:22", "text": "ログ記録に関する何かを忘れていました"}, {"type": "subtitle", "time": 5065.75, "timestamp": "01:24:25", "text": "見せる。"}, {"type": "subtitle", "time": 5069.51, "timestamp": "01:24:29", "text": "わかった。何だって？私はどこまで話したっけ？"}, {"type": "subtitle", "time": 5073.669, "timestamp": "01:24:33", "text": "内部？現在の開始時刻を作成します"}, {"type": "subtitle", "time": 5078.31, "timestamp": "01:24:38", "text": "日時。右。わかった。"}, {"type": "subtitle", "time": 5083.43, "timestamp": "01:24:43", "text": "了解しました。ここに置いてください。"}, {"type": "subtitle", "time": 5085.91, "timestamp": "01:24:45", "text": "オペレーター"}, {"type": "subtitle", "time": 5088.47, "timestamp": "01:24:48", "text": "入力形式"}, {"type": "subtitle", "time": 5090.87, "timestamp": "01:24:50", "text": "ISO形式に変更する必要があります。"}, {"type": "subtitle", "time": 5092.79, "timestamp": "01:24:52", "text": "右？"}]
[{"type": "subtitle", "time": 14784.15, "timestamp": "04:06:24", "text": "もし待って、えっと、別の方法でできるなら"}, {"type": "subtitle", "time": 14785.99, "timestamp": "04:06:25", "text": "は"}, {"type": "subtitle", "time": 14789.99, "timestamp": "04:06:29", "text": "ビデオの状態が「ライブ」の場合。"}, {"type": "subtitle", "time": 14792.389, "timestamp": "04:06:32", "text": "いいえ、みんながビデオを見ているとは思いません"}, {"type": "subtitle", "time": 14795.349, "timestamp": "04:06:35", "text": "ステータスは「ライブ」ですよね？"}, {"type": "subtitle", "time": 14798.79, "timestamp": "04:06:38", "text": "私はそれが事実だとは到底思えません。"}, {"type": "subtitle", "time": 14801.429, "timestamp": "04:06:41", "text": "それはこの男に限った話だ。他の全員、"}]
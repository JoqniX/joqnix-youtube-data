[{"type": "subtitle", "time": 722.949, "timestamp": "00:12:02", "text": "全て揃っている。えっと、私の"}, {"type": "subtitle", "time": 726.47, "timestamp": "00:12:06", "text": "OBS に問題があった、えーと、タイムスタンプ"}, {"type": "subtitle", "time": 728.629, "timestamp": "00:12:08", "text": "ストリームを切り替えたとき、"}, {"type": "subtitle", "time": 731.91, "timestamp": "00:12:11", "text": "私がぼかしをオンにしたとき、そのシーンは"}, {"type": "subtitle", "time": 734.23, "timestamp": "00:12:14", "text": "緊急時のぼかし機能 以前持っていたもの"}, {"type": "subtitle", "time": 738.949, "timestamp": "00:12:18", "text": "昔はそうだった。私はこれを覚えています。私"}, {"type": "subtitle", "time": 741.91, "timestamp": "00:12:21", "text": "以前は自分の個人情報をひどく晒していた。えっと、そうじゃない"}, {"type": "subtitle", "time": 744.949, "timestamp": "00:12:24", "text": "自分を晒す、えっと、いくつか"}, {"type": "subtitle", "time": 746.87, "timestamp": "00:12:26", "text": "本来持っていてはいけない不要なもの"}, {"type": "subtitle", "time": 749.509, "timestamp": "00:12:29", "text": "ストリームに誤って表示される。"}, {"type": "subtitle", "time": 752.31, "timestamp": "00:12:32", "text": "それからピアノの鍵盤を押さなければならなかった"}, {"type": "subtitle", "time": 754.79, "timestamp": "00:12:34", "text": "まるで[音楽]Cシャープとかそんな感じで"}, {"type": "subtitle", "time": 757.833, "timestamp": "00:12:37", "text": "自動的に画面をぼかします"}, {"type": "subtitle", "time": 758.949, "timestamp": "00:12:38", "text": "[笑い声と息を呑む音] とかそんな感じ。うん、"}, {"type": "subtitle", "time": 762.31, "timestamp": "00:12:42", "text": "私はそういうのが懐かしいと思う。私はそれを持っていますか？"}, {"type": "subtitle", "time": 765.99, "timestamp": "00:12:45", "text": "ご回答ありがとうございます。はぁ？ようこそ。"}, {"type": "subtitle", "time": 768.389, "timestamp": "00:12:48", "text": "当時はMIDI機器を使っていた。"}, {"type": "subtitle", "time": 772.15, "timestamp": "00:12:52", "text": "私のマクロストリームデッキか何かとして"}, {"type": "subtitle", "time": 774.389, "timestamp": "00:12:54", "text": "そんな感じ。ここだと思うか、"}, {"type": "subtitle", "time": 776.15, "timestamp": "00:12:56", "text": "何か。"}, {"type": "subtitle", "time": 779.59, "timestamp": "00:12:59", "text": "えっと、垂直方向のジョッキーブラーを開始してください。それは"}]
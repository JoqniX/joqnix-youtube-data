[{"type": "subtitle", "time": 21125.27, "timestamp": "05:52:05", "text": "えっと、ノーションタイマー。わかった。この男は"}, {"type": "subtitle", "time": 21134.39, "timestamp": "05:52:14", "text": "概念ハンドラー。ノテーションヘッダー"}, {"type": "subtitle", "time": 21156.23, "timestamp": "05:52:36", "text": "Notionのヘッダー。"}, {"type": "subtitle", "time": 21158.23, "timestamp": "05:52:38", "text": "良い。今は1つの番組です。ニース。今私たちは"}, {"type": "subtitle", "time": 21165.83, "timestamp": "05:52:45", "text": "わかった。"}]
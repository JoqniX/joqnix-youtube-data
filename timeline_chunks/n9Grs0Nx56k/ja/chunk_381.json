[{"type": "subtitle", "time": 22861.99, "timestamp": "06:21:01", "text": "つまり、その中身は配列です。うん"}, {"type": "subtitle", "time": 22864.07, "timestamp": "06:21:04", "text": "これは配列です。何でも揃っている。それで"}, {"type": "subtitle", "time": 22869.27, "timestamp": "06:21:09", "text": "私ができることは、データを相互チェックすることです。"}, {"type": "subtitle", "time": 22872.15, "timestamp": "06:21:12", "text": "フェッチからの現在のイベントのデータ"}, {"type": "subtitle", "time": 22876.948, "timestamp": "06:21:16", "text": "メインにマッピングされたデータを持つもの"}, {"type": "subtitle", "time": 22880.948, "timestamp": "06:21:20", "text": "地図の右、私はすべてのためにそれをすることができます"}, {"type": "subtitle", "time": 22884.708, "timestamp": "06:21:24", "text": "名前などのフィールドで名前を入力できます。"}, {"type": "subtitle", "time": 22889.03, "timestamp": "06:21:29", "text": "うん、名前ならできるよ"}, {"type": "subtitle", "time": 22891.03, "timestamp": "06:21:31", "text": "他に何ができるだろうか、名前は"}, {"type": "subtitle", "time": 22894.628, "timestamp": "06:21:34", "text": "複数のことができる可能性が高い"}, {"type": "subtitle", "time": 22898.628, "timestamp": "06:21:38", "text": "そうすればフィールドを比較できる"}, {"type": "subtitle", "time": 22900.788, "timestamp": "06:21:40", "text": "そして全てが正しいと思いますか、それは"}, {"type": "subtitle", "time": 22902.788, "timestamp": "06:21:42", "text": "良いアイデア"}, {"type": "subtitle", "time": 22905.19, "timestamp": "06:21:45", "text": "私はこれを別の州で行います"}, {"type": "subtitle", "time": 22909.43, "timestamp": "06:21:49", "text": "既存のDiscord IDではない"}, {"type": "subtitle", "time": 22913.19, "timestamp": "06:21:53", "text": "えーと等しくない、ええ、つまり、えーと、"}, {"type": "subtitle", "time": 22915.91, "timestamp": "06:21:55", "text": "メインロジックは、存在する場合のようになります"}, {"type": "subtitle", "time": 22919.75, "timestamp": "06:21:59", "text": "discord ID は、存在する場合、等しくなります"}]
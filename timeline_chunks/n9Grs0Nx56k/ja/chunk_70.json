[{"type": "subtitle", "time": 4201.35, "timestamp": "01:10:01", "text": "それでは、テストのために1分間にしてみましょう。"}, {"type": "subtitle", "time": 4205.43, "timestamp": "01:10:05", "text": "それ。そうすれば時間を延ばすことができます。いいえ。"}, {"type": "subtitle", "time": 4209.669, "timestamp": "01:10:09", "text": "ええと、スケジュールの時間"}, {"type": "subtitle", "time": 4216.63, "timestamp": "01:10:16", "text": "何に等しいですか？これから数学をやらなきゃ。"}, {"type": "subtitle", "time": 4219.35, "timestamp": "01:10:19", "text": "待って、待って、待って、待って、待って、待って。"}, {"type": "subtitle", "time": 4224.63, "timestamp": "01:10:24", "text": "そして予定時刻はああでした。"}, {"type": "subtitle", "time": 4234.95, "timestamp": "01:10:34", "text": "これらを全部保管しておいた方がいいんじゃない？"}, {"type": "subtitle", "time": 4237.51, "timestamp": "01:10:37", "text": "他の場所？"}, {"type": "subtitle", "time": 4240.79, "timestamp": "01:10:40", "text": "だって、同じことなんだから。それは"}, {"type": "subtitle", "time": 4243.59, "timestamp": "01:10:43", "text": "ああ、それと同じだ。"}, {"type": "subtitle", "time": 4248.229, "timestamp": "01:10:48", "text": "右。これらの人たちと"}]
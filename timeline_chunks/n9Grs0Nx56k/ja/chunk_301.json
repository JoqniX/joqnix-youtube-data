[{"type": "subtitle", "time": 18073.99, "timestamp": "05:01:13", "text": "待って、"}, {"type": "subtitle", "time": 18079.03, "timestamp": "05:01:19", "text": "それ。わかった。待って。"}, {"type": "subtitle", "time": 18081.83, "timestamp": "05:01:21", "text": "繰り返し表示を削除して"}, {"type": "subtitle", "time": 18085.91, "timestamp": "05:01:25", "text": "30秒ごとに実行されるわけではありません。いいえ、10番"}, {"type": "subtitle", "time": 18088.47, "timestamp": "05:01:28", "text": "秒。待って、"}, {"type": "subtitle", "time": 18090.948, "timestamp": "05:01:30", "text": "理解できたと思います。全体を掃除します"}, {"type": "subtitle", "time": 18103.03, "timestamp": "05:01:43", "text": "よし。わかった。では、ここへ行ってください。戻ってくる"}, {"type": "subtitle", "time": 18107.27, "timestamp": "05:01:47", "text": "ここ。河川地図ファイルを開いてください。"}, {"type": "subtitle", "time": 18109.83, "timestamp": "05:01:49", "text": "これを一時停止してください。"}]
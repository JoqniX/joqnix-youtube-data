[{"type": "subtitle", "time": 2760.39, "timestamp": "00:46:00", "text": "アニメを追いつこう。たくさんあります"}, {"type": "subtitle", "time": 2768.87, "timestamp": "00:46:08", "text": "私はFruitの曲を聴いています"}, {"type": "subtitle", "time": 2772.39, "timestamp": "00:46:12", "text": "バスケットに入って、俺はこう思う、俺は"}, {"type": "subtitle", "time": 2782.55, "timestamp": "00:46:22", "text": "だから、神様、"}, {"type": "subtitle", "time": 2784.87, "timestamp": "00:46:24", "text": "まだ３日間やらなきゃいけないんだ"}, {"type": "subtitle", "time": 2788.87, "timestamp": "00:46:28", "text": "ワールドボス征服。私はまだやっていない"}, {"type": "subtitle", "time": 2793.27, "timestamp": "00:46:33", "text": "あれは一度きりだったね、[笑い]"}, {"type": "subtitle", "time": 2796.15, "timestamp": "00:46:36", "text": "あらら。ああ、マスタートライアルが終わる"}, {"type": "subtitle", "time": 2798.069, "timestamp": "00:46:38", "text": "すぐ。いいえ、バッジを取得して"}, {"type": "subtitle", "time": 2800.069, "timestamp": "00:46:40", "text": "名刺。"}, {"type": "subtitle", "time": 2803.67, "timestamp": "00:46:43", "text": "えっと、タイトルのやつ。ええ、そうしないといけないんです"}, {"type": "subtitle", "time": 2807.03, "timestamp": "00:46:47", "text": "すぐ。今日中にこれを終えたら、"}, {"type": "subtitle", "time": 2809.109, "timestamp": "00:46:49", "text": "明日とかは、"}, {"type": "subtitle", "time": 2811.51, "timestamp": "00:46:51", "text": "ブループロトコル。"}, {"type": "subtitle", "time": 2815.67, "timestamp": "00:46:55", "text": "最後まで待てないよ。"}, {"type": "subtitle", "time": 2819.67, "timestamp": "00:46:59", "text": "1週間あたり100行です"}]
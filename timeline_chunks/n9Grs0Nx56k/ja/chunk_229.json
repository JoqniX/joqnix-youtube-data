[{"type": "subtitle", "time": 13753.03, "timestamp": "03:49:13", "text": "すべてのアップデートが実行されます。ああ、私はなんて愚かなんだろう。ああ、"}, {"type": "subtitle", "time": 13756.309, "timestamp": "03:49:16", "text": "ああ、スペルミスだ。何てことだ、"}, {"type": "subtitle", "time": 13759.189, "timestamp": "03:49:19", "text": "バカめ。君は私をバカにした。ああ、なんてことだ、君は"}, {"type": "subtitle", "time": 13762.55, "timestamp": "03:49:22", "text": "バカバカ。 [息を呑む] お前は今やバカだ。"}, {"type": "subtitle", "time": 13765.03, "timestamp": "03:49:25", "text": "お前は大バカだ"}, {"type": "subtitle", "time": 13767.99, "timestamp": "03:49:27", "text": "バカバカ。 [息を呑む] 30分も無駄にした"}, {"type": "subtitle", "time": 13770.95, "timestamp": "03:49:30", "text": "これは単なるスペルミスです。ああ、"}, {"type": "subtitle", "time": 13772.87, "timestamp": "03:49:32", "text": "神。"}, {"type": "subtitle", "time": 13774.95, "timestamp": "03:49:34", "text": "どこにもない。"}, {"type": "subtitle", "time": 13778.07, "timestamp": "03:49:38", "text": "とんでもない。 30ドルも無駄にしてしまった。ああ、なんてことだ。"}, {"type": "subtitle", "time": 13781.59, "timestamp": "03:49:41", "text": "よし、これでちゃんと動くようになったよね？"}, {"type": "subtitle", "time": 13783.75, "timestamp": "03:49:43", "text": "スペルミス。"}]
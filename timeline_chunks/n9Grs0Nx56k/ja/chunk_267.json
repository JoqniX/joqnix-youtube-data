[{"type": "subtitle", "time": 16037.75, "timestamp": "04:27:17", "text": "スケジュールを組まないでください"}, {"type": "subtitle", "time": 16039.59, "timestamp": "04:27:19", "text": "イベント。スケジュールを組まないでください"}, {"type": "subtitle", "time": 16041.83, "timestamp": "04:27:21", "text": "イベント。予定されたイベントを作成しないでください。する"}, {"type": "subtitle", "time": 16045.429, "timestamp": "04:27:25", "text": "「はい」とは言わない。"}, {"type": "subtitle", "time": 16048.469, "timestamp": "04:27:28", "text": "入力が間違っています。"}, {"type": "subtitle", "time": 16060.95, "timestamp": "04:27:40", "text": "何？なぜ？"}, {"type": "subtitle", "time": 16068.63, "timestamp": "04:27:48", "text": "正しくない。どうやって？"}, {"type": "subtitle", "time": 16070.95, "timestamp": "04:27:50", "text": "また、ファイルパスが"}, {"type": "subtitle", "time": 16074.309, "timestamp": "04:27:54", "text": "存在する。なぜ？ああ、この人は直してくれなかった。"}, {"type": "subtitle", "time": 16078.46, "timestamp": "04:27:58", "text": "あ、ごめんなさい。私のミスです。私のミスです。"}, {"type": "subtitle", "time": 16079.51, "timestamp": "04:27:59", "text": "[ため息と息を呑む音]"}]
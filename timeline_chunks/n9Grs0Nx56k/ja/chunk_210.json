[{"type": "subtitle", "time": 12602.0, "timestamp": "03:30:02", "text": "そして、シングルの代わりに 更新します。これは送信されています。"}, {"type": "subtitle", "time": 12604.96, "timestamp": "03:30:04", "text": "更新します。これは送信されています。 これで2回目だ。それで"}, {"type": "subtitle", "time": 12608.399, "timestamp": "03:30:08", "text": "これで2回目だ。それで 単一の更新ではなく"}, {"type": "subtitle", "time": 12617.83, "timestamp": "03:30:17", "text": "待ち時間なし。"}, {"type": "subtitle", "time": 12620.55, "timestamp": "03:30:20", "text": "ああ（ため息をつき、息を呑む）"}, {"type": "subtitle", "time": 12623.429, "timestamp": "03:30:23", "text": "いやいやいやいやいや。"}, {"type": "subtitle", "time": 12625.99, "timestamp": "03:30:25", "text": "M."}, {"type": "subtitle", "time": 12627.75, "timestamp": "03:30:27", "text": "ああ、こんな感じ、わかった、わかった"}, {"type": "subtitle", "time": 12629.51, "timestamp": "03:30:29", "text": "理解する。"}, {"type": "subtitle", "time": 12632.389, "timestamp": "03:30:32", "text": "それで"}, {"type": "subtitle", "time": 12633.99, "timestamp": "03:30:33", "text": "これ"}, {"type": "subtitle", "time": 12641.59, "timestamp": "03:30:41", "text": "一部。わかった、私はこう書いた、あ、待って"}, {"type": "subtitle", "time": 12648.71, "timestamp": "03:30:48", "text": "すべてのアップデートのパスをコピーします。私はそれを置いた"}, {"type": "subtitle", "time": 12650.71, "timestamp": "03:30:50", "text": "ここ"}, {"type": "subtitle", "time": 12654.95, "timestamp": "03:30:54", "text": "そして、このように作ります。"}]
[{"type": "subtitle", "time": 24300.548, "timestamp": "06:45:00", "text": "イベントの作成もすべて順調です。それで"}, {"type": "subtitle", "time": 24303.99, "timestamp": "06:45:03", "text": "イベントの中で私がやったことは"}, {"type": "subtitle", "time": 24305.75, "timestamp": "06:45:05", "text": "もし"}, {"type": "subtitle", "time": 24309.99, "timestamp": "06:45:09", "text": "イベントは作成もマッピングもされませんでした"}, {"type": "subtitle", "time": 24314.31, "timestamp": "06:45:14", "text": "今日はストリームのようなビデオIDを"}, {"type": "subtitle", "time": 24317.91, "timestamp": "06:45:17", "text": "それを作り出すでしょう。普通はどうやって"}, {"type": "subtitle", "time": 24321.27, "timestamp": "06:45:21", "text": "このボタンは、YouTube のときに機能します"}, {"type": "subtitle", "time": 24324.15, "timestamp": "06:45:24", "text": "ストリームはデータのようにスケジュールされます"}, {"type": "subtitle", "time": 24326.708, "timestamp": "06:45:26", "text": "これから配信されるストリームから"}, {"type": "subtitle", "time": 24329.27, "timestamp": "06:45:29", "text": "このボタンを実行してチェックします"}, {"type": "subtitle", "time": 24332.628, "timestamp": "06:45:32", "text": "もし彼らがビデオを持っているなら"}, {"type": "subtitle", "time": 24334.628, "timestamp": "06:45:34", "text": "イベントIDアクセスを何と呼ぶのですか？"}, {"type": "subtitle", "time": 24339.27, "timestamp": "06:45:39", "text": "または、正しくないのは、"}, {"type": "subtitle", "time": 24341.67, "timestamp": "06:45:41", "text": "粗雑さと無能さ"}, {"type": "subtitle", "time": 24344.948, "timestamp": "06:45:44", "text": "YouTube API 今後の配信検索 API"}, {"type": "subtitle", "time": 24347.99, "timestamp": "06:45:47", "text": "時々、それが"}, {"type": "subtitle", "time": 24350.31, "timestamp": "06:45:50", "text": "現在のライブストリームを"}, {"type": "subtitle", "time": 24353.43, "timestamp": "06:45:53", "text": "近日配信予定。そのため、そのような場合には"}, {"type": "subtitle", "time": 24356.628, "timestamp": "06:45:56", "text": "だからチェックするようにしたんだ"}, {"type": "subtitle", "time": 24359.11, "timestamp": "06:45:59", "text": "たとえそれが現在のライブであっても"}]
[{"type": "subtitle", "time": 7624.87, "timestamp": "02:07:04", "text": "こんにちは、ゴクウブラック。いらっしゃいませ。あなたは何者ですか"}, {"type": "subtitle", "time": 7626.55, "timestamp": "02:07:06", "text": "何をしているの？えっと、説明欄に書いてありますよ。"}, {"type": "subtitle", "time": 7629.27, "timestamp": "02:07:09", "text": "YouTubeでご覧になっているんですよね？"}, {"type": "subtitle", "time": 7630.95, "timestamp": "02:07:10", "text": "説明文に書いてある通り、私たちは"}, {"type": "subtitle", "time": 7634.31, "timestamp": "02:07:14", "text": "今日、人々がより簡単にできることを"}, {"type": "subtitle", "time": 7636.95, "timestamp": "02:07:16", "text": "私が今日何をしているのか理解してください。"}, {"type": "subtitle", "time": 7639.91, "timestamp": "02:07:19", "text": "説明欄に書いてありますよ。それを"}, {"type": "subtitle", "time": 7643.669, "timestamp": "02:07:23", "text": "読む。それは単に自動化です"}, {"type": "subtitle", "time": 7648.39, "timestamp": "02:07:28", "text": "ライブ配信中などにDiscordで流す音楽。"}, {"type": "subtitle", "time": 7651.189, "timestamp": "02:07:31", "text": "ええ、現在私たちは"}, {"type": "subtitle", "time": 7653.27, "timestamp": "02:07:33", "text": "イベントマネージャー。"}, {"type": "subtitle", "time": 7655.75, "timestamp": "02:07:35", "text": "現在、私たちはステップ1を実行中です。"}, {"type": "subtitle", "time": 7657.43, "timestamp": "02:07:37", "text": "もの。"}, {"type": "subtitle", "time": 7659.589, "timestamp": "02:07:39", "text": "それが終わったら、ステップ2に進みます"}, {"type": "subtitle", "time": 7662.709, "timestamp": "02:07:42", "text": "もの。次にステップ3、そしてその中で"}, {"type": "subtitle", "time": 7665.91, "timestamp": "02:07:45", "text": "1時間後とか、今から1時間後とか、私が"}, {"type": "subtitle", "time": 7667.51, "timestamp": "02:07:47", "text": "イベントマネージャーを完成させて、"}, {"type": "subtitle", "time": 7670.87, "timestamp": "02:07:50", "text": "配信アナウンサー。つまり、いつでも"}, {"type": "subtitle", "time": 7672.79, "timestamp": "02:07:52", "text": "ライブ配信すると、自動的に作成されます"}, {"type": "subtitle", "time": 7675.189, "timestamp": "02:07:55", "text": "私のサーバーのメンバー向けのDiscordイベント。"}, {"type": "subtitle", "time": 7679.35, "timestamp": "02:07:59", "text": "彼らがこのイベントシステムを使用するかどうか、"}]
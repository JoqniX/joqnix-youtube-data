[{"type": "subtitle", "time": 8821.11, "timestamp": "02:27:01", "text": "では、どのように機能するかというと"}, {"type": "subtitle", "time": 8825.27, "timestamp": "02:27:05", "text": "スケジュール時間をチェックしません"}, {"type": "subtitle", "time": 8828.87, "timestamp": "02:27:08", "text": "作成日をチェックする例"}, {"type": "subtitle", "time": 8833.27, "timestamp": "02:27:13", "text": "私はまずこのストリームを作り、それから"}, {"type": "subtitle", "time": 8836.87, "timestamp": "02:27:16", "text": "このストリームですね。最初のものは常に"}, {"type": "subtitle", "time": 8839.349, "timestamp": "02:27:19", "text": "もし"}, {"type": "subtitle", "time": 8841.349, "timestamp": "02:27:21", "text": "今、未来の時間を変更します"}, {"type": "subtitle", "time": 8843.349, "timestamp": "02:27:23", "text": "スケジュール時間を変更すると"}, {"type": "subtitle", "time": 8846.469, "timestamp": "02:27:26", "text": "順序は1 2になります。"}, {"type": "subtitle", "time": 8849.19, "timestamp": "02:27:29", "text": "今すぐ新しいストリームを作成する"}, {"type": "subtitle", "time": 8851.99, "timestamp": "02:27:31", "text": "今後のスケジュール配信は"}, {"type": "subtitle", "time": 8854.87, "timestamp": "02:27:34", "text": "今は３つに分かれているが、それは私たちが"}, {"type": "subtitle", "time": 8858.71, "timestamp": "02:27:38", "text": "最新のものを最初に表示したい"}, {"type": "subtitle", "time": 8861.75, "timestamp": "02:27:41", "text": "最後の、えーっと、古いもののように"}, {"type": "subtitle", "time": 8865.11, "timestamp": "02:27:45", "text": "右下なので、ある意味では私は"}, {"type": "subtitle", "time": 8868.95, "timestamp": "02:27:48", "text": "まだ注文していない"}, {"type": "subtitle", "time": 8872.63, "timestamp": "02:27:52", "text": "YouTube ボタンでまだやってない"}, {"type": "subtitle", "time": 8875.51, "timestamp": "02:27:55", "text": "YouTubeの今後の配信について"}, {"type": "subtitle", "time": 8878.55, "timestamp": "02:27:58", "text": "修正されていません。まだ注文を修正していません。"}]
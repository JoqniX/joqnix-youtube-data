[{"type": "subtitle", "time": 5820.55, "timestamp": "01:37:00", "text": "私たちはそうしません。これは問題ありません。ああ、この人"}, {"type": "subtitle", "time": 5823.109, "timestamp": "01:37:03", "text": "しなければならない"}, {"type": "subtitle", "time": 5826.629, "timestamp": "01:37:06", "text": "今後の配信準備が整いました。おお。そうそう。私たちは"}, {"type": "subtitle", "time": 5829.35, "timestamp": "01:37:09", "text": "すべて移動しました。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 5830.87, "timestamp": "01:37:10", "text": "うん。うん。これで十分だろう。"}, {"type": "subtitle", "time": 5834.229, "timestamp": "01:37:14", "text": "これはうまくいくはずだと思う。さあ"}, {"type": "subtitle", "time": 5838.709, "timestamp": "01:37:18", "text": "メインマップに送って、どうなるか見てみよう"}, {"type": "subtitle", "time": 5841.109, "timestamp": "01:37:21", "text": "見た目はこうなります。"}, {"type": "subtitle", "time": 5879.75, "timestamp": "01:37:59", "text": "いいえ。"}]
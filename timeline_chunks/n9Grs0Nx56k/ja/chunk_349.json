[{"type": "subtitle", "time": 20951.43, "timestamp": "05:49:11", "text": "ライブカテゴリに基づいています。はい、これは"}, {"type": "subtitle", "time": 20963.51, "timestamp": "05:49:23", "text": "えーと"}, {"type": "subtitle", "time": 20965.59, "timestamp": "05:49:25", "text": "喜び。良い一日を。頑張ってね。こんにちは。"}, {"type": "subtitle", "time": 20975.296, "timestamp": "05:49:35", "text": "こんにちは。幸運を。幸運を。幸運を。"}, {"type": "subtitle", "time": 20984.548, "timestamp": "05:49:44", "text": "そんなものは必要ない。わかった。ファイルをダウンロードしています。"}, {"type": "subtitle", "time": 20987.75, "timestamp": "05:49:47", "text": "溶かすために送る。わかった。"}, {"type": "subtitle", "time": 20991.35, "timestamp": "05:49:51", "text": "Notoに送信してください。わかった。ページデータ。私"}]
[{"type": "subtitle", "time": 1321.43, "timestamp": "00:22:01", "text": "ああ、順番がめちゃくちゃ間違ってるよ。そして"}, {"type": "subtitle", "time": 1331.35, "timestamp": "00:22:11", "text": "[咳払い]"}, {"type": "subtitle", "time": 1334.71, "timestamp": "00:22:14", "text": "順番が間違っていて、私は"}, {"type": "subtitle", "time": 1337.35, "timestamp": "00:22:17", "text": "兄弟みたいに"}, {"type": "subtitle", "time": 1340.71, "timestamp": "00:22:20", "text": "なぜ間違えるのですか？"}, {"type": "subtitle", "time": 1343.19, "timestamp": "00:22:23", "text": "なぜ？"}, {"type": "subtitle", "time": 1346.71, "timestamp": "00:22:26", "text": "わかった。それで、このコードイベントを作成します。"}, {"type": "subtitle", "time": 1349.83, "timestamp": "00:22:29", "text": "スクービーベース全体チャージ"}, {"type": "subtitle", "time": 1353.35, "timestamp": "00:22:33", "text": "昨日教えてくれたんだけど、まあそんな感じ"}, {"type": "subtitle", "time": 1357.51, "timestamp": "00:22:37", "text": "その他は全て良好です"}, {"type": "subtitle", "time": 1361.27, "timestamp": "00:22:41", "text": "えっと、私はすでに全部持っています"}, {"type": "subtitle", "time": 1364.47, "timestamp": "00:22:44", "text": "全体の骨組みがあるので"}, {"type": "subtitle", "time": 1367.19, "timestamp": "00:22:47", "text": "それほど難しくないし、"}, {"type": "subtitle", "time": 1370.71, "timestamp": "00:22:50", "text": "時間がかかりすぎるので、"}, {"type": "subtitle", "time": 1373.99, "timestamp": "00:22:53", "text": "イベントが発生するかどうかを確認し、"}, {"type": "subtitle", "time": 1377.11, "timestamp": "00:22:57", "text": "もし[音楽]がイベントであれば"}]
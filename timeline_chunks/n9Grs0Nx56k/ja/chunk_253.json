[{"type": "subtitle", "time": 15198.229, "timestamp": "04:13:18", "text": "わかった。イベントを削除して試してみましょう"}, {"type": "subtitle", "time": 15201.11, "timestamp": "04:13:21", "text": "またそれだ。あ、待って、待って、待って。さあ"}, {"type": "subtitle", "time": 15203.91, "timestamp": "04:13:23", "text": "削除しないでください。私たちはそれを確認する必要がある"}, {"type": "subtitle", "time": 15207.59, "timestamp": "04:13:27", "text": "既に地図として登録されている場合は、問題なく動作しますよね？おお、"}, {"type": "subtitle", "time": 15209.349, "timestamp": "04:13:29", "text": "待って、待って、待って。うまくいかないだろう。ごめん。"}, {"type": "subtitle", "time": 15212.469, "timestamp": "04:13:32", "text": "ええと、私たちはそれを送らない 私たちは送らない"}, {"type": "subtitle", "time": 15225.11, "timestamp": "04:13:45", "text": "保存してください。"}]
[{"type": "subtitle", "time": 2640.71, "timestamp": "00:44:00", "text": "貨物の中に何か入っている。 [音楽] うん、私は"}, {"type": "subtitle", "time": 2645.03, "timestamp": "00:44:05", "text": "ただ手に入れるだけ 私はただ買うだけ 私はそれを作る"}, {"type": "subtitle", "time": 2648.95, "timestamp": "00:44:08", "text": "2000 のやつがいっぱい [笑い]"}, {"type": "subtitle", "time": 2652.87, "timestamp": "00:44:12", "text": "そして、そうやってお金を手に入れる。"}, {"type": "subtitle", "time": 2654.55, "timestamp": "00:44:14", "text": "それがより良い方法かどうかはわかりません"}, {"type": "subtitle", "time": 2656.71, "timestamp": "00:44:16", "text": "やってみてよ、でもまあね、[笑い]"}, {"type": "subtitle", "time": 2682.87, "timestamp": "00:44:42", "text": "私は貧乏です。 [笑い]"}, {"type": "subtitle", "time": 2695.75, "timestamp": "00:44:55", "text": "ああ、かわいそうなギャングボン、アローとルノのために"}]
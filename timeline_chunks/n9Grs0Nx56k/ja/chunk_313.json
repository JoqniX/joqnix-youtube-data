[{"type": "subtitle", "time": 18780.628, "timestamp": "05:13:00", "text": "ドット"}, {"type": "subtitle", "time": 18788.07, "timestamp": "05:13:08", "text": "私はそれをDiscordが存在するものとして保存します"}, {"type": "subtitle", "time": 18789.67, "timestamp": "05:13:09", "text": "参照。"}, {"type": "subtitle", "time": 18793.35, "timestamp": "05:13:13", "text": "いやいやいやいや、ええ、ええ、いいですよ、いいですよ"}, {"type": "subtitle", "time": 18796.07, "timestamp": "05:13:16", "text": "大丈夫"}, {"type": "subtitle", "time": 18800.948, "timestamp": "05:13:20", "text": "そしてそれはJSON形式に変換されて送信されます。"}, {"type": "subtitle", "time": 18804.07, "timestamp": "05:13:24", "text": "ここにJSONデータはありますか？"}, {"type": "subtitle", "time": 18811.27, "timestamp": "05:13:31", "text": "これはJSON形式です。わかった。このJSONではありません。わかった。"}, {"type": "subtitle", "time": 18817.83, "timestamp": "05:13:37", "text": "もしこれがうまくいかなかったら、私は"}, {"type": "subtitle", "time": 18823.35, "timestamp": "05:13:43", "text": "泣かないけど、それでも行きたい"}, {"type": "subtitle", "time": 18830.868, "timestamp": "05:13:50", "text": "11 減速、"}]
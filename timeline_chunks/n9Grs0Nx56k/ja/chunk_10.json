[{"type": "subtitle", "time": 602.47, "timestamp": "00:10:02", "text": "私は何をしているのだろう？"}, {"type": "subtitle", "time": 616.15, "timestamp": "00:10:16", "text": "どこにあるの"}, {"type": "subtitle", "time": 618.55, "timestamp": "00:10:18", "text": "地図も？あなたは誰ですか？何"}, {"type": "subtitle", "time": 623.99, "timestamp": "00:10:23", "text": "あなたもそう思いますか？わかった。あなたは誰ですか？あなたが誰"}, {"type": "subtitle", "time": 633.43, "timestamp": "00:10:33", "text": "こいつらは必要ない。エントリー列ではありません。"}, {"type": "subtitle", "time": 641.59, "timestamp": "00:10:41", "text": "うん。なぜそれが必要なのですか？わかった。何が"}, {"type": "subtitle", "time": 644.87, "timestamp": "00:10:44", "text": "これ？えっと、配信開始。配信が終了しました。"}, {"type": "subtitle", "time": 653.19, "timestamp": "00:10:53", "text": "[笑い]"}, {"type": "subtitle", "time": 658.87, "timestamp": "00:10:58", "text": "覚えているよ。つまり、これは"}]
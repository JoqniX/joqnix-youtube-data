[{"type": "subtitle", "time": 3421.43, "timestamp": "00:57:01", "text": "マネージャー"}, {"type": "subtitle", "time": 3426.789, "timestamp": "00:57:06", "text": "ソース。ああ、ターゲットはディスコードだ"}, {"type": "subtitle", "time": 3429.19, "timestamp": "00:57:09", "text": "スラッシュイベント"}, {"type": "subtitle", "time": 3436.15, "timestamp": "00:57:16", "text": "すべてのアップデート、そして最新のアップデートは必要ありません"}, {"type": "subtitle", "time": 3440.39, "timestamp": "00:57:20", "text": "ビデオ削除パケットとこのパケットは"}, {"type": "subtitle", "time": 3444.95, "timestamp": "00:57:24", "text": "そこまで地図に送られる"}, {"type": "subtitle", "time": 3446.47, "timestamp": "00:57:26", "text": "良い。"}, {"type": "subtitle", "time": 3449.67, "timestamp": "00:57:29", "text": "これは何ですか"}, {"type": "subtitle", "time": 3466.63, "timestamp": "00:57:46", "text": "ああ、この人は必要ないね。"}, {"type": "subtitle", "time": 3471.51, "timestamp": "00:57:51", "text": "さあ、行って行って。私たちはあなたを必要としていません。"}, {"type": "subtitle", "time": 3473.27, "timestamp": "00:57:53", "text": "パン"}, {"type": "subtitle", "time": 3476.069, "timestamp": "00:57:56", "text": "そしてP。"}]
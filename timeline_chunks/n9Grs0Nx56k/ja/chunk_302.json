[{"type": "subtitle", "time": 18143.35, "timestamp": "05:02:23", "text": "YouTube APIがなぜなのかまだわかりません"}, {"type": "subtitle", "time": 18145.91, "timestamp": "05:02:25", "text": "今後3つあると言っている"}, {"type": "subtitle", "time": 18148.55, "timestamp": "05:02:28", "text": "ストリーム。なぜ現在のこれをカウントするのか"}, {"type": "subtitle", "time": 18152.15, "timestamp": "05:02:32", "text": "現在のストリームは今後どうなるのでしょうか？なぜ？私"}, {"type": "subtitle", "time": 18155.27, "timestamp": "05:02:35", "text": "理解できない。なし。"}, {"type": "subtitle", "time": 18157.99, "timestamp": "05:02:37", "text": "消去するにはどれくらいの論理が必要ですか？"}, {"type": "subtitle", "time": 18160.708, "timestamp": "05:02:40", "text": "これ？でも大丈夫"}, {"type": "subtitle", "time": 18163.27, "timestamp": "05:02:43", "text": "YouTubeがブーイングしているからだ。私はしなければならない"}, {"type": "subtitle", "time": 18166.07, "timestamp": "05:02:46", "text": "条件付きで多くのことを行うので"}, {"type": "subtitle", "time": 18169.43, "timestamp": "05:02:49", "text": "思い通りに動作する。"}, {"type": "subtitle", "time": 18171.91, "timestamp": "05:02:51", "text": "わかった。つまり、これは正しいということです。では、コピーします"}, {"type": "subtitle", "time": 18174.868, "timestamp": "05:02:54", "text": "ボタンはそのままの状態です。"}, {"type": "subtitle", "time": 18177.83, "timestamp": "05:02:57", "text": "これを新しい折り方で折ってください。"}]
[{"type": "subtitle", "time": 3061.03, "timestamp": "00:51:01", "text": "2回。えっと、私は、えっと、私は、"}, {"type": "subtitle", "time": 3065.27, "timestamp": "00:51:05", "text": "バッジのレベル。そうそう、"}, {"type": "subtitle", "time": 3068.79, "timestamp": "00:51:08", "text": "ええ、ええ。持続する。"}, {"type": "subtitle", "time": 3071.27, "timestamp": "00:51:11", "text": "私はそれをしていません。"}, {"type": "subtitle", "time": 3074.309, "timestamp": "00:51:14", "text": "友達用ベッド、すごくかわいい。"}, {"type": "subtitle", "time": 3090.87, "timestamp": "00:51:30", "text": "私は配信しています"}, {"type": "subtitle", "time": 3104.71, "timestamp": "00:51:44", "text": "について"}, {"type": "subtitle", "time": 3107.19, "timestamp": "00:51:47", "text": "同じ"}, {"type": "subtitle", "time": 3110.069, "timestamp": "00:51:50", "text": "私も同じものをコピーします"}, {"type": "subtitle", "time": 3113.19, "timestamp": "00:51:53", "text": "このイベント"}, {"type": "subtitle", "time": 3115.03, "timestamp": "00:51:55", "text": "マネージャー"}, {"type": "subtitle", "time": 3117.03, "timestamp": "00:51:57", "text": "しかし"}]
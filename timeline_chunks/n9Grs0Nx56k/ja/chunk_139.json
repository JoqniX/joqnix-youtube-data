[{"type": "subtitle", "time": 8341.349, "timestamp": "02:19:01", "text": "2分後にイベントが作成されます。私"}, {"type": "subtitle", "time": 8343.83, "timestamp": "02:19:03", "text": "それはイベントが"}, {"type": "subtitle", "time": 8346.549, "timestamp": "02:19:06", "text": "2分後に自動的に開始します。それは"}, {"type": "subtitle", "time": 8349.27, "timestamp": "02:19:09", "text": "今ははるかに良くなった。そして残りの"}, {"type": "subtitle", "time": 8352.07, "timestamp": "02:19:12", "text": "STSは割り当てられた場所で開始します"}, {"type": "subtitle", "time": 8353.83, "timestamp": "02:19:13", "text": "時間。"}, {"type": "subtitle", "time": 8357.11, "timestamp": "02:19:17", "text": "うん。 [咳払い]"}, {"type": "subtitle", "time": 8360.79, "timestamp": "02:19:20", "text": "えっと、開始時刻をスケジュールしてください。"}, {"type": "subtitle", "time": 8375.429, "timestamp": "02:19:35", "text": "私たちはボーンレイドを全力でやっています。おお。"}, {"type": "subtitle", "time": 8378.07, "timestamp": "02:19:38", "text": "待って、今"}, {"type": "subtitle", "time": 8381.03, "timestamp": "02:19:41", "text": "私たちは今、それを実行しています。いいえ、"}, {"type": "subtitle", "time": 8382.87, "timestamp": "02:19:42", "text": "参加できたらいいのですが、"}, {"type": "subtitle", "time": 8385.27, "timestamp": "02:19:45", "text": "これを終わらせてください。大丈夫。明日、もしあなたが"}, {"type": "subtitle", "time": 8395.03, "timestamp": "02:19:55", "text": "私はそこをあまりチェックしていない"}]
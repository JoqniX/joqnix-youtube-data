[{"type": "subtitle", "time": 10875.11, "timestamp": "03:01:15", "text": "わかった。だから、これを送らなければならない"}, {"type": "subtitle", "time": 10877.269, "timestamp": "03:01:17", "text": "右。えっと"}, {"type": "subtitle", "time": 10879.429, "timestamp": "03:01:19", "text": "兄弟、私たちはますます"}, {"type": "subtitle", "time": 10881.429, "timestamp": "03:01:21", "text": "問題。"}, {"type": "subtitle", "time": 10885.67, "timestamp": "03:01:25", "text": "私には理解できません。いくつの問題がありますか"}, {"type": "subtitle", "time": 10888.309, "timestamp": "03:01:28", "text": "今、対処しなければならないことは何ですか？"}, {"type": "subtitle", "time": 10894.63, "timestamp": "03:01:34", "text": "正気の沙汰じゃない"}, {"type": "subtitle", "time": 10896.55, "timestamp": "03:01:36", "text": "状態"}, {"type": "subtitle", "time": 10899.51, "timestamp": "03:01:39", "text": "音楽のステータスのようなもの。わかった。幾つか"}, {"type": "subtitle", "time": 10908.15, "timestamp": "03:01:48", "text": "私はただ、これから来るものが必要なだけです。それだけです。"}, {"type": "subtitle", "time": 10910.63, "timestamp": "03:01:50", "text": "ただ存在すればいいのです。"}]
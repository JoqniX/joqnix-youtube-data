[{"type": "subtitle", "time": 16864.31, "timestamp": "04:41:04", "text": "兄さん、何だって？"}, {"type": "subtitle", "time": 16867.19, "timestamp": "04:41:07", "text": "何？どこ？"}, {"type": "subtitle", "time": 16870.948, "timestamp": "04:41:10", "text": "何？はぁ？"}, {"type": "subtitle", "time": 16873.59, "timestamp": "04:41:13", "text": "わかった。送信されなかったのですか？こんにちは。何？何"}, {"type": "subtitle", "time": 16874.868, "timestamp": "04:41:14", "text": "何が起こっているのか？何が起こっている？何ですか"}, {"type": "subtitle", "time": 16876.55, "timestamp": "04:41:16", "text": "ハプニング？"}, {"type": "subtitle", "time": 16880.39, "timestamp": "04:41:20", "text": "送信されなかったのか、それとも私が勘違いしているのか？"}, {"type": "subtitle", "time": 16882.31, "timestamp": "04:41:22", "text": "ここ？"}, {"type": "subtitle", "time": 16885.19, "timestamp": "04:41:25", "text": "番組スケジュール。ええ、ここにありますよ。"}, {"type": "subtitle", "time": 16887.91, "timestamp": "04:41:27", "text": "Mをディスクへ。ええ、あなたはここにいます。"}, {"type": "subtitle", "time": 16891.35, "timestamp": "04:41:31", "text": "未定義。定義されていないのは誰ですか？"}, {"type": "subtitle", "time": 16893.99, "timestamp": "04:41:33", "text": "何？"}, {"type": "subtitle", "time": 16907.27, "timestamp": "04:41:47", "text": "Undefinedでさえ、ここにはそれがありません。"}, {"type": "subtitle", "time": 16910.788, "timestamp": "04:41:50", "text": "何？何が起こっているのか？"}, {"type": "subtitle", "time": 16915.43, "timestamp": "04:41:55", "text": "何？何？私はどこで間違ったのだろうか？"}]
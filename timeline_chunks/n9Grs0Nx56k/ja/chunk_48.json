[{"type": "subtitle", "time": 2880.71, "timestamp": "00:48:00", "text": "え、何？本当に？"}, {"type": "subtitle", "time": 2905.829, "timestamp": "00:48:25", "text": "それで、"}, {"type": "subtitle", "time": 2908.47, "timestamp": "00:48:28", "text": "そして、テンペストのモーの鉄火蟹。"}, {"type": "subtitle", "time": 2910.79, "timestamp": "00:48:30", "text": "ああ。"}, {"type": "subtitle", "time": 2917.67, "timestamp": "00:48:37", "text": "もっと。"}, {"type": "subtitle", "time": 2920.87, "timestamp": "00:48:40", "text": "それはいいですね。"}, {"type": "subtitle", "time": 2924.47, "timestamp": "00:48:44", "text": "ああ、ムクを手に入れたんだね。おお、"}, {"type": "subtitle", "time": 2931.43, "timestamp": "00:48:51", "text": "待って、君はどのクラスでプレイしてたの？"}, {"type": "subtitle", "time": 2934.47, "timestamp": "00:48:54", "text": "また？明るい。私のことが嫌いみたい。ボー"}]
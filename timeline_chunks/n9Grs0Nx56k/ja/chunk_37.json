[{"type": "subtitle", "time": 2224.15, "timestamp": "00:37:04", "text": "ゆっくり休んでね、ダイアナ。ゆっくり休んでください。"}, {"type": "subtitle", "time": 2226.71, "timestamp": "00:37:06", "text": "ゆっくり休んでください"}, {"type": "subtitle", "time": 2229.829, "timestamp": "00:37:09", "text": "そしてリラックスしてください。 D、"}, {"type": "subtitle", "time": 2232.55, "timestamp": "00:37:12", "text": "今日はブループロトコルをプレイしましたか？"}, {"type": "subtitle", "time": 2234.79, "timestamp": "00:37:14", "text": "あなたのメッセージを見たと思います。私は飛び跳ねた"}, {"type": "subtitle", "time": 2237.91, "timestamp": "00:37:17", "text": "5分くらいだけ。えっと、ただ"}, {"type": "subtitle", "time": 2240.79, "timestamp": "00:37:20", "text": "チェック。"}, {"type": "subtitle", "time": 2242.95, "timestamp": "00:37:22", "text": "えっと、あなたのメッセージを見たと思うのですが"}, {"type": "subtitle", "time": 2245.99, "timestamp": "00:37:25", "text": "ギルドチャット。"}, {"type": "subtitle", "time": 2250.39, "timestamp": "00:37:30", "text": "不安定なギルドをクリアしました"}, {"type": "subtitle", "time": 2254.63, "timestamp": "00:37:34", "text": "色々あって、辞めました。 [音楽] 試してみます、ああ、"}, {"type": "subtitle", "time": 2257.75, "timestamp": "00:37:37", "text": "ミステリーショッパーのことを忘れていました。する必要がある"}, {"type": "subtitle", "time": 2260.15, "timestamp": "00:37:40", "text": "夜にやります。"}, {"type": "subtitle", "time": 2263.696, "timestamp": "00:37:43", "text": "トランスジェンダーの謎が止まった。"}, {"type": "subtitle", "time": 2268.95, "timestamp": "00:37:48", "text": "やらなきゃいけないことが山ほどある。何かありますか？"}, {"type": "subtitle", "time": 2273.27, "timestamp": "00:37:53", "text": "サーバー内で発生しているイベント？私 私 私"}, {"type": "subtitle", "time": 2276.069, "timestamp": "00:37:56", "text": "どのイベントにも参加できなかったよ。私"}, {"type": "subtitle", "time": 2279.589, "timestamp": "00:37:59", "text": "とても申し訳ない気持ちです。"}]
[{"type": "subtitle", "time": 16627.51, "timestamp": "04:37:07", "text": "うん。うん。うん。ここにあります。"}, {"type": "subtitle", "time": 16629.429, "timestamp": "04:37:09", "text": "ああ、いや、いや、いや。あ、待って。ここにはない。"}, {"type": "subtitle", "time": 16635.029, "timestamp": "04:37:15", "text": "手動でやるよ、兄弟。何"}, {"type": "subtitle", "time": 16677.99, "timestamp": "04:37:57", "text": "ファイルパスはスラッシュで区切る必要があります"}]
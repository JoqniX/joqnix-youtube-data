[{"type": "subtitle", "time": 1818.23, "timestamp": "00:30:18", "text": "スケジュール開始。えっと"}, {"type": "subtitle", "time": 1821.75, "timestamp": "00:30:21", "text": "そう、Twitchのやつ。 Twitch形式。"}, {"type": "subtitle", "time": 1824.87, "timestamp": "00:30:24", "text": "えっと、ボタンをゲット。"}, {"type": "subtitle", "time": 1838.63, "timestamp": "00:30:38", "text": "スケジュールパスとスケジュールストリームの開始"}, {"type": "subtitle", "time": 1842.63, "timestamp": "00:30:42", "text": "時間とともに、それはここにあり、これは"}, {"type": "subtitle", "time": 1845.99, "timestamp": "00:30:45", "text": "変数名を「開始時間」とする"}, {"type": "subtitle", "time": 1853.83, "timestamp": "00:30:53", "text": "大丈夫。ダウンロードを開始します。"}]
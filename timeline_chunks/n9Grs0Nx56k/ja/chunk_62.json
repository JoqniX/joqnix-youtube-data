[{"type": "subtitle", "time": 3725.43, "timestamp": "01:02:05", "text": "そこで私は現在の"}, {"type": "subtitle", "time": 3727.91, "timestamp": "01:02:07", "text": "現在の開始"}, {"type": "subtitle", "time": 3730.069, "timestamp": "01:02:10", "text": "現在"}, {"type": "subtitle", "time": 3736.15, "timestamp": "01:02:16", "text": "えーと現在の時刻"}, {"type": "subtitle", "time": 3739.349, "timestamp": "01:02:19", "text": "現在時刻を使用してください。"}, {"type": "subtitle", "time": 3741.589, "timestamp": "01:02:21", "text": "もし"}, {"type": "subtitle", "time": 3751.109, "timestamp": "01:02:31", "text": "ええ、私たちは何かを作り出すことに集中します。"}, {"type": "subtitle", "time": 3753.19, "timestamp": "01:02:33", "text": "それからパッチ作業を行い、"}, {"type": "subtitle", "time": 3755.829, "timestamp": "01:02:35", "text": "削除するもの。"}, {"type": "subtitle", "time": 3763.43, "timestamp": "01:02:43", "text": "ふむ。今後の配信シナリオ"}, {"type": "subtitle", "time": 3765.27, "timestamp": "01:02:45", "text": "スケジュールスターはこれを一度も手に入れたことがなかった"}, {"type": "subtitle", "time": 3767.43, "timestamp": "01:02:47", "text": "作られたが、その後、あなたは人生を生きる"}, {"type": "subtitle", "time": 3769.99, "timestamp": "01:02:49", "text": "ステータスはライブスケジュール時間と同じです"}, {"type": "subtitle", "time": 3772.309, "timestamp": "01:02:52", "text": "過去。はい。"}, {"type": "subtitle", "time": 3775.51, "timestamp": "01:02:55", "text": "ええ、100 の場合はエラーが表示されます"}, {"type": "subtitle", "time": 3777.43, "timestamp": "01:02:57", "text": "なぜなら"}, {"type": "subtitle", "time": 3779.67, "timestamp": "01:02:59", "text": "それは将来必ず起こることだ。の"}]
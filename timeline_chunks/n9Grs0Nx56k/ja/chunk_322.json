[{"type": "subtitle", "time": 19320.23, "timestamp": "05:22:00", "text": "それらの顔とあまり違いはなく、"}, {"type": "subtitle", "time": 19322.628, "timestamp": "05:22:02", "text": "これは学校に行く人たちのために私がやったことです。"}, {"type": "subtitle", "time": 19324.678, "timestamp": "05:22:04", "text": "え、何？ [笑い]"}, {"type": "subtitle", "time": 19325.67, "timestamp": "05:22:05", "text": "[息を呑む]"}, {"type": "subtitle", "time": 19327.99, "timestamp": "05:22:07", "text": "うん。だから私は、"}, {"type": "subtitle", "time": 19331.67, "timestamp": "05:22:11", "text": "これ。もし私が両方で成功できれば"}, {"type": "subtitle", "time": 19336.628, "timestamp": "05:22:16", "text": "これらのうち、そう、私の今後の作品も"}, {"type": "subtitle", "time": 19340.55, "timestamp": "05:22:20", "text": "ストリーム埋め込み機能も再び改良されました。"}, {"type": "subtitle", "time": 19342.39, "timestamp": "05:22:22", "text": "これも機能するはずですが、"}, {"type": "subtitle", "time": 19346.47, "timestamp": "05:22:26", "text": "壊れた。後で取り組みます。まあ、そうですね。"}, {"type": "subtitle", "time": 19349.83, "timestamp": "05:22:29", "text": "こんにちは。今これを機能させることができれば、"}, {"type": "subtitle", "time": 19352.39, "timestamp": "05:22:32", "text": "全てをアップデートしてください。"}, {"type": "subtitle", "time": 19356.708, "timestamp": "05:22:36", "text": "[ため息をつき、息を呑む] うん、更新できるよ"}, {"type": "subtitle", "time": 19359.59, "timestamp": "05:22:39", "text": "すべて。想像してみて、想像してみて"}, {"type": "subtitle", "time": 19362.868, "timestamp": "05:22:42", "text": "私はチャットログシステムを持っています。"}, {"type": "subtitle", "time": 19364.868, "timestamp": "05:22:44", "text": "右？来た人みんなと同じように"}, {"type": "subtitle", "time": 19367.83, "timestamp": "05:22:47", "text": "ストリームでは、ここにログが記録されます。"}, {"type": "subtitle", "time": 19371.35, "timestamp": "05:22:51", "text": "YouTube、Twitch、みんなここにいるよ。"}, {"type": "subtitle", "time": 19374.23, "timestamp": "05:22:54", "text": "右？でも私は決してリンクしません。ええ、あなたは"}, {"type": "subtitle", "time": 19376.788, "timestamp": "05:22:56", "text": "ネイトもここにいるよ。でも私は決してそれを"}]
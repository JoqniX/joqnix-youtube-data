[{"type": "subtitle", "time": 14343.83, "timestamp": "03:59:03", "text": "そこで私たちは何を見ているのか"}, {"type": "subtitle", "time": 14352.15, "timestamp": "03:59:12", "text": "えーと地元の"}, {"type": "subtitle", "time": 14355.269, "timestamp": "03:59:15", "text": "地元の人ならではの魅力。わかった。それは存在した。それは"}, {"type": "subtitle", "time": 14357.67, "timestamp": "03:59:17", "text": "アクセス"}, {"type": "subtitle", "time": 14363.269, "timestamp": "03:59:23", "text": "ローカルサムパス。ローカルダンプパス。"}, {"type": "subtitle", "time": 14366.15, "timestamp": "03:59:26", "text": "H. それは正しいです。では、"}, {"type": "subtitle", "time": 14395.75, "timestamp": "03:59:55", "text": "チャット。はい、VRチャットは終了しました。"}, {"type": "subtitle", "time": 14399.349, "timestamp": "03:59:59", "text": "ボタンが失敗しました"}]
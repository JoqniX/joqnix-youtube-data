[{"type": "subtitle", "time": 22925.67, "timestamp": "06:22:05", "text": "存在しないので右にスキップします。それで、えっと、"}, {"type": "subtitle", "time": 22927.83, "timestamp": "06:22:07", "text": "存在しない場合は、新しいものを作成します"}, {"type": "subtitle", "time": 22930.788, "timestamp": "06:22:10", "text": "1つですよね？だから、私はこう表現したのです"}, {"type": "subtitle", "time": 22934.868, "timestamp": "06:22:14", "text": "今。それが正しいことを願っています。"}, {"type": "subtitle", "time": 22937.59, "timestamp": "06:22:17", "text": "ああ、兄弟、俺は自分のやり方を直さなきゃ"}, {"type": "subtitle", "time": 22941.99, "timestamp": "06:22:21", "text": "話し中。まるで、私が喋りまくっているみたい。"}]
[{"type": "subtitle", "time": 23448.07, "timestamp": "06:30:48", "text": "発売されたとき、私がそれを聴いたとき、"}, {"type": "subtitle", "time": 23450.15, "timestamp": "06:30:50", "text": "私はこれにすっかり夢中になった"}, {"type": "subtitle", "time": 23453.43, "timestamp": "06:30:53", "text": "歌だよ、男。私は「うん、行こう」って感じだった。"}, {"type": "subtitle", "time": 23456.948, "timestamp": "06:30:56", "text": "ああ、私もその歌を歌えるようになりたい。"}]
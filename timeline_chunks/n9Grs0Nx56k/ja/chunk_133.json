[{"type": "subtitle", "time": 7982.31, "timestamp": "02:13:02", "text": "うん。ほら、私がアップロードすると、"}, {"type": "subtitle", "time": 7985.51, "timestamp": "02:13:05", "text": "やってみて。だから私は以前はSafire Bだけを使っていた"}, {"type": "subtitle", "time": 7989.669, "timestamp": "02:13:09", "text": "Vチャンネルのアップロード専用です。"}, {"type": "subtitle", "time": 7993.91, "timestamp": "02:13:13", "text": "普通のことでイライラする。続けた"}, {"type": "subtitle", "time": 7995.83, "timestamp": "02:13:15", "text": "ピング、ピング、その他いろいろ。何ですか"}, {"type": "subtitle", "time": 7998.55, "timestamp": "02:13:18", "text": "私のマウスに何が起こっているのですか？"}, {"type": "subtitle", "time": 8001.589, "timestamp": "02:13:21", "text": "そうそう。ああ、これだ。いいえ、サファイアの"}, {"type": "subtitle", "time": 8004.149, "timestamp": "02:13:24", "text": "Twitchの通知機能は本当に素晴らしい。による"}, {"type": "subtitle", "time": 8007.75, "timestamp": "02:13:27", "text": "そう、私は、これがインスピレーションを与えてくれた"}, {"type": "subtitle", "time": 8010.069, "timestamp": "02:13:30", "text": "私が発表をするために。右"}, {"type": "subtitle", "time": 8013.589, "timestamp": "02:13:33", "text": "今、私が今していることは"}, {"type": "subtitle", "time": 8016.39, "timestamp": "02:13:36", "text": "ストリーム配信中、そして私がライブ配信しているとき、"}, {"type": "subtitle", "time": 8019.589, "timestamp": "02:13:39", "text": "Twitchの埋め込み機能は完璧に動作します。のように"}, {"type": "subtitle", "time": 8021.35, "timestamp": "02:13:41", "text": "ライブ配信中は、"}, {"type": "subtitle", "time": 8024.95, "timestamp": "02:13:44", "text": "ストリームの動的なサムネイル。"}, {"type": "subtitle", "time": 8028.79, "timestamp": "02:13:48", "text": "うん。ええ、終わったら"}, {"type": "subtitle", "time": 8031.51, "timestamp": "02:13:51", "text": "ストリームが終了すると、それがそれを編集します。"}, {"type": "subtitle", "time": 8033.83, "timestamp": "02:13:53", "text": "それがどのカテゴリーだったかを教えてくれます"}, {"type": "subtitle", "time": 8036.709, "timestamp": "02:13:56", "text": "ストリームがストリーミングされ、V。いくつ"}, {"type": "subtitle", "time": 8038.87, "timestamp": "02:13:58", "text": "何時間も配信して、"}]
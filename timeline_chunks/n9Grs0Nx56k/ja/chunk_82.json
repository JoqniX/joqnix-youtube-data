[{"type": "subtitle", "time": 4926.87, "timestamp": "01:22:06", "text": "今日は絶好調だ。日本語は使用できません"}, {"type": "subtitle", "time": 4930.629, "timestamp": "01:22:10", "text": "衝突。えっと、私の先生は、えっと"}, {"type": "subtitle", "time": 4934.39, "timestamp": "01:22:14", "text": "病気。 17日から授業が始まります"}, {"type": "subtitle", "time": 4936.87, "timestamp": "01:22:16", "text": "日曜日。ええ、日曜日は授業がありますよ。"}, {"type": "subtitle", "time": 4939.27, "timestamp": "01:22:19", "text": "ああ、夕方の小川も流れていない"}, {"type": "subtitle", "time": 4941.27, "timestamp": "01:22:21", "text": "残念ながら日曜日。"}, {"type": "subtitle", "time": 4945.43, "timestamp": "01:22:25", "text": "うん。そうそう。ということで、2日間の休みです。いいえ"}, {"type": "subtitle", "time": 4947.03, "timestamp": "01:22:27", "text": "クラス。それで、私はストリーミング配信をします"}, {"type": "subtitle", "time": 4950.07, "timestamp": "01:22:30", "text": "夕方、だいたいこの時間帯。"}, {"type": "subtitle", "time": 4963.91, "timestamp": "01:22:43", "text": "ああ、17日は月曜日だ。え、何？"}, {"type": "subtitle", "time": 4966.47, "timestamp": "01:22:46", "text": "ああ、16日か。ごめん。ごめん。 16日。そうそう。"}]
[{"type": "subtitle", "time": 3782.23, "timestamp": "01:03:02", "text": "スケジュール開始時刻"}, {"type": "subtitle", "time": 3784.549, "timestamp": "01:03:04", "text": "現在開催中のイベントについて。セットを設定する必要があります"}, {"type": "subtitle", "time": 3788.23, "timestamp": "01:03:08", "text": "エンティティタイプを1に変更する。わかった。私たちはしなければなりません"}, {"type": "subtitle", "time": 3790.39, "timestamp": "01:03:10", "text": "これを自動的に検出して調整します"}, {"type": "subtitle", "time": 3792.95, "timestamp": "01:03:12", "text": "行動"}, {"type": "subtitle", "time": 3795.829, "timestamp": "01:03:15", "text": "見せる"}, {"type": "subtitle", "time": 3798.87, "timestamp": "01:03:18", "text": "配信は現在ライブ配信中です"}, {"type": "subtitle", "time": 3801.589, "timestamp": "01:03:21", "text": "既存のDiscord IDは、"}, {"type": "subtitle", "time": 3804.069, "timestamp": "01:03:24", "text": "作成され、開始時刻は"}, {"type": "subtitle", "time": 3807.67, "timestamp": "01:03:27", "text": "パスワード。わかった。ストリームアプリの使用時間"}, {"type": "subtitle", "time": 3809.589, "timestamp": "01:03:29", "text": "Discordの開始タイムスタンプとしてスタンプする"}, {"type": "subtitle", "time": 3812.069, "timestamp": "01:03:32", "text": "ストリームは既に開始されています。それで"}, {"type": "subtitle", "time": 3814.63, "timestamp": "01:03:34", "text": "代わりに、今は、そう、まさに"}, {"type": "subtitle", "time": 3816.87, "timestamp": "01:03:36", "text": "それ。わかった。"}, {"type": "subtitle", "time": 3817.829, "timestamp": "01:03:37", "text": "条件付き。"}, {"type": "subtitle", "time": 3819.75, "timestamp": "01:03:39", "text": "わかった。"}, {"type": "subtitle", "time": 3823.67, "timestamp": "01:03:43", "text": "ストリームが現在ライブ配信中の場合"}, {"type": "subtitle", "time": 3826.95, "timestamp": "01:03:46", "text": "いいえ。わかった。"}, {"type": "subtitle", "time": 3829.349, "timestamp": "01:03:49", "text": "サミーの擬似コード。何が何が"}, {"type": "subtitle", "time": 3833.829, "timestamp": "01:03:53", "text": "パスド（sudo）のコード？それは何ですか？何が"}, {"type": "subtitle", "time": 3839.67, "timestamp": "01:03:59", "text": "ぷどコード。平易な言葉での説明"}]
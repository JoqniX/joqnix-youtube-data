[{"type": "subtitle", "time": 21903.51, "timestamp": "06:05:03", "text": "イベントIDが存在する場合でも、存在しない、存在しない"}, {"type": "subtitle", "time": 21907.11, "timestamp": "06:05:07", "text": "存在するとイベントが作成されるので"}, {"type": "subtitle", "time": 21910.15, "timestamp": "06:05:10", "text": "それがどのようにその物を作り出すか、"}, {"type": "subtitle", "time": 21914.47, "timestamp": "06:05:14", "text": "作成ロジックもパッチします"}, {"type": "subtitle", "time": 21918.628, "timestamp": "06:05:18", "text": "イベントIDを使用してサムネイルを作成します。"}, {"type": "subtitle", "time": 21921.03, "timestamp": "06:05:21", "text": "右？それが作成ロジックの仕組みです。"}, {"type": "subtitle", "time": 21923.91, "timestamp": "06:05:23", "text": "それはイベントを作り、パッチします"}, {"type": "subtitle", "time": 21927.11, "timestamp": "06:05:27", "text": "サムネイルのためだけに、それからえーと"}, {"type": "subtitle", "time": 21931.43, "timestamp": "06:05:31", "text": "ループを繰り返すループを終える"}, {"type": "subtitle", "time": 21934.868, "timestamp": "06:05:34", "text": "適切な数のストリームが存在します。それで"}, {"type": "subtitle", "time": 21939.35, "timestamp": "06:05:39", "text": "私が考えていたのは、もし存在するなら"}, {"type": "subtitle", "time": 21943.99, "timestamp": "06:05:43", "text": "Discord IDは存在しません"}, {"type": "subtitle", "time": 21946.788, "timestamp": "06:05:46", "text": "つまり、存在するということです"}, {"type": "subtitle", "time": 21951.35, "timestamp": "06:05:51", "text": "私は確認したかった"}, {"type": "subtitle", "time": 21954.31, "timestamp": "06:05:54", "text": "動画IDをもう一度確認します。同じことをします。"}, {"type": "subtitle", "time": 21957.91, "timestamp": "06:05:57", "text": "またループに陥っているのかも"}]
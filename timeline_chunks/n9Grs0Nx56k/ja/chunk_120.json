[{"type": "subtitle", "time": 7200.39, "timestamp": "02:00:00", "text": "ギルドIDまたはIDが必要です。ええ、ただ"}, {"type": "subtitle", "time": 7202.47, "timestamp": "02:00:02", "text": "ID。ギルドIDは必要ありません。"}, {"type": "subtitle", "time": 7204.95, "timestamp": "02:00:04", "text": "ギルドIDは私のサーバーIDです。それは、それは"}, {"type": "subtitle", "time": 7210.229, "timestamp": "02:00:10", "text": "ID"}, {"type": "subtitle", "time": 7212.55, "timestamp": "02:00:12", "text": "１、２、３。ああ、名前は"}, {"type": "subtitle", "time": 7233.91, "timestamp": "02:00:33", "text": "ああ、名前が必要だ。"}]
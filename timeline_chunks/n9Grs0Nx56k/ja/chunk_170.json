[{"type": "subtitle", "time": 10200.95, "timestamp": "02:50:00", "text": "えっと、待って。繰り返す。"}, {"type": "subtitle", "time": 10216.23, "timestamp": "02:50:16", "text": "現在のライブ配信は含まれません。それで"}, {"type": "subtitle", "time": 10220.79, "timestamp": "02:50:20", "text": "インデックスはこれを実行します。二。兄弟、私は"}, {"type": "subtitle", "time": 10223.59, "timestamp": "02:50:23", "text": "3点を入れる。"}, {"type": "subtitle", "time": 10226.15, "timestamp": "02:50:26", "text": "最後のライブストリームを統一しました。"}, {"type": "subtitle", "time": 10228.95, "timestamp": "02:50:28", "text": "これからやってくる兄弟を通して。そうじゃない。おお"}, {"type": "subtitle", "time": 10250.309, "timestamp": "02:50:50", "text": "私はただ本当にああ。おお。ああ、それは"}, {"type": "subtitle", "time": 10259.83, "timestamp": "02:50:59", "text": "なぜ私の今後の配信は？"}]
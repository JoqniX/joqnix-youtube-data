[{"type": "subtitle", "time": 18548.15, "timestamp": "05:09:08", "text": "何てことだ、"}, {"type": "subtitle", "time": 18550.868, "timestamp": "05:09:10", "text": "兄弟。"}, {"type": "subtitle", "time": 18565.35, "timestamp": "05:09:25", "text": "いや、待って、待って、待って。掃除をしましょう"}, {"type": "subtitle", "time": 18567.03, "timestamp": "05:09:27", "text": "1つ。きれいなものを作ろう。さあ"}, {"type": "subtitle", "time": 18568.788, "timestamp": "05:09:28", "text": "実際にきれいなものを作ってください。いや、いや、いや、いや。"}, {"type": "subtitle", "time": 18571.03, "timestamp": "05:09:31", "text": "私はそれを受け取れませんでした。私は受け取らない"}, {"type": "subtitle", "time": 18595.35, "timestamp": "05:09:55", "text": "まず第一に"}, {"type": "subtitle", "time": 18598.07, "timestamp": "05:09:58", "text": "パケットを送信します。"}]
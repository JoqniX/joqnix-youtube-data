[{"type": "subtitle", "time": 19755.99, "timestamp": "05:29:15", "text": "この正体不明の男が誰なのかは知らない。"}, {"type": "subtitle", "time": 19757.67, "timestamp": "05:29:17", "text": "しかしそれ以外は全て"}, {"type": "subtitle", "time": 19759.43, "timestamp": "05:29:19", "text": "働く。"}, {"type": "subtitle", "time": 19761.43, "timestamp": "05:29:21", "text": "なぜそうなっているのかわかりません"}, {"type": "subtitle", "time": 19773.19, "timestamp": "05:29:33", "text": "はい、それで大丈夫です。さあ、テストしてみよう"}, {"type": "subtitle", "time": 19778.07, "timestamp": "05:29:38", "text": "もし私のイベントマネージャーが無視するなら"}, {"type": "subtitle", "time": 19781.11, "timestamp": "05:29:41", "text": "それは[鼻を鳴らす]"}, {"type": "subtitle", "time": 19784.39, "timestamp": "05:29:44", "text": "ああ、そこだ。"}, {"type": "subtitle", "time": 19787.27, "timestamp": "05:29:47", "text": "ええと、それでは実行してみます。えっと、どこにあるの"}, {"type": "subtitle", "time": 19790.47, "timestamp": "05:29:50", "text": "これ？ええ、私たちは見ています。走るつもりです"}, {"type": "subtitle", "time": 19799.83, "timestamp": "05:29:59", "text": "イベントIDを探しています。地図に載っていません。"}]
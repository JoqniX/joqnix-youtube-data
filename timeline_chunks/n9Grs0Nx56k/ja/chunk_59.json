[{"type": "subtitle", "time": 3541.349, "timestamp": "00:59:01", "text": "サブオブジェクトはそれらすべてを作成します"}, {"type": "subtitle", "time": 3568.47, "timestamp": "00:59:28", "text": "1回のアップデート。"}, {"type": "subtitle", "time": 3570.789, "timestamp": "00:59:30", "text": "あのね？君、この男は、"}, {"type": "subtitle", "time": 3573.829, "timestamp": "00:59:33", "text": "自分。私たちは頂点まで登り詰めるつもりだ。"}, {"type": "subtitle", "time": 3575.91, "timestamp": "00:59:35", "text": "わかった。"}, {"type": "subtitle", "time": 3578.309, "timestamp": "00:59:38", "text": "頂点まで。そしてあなたは行く"}, {"type": "subtitle", "time": 3584.95, "timestamp": "00:59:44", "text": "そして、家族の支えも必要になるでしょう。それで"}, {"type": "subtitle", "time": 3587.91, "timestamp": "00:59:47", "text": "すべてのアップデート"}, {"type": "subtitle", "time": 3592.87, "timestamp": "00:59:52", "text": "そして更新パケット。アップデート"}, {"type": "subtitle", "time": 3594.87, "timestamp": "00:59:54", "text": "パケット。"}, {"type": "subtitle", "time": 3598.069, "timestamp": "00:59:58", "text": "名前が正しいことを確認してください。"}]
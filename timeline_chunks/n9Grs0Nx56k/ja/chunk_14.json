[{"type": "subtitle", "time": 842.23, "timestamp": "00:14:02", "text": "彼らのタイムゾーンに基づいて歓迎します"}, {"type": "subtitle", "time": 845.99, "timestamp": "00:14:05", "text": "例えば、こんにちは、ジョックさん、もし"}, {"type": "subtitle", "time": 848.47, "timestamp": "00:14:08", "text": "私にとって夜は、こんにちはと言うでしょう"}, {"type": "subtitle", "time": 851.509, "timestamp": "00:14:11", "text": "次はジョック、ストリームへようこそ。"}, {"type": "subtitle", "time": 853.75, "timestamp": "00:14:13", "text": "良い夜を、とかそんな感じ"}, {"type": "subtitle", "time": 856.31, "timestamp": "00:14:16", "text": "ユーザーに基づいた自動応答"}, {"type": "subtitle", "time": 857.829, "timestamp": "00:14:17", "text": "時間"}, {"type": "subtitle", "time": 859.75, "timestamp": "00:14:19", "text": "でも今は全部壊れてしまったので、"}, {"type": "subtitle", "time": 862.71, "timestamp": "00:14:22", "text": "それら全てを刷新する。それから私は他に何をしたのか"}, {"type": "subtitle", "time": 864.55, "timestamp": "00:14:24", "text": "作業中ですか？"}, {"type": "subtitle", "time": 867.829, "timestamp": "00:14:27", "text": "サミーは永遠に使えるだろう。 [笑い]"}, {"type": "subtitle", "time": 869.43, "timestamp": "00:14:29", "text": "ああ、気が散ってきた。はい、戻ります"}, {"type": "subtitle", "time": 872.629, "timestamp": "00:14:32", "text": "働く。ちょっと待って。ごめん。戻る"}, {"type": "subtitle", "time": 883.829, "timestamp": "00:14:43", "text": "基本的には、生活の質に関わる事柄ですね。"}, {"type": "subtitle", "time": 888.79, "timestamp": "00:14:48", "text": "まだ終わっていない。私はただ自分の"}, {"type": "subtitle", "time": 894.069, "timestamp": "00:14:54", "text": "ボタン。だから、見た目がすっきりするんです。"}, {"type": "subtitle", "time": 897.35, "timestamp": "00:14:57", "text": "配信で発表するよ"}]
[{"type": "subtitle", "time": 1381.51, "timestamp": "00:23:01", "text": "イベントが実行されている場合は、実行したい"}, {"type": "subtitle", "time": 1384.47, "timestamp": "00:23:04", "text": "それ"}, {"type": "subtitle", "time": 1388.23, "timestamp": "00:23:08", "text": "えっと、イベントが実行されている場合は、"}, {"type": "subtitle", "time": 1390.87, "timestamp": "00:23:10", "text": "アップデートなどが継続的に行われることを望んでいます。"}, {"type": "subtitle", "time": 1394.31, "timestamp": "00:23:14", "text": "それが、私たちがこれから行うことです。こんにちは。それで"}, {"type": "subtitle", "time": 1397.19, "timestamp": "00:23:17", "text": "今日はまず最初に"}, {"type": "subtitle", "time": 1401.19, "timestamp": "00:23:21", "text": "最初のストリームは4時間5時間でした"}, {"type": "subtitle", "time": 1403.43, "timestamp": "00:23:23", "text": "音楽みたいになるよ、あ、待って、"}, {"type": "subtitle", "time": 1407.51, "timestamp": "00:23:27", "text": "最大9時間までですが、ええ、"}, {"type": "subtitle", "time": 1409.27, "timestamp": "00:23:29", "text": "まず最初の3時間は"}, {"type": "subtitle", "time": 1412.07, "timestamp": "00:23:32", "text": "イベント作成に焦点を当てる"}, {"type": "subtitle", "time": 1415.19, "timestamp": "00:23:35", "text": "そして次に私たちは"}, {"type": "subtitle", "time": 1430.799, "timestamp": "00:23:50", "text": "は 無能を封印する時が来た。"}]
[{"type": "subtitle", "time": 24420.948, "timestamp": "06:47:00", "text": "私はアイデアを得ようとしています"}, {"type": "subtitle", "time": 24424.548, "timestamp": "06:47:04", "text": "何が変わったかとか、そういうことですよね？"}, {"type": "subtitle", "time": 24426.468, "timestamp": "06:47:06", "text": "だから、これが良いアイデアだといいのですが"}, {"type": "subtitle", "time": 24430.15, "timestamp": "06:47:10", "text": "引き離す。疑問符。"}, {"type": "subtitle", "time": 24440.868, "timestamp": "06:47:20", "text": "待って。では、私が今言ったことを踏まえて"}, {"type": "subtitle", "time": 24444.39, "timestamp": "06:47:24", "text": "作成ロジックでは、ストリームがライブの場合、"}, {"type": "subtitle", "time": 24447.67, "timestamp": "06:47:27", "text": "Discordイベントは作成されていません。私ができること"}, {"type": "subtitle", "time": 24451.91, "timestamp": "06:47:31", "text": "ここでやるべきことは、ローカル変数を作成することです。"}, {"type": "subtitle", "time": 24455.03, "timestamp": "06:47:35", "text": "と言っている"}, {"type": "subtitle", "time": 24457.35, "timestamp": "06:47:37", "text": "ライブ"}, {"type": "subtitle", "time": 24462.788, "timestamp": "06:47:42", "text": "待って。"}, {"type": "subtitle", "time": 24468.548, "timestamp": "06:47:48", "text": "現在"}, {"type": "subtitle", "time": 24471.83, "timestamp": "06:47:51", "text": "ライブビデオ"}, {"type": "subtitle", "time": 24471.92, "timestamp": "06:47:51", "text": "医学ビデオ医学ビデオ医学ビデオ医学ビデオ 医療ビデオ 医療ビデオメディア"}, {"type": "subtitle", "time": 24474.16, "timestamp": "06:47:54", "text": "医療ビデオ 医療ビデオメディア えっと、DC"}, {"type": "subtitle", "time": 24476.798, "timestamp": "06:47:56", "text": "えっと、DC この神でさえ"}, {"type": "subtitle", "time": 24479.52, "timestamp": "06:47:59", "text": "この神でさえ 作成済み"}]
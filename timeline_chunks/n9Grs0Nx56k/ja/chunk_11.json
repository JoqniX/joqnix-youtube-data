[{"type": "subtitle", "time": 663.19, "timestamp": "00:11:03", "text": "私が"}, {"type": "subtitle", "time": 665.509, "timestamp": "00:11:05", "text": "これは私のスタッフに贈られるものだと思います"}, {"type": "subtitle", "time": 668.31, "timestamp": "00:11:08", "text": "チャンネル、例えばこれらの1つは私の"}, {"type": "subtitle", "time": 671.372, "timestamp": "00:11:11", "text": "スタッフチャンネル スタッフチャンネル。それで、"}, {"type": "subtitle", "time": 671.91, "timestamp": "00:11:11", "text": "[音楽]"}, {"type": "subtitle", "time": 674.87, "timestamp": "00:11:14", "text": "ストリームを終了するたびに、"}, {"type": "subtitle", "time": 677.99, "timestamp": "00:11:17", "text": "レポートのようなものを出力します。"}, {"type": "subtitle", "time": 679.75, "timestamp": "00:11:19", "text": "配信タイトルは何でしたか？小川"}, {"type": "subtitle", "time": 681.59, "timestamp": "00:11:21", "text": "長さ、今日どこでストリーミングしたか、"}, {"type": "subtitle", "time": 685.269, "timestamp": "00:11:25", "text": "OBSプロファイルは、クラッシュが何回ありましたか？"}, {"type": "subtitle", "time": 688.069, "timestamp": "00:11:28", "text": "FPSの低下はありました"}, {"type": "subtitle", "time": 693.509, "timestamp": "00:11:33", "text": "OBSやイベントログなど、"}, {"type": "subtitle", "time": 698.55, "timestamp": "00:11:38", "text": "それと、私もそのファイルを送信しました。"}, {"type": "subtitle", "time": 702.389, "timestamp": "00:11:42", "text": "OBS を私のスタッフ チャンネルに長く"}, {"type": "subtitle", "time": 704.23, "timestamp": "00:11:44", "text": "戻る。"}, {"type": "subtitle", "time": 706.87, "timestamp": "00:11:46", "text": "そう、これは以前はボタンのようなものだった"}, {"type": "subtitle", "time": 709.829, "timestamp": "00:11:49", "text": "これは技術的なものです"}, {"type": "subtitle", "time": 714.069, "timestamp": "00:11:54", "text": "デバッグは、以前はよくやっていたと思います。私は思う"}, {"type": "subtitle", "time": 716.31, "timestamp": "00:11:56", "text": "モデレーターもそれを見ることができます。長い間"}, {"type": "subtitle", "time": 719.509, "timestamp": "00:11:59", "text": "確か前にやったと思う。そうですね、基本的には"}]
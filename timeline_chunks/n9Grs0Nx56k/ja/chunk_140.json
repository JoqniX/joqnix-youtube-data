[{"type": "subtitle", "time": 8404.15, "timestamp": "02:20:04", "text": "ハイは簡単だった。おお。"}, {"type": "subtitle", "time": 8408.79, "timestamp": "02:20:08", "text": "私は3000くらいです。待って、それはあなたの21Kですか？"}, {"type": "subtitle", "time": 8412.15, "timestamp": "02:20:12", "text": "今？待って、"}, {"type": "subtitle", "time": 8415.27, "timestamp": "02:20:15", "text": "音楽の再生回数は現在21.1Kだと思います。私は"}, {"type": "subtitle", "time": 8426.309, "timestamp": "02:20:26", "text": "八。私はまだ8Kです、"}, {"type": "subtitle", "time": 8428.15, "timestamp": "02:20:28", "text": "私は思う。"}, {"type": "subtitle", "time": 8431.349, "timestamp": "02:20:31", "text": "待って、私は8歳か、それとも違うと思う、私は"}, {"type": "subtitle", "time": 8433.99, "timestamp": "02:20:33", "text": "10に到達した。忘れてしまった。 8だと思います"}, {"type": "subtitle", "time": 8436.71, "timestamp": "02:20:36", "text": "あるいは、そんな感じ。私のギアスコアは？"}, {"type": "subtitle", "time": 8439.27, "timestamp": "02:20:39", "text": "前回はいつ来られましたか？ええ、まだ"}, {"type": "subtitle", "time": 8441.27, "timestamp": "02:20:41", "text": "同じ。"}]
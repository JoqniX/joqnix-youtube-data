[{"type": "subtitle", "time": 17464.628, "timestamp": "04:51:04", "text": "これはどうすればもっと自信に満ちた見た目になるのでしょうか？"}, {"type": "subtitle", "time": 17466.948, "timestamp": "04:51:06", "text": "なぜ私は"}, {"type": "subtitle", "time": 17469.91, "timestamp": "04:51:09", "text": "こんにちは、夜？元気かい？"}, {"type": "subtitle", "time": 17472.31, "timestamp": "04:51:12", "text": "こんにちは。こんにちは。"}, {"type": "subtitle", "time": 17475.35, "timestamp": "04:51:15", "text": "なぜnullになるんだ？理解できない"}, {"type": "subtitle", "time": 17480.47, "timestamp": "04:51:20", "text": "それ。なぜ？どうやって消去されたの？"}, {"type": "subtitle", "time": 17483.51, "timestamp": "04:51:23", "text": "どのように、そしてなぜ？なぜ何も問題ないのですか？"}, {"type": "subtitle", "time": 17485.83, "timestamp": "04:51:25", "text": "これは存在する。"}, {"type": "subtitle", "time": 17491.27, "timestamp": "04:51:31", "text": "案件。なぜnullなのか？未定義。"}, {"type": "subtitle", "time": 17494.15, "timestamp": "04:51:34", "text": "あなたはどういうわけか生きている。わかった。なぜ"}, {"type": "subtitle", "time": 17495.67, "timestamp": "04:51:35", "text": "なし？"}, {"type": "subtitle", "time": 17497.27, "timestamp": "04:51:37", "text": "なぜ？"}, {"type": "subtitle", "time": 17499.51, "timestamp": "04:51:39", "text": "この夢は何だろう？"}, {"type": "subtitle", "time": 17501.51, "timestamp": "04:51:41", "text": "ああ、昨日の配信のことね。わかった。どうでも"}, {"type": "subtitle", "time": 17505.67, "timestamp": "04:51:45", "text": "それ。えっと、なぜあなたはnullなのですか？"}, {"type": "subtitle", "time": 17514.948, "timestamp": "04:51:54", "text": "いや、これは違う。"}, {"type": "subtitle", "time": 17518.32, "timestamp": "04:51:58", "text": "これは違う。 どこにある"}]
[{"type": "subtitle", "time": 21960.868, "timestamp": "06:06:00", "text": "えーと、ループは必要ないと思うんだけど、"}, {"type": "subtitle", "time": 21962.948, "timestamp": "06:06:02", "text": "すでにすべてをチェックします"}, {"type": "subtitle", "time": 21966.23, "timestamp": "06:06:06", "text": "そうですね、ループではありません。でも私が言いたいのは"}, {"type": "subtitle", "time": 21969.83, "timestamp": "06:06:09", "text": "言うと、それは一つ一つチェックするようなものです"}, {"type": "subtitle", "time": 21972.07, "timestamp": "06:06:12", "text": "ビデオID"}, {"type": "subtitle", "time": 21977.19, "timestamp": "06:06:17", "text": "そして彼らのステータスがライブステータスかどうかを確認します"}, {"type": "subtitle", "time": 21981.03, "timestamp": "06:06:21", "text": "現在のライブステータスは"}, {"type": "subtitle", "time": 21984.628, "timestamp": "06:06:24", "text": "えっと、ライブか、終了か、何か。私は"}, {"type": "subtitle", "time": 21986.548, "timestamp": "06:06:26", "text": "考えていた、えっと、基本的に私は考えていた"}, {"type": "subtitle", "time": 21991.03, "timestamp": "06:06:31", "text": "例えば、現在進行中のイベントの場合"}, {"type": "subtitle", "time": 21993.03, "timestamp": "06:06:33", "text": "ライブストリームのようなものだとすれば"}, {"type": "subtitle", "time": 21996.15, "timestamp": "06:06:36", "text": "現在進行中で、現在、"}, {"type": "subtitle", "time": 21998.23, "timestamp": "06:06:38", "text": "ディスコードイベントが作成され、"}, {"type": "subtitle", "time": 22000.47, "timestamp": "06:06:40", "text": "現在配信中です。倍にしたいだけです"}, {"type": "subtitle", "time": 22005.51, "timestamp": "06:06:45", "text": "タイトルを確認して、更新してください"}, {"type": "subtitle", "time": 22008.31, "timestamp": "06:06:48", "text": "終末の時、まさに私たちが好きなように"}, {"type": "subtitle", "time": 22010.948, "timestamp": "06:06:50", "text": "前に述べたように、私は変えたいと思っていました"}, {"type": "subtitle", "time": 22014.47, "timestamp": "06:06:54", "text": "タイミングが、もし私が6時間を超えたら"}, {"type": "subtitle", "time": 22018.23, "timestamp": "06:06:58", "text": "それを記録しておこう"}]
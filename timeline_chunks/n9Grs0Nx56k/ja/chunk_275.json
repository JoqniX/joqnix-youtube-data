[{"type": "subtitle", "time": 16514.07, "timestamp": "04:35:14", "text": "待って。"}, {"type": "subtitle", "time": 16519.75, "timestamp": "04:35:19", "text": "何？何？何？何？何？何？"}, {"type": "subtitle", "time": 16521.189, "timestamp": "04:35:21", "text": "何？ [息を呑む]"}, {"type": "subtitle", "time": 16531.429, "timestamp": "04:35:31", "text": "私があなたを傷つけてしまったの？なぜ？はぁ？"}, {"type": "subtitle", "time": 16548.551, "timestamp": "04:35:48", "text": "なぜパケットを送信しないのですか？あなたは"}, {"type": "subtitle", "time": 16550.23, "timestamp": "04:35:50", "text": "パケットを送信するはずである。それはあなたの"}, {"type": "subtitle", "time": 16553.83, "timestamp": "04:35:53", "text": "タスクの最後に唯一の仕事、"}, {"type": "subtitle", "time": 16559.189, "timestamp": "04:35:59", "text": "右？それを地図に描くべきなんだ。"}]
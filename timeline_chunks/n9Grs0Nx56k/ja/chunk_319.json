[{"type": "subtitle", "time": 19142.23, "timestamp": "05:19:02", "text": "ライブ配信で、私のサーバーでDiscordイベントを開催したい"}, {"type": "subtitle", "time": 19144.948, "timestamp": "05:19:04", "text": "自動的に作成される"}, {"type": "subtitle", "time": 19148.47, "timestamp": "05:19:08", "text": "成功した。そしてライブ配信中は私も"}, {"type": "subtitle", "time": 19152.788, "timestamp": "05:19:12", "text": "アナウンサーのような感じが欲しい。私は私が使った"}, {"type": "subtitle", "time": 19156.39, "timestamp": "05:19:16", "text": "このコードからコンポーネント B2 を"}, {"type": "subtitle", "time": 19159.35, "timestamp": "05:19:19", "text": "容器。だからボタンを付けられるんです。アクション"}, {"type": "subtitle", "time": 19161.51, "timestamp": "05:19:21", "text": "アクション行はここに表示されます。ボタン。うん。"}, {"type": "subtitle", "time": 19164.868, "timestamp": "05:19:24", "text": "これは送信されます"}, {"type": "subtitle", "time": 19167.03, "timestamp": "05:19:27", "text": "えーと、これは、ええ、これは別のボタンです"}, {"type": "subtitle", "time": 19169.75, "timestamp": "05:19:29", "text": "ストリームと応答を呼び出します。これにより"}, {"type": "subtitle", "time": 19173.59, "timestamp": "05:19:33", "text": "予定時刻の10分前に送信されました。 [音楽]"}, {"type": "subtitle", "time": 19177.35, "timestamp": "05:19:37", "text": "つまり、YouTubeのスケジュール時間を比較するということです。"}, {"type": "subtitle", "time": 19180.31, "timestamp": "05:19:40", "text": "YouTubeの配信スケジュール開始時間"}, {"type": "subtitle", "time": 19184.23, "timestamp": "05:19:44", "text": "現在の時刻で、もしそれが"}, {"type": "subtitle", "time": 19187.11, "timestamp": "05:19:47", "text": "あと10分だよ、だってこれ"}, {"type": "subtitle", "time": 19189.99, "timestamp": "05:19:49", "text": "このボタンは5分ごとに実行されます。えーと"}, {"type": "subtitle", "time": 19191.91, "timestamp": "05:19:51", "text": "5分か2分。だから、もしそれが10なら"}, {"type": "subtitle", "time": 19193.59, "timestamp": "05:19:53", "text": "分後、待合室へ"}, {"type": "subtitle", "time": 19196.23, "timestamp": "05:19:56", "text": "待合室のようなメッセージ"}]
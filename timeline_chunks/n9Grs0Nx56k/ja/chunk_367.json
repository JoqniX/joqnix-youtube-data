[{"type": "subtitle", "time": 22021.19, "timestamp": "06:07:01", "text": "他のイベントに関して"}, {"type": "subtitle", "time": 22023.67, "timestamp": "06:07:03", "text": "スケジュールされたイベントのようなものが作られました"}, {"type": "subtitle", "time": 22027.35, "timestamp": "06:07:07", "text": "スケジュールされたストリームのように、"}, {"type": "subtitle", "time": 22031.27, "timestamp": "06:07:11", "text": "タイトルが二重にチェックされているか確認したい"}, {"type": "subtitle", "time": 22035.19, "timestamp": "06:07:15", "text": "そして、開始時刻が正しいかどうか。"}, {"type": "subtitle", "time": 22037.75, "timestamp": "06:07:17", "text": "メインマップでも同じです。それでおしまい。そして"}, {"type": "subtitle", "time": 22041.51, "timestamp": "06:07:21", "text": "YouTube がすでに更新されているので、アップデートしてください"}, {"type": "subtitle", "time": 22045.19, "timestamp": "06:07:25", "text": "えーと、近日公開予定のものと、現在のえーと、"}, {"type": "subtitle", "time": 22047.83, "timestamp": "06:07:27", "text": "ライブストリームAPIは両方のボタンで送信されます"}, {"type": "subtitle", "time": 22051.75, "timestamp": "06:07:31", "text": "最新データをメインマップの右ボタンに表示する。"}, {"type": "subtitle", "time": 22054.628, "timestamp": "06:07:34", "text": "つまり、メインマップは既にそれを書き込んでいます"}, {"type": "subtitle", "time": 22056.628, "timestamp": "06:07:36", "text": "ローカルファイルとメインマップのようなもの"}, {"type": "subtitle", "time": 22058.708, "timestamp": "06:07:38", "text": "右。だから私はこう考えている"}, {"type": "subtitle", "time": 22060.948, "timestamp": "06:07:40", "text": "パッチのためにそのようにできる"}, {"type": "subtitle", "time": 22069.99, "timestamp": "06:07:49", "text": "私はBに行きました。[笑い]"}]
[{"type": "subtitle", "time": 5401.27, "timestamp": "01:30:01", "text": "それを送らなければならない。いいえ。ああ、忘れてた。"}, {"type": "subtitle", "time": 5406.149, "timestamp": "01:30:06", "text": "待てよ、この人のことすっかり忘れてた。"}, {"type": "subtitle", "time": 5408.149, "timestamp": "01:30:08", "text": "ああ、なんてことだ、あなたのことをすっかり忘れてたよ"}, {"type": "subtitle", "time": 5409.669, "timestamp": "01:30:09", "text": "存在していた。"}, {"type": "subtitle", "time": 5413.669, "timestamp": "01:30:13", "text": "ローカルダンプパス。"}, {"type": "subtitle", "time": 5417.51, "timestamp": "01:30:17", "text": "ああ、直さなきゃ。それを"}, {"type": "subtitle", "time": 5422.07, "timestamp": "01:30:22", "text": "もの。手動で調整します"}, {"type": "subtitle", "time": 5428.87, "timestamp": "01:30:28", "text": "それらは壊れたのか？ああ、震えてる"}, {"type": "subtitle", "time": 5431.312, "timestamp": "01:30:31", "text": "そんなに。"}, {"type": "subtitle", "time": 5432.79, "timestamp": "01:30:32", "text": "[笑い]"}, {"type": "subtitle", "time": 5438.229, "timestamp": "01:30:38", "text": "えっと、"}, {"type": "subtitle", "time": 5441.91, "timestamp": "01:30:41", "text": "サムネイルURL。えっと、ローカルポッド。いいえ、それは"}, {"type": "subtitle", "time": 5443.99, "timestamp": "01:30:43", "text": "男。 [息を呑む]"}, {"type": "subtitle", "time": 5453.75, "timestamp": "01:30:53", "text": "うん。サムネイルの代わりに、"}]
[{"type": "subtitle", "time": 16693.51, "timestamp": "04:38:13", "text": "わかった、"}, {"type": "subtitle", "time": 16695.349, "timestamp": "04:38:15", "text": "保存しました。これは"}, {"type": "subtitle", "time": 16697.75, "timestamp": "04:38:17", "text": "リロードして"}, {"type": "subtitle", "time": 16708.15, "timestamp": "04:38:28", "text": "えっと、それからこの人。はい。わかった。今あなた"}, {"type": "subtitle", "time": 16710.709, "timestamp": "04:38:30", "text": "うまくいくはずです。技術的には、"}, {"type": "subtitle", "time": 16712.789, "timestamp": "04:38:32", "text": "あなたは出て行かないでください"}, {"type": "subtitle", "time": 16721.269, "timestamp": "04:38:41", "text": "こんにちは、ティム・ダーウィンさん。"}, {"type": "subtitle", "time": 16726.949, "timestamp": "04:38:46", "text": "水分補給のリマインダーをありがとうございます。私"}, {"type": "subtitle", "time": 16729.189, "timestamp": "04:38:49", "text": "まさにそれが欲しかったんです。私にはそれが必要だった。感謝"}, {"type": "subtitle", "time": 16731.91, "timestamp": "04:38:51", "text": "あなた。"}, {"type": "subtitle", "time": 16739.83, "timestamp": "04:38:59", "text": "ああ、なんてことだ、なんであれを片付けてしまったんだろう？おお"}]
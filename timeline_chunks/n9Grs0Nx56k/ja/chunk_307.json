[{"type": "subtitle", "time": 18441.35, "timestamp": "05:07:21", "text": "ああ、もしそれが「いいえ」のようなものだったらどうでしょう。"}, {"type": "subtitle", "time": 18443.99, "timestamp": "05:07:23", "text": "待って。"}, {"type": "subtitle", "time": 18445.91, "timestamp": "05:07:25", "text": "いいえ。違いは何ですか？"}, {"type": "subtitle", "time": 18448.39, "timestamp": "05:07:28", "text": "YouTubeとDiscord？"}, {"type": "subtitle", "time": 18451.51, "timestamp": "05:07:31", "text": "そうねぇ。 YouTube は自動的に"}, {"type": "subtitle", "time": 18455.19, "timestamp": "05:07:35", "text": "すべて順調です。しかし、ここには2つある。"}, {"type": "subtitle", "time": 18458.948, "timestamp": "05:07:38", "text": "ああ、なるほど。わかった。わかった。私"}, {"type": "subtitle", "time": 18461.51, "timestamp": "05:07:41", "text": "なんとなく理解できたと思う。なんとなく理解できたと思います。理解します"}, {"type": "subtitle", "time": 18464.23, "timestamp": "05:07:44", "text": "それ。わかった。エントリーのはず"}, {"type": "subtitle", "time": 18471.03, "timestamp": "05:07:51", "text": "ドットディスコード、これは"}, {"type": "subtitle", "time": 18473.822, "timestamp": "05:07:53", "text": "イベント"}, {"type": "subtitle", "time": 18475.75, "timestamp": "05:07:55", "text": "[笑い]"}]
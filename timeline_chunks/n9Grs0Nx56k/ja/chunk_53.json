[{"type": "subtitle", "time": 3180.39, "timestamp": "00:53:00", "text": "金曜日。今では、日々があっという間に過ぎ去る。"}, {"type": "subtitle", "time": 3183.349, "timestamp": "00:53:03", "text": "君は全然気づいてないよ。"}, {"type": "subtitle", "time": 3190.549, "timestamp": "00:53:10", "text": "週末はみんな暇だと思う。"}, {"type": "subtitle", "time": 3192.63, "timestamp": "00:53:12", "text": "だから、明日は襲撃しようと思う"}, {"type": "subtitle", "time": 3195.03, "timestamp": "00:53:15", "text": "あれ。"}, {"type": "subtitle", "time": 3207.51, "timestamp": "00:53:27", "text": "水。"}, {"type": "subtitle", "time": 3211.27, "timestamp": "00:53:31", "text": "水を飲みましょう。みんな水分補給"}, {"type": "subtitle", "time": 3213.19, "timestamp": "00:53:33", "text": "今日。そうそう。今日のギル集め。うん。"}, {"type": "subtitle", "time": 3222.47, "timestamp": "00:53:42", "text": "そしてダンスもする。いいえ。"}, {"type": "subtitle", "time": 3224.592, "timestamp": "00:53:44", "text": "そうしなければならない。"}, {"type": "subtitle", "time": 3226.39, "timestamp": "00:53:46", "text": "[咳払い]"}, {"type": "subtitle", "time": 3228.47, "timestamp": "00:53:48", "text": "私たちは"}, {"type": "subtitle", "time": 3231.349, "timestamp": "00:53:51", "text": "それを怠ってはならない。先週私は"}]
[{"type": "subtitle", "time": 5521.189, "timestamp": "01:32:01", "text": "わかった。このサムネイル部分"}, {"type": "subtitle", "time": 5525.11, "timestamp": "01:32:05", "text": "サムネイルターゲットパートナー"}, {"type": "subtitle", "time": 5544.31, "timestamp": "01:32:24", "text": "サムネイルもダウンロードしています。"}, {"type": "subtitle", "time": 5554.47, "timestamp": "01:32:34", "text": "ああ、この人か。あなたはなぜここにいるのですか？ここ。"}, {"type": "subtitle", "time": 5564.31, "timestamp": "01:32:44", "text": "ああ、それならローカルサムネイルを送信できます"}, {"type": "subtitle", "time": 5567.43, "timestamp": "01:32:47", "text": "ここからの道。おお。おお。ああ、できるよ"}, {"type": "subtitle", "time": 5571.27, "timestamp": "01:32:51", "text": "ここから送信してください。ああ、わかりました。ではなぜ"}, {"type": "subtitle", "time": 5576.149, "timestamp": "01:32:56", "text": "あなたはここにいますか？まるでミスターみたいに、"}]
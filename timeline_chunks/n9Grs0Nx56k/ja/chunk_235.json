[{"type": "subtitle", "time": 14103.269, "timestamp": "03:55:03", "text": "私はここで何をしているのだろう？私は"}, {"type": "subtitle", "time": 14106.469, "timestamp": "03:55:06", "text": "ボタン変数を取得するパス。"}, {"type": "subtitle", "time": 14108.63, "timestamp": "03:55:08", "text": "おお、"}, {"type": "subtitle", "time": 14112.309, "timestamp": "03:55:12", "text": "そしてそれをオブジェクトとして設定する。おお、"}, {"type": "subtitle", "time": 14116.87, "timestamp": "03:55:16", "text": "つまり、ボタン変数です。"}, {"type": "subtitle", "time": 14126.229, "timestamp": "03:55:26", "text": "ボタン変数を使う必要がある、オブジェクトではない"}, {"type": "subtitle", "time": 14132.71, "timestamp": "03:55:32", "text": "ボタン"}, {"type": "subtitle", "time": 14138.79, "timestamp": "03:55:38", "text": "そう、私たちは全体をコピー＆ペーストするだけです"}, {"type": "subtitle", "time": 14146.15, "timestamp": "03:55:46", "text": "名前"}, {"type": "subtitle", "time": 14149.59, "timestamp": "03:55:49", "text": "開始予定時刻。"}, {"type": "subtitle", "time": 14155.67, "timestamp": "03:55:55", "text": "ああ、終わりの時は、ああ、私の終わりの時は"}, {"type": "subtitle", "time": 14158.229, "timestamp": "03:55:58", "text": "間違っている。よかった、それに気付いたよ"}]
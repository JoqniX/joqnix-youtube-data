[{"type": "subtitle", "time": 11882.71, "timestamp": "03:18:02", "text": "ではなぜ"}, {"type": "subtitle", "time": 11886.79, "timestamp": "03:18:06", "text": "ほら、ここは完璧だよ"}, {"type": "subtitle", "time": 11888.87, "timestamp": "03:18:08", "text": "ストリーム。"}, {"type": "subtitle", "time": 11892.229, "timestamp": "03:18:12", "text": "こんにちは、Vansa。本当に久しぶりだ。調子はどうですか？"}, {"type": "subtitle", "time": 11895.429, "timestamp": "03:18:15", "text": "何をしているの？"}, {"type": "subtitle", "time": 11933.99, "timestamp": "03:18:53", "text": "ところで、仕事はどうですか？生活はどうですか？"}]
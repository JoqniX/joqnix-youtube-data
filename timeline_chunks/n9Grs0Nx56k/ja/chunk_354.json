[{"type": "subtitle", "time": 21242.15, "timestamp": "05:54:02", "text": "これを移動させてください。積極的に見たい"}, {"type": "subtitle", "time": 21245.91, "timestamp": "05:54:05", "text": "アップデート。保存。"}, {"type": "subtitle", "time": 21273.91, "timestamp": "05:54:33", "text": "送信済みと書いてあるけど、私は"}, {"type": "subtitle", "time": 21277.19, "timestamp": "05:54:37", "text": "それが送信されたことを確認してください"}, {"type": "subtitle", "time": 21284.868, "timestamp": "05:54:44", "text": "私は何をしたの？"}]
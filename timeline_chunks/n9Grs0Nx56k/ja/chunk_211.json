[{"type": "subtitle", "time": 12670.389, "timestamp": "03:31:10", "text": "わかった。すべてのアップデートはドットです"}, {"type": "subtitle", "time": 12680.55, "timestamp": "03:31:20", "text": "そしてその内部には局所的な親指電流が存在する。"}, {"type": "subtitle", "time": 12685.19, "timestamp": "03:31:25", "text": "これをコピーしてください。貼り付ける"}, {"type": "subtitle", "time": 12688.309, "timestamp": "03:31:28", "text": "このような。"}]
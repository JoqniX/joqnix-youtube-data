[{"type": "subtitle", "time": 3665.51, "timestamp": "01:01:05", "text": "だからもし"}, {"type": "subtitle", "time": 3673.19, "timestamp": "01:01:13", "text": "Discordイベントが作られていない場合"}, {"type": "subtitle", "time": 3677.589, "timestamp": "01:01:17", "text": "近日公開、ライブ配信、または現在"}, {"type": "subtitle", "time": 3682.63, "timestamp": "01:01:22", "text": "ライブストリームでは、今後制作される予定の"}, {"type": "subtitle", "time": 3686.63, "timestamp": "01:01:26", "text": "今後の配信"}, {"type": "subtitle", "time": 3691.109, "timestamp": "01:01:31", "text": "ある意味で綿になった"}, {"type": "subtitle", "time": 3693.589, "timestamp": "01:01:33", "text": "ライブ配信。"}, {"type": "subtitle", "time": 3697.589, "timestamp": "01:01:37", "text": "もしそれがそうなら、もしそれが"}, {"type": "subtitle", "time": 3701.75, "timestamp": "01:01:41", "text": "そして、そして、私は言う、そして私は言う"}, {"type": "subtitle", "time": 3705.67, "timestamp": "01:01:45", "text": "そのストリームにライブ配信した。"}, {"type": "subtitle", "time": 3710.549, "timestamp": "01:01:50", "text": "スケジュールを使用する場合"}, {"type": "subtitle", "time": 3715.19, "timestamp": "01:01:55", "text": "イベントを行うためにストリームストリームの時間、"}, {"type": "subtitle", "time": 3718.71, "timestamp": "01:01:58", "text": "エラーが表示されます。"}, {"type": "subtitle", "time": 3719.829, "timestamp": "01:01:59", "text": "右？"}]
[{"type": "subtitle", "time": 12361.67, "timestamp": "03:26:01", "text": "何か。"}, {"type": "subtitle", "time": 12364.63, "timestamp": "03:26:04", "text": "だから私はこう思う"}, {"type": "subtitle", "time": 12367.187, "timestamp": "03:26:07", "text": "今回はあまりできることがありません。"}, {"type": "subtitle", "time": 12368.15, "timestamp": "03:26:08", "text": "[笑い]"}, {"type": "subtitle", "time": 12371.11, "timestamp": "03:26:11", "text": "私が連絡できる人の数と"}, {"type": "subtitle", "time": 12374.15, "timestamp": "03:26:14", "text": "それと繋がりがある。ああ、神様、それは"}, {"type": "subtitle", "time": 12375.99, "timestamp": "03:26:15", "text": "手に入れた"}, {"type": "subtitle", "time": 12381.11, "timestamp": "03:26:21", "text": "めちゃくちゃだ。音楽が始まって以来、そういうもの"}, {"type": "subtitle", "time": 12384.07, "timestamp": "03:26:24", "text": "やらかしたのを逃したよ。それ以来"}, {"type": "subtitle", "time": 12386.79, "timestamp": "03:26:26", "text": "そういうことが起こったんです。"}, {"type": "subtitle", "time": 12391.19, "timestamp": "03:26:31", "text": "だから、もう二度とあんなことはできない。"}, {"type": "subtitle", "time": 12393.349, "timestamp": "03:26:33", "text": "でも、わからない。"}, {"type": "subtitle", "time": 12395.349, "timestamp": "03:26:35", "text": "先ほどは正気を保つのに必死だった"}, {"type": "subtitle", "time": 12398.07, "timestamp": "03:26:38", "text": "今年。損した気分だ。私"}, {"type": "subtitle", "time": 12401.248, "timestamp": "03:26:41", "text": "もっと早く知っていればよかった。 A"}]
[{"type": "subtitle", "time": 21481.11, "timestamp": "05:58:01", "text": "概念。"}, {"type": "subtitle", "time": 21494.23, "timestamp": "05:58:14", "text": "えっと、"}, {"type": "subtitle", "time": 21498.948, "timestamp": "05:58:18", "text": "実際、これをここに入れておきます。ジャンク。"}, {"type": "subtitle", "time": 21505.67, "timestamp": "05:58:25", "text": "戻ってきました。戻ってきました。戻ってきました。"}, {"type": "subtitle", "time": 21507.91, "timestamp": "05:58:27", "text": "何てことだ。"}, {"type": "subtitle", "time": 21510.15, "timestamp": "05:58:30", "text": "あまり食べられなかったので、"}, {"type": "subtitle", "time": 21511.91, "timestamp": "05:58:31", "text": "若干。"}, {"type": "subtitle", "time": 21513.99, "timestamp": "05:58:33", "text": "でも、私はたくさんのおやつを手に入れました"}, {"type": "subtitle", "time": 21516.15, "timestamp": "05:58:36", "text": "夜。"}, {"type": "subtitle", "time": 21530.23, "timestamp": "05:58:50", "text": "残り時間はあと2時間しかない。えっと、"}, {"type": "subtitle", "time": 21534.31, "timestamp": "05:58:54", "text": "いいえ。 6 7 8 9 10。了解。うん。 9. 10の前に"}, {"type": "subtitle", "time": 21536.23, "timestamp": "05:58:56", "text": "数時間後、配信を終了しなければなりません。それで、"}]
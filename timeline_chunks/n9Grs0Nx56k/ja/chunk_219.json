[{"type": "subtitle", "time": 13156.55, "timestamp": "03:39:16", "text": "これでうまくいくはずだ。"}, {"type": "subtitle", "time": 13159.59, "timestamp": "03:39:19", "text": "私たちは話が脱線してしまった。他の"}, {"type": "subtitle", "time": 13161.99, "timestamp": "03:39:21", "text": "物が壊れた。だから私はこう思うんです"}, {"type": "subtitle", "time": 13196.389, "timestamp": "03:39:56", "text": "新鮮な歓迎。"}]
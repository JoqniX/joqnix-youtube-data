[{"type": "subtitle", "time": 20641.27, "timestamp": "05:44:01", "text": "機能しません。私はそうしなければならない"}, {"type": "subtitle", "time": 20644.708, "timestamp": "05:44:04", "text": "GitHubでプルリクエストを作成する、プルではなく"}, {"type": "subtitle", "time": 20647.51, "timestamp": "05:44:07", "text": "リクエスト、プル、それについて問題提起"}, {"type": "subtitle", "time": 20651.11, "timestamp": "05:44:11", "text": "そして、なぜ機能しないのかを尋ねたり、"}, {"type": "subtitle", "time": 20654.548, "timestamp": "05:44:14", "text": "OBSも修正されるような何か"}, {"type": "subtitle", "time": 20656.948, "timestamp": "05:44:16", "text": "OBSは、"}, {"type": "subtitle", "time": 20660.47, "timestamp": "05:44:20", "text": "OBSの次回の大型アップデートで"}, {"type": "subtitle", "time": 20662.39, "timestamp": "05:44:22", "text": "数ヶ月かそこらで、今のところ彼らは"}, {"type": "subtitle", "time": 20664.39, "timestamp": "05:44:24", "text": "修理する予定はないとか、"}, {"type": "subtitle", "time": 20668.098, "timestamp": "05:44:28", "text": "そう言われたから、私は「それは最悪だ」と思った。"}, {"type": "subtitle", "time": 20670.07, "timestamp": "05:44:30", "text": "[笑い] 離れている間はVが欲しい"}, {"type": "subtitle", "time": 20674.39, "timestamp": "05:44:34", "text": "ストリームから、私がこう思うとき"}, {"type": "subtitle", "time": 20676.628, "timestamp": "05:44:36", "text": "えっと、配信中じゃないし、私は"}, {"type": "subtitle", "time": 20680.548, "timestamp": "05:44:40", "text": "休憩とか色々あって、今Vで遊んでほしいんだ。"}, {"type": "subtitle", "time": 20682.548, "timestamp": "05:44:42", "text": "うん。だから私は現在同じです"}, {"type": "subtitle", "time": 20684.948, "timestamp": "05:44:44", "text": "システムは、バージョン4のような最後のものと同様です。"}, {"type": "subtitle", "time": 20687.11, "timestamp": "05:44:47", "text": "コワーキングストリームを作ったところ、"}, {"type": "subtitle", "time": 20690.548, "timestamp": "05:44:50", "text": "カテゴリまたはストリームカテゴリ"}, {"type": "subtitle", "time": 20693.27, "timestamp": "05:44:53", "text": "私はそれに乗っていて、ランダム化します"}, {"type": "subtitle", "time": 20695.59, "timestamp": "05:44:55", "text": "プレイリストみたいなもの。うん。そして私は"}, {"type": "subtitle", "time": 20698.548, "timestamp": "05:44:58", "text": "バージョン1を追加します。"}]
[{"type": "subtitle", "time": 2831.51, "timestamp": "00:47:11", "text": "開発者たちはたくさんのバラを無料で配った"}, {"type": "subtitle", "time": 2835.349, "timestamp": "00:47:15", "text": "今はオーブです。私は6,000かそれくらい持っていると思います"}, {"type": "subtitle", "time": 2838.15, "timestamp": "00:47:18", "text": "何か。"}, {"type": "subtitle", "time": 2840.23, "timestamp": "00:47:20", "text": "6、7人。"}, {"type": "subtitle", "time": 2842.067, "timestamp": "00:47:22", "text": "私はただ謎のものを買っているだけです"}, {"type": "subtitle", "time": 2853.43, "timestamp": "00:47:33", "text": "表示させてください。私は600を持っています。"}, {"type": "subtitle", "time": 2855.27, "timestamp": "00:47:35", "text": "はぁ？"}, {"type": "subtitle", "time": 2859.03, "timestamp": "00:47:39", "text": "何？残りの時間はどこで過ごしましたか？"}, {"type": "subtitle", "time": 2863.43, "timestamp": "00:47:43", "text": "彼らはたくさんもらったんじゃないの？何？"}, {"type": "subtitle", "time": 2866.15, "timestamp": "00:47:46", "text": "何てことだ。あ、待って。それはこう言った"}, {"type": "subtitle", "time": 2869.99, "timestamp": "00:47:49", "text": "あなたはそうしました。あなたは何かを買いました。"}]
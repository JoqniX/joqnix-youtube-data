[{"type": "subtitle", "time": 9005.19, "timestamp": "02:30:05", "text": "私はこれを整理して、"}, {"type": "chat", "time": 9008.624, "timestamp": "02:30:08", "author": "@TheDivineGokuBlack", "avatar": "https://yt4.ggpht.com/x2pzeEVaf1zyUBkZCrzTAzUJCua_ZlOHqOBCVhiADyCWmaW54l65hftnOmbOFY2vCGVSXGk5Ng=s64-c-k-c0x00ffffff-no-rj", "message": "can't you make it so that it ignores the creation time and only check the date and time of the stream?"}, {"type": "subtitle", "time": 9020.389, "timestamp": "02:30:20", "text": "イベント。こうできないの？"}, {"type": "subtitle", "time": 9023.51, "timestamp": "02:30:23", "text": "作成時間を無視し、"}, {"type": "subtitle", "time": 9025.59, "timestamp": "02:30:25", "text": "配信の日時を確認してください。"}, {"type": "chat", "time": 9026.931, "timestamp": "02:30:26", "author": "@TheDivineGokuBlack", "avatar": "https://yt4.ggpht.com/x2pzeEVaf1zyUBkZCrzTAzUJCua_ZlOHqOBCVhiADyCWmaW54l65hftnOmbOFY2vCGVSXGk5Ng=s64-c-k-c0x00ffffff-no-rj", "message": "i might have to go in a bit my internet about to die"}, {"type": "subtitle", "time": 9034.469, "timestamp": "02:30:34", "text": "戻らなければならないかもしれない。私のインターネット"}, {"type": "subtitle", "time": 9037.11, "timestamp": "02:30:37", "text": "死にかけている。大丈夫。"}, {"type": "subtitle", "time": 9039.349, "timestamp": "02:30:39", "text": "大丈夫。心配しないで。そうします。"}, {"type": "subtitle", "time": 9041.03, "timestamp": "02:30:41", "text": "ご提案いただきありがとうございます。わかった。私"}, {"type": "subtitle", "time": 9043.91, "timestamp": "02:30:43", "text": "そのGPDを失った。そうしなければならない。"}, {"type": "subtitle", "time": 9046.15, "timestamp": "02:30:46", "text": "おそらく私は、"}, {"type": "subtitle", "time": 9047.99, "timestamp": "02:30:47", "text": "条件付きで何かをする必要がある"}, {"type": "subtitle", "time": 9049.67, "timestamp": "02:30:49", "text": "（咳払い）"}, {"type": "subtitle", "time": 9054.23, "timestamp": "02:30:54", "text": "ウムアロを整理する"}, {"type": "subtitle", "time": 9056.55, "timestamp": "02:30:56", "text": "それもまた然り。"}, {"type": "subtitle", "time": 9058.07, "timestamp": "02:30:58", "text": "こんにちは。"}]
[{"type": "subtitle", "time": 22800.788, "timestamp": "06:20:00", "text": "ループの前の上の部分"}, {"type": "subtitle", "time": 22803.51, "timestamp": "06:20:03", "text": "今後のストリームサイズループでは"}, {"type": "subtitle", "time": 22806.708, "timestamp": "06:20:06", "text": "コードIDが存在するか確認します。"}, {"type": "subtitle", "time": 22810.47, "timestamp": "06:20:10", "text": "そうじゃなくて、私がやることは"}, {"type": "subtitle", "time": 22812.868, "timestamp": "06:20:12", "text": "一番上か、その前の中間のような"}, {"type": "subtitle", "time": 22817.27, "timestamp": "06:20:17", "text": "ループが発生すると、現在の取得を維持します"}, {"type": "subtitle", "time": 22820.39, "timestamp": "06:20:20", "text": "えっと、Discordのイベントのやつ、私はクリスティーナを使ってる"}, {"type": "subtitle", "time": 22828.07, "timestamp": "06:20:28", "text": "えっと、サミーエクステンション。そのため、"}, {"type": "subtitle", "time": 22831.51, "timestamp": "06:20:31", "text": "そうやって私はイベントを開催できるのです"}, {"type": "subtitle", "time": 22834.23, "timestamp": "06:20:34", "text": "このコードとか、そういうもの全部。それで"}, {"type": "subtitle", "time": 22836.948, "timestamp": "06:20:36", "text": "取得中です。イベントを取得しています。"}, {"type": "subtitle", "time": 22840.47, "timestamp": "06:20:40", "text": "それって配列になるもの。"}, {"type": "subtitle", "time": 22842.788, "timestamp": "06:20:42", "text": "現在、3つのストリームがあり、"}, {"type": "subtitle", "time": 22845.43, "timestamp": "06:20:45", "text": "それら３つは地図上に示されています。わかった。だからそれは"}, {"type": "subtitle", "time": 22848.23, "timestamp": "06:20:48", "text": "フェッチ現在のフェッチのようになった"}, {"type": "subtitle", "time": 22850.548, "timestamp": "06:20:50", "text": "Discordイベント"}, {"type": "subtitle", "time": 22853.83, "timestamp": "06:20:53", "text": "えっと、それは物体になった。だからその"}, {"type": "subtitle", "time": 22856.47, "timestamp": "06:20:56", "text": "物体は3つあります。つまりそれは"}, {"type": "subtitle", "time": 22858.948, "timestamp": "06:20:58", "text": "オブジェクトが格納された配列。わかった。それで"}]
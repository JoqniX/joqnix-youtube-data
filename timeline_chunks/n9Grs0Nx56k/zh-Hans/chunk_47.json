[{"type": "subtitle", "time": 2831.51, "timestamp": "00:47:11", "text": "开发者们送出了好多免费玫瑰"}, {"type": "subtitle", "time": 2835.349, "timestamp": "00:47:15", "text": "现在是光球。我想我大概有6000个或者"}, {"type": "subtitle", "time": 2838.15, "timestamp": "00:47:18", "text": "某物。"}, {"type": "subtitle", "time": 2840.23, "timestamp": "00:47:20", "text": "六七个。"}, {"type": "subtitle", "time": 2842.067, "timestamp": "00:47:22", "text": "我只是在神秘网站上买东西。"}, {"type": "subtitle", "time": 2853.43, "timestamp": "00:47:33", "text": "展示出来。我有600个。"}, {"type": "subtitle", "time": 2855.27, "timestamp": "00:47:35", "text": "嗯？"}, {"type": "subtitle", "time": 2859.03, "timestamp": "00:47:39", "text": "什么？剩下的时间你都去哪儿了？"}, {"type": "subtitle", "time": 2863.43, "timestamp": "00:47:43", "text": "他们不是得到了很多吗？什么？"}, {"type": "subtitle", "time": 2866.15, "timestamp": "00:47:46", "text": "我的天啊。哦，等等。它确实说明了这一点。"}, {"type": "subtitle", "time": 2869.99, "timestamp": "00:47:49", "text": "你做到了。你买了东西。"}]
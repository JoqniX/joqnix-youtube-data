[{"type": "subtitle", "time": 16693.51, "timestamp": "04:38:13", "text": "好的，"}, {"type": "subtitle", "time": 16695.349, "timestamp": "04:38:15", "text": "我保存了。这将会变得"}, {"type": "subtitle", "time": 16697.75, "timestamp": "04:38:17", "text": "重新装弹"}, {"type": "subtitle", "time": 16708.15, "timestamp": "04:38:28", "text": "呃，还有这个人。是的。好的。现在轮到你"}, {"type": "subtitle", "time": 16710.709, "timestamp": "04:38:30", "text": "应该可以。技术上来说，"}, {"type": "subtitle", "time": 16712.789, "timestamp": "04:38:32", "text": "你不应该离开"}, {"type": "subtitle", "time": 16721.269, "timestamp": "04:38:41", "text": "呃，你好，蒂姆·达尔文。"}, {"type": "subtitle", "time": 16726.949, "timestamp": "04:38:46", "text": "谢谢你提醒我多喝水。我"}, {"type": "subtitle", "time": 16729.189, "timestamp": "04:38:49", "text": "正需要这个。我需要那个。感谢"}, {"type": "subtitle", "time": 16731.91, "timestamp": "04:38:51", "text": "你。"}, {"type": "subtitle", "time": 16739.83, "timestamp": "04:38:59", "text": "我的天哪，我为什么要清理它？哦"}]
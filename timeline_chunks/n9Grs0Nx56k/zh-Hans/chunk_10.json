[{"type": "subtitle", "time": 602.47, "timestamp": "00:10:02", "text": "我在做什么？"}, {"type": "subtitle", "time": 616.15, "timestamp": "00:10:16", "text": "在哪里？"}, {"type": "subtitle", "time": 618.55, "timestamp": "00:10:18", "text": "甚至地图？你是谁？你是什么？什么"}, {"type": "subtitle", "time": 623.99, "timestamp": "00:10:23", "text": "你这样做吗？好的。你是谁？你是谁"}, {"type": "subtitle", "time": 633.43, "timestamp": "00:10:33", "text": "我不需要这些人。不是入口行。"}, {"type": "subtitle", "time": 641.59, "timestamp": "00:10:41", "text": "是的。我为什么需要它？好的。什么是"}, {"type": "subtitle", "time": 644.87, "timestamp": "00:10:44", "text": "这？呃，直播开始。直播结束。"}, {"type": "subtitle", "time": 653.19, "timestamp": "00:10:53", "text": "[笑声]"}, {"type": "subtitle", "time": 658.87, "timestamp": "00:10:58", "text": "我记得这件事。所以，这曾是件大事。"}]
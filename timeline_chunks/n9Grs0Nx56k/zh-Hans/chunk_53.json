[{"type": "subtitle", "time": 3180.39, "timestamp": "00:53:00", "text": "星期五。时光飞逝，日子过得真快。"}, {"type": "subtitle", "time": 3183.349, "timestamp": "00:53:03", "text": "你根本没注意到，伙计。"}, {"type": "subtitle", "time": 3190.549, "timestamp": "00:53:10", "text": "我认为人们周末都很空闲。"}, {"type": "subtitle", "time": 3192.63, "timestamp": "00:53:12", "text": "所以，我想明天我会去突袭。"}, {"type": "subtitle", "time": 3195.03, "timestamp": "00:53:15", "text": "东西。"}, {"type": "subtitle", "time": 3207.51, "timestamp": "00:53:27", "text": "水。"}, {"type": "subtitle", "time": 3211.27, "timestamp": "00:53:31", "text": "喝水。大家都要补充水分"}, {"type": "subtitle", "time": 3213.19, "timestamp": "00:53:33", "text": "今天。哦，是的。今天的寻宝之旅。是的。"}, {"type": "subtitle", "time": 3222.47, "timestamp": "00:53:42", "text": "还可以跳舞。不。"}, {"type": "subtitle", "time": 3224.592, "timestamp": "00:53:44", "text": "必须这么做。"}, {"type": "subtitle", "time": 3226.39, "timestamp": "00:53:46", "text": "[清嗓子]"}, {"type": "subtitle", "time": 3228.47, "timestamp": "00:53:48", "text": "我们"}, {"type": "subtitle", "time": 3231.349, "timestamp": "00:53:51", "text": "必须做到这一点。上周我"}]
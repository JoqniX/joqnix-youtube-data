[{"type": "subtitle", "time": 12029.99, "timestamp": "03:20:29", "text": "我觉得这是女生才会遇到的问题。"}, {"type": "subtitle", "time": 12039.429, "timestamp": "03:20:39", "text": "或者这可能是 YouTube 的问题。"}, {"type": "subtitle", "time": 12042.07, "timestamp": "03:20:42", "text": "我觉得这是 YouTube 的问题。为什么"}, {"type": "subtitle", "time": 12045.83, "timestamp": "03:20:45", "text": "为什么我现在正在直播？"}, {"type": "subtitle", "time": 12049.83, "timestamp": "03:20:49", "text": "正在被拉走。真蠢。"}, {"type": "subtitle", "time": 12053.19, "timestamp": "03:20:53", "text": "我们不应该中断这个直播流。"}, {"type": "subtitle", "time": 12055.349, "timestamp": "03:20:55", "text": "我不明白。"}, {"type": "subtitle", "time": 12058.309, "timestamp": "03:20:58", "text": "为什么要拉取这个流？它为什么会拉动"}]
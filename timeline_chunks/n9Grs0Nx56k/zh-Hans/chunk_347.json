[{"type": "subtitle", "time": 20822.788, "timestamp": "05:47:02", "text": "手动将其托管在 noa 中。那将"}, {"type": "subtitle", "time": 20824.628, "timestamp": "05:47:04", "text": "做得更好。我不需要向他们索要"}, {"type": "subtitle", "time": 20826.868, "timestamp": "05:47:06", "text": "他们更新了PNG格式。我可以像这样"}, {"type": "subtitle", "time": 20830.548, "timestamp": "05:47:10", "text": "我自己的地方有一件东西，嗯，而且我有它"}, {"type": "subtitle", "time": 20834.39, "timestamp": "05:47:14", "text": "一切都安排妥当了吧？"}, {"type": "subtitle", "time": 20837.99, "timestamp": "05:47:17", "text": "我想到了这一点。"}, {"type": "subtitle", "time": 20840.15, "timestamp": "05:47:20", "text": "所以，"}, {"type": "subtitle", "time": 20842.708, "timestamp": "05:47:22", "text": "就像如果我像他一样想要"}, {"type": "subtitle", "time": 20845.91, "timestamp": "05:47:25", "text": "然后，它还可以动态自动化。"}, {"type": "subtitle", "time": 20853.59, "timestamp": "05:47:33", "text": "例如，呃，就是那张图片，对吧？"}, {"type": "subtitle", "time": 20856.39, "timestamp": "05:47:36", "text": "对于那张图片来说，"}, {"type": "subtitle", "time": 20859.51, "timestamp": "05:47:39", "text": "例如，它将拥有的图像"}, {"type": "subtitle", "time": 20861.75, "timestamp": "05:47:41", "text": "可以复制图片地址，然后它会"}, {"type": "subtitle", "time": 20865.11, "timestamp": "05:47:45", "text": "只需展示概念一即可。"}, {"type": "subtitle", "time": 20870.23, "timestamp": "05:47:50", "text": "正确的？所以，我绝对不会主持这个活动。"}, {"type": "subtitle", "time": 20873.11, "timestamp": "05:47:53", "text": "但我的网站上没有。是的，主持"}, {"type": "subtitle", "time": 20875.19, "timestamp": "05:47:55", "text": "主办方。"}]
[{"type": "subtitle", "time": 5401.27, "timestamp": "01:30:01", "text": "我必须把那个发过去。不，哦，我忘了。"}, {"type": "subtitle", "time": 5406.149, "timestamp": "01:30:06", "text": "等等，我居然忘了这个人。"}, {"type": "subtitle", "time": 5408.149, "timestamp": "01:30:08", "text": "我的天哪，我居然把你忘了。"}, {"type": "subtitle", "time": 5409.669, "timestamp": "01:30:09", "text": "存在过。"}, {"type": "subtitle", "time": 5413.669, "timestamp": "01:30:13", "text": "本地转储路径。"}, {"type": "subtitle", "time": 5417.51, "timestamp": "01:30:17", "text": "哦，我得修一下。我会把它放进去"}, {"type": "subtitle", "time": 5422.07, "timestamp": "01:30:22", "text": "事物。我会手动调整它。"}, {"type": "subtitle", "time": 5428.87, "timestamp": "01:30:28", "text": "它们坏了吗？我的天啊，它在抖动"}, {"type": "subtitle", "time": 5431.312, "timestamp": "01:30:31", "text": "太多了。"}, {"type": "subtitle", "time": 5432.79, "timestamp": "01:30:32", "text": "[笑声]"}, {"type": "subtitle", "time": 5438.229, "timestamp": "01:30:38", "text": "嗯，"}, {"type": "subtitle", "time": 5441.91, "timestamp": "01:30:41", "text": "缩略图网址。呃，本地播客。不，那个"}, {"type": "subtitle", "time": 5443.99, "timestamp": "01:30:43", "text": "男。 [倒吸一口气]"}, {"type": "subtitle", "time": 5453.75, "timestamp": "01:30:53", "text": "是的。我们可以制作比缩略图更多的图片。"}]
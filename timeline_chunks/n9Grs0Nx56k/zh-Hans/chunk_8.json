[{"type": "subtitle", "time": 484.55, "timestamp": "00:08:04", "text": "这个编号基本上是一个Q系统"}, {"type": "subtitle", "time": 487.189, "timestamp": "00:08:07", "text": "在哪里"}, {"type": "subtitle", "time": 490.15, "timestamp": "00:08:10", "text": "首先它会运行"}, {"type": "subtitle", "time": 494.309, "timestamp": "00:08:14", "text": "点击“即将播出的节目”按钮，然后它"}, {"type": "subtitle", "time": 496.07, "timestamp": "00:08:16", "text": "把音乐发送到主地图。"}, {"type": "subtitle", "time": 498.869, "timestamp": "00:08:18", "text": "一二，然后"}, {"type": "subtitle", "time": 501.11, "timestamp": "00:08:21", "text": "呃，如果我……它会等待当前流"}, {"type": "subtitle", "time": 504.39, "timestamp": "00:08:24", "text": "如果我开启直播，它就会运行。"}, {"type": "subtitle", "time": 508.39, "timestamp": "00:08:28", "text": "就像那个，然后"}, {"type": "subtitle", "time": 511.749, "timestamp": "00:08:31", "text": "呃，它应该做的基本上是这样的"}, {"type": "subtitle", "time": 513.67, "timestamp": "00:08:33", "text": "嗯"}, {"type": "subtitle", "time": 516.31, "timestamp": "00:08:36", "text": "啊，我觉得我可以做一个"}, {"type": "subtitle", "time": 519.43, "timestamp": "00:08:39", "text": "不同的跑步按钮或其他什么。"}, {"type": "subtitle", "time": 523.5889999999999, "timestamp": "00:08:43", "text": "你明白我的意思吗？基本上我们就是"}, {"type": "subtitle", "time": 526.389, "timestamp": "00:08:46", "text": "已经在进行相关计算了"}, {"type": "subtitle", "time": 530.389, "timestamp": "00:08:50", "text": "计算当前时间"}, {"type": "subtitle", "time": 532.87, "timestamp": "00:08:52", "text": "就像时间数学之间的差异"}, {"type": "subtitle", "time": 537.03, "timestamp": "00:08:57", "text": "数学 数学 嗯之间的区别"}]
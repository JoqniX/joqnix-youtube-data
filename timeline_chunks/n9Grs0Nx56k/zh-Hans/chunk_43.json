[{"type": "subtitle", "time": 2580.719, "timestamp": "00:43:00", "text": "但这就像我直接买下来一样。"}, {"type": "subtitle", "time": 2587.03, "timestamp": "00:43:07", "text": "呃，我刚才就是这么做的。 [笑声]"}, {"type": "subtitle", "time": 2590.39, "timestamp": "00:43:10", "text": "所以，我不用担心……"}, {"type": "subtitle", "time": 2593.19, "timestamp": "00:43:13", "text": "编织 300k。"}, {"type": "subtitle", "time": 2595.19, "timestamp": "00:43:15", "text": "等等，你是要开公会商店吗？"}, {"type": "subtitle", "time": 2597.349, "timestamp": "00:43:17", "text": "比如不是公会成员？嗯，你在做……"}, {"type": "subtitle", "time": 2602.55, "timestamp": "00:43:22", "text": "交换 Zinder 的东西？你很有钱吗？"}, {"type": "subtitle", "time": 2613.91, "timestamp": "00:43:33", "text": "我"}, {"type": "subtitle", "time": 2616.87, "timestamp": "00:43:36", "text": "是的，这是我唯一的赚钱方式。"}, {"type": "subtitle", "time": 2623.03, "timestamp": "00:43:43", "text": "交易中心嗯……我只是……技能方面"}, {"type": "subtitle", "time": 2625.109, "timestamp": "00:43:45", "text": "图书。啊"}, {"type": "subtitle", "time": 2627.99, "timestamp": "00:43:47", "text": "好的。我唯一能赚钱的方式就是通过获取"}, {"type": "subtitle", "time": 2632.15, "timestamp": "00:43:52", "text": "评级中心编号为无界限制"}, {"type": "subtitle", "time": 2635.03, "timestamp": "00:43:55", "text": "露娜是"}, {"type": "subtitle", "time": 2638.069, "timestamp": "00:43:58", "text": "嗯，公会那玩意儿，公会商店"}]
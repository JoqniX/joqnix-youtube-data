[{"type": "subtitle", "time": 23448.07, "timestamp": "06:30:48", "text": "当它发行的时候，当我听的时候，"}, {"type": "subtitle", "time": 23450.15, "timestamp": "06:30:50", "text": "我完全被它迷住了。"}, {"type": "subtitle", "time": 23453.43, "timestamp": "06:30:53", "text": "歌啊，伙计。我当时就想，“好，我们走吧。”"}, {"type": "subtitle", "time": 23456.948, "timestamp": "06:30:56", "text": "哦，我想学唱这首歌。"}]
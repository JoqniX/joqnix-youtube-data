[{"type": "subtitle", "time": 2760.39, "timestamp": "00:46:00", "text": "追追动漫。太多了。"}, {"type": "subtitle", "time": 2768.87, "timestamp": "00:46:08", "text": "我正在听Fruit乐队的歌。"}, {"type": "subtitle", "time": 2772.39, "timestamp": "00:46:12", "text": "现在我把篮子放进去了，然后我就想，老兄，我……"}, {"type": "subtitle", "time": 2782.55, "timestamp": "00:46:22", "text": "所以，上帝啊，"}, {"type": "subtitle", "time": 2784.87, "timestamp": "00:46:24", "text": "我还要做三天的……"}, {"type": "subtitle", "time": 2788.87, "timestamp": "00:46:28", "text": "世界首领征服。我还没做"}, {"type": "subtitle", "time": 2793.27, "timestamp": "00:46:33", "text": "那一次，[笑声] 就一次。"}, {"type": "subtitle", "time": 2796.15, "timestamp": "00:46:36", "text": "糟糕。是的，大师级试炼即将结束。"}, {"type": "subtitle", "time": 2798.069, "timestamp": "00:46:38", "text": "很快。不，我必须拿到徽章。"}, {"type": "subtitle", "time": 2800.069, "timestamp": "00:46:40", "text": "名片。"}, {"type": "subtitle", "time": 2803.67, "timestamp": "00:46:43", "text": "呃，标题那部分。是的，我必须这么做。"}, {"type": "subtitle", "time": 2807.03, "timestamp": "00:46:47", "text": "很快。今天我完成这件事之后，"}, {"type": "subtitle", "time": 2809.109, "timestamp": "00:46:49", "text": "明天的事，我只会专注于……"}, {"type": "subtitle", "time": 2811.51, "timestamp": "00:46:51", "text": "蓝色协议。"}, {"type": "subtitle", "time": 2815.67, "timestamp": "00:46:55", "text": "不行，我可以等到最后。"}, {"type": "subtitle", "time": 2819.67, "timestamp": "00:46:59", "text": "呃，每周100行"}]
[{"type": "subtitle", "time": 14161.11, "timestamp": "03:56:01", "text": "现在。"}, {"type": "subtitle", "time": 14179.03, "timestamp": "03:56:19", "text": "日程安排和时间，最后一个是"}, {"type": "subtitle", "time": 14181.83, "timestamp": "03:56:21", "text": "描述。"}, {"type": "subtitle", "time": 14183.75, "timestamp": "03:56:23", "text": "好的。现在，我们只需要设置路径。"}, {"type": "subtitle", "time": 14188.15, "timestamp": "03:56:28", "text": "就是这样。美元符号。包起来。"}, {"type": "subtitle", "time": 14199.11, "timestamp": "03:56:39", "text": "包起来。放上去。收到。包起来。"}, {"type": "subtitle", "time": 14203.03, "timestamp": "03:56:43", "text": "放上去。复制此内容。"}, {"type": "subtitle", "time": 14206.469, "timestamp": "03:56:46", "text": "包起来。放上去。它甚至还有一条路"}, {"type": "subtitle", "time": 14210.95, "timestamp": "03:56:50", "text": "出色地。包起来。放上去。但身份证件将会是"}, {"type": "subtitle", "time": 14213.99, "timestamp": "03:56:53", "text": "这。收到。收到。收到。"}]
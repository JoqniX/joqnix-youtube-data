[{"type": "subtitle", "time": 8821.11, "timestamp": "02:27:01", "text": "那么它的运作方式是怎样的呢？"}, {"type": "subtitle", "time": 8825.27, "timestamp": "02:27:05", "text": "它不会检查日程时间。"}, {"type": "subtitle", "time": 8828.87, "timestamp": "02:27:08", "text": "例如，检查创建日期。"}, {"type": "subtitle", "time": 8833.27, "timestamp": "02:27:13", "text": "我先创建了这个直播流，然后我又创建了"}, {"type": "subtitle", "time": 8836.87, "timestamp": "02:27:16", "text": "这个流对吧，所以第一个总是"}, {"type": "subtitle", "time": 8839.349, "timestamp": "02:27:19", "text": "无论如果如何，情况都会是这样。"}, {"type": "subtitle", "time": 8841.349, "timestamp": "02:27:21", "text": "我现在把时间改成未来。"}, {"type": "subtitle", "time": 8843.349, "timestamp": "02:27:23", "text": "如果我更改日程安排时间，那么"}, {"type": "subtitle", "time": 8846.469, "timestamp": "02:27:26", "text": "顺序将是 1 2，即使我"}, {"type": "subtitle", "time": 8849.19, "timestamp": "02:27:29", "text": "现在就创建一个新的流，就像一个新的"}, {"type": "subtitle", "time": 8851.99, "timestamp": "02:27:31", "text": "即将到来的呃，即将开始的直播安排"}, {"type": "subtitle", "time": 8854.87, "timestamp": "02:27:34", "text": "现在分成三份了，但这并不是我们想要的。"}, {"type": "subtitle", "time": 8858.71, "timestamp": "02:27:38", "text": "希望顺序是最新发布的优先。"}, {"type": "subtitle", "time": 8861.75, "timestamp": "02:27:41", "text": "最后一个呃呃，就像老那个一样"}, {"type": "subtitle", "time": 8865.11, "timestamp": "02:27:45", "text": "右下角，所以某种程度上来说，我不是。"}, {"type": "subtitle", "time": 8868.95, "timestamp": "02:27:48", "text": "我正在处理订单，但我还没有。"}, {"type": "subtitle", "time": 8872.63, "timestamp": "02:27:52", "text": "已经完成了，点击 YouTube 按钮。"}, {"type": "subtitle", "time": 8875.51, "timestamp": "02:27:55", "text": "YouTube即将推出的直播活动有吗？"}, {"type": "subtitle", "time": 8878.55, "timestamp": "02:27:58", "text": "尚未解决 我还没有解决订单问题"}]
[{"type": "subtitle", "time": 18720.868, "timestamp": "05:12:00", "text": "不知为何，这个内容缺失了。好的。"}, {"type": "subtitle", "time": 18727.27, "timestamp": "05:12:07", "text": "为什么我会得到一个对象变量？"}, {"type": "subtitle", "time": 18730.23, "timestamp": "05:12:10", "text": "难道不应该是一件完整的事情吗？"}, {"type": "subtitle", "time": 18733.83, "timestamp": "05:12:13", "text": "这是？所以"}, {"type": "subtitle", "time": 18735.43, "timestamp": "05:12:15", "text": "喜欢"}, {"type": "subtitle", "time": 18737.03, "timestamp": "05:12:17", "text": "按钮"}, {"type": "subtitle", "time": 18742.788, "timestamp": "05:12:22", "text": "它不应该是个按钮吗？"}, {"type": "subtitle", "time": 18754.788, "timestamp": "05:12:34", "text": "因为里面有冷凝水。但"}, {"type": "subtitle", "time": 18759.19, "timestamp": "05:12:39", "text": "还是我理解错了？我的天啊。"}, {"type": "subtitle", "time": 18761.75, "timestamp": "05:12:41", "text": "是的，这是个典故。好的。所以，就是这样。"}, {"type": "subtitle", "time": 18764.948, "timestamp": "05:12:44", "text": "这是一个物体，"}, {"type": "subtitle", "time": 18769.43, "timestamp": "05:12:49", "text": "不是一个变量。是的。所以，"}, {"type": "subtitle", "time": 18775.51, "timestamp": "05:12:55", "text": "入口"}, {"type": "subtitle", "time": 18778.23, "timestamp": "05:12:58", "text": "排"}]
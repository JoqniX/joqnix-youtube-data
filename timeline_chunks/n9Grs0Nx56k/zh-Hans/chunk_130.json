[{"type": "subtitle", "time": 7802.95, "timestamp": "02:10:02", "text": "已经这样了吗？有。不，我没有"}, {"type": "subtitle", "time": 7805.91, "timestamp": "02:10:05", "text": "我也这么认为。"}, {"type": "subtitle", "time": 7808.149, "timestamp": "02:10:08", "text": "您是指增加一个进行中"}, {"type": "subtitle", "time": 7812.629, "timestamp": "02:10:12", "text": "像 Discord 机器人一样直播宣布"}, {"type": "subtitle", "time": 7814.229, "timestamp": "02:10:14", "text": "你的直播之类的？那是"}, {"type": "subtitle", "time": 7817.189, "timestamp": "02:10:17", "text": "不同的。这不一样。"}, {"type": "subtitle", "time": 7819.43, "timestamp": "02:10:19", "text": "那都是些基本常识。 [音乐]"}, {"type": "subtitle", "time": 7823.03, "timestamp": "02:10:23", "text": "我想要更多更详细的信息，更多"}, {"type": "subtitle", "time": 7825.35, "timestamp": "02:10:25", "text": "先进的自动化设备。这就是我的原因"}, {"type": "chat", "time": 7829.683, "timestamp": "02:10:29", "author": "@TheDivineGokuBlack", "avatar": "https://yt4.ggpht.com/x2pzeEVaf1zyUBkZCrzTAzUJCua_ZlOHqOBCVhiADyCWmaW54l65hftnOmbOFY2vCGVSXGk5Ng=s64-c-k-c0x00ffffff-no-rj", "message": "so we making big brain moves"}, {"type": "subtitle", "time": 7829.75, "timestamp": "02:10:29", "text": "这样做。那个还可以，但是"}, {"type": "subtitle", "time": 7833.669, "timestamp": "02:10:33", "text": "这对YouTube来说尤其糟糕。"}, {"type": "subtitle", "time": 7835.75, "timestamp": "02:10:35", "text": "尤其"}, {"type": "subtitle", "time": 7839.35, "timestamp": "02:10:39", "text": "为了 Twitch。 Twitch 很好。"}, {"type": "subtitle", "time": 7841.669, "timestamp": "02:10:41", "text": "对 YouTube 来说，这很糟糕，因为……"}, {"type": "subtitle", "time": 7843.91, "timestamp": "02:10:43", "text": "YouTube API，你知道，它的工作原理是"}, {"type": "subtitle", "time": 7847.91, "timestamp": "02:10:47", "text": "好像它不会让你……它不会"}, {"type": "subtitle", "time": 7850.55, "timestamp": "02:10:50", "text": "让对方知道你在线"}, {"type": "subtitle", "time": 7854.069, "timestamp": "02:10:54", "text": "是直播还是视频，或者是YouTube视频？"}, {"type": "subtitle", "time": 7858.31, "timestamp": "02:10:58", "text": "射击？不。所以我不需要我的播音员"}]
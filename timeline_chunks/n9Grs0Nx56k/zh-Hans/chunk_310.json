[{"type": "subtitle", "time": 18601.35, "timestamp": "05:10:01", "text": "其次，去做这件事。"}, {"type": "subtitle", "time": 18605.03, "timestamp": "05:10:05", "text": "兄弟。我的天啊。我要翻身了。"}, {"type": "subtitle", "time": 18610.47, "timestamp": "05:10:10", "text": "241. 241 发生了什么事？ 241. 241."}, {"type": "subtitle", "time": 18618.708, "timestamp": "05:10:18", "text": "这让原本就很艰难的处境雪上加霜。"}, {"type": "subtitle", "time": 18656.788, "timestamp": "05:10:56", "text": "哦，它建成了。哦，它确实建造了它。好的。"}]
[{"type": "subtitle", "time": 4926.87, "timestamp": "01:22:06", "text": "我今天状态超棒。没有日语"}, {"type": "subtitle", "time": 4930.629, "timestamp": "01:22:10", "text": "冲突。呃，我的老师，我的师傅是呃"}, {"type": "subtitle", "time": 4934.39, "timestamp": "01:22:14", "text": "生病的。所以从17号开始就会有课了。"}, {"type": "subtitle", "time": 4936.87, "timestamp": "01:22:16", "text": "星期日。是的，星期天有课。"}, {"type": "subtitle", "time": 4939.27, "timestamp": "01:22:19", "text": "哦，晚上没有直播。"}, {"type": "subtitle", "time": 4941.27, "timestamp": "01:22:21", "text": "可惜，星期天。"}, {"type": "subtitle", "time": 4945.43, "timestamp": "01:22:25", "text": "是的。哦，是的。所以放两天假。不"}, {"type": "subtitle", "time": 4947.03, "timestamp": "01:22:27", "text": "课程。所以我打算直播……"}, {"type": "subtitle", "time": 4950.07, "timestamp": "01:22:30", "text": "傍晚这个时候左右。"}, {"type": "subtitle", "time": 4963.91, "timestamp": "01:22:43", "text": "哦，17号是星期一。等等，什么？"}, {"type": "subtitle", "time": 4966.47, "timestamp": "01:22:46", "text": "哦，16号。对不起。对不起。 16日哦，是的。"}]
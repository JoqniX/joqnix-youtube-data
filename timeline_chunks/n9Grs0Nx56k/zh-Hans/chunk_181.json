[{"type": "subtitle", "time": 10875.11, "timestamp": "03:01:15", "text": "好的。所以，我必须发送这个"}, {"type": "subtitle", "time": 10877.269, "timestamp": "03:01:17", "text": "正确的。呃"}, {"type": "subtitle", "time": 10879.429, "timestamp": "03:01:19", "text": "兄弟，我们越来越深入地了解"}, {"type": "subtitle", "time": 10881.429, "timestamp": "03:01:21", "text": "问题。"}, {"type": "subtitle", "time": 10885.67, "timestamp": "03:01:25", "text": "我不明白。我们有多少个问题？"}, {"type": "subtitle", "time": 10888.309, "timestamp": "03:01:28", "text": "我现在必须处理的事情有哪些？"}, {"type": "subtitle", "time": 10894.63, "timestamp": "03:01:34", "text": "太疯狂了"}, {"type": "subtitle", "time": 10896.55, "timestamp": "03:01:36", "text": "地位"}, {"type": "subtitle", "time": 10899.51, "timestamp": "03:01:39", "text": "就像[音乐]地位一样。好的。多少"}, {"type": "subtitle", "time": 10908.15, "timestamp": "03:01:48", "text": "我只需要接下来的事情。就这样。"}, {"type": "subtitle", "time": 10910.63, "timestamp": "03:01:50", "text": "你只需要存在。"}]
[{"type": "subtitle", "time": 663.19, "timestamp": "00:11:03", "text": "无论何时我"}, {"type": "subtitle", "time": 665.509, "timestamp": "00:11:05", "text": "我认为这应该交给我的员工。"}, {"type": "subtitle", "time": 668.31, "timestamp": "00:11:08", "text": "频道，比如其中一个就通往我的频道"}, {"type": "subtitle", "time": 671.372, "timestamp": "00:11:11", "text": "员工频道。所以，"}, {"type": "subtitle", "time": 671.91, "timestamp": "00:11:11", "text": "[音乐]"}, {"type": "subtitle", "time": 674.87, "timestamp": "00:11:14", "text": "每次我结束直播，它都会变成"}, {"type": "subtitle", "time": 677.99, "timestamp": "00:11:17", "text": "就像生成一份报告一样。"}, {"type": "subtitle", "time": 679.75, "timestamp": "00:11:19", "text": "直播标题是什么？溪流"}, {"type": "subtitle", "time": 681.59, "timestamp": "00:11:21", "text": "长度，我今天在哪里直播，什么"}, {"type": "subtitle", "time": 685.269, "timestamp": "00:11:25", "text": "OBS配置文件，崩溃了多少次？"}, {"type": "subtitle", "time": 688.069, "timestamp": "00:11:28", "text": "确实存在，比如帧率下降的情况。"}, {"type": "subtitle", "time": 693.509, "timestamp": "00:11:33", "text": "在 OBS 中，以及所有类似事件日志之类的东西"}, {"type": "subtitle", "time": 698.55, "timestamp": "00:11:38", "text": "那个东西，我还发送了文件。"}, {"type": "subtitle", "time": 702.389, "timestamp": "00:11:42", "text": "OBS 设备连接到我的员工频道"}, {"type": "subtitle", "time": 704.23, "timestamp": "00:11:44", "text": "后退。"}, {"type": "subtitle", "time": 706.87, "timestamp": "00:11:46", "text": "是的，这以前就像个按钮。"}, {"type": "subtitle", "time": 709.829, "timestamp": "00:11:49", "text": "这指的是技术方面的问题。"}, {"type": "subtitle", "time": 714.069, "timestamp": "00:11:54", "text": "我以前好像做过调试工作。我认为"}, {"type": "subtitle", "time": 716.31, "timestamp": "00:11:56", "text": "版主也能看到。很久"}, {"type": "subtitle", "time": 719.509, "timestamp": "00:11:59", "text": "我记得很久以前我就做到了。所以，基本上就是这样。"}]
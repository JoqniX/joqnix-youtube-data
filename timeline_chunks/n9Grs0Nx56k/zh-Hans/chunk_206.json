[{"type": "subtitle", "time": 12361.67, "timestamp": "03:26:01", "text": "某物。"}, {"type": "subtitle", "time": 12364.63, "timestamp": "03:26:04", "text": "所以我就想"}, {"type": "subtitle", "time": 12367.187, "timestamp": "03:26:07", "text": "不过这次我无能为力。"}, {"type": "subtitle", "time": 12368.15, "timestamp": "03:26:08", "text": "[笑声]"}, {"type": "subtitle", "time": 12371.11, "timestamp": "03:26:11", "text": "我可以联系的人数以及"}, {"type": "subtitle", "time": 12374.15, "timestamp": "03:26:14", "text": "与此有联系。哦，天哪"}, {"type": "subtitle", "time": 12375.99, "timestamp": "03:26:15", "text": "得到"}, {"type": "subtitle", "time": 12381.11, "timestamp": "03:26:21", "text": "搞砸了。自从[音乐]那玩意儿"}, {"type": "subtitle", "time": 12384.07, "timestamp": "03:26:24", "text": "我错过了“搞砸了，是啊”。自那以后"}, {"type": "subtitle", "time": 12386.79, "timestamp": "03:26:26", "text": "那件事确实发生过。"}, {"type": "subtitle", "time": 12391.19, "timestamp": "03:26:31", "text": "所以，我不能再做那些事了。"}, {"type": "subtitle", "time": 12393.349, "timestamp": "03:26:33", "text": "但我不知道。"}, {"type": "subtitle", "time": 12395.349, "timestamp": "03:26:35", "text": "我之前忙着让自己不至于崩溃。"}, {"type": "subtitle", "time": 12398.07, "timestamp": "03:26:38", "text": "今年。我觉得自己错过了什么。我"}, {"type": "subtitle", "time": 12401.248, "timestamp": "03:26:41", "text": "真希望我早点发现它。一个"}]
[{"type": "subtitle", "time": 2224.15, "timestamp": "00:37:04", "text": "戴安娜，好好休息。好好休息。"}, {"type": "subtitle", "time": 2226.71, "timestamp": "00:37:06", "text": "好好休息"}, {"type": "subtitle", "time": 2229.829, "timestamp": "00:37:09", "text": "放松一下。 D，"}, {"type": "subtitle", "time": 2232.55, "timestamp": "00:37:12", "text": "你今天玩《蓝色协议》了吗？"}, {"type": "subtitle", "time": 2234.79, "timestamp": "00:37:14", "text": "我好像看到了你的消息。我跳了起来"}, {"type": "subtitle", "time": 2237.91, "timestamp": "00:37:17", "text": "大概待了五分钟。呃，只是想"}, {"type": "subtitle", "time": 2240.79, "timestamp": "00:37:20", "text": "查看。"}, {"type": "subtitle", "time": 2242.95, "timestamp": "00:37:22", "text": "呃，我想我在……看到了你的消息。"}, {"type": "subtitle", "time": 2245.99, "timestamp": "00:37:25", "text": "公会聊天。"}, {"type": "subtitle", "time": 2250.39, "timestamp": "00:37:30", "text": "我刚完成了不稳定任务和公会任务。"}, {"type": "subtitle", "time": 2254.63, "timestamp": "00:37:34", "text": "事情太多，我就辞职了。 [音乐] 我得试试 哦，"}, {"type": "subtitle", "time": 2257.75, "timestamp": "00:37:37", "text": "我忘了神秘顾客那件事。我需要"}, {"type": "subtitle", "time": 2260.15, "timestamp": "00:37:40", "text": "我晚上会做。"}, {"type": "subtitle", "time": 2263.696, "timestamp": "00:37:43", "text": "跨性别之谜终于解开了。"}, {"type": "subtitle", "time": 2268.95, "timestamp": "00:37:48", "text": "现在有好多事情要做。是否有任何"}, {"type": "subtitle", "time": 2273.27, "timestamp": "00:37:53", "text": "服务器端发生了什么事件？我 我 我"}, {"type": "subtitle", "time": 2276.069, "timestamp": "00:37:56", "text": "唉，一个活动都没能参加。我"}, {"type": "subtitle", "time": 2279.589, "timestamp": "00:37:59", "text": "感觉糟透了。"}]
[{"type": "subtitle", "time": 7982.31, "timestamp": "02:13:02", "text": "是的。你看，如果我上传它，它就会"}, {"type": "subtitle", "time": 7985.51, "timestamp": "02:13:05", "text": "去做。所以我以前只用Safire B"}, {"type": "subtitle", "time": 7989.669, "timestamp": "02:13:09", "text": "仅限V频道上传，因为当时就是这样"}, {"type": "subtitle", "time": 7993.91, "timestamp": "02:13:13", "text": "普通事都让人厌烦。继续"}, {"type": "subtitle", "time": 7995.83, "timestamp": "02:13:15", "text": "一直发出ping和ping之类的信号。是什么"}, {"type": "subtitle", "time": 7998.55, "timestamp": "02:13:18", "text": "我的鼠标怎么了？"}, {"type": "subtitle", "time": 8001.589, "timestamp": "02:13:21", "text": "哦，是的。对，就是这个。不，是蓝宝石的"}, {"type": "subtitle", "time": 8004.149, "timestamp": "02:13:24", "text": "Twitch的通知功能真的很好用。经过"}, {"type": "subtitle", "time": 8007.75, "timestamp": "02:13:27", "text": "是的，这让我受到了启发。"}, {"type": "subtitle", "time": 8010.069, "timestamp": "02:13:30", "text": "我要做个公告。正确的"}, {"type": "subtitle", "time": 8013.589, "timestamp": "02:13:33", "text": "现在，我结束工作后正在做的事情"}, {"type": "subtitle", "time": 8016.39, "timestamp": "02:13:36", "text": "直播的时候，只有当我直播的时候。"}, {"type": "subtitle", "time": 8019.589, "timestamp": "02:13:39", "text": "Twitch嵌入功能完美运行。喜欢"}, {"type": "subtitle", "time": 8021.35, "timestamp": "02:13:41", "text": "直播时，它会显示"}, {"type": "subtitle", "time": 8024.95, "timestamp": "02:13:44", "text": "直播流的动态缩略图。"}, {"type": "subtitle", "time": 8028.79, "timestamp": "02:13:48", "text": "是的。嗯，是的，当一切结束时"}, {"type": "subtitle", "time": 8031.51, "timestamp": "02:13:51", "text": "直播结束了，它编辑了内容。"}, {"type": "subtitle", "time": 8033.83, "timestamp": "02:13:53", "text": "告诉你它属于哪个类别"}, {"type": "subtitle", "time": 8036.709, "timestamp": "02:13:56", "text": "流被传输，V。有多少"}, {"type": "subtitle", "time": 8038.87, "timestamp": "02:13:58", "text": "我直播了几个小时，然后我去了"}]
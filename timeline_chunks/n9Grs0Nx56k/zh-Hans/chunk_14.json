[{"type": "subtitle", "time": 842.23, "timestamp": "00:14:02", "text": "根据他们的时区欢迎他们"}, {"type": "subtitle", "time": 845.99, "timestamp": "00:14:05", "text": "比如，呃呃，比如，嗨，jock，如果是的话"}, {"type": "subtitle", "time": 848.47, "timestamp": "00:14:08", "text": "对我来说，就像夜晚会说“你好”一样。"}, {"type": "subtitle", "time": 851.509, "timestamp": "00:14:11", "text": "下一个运动员，欢迎来到直播间，希望你"}, {"type": "subtitle", "time": 853.75, "timestamp": "00:14:13", "text": "祝你有个美好的夜晚，或者类似的话。"}, {"type": "subtitle", "time": 856.31, "timestamp": "00:14:16", "text": "基于用户的自动回复"}, {"type": "subtitle", "time": 857.829, "timestamp": "00:14:17", "text": "时间"}, {"type": "subtitle", "time": 859.75, "timestamp": "00:14:19", "text": "但现在这一切都坏了，我不得不……"}, {"type": "subtitle", "time": 862.71, "timestamp": "00:14:22", "text": "全部改头换面。然后我还做了什么？"}, {"type": "subtitle", "time": 864.55, "timestamp": "00:14:24", "text": "工作内容？"}, {"type": "subtitle", "time": 867.829, "timestamp": "00:14:27", "text": "萨米将永存。 [笑声]"}, {"type": "subtitle", "time": 869.43, "timestamp": "00:14:29", "text": "嘿，我有点分心了。好的，回来"}, {"type": "subtitle", "time": 872.629, "timestamp": "00:14:32", "text": "去工作。好的，等等。对不起。返回"}, {"type": "subtitle", "time": 883.829, "timestamp": "00:14:43", "text": "主要是一些提升生活质量方面的东西。"}, {"type": "subtitle", "time": 888.79, "timestamp": "00:14:48", "text": "还没完成。我这就安排我的"}, {"type": "subtitle", "time": 894.069, "timestamp": "00:14:54", "text": "按钮。所以，看起来更整洁。"}, {"type": "subtitle", "time": 897.35, "timestamp": "00:14:57", "text": "我知道我会直播宣布"}]
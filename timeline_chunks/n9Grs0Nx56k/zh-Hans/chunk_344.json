[{"type": "subtitle", "time": 20641.27, "timestamp": "05:44:01", "text": "行不通。我必须"}, {"type": "subtitle", "time": 20644.708, "timestamp": "05:44:04", "text": "提交一个 GitHub 拉取请求，而不是拉取请求。"}, {"type": "subtitle", "time": 20647.51, "timestamp": "05:44:07", "text": "请求拉取，或者就此创建一个 issue"}, {"type": "subtitle", "time": 20651.11, "timestamp": "05:44:11", "text": "然后问问为什么它不起作用，或者"}, {"type": "subtitle", "time": 20654.548, "timestamp": "05:44:14", "text": "OBS 的某些功能也需要修复。"}, {"type": "subtitle", "time": 20656.948, "timestamp": "05:44:16", "text": "因为 OBS 确实会这样做，他们说他们会着手解决这个问题。"}, {"type": "subtitle", "time": 20660.47, "timestamp": "05:44:20", "text": "它将在 OBS 的下一次重大更新中亮相。"}, {"type": "subtitle", "time": 20662.39, "timestamp": "05:44:22", "text": "几个月左右吧，目前是这样。"}, {"type": "subtitle", "time": 20664.39, "timestamp": "05:44:24", "text": "他们不打算修复它之类的"}, {"type": "subtitle", "time": 20668.098, "timestamp": "05:44:28", "text": "他说完，我就想，真倒霉。"}, {"type": "subtitle", "time": 20670.07, "timestamp": "05:44:30", "text": "[笑声] 我不在家的时候也想要我的V"}, {"type": "subtitle", "time": 20674.39, "timestamp": "05:44:34", "text": "从呃，直播的时候，我就像"}, {"type": "subtitle", "time": 20676.628, "timestamp": "05:44:36", "text": "呃，不在直播里，我正在……"}, {"type": "subtitle", "time": 20680.548, "timestamp": "05:44:40", "text": "休息一下，我想让我的V现在玩游戏。"}, {"type": "subtitle", "time": 20682.548, "timestamp": "05:44:42", "text": "是的。所以，我目前的情况也一样。"}, {"type": "subtitle", "time": 20684.948, "timestamp": "05:44:44", "text": "类似第四版的系统，就像最后"}, {"type": "subtitle", "time": 20687.11, "timestamp": "05:44:47", "text": "我创建的联合办公流程取决于"}, {"type": "subtitle", "time": 20690.548, "timestamp": "05:44:50", "text": "关于类别或哪个流类别"}, {"type": "subtitle", "time": 20693.27, "timestamp": "05:44:53", "text": "我正在操作，它会进行随机化"}, {"type": "subtitle", "time": 20695.59, "timestamp": "05:44:55", "text": "播放列表之类的东西。是的。然后我会"}, {"type": "subtitle", "time": 20698.548, "timestamp": "05:44:58", "text": "我会把版本一添加进去，就像……"}]
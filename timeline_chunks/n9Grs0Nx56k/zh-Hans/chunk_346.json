[{"type": "subtitle", "time": 20768.868, "timestamp": "05:46:08", "text": "为什么关机了？哦，是的。没有更新"}, {"type": "subtitle", "time": 20772.15, "timestamp": "05:46:12", "text": "他们的 API 大概是上个月推出的。"}, {"type": "subtitle", "time": 20780.948, "timestamp": "05:46:20", "text": "9月3日。是的，他们变了"}, {"type": "subtitle", "time": 20782.628, "timestamp": "05:46:22", "text": "它。他们引入了一种叫做"}, {"type": "subtitle", "time": 20784.948, "timestamp": "05:46:24", "text": "数据来源。"}, {"type": "subtitle", "time": 20787.19, "timestamp": "05:46:27", "text": "他们修改了数据库方面的信息。所以"}, {"type": "subtitle", "time": 20789.75, "timestamp": "05:46:29", "text": "我必须改变很多事情。我的"}, {"type": "subtitle", "time": 20791.59, "timestamp": "05:46:31", "text": "基于概念的事物，对吧？就像"}, {"type": "subtitle", "time": 20795.19, "timestamp": "05:46:35", "text": "合作方，那个数据库，这个东西"}, {"type": "subtitle", "time": 20798.07, "timestamp": "05:46:38", "text": "我的网站上有所有内容"}, {"type": "subtitle", "time": 20800.548, "timestamp": "05:46:40", "text": "我曾合作过的 YouTuber。哦，是的。"}, {"type": "subtitle", "time": 20803.19, "timestamp": "05:46:43", "text": "龙骑士，你在这里。"}, {"type": "subtitle", "time": 20806.708, "timestamp": "05:46:46", "text": "呃，这些我也得修好。"}, {"type": "subtitle", "time": 20809.59, "timestamp": "05:46:49", "text": "东西。另外，我还会添加类似……"}, {"type": "subtitle", "time": 20811.83, "timestamp": "05:46:51", "text": "我可以点击那个人的……"}, {"type": "subtitle", "time": 20816.47, "timestamp": "05:46:56", "text": "输入名字，它会显示所有嗯嗯嗯"}, {"type": "subtitle", "time": 20819.27, "timestamp": "05:46:59", "text": "因为我必须这样做，所以需要这个人的头像。"}]
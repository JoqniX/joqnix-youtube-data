[{"type": "subtitle", "time": 2522.15, "timestamp": "00:42:02", "text": "是的，我我我"}, {"type": "subtitle", "time": 2525.75, "timestamp": "00:42:05", "text": "我什么都没收到。人们如何"}, {"type": "subtitle", "time": 2530.39, "timestamp": "00:42:10", "text": "收到这么多账单？"}, {"type": "subtitle", "time": 2534.23, "timestamp": "00:42:14", "text": "人们不像上帝那样对待贾纳"}, {"type": "subtitle", "time": 2537.19, "timestamp": "00:42:17", "text": "太难了。"}, {"type": "subtitle", "time": 2549.27, "timestamp": "00:42:29", "text": "哦，是的。哦，是的。你完成你的"}, {"type": "subtitle", "time": 2552.069, "timestamp": "00:42:32", "text": "生活技能方面的东西？你升到20级了吗？"}, {"type": "subtitle", "time": 2556.069, "timestamp": "00:42:36", "text": "像他们中的一些人一样达到最高等级了吗？"}, {"type": "subtitle", "time": 2559.829, "timestamp": "00:42:39", "text": "你知道吗，昨天我刚保留了我的PCFK"}, {"type": "subtitle", "time": 2564.39, "timestamp": "00:42:44", "text": "就像亚麻变成纱线一样，对吧？"}, {"type": "subtitle", "time": 2568.71, "timestamp": "00:42:48", "text": "是的。我当时有999根毛线。"}, {"type": "subtitle", "time": 2571.75, "timestamp": "00:42:51", "text": "东西。我做了。然后我就进去了。"}, {"type": "subtitle", "time": 2574.15, "timestamp": "00:42:54", "text": "早上我把它全部转换了。"}, {"type": "subtitle", "time": 2577.829, "timestamp": "00:42:57", "text": "将其加工成精制棉。"}]
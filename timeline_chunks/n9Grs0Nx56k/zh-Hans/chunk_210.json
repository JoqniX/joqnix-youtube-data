[{"type": "subtitle", "time": 12601.99, "timestamp": "03:30:01", "text": "然后把“single”替换成“single”。"}, {"type": "subtitle", "time": 12604.95, "timestamp": "03:30:04", "text": "更新，因为这条信息正在发送中"}, {"type": "subtitle", "time": 12608.389, "timestamp": "03:30:08", "text": "这是第二次了。所以"}, {"type": "subtitle", "time": 12617.83, "timestamp": "03:30:17", "text": "无需等待。"}, {"type": "subtitle", "time": 12620.55, "timestamp": "03:30:20", "text": "呃（叹气和倒吸气声）"}, {"type": "subtitle", "time": 12623.429, "timestamp": "03:30:23", "text": "不不不不不。"}, {"type": "subtitle", "time": 12625.99, "timestamp": "03:30:25", "text": "M."}, {"type": "subtitle", "time": 12627.75, "timestamp": "03:30:27", "text": "哦，像这样，好吧好吧，我"}, {"type": "subtitle", "time": 12629.51, "timestamp": "03:30:29", "text": "理解。"}, {"type": "subtitle", "time": 12632.389, "timestamp": "03:30:32", "text": "所以"}, {"type": "subtitle", "time": 12633.99, "timestamp": "03:30:33", "text": "这"}, {"type": "subtitle", "time": 12637.11, "timestamp": "03:30:37", "text": "以上就是所有更新内容。"}, {"type": "subtitle", "time": 12641.59, "timestamp": "03:30:41", "text": "部分。好吧，我把它写成了“哦，等等”。"}, {"type": "subtitle", "time": 12648.71, "timestamp": "03:30:48", "text": "我复制了所有更新路径。我把它放进去了"}, {"type": "subtitle", "time": 12650.71, "timestamp": "03:30:50", "text": "这里"}, {"type": "subtitle", "time": 12654.95, "timestamp": "03:30:54", "text": "就按这个样子做。"}]
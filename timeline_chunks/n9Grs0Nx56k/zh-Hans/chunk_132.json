[{"type": "subtitle", "time": 7920.79, "timestamp": "02:12:00", "text": "我可以找到旧的。我用了嗯我"}, {"type": "subtitle", "time": 7924.149, "timestamp": "02:12:04", "text": "过去常常用呃"}, {"type": "subtitle", "time": 7926.87, "timestamp": "02:12:06", "text": "蓝宝石 B. [音乐] 有人会说，"}, {"type": "subtitle", "time": 7937.43, "timestamp": "02:12:17", "text": "但你现在必须付款。这就是我的原因"}, {"type": "subtitle", "time": 7940.31, "timestamp": "02:12:20", "text": "不想做。"}, {"type": "subtitle", "time": 7941.99, "timestamp": "02:12:21", "text": "支持直播和首映。"}, {"type": "subtitle", "time": 7945.35, "timestamp": "02:12:25", "text": "是啊，这个我不知道怎么做，但是……"}, {"type": "subtitle", "time": 7947.51, "timestamp": "02:12:27", "text": "他们支持直播首映。"}, {"type": "subtitle", "time": 7949.43, "timestamp": "02:12:29", "text": "出色地。我不知道这怎么可能，"}, {"type": "subtitle", "time": 7953.43, "timestamp": "02:12:33", "text": "但我会自己实现自动化。"}, {"type": "subtitle", "time": 7956.47, "timestamp": "02:12:36", "text": "我会留下这个机器人，但你必须付费。"}, {"type": "subtitle", "time": 7958.39, "timestamp": "02:12:38", "text": "高级版"}, {"type": "subtitle", "time": 7962.149, "timestamp": "02:12:42", "text": "正确的？高级版多少钱？"}, {"type": "subtitle", "time": 7964.79, "timestamp": "02:12:44", "text": "每月10美元。"}, {"type": "subtitle", "time": 7968.229, "timestamp": "02:12:48", "text": "所以我就说，不。以及自由"}, {"type": "subtitle", "time": 7971.35, "timestamp": "02:12:51", "text": "蓝宝石版本，表现相当糟糕。"}]
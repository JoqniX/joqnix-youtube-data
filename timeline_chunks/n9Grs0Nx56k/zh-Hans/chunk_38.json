[{"type": "subtitle", "time": 2290.15, "timestamp": "00:38:10", "text": "我错过了这个。"}, {"type": "subtitle", "time": 2297.91, "timestamp": "00:38:17", "text": "所以，"}, {"type": "subtitle", "time": 2300.15, "timestamp": "00:38:20", "text": "80级装备什么时候出？"}, {"type": "subtitle", "time": 2311.91, "timestamp": "00:38:31", "text": "现在游戏节奏太快了！"}, {"type": "subtitle", "time": 2315.03, "timestamp": "00:38:35", "text": "已经达到80级了。它是"}, {"type": "subtitle", "time": 2318.069, "timestamp": "00:38:38", "text": "等等，我觉得"}, {"type": "subtitle", "time": 2320.39, "timestamp": "00:38:40", "text": "我认为国服版本已经……"}, {"type": "subtitle", "time": 2322.069, "timestamp": "00:38:42", "text": "级别，000。"}, {"type": "subtitle", "time": 2324.31, "timestamp": "00:38:44", "text": "不，不是一千个，也不是一百个，或者更多。"}, {"type": "subtitle", "time": 2328.47, "timestamp": "00:38:48", "text": "正确的？哇。"}, {"type": "subtitle", "time": 2331.67, "timestamp": "00:38:51", "text": "还有技能点相关的内容。不。你怎么做？"}, {"type": "subtitle", "time": 2334.79, "timestamp": "00:38:54", "text": "你能获得天赋点数吗？"}, {"type": "subtitle", "time": 2338.79, "timestamp": "00:38:58", "text": "我觉得我没能通过最后一次试炼。"}]
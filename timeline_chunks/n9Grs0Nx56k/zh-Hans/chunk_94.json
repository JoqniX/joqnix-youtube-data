[{"type": "subtitle", "time": 5648.87, "timestamp": "01:34:08", "text": "实际上，我会把它放在这里。我不知道"}, {"type": "subtitle", "time": 5651.669, "timestamp": "01:34:11", "text": "为什么我需要再次更新字段？患病的"}, {"type": "subtitle", "time": 5653.83, "timestamp": "01:34:13", "text": "只是"}, {"type": "subtitle", "time": 5660.79, "timestamp": "01:34:20", "text": "所以这次更新是这样的，对吧？呃，我会"}, {"type": "subtitle", "time": 5667.83, "timestamp": "01:34:27", "text": "用于缩略图硬币。你到这里"}, {"type": "subtitle", "time": 5670.709, "timestamp": "01:34:30", "text": "下。"}, {"type": "subtitle", "time": 5694.87, "timestamp": "01:34:54", "text": "它会成功两次吗？那是我的"}, {"type": "subtitle", "time": 5698.07, "timestamp": "01:34:58", "text": "怀疑。我不想让它发生两次。"}, {"type": "subtitle", "time": 5699.99, "timestamp": "01:34:59", "text": "我只是希望音乐能发挥它应有的作用。"}]
[{"type": "subtitle", "time": 722.949, "timestamp": "00:12:02", "text": "它应有尽有。嗯，就像每当我"}, {"type": "subtitle", "time": 726.47, "timestamp": "00:12:06", "text": "OBS是否有任何问题，呃，时间戳"}, {"type": "subtitle", "time": 728.629, "timestamp": "00:12:08", "text": "当时，当我切换视频流时"}, {"type": "subtitle", "time": 731.91, "timestamp": "00:12:11", "text": "当我开启模糊模式时，眼前的景象是这样的："}, {"type": "subtitle", "time": 734.23, "timestamp": "00:12:14", "text": "我以前有个应急模糊装置。"}, {"type": "subtitle", "time": 738.949, "timestamp": "00:12:18", "text": "想当年。我记得这件事。我"}, {"type": "subtitle", "time": 741.91, "timestamp": "00:12:21", "text": "以前经常泄露自己的个人信息。比如，呃，不是"}, {"type": "subtitle", "time": 744.949, "timestamp": "00:12:24", "text": "像展示自己一样，呃，就像一些"}, {"type": "subtitle", "time": 746.87, "timestamp": "00:12:26", "text": "我不该拥有的不想要的东西"}, {"type": "subtitle", "time": 749.509, "timestamp": "00:12:29", "text": "直播过程中意外弹出显示。"}, {"type": "subtitle", "time": 752.31, "timestamp": "00:12:32", "text": "然后我必须按下钢琴上的一个键。"}, {"type": "subtitle", "time": 754.79, "timestamp": "00:12:34", "text": "比如音乐中的升C调之类的，它"}, {"type": "subtitle", "time": 757.833, "timestamp": "00:12:37", "text": "会自动模糊我的屏幕"}, {"type": "subtitle", "time": 758.949, "timestamp": "00:12:38", "text": "[笑声和喘息声] 或者别的什么。是的，"}, {"type": "subtitle", "time": 762.31, "timestamp": "00:12:42", "text": "我怀念那些东西。我有吗？"}, {"type": "subtitle", "time": 765.99, "timestamp": "00:12:45", "text": "谢谢您的解答。嗯？欢迎光临。"}, {"type": "subtitle", "time": 768.389, "timestamp": "00:12:48", "text": "那段时间我还在使用MIDI设备。"}, {"type": "subtitle", "time": 772.15, "timestamp": "00:12:52", "text": "用作我的宏流卡组或其他什么"}, {"type": "subtitle", "time": 774.389, "timestamp": "00:12:54", "text": "就是这样。我觉得就在这里，或者"}, {"type": "subtitle", "time": 776.15, "timestamp": "00:12:56", "text": "某物。"}, {"type": "subtitle", "time": 779.59, "timestamp": "00:12:59", "text": "呃，开始垂直方向的模糊效果。是吗？"}]
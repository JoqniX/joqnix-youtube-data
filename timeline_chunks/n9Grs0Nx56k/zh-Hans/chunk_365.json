[{"type": "subtitle", "time": 21903.51, "timestamp": "06:05:03", "text": "即使事件 ID 存在，也不一定有效。"}, {"type": "subtitle", "time": 21907.11, "timestamp": "06:05:07", "text": "它存在就会创建事件，对吧？"}, {"type": "subtitle", "time": 21910.15, "timestamp": "06:05:10", "text": "以及它是如何创造出那个东西的，"}, {"type": "subtitle", "time": 21914.47, "timestamp": "06:05:14", "text": "创建逻辑是否也会进行修补？"}, {"type": "subtitle", "time": 21918.628, "timestamp": "06:05:18", "text": "使用事件 ID 生成缩略图。"}, {"type": "subtitle", "time": 21921.03, "timestamp": "06:05:21", "text": "正确的？这就是创建逻辑。"}, {"type": "subtitle", "time": 21923.91, "timestamp": "06:05:23", "text": "它使事件发生，然后进行修补。"}, {"type": "subtitle", "time": 21927.11, "timestamp": "06:05:27", "text": "只是为了缩略图，然后呃"}, {"type": "subtitle", "time": 21931.43, "timestamp": "06:05:31", "text": "完成它，呃，循环重复循环"}, {"type": "subtitle", "time": 21934.868, "timestamp": "06:05:34", "text": "流量数量合适。所以"}, {"type": "subtitle", "time": 21939.35, "timestamp": "06:05:39", "text": "我当时在想，如果……存在的话"}, {"type": "subtitle", "time": 21943.99, "timestamp": "06:05:43", "text": "Discord ID 不存在"}, {"type": "subtitle", "time": 21946.788, "timestamp": "06:05:46", "text": "我的意思是，呃，它确实存在。"}, {"type": "subtitle", "time": 21951.35, "timestamp": "06:05:51", "text": "我想检查一下"}, {"type": "subtitle", "time": 21954.31, "timestamp": "06:05:54", "text": "视频 ID 我们再次执行相同的操作"}, {"type": "subtitle", "time": 21957.91, "timestamp": "06:05:57", "text": "也许又陷入循环了。"}]
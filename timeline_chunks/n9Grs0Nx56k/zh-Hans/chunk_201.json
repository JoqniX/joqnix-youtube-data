[{"type": "subtitle", "time": 12066.15, "timestamp": "03:21:06", "text": "你看，它正在拉取当前流"}, {"type": "subtitle", "time": 12072.07, "timestamp": "03:21:12", "text": "这是我第一次注意到"}, {"type": "subtitle", "time": 12074.87, "timestamp": "03:21:14", "text": "你头上顶着星座。是的，莱昂纳多"}, {"type": "subtitle", "time": 12079.269, "timestamp": "03:21:19", "text": "星座。我的原产地标记"}, {"type": "subtitle", "time": 12082.469, "timestamp": "03:21:22", "text": "狮子座。另外，我也不知道是否有人"}, {"type": "subtitle", "time": 12085.75, "timestamp": "03:21:25", "text": "我知道我最近像我的一个朋友一样告诉过我"}, {"type": "subtitle", "time": 12088.63, "timestamp": "03:21:28", "text": "对我来说，出现了一个新的星座。不，不。"}, {"type": "subtitle", "time": 12091.75, "timestamp": "03:21:31", "text": "又出了一种新的星座玩意儿。我忘了"}, {"type": "subtitle", "time": 12094.389, "timestamp": "03:21:34", "text": "名称。就像出现了一个新的星座"}, {"type": "subtitle", "time": 12095.91, "timestamp": "03:21:35", "text": "东西"}, {"type": "subtitle", "time": 12098.07, "timestamp": "03:21:38", "text": "这是最近发生的"}, {"type": "subtitle", "time": 12101.11, "timestamp": "03:21:41", "text": "或者别的什么。还有那些天秤座的人"}, {"type": "subtitle", "time": 12103.03, "timestamp": "03:21:43", "text": "在他们被换衣服之前。我知道"}, {"type": "subtitle", "time": 12105.59, "timestamp": "03:21:45", "text": "射手座之类的星座变了。"}, {"type": "subtitle", "time": 12108.389, "timestamp": "03:21:48", "text": "例如十一月到十二月这段时间。"}, {"type": "subtitle", "time": 12115.75, "timestamp": "03:21:55", "text": "你相信z所说的吗？"}, {"type": "subtitle", "time": 12119.11, "timestamp": "03:21:59", "text": "关于人中的人？不多。"}]
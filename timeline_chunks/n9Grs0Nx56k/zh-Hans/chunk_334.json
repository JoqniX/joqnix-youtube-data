[{"type": "subtitle", "time": 20040.868, "timestamp": "05:34:00", "text": "你好。我会做这件事，你也会做这件事，而且"}, {"type": "subtitle", "time": 20043.43, "timestamp": "05:34:03", "text": "呃，删除逻辑"}, {"type": "subtitle", "time": 20046.548, "timestamp": "05:34:06", "text": "呃，稍后吧。你为什么这么晚才吃饭？我忘了"}, {"type": "subtitle", "time": 20049.51, "timestamp": "05:34:09", "text": "时间过得真快。我当时想"}, {"type": "subtitle", "time": 20052.868, "timestamp": "05:34:12", "text": "当时是晚上8点。现在是11点。就像……"}, {"type": "subtitle", "time": 20056.15, "timestamp": "05:34:16", "text": "真是疯了。如何"}, {"type": "subtitle", "time": 20060.906, "timestamp": "05:34:20", "text": "时间怎么过得这么快？"}, {"type": "subtitle", "time": 20061.91, "timestamp": "05:34:21", "text": "[笑声]"}, {"type": "subtitle", "time": 20064.15, "timestamp": "05:34:24", "text": "我想是因为我太沉浸其中了"}, {"type": "subtitle", "time": 20066.628, "timestamp": "05:34:26", "text": "我甚至都没意识到时间在流逝。"}, {"type": "subtitle", "time": 20077.27, "timestamp": "05:34:37", "text": "我甚至都没意识到今天是f"}, {"type": "subtitle", "time": 20080.47, "timestamp": "05:34:40", "text": "星期五。转眼间就到了周末。"}, {"type": "subtitle", "time": 20086.628, "timestamp": "05:34:46", "text": "我以为今天是星期三。"}, {"type": "subtitle", "time": 20088.548, "timestamp": "05:34:48", "text": "某物。"}, {"type": "subtitle", "time": 20091.19, "timestamp": "05:34:51", "text": "和"}, {"type": "subtitle", "time": 20095.27, "timestamp": "05:34:55", "text": "我的时间感正在丧失。"}]
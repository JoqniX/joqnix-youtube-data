[{"type": "subtitle", "time": 688.949, "timestamp": "00:11:28", "text": "我的天啊。 爆头致死。 疯狂的。"}, {"type": "subtitle", "time": 703.509, "timestamp": "00:11:43", "text": "这把枪怎么会这么蠢？"}, {"type": "subtitle", "time": 714.069, "timestamp": "00:11:54", "text": "不错，兄弟。 这款游戏现在真的"}, {"type": "subtitle", "time": 716.23, "timestamp": "00:11:56", "text": "很火。"}, {"type": "subtitle", "time": 719.67, "timestamp": "00:11:59", "text": "我的天，好"}]
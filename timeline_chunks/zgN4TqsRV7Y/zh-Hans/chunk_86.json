[{"type": "subtitle", "time": 5172.629, "timestamp": "01:26:12", "text": "你的笔记本电脑怎么样？"}, {"type": "subtitle", "time": 5188.709, "timestamp": "01:26:28", "text": "你知道最搞笑的是什么吗？"}, {"type": "subtitle", "time": 5192.07, "timestamp": "01:26:32", "text": "我想买一台50CD容量的笔记本电脑，因为"}, {"type": "subtitle", "time": 5196.87, "timestamp": "01:26:36", "text": "有AV1之类的设备。 后来我发现 Twitch"}, {"type": "subtitle", "time": 5199.27, "timestamp": "01:26:39", "text": "不支持 AV1。  Kick 不"}, {"type": "subtitle", "time": 5202.149, "timestamp": "01:26:42", "text": "支持 AV1。  YouTube 支持所有人，"}, {"type": "subtitle", "time": 5204.95, "timestamp": "01:26:44", "text": "但"}, {"type": "subtitle", "time": 5206.95, "timestamp": "01:26:46", "text": "如果我同时进行多平台直播，"}, {"type": "subtitle", "time": 5210.47, "timestamp": "01:26:50", "text": "却无法将视频发送给所有人，那还有什么意义呢"}]
[{"type": "subtitle", "time": 2946.549, "timestamp": "00:49:06", "text": "对她有点儿……嗯，有点儿偏袒，除非"}, {"type": "subtitle", "time": 2950.39, "timestamp": "00:49:10", "text": "她能控制住自己，否则我"}, {"type": "subtitle", "time": 2953.51, "timestamp": "00:49:13", "text": "见过她在推特上发泄情绪或者谈论一些"}, {"type": "subtitle", "time": 2956.63, "timestamp": "00:49:16", "text": "事情，对吧？ 你要"}, {"type": "subtitle", "time": 2958.23, "timestamp": "00:49:18", "text": "明白她也是一名"}, {"type": "subtitle", "time": 2959.91, "timestamp": "00:49:19", "text": "上班族，"}, {"type": "subtitle", "time": 2963.829, "timestamp": "00:49:23", "text": "对吧？ 她既要面对"}, {"type": "subtitle", "time": 2968.23, "timestamp": "00:49:28", "text": "偶像的各种事情，又要进行"}, {"type": "subtitle", "time": 2970.87, "timestamp": "00:49:30", "text": "直播。"}, {"type": "subtitle", "time": 2983.51, "timestamp": "00:49:43", "text": "你来了。 对，就是原版。 我还"}, {"type": "subtitle", "time": 2986.15, "timestamp": "00:49:46", "text": "记得最初的那些版本。 是啊，现在"}, {"type": "subtitle", "time": 2988.95, "timestamp": "00:49:48", "text": "来了很多人，"}, {"type": "subtitle", "time": 2994.79, "timestamp": "00:49:54", "text": "但事情就是这样。 只要"}, {"type": "subtitle", "time": 2997.109, "timestamp": "00:49:57", "text": "我回来的时候她还能"}]
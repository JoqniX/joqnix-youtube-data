[{"type": "subtitle", "time": 1083.35, "timestamp": "00:18:03", "text": "这枪的后坐力真是烦人。 不，是这东西，这"}, {"type": "subtitle", "time": 1087.19, "timestamp": "00:18:07", "text": "冒出来的火。 这种情况太罕见了。"}, {"type": "subtitle", "time": 1089.909, "timestamp": "00:18:09", "text": "什么都看不见。"}, {"type": "subtitle", "time": 1092.23, "timestamp": "00:18:12", "text": "到底发生了什么？"}, {"type": "subtitle", "time": 1131.19, "timestamp": "00:18:51", "text": "天，我已经有三颗子弹了。"}]
[{"type": "subtitle", "time": 4809.75, "timestamp": "01:20:09", "text": "现在的个人电脑很贵。 是的。 我正在从"}, {"type": "subtitle", "time": 4821.11, "timestamp": "01:20:21", "text": "家里取我的显卡、主板、内存、采集卡和固态硬盘。 我的日语老师"}, {"type": "subtitle", "time": 4823.669, "timestamp": "01:20:23", "text": "现在在印度。 他将于"}, {"type": "subtitle", "time": 4827.83, "timestamp": "01:20:27", "text": "26号或27号回来。 所以我问了我爸爸"}, {"type": "subtitle", "time": 4832.31, "timestamp": "01:20:32", "text": "，他同意把"}, {"type": "subtitle", "time": 4835.99, "timestamp": "01:20:35", "text": "我的东西搬到这里来。 所以，我得"}, {"type": "subtitle", "time": 4840.95, "timestamp": "01:20:40", "text": "去东京取我的零件。"}, {"type": "subtitle", "time": 4843.35, "timestamp": "01:20:43", "text": "所以，我已经买了电脑散热器和"}, {"type": "subtitle", "time": 4845.51, "timestamp": "01:20:45", "text": "电源。 我需要买个"}, {"type": "subtitle", "time": 4847.03, "timestamp": "01:20:47", "text": "机箱，"}, {"type": "subtitle", "time": 4850.229, "timestamp": "01:20:50", "text": "等我把配件都买齐了，"}, {"type": "subtitle", "time": 4853.59, "timestamp": "01:20:53", "text": "嗯，一切就都好了。"}, {"type": "subtitle", "time": 4856.39, "timestamp": "01:20:56", "text": "我组装了这台电脑，它将是一台"}, {"type": "subtitle", "time": 4858.87, "timestamp": "01:20:58", "text": "无头电脑。 这意味着没有显示器、"}]
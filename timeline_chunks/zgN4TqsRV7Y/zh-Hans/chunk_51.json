[{"type": "subtitle", "time": 3087.109, "timestamp": "00:51:27", "text": "哦，是的。 我觉得这些"}, {"type": "subtitle", "time": 3088.87, "timestamp": "00:51:28", "text": "人根本就没法谈论"}, {"type": "subtitle", "time": 3090.95, "timestamp": "00:51:30", "text": "任何有意义的事情。"}, {"type": "subtitle", "time": 3093.91, "timestamp": "00:51:33", "text": "但现在的问题是，"}, {"type": "subtitle", "time": 3098.39, "timestamp": "00:51:38", "text": "嗯，我以前只是喜欢嗨，"}, {"type": "subtitle", "time": 3107.19, "timestamp": "00:51:47", "text": "真正的直播。 等等，这样"}, {"type": "subtitle", "time": 3110.069, "timestamp": "00:51:50", "text": "讨论一些事情真的合适吗？比如“这难道不是很"}, {"type": "subtitle", "time": 3112.87, "timestamp": "00:51:52", "text": "糟糕吗？” 好像我们在谈论"}, {"type": "subtitle", "time": 3115.27, "timestamp": "00:51:55", "text": "别的地方？"}, {"type": "subtitle", "time": 3116.95, "timestamp": "00:51:56", "text": "我的意思是，我们并没有说坏话。"}]
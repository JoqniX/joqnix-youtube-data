[{"type": "subtitle", "time": 394.629, "timestamp": "00:06:34", "text": "大家好。 我真的非常抱歉。 嗯，我"}, {"type": "subtitle", "time": 396.629, "timestamp": "00:06:36", "text": "得去做些"}, {"type": "subtitle", "time": 399.83, "timestamp": "00:06:39", "text": "洗衣服的事。"}, {"type": "subtitle", "time": 402.55, "timestamp": "00:06:42", "text": "我得留一些衣服晾干。   这"}, {"type": "subtitle", "time": 405.51, "timestamp": "00:06:45", "text": "就是我迟到的原因。"}, {"type": "subtitle", "time": 407.83, "timestamp": "00:06:47", "text": "呃，过来吧，是的。 今天我们要"}, {"type": "subtitle", "time": 411.11, "timestamp": "00:06:51", "text": "玩的游戏叫做“街头战争”。"}, {"type": "subtitle", "time": 415.029, "timestamp": "00:06:55", "text": "我注意到这款游戏"}, {"type": "subtitle", "time": 419.35, "timestamp": "00:06:59", "text": "在推特上很火，或者说很受欢迎，"}]
[{"type": "subtitle", "time": 1691.59, "timestamp": "00:28:11", "text": "我的天哪，是他。 他拿着一把冲锋枪。"}, {"type": "subtitle", "time": 1694.47, "timestamp": "00:28:14", "text": "哦，绝对不行。"}, {"type": "subtitle", "time": 1697.51, "timestamp": "00:28:17", "text": "好了，他死了。 好的。"}, {"type": "subtitle", "time": 1708.31, "timestamp": "00:28:28", "text": "我该去哪里剪？"}, {"type": "subtitle", "time": 1711.909, "timestamp": "00:28:31", "text": "啊，他们抓到告密者了。"}, {"type": "subtitle", "time": 1714.63, "timestamp": "00:28:34", "text": "等等，他们赢了。 啊，"}, {"type": "subtitle", "time": 1715.269, "timestamp": "00:28:35", "text": "他们赢了。"}, {"type": "subtitle", "time": 1717.669, "timestamp": "00:28:37", "text": "没有借口。"}, {"type": "subtitle", "time": 1720.87, "timestamp": "00:28:40", "text": "啊，跑卫。 是的。"}]
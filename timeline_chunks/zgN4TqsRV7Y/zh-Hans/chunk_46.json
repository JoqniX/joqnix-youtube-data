[{"type": "subtitle", "time": 2765.03, "timestamp": "00:46:05", "text": "每月制作模拟币90。 什么？   这相当于"}, {"type": "subtitle", "time": 2767.19, "timestamp": "00:46:07", "text": "多少印度卢比？   我勒个去"}, {"type": "subtitle", "time": 2786.87, "timestamp": "00:46:26", "text": "6 点 哦，她她她"}, {"type": "subtitle", "time": 2789.19, "timestamp": "00:46:29", "text": "达到了 626k。"}, {"type": "subtitle", "time": 2803.829, "timestamp": "00:46:43", "text": "幽灵般的方式寻找加入新主机。"}, {"type": "subtitle", "time": 2806.309, "timestamp": "00:46:46", "text": "她刚刚办了会员卡。   就是这样。"}, {"type": "subtitle", "time": 2809.27, "timestamp": "00:46:49", "text": "啊，"}, {"type": "subtitle", "time": 2812.47, "timestamp": "00:46:52", "text": "通常人们都会这么做，我的意思是，也许她这么做"}, {"type": "subtitle", "time": 2819.109, "timestamp": "00:46:59", "text": "通常人们会把它当成"}]
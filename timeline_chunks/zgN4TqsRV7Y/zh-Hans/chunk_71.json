[{"type": "subtitle", "time": 4285.91, "timestamp": "01:11:25", "text": "街区里的狗叫声很好听。"}, {"type": "subtitle", "time": 4289.59, "timestamp": "01:11:29", "text": "它进入了“咻咻”模式。 是的，"}, {"type": "subtitle", "time": 4293.11, "timestamp": "01:11:33", "text": "我现在正在敲击头部。"}, {"type": "subtitle", "time": 4297.189, "timestamp": "01:11:37", "text": "直播开始了。 是的，"}, {"type": "subtitle", "time": 4309.59, "timestamp": "01:11:49", "text": "我的天啊。 我杀了那家伙。 他，呃，就是那个拿着"}, {"type": "subtitle", "time": 4312.31, "timestamp": "01:11:52", "text": "我枪的人。 他们杀了"}]
[{"type": "subtitle", "time": 3180.39, "timestamp": "00:53:00", "text": "一台游戏笔记本电脑。我在推特上问了她"}, {"type": "subtitle", "time": 3183.91, "timestamp": "00:53:03", "text": "，她把电脑寄给了我，我又买了一台"}, {"type": "subtitle", "time": 3187.589, "timestamp": "00:53:07", "text": "一样的。 但我拿到的是32寸的。不，我"}, {"type": "subtitle", "time": 3192.069, "timestamp": "00:53:12", "text": "拿到的是2TB存储扩展包。 仅"}, {"type": "subtitle", "time": 3194.309, "timestamp": "00:53:14", "text": "基础款。   是的"}, {"type": "subtitle", "time": 3196.47, "timestamp": "00:53:16", "text": "，有一次我跟她说，"}, {"type": "subtitle", "time": 3199.51, "timestamp": "00:53:19", "text": "如果你在"}, {"type": "subtitle", "time": 3203.349, "timestamp": "00:53:23", "text": "直播、"}, {"type": "subtitle", "time": 3206.549, "timestamp": "00:53:26", "text": "设置 OBS 之类的技术方面需要帮助，可以找我，因为你知道，如果"}, {"type": "subtitle", "time": 3208.87, "timestamp": "00:53:28", "text": "你之前没有任何经验就开始做 YouTube，那真的"}, {"type": "subtitle", "time": 3211.99, "timestamp": "00:53:31", "text": "很难"}, {"type": "subtitle", "time": 3215.349, "timestamp": "00:53:35", "text": "理解该做什么、该学什么"}, {"type": "subtitle", "time": 3218.63, "timestamp": "00:53:38", "text": "等等。   是的"}, {"type": "subtitle", "time": 3221.589, "timestamp": "00:53:41", "text": "，这有点痛苦。"}, {"type": "subtitle", "time": 3224.47, "timestamp": "00:53:44", "text": "她推荐了吗？是的，她推荐了，"}, {"type": "subtitle", "time": 3234.069, "timestamp": "00:53:54", "text": "这是个叫mouse的公司的产品，"}, {"type": "subtitle", "time": 3236.549, "timestamp": "00:53:56", "text": "他们最近推出了新款，我买的是"}, {"type": "subtitle", "time": 3239.589, "timestamp": "00:53:59", "text": "白色的。"}]
[{"type": "subtitle", "time": 3662.63, "timestamp": "01:01:02", "text": "美好的形象，把它变成不适宜工作场所观看的东西"}, {"type": "subtitle", "time": 3670.069, "timestamp": "01:01:10", "text": "是的，我的意思是肯定会有人喜欢这种风格，但是"}, {"type": "subtitle", "time": 3674.309, "timestamp": "01:01:14", "text": "，我不想"}, {"type": "subtitle", "time": 3676.47, "timestamp": "01:01:16", "text": "在我的同人作品里，或者"}, {"type": "subtitle", "time": 3680.87, "timestamp": "01:01:20", "text": "在我的主要同人作品标签里看到那种风格的东西。 我会"}, {"type": "subtitle", "time": 3683.589, "timestamp": "01:01:23", "text": "很难过的，伙计。"}, {"type": "subtitle", "time": 3686.789, "timestamp": "01:01:26", "text": "这张图片我用了"}, {"type": "subtitle", "time": 3689.03, "timestamp": "01:01:29", "text": "两年都一直用作壁纸"}, {"type": "subtitle", "time": 3694.15, "timestamp": "01:01:34", "text": "嗯，"}, {"type": "subtitle", "time": 3697.03, "timestamp": "01:01:37", "text": "我还要等多久才能"}, {"type": "subtitle", "time": 3701.109, "timestamp": "01:01:41", "text": "最终把"}, {"type": "subtitle", "time": 3704.63, "timestamp": "01:01:44", "text": "它发布出去呢？"}, {"type": "subtitle", "time": 3706.63, "timestamp": "01:01:46", "text": "我做了很多自定义"}, {"type": "subtitle", "time": 3708.63, "timestamp": "01:01:48", "text": "背景，就像壁纸一样，只是为了"}, {"type": "subtitle", "time": 3711.109, "timestamp": "01:01:51", "text": "自己欣赏。"}, {"type": "subtitle", "time": 3715.349, "timestamp": "01:01:55", "text": "那些夜晚就像我一直在观看"}]
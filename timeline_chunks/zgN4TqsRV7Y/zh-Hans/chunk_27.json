[{"type": "subtitle", "time": 1630.149, "timestamp": "00:27:10", "text": "你们看到了吗？ 我的天啊。 我"}, {"type": "subtitle", "time": 1634.07, "timestamp": "00:27:14", "text": "擅长玩这个游戏。 我勒个去？"}, {"type": "subtitle", "time": 1653.909, "timestamp": "00:27:33", "text": "不谈论这件事。 好的。"}, {"type": "subtitle", "time": 1658.789, "timestamp": "00:27:38", "text": "我撕得很厉害。 我"}, {"type": "subtitle", "time": 1660.95, "timestamp": "00:27:40", "text": "现在感觉糟透了。"}]
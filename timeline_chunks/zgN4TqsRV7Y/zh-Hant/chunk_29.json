[{"type": "subtitle", "time": 1741.51, "timestamp": "00:29:01", "text": "我是怎麼死的？我是"}, {"type": "subtitle", "time": 1743.62, "timestamp": "00:29:03", "text": "跳樓自殺的。好的。"}, {"type": "subtitle", "time": 1744.549, "timestamp": "00:29:04", "text": "[笑聲] 那"}, {"type": "subtitle", "time": 1747.35, "timestamp": "00:29:07", "text": "不是我的屍體嗎？"}, {"type": "subtitle", "time": 1750.07, "timestamp": "00:29:10", "text": "搞什麼鬼，兄弟？"}, {"type": "subtitle", "time": 1757.909, "timestamp": "00:29:17", "text": "哦，這是一場一對一的死亡"}, {"type": "subtitle", "time": 1759.99, "timestamp": "00:29:19", "text": "對決。  哦，這是一場生死之戰。我的天哪，它"}, {"type": "subtitle", "time": 1775.19, "timestamp": "00:29:35", "text": "。  去他媽的。我的天啊。你他媽在幹嘛，"}]
[{"type": "subtitle", "time": 1691.59, "timestamp": "00:28:11", "text": "天哪，是他。他拿著一把衝鋒槍。"}, {"type": "subtitle", "time": 1694.47, "timestamp": "00:28:14", "text": "哦，絕對不行。"}, {"type": "subtitle", "time": 1697.51, "timestamp": "00:28:17", "text": "好了，他死了。好的。"}, {"type": "subtitle", "time": 1708.31, "timestamp": "00:28:28", "text": "我該去哪裡剪？"}, {"type": "subtitle", "time": 1711.909, "timestamp": "00:28:31", "text": "啊，他們抓到告密者了。"}, {"type": "subtitle", "time": 1714.63, "timestamp": "00:28:34", "text": "等等，他們贏了。啊，"}, {"type": "subtitle", "time": 1715.269, "timestamp": "00:28:35", "text": "他們贏了。"}, {"type": "subtitle", "time": 1717.669, "timestamp": "00:28:37", "text": "沒有藉口。"}, {"type": "subtitle", "time": 1720.87, "timestamp": "00:28:40", "text": "啊，跑衛。是的。"}]
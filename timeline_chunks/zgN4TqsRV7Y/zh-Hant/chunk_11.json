[{"type": "subtitle", "time": 688.949, "timestamp": "00:11:28", "text": "爆頭致死。瘋狂的。  瘋狂的。瘋狂的"}, {"type": "subtitle", "time": 703.509, "timestamp": "00:11:43", "text": "這把槍怎麼會這麼蠢？"}, {"type": "subtitle", "time": 714.069, "timestamp": "00:11:54", "text": "不錯，兄弟。這款遊戲現在真的"}, {"type": "subtitle", "time": 716.23, "timestamp": "00:11:56", "text": "很紅。"}, {"type": "subtitle", "time": 719.67, "timestamp": "00:11:59", "text": "我的天，好痛啊"}]
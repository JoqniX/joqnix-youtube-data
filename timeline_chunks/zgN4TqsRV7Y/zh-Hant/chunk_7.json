[{"type": "subtitle", "time": 421.11, "timestamp": "00:07:01", "text": "人們說它和《決勝時刻》很像，像是遊戲"}, {"type": "subtitle", "time": 425.749, "timestamp": "00:07:05", "text": "機制等等，"}, {"type": "subtitle", "time": 430.309, "timestamp": "00:07:10", "text": "都有類似的元素。所以，我想，嗯，"}, {"type": "subtitle", "time": 434.39, "timestamp": "00:07:14", "text": "我玩玩吧。  是的"}, {"type": "subtitle", "time": 436.309, "timestamp": "00:07:16", "text": "。"}, {"type": "subtitle", "time": 439.909, "timestamp": "00:07:19", "text": "嗯，就放點音樂，給我一分鐘。"}, {"type": "subtitle", "time": 441.99, "timestamp": "00:07:21", "text": "我會"}, {"type": "subtitle", "time": 446.79, "timestamp": "00:07:26", "text": "盡快確認聊天連線是否正常，"}, {"type": "subtitle", "time": 455.909, "timestamp": "00:07:35", "text": "歡迎"}, {"type": "subtitle", "time": 457.99, "timestamp": "00:07:37", "text": "恐怖片粉絲"}, {"type": "subtitle", "time": 459.99, "timestamp": "00:07:39", "text": "178號。"}, {"type": "subtitle", "time": 465.67, "timestamp": "00:07:45", "text": "那些交班的人會"}, {"type": "subtitle", "time": 468.629, "timestamp": "00:07:48", "text": "進來的。"}, {"type": "subtitle", "time": 471.589, "timestamp": "00:07:51", "text": "請稍等片刻。  我的天"}, {"type": "subtitle", "time": 475.43, "timestamp": "00:07:55", "text": "，這款遊戲消耗了大量的"}]
[{"type": "subtitle", "time": 6841.51, "timestamp": "01:54:01", "text": "我覺得這是一個徵兆。  好的，我們會把"}, {"type": "subtitle", "time": 6857.109, "timestamp": "01:54:17", "text": "大家都結束的"}, {"type": "subtitle", "time": 6868.709, "timestamp": "01:54:28", "text": "。  我們直播了大約兩個小時。  現在是凌晨1點，我早上6點要起床。是啊，但是"}, {"type": "subtitle", "time": 6894.39, "timestamp": "01:54:54", "text": "感謝所有到場的朋友們。  V Matty，歡迎來到直播間，我相信這是你第一次來。歡迎來到星座世界。  Kisa，謝謝"}]
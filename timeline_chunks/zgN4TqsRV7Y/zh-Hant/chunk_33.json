[{"type": "subtitle", "time": 1982.71, "timestamp": "00:33:02", "text": "我沒看到。哦，他是在狙擊。媽的，"}, {"type": "subtitle", "time": 2001.75, "timestamp": "00:33:21", "text": "狙擊槍給我，兄弟。"}, {"type": "subtitle", "time": 2010.95, "timestamp": "00:33:30", "text": "我不知道我是怎麼殺死他們的，但"}, {"type": "subtitle", "time": 2017.75, "timestamp": "00:33:37", "text": "放了那傢伙。"}]
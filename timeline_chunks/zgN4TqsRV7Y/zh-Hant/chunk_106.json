[{"type": "subtitle", "time": 6397.51, "timestamp": "01:46:37", "text": "我需要兩次雙殺。然後我就可以解鎖彈鼓了。  我需要彈鼓。  AK-47步槍有60發子彈。  就像我玩《決勝時刻》之類的遊戲時，我現在的主要目標是解鎖鼓式霰彈槍，也就是鼓式彈匣，這樣你就可以有很多子彈，不然老兄死得太快了。"}, {"type": "chat", "time": 6412.522, "timestamp": "01:46:52", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "OwO"}]
[{"type": "subtitle", "time": 3098.39, "timestamp": "00:51:38", "text": "我覺得這些人根本沒辦法談論任何有意義的事。  但現在的問題是，嗯，我以前只是喜歡嗨，"}, {"type": "subtitle", "time": 3107.19, "timestamp": "00:51:47", "text": "真正的直播。等等，這樣"}, {"type": "subtitle", "time": 3112.87, "timestamp": "00:51:52", "text": "討論一些事情真的適合嗎？例如「這不是很糟糕嗎？」好像我們在談論別的"}, {"type": "subtitle", "time": 3115.27, "timestamp": "00:51:55", "text": "地方？  我的"}, {"type": "subtitle", "time": 3116.95, "timestamp": "00:51:56", "text": "意思是，我們並沒有說壞話。  我想我們只是在說好話而已。"}]
[{"type": "subtitle", "time": 2940.79, "timestamp": "00:49:00", "text": "ほとんどのモデレーターは"}, {"type": "subtitle", "time": 2946.549, "timestamp": "00:49:06", "text": "彼女に対してパラソーシャルな関係を築いているようなもので、"}, {"type": "subtitle", "time": 2950.39, "timestamp": "00:49:10", "text": "彼女が制限を守らない限り、"}, {"type": "subtitle", "time": 2953.51, "timestamp": "00:49:13", "text": "Twitterで不満を漏らしたり、いろいろなことを話したりするのを見たことがありますよ"}, {"type": "subtitle", "time": 2956.63, "timestamp": "00:49:16", "text": "ね？"}, {"type": "subtitle", "time": 2958.23, "timestamp": "00:49:18", "text": "彼女も社会人として働いているということを理解する必要があるでしょう"}, {"type": "subtitle", "time": 2963.829, "timestamp": "00:49:23", "text": "？ 彼女は"}, {"type": "subtitle", "time": 2968.23, "timestamp": "00:49:28", "text": "アイドル活動に向き合わなければならないし、それから配信もしなければならない"}, {"type": "subtitle", "time": 2970.87, "timestamp": "00:49:30", "text": "。"}, {"type": "subtitle", "time": 2986.15, "timestamp": "00:49:46", "text": "覚えているよ。 ええ、今はたくさんの"}, {"type": "subtitle", "time": 2988.95, "timestamp": "00:49:48", "text": "人が来てる"}, {"type": "subtitle", "time": 2994.79, "timestamp": "00:49:54", "text": "けど、まあそういうことだ。"}, {"type": "subtitle", "time": 2997.109, "timestamp": "00:49:57", "text": "私が戻ってきた時に彼女が"}]
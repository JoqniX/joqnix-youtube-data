[{"type": "subtitle", "time": 7020.95, "timestamp": "01:57:00", "text": "今回は違うよ、午後"}, {"type": "subtitle", "time": 7024.709, "timestamp": "01:57:04", "text": "7時半頃。 インド標準時（IST）。 つまり、午後"}, {"type": "subtitle", "time": 7026.95, "timestamp": "01:57:06", "text": "10時30分、"}, {"type": "subtitle", "time": 7034.79, "timestamp": "01:57:14", "text": "11時です。 私の時間は日本標準時です。"}, {"type": "subtitle", "time": 7036.39, "timestamp": "01:57:16", "text": "そう、金曜日と土曜日は、そのププのことに"}, {"type": "subtitle", "time": 7040.149, "timestamp": "01:57:20", "text": "完全に集中したかったんです"}, {"type": "subtitle", "time": 7042.95, "timestamp": "01:57:22", "text": "。 じゃあ、それら全部を練習するってことですよね"}, {"type": "subtitle", "time": 7044.79, "timestamp": "01:57:24", "text": "？   これが今のところ"}, {"type": "subtitle", "time": 7047.51, "timestamp": "01:57:27", "text": "私が作成した改善スケジュールです"}, {"type": "subtitle", "time": 7050.709, "timestamp": "01:57:30", "text": "。 ええ、"}, {"type": "subtitle", "time": 7053.669, "timestamp": "01:57:33", "text": "こんにちは。 全力を尽くしましょう。 私の配信などに来てくれて、改めてありがとう"}, {"type": "subtitle", "time": 7057.669, "timestamp": "01:57:37", "text": "。"}, {"type": "subtitle", "time": 7059.83, "timestamp": "01:57:39", "text": "皆さん、良い一日を。"}]
[{"type": "subtitle", "time": 3300.95, "timestamp": "00:55:00", "text": "。 彼女はそうしなかった。 わかった。   えっと、ちょっと待ってください"}, {"type": "subtitle", "time": 3319.51, "timestamp": "00:55:19", "text": "彼女が"}, {"type": "subtitle", "time": 3322.71, "timestamp": "00:55:22", "text": "TwitterではなくInstagramで私をフォローしたことが一度あったことを思い出しました。"}, {"type": "subtitle", "time": 3326.63, "timestamp": "00:55:26", "text": "それは私をとても幸せにしてくれました。 それで、"}, {"type": "subtitle", "time": 3330.23, "timestamp": "00:55:30", "text": "彼女にメッセージを送りたいと思ったのは、私が"}, {"type": "subtitle", "time": 3332.79, "timestamp": "00:55:32", "text": "彼女に「もし"}, {"type": "subtitle", "time": 3335.349, "timestamp": "00:55:35", "text": "技術的な問題があったら、私が"}, {"type": "subtitle", "time": 3337.75, "timestamp": "00:55:37", "text": "手伝うよ」と言ったからなんです。 でも"}, {"type": "subtitle", "time": 3340.95, "timestamp": "00:55:40", "text": "忙しすぎて彼女にメッセージを送るのを忘れてしまった。 そして"}, {"type": "subtitle", "time": 3345.349, "timestamp": "00:55:45", "text": "数日後、彼女が"}, {"type": "subtitle", "time": 3350.23, "timestamp": "00:55:50", "text": "私をフォロー解除したことに気づいて、私は「えー、"}]
[{"type": "subtitle", "time": 2716.55, "timestamp": "00:45:16", "text": "メンバーシップがすごく高い、どの"}, {"type": "subtitle", "time": 2718.71, "timestamp": "00:45:18", "text": "メンバーシップの"}, {"type": "subtitle", "time": 2719.75, "timestamp": "00:45:19", "text": "息子たち、"}, {"type": "subtitle", "time": 2720.95, "timestamp": "00:45:20", "text": "待って、本当に？   以上です。特典は"}, {"type": "subtitle", "time": 2729.589, "timestamp": "00:45:29", "text": "そして、実際には何もなかった。"}, {"type": "subtitle", "time": 2733.43, "timestamp": "00:45:33", "text": "私は"}, {"type": "subtitle", "time": 2740.87, "timestamp": "00:45:40", "text": "彼女の配信にはあまり行ったことがないんです。"}]
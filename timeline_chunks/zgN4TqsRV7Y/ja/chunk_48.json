[{"type": "subtitle", "time": 2897.51, "timestamp": "00:48:17", "text": "なんてこった？ 絶好調だよ。"}, {"type": "subtitle", "time": 2899.829, "timestamp": "00:48:19", "text": "キング、お元気ですか？ 元気です。"}, {"type": "subtitle", "time": 2904.87, "timestamp": "00:48:24", "text": "今日、食料品の買い出しや"}, {"type": "subtitle", "time": 2909.19, "timestamp": "00:48:29", "text": "買い物に出かける様子をIRLストリームで配信して、"}, {"type": "subtitle", "time": 2914.63, "timestamp": "00:48:34", "text": "ルームメイトのクインが作った自家製KFCみたいなものを食べ、今は近所で銃を撃っています"}, {"type": "subtitle", "time": 2923.43, "timestamp": "00:48:43", "text": "ええと、それは月に2回です。 ああ、そういうものなんだ"}, {"type": "subtitle", "time": 2925.51, "timestamp": "00:48:45", "text": "。 それに、"}, {"type": "subtitle", "time": 2928.39, "timestamp": "00:48:48", "text": "カタサは、"}, {"type": "subtitle", "time": 2934.79, "timestamp": "00:48:54", "text": "彼女はより大きなチャンネルなので、"}, {"type": "subtitle", "time": 2937.43, "timestamp": "00:48:57", "text": "モデレーターもあまりいないし、"}]
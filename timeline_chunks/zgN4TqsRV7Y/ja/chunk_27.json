[{"type": "subtitle", "time": 1630.149, "timestamp": "00:27:10", "text": "皆さん、あれ見ましたか？ 何てことだ。 私は"}, {"type": "subtitle", "time": 1634.07, "timestamp": "00:27:14", "text": "このゲームが得意です。 なんてこった？   なんだって"}, {"type": "subtitle", "time": 1653.909, "timestamp": "00:27:33", "text": "それについては話しません。 わかった。"}, {"type": "subtitle", "time": 1658.789, "timestamp": "00:27:38", "text": "ひどく破れてしまった。 今、すごくひどく裂けてしまった"}, {"type": "subtitle", "time": 1660.95, "timestamp": "00:27:40", "text": "。   何てことだ"}]
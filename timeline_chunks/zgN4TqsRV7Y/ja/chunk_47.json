[{"type": "subtitle", "time": 2824.069, "timestamp": "00:47:04", "text": "普通のケースのように保管します。10 ドルか 5 ドルでは"}, {"type": "subtitle", "time": 2828.55, "timestamp": "00:47:08", "text": "なく、5 ドルで 10 ドルというのは、7 100 円"}, {"type": "subtitle", "time": 2832.15, "timestamp": "00:47:12", "text": "か 600 円くらいです。"}, {"type": "subtitle", "time": 2837.27, "timestamp": "00:47:17", "text": "私の場合、990 円を見ましたが、それは"}, {"type": "subtitle", "time": 2839.19, "timestamp": "00:47:19", "text": "ほぼ"}, {"type": "subtitle", "time": 2843.51, "timestamp": "00:47:23", "text": "10 ドルから 12 ドルです。"}, {"type": "subtitle", "time": 2852.309, "timestamp": "00:47:32", "text": "こんにちは。 こんにちは。"}]
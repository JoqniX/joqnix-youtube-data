[{"type": "subtitle", "time": 4809.75, "timestamp": "01:20:09", "text": "今のパソコンは高価だ。 はい。 私は"}, {"type": "subtitle", "time": 4821.11, "timestamp": "01:20:21", "text": "自宅からグラフィックカード、マザーボード、RAM、キャプチャカード、SSDを取り寄せています。 私の日本語の先生は今、"}, {"type": "subtitle", "time": 4823.669, "timestamp": "01:20:23", "text": "インドにいます。 彼は"}, {"type": "subtitle", "time": 4827.83, "timestamp": "01:20:27", "text": "26日か27日に戻ってくるだろう。 それで父に頼んだら、うん、"}, {"type": "subtitle", "time": 4832.31, "timestamp": "01:20:32", "text": "父は"}, {"type": "subtitle", "time": 4835.99, "timestamp": "01:20:35", "text": "私の荷物をここに持ってきてくれることに同意してくれた。 だから、"}, {"type": "subtitle", "time": 4840.95, "timestamp": "01:20:40", "text": "東京に行って部品を受け取らなければならない。"}, {"type": "subtitle", "time": 4843.35, "timestamp": "01:20:43", "text": "それで、PCクーラーと"}, {"type": "subtitle", "time": 4845.51, "timestamp": "01:20:45", "text": "電源ユニットは既に購入しました。 ケースを買わないといけないし、"}, {"type": "subtitle", "time": 4850.229, "timestamp": "01:20:50", "text": "部品が届いたら、"}, {"type": "subtitle", "time": 4853.59, "timestamp": "01:20:53", "text": "ええと、すべて順調です。"}, {"type": "subtitle", "time": 4856.39, "timestamp": "01:20:56", "text": "PCを組み立てたんだけど、"}, {"type": "subtitle", "time": 4858.87, "timestamp": "01:20:58", "text": "ヘッドレスPCにするつもりなんだ。 つまり、モニターも"}]
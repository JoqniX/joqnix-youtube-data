[{"type": "subtitle", "time": 1741.51, "timestamp": "00:29:01", "text": "私はどのように死んだのですか？ 私は"}, {"type": "subtitle", "time": 1743.62, "timestamp": "00:29:03", "text": "飛び降りて死にました。 わかった。"}, {"type": "subtitle", "time": 1744.549, "timestamp": "00:29:04", "text": "[笑い声] あれって"}, {"type": "subtitle", "time": 1747.35, "timestamp": "00:29:07", "text": "私の死体じゃないの？   一体どういうことだよ"}, {"type": "subtitle", "time": 1750.07, "timestamp": "00:29:10", "text": "、兄弟？"}, {"type": "subtitle", "time": 1757.909, "timestamp": "00:29:17", "text": "ああ、これは1対1の決着だ。"}, {"type": "subtitle", "time": 1759.99, "timestamp": "00:29:19", "text": "ああ、これは死闘だ。 ああ、なんてことだ、"}, {"type": "subtitle", "time": 1775.19, "timestamp": "00:29:35", "text": "。 何てことだ。 お前なんかどうでもいいんだよ、"}]
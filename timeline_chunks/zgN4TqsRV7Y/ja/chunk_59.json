[{"type": "subtitle", "time": 3542.71, "timestamp": "00:59:02", "text": "なぜなら、一度"}, {"type": "subtitle", "time": 3548.95, "timestamp": "00:59:08", "text": "誰かと特別なやり取りを見せると、人々は"}, {"type": "subtitle", "time": 3552.069, "timestamp": "00:59:12", "text": "嫉妬し、それは文字通りソーシャルなものだからです。"}, {"type": "subtitle", "time": 3555.51, "timestamp": "00:59:15", "text": "厄介なことになる可能性もあるんだよ。"}, {"type": "subtitle", "time": 3558.71, "timestamp": "00:59:18", "text": "うん、それはまずいね。"}, {"type": "subtitle", "time": 3559.67, "timestamp": "00:59:19", "text": "一つ持っています。"}, {"type": "subtitle", "time": 3562.15, "timestamp": "00:59:22", "text": "ええ、それは"}, {"type": "subtitle", "time": 3569.19, "timestamp": "00:59:29", "text": "別のクリエイターコインの人から教わりました。その人はアンダー"}, {"type": "subtitle", "time": 3574.23, "timestamp": "00:59:34", "text": "カバーアカウントでベンドをしていた人で、"}, {"type": "subtitle", "time": 3577.829, "timestamp": "00:59:37", "text": "私と話してくれたんです。それで知りました。"}, {"type": "subtitle", "time": 3580.15, "timestamp": "00:59:40", "text": "ええ、彼らはオープンで、"}, {"type": "subtitle", "time": 3582.47, "timestamp": "00:59:42", "text": "もしあなたが私のメインチャンネルに来て、私の"}, {"type": "subtitle", "time": 3585.589, "timestamp": "00:59:45", "text": "メインチャンネルを見つけて話しかけたりしたら、"}, {"type": "subtitle", "time": 3592.71, "timestamp": "00:59:52", "text": "TwitterのDMで話していても、私はあなたに話しかけないと言っていました。とにかく、私はそれで、"}, {"type": "subtitle", "time": 3597.43, "timestamp": "00:59:57", "text": "これはちょっと待ってください、と理解しました"}]
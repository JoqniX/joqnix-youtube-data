[{"type": "subtitle", "time": 6721.189, "timestamp": "01:52:01", "text": "ゲームがクラッシュしました。"}, {"type": "subtitle", "time": 6732.629, "timestamp": "01:52:12", "text": "これは何かの兆候ですか？ それは私にそう言っているのですか？"}, {"type": "subtitle", "time": 6745.75, "timestamp": "01:52:25", "text": "ええ、それは何かの兆候だと思います。"}, {"type": "subtitle", "time": 6749.589, "timestamp": "01:52:29", "text": "はい、皆さん、これで終わりにします。"}, {"type": "subtitle", "time": 6762.79, "timestamp": "01:52:42", "text": "午前1時です。私は"}, {"type": "subtitle", "time": 6766.31, "timestamp": "01:52:46", "text": "6時に起きなければなりません。 ええ、でも私の睡眠が。   というわけで、"}, {"type": "subtitle", "time": 6768.07, "timestamp": "01:52:48", "text": "皆さん、"}, {"type": "subtitle", "time": 6772.709, "timestamp": "01:52:52", "text": "今日は来てくださってありがとうございました。 皆さん、良い一日を。   来てくださった"}]
[{"type": "subtitle", "time": 4985.43, "timestamp": "01:23:05", "text": "あなたはよくやっています。 削除してください。"}, {"type": "subtitle", "time": 4988.79, "timestamp": "01:23:08", "text": "動き続けろ。"}, {"type": "subtitle", "time": 4992.229, "timestamp": "01:23:12", "text": "待って、どうすればいいか知ってる？"}, {"type": "subtitle", "time": 4998.55, "timestamp": "01:23:18", "text": "誰かマルチレが聞こえる？"}, {"type": "subtitle", "time": 5004.709, "timestamp": "01:23:24", "text": "著作権のある音楽とか、"}, {"type": "subtitle", "time": 5010.39, "timestamp": "01:23:30", "text": "ストリームで聴いている音楽とかを再生したいんだけど"}, {"type": "subtitle", "time": 5018.39, "timestamp": "01:23:38", "text": "、特にYouTube"}, {"type": "subtitle", "time": 5020.79, "timestamp": "01:23:40", "text": "とかでは、それが配信されないようにしたいんだ。"}, {"type": "subtitle", "time": 5022.79, "timestamp": "01:23:42", "text": "それが可能ならね。 私もそうしたいです"}, {"type": "subtitle", "time": 5031.03, "timestamp": "01:23:51", "text": "えっと、"}, {"type": "subtitle", "time": 5033.35, "timestamp": "01:23:53", "text": "ジャガイモです。   何が手に入るのか分から"}, {"type": "subtitle", "time": 5036.95, "timestamp": "01:23:56", "text": "ない。"}]
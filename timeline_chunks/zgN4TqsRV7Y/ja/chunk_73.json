[{"type": "subtitle", "time": 4394.31, "timestamp": "01:13:14", "text": "ああ、お"}, {"type": "subtitle", "time": 4398.709, "timestamp": "01:13:18", "text": "尻で滑り降りる乗り物とジェットパックのことですか？"}, {"type": "subtitle", "time": 4402.63, "timestamp": "01:13:22", "text": "え、このゲームでスライディングできるの？ いいえ、そんなに"}, {"type": "subtitle", "time": 4407.43, "timestamp": "01:13:27", "text": "滑ることはできませんでした。 私は、私は、試してみました。"}, {"type": "subtitle", "time": 4411.189, "timestamp": "01:13:31", "text": "私にできるのは、うさぎ跳びくらいだと思う。"}, {"type": "subtitle", "time": 4413.43, "timestamp": "01:13:33", "text": "待って、私を起こしてくれる？ いいえ、そうは思いません"}, {"type": "subtitle", "time": 4430.229, "timestamp": "01:13:50", "text": "怖いんです。ええ、"}, {"type": "subtitle", "time": 4436.31, "timestamp": "01:13:56", "text": "ああ、大変だ、あそこにいる"}]
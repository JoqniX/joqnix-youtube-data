[{"type": "subtitle", "time": 3481.91, "timestamp": "00:58:01", "text": "。"}, {"type": "subtitle", "time": 3488.789, "timestamp": "00:58:08", "text": "うん。   パラ"}, {"type": "subtitle", "time": 3491.51, "timestamp": "00:58:11", "text": "ソーシャルイズムの問題は、例えば、どこからともなく"}, {"type": "subtitle", "time": 3494.309, "timestamp": "00:58:14", "text": "大物クリエイターが"}, {"type": "subtitle", "time": 3498.069, "timestamp": "00:58:18", "text": "あなたにメッセージを送ってきて、プライベートで、あるいは公にはしないプライベートな"}, {"type": "subtitle", "time": 3502.95, "timestamp": "00:58:22", "text": "会話をしているようなもので、"}, {"type": "subtitle", "time": 3508.39, "timestamp": "00:58:28", "text": "あなたは「ああ、"}, {"type": "subtitle", "time": 3510.95, "timestamp": "00:58:30", "text": "この人は私と話していて、"}, {"type": "subtitle", "time": 3513.03, "timestamp": "00:58:33", "text": "私たちは友達だ」と思うのですが、もしあなたが"}, {"type": "subtitle", "time": 3515.589, "timestamp": "00:58:35", "text": "ストリームに行って「"}, {"type": "subtitle", "time": 3517.829, "timestamp": "00:58:37", "text": "やあ、こんにちは、元気？」などとフレンドリーに振る舞うと、他の人は「おい、あそこにいないのに、なんで"}, {"type": "subtitle", "time": 3524.87, "timestamp": "00:58:44", "text": "この男は"}, {"type": "subtitle", "time": 3528.15, "timestamp": "00:58:48", "text": "私のストリーマーにそんな風にフレンドリーに振る舞ってるんだ？」と思うでしょう。"}, {"type": "subtitle", "time": 3532.789, "timestamp": "00:58:52", "text": "ストリーマーは"}, {"type": "subtitle", "time": 3536.71, "timestamp": "00:58:56", "text": "ライブストリームであなたに話しかけませんが、他の"}, {"type": "subtitle", "time": 3539.43, "timestamp": "00:58:59", "text": "人はあなたを奇妙に思うでしょう。"}]
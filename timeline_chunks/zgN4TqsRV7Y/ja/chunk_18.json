[{"type": "subtitle", "time": 1083.35, "timestamp": "00:18:03", "text": "この銃の反動は一体何なんだろう。 いいえ、これは、出てくるこの"}, {"type": "subtitle", "time": 1087.19, "timestamp": "00:18:07", "text": "炎です。 それはとても珍しいことです。   何も見え"}, {"type": "subtitle", "time": 1089.909, "timestamp": "00:18:09", "text": "ない。   一体何が"}, {"type": "subtitle", "time": 1092.23, "timestamp": "00:18:12", "text": "起こっているんだ？"}, {"type": "subtitle", "time": 1131.19, "timestamp": "00:18:51", "text": "ああ、もう弾丸が３発もある。   道を空けてください"}]
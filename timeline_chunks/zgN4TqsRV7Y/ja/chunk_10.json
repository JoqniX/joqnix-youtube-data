[{"type": "subtitle", "time": 603.59, "timestamp": "00:10:03", "text": "ああ、くそ。   ちょっと待ってください"}, {"type": "subtitle", "time": 625.75, "timestamp": "00:10:25", "text": "くそ。 銃弾が尽きた。"}, {"type": "subtitle", "time": 643.509, "timestamp": "00:10:43", "text": "ああ、なんてことだ、全員を一撃で倒した。"}, {"type": "subtitle", "time": 646.87, "timestamp": "00:10:46", "text": "ああ、やばい、殺されちゃった。"}]
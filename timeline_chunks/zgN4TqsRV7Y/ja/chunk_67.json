[{"type": "subtitle", "time": 4059.51, "timestamp": "01:07:39", "text": "私はとってもふわふわです。 カナデのぬいぐるみ"}, {"type": "subtitle", "time": 4061.67, "timestamp": "01:07:41", "text": "と"}, {"type": "subtitle", "time": 4065.349, "timestamp": "01:07:45", "text": "モリが欲しいです。 ナリッサやその他の"}, {"type": "subtitle", "time": 4066.95, "timestamp": "01:07:46", "text": "ぬいぐるみが"}, {"type": "subtitle", "time": 4068.789, "timestamp": "01:07:48", "text": "販売されています。"}, {"type": "subtitle", "time": 4071.029, "timestamp": "01:07:51", "text": "もし私がモールに行ったら、"}, {"type": "subtitle", "time": 4073.67, "timestamp": "01:07:53", "text": "ぬいぐるみを見せてあげるよ。"}, {"type": "subtitle", "time": 4076.15, "timestamp": "01:07:56", "text": "うん、"}, {"type": "subtitle", "time": 4079.27, "timestamp": "01:07:59", "text": "あそこにあるリボンのぬいぐるみだよ。"}]
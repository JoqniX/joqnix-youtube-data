[{"type": "subtitle", "time": 962.629, "timestamp": "00:16:02", "text": "押さえつけろ。"}, {"type": "subtitle", "time": 967.11, "timestamp": "00:16:07", "text": "このゲーム、すごく楽しい。 何？"}, {"type": "subtitle", "time": 969.189, "timestamp": "00:16:09", "text": "ひったくり。"}, {"type": "subtitle", "time": 973.35, "timestamp": "00:16:13", "text": "私は29キルしました。 私はトップの殺し屋だ。"}]
[{"type": "subtitle", "time": 1569.909, "timestamp": "00:26:09", "text": "、弾薬がない。"}, {"type": "subtitle", "time": 1577.19, "timestamp": "00:26:17", "text": "銃を必要としている。"}, {"type": "subtitle", "time": 1580.07, "timestamp": "00:26:20", "text": "誰かの死体が必要だ。"}, {"type": "subtitle", "time": 1583.51, "timestamp": "00:26:23", "text": "でも、私はグロックを持っています。"}, {"type": "subtitle", "time": 1586.31, "timestamp": "00:26:26", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 1611.669, "timestamp": "00:26:51", "text": "ニース。 ニース。 ニース。 ニース。 弾薬を発射せよ。 何てことだ"}, {"type": "subtitle", "time": 1613.669, "timestamp": "00:26:53", "text": "。 俺はプロだよ、兄弟。 私はプロ級の腕前だ"}, {"type": "subtitle", "time": 1618.549, "timestamp": "00:26:58", "text": "。 わかった。 グロック。 グロック。 グロックのロック。"}]
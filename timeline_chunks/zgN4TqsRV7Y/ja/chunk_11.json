[{"type": "subtitle", "time": 688.949, "timestamp": "00:11:28", "text": "。 頭部への一撃は即死です。 クレイジー。"}, {"type": "subtitle", "time": 703.509, "timestamp": "00:11:43", "text": "このバカな銃はどうですか？"}, {"type": "subtitle", "time": 714.069, "timestamp": "00:11:54", "text": "いいね、兄弟。 このゲーム、本当に人気が"}, {"type": "subtitle", "time": 716.23, "timestamp": "00:11:56", "text": "出てるよ。"}, {"type": "subtitle", "time": 719.67, "timestamp": "00:11:59", "text": "ああ、なんてこった、あれは"}]
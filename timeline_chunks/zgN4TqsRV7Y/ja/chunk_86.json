[{"type": "subtitle", "time": 5172.629, "timestamp": "01:26:12", "text": "パソコンの調子はどうですか？"}, {"type": "subtitle", "time": 5188.709, "timestamp": "01:26:28", "text": "知ってる？"}, {"type": "subtitle", "time": 5196.87, "timestamp": "01:26:36", "text": "AV1などの機能を使うために、50枚CDを再生できるノートパソコンが欲しかったんです。 そして、Twitchが"}, {"type": "subtitle", "time": 5199.27, "timestamp": "01:26:39", "text": "AV1をサポートしていないことに気づいた。  Kickは"}, {"type": "subtitle", "time": 5202.149, "timestamp": "01:26:42", "text": "AV1をサポートしていません。  YouTubeは全員をサポートしているけれど、"}, {"type": "subtitle", "time": 5206.95, "timestamp": "01:26:46", "text": "マルチストリーミングをしているのに"}, {"type": "subtitle", "time": 5210.47, "timestamp": "01:26:50", "text": "全員に配信できないとしたら、何の意味があるんだろう"}]
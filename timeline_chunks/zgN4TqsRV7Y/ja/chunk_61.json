[{"type": "subtitle", "time": 3662.63, "timestamp": "01:01:02", "text": "良いイメージを、"}, {"type": "subtitle", "time": 3670.069, "timestamp": "01:01:10", "text": "ええ、そういう人もいるでしょうけど、そういう"}, {"type": "subtitle", "time": 3674.309, "timestamp": "01:01:14", "text": "アート"}, {"type": "subtitle", "time": 3676.47, "timestamp": "01:01:16", "text": "とかそういうのは、私のファンアートとか、"}, {"type": "subtitle", "time": 3680.87, "timestamp": "01:01:20", "text": "メインのファンアートタグには入れたくないんです。"}, {"type": "subtitle", "time": 3683.589, "timestamp": "01:01:23", "text": "悲しいよ。"}, {"type": "subtitle", "time": 3686.789, "timestamp": "01:01:26", "text": "このモデルは、私が"}, {"type": "subtitle", "time": 3689.03, "timestamp": "01:01:29", "text": "2年間壁紙として使っているものなんです"}, {"type": "subtitle", "time": 3694.15, "timestamp": "01:01:34", "text": "えっと、それを"}, {"type": "subtitle", "time": 3701.109, "timestamp": "01:01:41", "text": "最終的に世に出すまでにどれだけ長い時間を待たなければならなかったか、"}, {"type": "subtitle", "time": 3704.63, "timestamp": "01:01:44", "text": "そしてすべてが。"}, {"type": "subtitle", "time": 3706.63, "timestamp": "01:01:46", "text": "私は、自分が鑑賞するためだけに、たくさんのカスタム"}, {"type": "subtitle", "time": 3708.63, "timestamp": "01:01:48", "text": "背景、つまり壁紙を作りました"}, {"type": "subtitle", "time": 3711.109, "timestamp": "01:01:51", "text": "。   まるで自分がずっと"}]
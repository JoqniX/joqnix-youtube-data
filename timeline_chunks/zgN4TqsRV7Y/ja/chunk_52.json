[{"type": "subtitle", "time": 3120.15, "timestamp": "00:52:00", "text": "良いことを言っているだけだと思う​​よ。 わかりません"}, {"type": "subtitle", "time": 3134.63, "timestamp": "00:52:14", "text": "ええと、私たちはただ話し合っているだけです。 こんにちは。"}, {"type": "subtitle", "time": 3139.91, "timestamp": "00:52:19", "text": "でも、えっと、"}, {"type": "subtitle", "time": 3141.589, "timestamp": "00:52:21", "text": "彼女がTwitterを使っているかどうかはわからないし、"}, {"type": "subtitle", "time": 3147.829, "timestamp": "00:52:27", "text": "最近はInstagramを使っているのかもしれないけど、"}, {"type": "subtitle", "time": 3152.95, "timestamp": "00:52:32", "text": "技術的な問題があったら、OBSとか"}, {"type": "subtitle", "time": 3154.87, "timestamp": "00:52:34", "text": "技術的なことで何か手助けが必要だったら、って彼女に言ったことがあったんだ。それで、"}, {"type": "subtitle", "time": 3163.75, "timestamp": "00:52:43", "text": "彼女が買ったノートパソコンと同じものを僕も買ったんだよ"}, {"type": "subtitle", "time": 3166.549, "timestamp": "00:52:46", "text": "。"}, {"type": "subtitle", "time": 3170.39, "timestamp": "00:52:50", "text": "ええ、日本から注文してノートパソコンを買おうと思って探していたんですが、"}, {"type": "subtitle", "time": 3177.43, "timestamp": "00:52:57", "text": "ここにたどり着いて、"}]
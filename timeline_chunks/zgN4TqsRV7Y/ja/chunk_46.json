[{"type": "subtitle", "time": 2765.03, "timestamp": "00:46:05", "text": "。 何？"}, {"type": "subtitle", "time": 2767.19, "timestamp": "00:46:07", "text": "インド・ルピーだといくらになりますか？"}, {"type": "subtitle", "time": 2786.87, "timestamp": "00:46:26", "text": "6 ポイント ああ、彼女は彼女は"}, {"type": "subtitle", "time": 2789.19, "timestamp": "00:46:29", "text": "626k に到達しました。"}, {"type": "subtitle", "time": 2803.829, "timestamp": "00:46:43", "text": "新しいホストに参加するために幽霊のように検索しているということです。"}, {"type": "subtitle", "time": 2806.309, "timestamp": "00:46:46", "text": "彼女は今、会員登録をしたばかりです。"}, {"type": "subtitle", "time": 2809.27, "timestamp": "00:46:49", "text": "それでおしまい。 ああ、"}, {"type": "subtitle", "time": 2812.47, "timestamp": "00:46:52", "text": "普通ならみんなそうするだろうけど、彼女には何か"}, {"type": "subtitle", "time": 2819.109, "timestamp": "00:46:59", "text": "通常、人々はそれを"}]
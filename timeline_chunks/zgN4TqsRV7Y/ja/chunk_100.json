[{"type": "subtitle", "time": 6025.75, "timestamp": "01:40:25", "text": "ああ、"}, {"type": "subtitle", "time": 6027.91, "timestamp": "01:40:27", "text": "ダブルキルが2回必要だ。 そうすれば"}, {"type": "subtitle", "time": 6030.47, "timestamp": "01:40:30", "text": "ドラムマガジンをロック解除できます。"}, {"type": "subtitle", "time": 6033.51, "timestamp": "01:40:33", "text": "ドラムマガジンが必要です。"}, {"type": "subtitle", "time": 6042.47, "timestamp": "01:40:42", "text": "コールオブデューティみたいなゲームをプレイするときはいつも"}, {"type": "subtitle", "time": 6046.39, "timestamp": "01:40:46", "text": "、今は"}, {"type": "subtitle", "time": 6049.669, "timestamp": "01:40:49", "text": "ドラムマガジンみたいなドラムガンをアンロックするのが主な目標なんだ。"}]
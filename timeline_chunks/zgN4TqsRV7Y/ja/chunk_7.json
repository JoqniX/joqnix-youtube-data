[{"type": "subtitle", "time": 421.11, "timestamp": "00:07:01", "text": "人々は、このゲームは"}, {"type": "subtitle", "time": 423.43, "timestamp": "00:07:03", "text": "Call of Dutyに似ているとか、ゲームの仕組みとか、"}, {"type": "subtitle", "time": 430.309, "timestamp": "00:07:10", "text": "そういう要素が全部揃っていると言っています。 それで、試しに"}, {"type": "subtitle", "time": 434.39, "timestamp": "00:07:14", "text": "プレイしてみようと思ったんです。"}, {"type": "subtitle", "time": 436.309, "timestamp": "00:07:16", "text": "ええ、そうですね。   えっと、ちょっと"}, {"type": "subtitle", "time": 439.909, "timestamp": "00:07:19", "text": "（音楽を）少し時間をください。"}, {"type": "subtitle", "time": 446.79, "timestamp": "00:07:26", "text": "チャットが接続されているか確認してみますので、"}, {"type": "subtitle", "time": 457.99, "timestamp": "00:07:37", "text": "ホラーファンボーイ"}, {"type": "subtitle", "time": 459.99, "timestamp": "00:07:39", "text": "178番さん、ようこそ。"}, {"type": "subtitle", "time": 465.67, "timestamp": "00:07:45", "text": "そして、退室する人たちは入ってきます"}, {"type": "subtitle", "time": 468.629, "timestamp": "00:07:48", "text": "。少し時間を"}, {"type": "subtitle", "time": 471.589, "timestamp": "00:07:51", "text": "ください。"}, {"type": "subtitle", "time": 475.43, "timestamp": "00:07:55", "text": "ああ、このゲームは大量の"}]
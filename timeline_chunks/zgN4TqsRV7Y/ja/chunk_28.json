[{"type": "subtitle", "time": 1691.59, "timestamp": "00:28:11", "text": "ああ、なんてことだ、彼。 彼は短機関銃を持っている。"}, {"type": "subtitle", "time": 1694.47, "timestamp": "00:28:14", "text": "いや、絶対に嫌だ。"}, {"type": "subtitle", "time": 1697.51, "timestamp": "00:28:17", "text": "ああ、彼は死んだんだ。 ニース。"}, {"type": "subtitle", "time": 1708.31, "timestamp": "00:28:28", "text": "どこでハサミを切ればいいの？"}, {"type": "subtitle", "time": 1711.909, "timestamp": "00:28:31", "text": "ああ、彼らは密告者みたいなものを手に入れたんだ。"}, {"type": "subtitle", "time": 1714.63, "timestamp": "00:28:34", "text": "待て、彼らが勝っている。 ああ、"}, {"type": "subtitle", "time": 1715.269, "timestamp": "00:28:35", "text": "彼らが勝った。"}, {"type": "subtitle", "time": 1717.669, "timestamp": "00:28:37", "text": "言い訳は通用しない。"}, {"type": "subtitle", "time": 1720.87, "timestamp": "00:28:40", "text": "ああ、ランニングバックか。 はい。"}]
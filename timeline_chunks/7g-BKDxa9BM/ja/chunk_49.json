[{"type": "subtitle", "time": 2940.39, "timestamp": "00:49:00", "text": "NPCと一緒に生まれた方法と"}, {"type": "subtitle", "time": 2942.549, "timestamp": "00:49:02", "text": "すべて。"}, {"type": "subtitle", "time": 2944.71, "timestamp": "00:49:04", "text": "相互作用中またはアクティブなときに、より多くの情報"}, {"type": "subtitle", "time": 2948.95, "timestamp": "00:49:08", "text": "サイドクエストをアクティブ化する。"}, {"type": "subtitle", "time": 2951.589, "timestamp": "00:49:11", "text": "ルノは、彼が尊敬している人たちと同じように、"}, {"type": "subtitle", "time": 2953.99, "timestamp": "00:49:13", "text": "強い人格を築き上げると"}, {"type": "subtitle", "time": 2956.63, "timestamp": "00:49:16", "text": "印象とサイコロゲームで"}, {"type": "subtitle", "time": 2964.47, "timestamp": "00:49:24", "text": "利点"}, {"type": "subtitle", "time": 2970.95, "timestamp": "00:49:30", "text": "楽しい知識が必要です"}, {"type": "subtitle", "time": 2973.51, "timestamp": "00:49:33", "text": "この世界を探検する。"}, {"type": "subtitle", "time": 2977.19, "timestamp": "00:49:37", "text": "Altキーを押しながら操作すると、文化と武器庫が表示されます。"}, {"type": "subtitle", "time": 2979.03, "timestamp": "00:49:39", "text": "今日の会場はどこでしょうか？"}, {"type": "subtitle", "time": 2981.75, "timestamp": "00:49:41", "text": "そしてゾンビ。ええと、ご覧いただけます、"}, {"type": "subtitle", "time": 2983.43, "timestamp": "00:49:43", "text": "キャラクターを置き換え、アップグレードし、"}, {"type": "subtitle", "time": 2985.99, "timestamp": "00:49:45", "text": "近接武器とトウモロコシ武器。"}, {"type": "subtitle", "time": 2989.589, "timestamp": "00:49:49", "text": "わかった。点をクリックして、点を結合します。"}, {"type": "subtitle", "time": 2991.75, "timestamp": "00:49:51", "text": "ああ、新しいキャラクターを無料でロックしました。"}, {"type": "subtitle", "time": 2993.19, "timestamp": "00:49:53", "text": "私の肩書きを聞いたことがある。"}, {"type": "subtitle", "time": 2994.549, "timestamp": "00:49:54", "text": "彼女はアンバーに似ている。"}, {"type": "subtitle", "time": 2996.23, "timestamp": "00:49:56", "text": "スピン。"}, {"type": "subtitle", "time": 2998.15, "timestamp": "00:49:58", "text": "それに賛同しないでください。電話してください"}, {"type": "subtitle", "time": 2999.43, "timestamp": "00:49:59", "text": "自分。"}]
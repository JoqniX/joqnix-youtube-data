[{"type": "subtitle", "time": 6480.39, "timestamp": "01:48:00", "text": "はい。"}, {"type": "subtitle", "time": 6482.07, "timestamp": "01:48:02", "text": "なるほど、そういうことか。"}, {"type": "subtitle", "time": 6484.47, "timestamp": "01:48:04", "text": "私の旅すべてにおいて、私たちは似たような"}, {"type": "subtitle", "time": 6486.07, "timestamp": "01:48:06", "text": "外観。"}, {"type": "subtitle", "time": 6489.189, "timestamp": "01:48:09", "text": "誰もが私と同じくらい魅力的だ。そして私たちは"}, {"type": "subtitle", "time": 6491.83, "timestamp": "01:48:11", "text": "非常に長生きする。"}, {"type": "subtitle", "time": 6492.229, "timestamp": "01:48:12", "text": "おお。"}, {"type": "subtitle", "time": 6494.55, "timestamp": "01:48:14", "text": "熟練の鍛冶屋のように、すべてのルノ"}, {"type": "subtitle", "time": 6497.189, "timestamp": "01:48:17", "text": "得意分野がある。"}, {"type": "subtitle", "time": 6502.39, "timestamp": "01:48:22", "text": "ああ、ご覧のとおり、私は悪魔的な"}, {"type": "subtitle", "time": 6505.83, "timestamp": "01:48:25", "text": "私の頭にある付属物。他にはない。"}, {"type": "subtitle", "time": 6508.95, "timestamp": "01:48:28", "text": "実際、私の人生で一度も見たことがない"}, {"type": "subtitle", "time": 6513.109, "timestamp": "01:48:33", "text": "ルナ。私は魔王のルノだ。"}, {"type": "subtitle", "time": 6514.229, "timestamp": "01:48:34", "text": "魔王。"}, {"type": "subtitle", "time": 6517.03, "timestamp": "01:48:37", "text": "残念ながら、ルノスのほとんどは野心に欠けている。"}, {"type": "subtitle", "time": 6518.95, "timestamp": "01:48:38", "text": "彼らはむしろ人間についていくことを好む。私の"}, {"type": "subtitle", "time": 6521.43, "timestamp": "01:48:41", "text": "小さな手下よ、お前は私について来なければならない。"}, {"type": "subtitle", "time": 6523.83, "timestamp": "01:48:43", "text": "私が世界を征服したら、あなたは"}, {"type": "subtitle", "time": 6526.47, "timestamp": "01:48:46", "text": "私の軍団のリーダー。待ってて"}, {"type": "subtitle", "time": 6527.59, "timestamp": "01:48:47", "text": "見る。"}, {"type": "subtitle", "time": 6530.95, "timestamp": "01:48:50", "text": "はい、殿下。共感。"}, {"type": "subtitle", "time": 6535.43, "timestamp": "01:48:55", "text": "わあ、とてもユニークですね。"}, {"type": "subtitle", "time": 6537.189, "timestamp": "01:48:57", "text": "入れる"}, {"type": "subtitle", "time": 6539.51, "timestamp": "01:48:59", "text": "タクティカルストアのアイテムをアップグレード"}]
[{"type": "subtitle", "time": 3482.789, "timestamp": "00:58:02", "text": "私自身にとってはどうなのか、私には分かりません。"}, {"type": "subtitle", "time": 3485.589, "timestamp": "00:58:05", "text": "誰かがちょっと"}, {"type": "subtitle", "time": 3493.99, "timestamp": "00:58:13", "text": "まだストーリークエスト中だからでしょうか？"}, {"type": "subtitle", "time": 3495.91, "timestamp": "00:58:15", "text": "それとも何か別のこと？"}, {"type": "subtitle", "time": 3527.589, "timestamp": "00:58:47", "text": "あなたは眼鏡をかけます。何"}, {"type": "subtitle", "time": 3534.23, "timestamp": "00:58:54", "text": "フロー武器スキン？"}]
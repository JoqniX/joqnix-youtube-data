[{"type": "subtitle", "time": 24664.948, "timestamp": "06:51:04", "text": "それはすばらしい。"}, {"type": "subtitle", "time": 24668.07, "timestamp": "06:51:08", "text": "乗客はライトをつけていますか？"}, {"type": "subtitle", "time": 24670.868, "timestamp": "06:51:10", "text": "窓は綺麗で暖かそうに見えますか？"}, {"type": "subtitle", "time": 24675.19, "timestamp": "06:51:15", "text": "暖炉の中の小さな炎みたい？"}, {"type": "subtitle", "time": 24676.788, "timestamp": "06:51:16", "text": "プシュケ、"}, {"type": "subtitle", "time": 24680.628, "timestamp": "06:51:20", "text": "いつ頃から視力が衰え始めましたか？"}, {"type": "subtitle", "time": 24683.51, "timestamp": "06:51:23", "text": "それはいつのことだった？"}, {"type": "subtitle", "time": 24686.468, "timestamp": "06:51:26", "text": "よくわからない。"}, {"type": "subtitle", "time": 24689.75, "timestamp": "06:51:29", "text": "以前と同じだろうと思っていたが、"}, {"type": "subtitle", "time": 24692.548, "timestamp": "06:51:32", "text": "しばらくの間、画面がぼやけているだけです。話さないでおこう"}, {"type": "subtitle", "time": 24694.39, "timestamp": "06:51:34", "text": "それについて。"}, {"type": "subtitle", "time": 24697.51, "timestamp": "06:51:37", "text": "行ってみたい場所があるんです。"}, {"type": "subtitle", "time": 24700.07, "timestamp": "06:51:40", "text": "彼女に聞きたいんだよ。"}, {"type": "subtitle", "time": 24705.19, "timestamp": "06:51:45", "text": "古い木の切り株の近く。さあ、着いたぞ。"}, {"type": "subtitle", "time": 24708.07, "timestamp": "06:51:48", "text": "できた"}, {"type": "subtitle", "time": 24712.788, "timestamp": "06:51:52", "text": "開けるの？これは、"}, {"type": "subtitle", "time": 24714.39, "timestamp": "06:51:54", "text": "カメラ。父は私に"}, {"type": "subtitle", "time": 24717.03, "timestamp": "06:51:57", "text": "カメラ機能のロックを解除しました。"}, {"type": "subtitle", "time": 24719.27, "timestamp": "06:51:59", "text": "しかし、私はそれを大切にしすぎた。だから私は来た"}]
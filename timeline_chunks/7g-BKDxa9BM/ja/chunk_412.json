[{"type": "subtitle", "time": 24721.35, "timestamp": "06:52:01", "text": "両親がいない時にここに一人でいる。"}, {"type": "subtitle", "time": 24723.91, "timestamp": "06:52:03", "text": "これでカメラで写真を撮ることができます。"}, {"type": "subtitle", "time": 24728.15, "timestamp": "06:52:08", "text": "彼らは私に腹を立てなかった。代わりに彼らは"}, {"type": "subtitle", "time": 24731.35, "timestamp": "06:52:11", "text": "「君が来たら掘り出そう」"}, {"type": "subtitle", "time": 24737.43, "timestamp": "06:52:17", "text": "A"}, {"type": "subtitle", "time": 24739.51, "timestamp": "06:52:19", "text": "一緒にいてくれてありがとう"}, {"type": "subtitle", "time": 24742.07, "timestamp": "06:52:22", "text": "過去数日間。私はもうそれを必要としません。"}, {"type": "subtitle", "time": 24750.31, "timestamp": "06:52:30", "text": "せっかくここにいるのだから、"}, {"type": "subtitle", "time": 24751.19, "timestamp": "06:52:31", "text": "どうですか？"}, {"type": "subtitle", "time": 24755.11, "timestamp": "06:52:35", "text": "おいおい、なんでこんなに感情的になるんだ？カメラには"}, {"type": "subtitle", "time": 24761.59, "timestamp": "06:52:41", "text": "時々私をここに連れてくるのは"}, {"type": "subtitle", "time": 24764.948, "timestamp": "06:52:44", "text": "歩く。時折隠れたり"}, {"type": "subtitle", "time": 24767.27, "timestamp": "06:52:47", "text": "汚物たちと共に探し求めよ、"}, {"type": "subtitle", "time": 24769.75, "timestamp": "06:52:49", "text": "私はいつもここに来るのを楽しみにしていた"}, {"type": "subtitle", "time": 24772.948, "timestamp": "06:52:52", "text": "なぜなら私は浮かぶ氷が好きで、"}, {"type": "subtitle", "time": 24777.03, "timestamp": "06:52:57", "text": "ここには山があります。さらに、私は"}]
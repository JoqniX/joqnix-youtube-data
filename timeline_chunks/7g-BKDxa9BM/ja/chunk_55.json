[{"type": "subtitle", "time": 3301.51, "timestamp": "00:55:01", "text": "ここからどれくらい離れているか知っていますか？それは"}, {"type": "subtitle", "time": 3303.43, "timestamp": "00:55:03", "text": "小さな島"}, {"type": "subtitle", "time": 3306.549, "timestamp": "00:55:06", "text": "ヒュポレイアの南は巨大な"}, {"type": "subtitle", "time": 3308.87, "timestamp": "00:55:08", "text": "天国の木ですよね？"}, {"type": "subtitle", "time": 3311.349, "timestamp": "00:55:11", "text": "それはとても遠い。"}, {"type": "subtitle", "time": 3314.47, "timestamp": "00:55:14", "text": "1,500 km。おお。"}, {"type": "subtitle", "time": 3316.15, "timestamp": "00:55:16", "text": "あなたはそこから来たのですか、それとも"}, {"type": "subtitle", "time": 3318.63, "timestamp": "00:55:18", "text": "そこへ行こうとしているのですか？"}, {"type": "subtitle", "time": 3322.79, "timestamp": "00:55:22", "text": "そんなに遠いの？しかし誰が、なぜ"}, {"type": "subtitle", "time": 3323.829, "timestamp": "00:55:23", "text": "彼らは？"}, {"type": "subtitle", "time": 3326.71, "timestamp": "00:55:26", "text": "よし、誰かが私たちをここに連れてきたんだ。いくら"}, {"type": "subtitle", "time": 3328.549, "timestamp": "00:55:28", "text": "pingの応答はどうですか？どうすれば確認できますか？"}, {"type": "subtitle", "time": 3330.23, "timestamp": "00:55:30", "text": "ping?"}, {"type": "subtitle", "time": 3332.95, "timestamp": "00:55:32", "text": "待って、"}, {"type": "subtitle", "time": 3344.309, "timestamp": "00:55:44", "text": "右下。"}, {"type": "subtitle", "time": 3347.99, "timestamp": "00:55:47", "text": "「右下」とはどういう意味ですか？"}, {"type": "subtitle", "time": 3351.19, "timestamp": "00:55:51", "text": "何もありません。"}]
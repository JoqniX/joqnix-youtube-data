[{"type": "subtitle", "time": 12722.229, "timestamp": "03:32:02", "text": "切り替えて正解だった。ああ、待って、待って、待って、"}, {"type": "subtitle", "time": 12725.429, "timestamp": "03:32:05", "text": "待って。自作農地。"}, {"type": "subtitle", "time": 12735.91, "timestamp": "03:32:15", "text": "それから私はこのゲームにもう二度と触れない"}, {"type": "subtitle", "time": 12743.429, "timestamp": "03:32:23", "text": "あらら。ああ、また黒い花だ。さあ"}, {"type": "subtitle", "time": 12747.349, "timestamp": "03:32:27", "text": "行く。黒い花を2つ手に入れました。"}, {"type": "subtitle", "time": 12750.07, "timestamp": "03:32:30", "text": "残り物。わかった。"}, {"type": "subtitle", "time": 12754.95, "timestamp": "03:32:34", "text": "残りの残り物。わかった。えっと"}, {"type": "subtitle", "time": 12756.95, "timestamp": "03:32:36", "text": "待って、ちょっと待って。それは黒ですか"}, {"type": "subtitle", "time": 12759.349, "timestamp": "03:32:39", "text": "花？"}, {"type": "subtitle", "time": 12769.429, "timestamp": "03:32:49", "text": "待って、待って、待って。それは黒い花です。"}]
[{"type": "subtitle", "time": 14281.429, "timestamp": "03:58:01", "text": "宝箱は集めたくない。正直に、"}, {"type": "subtitle", "time": 14283.189, "timestamp": "03:58:03", "text": "インタラクティブマップを使用して"}, {"type": "subtitle", "time": 14286.389, "timestamp": "03:58:06", "text": "それらを集めてください。"}, {"type": "subtitle", "time": 14289.269, "timestamp": "03:58:09", "text": "餌。特性を利用して遺伝子を引き寄せることができる"}, {"type": "subtitle", "time": 14291.269, "timestamp": "03:58:11", "text": "様々な数量の。より高品質で、"}, {"type": "subtitle", "time": 14297.349, "timestamp": "03:58:17", "text": "紅明邸で祈る"}, {"type": "subtitle", "time": 14298.87, "timestamp": "03:58:18", "text": "特に中央を狙う場合"}, {"type": "subtitle", "time": 14319.11, "timestamp": "03:58:39", "text": "ああ、これは私と一緒に来たものです。ニース。"}, {"type": "subtitle", "time": 14321.83, "timestamp": "03:58:41", "text": "はい、そういう仕組みです。あなたは"}, {"type": "subtitle", "time": 14327.269, "timestamp": "03:58:47", "text": "何が"}, {"type": "subtitle", "time": 14329.269, "timestamp": "03:58:49", "text": "この小さな子が言うには、"}, {"type": "subtitle", "time": 14332.389, "timestamp": "03:58:52", "text": "信頼できる人のように親しみを感じる"}, {"type": "subtitle", "time": 14334.469, "timestamp": "03:58:54", "text": "それはあなたと一緒に行きたがっています。"}, {"type": "subtitle", "time": 14336.15, "timestamp": "03:58:56", "text": "あなたが責任を持って対処してください。"}]
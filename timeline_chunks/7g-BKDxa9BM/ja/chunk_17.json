[{"type": "subtitle", "time": 1022.55, "timestamp": "00:17:02", "text": "ニース。"}, {"type": "subtitle", "time": 1067.669, "timestamp": "00:17:47", "text": "つまり、彼らは恐らく逃げ出したということだ"}, {"type": "subtitle", "time": 1069.83, "timestamp": "00:17:49", "text": "船で。私たちは急いで家に帰って"}, {"type": "subtitle", "time": 1072.39, "timestamp": "00:17:52", "text": "武器を準備してから埠頭へ向かう。"}, {"type": "subtitle", "time": 1075.029, "timestamp": "00:17:55", "text": "私たちは現在、非武装です。私たちはしなければならない"}, {"type": "subtitle", "time": 1078.31, "timestamp": "00:17:58", "text": "そういった汚物はできる限り避けてください。"}]
[{"type": "subtitle", "time": 1581.83, "timestamp": "00:26:21", "text": "つまり、鍵となるのはこの剣だ。"}, {"type": "subtitle", "time": 1589.19, "timestamp": "00:26:29", "text": "[音楽]"}, {"type": "subtitle", "time": 1591.51, "timestamp": "00:26:31", "text": "見て、蝶々。"}, {"type": "subtitle", "time": 1595.11, "timestamp": "00:26:35", "text": "ああ、君なら受け取れるよ。わかった。"}, {"type": "subtitle", "time": 1610.07, "timestamp": "00:26:50", "text": "頂上を目指しましょう。使用"}, {"type": "subtitle", "time": 1613.19, "timestamp": "00:26:53", "text": "飛行船になる。彼女は"}, {"type": "subtitle", "time": 1614.31, "timestamp": "00:26:54", "text": "もしかしたら、そこから抜け出せるかもしれない。おお、"}]
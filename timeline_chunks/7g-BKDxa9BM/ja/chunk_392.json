[{"type": "subtitle", "time": 23523.41, "timestamp": "06:32:03", "text": "私をその気にさせる。"}, {"type": "subtitle", "time": 23551.19, "timestamp": "06:32:31", "text": "[音楽]"}, {"type": "subtitle", "time": 23552.72, "timestamp": "06:32:32", "text": "わかった。"}, {"type": "subtitle", "time": 23555.91, "timestamp": "06:32:35", "text": "[音楽]"}, {"type": "subtitle", "time": 23564.948, "timestamp": "06:32:44", "text": "あなたは過去の部外者で、私を"}, {"type": "subtitle", "time": 23567.35, "timestamp": "06:32:47", "text": "ここで見張りをしてください。この魔王の"}, {"type": "subtitle", "time": 23568.868, "timestamp": "06:32:48", "text": "優れた才能はリーダーシップを発揮するためにある"}, {"type": "subtitle", "time": 23570.548, "timestamp": "06:32:50", "text": "狩猟、保管しない"}, {"type": "subtitle", "time": 23572.628, "timestamp": "06:32:52", "text": "それはあなたが特別な才能を持っているからです"}, {"type": "subtitle", "time": 23573.75, "timestamp": "06:32:53", "text": "のために"}, {"type": "subtitle", "time": 23575.75, "timestamp": "06:32:55", "text": "私の"}, {"type": "subtitle", "time": 23578.868, "timestamp": "06:32:58", "text": "いいえ、全く違います。シーッ。"}]
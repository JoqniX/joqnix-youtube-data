[{"type": "subtitle", "time": 19502.23, "timestamp": "05:25:02", "text": "私は登ることができません。わかった。"}, {"type": "subtitle", "time": 19503.91, "timestamp": "05:25:03", "text": "連絡は取らないこと。"}, {"type": "subtitle", "time": 19506.788, "timestamp": "05:25:06", "text": "ついに血清が手に入ったんですね。これ"}, {"type": "subtitle", "time": 19513.35, "timestamp": "05:25:13", "text": "第一波が終了しました。"}, {"type": "subtitle", "time": 19515.67, "timestamp": "05:25:15", "text": "もっと欲しい。"}, {"type": "subtitle", "time": 19517.83, "timestamp": "05:25:17", "text": "行く。"}, {"type": "subtitle", "time": 19520.788, "timestamp": "05:25:20", "text": "ルルは解放しようと試みているように見える"}, {"type": "subtitle", "time": 19524.708, "timestamp": "05:25:24", "text": "敗北は、おお"}, {"type": "subtitle", "time": 19535.27, "timestamp": "05:25:35", "text": "すべてだ。次回は必ず手に入りますよ。ただ"}]
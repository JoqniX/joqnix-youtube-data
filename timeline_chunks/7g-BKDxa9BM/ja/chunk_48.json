[{"type": "subtitle", "time": 2881.43, "timestamp": "00:48:01", "text": "時間、もしあなたが"}, {"type": "subtitle", "time": 2884.47, "timestamp": "00:48:04", "text": "汚物ども、我々について来い。"}, {"type": "subtitle", "time": 2887.91, "timestamp": "00:48:07", "text": "汚物FOD。わかった。どのように"}, {"type": "subtitle", "time": 2890.23, "timestamp": "00:48:10", "text": "残りの地図帳には、それが示されている。取ろう"}, {"type": "subtitle", "time": 2892.23, "timestamp": "00:48:12", "text": "私たちが受けた印象をじっくり見てみましょう"}, {"type": "subtitle", "time": 2896.55, "timestamp": "00:48:16", "text": "地域。わかった。どうやらこのゲームは"}, {"type": "subtitle", "time": 2898.79, "timestamp": "00:48:18", "text": "これは私にとって初めてのことです"}, {"type": "subtitle", "time": 2902.069, "timestamp": "00:48:22", "text": "ガチャゲームをプレイしている"}, {"type": "subtitle", "time": 2906.069, "timestamp": "00:48:26", "text": "えっと、セリフの印象とか。"}, {"type": "subtitle", "time": 2909.51, "timestamp": "00:48:29", "text": "だから人と話すときは、"}, {"type": "subtitle", "time": 2912.549, "timestamp": "00:48:32", "text": "適切な選択をするために"}, {"type": "subtitle", "time": 2915.19, "timestamp": "00:48:35", "text": "印象が増したり、"}, {"type": "subtitle", "time": 2917.43, "timestamp": "00:48:37", "text": "減少やその他は、何によっても異なります"}, {"type": "subtitle", "time": 2920.79, "timestamp": "00:48:40", "text": "私が選んだ選択です。右。そしてそれは"}, {"type": "subtitle", "time": 2925.829, "timestamp": "00:48:45", "text": "いいね。私はこれまで、"}, {"type": "subtitle", "time": 2928.95, "timestamp": "00:48:48", "text": "これを実行するため。いつものように"}, {"type": "subtitle", "time": 2931.19, "timestamp": "00:48:51", "text": "ランダムにボタンを押すだけでいい"}, {"type": "subtitle", "time": 2933.349, "timestamp": "00:48:53", "text": "対話。どんなことでも構わない"}, {"type": "subtitle", "time": 2934.95, "timestamp": "00:48:54", "text": "対話を選ぶようなもの、"}, {"type": "subtitle", "time": 2938.63, "timestamp": "00:48:58", "text": "右？しかし、ここでは第一印象が重要となる。"}]
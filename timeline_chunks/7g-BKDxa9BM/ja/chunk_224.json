[{"type": "subtitle", "time": 13440.309, "timestamp": "03:44:00", "text": "何が起こっているの？"}, {"type": "subtitle", "time": 13442.95, "timestamp": "03:44:02", "text": "息をつく暇もない。聞いてくれ、誰か"}, {"type": "subtitle", "time": 13446.71, "timestamp": "03:44:06", "text": "アイスレイクの外で巨大な豚を見かけた"}, {"type": "subtitle", "time": 13449.349, "timestamp": "03:44:09", "text": "そして帽子をかぶったあなたより背が高い"}, {"type": "subtitle", "time": 13452.87, "timestamp": "03:44:12", "text": "バンくらいの大きさ。そして、それがそれを止めれば、バン、"}]
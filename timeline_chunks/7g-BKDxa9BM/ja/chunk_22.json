[{"type": "subtitle", "time": 1322.95, "timestamp": "00:22:02", "text": "あれに頼るしかないだろうな。"}, {"type": "subtitle", "time": 1325.27, "timestamp": "00:22:05", "text": "聞いて、実はもう1つあるんだ"}, {"type": "subtitle", "time": 1327.669, "timestamp": "00:22:07", "text": "こんにちは、フランコ。ストリームへようこそ"}, {"type": "subtitle", "time": 1330.549, "timestamp": "00:22:10", "text": "山奥の遺跡。"}, {"type": "subtitle", "time": 1333.51, "timestamp": "00:22:13", "text": "山の上の船。"}, {"type": "subtitle", "time": 1335.029, "timestamp": "00:22:15", "text": "いらっしゃいませ。ようこそ。"}, {"type": "subtitle", "time": 1340.23, "timestamp": "00:22:20", "text": "そう、空を飛ぶ船だ。さあ、私についてきてください。"}, {"type": "subtitle", "time": 1343.35, "timestamp": "00:22:23", "text": "空を飛ぶ船。"}, {"type": "subtitle", "time": 1345.11, "timestamp": "00:22:25", "text": "遠距離武器は、"}, {"type": "subtitle", "time": 1347.35, "timestamp": "00:22:27", "text": "エレベーターの位置にいる敵。ない"}, {"type": "subtitle", "time": 1351.83, "timestamp": "00:22:31", "text": "それは彼らのマガジン内の弾薬に制限をかけるものだ。"}, {"type": "subtitle", "time": 1354.23, "timestamp": "00:22:34", "text": "弾薬を入手できるチャンスがあります"}, {"type": "subtitle", "time": 1355.909, "timestamp": "00:22:35", "text": "敵を倒し、宝箱を開け、"}, {"type": "subtitle", "time": 1357.909, "timestamp": "00:22:37", "text": "回復可能なオブジェクトを破壊する"}, {"type": "subtitle", "time": 1362.23, "timestamp": "00:22:42", "text": "武器の補充に用いられる。わかった、"}, {"type": "subtitle", "time": 1365.75, "timestamp": "00:22:45", "text": "さらに多くのIDが登場します。"}, {"type": "subtitle", "time": 1368.31, "timestamp": "00:22:48", "text": "そばにいて。必要に応じて、"}, {"type": "subtitle", "time": 1370.87, "timestamp": "00:22:50", "text": "秘密の信号。私たちはそれらを以前に作りました"}, {"type": "subtitle", "time": 1374.71, "timestamp": "00:22:54", "text": "警戒されないように。"}]
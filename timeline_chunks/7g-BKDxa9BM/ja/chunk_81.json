[{"type": "subtitle", "time": 4862.31, "timestamp": "01:21:02", "text": "家？宿泊客からその話を聞きました"}, {"type": "subtitle", "time": 4865.189, "timestamp": "01:21:05", "text": "アスピデルにて。いつも誰かがいる"}, {"type": "subtitle", "time": 4867.669, "timestamp": "01:21:07", "text": "不満を言う。たとえそれがとても"}, {"type": "subtitle", "time": 4869.99, "timestamp": "01:21:09", "text": "大きな宿屋、扉はいつも閉まっている"}, {"type": "subtitle", "time": 4872.55, "timestamp": "01:21:12", "text": "毎日きつく締められ、"}, {"type": "subtitle", "time": 4876.07, "timestamp": "01:21:16", "text": "町外からの旅行者。あるいはどのように"}, {"type": "subtitle", "time": 4879.91, "timestamp": "01:21:19", "text": "下宿人たちは、まるで決して出て行かないようだ。"}, {"type": "subtitle", "time": 4882.79, "timestamp": "01:21:22", "text": "そして宿屋の主人の顔はますます冷たくなっている"}, {"type": "subtitle", "time": 4895.11, "timestamp": "01:21:35", "text": "[音楽]"}, {"type": "subtitle", "time": 4897.35, "timestamp": "01:21:37", "text": "まるで彼は"}, {"type": "subtitle", "time": 4897.99, "timestamp": "01:21:37", "text": "1"}, {"type": "subtitle", "time": 4899.59, "timestamp": "01:21:39", "text": "くしゃみが止まらない。"}, {"type": "subtitle", "time": 4902.47, "timestamp": "01:21:42", "text": "悪くない話ですね。私はそう思った"}, {"type": "subtitle", "time": 4904.39, "timestamp": "01:21:44", "text": "汚物と犯罪者で溢れかえっている。"}, {"type": "subtitle", "time": 4906.31, "timestamp": "01:21:46", "text": "共同作業機能。黒を完成させる"}, {"type": "subtitle", "time": 4909.43, "timestamp": "01:21:49", "text": "その章の鉄と白水。いいえ"}, {"type": "subtitle", "time": 4911.189, "timestamp": "01:21:51", "text": "協力プレイをアンロックするには、回してください。他のプレイヤーと交流しよう"}, {"type": "subtitle", "time": 4913.59, "timestamp": "01:21:53", "text": "専念した時間を通じて"}]
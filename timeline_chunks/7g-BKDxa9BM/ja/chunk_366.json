[{"type": "subtitle", "time": 21960.708, "timestamp": "06:06:00", "text": "わかった、"}, {"type": "subtitle", "time": 21965.03, "timestamp": "06:06:05", "text": "まずは最悪のケースから聞いてみましょう。"}, {"type": "subtitle", "time": 21969.03, "timestamp": "06:06:09", "text": "プルガトリオ島に残された部隊は"}, {"type": "subtitle", "time": 21971.75, "timestamp": "06:06:11", "text": "3日間その地域を捜索しているが、"}, {"type": "subtitle", "time": 21973.99, "timestamp": "06:06:13", "text": "彼らはまだその痕跡を何も見つけていない"}, {"type": "subtitle", "time": 21980.868, "timestamp": "06:06:20", "text": "私たちは近くの海域を捜索した。"}, {"type": "subtitle", "time": 21982.47, "timestamp": "06:06:22", "text": "彼女が落ちた直後"}, {"type": "subtitle", "time": 21984.948, "timestamp": "06:06:24", "text": "崖。理論的には、彼女は"}, {"type": "subtitle", "time": 21987.91, "timestamp": "06:06:27", "text": "遠くまで漂流するべきではなかった"}, {"type": "subtitle", "time": 21990.868, "timestamp": "06:06:30", "text": "ない限り"}, {"type": "subtitle", "time": 21996.868, "timestamp": "06:06:36", "text": "誰かが"}, {"type": "subtitle", "time": 21999.83, "timestamp": "06:06:39", "text": "彼女を救出した。"}, {"type": "subtitle", "time": 22001.75, "timestamp": "06:06:41", "text": "引き続き住居の調査を続けます"}, {"type": "subtitle", "time": 22004.39, "timestamp": "06:06:44", "text": "近隣の島々。容疑者を残さず、"}, {"type": "subtitle", "time": 22007.59, "timestamp": "06:06:47", "text": "監視されていない目撃者。"}, {"type": "subtitle", "time": 22009.75, "timestamp": "06:06:49", "text": "既に着手しており、さらに拡大しています"}, {"type": "subtitle", "time": 22015.27, "timestamp": "06:06:55", "text": "捜索範囲。ええと、もしよろしければお伺いしたいのですが、"}, {"type": "subtitle", "time": 22017.91, "timestamp": "06:06:57", "text": "彼女を見つけたら、"}, {"type": "subtitle", "time": 22019.27, "timestamp": "06:06:59", "text": "共振、"}]
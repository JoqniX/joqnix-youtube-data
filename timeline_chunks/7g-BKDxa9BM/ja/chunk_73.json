[{"type": "subtitle", "time": 4395.189, "timestamp": "01:13:15", "text": "うん。だから、私がアジアを選んだから。さて、"}, {"type": "subtitle", "time": 4398.87, "timestamp": "01:13:18", "text": "私がアジアを選んだ理由は"}, {"type": "subtitle", "time": 4401.43, "timestamp": "01:13:21", "text": "来年、私は日本に行くんですよね？だから私は"}, {"type": "subtitle", "time": 4404.149, "timestamp": "01:13:24", "text": "pingの問題は避けたい。しかし問題は"}, {"type": "subtitle", "time": 4408.79, "timestamp": "01:13:28", "text": "原神を見るために、私はアジアを選びました。のために"}, {"type": "subtitle", "time": 4413.03, "timestamp": "01:13:33", "text": "ヴヴァ、私はSCAを選んだんだよね？"}, {"type": "subtitle", "time": 4415.99, "timestamp": "01:13:35", "text": "それで、"}, {"type": "subtitle", "time": 4419.669, "timestamp": "01:13:39", "text": "もしそれが見えるなら、"}, {"type": "subtitle", "time": 4423.27, "timestamp": "01:13:43", "text": "SCAを選んでもよかったのかもしれない。私"}, {"type": "subtitle", "time": 4433.35, "timestamp": "01:13:53", "text": "とても混乱しています。"}]
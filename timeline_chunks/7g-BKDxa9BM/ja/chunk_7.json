[{"type": "subtitle", "time": 439.029, "timestamp": "00:07:19", "text": "とても綺麗ですよね？ゲーム"}, {"type": "subtitle", "time": 441.99, "timestamp": "00:07:21", "text": "品質とかそういうもの。"}, {"type": "subtitle", "time": 444.39, "timestamp": "00:07:24", "text": "カットシーンであっても、"}, {"type": "subtitle", "time": 446.79, "timestamp": "00:07:26", "text": "かわいい。新規登録。"}, {"type": "subtitle", "time": 449.27, "timestamp": "00:07:29", "text": "それは二重らせんのように展開する。"}, {"type": "subtitle", "time": 450.87, "timestamp": "00:07:30", "text": "ああ、これは本当にすごい。"}, {"type": "subtitle", "time": 451.029, "timestamp": "00:07:31", "text": "聞く"}, {"type": "subtitle", "time": 454.87, "timestamp": "00:07:34", "text": "私自身もその質問を数えきれないほど考えました。"}, {"type": "subtitle", "time": 458.71, "timestamp": "00:07:38", "text": "しかし、今のところ回答は得られていない。"}, {"type": "subtitle", "time": 459.51, "timestamp": "00:07:39", "text": "おお。"}]
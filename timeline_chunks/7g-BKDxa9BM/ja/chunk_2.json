[{"type": "subtitle", "time": 150.15, "timestamp": "00:02:30", "text": "[音楽]"}, {"type": "subtitle", "time": 152.71, "timestamp": "00:02:32", "text": "みなさん、こんにちは。"}, {"type": "subtitle", "time": 159.99, "timestamp": "00:02:39", "text": "皆さん、おはようございます。"}, {"type": "subtitle", "time": 166.07, "timestamp": "00:02:46", "text": "皆さん、お元気ですか？"}, {"type": "subtitle", "time": 170.15, "timestamp": "00:02:50", "text": "大丈夫です。15分遅れました。その"}, {"type": "subtitle", "time": 173.589, "timestamp": "00:02:53", "text": "わかった。 15分遅刻したことは分かっています。私"}, {"type": "subtitle", "time": 176.47, "timestamp": "00:02:56", "text": "わかってるけど、大丈夫だよ。私たちは遊ぶことができました"}]
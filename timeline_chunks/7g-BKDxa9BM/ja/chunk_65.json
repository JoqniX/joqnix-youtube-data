[{"type": "subtitle", "time": 3903.589, "timestamp": "01:05:03", "text": "道徳。"}, {"type": "subtitle", "time": 3906.15, "timestamp": "01:05:06", "text": "どの島ですか？具体的に述べてください。がある"}, {"type": "subtitle", "time": 3908.549, "timestamp": "01:05:08", "text": "まるで百万の島々のようだ。どうでも。見せる"}, {"type": "subtitle", "time": 3914.23, "timestamp": "01:05:14", "text": "彼女は南部出身だ。ビバールより送信"}, {"type": "subtitle", "time": 3917.029, "timestamp": "01:05:17", "text": "ワイナリーが商品を配達する。橋は"}, {"type": "subtitle", "time": 3919.67, "timestamp": "01:05:19", "text": "滑りやすかったので、カートがひっくり返り、"}, {"type": "subtitle", "time": 3921.67, "timestamp": "01:05:21", "text": "汚い連中がこの貧しい人を破壊した"}, {"type": "subtitle", "time": 3924.71, "timestamp": "01:05:24", "text": "物の貨物と荷物。"}, {"type": "subtitle", "time": 3927.27, "timestamp": "01:05:27", "text": "近いうちに旅行許可証を再申請します。"}, {"type": "subtitle", "time": 3929.43, "timestamp": "01:05:29", "text": "しかし、その子供はかなり動揺している。"}, {"type": "subtitle", "time": 3930.23, "timestamp": "01:05:30", "text": "ああ、我が子よ。"}, {"type": "subtitle", "time": 3933.27, "timestamp": "01:05:33", "text": "このかわいそうな生き物に慈悲をかけてあげてください。"}, {"type": "subtitle", "time": 3935.109, "timestamp": "01:05:35", "text": "私はそれを見た。"}, {"type": "subtitle", "time": 3943.589, "timestamp": "01:05:43", "text": "悲しい顔をする。"}, {"type": "subtitle", "time": 3945.589, "timestamp": "01:05:45", "text": "なぜ泣いているのですか？"}, {"type": "subtitle", "time": 3948.39, "timestamp": "01:05:48", "text": "ちくしょう。チーフは対処法を教えてくれなかった"}, {"type": "subtitle", "time": 3951.19, "timestamp": "01:05:51", "text": "涙を流す若い女性たちと共に。"}, {"type": "subtitle", "time": 3953.029, "timestamp": "01:05:53", "text": "これは簡単なことだっただろう"}, {"type": "subtitle", "time": 3955.27, "timestamp": "01:05:55", "text": "過去のことですが、カミラさん、でもご存知の通り、"}, {"type": "subtitle", "time": 3958.95, "timestamp": "01:05:58", "text": "最近フォークを振ったり何か"}]
[{"type": "subtitle", "time": 13927.67, "timestamp": "03:52:07", "text": "[音楽]"}, {"type": "subtitle", "time": 13956.95, "timestamp": "03:52:36", "text": "わかった。こちらです。"}, {"type": "subtitle", "time": 13959.75, "timestamp": "03:52:39", "text": "さあ、着いたぞ。ラメンティング湖の南"}, {"type": "subtitle", "time": 13962.389, "timestamp": "03:52:42", "text": "大きな斜面。ここで人々はこう言った"}, {"type": "subtitle", "time": 13965.75, "timestamp": "03:52:45", "text": "彼らは巨大な豚を見た。"}, {"type": "subtitle", "time": 13967.269, "timestamp": "03:52:47", "text": "巨大な豚。"}, {"type": "subtitle", "time": 13969.51, "timestamp": "03:52:49", "text": "何も見えません。"}, {"type": "subtitle", "time": 13970.63, "timestamp": "03:52:50", "text": "いや、そんなはずはない。"}, {"type": "subtitle", "time": 13974.07, "timestamp": "03:52:54", "text": "よし。私は行きます。あ、待って、待って。"}, {"type": "subtitle", "time": 13977.189, "timestamp": "03:52:57", "text": "あちらを見て。見る？来て。もし"}, {"type": "subtitle", "time": 13979.75, "timestamp": "03:52:59", "text": "そうではないので、戻ります。"}]
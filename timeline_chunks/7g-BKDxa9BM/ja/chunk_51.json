[{"type": "subtitle", "time": 3061.91, "timestamp": "00:51:01", "text": "ああ、鎌だ。大好きです。"}, {"type": "subtitle", "time": 3070.309, "timestamp": "00:51:10", "text": "それは日本刀のように見える。"}, {"type": "subtitle", "time": 3072.39, "timestamp": "00:51:12", "text": "それは日本刀です。わかった。ええ、それは"}, {"type": "subtitle", "time": 3073.91, "timestamp": "00:51:13", "text": "刀。"}, {"type": "subtitle", "time": 3077.27, "timestamp": "00:51:17", "text": "二本の短剣。ニース。"}, {"type": "subtitle", "time": 3081.829, "timestamp": "00:51:21", "text": "ああ、それ大好き。それ、すごく好き。"}, {"type": "subtitle", "time": 3095.03, "timestamp": "00:51:35", "text": "おお。"}, {"type": "subtitle", "time": 3097.03, "timestamp": "00:51:37", "text": "キャラクター。よし、見てみよう。"}, {"type": "subtitle", "time": 3098.23, "timestamp": "00:51:38", "text": "私がしなければならない"}, {"type": "subtitle", "time": 3108.63, "timestamp": "00:51:48", "text": "さぁ行こう。私をデートに連れて行ってくれるの？フィナ、"}, {"type": "subtitle", "time": 3112.15, "timestamp": "00:51:52", "text": "お前がサイコパスだってことは知ってたよ。"}, {"type": "subtitle", "time": 3113.91, "timestamp": "00:51:53", "text": "ありがとう。"}, {"type": "subtitle", "time": 3115.27, "timestamp": "00:51:55", "text": "レベッカ、"}, {"type": "subtitle", "time": 3117.349, "timestamp": "00:51:57", "text": "彼女を手に入れたい。彼女はAFKに適している"}, {"type": "subtitle", "time": 3119.91, "timestamp": "00:51:59", "text": "どうやら農業らしい。私は聞いた"}]
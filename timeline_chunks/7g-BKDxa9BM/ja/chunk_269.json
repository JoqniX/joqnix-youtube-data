[{"type": "subtitle", "time": 16158.07, "timestamp": "04:29:18", "text": "すべては金持ちから始まったようだ"}, {"type": "subtitle", "time": 16161.83, "timestamp": "04:29:21", "text": "近くの山々には天空の鉱脈が見られる。"}, {"type": "subtitle", "time": 16165.269, "timestamp": "04:29:25", "text": "その通り。ずっと昔、"}, {"type": "subtitle", "time": 16167.51, "timestamp": "04:29:27", "text": "人々は危険を冒して収集した"}]
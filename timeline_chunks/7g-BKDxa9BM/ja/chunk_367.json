[{"type": "subtitle", "time": 22031.35, "timestamp": "06:07:11", "text": "完全に覚醒した共鳴は"}, {"type": "subtitle", "time": 22034.39, "timestamp": "06:07:14", "text": "悪魔を制御できるが、その力は"}, {"type": "subtitle", "time": 22045.11, "timestamp": "06:07:25", "text": "それは本当です。"}, {"type": "subtitle", "time": 22048.23, "timestamp": "06:07:28", "text": "つまり、彼女が協力しない場合は、"}, {"type": "subtitle", "time": 22051.35, "timestamp": "06:07:31", "text": "彼女を捕らえても、帝国にとっては何の益にもならない。"}, {"type": "subtitle", "time": 22053.75, "timestamp": "06:07:33", "text": "さらに悪いことに、それは脅威になる可能性があり、"}, {"type": "subtitle", "time": 22056.628, "timestamp": "06:07:36", "text": "前回同様。"}, {"type": "subtitle", "time": 22059.27, "timestamp": "06:07:39", "text": "それから、以前と同じことをする。拭く"}, {"type": "subtitle", "time": 22062.15, "timestamp": "06:07:42", "text": "外。その力は外に落ちない"}, {"type": "subtitle", "time": 22064.39, "timestamp": "06:07:44", "text": "帝国の手、特に"}, {"type": "subtitle", "time": 22066.07, "timestamp": "06:07:46", "text": "楽園。"}, {"type": "subtitle", "time": 22073.51, "timestamp": "06:07:53", "text": "それは別の問題に関するものです。その間"}, {"type": "subtitle", "time": 22076.708, "timestamp": "06:07:56", "text": "無人島を探索していると、"}, {"type": "subtitle", "time": 22078.47, "timestamp": "06:07:58", "text": "まるでボウルを味わっているかのようだ"}]
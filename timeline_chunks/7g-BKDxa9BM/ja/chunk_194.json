[{"type": "subtitle", "time": 11643.349, "timestamp": "03:14:03", "text": "Chameleia がプレイ可能になったとき"}, {"type": "subtitle", "time": 11647.11, "timestamp": "03:14:07", "text": "お泊まり会をしても構いません。何だって？"}, {"type": "subtitle", "time": 11649.67, "timestamp": "03:14:09", "text": "一体何なんだ？"}, {"type": "subtitle", "time": 11651.349, "timestamp": "03:14:11", "text": "何かの装置か何かがあるんだ。あなたはできる"}, {"type": "subtitle", "time": 11672.309, "timestamp": "03:14:32", "text": "ええと、一つだけさせてください。わかった、辞めるよ"}, {"type": "subtitle", "time": 11679.99, "timestamp": "03:14:39", "text": "ゲームをやめます。私は辞めます"}, {"type": "subtitle", "time": 11681.91, "timestamp": "03:14:41", "text": "ランチャー。"}, {"type": "subtitle", "time": 11689.99, "timestamp": "03:14:49", "text": "私はすぐにブループロトコル関連の作業をして、"}, {"type": "subtitle", "time": 11692.309, "timestamp": "03:14:52", "text": "それから、こちらに戻ります"}, {"type": "subtitle", "time": 11694.87, "timestamp": "03:14:54", "text": "ゲーム。わかった。"}, {"type": "subtitle", "time": 11698.15, "timestamp": "03:14:58", "text": "えっと、もし私がそうしていたら本当にごめんなさい"}]
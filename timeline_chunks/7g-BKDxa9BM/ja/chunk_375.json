[{"type": "subtitle", "time": 22509.59, "timestamp": "06:15:09", "text": "[音楽]"}, {"type": "subtitle", "time": 22525.83, "timestamp": "06:15:25", "text": "ああ、45口径の銃が手に入る。弓も手に入る。"}, {"type": "subtitle", "time": 22528.31, "timestamp": "06:15:28", "text": "わかった。わかった。わかった、私はただ"}, {"type": "subtitle", "time": 22544.548, "timestamp": "06:15:44", "text": "うわー、かっこいい新しいものを手に入れたね"}, {"type": "subtitle", "time": 22547.11, "timestamp": "06:15:47", "text": "ギヤ。ちょっと見せてもらってもいいですか？しないで"}, {"type": "subtitle", "time": 22550.93, "timestamp": "06:15:50", "text": "心配しないで、壊したりしないから。"}]
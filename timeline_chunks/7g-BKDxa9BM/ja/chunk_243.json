[{"type": "subtitle", "time": 14581.03, "timestamp": "04:03:01", "text": "私の情熱は"}, {"type": "subtitle", "time": 14609.349, "timestamp": "04:03:29", "text": "こっそりやらなきゃいけないよね？"}, {"type": "subtitle", "time": 14612.79, "timestamp": "04:03:32", "text": "私ならできます。"}, {"type": "subtitle", "time": 14615.269, "timestamp": "04:03:35", "text": "まるでゲームをしているような気分だ。"}, {"type": "subtitle", "time": 14618.07, "timestamp": "04:03:38", "text": "ほら、すぐそこだよ。避けることを忘れないでください"}, {"type": "subtitle", "time": 14620.71, "timestamp": "04:03:40", "text": "巡回隊員たち。彼らが起動した場合"}, {"type": "subtitle", "time": 14632.63, "timestamp": "04:03:52", "text": "わかった、"}]
[{"type": "subtitle", "time": 17824.07, "timestamp": "04:57:04", "text": "私があなたを解放します。エンドゲーム。心配しないで。"}, {"type": "subtitle", "time": 17826.55, "timestamp": "04:57:06", "text": "必ず君を見つけ出す。"}, {"type": "subtitle", "time": 17839.91, "timestamp": "04:57:19", "text": "こんにちは、よそ者さん。アウディ。"}, {"type": "subtitle", "time": 17842.55, "timestamp": "04:57:22", "text": "さあ、本題に入ろう。"}, {"type": "subtitle", "time": 17850.868, "timestamp": "04:57:30", "text": "あなたのクリスタルを拝借してしまって申し訳ありませんでした。そうしなければならなかった"}, {"type": "subtitle", "time": 17852.23, "timestamp": "04:57:32", "text": "そうすれば二人きりで話せるから"}, {"type": "subtitle", "time": 17853.43, "timestamp": "04:57:33", "text": "ここ。"}, {"type": "subtitle", "time": 17856.15, "timestamp": "04:57:36", "text": "いや、彼女は大丈夫だよ。あの小さなボタン"}, {"type": "subtitle", "time": 17857.91, "timestamp": "04:57:37", "text": "キノコは熱弁ばかりだけど、私は"}, {"type": "subtitle", "time": 17859.43, "timestamp": "04:57:39", "text": "彼女がヒュプノスの店に出入りするのを見た"}, {"type": "subtitle", "time": 17861.75, "timestamp": "04:57:41", "text": "家。彼女がただの私なのかどうかわからない"}, {"type": "subtitle", "time": 17863.99, "timestamp": "04:57:43", "text": "単刀直入に言おう。私はヘンリックを信用していない"}, {"type": "subtitle", "time": 17865.11, "timestamp": "04:57:45", "text": "エセルド。"}, {"type": "subtitle", "time": 17866.39, "timestamp": "04:57:46", "text": "何か怪しい。"}, {"type": "subtitle", "time": 17867.91, "timestamp": "04:57:47", "text": "クリスタルについて何か知っていますか？"}, {"type": "subtitle", "time": 17870.55, "timestamp": "04:57:50", "text": "ステラの？彼が狙っているもの。彼らは"}, {"type": "subtitle", "time": 17871.91, "timestamp": "04:57:51", "text": "美しい岩は"}, {"type": "subtitle", "time": 17873.67, "timestamp": "04:57:53", "text": "彼らの見た目。かつて深刻な"}, {"type": "subtitle", "time": 17875.59, "timestamp": "04:57:55", "text": "医療過誤の事例"}, {"type": "subtitle", "time": 17877.27, "timestamp": "04:57:57", "text": "フラッグソンのステラのクリスタロ"}]
[{"type": "subtitle", "time": 16201.67, "timestamp": "04:30:01", "text": "アルケミスト、あなたの地元はひどくて成長します"}, {"type": "subtitle", "time": 16204.149, "timestamp": "04:30:04", "text": "完全に自然のまま。"}, {"type": "subtitle", "time": 16207.59, "timestamp": "04:30:07", "text": "なるほど。それでは彼も連れて行こう。あなた"}, {"type": "subtitle", "time": 16219.349, "timestamp": "04:30:19", "text": "私はいつもこれを忘れてしまう。青くない"}, {"type": "subtitle", "time": 16221.99, "timestamp": "04:30:21", "text": "プロトコル。滑空する方法はありません"}, {"type": "chat", "time": 16237.565, "timestamp": "04:30:37", "author": "@miko_chann.1", "avatar": "https://yt4.ggpht.com/pA1qKxvA6gJkJo5iacL6MoaaocqRqPaKMbOHlznwOHpCJPPZbIU3_GNZ4faHtUzgYCNGbiZs1w=s64-c-k-c0x00ffffff-no-rj", "message": "hey joqnix i setup everything just i don't know what to add in width and height"}, {"type": "subtitle", "time": 16241.67, "timestamp": "04:30:41", "text": "追加すべき事項。幅と高さ。上がっています"}, {"type": "subtitle", "time": 16244.309, "timestamp": "04:30:44", "text": "あなたへ。"}, {"type": "subtitle", "time": 16247.429, "timestamp": "04:30:47", "text": "幅と高さ。それはあなた次第です。"}, {"type": "subtitle", "time": 16249.349, "timestamp": "04:30:49", "text": "先ほど見つけた粉末状の頭部は"}, {"type": "subtitle", "time": 16252.469, "timestamp": "04:30:52", "text": "大変助かりました。ええ、そうですね。"}, {"type": "subtitle", "time": 16254.71, "timestamp": "04:30:54", "text": "ええと、夜については、あなた次第です。"}, {"type": "subtitle", "time": 16258.229, "timestamp": "04:30:58", "text": "チャットボックスは、お好みに合わせてカスタマイズできます。"}]
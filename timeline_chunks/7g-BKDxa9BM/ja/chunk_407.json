[{"type": "subtitle", "time": 24420.788, "timestamp": "06:47:00", "text": "ごめんなさい。"}, {"type": "subtitle", "time": 24429.35, "timestamp": "06:47:09", "text": "どうしたの？何が起こったのか"}, {"type": "subtitle", "time": 24431.67, "timestamp": "06:47:11", "text": "プシュケ？"}, {"type": "subtitle", "time": 24440.468, "timestamp": "06:47:20", "text": "彼女には休息が必要だ。その"}, {"type": "subtitle", "time": 24443.03, "timestamp": "06:47:23", "text": "大したことではないけれど、彼女を放っておいてあげてください"}, {"type": "subtitle", "time": 24446.23, "timestamp": "06:47:26", "text": "今後数日間は一人で過ごす。"}, {"type": "subtitle", "time": 24448.548, "timestamp": "06:47:28", "text": "プシュケ、出かけたい？"}, {"type": "subtitle", "time": 24450.948, "timestamp": "06:47:30", "text": "一緒に歩きませんか？"}, {"type": "subtitle", "time": 24453.51, "timestamp": "06:47:33", "text": "外に出て新鮮な空気を吸いましょう。"}, {"type": "subtitle", "time": 24456.31, "timestamp": "06:47:36", "text": "怖がらないで、"}, {"type": "subtitle", "time": 24457.59, "timestamp": "06:47:37", "text": "お願いします。"}, {"type": "subtitle", "time": 24461.83, "timestamp": "06:47:41", "text": "私は嘆きの湖に行きたい。"}, {"type": "subtitle", "time": 24465.11, "timestamp": "06:47:45", "text": "もちろん、一緒に行きますよ。"}, {"type": "subtitle", "time": 24467.11, "timestamp": "06:47:47", "text": "ヘンリックさん、"}, {"type": "subtitle", "time": 24470.07, "timestamp": "06:47:50", "text": "散歩に出かけてもいいですか？"}, {"type": "subtitle", "time": 24473.91, "timestamp": "06:47:53", "text": "心配しないで、"}, {"type": "subtitle", "time": 24476.548, "timestamp": "06:47:56", "text": "どうぞ。でも私が言ったことを覚えておいてください"}, {"type": "subtitle", "time": 24479.43, "timestamp": "06:47:59", "text": "あなた。さもないと、"}]
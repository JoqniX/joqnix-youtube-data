[{"type": "subtitle", "time": 7453.83, "timestamp": "02:04:13", "text": "本当に休憩が必要だ"}, {"type": "subtitle", "time": 7455.83, "timestamp": "02:04:15", "text": "何か食べられるように。"}, {"type": "subtitle", "time": 7459.43, "timestamp": "02:04:19", "text": "ああ、ここは意外と広いですね"}, {"type": "subtitle", "time": 7462.709, "timestamp": "02:04:22", "text": "そして地上よりもずっと暖かい。"}, {"type": "subtitle", "time": 7466.31, "timestamp": "02:04:26", "text": "ああ、まるで秘密の小さな王国みたいだ。追跡"}, {"type": "subtitle", "time": 7468.47, "timestamp": "02:04:28", "text": "それらの生き物を追い払い、"}, {"type": "subtitle", "time": 7471.669, "timestamp": "02:04:31", "text": "匂い。そうすればテントを張って"}, {"type": "subtitle", "time": 7474.149, "timestamp": "02:04:34", "text": "実質的にここに住んでいる、"}, {"type": "subtitle", "time": 7484.39, "timestamp": "02:04:44", "text": "泥棒は前方にいる。"}, {"type": "subtitle", "time": 7487.83, "timestamp": "02:04:47", "text": "ああ、彼は汚物どもと戦っている。"}, {"type": "subtitle", "time": 7489.83, "timestamp": "02:04:49", "text": "汚物どもを追い払って"}]
[{"type": "subtitle", "time": 7081.51, "timestamp": "01:58:01", "text": "彼を昼寝させろ。"}, {"type": "subtitle", "time": 7083.03, "timestamp": "01:58:03", "text": "これは"}, {"type": "subtitle", "time": 7085.669, "timestamp": "01:58:05", "text": "治安当局が担当するのか？"}, {"type": "subtitle", "time": 7088.149, "timestamp": "01:58:08", "text": "まあ、保安局が"}, {"type": "subtitle", "time": 7090.31, "timestamp": "01:58:10", "text": "私たちを悩ませるキャロン、氷は"}, {"type": "subtitle", "time": 7093.91, "timestamp": "01:58:13", "text": "ラメンティン湖は溶けて消滅していただろう。"}, {"type": "subtitle", "time": 7097.03, "timestamp": "01:58:17", "text": "カミリラさん、どうか、最も親切で"}, {"type": "subtitle", "time": 7100.31, "timestamp": "01:58:20", "text": "アイスレイクで一番美しい女性。できた"}, {"type": "subtitle", "time": 7103.51, "timestamp": "01:58:23", "text": "キツネ狩りをする人たちに聞いてみてはどうでしょう"}, {"type": "subtitle", "time": 7106.149, "timestamp": "01:58:26", "text": "お手伝いするために来ましたか？ほんの小さな"}, {"type": "subtitle", "time": 7110.47, "timestamp": "01:58:30", "text": "好意。お願いです。"}, {"type": "subtitle", "time": 7113.27, "timestamp": "01:58:33", "text": "保存してください。何も知らないことを知っておくべきです"}, {"type": "subtitle", "time": 7117.109, "timestamp": "01:58:37", "text": "ここで求められたものは、代償なしに手に入る。"}, {"type": "subtitle", "time": 7121.83, "timestamp": "01:58:41", "text": "では、もしかしたら、"}, {"type": "subtitle", "time": 7124.229, "timestamp": "01:58:44", "text": "割引か何かご提案できます"}, {"type": "subtitle", "time": 7128.629, "timestamp": "01:58:48", "text": "それ以外？結局どうなったんだっけ？"}, {"type": "subtitle", "time": 7131.91, "timestamp": "01:58:51", "text": "ああ、情報は金と同じくらい価値がある、"}, {"type": "subtitle", "time": 7134.31, "timestamp": "01:58:54", "text": "右？私はすべてのゴミ箱を処理します"}, {"type": "subtitle", "time": 7138.31, "timestamp": "01:58:58", "text": "アイスレイクにて。では、これはどうでしょう？もし私が"}]
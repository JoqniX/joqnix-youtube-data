[{"type": "subtitle", "time": 22279.03, "timestamp": "06:11:19", "text": "えーっと、ちょっと音を立てて"}, {"type": "subtitle", "time": 22280.39, "timestamp": "06:11:20", "text": "それを微調整して、これらの小さな"}, {"type": "subtitle", "time": 22282.948, "timestamp": "06:11:22", "text": "生き物たちが私に向かってきた。"}, {"type": "subtitle", "time": 22287.19, "timestamp": "06:11:27", "text": "さあ、友よ。手伝ってください。"}, {"type": "subtitle", "time": 22315.75, "timestamp": "06:11:55", "text": "悪くない。例えば、大型の獣の場合"}, {"type": "subtitle", "time": 22318.23, "timestamp": "06:11:58", "text": "そして、汚物どもは速い。"}, {"type": "subtitle", "time": 22319.35, "timestamp": "06:11:59", "text": "主、"}]
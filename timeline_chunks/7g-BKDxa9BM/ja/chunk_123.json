[{"type": "subtitle", "time": 7404.229, "timestamp": "02:03:24", "text": "彼らはあなたが"}, {"type": "subtitle", "time": 7406.55, "timestamp": "02:03:26", "text": "ここまでずっと壁を登り続けろ。あなた"}, {"type": "subtitle", "time": 7407.669, "timestamp": "02:03:27", "text": "お金を分け合うと言っていた"}, {"type": "subtitle", "time": 7410.07, "timestamp": "02:03:30", "text": "とにかく貧しい人たちと一緒にいるのに、なぜ私は"}, {"type": "subtitle", "time": 7412.79, "timestamp": "02:03:32", "text": "その一部？"}, {"type": "subtitle", "time": 7415.91, "timestamp": "02:03:35", "text": "もしあなたが経済的に困っているなら、私が力になれますよ。しかし"}, {"type": "subtitle", "time": 7418.47, "timestamp": "02:03:38", "text": "人から金をむしり取ることはできない。"}, {"type": "subtitle", "time": 7419.83, "timestamp": "02:03:39", "text": "そんなことをしたら頭を殴られるぞ"}, {"type": "subtitle", "time": 7427.189, "timestamp": "02:03:47", "text": "[音楽]"}, {"type": "subtitle", "time": 7430.39, "timestamp": "02:03:50", "text": "彼はまた姿を消した。彼は一体何者なのか？ A"}, {"type": "subtitle", "time": 7431.669, "timestamp": "02:03:51", "text": "おばけ？"}]
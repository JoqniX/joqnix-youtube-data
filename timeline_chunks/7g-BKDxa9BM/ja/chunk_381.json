[{"type": "subtitle", "time": 22868.788, "timestamp": "06:21:08", "text": "わかった。何が起こったのかはわかりませんが、"}, {"type": "subtitle", "time": 22874.47, "timestamp": "06:21:14", "text": "プシュケ。"}, {"type": "subtitle", "time": 22882.788, "timestamp": "06:21:22", "text": "それは私があなたの目に映ると約束したということでしょうか？"}, {"type": "subtitle", "time": 22884.548, "timestamp": "06:21:24", "text": "物が見えにくいですか？"}, {"type": "subtitle", "time": 22885.59, "timestamp": "06:21:25", "text": "また？"}, {"type": "subtitle", "time": 22889.11, "timestamp": "06:21:29", "text": "うん、私のビジョンは少し、私は少し"}, {"type": "subtitle", "time": 22890.708, "timestamp": "06:21:30", "text": "疲れた。"}, {"type": "subtitle", "time": 22903.03, "timestamp": "06:21:43", "text": "はぁ？"}, {"type": "subtitle", "time": 22905.91, "timestamp": "06:21:45", "text": "私は独り言を歌っている。私に"}, {"type": "subtitle", "time": 22909.51, "timestamp": "06:21:49", "text": "好意？ここの鉢植えの植物は、"}]
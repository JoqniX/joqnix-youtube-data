[{"type": "subtitle", "time": 15363.59, "timestamp": "04:16:03", "text": "ポップアップチャット。チャットのURLをコピーしてください。"}, {"type": "subtitle", "time": 15366.95, "timestamp": "04:16:06", "text": "OBSに貼り付けてください。チャットボックスを作成する"}, {"type": "subtitle", "time": 15371.189, "timestamp": "04:16:11", "text": "私が送るリンク。 CSSをコピーしてください。"}, {"type": "subtitle", "time": 15373.83, "timestamp": "04:16:13", "text": "ブラウザのソースに貼り付けてください。"}, {"type": "subtitle", "time": 15376.95, "timestamp": "04:16:16", "text": "DMのどこかにURLリンクを保存してください"}, {"type": "subtitle", "time": 15379.269, "timestamp": "04:16:19", "text": "またはどこでも必要なく"}, {"type": "subtitle", "time": 15382.63, "timestamp": "04:16:22", "text": "チャットボックスの設定を継続的に変更する"}, {"type": "subtitle", "time": 15386.469, "timestamp": "04:16:26", "text": "などなど。そう、私はあなたに連絡して、あなたは"}, {"type": "subtitle", "time": 15389.75, "timestamp": "04:16:29", "text": "確認してみます。"}, {"type": "subtitle", "time": 15392.229, "timestamp": "04:16:32", "text": "はい、もし疑問があれば、"}, {"type": "subtitle", "time": 15394.309, "timestamp": "04:16:34", "text": "知る。覚えて"}, {"type": "subtitle", "time": 15396.79, "timestamp": "04:16:36", "text": "これは YouTube のみで、"}, {"type": "subtitle", "time": 15398.389, "timestamp": "04:16:38", "text": "Twitch"}, {"type": "chat", "time": 15399.611, "timestamp": "04:16:39", "author": "@miko_chann.1", "avatar": "https://yt4.ggpht.com/pA1qKxvA6gJkJo5iacL6MoaaocqRqPaKMbOHlznwOHpCJPPZbIU3_GNZ4faHtUzgYCNGbiZs1w=s64-c-k-c0x00ffffff-no-rj", "message": "ok wait a min..."}]
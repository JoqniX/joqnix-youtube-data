[{"type": "subtitle", "time": 8295.19, "timestamp": "02:18:15", "text": "ニース。"}, {"type": "subtitle", "time": 8297.509, "timestamp": "02:18:17", "text": "私は不忠実な者たちを罰する"}, {"type": "subtitle", "time": 8301.429, "timestamp": "02:18:21", "text": "愛の神の名において愛する。"}, {"type": "subtitle", "time": 8304.79, "timestamp": "02:18:24", "text": "昇格できません。"}, {"type": "subtitle", "time": 8313.509, "timestamp": "02:18:33", "text": "私はレベッカに焦点を当てます。それから集中します"}, {"type": "subtitle", "time": 8315.83, "timestamp": "02:18:35", "text": "他のキャラクターについても一人ずつ取り上げていく。ゆっくり、"}, {"type": "subtitle", "time": 8333.19, "timestamp": "02:18:53", "text": "デートに誘ってくれてるの？"}]
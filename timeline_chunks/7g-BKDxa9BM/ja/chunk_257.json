[{"type": "subtitle", "time": 15422.55, "timestamp": "04:17:02", "text": "待って、これって秘密の手紙みたいなものじゃないの？"}, {"type": "subtitle", "time": 15444.87, "timestamp": "04:17:24", "text": "彼女を閉じ込めることはできないような気がする。"}, {"type": "subtitle", "time": 15448.469, "timestamp": "04:17:28", "text": "こんにちは、私です、売店のトリュフです、"}, {"type": "subtitle", "time": 15451.51, "timestamp": "04:17:31", "text": "私の忠実な支持者たちが傍らにいてくれた。"}, {"type": "subtitle", "time": 15464.95, "timestamp": "04:17:44", "text": "彼女は水だ。わかった。"}, {"type": "subtitle", "time": 15467.67, "timestamp": "04:17:47", "text": "私には昇天するための材料がありません"}, {"type": "subtitle", "time": 15474.71, "timestamp": "04:17:54", "text": "彼女はまだ。移転と探査。"}]
[{"type": "subtitle", "time": 3841.43, "timestamp": "01:04:01", "text": "城門はすぐそこです。フォローする"}, {"type": "subtitle", "time": 3844.23, "timestamp": "01:04:04", "text": "私たちの後ろに。入れてあげます。"}, {"type": "subtitle", "time": 3846.95, "timestamp": "01:04:06", "text": "口を閉じろ。何かが起こったら"}, {"type": "subtitle", "time": 3853.27, "timestamp": "01:04:13", "text": "こんにちは。"}, {"type": "subtitle", "time": 3856.309, "timestamp": "01:04:16", "text": "もう小切手は要らない。覚えていない"}, {"type": "subtitle", "time": 3859.19, "timestamp": "01:04:19", "text": "カミラとスノーか。あなたの"}, {"type": "subtitle", "time": 3860.95, "timestamp": "01:04:20", "text": "目と脳がうまく機能していない"}, {"type": "subtitle", "time": 3862.95, "timestamp": "01:04:22", "text": "良い。"}, {"type": "subtitle", "time": 3868.15, "timestamp": "01:04:28", "text": "君じゃないよ、ルノ。私はオイと話していました。"}, {"type": "subtitle", "time": 3870.63, "timestamp": "01:04:30", "text": "なぜ私がそんなに急いで訪問するのか"}, {"type": "subtitle", "time": 3873.19, "timestamp": "01:04:33", "text": "お茶のための保安局？うん。"}, {"type": "subtitle", "time": 3876.069, "timestamp": "01:04:36", "text": "彼は、ああ、なんてことだ。イギリス人"}, {"type": "subtitle", "time": 3879.43, "timestamp": "01:04:39", "text": "ブーバでアジアに騙された。"}, {"type": "subtitle", "time": 3881.75, "timestamp": "01:04:41", "text": "だから、二人ともここに連れてきたんです。"}, {"type": "subtitle", "time": 3883.75, "timestamp": "01:04:43", "text": "ああ。"}, {"type": "subtitle", "time": 3885.349, "timestamp": "01:04:45", "text": "くそ。"}]
[{"type": "subtitle", "time": 14701.59, "timestamp": "04:05:01", "text": "ターゲットが泣いているのが聞こえると思う"}, {"type": "subtitle", "time": 14705.189, "timestamp": "04:05:05", "text": "ヘルプ。あそこの独房だよ。その"}, {"type": "subtitle", "time": 14708.389, "timestamp": "04:05:08", "text": "あそこの独房。急いで。"}, {"type": "subtitle", "time": 14723.429, "timestamp": "04:05:23", "text": "いいえ。"}, {"type": "subtitle", "time": 14726.07, "timestamp": "04:05:26", "text": "失敗は辛いものだ。"}, {"type": "subtitle", "time": 14730.15, "timestamp": "04:05:30", "text": "あなたからの慰めを少しだけ借りたい。"}, {"type": "subtitle", "time": 14731.51, "timestamp": "04:05:31", "text": "これは難しい。"}, {"type": "subtitle", "time": 14733.429, "timestamp": "04:05:33", "text": "私が先に始めます。"}, {"type": "subtitle", "time": 14734.95, "timestamp": "04:05:34", "text": "待てよ、これは実際難しいぞ。"}]
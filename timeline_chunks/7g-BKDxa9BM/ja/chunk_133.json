[{"type": "subtitle", "time": 7980.149, "timestamp": "02:13:00", "text": "キツネ狩りをする人はほとんどいなかったが、"}, {"type": "subtitle", "time": 7982.55, "timestamp": "02:13:02", "text": "そこでキツネの切れ端を見つけるが、"}, {"type": "subtitle", "time": 7984.31, "timestamp": "02:13:04", "text": "誰一人として戻ってこなかった。"}, {"type": "subtitle", "time": 7985.51, "timestamp": "02:13:05", "text": "キツネは成長する。"}, {"type": "subtitle", "time": 7987.75, "timestamp": "02:13:07", "text": "つまり、ヘンリックが5000をぶら下げていても"}, {"type": "subtitle", "time": 7990.39, "timestamp": "02:13:10", "text": "銀貨、キツネ狩りは"}, {"type": "subtitle", "time": 7992.229, "timestamp": "02:13:12", "text": "噛む。"}, {"type": "subtitle", "time": 7994.39, "timestamp": "02:13:14", "text": "キツネ狩りをする者は、生まれながらの冒険家だ。"}, {"type": "subtitle", "time": 7995.109, "timestamp": "02:13:15", "text": "買います"}, {"type": "subtitle", "time": 7997.91, "timestamp": "02:13:17", "text": "そして、無謀な愚か者ではない。石はとても"}, {"type": "subtitle", "time": 8000.709, "timestamp": "02:13:20", "text": "存在はさておき、ヘンリックが"}, {"type": "subtitle", "time": 8007.43, "timestamp": "02:13:27", "text": "彼が最近亡くなったことは誰もが知っている"}, {"type": "subtitle", "time": 8009.589, "timestamp": "02:13:29", "text": "破産し、"}, {"type": "subtitle", "time": 8012.55, "timestamp": "02:13:32", "text": "家族の家。彼はギャンブルをするつもりですか？"}, {"type": "subtitle", "time": 8015.189, "timestamp": "02:13:35", "text": "すべてトレードクリスタルに関するものですか？"}, {"type": "subtitle", "time": 8017.83, "timestamp": "02:13:37", "text": "ちょっと待って。クリスタルの取引は"}, {"type": "subtitle", "time": 8019.91, "timestamp": "02:13:39", "text": "長年禁止されていた。"}, {"type": "subtitle", "time": 8029.589, "timestamp": "02:13:49", "text": "カミラさん、何度言いましたか？"}, {"type": "subtitle", "time": 8029.99, "timestamp": "02:13:49", "text": "費用はどれくらいかかりますか？"}, {"type": "subtitle", "time": 8032.149, "timestamp": "02:13:52", "text": "ほぼ同じ価格です。"}, {"type": "subtitle", "time": 8033.43, "timestamp": "02:13:53", "text": "興味がある方は"}, {"type": "subtitle", "time": 8035.83, "timestamp": "02:13:55", "text": "あなた？マジですか？"}, {"type": "subtitle", "time": 8038.629, "timestamp": "02:13:58", "text": "ありがとう。あなたはかつて私にこう言った"}]
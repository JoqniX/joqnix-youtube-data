[{"type": "subtitle", "time": 17524.39, "timestamp": "04:52:04", "text": "アウトサイダー、"}, {"type": "subtitle", "time": 17527.51, "timestamp": "04:52:07", "text": "今日は帰宅がとても遅いですね。どこに"}, {"type": "subtitle", "time": 17561.11, "timestamp": "04:52:41", "text": "雪が積もった深い森の中だったのだろうか"}, {"type": "subtitle", "time": 17563.03, "timestamp": "04:52:43", "text": "オオカミは茶色？または"}, {"type": "subtitle", "time": 17565.51, "timestamp": "04:52:45", "text": "私はどこにも行かなかった。今日はミス"}, {"type": "subtitle", "time": 17567.27, "timestamp": "04:52:47", "text": "フィナの誕生日だったので、アイスに滞在しました。"}, {"type": "subtitle", "time": 17568.15, "timestamp": "04:52:48", "text": "湖。"}, {"type": "subtitle", "time": 17568.868, "timestamp": "04:52:48", "text": "氷の湖？"}, {"type": "subtitle", "time": 17572.23, "timestamp": "04:52:52", "text": "あなたはいつもそう言いますね。しかし新たな傷跡が"}, {"type": "subtitle", "time": 17575.51, "timestamp": "04:52:55", "text": "あなたの腕に現れます。"}, {"type": "subtitle", "time": 17577.03, "timestamp": "04:52:57", "text": "なんてこった。彼女は大丈夫ですか？"}, {"type": "subtitle", "time": 17579.43, "timestamp": "04:52:59", "text": "しかし今回は本当だ。"}]
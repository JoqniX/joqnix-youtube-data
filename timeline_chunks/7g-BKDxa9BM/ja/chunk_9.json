[{"type": "subtitle", "time": 541.67, "timestamp": "00:09:01", "text": "あなたが目を覚ましたら、すぐここにいます。"}, {"type": "subtitle", "time": 544.15, "timestamp": "00:09:04", "text": "大丈夫。私たちは降りるべきです"}, {"type": "subtitle", "time": 546.63, "timestamp": "00:09:06", "text": "山を登り、村へ向かう。"}, {"type": "subtitle", "time": 548.47, "timestamp": "00:09:08", "text": "戻りたいの？これまで"}, {"type": "subtitle", "time": 550.389, "timestamp": "00:09:10", "text": "何日もの間、そこから轟音が聞こえてきた。"}, {"type": "subtitle", "time": 552.71, "timestamp": "00:09:12", "text": "家に帰れるかどうか考えていた"}, {"type": "subtitle", "time": 555.99, "timestamp": "00:09:15", "text": "そして武器をつかみ、"}, {"type": "subtitle", "time": 558.87, "timestamp": "00:09:18", "text": "強さがあれば、きっと抜け出す道が見つかる。いいえ"}, {"type": "subtitle", "time": 560.71, "timestamp": "00:09:20", "text": "どんなに困難でも誰かが私たちを救ってくれるだろう"}, {"type": "subtitle", "time": 563.269, "timestamp": "00:09:23", "text": "私たちがここに滞在する期間。ともかく、"}, {"type": "subtitle", "time": 591.269, "timestamp": "00:09:51", "text": "洞窟から出ろ。"}, {"type": "subtitle", "time": 593.03, "timestamp": "00:09:53", "text": "まるでシングルをプレイしているような気分だ"}, {"type": "subtitle", "time": 595.35, "timestamp": "00:09:55", "text": "プレイヤーゲーム、"}]
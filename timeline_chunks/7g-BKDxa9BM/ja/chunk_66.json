[{"type": "subtitle", "time": 3960.95, "timestamp": "01:06:00", "text": "全国的に指名手配されている。それで、署長は"}, {"type": "subtitle", "time": 3962.549, "timestamp": "01:06:02", "text": "特に厳重なセキュリティを要求した"}, {"type": "subtitle", "time": 3970.789, "timestamp": "01:06:10", "text": "ping を確認できればいいのに、"}, {"type": "subtitle", "time": 3971.43, "timestamp": "01:06:11", "text": "男。"}, {"type": "subtitle", "time": 3976.069, "timestamp": "01:06:16", "text": "見捨てられた者たちよ、言っておくが。私"}, {"type": "subtitle", "time": 3979.27, "timestamp": "01:06:19", "text": "私の名誉にかけて、彼女は"}, {"type": "subtitle", "time": 3982.789, "timestamp": "01:06:22", "text": "フォアセイクンズとは何の関係もありません。"}, {"type": "subtitle", "time": 3985.99, "timestamp": "01:06:25", "text": "わかりました、カミラさん、あなたを信じます。しかし"}, {"type": "subtitle", "time": 3988.47, "timestamp": "01:06:28", "text": "覚えておいて、この子から目を離さないで。"}, {"type": "subtitle", "time": 3991.349, "timestamp": "01:06:31", "text": "そして、彼女にトラブルを起こさせないように"}, {"type": "subtitle", "time": 3994.789, "timestamp": "01:06:34", "text": "町。署長がこれを知ったら、"}, {"type": "subtitle", "time": 3997.67, "timestamp": "01:06:37", "text": "私たち二人とも大変なことになるでしょう。"}, {"type": "subtitle", "time": 3998.069, "timestamp": "01:06:38", "text": "おお、"}, {"type": "subtitle", "time": 4000.71, "timestamp": "01:06:40", "text": "ありがとう。次回は"}, {"type": "subtitle", "time": 4014.47, "timestamp": "01:06:54", "text": "ピンが見えればいいのに。"}, {"type": "subtitle", "time": 4016.71, "timestamp": "01:06:56", "text": "通常、これらのゲームでは、"}]
[{"type": "subtitle", "time": 6188.95, "timestamp": "01:43:08", "text": "バカ。わかった。"}, {"type": "subtitle", "time": 6191.43, "timestamp": "01:43:11", "text": "ほら、懐疑心が書いてあるのが見えるよ"}, {"type": "subtitle", "time": 6193.17, "timestamp": "01:43:13", "text": "あなたの顔。"}, {"type": "subtitle", "time": 6195.59, "timestamp": "01:43:15", "text": "[音楽]"}, {"type": "subtitle", "time": 6198.47, "timestamp": "01:43:18", "text": "私を信じてください。あなたは知っておく必要があります"}, {"type": "subtitle", "time": 6200.709, "timestamp": "01:43:20", "text": "「ルノスは決して害を及ぼさない」と言っている。"}, {"type": "subtitle", "time": 6201.99, "timestamp": "01:43:21", "text": "そんな話は聞いたことがない。"}, {"type": "subtitle", "time": 6203.35, "timestamp": "01:43:23", "text": "ラシアはそれを知っている。"}, {"type": "subtitle", "time": 6206.39, "timestamp": "01:43:26", "text": "いいえ。私は初心者です。私は新参者です。"}, {"type": "subtitle", "time": 6209.109, "timestamp": "01:43:29", "text": "その通り。"}, {"type": "subtitle", "time": 6216.87, "timestamp": "01:43:36", "text": "ええ、おっしゃる通りです。戻りましょう"}, {"type": "subtitle", "time": 6218.07, "timestamp": "01:43:38", "text": "では、一緒に。"}, {"type": "subtitle", "time": 6224.629, "timestamp": "01:43:44", "text": "わかった。ということで、新しい武器をアンロックしました。"}, {"type": "subtitle", "time": 6231.669, "timestamp": "01:43:51", "text": "炎を燃やす、プーラン・ペリション武器ホルダー"}, {"type": "subtitle", "time": 6234.87, "timestamp": "01:43:54", "text": "ボルトフレームバレル。ああ、あなたは"}, {"type": "subtitle", "time": 6237.91, "timestamp": "01:43:57", "text": "これらの個々のアイテムをすべてロック解除して"}]
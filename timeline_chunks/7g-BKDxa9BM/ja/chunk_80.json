[{"type": "subtitle", "time": 4801.11, "timestamp": "01:20:01", "text": "今日はこれで終わりにしましょう。外出していました。それで、"}, {"type": "subtitle", "time": 4802.95, "timestamp": "01:20:02", "text": "生き残ろうとするが、"}, {"type": "subtitle", "time": 4805.189, "timestamp": "01:20:05", "text": "たとえそれさえもしたら、二度と"}, {"type": "subtitle", "time": 4807.51, "timestamp": "01:20:07", "text": "対決に関する狂った話に言及する"}, {"type": "subtitle", "time": 4810.47, "timestamp": "01:20:10", "text": "Cibilに連絡して、荷物を取り戻しましょう。"}, {"type": "subtitle", "time": 4811.83, "timestamp": "01:20:11", "text": "見て、"}, {"type": "subtitle", "time": 4813.43, "timestamp": "01:20:13", "text": "北の方に宿屋がある"}, {"type": "subtitle", "time": 4815.91, "timestamp": "01:20:15", "text": "誰かを受け入れてくれるかもしれないヒュプノス・ハウス"}, {"type": "subtitle", "time": 4819.43, "timestamp": "01:20:19", "text": "君みたいに、曖昧な過去を持つ人。"}, {"type": "subtitle", "time": 4822.31, "timestamp": "01:20:22", "text": "あの不気味な幽霊屋敷のことですか？"}, {"type": "subtitle", "time": 4823.51, "timestamp": "01:20:23", "text": "お化け屋敷？"}, {"type": "subtitle", "time": 4825.51, "timestamp": "01:20:25", "text": "他にどこで、キャロンを乗せずに"}, {"type": "subtitle", "time": 4827.99, "timestamp": "01:20:27", "text": "旅行許可証？しかし、とても"}, {"type": "subtitle", "time": 4830.39, "timestamp": "01:20:30", "text": "兵士たちでさえも気味が悪かった"}, {"type": "subtitle", "time": 4831.59, "timestamp": "01:20:31", "text": "検索。"}, {"type": "subtitle", "time": 4833.03, "timestamp": "01:20:33", "text": "わかりました。"}, {"type": "subtitle", "time": 4835.03, "timestamp": "01:20:35", "text": "えっと、"}, {"type": "subtitle", "time": 4837.27, "timestamp": "01:20:37", "text": "よし。君がこんなに孤独で"}, {"type": "subtitle", "time": 4856.55, "timestamp": "01:20:56", "text": "わかった。エントリーを見る。"}, {"type": "subtitle", "time": 4859.51, "timestamp": "01:20:59", "text": "「幽霊が出る」とは具体的にどういう意味ですか？"}]
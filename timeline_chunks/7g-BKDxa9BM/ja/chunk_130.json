[{"type": "subtitle", "time": 7804.47, "timestamp": "02:10:04", "text": "つまり、コミッションとは、"}, {"type": "subtitle", "time": 7807.589, "timestamp": "02:10:07", "text": "農業を続けることができる。"}, {"type": "subtitle", "time": 7811.03, "timestamp": "02:10:11", "text": "キャラクターの経験値が必要なら、これを周回すればいい。"}, {"type": "subtitle", "time": 7813.669, "timestamp": "02:10:13", "text": "武器の経験値が必要なら、これを周回すればいい。"}, {"type": "subtitle", "time": 7815.35, "timestamp": "02:10:15", "text": "キャラクター昇格マターが必要です、"}, {"type": "subtitle", "time": 7818.31, "timestamp": "02:10:18", "text": "これを耕作する。"}, {"type": "subtitle", "time": 7820.709, "timestamp": "02:10:20", "text": "武器の強化マスター、これを周回するんだ。"}, {"type": "subtitle", "time": 7824.72, "timestamp": "02:10:24", "text": "デーモン使いの皆さん、これを収穫してください。"}, {"type": "subtitle", "time": 7832.39, "timestamp": "02:10:32", "text": "[音楽]"}, {"type": "subtitle", "time": 7835.51, "timestamp": "02:10:35", "text": "来て。"}, {"type": "subtitle", "time": 7843.71, "timestamp": "02:10:43", "text": "20％の手数料をいただきます。あなたは80％を受け取ります。"}, {"type": "subtitle", "time": 7849.109, "timestamp": "02:10:49", "text": "[音楽]"}, {"type": "subtitle", "time": 7852.02, "timestamp": "02:10:52", "text": "神秘的な魔術師。"}]
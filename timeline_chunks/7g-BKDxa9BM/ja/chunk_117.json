[{"type": "subtitle", "time": 7056.55, "timestamp": "01:57:36", "text": "そして突然、彼は私を待ち伏せした"}, {"type": "subtitle", "time": 7059.189, "timestamp": "01:57:39", "text": "そして、私が手に入れたばかりの現金を盗んだ。"}, {"type": "subtitle", "time": 7061.35, "timestamp": "01:57:41", "text": "ああ、あのローターは私たちにも容赦しない"}, {"type": "subtitle", "time": 7062.79, "timestamp": "01:57:42", "text": "腐肉食動物。"}, {"type": "subtitle", "time": 7064.95, "timestamp": "01:57:44", "text": "そのお金は複数の家族のためのものだった。"}, {"type": "subtitle", "time": 7067.43, "timestamp": "01:57:47", "text": "スラム街の維持管理。"}, {"type": "subtitle", "time": 7069.83, "timestamp": "01:57:49", "text": "そのコインの袋がなければ、若い"}, {"type": "subtitle", "time": 7071.669, "timestamp": "01:57:51", "text": "そして高齢者は倹約を強いられるだろう"}, {"type": "subtitle", "time": 7075.03, "timestamp": "01:57:55", "text": "来月はさらに増えるだろう。"}, {"type": "subtitle", "time": 7077.51, "timestamp": "01:57:57", "text": "私は持っていません"}, {"type": "subtitle", "time": 7079.35, "timestamp": "01:57:59", "text": "逃げ出す。誰かに手伝ってもらいたい"}]
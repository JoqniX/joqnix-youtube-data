[{"type": "subtitle", "time": 22924.78, "timestamp": "06:22:04", "text": "予想通りだった。"}, {"type": "subtitle", "time": 22926.628, "timestamp": "06:22:06", "text": "[音楽]"}, {"type": "subtitle", "time": 22936.788, "timestamp": "06:22:16", "text": "花は鮮やかな黄色です。"}, {"type": "subtitle", "time": 22939.03, "timestamp": "06:22:19", "text": "私は黄色い花が好きです。"}, {"type": "subtitle", "time": 22942.31, "timestamp": "06:22:22", "text": "鮮やかな黄色。それは白です。そして私の"}, {"type": "subtitle", "time": 22950.548, "timestamp": "06:22:30", "text": "花びらの縁は滑らかではない。"}, {"type": "subtitle", "time": 22952.948, "timestamp": "06:22:32", "text": "その代わりに、不規則なものがたくさんある"}, {"type": "subtitle", "time": 22955.43, "timestamp": "06:22:35", "text": "ギャップ。右。"}, {"type": "subtitle", "time": 22957.67, "timestamp": "06:22:37", "text": "花びらにそっと触れてみてください。"}, {"type": "subtitle", "time": 22960.49, "timestamp": "06:22:40", "text": "これらの花びらは"}, {"type": "subtitle", "time": 22962.708, "timestamp": "06:22:42", "text": "[音楽]"}, {"type": "subtitle", "time": 22965.19, "timestamp": "06:22:45", "text": "柔らかい縞模様が放射状に広がっている"}, {"type": "subtitle", "time": 22968.07, "timestamp": "06:22:48", "text": "中心から外側に向かって、やや似ている"}, {"type": "subtitle", "time": 22971.99, "timestamp": "06:22:51", "text": "葉脈。しかし、彼らは"}, {"type": "subtitle", "time": 22979.43, "timestamp": "06:22:59", "text": "縞模様は栄養素を運び、"}]
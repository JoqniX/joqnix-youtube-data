[{"type": "subtitle", "time": 21122.948, "timestamp": "05:52:02", "text": "私が片付けてあげます。何てことだ。わかった、"}, {"type": "subtitle", "time": 21124.868, "timestamp": "05:52:04", "text": "私はそういう性格を持っている。私は少なくとも"}, {"type": "subtitle", "time": 21128.07, "timestamp": "05:52:08", "text": "彼女に切り替えてください。これは本当に美味しい。"}, {"type": "subtitle", "time": 21130.628, "timestamp": "05:52:10", "text": "これはとても良いです、"}, {"type": "subtitle", "time": 21149.27, "timestamp": "05:52:29", "text": "飛行しない。"}, {"type": "subtitle", "time": 21161.03, "timestamp": "05:52:41", "text": "かわいそうな子豚ちゃん。"}]
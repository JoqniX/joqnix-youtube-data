[{"type": "subtitle", "time": 7200.229, "timestamp": "02:00:00", "text": "あなたの過去や背景についてですが、"}, {"type": "subtitle", "time": 7212.629, "timestamp": "02:00:12", "text": "知恵、"}, {"type": "subtitle", "time": 7214.55, "timestamp": "02:00:14", "text": "でも、君は強そうには見えないね。あなたの"}, {"type": "subtitle", "time": 7217.109, "timestamp": "02:00:17", "text": "勇気は称賛に値する。"}, {"type": "subtitle", "time": 7219.189, "timestamp": "02:00:19", "text": "あなたは確かに平均よりも強い"}, {"type": "subtitle", "time": 7221.75, "timestamp": "02:00:21", "text": "カロン。君が喧嘩しているのを見たことがあるけど、"}, {"type": "subtitle", "time": 7223.589, "timestamp": "02:00:23", "text": "力任せでは資格を満たせない"}, {"type": "subtitle", "time": 7226.07, "timestamp": "02:00:26", "text": "あなたはキツネ狩りをする人になるべきだ。必要がある"}, {"type": "subtitle", "time": 7227.669, "timestamp": "02:00:27", "text": "対処できることを証明してください"}, {"type": "subtitle", "time": 7230.229, "timestamp": "02:00:30", "text": "あらゆる不測の事態と"}, {"type": "subtitle", "time": 7233.43, "timestamp": "02:00:33", "text": "非常に多様な顧客層。"}, {"type": "subtitle", "time": 7236.95, "timestamp": "02:00:36", "text": "たまたまチャンスがあって、ああ、"}, {"type": "subtitle", "time": 7247.75, "timestamp": "02:00:47", "text": "本当に助かります。"}, {"type": "subtitle", "time": 7250.47, "timestamp": "02:00:50", "text": "こんにちは、マージー。マーギー、"}]
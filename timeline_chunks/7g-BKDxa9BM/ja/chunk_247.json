[{"type": "subtitle", "time": 14830.309, "timestamp": "04:07:10", "text": "これらの部屋はすべて全く同じように見える"}, {"type": "subtitle", "time": 14833.189, "timestamp": "04:07:13", "text": "自分。幸いなことに、私の小さな手下は"}, {"type": "subtitle", "time": 14835.269, "timestamp": "04:07:15", "text": "適切なものを見つけるための十分な創意工夫"}, {"type": "subtitle", "time": 14838.389, "timestamp": "04:07:18", "text": "1つ。さあ、早くターゲットを見つけよう。これ"}, {"type": "subtitle", "time": 14875.429, "timestamp": "04:07:55", "text": "ああ、あの巡回員が"}, {"type": "subtitle", "time": 14877.269, "timestamp": "04:07:57", "text": "アラーム。"}, {"type": "subtitle", "time": 14879.51, "timestamp": "04:07:59", "text": "こうなることは分かっていた。これら"}]
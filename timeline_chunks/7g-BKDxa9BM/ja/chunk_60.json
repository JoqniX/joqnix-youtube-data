[{"type": "subtitle", "time": 3605.67, "timestamp": "01:00:05", "text": "ラメ。"}, {"type": "subtitle", "time": 3608.789, "timestamp": "01:00:08", "text": "ああ、これがあなたの功績なんですね？私"}, {"type": "subtitle", "time": 3611.75, "timestamp": "01:00:11", "text": "物語を考えてみよう。そうそう。ストーリーと"}, {"type": "subtitle", "time": 3613.51, "timestamp": "01:00:13", "text": "すべて。"}, {"type": "subtitle", "time": 3635.349, "timestamp": "01:00:35", "text": "そうそう。肌。 20回の描画でスキンのみ。"}, {"type": "subtitle", "time": 3641.829, "timestamp": "01:00:41", "text": "ああ、これはとても綺麗だ。"}, {"type": "subtitle", "time": 3644.23, "timestamp": "01:00:44", "text": "もしかしたら、彼女を応援するかもしれない。私はしません"}, {"type": "subtitle", "time": 3645.75, "timestamp": "01:00:45", "text": "知る。"}, {"type": "subtitle", "time": 3648.63, "timestamp": "01:00:48", "text": "皮膚を引っ張る。忘れた。必要ありません"}]
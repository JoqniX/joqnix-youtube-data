[{"type": "subtitle", "time": 18542.23, "timestamp": "05:09:02", "text": "有益な情報をいくつか入手できた。"}, {"type": "subtitle", "time": 18550.07, "timestamp": "05:09:10", "text": "まあ。"}, {"type": "subtitle", "time": 18551.83, "timestamp": "05:09:11", "text": "捜査はどのように進みましたか？できなかった"}, {"type": "subtitle", "time": 18554.47, "timestamp": "05:09:14", "text": "彼の話の真相を突き止める。でも私は"}, {"type": "subtitle", "time": 18556.23, "timestamp": "05:09:16", "text": "作った"}, {"type": "subtitle", "time": 18558.868, "timestamp": "05:09:18", "text": "つまり、ここは実は療養所なんです。"}, {"type": "subtitle", "time": 18560.39, "timestamp": "05:09:20", "text": "それについて隠すことなんてあるだろうか？"}, {"type": "subtitle", "time": 18561.59, "timestamp": "05:09:21", "text": "右。"}, {"type": "subtitle", "time": 18562.788, "timestamp": "05:09:22", "text": "私はまた、"}, {"type": "subtitle", "time": 18564.15, "timestamp": "05:09:24", "text": "ハントは以前はとても健康だった"}, {"type": "subtitle", "time": 18566.628, "timestamp": "05:09:26", "text": "消えた。"}, {"type": "subtitle", "time": 18567.35, "timestamp": "05:09:27", "text": "彼らは拒否した。"}, {"type": "subtitle", "time": 18570.55, "timestamp": "05:09:30", "text": "ヘンリックは病人を標的にしているのか？"}, {"type": "subtitle", "time": 18571.99, "timestamp": "05:09:31", "text": "あれがヘンリックのオフィスです。"}, {"type": "subtitle", "time": 18573.27, "timestamp": "05:09:33", "text": "賢明な判断だ。"}, {"type": "subtitle", "time": 18577.27, "timestamp": "05:09:37", "text": "しかし、鍵のかかったドアだけが"}, {"type": "subtitle", "time": 18579.51, "timestamp": "05:09:39", "text": "私はそこのロッジの人たちと話し、掘り下げました"}, {"type": "subtitle", "time": 18581.59, "timestamp": "05:09:41", "text": "情報を入手した。ヘンリック。"}, {"type": "subtitle", "time": 18584.708, "timestamp": "05:09:44", "text": "素晴らしい。それでは、これが私たちの計画です。あなたはとても"}, {"type": "subtitle", "time": 18585.83, "timestamp": "05:09:45", "text": "シャープ。"}, {"type": "subtitle", "time": 18587.35, "timestamp": "05:09:47", "text": "私は特にそうではありませんでした。"}, {"type": "subtitle", "time": 18590.39, "timestamp": "05:09:50", "text": "よし。今後数日間で。"}, {"type": "subtitle", "time": 18591.59, "timestamp": "05:09:51", "text": "そしてねえ、"}, {"type": "subtitle", "time": 18594.47, "timestamp": "05:09:54", "text": "まだ始まったばかりだ。もしかしたら私は"}, {"type": "subtitle", "time": 18597.03, "timestamp": "05:09:57", "text": "さあ。プシュケは少し"}]
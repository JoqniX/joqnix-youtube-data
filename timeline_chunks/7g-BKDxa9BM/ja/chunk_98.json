[{"type": "subtitle", "time": 5882.229, "timestamp": "01:38:02", "text": "もし彼女が逃げ出すことができたなら、きっと"}, {"type": "subtitle", "time": 5886.87, "timestamp": "01:38:06", "text": "私を見つけるためにあらゆる手段を尽くしてください。もちろん、私は"}, {"type": "subtitle", "time": 5888.95, "timestamp": "01:38:08", "text": "最悪のシナリオは排除できない"}, {"type": "subtitle", "time": 5893.83, "timestamp": "01:38:13", "text": "シビルが彼女を軍団に連れて行ったのだ。"}, {"type": "subtitle", "time": 5897.189, "timestamp": "01:38:17", "text": "良い面としては、"}, {"type": "subtitle", "time": 5901.109, "timestamp": "01:38:21", "text": "シビルは何らかの理由でバリーを必要としていたので、"}, {"type": "subtitle", "time": 5904.709, "timestamp": "01:38:24", "text": "彼女はおそらく彼女に危害を加えないだろう。"}, {"type": "subtitle", "time": 5908.229, "timestamp": "01:38:28", "text": "とにかく、いくつか集めなければならない"}, {"type": "subtitle", "time": 5911.91, "timestamp": "01:38:31", "text": "アイスレイクでお金を手に入れ、旅行許可証を取得し、"}, {"type": "subtitle", "time": 5915.109, "timestamp": "01:38:35", "text": "そして、次の行動を計画する。"}, {"type": "subtitle", "time": 5916.55, "timestamp": "01:38:36", "text": "旅行許可証。わかった。"}, {"type": "subtitle", "time": 5918.47, "timestamp": "01:38:38", "text": "戻る。"}, {"type": "subtitle", "time": 5920.79, "timestamp": "01:38:40", "text": "お腹が空いているに違いない。いくつかご紹介します"}, {"type": "subtitle", "time": 5923.669, "timestamp": "01:38:43", "text": "焼きたてのパン。"}, {"type": "subtitle", "time": 5925.99, "timestamp": "01:38:45", "text": "バリー。"}, {"type": "subtitle", "time": 5930.629, "timestamp": "01:38:50", "text": "大丈夫ですか？"}, {"type": "subtitle", "time": 5933.35, "timestamp": "01:38:53", "text": "ああ、それはまるで"}, {"type": "subtitle", "time": 5936.47, "timestamp": "01:38:56", "text": "えっと、それならパンを食べた方がいいよ"}, {"type": "subtitle", "time": 5938.79, "timestamp": "01:38:58", "text": "そして温かい牛乳で流し込む。"}, {"type": "subtitle", "time": 5939.91, "timestamp": "01:38:59", "text": "温かい牛乳？"}]
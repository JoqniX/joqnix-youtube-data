[{"type": "subtitle", "time": 22321.83, "timestamp": "06:12:01", "text": "よし。"}, {"type": "subtitle", "time": 22322.868, "timestamp": "06:12:02", "text": "これは何ですか？"}, {"type": "subtitle", "time": 22324.628, "timestamp": "06:12:04", "text": "私が拾ったスクラップ金属片"}, {"type": "subtitle", "time": 22327.99, "timestamp": "06:12:07", "text": "ゴミ拾いをする少女。"}, {"type": "subtitle", "time": 22334.868, "timestamp": "06:12:14", "text": "追放効果。ああ、いいね、いいね、いいね、"}, {"type": "subtitle", "time": 22337.67, "timestamp": "06:12:17", "text": "いいね、いいね。そして、我々は彼を捕まえた。おお、いいね、"}, {"type": "subtitle", "time": 22349.51, "timestamp": "06:12:29", "text": "それが彼の武器だ。おお、"}, {"type": "subtitle", "time": 22352.15, "timestamp": "06:12:32", "text": "デートに誘ってくれてるの？"}, {"type": "subtitle", "time": 22355.03, "timestamp": "06:12:35", "text": "これはかなり"}, {"type": "subtitle", "time": 22357.43, "timestamp": "06:12:37", "text": "私たちは既にお互いをよく知っています。"}, {"type": "subtitle", "time": 22360.39, "timestamp": "06:12:40", "text": "自己紹介をしなければなりませんね。"}, {"type": "subtitle", "time": 22364.23, "timestamp": "06:12:44", "text": "よそ者、見知らぬ人。"}, {"type": "subtitle", "time": 22366.708, "timestamp": "06:12:46", "text": "くそ。"}, {"type": "subtitle", "time": 22371.11, "timestamp": "06:12:51", "text": "私にできるささやかな援助をさせていただきます。"}]
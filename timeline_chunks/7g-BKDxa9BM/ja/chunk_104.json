[{"type": "subtitle", "time": 6241.03, "timestamp": "01:44:01", "text": "銃を作る。聖なる、"}, {"type": "subtitle", "time": 6244.709, "timestamp": "01:44:04", "text": "農業の量、兄弟、"}, {"type": "subtitle", "time": 6247.27, "timestamp": "01:44:07", "text": "好きな武器、好きなキャラクター"}, {"type": "subtitle", "time": 6265.99, "timestamp": "01:44:25", "text": "それはすごくクールですね。"}, {"type": "subtitle", "time": 6269.99, "timestamp": "01:44:29", "text": "わあ、もう基地を作ったんですね。では、誰が"}, {"type": "subtitle", "time": 6273.03, "timestamp": "01:44:33", "text": "ここに来る予定ですか？私は疑問に思う。そして誰が"}, {"type": "subtitle", "time": 6284.629, "timestamp": "01:44:44", "text": "[音楽]"}, {"type": "subtitle", "time": 6288.31, "timestamp": "01:44:48", "text": "あなたは火を燃やしている。"}, {"type": "subtitle", "time": 6290.149, "timestamp": "01:44:50", "text": "これは鍛造作業台です。材料"}, {"type": "subtitle", "time": 6291.83, "timestamp": "01:44:51", "text": "私たちが収集するものはさまざまな形に加工できます"}, {"type": "subtitle", "time": 6295.189, "timestamp": "01:44:55", "text": "食料調達の計画を立てるんだ、坊や。"}, {"type": "subtitle", "time": 6299.189, "timestamp": "01:44:59", "text": "私のハンマーは、その力を解き放ちたくてうずうずしている。"}]
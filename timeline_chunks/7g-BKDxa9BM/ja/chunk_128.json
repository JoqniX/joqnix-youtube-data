[{"type": "subtitle", "time": 7684.069, "timestamp": "02:08:04", "text": "誓って言うけど、支配権がある"}, {"type": "subtitle", "time": 7686.149, "timestamp": "02:08:06", "text": "こちらです。キツネの依頼はすべて"}, {"type": "subtitle", "time": 7695.03, "timestamp": "02:08:15", "text": "手数料。いいえ。キツネに手を貸す"}, {"type": "subtitle", "time": 7697.35, "timestamp": "02:08:17", "text": "再びハンターたち。今度は何だ？"}, {"type": "subtitle", "time": 7698.31, "timestamp": "02:08:18", "text": "ナブス。"}, {"type": "subtitle", "time": 7700.629, "timestamp": "02:08:20", "text": "何てことだ。彼の目に何が起こったのですか？"}, {"type": "subtitle", "time": 7701.91, "timestamp": "02:08:21", "text": "卑劣な企み。"}, {"type": "subtitle", "time": 7703.669, "timestamp": "02:08:23", "text": "この低画素の目は何？"}, {"type": "subtitle", "time": 7705.189, "timestamp": "02:08:25", "text": "目立たないようにしているんです。"}, {"type": "subtitle", "time": 7706.39, "timestamp": "02:08:26", "text": "たった一つだけ。"}, {"type": "subtitle", "time": 7708.229, "timestamp": "02:08:28", "text": "よし、これで良くなった。"}, {"type": "subtitle", "time": 7713.189, "timestamp": "02:08:33", "text": "私は嘘をついたことがない。こんにちは、ウェルズさん。"}, {"type": "subtitle", "time": 7715.669, "timestamp": "02:08:35", "text": "つまり、あなたがずっと探していたということですか？"}, {"type": "subtitle", "time": 7716.95, "timestamp": "02:08:36", "text": "ありがとう。"}, {"type": "subtitle", "time": 7720.47, "timestamp": "02:08:40", "text": "些細なこと。言っておきますが、それはすべて"}, {"type": "subtitle", "time": 7721.03, "timestamp": "02:08:41", "text": "これら。"}, {"type": "subtitle", "time": 7724.55, "timestamp": "02:08:44", "text": "NPCの口はどうなったの？"}, {"type": "subtitle", "time": 7725.589, "timestamp": "02:08:45", "text": "壊れています。"}, {"type": "subtitle", "time": 7725.99, "timestamp": "02:08:45", "text": "大きい。"}, {"type": "subtitle", "time": 7728.55, "timestamp": "02:08:48", "text": "それならもっと頑張らなきゃ。から学ぶ"}, {"type": "subtitle", "time": 7729.589, "timestamp": "02:08:49", "text": "プロフェッショナルな"}, {"type": "subtitle", "time": 7733.35, "timestamp": "02:08:53", "text": "私から学びなさい。もう勘弁してくれよ。取る"}, {"type": "subtitle", "time": 7735.83, "timestamp": "02:08:55", "text": "じっくり考えて、なぜ"}, {"type": "subtitle", "time": 7738.39, "timestamp": "02:08:58", "text": "結局、この道にたどり着いた。これはあなたが"}, {"type": "subtitle", "time": 7739.43, "timestamp": "02:08:59", "text": "そうすべきだ。"}]
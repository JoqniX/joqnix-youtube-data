[{"type": "subtitle", "time": 17941.83, "timestamp": "04:59:01", "text": "大切な人には会いたくない"}, {"type": "subtitle", "time": 17942.39, "timestamp": "04:59:02", "text": "住んでいる。"}, {"type": "subtitle", "time": 17944.948, "timestamp": "04:59:04", "text": "その場合、私は誰かのことを心配しています"}, {"type": "subtitle", "time": 17946.708, "timestamp": "04:59:06", "text": "あまりにも。"}, {"type": "subtitle", "time": 17948.31, "timestamp": "04:59:08", "text": "何かが起こって物事がうまくいかなくなったら"}, {"type": "subtitle", "time": 17949.91, "timestamp": "04:59:09", "text": "上へ、または人々が質問し始めたら"}, {"type": "subtitle", "time": 17952.39, "timestamp": "04:59:12", "text": "ヘンリックに何が起こっているにせよ、それは"}, {"type": "subtitle", "time": 17953.11, "timestamp": "04:59:13", "text": "私のものではない"}, {"type": "subtitle", "time": 17955.43, "timestamp": "04:59:15", "text": "良い。私はクリスタルを手に入れようとしていた"}, {"type": "subtitle", "time": 17958.07, "timestamp": "04:59:18", "text": "穴から取り出して、思った通りに使う"}, {"type": "subtitle", "time": 17959.99, "timestamp": "04:59:19", "text": "その仕事を引き受ける人もいるだろう。それで、私は出発した。"}, {"type": "subtitle", "time": 17961.91, "timestamp": "04:59:21", "text": "何か用意できますよ。あなたが読んでいる"}, {"type": "subtitle", "time": 17963.75, "timestamp": "04:59:23", "text": "身元。"}, {"type": "subtitle", "time": 17965.91, "timestamp": "04:59:25", "text": "あなたが自由に移動できる以外にも、多くの人が"}, {"type": "subtitle", "time": 17967.99, "timestamp": "04:59:27", "text": "あなたにお金を払う意思があります。"}, {"type": "subtitle", "time": 17970.55, "timestamp": "04:59:30", "text": "ほんの少しの命を危険にさらして"}, {"type": "subtitle", "time": 17972.07, "timestamp": "04:59:32", "text": "ゲスト。"}, {"type": "subtitle", "time": 17973.35, "timestamp": "04:59:33", "text": "つまり、旅行は実際には必要ないということです。"}, {"type": "subtitle", "time": 17974.15, "timestamp": "04:59:34", "text": "許可証か。"}, {"type": "subtitle", "time": 17977.75, "timestamp": "04:59:37", "text": "彼は情報を探っている。"}, {"type": "subtitle", "time": 17979.43, "timestamp": "04:59:39", "text": "神様、あなたは偽物のことを言っているのですね。"}, {"type": "subtitle", "time": 17983.75, "timestamp": "04:59:43", "text": "この街には"}, {"type": "subtitle", "time": 17986.23, "timestamp": "04:59:46", "text": "旅行用鍋なしで。では、"}, {"type": "subtitle", "time": 17988.47, "timestamp": "04:59:48", "text": "いいえ、どうぞお持ちください。取引できます。"}, {"type": "subtitle", "time": 17989.83, "timestamp": "04:59:49", "text": "あなたは地元の人ではないので、"}, {"type": "subtitle", "time": 17990.788, "timestamp": "04:59:50", "text": "彼のものではないかもしれない"}, {"type": "subtitle", "time": 17992.07, "timestamp": "04:59:52", "text": "ちょっとこっそり覗き見する。"}, {"type": "subtitle", "time": 17993.35, "timestamp": "04:59:53", "text": "簡単そうに聞こえるけど、"}, {"type": "subtitle", "time": 17993.91, "timestamp": "04:59:53", "text": "注意深い。"}, {"type": "subtitle", "time": 17996.15, "timestamp": "04:59:56", "text": "午前0時12分。了解。時間は"}]
[{"type": "subtitle", "time": 21723.75, "timestamp": "06:02:03", "text": "1人減った。彼の持ち物から手紙を見つけた。手に入れた"}, {"type": "subtitle", "time": 21725.75, "timestamp": "06:02:05", "text": "それ。他の2人のメンバーは"}, {"type": "subtitle", "time": 21727.99, "timestamp": "06:02:07", "text": "フォーセイクンはおそらく私が"}, {"type": "subtitle", "time": 21728.948, "timestamp": "06:02:08", "text": "印を付けました。"}]
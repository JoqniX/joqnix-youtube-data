[{"type": "subtitle", "time": 2764.95, "timestamp": "00:46:04", "text": "面白い。"}, {"type": "subtitle", "time": 2769.589, "timestamp": "00:46:09", "text": "こんにちは。聞こえますか？"}, {"type": "subtitle", "time": 2771.589, "timestamp": "00:46:11", "text": "この小さな子供は誰ですか？"}, {"type": "subtitle", "time": 2774.55, "timestamp": "00:46:14", "text": "カミラ、"}, {"type": "subtitle", "time": 2777.589, "timestamp": "00:46:17", "text": "彼女は目を覚ました。"}, {"type": "subtitle", "time": 2779.43, "timestamp": "00:46:19", "text": "ああ、あれは私たちが"}, {"type": "subtitle", "time": 2780.71, "timestamp": "00:46:20", "text": "カットシーン。"}, {"type": "subtitle", "time": 2783.27, "timestamp": "00:46:23", "text": "生存しており、行動不能状態ではない。"}, {"type": "subtitle", "time": 2786.309, "timestamp": "00:46:26", "text": "骨折はなかったんですね。"}, {"type": "subtitle", "time": 2788.23, "timestamp": "00:46:28", "text": "私はどうして生きているのだろう？"}, {"type": "subtitle", "time": 2791.51, "timestamp": "00:46:31", "text": "どうして私の名前を知っているのですか？バリーでは"}, {"type": "subtitle", "time": 2794.39, "timestamp": "00:46:34", "text": "私たちはそうでしょうか？"}, {"type": "subtitle", "time": 2795.99, "timestamp": "00:46:35", "text": "いいえ。"}, {"type": "subtitle", "time": 2797.349, "timestamp": "00:46:37", "text": "私たちは"}, {"type": "subtitle", "time": 2800.79, "timestamp": "00:46:40", "text": "バリーを見つけなければならない。"}, {"type": "subtitle", "time": 2802.309, "timestamp": "00:46:42", "text": "多分。"}, {"type": "subtitle", "time": 2805.67, "timestamp": "00:46:45", "text": "おい、ちゃんと聞いてるのか？カミラと"}, {"type": "chat", "time": 2806.156, "timestamp": "00:46:46", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "Is it hot where you are?"}, {"type": "subtitle", "time": 2807.19, "timestamp": "00:46:47", "text": "雪はここまで来た。"}, {"type": "subtitle", "time": 2808.63, "timestamp": "00:46:48", "text": "わかった。彼女の名前はスノーです。"}, {"type": "subtitle", "time": 2810.15, "timestamp": "00:46:50", "text": "私たちと一緒に街へ行った方がいいよ。そして"}, {"type": "subtitle", "time": 2813.91, "timestamp": "00:46:53", "text": "金髪の女性の名前は"}, {"type": "subtitle", "time": 2816.55, "timestamp": "00:46:56", "text": "あなたの住んでいる地域は暑いですか？あまり暑くない。"}, {"type": "subtitle", "time": 2818.39, "timestamp": "00:46:58", "text": "中程度です。"}]
[{"type": "subtitle", "time": 23704.68, "timestamp": "06:35:04", "text": "ポップコーンシグ。"}, {"type": "subtitle", "time": 23739.99, "timestamp": "06:35:39", "text": "思いやりの花。"}, {"type": "subtitle", "time": 23743.99, "timestamp": "06:35:43", "text": "ここは花屋です。待って、彼は続けるつもり？"}, {"type": "subtitle", "time": 23746.628, "timestamp": "06:35:46", "text": "デート？向かい側の席に座りましょう"}]
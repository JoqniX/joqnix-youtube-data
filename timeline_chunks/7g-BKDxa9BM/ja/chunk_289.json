[{"type": "subtitle", "time": 17341.11, "timestamp": "04:49:01", "text": "だからあなたは覚えている"}, {"type": "subtitle", "time": 17343.19, "timestamp": "04:49:03", "text": "何か起こった場合、"}, {"type": "subtitle", "time": 17344.868, "timestamp": "04:49:04", "text": "物事を台無しにしたり、人々が始めたり"}, {"type": "subtitle", "time": 17347.51, "timestamp": "04:49:07", "text": "質問する、"}, {"type": "subtitle", "time": 17348.31, "timestamp": "04:49:08", "text": "あのね？"}, {"type": "subtitle", "time": 17349.99, "timestamp": "04:49:09", "text": "本当に申し訳ありません、ミスター。"}, {"type": "subtitle", "time": 17352.31, "timestamp": "04:49:12", "text": "君はいい子だよ。"}, {"type": "subtitle", "time": 17355.75, "timestamp": "04:49:15", "text": "二度とこんなことが起こらないようにしてほしい。"}, {"type": "subtitle", "time": 17358.788, "timestamp": "04:49:18", "text": "あなたに関しては、"}, {"type": "subtitle", "time": 17362.47, "timestamp": "04:49:22", "text": "自分の庭の手入れをし、引きずらない"}, {"type": "subtitle", "time": 17365.35, "timestamp": "04:49:25", "text": "あなたのビジネスに無関係な人々を取り込む。"}, {"type": "subtitle", "time": 17371.75, "timestamp": "04:49:31", "text": "それでは、別の話題に移りましょう。"}, {"type": "subtitle", "time": 17374.31, "timestamp": "04:49:34", "text": "例えば、あなたはこんなに礼儀正しくて"}, {"type": "subtitle", "time": 17376.948, "timestamp": "04:49:36", "text": "誰に対しても友好的？当然のことながら"}, {"type": "subtitle", "time": 17380.23, "timestamp": "04:49:40", "text": "あなたの家は決して売れない。"}, {"type": "subtitle", "time": 17383.19, "timestamp": "04:49:43", "text": "それが私の問題なんです。朝までには、"}, {"type": "subtitle", "time": 17386.07, "timestamp": "04:49:46", "text": "家に帰りましょう。プシュケ。"}, {"type": "subtitle", "time": 17399.59, "timestamp": "04:49:59", "text": "あのハンマーはいつもロイヤルのやり方を知っている"}]
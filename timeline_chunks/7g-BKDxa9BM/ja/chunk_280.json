[{"type": "subtitle", "time": 16801.99, "timestamp": "04:40:01", "text": "すべて順調ですか？崩壊には"}, {"type": "subtitle", "time": 16808.868, "timestamp": "04:40:08", "text": "突然、後ろがはっきり見えなくなった"}, {"type": "subtitle", "time": 16810.55, "timestamp": "04:40:10", "text": "そこには。"}, {"type": "subtitle", "time": 16813.75, "timestamp": "04:40:13", "text": "はい、それは壊れています。"}, {"type": "subtitle", "time": 16817.27, "timestamp": "04:40:17", "text": "一部が弱点だ。"}, {"type": "subtitle", "time": 16818.868, "timestamp": "04:40:18", "text": "えっと"}, {"type": "subtitle", "time": 16822.55, "timestamp": "04:40:22", "text": "弱点ブロック"}, {"type": "subtitle", "time": 16830.868, "timestamp": "04:40:30", "text": "わかった。心理学サイクル彼女は一緒に遊ぶのに良い人です"}, {"type": "subtitle", "time": 16833.43, "timestamp": "04:40:33", "text": "蝶。私は彼女を演じるのが大好きです。どうやって"}, {"type": "subtitle", "time": 16837.11, "timestamp": "04:40:37", "text": "私はエンドゲームに到達しなければならないと思います。"}, {"type": "subtitle", "time": 16838.628, "timestamp": "04:40:38", "text": "アビセラ。"}, {"type": "subtitle", "time": 16839.27, "timestamp": "04:40:39", "text": "これは何ですか"}, {"type": "subtitle", "time": 16841.43, "timestamp": "04:40:41", "text": "美しさ？誰もがその一部を手に入れたがるのも当然だ。"}, {"type": "subtitle", "time": 16841.99, "timestamp": "04:40:41", "text": "それの。"}, {"type": "subtitle", "time": 16844.788, "timestamp": "04:40:44", "text": "ああ、これが次に手に入る男だ。"}, {"type": "subtitle", "time": 16846.788, "timestamp": "04:40:46", "text": "つまり、それを取り除いたのはあなたたちだったんですね"}, {"type": "subtitle", "time": 16850.23, "timestamp": "04:40:50", "text": "巨大なもの。印象的な。"}, {"type": "subtitle", "time": 16852.708, "timestamp": "04:40:52", "text": "こんにちは。えっと、彼の名前は何でしたっけ？"}, {"type": "subtitle", "time": 16853.43, "timestamp": "04:40:53", "text": "アウトサイダー。"}, {"type": "subtitle", "time": 16856.15, "timestamp": "04:40:56", "text": "クリスタルはあなたの手の中にあります。それは私の"}, {"type": "subtitle", "time": 16858.788, "timestamp": "04:40:58", "text": "最初に小さな手下"}]
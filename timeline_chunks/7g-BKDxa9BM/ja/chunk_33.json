[{"type": "subtitle", "time": 1997.11, "timestamp": "00:33:17", "text": "これがあなたの考える正確な情報ですか？"}, {"type": "subtitle", "time": 1998.95, "timestamp": "00:33:18", "text": "ランディ？"}, {"type": "subtitle", "time": 2005.669, "timestamp": "00:33:25", "text": "兵士たちは最善を尽くした"}, {"type": "subtitle", "time": 2007.35, "timestamp": "00:33:27", "text": "汚物ども。"}, {"type": "subtitle", "time": 2009.029, "timestamp": "00:33:29", "text": "これらは確かに予期せぬものです"}, {"type": "subtitle", "time": 2011.909, "timestamp": "00:33:31", "text": "状況。しかし、私たちは何かを発見しました"}, {"type": "subtitle", "time": 2014.549, "timestamp": "00:33:34", "text": "今日、この島で貴重な存在となっている。"}, {"type": "subtitle", "time": 2016.95, "timestamp": "00:33:36", "text": "彼女が使用した錬金術の道具と"}, {"type": "subtitle", "time": 2019.11, "timestamp": "00:33:39", "text": "レギオンのシリアル番号が付いた飛行船"}, {"type": "subtitle", "time": 2019.83, "timestamp": "00:33:39", "text": "それ。"}, {"type": "subtitle", "time": 2021.83, "timestamp": "00:33:41", "text": "私たちは番号を探していることに気づいてください"}, {"type": "subtitle", "time": 2025.669, "timestamp": "00:33:45", "text": "ゼロ、こんな役に立たないガラクタじゃないよね？"}, {"type": "subtitle", "time": 2028.549, "timestamp": "00:33:48", "text": "私たちは10年以上探し続けています。"}, {"type": "subtitle", "time": 2030.789, "timestamp": "00:33:50", "text": "しかし、我々の海上部隊は"}, {"type": "subtitle", "time": 2033.11, "timestamp": "00:33:53", "text": "村のいくつかの船。彼らは"}, {"type": "subtitle", "time": 2035.909, "timestamp": "00:33:55", "text": "いくつか掘り出せるかもしれない。"}, {"type": "subtitle", "time": 2037.509, "timestamp": "00:33:57", "text": "あれは銃声だったのか、"}]
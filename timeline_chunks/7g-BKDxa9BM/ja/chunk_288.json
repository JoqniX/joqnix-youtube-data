[{"type": "subtitle", "time": 17314.788, "timestamp": "04:48:34", "text": "心が揺らいでいる。私"}, {"type": "subtitle", "time": 17316.868, "timestamp": "04:48:36", "text": "あそこにいるヘンリック。"}, {"type": "subtitle", "time": 17318.07, "timestamp": "04:48:38", "text": "こんにちは、ヘンリックさん。"}, {"type": "subtitle", "time": 17324.868, "timestamp": "04:48:44", "text": "ヘンリーさん、"}, {"type": "subtitle", "time": 17326.39, "timestamp": "04:48:46", "text": "ヒュプノスに泊まるべきだった"}, {"type": "subtitle", "time": 17328.39, "timestamp": "04:48:48", "text": "家でふざける代わりに"}, {"type": "subtitle", "time": 17330.788, "timestamp": "04:48:50", "text": "このSK。さて、"}, {"type": "subtitle", "time": 17334.31, "timestamp": "04:48:54", "text": "グラムピット"}, {"type": "subtitle", "time": 17336.07, "timestamp": "04:48:56", "text": "クリスタロを忘れた？"}, {"type": "subtitle", "time": 17338.31, "timestamp": "04:48:58", "text": "どこかへ行かないでください。そして"}]
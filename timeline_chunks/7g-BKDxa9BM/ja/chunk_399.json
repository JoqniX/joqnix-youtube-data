[{"type": "subtitle", "time": 23940.788, "timestamp": "06:39:00", "text": "それは何ですか？"}, {"type": "subtitle", "time": 23942.708, "timestamp": "06:39:02", "text": "今こそ、最も大きな試練を通して学ぶ時が来た"}, {"type": "subtitle", "time": 23951.91, "timestamp": "06:39:11", "text": "いいえ、実際には空っぽではありません。以前は"}, {"type": "subtitle", "time": 23954.468, "timestamp": "06:39:14", "text": "粉。ヘンリックはなぜわざわざ"}, {"type": "subtitle", "time": 23954.788, "timestamp": "06:39:14", "text": "B？"}, {"type": "subtitle", "time": 23975.83, "timestamp": "06:39:35", "text": "私は全身に覆われてしまった。"}, {"type": "subtitle", "time": 23978.788, "timestamp": "06:39:38", "text": "フィナはとにかく、"}, {"type": "subtitle", "time": 23987.91, "timestamp": "06:39:47", "text": "こんなに大きな炉。"}, {"type": "subtitle", "time": 23990.708, "timestamp": "06:39:50", "text": "とんでもない。料理用です。眠り"}, {"type": "subtitle", "time": 23994.39, "timestamp": "06:39:54", "text": "プロジェクト。 9月3日。カロライナ・ブラウン。"}, {"type": "subtitle", "time": 23995.43, "timestamp": "06:39:55", "text": "何？"}, {"type": "subtitle", "time": 23999.75, "timestamp": "06:39:59", "text": "ハント。 11月25日。"}]
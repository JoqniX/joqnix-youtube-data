[{"type": "subtitle", "time": 8762.23, "timestamp": "02:26:02", "text": "カトラの昇天"}, {"type": "subtitle", "time": 8766.23, "timestamp": "02:26:06", "text": "捕獲。依頼が多すぎる。おお。もし"}, {"type": "subtitle", "time": 8767.75, "timestamp": "02:26:07", "text": "お金がなくなってきたら、"}, {"type": "subtitle", "time": 8769.91, "timestamp": "02:26:09", "text": "農家のお金。もしスゲが必要なら、"}, {"type": "subtitle", "time": 8814.63, "timestamp": "02:26:54", "text": "ああ、これらはセットですね。わかった。これらは"}, {"type": "subtitle", "time": 8817.99, "timestamp": "02:26:57", "text": "セット。"}]
[{"type": "subtitle", "time": 22081.51, "timestamp": "06:08:01", "text": "普通の濃厚スープを見つけるだけで"}, {"type": "subtitle", "time": 22082.548, "timestamp": "06:08:02", "text": "空想する"}, {"type": "subtitle", "time": 22084.39, "timestamp": "06:08:04", "text": "ああ、そうです、隊長。"}, {"type": "subtitle", "time": 22085.43, "timestamp": "06:08:05", "text": "私は調剤しています。"}, {"type": "subtitle", "time": 22087.51, "timestamp": "06:08:07", "text": "村人たちは私に、汚物どもが"}, {"type": "subtitle", "time": 22090.31, "timestamp": "06:08:10", "text": "煉獄島の住人は常に"}, {"type": "subtitle", "time": 22092.23, "timestamp": "06:08:12", "text": "山々はあまり"}, {"type": "subtitle", "time": 22094.868, "timestamp": "06:08:14", "text": "2日間。すでに"}, {"type": "subtitle", "time": 22097.27, "timestamp": "06:08:17", "text": "解決しましたよ、隊長。かなり"}, {"type": "subtitle", "time": 22099.59, "timestamp": "06:08:19", "text": "偶然だけが原因ではない"}, {"type": "subtitle", "time": 22101.27, "timestamp": "06:08:21", "text": "操作する能力がある？"}, {"type": "subtitle", "time": 22103.91, "timestamp": "06:08:23", "text": "それが誰であれ、これら30の後の"}, {"type": "subtitle", "time": 22106.948, "timestamp": "06:08:26", "text": "数年経った今、徹底的な調査を行う時期が来た。"}, {"type": "subtitle", "time": 22109.91, "timestamp": "06:08:29", "text": "絶滅。"}, {"type": "subtitle", "time": 22112.39, "timestamp": "06:08:32", "text": "では、彼女は悪い人ですか、それとも"}, {"type": "subtitle", "time": 22115.43, "timestamp": "06:08:35", "text": "アンテルニスト？理解できません。誰が"}, {"type": "subtitle", "time": 22116.948, "timestamp": "06:08:36", "text": "サウンドトラックとすべてが、"}, {"type": "subtitle", "time": 22119.19, "timestamp": "06:08:39", "text": "彼女は悪い人みたいだけど、なぜ"}, {"type": "subtitle", "time": 22121.03, "timestamp": "06:08:41", "text": "彼女はプレイアブルキャラクターですか？"}, {"type": "subtitle", "time": 22124.31, "timestamp": "06:08:44", "text": "まるでヴーヴァがどうやって作られたかみたいだ"}, {"type": "subtitle", "time": 22127.03, "timestamp": "06:08:47", "text": "フィル・フィローラ何とか何とか"}, {"type": "subtitle", "time": 22128.868, "timestamp": "06:08:48", "text": "プレイ可能"}, {"type": "subtitle", "time": 22133.51, "timestamp": "06:08:53", "text": "それはおかしい。それもいいですね。"}]
[{"type": "subtitle", "time": 16442.23, "timestamp": "04:34:02", "text": "私はこれをやらなければならない。来て。どうやら"}, {"type": "subtitle", "time": 16445.189, "timestamp": "04:34:05", "text": "ピットの中にいる。"}, {"type": "subtitle", "time": 16446.949, "timestamp": "04:34:06", "text": "その雑誌は、"}, {"type": "subtitle", "time": 16448.789, "timestamp": "04:34:08", "text": "特別な汚物になれ。"}, {"type": "subtitle", "time": 16451.269, "timestamp": "04:34:11", "text": "見てください、真ん中にある巨大な水晶は"}, {"type": "subtitle", "time": 16454.47, "timestamp": "04:34:14", "text": "輝いている。結晶が"}, {"type": "subtitle", "time": 16464.869, "timestamp": "04:34:24", "text": "再び声を。"}, {"type": "subtitle", "time": 16467.029, "timestamp": "04:34:27", "text": "甘い。"}, {"type": "subtitle", "time": 16469.269, "timestamp": "04:34:29", "text": "なぜこんなに汚物が出てくるのか"}, {"type": "subtitle", "time": 16472.15, "timestamp": "04:34:32", "text": "突然、私たちに襲いかかってきたのか？"}, {"type": "subtitle", "time": 16475.029, "timestamp": "04:34:35", "text": "ここに1つ置いてください。"}, {"type": "subtitle", "time": 16479.429, "timestamp": "04:34:39", "text": "私の光り輝く爆弾を受け取って。"}, {"type": "subtitle", "time": 16480.551, "timestamp": "04:34:40", "text": "大丈夫。"}, {"type": "subtitle", "time": 16489.029, "timestamp": "04:34:49", "text": "黄色の結晶の突起は実際には"}, {"type": "subtitle", "time": 16491.83, "timestamp": "04:34:51", "text": "内部にはたくさんのきらめく石が散りばめられている。"}, {"type": "subtitle", "time": 16493.99, "timestamp": "04:34:53", "text": "それらは注意深く隠されていたようだ"}, {"type": "subtitle", "time": 16498.15, "timestamp": "04:34:58", "text": "まるで大切な宝物のように、遠くへ持ち去られた。"}]
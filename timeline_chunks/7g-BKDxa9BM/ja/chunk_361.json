[{"type": "subtitle", "time": 21661.83, "timestamp": "06:01:01", "text": "ここで絆を深めよう。破壊しなければ、"}, {"type": "subtitle", "time": 21663.51, "timestamp": "06:01:03", "text": "全員の命が墓場に落ちる"}, {"type": "subtitle", "time": 21665.83, "timestamp": "06:01:05", "text": "危険。クライアントは3つ挙げた"}, {"type": "subtitle", "time": 21667.59, "timestamp": "06:01:07", "text": "フォーセイクンズのメンバーが背後にいる"}, {"type": "subtitle", "time": 21669.99, "timestamp": "06:01:09", "text": "この爆発。もし私が"}, {"type": "subtitle", "time": 21672.23, "timestamp": "06:01:12", "text": "彼を見つけろ。それらを取り外す前に"}, {"type": "subtitle", "time": 21675.03, "timestamp": "06:01:15", "text": "フィナーレフレアの起爆装置を壊すと"}, {"type": "subtitle", "time": 21693.91, "timestamp": "06:01:33", "text": "兵士の一人が"}, {"type": "subtitle", "time": 21696.23, "timestamp": "06:01:36", "text": "見捨てられた。"}, {"type": "subtitle", "time": 21698.47, "timestamp": "06:01:38", "text": "クライアントは、フィナーレを防ぐよう私たちに依頼しました。"}, {"type": "subtitle", "time": 21701.03, "timestamp": "06:01:41", "text": "爆発による閃光。だから、"}, {"type": "subtitle", "time": 21705.43, "timestamp": "06:01:45", "text": "これらの兵士たちは我々に有利に働くはずだ。"}, {"type": "subtitle", "time": 21706.868, "timestamp": "06:01:46", "text": "おもちゃメーカー。"}]
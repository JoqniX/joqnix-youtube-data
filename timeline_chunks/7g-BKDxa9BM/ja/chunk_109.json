[{"type": "subtitle", "time": 6542.229, "timestamp": "01:49:02", "text": "今後の戦いのために。わかりました、"}, {"type": "subtitle", "time": 6544.95, "timestamp": "01:49:04", "text": "それ？"}, {"type": "subtitle", "time": 6547.27, "timestamp": "01:49:07", "text": "今日の会場へ向かいます。"}, {"type": "subtitle", "time": 6549.43, "timestamp": "01:49:09", "text": "タクティカルバッグの中の様々なアイテムをドラッグする"}, {"type": "subtitle", "time": 6553.03, "timestamp": "01:49:13", "text": "戦闘を用いる。あなたは十分に準備を整えているでしょう。"}, {"type": "subtitle", "time": 6555.59, "timestamp": "01:49:15", "text": "compatを使用して仲間を召喚し、戦闘を行います。"}, {"type": "subtitle", "time": 6557.91, "timestamp": "01:49:17", "text": "そうするために。まず、"}, {"type": "subtitle", "time": 6560.629, "timestamp": "01:49:20", "text": "タクティカルバックパック。まず最初に"}, {"type": "subtitle", "time": 6563.03, "timestamp": "01:49:23", "text": "装甲は当社のコンパクトなパートナーです"}, {"type": "subtitle", "time": 6565.83, "timestamp": "01:49:25", "text": "積み込み。"}, {"type": "subtitle", "time": 6568.149, "timestamp": "01:49:28", "text": "各戦闘パーツには以下を装備できます"}, {"type": "subtitle", "time": 6571.189, "timestamp": "01:49:31", "text": "近接武器か遠距離武器のどちらか1つのみ使用可能。"}, {"type": "subtitle", "time": 6573.75, "timestamp": "01:49:33", "text": "各武器は1人にしか割り当てることができません。"}, {"type": "subtitle", "time": 6577.03, "timestamp": "01:49:37", "text": "わかった。料理武器を手に入れても、"}, {"type": "subtitle", "time": 6580.709, "timestamp": "01:49:40", "text": "このページには賃金情報が掲載されています。 com をドラッグして"}, {"type": "subtitle", "time": 6584.709, "timestamp": "01:49:44", "text": "武器を戦術用バッテリーパックに組み込む。"}, {"type": "subtitle", "time": 6587.189, "timestamp": "01:49:47", "text": "わかった。"}, {"type": "subtitle", "time": 6589.35, "timestamp": "01:49:49", "text": "世界探検中またはソロ"}, {"type": "subtitle", "time": 6591.51, "timestamp": "01:49:51", "text": "依頼により、最大2人まで召喚できます"}, {"type": "subtitle", "time": 6593.669, "timestamp": "01:49:53", "text": "一度に複数の戦闘パターンを処理。その間"}, {"type": "subtitle", "time": 6596.31, "timestamp": "01:49:56", "text": "2人用コミッション、各プレイヤーは"}]
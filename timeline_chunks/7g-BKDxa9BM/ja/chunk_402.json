[{"type": "subtitle", "time": 24120.708, "timestamp": "06:42:00", "text": "失敗。でも、勇気を持つことを忘れないで。"}, {"type": "subtitle", "time": 24122.628, "timestamp": "06:42:02", "text": "無謀な行動はしないし、私はこれを踏み越える"}, {"type": "subtitle", "time": 24129.27, "timestamp": "06:42:09", "text": "ありがとう。心配しないで。私は"}, {"type": "subtitle", "time": 24131.03, "timestamp": "06:42:11", "text": "わかった。"}, {"type": "subtitle", "time": 24135.97, "timestamp": "06:42:15", "text": "翌日。"}, {"type": "subtitle", "time": 24145.67, "timestamp": "06:42:25", "text": "わかった。この章の後は、"}, {"type": "subtitle", "time": 24150.15, "timestamp": "06:42:30", "text": "本日はこれで終了とさせていただきます。"}, {"type": "subtitle", "time": 24152.468, "timestamp": "06:42:32", "text": "魚。"}, {"type": "subtitle", "time": 24154.628, "timestamp": "06:42:34", "text": "うん。"}, {"type": "subtitle", "time": 24171.27, "timestamp": "06:42:51", "text": "悪魔。"}]
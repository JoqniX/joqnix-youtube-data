[{"type": "subtitle", "time": 5945.669, "timestamp": "01:39:05", "text": "感じるよ。"}, {"type": "subtitle", "time": 5947.35, "timestamp": "01:39:07", "text": "たとえあなたが"}, {"type": "subtitle", "time": 5948.39, "timestamp": "01:39:08", "text": "笑顔。"}, {"type": "subtitle", "time": 5951.35, "timestamp": "01:39:11", "text": "彼女の服がすごく好き。それはまるで"}, {"type": "subtitle", "time": 5953.59, "timestamp": "01:39:13", "text": "あなたが何をしているのか少し気になります"}, {"type": "subtitle", "time": 5954.709, "timestamp": "01:39:14", "text": "を通して。"}, {"type": "subtitle", "time": 5956.87, "timestamp": "01:39:16", "text": "ヘンリック氏は私に、私たちの"}, {"type": "subtitle", "time": 5958.31, "timestamp": "01:39:18", "text": "過去の宿泊客。"}, {"type": "subtitle", "time": 5961.51, "timestamp": "01:39:21", "text": "彼女の腕についている、あのやつ。"}, {"type": "subtitle", "time": 5963.669, "timestamp": "01:39:23", "text": "蝶のように。"}, {"type": "subtitle", "time": 5967.27, "timestamp": "01:39:27", "text": "プシュケ。お金が必要なんです。は"}, {"type": "subtitle", "time": 5970.55, "timestamp": "01:39:30", "text": "どこかありますか？そうねぇ。ほとんどの人が"}, {"type": "subtitle", "time": 5973.75, "timestamp": "01:39:33", "text": "ここでは工場で働いています。カミラさん"}, {"type": "subtitle", "time": 5975.91, "timestamp": "01:39:35", "text": "スカーレットの酒場。しかし"}, {"type": "subtitle", "time": 5976.629, "timestamp": "01:39:36", "text": "手数料。"}, {"type": "subtitle", "time": 5979.669, "timestamp": "01:39:39", "text": "それらの手数料。カミラ・スカーレット。"}, {"type": "subtitle", "time": 5982.629, "timestamp": "01:39:42", "text": "今日、彼女に会った。全く知らなかった"}, {"type": "subtitle", "time": 5985.51, "timestamp": "01:39:45", "text": "彼女は大丈夫だ。私なら大丈夫。"}, {"type": "subtitle", "time": 5987.91, "timestamp": "01:39:47", "text": "はぁ？こんなに走り回った後、"}, {"type": "subtitle", "time": 5991.03, "timestamp": "01:39:51", "text": "カミラとよりを戻すの？それから数える"}, {"type": "subtitle", "time": 5994.149, "timestamp": "01:39:54", "text": "雪が降る。雪は雪にとても慣れている。"}, {"type": "subtitle", "time": 5996.149, "timestamp": "01:39:56", "text": "あの場所。"}]
[{"type": "subtitle", "time": 2822.309, "timestamp": "00:47:02", "text": "街は大騒ぎになったんだね？心配ない。"}, {"type": "subtitle", "time": 2825.109, "timestamp": "00:47:05", "text": "すぐに安全になりますよ。アイスレイクは"}, {"type": "subtitle", "time": 2828.95, "timestamp": "00:47:08", "text": "ハイペロリア北部最大の都市。"}, {"type": "subtitle", "time": 2831.75, "timestamp": "00:47:11", "text": "北部ヒポポリア。"}, {"type": "subtitle", "time": 2834.79, "timestamp": "00:47:14", "text": "ええ、そうですね。何がそんなに問題なの？"}, {"type": "subtitle", "time": 2837.43, "timestamp": "00:47:17", "text": "シビルという女性を知っていますか？"}, {"type": "subtitle", "time": 2840.39, "timestamp": "00:47:20", "text": "他の人は彼女をチーフと呼び、"}, {"type": "subtitle", "time": 2843.99, "timestamp": "00:47:23", "text": "彼女はこの国にいるはずなのに。私"}, {"type": "subtitle", "time": 2844.47, "timestamp": "00:47:24", "text": "必要"}, {"type": "subtitle", "time": 2846.87, "timestamp": "00:47:26", "text": "市民は一般的な名前ですが、"}, {"type": "subtitle", "time": 2849.51, "timestamp": "00:47:29", "text": "役職名「チーフ」と関連付けられるもの。"}, {"type": "subtitle", "time": 2851.43, "timestamp": "00:47:31", "text": "彼女を見つけたいのですか？"}, {"type": "subtitle", "time": 2852.87, "timestamp": "00:47:32", "text": "どうして正気を失ったのか"}, {"type": "subtitle", "time": 2853.829, "timestamp": "00:47:33", "text": "ブリザード？"}, {"type": "subtitle", "time": 2855.75, "timestamp": "00:47:35", "text": "カロンは"}, {"type": "subtitle", "time": 2857.67, "timestamp": "00:47:37", "text": "低温に強い。"}, {"type": "subtitle", "time": 2858.47, "timestamp": "00:47:38", "text": "カロンズ？"}, {"type": "subtitle", "time": 2863.19, "timestamp": "00:47:43", "text": "真剣になれ。彼女が少し飲んだのかもしれない。"}, {"type": "subtitle", "time": 2866.95, "timestamp": "00:47:46", "text": "それは私にとって非常に重要なことです。スパイ活動、"}, {"type": "subtitle", "time": 2869.67, "timestamp": "00:47:49", "text": "暗殺、反抗。何で"}, {"type": "subtitle", "time": 2871.349, "timestamp": "00:47:51", "text": "あなたは今、帝国兵が"}, {"type": "subtitle", "time": 2872.95, "timestamp": "00:47:52", "text": "以下の3つの理由で逮捕される可能性があります"}, {"type": "subtitle", "time": 2873.589, "timestamp": "00:47:53", "text": "一人で。"}, {"type": "subtitle", "time": 2874.63, "timestamp": "00:47:54", "text": "おお。"}, {"type": "subtitle", "time": 2877.03, "timestamp": "00:47:57", "text": "もし本当に首領を見つけたいなら、"}, {"type": "subtitle", "time": 2879.27, "timestamp": "00:47:59", "text": "お勧めしません。そして最後に"}]
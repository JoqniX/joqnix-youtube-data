[{"type": "subtitle", "time": 17880.628, "timestamp": "04:58:00", "text": "州は都市を混乱に陥れた。"}, {"type": "subtitle", "time": 17881.99, "timestamp": "04:58:01", "text": "その時、彼らは禁止令を出した"}, {"type": "subtitle", "time": 17884.07, "timestamp": "04:58:04", "text": "クリスタロ取引。"}, {"type": "subtitle", "time": 17886.39, "timestamp": "04:58:06", "text": "それはほんの一部に過ぎない。幾つか"}, {"type": "subtitle", "time": 17888.07, "timestamp": "04:58:08", "text": "アイスレートの街の人々は"}, {"type": "subtitle", "time": 17891.43, "timestamp": "04:58:11", "text": "本当に潔白だと言えるのか？"}, {"type": "subtitle", "time": 17892.708, "timestamp": "04:58:12", "text": "近所の人たちはこう言っています"}, {"type": "subtitle", "time": 17896.07, "timestamp": "04:58:16", "text": "ヘンリックと彼のロッジの連中は、ちょっと変わった連中だ。"}, {"type": "subtitle", "time": 17897.75, "timestamp": "04:58:17", "text": "彼らは自分たちの世界に閉じこもっている。いくつかは"}, {"type": "subtitle", "time": 17900.47, "timestamp": "04:58:20", "text": "中を覗き込んだ。そこのロッジはすべて"}, {"type": "subtitle", "time": 17902.788, "timestamp": "04:58:22", "text": "20歳未満の若者。"}, {"type": "subtitle", "time": 17903.83, "timestamp": "04:58:23", "text": "いまだに見知らぬ者同士。"}, {"type": "subtitle", "time": 17906.23, "timestamp": "04:58:26", "text": "はい、幽霊屋敷の話を聞いたことがあります"}, {"type": "subtitle", "time": 17908.39, "timestamp": "04:58:28", "text": "噂も流れている。どうやってこの仕事に就いたのですか？"}, {"type": "subtitle", "time": 17908.628, "timestamp": "04:58:28", "text": "これ？"}, {"type": "subtitle", "time": 17910.39, "timestamp": "04:58:30", "text": "昔、キツネ狩りをする少年がいたんだけど"}, {"type": "subtitle", "time": 17911.75, "timestamp": "04:58:31", "text": "ハントという人物と仕事をする。"}, {"type": "subtitle", "time": 17914.23, "timestamp": "04:58:34", "text": "ハント？数日前、私は"}, {"type": "subtitle", "time": 17916.47, "timestamp": "04:58:36", "text": "そこで激しい口論になり、"}, {"type": "subtitle", "time": 17917.99, "timestamp": "04:58:37", "text": "ヘンリック。"}, {"type": "subtitle", "time": 17919.91, "timestamp": "04:58:39", "text": "喉に短剣を突きつけられても、彼は"}, {"type": "subtitle", "time": 17922.788, "timestamp": "04:58:42", "text": "ただそこに立って、嘲笑っていた。あなたが知っている"}, {"type": "subtitle", "time": 17924.708, "timestamp": "04:58:44", "text": "キャロンに何が起こるか、よくわかった"}, {"type": "subtitle", "time": 17926.868, "timestamp": "04:58:46", "text": "太陽に害を与える。あなたには"}, {"type": "subtitle", "time": 17928.948, "timestamp": "04:58:48", "text": "妹。近寄らない方がいいよ。くそ。私"}, {"type": "subtitle", "time": 17930.07, "timestamp": "04:58:50", "text": "本当に彼を"}, {"type": "subtitle", "time": 17933.51, "timestamp": "04:58:53", "text": "嘆きの湖。とにかく、調べなければならない"}, {"type": "subtitle", "time": 17934.868, "timestamp": "04:58:54", "text": "ハントに何が起こったのか。"}, {"type": "subtitle", "time": 17936.55, "timestamp": "04:58:56", "text": "ハントだけではない。"}, {"type": "subtitle", "time": 17939.43, "timestamp": "04:58:59", "text": "私は主にフィナのためにこれをやっています。"}]
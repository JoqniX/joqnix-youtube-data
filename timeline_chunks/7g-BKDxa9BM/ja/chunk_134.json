[{"type": "subtitle", "time": 8040.79, "timestamp": "02:14:00", "text": "アスフォデルは邪魔にならない。クリスタロ"}, {"type": "subtitle", "time": 8043.589, "timestamp": "02:14:03", "text": "ステラの青紫色の結晶は"}, {"type": "subtitle", "time": 8045.83, "timestamp": "02:14:05", "text": "星雲が渦巻いているように見える。ここに"}, {"type": "subtitle", "time": 8047.589, "timestamp": "02:14:07", "text": "回収のための料金。作って"}, {"type": "subtitle", "time": 8049.03, "timestamp": "02:14:09", "text": "無事に帰還した。"}, {"type": "subtitle", "time": 8052.149, "timestamp": "02:14:12", "text": "ああ、神様。"}, {"type": "subtitle", "time": 8059.83, "timestamp": "02:14:19", "text": "わかった。"}, {"type": "subtitle", "time": 8062.709, "timestamp": "02:14:22", "text": "つまり、無駄な付属品ということだ。"}, {"type": "subtitle", "time": 8065.109, "timestamp": "02:14:25", "text": "グリル電源を取り外します"}, {"type": "subtitle", "time": 8066.87, "timestamp": "02:14:26", "text": "キャラクター。"}, {"type": "subtitle", "time": 8070.31, "timestamp": "02:14:30", "text": "戦闘は現在ロックされています。"}, {"type": "subtitle", "time": 8084.229, "timestamp": "02:14:44", "text": "魅力的な報酬。わかった。"}, {"type": "subtitle", "time": 8090.87, "timestamp": "02:14:50", "text": "XP"}]
[{"type": "subtitle", "time": 1928.95, "timestamp": "00:32:08", "text": "私たちは何年も探し続けています。いつ"}, {"type": "subtitle", "time": 1930.63, "timestamp": "00:32:10", "text": "署長はこの無意味なことを諦めるだろうか"}, {"type": "subtitle", "time": 1931.909, "timestamp": "00:32:11", "text": "ハント？"}, {"type": "subtitle", "time": 1934.87, "timestamp": "00:32:14", "text": "誰ですか？武器を捨てろ。あなたは"}, {"type": "subtitle", "time": 1937.11, "timestamp": "00:32:17", "text": "第13軍団に包囲された。"}, {"type": "subtitle", "time": 1940.47, "timestamp": "00:32:20", "text": "なぜそうなるのですか？"}, {"type": "subtitle", "time": 1943.909, "timestamp": "00:32:23", "text": "バリー、何があったんだ？"}, {"type": "subtitle", "time": 1947.509, "timestamp": "00:32:27", "text": "レギオン。彼らはここまでたどり着いた。"}, {"type": "subtitle", "time": 1950.95, "timestamp": "00:32:30", "text": "とにかく、彼らが先に脱出したんだ。"}]
[{"type": "subtitle", "time": 7269.91, "timestamp": "02:01:09", "text": "まずは西の方角から探してみましょう。"}, {"type": "subtitle", "time": 7274.629, "timestamp": "02:01:14", "text": "泥棒は黒髪で、"}, {"type": "subtitle", "time": 7278.79, "timestamp": "02:01:18", "text": "青いトップスだったと思う。"}, {"type": "subtitle", "time": 7283.189, "timestamp": "02:01:23", "text": "ああ、見て。不況時代の悪役だ。"}, {"type": "subtitle", "time": 7283.669, "timestamp": "02:01:23", "text": "こんにちは。"}, {"type": "subtitle", "time": 7285.43, "timestamp": "02:01:25", "text": "こんにちは、バディさん。"}, {"type": "subtitle", "time": 7288.47, "timestamp": "02:01:28", "text": "散歩に出かけました。"}, {"type": "subtitle", "time": 7289.43, "timestamp": "02:01:29", "text": "ああ、それは"}, {"type": "subtitle", "time": 7293.669, "timestamp": "02:01:33", "text": "私は脇役ではない。私は魔王だ。"}, {"type": "subtitle", "time": 7295.35, "timestamp": "02:01:35", "text": "よし、それで"}, {"type": "subtitle", "time": 7299.99, "timestamp": "02:01:39", "text": "いやいや。光の魔王だ。"}, {"type": "subtitle", "time": 7308.95, "timestamp": "02:01:48", "text": "ええ、ある意味では。ありがとう。私は行きます。彼"}, {"type": "subtitle", "time": 7311.27, "timestamp": "02:01:51", "text": "3番目の大きなゴミ箱という意味だった。今、"}, {"type": "subtitle", "time": 7316.149, "timestamp": "02:01:56", "text": "この辺りは静かだ。心配ない。"}, {"type": "subtitle", "time": 7319.669, "timestamp": "02:01:59", "text": "何？ゴミ箱の中に何か入っている。単に"}]
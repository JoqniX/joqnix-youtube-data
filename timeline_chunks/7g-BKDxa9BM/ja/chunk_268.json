[{"type": "subtitle", "time": 16083.11, "timestamp": "04:28:03", "text": "よし、行こう。"}, {"type": "subtitle", "time": 16085.75, "timestamp": "04:28:05", "text": "私はOculusというデバイスを1つ購入しました。"}, {"type": "subtitle", "time": 16088.07, "timestamp": "04:28:08", "text": "魔王、小さな手下"}, {"type": "subtitle", "time": 16090.71, "timestamp": "04:28:10", "text": "遠くからアイスレイクに到着したばかりで、"}, {"type": "subtitle", "time": 16094.71, "timestamp": "04:28:14", "text": "たった一日で優秀なハンターになる。"}, {"type": "subtitle", "time": 16097.269, "timestamp": "04:28:17", "text": "この伝説の新たな章"}, {"type": "subtitle", "time": 16098.95, "timestamp": "04:28:18", "text": "魔王。"}, {"type": "subtitle", "time": 16101.75, "timestamp": "04:28:21", "text": "キツネ狩りってかっこいい名前だね。"}, {"type": "subtitle", "time": 16105.03, "timestamp": "04:28:25", "text": "彼らは皆、キツネと呼ばれる動物を狩るのですか？"}, {"type": "subtitle", "time": 16107.59, "timestamp": "04:28:27", "text": "いや、今のキツネ狩りは実際には"}, {"type": "subtitle", "time": 16109.83, "timestamp": "04:28:29", "text": "賞金稼ぎ。関係がある"}, {"type": "subtitle", "time": 16112.389, "timestamp": "04:28:32", "text": "ずっと昔からキツネ狩りをしていた。"}, {"type": "subtitle", "time": 16115.51, "timestamp": "04:28:35", "text": "右。私はそれが、"}, {"type": "subtitle", "time": 16118.07, "timestamp": "04:28:38", "text": "この地で生まれた職業"}, {"type": "subtitle", "time": 16129.75, "timestamp": "04:28:49", "text": "デートに誘ってくれてるの？"}, {"type": "subtitle", "time": 16136.71, "timestamp": "04:28:56", "text": "積み込み。"}, {"type": "subtitle", "time": 16139.03, "timestamp": "04:28:59", "text": "ええと、彼女にあげます。私は持っていません"}]
[{"type": "subtitle", "time": 13418.55, "timestamp": "03:43:38", "text": "ちっぽけな手下。重大ニュース。つまり、"}, {"type": "subtitle", "time": 13429.75, "timestamp": "03:43:49", "text": "まだ見ていないけど、"}, {"type": "subtitle", "time": 13432.309, "timestamp": "03:43:52", "text": "それについて考えると、鳥肌が立つ。"}, {"type": "subtitle", "time": 13434.71, "timestamp": "03:43:54", "text": "すでに。"}, {"type": "subtitle", "time": 13437.75, "timestamp": "03:43:57", "text": "落ち着いて深呼吸してください。何ですか"}]
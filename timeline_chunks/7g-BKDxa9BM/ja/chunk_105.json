[{"type": "subtitle", "time": 6301.51, "timestamp": "01:45:01", "text": "よし、鍛造を始めよう。"}, {"type": "subtitle", "time": 6311.35, "timestamp": "01:45:11", "text": "[音楽]"}, {"type": "subtitle", "time": 6313.43, "timestamp": "01:45:13", "text": "何かお宝を見つけましたか？"}, {"type": "subtitle", "time": 6316.149, "timestamp": "01:45:16", "text": "最近？見せてくれれば、偽造するかもしれない"}, {"type": "subtitle", "time": 6320.39, "timestamp": "01:45:20", "text": "そこから生まれるのは、実に並外れた武器だ。"}, {"type": "subtitle", "time": 6335.83, "timestamp": "01:45:35", "text": "えーと、イベント。"}]
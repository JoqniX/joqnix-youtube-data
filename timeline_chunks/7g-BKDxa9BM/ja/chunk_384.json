[{"type": "subtitle", "time": 23040.23, "timestamp": "06:24:00", "text": "正しい。土壌が原因かもしれない。はい、"}, {"type": "subtitle", "time": 23042.39, "timestamp": "06:24:02", "text": "彼は、特別な土壌は"}, {"type": "subtitle", "time": 23045.27, "timestamp": "06:24:05", "text": "他のものよりも肥沃である。たぶん私は"}, {"type": "subtitle", "time": 23049.03, "timestamp": "06:24:09", "text": "そこに行って、まあ、忘れてしまってもいいよ。病気"}, {"type": "subtitle", "time": 23051.67, "timestamp": "06:24:11", "text": "このことは後で考えよう。"}, {"type": "subtitle", "time": 23055.03, "timestamp": "06:24:15", "text": "心配しないで。そうする必要はありません。"}, {"type": "subtitle", "time": 23057.67, "timestamp": "06:24:17", "text": "大丈夫。私は町を出なければならない"}, {"type": "subtitle", "time": 23060.948, "timestamp": "06:24:20", "text": "とにかく手数料はね。ありがとう。私は"}, {"type": "subtitle", "time": 23063.43, "timestamp": "06:24:23", "text": "感謝を言おうとしているのですが、"}, {"type": "subtitle", "time": 23065.67, "timestamp": "06:24:25", "text": "私たちはそんな形式ばったことはもう気にしない。私に与えさせてください"}, {"type": "subtitle", "time": 23067.75, "timestamp": "06:24:27", "text": "洞窟の場所を教えてください。"}, {"type": "subtitle", "time": 23083.99, "timestamp": "06:24:43", "text": "これをスピードランでクリアしなきゃ。"}, {"type": "subtitle", "time": 23086.868, "timestamp": "06:24:46", "text": "つまり、急ぐ必要はないんです。それは"}, {"type": "subtitle", "time": 23088.39, "timestamp": "06:24:48", "text": "このゲームの良いところ。私はしません"}]
[{"type": "subtitle", "time": 1818.07, "timestamp": "00:30:18", "text": "私たちは前進し続ける。"}, {"type": "subtitle", "time": 1820.07, "timestamp": "00:30:20", "text": "別れを告げるなんて信じられない"}, {"type": "subtitle", "time": 1827.51, "timestamp": "00:30:27", "text": "お前ら生き物は私たちに"}, {"type": "subtitle", "time": 1837.43, "timestamp": "00:30:37", "text": "降伏。"}]
[{"type": "subtitle", "time": 18421.83, "timestamp": "05:07:01", "text": "制限。 N氏以外には誰もいません。"}, {"type": "subtitle", "time": 18424.23, "timestamp": "05:07:04", "text": "そこには何も面白いものはない。"}, {"type": "subtitle", "time": 18426.628, "timestamp": "05:07:06", "text": "掃除、埃払い"}, {"type": "subtitle", "time": 18428.868, "timestamp": "05:07:08", "text": "毎日。君は何も分かっていない。その"}, {"type": "subtitle", "time": 18431.43, "timestamp": "05:07:11", "text": "習慣。掃除の仕方と同じように詰める"}, {"type": "subtitle", "time": 18434.07, "timestamp": "05:07:14", "text": "毎日ここで、またはプシュケが彼女に水をやる方法"}, {"type": "subtitle", "time": 18435.91, "timestamp": "05:07:15", "text": "花を1日に2回。"}, {"type": "subtitle", "time": 18438.07, "timestamp": "05:07:18", "text": "習慣は心の空虚さを埋める。"}, {"type": "subtitle", "time": 18440.31, "timestamp": "05:07:20", "text": "彼はかなり規律正しいようだ。"}, {"type": "subtitle", "time": 18443.99, "timestamp": "05:07:23", "text": "ヘンリックさん、リンゴの皮をむくとき、"}, {"type": "subtitle", "time": 18446.948, "timestamp": "05:07:26", "text": "皮は破れてはいけない。ステップ数"}, {"type": "subtitle", "time": 18449.35, "timestamp": "05:07:29", "text": "お風呂から、これらの習慣はかなり"}, {"type": "subtitle", "time": 18451.27, "timestamp": "05:07:31", "text": "個人的な話ですが。"}, {"type": "subtitle", "time": 18454.31, "timestamp": "05:07:34", "text": "それで、ヘンリックは定期的に"}, {"type": "subtitle", "time": 18457.59, "timestamp": "05:07:37", "text": "午後8時に帰宅毎月20日。"}, {"type": "subtitle", "time": 18470.948, "timestamp": "05:07:50", "text": "こんにちは、ミア。"}, {"type": "subtitle", "time": 18473.19, "timestamp": "05:07:53", "text": "あなたは私を置いていっただけでなく、"}, {"type": "subtitle", "time": 18474.868, "timestamp": "05:07:54", "text": "右。"}, {"type": "subtitle", "time": 18476.55, "timestamp": "05:07:56", "text": "はぁ？"}]
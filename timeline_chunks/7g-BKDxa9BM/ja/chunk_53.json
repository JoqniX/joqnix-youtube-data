[{"type": "subtitle", "time": 3180.549, "timestamp": "00:53:00", "text": "急ぐ必要は全くありません。"}, {"type": "subtitle", "time": 3183.589, "timestamp": "00:53:03", "text": "これは農業ゲームです。耐えられない"}, {"type": "subtitle", "time": 3194.15, "timestamp": "00:53:14", "text": "本の栽培は大変だろう、私は"}, {"type": "subtitle", "time": 3206.23, "timestamp": "00:53:26", "text": "[音楽]"}, {"type": "subtitle", "time": 3209.51, "timestamp": "00:53:29", "text": "一部のスキルはFSを発動させますが、それは場合によります。"}, {"type": "subtitle", "time": 3211.349, "timestamp": "00:53:31", "text": "えっと"}, {"type": "subtitle", "time": 3216.549, "timestamp": "00:53:36", "text": "スキルを発揮する。"}, {"type": "subtitle", "time": 3219.51, "timestamp": "00:53:39", "text": "全身に痣や切り傷があるようだね。は"}, {"type": "subtitle", "time": 3224.47, "timestamp": "00:53:44", "text": "ダメージ。"}, {"type": "subtitle", "time": 3226.39, "timestamp": "00:53:46", "text": "元気です。"}, {"type": "subtitle", "time": 3228.309, "timestamp": "00:53:48", "text": "痛みはもうなくなりました。"}, {"type": "subtitle", "time": 3230.23, "timestamp": "00:53:50", "text": "何か本当に悪いことが起こったに違いない"}, {"type": "subtitle", "time": 3234.71, "timestamp": "00:53:54", "text": "あなたへ。でも、心配はいりません。あなたは私の支配下にある"}, {"type": "subtitle", "time": 3238.23, "timestamp": "00:53:58", "text": "今すぐ翼を。雪があなたを守ってくれるでしょう。後"}]
[{"type": "subtitle", "time": 6687.99, "timestamp": "01:51:27", "text": "ああ、それは火炎放射器だ。なんてこった、"}, {"type": "subtitle", "time": 6690.229, "timestamp": "01:51:30", "text": "まさかの火炎放射器。"}, {"type": "subtitle", "time": 6692.709, "timestamp": "01:51:32", "text": "とんでもない。"}, {"type": "subtitle", "time": 6700.47, "timestamp": "01:51:40", "text": "おお。"}, {"type": "subtitle", "time": 6703.109, "timestamp": "01:51:43", "text": "よく見ると、各キャラクターには"}, {"type": "subtitle", "time": 6705.99, "timestamp": "01:51:45", "text": "独自のもの。私は"}, {"type": "subtitle", "time": 6708.39, "timestamp": "01:51:48", "text": "レベッカを演じている彼女の色はアクアマリンのようで、"}, {"type": "subtitle", "time": 6711.75, "timestamp": "01:51:51", "text": "右？剣の斬撃と"}, {"type": "subtitle", "time": 6716.47, "timestamp": "01:51:56", "text": "銃声は彼女のアクセントのテーマだ。それは"}]
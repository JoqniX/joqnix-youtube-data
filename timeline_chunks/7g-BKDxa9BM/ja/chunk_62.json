[{"type": "subtitle", "time": 3721.51, "timestamp": "01:02:01", "text": "多すぎる"}, {"type": "subtitle", "time": 3725.51, "timestamp": "01:02:05", "text": "繰り返しが多くて、"}, {"type": "subtitle", "time": 3727.43, "timestamp": "01:02:07", "text": "それは、あなたが燃え尽きた後に起こります"}, {"type": "subtitle", "time": 3730.549, "timestamp": "01:02:10", "text": "ひたすら努力している。いいえ"}, {"type": "subtitle", "time": 3737.75, "timestamp": "01:02:17", "text": "以前は遊んでいたけど、今は触らない"}, {"type": "subtitle", "time": 3744.15, "timestamp": "01:02:24", "text": "私はまだペンタコンIにすら到達していない"}, {"type": "subtitle", "time": 3747.91, "timestamp": "01:02:27", "text": "それ以来ずっと止まっている"}, {"type": "subtitle", "time": 3751.109, "timestamp": "01:02:31", "text": "最後に"}, {"type": "subtitle", "time": 3754.47, "timestamp": "01:02:34", "text": "ダンハン、つまり龍が来たとき"}, {"type": "subtitle", "time": 3757.109, "timestamp": "01:02:37", "text": "キャラクターが今すぐ公開"}, {"type": "subtitle", "time": 3760.95, "timestamp": "01:02:40", "text": "ええ、それ以来、それはルカだと思います"}, {"type": "subtitle", "time": 3763.589, "timestamp": "01:02:43", "text": "ロカか何か、墓、男"}, {"type": "subtitle", "time": 3765.91, "timestamp": "01:02:45", "text": "墓石を持っている人、または"}, {"type": "subtitle", "time": 3768.23, "timestamp": "01:02:48", "text": "彼が出てきたとき、それは"}]
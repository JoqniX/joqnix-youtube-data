[{"type": "subtitle", "time": 1200.23, "timestamp": "00:20:00", "text": "何だって何だって"}, {"type": "subtitle", "time": 1232.87, "timestamp": "00:20:32", "text": "Warframeみたいだ。"}, {"type": "subtitle", "time": 1235.51, "timestamp": "00:20:35", "text": "あなたはボートを1隻も残さなかった。"}, {"type": "subtitle", "time": 1236.95, "timestamp": "00:20:36", "text": "あなたが村にいたとき"}, {"type": "subtitle", "time": 1239.75, "timestamp": "00:20:39", "text": "汚物どもが来たんだろ？もしそれが"}, {"type": "subtitle", "time": 1242.549, "timestamp": "00:20:42", "text": "私のために戻るためではなかった、あなたは"}, {"type": "subtitle", "time": 1244.789, "timestamp": "00:20:44", "text": "彼らと共に逃げ出した。"}, {"type": "subtitle", "time": 1246.71, "timestamp": "00:20:46", "text": "ばかげたことを言うな。あなただって同じことをしたでしょう"}, {"type": "subtitle", "time": 1249.27, "timestamp": "00:20:49", "text": "私にとって。海岸沿いに探してみましょう"}]
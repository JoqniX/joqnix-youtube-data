[{"type": "subtitle", "time": 3125.589, "timestamp": "00:52:05", "text": "ああ、彼女は本当にクールだ。"}, {"type": "subtitle", "time": 3127.51, "timestamp": "00:52:07", "text": "敵に援助を求める。"}, {"type": "subtitle", "time": 3128.069, "timestamp": "00:52:08", "text": "おお、"}, {"type": "subtitle", "time": 3128.63, "timestamp": "00:52:08", "text": "良い。"}, {"type": "subtitle", "time": 3130.23, "timestamp": "00:52:10", "text": "敵を相手にプレイすることもできる。"}, {"type": "subtitle", "time": 3132.15, "timestamp": "00:52:12", "text": "完全に拍手喝采したわけではない。"}, {"type": "subtitle", "time": 3134.79, "timestamp": "00:52:14", "text": "今日は冒険に出かけるの？あなた"}, {"type": "subtitle", "time": 3137.51, "timestamp": "00:52:17", "text": "あなたは私のために舞台を整えてくれた。"}, {"type": "subtitle", "time": 3138.47, "timestamp": "00:52:18", "text": "さあ行こう。"}, {"type": "subtitle", "time": 3140.23, "timestamp": "00:52:20", "text": "ええ、彼女は着ています"}, {"type": "subtitle", "time": 3143.12, "timestamp": "00:52:23", "text": "罪人たちはどこにいるのか？"}, {"type": "subtitle", "time": 3145.99, "timestamp": "00:52:25", "text": "[音楽]"}, {"type": "subtitle", "time": 3147.109, "timestamp": "00:52:27", "text": "これは非常に繊細です"}, {"type": "subtitle", "time": 3148.549, "timestamp": "00:52:28", "text": "アウトサイダー。"}, {"type": "subtitle", "time": 3150.309, "timestamp": "00:52:30", "text": "ああ、ランディ役も演じられるよ。"}, {"type": "subtitle", "time": 3160.39, "timestamp": "00:52:40", "text": "メインキャラのレベルを上げるのが理想的ではないでしょうか？"}, {"type": "subtitle", "time": 3161.99, "timestamp": "00:52:41", "text": "キャラクター？"}, {"type": "subtitle", "time": 3163.51, "timestamp": "00:52:43", "text": "わかりません。私はこれをプレイしたことがない"}, {"type": "subtitle", "time": 3166.15, "timestamp": "00:52:46", "text": "ゲームなので、とても混乱しています。"}, {"type": "subtitle", "time": 3168.71, "timestamp": "00:52:48", "text": "正直に、"}, {"type": "subtitle", "time": 3172.309, "timestamp": "00:52:52", "text": "それならレベルを5にするよ。つまり、"}, {"type": "subtitle", "time": 3174.069, "timestamp": "00:52:54", "text": "急ぐ必要はない"}, {"type": "subtitle", "time": 3176.39, "timestamp": "00:52:56", "text": "本日の"}, {"type": "subtitle", "time": 3178.47, "timestamp": "00:52:58", "text": "右？"}]
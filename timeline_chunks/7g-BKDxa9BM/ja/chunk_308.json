[{"type": "subtitle", "time": 18480.07, "timestamp": "05:08:00", "text": "あなたは誰ですか？あなたとは以前お会いしたことがありません。"}, {"type": "subtitle", "time": 18484.47, "timestamp": "05:08:04", "text": "ああ、あなた。いいえ、違います。わからない。"}, {"type": "subtitle", "time": 18486.948, "timestamp": "05:08:06", "text": "私は何も知りません。近づかないでください"}, {"type": "subtitle", "time": 18487.83, "timestamp": "05:08:07", "text": "私から。"}, {"type": "subtitle", "time": 18491.03, "timestamp": "05:08:11", "text": "部外者の言う通りだった。行方不明のキツネを捜索する"}, {"type": "subtitle", "time": 18494.39, "timestamp": "05:08:14", "text": "かつてここに猟師が住んでいた。"}, {"type": "subtitle", "time": 18494.628, "timestamp": "05:08:14", "text": "おお、"}, {"type": "subtitle", "time": 18503.91, "timestamp": "05:08:23", "text": "ベッドの上に登れるという事実は"}, {"type": "subtitle", "time": 18511.99, "timestamp": "05:08:31", "text": "こんにちは、おかえりなさい。"}, {"type": "subtitle", "time": 18515.03, "timestamp": "05:08:35", "text": "確認しました。クリスタルはここにあります"}, {"type": "subtitle", "time": 18519.19, "timestamp": "05:08:39", "text": "行く。銀貨3,000枚とこの看板と"}, {"type": "subtitle", "time": 18520.788, "timestamp": "05:08:40", "text": "これ"}, {"type": "subtitle", "time": 18521.35, "timestamp": "05:08:41", "text": "ネック。"}, {"type": "subtitle", "time": 18524.15, "timestamp": "05:08:44", "text": "よし、それでは取引成立だ。そして、"}, {"type": "subtitle", "time": 18530.948, "timestamp": "05:08:50", "text": "彼は私を泊まらせてくれないのだろうか"}, {"type": "subtitle", "time": 18533.99, "timestamp": "05:08:53", "text": "家？そこは私の作業場兼工房です"}, {"type": "subtitle", "time": 18537.11, "timestamp": "05:08:57", "text": "そして私のベッドとすべてが"}, {"type": "subtitle", "time": 18539.35, "timestamp": "05:08:59", "text": "オフィスに入ることができなかった。私は"}]
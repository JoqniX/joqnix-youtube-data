[{"type": "subtitle", "time": 22218.47, "timestamp": "06:10:18", "text": "フレイムドロップは攻撃を好みます"}, {"type": "subtitle", "time": 22220.15, "timestamp": "06:10:20", "text": "通過するすべてのターゲットへのダメージと"}, {"type": "subtitle", "time": 22222.708, "timestamp": "06:10:22", "text": "中にはより高いダメージを与えるものもある。"}, {"type": "subtitle", "time": 22225.35, "timestamp": "06:10:25", "text": "地上にあるこれらのものは"}, {"type": "subtitle", "time": 22229.51, "timestamp": "06:10:29", "text": "外部の罠。これは本当にすごいことだ。"}, {"type": "subtitle", "time": 22231.67, "timestamp": "06:10:31", "text": "部外者にそんな才能があるとは知らなかった"}]
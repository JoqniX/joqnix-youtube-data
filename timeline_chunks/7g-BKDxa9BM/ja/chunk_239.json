[{"type": "subtitle", "time": 14340.309, "timestamp": "03:59:00", "text": "確かにそうですね。"}, {"type": "subtitle", "time": 14342.95, "timestamp": "03:59:02", "text": "だから、もし迷子のジェニモンに出くわしたら、"}, {"type": "subtitle", "time": 14345.51, "timestamp": "03:59:05", "text": "おいしいおやつをあげて、"}, {"type": "subtitle", "time": 14346.71, "timestamp": "03:59:06", "text": "あなたについていきます。"}, {"type": "subtitle", "time": 14348.79, "timestamp": "03:59:08", "text": "そうすれば、"}, {"type": "subtitle", "time": 14351.349, "timestamp": "03:59:11", "text": "あの悪質なジェニオンハンターたちめ。"}, {"type": "subtitle", "time": 14353.429, "timestamp": "03:59:13", "text": "そう、悪い精霊ハンターたちだ。"}, {"type": "subtitle", "time": 14356.229, "timestamp": "03:59:16", "text": "精霊ハンターがそう言うなら、私は"}, {"type": "subtitle", "time": 14358.79, "timestamp": "03:59:18", "text": "小さなミニオンが大量の"}, {"type": "subtitle", "time": 14366.15, "timestamp": "03:59:26", "text": "全てを長押しして武器庫を選択します。"}, {"type": "subtitle", "time": 14369.269, "timestamp": "03:59:29", "text": "デートに誘ってくれてるの？"}, {"type": "subtitle", "time": 14376.15, "timestamp": "03:59:36", "text": "アップグレードします。展開する。アップグレードしてください。"}, {"type": "subtitle", "time": 14379.75, "timestamp": "03:59:39", "text": "どう思いますか？おいしい。おいしい。クリーム。"}, {"type": "subtitle", "time": 14381.59, "timestamp": "03:59:41", "text": "わかった。"}]
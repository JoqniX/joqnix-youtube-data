[{"type": "subtitle", "time": 1707.19, "timestamp": "00:28:27", "text": "以前、ここに誰かが住んでいたようだ。"}, {"type": "subtitle", "time": 1707.83, "timestamp": "00:28:27", "text": "これはあなたの"}, {"type": "subtitle", "time": 1715.19, "timestamp": "00:28:35", "text": "ああ、本。"}, {"type": "subtitle", "time": 1720.63, "timestamp": "00:28:40", "text": "はい。"}, {"type": "subtitle", "time": 1724.07, "timestamp": "00:28:44", "text": "いいえ、そこは私たちの家でした。"}, {"type": "subtitle", "time": 1726.549, "timestamp": "00:28:46", "text": "私たちの家？"}, {"type": "subtitle", "time": 1729.269, "timestamp": "00:28:49", "text": "でも、何も覚えていないんです。"}, {"type": "subtitle", "time": 1732.47, "timestamp": "00:28:52", "text": "大丈夫。もしかしたら、それが最善なのかもしれない。"}, {"type": "subtitle", "time": 1734.149, "timestamp": "00:28:54", "text": "メイク・イット・アウトの後。私たちは新しい"}]
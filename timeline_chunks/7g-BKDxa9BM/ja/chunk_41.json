[{"type": "subtitle", "time": 2468.71, "timestamp": "00:41:08", "text": "猫の究極スキル ミラーフレイム"}, {"type": "subtitle", "time": 2472.069, "timestamp": "00:41:12", "text": "共鳴の力に触発された。とても"}, {"type": "subtitle", "time": 2474.39, "timestamp": "00:41:14", "text": "究極のスキルが覚醒した。"}, {"type": "subtitle", "time": 2476.87, "timestamp": "00:41:16", "text": "迫害して釈放する。わかった。終わらせるために"}, {"type": "subtitle", "time": 2478.71, "timestamp": "00:41:18", "text": "究極の肌。わかった、"}, {"type": "subtitle", "time": 2482.15, "timestamp": "00:41:22", "text": "その数字は"}, {"type": "subtitle", "time": 2490.63, "timestamp": "00:41:30", "text": "それは彼女の力ではない。それは共鳴だ。"}, {"type": "subtitle", "time": 2493.589, "timestamp": "00:41:33", "text": "彼女が守ろうとしているあの生意気なガキ。"}, {"type": "subtitle", "time": 2495.91, "timestamp": "00:41:35", "text": "これは電源用の新しいコンセントです"}, {"type": "subtitle", "time": 2499.27, "timestamp": "00:41:39", "text": "共鳴の。考えてみれば、彼女は"}, {"type": "subtitle", "time": 2502.87, "timestamp": "00:41:42", "text": "顔は権力の再出現だった"}, {"type": "subtitle", "time": 2505.51, "timestamp": "00:41:45", "text": "共鳴の。そして"}]
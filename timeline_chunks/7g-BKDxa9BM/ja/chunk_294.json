[{"type": "subtitle", "time": 17641.75, "timestamp": "04:54:01", "text": "A"}, {"type": "subtitle", "time": 17647.03, "timestamp": "04:54:07", "text": "やあ、君はここにいるんだね。"}, {"type": "subtitle", "time": 17648.708, "timestamp": "04:54:08", "text": "この女性は誰ですか？"}, {"type": "subtitle", "time": 17651.43, "timestamp": "04:54:11", "text": "えっと、私の新しい友達です。"}, {"type": "subtitle", "time": 17652.23, "timestamp": "04:54:12", "text": "まあ、そんな感じ。"}, {"type": "subtitle", "time": 17653.83, "timestamp": "04:54:13", "text": "お会いできてうれしいです。"}, {"type": "subtitle", "time": 17655.51, "timestamp": "04:54:15", "text": "大丈夫ですか？"}, {"type": "subtitle", "time": 17658.39, "timestamp": "04:54:18", "text": "大丈夫。元気です。"}, {"type": "subtitle", "time": 17661.43, "timestamp": "04:54:21", "text": "ただのお茶会です。"}, {"type": "subtitle", "time": 17665.67, "timestamp": "04:54:25", "text": "ただの水だよ。手に入れないで"}, {"type": "subtitle", "time": 17667.99, "timestamp": "04:54:27", "text": "どうしたんですか、お嬢さん？"}, {"type": "subtitle", "time": 17671.83, "timestamp": "04:54:31", "text": "何もない。ただケーキは"}, {"type": "subtitle", "time": 17675.83, "timestamp": "04:54:35", "text": "とても甘い、それは私の"}, {"type": "subtitle", "time": 17677.51, "timestamp": "04:54:37", "text": "家族。"}, {"type": "subtitle", "time": 17679.91, "timestamp": "04:54:39", "text": "彼女はよく料理にたくさんの"}, {"type": "subtitle", "time": 17682.708, "timestamp": "04:54:42", "text": "砂糖。私たちが育った島には"}, {"type": "subtitle", "time": 17685.99, "timestamp": "04:54:45", "text": "魚と塩はたっぷりあったが、砂糖は"}, {"type": "subtitle", "time": 17687.59, "timestamp": "04:54:47", "text": "希少性。"}, {"type": "subtitle", "time": 17689.99, "timestamp": "04:54:49", "text": "だから、私たちが小さい頃は、"}, {"type": "subtitle", "time": 17691.99, "timestamp": "04:54:51", "text": "絶対に手に入れなければならない。彼女はまだ数歳です"}, {"type": "subtitle", "time": 17695.03, "timestamp": "04:54:55", "text": "私より年上だが、幼い頃から"}, {"type": "subtitle", "time": 17697.19, "timestamp": "04:54:57", "text": "の助手として働き始めた"}, {"type": "subtitle", "time": 17698.868, "timestamp": "04:54:58", "text": "近隣の漁師。"}, {"type": "subtitle", "time": 17699.43, "timestamp": "04:54:59", "text": "おお。"}]
[{"type": "subtitle", "time": 5761.669, "timestamp": "01:36:01", "text": "男。彼女は本当に素晴らしい。"}, {"type": "subtitle", "time": 5764.229, "timestamp": "01:36:04", "text": "世紀を去る。"}, {"type": "subtitle", "time": 5768.07, "timestamp": "01:36:08", "text": "彼女は自分の店を持っている。一体どういうことだ？彼女"}, {"type": "subtitle", "time": 5775.189, "timestamp": "01:36:15", "text": "お金を使いたいけど、"}, {"type": "subtitle", "time": 5777.59, "timestamp": "01:36:17", "text": "お金を使う。お金を使いたい、"}, {"type": "subtitle", "time": 5779.43, "timestamp": "01:36:19", "text": "でも、お金は使いたくないんです。私は"}, {"type": "subtitle", "time": 5784.47, "timestamp": "01:36:24", "text": "壊れた。正直言って、お金がない。金欠だ。"}, {"type": "subtitle", "time": 5786.31, "timestamp": "01:36:26", "text": "例えば、お金を使うなら、正直"}, {"type": "subtitle", "time": 5790.629, "timestamp": "01:36:30", "text": "率直に言って、私はこれを手に入れたいです。"}, {"type": "subtitle", "time": 5792.79, "timestamp": "01:36:32", "text": "ああ、もしあなたが望まないなら、こうすれば"}, {"type": "subtitle", "time": 5795.75, "timestamp": "01:36:35", "text": "ファームするには、キャラクターを入手するだけでよい"}, {"type": "subtitle", "time": 5797.669, "timestamp": "01:36:37", "text": "ここから。"}, {"type": "subtitle", "time": 5804.79, "timestamp": "01:36:44", "text": "今はただクリスマスが欲しいだけです"}]
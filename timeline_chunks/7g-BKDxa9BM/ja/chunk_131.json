[{"type": "subtitle", "time": 7867.03, "timestamp": "02:11:07", "text": "今すぐモバイルでこのゲームをダウンロードしよう。"}, {"type": "subtitle", "time": 7876.709, "timestamp": "02:11:16", "text": "[音楽]"}, {"type": "subtitle", "time": 7879.99, "timestamp": "02:11:19", "text": "あと、今気づいたことがあるんです。えっと"}, {"type": "subtitle", "time": 7882.95, "timestamp": "02:11:22", "text": "レベッカのベールですよね？これは私に思い出させる"}, {"type": "subtitle", "time": 7886.95, "timestamp": "02:11:26", "text": "私の新しいモデルのベールについて。これと似たような"}, {"type": "subtitle", "time": 7890.229, "timestamp": "02:11:30", "text": "上に王冠を乗せて。"}, {"type": "subtitle", "time": 7896.95, "timestamp": "02:11:36", "text": "上部の部分が心配だ。"}, {"type": "subtitle", "time": 7900.629, "timestamp": "02:11:40", "text": "いいえ、していません。そうだけど、私は2Dだから"}, {"type": "subtitle", "time": 7902.55, "timestamp": "02:11:42", "text": "大丈夫です。 3Dに関しては、私は"}, {"type": "subtitle", "time": 7904.47, "timestamp": "02:11:44", "text": "トップ"}, {"type": "subtitle", "time": 7913.109, "timestamp": "02:11:53", "text": "私はカミレイア・ノ・バラバカを使うかもしれない"}, {"type": "subtitle", "time": 7916.149, "timestamp": "02:11:56", "text": "3Dデザインの参考となるデザイン。"}, {"type": "subtitle", "time": 7918.61, "timestamp": "02:11:58", "text": "本当に良いです。正直に、"}]
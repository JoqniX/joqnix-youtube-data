[{"type": "subtitle", "time": 4681.75, "timestamp": "01:18:01", "text": "凍てつく荒野へ"}, {"type": "subtitle", "time": 4684.229, "timestamp": "01:18:04", "text": "そしてアジア、アジア、中国、韓国"}, {"type": "subtitle", "time": 4686.95, "timestamp": "01:18:06", "text": "おそらく日本と韓国だろう"}, {"type": "chat", "time": 4688.073, "timestamp": "01:18:08", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "hi"}, {"type": "subtitle", "time": 4688.47, "timestamp": "01:18:08", "text": "その辺りの何か"}, {"type": "subtitle", "time": 4691.189, "timestamp": "01:18:11", "text": "香港にサーバーがあるから"}, {"type": "subtitle", "time": 4692.07, "timestamp": "01:18:12", "text": "それは中国向けです"}, {"type": "subtitle", "time": 4696.07, "timestamp": "01:18:16", "text": "私は一体何のためにここに連れてきたのか"}, {"type": "subtitle", "time": 4697.91, "timestamp": "01:18:17", "text": "わからない"}, {"type": "subtitle", "time": 4699.91, "timestamp": "01:18:19", "text": "えーと"}, {"type": "subtitle", "time": 4701.669, "timestamp": "01:18:21", "text": "13番目の地域は直接"}, {"type": "subtitle", "time": 4703.51, "timestamp": "01:18:23", "text": "こんにちはベーコン、ようこそ"}, {"type": "subtitle", "time": 4706.87, "timestamp": "01:18:26", "text": "各州に拠点を置いている。"}, {"type": "subtitle", "time": 4709.27, "timestamp": "01:18:29", "text": "おはよう。"}, {"type": "subtitle", "time": 4712.39, "timestamp": "01:18:32", "text": "そして、おはようございます、ポテトさん。"}, {"type": "subtitle", "time": 4719.11, "timestamp": "01:18:39", "text": "帝都では"}, {"type": "chat", "time": 4719.962, "timestamp": "01:18:39", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "its 11pm sir"}, {"type": "subtitle", "time": 4721.59, "timestamp": "01:18:41", "text": "帝国の精鋭兵士と"}, {"type": "subtitle", "time": 4724.55, "timestamp": "01:18:44", "text": "あらゆる種類の武器庫と"}, {"type": "chat", "time": 4724.991, "timestamp": "01:18:44", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "but good morning"}, {"type": "subtitle", "time": 4726.87, "timestamp": "01:18:46", "text": "想像を絶する兵器。"}, {"type": "chat", "time": 4730.284, "timestamp": "01:18:50", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "mornig patata"}, {"type": "subtitle", "time": 4730.47, "timestamp": "01:18:50", "text": "午後11時です。ごめん。"}, {"type": "subtitle", "time": 4733.99, "timestamp": "01:18:53", "text": "あの場所はこんばんは。燃えるような熱さだ。"}, {"type": "chat", "time": 4734.165, "timestamp": "01:18:54", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "*potato"}, {"type": "subtitle", "time": 4736.79, "timestamp": "01:18:56", "text": "試してみたいなら、どうぞ。"}, {"type": "subtitle", "time": 4738.87, "timestamp": "01:18:58", "text": "あなたは最初でも最後でもない"}]
[{"type": "subtitle", "time": 9182.23, "timestamp": "02:33:02", "text": "あらまあ、そういうこともあるんですね。"}, {"type": "subtitle", "time": 9189.11, "timestamp": "02:33:09", "text": "わかった。わかった、次回は"}, {"type": "subtitle", "time": 9192.95, "timestamp": "02:33:12", "text": "実際にそうしてください。おお、"}, {"type": "subtitle", "time": 9199.83, "timestamp": "02:33:19", "text": "あ、待って。"}, {"type": "subtitle", "time": 9201.349, "timestamp": "02:33:21", "text": "煉獄。"}, {"type": "subtitle", "time": 9209.349, "timestamp": "02:33:29", "text": "[音楽]"}, {"type": "subtitle", "time": 9211.67, "timestamp": "02:33:31", "text": "あのね？ちょっと休憩します"}, {"type": "subtitle", "time": 9213.75, "timestamp": "02:33:33", "text": "しばらくの間。"}, {"type": "subtitle", "time": 9216.389, "timestamp": "02:33:36", "text": "夕食を食べに行きます。ああ、そうだね。"}, {"type": "subtitle", "time": 9220.23, "timestamp": "02:33:40", "text": "朝食を済ませたら、少ししてから来てください。"}, {"type": "subtitle", "time": 9222.07, "timestamp": "02:33:42", "text": "わかった、"}]
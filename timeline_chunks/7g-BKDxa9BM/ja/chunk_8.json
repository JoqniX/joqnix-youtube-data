[{"type": "subtitle", "time": 490.71, "timestamp": "00:08:10", "text": "この男は誰だ？私は手に入れている"}, {"type": "subtitle", "time": 494.55, "timestamp": "00:08:14", "text": "私は砂の中に沈んでいく。"}, {"type": "subtitle", "time": 501.99, "timestamp": "00:08:21", "text": "この脱出は、あの奇妙な出来事によって予兆された。"}, {"type": "subtitle", "time": 504.95, "timestamp": "00:08:24", "text": "夢。私も似たような問題に悩まされてきた"}, {"type": "subtitle", "time": 506.79, "timestamp": "00:08:26", "text": "私の人生すべて。しかし今はその時ではない"}, {"type": "subtitle", "time": 509.029, "timestamp": "00:08:29", "text": "反射。しかし、もっと差し迫った問題がある"}, {"type": "subtitle", "time": 511.189, "timestamp": "00:08:31", "text": "その瞬間。バリーと私は逃げなければならない"}, {"type": "subtitle", "time": 515.11, "timestamp": "00:08:35", "text": "この島は私たちに氷を張っている。かつて私たちが感じた平和"}, {"type": "subtitle", "time": 518.07, "timestamp": "00:08:38", "text": "知っていたが、引き裂かれてしまった"}, {"type": "subtitle", "time": 528.87, "timestamp": "00:08:48", "text": "あの女性は誰ですか？そして、この人は誰ですか？"}, {"type": "subtitle", "time": 531.35, "timestamp": "00:08:51", "text": "水分？"}, {"type": "subtitle", "time": 533.829, "timestamp": "00:08:53", "text": "大丈夫ですか？"}, {"type": "subtitle", "time": 535.75, "timestamp": "00:08:55", "text": "うん。"}, {"type": "subtitle", "time": 538.55, "timestamp": "00:08:58", "text": "もっと寝なさい。私はここを離れません。病気"}]
[{"type": "subtitle", "time": 6070.95, "timestamp": "01:41:10", "text": "ねえ、あなた。そう、君だよ。あそこにいる子供。"}, {"type": "subtitle", "time": 6073.99, "timestamp": "01:41:13", "text": "こんにちは、ハンマーを持ったルナさん。"}, {"type": "subtitle", "time": 6074.709, "timestamp": "01:41:14", "text": "これですか"}, {"type": "subtitle", "time": 6078.47, "timestamp": "01:41:18", "text": "雪にそっくりな女の子？"}, {"type": "subtitle", "time": 6081.109, "timestamp": "01:41:21", "text": "ああ、彼らは兄妹なんですね。"}, {"type": "subtitle", "time": 6083.43, "timestamp": "01:41:23", "text": "待って、あの女の子には口ひげが生えてる。何"}, {"type": "subtitle", "time": 6085.51, "timestamp": "01:41:25", "text": "えっ？"}, {"type": "subtitle", "time": 6089.43, "timestamp": "01:41:29", "text": "誰のことを女の子って呼んでるの？"}, {"type": "subtitle", "time": 6091.669, "timestamp": "01:41:31", "text": "今の若い世代は"}, {"type": "subtitle", "time": 6098.229, "timestamp": "01:41:38", "text": "発言には気をつけた方がいいよ。それでも"}, {"type": "subtitle", "time": 6100.79, "timestamp": "01:41:40", "text": "月人はみんな若く見えるけど、彼女は実際は"}, {"type": "subtitle", "time": 6103.43, "timestamp": "01:41:43", "text": "あなたの曾祖母と同じくらいの年齢です。"}, {"type": "subtitle", "time": 6116.39, "timestamp": "01:41:56", "text": "道徳。"}]
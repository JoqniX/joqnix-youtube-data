[{"type": "subtitle", "time": 16981.19, "timestamp": "04:43:01", "text": "今、私のことを何て呼んだの？なんて失礼な。"}, {"type": "subtitle", "time": 16982.31, "timestamp": "04:43:02", "text": "彼女はこう言う、"}, {"type": "subtitle", "time": 16985.51, "timestamp": "04:43:05", "text": "失礼。正直に言っているだけです。私の心は"}, {"type": "subtitle", "time": 16987.27, "timestamp": "04:43:07", "text": "本物として。"}, {"type": "subtitle", "time": 16990.868, "timestamp": "04:43:10", "text": "覚醒を単に一つの段階とだけ言うつもりはない"}, {"type": "subtitle", "time": 16993.43, "timestamp": "04:43:13", "text": "すべてのカロンが経験する世界"}, {"type": "subtitle", "time": 16994.788, "timestamp": "04:43:14", "text": "目覚めた後。"}, {"type": "subtitle", "time": 16997.19, "timestamp": "04:43:17", "text": "まさにその瞬間だった。"}, {"type": "subtitle", "time": 16999.99, "timestamp": "04:43:19", "text": "以前より体が軽くなったのも当然だ。"}, {"type": "subtitle", "time": 17003.11, "timestamp": "04:43:23", "text": "私の傷は、私の魔法能力に関係している。"}, {"type": "subtitle", "time": 17004.55, "timestamp": "04:43:24", "text": "共振。"}, {"type": "subtitle", "time": 17006.31, "timestamp": "04:43:26", "text": "Wa参照。"}, {"type": "subtitle", "time": 17009.11, "timestamp": "04:43:29", "text": "悪魔は稀だ。だから君たちはラッキーだね"}, {"type": "subtitle", "time": 17012.948, "timestamp": "04:43:32", "text": "アヒル。ほとんどのカロンはそれほど幸運ではない。で"}, {"type": "subtitle", "time": 17015.83, "timestamp": "04:43:35", "text": "最高に良いのは、少しだけ頑丈になることだ。その"}, {"type": "subtitle", "time": 17017.99, "timestamp": "04:43:37", "text": "中には恐ろしいものになるものもあると言われた"}, {"type": "subtitle", "time": 17020.23, "timestamp": "04:43:40", "text": "モンスター、私は見たことがないけれど"}, {"type": "subtitle", "time": 17022.628, "timestamp": "04:43:42", "text": "自分自身。"}, {"type": "subtitle", "time": 17025.27, "timestamp": "04:43:45", "text": "ボタンマッシュルームは大部分を覆っています"}, {"type": "subtitle", "time": 17026.47, "timestamp": "04:43:46", "text": "キノコ。"}, {"type": "subtitle", "time": 17027.59, "timestamp": "04:43:47", "text": "普通の車。"}, {"type": "subtitle", "time": 17028.868, "timestamp": "04:43:48", "text": "彼らはただ試していただけだった。"}, {"type": "subtitle", "time": 17030.55, "timestamp": "04:43:50", "text": "いいえ、"}, {"type": "subtitle", "time": 17032.39, "timestamp": "04:43:52", "text": "私は少し遅れて戻ってきます"}, {"type": "subtitle", "time": 17035.03, "timestamp": "04:43:55", "text": "一人で。しないで"}, {"type": "subtitle", "time": 17038.31, "timestamp": "04:43:58", "text": "はい、わかりました。アウトサイダー。"}]
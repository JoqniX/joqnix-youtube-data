[{"type": "subtitle", "time": 2643.109, "timestamp": "00:44:03", "text": "この力は何の変化ももたらさなかった。"}, {"type": "subtitle", "time": 2646.55, "timestamp": "00:44:06", "text": "私は海に落ちて、二度と目を覚まさないだろう"}, {"type": "subtitle", "time": 2648.47, "timestamp": "00:44:08", "text": "再び立ち上がった。"}, {"type": "subtitle", "time": 2651.51, "timestamp": "00:44:11", "text": "いいえ、見えますよ。"}, {"type": "subtitle", "time": 2653.67, "timestamp": "00:44:13", "text": "あなたの未来。私たちの未来。"}, {"type": "subtitle", "time": 2657.51, "timestamp": "00:44:17", "text": "この粉塵は何ですか？砂。月の砂。"}, {"type": "subtitle", "time": 2659.75, "timestamp": "00:44:19", "text": "誰かがあなたを海から救い出してくれるでしょう"}, {"type": "subtitle", "time": 2660.55, "timestamp": "00:44:20", "text": "水。"}, {"type": "subtitle", "time": 2662.87, "timestamp": "00:44:22", "text": "あなたは言っているのですか"}, {"type": "subtitle", "time": 2664.63, "timestamp": "00:44:24", "text": "私はまだ生きているのか？"}, {"type": "subtitle", "time": 2666.95, "timestamp": "00:44:26", "text": "出発の時間だ。人生は"}, {"type": "subtitle", "time": 2668.95, "timestamp": "00:44:28", "text": "果てしない世界を孤独に旅する"}, {"type": "subtitle", "time": 2670.63, "timestamp": "00:44:30", "text": "夜の闇。"}, {"type": "subtitle", "time": 2673.51, "timestamp": "00:44:33", "text": "わかった。川は涙を流し、溢れ出す"}, {"type": "subtitle", "time": 2676.069, "timestamp": "00:44:36", "text": "土手には、とげのある茂みが"}, {"type": "subtitle", "time": 2678.79, "timestamp": "00:44:38", "text": "両側は、"}, {"type": "subtitle", "time": 2679.99, "timestamp": "00:44:39", "text": "悲しみ。"}, {"type": "subtitle", "time": 2681.589, "timestamp": "00:44:41", "text": "角張ったイチジク。"}, {"type": "subtitle", "time": 2683.91, "timestamp": "00:44:43", "text": "私はあなたを見守り続けるよ、"}, {"type": "subtitle", "time": 2686.87, "timestamp": "00:44:46", "text": "海岸の向こう側を見て、自分がどこにいるか確認する"}, {"type": "subtitle", "time": 2699.03, "timestamp": "00:44:59", "text": "大型ネコ科動物を着陸させる。釣りがあります"}]
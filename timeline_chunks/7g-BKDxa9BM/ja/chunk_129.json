[{"type": "subtitle", "time": 7742.149, "timestamp": "02:09:02", "text": "お金が必要です。誰だってそう思うよね？私は"}, {"type": "subtitle", "time": 7743.589, "timestamp": "02:09:03", "text": "私に莫大な借金をしている人たち。"}, {"type": "subtitle", "time": 7745.43, "timestamp": "02:09:05", "text": "おかえりなさい。"}, {"type": "subtitle", "time": 7747.75, "timestamp": "02:09:07", "text": "それは楽勝だった。私の小さな手下"}, {"type": "subtitle", "time": 7749.109, "timestamp": "02:09:09", "text": "そして私は与えた"}, {"type": "subtitle", "time": 7751.27, "timestamp": "02:09:11", "text": "つまり、あなたが泥棒を捕まえた人だったんですね。"}, {"type": "subtitle", "time": 7753.189, "timestamp": "02:09:13", "text": "スノーが君のことをミニオンって呼んだと思ったのは"}, {"type": "subtitle", "time": 7754.95, "timestamp": "02:09:14", "text": "君は彼女に見つかってしまったんだね。"}, {"type": "subtitle", "time": 7755.75, "timestamp": "02:09:15", "text": "しかし、"}, {"type": "subtitle", "time": 7758.31, "timestamp": "02:09:18", "text": "彼女は私の行いの目撃者だった。あなたは"}, {"type": "subtitle", "time": 7760.629, "timestamp": "02:09:20", "text": "それは全て間違っている。あなたは馬鹿にした"}, {"type": "subtitle", "time": 7763.189, "timestamp": "02:09:23", "text": "今回は自分でやったんでしょう？"}, {"type": "subtitle", "time": 7765.35, "timestamp": "02:09:25", "text": "今言ったこと、すみませんでした。"}, {"type": "subtitle", "time": 7766.39, "timestamp": "02:09:26", "text": "それは私の責任です。わかった。"}, {"type": "subtitle", "time": 7769.51, "timestamp": "02:09:29", "text": "20％の手数料をいただきます。 80%は"}, {"type": "subtitle", "time": 7777.43, "timestamp": "02:09:37", "text": "[音楽]"}]
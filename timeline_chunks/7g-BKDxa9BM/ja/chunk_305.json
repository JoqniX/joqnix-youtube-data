[{"type": "subtitle", "time": 18300.15, "timestamp": "05:05:00", "text": "入って。そして君たち二人は"}, {"type": "subtitle", "time": 18301.67, "timestamp": "05:05:01", "text": "あなたは宿泊関係のことでここに来たのですね。"}, {"type": "subtitle", "time": 18303.51, "timestamp": "05:05:03", "text": "あなたもそうでしょう？"}, {"type": "subtitle", "time": 18307.51, "timestamp": "05:05:07", "text": "心配しないで。本当に"}, {"type": "subtitle", "time": 18311.27, "timestamp": "05:05:11", "text": "それは素晴らしいですが、あの男性はとても"}, {"type": "subtitle", "time": 18312.23, "timestamp": "05:05:12", "text": "共感"}, {"type": "subtitle", "time": 18314.31, "timestamp": "05:05:14", "text": "本当に"}, {"type": "subtitle", "time": 18321.27, "timestamp": "05:05:21", "text": "はい"}, {"type": "subtitle", "time": 18324.948, "timestamp": "05:05:24", "text": "みんな元気？"}, {"type": "subtitle", "time": 18326.23, "timestamp": "05:05:26", "text": "どうしたの"}, {"type": "subtitle", "time": 18329.11, "timestamp": "05:05:29", "text": "ちょっとした病気"}, {"type": "subtitle", "time": 18330.32, "timestamp": "05:05:30", "text": "病気 私は、"}, {"type": "subtitle", "time": 18333.2, "timestamp": "05:05:33", "text": "私は、 ヒュプノス"}, {"type": "subtitle", "time": 18335.6, "timestamp": "05:05:35", "text": "ヒュプノス 出だしからつまづいてしまった。本当に？"}, {"type": "subtitle", "time": 18339.04, "timestamp": "05:05:39", "text": "出だしからつまづいてしまった。本当に？ ヘンリーさん、もしよろしければ"}, {"type": "subtitle", "time": 18341.44, "timestamp": "05:05:41", "text": "ヘンリーさん、もしよろしければ ここで、チェスのヘンリックはほぼ常に"}, {"type": "subtitle", "time": 18344.56, "timestamp": "05:05:44", "text": "ここで、チェスのヘンリックはほぼ常に ここ。"}, {"type": "subtitle", "time": 18346.718, "timestamp": "05:05:46", "text": "ここ。 ヘンリック氏は前回かなり動揺していたようだった。"}, {"type": "subtitle", "time": 18349.68, "timestamp": "05:05:49", "text": "ヘンリック氏は前回かなり動揺していたようだった。 元気です。"}, {"type": "subtitle", "time": 18351.68, "timestamp": "05:05:51", "text": "元気です。 ヘンさん、"}, {"type": "subtitle", "time": 18352.4, "timestamp": "05:05:52", "text": "ヘンさん、 それは良い知らせですね。"}, {"type": "subtitle", "time": 18355.6, "timestamp": "05:05:55", 
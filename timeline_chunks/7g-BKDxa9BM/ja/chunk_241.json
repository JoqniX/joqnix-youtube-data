[{"type": "subtitle", "time": 14465.99, "timestamp": "04:01:05", "text": "ルーマニア、ドリーム、フェザー、OSブレーカー。"}, {"type": "subtitle", "time": 14468.15, "timestamp": "04:01:08", "text": "つまり、私は弓が欲しい、"}, {"type": "subtitle", "time": 14470.15, "timestamp": "04:01:10", "text": "正直に。"}, {"type": "subtitle", "time": 14473.67, "timestamp": "04:01:13", "text": "弓が本当に欲しいんだよ。"}, {"type": "subtitle", "time": 14476.469, "timestamp": "04:01:16", "text": "私は弓のキャラクターが大好きです、弓"}, {"type": "subtitle", "time": 14480.63, "timestamp": "04:01:20", "text": "兵器。つまり、これは弓の活力です。"}, {"type": "subtitle", "time": 14482.95, "timestamp": "04:01:22", "text": "ピンクのリボン。"}, {"type": "subtitle", "time": 14484.55, "timestamp": "04:01:24", "text": "待って、これは実際には私の"}, {"type": "subtitle", "time": 14489.429, "timestamp": "04:01:29", "text": "Jocknの配色のようなキャラクター。"}, {"type": "subtitle", "time": 14491.83, "timestamp": "04:01:31", "text": "それは紫色のリボンですか？私はそうするだろう"}, {"type": "subtitle", "time": 14494.79, "timestamp": "04:01:34", "text": "それ、大好き。ああ、彼らは"}, {"type": "subtitle", "time": 14497.91, "timestamp": "04:01:37", "text": "ランチャーミニガン。"}, {"type": "subtitle", "time": 14516.87, "timestamp": "04:01:56", "text": "[音楽]"}]
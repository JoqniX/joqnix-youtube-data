[{"type": "subtitle", "time": 14161.429, "timestamp": "03:56:01", "text": "パートナー。私たちを救ってくれてありがとう"}, {"type": "subtitle", "time": 14164.15, "timestamp": "03:56:04", "text": "精霊たちを追い払って、それらの精霊を"}, {"type": "subtitle", "time": 14165.269, "timestamp": "03:56:05", "text": "ハンターたち。"}, {"type": "subtitle", "time": 14168.15, "timestamp": "03:56:08", "text": "精霊の男狩り。"}, {"type": "subtitle", "time": 14170.87, "timestamp": "03:56:10", "text": "はい。後ろにいる連中だよ。彼らは通ります"}, {"type": "subtitle", "time": 14173.03, "timestamp": "03:56:13", "text": "名前"}, {"type": "subtitle", "time": 14174.55, "timestamp": "03:56:14", "text": "それは全くかっこよくないですね。"}, {"type": "subtitle", "time": 14176.63, "timestamp": "03:56:16", "text": "帽子の飾りが気に入りました。"}, {"type": "subtitle", "time": 14178.229, "timestamp": "03:56:18", "text": "彼らが見つけられる限りの精霊たち。"}, {"type": "subtitle", "time": 14180.229, "timestamp": "03:56:20", "text": "その物についているリボンを見てください。"}, {"type": "subtitle", "time": 14181.83, "timestamp": "03:56:21", "text": "ゲノンについて。"}, {"type": "subtitle", "time": 14183.99, "timestamp": "03:56:23", "text": "そして、これも。この子、すごく可愛いね。"}, {"type": "subtitle", "time": 14185.75, "timestamp": "03:56:25", "text": "実に様々な種類の生物。"}, {"type": "subtitle", "time": 14187.349, "timestamp": "03:56:27", "text": "見てください"}, {"type": "subtitle", "time": 14190.07, "timestamp": "03:56:30", "text": "ziみたいなもの。ああ、見て。手を振っている"}, {"type": "subtitle", "time": 14193.14, "timestamp": "03:56:33", "text": "あなたの手。おお。"}, {"type": "subtitle", "time": 14194.63, "timestamp": "03:56:34", "text": "[音楽]"}, {"type": "subtitle", "time": 14195.75, "timestamp": "03:56:35", "text": "知恵。わかった。"}, {"type": "subtitle", "time": 14199.03, "timestamp": "03:56:39", "text": "その通り。あなたはそれをとても早く理解しましたね。"}, {"type": "subtitle", "time": 14202.15, "timestamp": "03:56:42", "text": "あなたは本当に頭がいいに違いない。"}, {"type": "subtitle", "time": 14204.63, "timestamp": "03:56:44", "text": "とにかく、私はそれについて本で読んだのですが"}, {"type": "subtitle", "time": 14206.55, "timestamp": "03:56:46", "text": "魔法使いの母親たちは、その力を活用する。"}, {"type": "subtitle", "time": 14209.51, "timestamp": "03:56:49", "text": "ああ、彼女は星のような目をしている"}, {"type": "subtitle", "time": 14213.03, "timestamp": "03:56:53", "text": "さまざまな環境に適応する。"}, {"type": "subtitle", "time": 14215.91, "timestamp": "03:56:55", "text": "例えば、火のそばに近づきすぎると、"}, {"type": "subtitle", "time": 14219.189, "timestamp": "03:56:59", "text": "それらは、香ばしくてふわふわのザピロに変わります。"}]
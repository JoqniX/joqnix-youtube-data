[{"type": "subtitle", "time": 18062.55, "timestamp": "05:01:02", "text": "ダイナミックな探求"}, {"type": "subtitle", "time": 18071.59, "timestamp": "05:01:11", "text": "それが私たちの"}, {"type": "subtitle", "time": 18072.868, "timestamp": "05:01:12", "text": "淑女の船。"}, {"type": "subtitle", "time": 18075.83, "timestamp": "05:01:15", "text": "レディシップ。こんにちは。"}, {"type": "subtitle", "time": 18078.708, "timestamp": "05:01:18", "text": "はじめまして。次。"}]
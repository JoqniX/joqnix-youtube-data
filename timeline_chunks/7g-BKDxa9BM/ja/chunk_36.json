[{"type": "subtitle", "time": 2185.51, "timestamp": "00:36:25", "text": "彼女は誰ですか？"}, {"type": "subtitle", "time": 2187.27, "timestamp": "00:36:27", "text": "私の攻撃に対抗してください。強力な敵"}, {"type": "subtitle", "time": 2190.39, "timestamp": "00:36:30", "text": "戦闘態勢を維持できる"}, {"type": "subtitle", "time": 2192.15, "timestamp": "00:36:32", "text": "攻撃によって弱体化する可能性がある。中には"}, {"type": "subtitle", "time": 2195.91, "timestamp": "00:36:35", "text": "感覚が弱まるとバランス感覚を失う。"}, {"type": "subtitle", "time": 2209.19, "timestamp": "00:36:49", "text": "episはFを押すだけです。"}]
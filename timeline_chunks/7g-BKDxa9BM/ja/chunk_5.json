[{"type": "subtitle", "time": 308.79, "timestamp": "00:05:08", "text": "試合の音が聞こえますか？よし、行こう。"}, {"type": "subtitle", "time": 311.749, "timestamp": "00:05:11", "text": "アジア。私は大丈夫だと思う"}, {"type": "subtitle", "time": 313.35, "timestamp": "00:05:13", "text": "アジアと関係しているんですよね？だって私は"}, {"type": "subtitle", "time": 322.55, "timestamp": "00:05:22", "text": "さあ行こう。私は興奮しています。"}, {"type": "subtitle", "time": 326.55, "timestamp": "00:05:26", "text": "私は興奮しています。 D"}, {"type": "subtitle", "time": 329.029, "timestamp": "00:05:29", "text": "スライド。しゃがんで滑り降りる。通り抜ける"}, {"type": "subtitle", "time": 333.67, "timestamp": "00:05:33", "text": "狭くて低い隙間。わかった。おお。"}, {"type": "subtitle", "time": 341.749, "timestamp": "00:05:41", "text": "この人は誰ですか？私は誰？"}, {"type": "subtitle", "time": 345.51, "timestamp": "00:05:45", "text": "生きたければ、真実を話せ。"}, {"type": "subtitle", "time": 348.71, "timestamp": "00:05:48", "text": "あなたはなぜここにいるのですか？誰があなたと一緒にいるの？"}, {"type": "subtitle", "time": 353.11, "timestamp": "00:05:53", "text": "一体あなたは誰ですか？"}]
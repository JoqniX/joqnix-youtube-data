[{"type": "subtitle", "time": 5280.629, "timestamp": "01:28:00", "text": "どこの出身ですか？"}, {"type": "subtitle", "time": 5284.47, "timestamp": "01:28:04", "text": "あなたの服装は私にとって初めて見るものです。"}, {"type": "subtitle", "time": 5289.83, "timestamp": "01:28:09", "text": "はるか南にある小さな島。"}, {"type": "subtitle", "time": 5291.669, "timestamp": "01:28:11", "text": "南部。"}, {"type": "subtitle", "time": 5293.75, "timestamp": "01:28:13", "text": "私はそれを知っている。"}, {"type": "subtitle", "time": 5295.91, "timestamp": "01:28:15", "text": "ここは4つの場所がある。"}, {"type": "subtitle", "time": 5297.83, "timestamp": "01:28:17", "text": "バックグラウンドミュージックが"}, {"type": "subtitle", "time": 5311.51, "timestamp": "01:28:31", "text": "お腹がすきましたか？"}, {"type": "subtitle", "time": 5314.229, "timestamp": "01:28:34", "text": "何か食べ物を持ってきてあげるよ。正しい"}, {"type": "subtitle", "time": 5316.95, "timestamp": "01:28:36", "text": "戻る。"}, {"type": "subtitle", "time": 5319.75, "timestamp": "01:28:39", "text": "彼女は可愛い。"}, {"type": "subtitle", "time": 5321.43, "timestamp": "01:28:41", "text": "こんな失礼で"}, {"type": "subtitle", "time": 5323.11, "timestamp": "01:28:43", "text": "陰気な宿屋の主人は、とても素敵な"}, {"type": "subtitle", "time": 5326.47, "timestamp": "01:28:46", "text": "そして、彼のために働いている、役に立つ子供？"}, {"type": "subtitle", "time": 5328.95, "timestamp": "01:28:48", "text": "彼女のおかげで、私たちはついに場所を見つけることができました"}, {"type": "subtitle", "time": 5331.83, "timestamp": "01:28:51", "text": "滞在する。少し休憩しましょう。私はかなり"}]
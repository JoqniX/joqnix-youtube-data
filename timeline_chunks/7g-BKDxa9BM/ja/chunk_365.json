[{"type": "subtitle", "time": 21902.15, "timestamp": "06:05:02", "text": "さあ行こう。素早い脱出だった。"}, {"type": "subtitle", "time": 21904.31, "timestamp": "06:05:04", "text": "私は不忠実な者たちを罰する"}, {"type": "subtitle", "time": 21907.27, "timestamp": "06:05:07", "text": "愛する。愛の神の名において"}, {"type": "subtitle", "time": 21909.99, "timestamp": "06:05:09", "text": "昇格することができる。昇格できません。"}, {"type": "subtitle", "time": 21947.51, "timestamp": "06:05:47", "text": "感じる"}, {"type": "subtitle", "time": 21955.19, "timestamp": "06:05:55", "text": "悪い知らせがあって、えーと、"}, {"type": "subtitle", "time": 21957.99, "timestamp": "06:05:57", "text": "もう一つ悪いと思われるもの"}, {"type": "subtitle", "time": 21959.59, "timestamp": "06:05:59", "text": "良い。"}]
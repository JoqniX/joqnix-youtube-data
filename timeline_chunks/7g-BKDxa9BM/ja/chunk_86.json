[{"type": "subtitle", "time": 5165.11, "timestamp": "01:26:05", "text": "私、ヘンリックです。"}, {"type": "subtitle", "time": 5168.149, "timestamp": "01:26:08", "text": "それなら、あなたの好きなようにすればいい。"}, {"type": "subtitle", "time": 5170.87, "timestamp": "01:26:10", "text": "でもたった一晩だけ、"}, {"type": "subtitle", "time": 5171.83, "timestamp": "01:26:11", "text": "朝、"}, {"type": "subtitle", "time": 5174.95, "timestamp": "01:26:14", "text": "あなたは行くべき場所に行かなければなりません。"}, {"type": "subtitle", "time": 5193.27, "timestamp": "01:26:33", "text": "ああ、私はジャンプすることしかできない。登攀禁止"}, {"type": "subtitle", "time": 5196.28, "timestamp": "01:26:36", "text": "このゲームでは、ね？"}, {"type": "subtitle", "time": 5208.55, "timestamp": "01:26:48", "text": "それは残念だ。"}, {"type": "subtitle", "time": 5217.83, "timestamp": "01:26:57", "text": "私たちは。"}]
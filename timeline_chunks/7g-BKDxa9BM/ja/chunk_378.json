[{"type": "subtitle", "time": 22687.99, "timestamp": "06:18:07", "text": "ニース。"}, {"type": "subtitle", "time": 22691.03, "timestamp": "06:18:11", "text": "悪くない。あなたの戦闘スキルは"}, {"type": "subtitle", "time": 22693.27, "timestamp": "06:18:13", "text": "思ったより鋭い。あっという間に"}, {"type": "subtitle", "time": 22696.39, "timestamp": "06:18:16", "text": "あなたは一人前のキツネ猟師になった。"}, {"type": "subtitle", "time": 22700.07, "timestamp": "06:18:20", "text": "今の若い世代には確かに才能がある。"}, {"type": "subtitle", "time": 22703.27, "timestamp": "06:18:23", "text": "日が沈んでいく。さあ行こう。"}, {"type": "subtitle", "time": 22705.83, "timestamp": "06:18:25", "text": "さあ、マッシュルームに会いに行きましょう。私"}, {"type": "subtitle", "time": 22707.35, "timestamp": "06:18:27", "text": "彼女の側で全てがうまくいったかどうか疑問に思う"}, {"type": "subtitle", "time": 22716.868, "timestamp": "06:18:36", "text": "[音楽]"}, {"type": "subtitle", "time": 22722.78, "timestamp": "06:18:42", "text": "M."}, {"type": "subtitle", "time": 22726.15, "timestamp": "06:18:46", "text": "[音楽]"}]
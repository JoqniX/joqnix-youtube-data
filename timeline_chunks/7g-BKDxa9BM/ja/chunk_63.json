[{"type": "subtitle", "time": 3793.19, "timestamp": "01:03:13", "text": "最大レベルはいくつですか？"}, {"type": "subtitle", "time": 3829.99, "timestamp": "01:03:49", "text": "ああ、滑空はできないよ。枯れていない"}, {"type": "subtitle", "time": 3833.91, "timestamp": "01:03:53", "text": "波。忘れた。あるいはブループロトコル。"}, {"type": "subtitle", "time": 3837.51, "timestamp": "01:03:57", "text": "そうそう。滑空できるよ。待って、"}, {"type": "subtitle", "time": 3838.549, "timestamp": "01:03:58", "text": "若干。"}]
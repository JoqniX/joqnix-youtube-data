[{"type": "subtitle", "time": 16760.869, "timestamp": "04:39:20", "text": "それは何ですか？"}, {"type": "subtitle", "time": 16779.75, "timestamp": "04:39:39", "text": "ファンタジアのフラッシュフォワードスキル"}, {"type": "subtitle", "time": 16782.708, "timestamp": "04:39:42", "text": "割り込みQを使用してフラッシュできます"}, {"type": "subtitle", "time": 16785.43, "timestamp": "04:39:45", "text": "影響。"}, {"type": "chat", "time": 16786.601, "timestamp": "04:39:46", "author": "@miko_chann.1", "avatar": "https://yt4.ggpht.com/pA1qKxvA6gJkJo5iacL6MoaaocqRqPaKMbOHlznwOHpCJPPZbIU3_GNZ4faHtUzgYCNGbiZs1w=s64-c-k-c0x00ffffff-no-rj", "message": "genshin effect lolUCkszU2WH9gy1mb0dV-11UJg/KsIfY6LzFoLM6AKanYDQAg"}, {"type": "subtitle", "time": 16787.59, "timestamp": "04:39:47", "text": "えっと、"}, {"type": "subtitle", "time": 16789.67, "timestamp": "04:39:49", "text": "破壊された各パスを完全に破壊する"}, {"type": "subtitle", "time": 16791.99, "timestamp": "04:39:51", "text": "HP製。"}, {"type": "subtitle", "time": 16794.07, "timestamp": "04:39:54", "text": "私はその部品を破壊します。モンスターハンターだ。"}, {"type": "subtitle", "time": 16799.19, "timestamp": "04:39:59", "text": "はい、わかりました。ええと、頭を露出させることができます。"}, {"type": "subtitle", "time": 16799.67, "timestamp": "04:39:59", "text": "わかった。"}]
[{"type": "subtitle", "time": 12000.55, "timestamp": "03:20:00", "text": "サイドクエストはありますか？"}, {"type": "subtitle", "time": 12002.07, "timestamp": "03:20:02", "text": "そうそう。サイドクエストが多すぎる。ニース。"}, {"type": "subtitle", "time": 12005.429, "timestamp": "03:20:05", "text": "ニース。ニース。しかし、そうする必要はありません。"}, {"type": "subtitle", "time": 12007.11, "timestamp": "03:20:07", "text": "モンスター討伐戦が始まった。そうそう。うん。"}, {"type": "subtitle", "time": 12010.87, "timestamp": "03:20:10", "text": "うん。モンスター討伐戦が始まった。そうそう。"}, {"type": "subtitle", "time": 12025.269, "timestamp": "03:20:25", "text": "懸念事項に焦点を当てる。ああ、もう。私はただ"}, {"type": "subtitle", "time": 12027.67, "timestamp": "03:20:27", "text": "チャレンジを完了して、"}, {"type": "subtitle", "time": 12043.75, "timestamp": "03:20:43", "text": "六。六。えっと、"}, {"type": "subtitle", "time": 12048.469, "timestamp": "03:20:48", "text": "今すぐできることは、"}, {"type": "subtitle", "time": 12051.75, "timestamp": "03:20:51", "text": "これをオフにして、DNAに戻れるようにしたいのですが？欲しい"}, {"type": "subtitle", "time": 12054.229, "timestamp": "03:20:54", "text": "DNAに立ち返る。"}]
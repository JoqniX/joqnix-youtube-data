[{"type": "subtitle", "time": 6961.91, "timestamp": "01:56:01", "text": "拳を緩めなさい、心よ。ああ、私は"}, {"type": "subtitle", "time": 6965.83, "timestamp": "01:56:05", "text": "心配。私は理性的に行動します。結局、"}, {"type": "subtitle", "time": 6969.83, "timestamp": "01:56:09", "text": "カミラさんが私のことを保証してくれた。右。"}, {"type": "subtitle", "time": 6972.95, "timestamp": "01:56:12", "text": "アスフィデルはすぐそこです。さあ行こう。"}, {"type": "subtitle", "time": 6993.43, "timestamp": "01:56:33", "text": "ハニー。"}, {"type": "subtitle", "time": 6996.39, "timestamp": "01:56:36", "text": "ハニー、"}, {"type": "subtitle", "time": 7004.8, "timestamp": "01:56:44", "text": "彼女は泣いているのか？"}]
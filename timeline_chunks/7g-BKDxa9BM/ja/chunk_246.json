[{"type": "subtitle", "time": 14769.26, "timestamp": "04:06:09", "text": "おお、"}, {"type": "subtitle", "time": 14778.87, "timestamp": "04:06:18", "text": "どうして彼らは私がここにいることを知ったんだろう？"}, {"type": "subtitle", "time": 14792.95, "timestamp": "04:06:32", "text": "41."}, {"type": "subtitle", "time": 14795.67, "timestamp": "04:06:35", "text": "待てよ、私のダメージは実際には低い。なし"}, {"type": "subtitle", "time": 14802.469, "timestamp": "04:06:42", "text": "何てことだ。私はアップグレードする必要があると思います"}, {"type": "subtitle", "time": 14805.67, "timestamp": "04:06:45", "text": "それでは、登場人物たち。"}]
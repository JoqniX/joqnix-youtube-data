[{"type": "subtitle", "time": 5462.229, "timestamp": "01:31:02", "text": "さあ行こう。"}, {"type": "subtitle", "time": 5466.55, "timestamp": "01:31:06", "text": "そして、ベロニカも手に入れました。ニース。"}, {"type": "subtitle", "time": 5480.229, "timestamp": "01:31:20", "text": "私は実際にレベッカのレベルを上げます。"}, {"type": "subtitle", "time": 5483.59, "timestamp": "01:31:23", "text": "彼女は放置狩りに適していると聞きました。"}, {"type": "subtitle", "time": 5483.669, "timestamp": "01:31:23", "text": "は"}, {"type": "subtitle", "time": 5502.07, "timestamp": "01:31:42", "text": "彼女のロックを完全に解除するかもしれない。私"}, {"type": "subtitle", "time": 5503.99, "timestamp": "01:31:43", "text": "わからない。しかし、ある意味では、私は持っていない"}, {"type": "subtitle", "time": 5507.35, "timestamp": "01:31:47", "text": "急ぐしかないですよね？"}]
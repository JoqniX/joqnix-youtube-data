[{"type": "subtitle", "time": 14221.189, "timestamp": "03:57:01", "text": "暗闇の中に長くいると、"}, {"type": "subtitle", "time": 14223.59, "timestamp": "03:57:03", "text": "彼らは影に隠れてエクイネックスになる"}, {"type": "subtitle", "time": 14224.79, "timestamp": "03:57:04", "text": "周囲に溶け込む。"}, {"type": "subtitle", "time": 14225.429, "timestamp": "03:57:05", "text": "エクイネックス。"}, {"type": "subtitle", "time": 14226.95, "timestamp": "03:57:06", "text": "ほとんどの人はそれがどのように"}, {"type": "subtitle", "time": 14229.83, "timestamp": "03:57:09", "text": "作品。だから彼らはそれが邪悪な魔法だと思っていて"}, {"type": "subtitle", "time": 14232.389, "timestamp": "03:57:12", "text": "彼らを恐れる。"}, {"type": "subtitle", "time": 14233.99, "timestamp": "03:57:13", "text": "しかし、彼らは"}, {"type": "subtitle", "time": 14235.51, "timestamp": "03:57:15", "text": "フォクシー"}, {"type": "subtitle", "time": 14237.99, "timestamp": "03:57:17", "text": "Soのグループの注目を集めた"}, {"type": "subtitle", "time": 14239.51, "timestamp": "03:57:19", "text": "過去数ヶ月間、私はここに滞在していました"}, {"type": "subtitle", "time": 14241.99, "timestamp": "03:57:21", "text": "数日待って、彼らに後悔させてやる"}, {"type": "subtitle", "time": 14244.55, "timestamp": "03:57:24", "text": "彼らの行動。"}, {"type": "subtitle", "time": 14249.189, "timestamp": "03:57:29", "text": "ああ、なるほど。彼らはジェノンを狩り、そしてあなたは"}, {"type": "subtitle", "time": 14250.229, "timestamp": "03:57:30", "text": "彼らを狩れ。"}, {"type": "subtitle", "time": 14251.269, "timestamp": "03:57:31", "text": "天才ハンターハンター。"}, {"type": "subtitle", "time": 14255.11, "timestamp": "03:57:35", "text": "あなたは天才ハンターですか？それは"}, {"type": "subtitle", "time": 14258.309, "timestamp": "03:57:38", "text": "ちょっと長くて言いづらいですね。よし。私にさせて"}, {"type": "subtitle", "time": 14260.87, "timestamp": "03:57:40", "text": "それらに遭遇した場合に備えてください。なぜこれが"}, {"type": "subtitle", "time": 14265.99, "timestamp": "03:57:45", "text": "まだここに座っている人がいるの？怪我をしていますか？"}, {"type": "subtitle", "time": 14269.03, "timestamp": "03:57:49", "text": "さあ、おいしいおやつをどうぞ。"}, {"type": "subtitle", "time": 14272.389, "timestamp": "03:57:52", "text": "大好きです。運が良ければ、開けられます。"}, {"type": "subtitle", "time": 14274.79, "timestamp": "03:57:54", "text": "わかった。"}, {"type": "subtitle", "time": 14278.63, "timestamp": "03:57:58", "text": "ああ、ここに宝箱がある。"}]
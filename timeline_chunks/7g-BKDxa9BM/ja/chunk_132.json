[{"type": "subtitle", "time": 7921.91, "timestamp": "02:12:01", "text": "[音楽]"}, {"type": "subtitle", "time": 7924.229, "timestamp": "02:12:04", "text": "君の最初のライブはとてもスムーズだったし、君は"}, {"type": "subtitle", "time": 7926.87, "timestamp": "02:12:06", "text": "ウェルズとは気が合った。キツネとしてのあなたのキャリア"}, {"type": "subtitle", "time": 7929.27, "timestamp": "02:12:09", "text": "ハンターは出発した。さあ、体を温めるホットドリンクをどうぞ"}, {"type": "subtitle", "time": 7931.83, "timestamp": "02:12:11", "text": "君を起こして。あなたに一つプレゼントしようと思っていたのですが、"}, {"type": "subtitle", "time": 7934.47, "timestamp": "02:12:14", "text": "しかし、ウェルズが提案されているので、"}, {"type": "subtitle", "time": 7935.91, "timestamp": "02:12:15", "text": "彼の蛇口から。"}, {"type": "subtitle", "time": 7939.03, "timestamp": "02:12:19", "text": "わーい。右。私はこれを最後に間違えました"}, {"type": "subtitle", "time": 7943.03, "timestamp": "02:12:23", "text": "泥棒。それは私にできるせめてものことだ。"}, {"type": "subtitle", "time": 7945.35, "timestamp": "02:12:25", "text": "ああ、それから、彼女に私たちの"}, {"type": "subtitle", "time": 7947.83, "timestamp": "02:12:27", "text": "職業。正直に言うと、"}, {"type": "subtitle", "time": 7949.589, "timestamp": "02:12:29", "text": "かなり厳しい。ちょっと見てみました"}, {"type": "subtitle", "time": 7951.99, "timestamp": "02:12:31", "text": "今日の仕事はどれも、報われない仕事ばかりだ。"}, {"type": "subtitle", "time": 7956.709, "timestamp": "02:12:36", "text": "正しい仕事をする。死の石を見つけた。"}, {"type": "subtitle", "time": 7958.629, "timestamp": "02:12:38", "text": "あなたに話しても無駄です。私たちでさえ"}, {"type": "subtitle", "time": 7961.03, "timestamp": "02:12:41", "text": "ベテランは触ろうともしない、ましてや"}, {"type": "subtitle", "time": 7963.83, "timestamp": "02:12:43", "text": "君のような初心者。"}, {"type": "subtitle", "time": 7965.91, "timestamp": "02:12:45", "text": "それは、"}, {"type": "subtitle", "time": 7969.27, "timestamp": "02:12:49", "text": "古い星の結晶。"}, {"type": "subtitle", "time": 7972.39, "timestamp": "02:12:52", "text": "依頼人はヘンリック・エルドレッド氏です。"}, {"type": "subtitle", "time": 7974.87, "timestamp": "02:12:54", "text": "そう、まさにあのヘンリックだよ。"}, {"type": "subtitle", "time": 7978.069, "timestamp": "02:12:58", "text": "グラビン・ピットは今や汚物どもの巣窟だ。 A"}]
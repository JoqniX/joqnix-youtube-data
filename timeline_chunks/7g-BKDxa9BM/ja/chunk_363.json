[{"type": "subtitle", "time": 21794.9, "timestamp": "06:03:14", "text": "これで簡単に"}, {"type": "subtitle", "time": 21828.868, "timestamp": "06:03:48", "text": "フィナーレフレアの起爆装置が露出している。"}, {"type": "subtitle", "time": 21832.23, "timestamp": "06:03:52", "text": "さあ、破壊する時だ。うわあ、まるで私たちが"}, {"type": "subtitle", "time": 21834.708, "timestamp": "06:03:54", "text": "この爆弾を仕掛けたのは私だ。どうしてすべての敵が"}]
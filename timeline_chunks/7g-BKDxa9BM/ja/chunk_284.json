[{"type": "subtitle", "time": 17042.15, "timestamp": "04:44:02", "text": "なんて名前だ。彼は部外者だ。"}, {"type": "subtitle", "time": 17044.07, "timestamp": "04:44:04", "text": "出べそ。"}, {"type": "subtitle", "time": 17047.43, "timestamp": "04:44:07", "text": "アウディのアウトイ。おお、"}, {"type": "subtitle", "time": 17050.948, "timestamp": "04:44:10", "text": "アウディ。私は部外者に新しいあだ名をつけた。"}, {"type": "subtitle", "time": 17052.868, "timestamp": "04:44:12", "text": "アウディ。"}, {"type": "subtitle", "time": 17063.99, "timestamp": "04:44:23", "text": "何が起こっていますか？"}, {"type": "subtitle", "time": 17067.51, "timestamp": "04:44:27", "text": "なぜ動かなくなったのですか？"}]
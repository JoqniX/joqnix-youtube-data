[{"type": "subtitle", "time": 24555.75, "timestamp": "06:49:15", "text": "もう日が暮れている頃だろう。"}, {"type": "subtitle", "time": 24558.548, "timestamp": "06:49:18", "text": "嘆きの湖は"}, {"type": "subtitle", "time": 24560.708, "timestamp": "06:49:20", "text": "いつものように美しい"}, {"type": "subtitle", "time": 24569.11, "timestamp": "06:49:29", "text": "ええ、素晴らしい眺めですね。"}, {"type": "subtitle", "time": 24571.35, "timestamp": "06:49:31", "text": "私と一緒に散歩に行きませんか？"}, {"type": "subtitle", "time": 24580.948, "timestamp": "06:49:40", "text": "[音楽]"}, {"type": "subtitle", "time": 24582.708, "timestamp": "06:49:42", "text": "ああ、胸が高鳴る。"}, {"type": "subtitle", "time": 24587.03, "timestamp": "06:49:47", "text": "ここは雪がかなり積もっている。"}, {"type": "subtitle", "time": 24590.07, "timestamp": "06:49:50", "text": "それでは、先にどうぞ。"}, {"type": "subtitle", "time": 24593.91, "timestamp": "06:49:53", "text": "私もあなたの後を追います。そのように。"}]
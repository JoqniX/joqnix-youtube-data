[{"type": "subtitle", "time": 6900.79, "timestamp": "01:55:00", "text": "魔法を操る者たち。しかし、いつもできるとは限らない"}, {"type": "subtitle", "time": 6903.83, "timestamp": "01:55:03", "text": "我慢しろ。あなたの魔法を使ってみませんか？"}, {"type": "subtitle", "time": 6906.39, "timestamp": "01:55:06", "text": "彼らを泣かせて、"}, {"type": "subtitle", "time": 6907.99, "timestamp": "01:55:07", "text": "赤ちゃん？"}, {"type": "subtitle", "time": 6912.47, "timestamp": "01:55:12", "text": "本当に、腹が立つ。"}, {"type": "subtitle", "time": 6916.709, "timestamp": "01:55:16", "text": "共感。"}, {"type": "subtitle", "time": 6921.35, "timestamp": "01:55:21", "text": "約18～19年前、カロンは"}, {"type": "subtitle", "time": 6924.55, "timestamp": "01:55:24", "text": "かつて帝国は戦争を仕掛けた。"}, {"type": "subtitle", "time": 6927.189, "timestamp": "01:55:27", "text": "私はその頃には生まれていなかったし、人々はめったに"}, {"type": "subtitle", "time": 6929.27, "timestamp": "01:55:29", "text": "それについて話しましょう。"}, {"type": "subtitle", "time": 6931.51, "timestamp": "01:55:31", "text": "あなたのような人はまだ"}, {"type": "subtitle", "time": 6933.27, "timestamp": "01:55:33", "text": "反撃しようと奮闘し、"}, {"type": "subtitle", "time": 6934.47, "timestamp": "01:55:34", "text": "例えば、フォーセイクン、"}, {"type": "subtitle", "time": 6937.189, "timestamp": "01:55:37", "text": "魔法に完全に熟練した者は"}, {"type": "subtitle", "time": 6941.109, "timestamp": "01:55:41", "text": "少数。ほとんどの人にとって、反撃することはあまりにも"}, {"type": "subtitle", "time": 6942.629, "timestamp": "01:55:42", "text": "高価です。"}, {"type": "subtitle", "time": 6944.79, "timestamp": "01:55:44", "text": "自分自身と愛する人を守る"}, {"type": "subtitle", "time": 6947.51, "timestamp": "01:55:47", "text": "生きているということは、すでにあらゆるものを要求している"}, {"type": "subtitle", "time": 6947.91, "timestamp": "01:55:47", "text": "彼らの"}, {"type": "subtitle", "time": 6950.07, "timestamp": "01:55:50", "text": "さて、このNPCは一体誰ですか？彼女は可愛い。"}, {"type": "subtitle", "time": 6953.43, "timestamp": "01:55:53", "text": "先ほどお邪魔して申し訳ありませんでした。私"}, {"type": "subtitle", "time": 6957.75, "timestamp": "01:55:57", "text": "大丈夫です。やっと分かりました。ただ"}]
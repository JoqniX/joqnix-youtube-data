[{"type": "subtitle", "time": 14654.63, "timestamp": "04:04:14", "text": "いや、無理だよ。"}, {"type": "subtitle", "time": 14656.71, "timestamp": "04:04:16", "text": "それはひどい。"}, {"type": "subtitle", "time": 14658.87, "timestamp": "04:04:18", "text": "心配しないでください。"}, {"type": "subtitle", "time": 14661.349, "timestamp": "04:04:21", "text": "ああ、コントローラーが作動した"}, {"type": "subtitle", "time": 14662.07, "timestamp": "04:04:22", "text": "アラーム。"}, {"type": "subtitle", "time": 14663.349, "timestamp": "04:04:23", "text": "いいえ。いいえ。"}, {"type": "subtitle", "time": 14665.429, "timestamp": "04:04:25", "text": "あなたはこうなることを知っていたはずだ。これら"}, {"type": "subtitle", "time": 14667.429, "timestamp": "04:04:27", "text": "男たちは絶望して"}, {"type": "subtitle", "time": 14669.51, "timestamp": "04:04:29", "text": "なぜ彼らはこんなにも殺しにくいのか？"}, {"type": "subtitle", "time": 14671.51, "timestamp": "04:04:31", "text": "手遅れになる前にターゲットを救出しなければならない"}, {"type": "subtitle", "time": 14679.269, "timestamp": "04:04:39", "text": "4点のダメージ。私をからかってるの？"}, {"type": "subtitle", "time": 14681.91, "timestamp": "04:04:41", "text": "私の電力供給が弱いのでしょうか？"}, {"type": "subtitle", "time": 14683.91, "timestamp": "04:04:43", "text": "それは残酷だ。"}, {"type": "subtitle", "time": 14686.229, "timestamp": "04:04:46", "text": "ああ、"}, {"type": "subtitle", "time": 14689.83, "timestamp": "04:04:49", "text": "全員ここにいる。死ね、死ね。死ね、死ね、"}, {"type": "subtitle", "time": 14699.51, "timestamp": "04:04:59", "text": "私はあなたをその土地へ送ります。"}]
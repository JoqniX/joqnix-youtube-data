[{"type": "subtitle", "time": 2701.75, "timestamp": "00:45:01", "text": "このゲーム。もちろんまだ"}, {"type": "subtitle", "time": 2703.51, "timestamp": "00:45:03", "text": "釣り。"}, {"type": "chat", "time": 2715.553, "timestamp": "00:45:15", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "Do you eat eggs?"}, {"type": "subtitle", "time": 2726.63, "timestamp": "00:45:26", "text": "あなたは卵を食べますか？もちろん食べるよ"}, {"type": "subtitle", "time": 2730.47, "timestamp": "00:45:30", "text": "すべて。卵、肉、何でも。"}, {"type": "subtitle", "time": 2731.43, "timestamp": "00:45:31", "text": "制限なし。"}, {"type": "subtitle", "time": 2734.87, "timestamp": "00:45:34", "text": "この州に来たのは初めてです。"}, {"type": "subtitle", "time": 2737.75, "timestamp": "00:45:37", "text": "ここにいる人たちは誰ですか？"}, {"type": "subtitle", "time": 2741.349, "timestamp": "00:45:41", "text": "彼女はこの男が"}, {"type": "subtitle", "time": 2749.109, "timestamp": "00:45:49", "text": "値引き。いくらでも払います"}, {"type": "subtitle", "time": 2752.39, "timestamp": "00:45:52", "text": "そして、あなたがしなければならないことはそれだけです。そうですね、"}, {"type": "subtitle", "time": 2754.309, "timestamp": "00:45:54", "text": "朝飯前だ。"}]
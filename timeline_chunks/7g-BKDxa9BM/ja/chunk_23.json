[{"type": "subtitle", "time": 1380.71, "timestamp": "00:23:00", "text": "素早い胸の動き。右側の2枚のカード"}, {"type": "subtitle", "time": 1382.149, "timestamp": "00:23:02", "text": "ショルダー。"}, {"type": "subtitle", "time": 1389.59, "timestamp": "00:23:09", "text": "これはおかしい。"}, {"type": "subtitle", "time": 1390.63, "timestamp": "00:23:10", "text": "もっと近くで。"}, {"type": "subtitle", "time": 1396.95, "timestamp": "00:23:16", "text": "私は3つの列車を狙うことができる。"}, {"type": "subtitle", "time": 1402.39, "timestamp": "00:23:22", "text": "私は"}, {"type": "subtitle", "time": 1404.47, "timestamp": "00:23:24", "text": "素早い。"}, {"type": "subtitle", "time": 1408.31, "timestamp": "00:23:28", "text": "これは本当に素晴らしい。覚えて"}, {"type": "subtitle", "time": 1410.71, "timestamp": "00:23:30", "text": "3回素早く瞬きすると"}, {"type": "subtitle", "time": 1412.71, "timestamp": "00:23:32", "text": "私はその信号には興味がありません。"}, {"type": "subtitle", "time": 1414.07, "timestamp": "00:23:34", "text": "ああ、それは弾薬だ。"}, {"type": "subtitle", "time": 1416.47, "timestamp": "00:23:36", "text": "とにかく覚えておいてください。"}, {"type": "subtitle", "time": 1438.31, "timestamp": "00:23:58", "text": "今すぐこれらの人たちを育てて"}]
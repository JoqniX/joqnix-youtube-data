[{"type": "subtitle", "time": 11285.11, "timestamp": "03:08:05", "text": "戻ってきました。"}, {"type": "subtitle", "time": 11288.95, "timestamp": "03:08:08", "text": "戻りました。本当に申し訳ないのですが、"}, {"type": "subtitle", "time": 11290.63, "timestamp": "03:08:10", "text": "遅い。"}, {"type": "subtitle", "time": 11293.83, "timestamp": "03:08:13", "text": "アジアではラグが異常にひどい。待って、どうやって"}, {"type": "subtitle", "time": 11296.15, "timestamp": "03:08:16", "text": "動作が遅いかどうか分かりますか？"}, {"type": "subtitle", "time": 11302.87, "timestamp": "03:08:22", "text": "ああ、神様。私はここにいます。"}, {"type": "subtitle", "time": 11306.389, "timestamp": "03:08:26", "text": "皆さん、私はここにいます。"}, {"type": "subtitle", "time": 11327.349, "timestamp": "03:08:47", "text": "わかった、"}, {"type": "subtitle", "time": 11330.71, "timestamp": "03:08:50", "text": "くしゃみが止まらなかった。私は夕食を食べました。"}]
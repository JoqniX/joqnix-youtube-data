[{"type": "subtitle", "time": 17702.55, "timestamp": "04:55:02", "text": "ある時、その漁師はどういうわけか"}, {"type": "subtitle", "time": 17705.19, "timestamp": "04:55:05", "text": "帝国の物資の一部を手に入れ、"}, {"type": "subtitle", "time": 17708.55, "timestamp": "04:55:08", "text": "砂糖の瓶2つを含めて、"}, {"type": "subtitle", "time": 17711.67, "timestamp": "04:55:11", "text": "半月分の給料と引き換えに"}, {"type": "subtitle", "time": 17713.51, "timestamp": "04:55:13", "text": "小さな瓶。"}, {"type": "subtitle", "time": 17714.47, "timestamp": "04:55:14", "text": "おお。"}, {"type": "subtitle", "time": 17716.788, "timestamp": "04:55:16", "text": "彼女が初めて手にしたのは"}, {"type": "subtitle", "time": 17719.11, "timestamp": "04:55:19", "text": "砂糖は一切摂らず、彼女は"}, {"type": "subtitle", "time": 17720.39, "timestamp": "04:55:20", "text": "それを使ってください。"}, {"type": "subtitle", "time": 17722.15, "timestamp": "04:55:22", "text": "それが何かだと知るだけで"}, {"type": "subtitle", "time": 17725.67, "timestamp": "04:55:25", "text": "貴重でおいしい、彼女はそれを注いだ"}, {"type": "subtitle", "time": 17733.19, "timestamp": "04:55:33", "text": "私たちが成長して"}, {"type": "subtitle", "time": 17736.15, "timestamp": "04:55:36", "text": "収入が増えたので、砂糖はそれほど贅沢品ではなくなった。"}, {"type": "subtitle", "time": 17736.948, "timestamp": "04:55:36", "text": "もう。"}, {"type": "subtitle", "time": 17740.47, "timestamp": "04:55:40", "text": "うわあ、それはひどい話ですね。"}, {"type": "subtitle", "time": 17744.07, "timestamp": "04:55:44", "text": "あの甘ったるい匂いが、今にも漂ってきそうだ。"}, {"type": "subtitle", "time": 17744.788, "timestamp": "04:55:44", "text": "何てことだ。"}, {"type": "subtitle", "time": 17746.15, "timestamp": "04:55:46", "text": "彼女はあなたに謝罪すべきだ。"}, {"type": "subtitle", "time": 17747.59, "timestamp": "04:55:47", "text": "どうやって匂いを嗅ぎ分けられるの？"}, {"type": "subtitle", "time": 17749.59, "timestamp": "04:55:49", "text": "彼女は砂糖と5分の1を支払う義務がある"}, {"type": "subtitle", "time": 17751.75, "timestamp": "04:55:51", "text": "謝罪。"}, {"type": "subtitle", "time": 17754.628, "timestamp": "04:55:54", "text": "部外者じゃない、君がいないんだ。私は信じている"}, {"type": "subtitle", "time": 17757.27, "timestamp": "04:55:57", "text": "いつも砂糖をたくさん使う女性"}]
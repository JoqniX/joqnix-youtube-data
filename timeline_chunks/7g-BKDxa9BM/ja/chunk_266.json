[{"type": "subtitle", "time": 15987.75, "timestamp": "04:26:27", "text": "プシュケ。何？私は、"}, {"type": "subtitle", "time": 15988.87, "timestamp": "04:26:28", "text": "君のやり方だよ。"}, {"type": "subtitle", "time": 15990.55, "timestamp": "04:26:30", "text": "雪は道を知っている。"}, {"type": "subtitle", "time": 15992.63, "timestamp": "04:26:32", "text": "ガンド"}, {"type": "subtitle", "time": 15995.03, "timestamp": "04:26:35", "text": "部外者は簡単に道に迷ってしまう"}, {"type": "subtitle", "time": 15995.67, "timestamp": "04:26:35", "text": "そこには。"}, {"type": "subtitle", "time": 15997.75, "timestamp": "04:26:37", "text": "あなたには借りがある。わかった、"}, {"type": "subtitle", "time": 15999.349, "timestamp": "04:26:39", "text": "実は。"}, {"type": "subtitle", "time": 16003.53, "timestamp": "04:26:43", "text": "わかった。出発する"}, {"type": "subtitle", "time": 16011.03, "timestamp": "04:26:51", "text": "しばらく外出していませんでした"}, {"type": "subtitle", "time": 16015.269, "timestamp": "04:26:55", "text": "都市の。雪に覆われた針葉樹"}, {"type": "subtitle", "time": 16017.51, "timestamp": "04:26:57", "text": "ヘビを見つけた"}, {"type": "subtitle", "time": 16019.51, "timestamp": "04:26:59", "text": "山々の頂上は"}]
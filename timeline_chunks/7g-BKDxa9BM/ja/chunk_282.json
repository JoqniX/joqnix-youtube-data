[{"type": "subtitle", "time": 16921.51, "timestamp": "04:42:01", "text": "あなたは自分の小さなグループで指示を出します。"}, {"type": "subtitle", "time": 16922.55, "timestamp": "04:42:02", "text": "右？"}, {"type": "subtitle", "time": 16925.75, "timestamp": "04:42:05", "text": "教えてください、なぜあなたたちは全員私に会いに行ったのですか"}, {"type": "subtitle", "time": 16929.27, "timestamp": "04:42:09", "text": "知ってた？なるほど、それは理にかなっている。私は"}, {"type": "subtitle", "time": 16931.91, "timestamp": "04:42:11", "text": "少し時間をいただいて、説明させてください。彼らは"}, {"type": "subtitle", "time": 16934.15, "timestamp": "04:42:14", "text": "今夜空いてますか？ご安心ください。"}, {"type": "subtitle", "time": 16936.31, "timestamp": "04:42:16", "text": "あなたは何をしているの？"}, {"type": "subtitle", "time": 16938.31, "timestamp": "04:42:18", "text": "これらのパックを見てください。もし"}, {"type": "subtitle", "time": 16940.31, "timestamp": "04:42:20", "text": "この怪物、その飼い主は"}, {"type": "subtitle", "time": 16941.91, "timestamp": "04:42:21", "text": "アスフォデルでくつろぎながら、飲み物を飲んでいる。"}, {"type": "subtitle", "time": 16943.83, "timestamp": "04:42:23", "text": "そして、お互いの体験談を語り合う。私は自分が"}, {"type": "subtitle", "time": 16945.19, "timestamp": "04:42:25", "text": "それらを識別して返却することができます"}, {"type": "subtitle", "time": 16946.948, "timestamp": "04:42:26", "text": "家族に持ち帰るもの。感謝"}, {"type": "subtitle", "time": 16948.788, "timestamp": "04:42:28", "text": "ああ、侵入してきたのはあなたたち悪魔だったのか"}, {"type": "subtitle", "time": 16949.91, "timestamp": "04:42:29", "text": "今日。"}, {"type": "subtitle", "time": 16951.43, "timestamp": "04:42:31", "text": "ダム。"}, {"type": "subtitle", "time": 16953.43, "timestamp": "04:42:33", "text": "皆さん、彼らは結局"}, {"type": "subtitle", "time": 16955.51, "timestamp": "04:42:35", "text": "彼らのように。"}, {"type": "subtitle", "time": 16957.91, "timestamp": "04:42:37", "text": "悪魔。"}, {"type": "subtitle", "time": 16959.35, "timestamp": "04:42:39", "text": "手術を受けたキャロン"}, {"type": "subtitle", "time": 16961.67, "timestamp": "04:42:41", "text": "目覚めて特別な力を得た"}, {"type": "subtitle", "time": 16963.27, "timestamp": "04:42:43", "text": "私たち。"}, {"type": "subtitle", "time": 16964.55, "timestamp": "04:42:44", "text": "おお、"}, {"type": "subtitle", "time": 16966.15, "timestamp": "04:42:46", "text": "どうしてあなたは新米のように何も知らないの？"}, {"type": "subtitle", "time": 16968.788, "timestamp": "04:42:48", "text": "孵化したウズラ？きっとその小さな"}, {"type": "subtitle", "time": 16970.708, "timestamp": "04:42:50", "text": "あなたの隣にある白いマッシュルームは"}, {"type": "subtitle", "time": 16973.51, "timestamp": "04:42:53", "text": "知らされた。"}, {"type": "subtitle", "time": 16977.67, "timestamp": "04:42:57", "text": "もちろん、スノーは本当に頭がいい。待って、"}]
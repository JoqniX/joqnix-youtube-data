[{"type": "subtitle", "time": 15781.349, "timestamp": "04:23:01", "text": "えーと、もう一つ、"}, {"type": "subtitle", "time": 15784.07, "timestamp": "04:23:04", "text": "探検する。"}, {"type": "subtitle", "time": 15787.429, "timestamp": "04:23:07", "text": "すべてのテレポートポイントを取得できますか？"}, {"type": "subtitle", "time": 15792.469, "timestamp": "04:23:12", "text": "こんな風に苦労して来る必要はないのでは？"}, {"type": "subtitle", "time": 15800.07, "timestamp": "04:23:20", "text": "ああ、しまった。"}, {"type": "subtitle", "time": 15817.349, "timestamp": "04:23:37", "text": "H."}, {"type": "subtitle", "time": 15832.149, "timestamp": "04:23:52", "text": "気のせいだろうか、それとも私はここに閉じ込められているのだろうか？"}, {"type": "subtitle", "time": 15839.189, "timestamp": "04:23:59", "text": "はい、そうです。私は。私は。私は。来て。"}]
[{"type": "subtitle", "time": 16867.19, "timestamp": "04:41:07", "text": "先取りなんてものはない。"}, {"type": "subtitle", "time": 16867.99, "timestamp": "04:41:07", "text": "がある。そして"}, {"type": "subtitle", "time": 16871.43, "timestamp": "04:41:11", "text": "あなた、ここに来たばかりですよね？誰かが"}, {"type": "subtitle", "time": 16873.11, "timestamp": "04:41:13", "text": "あなたにこの教訓を教えるために。そしてそれは"}, {"type": "subtitle", "time": 16875.67, "timestamp": "04:41:15", "text": "たまたま今日は私がその「誰か」だったというだけだ。"}, {"type": "subtitle", "time": 16877.67, "timestamp": "04:41:17", "text": "このクリスタルを授業料と考えてください。"}, {"type": "subtitle", "time": 16878.15, "timestamp": "04:41:18", "text": "私たちは？"}, {"type": "subtitle", "time": 16879.59, "timestamp": "04:41:19", "text": "学費。"}, {"type": "subtitle", "time": 16881.51, "timestamp": "04:41:21", "text": "返してください。"}, {"type": "subtitle", "time": 16884.39, "timestamp": "04:41:24", "text": "そのクリスタルは彼女にとって重要であり、"}, {"type": "subtitle", "time": 16889.43, "timestamp": "04:41:29", "text": "道徳。"}, {"type": "subtitle", "time": 16891.35, "timestamp": "04:41:31", "text": "あなたが理性的であることを拒否するので"}, {"type": "subtitle", "time": 16895.11, "timestamp": "04:41:35", "text": "あなた、この会話はこれで終わりです。"}, {"type": "subtitle", "time": 16896.708, "timestamp": "04:41:36", "text": "うん。"}, {"type": "subtitle", "time": 16899.99, "timestamp": "04:41:39", "text": "落ち着いて、坊や。怒らないで。"}, {"type": "subtitle", "time": 16902.55, "timestamp": "04:41:42", "text": "その意気だ。来て。おっと、落ち着いて"}, {"type": "subtitle", "time": 16904.15, "timestamp": "04:41:44", "text": "下。探す必要はありません"}, {"type": "subtitle", "time": 16905.91, "timestamp": "04:41:45", "text": "5050. どこにもない。"}, {"type": "subtitle", "time": 16907.27, "timestamp": "04:41:47", "text": "少し熱が出ました。"}, {"type": "subtitle", "time": 16908.47, "timestamp": "04:41:48", "text": "もちろん。"}, {"type": "subtitle", "time": 16910.07, "timestamp": "04:41:50", "text": "心配ない。"}, {"type": "subtitle", "time": 16911.43, "timestamp": "04:41:51", "text": "知らなくて申し訳ありません。"}, {"type": "subtitle", "time": 16914.708, "timestamp": "04:41:54", "text": "何？持続する。たとえそれが大丈夫だとしても。"}, {"type": "subtitle", "time": 16919.19, "timestamp": "04:41:59", "text": "メガ、このずる賢いミュータントはミュータントになろうとしている。"}, {"type": "subtitle", "time": 16919.99, "timestamp": "04:41:59", "text": "何てことだ。"}]
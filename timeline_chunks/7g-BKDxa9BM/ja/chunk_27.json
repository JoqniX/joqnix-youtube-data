[{"type": "subtitle", "time": 1646.95, "timestamp": "00:27:26", "text": "くしゃみが出ていたので、ミュートにしました。うん、"}, {"type": "subtitle", "time": 1649.75, "timestamp": "00:27:29", "text": "ロックを解除するためのメカニズム"}, {"type": "subtitle", "time": 1650.23, "timestamp": "00:27:30", "text": "死んだ"}, {"type": "subtitle", "time": 1652.149, "timestamp": "00:27:32", "text": "鍵屋の仕事みたいだ。それは素晴らしいですね。"}, {"type": "subtitle", "time": 1653.83, "timestamp": "00:27:33", "text": "誰かが彼と喧嘩したみたいだ"}, {"type": "subtitle", "time": 1655.269, "timestamp": "00:27:35", "text": "私たちが到着する前に。"}, {"type": "subtitle", "time": 1657.75, "timestamp": "00:27:37", "text": "村人の誰かだろうか？"}, {"type": "subtitle", "time": 1660.789, "timestamp": "00:27:40", "text": "いいえ、私たちが最初にその扉を開けたのです。"}, {"type": "subtitle", "time": 1663.909, "timestamp": "00:27:43", "text": "とにかく、あの人のおかげで、私たちは"}, {"type": "subtitle", "time": 1665.59, "timestamp": "00:27:45", "text": "これらの汚物に対処しなければならない"}, {"type": "subtitle", "time": 1666.95, "timestamp": "00:27:46", "text": "私たち自身。"}, {"type": "subtitle", "time": 1669.11, "timestamp": "00:27:49", "text": "誰であろうと、彼らは"}]
[{"type": "subtitle", "time": 5641.11, "timestamp": "01:34:01", "text": "アーティファイ・ファイアPTSD。大丈夫。それは"}, {"type": "subtitle", "time": 5644.229, "timestamp": "01:34:04", "text": "農業ゲーム。つまり、あなたは、ああ、それで私は"}, {"type": "subtitle", "time": 5647.189, "timestamp": "01:34:07", "text": "これらのキャラクターを無料で入手するには"}, {"type": "subtitle", "time": 5650.149, "timestamp": "01:34:10", "text": "クエストをこなす時、私はレベルアップしている。手に入れます"}, {"type": "subtitle", "time": 5651.91, "timestamp": "01:34:11", "text": "トリュフを無料で。私がそうするときに手に入れます"}, {"type": "subtitle", "time": 5656.07, "timestamp": "01:34:16", "text": "そのクエストで、彼を無料で手に入れるよ。"}, {"type": "subtitle", "time": 5659.91, "timestamp": "01:34:19", "text": "部外者は無料、耳の聞こえない人は無料、"}, {"type": "subtitle", "time": 5670.149, "timestamp": "01:34:30", "text": "武器関連のアイテムは無料で手に入ります。おお、"}, {"type": "subtitle", "time": 5677.189, "timestamp": "01:34:37", "text": "必要なものがすべてわかります"}, {"type": "subtitle", "time": 5679.51, "timestamp": "01:34:39", "text": "挽く。グラインドに必要なアイテム数はいくつですか？"}]
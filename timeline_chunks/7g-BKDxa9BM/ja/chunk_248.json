[{"type": "subtitle", "time": 14881.429, "timestamp": "04:08:01", "text": "男たちは絶望して"}, {"type": "subtitle", "time": 14882.87, "timestamp": "04:08:02", "text": "ターゲットを実行します。"}, {"type": "subtitle", "time": 14883.59, "timestamp": "04:08:03", "text": "兄弟、"}, {"type": "subtitle", "time": 14885.59, "timestamp": "04:08:05", "text": "手遅れになる前にターゲットを救出しなければならない"}, {"type": "subtitle", "time": 14887.83, "timestamp": "04:08:07", "text": "遅い。"}, {"type": "subtitle", "time": 14890.309, "timestamp": "04:08:10", "text": "わかった、"}, {"type": "subtitle", "time": 14902.63, "timestamp": "04:08:22", "text": "私から離れてください。"}, {"type": "subtitle", "time": 14905.51, "timestamp": "04:08:25", "text": "慌てないで。私たちはキツネ狩りをする者です。だった"}, {"type": "subtitle", "time": 14908.389, "timestamp": "04:08:28", "text": "あなたを救うためにここにいます。"}, {"type": "subtitle", "time": 14911.269, "timestamp": "04:08:31", "text": "ああ、わかった。彼らがあなたを派遣したに違いない"}, {"type": "subtitle", "time": 14914.229, "timestamp": "04:08:34", "text": "ここ。ありがとう。ここから出よう"}, {"type": "chat", "time": 14922.537, "timestamp": "04:08:42", "author": "@miko_chann.1", "avatar": "https://yt4.ggpht.com/pA1qKxvA6gJkJo5iacL6MoaaocqRqPaKMbOHlznwOHpCJPPZbIU3_GNZ4faHtUzgYCNGbiZs1w=s64-c-k-c0x00ffffff-no-rj", "message": "haiiii JOQ"}]
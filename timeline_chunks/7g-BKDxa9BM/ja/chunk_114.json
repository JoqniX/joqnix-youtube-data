[{"type": "subtitle", "time": 6840.87, "timestamp": "01:54:00", "text": "あるいは、私たちが「はい」であるということでしょうか。"}, {"type": "subtitle", "time": 6843.43, "timestamp": "01:54:03", "text": "ここハイペロレイアで？"}, {"type": "subtitle", "time": 6848.149, "timestamp": "01:54:08", "text": "我々カロン族だが、我々の独特な外見"}, {"type": "subtitle", "time": 6851.51, "timestamp": "01:54:11", "text": "ソラスとは異なる。"}, {"type": "subtitle", "time": 6855.91, "timestamp": "01:54:15", "text": "彼らは私たちのことを悪魔の子とさえ呼ぶ。"}, {"type": "subtitle", "time": 6857.43, "timestamp": "01:54:17", "text": "おお、"}, {"type": "subtitle", "time": 6860.47, "timestamp": "01:54:20", "text": "そういえば、人間が"}, {"type": "subtitle", "time": 6862.87, "timestamp": "01:54:22", "text": "悪魔や子供などの話をする、"}, {"type": "subtitle", "time": 6865.91, "timestamp": "01:54:25", "text": "そして魔法は、いつも汚いものを与える"}, {"type": "subtitle", "time": 6872.31, "timestamp": "01:54:32", "text": "ありがとう、スノー。しかし事実は変わらない。"}, {"type": "subtitle", "time": 6875.75, "timestamp": "01:54:35", "text": "私たちはここでは歓迎されていない。あの兵士が戻ってきた"}, {"type": "subtitle", "time": 6878.95, "timestamp": "01:54:38", "text": "そこには。このような行為を行った後でも"}, {"type": "subtitle", "time": 6881.589, "timestamp": "01:54:41", "text": "残虐な行為、私たちが見た唯一の"}, {"type": "subtitle", "time": 6884.229, "timestamp": "01:54:44", "text": "偶発的なミスは数多くあります。彼らはただ"}, {"type": "subtitle", "time": 6887.109, "timestamp": "01:54:47", "text": "カオンズが"}, {"type": "subtitle", "time": 6889.109, "timestamp": "01:54:49", "text": "都心部への立ち入りは許可されていません"}, {"type": "subtitle", "time": 6892.149, "timestamp": "01:54:52", "text": "氷の湖の。"}, {"type": "subtitle", "time": 6894.47, "timestamp": "01:54:54", "text": "これはなぜこうなっているのかという疑問を生じさせます。の"}, {"type": "subtitle", "time": 6896.47, "timestamp": "01:54:56", "text": "ヒュペロレイアのソレルたち。"}, {"type": "subtitle", "time": 6898.39, "timestamp": "01:54:58", "text": "魔法は邪悪な魔術師である"}]
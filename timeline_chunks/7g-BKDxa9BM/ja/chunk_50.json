[{"type": "subtitle", "time": 3002.069, "timestamp": "00:50:02", "text": "ニース。キャラクターを配置する。設定する"}, {"type": "subtitle", "time": 3005.349, "timestamp": "00:50:05", "text": "近接武器。新たに手に入れた武器。"}, {"type": "subtitle", "time": 3010.23, "timestamp": "00:50:10", "text": "属性情報装備アップグレード。"}, {"type": "subtitle", "time": 3012.47, "timestamp": "00:50:12", "text": "おお。"}, {"type": "subtitle", "time": 3015.75, "timestamp": "00:50:15", "text": "わかりました、アップグレードはすべてお渡しします。"}, {"type": "subtitle", "time": 3019.27, "timestamp": "00:50:19", "text": "よし、レベル5だ。ニース。"}, {"type": "subtitle", "time": 3022.309, "timestamp": "00:50:22", "text": "遠距離武器。ああ、なんてことだ、"}, {"type": "subtitle", "time": 3038.069, "timestamp": "00:50:38", "text": "ああ、ツイン・デ・ツイン・ガンがある。そこには"}, {"type": "subtitle", "time": 3042.39, "timestamp": "00:50:42", "text": "かっこいい銃とかがいっぱいある。したい"}, {"type": "subtitle", "time": 3054.15, "timestamp": "00:50:54", "text": "おお。すごくかっこいい。ああ、あれですね。おお、"}]
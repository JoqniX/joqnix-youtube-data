[{"type": "subtitle", "time": 2523.03, "timestamp": "00:42:03", "text": "頑張って。見つけた。"}, {"type": "subtitle", "time": 2525.43, "timestamp": "00:42:05", "text": "いいえ。いいえ。"}, {"type": "subtitle", "time": 2527.27, "timestamp": "00:42:07", "text": "あ、待って。"}, {"type": "subtitle", "time": 2529.99, "timestamp": "00:42:09", "text": "諦めろ。ゼロ番。"}, {"type": "subtitle", "time": 2532.71, "timestamp": "00:42:12", "text": "どんなに頑丈な刃物にも、それは備わっている。"}, {"type": "subtitle", "time": 2536.55, "timestamp": "00:42:16", "text": "だめだ。だめだ。だめだ、だめだ、だめだ。彼女を外さないで"}, {"type": "subtitle", "time": 2541.109, "timestamp": "00:42:21", "text": "アーム。どうか、とても気にかけてください"}, {"type": "subtitle", "time": 2542.87, "timestamp": "00:42:22", "text": "さもなければ彼女は"}, {"type": "subtitle", "time": 2549.27, "timestamp": "00:42:29", "text": "私も一緒に戻ります。でも、"}, {"type": "subtitle", "time": 2551.99, "timestamp": "00:42:31", "text": "彼女を解放すると約束する。"}, {"type": "subtitle", "time": 2555.27, "timestamp": "00:42:35", "text": "約束してくれ、さもなければ2つ持って行け"}, {"type": "subtitle", "time": 2557.109, "timestamp": "00:42:37", "text": "死体が戻ってきた。"}, {"type": "subtitle", "time": 2560.79, "timestamp": "00:42:40", "text": "私の説明が分かりにくかったかもしれません。"}, {"type": "subtitle", "time": 2563.03, "timestamp": "00:42:43", "text": "これは交渉ではない。"}, {"type": "subtitle", "time": 2570.39, "timestamp": "00:42:50", "text": "いや、いや、いや。"}, {"type": "subtitle", "time": 2573.99, "timestamp": "00:42:53", "text": "出て行け。"}]
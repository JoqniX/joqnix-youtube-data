[{"type": "subtitle", "time": 23778.23, "timestamp": "06:36:18", "text": "私の名前は"}, {"type": "subtitle", "time": 23792.788, "timestamp": "06:36:32", "text": "よし、彼は帰る。"}, {"type": "subtitle", "time": 23794.788, "timestamp": "06:36:34", "text": "彼がそこにいる。"}, {"type": "subtitle", "time": 23798.31, "timestamp": "06:36:38", "text": "お二人に何かお飲み物はいかがですか？"}, {"type": "subtitle", "time": 23801.27, "timestamp": "06:36:41", "text": "ああ、大丈夫です。まあ、"}, {"type": "subtitle", "time": 23805.35, "timestamp": "06:36:45", "text": "結構です、と答えます。いくつかあります"}, {"type": "subtitle", "time": 23806.948, "timestamp": "06:36:46", "text": "植物に聞いてみよう。"}, {"type": "subtitle", "time": 23810.868, "timestamp": "06:36:50", "text": "私の名前はアニーです。"}]
[{"type": "subtitle", "time": 17760.788, "timestamp": "04:56:00", "text": "彼はまた、偉大なマジシャンでもあった。だから私たちの"}, {"type": "subtitle", "time": 17763.51, "timestamp": "04:56:03", "text": "ゲストの目、彼女に関するすべて"}, {"type": "subtitle", "time": 17765.75, "timestamp": "04:56:05", "text": "素晴らしかった。たとえ"}, {"type": "subtitle", "time": 17768.07, "timestamp": "04:56:08", "text": "わかった、フェヌスが言うことなら何でも。"}, {"type": "subtitle", "time": 17768.708, "timestamp": "04:56:08", "text": "私たちは知っています。"}, {"type": "subtitle", "time": 17769.19, "timestamp": "04:56:09", "text": "それで"}, {"type": "subtitle", "time": 17771.75, "timestamp": "04:56:11", "text": "私たちは離れ離れになり、お互いを見失ってしまった。"}, {"type": "subtitle", "time": 17776.708, "timestamp": "04:56:16", "text": "昨日だったか、あるいはもっと前だったかもしれない。私は違います"}, {"type": "subtitle", "time": 17779.91, "timestamp": "04:56:19", "text": "それなら、家族のために彼女を見つけなければなりません"}, {"type": "subtitle", "time": 17783.43, "timestamp": "04:56:23", "text": "花や木々、雪や風のように。"}, {"type": "subtitle", "time": 17788.23, "timestamp": "04:56:28", "text": "ええ、私は本当に部外者です。お金が必要です"}, {"type": "subtitle", "time": 17791.03, "timestamp": "04:56:31", "text": "宿泊施設、情報収集、"}, {"type": "subtitle", "time": 17793.51, "timestamp": "04:56:33", "text": "そして、私が必要とする場合に備えていくらか余分に取っておく"}, {"type": "subtitle", "time": 17795.19, "timestamp": "04:56:35", "text": "すぐに出発する"}, {"type": "subtitle", "time": 17797.43, "timestamp": "04:56:37", "text": "フィナ、もう寝る時間だよ。"}, {"type": "subtitle", "time": 17798.39, "timestamp": "04:56:38", "text": "他にもあります"}, {"type": "subtitle", "time": 17800.868, "timestamp": "04:56:40", "text": "それでは、おやすみなさい。おやすみ。"}, {"type": "subtitle", "time": 17802.788, "timestamp": "04:56:42", "text": "彼女の青い髪が大好きだ。見てください"}, {"type": "subtitle", "time": 17807.19, "timestamp": "04:56:47", "text": "彼女の髪飾り。すごく可愛いですね。"}, {"type": "subtitle", "time": 17815.19, "timestamp": "04:56:55", "text": "何か盗めるものはある？寝てもいいですか？"}, {"type": "subtitle", "time": 17819.99, "timestamp": "04:56:59", "text": "ベッド？いいえ。こんにちは、フィナ。"}]
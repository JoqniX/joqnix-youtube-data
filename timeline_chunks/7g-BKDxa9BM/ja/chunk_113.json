[{"type": "subtitle", "time": 6780.709, "timestamp": "01:53:00", "text": "いいえ、"}, {"type": "subtitle", "time": 6786.79, "timestamp": "01:53:06", "text": "何見てんだよ、このちびっ子"}, {"type": "subtitle", "time": 6789.35, "timestamp": "01:53:09", "text": "ちびっ子？"}, {"type": "subtitle", "time": 6791.75, "timestamp": "01:53:11", "text": "あなたは私にとって厄介な存在ではなくなった。"}, {"type": "subtitle", "time": 6798.629, "timestamp": "01:53:18", "text": "父親。"}, {"type": "subtitle", "time": 6819.589, "timestamp": "01:53:39", "text": "彼らは殺した"}, {"type": "subtitle", "time": 6821.83, "timestamp": "01:53:41", "text": "彼らは少年を殺した。何？"}, {"type": "subtitle", "time": 6823.27, "timestamp": "01:53:43", "text": "行きましょう。"}, {"type": "subtitle", "time": 6824.229, "timestamp": "01:53:44", "text": "何？"}, {"type": "subtitle", "time": 6825.83, "timestamp": "01:53:45", "text": "重要なことがあります"}, {"type": "subtitle", "time": 6826.95, "timestamp": "01:53:46", "text": "知る。"}, {"type": "subtitle", "time": 6830.87, "timestamp": "01:53:50", "text": "遠くから来た方は、"}, {"type": "subtitle", "time": 6832.39, "timestamp": "01:53:52", "text": "もしサラリアンがいたらどうなる？"}, {"type": "subtitle", "time": 6833.27, "timestamp": "01:53:53", "text": "サラリアン？"}, {"type": "subtitle", "time": 6836.07, "timestamp": "01:53:56", "text": "角のないやつってこと？"}]
[{"type": "subtitle", "time": 18243.51, "timestamp": "05:04:03", "text": "[音楽]"}, {"type": "subtitle", "time": 18245.67, "timestamp": "05:04:05", "text": "こっそり調べてみます。"}, {"type": "subtitle", "time": 18250.628, "timestamp": "05:04:10", "text": "あなたの髪に小さな花がピンで留められているのを見てください。"}, {"type": "subtitle", "time": 18258.15, "timestamp": "05:04:18", "text": "プシュケ、"}, {"type": "subtitle", "time": 18261.11, "timestamp": "05:04:21", "text": "ここで何をしているの？ヘンリック氏は"}, {"type": "subtitle", "time": 18263.11, "timestamp": "05:04:23", "text": "これについて知っていますか？ここで待っていられますか？"}, {"type": "subtitle", "time": 18266.948, "timestamp": "05:04:26", "text": "アリサ、ちょっと待ってくれる？私は"}, {"type": "subtitle", "time": 18270.47, "timestamp": "05:04:30", "text": "二階に上がってプシュケと話をする。何が"}, {"type": "subtitle", "time": 18272.708, "timestamp": "05:04:32", "text": "これ？"}, {"type": "subtitle", "time": 18275.67, "timestamp": "05:04:35", "text": "あなたは誰ですか？こんにちは。"}, {"type": "subtitle", "time": 18297.83, "timestamp": "05:04:57", "text": "ヘンリック氏は部外者が"}]
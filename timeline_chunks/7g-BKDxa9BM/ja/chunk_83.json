[{"type": "subtitle", "time": 4989.99, "timestamp": "01:23:09", "text": "カミラ・スカーレットさんは、"}, {"type": "subtitle", "time": 4992.55, "timestamp": "01:23:12", "text": "ここで揺れる。"}, {"type": "subtitle", "time": 4995.59, "timestamp": "01:23:15", "text": "彼女を利用できるかもしれない。そしてここ"}, {"type": "subtitle", "time": 5005.43, "timestamp": "01:23:25", "text": "ああ、くしゃみが止まらない。とても痛い。"}, {"type": "subtitle", "time": 5008.31, "timestamp": "01:23:28", "text": "私は純白の救世主です。悪魔、"}, {"type": "subtitle", "time": 5010.87, "timestamp": "01:23:30", "text": "光の王。彼らに祝福あれ。まあ、これは"}, {"type": "subtitle", "time": 5013.27, "timestamp": "01:23:33", "text": "人"}, {"type": "subtitle", "time": 5026.95, "timestamp": "01:23:46", "text": "保持する。"}, {"type": "subtitle", "time": 5029.03, "timestamp": "01:23:49", "text": "カミラ・スカーレットさんは私にこう言いました"}, {"type": "subtitle", "time": 5031.59, "timestamp": "01:23:51", "text": "この場所。私はここに滞在したいと思っていました"}]
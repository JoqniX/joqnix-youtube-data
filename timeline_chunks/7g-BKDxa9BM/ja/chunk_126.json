[{"type": "subtitle", "time": 7563.589, "timestamp": "02:06:03", "text": "捕獲後、保持する。"}, {"type": "subtitle", "time": 7565.75, "timestamp": "02:06:05", "text": "それはスノーを過小評価したからだ"}, {"type": "subtitle", "time": 7569.589, "timestamp": "02:06:09", "text": "手下。これで、私たちが何を持っているかお分かりいただけたでしょう。"}, {"type": "subtitle", "time": 7572.39, "timestamp": "02:06:12", "text": "よし。よし。はい、お金です。"}, {"type": "subtitle", "time": 7577.03, "timestamp": "02:06:17", "text": "あなたは飢えている。何だと思う？すべて"}, {"type": "subtitle", "time": 7579.27, "timestamp": "02:06:19", "text": "これはどうでしょう？"}, {"type": "subtitle", "time": 7581.669, "timestamp": "02:06:21", "text": "えっと"}, {"type": "subtitle", "time": 7583.03, "timestamp": "02:06:23", "text": "わかった。"}, {"type": "subtitle", "time": 7583.83, "timestamp": "02:06:23", "text": "彼は何をしているの？"}, {"type": "subtitle", "time": 7589.75, "timestamp": "02:06:29", "text": "何かが短剣を弾き飛ばした。"}, {"type": "subtitle", "time": 7592.149, "timestamp": "02:06:32", "text": "覚えておいてください、時には獣が"}, {"type": "subtitle", "time": 7594.709, "timestamp": "02:06:34", "text": "腹部に弱みは見られない。"}, {"type": "subtitle", "time": 7597.83, "timestamp": "02:06:37", "text": "罠を仕掛ける。野生のように、都市の"}, {"type": "subtitle", "time": 7599.03, "timestamp": "02:06:39", "text": "獣で溢れかえっている"}, {"type": "subtitle", "time": 7602.47, "timestamp": "02:06:42", "text": "ああ、カミラさん、"}, {"type": "subtitle", "time": 7604.39, "timestamp": "02:06:44", "text": "アイスまでここまで来たのだから"}, {"type": "subtitle", "time": 7606.629, "timestamp": "02:06:46", "text": "湖よ、君に会うのは残念だ"}, {"type": "subtitle", "time": 7607.189, "timestamp": "02:06:47", "text": "おお、"}, {"type": "subtitle", "time": 7609.589, "timestamp": "02:06:49", "text": "何か大物が来たのかと思った。結局"}, {"type": "subtitle", "time": 7611.99, "timestamp": "02:06:51", "text": "それはただの居酒屋で、老鶏を飼っているだけだ。"}, {"type": "subtitle", "time": 7619.589, "timestamp": "02:06:59", "text": "私たちは私たちのやり方であなたを扱います。あなたに教える"}]
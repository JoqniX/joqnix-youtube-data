[{"type": "subtitle", "time": 11705.83, "timestamp": "03:15:05", "text": "それにはちゃんとした理由がある。私"}, {"type": "subtitle", "time": 11707.83, "timestamp": "03:15:07", "text": "今は、"}, {"type": "subtitle", "time": 11709.91, "timestamp": "03:15:09", "text": "心の平安。"}, {"type": "subtitle", "time": 11713.19, "timestamp": "03:15:13", "text": "私はただ日々のタスクを終わらせたいだけです。"}, {"type": "subtitle", "time": 11716.07, "timestamp": "03:15:16", "text": "夜にまた来てやります。"}, {"type": "subtitle", "time": 11719.75, "timestamp": "03:15:19", "text": "わかった。だから、私は"}, {"type": "subtitle", "time": 11722.07, "timestamp": "03:15:22", "text": "Blue Protocol の演奏を観に来る人"}, {"type": "subtitle", "time": 11724.71, "timestamp": "03:15:24", "text": "次の10分間。本当に申し訳ありません。私"}, {"type": "subtitle", "time": 11728.229, "timestamp": "03:15:28", "text": "今すぐ謝罪します。"}, {"type": "subtitle", "time": 11730.07, "timestamp": "03:15:30", "text": "でも、私はただ自分のことをしたいだけです"}, {"type": "subtitle", "time": 11731.59, "timestamp": "03:15:31", "text": "日刊紙。昨日はできませんでした。私"}, {"type": "subtitle", "time": 11734.55, "timestamp": "03:15:34", "text": "昨日は6時間働いていました。"}, {"type": "subtitle", "time": 11737.269, "timestamp": "03:15:37", "text": "右。私たちは7時間配信していました"}, {"type": "subtitle", "time": 11738.79, "timestamp": "03:15:38", "text": "昨日。"}, {"type": "subtitle", "time": 11742.469, "timestamp": "03:15:42", "text": "忘れないで。 H. わかりました。私は接続します"}]
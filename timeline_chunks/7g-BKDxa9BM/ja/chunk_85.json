[{"type": "subtitle", "time": 5100.39, "timestamp": "01:25:00", "text": "ヘンリックさん、ただいま。"}, {"type": "subtitle", "time": 5102.55, "timestamp": "01:25:02", "text": "さっきまた家を片付けたんだけど"}, {"type": "subtitle", "time": 5105.43, "timestamp": "01:25:05", "text": "準備は万端です。"}, {"type": "subtitle", "time": 5106.81, "timestamp": "01:25:06", "text": "気をつけて。"}, {"type": "subtitle", "time": 5108.31, "timestamp": "01:25:08", "text": "[音楽]"}, {"type": "subtitle", "time": 5110.229, "timestamp": "01:25:10", "text": "この女性は誰ですか？"}, {"type": "subtitle", "time": 5115.27, "timestamp": "01:25:15", "text": "あなたは新しい下宿人ですか？"}, {"type": "subtitle", "time": 5118.95, "timestamp": "01:25:18", "text": "彼女は探しているように見える"}, {"type": "subtitle", "time": 5121.99, "timestamp": "01:25:21", "text": "私は彼女を追い出そうとしていた。"}, {"type": "subtitle", "time": 5124.229, "timestamp": "01:25:24", "text": "イダー。"}, {"type": "subtitle", "time": 5127.35, "timestamp": "01:25:27", "text": "でも、彼女を追い出したら、彼女は"}, {"type": "subtitle", "time": 5128.31, "timestamp": "01:25:28", "text": "ホームレス？"}, {"type": "subtitle", "time": 5130.39, "timestamp": "01:25:30", "text": "その通り。ホームレスになりたくない。"}, {"type": "subtitle", "time": 5139.43, "timestamp": "01:25:39", "text": "しかし、その家はまだ売れていない。"}, {"type": "subtitle", "time": 5141.75, "timestamp": "01:25:41", "text": "一晩だけ彼女に貸しても"}, {"type": "subtitle", "time": 5144.47, "timestamp": "01:25:44", "text": "痛いよね？"}, {"type": "subtitle", "time": 5147.189, "timestamp": "01:25:47", "text": "彼女は返済できる時に返済してくれるでしょう。それ"}, {"type": "subtitle", "time": 5149.669, "timestamp": "01:25:49", "text": "方法によっては、少し余分にお金が手に入る"}, {"type": "subtitle", "time": 5152.79, "timestamp": "01:25:52", "text": "基本的に何もない。"}, {"type": "subtitle", "time": 5155.669, "timestamp": "01:25:55", "text": "あなたが皆にそんなに冷たくし続けるなら、"}, {"type": "subtitle", "time": 5157.27, "timestamp": "01:25:57", "text": "そんなもの、絶対に買い手は見つからないよ"}, {"type": "subtitle", "time": 5159.59, "timestamp": "01:25:59", "text": "場所。"}]
[{"type": "subtitle", "time": 18362.08, "timestamp": "05:06:02", "text": "何かを隠している。ヘンリック氏は もうすぐ出てくるよ。あなたは去ろうとしている"}, {"type": "subtitle", "time": 18363.6, "timestamp": "05:06:03", "text": "もうすぐ出てくるよ。あなたは去ろうとしている すでに。はい、これとこれを持って行ってください。"}, {"type": "subtitle", "time": 18367.2, "timestamp": "05:06:07", "text": "すでに。はい、これとこれを持って行ってください。 母はいつも花を持って"}, {"type": "subtitle", "time": 18369.52, "timestamp": "05:06:09", "text": "母はいつも花を持って 情報収集に良い機会となる"}, {"type": "subtitle", "time": 18371.92, "timestamp": "05:06:11", "text": "情報収集に良い機会となる 階下。"}, {"type": "subtitle", "time": 18373.52, "timestamp": "05:06:13", "text": "階下。 うん、"}, {"type": "subtitle", "time": 18383.03, "timestamp": "05:06:23", "text": "私はこれらの本を集めます。私は"}, {"type": "subtitle", "time": 18386.23, "timestamp": "05:06:26", "text": "もうここにはいない。それで、"}, {"type": "subtitle", "time": 18388.23, "timestamp": "05:06:28", "text": "集められるものは何でも集めます"}, {"type": "subtitle", "time": 18394.39, "timestamp": "05:06:34", "text": "私は完璧主義者だから。だから私は"}, {"type": "subtitle", "time": 18396.628, "timestamp": "05:06:36", "text": "すべての実績を獲得する"}, {"type": "subtitle", "time": 18414.868, "timestamp": "05:06:54", "text": "H"}, {"type": "subtitle", "time": 18417.83, "timestamp": "05:06:57", "text": "そのドアには触らないでください。オフィスは閉まっています"}]
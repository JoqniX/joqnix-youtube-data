[{"type": "subtitle", "time": 20185.99, "timestamp": "05:36:25", "text": "何てことだ。波に何度乗れるかな"}, {"type": "subtitle", "time": 20194.47, "timestamp": "05:36:34", "text": "くそ、6波もやってしまった。"}, {"type": "subtitle", "time": 20196.628, "timestamp": "05:36:36", "text": "私は不忠実な者たちを罰する"}, {"type": "subtitle", "time": 20201.03, "timestamp": "05:36:41", "text": "愛の神の名において愛する。"}, {"type": "subtitle", "time": 20203.67, "timestamp": "05:36:43", "text": "あれはクレイジーだった"}]
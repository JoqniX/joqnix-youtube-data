[{"type": "subtitle", "time": 3240.79, "timestamp": "00:54:00", "text": "すべて、雪は"}, {"type": "subtitle", "time": 3252.95, "timestamp": "00:54:12", "text": "私は彼女を愛している。"}, {"type": "subtitle", "time": 3256.309, "timestamp": "00:54:16", "text": "彼はただ「うん、ただ」と言っているだけです"}, {"type": "subtitle", "time": 3262.63, "timestamp": "00:54:22", "text": "ボン。"}, {"type": "subtitle", "time": 3264.71, "timestamp": "00:54:24", "text": "ああ、もうこの件からは手を引きます。"}, {"type": "subtitle", "time": 3266.23, "timestamp": "00:54:26", "text": "誰かがちょっと"}, {"type": "subtitle", "time": 3268.47, "timestamp": "00:54:28", "text": "事故で、さらに"}, {"type": "subtitle", "time": 3276.47, "timestamp": "00:54:36", "text": "奴らを倒せて本当に良かった。"}, {"type": "subtitle", "time": 3279.03, "timestamp": "00:54:39", "text": "ああ、ラシッド、転倒させてくれてありがとう。えっと、"}, {"type": "subtitle", "time": 3280.95, "timestamp": "00:54:40", "text": "ラチェット"}, {"type": "subtitle", "time": 3289.589, "timestamp": "00:54:49", "text": "だってそれが"}, {"type": "subtitle", "time": 3291.99, "timestamp": "00:54:51", "text": "いずれにしても、あの運転については心配していた。"}, {"type": "subtitle", "time": 3294.069, "timestamp": "00:54:54", "text": "それが私に勧められた方法です。"}, {"type": "subtitle", "time": 3296.5, "timestamp": "00:54:56", "text": "質問。"}, {"type": "subtitle", "time": 3298.39, "timestamp": "00:54:58", "text": "[音楽]"}]
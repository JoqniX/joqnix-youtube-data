[{"type": "subtitle", "time": 4621.43, "timestamp": "01:17:01", "text": "日本から100人が見に来ると予想していた。"}, {"type": "subtitle", "time": 4623.59, "timestamp": "01:17:03", "text": "ええ、今はアジアにいます。"}, {"type": "subtitle", "time": 4625.03, "timestamp": "01:17:05", "text": "今が絶好の機会だ。"}, {"type": "subtitle", "time": 4626.79, "timestamp": "01:17:06", "text": "日本ではゆったりとしたペースで走るんですよね？"}, {"type": "subtitle", "time": 4630.39, "timestamp": "01:17:10", "text": "よし。あなたを連れてきたので、"}, {"type": "subtitle", "time": 4630.95, "timestamp": "01:17:10", "text": "大丈夫です。"}, {"type": "subtitle", "time": 4633.43, "timestamp": "01:17:13", "text": "私は自分の酒場に戻らなければならない。"}, {"type": "subtitle", "time": 4641.43, "timestamp": "01:17:21", "text": "ちょっと待って。それなら手早くやれ。時間"}, {"type": "subtitle", "time": 4642.63, "timestamp": "01:17:22", "text": "それは商人にとってのお金です。"}, {"type": "subtitle", "time": 4656.55, "timestamp": "01:17:36", "text": "はい。昨日の真っ暗闇の中で"}, {"type": "subtitle", "time": 4659.189, "timestamp": "01:17:39", "text": "風の強い夕方。"}, {"type": "subtitle", "time": 4661.669, "timestamp": "01:17:41", "text": "フードを被った白いマントの男"}, {"type": "subtitle", "time": 4663.27, "timestamp": "01:17:43", "text": "カミラと取引をしてあなたを見つけます"}, {"type": "subtitle", "time": 4665.11, "timestamp": "01:17:45", "text": "そしてあなたを連れ出す あなたは何を覚えていますか"}, {"type": "subtitle", "time": 4665.669, "timestamp": "01:17:45", "text": "この地図？"}, {"type": "subtitle", "time": 4667.59, "timestamp": "01:17:47", "text": "彼は頭からつま先まで覆われていた。"}, {"type": "subtitle", "time": 4671.59, "timestamp": "01:17:51", "text": "私には全く分かりません。"}, {"type": "subtitle", "time": 4673.59, "timestamp": "01:17:53", "text": "なんとも不思議だ。"}, {"type": "subtitle", "time": 4675.83, "timestamp": "01:17:55", "text": "謎の恩人"}, {"type": "subtitle", "time": 4677.99, "timestamp": "01:17:57", "text": "誰かがあなたを塩水の中から救い出してくれるでしょう"}, {"type": "subtitle", "time": 4679.59, "timestamp": "01:17:59", "text": "水"}]
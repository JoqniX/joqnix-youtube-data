[{"type": "subtitle", "time": 11880.309, "timestamp": "03:18:00", "text": "えっと、私はただこうするだけです"}, {"type": "subtitle", "time": 11900.469, "timestamp": "03:18:20", "text": "モジュールとアップ。"}, {"type": "subtitle", "time": 11903.59, "timestamp": "03:18:23", "text": "それは承知しています。ただ、私は"}, {"type": "subtitle", "time": 11927.99, "timestamp": "03:18:47", "text": "もっと安く手に入れられるか見てみよう"}, {"type": "subtitle", "time": 11930.71, "timestamp": "03:18:50", "text": "価格。"}]
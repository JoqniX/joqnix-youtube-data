[{"type": "subtitle", "time": 7621.669, "timestamp": "02:07:01", "text": "おそらくあなたが欠落している人生の教訓は少ない"}, {"type": "subtitle", "time": 7623.03, "timestamp": "02:07:03", "text": "母は決してそうしなかった。"}, {"type": "subtitle", "time": 7625.189, "timestamp": "02:07:05", "text": "私の母を巻き込まないで。手放す"}, {"type": "subtitle", "time": 7627.189, "timestamp": "02:07:07", "text": "自分。卑劣なハッカーめ。"}, {"type": "subtitle", "time": 7628.709, "timestamp": "02:07:08", "text": "魔女。"}, {"type": "subtitle", "time": 7631.43, "timestamp": "02:07:11", "text": "ああ、彼は彼に電話したんだ。彼女を老婆と呼んだ。"}, {"type": "subtitle", "time": 7632.79, "timestamp": "02:07:12", "text": "彼を保安局へ連れて行け。"}, {"type": "subtitle", "time": 7633.43, "timestamp": "02:07:13", "text": "真っ直ぐ。"}, {"type": "subtitle", "time": 7636.149, "timestamp": "02:07:16", "text": "何？いいえ。"}, {"type": "subtitle", "time": 7638.47, "timestamp": "02:07:18", "text": "いいえ。お願いします。"}, {"type": "subtitle", "time": 7640.069, "timestamp": "02:07:20", "text": "私は帰ります。永久に氷に覆われた湖。"}, {"type": "subtitle", "time": 7642.149, "timestamp": "02:07:22", "text": "カミラさん。彼に何かあったの？"}, {"type": "subtitle", "time": 7644.95, "timestamp": "02:07:24", "text": "下がっていろ。彼は、"}, {"type": "subtitle", "time": 7647.43, "timestamp": "02:07:27", "text": "彼は見た。とにかく、マーギーはもしあなたが"}, {"type": "subtitle", "time": 7648.39, "timestamp": "02:07:28", "text": "依然として"}, {"type": "subtitle", "time": 7651.589, "timestamp": "02:07:31", "text": "お願いだから、私を解放して。"}, {"type": "subtitle", "time": 7652.709, "timestamp": "02:07:32", "text": "あれは奇妙だった。"}, {"type": "subtitle", "time": 7654.95, "timestamp": "02:07:34", "text": "なぜ私はパニックになったのだろう？カミラが恋しかった"}, {"type": "subtitle", "time": 7657.91, "timestamp": "02:07:37", "text": "そしてあの泥棒もだ。見た目のように震えている"}, {"type": "subtitle", "time": 7661.03, "timestamp": "02:07:41", "text": "彼はこれから大変な目に遭いそうだ。"}, {"type": "subtitle", "time": 7662.87, "timestamp": "02:07:42", "text": "危うく忘れるところだった。ありがとう。"}, {"type": "subtitle", "time": 7664.87, "timestamp": "02:07:44", "text": "ああ、報告書を受け取ったよ。"}, {"type": "subtitle", "time": 7667.35, "timestamp": "02:07:47", "text": "さて、これからこれらのコインを分配しなくてはならない。"}, {"type": "subtitle", "time": 7669.91, "timestamp": "02:07:49", "text": "私は普段、あちこちで買い物をします。"}, {"type": "subtitle", "time": 7675.27, "timestamp": "02:07:55", "text": "私たちは戻るのか、それとも"}, {"type": "subtitle", "time": 7676.79, "timestamp": "02:07:56", "text": "スラム街？"}]
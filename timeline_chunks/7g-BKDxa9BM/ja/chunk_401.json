[{"type": "subtitle", "time": 24062.788, "timestamp": "06:41:02", "text": "プシュケが危険な状況にあるということですか？"}, {"type": "subtitle", "time": 24065.27, "timestamp": "06:41:05", "text": "彼が行方不明になった後、そのリストに載っていた。私"}, {"type": "subtitle", "time": 24067.51, "timestamp": "06:41:07", "text": "彼の身に良い結末が訪れなかったのではないかと心配だ。"}, {"type": "subtitle", "time": 24069.35, "timestamp": "06:41:09", "text": "そして、あなたの友人のプシュケが心配している"}, {"type": "subtitle", "time": 24069.99, "timestamp": "06:41:09", "text": "次は私だ。"}, {"type": "subtitle", "time": 24073.03, "timestamp": "06:41:13", "text": "なんてこった。"}, {"type": "subtitle", "time": 24076.07, "timestamp": "06:41:16", "text": "ヘンリックは最悪のタイミングで戻ってきた。もし私が"}, {"type": "subtitle", "time": 24078.07, "timestamp": "06:41:18", "text": "あと数分です。"}, {"type": "subtitle", "time": 24080.628, "timestamp": "06:41:20", "text": "これからどうすればいいのでしょうか？"}, {"type": "subtitle", "time": 24081.43, "timestamp": "06:41:21", "text": "私は"}, {"type": "subtitle", "time": 24083.35, "timestamp": "06:41:23", "text": "焦ってはいけません。"}, {"type": "subtitle", "time": 24088.23, "timestamp": "06:41:28", "text": "いいえ、行動を起こす方が常に良いのです。"}, {"type": "subtitle", "time": 24090.948, "timestamp": "06:41:30", "text": "ただそこに立ち尽くして、彼女を見つめるしかない"}, {"type": "subtitle", "time": 24092.15, "timestamp": "06:41:32", "text": "離れる。"}, {"type": "subtitle", "time": 24093.19, "timestamp": "06:41:33", "text": "どうして分かったの？"}, {"type": "subtitle", "time": 24095.67, "timestamp": "06:41:35", "text": "あくまで推測です。あなたはかなり動揺しているようですね。"}, {"type": "subtitle", "time": 24097.19, "timestamp": "06:41:37", "text": "あらゆる注意と留保を捨てて"}, {"type": "subtitle", "time": 24098.868, "timestamp": "06:41:38", "text": "突然風が吹いた。"}, {"type": "subtitle", "time": 24101.43, "timestamp": "06:41:41", "text": "異国の地に放り込まれた状況を想像してみてください。"}, {"type": "subtitle", "time": 24102.15, "timestamp": "06:41:42", "text": "たった一人ぼっち。"}, {"type": "subtitle", "time": 24102.788, "timestamp": "06:41:42", "text": "これは何ですか？"}, {"type": "subtitle", "time": 24105.91, "timestamp": "06:41:45", "text": "誰からも必要とされていない、無力だと感じる。それから"}, {"type": "subtitle", "time": 24108.07, "timestamp": "06:41:48", "text": "誰かが手を差し伸べてあなたを励ましてくれる"}, {"type": "subtitle", "time": 24110.468, "timestamp": "06:41:50", "text": "良いことが起こるまで持ちこたえよう"}, {"type": "subtitle", "time": 24112.468, "timestamp": "06:41:52", "text": "その人々は危険にさらされていた。"}, {"type": "subtitle", "time": 24114.31, "timestamp": "06:41:54", "text": "あなたも、助けるためなら何でもするでしょう。"}, {"type": "subtitle", "time": 24115.75, "timestamp": "06:41:55", "text": "真実。私は...するだろう。"}, {"type": "subtitle", "time": 24118.31, "timestamp": "06:41:58", "text": "もしかしたらあなたの言う通りかもしれない。苦味"}]
[{"type": "subtitle", "time": 8702.15, "timestamp": "02:25:02", "text": "よし、これで十分だろう"}, {"type": "subtitle", "time": 8704.469, "timestamp": "02:25:04", "text": "彼に教訓を与えてやれ。これで締めくくりましょう"}, {"type": "subtitle", "time": 8706.15, "timestamp": "02:25:06", "text": "そして戻って"}, {"type": "subtitle", "time": 8708.469, "timestamp": "02:25:08", "text": "いやあ、あっという間だったね。"}, {"type": "subtitle", "time": 8710.63, "timestamp": "02:25:10", "text": "私は不誠実な者を罰するだろう"}, {"type": "subtitle", "time": 8713.75, "timestamp": "02:25:13", "text": "愛の神の名において愛する。"}, {"type": "subtitle", "time": 8716.71, "timestamp": "02:25:16", "text": "昇格可能。わかった。ああ、私の武器"}, {"type": "subtitle", "time": 8720.55, "timestamp": "02:25:20", "text": "レベルアップもできます。おお、いいね、いいね、"}, {"type": "subtitle", "time": 8722.95, "timestamp": "02:25:22", "text": "ニース。農業資材をたくさん手に入れました。"}, {"type": "subtitle", "time": 8725.03, "timestamp": "02:25:25", "text": "ニース。"}, {"type": "subtitle", "time": 8730.95, "timestamp": "02:25:30", "text": "野菜は、"}, {"type": "subtitle", "time": 8737.75, "timestamp": "02:25:37", "text": "そう思います"}, {"type": "subtitle", "time": 8741.03, "timestamp": "02:25:41", "text": "遺物か何かのようなもの"}, {"type": "subtitle", "time": 8745.91, "timestamp": "02:25:45", "text": "あるいは、パワーアップアイテムのようなものですね。"}, {"type": "subtitle", "time": 8750.15, "timestamp": "02:25:50", "text": "ああ、本当にたくさんのことがある。"}]
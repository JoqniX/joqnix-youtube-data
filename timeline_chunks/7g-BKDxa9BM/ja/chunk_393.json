[{"type": "subtitle", "time": 23581.11, "timestamp": "06:33:01", "text": "ちょうど8時ちょうど。"}, {"type": "subtitle", "time": 23583.67, "timestamp": "06:33:03", "text": "当初の計画に忠実に従う。雪と私"}, {"type": "subtitle", "time": 23586.39, "timestamp": "06:33:06", "text": "ヘンリックを尾行する。そして部外者よ、"}, {"type": "subtitle", "time": 23588.15, "timestamp": "06:33:08", "text": "ヘンリックのオフィスに忍び込む"}, {"type": "subtitle", "time": 23601.03, "timestamp": "06:33:21", "text": "ちびっ子、急げ。"}, {"type": "subtitle", "time": 23629.27, "timestamp": "06:33:49", "text": "ポップコーン"}]
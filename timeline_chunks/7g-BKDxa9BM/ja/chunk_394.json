[{"type": "subtitle", "time": 23656.628, "timestamp": "06:34:16", "text": "あ、いい考えがある。私たちは中に隠れる"}, {"type": "subtitle", "time": 23658.468, "timestamp": "06:34:18", "text": "この大男を追いかけ、"}, {"type": "subtitle", "time": 23660.15, "timestamp": "06:34:20", "text": "音を立てる。"}, {"type": "subtitle", "time": 23662.07, "timestamp": "06:34:22", "text": "それでは、どのように計画しているか教えてください"}, {"type": "subtitle", "time": 23664.07, "timestamp": "06:34:24", "text": "兵士に見つからないようにこっそり中に入る"}, {"type": "subtitle", "time": 23666.23, "timestamp": "06:34:26", "text": "気づいてる。"}, {"type": "subtitle", "time": 23670.468, "timestamp": "06:34:30", "text": "えっと、あの、ヘンリックが去るんです。さあ"}, {"type": "subtitle", "time": 23671.51, "timestamp": "06:34:31", "text": "行く。"}, {"type": "subtitle", "time": 23685.11, "timestamp": "06:34:45", "text": "[音楽]"}, {"type": "subtitle", "time": 23686.15, "timestamp": "06:34:46", "text": "待って。"}, {"type": "subtitle", "time": 23689.27, "timestamp": "06:34:49", "text": "ああ、くそ。また君か。"}, {"type": "subtitle", "time": 23691.91, "timestamp": "06:34:51", "text": "いいえ。いいえ。私たちはちょうど戻っていたところでした"}, {"type": "subtitle", "time": 23694.07, "timestamp": "06:34:54", "text": "酒場。待って。"}]
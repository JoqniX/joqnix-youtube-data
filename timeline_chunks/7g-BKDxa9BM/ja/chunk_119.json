[{"type": "subtitle", "time": 7141.35, "timestamp": "01:59:01", "text": "何か役立つ情報を見つけたら、"}, {"type": "subtitle", "time": 7143.99, "timestamp": "01:59:03", "text": "最初に知った者。"}, {"type": "subtitle", "time": 7146.149, "timestamp": "01:59:06", "text": "あなたです。"}, {"type": "subtitle", "time": 7148.55, "timestamp": "01:59:08", "text": "そしてあなたは、"}, {"type": "subtitle", "time": 7151.99, "timestamp": "01:59:11", "text": "言い換えれば「精神」という表現ですよね？"}, {"type": "subtitle", "time": 7154.87, "timestamp": "01:59:14", "text": "はい、カミラさん。"}, {"type": "subtitle", "time": 7157.589, "timestamp": "01:59:17", "text": "今はヒュプノスの家に滞在しています。"}, {"type": "subtitle", "time": 7160.79, "timestamp": "01:59:20", "text": "今、くしゃみがすごく出ている。"}, {"type": "subtitle", "time": 7163.589, "timestamp": "01:59:23", "text": "友達と一緒です。"}, {"type": "subtitle", "time": 7166.149, "timestamp": "01:59:26", "text": "彼女は仕事を探していて、"}, {"type": "subtitle", "time": 7169.109, "timestamp": "01:59:29", "text": "キツネ狩りをする。"}, {"type": "subtitle", "time": 7171.75, "timestamp": "01:59:31", "text": "それなら、あなたは正しい場所に来ました。"}, {"type": "subtitle", "time": 7173.43, "timestamp": "01:59:33", "text": "キツネ狩りには手数料がかかる"}, {"type": "subtitle", "time": 7175.589, "timestamp": "01:59:35", "text": "今すぐ。"}, {"type": "subtitle", "time": 7178.629, "timestamp": "01:59:38", "text": "今はダメだよ、マーギー。"}, {"type": "subtitle", "time": 7185.91, "timestamp": "01:59:45", "text": "すでに友達ができた。あなたはとても"}, {"type": "subtitle", "time": 7188.149, "timestamp": "01:59:48", "text": "魅力的な人ですね。"}, {"type": "subtitle", "time": 7191.27, "timestamp": "01:59:51", "text": "キツネ狩りをする人たちは、"}, {"type": "subtitle", "time": 7193.589, "timestamp": "01:59:53", "text": "まず、一つはっきりさせておきましょう。これは"}, {"type": "subtitle", "time": 7196.229, "timestamp": "01:59:56", "text": "子供の遊びでもなければ、楽な仕事でもない。それは本当です"}, {"type": "subtitle", "time": 7197.91, "timestamp": "01:59:57", "text": "この場所では誰も調査しないだろう"}]
[{"type": "subtitle", "time": 17401.03, "timestamp": "04:50:01", "text": "人々を立ち上がらせます。"}, {"type": "subtitle", "time": 17403.11, "timestamp": "04:50:03", "text": "彼があまり厳しくしないことを願うばかりです"}, {"type": "subtitle", "time": 17406.15, "timestamp": "04:50:06", "text": "プシュケ。これが最後かどうかについては"}, {"type": "subtitle", "time": 17409.11, "timestamp": "04:50:09", "text": "その家での夜、私は"}, {"type": "subtitle", "time": 17410.47, "timestamp": "04:50:10", "text": "アウトサイダー。"}, {"type": "subtitle", "time": 17412.15, "timestamp": "04:50:12", "text": "あなたたち二人はその秘密を共有することになる"}, {"type": "subtitle", "time": 17414.708, "timestamp": "04:50:14", "text": "私抜きでちょっと話をしてたの？それ"}, {"type": "subtitle", "time": 17417.83, "timestamp": "04:50:17", "text": "部外者というのは、そんな過去の話だ。"}, {"type": "subtitle", "time": 17421.11, "timestamp": "04:50:21", "text": "どうでもいいよ。さあ、行ってらっしゃい。私は行くつもりです"}]
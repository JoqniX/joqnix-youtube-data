[{"type": "subtitle", "time": 23301.75, "timestamp": "06:28:21", "text": "プシュケ。これがその土壌です。"}, {"type": "subtitle", "time": 23305.27, "timestamp": "06:28:25", "text": "そして、それは非常に多いのです。"}, {"type": "subtitle", "time": 23313.59, "timestamp": "06:28:33", "text": "ああ、それは私があなたにあげたあの花ですね。"}, {"type": "subtitle", "time": 23318.708, "timestamp": "06:28:38", "text": "もちろん、それは貴重な贈り物です。"}, {"type": "subtitle", "time": 23320.868, "timestamp": "06:28:40", "text": "切りたてのものを見たことがありますか？"}, {"type": "subtitle", "time": 23323.11, "timestamp": "06:28:43", "text": "花屋で売られている花？"}, {"type": "subtitle", "time": 23323.83, "timestamp": "06:28:43", "text": "森？"}, {"type": "subtitle", "time": 23327.11, "timestamp": "06:28:47", "text": "花、茎、葉はすべて"}, {"type": "subtitle", "time": 23329.91, "timestamp": "06:28:49", "text": "同じ植物。しかし、人々は"}, {"type": "subtitle", "time": 23331.75, "timestamp": "06:28:51", "text": "あなたが花を贈ったとき、"}, {"type": "subtitle", "time": 23333.91, "timestamp": "06:28:53", "text": "少し。それはあなたが感じているということですか"}]
[{"type": "subtitle", "time": 8341.19, "timestamp": "02:19:01", "text": "キャラクター：悪魔ウェス、武器。"}, {"type": "chat", "time": 8343.44, "timestamp": "02:19:03", "author": "@YuiAimee", "avatar": "https://yt4.ggpht.com/9uJx6zl2Th-qTTaHPiE2zUXikqflkcr8RMw9pOsiOhodbUfx1hDAd7Vf6b8GJ44KFGPbxEbUOFs=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/egJ1XufTKYfegwOo57ewAgUCkszU2WH9gy1mb0dV-11UJg/egJ1XufTKYfegwOo57ewAg"}, {"type": "subtitle", "time": 8347.589, "timestamp": "02:19:07", "text": "複数の男性が使用しています。同様に、同じ"}, {"type": "subtitle", "time": 8350.07, "timestamp": "02:19:10", "text": "武器は"}, {"type": "subtitle", "time": 8354.309, "timestamp": "02:19:14", "text": "同じ武器、同じ悪魔の野菜は"}, {"type": "subtitle", "time": 8356.469, "timestamp": "02:19:16", "text": "使用済み"}, {"type": "subtitle", "time": 8364.07, "timestamp": "02:19:24", "text": "悪魔。えっと、マッサージの文字を設定してください。えっと"}, {"type": "subtitle", "time": 8366.469, "timestamp": "02:19:26", "text": "オレンジ色は容量を表します"}, {"type": "subtitle", "time": 8369.11, "timestamp": "02:19:29", "text": "武器を"}, {"type": "subtitle", "time": 8372.709, "timestamp": "02:19:32", "text": "通話回数。"}, {"type": "subtitle", "time": 8375.509, "timestamp": "02:19:35", "text": "えっと"}, {"type": "subtitle", "time": 8380.07, "timestamp": "02:19:40", "text": "それらはどういう意味ですか？えっと"}, {"type": "subtitle", "time": 8381.91, "timestamp": "02:19:41", "text": "わかった。"}, {"type": "subtitle", "time": 8385.19, "timestamp": "02:19:45", "text": "クリップは何"}, {"type": "subtitle", "time": 8387.83, "timestamp": "02:19:47", "text": "翼？わかった。"}]
[{"type": "subtitle", "time": 4561.99, "timestamp": "01:16:01", "text": "ラチェット、君だったのか。いくらって言った？"}, {"type": "subtitle", "time": 4564.95, "timestamp": "01:16:04", "text": "また？えっと"}, {"type": "subtitle", "time": 4569.59, "timestamp": "01:16:09", "text": "SCAサーバーのping値は70～90msくらいです。"}, {"type": "subtitle", "time": 4574.709, "timestamp": "01:16:14", "text": "アジアはpingが90から120くらいで、彼は"}, {"type": "subtitle", "time": 4579.59, "timestamp": "01:16:19", "text": "彼らもインド出身です。それで"}, {"type": "subtitle", "time": 4582.95, "timestamp": "01:16:22", "text": "うん、いつ"}, {"type": "subtitle", "time": 4587.59, "timestamp": "01:16:27", "text": "協力プレイの範囲はいつ解除されますか？"}, {"type": "subtitle", "time": 4598.07, "timestamp": "01:16:38", "text": "さあ、プレイを続けよう"}, {"type": "subtitle", "time": 4599.59, "timestamp": "01:16:39", "text": "協力者を解除してチェックします"}, {"type": "subtitle", "time": 4602.95, "timestamp": "01:16:42", "text": "後で連絡します。わかった、"}, {"type": "subtitle", "time": 4604.31, "timestamp": "01:16:44", "text": "それが私にできる唯一のことです。"}, {"type": "subtitle", "time": 4615.35, "timestamp": "01:16:55", "text": "君は普段は正直な子だと思うよ。"}, {"type": "subtitle", "time": 4618.31, "timestamp": "01:16:58", "text": "韓国出身者は70人。だからそれは"}]
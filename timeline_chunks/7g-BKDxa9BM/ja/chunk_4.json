[{"type": "subtitle", "time": 247.50900000000001, "timestamp": "00:04:07", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 250.55, "timestamp": "00:04:10", "text": "ええと、こんばんは、ジェームズ・ジャガーさん。いらっしゃいませ"}, {"type": "subtitle", "time": 252.309, "timestamp": "00:04:12", "text": "で。"}, {"type": "subtitle", "time": 255.67, "timestamp": "00:04:15", "text": "こんばんは。おはよう。"}, {"type": "subtitle", "time": 266.469, "timestamp": "00:04:26", "text": "アジア。私はアジアサーバーでプレイすることを勧められました。"}, {"type": "subtitle", "time": 269.35, "timestamp": "00:04:29", "text": "え、何？また、サーバーは"}, {"type": "subtitle", "time": 276.79, "timestamp": "00:04:36", "text": "待って、もう発売されてるよ。 7時30分ではありません。彼らは"}, {"type": "subtitle", "time": 280.55, "timestamp": "00:04:40", "text": "すでに門は開いています。"}, {"type": "subtitle", "time": 282.71, "timestamp": "00:04:42", "text": "え、何？"}, {"type": "subtitle", "time": 288.15, "timestamp": "00:04:48", "text": "ああ、みんなプレイしてるよ。はい、はい、"}, {"type": "subtitle", "time": 291.51, "timestamp": "00:04:51", "text": "わかった。めちゃくちゃ遅い。"}, {"type": "subtitle", "time": 294.87, "timestamp": "00:04:54", "text": "めちゃくちゃ遅刻しちゃった。一体どういうことだ？"}, {"type": "subtitle", "time": 296.469, "timestamp": "00:04:56", "text": "調べてみます。調べてみます。私にさせて"}]
[{"type": "subtitle", "time": 18122.07, "timestamp": "05:02:02", "text": "ここで何をしているの？聞いてないの？"}, {"type": "subtitle", "time": 18124.708, "timestamp": "05:02:04", "text": "あなたは朝出発する予定ですか？"}, {"type": "subtitle", "time": 18127.35, "timestamp": "05:02:07", "text": "あなたが探していたものを見つけました。の"}, {"type": "subtitle", "time": 18129.03, "timestamp": "05:02:09", "text": "ステラのクリスタロ。"}, {"type": "subtitle", "time": 18132.628, "timestamp": "05:02:12", "text": "誰もあなたにここに来るように頼んでいない。"}, {"type": "subtitle", "time": 18135.51, "timestamp": "05:02:15", "text": "私はここの出身ではありません。私はよく知りません"}, {"type": "subtitle", "time": 18139.11, "timestamp": "05:02:19", "text": "アイスレイクスの流儀。私の出身地では、"}, {"type": "subtitle", "time": 18141.67, "timestamp": "05:02:21", "text": "取引とは、片手に現金、もう片手に商品があることを意味します。"}, {"type": "subtitle", "time": 18143.67, "timestamp": "05:02:23", "text": "もう一方。"}, {"type": "subtitle", "time": 18146.15, "timestamp": "05:02:26", "text": "ご興味がない場合は、ヘンリックさん、"}, {"type": "subtitle", "time": 18147.75, "timestamp": "05:02:27", "text": "私は別のものを探しに行くかもしれない"}, {"type": "subtitle", "time": 18153.51, "timestamp": "05:02:33", "text": "どうぞお入りください。"}, {"type": "subtitle", "time": 18163.51, "timestamp": "05:02:43", "text": "待って。では、メインとしてプレイできますか？"}, {"type": "subtitle", "time": 18165.99, "timestamp": "05:02:45", "text": "キャラクター？"}, {"type": "subtitle", "time": 18169.83, "timestamp": "05:02:49", "text": "だから、私はこのようにデプロイします。"}]
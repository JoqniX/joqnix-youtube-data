[{"type": "subtitle", "time": 5402.39, "timestamp": "01:30:02", "text": "バロニカ。"}, {"type": "subtitle", "time": 5404.95, "timestamp": "01:30:04", "text": "ああ、レベッカを手に入れたよ。"}, {"type": "subtitle", "time": 5414.629, "timestamp": "01:30:14", "text": "オープンベータ版の報酬。私はそれをプレイしたことがない。"}, {"type": "subtitle", "time": 5434.39, "timestamp": "01:30:34", "text": "私たちはどこへ向かっているのか？招待していますか"}, {"type": "subtitle", "time": 5434.709, "timestamp": "01:30:34", "text": "自分？"}, {"type": "subtitle", "time": 5436.709, "timestamp": "01:30:36", "text": "あ、待って。レベッカのロックを解除できるようになりました。"}, {"type": "subtitle", "time": 5442.709, "timestamp": "01:30:42", "text": "彼女のロックを解除する。"}, {"type": "subtitle", "time": 5445.51, "timestamp": "01:30:45", "text": "ロマンチックな出会い。これは"}, {"type": "subtitle", "time": 5447.35, "timestamp": "01:30:47", "text": "愛の仕事？"}, {"type": "subtitle", "time": 5449.11, "timestamp": "01:30:49", "text": "彼女はとても綺麗だ。"}, {"type": "subtitle", "time": 5451.11, "timestamp": "01:30:51", "text": "調香師。"}, {"type": "subtitle", "time": 5453.27, "timestamp": "01:30:53", "text": "本当にユニークな体験をしてみませんか？"}, {"type": "subtitle", "time": 5456.79, "timestamp": "01:30:56", "text": "香り？教訓は、私たちのものです。"}, {"type": "subtitle", "time": 5458.629, "timestamp": "01:30:58", "text": "自分で作りました。"}]
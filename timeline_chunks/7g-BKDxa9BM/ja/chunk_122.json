[{"type": "subtitle", "time": 7320.229, "timestamp": "02:02:00", "text": "もちろん。"}, {"type": "subtitle", "time": 7324.149, "timestamp": "02:02:04", "text": "おお。しかしこれは本当に"}, {"type": "subtitle", "time": 7337.669, "timestamp": "02:02:17", "text": "これを見てください。 2段重ねの木箱"}, {"type": "subtitle", "time": 7340.47, "timestamp": "02:02:20", "text": "壁にもたれて。州によると"}, {"type": "subtitle", "time": 7342.95, "timestamp": "02:02:22", "text": "こうして、口数の少ない探偵マーギーは"}, {"type": "subtitle", "time": 7345.27, "timestamp": "02:02:25", "text": "絶望的な泥棒は"}, {"type": "subtitle", "time": 7347.83, "timestamp": "02:02:27", "text": "これらの木箱を積み重ねて壁を登った。"}, {"type": "subtitle", "time": 7349.91, "timestamp": "02:02:29", "text": "賢明な考えだ。"}, {"type": "subtitle", "time": 7352.87, "timestamp": "02:02:32", "text": "それで、口数の少ない刑事さん、それがあなたの"}, {"type": "subtitle", "time": 7356.79, "timestamp": "02:02:36", "text": "タイトル、マーギー。良さそうですね。少し短い"}, {"type": "subtitle", "time": 7359.669, "timestamp": "02:02:39", "text": "けれど。もっとパンチが欲しい。"}, {"type": "subtitle", "time": 7362.31, "timestamp": "02:02:42", "text": "なるほど。何か提案はありますか、悪魔"}, {"type": "subtitle", "time": 7364.709, "timestamp": "02:02:44", "text": "王？"}, {"type": "subtitle", "time": 7371.83, "timestamp": "02:02:51", "text": "[音楽]"}, {"type": "subtitle", "time": 7373.589, "timestamp": "02:02:53", "text": "後ろにいた老人があなたを呼んでいました"}, {"type": "subtitle", "time": 7375.669, "timestamp": "02:02:55", "text": "プリンセスのゴミ箱。"}]
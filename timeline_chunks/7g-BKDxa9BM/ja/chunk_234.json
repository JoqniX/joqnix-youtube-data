[{"type": "subtitle", "time": 14044.15, "timestamp": "03:54:04", "text": "ああ、これだ。それは文字通り仲間です"}, {"type": "subtitle", "time": 14047.03, "timestamp": "03:54:07", "text": "今の世界。"}, {"type": "subtitle", "time": 14051.11, "timestamp": "03:54:11", "text": "私たちはこれらの可愛いポケモンを集めることができました。"}, {"type": "subtitle", "time": 14054.469, "timestamp": "03:54:14", "text": "はぁ？精霊を傷つけてはいけません。"}, {"type": "subtitle", "time": 14056.55, "timestamp": "03:54:16", "text": "それらをやっつけろ。"}, {"type": "subtitle", "time": 14058.07, "timestamp": "03:54:18", "text": "ああ、彼女が来た。"}, {"type": "subtitle", "time": 14060.15, "timestamp": "03:54:20", "text": "声に出して。あと何回"}, {"type": "subtitle", "time": 14062.469, "timestamp": "03:54:22", "text": "彼女にばったり会う？急いで。すべての"}, {"type": "subtitle", "time": 14065.03, "timestamp": "03:54:25", "text": "天才たちが動き出す。"}, {"type": "subtitle", "time": 14067.91, "timestamp": "03:54:27", "text": "彼らは逃げている。ミスとあなたの"}, {"type": "subtitle", "time": 14072.309, "timestamp": "03:54:32", "text": "小さな友達、ちょっと手伝ってくれないか？"}, {"type": "subtitle", "time": 14076.95, "timestamp": "03:54:36", "text": "巨大な豚は実在する。それは話す。はい、私は"}, {"type": "subtitle", "time": 14078.95, "timestamp": "03:54:38", "text": "そこに書いてある通りにするとしましょう。あの人たち"}, {"type": "subtitle", "time": 14093.429, "timestamp": "03:54:53", "text": "全員即死だった。私は死んだ"}, {"type": "subtitle", "time": 14095.91, "timestamp": "03:54:55", "text": "そこから。一体どういうことだ？あなたは見ましたか"}, {"type": "subtitle", "time": 14097.59, "timestamp": "03:54:57", "text": "それ？私は捨てられた。"}, {"type": "subtitle", "time": 14099.83, "timestamp": "03:54:59", "text": "彼らはとても速く走って消えた"}]
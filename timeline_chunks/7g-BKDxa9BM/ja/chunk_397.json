[{"type": "subtitle", "time": 23821.11, "timestamp": "06:37:01", "text": "こんにちは。私たちはこの銀貨を見つけました。かわいい"}, {"type": "subtitle", "time": 23824.868, "timestamp": "06:37:04", "text": "確かにその男はただ待って、あなたは"}, {"type": "subtitle", "time": 23828.628, "timestamp": "06:37:08", "text": "いいえ、白い服を着た紳士のことなら。"}, {"type": "subtitle", "time": 23829.91, "timestamp": "06:37:09", "text": "彼は"}, {"type": "subtitle", "time": 23833.51, "timestamp": "06:37:13", "text": "わかった。ありがとう。待って、君"}, {"type": "subtitle", "time": 23836.708, "timestamp": "06:37:16", "text": "いや、そうだったかもしれない。あなたは私に与えている"}, {"type": "subtitle", "time": 23838.788, "timestamp": "06:37:18", "text": "それは正しい。"}, {"type": "subtitle", "time": 23841.11, "timestamp": "06:37:21", "text": "やあ、スパーク。ありがとう。"}, {"type": "subtitle", "time": 23861.35, "timestamp": "06:37:41", "text": "[音楽]"}, {"type": "subtitle", "time": 23875.51, "timestamp": "06:37:55", "text": "ああ、いいよ。それで、彼はいつ行ったの？"}]
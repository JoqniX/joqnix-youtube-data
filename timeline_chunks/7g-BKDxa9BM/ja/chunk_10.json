[{"type": "subtitle", "time": 613.99, "timestamp": "00:10:13", "text": "この辺りに隠し宝箱はありますか？"}, {"type": "subtitle", "time": 616.79, "timestamp": "00:10:16", "text": "こんにちは。胸部なし。私は"}, {"type": "subtitle", "time": 619.03, "timestamp": "00:10:19", "text": "キャラクターが私についてくる。それはまるで"}, {"type": "subtitle", "time": 622.71, "timestamp": "00:10:22", "text": "えっと、オンラインのやつみたいな感じですよね？"}, {"type": "subtitle", "time": 624.87, "timestamp": "00:10:24", "text": "つまり、あなたは自分のメインキャラクターを演じるか、"}, {"type": "subtitle", "time": 627.75, "timestamp": "00:10:27", "text": "1 つのキャラクター、すべての NPC または"}, {"type": "subtitle", "time": 629.43, "timestamp": "00:10:29", "text": "同行キャラクターがあなたについてきます。"}, {"type": "subtitle", "time": 632.31, "timestamp": "00:10:32", "text": "それはすごくクールだね。"}, {"type": "subtitle", "time": 634.87, "timestamp": "00:10:34", "text": "おい、それめっちゃかっこいいじゃん。これ大好き"}, {"type": "subtitle", "time": 637.75, "timestamp": "00:10:37", "text": "点灯。"}, {"type": "subtitle", "time": 651.43, "timestamp": "00:10:51", "text": "そして、コントロールと自由を残せた。"}, {"type": "subtitle", "time": 655.03, "timestamp": "00:10:55", "text": "おい、なんでWarframeみたいな感じがするんだよ？"}, {"type": "subtitle", "time": 656.71, "timestamp": "00:10:56", "text": "私は大丈夫です。その"}, {"type": "subtitle", "time": 659.99, "timestamp": "00:10:59", "text": "なぜWarframeに似ていると感じるのか？"}]
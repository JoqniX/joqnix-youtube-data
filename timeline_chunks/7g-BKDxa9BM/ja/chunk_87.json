[{"type": "subtitle", "time": 5220.39, "timestamp": "01:27:00", "text": "聖域。"}, {"type": "subtitle", "time": 5223.03, "timestamp": "01:27:03", "text": "ああ、ここは私たちの主要拠点です。おお、"}, {"type": "subtitle", "time": 5225.91, "timestamp": "01:27:05", "text": "この部屋はついさっき掃除されたばかりです。あなた"}, {"type": "subtitle", "time": 5229.11, "timestamp": "01:27:09", "text": "今夜はここに泊まることができます。"}, {"type": "subtitle", "time": 5231.75, "timestamp": "01:27:11", "text": "いいね。"}, {"type": "subtitle", "time": 5233.669, "timestamp": "01:27:13", "text": "怒らないで。"}, {"type": "subtitle", "time": 5237.11, "timestamp": "01:27:17", "text": "ヘンリック氏は実際にはそれほど貪欲ではない。"}, {"type": "subtitle", "time": 5239.189, "timestamp": "01:27:19", "text": "私たちはかなり金銭的に苦しい状況にあり、"}, {"type": "subtitle", "time": 5241.83, "timestamp": "01:27:21", "text": "最近現金が不足している。そうでなければ、彼は"}, {"type": "subtitle", "time": 5243.669, "timestamp": "01:27:23", "text": "古い家を売って"}, {"type": "subtitle", "time": 5245.99, "timestamp": "01:27:25", "text": "なんとかやりくりできる。"}, {"type": "subtitle", "time": 5246.31, "timestamp": "01:27:26", "text": "おお、"}, {"type": "subtitle", "time": 5249.03, "timestamp": "01:27:29", "text": "それは何年も放置されてきた。しかしその後"}, {"type": "subtitle", "time": 5253.11, "timestamp": "01:27:33", "text": "しっかり掃除すれば、それほど悪くないですよね？"}, {"type": "subtitle", "time": 5256.229, "timestamp": "01:27:36", "text": "少なくとも寒さは防いでくれる。"}, {"type": "subtitle", "time": 5257.35, "timestamp": "01:27:37", "text": "おお、"}, {"type": "subtitle", "time": 5260.31, "timestamp": "01:27:40", "text": "自己紹介がまだでした。"}, {"type": "subtitle", "time": 5261.59, "timestamp": "01:27:41", "text": "私はサイキです。"}, {"type": "subtitle", "time": 5262.07, "timestamp": "01:27:42", "text": "プシュケ、"}, {"type": "subtitle", "time": 5265.03, "timestamp": "01:27:45", "text": "ヒュプノス・ハウスの下宿人と、"}, {"type": "subtitle", "time": 5267.83, "timestamp": "01:27:47", "text": "時々、ヘンリックさんの手伝いをします。"}, {"type": "subtitle", "time": 5269.83, "timestamp": "01:27:49", "text": "おお、"}, {"type": "subtitle", "time": 5270.39, "timestamp": "01:27:50", "text": "冗談です。"}, {"type": "subtitle", "time": 5274.149, "timestamp": "01:27:54", "text": "この街ではかなり珍しい名前だ。"}, {"type": "subtitle", "time": 5278.229, "timestamp": "01:27:58", "text": "ヘンリックさんが、あなたは地元の人ではないと言っていましたよ。"}]
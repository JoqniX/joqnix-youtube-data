[{"type": "subtitle", "time": 21332.23, "timestamp": "05:55:32", "text": "えっと"}, {"type": "subtitle", "time": 21333.11, "timestamp": "05:55:33", "text": "招待していますか"}, {"type": "subtitle", "time": 21339.19, "timestamp": "05:55:39", "text": "えっと"}, {"type": "subtitle", "time": 21342.628, "timestamp": "05:55:42", "text": "彼女はポーラと仲が良い"}, {"type": "subtitle", "time": 21346.788, "timestamp": "05:55:46", "text": "そして彼女の武器は、このセイレーンのキスだ。"}, {"type": "subtitle", "time": 21348.628, "timestamp": "05:55:48", "text": "彼女の武器を手に入れなければならない"}]
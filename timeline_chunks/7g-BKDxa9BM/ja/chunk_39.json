[{"type": "subtitle", "time": 2340.069, "timestamp": "00:39:00", "text": "一体あなたは誰ですか？"}, {"type": "subtitle", "time": 2343.27, "timestamp": "00:39:03", "text": "何てことだ。そこに戻ると、カットシーンが流れた。"}, {"type": "subtitle", "time": 2347.91, "timestamp": "00:39:07", "text": "ああ、あれは回想シーンだったんだ。これらすべて。"}, {"type": "subtitle", "time": 2358.55, "timestamp": "00:39:18", "text": "フィルソイドは理由もなくあなたを攻撃しました"}, {"type": "subtitle", "time": 2361.67, "timestamp": "00:39:21", "text": "あなたがここに来て、"}, {"type": "subtitle", "time": 2365.43, "timestamp": "00:39:25", "text": "偶然に隠された道を開く。"}, {"type": "subtitle", "time": 2369.51, "timestamp": "00:39:29", "text": "それは本当にあなたの話ですか？"}, {"type": "subtitle", "time": 2378.47, "timestamp": "00:39:38", "text": "シビル署長、彼女の脊髄を検査しました"}, {"type": "subtitle", "time": 2380.47, "timestamp": "00:39:40", "text": "構造を確認し、彼女が"}]
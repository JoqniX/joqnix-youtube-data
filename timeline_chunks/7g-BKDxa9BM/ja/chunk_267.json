[{"type": "subtitle", "time": 16021.189, "timestamp": "04:27:01", "text": "雲。"}, {"type": "subtitle", "time": 16023.269, "timestamp": "04:27:03", "text": "私はこれらすべてが大好きです。"}, {"type": "subtitle", "time": 16026.309, "timestamp": "04:27:06", "text": "雪はどちらかというと都市的なものだ。"}, {"type": "subtitle", "time": 16029.67, "timestamp": "04:27:09", "text": "グリームピットへの入り口はすぐそこです。"}, {"type": "subtitle", "time": 16031.91, "timestamp": "04:27:11", "text": "くれぐれもご注意ください。"}, {"type": "subtitle", "time": 16032.79, "timestamp": "04:27:12", "text": "それでは行きましょう。"}, {"type": "subtitle", "time": 16035.83, "timestamp": "04:27:15", "text": "さあ行こう。明るくしよう。わかりました。"}, {"type": "subtitle", "time": 16045.91, "timestamp": "04:27:25", "text": "これは何ですか？"}, {"type": "subtitle", "time": 16054.71, "timestamp": "04:27:34", "text": "痛い。"}, {"type": "subtitle", "time": 16057.91, "timestamp": "04:27:37", "text": "これほど厚いドアは恐らく貫通しないだろう"}, {"type": "subtitle", "time": 16059.75, "timestamp": "04:27:39", "text": "力ずくで解決する。"}, {"type": "subtitle", "time": 16061.51, "timestamp": "04:27:41", "text": "それでは、周りを見渡して"}, {"type": "subtitle", "time": 16062.95, "timestamp": "04:27:42", "text": "別の侵入経路。"}, {"type": "subtitle", "time": 16066.389, "timestamp": "04:27:46", "text": "スノー、頭が痛い？手伝わせてください"}, {"type": "subtitle", "time": 16074.63, "timestamp": "04:27:54", "text": "痛みを和らげるために交換する。"}]
[{"type": "subtitle", "time": 14102.79, "timestamp": "03:55:02", "text": "フラッシュ。彼らを追いかけるべきだろうか？"}, {"type": "subtitle", "time": 14106.07, "timestamp": "03:55:06", "text": "いいえ。彼らはまるで全てを知っているかのように逃げ出した"}, {"type": "subtitle", "time": 14107.99, "timestamp": "03:55:07", "text": "この場所には近道がある。"}, {"type": "subtitle", "time": 14110.71, "timestamp": "03:55:10", "text": "追いつくのは不可能だ。"}, {"type": "subtitle", "time": 14115.189, "timestamp": "03:55:15", "text": "それに、私たちがここにいる理由を忘れてしまいましょう。"}, {"type": "subtitle", "time": 14118.55, "timestamp": "03:55:18", "text": "つまり、これは背の高い巨大な豚です"}, {"type": "subtitle", "time": 14121.349, "timestamp": "03:55:21", "text": "私よりも大きく、頭の大きさは"}, {"type": "subtitle", "time": 14122.469, "timestamp": "03:55:22", "text": "バン。"}, {"type": "subtitle", "time": 14125.59, "timestamp": "03:55:25", "text": "あなたは誇張された言葉に騙されたのです。"}, {"type": "subtitle", "time": 14128.63, "timestamp": "03:55:28", "text": "まあ、いいでしょう。もしかしたら、それほどではないかもしれない"}, {"type": "subtitle", "time": 14130.71, "timestamp": "03:55:30", "text": "言った通り大きいけど、それでもかなり"}, {"type": "subtitle", "time": 14134.469, "timestamp": "03:55:34", "text": "大きい。そして、それが話すことも忘れないでください。"}, {"type": "subtitle", "time": 14135.67, "timestamp": "03:55:35", "text": "ええ、それは話します"}, {"type": "subtitle", "time": 14143.67, "timestamp": "03:55:43", "text": "しかし実際にはそうは見えない"}, {"type": "subtitle", "time": 14145.91, "timestamp": "03:55:45", "text": "話し合い。"}, {"type": "subtitle", "time": 14149.189, "timestamp": "03:55:49", "text": "それは私でした。"}, {"type": "subtitle", "time": 14149.83, "timestamp": "03:55:49", "text": "こんにちは。"}, {"type": "subtitle", "time": 14155.03, "timestamp": "03:55:55", "text": "これは、ええと、フィブのようです"}, {"type": "subtitle", "time": 14155.83, "timestamp": "03:55:55", "text": "しかし、より小さい。"}, {"type": "subtitle", "time": 14158.71, "timestamp": "03:55:58", "text": "私の親友であり、最も信頼できる人です"}]
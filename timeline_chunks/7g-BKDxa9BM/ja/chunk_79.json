[{"type": "subtitle", "time": 4741.91, "timestamp": "01:19:01", "text": "私が今まで見た中で一番クレイジーな話だ。"}, {"type": "subtitle", "time": 4742.95, "timestamp": "01:19:02", "text": "それで、"}, {"type": "subtitle", "time": 4745.43, "timestamp": "01:19:05", "text": "私は寝ていない。あなたも寝ていない。何？"}, {"type": "subtitle", "time": 4748.95, "timestamp": "01:19:08", "text": "しかし、彼女の背後には帝国が広がっている。私は立つのか"}, {"type": "chat", "time": 4752.987, "timestamp": "01:19:12", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "r you sick?"}, {"type": "subtitle", "time": 4753.27, "timestamp": "01:19:13", "text": "チャンス？少なくとも今のところは。私は"}, {"type": "subtitle", "time": 4760.87, "timestamp": "01:19:20", "text": "スノーがさっきあなたに言ったじゃないですか？その"}, {"type": "subtitle", "time": 4762.55, "timestamp": "01:19:22", "text": "具合が悪いのですか？うん、風邪を引いてるんだ。"}, {"type": "subtitle", "time": 4764.07, "timestamp": "01:19:24", "text": "またそこへ行く予定です。の"}, {"type": "subtitle", "time": 4767.51, "timestamp": "01:19:27", "text": "南行きの列車には重い荷物が積まれています"}, {"type": "subtitle", "time": 4770.229, "timestamp": "01:19:30", "text": "旅費。少なくとも"}, {"type": "subtitle", "time": 4772.87, "timestamp": "01:19:32", "text": "数千枚の銀貨"}, {"type": "subtitle", "time": 4773.59, "timestamp": "01:19:33", "text": "仕事。"}, {"type": "subtitle", "time": 4775.51, "timestamp": "01:19:35", "text": "たとえ物乞いをして渡る方がましだとしても"}, {"type": "subtitle", "time": 4778.07, "timestamp": "01:19:38", "text": "ハイパーオレアン平原では、まだ必要"}, {"type": "subtitle", "time": 4779.91, "timestamp": "01:19:39", "text": "検査に何らかの方法で対処するために"}, {"type": "subtitle", "time": 4782.79, "timestamp": "01:19:42", "text": "通り過ぎるすべての町。次回は、"}, {"type": "subtitle", "time": 4785.669, "timestamp": "01:19:45", "text": "それほど幸運ではないかもしれない。ああ、それは本当だ。"}, {"type": "subtitle", "time": 4788.31, "timestamp": "01:19:48", "text": "もしかしたら、"}, {"type": "subtitle", "time": 4790.87, "timestamp": "01:19:50", "text": "あなた自身が刑務所で苦しんでいる。"}, {"type": "subtitle", "time": 4793.43, "timestamp": "01:19:53", "text": "私はそれを望んでいません。"}, {"type": "subtitle", "time": 4795.75, "timestamp": "01:19:55", "text": "右。ずっと昔に戻ることは"}, {"type": "subtitle", "time": 4797.75, "timestamp": "01:19:57", "text": "ピクニック。私はしなければならない"}]
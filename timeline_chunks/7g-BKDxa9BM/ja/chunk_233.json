[{"type": "subtitle", "time": 13981.429, "timestamp": "03:53:01", "text": "こんにちは。お伺いしてもよろしいでしょうか？"}, {"type": "subtitle", "time": 13981.91, "timestamp": "03:53:01", "text": "シーッ。"}, {"type": "subtitle", "time": 13983.91, "timestamp": "03:53:03", "text": "静かにしてください。"}, {"type": "subtitle", "time": 13987.429, "timestamp": "03:53:07", "text": "何かを期待して、それらの秘密を守り続けなさい。"}, {"type": "subtitle", "time": 13993.349, "timestamp": "03:53:13", "text": "あ、ごめんなさい。つまり、あなたもここにいるのは"}, {"type": "subtitle", "time": 13996.87, "timestamp": "03:53:16", "text": "はい。何？君たちも？先着順、"}, {"type": "subtitle", "time": 14001.75, "timestamp": "03:53:21", "text": "先着順。列なし。"}, {"type": "subtitle", "time": 14004.15, "timestamp": "03:53:24", "text": "これさえも行列ができているんです。"}, {"type": "subtitle", "time": 14007.269, "timestamp": "03:53:27", "text": "つまり、それは巨大なものなんです。十分な量があります"}, {"type": "subtitle", "time": 14009.51, "timestamp": "03:53:29", "text": "みんな。"}, {"type": "subtitle", "time": 14011.75, "timestamp": "03:53:31", "text": "でもいいよ、私たちはただ見ているだけ"}, {"type": "subtitle", "time": 14014.309, "timestamp": "03:53:34", "text": "サイドライン。完了したら、"}, {"type": "subtitle", "time": 14016.95, "timestamp": "03:53:36", "text": "さらに詳しく見てみましょう。"}, {"type": "subtitle", "time": 14019.75, "timestamp": "03:53:39", "text": "なぜか、あなたは話していないように感じる"}, {"type": "subtitle", "time": 14022.71, "timestamp": "03:53:42", "text": "同じことについて？"}, {"type": "subtitle", "time": 14025.349, "timestamp": "03:53:45", "text": "他に何があり得るだろうか？誰でも"}, {"type": "subtitle", "time": 14029.429, "timestamp": "03:53:49", "text": "ここは明らかに"}, {"type": "subtitle", "time": 14034.87, "timestamp": "03:53:54", "text": "今。ロープを引いてください。"}]
[{"type": "subtitle", "time": 24840.868, "timestamp": "06:54:00", "text": ">> A stranger here. I can take you away."}, {"type": "subtitle", "time": 24842.708, "timestamp": "06:54:02", "text": "Just like the day we went to the pit"}, {"type": "subtitle", "time": 24844.948, "timestamp": "06:54:04", "text": "together."}, {"type": "subtitle", "time": 24847.67, "timestamp": "06:54:07", "text": "Once I find Bry, we can go to my"}, {"type": "subtitle", "time": 24850.15, "timestamp": "06:54:10", "text": "hometown in the south. Build little"}, {"type": "subtitle", "time": 24852.468, "timestamp": "06:54:12", "text": "houses by the sea and grow flowers"}, {"type": "subtitle", "time": 24855.43, "timestamp": "06:54:15", "text": "around our homes. When spring comes and"}, {"type": "subtitle", "time": 24860.23, "timestamp": "06:54:20", "text": "the flowers bloom, your eyes will heal."}, {"type": "subtitle", "time": 24863.83, "timestamp": "06:54:23", "text": "Every day the sun will shine so brightly"}, {"type": "subtitle", "time": 24865.59, "timestamp": "06:54:25", "text": "that you might even find yourself"}, {"type": "subtitle", "time": 24868.39, "timestamp": "06:54:28", "text": "missing Ice Lake snow."}, {"type": "subtitle", "time": 24871.43, "timestamp": "06:54:31", "text": "Oh, it might be a slight damper on your"}, {"type": "subtitle", "time": 24874.788, "timestamp": "06:54:34", "text": "dream, but are you scared of bugs? The"}, {"type": "subtitle", "time": 24878.23, "timestamp": "06:54:38", "text": "ones in the south are bigger. Thank you."}, {"type": "subtitle", "time": 24880.868, "timestamp": "06:54:40", "text": "I just can't leave Iceland. What do you"}, {"type": "subtitle", "time": 24884.948, "timestamp": "06:54:44", "text": "mean? Sorry, I can't tell you. Could you"}, {"type": "subtitle", "time": 24887.03, "timestamp": "06:54:47", "text": "take another photo? I don't like this"}, {"type": "subtitle", "time": 24889.75, "timestamp": "06:54:49", "text": "city."}, {"type": "subtitle", "time": 24892.628, "timestamp": "06:54:52", "text": ">> I hate But it's still where I grew up,"}, {"type": "subtitle", "time": 24894.15, "timestamp": "06:54:54", "text": "so"}, {"type": "subtitle", "time": 24896.948, "timestamp": "06:54:56", "text": "I'd like to take a picture with it."}, {"type": "subtitle", "time": 24899.91, "timestamp": "06:54:59", "text": ">> Man,"}]
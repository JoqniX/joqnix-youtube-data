[{"type": "subtitle", "time": 30122.468, "timestamp": "08:22:02", "text": ">> My eyes can see the longings of souls."}, {"type": "subtitle", "time": 30125.27, "timestamp": "08:22:05", "text": "As I guided her, I glimpsed."}, {"type": "subtitle", "time": 30128.15, "timestamp": "08:22:08", "text": ">> She was a friend of mine. I"}, {"type": "subtitle", "time": 30130.548, "timestamp": "08:22:10", "text": ">> quite the opposite."}, {"type": "subtitle", "time": 30133.27, "timestamp": "08:22:13", "text": ">> Many souls I've But her voice was very"}, {"type": "subtitle", "time": 30134.868, "timestamp": "08:22:14", "text": "gentle."}, {"type": "subtitle", "time": 30136.628, "timestamp": "08:22:16", "text": "Don't make me cry."}, {"type": "subtitle", "time": 30145.99, "timestamp": "08:22:25", "text": ">> child? I have lived long and bid"}, {"type": "subtitle", "time": 30148.388, "timestamp": "08:22:28", "text": "farewell to countless souls. Just as"}, {"type": "subtitle", "time": 30151.59, "timestamp": "08:22:31", "text": "plants succumb to wildfires and bugs"}, {"type": "subtitle", "time": 30153.83, "timestamp": "08:22:33", "text": "perish in storms."}, {"type": "subtitle", "time": 30156.948, "timestamp": "08:22:36", "text": "Impermanence is a part of life. Sooner"}, {"type": "subtitle", "time": 30161.51, "timestamp": "08:22:41", "text": "or later, death touches us all."}, {"type": "subtitle", "time": 30163.59, "timestamp": "08:22:43", "text": "Rather than cursing fate's indifference"}, {"type": "subtitle", "time": 30167.83, "timestamp": "08:22:47", "text": "and cruelty or lamenting our frailty,"}, {"type": "subtitle", "time": 30171.99, "timestamp": "08:22:51", "text": "we can choose to cherish the memories we"}, {"type": "subtitle", "time": 30175.75, "timestamp": "08:22:55", "text": "hold dear. After all, if death is the"}, {"type": "subtitle", "time": 30177.27, "timestamp": "08:22:57", "text": "inevitable,"}, {"type": "subtitle", "time": 30179.27, "timestamp": "08:22:59", "text": "then every moment alive is a miracle"}]
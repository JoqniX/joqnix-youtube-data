[{"type": "subtitle", "time": 6070.95, "timestamp": "01:41:10", "text": "Hey, you. Yes, you. The kid over there."}, {"type": "subtitle", "time": 6073.99, "timestamp": "01:41:13", "text": ">> Hello, Luna with the hammer."}, {"type": "subtitle", "time": 6074.709, "timestamp": "01:41:14", "text": "Is this"}, {"type": "subtitle", "time": 6078.47, "timestamp": "01:41:18", "text": ">> girl who looks just like Snow?"}, {"type": "subtitle", "time": 6081.109, "timestamp": "01:41:21", "text": ">> Oh, they're siblings."}, {"type": "subtitle", "time": 6083.43, "timestamp": "01:41:23", "text": "Wait, that girl has a mustache. What the"}, {"type": "subtitle", "time": 6085.51, "timestamp": "01:41:25", "text": "heck?"}, {"type": "subtitle", "time": 6089.43, "timestamp": "01:41:29", "text": "Who are you calling girl?"}, {"type": "subtitle", "time": 6091.669, "timestamp": "01:41:31", "text": ">> The the younger generation nowadays is"}, {"type": "subtitle", "time": 6098.229, "timestamp": "01:41:38", "text": ">> You should watch what you say. Although"}, {"type": "subtitle", "time": 6100.79, "timestamp": "01:41:40", "text": "all Lunarians look young, she's actually"}, {"type": "subtitle", "time": 6103.43, "timestamp": "01:41:43", "text": "as old as your great great grandmother."}, {"type": "subtitle", "time": 6116.39, "timestamp": "01:41:56", "text": "morality."}]
[{"type": "subtitle", "time": 30721.51, "timestamp": "08:32:01", "text": ">> even in the grave."}, {"type": "subtitle", "time": 30723.83, "timestamp": "08:32:03", "text": ">> So, I tend flowers."}, {"type": "subtitle", "time": 30727.43, "timestamp": "08:32:07", "text": ">> Perhaps then when that day comes, I'll"}, {"type": "subtitle", "time": 30729.51, "timestamp": "08:32:09", "text": "have fewer regret. But I didn't mean to"}, {"type": "subtitle", "time": 30730.628, "timestamp": "08:32:10", "text": "upset you, Elise."}, {"type": "subtitle", "time": 30731.83, "timestamp": "08:32:11", "text": ">> Huh?"}, {"type": "subtitle", "time": 30735.99, "timestamp": "08:32:15", "text": ">> But Psyche, you're the only one willing"}, {"type": "subtitle", "time": 30743.35, "timestamp": "08:32:23", "text": ">> Don't worry about it. I was just"}, {"type": "subtitle", "time": 30744.628, "timestamp": "08:32:24", "text": ">> Okay."}, {"type": "subtitle", "time": 30747.19, "timestamp": "08:32:27", "text": "Next time you see that person"}, {"type": "subtitle", "time": 30748.708, "timestamp": "08:32:28", "text": ">> and about the heaven tree."}, {"type": "subtitle", "time": 30761.19, "timestamp": "08:32:41", "text": ">> Man, that was so pretty. Thank you for"}, {"type": "subtitle", "time": 30763.03, "timestamp": "08:32:43", "text": "the follow,"}, {"type": "subtitle", "time": 30765.35, "timestamp": "08:32:45", "text": "Alter."}, {"type": "subtitle", "time": 30769.91, "timestamp": "08:32:49", "text": "Thank you. Welcome in."}, {"type": "subtitle", "time": 30773.99, "timestamp": "08:32:53", "text": "What is this? dropped by enemy souls"}]
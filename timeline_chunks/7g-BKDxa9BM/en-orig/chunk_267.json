[{"type": "subtitle", "time": 16021.189, "timestamp": "04:27:01", "text": "clouds."}, {"type": "subtitle", "time": 16023.269, "timestamp": "04:27:03", "text": "I love all this."}, {"type": "subtitle", "time": 16026.309, "timestamp": "04:27:06", "text": ">> Snow is more of a city."}, {"type": "subtitle", "time": 16029.67, "timestamp": "04:27:09", "text": ">> The entrance to Gleam Pit is up ahead."}, {"type": "subtitle", "time": 16031.91, "timestamp": "04:27:11", "text": "Please be extra careful."}, {"type": "subtitle", "time": 16032.79, "timestamp": "04:27:12", "text": ">> Let's go then."}, {"type": "subtitle", "time": 16035.83, "timestamp": "04:27:15", "text": ">> Let's go. Let's bright. All right, then."}, {"type": "subtitle", "time": 16045.91, "timestamp": "04:27:25", "text": ">> What is this?"}, {"type": "subtitle", "time": 16054.71, "timestamp": "04:27:34", "text": ">> Ouchie."}, {"type": "subtitle", "time": 16057.91, "timestamp": "04:27:37", "text": "A door this thick is probably impervious"}, {"type": "subtitle", "time": 16059.75, "timestamp": "04:27:39", "text": "to brute force."}, {"type": "subtitle", "time": 16061.51, "timestamp": "04:27:41", "text": ">> Then let's look around to see if there's"}, {"type": "subtitle", "time": 16062.95, "timestamp": "04:27:42", "text": "another way in."}, {"type": "subtitle", "time": 16066.389, "timestamp": "04:27:46", "text": ">> Snow, does your head hurt? Let me help"}, {"type": "subtitle", "time": 16074.63, "timestamp": "04:27:54", "text": ">> Exchange for ease the pain."}]
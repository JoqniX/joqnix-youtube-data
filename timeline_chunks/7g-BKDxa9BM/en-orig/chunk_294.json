[{"type": "subtitle", "time": 17641.75, "timestamp": "04:54:01", "text": ">> A"}, {"type": "subtitle", "time": 17647.03, "timestamp": "04:54:07", "text": ">> Hey, you're here."}, {"type": "subtitle", "time": 17648.708, "timestamp": "04:54:08", "text": ">> Who is this lady?"}, {"type": "subtitle", "time": 17651.43, "timestamp": "04:54:11", "text": ">> Um, a new friend of mine."}, {"type": "subtitle", "time": 17652.23, "timestamp": "04:54:12", "text": ">> Sort of."}, {"type": "subtitle", "time": 17653.83, "timestamp": "04:54:13", "text": ">> Pleased to meet you."}, {"type": "subtitle", "time": 17655.51, "timestamp": "04:54:15", "text": ">> Are you all right?"}, {"type": "subtitle", "time": 17658.39, "timestamp": "04:54:18", "text": ">> It's okay. I'm fine."}, {"type": "subtitle", "time": 17661.43, "timestamp": "04:54:21", "text": "Just a tea party."}, {"type": "subtitle", "time": 17665.67, "timestamp": "04:54:25", "text": ">> It's just water. Don't get"}, {"type": "subtitle", "time": 17667.99, "timestamp": "04:54:27", "text": "What's wrong, miss?"}, {"type": "subtitle", "time": 17671.83, "timestamp": "04:54:31", "text": ">> Nothing. It's just that the cake is"}, {"type": "subtitle", "time": 17675.83, "timestamp": "04:54:35", "text": "quite sweet, which reminds me of my"}, {"type": "subtitle", "time": 17677.51, "timestamp": "04:54:37", "text": "family."}, {"type": "subtitle", "time": 17679.91, "timestamp": "04:54:39", "text": "She used to season food with lots of"}, {"type": "subtitle", "time": 17682.708, "timestamp": "04:54:42", "text": "sugar. The island we grew up on had"}, {"type": "subtitle", "time": 17685.99, "timestamp": "04:54:45", "text": "plenty of fish and salt, but sugar was a"}, {"type": "subtitle", "time": 17687.59, "timestamp": "04:54:47", "text": "rarity."}, {"type": "subtitle", "time": 17689.99, "timestamp": "04:54:49", "text": "So, when we were little, we never really"}, {"type": "subtitle", "time": 17691.99, "timestamp": "04:54:51", "text": "got to have it. She's only a few years"}, {"type": "subtitle", "time": 17695.03, "timestamp": "04:54:55", "text": "older than me, but from a young age, she"}, {"type": "subtitle", "time": 17697.19, "timestamp": "04:54:57", "text": "began working as a helper for the"}, {"type": "subtitle", "time": 17698.868, "timestamp": "04:54:58", "text": "neighboring fisherman."}, {"type": "subtitle", "time": 17699.43, "timestamp": "04:54:59", "text": ">> Oh."}]
[{"type": "subtitle", "time": 25260.788, "timestamp": "07:01:00", "text": "it, that was right around the time he"}, {"type": "subtitle", "time": 25264.548, "timestamp": "07:01:04", "text": "got in trouble in Scarlet River."}, {"type": "subtitle", "time": 25266.468, "timestamp": "07:01:06", "text": "He had a wife and a daughter. They were"}, {"type": "subtitle", "time": 25268.628, "timestamp": "07:01:08", "text": "just an ordinary family of three. But"}, {"type": "subtitle", "time": 25270.468, "timestamp": "07:01:10", "text": "then his wife, as for his daughter,"}, {"type": "subtitle", "time": 25272.868, "timestamp": "07:01:12", "text": "what's her name? Heidi Haley, I don't"}, {"type": "subtitle", "time": 25275.43, "timestamp": "07:01:15", "text": "quite remember. Anyway, he never talks"}, {"type": "subtitle", "time": 25276.628, "timestamp": "07:01:16", "text": "about his daughter."}, {"type": "subtitle", "time": 25278.39, "timestamp": "07:01:18", "text": ">> One year, my superior asked about her"}, {"type": "subtitle", "time": 25280.15, "timestamp": "07:01:20", "text": "over drink. I swear I've told you"}, {"type": "subtitle", "time": 25282.548, "timestamp": "07:01:22", "text": "everything I know. Can you please let me"}, {"type": "subtitle", "time": 25286.788, "timestamp": "07:01:26", "text": "off now? Just give me the film."}, {"type": "subtitle", "time": 25287.51, "timestamp": "07:01:27", "text": ">> Damn it."}, {"type": "subtitle", "time": 25289.51, "timestamp": "07:01:29", "text": ">> Well, take care, sir."}, {"type": "subtitle", "time": 25291.59, "timestamp": "07:01:31", "text": ">> Hey, you just going to leave like that?"}, {"type": "subtitle", "time": 25293.83, "timestamp": "07:01:33", "text": ">> Where are you going? O, you promised not"}, {"type": "subtitle", "time": 25295.35, "timestamp": "07:01:35", "text": "to tell anyone, didn't you?"}, {"type": "subtitle", "time": 25298.788, "timestamp": "07:01:38", "text": ">> You stick to your word."}]
[{"type": "subtitle", "time": 30363.51, "timestamp": "08:26:03", "text": ">> You seem sad."}, {"type": "subtitle", "time": 30365.59, "timestamp": "08:26:05", "text": ">> Yes,"}, {"type": "subtitle", "time": 30369.99, "timestamp": "08:26:09", "text": "I had a sad dream. Well, I'm not sure if"}, {"type": "subtitle", "time": 30373.51, "timestamp": "08:26:13", "text": "it was a dream. I feel like I've lost"}, {"type": "subtitle", "time": 30376.23, "timestamp": "08:26:16", "text": "something important."}, {"type": "subtitle", "time": 30378.868, "timestamp": "08:26:18", "text": ">> Trying hard to hold on to something, yet"}, {"type": "subtitle", "time": 30381.35, "timestamp": "08:26:21", "text": "it slips away like sand through our"}, {"type": "subtitle", "time": 30383.27, "timestamp": "08:26:23", "text": "fingers."}, {"type": "subtitle", "time": 30387.03, "timestamp": "08:26:27", "text": "Time and life."}, {"type": "subtitle", "time": 30391.11, "timestamp": "08:26:31", "text": "To be born is to be destroyed. To meet"}, {"type": "subtitle", "time": 30394.07, "timestamp": "08:26:34", "text": "is to part ways. The only thing that"}, {"type": "subtitle", "time": 30398.948, "timestamp": "08:26:38", "text": "everlasts in this world is oblivion."}, {"type": "subtitle", "time": 30407.19, "timestamp": "08:26:47", "text": "Like you, I'm starting my own journey."}, {"type": "subtitle", "time": 30411.35, "timestamp": "08:26:51", "text": ">> Wait, who who are you?"}, {"type": "subtitle", "time": 30414.708, "timestamp": "08:26:54", "text": ">> My name is Our paths may cross again one"}, {"type": "subtitle", "time": 30416.23, "timestamp": "08:26:56", "text": "day."}, {"type": "subtitle", "time": 30419.83, "timestamp": "08:26:59", "text": ">> Once again, in the collapsing dream that"}]
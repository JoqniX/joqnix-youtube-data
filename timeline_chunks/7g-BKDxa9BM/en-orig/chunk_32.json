[{"type": "subtitle", "time": 1928.95, "timestamp": "00:32:08", "text": "We've been searching for years. When"}, {"type": "subtitle", "time": 1930.63, "timestamp": "00:32:10", "text": "will the chief give up this pointless"}, {"type": "subtitle", "time": 1931.909, "timestamp": "00:32:11", "text": "hunt?"}, {"type": "subtitle", "time": 1934.87, "timestamp": "00:32:14", "text": ">> Who's there? Lay down your arms. You're"}, {"type": "subtitle", "time": 1937.11, "timestamp": "00:32:17", "text": "surrounded by the 13th Legion."}, {"type": "subtitle", "time": 1940.47, "timestamp": "00:32:20", "text": ">> How come it's that?"}, {"type": "subtitle", "time": 1943.909, "timestamp": "00:32:23", "text": ">> What happened, Barry?"}, {"type": "subtitle", "time": 1947.509, "timestamp": "00:32:27", "text": ">> The Legion. They found their way here."}, {"type": "subtitle", "time": 1950.95, "timestamp": "00:32:30", "text": "Anyway, they got to break out first."}]
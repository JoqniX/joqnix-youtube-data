[{"type": "subtitle", "time": 1707.19, "timestamp": "00:28:27", "text": "It seems someone used to live here."}, {"type": "subtitle", "time": 1707.83, "timestamp": "00:28:27", "text": ">> This was your"}, {"type": "subtitle", "time": 1715.19, "timestamp": "00:28:35", "text": ">> Oh, books."}, {"type": "subtitle", "time": 1720.63, "timestamp": "00:28:40", "text": ">> Yes."}, {"type": "subtitle", "time": 1724.07, "timestamp": "00:28:44", "text": ">> And no, it was our home."}, {"type": "subtitle", "time": 1726.549, "timestamp": "00:28:46", "text": ">> Our home?"}, {"type": "subtitle", "time": 1729.269, "timestamp": "00:28:49", "text": "But I don't remember a thing."}, {"type": "subtitle", "time": 1732.47, "timestamp": "00:28:52", "text": ">> It's okay. Maybe it's all for the best."}, {"type": "subtitle", "time": 1734.149, "timestamp": "00:28:54", "text": "After Make it out. We'll build a new"}]
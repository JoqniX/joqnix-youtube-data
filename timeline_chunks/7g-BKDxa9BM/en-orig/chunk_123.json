[{"type": "subtitle", "time": 7404.229, "timestamp": "02:03:24", "text": "They should have made it so you can"}, {"type": "subtitle", "time": 7406.55, "timestamp": "02:03:26", "text": "climb walls all the way up here. You"}, {"type": "subtitle", "time": 7407.669, "timestamp": "02:03:27", "text": "said you were going to share the money"}, {"type": "subtitle", "time": 7410.07, "timestamp": "02:03:30", "text": "with the poor anyway, so why can't I get"}, {"type": "subtitle", "time": 7412.79, "timestamp": "02:03:32", "text": "a piece of it?"}, {"type": "subtitle", "time": 7415.91, "timestamp": "02:03:35", "text": "If you're hard up, I can help you. But"}, {"type": "subtitle", "time": 7418.47, "timestamp": "02:03:38", "text": "you can't just grab money off people."}, {"type": "subtitle", "time": 7419.83, "timestamp": "02:03:39", "text": "That'll earn you a whack on the head"}, {"type": "subtitle", "time": 7427.189, "timestamp": "02:03:47", "text": "[Music]"}, {"type": "subtitle", "time": 7430.39, "timestamp": "02:03:50", "text": ">> He's disappeared again. What is he? A"}, {"type": "subtitle", "time": 7431.669, "timestamp": "02:03:51", "text": "ghost?"}]
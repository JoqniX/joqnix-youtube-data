[{"type": "subtitle", "time": 7804.47, "timestamp": "02:10:04", "text": "So, so commissions are stuff where you"}, {"type": "subtitle", "time": 7807.589, "timestamp": "02:10:07", "text": "can keep on farming."}, {"type": "subtitle", "time": 7811.03, "timestamp": "02:10:11", "text": "If you need character XP, you farm this."}, {"type": "subtitle", "time": 7813.669, "timestamp": "02:10:13", "text": "If you need weapon XP, you farm this."}, {"type": "subtitle", "time": 7815.35, "timestamp": "02:10:15", "text": "You need character ascension mater, you"}, {"type": "subtitle", "time": 7818.31, "timestamp": "02:10:18", "text": "farm this."}, {"type": "subtitle", "time": 7820.709, "timestamp": "02:10:20", "text": "Weapon ascension mater, you farm this."}, {"type": "subtitle", "time": 7824.72, "timestamp": "02:10:24", "text": "Demoners, you farm this."}, {"type": "subtitle", "time": 7832.39, "timestamp": "02:10:32", "text": "[Music]"}, {"type": "subtitle", "time": 7835.51, "timestamp": "02:10:35", "text": "Come on."}, {"type": "subtitle", "time": 7843.71, "timestamp": "02:10:43", "text": ">> I'll take a 20% cut. You keep 80%."}, {"type": "subtitle", "time": 7849.109, "timestamp": "02:10:49", "text": "[Music]"}, {"type": "subtitle", "time": 7852.02, "timestamp": "02:10:52", "text": ">> Mystic mage."}]
[{"type": "subtitle", "time": 7320.229, "timestamp": "02:02:00", "text": "sure."}, {"type": "subtitle", "time": 7324.149, "timestamp": "02:02:04", "text": ">> Wow. But this really is"}, {"type": "subtitle", "time": 7337.669, "timestamp": "02:02:17", "text": "Check this out. Two layers of crates"}, {"type": "subtitle", "time": 7340.47, "timestamp": "02:02:20", "text": "against the wall. According to the state"}, {"type": "subtitle", "time": 7342.95, "timestamp": "02:02:22", "text": "thus Margie, the reticent detective"}, {"type": "subtitle", "time": 7345.27, "timestamp": "02:02:25", "text": "deduces that desperate thief must have"}, {"type": "subtitle", "time": 7347.83, "timestamp": "02:02:27", "text": "stacked these crates to climb the wall."}, {"type": "subtitle", "time": 7349.91, "timestamp": "02:02:29", "text": ">> Smart thinking."}, {"type": "subtitle", "time": 7352.87, "timestamp": "02:02:32", "text": "So reticent detective, that's your"}, {"type": "subtitle", "time": 7356.79, "timestamp": "02:02:36", "text": "title, Margie. Sounds cool. A bit short"}, {"type": "subtitle", "time": 7359.669, "timestamp": "02:02:39", "text": "though. Could use more punch."}, {"type": "subtitle", "time": 7362.31, "timestamp": "02:02:42", "text": "Makes sense. Any suggestions, demon"}, {"type": "subtitle", "time": 7364.709, "timestamp": "02:02:44", "text": "king?"}, {"type": "subtitle", "time": 7371.83, "timestamp": "02:02:51", "text": "[Music]"}, {"type": "subtitle", "time": 7373.589, "timestamp": "02:02:53", "text": ">> That old man back there called you"}, {"type": "subtitle", "time": 7375.669, "timestamp": "02:02:55", "text": "princess rubbish bin."}]
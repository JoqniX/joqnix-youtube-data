[{"type": "subtitle", "time": 24604.39, "timestamp": "06:50:04", "text": ">> The butterflies makes it more emotional."}, {"type": "subtitle", "time": 24607.51, "timestamp": "06:50:07", "text": ">> Where does this river lead?"}, {"type": "subtitle", "time": 24609.67, "timestamp": "06:50:09", "text": "I'm not sure."}, {"type": "subtitle", "time": 24612.548, "timestamp": "06:50:12", "text": "Maybe to the oceaner."}, {"type": "subtitle", "time": 24615.11, "timestamp": "06:50:15", "text": "That can't be right."}, {"type": "subtitle", "time": 24617.67, "timestamp": "06:50:17", "text": "I remember reading that ocean when I"}, {"type": "subtitle", "time": 24620.468, "timestamp": "06:50:20", "text": "tried the water here before. Really?"}, {"type": "subtitle", "time": 24622.15, "timestamp": "06:50:22", "text": "What's wrong?"}, {"type": "subtitle", "time": 24626.548, "timestamp": "06:50:26", "text": "That's freezing my whole mouth."}, {"type": "subtitle", "time": 24630.07, "timestamp": "06:50:30", "text": "Let's head to the lakeside."}, {"type": "subtitle", "time": 24632.23, "timestamp": "06:50:32", "text": "When I was little,"}, {"type": "subtitle", "time": 24635.67, "timestamp": "06:50:35", "text": "I thought if I just kept running,"}, {"type": "subtitle", "time": 24639.27, "timestamp": "06:50:39", "text": "this flower looks familiar."}, {"type": "subtitle", "time": 24640.948, "timestamp": "06:50:40", "text": ">> Really?"}, {"type": "subtitle", "time": 24644.39, "timestamp": "06:50:44", "text": ">> Would you like to pick it as a No. Just"}, {"type": "subtitle", "time": 24648.31, "timestamp": "06:50:48", "text": "knowing it's here is enough for me."}]
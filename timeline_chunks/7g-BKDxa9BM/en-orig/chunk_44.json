[{"type": "subtitle", "time": 2643.109, "timestamp": "00:44:03", "text": ">> This power didn't change anything."}, {"type": "subtitle", "time": 2646.55, "timestamp": "00:44:06", "text": "I fell into the sea and I'll never wake"}, {"type": "subtitle", "time": 2648.47, "timestamp": "00:44:08", "text": "up again."}, {"type": "subtitle", "time": 2651.51, "timestamp": "00:44:11", "text": ">> No, I can see it."}, {"type": "subtitle", "time": 2653.67, "timestamp": "00:44:13", "text": "Your future. Our future."}, {"type": "subtitle", "time": 2657.51, "timestamp": "00:44:17", "text": ">> What is this dust? Sand. Moon sand."}, {"type": "subtitle", "time": 2659.75, "timestamp": "00:44:19", "text": ">> Someone will pluck you from the briny"}, {"type": "subtitle", "time": 2660.55, "timestamp": "00:44:20", "text": "waters."}, {"type": "subtitle", "time": 2662.87, "timestamp": "00:44:22", "text": ">> Are you saying"}, {"type": "subtitle", "time": 2664.63, "timestamp": "00:44:24", "text": "I'm still alive?"}, {"type": "subtitle", "time": 2666.95, "timestamp": "00:44:26", "text": ">> It's time to set off. Life is like a"}, {"type": "subtitle", "time": 2668.95, "timestamp": "00:44:28", "text": "lonely cruise through the boundless"}, {"type": "subtitle", "time": 2670.63, "timestamp": "00:44:30", "text": "darkness of the night."}, {"type": "subtitle", "time": 2673.51, "timestamp": "00:44:33", "text": ">> Okay. The river weeps, overflowing its"}, {"type": "subtitle", "time": 2676.069, "timestamp": "00:44:36", "text": "banks, while the thorny thickets on"}, {"type": "subtitle", "time": 2678.79, "timestamp": "00:44:38", "text": "either side stand as a testament to its"}, {"type": "subtitle", "time": 2679.99, "timestamp": "00:44:39", "text": "sorrow."}, {"type": "subtitle", "time": 2681.589, "timestamp": "00:44:41", "text": ">> Horny fig."}, {"type": "subtitle", "time": 2683.91, "timestamp": "00:44:43", "text": ">> I'll keep watching over you, the one"}, {"type": "subtitle", "time": 2686.87, "timestamp": "00:44:46", "text": "across the shore, to see where you're"}, {"type": "subtitle", "time": 2699.03, "timestamp": "00:44:59", "text": "landing a large cat. There's fishing in"}]
[{"type": "subtitle", "time": 5220.39, "timestamp": "01:27:00", "text": ">> Sanctuary."}, {"type": "subtitle", "time": 5223.03, "timestamp": "01:27:03", "text": "Oh, this is our main hub. Oh,"}, {"type": "subtitle", "time": 5225.91, "timestamp": "01:27:05", "text": ">> this room has just been cleaned up. You"}, {"type": "subtitle", "time": 5229.11, "timestamp": "01:27:09", "text": "can stay here tonight."}, {"type": "subtitle", "time": 5231.75, "timestamp": "01:27:11", "text": ">> Cool."}, {"type": "subtitle", "time": 5233.669, "timestamp": "01:27:13", "text": ">> Don't be upset."}, {"type": "subtitle", "time": 5237.11, "timestamp": "01:27:17", "text": "Mr. Henrik isn't really that greedy."}, {"type": "subtitle", "time": 5239.189, "timestamp": "01:27:19", "text": "It's just we've been quite strapped for"}, {"type": "subtitle", "time": 5241.83, "timestamp": "01:27:21", "text": "cash lately. Otherwise, he wouldn't"}, {"type": "subtitle", "time": 5243.669, "timestamp": "01:27:23", "text": "consider selling his old house to make"}, {"type": "subtitle", "time": 5245.99, "timestamp": "01:27:25", "text": "ends meet."}, {"type": "subtitle", "time": 5246.31, "timestamp": "01:27:26", "text": ">> Oh,"}, {"type": "subtitle", "time": 5249.03, "timestamp": "01:27:29", "text": ">> it's been neglected for years. But after"}, {"type": "subtitle", "time": 5253.11, "timestamp": "01:27:33", "text": "a good clean, it's not half bad, right?"}, {"type": "subtitle", "time": 5256.229, "timestamp": "01:27:36", "text": "At least it keeps out the chill."}, {"type": "subtitle", "time": 5257.35, "timestamp": "01:27:37", "text": ">> Oh,"}, {"type": "subtitle", "time": 5260.31, "timestamp": "01:27:40", "text": ">> I haven't introduced myself."}, {"type": "subtitle", "time": 5261.59, "timestamp": "01:27:41", "text": ">> I'm Psyche."}, {"type": "subtitle", "time": 5262.07, "timestamp": "01:27:42", "text": ">> Psyche,"}, {"type": "subtitle", "time": 5265.03, "timestamp": "01:27:45", "text": ">> the lodger at the Hypnos House, and"}, {"type": "subtitle", "time": 5267.83, "timestamp": "01:27:47", "text": "sometimes I help Mr. Henrik out."}, {"type": "subtitle", "time": 5269.83, "timestamp": "01:27:49", "text": ">> Oh,"}, {"type": "subtitle", "time": 5270.39, "timestamp": "01:27:50", "text": "I'm joking."}, {"type": "subtitle", "time": 5274.149, "timestamp": "01:27:54", "text": ">> Quite an uncommon name in this city."}, {"type": "subtitle", "time": 5278.229, "timestamp": "01:27:58", "text": ">> Mr. Henrik mentioned you're not a local."}]
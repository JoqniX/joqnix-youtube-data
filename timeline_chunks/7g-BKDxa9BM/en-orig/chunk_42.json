[{"type": "subtitle", "time": 2523.03, "timestamp": "00:42:03", "text": ">> Hang in there. I got you."}, {"type": "subtitle", "time": 2525.43, "timestamp": "00:42:05", "text": ">> No. No."}, {"type": "subtitle", "time": 2527.27, "timestamp": "00:42:07", "text": ">> Oh, wait."}, {"type": "subtitle", "time": 2529.99, "timestamp": "00:42:09", "text": ">> Give it up. Number zero."}, {"type": "subtitle", "time": 2532.71, "timestamp": "00:42:12", "text": "Even the toughest blade has it."}, {"type": "subtitle", "time": 2536.55, "timestamp": "00:42:16", "text": ">> No. No. No, no, don't. Don't remove her"}, {"type": "subtitle", "time": 2541.109, "timestamp": "00:42:21", "text": "arm. Please care so much about"}, {"type": "subtitle", "time": 2542.87, "timestamp": "00:42:22", "text": ">> otherwise she will"}, {"type": "subtitle", "time": 2549.27, "timestamp": "00:42:29", "text": ">> I'll go back with you. But you have to"}, {"type": "subtitle", "time": 2551.99, "timestamp": "00:42:31", "text": "promise to let her go."}, {"type": "subtitle", "time": 2555.27, "timestamp": "00:42:35", "text": ">> Give me your word or you can take two"}, {"type": "subtitle", "time": 2557.109, "timestamp": "00:42:37", "text": "corpses back."}, {"type": "subtitle", "time": 2560.79, "timestamp": "00:42:40", "text": ">> Perhaps I wasn't clear."}, {"type": "subtitle", "time": 2563.03, "timestamp": "00:42:43", "text": ">> This is not a negotiation."}, {"type": "subtitle", "time": 2570.39, "timestamp": "00:42:50", "text": ">> No, no, no."}, {"type": "subtitle", "time": 2573.99, "timestamp": "00:42:53", "text": ">> You out of here."}]
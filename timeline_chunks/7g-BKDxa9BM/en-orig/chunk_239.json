[{"type": "subtitle", "time": 14340.309, "timestamp": "03:59:00", "text": ">> Sure kind."}, {"type": "subtitle", "time": 14342.95, "timestamp": "03:59:02", "text": ">> So if you ever run into a lost genimon,"}, {"type": "subtitle", "time": 14345.51, "timestamp": "03:59:05", "text": "try treating it to a yum treat to get it"}, {"type": "subtitle", "time": 14346.71, "timestamp": "03:59:06", "text": "to follow you."}, {"type": "subtitle", "time": 14348.79, "timestamp": "03:59:08", "text": ">> That way it won't end up in the hands of"}, {"type": "subtitle", "time": 14351.349, "timestamp": "03:59:11", "text": "those bad Genieon hunters."}, {"type": "subtitle", "time": 14353.429, "timestamp": "03:59:13", "text": "Yeah, the bad genie hunters."}, {"type": "subtitle", "time": 14356.229, "timestamp": "03:59:16", "text": ">> If the genie hunter hunter says so, I'll"}, {"type": "subtitle", "time": 14358.79, "timestamp": "03:59:18", "text": "make the little minion collects tons of"}, {"type": "subtitle", "time": 14366.15, "timestamp": "03:59:26", "text": ">> Hold all to select the armory."}, {"type": "subtitle", "time": 14369.269, "timestamp": "03:59:29", "text": ">> Are you inviting me on a date?"}, {"type": "subtitle", "time": 14376.15, "timestamp": "03:59:36", "text": "upgrade. Deploy. Upgrade."}, {"type": "subtitle", "time": 14379.75, "timestamp": "03:59:39", "text": "What do you think? Yum. Yum. Cream."}, {"type": "subtitle", "time": 14381.59, "timestamp": "03:59:41", "text": "Okay."}]
[{"type": "subtitle", "time": 13981.429, "timestamp": "03:53:01", "text": ">> Hello. May I ask?"}, {"type": "subtitle", "time": 13981.91, "timestamp": "03:53:01", "text": ">> Shh."}, {"type": "subtitle", "time": 13983.91, "timestamp": "03:53:03", "text": ">> Keep it down."}, {"type": "subtitle", "time": 13987.429, "timestamp": "03:53:07", "text": ">> Keep those secrets expecting something."}, {"type": "subtitle", "time": 13993.349, "timestamp": "03:53:13", "text": "Oh, my bad. So, you're also here for"}, {"type": "subtitle", "time": 13996.87, "timestamp": "03:53:16", "text": ">> Yep. What? You guys, too? First come,"}, {"type": "subtitle", "time": 14001.75, "timestamp": "03:53:21", "text": "first served. No line."}, {"type": "subtitle", "time": 14004.15, "timestamp": "03:53:24", "text": ">> There's even a queue for this."}, {"type": "subtitle", "time": 14007.269, "timestamp": "03:53:27", "text": ">> I mean, it's huge. There's enough for"}, {"type": "subtitle", "time": 14009.51, "timestamp": "03:53:29", "text": "everyone."}, {"type": "subtitle", "time": 14011.75, "timestamp": "03:53:31", "text": ">> But fine, we'll just watch from the"}, {"type": "subtitle", "time": 14014.309, "timestamp": "03:53:34", "text": "sidelines. Once you're done, we'll take"}, {"type": "subtitle", "time": 14016.95, "timestamp": "03:53:36", "text": "a closer look."}, {"type": "subtitle", "time": 14019.75, "timestamp": "03:53:39", "text": "Why do I feel like you're not talking"}, {"type": "subtitle", "time": 14022.71, "timestamp": "03:53:42", "text": "about the same thing?"}, {"type": "subtitle", "time": 14025.349, "timestamp": "03:53:45", "text": ">> What else would it be? Anyone who comes"}, {"type": "subtitle", "time": 14029.429, "timestamp": "03:53:49", "text": "here is obviously here for"}, {"type": "subtitle", "time": 14034.87, "timestamp": "03:53:54", "text": ">> now. Pull the rope."}]
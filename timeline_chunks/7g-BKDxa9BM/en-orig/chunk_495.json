[{"type": "subtitle", "time": 29701.99, "timestamp": "08:15:01", "text": ">> No,"}, {"type": "subtitle", "time": 29712.388, "timestamp": "08:15:12", "text": "I killed"}, {"type": "subtitle", "time": 29715.35, "timestamp": "08:15:15", "text": "myself."}, {"type": "subtitle", "time": 29717.51, "timestamp": "08:15:17", "text": "I can't"}, {"type": "subtitle", "time": 29720.07, "timestamp": "08:15:20", "text": "and I don't want to"}, {"type": "subtitle", "time": 29722.868, "timestamp": "08:15:22", "text": "live like this."}, {"type": "subtitle", "time": 29726.15, "timestamp": "08:15:26", "text": "Chin up, Psyche. You said you dreamt of"}, {"type": "subtitle", "time": 29728.948, "timestamp": "08:15:28", "text": "a place warm and full of blooming"}, {"type": "subtitle", "time": 29730.388, "timestamp": "08:15:30", "text": "flowers."}, {"type": "subtitle", "time": 29731.19, "timestamp": "08:15:31", "text": ">> Mhm."}, {"type": "subtitle", "time": 29733.35, "timestamp": "08:15:33", "text": ">> You've said it yourself."}, {"type": "subtitle", "time": 29737.11, "timestamp": "08:15:37", "text": "Flowers bring good luck."}, {"type": "subtitle", "time": 29739.11, "timestamp": "08:15:39", "text": ">> Yes,"}, {"type": "subtitle", "time": 29741.83, "timestamp": "08:15:41", "text": "it must be"}, {"type": "subtitle", "time": 29745.03, "timestamp": "08:15:45", "text": "a beautiful place."}, {"type": "subtitle", "time": 29747.19, "timestamp": "08:15:47", "text": ">> Is it me or her skin is going on?"}, {"type": "subtitle", "time": 29749.99, "timestamp": "08:15:49", "text": ">> Don't just take my word for it. You have"}, {"type": "subtitle", "time": 29753.35, "timestamp": "08:15:53", "text": "to see it for yourself."}, {"type": "subtitle", "time": 29755.43, "timestamp": "08:15:55", "text": "Do you know"}, {"type": "subtitle", "time": 29759.11, "timestamp": "08:15:59", "text": "why I love flowers?"}]
[{"type": "subtitle", "time": 29220.07, "timestamp": "08:07:00", "text": "last thing we can do for her. Mom, Dad,"}, {"type": "subtitle", "time": 29222.868, "timestamp": "08:07:02", "text": "I'm sorry."}, {"type": "subtitle", "time": 29231.03, "timestamp": "08:07:11", "text": "[Music]"}, {"type": "subtitle", "time": 29234.468, "timestamp": "08:07:14", "text": ">> It's all meaningless."}, {"type": "subtitle", "time": 29237.19, "timestamp": "08:07:17", "text": "You bring these things to me every day,"}, {"type": "subtitle", "time": 29239.99, "timestamp": "08:07:19", "text": "but what difference do they make?"}, {"type": "subtitle", "time": 29241.91, "timestamp": "08:07:21", "text": ">> Psyche."}, {"type": "subtitle", "time": 29244.23, "timestamp": "08:07:24", "text": "You should know what it means to be sent"}, {"type": "subtitle", "time": 29248.868, "timestamp": "08:07:28", "text": "here. Yes, I'm aware."}, {"type": "subtitle", "time": 29252.15, "timestamp": "08:07:32", "text": "But are we just living for some kind of"}, {"type": "subtitle", "time": 29255.11, "timestamp": "08:07:35", "text": "meaning?"}, {"type": "subtitle", "time": 29271.59, "timestamp": "08:07:51", "text": ">> Honey, look. Psyche is smiling at us."}, {"type": "subtitle", "time": 29273.35, "timestamp": "08:07:53", "text": ">> I promise"}, {"type": "subtitle", "time": 29276.388, "timestamp": "08:07:56", "text": "her today."}, {"type": "subtitle", "time": 29278.948, "timestamp": "08:07:58", "text": "Wow."}]
[{"type": "subtitle", "time": 24555.75, "timestamp": "06:49:15", "text": "The sun should be setting by now."}, {"type": "subtitle", "time": 24558.548, "timestamp": "06:49:18", "text": "I wonder if Lamenting Lake looks as"}, {"type": "subtitle", "time": 24560.708, "timestamp": "06:49:20", "text": "beautiful as it always does at this"}, {"type": "subtitle", "time": 24569.11, "timestamp": "06:49:29", "text": "Yeah, it's a spectacular view."}, {"type": "subtitle", "time": 24571.35, "timestamp": "06:49:31", "text": ">> Would you like to take a walk with me by"}, {"type": "subtitle", "time": 24580.948, "timestamp": "06:49:40", "text": "[Music]"}, {"type": "subtitle", "time": 24582.708, "timestamp": "06:49:42", "text": ">> Man, the butterflies."}, {"type": "subtitle", "time": 24587.03, "timestamp": "06:49:47", "text": ">> The snow's a bit thick here."}, {"type": "subtitle", "time": 24590.07, "timestamp": "06:49:50", "text": "Could you go first, then?"}, {"type": "subtitle", "time": 24593.91, "timestamp": "06:49:53", "text": "I'll follow in your footsteps. that way."}]
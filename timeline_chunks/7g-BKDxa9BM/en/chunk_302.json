[{"type": "subtitle", "time": 18122.07, "timestamp": "05:02:02", "text": ">> What are you doing here? Didn't I ask"}, {"type": "subtitle", "time": 18124.708, "timestamp": "05:02:04", "text": "you to leave in the morning?"}, {"type": "subtitle", "time": 18127.35, "timestamp": "05:02:07", "text": ">> I've got what you were looking for. The"}, {"type": "subtitle", "time": 18129.03, "timestamp": "05:02:09", "text": "crystalallo of Stella."}, {"type": "subtitle", "time": 18132.628, "timestamp": "05:02:12", "text": ">> No one asked for you to come here."}, {"type": "subtitle", "time": 18135.51, "timestamp": "05:02:15", "text": ">> I'm not from here. I'm not familiar with"}, {"type": "subtitle", "time": 18139.11, "timestamp": "05:02:19", "text": "Ice Lakes's ways. Where I come from, a"}, {"type": "subtitle", "time": 18141.67, "timestamp": "05:02:21", "text": "deal means cash in one hand, goods in"}, {"type": "subtitle", "time": 18143.67, "timestamp": "05:02:23", "text": "the other."}, {"type": "subtitle", "time": 18146.15, "timestamp": "05:02:26", "text": ">> If you're not interested, Mr. Henrik,"}, {"type": "subtitle", "time": 18147.75, "timestamp": "05:02:27", "text": ">> I might just go looking for another"}, {"type": "subtitle", "time": 18153.51, "timestamp": "05:02:33", "text": ">> Come on in."}, {"type": "subtitle", "time": 18163.51, "timestamp": "05:02:43", "text": ">> wait. So, can I play as the main"}, {"type": "subtitle", "time": 18165.99, "timestamp": "05:02:45", "text": "character?"}, {"type": "subtitle", "time": 18169.83, "timestamp": "05:02:49", "text": "So I deploy it like this."}]
[{"type": "subtitle", "time": 5100.39, "timestamp": "01:25:00", "text": ">> Mr. Henrik, I'm back."}, {"type": "subtitle", "time": 5102.55, "timestamp": "01:25:02", "text": ">> I just tidied up the house again and"}, {"type": "subtitle", "time": 5105.43, "timestamp": "01:25:05", "text": "it's all set."}, {"type": "subtitle", "time": 5106.81, "timestamp": "01:25:06", "text": "Be careful."}, {"type": "subtitle", "time": 5108.31, "timestamp": "01:25:08", "text": "[Music]"}, {"type": "subtitle", "time": 5110.229, "timestamp": "01:25:10", "text": ">> Who's this lady?"}, {"type": "subtitle", "time": 5115.27, "timestamp": "01:25:15", "text": ">> Are you a new lodger?"}, {"type": "subtitle", "time": 5118.95, "timestamp": "01:25:18", "text": ">> She looks like a looking for"}, {"type": "subtitle", "time": 5121.99, "timestamp": "01:25:21", "text": ">> I was about to kick her out."}, {"type": "subtitle", "time": 5124.229, "timestamp": "01:25:24", "text": ">> An Ider."}, {"type": "subtitle", "time": 5127.35, "timestamp": "01:25:27", "text": "But if you kick her out, won't she be"}, {"type": "subtitle", "time": 5128.31, "timestamp": "01:25:28", "text": "homeless?"}, {"type": "subtitle", "time": 5130.39, "timestamp": "01:25:30", "text": ">> Exactly. I don't want to be homeless."}, {"type": "subtitle", "time": 5139.43, "timestamp": "01:25:39", "text": ">> But the house is still unsold anyway."}, {"type": "subtitle", "time": 5141.75, "timestamp": "01:25:41", "text": "Lending it to her for one night wouldn't"}, {"type": "subtitle", "time": 5144.47, "timestamp": "01:25:44", "text": "hurt, right?"}, {"type": "subtitle", "time": 5147.189, "timestamp": "01:25:47", "text": "She can pay you back when she can. That"}, {"type": "subtitle", "time": 5149.669, "timestamp": "01:25:49", "text": "way, we get a little extra cash for"}, {"type": "subtitle", "time": 5152.79, "timestamp": "01:25:52", "text": "basically nothing."}, {"type": "subtitle", "time": 5155.669, "timestamp": "01:25:55", "text": "If you keep being so cold to everyone,"}, {"type": "subtitle", "time": 5157.27, "timestamp": "01:25:57", "text": "you'll never find a buyer for that"}, {"type": "subtitle", "time": 5159.59, "timestamp": "01:25:59", "text": "place."}]
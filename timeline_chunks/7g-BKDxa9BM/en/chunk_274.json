[{"type": "subtitle", "time": 16442.23, "timestamp": "04:34:02", "text": ">> I got to do this. Come on. There seems"}, {"type": "subtitle", "time": 16445.189, "timestamp": "04:34:05", "text": "to be in the pit."}, {"type": "subtitle", "time": 16446.949, "timestamp": "04:34:06", "text": ">> The journal mentioned that there could"}, {"type": "subtitle", "time": 16448.789, "timestamp": "04:34:08", "text": "be a special filthoid."}, {"type": "subtitle", "time": 16451.269, "timestamp": "04:34:11", "text": ">> Look, a giant crystal in the middle is"}, {"type": "subtitle", "time": 16454.47, "timestamp": "04:34:14", "text": "glowing. Could it be that the crystal of"}, {"type": "subtitle", "time": 16464.869, "timestamp": "04:34:24", "text": ">> Voice again."}, {"type": "subtitle", "time": 16467.029, "timestamp": "04:34:27", "text": ">> Sweet."}, {"type": "subtitle", "time": 16469.269, "timestamp": "04:34:29", "text": ">> How come there are so many filths coming"}, {"type": "subtitle", "time": 16472.15, "timestamp": "04:34:32", "text": "at us out of nowhere?"}, {"type": "subtitle", "time": 16475.029, "timestamp": "04:34:35", "text": "Put one here."}, {"type": "subtitle", "time": 16476.47, "timestamp": "04:34:36", "text": ">> Put one here."}, {"type": "subtitle", "time": 16479.429, "timestamp": "04:34:39", "text": ">> Take my shiny bomb."}, {"type": "subtitle", "time": 16480.551, "timestamp": "04:34:40", "text": ">> It's okay."}, {"type": "subtitle", "time": 16489.029, "timestamp": "04:34:49", "text": ">> yellow crystal spikes actually have so"}, {"type": "subtitle", "time": 16491.83, "timestamp": "04:34:51", "text": "many glittering stones inside."}, {"type": "subtitle", "time": 16493.99, "timestamp": "04:34:53", "text": ">> They seem to have been carefully hidden"}, {"type": "subtitle", "time": 16498.15, "timestamp": "04:34:58", "text": "away like cherished treasures."}]
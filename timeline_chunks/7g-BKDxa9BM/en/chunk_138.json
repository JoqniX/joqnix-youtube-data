[{"type": "subtitle", "time": 8295.19, "timestamp": "02:18:15", "text": "Nice."}, {"type": "subtitle", "time": 8297.509, "timestamp": "02:18:17", "text": "I will punish those who aren't faithful"}, {"type": "subtitle", "time": 8301.429, "timestamp": "02:18:21", "text": "to love in the god of love's name."}, {"type": "subtitle", "time": 8304.79, "timestamp": "02:18:24", "text": ">> Can't be ascended."}, {"type": "subtitle", "time": 8313.509, "timestamp": "02:18:33", "text": "I'll focus on Rebecca. Then I'll focus"}, {"type": "subtitle", "time": 8315.83, "timestamp": "02:18:35", "text": "on other characters one by one. Slowly,"}, {"type": "subtitle", "time": 8333.19, "timestamp": "02:18:53", "text": ">> are you inviting me on a date?"}]
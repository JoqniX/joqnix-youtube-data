[{"type": "subtitle", "time": 17580.39, "timestamp": "04:53:00", "text": "Look, I went out."}, {"type": "subtitle", "time": 17584.708, "timestamp": "04:53:04", "text": ">> Is this a cake? But there aren't any"}, {"type": "subtitle", "time": 17587.03, "timestamp": "04:53:07", "text": "cake shops in the neighborhood."}, {"type": "subtitle", "time": 17589.59, "timestamp": "04:53:09", "text": ">> I have my ways."}, {"type": "subtitle", "time": 17591.11, "timestamp": "04:53:11", "text": ">> You know I am a magician of"}, {"type": "subtitle", "time": 17593.75, "timestamp": "04:53:13", "text": "extraordinary wisdom."}, {"type": "subtitle", "time": 17608.47, "timestamp": "04:53:28", "text": ">> Stars. Aw,"}, {"type": "subtitle", "time": 17610.55, "timestamp": "04:53:30", "text": ">> twinkling"}, {"type": "subtitle", "time": 17613.59, "timestamp": "04:53:33", "text": "shining stars."}, {"type": "subtitle", "time": 17616.788, "timestamp": "04:53:36", "text": "You read the story I wrote, didn't you?"}, {"type": "subtitle", "time": 17619.83, "timestamp": "04:53:39", "text": "The nighting gale yearned for the sky,"}, {"type": "subtitle", "time": 17623.43, "timestamp": "04:53:43", "text": "but it was ever so dark. If only I could"}, {"type": "subtitle", "time": 17628.15, "timestamp": "04:53:48", "text": "see the stars once, she wished silently."}, {"type": "subtitle", "time": 17631.35, "timestamp": "04:53:51", "text": "Even but for a fleeting moment."}, {"type": "subtitle", "time": 17634.788, "timestamp": "04:53:54", "text": "Nights and ice are always so misty."}, {"type": "subtitle", "time": 17637.03, "timestamp": "04:53:57", "text": "So you"}, {"type": "subtitle", "time": 17639.91, "timestamp": "04:53:59", "text": "conjured up a starry sky."}]
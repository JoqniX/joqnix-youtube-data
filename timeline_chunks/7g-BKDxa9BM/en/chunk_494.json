[{"type": "subtitle", "time": 29640.23, "timestamp": "08:14:00", "text": ">> Welcome back, Psyche."}, {"type": "subtitle", "time": 29642.948, "timestamp": "08:14:02", "text": "Long as I"}, {"type": "subtitle", "time": 29645.43, "timestamp": "08:14:05", "text": ">> still ended up"}, {"type": "subtitle", "time": 29648.388, "timestamp": "08:14:08", "text": "hurting you all."}, {"type": "subtitle", "time": 29651.99, "timestamp": "08:14:11", "text": "I'm so sorry."}, {"type": "subtitle", "time": 29653.99, "timestamp": "08:14:13", "text": "It's okay."}, {"type": "subtitle", "time": 29656.948, "timestamp": "08:14:16", "text": "Let's go home together."}, {"type": "subtitle", "time": 29660.31, "timestamp": "08:14:20", "text": "They wanted me to tell you. They're all"}, {"type": "subtitle", "time": 29663.19, "timestamp": "08:14:23", "text": "waiting for you."}, {"type": "subtitle", "time": 29665.35, "timestamp": "08:14:25", "text": ">> Home,"}, {"type": "subtitle", "time": 29668.468, "timestamp": "08:14:28", "text": "but it's already"}, {"type": "subtitle", "time": 29670.868, "timestamp": "08:14:30", "text": "too late."}, {"type": "subtitle", "time": 29673.43, "timestamp": "08:14:33", "text": "Outsider, are anyone know all? Didn't"}, {"type": "subtitle", "time": 29675.19, "timestamp": "08:14:35", "text": "you say your brain was a million times"}, {"type": "subtitle", "time": 29688.708, "timestamp": "08:14:48", "text": ">> It's too late. She's fatally wounded."}, {"type": "subtitle", "time": 29691.43, "timestamp": "08:14:51", "text": "She won't make it even as a filthoid."}, {"type": "subtitle", "time": 29693.35, "timestamp": "08:14:53", "text": ">> No,"}, {"type": "subtitle", "time": 29695.35, "timestamp": "08:14:55", "text": "we are the main character."}, {"type": "subtitle", "time": 29696.868, "timestamp": "08:14:56", "text": ">> We are the protagonist. We have some"}, {"type": "subtitle", "time": 29697.51, "timestamp": "08:14:57", "text": "power."}, {"type": "subtitle", "time": 29699.67, "timestamp": "08:14:59", "text": ">> Hard."}]
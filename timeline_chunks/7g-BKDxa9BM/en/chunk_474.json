[{"type": "subtitle", "time": 28441.43, "timestamp": "07:54:01", "text": "struggle. Hello,"}, {"type": "subtitle", "time": 28443.91, "timestamp": "07:54:03", "text": ">> father in despair."}, {"type": "subtitle", "time": 28446.788, "timestamp": "07:54:06", "text": ">> We've been wrong about you all along. Do"}, {"type": "subtitle", "time": 28450.23, "timestamp": "07:54:10", "text": "not forgive. I brought them"}, {"type": "subtitle", "time": 28456.23, "timestamp": "07:54:16", "text": ">> Then what happened to Psyche?"}, {"type": "subtitle", "time": 28458.07, "timestamp": "07:54:18", "text": ">> I tried"}, {"type": "subtitle", "time": 28461.03, "timestamp": "07:54:21", "text": "with the crystallos, but still couldn't."}, {"type": "subtitle", "time": 28464.07, "timestamp": "07:54:24", "text": "I was supposed to let her go. Like all"}, {"type": "subtitle", "time": 28467.99, "timestamp": "07:54:27", "text": "the others, she knew what was coming."}, {"type": "subtitle", "time": 28472.548, "timestamp": "07:54:32", "text": "Yet she's always worn a smile."}, {"type": "subtitle", "time": 28475.27, "timestamp": "07:54:35", "text": ">> For months I'm old."}, {"type": "subtitle", "time": 28478.548, "timestamp": "07:54:38", "text": ">> I couldn't do it again."}, {"type": "subtitle", "time": 28481.27, "timestamp": "07:54:41", "text": ">> So in your hesitation,"}, {"type": "subtitle", "time": 28483.35, "timestamp": "07:54:43", "text": "you missed the last window."}, {"type": "subtitle", "time": 28483.75, "timestamp": "07:54:43", "text": ">> Oh, looks"}, {"type": "subtitle", "time": 28485.27, "timestamp": "07:54:45", "text": ">> like you lost her mind, attacked you,"}, {"type": "subtitle", "time": 28487.03, "timestamp": "07:54:47", "text": "and ran away."}, {"type": "subtitle", "time": 28491.03, "timestamp": "07:54:51", "text": ">> How come? I can't believe"}, {"type": "subtitle", "time": 28493.03, "timestamp": "07:54:53", "text": ">> you're demons."}, {"type": "subtitle", "time": 28496.468, "timestamp": "07:54:56", "text": "You can stop that child."}, {"type": "subtitle", "time": 28499.83, "timestamp": "07:54:59", "text": "She has such a gentle soul."}]
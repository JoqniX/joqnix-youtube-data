[{"type": "subtitle", "time": 25141.75, "timestamp": "06:59:01", "text": "Forsakens. Later, I heard he got nabbed"}, {"type": "subtitle", "time": 25143.67, "timestamp": "06:59:03", "text": "for stealing. And when they found out he"}, {"type": "subtitle", "time": 25145.51, "timestamp": "06:59:05", "text": "was a deteriorator, they took him"}, {"type": "subtitle", "time": 25147.35, "timestamp": "06:59:07", "text": "straight to the security bureau. Like I"}, {"type": "subtitle", "time": 25149.75, "timestamp": "06:59:09", "text": "said, there's no cure for deteriorators,"}, {"type": "subtitle", "time": 25150.15, "timestamp": "06:59:10", "text": "so"}, {"type": "subtitle", "time": 25150.628, "timestamp": "06:59:10", "text": ">> that's good."}, {"type": "subtitle", "time": 25152.39, "timestamp": "06:59:12", "text": ">> What else? He pretty much had it coming."}, {"type": "subtitle", "time": 25154.628, "timestamp": "06:59:14", "text": "But still, we were friends for a few"}, {"type": "subtitle", "time": 25156.31, "timestamp": "06:59:16", "text": "years. I couldn't bear the thought of"}, {"type": "subtitle", "time": 25158.07, "timestamp": "06:59:18", "text": "him lying in a cold morg, so I sneaked"}, {"type": "subtitle", "time": 25160.07, "timestamp": "06:59:20", "text": "him out. I was going to bury him."}, {"type": "subtitle", "time": 25162.788, "timestamp": "06:59:22", "text": ">> Hold on. I'm curious."}, {"type": "subtitle", "time": 25163.83, "timestamp": "06:59:23", "text": ">> What symptoms?"}, {"type": "subtitle", "time": 25165.19, "timestamp": "06:59:25", "text": ">> I wouldn't know,"}, {"type": "subtitle", "time": 25166.948, "timestamp": "06:59:26", "text": ">> but I have heard that some would turn"}, {"type": "subtitle", "time": 25169.35, "timestamp": "06:59:29", "text": "extremely violent and some. This is all"}, {"type": "subtitle", "time": 25171.59, "timestamp": "06:59:31", "text": "just hearsay, though. If you're curious"}, {"type": "subtitle", "time": 25174.39, "timestamp": "06:59:34", "text": "about it,"}, {"type": "subtitle", "time": 25176.39, "timestamp": "06:59:36", "text": ">> oh no,"}, {"type": "subtitle", "time": 25178.788, "timestamp": "06:59:38", "text": ">> I got it. I suddenly couldn't see"}, {"type": "subtitle", "time": 25180.948, "timestamp": "06:59:40", "text": "clearly back there and ended up"}, {"type": "subtitle", "time": 25184.708, "timestamp": "06:59:44", "text": "startling that monster psyche."}, {"type": "subtitle", "time": 25187.67, "timestamp": "06:59:47", "text": "Who was it? Could Psyche sight loss be a"}, {"type": "subtitle", "time": 25189.19, "timestamp": "06:59:49", "text": "symptom of deterioration?"}, {"type": "subtitle", "time": 25191.99, "timestamp": "06:59:51", "text": ">> All the determinators that the Hypnos"}, {"type": "subtitle", "time": 25194.31, "timestamp": "06:59:54", "text": "have, sir, I'd like to inquire about"}, {"type": "subtitle", "time": 25197.11, "timestamp": "06:59:57", "text": "someone. And I hope you'll be frank and"}, {"type": "subtitle", "time": 25198.708, "timestamp": "06:59:58", "text": "supportive."}]
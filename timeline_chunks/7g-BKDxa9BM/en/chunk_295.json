[{"type": "subtitle", "time": 17702.55, "timestamp": "04:55:02", "text": ">> One time, that fisherman somehow got his"}, {"type": "subtitle", "time": 17705.19, "timestamp": "04:55:05", "text": "hands on some imperial supplies,"}, {"type": "subtitle", "time": 17708.55, "timestamp": "04:55:08", "text": "including two jars of sugar, and she"}, {"type": "subtitle", "time": 17711.67, "timestamp": "04:55:11", "text": "traded half a month's wages for one"}, {"type": "subtitle", "time": 17713.51, "timestamp": "04:55:13", "text": "small jar."}, {"type": "subtitle", "time": 17714.47, "timestamp": "04:55:14", "text": ">> Oh."}, {"type": "subtitle", "time": 17716.788, "timestamp": "04:55:16", "text": ">> It was the first time she got hold of"}, {"type": "subtitle", "time": 17719.11, "timestamp": "04:55:19", "text": "any sugar, and she didn't know how to"}, {"type": "subtitle", "time": 17720.39, "timestamp": "04:55:20", "text": "use it."}, {"type": "subtitle", "time": 17722.15, "timestamp": "04:55:22", "text": "simply knowing that it was something"}, {"type": "subtitle", "time": 17725.67, "timestamp": "04:55:25", "text": "valuable and delicious, she poured it"}, {"type": "subtitle", "time": 17733.19, "timestamp": "04:55:33", "text": ">> By the time we grew up and started"}, {"type": "subtitle", "time": 17736.15, "timestamp": "04:55:36", "text": "earning more, sugar wasn't such a luxury"}, {"type": "subtitle", "time": 17736.948, "timestamp": "04:55:36", "text": "anymore."}, {"type": "subtitle", "time": 17740.47, "timestamp": "04:55:40", "text": ">> Goodness, that sounds horrible."}, {"type": "subtitle", "time": 17744.07, "timestamp": "04:55:44", "text": "I can almost smell that sickly sweet."}, {"type": "subtitle", "time": 17744.788, "timestamp": "04:55:44", "text": ">> Oh my god."}, {"type": "subtitle", "time": 17746.15, "timestamp": "04:55:46", "text": ">> She owes you an apology."}, {"type": "subtitle", "time": 17747.59, "timestamp": "04:55:47", "text": ">> How can you smell it?"}, {"type": "subtitle", "time": 17749.59, "timestamp": "04:55:49", "text": "She owes the sugar and the fifth"}, {"type": "subtitle", "time": 17751.75, "timestamp": "04:55:51", "text": "apology."}, {"type": "subtitle", "time": 17754.628, "timestamp": "04:55:54", "text": ">> No outsider, you're missing. I believe"}, {"type": "subtitle", "time": 17757.27, "timestamp": "04:55:57", "text": "that lady who always used a lot of sugar"}]
[{"type": "subtitle", "time": 7742.149, "timestamp": "02:09:02", "text": ">> I need money. Who doesn't? I've got"}, {"type": "subtitle", "time": 7743.589, "timestamp": "02:09:03", "text": "folks owing me a fortune."}, {"type": "subtitle", "time": 7745.43, "timestamp": "02:09:05", "text": ">> You're back."}, {"type": "subtitle", "time": 7747.75, "timestamp": "02:09:07", "text": ">> It was a piece of cake. My little minion"}, {"type": "subtitle", "time": 7749.109, "timestamp": "02:09:09", "text": "and I gave"}, {"type": "subtitle", "time": 7751.27, "timestamp": "02:09:11", "text": ">> So, you're the one who nabbed the thief."}, {"type": "subtitle", "time": 7753.189, "timestamp": "02:09:13", "text": "I thought Snow called you Minion because"}, {"type": "subtitle", "time": 7754.95, "timestamp": "02:09:14", "text": "you got caught by her."}, {"type": "subtitle", "time": 7755.75, "timestamp": "02:09:15", "text": ">> But then again,"}, {"type": "subtitle", "time": 7758.31, "timestamp": "02:09:18", "text": ">> she was the witness of my deeds. You had"}, {"type": "subtitle", "time": 7760.629, "timestamp": "02:09:20", "text": "it all wrong. You've made a fool of"}, {"type": "subtitle", "time": 7763.189, "timestamp": "02:09:23", "text": "yourself this time, haven't you?"}, {"type": "subtitle", "time": 7765.35, "timestamp": "02:09:25", "text": ">> Sorry for what I've just said."}, {"type": "subtitle", "time": 7766.39, "timestamp": "02:09:26", "text": ">> It's on me. Okay."}, {"type": "subtitle", "time": 7769.51, "timestamp": "02:09:29", "text": ">> I'll take a 20% cut. You keep 80% as"}, {"type": "subtitle", "time": 7777.43, "timestamp": "02:09:37", "text": "[Music]"}]
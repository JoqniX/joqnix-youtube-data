[{"type": "subtitle", "time": 7056.55, "timestamp": "01:57:36", "text": "And then out of nowhere, he ambushed me"}, {"type": "subtitle", "time": 7059.189, "timestamp": "01:57:39", "text": "and pinched the cash I'd just gotten."}, {"type": "subtitle", "time": 7061.35, "timestamp": "01:57:41", "text": "Oh, that roter doesn't even spare us"}, {"type": "subtitle", "time": 7062.79, "timestamp": "01:57:42", "text": "scavengers."}, {"type": "subtitle", "time": 7064.95, "timestamp": "01:57:44", "text": "That money was for several families"}, {"type": "subtitle", "time": 7067.43, "timestamp": "01:57:47", "text": "upkeep in the slums."}, {"type": "subtitle", "time": 7069.83, "timestamp": "01:57:49", "text": "Without that bag of coins, all the young"}, {"type": "subtitle", "time": 7071.669, "timestamp": "01:57:51", "text": "and old will have to tighten their belts"}, {"type": "subtitle", "time": 7075.03, "timestamp": "01:57:55", "text": "even more next month."}, {"type": "subtitle", "time": 7077.51, "timestamp": "01:57:57", "text": ">> I have no"}, {"type": "subtitle", "time": 7079.35, "timestamp": "01:57:59", "text": "run off to. I need someone to help me"}]
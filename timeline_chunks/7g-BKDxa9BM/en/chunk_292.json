[{"type": "subtitle", "time": 17524.39, "timestamp": "04:52:04", "text": ">> Outsider,"}, {"type": "subtitle", "time": 17527.51, "timestamp": "04:52:07", "text": "you're home so late today. Where have"}, {"type": "subtitle", "time": 17561.11, "timestamp": "04:52:41", "text": "Was it in the dense woods where snow"}, {"type": "subtitle", "time": 17563.03, "timestamp": "04:52:43", "text": "wolves brown? Or"}, {"type": "subtitle", "time": 17565.51, "timestamp": "04:52:45", "text": ">> I didn't go anywhere. Today is Miss"}, {"type": "subtitle", "time": 17567.27, "timestamp": "04:52:47", "text": "Fina's birthday, so I stayed in Ice"}, {"type": "subtitle", "time": 17568.15, "timestamp": "04:52:48", "text": "Lake."}, {"type": "subtitle", "time": 17568.868, "timestamp": "04:52:48", "text": ">> Ice Lake?"}, {"type": "subtitle", "time": 17572.23, "timestamp": "04:52:52", "text": ">> You always say so. Yet new scars keep"}, {"type": "subtitle", "time": 17575.51, "timestamp": "04:52:55", "text": "appearing on your arms."}, {"type": "subtitle", "time": 17577.03, "timestamp": "04:52:57", "text": ">> Oh no. Is she okay?"}, {"type": "subtitle", "time": 17579.43, "timestamp": "04:52:59", "text": ">> But this time it's true."}]
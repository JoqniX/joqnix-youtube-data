[{"type": "subtitle", "time": 1997.11, "timestamp": "00:33:17", "text": "Is this your idea of accurate intel,"}, {"type": "subtitle", "time": 1998.95, "timestamp": "00:33:18", "text": "Randy?"}, {"type": "subtitle", "time": 2005.669, "timestamp": "00:33:25", "text": ">> The soldiers did their best with the"}, {"type": "subtitle", "time": 2007.35, "timestamp": "00:33:27", "text": "Filthoids."}, {"type": "subtitle", "time": 2009.029, "timestamp": "00:33:29", "text": "These are indeed unforeseen"}, {"type": "subtitle", "time": 2011.909, "timestamp": "00:33:31", "text": "circumstances. But we did find something"}, {"type": "subtitle", "time": 2014.549, "timestamp": "00:33:34", "text": "valuable on this island today."}, {"type": "subtitle", "time": 2016.95, "timestamp": "00:33:36", "text": "alchemical tools she has used and an"}, {"type": "subtitle", "time": 2019.11, "timestamp": "00:33:39", "text": "airship with a Legion serial number on"}, {"type": "subtitle", "time": 2019.83, "timestamp": "00:33:39", "text": "it."}, {"type": "subtitle", "time": 2021.83, "timestamp": "00:33:41", "text": ">> You realize we're looking for number"}, {"type": "subtitle", "time": 2025.669, "timestamp": "00:33:45", "text": "zero, not this useless junk, right?"}, {"type": "subtitle", "time": 2028.549, "timestamp": "00:33:48", "text": ">> We've been searching for over a decade,"}, {"type": "subtitle", "time": 2030.789, "timestamp": "00:33:50", "text": "but our maritime unit intercepted"}, {"type": "subtitle", "time": 2033.11, "timestamp": "00:33:53", "text": "several of the vill's vessels. They"}, {"type": "subtitle", "time": 2035.909, "timestamp": "00:33:55", "text": "might be able to dig up some."}, {"type": "subtitle", "time": 2037.509, "timestamp": "00:33:57", "text": ">> Were those gunshots,"}]
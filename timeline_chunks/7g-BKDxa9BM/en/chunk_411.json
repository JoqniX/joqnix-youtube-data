[{"type": "subtitle", "time": 24664.948, "timestamp": "06:51:04", "text": "That's nice."}, {"type": "subtitle", "time": 24668.07, "timestamp": "06:51:08", "text": "Do the passengers have lights on?"}, {"type": "subtitle", "time": 24670.868, "timestamp": "06:51:10", "text": "Are the windows looking pretty and warm"}, {"type": "subtitle", "time": 24675.19, "timestamp": "06:51:15", "text": "like tiny flames in a fireplace?"}, {"type": "subtitle", "time": 24676.788, "timestamp": "06:51:16", "text": "Psyche,"}, {"type": "subtitle", "time": 24680.628, "timestamp": "06:51:20", "text": "when did your eyesight start to fade?"}, {"type": "subtitle", "time": 24683.51, "timestamp": "06:51:23", "text": "When was it?"}, {"type": "subtitle", "time": 24686.468, "timestamp": "06:51:26", "text": "I don't really know."}, {"type": "subtitle", "time": 24689.75, "timestamp": "06:51:29", "text": "I thought it'd be the same as before,"}, {"type": "subtitle", "time": 24692.548, "timestamp": "06:51:32", "text": "just blurry for a while. Let's not talk"}, {"type": "subtitle", "time": 24694.39, "timestamp": "06:51:34", "text": "about that."}, {"type": "subtitle", "time": 24697.51, "timestamp": "06:51:37", "text": ">> There's a place I'd like to visit."}, {"type": "subtitle", "time": 24700.07, "timestamp": "06:51:40", "text": ">> I want to ask her, man."}, {"type": "subtitle", "time": 24705.19, "timestamp": "06:51:45", "text": ">> Near an old tree stump. Here we are."}, {"type": "subtitle", "time": 24708.07, "timestamp": "06:51:48", "text": "Could"}, {"type": "subtitle", "time": 24712.788, "timestamp": "06:51:52", "text": "you open it? This is a It's called a"}, {"type": "subtitle", "time": 24714.39, "timestamp": "06:51:54", "text": "camera. Dad gave me"}, {"type": "subtitle", "time": 24717.03, "timestamp": "06:51:57", "text": ">> You unlocked the camera feature."}, {"type": "subtitle", "time": 24719.27, "timestamp": "06:51:59", "text": ">> But I cherished it too much. So I came"}]
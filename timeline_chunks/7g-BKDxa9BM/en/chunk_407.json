[{"type": "subtitle", "time": 24420.788, "timestamp": "06:47:00", "text": ">> I'm sorry."}, {"type": "subtitle", "time": 24429.35, "timestamp": "06:47:09", "text": ">> What's going on? What happened to"}, {"type": "subtitle", "time": 24431.67, "timestamp": "06:47:11", "text": "Psyche?"}, {"type": "subtitle", "time": 24440.468, "timestamp": "06:47:20", "text": "And she needs some time to rest. It's"}, {"type": "subtitle", "time": 24443.03, "timestamp": "06:47:23", "text": "nothing serious, but please leave her"}, {"type": "subtitle", "time": 24446.23, "timestamp": "06:47:26", "text": "alone for the next few days."}, {"type": "subtitle", "time": 24448.548, "timestamp": "06:47:28", "text": ">> Psyche, would you like to go out for a"}, {"type": "subtitle", "time": 24450.948, "timestamp": "06:47:30", "text": "walk with me?"}, {"type": "subtitle", "time": 24453.51, "timestamp": "06:47:33", "text": "Let's go outside for some fresh air."}, {"type": "subtitle", "time": 24456.31, "timestamp": "06:47:36", "text": "Don't be afraid,"}, {"type": "subtitle", "time": 24457.59, "timestamp": "06:47:37", "text": ">> please."}, {"type": "subtitle", "time": 24461.83, "timestamp": "06:47:41", "text": ">> I want to go to the lamenting lake."}, {"type": "subtitle", "time": 24465.11, "timestamp": "06:47:45", "text": ">> Sure, I'll go with you."}, {"type": "subtitle", "time": 24467.11, "timestamp": "06:47:47", "text": "Mr. Henrik,"}, {"type": "subtitle", "time": 24470.07, "timestamp": "06:47:50", "text": "may I go out for a walk?"}, {"type": "subtitle", "time": 24473.91, "timestamp": "06:47:53", "text": "Don't worry, it won't"}, {"type": "subtitle", "time": 24476.548, "timestamp": "06:47:56", "text": ">> Go ahead. But remember what I've told"}, {"type": "subtitle", "time": 24479.43, "timestamp": "06:47:59", "text": "you. Otherwise,"}]
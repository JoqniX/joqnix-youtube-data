[{"type": "subtitle", "time": 7453.83, "timestamp": "02:04:13", "text": "我真的應該休息一下，吃點"}, {"type": "subtitle", "time": 7455.83, "timestamp": "02:04:15", "text": "東西。"}, {"type": "subtitle", "time": 7459.43, "timestamp": "02:04:19", "text": "哦，這裡出乎意料地寬敞，"}, {"type": "subtitle", "time": 7462.709, "timestamp": "02:04:22", "text": "而且比地面上暖和得多。"}, {"type": "subtitle", "time": 7466.31, "timestamp": "02:04:26", "text": "哦，就像一個秘密的小王國。"}, {"type": "subtitle", "time": 7468.47, "timestamp": "02:04:28", "text": "趕走那些小動物，去除"}, {"type": "subtitle", "time": 7471.669, "timestamp": "02:04:31", "text": "異味。那你就可以搭起帳篷，"}, {"type": "subtitle", "time": 7474.149, "timestamp": "02:04:34", "text": "基本上就住在這裡了，"}, {"type": "subtitle", "time": 7484.39, "timestamp": "02:04:44", "text": "小偷就在前面。"}, {"type": "subtitle", "time": 7487.83, "timestamp": "02:04:47", "text": "喔不，他跟一群骯髒的傢伙打起來了。  咱們把那些"}, {"type": "subtitle", "time": 7489.83, "timestamp": "02:04:49", "text": "骯髒的傢伙趕走，然後抓住"}]
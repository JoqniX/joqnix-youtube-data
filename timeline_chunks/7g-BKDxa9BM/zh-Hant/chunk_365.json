[{"type": "subtitle", "time": 21904.31, "timestamp": "06:05:04", "text": "我找到了一封關於他的信"}, {"type": "subtitle", "time": 21907.27, "timestamp": "06:05:07", "text": "。知道了。另外兩名被遺棄者成員"}, {"type": "subtitle", "time": 21909.99, "timestamp": "06:05:09", "text": "可能就在我標記的區域內。  好的。  誇張的。你好，Bombastic。  血腥。太"}, {"type": "subtitle", "time": 21957.99, "timestamp": "06:05:57", "text": "殘酷了"}, {"type": "subtitle", "time": 21959.59, "timestamp": "06:05:59", "text": "。  好了"}]
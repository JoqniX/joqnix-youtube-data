[{"type": "subtitle", "time": 25025.11, "timestamp": "06:57:05", "text": "年輕人中箭了。好吧。好吧。我投降。不是我。我發誓是你。我相信你，卡米拉小姐。但記住，密切注意這個孩子，不要"}, {"type": "subtitle", "time": 25027.91, "timestamp": "06:57:07", "text": "讓她在鎮上惹麻煩。如果"}, {"type": "subtitle", "time": 25031.27, "timestamp": "06:57:11", "text": "警長發現這件事，我們"}, {"type": "subtitle", "time": 25034.15, "timestamp": "06:57:14", "text": "兩個都會有麻煩的。"}, {"type": "subtitle", "time": 25037.51, "timestamp": "06:57:17", "text": "該死，沒想到會碰到你。幫"}, {"type": "subtitle", "time": 25039.91, "timestamp": "06:57:19", "text": "我個忙，小姐。這件事保密，好嗎"}, {"type": "subtitle", "time": 25041.27, "timestamp": "06:57:21", "text": "？他"}, {"type": "subtitle", "time": 25043.19, "timestamp": "06:57:23", "text": "是誰？這個？"}, {"type": "subtitle", "time": 25045.11, "timestamp": "06:57:25", "text": "好吧，好吧。這是你的錢。"}, {"type": "subtitle", "time": 25049.75, "timestamp": "06:57:29", "text": "你處決了他。我覺得他不該"}, {"type": "subtitle", "time": 25069.59, "timestamp": "06:57:49", "text": "遭受這樣的對待。小聲點。我跟你說過不是我幹的。我只是想把屍體偷偷帶出去。我叫凱文。我們以前見過。我是郊區的護衛。這位可憐的人是哈爾，我的老鄰居。他很小的時候就失去了母親，"}, {"type": "subtitle", "time": 25073.35, "timestamp": "06:57:53", "text": "從那時起就一直打架鬥毆。我家不允許我和"}, {"type": "subtitle", "time": 25075.99, "timestamp": "06:57:55", "text": "卡隆人來往，但他是"}, {"type": "subtitle", "time": 25077.91, "timestamp": "06:57:57", "text": "我小時候的老朋友，所以我"}]
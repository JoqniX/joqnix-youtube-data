[{"type": "subtitle", "time": 1322.95, "timestamp": "00:22:02", "text": "看來我們只能指望那東西了。"}, {"type": "subtitle", "time": 1325.27, "timestamp": "00:22:05", "text": "聽著，其實還有另一部《"}, {"type": "subtitle", "time": 1327.669, "timestamp": "00:22:07", "text": "你好，法蘭科》。歡迎來到"}, {"type": "subtitle", "time": 1330.549, "timestamp": "00:22:10", "text": "山頂廢墟中的溪流。"}, {"type": "subtitle", "time": 1333.51, "timestamp": "00:22:13", "text": "山上的船。"}, {"type": "subtitle", "time": 1335.029, "timestamp": "00:22:15", "text": "歡迎。歡迎登船。"}, {"type": "subtitle", "time": 1340.23, "timestamp": "00:22:20", "text": "沒錯，這是一艘會飛的船。現在跟我來。"}, {"type": "subtitle", "time": 1343.35, "timestamp": "00:22:23", "text": "一艘會飛的船。"}, {"type": "subtitle", "time": 1345.11, "timestamp": "00:22:25", "text": "遠程武器是擊敗"}, {"type": "subtitle", "time": 1347.35, "timestamp": "00:22:27", "text": "電梯位置敵人的理想選擇。並非說"}, {"type": "subtitle", "time": 1351.83, "timestamp": "00:22:31", "text": "他們的彈匣彈藥數量有限制。  玩家可以透過"}, {"type": "subtitle", "time": 1355.909, "timestamp": "00:22:35", "text": "擊敗敵人、打開寶箱、"}, {"type": "subtitle", "time": 1357.909, "timestamp": "00:22:37", "text": "摧毀可回收物品來獲得彈藥補給，這些物品可以"}, {"type": "subtitle", "time": 1362.23, "timestamp": "00:22:42", "text": "用來補充武器彈藥。好了，"}, {"type": "subtitle", "time": 1365.75, "timestamp": "00:22:45", "text": "海葵要來了。"}, {"type": "subtitle", "time": 1368.31, "timestamp": "00:22:48", "text": "保持距離。必要時，洩漏"}, {"type": "subtitle", "time": 1370.87, "timestamp": "00:22:50", "text": "秘密訊號。我們提前編好了，"}, {"type": "subtitle", "time": 1374.71, "timestamp": "00:22:54", "text": "以免引起上級的注意。"}]
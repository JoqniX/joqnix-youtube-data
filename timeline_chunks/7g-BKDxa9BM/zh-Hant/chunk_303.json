[{"type": "subtitle", "time": 18189.52, "timestamp": "05:03:09", "text": "早上就讓你"}, {"type": "subtitle", "time": 18207.59, "timestamp": "05:03:27", "text": "走了嗎？  我找到你要找的東西了。史黛拉的水晶球。  沒"}, {"type": "subtitle", "time": 18210.07, "timestamp": "05:03:30", "text": "人要求你"}, {"type": "subtitle", "time": 18210.948, "timestamp": "05:03:30", "text": "來這裡。  我不是本地人。"}, {"type": "subtitle", "time": 18229.67, "timestamp": "05:03:49", "text": "交易意味著一手拿現金，一手拿貨物。  亨里克先生，如果您不感興趣，我可能就去找其他買家了。  進來吧。哦，等等。那麼，我"}]
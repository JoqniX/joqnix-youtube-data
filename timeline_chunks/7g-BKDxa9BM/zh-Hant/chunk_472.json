[{"type": "subtitle", "time": 28320.388, "timestamp": "07:52:00", "text": "撲向我，看起來很可怕。幸好我反應"}, {"type": "subtitle", "time": 28322.07, "timestamp": "07:52:02", "text": "快。但是，哦"}, {"type": "subtitle", "time": 28324.708, "timestamp": "07:52:04", "text": "不……哦，"}, {"type": "subtitle", "time": 28325.11, "timestamp": "07:52:05", "text": "該死。"}, {"type": "subtitle", "time": 28327.67, "timestamp": "07:52:07", "text": "請幫幫我們。亨里克先生"}, {"type": "subtitle", "time": 28330.15, "timestamp": "07:52:10", "text": "怎麼了？"}, {"type": "subtitle", "time": 28331.51, "timestamp": "07:52:11", "text": "請幫幫我們。"}, {"type": "subtitle", "time": 28331.99, "timestamp": "07:52:11", "text": "什麼？"}, {"type": "subtitle", "time": 28335.27, "timestamp": "07:52:15", "text": "跟我來"}, {"type": "subtitle", "time": 28338.31, "timestamp": "07:52:18", "text": "這邊。亨里克先生在他的辦公室。我的"}, {"type": "subtitle", "time": 28340.468, "timestamp": "07:52:20", "text": "天哪。一切都亂了套。"}, {"type": "subtitle", "time": 28343.11, "timestamp": "07:52:23", "text": "等等。我不在這裡。其他"}, {"type": "subtitle", "time": 28367.83, "timestamp": "07:52:47", "text": "亨里克，"}, {"type": "subtitle", "time": 28370.708, "timestamp": "07:52:50", "text": "他還活著。斯諾，看看你"}, {"type": "subtitle", "time": 28371.11, "timestamp": "07:52:51", "text": "能"}, {"type": "subtitle", "time": 28373.75, "timestamp": "07:52:53", "text": "不能……別在我身上浪費時間。我罪有應得……別費勁了"}, {"type": "subtitle", "time": 28375.83, "timestamp": "07:52:55", "text": "。他死定了。讓他"}, {"type": "subtitle", "time": 28378.07, "timestamp": "07:52:58", "text": "結束這一切。話。"}]
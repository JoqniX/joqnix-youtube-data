[{"type": "subtitle", "time": 7320.229, "timestamp": "02:02:00", "text": "確認一下。"}, {"type": "subtitle", "time": 7324.149, "timestamp": "02:02:04", "text": "哇。但這東西確實存在"}, {"type": "subtitle", "time": 7337.669, "timestamp": "02:02:17", "text": "看看這個。牆邊擺放著兩層板條箱"}, {"type": "subtitle", "time": 7340.47, "timestamp": "02:02:20", "text": "。據州政府稱"}, {"type": "subtitle", "time": 7342.95, "timestamp": "02:02:22", "text": "，沉默寡言的偵探瑪吉"}, {"type": "subtitle", "time": 7345.27, "timestamp": "02:02:25", "text": "推斷，走投無路的竊賊一定是把"}, {"type": "subtitle", "time": 7347.83, "timestamp": "02:02:27", "text": "這些箱子堆起來，以便爬上牆。"}, {"type": "subtitle", "time": 7349.91, "timestamp": "02:02:29", "text": "聰明的想法。"}, {"type": "subtitle", "time": 7356.79, "timestamp": "02:02:36", "text": "瑪吉，你的頭銜是「沉默寡言的偵探」。聽起來不錯。稍微短了一點"}, {"type": "subtitle", "time": 7359.669, "timestamp": "02:02:39", "text": "。力度還可以再強一些。"}, {"type": "subtitle", "time": 7362.31, "timestamp": "02:02:42", "text": "有道理。魔王，你有什麼建議嗎"}, {"type": "subtitle", "time": 7364.709, "timestamp": "02:02:44", "text": "？"}, {"type": "subtitle", "time": 7371.83, "timestamp": "02:02:51", "text": "[音樂]"}, {"type": "subtitle", "time": 7373.589, "timestamp": "02:02:53", "text": "前面那個老頭叫你公主"}, {"type": "subtitle", "time": 7375.669, "timestamp": "02:02:55", "text": "垃圾桶。"}]
[{"type": "subtitle", "time": 28862.15, "timestamp": "08:01:02", "text": "這應該是最後一段路了。"}, {"type": "subtitle", "time": 28894.868, "timestamp": "08:01:34", "text": "她要變成最終頭目了嗎？"}, {"type": "subtitle", "time": 28896.788, "timestamp": "08:01:36", "text": "風太大了。不能再"}, {"type": "subtitle", "time": 28897.67, "timestamp": "08:01:37", "text": "靠近了。太"}, {"type": "subtitle", "time": 28900.23, "timestamp": "08:01:40", "text": "危險了。待在這裡。該死。這樣下去"}, {"type": "subtitle", "time": 28902.07, "timestamp": "08:01:42", "text": "我們就完了。她瘋了。"}, {"type": "subtitle", "time": 28904.628, "timestamp": "08:01:44", "text": "準備戰鬥。"}, {"type": "subtitle", "time": 28906.548, "timestamp": "08:01:46", "text": "不。"}, {"type": "subtitle", "time": 28911.11, "timestamp": "08:01:51", "text": "哦，糟糕。"}, {"type": "subtitle", "time": 28913.67, "timestamp": "08:01:53", "text": "她變成最終"}]
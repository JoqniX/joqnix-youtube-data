[{"type": "subtitle", "time": 30010.15, "timestamp": "08:20:10", "text": "總之，振作起來。那"}, {"type": "subtitle", "time": 30011.67, "timestamp": "08:20:11", "text": "女孩一定會希望你"}, {"type": "subtitle", "time": 30014.468, "timestamp": "08:20:14", "text": "明天能帶著微笑迎接挑戰。"}, {"type": "subtitle", "time": 30016.31, "timestamp": "08:20:16", "text": "即使我們曾經被這個"}, {"type": "subtitle", "time": 30023.83, "timestamp": "08:20:23", "text": "天哪，為什麼？"}, {"type": "subtitle", "time": 30027.43, "timestamp": "08:20:27", "text": "我不明白。為什麼要殺死一個好"}]
[{"type": "subtitle", "time": 29701.99, "timestamp": "08:15:01", "text": "不，"}, {"type": "subtitle", "time": 29712.388, "timestamp": "08:15:12", "text": "我自殺了。"}, {"type": "subtitle", "time": 29717.51, "timestamp": "08:15:17", "text": "我不能也"}, {"type": "subtitle", "time": 29720.07, "timestamp": "08:15:20", "text": "不想這樣"}, {"type": "subtitle", "time": 29722.868, "timestamp": "08:15:22", "text": "生活。"}, {"type": "subtitle", "time": 29726.15, "timestamp": "08:15:26", "text": "振作起來，普賽克。你說你夢見了"}, {"type": "subtitle", "time": 29728.948, "timestamp": "08:15:28", "text": "一個溫暖且鮮花盛開的地方"}, {"type": "subtitle", "time": 29730.388, "timestamp": "08:15:30", "text": "。"}, {"type": "subtitle", "time": 29731.19, "timestamp": "08:15:31", "text": "嗯。"}, {"type": "subtitle", "time": 29733.35, "timestamp": "08:15:33", "text": "你自己也說過。"}, {"type": "subtitle", "time": 29737.11, "timestamp": "08:15:37", "text": "鮮花能帶來好運。  是"}, {"type": "subtitle", "time": 29739.11, "timestamp": "08:15:39", "text": "的，"}, {"type": "subtitle", "time": 29741.83, "timestamp": "08:15:41", "text": "那一定是"}, {"type": "subtitle", "time": 29745.03, "timestamp": "08:15:45", "text": "個很美的地方。"}, {"type": "subtitle", "time": 29747.19, "timestamp": "08:15:47", "text": "是我的錯覺嗎，還是她的皮膚出了問題？"}, {"type": "subtitle", "time": 29749.99, "timestamp": "08:15:49", "text": "別光聽我說的。你得親眼"}, {"type": "subtitle", "time": 29753.35, "timestamp": "08:15:53", "text": "看看。"}, {"type": "subtitle", "time": 29755.43, "timestamp": "08:15:55", "text": "你知道"}, {"type": "subtitle", "time": 29759.11, "timestamp": "08:15:59", "text": "我為什麼喜歡花嗎？"}]
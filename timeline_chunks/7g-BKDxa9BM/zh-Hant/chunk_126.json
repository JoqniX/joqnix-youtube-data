[{"type": "subtitle", "time": 7563.589, "timestamp": "02:06:03", "text": "在捕獲後保持。"}, {"type": "subtitle", "time": 7565.75, "timestamp": "02:06:05", "text": "這是因為你低估了斯諾的"}, {"type": "subtitle", "time": 7569.589, "timestamp": "02:06:09", "text": "手下。現在你知道我們有什麼了吧。"}, {"type": "subtitle", "time": 7572.39, "timestamp": "02:06:12", "text": "好的。好的。這是你的錢。"}, {"type": "subtitle", "time": 7577.03, "timestamp": "02:06:17", "text": "你餓壞了。你猜怎麼著？那麼，大家覺得這樣怎麼樣呢"}, {"type": "subtitle", "time": 7579.27, "timestamp": "02:06:19", "text": "？"}, {"type": "subtitle", "time": 7581.669, "timestamp": "02:06:21", "text": "嗯，"}, {"type": "subtitle", "time": 7583.03, "timestamp": "02:06:23", "text": "好的。"}, {"type": "subtitle", "time": 7583.83, "timestamp": "02:06:23", "text": "他在做什麼？"}, {"type": "subtitle", "time": 7589.75, "timestamp": "02:06:29", "text": "匕首被什麼東西碰掉了。"}, {"type": "subtitle", "time": 7592.149, "timestamp": "02:06:32", "text": "記住，有時候野獸露出"}, {"type": "subtitle", "time": 7594.709, "timestamp": "02:06:34", "text": "肚皮並不代表它很虛弱。"}, {"type": "subtitle", "time": 7597.83, "timestamp": "02:06:37", "text": "誘捕者交配。就像荒野一樣，這座城市裡到處都是"}, {"type": "subtitle", "time": 7599.03, "timestamp": "02:06:39", "text": "野獸，比如……"}, {"type": "subtitle", "time": 7602.47, "timestamp": "02:06:42", "text": "哦，卡米拉小姐，"}, {"type": "subtitle", "time": 7604.39, "timestamp": "02:06:44", "text": "既然你大老遠來到"}, {"type": "subtitle", "time": 7606.629, "timestamp": "02:06:46", "text": "冰湖，如果遇到你的……"}, {"type": "subtitle", "time": 7607.189, "timestamp": "02:06:47", "text": "哦，"}, {"type": "subtitle", "time": 7609.589, "timestamp": "02:06:49", "text": "我還以為來了個大人物呢。原來"}, {"type": "subtitle", "time": 7611.99, "timestamp": "02:06:51", "text": "那隻是養老母雞的酒館。"}, {"type": "subtitle", "time": 7619.589, "timestamp": "02:06:59", "text": "我們會用我們的方式來對待你。教你"}]
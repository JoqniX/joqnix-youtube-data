[{"type": "subtitle", "time": 6120.55, "timestamp": "01:42:00", "text": "好吧，這次我就放過你了。"}, {"type": "subtitle", "time": 6123.669, "timestamp": "01:42:03", "text": "哦，對。這是"}, {"type": "subtitle", "time": 6136.53, "timestamp": "01:42:16", "text": "驚人的。那真是難以置信。"}, {"type": "subtitle", "time": 6139.03, "timestamp": "01:42:19", "text": "[音樂]"}, {"type": "subtitle", "time": 6141.03, "timestamp": "01:42:21", "text": "我不太確定。"}, {"type": "subtitle", "time": 6143.51, "timestamp": "01:42:23", "text": "這把劍我一直陪伴著我，只要"}, {"type": "subtitle", "time": 6147.27, "timestamp": "01:42:27", "text": "我能擁有它。有意思。非常有趣。"}, {"type": "subtitle", "time": 6150.629, "timestamp": "01:42:30", "text": "這就是我整個孩子心目中的武器匠嗎？"}, {"type": "subtitle", "time": 6154.39, "timestamp": "01:42:34", "text": "我是 Lunosmith，一位世界級的鐵匠。我"}, {"type": "subtitle", "time": 6156.149, "timestamp": "01:42:36", "text": "走遍了從"}, {"type": "subtitle", "time": 6158.87, "timestamp": "01:42:38", "text": "海伯羅利亞到阿里西姆的整個大陸，鍛造了"}, {"type": "subtitle", "time": 6162.07, "timestamp": "01:42:42", "text": "無數武器。如果你需要任何"}, {"type": "subtitle", "time": 6166.229, "timestamp": "01:42:46", "text": "武器，我隨時奉陪。哇。所以，"}, {"type": "subtitle", "time": 6169.83, "timestamp": "01:42:49", "text": "你是一位經驗豐富的鐵匠大師。"}, {"type": "subtitle", "time": 6172.87, "timestamp": "01:42:52", "text": "我只要求一份基本工資和一個"}]
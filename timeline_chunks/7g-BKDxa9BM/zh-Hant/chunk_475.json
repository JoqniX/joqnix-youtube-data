[{"type": "subtitle", "time": 28521.11, "timestamp": "07:55:21", "text": "是惡魔。你們可以阻止那個孩子。她心地善良。拜託了。 [音樂]救救Psyche。他快死了嗎？不。救救我的Haley。等等，她的女兒。她……他……她的女兒Haley是Psyche。等等，我糊塗了。我們"}, {"type": "subtitle", "time": 28523.99, "timestamp": "07:55:23", "text": "走吧。我們必須快點。"}, {"type": "subtitle", "time": 28525.25, "timestamp": "07:55:25", "text": "等等，什麼？"}, {"type": "subtitle", "time": 28527.51, "timestamp": "07:55:27", "text": "[音樂]"}, {"type": "subtitle", "time": 28530.628, "timestamp": "07:55:30", "text": "兄弟，這音樂太激烈了。激烈的音樂"}, {"type": "subtitle", "time": 28537.51, "timestamp": "07:55:37", "text": "阻止一個破壞者可不是件容易的"}, {"type": "subtitle", "time": 28539.91, "timestamp": "07:55:39", "text": "事。在"}, {"type": "subtitle", "time": 28541.35, "timestamp": "07:55:41", "text": "離開城市尋找"}, {"type": "subtitle", "time": 28544.23, "timestamp": "07:55:44", "text": "Psyche之前，確保你已經做好了充分的準備。"}, {"type": "subtitle", "time": 28555.67, "timestamp": "07:55:55", "text": "好吧，下雨了，還有你的角色。哦，天哪。"}, {"type": "subtitle", "time": 28557.91, "timestamp": "07:55:57", "text": "去軍械庫。哦，天哪。我必須……我"}]
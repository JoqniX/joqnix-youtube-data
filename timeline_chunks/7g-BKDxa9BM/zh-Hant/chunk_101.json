[{"type": "subtitle", "time": 6070.95, "timestamp": "01:41:10", "text": "嘿，你。是的，就是你。那邊那個孩子。  你好，我是拿著"}, {"type": "subtitle", "time": 6073.99, "timestamp": "01:41:13", "text": "鐵鎚的露娜。"}, {"type": "subtitle", "time": 6074.709, "timestamp": "01:41:14", "text": "這個"}, {"type": "subtitle", "time": 6078.47, "timestamp": "01:41:18", "text": "女孩長得好像Snow嗎？"}, {"type": "subtitle", "time": 6081.109, "timestamp": "01:41:21", "text": "哦，他們是兄妹。"}, {"type": "subtitle", "time": 6083.43, "timestamp": "01:41:23", "text": "等等，那個女孩有鬍子。"}, {"type": "subtitle", "time": 6085.51, "timestamp": "01:41:25", "text": "搞什麼鬼？"}, {"type": "subtitle", "time": 6089.43, "timestamp": "01:41:29", "text": "你在叫誰女孩？"}, {"type": "subtitle", "time": 6091.669, "timestamp": "01:41:31", "text": "現在的年輕人"}, {"type": "subtitle", "time": 6098.229, "timestamp": "01:41:38", "text": "你說話要小心。雖然"}, {"type": "subtitle", "time": 6100.79, "timestamp": "01:41:40", "text": "所有月球人看起來都很年輕，但她實際上和"}, {"type": "subtitle", "time": 6103.43, "timestamp": "01:41:43", "text": "你的曾祖母一樣老。"}, {"type": "subtitle", "time": 6116.39, "timestamp": "01:41:56", "text": "道德觀。"}]
[{"type": "subtitle", "time": 11285.11, "timestamp": "03:08:05", "text": "我回來了。  我回來了"}, {"type": "subtitle", "time": 11288.95, "timestamp": "03:08:08", "text": "。非常抱歉我"}, {"type": "subtitle", "time": 11290.63, "timestamp": "03:08:10", "text": "遲到了。"}, {"type": "subtitle", "time": 11293.83, "timestamp": "03:08:13", "text": "亞洲的延遲簡直太嚴重了。等等，"}, {"type": "subtitle", "time": 11296.15, "timestamp": "03:08:16", "text": "你怎麼知道它是否卡頓？"}, {"type": "subtitle", "time": 11302.87, "timestamp": "03:08:22", "text": "天哪。我在這裡。"}, {"type": "subtitle", "time": 11306.389, "timestamp": "03:08:26", "text": "我來了，各位。  我在這裡。"}, {"type": "subtitle", "time": 11327.349, "timestamp": "03:08:47", "text": "好吧，"}, {"type": "subtitle", "time": 11330.71, "timestamp": "03:08:50", "text": "我打噴嚏打個不停。我吃過晚餐了。"}]
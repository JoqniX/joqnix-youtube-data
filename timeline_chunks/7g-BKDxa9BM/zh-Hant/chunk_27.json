[{"type": "subtitle", "time": 1646.95, "timestamp": "00:27:26", "text": "我打噴嚏，所以把聲音關掉了。是的，"}, {"type": "subtitle", "time": 1649.75, "timestamp": "00:27:29", "text": "那種打開死者屍體的機制"}, {"type": "subtitle", "time": 1652.149, "timestamp": "00:27:32", "text": "就像開鎖一樣。太好了。"}, {"type": "subtitle", "time": 1653.83, "timestamp": "00:27:33", "text": "似乎在我們到達之前有人和他打過架"}, {"type": "subtitle", "time": 1655.269, "timestamp": "00:27:35", "text": "。"}, {"type": "subtitle", "time": 1657.75, "timestamp": "00:27:37", "text": "會不會是村民中的某個人？"}, {"type": "subtitle", "time": 1660.789, "timestamp": "00:27:40", "text": "不，我們才是第一個打開那扇門的人。"}, {"type": "subtitle", "time": 1663.909, "timestamp": "00:27:43", "text": "總之，多虧了那個人，我們才"}, {"type": "subtitle", "time": 1665.59, "timestamp": "00:27:45", "text": "不用自己去處理這些髒東西"}, {"type": "subtitle", "time": 1666.95, "timestamp": "00:27:46", "text": "。"}, {"type": "subtitle", "time": 1669.11, "timestamp": "00:27:49", "text": "無論他是誰，都"}]
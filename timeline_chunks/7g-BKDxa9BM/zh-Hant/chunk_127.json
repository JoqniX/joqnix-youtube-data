[{"type": "subtitle", "time": 7621.669, "timestamp": "02:07:01", "text": "一些你那可能不在身邊的母親從未教過你的人生道理。"}, {"type": "subtitle", "time": 7625.189, "timestamp": "02:07:05", "text": "別把我媽牽扯進來。放開"}, {"type": "subtitle", "time": 7627.189, "timestamp": "02:07:07", "text": "我。你這個卑鄙的黑客。"}, {"type": "subtitle", "time": 7628.709, "timestamp": "02:07:08", "text": "魔女。"}, {"type": "subtitle", "time": 7631.43, "timestamp": "02:07:11", "text": "哦，他打過電話給他。叫她老巫婆。"}, {"type": "subtitle", "time": 7632.79, "timestamp": "02:07:12", "text": "把他送到保安局。"}, {"type": "subtitle", "time": 7633.43, "timestamp": "02:07:13", "text": "直的。"}, {"type": "subtitle", "time": 7642.149, "timestamp": "02:07:22", "text": "什麼？不，不，求求你"}, {"type": "subtitle", "time": 7647.43, "timestamp": "02:07:27", "text": "。  我走了。冰湖永存。"}, {"type": "subtitle", "time": 7654.95, "timestamp": "02:07:34", "text": "卡米拉小姐。他怎麼了？  保持距離。他比看起來危險得多。總之，瑪姬說：「如果你還是執意如此，那就請放我走吧。」這真是奇怪。  我為什麼會驚慌失措？我確實很想念卡米拉，"}, {"type": "subtitle", "time": 7657.91, "timestamp": "02:07:37", "text": "還有那個小偷。他渾身顫抖，看來他要倒楣了。"}, {"type": "subtitle", "time": 7662.87, "timestamp": "02:07:42", "text": "我差點忘了。謝謝。"}, {"type": "subtitle", "time": 7664.87, "timestamp": "02:07:44", "text": "哦，我們收到報告了。  好了，我得去"}, {"type": "subtitle", "time": 7667.35, "timestamp": "02:07:47", "text": "把這些硬幣分了。"}, {"type": "subtitle", "time": 7669.91, "timestamp": "02:07:49", "text": "我通常到處購物。"}, {"type": "subtitle", "time": 7675.27, "timestamp": "02:07:55", "text": "我們是要回到過去，還是要繼續留"}]
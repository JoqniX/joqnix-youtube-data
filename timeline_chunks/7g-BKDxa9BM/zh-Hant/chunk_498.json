[{"type": "subtitle", "time": 29882.388, "timestamp": "08:18:02", "text": "H. 她"}, {"type": "subtitle", "time": 29885.43, "timestamp": "08:18:05", "text": "試著避開人群。"}, {"type": "subtitle", "time": 29887.75, "timestamp": "08:18:07", "text": "這就是她拼命向郊區逃竄的原因"}, {"type": "subtitle", "time": 29894.708, "timestamp": "08:18:14", "text": "即使在生命的最後時刻，她仍然在"}, {"type": "subtitle", "time": 29898.23, "timestamp": "08:18:18", "text": "努力為他人做些事。"}, {"type": "subtitle", "time": 29900.628, "timestamp": "08:18:20", "text": "M：我不明白。為什麼要殺死它們？"}, {"type": "subtitle", "time": 29904.31, "timestamp": "08:18:24", "text": "我處理掉了。你說什麼？你還"}, {"type": "subtitle", "time": 29906.468, "timestamp": "08:18:26", "text": "好嗎？我應該安排嗎？"}, {"type": "subtitle", "time": 29908.628, "timestamp": "08:18:28", "text": "完全不用，媽媽。"}, {"type": "subtitle", "time": 29910.548, "timestamp": "08:18:30", "text": "我的朋友只是說：「我們改天再談"}, {"type": "subtitle", "time": 29912.548, "timestamp": "08:18:32", "text": "獎勵的事吧。」又接到一個"}, {"type": "subtitle", "time": 29919.91, "timestamp": "08:18:39", "text": "手掌向下，保持不動。讓"}, {"type": "subtitle", "time": 29928.31, "timestamp": "08:18:48", "text": "離開。"}, {"type": "subtitle", "time": 29930.468, "timestamp": "08:18:50", "text": "等等，為什麼？"}, {"type": "subtitle", "time": 29936.548, "timestamp": "08:18:56", "text": "我不明白。為什麼要殺死普賽克？  我不明白。"}, {"type": "subtitle", "time": 29939.99, "timestamp": "08:18:59", "text": "為什麼要殺死卡扎基？"}]
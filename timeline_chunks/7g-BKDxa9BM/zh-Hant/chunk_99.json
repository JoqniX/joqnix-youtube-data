[{"type": "subtitle", "time": 5945.669, "timestamp": "01:39:05", "text": "我能感覺到。"}, {"type": "subtitle", "time": 5947.35, "timestamp": "01:39:07", "text": "即使你努力想擠出一個"}, {"type": "subtitle", "time": 5948.39, "timestamp": "01:39:08", "text": "笑容。"}, {"type": "subtitle", "time": 5951.35, "timestamp": "01:39:11", "text": "我太喜歡她的這身打扮了。"}, {"type": "subtitle", "time": 5953.59, "timestamp": "01:39:13", "text": "我有點好奇你經歷了什麼"}, {"type": "subtitle", "time": 5954.709, "timestamp": "01:39:14", "text": "。"}, {"type": "subtitle", "time": 5956.87, "timestamp": "01:39:16", "text": "亨里克先生告訴我不要問"}, {"type": "subtitle", "time": 5958.31, "timestamp": "01:39:18", "text": "過客人的過去。"}, {"type": "subtitle", "time": 5961.51, "timestamp": "01:39:21", "text": "你知道，就是她手臂上那個"}, {"type": "subtitle", "time": 5963.669, "timestamp": "01:39:23", "text": "像蝴蝶的東西。"}, {"type": "subtitle", "time": 5967.27, "timestamp": "01:39:27", "text": "精神。我需要……我需要一些錢。"}, {"type": "subtitle", "time": 5970.55, "timestamp": "01:39:30", "text": "有地方嗎？讓我看看。這裡的大多數人都"}, {"type": "subtitle", "time": 5973.75, "timestamp": "01:39:33", "text": "在工廠工作。卡米拉·"}, {"type": "subtitle", "time": 5975.91, "timestamp": "01:39:35", "text": "史嘉莉小姐的酒館。但"}, {"type": "subtitle", "time": 5976.629, "timestamp": "01:39:36", "text": "佣金。"}, {"type": "subtitle", "time": 5979.669, "timestamp": "01:39:39", "text": "那些佣金。卡米拉·斯嘉麗。"}, {"type": "subtitle", "time": 5982.629, "timestamp": "01:39:42", "text": "我今天見到她了。雖然我完全不知道"}, {"type": "subtitle", "time": 5985.51, "timestamp": "01:39:45", "text": "她沒關係。我能應付。"}, {"type": "subtitle", "time": 5987.91, "timestamp": "01:39:47", "text": "嗯？跑了這麼久，"}, {"type": "subtitle", "time": 5991.03, "timestamp": "01:39:51", "text": "你還是要回到卡蜜拉身邊？再加"}, {"type": "subtitle", "time": 5994.149, "timestamp": "01:39:54", "text": "上雪。雪對"}, {"type": "subtitle", "time": 5996.149, "timestamp": "01:39:56", "text": "那個地方來說再熟悉不過了。"}]
[{"type": "subtitle", "time": 28260.468, "timestamp": "07:51:00", "text": "普諾斯宅邸的小屋"}, {"type": "subtitle", "time": 28262.468, "timestamp": "07:51:02", "text": "可能都…亨利克的女兒"}, {"type": "subtitle", "time": 28264.388, "timestamp": "07:51:04", "text": "很可能在猩紅河被殺，可能是"}, {"type": "subtitle", "time": 28266.708, "timestamp": "07:51:06", "text": "被腐蝕者"}, {"type": "subtitle", "time": 28269.67, "timestamp": "07:51:09", "text": "引發的火花殺死的。所以他設法"}, {"type": "subtitle", "time": 28272.07, "timestamp": "07:51:12", "text": "控制了一些腐蝕者，並以"}, {"type": "subtitle", "time": 28275.11, "timestamp": "07:51:15", "text": "自己的方式伸張正義。"}, {"type": "subtitle", "time": 28276.628, "timestamp": "07:51:16", "text": "這就是你的結論，對吧？"}, {"type": "subtitle", "time": 28277.43, "timestamp": "07:51:17", "text": "是的。"}, {"type": "subtitle", "time": 28278.23, "timestamp": "07:51:18", "text": "正義的化身。"}, {"type": "subtitle", "time": 28280.31, "timestamp": "07:51:20", "text": "無論祂經歷了什麼，也無論那些"}, {"type": "subtitle", "time": 28282.468, "timestamp": "07:51:22", "text": "墮落者最終會"}, {"type": "subtitle", "time": 28291.59, "timestamp": "07:51:31", "text": "你聽到了嗎？尖叫聲從……的"}, {"type": "subtitle", "time": 28292.31, "timestamp": "07:51:32", "text": "方向"}, {"type": "subtitle", "time": 28293.43, "timestamp": "07:51:33", "text": "傳來。走吧。"}, {"type": "subtitle", "time": 28307.19, "timestamp": "07:51:47", "text": "你終於來了。你不知道有多"}, {"type": "subtitle", "time": 28308.548, "timestamp": "07:51:48", "text": "可怕。剛才的"}, {"type": "subtitle", "time": 28309.91, "timestamp": "07:51:49", "text": "尖叫聲是你發出的嗎？"}, {"type": "subtitle", "time": 28311.43, "timestamp": "07:51:51", "text": "我只是按照你的吩咐在這裡放哨"}, {"type": "subtitle", "time": 28314.15, "timestamp": "07:51:54", "text": "。正如你所料，"}, {"type": "subtitle", "time": 28317.19, "timestamp": "07:51:57", "text": "普賽克出來了。我跑了，但她突然"}]
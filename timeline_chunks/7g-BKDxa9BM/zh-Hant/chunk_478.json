[{"type": "subtitle", "time": 28712.948, "timestamp": "07:58:32", "text": "那個年輕女士剛才咻的一聲飛過去了。她是"}, {"type": "subtitle", "time": 28722.948, "timestamp": "07:58:42", "text": "怎麼做到的"}, {"type": "subtitle", "time": 28725.83, "timestamp": "07:58:45", "text": "？噓。放下它，回城裡去。那是個破壞者。蝴蝶。這麼冷的地方怎麼會有蝴蝶？"}, {"type": "subtitle", "time": 28728.31, "timestamp": "07:58:48", "text": "這些骯髒的傢伙都半死了。可能是"}, {"type": "subtitle", "time": 28730.788, "timestamp": "07:58:50", "text": "被普賽克打敗的"}]
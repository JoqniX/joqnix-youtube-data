[{"type": "subtitle", "time": 247.50900000000001, "timestamp": "00:04:07", "text": "好了，就是這樣。"}, {"type": "subtitle", "time": 250.55, "timestamp": "00:04:10", "text": "嗯，晚上好，詹姆斯·賈格爾。歡迎"}, {"type": "subtitle", "time": 252.309, "timestamp": "00:04:12", "text": "光臨。"}, {"type": "subtitle", "time": 255.67, "timestamp": "00:04:15", "text": "晚安.早安."}, {"type": "subtitle", "time": 266.469, "timestamp": "00:04:26", "text": "亞洲。有人建議我去亞洲伺服器玩。"}, {"type": "subtitle", "time": 269.35, "timestamp": "00:04:29", "text": "等等，什麼？另外，伺服器剛剛"}, {"type": "subtitle", "time": 276.79, "timestamp": "00:04:36", "text": "等等，已經出來了。不是7點30分。他們"}, {"type": "subtitle", "time": 280.55, "timestamp": "00:04:40", "text": "已經打開了大門。"}, {"type": "subtitle", "time": 282.71, "timestamp": "00:04:42", "text": "等等，什麼？"}, {"type": "subtitle", "time": 288.15, "timestamp": "00:04:48", "text": "哦，有人在玩這個遊戲。好的，好的，"}, {"type": "subtitle", "time": 291.51, "timestamp": "00:04:51", "text": "好的。遲到了。"}, {"type": "subtitle", "time": 294.87, "timestamp": "00:04:54", "text": "我遲到了。搞什麼鬼？"}, {"type": "subtitle", "time": 296.469, "timestamp": "00:04:56", "text": "讓我查一下。讓我查一下。讓我"}]
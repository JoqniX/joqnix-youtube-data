[{"type": "subtitle", "time": 28766.788, "timestamp": "07:59:26", "text": "已經知道普賽克去哪裡了。我們只"}, {"type": "subtitle", "time": 28769.03, "timestamp": "07:59:29", "text": "需要沿著她的蹤跡走就行了。"}, {"type": "subtitle", "time": 28773.19, "timestamp": "07:59:33", "text": "對。只要我們能找到普賽克就好。"}, {"type": "subtitle", "time": 28775.99, "timestamp": "07:59:35", "text": "風要把我吹走了。"}, {"type": "subtitle", "time": 28778.948, "timestamp": "07:59:38", "text": "雪兒，待在我們後面。等風小點兒我們就"}, {"type": "subtitle", "time": 28780.868, "timestamp": "07:59:40", "text": "行動。"}, {"type": "subtitle", "time": 28782.948, "timestamp": "07:59:42", "text": "如果風太大了，我們可以躲在"}, {"type": "subtitle", "time": 28785.27, "timestamp": "07:59:45", "text": "岩石後面休息一會兒。"}, {"type": "subtitle", "time": 28787.35, "timestamp": "07:59:47", "text": "別衝進去。"}]
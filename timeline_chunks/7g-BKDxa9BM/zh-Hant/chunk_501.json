[{"type": "subtitle", "time": 30068.788, "timestamp": "08:21:08", "text": "為什麼要殺死一個好角色？  為什麼要殺死一個好人？我不這麼認為，這說"}, {"type": "subtitle", "time": 30089.03, "timestamp": "08:21:29", "text": "願你的靈魂在迷霧繚繞的大海深處找到安寧"}, {"type": "subtitle", "time": 30090.468, "timestamp": "08:21:30", "text": "。"}, {"type": "subtitle", "time": 30093.59, "timestamp": "08:21:33", "text": "哦，那是下一個角色。"}, {"type": "subtitle", "time": 30095.91, "timestamp": "08:21:35", "text": "孩子，你來了。"}, {"type": "subtitle", "time": 30098.708, "timestamp": "08:21:38", "text": "請稍等，我正在完成最後一個"}, {"type": "subtitle", "time": 30101.67, "timestamp": "08:21:41", "text": "右轉彎動作。"}, {"type": "subtitle", "time": 30104.23, "timestamp": "08:21:44", "text": "願你在祝福中獲得新生，"}, {"type": "subtitle", "time": 30105.67, "timestamp": "08:21:45", "text": "孩子。"}, {"type": "subtitle", "time": 30108.15, "timestamp": "08:21:48", "text": "我像迷霧之"}, {"type": "subtitle", "time": 30112.07, "timestamp": "08:21:52", "text": "海中的仙女一樣遊蕩，或者說，我曾來到這裡旅行。我"}, {"type": "subtitle", "time": 30113.99, "timestamp": "08:21:53", "text": "聽見了這其中有一顆迷惘靈魂的低語。"}, {"type": "subtitle", "time": 30117.11, "timestamp": "08:21:57", "text": "一個好奇的靈魂？"}, {"type": "subtitle", "time": 30118.708, "timestamp": "08:21:58", "text": "是的。"}, {"type": "subtitle", "time": 30119.91, "timestamp": "08:21:59", "text": "你是怎麼知道的？"}]
[{"type": "subtitle", "time": 1868.23, "timestamp": "00:31:08", "text": "把你撕成碎片。"}, {"type": "subtitle", "time": 1880.32, "timestamp": "00:31:20", "text": "碎片。 投降。"}, {"type": "subtitle", "time": 1881.52, "timestamp": "00:31:21", "text": "投降。 它們有多少個？"}, {"type": "subtitle", "time": 1885.039, "timestamp": "00:31:25", "text": "它們有多少個？ 讓我們爬到頂峰，把它們甩掉。"}, {"type": "subtitle", "time": 1887.2, "timestamp": "00:31:27", "text": "讓我們爬到頂峰，把它們甩掉。 把你撕成碎片。"}]
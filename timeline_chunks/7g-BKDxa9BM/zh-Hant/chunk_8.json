[{"type": "subtitle", "time": 490.71, "timestamp": "00:08:10", "text": "這是誰？我感覺"}, {"type": "subtitle", "time": 494.55, "timestamp": "00:08:14", "text": "自己快要陷進沙子裡了。"}, {"type": "subtitle", "time": 501.99, "timestamp": "00:08:21", "text": "這次逃亡是由那個奇怪的"}, {"type": "subtitle", "time": 504.95, "timestamp": "00:08:24", "text": "夢預示的。我一生都飽受類似問題的困擾。"}, {"type": "subtitle", "time": 506.79, "timestamp": "00:08:26", "text": "但現在不是"}, {"type": "subtitle", "time": 509.029, "timestamp": "00:08:29", "text": "反思的時候。但目前還有更緊迫的事"}, {"type": "subtitle", "time": 511.189, "timestamp": "00:08:31", "text": "。巴瑞和我必須逃離"}, {"type": "subtitle", "time": 515.11, "timestamp": "00:08:35", "text": "這座冰雪覆蓋的島嶼。我們曾經享有的和平，"}, {"type": "subtitle", "time": 528.87, "timestamp": "00:08:48", "text": "那位女士是誰？這股水分是誰"}, {"type": "subtitle", "time": 531.35, "timestamp": "00:08:51", "text": "？"}, {"type": "subtitle", "time": 533.829, "timestamp": "00:08:53", "text": "你還好嗎？  是的"}, {"type": "subtitle", "time": 535.75, "timestamp": "00:08:55", "text": "。  再睡"}, {"type": "subtitle", "time": 538.55, "timestamp": "00:08:58", "text": "一會兒吧。我不會離開。"}]
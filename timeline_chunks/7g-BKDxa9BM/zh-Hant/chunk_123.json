[{"type": "subtitle", "time": 7404.229, "timestamp": "02:03:24", "text": "他們應該設計成可以讓你一路"}, {"type": "subtitle", "time": 7406.55, "timestamp": "02:03:26", "text": "爬到這裡。你"}, {"type": "subtitle", "time": 7407.669, "timestamp": "02:03:27", "text": "說過無論如何都要把錢分"}, {"type": "subtitle", "time": 7410.07, "timestamp": "02:03:30", "text": "給窮人，為什麼我不能分到"}, {"type": "subtitle", "time": 7412.79, "timestamp": "02:03:32", "text": "一份？"}, {"type": "subtitle", "time": 7415.91, "timestamp": "02:03:35", "text": "如果你經濟困難，我可以幫你。但"}, {"type": "subtitle", "time": 7418.47, "timestamp": "02:03:38", "text": "你不能隨便從別人手中搶錢。  你敢這麼做，我就用"}, {"type": "subtitle", "time": 7427.189, "timestamp": "02:03:47", "text": "[音樂]"}, {"type": "subtitle", "time": 7430.39, "timestamp": "02:03:50", "text": "他又消失了。他是什麼人？"}, {"type": "subtitle", "time": 7431.669, "timestamp": "02:03:51", "text": "鬼魂？"}]
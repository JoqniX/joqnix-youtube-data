[{"type": "subtitle", "time": 1232.87, "timestamp": "00:20:32", "text": "感覺就像是《星際戰甲》。"}, {"type": "subtitle", "time": 1235.51, "timestamp": "00:20:35", "text": "你連一艘船都沒留下。"}, {"type": "subtitle", "time": 1236.95, "timestamp": "00:20:36", "text": "那些"}, {"type": "subtitle", "time": 1239.75, "timestamp": "00:20:39", "text": "污穢之徒來村子的時候，你也在場，對吧？如果"}, {"type": "subtitle", "time": 1242.549, "timestamp": "00:20:42", "text": "不是你回來找我，你本來可以"}, {"type": "subtitle", "time": 1244.789, "timestamp": "00:20:44", "text": "和他們一起逃走。"}, {"type": "subtitle", "time": 1246.71, "timestamp": "00:20:46", "text": "別傻了。你也會"}, {"type": "subtitle", "time": 1249.27, "timestamp": "00:20:49", "text": "為我做同樣的事。我們沿著海岸找找，"}]
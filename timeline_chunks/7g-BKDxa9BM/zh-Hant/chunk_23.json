[{"type": "subtitle", "time": 1380.71, "timestamp": "00:23:00", "text": "快速胸部。右肩上有兩張卡片"}, {"type": "subtitle", "time": 1382.149, "timestamp": "00:23:02", "text": "。"}, {"type": "subtitle", "time": 1389.59, "timestamp": "00:23:09", "text": "這太瘋狂了。"}, {"type": "subtitle", "time": 1390.63, "timestamp": "00:23:10", "text": "更近了。"}, {"type": "subtitle", "time": 1396.95, "timestamp": "00:23:16", "text": "我可以瞄準三列火車。"}, {"type": "subtitle", "time": 1404.47, "timestamp": "00:23:24", "text": "很快。"}, {"type": "subtitle", "time": 1408.31, "timestamp": "00:23:28", "text": "太好了。記住，"}, {"type": "subtitle", "time": 1410.71, "timestamp": "00:23:30", "text": "快速眨眼三次表示"}, {"type": "subtitle", "time": 1412.71, "timestamp": "00:23:32", "text": "我對該訊號不感興趣。"}, {"type": "subtitle", "time": 1414.07, "timestamp": "00:23:34", "text": "哦，那是彈藥。"}, {"type": "subtitle", "time": 1416.47, "timestamp": "00:23:36", "text": "無論如何，記住它。"}, {"type": "subtitle", "time": 1438.31, "timestamp": "00:23:58", "text": "我現在可以刷這些傢伙，"}]
[{"type": "subtitle", "time": 5882.229, "timestamp": "01:38:02", "text": "如果她成功逃脫，"}, {"type": "subtitle", "time": 5904.709, "timestamp": "01:38:24", "text": "她一定會想盡辦法找到我。當然，我也不能排除最糟糕的情況，那就是西比爾已經把她帶到軍團去了。  好的一面是，西比爾似乎因為某些原因需要巴里，所以她可能不會傷害她。  總之"}, {"type": "subtitle", "time": 5908.229, "timestamp": "01:38:28", "text": "，我需要"}, {"type": "subtitle", "time": 5911.91, "timestamp": "01:38:31", "text": "在冰湖湊些錢，辦個旅行許可證，"}, {"type": "subtitle", "time": 5915.109, "timestamp": "01:38:35", "text": "然後計畫下一步。"}, {"type": "subtitle", "time": 5916.55, "timestamp": "01:38:36", "text": "旅行許可。好的。"}, {"type": "subtitle", "time": 5918.47, "timestamp": "01:38:38", "text": "後退。"}, {"type": "subtitle", "time": 5920.79, "timestamp": "01:38:40", "text": "你一定是餓壞了。這是"}, {"type": "subtitle", "time": 5923.669, "timestamp": "01:38:43", "text": "新鮮出爐的麵包。"}, {"type": "subtitle", "time": 5925.99, "timestamp": "01:38:45", "text": "巴里。"}, {"type": "subtitle", "time": 5930.629, "timestamp": "01:38:50", "text": "你還好嗎？"}, {"type": "subtitle", "time": 5933.35, "timestamp": "01:38:53", "text": "哦，這就像……嗯……那你"}, {"type": "subtitle", "time": 5936.47, "timestamp": "01:38:56", "text": "最好吃點麵包，再喝點"}, {"type": "subtitle", "time": 5938.79, "timestamp": "01:38:58", "text": "溫牛奶送服。"}, {"type": "subtitle", "time": 5939.91, "timestamp": "01:38:59", "text": "溫牛奶？"}]
[{"type": "subtitle", "time": 2764.95, "timestamp": "00:46:04", "text": "無限制。  第一次來這個省。  這些"}, {"type": "subtitle", "time": 2771.589, "timestamp": "00:46:11", "text": "人是誰？  她覺得這個人好像很在意你的討價還價"}, {"type": "subtitle", "time": 2777.589, "timestamp": "00:46:17", "text": "。我會付給你你想要的任何報酬，而你"}, {"type": "subtitle", "time": 2783.27, "timestamp": "00:46:23", "text": "只需要做你該做的事。這簡直是小菜一碟。  小菜一碟。好的。  有趣的。  你好。"}, {"type": "subtitle", "time": 2791.51, "timestamp": "00:46:31", "text": "你聽得到我嗎？  這個小孩是誰？  卡米拉醒了。  哦，原來這就是我們在過場動畫裡"}, {"type": "subtitle", "time": 2800.79, "timestamp": "00:46:40", "text": "看到的那位女士。  仍然活著，且未喪失行為能力。  看來沒人骨折。"}, {"type": "subtitle", "time": 2805.67, "timestamp": "00:46:45", "text": "我怎麼還活著？  你怎麼知道我"}, {"type": "chat", "time": 2806.156, "timestamp": "00:46:46", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "Is it hot where you are?"}, {"type": "subtitle", "time": 2813.91, "timestamp": "00:46:53", "text": "的名字？巴里，我們"}, {"type": "subtitle", "time": 2816.55, "timestamp": "00:46:56", "text": "這是在哪裡？  不，我們當時……我必須找到巴里。  或許"}, {"type": "subtitle", "time": 2818.39, "timestamp": "00:46:58", "text": "。  嘿，"}]
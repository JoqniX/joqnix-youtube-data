[{"type": "subtitle", "time": 541.67, "timestamp": "00:09:01", "text": "你醒來的時候我就在這裡。"}, {"type": "subtitle", "time": 544.15, "timestamp": "00:09:04", "text": "沒關係。我們應該"}, {"type": "subtitle", "time": 546.63, "timestamp": "00:09:06", "text": "下山，前往村莊。"}, {"type": "subtitle", "time": 548.47, "timestamp": "00:09:08", "text": "你想回去嗎？"}, {"type": "subtitle", "time": 550.389, "timestamp": "00:09:10", "text": "那裡已經傳來好幾天的咆哮聲了。"}, {"type": "subtitle", "time": 552.71, "timestamp": "00:09:12", "text": "我在想，如果我們能回到家，"}, {"type": "subtitle", "time": 555.99, "timestamp": "00:09:15", "text": "拿到武器，憑藉你的"}, {"type": "subtitle", "time": 558.87, "timestamp": "00:09:18", "text": "力量，你一定能找到出路。"}, {"type": "subtitle", "time": 560.71, "timestamp": "00:09:20", "text": "無論"}, {"type": "subtitle", "time": 563.269, "timestamp": "00:09:23", "text": "我們在這裡待多久，都不會有人來救我們。總之，"}, {"type": "subtitle", "time": 591.269, "timestamp": "00:09:51", "text": "離開山洞。"}, {"type": "subtitle", "time": 593.03, "timestamp": "00:09:53", "text": "感覺就像在玩單"}, {"type": "subtitle", "time": 595.35, "timestamp": "00:09:55", "text": "人遊戲，"}]
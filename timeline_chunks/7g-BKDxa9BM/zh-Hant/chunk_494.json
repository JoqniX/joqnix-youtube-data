[{"type": "subtitle", "time": 29642.948, "timestamp": "08:14:02", "text": "我"}, {"type": "subtitle", "time": 29645.43, "timestamp": "08:14:05", "text": "一直都想離開這個地方"}, {"type": "subtitle", "time": 29648.388, "timestamp": "08:14:08", "text": "。  是"}, {"type": "subtitle", "time": 29653.99, "timestamp": "08:14:13", "text": "的。看看世界，看看世界。  找一個溫暖且鮮花常開的地方。  我"}, {"type": "subtitle", "time": 29660.31, "timestamp": "08:14:20", "text": "希望能夠到達那裡。  我一定能到達那裡。  我是靈媒，我來帶你回家。  歡迎回來，Psyche。  只要我最終還是傷害了你們所有人。  我很抱歉。  沒關係。  我們一起回家吧。  他們想讓我告訴你。他們都在"}, {"type": "subtitle", "time": 29663.19, "timestamp": "08:14:23", "text": "等你。"}, {"type": "subtitle", "time": 29665.35, "timestamp": "08:14:25", "text": "回到家，但已經"}, {"type": "subtitle", "time": 29670.868, "timestamp": "08:14:30", "text": "太晚了。"}, {"type": "subtitle", "time": 29673.43, "timestamp": "08:14:33", "text": "局外人，有人知道全部嗎？"}, {"type": "subtitle", "time": 29675.19, "timestamp": "08:14:35", "text": "你不是說過你的大腦"}, {"type": "subtitle", "time": 29688.708, "timestamp": "08:14:48", "text": "她身負重傷。"}, {"type": "subtitle", "time": 29691.43, "timestamp": "08:14:51", "text": "她就算淪為骯髒之人也活不下去。  不，我們才是"}, {"type": "subtitle", "time": 29695.35, "timestamp": "08:14:55", "text": "主角。  我們"}, {"type": "subtitle", "time": 29696.868, "timestamp": "08:14:56", "text": "是主角。我們擁有一些"}, {"type": "subtitle", "time": 29697.51, "timestamp": "08:14:57", "text": "權力。"}, {"type": "subtitle", "time": 29699.67, "timestamp": "08:14:59", "text": "難的。"}]
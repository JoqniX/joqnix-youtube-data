[{"type": "subtitle", "time": 25260.788, "timestamp": "07:01:00", "text": "，那差不多就是他"}, {"type": "subtitle", "time": 25264.548, "timestamp": "07:01:04", "text": "在猩紅河鎮惹上麻煩的時候。"}, {"type": "subtitle", "time": 25266.468, "timestamp": "07:01:06", "text": "他有一個妻子和一個女兒。他們"}, {"type": "subtitle", "time": 25268.628, "timestamp": "07:01:08", "text": "只是一個普通的三口之家。"}, {"type": "subtitle", "time": 25270.468, "timestamp": "07:01:10", "text": "至於他的妻子，還有他的女兒，"}, {"type": "subtitle", "time": 25272.868, "timestamp": "07:01:12", "text": "她叫什麼來著？海蒂·海莉，我不太"}, {"type": "subtitle", "time": 25275.43, "timestamp": "07:01:15", "text": "記得了。總之，他從來不"}, {"type": "subtitle", "time": 25276.628, "timestamp": "07:01:16", "text": "提起他的女兒。"}, {"type": "subtitle", "time": 25278.39, "timestamp": "07:01:18", "text": "有一年，我的上級問起……她"}, {"type": "subtitle", "time": 25280.15, "timestamp": "07:01:20", "text": "喝多了。我發誓我已經把我知道的都告訴你了"}, {"type": "subtitle", "time": 25282.548, "timestamp": "07:01:22", "text": "。現在可以放我"}, {"type": "subtitle", "time": 25286.788, "timestamp": "07:01:26", "text": "走了嗎？把電影給我。"}, {"type": "subtitle", "time": 25287.51, "timestamp": "07:01:27", "text": "該死。"}, {"type": "subtitle", "time": 25289.51, "timestamp": "07:01:29", "text": "好吧，先生，保重。"}, {"type": "subtitle", "time": 25291.59, "timestamp": "07:01:31", "text": "嘿，你就這樣走了？"}, {"type": "subtitle", "time": 25293.83, "timestamp": "07:01:33", "text": "你要去哪裡？哦，你答應過不"}, {"type": "subtitle", "time": 25295.35, "timestamp": "07:01:35", "text": "告訴任何人，對吧？"}, {"type": "subtitle", "time": 25298.788, "timestamp": "07:01:38", "text": "你信守諾言。"}]
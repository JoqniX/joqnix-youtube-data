[{"type": "subtitle", "time": 2472.069, "timestamp": "00:41:12", "text": "共振的力量。  過場動畫卡頓。  過場動畫卡頓。  兄弟，"}, {"type": "subtitle", "time": 2482.15, "timestamp": "00:41:22", "text": "真想把這些都"}, {"type": "subtitle", "time": 2493.589, "timestamp": "00:41:33", "text": "貓咪終極技能"}, {"type": "subtitle", "time": 2495.91, "timestamp": "00:41:35", "text": "鏡焰，靈感來自"}, {"type": "subtitle", "time": 2499.27, "timestamp": "00:41:39", "text": "共鳴之力。終極技能已被覺醒。  迫害和釋放。好的。終結終極皮膚。好的，這個數字還不能讓她完全"}, {"type": "subtitle", "time": 2502.87, "timestamp": "00:41:42", "text": "釋放自己的力量。為什麼？  那不是她的能力。這是共鳴。  她想保護的那個小鬼。  這是"}, {"type": "subtitle", "time": 2505.51, "timestamp": "00:41:45", "text": "共振能量的新容器。仔細想想，她的臉龐正是共鳴力量的重現。"}]
[{"type": "subtitle", "time": 29762.788, "timestamp": "08:16:02", "text": "因為它們的種子"}, {"type": "subtitle", "time": 29764.948, "timestamp": "08:16:04", "text": "隨風飄散。"}, {"type": "subtitle", "time": 29767.51, "timestamp": "08:16:07", "text": "哦，她的頭髮真長。"}, {"type": "subtitle", "time": 29770.31, "timestamp": "08:16:10", "text": "遠方的土地，"}, {"type": "subtitle", "time": 29775.19, "timestamp": "08:16:15", "text": "越過城牆和山脈。"}, {"type": "subtitle", "time": 29783.11, "timestamp": "08:16:23", "text": "我還有一個最後的願望。"}, {"type": "subtitle", "time": 29802.07, "timestamp": "08:16:42", "text": "錯過了[音樂]目標。無法"}, {"type": "subtitle", "time": 29805.59, "timestamp": "08:16:45", "text": "從該距離確認目標或人質的狀態。  做好"}, {"type": "subtitle", "time": 29808.15, "timestamp": "08:16:48", "text": "直接交鋒的準備。"}, {"type": "subtitle", "time": 29815.91, "timestamp": "08:16:55", "text": "好像你不會死在我面前一樣。等待。她去世了。"}, {"type": "subtitle", "time": 29817.83, "timestamp": "08:16:57", "text": "什麼？什麼？搞什麼鬼？這是什麼鬼"}]
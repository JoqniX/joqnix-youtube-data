[{"type": "subtitle", "time": 28212.788, "timestamp": "07:50:12", "text": "[音樂]"}, {"type": "subtitle", "time": 28223.03, "timestamp": "07:50:23", "text": "一切都安排好了。我已經和"}, {"type": "subtitle", "time": 28224.468, "timestamp": "07:50:24", "text": "城裡一個朋友談好了。"}, {"type": "subtitle", "time": 28225.91, "timestamp": "07:50:25", "text": "他今晚會派他的教練過來"}, {"type": "subtitle", "time": 28227.19, "timestamp": "07:50:27", "text": "。"}, {"type": "subtitle", "time": 28229.75, "timestamp": "07:50:29", "text": "等普賽克之後出現，我們"}, {"type": "subtitle", "time": 28230.628, "timestamp": "07:50:30", "text": "就得隨機應變了。"}, {"type": "subtitle", "time": 28233.27, "timestamp": "07:50:33", "text": "你的目標範圍真廣。"}, {"type": "subtitle", "time": 28234.07, "timestamp": "07:50:34", "text": "得把它們都撒上去。"}, {"type": "subtitle", "time": 28235.75, "timestamp": "07:50:35", "text": "我不確定。"}, {"type": "subtitle", "time": 28237.43, "timestamp": "07:50:37", "text": "我們闖入許普諾斯宅邸，與"}, {"type": "subtitle", "time": 28239.59, "timestamp": "07:50:39", "text": "亨利對峙。別抱太大希望。"}, {"type": "subtitle", "time": 28240.788, "timestamp": "07:50:40", "text": "一步一步來，"}, {"type": "subtitle", "time": 28243.67, "timestamp": "07:50:43", "text": "對吧？說到這個，那些"}, {"type": "subtitle", "time": 28245.59, "timestamp": "07:50:45", "text": "腐蝕者通常不是由"}, {"type": "subtitle", "time": 28248.548, "timestamp": "07:50:48", "text": "護衛隊處理的嗎？亨利到底經歷了什麼？"}, {"type": "subtitle", "time": 28251.51, "timestamp": "07:50:51", "text": "我可能已經弄清楚為什麼"}, {"type": "subtitle", "time": 28253.27, "timestamp": "07:50:53", "text": "亨里克以前是醫生，"}, {"type": "subtitle", "time": 28255.19, "timestamp": "07:50:55", "text": "但他不知什麼原因關閉了診所"}, {"type": "subtitle", "time": 28256.23, "timestamp": "07:50:56", "text": "。"}, {"type": "subtitle", "time": 28258.628, "timestamp": "07:50:58", "text": "沒錯。更重要的是，許"}]
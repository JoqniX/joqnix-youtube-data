[{"type": "subtitle", "time": 28441.43, "timestamp": "07:54:01", "text": "掙扎。你好，"}, {"type": "subtitle", "time": 28443.91, "timestamp": "07:54:03", "text": "絕望的父親。"}, {"type": "subtitle", "time": 28446.788, "timestamp": "07:54:06", "text": "我們一直誤解了你。"}, {"type": "subtitle", "time": 28450.23, "timestamp": "07:54:10", "text": "不要原諒我。我讓他們"}, {"type": "subtitle", "time": 28456.23, "timestamp": "07:54:16", "text": "那麼普賽克怎麼樣了呢？"}, {"type": "subtitle", "time": 28458.07, "timestamp": "07:54:18", "text": "我試著"}, {"type": "subtitle", "time": 28461.03, "timestamp": "07:54:21", "text": "用水晶球，但還是不行。"}, {"type": "subtitle", "time": 28464.07, "timestamp": "07:54:24", "text": "我應該放她走。像"}, {"type": "subtitle", "time": 28467.99, "timestamp": "07:54:27", "text": "其他人一樣，她知道即將發生什麼。"}, {"type": "subtitle", "time": 28472.548, "timestamp": "07:54:32", "text": "然而她總是面帶微笑。"}, {"type": "subtitle", "time": 28475.27, "timestamp": "07:54:35", "text": "幾個月過去了，我老了。"}, {"type": "subtitle", "time": 28478.548, "timestamp": "07:54:38", "text": "我不能再這樣做了。"}, {"type": "subtitle", "time": 28481.27, "timestamp": "07:54:41", "text": "所以，在你的猶豫中，"}, {"type": "subtitle", "time": 28483.35, "timestamp": "07:54:43", "text": "你錯過了最後的機會。"}, {"type": "subtitle", "time": 28483.75, "timestamp": "07:54:43", "text": "哦，"}, {"type": "subtitle", "time": 28485.27, "timestamp": "07:54:45", "text": "看來你被她搞瘋了，她攻擊了你，"}, {"type": "subtitle", "time": 28487.03, "timestamp": "07:54:47", "text": "然後跑了。"}, {"type": "subtitle", "time": 28491.03, "timestamp": "07:54:51", "text": "怎麼回事？我簡直不敢相信"}, {"type": "subtitle", "time": 28493.03, "timestamp": "07:54:53", "text": "你們"}]
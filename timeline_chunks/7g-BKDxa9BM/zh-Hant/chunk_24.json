[{"type": "subtitle", "time": 1445.27, "timestamp": "00:24:05", "text": "我正在升級。"}, {"type": "subtitle", "time": 1463.029, "timestamp": "00:24:23", "text": "，我的彈藥已滿。  好的"}, {"type": "subtitle", "time": 1464.39, "timestamp": "00:24:24", "text": "。抓鉤點遍布"}, {"type": "subtitle", "time": 1466.39, "timestamp": "00:24:26", "text": "世界各地。按F2鍵啟動。"}, {"type": "subtitle", "time": 1498.39, "timestamp": "00:24:58", "text": "我的天哪。超好的。戰鬥體驗好多了"}]
[{"type": "subtitle", "time": 308.79, "timestamp": "00:05:08", "text": "你聽得到比賽的聲音嗎？好了，我們走吧。"}, {"type": "subtitle", "time": 311.749, "timestamp": "00:05:11", "text": "亞洲。我覺得我適應"}, {"type": "subtitle", "time": 313.35, "timestamp": "00:05:13", "text": "亞洲的生活應該沒問題吧？因為我"}, {"type": "subtitle", "time": 322.55, "timestamp": "00:05:22", "text": "走吧。我很興奮。"}, {"type": "subtitle", "time": 326.55, "timestamp": "00:05:26", "text": "我很興奮。 D"}, {"type": "subtitle", "time": 329.029, "timestamp": "00:05:29", "text": "滑音。蹲下滑行。穿過"}, {"type": "subtitle", "time": 333.67, "timestamp": "00:05:33", "text": "低矮狹窄的縫隙。好的。哦。"}, {"type": "subtitle", "time": 341.749, "timestamp": "00:05:41", "text": "這是誰？我是誰？"}, {"type": "subtitle", "time": 345.51, "timestamp": "00:05:45", "text": "如果你想活命，就告訴我實話。"}, {"type": "subtitle", "time": 348.71, "timestamp": "00:05:48", "text": "你為什麼在這裡？誰和你一起？"}, {"type": "subtitle", "time": 353.11, "timestamp": "00:05:53", "text": "你究竟是誰？"}]
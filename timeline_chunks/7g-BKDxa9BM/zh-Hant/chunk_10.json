[{"type": "subtitle", "time": 613.99, "timestamp": "00:10:13", "text": "附近有隱藏的寶箱嗎？"}, {"type": "subtitle", "time": 616.79, "timestamp": "00:10:16", "text": "你好。沒有胸部。我喜歡這個"}, {"type": "subtitle", "time": 619.03, "timestamp": "00:10:19", "text": "角色一直跟著我。它有點像某種"}, {"type": "subtitle", "time": 622.71, "timestamp": "00:10:22", "text": "網路平台，對吧？"}, {"type": "subtitle", "time": 624.87, "timestamp": "00:10:24", "text": "所以，你扮演主角或某個"}, {"type": "subtitle", "time": 627.75, "timestamp": "00:10:27", "text": "角色，所有NPC或同伴角色都會"}, {"type": "subtitle", "time": 629.43, "timestamp": "00:10:29", "text": "跟著你。"}, {"type": "subtitle", "time": 632.31, "timestamp": "00:10:32", "text": "太酷了。"}, {"type": "subtitle", "time": 634.87, "timestamp": "00:10:34", "text": "兄弟，這太酷了。我喜歡這種"}, {"type": "subtitle", "time": 637.75, "timestamp": "00:10:37", "text": "光線。"}, {"type": "subtitle", "time": 651.43, "timestamp": "00:10:51", "text": "留下控制和空間。"}, {"type": "subtitle", "time": 655.03, "timestamp": "00:10:55", "text": "兄弟，為什麼感覺像在玩Warframe？  我沒事。為什麼感覺像 Warframe？  太難了"}, {"type": "subtitle", "time": 656.71, "timestamp": "00:10:56", "text": "。"}]
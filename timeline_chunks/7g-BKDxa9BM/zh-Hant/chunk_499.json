[{"type": "subtitle", "time": 29948.708, "timestamp": "08:19:08", "text": "我以為你不會再那麼魯莽行事了。"}, {"type": "subtitle", "time": 29952.23, "timestamp": "08:19:12", "text": "我們剛剛和一位勇敢的年輕"}, {"type": "subtitle", "time": 29952.628, "timestamp": "08:19:12", "text": "女士道別。"}, {"type": "subtitle", "time": 29953.59, "timestamp": "08:19:13", "text": "感謝報道。"}, {"type": "subtitle", "time": 29955.67, "timestamp": "08:19:15", "text": "沒什麼值得感謝的。"}, {"type": "subtitle", "time": 29958.15, "timestamp": "08:19:18", "text": "刺蝟保持著它的尊嚴。哦，我"}, {"type": "subtitle", "time": 29960.31, "timestamp": "08:19:20", "text": "從未聽說過哪個墮落者會"}, {"type": "subtitle", "time": 29962.468, "timestamp": "08:19:22", "text": "恢復自我意識，但"}, {"type": "subtitle", "time": 29966.868, "timestamp": "08:19:26", "text": "他確實短暫地做到了。是你促成了這件事嗎"}, {"type": "subtitle", "time": 29970.23, "timestamp": "08:19:30", "text": "？放鬆。"}, {"type": "subtitle", "time": 29989.91, "timestamp": "08:19:49", "text": "我不會讓你覺得你擁有的這種力量對你在帝國來說是災難性的。  我記得上一個有這種能力的人……所以，使用你的權力時務必極其謹慎。  好的。這裡的風好大。我什麼也"}, {"type": "subtitle", "time": 29992.15, "timestamp": "08:19:52", "text": "聽不見。即使我只聽到"}, {"type": "subtitle", "time": 29993.99, "timestamp": "08:19:53", "text": "麻雀的叫聲。"}, {"type": "subtitle", "time": 29995.51, "timestamp": "08:19:55", "text": "這種事我見過無數"}, {"type": "subtitle", "time": 29996.628, "timestamp": "08:19:56", "text": "次了。"}, {"type": "subtitle", "time": 29998.388, "timestamp": "08:19:58", "text": "但我告訴自己，"}]
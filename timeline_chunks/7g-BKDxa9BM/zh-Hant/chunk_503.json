[{"type": "subtitle", "time": 30193.99, "timestamp": "08:23:13", "text": "奇蹟，一個戰勝機率的奇蹟。我相信，前往迷霧之海的溫柔靈魂也會希望，當你回想起迷霧之海時，它是卡隆生命的搖籃和安息之地"}, {"type": "subtitle", "time": 30196.31, "timestamp": "08:23:16", "text": "。"}, {"type": "subtitle", "time": 30199.19, "timestamp": "08:23:19", "text": "逝者的靈魂會回到那裡，而生者則會從那裡出現。  如果換作"}, {"type": "subtitle", "time": 30207.51, "timestamp": "08:23:27", "text": "別人問這個問題，我的回答"}, {"type": "subtitle", "time": 30209.59, "timestamp": "08:23:29", "text": "會是這樣的"}]
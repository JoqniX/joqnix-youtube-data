[{"type": "subtitle", "time": 29826.788, "timestamp": "08:17:06", "text": "不，她沒有。等等，"}, {"type": "subtitle", "time": 29827.75, "timestamp": "08:17:07", "text": "那並不能使它"}, {"type": "subtitle", "time": 29829.75, "timestamp": "08:17:09", "text": "變質。"}, {"type": "subtitle", "time": 29832.868, "timestamp": "08:17:12", "text": "情況已經"}, {"type": "subtitle", "time": 29835.67, "timestamp": "08:17:15", "text": "有些不對勁了，但人質是"}, {"type": "subtitle", "time": 29838.388, "timestamp": "08:17:18", "text": "安全的。至少"}, {"type": "subtitle", "time": 29840.388, "timestamp": "08:17:20", "text": "卡西圖斯護衛隊的準尉雷瑟姆·費雪是其中之一。"}, {"type": "subtitle", "time": 29844.468, "timestamp": "08:17:24", "text": "污穢怪極度危險。"}, {"type": "subtitle", "time": 29846.868, "timestamp": "08:17:26", "text": "不用了，女士。在"}, {"type": "subtitle", "time": 29850.15, "timestamp": "08:17:30", "text": "你來之前我們已經處理好了。處理好了。我"}, {"type": "subtitle", "time": 29852.31, "timestamp": "08:17:32", "text": "懂了。這就解釋了為什麼這個目標"}, {"type": "subtitle", "time": 29854.548, "timestamp": "08:17:34", "text": "比一般的污穢生物更穩定。  不過，當時只有"}, {"type": "subtitle", "time": 29857.67, "timestamp": "08:17:37", "text": "你們兩個人嗎？"}, {"type": "subtitle", "time": 29861.03, "timestamp": "08:17:41", "text": "恰恰。不是這個。媽媽，在我"}, {"type": "subtitle", "time": 29862.388, "timestamp": "08:17:42", "text": "早期的偵察中，雖然是從"}, {"type": "subtitle", "time": 29865.03, "timestamp": "08:17:45", "text": "遠處觀察，但他們可能是"}, {"type": "subtitle", "time": 29867.27, "timestamp": "08:17:47", "text": "同夥。"}, {"type": "subtitle", "time": 29870.388, "timestamp": "08:17:50", "text": "呃，媽媽，我不是說我指的就是"}, {"type": "subtitle", "time": 29872.548, "timestamp": "08:17:52", "text": "他們。我並不是說所有"}, {"type": "subtitle", "time": 29872.948, "timestamp": "08:17:52", "text": "汽車都"}, {"type": "subtitle", "time": 29874.788, "timestamp": "08:17:54", "text": "應該懲罰罪犯。我們"}, {"type": "subtitle", "time": 29876.468, "timestamp": "08:17:56", "text": "感謝您對退伍軍人協會的支持。"}, {"type": "subtitle", "time": 29878.468, "timestamp": "08:17:58", "text": "丟棄損壞部分。不要碰"}, {"type": "subtitle", "time": 29879.43, "timestamp": "08:17:59", "text": "她。"}]
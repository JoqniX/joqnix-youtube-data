[{"type": "subtitle", "time": 662.23, "timestamp": "00:11:02", "text": "我們還要留些"}, {"type": "subtitle", "time": 673.59, "timestamp": "00:11:13", "text": "這感覺就像是《星際戰甲》。  旋轉"}, {"type": "subtitle", "time": 697.43, "timestamp": "00:11:37", "text": "這首鋼琴曲真的很好聽"}, {"type": "subtitle", "time": 700.23, "timestamp": "00:11:40", "text": "。"}, {"type": "subtitle", "time": 703.35, "timestamp": "00:11:43", "text": "煉獄"}, {"type": "subtitle", "time": 708.55, "timestamp": "00:11:48", "text": "地圖和傳送點現已解鎖。  召喚"}, {"type": "subtitle", "time": 710.87, "timestamp": "00:11:50", "text": "艾文之靈，記錄"}, {"type": "subtitle", "time": 714.069, "timestamp": "00:11:54", "text": "外星高塔，瞬間重返這些地方"}, {"type": "subtitle", "time": 715.99, "timestamp": "00:11:55", "text": "。  以榮譽的方式接近這位榮譽的外星人，來"}]
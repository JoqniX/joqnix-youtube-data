[{"type": "subtitle", "time": 1525.269, "timestamp": "00:25:25", "text": "是的。曾經有人把那艘飛船遺棄在"}, {"type": "subtitle", "time": 1526.23, "timestamp": "00:25:26", "text": "這裡。"}, {"type": "subtitle", "time": 1537.35, "timestamp": "00:25:37", "text": "一把鑰匙。"}, {"type": "subtitle", "time": 1546.47, "timestamp": "00:25:46", "text": "聽。把你的劍直接刺"}, {"type": "subtitle", "time": 1548.22, "timestamp": "00:25:48", "text": "進去。"}, {"type": "subtitle", "time": 1550.47, "timestamp": "00:25:50", "text": "[音樂]"}]
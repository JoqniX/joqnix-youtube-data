[{"type": "subtitle", "time": 25080.23, "timestamp": "06:58:00", "text": "有時會幫他。有一天，他來找我，"}, {"type": "subtitle", "time": 25082.628, "timestamp": "06:58:02", "text": "行為很奇怪。我以為他"}, {"type": "subtitle", "time": 25084.628, "timestamp": "06:58:04", "text": "又欠債了，或是來抱怨"}, {"type": "subtitle", "time": 25085.99, "timestamp": "06:58:05", "text": "被他喝醉的……"}, {"type": "subtitle", "time": 25089.91, "timestamp": "06:58:09", "text": "到底什麼是衰敗？"}, {"type": "subtitle", "time": 25091.51, "timestamp": "06:58:11", "text": "身為卡隆人，你不懂"}, {"type": "subtitle", "time": 25093.27, "timestamp": "06:58:13", "text": "衰敗。"}, {"type": "subtitle", "time": 25094.868, "timestamp": "06:58:14", "text": "你真的是本地人嗎？"}, {"type": "subtitle", "time": 25096.708, "timestamp": "06:58:16", "text": "呃，"}, {"type": "subtitle", "time": 25097.83, "timestamp": "06:58:17", "text": "不是。"}, {"type": "subtitle", "time": 25099.83, "timestamp": "06:58:19", "text": "對。卡米拉確實提到了。所以"}, {"type": "subtitle", "time": 25102.548, "timestamp": "06:58:22", "text": "衰敗是一種"}, {"type": "subtitle", "time": 25105.11, "timestamp": "06:58:25", "text": "只有卡隆人才會得的特殊疾病。一旦你們這些"}, {"type": "subtitle", "time": 25107.11, "timestamp": "06:58:27", "text": "人醒來……青少年時期就能擁有那種力量"}, {"type": "subtitle", "time": 25109.59, "timestamp": "06:58:29", "text": "，但並非人人都"}, {"type": "subtitle", "time": 25111.75, "timestamp": "06:58:31", "text": "那麼幸運。"}, {"type": "subtitle", "time": 25113.35, "timestamp": "06:58:33", "text": "總是有些倒楣蛋不知"}, {"type": "subtitle", "time": 25114.868, "timestamp": "06:58:34", "text": "怎麼搞砸了，變成了"}, {"type": "subtitle", "time": 25117.11, "timestamp": "06:58:37", "text": "污穢者，而且比"}, {"type": "subtitle", "time": 25119.27, "timestamp": "06:58:39", "text": "普通的污穢者強大得多。"}, {"type": "subtitle", "time": 25121.59, "timestamp": "06:58:41", "text": "如果城裡出現腐化者，就會有專人護送"}, {"type": "subtitle", "time": 25124.15, "timestamp": "06:58:44", "text": "。現在你明白為什麼大多數魂鬥羅都恨"}, {"type": "subtitle", "time": 25127.03, "timestamp": "06:58:47", "text": "卡隆了吧？他們說那是邪惡的化身。說"}, {"type": "subtitle", "time": 25129.19, "timestamp": "06:58:49", "text": "實話，我對此並不完全信服，"}, {"type": "subtitle", "time": 25130.708, "timestamp": "06:58:50", "text": "但"}, {"type": "subtitle", "time": 25132.948, "timestamp": "06:58:52", "text": "大約兩週前，他獨自來到我的"}, {"type": "subtitle", "time": 25135.59, "timestamp": "06:58:55", "text": "公寓。但我又能怎麼做呢？"}, {"type": "subtitle", "time": 25138.07, "timestamp": "06:58:58", "text": "窩藏腐化者和"}, {"type": "subtitle", "time": 25139.51, "timestamp": "06:58:59", "text": "庇護"}]
[{"type": "subtitle", "time": 1818.07, "timestamp": "00:30:18", "text": "我們會繼續努力。  真"}, {"type": "subtitle", "time": 1820.07, "timestamp": "00:30:20", "text": "不敢相信我們"}, {"type": "subtitle", "time": 1827.51, "timestamp": "00:30:27", "text": "你們這些傢伙不能放過我們嗎"}, {"type": "subtitle", "time": 1837.43, "timestamp": "00:30:37", "text": "投降。  把"}]
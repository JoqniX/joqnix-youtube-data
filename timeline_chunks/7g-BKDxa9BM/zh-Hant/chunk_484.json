[{"type": "subtitle", "time": 29042.15, "timestamp": "08:04:02", "text": "搞什麼鬼？"}, {"type": "subtitle", "time": 29044.07, "timestamp": "08:04:04", "text": "精神。"}, {"type": "subtitle", "time": 29054.468, "timestamp": "08:04:14", "text": "這是"}, {"type": "subtitle", "time": 29074.07, "timestamp": "08:04:34", "text": "親愛的，你看。普賽克正對我們微笑。"}, {"type": "subtitle", "time": 29076.548, "timestamp": "08:04:36", "text": "我不知道這個孩子的降生究竟"}, {"type": "subtitle", "time": 29079.99, "timestamp": "08:04:39", "text": "是福還是禍。"}, {"type": "subtitle", "time": 29084.89, "timestamp": "08:04:44", "text": "是的，我們並非生來就擁有幸福。"}]
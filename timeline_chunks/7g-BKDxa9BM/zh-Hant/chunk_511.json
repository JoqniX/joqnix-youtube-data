[{"type": "subtitle", "time": 30665.27, "timestamp": "08:31:05", "text": "以前從未見過如此巨大的污穢之物。  但她其實不算強壯。"}, {"type": "subtitle", "time": 30670.388, "timestamp": "08:31:10", "text": "然後，那個巨大的骯髒生物猛地一舔，又重重地摔了下來，你們兩個都摔倒了。哦，艾莉莎，你真是太聰明了。"}, {"type": "subtitle", "time": 30678.308, "timestamp": "08:31:18", "text": "我還沒"}, {"type": "subtitle", "time": 30683.27, "timestamp": "08:31:23", "text": "告訴弗雷德呢。哦，你一定是因為你喜歡跟……嗯……說話。是嗎？  我確實從未聽過這個故事。"}, {"type": "subtitle", "time": 30691.35, "timestamp": "08:31:31", "text": "好的。"}, {"type": "subtitle", "time": 30694.23, "timestamp": "08:31:34", "text": "哦，她告訴我那裡還有一片海。那個人有沒有站在沙子下面？"}, {"type": "subtitle", "time": 30711.35, "timestamp": "08:31:51", "text": "我聽說海邊的沙子柔軟光滑。  她對這些事隻字未提。知道這一切又有什麼用呢？我們甚至無法離開"}]
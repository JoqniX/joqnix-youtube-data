[{"type": "subtitle", "time": 7921.91, "timestamp": "02:12:01", "text": "]"}, {"type": "subtitle", "time": 7924.229, "timestamp": "02:12:04", "text": "你的第一場演出非常順利，你"}, {"type": "subtitle", "time": 7926.87, "timestamp": "02:12:06", "text": "和"}, {"type": "subtitle", "time": 7934.47, "timestamp": "02:12:14", "text": "威爾斯相處得很好。你的獵狐生涯結束了。來，給你一杯熱飲暖暖身子。"}, {"type": "subtitle", "time": 7939.03, "timestamp": "02:12:19", "text": "我本來打算請你喝一杯，但既然威爾斯請客，"}, {"type": "subtitle", "time": 7945.35, "timestamp": "02:12:25", "text": "我們就讓他來喝吧。  耶。正確的。我確實把最後這個人誤認為小偷。這是我力所能及的。  哦，我還可以讓她了解我們這行的工作情況。說實話，這段時間挺難熬的"}, {"type": "subtitle", "time": 7949.589, "timestamp": "02:12:29", "text": "。我剛才看了看"}, {"type": "subtitle", "time": 7951.99, "timestamp": "02:12:31", "text": "今天的工作崗位，都是些吃力"}, {"type": "subtitle", "time": 7961.03, "timestamp": "02:12:41", "text": "不討好的工作。  找到合適的工作。找到一些死亡之石。  告訴"}, {"type": "subtitle", "time": 7974.87, "timestamp": "02:12:54", "text": "你也沒用。即使是我們這些老手也不敢碰它，更何況是你這樣的新手。  它正在尋找一種名為“星狀晶體”的稀有礦物。  客戶是亨里克·埃爾德雷德。  是的，就是你認識的亨利克。"}, {"type": "subtitle", "time": 7978.069, "timestamp": "02:12:58", "text": "格拉文坑現在成了污穢之徒的巢穴。"}]
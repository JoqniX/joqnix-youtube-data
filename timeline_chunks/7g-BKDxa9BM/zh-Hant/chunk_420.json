[{"type": "subtitle", "time": 25200.548, "timestamp": "07:00:00", "text": "看到這台攝影機了嗎？如果您……如果可以的話，就把"}, {"type": "subtitle", "time": 25203.27, "timestamp": "07:00:03", "text": "它交給"}, {"type": "subtitle", "time": 25204.468, "timestamp": "07:00:04", "text": "安全局吧。"}, {"type": "subtitle", "time": 25207.35, "timestamp": "07:00:07", "text": "拜託，別這麼苛刻。如果您在"}, {"type": "subtitle", "time": 25209.11, "timestamp": "07:00:09", "text": "挖掘什麼軍事機密，"}, {"type": "subtitle", "time": 25211.83, "timestamp": "07:00:11", "text": "您知道亨里克·埃斯的什麼消息嗎？"}, {"type": "subtitle", "time": 25215.03, "timestamp": "07:00:15", "text": "亨里克·埃斯？他不就是個內部老闆嗎？"}, {"type": "subtitle", "time": 25217.27, "timestamp": "07:00:17", "text": "我的上司確實有一些……哦，那"}, {"type": "subtitle", "time": 25219.03, "timestamp": "07:00:19", "text": "傢伙脾氣很暴躁。"}, {"type": "subtitle", "time": 25220.708, "timestamp": "07:00:20", "text": "他常常把門關在旅客前面，"}, {"type": "subtitle", "time": 25224.31, "timestamp": "07:00:24", "text": "但他就是這樣的人。"}, {"type": "subtitle", "time": 25227.11, "timestamp": "07:00:27", "text": "嗯，大概十四五年前吧"}, {"type": "subtitle", "time": 25229.99, "timestamp": "07:00:29", "text": "。亨里克·埃塞爾德犯了一起謀殺案。"}, {"type": "subtitle", "time": 25232.15, "timestamp": "07:00:32", "text": "受害者是卡隆人，"}, {"type": "subtitle", "time": 25234.788, "timestamp": "07:00:34", "text": "正如我剛才所說，已經有些衰弱了。"}, {"type": "subtitle", "time": 25236.31, "timestamp": "07:00:36", "text": "不過，這不算什麼大案子。所以，他只是……"}, {"type": "subtitle", "time": 25237.51, "timestamp": "07:00:37", "text": "他為什麼要這麼做？"}, {"type": "subtitle", "time": 25240.07, "timestamp": "07:00:40", "text": "我不知道。但各位，我只是"}, {"type": "subtitle", "time": 25241.83, "timestamp": "07:00:41", "text": "從我的上級那裡聽說的。事情已經過去很久了，"}, {"type": "subtitle", "time": 25243.59, "timestamp": "07:00:43", "text": "而且好像也沒發生過。"}, {"type": "subtitle", "time": 25244.07, "timestamp": "07:00:44", "text": "好吧。"}, {"type": "subtitle", "time": 25245.91, "timestamp": "07:00:45", "text": "冰河鎮的老人家都知道，"}, {"type": "subtitle", "time": 25248.23, "timestamp": "07:00:48", "text": "亨里克曾經是個名醫。"}, {"type": "subtitle", "time": 25249.99, "timestamp": "07:00:49", "text": "他醫術精湛。連"}, {"type": "subtitle", "time": 25251.51, "timestamp": "07:00:51", "text": "內城的貴族都會去找"}, {"type": "subtitle", "time": 25254.39, "timestamp": "07:00:54", "text": "他看病。但後來發生了一些事，當他名聲"}, {"type": "subtitle", "time": 25255.75, "timestamp": "07:00:55", "text": "鼎盛之時，他關閉了診所，"}, {"type": "subtitle", "time": 25258.23, "timestamp": "07:00:58", "text": "幾年後又把它改成了一家旅館"}, {"type": "subtitle", "time": 25259.51, "timestamp": "07:00:59", "text": "。仔細想想"}]
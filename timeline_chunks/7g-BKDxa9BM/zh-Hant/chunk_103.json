[{"type": "subtitle", "time": 6188.95, "timestamp": "01:43:08", "text": "很笨。好的。  你"}, {"type": "subtitle", "time": 6191.43, "timestamp": "01:43:11", "text": "看，我都能看出"}, {"type": "subtitle", "time": 6193.17, "timestamp": "01:43:13", "text": "你臉上寫滿了懷疑。"}, {"type": "subtitle", "time": 6195.59, "timestamp": "01:43:15", "text": "[音樂]"}, {"type": "subtitle", "time": 6198.47, "timestamp": "01:43:18", "text": "你可以相信我。你一定聽過這句"}, {"type": "subtitle", "time": 6200.709, "timestamp": "01:43:20", "text": "諺語：「月亮不會傷害人。」"}, {"type": "subtitle", "time": 6201.99, "timestamp": "01:43:21", "text": "我以前從來沒聽過。"}, {"type": "subtitle", "time": 6203.35, "timestamp": "01:43:23", "text": "拉西亞知道這一點。"}, {"type": "subtitle", "time": 6206.39, "timestamp": "01:43:26", "text": "沒有。我是新來的。我是個新人。"}, {"type": "subtitle", "time": 6209.109, "timestamp": "01:43:29", "text": "確切地。"}, {"type": "subtitle", "time": 6216.87, "timestamp": "01:43:36", "text": "是的，你說得對。那我們一起回去吧"}, {"type": "subtitle", "time": 6218.07, "timestamp": "01:43:38", "text": "。"}, {"type": "subtitle", "time": 6224.629, "timestamp": "01:43:44", "text": "好的。所以，我們解鎖了一種新武器。"}, {"type": "subtitle", "time": 6231.669, "timestamp": "01:43:51", "text": "火焰吞噬了純粹的武器支架"}, {"type": "subtitle", "time": 6234.87, "timestamp": "01:43:54", "text": "螺栓框架槍管。哦，你需要"}, {"type": "subtitle", "time": 6237.91, "timestamp": "01:43:57", "text": "解鎖所有這些單獨的物品才能"}]
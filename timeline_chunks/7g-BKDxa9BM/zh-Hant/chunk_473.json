[{"type": "subtitle", "time": 28382.15, "timestamp": "07:53:02", "text": "你必須阻止普賽克。"}, {"type": "subtitle", "time": 28385.03, "timestamp": "07:53:05", "text": "阻止她。"}, {"type": "subtitle", "time": 28387.75, "timestamp": "07:53:07", "text": "什麼？"}, {"type": "subtitle", "time": 28391.43, "timestamp": "07:53:11", "text": "許普諾斯之家的庇護所正在衰敗。"}, {"type": "subtitle", "time": 28395.91, "timestamp": "07:53:15", "text": "那些被命運遺棄的人。"}, {"type": "subtitle", "time": 28399.67, "timestamp": "07:53:19", "text": "他們注定的結局本該是一顆"}, {"type": "subtitle", "time": 28401.75, "timestamp": "07:53:21", "text": "冰冷的子彈。"}, {"type": "subtitle", "time": 28402.628, "timestamp": "07:53:22", "text": "好吧。"}, {"type": "subtitle", "time": 28406.23, "timestamp": "07:53:26", "text": "沒錯。在海伯瑞亞，任何出現"}, {"type": "subtitle", "time": 28408.31, "timestamp": "07:53:28", "text": "衰敗跡象的卡隆都會"}, {"type": "subtitle", "time": 28409.99, "timestamp": "07:53:29", "text": "立即被帶走，以防止他們"}, {"type": "subtitle", "time": 28412.31, "timestamp": "07:53:32", "text": "變成污穢之人。等等，你是"}, {"type": "subtitle", "time": 28413.83, "timestamp": "07:53:33", "text": "說"}, {"type": "subtitle", "time": 28416.388, "timestamp": "07:53:36", "text": "他們的家人沒有心腸，無法"}, {"type": "subtitle", "time": 28420.788, "timestamp": "07:53:40", "text": "以一種體面而溫柔的方式結束他們的痛苦"}, {"type": "chat", "time": 28422.788, "timestamp": "07:53:42", "author": "@Tannu-4xb", "avatar": "https://yt4.ggpht.com/_JP-8D8zBTzbhDsee74cjCLrBQ_ChSgQg1feSYJ0H0ndg2P0pEtpMtfWfHgIGcMKStiEGX_RNg=s64-c-k-c0x00ffffff-no-rj", "message": "hii"}, {"type": "subtitle", "time": 28422.868, "timestamp": "07:53:42", "text": "？"}, {"type": "subtitle", "time": 28424.868, "timestamp": "07:53:44", "text": "就像"}, {"type": "subtitle", "time": 28427.19, "timestamp": "07:53:47", "text": "我"}, {"type": "subtitle", "time": 28428.15, "timestamp": "07:53:48", "text": "真的…"}, {"type": "subtitle", "time": 28429.67, "timestamp": "07:53:49", "text": "哦，你的醫生"}, {"type": "subtitle", "time": 28432.468, "timestamp": "07:53:52", "text": "說的是那個"}, {"type": "subtitle", "time": 28434.548, "timestamp": "07:53:54", "text": "在猩紅河被殺的衰敗者。"}, {"type": "subtitle", "time": 28437.19, "timestamp": "07:53:57", "text": "你也知道這件事。"}, {"type": "subtitle", "time": 28439.51, "timestamp": "07:53:59", "text": "那隻不過是最後的絕望"}]
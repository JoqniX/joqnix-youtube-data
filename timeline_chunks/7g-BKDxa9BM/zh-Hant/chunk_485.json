[{"type": "subtitle", "time": 29110.23, "timestamp": "08:05:10", "text": "媽媽，我答應Psyche今天帶她"}, {"type": "subtitle", "time": 29113.27, "timestamp": "08:05:13", "text": "回家玩積木。"}, {"type": "subtitle", "time": 29115.99, "timestamp": "08:05:15", "text": "誰說你可以跟她玩？"}, {"type": "subtitle", "time": 29117.83, "timestamp": "08:05:17", "text": "我跟你說過多少遍了，要遠離"}, {"type": "subtitle", "time": 29120.388, "timestamp": "08:05:20", "text": "這些不潔的人？你想"}, {"type": "subtitle", "time": 29123.43, "timestamp": "08:05:23", "text": "被黑魔法殺死嗎？啊，這些"}, {"type": "subtitle", "time": 29125.99, "timestamp": "08:05:25", "text": "方塊現在都髒了。現在就把它們丟掉"}, {"type": "subtitle", "time": 29127.93, "timestamp": "08:05:27", "text": "。"}, {"type": "subtitle", "time": 29151.03, "timestamp": "08:05:51", "text": "她在我的家庭裡對先生不好嗎？"}, {"type": "subtitle", "time": 29154.788, "timestamp": "08:05:54", "text": "感到委屈和困惑。我"}, {"type": "subtitle", "time": 29158.15, "timestamp": "08:05:58", "text": "整夜都在洗澡，直到皮膚都滲出血來了。"}]
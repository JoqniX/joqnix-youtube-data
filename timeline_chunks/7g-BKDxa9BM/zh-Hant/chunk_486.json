[{"type": "subtitle", "time": 29161.59, "timestamp": "08:06:01", "text": "先生，您完全搞錯了。我"}, {"type": "subtitle", "time": 29164.07, "timestamp": "08:06:04", "text": "女兒是個好女孩。她很清楚，"}, {"type": "subtitle", "time": 29166.07, "timestamp": "08:06:06", "text": "偷項鍊藏"}, {"type": "subtitle", "time": 29168.23, "timestamp": "08:06:08", "text": "在花盆裡是不可取的。"}, {"type": "subtitle", "time": 29170.948, "timestamp": "08:06:10", "text": "保存。卡倫家的孩子裡，難道沒有一個沒被摸過"}, {"type": "subtitle", "time": 29173.59, "timestamp": "08:06:13", "text": "手指的嗎？好的。如果她"}, {"type": "subtitle", "time": 29176.468, "timestamp": "08:06:16", "text": "真的清白，她可以證明這一點。把"}, {"type": "subtitle", "time": 29178.468, "timestamp": "08:06:18", "text": "這裡的花盆全砸碎。這樣就能把"}, {"type": "subtitle", "time": 29179.83, "timestamp": "08:06:19", "text": "事情說清楚了。"}]
[{"type": "subtitle", "time": 1997.11, "timestamp": "00:33:17", "text": "這就是你認為的準確情報嗎"}, {"type": "subtitle", "time": 1998.95, "timestamp": "00:33:18", "text": "？"}, {"type": "subtitle", "time": 2005.669, "timestamp": "00:33:25", "text": "士兵們盡了全力對付那些"}, {"type": "subtitle", "time": 2007.35, "timestamp": "00:33:27", "text": "污穢之徒。"}, {"type": "subtitle", "time": 2009.029, "timestamp": "00:33:29", "text": "這確實是無法預料的"}, {"type": "subtitle", "time": 2011.909, "timestamp": "00:33:31", "text": "情況。但我們"}, {"type": "subtitle", "time": 2014.549, "timestamp": "00:33:34", "text": "今天確實在這個島上發現了一些有價值的東西。"}, {"type": "subtitle", "time": 2016.95, "timestamp": "00:33:36", "text": "她使用過的煉金工具，以及一艘"}, {"type": "subtitle", "time": 2019.11, "timestamp": "00:33:39", "text": "帶有軍團序號的飛艇"}, {"type": "subtitle", "time": 2019.83, "timestamp": "00:33:39", "text": "。"}, {"type": "subtitle", "time": 2021.83, "timestamp": "00:33:41", "text": "你知道我們要找的是"}, {"type": "subtitle", "time": 2025.669, "timestamp": "00:33:45", "text": "零號，而不是這些沒用的垃圾，對吧？"}, {"type": "subtitle", "time": 2028.549, "timestamp": "00:33:48", "text": "我們已經搜尋了十多年，"}, {"type": "subtitle", "time": 2030.789, "timestamp": "00:33:50", "text": "但我們的海上部隊攔截了"}, {"type": "subtitle", "time": 2033.11, "timestamp": "00:33:53", "text": "該村莊的幾艘船。他們"}, {"type": "subtitle", "time": 2035.909, "timestamp": "00:33:55", "text": "或許能挖到一些。"}]
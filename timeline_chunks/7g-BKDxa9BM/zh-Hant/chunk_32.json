[{"type": "subtitle", "time": 1928.95, "timestamp": "00:32:08", "text": "我們已經尋找多年了。"}, {"type": "subtitle", "time": 1930.63, "timestamp": "00:32:10", "text": "酋長何時才能放棄這場毫無意義的"}, {"type": "subtitle", "time": 1931.909, "timestamp": "00:32:11", "text": "追捕？"}, {"type": "subtitle", "time": 1934.87, "timestamp": "00:32:14", "text": "誰在那裡？放下武器。你被"}, {"type": "subtitle", "time": 1937.11, "timestamp": "00:32:17", "text": "第十三軍團包圍了。"}, {"type": "subtitle", "time": 1940.47, "timestamp": "00:32:20", "text": "怎麼會是這樣呢？"}, {"type": "subtitle", "time": 1943.909, "timestamp": "00:32:23", "text": "巴里，發生什麼事了？"}, {"type": "subtitle", "time": 1947.509, "timestamp": "00:32:27", "text": "軍團。他們找到了來這裡的路。"}, {"type": "subtitle", "time": 1950.95, "timestamp": "00:32:30", "text": "總之，他們得先越獄。  他們必須投降。"}]
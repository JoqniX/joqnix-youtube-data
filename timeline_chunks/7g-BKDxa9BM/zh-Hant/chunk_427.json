[{"type": "subtitle", "time": 25620.948, "timestamp": "07:07:00", "text": "我想要我的"}, {"type": "subtitle", "time": 25625.11, "timestamp": "07:07:05", "text": "武士刀。鞭劍是什麼？"}, {"type": "subtitle", "time": 25627.35, "timestamp": "07:07:07", "text": "好吧，這是一把……好吧，這是一把鞭"}, {"type": "subtitle", "time": 25629.99, "timestamp": "07:07:09", "text": "劍。"}, {"type": "subtitle", "time": 25631.75, "timestamp": "07:07:11", "text": "好吧，射程呢？我什麼時候才能拿到"}, {"type": "subtitle", "time": 25635.43, "timestamp": "07:07:15", "text": "弓？巴塔納。等等，這裡有一把霰彈槍。"}, {"type": "subtitle", "time": 25638.628, "timestamp": "07:07:18", "text": "什麼？搞什麼鬼？這裡有一把霰彈槍。突擊步槍。"}, {"type": "subtitle", "time": 25643.51, "timestamp": "07:07:23", "text": "呃，霰彈槍在哪裡？這把。"}, {"type": "subtitle", "time": 25645.75, "timestamp": "07:07:25", "text": "榴彈發射器。"}, {"type": "subtitle", "time": 25655.03, "timestamp": "07:07:35", "text": "射擊。我的天啊，這把霰彈槍看起來太"}, {"type": "subtitle", "time": 25659.27, "timestamp": "07:07:39", "text": "酷了，兄弟。我想要它。"}, {"type": "subtitle", "time": 25674.868, "timestamp": "07:07:54", "text": "那麼，我們先做一件事。我……我……我……"}]
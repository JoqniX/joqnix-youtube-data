[{"type": "subtitle", "time": 28924.628, "timestamp": "08:02:04", "text": "她變成了一個美麗的最終頭目。哇，老兄。她變成了一個美麗的最終頭目。"}, {"type": "subtitle", "time": 28928.628, "timestamp": "08:02:08", "text": "普賽克，你聽得到我說話嗎？"}, {"type": "subtitle", "time": 28931.51, "timestamp": "08:02:11", "text": "跟我說話，普賽克。"}, {"type": "subtitle", "time": 28931.99, "timestamp": "08:02:11", "text": "你說過，"}, {"type": "subtitle", "time": 28933.11, "timestamp": "08:02:13", "text": "「我的天啊，"}, {"type": "subtitle", "time": 28935.99, "timestamp": "08:02:15", "text": "你有很多想做的事情。」"}, {"type": "subtitle", "time": 28938.708, "timestamp": "08:02:18", "text": "你會離開冰湖，去往那些人跡罕至的"}, {"type": "subtitle", "time": 28940.388, "timestamp": "08:02:20", "text": "地方。"}, {"type": "subtitle", "time": 28943.03, "timestamp": "08:02:23", "text": "你會去一個小島上，在那裡你"}, {"type": "subtitle", "time": 28947.03, "timestamp": "08:02:27", "text": "可以建造一座海邊的房子，並在房子"}, {"type": "subtitle", "time": 28950.15, "timestamp": "08:02:30", "text": "周圍種植白色的花。"}, {"type": "subtitle", "time": 28952.388, "timestamp": "08:02:32", "text": "和朋友們一起在冰湖邊聊天，"}, {"type": "subtitle", "time": 28954.868, "timestamp": "08:02:34", "text": "同時戴上"}]
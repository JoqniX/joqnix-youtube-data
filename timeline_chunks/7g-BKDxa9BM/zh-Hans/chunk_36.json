[{"type": "subtitle", "time": 2185.51, "timestamp": "00:36:25", "text": "她是谁？"}, {"type": "subtitle", "time": 2187.27, "timestamp": "00:36:27", "text": "相反，你应该反击我的攻击。强大的敌人"}, {"type": "subtitle", "time": 2190.39, "timestamp": "00:36:30", "text": "能够保持他们的战斗姿态，"}, {"type": "subtitle", "time": 2192.15, "timestamp": "00:36:32", "text": "会被攻击削弱。有些人会"}, {"type": "subtitle", "time": 2195.91, "timestamp": "00:36:35", "text": "感觉减弱时会失去平衡。"}, {"type": "subtitle", "time": 2209.19, "timestamp": "00:36:49", "text": "只需按 F 键即可播放。"}]
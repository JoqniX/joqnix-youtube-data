[{"type": "subtitle", "time": 14340.309, "timestamp": "03:59:00", "text": "当然好心。"}, {"type": "subtitle", "time": 14342.95, "timestamp": "03:59:02", "text": "所以如果你碰巧遇到一只迷路的幻兽，"}, {"type": "subtitle", "time": 14345.51, "timestamp": "03:59:05", "text": "试试给它一些美味的零食来哄它开心。"}, {"type": "subtitle", "time": 14346.71, "timestamp": "03:59:06", "text": "关注你。"}, {"type": "subtitle", "time": 14348.79, "timestamp": "03:59:08", "text": "这样它就不会落入……手中。"}, {"type": "subtitle", "time": 14351.349, "timestamp": "03:59:11", "text": "那些邪恶的精灵猎人。"}, {"type": "subtitle", "time": 14353.429, "timestamp": "03:59:13", "text": "没错，就是那些邪恶的精灵猎人。"}, {"type": "subtitle", "time": 14356.229, "timestamp": "03:59:16", "text": "如果那个精灵猎人这么说，我就"}, {"type": "subtitle", "time": 14358.79, "timestamp": "03:59:18", "text": "让小黄人收集大量的"}, {"type": "subtitle", "time": 14366.15, "timestamp": "03:59:26", "text": "按住所有键选择军械库。"}, {"type": "subtitle", "time": 14369.269, "timestamp": "03:59:29", "text": "你是要约我出去吗？"}, {"type": "subtitle", "time": 14376.15, "timestamp": "03:59:36", "text": "升级。部署。升级。"}, {"type": "subtitle", "time": 14379.75, "timestamp": "03:59:39", "text": "你怎么认为？好吃。好吃。奶油。"}, {"type": "subtitle", "time": 14381.59, "timestamp": "03:59:41", "text": "好的。"}]
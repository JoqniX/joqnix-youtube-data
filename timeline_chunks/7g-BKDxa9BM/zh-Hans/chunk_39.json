[{"type": "subtitle", "time": 2340.069, "timestamp": "00:39:00", "text": "你到底是谁？"}, {"type": "subtitle", "time": 2343.27, "timestamp": "00:39:03", "text": "我的天啊。那段剧情被删减了。"}, {"type": "subtitle", "time": 2347.91, "timestamp": "00:39:07", "text": "好了，那是一段回忆。这一切。"}, {"type": "subtitle", "time": 2358.55, "timestamp": "00:39:18", "text": "那些污秽之徒无缘无故地攻击了你。"}, {"type": "subtitle", "time": 2361.67, "timestamp": "00:39:21", "text": "你来到这里之后，你设法"}, {"type": "subtitle", "time": 2365.43, "timestamp": "00:39:25", "text": "偶然间打开了隐藏的小路。"}, {"type": "subtitle", "time": 2369.51, "timestamp": "00:39:29", "text": "这就是你的故事吗？"}, {"type": "subtitle", "time": 2378.47, "timestamp": "00:39:38", "text": "西比尔警长，我们已经检查过她的脊椎了。"}, {"type": "subtitle", "time": 2380.47, "timestamp": "00:39:40", "text": "结构并确认她是"}]
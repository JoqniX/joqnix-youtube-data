[{"type": "subtitle", "time": 7320.229, "timestamp": "02:02:00", "text": "当然。"}, {"type": "subtitle", "time": 7324.149, "timestamp": "02:02:04", "text": "哇。但这确实是"}, {"type": "subtitle", "time": 7337.669, "timestamp": "02:02:17", "text": "看看这个。两层板条箱"}, {"type": "subtitle", "time": 7340.47, "timestamp": "02:02:20", "text": "靠墙站着。据该州称"}, {"type": "subtitle", "time": 7342.95, "timestamp": "02:02:22", "text": "于是，沉默寡言的女侦探玛吉"}, {"type": "subtitle", "time": 7345.27, "timestamp": "02:02:25", "text": "推断绝望的小偷一定有"}, {"type": "subtitle", "time": 7347.83, "timestamp": "02:02:27", "text": "他们把这些箱子堆起来爬墙。"}, {"type": "subtitle", "time": 7349.91, "timestamp": "02:02:29", "text": "聪明的想法。"}, {"type": "subtitle", "time": 7352.87, "timestamp": "02:02:32", "text": "如此沉默寡言的侦探，那就是你"}, {"type": "subtitle", "time": 7356.79, "timestamp": "02:02:36", "text": "标题，玛吉。听起来不错。有点短"}, {"type": "subtitle", "time": 7359.669, "timestamp": "02:02:39", "text": "尽管。力度还可以再强一些。"}, {"type": "subtitle", "time": 7362.31, "timestamp": "02:02:42", "text": "有道理。有什么建议吗，恶魔？"}, {"type": "subtitle", "time": 7364.709, "timestamp": "02:02:44", "text": "国王？"}, {"type": "subtitle", "time": 7371.83, "timestamp": "02:02:51", "text": "[音乐]"}, {"type": "subtitle", "time": 7373.589, "timestamp": "02:02:53", "text": "那边那个老头叫你"}, {"type": "subtitle", "time": 7375.669, "timestamp": "02:02:55", "text": "公主垃圾桶。"}]
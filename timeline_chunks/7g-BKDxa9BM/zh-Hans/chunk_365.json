[{"type": "subtitle", "time": 21902.15, "timestamp": "06:05:02", "text": "我们走吧。那是一次迅速的逃脱。"}, {"type": "subtitle", "time": 21904.31, "timestamp": "06:05:04", "text": "我会惩罚那些不忠的人。"}, {"type": "subtitle", "time": 21907.27, "timestamp": "06:05:07", "text": "去爱。以爱神之名"}, {"type": "subtitle", "time": 21909.99, "timestamp": "06:05:09", "text": "可以攀登。无法升华。"}, {"type": "subtitle", "time": 21947.51, "timestamp": "06:05:47", "text": "感觉"}, {"type": "subtitle", "time": 21955.19, "timestamp": "06:05:55", "text": "有一个坏消息，还有，嗯，"}, {"type": "subtitle", "time": 21957.99, "timestamp": "06:05:57", "text": "另一个可能被认为是不好的"}, {"type": "subtitle", "time": 21959.59, "timestamp": "06:05:59", "text": "出色地。"}]
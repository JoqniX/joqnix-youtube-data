[{"type": "subtitle", "time": 6241.03, "timestamp": "01:44:01", "text": "制造一把枪。圣，"}, {"type": "subtitle", "time": 6244.709, "timestamp": "01:44:04", "text": "兄弟，农业的规模……"}, {"type": "subtitle", "time": 6247.27, "timestamp": "01:44:07", "text": "你喜欢的武器，你喜欢的角色"}, {"type": "subtitle", "time": 6265.99, "timestamp": "01:44:25", "text": "太酷了！"}, {"type": "subtitle", "time": 6269.99, "timestamp": "01:44:29", "text": "哇，你已经建好基地了。那么，他是谁？"}, {"type": "subtitle", "time": 6273.03, "timestamp": "01:44:33", "text": "你会来这里吗？我想知道。谁是"}, {"type": "subtitle", "time": 6284.629, "timestamp": "01:44:44", "text": "[音乐]"}, {"type": "subtitle", "time": 6288.31, "timestamp": "01:44:48", "text": "你正在点燃火焰。"}, {"type": "subtitle", "time": 6290.149, "timestamp": "01:44:50", "text": "这是锻造台。材料"}, {"type": "subtitle", "time": 6291.83, "timestamp": "01:44:51", "text": "我们收集的物品可以锻造成各种各样的"}, {"type": "subtitle", "time": 6295.189, "timestamp": "01:44:55", "text": "孩子，这是觅食计划。"}, {"type": "subtitle", "time": 6299.189, "timestamp": "01:44:59", "text": "我的锤子渴望释放它的威力。"}]
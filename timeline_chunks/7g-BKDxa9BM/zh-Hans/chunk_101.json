[{"type": "subtitle", "time": 6070.95, "timestamp": "01:41:10", "text": "嘿，你。是的，就是你。那边那个孩子。"}, {"type": "subtitle", "time": 6073.99, "timestamp": "01:41:13", "text": "你好，我是拿着锤子的露娜。"}, {"type": "subtitle", "time": 6074.709, "timestamp": "01:41:14", "text": "这是什么？"}, {"type": "subtitle", "time": 6078.47, "timestamp": "01:41:18", "text": "长得像Snow的女孩？"}, {"type": "subtitle", "time": 6081.109, "timestamp": "01:41:21", "text": "哦，他们是兄妹。"}, {"type": "subtitle", "time": 6083.43, "timestamp": "01:41:23", "text": "等等，那个女孩有胡子。什么？"}, {"type": "subtitle", "time": 6085.52, "timestamp": "01:41:25", "text": "什么？ 你在叫谁女孩？"}, {"type": "subtitle", "time": 6089.44, "timestamp": "01:41:29", "text": "你在叫谁女孩？ 如今的年轻一代是"}, {"type": "subtitle", "time": 6091.679, "timestamp": "01:41:31", "text": "如今的年轻一代是 太不尊重人了。"}, {"type": "subtitle", "time": 6098.229, "timestamp": "01:41:38", "text": "你说话要小心。虽然"}, {"type": "subtitle", "time": 6100.79, "timestamp": "01:41:40", "text": "所有月球人看起来都很年轻，她其实也挺老的。"}, {"type": "subtitle", "time": 6103.43, "timestamp": "01:41:43", "text": "和你曾祖母一样老。"}, {"type": "subtitle", "time": 6116.39, "timestamp": "01:41:56", "text": "道德。"}]
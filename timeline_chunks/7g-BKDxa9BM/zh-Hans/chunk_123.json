[{"type": "subtitle", "time": 7404.229, "timestamp": "02:03:24", "text": "他们应该让它可以让你……"}, {"type": "subtitle", "time": 7406.55, "timestamp": "02:03:26", "text": "一路攀爬墙壁来到这里。你"}, {"type": "subtitle", "time": 7407.669, "timestamp": "02:03:27", "text": "你说过要把钱分给大家。"}, {"type": "subtitle", "time": 7410.07, "timestamp": "02:03:30", "text": "反正都是穷人，为什么我不能和他们在一起"}, {"type": "subtitle", "time": 7412.79, "timestamp": "02:03:32", "text": "一部分？"}, {"type": "subtitle", "time": 7415.91, "timestamp": "02:03:35", "text": "如果你经济困难，我可以帮你。但"}, {"type": "subtitle", "time": 7418.47, "timestamp": "02:03:38", "text": "你不能随便从别人那里抢钱。"}, {"type": "subtitle", "time": 7419.83, "timestamp": "02:03:39", "text": "那样做会挨一记耳光。"}, {"type": "subtitle", "time": 7427.189, "timestamp": "02:03:47", "text": "[音乐]"}, {"type": "subtitle", "time": 7430.39, "timestamp": "02:03:50", "text": "他又失踪了。他是什么人？一个"}, {"type": "subtitle", "time": 7431.669, "timestamp": "02:03:51", "text": "鬼？"}]
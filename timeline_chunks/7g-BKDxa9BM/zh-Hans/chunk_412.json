[{"type": "subtitle", "time": 24721.35, "timestamp": "06:52:01", "text": "爸爸妈妈不在的时候，只有我一个人在这里。"}, {"type": "subtitle", "time": 24723.91, "timestamp": "06:52:03", "text": "现在我们可以拍照了。"}, {"type": "subtitle", "time": 24728.15, "timestamp": "06:52:08", "text": "他们没有生我的气。相反，他们"}, {"type": "subtitle", "time": 24731.35, "timestamp": "06:52:11", "text": "他说：“让我们在你到来时把它挖出来……”"}, {"type": "subtitle", "time": 24737.43, "timestamp": "06:52:17", "text": "一个"}, {"type": "subtitle", "time": 24739.51, "timestamp": "06:52:19", "text": "谢谢你陪伴我度过这些时光"}, {"type": "subtitle", "time": 24742.07, "timestamp": "06:52:22", "text": "过去的日子。我不再需要它了，因为"}, {"type": "subtitle", "time": 24750.31, "timestamp": "06:52:30", "text": "既然我们已经到了这里，"}, {"type": "subtitle", "time": 24751.19, "timestamp": "06:52:31", "text": "怎么样？"}, {"type": "subtitle", "time": 24755.11, "timestamp": "06:52:35", "text": "唉，为什么这么感人呢？相机有"}, {"type": "subtitle", "time": 24761.59, "timestamp": "06:52:41", "text": "有时，这会把我带到这里。"}, {"type": "subtitle", "time": 24764.948, "timestamp": "06:52:44", "text": "散步。尽管偶尔会有躲藏和"}, {"type": "subtitle", "time": 24767.27, "timestamp": "06:52:47", "text": "与污秽之人为伍，"}, {"type": "subtitle", "time": 24769.75, "timestamp": "06:52:49", "text": "我一直都很期待来这里。"}, {"type": "subtitle", "time": 24772.948, "timestamp": "06:52:52", "text": "因为我喜欢浮冰，"}, {"type": "subtitle", "time": 24777.03, "timestamp": "06:52:57", "text": "这里有山。而且，我非常喜欢"}]
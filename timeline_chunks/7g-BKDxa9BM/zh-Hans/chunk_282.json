[{"type": "subtitle", "time": 16921.51, "timestamp": "04:42:01", "text": "在你的小团队里，你说了算。"}, {"type": "subtitle", "time": 16922.55, "timestamp": "04:42:02", "text": "正确的？"}, {"type": "subtitle", "time": 16925.75, "timestamp": "04:42:05", "text": "告诉我，你们为什么要去参加所有这些活动？"}, {"type": "subtitle", "time": 16929.27, "timestamp": "04:42:09", "text": "知道吗？嗯，这说得通。我已经"}, {"type": "subtitle", "time": 16931.91, "timestamp": "04:42:11", "text": "我有点时间想解释一下。他们"}, {"type": "subtitle", "time": 16934.15, "timestamp": "04:42:14", "text": "今晚有空吗？您可以放心。"}, {"type": "subtitle", "time": 16936.31, "timestamp": "04:42:16", "text": "你要做什么？"}, {"type": "subtitle", "time": 16938.31, "timestamp": "04:42:18", "text": "看到这些包装了吗？如果不是因为"}, {"type": "subtitle", "time": 16940.31, "timestamp": "04:42:20", "text": "这个怪物，它们的拥有者可能是"}, {"type": "subtitle", "time": 16941.91, "timestamp": "04:42:21", "text": "在阿斯福德酒店放松身心，啜饮饮品"}, {"type": "subtitle", "time": 16943.83, "timestamp": "04:42:23", "text": "互相讲述故事。我想看看我是否"}, {"type": "subtitle", "time": 16945.19, "timestamp": "04:42:25", "text": "可以识别它们并归还它们"}, {"type": "subtitle", "time": 16946.948, "timestamp": "04:42:26", "text": "将财物交给家人。感谢"}, {"type": "subtitle", "time": 16948.788, "timestamp": "04:42:28", "text": "天哪，原来是你们这些恶魔闯进来的！"}, {"type": "subtitle", "time": 16949.91, "timestamp": "04:42:29", "text": "今天。"}, {"type": "subtitle", "time": 16951.43, "timestamp": "04:42:31", "text": "水坝。"}, {"type": "subtitle", "time": 16953.43, "timestamp": "04:42:33", "text": "各位，他们最终可能只是"}, {"type": "subtitle", "time": 16955.51, "timestamp": "04:42:35", "text": "喜欢他们。"}, {"type": "subtitle", "time": 16957.91, "timestamp": "04:42:37", "text": "恶魔。"}, {"type": "subtitle", "time": 16959.35, "timestamp": "04:42:39", "text": "那些经历过"}, {"type": "subtitle", "time": 16961.67, "timestamp": "04:42:41", "text": "觉醒并获得特殊能力，例如"}, {"type": "subtitle", "time": 16963.27, "timestamp": "04:42:43", "text": "我们。"}, {"type": "subtitle", "time": 16964.55, "timestamp": "04:42:44", "text": "哦，"}, {"type": "subtitle", "time": 16966.15, "timestamp": "04:42:46", "text": "你怎么会像个新手一样一窍不通呢？"}, {"type": "subtitle", "time": 16968.788, "timestamp": "04:42:48", "text": "孵出来的鹌鹑？我敢打赌，即使是这么一点点"}, {"type": "subtitle", "time": 16970.708, "timestamp": "04:42:50", "text": "你旁边的白色纽扣蘑菇更多"}, {"type": "subtitle", "time": 16973.51, "timestamp": "04:42:53", "text": "知情。"}, {"type": "subtitle", "time": 16977.67, "timestamp": "04:42:57", "text": "当然，斯诺真的很聪明。等待，"}]
[{"type": "subtitle", "time": 4621.43, "timestamp": "01:17:01", "text": "预计会有100名日本观众到场。"}, {"type": "subtitle", "time": 4623.59, "timestamp": "01:17:03", "text": "是的，不过我现在在亚洲。"}, {"type": "subtitle", "time": 4625.03, "timestamp": "01:17:05", "text": "机不可失。"}, {"type": "subtitle", "time": 4626.79, "timestamp": "01:17:06", "text": "它在日本会很受欢迎，对吧？"}, {"type": "subtitle", "time": 4630.39, "timestamp": "01:17:10", "text": "好的。既然我已经把你带进来了，"}, {"type": "subtitle", "time": 4630.95, "timestamp": "01:17:10", "text": "没关系。"}, {"type": "subtitle", "time": 4633.43, "timestamp": "01:17:13", "text": "我应该回我的酒馆了。"}, {"type": "subtitle", "time": 4641.43, "timestamp": "01:17:21", "text": "等一下。那就快点。时间"}, {"type": "subtitle", "time": 4642.63, "timestamp": "01:17:22", "text": "对商人来说，就是钱。"}, {"type": "subtitle", "time": 4656.55, "timestamp": "01:17:36", "text": "是的。就在昨天，一片漆黑"}, {"type": "subtitle", "time": 4659.189, "timestamp": "01:17:39", "text": "刮风的傍晚。"}, {"type": "subtitle", "time": 4661.669, "timestamp": "01:17:41", "text": "嗯，一个身穿白色斗篷、头戴兜帽的男人"}, {"type": "subtitle", "time": 4663.27, "timestamp": "01:17:43", "text": "我和卡米拉达成协议，要找到你。"}, {"type": "subtitle", "time": 4665.11, "timestamp": "01:17:45", "text": "并带你进入你还记得什么吗？"}, {"type": "subtitle", "time": 4665.669, "timestamp": "01:17:45", "text": "这张地图？"}, {"type": "subtitle", "time": 4667.59, "timestamp": "01:17:47", "text": "他从头到脚都裹得严严实实。"}, {"type": "subtitle", "time": 4671.59, "timestamp": "01:17:51", "text": "先生，我完全不知道。"}, {"type": "subtitle", "time": 4673.59, "timestamp": "01:17:53", "text": "真奇怪。"}, {"type": "subtitle", "time": 4675.83, "timestamp": "01:17:55", "text": "某个神秘的恩人，来自……"}, {"type": "subtitle", "time": 4677.99, "timestamp": "01:17:57", "text": "总会有人把你从咸水中救出来。"}, {"type": "subtitle", "time": 4679.59, "timestamp": "01:17:59", "text": "水"}]
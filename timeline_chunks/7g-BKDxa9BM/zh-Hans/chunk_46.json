[{"type": "subtitle", "time": 2764.95, "timestamp": "00:46:04", "text": "有趣的。"}, {"type": "subtitle", "time": 2769.589, "timestamp": "00:46:09", "text": "你好。你能听到我吗？"}, {"type": "subtitle", "time": 2771.589, "timestamp": "00:46:11", "text": "这个小孩是谁？"}, {"type": "subtitle", "time": 2774.55, "timestamp": "00:46:14", "text": "卡米拉，"}, {"type": "subtitle", "time": 2777.589, "timestamp": "00:46:17", "text": "她醒了。"}, {"type": "subtitle", "time": 2779.43, "timestamp": "00:46:19", "text": "哦，那就是我们在……看到的那位女士。"}, {"type": "subtitle", "time": 2780.71, "timestamp": "00:46:20", "text": "过场动画。"}, {"type": "subtitle", "time": 2783.27, "timestamp": "00:46:23", "text": "仍然活着，且未丧失行为能力。"}, {"type": "subtitle", "time": 2786.309, "timestamp": "00:46:26", "text": "看来没人骨折。"}, {"type": "subtitle", "time": 2788.23, "timestamp": "00:46:28", "text": "我怎么还活着？"}, {"type": "subtitle", "time": 2791.51, "timestamp": "00:46:31", "text": "你怎么知道我的名字？巴里，那里"}, {"type": "subtitle", "time": 2794.39, "timestamp": "00:46:34", "text": "是吗？"}, {"type": "subtitle", "time": 2795.99, "timestamp": "00:46:35", "text": "不。"}, {"type": "subtitle", "time": 2797.349, "timestamp": "00:46:37", "text": "我们曾"}, {"type": "subtitle", "time": 2800.79, "timestamp": "00:46:40", "text": "我必须找到巴里。"}, {"type": "subtitle", "time": 2802.309, "timestamp": "00:46:42", "text": "或许。"}, {"type": "subtitle", "time": 2805.67, "timestamp": "00:46:45", "text": "嘿，你到底有没有在听？卡米拉和"}, {"type": "chat", "time": 2806.156, "timestamp": "00:46:46", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "Is it hot where you are?"}, {"type": "subtitle", "time": 2807.19, "timestamp": "00:46:47", "text": "雪一路飘到了这里。"}, {"type": "subtitle", "time": 2808.63, "timestamp": "00:46:48", "text": "好的。她的名字叫雪。"}, {"type": "subtitle", "time": 2810.15, "timestamp": "00:46:50", "text": "你最好跟我们一起进城。和"}, {"type": "subtitle", "time": 2813.91, "timestamp": "00:46:53", "text": "那位金发女士的名字是"}, {"type": "subtitle", "time": 2816.55, "timestamp": "00:46:56", "text": "你那里热吗？不太热。"}, {"type": "subtitle", "time": 2818.39, "timestamp": "00:46:58", "text": "中等。"}]
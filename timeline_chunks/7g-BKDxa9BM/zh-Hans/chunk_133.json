[{"type": "subtitle", "time": 7980.149, "timestamp": "02:13:00", "text": "很少有猎狐者抱着侥幸心理去碰碰运气。"}, {"type": "subtitle", "time": 7982.55, "timestamp": "02:13:02", "text": "在那里找到了一些狐狸精残渣，但是"}, {"type": "subtitle", "time": 7984.31, "timestamp": "02:13:04", "text": "没有一个人回来。"}, {"type": "subtitle", "time": 7985.51, "timestamp": "02:13:05", "text": "Foxines 正在成长。"}, {"type": "subtitle", "time": 7987.75, "timestamp": "02:13:07", "text": "所以，即使亨里克悬赏5000英镑"}, {"type": "subtitle", "time": 7990.39, "timestamp": "02:13:10", "text": "银币，没有猎狐者拿走"}, {"type": "subtitle", "time": 7992.229, "timestamp": "02:13:12", "text": "咬。"}, {"type": "subtitle", "time": 7994.39, "timestamp": "02:13:14", "text": "猎狐者天生就是冒险家。"}, {"type": "subtitle", "time": 7995.109, "timestamp": "02:13:15", "text": "我要买它"}, {"type": "subtitle", "time": 7997.91, "timestamp": "02:13:17", "text": "而不是鲁莽的傻瓜。这块石头非常"}, {"type": "subtitle", "time": 8000.709, "timestamp": "02:13:20", "text": "撇开存在与否不谈，谁知道亨里克是否能……"}, {"type": "subtitle", "time": 8007.43, "timestamp": "02:13:27", "text": "大家都知道他最近离开了。"}, {"type": "subtitle", "time": 8009.589, "timestamp": "02:13:29", "text": "破产了，甚至想把资产卖掉"}, {"type": "subtitle", "time": 8012.55, "timestamp": "02:13:32", "text": "家庭住宅。他打算赌博吗？"}, {"type": "subtitle", "time": 8015.189, "timestamp": "02:13:35", "text": "这一切都在交易水晶上进行吗？"}, {"type": "subtitle", "time": 8017.83, "timestamp": "02:13:37", "text": "等一下。水晶交易一直是"}, {"type": "subtitle", "time": 8019.91, "timestamp": "02:13:39", "text": "被禁多年。"}, {"type": "subtitle", "time": 8029.589, "timestamp": "02:13:49", "text": "卡米拉小姐，你说了多少？"}, {"type": "subtitle", "time": 8029.99, "timestamp": "02:13:49", "text": "费用是多少？"}, {"type": "subtitle", "time": 8032.149, "timestamp": "02:13:52", "text": "价格差不多。"}, {"type": "subtitle", "time": 8033.43, "timestamp": "02:13:53", "text": "有兴趣参加"}, {"type": "subtitle", "time": 8035.83, "timestamp": "02:13:55", "text": "你？你是认真的吗？"}, {"type": "subtitle", "time": 8038.629, "timestamp": "02:13:58", "text": "谢谢。你曾经告诉我"}]
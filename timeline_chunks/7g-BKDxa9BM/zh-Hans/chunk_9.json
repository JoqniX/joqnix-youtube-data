[{"type": "subtitle", "time": 541.67, "timestamp": "00:09:01", "text": "你醒来的时候我就在这里。"}, {"type": "subtitle", "time": 544.15, "timestamp": "00:09:04", "text": "没关系。我们应该下去"}, {"type": "subtitle", "time": 546.63, "timestamp": "00:09:06", "text": "爬山，然后前往村庄。"}, {"type": "subtitle", "time": 548.47, "timestamp": "00:09:08", "text": "你想回去吗？已经"}, {"type": "subtitle", "time": 550.389, "timestamp": "00:09:10", "text": "那里连续几天都传来咆哮声。"}, {"type": "subtitle", "time": 552.71, "timestamp": "00:09:12", "text": "我在想我们能不能回家。"}, {"type": "subtitle", "time": 555.99, "timestamp": "00:09:15", "text": "拿起我们的武器，用你的"}, {"type": "subtitle", "time": 558.87, "timestamp": "00:09:18", "text": "只要有力量，你就能找到出路。不"}, {"type": "subtitle", "time": 560.71, "timestamp": "00:09:20", "text": "无论如何，总会有人来救我们。"}, {"type": "subtitle", "time": 563.269, "timestamp": "00:09:23", "text": "我们在这里待多久。反正，"}, {"type": "subtitle", "time": 591.269, "timestamp": "00:09:51", "text": "离开山洞。"}, {"type": "subtitle", "time": 593.03, "timestamp": "00:09:53", "text": "感觉就像我在玩单曲一样"}, {"type": "subtitle", "time": 595.35, "timestamp": "00:09:55", "text": "玩家游戏，"}]
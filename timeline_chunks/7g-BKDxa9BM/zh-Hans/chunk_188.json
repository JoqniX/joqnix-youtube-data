[{"type": "subtitle", "time": 11285.11, "timestamp": "03:08:05", "text": "我回来了。"}, {"type": "subtitle", "time": 11290.63, "timestamp": "03:08:10", "text": "晚的。"}, {"type": "subtitle", "time": 11293.83, "timestamp": "03:08:13", "text": "亚洲的延迟简直太严重了。等等，该怎么做？"}, {"type": "subtitle", "time": 11296.15, "timestamp": "03:08:16", "text": "你知道它运行起来是否卡顿吗？"}, {"type": "subtitle", "time": 11302.87, "timestamp": "03:08:22", "text": "我的天哪。我在这里。"}, {"type": "subtitle", "time": 11306.389, "timestamp": "03:08:26", "text": "我来了，各位。"}, {"type": "subtitle", "time": 11327.349, "timestamp": "03:08:47", "text": "好的，"}, {"type": "subtitle", "time": 11330.71, "timestamp": "03:08:50", "text": "我打喷嚏打个不停。我吃过晚饭了。"}]
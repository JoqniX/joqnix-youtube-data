[{"type": "subtitle", "time": 7056.55, "timestamp": "01:57:36", "text": "然后，他突然从某个地方袭击了我。"}, {"type": "subtitle", "time": 7059.189, "timestamp": "01:57:39", "text": "然后我偷偷拿走了刚拿到的现金。"}, {"type": "subtitle", "time": 7061.35, "timestamp": "01:57:41", "text": "哦，那只转子发动机连我们都不放过。"}, {"type": "subtitle", "time": 7062.79, "timestamp": "01:57:42", "text": "拾荒者。"}, {"type": "subtitle", "time": 7064.95, "timestamp": "01:57:44", "text": "那笔钱是给好几个家庭的"}, {"type": "subtitle", "time": 7067.43, "timestamp": "01:57:47", "text": "贫民窟的维护。"}, {"type": "subtitle", "time": 7069.83, "timestamp": "01:57:49", "text": "如果没有那袋硬币，所有年轻人"}, {"type": "subtitle", "time": 7071.669, "timestamp": "01:57:51", "text": "老年人则不得不勒紧裤腰带过日子了。"}, {"type": "subtitle", "time": 7075.03, "timestamp": "01:57:55", "text": "下个月还会更多。"}, {"type": "subtitle", "time": 7077.51, "timestamp": "01:57:57", "text": "我没有"}, {"type": "subtitle", "time": 7079.35, "timestamp": "01:57:59", "text": "跑去。我需要有人帮助我"}]
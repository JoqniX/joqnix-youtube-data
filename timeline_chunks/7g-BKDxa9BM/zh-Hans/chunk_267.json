[{"type": "subtitle", "time": 16021.189, "timestamp": "04:27:01", "text": "云。"}, {"type": "subtitle", "time": 16023.269, "timestamp": "04:27:03", "text": "我喜欢这一切。"}, {"type": "subtitle", "time": 16026.309, "timestamp": "04:27:06", "text": "雪更像是一座城市。"}, {"type": "subtitle", "time": 16029.67, "timestamp": "04:27:09", "text": "前方就是闪耀之坑的入口。"}, {"type": "subtitle", "time": 16031.91, "timestamp": "04:27:11", "text": "请格外小心。"}, {"type": "subtitle", "time": 16032.79, "timestamp": "04:27:12", "text": "那我们走吧。"}, {"type": "subtitle", "time": 16035.83, "timestamp": "04:27:15", "text": "我们走吧。让我们闪耀光芒。好吧。"}, {"type": "subtitle", "time": 16045.91, "timestamp": "04:27:25", "text": "这是什么？"}, {"type": "subtitle", "time": 16054.71, "timestamp": "04:27:34", "text": "哎哟。"}, {"type": "subtitle", "time": 16057.91, "timestamp": "04:27:37", "text": "这么厚的门大概是防不住的。"}, {"type": "subtitle", "time": 16059.75, "timestamp": "04:27:39", "text": "诉诸蛮力。"}, {"type": "subtitle", "time": 16061.51, "timestamp": "04:27:41", "text": "然后我们四处看看有没有……"}, {"type": "subtitle", "time": 16062.95, "timestamp": "04:27:42", "text": "还有另一种进入方式。"}, {"type": "subtitle", "time": 16066.389, "timestamp": "04:27:46", "text": "雪，你头疼吗？让我来帮忙"}, {"type": "subtitle", "time": 16074.63, "timestamp": "04:27:54", "text": "以物易物，减轻痛苦。"}]
[{"type": "subtitle", "time": 14281.429, "timestamp": "03:58:01", "text": "我不想收集宝箱。诚实地，"}, {"type": "subtitle", "time": 14283.189, "timestamp": "03:58:03", "text": "我想使用交互式地图来"}, {"type": "subtitle", "time": 14286.389, "timestamp": "03:58:06", "text": "把它们收集起来。"}, {"type": "subtitle", "time": 14289.269, "timestamp": "03:58:09", "text": "喂养。你可以利用性状来吸引基因"}, {"type": "subtitle", "time": 14291.269, "timestamp": "03:58:11", "text": "数量不等。更高品质"}, {"type": "subtitle", "time": 14297.349, "timestamp": "03:58:17", "text": "在红明府祈祷"}, {"type": "subtitle", "time": 14298.87, "timestamp": "03:58:18", "text": "尤其是当你瞄准中心时"}, {"type": "subtitle", "time": 14319.11, "timestamp": "03:58:39", "text": "哦，这个是我带来的。好的。"}, {"type": "subtitle", "time": 14321.83, "timestamp": "03:58:41", "text": "是的，就是这样。你是"}, {"type": "subtitle", "time": 14327.269, "timestamp": "03:58:47", "text": "什么是"}, {"type": "subtitle", "time": 14329.269, "timestamp": "03:58:49", "text": "就是这个小家伙说你感觉到了"}, {"type": "subtitle", "time": 14332.389, "timestamp": "03:58:52", "text": "就像可以信任的人一样熟悉"}, {"type": "subtitle", "time": 14334.469, "timestamp": "03:58:54", "text": "它想和你一起走。"}, {"type": "subtitle", "time": 14336.15, "timestamp": "03:58:56", "text": "你负责处理。"}]
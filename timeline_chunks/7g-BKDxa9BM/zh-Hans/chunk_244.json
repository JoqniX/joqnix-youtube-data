[{"type": "subtitle", "time": 14654.63, "timestamp": "04:04:14", "text": "兄弟，我做不到。"}, {"type": "subtitle", "time": 14656.71, "timestamp": "04:04:16", "text": "太残酷了。"}, {"type": "subtitle", "time": 14658.87, "timestamp": "04:04:18", "text": "别惊慌。"}, {"type": "subtitle", "time": 14661.349, "timestamp": "04:04:21", "text": "哦不，那个控制器启动了"}, {"type": "subtitle", "time": 14662.07, "timestamp": "04:04:22", "text": "警报。"}, {"type": "subtitle", "time": 14663.349, "timestamp": "04:04:23", "text": "不。不。"}, {"type": "subtitle", "time": 14665.429, "timestamp": "04:04:25", "text": "你知道这会发生。这些"}, {"type": "subtitle", "time": 14667.429, "timestamp": "04:04:27", "text": "这群家伙走投无路了，决定"}, {"type": "subtitle", "time": 14669.51, "timestamp": "04:04:29", "text": "为什么它们这么难杀死？"}, {"type": "subtitle", "time": 14671.51, "timestamp": "04:04:31", "text": "必须在目标人物遇难之前救出他。"}, {"type": "subtitle", "time": 14679.269, "timestamp": "04:04:39", "text": "四点伤害。你在开玩笑吧？"}, {"type": "subtitle", "time": 14681.91, "timestamp": "04:04:41", "text": "是我功率不足吗？"}, {"type": "subtitle", "time": 14683.91, "timestamp": "04:04:43", "text": "太残酷了。"}, {"type": "subtitle", "time": 14686.229, "timestamp": "04:04:46", "text": "啊，"}, {"type": "subtitle", "time": 14689.83, "timestamp": "04:04:49", "text": "大家都到齐了。去死吧，去死吧。死吧，死吧，"}, {"type": "subtitle", "time": 14699.51, "timestamp": "04:04:59", "text": "我派你到那地去。"}]
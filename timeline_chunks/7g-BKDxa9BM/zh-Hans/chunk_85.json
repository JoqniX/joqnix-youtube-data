[{"type": "subtitle", "time": 5100.39, "timestamp": "01:25:00", "text": "亨里克先生，我回来了。"}, {"type": "subtitle", "time": 5102.55, "timestamp": "01:25:02", "text": "我刚刚又把房子收拾了一遍。"}, {"type": "subtitle", "time": 5105.43, "timestamp": "01:25:05", "text": "一切就绪。"}, {"type": "subtitle", "time": 5106.81, "timestamp": "01:25:06", "text": "当心。"}, {"type": "subtitle", "time": 5108.31, "timestamp": "01:25:08", "text": "[音乐]"}, {"type": "subtitle", "time": 5110.229, "timestamp": "01:25:10", "text": "这位女士是谁？"}, {"type": "subtitle", "time": 5115.27, "timestamp": "01:25:15", "text": "你是新房客吗？"}, {"type": "subtitle", "time": 5118.95, "timestamp": "01:25:18", "text": "她看起来像是在寻找"}, {"type": "subtitle", "time": 5121.99, "timestamp": "01:25:21", "text": "我当时正准备把她赶出去。"}, {"type": "subtitle", "time": 5124.229, "timestamp": "01:25:24", "text": "一个 Ider。"}, {"type": "subtitle", "time": 5127.35, "timestamp": "01:25:27", "text": "但如果你把她赶出去，她岂不是……"}, {"type": "subtitle", "time": 5128.31, "timestamp": "01:25:28", "text": "无家可归？"}, {"type": "subtitle", "time": 5130.39, "timestamp": "01:25:30", "text": "确切地。我不想流落街头。"}, {"type": "subtitle", "time": 5139.43, "timestamp": "01:25:39", "text": "但房子至今仍未售出。"}, {"type": "subtitle", "time": 5141.75, "timestamp": "01:25:41", "text": "借给她一晚不会有什么问题"}, {"type": "subtitle", "time": 5144.47, "timestamp": "01:25:44", "text": "疼吧？"}, {"type": "subtitle", "time": 5147.189, "timestamp": "01:25:47", "text": "她有能力的时候会还你的钱。那"}, {"type": "subtitle", "time": 5149.669, "timestamp": "01:25:49", "text": "这样，我们就能赚点额外的现金了。"}, {"type": "subtitle", "time": 5152.79, "timestamp": "01:25:52", "text": "基本上什么也没有。"}, {"type": "subtitle", "time": 5155.669, "timestamp": "01:25:55", "text": "如果你继续对每个人都这么冷漠，"}, {"type": "subtitle", "time": 5157.27, "timestamp": "01:25:57", "text": "你永远也找不到买家。"}, {"type": "subtitle", "time": 5159.59, "timestamp": "01:25:59", "text": "地方。"}]
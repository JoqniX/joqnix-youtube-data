[{"type": "subtitle", "time": 21960.708, "timestamp": "06:06:00", "text": "好的，"}, {"type": "subtitle", "time": 21965.03, "timestamp": "06:06:05", "text": "我们先来说说最糟糕的那个。"}, {"type": "subtitle", "time": 21969.03, "timestamp": "06:06:09", "text": "留在普尔加托里奥岛上的装置"}, {"type": "subtitle", "time": 21971.75, "timestamp": "06:06:11", "text": "已经在这个区域搜索了三天，但是……"}, {"type": "subtitle", "time": 21973.99, "timestamp": "06:06:13", "text": "他们至今尚未找到任何相关线索。"}, {"type": "subtitle", "time": 21980.868, "timestamp": "06:06:20", "text": "我们搜索了附近的水域。"}, {"type": "subtitle", "time": 21982.47, "timestamp": "06:06:22", "text": "她刚从……上摔下来就……"}, {"type": "subtitle", "time": 21984.948, "timestamp": "06:06:24", "text": "悬崖。理论上讲，她"}, {"type": "subtitle", "time": 21987.91, "timestamp": "06:06:27", "text": "不该漂流太远"}, {"type": "subtitle", "time": 21990.868, "timestamp": "06:06:30", "text": "除非"}, {"type": "subtitle", "time": 21999.83, "timestamp": "06:06:39", "text": "救了她。"}, {"type": "subtitle", "time": 22001.75, "timestamp": "06:06:41", "text": "继续调查该住所"}, {"type": "subtitle", "time": 22004.39, "timestamp": "06:06:44", "text": "附近岛屿。不留下任何嫌疑人或"}, {"type": "subtitle", "time": 22007.59, "timestamp": "06:06:47", "text": "未经核实的证人。"}, {"type": "subtitle", "time": 22009.75, "timestamp": "06:06:49", "text": "我们已经在着手做了，而且正在扩大规模。"}, {"type": "subtitle", "time": 22015.27, "timestamp": "06:06:55", "text": "搜索区域。呃，请问一下，"}, {"type": "subtitle", "time": 22017.91, "timestamp": "06:06:57", "text": "如果我们找到了她，主持人"}, {"type": "subtitle", "time": 22019.27, "timestamp": "06:06:59", "text": "谐振，"}]
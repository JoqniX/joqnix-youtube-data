[{"type": "subtitle", "time": 2940.39, "timestamp": "00:49:00", "text": "你如何与NPC们一起诞生？"}, {"type": "subtitle", "time": 2942.549, "timestamp": "00:49:02", "text": "一切。"}, {"type": "subtitle", "time": 2944.71, "timestamp": "00:49:04", "text": "互动或活动期间的更多信息"}, {"type": "subtitle", "time": 2948.95, "timestamp": "00:49:08", "text": "激活支线任务。"}, {"type": "subtitle", "time": 2951.589, "timestamp": "00:49:11", "text": "卢诺就像他欣赏那些……"}, {"type": "subtitle", "time": 2953.99, "timestamp": "00:49:13", "text": "一旦你建立起强大的个性"}, {"type": "subtitle", "time": 2956.63, "timestamp": "00:49:16", "text": "带有印象和骰子的游戏"}, {"type": "subtitle", "time": 2964.47, "timestamp": "00:49:24", "text": "益处"}, {"type": "subtitle", "time": 2970.95, "timestamp": "00:49:30", "text": "我们需要一些有趣的知识"}, {"type": "subtitle", "time": 2973.51, "timestamp": "00:49:33", "text": "探索这个世界。"}, {"type": "subtitle", "time": 2977.19, "timestamp": "00:49:37", "text": "按住 Alt 键可显示文化和武器库。"}, {"type": "subtitle", "time": 2979.03, "timestamp": "00:49:39", "text": "我们今天要去哪个大厅？"}, {"type": "subtitle", "time": 2981.75, "timestamp": "00:49:41", "text": "还有僵尸。呃，你可以查看，"}, {"type": "subtitle", "time": 2983.43, "timestamp": "00:49:43", "text": "替换、升级角色及其"}, {"type": "subtitle", "time": 2985.99, "timestamp": "00:49:45", "text": "近战武器和玉米武器。"}, {"type": "subtitle", "time": 2989.589, "timestamp": "00:49:49", "text": "好的。点击这些点即可将它们合并。"}, {"type": "subtitle", "time": 2991.75, "timestamp": "00:49:51", "text": "哦，我免费解锁了一个新角色。"}, {"type": "subtitle", "time": 2993.19, "timestamp": "00:49:53", "text": "听说过我的头衔。"}, {"type": "subtitle", "time": 2994.549, "timestamp": "00:49:54", "text": "她长得像安柏。"}, {"type": "subtitle", "time": 2996.23, "timestamp": "00:49:56", "text": "旋转。"}, {"type": "subtitle", "time": 2998.15, "timestamp": "00:49:58", "text": "请不要配合。只需打电话"}, {"type": "subtitle", "time": 2999.43, "timestamp": "00:49:59", "text": "我。"}]
[{"type": "subtitle", "time": 7141.35, "timestamp": "01:59:01", "text": "偶然发现任何有用的信息，你就会"}, {"type": "subtitle", "time": 7143.99, "timestamp": "01:59:03", "text": "最先知道的人。"}, {"type": "subtitle", "time": 7146.149, "timestamp": "01:59:06", "text": "是你。"}, {"type": "subtitle", "time": 7148.55, "timestamp": "01:59:08", "text": "你就是那个来自……的小女孩"}, {"type": "subtitle", "time": 7151.99, "timestamp": "01:59:11", "text": "这个词组是“心理”，对吧？"}, {"type": "subtitle", "time": 7154.87, "timestamp": "01:59:14", "text": "是的，卡米拉小姐。"}, {"type": "subtitle", "time": 7157.589, "timestamp": "01:59:17", "text": "我暂时住在许普诺斯之家。"}, {"type": "subtitle", "time": 7160.79, "timestamp": "01:59:20", "text": "我现在一直在打喷嚏。"}, {"type": "subtitle", "time": 7163.589, "timestamp": "01:59:23", "text": "我和朋友一起来的。"}, {"type": "subtitle", "time": 7166.149, "timestamp": "01:59:26", "text": "她正在找工作，并且希望"}, {"type": "subtitle", "time": 7169.109, "timestamp": "01:59:29", "text": "成为一名猎狐者。"}, {"type": "subtitle", "time": 7171.75, "timestamp": "01:59:31", "text": "那你来对地方了。"}, {"type": "subtitle", "time": 7173.43, "timestamp": "01:59:33", "text": "有一个专门为猎狐者设立的委员会。"}, {"type": "subtitle", "time": 7175.589, "timestamp": "01:59:35", "text": "现在。"}, {"type": "subtitle", "time": 7178.629, "timestamp": "01:59:38", "text": "现在不行，玛吉。"}, {"type": "subtitle", "time": 7185.91, "timestamp": "01:59:45", "text": "已经交到朋友了。你真是个……"}, {"type": "subtitle", "time": 7188.149, "timestamp": "01:59:48", "text": "你真是个迷人的人，不是吗？"}, {"type": "subtitle", "time": 7191.27, "timestamp": "01:59:51", "text": "至于猎狐者，"}, {"type": "subtitle", "time": 7193.589, "timestamp": "01:59:53", "text": "首先要明确一点。这不是"}, {"type": "subtitle", "time": 7196.229, "timestamp": "01:59:56", "text": "这可不是儿戏，也不是什么轻松的差事。没错"}, {"type": "subtitle", "time": 7197.91, "timestamp": "01:59:57", "text": "在这个地方，没有人会探究"}]
[{"type": "subtitle", "time": 22031.35, "timestamp": "06:07:11", "text": "完全觉醒的共振可以发挥作用"}, {"type": "subtitle", "time": 22034.39, "timestamp": "06:07:14", "text": "控制任何恶魔，但那种力量"}, {"type": "subtitle", "time": 22045.11, "timestamp": "06:07:25", "text": "没错。"}, {"type": "subtitle", "time": 22048.23, "timestamp": "06:07:28", "text": "这意味着如果她不合作，那么"}, {"type": "subtitle", "time": 22051.35, "timestamp": "06:07:31", "text": "俘虏她对帝国没有任何好处。"}, {"type": "subtitle", "time": 22053.75, "timestamp": "06:07:33", "text": "更糟糕的是，它甚至可能成为一种威胁。"}, {"type": "subtitle", "time": 22056.628, "timestamp": "06:07:36", "text": "就像上次一样。"}, {"type": "subtitle", "time": 22059.27, "timestamp": "06:07:39", "text": "然后我们重复之前的做法。擦干净"}, {"type": "subtitle", "time": 22062.15, "timestamp": "06:07:42", "text": "出去。这种权力不可能落入外部。"}, {"type": "subtitle", "time": 22064.39, "timestamp": "06:07:44", "text": "帝国之手，最不可能落入其手中。"}, {"type": "subtitle", "time": 22066.07, "timestamp": "06:07:46", "text": "极乐世界。"}, {"type": "subtitle", "time": 22073.51, "timestamp": "06:07:53", "text": "是关于另一件事。在"}, {"type": "subtitle", "time": 22076.708, "timestamp": "06:07:56", "text": "在荒岛上搜索时，我遇到了"}, {"type": "subtitle", "time": 22078.47, "timestamp": "06:07:58", "text": "就好像你在品尝一碗……"}]
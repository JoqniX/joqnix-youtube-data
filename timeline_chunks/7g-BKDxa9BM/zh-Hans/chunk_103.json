[{"type": "subtitle", "time": 6188.95, "timestamp": "01:43:08", "text": "哑的。好的。"}, {"type": "subtitle", "time": 6191.43, "timestamp": "01:43:11", "text": "你看，我能看出上面写着怀疑。"}, {"type": "subtitle", "time": 6193.17, "timestamp": "01:43:13", "text": "你的脸。"}, {"type": "subtitle", "time": 6195.59, "timestamp": "01:43:15", "text": "[音乐]"}, {"type": "subtitle", "time": 6198.47, "timestamp": "01:43:18", "text": "你可以相信我。你必须知道"}, {"type": "subtitle", "time": 6200.709, "timestamp": "01:43:20", "text": "他说：“月亮从不伤害人。”"}, {"type": "subtitle", "time": 6201.99, "timestamp": "01:43:21", "text": "我以前从没听说过。"}, {"type": "subtitle", "time": 6203.35, "timestamp": "01:43:23", "text": "拉西亚知道这一点。"}, {"type": "subtitle", "time": 6206.39, "timestamp": "01:43:26", "text": "没有。我是新来的。我是个新人。"}, {"type": "subtitle", "time": 6209.109, "timestamp": "01:43:29", "text": "确切地。"}, {"type": "subtitle", "time": 6216.87, "timestamp": "01:43:36", "text": "是的，你说得对。我们回去吧"}, {"type": "subtitle", "time": 6218.07, "timestamp": "01:43:38", "text": "然后一起。"}, {"type": "subtitle", "time": 6224.629, "timestamp": "01:43:44", "text": "好的。所以，我们解锁了一种新武器。"}, {"type": "subtitle", "time": 6231.669, "timestamp": "01:43:51", "text": "火焰普兰·佩里蒂翁武器持有者"}, {"type": "subtitle", "time": 6234.87, "timestamp": "01:43:54", "text": "枪栓式枪管。哦，你必须"}, {"type": "subtitle", "time": 6237.91, "timestamp": "01:43:57", "text": "解锁所有这些单独的物品"}]
[{"type": "subtitle", "time": 18243.51, "timestamp": "05:04:03", "text": "[音乐]"}, {"type": "subtitle", "time": 18245.67, "timestamp": "05:04:05", "text": "我会四处打听。"}, {"type": "subtitle", "time": 18250.628, "timestamp": "05:04:10", "text": "瞧，你头发上别着一朵小花。"}, {"type": "subtitle", "time": 18258.15, "timestamp": "05:04:18", "text": "精神，"}, {"type": "subtitle", "time": 18261.11, "timestamp": "05:04:21", "text": "你在这里做什么？亨里克先生"}, {"type": "subtitle", "time": 18263.11, "timestamp": "05:04:23", "text": "你知道这件事吗？请您在这儿稍等片刻"}, {"type": "subtitle", "time": 18266.948, "timestamp": "05:04:26", "text": "稍等一下，艾丽莎？我会"}, {"type": "subtitle", "time": 18270.47, "timestamp": "05:04:30", "text": "上楼和普赛克聊天。什么是"}, {"type": "subtitle", "time": 18272.708, "timestamp": "05:04:32", "text": "这？"}, {"type": "subtitle", "time": 18275.67, "timestamp": "05:04:35", "text": "你是谁？你好。"}, {"type": "subtitle", "time": 18297.83, "timestamp": "05:04:57", "text": "亨里克先生不允许外人……"}]
[{"type": "subtitle", "time": 14221.189, "timestamp": "03:57:01", "text": "然而，如果长时间待在黑暗中，"}, {"type": "subtitle", "time": 14223.59, "timestamp": "03:57:03", "text": "他们变得神秘莫测，然后变成了Equinex。"}, {"type": "subtitle", "time": 14224.79, "timestamp": "03:57:04", "text": "融入环境。"}, {"type": "subtitle", "time": 14225.429, "timestamp": "03:57:05", "text": "Equinex。"}, {"type": "subtitle", "time": 14226.95, "timestamp": "03:57:06", "text": "大多数人都不明白这是怎么回事。"}, {"type": "subtitle", "time": 14229.83, "timestamp": "03:57:09", "text": "作品。所以他们认为这是邪恶的魔法，"}, {"type": "subtitle", "time": 14232.389, "timestamp": "03:57:12", "text": "害怕他们。"}, {"type": "subtitle", "time": 14233.99, "timestamp": "03:57:13", "text": "但因为他们可以利用……的力量"}, {"type": "subtitle", "time": 14235.51, "timestamp": "03:57:15", "text": "狐狸"}, {"type": "subtitle", "time": 14237.99, "timestamp": "03:57:17", "text": "引起了索的一群人的注意"}, {"type": "subtitle", "time": 14239.51, "timestamp": "03:57:19", "text": "过去一段时间我一直在附近徘徊"}, {"type": "subtitle", "time": 14241.99, "timestamp": "03:57:21", "text": "再等几天，让他们后悔吧。"}, {"type": "subtitle", "time": 14244.55, "timestamp": "03:57:24", "text": "他们的行为。"}, {"type": "subtitle", "time": 14249.189, "timestamp": "03:57:29", "text": "哦，我明白了。他们猎杀基因，而你"}, {"type": "subtitle", "time": 14250.229, "timestamp": "03:57:30", "text": "追捕它们。"}, {"type": "subtitle", "time": 14251.269, "timestamp": "03:57:31", "text": "精灵猎人猎人。"}, {"type": "subtitle", "time": 14255.11, "timestamp": "03:57:35", "text": "你是精灵猎人吗？那是"}, {"type": "subtitle", "time": 14258.309, "timestamp": "03:57:38", "text": "有点拗口。好的。让我"}, {"type": "subtitle", "time": 14260.87, "timestamp": "03:57:40", "text": "知道你是否遇到过这些情况。为什么会这样？"}, {"type": "subtitle", "time": 14265.99, "timestamp": "03:57:45", "text": "这里还剩一个吗？它受伤了吗？"}, {"type": "subtitle", "time": 14269.03, "timestamp": "03:57:49", "text": "来，尝尝这美味的点心。"}, {"type": "subtitle", "time": 14272.389, "timestamp": "03:57:52", "text": "爱它。如果运气好，就能打开。"}, {"type": "subtitle", "time": 14274.79, "timestamp": "03:57:54", "text": "好的。"}, {"type": "subtitle", "time": 14278.63, "timestamp": "03:57:58", "text": "哦，这里有个箱子。"}]
[{"type": "subtitle", "time": 18122.07, "timestamp": "05:02:02", "text": "你在这里做什么？我不是问过吗？"}, {"type": "subtitle", "time": 18124.708, "timestamp": "05:02:04", "text": "你早上要走吗？"}, {"type": "subtitle", "time": 18127.35, "timestamp": "05:02:07", "text": "我找到了你要找的东西。这"}, {"type": "subtitle", "time": 18129.03, "timestamp": "05:02:09", "text": "Stella 的 crystalallo。"}, {"type": "subtitle", "time": 18132.628, "timestamp": "05:02:12", "text": "没人要求你来这里。"}, {"type": "subtitle", "time": 18135.51, "timestamp": "05:02:15", "text": "我不是本地人。我不熟悉"}, {"type": "subtitle", "time": 18139.11, "timestamp": "05:02:19", "text": "冰湖之道。在我来自的地方，"}, {"type": "subtitle", "time": 18141.67, "timestamp": "05:02:21", "text": "交易意味着一手现金，一手货物。"}, {"type": "subtitle", "time": 18143.67, "timestamp": "05:02:23", "text": "另一个。"}, {"type": "subtitle", "time": 18146.15, "timestamp": "05:02:26", "text": "亨里克先生，如果您不感兴趣的话，"}, {"type": "subtitle", "time": 18147.75, "timestamp": "05:02:27", "text": "我或许会再去找另一个。"}, {"type": "subtitle", "time": 18153.51, "timestamp": "05:02:33", "text": "请进。"}, {"type": "subtitle", "time": 18163.51, "timestamp": "05:02:43", "text": "等待。那么，我可以扮演主角吗？"}, {"type": "subtitle", "time": 18165.99, "timestamp": "05:02:45", "text": "特点？"}, {"type": "subtitle", "time": 18169.83, "timestamp": "05:02:49", "text": "所以我这样部署。"}]
[{"type": "subtitle", "time": 7563.589, "timestamp": "02:06:03", "text": "捕获后保持。"}, {"type": "subtitle", "time": 7565.75, "timestamp": "02:06:05", "text": "这是低估了斯诺的实力。"}, {"type": "subtitle", "time": 7569.589, "timestamp": "02:06:09", "text": "小黄人。现在你知道我们有什么了吧。"}, {"type": "subtitle", "time": 7572.39, "timestamp": "02:06:12", "text": "好的。好的。这是你的钱。"}, {"type": "subtitle", "time": 7577.03, "timestamp": "02:06:17", "text": "你饿坏了。你猜怎么着？所以，每"}, {"type": "subtitle", "time": 7579.27, "timestamp": "02:06:19", "text": "这样如何？"}, {"type": "subtitle", "time": 7581.669, "timestamp": "02:06:21", "text": "呃"}, {"type": "subtitle", "time": 7583.03, "timestamp": "02:06:23", "text": "好的。"}, {"type": "subtitle", "time": 7583.83, "timestamp": "02:06:23", "text": "他在做什么？"}, {"type": "subtitle", "time": 7589.75, "timestamp": "02:06:29", "text": "匕首被什么东西碰掉了。"}, {"type": "subtitle", "time": 7592.149, "timestamp": "02:06:32", "text": "记住，有时候一头野兽带着它的"}, {"type": "subtitle", "time": 7594.709, "timestamp": "02:06:34", "text": "腹部没有出现虚弱的迹象。"}, {"type": "subtitle", "time": 7597.83, "timestamp": "02:06:37", "text": "诱捕者交配。就像荒野一样，这座城市的"}, {"type": "subtitle", "time": 7599.03, "timestamp": "02:06:39", "text": "到处都是像这样的野兽"}, {"type": "subtitle", "time": 7602.47, "timestamp": "02:06:42", "text": "哦，卡米拉小姐"}, {"type": "subtitle", "time": 7604.39, "timestamp": "02:06:44", "text": "既然你千里迢迢来到这里，就来到冰雪世界吧。"}, {"type": "subtitle", "time": 7606.629, "timestamp": "02:06:46", "text": "湖，如果遇到你，那就太可惜了。"}, {"type": "subtitle", "time": 7607.189, "timestamp": "02:06:47", "text": "哦，"}, {"type": "subtitle", "time": 7609.589, "timestamp": "02:06:49", "text": "我以为来了个大人物。原来如此"}, {"type": "subtitle", "time": 7611.99, "timestamp": "02:06:51", "text": "那只是一家养着老母鸡的酒馆。"}, {"type": "subtitle", "time": 7619.589, "timestamp": "02:06:59", "text": "我们会按我们的方式来对待你。教你一个"}]
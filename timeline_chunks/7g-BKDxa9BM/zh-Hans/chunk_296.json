[{"type": "subtitle", "time": 17760.788, "timestamp": "04:56:00", "text": "他也是一位伟大的魔术师。所以，在我们的"}, {"type": "subtitle", "time": 17763.51, "timestamp": "04:56:03", "text": "客人的眼神，以及与她有关的一切。"}, {"type": "subtitle", "time": 17765.75, "timestamp": "04:56:05", "text": "太棒了。甚至"}, {"type": "subtitle", "time": 17768.07, "timestamp": "04:56:08", "text": "好吧，菲努斯说什么就是什么。"}, {"type": "subtitle", "time": 17768.708, "timestamp": "04:56:08", "text": "我们知道。"}, {"type": "subtitle", "time": 17769.19, "timestamp": "04:56:09", "text": "所以"}, {"type": "subtitle", "time": 17771.75, "timestamp": "04:56:11", "text": "我们走散了，彼此失去了联系。"}, {"type": "subtitle", "time": 17776.708, "timestamp": "04:56:16", "text": "昨天，或者更早以前。我不是"}, {"type": "subtitle", "time": 17779.91, "timestamp": "04:56:19", "text": "那么你必须找到她，因为家人"}, {"type": "subtitle", "time": 17783.43, "timestamp": "04:56:23", "text": "就像花草树木、雪和风一样。"}, {"type": "subtitle", "time": 17788.23, "timestamp": "04:56:28", "text": "是的，我真是个局外人。我需要钱"}, {"type": "subtitle", "time": 17791.03, "timestamp": "04:56:31", "text": "住宿、信息收集、"}, {"type": "subtitle", "time": 17793.51, "timestamp": "04:56:33", "text": "还预留了一些以备不时之需"}, {"type": "subtitle", "time": 17795.19, "timestamp": "04:56:35", "text": "立即出发"}, {"type": "subtitle", "time": 17797.43, "timestamp": "04:56:37", "text": "菲娜，该睡觉了。"}, {"type": "subtitle", "time": 17798.39, "timestamp": "04:56:38", "text": "我还有其他"}, {"type": "subtitle", "time": 17800.868, "timestamp": "04:56:40", "text": "好的，晚安。晚安。"}, {"type": "subtitle", "time": 17802.788, "timestamp": "04:56:42", "text": "我喜欢她蓝色的头发。看看"}, {"type": "subtitle", "time": 17807.19, "timestamp": "04:56:47", "text": "她头发上的饰品。太可爱了。"}, {"type": "subtitle", "time": 17815.19, "timestamp": "04:56:55", "text": "有什么可以偷的吗？我可以睡在"}, {"type": "subtitle", "time": 17819.99, "timestamp": "04:56:59", "text": "床？不。你好，菲娜。"}]
[{"type": "subtitle", "time": 17702.55, "timestamp": "04:55:02", "text": "有一次，那个渔夫不知怎么地得到了他的"}, {"type": "subtitle", "time": 17705.19, "timestamp": "04:55:05", "text": "亲手拿到一些帝国物资，"}, {"type": "subtitle", "time": 17708.55, "timestamp": "04:55:08", "text": "包括两罐糖，还有她"}, {"type": "subtitle", "time": 17711.67, "timestamp": "04:55:11", "text": "用半个月的工资换了一个"}, {"type": "subtitle", "time": 17713.51, "timestamp": "04:55:13", "text": "小罐子。"}, {"type": "subtitle", "time": 17714.47, "timestamp": "04:55:14", "text": "哦。"}, {"type": "subtitle", "time": 17716.788, "timestamp": "04:55:16", "text": "这是她第一次拿到"}, {"type": "subtitle", "time": 17719.11, "timestamp": "04:55:19", "text": "她什么糖都吃不下，也不知道该怎么做。"}, {"type": "subtitle", "time": 17720.39, "timestamp": "04:55:20", "text": "用它。"}, {"type": "subtitle", "time": 17722.15, "timestamp": "04:55:22", "text": "仅仅知道那是一件某事就够了。"}, {"type": "subtitle", "time": 17725.67, "timestamp": "04:55:25", "text": "她把它倒了进去，它既珍贵又美味。"}, {"type": "subtitle", "time": 17733.19, "timestamp": "04:55:33", "text": "等我们长大成人，开始……"}, {"type": "subtitle", "time": 17736.15, "timestamp": "04:55:36", "text": "收入增加后，糖就不再是奢侈品了。"}, {"type": "subtitle", "time": 17736.948, "timestamp": "04:55:36", "text": "不再是了。"}, {"type": "subtitle", "time": 17740.47, "timestamp": "04:55:40", "text": "天哪，听起来太可怕了。"}, {"type": "subtitle", "time": 17744.07, "timestamp": "04:55:44", "text": "我仿佛都能闻到那种甜腻的味道了。"}, {"type": "subtitle", "time": 17744.788, "timestamp": "04:55:44", "text": "我的天啊。"}, {"type": "subtitle", "time": 17746.15, "timestamp": "04:55:46", "text": "她欠你一个道歉。"}, {"type": "subtitle", "time": 17747.59, "timestamp": "04:55:47", "text": "你怎么能闻到它的味道？"}, {"type": "subtitle", "time": 17749.59, "timestamp": "04:55:49", "text": "她欠了糖和第五份钱。"}, {"type": "subtitle", "time": 17751.75, "timestamp": "04:55:51", "text": "道歉。"}, {"type": "subtitle", "time": 17754.628, "timestamp": "04:55:54", "text": "不是外人，你缺席了。我相信"}, {"type": "subtitle", "time": 17757.27, "timestamp": "04:55:57", "text": "那位总是用很多糖的女士"}]
[{"type": "subtitle", "time": 18480.07, "timestamp": "05:08:00", "text": "你是谁？我以前没见过你。"}, {"type": "subtitle", "time": 18484.47, "timestamp": "05:08:04", "text": "哦，你？不，我不是。我不知道。"}, {"type": "subtitle", "time": 18486.948, "timestamp": "05:08:06", "text": "我什么都不知道。请远离"}, {"type": "subtitle", "time": 18487.83, "timestamp": "05:08:07", "text": "来自我。"}, {"type": "subtitle", "time": 18491.03, "timestamp": "05:08:11", "text": "局外人说得对。寻找失踪的狐狸"}, {"type": "subtitle", "time": 18494.39, "timestamp": "05:08:14", "text": "以前有个猎人住在这里。"}, {"type": "subtitle", "time": 18494.628, "timestamp": "05:08:14", "text": "哦，"}, {"type": "subtitle", "time": 18503.91, "timestamp": "05:08:23", "text": "我能爬上床面这件事本身就是"}, {"type": "subtitle", "time": 18511.99, "timestamp": "05:08:31", "text": "您好，欢迎回来。"}, {"type": "subtitle", "time": 18515.03, "timestamp": "05:08:35", "text": "我已经查过了。水晶就在这里"}, {"type": "subtitle", "time": 18519.19, "timestamp": "05:08:39", "text": "去。 3000枚银币和这个标志"}, {"type": "subtitle", "time": 18520.788, "timestamp": "05:08:40", "text": "这"}, {"type": "subtitle", "time": 18521.35, "timestamp": "05:08:41", "text": "脖子。"}, {"type": "subtitle", "time": 18524.15, "timestamp": "05:08:44", "text": "好了，交易完成了。以及关于"}, {"type": "subtitle", "time": 18530.948, "timestamp": "05:08:50", "text": "他难道不让我留下来吗？"}, {"type": "subtitle", "time": 18533.99, "timestamp": "05:08:53", "text": "房子？那是我的工作室和店铺。"}, {"type": "subtitle", "time": 18537.11, "timestamp": "05:08:57", "text": "我的床和所有东西都是"}, {"type": "subtitle", "time": 18539.35, "timestamp": "05:08:59", "text": "我进不去办公室。我已经"}]
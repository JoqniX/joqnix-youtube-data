[{"type": "subtitle", "time": 1928.95, "timestamp": "00:32:08", "text": "我们已经寻找多年了。什么时候"}, {"type": "subtitle", "time": 1930.63, "timestamp": "00:32:10", "text": "酋长会放弃这种毫无意义的做法吗？"}, {"type": "subtitle", "time": 1931.909, "timestamp": "00:32:11", "text": "打猎？"}, {"type": "subtitle", "time": 1934.87, "timestamp": "00:32:14", "text": "谁在那儿？放下武器。你是"}, {"type": "subtitle", "time": 1937.11, "timestamp": "00:32:17", "text": "被第十三军团包围。"}, {"type": "subtitle", "time": 1940.47, "timestamp": "00:32:20", "text": "怎么会是这样呢？"}, {"type": "subtitle", "time": 1943.909, "timestamp": "00:32:23", "text": "巴里，发生什么事了？"}, {"type": "subtitle", "time": 1947.509, "timestamp": "00:32:27", "text": "军团。他们找到了来这里的路。"}, {"type": "subtitle", "time": 1950.95, "timestamp": "00:32:30", "text": "总之，他们得先越狱。"}]
[{"type": "subtitle", "time": 2468.71, "timestamp": "00:41:08", "text": "猫咪终极技能镜焰"}, {"type": "subtitle", "time": 2472.069, "timestamp": "00:41:12", "text": "受共鸣力量的启发。非常"}, {"type": "subtitle", "time": 2474.39, "timestamp": "00:41:14", "text": "终极技能已觉醒。"}, {"type": "subtitle", "time": 2476.87, "timestamp": "00:41:16", "text": "迫害和释放。好的。结束"}, {"type": "subtitle", "time": 2478.71, "timestamp": "00:41:18", "text": "极致肌肤。好的，"}, {"type": "subtitle", "time": 2482.15, "timestamp": "00:41:22", "text": "那个数字不应该是"}, {"type": "subtitle", "time": 2490.63, "timestamp": "00:41:30", "text": "那不是她的能力。这是共鸣。"}, {"type": "subtitle", "time": 2493.589, "timestamp": "00:41:33", "text": "她想保护的那个小鬼。"}, {"type": "subtitle", "time": 2495.91, "timestamp": "00:41:35", "text": "那是新的电源插座"}, {"type": "subtitle", "time": 2499.27, "timestamp": "00:41:39", "text": "共振。仔细想想，她"}, {"type": "subtitle", "time": 2502.87, "timestamp": "00:41:42", "text": "面孔是力量的重现。"}, {"type": "subtitle", "time": 2505.51, "timestamp": "00:41:45", "text": "共振。和"}]
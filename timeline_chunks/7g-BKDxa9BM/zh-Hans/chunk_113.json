[{"type": "subtitle", "time": 6780.709, "timestamp": "01:53:00", "text": "不，"}, {"type": "subtitle", "time": 6786.79, "timestamp": "01:53:06", "text": "你这小家伙在看什么呢？"}, {"type": "subtitle", "time": 6789.35, "timestamp": "01:53:09", "text": "蠢货？"}, {"type": "subtitle", "time": 6791.75, "timestamp": "01:53:11", "text": "你对我来说没麻烦了。"}, {"type": "subtitle", "time": 6798.629, "timestamp": "01:53:18", "text": "父亲。"}, {"type": "subtitle", "time": 6819.589, "timestamp": "01:53:39", "text": "他们杀了"}, {"type": "subtitle", "time": 6823.27, "timestamp": "01:53:43", "text": "我们走吧。"}, {"type": "subtitle", "time": 6824.229, "timestamp": "01:53:44", "text": "什么？"}, {"type": "subtitle", "time": 6825.83, "timestamp": "01:53:45", "text": "有一件重要的事情你应该……"}, {"type": "subtitle", "time": 6826.95, "timestamp": "01:53:46", "text": "知道。"}, {"type": "subtitle", "time": 6830.87, "timestamp": "01:53:50", "text": "如果你来自远方，请记住"}, {"type": "subtitle", "time": 6832.39, "timestamp": "01:53:52", "text": "如果萨拉瑞人呢？"}, {"type": "subtitle", "time": 6833.27, "timestamp": "01:53:53", "text": "工薪阶层？"}, {"type": "subtitle", "time": 6836.07, "timestamp": "01:53:56", "text": "你是说那些没有角的吗？"}]
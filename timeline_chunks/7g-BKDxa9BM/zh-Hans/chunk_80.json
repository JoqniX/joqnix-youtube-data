[{"type": "subtitle", "time": 4801.11, "timestamp": "01:20:01", "text": "今天就到此为止吧。我出去了。所以，"}, {"type": "subtitle", "time": 4802.95, "timestamp": "01:20:02", "text": "尽量靠自己的力量生存下去，如果做不到的话。"}, {"type": "subtitle", "time": 4805.189, "timestamp": "01:20:05", "text": "即使那样做，也永远不要再那样做了。"}, {"type": "subtitle", "time": 4807.51, "timestamp": "01:20:07", "text": "别提任何关于对抗的疯狂言论"}, {"type": "subtitle", "time": 4810.47, "timestamp": "01:20:10", "text": "使用 Cibil 找回你的东西。"}, {"type": "subtitle", "time": 4811.83, "timestamp": "01:20:11", "text": "看，"}, {"type": "subtitle", "time": 4813.43, "timestamp": "01:20:13", "text": "北部有一家名为……的旅馆"}, {"type": "subtitle", "time": 4815.91, "timestamp": "01:20:15", "text": "或许会收留某人的Hypnos House"}, {"type": "subtitle", "time": 4819.43, "timestamp": "01:20:19", "text": "和你一样，有着扑朔迷离的背景故事。"}, {"type": "subtitle", "time": 4822.31, "timestamp": "01:20:22", "text": "你是说那座阴森恐怖的鬼屋吗？"}, {"type": "subtitle", "time": 4823.51, "timestamp": "01:20:23", "text": "鬼屋？"}, {"type": "subtitle", "time": 4825.51, "timestamp": "01:20:25", "text": "还有哪里能买到汽车呢？"}, {"type": "subtitle", "time": 4827.99, "timestamp": "01:20:27", "text": "旅行许可证？但这样一个地方"}, {"type": "subtitle", "time": 4830.39, "timestamp": "01:20:30", "text": "令人毛骨悚然，就连士兵们都不愿如此。"}, {"type": "subtitle", "time": 4831.59, "timestamp": "01:20:31", "text": "搜索。"}, {"type": "subtitle", "time": 4833.03, "timestamp": "01:20:33", "text": "我明白。"}, {"type": "subtitle", "time": 4835.03, "timestamp": "01:20:35", "text": "嗯，"}, {"type": "subtitle", "time": 4837.27, "timestamp": "01:20:37", "text": "好的。看到你这么孤独，"}, {"type": "subtitle", "time": 4856.55, "timestamp": "01:20:56", "text": "好的。查看条目。"}, {"type": "subtitle", "time": 4859.51, "timestamp": "01:20:59", "text": "你说的“闹鬼”到底是什么意思？"}]
[{"type": "subtitle", "time": 5165.11, "timestamp": "01:26:05", "text": "我，亨里克。"}, {"type": "subtitle", "time": 5168.149, "timestamp": "01:26:08", "text": "那就按你的方式来吧。"}, {"type": "subtitle", "time": 5170.87, "timestamp": "01:26:10", "text": "但仅仅一晚而已，"}, {"type": "subtitle", "time": 5171.83, "timestamp": "01:26:11", "text": "早晨，"}, {"type": "subtitle", "time": 5174.95, "timestamp": "01:26:14", "text": "你必须去你该去的地方。"}, {"type": "subtitle", "time": 5193.27, "timestamp": "01:26:33", "text": "哦，我只能跳。禁止攀爬"}, {"type": "subtitle", "time": 5196.28, "timestamp": "01:26:36", "text": "在这场游戏中，是吗？"}, {"type": "subtitle", "time": 5208.55, "timestamp": "01:26:48", "text": "真糟糕。"}, {"type": "subtitle", "time": 5217.83, "timestamp": "01:26:57", "text": "我们是。"}]
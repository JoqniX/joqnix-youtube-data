[{"type": "subtitle", "time": 6469.109, "timestamp": "01:47:49", "text": "你真是太棒了。"}, {"type": "subtitle", "time": 6472.55, "timestamp": "01:47:52", "text": "我超喜欢这张原声带。诚实地，"}, {"type": "subtitle", "time": 6475.27, "timestamp": "01:47:55", "text": "我见过很多像你这样的人，"}, {"type": "subtitle", "time": 6478.229, "timestamp": "01:47:58", "text": "雪。它们都是你来自哪里吗？"}, {"type": "subtitle", "time": 6478.79, "timestamp": "01:47:58", "text": "偏僻的？"}]
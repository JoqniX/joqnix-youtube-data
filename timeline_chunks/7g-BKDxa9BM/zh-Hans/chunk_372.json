[{"type": "subtitle", "time": 22321.83, "timestamp": "06:12:01", "text": "好的。"}, {"type": "subtitle", "time": 22322.868, "timestamp": "06:12:02", "text": "这是什么？"}, {"type": "subtitle", "time": 22324.628, "timestamp": "06:12:04", "text": "我从……捡到的一块废金属"}, {"type": "subtitle", "time": 22327.99, "timestamp": "06:12:07", "text": "拾荒女孩。"}, {"type": "subtitle", "time": 22334.868, "timestamp": "06:12:14", "text": "放逐效果。哦，真好，真好，真好。"}, {"type": "subtitle", "time": 22337.67, "timestamp": "06:12:17", "text": "不错，不错。我们抓到他了。哦，不错。"}, {"type": "subtitle", "time": 22349.51, "timestamp": "06:12:29", "text": "这就是他的武器。哦，"}, {"type": "subtitle", "time": 22352.15, "timestamp": "06:12:32", "text": "你是要约我出去吗？"}, {"type": "subtitle", "time": 22355.03, "timestamp": "06:12:35", "text": "这真是相当"}, {"type": "subtitle", "time": 22357.43, "timestamp": "06:12:37", "text": "我们彼此已经很了解了。"}, {"type": "subtitle", "time": 22360.39, "timestamp": "06:12:40", "text": "我真的需要自我介绍一下。"}, {"type": "subtitle", "time": 22364.23, "timestamp": "06:12:44", "text": "局外人，陌生人。"}, {"type": "subtitle", "time": 22366.708, "timestamp": "06:12:46", "text": "该死。"}, {"type": "subtitle", "time": 22371.11, "timestamp": "06:12:51", "text": "我将尽我所能提供微薄的帮助。"}]
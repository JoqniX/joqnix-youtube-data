[{"type": "subtitle", "time": 18362.07, "timestamp": "05:06:02", "text": "隐瞒某些事情。亨里克先生应该"}, {"type": "subtitle", "time": 18363.59, "timestamp": "05:06:03", "text": "随时可能出去。你要离开了"}, {"type": "subtitle", "time": 18367.19, "timestamp": "05:06:07", "text": "已经。给你，拿着这些，还有这个。"}, {"type": "subtitle", "time": 18369.51, "timestamp": "05:06:09", "text": "妈妈总是说，带着一朵花"}, {"type": "subtitle", "time": 18371.91, "timestamp": "05:06:11", "text": "现在是收集情报的好时机"}, {"type": "subtitle", "time": 18373.51, "timestamp": "05:06:13", "text": "楼下。"}, {"type": "subtitle", "time": 18383.03, "timestamp": "05:06:23", "text": "我会把这些书收集起来。我觉得我"}, {"type": "subtitle", "time": 18386.23, "timestamp": "05:06:26", "text": "不会再在这里了。所以，"}, {"type": "subtitle", "time": 18388.23, "timestamp": "05:06:28", "text": "凡是我能收集到的，我都会收集。"}, {"type": "subtitle", "time": 18394.39, "timestamp": "05:06:34", "text": "因为我有完美主义倾向。所以，我会"}, {"type": "subtitle", "time": 18396.628, "timestamp": "05:06:36", "text": "获得所有成就"}, {"type": "subtitle", "time": 18414.868, "timestamp": "05:06:54", "text": "H"}, {"type": "subtitle", "time": 18417.83, "timestamp": "05:06:57", "text": "别碰那扇门。办公室关门了"}]
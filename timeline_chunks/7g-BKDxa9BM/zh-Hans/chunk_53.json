[{"type": "subtitle", "time": 3180.549, "timestamp": "00:53:00", "text": "我完全没必要着急。"}, {"type": "subtitle", "time": 3183.589, "timestamp": "00:53:03", "text": "这是一款农场经营游戏。我受不了了"}, {"type": "subtitle", "time": 3194.15, "timestamp": "00:53:14", "text": "写书会很困难，我"}, {"type": "subtitle", "time": 3206.23, "timestamp": "00:53:26", "text": "[音乐]"}, {"type": "subtitle", "time": 3209.51, "timestamp": "00:53:29", "text": "有些技能会触发FS，但具体情况还要看情况。"}, {"type": "subtitle", "time": 3211.349, "timestamp": "00:53:31", "text": "呃"}, {"type": "subtitle", "time": 3216.549, "timestamp": "00:53:36", "text": "释放技能。"}, {"type": "subtitle", "time": 3219.51, "timestamp": "00:53:39", "text": "你身上好像到处都是淤青和伤口。是"}, {"type": "subtitle", "time": 3224.47, "timestamp": "00:53:44", "text": "损害。"}, {"type": "subtitle", "time": 3226.39, "timestamp": "00:53:46", "text": "我很好。"}, {"type": "subtitle", "time": 3228.309, "timestamp": "00:53:48", "text": "疼痛已经消失了。"}, {"type": "subtitle", "time": 3230.23, "timestamp": "00:53:50", "text": "一定发生了什么非常糟糕的事情。"}, {"type": "subtitle", "time": 3234.71, "timestamp": "00:53:54", "text": "给你。不过别担心。你在我的掌控之下"}, {"type": "subtitle", "time": 3238.23, "timestamp": "00:53:58", "text": "现在起飞。雪会保护你。后"}]
[{"type": "subtitle", "time": 5220.39, "timestamp": "01:27:00", "text": "避难所。"}, {"type": "subtitle", "time": 5223.03, "timestamp": "01:27:03", "text": "哦，这是我们的主要枢纽。哦，"}, {"type": "subtitle", "time": 5225.91, "timestamp": "01:27:05", "text": "这个房间刚刚打扫干净了。你"}, {"type": "subtitle", "time": 5229.11, "timestamp": "01:27:09", "text": "今晚可以留宿。"}, {"type": "subtitle", "time": 5231.75, "timestamp": "01:27:11", "text": "凉爽的。"}, {"type": "subtitle", "time": 5233.669, "timestamp": "01:27:13", "text": "别生气。"}, {"type": "subtitle", "time": 5237.11, "timestamp": "01:27:17", "text": "亨里克先生其实并没有那么贪婪。"}, {"type": "subtitle", "time": 5239.189, "timestamp": "01:27:19", "text": "只是我们一直资金比较紧张。"}, {"type": "subtitle", "time": 5241.83, "timestamp": "01:27:21", "text": "最近现金流不错。否则，他就不会这么做。"}, {"type": "subtitle", "time": 5243.669, "timestamp": "01:27:23", "text": "考虑卖掉他的旧房子来赚钱"}, {"type": "subtitle", "time": 5245.99, "timestamp": "01:27:25", "text": "收支平衡。"}, {"type": "subtitle", "time": 5246.31, "timestamp": "01:27:26", "text": "哦，"}, {"type": "subtitle", "time": 5249.03, "timestamp": "01:27:29", "text": "它已被忽视多年。但之后"}, {"type": "subtitle", "time": 5253.11, "timestamp": "01:27:33", "text": "好好打扫一下，效果还不错，对吧？"}, {"type": "subtitle", "time": 5256.229, "timestamp": "01:27:36", "text": "至少它能挡寒气。"}, {"type": "subtitle", "time": 5257.35, "timestamp": "01:27:37", "text": "哦，"}, {"type": "subtitle", "time": 5260.31, "timestamp": "01:27:40", "text": "我还没自我介绍呢。"}, {"type": "subtitle", "time": 5261.59, "timestamp": "01:27:41", "text": "我是Psyche。"}, {"type": "subtitle", "time": 5262.07, "timestamp": "01:27:42", "text": "精神，"}, {"type": "subtitle", "time": 5265.03, "timestamp": "01:27:45", "text": "许普诺斯旅馆的房客，以及"}, {"type": "subtitle", "time": 5267.83, "timestamp": "01:27:47", "text": "有时我会帮亨里克先生的忙。"}, {"type": "subtitle", "time": 5269.83, "timestamp": "01:27:49", "text": "哦，"}, {"type": "subtitle", "time": 5270.39, "timestamp": "01:27:50", "text": "我是在开玩笑。"}, {"type": "subtitle", "time": 5274.149, "timestamp": "01:27:54", "text": "在这个城市里，这个名字相当少见。"}, {"type": "subtitle", "time": 5278.229, "timestamp": "01:27:58", "text": "亨里克先生提到你不是本地人。"}]
[{"type": "subtitle", "time": 4561.99, "timestamp": "01:16:01", "text": "棘轮，是你吗？你说了多少钱？"}, {"type": "subtitle", "time": 4564.95, "timestamp": "01:16:04", "text": "再次？嗯"}, {"type": "subtitle", "time": 4569.59, "timestamp": "01:16:09", "text": "SCA 服务器的延迟似乎在 70 到 90 毫秒之间"}, {"type": "subtitle", "time": 4574.709, "timestamp": "01:16:14", "text": "亚洲地区的延迟大概在90到120毫秒之间，而他……"}, {"type": "subtitle", "time": 4579.59, "timestamp": "01:16:19", "text": "他们也来自印度。所以"}, {"type": "subtitle", "time": 4582.95, "timestamp": "01:16:22", "text": "是啊，什么时候？"}, {"type": "subtitle", "time": 4587.59, "timestamp": "01:16:27", "text": "我何时才能解锁合作半径？"}, {"type": "subtitle", "time": 4598.07, "timestamp": "01:16:38", "text": "好，我们继续玩吧。"}, {"type": "subtitle", "time": 4599.59, "timestamp": "01:16:39", "text": "解锁合作者并检查"}, {"type": "subtitle", "time": 4602.95, "timestamp": "01:16:42", "text": "稍后再回复。好的，"}, {"type": "subtitle", "time": 4604.31, "timestamp": "01:16:44", "text": "这是我唯一能做的。"}, {"type": "subtitle", "time": 4615.35, "timestamp": "01:16:55", "text": "我觉得你平时是个很诚实的孩子。"}, {"type": "subtitle", "time": 4618.31, "timestamp": "01:16:58", "text": "70名韩国人。所以需要时间"}]
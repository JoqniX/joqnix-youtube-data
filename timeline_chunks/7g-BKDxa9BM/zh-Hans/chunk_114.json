[{"type": "subtitle", "time": 6840.87, "timestamp": "01:54:00", "text": "难道我们就是“是”吗？"}, {"type": "subtitle", "time": 6843.43, "timestamp": "01:54:03", "text": "这里是海伯瑞亚吗？"}, {"type": "subtitle", "time": 6848.149, "timestamp": "01:54:08", "text": "我们是卡伦人，但我们独特的外貌"}, {"type": "subtitle", "time": 6851.51, "timestamp": "01:54:11", "text": "与太阳神不同。"}, {"type": "subtitle", "time": 6855.91, "timestamp": "01:54:15", "text": "他们甚至称我们为魔鬼的孩子。"}, {"type": "subtitle", "time": 6857.43, "timestamp": "01:54:17", "text": "哦，"}, {"type": "subtitle", "time": 6860.47, "timestamp": "01:54:20", "text": "说到这里，每当那些人类"}, {"type": "subtitle", "time": 6862.87, "timestamp": "01:54:22", "text": "谈论诸如恶魔、孩子之类的事情，"}, {"type": "subtitle", "time": 6865.91, "timestamp": "01:54:25", "text": "还有魔法，它们总是带来如此肮脏的东西"}, {"type": "subtitle", "time": 6872.31, "timestamp": "01:54:32", "text": "谢谢你，斯诺。但事实依然如此，"}, {"type": "subtitle", "time": 6875.75, "timestamp": "01:54:35", "text": "我们在这里不受欢迎。那个士兵回来了"}, {"type": "subtitle", "time": 6878.95, "timestamp": "01:54:38", "text": "那里。即使犯下这样的罪行"}, {"type": "subtitle", "time": 6881.589, "timestamp": "01:54:41", "text": "残忍的行为，这是我们见过的唯一一起。"}, {"type": "subtitle", "time": 6884.229, "timestamp": "01:54:44", "text": "意外错误很多。他们只是"}, {"type": "subtitle", "time": 6887.109, "timestamp": "01:54:47", "text": "就像卡昂斯的存在一样平常"}, {"type": "subtitle", "time": 6889.109, "timestamp": "01:54:49", "text": "不允许进入市中心"}, {"type": "subtitle", "time": 6892.149, "timestamp": "01:54:52", "text": "冰湖。"}, {"type": "subtitle", "time": 6894.47, "timestamp": "01:54:54", "text": "为什么会这样？这"}, {"type": "subtitle", "time": 6896.47, "timestamp": "01:54:56", "text": "Hyperoreia 的 solers。"}, {"type": "subtitle", "time": 6898.39, "timestamp": "01:54:58", "text": "魔法是邪恶的巫师"}]
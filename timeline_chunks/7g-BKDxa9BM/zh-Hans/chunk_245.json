[{"type": "subtitle", "time": 14701.59, "timestamp": "04:05:01", "text": "我好像听到目标在哭泣"}, {"type": "subtitle", "time": 14705.189, "timestamp": "04:05:05", "text": "帮助。就是那边那个牢房。它是"}, {"type": "subtitle", "time": 14708.389, "timestamp": "04:05:08", "text": "那边那个牢房。赶快。"}, {"type": "subtitle", "time": 14723.429, "timestamp": "04:05:23", "text": "不。"}, {"type": "subtitle", "time": 14726.07, "timestamp": "04:05:26", "text": "失败令人痛苦。"}, {"type": "subtitle", "time": 14730.15, "timestamp": "04:05:30", "text": "希望能得到你的一点安慰。"}, {"type": "subtitle", "time": 14731.51, "timestamp": "04:05:31", "text": "这很难。"}, {"type": "subtitle", "time": 14733.429, "timestamp": "04:05:33", "text": "我先来。"}, {"type": "subtitle", "time": 14734.95, "timestamp": "04:05:34", "text": "等等，这其实很难。"}]
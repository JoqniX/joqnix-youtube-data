[{"type": "subtitle", "time": 19156.39, "timestamp": "05:19:16", "text": "好的，我们继续走。"}, {"type": "subtitle", "time": 19185.19, "timestamp": "05:19:45", "text": "快点，我们去找个炼药台。哦"}, {"type": "subtitle", "time": 19187.43, "timestamp": "05:19:47", "text": "是的。为了让车站收集"}, {"type": "subtitle", "time": 19189.59, "timestamp": "05:19:49", "text": "血清，我们必须击败附近的敌人"}, {"type": "subtitle", "time": 19192.47, "timestamp": "05:19:52", "text": "它。把药剂台装满。不，不"}, {"type": "subtitle", "time": 19195.27, "timestamp": "05:19:55", "text": "不。如果敌人被击败得太远"}, {"type": "subtitle", "time": 19197.83, "timestamp": "05:19:57", "text": "药剂站，他们的血清不会是"}]
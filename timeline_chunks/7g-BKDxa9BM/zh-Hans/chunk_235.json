[{"type": "subtitle", "time": 14102.79, "timestamp": "03:55:02", "text": "闪光。我们应该追赶他们吗？"}, {"type": "subtitle", "time": 14106.07, "timestamp": "03:55:06", "text": "没有。他们拔腿就跑，好像他们知道一切。"}, {"type": "subtitle", "time": 14107.99, "timestamp": "03:55:07", "text": "这里是捷径。"}, {"type": "subtitle", "time": 14110.71, "timestamp": "03:55:10", "text": "我们根本不可能赶上。"}, {"type": "subtitle", "time": 14115.189, "timestamp": "03:55:15", "text": "此外，我们还是忘了我们来这里的目的吧。"}, {"type": "subtitle", "time": 14118.55, "timestamp": "03:55:18", "text": "所以，这就是那头更高的巨型猪"}, {"type": "subtitle", "time": 14121.349, "timestamp": "03:55:21", "text": "比我大，脑袋也跟……一样大"}, {"type": "subtitle", "time": 14122.469, "timestamp": "03:55:22", "text": "货车。"}, {"type": "subtitle", "time": 14125.59, "timestamp": "03:55:25", "text": "你被夸张的言辞蒙蔽了。"}, {"type": "subtitle", "time": 14128.63, "timestamp": "03:55:28", "text": "好吧。或许并不完全如此"}, {"type": "subtitle", "time": 14130.71, "timestamp": "03:55:30", "text": "正如我所说，它很大，但仍然相当……"}, {"type": "subtitle", "time": 14134.469, "timestamp": "03:55:34", "text": "大的。别忘了它还会说话。"}, {"type": "subtitle", "time": 14135.67, "timestamp": "03:55:35", "text": "是的，它会说话。"}, {"type": "subtitle", "time": 14143.67, "timestamp": "03:55:43", "text": "但看起来好像并非如此"}, {"type": "subtitle", "time": 14145.91, "timestamp": "03:55:45", "text": "会谈。"}, {"type": "subtitle", "time": 14149.189, "timestamp": "03:55:49", "text": "那是我。"}, {"type": "subtitle", "time": 14149.83, "timestamp": "03:55:49", "text": "你好。"}, {"type": "subtitle", "time": 14155.03, "timestamp": "03:55:55", "text": "这看起来像是……谎言"}, {"type": "subtitle", "time": 14155.83, "timestamp": "03:55:55", "text": "但尺寸更小。"}, {"type": "subtitle", "time": 14158.71, "timestamp": "03:55:58", "text": "是我最好的朋友，也是我最信任的人。"}]
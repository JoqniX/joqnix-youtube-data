[{"type": "subtitle", "time": 1322.95, "timestamp": "00:22:02", "text": "看来我们只能指望那东西了。"}, {"type": "subtitle", "time": 1325.27, "timestamp": "00:22:05", "text": "听着，其实还有另一个。"}, {"type": "subtitle", "time": 1327.669, "timestamp": "00:22:07", "text": "你好，弗兰科。欢迎来到直播间"}, {"type": "subtitle", "time": 1330.549, "timestamp": "00:22:10", "text": "在山顶的废墟里。"}, {"type": "subtitle", "time": 1333.51, "timestamp": "00:22:13", "text": "山上的船。"}, {"type": "subtitle", "time": 1335.029, "timestamp": "00:22:15", "text": "欢迎。欢迎光临。"}, {"type": "subtitle", "time": 1340.23, "timestamp": "00:22:20", "text": "是的，一艘会飞的船。现在跟我来。"}, {"type": "subtitle", "time": 1343.35, "timestamp": "00:22:23", "text": "一艘会飞的船。"}, {"type": "subtitle", "time": 1345.11, "timestamp": "00:22:25", "text": "远程武器是击败敌人的理想选择"}, {"type": "subtitle", "time": 1347.35, "timestamp": "00:22:27", "text": "电梯位置上的敌人。不是"}, {"type": "subtitle", "time": 1351.83, "timestamp": "00:22:31", "text": "这限制了他们弹匣的弹药量。"}, {"type": "subtitle", "time": 1354.23, "timestamp": "00:22:34", "text": "有机会获得弹药补给"}, {"type": "subtitle", "time": 1355.909, "timestamp": "00:22:35", "text": "通过击败敌人、打开宝箱，"}, {"type": "subtitle", "time": 1357.909, "timestamp": "00:22:37", "text": "销毁可恢复对象"}, {"type": "subtitle", "time": 1362.23, "timestamp": "00:22:42", "text": "可用于补充武器弹药。好的，"}, {"type": "subtitle", "time": 1365.75, "timestamp": "00:22:45", "text": "巨蟹座要来了。"}, {"type": "subtitle", "time": 1368.31, "timestamp": "00:22:48", "text": "保持距离。如有必要，分发"}, {"type": "subtitle", "time": 1370.87, "timestamp": "00:22:50", "text": "秘密信号。我们之前编造的。"}, {"type": "subtitle", "time": 1374.71, "timestamp": "00:22:54", "text": "以免引起上级警觉。"}]
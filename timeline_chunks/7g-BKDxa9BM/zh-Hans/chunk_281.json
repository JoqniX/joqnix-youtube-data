[{"type": "subtitle", "time": 16867.19, "timestamp": "04:41:07", "text": "没有“先到先得”这回事。"}, {"type": "subtitle", "time": 16867.99, "timestamp": "04:41:07", "text": "有。和"}, {"type": "subtitle", "time": 16871.43, "timestamp": "04:41:11", "text": "你是新来的吧？有人"}, {"type": "subtitle", "time": 16873.11, "timestamp": "04:41:13", "text": "给你上这一课。而那"}, {"type": "subtitle", "time": 16875.67, "timestamp": "04:41:15", "text": "今天碰巧轮到我了。"}, {"type": "subtitle", "time": 16877.67, "timestamp": "04:41:17", "text": "请把这块水晶当作学费。"}, {"type": "subtitle", "time": 16878.15, "timestamp": "04:41:18", "text": "我们？"}, {"type": "subtitle", "time": 16879.59, "timestamp": "04:41:19", "text": "学费。"}, {"type": "subtitle", "time": 16881.51, "timestamp": "04:41:21", "text": "请还给我。"}, {"type": "subtitle", "time": 16884.39, "timestamp": "04:41:24", "text": "那块水晶对她来说很重要，而且"}, {"type": "subtitle", "time": 16889.43, "timestamp": "04:41:29", "text": "道德。"}, {"type": "subtitle", "time": 16891.35, "timestamp": "04:41:31", "text": "既然你拒绝讲道理"}, {"type": "subtitle", "time": 16895.11, "timestamp": "04:41:35", "text": "先生，谈话到此结束。"}, {"type": "subtitle", "time": 16896.708, "timestamp": "04:41:36", "text": "是的。"}, {"type": "subtitle", "time": 16899.99, "timestamp": "04:41:39", "text": "别紧张，孩子。别生气。"}, {"type": "subtitle", "time": 16902.55, "timestamp": "04:41:42", "text": "这才对嘛。快点。哇，冷静"}, {"type": "subtitle", "time": 16904.15, "timestamp": "04:41:44", "text": "向下。无需诉诸寻找"}, {"type": "subtitle", "time": 16905.91, "timestamp": "04:41:45", "text": "5050. 无处可去。"}, {"type": "subtitle", "time": 16907.27, "timestamp": "04:41:47", "text": "有点发烧。"}, {"type": "subtitle", "time": 16908.47, "timestamp": "04:41:48", "text": "当然。"}, {"type": "subtitle", "time": 16910.07, "timestamp": "04:41:50", "text": "不用担心。"}, {"type": "subtitle", "time": 16911.43, "timestamp": "04:41:51", "text": "很抱歉我们不知道。"}, {"type": "subtitle", "time": 16914.708, "timestamp": "04:41:54", "text": "什么？坚持，稍等。即使一切都还好。"}, {"type": "subtitle", "time": 16919.19, "timestamp": "04:41:59", "text": "Mega，这个狡猾的变种人正试图变异。"}, {"type": "subtitle", "time": 16919.99, "timestamp": "04:41:59", "text": "我的天啊。"}]
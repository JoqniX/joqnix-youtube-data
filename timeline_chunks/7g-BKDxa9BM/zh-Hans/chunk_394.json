[{"type": "subtitle", "time": 23656.628, "timestamp": "06:34:16", "text": "哦，我有个主意。我们躲藏在里面"}, {"type": "subtitle", "time": 23658.468, "timestamp": "06:34:18", "text": "这个大个子，跟着他走。"}, {"type": "subtitle", "time": 23660.15, "timestamp": "06:34:20", "text": "发出声音。"}, {"type": "subtitle", "time": 23662.07, "timestamp": "06:34:22", "text": "那么请告诉我你的计划是什么"}, {"type": "subtitle", "time": 23664.07, "timestamp": "06:34:24", "text": "趁士兵不注意偷偷溜进去。"}, {"type": "subtitle", "time": 23666.23, "timestamp": "06:34:26", "text": "注意到。"}, {"type": "subtitle", "time": 23670.468, "timestamp": "06:34:30", "text": "嗯，你看，亨里克要走了。我们开始吧"}, {"type": "subtitle", "time": 23671.51, "timestamp": "06:34:31", "text": "去。"}, {"type": "subtitle", "time": 23685.11, "timestamp": "06:34:45", "text": "[音乐]"}, {"type": "subtitle", "time": 23686.15, "timestamp": "06:34:46", "text": "等待。"}, {"type": "subtitle", "time": 23689.27, "timestamp": "06:34:49", "text": "妈的。又是你。"}, {"type": "subtitle", "time": 23691.91, "timestamp": "06:34:51", "text": "不，不。我们正要返回……"}, {"type": "subtitle", "time": 23694.07, "timestamp": "06:34:54", "text": "酒馆。等待。"}]
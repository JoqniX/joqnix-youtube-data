[{"type": "subtitle", "time": 3721.51, "timestamp": "01:02:01", "text": "太多了"}, {"type": "subtitle", "time": 3725.51, "timestamp": "01:02:05", "text": "太重复了，而且一切都……"}, {"type": "subtitle", "time": 3727.43, "timestamp": "01:02:07", "text": "如果你之后筋疲力尽，就会发生这种情况。"}, {"type": "subtitle", "time": 3730.549, "timestamp": "01:02:10", "text": "磨练了这么多年。不"}, {"type": "subtitle", "time": 3737.75, "timestamp": "01:02:17", "text": "我以前玩过，现在不玩了。"}, {"type": "subtitle", "time": 3744.15, "timestamp": "01:02:24", "text": "我甚至还没到达五角大楼呢。"}, {"type": "subtitle", "time": 3747.91, "timestamp": "01:02:27", "text": "自从……之后就停止了"}, {"type": "subtitle", "time": 3751.109, "timestamp": "01:02:31", "text": "最后一件事是什么？"}, {"type": "subtitle", "time": 3754.47, "timestamp": "01:02:34", "text": "当丹航，呃，龙来了"}, {"type": "subtitle", "time": 3757.109, "timestamp": "01:02:37", "text": "现已推出该角色"}, {"type": "subtitle", "time": 3760.95, "timestamp": "01:02:40", "text": "是的，从那时起，我想那就是卢卡了。"}, {"type": "subtitle", "time": 3763.589, "timestamp": "01:02:43", "text": "洛卡或者别的什么，坟墓，那家伙"}, {"type": "subtitle", "time": 3765.91, "timestamp": "01:02:45", "text": "谁拿着坟墓，呃，坟墓盒，或者"}, {"type": "subtitle", "time": 3768.23, "timestamp": "01:02:48", "text": "他出来的时候发生了一件事，那就是"}]
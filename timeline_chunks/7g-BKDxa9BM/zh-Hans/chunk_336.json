[{"type": "subtitle", "time": 20185.99, "timestamp": "05:36:25", "text": "我的天啊。我可以像那样冲多少浪"}, {"type": "subtitle", "time": 20194.47, "timestamp": "05:36:34", "text": "天哪，我做了六次波浪动作。"}, {"type": "subtitle", "time": 20196.628, "timestamp": "05:36:36", "text": "我会惩罚那些不忠的人。"}, {"type": "subtitle", "time": 20201.03, "timestamp": "05:36:41", "text": "以爱神之名去爱。"}, {"type": "subtitle", "time": 20203.67, "timestamp": "05:36:43", "text": "太疯狂了"}]
[{"type": "subtitle", "time": 5945.669, "timestamp": "01:39:05", "text": "我能感觉到。"}, {"type": "subtitle", "time": 5947.35, "timestamp": "01:39:07", "text": "即使你正试图穿上"}, {"type": "subtitle", "time": 5948.39, "timestamp": "01:39:08", "text": "微笑。"}, {"type": "subtitle", "time": 5951.35, "timestamp": "01:39:11", "text": "我太喜欢她的这身打扮了。这就像……"}, {"type": "subtitle", "time": 5953.59, "timestamp": "01:39:13", "text": "我有点好奇你最近在忙些什么。"}, {"type": "subtitle", "time": 5954.709, "timestamp": "01:39:14", "text": "通过。"}, {"type": "subtitle", "time": 5956.87, "timestamp": "01:39:16", "text": "亨里克先生告诉我不要窥探我们的隐私"}, {"type": "subtitle", "time": 5958.31, "timestamp": "01:39:18", "text": "来访的客人。"}, {"type": "subtitle", "time": 5961.51, "timestamp": "01:39:21", "text": "你知道，就是她胳膊上的那个东西"}, {"type": "subtitle", "time": 5963.669, "timestamp": "01:39:23", "text": "像蝴蝶一样。"}, {"type": "subtitle", "time": 5967.27, "timestamp": "01:39:27", "text": "精神。我需要……我需要一些钱。是"}, {"type": "subtitle", "time": 5970.55, "timestamp": "01:39:30", "text": "有地方吗？让我看看。大多数人"}, {"type": "subtitle", "time": 5973.75, "timestamp": "01:39:33", "text": "他们在工厂工作。卡米拉小姐"}, {"type": "subtitle", "time": 5975.91, "timestamp": "01:39:35", "text": "斯嘉丽的酒馆。但"}, {"type": "subtitle", "time": 5976.629, "timestamp": "01:39:36", "text": "佣金。"}, {"type": "subtitle", "time": 5979.669, "timestamp": "01:39:39", "text": "那些佣金。卡米拉·斯嘉丽。"}, {"type": "subtitle", "time": 5982.629, "timestamp": "01:39:42", "text": "我今天见到她了。虽然我当时一无所知"}, {"type": "subtitle", "time": 5985.51, "timestamp": "01:39:45", "text": "她说：“没关系。”我能应付。"}, {"type": "subtitle", "time": 5987.91, "timestamp": "01:39:47", "text": "嗯？跑了这么久之后，"}, {"type": "subtitle", "time": 5991.03, "timestamp": "01:39:51", "text": "你要回到卡米拉身边吗？然后数"}, {"type": "subtitle", "time": 5994.149, "timestamp": "01:39:54", "text": "下雪了。雪对……再熟悉不过了。"}, {"type": "subtitle", "time": 5996.149, "timestamp": "01:39:56", "text": "那个地方。"}]
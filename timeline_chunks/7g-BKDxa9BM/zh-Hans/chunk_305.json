[{"type": "subtitle", "time": 18300.15, "timestamp": "05:05:00", "text": "进来。你们俩在……上做爱了。"}, {"type": "subtitle", "time": 18301.67, "timestamp": "05:05:01", "text": "你来这里是为了办理住宿手续，"}, {"type": "subtitle", "time": 18303.51, "timestamp": "05:05:03", "text": "难道不是吗？"}, {"type": "subtitle", "time": 18307.51, "timestamp": "05:05:07", "text": "不用担心。真的"}, {"type": "subtitle", "time": 18311.27, "timestamp": "05:05:11", "text": "那太好了，但那个人真是太……"}, {"type": "subtitle", "time": 18312.23, "timestamp": "05:05:12", "text": "共情"}, {"type": "subtitle", "time": 18314.31, "timestamp": "05:05:14", "text": "真的"}, {"type": "subtitle", "time": 18321.27, "timestamp": "05:05:21", "text": "是的"}, {"type": "subtitle", "time": 18324.948, "timestamp": "05:05:24", "text": "你一切都好吗？"}, {"type": "subtitle", "time": 18326.23, "timestamp": "05:05:26", "text": "你怎么了"}, {"type": "subtitle", "time": 18329.11, "timestamp": "05:05:29", "text": "只是小毛病而已"}, {"type": "subtitle", "time": 18330.31, "timestamp": "05:05:30", "text": "病痛"}, {"type": "subtitle", "time": 18333.19, "timestamp": "05:05:33", "text": "我很高兴所有房客都……"}, {"type": "subtitle", "time": 18335.59, "timestamp": "05:05:35", "text": "催眠"}, {"type": "subtitle", "time": 18339.03, "timestamp": "05:05:39", "text": "我一开始就走错了路。真的吗？"}, {"type": "subtitle", "time": 18341.43, "timestamp": "05:05:41", "text": "亨利先生，如果您愿意来的话"}, {"type": "subtitle", "time": 18344.55, "timestamp": "05:05:44", "text": "在这里，亨里克下棋几乎总是"}, {"type": "subtitle", "time": 18346.708, "timestamp": "05:05:46", "text": "这里。"}, {"type": "subtitle", "time": 18349.67, "timestamp": "05:05:49", "text": "亨里克先生上一任似乎很沮丧。"}, {"type": "subtitle", "time": 18351.67, "timestamp": "05:05:51", "text": "我很好。"}, {"type": "subtitle", "time": 18352.39, "timestamp": "05:05:52", "text": "亨先生"}, {"type": "subtitle", "time": 18355.59, "timestamp": "05:05:55", "text": "听到这个消息很高兴。"}, {"type": "subtitle", "time": 18359.11, "timestamp": "05:05:59", "text": "没关系。普赛克是"}]
[{"type": "subtitle", "time": 4989.99, "timestamp": "01:23:09", "text": "看来卡米拉·斯嘉丽小姐持有一些"}, {"type": "subtitle", "time": 4992.55, "timestamp": "01:23:12", "text": "这里摇摆。"}, {"type": "subtitle", "time": 4995.59, "timestamp": "01:23:15", "text": "或许我可以利用她。这里"}, {"type": "subtitle", "time": 5005.43, "timestamp": "01:23:25", "text": "天哪，我打喷嚏打个不停。太痛苦了。"}, {"type": "subtitle", "time": 5008.31, "timestamp": "01:23:28", "text": "我是纯洁无瑕的救赎者。恶魔，"}, {"type": "subtitle", "time": 5010.87, "timestamp": "01:23:30", "text": "光明之王。祝福他们。嗯，这个"}, {"type": "subtitle", "time": 5013.27, "timestamp": "01:23:33", "text": "人"}, {"type": "subtitle", "time": 5026.95, "timestamp": "01:23:46", "text": "成立。"}, {"type": "subtitle", "time": 5029.03, "timestamp": "01:23:49", "text": "卡米拉·斯嘉丽小姐让我来"}, {"type": "subtitle", "time": 5031.59, "timestamp": "01:23:51", "text": "这个地方。我原本希望留在这里。"}]
[{"type": "subtitle", "time": 1380.71, "timestamp": "00:23:00", "text": "快速胸部。右边两张牌"}, {"type": "subtitle", "time": 1382.149, "timestamp": "00:23:02", "text": "肩膀。"}, {"type": "subtitle", "time": 1389.59, "timestamp": "00:23:09", "text": "这太疯狂了。"}, {"type": "subtitle", "time": 1390.63, "timestamp": "00:23:10", "text": "更近了。"}, {"type": "subtitle", "time": 1396.95, "timestamp": "00:23:16", "text": "我可以瞄准三列火车。"}, {"type": "subtitle", "time": 1402.39, "timestamp": "00:23:22", "text": "我是"}, {"type": "subtitle", "time": 1404.47, "timestamp": "00:23:24", "text": "快的。"}, {"type": "subtitle", "time": 1408.31, "timestamp": "00:23:28", "text": "太好了。记住"}, {"type": "subtitle", "time": 1410.71, "timestamp": "00:23:30", "text": "快速眨眼三次意味着"}, {"type": "subtitle", "time": 1412.71, "timestamp": "00:23:32", "text": "我对那个信号不感兴趣。"}, {"type": "subtitle", "time": 1414.07, "timestamp": "00:23:34", "text": "哦，那是弹药。"}, {"type": "subtitle", "time": 1416.47, "timestamp": "00:23:36", "text": "无论如何，记住它。"}, {"type": "subtitle", "time": 1438.31, "timestamp": "00:23:58", "text": "我现在可以开始刷这些家伙了吗？"}]
[{"type": "subtitle", "time": 6301.51, "timestamp": "01:45:01", "text": "好了，开始锻造。"}, {"type": "subtitle", "time": 6311.35, "timestamp": "01:45:11", "text": "[音乐]"}, {"type": "subtitle", "time": 6313.43, "timestamp": "01:45:13", "text": "你有没有发现什么宝物？"}, {"type": "subtitle", "time": 6316.149, "timestamp": "01:45:16", "text": "最近？给我看看，我或许能伪造一个"}, {"type": "subtitle", "time": 6320.39, "timestamp": "01:45:20", "text": "它里面竟然藏着一件非常特别的武器。"}, {"type": "subtitle", "time": 6335.83, "timestamp": "01:45:35", "text": "呃，事件。"}]
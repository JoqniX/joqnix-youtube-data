[{"type": "subtitle", "time": 13440.309, "timestamp": "03:44:00", "text": "发生了什么事？"}, {"type": "subtitle", "time": 13442.95, "timestamp": "03:44:02", "text": "连喘息的时间都没有。听着，有人"}, {"type": "subtitle", "time": 13446.71, "timestamp": "03:44:06", "text": "在冰湖外发现了一头巨大的猪"}, {"type": "subtitle", "time": 13449.349, "timestamp": "03:44:09", "text": "他戴着帽子，比你高。"}, {"type": "subtitle", "time": 13452.87, "timestamp": "03:44:12", "text": "厢式货车的大小。如果它阻止了它，砰！"}]
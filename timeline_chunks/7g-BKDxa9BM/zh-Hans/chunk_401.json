[{"type": "subtitle", "time": 24062.788, "timestamp": "06:41:02", "text": "你是说普赛克有危险吗？"}, {"type": "subtitle", "time": 24065.27, "timestamp": "06:41:05", "text": "他失踪后被列入了名单。我"}, {"type": "subtitle", "time": 24067.51, "timestamp": "06:41:07", "text": "恐怕他的结局不太好。"}, {"type": "subtitle", "time": 24069.35, "timestamp": "06:41:09", "text": "我担心你的朋友赛琪可能会"}, {"type": "subtitle", "time": 24069.99, "timestamp": "06:41:09", "text": "下一个就是你。"}, {"type": "subtitle", "time": 24073.03, "timestamp": "06:41:13", "text": "哦，不。"}, {"type": "subtitle", "time": 24076.07, "timestamp": "06:41:16", "text": "亨里克回来的时机很糟糕。如果我曾"}, {"type": "subtitle", "time": 24078.07, "timestamp": "06:41:18", "text": "再过几分钟就好了。"}, {"type": "subtitle", "time": 24080.628, "timestamp": "06:41:20", "text": "我们现在该怎么办？"}, {"type": "subtitle", "time": 24081.43, "timestamp": "06:41:21", "text": "我要"}, {"type": "subtitle", "time": 24083.35, "timestamp": "06:41:23", "text": "不要操之过急。"}, {"type": "subtitle", "time": 24088.23, "timestamp": "06:41:28", "text": "不，行动永远是最好的。"}, {"type": "subtitle", "time": 24090.948, "timestamp": "06:41:30", "text": "只能无助地站在那里看着她。"}, {"type": "subtitle", "time": 24092.15, "timestamp": "06:41:32", "text": "离开。"}, {"type": "subtitle", "time": 24093.19, "timestamp": "06:41:33", "text": "你是怎么知道的？"}, {"type": "subtitle", "time": 24095.67, "timestamp": "06:41:35", "text": "只是猜测。你看起来很惊慌，"}, {"type": "subtitle", "time": 24097.19, "timestamp": "06:41:37", "text": "抛开所有谨慎和保留"}, {"type": "subtitle", "time": 24098.868, "timestamp": "06:41:38", "text": "突然刮起了风。"}, {"type": "subtitle", "time": 24101.43, "timestamp": "06:41:41", "text": "想象一下被扔到一个陌生的国度"}, {"type": "subtitle", "time": 24102.15, "timestamp": "06:41:42", "text": "孤身一人。"}, {"type": "subtitle", "time": 24102.788, "timestamp": "06:41:42", "text": "这是什么？"}, {"type": "subtitle", "time": 24105.91, "timestamp": "06:41:45", "text": "感到不被需要，感到无助。然后"}, {"type": "subtitle", "time": 24108.07, "timestamp": "06:41:48", "text": "有人主动联系你并鼓励你。"}, {"type": "subtitle", "time": 24110.468, "timestamp": "06:41:50", "text": "坚持下去，好事终会到来。"}, {"type": "subtitle", "time": 24112.468, "timestamp": "06:41:52", "text": "有人处于危险之中。"}, {"type": "subtitle", "time": 24114.31, "timestamp": "06:41:54", "text": "你也会竭尽全力去帮忙。"}, {"type": "subtitle", "time": 24115.75, "timestamp": "06:41:55", "text": "真的。我会的。"}, {"type": "subtitle", "time": 24118.31, "timestamp": "06:41:58", "text": "或许你是对的。苦涩"}]
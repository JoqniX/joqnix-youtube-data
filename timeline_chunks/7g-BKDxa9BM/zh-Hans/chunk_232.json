[{"type": "subtitle", "time": 13927.67, "timestamp": "03:52:07", "text": "[音乐]"}, {"type": "subtitle", "time": 13956.95, "timestamp": "03:52:36", "text": "好的。这边。"}, {"type": "subtitle", "time": 13959.75, "timestamp": "03:52:39", "text": "我们到了。哀叹湖以南"}, {"type": "subtitle", "time": 13962.389, "timestamp": "03:52:42", "text": "大斜坡。这是人们说的地方"}, {"type": "subtitle", "time": 13965.75, "timestamp": "03:52:45", "text": "他们看到了那头巨猪。"}, {"type": "subtitle", "time": 13967.269, "timestamp": "03:52:47", "text": "巨型猪。"}, {"type": "subtitle", "time": 13969.51, "timestamp": "03:52:49", "text": "我什么也没看到。"}, {"type": "subtitle", "time": 13970.63, "timestamp": "03:52:50", "text": "这不可能。"}, {"type": "subtitle", "time": 13974.07, "timestamp": "03:52:54", "text": "好的。我要走了。哦，等等，等等。"}, {"type": "subtitle", "time": 13977.189, "timestamp": "03:52:57", "text": "看那边。看？快点。如果"}, {"type": "subtitle", "time": 13979.75, "timestamp": "03:52:59", "text": "他们不在那里，我们回去吧。"}]
[{"type": "subtitle", "time": 6687.99, "timestamp": "01:51:27", "text": "哦，原来是火焰喷射器。我的天哪，这是"}, {"type": "subtitle", "time": 6690.229, "timestamp": "01:51:30", "text": "一个该死的火焰喷射器。"}, {"type": "subtitle", "time": 6692.709, "timestamp": "01:51:32", "text": "决不。"}, {"type": "subtitle", "time": 6700.47, "timestamp": "01:51:40", "text": "哇。"}, {"type": "subtitle", "time": 6703.109, "timestamp": "01:51:43", "text": "如果你仔细观察，你会发现每个角色都有自己的"}, {"type": "subtitle", "time": 6705.99, "timestamp": "01:51:45", "text": "独一无二的东西。就像因为我"}, {"type": "subtitle", "time": 6708.39, "timestamp": "01:51:48", "text": "扮演丽贝卡时，她的颜色是水蓝色。"}, {"type": "subtitle", "time": 6711.75, "timestamp": "01:51:51", "text": "正确的？所以剑刃劈砍和"}, {"type": "subtitle", "time": 6716.47, "timestamp": "01:51:56", "text": "枪声是她的口音主题。那是"}]
[{"type": "subtitle", "time": 13046.79, "timestamp": "03:37:26", "text": "施肥。嗯，是的，一个"}, {"type": "subtitle", "time": 13060.55, "timestamp": "03:37:40", "text": "我的肥料都去哪儿了？什么？"}, {"type": "subtitle", "time": 13062.16, "timestamp": "03:37:42", "text": "什么？ 好了，就是这样。"}, {"type": "subtitle", "time": 13070.389, "timestamp": "03:37:50", "text": "所以，如果我的理论正确，这将"}, {"type": "subtitle", "time": 13073.349, "timestamp": "03:37:53", "text": "给附近的植物授粉"}, {"type": "subtitle", "time": 13076.07, "timestamp": "03:37:56", "text": "把田地变成黑色"}, {"type": "subtitle", "time": 13079.99, "timestamp": "03:37:59", "text": "花。这也会导致授粉。"}]
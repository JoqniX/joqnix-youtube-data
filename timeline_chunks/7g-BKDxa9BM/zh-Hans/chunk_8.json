[{"type": "subtitle", "time": 490.71, "timestamp": "00:08:10", "text": "这是谁？我正在获得"}, {"type": "subtitle", "time": 494.55, "timestamp": "00:08:14", "text": "我感觉自己快要陷进沙子里了。"}, {"type": "subtitle", "time": 501.99, "timestamp": "00:08:21", "text": "这次逃脱是由那件奇怪的事情预示的。"}, {"type": "subtitle", "time": 504.95, "timestamp": "00:08:24", "text": "梦。我也一直深受类似问题的困扰。"}, {"type": "subtitle", "time": 506.79, "timestamp": "00:08:26", "text": "我一生都是如此。但现在还不是时候"}, {"type": "subtitle", "time": 509.029, "timestamp": "00:08:29", "text": "反射。但还有更紧迫的事情。"}, {"type": "subtitle", "time": 511.189, "timestamp": "00:08:31", "text": "那一刻。巴里和我必须逃离"}, {"type": "subtitle", "time": 515.11, "timestamp": "00:08:35", "text": "这座岛屿冰封着我们。我们曾经拥有的和平"}, {"type": "subtitle", "time": 518.07, "timestamp": "00:08:38", "text": "知道已被撕裂"}, {"type": "subtitle", "time": 528.87, "timestamp": "00:08:48", "text": "那位女士是谁？那他是谁？"}, {"type": "subtitle", "time": 531.35, "timestamp": "00:08:51", "text": "水分？"}, {"type": "subtitle", "time": 533.829, "timestamp": "00:08:53", "text": "你还好吗？"}, {"type": "subtitle", "time": 535.75, "timestamp": "00:08:55", "text": "是的。"}, {"type": "subtitle", "time": 538.55, "timestamp": "00:08:58", "text": "再睡一会儿吧。我不会离开。患病的"}]
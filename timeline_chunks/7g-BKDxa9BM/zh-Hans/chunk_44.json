[{"type": "subtitle", "time": 2643.109, "timestamp": "00:44:03", "text": "这种权力并没有改变任何事情。"}, {"type": "subtitle", "time": 2646.55, "timestamp": "00:44:06", "text": "我坠入大海，再也醒不过来了。"}, {"type": "subtitle", "time": 2648.47, "timestamp": "00:44:08", "text": "又起来了。"}, {"type": "subtitle", "time": 2651.51, "timestamp": "00:44:11", "text": "不，我能看到。"}, {"type": "subtitle", "time": 2653.67, "timestamp": "00:44:13", "text": "你的未来。我们的未来。"}, {"type": "subtitle", "time": 2657.51, "timestamp": "00:44:17", "text": "这是什么灰尘？沙。月沙。"}, {"type": "subtitle", "time": 2659.75, "timestamp": "00:44:19", "text": "总会有人把你从咸水中救出来。"}, {"type": "subtitle", "time": 2660.55, "timestamp": "00:44:20", "text": "水。"}, {"type": "subtitle", "time": 2662.87, "timestamp": "00:44:22", "text": "你是说"}, {"type": "subtitle", "time": 2664.63, "timestamp": "00:44:24", "text": "我还活着？"}, {"type": "subtitle", "time": 2666.95, "timestamp": "00:44:26", "text": "该出发了。人生就像……"}, {"type": "subtitle", "time": 2668.95, "timestamp": "00:44:28", "text": "孤独地航行在无垠的大海中"}, {"type": "subtitle", "time": 2670.63, "timestamp": "00:44:30", "text": "夜幕降临。"}, {"type": "subtitle", "time": 2673.51, "timestamp": "00:44:33", "text": "好的。河流在哭泣，泛滥成灾"}, {"type": "subtitle", "time": 2676.069, "timestamp": "00:44:36", "text": "河岸，而荆棘丛生的灌木丛……"}, {"type": "subtitle", "time": 2678.79, "timestamp": "00:44:38", "text": "双方都以此作为对其的证明。"}, {"type": "subtitle", "time": 2679.99, "timestamp": "00:44:39", "text": "悲哀。"}, {"type": "subtitle", "time": 2681.589, "timestamp": "00:44:41", "text": "角质无花果。"}, {"type": "subtitle", "time": 2683.91, "timestamp": "00:44:43", "text": "我会一直守护着你，我的唯一"}, {"type": "subtitle", "time": 2686.87, "timestamp": "00:44:46", "text": "对岸看看你在哪里"}, {"type": "subtitle", "time": 2699.03, "timestamp": "00:44:59", "text": "一只大型猫科动物降落。那里可以钓鱼"}]
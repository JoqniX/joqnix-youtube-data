[{"type": "subtitle", "time": 2701.75, "timestamp": "00:45:01", "text": "这款游戏。当然还有。"}, {"type": "subtitle", "time": 2703.51, "timestamp": "00:45:03", "text": "钓鱼。"}, {"type": "chat", "time": 2715.553, "timestamp": "00:45:15", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "Do you eat eggs?"}, {"type": "subtitle", "time": 2726.63, "timestamp": "00:45:26", "text": "你吃鸡蛋吗？我当然会吃"}, {"type": "subtitle", "time": 2730.47, "timestamp": "00:45:30", "text": "一切。鸡蛋、肉类，应有尽有。"}, {"type": "subtitle", "time": 2731.43, "timestamp": "00:45:31", "text": "无限制。"}, {"type": "subtitle", "time": 2734.87, "timestamp": "00:45:34", "text": "第一次来这个省。"}, {"type": "subtitle", "time": 2737.75, "timestamp": "00:45:37", "text": "这些人是谁？"}, {"type": "subtitle", "time": 2741.349, "timestamp": "00:45:41", "text": "她觉得这个男人感觉就像……"}, {"type": "subtitle", "time": 2749.109, "timestamp": "00:45:49", "text": "便宜货。你想付多少钱我都付。"}, {"type": "subtitle", "time": 2752.39, "timestamp": "00:45:52", "text": "而你所要做的就是……嗯，将会是"}, {"type": "subtitle", "time": 2754.309, "timestamp": "00:45:54", "text": "小菜一碟。"}]
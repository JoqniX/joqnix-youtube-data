[{"type": "subtitle", "time": 2523.03, "timestamp": "00:42:03", "text": "坚持住。我接到你了。"}, {"type": "subtitle", "time": 2525.43, "timestamp": "00:42:05", "text": "不。不。"}, {"type": "subtitle", "time": 2527.27, "timestamp": "00:42:07", "text": "哦，等等。"}, {"type": "subtitle", "time": 2529.99, "timestamp": "00:42:09", "text": "放弃吧。零号。"}, {"type": "subtitle", "time": 2532.71, "timestamp": "00:42:12", "text": "即使最坚硬的刀刃也有它。"}, {"type": "subtitle", "time": 2536.55, "timestamp": "00:42:16", "text": "不，不，不，千万别。不要把她带走。"}, {"type": "subtitle", "time": 2541.109, "timestamp": "00:42:21", "text": "手臂。请你如此关心"}, {"type": "subtitle", "time": 2542.87, "timestamp": "00:42:22", "text": "否则她将"}, {"type": "subtitle", "time": 2549.27, "timestamp": "00:42:29", "text": "我跟你一起回去。但你必须"}, {"type": "subtitle", "time": 2551.99, "timestamp": "00:42:31", "text": "答应放她走。"}, {"type": "subtitle", "time": 2555.27, "timestamp": "00:42:35", "text": "你给我保证，否则你可以拿两个。"}, {"type": "subtitle", "time": 2557.109, "timestamp": "00:42:37", "text": "尸体倒了。"}, {"type": "subtitle", "time": 2560.79, "timestamp": "00:42:40", "text": "或许我没表达清楚。"}, {"type": "subtitle", "time": 2563.03, "timestamp": "00:42:43", "text": "这不是谈判。"}, {"type": "subtitle", "time": 2570.39, "timestamp": "00:42:50", "text": "不，不，不。"}, {"type": "subtitle", "time": 2573.99, "timestamp": "00:42:53", "text": "你出去。"}]
[{"type": "subtitle", "time": 5882.229, "timestamp": "01:38:02", "text": "如果她成功逃脱，她肯定会"}, {"type": "subtitle", "time": 5886.87, "timestamp": "01:38:06", "text": "想尽一切办法找到我。当然，我"}, {"type": "subtitle", "time": 5888.95, "timestamp": "01:38:08", "text": "不能排除最坏情况的可能性。"}, {"type": "subtitle", "time": 5893.83, "timestamp": "01:38:13", "text": "西比尔把她带到了军团。"}, {"type": "subtitle", "time": 5897.189, "timestamp": "01:38:17", "text": "令人欣慰的是，似乎……"}, {"type": "subtitle", "time": 5901.109, "timestamp": "01:38:21", "text": "西比尔出于某种原因需要巴里，所以"}, {"type": "subtitle", "time": 5904.709, "timestamp": "01:38:24", "text": "她大概不会伤害她。"}, {"type": "subtitle", "time": 5908.229, "timestamp": "01:38:28", "text": "总之，我需要想办法凑齐一些钱。"}, {"type": "subtitle", "time": 5911.91, "timestamp": "01:38:31", "text": "在冰湖城里存点钱，办张旅行许可证，"}, {"type": "subtitle", "time": 5915.109, "timestamp": "01:38:35", "text": "然后计划下一步行动。"}, {"type": "subtitle", "time": 5916.55, "timestamp": "01:38:36", "text": "旅行许可。好的。"}, {"type": "subtitle", "time": 5918.47, "timestamp": "01:38:38", "text": "后退。"}, {"type": "subtitle", "time": 5920.79, "timestamp": "01:38:40", "text": "你一定饿坏了。这里有一些"}, {"type": "subtitle", "time": 5923.669, "timestamp": "01:38:43", "text": "新鲜出炉的面包。"}, {"type": "subtitle", "time": 5925.99, "timestamp": "01:38:45", "text": "巴里。"}, {"type": "subtitle", "time": 5930.629, "timestamp": "01:38:50", "text": "你还好吗？"}, {"type": "subtitle", "time": 5933.35, "timestamp": "01:38:53", "text": "哦，就像"}, {"type": "subtitle", "time": 5936.47, "timestamp": "01:38:56", "text": "嗯，那你最好吃点面包。"}, {"type": "subtitle", "time": 5938.79, "timestamp": "01:38:58", "text": "然后喝点温牛奶送服。"}, {"type": "subtitle", "time": 5939.91, "timestamp": "01:38:59", "text": "温牛奶？"}]
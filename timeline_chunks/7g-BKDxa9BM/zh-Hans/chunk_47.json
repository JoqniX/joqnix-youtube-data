[{"type": "subtitle", "time": 2822.309, "timestamp": "00:47:02", "text": "这座城市吓了一跳，是吧？不用担心。"}, {"type": "subtitle", "time": 2825.109, "timestamp": "00:47:05", "text": "你很快就会安全了。冰湖是"}, {"type": "subtitle", "time": 2828.95, "timestamp": "00:47:08", "text": "海伯利亚北部最大的城市。"}, {"type": "subtitle", "time": 2831.75, "timestamp": "00:47:11", "text": "北下孔。"}, {"type": "subtitle", "time": 2834.79, "timestamp": "00:47:14", "text": "嗯，是的。这有什么大不了的？"}, {"type": "subtitle", "time": 2837.43, "timestamp": "00:47:17", "text": "你认识一个叫西比尔的女人吗？"}, {"type": "subtitle", "time": 2840.39, "timestamp": "00:47:20", "text": "其他人称她为首领和"}, {"type": "subtitle", "time": 2843.99, "timestamp": "00:47:23", "text": "她应该在这个国家。我"}, {"type": "subtitle", "time": 2844.47, "timestamp": "00:47:24", "text": "需要"}, {"type": "subtitle", "time": 2846.87, "timestamp": "00:47:26", "text": "民事是一个常见名称，但只有"}, {"type": "subtitle", "time": 2849.51, "timestamp": "00:47:29", "text": "与“首领”头衔相关的。"}, {"type": "subtitle", "time": 2851.43, "timestamp": "00:47:31", "text": "你想找到她吗？"}, {"type": "subtitle", "time": 2852.87, "timestamp": "00:47:32", "text": "你是怎么失去理智的？"}, {"type": "subtitle", "time": 2853.829, "timestamp": "00:47:33", "text": "暴风雪？"}, {"type": "subtitle", "time": 2855.75, "timestamp": "00:47:35", "text": "我以为卡隆应该是……"}, {"type": "subtitle", "time": 2857.67, "timestamp": "00:47:37", "text": "耐寒。"}, {"type": "subtitle", "time": 2858.47, "timestamp": "00:47:38", "text": "卡隆斯？"}, {"type": "subtitle", "time": 2863.19, "timestamp": "00:47:43", "text": "认真点。她可能拿了一些。"}, {"type": "subtitle", "time": 2866.95, "timestamp": "00:47:46", "text": "这对我来说非常重要。间谍，"}, {"type": "subtitle", "time": 2869.67, "timestamp": "00:47:49", "text": "暗杀，反抗。用什么"}, {"type": "subtitle", "time": 2871.349, "timestamp": "00:47:51", "text": "你刚才说的是帝国士兵"}, {"type": "subtitle", "time": 2872.95, "timestamp": "00:47:52", "text": "可能因以下三个原因逮捕你"}, {"type": "subtitle", "time": 2873.589, "timestamp": "00:47:53", "text": "独自的。"}, {"type": "subtitle", "time": 2874.63, "timestamp": "00:47:54", "text": "哇。"}, {"type": "subtitle", "time": 2877.03, "timestamp": "00:47:57", "text": "如果你真的想找到首领，"}, {"type": "subtitle", "time": 2879.27, "timestamp": "00:47:59", "text": "我建议你不要这样做。最后"}]
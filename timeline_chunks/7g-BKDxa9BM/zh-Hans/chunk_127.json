[{"type": "subtitle", "time": 7621.669, "timestamp": "02:07:01", "text": "你大概没学到什么人生经验吧"}, {"type": "subtitle", "time": 7623.03, "timestamp": "02:07:03", "text": "母亲从来没有这样做过。"}, {"type": "subtitle", "time": 7625.189, "timestamp": "02:07:05", "text": "别把我妈牵扯进来。放手"}, {"type": "subtitle", "time": 7627.189, "timestamp": "02:07:07", "text": "我。你这个卑鄙的黑客。"}, {"type": "subtitle", "time": 7628.709, "timestamp": "02:07:08", "text": "魔女。"}, {"type": "subtitle", "time": 7631.43, "timestamp": "02:07:11", "text": "哦，他给他打过电话。叫她老巫婆。"}, {"type": "subtitle", "time": 7632.79, "timestamp": "02:07:12", "text": "把他送到保安局。"}, {"type": "subtitle", "time": 7633.43, "timestamp": "02:07:13", "text": "直的。"}, {"type": "subtitle", "time": 7636.149, "timestamp": "02:07:16", "text": "什么？不。"}, {"type": "subtitle", "time": 7638.47, "timestamp": "02:07:18", "text": "不，求你了。"}, {"type": "subtitle", "time": 7640.069, "timestamp": "02:07:20", "text": "我走了。冰湖永存。"}, {"type": "subtitle", "time": 7642.149, "timestamp": "02:07:22", "text": "卡米拉小姐。他怎么了？"}, {"type": "subtitle", "time": 7644.95, "timestamp": "02:07:24", "text": "保持距离。他比……危险得多"}, {"type": "subtitle", "time": 7647.43, "timestamp": "02:07:27", "text": "他看了看。总之，玛吉得到了如果你是"}, {"type": "subtitle", "time": 7648.39, "timestamp": "02:07:28", "text": "仍然设定"}, {"type": "subtitle", "time": 7651.589, "timestamp": "02:07:31", "text": "求求你放了我吧。"}, {"type": "subtitle", "time": 7652.709, "timestamp": "02:07:32", "text": "真奇怪。"}, {"type": "subtitle", "time": 7654.95, "timestamp": "02:07:34", "text": "我为什么会惊慌失措？我确实很想念卡米拉的"}, {"type": "subtitle", "time": 7657.91, "timestamp": "02:07:37", "text": "还有那个小偷。看起来像在颤抖"}, {"type": "subtitle", "time": 7661.03, "timestamp": "02:07:41", "text": "看来他要倒霉了。"}, {"type": "subtitle", "time": 7662.87, "timestamp": "02:07:42", "text": "我差点忘了。谢谢。"}, {"type": "subtitle", "time": 7664.87, "timestamp": "02:07:44", "text": "哦，我们收到报告了。"}, {"type": "subtitle", "time": 7667.35, "timestamp": "02:07:47", "text": "好了，我得去把这些硬币分了。"}, {"type": "subtitle", "time": 7669.91, "timestamp": "02:07:49", "text": "我通常到处购物。"}, {"type": "subtitle", "time": 7675.27, "timestamp": "02:07:55", "text": "我们是要回去还是要被困在原地？"}, {"type": "subtitle", "time": 7676.79, "timestamp": "02:07:56", "text": "贫民窟？"}]
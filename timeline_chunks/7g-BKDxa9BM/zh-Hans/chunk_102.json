[{"type": "subtitle", "time": 6120.55, "timestamp": "01:42:00", "text": "好吧，这次我就放过你了。"}, {"type": "subtitle", "time": 6123.669, "timestamp": "01:42:03", "text": "哦，对。这是"}, {"type": "subtitle", "time": 6136.53, "timestamp": "01:42:16", "text": "惊人的。那真是难以置信。"}, {"type": "subtitle", "time": 6139.03, "timestamp": "01:42:19", "text": "[音乐]"}, {"type": "subtitle", "time": 6141.03, "timestamp": "01:42:21", "text": "我不知道。"}, {"type": "subtitle", "time": 6143.51, "timestamp": "01:42:23", "text": "这把剑陪伴了我很久很久"}, {"type": "subtitle", "time": 6147.27, "timestamp": "01:42:27", "text": "尽我所能。有意思。非常有趣。"}, {"type": "subtitle", "time": 6150.629, "timestamp": "01:42:30", "text": "这就是我整个孩子心目中的武器匠吗？"}, {"type": "subtitle", "time": 6154.39, "timestamp": "01:42:34", "text": "我是 Lunosmith，一位世界级的铁匠。我已经"}, {"type": "subtitle", "time": 6156.149, "timestamp": "01:42:36", "text": "从全国各地旅行"}, {"type": "subtitle", "time": 6158.87, "timestamp": "01:42:38", "text": "Hyperoreia 到 Alisium，我锻造"}, {"type": "subtitle", "time": 6162.07, "timestamp": "01:42:42", "text": "数不胜数的武器。如果您需要任何帮助"}, {"type": "subtitle", "time": 6166.229, "timestamp": "01:42:46", "text": "武器，我听候你的差遣。哇。所以，"}, {"type": "subtitle", "time": 6169.83, "timestamp": "01:42:49", "text": "你是一位经验丰富的铁匠大师。"}, {"type": "subtitle", "time": 6172.87, "timestamp": "01:42:52", "text": "我只要求基本工资和"}]
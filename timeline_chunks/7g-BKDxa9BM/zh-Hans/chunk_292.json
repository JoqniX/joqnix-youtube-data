[{"type": "subtitle", "time": 17524.39, "timestamp": "04:52:04", "text": "局外人，"}, {"type": "subtitle", "time": 17527.51, "timestamp": "04:52:07", "text": "你今天回家这么晚。哪里有"}, {"type": "subtitle", "time": 17561.11, "timestamp": "04:52:41", "text": "是在积雪覆盖的茂密森林里吗？"}, {"type": "subtitle", "time": 17563.03, "timestamp": "04:52:43", "text": "狼是棕色的吗？或者"}, {"type": "subtitle", "time": 17565.51, "timestamp": "04:52:45", "text": "我哪儿也没去。今天是小姐"}, {"type": "subtitle", "time": 17567.27, "timestamp": "04:52:47", "text": "菲娜的生日，所以我留在了冰雪世界。"}, {"type": "subtitle", "time": 17568.15, "timestamp": "04:52:48", "text": "湖。"}, {"type": "subtitle", "time": 17568.868, "timestamp": "04:52:48", "text": "冰湖？"}, {"type": "subtitle", "time": 17572.23, "timestamp": "04:52:52", "text": "你总是这么说。然而，新的伤疤依然存在"}, {"type": "subtitle", "time": 17575.51, "timestamp": "04:52:55", "text": "出现在你的手臂上。"}, {"type": "subtitle", "time": 17577.03, "timestamp": "04:52:57", "text": "哦，不。她没事吧？"}, {"type": "subtitle", "time": 17579.43, "timestamp": "04:52:59", "text": "但这次是真的。"}]
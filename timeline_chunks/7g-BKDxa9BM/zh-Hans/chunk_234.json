[{"type": "subtitle", "time": 14044.15, "timestamp": "03:54:04", "text": "哦，是这个。这简直就是个好朋友"}, {"type": "subtitle", "time": 14047.03, "timestamp": "03:54:07", "text": "如今的世界。"}, {"type": "subtitle", "time": 14051.11, "timestamp": "03:54:11", "text": "我们收集了这些可爱的宝可梦。"}, {"type": "subtitle", "time": 14054.469, "timestamp": "03:54:14", "text": "嗯？不要伤害精灵。"}, {"type": "subtitle", "time": 14056.55, "timestamp": "03:54:16", "text": "把他们打倒。"}, {"type": "subtitle", "time": 14058.07, "timestamp": "03:54:18", "text": "我的天哪，她来了。"}, {"type": "subtitle", "time": 14060.15, "timestamp": "03:54:20", "text": "大声说出来。我们还有多少次机会？"}, {"type": "subtitle", "time": 14062.469, "timestamp": "03:54:22", "text": "偶遇她？赶快。抓住所有"}, {"type": "subtitle", "time": 14065.03, "timestamp": "03:54:25", "text": "天才们，行动起来。"}, {"type": "subtitle", "time": 14067.91, "timestamp": "03:54:27", "text": "他们要逃走了。小姐和您的"}, {"type": "subtitle", "time": 14072.309, "timestamp": "03:54:32", "text": "小朋友，能帮我个忙吗？"}, {"type": "subtitle", "time": 14076.95, "timestamp": "03:54:36", "text": "那头巨型猪是真的。它会说话。好的，我"}, {"type": "subtitle", "time": 14078.95, "timestamp": "03:54:38", "text": "就说我们按它说的做。那些家伙"}, {"type": "subtitle", "time": 14093.429, "timestamp": "03:54:53", "text": "所有人当场死亡。我刚刚去世了"}, {"type": "subtitle", "time": 14095.91, "timestamp": "03:54:55", "text": "由此而来。搞什么鬼？你有没有看到"}, {"type": "subtitle", "time": 14097.59, "timestamp": "03:54:57", "text": "那？我被抛弃了。"}, {"type": "subtitle", "time": 14099.83, "timestamp": "03:54:59", "text": "他们跑得飞快，消失在……"}]
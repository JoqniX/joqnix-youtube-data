[{"type": "subtitle", "time": 3841.43, "timestamp": "01:04:01", "text": "城门就在前面。跟随"}, {"type": "subtitle", "time": 3844.23, "timestamp": "01:04:04", "text": "在我们身后。我们会让你进去的。并且保持"}, {"type": "subtitle", "time": 3846.95, "timestamp": "01:04:06", "text": "闭嘴。如果有什么事发生"}, {"type": "subtitle", "time": 3853.27, "timestamp": "01:04:13", "text": "你好。"}, {"type": "subtitle", "time": 3856.309, "timestamp": "01:04:16", "text": "无需再次核查。完全不记得了"}, {"type": "subtitle", "time": 3859.19, "timestamp": "01:04:19", "text": "卡米拉和斯诺，是吗？看起来你的"}, {"type": "subtitle", "time": 3860.95, "timestamp": "01:04:20", "text": "你的眼睛和大脑都不太灵光。"}, {"type": "subtitle", "time": 3862.95, "timestamp": "01:04:22", "text": "出色地。"}, {"type": "subtitle", "time": 3868.15, "timestamp": "01:04:28", "text": "不是你，卢诺。我当时在和Oi说话。"}, {"type": "subtitle", "time": 3870.63, "timestamp": "01:04:30", "text": "我为什么这么急着去参观？"}, {"type": "subtitle", "time": 3873.19, "timestamp": "01:04:33", "text": "保安局负责茶叶？是的。"}, {"type": "subtitle", "time": 3876.069, "timestamp": "01:04:36", "text": "他……我的天哪。英国人"}, {"type": "subtitle", "time": 3879.43, "timestamp": "01:04:39", "text": "我在布瓦被亚洲骗了。"}, {"type": "subtitle", "time": 3881.75, "timestamp": "01:04:41", "text": "所以我才带我们俩来这里。"}, {"type": "subtitle", "time": 3883.75, "timestamp": "01:04:43", "text": "啊。"}, {"type": "subtitle", "time": 3885.349, "timestamp": "01:04:45", "text": "该死。"}]
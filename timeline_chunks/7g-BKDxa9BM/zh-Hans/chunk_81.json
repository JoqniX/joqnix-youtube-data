[{"type": "subtitle", "time": 4862.31, "timestamp": "01:21:02", "text": "房子？我是从客人那里听说的。"}, {"type": "subtitle", "time": 4865.189, "timestamp": "01:21:05", "text": "在阿斯皮德尔。总会有人"}, {"type": "subtitle", "time": 4867.669, "timestamp": "01:21:07", "text": "抱怨。即便如此"}, {"type": "subtitle", "time": 4869.99, "timestamp": "01:21:09", "text": "一家大旅馆，大门总是紧闭。"}, {"type": "subtitle", "time": 4872.55, "timestamp": "01:21:12", "text": "每天都很紧张，拒绝任何"}, {"type": "subtitle", "time": 4876.07, "timestamp": "01:21:16", "text": "来自外地的游客。或者如何"}, {"type": "subtitle", "time": 4879.91, "timestamp": "01:21:19", "text": "这些房客似乎从来不离开。"}, {"type": "subtitle", "time": 4882.79, "timestamp": "01:21:22", "text": "旅店老板的脸色更冷了。"}, {"type": "subtitle", "time": 4895.11, "timestamp": "01:21:35", "text": "[音乐]"}, {"type": "subtitle", "time": 4897.35, "timestamp": "01:21:37", "text": "他好像不是"}, {"type": "subtitle", "time": 4897.99, "timestamp": "01:21:37", "text": "一个"}, {"type": "subtitle", "time": 4899.59, "timestamp": "01:21:39", "text": "打喷嚏打个不停。"}, {"type": "subtitle", "time": 4902.47, "timestamp": "01:21:42", "text": "听起来还不错。我以为是"}, {"type": "subtitle", "time": 4904.39, "timestamp": "01:21:44", "text": "里面挤满了肮脏之徒和罪犯。"}, {"type": "subtitle", "time": 4906.31, "timestamp": "01:21:46", "text": "合作功能。完成黑色"}, {"type": "subtitle", "time": 4909.43, "timestamp": "01:21:49", "text": "本章的铁与白水。不"}, {"type": "subtitle", "time": 4911.189, "timestamp": "01:21:51", "text": "转到以解锁合作模式。结识其他玩家"}, {"type": "subtitle", "time": 4913.59, "timestamp": "01:21:53", "text": "随着时间的推移，我们一直致力于"}]
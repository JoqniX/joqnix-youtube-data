[{"type": "subtitle", "time": 3960.95, "timestamp": "01:06:00", "text": "全国通缉犯所以，酋长"}, {"type": "subtitle", "time": 3962.549, "timestamp": "01:06:02", "text": "特别要求严格的安保措施"}, {"type": "subtitle", "time": 3970.789, "timestamp": "01:06:10", "text": "要是我们能查到延迟就好了。"}, {"type": "subtitle", "time": 3971.43, "timestamp": "01:06:11", "text": "男人。"}, {"type": "subtitle", "time": 3976.069, "timestamp": "01:06:16", "text": "被遗弃者们，我告诉你们。我"}, {"type": "subtitle", "time": 3979.27, "timestamp": "01:06:19", "text": "我以我的荣誉向你保证，她有"}, {"type": "subtitle", "time": 3982.789, "timestamp": "01:06:22", "text": "与被遗弃者无关。"}, {"type": "subtitle", "time": 3985.99, "timestamp": "01:06:25", "text": "好的，我相信你，卡米拉小姐。但"}, {"type": "subtitle", "time": 3988.47, "timestamp": "01:06:28", "text": "记住，一定要密切关注这个孩子。"}, {"type": "subtitle", "time": 3991.349, "timestamp": "01:06:31", "text": "别让她惹是生非。"}, {"type": "subtitle", "time": 3994.789, "timestamp": "01:06:34", "text": "镇。如果局长发现了这件事，"}, {"type": "subtitle", "time": 3997.67, "timestamp": "01:06:37", "text": "我们俩都得遭殃。"}, {"type": "subtitle", "time": 3998.069, "timestamp": "01:06:38", "text": "哦，"}, {"type": "subtitle", "time": 4000.71, "timestamp": "01:06:40", "text": "谢谢。下次你来的时候"}, {"type": "subtitle", "time": 4014.47, "timestamp": "01:06:54", "text": "要是能看到ping值就好了。"}, {"type": "subtitle", "time": 4016.71, "timestamp": "01:06:56", "text": "就像通常这些游戏会向你展示的那样"}]
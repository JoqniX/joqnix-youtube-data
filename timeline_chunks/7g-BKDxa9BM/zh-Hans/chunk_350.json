[{"type": "subtitle", "time": 21001.03, "timestamp": "05:50:01", "text": "那真是个不错的例子。"}, {"type": "subtitle", "time": 21008.39, "timestamp": "05:50:08", "text": "我必须拿到所有的武器和所有东西"}, {"type": "subtitle", "time": 21011.03, "timestamp": "05:50:11", "text": "角色。"}, {"type": "subtitle", "time": 21013.27, "timestamp": "05:50:13", "text": "不过，不着急。这不是扭蛋游戏。我"}, {"type": "subtitle", "time": 21015.99, "timestamp": "05:50:15", "text": "意思是说，这是一款扭蛋游戏，但没有陷阱。"}, {"type": "subtitle", "time": 21019.03, "timestamp": "05:50:19", "text": "这是动漫版的《星际战甲》，"}, {"type": "subtitle", "time": 21023.67, "timestamp": "05:50:23", "text": "所以没问题。我可以慢慢来。"}, {"type": "subtitle", "time": 21025.99, "timestamp": "05:50:25", "text": "里夫。"}, {"type": "subtitle", "time": 21027.91, "timestamp": "05:50:27", "text": "好的。所以，这是标准版"}, {"type": "subtitle", "time": 21030.788, "timestamp": "05:50:30", "text": "横幅将用于宣传这款化妆品。"}, {"type": "subtitle", "time": 21033.21, "timestamp": "05:50:33", "text": "啊，"}, {"type": "subtitle", "time": 21034.628, "timestamp": "05:50:34", "text": "[音乐]"}, {"type": "subtitle", "time": 21037.19, "timestamp": "05:50:37", "text": "我应该抽米娜吗？我不知道。患病的"}, {"type": "subtitle", "time": 21040.47, "timestamp": "05:50:40", "text": "攒钱就行了。我有50 P。我有50"}, {"type": "subtitle", "time": 21045.11, "timestamp": "05:50:45", "text": "我能得到的东西。我喜欢这些化妆品。"}, {"type": "subtitle", "time": 21048.548, "timestamp": "05:50:48", "text": "我想要这只紫色的蝴蝶"}, {"type": "subtitle", "time": 21051.03, "timestamp": "05:50:51", "text": "或者眼镜。我非常乐意拥有"}, {"type": "subtitle", "time": 21053.03, "timestamp": "05:50:53", "text": "眼镜。"}]
[{"type": "subtitle", "time": 3903.589, "timestamp": "01:05:03", "text": "道德。"}, {"type": "subtitle", "time": 3906.15, "timestamp": "01:05:06", "text": "哪个岛？请具体说明。有"}, {"type": "subtitle", "time": 3908.549, "timestamp": "01:05:08", "text": "就像无数个岛屿。没关系。展示"}, {"type": "subtitle", "time": 3914.23, "timestamp": "01:05:14", "text": "她来自南方。由维瓦尔发送"}, {"type": "subtitle", "time": 3917.029, "timestamp": "01:05:17", "text": "酒庄将负责送货。这座桥是"}, {"type": "subtitle", "time": 3919.67, "timestamp": "01:05:19", "text": "路面湿滑，所以手推车翻了。"}, {"type": "subtitle", "time": 3921.67, "timestamp": "01:05:21", "text": "一些卑鄙之徒毁了这个可怜的人。"}, {"type": "subtitle", "time": 3924.71, "timestamp": "01:05:24", "text": "物品的货物和行李。"}, {"type": "subtitle", "time": 3927.27, "timestamp": "01:05:27", "text": "我将尽快重新申请旅行许可。"}, {"type": "subtitle", "time": 3929.43, "timestamp": "01:05:29", "text": "但孩子受到了很大的惊吓。"}, {"type": "subtitle", "time": 3930.23, "timestamp": "01:05:30", "text": "哦，我的孩子。"}, {"type": "subtitle", "time": 3933.27, "timestamp": "01:05:33", "text": "请怜悯这可怜的小家伙。"}, {"type": "subtitle", "time": 3935.109, "timestamp": "01:05:35", "text": "我看到了。"}, {"type": "subtitle", "time": 3943.589, "timestamp": "01:05:43", "text": "做出悲伤的表情。"}, {"type": "subtitle", "time": 3945.589, "timestamp": "01:05:45", "text": "你为什么哭？"}, {"type": "subtitle", "time": 3948.39, "timestamp": "01:05:48", "text": "该死。首领从来没告诉我们该如何应对"}, {"type": "subtitle", "time": 3951.19, "timestamp": "01:05:51", "text": "一群泪流满面的年轻女子。"}, {"type": "subtitle", "time": 3953.029, "timestamp": "01:05:53", "text": "这本来是一件很简单的事。"}, {"type": "subtitle", "time": 3955.27, "timestamp": "01:05:55", "text": "过去的事了，卡米拉小姐，但你知道的。"}, {"type": "subtitle", "time": 3958.95, "timestamp": "01:05:58", "text": "最近那把叉子晃动了一下，或者是什么事。"}]
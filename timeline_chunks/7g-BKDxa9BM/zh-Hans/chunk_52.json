[{"type": "subtitle", "time": 3125.589, "timestamp": "00:52:05", "text": "A，她太酷了。"}, {"type": "subtitle", "time": 3127.51, "timestamp": "00:52:07", "text": "向敌人寻求帮助。"}, {"type": "subtitle", "time": 3128.069, "timestamp": "00:52:08", "text": "哦，"}, {"type": "subtitle", "time": 3128.63, "timestamp": "00:52:08", "text": "好的。"}, {"type": "subtitle", "time": 3130.23, "timestamp": "00:52:10", "text": "你可以扮演敌人。"}, {"type": "subtitle", "time": 3132.15, "timestamp": "00:52:12", "text": "它还没有完全鼓掌。"}, {"type": "subtitle", "time": 3134.79, "timestamp": "00:52:14", "text": "我们今天要去冒险吗？你"}, {"type": "subtitle", "time": 3137.51, "timestamp": "00:52:17", "text": "你已经为我铺好了路。"}, {"type": "subtitle", "time": 3138.47, "timestamp": "00:52:18", "text": "我们走吧。"}, {"type": "subtitle", "time": 3140.23, "timestamp": "00:52:20", "text": "是的，她穿着"}, {"type": "subtitle", "time": 3143.12, "timestamp": "00:52:23", "text": "罪人在哪里？"}, {"type": "subtitle", "time": 3145.99, "timestamp": "00:52:25", "text": "[音乐]"}, {"type": "subtitle", "time": 3147.109, "timestamp": "00:52:27", "text": "这非常微妙"}, {"type": "subtitle", "time": 3148.549, "timestamp": "00:52:28", "text": "局外人。"}, {"type": "subtitle", "time": 3150.309, "timestamp": "00:52:30", "text": "哦，你也可以扮演兰迪。"}, {"type": "subtitle", "time": 3160.39, "timestamp": "00:52:40", "text": "提升主技能等级难道不是理想之选吗？"}, {"type": "subtitle", "time": 3161.99, "timestamp": "00:52:41", "text": "特点？"}, {"type": "subtitle", "time": 3163.51, "timestamp": "00:52:43", "text": "我不知道。我从来没玩过这个游戏。"}, {"type": "subtitle", "time": 3166.15, "timestamp": "00:52:46", "text": "游戏，所以我很困惑。"}, {"type": "subtitle", "time": 3168.71, "timestamp": "00:52:48", "text": "诚实地，"}, {"type": "subtitle", "time": 3172.309, "timestamp": "00:52:52", "text": "那我把它调到五级。我的意思是，"}, {"type": "subtitle", "time": 3174.069, "timestamp": "00:52:54", "text": "我没必要着急。"}, {"type": "subtitle", "time": 3176.39, "timestamp": "00:52:56", "text": "对于今天的，"}, {"type": "subtitle", "time": 3178.47, "timestamp": "00:52:58", "text": "正确的？"}]
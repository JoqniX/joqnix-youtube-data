[{"type": "subtitle", "time": 21723.75, "timestamp": "06:02:03", "text": "搞定一个。我找到了一封关于他的信。得到"}, {"type": "subtitle", "time": 21725.75, "timestamp": "06:02:05", "text": "它。另外两名成员"}, {"type": "subtitle", "time": 21727.99, "timestamp": "06:02:07", "text": "被遗忘者可能就在我所在的区域。"}, {"type": "subtitle", "time": 21728.948, "timestamp": "06:02:08", "text": "标记。"}]
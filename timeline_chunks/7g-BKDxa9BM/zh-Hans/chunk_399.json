[{"type": "subtitle", "time": 23940.788, "timestamp": "06:39:00", "text": "那是什么？"}, {"type": "subtitle", "time": 23942.708, "timestamp": "06:39:02", "text": "现在，最艰难的时刻即将到来。"}, {"type": "subtitle", "time": 23951.91, "timestamp": "06:39:11", "text": "不，它其实并不空。它之前"}, {"type": "subtitle", "time": 23954.468, "timestamp": "06:39:14", "text": "粉末。亨里克为什么要费心放一个"}, {"type": "subtitle", "time": 23954.788, "timestamp": "06:39:14", "text": "B？"}, {"type": "subtitle", "time": 23975.83, "timestamp": "06:39:35", "text": "我全身都遮盖住了。"}, {"type": "subtitle", "time": 23978.788, "timestamp": "06:39:38", "text": "菲娜无论如何都会做出一个f。"}, {"type": "subtitle", "time": 23987.91, "timestamp": "06:39:47", "text": "这么大的炉子。"}, {"type": "subtitle", "time": 23990.708, "timestamp": "06:39:50", "text": "决不。它是用来烹饪的。沉睡"}, {"type": "subtitle", "time": 23994.39, "timestamp": "06:39:54", "text": "项目。 9月3日。卡罗琳娜·布朗。"}, {"type": "subtitle", "time": 23995.43, "timestamp": "06:39:55", "text": "什么？"}, {"type": "subtitle", "time": 23999.75, "timestamp": "06:39:59", "text": "打猎。 11月25日。"}]
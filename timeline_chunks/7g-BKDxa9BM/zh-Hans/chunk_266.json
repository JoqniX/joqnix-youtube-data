[{"type": "subtitle", "time": 15987.75, "timestamp": "04:26:27", "text": "精神。什么？我想帮忙展示一下"}, {"type": "subtitle", "time": 15988.87, "timestamp": "04:26:28", "text": "你走吧。"}, {"type": "subtitle", "time": 15990.55, "timestamp": "04:26:30", "text": "雪知道路。"}, {"type": "subtitle", "time": 15992.63, "timestamp": "04:26:32", "text": "甘德"}, {"type": "subtitle", "time": 15995.03, "timestamp": "04:26:35", "text": "外来者很容易迷路"}, {"type": "subtitle", "time": 15995.67, "timestamp": "04:26:35", "text": "那里。"}, {"type": "subtitle", "time": 15997.75, "timestamp": "04:26:37", "text": "我欠你一个人情。好的，"}, {"type": "subtitle", "time": 15999.349, "timestamp": "04:26:39", "text": "实际上。"}, {"type": "subtitle", "time": 16003.53, "timestamp": "04:26:43", "text": "好的。前往"}, {"type": "subtitle", "time": 16011.03, "timestamp": "04:26:51", "text": "我已经很久没出门了。"}, {"type": "subtitle", "time": 16015.269, "timestamp": "04:26:55", "text": "这座城市。雪覆针叶树"}, {"type": "subtitle", "time": 16017.51, "timestamp": "04:26:57", "text": "找到那条蛇"}, {"type": "subtitle", "time": 16019.51, "timestamp": "04:26:59", "text": "山峰耸立"}]
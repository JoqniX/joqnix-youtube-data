[{"type": "subtitle", "time": 9182.23, "timestamp": "02:33:02", "text": "我的天，居然还有这种东西。"}, {"type": "subtitle", "time": 9189.11, "timestamp": "02:33:09", "text": "好的。好的，下次我会的"}, {"type": "subtitle", "time": 9192.95, "timestamp": "02:33:12", "text": "真的去做。哦，"}, {"type": "subtitle", "time": 9199.83, "timestamp": "02:33:19", "text": "哦，等等。"}, {"type": "subtitle", "time": 9201.349, "timestamp": "02:33:21", "text": "炼狱。"}, {"type": "subtitle", "time": 9209.349, "timestamp": "02:33:29", "text": "[音乐]"}, {"type": "subtitle", "time": 9211.67, "timestamp": "02:33:31", "text": "你知道吗？我去休息一下。"}, {"type": "subtitle", "time": 9213.75, "timestamp": "02:33:33", "text": "一会儿。"}, {"type": "subtitle", "time": 9216.389, "timestamp": "02:33:36", "text": "我去吃晚饭了。嗯，是的。"}, {"type": "subtitle", "time": 9220.23, "timestamp": "02:33:40", "text": "吃过早餐，一会儿就进来。"}, {"type": "subtitle", "time": 9222.07, "timestamp": "02:33:42", "text": "好的，"}]
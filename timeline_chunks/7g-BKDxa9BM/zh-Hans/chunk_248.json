[{"type": "subtitle", "time": 14881.429, "timestamp": "04:08:01", "text": "这群家伙走投无路了，决定"}, {"type": "subtitle", "time": 14882.87, "timestamp": "04:08:02", "text": "执行目标操作。"}, {"type": "subtitle", "time": 14883.59, "timestamp": "04:08:03", "text": "兄弟，"}, {"type": "subtitle", "time": 14885.59, "timestamp": "04:08:05", "text": "必须在目标人物遇难之前救出他。"}, {"type": "subtitle", "time": 14887.83, "timestamp": "04:08:07", "text": "晚的。"}, {"type": "subtitle", "time": 14890.309, "timestamp": "04:08:10", "text": "好的，"}, {"type": "subtitle", "time": 14902.63, "timestamp": "04:08:22", "text": "离我远点。"}, {"type": "subtitle", "time": 14905.51, "timestamp": "04:08:25", "text": "不要恐慌。我们是猎狐者。是"}, {"type": "subtitle", "time": 14908.389, "timestamp": "04:08:28", "text": "来救你的。"}, {"type": "subtitle", "time": 14911.269, "timestamp": "04:08:31", "text": "哦，我明白了。他们一定是派你来的。"}, {"type": "subtitle", "time": 14914.229, "timestamp": "04:08:34", "text": "这里。谢谢。我们离开这里吧"}, {"type": "chat", "time": 14922.537, "timestamp": "04:08:42", "author": "@miko_chann.1", "avatar": "https://yt4.ggpht.com/pA1qKxvA6gJkJo5iacL6MoaaocqRqPaKMbOHlznwOHpCJPPZbIU3_GNZ4faHtUzgYCNGbiZs1w=s64-c-k-c0x00ffffff-no-rj", "message": "haiiii JOQ"}]
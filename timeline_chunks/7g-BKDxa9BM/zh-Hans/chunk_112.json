[{"type": "subtitle", "time": 6739.589, "timestamp": "01:52:19", "text": "水仙花就在南边。"}, {"type": "subtitle", "time": 6741.99, "timestamp": "01:52:21", "text": "快点。雪将在等着你"}, {"type": "subtitle", "time": 6747.35, "timestamp": "01:52:27", "text": "在哪里？"}, {"type": "subtitle", "time": 6749.43, "timestamp": "01:52:29", "text": "您的旅行证件。"}, {"type": "subtitle", "time": 6754.87, "timestamp": "01:52:34", "text": "你是聋子吗？呃，对不起，先生。我有点"}, {"type": "subtitle", "time": 6760.229, "timestamp": "01:52:40", "text": "哦，"}, {"type": "subtitle", "time": 6761.51, "timestamp": "01:52:41", "text": "这是你吗？"}, {"type": "subtitle", "time": 6765.589, "timestamp": "01:52:45", "text": "是的。为什么它看起来更像一个“为什么”"}]
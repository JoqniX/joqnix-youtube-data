[{"type": "subtitle", "time": 16981.19, "timestamp": "04:43:01", "text": "你刚才叫我什么？真没礼貌。"}, {"type": "subtitle", "time": 16982.31, "timestamp": "04:43:02", "text": "她就像是，"}, {"type": "subtitle", "time": 16985.51, "timestamp": "04:43:05", "text": "粗鲁的。我只是实话实说。我的心是"}, {"type": "subtitle", "time": 16987.27, "timestamp": "04:43:07", "text": "真实可靠。"}, {"type": "subtitle", "time": 16990.868, "timestamp": "04:43:10", "text": "我不会简单地把觉醒说成是一个阶段。"}, {"type": "subtitle", "time": 16993.43, "timestamp": "04:43:13", "text": "卡伦经历的世界"}, {"type": "subtitle", "time": 16994.788, "timestamp": "04:43:14", "text": "醒来之后。"}, {"type": "subtitle", "time": 16997.19, "timestamp": "04:43:17", "text": "就是那一刻。"}, {"type": "subtitle", "time": 16999.99, "timestamp": "04:43:19", "text": "难怪我感觉比以前轻松多了。"}, {"type": "subtitle", "time": 17003.11, "timestamp": "04:43:23", "text": "我的伤势以及我的魔法能力。"}, {"type": "subtitle", "time": 17004.55, "timestamp": "04:43:24", "text": "谐振。"}, {"type": "subtitle", "time": 17006.31, "timestamp": "04:43:26", "text": "Wa 参考。"}, {"type": "subtitle", "time": 17009.11, "timestamp": "04:43:29", "text": "恶魔十分罕见。你们真幸运。"}, {"type": "subtitle", "time": 17012.948, "timestamp": "04:43:32", "text": "鸭子。大多数卡隆就没有那么幸运了。在"}, {"type": "subtitle", "time": 17015.83, "timestamp": "04:43:35", "text": "最好是，它们只会变得更坚固一些。它是"}, {"type": "subtitle", "time": 17017.99, "timestamp": "04:43:37", "text": "据说有些甚至会变得可怕。"}, {"type": "subtitle", "time": 17020.23, "timestamp": "04:43:40", "text": "虽然我从未见过怪物。"}, {"type": "subtitle", "time": 17022.628, "timestamp": "04:43:42", "text": "我。"}, {"type": "subtitle", "time": 17025.27, "timestamp": "04:43:45", "text": "蘑菇几乎覆盖了大部分区域。"}, {"type": "subtitle", "time": 17026.47, "timestamp": "04:43:46", "text": "蘑菇。"}, {"type": "subtitle", "time": 17027.59, "timestamp": "04:43:47", "text": "普通汽车。"}, {"type": "subtitle", "time": 17028.868, "timestamp": "04:43:48", "text": "他们只是在尝试。"}, {"type": "subtitle", "time": 17030.55, "timestamp": "04:43:50", "text": "不，"}, {"type": "subtitle", "time": 17032.39, "timestamp": "04:43:52", "text": "我会晚点回来，然后……"}, {"type": "subtitle", "time": 17035.03, "timestamp": "04:43:55", "text": "独自的。不"}, {"type": "subtitle", "time": 17038.31, "timestamp": "04:43:58", "text": "好的，明白了。局外人。"}]
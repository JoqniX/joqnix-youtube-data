[{"type": "subtitle", "time": 1707.19, "timestamp": "00:28:27", "text": "这里似乎以前有人住过。"}, {"type": "subtitle", "time": 1707.83, "timestamp": "00:28:27", "text": "这是你的"}, {"type": "subtitle", "time": 1715.19, "timestamp": "00:28:35", "text": "哦，书。"}, {"type": "subtitle", "time": 1720.63, "timestamp": "00:28:40", "text": "是的。"}, {"type": "subtitle", "time": 1724.07, "timestamp": "00:28:44", "text": "不，那是我们的家。"}, {"type": "subtitle", "time": 1726.549, "timestamp": "00:28:46", "text": "我们的家？"}, {"type": "subtitle", "time": 1729.269, "timestamp": "00:28:49", "text": "但我什么都不记得了。"}, {"type": "subtitle", "time": 1732.47, "timestamp": "00:28:52", "text": "没关系。或许一切都是最好的安排。"}, {"type": "subtitle", "time": 1734.149, "timestamp": "00:28:54", "text": "成功脱身之后。我们将建造一个新的"}]
[{"type": "subtitle", "time": 1200.23, "timestamp": "00:20:00", "text": "什么？什么？"}, {"type": "subtitle", "time": 1232.87, "timestamp": "00:20:32", "text": "感觉像是在玩《星际战甲》。"}, {"type": "subtitle", "time": 1235.51, "timestamp": "00:20:35", "text": "你连一艘船都没留下。"}, {"type": "subtitle", "time": 1236.95, "timestamp": "00:20:36", "text": "你当时在村子里……"}, {"type": "subtitle", "time": 1239.75, "timestamp": "00:20:39", "text": "那些肮脏之徒来了，对吧？如果"}, {"type": "subtitle", "time": 1242.549, "timestamp": "00:20:42", "text": "不是为了回来找我，你可以"}, {"type": "subtitle", "time": 1244.789, "timestamp": "00:20:44", "text": "和他们一起逃走了。"}, {"type": "subtitle", "time": 1246.71, "timestamp": "00:20:46", "text": "别傻了。你也会这么做的。"}, {"type": "subtitle", "time": 1249.27, "timestamp": "00:20:49", "text": "为我。我们沿着海岸线寻找吧。"}]
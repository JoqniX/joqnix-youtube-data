[{"type": "subtitle", "time": 13981.429, "timestamp": "03:53:01", "text": "你好。请问？"}, {"type": "subtitle", "time": 13981.91, "timestamp": "03:53:01", "text": "嘘。"}, {"type": "subtitle", "time": 13983.91, "timestamp": "03:53:03", "text": "安静点。"}, {"type": "subtitle", "time": 13987.429, "timestamp": "03:53:07", "text": "把那些秘密藏起来，期待会有回报。"}, {"type": "subtitle", "time": 13993.349, "timestamp": "03:53:13", "text": "哦，我的错。所以，你来这里也是为了……"}, {"type": "subtitle", "time": 13996.87, "timestamp": "03:53:16", "text": "是的。什么？你们也一样？首先，"}, {"type": "subtitle", "time": 14001.75, "timestamp": "03:53:21", "text": "先到先得。没有线路。"}, {"type": "subtitle", "time": 14004.15, "timestamp": "03:53:24", "text": "甚至还有人排队。"}, {"type": "subtitle", "time": 14007.269, "timestamp": "03:53:27", "text": "我的意思是，它太大了。足够了"}, {"type": "subtitle", "time": 14009.51, "timestamp": "03:53:29", "text": "每个人。"}, {"type": "subtitle", "time": 14011.75, "timestamp": "03:53:31", "text": "好吧，我们就在一旁观看吧。"}, {"type": "subtitle", "time": 14014.309, "timestamp": "03:53:34", "text": "场边。完成后，我们将……"}, {"type": "subtitle", "time": 14016.95, "timestamp": "03:53:36", "text": "仔细看看。"}, {"type": "subtitle", "time": 14019.75, "timestamp": "03:53:39", "text": "为什么我觉得你好像没在说话"}, {"type": "subtitle", "time": 14022.71, "timestamp": "03:53:42", "text": "差不多是同一件事？"}, {"type": "subtitle", "time": 14025.349, "timestamp": "03:53:45", "text": "还能是什么呢？任何来的人"}, {"type": "subtitle", "time": 14029.429, "timestamp": "03:53:49", "text": "这里显然是为了"}, {"type": "subtitle", "time": 14034.87, "timestamp": "03:53:54", "text": "现在。拉绳子。"}]
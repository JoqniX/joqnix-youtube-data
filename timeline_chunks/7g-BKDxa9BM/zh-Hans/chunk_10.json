[{"type": "subtitle", "time": 613.99, "timestamp": "00:10:13", "text": "这附近有隐藏的宝箱吗？"}, {"type": "subtitle", "time": 616.79, "timestamp": "00:10:16", "text": "你好。没有胸部。我喜欢这种方式"}, {"type": "subtitle", "time": 619.03, "timestamp": "00:10:19", "text": "角色一直跟着我。这就像某种……"}, {"type": "subtitle", "time": 622.71, "timestamp": "00:10:22", "text": "有点像那种线上的东西，对吧？"}, {"type": "subtitle", "time": 624.87, "timestamp": "00:10:24", "text": "所以，你扮演你的主角或者其他什么角色。"}, {"type": "subtitle", "time": 627.75, "timestamp": "00:10:27", "text": "一个角色，每个你都是NPC或"}, {"type": "subtitle", "time": 629.43, "timestamp": "00:10:29", "text": "同伴角色会跟随你。"}, {"type": "subtitle", "time": 632.31, "timestamp": "00:10:32", "text": "太酷了。"}, {"type": "subtitle", "time": 634.87, "timestamp": "00:10:34", "text": "兄弟，这太酷了。我喜欢这个"}, {"type": "subtitle", "time": 637.75, "timestamp": "00:10:37", "text": "灯光。"}, {"type": "subtitle", "time": 651.43, "timestamp": "00:10:51", "text": "并留下控制和空间。"}, {"type": "subtitle", "time": 655.03, "timestamp": "00:10:55", "text": "兄弟，为什么感觉像在玩Warframe？"}, {"type": "subtitle", "time": 656.71, "timestamp": "00:10:56", "text": "我没事。它是"}, {"type": "subtitle", "time": 659.99, "timestamp": "00:10:59", "text": "为什么感觉像《星际战甲》（Warframe）？"}]
[{"type": "subtitle", "time": 17824.07, "timestamp": "04:57:04", "text": "我会帮你解锁。游戏结束。不用担心。"}, {"type": "subtitle", "time": 17826.55, "timestamp": "04:57:06", "text": "我会找到你的。"}, {"type": "subtitle", "time": 17839.91, "timestamp": "04:57:19", "text": "你好，外来者。奥迪。"}, {"type": "subtitle", "time": 17842.55, "timestamp": "04:57:22", "text": "是时候进入正题了。"}, {"type": "subtitle", "time": 17850.868, "timestamp": "04:57:30", "text": "对不起，我拿走了你的水晶。我不得不"}, {"type": "subtitle", "time": 17852.23, "timestamp": "04:57:32", "text": "这样做我们就可以私下谈话了。"}, {"type": "subtitle", "time": 17853.43, "timestamp": "04:57:33", "text": "这里。"}, {"type": "subtitle", "time": 17856.15, "timestamp": "04:57:36", "text": "不，她没事。那个小按钮"}, {"type": "subtitle", "time": 17857.91, "timestamp": "04:57:37", "text": "蘑菇满嘴跑火车，但我却……"}, {"type": "subtitle", "time": 17859.43, "timestamp": "04:57:39", "text": "看到她进出许普诺斯酒吧"}, {"type": "subtitle", "time": 17861.75, "timestamp": "04:57:41", "text": "房子。我不知道她是不是只是我会"}, {"type": "subtitle", "time": 17863.99, "timestamp": "04:57:43", "text": "开门见山。我不信任亨里克"}, {"type": "subtitle", "time": 17865.11, "timestamp": "04:57:45", "text": "埃塞尔德。"}, {"type": "subtitle", "time": 17866.39, "timestamp": "04:57:46", "text": "有点蹊跷。"}, {"type": "subtitle", "time": 17867.91, "timestamp": "04:57:47", "text": "你对水晶了解多少？"}, {"type": "subtitle", "time": 17870.55, "timestamp": "04:57:50", "text": "斯特拉？他想要的东西。他们是"}, {"type": "subtitle", "time": 17871.91, "timestamp": "04:57:51", "text": "美丽的石头很受欢迎"}, {"type": "subtitle", "time": 17873.67, "timestamp": "04:57:53", "text": "他们的外貌。曾经有一场严重的"}, {"type": "subtitle", "time": 17875.59, "timestamp": "04:57:55", "text": "一起涉及医疗事故的案件"}, {"type": "subtitle", "time": 17877.27, "timestamp": "04:57:57", "text": "弗拉格森的斯特拉尔水晶"}]
[{"type": "subtitle", "time": 12722.229, "timestamp": "03:32:02", "text": "换个平台挺好的。哦，等等，等等，等等"}, {"type": "subtitle", "time": 12725.429, "timestamp": "03:32:05", "text": "等待。家园。"}, {"type": "subtitle", "time": 12735.91, "timestamp": "03:32:15", "text": "然后我就再也不碰这个游戏了。"}, {"type": "subtitle", "time": 12743.429, "timestamp": "03:32:23", "text": "糟糕。哦，又是一朵黑色的花。我们开始吧"}, {"type": "subtitle", "time": 12747.349, "timestamp": "03:32:27", "text": "去。我得到了两朵黑色的花。"}, {"type": "subtitle", "time": 12750.07, "timestamp": "03:32:30", "text": "剩下的碎屑。好的。"}, {"type": "subtitle", "time": 12754.95, "timestamp": "03:32:34", "text": "剩下的边角料。好的。呃"}, {"type": "subtitle", "time": 12756.95, "timestamp": "03:32:36", "text": "等等，稍等。那是黑色的"}, {"type": "subtitle", "time": 12759.349, "timestamp": "03:32:39", "text": "花？"}, {"type": "subtitle", "time": 12769.429, "timestamp": "03:32:49", "text": "等等，等等，等等。那是一朵黑色的花。"}]
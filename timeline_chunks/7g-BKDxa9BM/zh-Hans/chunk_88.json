[{"type": "subtitle", "time": 5280.629, "timestamp": "01:28:00", "text": "你从哪来？"}, {"type": "subtitle", "time": 5284.47, "timestamp": "01:28:04", "text": "你的穿着打扮我还是第一次见。"}, {"type": "subtitle", "time": 5289.83, "timestamp": "01:28:09", "text": "位于遥远南方的一个小岛。"}, {"type": "subtitle", "time": 5291.669, "timestamp": "01:28:11", "text": "南方。"}, {"type": "subtitle", "time": 5293.75, "timestamp": "01:28:13", "text": "我知道这。"}, {"type": "subtitle", "time": 5295.91, "timestamp": "01:28:15", "text": "这是一个有四个人的地方。"}, {"type": "subtitle", "time": 5297.83, "timestamp": "01:28:17", "text": "我刚刚意识到背景音乐是"}, {"type": "subtitle", "time": 5311.51, "timestamp": "01:28:31", "text": "你饿了吗？"}, {"type": "subtitle", "time": 5314.229, "timestamp": "01:28:34", "text": "我去给你弄点吃的。没错"}, {"type": "subtitle", "time": 5316.95, "timestamp": "01:28:36", "text": "后退。"}, {"type": "subtitle", "time": 5319.75, "timestamp": "01:28:39", "text": "她很漂亮。"}, {"type": "subtitle", "time": 5321.43, "timestamp": "01:28:41", "text": "谁会想到会有如此粗鲁无礼的人呢？"}, {"type": "subtitle", "time": 5323.11, "timestamp": "01:28:43", "text": "阴郁的旅店老板会拥有如此美好的"}, {"type": "subtitle", "time": 5326.47, "timestamp": "01:28:46", "text": "还有个帮他干活的乐于助人的孩子？"}, {"type": "subtitle", "time": 5328.95, "timestamp": "01:28:48", "text": "多亏了她，我们终于找到了住处。"}, {"type": "subtitle", "time": 5331.83, "timestamp": "01:28:51", "text": "留下来。我们休息一会儿吧。我相当"}]
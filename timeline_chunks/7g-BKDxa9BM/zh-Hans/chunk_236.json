[{"type": "subtitle", "time": 14161.429, "timestamp": "03:56:01", "text": "伙伴。感谢您帮助我们拯救"}, {"type": "subtitle", "time": 14164.15, "timestamp": "03:56:04", "text": "驱赶精灵，赶走那些精灵"}, {"type": "subtitle", "time": 14165.269, "timestamp": "03:56:05", "text": "猎人。"}, {"type": "subtitle", "time": 14168.15, "timestamp": "03:56:08", "text": "精灵猎人。"}, {"type": "subtitle", "time": 14170.87, "timestamp": "03:56:10", "text": "是的。后面那几个家伙。他们经过"}, {"type": "subtitle", "time": 14173.03, "timestamp": "03:56:13", "text": "名字"}, {"type": "subtitle", "time": 14174.55, "timestamp": "03:56:14", "text": "听起来一点也不酷。"}, {"type": "subtitle", "time": 14176.63, "timestamp": "03:56:16", "text": "我喜欢帽子上的配饰。"}, {"type": "subtitle", "time": 14178.229, "timestamp": "03:56:18", "text": "他们能找到的每一个精灵。"}, {"type": "subtitle", "time": 14180.229, "timestamp": "03:56:20", "text": "看看那东西上的丝带。"}, {"type": "subtitle", "time": 14181.83, "timestamp": "03:56:21", "text": "关于基因。"}, {"type": "subtitle", "time": 14183.99, "timestamp": "03:56:23", "text": "还有这个。这小家伙太可爱了。"}, {"type": "subtitle", "time": 14185.75, "timestamp": "03:56:25", "text": "各种各样的物种。"}, {"type": "subtitle", "time": 14187.349, "timestamp": "03:56:27", "text": "看看"}, {"type": "subtitle", "time": 14190.07, "timestamp": "03:56:30", "text": "zi 类似的东西。哦，瞧。它在挥手"}, {"type": "subtitle", "time": 14193.14, "timestamp": "03:56:33", "text": "你的手。哇。"}, {"type": "subtitle", "time": 14194.63, "timestamp": "03:56:34", "text": "[音乐]"}, {"type": "subtitle", "time": 14195.75, "timestamp": "03:56:35", "text": "智慧。好的。"}, {"type": "subtitle", "time": 14199.03, "timestamp": "03:56:39", "text": "确切地。你这么快就明白了。"}, {"type": "subtitle", "time": 14202.15, "timestamp": "03:56:42", "text": "你一定非常聪明。"}, {"type": "subtitle", "time": 14204.63, "timestamp": "03:56:44", "text": "总之，我是在一本书里读到这件事的。"}, {"type": "subtitle", "time": 14206.55, "timestamp": "03:56:46", "text": "神奇妈妈们利用了这种力量。"}, {"type": "subtitle", "time": 14209.51, "timestamp": "03:56:49", "text": "哦，她有一双像星星一样的眼睛。"}, {"type": "subtitle", "time": 14213.03, "timestamp": "03:56:53", "text": "适应不同的环境。"}, {"type": "subtitle", "time": 14215.91, "timestamp": "03:56:55", "text": "就像它们在火堆旁待得太近一样，"}, {"type": "subtitle", "time": 14219.189, "timestamp": "03:56:59", "text": "它们会变成香喷喷的蓬松小球。"}]
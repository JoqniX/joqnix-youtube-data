[{"type": "subtitle", "time": 11705.83, "timestamp": "03:15:05", "text": "这其中有充分的理由。我"}, {"type": "subtitle", "time": 11707.83, "timestamp": "03:15:07", "text": "我现在只想吃一块"}, {"type": "subtitle", "time": 11709.91, "timestamp": "03:15:09", "text": "安心。"}, {"type": "subtitle", "time": 11713.19, "timestamp": "03:15:13", "text": "我只想完成每日任务，我"}, {"type": "subtitle", "time": 11716.07, "timestamp": "03:15:16", "text": "我打算晚上再来做。"}, {"type": "subtitle", "time": 11719.75, "timestamp": "03:15:19", "text": "好的。所以，我为那些……感到抱歉。"}, {"type": "subtitle", "time": 11722.07, "timestamp": "03:15:22", "text": "去看我玩《蓝色协议》"}, {"type": "subtitle", "time": 11724.71, "timestamp": "03:15:24", "text": "接下来的10分钟。我非常抱歉。我"}, {"type": "subtitle", "time": 11728.229, "timestamp": "03:15:28", "text": "我这就道歉。"}, {"type": "subtitle", "time": 11730.07, "timestamp": "03:15:30", "text": "但我想说，我只想做我的"}, {"type": "subtitle", "time": 11731.59, "timestamp": "03:15:31", "text": "每日新闻。我昨天没能做到。我"}, {"type": "subtitle", "time": 11734.55, "timestamp": "03:15:34", "text": "昨天工作了6个小时。"}, {"type": "subtitle", "time": 11737.269, "timestamp": "03:15:37", "text": "正确的。我们直播了7个小时。"}, {"type": "subtitle", "time": 11738.79, "timestamp": "03:15:38", "text": "昨天。"}, {"type": "subtitle", "time": 11742.469, "timestamp": "03:15:42", "text": "别忘了。 H. 好的。我会连接我的"}]
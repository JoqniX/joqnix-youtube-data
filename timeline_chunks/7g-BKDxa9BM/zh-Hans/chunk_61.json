[{"type": "subtitle", "time": 3697.51, "timestamp": "01:01:37", "text": "你玩扭蛋游戏吗？我玩原神。"}, {"type": "subtitle", "time": 3699.43, "timestamp": "01:01:39", "text": "瓦尔"}, {"type": "subtitle", "time": 3701.27, "timestamp": "01:01:41", "text": "还有一些其他的东西。我刚刚停止玩游戏了。"}, {"type": "subtitle", "time": 3703.589, "timestamp": "01:01:43", "text": "原神。"}, {"type": "subtitle", "time": 3707.829, "timestamp": "01:01:47", "text": "我很少玩《翼浪》。"}, {"type": "subtitle", "time": 3716.549, "timestamp": "01:01:56", "text": "我玩原神玩腻了，一直刷刷刷的。"}, {"type": "subtitle", "time": 3718.71, "timestamp": "01:01:58", "text": "太多了，而且"}]
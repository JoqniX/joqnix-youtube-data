[{"type": "subtitle", "time": 17401.03, "timestamp": "04:50:01", "text": "人们起来了。"}, {"type": "subtitle", "time": 17403.11, "timestamp": "04:50:03", "text": "我只希望他不会太苛刻。"}, {"type": "subtitle", "time": 17406.15, "timestamp": "04:50:06", "text": "精神。至于这是否是我的最后一次"}, {"type": "subtitle", "time": 17409.11, "timestamp": "04:50:09", "text": "那天晚上在那栋房子里，我需要……"}, {"type": "subtitle", "time": 17410.47, "timestamp": "04:50:10", "text": "局外人。"}, {"type": "subtitle", "time": 17412.15, "timestamp": "04:50:12", "text": "你们俩要保守这个秘密。"}, {"type": "subtitle", "time": 17414.708, "timestamp": "04:50:14", "text": "没跟我说话，是吗？那"}, {"type": "subtitle", "time": 17417.83, "timestamp": "04:50:17", "text": "局外人已经是过去式了。"}, {"type": "subtitle", "time": 17421.11, "timestamp": "04:50:21", "text": "我才不在乎。走吧。我要走了"}]
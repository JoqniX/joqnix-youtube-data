[{"type": "subtitle", "time": 247.50900000000001, "timestamp": "00:04:07", "text": "好了，就是这样。"}, {"type": "subtitle", "time": 250.55, "timestamp": "00:04:10", "text": "嗯，晚上好，詹姆斯·贾格尔。欢迎"}, {"type": "subtitle", "time": 252.309, "timestamp": "00:04:12", "text": "在。"}, {"type": "subtitle", "time": 255.67, "timestamp": "00:04:15", "text": "晚上好。早上好。"}, {"type": "subtitle", "time": 266.469, "timestamp": "00:04:26", "text": "亚洲。有人建议我去亚洲服务器玩。"}, {"type": "subtitle", "time": 269.35, "timestamp": "00:04:29", "text": "等等，什么？另外，服务器是不是刚刚"}, {"type": "subtitle", "time": 276.79, "timestamp": "00:04:36", "text": "等等，已经出来了。不是7点30分。他们"}, {"type": "subtitle", "time": 280.55, "timestamp": "00:04:40", "text": "大门已经打开了。"}, {"type": "subtitle", "time": 282.71, "timestamp": "00:04:42", "text": "等等，什么？"}, {"type": "subtitle", "time": 288.15, "timestamp": "00:04:48", "text": "哦，有人在玩这个游戏。好的，好的。"}, {"type": "subtitle", "time": 291.51, "timestamp": "00:04:51", "text": "好的。迟到了。"}, {"type": "subtitle", "time": 294.87, "timestamp": "00:04:54", "text": "我迟到了。搞什么鬼？"}, {"type": "subtitle", "time": 296.469, "timestamp": "00:04:56", "text": "让我查一下。让我查一下。让我"}]
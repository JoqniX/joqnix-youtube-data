[{"type": "subtitle", "time": 15422.55, "timestamp": "04:17:02", "text": "等等，这些不就像秘密信件吗？"}, {"type": "subtitle", "time": 15444.87, "timestamp": "04:17:24", "text": "我好像没办法把她锁起来。"}, {"type": "subtitle", "time": 15448.469, "timestamp": "04:17:28", "text": "你好，我是食品供应员松露。"}, {"type": "subtitle", "time": 15451.51, "timestamp": "04:17:31", "text": "我的忠实追随者们一直陪伴在我身边。"}, {"type": "subtitle", "time": 15464.95, "timestamp": "04:17:44", "text": "她是水力发电。好的。"}, {"type": "subtitle", "time": 15467.67, "timestamp": "04:17:47", "text": "我没有攀登所需的材料。"}, {"type": "subtitle", "time": 15474.71, "timestamp": "04:17:54", "text": "她还没来。搬迁和勘探。"}]
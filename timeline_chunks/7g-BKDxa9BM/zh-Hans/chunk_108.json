[{"type": "subtitle", "time": 6480.39, "timestamp": "01:48:00", "text": "是的。"}, {"type": "subtitle", "time": 6482.07, "timestamp": "01:48:02", "text": "这就解释得通了。"}, {"type": "subtitle", "time": 6484.47, "timestamp": "01:48:04", "text": "在我所有的旅行中，我们都拥有相似的经历。"}, {"type": "subtitle", "time": 6486.07, "timestamp": "01:48:06", "text": "外貌。"}, {"type": "subtitle", "time": 6489.189, "timestamp": "01:48:09", "text": "每个人都和我一样漂亮。我们"}, {"type": "subtitle", "time": 6491.83, "timestamp": "01:48:11", "text": "活得非常长寿。"}, {"type": "subtitle", "time": 6492.229, "timestamp": "01:48:12", "text": "哇。"}, {"type": "subtitle", "time": 6494.55, "timestamp": "01:48:14", "text": "就像铁匠大师一样，每个卢诺"}, {"type": "subtitle", "time": 6497.189, "timestamp": "01:48:17", "text": "有一项特别的强项。"}, {"type": "subtitle", "time": 6502.39, "timestamp": "01:48:22", "text": "哦，正如你所看到的，我有恶魔般的"}, {"type": "subtitle", "time": 6505.83, "timestamp": "01:48:25", "text": "我头上的附属物。没有别的了。"}, {"type": "subtitle", "time": 6508.95, "timestamp": "01:48:28", "text": "的确，在我这么多年来，我从未见过"}, {"type": "subtitle", "time": 6513.109, "timestamp": "01:48:33", "text": "月亮。我是魔王卢诺。"}, {"type": "subtitle", "time": 6514.229, "timestamp": "01:48:34", "text": "魔王。"}, {"type": "subtitle", "time": 6517.03, "timestamp": "01:48:37", "text": "可惜的是，大多数卢诺人缺乏雄心壮志。"}, {"type": "subtitle", "time": 6518.95, "timestamp": "01:48:38", "text": "他们宁愿跟随人类。我的"}, {"type": "subtitle", "time": 6521.43, "timestamp": "01:48:41", "text": "小喽啰，你得跟着我。"}, {"type": "subtitle", "time": 6523.83, "timestamp": "01:48:43", "text": "当我征服世界之后，你将成为……"}, {"type": "subtitle", "time": 6526.47, "timestamp": "01:48:46", "text": "我的军团领袖。你等着瞧吧。"}, {"type": "subtitle", "time": 6527.59, "timestamp": "01:48:47", "text": "看。"}, {"type": "subtitle", "time": 6530.95, "timestamp": "01:48:50", "text": "是的，殿下。共情。"}, {"type": "subtitle", "time": 6535.43, "timestamp": "01:48:55", "text": "哇，真独特。"}, {"type": "subtitle", "time": 6537.189, "timestamp": "01:48:57", "text": "插入"}, {"type": "subtitle", "time": 6539.51, "timestamp": "01:48:59", "text": "把你的战术商店里的物品都拿出来"}]
[{"type": "subtitle", "time": 6961.91, "timestamp": "01:56:01", "text": "放松你的拳头，我的大脑。哦，我没有"}, {"type": "subtitle", "time": 6965.83, "timestamp": "01:56:05", "text": "担心。我会理性行事。毕竟，"}, {"type": "subtitle", "time": 6969.83, "timestamp": "01:56:09", "text": "卡米拉小姐为我作证。正确的。"}, {"type": "subtitle", "time": 6972.95, "timestamp": "01:56:12", "text": "花苞就在前面。我们走吧。"}, {"type": "subtitle", "time": 6993.43, "timestamp": "01:56:33", "text": "蜂蜜。"}, {"type": "subtitle", "time": 6996.39, "timestamp": "01:56:36", "text": "蜂蜜，"}, {"type": "subtitle", "time": 7004.8, "timestamp": "01:56:44", "text": "她在哭吗？"}]
[{"type": "subtitle", "time": 18542.23, "timestamp": "05:09:02", "text": "设法收集到了一些有用的情报。"}, {"type": "subtitle", "time": 18550.07, "timestamp": "05:09:10", "text": "哦亲爱的。"}, {"type": "subtitle", "time": 18551.83, "timestamp": "05:09:11", "text": "调查进展如何？不能"}, {"type": "subtitle", "time": 18554.47, "timestamp": "05:09:14", "text": "弄清他故事的真相。但我"}, {"type": "subtitle", "time": 18556.23, "timestamp": "05:09:16", "text": "确实做了"}, {"type": "subtitle", "time": 18558.868, "timestamp": "05:09:18", "text": "所以它实际上是一家疗养院。"}, {"type": "subtitle", "time": 18560.39, "timestamp": "05:09:20", "text": "这有什么好隐瞒的？"}, {"type": "subtitle", "time": 18561.59, "timestamp": "05:09:21", "text": "正确的。"}, {"type": "subtitle", "time": 18562.788, "timestamp": "05:09:22", "text": "我还了解到"}, {"type": "subtitle", "time": 18564.15, "timestamp": "05:09:24", "text": "亨特之前身体很健康"}, {"type": "subtitle", "time": 18566.628, "timestamp": "05:09:26", "text": "消失了。"}, {"type": "subtitle", "time": 18567.35, "timestamp": "05:09:27", "text": "他们拒绝了。"}, {"type": "subtitle", "time": 18570.55, "timestamp": "05:09:30", "text": "亨里克是不是专门针对病人？"}, {"type": "subtitle", "time": 18571.99, "timestamp": "05:09:31", "text": "那是亨里克的办公室。"}, {"type": "subtitle", "time": 18573.27, "timestamp": "05:09:33", "text": "明智的决定。"}, {"type": "subtitle", "time": 18577.27, "timestamp": "05:09:37", "text": "但锁上的门并不是唯一的问题。"}, {"type": "subtitle", "time": 18579.51, "timestamp": "05:09:39", "text": "我和那里的旅馆老板聊了聊，还挖了坑。"}, {"type": "subtitle", "time": 18581.59, "timestamp": "05:09:41", "text": "透露一些情报。亨里克。"}, {"type": "subtitle", "time": 18584.708, "timestamp": "05:09:44", "text": "伟大的。所以，这就是我们的计划。你相当"}, {"type": "subtitle", "time": 18585.83, "timestamp": "05:09:45", "text": "锋利的。"}, {"type": "subtitle", "time": 18587.35, "timestamp": "05:09:47", "text": "我倒不是特别喜欢。"}, {"type": "subtitle", "time": 18590.39, "timestamp": "05:09:50", "text": "好的。接下来的几天里。"}, {"type": "subtitle", "time": 18591.59, "timestamp": "05:09:51", "text": "嘿，"}, {"type": "subtitle", "time": 18594.47, "timestamp": "05:09:54", "text": "现在还为时过早。也许我可以去"}, {"type": "subtitle", "time": 18597.03, "timestamp": "05:09:57", "text": "等等。普赛克似乎有点"}]
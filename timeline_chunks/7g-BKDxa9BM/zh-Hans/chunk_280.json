[{"type": "subtitle", "time": 16801.99, "timestamp": "04:40:01", "text": "一切都好吗？衰变具有"}, {"type": "subtitle", "time": 16808.868, "timestamp": "04:40:08", "text": "我突然看不清后背了。"}, {"type": "subtitle", "time": 16810.55, "timestamp": "04:40:10", "text": "那里。"}, {"type": "subtitle", "time": 16813.75, "timestamp": "04:40:13", "text": "好的，这个功能坏了。"}, {"type": "subtitle", "time": 16817.27, "timestamp": "04:40:17", "text": "部分部件是它的弱点。"}, {"type": "subtitle", "time": 16818.868, "timestamp": "04:40:18", "text": "呃"}, {"type": "subtitle", "time": 16822.55, "timestamp": "04:40:22", "text": "弱点障碍"}, {"type": "subtitle", "time": 16830.868, "timestamp": "04:40:30", "text": "好的。心理周期她玩起来很舒服。"}, {"type": "subtitle", "time": 16833.43, "timestamp": "04:40:33", "text": "蝴蝶。我喜欢扮演她。如何"}, {"type": "subtitle", "time": 16837.11, "timestamp": "04:40:37", "text": "我觉得我必须通关。"}, {"type": "subtitle", "time": 16838.628, "timestamp": "04:40:38", "text": "深渊。"}, {"type": "subtitle", "time": 16839.27, "timestamp": "04:40:39", "text": "这是什么？"}, {"type": "subtitle", "time": 16841.43, "timestamp": "04:40:41", "text": "美丽？难怪人人都想分一杯羹。"}, {"type": "subtitle", "time": 16841.99, "timestamp": "04:40:41", "text": "它的。"}, {"type": "subtitle", "time": 16844.788, "timestamp": "04:40:44", "text": "哦，这是你接下来可以招到的人。"}, {"type": "subtitle", "time": 16846.788, "timestamp": "04:40:46", "text": "所以，是你们干掉它的。"}, {"type": "subtitle", "time": 16850.23, "timestamp": "04:40:50", "text": "巨大的东西。感人的。"}, {"type": "subtitle", "time": 16852.708, "timestamp": "04:40:52", "text": "你好。呃，他叫什么名字来着？"}, {"type": "subtitle", "time": 16853.43, "timestamp": "04:40:53", "text": "局外人。"}, {"type": "subtitle", "time": 16856.15, "timestamp": "04:40:56", "text": "水晶就在你手中。那是我的"}, {"type": "subtitle", "time": 16858.788, "timestamp": "04:40:58", "text": "小喽啰第一个"}]
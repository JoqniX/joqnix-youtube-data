[{"type": "subtitle", "time": 2881.43, "timestamp": "00:48:01", "text": "如果你不想落得如此下场，就应该珍惜时间。"}, {"type": "subtitle", "time": 2884.47, "timestamp": "00:48:04", "text": "肮脏的饲料，跟我们来。"}, {"type": "subtitle", "time": 2887.91, "timestamp": "00:48:07", "text": "污秽的FOD。好的。很好奇如何"}, {"type": "subtitle", "time": 2890.23, "timestamp": "00:48:10", "text": "地图集的其余部分向我们展示了这一点。拿一个"}, {"type": "subtitle", "time": 2892.23, "timestamp": "00:48:12", "text": "看看我们传递的印象"}, {"type": "subtitle", "time": 2896.55, "timestamp": "00:48:16", "text": "地区。好的。所以显然这款游戏"}, {"type": "subtitle", "time": 2898.79, "timestamp": "00:48:18", "text": "因为这是我第一次……"}, {"type": "subtitle", "time": 2902.069, "timestamp": "00:48:22", "text": "玩一款扭蛋游戏，该游戏"}, {"type": "subtitle", "time": 2906.069, "timestamp": "00:48:26", "text": "嗯，对话印象方面的东西。"}, {"type": "subtitle", "time": 2909.51, "timestamp": "00:48:29", "text": "所以，当我和别人聊天时，我必须"}, {"type": "subtitle", "time": 2912.549, "timestamp": "00:48:32", "text": "做出正确的选择"}, {"type": "subtitle", "time": 2915.19, "timestamp": "00:48:35", "text": "印象增强等等"}, {"type": "subtitle", "time": 2917.43, "timestamp": "00:48:37", "text": "减少等等取决于什么"}, {"type": "subtitle", "time": 2920.79, "timestamp": "00:48:40", "text": "我做出的选择。正确的。就是这样。"}, {"type": "subtitle", "time": 2925.829, "timestamp": "00:48:45", "text": "凉爽的。我从未玩过一款让我……的游戏"}, {"type": "subtitle", "time": 2928.95, "timestamp": "00:48:48", "text": "这样做。像往常一样"}, {"type": "subtitle", "time": 2931.19, "timestamp": "00:48:51", "text": "你只需要随机按下几个键就行了。"}, {"type": "subtitle", "time": 2933.349, "timestamp": "00:48:53", "text": "对话。无论如何，这都无关紧要。"}, {"type": "subtitle", "time": 2934.95, "timestamp": "00:48:54", "text": "你选择的那种对话，"}, {"type": "subtitle", "time": 2938.63, "timestamp": "00:48:58", "text": "正确的？但在这里，印象很重要。"}]
[{"type": "subtitle", "time": 7742.149, "timestamp": "02:09:02", "text": "我需要钱。谁不喜欢呢？我有"}, {"type": "subtitle", "time": 7743.589, "timestamp": "02:09:03", "text": "有人欠我一大笔钱。"}, {"type": "subtitle", "time": 7745.43, "timestamp": "02:09:05", "text": "你回来了。"}, {"type": "subtitle", "time": 7747.75, "timestamp": "02:09:07", "text": "这简直是​​小菜一碟。我的小黄人"}, {"type": "subtitle", "time": 7749.109, "timestamp": "02:09:09", "text": "我给了"}, {"type": "subtitle", "time": 7751.27, "timestamp": "02:09:11", "text": "所以，是你抓住了小偷。"}, {"type": "subtitle", "time": 7753.189, "timestamp": "02:09:13", "text": "我以为Snow叫你Minion是因为"}, {"type": "subtitle", "time": 7754.95, "timestamp": "02:09:14", "text": "你被她抓住了。"}, {"type": "subtitle", "time": 7755.75, "timestamp": "02:09:15", "text": "但话说回来，"}, {"type": "subtitle", "time": 7758.31, "timestamp": "02:09:18", "text": "她见证了我的所作所为。你曾"}, {"type": "subtitle", "time": 7760.629, "timestamp": "02:09:20", "text": "一切都错了。你把……弄得像个傻瓜一样"}, {"type": "subtitle", "time": 7763.189, "timestamp": "02:09:23", "text": "这次是你自己做的，对吧？"}, {"type": "subtitle", "time": 7765.35, "timestamp": "02:09:25", "text": "抱歉我刚才说的话。"}, {"type": "subtitle", "time": 7766.39, "timestamp": "02:09:26", "text": "这事儿我管。好的。"}, {"type": "subtitle", "time": 7769.51, "timestamp": "02:09:29", "text": "我接受20%的分成。你保留80%作为"}, {"type": "subtitle", "time": 7777.43, "timestamp": "02:09:37", "text": "[音乐]"}]
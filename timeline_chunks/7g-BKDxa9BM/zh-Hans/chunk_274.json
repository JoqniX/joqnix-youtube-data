[{"type": "subtitle", "time": 16442.23, "timestamp": "04:34:02", "text": "我必须做这件事。快点。似乎"}, {"type": "subtitle", "time": 16445.189, "timestamp": "04:34:05", "text": "身处深渊。"}, {"type": "subtitle", "time": 16446.949, "timestamp": "04:34:06", "text": "该期刊提到，可能会"}, {"type": "subtitle", "time": 16448.789, "timestamp": "04:34:08", "text": "做一个特别肮脏的人。"}, {"type": "subtitle", "time": 16451.269, "timestamp": "04:34:11", "text": "看，中间有一块巨大的水晶"}, {"type": "subtitle", "time": 16454.47, "timestamp": "04:34:14", "text": "闪闪发光。会不会是那块水晶……"}, {"type": "subtitle", "time": 16464.869, "timestamp": "04:34:24", "text": "声音再次响起。"}, {"type": "subtitle", "time": 16467.029, "timestamp": "04:34:27", "text": "甜的。"}, {"type": "subtitle", "time": 16469.269, "timestamp": "04:34:29", "text": "为什么会有这么多污秽之物涌现？"}, {"type": "subtitle", "time": 16472.15, "timestamp": "04:34:32", "text": "莫名其妙地突然袭击我们？"}, {"type": "subtitle", "time": 16475.029, "timestamp": "04:34:35", "text": "在这里放一个。"}, {"type": "subtitle", "time": 16479.429, "timestamp": "04:34:39", "text": "收下我的闪亮炸弹。"}, {"type": "subtitle", "time": 16480.551, "timestamp": "04:34:40", "text": "没关系。"}, {"type": "subtitle", "time": 16489.029, "timestamp": "04:34:49", "text": "黄色水晶尖刺实际上有这么多"}, {"type": "subtitle", "time": 16491.83, "timestamp": "04:34:51", "text": "里面有很多闪闪发光的宝石。"}, {"type": "subtitle", "time": 16493.99, "timestamp": "04:34:53", "text": "它们似乎被精心隐藏了起来。"}, {"type": "subtitle", "time": 16498.15, "timestamp": "04:34:58", "text": "像珍宝一样珍藏起来。"}]
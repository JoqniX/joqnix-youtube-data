[{"type": "subtitle", "time": 5761.669, "timestamp": "01:36:01", "text": "男人。她太棒了。"}, {"type": "subtitle", "time": 5764.229, "timestamp": "01:36:04", "text": "离开世纪。"}, {"type": "subtitle", "time": 5768.07, "timestamp": "01:36:08", "text": "她有自己的店铺。搞什么鬼？她"}, {"type": "subtitle", "time": 5775.189, "timestamp": "01:36:15", "text": "我想花钱，但我不想"}, {"type": "subtitle", "time": 5777.59, "timestamp": "01:36:17", "text": "花钱。我想花钱，"}, {"type": "subtitle", "time": 5779.43, "timestamp": "01:36:19", "text": "但我不想花钱。我是"}, {"type": "subtitle", "time": 5784.47, "timestamp": "01:36:24", "text": "破产了。说实话，我破产了。穷得叮当响。"}, {"type": "subtitle", "time": 5786.31, "timestamp": "01:36:26", "text": "比如，如果我要花钱，老实说……"}, {"type": "subtitle", "time": 5790.629, "timestamp": "01:36:30", "text": "说真的，我很想得到这个。"}, {"type": "subtitle", "time": 5792.79, "timestamp": "01:36:32", "text": "哦，如果你不想的话，你可以这样做。"}, {"type": "subtitle", "time": 5795.75, "timestamp": "01:36:35", "text": "要刷资源，你只需要获得这些角色即可。"}, {"type": "subtitle", "time": 5797.669, "timestamp": "01:36:37", "text": "从这里开始。"}, {"type": "subtitle", "time": 5804.79, "timestamp": "01:36:44", "text": "我现在只想过圣诞节"}]
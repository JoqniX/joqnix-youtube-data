[{"type": "subtitle", "time": 1997.11, "timestamp": "00:33:17", "text": "这就是你认为的准确情报吗？"}, {"type": "subtitle", "time": 1998.95, "timestamp": "00:33:18", "text": "兰迪？"}, {"type": "subtitle", "time": 2005.669, "timestamp": "00:33:25", "text": "士兵们尽了全力"}, {"type": "subtitle", "time": 2007.35, "timestamp": "00:33:27", "text": "污秽之徒。"}, {"type": "subtitle", "time": 2009.029, "timestamp": "00:33:29", "text": "这些确实是意料之外的。"}, {"type": "subtitle", "time": 2011.909, "timestamp": "00:33:31", "text": "情况。但我们确实发现了一些东西。"}, {"type": "subtitle", "time": 2014.549, "timestamp": "00:33:34", "text": "如今这座岛上的珍贵物品。"}, {"type": "subtitle", "time": 2016.95, "timestamp": "00:33:36", "text": "她使用的炼金术工具以及"}, {"type": "subtitle", "time": 2019.11, "timestamp": "00:33:39", "text": "带有军团序列号的飞艇"}, {"type": "subtitle", "time": 2019.83, "timestamp": "00:33:39", "text": "它。"}, {"type": "subtitle", "time": 2021.83, "timestamp": "00:33:41", "text": "你明白我们正在寻找数字吗？"}, {"type": "subtitle", "time": 2025.669, "timestamp": "00:33:45", "text": "零，不是这些没用的垃圾，对吧？"}, {"type": "subtitle", "time": 2028.549, "timestamp": "00:33:48", "text": "我们已经寻找了十多年，"}, {"type": "subtitle", "time": 2030.789, "timestamp": "00:33:50", "text": "但我方海上部队拦截了"}, {"type": "subtitle", "time": 2033.11, "timestamp": "00:33:53", "text": "村里的几艘船。他们"}, {"type": "subtitle", "time": 2035.909, "timestamp": "00:33:55", "text": "或许能挖到一些。"}, {"type": "subtitle", "time": 2037.509, "timestamp": "00:33:57", "text": "那些是枪声吗？"}]
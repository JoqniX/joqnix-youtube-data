[{"type": "subtitle", "time": 8702.15, "timestamp": "02:25:02", "text": "好了，这应该足够了。"}, {"type": "subtitle", "time": 8704.469, "timestamp": "02:25:04", "text": "给他点教训。我们来总结一下。"}, {"type": "subtitle", "time": 8706.15, "timestamp": "02:25:06", "text": "然后返回"}, {"type": "subtitle", "time": 8708.469, "timestamp": "02:25:08", "text": "哇，这也太快了吧。"}, {"type": "subtitle", "time": 8710.63, "timestamp": "02:25:10", "text": "我会惩罚那些不忠诚的人。"}, {"type": "subtitle", "time": 8713.75, "timestamp": "02:25:13", "text": "以爱神之名去爱。"}, {"type": "subtitle", "time": 8716.71, "timestamp": "02:25:16", "text": "可以攀登。好的。哦，我的武器"}, {"type": "subtitle", "time": 8720.55, "timestamp": "02:25:20", "text": "同时提升等级。哦，真好，真好。"}, {"type": "subtitle", "time": 8722.95, "timestamp": "02:25:22", "text": "好的。我获得了许多农用物资。"}, {"type": "subtitle", "time": 8725.03, "timestamp": "02:25:25", "text": "好的。"}, {"type": "subtitle", "time": 8730.95, "timestamp": "02:25:30", "text": "所以蔬菜就像人造物一样吗？"}, {"type": "subtitle", "time": 8737.75, "timestamp": "02:25:37", "text": "我也这么认为。"}, {"type": "subtitle", "time": 8741.03, "timestamp": "02:25:41", "text": "比如文物之类的东西"}, {"type": "subtitle", "time": 8745.91, "timestamp": "02:25:45", "text": "或者就像你可以拥有的一种强化道具。"}, {"type": "subtitle", "time": 8750.15, "timestamp": "02:25:50", "text": "该死的，好多事。"}]
[{"type": "subtitle", "time": 6542.229, "timestamp": "01:49:02", "text": "为了你未来的战斗。好的，那是什么？"}, {"type": "subtitle", "time": 6544.95, "timestamp": "01:49:04", "text": "那？"}, {"type": "subtitle", "time": 6547.27, "timestamp": "01:49:07", "text": "前往今天的会场。"}, {"type": "subtitle", "time": 6549.43, "timestamp": "01:49:09", "text": "将各种物品拖入战术包中"}, {"type": "subtitle", "time": 6553.03, "timestamp": "01:49:13", "text": "使用战斗手段。你会做好充分的准备。"}, {"type": "subtitle", "time": 6555.59, "timestamp": "01:49:15", "text": "使用兼容性召唤盟友并进行战斗"}, {"type": "subtitle", "time": 6557.91, "timestamp": "01:49:17", "text": "这样做。首先将它们添加到你的"}, {"type": "subtitle", "time": 6560.629, "timestamp": "01:49:20", "text": "战术背包。首先，我们……"}, {"type": "subtitle", "time": 6563.03, "timestamp": "01:49:23", "text": "装甲我们的紧凑型合作伙伴"}, {"type": "subtitle", "time": 6565.83, "timestamp": "01:49:25", "text": "装载完毕。"}, {"type": "subtitle", "time": 6568.149, "timestamp": "01:49:28", "text": "每个战斗部件都可以装备"}, {"type": "subtitle", "time": 6571.189, "timestamp": "01:49:31", "text": "只能使用一种武器，近战或远程均可。"}, {"type": "subtitle", "time": 6573.75, "timestamp": "01:49:33", "text": "每件武器只能分配给一个人。"}, {"type": "subtitle", "time": 6577.03, "timestamp": "01:49:37", "text": "好的。你无需任何操作就能获得烹饪武器"}, {"type": "subtitle", "time": 6580.709, "timestamp": "01:49:40", "text": "本页显示的是工资。拖动 com 与"}, {"type": "subtitle", "time": 6584.709, "timestamp": "01:49:44", "text": "将武器装入战术电池组。"}, {"type": "subtitle", "time": 6587.189, "timestamp": "01:49:47", "text": "好的。"}, {"type": "subtitle", "time": 6589.35, "timestamp": "01:49:49", "text": "在世界探索或独自一人时"}, {"type": "subtitle", "time": 6591.51, "timestamp": "01:49:51", "text": "获得佣金后，你最多可以召唤两个"}, {"type": "subtitle", "time": 6593.669, "timestamp": "01:49:53", "text": "一次只能进行一种战斗模式。期间"}, {"type": "subtitle", "time": 6596.31, "timestamp": "01:49:56", "text": "双人佣金，每位玩家可以"}]
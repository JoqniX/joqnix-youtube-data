[{"type": "subtitle", "time": 18189.52, "timestamp": "05:03:09", "text": "你是要约我出去吗？"}, {"type": "subtitle", "time": 18207.59, "timestamp": "05:03:27", "text": "我们走吧。"}, {"type": "subtitle", "time": 18210.07, "timestamp": "05:03:30", "text": "我想得到她。男人，"}, {"type": "subtitle", "time": 18210.948, "timestamp": "05:03:30", "text": "开始了。"}, {"type": "subtitle", "time": 18212.2, "timestamp": "05:03:32", "text": "伊莎贝尔"}, {"type": "subtitle", "time": 18229.67, "timestamp": "05:03:49", "text": "场景就在眼前"}]
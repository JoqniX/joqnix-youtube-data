[{"type": "subtitle", "time": 24420.788, "timestamp": "06:47:00", "text": "对不起。"}, {"type": "subtitle", "time": 24429.35, "timestamp": "06:47:09", "text": "这是怎么回事？发生了什么事？"}, {"type": "subtitle", "time": 24431.67, "timestamp": "06:47:11", "text": "精神？"}, {"type": "subtitle", "time": 24440.468, "timestamp": "06:47:20", "text": "她需要休息一段时间。它是"}, {"type": "subtitle", "time": 24443.03, "timestamp": "06:47:23", "text": "没什么大碍，但请你离开她。"}, {"type": "subtitle", "time": 24446.23, "timestamp": "06:47:26", "text": "接下来的几天他将独自一人度过。"}, {"type": "subtitle", "time": 24448.548, "timestamp": "06:47:28", "text": "普赛克，你想出去走走吗？"}, {"type": "subtitle", "time": 24450.948, "timestamp": "06:47:30", "text": "跟我一起走吗？"}, {"type": "subtitle", "time": 24453.51, "timestamp": "06:47:33", "text": "我们出去透透气吧。"}, {"type": "subtitle", "time": 24456.31, "timestamp": "06:47:36", "text": "不要害怕，"}, {"type": "subtitle", "time": 24457.59, "timestamp": "06:47:37", "text": "请。"}, {"type": "subtitle", "time": 24461.83, "timestamp": "06:47:41", "text": "我想去哀叹湖。"}, {"type": "subtitle", "time": 24465.11, "timestamp": "06:47:45", "text": "当然，我跟你一起去。"}, {"type": "subtitle", "time": 24467.11, "timestamp": "06:47:47", "text": "亨里克先生，"}, {"type": "subtitle", "time": 24470.07, "timestamp": "06:47:50", "text": "我可以出去散步吗？"}, {"type": "subtitle", "time": 24473.91, "timestamp": "06:47:53", "text": "别担心，不会的"}, {"type": "subtitle", "time": 24476.548, "timestamp": "06:47:56", "text": "前进。但请记住我跟你说过的话"}, {"type": "subtitle", "time": 24479.43, "timestamp": "06:47:59", "text": "你。否则，"}]
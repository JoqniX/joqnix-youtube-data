[{"type": "subtitle", "time": 7684.069, "timestamp": "02:08:04", "text": "我发誓，这绝对是一种至高无上的权利。"}, {"type": "subtitle", "time": 7686.149, "timestamp": "02:08:06", "text": "这边。所有狐狸的佣金"}, {"type": "subtitle", "time": 7695.03, "timestamp": "02:08:15", "text": "佣金。不。帮助狐狸"}, {"type": "subtitle", "time": 7697.35, "timestamp": "02:08:17", "text": "又是猎人。这次又是什么事？"}, {"type": "subtitle", "time": 7698.31, "timestamp": "02:08:18", "text": "纳布斯。"}, {"type": "subtitle", "time": 7700.629, "timestamp": "02:08:20", "text": "我的天啊。他的眼睛怎么了？"}, {"type": "subtitle", "time": 7701.91, "timestamp": "02:08:21", "text": "卑鄙的阴谋。"}, {"type": "subtitle", "time": 7703.669, "timestamp": "02:08:23", "text": "这是什么低像素眼睛？"}, {"type": "subtitle", "time": 7705.189, "timestamp": "02:08:25", "text": "我打算低调处理。"}, {"type": "subtitle", "time": 7706.39, "timestamp": "02:08:26", "text": "只有一个。"}, {"type": "subtitle", "time": 7708.229, "timestamp": "02:08:28", "text": "好了，现在好多了。"}, {"type": "subtitle", "time": 7713.189, "timestamp": "02:08:33", "text": "我从未撒谎。你好，威尔斯先生。"}, {"type": "subtitle", "time": 7715.669, "timestamp": "02:08:35", "text": "所以，是你一直在四处张望"}, {"type": "subtitle", "time": 7716.95, "timestamp": "02:08:36", "text": "谢谢。"}, {"type": "subtitle", "time": 7720.47, "timestamp": "02:08:40", "text": "一件小事。我告诉你，这一切都是真的。"}, {"type": "subtitle", "time": 7721.03, "timestamp": "02:08:41", "text": "这些。"}, {"type": "subtitle", "time": 7724.55, "timestamp": "02:08:44", "text": "NPC的嘴怎么了？"}, {"type": "subtitle", "time": 7725.589, "timestamp": "02:08:45", "text": "它坏了。"}, {"type": "subtitle", "time": 7725.99, "timestamp": "02:08:45", "text": "大的。"}, {"type": "subtitle", "time": 7728.55, "timestamp": "02:08:48", "text": "那我应该更加努力。学习"}, {"type": "subtitle", "time": 7729.589, "timestamp": "02:08:49", "text": "专业人士"}, {"type": "subtitle", "time": 7733.35, "timestamp": "02:08:53", "text": "向我学习。拜托，饶了我吧。拿"}, {"type": "subtitle", "time": 7735.83, "timestamp": "02:08:55", "text": "好好思考一下，弄清楚你为什么"}, {"type": "subtitle", "time": 7738.39, "timestamp": "02:08:58", "text": "最终走上了这条路。这就是你"}, {"type": "subtitle", "time": 7739.43, "timestamp": "02:08:59", "text": "应该这样做。"}]
[{"type": "subtitle", "time": 22687.99, "timestamp": "06:18:07", "text": "好的。"}, {"type": "subtitle", "time": 22691.03, "timestamp": "06:18:11", "text": "不错。你的战斗技能已经提升了"}, {"type": "subtitle", "time": 22693.27, "timestamp": "06:18:13", "text": "比我想象的要锋利。如此迅速"}, {"type": "subtitle", "time": 22696.39, "timestamp": "06:18:16", "text": "你已经成为一名合格的猎狐者了。"}, {"type": "subtitle", "time": 22700.07, "timestamp": "06:18:20", "text": "现在的年轻人确实很有才华。"}, {"type": "subtitle", "time": 22703.27, "timestamp": "06:18:23", "text": "太阳快落山了。我们走吧。"}, {"type": "subtitle", "time": 22705.83, "timestamp": "06:18:25", "text": "是时候认识一下纽扣蘑菇了。我"}, {"type": "subtitle", "time": 22707.35, "timestamp": "06:18:27", "text": "不知道她那边一切是否顺利"}, {"type": "subtitle", "time": 22716.868, "timestamp": "06:18:36", "text": "[音乐]"}, {"type": "subtitle", "time": 22722.78, "timestamp": "06:18:42", "text": "M."}, {"type": "subtitle", "time": 22726.15, "timestamp": "06:18:46", "text": "[音乐]"}]
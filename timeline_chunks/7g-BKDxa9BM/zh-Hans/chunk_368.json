[{"type": "subtitle", "time": 22081.51, "timestamp": "06:08:01", "text": "普通的浓汤，却发现"}, {"type": "subtitle", "time": 22082.548, "timestamp": "06:08:02", "text": "幻想"}, {"type": "subtitle", "time": 22084.39, "timestamp": "06:08:04", "text": "啊，是的，老大。"}, {"type": "subtitle", "time": 22085.43, "timestamp": "06:08:05", "text": "我正在分发。"}, {"type": "subtitle", "time": 22087.51, "timestamp": "06:08:07", "text": "村民们告诉我，那些肮脏的人"}, {"type": "subtitle", "time": 22090.31, "timestamp": "06:08:10", "text": "普尔加托里奥岛的居民一直居住在"}, {"type": "subtitle", "time": 22092.23, "timestamp": "06:08:12", "text": "山脉几乎没有"}, {"type": "subtitle", "time": 22094.868, "timestamp": "06:08:14", "text": "两天。看来你已经……"}, {"type": "subtitle", "time": 22097.27, "timestamp": "06:08:17", "text": "搞定了，老大。相当"}, {"type": "subtitle", "time": 22099.59, "timestamp": "06:08:19", "text": "巧合并非唯一的因素。"}, {"type": "subtitle", "time": 22101.27, "timestamp": "06:08:21", "text": "能够操纵？"}, {"type": "subtitle", "time": 22103.91, "timestamp": "06:08:23", "text": "无论他是谁，毕竟是这30个人。"}, {"type": "subtitle", "time": 22106.948, "timestamp": "06:08:26", "text": "多年以后，是时候进行一次彻底的……"}, {"type": "subtitle", "time": 22109.91, "timestamp": "06:08:29", "text": "灭绝。"}, {"type": "subtitle", "time": 22112.39, "timestamp": "06:08:32", "text": "好吧，所以她是个坏人吗？"}, {"type": "subtitle", "time": 22115.43, "timestamp": "06:08:35", "text": "内科医生？我不明白。谁是那个"}, {"type": "subtitle", "time": 22116.948, "timestamp": "06:08:36", "text": "配乐和一切都让人感觉"}, {"type": "subtitle", "time": 22119.19, "timestamp": "06:08:39", "text": "就好像她是个坏人，但为什么呢？"}, {"type": "subtitle", "time": 22121.03, "timestamp": "06:08:41", "text": "她能玩吗？"}, {"type": "subtitle", "time": 22124.31, "timestamp": "06:08:44", "text": "就像Vuva那样，他们把她弄得像……呃"}, {"type": "subtitle", "time": 22127.03, "timestamp": "06:08:47", "text": "菲尔·菲洛拉"}, {"type": "subtitle", "time": 22128.868, "timestamp": "06:08:48", "text": "可玩"}, {"type": "subtitle", "time": 22133.51, "timestamp": "06:08:53", "text": "这太疯狂了。那也很酷。"}]
[{"type": "subtitle", "time": 7453.83, "timestamp": "02:04:13", "text": "我真的应该休息一下。"}, {"type": "subtitle", "time": 7455.83, "timestamp": "02:04:15", "text": "这样我就可以吃点东西了。"}, {"type": "subtitle", "time": 7459.43, "timestamp": "02:04:19", "text": "哦，这里空间出乎意料地宽敞。"}, {"type": "subtitle", "time": 7462.709, "timestamp": "02:04:22", "text": "而且比地面上的温度高得多。"}, {"type": "subtitle", "time": 7466.31, "timestamp": "02:04:26", "text": "哦，就像一个秘密的小王国。追赶"}, {"type": "subtitle", "time": 7468.47, "timestamp": "02:04:28", "text": "赶走那些小动物，清除掉……"}, {"type": "subtitle", "time": 7471.669, "timestamp": "02:04:31", "text": "闻。然后你就可以搭帐篷了"}, {"type": "subtitle", "time": 7474.149, "timestamp": "02:04:34", "text": "几乎就住在这里，"}, {"type": "subtitle", "time": 7484.39, "timestamp": "02:04:44", "text": "小偷就在前面。"}, {"type": "subtitle", "time": 7487.83, "timestamp": "02:04:47", "text": "哦不，他跟一群肮脏的家伙打起来了。"}, {"type": "subtitle", "time": 7489.83, "timestamp": "02:04:49", "text": "让我们赶走这些肮脏的家伙，然后……"}]
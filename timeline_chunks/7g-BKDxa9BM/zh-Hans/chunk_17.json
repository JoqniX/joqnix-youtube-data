[{"type": "subtitle", "time": 1022.55, "timestamp": "00:17:02", "text": "好的。"}, {"type": "subtitle", "time": 1067.669, "timestamp": "00:17:47", "text": "我的意思是，他们可能已经逃之夭夭了。"}, {"type": "subtitle", "time": 1069.83, "timestamp": "00:17:49", "text": "乘船。我们应该赶紧回家。"}, {"type": "subtitle", "time": 1072.39, "timestamp": "00:17:52", "text": "拿到武器后，前往码头。"}, {"type": "subtitle", "time": 1075.029, "timestamp": "00:17:55", "text": "我们现在没有武器。我们必须"}, {"type": "subtitle", "time": 1078.31, "timestamp": "00:17:58", "text": "尽量避免接触那些污秽之物。"}]
[{"type": "subtitle", "time": 5402.39, "timestamp": "01:30:02", "text": "巴罗尼卡。"}, {"type": "subtitle", "time": 5404.95, "timestamp": "01:30:04", "text": "哦，我们找到了丽贝卡。"}, {"type": "subtitle", "time": 5414.629, "timestamp": "01:30:14", "text": "公开测试版奖励。我从来没玩过。"}, {"type": "subtitle", "time": 5434.39, "timestamp": "01:30:34", "text": "我们要去哪里？你在邀请吗？"}, {"type": "subtitle", "time": 5434.709, "timestamp": "01:30:34", "text": "我？"}, {"type": "subtitle", "time": 5436.709, "timestamp": "01:30:36", "text": "哦，等等。现在你可以解锁丽贝卡了。"}, {"type": "subtitle", "time": 5442.709, "timestamp": "01:30:42", "text": "我正在解锁她。"}, {"type": "subtitle", "time": 5445.51, "timestamp": "01:30:45", "text": "浪漫邂逅。这就是神吗？"}, {"type": "subtitle", "time": 5447.35, "timestamp": "01:30:47", "text": "爱情的功劳？"}, {"type": "subtitle", "time": 5449.11, "timestamp": "01:30:49", "text": "她真漂亮。"}, {"type": "subtitle", "time": 5451.11, "timestamp": "01:30:51", "text": "一位调香师。"}, {"type": "subtitle", "time": 5453.27, "timestamp": "01:30:53", "text": "何不尽情享受一次真正独特的体验呢？"}, {"type": "subtitle", "time": 5456.79, "timestamp": "01:30:56", "text": "香味？课程内容令人厌烦。"}, {"type": "subtitle", "time": 5458.629, "timestamp": "01:30:58", "text": "我自己做的。"}]
[{"type": "subtitle", "time": 17880.628, "timestamp": "04:58:00", "text": "省政府的行动使这座城市陷入混乱。"}, {"type": "subtitle", "time": 17881.99, "timestamp": "04:58:01", "text": "就在那时，他们颁布了禁令。"}, {"type": "subtitle", "time": 17884.07, "timestamp": "04:58:04", "text": "crystalallo 交易。"}, {"type": "subtitle", "time": 17886.39, "timestamp": "04:58:06", "text": "但这还不到全部真相的一半。多少"}, {"type": "subtitle", "time": 17888.07, "timestamp": "04:58:08", "text": "伊斯拉特街头的人们可以"}, {"type": "subtitle", "time": 17891.43, "timestamp": "04:58:11", "text": "真的声称自己清白无辜吗？"}, {"type": "subtitle", "time": 17892.708, "timestamp": "04:58:12", "text": "附近的居民说："}, {"type": "subtitle", "time": 17896.07, "timestamp": "04:58:16", "text": "亨里克和他的分会成员都是一群怪人。"}, {"type": "subtitle", "time": 17897.75, "timestamp": "04:58:17", "text": "他们不与人交往。有些人有"}, {"type": "subtitle", "time": 17900.47, "timestamp": "04:58:20", "text": "往里窥视了一下。那里的旅馆都是"}, {"type": "subtitle", "time": 17902.788, "timestamp": "04:58:22", "text": "20岁以下的年轻人。"}, {"type": "subtitle", "time": 17903.83, "timestamp": "04:58:23", "text": "还是陌生人。"}, {"type": "subtitle", "time": 17906.23, "timestamp": "04:58:26", "text": "是的，我听说过一些闹鬼的房子"}, {"type": "subtitle", "time": 17908.39, "timestamp": "04:58:28", "text": "谣言也很多。你是怎么加入的"}, {"type": "subtitle", "time": 17908.628, "timestamp": "04:58:28", "text": "这？"}, {"type": "subtitle", "time": 17910.39, "timestamp": "04:58:30", "text": "我以前认识一个猎狐少年"}, {"type": "subtitle", "time": 17911.75, "timestamp": "04:58:31", "text": "与名叫亨特的人一起工作。"}, {"type": "subtitle", "time": 17914.23, "timestamp": "04:58:34", "text": "打猎？几天前，我过去了"}, {"type": "subtitle", "time": 17916.47, "timestamp": "04:58:36", "text": "在那里，他们最终爆发了激烈的争吵。"}, {"type": "subtitle", "time": 17917.99, "timestamp": "04:58:37", "text": "亨里克。"}, {"type": "subtitle", "time": 17919.91, "timestamp": "04:58:39", "text": "即使匕首抵着他的喉咙，他……"}, {"type": "subtitle", "time": 17922.788, "timestamp": "04:58:42", "text": "就那样站在那里，冷笑着。你知道"}, {"type": "subtitle", "time": 17924.708, "timestamp": "04:58:44", "text": "一个卡隆会发生什么呢？"}, {"type": "subtitle", "time": 17926.868, "timestamp": "04:58:46", "text": "损害太阳能。我知道你有一个"}, {"type": "subtitle", "time": 17928.948, "timestamp": "04:58:48", "text": "姐姐。最好别出去。该死的。我"}, {"type": "subtitle", "time": 17930.07, "timestamp": "04:58:50", "text": "真想把他扔进去"}, {"type": "subtitle", "time": 17933.51, "timestamp": "04:58:53", "text": "哀叹的湖泊。总之，我必须弄清楚。"}, {"type": "subtitle", "time": 17934.868, "timestamp": "04:58:54", "text": "亨特怎么了？"}, {"type": "subtitle", "time": 17936.55, "timestamp": "04:58:56", "text": "不只是亨特。"}, {"type": "subtitle", "time": 17939.43, "timestamp": "04:58:59", "text": "我这样做主要是为了菲娜。"}]
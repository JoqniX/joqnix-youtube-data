[{"type": "subtitle", "time": 16083.11, "timestamp": "04:28:03", "text": "好了，我们走吧。"}, {"type": "subtitle", "time": 16085.75, "timestamp": "04:28:05", "text": "我买了一个Oculus头显。"}, {"type": "subtitle", "time": 16088.07, "timestamp": "04:28:08", "text": "魔王，那个小喽啰"}, {"type": "subtitle", "time": 16090.71, "timestamp": "04:28:10", "text": "刚从远方抵达冰湖，有"}, {"type": "subtitle", "time": 16094.71, "timestamp": "04:28:14", "text": "一天之内成为杰出的猎人。"}, {"type": "subtitle", "time": 16097.269, "timestamp": "04:28:17", "text": "这段传奇故事的新篇章。"}, {"type": "subtitle", "time": 16098.95, "timestamp": "04:28:18", "text": "魔王。"}, {"type": "subtitle", "time": 16101.75, "timestamp": "04:28:21", "text": "“猎狐人”这个名字很酷。"}, {"type": "subtitle", "time": 16105.03, "timestamp": "04:28:25", "text": "它们都猎杀一种叫狐狸的动物吗？"}, {"type": "subtitle", "time": 16107.59, "timestamp": "04:28:27", "text": "不，现在的猎狐者实际上是"}, {"type": "subtitle", "time": 16109.83, "timestamp": "04:28:29", "text": "赏金猎人。这跟……有关"}, {"type": "subtitle", "time": 16112.389, "timestamp": "04:28:32", "text": "很久以前就有了黄斑。"}, {"type": "subtitle", "time": 16115.51, "timestamp": "04:28:35", "text": "正确的。我听说它用来指代……"}, {"type": "subtitle", "time": 16118.07, "timestamp": "04:28:38", "text": "起源于此的职业"}, {"type": "subtitle", "time": 16129.75, "timestamp": "04:28:49", "text": "你是要约我出去吗？"}, {"type": "subtitle", "time": 16136.71, "timestamp": "04:28:56", "text": "装载完毕。"}, {"type": "subtitle", "time": 16139.03, "timestamp": "04:28:59", "text": "呃，我们会给她，我没有一个"}]
[{"type": "subtitle", "time": 662.23, "timestamp": "00:11:02", "text": "太难了。我们仍然需要存一些钱。"}, {"type": "subtitle", "time": 673.59, "timestamp": "00:11:13", "text": "感觉像是在玩《星际战甲》。"}, {"type": "subtitle", "time": 697.43, "timestamp": "00:11:37", "text": "钢琴曲真好听"}, {"type": "subtitle", "time": 700.23, "timestamp": "00:11:40", "text": "实际上。"}, {"type": "subtitle", "time": 703.35, "timestamp": "00:11:43", "text": "炼狱 Purgatorio"}, {"type": "subtitle", "time": 708.55, "timestamp": "00:11:48", "text": "地图和传送功能现已解锁。"}, {"type": "subtitle", "time": 710.87, "timestamp": "00:11:50", "text": "召唤阿文之灵记录"}, {"type": "subtitle", "time": 714.069, "timestamp": "00:11:54", "text": "外星塔楼，并重访这些地方"}, {"type": "subtitle", "time": 715.99, "timestamp": "00:11:55", "text": "一道闪光。"}]
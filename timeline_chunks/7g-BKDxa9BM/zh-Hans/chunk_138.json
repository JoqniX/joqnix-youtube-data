[{"type": "subtitle", "time": 8295.19, "timestamp": "02:18:15", "text": "好的。"}, {"type": "subtitle", "time": 8297.509, "timestamp": "02:18:17", "text": "我会惩罚那些不忠的人。"}, {"type": "subtitle", "time": 8301.429, "timestamp": "02:18:21", "text": "以爱神之名去爱。"}, {"type": "subtitle", "time": 8304.79, "timestamp": "02:18:24", "text": "无法升华。"}, {"type": "subtitle", "time": 8313.509, "timestamp": "02:18:33", "text": "我将重点放在丽贝卡身上。然后我会集中精力"}, {"type": "subtitle", "time": 8315.83, "timestamp": "02:18:35", "text": "逐一添加其他字符。慢慢地，"}, {"type": "subtitle", "time": 8333.19, "timestamp": "02:18:53", "text": "你是要约我出去吗？"}]
[{"type": "subtitle", "time": 1646.95, "timestamp": "00:27:26", "text": "我打喷嚏，所以把声音关掉了。是的，"}, {"type": "subtitle", "time": 1649.75, "timestamp": "00:27:29", "text": "解锁机制"}, {"type": "subtitle", "time": 1650.23, "timestamp": "00:27:30", "text": "死的"}, {"type": "subtitle", "time": 1652.149, "timestamp": "00:27:32", "text": "比如锁匠。太好了。"}, {"type": "subtitle", "time": 1653.83, "timestamp": "00:27:33", "text": "好像有人跟他吵架了。"}, {"type": "subtitle", "time": 1655.269, "timestamp": "00:27:35", "text": "在我们到达之前。"}, {"type": "subtitle", "time": 1657.75, "timestamp": "00:27:37", "text": "会不会是村民中的某个人？"}, {"type": "subtitle", "time": 1660.789, "timestamp": "00:27:40", "text": "不，我们才是第一个打开那扇门的人。"}, {"type": "subtitle", "time": 1663.909, "timestamp": "00:27:43", "text": "总之，多亏了那个人，我们才没有"}, {"type": "subtitle", "time": 1665.59, "timestamp": "00:27:45", "text": "不得不处理这些肮脏的东西"}, {"type": "subtitle", "time": 1666.95, "timestamp": "00:27:46", "text": "我们自己。"}, {"type": "subtitle", "time": 1669.11, "timestamp": "00:27:49", "text": "无论是谁，他们都不应该……"}]
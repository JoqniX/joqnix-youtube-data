[{"type": "subtitle", "time": 3301.51, "timestamp": "00:55:01", "text": "你知道这里离这里有多远吗？这是一个"}, {"type": "subtitle", "time": 3303.43, "timestamp": "00:55:03", "text": "小岛"}, {"type": "subtitle", "time": 3306.549, "timestamp": "00:55:06", "text": "希波里亚南部位于一个巨大的……之下"}, {"type": "subtitle", "time": 3308.87, "timestamp": "00:55:08", "text": "天堂树，对吧？"}, {"type": "subtitle", "time": 3311.349, "timestamp": "00:55:11", "text": "那里非常非常远。"}, {"type": "subtitle", "time": 3314.47, "timestamp": "00:55:14", "text": "1500公里。哇。"}, {"type": "subtitle", "time": 3316.15, "timestamp": "00:55:16", "text": "你是来自那里的吗？还是……"}, {"type": "subtitle", "time": 3318.63, "timestamp": "00:55:18", "text": "想去那里吗？"}, {"type": "subtitle", "time": 3322.79, "timestamp": "00:55:22", "text": "那么远吗？但究竟是谁，又为何会这样做呢？"}, {"type": "subtitle", "time": 3323.829, "timestamp": "00:55:23", "text": "他们？"}, {"type": "subtitle", "time": 3326.71, "timestamp": "00:55:26", "text": "好吧，是有人把我们带到这里的。多少"}, {"type": "subtitle", "time": 3328.549, "timestamp": "00:55:28", "text": "你收到的延迟是多少？我该如何检查我的"}, {"type": "subtitle", "time": 3330.23, "timestamp": "00:55:30", "text": "ping？"}, {"type": "subtitle", "time": 3332.95, "timestamp": "00:55:32", "text": "等待，"}, {"type": "subtitle", "time": 3344.309, "timestamp": "00:55:44", "text": "右下角。"}, {"type": "subtitle", "time": 3347.99, "timestamp": "00:55:47", "text": "你说的右下角是什么意思？"}, {"type": "subtitle", "time": 3351.19, "timestamp": "00:55:51", "text": "什么也没有。"}]
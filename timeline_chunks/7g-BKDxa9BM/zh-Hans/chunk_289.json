[{"type": "subtitle", "time": 17341.11, "timestamp": "04:49:01", "text": "所以你还记得"}, {"type": "subtitle", "time": 17343.19, "timestamp": "04:49:03", "text": "在做出决定之前，如果发生任何情况……"}, {"type": "subtitle", "time": 17344.868, "timestamp": "04:49:04", "text": "把事情搞砸了，或者如果人们开始"}, {"type": "subtitle", "time": 17347.51, "timestamp": "04:49:07", "text": "提出问题，"}, {"type": "subtitle", "time": 17348.31, "timestamp": "04:49:08", "text": "你知道吗？"}, {"type": "subtitle", "time": 17349.99, "timestamp": "04:49:09", "text": "非常抱歉，先生。"}, {"type": "subtitle", "time": 17352.31, "timestamp": "04:49:12", "text": "你是个好孩子。"}, {"type": "subtitle", "time": 17355.75, "timestamp": "04:49:15", "text": "千万别让这种事再次发生。"}, {"type": "subtitle", "time": 17358.788, "timestamp": "04:49:18", "text": "至于你，"}, {"type": "subtitle", "time": 17362.47, "timestamp": "04:49:22", "text": "照料好自己的花园，别拖延。"}, {"type": "subtitle", "time": 17365.35, "timestamp": "04:49:25", "text": "将无关人员引入你的业务。"}, {"type": "subtitle", "time": 17371.75, "timestamp": "04:49:31", "text": "那我们聊点别的吧。"}, {"type": "subtitle", "time": 17374.31, "timestamp": "04:49:34", "text": "例如，你一直都这么有礼貌吗？"}, {"type": "subtitle", "time": 17376.948, "timestamp": "04:49:36", "text": "对每个人都友善吗？难怪"}, {"type": "subtitle", "time": 17380.23, "timestamp": "04:49:40", "text": "你的房子一直卖不出去。"}, {"type": "subtitle", "time": 17383.19, "timestamp": "04:49:43", "text": "这就是我的问题。我预计到早上就能见到结果。"}, {"type": "subtitle", "time": 17386.07, "timestamp": "04:49:46", "text": "我们回家吧。精神。"}, {"type": "subtitle", "time": 17399.59, "timestamp": "04:49:59", "text": "那位汉默总是知道如何展现王室风范。"}]
[{"type": "subtitle", "time": 16158.07, "timestamp": "04:29:18", "text": "这一切似乎都始于富人。"}, {"type": "subtitle", "time": 16161.83, "timestamp": "04:29:21", "text": "附近山脉中蕴藏着丰富的矿脉。"}, {"type": "subtitle", "time": 16165.269, "timestamp": "04:29:25", "text": "确切地。很久很久以前，许多"}, {"type": "subtitle", "time": 16167.51, "timestamp": "04:29:27", "text": "人们冒着风险收集"}]
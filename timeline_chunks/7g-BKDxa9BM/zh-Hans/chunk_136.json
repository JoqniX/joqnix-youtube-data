[{"type": "subtitle", "time": 8162.229, "timestamp": "02:16:02", "text": "哦，是的。为了建造这个车站，我们有"}, {"type": "subtitle", "time": 8165.43, "timestamp": "02:16:05", "text": "击败附近的敌人。"}, {"type": "subtitle", "time": 8170.47, "timestamp": "02:16:10", "text": "明白了。爆炸物会在范围内产生。"}, {"type": "subtitle", "time": 8172.55, "timestamp": "02:16:12", "text": "填满药剂站即可完成"}, {"type": "subtitle", "time": 8212.309, "timestamp": "02:16:52", "text": "好的。"}, {"type": "subtitle", "time": 8215.75, "timestamp": "02:16:55", "text": "正用有毒布料冲过来。它将"}, {"type": "subtitle", "time": 8218.389, "timestamp": "02:16:58", "text": "污染空间站内所有血清。"}]
[{"type": "subtitle", "time": 23778.23, "timestamp": "06:36:18", "text": "我的名字是"}, {"type": "subtitle", "time": 23792.788, "timestamp": "06:36:32", "text": "好了，他要走了。"}, {"type": "subtitle", "time": 23794.788, "timestamp": "06:36:34", "text": "他在那里。"}, {"type": "subtitle", "time": 23798.31, "timestamp": "06:36:38", "text": "你们俩要喝点什么吗？"}, {"type": "subtitle", "time": 23801.27, "timestamp": "06:36:41", "text": "哦，我们没事。嗯，没有什么能与之搭配。"}, {"type": "subtitle", "time": 23805.35, "timestamp": "06:36:45", "text": "好的，不用了，谢谢。我们有一些"}, {"type": "subtitle", "time": 23806.948, "timestamp": "06:36:46", "text": "我们去问问植物女神吧。"}, {"type": "subtitle", "time": 23810.868, "timestamp": "06:36:50", "text": "我的名字叫安妮。"}]
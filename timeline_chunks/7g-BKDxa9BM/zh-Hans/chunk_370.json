[{"type": "subtitle", "time": 22218.47, "timestamp": "06:10:18", "text": "火焰坠落会喜欢攻击处理"}, {"type": "subtitle", "time": 22220.15, "timestamp": "06:10:20", "text": "对所有穿过的目标造成伤害"}, {"type": "subtitle", "time": 22222.708, "timestamp": "06:10:22", "text": "有些伤害更高。"}, {"type": "subtitle", "time": 22225.35, "timestamp": "06:10:25", "text": "地面上的这些东西必须是"}, {"type": "subtitle", "time": 22229.51, "timestamp": "06:10:29", "text": "外部陷阱。这真是令人难以置信。"}, {"type": "subtitle", "time": 22231.67, "timestamp": "06:10:31", "text": "我不知道局外人有这样的本事"}]
[{"type": "subtitle", "time": 9543.19, "timestamp": "02:39:03", "text": "悪い。私はこの男とこの件が大嫌いだ。"}, {"type": "subtitle", "time": 9547.19, "timestamp": "02:39:07", "text": "それは、実に不可解な痛みだ。いくつかのように"}, {"type": "subtitle", "time": 9550.23, "timestamp": "02:39:10", "text": "それらのウェブサイトには静的なコンテンツがある。いくつかの"}, {"type": "subtitle", "time": 9553.75, "timestamp": "02:39:13", "text": "彼らが使用する相対的および絶対的なウェブサイト"}, {"type": "subtitle", "time": 9556.71, "timestamp": "02:39:16", "text": "そして全て。私は何だって"}, {"type": "subtitle", "time": 9564.87, "timestamp": "02:39:24", "text": "とても紛らわしい。"}, {"type": "subtitle", "time": 9570.23, "timestamp": "02:39:30", "text": "こういうやり方をする人もいる。そういう人もいる"}, {"type": "subtitle", "time": 9572.87, "timestamp": "02:39:32", "text": "そのように。正しい方法は"}, {"type": "subtitle", "time": 9589.27, "timestamp": "02:39:49", "text": "そうそう。あなたはそういうものを頼んだのね、"}, {"type": "subtitle", "time": 9592.309, "timestamp": "02:39:52", "text": "右？の"}, {"type": "subtitle", "time": 9599.67, "timestamp": "02:39:59", "text": "彼らの市場において。"}]
[{"type": "subtitle", "time": 12121.99, "timestamp": "03:22:01", "text": "それは反応し、すべてが似たような"}, {"type": "subtitle", "time": 12125.19, "timestamp": "03:22:05", "text": "例えば、ラプラスのウェブサイト"}, {"type": "subtitle", "time": 12132.469, "timestamp": "03:22:12", "text": "ラプラに似ているかどうかはわかりません"}, {"type": "subtitle", "time": 12136.229, "timestamp": "03:22:16", "text": "ウェブサイトをクリックすると彼女の目が開きます"}, {"type": "subtitle", "time": 12139.19, "timestamp": "03:22:19", "text": "そして、彼女をクリックすると、"}, {"type": "subtitle", "time": 12143.269, "timestamp": "03:22:23", "text": "彼女はASMRの朝の動画をたくさん投稿しています"}, {"type": "subtitle", "time": 12146.309, "timestamp": "03:22:26", "text": "音は彼女の頭にカチッとはしないけど、うん"}, {"type": "subtitle", "time": 12149.269, "timestamp": "03:22:29", "text": "頭をクリックして撫でたり"}, {"type": "subtitle", "time": 12152.71, "timestamp": "03:22:32", "text": "まあ、何かしらの理由があるんだろうね。"}, {"type": "subtitle", "time": 12155.03, "timestamp": "03:22:35", "text": "そしてこれは、マウスオーバーしたときに良い効果を発揮します"}, {"type": "subtitle", "time": 12157.67, "timestamp": "03:22:37", "text": "その上に。"}, {"type": "subtitle", "time": 12167.59, "timestamp": "03:22:47", "text": "それは知っている。それはとても"}, {"type": "subtitle", "time": 12170.87, "timestamp": "03:22:50", "text": "でも、それは本当に素晴らしいことだよ。いいね、でも"}, {"type": "subtitle", "time": 12173.349, "timestamp": "03:22:53", "text": "ええ、このウェブサイトにはテーマがあります"}, {"type": "subtitle", "time": 12176.07, "timestamp": "03:22:56", "text": "もの。これを見てください。それは"}, {"type": "subtitle", "time": 12178.389, "timestamp": "03:22:58", "text": "テーマはありますが。"}]
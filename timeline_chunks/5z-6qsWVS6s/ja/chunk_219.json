[{"type": "subtitle", "time": 13144.71, "timestamp": "03:39:04", "text": "チャットのこのランクのことは、うん、それは"}, {"type": "subtitle", "time": 13147.83, "timestamp": "03:39:07", "text": "YouTubeに「リーダーボード」という新機能が追加されました。"}, {"type": "subtitle", "time": 13150.87, "timestamp": "03:39:10", "text": "チャットするなら、コメントしてください。ええ、チャットすればね。"}, {"type": "subtitle", "time": 13152.79, "timestamp": "03:39:12", "text": "はい、コメントすると、スーパー"}, {"type": "subtitle", "time": 13155.67, "timestamp": "03:39:15", "text": "チャット、メンバーシップ、すべて、"}, {"type": "subtitle", "time": 13157.51, "timestamp": "03:39:17", "text": "ええと、リーダーボードに載ります"}, {"type": "subtitle", "time": 13163.11, "timestamp": "03:39:23", "text": "こうすれば誰が来るのか全員分かる"}, {"type": "subtitle", "time": 13165.91, "timestamp": "03:39:25", "text": "ストリーミング配信とチャットを行う。"}, {"type": "subtitle", "time": 13170.55, "timestamp": "03:39:30", "text": "それは私のものと同じシステムです"}, {"type": "subtitle", "time": 13173.59, "timestamp": "03:39:33", "text": "Discordの配信参加者向け情報"}, {"type": "subtitle", "time": 13177.75, "timestamp": "03:39:37", "text": "持っている。右。どこですか？えっと、どこですか"}, {"type": "subtitle", "time": 13181.11, "timestamp": "03:39:41", "text": "それ？どこですか？"}, {"type": "subtitle", "time": 13183.19, "timestamp": "03:39:43", "text": "ストリーム参加者と似ています"}, {"type": "subtitle", "time": 13185.11, "timestamp": "03:39:45", "text": "彼らは皆、小川にやって来た。リスト"}, {"type": "subtitle", "time": 13187.83, "timestamp": "03:39:47", "text": "今、この小川にやってきた人々。"}, {"type": "subtitle", "time": 13191.349, "timestamp": "03:39:51", "text": "TwitchやYouTubeも同様です。"}, {"type": "subtitle", "time": 13196.71, "timestamp": "03:39:56", "text": "ああ、カのためにやらなきゃいけないんだ。 O"}]
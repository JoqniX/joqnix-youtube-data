[{"type": "subtitle", "time": 17362.708, "timestamp": "04:49:22", "text": "男。彼らの背景を盗みたい、"}, {"type": "subtitle", "time": 17365.91, "timestamp": "04:49:25", "text": "兄弟。フラクタルノイズは"}, {"type": "subtitle", "time": 17370.39, "timestamp": "04:49:30", "text": "良い。できる限り再現しようと努力しました。"}, {"type": "subtitle", "time": 17372.47, "timestamp": "04:49:32", "text": "えっと、私、何か問題起こしてるのかな？ただ"}, {"type": "subtitle", "time": 17375.35, "timestamp": "04:49:35", "text": "緑色のPNG画像ですよね？私は手に入れるだろうか"}, {"type": "subtitle", "time": 17391.51, "timestamp": "04:49:51", "text": "えっと、"}, {"type": "subtitle", "time": 17394.788, "timestamp": "04:49:54", "text": "それって悪いことじゃない？うん。"}, {"type": "subtitle", "time": 17398.708, "timestamp": "04:49:58", "text": "これはお好きですか？待って、待って、待って。"}]
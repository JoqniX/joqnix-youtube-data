[{"type": "subtitle", "time": 3660.309, "timestamp": "01:01:00", "text": "伝承は"}, {"type": "subtitle", "time": 3663.03, "timestamp": "01:01:03", "text": "ええと、コンサートに基づくと、上椿"}, {"type": "subtitle", "time": 3667.27, "timestamp": "01:01:07", "text": "女の子がする、または漫画や"}, {"type": "subtitle", "time": 3670.309, "timestamp": "01:01:10", "text": "Steamで配信されている小説またはゲーム"}, {"type": "subtitle", "time": 3672.95, "timestamp": "01:01:12", "text": "現在。えっと、神素房樹のリズム"}, {"type": "subtitle", "time": 3675.19, "timestamp": "01:01:15", "text": "ゲームはそこにある。彼らはボーカロイドを持っている"}, {"type": "subtitle", "time": 3677.43, "timestamp": "01:01:17", "text": "あれのことですよね？ Kamiを検索すると"}, {"type": "subtitle", "time": 3681.51, "timestamp": "01:01:21", "text": "スババキでは、都市の再生が行われている。"}, {"type": "subtitle", "time": 3684.789, "timestamp": "01:01:24", "text": "Regenerateはビジュアルノベルのようなものです。"}, {"type": "subtitle", "time": 3686.95, "timestamp": "01:01:26", "text": "ええ、ビジュアルから得たもののいくつか"}, {"type": "subtitle", "time": 3688.87, "timestamp": "01:01:28", "text": "その小説はアニメ化されている。それは"}, {"type": "subtitle", "time": 3691.03, "timestamp": "01:01:31", "text": "アニメに登場します。見ることができます"}, {"type": "subtitle", "time": 3694.63, "timestamp": "01:01:34", "text": "エリアゼロエリアについてもっと世界"}, {"type": "subtitle", "time": 3696.549, "timestamp": "01:01:36", "text": "物を作る。すべてのエリアと"}, {"type": "subtitle", "time": 3699.829, "timestamp": "01:01:39", "text": "すべて。うん。その地域のあらゆること。"}, {"type": "subtitle", "time": 3702.789, "timestamp": "01:01:42", "text": "エリアゼロ、エリアファイブ、エリアシックス、エリアセブン、すべて"}, {"type": "subtitle", "time": 3705.589, "timestamp": "01:01:45", "text": "これらの場所がどのように破壊されたか、"}, {"type": "subtitle", "time": 3709.349, "timestamp": "01:01:49", "text": "何が起こったのか、など。いいえ、種類"}, {"type": "subtitle", "time": 3712.95, "timestamp": "01:01:52", "text": "そんな感じのことです。それで、"}, {"type": "subtitle", "time": 3716.069, "timestamp": "01:01:56", "text": "そう、それは本当に素晴らしいことだ。今、"}, {"type": "subtitle", "time": 3719.109, "timestamp": "01:01:59", "text": "そうですね、アニメではそれについて少し触れています。"}]
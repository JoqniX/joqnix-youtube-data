[{"type": "subtitle", "time": 2700.55, "timestamp": "00:45:00", "text": "ここまで。ここに以下のように置くことができます"}, {"type": "subtitle", "time": 2705.43, "timestamp": "00:45:05", "text": "このウェブサイトではそれが一番上に表示されている。うん。"}, {"type": "subtitle", "time": 2707.43, "timestamp": "00:45:07", "text": "でも、モバイル端末の場合は、"}, {"type": "subtitle", "time": 2709.51, "timestamp": "00:45:09", "text": "ここだ。"}, {"type": "subtitle", "time": 2710.95, "timestamp": "00:45:10", "text": "うん。モバイル端末をご利用の場合は、"}, {"type": "subtitle", "time": 2712.95, "timestamp": "00:45:12", "text": "ここだ。でも、PC の場合は、"}, {"type": "subtitle", "time": 2715.99, "timestamp": "00:45:15", "text": "一番上に置いてください。どうやってやるのか分からない"}, {"type": "subtitle", "time": 2718.79, "timestamp": "00:45:18", "text": "移行処理。"}, {"type": "subtitle", "time": 2720.55, "timestamp": "00:45:20", "text": "おい、それめっちゃかっこいいじゃん。見てみて"}, {"type": "subtitle", "time": 2723.27, "timestamp": "00:45:23", "text": "動的に変化する。あなたは"}, {"type": "subtitle", "time": 2725.75, "timestamp": "00:45:25", "text": "ページを再読み込みしてください。動的に"}, {"type": "subtitle", "time": 2727.91, "timestamp": "00:45:27", "text": "それ。何？"}, {"type": "subtitle", "time": 2731.19, "timestamp": "00:45:31", "text": "それはすごくクールですね。"}, {"type": "subtitle", "time": 2734.39, "timestamp": "00:45:34", "text": "おお。私が通っているゼルはニュージャージー州にあります。"}, {"type": "subtitle", "time": 2743.829, "timestamp": "00:45:43", "text": "ああ、すごくかっこいい。すごくかっこいい。すごくかっこいい。"}, {"type": "subtitle", "time": 2747.349, "timestamp": "00:45:47", "text": "ですから、そうするように努めます。今日はここまで。"}, {"type": "subtitle", "time": 2750.79, "timestamp": "00:45:50", "text": "えっと、それから時間APIも試してみます"}, {"type": "subtitle", "time": 2753.349, "timestamp": "00:45:53", "text": "天気API"}, {"type": "subtitle", "time": 2756.87, "timestamp": "00:45:56", "text": "えーと、天体としての私のテーマに関するもの"}, {"type": "subtitle", "time": 2759.99, "timestamp": "00:45:59", "text": "星座とかそういうの。私はしません"}]
[{"type": "subtitle", "time": 1260.63, "timestamp": "00:21:00", "text": "ローカルでホストすると次のようになります"}, {"type": "subtitle", "time": 1264.39, "timestamp": "00:21:04", "text": "自分のローカルホスト、正しいローカルホスト"}, {"type": "subtitle", "time": 1267.029, "timestamp": "00:21:07", "text": "右。だからビルダーを使って"}, {"type": "subtitle", "time": 1269.27, "timestamp": "00:21:09", "text": "変更を加えた場合、または編集者に渡した場合"}, {"type": "subtitle", "time": 1271.669, "timestamp": "00:21:11", "text": "ウェブエディタか何かで、"}, {"type": "subtitle", "time": 1274.39, "timestamp": "00:21:14", "text": "内容だけを変更するか、"}, {"type": "subtitle", "time": 1276.149, "timestamp": "00:21:16", "text": "デザインをすべて正しく変更してください。それで"}, {"type": "subtitle", "time": 1279.51, "timestamp": "00:21:19", "text": "これはある意味で役に立つ、それが私が"}, {"type": "subtitle", "time": 1282.149, "timestamp": "00:21:22", "text": "たくさんあるので、やろうと思っています"}, {"type": "subtitle", "time": 1285.83, "timestamp": "00:21:25", "text": "私のサイトに欲しいもの。"}, {"type": "subtitle", "time": 1290.149, "timestamp": "00:21:30", "text": "だから、私は、えっと"}, {"type": "subtitle", "time": 1292.47, "timestamp": "00:21:32", "text": "セルフホスティングも含め、すべて自己管理です。だから私は"}, {"type": "subtitle", "time": 1295.909, "timestamp": "00:21:35", "text": "ここに行ってエクスポートしてください。特徴がある"}, {"type": "subtitle", "time": 1298.39, "timestamp": "00:21:38", "text": "Dockerなど、あらゆるものに対応しています。だから私は"}, {"type": "subtitle", "time": 1300.39, "timestamp": "00:21:40", "text": "それ。"}, {"type": "subtitle", "time": 1303.99, "timestamp": "00:21:43", "text": "しかし、使い方は簡単です。うん、"}, {"type": "subtitle", "time": 1309.51, "timestamp": "00:21:49", "text": "Verselも搭載されています。詩があります"}, {"type": "subtitle", "time": 1312.63, "timestamp": "00:21:52", "text": "それは良いことだ。 Verselのエクスポート機能があるので"}, {"type": "subtitle", "time": 1314.549, "timestamp": "00:21:54", "text": "すぐに起動できますし"}, {"type": "subtitle", "time": 1317.35, "timestamp": "00:21:57", "text": "すべて。私もプロプランに加入しています。"}]
[{"type": "subtitle", "time": 10579.429, "timestamp": "02:56:19", "text": "それでは、私たちが何をしたのか確認してみましょう。"}, {"type": "subtitle", "time": 10593.75, "timestamp": "02:56:33", "text": "[音楽]"}, {"type": "subtitle", "time": 10596.87, "timestamp": "02:56:36", "text": "つまり、SMSエリアですね。さて、これは対話です"}, {"type": "subtitle", "time": 10600.389, "timestamp": "02:56:40", "text": "語根ダイアログボタン。そこには"}, {"type": "subtitle", "time": 10603.11, "timestamp": "02:56:43", "text": "対話のトリガーと対話"}, {"type": "subtitle", "time": 10606.469, "timestamp": "02:56:46", "text": "これがオーバーレイです。このオーバーレイでは、"}, {"type": "subtitle", "time": 10609.269, "timestamp": "02:56:49", "text": "私がやったことは"}, {"type": "subtitle", "time": 10612.15, "timestamp": "02:56:52", "text": "ページコンテンツを幅に設定し、"}, {"type": "subtitle", "time": 10615.03, "timestamp": "02:56:55", "text": "身長は100%でした。"}, {"type": "subtitle", "time": 10619.11, "timestamp": "02:56:59", "text": "Z指数は50で、相対的な"}]
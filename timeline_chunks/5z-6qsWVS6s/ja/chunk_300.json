[{"type": "subtitle", "time": 18031.35, "timestamp": "05:00:31", "text": "ああ、これは騎士ではない。これはまるで"}, {"type": "subtitle", "time": 18033.59, "timestamp": "05:00:33", "text": "これはオリジナルです"}, {"type": "subtitle", "time": 18035.67, "timestamp": "05:00:35", "text": "色。"}, {"type": "subtitle", "time": 18039.19, "timestamp": "05:00:39", "text": "名前を変更するにはどうすればいいですか"}, {"type": "subtitle", "time": 18045.83, "timestamp": "05:00:45", "text": "[音楽]"}, {"type": "subtitle", "time": 18048.31, "timestamp": "05:00:48", "text": "宣言文をすべてコピーしてください。ベースを一時停止"}, {"type": "subtitle", "time": 18050.788, "timestamp": "05:00:50", "text": "宣言。"}, {"type": "subtitle", "time": 18054.15, "timestamp": "05:00:54", "text": "わかりました、これをコピーします。"}, {"type": "subtitle", "time": 18056.788, "timestamp": "05:00:56", "text": "やめろ。"}, {"type": "subtitle", "time": 18059.43, "timestamp": "05:00:59", "text": "もう一度作ってください。"}]
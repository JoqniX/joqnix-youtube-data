[{"type": "subtitle", "time": 1020.629, "timestamp": "00:17:00", "text": "待って、Cのウェブサイトにあったと思う。"}, {"type": "subtitle", "time": 1022.629, "timestamp": "00:17:02", "text": "えっと、"}, {"type": "subtitle", "time": 1028.15, "timestamp": "00:17:08", "text": "車のウェブサイトが追加されました、もし私の理解が正しければ、"}, {"type": "subtitle", "time": 1031.59, "timestamp": "00:17:11", "text": "そう、歴史は新しいものだ。歴史は新しい。"}, {"type": "subtitle", "time": 1034.069, "timestamp": "00:17:14", "text": "うん。ええ、タイムラインみたいなのを追加しました"}, {"type": "subtitle", "time": 1035.99, "timestamp": "00:17:15", "text": "あれを見て、「うわあ、これは"}, {"type": "subtitle", "time": 1038.949, "timestamp": "00:17:18", "text": "いいね。私もそう思うよ。うん、私もそう思う。"}, {"type": "subtitle", "time": 1041.909, "timestamp": "00:17:21", "text": "そうですね。ええと、すべて読み込みます。"}, {"type": "subtitle", "time": 1044.87, "timestamp": "00:17:24", "text": "特定のものに絞り込むことができます。"}, {"type": "subtitle", "time": 1048.71, "timestamp": "00:17:28", "text": "良い。私たちがやったことは、2028年に咳がやったことだ"}, {"type": "subtitle", "time": 1053.029, "timestamp": "00:17:33", "text": "2024年に。これはクールだ。いいえ、私は"}, {"type": "subtitle", "time": 1054.95, "timestamp": "00:17:34", "text": "このようなことをする。私"}, {"type": "subtitle", "time": 1057.59, "timestamp": "00:17:37", "text": "こんなことをしたい"}, {"type": "subtitle", "time": 1060.39, "timestamp": "00:17:40", "text": "だから、ショーケースみたいに見せびらかせるんです。しかし、これだけ"}, {"type": "subtitle", "time": 1062.63, "timestamp": "00:17:42", "text": "コンサートなどの本格的なイベントに適しています"}, {"type": "subtitle", "time": 1064.39, "timestamp": "00:17:44", "text": "などなど。"}, {"type": "subtitle", "time": 1066.87, "timestamp": "00:17:46", "text": "何？何？なぜこれを詰まらせる必要があるのか"}, {"type": "subtitle", "time": 1069.75, "timestamp": "00:17:49", "text": "ストリームのような履歴と"}, {"type": "subtitle", "time": 1071.59, "timestamp": "00:17:51", "text": "あれみたいな？それは多すぎる。"}, {"type": "subtitle", "time": 1073.35, "timestamp": "00:17:53", "text": "右？"}, {"type": "subtitle", "time": 1077.35, "timestamp": "00:17:57", "text": "それから、IRL配信者もいました"}, {"type": "subtitle", "time": 1079.43, "timestamp": "00:17:59", "text": "連合と呼ばれている。"}]
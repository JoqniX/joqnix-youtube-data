[{"type": "subtitle", "time": 5880.95, "timestamp": "01:38:00", "text": "N5 なので、補償として、私の"}, {"type": "subtitle", "time": 5884.629, "timestamp": "01:38:04", "text": "私は地元の学校に通っていました"}, {"type": "subtitle", "time": 5888.229, "timestamp": "01:38:08", "text": "都市、そして私は合格しました"}, {"type": "subtitle", "time": 5892.229, "timestamp": "01:38:12", "text": "試験と、応募したのですが、"}, {"type": "subtitle", "time": 5894.79, "timestamp": "01:38:14", "text": "私はまだインタビューなど"}, {"type": "subtitle", "time": 5896.87, "timestamp": "01:38:16", "text": "学位取得のための勉強をしているので、"}, {"type": "subtitle", "time": 5898.87, "timestamp": "01:38:18", "text": "学位の権利だから私は制限されていた"}, {"type": "subtitle", "time": 5901.669, "timestamp": "01:38:21", "text": "語学学校での選択"}, {"type": "subtitle", "time": 5903.83, "timestamp": "01:38:23", "text": "学校のような機会"}, {"type": "subtitle", "time": 5905.669, "timestamp": "01:38:25", "text": "東京、大阪、そういうところ全部。私"}, {"type": "subtitle", "time": 5907.99, "timestamp": "01:38:27", "text": "それらにアクセスできなかったのは、"}, {"type": "subtitle", "time": 5912.55, "timestamp": "01:38:32", "text": "学校ではN5の合格が求められ、"}, {"type": "subtitle", "time": 5915.03, "timestamp": "01:38:35", "text": "学位証明書は私が"}, {"type": "subtitle", "time": 5916.95, "timestamp": "01:38:36", "text": "それを持っていなかったし、私もそうするつもりだった"}, {"type": "subtitle", "time": 5924.39, "timestamp": "01:38:44", "text": "私のN5 JPT N5のやつN5のやつを書いてください。"}, {"type": "subtitle", "time": 5926.87, "timestamp": "01:38:46", "text": "それで、学校は1つしかなかったのですが、"}, {"type": "subtitle", "time": 5931.03, "timestamp": "01:38:51", "text": "GMAで手に入れた幸運な私は"}, {"type": "subtitle", "time": 5933.99, "timestamp": "01:38:53", "text": "最初の面接に合格し、"}, {"type": "subtitle", "time": 5936.709, "timestamp": "01:38:56", "text": "まずは試験も。私は書かなければならなかった"}, {"type": "subtitle", "time": 5938.87, "timestamp": "01:38:58", "text": "チェンナイからの試験。チェンナイと"}]
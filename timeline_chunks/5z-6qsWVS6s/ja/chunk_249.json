[{"type": "subtitle", "time": 14951.11, "timestamp": "04:09:11", "text": "これは何ですか？オーバーフロークリップ。オーバーフロー"}, {"type": "subtitle", "time": 14955.189, "timestamp": "04:09:15", "text": "隠れた。オーバーフローは自動的に表示されます。"}, {"type": "subtitle", "time": 14969.75, "timestamp": "04:09:29", "text": "応募方法は？"}, {"type": "subtitle", "time": 14975.03, "timestamp": "04:09:35", "text": "ああ、フィルターをかけなきゃいけないと思う。"}, {"type": "subtitle", "time": 14978.469, "timestamp": "04:09:38", "text": "右？ぼやけている。"}, {"type": "subtitle", "time": 14980.389, "timestamp": "04:09:40", "text": "えっと、"}, {"type": "subtitle", "time": 14982.79, "timestamp": "04:09:42", "text": "ドロップシャドウ。"}, {"type": "subtitle", "time": 14984.389, "timestamp": "04:09:44", "text": "いいえ"}, {"type": "subtitle", "time": 14989.83, "timestamp": "04:09:49", "text": "優れた。いや、待って。どうすればいいですか"}, {"type": "subtitle", "time": 14996.15, "timestamp": "04:09:56", "text": "ここでブレンドモードを使うにはどうすればいいですか？"}, {"type": "subtitle", "time": 14999.99, "timestamp": "04:09:59", "text": "背景かもしれない。"}]
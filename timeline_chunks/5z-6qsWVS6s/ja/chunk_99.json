[{"type": "subtitle", "time": 5941.91, "timestamp": "01:39:01", "text": "確かバンガロールだったと思います。"}, {"type": "subtitle", "time": 5944.07, "timestamp": "01:39:04", "text": "デリーや"}, {"type": "subtitle", "time": 5946.47, "timestamp": "01:39:06", "text": "すべてにおいて。上へもっと"}, {"type": "subtitle", "time": 5949.75, "timestamp": "01:39:09", "text": "北側も同様です。でも、そう、だから私は"}, {"type": "subtitle", "time": 5952.87, "timestamp": "01:39:12", "text": "チェンナイに行かなきゃいけなくて、"}, {"type": "subtitle", "time": 5955.51, "timestamp": "01:39:15", "text": "試験を受けて合格しました。まるで"}, {"type": "subtitle", "time": 5958.39, "timestamp": "01:39:18", "text": "えーと、日本に行く学生たち"}, {"type": "subtitle", "time": 5961.35, "timestamp": "01:39:21", "text": "4月入学の場合。ええと、彼らも"}, {"type": "subtitle", "time": 5964.87, "timestamp": "01:39:24", "text": "そこには。だから私は、2人くらいの人"}, {"type": "subtitle", "time": 5968.39, "timestamp": "01:39:28", "text": "7月入学分と残りの人たちは"}, {"type": "subtitle", "time": 5971.43, "timestamp": "01:39:31", "text": "残りの6人は4月のような感じだった"}, {"type": "subtitle", "time": 5975.83, "timestamp": "01:39:35", "text": "入学する人たち、私たちは両方とも試験だけです"}, {"type": "subtitle", "time": 5979.99, "timestamp": "01:39:39", "text": "試験に合格したよ、みんな不合格だったけど"}, {"type": "subtitle", "time": 5984.629, "timestamp": "01:39:44", "text": "どういうわけか分からないけど、そう、ほとんどの"}, {"type": "subtitle", "time": 5988.07, "timestamp": "01:39:48", "text": "人々は4月の入学に行きました、ええと"}, {"type": "subtitle", "time": 5990.629, "timestamp": "01:39:50", "text": "アカデミーの人たちは私にこう言っていた"}, {"type": "subtitle", "time": 5992.629, "timestamp": "01:39:52", "text": "ええ、彼らのほとんどは苦しんでいます"}, {"type": "subtitle", "time": 5995.99, "timestamp": "01:39:55", "text": "彼らの言語は弱く、すべてが"}, {"type": "subtitle", "time": 5999.91, "timestamp": "01:39:59", "text": "そして彼らはあなたにパートタイムの仕事を与えてくれる"}]
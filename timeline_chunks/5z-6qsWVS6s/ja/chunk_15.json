[{"type": "subtitle", "time": 903.75, "timestamp": "00:15:03", "text": "2Dライブ3D3Dボイドワンchすべて"}, {"type": "subtitle", "time": 912.55, "timestamp": "00:15:12", "text": "ファンダムのWikiはこちらで見ることができます"}, {"type": "subtitle", "time": 915.35, "timestamp": "00:15:15", "text": "えっと、ポートレート版みたいなちびキャラ版"}, {"type": "subtitle", "time": 917.03, "timestamp": "00:15:17", "text": "バージョン"}, {"type": "subtitle", "time": 921.269, "timestamp": "00:15:21", "text": "最初の頭文字、この頭文字、PNG"}, {"type": "subtitle", "time": 924.23, "timestamp": "00:15:24", "text": "そして虚無の者。扇風機を置く必要がある"}, {"type": "subtitle", "time": 927.59, "timestamp": "00:15:27", "text": "どこかにアートがあるよね？それもある"}, {"type": "subtitle", "time": 931.11, "timestamp": "00:15:31", "text": "作業中。そして、ウィキペディアを更新する必要がある"}, {"type": "subtitle", "time": 932.87, "timestamp": "00:15:32", "text": "それもまた。私は言及していません"}, {"type": "subtitle", "time": 935.509, "timestamp": "00:15:35", "text": "ジョアトンイベントについて。もし私が"}, {"type": "subtitle", "time": 938.389, "timestamp": "00:15:38", "text": "書くには、どこかに書いておかなければならない"}, {"type": "subtitle", "time": 941.11, "timestamp": "00:15:41", "text": "ここで言及しなければならないのは"}, {"type": "subtitle", "time": 944.389, "timestamp": "00:15:44", "text": "イベントですよね？えっと、これは何のイベントですか？"}, {"type": "subtitle", "time": 947.03, "timestamp": "00:15:47", "text": "右。私はそれを書かなければならない"}, {"type": "subtitle", "time": 949.59, "timestamp": "00:15:49", "text": "だって、でも私はそれをやるつもりだ"}, {"type": "subtitle", "time": 951.749, "timestamp": "00:15:51", "text": "チャカトンは一年中正しい"}, {"type": "subtitle", "time": 953.35, "timestamp": "00:15:53", "text": "あれ"}, {"type": "subtitle", "time": 955.749, "timestamp": "00:15:55", "text": "モデル開発のための資金提供など、すべて。それで"}, {"type": "subtitle", "time": 957.509, "timestamp": "00:15:57", "text": "私たちがやったことをすべて載せます"}, {"type": "subtitle", "time": 959.829, "timestamp": "00:15:59", "text": "月。同じことが"}]
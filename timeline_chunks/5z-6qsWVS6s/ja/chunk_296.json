[{"type": "subtitle", "time": 17760.56, "timestamp": "04:56:00", "text": "というわけで、ダイアログオーバーレイ機能を手に入れました。"}, {"type": "subtitle", "time": 17762.07, "timestamp": "04:56:02", "text": "[音楽]"}, {"type": "subtitle", "time": 17765.03, "timestamp": "04:56:05", "text": "問題は"}, {"type": "subtitle", "time": 17775.99, "timestamp": "04:56:15", "text": "ああ、それを変数にできるよ。私は作ることができます"}, {"type": "subtitle", "time": 17777.75, "timestamp": "04:56:17", "text": "それは変数です。わかった。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 17780.55, "timestamp": "04:56:20", "text": "わかった。待って。それを変数にすることができます。"}, {"type": "subtitle", "time": 17783.99, "timestamp": "04:56:23", "text": "おお。おお。おお。おお。おお。これを"}, {"type": "subtitle", "time": 17785.83, "timestamp": "04:56:25", "text": "変数。"}, {"type": "subtitle", "time": 17791.67, "timestamp": "04:56:31", "text": "待って。グローバルルート。ここに来て。"}, {"type": "subtitle", "time": 17795.75, "timestamp": "04:56:35", "text": "背景として"}, {"type": "subtitle", "time": 17798.868, "timestamp": "04:56:38", "text": "背景。はい、アクセントカードを入手しました"}, {"type": "subtitle", "time": 17801.11, "timestamp": "04:56:41", "text": "主要、二次、前景。わかりました、"}, {"type": "subtitle", "time": 17804.47, "timestamp": "04:56:44", "text": "背景を描くことができます。"}, {"type": "subtitle", "time": 17807.11, "timestamp": "04:56:47", "text": "新しいものを作ることができます。"}]
[{"type": "subtitle", "time": 13628.95, "timestamp": "03:47:08", "text": "それはスクロール操作によるものだけどね"}, {"type": "subtitle", "time": 13633.03, "timestamp": "03:47:13", "text": "まだキーフレームは設定されていません。"}, {"type": "subtitle", "time": 13635.51, "timestamp": "03:47:15", "text": "えっと"}, {"type": "subtitle", "time": 13645.11, "timestamp": "03:47:25", "text": "Hノイズ発生器に使用される可能性がある。私"}, {"type": "subtitle", "time": 13664.79, "timestamp": "03:47:44", "text": "わかった。アニメーション関連。私"}, {"type": "subtitle", "time": 13666.87, "timestamp": "03:47:46", "text": "ああ、アニメーショングループに参加しないといけないんだ。"}, {"type": "subtitle", "time": 13676.309, "timestamp": "03:47:56", "text": "私に試させてください"}, {"type": "subtitle", "time": 13679.269, "timestamp": "03:47:59", "text": "入れる"}]
[{"type": "subtitle", "time": 7140.87, "timestamp": "01:59:00", "text": "Mixcloudとか昔のもの全部"}, {"type": "subtitle", "time": 7144.39, "timestamp": "01:59:04", "text": "またはYouTubeのミックスなどですが"}, {"type": "subtitle", "time": 7147.51, "timestamp": "01:59:07", "text": "ええ、それができなかったので、"}, {"type": "subtitle", "time": 7150.95, "timestamp": "01:59:10", "text": "一種のコミュニティのようなものになった。 Onxのもの"}, {"type": "subtitle", "time": 7153.589, "timestamp": "01:59:13", "text": "それはかつて私のコミュニティ名でした。"}, {"type": "subtitle", "time": 7156.79, "timestamp": "01:59:16", "text": "そして私は気づいた、そして最終的に私たちは"}, {"type": "subtitle", "time": 7159.43, "timestamp": "01:59:19", "text": "私たちはキャラクターを作りました。"}, {"type": "subtitle", "time": 7162.709, "timestamp": "01:59:22", "text": "昨日は私の昨日は最初は"}, {"type": "subtitle", "time": 7167.51, "timestamp": "01:59:27", "text": "オニキス。オニキス、または現在の名前はカエス"}, {"type": "subtitle", "time": 7171.03, "timestamp": "01:59:31", "text": "彼女の誕生日は昨日だった。だから私の父は"}, {"type": "subtitle", "time": 7174.39, "timestamp": "01:59:34", "text": "誕生日は7月4日です。それで7月5日、私は"}, {"type": "subtitle", "time": 7178.47, "timestamp": "01:59:38", "text": "セシルのために取っておいたよ、もしできるなら"}, {"type": "subtitle", "time": 7180.79, "timestamp": "01:59:40", "text": "見せてあげて。えっと"}, {"type": "subtitle", "time": 7183.35, "timestamp": "01:59:43", "text": "私の理解が正しければ。待って、私はこれを正しく使った"}, {"type": "subtitle", "time": 7188.31, "timestamp": "01:59:48", "text": "そう、セシルの誕生日だったんだ。セシル"}, {"type": "subtitle", "time": 7192.07, "timestamp": "01:59:52", "text": "えっと、これは別のキャラクターです。彼女は彼女は"}, {"type": "subtitle", "time": 7196.47, "timestamp": "01:59:56", "text": "女王。紫色の頭の男性、または魔法使いの女性。"}, {"type": "subtitle", "time": 7198.79, "timestamp": "01:59:58", "text": "彼女は魔法使いだ。"}]
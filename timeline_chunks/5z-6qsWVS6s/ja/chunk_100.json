[{"type": "subtitle", "time": 6002.229, "timestamp": "01:40:02", "text": "言語のように、日本では今や必須となっている"}, {"type": "subtitle", "time": 6005.83, "timestamp": "01:40:05", "text": "学校部分は必須なので28"}, {"type": "subtitle", "time": 6010.55, "timestamp": "01:40:10", "text": "パートタイムの週あたりの時間数ですね。"}, {"type": "subtitle", "time": 6012.47, "timestamp": "01:40:12", "text": "ええ、そういう学生もいました"}, {"type": "subtitle", "time": 6016.07, "timestamp": "01:40:16", "text": "ホームシックなのでアカデミーの人たちは"}, {"type": "subtitle", "time": 6018.87, "timestamp": "01:40:18", "text": "日本へ送るだけです"}, {"type": "subtitle", "time": 6021.35, "timestamp": "01:40:21", "text": "あなたが取るものについて全責任を負います"}, {"type": "subtitle", "time": 6024.39, "timestamp": "01:40:24", "text": "日本に着くまで、あなたの持ち物"}, {"type": "subtitle", "time": 6026.31, "timestamp": "01:40:26", "text": "言語を卒業するまで"}, {"type": "subtitle", "time": 6028.149, "timestamp": "01:40:28", "text": "学校ですね、だから気をつけなければなりません"}, {"type": "subtitle", "time": 6031.27, "timestamp": "01:40:31", "text": "あなたに関することはすべて、"}, {"type": "subtitle", "time": 6033.27, "timestamp": "01:40:33", "text": "lang academy の人々は、"}, {"type": "subtitle", "time": 6036.47, "timestamp": "01:40:36", "text": "書面による謝罪、例えば"}, {"type": "subtitle", "time": 6038.79, "timestamp": "01:40:38", "text": "校長先生と生徒のためのすべて"}, {"type": "subtitle", "time": 6040.55, "timestamp": "01:40:40", "text": "ケースでは、1人の学生が"}, {"type": "subtitle", "time": 6042.229, "timestamp": "01:40:42", "text": "ホームシックだったので、"}, {"type": "subtitle", "time": 6043.75, "timestamp": "01:40:43", "text": "校長先生にどうするかを相談する"}, {"type": "subtitle", "time": 6046.55, "timestamp": "01:40:46", "text": "学生の中に、えーと"}, {"type": "subtitle", "time": 6049.59, "timestamp": "01:40:49", "text": "パフォーマンスが非常に悪く、パートタイムだったので"}, {"type": "subtitle", "time": 6053.75, "timestamp": "01:40:53", "text": "アカデミーは会議をしなければならなかった"}, {"type": "subtitle", "time": 6057.51, "timestamp": "01:40:57", "text": "パートタイムまたは仕事のオーナー"}, {"type": "subtitle", "time": 6059.189, "timestamp": "01:40:59", "text": "コンビニだったと思う。彼らは"}]
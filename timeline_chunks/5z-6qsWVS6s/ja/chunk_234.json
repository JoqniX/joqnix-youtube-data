[{"type": "subtitle", "time": 14044.07, "timestamp": "03:54:04", "text": "わかった。わかった。だから、私ができることは"}, {"type": "subtitle", "time": 14048.95, "timestamp": "03:54:08", "text": "いくつか繰り返しておこう。"}, {"type": "subtitle", "time": 14052.309, "timestamp": "03:54:12", "text": "これを別の色のようにして"}, {"type": "subtitle", "time": 14060.79, "timestamp": "03:54:20", "text": "そして、スクロール可能になる"}, {"type": "subtitle", "time": 14067.349, "timestamp": "03:54:27", "text": "私はそれを望んでいません。それは私が"}, {"type": "subtitle", "time": 14069.269, "timestamp": "03:54:29", "text": "それが欲しい。えっと、"}, {"type": "subtitle", "time": 14073.189, "timestamp": "03:54:33", "text": "相対性を使うべきでしょうか？"}, {"type": "subtitle", "time": 14078.389, "timestamp": "03:54:38", "text": "レイヤー分けしたいんだけど。"}, {"type": "subtitle", "time": 14080.63, "timestamp": "03:54:40", "text": "とにかく、私たちはそれをアニメーション化しようとしていました。"}, {"type": "subtitle", "time": 14082.63, "timestamp": "03:54:42", "text": "右？"}]
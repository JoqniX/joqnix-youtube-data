[{"type": "subtitle", "time": 18131.35, "timestamp": "05:02:11", "text": "背景を削除しましょう。背景：夜"}, {"type": "subtitle", "time": 18133.99, "timestamp": "05:02:13", "text": "青とピンク。右。私たちはそうしました"}, {"type": "subtitle", "time": 18136.07, "timestamp": "05:02:16", "text": "ここ。"}, {"type": "subtitle", "time": 18139.11, "timestamp": "05:02:19", "text": "これは青とピンクです"}, {"type": "subtitle", "time": 18157.91, "timestamp": "05:02:37", "text": "こことここに貼り付けてください。いいえ、コピーします"}, {"type": "subtitle", "time": 18172.47, "timestamp": "05:02:52", "text": "モ、何色がいいかな？朝。"}]
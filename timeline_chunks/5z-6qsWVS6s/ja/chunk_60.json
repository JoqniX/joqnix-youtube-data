[{"type": "subtitle", "time": 3601.349, "timestamp": "01:00:01", "text": "現在放送中のアニメは"}, {"type": "subtitle", "time": 3605.109, "timestamp": "01:00:05", "text": "上すばき放送"}, {"type": "subtitle", "time": 3607.03, "timestamp": "01:00:07", "text": "えっと、これは現在放送中です"}, {"type": "subtitle", "time": 3610.63, "timestamp": "01:00:10", "text": "エピソードゼロは最近公開されました"}, {"type": "subtitle", "time": 3614.47, "timestamp": "01:00:14", "text": "神羽木ってやつ、えっと、放送されると思うんだけど"}, {"type": "subtitle", "time": 3618.39, "timestamp": "01:00:18", "text": "毎週木曜日にエピソードゼロが公開されました"}, {"type": "subtitle", "time": 3621.75, "timestamp": "01:00:21", "text": "それは、えっと、それについて話されたようなものでした"}, {"type": "subtitle", "time": 3625.589, "timestamp": "01:00:25", "text": "どのように"}, {"type": "subtitle", "time": 3627.43, "timestamp": "01:00:27", "text": "彼らの"}, {"type": "subtitle", "time": 3630.789, "timestamp": "01:00:30", "text": "ええと、評価のようなものです。それは"}, {"type": "subtitle", "time": 3633.349, "timestamp": "01:00:33", "text": "なぜなら、私はそれが"}, {"type": "subtitle", "time": 3635.91, "timestamp": "01:00:35", "text": "3Dアニメーションをどうぞ。人々は気に入らなかった"}, {"type": "subtitle", "time": 3638.95, "timestamp": "01:00:38", "text": "3Dアニメーションとか、そういう類のもの。うん、"}, {"type": "subtitle", "time": 3641.589, "timestamp": "01:00:41", "text": "これはカファンです"}, {"type": "subtitle", "time": 3644.789, "timestamp": "01:00:44", "text": "覇気。彼女が誰なのか知らない。うん、そうだね"}, {"type": "subtitle", "time": 3649.27, "timestamp": "01:00:49", "text": "法律のように、"}, {"type": "subtitle", "time": 3653.91, "timestamp": "01:00:53", "text": "神須賀ファンのような人たちは、"}, {"type": "subtitle", "time": 3656.47, "timestamp": "01:00:56", "text": "ストーリーボードとか、理論構築みたいなもの"}]
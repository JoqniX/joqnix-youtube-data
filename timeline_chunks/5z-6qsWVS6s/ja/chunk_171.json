[{"type": "subtitle", "time": 10261.59, "timestamp": "02:51:01", "text": "そんな風に働くんだ。"}, {"type": "subtitle", "time": 10266.309, "timestamp": "02:51:06", "text": "うん。うん。私も同じことをしました"}, {"type": "subtitle", "time": 10270.469, "timestamp": "02:51:10", "text": "シャワーも浴びる。私はSammyを使って自動化しました。"}, {"type": "subtitle", "time": 10274.79, "timestamp": "02:51:14", "text": "ええと、かなり前のことだったと思います"}, {"type": "subtitle", "time": 10278.63, "timestamp": "02:51:18", "text": "私がビリー・ビリーをやっていた頃。"}, {"type": "subtitle", "time": 10282.87, "timestamp": "02:51:22", "text": "ああ、ビリービリー。"}, {"type": "subtitle", "time": 10302.469, "timestamp": "02:51:42", "text": "請求書の流れ。ええ、今のところこんな感じです"}, {"type": "subtitle", "time": 10305.269, "timestamp": "02:51:45", "text": "ライブ。だから、私がやったことは、私が持っているカスタム"}, {"type": "subtitle", "time": 10307.83, "timestamp": "02:51:47", "text": "Discordのカスタムアクティビティとして"}, {"type": "subtitle", "time": 10311.51, "timestamp": "02:51:51", "text": "良い。そうすれば人々は私がライブ配信中だと知るだろう"}, {"type": "subtitle", "time": 10314.71, "timestamp": "02:51:54", "text": "ビリービリー、そのタイトルは私の"}, {"type": "subtitle", "time": 10317.51, "timestamp": "02:51:57", "text": "ええと、流線型"}, {"type": "subtitle", "time": 10319.67, "timestamp": "02:51:59", "text": "HLSリンクとガイドラインも同様です。"}]
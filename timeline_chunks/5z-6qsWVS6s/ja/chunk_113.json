[{"type": "subtitle", "time": 6781.27, "timestamp": "01:53:01", "text": "良い考えでしょうか、それとも待つべきでしょうか？"}, {"type": "subtitle", "time": 6783.43, "timestamp": "01:53:03", "text": "コンテンツに焦点を当てる？コンテンツ制作に取り掛かる。"}, {"type": "subtitle", "time": 6786.79, "timestamp": "01:53:06", "text": "私と同じ過ちを犯さないでください。構築に焦点を当てる"}, {"type": "subtitle", "time": 6790.07, "timestamp": "01:53:10", "text": "あなたのコミュニティ、そしてその他すべて。初め"}, {"type": "subtitle", "time": 6792.39, "timestamp": "01:53:12", "text": "良い、停滞したコミュニティを持つ。あなたが知っている、"}, {"type": "subtitle", "time": 6794.55, "timestamp": "01:53:14", "text": "「古くなった」という言葉を使うのは適切ではありません。"}, {"type": "subtitle", "time": 6797.75, "timestamp": "01:53:17", "text": "安定したコミュニティとか、えっと、誰が"}, {"type": "subtitle", "time": 6800.07, "timestamp": "01:53:20", "text": "そこにいて、活動的で、魅力的で、"}, {"type": "subtitle", "time": 6802.79, "timestamp": "01:53:22", "text": "すべてを行い、さらに一歩踏み出す"}, {"type": "subtitle", "time": 6805.03, "timestamp": "01:53:25", "text": "グッズとか、そういうもの全部。"}, {"type": "subtitle", "time": 6808.229, "timestamp": "01:53:28", "text": "もしくは、もしあなたが望むなら"}, {"type": "subtitle", "time": 6811.109, "timestamp": "01:53:31", "text": "それを行うには、いつでも第四の壁を利用すればよい。"}, {"type": "subtitle", "time": 6812.709, "timestamp": "01:53:32", "text": "Twitchストリーマーの中には、"}, {"type": "subtitle", "time": 6816.229, "timestamp": "01:53:36", "text": "第四の壁。例えば、サイは"}, {"type": "subtitle", "time": 6819.99, "timestamp": "01:53:39", "text": "慢性化。彼女は第四の壁を破る。彼女"}, {"type": "subtitle", "time": 6823.669, "timestamp": "01:53:43", "text": "第四の壁のページがあります。"}, {"type": "subtitle", "time": 6825.83, "timestamp": "01:53:45", "text": "彼女には第四の壁のページがある。どこ"}, {"type": "subtitle", "time": 6828.55, "timestamp": "01:53:48", "text": "それ？彼女は変わったのか？"}, {"type": "subtitle", "time": 6830.229, "timestamp": "01:53:50", "text": "わかった。"}, {"type": "subtitle", "time": 6836.95, "timestamp": "01:53:56", "text": "1秒。えっと"}, {"type": "subtitle", "time": 6839.83, "timestamp": "01:53:59", "text": "彼女は第四の壁のページを持っています。"}]
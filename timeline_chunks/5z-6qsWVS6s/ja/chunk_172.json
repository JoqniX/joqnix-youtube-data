[{"type": "subtitle", "time": 10322.469, "timestamp": "02:52:02", "text": "ビリービリー、人々は"}, {"type": "subtitle", "time": 10325.51, "timestamp": "02:52:05", "text": "中国語の読み方を知っているリンク"}, {"type": "subtitle", "time": 10328.469, "timestamp": "02:52:08", "text": "翻訳ツールと小冊子"}, {"type": "subtitle", "time": 10331.19, "timestamp": "02:52:11", "text": "WCのストリームリンクを抽出するため"}, {"type": "subtitle", "time": 10334.309, "timestamp": "02:52:14", "text": "あれとYouTubeのページ"}, {"type": "subtitle", "time": 10336.309, "timestamp": "02:52:16", "text": "ビリーのアーカイブ用プレイリスト"}, {"type": "subtitle", "time": 10339.19, "timestamp": "02:52:19", "text": "村の小川を、私は昔はこんな風に描いていた。"}, {"type": "subtitle", "time": 10342.309, "timestamp": "02:52:22", "text": "配信後、私は"}, {"type": "subtitle", "time": 10344.87, "timestamp": "02:52:24", "text": "要約みたいなもの。"}, {"type": "subtitle", "time": 10347.59, "timestamp": "02:52:27", "text": "これは私が以前やっていたことです。そして私は立ち止まった"}, {"type": "subtitle", "time": 10351.269, "timestamp": "02:52:31", "text": "こんな余分なことをするのは、"}, {"type": "subtitle", "time": 10354.71, "timestamp": "02:52:34", "text": "今は余計なものが多すぎる。"}, {"type": "subtitle", "time": 10357.349, "timestamp": "02:52:37", "text": "あれをするのが懐かしい。"}, {"type": "subtitle", "time": 10361.11, "timestamp": "02:52:41", "text": "ああ、痛い。埋め込み機能を復活させる必要がある"}, {"type": "subtitle", "time": 10364.15, "timestamp": "02:52:44", "text": "お知らせみたいなもの。"}, {"type": "subtitle", "time": 10366.79, "timestamp": "02:52:46", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 10373.51, "timestamp": "02:52:53", "text": "うん、明日までにDMするよ"}, {"type": "subtitle", "time": 10376.15, "timestamp": "02:52:56", "text": "そのことについてですが、でもね、わかりますか？"}, {"type": "subtitle", "time": 10379.91, "timestamp": "02:52:59", "text": "私は今すぐそれをします"}]
[{"type": "subtitle", "time": 1321.11, "timestamp": "00:22:01", "text": "右？そうですね、"}, {"type": "subtitle", "time": 1324.07, "timestamp": "00:22:04", "text": "もし私がそうしたら、えっと、"}, {"type": "subtitle", "time": 1326.549, "timestamp": "00:22:06", "text": "その特注の棚は設置されているんですよね？私はできる"}, {"type": "subtitle", "time": 1330.789, "timestamp": "00:22:10", "text": "まるでベイプラップサイトのように、"}, {"type": "subtitle", "time": 1333.11, "timestamp": "00:22:13", "text": "彼らが使っていることに気づいた"}, {"type": "subtitle", "time": 1335.75, "timestamp": "00:22:15", "text": "コマンドとメニューの検索"}, {"type": "subtitle", "time": 1337.99, "timestamp": "00:22:17", "text": "あれ。これらすべてのことですよね？どうやって"}, {"type": "subtitle", "time": 1340.47, "timestamp": "00:22:20", "text": "彼らはデータベース関連のあらゆるものを持っている"}, {"type": "subtitle", "time": 1344.47, "timestamp": "00:22:24", "text": "ビリービリーウィジェット（ラプラチャットなど）"}, {"type": "subtitle", "time": 1347.27, "timestamp": "00:22:27", "text": "明らかな時計ログイン同期すべて"}, {"type": "subtitle", "time": 1350.149, "timestamp": "00:22:30", "text": "AI関連のものすべて、ここにあるものすべて"}, {"type": "subtitle", "time": 1353.19, "timestamp": "00:22:33", "text": "まさに自分たちの支店でこれは"}, {"type": "subtitle", "time": 1356.31, "timestamp": "00:22:36", "text": "高度にコーディングされたウェブサイト ラップレス"}, {"type": "subtitle", "time": 1360.23, "timestamp": "00:22:40", "text": "スケジュールも含め、生活も"}, {"type": "subtitle", "time": 1363.909, "timestamp": "00:22:43", "text": "この件に関しては、私はこういうことができる"}, {"type": "subtitle", "time": 1367.35, "timestamp": "00:22:47", "text": "自分でホストする場合もカスタムではないので、"}, {"type": "subtitle", "time": 1369.59, "timestamp": "00:22:49", "text": "もの。"}, {"type": "subtitle", "time": 1371.669, "timestamp": "00:22:51", "text": "うん、ちょっとやりすぎだよね。見てください"}, {"type": "subtitle", "time": 1373.909, "timestamp": "00:22:53", "text": "これ。でも、これ、すごく気に入ってるんだ。その"}]
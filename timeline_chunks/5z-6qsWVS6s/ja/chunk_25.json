[{"type": "subtitle", "time": 1501.75, "timestamp": "00:25:01", "text": "ここにいる。ちょうど私が持っているように"}, {"type": "subtitle", "time": 1505.909, "timestamp": "00:25:05", "text": "YouTubeやTwitchのチャットはこんな感じです。"}, {"type": "subtitle", "time": 1509.19, "timestamp": "00:25:09", "text": "あなたのチャットも確認​​済みです。"}, {"type": "subtitle", "time": 1512.31, "timestamp": "00:25:12", "text": "そして、あなたには独自のスレッドシステムもあります。"}, {"type": "subtitle", "time": 1516.71, "timestamp": "00:25:16", "text": "チャットの内容はすべてここに記録されています。私"}, {"type": "subtitle", "time": 1519.99, "timestamp": "00:25:19", "text": "これはサミー経由で行いました。そう、だから"}, {"type": "subtitle", "time": 1522.07, "timestamp": "00:25:22", "text": "私はその方が安心です。だからこれは"}, {"type": "subtitle", "time": 1525.19, "timestamp": "00:25:25", "text": "管理などにも役立ちます。"}, {"type": "subtitle", "time": 1527.11, "timestamp": "00:25:27", "text": "節度とか色々、そうしよう"}, {"type": "subtitle", "time": 1529.75, "timestamp": "00:25:29", "text": "何か忘れ物をしたと言ってください。私も持っています"}, {"type": "subtitle", "time": 1532.95, "timestamp": "00:25:32", "text": "リマインダーのようなものも、"}, {"type": "subtitle", "time": 1535.51, "timestamp": "00:25:35", "text": "YouTubeで飲むと言っているよりも凍っている"}, {"type": "subtitle", "time": 1537.43, "timestamp": "00:25:37", "text": "温水"}, {"type": "subtitle", "time": 1540.71, "timestamp": "00:25:40", "text": "そして、サタカンのように覚えておいてください"}, {"type": "subtitle", "time": 1543.029, "timestamp": "00:25:43", "text": "水は大切なもののように飲むべきだ。今"}, {"type": "subtitle", "time": 1545.83, "timestamp": "00:25:45", "text": "チャットの参加者はこれを実行できます"}, {"type": "subtitle", "time": 1549.35, "timestamp": "00:25:49", "text": "感嘆符 ジョックに思い出させる"}, {"type": "subtitle", "time": 1555.99, "timestamp": "00:25:55", "text": "これはリマインダーなどに役立ちます"}, {"type": "subtitle", "time": 1557.909, "timestamp": "00:25:57", "text": "例えば、私がプレイすることになっているとしましょう"}]
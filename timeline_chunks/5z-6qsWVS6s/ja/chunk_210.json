[{"type": "subtitle", "time": 12600.389, "timestamp": "03:30:00", "text": "ウェブシリーズに組み込まれているフィルターを使用できます。"}, {"type": "subtitle", "time": 12603.51, "timestamp": "03:30:03", "text": "わかった。グラデーションが待っています"}, {"type": "subtitle", "time": 12605.91, "timestamp": "03:30:05", "text": "ウェブスタジオをチェックさせてください"}, {"type": "subtitle", "time": 12612.469, "timestamp": "03:30:12", "text": "グラデーションになると思う"}, {"type": "subtitle", "time": 12617.11, "timestamp": "03:30:17", "text": "スライダー。彼らはそれについて話していた"}, {"type": "subtitle", "time": 12619.67, "timestamp": "03:30:19", "text": "私の理解が正しければ。"}, {"type": "subtitle", "time": 12630.95, "timestamp": "03:30:30", "text": "彼らはそのことについて話していた。えっと"}, {"type": "subtitle", "time": 12633.91, "timestamp": "03:30:33", "text": "そして彼らは私が"}, {"type": "subtitle", "time": 12647.51, "timestamp": "03:30:47", "text": "[音楽]"}, {"type": "subtitle", "time": 12654.79, "timestamp": "03:30:54", "text": "建築設計のグラデーションにあると思います。"}, {"type": "subtitle", "time": 12657.11, "timestamp": "03:30:57", "text": "勾配"}, {"type": "subtitle", "time": 12659.75, "timestamp": "03:30:59", "text": "地元スタイル"}]
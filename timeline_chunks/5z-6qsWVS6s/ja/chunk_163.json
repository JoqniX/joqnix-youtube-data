[{"type": "subtitle", "time": 9780.87, "timestamp": "02:43:00", "text": "サーバー内で話さないと"}, {"type": "subtitle", "time": 9784.71, "timestamp": "02:43:04", "text": "サーバーに潜伏してDMをスパムするだけ"}, {"type": "subtitle", "time": 9787.99, "timestamp": "02:43:07", "text": "メンバーリストに載っているすべての人"}, {"type": "subtitle", "time": 9792.469, "timestamp": "02:43:12", "text": "GFXアーティストなどが自分の作品を販売している"}, {"type": "subtitle", "time": 9796.79, "timestamp": "02:43:16", "text": "など。それで、私は、私は、"}, {"type": "subtitle", "time": 9799.19, "timestamp": "02:43:19", "text": "Twitterでグラフィック関連のアカウントを持っている人も忘れないでください。うん"}, {"type": "subtitle", "time": 9801.51, "timestamp": "02:43:21", "text": "Twitterにはグラフィックデザイナーがたくさんいる"}, {"type": "subtitle", "time": 9811.67, "timestamp": "02:43:31", "text": "そしてGF輸出は、私たちの、ええと、原因となる"}, {"type": "subtitle", "time": 9815.03, "timestamp": "02:43:35", "text": "私たちインド人の間では評判が悪い"}, {"type": "subtitle", "time": 9817.83, "timestamp": "02:43:37", "text": "だって、それはまるでテクニカルサポート詐欺みたいなんだもん"}, {"type": "subtitle", "time": 9820.389, "timestamp": "02:43:40", "text": "マイクロソフトの詐欺みたいなやつ"}, {"type": "subtitle", "time": 9828.309, "timestamp": "02:43:48", "text": "ある意味、誰かが深い"}, {"type": "subtitle", "time": 9831.19, "timestamp": "02:43:51", "text": "このGFXの人たちは気づいた"}, {"type": "subtitle", "time": 9834.63, "timestamp": "02:43:54", "text": "それはまるで人々の集まりのようだ"}, {"type": "subtitle", "time": 9836.55, "timestamp": "02:43:56", "text": "または会社内の人々のグループまたは"}]
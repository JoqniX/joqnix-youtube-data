[{"type": "subtitle", "time": 4681.27, "timestamp": "01:18:01", "text": "詰まったのは、ビデオのようだった"}, {"type": "subtitle", "time": 4683.669, "timestamp": "01:18:03", "text": "右側のすべてのショットとビデオ"}, {"type": "subtitle", "time": 4687.27, "timestamp": "01:18:07", "text": "きっと私はめちゃくちゃになるだろうね。うん、そうだよ。"}, {"type": "subtitle", "time": 4689.35, "timestamp": "01:18:09", "text": "本当に面倒くさいし、YouTube は良い"}, {"type": "subtitle", "time": 4692.55, "timestamp": "01:18:12", "text": "こうなるようにしたんだ。それは"}, {"type": "subtitle", "time": 4695.669, "timestamp": "01:18:15", "text": "混乱。ええ、それが唯一の理由でした"}, {"type": "subtitle", "time": 4699.59, "timestamp": "01:18:19", "text": "私はためらった。ええと、そうだったらよかったのに"}, {"type": "subtitle", "time": 4702.87, "timestamp": "01:18:22", "text": "似たようなものが好きになる方法があります"}, {"type": "subtitle", "time": 4705.43, "timestamp": "01:18:25", "text": "プレイリスト。これでタグシステムのようなものを導入できます"}, {"type": "subtitle", "time": 4708.149, "timestamp": "01:18:28", "text": "ビデオセッションか何かのためにここにいます"}, {"type": "subtitle", "time": 4711.43, "timestamp": "01:18:31", "text": "ビリー・ビリーが持っているはずです。もし私が"}, {"type": "subtitle", "time": 4713.83, "timestamp": "01:18:33", "text": "ビリービリーのところへ行って、"}, {"type": "subtitle", "time": 4716.47, "timestamp": "01:18:36", "text": "もし私がビリービリーのところへ行ったら、"}, {"type": "subtitle", "time": 4720.47, "timestamp": "01:18:40", "text": "えっと、もし私がビリー・ビリー・Vに行ったら、ですよね？私"}, {"type": "subtitle", "time": 4722.55, "timestamp": "01:18:42", "text": "ビリー・ビリーも持っていると思う"}, {"type": "subtitle", "time": 4724.63, "timestamp": "01:18:44", "text": "もの。私は自分のYouTube動画をすべてアップロードしています"}, {"type": "subtitle", "time": 4726.95, "timestamp": "01:18:46", "text": "ストリーム、YouTube、Twitchのストリームはこちら。それで"}, {"type": "subtitle", "time": 4729.35, "timestamp": "01:18:49", "text": "動画セクションみたいに、ですよね？もし"}, {"type": "subtitle", "time": 4731.83, "timestamp": "01:18:51", "text": "のような可能性もある"}, {"type": "subtitle", "time": 4734.39, "timestamp": "01:18:54", "text": "このようなタグシステムは本当に"}, {"type": "subtitle", "time": 4737.27, "timestamp": "01:18:57", "text": "いい感じですね。あ、待って。私はそうは思わない 私はそうは思わない"}, {"type": "subtitle", "time": 4739.59, "timestamp": "01:18:59", "text": "彼らはタグを持っていると思う。ここだったのか？"}]
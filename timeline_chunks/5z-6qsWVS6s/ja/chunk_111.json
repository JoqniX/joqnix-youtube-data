[{"type": "subtitle", "time": 6660.95, "timestamp": "01:51:00", "text": "決済ゲートウェイとその他すべて"}, {"type": "subtitle", "time": 6662.95, "timestamp": "01:51:02", "text": "物やあらゆるものが必要なのはなぜ"}, {"type": "subtitle", "time": 6665.75, "timestamp": "01:51:05", "text": "ラグが発生しています。こんにちは。"}, {"type": "subtitle", "time": 6668.229, "timestamp": "01:51:08", "text": "ええ、それで、なぜラグが発生するのですか、こんにちは。"}, {"type": "subtitle", "time": 6670.55, "timestamp": "01:51:10", "text": "これを閉じる"}, {"type": "subtitle", "time": 6673.27, "timestamp": "01:51:13", "text": "ああ、ここで閉じなければならない、それは"}, {"type": "subtitle", "time": 6676.629, "timestamp": "01:51:16", "text": "あなたが幸運な理由"}, {"type": "subtitle", "time": 6679.75, "timestamp": "01:51:19", "text": "これを閉じる、うん、これら全部立つように"}, {"type": "subtitle", "time": 6681.91, "timestamp": "01:51:21", "text": "ダッキーマクラ、彼らが持っているこれらのものすべて"}, {"type": "subtitle", "time": 6683.669, "timestamp": "01:51:23", "text": "今"}, {"type": "subtitle", "time": 6686.07, "timestamp": "01:51:26", "text": "一度睡眠をとれば、"}, {"type": "subtitle", "time": 6688.229, "timestamp": "01:51:28", "text": "オーナーと、一度やらなければならないこと"}, {"type": "subtitle", "time": 6689.75, "timestamp": "01:51:29", "text": "GST（消費税）など、すべて含めてね"}, {"type": "subtitle", "time": 6692.07, "timestamp": "01:51:32", "text": "支払い方法は以下のとおりです"}, {"type": "subtitle", "time": 6695.189, "timestamp": "01:51:35", "text": "電話決済、Google決済、これが私が欲しいものです"}, {"type": "subtitle", "time": 6698.229, "timestamp": "01:51:38", "text": "私のウェブサイトのために"}, {"type": "subtitle", "time": 6702.149, "timestamp": "01:51:42", "text": "私の側で遅延が発生しています 2 a"}, {"type": "subtitle", "time": 6705.109, "timestamp": "01:51:45", "text": "遅延に気づいてるよ。ああ、そうだね。"}, {"type": "subtitle", "time": 6708.79, "timestamp": "01:51:48", "text": "パソコンが壊れかけていると思う。"}, {"type": "subtitle", "time": 6711.91, "timestamp": "01:51:51", "text": "はい、82です。理由はわかりませんが、"}, {"type": "subtitle", "time": 6716.31, "timestamp": "01:51:56", "text": "うん。ああ、でもそうだね。えっと"}, {"type": "subtitle", "time": 6719.03, "timestamp": "0
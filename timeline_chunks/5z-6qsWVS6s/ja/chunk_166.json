[{"type": "subtitle", "time": 9960.95, "timestamp": "02:46:00", "text": "待って、これ使えるよ。私は必要ない"}, {"type": "subtitle", "time": 9963.19, "timestamp": "02:46:03", "text": "私専用のものを作ってください。私はただ奪うだけです"}, {"type": "subtitle", "time": 9969.269, "timestamp": "02:46:09", "text": "何てことだ。音声録音開始。ああ、これ"}, {"type": "subtitle", "time": 9992.87, "timestamp": "02:46:32", "text": "認証を行う必要があります。おお。"}, {"type": "subtitle", "time": 10001.429, "timestamp": "02:46:41", "text": "不和。不和。不和。このカード。おお"}, {"type": "subtitle", "time": 10003.269, "timestamp": "02:46:43", "text": "ああ、認証が多すぎる"}, {"type": "subtitle", "time": 10006.469, "timestamp": "02:46:46", "text": "もの。とても紛らわしい。私は17個くらい持っています"}, {"type": "subtitle", "time": 10009.11, "timestamp": "02:46:49", "text": "このカードのアカウントは、私のメイン"}, {"type": "subtitle", "time": 10012.07, "timestamp": "02:46:52", "text": "アカウントがいっぱいです。メインアカウントがいっぱいです"}, {"type": "subtitle", "time": 10013.59, "timestamp": "02:46:53", "text": "満杯。"}]
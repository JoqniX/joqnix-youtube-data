[{"type": "subtitle", "time": 13994.229, "timestamp": "03:53:14", "text": "なぜ私の思い通りに動かないのか"}, {"type": "subtitle", "time": 14005.349, "timestamp": "03:53:25", "text": "ダイアログが溢れました。"}, {"type": "subtitle", "time": 14006.95, "timestamp": "03:53:26", "text": "えっと、"}, {"type": "subtitle", "time": 14009.59, "timestamp": "03:53:29", "text": "思ったように動作していない。"}, {"type": "subtitle", "time": 14013.349, "timestamp": "03:53:33", "text": "私はこれいらない。"}, {"type": "subtitle", "time": 14021.75, "timestamp": "03:53:41", "text": "ああ、それはコラムだからですね。もしも"}, {"type": "subtitle", "time": 14023.51, "timestamp": "03:53:43", "text": "それはブロックですか？ああ、作らなきゃ"}, {"type": "subtitle", "time": 14033.91, "timestamp": "03:53:53", "text": "わかった。ブロックとして配置する場合。"}, {"type": "subtitle", "time": 14037.269, "timestamp": "03:53:57", "text": "はい、赤色の意味はわかりました。はい。もし私がそれを作ったら"}, {"type": "subtitle", "time": 14039.91, "timestamp": "03:53:59", "text": "透明になっているので、古い背景が見える。"}]
[{"type": "subtitle", "time": 13740.469, "timestamp": "03:49:00", "text": "ああ、条件付きでできるよ"}, {"type": "subtitle", "time": 13746.15, "timestamp": "03:49:06", "text": "わかった。わかった。わかった。わかった。わかった。だから、"}, {"type": "subtitle", "time": 13757.189, "timestamp": "03:49:17", "text": "レックスから東京へ"}, {"type": "subtitle", "time": 13759.99, "timestamp": "03:49:19", "text": "東京"}, {"type": "subtitle", "time": 13765.189, "timestamp": "03:49:25", "text": "形式。いいえ。フォーマットはどのようなものですか？"}, {"type": "subtitle", "time": 13768.469, "timestamp": "03:49:28", "text": "東京＋28。"}, {"type": "subtitle", "time": 13771.03, "timestamp": "03:49:31", "text": "今は夜のはずなのに。私にさせて"}, {"type": "subtitle", "time": 13779.11, "timestamp": "03:49:39", "text": "天気に関する話題。"}, {"type": "subtitle", "time": 13782.389, "timestamp": "03:49:42", "text": "ああ、これはなかなか良いですね。"}, {"type": "subtitle", "time": 13786.07, "timestamp": "03:49:46", "text": "すごいね。"}, {"type": "subtitle", "time": 13789.269, "timestamp": "03:49:49", "text": "おお。夜。それは表示しますか"}, {"type": "subtitle", "time": 13792.07, "timestamp": "03:49:52", "text": "待って、待って、待って、待って。私は自分のためにできる"}, {"type": "subtitle", "time": 13795.269, "timestamp": "03:49:55", "text": "使用事例。月の周期を利用できます。"}, {"type": "subtitle", "time": 13798.79, "timestamp": "03:49:58", "text": "月の顔、ですよね？私は星座です。"}]
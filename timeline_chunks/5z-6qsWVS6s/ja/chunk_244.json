[{"type": "subtitle", "time": 14641.03, "timestamp": "04:04:01", "text": "これは今"}, {"type": "subtitle", "time": 14644.229, "timestamp": "04:04:04", "text": "しばらくすれば終わるよ。それは"}, {"type": "subtitle", "time": 14651.51, "timestamp": "04:04:11", "text": "これってすぐに終わるよね？私たちには必要だ"}, {"type": "subtitle", "time": 14654.389, "timestamp": "04:04:14", "text": "それを続けること。"}, {"type": "subtitle", "time": 14657.59, "timestamp": "04:04:17", "text": "いや、でも大丈夫だよ。私たちはそうしないと思います"}, {"type": "subtitle", "time": 14659.91, "timestamp": "04:04:19", "text": "今はアニメーションが必要です。ウェブの場合"}, {"type": "subtitle", "time": 14662.79, "timestamp": "04:04:22", "text": "スタジオが追加する、私が追加することもできるし、"}, {"type": "subtitle", "time": 14666.229, "timestamp": "04:04:26", "text": "もちろん、私ができることを書いてもいいですよ"}, {"type": "subtitle", "time": 14670.389, "timestamp": "04:04:30", "text": "今は div に id のように配置され、"}, {"type": "subtitle", "time": 14674.07, "timestamp": "04:04:34", "text": "クラスですよね？ HTML埋め込みを使用してください。使用"}, {"type": "subtitle", "time": 14676.15, "timestamp": "04:04:36", "text": "カスタムコード"}, {"type": "subtitle", "time": 14680.389, "timestamp": "04:04:40", "text": "キーフレーム。 AI から取得すると"}, {"type": "subtitle", "time": 14683.91, "timestamp": "04:04:43", "text": "無限にするためのコード。"}, {"type": "subtitle", "time": 14687.11, "timestamp": "04:04:47", "text": "しかし、私はウェブサイトCのようにしたかったのです"}, {"type": "subtitle", "time": 14691.03, "timestamp": "04:04:51", "text": "このようなウェブサイト。"}, {"type": "subtitle", "time": 14693.83, "timestamp": "04:04:53", "text": "それは私にもできることです。うん、"}, {"type": "subtitle", "time": 14696.95, "timestamp": "04:04:56", "text": "私たちの場合は、ただ見ているだけでした"}]
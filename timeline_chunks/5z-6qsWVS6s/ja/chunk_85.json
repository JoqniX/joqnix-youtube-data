[{"type": "subtitle", "time": 5102.39, "timestamp": "01:25:02", "text": "10GBを超えるファイルをアップロードすることはできません。えっと、"}, {"type": "subtitle", "time": 5104.149, "timestamp": "01:25:04", "text": "また"}, {"type": "subtitle", "time": 5107.11, "timestamp": "01:25:07", "text": "期間制限もあります。ストリーム用"}, {"type": "subtitle", "time": 5109.189, "timestamp": "01:25:09", "text": "そして、ビデオコンテンツは、"}, {"type": "subtitle", "time": 5112.87, "timestamp": "01:25:12", "text": "10時間以内ですよね？だから私が"}, {"type": "subtitle", "time": 5114.79, "timestamp": "01:25:14", "text": "もし私が12時間くらい働いていたとしたら"}, {"type": "subtitle", "time": 5117.59, "timestamp": "01:25:17", "text": "配信のために、2つのパートに分ける必要がありました。一部"}, {"type": "subtitle", "time": 5121.11, "timestamp": "01:25:21", "text": "1つ目、パート2、それを2つに分割する。"}, {"type": "subtitle", "time": 5123.03, "timestamp": "01:25:23", "text": "そうですね、"}, {"type": "subtitle", "time": 5125.83, "timestamp": "01:25:25", "text": "いろいろあったのに、今になって変わってしまった。"}, {"type": "subtitle", "time": 5129.35, "timestamp": "01:25:29", "text": "今、私には10万人のファンが必要なんだ"}, {"type": "subtitle", "time": 5133.669, "timestamp": "01:25:33", "text": "レベル3の場合。おい、一体どうやって"}, {"type": "subtitle", "time": 5136.629, "timestamp": "01:25:36", "text": "このプラットフォームは素晴らしいビューです"}, {"type": "subtitle", "time": 5140.07, "timestamp": "01:25:40", "text": "ビューやエンゲージメントなど、"}, {"type": "subtitle", "time": 5142.39, "timestamp": "01:25:42", "text": "それらの数字は方向付けられています。"}, {"type": "subtitle", "time": 5144.39, "timestamp": "01:25:44", "text": "彼らにはレベルアップシステムがあります"}, {"type": "subtitle", "time": 5146.229, "timestamp": "01:25:46", "text": "ストリーマーと彼らはレベルアップしている"}, {"type": "subtitle", "time": 5149.11, "timestamp": "01:25:49", "text": "通常のコンテンツのためのシステム"}, {"type": "subtitle", "time": 5153.189, "timestamp": "01:25:53", "text": "動画アップロード者も同様です。ストリーマー向け"}, {"type": "subtitle", "time": 5156.229, "timestamp": "01:25:56", "text": "レベリングシステム、ライブに行くと"}]
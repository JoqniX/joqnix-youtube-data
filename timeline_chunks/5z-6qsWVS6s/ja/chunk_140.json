[{"type": "subtitle", "time": 8403.11, "timestamp": "02:20:03", "text": "えーと"}, {"type": "subtitle", "time": 8404.71, "timestamp": "02:20:04", "text": "あなたはブランディングのことしか言及しない。うん。"}, {"type": "subtitle", "time": 8406.55, "timestamp": "02:20:06", "text": "ええ、まだあなたには話していませんでしたね。"}, {"type": "subtitle", "time": 8410.23, "timestamp": "02:20:10", "text": "あなたにそのことを聞こうと思っていたんです。だから私は"}, {"type": "subtitle", "time": 8415.27, "timestamp": "02:20:15", "text": "時間 API を使用しているように感じます。"}, {"type": "subtitle", "time": 8419.349, "timestamp": "02:20:19", "text": "時間 API と天気 API に基づいて"}, {"type": "subtitle", "time": 8422.23, "timestamp": "02:20:22", "text": "つまり、ある意味では、考えてみると"}, {"type": "subtitle", "time": 8425.429, "timestamp": "02:20:25", "text": "これは自動ダイナミックライトモードのようなものです"}, {"type": "subtitle", "time": 8429.19, "timestamp": "02:20:29", "text": "ダークモードのやつ"}, {"type": "subtitle", "time": 8431.59, "timestamp": "02:20:31", "text": "はい、これはダイナミックライトモードで、"}, {"type": "subtitle", "time": 8434.07, "timestamp": "02:20:34", "text": "ダークモードのやつ、もしあなたが"}, {"type": "subtitle", "time": 8436.87, "timestamp": "02:20:36", "text": "よく考えてみて、正直に言って"}, {"type": "subtitle", "time": 8439.99, "timestamp": "02:20:39", "text": "ライトモードのようにして"}, {"type": "subtitle", "time": 8443.59, "timestamp": "02:20:43", "text": "えっと、ライトモードとライトモードと、"}, {"type": "subtitle", "time": 8447.27, "timestamp": "02:20:47", "text": "ダークモードボタンはスイッチのようなものです"}, {"type": "subtitle", "time": 8452.87, "timestamp": "02:20:52", "text": "ブラウザには時間APIがありますか？え、何だって？"}, {"type": "subtitle", "time": 8456.55, "timestamp": "02:20:56", "text": "ブラウザの時刻 API ユーザーは、あなたが時間を提供します"}]
[{"type": "subtitle", "time": 422.71, "timestamp": "00:07:02", "text": "画面を切り替えてお見せしますね。えっと、"}, {"type": "subtitle", "time": 424.95, "timestamp": "00:07:04", "text": "ウェブスタジオが何かわからない場合は、"}, {"type": "subtitle", "time": 427.589, "timestamp": "00:07:07", "text": "えっと、これが私のサイトです。これらすべては"}, {"type": "subtitle", "time": 430.469, "timestamp": "00:07:10", "text": "Web Studioで作成しました。えーと、このサイト、"}, {"type": "subtitle", "time": 433.029, "timestamp": "00:07:13", "text": "特に私のためにデザインしました"}, {"type": "subtitle", "time": 435.189, "timestamp": "00:07:15", "text": "オーバーレイはできません、私のものが見えません"}, {"type": "subtitle", "time": 437.189, "timestamp": "00:07:17", "text": "私が使用しているオーバーレイが原因です。うん、"}, {"type": "subtitle", "time": 438.79, "timestamp": "00:07:18", "text": "このサイトは特に"}, {"type": "subtitle", "time": 441.99, "timestamp": "00:07:21", "text": "僕の推しの一人からインスピレーションを受けた"}, {"type": "subtitle", "time": 449.11, "timestamp": "00:07:29", "text": "ところで、Kには神崎の人々が"}, {"type": "subtitle", "time": 451.909, "timestamp": "00:07:31", "text": "今シーズン放送される彼らのアニメ。お願いします"}, {"type": "subtitle", "time": 455.189, "timestamp": "00:07:35", "text": "ぜひ見てください。本当に素晴らしいアニメです。"}, {"type": "subtitle", "time": 457.83, "timestamp": "00:07:37", "text": "ご覧のとおり、Kのウェブサイトは現在"}, {"type": "subtitle", "time": 461.11, "timestamp": "00:07:41", "text": "オーバーレイ。ああ、でも、その上でどうやって"}, {"type": "subtitle", "time": 462.71, "timestamp": "00:07:42", "text": "私のものを隠すには、私のものを隠すボタンが必要です"}, {"type": "subtitle", "time": 464.79, "timestamp": "00:07:44", "text": "かぶせる。でも、確かに似ているところもある"}, {"type": "subtitle", "time": 466.79, "timestamp": "00:07:46", "text": "設定。これはカスタムだと思います"}, {"type": "subtitle", "time": 469.51, "timestamp": "00:07:49", "text": "WordPress のやつ。だから私は"}, {"type": "subtitle", "time": 471.749, "timestamp": "00:07:51", "text": "これに触発されて、それを再現しようと試みました"}, {"type": "subtitle", "time": 475.99, "timestamp": "00:07:55", "text": "ウェブスタジオにて。だから私は最善を尽くしました"}, {"type": "subtitle", "time": 478.71, "timestamp": "00:07:58", "text": "私がウェブスタジオをやろ
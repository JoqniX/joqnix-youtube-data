[{"type": "subtitle", "time": 4861.43, "timestamp": "01:21:01", "text": "中国のプラットフォーム、これらすべて"}, {"type": "subtitle", "time": 4863.51, "timestamp": "01:21:03", "text": "タイトルを英語にすること"}, {"type": "subtitle", "time": 4865.83, "timestamp": "01:21:05", "text": "字幕も何もない。"}, {"type": "subtitle", "time": 4868.87, "timestamp": "01:21:08", "text": "いいえ、それは無効なコンテンツと見なされます。"}, {"type": "subtitle", "time": 4871.59, "timestamp": "01:21:11", "text": "無効なアップロードか何か"}, {"type": "subtitle", "time": 4873.27, "timestamp": "01:21:13", "text": "人々。"}, {"type": "subtitle", "time": 4875.91, "timestamp": "01:21:15", "text": "えっと、いくつか代理店を探していたんです"}, {"type": "subtitle", "time": 4878.39, "timestamp": "01:21:18", "text": "もしくは、私を迎えに来てくれる人、私は"}, {"type": "subtitle", "time": 4881.27, "timestamp": "01:21:21", "text": "外国人のための外国人。たくさんあります"}, {"type": "subtitle", "time": 4883.43, "timestamp": "01:21:23", "text": "我が神よ。もし私が"}, {"type": "subtitle", "time": 4887.11, "timestamp": "01:21:27", "text": "このプラットフォームには制限があるんだよ、兄弟。"}, {"type": "subtitle", "time": 4890.63, "timestamp": "01:21:30", "text": "何てことだ。私はジョアソンの件をやっていました。"}, {"type": "subtitle", "time": 4892.55, "timestamp": "01:21:32", "text": "ジョアソンみたいなのはサバソンみたいなもので、"}, {"type": "subtitle", "time": 4894.229, "timestamp": "01:21:34", "text": "そう、Twitchとかで配信してるよね？"}, {"type": "subtitle", "time": 4897.43, "timestamp": "01:21:37", "text": "まるで私が生きているような"}, {"type": "subtitle", "time": 4900.229, "timestamp": "01:21:40", "text": "24時間365日体制ってことですよね？そして私は寝る"}, {"type": "subtitle", "time": 4904.229, "timestamp": "01:21:44", "text": "ストリームとかそういうやつだよね？だから、兄弟、君"}, {"type": "subtitle", "time": 4906.79, "timestamp": "01:21:46", "text": "配信中は眠れない。 AFK（離席）はできません"}, {"type": "subtitle", "time": 4908.79, "timestamp": "01:21:48", "text": "10分以上ストリーム配信している"}, {"type": "subtitle", "time": 4910.709, "timestamp": "01:21:50", "text": "または5分。もしあなたが"}, {"type": "subtitle", "time": 4913.11, "timestamp": "01:21:53", "text": "ストリームか何かで、どうしても欲しいんです"}, {"type": "subtitle", "time": 4915.51, "timestamp": "01:21:55", "text": "視覚的に、あるいは何かで言うと、"}, {"type": "subtitle", "time": 4918.709, "timestamp": "01:21:58", "text": "管理者は私の"}]
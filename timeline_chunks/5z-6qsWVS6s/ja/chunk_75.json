[{"type": "subtitle", "time": 4502.95, "timestamp": "01:15:02", "text": "私はその中のすべてにブランドを付けなければならない"}, {"type": "subtitle", "time": 4505.669, "timestamp": "01:15:05", "text": "その基準は今ではビデオに関しても、"}, {"type": "subtitle", "time": 4509.03, "timestamp": "01:15:09", "text": "すべて、しかし私の、私のものは"}, {"type": "subtitle", "time": 4514.229, "timestamp": "01:15:14", "text": "私はまだ、"}, {"type": "subtitle", "time": 4516.87, "timestamp": "01:15:16", "text": "まだ何も投稿していません。それで"}, {"type": "subtitle", "time": 4520.31, "timestamp": "01:15:20", "text": "私は、ええと、条件付きで来ることができました。"}, {"type": "subtitle", "time": 4523.11, "timestamp": "01:15:23", "text": "私が始めたときから"}, {"type": "subtitle", "time": 4526.95, "timestamp": "01:15:26", "text": "ジョッカソンみたいなやつ。私は、えっと、試してみました"}, {"type": "subtitle", "time": 4529.27, "timestamp": "01:15:29", "text": "何かアップロードするのが一番です。それは"}, {"type": "subtitle", "time": 4531.27, "timestamp": "01:15:31", "text": "私のショーツとかは"}, {"type": "subtitle", "time": 4535.43, "timestamp": "01:15:35", "text": "インスタグラムとか、YouTubeとか、そういうやつ。全て"}, {"type": "subtitle", "time": 4536.95, "timestamp": "01:15:36", "text": "たとえ低いとしても"}, {"type": "subtitle", "time": 4539.83, "timestamp": "01:15:39", "text": "品質は良好だが、編集はほとんど行われていない。ただ"}, {"type": "subtitle", "time": 4543.35, "timestamp": "01:15:43", "text": "レイアウトを縦方向にリサイズする"}, {"type": "subtitle", "time": 4546.79, "timestamp": "01:15:46", "text": "あれのことですよね？たとえこうであっても、"}, {"type": "subtitle", "time": 4549.189, "timestamp": "01:15:49", "text": "アップロードしてよかった"}, {"type": "subtitle", "time": 4552.55, "timestamp": "01:15:52", "text": "何か。私はアップロードに反対でした"}, {"type": "subtitle", "time": 4554.709, "timestamp": "01:15:54", "text": "ショートパンツ。私は、"}, {"type": "subtitle", "time": 4557.83, "timestamp": "01:15:57", "text": "メインチャンネルに私の動画やコンテンツをアップしています。"}]
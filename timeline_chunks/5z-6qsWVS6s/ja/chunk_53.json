[{"type": "subtitle", "time": 3180.549, "timestamp": "00:53:00", "text": "あまりにも。ゲームの準備ができたら、"}, {"type": "subtitle", "time": 3182.63, "timestamp": "00:53:02", "text": "ビジュアルノベルみたいなもの、"}, {"type": "subtitle", "time": 3186.309, "timestamp": "00:53:06", "text": "そこにも。想像してみてください"}, {"type": "subtitle", "time": 3190.069, "timestamp": "00:53:10", "text": "このアイデアでできること"}, {"type": "subtitle", "time": 3192.15, "timestamp": "00:53:12", "text": "うん。うん。うん。忘れない方が良い"}, {"type": "subtitle", "time": 3193.75, "timestamp": "00:53:13", "text": "彼ら。うん。うん。うん。つまり、それは"}, {"type": "subtitle", "time": 3196.549, "timestamp": "00:53:16", "text": "いつも私の心の中に。問題は、私にはできないということです"}, {"type": "subtitle", "time": 3199.829, "timestamp": "00:53:19", "text": "全て自分でやる。あなたには"}, {"type": "subtitle", "time": 3203.589, "timestamp": "00:53:23", "text": "チームの人々。いいえ、だから私はやめたんです"}, {"type": "subtitle", "time": 3206.79, "timestamp": "00:53:26", "text": "私のOnexiaのアイテムは、"}, {"type": "subtitle", "time": 3210.309, "timestamp": "00:53:30", "text": "うん、チームが必要だ"}, {"type": "subtitle", "time": 3212.79, "timestamp": "00:53:32", "text": "たくさんの人。いいえ、"}, {"type": "subtitle", "time": 3217.51, "timestamp": "00:53:37", "text": "大きなもの、例えば、"}, {"type": "subtitle", "time": 3220.79, "timestamp": "00:53:40", "text": "ゲームの設定や音楽など、"}, {"type": "subtitle", "time": 3224.069, "timestamp": "00:53:44", "text": "アート、漫画、何でも、音楽、何でも。"}, {"type": "subtitle", "time": 3227.67, "timestamp": "00:53:47", "text": "OnXとは何ですか？ OnXは、えっと、どうすればいいですか"}, {"type": "subtitle", "time": 3230.95, "timestamp": "00:53:50", "text": "えっと、どう言えばいいの？私"}, {"type": "subtitle", "time": 3234.549, "timestamp": "00:53:54", "text": "これをこの中に入れたっけ？"}, {"type": "subtitle", "time": 3237.67, "timestamp": "00:53:57", "text": "私がここに置いたっけ？"}, {"type": "subtitle", "time": 3239.99, "timestamp": "00:53:59", "text": "そうですね。うん。だからそれは与えるようなものだ"}]
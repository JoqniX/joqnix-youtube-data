[{"type": "subtitle", "time": 4920.79, "timestamp": "01:22:00", "text": "ストリームと"}, {"type": "subtitle", "time": 4923.43, "timestamp": "01:22:03", "text": "警告を送ってください"}, {"type": "subtitle", "time": 4926.31, "timestamp": "01:22:06", "text": "活動していない。 AFK警告、否定的"}, {"type": "subtitle", "time": 4929.43, "timestamp": "01:22:09", "text": "ストリーミング配信に関するガイドライン警告。うん。だから私は"}, {"type": "subtitle", "time": 4932.39, "timestamp": "01:22:12", "text": "警告が多すぎて"}, {"type": "subtitle", "time": 4936.79, "timestamp": "01:22:16", "text": "ああ、なんてことだ、私は1つでBANされた"}, {"type": "subtitle", "time": 4938.95, "timestamp": "01:22:18", "text": "週。"}, {"type": "subtitle", "time": 4942.55, "timestamp": "01:22:22", "text": "ああ、外国人としては、本当に大変だった。"}, {"type": "subtitle", "time": 4945.11, "timestamp": "01:22:25", "text": "しかし、彼らには理解できない。私"}, {"type": "subtitle", "time": 4947.99, "timestamp": "01:22:27", "text": "私は中国語も知らないのに、"}, {"type": "subtitle", "time": 4950.629, "timestamp": "01:22:30", "text": "中国語（北京語）私は中国語が分かりません。私はできません"}, {"type": "subtitle", "time": 4953.99, "timestamp": "01:22:33", "text": "画面上の翻訳機能を使うことさえあります"}, {"type": "subtitle", "time": 4957.03, "timestamp": "01:22:37", "text": "なぜなら、それは私のことを全く理解していないからだ。"}, {"type": "subtitle", "time": 4960.629, "timestamp": "01:22:40", "text": "理由がわからない。マイクロソフトを試してみました"}, {"type": "subtitle", "time": 4963.99, "timestamp": "01:22:43", "text": "音声認識機能。試してみました"}, {"type": "subtitle", "time": 4967.11, "timestamp": "01:22:47", "text": "ジムークちゃんのやつを試してみました。私は試した"}, {"type": "subtitle", "time": 4969.83, "timestamp": "01:22:49", "text": "もっと忍者が文字起こしをする。私は試した"}, {"type": "subtitle", "time": 4973.27, "timestamp": "01:22:53", "text": "AIモデル関連のものがたくさん。それで、これについては"}, {"type": "subtitle", "time": 4976.95, "timestamp": "01:22:56", "text": "ローカルの llm を理解するために"}, {"type": "subtitle", "time": 4979.59, "timestamp": "01:22:59", "text": "言語みたいなもの。あらゆることを試しました"}]
[{"type": "subtitle", "time": 14400.15, "timestamp": "04:00:00", "text": "緩和。"}, {"type": "subtitle", "time": 14407.51, "timestamp": "04:00:07", "text": "範囲の問題です"}, {"type": "subtitle", "time": 14412.63, "timestamp": "04:00:12", "text": "これを安定させる必要がある。どこにある"}, {"type": "subtitle", "time": 14416.309, "timestamp": "04:00:16", "text": "アニメーションエンジン関連のものですか？"}, {"type": "subtitle", "time": 14418.63, "timestamp": "04:00:18", "text": "アニメーションエンジンの例。勉強しましょう"}, {"type": "subtitle", "time": 14424.15, "timestamp": "04:00:24", "text": "[音楽]"}, {"type": "subtitle", "time": 14435.429, "timestamp": "04:00:35", "text": "間隔"}, {"type": "subtitle", "time": 14438.469, "timestamp": "04:00:38", "text": "ページが読み込まれたとき、またはページが読み込まれたときに任意の要素"}, {"type": "subtitle", "time": 14449.269, "timestamp": "04:00:49", "text": "適切な期間です。私は理解しています"}, {"type": "subtitle", "time": 14457.269, "timestamp": "04:00:57", "text": "えっと"}]
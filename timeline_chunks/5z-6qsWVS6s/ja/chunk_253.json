[{"type": "subtitle", "time": 15182.229, "timestamp": "04:13:02", "text": "こんな感じのやつ。"}, {"type": "subtitle", "time": 15185.03, "timestamp": "04:13:05", "text": "これにより、"}, {"type": "subtitle", "time": 15195.429, "timestamp": "04:13:15", "text": "柔らかな光っていいよね。"}, {"type": "subtitle", "time": 15197.51, "timestamp": "04:13:17", "text": "もしくは、私の好きなもの。"}, {"type": "subtitle", "time": 15199.91, "timestamp": "04:13:19", "text": "うん。"}, {"type": "subtitle", "time": 15202.63, "timestamp": "04:13:22", "text": "最終的に、私たちはこれを"}, {"type": "subtitle", "time": 15209.51, "timestamp": "04:13:29", "text": "うん。そして私は電話がかかってくるかもしれないと感じています"}, {"type": "subtitle", "time": 15212.87, "timestamp": "04:13:32", "text": "彼らの…をコピーしたら問題になるかもしれない"}, {"type": "subtitle", "time": 15215.03, "timestamp": "04:13:35", "text": "ノイズのことですよね？私は自分で作ります"}, {"type": "subtitle", "time": 15218.229, "timestamp": "04:13:38", "text": "たぶん、ノイズ系の音だと思う。"}, {"type": "subtitle", "time": 15222.229, "timestamp": "04:13:42", "text": "読みやすいですね。はい、"}, {"type": "subtitle", "time": 15229.59, "timestamp": "04:13:49", "text": "背景テクスチャ"}, {"type": "subtitle", "time": 15232.309, "timestamp": "04:13:52", "text": "そしてアップロードしてください。今、"}, {"type": "subtitle", "time": 15235.429, "timestamp": "04:13:55", "text": "これはどうやって作るのですか？"}, {"type": "subtitle", "time": 15238.55, "timestamp": "04:13:58", "text": "音を出す方法"}]
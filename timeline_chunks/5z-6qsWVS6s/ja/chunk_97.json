[{"type": "subtitle", "time": 5820.229, "timestamp": "01:37:00", "text": "それから私の"}, {"type": "subtitle", "time": 5822.79, "timestamp": "01:37:02", "text": "延長すると、私は、"}, {"type": "subtitle", "time": 5826.79, "timestamp": "01:37:06", "text": "たくさんの人が、えーと、"}, {"type": "subtitle", "time": 5828.47, "timestamp": "01:37:08", "text": "それを作り、それを望んだ人々は"}, {"type": "subtitle", "time": 5830.709, "timestamp": "01:37:10", "text": "スケジュール変更とか、その他諸々。だから私はこう思った"}, {"type": "subtitle", "time": 5833.59, "timestamp": "01:37:13", "text": "うん、私の予定が延長されたから、"}, {"type": "subtitle", "time": 5836.229, "timestamp": "01:37:16", "text": "後でやってもいいよ。私は連絡を取った"}, {"type": "subtitle", "time": 5839.35, "timestamp": "01:37:19", "text": "200人以上いたと思います。うん"}, {"type": "subtitle", "time": 5841.51, "timestamp": "01:37:21", "text": "これらは保留中の人々のようなものです。私は思う"}, {"type": "subtitle", "time": 5844.629, "timestamp": "01:37:24", "text": "私はまだ彼らとコラボレーションできます"}, {"type": "subtitle", "time": 5847.83, "timestamp": "01:37:27", "text": "もうすぐだ。今はもっと持っているからだと思う"}, {"type": "subtitle", "time": 5850.79, "timestamp": "01:37:30", "text": "時間。いいえ、そうでない人もいます"}, {"type": "subtitle", "time": 5853.03, "timestamp": "01:37:33", "text": "これに対してまだ返答がない。 5つだと思います"}, {"type": "subtitle", "time": 5856.149, "timestamp": "01:37:36", "text": "人々がそれを喜んで行うだろう。だから私は"}, {"type": "subtitle", "time": 5858.149, "timestamp": "01:37:38", "text": "ここに置いてください。"}, {"type": "subtitle", "time": 5861.189, "timestamp": "01:37:41", "text": "ええ、そこで日本語を勉強する予定です。"}, {"type": "subtitle", "time": 5865.109, "timestamp": "01:37:45", "text": "現在、私はN5レベルです。 N5に合格しました"}, {"type": "subtitle", "time": 5867.99, "timestamp": "01:37:47", "text": "そして私はNAT試験を受けました。"}, {"type": "subtitle", "time": 5872.149, "timestamp": "01:37:52", "text": "えっと、NATじゃないよ。えっと、NAT試験を受けたから。"}, {"type": "subtitle", "time": 5875.91, "timestamp": "01:37:55", "text": "それはQ5で、N5 JPTに相当します。"}]
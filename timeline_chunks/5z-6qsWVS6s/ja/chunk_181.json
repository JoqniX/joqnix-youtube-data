[{"type": "subtitle", "time": 10880.79, "timestamp": "03:01:20", "text": "ちょっと待って。彼らには"}, {"type": "subtitle", "time": 10883.67, "timestamp": "03:01:23", "text": "君がそれを見るのを邪魔するんだよ、兄弟。"}, {"type": "subtitle", "time": 10885.269, "timestamp": "03:01:25", "text": "何？"}, {"type": "subtitle", "time": 10891.19, "timestamp": "03:01:31", "text": "彼らには、あなたをブロックするものがあります"}, {"type": "subtitle", "time": 10893.91, "timestamp": "03:01:33", "text": "使用しています。"}, {"type": "subtitle", "time": 10897.91, "timestamp": "03:01:37", "text": "えっと、何？そんなことができるの？"}, {"type": "subtitle", "time": 10899.429, "timestamp": "03:01:39", "text": "待って、いや、いや、いや、待って。確認させてください"}, {"type": "subtitle", "time": 10901.99, "timestamp": "03:01:41", "text": "その他のウェブサイト。ああ、私はホバリングできます"}, {"type": "subtitle", "time": 10905.269, "timestamp": "03:01:45", "text": "これ。待って、彼らは誰かが行くことを知っていた"}, {"type": "subtitle", "time": 10910.309, "timestamp": "03:01:50", "text": "白昼堂々と強盗を働く。何？"}]
[{"type": "subtitle", "time": 7811.91, "timestamp": "02:10:11", "text": "あれは空中トイレだ。何？"}, {"type": "subtitle", "time": 7815.669, "timestamp": "02:10:15", "text": "何？どこ？どうやって？なぜ、"}, {"type": "subtitle", "time": 7836.709, "timestamp": "02:10:36", "text": "本当に、言葉が出ない"}, {"type": "subtitle", "time": 7844.87, "timestamp": "02:10:44", "text": "今は言葉が見つかりません。スキー用トイレは"}]
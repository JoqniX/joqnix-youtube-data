[{"type": "subtitle", "time": 14882.71, "timestamp": "04:08:02", "text": "今はそういうことなんだ、だって彼らは"}, {"type": "subtitle", "time": 14886.469, "timestamp": "04:08:06", "text": "画像ファイルが見つかれば、それを使います。"}, {"type": "subtitle", "time": 14888.389, "timestamp": "04:08:08", "text": "ええ、彼らはイメージを重視するんです"}, {"type": "subtitle", "time": 14891.83, "timestamp": "04:08:11", "text": "あれ。最適化機能がある"}, {"type": "subtitle", "time": 14894.07, "timestamp": "04:08:14", "text": "画像用。"}, {"type": "subtitle", "time": 14897.03, "timestamp": "04:08:17", "text": "私はそれを改良しているところです。だから私は"}, {"type": "subtitle", "time": 14901.59, "timestamp": "04:08:21", "text": "背景画像をアップロードすることしかできません。"}, {"type": "subtitle", "time": 14903.67, "timestamp": "04:08:23", "text": "例えば、私の星座のやつ"}, {"type": "subtitle", "time": 14906.07, "timestamp": "04:08:26", "text": "ここです。"}, {"type": "subtitle", "time": 14908.79, "timestamp": "04:08:28", "text": "星座に関する知識があるんです。おお、"}, {"type": "subtitle", "time": 14912.07, "timestamp": "04:08:32", "text": "ちなみに、これは使えます。ああ、そう"}, {"type": "subtitle", "time": 14918.95, "timestamp": "04:08:38", "text": "100%。"}, {"type": "subtitle", "time": 14921.349, "timestamp": "04:08:41", "text": "私はそうしなければならないと思う"}, {"type": "subtitle", "time": 14927.83, "timestamp": "04:08:47", "text": "えっと"}, {"type": "subtitle", "time": 14930.309, "timestamp": "04:08:50", "text": "「fill」と「contain」のどちらが良いでしょうか？埋める"}, {"type": "subtitle", "time": 14932.469, "timestamp": "04:08:52", "text": "見た目"}, {"type": "subtitle", "time": 14935.95, "timestamp": "04:08:55", "text": "カバーも使えます。"}, {"type": "subtitle", "time": 14937.67, "timestamp": "04:08:57", "text": "[音楽]"}, {"type": "subtitle", "time": 14939.67, "timestamp": "04:08:59", "text": "ああ、オブジェクトの位置は変更できる"}]
[{"type": "subtitle", "time": 3302.15, "timestamp": "00:55:02", "text": "しばらく立ち往生している。私はそれを止めました。だから私の"}, {"type": "subtitle", "time": 3304.63, "timestamp": "00:55:04", "text": "vubingの旅は、私がやり直そうとしているものです"}, {"type": "subtitle", "time": 3308.15, "timestamp": "00:55:08", "text": "もの。自分のことをやり直す、つまり物事をやり直す"}, {"type": "subtitle", "time": 3310.87, "timestamp": "00:55:10", "text": "私は諦めたが、それでも夢を追いかけている"}, {"type": "subtitle", "time": 3312.71, "timestamp": "00:55:12", "text": "最初の夢、それが私がやっていることです"}, {"type": "subtitle", "time": 3315.03, "timestamp": "00:55:15", "text": "今は音楽とかそういうのに夢中"}, {"type": "subtitle", "time": 3316.87, "timestamp": "00:55:16", "text": "将来は音楽を作って、"}, {"type": "subtitle", "time": 3320.39, "timestamp": "00:55:20", "text": "今はすべてが終わったので、私がしたかったのは"}, {"type": "subtitle", "time": 3324.069, "timestamp": "00:55:24", "text": "書くことは主に宇宙のようなものだ"}, {"type": "subtitle", "time": 3327.43, "timestamp": "00:55:27", "text": "あるいはストーリーのテーマのようなもので、オニキスは"}, {"type": "subtitle", "time": 3329.67, "timestamp": "00:55:29", "text": "倉庫のような感じですね"}, {"type": "subtitle", "time": 3333.75, "timestamp": "00:55:33", "text": "私にはたくさんのキャラクターがいます"}, {"type": "subtitle", "time": 3337.19, "timestamp": "00:55:37", "text": "書きたいこと、音楽で披露したいこと"}, {"type": "subtitle", "time": 3339.91, "timestamp": "00:55:39", "text": "いろいろなもの、そしてたくさんのものが好きです。だから"}, {"type": "subtitle", "time": 3342.15, "timestamp": "00:55:42", "text": "これらのキャラクターは"}, {"type": "subtitle", "time": 3344.47, "timestamp": "00:55:44", "text": "ミュージックビデオとかそういう意味で。のために"}, {"type": "subtitle", "time": 3347.27, "timestamp": "00:55:47", "text": "例えば、あなたが見て、あなたが聞いて"}, {"type": "subtitle", "time": 3350.39, "timestamp": "00:55:50", "text": "日本の音楽、もしかしたら"}, {"type": "subtitle", "time": 3353.99, "timestamp": "00:55:53", "text": "イブについて知っている。"}, {"type": "subtitle", "time": 3357.03, "timestamp": "00:55:57", "text": "イブは"}, {"type": "subtitle", "time": 3359.589, "timestamp": "00:55:59", "text": "えーと、イヴは日本のソングライターみたいな感じ"}]
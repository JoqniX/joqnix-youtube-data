[{"type": "subtitle", "time": 7502.229, "timestamp": "02:05:02", "text": "私は複合施設に入りました"}, {"type": "subtitle", "time": 7505.99, "timestamp": "02:05:05", "text": "描き忘れた接線の複雑な組み合わせ"}, {"type": "subtitle", "time": 7508.229, "timestamp": "02:05:08", "text": "今日私たちがやるべきこと。おお"}, {"type": "subtitle", "time": 7512.39, "timestamp": "02:05:12", "text": "我が神よ。ああ、神様。わかった。"}, {"type": "subtitle", "time": 7514.79, "timestamp": "02:05:14", "text": "わかった。それでは、メニューの件に移りましょう。"}, {"type": "subtitle", "time": 7517.27, "timestamp": "02:05:17", "text": "わかった。"}, {"type": "subtitle", "time": 7520.07, "timestamp": "02:05:20", "text": "私は話が脱線してしまった"}, {"type": "subtitle", "time": 7523.99, "timestamp": "02:05:23", "text": "私は"}, {"type": "subtitle", "time": 7527.189, "timestamp": "02:05:27", "text": "大丈夫。"}, {"type": "subtitle", "time": 7529.99, "timestamp": "02:05:29", "text": "こんにちは。えーと、私がやらなきゃいけないことの一つは"}, {"type": "subtitle", "time": 7533.35, "timestamp": "02:05:33", "text": "これは時間APIです。"}, {"type": "subtitle", "time": 7557.51, "timestamp": "02:05:57", "text": "ウェブサイトの読み込みにものすごく時間がかかっている。"}, {"type": "subtitle", "time": 7559.83, "timestamp": "02:05:59", "text": "なし。何かダウンロード中ですか？"}]
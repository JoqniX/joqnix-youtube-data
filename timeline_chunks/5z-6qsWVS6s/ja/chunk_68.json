[{"type": "subtitle", "time": 4082.47, "timestamp": "01:08:02", "text": "全てを管理するのは本当に大変だった。"}, {"type": "subtitle", "time": 4084.39, "timestamp": "01:08:04", "text": "いいえ、"}, {"type": "subtitle", "time": 4086.47, "timestamp": "01:08:06", "text": "あまり人がいなかった"}, {"type": "subtitle", "time": 4088.95, "timestamp": "01:08:08", "text": "ボランティアで私を手伝ってくれる"}, {"type": "subtitle", "time": 4091.029, "timestamp": "01:08:11", "text": "あれら。耐えられなくなったのでやめました"}, {"type": "subtitle", "time": 4094.549, "timestamp": "01:08:14", "text": "まあ、ある意味ではそうしている。だから、私たちは"}, {"type": "subtitle", "time": 4098.55, "timestamp": "01:08:18", "text": "リスト。もし私がそれを証明できれば。どこですか？"}, {"type": "subtitle", "time": 4101.59, "timestamp": "01:08:21", "text": "ええ、このリストを作ったのは"}, {"type": "subtitle", "time": 4105.189, "timestamp": "01:08:25", "text": "誰かにあげたかった"}, {"type": "subtitle", "time": 4108.229, "timestamp": "01:08:28", "text": "大規模データベース。 VTuberデータベースにいくつかの"}, {"type": "subtitle", "time": 4112.39, "timestamp": "01:08:32", "text": "このYouTuberのように"}, {"type": "subtitle", "time": 4117.11, "timestamp": "01:08:37", "text": "アジアのVtuber。アジアです。できれば"}, {"type": "subtitle", "time": 4119.99, "timestamp": "01:08:39", "text": "ここにインドのユーチューバーを500人追加してください"}, {"type": "subtitle", "time": 4122.229, "timestamp": "01:08:42", "text": "インドのユーチューバー200人"}, {"type": "subtitle", "time": 4125.269, "timestamp": "01:08:45", "text": "こんな感じで、"}, {"type": "subtitle", "time": 4127.43, "timestamp": "01:08:47", "text": "インドのユーチューバーが情報を広める"}, {"type": "subtitle", "time": 4130.39, "timestamp": "01:08:50", "text": "存在するし色々あるけど、彼らは"}, {"type": "subtitle", "time": 4134.55, "timestamp": "01:08:54", "text": "東アジア系とか、よくわからないけど。"}, {"type": "subtitle", "time": 4138.47, "timestamp": "01:08:58", "text": "手に入れるのがとても大変です"}]
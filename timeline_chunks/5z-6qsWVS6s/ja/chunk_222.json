[{"type": "subtitle", "time": 13321.429, "timestamp": "03:42:01", "text": "なぜ"}, {"type": "subtitle", "time": 13332.95, "timestamp": "03:42:12", "text": "背景のテクスチャも素敵ですね。できる"}, {"type": "subtitle", "time": 13335.67, "timestamp": "03:42:15", "text": "この背景のテクスチャが見えますか？待って、"}, {"type": "subtitle", "time": 13339.91, "timestamp": "03:42:19", "text": "もし私がこれを自分のものにしたら？"}, {"type": "subtitle", "time": 13342.309, "timestamp": "03:42:22", "text": "背景のtexturepngはどこにありますか？"}, {"type": "subtitle", "time": 13343.99, "timestamp": "03:42:23", "text": "わかった。"}, {"type": "subtitle", "time": 13345.91, "timestamp": "03:42:25", "text": "えっと、"}, {"type": "subtitle", "time": 13349.03, "timestamp": "03:42:29", "text": "どこですか？ええと、ウェブスタジオです。だから、もし私が"}, {"type": "subtitle", "time": 13354.07, "timestamp": "03:42:34", "text": "画像、画像を選択してください。画像のURLを入力しました"}, {"type": "subtitle", "time": 13358.07, "timestamp": "03:42:38", "text": "これを配置してください。ええ、質感と"}, {"type": "subtitle", "time": 13361.59, "timestamp": "03:42:41", "text": "ブレンドモード。私はこうしなければならない"}, {"type": "subtitle", "time": 13370.469, "timestamp": "03:42:50", "text": "私は「うん」って言うべきだと思う。"}, {"type": "subtitle", "time": 13372.87, "timestamp": "03:42:52", "text": "柔らかな光。うん。うん。うん。ほら、"}, {"type": "subtitle", "time": 13376.79, "timestamp": "03:42:56", "text": "ざらざらした質感がある"}]
[{"type": "subtitle", "time": 18302.708, "timestamp": "05:05:02", "text": "それは少し役に立つ"}, {"type": "subtitle", "time": 18307.91, "timestamp": "05:05:07", "text": "昼夜の切り替えのためかな。"}, {"type": "subtitle", "time": 18309.55, "timestamp": "05:05:09", "text": "えっと、"}, {"type": "subtitle", "time": 18313.43, "timestamp": "05:05:13", "text": "[音楽]"}, {"type": "subtitle", "time": 18318.55, "timestamp": "05:05:18", "text": "いやあ、これはいい条件文だね。"}, {"type": "subtitle", "time": 18321.43, "timestamp": "05:05:21", "text": "でも、気が散ってきて"}, {"type": "subtitle", "time": 18325.27, "timestamp": "05:05:25", "text": "多く。大丈夫。えっと、これは円形です"}, {"type": "subtitle", "time": 18327.59, "timestamp": "05:05:27", "text": "放射状のやつですよね？彼らは1つ持っています、"}, {"type": "subtitle", "time": 18331.03, "timestamp": "05:05:31", "text": "2つ目ですが、これは4段階のグラデーションだと思います。"}, {"type": "subtitle", "time": 18340.07, "timestamp": "05:05:40", "text": "えっと、"}, {"type": "subtitle", "time": 18342.708, "timestamp": "05:05:42", "text": "では、これをコピーします。コピー"}]
[{"type": "subtitle", "time": 12555.51, "timestamp": "03:29:15", "text": "頭？メインストリートと"}, {"type": "subtitle", "time": 12572.07, "timestamp": "03:29:32", "text": "わかった。背景色とぼかしを重ね合わせる。"}, {"type": "subtitle", "time": 12575.269, "timestamp": "03:29:35", "text": "彼らにはアクセントの背景アクセントがあり、"}, {"type": "subtitle", "time": 12577.87, "timestamp": "03:29:37", "text": "コンテナには"}, {"type": "subtitle", "time": 12581.03, "timestamp": "03:29:41", "text": "[音楽]"}, {"type": "subtitle", "time": 12583.59, "timestamp": "03:29:43", "text": "位置指定または絶対位置指定"}, {"type": "subtitle", "time": 12586.63, "timestamp": "03:29:46", "text": "あ、待って。絶対的な効果。トップトップ"}, {"type": "subtitle", "time": 12589.349, "timestamp": "03:29:49", "text": "幅100 高さ100"}, {"type": "subtitle", "time": 12592.229, "timestamp": "03:29:52", "text": "オーバーレイ設定。背景をぼかす。えっと"}, {"type": "subtitle", "time": 12595.51, "timestamp": "03:29:55", "text": "divクラスを作成します。"}, {"type": "subtitle", "time": 12597.91, "timestamp": "03:29:57", "text": "アクセント。"}]
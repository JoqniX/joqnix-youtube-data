[{"type": "subtitle", "time": 4201.189, "timestamp": "01:10:01", "text": "もの"}, {"type": "subtitle", "time": 4212.39, "timestamp": "01:10:12", "text": "ああ、私、たくさん喋っちゃった。私の喉は"}, {"type": "subtitle", "time": 4219.03, "timestamp": "01:10:19", "text": "乾燥した。ちょっと熱いものを置かせてください"}, {"type": "subtitle", "time": 4221.669, "timestamp": "01:10:21", "text": "水を入れて、絞る。"}, {"type": "subtitle", "time": 4223.43, "timestamp": "01:10:23", "text": "うん、"}, {"type": "subtitle", "time": 4226.47, "timestamp": "01:10:26", "text": "えっと、コメントの一つを読んでみますね。"}, {"type": "subtitle", "time": 4231.03, "timestamp": "01:10:31", "text": "あなたから何も得られなかった。えっと、"}, {"type": "subtitle", "time": 4232.79, "timestamp": "01:10:32", "text": "あなたの主なコンテンツは何ですか？私の主な"}, {"type": "subtitle", "time": 4242.63, "timestamp": "01:10:42", "text": "ご覧のとおり、"}, {"type": "subtitle", "time": 4246.31, "timestamp": "01:10:46", "text": "主な内容は多様性です。私はゲームをします"}, {"type": "subtitle", "time": 4249.11, "timestamp": "01:10:49", "text": "などなど。これは私の主なものではありません"}, {"type": "subtitle", "time": 4252.39, "timestamp": "01:10:52", "text": "私が理想とするコンテンツは"}, {"type": "subtitle", "time": 4259.27, "timestamp": "01:10:59", "text": "えーと、主に音楽関連のことですが、"}]
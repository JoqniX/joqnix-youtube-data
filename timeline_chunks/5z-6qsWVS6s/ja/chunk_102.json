[{"type": "subtitle", "time": 6121.669, "timestamp": "01:42:01", "text": "レベルアップするにはどれくらい必要ですか？つまり"}, {"type": "subtitle", "time": 6124.629, "timestamp": "01:42:04", "text": "JPTに関しては5つのレベルがあり、5番目は"}, {"type": "subtitle", "time": 6126.31, "timestamp": "01:42:06", "text": "初心者とネイティブ"}, {"type": "subtitle", "time": 6129.83, "timestamp": "01:42:09", "text": "レベル。ビジネスの仕事と仕事"}, {"type": "subtitle", "time": 6131.75, "timestamp": "01:42:11", "text": "一般的には、"}, {"type": "subtitle", "time": 6135.91, "timestamp": "01:42:15", "text": "外国人N2資格"}, {"type": "subtitle", "time": 6138.07, "timestamp": "01:42:18", "text": "えーと、日本語の2言語"}, {"type": "subtitle", "time": 6141.27, "timestamp": "01:42:21", "text": "教授の流暢さの資格は"}, {"type": "subtitle", "time": 6143.669, "timestamp": "01:42:23", "text": "そこで仕事を得るためには、これらが必須です。"}, {"type": "subtitle", "time": 6146.229, "timestamp": "01:42:26", "text": "それでアカデミーの人たちはこう言った"}, {"type": "subtitle", "time": 6148.39, "timestamp": "01:42:28", "text": "なぜなら、彼らは私に教えてくれるからです"}, {"type": "subtitle", "time": 6152.95, "timestamp": "01:42:32", "text": "N4とN3の基礎レベルはそこで、私の4月は"}, {"type": "subtitle", "time": 6155.35, "timestamp": "01:42:35", "text": "入学期間は2年くらいになるでしょう"}, {"type": "subtitle", "time": 6157.83, "timestamp": "01:42:37", "text": "正しいコースの期間は2年間なので、"}, {"type": "subtitle", "time": 6159.91, "timestamp": "01:42:39", "text": "彼らは私が全部終わらせることができると言った"}, {"type": "subtitle", "time": 6162.79, "timestamp": "01:42:42", "text": "コースは1年間で修了します"}, {"type": "subtitle", "time": 6165.75, "timestamp": "01:42:45", "text": "1年で完全に終わらせることができます"}, {"type": "subtitle", "time": 6168.629, "timestamp": "01:42:48", "text": "私の全コース、そして私が必要とするものすべて"}, {"type": "subtitle", "time": 6172.31, "timestamp": "01:42:52", "text": "良いものを見つけるか、"}, {"type": "subtitle", "time": 6176.709, "timestamp": "01:42:56", "text": "フルタイムの仕事か、それとも"}]
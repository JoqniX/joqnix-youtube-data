[{"type": "subtitle", "time": 7323.51, "timestamp": "02:02:03", "text": "テーマは、あなたが好きになることに決めたので"}, {"type": "subtitle", "time": 7326.149, "timestamp": "02:02:06", "text": "自分を除外する理由は"}, {"type": "subtitle", "time": 7328.47, "timestamp": "02:02:08", "text": "昨年得た機会やその他"}, {"type": "subtitle", "time": 7332.39, "timestamp": "02:02:12", "text": "そして今、私を導いたすべてのもの"}, {"type": "subtitle", "time": 7335.83, "timestamp": "02:02:15", "text": "こうして私は"}, {"type": "subtitle", "time": 7337.91, "timestamp": "02:02:17", "text": "たくさんのことを約束し、"}, {"type": "subtitle", "time": 7340.629, "timestamp": "02:02:20", "text": "機会やその他諸々のおかげで私は"}, {"type": "subtitle", "time": 7343.91, "timestamp": "02:02:23", "text": "ジョックニックを除外することにした"}, {"type": "subtitle", "time": 7350.47, "timestamp": "02:02:30", "text": "えーと、アネクシア法は最初は"}, {"type": "subtitle", "time": 7355.189, "timestamp": "02:02:35", "text": "私たち３人４人全員であるはず"}, {"type": "subtitle", "time": 7358.55, "timestamp": "02:02:38", "text": "考える。ええと、アクィナ、シーザー。ああ、セシル、"}, {"type": "subtitle", "time": 7361.589, "timestamp": "02:02:41", "text": "アクィナ、ダスティン、そして私。まるで世界のように"}, {"type": "subtitle", "time": 7363.83, "timestamp": "02:02:43", "text": "３つすべて、４つすべてを取り囲む"}, {"type": "subtitle", "time": 7366.629, "timestamp": "02:02:46", "text": "主人公、4人のMC。私はやりたかった"}, {"type": "subtitle", "time": 7369.43, "timestamp": "02:02:49", "text": "ハリー・ポッターみたいなやつ"}, {"type": "subtitle", "time": 7372.709, "timestamp": "02:02:52", "text": "叙事詩のような、叙事詩のような小説タイプ"}, {"type": "subtitle", "time": 7374.87, "timestamp": "02:02:54", "text": "すべてのキャラクターのようなもの"}, {"type": "subtitle", "time": 7376.709, "timestamp": "02:02:56", "text": "独自の宇宙とすべて"}, {"type": "subtitle", "time": 7379.35, "timestamp": "02:02:59", "text": "彼らの伝承みたいなもの全体が"}]
[{"type": "subtitle", "time": 6060.709, "timestamp": "01:41:00", "text": "コンビニエンスストアと話をしなければならなかった"}, {"type": "subtitle", "time": 6063.27, "timestamp": "01:41:03", "text": "オーナーに謝罪し、書面で"}, {"type": "subtitle", "time": 6065.99, "timestamp": "01:41:05", "text": "謝罪の手紙とその他"}, {"type": "subtitle", "time": 6067.59, "timestamp": "01:41:07", "text": "すべて"}, {"type": "subtitle", "time": 6069.59, "timestamp": "01:41:09", "text": "仕事のパフォーマンスが悪く、"}, {"type": "subtitle", "time": 6072.629, "timestamp": "01:41:12", "text": "すべて。でも、すごく痛いんです。だから彼らは"}, {"type": "subtitle", "time": 6074.79, "timestamp": "01:41:14", "text": "この種の補償のようなもの"}, {"type": "subtitle", "time": 6077.83, "timestamp": "01:41:17", "text": "何が起こったのか彼らは言った"}, {"type": "subtitle", "time": 6081.59, "timestamp": "01:41:21", "text": "N4の授業を無料で提供してくれる。だから私は"}, {"type": "subtitle", "time": 6084.47, "timestamp": "01:41:24", "text": "授業を受ける"}, {"type": "subtitle", "time": 6088.87, "timestamp": "01:41:28", "text": "N4からN3までの基礎レベルクラス。だからそれは"}, {"type": "subtitle", "time": 6091.75, "timestamp": "01:41:31", "text": "むしろ、万全の準備を整えるつもりだ。病気"}, {"type": "subtitle", "time": 6095.59, "timestamp": "01:41:35", "text": "準備万端で、準備万端で"}, {"type": "subtitle", "time": 6099.669, "timestamp": "01:41:39", "text": "4月入学組のように日本へ出発する。だから"}, {"type": "subtitle", "time": 6103.03, "timestamp": "01:41:43", "text": "3月末に出発します。では次は"}, {"type": "subtitle", "time": 6105.669, "timestamp": "01:41:45", "text": "準備する時間があるように、1年かけて準備します。今これ"}, {"type": "subtitle", "time": 6108.149, "timestamp": "01:41:48", "text": "時間があるということは、書かなければならないということだ"}, {"type": "subtitle", "time": 6112.95, "timestamp": "01:41:52", "text": "N4試験も同様です。だから私はこう思う"}, {"type": "subtitle", "time": 6115.189, "timestamp": "01:41:55", "text": "うん、そうしないといけないね。いいえ、持っています"}, {"type": "subtitle", "time": 6116.87, "timestamp": "01:41:56", "text": "勉強に最善を尽くし、"}, {"type": "subtitle", "time": 6118.629, "timestamp": "01:41:58", "text": "すべて。"}]
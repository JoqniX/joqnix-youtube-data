[{"type": "subtitle", "time": 4982.07, "timestamp": "01:23:02", "text": "画面上の字幕のようなもの"}, {"type": "subtitle", "time": 4984.79, "timestamp": "01:23:04", "text": "中国語で。でも、それは"}, {"type": "subtitle", "time": 4986.95, "timestamp": "01:23:06", "text": "問題。今、私が何かを言うと、"}, {"type": "subtitle", "time": 4989.189, "timestamp": "01:23:09", "text": "いくつか間違った翻訳と人々"}, {"type": "subtitle", "time": 4990.87, "timestamp": "01:23:10", "text": "翻訳を読んでいる人は"}, {"type": "subtitle", "time": 4993.99, "timestamp": "01:23:13", "text": "「あぁ、彼は何か脈絡のないことを言ってる」"}, {"type": "subtitle", "time": 4996.79, "timestamp": "01:23:16", "text": "何か本当に"}, {"type": "subtitle", "time": 5000.31, "timestamp": "01:23:20", "text": "背中に危険が及ぶと彼らは"}, {"type": "subtitle", "time": 5002.629, "timestamp": "01:23:22", "text": "私が別のことを言っていると分かっていても、"}, {"type": "subtitle", "time": 5005.91, "timestamp": "01:23:25", "text": "もし私が"}, {"type": "subtitle", "time": 5007.91, "timestamp": "01:23:27", "text": "自分が失礼なことをしているのか、それとも"}, {"type": "subtitle", "time": 5010.31, "timestamp": "01:23:30", "text": "かわいいことについて話しているとき"}, {"type": "subtitle", "time": 5014.229, "timestamp": "01:23:34", "text": "物事は正しい、そう、私は"}, {"type": "subtitle", "time": 5016.47, "timestamp": "01:23:36", "text": "私の配信に関する免責事項として"}, {"type": "subtitle", "time": 5019.75, "timestamp": "01:23:39", "text": "テキストOBSテキストのようなものですね。ああ、"}, {"type": "subtitle", "time": 5022.149, "timestamp": "01:23:42", "text": "ビリー、ビリー、もうOBSは使えません"}, {"type": "subtitle", "time": 5024.229, "timestamp": "01:23:44", "text": "直接ストリーミング配信用。使用する必要があります"}, {"type": "subtitle", "time": 5027.35, "timestamp": "01:23:47", "text": "彼ら独自のOBSはbe liveと呼ばれており、"}, {"type": "subtitle", "time": 5030.149, "timestamp": "01:23:50", "text": "この男。私はライブ配信を利用しなければならない。私は持っている"}, {"type": "subtitle", "time": 5033.35, "timestamp": "01:23:53", "text": "OBS仮想カメラを使用する"}, {"type": "subtitle", "time": 5036.87, "timestamp": "01:23:56", "text": "それを使用するためのソフトウェア。"}, {"type": "subtitle", "time": 5039.43, "timestamp": "01:23:59", "text": "そして以前は、必要なのは"}]
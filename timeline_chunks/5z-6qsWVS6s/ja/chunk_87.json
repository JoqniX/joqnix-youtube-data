[{"type": "subtitle", "time": 5221.43, "timestamp": "01:27:01", "text": "ストリーム。だから、もしあなたが代理店や誰か"}, {"type": "subtitle", "time": 5225.27, "timestamp": "01:27:05", "text": "えっと、いいねサインをくれるような"}, {"type": "subtitle", "time": 5226.95, "timestamp": "01:27:06", "text": "あなたか何かで、ストリーミングできます"}, {"type": "subtitle", "time": 5229.83, "timestamp": "01:27:09", "text": "外国人であるビリーにとって"}, {"type": "subtitle", "time": 5233.51, "timestamp": "01:27:13", "text": "独占配信を行う必要がある"}, {"type": "subtitle", "time": 5235.75, "timestamp": "01:27:15", "text": "このように、また、言うこともできません"}, {"type": "subtitle", "time": 5238.229, "timestamp": "01:27:18", "text": "YouTube、Twitch、その他のプラットフォーム"}, {"type": "subtitle", "time": 5241.03, "timestamp": "01:27:21", "text": "ビリー・ビリーまたは中国のプラットフォームを除く"}, {"type": "subtitle", "time": 5243.11, "timestamp": "01:27:23", "text": "外国について話すことはできない"}, {"type": "subtitle", "time": 5245.99, "timestamp": "01:27:25", "text": "ウェブサイトを表示したり、YouTubeを表示したりすることさえできません。"}, {"type": "subtitle", "time": 5248.55, "timestamp": "01:27:28", "text": "YouTubeを見せても、"}, {"type": "subtitle", "time": 5251.99, "timestamp": "01:27:31", "text": "YouTubeのアイコンとかをフィルタリングして削除する。"}, {"type": "subtitle", "time": 5254.229, "timestamp": "01:27:34", "text": "ええと、最近ではAIと"}, {"type": "subtitle", "time": 5256.709, "timestamp": "01:27:36", "text": "管理者マニュアルまたはAI"}, {"type": "subtitle", "time": 5258.87, "timestamp": "01:27:38", "text": "管理者たちは本当に賢い。彼らは"}, {"type": "subtitle", "time": 5260.95, "timestamp": "01:27:40", "text": "本当に私が見ているのは"}, {"type": "subtitle", "time": 5264.229, "timestamp": "01:27:44", "text": "UIに基づいたYouTube。たとえ私が使っても"}, {"type": "subtitle", "time": 5267.59, "timestamp": "01:27:47", "text": "ブロック元を使用してUIをフィルタリングします"}, {"type": "subtitle", "time": 5269.27, "timestamp": "01:27:49", "text": "要素、右、上部と"}, {"type": "subtitle", "time": 5271.189, "timestamp": "01:27:51", "text": "そういうことなら、彼らは理解してくれるだろう。私は"}, {"type": "subtitle", "time": 5274.07, "timestamp": "01:27:54", "text": "海外のウェブサイトを見ている。私は手に入れた"}, {"type": "subtitle", "time": 5277.35, "timestamp": "01:27:57", "text": "杖。 5回くらいペナルティを受けた"}, {"type": "subtitle", "time": 5279.91, "timestamp": "01:27:59", "text": "そのためです。だって私は見せたから"}]
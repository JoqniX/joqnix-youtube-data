[{"type": "subtitle", "time": 360.629, "timestamp": "00:06:00", "text": "私がウェブフローで実現したかったこと"}, {"type": "subtitle", "time": 362.79, "timestamp": "00:06:02", "text": "そして私は良いことに気づいた"}, {"type": "subtitle", "time": 366.15, "timestamp": "00:06:06", "text": "オープンソース版のウェブフローは"}, {"type": "subtitle", "time": 367.749, "timestamp": "00:06:07", "text": "Web Flow の直接の競合相手"}, {"type": "subtitle", "time": 371.35, "timestamp": "00:06:11", "text": "それはウェブスタジオで、それから３つ、２つ"}, {"type": "subtitle", "time": 374.71, "timestamp": "00:06:14", "text": "数年前、そして昨年私は"}, {"type": "subtitle", "time": 376.87, "timestamp": "00:06:16", "text": "ウェブスタジオで進めたい"}, {"type": "subtitle", "time": 379.83, "timestamp": "00:06:19", "text": "カスタムドメインを接続できるので"}, {"type": "subtitle", "time": 381.59, "timestamp": "00:06:21", "text": "ドメインは 1 つまたは 3 つまたは"}, {"type": "subtitle", "time": 384.07, "timestamp": "00:06:24", "text": "4つのカスタムドメインとサイトを公開する"}, {"type": "subtitle", "time": 386.87, "timestamp": "00:06:26", "text": "すぐに正しいし、すべてが"}, {"type": "subtitle", "time": 389.029, "timestamp": "00:06:29", "text": "それは私が望んでいたもの全てを手に入れる"}, {"type": "subtitle", "time": 391.35, "timestamp": "00:06:31", "text": "複数ドメインのサポートが無料など"}, {"type": "subtitle", "time": 393.11, "timestamp": "00:06:33", "text": "そしてその時、私はすべてに気づいた"}, {"type": "subtitle", "time": 395.43, "timestamp": "00:06:35", "text": "彼らは生涯契約を結んでいるので、私は"}, {"type": "subtitle", "time": 398.469, "timestamp": "00:06:38", "text": "生涯契約プランのやつ。となることによって"}, {"type": "subtitle", "time": 401.43, "timestamp": "00:06:41", "text": "永遠に私ができることを意味する"}, {"type": "subtitle", "time": 404.55, "timestamp": "00:06:44", "text": "ウェブサイト、接続するドメインの数"}, {"type": "subtitle", "time": 408.469, "timestamp": "00:06:48", "text": "欲しいものなど、すべて無料です。"}, {"type": "subtitle", "time": 412.55, "timestamp": "00:06:52", "text": "それで、プロプランを手に入れたんだけど、えーっと、えーっと、"}, {"type": "subtitle", "time": 416.629, "timestamp": "00:06:56", "text": "そこから生涯契約が得られます。だから雰囲気は全部、"}, {"type": "subtitle", "time": 419.27, "timestamp": "00:06:59", "text": "ウェブサイト関連の作業はウェブスタジオで行っています。"}]
[{"type": "subtitle", "time": 3061.829, "timestamp": "00:51:01", "text": "そして今なら時間をかけられる"}, {"type": "subtitle", "time": 3065.91, "timestamp": "00:51:05", "text": "タイムラインは午前7時頃。私は"}, {"type": "subtitle", "time": 3068.069, "timestamp": "00:51:08", "text": "ダンジョン、"}, {"type": "subtitle", "time": 3070.39, "timestamp": "00:51:10", "text": "そういうこと全部ですよね？そうすることができます"}, {"type": "subtitle", "time": 3073.349, "timestamp": "00:51:13", "text": "そういうことは他にもたくさんある。しかし、"}, {"type": "subtitle", "time": 3076.39, "timestamp": "00:51:16", "text": "キャラクター ストーリー 感情 もの、すべて"}, {"type": "subtitle", "time": 3080.87, "timestamp": "00:51:20", "text": "最終的にはこれが理にかなうだろう"}, {"type": "subtitle", "time": 3084.23, "timestamp": "00:51:24", "text": "今私がやろうとしているのは、"}, {"type": "subtitle", "time": 3088.549, "timestamp": "00:51:28", "text": "ベッドのパンくずのように残す。"}, {"type": "subtitle", "time": 3090.95, "timestamp": "00:51:30", "text": "うん、パンくずを残しておいてね。そういうもの"}, {"type": "subtitle", "time": 3092.95, "timestamp": "00:51:32", "text": "ウェブサイトで見るもの、"}, {"type": "subtitle", "time": 3095.109, "timestamp": "00:51:35", "text": "小川から、イースターエッグの中に隠されている"}, {"type": "subtitle", "time": 3096.95, "timestamp": "00:51:36", "text": "そして、中から見えるものすべて"}, {"type": "subtitle", "time": 3098.95, "timestamp": "00:51:38", "text": "未来、音楽関係のことですよね？"}, {"type": "subtitle", "time": 3101.67, "timestamp": "00:51:41", "text": "ミュージックビデオや音楽関連グッズ。ああ、"}, {"type": "subtitle", "time": 3104.39, "timestamp": "00:51:44", "text": "歌詞、そういうもの全て、もしあなたが繋がるなら"}, {"type": "subtitle", "time": 3108.95, "timestamp": "00:51:48", "text": "ドットは、えーっと、"}, {"type": "subtitle", "time": 3111.99, "timestamp": "00:51:51", "text": "君は物語とか何かが好きなんだよね？"}, {"type": "subtitle", "time": 3114.47, "timestamp": "00:51:54", "text": "文字通り、つながりを築くことができます"}, {"type": "subtitle", "time": 3117.43, "timestamp": "00:51:57", "text": "点と点をつなぎ合わせて、物語全体を理解する"}]
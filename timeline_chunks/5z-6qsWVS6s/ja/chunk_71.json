[{"type": "subtitle", "time": 4263.91, "timestamp": "01:11:03", "text": "音楽はできないから、やらなきゃ。私は"}, {"type": "subtitle", "time": 4266.47, "timestamp": "01:11:06", "text": "ゲームと私がいつも"}, {"type": "subtitle", "time": 4268.87, "timestamp": "01:11:08", "text": "後悔や罪悪感を感じた"}, {"type": "subtitle", "time": 4272.39, "timestamp": "01:11:12", "text": "ゲーム関連のことをしているような気分です。"}, {"type": "subtitle", "time": 4274.47, "timestamp": "01:11:14", "text": "私は楽な道を選ぶのが好きなんです。したい"}, {"type": "subtitle", "time": 4277.75, "timestamp": "01:11:17", "text": "難しい方法を選んで、たくさん"}, {"type": "subtitle", "time": 4279.99, "timestamp": "01:11:19", "text": "ゲームではなく、今努力すること"}, {"type": "subtitle", "time": 4281.59, "timestamp": "01:11:21", "text": "反応コンテンツとか、そういう類のもの。"}, {"type": "subtitle", "time": 4284.31, "timestamp": "01:11:24", "text": "私はそれを望んでいません。でも、ゲームは"}, {"type": "subtitle", "time": 4286.229, "timestamp": "01:11:26", "text": "必要なものはそこにある。だから、ある意味では、"}, {"type": "subtitle", "time": 4288.229, "timestamp": "01:11:28", "text": "私のコンテンツや、あなたが"}, {"type": "subtitle", "time": 4291.99, "timestamp": "01:11:31", "text": "えっと、ゲームって、見てみて"}, {"type": "subtitle", "time": 4294.709, "timestamp": "01:11:34", "text": "一番古いものから。おそらく"}, {"type": "subtitle", "time": 4298.07, "timestamp": "01:11:38", "text": "ゲーム、その他普通のYouTuberの活動"}, {"type": "subtitle", "time": 4299.83, "timestamp": "01:11:39", "text": "右"}, {"type": "subtitle", "time": 4302.95, "timestamp": "01:11:42", "text": "ええ、でも私がやりたいことは"}, {"type": "subtitle", "time": 4304.47, "timestamp": "01:11:44", "text": "のように"}, {"type": "subtitle", "time": 4307.99, "timestamp": "01:11:47", "text": "音楽関連、コンサート関連、クールなものがたくさん"}, {"type": "subtitle", "time": 4311.75, "timestamp": "01:11:51", "text": "私がやりたいこと、それについて"}, {"type": "subtitle", "time": 4315.189, "timestamp": "01:11:55", "text": "vtubingはチューブであり、固定されたものではありません"}, {"type": "subtitle", "time": 4318.95, "timestamp": "01:11:58", "text": "ジャンルやニッチのようなもので、"}]
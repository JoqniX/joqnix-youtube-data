[{"type": "subtitle", "time": 3481.109, "timestamp": "00:58:01", "text": "小説をリリースするみたいなもの"}, {"type": "subtitle", "time": 3485.67, "timestamp": "00:58:05", "text": "TRPGゲーム、アニメ、Web 2の基盤として"}, {"type": "subtitle", "time": 3487.99, "timestamp": "00:58:07", "text": "そして、Web 3 は MF になります。私たちは以前は"}, {"type": "subtitle", "time": 3491.43, "timestamp": "00:58:11", "text": "過去にはWeb3関連のものやNFD関連のものがありました。今"}, {"type": "subtitle", "time": 3492.87, "timestamp": "00:58:12", "text": "彼らは止めて、"}, {"type": "subtitle", "time": 3495.109, "timestamp": "00:58:15", "text": "方向。つまりNFDの件は"}, {"type": "subtitle", "time": 3498.23, "timestamp": "00:58:18", "text": "市民になれるように"}, {"type": "subtitle", "time": 3501.27, "timestamp": "00:58:21", "text": "上椿市のこととか全部"}, {"type": "subtitle", "time": 3503.75, "timestamp": "00:58:23", "text": "そして彼らが今していることは"}, {"type": "subtitle", "time": 3507.03, "timestamp": "00:58:27", "text": "ああ、これがNFTのやつだったんだ。彼らは"}, {"type": "subtitle", "time": 3509.03, "timestamp": "00:58:29", "text": "これを止めました。変化があった"}, {"type": "subtitle", "time": 3511.589, "timestamp": "00:58:31", "text": "今はその方向へ。彼らはこれを止めた。しかし"}, {"type": "subtitle", "time": 3516.549, "timestamp": "00:58:36", "text": "うん、インド、君は"}, {"type": "subtitle", "time": 3519.43, "timestamp": "00:58:39", "text": "コミュニティシティの住民"}, {"type": "subtitle", "time": 3522.63, "timestamp": "00:58:42", "text": "また、彼らはセンスシリーズも持っています。だから"}, {"type": "subtitle", "time": 3524.87, "timestamp": "00:58:44", "text": "将来ライブでやろうと思っていること"}, {"type": "subtitle", "time": 3528.23, "timestamp": "00:58:48", "text": "コンサートもそうだし、3Dコンサートとかもね。"}, {"type": "subtitle", "time": 3530.63, "timestamp": "00:58:50", "text": "えーと、私はどちらかというとプロデューサータイプなので"}, {"type": "subtitle", "time": 3532.63, "timestamp": "00:58:52", "text": "それと、歌も習っているんです。"}, {"type": "subtitle", "time": 3536.069, "timestamp": "00:58:56", "text": "だから、自分のコンサートをやりたいな。"}, {"type": "subtitle", "time": 3538.39, "timestamp": "00:58:58", "text": "ソロコンサートは私一人で"}]
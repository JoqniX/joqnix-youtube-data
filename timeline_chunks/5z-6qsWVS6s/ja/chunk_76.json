[{"type": "subtitle", "time": 4562.63, "timestamp": "01:16:02", "text": "もちろん、Vチャンネルに入れることもできます。"}, {"type": "subtitle", "time": 4566.149, "timestamp": "01:16:06", "text": "えっと、Twitch向けです。私はチャンネルを持っています"}, {"type": "subtitle", "time": 4570.229, "timestamp": "01:16:10", "text": "えーと、Twitchとかですね。私は思った"}, {"type": "subtitle", "time": 4573.27, "timestamp": "01:16:13", "text": "ここに置くのは、メイン"}, {"type": "subtitle", "time": 4576.229, "timestamp": "01:16:16", "text": "チャンネルI オリジナルのえーと"}, {"type": "subtitle", "time": 4579.11, "timestamp": "01:16:19", "text": "オリジナル短編シリーズ"}, {"type": "subtitle", "time": 4582.47, "timestamp": "01:16:22", "text": "短いタイプのコンテンツを作りました。"}, {"type": "subtitle", "time": 4584.229, "timestamp": "01:16:24", "text": "適切なオーバーレイとすべて"}, {"type": "subtitle", "time": 4587.189, "timestamp": "01:16:27", "text": "適切なフォーマットで全てが正しい"}, {"type": "subtitle", "time": 4590.79, "timestamp": "01:16:30", "text": "届くまでに少し時間がかかりました"}, {"type": "subtitle", "time": 4593.51, "timestamp": "01:16:33", "text": "条件と、でも私はついに"}, {"type": "subtitle", "time": 4595.43, "timestamp": "01:16:35", "text": "やったよ"}, {"type": "subtitle", "time": 4598.31, "timestamp": "01:16:38", "text": "だって、これをやる良いインスピレーションだから"}, {"type": "subtitle", "time": 4601.669, "timestamp": "01:16:41", "text": "Mory Kio OPは生産を比較していました"}, {"type": "subtitle", "time": 4603.59, "timestamp": "01:16:43", "text": "コーパスを用いた評価は公平ではない。うん、"}, {"type": "subtitle", "time": 4606.229, "timestamp": "01:16:46", "text": "それもまた然り。知っている。"}, {"type": "subtitle", "time": 4610.07, "timestamp": "01:16:50", "text": "知っている。そう、私はモラルに気づいた"}, {"type": "subtitle", "time": 4612.709, "timestamp": "01:16:52", "text": "彼女は音楽のバッジを持っているが、"}, {"type": "subtitle", "time": 4614.95, "timestamp": "01:16:54", "text": "右？音楽バッジですよね？彼女のコンテンツ"}, {"type": "subtitle", "time": 4619.03, "timestamp": "01:16:59", "text": "ライブではもっとダイナミックな感じ"}]
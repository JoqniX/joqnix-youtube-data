[{"type": "subtitle", "time": 5643.51, "timestamp": "01:34:03", "text": "ここに行くと"}, {"type": "subtitle", "time": 5647.43, "timestamp": "01:34:07", "text": "ええと、生放送って表示されると思います"}, {"type": "subtitle", "time": 5649.99, "timestamp": "01:34:09", "text": "生放送最強艦隊賞"}, {"type": "subtitle", "time": 5653.83, "timestamp": "01:34:13", "text": "名誉を。受賞した賞はすべて"}, {"type": "subtitle", "time": 5657.35, "timestamp": "01:34:17", "text": "ビリー・ビリーがここで紹介されます。そして"}, {"type": "subtitle", "time": 5660.31, "timestamp": "01:34:20", "text": "うん、もしあなたが"}, {"type": "subtitle", "time": 5662.31, "timestamp": "01:34:22", "text": "100万ドルとかいう高額賞金"}, {"type": "subtitle", "time": 5664.31, "timestamp": "01:34:24", "text": "右？すべての賞はここにあり、"}, {"type": "subtitle", "time": 5666.47, "timestamp": "01:34:26", "text": "すべて。"}, {"type": "subtitle", "time": 5669.669, "timestamp": "01:34:29", "text": "たくさんあります。ミスタービースト、見せてください。私は思う"}, {"type": "subtitle", "time": 5673.11, "timestamp": "01:34:33", "text": "ミスタービーストが出演しています。ビリー。ええ、彼は"}, {"type": "subtitle", "time": 5678.39, "timestamp": "01:34:38", "text": "ここ。うん、彼はこう思うと思う"}, {"type": "subtitle", "time": 5685.11, "timestamp": "01:34:45", "text": "ビー氏の公式アカウント。わかった。うん。"}, {"type": "subtitle", "time": 5688.79, "timestamp": "01:34:48", "text": "検証はこんなに素晴らしい。今のように"}, {"type": "subtitle", "time": 5691.11, "timestamp": "01:34:51", "text": "一番大切なのはタイトルを入れることです"}, {"type": "subtitle", "time": 5694.149, "timestamp": "01:34:54", "text": "そしてすべての"}, {"type": "subtitle", "time": 5695.99, "timestamp": "01:34:55", "text": "中国コンテンツみたいなものですよね？私はできません"}, {"type": "subtitle", "time": 5698.39, "timestamp": "01:34:58", "text": "英語風に書いてください。私は持っている"}]
[{"type": "subtitle", "time": 7741.99, "timestamp": "02:09:01", "text": "しかし、私が最初に作ったので、"}, {"type": "subtitle", "time": 7745.589, "timestamp": "02:09:05", "text": "招待状を送ることもできると思う"}, {"type": "subtitle", "time": 7748.629, "timestamp": "02:09:08", "text": "なければ、"}, {"type": "subtitle", "time": 7752.47, "timestamp": "02:09:12", "text": "活動的な人であれば、"}, {"type": "subtitle", "time": 7754.79, "timestamp": "02:09:14", "text": "インド人ユーチューバーでメイクアップアーティスト"}, {"type": "subtitle", "time": 7757.109, "timestamp": "02:09:17", "text": "コンテンツとその他すべて"}, {"type": "subtitle", "time": 7760.47, "timestamp": "02:09:20", "text": "ドラマや"}, {"type": "subtitle", "time": 7765.03, "timestamp": "02:09:25", "text": "何でもいいから、あなたは良い人です"}, {"type": "subtitle", "time": 7767.99, "timestamp": "02:09:27", "text": "ドラマチックな出来事が多すぎて"}, {"type": "subtitle", "time": 7772.39, "timestamp": "02:09:32", "text": "この空間は大混乱だった"}, {"type": "subtitle", "time": 7777.109, "timestamp": "02:09:37", "text": "だから、ある意味で私たちは完全に"}, {"type": "subtitle", "time": 7780.55, "timestamp": "02:09:40", "text": "超保護的で、いろいろ"}, {"type": "subtitle", "time": 7783.03, "timestamp": "02:09:43", "text": "そうですね"}, {"type": "subtitle", "time": 7786.31, "timestamp": "02:09:46", "text": "怖いトイレがたくさんある"}, {"type": "subtitle", "time": 7790.149, "timestamp": "02:09:50", "text": "お皿の飾り付けって一体何なの？"}]
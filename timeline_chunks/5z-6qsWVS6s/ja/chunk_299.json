[{"type": "subtitle", "time": 17944.708, "timestamp": "04:59:04", "text": "航海日。"}, {"type": "subtitle", "time": 17967.11, "timestamp": "04:59:27", "text": "ああ、それはいいですね。私は必要ないが、"}, {"type": "subtitle", "time": 17973.35, "timestamp": "04:59:33", "text": "レイヤーを暗くしたり明るくしたりします"}, {"type": "subtitle", "time": 17976.788, "timestamp": "04:59:36", "text": "最上層に。"}, {"type": "subtitle", "time": 17979.59, "timestamp": "04:59:39", "text": "これはアルファチャンネル後のデータです。ああ、これ"}]
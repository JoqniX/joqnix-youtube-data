[{"type": "subtitle", "time": 4382.55, "timestamp": "01:13:02", "text": "ブランディングやその他諸々が今"}, {"type": "subtitle", "time": 4386.31, "timestamp": "01:13:06", "text": "現在のことは、例えば私が"}, {"type": "subtitle", "time": 4390.47, "timestamp": "01:13:10", "text": "天気予報の女の子たちを見せています"}, {"type": "subtitle", "time": 4393.43, "timestamp": "01:13:13", "text": "例えば"}, {"type": "subtitle", "time": 4395.91, "timestamp": "01:13:15", "text": "現代のユーチューバーたちは"}, {"type": "subtitle", "time": 4399.43, "timestamp": "01:13:19", "text": "より高い水準という意味ですよね？"}, {"type": "subtitle", "time": 4401.91, "timestamp": "01:13:21", "text": "彼女のチャンネルを見てみて、バナー"}, {"type": "subtitle", "time": 4405.189, "timestamp": "01:13:25", "text": "物、高等級のもの、背景、"}, {"type": "subtitle", "time": 4407.51, "timestamp": "01:13:27", "text": "チャンネルとか、全部。サムネイル"}, {"type": "subtitle", "time": 4411.59, "timestamp": "01:13:31", "text": "賢明、説明賢明、mビデオさえも"}, {"type": "subtitle", "time": 4413.99, "timestamp": "01:13:33", "text": "コンテンツも同様です。カバー曲では、"}, {"type": "subtitle", "time": 4417.75, "timestamp": "01:13:37", "text": "すべて良質で、お金もたっぷり。"}, {"type": "subtitle", "time": 4422.149, "timestamp": "01:13:42", "text": "オカネはかなり高いところまで費やした"}, {"type": "subtitle", "time": 4425.03, "timestamp": "01:13:45", "text": "質の高いコンテンツですよね？それはとても"}, {"type": "subtitle", "time": 4427.99, "timestamp": "01:13:47", "text": "基準は非常に高く、"}, {"type": "subtitle", "time": 4430.87, "timestamp": "01:13:50", "text": "モデルも標準に達しました"}, {"type": "subtitle", "time": 4434.79, "timestamp": "01:13:54", "text": "高い、それはとても難しいですよね、だから私も"}, {"type": "subtitle", "time": 4437.99, "timestamp": "01:13:57", "text": "私は非常にプロ意識が高く、とてもこだわりが強かった"}, {"type": "subtitle", "time": 4439.99, "timestamp": "01:13:59", "text": "いや、私はそうは思わない"}]
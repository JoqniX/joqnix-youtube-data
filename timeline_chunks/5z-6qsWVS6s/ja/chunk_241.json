[{"type": "subtitle", "time": 14462.229, "timestamp": "04:01:02", "text": "インデックスとは何ですか？高度なインデックス"}, {"type": "subtitle", "time": 14464.469, "timestamp": "04:01:04", "text": "インデックスは自動的に作成され、"}, {"type": "subtitle", "time": 14468.229, "timestamp": "04:01:08", "text": "20%のインデックスを計算する範囲は問題ありません。"}, {"type": "subtitle", "time": 14471.67, "timestamp": "04:01:11", "text": "わかった。最初の子インデックスは自動的に"}, {"type": "subtitle", "time": 14474.389, "timestamp": "04:01:14", "text": "利用可能になり、"}, {"type": "subtitle", "time": 14476.469, "timestamp": "04:01:16", "text": "インデックスアニメーションの現在の子"}, {"type": "subtitle", "time": 14478.389, "timestamp": "04:01:18", "text": "グループ。計算に使用できます"}, {"type": "subtitle", "time": 14481.189, "timestamp": "04:01:21", "text": "複雑なアニメーションを実行する。"}, {"type": "subtitle", "time": 14487.03, "timestamp": "04:01:27", "text": "カロリー40％＋変動10％を含む。"}, {"type": "subtitle", "time": 14489.67, "timestamp": "04:01:29", "text": "開始には以下が含まれます"}, {"type": "subtitle", "time": 14493.349, "timestamp": "04:01:33", "text": "私の脳は死にかけている。"}, {"type": "subtitle", "time": 14495.59, "timestamp": "04:01:35", "text": "待って"}, {"type": "subtitle", "time": 14497.91, "timestamp": "04:01:37", "text": "固定画像。"}, {"type": "subtitle", "time": 14503.189, "timestamp": "04:01:43", "text": "文字ごとのテキストアニメーションはありません。"}, {"type": "subtitle", "time": 14505.59, "timestamp": "04:01:45", "text": "スクロールすると発生します。いいえ、私はしません"}, {"type": "subtitle", "time": 14509.67, "timestamp": "04:01:49", "text": "スクロールしたい。私は"}]
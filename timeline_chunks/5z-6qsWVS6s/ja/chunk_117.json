[{"type": "subtitle", "time": 7024.55, "timestamp": "01:57:04", "text": "でも、これはうまくいくかもしれないね。しかし、それはまた"}, {"type": "subtitle", "time": 7026.47, "timestamp": "01:57:06", "text": "Stripeによって提供されています。だから、それはある意味"}, {"type": "subtitle", "time": 7031.83, "timestamp": "01:57:11", "text": "痛み。これはうまくいくかもしれない。"}, {"type": "subtitle", "time": 7033.75, "timestamp": "01:57:13", "text": "ええ、全員GST番号が必要です"}, {"type": "subtitle", "time": 7037.91, "timestamp": "01:57:17", "text": "あれ。はい。はい。はい。そこが問題なんです。"}, {"type": "subtitle", "time": 7047.51, "timestamp": "01:57:27", "text": "ええ、話が全く脱線してしまいました。"}, {"type": "subtitle", "time": 7049.189, "timestamp": "01:57:29", "text": "右？"}, {"type": "subtitle", "time": 7051.75, "timestamp": "01:57:31", "text": "くそ。こんにちは、ユガンさん。申し訳ありません"}, {"type": "subtitle", "time": 7053.43, "timestamp": "01:57:33", "text": "今、あなたのコメントを読んでいます。私は読む"}, {"type": "subtitle", "time": 7056.39, "timestamp": "01:57:36", "text": "以前にも言ったけど、声に出して言うのを忘れてた"}, {"type": "subtitle", "time": 7059.91, "timestamp": "01:57:39", "text": "それについて。えーっと、声に出して言うと、声に出して言うと"}, {"type": "subtitle", "time": 7066.07, "timestamp": "01:57:46", "text": "でも、本当にたくさんのことがあるよ、ディオン。うん。"}, {"type": "subtitle", "time": 7072.07, "timestamp": "01:57:52", "text": "たくさんのこと。それは最高だった"}, {"type": "subtitle", "time": 7075.589, "timestamp": "01:57:55", "text": "参考になる。よかったです。よかった"}, {"type": "subtitle", "time": 7077.99, "timestamp": "01:57:57", "text": "だった。それはあなたが「何が」と尋ねることから始まった"}]
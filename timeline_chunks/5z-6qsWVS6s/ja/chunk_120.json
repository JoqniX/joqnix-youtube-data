[{"type": "subtitle", "time": 7204.07, "timestamp": "02:00:04", "text": "そしてセシル。こちらはセシル・レッドヘッドです"}, {"type": "subtitle", "time": 7207.27, "timestamp": "02:00:07", "text": "戦闘少女。彼女はある意味、反逆者だ。"}, {"type": "subtitle", "time": 7210.79, "timestamp": "02:00:10", "text": "二刀流キャラクター。彼女は二輪車"}, {"type": "subtitle", "time": 7213.589, "timestamp": "02:00:13", "text": "車輪は、えっと、短剣みたいなやつ"}, {"type": "subtitle", "time": 7217.99, "timestamp": "02:00:17", "text": "推測。そして彼女は拳も使います"}, {"type": "subtitle", "time": 7220.47, "timestamp": "02:00:20", "text": "良い。うん、"}, {"type": "subtitle", "time": 7223.99, "timestamp": "02:00:23", "text": "それはまるで海塩のようだった。そしてまた"}, {"type": "subtitle", "time": 7229.51, "timestamp": "02:00:29", "text": "登場人物は科学者の男です"}, {"type": "subtitle", "time": 7231.109, "timestamp": "02:00:31", "text": "錬金術師"}, {"type": "subtitle", "time": 7233.91, "timestamp": "02:00:33", "text": "彼の名前はティアスティンです。ティアスティンは"}, {"type": "subtitle", "time": 7236.31, "timestamp": "02:00:36", "text": "えっと、あなたの誕生日は私の誕生日のようです"}, {"type": "subtitle", "time": 7240.229, "timestamp": "02:00:40", "text": "祖母の誕生日 11月30日"}, {"type": "subtitle", "time": 7242.55, "timestamp": "02:00:42", "text": "あなたの罪はアクィナの罪であり、私の母の罪である"}, {"type": "subtitle", "time": 7245.83, "timestamp": "02:00:45", "text": "誕生日 10月6日 10月5日は"}, {"type": "subtitle", "time": 7247.99, "timestamp": "02:00:47", "text": "母の誕生日なので10月6日は"}, {"type": "subtitle", "time": 7251.03, "timestamp": "02:00:51", "text": "アクィナなので、ある意味で私は思い出すことができる"}, {"type": "subtitle", "time": 7253.83, "timestamp": "02:00:53", "text": "今では、彼らは独自のTwitterアカウントも持っています。"}]
[{"type": "subtitle", "time": 2942.87, "timestamp": "00:49:02", "text": "目を覚ますよ、アラームが鳴ってるから"}, {"type": "subtitle", "time": 2945.19, "timestamp": "00:49:05", "text": "アラームが鳴り始めたら、"}, {"type": "subtitle", "time": 2948.15, "timestamp": "00:49:08", "text": "Googleみたいなアラームですね。"}, {"type": "subtitle", "time": 2950.79, "timestamp": "00:49:10", "text": "それはアクティビティ状態を送信します"}, {"type": "subtitle", "time": 2953.03, "timestamp": "00:49:13", "text": "ジョックのアラームが鳴っている"}, {"type": "subtitle", "time": 2955.75, "timestamp": "00:49:15", "text": "などなど。私がそれを無視すると、"}, {"type": "subtitle", "time": 2959.19, "timestamp": "00:49:19", "text": "ジョーが目を覚ましたなどの別のリクエスト"}, {"type": "subtitle", "time": 2962.549, "timestamp": "00:49:22", "text": "何か。私がスヌーズすると、ジョックは"}, {"type": "subtitle", "time": 2964.79, "timestamp": "00:49:24", "text": "もう少し寝るとか、何かするよ。そういうやつ"}, {"type": "subtitle", "time": 2968.63, "timestamp": "00:49:28", "text": "アクティビティフィードの。私の言いたいこと、分かりますか？"}, {"type": "subtitle", "time": 2971.67, "timestamp": "00:49:31", "text": "それはやりすぎだ。しかし、それはあなたに"}, {"type": "subtitle", "time": 2973.91, "timestamp": "00:49:33", "text": "キャラクターの没入感、"}, {"type": "subtitle", "time": 2976.71, "timestamp": "00:49:36", "text": "右？あなたは何て言ったの？まるで"}, {"type": "subtitle", "time": 2978.549, "timestamp": "00:49:38", "text": "考えてみてください、このように考えてください"}, {"type": "subtitle", "time": 2980.95, "timestamp": "00:49:40", "text": "好きなアニメキャラクターまたは好きな"}, {"type": "subtitle", "time": 2983.27, "timestamp": "00:49:43", "text": "ゲームキャラクター。あなたは知りたいですか"}, {"type": "subtitle", "time": 2985.67, "timestamp": "00:49:45", "text": "あなたのゲームキャラクターまたはアニメキャラクター"}, {"type": "subtitle", "time": 2989.67, "timestamp": "00:49:49", "text": "やっている。あなたの架空のワイフまたは"}, {"type": "subtitle", "time": 2991.75, "timestamp": "00:49:51", "text": "夫か、あなたの夫が何をしているのか"}, {"type": "subtitle", "time": 2994.549, "timestamp": "00:49:54", "text": "あるいは、奥さんがやっていることですよね？チェック"}, {"type": "subtitle", "time": 2997.51, "timestamp": "00:49:57", "text": "彼らの活動やその他諸々について、"}]
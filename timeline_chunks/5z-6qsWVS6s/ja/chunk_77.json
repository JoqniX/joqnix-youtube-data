[{"type": "subtitle", "time": 4622.149, "timestamp": "01:17:02", "text": "タブ。彼女はBTuberコンテンツをやっているんですよね？"}, {"type": "subtitle", "time": 4625.03, "timestamp": "01:17:05", "text": "通常のリリース。彼女が音楽を担当する"}, {"type": "subtitle", "time": 4628.31, "timestamp": "01:17:08", "text": "物、ショートパンツも。彼女は持っている"}, {"type": "subtitle", "time": 4631.11, "timestamp": "01:17:11", "text": "オリジナルの短編シリーズとクリップだと思います"}, {"type": "subtitle", "time": 4634.149, "timestamp": "01:17:14", "text": "ここにはないが、オリジナルに近い"}, {"type": "subtitle", "time": 4636.55, "timestamp": "01:17:16", "text": "短編シリーズ、テレビアニメシリーズのようなもの"}, {"type": "subtitle", "time": 4640.79, "timestamp": "01:17:20", "text": "コミックみたいなもの、そして"}, {"type": "subtitle", "time": 4643.189, "timestamp": "01:17:23", "text": "モデルタイプのショットのような"}, {"type": "subtitle", "time": 4646.07, "timestamp": "01:17:26", "text": "それらもここにあります。今は見えない"}, {"type": "subtitle", "time": 4648.63, "timestamp": "01:17:28", "text": "彼女はここでストリームクリップをやっているが"}, {"type": "subtitle", "time": 4650.95, "timestamp": "01:17:30", "text": "ええ、ストリームクリップは彼女がやっていない"}, {"type": "subtitle", "time": 4653.99, "timestamp": "01:17:33", "text": "なぜなら、生涯ファンは"}, {"type": "subtitle", "time": 4655.75, "timestamp": "01:17:35", "text": "YouTuberのクリップとかが今や"}, {"type": "subtitle", "time": 4657.59, "timestamp": "01:17:37", "text": "今すぐそうしてください。だから、"}, {"type": "subtitle", "time": 4660.47, "timestamp": "01:17:40", "text": "我々の独立のためにそれを正しく行う"}, {"type": "subtitle", "time": 4663.669, "timestamp": "01:17:43", "text": "正しくやらなければならない、なぜ"}, {"type": "subtitle", "time": 4666.55, "timestamp": "01:17:46", "text": "企業を比較するが、主なものは"}, {"type": "subtitle", "time": 4669.189, "timestamp": "01:17:49", "text": "YouTube の問題は、"}, {"type": "subtitle", "time": 4672.63, "timestamp": "01:17:52", "text": "彼らが持っていなかった日"}, {"type": "subtitle", "time": 4674.63, "timestamp": "01:17:54", "text": "昔は、"}, {"type": "subtitle", "time": 4676.87, "timestamp": "01:17:56", "text": "このようなリリース タブまたはショット フィード"}, {"type": "subtitle", "time": 4679.189, "timestamp": "01:17:59", "text": "まさにその直前のように、"}]
[{"type": "subtitle", "time": 7440.55, "timestamp": "02:04:00", "text": "えーっと、彼らはさまざまな目的で歌手を雇います"}, {"type": "subtitle", "time": 7443.589, "timestamp": "02:04:03", "text": "キャラクター。これはまるで"}, {"type": "subtitle", "time": 7445.27, "timestamp": "02:04:05", "text": "えっと、これは、"}, {"type": "subtitle", "time": 7447.589, "timestamp": "02:04:07", "text": "キャラクターですよね？あります"}, {"type": "subtitle", "time": 7450.07, "timestamp": "02:04:10", "text": "刑務官。警備員がいて、ガイドが"}, {"type": "subtitle", "time": 7452.87, "timestamp": "02:04:12", "text": "そこでは、彼らは皆囚人だ。彼らは"}, {"type": "subtitle", "time": 7454.629, "timestamp": "02:04:14", "text": "彼らには彼ら自身の物語があり、"}, {"type": "subtitle", "time": 7456.95, "timestamp": "02:04:16", "text": "すべて。それらの物語が紹介される"}, {"type": "subtitle", "time": 7459.109, "timestamp": "02:04:19", "text": "ミュージックビデオの形式で、"}, {"type": "subtitle", "time": 7464.31, "timestamp": "02:04:24", "text": "すべて。例えば、彼女のアマンは"}, {"type": "subtitle", "time": 7468.87, "timestamp": "02:04:28", "text": "彼女の持ち物。エピソード1だと思います。"}, {"type": "subtitle", "time": 7471.75, "timestamp": "02:04:31", "text": "えっと、どこにあるの？どうすれば見つけられますか"}, {"type": "subtitle", "time": 7474.47, "timestamp": "02:04:34", "text": "アマンの音楽関連のもの？"}, {"type": "subtitle", "time": 7476.47, "timestamp": "02:04:36", "text": "あ、忘れてた。 YouTubeにあると思います"}, {"type": "subtitle", "time": 7478.95, "timestamp": "02:04:38", "text": "ミリグラムチャンネル。うん。うん。毎"}, {"type": "subtitle", "time": 7481.109, "timestamp": "02:04:41", "text": "キャラクターには独自のストーリーがあります"}, {"type": "subtitle", "time": 7485.91, "timestamp": "02:04:45", "text": "彼女の物語、彼女の物語のようなもの。うん。"}, {"type": "subtitle", "time": 7488.709, "timestamp": "02:04:48", "text": "たくさんのこと。"}, {"type": "subtitle", "time": 7490.79, "timestamp": "02:04:50", "text": "だから私はそういうことをしたかったんです"}, {"type": "subtitle", "time": 7493.51, "timestamp": "02:04:53", "text": "そして、私はあまりにも多くのことに気づいてしまった。私は行きます"}, {"type": "subtitle", "time": 7496.07, "timestamp": "02:04:56", "text": "少しの間、電話をかける。こんにちは。気をつけて。取る"}, {"type": "subtitle", "time": 7498.149, "timestamp": "02:04:58", "text": "ケア。"}]
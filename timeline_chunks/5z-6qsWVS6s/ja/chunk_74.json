[{"type": "subtitle", "time": 4442.39, "timestamp": "01:14:02", "text": "良質なものがない限りアップロードしません"}, {"type": "subtitle", "time": 4446.47, "timestamp": "01:14:06", "text": "コンテンツとか色々、昔は好きだったから"}, {"type": "subtitle", "time": 4449.03, "timestamp": "01:14:09", "text": "自分を批判しすぎると"}, {"type": "subtitle", "time": 4453.59, "timestamp": "01:14:13", "text": "私がある意味そう思っていた核心は"}, {"type": "subtitle", "time": 4455.669, "timestamp": "01:14:15", "text": "ほとんどのものに満足しています。"}, {"type": "subtitle", "time": 4458.63, "timestamp": "01:14:18", "text": "問題とかそういうのは"}, {"type": "subtitle", "time": 4460.95, "timestamp": "01:14:20", "text": "ストリームサイドにはバグが多すぎる"}, {"type": "subtitle", "time": 4464.55, "timestamp": "01:14:24", "text": "速報、サミー、君のことだよ"}, {"type": "subtitle", "time": 4468.07, "timestamp": "01:14:28", "text": "プレゼンテーションの質の面で"}, {"type": "subtitle", "time": 4469.99, "timestamp": "01:14:29", "text": "制作関係など、たくさんある"}, {"type": "subtitle", "time": 4472.07, "timestamp": "01:14:32", "text": "ここで今すぐやらなければならないことがあるので、私は"}, {"type": "subtitle", "time": 4474.63, "timestamp": "01:14:34", "text": "こだわりが強いけど、"}, {"type": "subtitle", "time": 4476.87, "timestamp": "01:14:36", "text": "私はジョアソンイベントに参加するので"}, {"type": "subtitle", "time": 4479.91, "timestamp": "01:14:39", "text": "新型モデルも登場"}, {"type": "subtitle", "time": 4482.79, "timestamp": "01:14:42", "text": "別の種類の頭痛の種は"}, {"type": "subtitle", "time": 4485.99, "timestamp": "01:14:45", "text": "モデルがこれを配布しているような感じ"}, {"type": "subtitle", "time": 4489.83, "timestamp": "01:14:49", "text": "この品質レベルは、より高い"}, {"type": "subtitle", "time": 4493.03, "timestamp": "01:14:53", "text": "期待値と基準の等級。はぁ？"}, {"type": "subtitle", "time": 4495.35, "timestamp": "01:14:55", "text": "モールショーでは"}, {"type": "subtitle", "time": 4497.91, "timestamp": "01:14:57", "text": "より高いレベルの期待と基準"}]
[{"type": "subtitle", "time": 17823.27, "timestamp": "04:57:03", "text": "ナビゲーション ナビゲーション 右 背景"}, {"type": "subtitle", "time": 17826.23, "timestamp": "04:57:06", "text": "ナビゲーション"}, {"type": "subtitle", "time": 17840.868, "timestamp": "04:57:20", "text": "どこですか？今、できた。わかった。"}, {"type": "subtitle", "time": 17844.868, "timestamp": "04:57:24", "text": "背景は夜ですよね？そしてなぜ"}, {"type": "subtitle", "time": 17848.55, "timestamp": "04:57:28", "text": "この遅延は何を意味するのでしょうか？一体どういうことだ？"}, {"type": "subtitle", "time": 17851.27, "timestamp": "04:57:31", "text": "はい、ここに貼り付けます。わかった、"}, {"type": "subtitle", "time": 17852.868, "timestamp": "04:57:32", "text": "停止。"}, {"type": "subtitle", "time": 17854.948, "timestamp": "04:57:34", "text": "何てことだ。"}, {"type": "subtitle", "time": 17869.99, "timestamp": "04:57:49", "text": "はい、グローバルルートに追加しました。それで"}, {"type": "subtitle", "time": 17873.19, "timestamp": "04:57:53", "text": "私ができること、私の考えは今"}, {"type": "subtitle", "time": 17876.788, "timestamp": "04:57:56", "text": "背景のナビゲーションを変更します"}, {"type": "subtitle", "time": 17879.99, "timestamp": "04:57:59", "text": "夜も夜も昼も"}]
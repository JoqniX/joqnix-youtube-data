[{"type": "subtitle", "time": 1201.43, "timestamp": "00:20:01", "text": "すべて正しいですが、これは"}, {"type": "subtitle", "time": 1204.31, "timestamp": "00:20:04", "text": "フロントエンドは、ウェブスタジオであっても"}, {"type": "subtitle", "time": 1207.909, "timestamp": "00:20:07", "text": "セルフホスティングが可能になります。それは"}, {"type": "subtitle", "time": 1212.47, "timestamp": "00:20:12", "text": "つまり、VPSを購入しなければならないということですよね？売る"}, {"type": "subtitle", "time": 1216.31, "timestamp": "00:20:16", "text": "ええと、携帯電話のウェブスタジオがあります。それから私は"}, {"type": "subtitle", "time": 1219.029, "timestamp": "00:20:19", "text": "他のことをしなければならない、"}, {"type": "subtitle", "time": 1221.43, "timestamp": "00:20:21", "text": "右？他にもいろいろありますよね？その他のもの"}, {"type": "subtitle", "time": 1224.95, "timestamp": "00:20:24", "text": "例えばCMS関連のものなら"}, {"type": "subtitle", "time": 1227.75, "timestamp": "00:20:27", "text": "ベース行を実行するには、セルフホストする必要があります"}, {"type": "subtitle", "time": 1231.19, "timestamp": "00:20:31", "text": "自己ホストベース行。では、他に何があるだろうか？のために"}, {"type": "subtitle", "time": 1233.11, "timestamp": "00:20:33", "text": "認証とユーザー認証"}, {"type": "subtitle", "time": 1236.47, "timestamp": "00:20:36", "text": "そして全て。えーとデータベース関連の"}, {"type": "subtitle", "time": 1239.43, "timestamp": "00:20:39", "text": "apprite のように自己ホストするか、"}, {"type": "subtitle", "time": 1241.83, "timestamp": "00:20:41", "text": "スーパーベース"}, {"type": "subtitle", "time": 1244.23, "timestamp": "00:20:44", "text": "それら全て、私は大丈夫です"}, {"type": "subtitle", "time": 1247.35, "timestamp": "00:20:47", "text": "正直に言うと、フロントエンド向けのウェブスタジオ"}, {"type": "subtitle", "time": 1249.59, "timestamp": "00:20:49", "text": "これでいいよ、だって今は"}, {"type": "subtitle", "time": 1252.47, "timestamp": "00:20:52", "text": "ご覧のとおり、"}, {"type": "subtitle", "time": 1255.669, "timestamp": "00:20:55", "text": "独自のクラウド上で実行されています"}, {"type": "subtitle", "time": 1258.31, "timestamp": "00:20:58", "text": "サーバーは今これこのエディターです"}]
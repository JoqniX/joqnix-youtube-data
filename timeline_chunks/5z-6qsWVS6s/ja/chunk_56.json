[{"type": "subtitle", "time": 3362.63, "timestamp": "00:56:02", "text": "そして歌手ですよね？そしてイブのほとんど"}, {"type": "subtitle", "time": 3365.349, "timestamp": "00:56:05", "text": "曲、すべてのミュージックビデオ、あなたが見るのは"}, {"type": "subtitle", "time": 3366.87, "timestamp": "00:56:06", "text": "性格も何もかも違う、"}, {"type": "subtitle", "time": 3369.91, "timestamp": "00:56:09", "text": "右？登場人物の物語、彼らがどのようにして"}, {"type": "subtitle", "time": 3373.109, "timestamp": "00:56:13", "text": "これなど、似たような歌の音楽"}, {"type": "subtitle", "time": 3376.309, "timestamp": "00:56:16", "text": "賢明ですよね？同じシステムです。私はやりたかった"}, {"type": "subtitle", "time": 3380.309, "timestamp": "00:56:20", "text": "これに似たもの。だからそれは"}, {"type": "subtitle", "time": 3381.99, "timestamp": "00:56:21", "text": "むしろキャラクターの倉庫といった感じ"}, {"type": "subtitle", "time": 3383.589, "timestamp": "00:56:23", "text": "独自のストーリーラインを持ち、"}, {"type": "subtitle", "time": 3386.549, "timestamp": "00:56:26", "text": "すべて、そしてすべて。えっと、それで私は"}, {"type": "subtitle", "time": 3388.549, "timestamp": "00:56:28", "text": "自分の創造性を表現したかった"}, {"type": "subtitle", "time": 3391.99, "timestamp": "00:56:31", "text": "この方向は、次のように言うことができます"}, {"type": "subtitle", "time": 3395.75, "timestamp": "00:56:35", "text": "音楽、コミック、マンガの形で"}, {"type": "subtitle", "time": 3398.23, "timestamp": "00:56:38", "text": "それらのアニメーションはすべて"}, {"type": "subtitle", "time": 3400.549, "timestamp": "00:56:40", "text": "ゲーム面でもビジュアル面でも"}, {"type": "subtitle", "time": 3403.829, "timestamp": "00:56:43", "text": "小説とか全部そうだったから、"}, {"type": "subtitle", "time": 3406.71, "timestamp": "00:56:46", "text": "私が良い例として望んでいたのは"}, {"type": "subtitle", "time": 3408.63, "timestamp": "00:56:48", "text": "神スバキ"}, {"type": "subtitle", "time": 3416.309, "timestamp": "00:56:56", "text": "いい例ですね"}, {"type": "subtitle", "time": 3418.549, "timestamp": "00:56:58", "text": "私が欲しいもの、そして私はある意味"}]
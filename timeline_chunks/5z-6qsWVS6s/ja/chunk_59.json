[{"type": "subtitle", "time": 3540.549, "timestamp": "00:59:00", "text": "演奏も歌もする。それが"}, {"type": "subtitle", "time": 3543.91, "timestamp": "00:59:03", "text": "将来は一人でやりたい。"}, {"type": "subtitle", "time": 3546.549, "timestamp": "00:59:06", "text": "では、堺ではこれらの罪で何をするのでしょうか"}, {"type": "subtitle", "time": 3548.309, "timestamp": "00:59:08", "text": "シリーズやコンサートのようなもの、"}, {"type": "subtitle", "time": 3551.03, "timestamp": "00:59:11", "text": "右？神椿戦争または神椿"}, {"type": "subtitle", "time": 3553.829, "timestamp": "00:59:13", "text": "現在進行中の出来事。"}, {"type": "subtitle", "time": 3556.309, "timestamp": "00:59:16", "text": "ええと、彼らがやっていることは、世界"}, {"type": "subtitle", "time": 3558.71, "timestamp": "00:59:18", "text": "上椿市の環境​​または"}, {"type": "subtitle", "time": 3561.349, "timestamp": "00:59:21", "text": "伝承に基づいたもの。すべての曲は"}, {"type": "subtitle", "time": 3565.19, "timestamp": "00:59:25", "text": "彼らの伝承に基づく。すべての曲"}, {"type": "subtitle", "time": 3567.51, "timestamp": "00:59:27", "text": "曲とその歌詞の書き方すべて"}, {"type": "subtitle", "time": 3570.63, "timestamp": "00:59:30", "text": "それは伝承と結びつけることができる"}, {"type": "subtitle", "time": 3573.589, "timestamp": "00:59:33", "text": "ある意味では、それは本当に良いことで、"}, {"type": "subtitle", "time": 3576.309, "timestamp": "00:59:36", "text": "すごくクールだから、私が望んでいた通り"}, {"type": "subtitle", "time": 3580.309, "timestamp": "00:59:40", "text": "私もそれを欲しい"}, {"type": "subtitle", "time": 3582.87, "timestamp": "00:59:42", "text": "それはむしろ、創造性を分配するようなものだ"}, {"type": "subtitle", "time": 3585.51, "timestamp": "00:59:45", "text": "コンサートを観ているような体験を"}, {"type": "subtitle", "time": 3588.549, "timestamp": "00:59:48", "text": "コンサートはどんな感じですか"}, {"type": "subtitle", "time": 3590.95, "timestamp": "00:59:50", "text": "ユニークな体験と呼ぶか、何かと呼ぶか"}, {"type": "subtitle", "time": 3593.19, "timestamp": "00:59:53", "text": "ほら、私はそれをとてもベースにしたかったんだ"}, {"type": "subtitle", "time": 3595.829, "timestamp": "00:59:55", "text": "伝承に基づいたイベントか何かで、"}, {"type": "subtitle", "time": 3598.069, "timestamp": "00:59:58", "text": "彼らは今アニメーションを持っている"}]
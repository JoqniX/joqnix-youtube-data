[{"type": "subtitle", "time": 1382.07, "timestamp": "00:23:02", "text": "すごくかっこいい。映画鑑賞会など"}, {"type": "subtitle", "time": 1384.95, "timestamp": "00:23:04", "text": "ここにもいる。おい、ちょっと待ってくれよ。これですか"}, {"type": "subtitle", "time": 1387.59, "timestamp": "00:23:07", "text": "アニメ関連のもの？"}, {"type": "subtitle", "time": 1389.909, "timestamp": "00:23:09", "text": "待って、ちょっと待って。これは私が考えていることでしょうか"}, {"type": "subtitle", "time": 1396.789, "timestamp": "00:23:16", "text": "カレンダー購読"}, {"type": "subtitle", "time": 1399.029, "timestamp": "00:23:19", "text": "法人"}, {"type": "subtitle", "time": 1400.95, "timestamp": "00:23:20", "text": "わからない。"}, {"type": "subtitle", "time": 1403.029, "timestamp": "00:23:23", "text": "えっと"}, {"type": "subtitle", "time": 1407.99, "timestamp": "00:23:27", "text": "彼女はコルではないと思います"}, {"type": "subtitle", "time": 1411.35, "timestamp": "00:23:31", "text": "牛乳。彼女は企業人ではないと思う。わからない。"}, {"type": "subtitle", "time": 1414.31, "timestamp": "00:23:34", "text": "忘れた。"}, {"type": "subtitle", "time": 1416.63, "timestamp": "00:23:36", "text": "彼らは今、独自の開発チームを持っている。彼らは"}, {"type": "subtitle", "time": 1419.11, "timestamp": "00:23:39", "text": "ラプラを生き返らせたのは彼らです"}, {"type": "subtitle", "time": 1422.63, "timestamp": "00:23:42", "text": "ライブチャット機能。膝を使わないチャット。"}, {"type": "subtitle", "time": 1425.35, "timestamp": "00:23:45", "text": "labless.liv"}, {"type": "subtitle", "time": 1431.43, "timestamp": "00:23:51", "text": "chat.lapless ライブ 私はこれではありません。"}, {"type": "subtitle", "time": 1434.23, "timestamp": "00:23:54", "text": "彼らがこれをやったんだ。えっと"}, {"type": "subtitle", "time": 1436.39, "timestamp": "00:23:56", "text": "これは私がビリーに使っていたものです"}, {"type": "subtitle", "time": 1438.789, "timestamp": "00:23:58", "text": "ビリーがそこでストリーミング配信していたとき"}]
[{"type": "subtitle", "time": 15030.309, "timestamp": "04:10:30", "text": "入手困難なブレンドモードのようなものはありません。"}, {"type": "subtitle", "time": 15033.269, "timestamp": "04:10:33", "text": "ええ、それは私が抱える問題の一つです"}, {"type": "subtitle", "time": 15036.309, "timestamp": "04:10:36", "text": "私は画像ソースとして直接使用しています。いいえ、"}, {"type": "subtitle", "time": 15040.15, "timestamp": "04:10:40", "text": "ブレンドモードのことですよね？もし私が"}, {"type": "subtitle", "time": 15042.389, "timestamp": "04:10:42", "text": "例えば、私が追加しているように"}, {"type": "subtitle", "time": 15047.03, "timestamp": "04:10:47", "text": "ここ。画像はありません。私はこれを選びます。"}, {"type": "subtitle", "time": 15049.03, "timestamp": "04:10:49", "text": "私は星座を配置しました。ああ、これは"}, {"type": "subtitle", "time": 15054.63, "timestamp": "04:10:54", "text": "ニース。繰り返されている。いいですね。見る、"}, {"type": "subtitle", "time": 15056.79, "timestamp": "04:10:56", "text": "それはすばらしい。"}]
[{"type": "subtitle", "time": 8102.709, "timestamp": "02:15:02", "text": "あなたはここにいますか？ 「睡眠中」と表示されていた。"}, {"type": "subtitle", "time": 8104.79, "timestamp": "02:15:04", "text": "何？寝てるの？何？どういう意味"}, {"type": "subtitle", "time": 8106.47, "timestamp": "02:15:06", "text": "寝ている？"}, {"type": "subtitle", "time": 8109.35, "timestamp": "02:15:09", "text": "どこ？私の上には「ライブ」と書いてある"}, {"type": "subtitle", "time": 8112.95, "timestamp": "02:15:12", "text": "画面には「ライブ」と表示され、何が"}, {"type": "subtitle", "time": 8115.35, "timestamp": "02:15:15", "text": "私たちがやっていることや活動など"}, {"type": "subtitle", "time": 8134.39, "timestamp": "02:15:34", "text": "それはどういう意味ですか"}, {"type": "subtitle", "time": 8140.229, "timestamp": "02:15:40", "text": "私たちは今、これを見たところです。ああ、心配しないでください。しないで"}, {"type": "subtitle", "time": 8145.109, "timestamp": "02:15:45", "text": "心配。心配しないで。きっとそうでしょうね。"}, {"type": "subtitle", "time": 8147.27, "timestamp": "02:15:47", "text": "ああ、あの活動。そうそう。気にしないで"}, {"type": "subtitle", "time": 8149.189, "timestamp": "02:15:49", "text": "それ。わかった。気にしないでください。気にしないで"}, {"type": "subtitle", "time": 8156.39, "timestamp": "02:15:56", "text": "心配ない。心配ない。元気でいてくれるといいな"}, {"type": "subtitle", "time": 8159.83, "timestamp": "02:15:59", "text": "順調です。ウェブサイト関連の作業をしています"}]
[{"type": "subtitle", "time": 14227.349, "timestamp": "03:57:07", "text": "ええ、この人を移動させるだけです。いいえ、それで"}, {"type": "subtitle", "time": 14231.349, "timestamp": "03:57:11", "text": "アニメーションの新しいキーフレーム。"}, {"type": "subtitle", "time": 14235.11, "timestamp": "03:57:15", "text": "どうやって作るのですか？待って、ちょっと考えてみる"}, {"type": "subtitle", "time": 14244.55, "timestamp": "03:57:24", "text": "腐敗させることはできますか？いや、回転させるとおかしくなるよ。"}, {"type": "subtitle", "time": 14255.91, "timestamp": "03:57:35", "text": "上下。彼らは何をするのでしょうか"}, {"type": "subtitle", "time": 14263.99, "timestamp": "03:57:43", "text": "左右に動いているか何かで、"}, {"type": "subtitle", "time": 14265.67, "timestamp": "03:57:45", "text": "右？"}, {"type": "subtitle", "time": 14269.189, "timestamp": "03:57:49", "text": "あのざらざらしたテレビの画面みたいなやつ、"}, {"type": "subtitle", "time": 14271.83, "timestamp": "03:57:51", "text": "右？これは見ることができます。いいえ。"}, {"type": "subtitle", "time": 14278.87, "timestamp": "03:57:58", "text": "えっと"}]
[{"type": "subtitle", "time": 2880.55, "timestamp": "00:48:00", "text": "私は夕食、朝食、真夜中を食べています"}, {"type": "subtitle", "time": 2882.63, "timestamp": "00:48:02", "text": "おやつを食べているとき、トイレに行くとき、"}, {"type": "subtitle", "time": 2886.23, "timestamp": "00:48:06", "text": "目が覚めると、いつも通りだった"}, {"type": "subtitle", "time": 2889.589, "timestamp": "00:48:09", "text": "私はこうするしかなかった。やらざるを得なかった"}, {"type": "subtitle", "time": 2891.589, "timestamp": "00:48:11", "text": "このボタンのように"}, {"type": "subtitle", "time": 2893.67, "timestamp": "00:48:13", "text": "形式。私は自分のボタンを押さなければならなかった"}, {"type": "subtitle", "time": 2896.63, "timestamp": "00:48:16", "text": "電話でストリーミング中に更新します。のために"}, {"type": "chat", "time": 2898.329, "timestamp": "00:48:18", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Joq's Activity State is Sleeping 😴✨"}, {"type": "subtitle", "time": 2900.55, "timestamp": "00:48:20", "text": "例えば、配信中に寝ると"}, {"type": "subtitle", "time": 2903.43, "timestamp": "00:48:23", "text": "ボタンをクリックすると、"}, {"type": "subtitle", "time": 2907.19, "timestamp": "00:48:27", "text": "OBS のオーバーレイと、"}, {"type": "subtitle", "time": 2909.99, "timestamp": "00:48:29", "text": "TwitchやYouTubeのチャットはまさにそんな感じだ。"}, {"type": "subtitle", "time": 2912.87, "timestamp": "00:48:32", "text": "さて、これを自動化したいのですが"}, {"type": "subtitle", "time": 2916.63, "timestamp": "00:48:36", "text": "何とかして動的に設定できます"}, {"type": "subtitle", "time": 2919.99, "timestamp": "00:48:39", "text": "現実世界で。まるで、もし"}, {"type": "subtitle", "time": 2922.63, "timestamp": "00:48:42", "text": "方法があると思う。可能だと思う。"}, {"type": "subtitle", "time": 2926.069, "timestamp": "00:48:46", "text": "私がウェブフックを送信すると想像してみてください"}, {"type": "subtitle", "time": 2928.87, "timestamp": "00:48:48", "text": "えーと、Alexaからのリクエストか何か、"}, {"type": "subtitle", "time": 2931.43, "timestamp": "00:48:51", "text": "「OK Google」とか、そういう感じですよね。"}, {"type": "subtitle", "time": 2934.39, "timestamp": "00:48:54", "text": "えっと、目を覚ますと、想像してみてください"}, {"type": "subtitle", "time": 2936.71, "timestamp": "00:48:56", "text": "神様みたいに、たくさんのアイデアが浮かぶ"}, {"type": "subtitle", "time": 2939.43, "timestamp": "00:48:59", "text": "この1秒間に一体何が起こっているのか想像してみてください"}]
[{"type": "subtitle", "time": 6180.229, "timestamp": "01:43:00", "text": "大学は修士号のようなものをします、または"}, {"type": "subtitle", "time": 6183.109, "timestamp": "01:43:03", "text": "大学に入学するための何か"}, {"type": "subtitle", "time": 6184.95, "timestamp": "01:43:04", "text": "東京大学か何かだろう"}, {"type": "subtitle", "time": 6187.83, "timestamp": "01:43:07", "text": "大変だけど、そこへ行こうとしたら、"}, {"type": "subtitle", "time": 6190.629, "timestamp": "01:43:10", "text": "2年後には変えなければならない"}, {"type": "subtitle", "time": 6192.79, "timestamp": "01:43:12", "text": "ビザの権利を元に戻します"}, {"type": "subtitle", "time": 6194.629, "timestamp": "01:43:14", "text": "学生ビザまたは就労ビザの権利"}, {"type": "subtitle", "time": 6198.229, "timestamp": "01:43:18", "text": "日本に滞在する、たくさんの"}, {"type": "subtitle", "time": 6201.03, "timestamp": "01:43:21", "text": "私が主に日本に行きたかったこと"}, {"type": "subtitle", "time": 6203.75, "timestamp": "01:43:23", "text": "仕事に就きたかったから"}, {"type": "subtitle", "time": 6205.59, "timestamp": "01:43:25", "text": "えーと、それはエンターテインメント業界です"}, {"type": "subtitle", "time": 6208.55, "timestamp": "01:43:28", "text": "チューブなどの業界関連または"}, {"type": "subtitle", "time": 6211.27, "timestamp": "01:43:31", "text": "何か、そうすれば、えーと、何か"}, {"type": "subtitle", "time": 6213.669, "timestamp": "01:43:33", "text": "私は誓いを立てたかった"}, {"type": "subtitle", "time": 6217.109, "timestamp": "01:43:37", "text": "チャンネルをポートフォリオとして活用し、仕事を得る"}, {"type": "subtitle", "time": 6219.51, "timestamp": "01:43:39", "text": "あるいはチャンスか何かかもしれない"}, {"type": "subtitle", "time": 6222.07, "timestamp": "01:43:42", "text": "私は自分の声を練習して、"}, {"type": "subtitle", "time": 6224.79, "timestamp": "01:43:44", "text": "声優とか何か"}, {"type": "subtitle", "time": 6228.79, "timestamp": "01:43:48", "text": "そうですね、でも、これも役に立つでしょう"}, {"type": "subtitle", "time": 6231.03, "timestamp": "01:43:51", "text": "これは私の経験に役立つでしょう"}, {"type": "subtitle", "time": 6235.59, "timestamp": "01:43:55", "text": "それに、Vubingの観点からも"}, {"type": "subtitle", "time": 6237.91, "timestamp": "01:43:57", "text": "日本から始まった。だからたくさんもらえるかもしれない"}]
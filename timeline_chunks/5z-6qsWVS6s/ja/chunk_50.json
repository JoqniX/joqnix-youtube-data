[{"type": "subtitle", "time": 3001.99, "timestamp": "00:50:01", "text": "右？えっと、展示が多すぎる。ええ、わかっています。"}, {"type": "subtitle", "time": 3005.91, "timestamp": "00:50:05", "text": "でも、そう、ワイズを修正して、下位のワイズを修正しました"}, {"type": "subtitle", "time": 3009.589, "timestamp": "00:50:09", "text": "システムIで私が考えているのは、"}, {"type": "subtitle", "time": 3011.91, "timestamp": "00:50:11", "text": "例えば、カレンダーのようなもの。だから"}, {"type": "subtitle", "time": 3014.95, "timestamp": "00:50:14", "text": "カレンダー、そう、カレンダーのように"}, {"type": "subtitle", "time": 3020.309, "timestamp": "00:50:20", "text": "えっと、カレンダーに書いてあるかな。"}, {"type": "subtitle", "time": 3023.03, "timestamp": "00:50:23", "text": "何てことだ。わかった。カレンダーのように"}, {"type": "subtitle", "time": 3025.75, "timestamp": "00:50:25", "text": "設定は正しいですか？えっと、例えばショーのように"}, {"type": "subtitle", "time": 3029.51, "timestamp": "00:50:29", "text": "カレンダーの設定のようなノテーションカレンダー"}, {"type": "subtitle", "time": 3032.15, "timestamp": "00:50:32", "text": "えーっと、カレンダーの設定で月ごとに"}, {"type": "subtitle", "time": 3035.91, "timestamp": "00:50:35", "text": "事前作成アクティビティを設定する"}, {"type": "subtitle", "time": 3039.03, "timestamp": "00:50:39", "text": "例えば私の誕生日は8月です"}, {"type": "subtitle", "time": 3043.27, "timestamp": "00:50:43", "text": "11、つまり8月11日、こう表現できます。"}, {"type": "subtitle", "time": 3045.99, "timestamp": "00:50:45", "text": "ジョークの誕生日と8月10日ジョーは何"}, {"type": "subtitle", "time": 3048.47, "timestamp": "00:50:48", "text": "例えば私が戦いに行ったら"}, {"type": "subtitle", "time": 3049.99, "timestamp": "00:50:49", "text": "ダンジョンのボスか何か"}, {"type": "subtitle", "time": 3053.43, "timestamp": "00:50:53", "text": "特定の時間ならそれもできます。"}, {"type": "subtitle", "time": 3056.71, "timestamp": "00:50:56", "text": "もし私が作家を起用できると言ったら"}, {"type": "subtitle", "time": 3059.19, "timestamp": "00:50:59", "text": "自分の物語を書かなければならないので、"}]
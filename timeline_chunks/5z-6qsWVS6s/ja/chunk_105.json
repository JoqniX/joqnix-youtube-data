[{"type": "subtitle", "time": 6301.91, "timestamp": "01:45:01", "text": "他のニッチな分野を探求していた"}, {"type": "subtitle", "time": 6304.229, "timestamp": "01:45:04", "text": "私は自分が何が得意なのか知りたかったのです。いいえ。"}, {"type": "subtitle", "time": 6306.55, "timestamp": "01:45:06", "text": "それでグラフィックデザインやゲームデザインを試してみました"}, {"type": "subtitle", "time": 6308.87, "timestamp": "01:45:08", "text": "吹き替えも含めて全て。学習された統一"}, {"type": "subtitle", "time": 6311.43, "timestamp": "01:45:11", "text": "チュートリアル動画を見ることすべて。だから私は"}, {"type": "subtitle", "time": 6313.75, "timestamp": "01:45:13", "text": "自分のグッズが欲しかったので欲しかった"}, {"type": "subtitle", "time": 6316.629, "timestamp": "01:45:16", "text": "そして服飾ブランド、ファッション関連のもの。私 私"}, {"type": "subtitle", "time": 6318.149, "timestamp": "01:45:18", "text": "ファッションデザインに興味があった"}, {"type": "subtitle", "time": 6321.669, "timestamp": "01:45:21", "text": "YouTubeのチュートリアル。私は"}, {"type": "subtitle", "time": 6324.39, "timestamp": "01:45:24", "text": "小さめの服で、縫い合わせたような感じ"}, {"type": "subtitle", "time": 6327.43, "timestamp": "01:45:27", "text": "何かランダムなもの。だから、ちょっと楽しかったよ。"}, {"type": "subtitle", "time": 6329.83, "timestamp": "01:45:29", "text": "それを行うために。だから、私は考えていたのかもしれない"}, {"type": "subtitle", "time": 6332.31, "timestamp": "01:45:32", "text": "そこでならそれが可能です。"}, {"type": "subtitle", "time": 6336.79, "timestamp": "01:45:36", "text": "あと、私はあの髪型がすごく好きなんです。えっと"}, {"type": "subtitle", "time": 6339.109, "timestamp": "01:45:39", "text": "ヘアスタイルとかヘアデザインとか、そういう類のもの。"}, {"type": "subtitle", "time": 6341.35, "timestamp": "01:45:41", "text": "私はそれが好きです。だから私は、もしかしたらできるかもしれないと思った"}, {"type": "subtitle", "time": 6343.75, "timestamp": "01:45:43", "text": "何も上手くいかないなら美容師になろう"}, {"type": "subtitle", "time": 6347.59, "timestamp": "01:45:47", "text": "今は外出していますが、たくさんの代替案を用意していました。それで"}, {"type": "chat", "time": 6351.134, "timestamp": "01:45:51", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/DGXvUKi0q0ld5Zo5CNG2tmulZfZqg_h6ivQHLtQfKyx-z_EjHr-Bx7limqyg4JtpZ00_XP_BTQ=s64-c-k-c0x00ffffff-no-rj", "message": "yo"}, {"type": "subtitle", "time": 6352.07, "timestamp": "01:45:52", "text": "ええ、そしてYouTuberとしては、"}, {"type": "subtitle", "time": 6354.55, "timestamp": "01:45:54", "text": "インド人とインド人の間に橋を架ける"}, {"type": "subtitle", "time": 6359.03, "timestamp": "01:45:59", "text": "YouTuberとJP CNと料理系YouTuber"}]
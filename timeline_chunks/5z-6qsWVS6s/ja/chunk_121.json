[{"type": "subtitle", "time": 7263.03, "timestamp": "02:01:03", "text": "ええ、この画像はファンアートでした"}, {"type": "subtitle", "time": 7265.99, "timestamp": "02:01:05", "text": "これは撮影クルーの写真でした。これは写真です"}, {"type": "subtitle", "time": 7270.31, "timestamp": "02:01:10", "text": "クルー。これはファンアートです"}, {"type": "subtitle", "time": 7273.189, "timestamp": "02:01:13", "text": "また、これもまた、これは"}, {"type": "subtitle", "time": 7275.83, "timestamp": "02:01:15", "text": "ファンアートでもあります。"}, {"type": "subtitle", "time": 7278.47, "timestamp": "02:01:18", "text": "私のものが入ってるよね？の"}, {"type": "subtitle", "time": 7280.149, "timestamp": "02:01:20", "text": "星座"}, {"type": "subtitle", "time": 7282.87, "timestamp": "02:01:22", "text": "私にとってそれは、私は8月生まれです"}, {"type": "subtitle", "time": 7286.39, "timestamp": "02:01:26", "text": "彼女にとっての獅子座。私はこう思う"}, {"type": "subtitle", "time": 7288.95, "timestamp": "02:01:28", "text": "癌です。"}, {"type": "subtitle", "time": 7291.189, "timestamp": "02:01:31", "text": "どの星座だったか忘れてしまったが、"}, {"type": "subtitle", "time": 7293.99, "timestamp": "02:01:33", "text": "そう、頭の上で、起源のように"}, {"type": "subtitle", "time": 7297.669, "timestamp": "02:01:37", "text": "マーク。これは私の新しいモデルでの変更です"}, {"type": "subtitle", "time": 7301.91, "timestamp": "02:01:41", "text": "自分。ええと、私は原産地マークを変更しました"}, {"type": "subtitle", "time": 7305.99, "timestamp": "02:01:45", "text": "私の新しいモデルには原産地マークが付いています。"}, {"type": "subtitle", "time": 7308.95, "timestamp": "02:01:48", "text": "新しいモデルはもっと"}, {"type": "subtitle", "time": 7311.669, "timestamp": "02:01:51", "text": "天体をテーマにしたもの、あるいは星座のようなもの"}, {"type": "subtitle", "time": 7316.229, "timestamp": "02:01:56", "text": "私は前立腺癌患者なので、"}, {"type": "subtitle", "time": 7319.75, "timestamp": "02:01:59", "text": "星座の。これで解決しました"}]
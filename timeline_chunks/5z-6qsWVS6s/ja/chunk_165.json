[{"type": "subtitle", "time": 9901.349, "timestamp": "02:45:01", "text": "プリズムスタジオ。"}, {"type": "subtitle", "time": 9914.469, "timestamp": "02:45:14", "text": "私はこれをやりたい。"}, {"type": "subtitle", "time": 9916.55, "timestamp": "02:45:16", "text": "これは彼ら独自のカスタム検証です"}, {"type": "subtitle", "time": 9920.55, "timestamp": "02:45:20", "text": "ボード自体が与えるもの"}, {"type": "subtitle", "time": 9922.71, "timestamp": "02:45:22", "text": "キャプチャコードを取得してください。選択しなければならない"}, {"type": "subtitle", "time": 9924.87, "timestamp": "02:45:24", "text": "それがコードです。私はこれをしたい"}, {"type": "subtitle", "time": 9945.83, "timestamp": "02:45:45", "text": "待って、それは待ってみたいなものですか、"}, {"type": "subtitle", "time": 9947.429, "timestamp": "02:45:47", "text": "あれは何？待って、それはまるで"}, {"type": "subtitle", "time": 9949.75, "timestamp": "02:45:49", "text": "ボット。待って、これ使えるよ。待って、待って、"}, {"type": "subtitle", "time": 9951.99, "timestamp": "02:45:51", "text": "待って。何？"}, {"type": "subtitle", "time": 9954.79, "timestamp": "02:45:54", "text": "待って。"}, {"type": "subtitle", "time": 9958.23, "timestamp": "02:45:58", "text": "あ、待って。ああ、これは実際に使える。"}]
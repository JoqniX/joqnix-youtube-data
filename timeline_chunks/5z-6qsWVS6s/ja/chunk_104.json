[{"type": "subtitle", "time": 6240.55, "timestamp": "01:44:00", "text": "経験と洞察"}, {"type": "subtitle", "time": 6242.47, "timestamp": "01:44:02", "text": "YouTubeのビジネス面やその他諸々"}, {"type": "subtitle", "time": 6244.709, "timestamp": "01:44:04", "text": "他のユーチューバーや代理店を支援すること"}, {"type": "subtitle", "time": 6247.99, "timestamp": "01:44:07", "text": "変更するか何か良いことがあれば"}, {"type": "subtitle", "time": 6249.75, "timestamp": "01:44:09", "text": "それはうまくいかないから、音楽の道に進むよ"}, {"type": "subtitle", "time": 6251.35, "timestamp": "01:44:11", "text": "そこには。"}, {"type": "subtitle", "time": 6254.07, "timestamp": "01:44:14", "text": "それが一番重要な点です。私は本当に"}, {"type": "subtitle", "time": 6256.39, "timestamp": "01:44:16", "text": "音楽関係のコネクションを作る"}, {"type": "subtitle", "time": 6259.51, "timestamp": "01:44:19", "text": "そこで、音楽アーティストとコラボレーションする"}, {"type": "subtitle", "time": 6261.35, "timestamp": "01:44:21", "text": "などなど。"}, {"type": "subtitle", "time": 6264.79, "timestamp": "01:44:24", "text": "子供の頃の最初の夢"}, {"type": "subtitle", "time": 6268.47, "timestamp": "01:44:28", "text": "音楽やDJをするのが好きで、"}, {"type": "subtitle", "time": 6271.109, "timestamp": "01:44:31", "text": "すべて。思うに"}, {"type": "subtitle", "time": 6274.149, "timestamp": "01:44:34", "text": "アンダーグラウンドDJのような機会"}, {"type": "subtitle", "time": 6276.39, "timestamp": "01:44:36", "text": "そして、そこにはいろいろなものがある。だから、私は自分の"}, {"type": "subtitle", "time": 6278.95, "timestamp": "01:44:38", "text": "音楽演奏やその他イベントもそこで開催できます。"}, {"type": "subtitle", "time": 6282.229, "timestamp": "01:44:42", "text": "きっと素敵な場所だろうね。もしそれが"}, {"type": "subtitle", "time": 6285.59, "timestamp": "01:44:45", "text": "うまくいかないから、ファッションのようにするよ"}, {"type": "subtitle", "time": 6287.51, "timestamp": "01:44:47", "text": "デザインとか何か、だって最初は"}, {"type": "subtitle", "time": 6289.83, "timestamp": "01:44:49", "text": "自分のグッズとかを作りたいと思ったとき"}, {"type": "subtitle", "time": 6295.27, "timestamp": "01:44:55", "text": "今、私はそのサイクルの中にいたので"}, {"type": "subtitle", "time": 6298.31, "timestamp": "01:44:58", "text": "行き詰まってしまったので、音楽を諦めました。私"}]
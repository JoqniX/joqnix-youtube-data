[{"type": "subtitle", "time": 8760.95, "timestamp": "02:26:00", "text": "それはVio拡張機能と呼ばれています。私はそれを購入しました。"}, {"type": "subtitle", "time": 8764.309, "timestamp": "02:26:04", "text": "拡張機能を使えば、より多くのものを手に入れることができます"}, {"type": "subtitle", "time": 8770.71, "timestamp": "02:26:10", "text": "ええ、それで私はABC Dハイファイとハイファイを持っています"}, {"type": "subtitle", "time": 8774.23, "timestamp": "02:26:14", "text": "そして通常のケーブルなので、それはABCのようなものです"}, {"type": "subtitle", "time": 8778.79, "timestamp": "02:26:18", "text": "Dハイファイと通常のケーブル。つまり、7つ"}, {"type": "subtitle", "time": 8782.79, "timestamp": "02:26:22", "text": "7つのVB仮想ケーブルなどですが、"}, {"type": "subtitle", "time": 8785.91, "timestamp": "02:26:25", "text": "それらはすべて私の背中のために使われています。えっと、"}, {"type": "subtitle", "time": 8788.79, "timestamp": "02:26:28", "text": "以前はデュアルPC構成だったので、"}, {"type": "subtitle", "time": 8793.51, "timestamp": "02:26:33", "text": "私のVbandのものをアップして、えっと、これがこれです"}, {"type": "subtitle", "time": 8796.71, "timestamp": "02:26:36", "text": "これは私の配信用PCのはずです。それで、"}, {"type": "subtitle", "time": 8798.79, "timestamp": "02:26:38", "text": "受信ストリームは次のようなものになるはずだった"}, {"type": "subtitle", "time": 8801.67, "timestamp": "02:26:41", "text": "私のゲーム用PCはオーディオとか全部好きです。"}, {"type": "subtitle", "time": 8803.91, "timestamp": "02:26:43", "text": "送信とは、OBS、マイク、"}, {"type": "subtitle", "time": 8806.71, "timestamp": "02:26:46", "text": "すべて。すべて。私のメインPC、ゲーム"}, {"type": "subtitle", "time": 8810.23, "timestamp": "02:26:50", "text": "PCが故障しました。 CPUが完全に壊れてしまった。"}, {"type": "subtitle", "time": 8815.349, "timestamp": "02:26:55", "text": "GPU 2060が故障しました。 CPUはAMD Ryzen 7でした。"}]
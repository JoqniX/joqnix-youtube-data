[{"type": "subtitle", "time": 5464.79, "timestamp": "01:31:04", "text": "彼らは各ゲームごとにガイドラインを用意している。"}, {"type": "subtitle", "time": 5466.55, "timestamp": "01:31:06", "text": "彼らにはガイドラインがある。新しい"}, {"type": "subtitle", "time": 5469.59, "timestamp": "01:31:09", "text": "ゲームが発売されたら、彼らはそれを言及するだろう"}, {"type": "subtitle", "time": 5473.03, "timestamp": "01:31:13", "text": "彼らのニュース番組。えっと、できるかどうか"}, {"type": "subtitle", "time": 5474.87, "timestamp": "01:31:14", "text": "ストリーミングするかどうか、またはどのようにすべきか"}, {"type": "subtitle", "time": 5479.91, "timestamp": "01:31:19", "text": "それをストリーミング配信したり、そういう類のことです。"}, {"type": "subtitle", "time": 5481.669, "timestamp": "01:31:21", "text": "私はコラボレーションする予定だった"}, {"type": "subtitle", "time": 5484.31, "timestamp": "01:31:24", "text": "熱心なYouTuber。えっと、彼らはそうしない"}, {"type": "subtitle", "time": 5487.51, "timestamp": "01:31:27", "text": "そこではVTuberと呼んでいます。彼らはそれを"}, {"type": "subtitle", "time": 5491.189, "timestamp": "01:31:31", "text": "えーと、バーチャルアップマスター。 Vups"}, {"type": "subtitle", "time": 5495.43, "timestamp": "01:31:35", "text": "vup。うん。 Vアップ V U"}, {"type": "subtitle", "time": 5497.75, "timestamp": "01:31:37", "text": "V WOPかな。うん。うん。彼らはそれを"}, {"type": "subtitle", "time": 5500.39, "timestamp": "01:31:40", "text": "そんな感じ。代理店はここで、"}, {"type": "subtitle", "time": 5503.75, "timestamp": "01:31:43", "text": "ビリーの罪悪感とコメントは"}, {"type": "subtitle", "time": 5505.99, "timestamp": "01:31:45", "text": "まるで弾幕攻撃のようだ。"}, {"type": "subtitle", "time": 5508.95, "timestamp": "01:31:48", "text": "物を見せてください。"}, {"type": "subtitle", "time": 5512.47, "timestamp": "01:31:52", "text": "つまり、ある意味では良いことなんです。"}, {"type": "subtitle", "time": 5514.47, "timestamp": "01:31:54", "text": "今のところ、誹謗中傷コメントは一つもありません。"}, {"type": "subtitle", "time": 5517.27, "timestamp": "01:31:57", "text": "あるいは何でも。私がそう思っていたすべての人"}]
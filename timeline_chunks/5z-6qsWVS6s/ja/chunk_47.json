[{"type": "subtitle", "time": 2821.43, "timestamp": "00:47:01", "text": "モバイルアプリまたは私に関連するもの、"}, {"type": "subtitle", "time": 2823.349, "timestamp": "00:47:03", "text": "えっと、今のところは私ですが、将来的には"}, {"type": "subtitle", "time": 2825.67, "timestamp": "00:47:05", "text": "あなたのキャラクターのためにそれをやります"}, {"type": "subtitle", "time": 2829.349, "timestamp": "00:47:09", "text": "良い。つまり、チェックするゲームのようなもの"}, {"type": "subtitle", "time": 2831.99, "timestamp": "00:47:11", "text": "シムズのようなゲームと"}, {"type": "subtitle", "time": 2834.39, "timestamp": "00:47:14", "text": "キャラクターをクリックするもの"}, {"type": "subtitle", "time": 2836.23, "timestamp": "00:47:16", "text": "あなたのNPCキャラクターは、彼らが何をしているか見ることができます"}, {"type": "subtitle", "time": 2838.63, "timestamp": "00:47:18", "text": "気分次第で"}, {"type": "subtitle", "time": 2840.71, "timestamp": "00:47:20", "text": "彼らは正しいことをしているし、すべて同様だ"}, {"type": "subtitle", "time": 2843.43, "timestamp": "00:47:23", "text": "そこで私は、"}, {"type": "subtitle", "time": 2845.109, "timestamp": "00:47:25", "text": "ウェブサイトか何か実際に"}, {"type": "subtitle", "time": 2848.95, "timestamp": "00:47:28", "text": "ディスプレイ ディスプレイ ディスプレイ 私が"}, {"type": "subtitle", "time": 2852.79, "timestamp": "00:47:32", "text": "3つの形式で行う、例えば"}, {"type": "subtitle", "time": 2855.99, "timestamp": "00:47:35", "text": "現実世界に基づいている"}, {"type": "subtitle", "time": 2859.51, "timestamp": "00:47:39", "text": "現実世界とかそういうこと。 2番目は"}, {"type": "subtitle", "time": 2863.03, "timestamp": "00:47:43", "text": "えっと、現実世界では、"}, {"type": "subtitle", "time": 2865.349, "timestamp": "00:47:45", "text": "ストリーム配信なども含め、すべて同様です。それ"}, {"type": "subtitle", "time": 2869.19, "timestamp": "00:47:49", "text": "Vユーチューバーみたいな生活を送って、"}, {"type": "subtitle", "time": 2871.829, "timestamp": "00:47:51", "text": "その2番目の部分は修正のようになります"}, {"type": "subtitle", "time": 2874.95, "timestamp": "00:47:54", "text": "下部の土台部分も同様です。あなたがやる"}, {"type": "subtitle", "time": 2878.15, "timestamp": "00:47:58", "text": "現実の現実、例えばこれのように、もし"}]
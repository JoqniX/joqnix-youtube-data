[{"type": "subtitle", "time": 10622.87, "timestamp": "02:57:02", "text": "相対値100か。そして私は詰め物をして"}, {"type": "subtitle", "time": 10626.309, "timestamp": "02:57:06", "text": "オートマリングスはオートでした。私はパディングをしました"}, {"type": "subtitle", "time": 10629.51, "timestamp": "02:57:09", "text": "1.5 mm。"}, {"type": "subtitle", "time": 10631.75, "timestamp": "02:57:11", "text": "わかった。だから私たちは同じことをしなければならない"}, {"type": "subtitle", "time": 10641.19, "timestamp": "02:57:21", "text": "わかった。そうしましょう。えっと、容器。"}, {"type": "subtitle", "time": 10644.389, "timestamp": "02:57:24", "text": "わかった。新しい要素。"}, {"type": "subtitle", "time": 10648.23, "timestamp": "02:57:28", "text": "ええと、私たちは探しています"}, {"type": "subtitle", "time": 10652.15, "timestamp": "02:57:32", "text": "ナビゲーションメニュータブダイアログ"}, {"type": "subtitle", "time": 10653.91, "timestamp": "02:57:33", "text": "オーバーレイ付きでコンテンツを表示する"}, {"type": "subtitle", "time": 10655.83, "timestamp": "02:57:35", "text": "ボタンによって表示されるウィンドウを覆います。"}, {"type": "subtitle", "time": 10658.23, "timestamp": "02:57:38", "text": "オーバーレイをクリックすると、"}, {"type": "subtitle", "time": 10666.55, "timestamp": "02:57:46", "text": "ナビゲーションメニューは、あのメニューのことです。"}, {"type": "subtitle", "time": 10669.67, "timestamp": "02:57:49", "text": "右？全画面表示のようなものが欲しいです。"}, {"type": "subtitle", "time": 10671.19, "timestamp": "02:57:51", "text": "右？"}, {"type": "subtitle", "time": 10674.63, "timestamp": "02:57:54", "text": "だから、私はセリフを言わなければならない。"}, {"type": "subtitle", "time": 10677.59, "timestamp": "02:57:57", "text": "これでボタンができました"}]
[{"type": "subtitle", "time": 14106.55, "timestamp": "03:55:06", "text": "私たちはアニメーション化しようとしています"}, {"type": "subtitle", "time": 14117.91, "timestamp": "03:55:17", "text": "アニメーションさせたいインスタンスを追加してください。"}, {"type": "subtitle", "time": 14120.229, "timestamp": "03:55:20", "text": "これをアニメーション化したいのですが、"}, {"type": "subtitle", "time": 14125.59, "timestamp": "03:55:25", "text": "アニメーショングループ これを実行してデバッグします"}, {"type": "subtitle", "time": 14135.269, "timestamp": "03:55:35", "text": "このテキストビデオをずらして表示できます"}, {"type": "subtitle", "time": 14136.95, "timestamp": "03:55:36", "text": "子要素をアニメーション化できます"}, {"type": "subtitle", "time": 14138.87, "timestamp": "03:55:38", "text": "スライド式の窓の中に。私たちは必要としません"}, {"type": "subtitle", "time": 14141.429, "timestamp": "03:55:41", "text": "それ。アニメーション制作チームが必要なだけです。ここ"}, {"type": "subtitle", "time": 14144.87, "timestamp": "03:55:44", "text": "アニメーションでは、"}, {"type": "subtitle", "time": 14155.83, "timestamp": "03:55:55", "text": "えっと、位置を変えます。"}]
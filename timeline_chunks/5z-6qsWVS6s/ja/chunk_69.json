[{"type": "subtitle", "time": 4141.59, "timestamp": "01:09:01", "text": "拡散を好み、追加する人もいます"}, {"type": "subtitle", "time": 4144.63, "timestamp": "01:09:04", "text": "その言葉は痛みです。私は本当にそれを望んでいました"}, {"type": "subtitle", "time": 4147.269, "timestamp": "01:09:07", "text": "データベースとかそういうもの"}, {"type": "subtitle", "time": 4150.309, "timestamp": "01:09:10", "text": "YouTuberによって。視聴者にとっては、"}, {"type": "subtitle", "time": 4154.309, "timestamp": "01:09:14", "text": "YouTuberを簡単に見つける。いいえ、そこ"}, {"type": "subtitle", "time": 4156.709, "timestamp": "01:09:16", "text": "需要は全くなかった。ゆっくりと"}, {"type": "subtitle", "time": 4158.309, "timestamp": "01:09:18", "text": "ハプニング。コミュニティとすべて"}, {"type": "subtitle", "time": 4161.11, "timestamp": "01:09:21", "text": "本当に小さいです、大きすぎず、"}, {"type": "subtitle", "time": 4164.07, "timestamp": "01:09:24", "text": "何でも。すべてのIMTuberの人々"}, {"type": "subtitle", "time": 4167.51, "timestamp": "01:09:27", "text": "それぞれ共通の視聴者層を持っている。"}, {"type": "subtitle", "time": 4169.669, "timestamp": "01:09:29", "text": "例えば、"}, {"type": "subtitle", "time": 4172.63, "timestamp": "01:09:32", "text": "企業のユーチューバーの視聴者は"}, {"type": "subtitle", "time": 4175.91, "timestamp": "01:09:35", "text": "インディーズ系YouTuberに似ている。個人"}, {"type": "subtitle", "time": 4178.55, "timestamp": "01:09:38", "text": "同じものと積極的にコラボレーションしている"}, {"type": "subtitle", "time": 4181.91, "timestamp": "01:09:41", "text": "そのような企業、またはほとんどの企業"}, {"type": "subtitle", "time": 4184.47, "timestamp": "01:09:44", "text": "インディーズには独自のファン層がいる"}, {"type": "subtitle", "time": 4187.269, "timestamp": "01:09:47", "text": "彼らの中には独自の視聴者がいるか、"}, {"type": "subtitle", "time": 4190.47, "timestamp": "01:09:50", "text": "より多くの時間それはより"}, {"type": "subtitle", "time": 4193.03, "timestamp": "01:09:53", "text": "共通の視聴者層は、"}, {"type": "subtitle", "time": 4195.99, "timestamp": "01:09:55", "text": "小さいものも小さいもの"}, {"type": "subtitle", "time": 4198.31, "timestamp": "01:09:58", "text": "本当に小さい、小さいのもその一つ"}]
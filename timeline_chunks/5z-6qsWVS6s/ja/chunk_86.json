[{"type": "subtitle", "time": 5160.07, "timestamp": "01:26:00", "text": "ライブストリーミングカテゴリ"}, {"type": "subtitle", "time": 5164.79, "timestamp": "01:26:04", "text": "例えば、私がチェックすると"}, {"type": "subtitle", "time": 5167.35, "timestamp": "01:26:07", "text": "えっと、こちらはヴァレラントさんですよね？もし私が"}, {"type": "subtitle", "time": 5169.27, "timestamp": "01:26:09", "text": "バレラントをチェックしてください。"}, {"type": "subtitle", "time": 5171.27, "timestamp": "01:26:11", "text": "もし私が確認したら、ああ、それはページです。"}, {"type": "subtitle", "time": 5174.79, "timestamp": "01:26:14", "text": "おお。そうそう。うん。レベル50の場合"}, {"type": "subtitle", "time": 5177.03, "timestamp": "01:26:17", "text": "または、カスタム"}, {"type": "subtitle", "time": 5180.07, "timestamp": "01:26:20", "text": "このようなページ。ヴァレラントが"}, {"type": "subtitle", "time": 5181.83, "timestamp": "01:26:21", "text": "トーナメントでは、カスタム"}, {"type": "subtitle", "time": 5185.03, "timestamp": "01:26:25", "text": "ストリームルームみたいなやつ。あなたは"}, {"type": "subtitle", "time": 5187.11, "timestamp": "01:26:27", "text": "イベントページ付きのカスタムルーム"}, {"type": "subtitle", "time": 5190.709, "timestamp": "01:26:30", "text": "欲しいものと一緒にね？もし"}, {"type": "subtitle", "time": 5192.55, "timestamp": "01:26:32", "text": "あなたではない、"}, {"type": "subtitle", "time": 5196.47, "timestamp": "01:26:36", "text": "例えば、あ、待って。神経学。何？"}, {"type": "subtitle", "time": 5199.75, "timestamp": "01:26:39", "text": "Neuroが登場しました。"}, {"type": "subtitle", "time": 5202.629, "timestamp": "01:26:42", "text": "すみません。何？"}, {"type": "subtitle", "time": 5206.07, "timestamp": "01:26:46", "text": "そうそう。うん。多くのユーチューバーが"}, {"type": "subtitle", "time": 5210.07, "timestamp": "01:26:50", "text": "ちなみに、こちらです。たくさんの弓"}, {"type": "subtitle", "time": 5212.07, "timestamp": "01:26:52", "text": "メリーウェザー・ルーシャス・メリーウェザー。それで"}, {"type": "subtitle", "time": 5214.149, "timestamp": "01:26:54", "text": "たくさんの人がここにいます。"}, {"type": "subtitle", "time": 5217.43, "timestamp": "01:26:57", "text": "これは独占記事だと思う"}]
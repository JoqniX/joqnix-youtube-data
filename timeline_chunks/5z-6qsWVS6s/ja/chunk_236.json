[{"type": "subtitle", "time": 14160.229, "timestamp": "03:56:00", "text": "うん。うん。位置関係の問題ですよね？"}, {"type": "subtitle", "time": 14164.229, "timestamp": "03:56:04", "text": "私ができること（期間）。"}, {"type": "subtitle", "time": 14168.309, "timestamp": "03:56:08", "text": "範囲表示機能は要らない。"}, {"type": "subtitle", "time": 14178.95, "timestamp": "03:56:18", "text": "両方とも線形"}, {"type": "subtitle", "time": 14181.03, "timestamp": "03:56:21", "text": "キーフレーム。ああ、これが鍵のやり方だ"}, {"type": "subtitle", "time": 14183.429, "timestamp": "03:56:23", "text": "フレームですよね？キーフレームを追加し、"}, {"type": "subtitle", "time": 14197.03, "timestamp": "03:56:37", "text": "ああ、ブロック全体が動いてしまう。おお、"}, {"type": "subtitle", "time": 14199.83, "timestamp": "03:56:39", "text": "それからそれから待つ。いい考えがある。"}, {"type": "subtitle", "time": 14208.15, "timestamp": "03:56:48", "text": "色は必要ない。"}]
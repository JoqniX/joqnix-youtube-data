[{"type": "subtitle", "time": 8341.27, "timestamp": "02:19:01", "text": "ええ、朝で晴れていれば"}, {"type": "subtitle", "time": 8343.589, "timestamp": "02:19:03", "text": "こうなるだろう。"}, {"type": "subtitle", "time": 8345.83, "timestamp": "02:19:05", "text": "雨が降れば、雨が降るでしょう"}, {"type": "subtitle", "time": 8348.15, "timestamp": "02:19:08", "text": "あれ。つまり、条件付き"}, {"type": "subtitle", "time": 8350.309, "timestamp": "02:19:10", "text": "彼らの作品のレンダリング。それはある意味"}, {"type": "subtitle", "time": 8353.75, "timestamp": "02:19:13", "text": "いいね。今は雨が降っている。だから雨が降ると"}, {"type": "subtitle", "time": 8357.27, "timestamp": "02:19:17", "text": "まるで私たちにも見えるかのように。彼らは置かない"}, {"type": "subtitle", "time": 8359.75, "timestamp": "02:19:19", "text": "それ。"}, {"type": "subtitle", "time": 8362.15, "timestamp": "02:19:22", "text": "わかった。彼らはそれを置かない。デリーは"}, {"type": "subtitle", "time": 8369.75, "timestamp": "02:19:29", "text": "うん、夜の雨の部分ね。うん、そうなるよ"}, {"type": "subtitle", "time": 8372.309, "timestamp": "02:19:32", "text": "こうあるべきだ。いいえ。それで、私は"}, {"type": "subtitle", "time": 8374.95, "timestamp": "02:19:34", "text": "それを行うこと、それを行う方法を学ぶこと。それで、"}, {"type": "subtitle", "time": 8378.309, "timestamp": "02:19:38", "text": "今日はこれをやります。えっと、もし"}, {"type": "subtitle", "time": 8380.469, "timestamp": "02:19:40", "text": "見つけられますよ。ええと、今日は"}, {"type": "subtitle", "time": 8386.79, "timestamp": "02:19:46", "text": "メニューシステムはフルスクリーンメニューのような"}, {"type": "subtitle", "time": 8389.59, "timestamp": "02:19:49", "text": "全画面メニューのように"}, {"type": "subtitle", "time": 8392.55, "timestamp": "02:19:52", "text": "えーと、このロゴみたいなもの"}, {"type": "subtitle", "time": 8396.63, "timestamp": "02:19:56", "text": "ページに関するあらゆること。私たちは試みます"}]
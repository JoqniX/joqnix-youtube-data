[{"type": "subtitle", "time": 2102.95, "timestamp": "00:35:02", "text": "えっと、どこですか、いいえ、それは"}, {"type": "subtitle", "time": 2105.43, "timestamp": "00:35:05", "text": "ジョックのウェブサイトも雨天に切り替える"}, {"type": "subtitle", "time": 2108.39, "timestamp": "00:35:08", "text": "ウェブバン、雨が降っているなら、そうかもしれない"}, {"type": "subtitle", "time": 2111.67, "timestamp": "00:35:11", "text": "すごくクール！気に入った！"}, {"type": "subtitle", "time": 2116.23, "timestamp": "00:35:16", "text": "同じことだけど、私のインド人みたいな"}, {"type": "subtitle", "time": 2118.79, "timestamp": "00:35:18", "text": "タイムゾーンのことですね。"}, {"type": "subtitle", "time": 2120.87, "timestamp": "00:35:20", "text": "私の理解が正しければ、それは1つになるはずです"}, {"type": "subtitle", "time": 2123.75, "timestamp": "00:35:23", "text": "古いページの"}, {"type": "subtitle", "time": 2126.39, "timestamp": "00:35:26", "text": "uh jo ライブダイレクト。よし、これだ。わかった、"}, {"type": "subtitle", "time": 2130.31, "timestamp": "00:35:30", "text": "ここにあります。そこで私がここでやったことは"}, {"type": "subtitle", "time": 2135.27, "timestamp": "00:35:35", "text": "えっと、私は見ていました、私は見ていました"}, {"type": "subtitle", "time": 2140.47, "timestamp": "00:35:40", "text": "だからこれは、以前は"}, {"type": "subtitle", "time": 2142.63, "timestamp": "00:35:42", "text": "えーと、ライブリダイレクトページ、だって私は"}, {"type": "subtitle", "time": 2144.71, "timestamp": "00:35:44", "text": "マルチリーミングを開始しました。だから私は人々に"}, {"type": "subtitle", "time": 2147.19, "timestamp": "00:35:47", "text": "好きなプラットフォームに参加しよう。だから私が"}, {"type": "subtitle", "time": 2150.15, "timestamp": "00:35:50", "text": "した"}, {"type": "subtitle", "time": 2155.27, "timestamp": "00:35:55", "text": "えっと、それで、私がやったことは、えっと、それを置いたんです"}, {"type": "subtitle", "time": 2156.79, "timestamp": "00:35:56", "text": "えっと"}, {"type": "subtitle", "time": 2159.109, "timestamp": "00:35:59", "text": "ライブ配信のプレビューをすべて掲載してください。なぜ"}]
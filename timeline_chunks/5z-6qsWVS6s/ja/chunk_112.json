[{"type": "subtitle", "time": 6721.83, "timestamp": "01:52:01", "text": "それによって、次のような多くのことができるようになります。"}, {"type": "subtitle", "time": 6724.39, "timestamp": "01:52:04", "text": "よりプロフェッショナルな形式"}, {"type": "subtitle", "time": 6727.43, "timestamp": "01:52:07", "text": "設定を正しく行う。うん。だから"}, {"type": "subtitle", "time": 6730.229, "timestamp": "01:52:10", "text": "私はそれを完全に終わらせました、私は"}, {"type": "subtitle", "time": 6733.669, "timestamp": "01:52:13", "text": "文字通り、私は文字通り、私は"}, {"type": "subtitle", "time": 6736.07, "timestamp": "01:52:16", "text": "半分くらい終わったので、"}, {"type": "subtitle", "time": 6740.87, "timestamp": "01:52:20", "text": "GS GST番号。ええ、彼らは"}, {"type": "subtitle", "time": 6744.229, "timestamp": "01:52:24", "text": "書類を再度確認し、内容を明確にしてください。"}, {"type": "subtitle", "time": 6746.07, "timestamp": "01:52:26", "text": "まだ返答がない件です。"}, {"type": "subtitle", "time": 6747.83, "timestamp": "01:52:27", "text": "まだメールが届いていません。私はしません"}, {"type": "subtitle", "time": 6751.51, "timestamp": "01:52:31", "text": "理由を知りなさい。ログインして確認する必要があるかもしれません"}, {"type": "subtitle", "time": 6753.35, "timestamp": "01:52:33", "text": "また。"}, {"type": "subtitle", "time": 6756.55, "timestamp": "01:52:36", "text": "ええ、じゃあGST10ってやつを買います。"}, {"type": "subtitle", "time": 6760.95, "timestamp": "01:52:40", "text": "LLCみたいなものではないので、できます。"}, {"type": "subtitle", "time": 6765.189, "timestamp": "01:52:45", "text": "私はビジネス用の電話番号を持っていません。"}, {"type": "subtitle", "time": 6769.109, "timestamp": "01:52:49", "text": "しかし少なくとも少なくとも少なくともそれは"}, {"type": "subtitle", "time": 6771.91, "timestamp": "01:52:51", "text": "私の名前で登録してください。いや、ジョックニックのことだ"}, {"type": "subtitle", "time": 6775.03, "timestamp": "01:52:55", "text": "もしそれが普通預金口座なら、"}, {"type": "subtitle", "time": 6777.83, "timestamp": "01:52:57", "text": "少なくとも起こっている。"}, {"type": "subtitle", "time": 6779.83, "timestamp": "01:52:59", "text": "ソロレスを早期登録するのはどう思いますか？"}]
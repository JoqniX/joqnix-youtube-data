[{"type": "subtitle", "time": 8581.59, "timestamp": "02:23:01", "text": "約1,181,340までスクロールしました"}, {"type": "subtitle", "time": 8589.83, "timestamp": "02:23:09", "text": "ああ、神様。でも、トップアーティストはいつも"}, {"type": "subtitle", "time": 8599.11, "timestamp": "02:23:19", "text": "昔はよく聴いていた"}, {"type": "subtitle", "time": 8601.91, "timestamp": "02:23:21", "text": "ストリーム配信用のHarrisによるビートをストリーミング配信します。それ"}, {"type": "subtitle", "time": 8605.429, "timestamp": "02:23:25", "text": "こちらにも記録されます。"}, {"type": "subtitle", "time": 8609.429, "timestamp": "02:23:29", "text": "それは2020年から2021年頃のことだった。"}, {"type": "subtitle", "time": 8612.63, "timestamp": "02:23:32", "text": "うん。今はもうそれをやめた。ストリームル"}, {"type": "subtitle", "time": 8616.15, "timestamp": "02:23:36", "text": "素晴らしいです。はい、そうです。"}, {"type": "subtitle", "time": 8618.469, "timestamp": "02:23:38", "text": "それで"}, {"type": "subtitle", "time": 8620.389, "timestamp": "02:23:40", "text": "私は音楽を聴きます。私は聴くことができます"}, {"type": "subtitle", "time": 8622.87, "timestamp": "02:23:42", "text": "音楽。実は、ログインしないといけないんです。ああ"}, {"type": "subtitle", "time": 8625.51, "timestamp": "02:23:45", "text": "神。"}, {"type": "subtitle", "time": 8639.99, "timestamp": "02:23:59", "text": "ああ、なんてこった。ああ、神様。ええ、私は"}]
[{"type": "subtitle", "time": 6482.229, "timestamp": "01:48:02", "text": "JPTと良いものを構築"}, {"type": "subtitle", "time": 6485.43, "timestamp": "01:48:05", "text": "接続とか色々、だって今気づいたから"}, {"type": "subtitle", "time": 6489.03, "timestamp": "01:48:09", "text": "最高のユーチューバーAPのようなコミュニティ"}, {"type": "subtitle", "time": 6498.87, "timestamp": "01:48:18", "text": "あなたが知っていること、考えていること、そして"}, {"type": "subtitle", "time": 6500.629, "timestamp": "01:48:20", "text": "何かをするのは、"}, {"type": "subtitle", "time": 6502.95, "timestamp": "01:48:22", "text": "異なるコミュニティにやってくる"}, {"type": "subtitle", "time": 6505.35, "timestamp": "01:48:25", "text": "プレゼンテーションの方法、"}, {"type": "subtitle", "time": 6509.109, "timestamp": "01:48:29", "text": "昇進、すべて順調。どのように"}, {"type": "subtitle", "time": 6510.87, "timestamp": "01:48:30", "text": "準備すべきこと、フォーマットはどのようにすべきか"}, {"type": "subtitle", "time": 6514.709, "timestamp": "01:48:34", "text": "なれ。一部のコラボレーションは取引を伴うものとなるでしょう。"}, {"type": "subtitle", "time": 6518.229, "timestamp": "01:48:38", "text": "コラボレーションの中には、"}, {"type": "subtitle", "time": 6519.91, "timestamp": "01:48:39", "text": "取引的であるように、"}, {"type": "subtitle", "time": 6522.39, "timestamp": "01:48:42", "text": "より大きな組織と協力する"}, {"type": "subtitle", "time": 6524.709, "timestamp": "01:48:44", "text": "創造主は平等でなければならないし"}, {"type": "subtitle", "time": 6529.03, "timestamp": "01:48:49", "text": "取引とかそういう類のこと。一部の人々は"}, {"type": "subtitle", "time": 6532.229, "timestamp": "01:48:52", "text": "コラボレーションを真の"}, {"type": "subtitle", "time": 6534.39, "timestamp": "01:48:54", "text": "本物のつながりのようなもの"}, {"type": "subtitle", "time": 6536.709, "timestamp": "01:48:56", "text": "お互いを知り合う場所"}, {"type": "subtitle", "time": 6538.87, "timestamp": "01:48:58", "text": "クリエイターとあなたは一緒に過ごし、遊ぶ"}]
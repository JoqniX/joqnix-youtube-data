[{"type": "subtitle", "time": 541.59, "timestamp": "00:09:01", "text": "もしそれをaに置くなら、もしそれをaに置くなら"}, {"type": "subtitle", "time": 545.11, "timestamp": "00:09:05", "text": "Firefoxブラウザでは、ストリームを見ることができます"}, {"type": "subtitle", "time": 548.389, "timestamp": "00:09:08", "text": "何かが現れる。現在の流れ。"}, {"type": "subtitle", "time": 550.31, "timestamp": "00:09:10", "text": "はい、現在のストリームは次のように表示されます"}, {"type": "subtitle", "time": 552.55, "timestamp": "00:09:12", "text": "チャンネルのプレイリスト。すべてのストリーム"}, {"type": "subtitle", "time": 554.31, "timestamp": "00:09:14", "text": "プラネットチャンネルに登場します"}, {"type": "subtitle", "time": 556.87, "timestamp": "00:09:16", "text": "プレイリスト。ええ、なぜなのかはわかりませんが"}, {"type": "subtitle", "time": 558.71, "timestamp": "00:09:18", "text": "Chromium ビルドでは動作しませんが、"}, {"type": "chat", "time": 560.034, "timestamp": "00:09:20", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "👀"}, {"type": "subtitle", "time": 561.59, "timestamp": "00:09:21", "text": "うん、変な感じだよ、それから私はそこに"}, {"type": "subtitle", "time": 564.55, "timestamp": "00:09:24", "text": "これは古いタイプのウェブサイトで、今は"}, {"type": "subtitle", "time": 567.03, "timestamp": "00:09:27", "text": "何て言うんだっけ忘れちゃったんだけど。それで"}, {"type": "subtitle", "time": 569.67, "timestamp": "00:09:29", "text": "私はそこにインスピレーションを求めていたのです。"}, {"type": "subtitle", "time": 572.55, "timestamp": "00:09:32", "text": "それから、こちらを見てみました。えっと、それは"}, {"type": "subtitle", "time": 574.23, "timestamp": "00:09:34", "text": "ゲスト。ゲストワードのようなものがあった"}, {"type": "subtitle", "time": 577.269, "timestamp": "00:09:37", "text": "あれ。以前のウェブサイトのことですよね？の"}, {"type": "subtitle", "time": 580.63, "timestamp": "00:09:40", "text": "それは何という名前ですか？ネットユーザー。いいえ。えっと、忘れました。"}, {"type": "subtitle", "time": 584.15, "timestamp": "00:09:44", "text": "それは何と呼ばれていますか？ 90年代みたいに"}, {"type": "subtitle", "time": 588.79, "timestamp": "00:09:48", "text": "80年代風のスタイルで"}, {"type": "subtitle", "time": 591.269, "timestamp": "00:09:51", "text": "自分たちのものを作る人々のコミュニティ"}, {"type": "subtitle", "time": 593.269, "timestamp": "00:09:53", "text": "ウェブサイトとか、そういうやつですよね？まるで私が"}, {"type": "subtitle", "time": 595.67, "timestamp": "00:09:55", "text": "名前を忘れてしまった。それで私はいくつか見ました"}, {"type": "subtitle", "time": 597.59, "timestamp": "00:09:57", "text": "あちらのウェブサイトには、"}]
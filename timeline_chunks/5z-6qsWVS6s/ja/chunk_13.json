pe": "subtitle", "time": 825.269, "timestamp": "00:13:45", "text": "中国本土。だから私は「わかった、"}, {"type": "subtitle", "time": 828.23, "timestamp": "00:13:48", "text": "待って。これはうまくいきません。私は持っています"}, {"type": "subtitle", "time": 830.069, "timestamp": "00:13:50", "text": "「自分だけのカスタムアプリか何かを手に入れた。」"}, {"type": "chat", "time": 830.077, "timestamp": "00:13:50", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "dayumm"}, {"type": "subtitle", "time": 831.829, "timestamp": "00:13:51", "text": "ホロウ・ライブズ・アプリに触発され、"}, {"type": "subtitle", "time": 833.509, "timestamp": "00:13:53", "text": "すべて"}, {"type": "subtitle", "time": 836.31, "timestamp": "00:13:56", "text": "しかし、それには多くのコーディングと"}, {"type": "subtitle", "time": 838.389, "timestamp": "00:13:58", "text": "人を雇わなければならない"}]
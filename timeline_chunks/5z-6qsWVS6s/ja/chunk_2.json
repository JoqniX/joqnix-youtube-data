[{"type": "subtitle", "time": 120.789, "timestamp": "00:02:00", "text": "もう少ししたら現れます。少しアップデートしました"}, {"type": "subtitle", "time": 125.749, "timestamp": "00:02:05", "text": "それの。だから今はもっとダイナミックになっている、つまり"}, {"type": "subtitle", "time": 130.07, "timestamp": "00:02:10", "text": "それは何と呼ばれますか？ええと、ダイナミックな"}, {"type": "subtitle", "time": 133.83, "timestamp": "00:02:13", "text": "テキスト。テキストが多いほど、"}, {"type": "subtitle", "time": 137.35, "timestamp": "00:02:17", "text": "均等に間隔を空けて詰め込む。うん。一番上に"}, {"type": "subtitle", "time": 141.11, "timestamp": "00:02:21", "text": "私の画面の。それはすばらしい。"}, {"type": "subtitle", "time": 144.55, "timestamp": "00:02:24", "text": "だから今日今日"}, {"type": "subtitle", "time": 147.43, "timestamp": "00:02:27", "text": "夜だ。午後10時30分になります。"}, {"type": "subtitle", "time": 152.07, "timestamp": "00:02:32", "text": "それ。でも、今日はちょっとアイデアが浮かんだんです。それで、"}, {"type": "subtitle", "time": 154.55, "timestamp": "00:02:34", "text": "昨日、私たちはストリームを停止しました。"}, {"type": "subtitle", "time": 156.869, "timestamp": "00:02:36", "text": "午前5時ですよね？"}, {"type": "subtitle", "time": 162.63, "timestamp": "00:02:42", "text": "えっと、昨日私が探していたとき"}, {"type": "subtitle", "time": 165.19, "timestamp": "00:02:45", "text": "いくつかのウェブサイトでインスピレーションを受けたので"}, {"type": "subtitle", "time": 167.27, "timestamp": "00:02:47", "text": "そして全て。だから、私たちが"}, {"type": "subtitle", "time": 169.19, "timestamp": "00:02:49", "text": "昨日チェックしたところ、"}, {"type": "subtitle", "time": 172.47, "timestamp": "00:02:52", "text": "天気惑星、えーと天気惑星1"}, {"type": "subtitle", "time": 176.79, "timestamp": "00:02:56", "text": "それは2人用のユニットのようなものだと思います。"}, {"type": "subtitle", "time": 179.67000000000002, "timestamp": "00:02:59", "text": "ええ、ええ。だから私はほとんどの"}]
[{"type": "subtitle", "time": 10501.19, "timestamp": "02:55:01", "text": "皆さん、モデレーターに聞いてください。"}, {"type": "subtitle", "time": 10503.03, "timestamp": "02:55:03", "text": "そしてモデレーターは"}, {"type": "subtitle", "time": 10506.63, "timestamp": "02:55:06", "text": "招待リンクとかそういうもの。"}, {"type": "subtitle", "time": 10509.67, "timestamp": "02:55:09", "text": "だから、まるで技術モードのように、私はそれを実行できる。"}, {"type": "subtitle", "time": 10526.309, "timestamp": "02:55:26", "text": "私たちは文字通りさらに脇道に逸れました"}, {"type": "subtitle", "time": 10536.2, "timestamp": "02:55:36", "text": "色度シフト。"}, {"type": "subtitle", "time": 10547.91, "timestamp": "02:55:47", "text": "[音楽]"}]
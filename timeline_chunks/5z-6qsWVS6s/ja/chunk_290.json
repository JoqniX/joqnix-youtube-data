[{"type": "subtitle", "time": 17403.43, "timestamp": "04:50:03", "text": "ええ、ええ、私は何か持っていきます。では教えてください"}, {"type": "subtitle", "time": 17411.03, "timestamp": "04:50:11", "text": "えっと、マウスは口を閉ざしたままにしておきます。"}, {"type": "subtitle", "time": 17414.55, "timestamp": "04:50:14", "text": "これを見せてください。わかった。"}, {"type": "subtitle", "time": 17417.51, "timestamp": "04:50:17", "text": "どちらが良いか教えてください。これは"}, {"type": "subtitle", "time": 17421.99, "timestamp": "04:50:21", "text": "もっと大きく？これは良いですか？"}, {"type": "subtitle", "time": 17427.27, "timestamp": "04:50:27", "text": "これは私のものです。これは良いですか、それとも"}, {"type": "subtitle", "time": 17429.43, "timestamp": "04:50:29", "text": "これは良い？"}, {"type": "subtitle", "time": 17438.948, "timestamp": "04:50:38", "text": "両方を組み合わせると、"}]
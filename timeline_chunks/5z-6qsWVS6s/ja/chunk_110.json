[{"type": "subtitle", "time": 6601.75, "timestamp": "01:50:01", "text": "だから、使える唯一の方法は"}, {"type": "subtitle", "time": 6606.07, "timestamp": "01:50:06", "text": "UPIですが、UPIを使用すると表示されます"}, {"type": "subtitle", "time": 6607.669, "timestamp": "01:50:07", "text": "実際に名前を書いて"}, {"type": "subtitle", "time": 6611.43, "timestamp": "01:50:11", "text": "取引権 銀行名"}, {"type": "subtitle", "time": 6612.95, "timestamp": "01:50:12", "text": "うん"}, {"type": "subtitle", "time": 6617.109, "timestamp": "01:50:17", "text": "それで、それで、私は、えっと、私は、"}, {"type": "subtitle", "time": 6619.43, "timestamp": "01:50:19", "text": "私は現在を作りたかった"}, {"type": "subtitle", "time": 6622.79, "timestamp": "01:50:22", "text": "アカウントは、ジョックニックスの下のものです。"}, {"type": "subtitle", "time": 6625.109, "timestamp": "01:50:25", "text": "それは私がジョアソンをすべて配置するのに役立ちます"}, {"type": "subtitle", "time": 6628.709, "timestamp": "01:50:28", "text": "ジョックニックス自身の銀行口座にお金が振り込まれる"}, {"type": "subtitle", "time": 6632.709, "timestamp": "01:50:32", "text": "また、私は、ええと、私はまた"}, {"type": "subtitle", "time": 6635.43, "timestamp": "01:50:35", "text": "これを使うということは、ソールをやらなければならないということです"}, {"type": "subtitle", "time": 6637.43, "timestamp": "01:50:37", "text": "所有者の権利、つまり私も"}, {"type": "subtitle", "time": 6640.07, "timestamp": "01:50:40", "text": "商品やその他多くのものを販売しています"}, {"type": "subtitle", "time": 6645.35, "timestamp": "01:50:45", "text": "物事はちょうど、うーんのように正しい"}, {"type": "subtitle", "time": 6647.75, "timestamp": "01:50:47", "text": "まるでプロダクトプロジェクトスタースケープのように"}, {"type": "subtitle", "time": 6651.35, "timestamp": "01:50:51", "text": "彼らのショップのウェブサイトはありません。星空はありません。"}, {"type": "subtitle", "time": 6653.03, "timestamp": "01:50:53", "text": "Tシャツも全部揃っている"}, {"type": "subtitle", "time": 6655.43, "timestamp": "01:50:55", "text": "私は、次のようにしなければならないことを学びました"}, {"type": "subtitle", "time": 6657.27, "timestamp": "01:50:57", "text": "商用ライセンス、その他諸々"}, {"type": "subtitle", "time": 6659.03, "timestamp": "01:50:59", "text": "右"}]
[{"type": "subtitle", "time": 5283.91, "timestamp": "01:28:03", "text": "Twitterを見せて、そう、だって私は"}, {"type": "subtitle", "time": 5286.07, "timestamp": "01:28:06", "text": "TwitterにXマークを見せた。彼らは"}, {"type": "subtitle", "time": 5288.31, "timestamp": "01:28:08", "text": "自分が外国のウェブサイトにアクセスしていることに気づいた。"}, {"type": "subtitle", "time": 5291.27, "timestamp": "01:28:11", "text": "彼らは文字通り私にストライクを与えた。それで"}, {"type": "subtitle", "time": 5297.43, "timestamp": "01:28:17", "text": "そう、本当にたくさんのことがありました。うん。えっと、"}, {"type": "subtitle", "time": 5300.149, "timestamp": "01:28:20", "text": "私の作品に基づいて、彼らは私にこうするように言いました"}, {"type": "subtitle", "time": 5302.79, "timestamp": "01:28:22", "text": "限定配信。私は彼らに懇願した"}, {"type": "subtitle", "time": 5305.51, "timestamp": "01:28:25", "text": "マルチストリーム関連のことをやっていたから"}, {"type": "subtitle", "time": 5307.91, "timestamp": "01:28:27", "text": "ジョアソンとか、そういうやつ。えっと、ジョアソンの前に、私は"}, {"type": "subtitle", "time": 5310.229, "timestamp": "01:28:30", "text": "マルチリーミングみたいなことをしてたんだよね？これまで"}, {"type": "subtitle", "time": 5312.87, "timestamp": "01:28:32", "text": "Twitchはマルチストリーミングを許可しているので、"}, {"type": "subtitle", "time": 5315.91, "timestamp": "01:28:35", "text": "マルチストリーミングをしたかったのは、"}, {"type": "subtitle", "time": 5319.11, "timestamp": "01:28:39", "text": "独占配信、彼らの要件は1でした"}, {"type": "subtitle", "time": 5327.83, "timestamp": "01:28:47", "text": "私も以前はそうしていました。それはかつて私の"}, {"type": "subtitle", "time": 5331.669, "timestamp": "01:28:51", "text": "以前は、私は1時間"}, {"type": "subtitle", "time": 5334.149, "timestamp": "01:28:54", "text": "ApexとかValerantとかそういうやつ。おお"}, {"type": "subtitle", "time": 5336.709, "timestamp": "01:28:56", "text": "うん、まともにストリーミングもできないよ"}, {"type": "subtitle", "time": 5339.43, "timestamp": "01:28:59", "text": "エイペックスとヴァレラント。隠さなければならない"}]
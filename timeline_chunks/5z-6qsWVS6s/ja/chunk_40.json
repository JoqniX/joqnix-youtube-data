[{"type": "subtitle", "time": 2403.03, "timestamp": "00:40:03", "text": "何かを追加して、えっと、私が"}, {"type": "subtitle", "time": 2405.589, "timestamp": "00:40:05", "text": "すべてのトークンを管理し、トークンを設計します"}, {"type": "subtitle", "time": 2407.349, "timestamp": "00:40:07", "text": "あれ。"}, {"type": "subtitle", "time": 2410.15, "timestamp": "00:40:10", "text": "例えば"}, {"type": "subtitle", "time": 2413.109, "timestamp": "00:40:13", "text": "ここがそのセクションですね。だから"}, {"type": "subtitle", "time": 2415.589, "timestamp": "00:40:15", "text": "問題は、私がセクションと入力すると、"}, {"type": "subtitle", "time": 2417.829, "timestamp": "00:40:17", "text": "ここにはたくさんのものがある。どちらが"}, {"type": "subtitle", "time": 2420.31, "timestamp": "00:40:20", "text": "どれの。だから私は、したくないようにしたい"}, {"type": "subtitle", "time": 2423.91, "timestamp": "00:40:23", "text": "管理とかそういうことですね。まだ"}, {"type": "subtitle", "time": 2427.109, "timestamp": "00:40:27", "text": "彼らはまだ取り組んでいると思います"}, {"type": "subtitle", "time": 2430.55, "timestamp": "00:40:30", "text": "話すように、えっと"}, {"type": "subtitle", "time": 2433.51, "timestamp": "00:40:33", "text": "uh tok uh sty デザイン トークン マネージャーまたは"}, {"type": "subtitle", "time": 2436.63, "timestamp": "00:40:36", "text": "何か。それは何かだけど、"}, {"type": "subtitle", "time": 2438.95, "timestamp": "00:40:38", "text": "天気予報機能の私のユースケース"}, {"type": "subtitle", "time": 2441.91, "timestamp": "00:40:41", "text": "彼らにはグローバルなルートのようなものがある。だからもし私が"}, {"type": "subtitle", "time": 2444.79, "timestamp": "00:40:44", "text": "下へ降りて、私が"}, {"type": "subtitle", "time": 2447.67, "timestamp": "00:40:47", "text": "背景のアクセントやアクセントが欲しい"}, {"type": "subtitle", "time": 2450.39, "timestamp": "00:40:50", "text": "そして、いろいろなものを記録します。私はそれを入れることができます"}, {"type": "subtitle", "time": 2452.23, "timestamp": "00:40:52", "text": "変数内。もう一つ追加できます"}, {"type": "subtitle", "time": 2454.87, "timestamp": "00:40:54", "text": "変数。これは役に立つでしょう。私ができること"}, {"type": "subtitle", "time": 2457.75, "timestamp": "00:40:57", "text": "今日やることは、変数を作ることです"}]
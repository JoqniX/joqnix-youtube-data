[{"type": "subtitle", "time": 14777.91, "timestamp": "04:06:17", "text": "どうすればいいのですか？"}, {"type": "subtitle", "time": 14787.269, "timestamp": "04:06:27", "text": "おお、いいね。私はこれ、結構好きです。実は"}, {"type": "subtitle", "time": 14789.51, "timestamp": "04:06:29", "text": "でも、私はこれが好き"}, {"type": "subtitle", "time": 14794.55, "timestamp": "04:06:34", "text": "青みがかったピンク色で、ああ、これ好き。"}, {"type": "subtitle", "time": 14805.429, "timestamp": "04:06:45", "text": "ええ、そういうものなんです。しかし"}, {"type": "subtitle", "time": 14809.269, "timestamp": "04:06:49", "text": "オーバーレイを配置できるようなものを配置しています"}, {"type": "subtitle", "time": 14811.429, "timestamp": "04:06:51", "text": "もしくは、カラーのものもいいですね。まるで私は"}, {"type": "subtitle", "time": 14815.83, "timestamp": "04:06:55", "text": "太陽か何かを見つめている。"}]
[{"type": "subtitle", "time": 17702.39, "timestamp": "04:55:02", "text": "日本で。待って、つまり彼らは"}, {"type": "subtitle", "time": 17705.02, "timestamp": "04:55:05", "text": "物"}, {"type": "subtitle", "time": 17706.23, "timestamp": "04:55:06", "text": "[音楽]"}, {"type": "subtitle", "time": 17710.31, "timestamp": "04:55:10", "text": "ああ、彼らは変えた、彼らは変えた"}, {"type": "subtitle", "time": 17712.55, "timestamp": "04:55:12", "text": "それも。"}, {"type": "subtitle", "time": 17730.55, "timestamp": "04:55:30", "text": "これは本当に良い背景ですね。のように"}, {"type": "subtitle", "time": 17738.23, "timestamp": "04:55:38", "text": "[音楽]"}, {"type": "subtitle", "time": 17742.31, "timestamp": "04:55:42", "text": "そうみたいですね。だから、"}, {"type": "subtitle", "time": 17744.23, "timestamp": "04:55:44", "text": "条件。うん。うん。うん。 1つ挙げましょう"}, {"type": "subtitle", "time": 17747.11, "timestamp": "04:55:47", "text": "1つのバージョンを作成する。うん。さあ、そうしよう"}, {"type": "subtitle", "time": 17751.03, "timestamp": "04:55:51", "text": "これは夜間バージョンにしましょう。私は推測する"}, {"type": "subtitle", "time": 17755.51, "timestamp": "04:55:55", "text": "たぶん、変更すると思います。うん。"}]
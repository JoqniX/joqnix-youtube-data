[{"type": "subtitle", "time": 5701.35, "timestamp": "01:35:01", "text": "すべてを翻訳する。たくさんのこと、"}, {"type": "subtitle", "time": 5704.149, "timestamp": "01:35:04", "text": "右？だから私はこう思うんです"}, {"type": "subtitle", "time": 5706.55, "timestamp": "01:35:06", "text": "当初私がいるはずだった時間"}, {"type": "subtitle", "time": 5709.51, "timestamp": "01:35:09", "text": "戦争のため、今月までに日本は"}, {"type": "subtitle", "time": 5711.75, "timestamp": "01:35:11", "text": "インドとパキスタンの件について"}, {"type": "subtitle", "time": 5714.79, "timestamp": "01:35:14", "text": "そのため、私の入学はキャンセルされました"}, {"type": "subtitle", "time": 5717.83, "timestamp": "01:35:17", "text": "彼らはこれをすべてキャンセルした"}, {"type": "subtitle", "time": 5722.07, "timestamp": "01:35:22", "text": "年間の入学はすべてインドからで、"}, {"type": "subtitle", "time": 5724.55, "timestamp": "01:35:24", "text": "7月入学の人たちは"}, {"type": "subtitle", "time": 5728.55, "timestamp": "01:35:28", "text": "僕が7月に日本に行くみたいに"}, {"type": "subtitle", "time": 5730.709, "timestamp": "01:35:30", "text": "キャンセルされました"}, {"type": "subtitle", "time": 5732.709, "timestamp": "01:35:32", "text": "10月入学は中止になりました。 12月"}, {"type": "subtitle", "time": 5736.629, "timestamp": "01:35:36", "text": "入学手続きが中止になりました。だからそれらはただ"}, {"type": "subtitle", "time": 5740.07, "timestamp": "01:35:40", "text": "私が通う語学学校はGMAです。それで"}, {"type": "subtitle", "time": 5741.91, "timestamp": "01:35:41", "text": "えっと、私の語学学校では、"}, {"type": "subtitle", "time": 5743.99, "timestamp": "01:35:43", "text": "来年以降のみ"}, {"type": "subtitle", "time": 5747.43, "timestamp": "01:35:47", "text": "まるで出来立てのようだ。だから"}, {"type": "subtitle", "time": 5751.11, "timestamp": "01:35:51", "text": "私の入学時期は2026年4月頃です。"}, {"type": "subtitle", "time": 5753.35, "timestamp": "01:35:53", "text": "そして今、私には時間があるから、だから私は"}, {"type": "subtitle", "time": 5756.31, "timestamp": "01:35:56", "text": "ジョアソンイベントの期間を延長しました。最初は、私は"}, {"type": "subtitle", "time": 5758.39, "timestamp": "01:35:58", "text": "私のイベントを終わらせるはずだった、ジョアソン"}]
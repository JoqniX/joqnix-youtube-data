[{"type": "subtitle", "time": 12673.349, "timestamp": "03:31:13", "text": "グラデーションのものはどこにありますか？コンテンツ"}, {"type": "subtitle", "time": 12675.91, "timestamp": "03:31:15", "text": "モデレーター関連のこと。"}, {"type": "subtitle", "time": 12678.469, "timestamp": "03:31:18", "text": "スタイルセクションのアップデートを先行公開します。何が"}, {"type": "subtitle", "time": 12680.15, "timestamp": "03:31:20", "text": "これ？"}, {"type": "subtitle", "time": 12681.99, "timestamp": "03:31:21", "text": "ああ、そうじゃないよ。待って、彼らは連れてきたの？"}, {"type": "subtitle", "time": 12685.19, "timestamp": "03:31:25", "text": "そのアップデート？ちょっと待って、見せて。スタイル。"}, {"type": "subtitle", "time": 12687.269, "timestamp": "03:31:27", "text": "ああ、フォーカスモードですね。詳細モード。そうそう。"}, {"type": "subtitle", "time": 12689.91, "timestamp": "03:31:29", "text": "ええ、ええ。"}, {"type": "subtitle", "time": 12693.19, "timestamp": "03:31:33", "text": "フォーカスモードのデフォルト設定。はい、はい、はい。"}, {"type": "subtitle", "time": 12698.229, "timestamp": "03:31:38", "text": "彼らはそのアップデートを地域にもたらした。"}, {"type": "subtitle", "time": 12701.99, "timestamp": "03:31:41", "text": "えっと、カラーピッカーにもっと色を追加してください。"}, {"type": "subtitle", "time": 12703.51, "timestamp": "03:31:43", "text": "H、"}, {"type": "subtitle", "time": 12705.91, "timestamp": "03:31:45", "text": "小規模なレイヤー名の変更。"}, {"type": "subtitle", "time": 12708.309, "timestamp": "03:31:48", "text": "H."}, {"type": "subtitle", "time": 12710.469, "timestamp": "03:31:50", "text": "そうそう。 Viveのコードモードが追加されるそうです。"}, {"type": "subtitle", "time": 12713.83, "timestamp": "03:31:53", "text": "ウェブスタジオのViveコーディングモード。"}, {"type": "subtitle", "time": 12717.99, "timestamp": "03:31:57", "text": "彼らは実際にこれを持ち込んでいる。"}]
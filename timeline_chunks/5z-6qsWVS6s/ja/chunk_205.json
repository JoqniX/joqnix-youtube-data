[{"type": "subtitle", "time": 12306.55, "timestamp": "03:25:06", "text": "お元気ですか？ホスティングの状況はいかがですか？私"}, {"type": "subtitle", "time": 12308.63, "timestamp": "03:25:08", "text": "全く知らない。これは"}, {"type": "subtitle", "time": 12311.91, "timestamp": "03:25:11", "text": "ホストされている曲はなぜVisなのか"}, {"type": "subtitle", "time": 12315.349, "timestamp": "03:25:15", "text": "カリファ？また会おうね、がここにあります。"}, {"type": "subtitle", "time": 12319.91, "timestamp": "03:25:19", "text": "これは彼女によるカバーだと思う。わかった、"}, {"type": "subtitle", "time": 12321.429, "timestamp": "03:25:21", "text": "これらは高級部品です。それは"}, {"type": "subtitle", "time": 12329.67, "timestamp": "03:25:29", "text": "彼らの分析ツールはあなたの彼女を示しています"}, {"type": "subtitle", "time": 12332.79, "timestamp": "03:25:32", "text": "ストリーム分析。どちらかわからない"}, {"type": "subtitle", "time": 12335.67, "timestamp": "03:25:35", "text": "彼女が直接Iを取得するために使用するウェブサイト"}, {"type": "subtitle", "time": 12339.11, "timestamp": "03:25:39", "text": "うん、膝の上に人が何人もいるような感じ"}, {"type": "subtitle", "time": 12341.349, "timestamp": "03:25:41", "text": "直接"}, {"type": "subtitle", "time": 12345.269, "timestamp": "03:25:45", "text": "えっと、ビリービリーのための開発者向けツール。いいえ、だって"}, {"type": "subtitle", "time": 12347.83, "timestamp": "03:25:47", "text": "彼らは中国人です。するために"}, {"type": "subtitle", "time": 12351.11, "timestamp": "03:25:51", "text": "開発者へのアクセス権を取得する"}, {"type": "subtitle", "time": 12354.71, "timestamp": "03:25:54", "text": "そういうことですよね？開発者が何かを作る"}, {"type": "subtitle", "time": 12358.309, "timestamp": "03:25:58", "text": "アプリを作ったり、ゲームを作ったり、何か別のことをする。"}]
[{"type": "subtitle", "time": 5941.91, "timestamp": "01:39:01", "text": "如果我没记错的话，应该是班加罗尔。"}, {"type": "subtitle", "time": 5944.07, "timestamp": "01:39:04", "text": "我认为像德里这样的地方还有更多。"}, {"type": "subtitle", "time": 5946.47, "timestamp": "01:39:06", "text": "所有的一切。还有更多内容"}, {"type": "subtitle", "time": 5949.75, "timestamp": "01:39:09", "text": "北侧也是如此。是的，所以"}, {"type": "subtitle", "time": 5952.87, "timestamp": "01:39:12", "text": "我得去钦奈什么的，然后我就"}, {"type": "subtitle", "time": 5955.51, "timestamp": "01:39:15", "text": "我参加了考试，并且通过了。就像"}, {"type": "subtitle", "time": 5958.39, "timestamp": "01:39:18", "text": "呃，即将前往日本的学生们"}, {"type": "subtitle", "time": 5961.35, "timestamp": "01:39:21", "text": "四月份入学。呃，他们也是。"}, {"type": "subtitle", "time": 5964.87, "timestamp": "01:39:24", "text": "那里。所以，我，就像两个人一样。"}, {"type": "subtitle", "time": 5968.39, "timestamp": "01:39:28", "text": "从七月份的入学人数开始，其余的也都是如此。"}, {"type": "subtitle", "time": 5971.43, "timestamp": "01:39:31", "text": "剩下的六个人就像四月一样。"}, {"type": "subtitle", "time": 5975.83, "timestamp": "01:39:35", "text": "招生人员我们俩都只参加考试我"}, {"type": "subtitle", "time": 5979.99, "timestamp": "01:39:39", "text": "兄弟，我考过了，大家都没过。"}, {"type": "subtitle", "time": 5984.629, "timestamp": "01:39:44", "text": "我不知道怎么做到的，但是，是的，所以大部分"}, {"type": "subtitle", "time": 5988.07, "timestamp": "01:39:48", "text": "人们去了四月份的招生，嗯……"}, {"type": "subtitle", "time": 5990.629, "timestamp": "01:39:50", "text": "学院的人告诉我，就像"}, {"type": "subtitle", "time": 5992.629, "timestamp": "01:39:52", "text": "是的，他们中的大多数人都在受苦，因为"}, {"type": "subtitle", "time": 5995.99, "timestamp": "01:39:55", "text": "他们的语言很弱，而且一切"}, {"type": "subtitle", "time": 5999.91, "timestamp": "01:39:59", "text": "他们会给你提供兼职工作之类的机会。"}]
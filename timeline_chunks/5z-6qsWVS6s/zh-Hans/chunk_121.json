[{"type": "subtitle", "time": 7263.03, "timestamp": "02:01:03", "text": "嗯，是的，这张图是粉丝创作的。"}, {"type": "subtitle", "time": 7265.99, "timestamp": "02:01:05", "text": "这是一张剧组人员拍摄的照片。这是一张照片"}, {"type": "subtitle", "time": 7270.31, "timestamp": "02:01:10", "text": "全体人员。这是一幅同人作品。"}, {"type": "subtitle", "time": 7273.189, "timestamp": "02:01:13", "text": "还有另一个，这也是这个。"}, {"type": "subtitle", "time": 7275.83, "timestamp": "02:01:15", "text": "还有一张同人图。"}, {"type": "subtitle", "time": 7278.47, "timestamp": "02:01:18", "text": "它上面有我的那玩意儿，对吧？这"}, {"type": "subtitle", "time": 7280.149, "timestamp": "02:01:20", "text": "星座"}, {"type": "subtitle", "time": 7282.87, "timestamp": "02:01:22", "text": "对我来说，我是八月出生的。"}, {"type": "subtitle", "time": 7286.39, "timestamp": "02:01:26", "text": "她属于狮子座。我认为这一点"}, {"type": "subtitle", "time": 7288.95, "timestamp": "02:01:28", "text": "是癌症。"}, {"type": "subtitle", "time": 7291.189, "timestamp": "02:01:31", "text": "我忘了是哪个星座了，但是"}, {"type": "subtitle", "time": 7293.99, "timestamp": "02:01:33", "text": "对，就在头上，就像起源一样。"}, {"type": "subtitle", "time": 7297.669, "timestamp": "02:01:37", "text": "标记。这在我的新模型中有所改变。"}, {"type": "subtitle", "time": 7301.91, "timestamp": "02:01:41", "text": "我。呃，我更改了我的原籍标记"}, {"type": "subtitle", "time": 7305.99, "timestamp": "02:01:45", "text": "嗯，我新模型上的原点标记。"}, {"type": "subtitle", "time": 7308.95, "timestamp": "02:01:48", "text": "我改变了我的新模型，它更"}, {"type": "subtitle", "time": 7311.669, "timestamp": "02:01:51", "text": "天体主题或类似星座"}, {"type": "subtitle", "time": 7316.229, "timestamp": "02:01:56", "text": "因为我怀孕了，所以需要这个东西"}, {"type": "subtitle", "time": 7319.75, "timestamp": "02:01:59", "text": "星座。所以这个问题解决了。"}]
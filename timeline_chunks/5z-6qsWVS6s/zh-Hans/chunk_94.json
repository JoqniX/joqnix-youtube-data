[{"type": "subtitle", "time": 5643.51, "timestamp": "01:34:03", "text": "如果你来这里"}, {"type": "subtitle", "time": 5647.43, "timestamp": "01:34:07", "text": "嗯，它会显示“是的，直播”之类的字样。"}, {"type": "subtitle", "time": 5649.99, "timestamp": "01:34:09", "text": "呃，现场直播最强舰队奖"}, {"type": "subtitle", "time": 5653.83, "timestamp": "01:34:13", "text": "维护荣誉。你获得的所有奖项"}, {"type": "subtitle", "time": 5657.35, "timestamp": "01:34:17", "text": "比利·比利将在这里亮相。和"}, {"type": "subtitle", "time": 5660.31, "timestamp": "01:34:20", "text": "是的，如果你像……那样击球，所有这些东西都会发生。"}, {"type": "subtitle", "time": 5662.31, "timestamp": "01:34:22", "text": "大奖，比如一百万美元之类的，"}, {"type": "subtitle", "time": 5664.31, "timestamp": "01:34:24", "text": "正确的？所有奖项都将在这里颁发。"}, {"type": "subtitle", "time": 5666.47, "timestamp": "01:34:26", "text": "一切。"}, {"type": "subtitle", "time": 5669.669, "timestamp": "01:34:29", "text": "太多了。 Mr. Beast，让我看看。我认为"}, {"type": "subtitle", "time": 5673.11, "timestamp": "01:34:33", "text": "Mr. Beast也参演了。比利。是的，他是"}, {"type": "subtitle", "time": 5678.39, "timestamp": "01:34:38", "text": "这里。是的，我觉得这会像这样"}, {"type": "subtitle", "time": 5685.11, "timestamp": "01:34:45", "text": "Be先生的官方账号。好的。是的。"}, {"type": "subtitle", "time": 5688.79, "timestamp": "01:34:48", "text": "验证功能就是这么好用。就像现在这样"}, {"type": "subtitle", "time": 5691.11, "timestamp": "01:34:51", "text": "最重要的是你要写上标题。"}, {"type": "subtitle", "time": 5694.149, "timestamp": "01:34:54", "text": "以及所有的一切"}, {"type": "subtitle", "time": 5695.99, "timestamp": "01:34:55", "text": "就像中国的内容一样，对吧？我不能"}, {"type": "subtitle", "time": 5698.39, "timestamp": "01:34:58", "text": "用英语那种方式表达。我有"}]
[{"type": "subtitle", "time": 6240.55, "timestamp": "01:44:00", "text": "来自经验和见解"}, {"type": "subtitle", "time": 6242.47, "timestamp": "01:44:02", "text": "YouTube的商业运作以及所有这些"}, {"type": "subtitle", "time": 6244.709, "timestamp": "01:44:04", "text": "帮助其他 YouTuber 或机构"}, {"type": "subtitle", "time": 6247.99, "timestamp": "01:44:07", "text": "改变或者其他什么一定很好，或者如果"}, {"type": "subtitle", "time": 6249.75, "timestamp": "01:44:09", "text": "如果那样行不通，我会继续从事音乐。"}, {"type": "subtitle", "time": 6251.35, "timestamp": "01:44:11", "text": "那里。"}, {"type": "subtitle", "time": 6254.07, "timestamp": "01:44:14", "text": "这是最重要的事。我真的很想"}, {"type": "subtitle", "time": 6256.39, "timestamp": "01:44:16", "text": "为音乐相关事宜建立联系"}, {"type": "subtitle", "time": 6259.51, "timestamp": "01:44:19", "text": "在那里，与音乐艺术家合作"}, {"type": "subtitle", "time": 6261.35, "timestamp": "01:44:21", "text": "还有一些其他的东西。"}, {"type": "subtitle", "time": 6264.79, "timestamp": "01:44:24", "text": "我小时候的第一个梦想"}, {"type": "subtitle", "time": 6268.47, "timestamp": "01:44:28", "text": "就像做音乐和DJ一样"}, {"type": "subtitle", "time": 6271.109, "timestamp": "01:44:31", "text": "一切。我认为有"}, {"type": "subtitle", "time": 6274.149, "timestamp": "01:44:34", "text": "像地下DJ这样的机会"}, {"type": "subtitle", "time": 6276.39, "timestamp": "01:44:36", "text": "还有一些其他的东西。所以，我可以玩我的"}, {"type": "subtitle", "time": 6278.95, "timestamp": "01:44:38", "text": "那里也会有音乐演出或其他表演活动。"}, {"type": "subtitle", "time": 6282.229, "timestamp": "01:44:42", "text": "那里应该很不错吧。如果那样的话"}, {"type": "subtitle", "time": 6285.59, "timestamp": "01:44:45", "text": "行不通，那我就按时尚的方式来吧。"}, {"type": "subtitle", "time": 6287.51, "timestamp": "01:44:47", "text": "设计之类的，因为我最初"}, {"type": "subtitle", "time": 6289.83, "timestamp": "01:44:49", "text": "当我想要制作我的周边产品之类的东西时"}, {"type": "subtitle", "time": 6295.27, "timestamp": "01:44:55", "text": "现在，自从我陷入那个循环以来，呃……"}, {"type": "subtitle", "time": 6298.31, "timestamp": "01:44:58", "text": "放弃了音乐，因为我陷入了困境。我"}]
[{"type": "subtitle", "time": 6660.95, "timestamp": "01:51:00", "text": "用于支付网关和您所需的一切"}, {"type": "subtitle", "time": 6662.95, "timestamp": "01:51:02", "text": "必须拥有所有东西，为什么？"}, {"type": "subtitle", "time": 6665.75, "timestamp": "01:51:05", "text": "它卡顿了，你好"}, {"type": "subtitle", "time": 6668.229, "timestamp": "01:51:08", "text": "是啊，所以……为什么会卡顿？你好"}, {"type": "subtitle", "time": 6670.55, "timestamp": "01:51:10", "text": "我关掉这个"}, {"type": "subtitle", "time": 6673.27, "timestamp": "01:51:13", "text": "哦，我得在这里关门了，你就是这样。"}, {"type": "subtitle", "time": 6676.629, "timestamp": "01:51:16", "text": "你很幸运"}, {"type": "subtitle", "time": 6679.75, "timestamp": "01:51:19", "text": "关闭这个，是的，就像站在这里一样。"}, {"type": "subtitle", "time": 6681.91, "timestamp": "01:51:21", "text": "鸭子枕头，他们有的所有这些东西"}, {"type": "subtitle", "time": 6683.669, "timestamp": "01:51:23", "text": "现在"}, {"type": "subtitle", "time": 6686.07, "timestamp": "01:51:26", "text": "你可以这样做，比如一旦你有了睡眠"}, {"type": "subtitle", "time": 6688.229, "timestamp": "01:51:28", "text": "老板和你必须做的所有事情"}, {"type": "subtitle", "time": 6689.75, "timestamp": "01:51:29", "text": "你已经把消费税（GST）之类的东西都算进去了，对吧？"}, {"type": "subtitle", "time": 6692.07, "timestamp": "01:51:32", "text": "您可以使用以下付款方式"}, {"type": "subtitle", "time": 6695.189, "timestamp": "01:51:35", "text": "我想要的是手机支付和谷歌支付。"}, {"type": "subtitle", "time": 6698.229, "timestamp": "01:51:38", "text": "为了我的网站"}, {"type": "subtitle", "time": 6702.149, "timestamp": "01:51:42", "text": "我这边有延迟 2 a"}, {"type": "subtitle", "time": 6705.109, "timestamp": "01:51:45", "text": "我注意到我的“哦，是的，我”有点延迟"}, {"type": "subtitle", "time": 6708.79, "timestamp": "01:51:48", "text": "我觉得是我的电脑快要坏掉了。"}, {"type": "subtitle", "time": 6711.91, "timestamp": "01:51:51", "text": "好吧，现在是82。我不知道为什么，但是……"}, {"type": "subtitle", "time": 6716.31, "timestamp": "01:51:56", "text": "是的。嗯，是的。嗯"}, {"type": "subtitle", "time": 6719.03, "timestamp": "01:51:59", "text": "所以，就像很多事情一样，并非如此。"}]
[{"type": "subtitle", "time": 5520.07, "timestamp": "01:32:00", "text": "我相信你知道，嗯，他们"}, {"type": "subtitle", "time": 5522.87, "timestamp": "01:32:02", "text": "就像医生说的，你不应该这样做。"}, {"type": "subtitle", "time": 5525.91, "timestamp": "01:32:05", "text": "别这么做。每个人都持怀疑态度，就像……"}, {"type": "subtitle", "time": 5529.59, "timestamp": "01:32:09", "text": "不，别这样，因为现在做这件事是我的梦想。"}, {"type": "subtitle", "time": 5532.47, "timestamp": "01:32:12", "text": "比利比利，因为有那么一次"}, {"type": "subtitle", "time": 5534.55, "timestamp": "01:32:14", "text": "当我在 YouTube 和 Twitch 上直播时"}, {"type": "subtitle", "time": 5537.11, "timestamp": "01:32:17", "text": "一些观众评论说……"}, {"type": "subtitle", "time": 5540.95, "timestamp": "01:32:20", "text": "他们来自中国之类的，他们"}, {"type": "subtitle", "time": 5543.669, "timestamp": "01:32:23", "text": "他们告诉我他们必须使用 VPN 才能监视我。"}, {"type": "subtitle", "time": 5546.95, "timestamp": "01:32:26", "text": "我不知道为什么，但我调查了一下。"}, {"type": "subtitle", "time": 5549.91, "timestamp": "01:32:29", "text": "我意识到，是的，中国是"}, {"type": "subtitle", "time": 5552.149, "timestamp": "01:32:32", "text": "由于防火墙的原因被阻止了"}, {"type": "subtitle", "time": 5553.99, "timestamp": "01:32:33", "text": "因为他们的东西，所以才这样，对吧？"}, {"type": "subtitle", "time": 5556.79, "timestamp": "01:32:36", "text": "无法访问 Discord、YouTube 和 Twitch。"}, {"type": "subtitle", "time": 5559.51, "timestamp": "01:32:39", "text": "通常情况下，我们会这样做。"}, {"type": "subtitle", "time": 5562.709, "timestamp": "01:32:42", "text": "对，即使使用VPN也必须使用"}, {"type": "subtitle", "time": 5565.189, "timestamp": "01:32:45", "text": "使用 VPN 是非法的，对吧？"}, {"type": "subtitle", "time": 5567.75, "timestamp": "01:32:47", "text": "被抓到的话，你马上就要坐牢了，就是那种。"}, {"type": "subtitle", "time": 5571.75, "timestamp": "01:32:51", "text": "系统对吧，所以我就想"}, {"type": "subtitle", "time": 5574.149, "timestamp": "01:32:54", "text": "我见过很多 YouTuber 直播，"}, {"type": "subtitle", "time": 5577.189, "timestamp": "01:32:57", "text": "东西，人们呃在比利上直播。所以，我"}, {"type": "subtitle", "time": 5578.79, "timestamp": "01:32:58", "text": "当时我就想，“好吧，我要开始直播了。”"}]
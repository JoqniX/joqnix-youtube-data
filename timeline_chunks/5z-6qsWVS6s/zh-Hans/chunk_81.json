[{"type": "subtitle", "time": 4861.43, "timestamp": "01:21:01", "text": "一个中国平台，所有这些"}, {"type": "subtitle", "time": 4863.51, "timestamp": "01:21:03", "text": "甚至连标题都用英文写了"}, {"type": "subtitle", "time": 4865.83, "timestamp": "01:21:05", "text": "而且没有字幕什么的。"}, {"type": "subtitle", "time": 4868.87, "timestamp": "01:21:08", "text": "不，它被视为无效内容。"}, {"type": "subtitle", "time": 4871.59, "timestamp": "01:21:11", "text": "无效上传或其他什么原因导致的。"}, {"type": "subtitle", "time": 4873.27, "timestamp": "01:21:13", "text": "人们。"}, {"type": "subtitle", "time": 4875.91, "timestamp": "01:21:15", "text": "呃，因为我当时在找一些代理机构。"}, {"type": "subtitle", "time": 4878.39, "timestamp": "01:21:18", "text": "或者有人来接我，因为我是一个"}, {"type": "subtitle", "time": 4881.27, "timestamp": "01:21:21", "text": "现在外国人对外国人来说。好多哦"}, {"type": "subtitle", "time": 4883.43, "timestamp": "01:21:23", "text": "我的上帝。如果我要谈论……"}, {"type": "subtitle", "time": 4887.11, "timestamp": "01:21:27", "text": "兄弟，这个平台有限制。"}, {"type": "subtitle", "time": 4890.63, "timestamp": "01:21:30", "text": "我的天啊。我当时在做 Joathon 的事。"}, {"type": "subtitle", "time": 4892.55, "timestamp": "01:21:32", "text": "Joathon thingy 就像一场马拉松，"}, {"type": "subtitle", "time": 4894.229, "timestamp": "01:21:34", "text": "对，在 Twitch 和其他平台上都是如此，对吧？"}, {"type": "subtitle", "time": 4897.43, "timestamp": "01:21:37", "text": "有点像我活着的那种感觉"}, {"type": "subtitle", "time": 4900.229, "timestamp": "01:21:40", "text": "就像24小时不间断运行一样，对吧？而且我还会睡觉"}, {"type": "subtitle", "time": 4904.229, "timestamp": "01:21:44", "text": "直播之类的，对吧？所以，兄弟，你"}, {"type": "subtitle", "time": 4906.79, "timestamp": "01:21:46", "text": "直播时睡不着。你不能挂机"}, {"type": "subtitle", "time": 4908.79, "timestamp": "01:21:48", "text": "在您的直播间停留超过 10 分钟"}, {"type": "subtitle", "time": 4910.709, "timestamp": "01:21:50", "text": "或 5 分钟。如果你要离开"}, {"type": "subtitle", "time": 4913.11, "timestamp": "01:21:53", "text": "直播之类的，我一定要看。"}, {"type": "subtitle", "time": 4915.51, "timestamp": "01:21:55", "text": "用视觉方式或其他方式表达出来，以便"}, {"type": "subtitle", "time": 4918.709, "timestamp": "01:21:58", "text": "管理员不会删除我的文件。"}]
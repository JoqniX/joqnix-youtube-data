[{"type": "subtitle", "time": 8522.15, "timestamp": "02:22:02", "text": "我网站上的东西，嗯，根据……"}, {"type": "subtitle", "time": 8525.59, "timestamp": "02:22:05", "text": "我刚才说的就是活动那件事，嗯……"}, {"type": "subtitle", "time": 8527.67, "timestamp": "02:22:07", "text": "想让大家知道我唱的是什么歌"}, {"type": "subtitle", "time": 8531.11, "timestamp": "02:22:11", "text": "唱歌就像听歌一样，所以你就能明白"}, {"type": "subtitle", "time": 8534.309, "timestamp": "02:22:14", "text": "一开始我就是这样用的……"}, {"type": "subtitle", "time": 8537.59, "timestamp": "02:22:17", "text": "在 Takisan 的 utify 装置出现之前，我"}, {"type": "subtitle", "time": 8540.23, "timestamp": "02:22:20", "text": "看着不同的事物，嗯，我想我"}, {"type": "subtitle", "time": 8543.99, "timestamp": "02:22:23", "text": "直接从上一个 FM API 查看"}, {"type": "subtitle", "time": 8546.63, "timestamp": "02:22:26", "text": "至于图片，我想我当时在找"}, {"type": "subtitle", "time": 8550.63, "timestamp": "02:22:30", "text": "真的。这些都是我手动完成的。"}, {"type": "subtitle", "time": 8552.87, "timestamp": "02:22:32", "text": "使用谷歌搜索 API 等等"}, {"type": "subtitle", "time": 8554.87, "timestamp": "02:22:34", "text": "使用令牌等等。然后"}, {"type": "subtitle", "time": 8558.07, "timestamp": "02:22:38", "text": "Takisa自己制作了应用程序，其余的"}, {"type": "subtitle", "time": 8561.75, "timestamp": "02:22:41", "text": "API相关内容。然后它就变得更容易了，"}, {"type": "subtitle", "time": 8566.07, "timestamp": "02:22:46", "text": "正确的？是的。是的。所以我有一个我用的"}, {"type": "subtitle", "time": 8568.55, "timestamp": "02:22:48", "text": "最后一次FM是我整个跟踪过程的最后FM"}, {"type": "subtitle", "time": 8572.23, "timestamp": "02:22:52", "text": "我什么歌都听。这是"}, {"type": "subtitle", "time": 8574.23, "timestamp": "02:22:54", "text": "我最后一个FM相关的东西。我觉得我一直"}, {"type": "subtitle", "time": 8577.75, "timestamp": "02:22:57", "text": "长期以来一直在创作音乐。我"}]
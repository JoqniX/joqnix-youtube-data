[{"type": "subtitle", "time": 4382.55, "timestamp": "01:13:02", "text": "品牌推广以及现在的一切"}, {"type": "subtitle", "time": 4386.31, "timestamp": "01:13:06", "text": "目前的情况就像，例如，我曾经是"}, {"type": "subtitle", "time": 4390.47, "timestamp": "01:13:10", "text": "展示天气星球女孩们"}, {"type": "subtitle", "time": 4393.43, "timestamp": "01:13:13", "text": "例如像"}, {"type": "subtitle", "time": 4395.91, "timestamp": "01:13:15", "text": "如今的YouTube博主们，他们投入了大量精力"}, {"type": "subtitle", "time": 4399.43, "timestamp": "01:13:19", "text": "就像更高等级的标准一样，对吧？"}, {"type": "subtitle", "time": 4401.91, "timestamp": "01:13:21", "text": "看看她的频道，还有横幅广告。"}, {"type": "subtitle", "time": 4405.189, "timestamp": "01:13:25", "text": "东西，更高级的东西，背景，"}, {"type": "subtitle", "time": 4407.51, "timestamp": "01:13:27", "text": "频道什么的，所有的一切。缩略图"}, {"type": "subtitle", "time": 4411.59, "timestamp": "01:13:31", "text": "就描述而言，甚至就视频而言"}, {"type": "subtitle", "time": 4413.99, "timestamp": "01:13:33", "text": "内容方面也是如此。 Cover songwise，"}, {"type": "subtitle", "time": 4417.75, "timestamp": "01:13:37", "text": "所有东西质量都很好，价格也很高。"}, {"type": "subtitle", "time": 4422.149, "timestamp": "01:13:42", "text": "所以很多钱都花在了有点高的地方"}, {"type": "subtitle", "time": 4425.03, "timestamp": "01:13:45", "text": "内容质量不错，对吧？真是太……"}, {"type": "subtitle", "time": 4427.99, "timestamp": "01:13:47", "text": "标准已经达到了如此之高，以至于"}, {"type": "subtitle", "time": 4430.87, "timestamp": "01:13:50", "text": "模型和标准已经达到如此水平"}, {"type": "subtitle", "time": 4434.79, "timestamp": "01:13:54", "text": "太高了，真的很难，对吧？所以我也……"}, {"type": "subtitle", "time": 4437.99, "timestamp": "01:13:57", "text": "我非常专业，而且很挑剔。"}, {"type": "subtitle", "time": 4439.99, "timestamp": "01:13:59", "text": "以至于我当时就想，不，我不会的。"}]
[{"type": "subtitle", "time": 4920.79, "timestamp": "01:22:00", "text": "流和"}, {"type": "subtitle", "time": 4923.43, "timestamp": "01:22:03", "text": "给我，给我，给我发个警告"}, {"type": "subtitle", "time": 4926.31, "timestamp": "01:22:06", "text": "处于不活跃状态。 AFK警告，负面"}, {"type": "subtitle", "time": 4929.43, "timestamp": "01:22:09", "text": "流媒体指南警告。是的。所以，我"}, {"type": "subtitle", "time": 4932.39, "timestamp": "01:22:12", "text": "我收到了无数次警告，简直到了这种地步。"}, {"type": "subtitle", "time": 4936.79, "timestamp": "01:22:16", "text": "天哪，我居然因为一件事被封号了"}, {"type": "subtitle", "time": 4938.95, "timestamp": "01:22:18", "text": "星期。"}, {"type": "subtitle", "time": 4942.55, "timestamp": "01:22:22", "text": "我的天啊，作为一个外国人，这真是太忙乱了。"}, {"type": "subtitle", "time": 4945.11, "timestamp": "01:22:25", "text": "虽然他们无法理解。我"}, {"type": "subtitle", "time": 4947.99, "timestamp": "01:22:27", "text": "我不能吗？我甚至不懂中文。"}, {"type": "subtitle", "time": 4950.629, "timestamp": "01:22:30", "text": "普通话。我不会说普通话。我不能"}, {"type": "subtitle", "time": 4953.99, "timestamp": "01:22:33", "text": "甚至可以使用屏幕翻译器之类的东西"}, {"type": "subtitle", "time": 4957.03, "timestamp": "01:22:37", "text": "因为它根本不理解我。"}, {"type": "subtitle", "time": 4960.629, "timestamp": "01:22:40", "text": "我不知道为什么。我尝试了微软"}, {"type": "subtitle", "time": 4963.99, "timestamp": "01:22:43", "text": "语音识别装置。我试过了，嗯……"}, {"type": "subtitle", "time": 4967.11, "timestamp": "01:22:47", "text": "我试过了，我试过Jimakuchan那个东西。我试过"}, {"type": "subtitle", "time": 4969.83, "timestamp": "01:22:49", "text": "更多忍者转录了东西。我试过"}, {"type": "subtitle", "time": 4973.27, "timestamp": "01:22:53", "text": "好多人工智能模型之类的东西。所以，呃，关于这个"}, {"type": "subtitle", "time": 4976.95, "timestamp": "01:22:56", "text": "它需要理解当地的法律"}, {"type": "subtitle", "time": 4979.59, "timestamp": "01:22:59", "text": "就像语言之类的东西。我尝试了一切办法"}]
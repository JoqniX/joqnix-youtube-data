[{"type": "subtitle", "time": 3601.349, "timestamp": "01:00:01", "text": "是目前正在播出的动画"}, {"type": "subtitle", "time": 3605.109, "timestamp": "01:00:05", "text": "播出神すだ"}, {"type": "subtitle", "time": 3607.03, "timestamp": "01:00:07", "text": "呃，这部剧目前正在播出。"}, {"type": "subtitle", "time": 3610.63, "timestamp": "01:00:10", "text": "第零集最近刚出。"}, {"type": "subtitle", "time": 3614.47, "timestamp": "01:00:14", "text": "神吹玩意儿，嗯，我觉得它播出了"}, {"type": "subtitle", "time": 3618.39, "timestamp": "01:00:18", "text": "每周四播出，所以第零集也随之播出。"}, {"type": "subtitle", "time": 3621.75, "timestamp": "01:00:21", "text": "它有点像是在谈论……嗯……"}, {"type": "subtitle", "time": 3625.589, "timestamp": "01:00:25", "text": "它深入探讨了……"}, {"type": "subtitle", "time": 3627.43, "timestamp": "01:00:27", "text": "他们"}, {"type": "subtitle", "time": 3630.789, "timestamp": "01:00:30", "text": "呃，比如评分。我认为是"}, {"type": "subtitle", "time": 3633.349, "timestamp": "01:00:33", "text": "因为我认为是因为"}, {"type": "subtitle", "time": 3635.91, "timestamp": "01:00:35", "text": "现在是3D动画。人们不喜欢"}, {"type": "subtitle", "time": 3638.95, "timestamp": "01:00:38", "text": "3D动画之类的。是的，"}, {"type": "subtitle", "time": 3641.589, "timestamp": "01:00:41", "text": "这是卡凡"}, {"type": "subtitle", "time": 3644.789, "timestamp": "01:00:44", "text": "霸气。我不知道她是谁。是的，就是这样。"}, {"type": "subtitle", "time": 3649.27, "timestamp": "01:00:49", "text": "就像法律一样，它赋予了你一个完整的你。"}, {"type": "subtitle", "time": 3653.91, "timestamp": "01:00:53", "text": "像卡米苏阿格的粉丝们不得不……"}, {"type": "subtitle", "time": 3656.47, "timestamp": "01:00:56", "text": "就像故事板或者理论构思之类的"}]
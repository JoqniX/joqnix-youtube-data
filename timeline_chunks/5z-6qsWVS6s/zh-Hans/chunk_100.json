[{"type": "subtitle", "time": 6002.229, "timestamp": "01:40:02", "text": "现在在日本，有些东西是强制性的，比如语言。"}, {"type": "subtitle", "time": 6005.83, "timestamp": "01:40:05", "text": "学校部分是强制性的，所以是28"}, {"type": "subtitle", "time": 6010.55, "timestamp": "01:40:10", "text": "每周兼职小时数，对吧？"}, {"type": "subtitle", "time": 6012.47, "timestamp": "01:40:12", "text": "是的，有些学生"}, {"type": "subtitle", "time": 6016.07, "timestamp": "01:40:16", "text": "所以学院里的人都很想家，他们不是"}, {"type": "subtitle", "time": 6018.87, "timestamp": "01:40:18", "text": "他们只会把你送到日本。"}, {"type": "subtitle", "time": 6021.35, "timestamp": "01:40:21", "text": "对你所采取的一切负全部责任"}, {"type": "subtitle", "time": 6024.39, "timestamp": "01:40:24", "text": "你的事直到你到了日本才结束"}, {"type": "subtitle", "time": 6026.31, "timestamp": "01:40:26", "text": "直到你从这门语言课程毕业"}, {"type": "subtitle", "time": 6028.149, "timestamp": "01:40:28", "text": "对了，所以你得照顾好自己。"}, {"type": "subtitle", "time": 6031.27, "timestamp": "01:40:31", "text": "所有与你有关的事情，对吧？"}, {"type": "subtitle", "time": 6033.27, "timestamp": "01:40:33", "text": "语言学院的人必须写一个"}, {"type": "subtitle", "time": 6036.47, "timestamp": "01:40:36", "text": "书面道歉之类的东西，比如跟……谈谈"}, {"type": "subtitle", "time": 6038.79, "timestamp": "01:40:38", "text": "校长和所有学生相关事宜"}, {"type": "subtitle", "time": 6040.55, "timestamp": "01:40:40", "text": "案例中有一名学生是"}, {"type": "subtitle", "time": 6042.229, "timestamp": "01:40:42", "text": "他们想家了，所以不得不和……交谈"}, {"type": "subtitle", "time": 6043.75, "timestamp": "01:40:43", "text": "校长关于如何处理"}, {"type": "subtitle", "time": 6046.55, "timestamp": "01:40:46", "text": "有个学生，呃……"}, {"type": "subtitle", "time": 6049.59, "timestamp": "01:40:49", "text": "表现非常差，而且是兼职的"}, {"type": "subtitle", "time": 6053.75, "timestamp": "01:40:53", "text": "学院不得不与……举行一次会议"}, {"type": "subtitle", "time": 6057.51, "timestamp": "01:40:57", "text": "兼职或全职的 I 的所有者"}, {"type": "subtitle", "time": 6059.189, "timestamp": "01:40:59", "text": "我想那应该是一家便利店。他们"}]
[{"type": "subtitle", "time": 5283.91, "timestamp": "01:28:03", "text": "展示了推特，我也展示了，是的，因为我"}, {"type": "subtitle", "time": 5286.07, "timestamp": "01:28:06", "text": "向推特用户展示了那个 X 形的东西。他们"}, {"type": "subtitle", "time": 5288.31, "timestamp": "01:28:08", "text": "我意识到自己正在浏览一个外国网站。"}, {"type": "subtitle", "time": 5291.27, "timestamp": "01:28:11", "text": "他们真的给了我一次机会。所以"}, {"type": "subtitle", "time": 5297.43, "timestamp": "01:28:17", "text": "是的，有很多事情。是的。呃，为了在"}, {"type": "subtitle", "time": 5300.149, "timestamp": "01:28:20", "text": "根据我提供的信息，他们让我做什么"}, {"type": "subtitle", "time": 5302.79, "timestamp": "01:28:22", "text": "独家直播。我恳求他们"}, {"type": "subtitle", "time": 5305.51, "timestamp": "01:28:25", "text": "多流直播之类的，因为我当时在做"}, {"type": "subtitle", "time": 5307.91, "timestamp": "01:28:27", "text": "Joathon 和其他人。呃，在乔森之前，我"}, {"type": "subtitle", "time": 5310.229, "timestamp": "01:28:30", "text": "就像在做多路复用一样，对吧？曾经"}, {"type": "subtitle", "time": 5312.87, "timestamp": "01:28:32", "text": "由于 Twitch 允许多路直播，我"}, {"type": "subtitle", "time": 5315.91, "timestamp": "01:28:35", "text": "想做多平台直播，因为……"}, {"type": "subtitle", "time": 5319.11, "timestamp": "01:28:39", "text": "独家直播，他们的要求是1"}, {"type": "subtitle", "time": 5327.83, "timestamp": "01:28:47", "text": "我以前也这样做过。那曾经是我的"}, {"type": "subtitle", "time": 5331.669, "timestamp": "01:28:51", "text": "以前我常常花一个小时……"}, {"type": "subtitle", "time": 5334.149, "timestamp": "01:28:54", "text": "Apex 和 Valerant 之类的游戏。哦"}, {"type": "subtitle", "time": 5336.709, "timestamp": "01:28:56", "text": "是啊，连正常播放都做不到。"}, {"type": "subtitle", "time": 5339.43, "timestamp": "01:28:59", "text": "Apex 和 Valerant。你必须隐藏"}]
[{"type": "subtitle", "time": 4082.47, "timestamp": "01:08:02", "text": "要管理所有事情真是太忙了。"}, {"type": "subtitle", "time": 4084.39, "timestamp": "01:08:04", "text": "不，"}, {"type": "subtitle", "time": 4086.47, "timestamp": "01:08:06", "text": "当时人不多。"}, {"type": "subtitle", "time": 4088.95, "timestamp": "01:08:08", "text": "自愿来帮我"}, {"type": "subtitle", "time": 4091.029, "timestamp": "01:08:11", "text": "小玩意儿。情况太糟糕了，我就停了下来。"}, {"type": "subtitle", "time": 4094.549, "timestamp": "01:08:14", "text": "算是这么做吧。所以，我们当时就像……"}, {"type": "subtitle", "time": 4098.55, "timestamp": "01:08:18", "text": "列表。如果我能证明这一点的话。它在哪里？"}, {"type": "subtitle", "time": 4101.59, "timestamp": "01:08:21", "text": "嗯，是的，因为我列了个清单，因为我"}, {"type": "subtitle", "time": 4105.189, "timestamp": "01:08:25", "text": "想把它送给像……这样的人"}, {"type": "subtitle", "time": 4108.229, "timestamp": "01:08:28", "text": "大型数据库。 VTuber数据库放置了一些"}, {"type": "subtitle", "time": 4112.39, "timestamp": "01:08:32", "text": "就像这位 YouTuber 一样"}, {"type": "subtitle", "time": 4117.11, "timestamp": "01:08:37", "text": "亚洲虚拟主播。这里是亚洲。我希望我们能"}, {"type": "subtitle", "time": 4119.99, "timestamp": "01:08:39", "text": "在这里添加大约 500 位印度 YouTuber"}, {"type": "subtitle", "time": 4122.229, "timestamp": "01:08:42", "text": "来自印度的 200 位 YouTuber"}, {"type": "subtitle", "time": 4125.269, "timestamp": "01:08:45", "text": "类似这样的东西，就像"}, {"type": "subtitle", "time": 4127.43, "timestamp": "01:08:47", "text": "让印度 YouTuber 传播这个消息"}, {"type": "subtitle", "time": 4130.39, "timestamp": "01:08:50", "text": "存在之类的东西，但他们只关注"}, {"type": "subtitle", "time": 4134.55, "timestamp": "01:08:54", "text": "东亚人什么的，我也不知道。"}, {"type": "subtitle", "time": 4138.47, "timestamp": "01:08:58", "text": "真是太麻烦了，很难获得"}]
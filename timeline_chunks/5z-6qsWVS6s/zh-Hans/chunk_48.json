[{"type": "subtitle", "time": 2880.55, "timestamp": "00:48:00", "text": "我吃晚餐、早餐，还有午夜饭"}, {"type": "subtitle", "time": 2882.63, "timestamp": "00:48:02", "text": "吃零食，如果我要去厕所，如果"}, {"type": "subtitle", "time": 2886.23, "timestamp": "00:48:06", "text": "我醒了，一切都和往常一样。"}, {"type": "subtitle", "time": 2889.589, "timestamp": "00:48:09", "text": "我不得不这么做。我不得不这么做。"}, {"type": "subtitle", "time": 2891.589, "timestamp": "00:48:11", "text": "就像在这个按钮里一样"}, {"type": "subtitle", "time": 2893.67, "timestamp": "00:48:13", "text": "格式。我必须按下我身上的一个按钮。"}, {"type": "subtitle", "time": 2896.63, "timestamp": "00:48:16", "text": "用手机在直播中更新。为了"}, {"type": "chat", "time": 2898.329, "timestamp": "00:48:18", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Joq's Activity State is Sleeping 😴✨"}, {"type": "subtitle", "time": 2900.55, "timestamp": "00:48:20", "text": "例如，如果我在直播中睡觉……"}, {"type": "subtitle", "time": 2903.43, "timestamp": "00:48:23", "text": "现在点击按钮，它将显示为一个"}, {"type": "subtitle", "time": 2907.19, "timestamp": "00:48:27", "text": "在 OBS 上叠加显示，并且也说了这一点"}, {"type": "subtitle", "time": 2909.99, "timestamp": "00:48:29", "text": "Twitch 和 YouTube 聊天室就是这样的。"}, {"type": "subtitle", "time": 2912.87, "timestamp": "00:48:32", "text": "所以，我想以某种方式实现自动化。"}, {"type": "subtitle", "time": 2916.63, "timestamp": "00:48:36", "text": "我可以以某种方式动态地设置它。"}, {"type": "subtitle", "time": 2919.99, "timestamp": "00:48:39", "text": "现实生活中。我感觉就像在想象如果"}, {"type": "subtitle", "time": 2922.63, "timestamp": "00:48:42", "text": "我认为有办法，而且是可能的。"}, {"type": "subtitle", "time": 2926.069, "timestamp": "00:48:46", "text": "想象一下，我发送了一个 Webhook。"}, {"type": "subtitle", "time": 2928.87, "timestamp": "00:48:48", "text": "呃，向 Alexa 提出请求或其他什么请求"}, {"type": "subtitle", "time": 2931.43, "timestamp": "00:48:51", "text": "就像“OK Google”之类的，对吧？"}, {"type": "subtitle", "time": 2934.39, "timestamp": "00:48:54", "text": "呃，它醒来就像记得想象一样"}, {"type": "subtitle", "time": 2936.71, "timestamp": "00:48:56", "text": "天哪，我脑子里冒出了好多想法。"}, {"type": "subtitle", "time": 2939.43, "timestamp": "00:48:59", "text": "就在这一秒，我到底在想什么？"}]
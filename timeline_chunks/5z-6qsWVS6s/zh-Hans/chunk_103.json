[{"type": "subtitle", "time": 6180.229, "timestamp": "01:43:00", "text": "大学对硕士之类的学位很有帮助"}, {"type": "subtitle", "time": 6183.109, "timestamp": "01:43:03", "text": "进入大学需要一些条件"}, {"type": "subtitle", "time": 6184.95, "timestamp": "01:43:04", "text": "应该是东京大学之类的。"}, {"type": "subtitle", "time": 6187.83, "timestamp": "01:43:07", "text": "虽然很难，但我必须努力达到目标。"}, {"type": "subtitle", "time": 6190.629, "timestamp": "01:43:10", "text": "比如两年后我必须改变我"}, {"type": "subtitle", "time": 6192.79, "timestamp": "01:43:12", "text": "将我的签证改回A类"}, {"type": "subtitle", "time": 6194.629, "timestamp": "01:43:14", "text": "学生签证或类似工作签证的权利"}, {"type": "subtitle", "time": 6198.229, "timestamp": "01:43:18", "text": "待在日本，做所有这些事，太多了。"}, {"type": "subtitle", "time": 6201.03, "timestamp": "01:43:21", "text": "我主要想去日本的事情"}, {"type": "subtitle", "time": 6203.75, "timestamp": "01:43:23", "text": "因为我想找份工作。"}, {"type": "subtitle", "time": 6205.59, "timestamp": "01:43:25", "text": "嗯，这是行业娱乐。"}, {"type": "subtitle", "time": 6208.55, "timestamp": "01:43:28", "text": "行业相关，例如我们管材或"}, {"type": "subtitle", "time": 6211.27, "timestamp": "01:43:31", "text": "一些这样我就可以呃或者其他什么"}, {"type": "subtitle", "time": 6213.669, "timestamp": "01:43:33", "text": "在某种程度上，我想承诺我的"}, {"type": "subtitle", "time": 6217.109, "timestamp": "01:43:37", "text": "把渠道当作作品集来获取类似工作的机会"}, {"type": "subtitle", "time": 6219.51, "timestamp": "01:43:39", "text": "或许是机会，或许是别的什么，我"}, {"type": "subtitle", "time": 6222.07, "timestamp": "01:43:42", "text": "或许我会努力练习我的嗓音并这样做"}, {"type": "subtitle", "time": 6224.79, "timestamp": "01:43:44", "text": "配音之类的"}, {"type": "subtitle", "time": 6228.79, "timestamp": "01:43:48", "text": "对，而且，这也有帮助。"}, {"type": "subtitle", "time": 6231.03, "timestamp": "01:43:51", "text": "这将帮助我积累经验。"}, {"type": "subtitle", "time": 6235.59, "timestamp": "01:43:55", "text": "也呃，就Vubing而言"}, {"type": "subtitle", "time": 6237.91, "timestamp": "01:43:57", "text": "起源于日本。所以我可能会得到很多"}]
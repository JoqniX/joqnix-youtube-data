[{"type": "subtitle", "time": 1260.63, "timestamp": "00:21:00", "text": "如果我本地托管，它就会像……"}, {"type": "subtitle", "time": 1264.39, "timestamp": "00:21:04", "text": "我自己的本地主机，对吧，本地主机"}, {"type": "subtitle", "time": 1267.029, "timestamp": "00:21:07", "text": "正确的。所以我可以使用构建器并进行创建"}, {"type": "subtitle", "time": 1269.27, "timestamp": "00:21:09", "text": "修改，或者如果我把它交给编辑"}, {"type": "subtitle", "time": 1271.669, "timestamp": "00:21:11", "text": "比如网页编辑器之类的，我只能"}, {"type": "subtitle", "time": 1274.39, "timestamp": "00:21:14", "text": "只更改内容，或者我可以获取"}, {"type": "subtitle", "time": 1276.149, "timestamp": "00:21:16", "text": "把设计全部改好。所以"}, {"type": "subtitle", "time": 1279.51, "timestamp": "00:21:19", "text": "这在某种程度上是有帮助的，这就是我所需要的。"}, {"type": "subtitle", "time": 1282.149, "timestamp": "00:21:22", "text": "考虑做这件事，因为我有很多"}, {"type": "subtitle", "time": 1285.83, "timestamp": "00:21:25", "text": "我希望网站上能直接显示这些内容。"}, {"type": "subtitle", "time": 1290.149, "timestamp": "00:21:30", "text": "所以就好像我必须做……"}, {"type": "subtitle", "time": 1292.47, "timestamp": "00:21:32", "text": "包括自托管等等。所以我可以"}, {"type": "subtitle", "time": 1295.909, "timestamp": "00:21:35", "text": "比如点击这里导出。它有某种东西"}, {"type": "subtitle", "time": 1298.39, "timestamp": "00:21:38", "text": "适用于 Docker 等所有相关产品。所以我可以这样做"}, {"type": "subtitle", "time": 1300.39, "timestamp": "00:21:40", "text": "那。"}, {"type": "subtitle", "time": 1303.99, "timestamp": "00:21:43", "text": "但它使用起来很简单。是的，"}, {"type": "subtitle", "time": 1309.51, "timestamp": "00:21:49", "text": "它还有诗句。它具有万能性"}, {"type": "subtitle", "time": 1312.63, "timestamp": "00:21:52", "text": "这很好。 Versel导出功能已具备，所以"}, {"type": "subtitle", "time": 1314.549, "timestamp": "00:21:54", "text": "我可以立即启动它，"}, {"type": "subtitle", "time": 1317.35, "timestamp": "00:21:57", "text": "一切。我也是专业版用户。"}]
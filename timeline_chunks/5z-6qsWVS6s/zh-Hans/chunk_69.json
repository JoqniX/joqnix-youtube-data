[{"type": "subtitle", "time": 4141.59, "timestamp": "01:09:01", "text": "有些人喜欢添加传播"}, {"type": "subtitle", "time": 4144.63, "timestamp": "01:09:04", "text": "那个词，就是痛苦，我真的很想要那个。"}, {"type": "subtitle", "time": 4147.269, "timestamp": "01:09:07", "text": "比如数据库之类的"}, {"type": "subtitle", "time": 4150.309, "timestamp": "01:09:10", "text": "由 YouTube 用户创作。所以对于观众来说，他们可以"}, {"type": "subtitle", "time": 4154.309, "timestamp": "01:09:14", "text": "轻松找到YouTube用户。不，那里"}, {"type": "subtitle", "time": 4156.709, "timestamp": "01:09:16", "text": "没有需求。慢慢地"}, {"type": "subtitle", "time": 4158.309, "timestamp": "01:09:18", "text": "正在发生。社区和一切"}, {"type": "subtitle", "time": 4161.11, "timestamp": "01:09:21", "text": "真的很小，不太大或者"}, {"type": "subtitle", "time": 4164.07, "timestamp": "01:09:24", "text": "任何事物。每个 IMTuber 人"}, {"type": "subtitle", "time": 4167.51, "timestamp": "01:09:27", "text": "他们拥有共同的受众群体。"}, {"type": "subtitle", "time": 4169.669, "timestamp": "01:09:29", "text": "例如，呃，如果你观看其中一个"}, {"type": "subtitle", "time": 4172.63, "timestamp": "01:09:32", "text": "企业YouTube博主，他们的观众将会是"}, {"type": "subtitle", "time": 4175.91, "timestamp": "01:09:35", "text": "类似于独立YouTube博主。个人"}, {"type": "subtitle", "time": 4178.55, "timestamp": "01:09:38", "text": "正在积极与同一方合作的人"}, {"type": "subtitle", "time": 4181.91, "timestamp": "01:09:41", "text": "像这样的公司，或者像大多数公司一样。"}, {"type": "subtitle", "time": 4184.47, "timestamp": "01:09:44", "text": "独立电影拥有其独特的受众群体。"}, {"type": "subtitle", "time": 4187.269, "timestamp": "01:09:47", "text": "它们各自拥有独特的受众群体或"}, {"type": "subtitle", "time": 4190.47, "timestamp": "01:09:50", "text": "很多时候，它更像是一种"}, {"type": "subtitle", "time": 4193.03, "timestamp": "01:09:53", "text": "共同的受众群体，关键在于它更多"}, {"type": "subtitle", "time": 4195.99, "timestamp": "01:09:55", "text": "小巧精致"}, {"type": "subtitle", "time": 4198.31, "timestamp": "01:09:58", "text": "真的很小，也很小，那是一个"}]
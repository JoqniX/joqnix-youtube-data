[{"type": "subtitle", "time": 8102.709, "timestamp": "02:15:02", "text": "你在这里？它说正在睡觉。"}, {"type": "subtitle", "time": 8104.79, "timestamp": "02:15:04", "text": "什么？睡眠？什么？你是什​​么意思"}, {"type": "subtitle", "time": 8106.47, "timestamp": "02:15:06", "text": "睡眠？"}, {"type": "subtitle", "time": 8109.35, "timestamp": "02:15:09", "text": "在哪里？它上面写着“活着”，尽管它就在我的上方"}, {"type": "subtitle", "time": 8112.95, "timestamp": "02:15:12", "text": "屏幕上显示“直播”，并询问“这是什么”。"}, {"type": "subtitle", "time": 8115.35, "timestamp": "02:15:15", "text": "我们正在做的事情和活动"}, {"type": "subtitle", "time": 8134.39, "timestamp": "02:15:34", "text": "你说的“它说它是”是什么意思？"}, {"type": "subtitle", "time": 8140.229, "timestamp": "02:15:40", "text": "我们刚才看到了这个。啊，别担心。不"}, {"type": "subtitle", "time": 8145.109, "timestamp": "02:15:45", "text": "担心。不用担心。我敢肯定。"}, {"type": "subtitle", "time": 8147.27, "timestamp": "02:15:47", "text": "哦，这项活动。哦，是的。别介意"}, {"type": "subtitle", "time": 8149.189, "timestamp": "02:15:49", "text": "那。好的。别在意。别介意"}, {"type": "subtitle", "time": 8156.39, "timestamp": "02:15:56", "text": "不用担心。不用担心。希望你"}, {"type": "subtitle", "time": 8159.83, "timestamp": "02:15:59", "text": "一切顺利。我在做网站相关的事情。"}]
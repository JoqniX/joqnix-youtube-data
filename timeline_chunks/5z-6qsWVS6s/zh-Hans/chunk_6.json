[{"type": "subtitle", "time": 360.629, "timestamp": "00:06:00", "text": "我想在 Webflow 上尝试一些东西。"}, {"type": "subtitle", "time": 362.79, "timestamp": "00:06:02", "text": "然后我意识到，这很好"}, {"type": "subtitle", "time": 366.15, "timestamp": "00:06:06", "text": "开源版本的 Webflow，例如"}, {"type": "subtitle", "time": 367.749, "timestamp": "00:06:07", "text": "Web Flow 的直接竞争对手"}, {"type": "subtitle", "time": 371.35, "timestamp": "00:06:11", "text": "那是网络工作室，然后就像三呃二"}, {"type": "subtitle", "time": 374.71, "timestamp": "00:06:14", "text": "几年前，然后知道去年我"}, {"type": "subtitle", "time": 376.87, "timestamp": "00:06:16", "text": "好吧，我想用 Web Studio。"}, {"type": "subtitle", "time": 379.83, "timestamp": "00:06:19", "text": "因为你可以连接一个自定义域"}, {"type": "subtitle", "time": 381.59, "timestamp": "00:06:21", "text": "您可以连接一个或三个域，或者"}, {"type": "subtitle", "time": 384.07, "timestamp": "00:06:24", "text": "四个自定义域名并发布网站"}, {"type": "subtitle", "time": 386.87, "timestamp": "00:06:26", "text": "立刻就对了，一切都对了"}, {"type": "subtitle", "time": 389.029, "timestamp": "00:06:29", "text": "这让我得到了我想要的一切。"}, {"type": "subtitle", "time": 391.35, "timestamp": "00:06:31", "text": "例如免费提供多域名支持"}, {"type": "subtitle", "time": 393.11, "timestamp": "00:06:33", "text": "就在那时，我意识到了一切。"}, {"type": "subtitle", "time": 395.43, "timestamp": "00:06:35", "text": "他们提供终身合约，所以我选择了他们"}, {"type": "subtitle", "time": 398.469, "timestamp": "00:06:38", "text": "终身合约计划之类的东西。以便"}, {"type": "subtitle", "time": 401.43, "timestamp": "00:06:41", "text": "这意味着我可以永远这样做"}, {"type": "subtitle", "time": 404.55, "timestamp": "00:06:44", "text": "网站，连接到多少个域名"}, {"type": "subtitle", "time": 408.469, "timestamp": "00:06:48", "text": "想要等等。全部免费。"}, {"type": "subtitle", "time": 412.55, "timestamp": "00:06:52", "text": "所以我买了专业版套餐，呃，嗯，呃，呃，就像"}, {"type": "subtitle", "time": 416.629, "timestamp": "00:06:56", "text": "它提供的终身保障。所以全是氛围，没有"}, {"type": "subtitle", "time": 419.27, "timestamp": "00:06:59", "text": "网站相关的工作是在 Web Studio 中完成的。"}]
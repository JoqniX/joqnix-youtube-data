[{"type": "subtitle", "time": 8820.23, "timestamp": "02:27:00", "text": "一台用了6年就坏掉的3800X处理器。我 我 我 它"}, {"type": "subtitle", "time": 8823.11, "timestamp": "02:27:03", "text": "当时它在进行现场支持，"}, {"type": "subtitle", "time": 8825.99, "timestamp": "02:27:05", "text": "它死了，伙计。真糟糕。它曾经是"}, {"type": "subtitle", "time": 8829.19, "timestamp": "02:27:09", "text": "内部问题。整个处理器"}, {"type": "subtitle", "time": 8831.75, "timestamp": "02:27:11", "text": "死了。是的，所以我把所有东西都放进去了。"}, {"type": "subtitle", "time": 8834.71, "timestamp": "02:27:14", "text": "现在就从游戏电脑换到游戏电脑。所以在"}, {"type": "subtitle", "time": 8837.51, "timestamp": "02:27:17", "text": "我现在把所有东西都放在这里。"}, {"type": "subtitle", "time": 8840.95, "timestamp": "02:27:20", "text": "由于VB音频方面的内容已经满了，所以我也"}, {"type": "subtitle", "time": 8844.55, "timestamp": "02:27:24", "text": "我还买了这个虚拟的"}, {"type": "subtitle", "time": 8847.429, "timestamp": "02:27:27", "text": "音频线"}, {"type": "subtitle", "time": 8851.429, "timestamp": "02:27:31", "text": "使用V型电缆。我有这个专业人士"}, {"type": "subtitle", "time": 8853.91, "timestamp": "02:27:33", "text": "这是此版本的一个版本。所以从某种意义上说，你可以"}, {"type": "subtitle", "time": 8857.27, "timestamp": "02:27:37", "text": "创建 127 条虚拟电缆，对吗？所以，我"}, {"type": "subtitle", "time": 8860.309, "timestamp": "02:27:40", "text": "有一个浏览器版本"}, {"type": "subtitle", "time": 8863.19, "timestamp": "02:27:43", "text": "也就是说，我有一个用于浏览器的眉毛，"}, {"type": "subtitle", "time": 8866.63, "timestamp": "02:27:46", "text": "还有一个用于音乐。有一个开放的"}, {"type": "subtitle", "time": 8871.27, "timestamp": "02:27:51", "text": "来源一是呃 J 呃 是 DMAC 吗？是"}, {"type": "subtitle", "time": 8873.83, "timestamp": "02:27:53", "text": "它是DMAC吗？"}, {"type": "subtitle", "time": 8877.99, "timestamp": "02:27:57", "text": "等等，是Jack音频线吗？"}]
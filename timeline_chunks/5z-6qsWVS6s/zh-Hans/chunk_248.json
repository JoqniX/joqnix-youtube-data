[{"type": "subtitle", "time": 14882.71, "timestamp": "04:08:02", "text": "现在搞这个是因为他们喜欢它"}, {"type": "subtitle", "time": 14886.469, "timestamp": "04:08:06", "text": "如果能找到图片，就生成图片文件。"}, {"type": "subtitle", "time": 14888.389, "timestamp": "04:08:08", "text": "是的，他们很注重形象。"}, {"type": "subtitle", "time": 14891.83, "timestamp": "04:08:11", "text": "东西。他们有个优化装置"}, {"type": "subtitle", "time": 14894.07, "timestamp": "04:08:14", "text": "用于图像。"}, {"type": "subtitle", "time": 14897.03, "timestamp": "04:08:17", "text": "我正在改进这个东西。所以，我"}, {"type": "subtitle", "time": 14901.59, "timestamp": "04:08:21", "text": "可以做的就是上传背景图。"}, {"type": "subtitle", "time": 14903.67, "timestamp": "04:08:23", "text": "例如，我的星座"}, {"type": "subtitle", "time": 14906.07, "timestamp": "04:08:26", "text": "就在这里。"}, {"type": "subtitle", "time": 14908.79, "timestamp": "04:08:28", "text": "我这里有个星座相关的玩意儿。哦，"}, {"type": "subtitle", "time": 14912.07, "timestamp": "04:08:32", "text": "顺便说一句，我可以用这个。哦，对，让我们"}, {"type": "subtitle", "time": 14918.95, "timestamp": "04:08:38", "text": "100%。"}, {"type": "subtitle", "time": 14921.349, "timestamp": "04:08:41", "text": "我觉得我必须这么做"}, {"type": "subtitle", "time": 14927.83, "timestamp": "04:08:47", "text": "呃"}, {"type": "subtitle", "time": 14930.309, "timestamp": "04:08:50", "text": "是“填充”还是“包含”更好？充满"}, {"type": "subtitle", "time": 14932.469, "timestamp": "04:08:52", "text": "看起来"}, {"type": "subtitle", "time": 14935.95, "timestamp": "04:08:55", "text": "掩护也可以。"}, {"type": "subtitle", "time": 14937.67, "timestamp": "04:08:57", "text": "[音乐]"}, {"type": "subtitle", "time": 14939.67, "timestamp": "04:08:59", "text": "哦，对了，我可以改变物体的位置。"}]
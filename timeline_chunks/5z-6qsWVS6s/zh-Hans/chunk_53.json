[{"type": "subtitle", "time": 3180.549, "timestamp": "00:53:00", "text": "也。一旦我们准备好游戏道具，"}, {"type": "subtitle", "time": 3182.63, "timestamp": "00:53:02", "text": "比如视觉小说之类的东西，我可以放一些东西。"}, {"type": "subtitle", "time": 3186.309, "timestamp": "00:53:06", "text": "那里也是。想象一下数量"}, {"type": "subtitle", "time": 3190.069, "timestamp": "00:53:10", "text": "我可以利用这个想法做的事情"}, {"type": "subtitle", "time": 3192.15, "timestamp": "00:53:12", "text": "是的。是的。是的。最好不要忘记"}, {"type": "subtitle", "time": 3193.75, "timestamp": "00:53:13", "text": "他们。是的。是的。是的。我的意思是，它是"}, {"type": "subtitle", "time": 3196.549, "timestamp": "00:53:16", "text": "一直萦绕在我心头。问题是我不能"}, {"type": "subtitle", "time": 3199.829, "timestamp": "00:53:19", "text": "所有事情都由我自己做。你需要像一个"}, {"type": "subtitle", "time": 3203.589, "timestamp": "00:53:23", "text": "团队。不，这就是我停下来的原因。"}, {"type": "subtitle", "time": 3206.79, "timestamp": "00:53:26", "text": "我的 Onexia 相关内容，因为我意识到"}, {"type": "subtitle", "time": 3210.309, "timestamp": "00:53:30", "text": "是的，你需要一个团队，一个……团队"}, {"type": "subtitle", "time": 3212.79, "timestamp": "00:53:32", "text": "很多人。不，为了做"}, {"type": "subtitle", "time": 3217.51, "timestamp": "00:53:37", "text": "像拥有整个……这样的大事"}, {"type": "subtitle", "time": 3220.79, "timestamp": "00:53:40", "text": "游戏设置、音乐或其他任何东西，"}, {"type": "subtitle", "time": 3224.069, "timestamp": "00:53:44", "text": "艺术、漫画、一切事物、音乐，任何东西。"}, {"type": "subtitle", "time": 3227.67, "timestamp": "00:53:47", "text": "OnX是什么？ OnX就像……嗯……我该怎么做？"}, {"type": "subtitle", "time": 3230.95, "timestamp": "00:53:50", "text": "我该怎么说呢？我"}, {"type": "subtitle", "time": 3234.549, "timestamp": "00:53:54", "text": "我想我把它放进这个东西里了吗？"}, {"type": "subtitle", "time": 3237.67, "timestamp": "00:53:57", "text": "我把它放在这里了吗？"}, {"type": "subtitle", "time": 3239.99, "timestamp": "00:53:59", "text": "我想是的。是的。所以这就像是给予"}]
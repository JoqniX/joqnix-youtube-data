[{"type": "subtitle", "time": 11954.71, "timestamp": "03:19:14", "text": "很多事情我都不明白。"}, {"type": "subtitle", "time": 11958.229, "timestamp": "03:19:18", "text": "时区类型等于“哦，我明白了”。"}, {"type": "subtitle", "time": 11963.269, "timestamp": "03:19:23", "text": "哦，那个时区相当于晚上。"}, {"type": "subtitle", "time": 11965.59, "timestamp": "03:19:25", "text": "类型龙卷风"}, {"type": "subtitle", "time": 11975.11, "timestamp": "03:19:35", "text": "我计划使用 inert，它是开源的。"}, {"type": "subtitle", "time": 11977.51, "timestamp": "03:19:37", "text": "是的，如果你有虚拟主播模型，那就去吧。"}, {"type": "subtitle", "time": 11980.309, "timestamp": "03:19:40", "text": "带有实时 2D 显示。这并不重要，即使你"}, {"type": "subtitle", "time": 11983.51, "timestamp": "03:19:43", "text": "使用 Vub Studio 或 Inoi。井野不是停下来了吗？"}, {"type": "subtitle", "time": 11987.11, "timestamp": "03:19:47", "text": "他们的开发过程，因为嗯"}, {"type": "subtitle", "time": 11991.03, "timestamp": "03:19:51", "text": "开发人员专注于她的VT社交"}, {"type": "subtitle", "time": 11992.95, "timestamp": "03:19:52", "text": "东西。"}, {"type": "subtitle", "time": 11995.99, "timestamp": "03:19:55", "text": "不，她"}]
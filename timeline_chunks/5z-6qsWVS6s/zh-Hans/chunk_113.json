[{"type": "subtitle", "time": 6781.27, "timestamp": "01:53:01", "text": "这是个好主意吗？还是我应该再等等？"}, {"type": "subtitle", "time": 6783.43, "timestamp": "01:53:03", "text": "专注于内容？做内容创作方面的工作。"}, {"type": "subtitle", "time": 6786.79, "timestamp": "01:53:06", "text": "不要重蹈我的覆辙。专注于建设"}, {"type": "subtitle", "time": 6790.07, "timestamp": "01:53:10", "text": "你的社区以及所有的一切。第一的"}, {"type": "subtitle", "time": 6792.39, "timestamp": "01:53:12", "text": "拥有一个不错的、略显沉闷的社区。你知道，"}, {"type": "subtitle", "time": 6794.55, "timestamp": "01:53:14", "text": "“陈旧”这个词用得不恰当。"}, {"type": "subtitle", "time": 6797.75, "timestamp": "01:53:17", "text": "稳定的社区等等，呃，谁？"}, {"type": "subtitle", "time": 6800.07, "timestamp": "01:53:20", "text": "他们在那里，积极参与，并且"}, {"type": "subtitle", "time": 6802.79, "timestamp": "01:53:22", "text": "然后尽一切努力做到这些额外的事情"}, {"type": "subtitle", "time": 6805.03, "timestamp": "01:53:25", "text": "像周边商品之类的东西。"}, {"type": "subtitle", "time": 6808.229, "timestamp": "01:53:28", "text": "或者，如果你……如果你愿意的话"}, {"type": "subtitle", "time": 6811.109, "timestamp": "01:53:31", "text": "要做到这一点，你总是可以打破第四面墙。"}, {"type": "subtitle", "time": 6812.709, "timestamp": "01:53:32", "text": "有些 Twitch 主播使用"}, {"type": "subtitle", "time": 6816.229, "timestamp": "01:53:36", "text": "第四面墙。例如，Sai 使用"}, {"type": "subtitle", "time": 6819.99, "timestamp": "01:53:39", "text": "慢性病。她打破了第四面墙。她"}, {"type": "subtitle", "time": 6823.669, "timestamp": "01:53:43", "text": "有一个打破第四面墙的页面。"}, {"type": "subtitle", "time": 6825.83, "timestamp": "01:53:45", "text": "呃，她有一个打破第四面墙的页面。在哪里？"}, {"type": "subtitle", "time": 6828.55, "timestamp": "01:53:48", "text": "它？她变了吗？"}, {"type": "subtitle", "time": 6830.229, "timestamp": "01:53:50", "text": "好的。"}, {"type": "subtitle", "time": 6836.95, "timestamp": "01:53:56", "text": "一秒钟。嗯"}, {"type": "subtitle", "time": 6839.83, "timestamp": "01:53:59", "text": "如果我是的话，她会有一个打破第四面墙的页面"}]
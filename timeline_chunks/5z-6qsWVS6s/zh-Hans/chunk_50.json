[{"type": "subtitle", "time": 3001.99, "timestamp": "00:50:01", "text": "正确的？嗯，展会太多了。是的，我知道。"}, {"type": "subtitle", "time": 3005.91, "timestamp": "00:50:05", "text": "但是，是的，固定方式已经修复了下部。"}, {"type": "subtitle", "time": 3009.589, "timestamp": "00:50:09", "text": "我脑海中构想的系统是这样的："}, {"type": "subtitle", "time": 3011.91, "timestamp": "00:50:11", "text": "例如，像日历一样。所以"}, {"type": "subtitle", "time": 3014.95, "timestamp": "00:50:14", "text": "日历，就像日历一样，你可以……"}, {"type": "subtitle", "time": 3020.309, "timestamp": "00:50:20", "text": "比如，就像在日历里写“我有吗？”"}, {"type": "subtitle", "time": 3023.03, "timestamp": "00:50:23", "text": "我的天啊。好的。就像日历一样"}, {"type": "subtitle", "time": 3025.75, "timestamp": "00:50:25", "text": "设置正确吗？嗯，例如像节目"}, {"type": "subtitle", "time": 3029.51, "timestamp": "00:50:29", "text": "概念日历类似于日历设置"}, {"type": "subtitle", "time": 3032.15, "timestamp": "00:50:32", "text": "呃，就像日历设置一样，我可以按月设置。"}, {"type": "subtitle", "time": 3035.91, "timestamp": "00:50:35", "text": "设置一个预先创建的活动"}, {"type": "subtitle", "time": 3039.03, "timestamp": "00:50:39", "text": "比如，我的生日是八月。"}, {"type": "subtitle", "time": 3043.27, "timestamp": "00:50:43", "text": "11，对，所以8月11日，我可以这样说："}, {"type": "subtitle", "time": 3045.99, "timestamp": "00:50:45", "text": "笑话的生日和8月10日是什么？"}, {"type": "subtitle", "time": 3048.47, "timestamp": "00:50:48", "text": "例如，如果我去打仗的话。"}, {"type": "subtitle", "time": 3049.99, "timestamp": "00:50:49", "text": "地牢首领之类的东西"}, {"type": "subtitle", "time": 3053.43, "timestamp": "00:50:53", "text": "具体时间我们也可以这样做，我可以"}, {"type": "subtitle", "time": 3056.71, "timestamp": "00:50:56", "text": "如果我说如果我能启动我的写作"}, {"type": "subtitle", "time": 3059.19, "timestamp": "00:50:59", "text": "因为我得自己写故事，所以就先写这些吧。"}]
[{"type": "subtitle", "time": 6060.709, "timestamp": "01:41:00", "text": "需要和便利店谈谈。"}, {"type": "subtitle", "time": 6063.27, "timestamp": "01:41:03", "text": "向所有者道歉并写一份书面道歉信"}, {"type": "subtitle", "time": 6065.99, "timestamp": "01:41:05", "text": "道歉信及其他相关材料"}, {"type": "subtitle", "time": 6067.59, "timestamp": "01:41:07", "text": "一切"}, {"type": "subtitle", "time": 6069.59, "timestamp": "01:41:09", "text": "工作表现不佳"}, {"type": "subtitle", "time": 6072.629, "timestamp": "01:41:12", "text": "一切。真是太痛苦了。所以他们"}, {"type": "subtitle", "time": 6074.79, "timestamp": "01:41:14", "text": "就像这种补偿一样"}, {"type": "subtitle", "time": 6077.83, "timestamp": "01:41:17", "text": "他们讲述了事情的经过。"}, {"type": "subtitle", "time": 6081.59, "timestamp": "01:41:21", "text": "给我提供免费的N4课程。所以我会是"}, {"type": "subtitle", "time": 6084.47, "timestamp": "01:41:24", "text": "参加课程"}, {"type": "subtitle", "time": 6088.87, "timestamp": "01:41:28", "text": "N4 至 N3 基础课程。所以是"}, {"type": "subtitle", "time": 6091.75, "timestamp": "01:41:31", "text": "更像是我会做好充分准备。患病的"}, {"type": "subtitle", "time": 6095.59, "timestamp": "01:41:35", "text": "做好充分准备，直到我"}, {"type": "subtitle", "time": 6099.669, "timestamp": "01:41:39", "text": "像四月份入学那样去日本。所以通过"}, {"type": "subtitle", "time": 6103.03, "timestamp": "01:41:43", "text": "三月底我就要离开了。接下来"}, {"type": "subtitle", "time": 6105.669, "timestamp": "01:41:45", "text": "一年时间，所以我有时间准备。现在这个"}, {"type": "subtitle", "time": 6108.149, "timestamp": "01:41:48", "text": "我仅有的时间意味着我必须写作"}, {"type": "subtitle", "time": 6112.95, "timestamp": "01:41:52", "text": "N4考试也包括在内。所以我就像是……"}, {"type": "subtitle", "time": 6115.189, "timestamp": "01:41:55", "text": "是啊，我必须这么做。不，我有"}, {"type": "subtitle", "time": 6116.87, "timestamp": "01:41:56", "text": "我会尽我所能好好学习。"}, {"type": "subtitle", "time": 6118.629, "timestamp": "01:41:58", "text": "一切。"}]
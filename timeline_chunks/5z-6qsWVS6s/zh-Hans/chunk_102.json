[{"type": "subtitle", "time": 6121.669, "timestamp": "01:42:01", "text": "你需要升到多少级？我是说"}, {"type": "subtitle", "time": 6124.629, "timestamp": "01:42:04", "text": "JPT考试分为五个级别，其中五个级别是"}, {"type": "subtitle", "time": 6126.31, "timestamp": "01:42:06", "text": "初学者和本地人"}, {"type": "subtitle", "time": 6129.83, "timestamp": "01:42:09", "text": "等级。商业职位和工作职位"}, {"type": "subtitle", "time": 6131.75, "timestamp": "01:42:11", "text": "一般来说，你需要拥有一个"}, {"type": "subtitle", "time": 6135.91, "timestamp": "01:42:15", "text": "外国人N2资格"}, {"type": "subtitle", "time": 6138.07, "timestamp": "01:42:18", "text": "呃，还有两种语言：日语"}, {"type": "subtitle", "time": 6141.27, "timestamp": "01:42:21", "text": "教授的流利度资格是"}, {"type": "subtitle", "time": 6143.669, "timestamp": "01:42:23", "text": "这是你在那里找到任何工作的必要条件。"}, {"type": "subtitle", "time": 6146.229, "timestamp": "01:42:26", "text": "所以，学院的人就是这样说的。"}, {"type": "subtitle", "time": 6148.39, "timestamp": "01:42:28", "text": "因为我是，因为他们会教我"}, {"type": "subtitle", "time": 6152.95, "timestamp": "01:42:32", "text": "N4 和 N3 基准水平，然后是我的四月"}, {"type": "subtitle", "time": 6155.35, "timestamp": "01:42:35", "text": "入学时间大约为两年。"}, {"type": "subtitle", "time": 6157.83, "timestamp": "01:42:37", "text": "正确的课程时长是2年，所以在"}, {"type": "subtitle", "time": 6159.91, "timestamp": "01:42:39", "text": "他们说我可以完成我的全部"}, {"type": "subtitle", "time": 6162.79, "timestamp": "01:42:42", "text": "一年内即可完成课程"}, {"type": "subtitle", "time": 6165.75, "timestamp": "01:42:45", "text": "一年之内我就能完全完成"}, {"type": "subtitle", "time": 6168.629, "timestamp": "01:42:48", "text": "我的所有课程，以及我需要的一切"}, {"type": "subtitle", "time": 6172.31, "timestamp": "01:42:52", "text": "要么去找个好人。"}, {"type": "subtitle", "time": 6176.709, "timestamp": "01:42:56", "text": "全职工作或者找份工作"}]
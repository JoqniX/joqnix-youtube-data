[{"type": "subtitle", "time": 10322.469, "timestamp": "02:52:02", "text": "比利，比利，怎么做呢，因为人们不"}, {"type": "subtitle", "time": 10325.51, "timestamp": "02:52:05", "text": "懂中文，怎么读这个链接"}, {"type": "subtitle", "time": 10328.469, "timestamp": "02:52:08", "text": "翻译稿和小册子"}, {"type": "subtitle", "time": 10331.19, "timestamp": "02:52:11", "text": "用于提取 WC 的流链接"}, {"type": "subtitle", "time": 10334.309, "timestamp": "02:52:14", "text": "那个东西和 YouTube 页面"}, {"type": "subtitle", "time": 10336.309, "timestamp": "02:52:16", "text": "比利档案馆的播放列表"}, {"type": "subtitle", "time": 10339.19, "timestamp": "02:52:19", "text": "我以前经常这样处理村里的溪流。"}, {"type": "subtitle", "time": 10342.309, "timestamp": "02:52:22", "text": "直播结束后，我发送了"}, {"type": "subtitle", "time": 10344.87, "timestamp": "02:52:24", "text": "摘要说明。"}, {"type": "subtitle", "time": 10347.59, "timestamp": "02:52:27", "text": "我以前就是这么做的。我停了下来"}, {"type": "subtitle", "time": 10351.269, "timestamp": "02:52:31", "text": "做这些额外的事情是因为就像"}, {"type": "subtitle", "time": 10354.71, "timestamp": "02:52:34", "text": "现在太多了。"}, {"type": "subtitle", "time": 10357.349, "timestamp": "02:52:37", "text": "我怀念做那件事。"}, {"type": "subtitle", "time": 10361.11, "timestamp": "02:52:41", "text": "哦，好痛。我需要恢复嵌入功能。"}, {"type": "subtitle", "time": 10364.15, "timestamp": "02:52:44", "text": "公告之类的东西。"}, {"type": "subtitle", "time": 10366.79, "timestamp": "02:52:46", "text": "我的天哪。"}, {"type": "subtitle", "time": 10373.51, "timestamp": "02:52:53", "text": "好的，明天之前我会私信我。"}, {"type": "subtitle", "time": 10376.15, "timestamp": "02:52:56", "text": "关于这件事，但是你知道吗？"}, {"type": "subtitle", "time": 10379.91, "timestamp": "02:52:59", "text": "我现在就去做，趁我还没……"}]
[{"type": "subtitle", "time": 3481.109, "timestamp": "00:58:01", "text": "比如他们会发布小说之类的，"}, {"type": "subtitle", "time": 3485.67, "timestamp": "00:58:05", "text": "TRPG游戏，以网络动画为基础2.0平台"}, {"type": "subtitle", "time": 3487.99, "timestamp": "00:58:07", "text": "Web 3 将是 MF。我们过去确实这样做过"}, {"type": "subtitle", "time": 3491.43, "timestamp": "00:58:11", "text": "过去做过 Web 3 相关的事情，也做过 NFD 相关的事情。现在"}, {"type": "subtitle", "time": 3492.87, "timestamp": "00:58:12", "text": "他们停了下来，他们改变了"}, {"type": "subtitle", "time": 3495.109, "timestamp": "00:58:15", "text": "方向。所以就像NFD那玩意儿一样"}, {"type": "subtitle", "time": 3498.23, "timestamp": "00:58:18", "text": "就像你获得了公民身份一样"}, {"type": "subtitle", "time": 3501.27, "timestamp": "00:58:21", "text": "神椿市那件事等等"}, {"type": "subtitle", "time": 3503.75, "timestamp": "00:58:23", "text": "所以他们现在所做的就是通过"}, {"type": "subtitle", "time": 3507.03, "timestamp": "00:58:27", "text": "对，这就是NFT那玩意儿。他们"}, {"type": "subtitle", "time": 3509.03, "timestamp": "00:58:29", "text": "停止了。它们发生了变化"}, {"type": "subtitle", "time": 3511.589, "timestamp": "00:58:31", "text": "现在朝着这个方向前进。他们阻止了这件事。但"}, {"type": "subtitle", "time": 3516.549, "timestamp": "00:58:36", "text": "是的，印度你可以像……一样"}, {"type": "subtitle", "time": 3519.43, "timestamp": "00:58:39", "text": "社区城市居民"}, {"type": "subtitle", "time": 3522.63, "timestamp": "00:58:42", "text": "他们还有一部感官系列作品。所以在"}, {"type": "subtitle", "time": 3524.87, "timestamp": "00:58:44", "text": "我未来计划做的直播"}, {"type": "subtitle", "time": 3528.23, "timestamp": "00:58:48", "text": "还有演唱会，3D演唱会之类的。"}, {"type": "subtitle", "time": 3530.63, "timestamp": "00:58:50", "text": "呃，因为我更偏向于制作人类型的"}, {"type": "subtitle", "time": 3532.63, "timestamp": "00:58:52", "text": "虽然我有点迷糊，但我也在学习唱歌。"}, {"type": "subtitle", "time": 3536.069, "timestamp": "00:58:56", "text": "所以我希望我能举办自己的演唱会，"}, {"type": "subtitle", "time": 3538.39, "timestamp": "00:58:58", "text": "就像我自己一个人的独奏音乐会"}]
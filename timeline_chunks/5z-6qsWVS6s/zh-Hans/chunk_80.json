[{"type": "subtitle", "time": 4801.51, "timestamp": "01:20:01", "text": "公会链接，呃，这是我的账号。所以"}, {"type": "subtitle", "time": 4803.51, "timestamp": "01:20:03", "text": "所以每当我想要直播的时候……"}, {"type": "subtitle", "time": 4805.75, "timestamp": "01:20:05", "text": "现在我不得不预订一份像清单一样广泛的名单。"}, {"type": "subtitle", "time": 4808.07, "timestamp": "01:20:08", "text": "提前一周或提前一个月。我有"}, {"type": "subtitle", "time": 4812.39, "timestamp": "01:20:12", "text": "像对待一个人一样对我的……员工儿子说"}, {"type": "subtitle", "time": 4814.709, "timestamp": "01:20:14", "text": "我得私信问问是谁在帮我。"}, {"type": "subtitle", "time": 4816.709, "timestamp": "01:20:16", "text": "我会说，是的，我会直播这个"}, {"type": "subtitle", "time": 4818.95, "timestamp": "01:20:18", "text": "现在我可以预订白名单吗？"}, {"type": "subtitle", "time": 4821.669, "timestamp": "01:20:21", "text": "七八月份那样，我就是那样做的。"}, {"type": "subtitle", "time": 4824.63, "timestamp": "01:20:24", "text": "以前去年就这么做过"}, {"type": "subtitle", "time": 4828.149, "timestamp": "01:20:28", "text": "那一年我被给予了我"}, {"type": "subtitle", "time": 4830.149, "timestamp": "01:20:30", "text": "能够向 Billy Billy 直播"}, {"type": "subtitle", "time": 4831.669, "timestamp": "01:20:31", "text": "我想我第一次开始的时候"}, {"type": "subtitle", "time": 4835.11, "timestamp": "01:20:35", "text": "像二月三月那样在那里直播"}, {"type": "subtitle", "time": 4839.35, "timestamp": "01:20:39", "text": "大概是去年这个时候。"}, {"type": "subtitle", "time": 4842.709, "timestamp": "01:20:42", "text": "嗯，是的，是的，就是这样。"}, {"type": "subtitle", "time": 4844.79, "timestamp": "01:20:44", "text": "是V通道。主频道是"}, {"type": "subtitle", "time": 4849.83, "timestamp": "01:20:49", "text": "这。接下来我在这里搜索 Jockn。这"}, {"type": "subtitle", "time": 4852.63, "timestamp": "01:20:52", "text": "是主频道。"}, {"type": "subtitle", "time": 4855.51, "timestamp": "01:20:55", "text": "目前我只上传短片。而这"}, {"type": "subtitle", "time": 4857.51, "timestamp": "01:20:57", "text": "现在的情况可能是，因为它就像"}]
[{"type": "subtitle", "time": 4622.149, "timestamp": "01:17:02", "text": "标签。她做BTuber内容，对吧？"}, {"type": "subtitle", "time": 4625.03, "timestamp": "01:17:05", "text": "正常发布。她负责音乐创作。"}, {"type": "subtitle", "time": 4628.31, "timestamp": "01:17:08", "text": "东西，还有短裤。她确实有"}, {"type": "subtitle", "time": 4631.11, "timestamp": "01:17:11", "text": "原创短剧集，还有我认为的片段"}, {"type": "subtitle", "time": 4634.149, "timestamp": "01:17:14", "text": "这里没有，但更像是原版。"}, {"type": "subtitle", "time": 4636.55, "timestamp": "01:17:16", "text": "短篇系列，电视动画系列之类的"}, {"type": "subtitle", "time": 4640.79, "timestamp": "01:17:20", "text": "东西，漫画那种东西，还有"}, {"type": "subtitle", "time": 4643.189, "timestamp": "01:17:23", "text": "呃，就像模特那种类型的照片"}, {"type": "subtitle", "time": 4646.07, "timestamp": "01:17:26", "text": "这里也有那些东西。现在我看不见了"}, {"type": "subtitle", "time": 4648.63, "timestamp": "01:17:28", "text": "她在这里做直播片段，但是"}, {"type": "subtitle", "time": 4650.95, "timestamp": "01:17:30", "text": "是啊，直播片段她没做。"}, {"type": "subtitle", "time": 4653.99, "timestamp": "01:17:33", "text": "因为整个生活都充满了粉丝。"}, {"type": "subtitle", "time": 4655.75, "timestamp": "01:17:35", "text": "YouTuber剪辑器之类的东西现在他们"}, {"type": "subtitle", "time": 4657.59, "timestamp": "01:17:37", "text": "现在就去做。所以你不需要"}, {"type": "subtitle", "time": 4660.47, "timestamp": "01:17:40", "text": "这样做是为了我们的独立，我们才这样做。"}, {"type": "subtitle", "time": 4663.669, "timestamp": "01:17:43", "text": "必须以正确的方式去做，为什么？"}, {"type": "subtitle", "time": 4666.55, "timestamp": "01:17:46", "text": "要比较企业，但主要还是"}, {"type": "subtitle", "time": 4669.189, "timestamp": "01:17:49", "text": "YouTube的问题又出现了。"}, {"type": "subtitle", "time": 4672.63, "timestamp": "01:17:52", "text": "那天他们没有"}, {"type": "subtitle", "time": 4674.63, "timestamp": "01:17:54", "text": "嗯，以前他们没有……"}, {"type": "subtitle", "time": 4676.87, "timestamp": "01:17:56", "text": "像这样的发布标签或镜头推送"}, {"type": "subtitle", "time": 4679.189, "timestamp": "01:17:59", "text": "就像之前那样，而这一切都是"}]
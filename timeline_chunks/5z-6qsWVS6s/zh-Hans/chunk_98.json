[{"type": "subtitle", "time": 5880.95, "timestamp": "01:38:00", "text": "N5 所以，是的，作为对我的补偿，呃"}, {"type": "subtitle", "time": 5884.629, "timestamp": "01:38:04", "text": "我去了我家附近的一所学院。"}, {"type": "subtitle", "time": 5888.229, "timestamp": "01:38:08", "text": "城市，嗯，这就是我通过的方式。"}, {"type": "subtitle", "time": 5892.229, "timestamp": "01:38:12", "text": "考试，我还申请了，他们给了"}, {"type": "subtitle", "time": 5894.79, "timestamp": "01:38:14", "text": "因为我还在，所以会接受采访之类的。"}, {"type": "subtitle", "time": 5896.87, "timestamp": "01:38:16", "text": "我在忙着完成学位相关的工作，我没有……"}, {"type": "subtitle", "time": 5898.87, "timestamp": "01:38:18", "text": "学位对吗？所以我的发挥受到了限制。"}, {"type": "subtitle", "time": 5901.669, "timestamp": "01:38:21", "text": "在语言学校的选择"}, {"type": "subtitle", "time": 5903.83, "timestamp": "01:38:23", "text": "类似学校的机会"}, {"type": "subtitle", "time": 5905.669, "timestamp": "01:38:25", "text": "东京、大阪，所有那些地方。我"}, {"type": "subtitle", "time": 5907.99, "timestamp": "01:38:27", "text": "无法访问它们，因为那些"}, {"type": "subtitle", "time": 5912.55, "timestamp": "01:38:32", "text": "学校要求你持有N5证书。"}, {"type": "subtitle", "time": 5915.03, "timestamp": "01:38:35", "text": "既然我愿意，我就应该拿到学位证书。"}, {"type": "subtitle", "time": 5916.95, "timestamp": "01:38:36", "text": "我没有那个，而且我也打算……"}, {"type": "subtitle", "time": 5924.39, "timestamp": "01:38:44", "text": "写我的N5 JPT N5东西 N5东西。"}, {"type": "subtitle", "time": 5926.87, "timestamp": "01:38:46", "text": "所以，呃，只有一所学校，我"}, {"type": "subtitle", "time": 5931.03, "timestamp": "01:38:51", "text": "我收到了GMA的节目，幸运的是，我"}, {"type": "subtitle", "time": 5933.99, "timestamp": "01:38:53", "text": "我通过了第一轮面试。"}, {"type": "subtitle", "time": 5936.709, "timestamp": "01:38:56", "text": "首先是考试。我不得不写"}, {"type": "subtitle", "time": 5938.87, "timestamp": "01:38:58", "text": "考试地点在钦奈。有钦奈和"}]
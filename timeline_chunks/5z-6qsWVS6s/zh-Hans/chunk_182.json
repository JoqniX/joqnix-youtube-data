[{"type": "subtitle", "time": 10924.469, "timestamp": "03:02:04", "text": "天哪，我该怎么学习？"}, {"type": "subtitle", "time": 10927.59, "timestamp": "03:02:07", "text": "等等，他们知道我要做什么吗？"}, {"type": "subtitle", "time": 10931.75, "timestamp": "03:02:11", "text": "今天还是哪天，兄弟？"}, {"type": "subtitle", "time": 10934.71, "timestamp": "03:02:14", "text": "哦，是的，正如你所看到的，嗯，他们"}, {"type": "subtitle", "time": 10939.03, "timestamp": "03:02:19", "text": "比如 YouTube API 之类的东西"}, {"type": "subtitle", "time": 10943.51, "timestamp": "03:02:23", "text": "日志。哦，这是 WebSocket 吗？"}, {"type": "subtitle", "time": 10945.83, "timestamp": "03:02:25", "text": "哦，嵌入式播放器。哦，为了玩家。"}, {"type": "subtitle", "time": 10948.55, "timestamp": "03:02:28", "text": "哦，"}, {"type": "subtitle", "time": 10951.269, "timestamp": "03:02:31", "text": "是的。因为他们之间有某种联系，而你"}, {"type": "subtitle", "time": 10955.75, "timestamp": "03:02:35", "text": "就像日语里说的“不要”"}, {"type": "subtitle", "time": 10964.55, "timestamp": "03:02:44", "text": "为什么会这样？"}, {"type": "subtitle", "time": 10968.79, "timestamp": "03:02:48", "text": "我有时无法点击，请稍等，他们有……"}, {"type": "subtitle", "time": 10971.03, "timestamp": "03:02:51", "text": "写在底部的东西"}, {"type": "subtitle", "time": 10976.23, "timestamp": "03:02:56", "text": "屏幕似乎不常用"}, {"type": "subtitle", "time": 10979.349, "timestamp": "03:02:59", "text": "任何未经授权的复制文件"}]
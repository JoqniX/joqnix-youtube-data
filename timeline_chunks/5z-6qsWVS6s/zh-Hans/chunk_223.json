[{"type": "subtitle", "time": 13380.79, "timestamp": "03:43:00", "text": "当我点击时。是的。颗粒状质地。"}, {"type": "subtitle", "time": 13383.349, "timestamp": "03:43:03", "text": "我不知道该如何制作动画。"}, {"type": "subtitle", "time": 13387.59, "timestamp": "03:43:07", "text": "这？比如我去听Kamisubaki广播电台。"}, {"type": "subtitle", "time": 13392.87, "timestamp": "03:43:12", "text": "网站，对吧？上须吹"}, {"type": "subtitle", "time": 13395.67, "timestamp": "03:43:15", "text": "收音机。"}, {"type": "subtitle", "time": 13397.99, "timestamp": "03:43:17", "text": "于是我找到了Kamisubaki电台的网站。"}, {"type": "subtitle", "time": 13401.51, "timestamp": "03:43:21", "text": "你可以把它看作是“是的”。你看，就是"}, {"type": "subtitle", "time": 13409.59, "timestamp": "03:43:29", "text": "它很生动。等等，她有新的"}, {"type": "subtitle", "time": 13412.71, "timestamp": "03:43:32", "text": "现在开始广播节目。"}, {"type": "subtitle", "time": 13417.03, "timestamp": "03:43:37", "text": "哦，不错。现在你可以看到了。"}, {"type": "subtitle", "time": 13421.51, "timestamp": "03:43:41", "text": "我的意思是，动画 webp。呃，不，等等，"}, {"type": "subtitle", "time": 13423.429, "timestamp": "03:43:43", "text": "等等，等等。不，不，不。实际上"}, {"type": "subtitle", "time": 13426.469, "timestamp": "03:43:46", "text": "关键帧。关键帧已经画好了，老兄。"}, {"type": "subtitle", "time": 13429.99, "timestamp": "03:43:49", "text": "我记得我看过。"}, {"type": "subtitle", "time": 13433.99, "timestamp": "03:43:53", "text": "等等，我记得我查过这个。嗯，"}, {"type": "subtitle", "time": 13436.71, "timestamp": "03:43:56", "text": "比如……"}]
[{"type": "subtitle", "time": 2643.03, "timestamp": "00:44:03", "text": "这是对话吗？等等，我想应该是"}, {"type": "subtitle", "time": 2648.309, "timestamp": "00:44:08", "text": "等等，我该怎么才能再看到那些东西？我"}, {"type": "subtitle", "time": 2650.55, "timestamp": "00:44:10", "text": "忘了。嗯，"}, {"type": "subtitle", "time": 2655.19, "timestamp": "00:44:15", "text": "不是代码，也不是警报。嗯，"}, {"type": "subtitle", "time": 2657.349, "timestamp": "00:44:17", "text": "我觉得这像是对话之类的东西。"}, {"type": "subtitle", "time": 2660.39, "timestamp": "00:44:20", "text": "对，这是个对话功能。所以，"}, {"type": "subtitle", "time": 2664.15, "timestamp": "00:44:24", "text": "对话框，对吧？你点击它，然后"}, {"type": "subtitle", "time": 2666.23, "timestamp": "00:44:26", "text": "上面显示了这一点。所以它的作用就是填充"}, {"type": "subtitle", "time": 2671.03, "timestamp": "00:44:31", "text": "屏幕上的画面和我之前做的类似"}, {"type": "subtitle", "time": 2673.589, "timestamp": "00:44:33", "text": "哦。哦，是的。我如何处理社交"}, {"type": "subtitle", "time": 2676.79, "timestamp": "00:44:36", "text": "就是那个东西，一样的东西。它有一个 X 形关闭"}, {"type": "subtitle", "time": 2679.43, "timestamp": "00:44:39", "text": "也标记一下。"}, {"type": "subtitle", "time": 2681.67, "timestamp": "00:44:41", "text": "任何汉堡包？有汉堡包"}, {"type": "subtitle", "time": 2685.03, "timestamp": "00:44:45", "text": "预设里的汉堡包"}, {"type": "subtitle", "time": 2688.15, "timestamp": "00:44:48", "text": "适用于网络工作室。我可以用到它。哦"}, {"type": "subtitle", "time": 2690.95, "timestamp": "00:44:50", "text": "对，就像一个带关闭按钮的对话框。"}, {"type": "subtitle", "time": 2695.03, "timestamp": "00:44:55", "text": "就是那个开关按钮，对吧？所以"}, {"type": "subtitle", "time": 2697.27, "timestamp": "00:44:57", "text": "我觉得我们不需要那个关闭装置。"}]
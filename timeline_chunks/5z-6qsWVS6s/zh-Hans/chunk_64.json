[{"type": "subtitle", "time": 3840.87, "timestamp": "01:04:00", "text": "还有印度 YouTuber 上的所有人"}, {"type": "subtitle", "time": 3843.19, "timestamp": "01:04:03", "text": "社区里的人都说，哦，乔正在制作"}, {"type": "subtitle", "time": 3846.39, "timestamp": "01:04:06", "text": "他自己的虚拟直播公司之类的，但是"}, {"type": "subtitle", "time": 3849.27, "timestamp": "01:04:09", "text": "实际上我并没有那样做。"}, {"type": "subtitle", "time": 3852.069, "timestamp": "01:04:12", "text": "它不仅仅是一家虚拟主播公司，规模要大得多。"}, {"type": "subtitle", "time": 3855.19, "timestamp": "01:04:15", "text": "项目权利"}, {"type": "subtitle", "time": 3857.91, "timestamp": "01:04:17", "text": "而且在有……的地方，它很贵。"}, {"type": "subtitle", "time": 3859.99, "timestamp": "01:04:19", "text": "是的，我们有一个社区，而且我"}, {"type": "subtitle", "time": 3862.15, "timestamp": "01:04:22", "text": "我忘了跟你说了，我查过了。"}, {"type": "subtitle", "time": 3863.51, "timestamp": "01:04:23", "text": "你的个人资料"}, {"type": "subtitle", "time": 3865.109, "timestamp": "01:04:25", "text": "我意识到你是印度人。"}, {"type": "subtitle", "time": 3870.069, "timestamp": "01:04:30", "text": "也是个油管博主。喵，儿子。是的，我们"}, {"type": "subtitle", "time": 3873.51, "timestamp": "01:04:33", "text": "拥有超过200名YouTube用户，"}, {"type": "subtitle", "time": 3876.71, "timestamp": "01:04:36", "text": "东西。我目前是一名 YouTuber。他们"}, {"type": "subtitle", "time": 3878.789, "timestamp": "01:04:38", "text": "既有企业 YouTuber，也有独立 YouTuber。"}, {"type": "subtitle", "time": 3881.349, "timestamp": "01:04:41", "text": "YouTube 用户也包括在内。"}, {"type": "subtitle", "time": 3885.27, "timestamp": "01:04:45", "text": "是的。是的。太多事情了。欢迎。"}, {"type": "subtitle", "time": 3888.87, "timestamp": "01:04:48", "text": "BBC也有一篇文章报道。如果你"}, {"type": "subtitle", "time": 3892.15, "timestamp": "01:04:52", "text": "各位，你们看，BBC 有一篇关于我们的文章。"}, {"type": "subtitle", "time": 3893.829, "timestamp": "01:04:53", "text": "你可以在前线看到我。"}, {"type": "subtitle", "time": 3896.87, "timestamp": "01:04:56", "text": "这就是我。但是，这篇文章确实提到了……"}]
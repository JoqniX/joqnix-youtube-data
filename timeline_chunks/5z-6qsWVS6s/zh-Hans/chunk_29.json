[{"type": "subtitle", "time": 1742.149, "timestamp": "00:29:02", "text": "目前在日本柴郡，它是云。"}, {"type": "subtitle", "time": 1744.789, "timestamp": "00:29:04", "text": "呃，就像之前正常的天气一样"}, {"type": "subtitle", "time": 1748.149, "timestamp": "00:29:08", "text": "下雨的时候，呃，我们"}, {"type": "subtitle", "time": 1751.99, "timestamp": "00:29:11", "text": "看到这个背景有雨水。"}, {"type": "subtitle", "time": 1755.029, "timestamp": "00:29:15", "text": "Ruka 的一个人带着行李袋来了。"}, {"type": "subtitle", "time": 1757.35, "timestamp": "00:29:17", "text": "我觉得它是基于……"}, {"type": "subtitle", "time": 1760.149, "timestamp": "00:29:20", "text": "官方音乐视频，他们是"}, {"type": "subtitle", "time": 1765.11, "timestamp": "00:29:25", "text": "他们发布的封面东西。所以这个"}, {"type": "subtitle", "time": 1768.549, "timestamp": "00:29:28", "text": "就是这样，就是这样，就是这样，"}, {"type": "subtitle", "time": 1770.71, "timestamp": "00:29:30", "text": "早上"}, {"type": "subtitle", "time": 1773.029, "timestamp": "00:29:33", "text": "在柴犬，就像明天，就像当你看到它一样"}, {"type": "subtitle", "time": 1774.87, "timestamp": "00:29:34", "text": "比如早上7点左右。"}, {"type": "subtitle", "time": 1779.19, "timestamp": "00:29:39", "text": "早上6点你会看到她，我忘了她了。"}, {"type": "subtitle", "time": 1781.75, "timestamp": "00:29:41", "text": "名字已定。哦，所以会是晴天。如果"}, {"type": "subtitle", "time": 1784.07, "timestamp": "00:29:44", "text": "下雨了，会有雨天的东西。"}, {"type": "subtitle", "time": 1787.029, "timestamp": "00:29:47", "text": "你可以看到下雨了。所以从某种意义上说"}, {"type": "subtitle", "time": 1789.83, "timestamp": "00:29:49", "text": "仔细想想，这就像"}, {"type": "subtitle", "time": 1792.87, "timestamp": "00:29:52", "text": "动态浅色模式和深色模式之类的"}, {"type": "subtitle", "time": 1795.11, "timestamp": "00:29:55", "text": "从某种意义上说，如果你仔细想想，这事儿是对的。"}, {"type": "subtitle", "time": 1798.95, "timestamp": "00:29:58", "text": "没错，所以我就想，啊，我该怎么办？"}]
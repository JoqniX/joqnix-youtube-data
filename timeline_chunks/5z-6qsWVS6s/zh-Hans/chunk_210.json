[{"type": "subtitle", "time": 12600.389, "timestamp": "03:30:00", "text": "您可以使用网络剧内置的筛选器。"}, {"type": "subtitle", "time": 12603.51, "timestamp": "03:30:03", "text": "好的。他们带来的渐变等待"}, {"type": "subtitle", "time": 12605.91, "timestamp": "03:30:05", "text": "让我看看那个网络工作室。"}, {"type": "subtitle", "time": 12612.469, "timestamp": "03:30:12", "text": "我认为它们会有一个渐变色。"}, {"type": "subtitle", "time": 12617.11, "timestamp": "03:30:17", "text": "滑块。他们正在谈论这件事。"}, {"type": "subtitle", "time": 12619.67, "timestamp": "03:30:19", "text": "如果我没记错的话。"}, {"type": "subtitle", "time": 12630.95, "timestamp": "03:30:30", "text": "他们在谈论这件事。嗯"}, {"type": "subtitle", "time": 12633.91, "timestamp": "03:30:33", "text": "他们正在讨论我是否"}, {"type": "subtitle", "time": 12647.51, "timestamp": "03:30:47", "text": "[音乐]"}, {"type": "subtitle", "time": 12654.79, "timestamp": "03:30:54", "text": "我认为它在建筑设计渐变中。"}, {"type": "subtitle", "time": 12657.11, "timestamp": "03:30:57", "text": "坡度"}, {"type": "subtitle", "time": 12659.75, "timestamp": "03:30:59", "text": "地方风格"}]
[{"type": "subtitle", "time": 64.149, "timestamp": "00:01:04", "text": "呃，在我的直播办公室里。嗯，所以"}, {"type": "subtitle", "time": 68.07, "timestamp": "00:01:08", "text": "我可以把它展示出来。所以，我是个正经人"}, {"type": "subtitle", "time": 70.07, "timestamp": "00:01:10", "text": "生意、我的工作以及所有的一切"}, {"type": "subtitle", "time": 72.23, "timestamp": "00:01:12", "text": "他们过来是为了让我能拿到那些东西。"}, {"type": "subtitle", "time": 74.149, "timestamp": "00:01:14", "text": "已整理。"}, {"type": "subtitle", "time": 76.71000000000001, "timestamp": "00:01:16", "text": "昨天我们也……呃，对于那些……的人来说"}, {"type": "subtitle", "time": 80.07, "timestamp": "00:01:20", "text": "昨天错过了115期直播"}, {"type": "subtitle", "time": 83.91, "timestamp": "00:01:23", "text": "我们在此基础上对叠加层进行了一些更新。"}, {"type": "subtitle", "time": 86.469, "timestamp": "00:01:26", "text": "屏幕上可以看到“直播”按钮"}, {"type": "subtitle", "time": 89.429, "timestamp": "00:01:29", "text": "现在显示红色表示我在线。"}, {"type": "subtitle", "time": 91.67, "timestamp": "00:01:31", "text": "它将适用于移动流媒体。"}, {"type": "subtitle", "time": 94.95, "timestamp": "00:01:34", "text": "绿色，看着我什么时候会这样"}, {"type": "subtitle", "time": 97.50999999999999, "timestamp": "00:01:37", "text": "演奏时会是通常的紫色"}, {"type": "subtitle", "time": 101.91, "timestamp": "00:01:41", "text": "所以我们更新了那个东西。"}, {"type": "subtitle", "time": 112.469, "timestamp": "00:01:52", "text": "呃，还有，呃，我们更新了我们的……"}, {"type": "subtitle", "time": 115.27000000000001, "timestamp": "00:01:55", "text": "我没记错，我们更新了活动数据。"}, {"type": "subtitle", "time": 118.31, "timestamp": "00:01:58", "text": "主题状态以及哪个是哪个将"}]
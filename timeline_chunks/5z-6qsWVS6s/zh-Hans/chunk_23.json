[{"type": "subtitle", "time": 1382.07, "timestamp": "00:23:02", "text": "太酷了。就像一起看电影一样"}, {"type": "subtitle", "time": 1384.95, "timestamp": "00:23:04", "text": "甚至还有人在这里。兄弟，等等。这是什么？"}, {"type": "subtitle", "time": 1387.59, "timestamp": "00:23:07", "text": "动漫相关的？"}, {"type": "subtitle", "time": 1389.909, "timestamp": "00:23:09", "text": "等等，稍等。这就是我想的那样吗？"}, {"type": "subtitle", "time": 1396.789, "timestamp": "00:23:16", "text": "日历订阅"}, {"type": "subtitle", "time": 1399.029, "timestamp": "00:23:19", "text": "公司。"}, {"type": "subtitle", "time": 1400.95, "timestamp": "00:23:20", "text": "没有把握。"}, {"type": "subtitle", "time": 1403.029, "timestamp": "00:23:23", "text": "嗯"}, {"type": "subtitle", "time": 1407.99, "timestamp": "00:23:27", "text": "我觉得，嗯，我觉得她不是个混蛋"}, {"type": "subtitle", "time": 1411.35, "timestamp": "00:23:31", "text": "牛奶。我猜她不是公司职员。没有把握。"}, {"type": "subtitle", "time": 1414.31, "timestamp": "00:23:34", "text": "我忘了。"}, {"type": "subtitle", "time": 1416.63, "timestamp": "00:23:36", "text": "他们现在有了自己的开发团队。他们"}, {"type": "subtitle", "time": 1419.11, "timestamp": "00:23:39", "text": "是他们让拉普拉斯活了下来。"}, {"type": "subtitle", "time": 1422.63, "timestamp": "00:23:42", "text": "在线聊天之类的东西。无需笔记本电脑的聊天。"}, {"type": "subtitle", "time": 1425.35, "timestamp": "00:23:45", "text": "labless.live"}, {"type": "subtitle", "time": 1431.43, "timestamp": "00:23:51", "text": "chat.lapless 直播 我不是这个。"}, {"type": "subtitle", "time": 1434.23, "timestamp": "00:23:54", "text": "是他们干的。嗯"}, {"type": "subtitle", "time": 1436.39, "timestamp": "00:23:56", "text": "这是我以前用来对付比利的。"}, {"type": "subtitle", "time": 1438.789, "timestamp": "00:23:58", "text": "比利，当时我正在那里直播"}]
[{"type": "subtitle", "time": 10880.79, "timestamp": "03:01:20", "text": "等一下。他们有这样一件事"}, {"type": "subtitle", "time": 10883.67, "timestamp": "03:01:23", "text": "挡住你的视线了，兄弟。"}, {"type": "subtitle", "time": 10885.269, "timestamp": "03:01:25", "text": "什么？"}, {"type": "subtitle", "time": 10891.19, "timestamp": "03:01:31", "text": "他们有某种东西可以阻止你"}, {"type": "subtitle", "time": 10893.91, "timestamp": "03:01:33", "text": "使用。"}, {"type": "subtitle", "time": 10897.91, "timestamp": "03:01:37", "text": "等等，什么？你能做到吗？"}, {"type": "subtitle", "time": 10899.429, "timestamp": "03:01:39", "text": "等等，不，不，不，等等。让我查一下"}, {"type": "subtitle", "time": 10901.99, "timestamp": "03:01:41", "text": "其他网站。哦，我可以悬停在上面"}, {"type": "subtitle", "time": 10905.269, "timestamp": "03:01:45", "text": "这。等等，他们知道有人要去"}, {"type": "subtitle", "time": 10910.309, "timestamp": "03:01:50", "text": "进行光天化日之下的抢劫。什么？"}]
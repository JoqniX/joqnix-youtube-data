[{"type": "subtitle", "time": 4442.39, "timestamp": "01:14:02", "text": "除非我有高质量的图片，否则请上传"}, {"type": "subtitle", "time": 4446.47, "timestamp": "01:14:06", "text": "内容之类的，因为我以前喜欢……"}, {"type": "subtitle", "time": 4449.03, "timestamp": "01:14:09", "text": "对自己进行过多的批判性批评"}, {"type": "subtitle", "time": 4453.59, "timestamp": "01:14:13", "text": "我内心深处其实是这么想的，但并非如此。"}, {"type": "subtitle", "time": 4455.669, "timestamp": "01:14:15", "text": "对大部分东西都很满意。"}, {"type": "subtitle", "time": 4458.63, "timestamp": "01:14:18", "text": "就像问题和类似的事情一样"}, {"type": "subtitle", "time": 4460.95, "timestamp": "01:14:20", "text": "溪流那边有很多虫子之类的东西"}, {"type": "subtitle", "time": 4464.55, "timestamp": "01:14:24", "text": "打破常规，我看着你呢，萨米的东西"}, {"type": "subtitle", "time": 4468.07, "timestamp": "01:14:28", "text": "就呈现质量而言，打破常规"}, {"type": "subtitle", "time": 4469.99, "timestamp": "01:14:29", "text": "生产方面的东西等等，太多了。"}, {"type": "subtitle", "time": 4472.07, "timestamp": "01:14:32", "text": "这里有些事你现在必须做，所以我当时"}, {"type": "subtitle", "time": 4474.63, "timestamp": "01:14:34", "text": "我以前对这方面很挑剔，但自从我开始……"}, {"type": "subtitle", "time": 4476.87, "timestamp": "01:14:36", "text": "因为我有一个Joathon活动，所以我要参加。"}, {"type": "subtitle", "time": 4479.91, "timestamp": "01:14:39", "text": "即将推出的新车型也是"}, {"type": "subtitle", "time": 4482.79, "timestamp": "01:14:42", "text": "另一种令人头疼的麻烦事是……"}, {"type": "subtitle", "time": 4485.99, "timestamp": "01:14:45", "text": "就像这个模型给出的那种信息一样"}, {"type": "subtitle", "time": 4489.83, "timestamp": "01:14:49", "text": "这种质量水平更高"}, {"type": "subtitle", "time": 4493.03, "timestamp": "01:14:53", "text": "期望等级和标准。嗯？"}, {"type": "subtitle", "time": 4495.35, "timestamp": "01:14:55", "text": "因为商场演出有"}, {"type": "subtitle", "time": 4497.91, "timestamp": "01:14:57", "text": "更高的期望和标准"}]
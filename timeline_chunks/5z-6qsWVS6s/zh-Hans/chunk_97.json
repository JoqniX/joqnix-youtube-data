[{"type": "subtitle", "time": 5820.229, "timestamp": "01:37:00", "text": "然后我得知我的东西出了问题。"}, {"type": "subtitle", "time": 5822.79, "timestamp": "01:37:02", "text": "然后我感觉就像……"}, {"type": "subtitle", "time": 5826.79, "timestamp": "01:37:06", "text": "很多人，嗯，呃，那些做不到的人"}, {"type": "subtitle", "time": 5828.47, "timestamp": "01:37:08", "text": "制作它，以及那些想要制作它的人"}, {"type": "subtitle", "time": 5830.709, "timestamp": "01:37:10", "text": "重新安排等等。所以我就想"}, {"type": "subtitle", "time": 5833.59, "timestamp": "01:37:13", "text": "是的，我的项目延期了，所以我们可以"}, {"type": "subtitle", "time": 5836.229, "timestamp": "01:37:16", "text": "也可以稍后再做。我联系了"}, {"type": "subtitle", "time": 5839.35, "timestamp": "01:37:19", "text": "我想大概有200多人吧。是的"}, {"type": "subtitle", "time": 5841.51, "timestamp": "01:37:21", "text": "这些人就像待定人员。我认为"}, {"type": "subtitle", "time": 5844.629, "timestamp": "01:37:24", "text": "我仍然可以像以前一样与他们合作"}, {"type": "subtitle", "time": 5847.83, "timestamp": "01:37:27", "text": "就快了。我想是因为我现在拥有更多"}, {"type": "subtitle", "time": 5850.79, "timestamp": "01:37:30", "text": "时间。不，有些人还没有。"}, {"type": "subtitle", "time": 5853.03, "timestamp": "01:37:33", "text": "目前尚未对此作出回应。我认为五"}, {"type": "subtitle", "time": 5856.149, "timestamp": "01:37:36", "text": "人们愿意这样做。所以我需要"}, {"type": "subtitle", "time": 5858.149, "timestamp": "01:37:38", "text": "放在这里。"}, {"type": "subtitle", "time": 5861.189, "timestamp": "01:37:41", "text": "是的，我会在那里学习日语。"}, {"type": "subtitle", "time": 5865.109, "timestamp": "01:37:45", "text": "目前我的级别是N5。我通过了N5考试。"}, {"type": "subtitle", "time": 5867.99, "timestamp": "01:37:47", "text": "我参加了NAT考试。"}, {"type": "subtitle", "time": 5872.149, "timestamp": "01:37:52", "text": "呃，不是NAT，呃，我参加了NAT考试。"}, {"type": "subtitle", "time": 5875.91, "timestamp": "01:37:55", "text": "那是Q5，相当于N5 JPT。"}]
[{"type": "subtitle", "time": 3721.589, "timestamp": "01:02:01", "text": "真的很好，我看到了一些精彩瞬间。"}, {"type": "subtitle", "time": 3724.309, "timestamp": "01:02:04", "text": "来自 Kas Cuff 的现场演唱会"}, {"type": "subtitle", "time": 3727.51, "timestamp": "01:02:07", "text": "出色地。一些，呃，一些风景"}, {"type": "subtitle", "time": 3730.39, "timestamp": "01:02:10", "text": "他们在3D CGI技术中加入了"}, {"type": "subtitle", "time": 3734.549, "timestamp": "01:02:14", "text": "在日本举办演唱会，或者像武道会之类的。"}, {"type": "subtitle", "time": 3737.589, "timestamp": "01:02:17", "text": "某物。我认为它在“如果”那里。"}, {"type": "subtitle", "time": 3741.829, "timestamp": "01:02:21", "text": "你去咳嗽，然后去YouTube。它在她里面……"}, {"type": "subtitle", "time": 3744.309, "timestamp": "01:02:24", "text": "在她的其中一本里。"}, {"type": "subtitle", "time": 3747.51, "timestamp": "01:02:27", "text": "我想应该是在其中一场演唱会上。"}, {"type": "subtitle", "time": 3749.67, "timestamp": "01:02:29", "text": "可以找到。"}, {"type": "subtitle", "time": 3752.47, "timestamp": "01:02:32", "text": "嗯，是的，一些演唱会展示"}, {"type": "subtitle", "time": 3754.789, "timestamp": "01:02:34", "text": "世界是如何被摧毁的，以及"}, {"type": "subtitle", "time": 3756.789, "timestamp": "01:02:36", "text": "诸如此类的东西和演员"}, {"type": "subtitle", "time": 3758.789, "timestamp": "01:02:38", "text": "唱着歌，唱着歌，控诉腐败"}, {"type": "subtitle", "time": 3762.069, "timestamp": "01:02:42", "text": "世界以及诸如此类的一切。所以"}, {"type": "subtitle", "time": 3763.91, "timestamp": "01:02:43", "text": "有点像那样，你会得到某种感觉"}, {"type": "subtitle", "time": 3765.91, "timestamp": "01:02:45", "text": "变得像很多理论和复杂的东西。"}, {"type": "subtitle", "time": 3768.47, "timestamp": "01:02:48", "text": "东西现在都在那里了。所以，我也是一样。"}, {"type": "subtitle", "time": 3772.069, "timestamp": "01:02:52", "text": "我也希望自己能拥有我想要的那种感觉。"}, {"type": "subtitle", "time": 3777.19, "timestamp": "01:02:57", "text": "比如，做同样的事情"}]
[{"type": "subtitle", "time": 5343.83, "timestamp": "01:29:03", "text": "呃，比如游戏内聊天、游戏内击杀信息"}, {"type": "subtitle", "time": 5345.99, "timestamp": "01:29:05", "text": "在右上角。你需要把它模糊处理。"}, {"type": "subtitle", "time": 5348.07, "timestamp": "01:29:08", "text": "出去。你必须在主播板上。"}, {"type": "subtitle", "time": 5350.79, "timestamp": "01:29:10", "text": "你不应该透露你的姓名"}, {"type": "subtitle", "time": 5353.99, "timestamp": "01:29:13", "text": "队友之类的，还有你的名字。所以"}, {"type": "subtitle", "time": 5356.709, "timestamp": "01:29:16", "text": "许多限制导致我无法和你一起玩"}, {"type": "subtitle", "time": 5359.11, "timestamp": "01:29:19", "text": "包含暴力内容的游戏"}, {"type": "subtitle", "time": 5362.31, "timestamp": "01:29:22", "text": "像GTA之类的血腥暴力游戏。我趁"}, {"type": "subtitle", "time": 5364.229, "timestamp": "01:29:24", "text": "在 Joathon 期间，我正在做"}, {"type": "subtitle", "time": 5367.59, "timestamp": "01:29:27", "text": "我当时正在森林里散步"}, {"type": "subtitle", "time": 5370.629, "timestamp": "01:29:30", "text": "呃，和几位INV YouTuber合作直播。"}, {"type": "subtitle", "time": 5376.47, "timestamp": "01:29:36", "text": "现在我把那件事忘了，呃，还有我"}, {"type": "subtitle", "time": 5380.31, "timestamp": "01:29:40", "text": "我当时盲目地看视频，结果就出现了这种情况。"}, {"type": "subtitle", "time": 5384.629, "timestamp": "01:29:44", "text": "兄弟，我好像因为性骚扰被罚了。"}, {"type": "subtitle", "time": 5387.91, "timestamp": "01:29:47", "text": "因为森林里的NPC们"}, {"type": "subtitle", "time": 5390.55, "timestamp": "01:29:50", "text": "一丝不挂之类的。不，当时有我"}, {"type": "subtitle", "time": 5393.99, "timestamp": "01:29:53", "text": "我记得里面好像有个女性NPC。所以"}, {"type": "subtitle", "time": 5396.95, "timestamp": "01:29:56", "text": "像女性的东西。所以这有点像"}]
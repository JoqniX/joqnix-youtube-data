[{"type": "subtitle", "time": 10141.269, "timestamp": "02:49:01", "text": "或者每次有活动时都会发生类似的事情"}, {"type": "subtitle", "time": 10143.349, "timestamp": "02:49:03", "text": "呃，我觉得他们用的是 WebSocket 或者"}, {"type": "subtitle", "time": 10146.07, "timestamp": "02:49:06", "text": "确实，它会更新，伙计们。"}, {"type": "subtitle", "time": 10149.51, "timestamp": "02:49:09", "text": "时间显示直播何时开始"}, {"type": "subtitle", "time": 10151.91, "timestamp": "02:49:11", "text": "流媒体就是一切。最后一个"}, {"type": "subtitle", "time": 10155.75, "timestamp": "02:49:15", "text": "永远都会像推特一样。"}, {"type": "subtitle", "time": 10160.07, "timestamp": "02:49:20", "text": "他们也会有推特账号。"}, {"type": "subtitle", "time": 10166.55, "timestamp": "02:49:26", "text": "对，就是这种东西。"}, {"type": "subtitle", "time": 10168.87, "timestamp": "02:49:28", "text": "我因此受到了启发。我当时就想，"}, {"type": "subtitle", "time": 10171.349, "timestamp": "02:49:31", "text": "“哦，在YouTube上我可以这么做。”然后我"}, {"type": "subtitle", "time": 10175.11, "timestamp": "02:49:35", "text": "意识到他们这样做是为了 Twitch。他们确实如此"}, {"type": "subtitle", "time": 10178.23, "timestamp": "02:49:38", "text": "它适用于 Twitch 和 Twitter 平台，并且"}, {"type": "subtitle", "time": 10180.389, "timestamp": "02:49:40", "text": "Twitch直播。我三个都在场。"}, {"type": "subtitle", "time": 10183.269, "timestamp": "02:49:43", "text": "他们中的。我也想要那个。甚至"}, {"type": "subtitle", "time": 10187.269, "timestamp": "02:49:47", "text": "比利也是。如果你去北爱尔兰"}, {"type": "subtitle", "time": 10189.83, "timestamp": "02:49:49", "text": "山治粉丝服务器，"}, {"type": "subtitle", "time": 10192.309, "timestamp": "02:49:52", "text": "他们做的是同样的事情。就像看到比利"}, {"type": "subtitle", "time": 10196.15, "timestamp": "02:49:56", "text": "比利，他们有 HSL，呃，HLS HLS"}, {"type": "subtitle", "time": 10198.55, "timestamp": "02:49:58", "text": "点击链接即可复制并播放"}]
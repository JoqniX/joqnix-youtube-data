[{"type": "subtitle", "time": 8760.95, "timestamp": "02:26:00", "text": "我买的那个叫Vio扩展程序。"}, {"type": "subtitle", "time": 8764.309, "timestamp": "02:26:04", "text": "扩展功能可以让你拥有更多东西。"}, {"type": "subtitle", "time": 8770.71, "timestamp": "02:26:10", "text": "是的，我有ABC D高保真音响和高保真音响。"}, {"type": "subtitle", "time": 8774.23, "timestamp": "02:26:14", "text": "还有普通的有线电视，就像ABC电视台那样。"}, {"type": "subtitle", "time": 8778.79, "timestamp": "02:26:18", "text": "D 高保真音响和普通有线电视 所以，七个"}, {"type": "subtitle", "time": 8782.79, "timestamp": "02:26:22", "text": "七根VB虚拟电缆之类的东西，但是"}, {"type": "subtitle", "time": 8785.91, "timestamp": "02:26:25", "text": "它们都用于我的背部。嗯，"}, {"type": "subtitle", "time": 8788.79, "timestamp": "02:26:28", "text": "之前我用的是双PC配置，所以我设置了"}, {"type": "subtitle", "time": 8793.51, "timestamp": "02:26:33", "text": "把我的Vband装备升级到……嗯，所以这就是这个"}, {"type": "subtitle", "time": 8796.71, "timestamp": "02:26:36", "text": "这应该是我的直播电脑。所以，"}, {"type": "subtitle", "time": 8798.79, "timestamp": "02:26:38", "text": "输入流本应像这样"}, {"type": "subtitle", "time": 8801.67, "timestamp": "02:26:41", "text": "我的游戏电脑，包括音频等等，都很好。"}, {"type": "subtitle", "time": 8803.91, "timestamp": "02:26:43", "text": "通过发送，我发送我的 OBS、麦克风、"}, {"type": "subtitle", "time": 8806.71, "timestamp": "02:26:46", "text": "一切。一切。我的主力电脑，游戏"}, {"type": "subtitle", "time": 8810.23, "timestamp": "02:26:50", "text": "电脑坏了。 CPU彻底坏掉了。"}, {"type": "subtitle", "time": 8815.349, "timestamp": "02:26:55", "text": "显卡2060坏了。 CPU是AMD Ryzen 7"}]
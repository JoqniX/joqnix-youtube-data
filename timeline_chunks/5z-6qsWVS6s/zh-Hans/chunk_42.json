[{"type": "subtitle", "time": 2521.349, "timestamp": "00:42:01", "text": "一切"}, {"type": "subtitle", "time": 2526.15, "timestamp": "00:42:06", "text": "嗯，所有这些事情都将在未来发生。所以对于"}, {"type": "subtitle", "time": 2527.75, "timestamp": "00:42:07", "text": "背景颜色等等现在我"}, {"type": "subtitle", "time": 2530.71, "timestamp": "00:42:10", "text": "可以动态地改变这一点"}, {"type": "subtitle", "time": 2532.79, "timestamp": "00:42:12", "text": "到"}, {"type": "subtitle", "time": 2535.349, "timestamp": "00:42:15", "text": "大概是个地方，绝对不是讽刺。"}, {"type": "subtitle", "time": 2538.63, "timestamp": "00:42:18", "text": "我去了简·坦普尔，简·坦普尔"}, {"type": "subtitle", "time": 2541.03, "timestamp": "00:42:21", "text": "哪里是"}, {"type": "subtitle", "time": 2551.03, "timestamp": "00:42:31", "text": "哦，我刚才真的把自己框起来了。"}, {"type": "subtitle", "time": 2555.109, "timestamp": "00:42:35", "text": "兄弟，好吧，我不那样做了。"}, {"type": "subtitle", "time": 2558.47, "timestamp": "00:42:38", "text": "那它在哪儿？"}, {"type": "subtitle", "time": 2561.51, "timestamp": "00:42:41", "text": "简·坦普尔·瑟是一处礼拜场所"}, {"type": "subtitle", "time": 2567.27, "timestamp": "00:42:47", "text": "给简。詹索姆之父。哦好的。"}, {"type": "subtitle", "time": 2570.71, "timestamp": "00:42:50", "text": "幸好我拖延了时间。我的天啊。我"}, {"type": "subtitle", "time": 2573.109, "timestamp": "00:42:53", "text": "字面上地"}, {"type": "subtitle", "time": 2575.829, "timestamp": "00:42:55", "text": "我的天啊。谷歌可能"}, {"type": "subtitle", "time": 2577.99, "timestamp": "00:42:57", "text": "不，不，不。"}]
[{"type": "subtitle", "time": 840.15, "timestamp": "00:14:00", "text": "基础设施等等很多"}, {"type": "subtitle", "time": 843.269, "timestamp": "00:14:03", "text": "事情进展顺利，很多事情都这样处理过。"}, {"type": "subtitle", "time": 848.15, "timestamp": "00:14:08", "text": "成为 Onexia 的呃……嗯"}, {"type": "subtitle", "time": 851.509, "timestamp": "00:14:11", "text": "我做的一个 Onexia，就像一个选择器，它是"}, {"type": "subtitle", "time": 855.189, "timestamp": "00:14:15", "text": "目前还没有反应，它坏得太厉害了。"}, {"type": "subtitle", "time": 857.509, "timestamp": "00:14:17", "text": "你可以看到文本被破坏了。"}, {"type": "subtitle", "time": 860.629, "timestamp": "00:14:20", "text": "一切都糟透了，但是，是的，我做到了。"}, {"type": "subtitle", "time": 863.75, "timestamp": "00:14:23", "text": "呃，响应式设计，这样人们就可以选择哪个"}, {"type": "subtitle", "time": 866.87, "timestamp": "00:14:26", "text": "像 jockn 那样的一个你可以重定向"}, {"type": "subtitle", "time": 868.629, "timestamp": "00:14:28", "text": "转到 jocknik 的页面，或者您可以重定向"}, {"type": "subtitle", "time": 872.069, "timestamp": "00:14:32", "text": "致 Onexia One One 这"}, {"type": "subtitle", "time": 874.949, "timestamp": "00:14:34", "text": "目前已有存档通知，但"}, {"type": "subtitle", "time": 878.629, "timestamp": "00:14:38", "text": "是的，它是中文和日文的。"}, {"type": "subtitle", "time": 881.99, "timestamp": "00:14:41", "text": "还有那件事，我也得手动操作。"}, {"type": "subtitle", "time": 886.949, "timestamp": "00:14:46", "text": "把它写进“在 Notation 中这样做”里"}, {"type": "subtitle", "time": 889.75, "timestamp": "00:14:49", "text": "就像这里你看到的直播标题 CN"}, {"type": "subtitle", "time": 892.15, "timestamp": "00:14:52", "text": "街头标题 JP"}, {"type": "subtitle", "time": 894.55, "timestamp": "00:14:54", "text": "很多事情"}, {"type": "subtitle", "time": 898.31, "timestamp": "00:14:58", "text": "你有两个模型，呃，我有一个直播。"}]
[{"type": "subtitle", "time": 961.749, "timestamp": "00:16:01", "text": "我的网站也是。这就是我"}, {"type": "subtitle", "time": 964.949, "timestamp": "00:16:04", "text": "计划为"}, {"type": "subtitle", "time": 968.389, "timestamp": "00:16:08", "text": "活动/jathon"}, {"type": "subtitle", "time": 969.91, "timestamp": "00:16:09", "text": "2025年。"}, {"type": "subtitle", "time": 973.189, "timestamp": "00:16:13", "text": "我暂时就写这个吧。"}, {"type": "subtitle", "time": 976.31, "timestamp": "00:16:16", "text": "但我计划放一个完整的"}, {"type": "subtitle", "time": 980.31, "timestamp": "00:16:20", "text": "事件时间线。我注意到这一点了。"}, {"type": "subtitle", "time": 984.55, "timestamp": "00:16:24", "text": "小腿那玩意儿。呃，不是咳嗽一声。是吗？"}, {"type": "subtitle", "time": 987.749, "timestamp": "00:16:27", "text": "打电话？我不知道。我注意到它"}, {"type": "subtitle", "time": 990.15, "timestamp": "00:16:30", "text": "女孩们"}, {"type": "subtitle", "time": 994.069, "timestamp": "00:16:34", "text": "革命项目.jp。"}, {"type": "subtitle", "time": 997.11, "timestamp": "00:16:37", "text": "我在《幽灵革命》那玩意儿里注意到"}, {"type": "subtitle", "time": 1001.189, "timestamp": "00:16:41", "text": "他们就像……他们这样放了"}, {"type": "subtitle", "time": 1003.59, "timestamp": "00:16:43", "text": "这还挺酷的。"}, {"type": "subtitle", "time": 1006.389, "timestamp": "00:16:46", "text": "呃，不是，不是这个。只有一个"}, {"type": "subtitle", "time": 1010.87, "timestamp": "00:16:50", "text": "我觉得他们好像有个时间表。"}, {"type": "subtitle", "time": 1013.35, "timestamp": "00:16:53", "text": "它不在这里吗？哦等等，也许它就在里面"}, {"type": "subtitle", "time": 1015.509, "timestamp": "00:16:55", "text": "C 网站。"}]
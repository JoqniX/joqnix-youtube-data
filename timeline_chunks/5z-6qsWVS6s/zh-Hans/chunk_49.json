[{"type": "subtitle", "time": 2942.87, "timestamp": "00:49:02", "text": "起床啦，闹钟响了。"}, {"type": "subtitle", "time": 2945.19, "timestamp": "00:49:05", "text": "一旦警报响起，如果我连接"}, {"type": "subtitle", "time": 2948.15, "timestamp": "00:49:08", "text": "就像谷歌的警报一样，对吧？"}, {"type": "subtitle", "time": 2950.79, "timestamp": "00:49:10", "text": "它会发送一个活动状态。"}, {"type": "subtitle", "time": 2953.03, "timestamp": "00:49:13", "text": "乔克的闹钟响了"}, {"type": "subtitle", "time": 2955.75, "timestamp": "00:49:15", "text": "还有一些其他的东西。如果我忽略它，它就会发送"}, {"type": "subtitle", "time": 2959.19, "timestamp": "00:49:19", "text": "另一个请求，比如乔醒了，或者"}, {"type": "subtitle", "time": 2962.549, "timestamp": "00:49:22", "text": "某物。如果我把它关掉，Jock就想……"}, {"type": "subtitle", "time": 2964.79, "timestamp": "00:49:24", "text": "再睡一会儿吧。那样"}, {"type": "subtitle", "time": 2968.63, "timestamp": "00:49:28", "text": "活动饲料。你明白我的意思吗？"}, {"type": "subtitle", "time": 2971.67, "timestamp": "00:49:31", "text": "太过分了。但它能给你带来那种感觉"}, {"type": "subtitle", "time": 2973.91, "timestamp": "00:49:33", "text": "角色沉浸感，"}, {"type": "subtitle", "time": 2976.71, "timestamp": "00:49:36", "text": "正确的？你这是怎么了？就像你"}, {"type": "subtitle", "time": 2978.549, "timestamp": "00:49:38", "text": "像这样思考你的"}, {"type": "subtitle", "time": 2980.95, "timestamp": "00:49:40", "text": "最喜欢的动漫角色或最喜欢的"}, {"type": "subtitle", "time": 2983.27, "timestamp": "00:49:43", "text": "游戏角色。你想知道什么"}, {"type": "subtitle", "time": 2985.67, "timestamp": "00:49:45", "text": "你的游戏角色或动漫角色"}, {"type": "subtitle", "time": 2989.67, "timestamp": "00:49:49", "text": "正在做。你虚构的……老婆或"}, {"type": "subtitle", "time": 2991.75, "timestamp": "00:49:51", "text": "丈夫，或者他们叫你老公"}, {"type": "subtitle", "time": 2994.549, "timestamp": "00:49:54", "text": "或者你妻子正在做的，对吧？你检查一下"}, {"type": "subtitle", "time": 2997.51, "timestamp": "00:49:57", "text": "关于他们的活动等等等等，"}]
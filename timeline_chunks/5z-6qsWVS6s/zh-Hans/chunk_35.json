[{"type": "subtitle", "time": 2102.95, "timestamp": "00:35:02", "text": "嗯，哪里？是的，我想它在……"}, {"type": "subtitle", "time": 2105.43, "timestamp": "00:35:05", "text": "运动网站也切换到雨天"}, {"type": "subtitle", "time": 2108.39, "timestamp": "00:35:08", "text": "如果下雨的话，网络可能会出现问题，是的。"}, {"type": "subtitle", "time": 2111.67, "timestamp": "00:35:11", "text": "太酷了，我喜欢，我想做……"}, {"type": "subtitle", "time": 2116.23, "timestamp": "00:35:16", "text": "同样的事情，呃，但是我的呃，就像印度人一样。"}, {"type": "subtitle", "time": 2118.79, "timestamp": "00:35:18", "text": "时区相关的东西。"}, {"type": "subtitle", "time": 2120.87, "timestamp": "00:35:20", "text": "所以如果我没理解错的话，它应该在一"}, {"type": "subtitle", "time": 2123.75, "timestamp": "00:35:23", "text": "旧页面"}, {"type": "subtitle", "time": 2126.39, "timestamp": "00:35:26", "text": "呃，乔现场直播。好的，就是这个。好的，"}, {"type": "subtitle", "time": 2130.31, "timestamp": "00:35:30", "text": "它在这里。所以我在这里所做的是"}, {"type": "subtitle", "time": 2135.27, "timestamp": "00:35:35", "text": "嗯，我当时在看，我当时在看"}, {"type": "subtitle", "time": 2140.47, "timestamp": "00:35:40", "text": "所以，呃，这曾经就像……"}, {"type": "subtitle", "time": 2142.63, "timestamp": "00:35:42", "text": "呃，实时重定向页面，因为我当时"}, {"type": "subtitle", "time": 2144.71, "timestamp": "00:35:44", "text": "现在进行多路复现。所以我希望人们"}, {"type": "subtitle", "time": 2147.19, "timestamp": "00:35:47", "text": "加入他们喜欢的任何平台。所以，我"}, {"type": "subtitle", "time": 2150.15, "timestamp": "00:35:50", "text": "所做的是"}, {"type": "subtitle", "time": 2155.27, "timestamp": "00:35:55", "text": "嗯，所以我做的就是……把它放进去。"}, {"type": "subtitle", "time": 2156.79, "timestamp": "00:35:56", "text": "嗯"}, {"type": "subtitle", "time": 2159.109, "timestamp": "00:35:59", "text": "把所有直播预览都放上去。为什么是"}]
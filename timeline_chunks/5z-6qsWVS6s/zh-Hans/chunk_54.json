[{"type": "subtitle", "time": 3242.549, "timestamp": "00:54:02", "text": "值得一读。我们一起去看吧。所以"}, {"type": "subtitle", "time": 3244.47, "timestamp": "00:54:04", "text": "焦虑症就像一个创意项目"}, {"type": "subtitle", "time": 3246.309, "timestamp": "00:54:06", "text": "由 Jocknik 发起的项目"}, {"type": "subtitle", "time": 3248.95, "timestamp": "00:54:08", "text": "介入故事讲述、音乐、"}, {"type": "subtitle", "time": 3251.43, "timestamp": "00:54:11", "text": "奇幻题材的动画。它"}, {"type": "subtitle", "time": 3252.71, "timestamp": "00:54:12", "text": "具有原创角色和"}, {"type": "subtitle", "time": 3254.63, "timestamp": "00:54:14", "text": "叙事展示了托梁的创意和"}, {"type": "subtitle", "time": 3257.349, "timestamp": "00:54:17", "text": "真实表达。她的目标是创造"}, {"type": "subtitle", "time": 3259.109, "timestamp": "00:54:19", "text": "通过沉浸式体验为粉丝带来"}, {"type": "subtitle", "time": 3261.03, "timestamp": "00:54:21", "text": "主题歌曲，但有相应的"}, {"type": "subtitle", "time": 3263.27, "timestamp": "00:54:23", "text": "动画。我需要修改这个"}, {"type": "subtitle", "time": 3267.75, "timestamp": "00:54:27", "text": "东西。哦，但是忒伊亚，它就像……嗯，它是"}, {"type": "subtitle", "time": 3271.51, "timestamp": "00:54:31", "text": "嗯……该怎么说呢？我有"}, {"type": "subtitle", "time": 3275.03, "timestamp": "00:54:35", "text": "特点。就像……"}, {"type": "subtitle", "time": 3278.069, "timestamp": "00:54:38", "text": "嗯，你可以把它想象成……一个创意"}, {"type": "subtitle", "time": 3281.589, "timestamp": "00:54:41", "text": "标签。 OnX 最初应该是"}, {"type": "subtitle", "time": 3284.79, "timestamp": "00:54:44", "text": "就像我想创立的唱片公司一样"}, {"type": "subtitle", "time": 3287.91, "timestamp": "00:54:47", "text": "东西。后来，当我……时，这个想法得到了扩展。"}, {"type": "subtitle", "time": 3291.109, "timestamp": "00:54:51", "text": "开始进入状态，嗯，开始变得"}, {"type": "subtitle", "time": 3293.829, "timestamp": "00:54:53", "text": "因为我不再做音乐了，所以我开始玩虚拟主播了。"}, {"type": "subtitle", "time": 3295.99, "timestamp": "00:54:55", "text": "因为我迷上了那个音乐博客"}, {"type": "subtitle", "time": 3299.109, "timestamp": "00:54:59", "text": "我迷路了，感觉就像被困住了一样。"}]
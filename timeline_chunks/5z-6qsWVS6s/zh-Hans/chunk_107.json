[{"type": "subtitle", "time": 6421.189, "timestamp": "01:47:01", "text": "与外国人相处融洽，而且也能"}, {"type": "subtitle", "time": 6423.27, "timestamp": "01:47:03", "text": "说英语，一切都一样。"}, {"type": "subtitle", "time": 6425.75, "timestamp": "01:47:05", "text": "与韩国 YouTuber 以及同样的人"}, {"type": "subtitle", "time": 6429.669, "timestamp": "01:47:09", "text": "JPTuber 也没有中国 YouTuber"}, {"type": "subtitle", "time": 6432.149, "timestamp": "01:47:12", "text": "对，所以我想建一座桥，或者"}, {"type": "subtitle", "time": 6434.39, "timestamp": "01:47:14", "text": "所以很容易就能做到"}, {"type": "subtitle", "time": 6436.87, "timestamp": "01:47:16", "text": "与人合作以及处理所有事情。"}, {"type": "subtitle", "time": 6438.87, "timestamp": "01:47:18", "text": "那是我曾经想过要做的事情。"}, {"type": "subtitle", "time": 6440.79, "timestamp": "01:47:20", "text": "方式。"}, {"type": "subtitle", "time": 6446.31, "timestamp": "01:47:26", "text": "其中之一是我设定的目标之一。"}, {"type": "subtitle", "time": 6449.03, "timestamp": "01:47:29", "text": "因为我在学习日语，所以我想要"}, {"type": "subtitle", "time": 6451.99, "timestamp": "01:47:31", "text": "就像在乔纳森时期，我们确实……"}, {"type": "subtitle", "time": 6455.669, "timestamp": "01:47:35", "text": "两款日本合作产品。其中一个是和嗯"}, {"type": "subtitle", "time": 6459.109, "timestamp": "01:47:39", "text": "服部希兰。另一个是和"}, {"type": "subtitle", "time": 6463.109, "timestamp": "01:47:43", "text": "一位韩国YouTube博主Shen Lisa，但那是"}, {"type": "subtitle", "time": 6465.83, "timestamp": "01:47:45", "text": "因为她日语很差，所以全程都是日语。"}, {"type": "subtitle", "time": 6469.35, "timestamp": "01:47:49", "text": "英语和我，我不知道，我没有。"}, {"type": "subtitle", "time": 6471.669, "timestamp": "01:47:51", "text": "因为我不懂韩语，所以很痛苦。所以在"}, {"type": "subtitle", "time": 6477.109, "timestamp": "01:47:57", "text": "我觉得我可以尽我所能"}, {"type": "subtitle", "time": 6479.189, "timestamp": "01:47:59", "text": "就像你知道的那样，融入其中，互动交流。"}]
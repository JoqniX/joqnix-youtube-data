[{"type": "subtitle", "time": 9780.87, "timestamp": "02:43:00", "text": "一个他们在服务器里不说话"}, {"type": "subtitle", "time": 9784.71, "timestamp": "02:43:04", "text": "就潜伏在服务器里，然后狂发私信。"}, {"type": "subtitle", "time": 9787.99, "timestamp": "02:43:07", "text": "成员名单中的每个人"}, {"type": "subtitle", "time": 9792.469, "timestamp": "02:43:12", "text": "他们像平面设计师一样出售自己的作品等等"}, {"type": "subtitle", "time": 9796.79, "timestamp": "02:43:16", "text": "等等。所以我正在考虑做……"}, {"type": "subtitle", "time": 9799.19, "timestamp": "02:43:19", "text": "也别忘了关注推特上的GFX从业者们。是的"}, {"type": "subtitle", "time": 9801.51, "timestamp": "02:43:21", "text": "Twitter 上有很多 GFX 人士。"}, {"type": "subtitle", "time": 9811.67, "timestamp": "02:43:31", "text": "GF出口导致我们就像呃导致一个"}, {"type": "subtitle", "time": 9815.03, "timestamp": "02:43:35", "text": "在我们印度人当中名声不好，对吧？"}, {"type": "subtitle", "time": 9817.83, "timestamp": "02:43:37", "text": "因为这就像那些技术支持骗局一样。"}, {"type": "subtitle", "time": 9820.389, "timestamp": "02:43:40", "text": "就是那个微软骗局。"}, {"type": "subtitle", "time": 9828.309, "timestamp": "02:43:48", "text": "某种程度上，我觉得有人确实做了件很深入的事。"}, {"type": "subtitle", "time": 9831.19, "timestamp": "02:43:51", "text": "深入研究这个图形设计领域，人们意识到"}, {"type": "subtitle", "time": 9834.63, "timestamp": "02:43:54", "text": "它就像一家公司"}, {"type": "subtitle", "time": 9836.55, "timestamp": "02:43:56", "text": "或者公司里的一群人，或者"}]
[{"type": "subtitle", "time": 7140.87, "timestamp": "01:59:00", "text": "Mixcloud 和以前的一切"}, {"type": "subtitle", "time": 7144.39, "timestamp": "01:59:04", "text": "或者YouTube上的混音之类的，但是"}, {"type": "subtitle", "time": 7147.51, "timestamp": "01:59:07", "text": "是的，因为我做不到……"}, {"type": "subtitle", "time": 7150.95, "timestamp": "01:59:10", "text": "变成了一种社区活动。 Onx 的"}, {"type": "subtitle", "time": 7153.589, "timestamp": "01:59:13", "text": "这曾是我的社区名称。"}, {"type": "subtitle", "time": 7156.79, "timestamp": "01:59:16", "text": "然后我意识到，最终我们"}, {"type": "subtitle", "time": 7159.43, "timestamp": "01:59:19", "text": "我们创造了一个角色。"}, {"type": "subtitle", "time": 7162.709, "timestamp": "01:59:22", "text": "昨天是我的昨天最初"}, {"type": "subtitle", "time": 7167.51, "timestamp": "01:59:27", "text": "缟玛瑙。 Onyx，或者她现在的名字是Caes"}, {"type": "subtitle", "time": 7171.03, "timestamp": "01:59:31", "text": "昨天是她的生日。所以我爸爸的"}, {"type": "subtitle", "time": 7174.39, "timestamp": "01:59:34", "text": "生日是7月4日。所以7月5日，我"}, {"type": "subtitle", "time": 7178.47, "timestamp": "01:59:38", "text": "如果可以的话，我把它留给塞西尔。"}, {"type": "subtitle", "time": 7180.79, "timestamp": "01:59:40", "text": "拿出来。嗯"}, {"type": "subtitle", "time": 7183.35, "timestamp": "01:59:43", "text": "如果我没记错的话。等等，我刚才用对了吗？"}, {"type": "subtitle", "time": 7188.31, "timestamp": "01:59:48", "text": "对，那天是塞西尔的生日。塞西尔"}, {"type": "subtitle", "time": 7192.07, "timestamp": "01:59:52", "text": "嗯，这是另一个角色。她 她是"}, {"type": "subtitle", "time": 7196.47, "timestamp": "01:59:56", "text": "一位女王。紫发男或女法师。"}, {"type": "subtitle", "time": 7198.79, "timestamp": "01:59:58", "text": "她是一名法师。"}]
[{"type": "subtitle", "time": 12673.349, "timestamp": "03:31:13", "text": "渐变色的那个在哪里？内容"}, {"type": "subtitle", "time": 12675.91, "timestamp": "03:31:15", "text": "版主相关事宜。"}, {"type": "subtitle", "time": 12678.469, "timestamp": "03:31:18", "text": "高级样式部分更新。是什么"}, {"type": "subtitle", "time": 12680.15, "timestamp": "03:31:20", "text": "这？"}, {"type": "subtitle", "time": 12681.99, "timestamp": "03:31:21", "text": "哦，他们还没有。等等，他们带来了吗？"}, {"type": "subtitle", "time": 12685.19, "timestamp": "03:31:25", "text": "是那次更新吗？等等，让我看看。风格。"}, {"type": "subtitle", "time": 12687.269, "timestamp": "03:31:27", "text": "哦，对焦模式。高级模式。哦，是的。"}, {"type": "subtitle", "time": 12689.91, "timestamp": "03:31:29", "text": "是啊是啊。"}, {"type": "subtitle", "time": 12693.19, "timestamp": "03:31:33", "text": "默认对焦模式。好的，好的，好的。"}, {"type": "subtitle", "time": 12698.229, "timestamp": "03:31:38", "text": "他们把更新带到了本地。"}, {"type": "subtitle", "time": 12701.99, "timestamp": "03:31:41", "text": "嗯，给颜色选择器添加更多颜色。"}, {"type": "subtitle", "time": 12703.51, "timestamp": "03:31:43", "text": "H，"}, {"type": "subtitle", "time": 12705.91, "timestamp": "03:31:45", "text": "小图层重命名。"}, {"type": "subtitle", "time": 12708.309, "timestamp": "03:31:48", "text": "H."}, {"type": "subtitle", "time": 12710.469, "timestamp": "03:31:50", "text": "哦，是的。他们正在添加Vive代码模式。"}, {"type": "subtitle", "time": 12713.83, "timestamp": "03:31:53", "text": "在 Web 工作室中启用 Vive 编码模式。"}, {"type": "subtitle", "time": 12717.99, "timestamp": "03:31:57", "text": "他们确实带来了这个。"}]
[{"type": "subtitle", "time": 3540.549, "timestamp": "00:59:00", "text": "表演和唱歌。就是这样"}, {"type": "subtitle", "time": 3543.91, "timestamp": "00:59:03", "text": "将来我想自己做这件事。"}, {"type": "subtitle", "time": 3546.549, "timestamp": "00:59:06", "text": "那么，他们在堺市犯下的这些罪行究竟是什么呢？"}, {"type": "subtitle", "time": 3548.309, "timestamp": "00:59:08", "text": "系列节目或者像他们的演唱会之类的东西，"}, {"type": "subtitle", "time": 3551.03, "timestamp": "00:59:11", "text": "正确的？神椿战争或神椿"}, {"type": "subtitle", "time": 3553.829, "timestamp": "00:59:13", "text": "目前正在经历的事情。"}, {"type": "subtitle", "time": 3556.309, "timestamp": "00:59:16", "text": "呃，他们所做的就是他们拥有世界"}, {"type": "subtitle", "time": 3558.71, "timestamp": "00:59:18", "text": "他们所处的上椿市或"}, {"type": "subtitle", "time": 3561.349, "timestamp": "00:59:21", "text": "基于背景设定的东西。所有的歌曲都是"}, {"type": "subtitle", "time": 3565.19, "timestamp": "00:59:25", "text": "根据他们的传说。整首歌"}, {"type": "subtitle", "time": 3567.51, "timestamp": "00:59:27", "text": "歌曲及其歌词创作的一切"}, {"type": "subtitle", "time": 3570.63, "timestamp": "00:59:30", "text": "你可以把它和传说联系起来。"}, {"type": "subtitle", "time": 3573.589, "timestamp": "00:59:33", "text": "从某种意义上说，这真的很好，而且是"}, {"type": "subtitle", "time": 3576.309, "timestamp": "00:59:36", "text": "太棒了，这更符合我的预期"}, {"type": "subtitle", "time": 3580.309, "timestamp": "00:59:40", "text": "我也想拥有那样的体验，就像……"}, {"type": "subtitle", "time": 3582.87, "timestamp": "00:59:42", "text": "更像是把那种创造力分享出去。"}, {"type": "subtitle", "time": 3585.51, "timestamp": "00:59:45", "text": "感觉就像在看一场音乐会。"}, {"type": "subtitle", "time": 3588.549, "timestamp": "00:59:48", "text": "感觉演唱会就像……你"}, {"type": "subtitle", "time": 3590.95, "timestamp": "00:59:50", "text": "你可以称它为独特的体验，或者一件小事。"}, {"type": "subtitle", "time": 3593.19, "timestamp": "00:59:53", "text": "你知道，我当时就是想表达这个意思，所以就这么做了。"}, {"type": "subtitle", "time": 3595.829, "timestamp": "00:59:55", "text": "基于背景故事的事件或其他什么"}, {"type": "subtitle", "time": 3598.069, "timestamp": "00:59:58", "text": "他们现在有动画，"}]
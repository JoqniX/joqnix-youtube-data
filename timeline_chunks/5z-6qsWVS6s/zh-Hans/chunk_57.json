[{"type": "subtitle", "time": 3422.39, "timestamp": "00:57:02", "text": "我也受到了他们的启发。神椿 TLA"}, {"type": "subtitle", "time": 3426.309, "timestamp": "00:57:06", "text": "它就像……就像一个创意标签。"}, {"type": "subtitle", "time": 3428.39, "timestamp": "00:57:08", "text": "它就像一个创意标签。他们有V"}, {"type": "subtitle", "time": 3432.549, "timestamp": "00:57:12", "text": "歌手 K Brim Harisaki Sojo Koko Se"}, {"type": "subtitle", "time": 3437.03, "timestamp": "00:57:17", "text": "等等。他们有，呃，他们有，比如，嗯，是"}, {"type": "subtitle", "time": 3438.789, "timestamp": "00:57:18", "text": "就像一个唱片公司，它有"}, {"type": "subtitle", "time": 3441.03, "timestamp": "00:57:21", "text": "VTuber艺人和其他艺人将会是"}, {"type": "subtitle", "time": 3443.91, "timestamp": "00:57:23", "text": "比如人声制作人之类的，"}, {"type": "subtitle", "time": 3447.03, "timestamp": "00:57:27", "text": "音乐家、歌手、制作人，所有人"}, {"type": "subtitle", "time": 3449.19, "timestamp": "00:57:29", "text": "它们会在这里。"}, {"type": "subtitle", "time": 3452.95, "timestamp": "00:57:32", "text": "呃，所以这就好比神椿所做的那样。"}, {"type": "subtitle", "time": 3456.069, "timestamp": "00:57:36", "text": "仿佛他们拥有自己的宇宙。呃"}, {"type": "subtitle", "time": 3459.27, "timestamp": "00:57:39", "text": "如果我能说如果我去这里我可以"}, {"type": "subtitle", "time": 3461.349, "timestamp": "00:57:41", "text": "我觉得我可以展示它"}, {"type": "subtitle", "time": 3463.109, "timestamp": "00:57:43", "text": "从这里开始。"}, {"type": "subtitle", "time": 3465.75, "timestamp": "00:57:45", "text": "所以他们有自己的故事板"}, {"type": "subtitle", "time": 3469.75, "timestamp": "00:57:49", "text": "如果可以的话，我会放一些东西。是的，他们就像……"}, {"type": "subtitle", "time": 3472.23, "timestamp": "00:57:52", "text": "语音项目。诗歌项目就像"}, {"type": "subtitle", "time": 3475.27, "timestamp": "00:57:55", "text": "他们建立了他们的城市等等。"}, {"type": "subtitle", "time": 3478.789, "timestamp": "00:57:58", "text": "城市。所以这就是方向。"}]
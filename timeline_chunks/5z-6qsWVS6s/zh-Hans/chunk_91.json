[{"type": "subtitle", "time": 5464.79, "timestamp": "01:31:04", "text": "他们为每款游戏都制定了规则。"}, {"type": "subtitle", "time": 5466.55, "timestamp": "01:31:06", "text": "他们有一套指导方针。每当一个新的"}, {"type": "subtitle", "time": 5469.59, "timestamp": "01:31:09", "text": "游戏已经发布了，他们会在……中提到。"}, {"type": "subtitle", "time": 5473.03, "timestamp": "01:31:13", "text": "他们的新闻节目。呃，你是否可以"}, {"type": "subtitle", "time": 5474.87, "timestamp": "01:31:14", "text": "看还是不看，或者你应该怎么做？"}, {"type": "subtitle", "time": 5479.91, "timestamp": "01:31:19", "text": "直播之类的。"}, {"type": "subtitle", "time": 5481.669, "timestamp": "01:31:21", "text": "我原本应该和……合作"}, {"type": "subtitle", "time": 5484.31, "timestamp": "01:31:24", "text": "虔诚的 YouTuber。嗯，他们不"}, {"type": "subtitle", "time": 5487.51, "timestamp": "01:31:27", "text": "那边的人称之为虚拟主播（VTuber）。他们称之为"}, {"type": "subtitle", "time": 5491.189, "timestamp": "01:31:31", "text": "呃，虚拟启动主控。伏普"}, {"type": "subtitle", "time": 5495.43, "timestamp": "01:31:35", "text": "呜。是的。 V 向上 V U"}, {"type": "subtitle", "time": 5497.75, "timestamp": "01:31:37", "text": "我猜是V WOP。是的。是的。他们称之为"}, {"type": "subtitle", "time": 5500.39, "timestamp": "01:31:40", "text": "就是这样。这里他们称之为机构"}, {"type": "subtitle", "time": 5503.75, "timestamp": "01:31:43", "text": "比利·比利的内疚感和评论是"}, {"type": "subtitle", "time": 5505.99, "timestamp": "01:31:45", "text": "就像弹幕一样。"}, {"type": "subtitle", "time": 5508.95, "timestamp": "01:31:48", "text": "给我展示一些东西。"}, {"type": "subtitle", "time": 5512.47, "timestamp": "01:31:52", "text": "我的意思是，从某种意义上来说，这还不错。"}, {"type": "subtitle", "time": 5514.47, "timestamp": "01:31:54", "text": "到目前为止，我还没有收到任何恶意评论。"}, {"type": "subtitle", "time": 5517.27, "timestamp": "01:31:57", "text": "或者任何东西。我以为所有人都是那样的人。"}]
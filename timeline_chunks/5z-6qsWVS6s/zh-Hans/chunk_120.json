[{"type": "subtitle", "time": 7204.07, "timestamp": "02:00:04", "text": "还有塞西尔。这是红发塞西尔，嗯。"}, {"type": "subtitle", "time": 7207.27, "timestamp": "02:00:07", "text": "女战士。嗯，从某种意义上说，她是个特立独行的人。"}, {"type": "subtitle", "time": 7210.79, "timestamp": "02:00:10", "text": "双持角色。她双轮的呃"}, {"type": "subtitle", "time": 7213.589, "timestamp": "02:00:13", "text": "轮子就像……匕首一样。"}, {"type": "subtitle", "time": 7217.99, "timestamp": "02:00:17", "text": "猜测。而且她还用拳头……"}, {"type": "subtitle", "time": 7220.47, "timestamp": "02:00:20", "text": "出色地。是的，"}, {"type": "subtitle", "time": 7223.99, "timestamp": "02:00:23", "text": "那味道就像海盐。然后又一个"}, {"type": "subtitle", "time": 7229.51, "timestamp": "02:00:29", "text": "角色是这位科学家"}, {"type": "subtitle", "time": 7231.109, "timestamp": "02:00:31", "text": "炼金术士"}, {"type": "subtitle", "time": 7233.91, "timestamp": "02:00:33", "text": "他的名字是thyastin，thyastin基于"}, {"type": "subtitle", "time": 7236.31, "timestamp": "02:00:36", "text": "嗯，你的生日就像在我的生日那天一样"}, {"type": "subtitle", "time": 7240.229, "timestamp": "02:00:40", "text": "奶奶的生日是11月30日"}, {"type": "subtitle", "time": 7242.55, "timestamp": "02:00:42", "text": "阿奎那的罪孽就是我母亲的罪孽。"}, {"type": "subtitle", "time": 7245.83, "timestamp": "02:00:45", "text": "生日是10月6日，10月5日是"}, {"type": "subtitle", "time": 7247.99, "timestamp": "02:00:47", "text": "母亲的生日是10月6日。"}, {"type": "subtitle", "time": 7251.03, "timestamp": "02:00:51", "text": "阿奎那，所以从某种意义上说，我能记住他。"}, {"type": "subtitle", "time": 7253.83, "timestamp": "02:00:53", "text": "现在他们也有了自己的推特账号。"}]
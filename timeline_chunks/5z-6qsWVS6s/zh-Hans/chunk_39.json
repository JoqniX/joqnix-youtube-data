[{"type": "subtitle", "time": 2342.069, "timestamp": "00:39:02", "text": "Twitch API、YouTube AVI、Billy Billy"}, {"type": "subtitle", "time": 2347.27, "timestamp": "00:39:07", "text": "东西。我的检查正在进行中。"}, {"type": "subtitle", "time": 2351.109, "timestamp": "00:39:11", "text": "是啊，太多事情了。我甚至还试过Holex"}, {"type": "subtitle", "time": 2354.55, "timestamp": "00:39:14", "text": "还有API方面的内容。"}, {"type": "subtitle", "time": 2356.55, "timestamp": "00:39:16", "text": "是啊，太多事情了。问题是"}, {"type": "subtitle", "time": 2358.55, "timestamp": "00:39:18", "text": "Web Studio 在以下方面存在局限性"}, {"type": "subtitle", "time": 2361.349, "timestamp": "00:39:21", "text": "这也适用于 API 调用。"}, {"type": "subtitle", "time": 2363.589, "timestamp": "00:39:23", "text": "概念和你需要的三个 API"}, {"type": "subtitle", "time": 2367.75, "timestamp": "00:39:27", "text": "正确的概念是限制，你"}, {"type": "subtitle", "time": 2370.95, "timestamp": "00:39:30", "text": "只能进行页面属性数据库操作"}, {"type": "subtitle", "time": 2374.95, "timestamp": "00:39:34", "text": "像这样的属性，你不能这样做"}, {"type": "subtitle", "time": 2377.589, "timestamp": "00:39:37", "text": "页面内的各种属性"}, {"type": "subtitle", "time": 2379.99, "timestamp": "00:39:39", "text": "或页面内的子内容"}, {"type": "subtitle", "time": 2382.63, "timestamp": "00:39:42", "text": "这件事会很难，因为他们"}, {"type": "subtitle", "time": 2385.91, "timestamp": "00:39:45", "text": "目前还不支持多 API 功能"}, {"type": "subtitle", "time": 2389.03, "timestamp": "00:39:49", "text": "仍在进行中。希望到年底……"}, {"type": "subtitle", "time": 2392.87, "timestamp": "00:39:52", "text": "到2025年，我们会把这些事情完成。"}, {"type": "subtitle", "time": 2395.99, "timestamp": "00:39:55", "text": "然后他们还有设计代币之类的东西。"}, {"type": "subtitle", "time": 2399.19, "timestamp": "00:39:59", "text": "所以我在等他们添加像你这样的功能。"}]
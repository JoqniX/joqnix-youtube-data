[{"type": "subtitle", "time": 5102.39, "timestamp": "01:25:02", "text": "上传文件不能超过10GB。呃，还有"}, {"type": "subtitle", "time": 5104.149, "timestamp": "01:25:04", "text": "还"}, {"type": "subtitle", "time": 5107.11, "timestamp": "01:25:07", "text": "同时还有持续时间限制。呃，关于流媒体"}, {"type": "subtitle", "time": 5109.189, "timestamp": "01:25:09", "text": "还有其他一些东西，比如视频内容，它必须是"}, {"type": "subtitle", "time": 5112.87, "timestamp": "01:25:12", "text": "不到10个小时，对吧？所以如果我正在做"}, {"type": "subtitle", "time": 5114.79, "timestamp": "01:25:14", "text": "如果我没记错的话，我当时是连续工作了12个小时。"}, {"type": "subtitle", "time": 5117.59, "timestamp": "01:25:17", "text": "直播的时候，我得分成两部分。部分"}, {"type": "subtitle", "time": 5121.11, "timestamp": "01:25:21", "text": "第一部分，第二部分，把它分成两部分。"}, {"type": "subtitle", "time": 5123.03, "timestamp": "01:25:23", "text": "是的，"}, {"type": "subtitle", "time": 5125.83, "timestamp": "01:25:25", "text": "那么多东西，现在他们都改了。"}, {"type": "subtitle", "time": 5129.35, "timestamp": "01:25:29", "text": "现在我需要大约10万个粉丝"}, {"type": "subtitle", "time": 5133.669, "timestamp": "01:25:33", "text": "三级。兄弟，这到底是怎么回事？"}, {"type": "subtitle", "time": 5136.629, "timestamp": "01:25:36", "text": "我试过这个平台吗？这个平台超级棒，呃……"}, {"type": "subtitle", "time": 5140.07, "timestamp": "01:25:40", "text": "浏览量和互动量等等"}, {"type": "subtitle", "time": 5142.39, "timestamp": "01:25:42", "text": "这些数字导向型。"}, {"type": "subtitle", "time": 5144.39, "timestamp": "01:25:44", "text": "他们有一个等级系统，呃……"}, {"type": "subtitle", "time": 5146.229, "timestamp": "01:25:46", "text": "主播们，他们有等级制度"}, {"type": "subtitle", "time": 5149.11, "timestamp": "01:25:49", "text": "用于上传正常内容的系统，例如"}, {"type": "subtitle", "time": 5153.189, "timestamp": "01:25:53", "text": "视频上传者也是如此。对于主播来说"}, {"type": "subtitle", "time": 5156.229, "timestamp": "01:25:56", "text": "等级系统，如果我去直播"}]
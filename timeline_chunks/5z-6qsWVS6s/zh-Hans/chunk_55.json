[{"type": "subtitle", "time": 3302.15, "timestamp": "00:55:02", "text": "卡住了一段时间。我阻止了它。所以我的"}, {"type": "subtitle", "time": 3304.63, "timestamp": "00:55:04", "text": "vubing之旅是我尝试重做我的"}, {"type": "subtitle", "time": 3308.15, "timestamp": "00:55:08", "text": "东西。重做我的事情，就像做那些事一样。"}, {"type": "subtitle", "time": 3310.87, "timestamp": "00:55:10", "text": "我放弃了，但我仍然在追逐我的梦想"}, {"type": "subtitle", "time": 3312.71, "timestamp": "00:55:12", "text": "最初的梦想就是我正在做的事情"}, {"type": "subtitle", "time": 3315.03, "timestamp": "00:55:15", "text": "目前正忙着音乐之类的事情"}, {"type": "subtitle", "time": 3316.87, "timestamp": "00:55:16", "text": "我未来还会继续创作音乐。"}, {"type": "subtitle", "time": 3320.39, "timestamp": "00:55:20", "text": "现在一切都好了，所以我想说的是……"}, {"type": "subtitle", "time": 3324.069, "timestamp": "00:55:24", "text": "写作主要就像一个宇宙"}, {"type": "subtitle", "time": 3327.43, "timestamp": "00:55:27", "text": "或者像故事主题之类的东西，所以缟玛瑙是"}, {"type": "subtitle", "time": 3329.67, "timestamp": "00:55:29", "text": "更像是一个仓库，你可以这么说。"}, {"type": "subtitle", "time": 3333.75, "timestamp": "00:55:33", "text": "我有很多字符，呃"}, {"type": "subtitle", "time": 3337.19, "timestamp": "00:55:37", "text": "想写关于音乐的文章，想在音乐中展示音乐。"}, {"type": "subtitle", "time": 3339.91, "timestamp": "00:55:39", "text": "东西，还有很多其他东西。所以"}, {"type": "subtitle", "time": 3342.15, "timestamp": "00:55:42", "text": "这些角色将在以下方面进行刻画："}, {"type": "subtitle", "time": 3344.47, "timestamp": "00:55:44", "text": "音乐视频之类的东西。为了"}, {"type": "subtitle", "time": 3347.27, "timestamp": "00:55:47", "text": "例如，如果你观看，如果你收听"}, {"type": "subtitle", "time": 3350.39, "timestamp": "00:55:50", "text": "日本音乐之类的东西，你可能也有。"}, {"type": "subtitle", "time": 3353.99, "timestamp": "00:55:53", "text": "了解夏娃。"}, {"type": "subtitle", "time": 3357.03, "timestamp": "00:55:57", "text": "夏娃就像一个"}, {"type": "subtitle", "time": 3359.589, "timestamp": "00:55:59", "text": "呃呃，Eve就像一位日本作曲家"}]
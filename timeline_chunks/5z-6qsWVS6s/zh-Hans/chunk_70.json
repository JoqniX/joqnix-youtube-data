[{"type": "subtitle", "time": 4201.189, "timestamp": "01:10:01", "text": "事物"}, {"type": "subtitle", "time": 4212.39, "timestamp": "01:10:12", "text": "我的天哪，我话好多啊。我的喉咙"}, {"type": "subtitle", "time": 4219.03, "timestamp": "01:10:19", "text": "干燥的。让我……让我放点……热的"}, {"type": "subtitle", "time": 4221.669, "timestamp": "01:10:21", "text": "水和环。"}, {"type": "subtitle", "time": 4223.43, "timestamp": "01:10:23", "text": "是的，"}, {"type": "subtitle", "time": 4226.47, "timestamp": "01:10:26", "text": "呃，让我读一下其中一条评论。"}, {"type": "subtitle", "time": 4231.03, "timestamp": "01:10:31", "text": "错过了你。嗯，"}, {"type": "subtitle", "time": 4232.79, "timestamp": "01:10:32", "text": "你们的主要内容是什么？我的主要"}, {"type": "subtitle", "time": 4242.63, "timestamp": "01:10:42", "text": "如你所见，"}, {"type": "subtitle", "time": 4246.31, "timestamp": "01:10:46", "text": "主要内容是多样性。我玩游戏。"}, {"type": "subtitle", "time": 4249.11, "timestamp": "01:10:49", "text": "还有一些其他的东西。这件事不是我的主要问题"}, {"type": "subtitle", "time": 4252.39, "timestamp": "01:10:52", "text": "我理想中想做的内容是"}, {"type": "subtitle", "time": 4259.27, "timestamp": "01:10:59", "text": "呃，主要是音乐方面的东西，我想……"}]
[{"type": "subtitle", "time": 2162.95, "timestamp": "00:36:02", "text": "是的，因为……所以需要一些时间。"}, {"type": "subtitle", "time": 2166.87, "timestamp": "00:36:06", "text": "正在加载。但是，是的，就是这样。"}, {"type": "subtitle", "time": 2169.67, "timestamp": "00:36:09", "text": "呃，我受到了打破第四面墙的启发。"}, {"type": "subtitle", "time": 2172.23, "timestamp": "00:36:12", "text": "如果你去第四世界，对吧？如果"}, {"type": "subtitle", "time": 2175.19, "timestamp": "00:36:15", "text": "你去找任何一个有……的创作者"}, {"type": "subtitle", "time": 2177.99, "timestamp": "00:36:17", "text": "使用第四世界，当你连接时"}, {"type": "subtitle", "time": 2180.87, "timestamp": "00:36:20", "text": "用它登录你的 YouTube 或 Twitch 频道，它会显示出来。"}, {"type": "subtitle", "time": 2185.19, "timestamp": "00:36:25", "text": "就像他们的外包装盒上的红色图标一样。"}, {"type": "subtitle", "time": 2188.39, "timestamp": "00:36:28", "text": "现在，它像一个发光的红色图标一样闪闪发光。"}, {"type": "subtitle", "time": 2190.39, "timestamp": "00:36:30", "text": "于是，我照做了。为什么需要这么长时间"}, {"type": "subtitle", "time": 2192.71, "timestamp": "00:36:32", "text": "永远？真是个大工程。"}, {"type": "subtitle", "time": 2194.31, "timestamp": "00:36:34", "text": "所以我把YouTube、Twitch和"}, {"type": "subtitle", "time": 2196.87, "timestamp": "00:36:36", "text": "比利比利那玩意儿。它会检查我是否"}, {"type": "subtitle", "time": 2200.47, "timestamp": "00:36:40", "text": "YouTube直播。如果我不是，呃，它"}, {"type": "subtitle", "time": 2202.79, "timestamp": "00:36:42", "text": "隐藏了 YouTube 图标。如果我正在直播"}, {"type": "subtitle", "time": 2204.79, "timestamp": "00:36:44", "text": "Twitch，它会显示 Twitch 的图标"}, {"type": "subtitle", "time": 2206.87, "timestamp": "00:36:46", "text": "聊天记录，"}, {"type": "subtitle", "time": 2209.589, "timestamp": "00:36:49", "text": "如你看到的。是的。是的。这曾经是"}, {"type": "subtitle", "time": 2211.67, "timestamp": "00:36:51", "text": "做比利比利的事。我没有直播"}, {"type": "subtitle", "time": 2214.79, "timestamp": "00:36:54", "text": "就这样，忽略这条吧。是的，所以"}, {"type": "subtitle", "time": 2216.71, "timestamp": "00:36:56", "text": "做了条件渲染。"}, {"type": "subtitle", "time": 2219.99, "timestamp": "00:36:59", "text": "你在这里说的也一样。这辆车"}]
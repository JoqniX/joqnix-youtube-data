[{"type": "subtitle", "time": 422.71, "timestamp": "00:07:02", "text": "让我切换一下屏幕给你看看。嗯，"}, {"type": "subtitle", "time": 424.95, "timestamp": "00:07:04", "text": "如果你不知道什么是网络工作室，"}, {"type": "subtitle", "time": 427.589, "timestamp": "00:07:07", "text": "呃，这是我的网站。这一切都是"}, {"type": "subtitle", "time": 430.469, "timestamp": "00:07:10", "text": "在 Web Studio 中完成。呃，这个网站，这个"}, {"type": "subtitle", "time": 433.029, "timestamp": "00:07:13", "text": "专为……哦，对了，我的设计"}, {"type": "subtitle", "time": 435.189, "timestamp": "00:07:15", "text": "叠加层不起作用，你看不到我的东西。"}, {"type": "subtitle", "time": 437.189, "timestamp": "00:07:17", "text": "因为我使用了叠加层。是的，"}, {"type": "subtitle", "time": 438.79, "timestamp": "00:07:18", "text": "这个网站尤其如此"}, {"type": "subtitle", "time": 441.99, "timestamp": "00:07:21", "text": "灵感来自我的一位 Oshi"}, {"type": "subtitle", "time": 449.11, "timestamp": "00:07:29", "text": "顺便一提，K有一个神崎人"}, {"type": "subtitle", "time": 451.909, "timestamp": "00:07:31", "text": "他们制作的动画正在本季播出。请"}, {"type": "subtitle", "time": 455.189, "timestamp": "00:07:35", "text": "一定要看。这部动漫真好看。"}, {"type": "subtitle", "time": 457.83, "timestamp": "00:07:37", "text": "是的，正如你所看到的，K 网站现在上线了。"}, {"type": "subtitle", "time": 461.11, "timestamp": "00:07:41", "text": "叠加层。哦，但是，在顶部该怎么做呢？"}, {"type": "subtitle", "time": 462.71, "timestamp": "00:07:42", "text": "我需要一个小按钮来隐藏我的"}, {"type": "subtitle", "time": 464.79, "timestamp": "00:07:44", "text": "覆盖。是的，它们有相似之处。"}, {"type": "subtitle", "time": 466.79, "timestamp": "00:07:46", "text": "环境。现在我认为这是定制的。"}, {"type": "subtitle", "time": 469.51, "timestamp": "00:07:49", "text": "WordPress相关的东西。所以我就有点明白了。"}, {"type": "subtitle", "time": 471.749, "timestamp": "00:07:51", "text": "受此启发，我尝试重新制作了它。"}, {"type": "subtitle", "time": 475.99, "timestamp": "00:07:55", "text": "在网络工作室中。所以我尽了全力。"}, {"type": "subtitle", "time": 478.71, "timestamp": "00:07:58", "text": "那段时间我尝试做 Web Studio。"}]
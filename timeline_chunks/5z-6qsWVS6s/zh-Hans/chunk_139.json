[{"type": "subtitle", "time": 8341.27, "timestamp": "02:19:01", "text": "是的，如果是早上，而且阳光明媚的话……"}, {"type": "subtitle", "time": 8343.589, "timestamp": "02:19:03", "text": "会是这样。"}, {"type": "subtitle", "time": 8345.83, "timestamp": "02:19:05", "text": "如果下雨，就会下雨。"}, {"type": "subtitle", "time": 8348.15, "timestamp": "02:19:08", "text": "东西。所以他们有一个条件。"}, {"type": "subtitle", "time": 8350.309, "timestamp": "02:19:10", "text": "为他们的东西渲染。这有点像"}, {"type": "subtitle", "time": 8353.75, "timestamp": "02:19:13", "text": "凉爽的。现在下雨了。所以会下雨"}, {"type": "subtitle", "time": 8357.27, "timestamp": "02:19:17", "text": "就像我们能看到的那样。他们不放"}, {"type": "subtitle", "time": 8359.75, "timestamp": "02:19:19", "text": "它。"}, {"type": "subtitle", "time": 8362.15, "timestamp": "02:19:22", "text": "好的。他们不放。德里方面表示"}, {"type": "subtitle", "time": 8369.75, "timestamp": "02:19:29", "text": "对，是夜雨那部分。是的，会的"}, {"type": "subtitle", "time": 8372.309, "timestamp": "02:19:32", "text": "像这样。不。所以，我当时在想……"}, {"type": "subtitle", "time": 8374.95, "timestamp": "02:19:34", "text": "做这件事，学习如何做这件事。所以，"}, {"type": "subtitle", "time": 8378.309, "timestamp": "02:19:38", "text": "今天我们要做这件事。嗯，如果"}, {"type": "subtitle", "time": 8380.469, "timestamp": "02:19:40", "text": "我可以找到它。嗯，今天我们将要做"}, {"type": "subtitle", "time": 8386.79, "timestamp": "02:19:46", "text": "菜单系统类似于全屏菜单"}, {"type": "subtitle", "time": 8389.59, "timestamp": "02:19:49", "text": "就像全屏菜单一样"}, {"type": "subtitle", "time": 8392.55, "timestamp": "02:19:52", "text": "呃，还有像这样的标志和"}, {"type": "subtitle", "time": 8396.63, "timestamp": "02:19:56", "text": "所有页面相关的东西。我们会尽量"}]
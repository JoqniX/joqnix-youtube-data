[{"type": "subtitle", "time": 541.59, "timestamp": "00:09:01", "text": "如果你把它放在……如果你把它放在……"}, {"type": "subtitle", "time": 545.11, "timestamp": "00:09:05", "text": "使用火狐浏览器，可以看到直播流。"}, {"type": "subtitle", "time": 548.389, "timestamp": "00:09:08", "text": "东西出现了。当前流。"}, {"type": "subtitle", "time": 550.31, "timestamp": "00:09:10", "text": "是的，当前流将显示出来。"}, {"type": "subtitle", "time": 552.55, "timestamp": "00:09:12", "text": "频道播放列表。所有流"}, {"type": "subtitle", "time": 554.31, "timestamp": "00:09:14", "text": "将在行星频道播出"}, {"type": "subtitle", "time": 556.87, "timestamp": "00:09:16", "text": "播放列表。所以，我也不知道为什么会这样。"}, {"type": "subtitle", "time": 558.71, "timestamp": "00:09:18", "text": "不适用于 Chromium 版本，但是"}, {"type": "chat", "time": 560.034, "timestamp": "00:09:20", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "👀"}, {"type": "subtitle", "time": 561.59, "timestamp": "00:09:21", "text": "是啊，这很奇怪，然后我就在那里"}, {"type": "subtitle", "time": 564.55, "timestamp": "00:09:24", "text": "这种老式网站现在还像这样吗？"}, {"type": "subtitle", "time": 567.03, "timestamp": "00:09:27", "text": "我忘了它叫什么了。所以"}, {"type": "subtitle", "time": 569.67, "timestamp": "00:09:29", "text": "我当时是想从中寻找灵感。"}, {"type": "subtitle", "time": 572.55, "timestamp": "00:09:32", "text": "然后我看了这个。呃，这是一个"}, {"type": "subtitle", "time": 574.23, "timestamp": "00:09:34", "text": "客人。他们就像一位客人一样。"}, {"type": "subtitle", "time": 577.269, "timestamp": "00:09:37", "text": "东西。是旧版网站吧？这"}, {"type": "subtitle", "time": 580.63, "timestamp": "00:09:40", "text": "它叫什么名字？ Netisen。不，嗯，忘了。"}, {"type": "subtitle", "time": 584.15, "timestamp": "00:09:44", "text": "它叫什么名字？就像90年代那样"}, {"type": "subtitle", "time": 588.79, "timestamp": "00:09:48", "text": "有点像80年代90年代的风格，就像……"}, {"type": "subtitle", "time": 591.269, "timestamp": "00:09:51", "text": "一群人自创的社区"}, {"type": "subtitle", "time": 593.269, "timestamp": "00:09:53", "text": "网站之类的，对吧？就像我"}, {"type": "subtitle", "time": 595.67, "timestamp": "00:09:55", "text": "我忘了它叫什么了。所以我看到了一些"}, {"type": "subtitle", "time": 597.59, "timestamp": "00:09:57", "text": "那边的网站就像……"}]
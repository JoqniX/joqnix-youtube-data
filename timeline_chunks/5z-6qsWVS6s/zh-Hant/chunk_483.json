[{"type": "subtitle", "time": 28981.59, "timestamp": "08:03:01", "text": "？  哦，是雲。"}, {"type": "subtitle", "time": 28985.51, "timestamp": "08:03:05", "text": "他們讓雲朵動了起來。不，是飄動的雲。不，很好。  季票。  嗯，我喜歡他們在這裡放一些小字。"}, {"type": "subtitle", "time": 28994.388, "timestamp": "08:03:14", "text": "但是，如果你能用 Framer 製作一些很酷的 2D 和 3D 作品，那當然沒問題，對吧？"}, {"type": "subtitle", "time": 29035.75, "timestamp": "08:03:55", "text": "這就像一款真正的3D遊戲"}]
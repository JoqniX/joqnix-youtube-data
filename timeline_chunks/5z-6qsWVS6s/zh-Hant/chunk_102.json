[{"type": "subtitle", "time": 6121.669, "timestamp": "01:42:01", "text": "語言"}, {"type": "subtitle", "time": 6124.629, "timestamp": "01:42:04", "text": "學校的人必須寫書面道歉，還要跟校長溝通等等。有個學生想家，所以他們必須跟校長商量如何處理這個學生。還有一個學生表現很差。因為是兼職，所以學院不得不與這家便利"}, {"type": "subtitle", "time": 6146.229, "timestamp": "01:42:26", "text": "商店的兼職老闆或店主開會。他們必須和便利商店老闆談話，道歉，還要寫道歉信等等，為工作表現不佳等一切事情道歉。真是太痛苦了。所以他們表示，作為對這件事的補償，"}, {"type": "subtitle", "time": 6148.39, "timestamp": "01:42:28", "text": "他們將免費提供"}, {"type": "subtitle", "time": 6152.95, "timestamp": "01:42:32", "text": "N4課程。所以我會上N4到N3的基礎課程。"}, {"type": "subtitle", "time": 6157.83, "timestamp": "01:42:37", "text": "所以更"}, {"type": "subtitle", "time": 6159.91, "timestamp": "01:42:39", "text": "確切地說，我會做好充分的準備。我會做好充分的準備，直到我四月到日本入學。所以到"}, {"type": "subtitle", "time": 6165.75, "timestamp": "01:42:45", "text": "三月底我就要離開了。所以明年再說吧，這樣我才有時間準備。這次"}]
[{"type": "subtitle", "time": 12360.15, "timestamp": "03:26:00", "text": "這個網站現在有了主題相關的"}, {"type": "subtitle", "time": 12379.67, "timestamp": "03:26:19", "text": "內容。看看這個。它確實有一些主題。  它包含了人生各階段的角色，像是鑰匙之類的。我想學習如何做到這一點。  太酷了！一切都會改變。  主題真多。  無論"}, {"type": "subtitle", "time": 12384.71, "timestamp": "03:26:24", "text": "你喜歡什麼主題，都可以使用"}, {"type": "subtitle", "time": 12389.99, "timestamp": "03:26:29", "text": "。  圖片互換。"}, {"type": "subtitle", "time": 12401.83, "timestamp": "03:26:41", "text": "呃，我覺得這是圖片製作"}, {"type": "subtitle", "time": 12406.79, "timestamp": "03:26:46", "text": "公司。當滑鼠懸停在上面時，就會顯示懸停圖像，對吧？  我這樣做是為了在我的"}]
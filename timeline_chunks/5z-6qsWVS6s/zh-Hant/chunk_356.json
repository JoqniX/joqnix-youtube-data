[{"type": "subtitle", "time": 21390.788, "timestamp": "05:56:30", "text": "好了，"}, {"type": "subtitle", "time": 21395.51, "timestamp": "05:56:35", "text": "現在我們可以安心做了。耶"}, {"type": "subtitle", "time": 21411.91, "timestamp": "05:56:51", "text": "。在這裡。呃，背景漸層。我能做的就是柔光。哦不，它崩潰了。我把它搞砸了。我把它搞砸了嗎？它又卡住了。兄弟沒事"}]
[{"type": "subtitle", "time": 242.07, "timestamp": "00:04:02", "text": "。其中一個是 Joex，我"}, {"type": "subtitle", "time": 244.71, "timestamp": "00:04:04", "text": "最近（指的是去年）買了一個網域"}, {"type": "subtitle", "time": 247.75, "timestamp": "00:04:07", "text": "。另一個是我花了三、兩年時間打造的，"}, {"type": "subtitle", "time": 250.149, "timestamp": "00:04:10", "text": "名為 Anexia 的項目，它是我傾注心血的成果。"}, {"type": "subtitle", "time": 255.27, "timestamp": "00:04:15", "text": "呃，因為我已經暫時把我的"}, {"type": "subtitle", "time": 257.59, "timestamp": "00:04:17", "text": "專案存檔了，我現在要全力"}, {"type": "subtitle", "time": 260.789, "timestamp": "00:04:20", "text": "投入我的下一個專案——我的個人"}, {"type": "subtitle", "time": 263.59, "timestamp": "00:04:23", "text": "獨立旅程。嗯，我專注於我"}, {"type": "subtitle", "time": 271.35, "timestamp": "00:04:31", "text": "的項目，但是，是的，我的網站也還在，嗯，還有我所有鏈接的短鏈接"}, {"type": "subtitle", "time": 277.189, "timestamp": "00:04:37", "text": "域名，對吧，品牌鏈接我也有短鏈接域名，嗯，讓我把它打到聊天框裡，"}, {"type": "subtitle", "time": 281.99, "timestamp": "00:04:41", "text": "這樣你就能看到了。嗯，我想"}, {"type": "chat", "time": 287.427, "timestamp": "00:04:47", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "JoqniX - https://joqnix.space"}, {"type": "subtitle", "time": 288.79, "timestamp": "00:04:48", "text": "我需要一個命令。  我其實需要一個指令來實現這個功能。請說說"}, {"type": "subtitle", "time": 291.67, "timestamp": "00:04:51", "text": "接下來一些比較陰暗的想法。"}, {"type": "subtitle", "time": 299.43, "timestamp": "00:04:59", "text": "哦，你不能在Twitch上用YouTube換行。哦，沒事了。好的。"}]
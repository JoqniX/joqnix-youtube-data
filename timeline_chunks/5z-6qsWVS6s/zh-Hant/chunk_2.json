[{"type": "subtitle", "time": 120.789, "timestamp": "00:02:00", "text": "顯示出來。我稍微修改了一下"}, {"type": "subtitle", "time": 125.749, "timestamp": "00:02:05", "text": "。所以現在它更具活力了，嗯，該"}, {"type": "subtitle", "time": 130.07, "timestamp": "00:02:10", "text": "怎麼稱呼它呢？嗯，動態的，就像"}, {"type": "subtitle", "time": 133.83, "timestamp": "00:02:13", "text": "文本中描述的那樣。文字越多，它就會自動"}, {"type": "subtitle", "time": 137.35, "timestamp": "00:02:17", "text": "均勻分佈等等。是的。在"}, {"type": "subtitle", "time": 141.11, "timestamp": "00:02:21", "text": "我的螢幕頂部。那很好。"}, {"type": "subtitle", "time": 144.55, "timestamp": "00:02:24", "text": "所以，今天"}, {"type": "subtitle", "time": 147.43, "timestamp": "00:02:27", "text": "是晚上。現在是晚上10點30分。"}, {"type": "subtitle", "time": 152.07, "timestamp": "00:02:32", "text": "它。不過，今天我確實有了一些想法。所以，"}, {"type": "subtitle", "time": 154.55, "timestamp": "00:02:34", "text": "昨天我們大概"}, {"type": "subtitle", "time": 156.869, "timestamp": "00:02:36", "text": "早上5點就停止直播了，對吧？"}, {"type": "subtitle", "time": 162.63, "timestamp": "00:02:42", "text": "呃，昨天我瀏覽了"}, {"type": "subtitle", "time": 165.19, "timestamp": "00:02:45", "text": "一些網站，因為我突然有了靈感"}, {"type": "subtitle", "time": 167.27, "timestamp": "00:02:47", "text": "。所以我們"}, {"type": "subtitle", "time": 169.19, "timestamp": "00:02:49", "text": "昨天查看的網站，例如"}, {"type": "subtitle", "time": 172.47, "timestamp": "00:02:52", "text": "Weather Planet，呃，Weather Planet One，"}, {"type": "subtitle", "time": 176.79, "timestamp": "00:02:56", "text": "我記得它好像是一個雙人單元。"}, {"type": "subtitle", "time": 179.67000000000002, "timestamp": "00:02:59", "text": "嗯，是的。我發現大多數"}]
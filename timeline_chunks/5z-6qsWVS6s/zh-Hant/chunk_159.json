[{"type": "subtitle", "time": 9543.19, "timestamp": "02:39:03", "text": "太多事情了。  我們又跑題了。  我一談到這些事，就滔滔不絕。嗯"}, {"type": "subtitle", "time": 9570.23, "timestamp": "02:39:30", "text": "一些東西。測試。我"}, {"type": "subtitle", "time": 9589.27, "timestamp": "02:39:49", "text": "呃，你知道"}, {"type": "subtitle", "time": 9592.309, "timestamp": "02:39:52", "text": "嗎？如果我"}, {"type": "subtitle", "time": 9599.67, "timestamp": "02:39:59", "text": "在這裡測試，我"}]
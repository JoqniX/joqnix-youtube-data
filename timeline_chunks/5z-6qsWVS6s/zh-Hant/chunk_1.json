[{"type": "subtitle", "time": 64.149, "timestamp": "00:01:04", "text": "在我的直播間辦公室掛個牌子。嗯，這樣"}, {"type": "subtitle", "time": 68.07, "timestamp": "00:01:08", "text": "我就可以把它展示出來了。所以，我是一家正規"}, {"type": "subtitle", "time": 70.07, "timestamp": "00:01:10", "text": "企業，我所做的一切都是合法的，如果"}, {"type": "subtitle", "time": 72.23, "timestamp": "00:01:12", "text": "他們過來，我可以把這些事情都"}, {"type": "subtitle", "time": 74.149, "timestamp": "00:01:14", "text": "安排好。"}, {"type": "subtitle", "time": 76.71000000000001, "timestamp": "00:01:16", "text": "另外，昨天我們更新了螢幕頂部的疊加層，對於那些"}, {"type": "subtitle", "time": 80.07, "timestamp": "00:01:20", "text": "錯過了昨天第 115 集直播的朋友，"}, {"type": "subtitle", "time": 86.469, "timestamp": "00:01:26", "text": "可以看到直播按鈕"}, {"type": "subtitle", "time": 89.429, "timestamp": "00:01:29", "text": "現在是紅色的，表示我正在直播。在行動裝置上觀看直播時，"}, {"type": "subtitle", "time": 91.67, "timestamp": "00:01:31", "text": "它會顯示為"}, {"type": "subtitle", "time": 94.95, "timestamp": "00:01:34", "text": "綠色。當我在播放影片時，它會顯示為"}, {"type": "subtitle", "time": 97.50999999999999, "timestamp": "00:01:37", "text": "通常的紫色。"}, {"type": "subtitle", "time": 101.91, "timestamp": "00:01:41", "text": "所以我們"}, {"type": "subtitle", "time": 112.469, "timestamp": "00:01:52", "text": "如果"}, {"type": "subtitle", "time": 115.27000000000001, "timestamp": "00:01:55", "text": "我沒記錯的話，我們也更新了活動"}, {"type": "subtitle", "time": 118.31, "timestamp": "00:01:58", "text": "主題狀態，稍後會"}]
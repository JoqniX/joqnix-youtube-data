[{"type": "subtitle", "time": 5400.149, "timestamp": "01:30:00", "text": "我好像在做多路復現之類的，對吧？自從 Twitch 允許多平台直播以來，我就想進行多平台直播，因為獨家直播的要求是 1 小時獨家內容。  我以前也這樣做過。那曾經是我的…我以前常玩一個小時的Apex，還有"}, {"type": "subtitle", "time": 5409.83, "timestamp": "01:30:09", "text": "Valerant之類的遊戲。哦，對啊，你甚至"}, {"type": "subtitle", "time": 5416.87, "timestamp": "01:30:16", "text": "不能好好直播《Apex英雄》和《Valerant》。"}, {"type": "subtitle", "time": 5418.95, "timestamp": "01:30:18", "text": "你需要隱藏右上角的遊戲"}, {"type": "subtitle", "time": 5421.75, "timestamp": "01:30:21", "text": "內聊天和殺死訊息。"}, {"type": "subtitle", "time": 5424.07, "timestamp": "01:30:24", "text": "你得把它模糊處理。你必須在主播板上。  你不應該透露隊友的"}, {"type": "subtitle", "time": 5427.43, "timestamp": "01:30:27", "text": "名字以及你自己的名字。"}, {"type": "subtitle", "time": 5436.31, "timestamp": "01:30:36", "text": "限制太多了，"}, {"type": "subtitle", "time": 5438.709, "timestamp": "01:30:38", "text": "你不能玩像GTA之類的暴力血腥遊戲。"}, {"type": "subtitle", "time": 5444.149, "timestamp": "01:30:44", "text": "我在 Joathon 期間直播的時候，和幾個 INV YouTuber 一起進行了一場關於森林的合作直播。  現在我忘了那件事，我盲目地直播，結果因為性方面的"}, {"type": "subtitle", "time": 5447.669, "timestamp": "01:30:47", "text": "違規行為受到了懲罰，因為森林裡的NPC都是裸體的"}, {"type": "subtitle", "time": 5451.75, "timestamp": "01:30:51", "text": "。不，我記得好像有個女性NPC。就像女性的那種東西。所以，當時的情況有點像是赤裸裸。不。我因為一些性方面的……"}]
[{"type": "subtitle", "time": 21901.43, "timestamp": "06:05:01", "text": "這裡有個眼睛圖標，這個東西有個眼睛圖標。背景影像圓形徑向背景影像大小[音樂]"}, {"type": "subtitle", "time": 21908.948, "timestamp": "06:05:08", "text": "可見性設定背景影像為"}, {"type": "subtitle", "time": 21911.51, "timestamp": "06:05:11", "text": "無"}, {"type": "subtitle", "time": 21919.67, "timestamp": "06:05:19", "text": "。哦。 [音樂]所以某種程度上，我想我會替換這個徑向的這個背景圖像。對吧？某種程度上，"}, {"type": "subtitle", "time": 21921.75, "timestamp": "06:05:21", "text": "我會動態地有條件地渲染這個東西。呃，總之，這應該是另一個，對吧？雜訊。 [音樂]你知道嗎？"}, {"type": "subtitle", "time": 21946.788, "timestamp": "06:05:46", "text": "我會加上複製的紋理雜訊。紋理。呃，為什麼不呢？沒人會知道"}, {"type": "subtitle", "time": 21950.07, "timestamp": "06:05:50", "text": "。我想我不知道。"}, {"type": "subtitle", "time": 21955.75, "timestamp": "06:05:55", "text": "我在直播裡說了。如果有人分享這個片段，我會進去的。"}]
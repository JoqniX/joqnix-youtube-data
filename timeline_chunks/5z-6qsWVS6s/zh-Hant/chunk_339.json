[{"type": "subtitle", "time": 20341.99, "timestamp": "05:39:01", "text": "黑手黨借另一半。等等，什麼？他從大學開始和黑手黨老大是朋友。好吧"}, {"type": "subtitle", "time": 20345.27, "timestamp": "05:39:05", "text": "。"}, {"type": "subtitle", "time": 20379.11, "timestamp": "05:39:39", "text": "不。他出院後，開始仔細檢查他需要支付的所有帳單。他付了錢。他立刻意識到自己無法全部"}]
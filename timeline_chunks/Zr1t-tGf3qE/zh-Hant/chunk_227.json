[{"type": "subtitle", "time": 13653.83, "timestamp": "03:47:33", "text": "好吧，我真的窮死了。我的天啊。這曾經在這裡看過Shroud的演出。我想殺了那傢伙。  嘿，我"}, {"type": "subtitle", "time": 13655.67, "timestamp": "03:47:35", "text": "只有一個。所以，這是一個使用呃那裡的玩家。  我的天啊，那是堡壘！  它們就在下面。"}, {"type": "subtitle", "time": 13668.87, "timestamp": "03:47:48", "text": "好的。我要去哪裡？"}, {"type": "subtitle", "time": 13672.63, "timestamp": "03:47:52", "text": "所有人都喊著：嘿"}]
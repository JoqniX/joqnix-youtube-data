[{"type": "subtitle", "time": 1507.51, "timestamp": "00:25:07", "text": "時刻保持在線。"}, {"type": "subtitle", "time": 1526.07, "timestamp": "00:25:26", "text": "離開"}, {"type": "subtitle", "time": 1536.71, "timestamp": "00:25:36", "text": "這裡。  當然。  他試圖殺"}, {"type": "subtitle", "time": 1537.99, "timestamp": "00:25:37", "text": "我。  可可。  你好。  我想把屍體從那傢伙身上弄走。  機器人。  哦，繃帶癒合。好的。  嘗試自殺15分鐘。哦，你們倆怎麼了？哦，你的橡皮鴨。"}, {"type": "subtitle", "time": 1540.149, "timestamp": "00:25:40", "text": "我喜歡土豆橋。  親愛的"}, {"type": "subtitle", "time": 1550.95, "timestamp": "00:25:50", "text": "，我躲在"}, {"type": "subtitle", "time": 1555.75, "timestamp": "00:25:55", "text": "門後跟你說了些事。我的天啊。  特惠繃帶。時間緊迫。"}]
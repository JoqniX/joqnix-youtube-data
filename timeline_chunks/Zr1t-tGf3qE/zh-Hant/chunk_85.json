[{"type": "subtitle", "time": 5124.95, "timestamp": "01:25:24", "text": "但如果我身處高級大廳之類的，那就不會了。我的天啊，人們會直接殺了你，"}, {"type": "subtitle", "time": 5126.47, "timestamp": "01:25:26", "text": "搶走你的戰利品，然後"}, {"type": "subtitle", "time": 5128.31, "timestamp": "01:25:28", "text": "撤離什麼的。 現在是最後一位"}, {"type": "subtitle", "time": 5133.35, "timestamp": "01:25:33", "text": "法典了"}, {"type": "subtitle", "time": 5134.79, "timestamp": "01:25:34", "text": "。 好吧，"}, {"type": "subtitle", "time": 5150.39, "timestamp": "01:25:50", "text": "我沒採到蠟燭莓。  哦"}]
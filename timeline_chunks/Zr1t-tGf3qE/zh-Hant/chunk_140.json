[{"type": "subtitle", "time": 8402.15, "timestamp": "02:20:02", "text": "哦好的。  好的。  所以，我打算採用這種方案。  好的。  如果"}, {"type": "subtitle", "time": 8409.19, "timestamp": "02:20:09", "text": "你們"}, {"type": "subtitle", "time": 8412.23, "timestamp": "02:20:12", "text": "重逢了，請耐心等待"}, {"type": "subtitle", "time": 8421.67, "timestamp": "02:20:21", "text": "。我們喜歡好消息。  光線，我早早地就折斷了"}, {"type": "subtitle", "time": 8452.79, "timestamp": "02:20:52", "text": "你好。  你好。  哦，你要去睡覺了。你好。晚安。  祝你睡個好覺。  為什麼選擇"}]
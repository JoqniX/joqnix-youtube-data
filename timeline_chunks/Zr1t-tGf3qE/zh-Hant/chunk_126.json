[{"type": "subtitle", "time": 7579.83, "timestamp": "02:06:19", "text": "？哪個？  呃，3D的那個。我還有它。"}, {"type": "subtitle", "time": 7588.07, "timestamp": "02:06:28", "text": "只是我沒有那個文件的Void版本"}, {"type": "subtitle", "time": 7598.069, "timestamp": "02:06:38", "text": "。我只有它的VRM文件。  嗯，我當時想的是，我乾脆再做一個新的什麼的。沒有"}, {"type": "subtitle", "time": 7609.109, "timestamp": "02:06:49", "text": "把握。  我忘了什麼東西"}, {"type": "subtitle", "time": 7612.709, "timestamp": "02:06:52", "text": "。"}, {"type": "subtitle", "time": 7615.189, "timestamp": "02:06:55", "text": "看到鄰居們"}, {"type": "subtitle", "time": 7618.229, "timestamp": "02:06:58", "text": "圍坐在一起共進晚餐。  各種種子。  真讓人納悶"}]
[{"type": "subtitle", "time": 4805.99, "timestamp": "01:20:05", "text": "然後與這些機器人或玩家戰鬥，收集一些戰利品，努力生存下來"}, {"type": "subtitle", "time": 4831.189, "timestamp": "01:20:31", "text": "那裡得到它。嗯？  自定義"}, {"type": "subtitle", "time": 4835.43, "timestamp": "01:20:35", "text": "零件工具。  好了"}, {"type": "subtitle", "time": 4836.95, "timestamp": "01:20:36", "text": "，我們走吧。免費送貨。"}, {"type": "subtitle", "time": 4839.51, "timestamp": "01:20:39", "text": "我們會報導寒潮、新版本更新以及雪景地圖之"}, {"type": "subtitle", "time": 4841.35, "timestamp": "01:20:41", "text": "類的東西"}, {"type": "subtitle", "time": 4842.39, "timestamp": "01:20:42", "text": "。  看著我被雪迅速凍死吧。  是的，"}, {"type": "subtitle", "time": 4849.03, "timestamp": "01:20:49", "text": "我們的目標是"}, {"type": "subtitle", "time": 4851.189, "timestamp": "01:20:51", "text": "找到一些蠟燭莓。  我獲得了"}]
[{"type": "subtitle", "time": 4153.11, "timestamp": "01:09:13", "text": "我該如何"}, {"type": "subtitle", "time": 4171.03, "timestamp": "01:09:31", "text": "沒關係。沒關係。沒關係。我勉強能到，我勉強"}, {"type": "subtitle", "time": 4172.87, "timestamp": "01:09:32", "text": "能到，對不起"}, {"type": "subtitle", "time": 4177.99, "timestamp": "01:09:37", "text": "。  會"}]
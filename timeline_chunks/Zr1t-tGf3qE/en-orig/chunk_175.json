[{"type": "subtitle", "time": 10503.99, "timestamp": "02:55:03", "text": ">> And search any arc."}, {"type": "subtitle", "time": 10505.91, "timestamp": "02:55:05", "text": ">> Shaunie told me about what you found."}, {"type": "subtitle", "time": 10507.349, "timestamp": "02:55:07", "text": ">> What is this?"}, {"type": "subtitle", "time": 10512.87, "timestamp": "02:55:12", "text": "We've seen a lot more probes beaming"}, {"type": "subtitle", "time": 10514.79, "timestamp": "02:55:14", "text": "across the skies."}, {"type": "subtitle", "time": 10515.429, "timestamp": "02:55:15", "text": ">> Okay."}, {"type": "subtitle", "time": 10521.03, "timestamp": "02:55:21", "text": "We've heard tales of what happens if"}, {"type": "subtitle", "time": 10523.51, "timestamp": "02:55:23", "text": "they find what they're looking for."}, {"type": "subtitle", "time": 10527.59, "timestamp": "02:55:27", "text": ">> Oh, they might be myths, but"}, {"type": "subtitle", "time": 10529.11, "timestamp": "02:55:29", "text": "I don't want us finding out the hard"}, {"type": "subtitle", "time": 10529.75, "timestamp": "02:55:29", "text": "way."}, {"type": "subtitle", "time": 10540.07, "timestamp": "02:55:40", "text": "Bad feeling."}, {"type": "subtitle", "time": 10541.59, "timestamp": "02:55:41", "text": ">> Even the slightest change to Ark's"}, {"type": "subtitle", "time": 10544.55, "timestamp": "02:55:44", "text": "behavior could spell"}, {"type": "subtitle", "time": 10545.19, "timestamp": "02:55:45", "text": "career."}, {"type": "subtitle", "time": 10546.79, "timestamp": "02:55:46", "text": ">> It's like nothing we've ever picked up."}, {"type": "subtitle", "time": 10549.19, "timestamp": "02:55:49", "text": "Good. Break open any probe or courier"}, {"type": "subtitle", "time": 10550.79, "timestamp": "02:55:50", "text": "you see on the surface and report back"}]
[{"type": "subtitle", "time": 1203.029, "timestamp": "00:20:03", "text": "Arritus 是一款什么类型的游戏？ 它就像"}, {"type": "subtitle", "time": 1206.15, "timestamp": "00:20:06", "text": "一款更黑暗但"}, {"type": "subtitle", "time": 1229.75, "timestamp": "00:20:29", "text": "而敌人则是人工智能（AI）和机器"}, {"type": "subtitle", "time": 1234.71, "timestamp": "00:20:34", "text": "学习。 它们会从你身上学习，它们会"}, {"type": "subtitle", "time": 1236.95, "timestamp": "00:20:36", "text": "随着时间的推移而学习，"}, {"type": "subtitle", "time": 1239.75, "timestamp": "00:20:39", "text": "或者说，在这个游戏中，机器人被称为弧线"}, {"type": "subtitle", "time": 1242.63, "timestamp": "00:20:42", "text": "。"}]
[{"type": "subtitle", "time": 1997.43, "timestamp": "00:33:17", "text": "哦，这个不错。星界石"}, {"type": "subtitle", "time": 2005.59, "timestamp": "00:33:25", "text": "嗯，有人交易星界石吗？哦，他们有"}, {"type": "subtitle", "time": 2010.389, "timestamp": "00:33:30", "text": "个NPC商店。等等，这让我想起了……"}, {"type": "subtitle", "time": 2012.31, "timestamp": "00:33:32", "text": "呃，那是什么游戏来着？《循环"}, {"type": "subtitle", "time": 2016.149, "timestamp": "00:33:36", "text": "前线》。对，就是那个。"}, {"type": "subtitle", "time": 2017.75, "timestamp": "00:33:37", "text": "枪店。哦，这是"}, {"type": "subtitle", "time": 2020.549, "timestamp": "00:33:40", "text": "买枪的地方。"}, {"type": "subtitle", "time": 2022.389, "timestamp": "00:33:42", "text": "有人送过你蜡烛莓香皂"}, {"type": "subtitle", "time": 2024.31, "timestamp": "00:33:44", "text": "吗？"}, {"type": "subtitle", "time": 2027.99, "timestamp": "00:33:47", "text": "哦，天哪，我们来试试这个。"}, {"type": "subtitle", "time": 2031.029, "timestamp": "00:33:51", "text": "哦，等等。这是《地狱潜行者》那种"}, {"type": "subtitle", "time": 2033.19, "timestamp": "00:33:53", "text": "系统吗？"}, {"type": "subtitle", "time": 2035.11, "timestamp": "00:33:55", "text": "等等，"}]
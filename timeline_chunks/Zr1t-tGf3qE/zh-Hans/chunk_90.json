[{"type": "subtitle", "time": 5410.95, "timestamp": "01:30:10", "text": "我的天哪。"}, {"type": "subtitle", "time": 5419.669, "timestamp": "01:30:19", "text": "兄弟。哦，"}, {"type": "subtitle", "time": 5421.189, "timestamp": "01:30:21", "text": "兄弟。"}, {"type": "subtitle", "time": 5425.27, "timestamp": "01:30:25", "text": "我拿到好东西了。我不想，"}, {"type": "subtitle", "time": 5432.79, "timestamp": "01:30:32", "text": "等等，我没有盾牌之"}, {"type": "subtitle", "time": 5435.51, "timestamp": "01:30:35", "text": "类的东西。哦，天哪，他朝我开枪了。我想杀了他。"}, {"type": "subtitle", "time": 5439.91, "timestamp": "01:30:39", "text": "别开枪。别开枪。"}]
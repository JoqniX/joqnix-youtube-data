[{"type": "subtitle", "time": 6485.59, "timestamp": "01:48:05", "text": "呃，"}, {"type": "subtitle", "time": 6487.35, "timestamp": "01:48:07", "text": "我觉得这是"}, {"type": "subtitle", "time": 6521.03, "timestamp": "01:48:41", "text": "我也收到了一些跟踪资料。 我把它"}, {"type": "subtitle", "time": 6524.87, "timestamp": "01:48:44", "text": "弄丢了。 哦，我该如何杀死那个敌人？"}, {"type": "subtitle", "time": 6528.07, "timestamp": "01:48:48", "text": "那弧线就像"}, {"type": "subtitle", "time": 6530.95, "timestamp": "01:48:50", "text": "火箭一样。 我该如何杀死它？ 我"}, {"type": "subtitle", "time": 6534.47, "timestamp": "01:48:54", "text": "附近有人。"}, {"type": "subtitle", "time": 6536.31, "timestamp": "01:48:56", "text": "哦，你可以查看他们的个人资料之"}]
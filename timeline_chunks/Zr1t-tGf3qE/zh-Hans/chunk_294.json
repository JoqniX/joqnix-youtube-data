[{"type": "subtitle", "time": 17641.43, "timestamp": "04:54:01", "text": "终于。"}, {"type": "subtitle", "time": 17643.35, "timestamp": "04:54:03", "text": "好的，让我来做。我会那样做的"}, {"type": "subtitle", "time": 17648.07, "timestamp": "04:54:08", "text": "。让我升级我的肯德基。"}, {"type": "subtitle", "time": 17653.43, "timestamp": "04:54:13", "text": "好的。呃，火车升级。会"}, {"type": "subtitle", "time": 17656.07, "timestamp": "04:54:16", "text": "发生什么？所以，你需要柠檬和"}, {"type": "subtitle", "time": 17659.03, "timestamp": "04:54:19", "text": "杏子，"}, {"type": "subtitle", "time": 17662.708, "timestamp": "04:54:22", "text": "以及更多的自信。好的。当"}, {"type": "subtitle", "time": 17667.59, "timestamp": "04:54:27", "text": "我们看到柠檬和杏子时，我们会得到"}, {"type": "subtitle", "time": 17670.31, "timestamp": "04:54:30", "text": "哇。"}, {"type": "subtitle", "time": 17674.55, "timestamp": "04:54:34", "text": "所以我想它会得到更多这些"}, {"type": "subtitle", "time": 17677.83, "timestamp": "04:54:37", "text": "。二级狂暴。好的，我"}, {"type": "subtitle", "time": 17680.55, "timestamp": "04:54:40", "text": "想你可以把这家伙升到满级。"}, {"type": "subtitle", "time": 17687.59, "timestamp": "04:54:47", "text": "等级"}, {"type": "subtitle", "time": 17690.628, "timestamp": "04:54:50", "text": "是陨石坑。"}, {"type": "subtitle", "time": 17694.23, "timestamp": "04:54:54", "text": "好的。好的。呃，最高等级是五级。所以"}, {"type": "subtitle", "time": 17697.99, "timestamp": "04:54:57", "text": "一级是狗项圈。拾荒者等级"}]
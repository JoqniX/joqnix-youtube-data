[{"type": "subtitle", "time": 3689.03, "timestamp": "01:01:29", "text": "呃，"}, {"type": "subtitle", "time": 3691.589, "timestamp": "01:01:31", "text": "所有掠夺者，屏幕上显示着方舟。"}, {"type": "subtitle", "time": 3693.829, "timestamp": "01:01:33", "text": "还剩5分钟。快去找回家的路。我"}, {"type": "subtitle", "time": 3695.829, "timestamp": "01:01:35", "text": "会的。哦，"}, {"type": "subtitle", "time": 3697.829, "timestamp": "01:01:37", "text": "该死。哦，不。不。不。不。不。不。不。不。"}]
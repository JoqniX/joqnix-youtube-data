[{"type": "subtitle", "time": 10503.99, "timestamp": "02:55:03", "text": "搜索任意弧。"}, {"type": "subtitle", "time": 10505.91, "timestamp": "02:55:05", "text": "Shaunie 把你的发现告诉了我。"}, {"type": "subtitle", "time": 10507.349, "timestamp": "02:55:07", "text": "这是什么？"}, {"type": "subtitle", "time": 10512.87, "timestamp": "02:55:12", "text": "我们看到更多探测器在天空中发射光束"}, {"type": "subtitle", "time": 10514.79, "timestamp": "02:55:14", "text": "。"}, {"type": "subtitle", "time": 10515.429, "timestamp": "02:55:15", "text": "好的。"}, {"type": "subtitle", "time": 10521.03, "timestamp": "02:55:21", "text": "我们听说过如果"}, {"type": "subtitle", "time": 10523.51, "timestamp": "02:55:23", "text": "他们找到了自己要找的东西会发生什么。"}, {"type": "subtitle", "time": 10527.59, "timestamp": "02:55:27", "text": "哦，它们或许只是传说，但"}, {"type": "subtitle", "time": 10529.11, "timestamp": "02:55:29", "text": "我不想让我们用惨痛的教训来验证这一点"}, {"type": "subtitle", "time": 10529.75, "timestamp": "02:55:29", "text": "。"}, {"type": "subtitle", "time": 10540.07, "timestamp": "02:55:40", "text": "不祥的预感。"}, {"type": "subtitle", "time": 10541.59, "timestamp": "02:55:41", "text": "即使Ark的行为发生最轻微的变化，也"}, {"type": "subtitle", "time": 10544.55, "timestamp": "02:55:44", "text": "可能决定他的"}, {"type": "subtitle", "time": 10545.19, "timestamp": "02:55:45", "text": "职业生涯。"}, {"type": "subtitle", "time": 10546.79, "timestamp": "02:55:46", "text": "这跟我们以前捡到的任何东西都不一样。"}, {"type": "subtitle", "time": 10549.19, "timestamp": "02:55:49", "text": "好的。 拆开你在地面上看到的任何探测器或快递器，"}, {"type": "subtitle", "time": 10550.79, "timestamp": "02:55:50", "text": "然后汇报"}]
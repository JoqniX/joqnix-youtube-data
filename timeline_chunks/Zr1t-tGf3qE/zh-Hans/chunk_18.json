[{"type": "subtitle", "time": 1084.71, "timestamp": "00:18:04", "text": "亲爱的，我"}, {"type": "subtitle", "time": 1086.95, "timestamp": "00:18:06", "text": "躲在门后跟你说了些事。"}, {"type": "subtitle", "time": 1090.07, "timestamp": "00:18:10", "text": "我的天啊。"}, {"type": "subtitle", "time": 1093.51, "timestamp": "00:18:13", "text": "特惠绷带。 时间紧迫。"}, {"type": "subtitle", "time": 1100.87, "timestamp": "00:18:20", "text": "我还活着。 如何？ 但我死了。 等等，"}, {"type": "subtitle", "time": 1125.59, "timestamp": "00:18:45", "text": "啊，他们屏蔽了。 我本来想把"}, {"type": "subtitle", "time": 1128.63, "timestamp": "00:18:48", "text": "我杀的那个人的尸体搬上楼，但是，"}]
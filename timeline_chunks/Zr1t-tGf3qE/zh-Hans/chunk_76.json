[{"type": "subtitle", "time": 4589.27, "timestamp": "01:16:29", "text": "电梯准备好了。别"}, {"type": "subtitle", "time": 4593.27, "timestamp": "01:16:33", "text": "开枪。嘿，别开枪。糟糕。"}, {"type": "subtitle", "time": 4597.51, "timestamp": "01:16:37", "text": "我应该直接杀了它吗？不。不。不。不。不。没事的。没事的"}, {"type": "subtitle", "time": 4601.11, "timestamp": "01:16:41", "text": "。"}, {"type": "subtitle", "time": 4606.709, "timestamp": "01:16:46", "text": "我很想。我很想杀了它。但这是"}, {"type": "subtitle", "time": 4609.03, "timestamp": "01:16:49", "text": "因为大家都是新手，所以"}, {"type": "subtitle", "time": 4612.07, "timestamp": "01:16:52", "text": "他们想谨慎行事吗？"}, {"type": "subtitle", "time": 4615.189, "timestamp": "01:16:55", "text": "袭击就在附近。"}, {"type": "subtitle", "time": 4619.83, "timestamp": "01:16:59", "text": "她知道那些乱七八糟的事情。好的。"}]
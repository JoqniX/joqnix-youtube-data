[{"type": "subtitle", "time": 2701.19, "timestamp": "00:45:01", "text": "技能树。哦，"}, {"type": "subtitle", "time": 2706.87, "timestamp": "00:45:06", "text": "一个声音有点怪异，之后可能会出错。哦，"}, {"type": "subtitle", "time": 2708.309, "timestamp": "00:45:08", "text": "蹲伏时的移动速度"}, {"type": "subtitle", "time": 2709.99, "timestamp": "00:45:09", "text": "提高了。你可以更快地攀爬和行走"}, {"type": "subtitle", "time": 2713.51, "timestamp": "00:45:13", "text": "。不会减速。佩戴盾牌"}, {"type": "subtitle", "time": 2717.109, "timestamp": "00:45:17", "text": "不会像以前那样减慢你的速度。"}, {"type": "subtitle", "time": 2721.589, "timestamp": "00:45:21", "text": "我该怎么办？"}, {"type": "subtitle", "time": 2724.47, "timestamp": "00:45:24", "text": "我想我会选择红色。我"}, {"type": "subtitle", "time": 2728.63, "timestamp": "00:45:28", "text": "有多少？没有显示。嗯？"}, {"type": "subtitle", "time": 2731.27, "timestamp": "00:45:31", "text": "好吧，我选这个。我"}, {"type": "subtitle", "time": 2742.63, "timestamp": "00:45:42", "text": "很弱？哦，我得制作弹药之类的"}, {"type": "subtitle", "time": 2757.03, "timestamp": "00:45:57", "text": "等等，我怎么扩充我的仓库？"}, {"type": "subtitle", "time": 2759.91, "timestamp": "00:45:59", "text": "哦，对了。我刚花了钱。5000"}]
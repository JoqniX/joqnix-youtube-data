[{"type": "subtitle", "time": 7333.83, "timestamp": "02:02:13", "text": "为什么我的“不要开枪？” 因为其他"}, {"type": "subtitle", "time": 7337.43, "timestamp": "02:02:17", "text": "玩家可能会杀了我。"}, {"type": "subtitle", "time": 7340.149, "timestamp": "02:02:20", "text": "我现在才开始玩这个游戏，所以"}, {"type": "subtitle", "time": 7343.03, "timestamp": "02:02:23", "text": "匹配到的都是新玩家。"}, {"type": "subtitle", "time": 7345.99, "timestamp": "02:02:25", "text": "但如果我身处高级大厅之类的"}, {"type": "subtitle", "time": 7348.55, "timestamp": "02:02:28", "text": "，那就不会了。   我的"}, {"type": "subtitle", "time": 7351.27, "timestamp": "02:02:31", "text": "天啊，人们会直接杀了你，"}, {"type": "subtitle", "time": 7354.07, "timestamp": "02:02:34", "text": "抢走你的战利品，"}, {"type": "subtitle", "time": 7357.589, "timestamp": "02:02:37", "text": "然后撤离什么的。"}, {"type": "subtitle", "time": 7366.709, "timestamp": "02:02:46", "text": "好吧，我没采到蜡烛莓。 屋顶。"}, {"type": "subtitle", "time": 7378.229, "timestamp": "02:02:58", "text": "解锁了一个很棒的功能。 法典。 什么是"}]
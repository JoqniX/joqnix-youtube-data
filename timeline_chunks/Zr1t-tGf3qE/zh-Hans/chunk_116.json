[{"type": "subtitle", "time": 6968.229, "timestamp": "01:56:08", "text": "你想允许吗？这是什么？"}, {"type": "subtitle", "time": 6969.589, "timestamp": "01:56:09", "text": "希望你穿得应季一些，"}, {"type": "subtitle", "time": 6971.51, "timestamp": "01:56:11", "text": "突袭者队队员。 今天是个采摘"}, {"type": "subtitle", "time": 6973.109, "timestamp": "01:56:13", "text": "烛莓的好日子，但要注意"}, {"type": "subtitle", "time": 6974.31, "timestamp": "01:56:14", "text": "防冻伤。"}, {"type": "subtitle", "time": 6983.43, "timestamp": "01:56:23", "text": "罐。"}, {"type": "subtitle", "time": 7004.79, "timestamp": "01:56:44", "text": "我听到有人开枪。 我觉得我一个人活不下去"}]
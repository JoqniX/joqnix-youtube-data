[{"type": "subtitle", "time": 2419.19, "timestamp": "00:40:19", "text": "搜刮来的。"}, {"type": "subtitle", "time": 2423.19, "timestamp": "00:40:23", "text": "我好害怕，伙计。为什么感觉像……说"}, {"type": "subtitle", "time": 2429.109, "timestamp": "00:40:29", "text": "实话，感觉有点像大逃杀，但你"}, {"type": "subtitle", "time": 2430.55, "timestamp": "00:40:30", "text": "知道会有其他"}, {"type": "subtitle", "time": 2433.43, "timestamp": "00:40:33", "text": "玩家。你知道你必须"}, {"type": "subtitle", "time": 2435.51, "timestamp": "00:40:35", "text": "找到你的…… 搜刮战利品，想办法"}, {"type": "subtitle", "time": 2437.19, "timestamp": "00:40:37", "text": "活下去"}, {"type": "subtitle", "time": 2438.71, "timestamp": "00:40:38", "text": "。"}, {"type": "subtitle", "time": 2441.27, "timestamp": "00:40:41", "text": "呃，如果你活不下去，你"}, {"type": "subtitle", "time": 2443.51, "timestamp": "00:40:43", "text": "搜刮到的所有东西都会消失。"}]
[{"type": "subtitle", "time": 1927.269, "timestamp": "00:32:07", "text": "自定义。"}, {"type": "subtitle", "time": 1929.75, "timestamp": "00:32:09", "text": "哇，你真的需要……我想要"}, {"type": "subtitle", "time": 1933.11, "timestamp": "00:32:13", "text": "这个颜色。白色和粉色。呃，白色"}, {"type": "subtitle", "time": 1936.07, "timestamp": "00:32:16", "text": "和紫色。现在看起来像我的颜色了"}, {"type": "subtitle", "time": 1943.83, "timestamp": "00:32:23", "text": "哦，这是一个头盔。好的。好的。 我觉得"}, {"type": "subtitle", "time": 1946.389, "timestamp": "00:32:26", "text": "它应该可以关掉。好吧，看起来"}, {"type": "subtitle", "time": 1949.99, "timestamp": "00:32:29", "text": "不错。头盔。手电筒。这里有个手电筒。"}, {"type": "subtitle", "time": 1951.83, "timestamp": "00:32:31", "text": "哦，"}, {"type": "subtitle", "time": 1954.23, "timestamp": "00:32:34", "text": "水下摄像头。这里有个水下"}, {"type": "subtitle", "time": 1957.269, "timestamp": "00:32:37", "text": "摄像头。天哪。东西"}, {"type": "subtitle", "time": 1959.509, "timestamp": "00:32:39", "text": "太多了。等等，哪个是"}, {"type": "subtitle", "time": 1962.149, "timestamp": "00:32:42", "text": "花生炮？是这个吗"}, {"type": "subtitle", "time": 1964.23, "timestamp": "00:32:44", "text": "？不是。"}, {"type": "subtitle", "time": 1967.269, "timestamp": "00:32:47", "text": "哦，还有这个。不错。"}, {"type": "subtitle", "time": 1971.83, "timestamp": "00:32:51", "text": "皮肤好多啊。什么？"}, {"type": "subtitle", "time": 1974.63, "timestamp": "00:32:54", "text": "10级。哦，这个是免费的。"}]
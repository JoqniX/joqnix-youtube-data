[{"type": "subtitle", "time": 4682.07, "timestamp": "01:18:02", "text": "。好的。"}, {"type": "subtitle", "time": 4690.07, "timestamp": "01:18:10", "text": "这是手枪吗？这看起来像"}, {"type": "subtitle", "time": 4693.11, "timestamp": "01:18:13", "text": "火箭。什么鬼？好的，"}, {"type": "subtitle", "time": 4702.55, "timestamp": "01:18:22", "text": "我该如何升级我的制作工坊？"}, {"type": "subtitle", "time": 4705.51, "timestamp": "01:18:25", "text": "蓝图。"}, {"type": "subtitle", "time": 4708.47, "timestamp": "01:18:28", "text": "安装。哦，"}, {"type": "subtitle", "time": 4713.51, "timestamp": "01:18:33", "text": "装备工作台。枪匠。医疗实验室。这个……"}, {"type": "subtitle", "time": 4717.51, "timestamp": "01:18:37", "text": "呃，"}, {"type": "subtitle", "time": 4720.55, "timestamp": "01:18:40", "text": "购买装备赚了我的销售配额。怎么做到的？"}, {"type": "subtitle", "time": 4723.27, "timestamp": "01:18:43", "text": "我该卖给谁？这些人。我"}, {"type": "subtitle", "time": 4725.51, "timestamp": "01:18:45", "text": "得购买我的内部处理器"}, {"type": "subtitle", "time": 4727.669, "timestamp": "01:18:47", "text": "来模拟舒适度。"}, {"type": "subtitle", "time": 4732.95, "timestamp": "01:18:52", "text": "你试过用烛"}]
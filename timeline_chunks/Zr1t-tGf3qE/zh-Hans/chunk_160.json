[{"type": "subtitle", "time": 9604.63, "timestamp": "02:40:04", "text": "啪啪声，爆炸，护盾充能器。 好的。   糟糕"}, {"type": "subtitle", "time": 9608.87, "timestamp": "02:40:08", "text": "，我们只能重新装弹了"}, {"type": "subtitle", "time": 9616.389, "timestamp": "02:40:16", "text": "不，我还是跟那个白吃白喝的人一起去吧。"}, {"type": "subtitle", "time": 9627.51, "timestamp": "02:40:27", "text": "我才买了酒瓶和"}]
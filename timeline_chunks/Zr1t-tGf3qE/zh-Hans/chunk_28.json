[{"type": "subtitle", "time": 1685.19, "timestamp": "00:28:05", "text": "好了，我回来了。 我回来了。 我回来了。 那只"}, {"type": "subtitle", "time": 1687.269, "timestamp": "00:28:07", "text": "狗在散步是因为它需要"}, {"type": "subtitle", "time": 1690.31, "timestamp": "00:28:10", "text": "水。 那里有一只蝴蝶，"}, {"type": "subtitle", "time": 1694.87, "timestamp": "00:28:14", "text": "还有一只乌鸦。 呃，我们……那只狗好像在说：“"}, {"type": "subtitle", "time": 1700.95, "timestamp": "00:28:20", "text": "我的天哪。我跑了。我跑了。好吧，它"}, {"type": "subtitle", "time": 1704.549, "timestamp": "00:28:24", "text": "在后院，就"}, {"type": "subtitle", "time": 1706.789, "timestamp": "00:28:26", "text": "在树下，很安静，就像在"}, {"type": "subtitle", "time": 1709.43, "timestamp": "00:28:29", "text": "休息。它好像在"}, {"type": "subtitle", "time": 1712.549, "timestamp": "00:28:32", "text": "试图抓住一只蝴蝶，或者类似"}, {"type": "subtitle", "time": 1716.87, "timestamp": "00:28:36", "text": "蝴蝶的东西。还有一只乌鸦或"}, {"type": "subtitle", "time": 1720.549, "timestamp": "00:28:40", "text": "鸟在发出叫声。所以它就莫名其妙地对着"}, {"type": "subtitle", "time": 1725.99, "timestamp": "00:28:45", "text": "它吠叫。我的天哪。"}, {"type": "subtitle", "time": 1728.47, "timestamp": "00:28:48", "text": "好吧。所以，一起玩吧。不，我要"}, {"type": "subtitle", "time": 1731.51, "timestamp": "00:28:51", "text": "单人玩。"}, {"type": "subtitle", "time": 1737.43, "timestamp": "00:28:57", "text": "Born Crown套装里的这个功能是什么"}]
[{"type": "subtitle", "time": 2299.51, "timestamp": "00:38:19", "text": "好的，我的电脑卡顿了。真的卡。"}, {"type": "subtitle", "time": 2301.75, "timestamp": "00:38:21", "text": "让我关掉浏览器。好的，我进来了"}, {"type": "subtitle", "time": 2303.03, "timestamp": "00:38:23", "text": "。我是"}, {"type": "subtitle", "time": 2305.43, "timestamp": "00:38:25", "text": "Shnie。别忘了你可以"}, {"type": "subtitle", "time": 2306.87, "timestamp": "00:38:26", "text": "在不同的地方找到不同类型的战利品"}, {"type": "subtitle", "time": 2309.67, "timestamp": "00:38:29", "text": "。查看你的地图"}, {"type": "subtitle", "time": 2311.43, "timestamp": "00:38:31", "text": "，前往我"}, {"type": "subtitle", "time": 2313.67, "timestamp": "00:38:33", "text": "用图标标记的任意地点。"}, {"type": "subtitle", "time": 2315.91, "timestamp": "00:38:35", "text": "有没有哪个区域有"}, {"type": "subtitle", "time": 2322.55, "timestamp": "00:38:42", "text": "战利品价值高，中等。"}, {"type": "subtitle", "time": 2324.31, "timestamp": "00:38:44", "text": "掠夺者在哪里？好的，那里有个"}, {"type": "subtitle", "time": 2326.79, "timestamp": "00:38:46", "text": "掠夺者舱口。"}, {"type": "subtitle", "time": 2333.19, "timestamp": "00:38:53", "text": "我好害怕。好的，我有一套免费的装备"}, {"type": "subtitle", "time": 2335.67, "timestamp": "00:38:55", "text": "。好的。"}, {"type": "subtitle", "time": 2337.51, "timestamp": "00:38:57", "text": "嗯嗯嗯嗯"}]
[{"type": "subtitle", "time": 14042.55, "timestamp": "03:54:02", "text": "等等，让我看看。 这样你就获得了一个"}, {"type": "subtitle", "time": 14045.349, "timestamp": "03:54:05", "text": "永久解锁。 你穿上一身类似掠夺者的"}, {"type": "subtitle", "time": 14050.389, "timestamp": "03:54:10", "text": "装束。 你的……嗯……清洁工废料。 是啊，"}, {"type": "subtitle", "time": 14053.67, "timestamp": "03:54:13", "text": "鸡腿肉。  Scrappy 会得到类似"}, {"type": "subtitle", "time": 14056.95, "timestamp": "03:54:16", "text": "帽子之类的东西。 那里会有一顶帽子。"}, {"type": "subtitle", "time": 14058.469, "timestamp": "03:54:18", "text": "此外，还会获得"}, {"type": "subtitle", "time": 14062.15, "timestamp": "03:54:22", "text": "12 个储物空间，以及"}, {"type": "subtitle", "time": 14064.389, "timestamp": "03:54:24", "text": "根据你出发时的储物空间价值计算的最多 5 点额外技能点数"}, {"type": "subtitle", "time": 14067.67, "timestamp": "03:54:27", "text": "。 是的，他们"}, {"type": "subtitle", "time": 14070.79, "timestamp": "03:54:30", "text": "会给你一个临时的增益效果，直到下一个"}, {"type": "subtitle", "time": 14074.389, "timestamp": "03:54:34", "text": "探险窗口期到来。"}, {"type": "subtitle", "time": 14077.189, "timestamp": "03:54:37", "text": "这就像一次软重启。"}, {"type": "subtitle", "time": 14079.349, "timestamp": "03:54:39", "text": "你派遣你的掠夺者进行远征，这"}, {"type": "subtitle", "time": 14082.469, "timestamp": "03:54:42", "text": "相当于软重置，让你获得"}, {"type": "subtitle", "time": 14084.71, "timestamp": "03:54:44", "text": "一个新的掠夺者，但会"}, {"type": "subtitle", "time": 14086.79, "timestamp": "03:54:46", "text": "保留这些永久和"}, {"type": "subtitle", "time": 14089.429, "timestamp": "03:54:49", "text": "临时的加成。"}, {"type": "subtitle", "time": 14091.91, "timestamp": "03:54:51", "text": "好的。 为了最大限度地利用河流，出发前请用高价值物品和金币装满你的储藏处"}, {"type": "subtitle", "time": 14094.71, "timestamp": "03:54:54", "text": "和洞穴"}, {"type": "subtitle", "time": 14098.229, "timestamp": "03:54:58", "text": "。"}]
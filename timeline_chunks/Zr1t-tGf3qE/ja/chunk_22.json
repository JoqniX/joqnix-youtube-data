[{"type": "subtitle", "time": 1371.35, "timestamp": "00:22:51", "text": "音声の状態について教えていただけますか？"}, {"type": "subtitle", "time": 1373.99, "timestamp": "00:22:53", "text": "ゲームの音が大きすぎますか？ 私の声は大きすぎますか？ 私に知らせないでください"}, {"type": "subtitle", "time": 1374.87, "timestamp": "00:22:54", "text": "。 はぁ？"}, {"type": "subtitle", "time": 1377.27, "timestamp": "00:22:57", "text": "おい、君、カメラに映ってるぞ。 このエレベーターは故障中です"}, {"type": "subtitle", "time": 1378.23, "timestamp": "00:22:58", "text": "。"}]
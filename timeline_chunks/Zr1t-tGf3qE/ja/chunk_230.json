[{"type": "subtitle", "time": 13819.91, "timestamp": "03:50:19", "text": "楽しいよ。 うん、楽しいよ。 そして、"}, {"type": "subtitle", "time": 13824.79, "timestamp": "03:50:24", "text": "一般の人にも適しています。"}, {"type": "subtitle", "time": 13831.03, "timestamp": "03:50:31", "text": "私が従わなければならない唯一のことは、えっと、"}, {"type": "subtitle", "time": 13834.71, "timestamp": "03:50:34", "text": "何て言うんでしたっけ？ なんて"}, {"type": "subtitle", "time": 13838.55, "timestamp": "03:50:38", "text": "言うんだっけ？ 私は"}, {"type": "subtitle", "time": 13841.59, "timestamp": "03:50:41", "text": "これを理解しなければならない。 うん。 ワイプは"}, {"type": "subtitle", "time": 13844.309, "timestamp": "03:50:44", "text": "6ヶ月ごととかに行われる"}, {"type": "subtitle", "time": 13846.79, "timestamp": "03:50:46", "text": "。 拭き取りにどれくらい時間がかかるか忘れてしまった"}, {"type": "subtitle", "time": 13849.349, "timestamp": "03:50:49", "text": "。 でも、新しいWワイプは"}, {"type": "subtitle", "time": 13852.63, "timestamp": "03:50:52", "text": "もうすぐ実施されるんですよね？  4日後。 どこ"}, {"type": "subtitle", "time": 13855.11, "timestamp": "03:50:55", "text": "ですか？"}, {"type": "subtitle", "time": 13857.91, "timestamp": "03:50:57", "text": "探検隊のことですよね？ 拭き取り用の"}]
[{"type": "subtitle", "time": 16022.469, "timestamp": "04:27:02", "text": "私は硝酸塩を演奏できます。 いいえ、怖いんです。 私は"}, {"type": "subtitle", "time": 16025.269, "timestamp": "04:27:05", "text": "怖いです。 硝酸塩は、"}, {"type": "subtitle", "time": 16027.189, "timestamp": "04:27:07", "text": "一人でいるときには恐ろしいものです。"}, {"type": "subtitle", "time": 16029.75, "timestamp": "04:27:09", "text": "はい。 はい。 はい。 はい。 硝酸塩とかそういうのって"}, {"type": "subtitle", "time": 16038.469, "timestamp": "04:27:18", "text": "ベースポート。 誰かが"}, {"type": "subtitle", "time": 16040.229, "timestamp": "04:27:20", "text": "発射塔を封鎖して、すべてのハードパーツを隠した。 一番"}, {"type": "subtitle", "time": 16042.71, "timestamp": "04:27:22", "text": "上を見てください。"}, {"type": "subtitle", "time": 16047.11, "timestamp": "04:27:27", "text": "これは何ですか？ ああ、これは大変そうだ。"}, {"type": "subtitle", "time": 16049.189, "timestamp": "04:27:29", "text": "難易度は高いですが。"}, {"type": "subtitle", "time": 16051.59, "timestamp": "04:27:31", "text": "これをプレイするにはフルチームが必要だと思う。 わかった。 とにかく、さっさとあの"}, {"type": "subtitle", "time": 16061.59, "timestamp": "04:27:41", "text": "何？ どういう意味ですか？ ショットガンの弾薬。"}]
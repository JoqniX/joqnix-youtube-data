[{"type": "subtitle", "time": 13563.349, "timestamp": "03:46:03", "text": "誰かが私を助けてくれなければならない。 誰かが自力で蘇生している"}, {"type": "subtitle", "time": 13570.07, "timestamp": "03:46:10", "text": "。 わかった。   一緒に"}, {"type": "subtitle", "time": 13571.03, "timestamp": "03:46:11", "text": "チームを組みませんか？"}, {"type": "subtitle", "time": 13572.95, "timestamp": "03:46:12", "text": "お電話をお受けしました。"}, {"type": "subtitle", "time": 13575.349, "timestamp": "03:46:15", "text": "おい、チームを組もうぜ。"}, {"type": "subtitle", "time": 13582.63, "timestamp": "03:46:22", "text": "こんにちは、レイダー。"}, {"type": "subtitle", "time": 13584.55, "timestamp": "03:46:24", "text": "アークオービットがチームに加わりました。"}, {"type": "subtitle", "time": 13586.95, "timestamp": "03:46:26", "text": "安全地帯は閉じつつある。"}, {"type": "subtitle", "time": 13597.91, "timestamp": "03:46:37", "text": "一緒に行きたいですか？"}, {"type": "subtitle", "time": 13601.59, "timestamp": "03:46:41", "text": "おい、撃たないでくれ。   一緒に"}, {"type": "subtitle", "time": 13602.87, "timestamp": "03:46:42", "text": "チームを組みませんか？   私には無理だと"}]
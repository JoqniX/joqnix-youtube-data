[{"type": "subtitle", "time": 18542.23, "timestamp": "05:09:02", "text": "そしてNAT試験、日本語NAT試験は"}, {"type": "subtitle", "time": 18544.55, "timestamp": "05:09:04", "text": "14日です。"}, {"type": "subtitle", "time": 18547.83, "timestamp": "05:09:07", "text": "うん。もう終わり。15日以降は自由。"}, {"type": "subtitle", "time": 18550.948, "timestamp": "05:09:10", "text": "鳥のように自由。"}, {"type": "subtitle", "time": 18558.708, "timestamp": "05:09:18", "text": "うん。15日以降は、"}, {"type": "subtitle", "time": 18561.99, "timestamp": "05:09:21", "text": "ストリームで実験したり、"}, {"type": "subtitle", "time": 18564.47, "timestamp": "05:09:24", "text": "ショート動画を出したり、あれこれやらなきゃいけない"}, {"type": "chat", "time": 18565.909, "timestamp": "05:09:25", "author": "@abhaynair7276", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m3_pcx7bakRsuScPVawS3lNZlHTFLM8XHTpdd1EGU=s64-c-k-c0x00ffffff-no-rj", "message": "no wonder how fluently you speak english"}, {"type": "subtitle", "time": 18566.948, "timestamp": "05:09:26", "text": "。オーケー。いやいやいやいや。"}, {"type": "subtitle", "time": 18573.59, "timestamp": "05:09:33", "text": "勉強すらしてない。勉強してるだけ。"}, {"type": "subtitle", "time": 18580.31, "timestamp": "05:09:40", "text": "学位を簡単に取れると思ってこれを選んだだけ。でも違う、未提出の"}, {"type": "subtitle", "time": 18582.708, "timestamp": "05:09:42", "text": "論文が山ほどある。ちゃんと"}, {"type": "subtitle", "time": 18585.83, "timestamp": "05:09:45", "text": "勉強して試験を受けていれば、もっと"}, {"type": "subtitle", "time": 18588.708, "timestamp": "05:09:48", "text": "簡単だったのに。でも、何を書けばいいのかもわからないし、自分の"}, {"type": "subtitle", "time": 18597.83, "timestamp": "05:09:57", "text": "言葉で何かを書く自信もない。それが問題。"}]
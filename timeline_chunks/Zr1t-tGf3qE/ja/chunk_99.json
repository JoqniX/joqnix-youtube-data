[{"type": "subtitle", "time": 5940.07, "timestamp": "01:39:00", "text": "ああ、他の曲も演奏できますよ。 おお。"}, {"type": "subtitle", "time": 5944.87, "timestamp": "01:39:04", "text": "ハランベリーはゴールデンダメージを増加させます。"}, {"type": "subtitle", "time": 5949.189, "timestamp": "01:39:09", "text": "これは新しい地図ではないですよね？ ああ、"}, {"type": "subtitle", "time": 5952.629, "timestamp": "01:39:12", "text": "ステラ・モンタス。"}, {"type": "subtitle", "time": 5956.39, "timestamp": "01:39:16", "text": "これらは"}, {"type": "subtitle", "time": 5965.75, "timestamp": "01:39:25", "text": "再装填してください。"}, {"type": "subtitle", "time": 5967.99, "timestamp": "01:39:27", "text": "解放するべきでしょうか？ わからない。 私は"}, {"type": "subtitle", "time": 5970.31, "timestamp": "01:39:30", "text": "自由の身で行くよ。 元気です。   こんなに勃起してる自分が"}, {"type": "subtitle", "time": 5973.59, "timestamp": "01:39:33", "text": "大好きだ"}]
[{"type": "subtitle", "time": 3911.109, "timestamp": "01:05:11", "text": "もっと遠くへ、もっと速く滑ろう。動き回ると"}, {"type": "subtitle", "time": 3913.829, "timestamp": "01:05:13", "text": "スタミナの消費が少なくなる。ああ、これを手に入れなきゃ。"}, {"type": "subtitle", "time": 3939.829, "timestamp": "01:05:39", "text": "天窓を板で塞いで、アートが"}, {"type": "subtitle", "time": 3957.27, "timestamp": "01:05:57", "text": "上にある。明らかに君を止められなかった。"}, {"type": "subtitle", "time": 3959.19, "timestamp": "01:05:59", "text": "君は戦利品の場所を見つけた。よかった"}, {"type": "subtitle", "time": 3959.67, "timestamp": "01:05:59", "text": "。"}]
[{"type": "subtitle", "time": 13923.189, "timestamp": "03:52:03", "text": "チケットはそうです。"}, {"type": "subtitle", "time": 13935.75, "timestamp": "03:52:15", "text": "どこですか？ あなたの襲撃者は、"}, {"type": "subtitle", "time": 13940.07, "timestamp": "03:52:20", "text": "錆びの呪文の向こう側の未知の領域にその位置を持ち込み、その"}, {"type": "subtitle", "time": 13943.11, "timestamp": "03:52:23", "text": "代わりに次の襲撃者は"}, {"type": "subtitle", "time": 13945.189, "timestamp": "03:52:25", "text": "次の"}, {"type": "subtitle", "time": 13947.91, "timestamp": "03:52:27", "text": "遠征隊が出発するまで続くユニークな足場を得る、と書いてありますか？ つまり、"}, {"type": "subtitle", "time": 13952.469, "timestamp": "03:52:32", "text": "キャラクター全体をリセットするようなもので、"}, {"type": "subtitle", "time": 13957.03, "timestamp": "03:52:37", "text": "500万の所持金が必要になる、みたいな感じですね"}, {"type": "subtitle", "time": 13959.51, "timestamp": "03:52:39", "text": "。   ええ"}, {"type": "subtitle", "time": 13962.469, "timestamp": "03:52:42", "text": "、だから多くの"}, {"type": "subtitle", "time": 13964.95, "timestamp": "03:52:44", "text": "Aratorストリーマーが"}, {"type": "subtitle", "time": 13968.07, "timestamp": "03:52:48", "text": "500万登録者を目指して、他の"}, {"type": "subtitle", "time": 13973.349, "timestamp": "03:52:53", "text": "ストリーマーやみんなと一緒にゲームをしたり、"}, {"type": "subtitle", "time": 13976.87, "timestamp": "03:52:56", "text": "戦利品を探したり、"}]
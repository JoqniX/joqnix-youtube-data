[{"type": "subtitle", "time": 3007.43, "timestamp": "00:50:07", "text": "こういう荒野のような"}, {"type": "subtitle", "time": 3017.03, "timestamp": "00:50:17", "text": "カミソリのようなアイテムがあると思う。 キノコとか植物とか、"}, {"type": "subtitle", "time": 3020.15, "timestamp": "00:50:20", "text": "そういうの。"}, {"type": "subtitle", "time": 3022.069, "timestamp": "00:50:22", "text": "時々こういうのがあるから。植物か何かを見た"}, {"type": "subtitle", "time": 3023.67, "timestamp": "00:50:23", "text": "。そうだったかもしれない"}, {"type": "subtitle", "time": 3040.39, "timestamp": "00:50:40", "text": "言ったでしょ。さっき"}, {"type": "subtitle", "time": 3047.349, "timestamp": "00:50:47", "text": "これって必要なの？ねえ、もういいよ。"}]
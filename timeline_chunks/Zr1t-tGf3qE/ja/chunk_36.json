[{"type": "subtitle", "time": 2170.71, "timestamp": "00:36:10", "text": "。受信"}, {"type": "subtitle", "time": 2179.51, "timestamp": "00:36:19", "text": "箱ハッピー。待って、1000が無料。"}, {"type": "subtitle", "time": 2181.829, "timestamp": "00:36:21", "text": "ああ、"}, {"type": "subtitle", "time": 2188.069, "timestamp": "00:36:28", "text": "ファイナルでエクセレントファイナルをアンロック。オーケー、オーケー、オーケー。"}, {"type": "subtitle", "time": 2190.39, "timestamp": "00:36:30", "text": "ダイナミス。よし、"}, {"type": "subtitle", "time": 2192.87, "timestamp": "00:36:32", "text": "スキンを手に入れるためだけにファイナルをダウンロードする。"}, {"type": "subtitle", "time": 2197.67, "timestamp": "00:36:37", "text": "待って、レイジャー通貨が1000個ある。いいね。"}, {"type": "subtitle", "time": 2200.71, "timestamp": "00:36:40", "text": "ああ、待って。スキンは手に入る。"}, {"type": "subtitle", "time": 2203.91, "timestamp": "00:36:43", "text": "もしそうなら、"}, {"type": "subtitle", "time": 2206.55, "timestamp": "00:36:46", "text": "スキンが手に入る。600だけ必要。"}]
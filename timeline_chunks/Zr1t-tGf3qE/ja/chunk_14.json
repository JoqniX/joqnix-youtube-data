[{"type": "subtitle", "time": 844.47, "timestamp": "00:14:04", "text": "ああ、これは何でしょう？"}, {"type": "subtitle", "time": 847.829, "timestamp": "00:14:07", "text": "私たちはゲームに参加しているのだろうか？ ああ、これが私たちだ。"}, {"type": "subtitle", "time": 850.79, "timestamp": "00:14:10", "text": "そこに非武装の"}, {"type": "subtitle", "time": 858.47, "timestamp": "00:14:18", "text": "ボット"}, {"type": "subtitle", "time": 861.91, "timestamp": "00:14:21", "text": "ああ、しまった。 とても素敵です。   自分が"}, {"type": "subtitle", "time": 868.79, "timestamp": "00:14:28", "text": "他の配信者がプレイしているのを見ていたゲームをプレイしているなんて信じられない。"}, {"type": "subtitle", "time": 872.629, "timestamp": "00:14:32", "text": "左シフトキーを押したままにします。 わかった。"}, {"type": "subtitle", "time": 876.15, "timestamp": "00:14:36", "text": "おお、それはすごい体力だ。   そうすれば"}, {"type": "subtitle", "time": 889.829, "timestamp": "00:14:49", "text": "素早く動け。 よし、"}]
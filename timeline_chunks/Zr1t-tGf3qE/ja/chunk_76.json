[{"type": "subtitle", "time": 4577.91, "timestamp": "01:16:17", "text": "撃たないで。わかった"}, {"type": "subtitle", "time": 4589.27, "timestamp": "01:16:29", "text": "エレベーターの準備ができました。"}, {"type": "subtitle", "time": 4593.27, "timestamp": "01:16:33", "text": "撃たないで。おい、撃たないで。"}, {"type": "subtitle", "time": 4595.27, "timestamp": "01:16:35", "text": "くそ。"}, {"type": "subtitle", "time": 4597.51, "timestamp": "01:16:37", "text": "殺しちゃおうか？いや。いや。いや。いや。いや。大丈夫。大丈夫。"}, {"type": "subtitle", "time": 4606.709, "timestamp": "01:16:46", "text": "誘惑に駆られる。殺したくなる。でも、"}, {"type": "subtitle", "time": 4609.03, "timestamp": "01:16:49", "text": "みんな初心者で"}, {"type": "subtitle", "time": 4612.07, "timestamp": "01:16:52", "text": "安全策をとっているからかな？"}, {"type": "subtitle", "time": 4615.189, "timestamp": "01:16:55", "text": "襲撃が近い。"}, {"type": "subtitle", "time": 4619.83, "timestamp": "01:16:59", "text": "彼女はマルチのクソを知ってる。わかった。"}]
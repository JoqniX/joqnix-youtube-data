[{"type": "subtitle", "time": 5896.709, "timestamp": "01:38:16", "text": "爆発物にはどれくらい必要ですか？"}, {"type": "subtitle", "time": 5899.669, "timestamp": "01:38:19", "text": "ああ、私ならできる。 ああ、わかりました。   今のところ"}, {"type": "subtitle", "time": 5901.91, "timestamp": "01:38:21", "text": "、私にできるのはこれだけですよね？"}, {"type": "subtitle", "time": 5914.229, "timestamp": "01:38:34", "text": "ああ、この駅はレベルアップできるんですよ。"}, {"type": "subtitle", "time": 5928.79, "timestamp": "01:38:48", "text": "金属部品を入手しました。 だから、それを理解する必要がある"}]
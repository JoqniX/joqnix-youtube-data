[{"type": "subtitle", "time": 18302.788, "timestamp": "05:05:02", "text": "3人までプレイできます。"}, {"type": "subtitle", "time": 18319.91, "timestamp": "05:05:19", "text": "ああ、これはああ、"}, {"type": "subtitle", "time": 18323.43, "timestamp": "05:05:23", "text": "デイリーをやればいいんだ。5つのフィードを完了する。燃料クレート"}, {"type": "subtitle", "time": 18325.67, "timestamp": "05:05:25", "text": "ガソリンスタンドに配達されました。ハチは駆除"}, {"type": "chat", "time": 18327.163, "timestamp": "05:05:27", "author": "@abhaynair7276", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m3_pcx7bakRsuScPVawS3lNZlHTFLM8XHTpdd1EGU=s64-c-k-c0x00ffffff-no-rj", "message": "when is the next stream?"}, {"type": "subtitle", "time": 18327.19, "timestamp": "05:05:27", "text": "されました。"}, {"type": "subtitle", "time": 18330.47, "timestamp": "05:05:30", "text": "オルタネーターに損傷があります。H 次の"}, {"type": "subtitle", "time": 18335.83, "timestamp": "05:05:35", "text": "配信はいつですか? うーん、場合によります。わかりません。"}, {"type": "subtitle", "time": 18338.55, "timestamp": "05:05:38", "text": "正直、わかりません。"}, {"type": "subtitle", "time": 18340.708, "timestamp": "05:05:40", "text": "問題は、試験の勉強を全くしていないのに、あの"}, {"type": "subtitle", "time": 18348.788, "timestamp": "05:05:48", "text": "日本語の件とこれをやらなければならないことです。それに、"}, {"type": "subtitle", "time": 18351.19, "timestamp": "05:05:51", "text": "このゲームを買ったので、"}, {"type": "chat", "time": 18359.845, "timestamp": "05:05:59", "author": "@abhaynair7276", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m3_pcx7bakRsuScPVawS3lNZlHTFLM8XHTpdd1EGU=s64-c-k-c0x00ffffff-no-rj", "message": "what is your exam?"}]
[{"type": "subtitle", "time": 5108.79, "timestamp": "01:25:08", "text": "。こっち。"}, {"type": "subtitle", "time": 5113.59, "timestamp": "01:25:13", "text": "ログブックの"}, {"type": "subtitle", "time": 5114.629, "timestamp": "01:25:14", "text": "ダメージ。"}, {"type": "subtitle", "time": 5117.03, "timestamp": "01:25:17", "text": "シュニーが話してる。銃の準備はいいか。"}, {"type": "subtitle", "time": 5119.43, "timestamp": "01:25:19", "text": "レイダー。アークに挑戦するときは、気を引き締めて。"}, {"type": "subtitle", "time": 5120.95, "timestamp": "01:25:20", "text": "ワイヤー。"}, {"type": "subtitle", "time": 5122.709, "timestamp": "01:25:22", "text": "うるさすぎると、"}, {"type": "subtitle", "time": 5124.95, "timestamp": "01:25:24", "text": "望まない注目を集めることになる。そして、"}, {"type": "subtitle", "time": 5128.31, "timestamp": "01:25:28", "text": "破壊した機械から合金を拾うのを忘れないで。"}, {"type": "subtitle", "time": 5133.35, "timestamp": "01:25:33", "text": "ええと、電子と"}, {"type": "subtitle", "time": 5134.79, "timestamp": "01:25:34", "text": "電気。よし、ここに行ける。"}, {"type": "subtitle", "time": 5136.39, "timestamp": "01:25:36", "text": "発電"}, {"type": "subtitle", "time": 5150.39, "timestamp": "01:25:50", "text": "誰かの声が聞こえた。足音か"}]
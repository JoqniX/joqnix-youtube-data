[{"type": "subtitle", "time": 1685.19, "timestamp": "00:28:05", "text": "、戻ってきました。 戻ってきました。 戻ってきました。"}, {"type": "subtitle", "time": 1687.269, "timestamp": "00:28:07", "text": "犬が歩いていたのは、水が必要だったからだ"}, {"type": "subtitle", "time": 1690.31, "timestamp": "00:28:10", "text": "。 蝶がいて、それから"}, {"type": "subtitle", "time": 1694.87, "timestamp": "00:28:14", "text": "カラスもいました。 えーと、犬は「なんてこった"}, {"type": "subtitle", "time": 1700.95, "timestamp": "00:28:20", "text": "。走った。走った。よし、"}, {"type": "subtitle", "time": 1704.549, "timestamp": "00:28:24", "text": "裏庭にいて、"}, {"type": "subtitle", "time": 1706.789, "timestamp": "00:28:26", "text": "木のすぐ下でくつろいでいる。蝶を"}, {"type": "subtitle", "time": 1712.549, "timestamp": "00:28:32", "text": "捕まえようとしていたのか、"}, {"type": "subtitle", "time": 1716.87, "timestamp": "00:28:36", "text": "そう、あれだ。それにカラスか"}, {"type": "subtitle", "time": 1720.549, "timestamp": "00:28:40", "text": "鳥が鳴いていた。だから、"}, {"type": "subtitle", "time": 1725.99, "timestamp": "00:28:45", "text": "理由もなく吠えていた。なんてこった。よし。"}, {"type": "subtitle", "time": 1728.47, "timestamp": "00:28:48", "text": "一緒に遊ぼう。いや、ソロでやる。えーと、"}, {"type": "subtitle", "time": 1737.43, "timestamp": "00:28:57", "text": "ボーンクラウンセットのこの機能は何？"}]
[{"type": "subtitle", "time": 2227.75, "timestamp": "00:37:07", "text": "ストアが更新されるまであと6日。ああ、"}, {"type": "subtitle", "time": 2230.15, "timestamp": "00:37:10", "text": "オーケー。こんにちは。とにかく、行こう。行こう。行こう"}, {"type": "subtitle", "time": 2232.63, "timestamp": "00:37:12", "text": "。"}, {"type": "subtitle", "time": 2237.27, "timestamp": "00:37:17", "text": "えっと、クロスプレイオン。よし。準備完了。"}, {"type": "subtitle", "time": 2239.91, "timestamp": "00:37:19", "text": "行くぞ。"}, {"type": "subtitle", "time": 2242.71, "timestamp": "00:37:22", "text": "ワクワクする。どうなるか"}, {"type": "subtitle", "time": 2246.23, "timestamp": "00:37:26", "text": "見てみよう。"}, {"type": "subtitle", "time": 2248.63, "timestamp": "00:37:28", "text": "生き残れるかな？"}]
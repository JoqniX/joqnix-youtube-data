[{"type": "subtitle", "time": 6780.229, "timestamp": "01:53:00", "text": "プレイヤーと戦ったり、戦利品を集めたり、"}, {"type": "subtitle", "time": 6785.51, "timestamp": "01:53:05", "text": "生き残って脱出し、家に帰ることです。"}, {"type": "subtitle", "time": 6788.79, "timestamp": "01:53:08", "text": "うん。 そう、"}, {"type": "subtitle", "time": 6796.07, "timestamp": "01:53:16", "text": "マップから手に入れたアイテムを渡して、"}, {"type": "subtitle", "time": 6798.629, "timestamp": "01:53:18", "text": "これは何？"}, {"type": "subtitle", "time": 6801.99, "timestamp": "01:53:21", "text": "ええ、それをNPCや"}, {"type": "subtitle", "time": 6805.189, "timestamp": "01:53:25", "text": "商人など、あなたが持っているものに渡してください。 彼らはあなたに"}, {"type": "subtitle", "time": 6807.43, "timestamp": "01:53:27", "text": "クエストを与えます。 物を作れるよ。 あれこれ"}, {"type": "subtitle", "time": 6807.75, "timestamp": "01:53:27", "text": "。   力を"}, {"type": "subtitle", "time": 6809.35, "timestamp": "01:53:29", "text": "合わせれば、この寒波も乗り越えられるでしょう"}, {"type": "subtitle", "time": 6812.31, "timestamp": "01:53:32", "text": "。 私はそれを知っている。"}, {"type": "subtitle", "time": 6820.709, "timestamp": "01:53:40", "text": "それらを有効活用します。 これがあなたの"}, {"type": "subtitle", "time": 6823.109, "timestamp": "01:53:43", "text": "報酬です。"}, {"type": "subtitle", "time": 6826.709, "timestamp": "01:53:46", "text": "化学薬品も必要だった。"}]
[{"type": "subtitle", "time": 2299.51, "timestamp": "00:38:19", "text": "、PCがラグってる。すごくラグってる。"}, {"type": "subtitle", "time": 2301.75, "timestamp": "00:38:21", "text": "ブラウザを閉じよう。よし、"}, {"type": "subtitle", "time": 2303.03, "timestamp": "00:38:23", "text": "ここに入った。"}, {"type": "subtitle", "time": 2305.43, "timestamp": "00:38:25", "text": "シュニーだ。場所によって"}, {"type": "subtitle", "time": 2306.87, "timestamp": "00:38:26", "text": "異なる種類の戦利品が見つかることを忘れないで"}, {"type": "subtitle", "time": 2309.67, "timestamp": "00:38:29", "text": "。マップを確認して"}, {"type": "subtitle", "time": 2311.43, "timestamp": "00:38:31", "text": "、アイコンでマークした場所のいずれかに向かおう"}, {"type": "subtitle", "time": 2313.67, "timestamp": "00:38:33", "text": "。"}, {"type": "subtitle", "time": 2315.91, "timestamp": "00:38:35", "text": "戦利品キャラクターがいるエリアはあるか？戦利品の"}, {"type": "subtitle", "time": 2322.55, "timestamp": "00:38:42", "text": "価値は高、中。"}, {"type": "subtitle", "time": 2324.31, "timestamp": "00:38:44", "text": "レイダーはどこだ？よし、"}, {"type": "subtitle", "time": 2326.79, "timestamp": "00:38:46", "text": "レイダーのハッチがある。"}, {"type": "subtitle", "time": 2333.19, "timestamp": "00:38:53", "text": "怖い。よし、装備は自由だ"}, {"type": "subtitle", "time": 2335.67, "timestamp": "00:38:55", "text": "。よし。あーあーあーあーあー"}]
[{"type": "subtitle", "time": 17181.43, "timestamp": "04:46:21", "text": "あ、待って。耐久性があった。いつ"}, {"type": "subtitle", "time": 17184.47, "timestamp": "04:46:24", "text": "耐久性を手に入れたんだ？何？ オーケー。いいぞ、いいぞ、いいぞ、"}, {"type": "subtitle", "time": 17202.23, "timestamp": "04:46:42", "text": "スタッフルームの鍵。持ってない。粉々に"}, {"type": "subtitle", "time": 17205.67, "timestamp": "04:46:45", "text": "砕ける音がすごい。"}]
[{"type": "subtitle", "time": 6485.59, "timestamp": "01:48:05", "text": "ええと、"}, {"type": "subtitle", "time": 6487.35, "timestamp": "01:48:07", "text": "これは"}, {"type": "subtitle", "time": 6521.03, "timestamp": "01:48:41", "text": "追跡可能な資料もいくつか入手しました。 私は理性を"}, {"type": "subtitle", "time": 6524.87, "timestamp": "01:48:44", "text": "失った。 ああ、どうすればあの敵を倒せるのだろうか？"}, {"type": "subtitle", "time": 6528.07, "timestamp": "01:48:48", "text": "その弧は"}, {"type": "subtitle", "time": 6530.95, "timestamp": "01:48:50", "text": "ロケットだ。 どうすれば殺せますか？ 誰かが"}, {"type": "subtitle", "time": 6534.47, "timestamp": "01:48:54", "text": "私の近くにいた。"}, {"type": "subtitle", "time": 6536.31, "timestamp": "01:48:56", "text": "ああ、彼らのプロフィールとかをチェックできるよ"}]
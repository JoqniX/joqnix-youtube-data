[{"type": "subtitle", "time": 15490.79, "timestamp": "04:18:10", "text": "青色のティアの戦利品も良いよ。 だから私はそうするべきだ。ああ"}, {"type": "subtitle", "time": 15493.91, "timestamp": "04:18:13", "text": "、これらの場所は"}, {"type": "subtitle", "time": 15497.99, "timestamp": "04:18:17", "text": "プラスチックにとって良い。   ヘロインが"}, {"type": "subtitle", "time": 15500.469, "timestamp": "04:18:20", "text": "必要なんだ。粉々に"}, {"type": "subtitle", "time": 15526.79, "timestamp": "04:18:46", "text": "誰かを見かけたところです。"}, {"type": "subtitle", "time": 15530.79, "timestamp": "04:18:50", "text": "ねえ、一緒にチームを組まない？ 撃たないで。   今、"}, {"type": "subtitle", "time": 15534.309, "timestamp": "04:18:54", "text": "誰かが歩いているのを見かけた。"}, {"type": "subtitle", "time": 15536.149, "timestamp": "04:18:56", "text": "私はおかしいのだろうか？"}, {"type": "subtitle", "time": 15538.469, "timestamp": "04:18:58", "text": "オービターは航行中です。 安全地帯は"}]
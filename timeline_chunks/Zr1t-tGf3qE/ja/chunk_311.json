[{"type": "subtitle", "time": 18664.47, "timestamp": "05:11:04", "text": "お気に入りの"}, {"type": "subtitle", "time": 18667.67, "timestamp": "05:11:07", "text": "配信者がたくさんプレイしているのを見て、ずっとプレイしたかったゲームだったので、とても楽しみにしていました。ええ、"}, {"type": "subtitle", "time": 18669.83, "timestamp": "05:11:09", "text": "もっとプレイするのが待ちきれません。"}, {"type": "chat", "time": 18671.452, "timestamp": "05:11:11", "author": "@abhaynair7276", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m3_pcx7bakRsuScPVawS3lNZlHTFLM8XHTpdd1EGU=s64-c-k-c0x00ffffff-no-rj", "message": "me too I had fun tooo"}, {"type": "subtitle", "time": 18672.628, "timestamp": "05:11:12", "text": "もしこのゲームを持っている方がいたら、"}, {"type": "subtitle", "time": 18675.67, "timestamp": "05:11:15", "text": "一緒にプレイできますよ。でも"}, {"type": "subtitle", "time": 18680.15, "timestamp": "05:11:20", "text": "、ええと、ベーコンが買いたがっているので、"}, {"type": "subtitle", "time": 18683.19, "timestamp": "05:11:23", "text": "ベーコンと一緒にプレイするかもしれません。ええ。まあ、"}, {"type": "subtitle", "time": 18687.75, "timestamp": "05:11:27", "text": "彼女は…ええ、"}, {"type": "subtitle", "time": 18690.31, "timestamp": "05:11:30", "text": "おそらく ソロでプレイして、"}, {"type": "subtitle", "time": 18692.948, "timestamp": "05:11:32", "text": "ゲームを理解して、いろいろやってみるつもりです。"}, {"type": "subtitle", "time": 18696.788, "timestamp": "05:11:36", "text": "ああ、楽しいですね。正直、ずっと"}, {"type": "subtitle", "time": 18703.83, "timestamp": "05:11:43", "text": "Tarovというゲームが欲しかったんですが、今はとても高価で、"}, {"type": "subtitle", "time": 18707.19, "timestamp": "05:11:47", "text": "でもこのゲームはTarovの洗練された"}, {"type": "subtitle", "time": 18717.91, "timestamp": "05:11:57", "text": "、これは"}]
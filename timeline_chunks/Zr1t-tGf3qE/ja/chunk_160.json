[{"type": "subtitle", "time": 9604.63, "timestamp": "02:40:04", "text": "スナップ、ブラスト、シールド再充電器。 わかった。   ああ"}, {"type": "subtitle", "time": 9608.87, "timestamp": "02:40:08", "text": "、リロードするしかないな"}, {"type": "subtitle", "time": 9616.389, "timestamp": "02:40:16", "text": "タダ乗りする方を選ぶよ。   だから"}, {"type": "subtitle", "time": 9627.51, "timestamp": "02:40:27", "text": "私はワインボトルと"}]
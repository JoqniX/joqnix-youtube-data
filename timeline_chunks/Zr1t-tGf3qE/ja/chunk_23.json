[{"type": "subtitle", "time": 1380.549, "timestamp": "00:23:00", "text": "Gセクターのスリングショットのセキュリティ。"}, {"type": "subtitle", "time": 1383.27, "timestamp": "00:23:03", "text": "チューブ内に可能性のあるものがあります。 繰り返す。"}, {"type": "subtitle", "time": 1385.83, "timestamp": "00:23:05", "text": "侵入者の可能性あり。 エレベーターが"}, {"type": "subtitle", "time": 1386.23, "timestamp": "00:23:06", "text": "停止したとき。"}, {"type": "subtitle", "time": 1388.47, "timestamp": "00:23:08", "text": "こんにちは、マックス。 久しぶりですね。 こんにちは。"}, {"type": "subtitle", "time": 1392.789, "timestamp": "00:23:12", "text": "顔を見せるまでは入れないぞ。 どうやって一人でここまで来たの"}, {"type": "subtitle", "time": 1394.95, "timestamp": "00:23:14", "text": "？ あなたは誰ですか？"}, {"type": "subtitle", "time": 1398.149, "timestamp": "00:23:18", "text": "あなたは誰ですか？ 一体彼女が何をしているのか、私には分からない"}, {"type": "subtitle", "time": 1400.63, "timestamp": "00:23:20", "text": "。"}, {"type": "subtitle", "time": 1404.63, "timestamp": "00:23:24", "text": "ああ、私たちは変われる。 わかった。 さあ、行って。 何てことだ"}, {"type": "subtitle", "time": 1416.47, "timestamp": "00:23:36", "text": "おお。 待って。 ああ、彼らはショートヘアですね。"}, {"type": "subtitle", "time": 1421.99, "timestamp": "00:23:41", "text": "彼らは髪が短い。 はい。 入れてもいいですか？"}, {"type": "subtitle", "time": 1425.43, "timestamp": "00:23:45", "text": "ああ、入れてもいいですよ。 ああ、わかりました。"}, {"type": "subtitle", "time": 1432.07, "timestamp": "00:23:52", "text": "おばあちゃん。 銀色です。 ああ、それはできますよ"}, {"type": "subtitle", "time": 1435.75, "timestamp": "00:23:55", "text": "。 わかった。 体型。   私は"}, {"type": "subtitle", "time": 1438.71, "timestamp": "00:23:58", "text": "女性の体型を選びます。"}]
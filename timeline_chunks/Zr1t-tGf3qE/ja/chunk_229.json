[{"type": "subtitle", "time": 13743.75, "timestamp": "03:49:03", "text": "代わりに流しておいて、自分の作業"}, {"type": "subtitle", "time": 13746.07, "timestamp": "03:49:06", "text": "や勉強をしたり、音楽を"}, {"type": "subtitle", "time": 13748.469, "timestamp": "03:49:08", "text": "聴きながら他の"}, {"type": "subtitle", "time": 13751.59, "timestamp": "03:49:11", "text": "人がこのゲームをプレイしているのを見たりしていました。"}, {"type": "subtitle", "time": 13754.63, "timestamp": "03:49:14", "text": "そして今では私もすっかりハマってしまいました。"}, {"type": "subtitle", "time": 13755.91, "timestamp": "03:49:15", "text": "すぐに。"}, {"type": "subtitle", "time": 13782.95, "timestamp": "03:49:42", "text": "私も今、このゲームを買おうと思っています。"}, {"type": "subtitle", "time": 13785.11, "timestamp": "03:49:45", "text": "H."}, {"type": "chat", "time": 13795.728, "timestamp": "03:49:55", "author": "@abhaynair7276", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m3_pcx7bakRsuScPVawS3lNZlHTFLM8XHTpdd1EGU=s64-c-k-c0x00ffffff-no-rj", "message": "it is kind a fun ngl"}]
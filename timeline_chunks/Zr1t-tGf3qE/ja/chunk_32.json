[{"type": "subtitle", "time": 1927.269, "timestamp": "00:32:07", "text": "カスタマイズ全体。"}, {"type": "subtitle", "time": 1929.75, "timestamp": "00:32:09", "text": "うわー、本当に必要です。私は"}, {"type": "subtitle", "time": 1933.11, "timestamp": "00:32:13", "text": "この色が欲しかったんです。白とピンク。ええと、白"}, {"type": "subtitle", "time": 1936.07, "timestamp": "00:32:16", "text": "と紫っぽい。それが今の私の色に見えます"}, {"type": "subtitle", "time": 1943.83, "timestamp": "00:32:23", "text": "ああ、 ヘルメットだ。わかった。わかった。"}, {"type": "subtitle", "time": 1946.389, "timestamp": "00:32:26", "text": "でも、消せると思う。わかった、"}, {"type": "subtitle", "time": 1949.99, "timestamp": "00:32:29", "text": "いい感じだ。ヘルメット。懐中電灯。懐中電灯がある。"}, {"type": "subtitle", "time": 1951.83, "timestamp": "00:32:31", "text": "あ、"}, {"type": "subtitle", "time": 1954.23, "timestamp": "00:32:34", "text": "水中カメラ。水中"}, {"type": "subtitle", "time": 1957.269, "timestamp": "00:32:37", "text": "カメラがある。くそ。多すぎる"}, {"type": "subtitle", "time": 1959.509, "timestamp": "00:32:39", "text": "。待って、"}, {"type": "subtitle", "time": 1962.149, "timestamp": "00:32:42", "text": "ピーナッツバンガレーターってどれだっけ？これか"}, {"type": "subtitle", "time": 1964.23, "timestamp": "00:32:44", "text": "？違う。"}, {"type": "subtitle", "time": 1967.269, "timestamp": "00:32:47", "text": "あ、これもある。いいな。"}, {"type": "subtitle", "time": 1971.83, "timestamp": "00:32:51", "text": "スキンがたくさんある。何？"}, {"type": "subtitle", "time": 1974.63, "timestamp": "00:32:54", "text": "レベル10。あ、これは無料でもらえるんだ。"}]
[{"type": "subtitle", "time": 2041.11, "timestamp": "00:34:01", "text": "ダイバーみたいだ。"}, {"type": "subtitle", "time": 2049.51, "timestamp": "00:34:09", "text": "なぜ？ああ、コインを稼げるんだ。わかった。わかった。わかった。50 50 100"}, {"type": "subtitle", "time": 2056.55, "timestamp": "00:34:16", "text": "150 200"}, {"type": "subtitle", "time": 2060.149, "timestamp": "00:34:20", "text": "250"}, {"type": "subtitle", "time": 2067.589, "timestamp": "00:34:27", "text": "電卓が使えない。計算できない。えーと、250 + 250 は"}, {"type": "subtitle", "time": 2072.31, "timestamp": "00:34:32", "text": "いくら？500。少ないな。"}, {"type": "subtitle", "time": 2074.629, "timestamp": "00:34:34", "text": "レイダーデッキを完成させたらどうなる？"}, {"type": "subtitle", "time": 2078.47, "timestamp": "00:34:38", "text": "他に何かある？何もない。DRのクソみたいな"}, {"type": "subtitle", "time": 2084.79, "timestamp": "00:34:44", "text": "戦場から無事に帰還する。シックに与えたダメージ。"}, {"type": "subtitle", "time": 2086.869, "timestamp": "00:34:46", "text": "シックって何？レイダーに与えたダメージ"}, {"type": "subtitle", "time": 2088.95, "timestamp": "00:34:48", "text": "。ああ、敵の"}, {"type": "subtitle", "time": 2093.669, "timestamp": "00:34:53", "text": "プレイヤーと戦わなければならないんだ。わかった。よし。行こう。えーと"}, {"type": "subtitle", "time": 2097.589, "timestamp": "00:34:57", "text": "プレイ。ああ、"}]
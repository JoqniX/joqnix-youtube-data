[{"type": "subtitle", "time": 2777.43, "timestamp": "00:46:17", "text": "スティッチャーはいいダメージを与える。"}, {"type": "subtitle", "time": 2780.95, "timestamp": "00:46:20", "text": "誘惑しないでくれ。"}, {"type": "chat", "time": 2781.377, "timestamp": "00:46:21", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! bakononcopiumm~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 2784.79, "timestamp": "00:46:24", "text": "そう、まさに。もし手に入れたら。"}, {"type": "subtitle", "time": 2795.51, "timestamp": "00:46:35", "text": "議論にはセーフポケットがない。"}, {"type": "subtitle", "time": 2799.51, "timestamp": "00:46:39", "text": "待って、セーフポケットってどういう意味？"}, {"type": "subtitle", "time": 2802.39, "timestamp": "00:46:42", "text": "セーフポケットはどうやって手に入れるの？"}, {"type": "subtitle", "time": 2809.589, "timestamp": "00:46:49", "text": "ああ、これでセーフが手に入る。よし、"}, {"type": "subtitle", "time": 2813.43, "timestamp": "00:46:53", "text": "知ってる？またフリーロードアウト。"}, {"type": "subtitle", "time": 2816.309, "timestamp": "00:46:56", "text": "待って、どうすればいいフリー"}, {"type": "subtitle", "time": 2819.67, "timestamp": "00:46:59", "text": "ロードアウトを手に入れられるの？"}]
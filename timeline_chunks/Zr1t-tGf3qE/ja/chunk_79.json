[{"type": "subtitle", "time": 4743.75, "timestamp": "01:19:03", "text": "お茶はあまり好きではありませんが、"}, {"type": "subtitle", "time": 4747.35, "timestamp": "01:19:07", "text": "温かい飲み物はいつでもありがたいです。"}, {"type": "subtitle", "time": 4749.189, "timestamp": "01:19:09", "text": "銃声。ああ、そうか。これは良い"}, {"type": "subtitle", "time": 4758.149, "timestamp": "01:19:18", "text": "レベルが上がれば上がるほど、これは"}, {"type": "subtitle", "time": 4761.11, "timestamp": "01:19:21", "text": "何でもなくなります。いや、"}, {"type": "subtitle", "time": 4764.79, "timestamp": "01:19:24", "text": "発明していると思います。よし、"}, {"type": "subtitle", "time": 4779.11, "timestamp": "01:19:39", "text": "だから、落ち着くか"}, {"type": "subtitle", "time": 4784.07, "timestamp": "01:19:44", "text": "何かを始めなければなりません。クエストの追跡。"}]
[{"type": "subtitle", "time": 14042.55, "timestamp": "03:54:02", "text": "。 つまり、"}, {"type": "subtitle", "time": 14045.349, "timestamp": "03:54:05", "text": "永久的なロック解除が手に入るということですね。 まるでレイダーの"}, {"type": "subtitle", "time": 14050.389, "timestamp": "03:54:10", "text": "衣装みたいだ。 あなたの、えーと、清掃員の残骸。 そう、あの"}, {"type": "subtitle", "time": 14053.67, "timestamp": "03:54:13", "text": "チキンスクラッピー。 スクラッピーは"}, {"type": "subtitle", "time": 14056.95, "timestamp": "03:54:16", "text": "キャップか何かをもらうだろう。 キャップはそこにあるでしょう。"}, {"type": "subtitle", "time": 14058.469, "timestamp": "03:54:18", "text": "さらに、"}, {"type": "subtitle", "time": 14062.15, "timestamp": "03:54:22", "text": "所持品スペースが12増加し、"}, {"type": "subtitle", "time": 14067.67, "timestamp": "03:54:27", "text": "出発時の所持品の価値に応じて最大5のボーナススキルが付与されます。 ええ、"}, {"type": "subtitle", "time": 14074.389, "timestamp": "03:54:34", "text": "次の遠征期間まで一時的なバフ効果を与えてくれますよ。"}, {"type": "subtitle", "time": 14077.189, "timestamp": "03:54:37", "text": "ソフトリセットのようなものだ。"}, {"type": "subtitle", "time": 14079.349, "timestamp": "03:54:39", "text": "レイダーを遠征に派遣すると、"}, {"type": "subtitle", "time": 14082.469, "timestamp": "03:54:42", "text": "ソフトリセットとして機能し、"}, {"type": "subtitle", "time": 14084.71, "timestamp": "03:54:44", "text": "新しいレイダーが手に入りますが、"}, {"type": "subtitle", "time": 14086.79, "timestamp": "03:54:46", "text": "これらの永続的および"}, {"type": "subtitle", "time": 14089.429, "timestamp": "03:54:49", "text": "一時的なボーナスは引き継がれます。   わかった"}, {"type": "subtitle", "time": 14091.91, "timestamp": "03:54:51", "text": "。 川を最大限に活用するには、"}, {"type": "subtitle", "time": 14098.229, "timestamp": "03:54:58", "text": "出発前に高価なアイテムやコインで保管庫と洞窟を満たしてください。   有効"}]
[{"type": "subtitle", "time": 2419.19, "timestamp": "00:40:19", "text": "スカベンジャーズ。怖いよ。なんでこんな風に感じるんだろう。正直言って、怖いよ"}, {"type": "subtitle", "time": 2423.19, "timestamp": "00:40:23", "text": "。 ある"}, {"type": "subtitle", "time": 2429.109, "timestamp": "00:40:29", "text": "意味バトルロイヤルみたいなものだけど、"}, {"type": "subtitle", "time": 2430.55, "timestamp": "00:40:30", "text": "他の"}, {"type": "subtitle", "time": 2433.43, "timestamp": "00:40:33", "text": "プレイヤーがいるって分かってる。"}, {"type": "subtitle", "time": 2435.51, "timestamp": "00:40:35", "text": "自分で戦利品を見つけて、"}, {"type": "subtitle", "time": 2438.71, "timestamp": "00:40:38", "text": "何とか生き残らなきゃいけないって分かってる。"}, {"type": "subtitle", "time": 2441.27, "timestamp": "00:40:41", "text": "そして、もし生き残れなかったら、"}, {"type": "subtitle", "time": 2443.51, "timestamp": "00:40:43", "text": "戦利品を全部失う。"}]
[{"type": "subtitle", "time": 8116.79, "timestamp": "02:15:16", "text": "ここでカナリアを見つけなきゃ。"}, {"type": "subtitle", "time": 8118.87, "timestamp": "02:15:18", "text": "これらの武器は全て、"}, {"type": "subtitle", "time": 8121.589, "timestamp": "02:15:21", "text": "ゲーム内では一種の毛布のようなものです。 避難所に入らなければならない"}, {"type": "subtitle", "time": 8124.47, "timestamp": "02:15:24", "text": "。 新しい目的地が追加されました。"}, {"type": "subtitle", "time": 8134.39, "timestamp": "02:15:34", "text": "バリタ市。"}, {"type": "subtitle", "time": 8137.109, "timestamp": "02:15:37", "text": "ああ、"}, {"type": "subtitle", "time": 8139.27, "timestamp": "02:15:39", "text": "あそこはどんな感じなの？"}, {"type": "subtitle", "time": 8141.109, "timestamp": "02:15:41", "text": "どこ？"}, {"type": "subtitle", "time": 8142.87, "timestamp": "02:15:42", "text": "市内で。"}, {"type": "subtitle", "time": 8143.27, "timestamp": "02:15:43", "text": "市。"}, {"type": "subtitle", "time": 8145.109, "timestamp": "02:15:45", "text": "危険だ。"}, {"type": "subtitle", "time": 8148.149, "timestamp": "02:15:48", "text": "全体が砂に飲み込まれてしまった。"}, {"type": "subtitle", "time": 8148.95, "timestamp": "02:15:48", "text": "これを見てみましょう。"}, {"type": "subtitle", "time": 8151.589, "timestamp": "02:15:51", "text": "そこにはもう誰も住んでいない。"}, {"type": "subtitle", "time": 8155.03, "timestamp": "02:15:55", "text": "街を歩いていると、それらの兆候を目にする。"}, {"type": "subtitle", "time": 8157.669, "timestamp": "02:15:57", "text": "色褪せた壁画、"}]
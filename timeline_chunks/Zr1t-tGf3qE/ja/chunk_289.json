[{"type": "subtitle", "time": 17346.31, "timestamp": "04:49:06", "text": "ああ、青い友達のチョーク。オーケー、これが必要だ"}, {"type": "subtitle", "time": 17353.83, "timestamp": "04:49:13", "text": "ああ、犬用クーラー。なんてこった。オーケー、今すぐ"}, {"type": "subtitle", "time": 17357.51, "timestamp": "04:49:17", "text": "脱出しないといけない。なんてこった。なんてこった"}, {"type": "subtitle", "time": 17371.19, "timestamp": "04:49:31", "text": "兄弟、今すぐX線検査しないといけない。しないといけない"}, {"type": "subtitle", "time": 17384.55, "timestamp": "04:49:44", "text": "。撃たないで。"}]
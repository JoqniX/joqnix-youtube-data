[{"type": "subtitle", "time": 2823.109, "timestamp": "00:47:03", "text": "システムカスタマイザーみたいなものがあるの？"}, {"type": "subtitle", "time": 2826.309, "timestamp": "00:47:06", "text": "トライアルズプレゼントって何？"}, {"type": "subtitle", "time": 2828.39, "timestamp": "00:47:08", "text": "ああ、これはみんなが"}, {"type": "subtitle", "time": 2830.63, "timestamp": "00:47:10", "text": "やってきたことだよ。いや、遠征で500"}, {"type": "subtitle", "time": 2837.67, "timestamp": "00:47:17", "text": "よし。カスタマイズ。よし。スキル。"}, {"type": "subtitle", "time": 2839.829, "timestamp": "00:47:19", "text": "フリーロードアウトのやつをチェックしたい。どうすれば"}, {"type": "subtitle", "time": 2842.39, "timestamp": "00:47:22", "text": "増やせるかな？"}, {"type": "subtitle", "time": 2844.71, "timestamp": "00:47:24", "text": "ルート中に音を立てないようにできる。ああ、"}, {"type": "subtitle", "time": 2848.47, "timestamp": "00:47:28", "text": "これが必要だ。うん。サバイバルモードで"}, {"type": "chat", "time": 2850.681, "timestamp": "00:47:30", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "Im tweaking hard"}, {"type": "subtitle", "time": 2851.829, "timestamp": "00:47:31", "text": "これを調整しようと思う。"}, {"type": "subtitle", "time": 2869.03, "timestamp": "00:47:49", "text": "シックにダメージを与える。レイダーにダメージを与える"}, {"type": "subtitle", "time": 2870.87, "timestamp": "00:47:50", "text": "。"}, {"type": "subtitle", "time": 2874.71, "timestamp": "00:47:54", "text": "トップスが私を誘惑している、ジョック。"}, {"type": "subtitle", "time": 2877.03, "timestamp": "00:47:57", "text": "まあ、大丈夫。できるときにゲームを手に入れて"}]
[{"type": "subtitle", "time": 10503.99, "timestamp": "02:55:03", "text": "そして、あらゆる弧を捜索する。"}, {"type": "subtitle", "time": 10505.91, "timestamp": "02:55:05", "text": "ショーニーがあなたの発見について教えてくれた。"}, {"type": "subtitle", "time": 10507.349, "timestamp": "02:55:07", "text": "これは何ですか？"}, {"type": "subtitle", "time": 10514.79, "timestamp": "02:55:14", "text": "空を横切る探査機の電波が以前よりもはるかに多く見られるようになった。   わかった"}, {"type": "subtitle", "time": 10515.429, "timestamp": "02:55:15", "text": "。"}, {"type": "subtitle", "time": 10523.51, "timestamp": "02:55:23", "text": "彼らが探しているものを見つけたらどうなるか、という話を聞いたことがある。"}, {"type": "subtitle", "time": 10527.59, "timestamp": "02:55:27", "text": "ああ、それは都市伝説かもしれないけど、"}, {"type": "subtitle", "time": 10529.11, "timestamp": "02:55:29", "text": "痛い目に遭って確かめたくはないんだ"}, {"type": "subtitle", "time": 10529.75, "timestamp": "02:55:29", "text": "。"}, {"type": "subtitle", "time": 10540.07, "timestamp": "02:55:40", "text": "嫌な予感。"}, {"type": "subtitle", "time": 10541.59, "timestamp": "02:55:41", "text": "アークの"}, {"type": "subtitle", "time": 10544.55, "timestamp": "02:55:44", "text": "行動にほんのわずかな変化が生じただけでも、彼のキャリアを左右する可能性がある"}, {"type": "subtitle", "time": 10545.19, "timestamp": "02:55:45", "text": "。   今まで手に取ったものとは全く違う"}, {"type": "subtitle", "time": 10546.79, "timestamp": "02:55:46", "text": "。"}, {"type": "subtitle", "time": 10549.19, "timestamp": "02:55:49", "text": "良い。 地表で見かけた探査機や輸送機を破壊して、"}]
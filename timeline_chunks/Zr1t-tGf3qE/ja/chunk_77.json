[{"type": "subtitle", "time": 4630.95, "timestamp": "01:17:10", "text": "大丈夫。"}, {"type": "subtitle", "time": 4651.43, "timestamp": "01:17:31", "text": "ワークショップに戻って"}, {"type": "subtitle", "time": 4655.03, "timestamp": "01:17:35", "text": "追加のアイテムと装備をクラフトしてください。ワークショップには"}, {"type": "subtitle", "time": 4657.75, "timestamp": "01:17:37", "text": "作業台が付いています。それを使って"}, {"type": "subtitle", "time": 4665.99, "timestamp": "01:17:45", "text": "ワークショップレベル1ス"}, {"type": "subtitle", "time": 4672.149, "timestamp": "01:17:52", "text": "スクラッピーは無料で戦利品か"}, {"type": "subtitle", "time": 4675.03, "timestamp": "01:17:55", "text": "何かをくれるんだ。"}]
[{"type": "subtitle", "time": 2102.71, "timestamp": "00:35:02", "text": "ラウンドプレイしなければならない。このラウンドを練習する。"}, {"type": "subtitle", "time": 2113.67, "timestamp": "00:35:13", "text": "わあ、これはいい。"}, {"type": "subtitle", "time": 2117.99, "timestamp": "00:35:17", "text": "これを見て。わあ。ロードアウトを確認する"}, {"type": "subtitle", "time": 2121.43, "timestamp": "00:35:21", "text": "。待って、ディズニーのこの"}, {"type": "subtitle", "time": 2123.51, "timestamp": "00:35:23", "text": "物を持っている。"}, {"type": "subtitle", "time": 2136.31, "timestamp": "00:35:36", "text": "全部元に戻すよ。"}, {"type": "subtitle", "time": 2140.15, "timestamp": "00:35:40", "text": "プリロードアウトしよう。"}, {"type": "subtitle", "time": 2143.109, "timestamp": "00:35:43", "text": "リロード。待ってる。一つチェックしてなかった"}, {"type": "subtitle", "time": 2146.069, "timestamp": "00:35:46", "text": "ものがある。"}, {"type": "subtitle", "time": 2148.79, "timestamp": "00:35:48", "text": "このゲームにはスキルツリーがあるって聞いたんだけど。なんてこった。"}, {"type": "subtitle", "time": 2157.109, "timestamp": "00:35:57", "text": "スキルツリーのスキルはいくつもらえるの？"}]
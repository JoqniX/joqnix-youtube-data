[{"type": "subtitle", "time": 7579.83, "timestamp": "02:06:19", "text": "いつ配信しますか？"}, {"type": "subtitle", "time": 7583.43, "timestamp": "02:06:23", "text": "午後2時まで行こうと思っていました。"}, {"type": "subtitle", "time": 7585.669, "timestamp": "02:06:25", "text": "ええ、必要ならもっと行けるんです"}, {"type": "subtitle", "time": 7588.07, "timestamp": "02:06:28", "text": "けど、土曜日に試験があって"}, {"type": "subtitle", "time": 7589.99, "timestamp": "02:06:29", "text": "勉強しなきゃいけなかったんです。 俺は全然"}, {"type": "subtitle", "time": 7592.229, "timestamp": "02:06:32", "text": "勉強してないんだよ。"}, {"type": "subtitle", "time": 7595.109, "timestamp": "02:06:35", "text": "おお。"}, {"type": "subtitle", "time": 7598.069, "timestamp": "02:06:38", "text": "それから、日本語の授業があります。"}, {"type": "subtitle", "time": 7600.149, "timestamp": "02:06:40", "text": "どうやら私の日本語講座は"}, {"type": "subtitle", "time": 7603.35, "timestamp": "02:06:43", "text": "20日の土曜日までに終わるらしい。 単に授業"}, {"type": "subtitle", "time": 7606.31, "timestamp": "02:06:46", "text": "内容を復習しているだけです。 全てが"}, {"type": "subtitle", "time": 7609.109, "timestamp": "02:06:49", "text": "奪われた。 すべてのパートが終了しました。"}, {"type": "subtitle", "time": 7612.709, "timestamp": "02:06:52", "text": "練習とか色々やらなきゃいけないんだ。 ああ、だから"}, {"type": "subtitle", "time": 7615.189, "timestamp": "02:06:55", "text": "大学の試験とかが終わったら、腰を据えて"}, {"type": "subtitle", "time": 7618.229, "timestamp": "02:06:58", "text": "日本語の練習をしないといけないんだよ"}]
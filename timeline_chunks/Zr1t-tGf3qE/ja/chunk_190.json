[{"type": "subtitle", "time": 11414.87, "timestamp": "03:10:14", "text": "まあ、つまりこの塔は、もし私が"}, {"type": "subtitle", "time": 11417.91, "timestamp": "03:10:17", "text": "このような状態であれば、おそらく"}, {"type": "subtitle", "time": 11421.19, "timestamp": "03:10:21", "text": "管制塔に来ることができるでしょうが、おそらく"}, {"type": "subtitle", "time": 11450.95, "timestamp": "03:10:50", "text": "丈夫な布地ですね。 医療用か商業用か？"}, {"type": "subtitle", "time": 11454.469, "timestamp": "03:10:54", "text": "医療関連や商業関連の商品はこちらです。"}]
[{"type": "subtitle", "time": 18487.11, "timestamp": "05:08:07", "text": "そう、イギリスの詩人とか、"}, {"type": "subtitle", "time": 18489.67, "timestamp": "05:08:09", "text": "シェイクスピアとか、そういう話全部。"}, {"type": "subtitle", "time": 18498.47, "timestamp": "05:08:18", "text": "JPか"}, {"type": "chat", "time": 18499.622, "timestamp": "05:08:19", "author": "@abhaynair7276", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m3_pcx7bakRsuScPVawS3lNZlHTFLM8XHTpdd1EGU=s64-c-k-c0x00ffffff-no-rj", "message": "your subject is shakespeare 🙀"}, {"type": "subtitle", "time": 18500.708, "timestamp": "05:08:20", "text": "何かで暗記して、重要な"}, {"type": "subtitle", "time": 18503.27, "timestamp": "05:08:23", "text": "ポイントを覚えよう。"}, {"type": "subtitle", "time": 18508.23, "timestamp": "05:08:28", "text": "ああ、そう。それから、えーと、月曜日、えーと、"}, {"type": "subtitle", "time": 18515.43, "timestamp": "05:08:35", "text": "20日は土曜日、24日は土曜日、22日は月曜日。わかった。わかった。"}, {"type": "subtitle", "time": 18517.59, "timestamp": "05:08:37", "text": "月曜日の試験は"}, {"type": "subtitle", "time": 18527.03, "timestamp": "05:08:47", "text": "これは苦痛だ。"}, {"type": "subtitle", "time": 18531.43, "timestamp": "05:08:51", "text": "1月5日まで試験がある。ああ、"}, {"type": "subtitle", "time": 18535.43, "timestamp": "05:08:55", "text": "つまり22日、23日、27日、"}, {"type": "subtitle", "time": 18539.11, "timestamp": "05:08:59", "text": "31日、2日、  5日。オーケー。"}]
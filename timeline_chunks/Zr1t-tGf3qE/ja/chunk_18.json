[{"type": "subtitle", "time": 1084.71, "timestamp": "00:18:04", "text": "ハニー、"}, {"type": "subtitle", "time": 1086.95, "timestamp": "00:18:06", "text": "ドアの向こうで何か話したわよ。 何てことだ"}, {"type": "subtitle", "time": 1090.07, "timestamp": "00:18:10", "text": "。"}, {"type": "subtitle", "time": 1093.51, "timestamp": "00:18:13", "text": "ジャックポット包帯。 時間を無駄にしている暇はない。"}, {"type": "subtitle", "time": 1100.87, "timestamp": "00:18:20", "text": "私は生きている。 どうやって？ でも、私は死んでしまった。 待って、"}, {"type": "subtitle", "time": 1125.59, "timestamp": "00:18:45", "text": "ああ、ブロックされたんだ。"}, {"type": "subtitle", "time": 1128.63, "timestamp": "00:18:48", "text": "殺した男の遺体を上の階に運びたかったのですが、"}]
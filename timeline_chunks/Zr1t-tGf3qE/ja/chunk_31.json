[{"type": "subtitle", "time": 1860.789, "timestamp": "00:31:00", "text": "ボグ"}, {"type": "subtitle", "time": 1868.71, "timestamp": "00:31:08", "text": "ファイナルアークレイダースキンの入手方法。"}, {"type": "subtitle", "time": 1870.87, "timestamp": "00:31:10", "text": "それは、"}, {"type": "subtitle", "time": 1872.549, "timestamp": "00:31:12", "text": "えーと、通常はさまざまな色をアンロックするようなものです"}, {"type": "subtitle", "time": 1874.95, "timestamp": "00:31:14", "text": "。オーケー。"}, {"type": "subtitle", "time": 1876.31, "timestamp": "00:31:16", "text": "ミッションをプレイしてクレジットを獲得し、"}, {"type": "subtitle", "time": 1878.47, "timestamp": "00:31:18", "text": "ゲーム内のレイダーデッキシステムを使用して進行することで"}, {"type": "subtitle", "time": 1881.51, "timestamp": "00:31:21", "text": "。オーケー。"}, {"type": "subtitle", "time": 1890.71, "timestamp": "00:31:30", "text": "このレイダーデッキデッキは何ですか？レイダー"}, {"type": "subtitle", "time": 1893.11, "timestamp": "00:31:33", "text": "デッキ無料。"}, {"type": "subtitle", "time": 1902.07, "timestamp": "00:31:42", "text": "これは何だ、この粗悪品は？"}, {"type": "subtitle", "time": 1905.83, "timestamp": "00:31:45", "text": "ああ、これはニワトリの"}, {"type": "subtitle", "time": 1907.59, "timestamp": "00:31:47", "text": "作業台です。ああ、ここで設計"}, {"type": "subtitle", "time": 1914.549, "timestamp": "00:31:54", "text": "図を入手してクラフトします。"}]
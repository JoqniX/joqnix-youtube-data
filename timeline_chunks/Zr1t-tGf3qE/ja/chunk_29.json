[{"type": "subtitle", "time": 1742.389, "timestamp": "00:29:02", "text": "なんてこった、高い。でも、"}, {"type": "subtitle", "time": 1763.83, "timestamp": "00:29:23", "text": "ウォーカーにお金を払わなきゃいけないのはなぜ？このスキンにお金を払わなきゃいけないのはなぜ？"}, {"type": "subtitle", "time": 1767.909, "timestamp": "00:29:27", "text": "これと何のために"}, {"type": "subtitle", "time": 1777.269, "timestamp": "00:29:37", "text": "？どこ？"}, {"type": "subtitle", "time": 1790.95, "timestamp": "00:29:50", "text": "有料スキンなのが本当に好き。"}, {"type": "subtitle", "time": 1792.389, "timestamp": "00:29:52", "text": "待って、待って、待って、待って。Steamをチェックさせて"}, {"type": "subtitle", "time": 1794.71, "timestamp": "00:29:54", "text": "。"}]
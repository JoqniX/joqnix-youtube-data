[{"type": "subtitle", "time": 4142.63, "timestamp": "01:09:02", "text": "今回はゲーム・オブ・スローンズの決勝からあのスキンを手に入れるんだ。あの赤いスキンを手に"}, {"type": "subtitle", "time": 4153.11, "timestamp": "01:09:13", "text": "今回はレイダーを見かけたら"}, {"type": "subtitle", "time": 4171.03, "timestamp": "01:09:31", "text": "これがショーニーだ。覚えておいて、レイダー、"}, {"type": "subtitle", "time": 4174.789, "timestamp": "01:09:34", "text": "必要なものに出会うまでうろうろすることもできるし、リサイクルする方法を学んで自分で解決することもできるんだ"}, {"type": "subtitle", "time": 4177.99, "timestamp": "01:09:37", "text": "。"}]
[{"type": "subtitle", "time": 4682.07, "timestamp": "01:18:02", "text": "どうやら彼を訓練できるらしい。わかった。"}, {"type": "subtitle", "time": 4690.07, "timestamp": "01:18:10", "text": "これはピストルか？これはロケットのように見える"}, {"type": "subtitle", "time": 4693.11, "timestamp": "01:18:13", "text": "。一体何だ？わかった、"}, {"type": "subtitle", "time": 4702.55, "timestamp": "01:18:22", "text": "クラフト場所のレベルを上げるにはどうすればいい？"}, {"type": "subtitle", "time": 4705.51, "timestamp": "01:18:25", "text": "設計図。"}, {"type": "subtitle", "time": 4708.47, "timestamp": "01:18:28", "text": "インストール。ああ、"}, {"type": "subtitle", "time": 4713.51, "timestamp": "01:18:33", "text": "ギアベンチ。ガンスミス。医療ラボ。これは、"}, {"type": "subtitle", "time": 4717.51, "timestamp": "01:18:37", "text": "えーと、"}, {"type": "subtitle", "time": 4720.55, "timestamp": "01:18:40", "text": "ギアを買って売ったお金です。どうやって？"}, {"type": "subtitle", "time": 4723.27, "timestamp": "01:18:43", "text": "誰から売るんですか？こいつらです。"}, {"type": "subtitle", "time": 4727.669, "timestamp": "01:18:47", "text": "快適さをシミュレートするために、内部プロセッサを買い取らなければなりません。"}]
[{"type": "subtitle", "time": 242.149, "timestamp": "00:04:02", "text": "こんにちは、みんな。 えっと、最近"}, {"type": "subtitle", "time": 243.99, "timestamp": "00:04:03", "text": "配信してないんです。"}, {"type": "subtitle", "time": 247.19, "timestamp": "00:04:07", "text": "最近は土曜日に"}, {"type": "subtitle", "time": 252.55, "timestamp": "00:04:12", "text": "試験とか色々あって、全く配信できていませんでした"}, {"type": "subtitle", "time": 254.55, "timestamp": "00:04:14", "text": "。 明後日の土曜日、つまり今週の土曜日に、"}, {"type": "subtitle", "time": 272.39, "timestamp": "00:04:32", "text": "こんにちは。"}, {"type": "subtitle", "time": 290.23, "timestamp": "00:04:50", "text": "私はします。   わかった"}, {"type": "subtitle", "time": 293.909, "timestamp": "00:04:53", "text": "。 さて、今日は「"}, {"type": "subtitle", "time": 296.629, "timestamp": "00:04:56", "text": "アークレイダーズ」というゲームをプレイします。 久しぶりですね"}]
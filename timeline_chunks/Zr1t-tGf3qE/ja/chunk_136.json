[{"type": "subtitle", "time": 8160.87, "timestamp": "02:16:00", "text": "古い広告やショーウィンドウ、"}, {"type": "subtitle", "time": 8176.31, "timestamp": "02:16:16", "text": "私のPCは故障寸前なのか、それとも動作が遅いのはなぜなのか？ たとえ他の誰も覚えていなくても、その"}, {"type": "subtitle", "time": 8195.11, "timestamp": "02:16:35", "text": "マイクロソフト エッジ 一体どういうことだ？   わかった"}, {"type": "subtitle", "time": 8196.629, "timestamp": "02:16:36", "text": "。"}, {"type": "subtitle", "time": 8199.27, "timestamp": "02:16:39", "text": "ディスコードを殺すべきだろうか？ 音声チャットに関する"}, {"type": "subtitle", "time": 8202.709, "timestamp": "02:16:42", "text": "問題。 後でもう一度お試しください。   わかった"}, {"type": "subtitle", "time": 8204.629, "timestamp": "02:16:44", "text": "。   でも、何ももらえなかった"}, {"type": "subtitle", "time": 8211.99, "timestamp": "02:16:51", "text": "。 では、もし私が"}, {"type": "subtitle", "time": 8214.87, "timestamp": "02:16:54", "text": "これを受け取らなかったらどうなりますか？ これらはどんどん"}, {"type": "subtitle", "time": 8217.83, "timestamp": "02:16:57", "text": "増えていくんですよね？ 今のところ"}, {"type": "subtitle", "time": 8219.99, "timestamp": "02:16:59", "text": "50人中5人です。ねえ、知ってる？ そのままにしておきます"}]
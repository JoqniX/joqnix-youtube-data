[{"type": "subtitle", "time": 14187.99, "timestamp": "03:56:27", "text": "えっと、その皮は一体何から作られているんですか？"}, {"type": "subtitle", "time": 14196.229, "timestamp": "03:56:36", "text": "。 何が手に入るの？ ラジオ"}, {"type": "subtitle", "time": 14198.55, "timestamp": "03:56:38", "text": "パック"}, {"type": "subtitle", "time": 14211.75, "timestamp": "03:56:51", "text": "1,300。 うん。 だから、これを公表したかったんです。 これは"}, {"type": "subtitle", "time": 14214.63, "timestamp": "03:56:54", "text": "ヘルメットなしのやつです。"}, {"type": "subtitle", "time": 14217.67, "timestamp": "03:56:57", "text": "ああ、開けることができます。うん、今はもっと"}, {"type": "subtitle", "time": 14219.51, "timestamp": "03:56:59", "text": "良くなりました。 パーカーの方。 見た目が"}]
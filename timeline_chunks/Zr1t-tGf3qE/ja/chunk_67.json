[{"type": "subtitle", "time": 4037.029, "timestamp": "01:07:17", "text": "でも待って、えーと、ちょっと待って、"}, {"type": "subtitle", "time": 4040.23, "timestamp": "01:07:20", "text": "待って、待って、ちょっと待って。"}, {"type": "subtitle", "time": 4042.95, "timestamp": "01:07:22", "text": "使うべきではないと思う。待って、"}, {"type": "subtitle", "time": 4045.75, "timestamp": "01:07:25", "text": "物を売ることはできるのか？"}, {"type": "subtitle", "time": 4049.75, "timestamp": "01:07:29", "text": "旧世界で見つけることができる。よし、"}, {"type": "subtitle", "time": 4051.43, "timestamp": "01:07:31", "text": "何を売ればいいのかわからない。"}, {"type": "subtitle", "time": 4053.75, "timestamp": "01:07:33", "text": "これらの銃を使い切って、"}, {"type": "subtitle", "time": 4063.75, "timestamp": "01:07:43", "text": "ライトシールド。ライトシールド。"}]
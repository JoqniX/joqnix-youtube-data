[{"type": "subtitle", "time": 2701.19, "timestamp": "00:45:01", "text": "スキルツリー。ああ、"}, {"type": "subtitle", "time": 2706.87, "timestamp": "00:45:06", "text": "後でファグとエラーの声。ああ、しゃがんでいる"}, {"type": "subtitle", "time": 2708.309, "timestamp": "00:45:08", "text": "間の移動速度が"}, {"type": "subtitle", "time": 2709.99, "timestamp": "00:45:09", "text": "上がる。より速く登ったり歩いたりできる"}, {"type": "subtitle", "time": 2713.51, "timestamp": "00:45:13", "text": "。遅くならない。シールドを装備してもあまり"}, {"type": "subtitle", "time": 2717.109, "timestamp": "00:45:17", "text": "遅くならない。"}, {"type": "subtitle", "time": 2721.589, "timestamp": "00:45:21", "text": "何をすればいい？"}, {"type": "subtitle", "time": 2724.47, "timestamp": "00:45:24", "text": "赤にしようと思う。いくつ持ってる"}, {"type": "subtitle", "time": 2728.63, "timestamp": "00:45:28", "text": "？表示されない。え？"}, {"type": "subtitle", "time": 2731.27, "timestamp": "00:45:31", "text": "よし、これにしよう。何も持ってない。何が"}, {"type": "subtitle", "time": 2742.63, "timestamp": "00:45:42", "text": "すごく弱いの？ああ、弾薬とかを作らなきゃいけないんだ"}, {"type": "subtitle", "time": 2757.03, "timestamp": "00:45:57", "text": "待って、どうやってスタッシュを拡張するの？"}, {"type": "subtitle", "time": 2759.91, "timestamp": "00:45:59", "text": "ああ、そうか。お金を使ったばかりだ。"}]
[{"type": "subtitle", "time": 9675.429, "timestamp": "02:41:15", "text": "分野。 ああ、現地報告か。"}, {"type": "subtitle", "time": 9677.59, "timestamp": "02:41:17", "text": "現地報告に行かなければならない。 それも探求の一部だ"}, {"type": "subtitle", "time": 9679.99, "timestamp": "02:41:19", "text": "。"}, {"type": "subtitle", "time": 9683.75, "timestamp": "02:41:23", "text": "着陸地点を見てみましょう。"}, {"type": "subtitle", "time": 9703.11, "timestamp": "02:41:43", "text": "現地への出発は終了しました。"}]
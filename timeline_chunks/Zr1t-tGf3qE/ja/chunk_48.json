[{"type": "subtitle", "time": 2887.51, "timestamp": "00:48:07", "text": "この全てで悲しいのは、"}, {"type": "subtitle", "time": 2891.19, "timestamp": "00:48:11", "text": "基本的にこのゲームでグラインドできないことだ"}, {"type": "subtitle", "time": 2893.99, "timestamp": "00:48:13", "text": "。本当にやりたかったんだけど、"}, {"type": "subtitle", "time": 2897.91, "timestamp": "00:48:17", "text": "今週の土曜日"}, {"type": "subtitle", "time": 2900.309, "timestamp": "00:48:20", "text": "と来週以降は試験があるから、"}, {"type": "subtitle", "time": 2903.99, "timestamp": "00:48:23", "text": "このゲームに時間を費やしてグラインドして楽しむことができない。でも、"}, {"type": "subtitle", "time": 2912.79, "timestamp": "00:48:32", "text": "1月から試験などが終わったら、私は"}, {"type": "subtitle", "time": 2915.27, "timestamp": "00:48:35", "text": "ここで時間を過ごすつもりだ。"}, {"type": "subtitle", "time": 2923.92, "timestamp": "00:48:43", "text": "。 よし、ロードされた。"}, {"type": "subtitle", "time": 2926.4, "timestamp": "00:48:46", "text": "よし、ロードされた。 かわいそうな私のPC。"}]
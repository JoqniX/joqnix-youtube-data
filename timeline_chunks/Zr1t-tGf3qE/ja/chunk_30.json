[{"type": "subtitle", "time": 1801.19, "timestamp": "00:30:01", "text": "ストアページ。"}, {"type": "subtitle", "time": 1803.43, "timestamp": "00:30:03", "text": "えーと、あれ"}, {"type": "subtitle", "time": 1806.63, "timestamp": "00:30:06", "text": "の名前は何だったっけ"}, {"type": "subtitle", "time": 1809.75, "timestamp": "00:30:09", "text": "？"}, {"type": "subtitle", "time": 1816.789, "timestamp": "00:30:16", "text": "ウォーカー。"}, {"type": "subtitle", "time": 1819.11, "timestamp": "00:30:19", "text": "デラックス。デラックスで何が手に入るんだっけ"}, {"type": "subtitle", "time": 1827.669, "timestamp": "00:30:27", "text": "えーと、ヴァンダーセット。オーケー。課金が"}, {"type": "subtitle", "time": 1829.51, "timestamp": "00:30:29", "text": "必要になるまでプレイ料金を支払う。"}, {"type": "subtitle", "time": 1844.789, "timestamp": "00:30:44", "text": "、確認させてください。えーと、"}, {"type": "subtitle", "time": 1848.23, "timestamp": "00:30:48", "text": "もう一度ブラウザを開いてください。"}, {"type": "subtitle", "time": 1857.19, "timestamp": "00:30:57", "text": "アークレイダー。"}]
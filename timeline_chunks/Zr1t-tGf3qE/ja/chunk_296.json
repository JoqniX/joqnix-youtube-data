[{"type": "subtitle", "time": 17760.788, "timestamp": "04:56:00", "text": "よし、次はスキルポイントだ。えっと、"}, {"type": "subtitle", "time": 17771.99, "timestamp": "04:56:11", "text": "そこに振っちゃおうかな。"}, {"type": "subtitle", "time": 17789.35, "timestamp": "04:56:29", "text": "スピンロール回避ファーファー"}, {"type": "subtitle", "time": 17802.31, "timestamp": "04:56:42", "text": "ああ、わかった。あとワーク"}, {"type": "subtitle", "time": 17804.708, "timestamp": "04:56:44", "text": "ショップが1つ残ってる。いや、この"}, {"type": "subtitle", "time": 17807.03, "timestamp": "04:56:47", "text": "人だ。あと1つ欲しかっただけなんだ。わかった、"}, {"type": "subtitle", "time": 17809.03, "timestamp": "04:56:49", "text": "いいよ。"}, {"type": "subtitle", "time": 17818.868, "timestamp": "04:56:58", "text": "シンアークポットから取れるかな？わかった。シンアークポット。リサイクルすれば"}]
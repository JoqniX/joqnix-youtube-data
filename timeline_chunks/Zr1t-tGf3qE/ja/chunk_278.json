[{"type": "subtitle", "time": 16690.869, "timestamp": "04:38:10", "text": "赤。いや、縁起でもないことを言ってはいけない。わかった、"}, {"type": "subtitle", "time": 16693.67, "timestamp": "04:38:13", "text": "冗談に縁起でもないことを言うのはやめよう。次はスポーツマン。"}, {"type": "subtitle", "time": 16699.59, "timestamp": "04:38:19", "text": "何か言い始めたら、本当に"}, {"type": "subtitle", "time": 16703.189, "timestamp": "04:38:23", "text": "起こってしまうかもしれないのが怖い。縁起が悪いかもしれない"}]
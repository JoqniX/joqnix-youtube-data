[{"type": "subtitle", "time": 10982.71, "timestamp": "03:03:02", "text": "間隔の点で似ていることがわかるだろう、ということです。"}, {"type": "subtitle", "time": 10987.59, "timestamp": "03:03:07", "text": "こちらの間隔がいいですね。   ええ"}, {"type": "subtitle", "time": 10990.15, "timestamp": "03:03:10", "text": "、私の家が見えますか？ うん。"}, {"type": "subtitle", "time": 10995.11, "timestamp": "03:03:15", "text": "こちらの間隔も隙間です。"}, {"type": "subtitle", "time": 10997.99, "timestamp": "03:03:17", "text": "両者とも同等である。 うん。"}, {"type": "subtitle", "time": 11001.99, "timestamp": "03:03:21", "text": "ここに足りないのは、"}, {"type": "subtitle", "time": 11009.75, "timestamp": "03:03:29", "text": "うん。 まあ、基本的には、"}, {"type": "subtitle", "time": 11013.349, "timestamp": "03:03:33", "text": "これを終えれば、これで終わりです。 はい。"}, {"type": "subtitle", "time": 11016.469, "timestamp": "03:03:36", "text": "彼らのやり方は本当にすごいですね。"}, {"type": "subtitle", "time": 11018.79, "timestamp": "03:03:38", "text": "でも、"}, {"type": "subtitle", "time": 11021.99, "timestamp": "03:03:41", "text": "後でうまくいくかどうか試してみましょう。 わかった。   どうなるか"}, {"type": "subtitle", "time": 11026.15, "timestamp": "03:03:46", "text": "楽しみです。"}, {"type": "subtitle", "time": 11028.71, "timestamp": "03:03:48", "text": "ええと、とにかく"}, {"type": "subtitle", "time": 11034.389, "timestamp": "03:03:54", "text": "、今は3時間です。"}, {"type": "subtitle", "time": 11036.87, "timestamp": "03:03:56", "text": "最初はもっと短い"}, {"type": "subtitle", "time": 11039.67, "timestamp": "03:03:59", "text": "配信をしようと思っていたんです。"}]
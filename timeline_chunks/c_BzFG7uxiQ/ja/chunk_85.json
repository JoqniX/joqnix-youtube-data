[{"type": "subtitle", "time": 5101.669, "timestamp": "01:25:01", "text": "Web Studioを開いて"}, {"type": "subtitle", "time": 5103.75, "timestamp": "01:25:03", "text": "、これを再現してみたい衝動に駆られています"}, {"type": "subtitle", "time": 5107.35, "timestamp": "01:25:07", "text": "。ぜひやってみたいです。"}, {"type": "subtitle", "time": 5109.83, "timestamp": "01:25:09", "text": "そのうち、最近Web"}, {"type": "subtitle", "time": 5112.47, "timestamp": "01:25:12", "text": "Studioの開発者たちがグリッド機能を追加したんです"}, {"type": "subtitle", "time": 5114.709, "timestamp": "01:25:14", "text": "。ええ。ええ"}, {"type": "subtitle", "time": 5116.629, "timestamp": "01:25:16", "text": "。それで、ちょっとお見せできると思うんですが、ええと、今"}, {"type": "subtitle", "time": 5136.31, "timestamp": "01:25:36", "text": "までコラボレーションしたすべてのコラボレーションパートナーのデータベースがあったんです。"}, {"type": "subtitle", "time": 5139.189, "timestamp": "01:25:39", "text": "ええ、"}, {"type": "subtitle", "time": 5149.03, "timestamp": "01:25:49", "text": "コピーをクリックして貼り付けるようなページと、自分のページなどを入れることができる"}, {"type": "subtitle", "time": 5154.87, "timestamp": "01:25:54", "text": "個人ページのようなものがありました"}]
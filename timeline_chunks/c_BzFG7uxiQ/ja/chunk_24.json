[{"type": "subtitle", "time": 1440.23, "timestamp": "00:24:00", "text": "。"}, {"type": "subtitle", "time": 1442.47, "timestamp": "00:24:02", "text": "つまり、自宅のパソコンから生配信する"}, {"type": "chat", "time": 1444.112, "timestamp": "00:24:04", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ya"}, {"type": "subtitle", "time": 1445.83, "timestamp": "00:24:05", "text": "音声だけのウォーキング配信をやってみたいんです。"}, {"type": "subtitle", "time": 1452.87, "timestamp": "00:24:12", "text": "外では"}, {"type": "subtitle", "time": 1456.63, "timestamp": "00:24:16", "text": "スマホで皆さんに話しかけるつもりです。 私も以前はそうしていました。"}, {"type": "subtitle", "time": 1458.31, "timestamp": "00:24:18", "text": "でも（鼻を鳴らして）そうしたいなら、事前に"}, {"type": "subtitle", "time": 1461.669, "timestamp": "00:24:21", "text": "サーバーを予約しないといけないんだ。 サーバーのようなものを"}, {"type": "subtitle", "time": 1464.39, "timestamp": "00:24:24", "text": "購入するために一定の金額を支払わなければならず、"}, {"type": "subtitle", "time": 1470.71, "timestamp": "00:24:30", "text": "そのサーバーは私の電話の音声を中継します。"}, {"type": "subtitle", "time": 1473.669, "timestamp": "00:24:33", "text": "もちろんビデオもできますが、"}, {"type": "subtitle", "time": 1476.71, "timestamp": "00:24:36", "text": "モバイルのビットレートの問題があるので、おそらく"}, {"type": "chat", "time": 1478.025, "timestamp": "00:24:38", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ohh"}, {"type": "subtitle", "time": 1480.31, "timestamp": "00:24:40", "text": "ビデオと音声だけになるでしょう。つまり、"}, {"type": "subtitle", "time": 1483.35, "timestamp": "00:24:43", "text": "電話からの音声フィードは"}, {"type": "subtitle", "time": 1488.149, "timestamp": "00:24:48", "text": "自宅のPCに送られます。私は"}, {"type": "subtitle", "time": 1491.19, "timestamp": "00:24:51", "text": "これを2年ほど前にやっていました"}, {"type": "subtitle", "time": 1493.59, "timestamp": "00:24:53", "text": "。 以前は朝"}, {"type": "subtitle", "time": 1496.07, "timestamp": "00:24:56", "text": "6時頃に起きていました。朝の"}, {"type": "subtitle", "time": 1498.39, "timestamp": "00:24:58", "text": "散歩やジョギングに出かけるのが習慣でした。   ああ、そうだね。"}]
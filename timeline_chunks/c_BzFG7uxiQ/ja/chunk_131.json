[{"type": "subtitle", "time": 7860.55, "timestamp": "02:11:00", "text": "パーサーのようなものを作りました"}, {"type": "subtitle", "time": 7863.51, "timestamp": "02:11:03", "text": "。ページとプロパティの両方を"}, {"type": "subtitle", "time": 7874.709, "timestamp": "02:11:14", "text": "便利です。"}, {"type": "subtitle", "time": 7880.149, "timestamp": "02:11:20", "text": "ページを利用できるようになったのは"}, {"type": "subtitle", "time": 7893.51, "timestamp": "02:11:33", "text": "正直、できると思います。"}, {"type": "subtitle", "time": 7895.43, "timestamp": "02:11:35", "text": "これらのすべて。あ、待ってください。見えていませんね"}, {"type": "subtitle", "time": 7900.95, "timestamp": "02:11:40", "text": "ええ、できると思います。"}, {"type": "subtitle", "time": 7905.83, "timestamp": "02:11:45", "text": "変更したいことの 1 つは、"}, {"type": "subtitle", "time": 7908.629, "timestamp": "02:11:48", "text": "ガイドラインのことです。この全体です"}, {"type": "subtitle", "time": 7915.109, "timestamp": "02:11:55", "text": "。実際に"}, {"type": "subtitle", "time": 7916.709, "timestamp": "02:11:56", "text": "[ため息と息を呑む]"}, {"type": "subtitle", "time": 7919.51, "timestamp": "02:11:59", "text": "どうやって終わらせればいいですか。"}]
[{"type": "subtitle", "time": 4140.709, "timestamp": "01:09:00", "text": "ああ、配信の概要、いや、ライブ"}, {"type": "subtitle", "time": 4144.309, "timestamp": "01:09:04", "text": "配信のアーカイブページのことですよね？"}, {"type": "subtitle", "time": 4147.03, "timestamp": "01:09:07", "text": "うん。 うん。 うん。 それで、最近、ライブ"}, {"type": "subtitle", "time": 4152.39, "timestamp": "01:09:12", "text": "ストリームのアーカイブみたいなことをやってるんです。"}, {"type": "subtitle", "time": 4155.51, "timestamp": "01:09:15", "text": "フォーマットが適切ではありません。   それは"}, {"type": "subtitle", "time": 4157.91, "timestamp": "01:09:17", "text": "後でやります。 でも、私の最後の"}, {"type": "subtitle", "time": 4160.229, "timestamp": "01:09:20", "text": "配信は、ええ"}, {"type": "subtitle", "time": 4163.749, "timestamp": "01:09:23", "text": "、これをクリックできます。"}, {"type": "subtitle", "time": 4169.269, "timestamp": "01:09:29", "text": "ストリームのように視聴できるページに移動します。"}, {"type": "subtitle", "time": 4176.229, "timestamp": "01:09:36", "text": "もちろん、YouTubeで見ることができます。 そして、"}, {"type": "subtitle", "time": 4182.39, "timestamp": "01:09:42", "text": "YouTubeで配信が予定されていた日時、"}, {"type": "subtitle", "time": 4185.349, "timestamp": "01:09:45", "text": "実際に配信が開始された日時、実際に"}, {"type": "subtitle", "time": 4187.11, "timestamp": "01:09:47", "text": "終了した日時、"}, {"type": "subtitle", "time": 4189.99, "timestamp": "01:09:49", "text": "配信の説明"}, {"type": "subtitle", "time": 4193.269, "timestamp": "01:09:53", "text": "や配信の文字起こし、"}, {"type": "chat", "time": 4196.04, "timestamp": "01:09:56", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "brb"}, {"type": "subtitle", "time": 4197.59, "timestamp": "01:09:57", "text": "字幕などの詳細も確認できます。"}]
[{"type": "subtitle", "time": 4260.31, "timestamp": "01:11:00", "text": "ここに記録されます。 バックエンド関連で、いろいろと修正しなければならなかった"}, {"type": "subtitle", "time": 4263.99, "timestamp": "01:11:03", "text": "。 ええ、"}, {"type": "subtitle", "time": 4272.47, "timestamp": "01:11:12", "text": "ここからライブストリームを見ることもできると思いますよ（笑）。"}, {"type": "subtitle", "time": 4274.39, "timestamp": "01:11:14", "text": "こちらのリンクからライブ配信をご覧いただけます"}, {"type": "subtitle", "time": 4286.39, "timestamp": "01:11:26", "text": "でも、ウェブ"}, {"type": "subtitle", "time": 4289.51, "timestamp": "01:11:29", "text": "サイトの"}, {"type": "subtitle", "time": 4292.95, "timestamp": "01:11:32", "text": "ことに関しては、頭の中にたくさんのアイデアがあるんです。 ただ、私はあまり得意ではないのですが"}, {"type": "subtitle", "time": 4298.39, "timestamp": "01:11:38", "text": "、ストリームでストリームを視聴すると"}, {"type": "subtitle", "time": 4299.99, "timestamp": "01:11:39", "text": "、"}, {"type": "subtitle", "time": 4312.559, "timestamp": "01:11:52", "text": "ヴァリ。  [笑い]"}]
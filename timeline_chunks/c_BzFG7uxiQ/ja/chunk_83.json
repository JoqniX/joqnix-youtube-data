[{"type": "subtitle", "time": 4982.629, "timestamp": "01:23:02", "text": "ああ、動画全体を置いてないんだ。ああ、"}, {"type": "subtitle", "time": 4986.07, "timestamp": "01:23:06", "text": "いいものだけ。オーケー。まるで"}, {"type": "subtitle", "time": 4990.07, "timestamp": "01:23:10", "text": "、ああ"}, {"type": "subtitle", "time": 4991.59, "timestamp": "01:23:11", "text": "、何かを発表してるんだろ"}, {"type": "subtitle", "time": 4993.75, "timestamp": "01:23:13", "text": "？だから、いいものだけを置いた方がいいんだ。"}, {"type": "subtitle", "time": 4999.91, "timestamp": "01:23:19", "text": "私のアイデアは、"}, {"type": "subtitle", "time": 5004.79, "timestamp": "01:23:24", "text": "ここにスライダーを置いて、ここに左右にスライダーを置いて"}, {"type": "subtitle", "time": 5005.669, "timestamp": "01:23:25", "text": "[鼻を鳴らす] えーと まさにこれです。"}, {"type": "subtitle", "time": 5012.55, "timestamp": "01:23:32", "text": "この人と一緒にやろうと思っていたことなんです。これってすごく"}, {"type": "subtitle", "time": 5015.83, "timestamp": "01:23:35", "text": "スクロールしないといけないんですよね。"}, {"type": "subtitle", "time": 5020.47, "timestamp": "01:23:40", "text": "横スクロールがあるんですが、"}, {"type": "subtitle", "time": 5023.83, "timestamp": "01:23:43", "text": "もし私が"}, {"type": "subtitle", "time": 5027.43, "timestamp": "01:23:47", "text": "ここから似たようなアイデアを真似しているなら、横スクロールがないんです。"}, {"type": "subtitle", "time": 5030.629, "timestamp": "01:23:50", "text": "ビデオの横スクロールと、ええ。ええ、できますよ。"}, {"type": "subtitle", "time": 5033.189, "timestamp": "01:23:53", "text": "ビデオを"}, {"type": "subtitle", "time": 5035.75, "timestamp": "01:23:55", "text": "ここに、ストリームをここに配置できます。ああ"}]
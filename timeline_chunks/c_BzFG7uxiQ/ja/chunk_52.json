[{"type": "subtitle", "time": 3121.03, "timestamp": "00:52:01", "text": "えーっと、それから、他に"}, {"type": "subtitle", "time": 3130.63, "timestamp": "00:52:10", "text": "とても気まずい。 いや、"}, {"type": "subtitle", "time": 3137.51, "timestamp": "00:52:17", "text": "長い間配信してなくて、"}, {"type": "subtitle", "time": 3139.99, "timestamp": "00:52:19", "text": "配信を巻き上げている時に、"}, {"type": "subtitle", "time": 3144.39, "timestamp": "00:52:24", "text": "言いたいことがたくさんあるのに何を"}, {"type": "subtitle", "time": 3147.956, "timestamp": "00:52:27", "text": "話せばいいのかわからない瞬間って、すごく気まずいんだよ"}, {"type": "subtitle", "time": 3171.829, "timestamp": "00:52:51", "text": "来月には、えっと、ウェブ"}, {"type": "subtitle", "time": 3175.43, "timestamp": "00:52:55", "text": "サイトをリニューアルしたいと思ってるんだ"}, {"type": "subtitle", "time": 3179.03, "timestamp": "00:52:59", "text": "。 それで、それは（鼻を鳴らして）"}]
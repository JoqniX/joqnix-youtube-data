[{"type": "subtitle", "time": 9121.27, "timestamp": "02:32:01", "text": "将来的に、"}, {"type": "subtitle", "time": 9123.59, "timestamp": "02:32:03", "text": "拡張性という点では、必要であれば将来的に使うこともできます"}, {"type": "subtitle", "time": 9140.63, "timestamp": "02:32:20", "text": "どこ？"}, {"type": "subtitle", "time": 9144.71, "timestamp": "02:32:24", "text": "はい。ここです。閉じる。閉じる。閉じる。これを閉じて、あれを閉じて。閉じる。閉じる"}, {"type": "subtitle", "time": 9166.389, "timestamp": "02:32:46", "text": "。閉じる。これをやって。あれをやって。"}]
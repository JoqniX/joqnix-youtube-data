[{"type": "subtitle", "time": 4440.286, "timestamp": "01:14:00", "text": "ああ"}, {"type": "subtitle", "time": 4440.95, "timestamp": "01:14:00", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 4443.83, "timestamp": "01:14:03", "text": "完全に忘れてた。 最近、私のPCが本当にわがままで、どうしようかと思ったんです。   これを"}, {"type": "subtitle", "time": 4454.79, "timestamp": "01:14:14", "text": "下げます。 そして私はそれを実行した"}, {"type": "subtitle", "time": 4479.43, "timestamp": "01:14:39", "text": "実は、"}, {"type": "subtitle", "time": 4483.59, "timestamp": "01:14:43", "text": "Sono V2のウェブサイトにすごく刺激を受けているんです。   えっと、"}, {"type": "subtitle", "time": 4486.87, "timestamp": "01:14:46", "text": "唯一やり方がわからないのは"}, {"type": "subtitle", "time": 4489.43, "timestamp": "01:14:49", "text": "音声サンプルです。 それは"}, {"type": "subtitle", "time": 4498.582, "timestamp": "01:14:58", "text": "うん。 これは本当にいいことだよね"}]
[{"type": "subtitle", "time": 7082.07, "timestamp": "01:58:02", "text": "音楽に関しても、私にも同じことが起こるんです。"}, {"type": "subtitle", "time": 7085.03, "timestamp": "01:58:05", "text": "好きな音楽を聴くと、いつも"}, {"type": "subtitle", "time": 7086.629, "timestamp": "01:58:06", "text": "「ああ、どうやってこの"}, {"type": "subtitle", "time": 7088.87, "timestamp": "01:58:08", "text": "音を作ったんだろう？どうやってこれをやったんだろう？どうやってあれをやったんだろう"}, {"type": "subtitle", "time": 7091.756, "timestamp": "01:58:11", "text": "？」って考えちゃうんだよね。"}, {"type": "subtitle", "time": 7092.709, "timestamp": "01:58:12", "text": "[鼻で笑う]"}, {"type": "subtitle", "time": 7097.27, "timestamp": "01:58:17", "text": "そして、自分が想像する、"}, {"type": "subtitle", "time": 7111.35, "timestamp": "01:58:31", "text": "彼らが作ったであろうものを再構築したり、作り直したりしようとするんだよね"}, {"type": "subtitle", "time": 7113.669, "timestamp": "01:58:33", "text": "。[笑い]"}, {"type": "subtitle", "time": 7115.27, "timestamp": "01:58:35", "text": "そう。"}, {"type": "subtitle", "time": 7128.229, "timestamp": "01:58:48", "text": "ウェブサイトのことでも同じことをしているのを見るのは嬉しい。"}, {"type": "subtitle", "time": 7131.35, "timestamp": "01:58:51", "text": "以前は音楽だったけど、"}, {"type": "subtitle", "time": 7134.629, "timestamp": "01:58:54", "text": "今は音楽だけでなく、"}]
[{"type": "subtitle", "time": 7561.83, "timestamp": "02:06:01", "text": "これはスクロールできないフル"}, {"type": "subtitle", "time": 7565.35, "timestamp": "02:06:05", "text": "スクリーンの壁紙みたいな設定の"}, {"type": "subtitle", "time": 7567.83, "timestamp": "02:06:07", "text": "ホームページシステムです。それで、"}, {"type": "subtitle", "time": 7573.589, "timestamp": "02:06:13", "text": "メニューみたいなプロファイルみたいなものを一番上に置くか、カードを追加する"}, {"type": "subtitle", "time": 7577.99, "timestamp": "02:06:17", "text": "カードみたいなものにしようと思ったんです。これを"}, {"type": "subtitle", "time": 7580.709, "timestamp": "02:06:20", "text": "クリックすると、別の"}, {"type": "subtitle", "time": 7583.189, "timestamp": "02:06:23", "text": "ページとかに移動するように。それが"}, {"type": "subtitle", "time": 7592.31, "timestamp": "02:06:32", "text": "そう、プロファイルのアイデアです。"}, {"type": "subtitle", "time": 7596.709, "timestamp": "02:06:36", "text": "これをクリックすると、"}, {"type": "subtitle", "time": 7599.75, "timestamp": "02:06:39", "text": "ページに移動して、ええ"}, {"type": "subtitle", "time": 7603.51, "timestamp": "02:06:43", "text": "、何かが見られるかもしれません。"}, {"type": "subtitle", "time": 7606.95, "timestamp": "02:06:46", "text": "ええ、何かが見られるページです。ええ。"}]
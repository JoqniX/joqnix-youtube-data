[{"type": "subtitle", "time": 7620.87, "timestamp": "02:07:00", "text": "たくさんの"}, {"type": "subtitle", "time": 7623.99, "timestamp": "02:07:03", "text": "ものを削除しないといけないんです。マイルストーンって何だったっけ？ ああ"}, {"type": "subtitle", "time": 7627.189, "timestamp": "02:07:07", "text": "、これはどうやら私の履歴ページだったみたい"}, {"type": "subtitle", "time": 7646.548, "timestamp": "02:07:26", "text": "ここにいろいろ追加しないといけないんです。"}, {"type": "subtitle", "time": 7648.47, "timestamp": "02:07:28", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 7651.669, "timestamp": "02:07:31", "text": "正直に言うと、えーと、ちょっと"}, {"type": "subtitle", "time": 7656.55, "timestamp": "02:07:36", "text": "待って。どうしてこの行を20行にしたんだろう？"}, {"type": "subtitle", "time": 7660.79, "timestamp": "02:07:40", "text": "ああ、セクションだ。ああ、そう。そう。セクション。"}, {"type": "subtitle", "time": 7664.709, "timestamp": "02:07:44", "text": "ああ、そう。セクション。セクション。そう。よし。よし。よし"}, {"type": "subtitle", "time": 7667.589, "timestamp": "02:07:47", "text": "。それで、"}, {"type": "subtitle", "time": 7672.55, "timestamp": "02:07:52", "text": "去年やったデータ全部、そうでしょ？"}, {"type": "subtitle", "time": 7674.79, "timestamp": "02:07:54", "text": "去年やったデータ全部"}, {"type": "subtitle", "time": 7678.39, "timestamp": "02:07:58", "text": "ハードコーディングだったんだよね。つまり、ハードコーディングってこと。Web"}]
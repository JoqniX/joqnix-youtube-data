[{"type": "subtitle", "time": 9031.11, "timestamp": "02:30:31", "text": "実際に保存されたんですか？ああ、保存されました。"}, {"type": "subtitle", "time": 9044.55, "timestamp": "02:30:44", "text": "キックレコーダーがちゃんと動いてます。"}, {"type": "subtitle", "time": 9045.83, "timestamp": "02:30:45", "text": "[笑い]"}, {"type": "subtitle", "time": 9050.63, "timestamp": "02:30:50", "text": "長い間配信してないのに、"}, {"type": "subtitle", "time": 9053.11, "timestamp": "02:30:53", "text": "ここに履歴があって、まるでさよならみたいに"}, {"type": "subtitle", "time": 9055.83, "timestamp": "02:30:55", "text": "動いてます。"}]
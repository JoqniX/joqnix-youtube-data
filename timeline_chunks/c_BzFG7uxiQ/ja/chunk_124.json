[{"type": "subtitle", "time": 7445.03, "timestamp": "02:04:05", "text": "でも、"}, {"type": "subtitle", "time": 7447.109, "timestamp": "02:04:07", "text": "いくつかの変数がそれを許さないんです"}, {"type": "subtitle", "time": 7449.99, "timestamp": "02:04:09", "text": "。どうしてなのか分かりません。"}, {"type": "subtitle", "time": 7452.229, "timestamp": "02:04:12", "text": "指示に従っていたのにうまくいかず、"}, {"type": "subtitle", "time": 7458.79, "timestamp": "02:04:18", "text": "そのアイデアを諦めたくなりました。だから、こういうのは、"}, {"type": "subtitle", "time": 7470.229, "timestamp": "02:04:30", "text": "Raspberry Piとか、Linuxとかが動く小さなミニ"}, {"type": "subtitle", "time": 7477.35, "timestamp": "02:04:37", "text": "デバイスがあればいいのにって思います。"}, {"type": "subtitle", "time": 7482.95, "timestamp": "02:04:42", "text": "[笑]"}, {"type": "subtitle", "time": 7488.55, "timestamp": "02:04:48", "text": "それに色々追加して、ずっと"}, {"type": "subtitle", "time": 7492.629, "timestamp": "02:04:52", "text": "動かし続ければいいんです。[笑] そうなったら"}]
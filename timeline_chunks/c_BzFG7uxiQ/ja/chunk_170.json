[{"type": "subtitle", "time": 10202.469, "timestamp": "02:50:02", "text": "17日だった。ああ。"}, {"type": "subtitle", "time": 10213.59, "timestamp": "02:50:13", "text": "ジョークを聞きたい？もちろん。どうぞ。私が"}, {"type": "subtitle", "time": 10216.23, "timestamp": "02:50:16", "text": "ジョークが下手なのは知ってるよね"}, {"type": "subtitle", "time": 10240.63, "timestamp": "02:50:40", "text": "嵐の雲があって、そこに"}, {"type": "subtitle", "time": 10245.429, "timestamp": "02:50:45", "text": "雨が降って、冷たい"}, {"type": "subtitle", "time": 10254.389, "timestamp": "02:50:54", "text": "。[鼻を鳴らす] 嵐の雲があって、"}, {"type": "subtitle", "time": 10256.753, "timestamp": "02:50:56", "text": "そこに雨の神様がいる。"}, {"type": "subtitle", "time": 10258.389, "timestamp": "02:50:58", "text": "[笑い]"}]
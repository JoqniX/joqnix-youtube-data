[{"type": "subtitle", "time": 3547.75, "timestamp": "00:59:07", "text": "最後にウェブ"}, {"type": "subtitle", "time": 3555.27, "timestamp": "00:59:15", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 3559.109, "timestamp": "00:59:19", "text": "ああ、大丈夫だ。"}, {"type": "subtitle", "time": 3561.109, "timestamp": "00:59:21", "text": "去年、去年。"}, {"type": "subtitle", "time": 3564.309, "timestamp": "00:59:24", "text": "うん。 うん。 うん。 私は覚えています。"}, {"type": "subtitle", "time": 3568.15, "timestamp": "00:59:28", "text": "うん。 うん。 うん。 私たちは、すぐ隣の"}, {"type": "subtitle", "time": 3573.51, "timestamp": "00:59:33", "text": "スペースでこれをやっていました。"}, {"type": "subtitle", "time": 3581.99, "timestamp": "00:59:41", "text": "私たちが何をしていたかって、えっと、"}, {"type": "subtitle", "time": 3586.069, "timestamp": "00:59:46", "text": "何だったっけ？ こういうものですよね？"}, {"type": "subtitle", "time": 3589.67, "timestamp": "00:59:49", "text": "テキストをプルするやつですよね？"}, {"type": "subtitle", "time": 3593.27, "timestamp": "00:59:53", "text": "私たちはまるで、たくさんのテキスト"}, {"type": "subtitle", "time": 3597.27, "timestamp": "00:59:57", "text": "情報を載せているようなものだったよね？ ああ、これ覚えてるよ"}, {"type": "subtitle", "time": 3599.911, "timestamp": "00:59:59", "text": "。  [笑い]"}]
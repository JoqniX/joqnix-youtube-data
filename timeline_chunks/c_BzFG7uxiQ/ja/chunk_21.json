[{"type": "subtitle", "time": 1263.75, "timestamp": "00:21:03", "text": "実は最近あまり活動していなかったんです。"}, {"type": "subtitle", "time": 1266.07, "timestamp": "00:21:06", "text": "だから私は「ああ、試験もあるし色々あるから"}, {"type": "subtitle", "time": 1268.149, "timestamp": "00:21:08", "text": "、"}, {"type": "subtitle", "time": 1270.87, "timestamp": "00:21:10", "text": "こういうことはやらないでおこう」と思ったんです。 とにかく、"}, {"type": "subtitle", "time": 1273.83, "timestamp": "00:21:13", "text": "今月はあまり配信はしない予定です。"}, {"type": "subtitle", "time": 1275.99, "timestamp": "00:21:15", "text": "えっと、誰に話しかけてるんですか？私は"}, {"type": "subtitle", "time": 1278.31, "timestamp": "00:21:18", "text": "マルチストリーミング中です。"}, {"type": "subtitle", "time": 1280.789, "timestamp": "00:21:20", "text": "他のプラットフォームにもユーザーはいる。"}, {"type": "subtitle", "time": 1283.029, "timestamp": "00:21:23", "text": "たとえ誰もいなくても、私は"}, {"type": "subtitle", "time": 1285.909, "timestamp": "00:21:25", "text": "喋らなきゃいけないんだよね？"}, {"type": "subtitle", "time": 1289.43, "timestamp": "00:21:29", "text": "それがストリーマーという仕事の本質だ。"}, {"type": "subtitle", "time": 1294.31, "timestamp": "00:21:34", "text": "準備状況はどうですか？ ええ、準備は順調に"}, {"type": "subtitle", "time": 1296.47, "timestamp": "00:21:36", "text": "進んでいます。"}, {"type": "subtitle", "time": 1299.51, "timestamp": "00:21:39", "text": "準備は順調に進んでいます。"}, {"type": "subtitle", "time": 1303.35, "timestamp": "00:21:43", "text": "それで、えっと、"}, {"type": "subtitle", "time": 1307.83, "timestamp": "00:21:47", "text": "今日は何の日ですか？  20日金曜日。 わかった。 私たちは"}, {"type": "subtitle", "time": 1310.39, "timestamp": "00:21:50", "text": "食べることを祝う。 いいえ、私も祝いませんでした"}, {"type": "subtitle", "time": 1313.28, "timestamp": "00:21:53", "text": "。"}]
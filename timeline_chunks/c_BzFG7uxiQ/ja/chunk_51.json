[{"type": "subtitle", "time": 3065.19, "timestamp": "00:51:05", "text": "[笑い]"}, {"type": "subtitle", "time": 3067.829, "timestamp": "00:51:07", "text": "ええ、さっきも言ったように、ゲームは"}, {"type": "subtitle", "time": 3071.91, "timestamp": "00:51:11", "text": "楽しいけど勉強も大切だ"}, {"type": "subtitle", "time": 3074.069, "timestamp": "00:51:14", "text": "けど、"}, {"type": "subtitle", "time": 3076.23, "timestamp": "00:51:16", "text": "でも、"}, {"type": "subtitle", "time": 3080.39, "timestamp": "00:51:20", "text": "ゲームをしないように集中しなきゃいけなかったんです。 うん、そう"}, {"type": "subtitle", "time": 3084.23, "timestamp": "00:51:24", "text": "自分に言い聞かせたんだ。 ゲームは禁止。"}, {"type": "subtitle", "time": 3086.385, "timestamp": "00:51:26", "text": "くそ。"}, {"type": "subtitle", "time": 3087.589, "timestamp": "00:51:27", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 3098.15, "timestamp": "00:51:38", "text": "ああ、私の、えっと、私の発表です。 あ、今、"}, {"type": "subtitle", "time": 3105.51, "timestamp": "00:51:45", "text": "私のDiscordの通知が来ました。   今、行ってきましたよ、"}]
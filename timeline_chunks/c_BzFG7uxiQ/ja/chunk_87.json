[{"type": "subtitle", "time": 5221.83, "timestamp": "01:27:01", "text": "divとか、特定の何かがあって、"}, {"type": "subtitle", "time": 5231.43, "timestamp": "01:27:11", "text": "この放送でコラボレーションしたクリエイターへのリンクがここにあるって表示されると思うんです。"}, {"type": "subtitle", "time": 5236.149, "timestamp": "01:27:16", "text": "アーカイブページを見た人が興味を持ったら、"}, {"type": "subtitle", "time": 5240.229, "timestamp": "01:27:20", "text": "フォローとかできるでしょ"}, {"type": "subtitle", "time": 5243.189, "timestamp": "01:27:23", "text": "。たくさんのコラボレーション。"}, {"type": "subtitle", "time": 5245.189, "timestamp": "01:27:25", "text": "ジョー、あなたは今や有名人よ。いいえ、違います"}, {"type": "subtitle", "time": 5247.27, "timestamp": "01:27:27", "text": "。違います。でも、"}, {"type": "subtitle", "time": 5250.87, "timestamp": "01:27:30", "text": "それらのコラボレーションは"}, {"type": "subtitle", "time": 5254.55, "timestamp": "01:27:34", "text": "過去のものです。"}, {"type": "subtitle", "time": 5257.91, "timestamp": "01:27:37", "text": "いいえ、最近はあまり多くのクリエイターとコラボレーションできないと思います"}, {"type": "subtitle", "time": 5261.03, "timestamp": "01:27:41", "text": "。"}, {"type": "subtitle", "time": 5262.79, "timestamp": "01:27:42", "text": "ええ、"}, {"type": "subtitle", "time": 5265.669, "timestamp": "01:27:45", "text": "でもそれらは、"}, {"type": "subtitle", "time": 5270.229, "timestamp": "01:27:50", "text": "えーと、なんて言うんでしょう？アーカイブ、歴史的、"}, {"type": "subtitle", "time": 5272.629, "timestamp": "01:27:52", "text": "歴史的。なんて言うんでしょう"}, {"type": "subtitle", "time": 5274.79, "timestamp": "01:27:54", "text": "？[笑い]"}]
[{"type": "subtitle", "time": 8040.47, "timestamp": "02:14:00", "text": "単に いつかグッズを売りたいと思って、とりあえず作って、"}, {"type": "subtitle", "time": 8051.35, "timestamp": "02:14:11", "text": "後でもっと良くできるようにしたんです。"}, {"type": "subtitle", "time": 8053.43, "timestamp": "02:14:13", "text": "それで、ええ、[笑い]今でも"}, {"type": "subtitle", "time": 8057.189, "timestamp": "02:14:17", "text": "覚えています。"}, {"type": "subtitle", "time": 8060.31, "timestamp": "02:14:20", "text": "配信で、いつか"}, {"type": "subtitle", "time": 8065.589, "timestamp": "02:14:25", "text": "グッズを売ったり、自分の"}, {"type": "subtitle", "time": 8069.51, "timestamp": "02:14:29", "text": "グッズを作って、それを売ってくれる会社とかを見つけられたらいいのにって言ってたんです"}, {"type": "subtitle", "time": 8073.109, "timestamp": "02:14:33", "text": "。インド"}, {"type": "subtitle", "time": 8075.35, "timestamp": "02:14:35", "text": "国内の人にも海外の人にも売れるように。それからずいぶん経ちましたが、"}, {"type": "subtitle", "time": 8094.31, "timestamp": "02:14:54", "text": "将来同じことができるようになると思います。たぶん、たぶん、"}]
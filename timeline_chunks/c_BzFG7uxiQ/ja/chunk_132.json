[{"type": "subtitle", "time": 7922.95, "timestamp": "02:12:02", "text": "実際にすべてのものを"}, {"type": "subtitle", "time": 7926.149, "timestamp": "02:12:06", "text": "ページにマッピングできたらいいなと思います。そのような感じです"}, {"type": "subtitle", "time": 7928.229, "timestamp": "02:12:08", "text": "。そうすれば、何か問題があれば"}, {"type": "subtitle", "time": 7935.99, "timestamp": "02:12:15", "text": "必要に応じて編集できますし、いつでも戻って"}, {"type": "subtitle", "time": 7941.109, "timestamp": "02:12:21", "text": "Web ビルダーから修正できます。"}, {"type": "subtitle", "time": 7951.51, "timestamp": "02:12:31", "text": "特に、ええ、 こんなの全部必要ない。"}, {"type": "subtitle", "time": 7956.47, "timestamp": "02:12:36", "text": "サービスのサムネイルとか、"}, {"type": "subtitle", "time": 7959.109, "timestamp": "02:12:39", "text": "レイザーペイの決済処理業者とか、そういうの全部削除しなきゃいけない。"}, {"type": "subtitle", "time": 7961.109, "timestamp": "02:12:41", "text": "彼らは私に「そうしなきゃいけない」って強制してた。GPD も全部持ってたし、"}, {"type": "subtitle", "time": 7968.95, "timestamp": "02:12:48", "text": "全部入れなきゃいけなかった。それに、"}]
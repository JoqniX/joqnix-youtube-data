[{"type": "subtitle", "time": 8762.15, "timestamp": "02:26:02", "text": "今は全くありませんが、私の"}, {"type": "subtitle", "time": 8765.27, "timestamp": "02:26:05", "text": "記憶が正しければずっと前に。ずっと前。ずっと前"}, {"type": "subtitle", "time": 8793.19, "timestamp": "02:26:33", "text": "、それは必要ありません。"}, {"type": "subtitle", "time": 8796.389, "timestamp": "02:26:36", "text": "この人が必要です。わかりました。H"}, {"type": "subtitle", "time": 8809.83, "timestamp": "02:26:49", "text": "セクションの位置"}, {"type": "subtitle", "time": 8816.55, "timestamp": "02:26:56", "text": "ああ、頭が痛い。これはまずい。"}]
[{"type": "subtitle", "time": 8166.629, "timestamp": "02:16:06", "text": "今日は金曜日です。6時"}, {"type": "subtitle", "time": 8172.47, "timestamp": "02:16:12", "text": "までに終わりにしましょうか。"}, {"type": "subtitle", "time": 8175.75, "timestamp": "02:16:15", "text": "よろしければ。 私がバック"}, {"type": "subtitle", "time": 8183.589, "timestamp": "02:16:23", "text": "グラウンドで作業している間、私がぺちゃくちゃ喋っているのに [笑い] [息を呑む] いいですか。私がバック"}, {"type": "subtitle", "time": 8189.549, "timestamp": "02:16:29", "text": "グラウンドで作業している間、私がぺちゃくちゃ喋っていても大丈夫ですか？"}, {"type": "subtitle", "time": 8190.47, "timestamp": "02:16:30", "text": "[息を呑む]"}, {"type": "subtitle", "time": 8194.134, "timestamp": "02:16:34", "text": "それで"}]
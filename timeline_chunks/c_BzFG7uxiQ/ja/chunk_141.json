[{"type": "subtitle", "time": 8486.95, "timestamp": "02:21:26", "text": "ちょっと待ってください。わかりました、"}, {"type": "subtitle", "time": 8489.429, "timestamp": "02:21:29", "text": "ログインさせてください。"}, {"type": "subtitle", "time": 8491.429, "timestamp": "02:21:31", "text": "それで、私たちは少し"}, {"type": "subtitle", "time": 8494.23, "timestamp": "02:21:34", "text": "仕事に移行しているところです。少しだけ仕事をして、"}, {"type": "subtitle", "time": 8496.23, "timestamp": "02:21:36", "text": "ストリームを配信しています。よろしければ"}, {"type": "subtitle", "time": 8500.55, "timestamp": "02:21:40", "text": "。"}, {"type": "subtitle", "time": 8504.389, "timestamp": "02:21:44", "text": "少しの間これをやって、"}, {"type": "subtitle", "time": 8508.469, "timestamp": "02:21:48", "text": "後で他のことに集中したいだけです。"}, {"type": "subtitle", "time": 8510.71, "timestamp": "02:21:50", "text": "これに戻りたくありません。スピードランできるかどうか試してみたいです"}, {"type": "subtitle", "time": 8512.468, "timestamp": "02:21:52", "text": "。"}, {"type": "subtitle", "time": 8513.429, "timestamp": "02:21:53", "text": "[笑い]"}, {"type": "subtitle", "time": 8515.67, "timestamp": "02:21:55", "text": "スピードランできるかどうか試してみたいです。"}, {"type": "subtitle", "time": 8517.349, "timestamp": "02:21:57", "text": "ええ、"}, {"type": "subtitle", "time": 8519.673, "timestamp": "02:21:59", "text": "スピードランできるかどうか試してみたいです。正直に言うと、"}]
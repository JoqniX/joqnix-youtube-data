[{"type": "subtitle", "time": 7980.55, "timestamp": "02:13:00", "text": "弁護士といい感じだったから、彼に「"}, {"type": "subtitle", "time": 7982.709, "timestamp": "02:13:02", "text": "これ調べてくれな​​いか？"}, {"type": "subtitle", "time": 7984.79, "timestamp": "02:13:04", "text": "このプライバシーポリシーの期間についてどう思う？」って頼んだんだ"}, {"type": "subtitle", "time": 7989.669, "timestamp": "02:13:09", "text": "。それで、頼んだんだ。確か前回行った時に何人かの"}, {"type": "subtitle", "time": 7993.83, "timestamp": "02:13:13", "text": "友達にも送ったんだ"}, {"type": "subtitle", "time": 7996.79, "timestamp": "02:13:16", "text": "。うん。"}, {"type": "subtitle", "time": 8000.149, "timestamp": "02:13:20", "text": "彼らは「大丈夫だよ」って言ってたよ"}, {"type": "subtitle", "time": 8002.872, "timestamp": "02:13:22", "text": "。"}, {"type": "subtitle", "time": 8003.43, "timestamp": "02:13:23", "text": "[笑い]"}, {"type": "subtitle", "time": 8008.39, "timestamp": "02:13:28", "text": "悪くないけど、正直言ってね。うん。"}, {"type": "subtitle", "time": 8010.55, "timestamp": "02:13:30", "text": "うん。特にこういうのは。"}, {"type": "subtitle", "time": 8013.03, "timestamp": "02:13:33", "text": "これも変更しないといけない。"}, {"type": "subtitle", "time": 8017.51, "timestamp": "02:13:37", "text": "もしくは、警告とかフラグとか、まだ"}, {"type": "subtitle", "time": 8023.589, "timestamp": "02:13:43", "text": "契約中で"}, {"type": "subtitle", "time": 8027.109, "timestamp": "02:13:47", "text": "有効じゃないから心配しないで、とか書いてある"}, {"type": "subtitle", "time": 8029.727, "timestamp": "02:13:49", "text": "。"}, {"type": "subtitle", "time": 8031.037, "timestamp": "02:13:51", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 8036.069, "timestamp": "02:13:56", "text": "こんなの全部作った理由は、ただ"}]
[{"type": "subtitle", "time": 5282.95, "timestamp": "01:28:02", "text": "でもそれは でもいいアイデアだよね？"}, {"type": "subtitle", "time": 5290.709, "timestamp": "01:28:10", "text": "つまり、これはゴリラストリームだよ"}, {"type": "subtitle", "time": 5293.83, "timestamp": "01:28:13", "text": "ね？ だから、"}, {"type": "subtitle", "time": 5299.27, "timestamp": "01:28:19", "text": "もし私が"}, {"type": "subtitle", "time": 5303.27, "timestamp": "01:28:23", "text": "望むなら、今すぐにでも座ってウェブサイトのことを頑張れるんだ。最近は、"}, {"type": "subtitle", "time": 5306.87, "timestamp": "01:28:26", "text": "ストリームで遊んだり何かをしたりする時間がないからね"}, {"type": "subtitle", "time": 5308.709, "timestamp": "01:28:28", "text": "。"}, {"type": "subtitle", "time": 5317.189, "timestamp": "01:28:37", "text": "でも、このウェブサイトをチェックすればするほど、"}, {"type": "subtitle", "time": 5319.189, "timestamp": "01:28:39", "text": "ね？"}, {"type": "subtitle", "time": 5322.87, "timestamp": "01:28:42", "text": "ああ、この人はすごく綺麗に作ったんだ。"}, {"type": "subtitle", "time": 5326.39, "timestamp": "01:28:46", "text": "背景があった。"}]
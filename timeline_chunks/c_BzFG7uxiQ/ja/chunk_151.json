[{"type": "subtitle", "time": 9060.23, "timestamp": "02:31:00", "text": "ええと、6時間ごとにすごく"}, {"type": "subtitle", "time": 9078.23, "timestamp": "02:31:18", "text": "時間もかけて何かを作って、それを"}, {"type": "subtitle", "time": 9081.59, "timestamp": "02:31:21", "text": "見ると 数週間後、あるいはしばらく"}, {"type": "subtitle", "time": 9086.95, "timestamp": "02:31:26", "text": "見ていない状態、というか、"}, {"type": "subtitle", "time": 9094.95, "timestamp": "02:31:34", "text": "しばらく使っていない状態から戻ってみると、まだちゃんと動いているのが分かります"}, {"type": "subtitle", "time": 9101.349, "timestamp": "02:31:41", "text": "。まだ動いている。まだ"}, {"type": "subtitle", "time": 9103.59, "timestamp": "02:31:43", "text": "生きている。"}, {"type": "subtitle", "time": 9106.15, "timestamp": "02:31:46", "text": "そう考えると、自分がやったんだと少し嬉しくなります"}, {"type": "subtitle", "time": 9112.87, "timestamp": "02:31:52", "text": "効率的には"}, {"type": "subtitle", "time": 9115.59, "timestamp": "02:31:55", "text": "関係ないかもしれませんが、しばらくは"}, {"type": "subtitle", "time": 9119.11, "timestamp": "02:31:59", "text": "動いていました。でも、やったんです。"}]
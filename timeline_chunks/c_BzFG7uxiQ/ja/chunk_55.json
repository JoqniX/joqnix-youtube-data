[{"type": "subtitle", "time": 3301.109, "timestamp": "00:55:01", "text": "えっと、"}, {"type": "subtitle", "time": 3304.069, "timestamp": "00:55:04", "text": "見えますか？ えっと、私のチャットをそこに載せようと思います"}, {"type": "subtitle", "time": 3315.91, "timestamp": "00:55:15", "text": "ああ、はい、どうぞ"}, {"type": "subtitle", "time": 3323.27, "timestamp": "00:55:23", "text": "こんにちは。  [鼻を鳴らす] つまり、これはVのウェブ"}, {"type": "subtitle", "time": 3327.43, "timestamp": "00:55:27", "text": "サイトみたいなものですね。 お見せしましょう。"}, {"type": "subtitle", "time": 3330.069, "timestamp": "00:55:30", "text": "ええと、日本のユーチューバーの多くが"}, {"type": "subtitle", "time": 3334.63, "timestamp": "00:55:34", "text": "これを使っています。 ええと、制限があります。"}, {"type": "subtitle", "time": 3337.51, "timestamp": "00:55:37", "text": "少し制限があります。 えっと、"}, {"type": "subtitle", "time": 3340.549, "timestamp": "00:55:40", "text": "ここにはごく少数の方しか参加できません。"}, {"type": "subtitle", "time": 3344.069, "timestamp": "00:55:44", "text": "ええと、そうですね、"}, {"type": "subtitle", "time": 3352.973, "timestamp": "00:55:52", "text": "、ではこの人を取り上げてみましょう。"}, {"type": "subtitle", "time": 3354.63, "timestamp": "00:55:54", "text": "[鼻を鳴らす] つまり、スプラッシュ"}, {"type": "subtitle", "time": 3356.47, "timestamp": "00:55:56", "text": "スクリーンみたいなものですね。"}]
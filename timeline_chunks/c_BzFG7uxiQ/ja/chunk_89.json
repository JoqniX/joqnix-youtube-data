[{"type": "subtitle", "time": 5340.07, "timestamp": "01:29:00", "text": "これはすごくクールだ。ああ、"}, {"type": "subtitle", "time": 5342.95, "timestamp": "01:29:02", "text": "たくさんの人がそれぞれクールな"}, {"type": "subtitle", "time": 5346.07, "timestamp": "01:29:06", "text": "ことをしている。これはいい。"}, {"type": "subtitle", "time": 5349.51, "timestamp": "01:29:09", "text": "インスピレーションが湧いてきたよ。"}, {"type": "subtitle", "time": 5352.709, "timestamp": "01:29:12", "text": "インスピレーションが湧いてきたら誰か止めてくれ。[笑い]"}, {"type": "subtitle", "time": 5356.149, "timestamp": "01:29:16", "text": "行かないで。この時点で、私は"}, {"type": "subtitle", "time": 5360.95, "timestamp": "01:29:20", "text": "すべてのYouTuberのプロフィールをチェックするよ。"}, {"type": "subtitle", "time": 5364.39, "timestamp": "01:29:24", "text": "この人も、似たような、いや、似たような、"}, {"type": "subtitle", "time": 5369.59, "timestamp": "01:29:29", "text": "基本的な"}, {"type": "subtitle", "time": 5373.59, "timestamp": "01:29:33", "text": "設定、カスタムではなく、"}, {"type": "subtitle", "time": 5379.43, "timestamp": "01:29:39", "text": "他のもののようなカスタムではない、このようなカスタムではないものを使っていると思う。"}, {"type": "subtitle", "time": 5382.629, "timestamp": "01:29:42", "text": "待って、これは影？"}, {"type": "subtitle", "time": 5385.51, "timestamp": "01:29:45", "text": "待って。ああ、待って。これ見た？"}, {"type": "subtitle", "time": 5388.79, "timestamp": "01:29:48", "text": "箱に影をつけたんだ。"}]
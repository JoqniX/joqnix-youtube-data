[{"type": "subtitle", "time": 10570.07, "timestamp": "02:56:10", "text": "4K 16K の高画質スクリーンショットを撮って"}, {"type": "subtitle", "time": 10573.59, "timestamp": "02:56:13", "text": "ズームインできるのを見たことがある。画質は落ちないんだ"}, {"type": "subtitle", "time": 10575.75, "timestamp": "02:56:15", "text": "。"}, {"type": "subtitle", "time": 10579.51, "timestamp": "02:56:19", "text": "うん、 いいね。"}, {"type": "subtitle", "time": 10581.11, "timestamp": "02:56:21", "text": "こういう時は、"}, {"type": "subtitle", "time": 10594.55, "timestamp": "02:56:34", "text": "最近、すぐに使えるように追加したよ。"}, {"type": "subtitle", "time": 10605.269, "timestamp": "02:56:45", "text": "最大50MPのサムネイルに「いいね」を追加するには、いいねを追加してください。"}, {"type": "subtitle", "time": 10617.007, "timestamp": "02:56:57", "text": "これは一体何だろう？ ええと、"}, {"type": "subtitle", "time": 10618.71, "timestamp": "02:56:58", "text": "[鼻を鳴らして]"}]
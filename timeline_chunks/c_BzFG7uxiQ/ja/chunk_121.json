[{"type": "subtitle", "time": 7260.31, "timestamp": "02:01:00", "text": "（笑）"}, {"type": "subtitle", "time": 7266.39, "timestamp": "02:01:06", "text": "。だから、私が"}, {"type": "subtitle", "time": 7275.669, "timestamp": "02:01:15", "text": "複雑なことを言ったり、あれこれ指示を出したりしても、家族には理解しにくいでしょう"}, {"type": "subtitle", "time": 7280.47, "timestamp": "02:01:20", "text": "。それで、"}, {"type": "subtitle", "time": 7282.79, "timestamp": "02:01:22", "text": "うーん、"}, {"type": "subtitle", "time": 7285.669, "timestamp": "02:01:25", "text": "あのね、"}, {"type": "subtitle", "time": 7291.99, "timestamp": "02:01:31", "text": "24時間365日プロジェクトは廃止するかアーカイブするつもりだけど、"}, {"type": "subtitle", "time": 7300.31, "timestamp": "02:01:40", "text": "お尻があるけど、"}, {"type": "subtitle", "time": 7304.87, "timestamp": "02:01:44", "text": "私のウェブサイトからはまだ見ることができるよ。"}, {"type": "subtitle", "time": 7306.709, "timestamp": "02:01:46", "text": "うん。"}, {"type": "subtitle", "time": 7308.39, "timestamp": "02:01:48", "text": "うん、私のウェブサイトからはまだ見ることができるよ"}, {"type": "subtitle", "time": 7311.589, "timestamp": "02:01:51", "text": "。ここに行けばいい。ああ"}, {"type": "subtitle", "time": 7314.229, "timestamp": "02:01:54", "text": "、これは何？"}, {"type": "subtitle", "time": 7316.31, "timestamp": "02:01:56", "text": "何が起こったの？"}, {"type": "subtitle", "time": 7317.83, "timestamp": "02:01:57", "text": "N。"}, {"type": "subtitle", "time": 7319.83, "timestamp": "02:01:59", "text": "ああ、何が起こったの？何が"}]
[{"type": "subtitle", "time": 6251.75, "timestamp": "01:44:11", "text": "それは、それは、おそらく"}, {"type": "subtitle", "time": 6256.229, "timestamp": "01:44:16", "text": "何らかの [鼻を鳴らす] CSS のようなものだと思います。"}, {"type": "subtitle", "time": 6261.27, "timestamp": "01:44:21", "text": "それはすごくクールだね。 もちろん。 特に、どうやって"}, {"type": "subtitle", "time": 6269.91, "timestamp": "01:44:29", "text": "Hをやったのかという点が"}, {"type": "subtitle", "time": 6277.03, "timestamp": "01:44:37", "text": "うん。 こういうのを見ると、ドキドキ"}, {"type": "subtitle", "time": 6283.51, "timestamp": "01:44:43", "text": "ワクワクって言いたくなって、「あー、これめっちゃ"}, {"type": "subtitle", "time": 6286.229, "timestamp": "01:44:46", "text": "かっこいい」って思うんだ。 私は"}]
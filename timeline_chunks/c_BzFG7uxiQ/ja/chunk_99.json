[{"type": "subtitle", "time": 5940.39, "timestamp": "01:39:00", "text": "ガンダムだ。"}, {"type": "subtitle", "time": 5944.229, "timestamp": "01:39:04", "text": "なぜガンダムが [笑い]"}, {"type": "subtitle", "time": 5948.79, "timestamp": "01:39:08", "text": "正義の勇者シガーだったと思うんだろう？"}, {"type": "subtitle", "time": 5950.733, "timestamp": "01:39:10", "text": "すごい。"}, {"type": "subtitle", "time": 5951.75, "timestamp": "01:39:11", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 5958.47, "timestamp": "01:39:18", "text": "彼らのペルソナがガンダムなら、明らかにガンダムファンでしょうね（笑）"}, {"type": "subtitle", "time": 5960.07, "timestamp": "01:39:20", "text": "。"}, {"type": "subtitle", "time": 5962.709, "timestamp": "01:39:22", "text": "つまり、"}, {"type": "subtitle", "time": 5965.83, "timestamp": "01:39:25", "text": "男です。ええ。おすすめのメディアは"}, {"type": "subtitle", "time": 5968.149, "timestamp": "01:39:28", "text": "エクスティングラでした。"}, {"type": "subtitle", "time": 5971.669, "timestamp": "01:39:31", "text": "それで、これを見ていくうちに、"}, {"type": "subtitle", "time": 5975.35, "timestamp": "01:39:35", "text": "インスピレーションが湧いてきました。"}, {"type": "subtitle", "time": 5976.709, "timestamp": "01:39:36", "text": "ええ。（笑）それをRobloxで構築する"}, {"type": "subtitle", "time": 5979.03, "timestamp": "01:39:39", "text": "。"}, {"type": "subtitle", "time": 5981.43, "timestamp": "01:39:41", "text": "いいですね。"}, {"type": "subtitle", "time": 5983.83, "timestamp": "01:39:43", "text": "それで、これらを見ていくうちに、"}, {"type": "subtitle", "time": 5986.709, "timestamp": "01:39:46", "text": "インスピレーションが湧いてきて、"}, {"type": "subtitle", "time": 5988.47, "timestamp": "01:39:48", "text": "「ああ、"}, {"type": "subtitle", "time": 5992.31, "timestamp": "01:39:52", "text": "ここにあるものを再現することもできるな、これは"}, {"type": "subtitle", "time": 5996.629, "timestamp": "01:39:56", "text": "本当に素晴らしい」と思ったんです。 必要であれば再現することもできます。"}]
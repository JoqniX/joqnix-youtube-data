[{"type": "subtitle", "time": 5162.87, "timestamp": "01:26:02", "text": "。"}, {"type": "subtitle", "time": 5171.35, "timestamp": "01:26:11", "text": "それで、こんな感じになりました。ええ、"}, {"type": "subtitle", "time": 5173.99, "timestamp": "01:26:13", "text": "最近グリッド機能を追加したんですが、"}, {"type": "subtitle", "time": 5177.11, "timestamp": "01:26:17", "text": "以前は横幅がすごく広くて、"}, {"type": "subtitle", "time": 5184.47, "timestamp": "01:26:24", "text": "ページからはみ出していました。今は、"}, {"type": "subtitle", "time": 5187.27, "timestamp": "01:26:27", "text": "1、2、3、4、5"}, {"type": "subtitle", "time": 5189.51, "timestamp": "01:26:29", "text": "タイルみたいな感じにしました。下にスクロールできます"}, {"type": "subtitle", "time": 5192.629, "timestamp": "01:26:32", "text": "。 ええ、"}, {"type": "subtitle", "time": 5197.43, "timestamp": "01:26:37", "text": "過去にコラボレーションした人たちはみんなここにいます。"}, {"type": "subtitle", "time": 5200.229, "timestamp": "01:26:40", "text": "それで、"}, {"type": "subtitle", "time": 5203.59, "timestamp": "01:26:43", "text": "前回の配信で、すごく"}, {"type": "subtitle", "time": 5208.149, "timestamp": "01:26:48", "text": "クールだろうなって話してたと思うんですけど、いや、"}, {"type": "subtitle", "time": 5211.35, "timestamp": "01:26:51", "text": "特にアーカイブページでは、"}, {"type": "subtitle", "time": 5217.91, "timestamp": "01:26:57", "text": "クリエイターとのコラボレーションだった場合、"}]
[{"type": "subtitle", "time": 3481.27, "timestamp": "00:58:01", "text": "素晴らしいのです。 つまり、これは私のウェブ"}, {"type": "subtitle", "time": 3484.39, "timestamp": "00:58:04", "text": "サイトを作る際のインスピレーションとして活用すべきなのかもしれない"}, {"type": "subtitle", "time": 3486.23, "timestamp": "00:58:06", "text": "。"}, {"type": "subtitle", "time": 3488.95, "timestamp": "00:58:08", "text": "持続する。 でも、私にはこんなスプラッシュ"}, {"type": "subtitle", "time": 3491.91, "timestamp": "00:58:11", "text": "スクリーンはありません。   私は"}, {"type": "subtitle", "time": 3497.51, "timestamp": "00:58:17", "text": "資産面で不足している。"}, {"type": "subtitle", "time": 3499.349, "timestamp": "00:58:19", "text": "だから、"}, {"type": "subtitle", "time": 3501.91, "timestamp": "00:58:21", "text": "大丈夫です。  [笑い] 大丈夫です。 えっと、"}, {"type": "subtitle", "time": 3508.71, "timestamp": "00:58:28", "text": "大丈夫です。"}, {"type": "subtitle", "time": 3512.14, "timestamp": "00:58:32", "text": "将来的にいくつかアート作品を依頼するつもりです。"}, {"type": "subtitle", "time": 3523.349, "timestamp": "00:58:43", "text": "いい子にしてきたよ。 最近どうですか？調子は"}, {"type": "subtitle", "time": 3525.589, "timestamp": "00:58:45", "text": "どうですか？ 前回お会いした時は、まだ"}, {"type": "subtitle", "time": 3527.03, "timestamp": "00:58:47", "text": "ウェブ"}, {"type": "subtitle", "time": 3530.309, "timestamp": "00:58:50", "text": "サイトの制作に取り組んでいらっしゃいましたね。 そうそう。 ちょっと待って、"}, {"type": "subtitle", "time": 3533.589, "timestamp": "00:58:53", "text": "最後に来たのはいつだったっけ？ えっと、"}]
[{"type": "subtitle", "time": 4621.189, "timestamp": "01:17:01", "text": "アート、"}, {"type": "subtitle", "time": 4626.229, "timestamp": "01:17:06", "text": "ビデオなど。待って、これらは実際には"}, {"type": "subtitle", "time": 4629.99, "timestamp": "01:17:09", "text": "リーダーリンク、CTAリンクです。"}, {"type": "subtitle", "time": 4631.59, "timestamp": "01:17:11", "text": "面白い。"}, {"type": "subtitle", "time": 4634.07, "timestamp": "01:17:14", "text": "そしてサムネイルが付けられています。ああ、"}, {"type": "subtitle", "time": 4637.43, "timestamp": "01:17:17", "text": "とても興味深い。ああ、なんてことだ。"}, {"type": "subtitle", "time": 4652.229, "timestamp": "01:17:32", "text": "そうです。タグが入っています。ああ、これはとても"}, {"type": "subtitle", "time": 4654.709, "timestamp": "01:17:34", "text": "いいですね。"}, {"type": "subtitle", "time": 4659.83, "timestamp": "01:17:39", "text": "私にもできます。待って、私にもできます。"}, {"type": "subtitle", "time": 4662.63, "timestamp": "01:17:42", "text": "待って、これは実際には私にとって簡単です。"}, {"type": "subtitle", "time": 4671.11, "timestamp": "01:17:51", "text": "なぜなら、私はすでにアーカイブページを作成済みだからです。そうですよね？"}, {"type": "subtitle", "time": 4674.07, "timestamp": "01:17:54", "text": "ええ、簡単になります。ええ"}, {"type": "subtitle", "time": 4675.91, "timestamp": "01:17:55", "text": "。ええ。ええ。ええ。では、"}, {"type": "subtitle", "time": 4679.189, "timestamp": "01:17:59", "text": "なぜ簡単なのか説明します。ええと、"}]
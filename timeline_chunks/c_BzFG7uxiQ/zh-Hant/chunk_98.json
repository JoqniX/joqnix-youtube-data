[{"type": "subtitle", "time": 5890.229, "timestamp": "01:38:10", "text": "然後就不管"}, {"type": "subtitle", "time": 5892.55, "timestamp": "01:38:12", "text": "了。他們建好之後就很少用，"}, {"type": "subtitle", "time": 5895.189, "timestamp": "01:38:15", "text": "這樣不好，對吧？他們得把不"}, {"type": "subtitle", "time": 5903.83, "timestamp": "01:38:23", "text": "活躍的頁面"}, {"type": "subtitle", "time": 5908.07, "timestamp": "01:38:28", "text": "刪掉，對吧？你肯定不想這樣。他們也不想這麼做，對吧"}, {"type": "subtitle", "time": 5915.27, "timestamp": "01:38:35", "text": "？那樣太麻煩了。而且，如果你在線上的話，你就能看到這個，對吧？就像那些創作者，那些真正在線的人，我覺得他們以後會添加聊天系統之類的"}, {"type": "subtitle", "time": 5918.87, "timestamp": "01:38:38", "text": "。不太確定。"}, {"type": "chat", "time": 5932.794, "timestamp": "01:38:52", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "mechhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh"}, {"type": "chat", "time": 5936.427, "timestamp": "01:38:56", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "lessssssssgoooooooooooooooo"}]
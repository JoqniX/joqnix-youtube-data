[{"type": "subtitle", "time": 6601.83, "timestamp": "01:50:01", "text": "呃，大概是40吧。"}, {"type": "subtitle", "time": 6610.55, "timestamp": "01:50:10", "text": "好的，我做到了。等等，等等，等等。呃，"}, {"type": "subtitle", "time": 6612.709, "timestamp": "01:50:12", "text": "視窗"}, {"type": "subtitle", "time": 6624.31, "timestamp": "01:50:24", "text": "嗯，夥計，夥計，夥計。  我見過他們，不，是我做的。我做到了"}, {"type": "subtitle", "time": 6641.99, "timestamp": "01:50:41", "text": "我剛剛就"}]
[{"type": "subtitle", "time": 1263.75, "timestamp": "00:21:03", "text": "我最近沒做什麼事。"}, {"type": "subtitle", "time": 1266.07, "timestamp": "00:21:06", "text": "所以我就想，「是啊，我還要考試什麼的"}, {"type": "subtitle", "time": 1268.149, "timestamp": "00:21:08", "text": "，所以我就不費心"}, {"type": "subtitle", "time": 1270.87, "timestamp": "00:21:10", "text": "做這些事了。」總之，"}, {"type": "subtitle", "time": 1273.83, "timestamp": "00:21:13", "text": "這個月我不會進行太多直播。"}, {"type": "subtitle", "time": 1275.99, "timestamp": "00:21:15", "text": "呃，你在跟誰說話？我正在同時進行"}, {"type": "subtitle", "time": 1278.31, "timestamp": "00:21:18", "text": "多平台直播。"}, {"type": "subtitle", "time": 1280.789, "timestamp": "00:21:20", "text": "其他平台上也有人。"}, {"type": "subtitle", "time": 1283.029, "timestamp": "00:21:23", "text": "即使沒人，我也可以……我必須"}, {"type": "subtitle", "time": 1285.909, "timestamp": "00:21:25", "text": "說點什麼，對吧？"}, {"type": "subtitle", "time": 1289.43, "timestamp": "00:21:29", "text": "這就是主播的工作內容。"}, {"type": "subtitle", "time": 1294.31, "timestamp": "00:21:34", "text": "準備工作進行得如何？是的，準備工作進展"}, {"type": "subtitle", "time": 1296.47, "timestamp": "00:21:36", "text": "順利。  準備工作進展順利"}, {"type": "subtitle", "time": 1299.51, "timestamp": "00:21:39", "text": "。  所以，呃，我"}, {"type": "subtitle", "time": 1303.35, "timestamp": "00:21:43", "text": "得知道"}, {"type": "subtitle", "time": 1307.83, "timestamp": "00:21:47", "text": "今天是幾號了？星期五，20號。好的。我們"}, {"type": "subtitle", "time": 1310.39, "timestamp": "00:21:50", "text": "慶祝美食。不，我也沒有慶祝"}, {"type": "subtitle", "time": 1313.28, "timestamp": "00:21:53", "text": "。"}]
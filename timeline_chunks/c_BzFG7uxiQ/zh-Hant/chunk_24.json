[{"type": "subtitle", "time": 1440.23, "timestamp": "00:24:00", "text": "。"}, {"type": "subtitle", "time": 1442.47, "timestamp": "00:24:02", "text": "我的意思是，我很想做一個步行直播"}, {"type": "chat", "time": 1444.112, "timestamp": "00:24:04", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ya"}, {"type": "subtitle", "time": 1445.83, "timestamp": "00:24:05", "text": "，一個只有音訊的步行直播，"}, {"type": "subtitle", "time": 1448.549, "timestamp": "00:24:08", "text": "我會在家裡的電腦上進行直播，同時"}, {"type": "subtitle", "time": 1452.87, "timestamp": "00:24:12", "text": "我會在戶外用"}, {"type": "subtitle", "time": 1456.63, "timestamp": "00:24:16", "text": "手機和大家聊天。我以前也這樣做過。"}, {"type": "subtitle", "time": 1458.31, "timestamp": "00:24:18", "text": "但是[嗤之以鼻]如果我想那樣做，"}, {"type": "subtitle", "time": 1461.669, "timestamp": "00:24:21", "text": "就得提前預訂服務員。我得花"}, {"type": "subtitle", "time": 1464.39, "timestamp": "00:24:24", "text": "一定的錢買個"}, {"type": "subtitle", "time": 1467.11, "timestamp": "00:24:27", "text": "伺服器之類的東西，這個"}, {"type": "subtitle", "time": 1470.71, "timestamp": "00:24:30", "text": "伺服器會傳輸我手機的"}, {"type": "subtitle", "time": 1473.669, "timestamp": "00:24:33", "text": "音頻，當然我也可以傳輸視頻，但是"}, {"type": "subtitle", "time": 1476.71, "timestamp": "00:24:36", "text": "手機的比特率有問題，所以我"}, {"type": "chat", "time": 1478.025, "timestamp": "00:24:38", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ohh"}, {"type": "subtitle", "time": 1480.31, "timestamp": "00:24:40", "text": "可能會用視頻音頻，這樣我"}, {"type": "subtitle", "time": 1483.35, "timestamp": "00:24:43", "text": "手機的音頻信號就會傳到我"}, {"type": "subtitle", "time": 1488.149, "timestamp": "00:24:48", "text": "家裡的電腦上。我以前也"}, {"type": "subtitle", "time": 1491.19, "timestamp": "00:24:51", "text": "這麼做過，大概兩年前吧"}, {"type": "subtitle", "time": 1493.59, "timestamp": "00:24:53", "text": "。我以前通常早上六點就會起床。我們經常一起"}, {"type": "subtitle", "time": 1496.07, "timestamp": "00:24:56", "text": "晨間"}, {"type": "subtitle", "time": 1498.39, "timestamp": "00:24:58", "text": "運動和慢跑。  嗯，是啊"}]
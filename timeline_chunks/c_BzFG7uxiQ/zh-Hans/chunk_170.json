[{"type": "subtitle", "time": 10202.469, "timestamp": "02:50:02", "text": "第17名。哦。"}, {"type": "subtitle", "time": 10213.59, "timestamp": "02:50:13", "text": "想听个笑话吗？当然。讲吧。"}, {"type": "subtitle", "time": 10216.23, "timestamp": "02:50:16", "text": "我想你知道我不擅长讲笑话，"}, {"type": "subtitle", "time": 10240.63, "timestamp": "02:50:40", "text": "我想画一朵暴风云，然后，"}, {"type": "subtitle", "time": 10245.429, "timestamp": "02:50:45", "text": "那里有，那里有雨，冷"}, {"type": "subtitle", "time": 10254.389, "timestamp": "02:50:54", "text": "我的天哪。[嗤笑]暴风云，"}, {"type": "subtitle", "time": 10256.753, "timestamp": "02:50:56", "text": "那里还有雨神。"}, {"type": "subtitle", "time": 10258.389, "timestamp": "02:50:58", "text": "[笑声]这是"}]
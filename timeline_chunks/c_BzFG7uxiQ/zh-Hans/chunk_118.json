[{"type": "subtitle", "time": 7082.07, "timestamp": "01:58:02", "text": "音乐也有同样的感觉。 每当我听"}, {"type": "subtitle", "time": 7085.03, "timestamp": "01:58:05", "text": "喜欢的音乐时，我就会"}, {"type": "subtitle", "time": 7086.629, "timestamp": "01:58:06", "text": "想，“哦，他们是怎么做出这种"}, {"type": "subtitle", "time": 7088.87, "timestamp": "01:58:08", "text": "声音的？他们是怎么做到这个的？他们是怎么"}, {"type": "subtitle", "time": 7091.756, "timestamp": "01:58:11", "text": "做到那个的？”"}, {"type": "subtitle", "time": 7092.709, "timestamp": "01:58:12", "text": "[嗤笑]"}, {"type": "subtitle", "time": 7097.27, "timestamp": "01:58:17", "text": "然后你就会一直这样，不断地"}, {"type": "subtitle", "time": 7101.43, "timestamp": "01:58:21", "text": "尝试去"}, {"type": "subtitle", "time": 7102.95, "timestamp": "01:58:22", "text": "重构"}, {"type": "subtitle", "time": 7105.43, "timestamp": "01:58:25", "text": "或重现"}, {"type": "subtitle", "time": 7108.07, "timestamp": "01:58:28", "text": "你认为"}, {"type": "subtitle", "time": 7111.35, "timestamp": "01:58:31", "text": "他们创作的方式"}, {"type": "subtitle", "time": 7113.669, "timestamp": "01:58:33", "text": "。[笑声] 是的"}, {"type": "subtitle", "time": 7115.27, "timestamp": "01:58:35", "text": "。很高兴"}, {"type": "subtitle", "time": 7124.31, "timestamp": "01:58:44", "text": "看到，我做"}, {"type": "subtitle", "time": 7128.229, "timestamp": "01:58:48", "text": "网站相关的事情也是如此。"}, {"type": "subtitle", "time": 7131.35, "timestamp": "01:58:51", "text": "以前我只关注音乐。"}, {"type": "subtitle", "time": 7134.629, "timestamp": "01:58:54", "text": "现在，不只是音乐，我也在做"}]
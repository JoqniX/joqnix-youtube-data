[{"type": "subtitle", "time": 4440.286, "timestamp": "01:14:00", "text": "呃"}, {"type": "subtitle", "time": 4440.95, "timestamp": "01:14:00", "text": "[嗤笑]"}, {"type": "subtitle", "time": 4443.83, "timestamp": "01:14:03", "text": "完全忘了。 最近我的电脑真是太不给力了，"}, {"type": "subtitle", "time": 4451.35, "timestamp": "01:14:11", "text": "我当时就想，哎，我该怎么办？"}, {"type": "subtitle", "time": 4454.79, "timestamp": "01:14:14", "text": "我这就把这东西放低点。 我做到了"}, {"type": "subtitle", "time": 4479.43, "timestamp": "01:14:39", "text": "我其实真的被"}, {"type": "subtitle", "time": 4483.59, "timestamp": "01:14:43", "text": "Sono V2的网站设计深深吸引了。   嗯，"}, {"type": "subtitle", "time": 4486.87, "timestamp": "01:14:46", "text": "我唯一不知道怎么"}, {"type": "subtitle", "time": 4489.43, "timestamp": "01:14:49", "text": "做的就是音频样本。 我想我"}, {"type": "subtitle", "time": 4498.582, "timestamp": "01:14:58", "text": "。 这感觉真好"}]
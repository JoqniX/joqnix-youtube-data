[{"type": "subtitle", "time": 5162.87, "timestamp": "01:26:02", "text": "只供我自己参考。实际上，我必须"}, {"type": "subtitle", "time": 5171.35, "timestamp": "01:26:11", "text": "它看起来是这样的。是的"}, {"type": "subtitle", "time": 5173.99, "timestamp": "01:26:13", "text": "，我之前添加了网格"}, {"type": "subtitle", "time": 5177.11, "timestamp": "01:26:17", "text": "布局，以前它横向展开很"}, {"type": "subtitle", "time": 5180.31, "timestamp": "01:26:20", "text": "宽，都超出页面范围了。"}, {"type": "subtitle", "time": 5184.47, "timestamp": "01:26:24", "text": "现在我把它改成了"}, {"type": "subtitle", "time": 5187.27, "timestamp": "01:26:27", "text": "一、二、三、四、五格的"}, {"type": "subtitle", "time": 5189.51, "timestamp": "01:26:29", "text": "布局。你可以向下滚动"}, {"type": "subtitle", "time": 5192.629, "timestamp": "01:26:32", "text": "。所以，是的，所有"}, {"type": "subtitle", "time": 5194.47, "timestamp": "01:26:34", "text": "我合作过的伙伴…… 以前合作过的都在"}, {"type": "subtitle", "time": 5197.43, "timestamp": "01:26:37", "text": "这里。"}, {"type": "subtitle", "time": 5200.229, "timestamp": "01:26:40", "text": "所以，我就想，嗯，我记得"}, {"type": "subtitle", "time": 5203.59, "timestamp": "01:26:43", "text": "上次直播的时候说过，这主意"}, {"type": "subtitle", "time": 5208.149, "timestamp": "01:26:48", "text": "太棒了。不，我觉得，"}, {"type": "subtitle", "time": 5211.35, "timestamp": "01:26:51", "text": "特别是对于我的存档页面，"}, {"type": "subtitle", "time": 5214.229, "timestamp": "01:26:54", "text": "如果是"}, {"type": "subtitle", "time": 5217.91, "timestamp": "01:26:57", "text": "和创作者的合作，页面上会有一个"}]
[{"type": "subtitle", "time": 9031.11, "timestamp": "02:30:31", "text": "它真的保存了吗？哦，保存了。"}, {"type": "subtitle", "time": 9044.55, "timestamp": "02:30:44", "text": "我的踢球录制器居然真的在工作"}, {"type": "subtitle", "time": 9045.83, "timestamp": "02:30:45", "text": "[笑]"}, {"type": "subtitle", "time": 9048.23, "timestamp": "02:30:48", "text": "我已经很久没直播了，"}, {"type": "subtitle", "time": 9053.11, "timestamp": "02:30:53", "text": "我在这里看到了我的历史记录，它"}, {"type": "subtitle", "time": 9055.83, "timestamp": "02:30:55", "text": "一直运行得很好。"}]
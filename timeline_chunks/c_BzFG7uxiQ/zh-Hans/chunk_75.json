[{"type": "subtitle", "time": 4506.709, "timestamp": "01:15:06", "text": "因为嗯，在我的社交媒体上，对吧？"}, {"type": "subtitle", "time": 4510.55, "timestamp": "01:15:10", "text": "我的社交媒体上，我总是会附上我的"}, {"type": "subtitle", "time": 4514.39, "timestamp": "01:15:14", "text": "dognix.space 网站链接，对吧？ 所以如果一个"}, {"type": "subtitle", "time": 4516.79, "timestamp": "01:15:16", "text": "陌生人随便"}, {"type": "subtitle", "time": 4518.229, "timestamp": "01:15:18", "text": "看看这个网站，他们会"}, {"type": "subtitle", "time": 4522.229, "timestamp": "01:15:22", "text": "说：“好吧，我们看到了……"}, {"type": "subtitle", "time": 4524.31, "timestamp": "01:15:24", "text": "”他们会说：“哦，我来给你看看"}, {"type": "subtitle", "time": 4528.229, "timestamp": "01:15:28", "text": "实时反应。”等等，"}, {"type": "subtitle", "time": 4531.51, "timestamp": "01:15:31", "text": "我来给你看看什么实时反应……"}, {"type": "subtitle", "time": 4537.35, "timestamp": "01:15:37", "text": "假设这是白人的"}, {"type": "subtitle", "time": 4539.51, "timestamp": "01:15:39", "text": "反应，"}, {"type": "subtitle", "time": 4542.709, "timestamp": "01:15:42", "text": "他们会说：“好吧，这是个笑话。”"}, {"type": "subtitle", "time": 4545.11, "timestamp": "01:15:45", "text": "然后他们往下滚动，也许这个"}, {"type": "subtitle", "time": 4549.189, "timestamp": "01:15:49", "text": "视频会播放……他们不会"}, {"type": "subtitle", "time": 4551.91, "timestamp": "01:15:51", "text": "替换……我不需要那样做……"}, {"type": "subtitle", "time": 4554.63, "timestamp": "01:15:54", "text": "然后还有一个Discord服务器之类的东西……我"}, {"type": "subtitle", "time": 4556.31, "timestamp": "01:15:56", "text": "还需要修复它……鼠标"}, {"type": "subtitle", "time": 4559.91, "timestamp": "01:15:59", "text": "悬停在上面时没有鼠标指针……"}]
[{"type": "subtitle", "time": 7201.51, "timestamp": "02:00:01", "text": "因为我得整理一下我的东西，"}, {"type": "subtitle", "time": 7206.149, "timestamp": "02:00:06", "text": "对吧？我一开始是"}, {"type": "subtitle", "time": 7209.91, "timestamp": "02:00:09", "text": "想搞个24小时不间断的频道，这样在我"}, {"type": "subtitle", "time": 7214.95, "timestamp": "02:00:14", "text": "直播之外的时间，大家就可以"}, {"type": "subtitle", "time": 7228.07, "timestamp": "02:00:28", "text": "但后来我突然意识到，"}, {"type": "subtitle", "time": 7232.31, "timestamp": "02:00:32", "text": "我不可能一直把"}, {"type": "subtitle", "time": 7236.149, "timestamp": "02:00:36", "text": "电脑开着，而且"}, {"type": "subtitle", "time": 7241.669, "timestamp": "02:00:41", "text": "维护起来也挺麻烦的，"}, {"type": "subtitle", "time": 7245.03, "timestamp": "02:00:45", "text": "因为我要从日本远程桌面连接"}, {"type": "subtitle", "time": 7250.87, "timestamp": "02:00:50", "text": "到印度，"}, {"type": "subtitle", "time": 7253.589, "timestamp": "02:00:53", "text": "对吧？这太麻烦了。"}, {"type": "subtitle", "time": 7256.55, "timestamp": "02:00:56", "text": "而且，除了我这个技术达人，我家里没人会"}, {"type": "subtitle", "time": 7259.438, "timestamp": "02:00:59", "text": "用电脑"}]
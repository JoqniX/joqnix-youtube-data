[{"type": "subtitle", "time": 1440.23, "timestamp": "00:24:00", "text": "直播。"}, {"type": "subtitle", "time": 1442.47, "timestamp": "00:24:02", "text": "我的意思是，我很想做一个步行"}, {"type": "chat", "time": 1444.112, "timestamp": "00:24:04", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ya"}, {"type": "subtitle", "time": 1445.83, "timestamp": "00:24:05", "text": "直播，一个只有音频的步行直播，"}, {"type": "subtitle", "time": 1448.549, "timestamp": "00:24:08", "text": "我会在家里的电脑上进行直播，同时"}, {"type": "subtitle", "time": 1452.87, "timestamp": "00:24:12", "text": "我会在户外用"}, {"type": "subtitle", "time": 1456.63, "timestamp": "00:24:16", "text": "手机和大家聊天。 我以前也这样做过。"}, {"type": "subtitle", "time": 1458.31, "timestamp": "00:24:18", "text": "但是[嗤之以鼻]如果我想那样做，"}, {"type": "subtitle", "time": 1461.669, "timestamp": "00:24:21", "text": "就得提前预订服务员。 我得花"}, {"type": "subtitle", "time": 1464.39, "timestamp": "00:24:24", "text": "一定的钱买个"}, {"type": "subtitle", "time": 1467.11, "timestamp": "00:24:27", "text": "服务器之类的东西，"}, {"type": "subtitle", "time": 1470.71, "timestamp": "00:24:30", "text": "这个服务器会传输我手机的"}, {"type": "subtitle", "time": 1473.669, "timestamp": "00:24:33", "text": "音频，当然我也可以传输视频，但是"}, {"type": "subtitle", "time": 1476.71, "timestamp": "00:24:36", "text": "手机的比特率有问题，所以"}, {"type": "chat", "time": 1478.025, "timestamp": "00:24:38", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ohh"}, {"type": "subtitle", "time": 1480.31, "timestamp": "00:24:40", "text": "我可能会用视频音频，这样"}, {"type": "subtitle", "time": 1483.35, "timestamp": "00:24:43", "text": "我手机的音频信号就会传到我"}, {"type": "subtitle", "time": 1488.149, "timestamp": "00:24:48", "text": "家里的电脑上。我以前也这么做过，大概"}, {"type": "subtitle", "time": 1491.19, "timestamp": "00:24:51", "text": "两年前吧"}, {"type": "subtitle", "time": 1493.59, "timestamp": "00:24:53", "text": "。 我以前通常早上"}, {"type": "subtitle", "time": 1496.07, "timestamp": "00:24:56", "text": "六点就起床。我们经常一起"}, {"type": "subtitle", "time": 1498.39, "timestamp": "00:24:58", "text": "晨练和慢跑。"}]
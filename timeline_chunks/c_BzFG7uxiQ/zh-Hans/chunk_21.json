[{"type": "subtitle", "time": 1263.75, "timestamp": "00:21:03", "text": "我最近没做什么事。"}, {"type": "subtitle", "time": 1266.07, "timestamp": "00:21:06", "text": "所以我就想，“是啊，我还要考试"}, {"type": "subtitle", "time": 1268.149, "timestamp": "00:21:08", "text": "什么的，所以我就不费心"}, {"type": "subtitle", "time": 1270.87, "timestamp": "00:21:10", "text": "做这些事了。” 总之，"}, {"type": "subtitle", "time": 1273.83, "timestamp": "00:21:13", "text": "这个月我不会进行太多直播。"}, {"type": "subtitle", "time": 1275.99, "timestamp": "00:21:15", "text": "呃，你在跟谁说话？我正在同时进行"}, {"type": "subtitle", "time": 1278.31, "timestamp": "00:21:18", "text": "多平台直播。"}, {"type": "subtitle", "time": 1280.789, "timestamp": "00:21:20", "text": "其他平台上也有人。"}, {"type": "subtitle", "time": 1283.029, "timestamp": "00:21:23", "text": "即使没人，我也可以……我必须"}, {"type": "subtitle", "time": 1285.909, "timestamp": "00:21:25", "text": "说点什么，对吧？"}, {"type": "subtitle", "time": 1289.43, "timestamp": "00:21:29", "text": "这就是主播的工作内容。"}, {"type": "subtitle", "time": 1294.31, "timestamp": "00:21:34", "text": "准备工作进行得如何？ 是的，准备工作"}, {"type": "subtitle", "time": 1296.47, "timestamp": "00:21:36", "text": "进展顺利。"}, {"type": "subtitle", "time": 1299.51, "timestamp": "00:21:39", "text": "准备工作进展顺利。"}, {"type": "subtitle", "time": 1303.35, "timestamp": "00:21:43", "text": "所以，呃，我得知道"}, {"type": "subtitle", "time": 1307.83, "timestamp": "00:21:47", "text": "今天是几号了？ 星期五，20号。 好的。 我们"}, {"type": "subtitle", "time": 1310.39, "timestamp": "00:21:50", "text": "庆祝美食。 不，我也没有庆祝"}, {"type": "subtitle", "time": 1313.28, "timestamp": "00:21:53", "text": "。"}]
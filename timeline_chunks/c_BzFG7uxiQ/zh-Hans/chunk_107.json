[{"type": "subtitle", "time": 6420.07, "timestamp": "01:47:00", "text": "不过我还是很好奇。 如何对"}, {"type": "subtitle", "time": 6425.99, "timestamp": "01:47:05", "text": "div元素进行倾斜调整？"}, {"type": "subtitle", "time": 6432.229, "timestamp": "01:47:12", "text": "我想做这件事。 我可以吗？（笑）我"}, {"type": "subtitle", "time": 6435.109, "timestamp": "01:47:15", "text": "不想这么做，但也不"}, {"type": "subtitle", "time": 6439.59, "timestamp": "01:47:19", "text": "想让你们觉得无聊。"}, {"type": "subtitle", "time": 6457.669, "timestamp": "01:47:37", "text": "我该怎么办？ 一秒钟。 背景。"}, {"type": "subtitle", "time": 6465.59, "timestamp": "01:47:45", "text": "他们是怎么安排的？ 是否"}, {"type": "subtitle", "time": 6467.109, "timestamp": "01:47:47", "text": "可以？"}, {"type": "subtitle", "time": 6470.55, "timestamp": "01:47:50", "text": "啊，视角。"}, {"type": "subtitle", "time": 6472.95, "timestamp": "01:47:52", "text": "从不同的角度来看，这是有可能的。 等等，"}, {"type": "subtitle", "time": 6476.31, "timestamp": "01:47:56", "text": "这有可能。 那确实有这么回事。"}]
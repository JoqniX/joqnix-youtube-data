[{"type": "subtitle", "time": 2042.31, "timestamp": "00:34:02", "text": "最近，我开始关注一个"}, {"type": "subtitle", "time": 2049.669, "timestamp": "00:34:09", "text": "叫做 Polar SH 的支付处理商"}, {"type": "subtitle", "time": 2052.389, "timestamp": "00:34:12", "text": "。"}, {"type": "subtitle", "time": 2056.79, "timestamp": "00:34:16", "text": "极地SH。 呃，我该怎么说呢"}, {"type": "subtitle", "time": 2058.95, "timestamp": "00:34:18", "text": "？  [嗤之以鼻]"}, {"type": "subtitle", "time": 2062.95, "timestamp": "00:34:22", "text": "如果你知道 Lemon Squeezy"}, {"type": "subtitle", "time": 2065.589, "timestamp": "00:34:25", "text": "这个平台，就"}, {"type": "subtitle", "time": 2067.51, "timestamp": "00:34:27", "text": "可以在上面列出产品，然后"}, {"type": "subtitle", "time": 2069.829, "timestamp": "00:34:29", "text": "人们可以付费购买他们"}, {"type": "subtitle", "time": 2072.79, "timestamp": "00:34:32", "text": "自己的……嗯……"}, {"type": "subtitle", "time": 2078.149, "timestamp": "00:34:38", "text": "东西，对吧？"}, {"type": "subtitle", "time": 2083.349, "timestamp": "00:34:43", "text": "如果我没记错的话，它应该支持 PayPal 和 Stripe。"}, {"type": "subtitle", "time": 2088.869, "timestamp": "00:34:48", "text": "嗯，是的，但我还没有完全……"}, {"type": "subtitle", "time": 2092.31, "timestamp": "00:34:52", "text": "完全设置好。"}, {"type": "subtitle", "time": 2095.829, "timestamp": "00:34:55", "text": "我当时在想，能不能做一个类似"}]
[{"type": "subtitle", "time": 2522.63, "timestamp": "00:42:02", "text": "我们不再需要它了。"}, {"type": "subtitle", "time": 2524.95, "timestamp": "00:42:04", "text": "说实话，你知道，呃，我相信"}, {"type": "subtitle", "time": 2529.75, "timestamp": "00:42:09", "text": "你们当中有人很久以前问过我这个问题，"}, {"type": "subtitle", "time": 2532.71, "timestamp": "00:42:12", "text": "那就是，呃，"}, {"type": "subtitle", "time": 2534.95, "timestamp": "00:42:14", "text": "Doc，你会真的举办"}, {"type": "subtitle", "time": 2537.829, "timestamp": "00:42:17", "text": "一个安息日活动之类的吗？"}, {"type": "subtitle", "time": 2539.91, "timestamp": "00:42:19", "text": "呃，因为上次你尝试做这件事的时候"}, {"type": "subtitle", "time": 2543.384, "timestamp": "00:42:23", "text": "，它突然就结束了。"}, {"type": "subtitle", "time": 2545.43, "timestamp": "00:42:25", "text": "[嗤笑] 呃，你会在"}, {"type": "subtitle", "time": 2548.39, "timestamp": "00:42:28", "text": "离开这个国家之前做完吗？ 然后我"}, {"type": "subtitle", "time": 2550.63, "timestamp": "00:42:30", "text": "就想，算了，我不想经历"}, {"type": "subtitle", "time": 2553.109, "timestamp": "00:42:33", "text": "那种痛苦。 我不想再像以前那样24小时不间断"}, {"type": "subtitle", "time": 2557.43, "timestamp": "00:42:37", "text": "直播，连续直播"}, {"type": "chat", "time": 2561.191, "timestamp": "00:42:41", "author": "@HatoriSheri", "avatar": "https://yt4.ggpht.com/DsfphvbAhwdLk0p1qQ_mF1n7PHAL8sZdkrG3HxN8YzS4UOSkAW5Ji98GoUVN8N9iNHN8DcnI=s64-c-k-c0x00ffffff-no-rj", "message": "Hi Joq!"}, {"type": "subtitle", "time": 2561.349, "timestamp": "00:42:41", "text": "12个小时然后累死，"}, {"type": "chat", "time": 2563.586, "timestamp": "00:42:43", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! HatoriSheri~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 2564.47, "timestamp": "00:42:44", "text": "对吧？ 我做了四个月，一共做了几个月"}, {"type": "subtitle", "time": 2569.349, "timestamp": "00:42:49", "text": "？ 三月、四月、五月、六月、七月、"}, {"type": "subtitle", "time": 2572.204, "timestamp": "00:42:52", "text": "八月。  6个月，对吧？"}, {"type": "subtitle", "time": 2575.67, "timestamp": "00:42:55", "text": "[嗤笑] 去年这个时候我们拼命努力[笑声]"}, {"type": "subtitle", "time": 2579.51, "timestamp": "00:42:59", "text": "。"}]
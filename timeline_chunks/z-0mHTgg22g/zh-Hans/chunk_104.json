[{"type": "subtitle", "time": 6250.87, "timestamp": "01:44:10", "text": "他们投了700。有意思。 好的。 它们之间"}, {"type": "subtitle", "time": 6253.109, "timestamp": "01:44:13", "text": "有字母间距。 他们给"}, {"type": "subtitle", "time": 6255.109, "timestamp": "01:44:15", "text": "字母之间加了间距。 好的。"}, {"type": "subtitle", "time": 6258.229, "timestamp": "01:44:18", "text": "底部有衬垫。 好的。 凌晨 2 点填充。"}, {"type": "subtitle", "time": 6263.03, "timestamp": "01:44:23", "text": "是的，我们可以添加内存。 不用担心。 呃，"}, {"type": "subtitle", "time": 6267.91, "timestamp": "01:44:27", "text": "字体高度。 手机尺寸为 2.5。"}, {"type": "subtitle", "time": 6273.51, "timestamp": "01:44:33", "text": "你们三岁了。 所以，我打算填入 2.5 的"}, {"type": "subtitle", "time": 6275.59, "timestamp": "01:44:35", "text": "面积。"}, {"type": "subtitle", "time": 6277.59, "timestamp": "01:44:37", "text": "好的。"}, {"type": "subtitle", "time": 6294.31, "timestamp": "01:44:54", "text": "边框实线 1 px 外边距为 1 1.2 em。"}, {"type": "subtitle", "time": 6296.229, "timestamp": "01:44:56", "text": "那多少钱？ 哦，那"}]
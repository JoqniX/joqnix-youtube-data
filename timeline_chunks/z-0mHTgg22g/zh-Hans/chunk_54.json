[{"type": "subtitle", "time": 3245.19, "timestamp": "00:54:05", "text": "会员内容在 Patreon 上，所以"}, {"type": "subtitle", "time": 3247.51, "timestamp": "00:54:07", "text": "他们使用 Discord 登录系统，"}, {"type": "subtitle", "time": 3249.75, "timestamp": "00:54:09", "text": "对吧？所以，"}, {"type": "subtitle", "time": 3252.069, "timestamp": "00:54:12", "text": "呃，如果你是 Patreon 会员，你就可以"}, {"type": "subtitle", "time": 3254.47, "timestamp": "00:54:14", "text": "访问，你已经有 Discord"}, {"type": "subtitle", "time": 3257.75, "timestamp": "00:54:17", "text": "账号了，所以他们会检查这一点，"}, {"type": "subtitle", "time": 3262.71, "timestamp": "00:54:22", "text": "以便访问他们的"}, {"type": "subtitle", "time": 3265.349, "timestamp": "00:54:25", "text": "会员专属频道和 Discord"}, {"type": "subtitle", "time": 3267.589, "timestamp": "00:54:27", "text": "等等。 你需要将你的 Patreon"}, {"type": "subtitle", "time": 3269.91, "timestamp": "00:54:29", "text": "账号关联到 Discord 上，对吧？ 很多"}, {"type": "subtitle", "time": 3271.91, "timestamp": "00:54:31", "text": "事情，对吧？ 董事会必须将它连接起来"}, {"type": "subtitle", "time": 3274.23, "timestamp": "00:54:34", "text": "等等。 所以，它就是这样扫描"}, {"type": "subtitle", "time": 3279.349, "timestamp": "00:54:39", "text": "你的 Discord 帐户中的 Patreon 会员资格是否有效的。 只有这样你才能在"}, {"type": "subtitle", "time": 3284.95, "timestamp": "00:54:44", "text": "这里体验到类似beta alpha版本的功能。 他们很聪明。"}, {"type": "subtitle", "time": 3288.39, "timestamp": "00:54:48", "text": "他们做了很多安全措施，以防止"}, {"type": "subtitle", "time": 3293.43, "timestamp": "00:54:53", "text": "人们滥用它。 太好了。"}, {"type": "subtitle", "time": 3295.27, "timestamp": "00:54:55", "text": "而且现在鼠标悬停在上面时，这种发光效果也很不错"}, {"type": "subtitle", "time": 3299.43, "timestamp": "00:54:59", "text": "。"}]
[{"type": "subtitle", "time": 1681.75, "timestamp": "00:28:01", "text": "就是 Twitch 和 Kick 的动态变化机制"}, {"type": "subtitle", "time": 1685.35, "timestamp": "00:28:05", "text": "。 呃，当我在 W 场景、"}, {"type": "subtitle", "time": 1688.23, "timestamp": "00:28:08", "text": "睡觉场景或休息"}, {"type": "subtitle", "time": 1693.59, "timestamp": "00:28:13", "text": "场景时，Twitch 上的“我”类别就会变成“我”只处于"}, {"type": "subtitle", "time": 1696.07, "timestamp": "00:28:16", "text": "睡觉状态。 为了搞笑，"}, {"type": "subtitle", "time": 1699.11, "timestamp": "00:28:19", "text": "它只会说，嗯，它只会"}, {"type": "subtitle", "time": 1701.669, "timestamp": "00:28:21", "text": "更改标题和所有内容。"}, {"type": "subtitle", "time": 1704.71, "timestamp": "00:28:24", "text": "是的，默认情况下它只会取自"}, {"type": "subtitle", "time": 1708.149, "timestamp": "00:28:28", "text": "我的 YouTube 标题。 它目前与 YouTube 的"}, {"type": "subtitle", "time": 1713.11, "timestamp": "00:28:33", "text": "标题“触摸和踢球”类似。 是的。"}, {"type": "subtitle", "time": 1717.83, "timestamp": "00:28:37", "text": "所以我向 Beam 的工作人员申请了"}, {"type": "subtitle", "time": 1721.51, "timestamp": "00:28:41", "text": "他们的聊天 API 和其他相关功能。 遗憾的是，到目前为止我"}, {"type": "subtitle", "time": 1723.909, "timestamp": "00:28:43", "text": "什么也没收到"}, {"type": "subtitle", "time": 1725.75, "timestamp": "00:28:45", "text": "。"}, {"type": "subtitle", "time": 1728.47, "timestamp": "00:28:48", "text": "如果我当时有台带光束的设备，我或许就能"}, {"type": "subtitle", "time": 1730.789, "timestamp": "00:28:50", "text": "做点什么了。 我需要"}, {"type": "subtitle", "time": 1733.59, "timestamp": "00:28:53", "text": "手动更新日期、日期"}, {"type": "subtitle", "time": 1736.63, "timestamp": "00:28:56", "text": "标题之类的东西。 这"}, {"type": "subtitle", "time": 1738.95, "timestamp": "00:28:58", "text": "对Beam来说太糟糕了。 我正在使用 Beam Stream 进行"}]
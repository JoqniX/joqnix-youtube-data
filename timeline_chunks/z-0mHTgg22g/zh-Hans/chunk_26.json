[{"type": "subtitle", "time": 1562.63, "timestamp": "00:26:02", "text": "才能直接向 Billy"}, {"type": "subtitle", "time": 1565.83, "timestamp": "00:26:05", "text": "Billy 请求白名单。 是的"}, {"type": "subtitle", "time": 1568.39, "timestamp": "00:26:08", "text": "，我还在寻找在"}, {"type": "subtitle", "time": 1570.95, "timestamp": "00:26:10", "text": "那里直播的方法。 另外，还有"}, {"type": "subtitle", "time": 1573.269, "timestamp": "00:26:13", "text": "几位 YouTuber 在"}, {"type": "subtitle", "time": 1575.35, "timestamp": "00:26:15", "text": "那里进行直播。 他们中的大多数都会隶属于"}, {"type": "subtitle", "time": 1577.43, "timestamp": "00:26:17", "text": "一个MCN（多频道网络）。   嗯，是的，"}, {"type": "subtitle", "time": 1581.029, "timestamp": "00:26:21", "text": "要么是有合同的，要么像"}, {"type": "subtitle", "time": 1583.35, "timestamp": "00:26:23", "text": "我这样没有合同，只是"}, {"type": "subtitle", "time": 1586.63, "timestamp": "00:26:26", "text": "利用一些资源上线"}, {"type": "subtitle", "time": 1588.71, "timestamp": "00:26:28", "text": "等等。 你走的是自己的路"}, {"type": "subtitle", "time": 1592.149, "timestamp": "00:26:32", "text": "。 是的。 是的。 是的。 我需要"}, {"type": "subtitle", "time": 1595.51, "timestamp": "00:26:35", "text": "找个地方住。 说"}, {"type": "subtitle", "time": 1597.75, "timestamp": "00:26:37", "text": "实话，"}, {"type": "subtitle", "time": 1599.59, "timestamp": "00:26:39", "text": "由于规章制度严格"}, {"type": "subtitle", "time": 1601.51, "timestamp": "00:26:41", "text": "等等原因，外国人很难在那里生存下去。"}, {"type": "subtitle", "time": 1604.63, "timestamp": "00:26:44", "text": "因为我当时在参加 Joathon 活动，所以我不被允许……"}, {"type": "subtitle", "time": 1607.19, "timestamp": "00:26:47", "text": "我以前经常因为"}, {"type": "subtitle", "time": 1611.75, "timestamp": "00:26:51", "text": "我的频道受到很多处罚和警告，"}, {"type": "subtitle", "time": 1614.789, "timestamp": "00:26:54", "text": "因为……你不能挂机超过 10 分钟，"}, {"type": "subtitle", "time": 1618.23, "timestamp": "00:26:58", "text": "也不能在"}]
[{"type": "subtitle", "time": 60.79, "timestamp": "00:01:00", "text": "是新的一天。 今天是"}, {"type": "subtitle", "time": 64.95, "timestamp": "00:01:04", "text": "Jookathon 的第 123 天。 这是一个星期六晚上。"}, {"type": "subtitle", "time": 68.95, "timestamp": "00:01:08", "text": "我本来想在上午或"}, {"type": "subtitle", "time": 72.789, "timestamp": "00:01:12", "text": "晚上过来，但我睡得很沉，因为"}, {"type": "subtitle", "time": 78.23, "timestamp": "00:01:18", "text": "我大概在中午12点左右就睡着了。"}, {"type": "subtitle", "time": 81.27, "timestamp": "00:01:21", "text": "嗯，今天"}, {"type": "subtitle", "time": 84.149, "timestamp": "00:01:24", "text": "某种程度上我熬了一整夜，尽管"}, {"type": "subtitle", "time": 87.35, "timestamp": "00:01:27", "text": "我凌晨四五点就结束了直播"}, {"type": "subtitle", "time": 91.99, "timestamp": "00:01:31", "text": "。"}, {"type": "subtitle", "time": 94.95, "timestamp": "00:01:34", "text": "我醒着。 是"}, {"type": "subtitle", "time": 97.429, "timestamp": "00:01:37", "text": "的，我醒着。 我当时好像在看"}, {"type": "subtitle", "time": 103.83, "timestamp": "00:01:43", "text": "是的，我当时在看一些"}, {"type": "subtitle", "time": 106.63, "timestamp": "00:01:46", "text": "教程之类的东西，然后大概"}, {"type": "chat", "time": 115.542, "timestamp": "00:01:55", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "hewoooo"}, {"type": "subtitle", "time": 118.31, "timestamp": "00:01:58", "text": "九、十点左右就睡着了。之后我又醒了，"}, {"type": "chat", "time": 119.061, "timestamp": "00:01:59", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Thorn— VT~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}]
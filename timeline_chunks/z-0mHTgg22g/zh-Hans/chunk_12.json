[{"type": "subtitle", "time": 721.91, "timestamp": "00:12:01", "text": "里程碑，比如当我达到一定的"}, {"type": "subtitle", "time": 723.75, "timestamp": "00:12:03", "text": "订阅者数量时，或者在"}, {"type": "subtitle", "time": 729.509, "timestamp": "00:12:09", "text": "我接下来几年的"}, {"type": "subtitle", "time": 731.19, "timestamp": "00:12:11", "text": "旅程中我们完成的任何目标和活动，我想把它放在"}, {"type": "subtitle", "time": 734.949, "timestamp": "00:12:14", "text": "网站上。 你好。 今天，"}, {"type": "subtitle", "time": 738.55, "timestamp": "00:12:18", "text": "我们将制作指南页面。 呃，"}, {"type": "subtitle", "time": 741.67, "timestamp": "00:12:21", "text": "我们已经制定了"}, {"type": "subtitle", "time": 745.59, "timestamp": "00:12:25", "text": "向矿工提出请求的指导方针，"}, {"type": "subtitle", "time": 748.23, "timestamp": "00:12:28", "text": "我想我今天可能需要好好研究一下这些"}, {"type": "subtitle", "time": 751.829, "timestamp": "00:12:31", "text": "衍生指导方针。 嗯，"}, {"type": "subtitle", "time": 755.91, "timestamp": "00:12:35", "text": "我们会把那些事情处理好的。 所以"}, {"type": "subtitle", "time": 759.75, "timestamp": "00:12:39", "text": "我今天的计划是，我们会创建一个"}, {"type": "subtitle", "time": 761.91, "timestamp": "00:12:41", "text": "指南页面，其中包含"}, {"type": "subtitle", "time": 765.99, "timestamp": "00:12:45", "text": "不同的部分，包括所有规则，"}, {"type": "subtitle", "time": 769.91, "timestamp": "00:12:49", "text": "例如聊天规则、指南、"}, {"type": "subtitle", "time": 775.509, "timestamp": "00:12:55", "text": "矿工请求等等。另外，我觉得"}, {"type": "subtitle", "time": 778.629, "timestamp": "00:12:58", "text": "一旦网站合并"}]
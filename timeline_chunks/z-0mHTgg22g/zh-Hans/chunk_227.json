[{"type": "subtitle", "time": 13626.74, "timestamp": "03:47:06", "text": "艺术人。 男人是什么？"}, {"type": "subtitle", "time": 13634.469, "timestamp": "03:47:14", "text": "等等，不。 等等，稍等。"}, {"type": "subtitle", "time": 13637.03, "timestamp": "03:47:17", "text": "他们会讨论粉丝自制素材之类的"}, {"type": "subtitle", "time": 13639.91, "timestamp": "03:47:19", "text": "东西吗？"}, {"type": "subtitle", "time": 13648.309, "timestamp": "03:47:28", "text": "呃，粉丝艺术作品"}, {"type": "subtitle", "time": 13660.87, "timestamp": "03:47:40", "text": "设计概念和另类选择，只要"}, {"type": "subtitle", "time": 13669.349, "timestamp": "03:47:49", "text": "[音乐]"}]
[{"type": "subtitle", "time": 9669.11, "timestamp": "02:41:09", "text": "他们很快就会增加电子商务方面的业务。 所以"}, {"type": "subtitle", "time": 9670.55, "timestamp": "02:41:10", "text": "他们打算"}, {"type": "subtitle", "time": 9674.309, "timestamp": "02:41:14", "text": "先尝试使用 Shopify。"}, {"type": "subtitle", "time": 9677.11, "timestamp": "02:41:17", "text": "呃，他们正在打造类似PL的产品，他们的产品"}, {"type": "subtitle", "time": 9680.15, "timestamp": "02:41:20", "text": "允许用户选择他们"}, {"type": "subtitle", "time": 9685.83, "timestamp": "02:41:25", "text": "喜欢的任何电子商务平台来连接到Web Studio之类的"}, {"type": "subtitle", "time": 9688.71, "timestamp": "02:41:28", "text": "东西。 所以这意味着，如果我有一个 Shopify"}, {"type": "subtitle", "time": 9691.51, "timestamp": "02:41:31", "text": "商店，一旦他们整合了 Shopify 的"}, {"type": "subtitle", "time": 9693.83, "timestamp": "02:41:33", "text": "功能，我就可以把它和 Shopify 连接起来"}, {"type": "subtitle", "time": 9696.15, "timestamp": "02:41:36", "text": "。 如果我使用其他类型的"}, {"type": "subtitle", "time": 9699.03, "timestamp": "02:41:39", "text": "商店，例如 Wix 或"}, {"type": "subtitle", "time": 9701.59, "timestamp": "02:41:41", "text": "其他非 Wix 的商店，比如"}, {"type": "subtitle", "time": 9704.07, "timestamp": "02:41:44", "text": "除了 Shopify 之外我不知道的其他商店，"}, {"type": "subtitle", "time": 9706.309, "timestamp": "02:41:46", "text": "但是，如果我有不同"}, {"type": "subtitle", "time": 9709.59, "timestamp": "02:41:49", "text": "类型的电子商务 API，我现在可以把"}, {"type": "subtitle", "time": 9713.03, "timestamp": "02:41:53", "text": "它添加到这里。 我可以在网页工作室里添加它"}, {"type": "subtitle", "time": 9716.389, "timestamp": "02:41:56", "text": "。 所以，是的，他们"}, {"type": "subtitle", "time": 9719.51, "timestamp": "02:41:59", "text": "也有一个内容管理系统之类的东西。 它们允许您"}]
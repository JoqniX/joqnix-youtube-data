[{"type": "subtitle", "time": 5350.87, "timestamp": "01:29:10", "text": "是的，在我们进入广播工作"}, {"type": "subtitle", "time": 5354.47, "timestamp": "01:29:14", "text": "部分之前，让我们先把我们已经收到的请求复制粘贴给"}, {"type": "subtitle", "time": 5357.669, "timestamp": "01:29:17", "text": "矿工们。   是的"}, {"type": "subtitle", "time": 5360.87, "timestamp": "01:29:20", "text": "，那将是第二部分。 我"}, {"type": "subtitle", "time": 5369.03, "timestamp": "01:29:29", "text": "对吧？ 我来拟个草稿。 但"}, {"type": "subtitle", "time": 5370.79, "timestamp": "01:29:30", "text": "问题是，"}, {"type": "subtitle", "time": 5375.75, "timestamp": "01:29:35", "text": "我没有为这些"}, {"type": "subtitle", "time": 5377.51, "timestamp": "01:29:37", "text": "标题填写任何内容。"}, {"type": "subtitle", "time": 5394.629, "timestamp": "01:29:54", "text": "页面主部分容器。"}, {"type": "subtitle", "time": 5398.07, "timestamp": "01:29:58", "text": "它会被放进这个"}]
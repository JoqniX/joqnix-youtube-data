[{"type": "subtitle", "time": 1022.069, "timestamp": "00:17:02", "text": "我寫這樣的指令，"}, {"type": "chat", "time": 1026.607, "timestamp": "00:17:06", "author": "@Lemmings_0", "avatar": "https://yt4.ggpht.com/MIeTwieZjegymaDIizsQ-fHaDloP6S4c_1OEYkYH-TxFDcvN-y3DI2XEu0eHqh_0Il1gLRD90Xw=s64-c-k-c0x00ffffff-no-rj", "message": "ohh software interesting"}, {"type": "subtitle", "time": 1026.87, "timestamp": "00:17:06", "text": "但我還是希望有一天"}, {"type": "subtitle", "time": 1031.27, "timestamp": "00:17:11", "text": "我能懂 C# 或 C++，我想用"}, {"type": "subtitle", "time": 1033.429, "timestamp": "00:17:13", "text": "Streamerbot，"}, {"type": "subtitle", "time": 1039.829, "timestamp": "00:17:19", "text": "現在很多人都在用 Streamerboard。但現在唯一的問題是，"}, {"type": "subtitle", "time": 1043.27, "timestamp": "00:17:23", "text": "我設定了很多東西，例如"}, {"type": "subtitle", "time": 1046.47, "timestamp": "00:17:26", "text": "YouTube 上的聊天板，以及"}, {"type": "subtitle", "time": 1048.63, "timestamp": "00:17:28", "text": "當新用戶"}, {"type": "subtitle", "time": 1051.11, "timestamp": "00:17:31", "text": "第一次打字時會歡迎他們的留言板。現在這個"}, {"type": "subtitle", "time": 1054.63, "timestamp": "00:17:34", "text": "是由這個人運營的，因為 Sammy"}, {"type": "subtitle", "time": 1058.47, "timestamp": "00:17:38", "text": "沒有辦法讓你添加"}, {"type": "subtitle", "time": 1062.15, "timestamp": "00:17:42", "text": "額外的 YouTube 帳戶作為"}, {"type": "subtitle", "time": 1065.11, "timestamp": "00:17:45", "text": "b。他們那裡有個功能可以添加多個"}, {"type": "subtitle", "time": 1067.99, "timestamp": "00:17:47", "text": "帳號，但是它不允許我"}, {"type": "subtitle", "time": 1070.23, "timestamp": "00:17:50", "text": "用不同的帳號聊天，"}, {"type": "subtitle", "time": 1073.11, "timestamp": "00:17:53", "text": "這很麻煩，否則我就會"}, {"type": "subtitle", "time": 1076.87, "timestamp": "00:17:56", "text": "用它來代替我的機器人了。所以"}, {"type": "subtitle", "time": 1079.909, "timestamp": "00:17:59", "text": "我現在用的是主播機器人，唯一的問題"}]
[{"type": "subtitle", "time": 1201.43, "timestamp": "00:20:01", "text": "KitTech Webhook 之類的東西。  他們"}, {"type": "subtitle", "time": 1204.87, "timestamp": "00:20:04", "text": "還有甲板之類的東西。這是"}, {"type": "subtitle", "time": 1206.39, "timestamp": "00:20:06", "text": "新情況。"}, {"type": "subtitle", "time": 1209.59, "timestamp": "00:20:09", "text": "他們正在運行一個 2.0 版本的東西。這"}, {"type": "subtitle", "time": 1211.59, "timestamp": "00:20:11", "text": "意味著你可以給你的"}, {"type": "subtitle", "time": 1216.23, "timestamp": "00:20:16", "text": "版主或任何人一個網站"}, {"type": "subtitle", "time": 1220.23, "timestamp": "00:20:20", "text": "連結。他們可以走到你的小玩意兒前，然後"}, {"type": "subtitle", "time": 1222.549, "timestamp": "00:20:22", "text": "按下一個按鈕。它會在"}, {"type": "subtitle", "time": 1233.19, "timestamp": "00:20:33", "text": "你的直播串流和其他所有裝置上啟動。您可以像設定按鈕一樣在這裡進行設定。這"}, {"type": "subtitle", "time": 1236.789, "timestamp": "00:20:36", "text": "就像一個友善的網站。我現在用這個是因為我用的是Sammy"}, {"type": "subtitle", "time": 1244.07, "timestamp": "00:20:44", "text": "。這意味著我必須在我的電腦或手機上運行它。這也意味著我必須先運行這些主要程式才能使用它。但這裡"}, {"type": "subtitle", "time": 1246.71, "timestamp": "00:20:46", "text": "也需要運行一個串流板"}, {"type": "subtitle", "time": 1249.11, "timestamp": "00:20:49", "text": "。如你所見，它與"}, {"type": "subtitle", "time": 1252.23, "timestamp": "00:20:52", "text": "Twitch、Twitchbot、YouTube"}, {"type": "subtitle", "time": 1255.909, "timestamp": "00:20:55", "text": "bot、OBS 以及所有這些工具都連接在一起。是的。"}]
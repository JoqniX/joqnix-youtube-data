[{"type": "subtitle", "time": 841.75, "timestamp": "00:14:01", "text": "今天就問，明天是星期天，所以我不知道會不會"}, {"type": "subtitle", "time": 843.67, "timestamp": "00:14:03", "text": "關門。所以星期一我會"}, {"type": "subtitle", "time": 847.75, "timestamp": "00:14:07", "text": "去問大家，我理解的對不對，事情是怎麼回事，我"}, {"type": "subtitle", "time": 850.629, "timestamp": "00:14:10", "text": "需要辦理哪些手續"}, {"type": "subtitle", "time": 853.43, "timestamp": "00:14:13", "text": "。然後我就開始著手做"}, {"type": "subtitle", "time": 856.87, "timestamp": "00:14:16", "text": "週邊產品網站那件事。呃，最好能先做好"}, {"type": "subtitle", "time": 861.829, "timestamp": "00:14:21", "text": "線框圖或基礎模板。  是的。是的。是的。  你好"}, {"type": "subtitle", "time": 866.71, "timestamp": "00:14:26", "text": "。呃，讓我來修復一下"}, {"type": "subtitle", "time": 871.43, "timestamp": "00:14:31", "text": "自動化系統。呃，我注意到，"}, {"type": "subtitle", "time": 874.71, "timestamp": "00:14:34", "text": "每當我在 YouTube 上直播時，它都"}, {"type": "subtitle", "time": 876.71, "timestamp": "00:14:36", "text": "檢測不到直播"}, {"type": "subtitle", "time": 880.71, "timestamp": "00:14:40", "text": "標題，而且當我不在 VOD 中繼模式下時，它也"}, {"type": "subtitle", "time": 883.829, "timestamp": "00:14:43", "text": "不會根據我的 OBS 場景更新 Twitch 並踢出我"}, {"type": "subtitle", "time": 888.949, "timestamp": "00:14:48", "text": "。"}, {"type": "subtitle", "time": 891.269, "timestamp": "00:14:51", "text": "對於那些一直關注我的人和"}, {"type": "subtitle", "time": 894.31, "timestamp": "00:14:54", "text": "新來的人，我們開始"}, {"type": "subtitle", "time": 896.389, "timestamp": "00:14:56", "text": "改變 Joathon"}, {"type": "subtitle", "time": 899.829, "timestamp": "00:14:59", "text": "直播的形式，所以我停止在 YouTube 上進行 24 小時"}]
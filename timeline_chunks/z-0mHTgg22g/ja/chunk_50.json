[{"type": "subtitle", "time": 3000.87, "timestamp": "00:50:00", "text": "TTS（テキスト読み上げ）のような音声処理のやり方です。"}, {"type": "subtitle", "time": 3005.03, "timestamp": "00:50:05", "text": "ええ、スーパー"}, {"type": "subtitle", "time": 3008.069, "timestamp": "00:50:08", "text": "チャットのメッセージなどをカスタマイズできますよ。 誰かが"}, {"type": "subtitle", "time": 3013.349, "timestamp": "00:50:13", "text": "スーパーチャットをすると、このように"}, {"type": "subtitle", "time": 3016.549, "timestamp": "00:50:16", "text": "画像やその他すべてのものを変更できるようになります"}, {"type": "subtitle", "time": 3023.67, "timestamp": "00:50:23", "text": "ストリーム要素も同様の設定になっています。"}, {"type": "subtitle", "time": 3025.91, "timestamp": "00:50:25", "text": "アラートなどの設定画面を見てください。"}, {"type": "subtitle", "time": 3028.95, "timestamp": "00:50:28", "text": "このテキサスのページのように設定して、"}, {"type": "subtitle", "time": 3040.79, "timestamp": "00:50:40", "text": "サミーとかのことを考えているなら、"}, {"type": "subtitle", "time": 3049.27, "timestamp": "00:50:49", "text": "このストリームの拡張機能について調べる必要があると思います。"}, {"type": "subtitle", "time": 3052.549, "timestamp": "00:50:52", "text": "ここからならすぐにできると思います。"}, {"type": "subtitle", "time": 3055.03, "timestamp": "00:50:55", "text": "えっと、"}, {"type": "subtitle", "time": 3058.63, "timestamp": "00:50:58", "text": "私はSpeakerbotを持っていないと思います。"}]
[{"type": "subtitle", "time": 4325.75, "timestamp": "01:12:05", "text": "CSSをチェックしています。   ええと、私は何も"}, {"type": "subtitle", "time": 4342.07, "timestamp": "01:12:22", "text": "彼らは何について話しているんですか？"}, {"type": "subtitle", "time": 4343.99, "timestamp": "01:12:23", "text": "ああ、彼らはスレッドを立てるだろう。 そこが"}, {"type": "subtitle", "time": 4347.27, "timestamp": "01:12:27", "text": "問題なんです。 例えば、私がチャットチャットに書き込んだら"}, {"type": "subtitle", "time": 4349.51, "timestamp": "01:12:29", "text": "、彼らはスレッドを作るでしょう。 もしくは、"}, {"type": "subtitle", "time": 4353.35, "timestamp": "01:12:33", "text": "ここで質問することもできます。"}, {"type": "subtitle", "time": 4361.27, "timestamp": "01:12:41", "text": "待って、あの音は何？ ちょっと待ってください"}]
[{"type": "subtitle", "time": 8833.75, "timestamp": "02:27:13", "text": "大量の投稿をする場合、このスケジュールやフォーマットの方が優れていることがわかります。"}, {"type": "subtitle", "time": 8836.07, "timestamp": "02:27:16", "text": "彼女は誰よりも上手く嘘をつくだろう。"}, {"type": "subtitle", "time": 8838.389, "timestamp": "02:27:18", "text": "私が何を言おうとしているのか、あなたにはわかるでしょう。"}, {"type": "subtitle", "time": 8841.11, "timestamp": "02:27:21", "text": "え、何？ どれ？ どれ？"}, {"type": "subtitle", "time": 8844.07, "timestamp": "02:27:24", "text": "スケジュールやフォーマットがより良いのは、投稿したときに何が"}, {"type": "chat", "time": 8849.648, "timestamp": "02:27:29", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "previous one"}, {"type": "subtitle", "time": 8850.15, "timestamp": "02:27:30", "text": "許可されているかということですか？"}, {"type": "subtitle", "time": 8862.07, "timestamp": "02:27:42", "text": "どれのことですか？これですか？"}, {"type": "subtitle", "time": 8869.03, "timestamp": "02:27:49", "text": "つまり、"}, {"type": "subtitle", "time": 8873.349, "timestamp": "02:27:53", "text": "週ごとのスケジュールということですか？ これです？"}, {"type": "subtitle", "time": 8876.309, "timestamp": "02:27:56", "text": "これですか？"}, {"type": "chat", "time": 8879.778, "timestamp": "02:27:59", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "yea"}]
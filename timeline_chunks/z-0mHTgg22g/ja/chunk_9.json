[{"type": "subtitle", "time": 540.389, "timestamp": "00:09:00", "text": "正しければ、それはどちらかというとゴラソンに近いものですね。 うん。 うん。 うん。"}, {"type": "subtitle", "time": 543.19, "timestamp": "00:09:03", "text": "うん。 つまり、TLDIA（TLDIA：長々と説明すると）新しい"}, {"type": "subtitle", "time": 546.71, "timestamp": "00:09:06", "text": "モデルを開発中なんです。 えっと、作品は完成しました。"}, {"type": "subtitle", "time": 549.43, "timestamp": "00:09:09", "text": "索具代がちょっと高いし、私は"}, {"type": "chat", "time": 553.657, "timestamp": "00:09:13", "author": "@Lemmings_0", "avatar": "https://yt4.ggpht.com/MIeTwieZjegymaDIizsQ-fHaDloP6S4c_1OEYkYH-TxFDcvN-y3DI2XEu0eHqh_0Il1gLRD90Xw=s64-c-k-c0x00ffffff-no-rj", "message": "ohh"}, {"type": "subtitle", "time": 553.99, "timestamp": "00:09:13", "text": "金欠なんです。 えっと、クラウド"}, {"type": "subtitle", "time": 556.87, "timestamp": "00:09:16", "text": "ファンディングみたいな形で資金を集めたかったんですが、資金"}, {"type": "subtitle", "time": 565.35, "timestamp": "00:09:25", "text": "集めというよりは、"}, {"type": "subtitle", "time": 571.269, "timestamp": "00:09:31", "text": "日本に行く前にやりたいことを実現するための方法だと考えています。"}, {"type": "subtitle", "time": 573.509, "timestamp": "00:09:33", "text": "当初は"}, {"type": "subtitle", "time": 577.91, "timestamp": "00:09:37", "text": "今月、"}, {"type": "subtitle", "time": 580.949, "timestamp": "00:09:40", "text": "7月1日頃に日本へ出発する予定だったんです。 本当はそこにいるはずだったんだけど、"}, {"type": "subtitle", "time": 586.87, "timestamp": "00:09:46", "text": "インドで起きた政治的な戦争のせいで、"}, {"type": "subtitle", "time": 590.87, "timestamp": "00:09:50", "text": "日本への留学がキャンセルになって、"}, {"type": "subtitle", "time": 594.47, "timestamp": "00:09:54", "text": "来年に延期になったんだ。 えっと、私は"}, {"type": "subtitle", "time": 596.23, "timestamp": "00:09:56", "text": "語学コースのために日本に行く予定です"}, {"type": "subtitle", "time": 598.949, "timestamp": "00:09:58", "text": "。 それで、アカデミーの人たちは、"}]
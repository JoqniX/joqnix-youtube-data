[{"type": "subtitle", "time": 6001.83, "timestamp": "01:40:01", "text": "【音楽】"}, {"type": "subtitle", "time": 6005.91, "timestamp": "01:40:05", "text": "よし、イントロをやらなきゃ。"}, {"type": "subtitle", "time": 6009.99, "timestamp": "01:40:09", "text": "彼らには太字のようなものはありません。 彼らです。"}, {"type": "subtitle", "time": 6022.31, "timestamp": "01:40:22", "text": "F 500 の電話は何ですか? 重さは500です。"}, {"type": "subtitle", "time": 6026.39, "timestamp": "01:40:26", "text": "私の携帯電話は何ですか？ これは700です。ですから、こうでなければなりません"}, {"type": "subtitle", "time": 6029.75, "timestamp": "01:40:29", "text": "。   自己"}, {"type": "subtitle", "time": 6055.35, "timestamp": "01:40:55", "text": "つまり、電話の場合も同様ということです"}, {"type": "subtitle", "time": 6058.31, "timestamp": "01:40:58", "text": "。 待って。 あ、待って。"}]
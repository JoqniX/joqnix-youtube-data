[{"type": "subtitle", "time": 3062.79, "timestamp": "00:51:02", "text": "ダウンロードする必要があるかもしれない。"}, {"type": "subtitle", "time": 3070.069, "timestamp": "00:51:10", "text": "待って、待って。 ストリーマーボットのウェブ"}, {"type": "subtitle", "time": 3072.549, "timestamp": "00:51:12", "text": "サイトに載ってるよね？ 配信者"}, {"type": "subtitle", "time": 3074.39, "timestamp": "00:51:14", "text": "ボットのウェブサイトに掲載されます。"}, {"type": "subtitle", "time": 3077.67, "timestamp": "00:51:17", "text": "簡単です。 やるべきことはそれほど多くない"}, {"type": "chat", "time": 3081.136, "timestamp": "00:51:21", "author": "@Lemmings_0", "avatar": "https://yt4.ggpht.com/MIeTwieZjegymaDIizsQ-fHaDloP6S4c_1OEYkYH-TxFDcvN-y3DI2XEu0eHqh_0Il1gLRD90Xw=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/egJ1XufTKYfegwOo57ewAgUCkszU2WH9gy1mb0dV-11UJg/egJ1XufTKYfegwOo57ewAg"}, {"type": "subtitle", "time": 3082.95, "timestamp": "00:51:22", "text": "。 ええ、そうですね。 スピーカーボットが安定しました。"}, {"type": "subtitle", "time": 3086.23, "timestamp": "00:51:26", "text": "これはインストールしたままにしておいた方がいいと思う。"}, {"type": "subtitle", "time": 3091.24, "timestamp": "00:51:31", "text": "2週間前に公開された今後のリリース情報。 ああ、"}, {"type": "subtitle", "time": 3099.829, "timestamp": "00:51:39", "text": "ワシントン2.0"}, {"type": "subtitle", "time": 3104.15, "timestamp": "00:51:44", "text": "現在のテストのチェックにサインしてください。"}, {"type": "subtitle", "time": 3107.03, "timestamp": "00:51:47", "text": "彼らはあの車の件をやります。"}, {"type": "subtitle", "time": 3109.99, "timestamp": "00:51:49", "text": "ご存知のように、"}, {"type": "subtitle", "time": 3112.549, "timestamp": "00:51:52", "text": "Streamer Bot に似たソフトウェアがありました。Beu Bot と呼ばれていました。Bika"}, {"type": "subtitle", "time": 3119.43, "timestamp": "00:51:59", "text": "から提供された Beu Bot というソフトウェアです。"}]
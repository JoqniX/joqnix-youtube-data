[{"type": "subtitle", "time": 1681.75, "timestamp": "00:28:01", "text": "TwitchとKickの動的な変化に関するものだと思います"}, {"type": "subtitle", "time": 1685.35, "timestamp": "00:28:05", "text": "。 えっと、私がWシーンにいるとき、"}, {"type": "subtitle", "time": 1688.23, "timestamp": "00:28:08", "text": "私が睡眠シーンや休憩"}, {"type": "subtitle", "time": 1693.59, "timestamp": "00:28:13", "text": "シーンにいるとき、Twitchでは私が睡眠のみのカテゴリに変わります"}, {"type": "subtitle", "time": 1696.07, "timestamp": "00:28:16", "text": "。 例えば、"}, {"type": "subtitle", "time": 1701.669, "timestamp": "00:28:21", "text": "タイトルなどを変更するだけだと表示されるでしょう。"}, {"type": "subtitle", "time": 1704.71, "timestamp": "00:28:24", "text": "はい、デフォルトではYouTubeのタイトルからしか取得されません"}, {"type": "subtitle", "time": 1708.149, "timestamp": "00:28:28", "text": "。 これはYouTubeの"}, {"type": "subtitle", "time": 1713.11, "timestamp": "00:28:33", "text": "タイトル「触って蹴って」を反映している。 うん。"}, {"type": "subtitle", "time": 1717.83, "timestamp": "00:28:37", "text": "そこで、Beamの人たちに"}, {"type": "subtitle", "time": 1721.51, "timestamp": "00:28:41", "text": "チャットAPIなどを提供してくれるよう依頼しました。"}, {"type": "subtitle", "time": 1725.75, "timestamp": "00:28:45", "text": "残念ながら、今のところ何も得られていません。"}, {"type": "subtitle", "time": 1728.47, "timestamp": "00:28:48", "text": "もしビームに関する何かを持っていたら、"}, {"type": "subtitle", "time": 1730.789, "timestamp": "00:28:50", "text": "ここで何かできたかもしれない。"}, {"type": "subtitle", "time": 1733.59, "timestamp": "00:28:53", "text": "日付や日付のタイトルなどを手動で更新する必要があります"}, {"type": "subtitle", "time": 1736.63, "timestamp": "00:28:56", "text": "。"}, {"type": "subtitle", "time": 1738.95, "timestamp": "00:28:58", "text": "ビームにとっては残念なことだ。 私はBeam Streamを使って"}]
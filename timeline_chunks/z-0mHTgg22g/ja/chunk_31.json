[{"type": "subtitle", "time": 1863.59, "timestamp": "00:31:03", "text": "えっと、これは何ですか？"}, {"type": "subtitle", "time": 1875.83, "timestamp": "00:31:15", "text": "1.0では、バックエンドでの実装に費用がかかるような、いくつかの新しい高度な機能が導入されるでしょう"}, {"type": "subtitle", "time": 1881.669, "timestamp": "00:31:21", "text": "。 わかった。 は、"}, {"type": "chat", "time": 1883.68, "timestamp": "00:31:23", "author": "@Lemmings_0", "avatar": "https://yt4.ggpht.com/MIeTwieZjegymaDIizsQ-fHaDloP6S4c_1OEYkYH-TxFDcvN-y3DI2XEu0eHqh_0Il1gLRD90Xw=s64-c-k-c0x00ffffff-no-rj", "message": "cya"}, {"type": "subtitle", "time": 1884.07, "timestamp": "00:31:24", "text": "数十人の開発者が取り組んでいるスタートアップ企業です。は、"}, {"type": "subtitle", "time": 1890.149, "timestamp": "00:31:30", "text": "カナダのオリアーノにある登録企業です。プログラミングと"}, {"type": "subtitle", "time": 1893.99, "timestamp": "00:31:33", "text": "開発の分野で、確かに"}, {"type": "subtitle", "time": 1900.23, "timestamp": "00:31:40", "text": "貢献があります。ええと、こんにちは。お元気で。お越しいただき"}, {"type": "subtitle", "time": 1903.509, "timestamp": "00:31:43", "text": "ありがとうございました。"}, {"type": "subtitle", "time": 1907.11, "timestamp": "00:31:47", "text": "良い一日または夜をお過ごしください。ええと、"}, {"type": "subtitle", "time": 1916.07, "timestamp": "00:31:56", "text": "証明書の署名に関連する手数料があります。"}]
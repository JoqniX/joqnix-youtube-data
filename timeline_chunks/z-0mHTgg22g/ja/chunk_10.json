[{"type": "subtitle", "time": 604.47, "timestamp": "00:10:04", "text": "学校側が来年"}, {"type": "subtitle", "time": 610.23, "timestamp": "00:10:10", "text": "インドからの学生を受け入れる用意があると言っていました。"}, {"type": "subtitle", "time": 619.43, "timestamp": "00:10:19", "text": "政治的な混乱のため、日本への年間入学枠を丸ごとキャンセルしたんです。 ええ、そうですね。 だから、たぶんあと"}, {"type": "chat", "time": 622.334, "timestamp": "00:10:22", "author": "@Lemmings_0", "avatar": "https://yt4.ggpht.com/MIeTwieZjegymaDIizsQ-fHaDloP6S4c_1OEYkYH-TxFDcvN-y3DI2XEu0eHqh_0Il1gLRD90Xw=s64-c-k-c0x00ffffff-no-rj", "message": "you are indian?"}, {"type": "subtitle", "time": 624.15, "timestamp": "00:10:24", "text": "9ヶ月くらいここにいると"}, {"type": "subtitle", "time": 627.11, "timestamp": "00:10:27", "text": "思う。 うん。 私は"}, {"type": "subtitle", "time": 630.31, "timestamp": "00:10:30", "text": "3月12日にジョックマラソンイベントを開始しました。 私は"}, {"type": "subtitle", "time": 633.11, "timestamp": "00:10:33", "text": "3月12日にジョックマラソンイベントを開始しました。 だから、"}, {"type": "subtitle", "time": 635.829, "timestamp": "00:10:35", "text": "3月12日か、"}, {"type": "subtitle", "time": 641.03, "timestamp": "00:10:41", "text": "もしくは3月22日くらいで終わらせようと思ってるんだ。"}, {"type": "subtitle", "time": 647.11, "timestamp": "00:10:47", "text": "4月入学で日本に留学する予定だからね。 つまり、"}, {"type": "subtitle", "time": 651.19, "timestamp": "00:10:51", "text": "4月1日までに"}, {"type": "subtitle", "time": 654.069, "timestamp": "00:10:54", "text": "日本に行かなければならず、授業は翌日から始まる、といった感じですね"}, {"type": "subtitle", "time": 656.71, "timestamp": "00:10:56", "text": "。 うん。"}, {"type": "subtitle", "time": 658.389, "timestamp": "00:10:58", "text": "あなたはインド人ですね。 はい。 私はインド人の"}]
[{"type": "subtitle", "time": 841.75, "timestamp": "00:14:01", "text": "今日は聞いてみますが、明日は日曜日なので"}, {"type": "subtitle", "time": 843.67, "timestamp": "00:14:03", "text": "閉まっていると思います。 だから月曜日に、"}, {"type": "subtitle", "time": 847.75, "timestamp": "00:14:07", "text": "状況がどうなっているのか、そして私に必要な手続きは何か、私の理解が正しいかどうかを関係者に尋ねてみるつもりです"}, {"type": "subtitle", "time": 853.43, "timestamp": "00:14:13", "text": "。 それから、グッズ販売ウェブサイトの制作に取り掛かります"}, {"type": "subtitle", "time": 856.87, "timestamp": "00:14:16", "text": "。 えっと、"}, {"type": "subtitle", "time": 861.829, "timestamp": "00:14:21", "text": "ワイヤーフレームとかベーステンプレートみたいなものを作っておくんです。"}, {"type": "subtitle", "time": 863.829, "timestamp": "00:14:23", "text": "うん。 うん。 うん。"}, {"type": "subtitle", "time": 866.71, "timestamp": "00:14:26", "text": "こんにちは。 では、えーと、"}, {"type": "subtitle", "time": 871.43, "timestamp": "00:14:31", "text": "自動化を修正させてください。 えっと、"}, {"type": "subtitle", "time": 874.71, "timestamp": "00:14:34", "text": "YouTubeでライブ配信しているときに、ストリームの"}, {"type": "subtitle", "time": 880.71, "timestamp": "00:14:40", "text": "タイトルが検出されず、VODリレー機能を使用していないときに"}, {"type": "subtitle", "time": 887.03, "timestamp": "00:14:47", "text": "OBSシーンに基づいてTwitchが更新されず、キックされないことに気づきました"}, {"type": "subtitle", "time": 888.949, "timestamp": "00:14:48", "text": "。"}, {"type": "subtitle", "time": 891.269, "timestamp": "00:14:51", "text": "えーと、これまで私を見てくれていた方々と、"}, {"type": "subtitle", "time": 894.31, "timestamp": "00:14:54", "text": "ここに来たばかりの方々のために、"}, {"type": "subtitle", "time": 896.389, "timestamp": "00:14:56", "text": "Joathon ストリームでフォーマットを変更し始めた"}, {"type": "subtitle", "time": 899.829, "timestamp": "00:14:59", "text": "ので、"}]
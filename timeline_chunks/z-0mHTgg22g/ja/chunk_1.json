[{"type": "subtitle", "time": 60.79, "timestamp": "00:01:00", "text": "今日は新しい日だ。 今日は"}, {"type": "subtitle", "time": 64.95, "timestamp": "00:01:04", "text": "Jookathonの123日目です。 土曜日の夜だ。"}, {"type": "subtitle", "time": 68.95, "timestamp": "00:01:08", "text": "朝晩に伺いたかったのですが、"}, {"type": "subtitle", "time": 78.23, "timestamp": "00:01:18", "text": "12時頃に寝てしまったので、ぐっすり眠っていました。"}, {"type": "subtitle", "time": 81.27, "timestamp": "00:01:21", "text": "えっと、今日はある意味、"}, {"type": "subtitle", "time": 91.99, "timestamp": "00:01:31", "text": "朝の午前4時か5時に配信を終えたにもかかわらず、一晩中起きていました。"}, {"type": "subtitle", "time": 94.95, "timestamp": "00:01:34", "text": "私は起きていた。"}, {"type": "subtitle", "time": 97.429, "timestamp": "00:01:37", "text": "ええ、起きていました。"}, {"type": "subtitle", "time": 103.83, "timestamp": "00:01:43", "text": "ええ、チュートリアル動画とかを見てたんですが、そのまま寝ちゃって、たぶん"}, {"type": "chat", "time": 115.542, "timestamp": "00:01:55", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "hewoooo"}, {"type": "subtitle", "time": 118.31, "timestamp": "00:01:58", "text": "9時か10時くらいに寝ちゃったんです。それからまた起きて、"}, {"type": "chat", "time": 119.061, "timestamp": "00:01:59", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Thorn— VT~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}]
[{"type": "subtitle", "time": 2462.55, "timestamp": "00:41:02", "text": "ああ、彼らは持っているんですね。"}, {"type": "subtitle", "time": 2465.589, "timestamp": "00:41:05", "text": "これは全指揮官用のExcelシートですか"}, {"type": "subtitle", "time": 2467.829, "timestamp": "00:41:07", "text": "？"}, {"type": "subtitle", "time": 2470.87, "timestamp": "00:41:10", "text": "何？ ビリー・ビリーもだ。"}, {"type": "subtitle", "time": 2474.15, "timestamp": "00:41:14", "text": "待って、これは実際には良いことだ。"}, {"type": "subtitle", "time": 2476.79, "timestamp": "00:41:16", "text": "ビリー・ビリーが見えない。"}, {"type": "subtitle", "time": 2484.95, "timestamp": "00:41:24", "text": "ああ、それは本当にいいですね。"}, {"type": "subtitle", "time": 2487.829, "timestamp": "00:41:27", "text": "あらゆる民族がここに集まっている。"}, {"type": "subtitle", "time": 2490.63, "timestamp": "00:41:30", "text": "ああ、これはなかなか良いですね。"}, {"type": "subtitle", "time": 2493.43, "timestamp": "00:41:33", "text": "私はこのデータを失うわけにはいかない。 この"}, {"type": "subtitle", "time": 2496.309, "timestamp": "00:41:36", "text": "データ"}, {"type": "subtitle", "time": 2499.28, "timestamp": "00:41:39", "text": "プラグインが必要です。 だから"}]
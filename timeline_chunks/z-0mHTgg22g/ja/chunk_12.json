[{"type": "subtitle", "time": 723.75, "timestamp": "00:12:03", "text": "購読者数が一定数に達したときや、"}, {"type": "subtitle", "time": 729.509, "timestamp": "00:12:09", "text": "今後数年間の私の"}, {"type": "subtitle", "time": 731.19, "timestamp": "00:12:11", "text": "旅の中で達成した目標や活動など、他のマイルストーンを追加できるようになります。それをウェブ"}, {"type": "subtitle", "time": 734.949, "timestamp": "00:12:14", "text": "サイトに掲載しようと思いました。 こんにちは。 それでは、今日は"}, {"type": "subtitle", "time": 738.55, "timestamp": "00:12:18", "text": "ガイドラインのページを作成します。 ええと、"}, {"type": "subtitle", "time": 745.59, "timestamp": "00:12:25", "text": "マイナーへのリクエストに関するガイドラインは既に作成済みで、"}, {"type": "subtitle", "time": 751.829, "timestamp": "00:12:31", "text": "今日はその派生ガイドラインをきちんと作成する必要があるかもしれません。 ええ、"}, {"type": "subtitle", "time": 755.91, "timestamp": "00:12:35", "text": "その件は解決しましょう。"}, {"type": "subtitle", "time": 759.75, "timestamp": "00:12:39", "text": "今日の私の計画は、"}, {"type": "subtitle", "time": 761.91, "timestamp": "00:12:41", "text": "ガイドラインページを1つ作成し、そこに"}, {"type": "subtitle", "time": 765.99, "timestamp": "00:12:45", "text": "さまざまなセクションを設けます。"}, {"type": "subtitle", "time": 769.91, "timestamp": "00:12:49", "text": "チャットルール、ガイドライン、"}, {"type": "subtitle", "time": 775.509, "timestamp": "00:12:55", "text": "マイナーへのリクエストなど、すべてのルールが含まれます。また、"}, {"type": "subtitle", "time": 778.629, "timestamp": "00:12:58", "text": "ウェブサイトのマージ作業が"}]
[{"type": "subtitle", "time": 4866.87, "timestamp": "01:21:06", "text": "セクションオプションのようなオプションが表示されます。 これらは正しいと見なすことができる"}, {"type": "subtitle", "time": 4869.27, "timestamp": "01:21:09", "text": "。"}, {"type": "subtitle", "time": 4872.149, "timestamp": "01:21:12", "text": "これらを与格とする。"}, {"type": "subtitle", "time": 4875.11, "timestamp": "01:21:15", "text": "未成年者向け、"}, {"type": "subtitle", "time": 4877.43, "timestamp": "01:21:17", "text": "支援者や会員向け、そして与格者向け、"}, {"type": "subtitle", "time": 4881.189, "timestamp": "01:21:21", "text": "それぞれ用意できます。 だから、ここに3つのテキストがある"}, {"type": "subtitle", "time": 4884.87, "timestamp": "01:21:24", "text": "か、ここにあります。"}, {"type": "subtitle", "time": 4888.31, "timestamp": "01:21:28", "text": "テキスト部分は中央揃えになりますよね"}, {"type": "subtitle", "time": 4892.07, "timestamp": "01:21:32", "text": "？ テキストは中央揃えにできます。   それが"}, {"type": "subtitle", "time": 4894.55, "timestamp": "01:21:34", "text": "私の考えです。"}, {"type": "subtitle", "time": 4897.51, "timestamp": "01:21:37", "text": "ええと、"}, {"type": "subtitle", "time": 4899.43, "timestamp": "01:21:39", "text": "現在、ウェブサイトのスペースを確認すると、"}, {"type": "subtitle", "time": 4908.63, "timestamp": "01:21:48", "text": "これらはすべて"}, {"type": "subtitle", "time": 4913.43, "timestamp": "01:21:53", "text": "中央に配置されています。 これで全て中央揃えになりました。"}, {"type": "subtitle", "time": 4915.59, "timestamp": "01:21:55", "text": "昨日の成果達成ページも"}, {"type": "subtitle", "time": 4917.83, "timestamp": "01:21:57", "text": "中央揃えになっています。 それでは、同じことを"}]
[{"type": "subtitle", "time": 1740.95, "timestamp": "00:29:00", "text": "マルチリーミングを行っています。 これは、ネイティブに"}, {"type": "subtitle", "time": 1749.029, "timestamp": "00:29:09", "text": "マルチストリーミングを可能にするストリーミングサービスのようなものです。 本当に良いウェブサイトです。   再"}, {"type": "subtitle", "time": 1752.47, "timestamp": "00:29:12", "text": "リーミングに料金を支払う必要がないようなものです。"}, {"type": "subtitle", "time": 1755.19, "timestamp": "00:29:15", "text": "無料で利用できますが、"}, {"type": "subtitle", "time": 1758.71, "timestamp": "00:29:18", "text": "プラットフォームに登録して、"}, {"type": "subtitle", "time": 1762.549, "timestamp": "00:29:22", "text": "月に最低4時間配信するだけでOKです。 つまり、"}, {"type": "subtitle", "time": 1765.11, "timestamp": "00:29:25", "text": "選択したスポンサーを利用しなければ、"}, {"type": "subtitle", "time": 1767.75, "timestamp": "00:29:27", "text": "プレミアム機能を利用するには月額料金を支払う必要があります"}, {"type": "subtitle", "time": 1770.63, "timestamp": "00:29:30", "text": "。 それはマルチストリーミングなどと同じようなものです。"}, {"type": "subtitle", "time": 1774.87, "timestamp": "00:29:34", "text": "私は"}, {"type": "subtitle", "time": 1776.549, "timestamp": "00:29:36", "text": "マルチストリーミングをたくさんしているので、"}, {"type": "subtitle", "time": 1779.909, "timestamp": "00:29:39", "text": "料金を支払ったりする必要がありません。 無料です。 彼らは"}, {"type": "subtitle", "time": 1783.029, "timestamp": "00:29:43", "text": "イベントを開催したり、"}, {"type": "subtitle", "time": 1789.59, "timestamp": "00:29:49", "text": "スポンサー企業と協力してカスタムPCなどの景品を配布したりしています。"}, {"type": "subtitle", "time": 1791.83, "timestamp": "00:29:51", "text": "アレクサンダーはPCっぽい。"}, {"type": "subtitle", "time": 1793.51, "timestamp": "00:29:53", "text": "うん。 そうそう。 彼らの"}, {"type": "subtitle", "time": 1798.31, "timestamp": "00:29:58", "text": "プレゼント企画はどうなったの？ プレゼント企画が見たいです。"}]
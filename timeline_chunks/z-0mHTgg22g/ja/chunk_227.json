[{"type": "subtitle", "time": 13626.74, "timestamp": "03:47:06", "text": "芸術家。 人間とは何か？"}, {"type": "subtitle", "time": 13634.469, "timestamp": "03:47:14", "text": "待って、違う。 待って、ちょっと待って。"}, {"type": "subtitle", "time": 13637.03, "timestamp": "03:47:17", "text": "彼らはファンメイドのアセットなどについて話しますか"}, {"type": "subtitle", "time": 13639.91, "timestamp": "03:47:19", "text": "？"}, {"type": "subtitle", "time": 13648.309, "timestamp": "03:47:28", "text": "ええと、ファンアートは"}, {"type": "subtitle", "time": 13660.87, "timestamp": "03:47:40", "text": "デザインされたコンセプトと代替案で、"}, {"type": "subtitle", "time": 13669.349, "timestamp": "03:47:49", "text": "[音楽] それを拾って置いて"}]
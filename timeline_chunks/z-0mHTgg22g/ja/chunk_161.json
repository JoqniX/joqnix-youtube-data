[{"type": "subtitle", "time": 9669.11, "timestamp": "02:41:09", "text": "近々、eコマース機能を追加する予定です。 そこで"}, {"type": "subtitle", "time": 9670.55, "timestamp": "02:41:10", "text": "彼らは"}, {"type": "subtitle", "time": 9674.309, "timestamp": "02:41:14", "text": "まずShopifyで試してみるつもりだ。"}, {"type": "subtitle", "time": 9677.11, "timestamp": "02:41:17", "text": "ええと、彼らはPLのようなものを作っていて、彼らの製品では、"}, {"type": "subtitle", "time": 9680.15, "timestamp": "02:41:20", "text": "ユーザーが任意の"}, {"type": "subtitle", "time": 9682.63, "timestamp": "02:41:22", "text": "eコマースプラットフォームを選択して"}, {"type": "subtitle", "time": 9685.83, "timestamp": "02:41:25", "text": "Webスタジオの製品に接続できるようにしています"}, {"type": "subtitle", "time": 9688.71, "timestamp": "02:41:28", "text": "。 つまり、Shopifyストアを持っている場合、"}, {"type": "subtitle", "time": 9691.51, "timestamp": "02:41:31", "text": "Shopifyの"}, {"type": "subtitle", "time": 9693.83, "timestamp": "02:41:33", "text": "機能を統合すれば、Shopifyと接続できるということです"}, {"type": "subtitle", "time": 9696.15, "timestamp": "02:41:36", "text": "。"}, {"type": "subtitle", "time": 9699.03, "timestamp": "02:41:39", "text": "例えば ​​Wix のような別のストアを使用する場合、あるいは"}, {"type": "subtitle", "time": 9701.59, "timestamp": "02:41:41", "text": "Wix 以外のストアを使用する場合、"}, {"type": "subtitle", "time": 9706.309, "timestamp": "02:41:46", "text": "Shopify 以外のストアは知りませんが、別の"}, {"type": "subtitle", "time": 9709.59, "timestamp": "02:41:49", "text": "タイプの e コマース API がある場合は、"}, {"type": "subtitle", "time": 9713.03, "timestamp": "02:41:53", "text": "ここに追加できます。 ウェブスタジオ内で追加できます"}, {"type": "subtitle", "time": 9716.389, "timestamp": "02:41:56", "text": "。 そう、つまり、彼ら"}, {"type": "subtitle", "time": 9719.51, "timestamp": "02:41:59", "text": "もCMSみたいなものを持っているんです。"}]
[{"type": "subtitle", "time": 5703.11, "timestamp": "01:35:03", "text": "サイトでもっと高度なことをしたいと思っています。 いいえ。だから、"}, {"type": "subtitle", "time": 5706.149, "timestamp": "01:35:06", "text": "サーバーを購入して、ウェブサイトなどをホスティングする必要があるかもしれません"}, {"type": "subtitle", "time": 5709.43, "timestamp": "01:35:09", "text": "。 うん。 今のところは無料で公開して"}, {"type": "subtitle", "time": 5712.709, "timestamp": "01:35:12", "text": "デザインして学ぶことができます。HTML"}, {"type": "subtitle", "time": 5716.07, "timestamp": "01:35:16", "text": "や CSS は知りませんが、"}, {"type": "subtitle", "time": 5719.91, "timestamp": "01:35:19", "text": "これを使って少しずつ学んでいます。何を"}, {"type": "subtitle", "time": 5722.629, "timestamp": "01:35:22", "text": "するべきか、div とは何か、"}, {"type": "subtitle", "time": 5726.149, "timestamp": "01:35:26", "text": "span とは何かをますます理解しています。最近 span が"}, {"type": "subtitle", "time": 5729.11, "timestamp": "01:35:29", "text": "何であるかを理解し、それらすべてを少しずつ"}, {"type": "subtitle", "time": 5734.95, "timestamp": "01:35:34", "text": "正しく行う方法を理解しています。でも、"}, {"type": "subtitle", "time": 5740.709, "timestamp": "01:35:40", "text": "カスタムの"}, {"type": "subtitle", "time": 5744.07, "timestamp": "01:35:44", "text": "ものが欲しい場合は、これを使うのではなく、何らかの方法で"}, {"type": "subtitle", "time": 5747.11, "timestamp": "01:35:47", "text": "セルフホストして適切に行う必要があります"}, {"type": "subtitle", "time": 5750.07, "timestamp": "01:35:50", "text": "。"}, {"type": "subtitle", "time": 5755.51, "timestamp": "01:35:55", "text": "カスタムコードに関しては、多くの制約も存在します。 今はコーディングをしないといけないんだけど、"}, {"type": "subtitle", "time": 5757.51, "timestamp": "01:35:57", "text": "私はコーディングがわからないから、それが"}, {"type": "subtitle", "time": 5759.83, "timestamp": "01:35:59", "text": "大変だ。"}]
[{"type": "subtitle", "time": 6061.35, "timestamp": "01:41:01", "text": "スマホで見るときに、それを包み込むようにしたかったんです。 どうすればいいですか"}, {"type": "subtitle", "time": 6064.79, "timestamp": "01:41:04", "text": "？ 私は昨日何をしたっけ？"}, {"type": "subtitle", "time": 6069.83, "timestamp": "01:41:09", "text": "この男は何をしているのか？ リストをブロックします。"}, {"type": "subtitle", "time": 6071.99, "timestamp": "01:41:11", "text": "半径方向の屈曲"}, {"type": "subtitle", "time": 6082.709, "timestamp": "01:41:22", "text": "コンテンツブロックの"}, {"type": "subtitle", "time": 6089.59, "timestamp": "01:41:29", "text": "コンテンツブロック。 ああ、全部コピーしちゃったんだね"}, {"type": "subtitle", "time": 6092.79, "timestamp": "01:41:32", "text": "。 いいえ、私たちはこれを望んでいません。 ああ、"}, {"type": "subtitle", "time": 6093.99, "timestamp": "01:41:33", "text": "大丈夫です。 大丈夫。 大丈夫。 私たちは"}, {"type": "subtitle", "time": 6095.75, "timestamp": "01:41:35", "text": "行く必要はありません。 私たちはあなたを必要としていません。"}, {"type": "subtitle", "time": 6097.83, "timestamp": "01:41:37", "text": "大丈夫。"}, {"type": "subtitle", "time": 6117.59, "timestamp": "01:41:57", "text": "えーと"}]
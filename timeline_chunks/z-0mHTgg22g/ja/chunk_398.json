[{"type": "subtitle", "time": 23887.27, "timestamp": "06:38:07", "text": "よし、この少年をスピードランで倒そう。 ファンメイドのツール"}, {"type": "subtitle", "time": 23916.07, "timestamp": "06:38:36", "text": "、これはうまくいくかもしれない。"}, {"type": "subtitle", "time": 23929.03, "timestamp": "06:38:49", "text": "このガイドラインページには全力で取り組むぞ"}, {"type": "subtitle", "time": 23932.788, "timestamp": "06:38:52", "text": "。 現時点では、規模が大きすぎるように感じます"}, {"type": "subtitle", "time": 23936.31, "timestamp": "06:38:56", "text": "。 私は気にしません。 自分がこんなにも"}]
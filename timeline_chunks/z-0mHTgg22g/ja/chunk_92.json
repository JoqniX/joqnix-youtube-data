[{"type": "subtitle", "time": 5522.87, "timestamp": "01:32:02", "text": "今日はガイドラインのページに取り組みたいと思っていました。ウェブ"}, {"type": "subtitle", "time": 5528.18, "timestamp": "01:32:08", "text": "サイトについては、固定コメントを確認してください。"}, {"type": "subtitle", "time": 5529.35, "timestamp": "01:32:09", "text": "[音楽]"}, {"type": "subtitle", "time": 5532.79, "timestamp": "01:32:12", "text": "ええ。 うん。 ウェブサイトが完成しました。"}, {"type": "subtitle", "time": 5534.87, "timestamp": "01:32:14", "text": "できますよ。 ウェブサイトはそこにあります。"}, {"type": "subtitle", "time": 5537.11, "timestamp": "01:32:17", "text": "メニューをクリックします。"}, {"type": "subtitle", "time": 5539.75, "timestamp": "01:32:19", "text": "これまでに作成したページを確認できます。  「会社"}, {"type": "subtitle", "time": 5542.87, "timestamp": "01:32:22", "text": "概要」ページは完成し、マイルストーン"}, {"type": "subtitle", "time": 5545.51, "timestamp": "01:32:25", "text": "ページは昨日完成しました。 今日は"}, {"type": "subtitle", "time": 5550.07, "timestamp": "01:32:30", "text": "ガイドラインと情報ページを作成します。   実は"}, {"type": "subtitle", "time": 5553.59, "timestamp": "01:32:33", "text": "既にマイナーページへのリクエストがあります"}, {"type": "subtitle", "time": 5555.27, "timestamp": "01:32:35", "text": "。"}, {"type": "subtitle", "time": 5559.51, "timestamp": "01:32:39", "text": "マイナスを要求します。"}, {"type": "subtitle", "time": 5561.83, "timestamp": "01:32:41", "text": "私は正しいです。"}, {"type": "subtitle", "time": 5564.47, "timestamp": "01:32:44", "text": "何？ どこですか？"}, {"type": "subtitle", "time": 5567.59, "timestamp": "01:32:47", "text": "サームス TRMS。"}, {"type": "subtitle", "time": 5570.629, "timestamp": "01:32:50", "text": "ああ、これだ。 私はこれを持っています。"}, {"type": "subtitle", "time": 5574.95, "timestamp": "01:32:54", "text": "それを、これから作成する現在のファイルにコピー＆ペーストする必要があります"}]
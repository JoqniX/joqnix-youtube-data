[{"type": "subtitle", "time": 1260.39, "timestamp": "00:21:00", "text": "私が使っているもう一つのソフトウェアはSammyです。 えっと、"}, {"type": "subtitle", "time": 1270.39, "timestamp": "00:21:10", "text": "これは私が最初に使ったものです"}, {"type": "subtitle", "time": 1273.75, "timestamp": "00:21:13", "text": "。"}, {"type": "subtitle", "time": 1276.07, "timestamp": "00:21:16", "text": "Sammyが最初に登場し、その後"}, {"type": "subtitle", "time": 1278.789, "timestamp": "00:21:18", "text": "他のソフトウェアが次々と登場しました。なぜ"}, {"type": "subtitle", "time": 1281.029, "timestamp": "00:21:21", "text": "読み込みにこんなに時間がかかるのでしょうか？ ええ、こちらは"}, {"type": "subtitle", "time": 1284.47, "timestamp": "00:21:24", "text": "サミーです。 それは多くのことができる。"}, {"type": "subtitle", "time": 1287.43, "timestamp": "00:21:27", "text": "OBS Twitch。 音声操作"}, {"type": "subtitle", "time": 1290.07, "timestamp": "00:21:30", "text": "機能が付いている。 彼らは「Mix Mix It Up」も作っている。"}, {"type": "subtitle", "time": 1293.99, "timestamp": "00:21:33", "text": "ミックス・イット・アップも、使えるツールのひとつです"}, {"type": "subtitle", "time": 1295.83, "timestamp": "00:21:35", "text": "。"}, {"type": "subtitle", "time": 1299.51, "timestamp": "00:21:39", "text": "ストリーミング配信用の別のソフトウェア。"}, {"type": "subtitle", "time": 1301.27, "timestamp": "00:21:41", "text": "物事を自動化できます。 別の"}, {"type": "subtitle", "time": 1303.35, "timestamp": "00:21:43", "text": "ソフトウェア。"}, {"type": "subtitle", "time": 1306.95, "timestamp": "00:21:46", "text": "このソフトウェアは、"}, {"type": "subtitle", "time": 1309.43, "timestamp": "00:21:49", "text": "UIとか色々あって、ちょっと複雑だと感じます。"}, {"type": "subtitle", "time": 1312.71, "timestamp": "00:21:52", "text": "初心者向けというほどではないけれど、"}, {"type": "subtitle", "time": 1315.11, "timestamp": "00:21:55", "text": "Discord や"}, {"type": "subtitle", "time": 1319.669, "timestamp": "00:21:59", "text": "Twitch クリップなどの作業はきちんとこなせる、本当に"}]
[{"type": "subtitle", "time": 2820.87, "timestamp": "00:47:00", "text": "ストリームでテキスト読み上げがある場合、どうやってそれを行うのですか？ それには複数の方法がある"}, {"type": "subtitle", "time": 2823.67, "timestamp": "00:47:03", "text": "。 どちらをご希望ですか？ クラウド版"}, {"type": "subtitle", "time": 2826.87, "timestamp": "00:47:06", "text": "かローカル版か。"}, {"type": "subtitle", "time": 2829.19, "timestamp": "00:47:09", "text": "ローカル版を作成する場合は、"}, {"type": "subtitle", "time": 2832.55, "timestamp": "00:47:12", "text": "Streamerbot から別のソフトウェアを入手する必要があります。 彼らは"}, {"type": "chat", "time": 2834.542, "timestamp": "00:47:14", "author": "@Lemmings_0", "avatar": "https://yt4.ggpht.com/MIeTwieZjegymaDIizsQ-fHaDloP6S4c_1OEYkYH-TxFDcvN-y3DI2XEu0eHqh_0Il1gLRD90Xw=s64-c-k-c0x00ffffff-no-rj", "message": "@sarthak hiii 👋"}, {"type": "subtitle", "time": 2834.63, "timestamp": "00:47:14", "text": "それをスピーカーボットと呼んでいる。"}, {"type": "subtitle", "time": 2845.349, "timestamp": "00:47:25", "text": "テキスト読み上げには、Google のサービスや基本的な Microsoft のサービスなど、任意のサービスを使用できます。クラウド"}, {"type": "subtitle", "time": 2847.75, "timestamp": "00:47:27", "text": "ベースの場合は、"}, {"type": "chat", "time": 2849.238, "timestamp": "00:47:29", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "@Hiro what you doin"}, {"type": "subtitle", "time": 2850.309, "timestamp": "00:47:30", "text": "複数の方法で実行できます。Streamlabs を使用して"}, {"type": "subtitle", "time": 2856.79, "timestamp": "00:47:36", "text": "実行することも、StreamElements を使用することもできます。"}, {"type": "subtitle", "time": 2862.55, "timestamp": "00:47:42", "text": "私の理解が正しければ、はい"}, {"type": "subtitle", "time": 2866.069, "timestamp": "00:47:46", "text": "。"}, {"type": "subtitle", "time": 2868.55, "timestamp": "00:47:48", "text": "そうそう。"}, {"type": "subtitle", "time": 2873.27, "timestamp": "00:47:53", "text": "ちなみに、Streamlabsはスポンサーシップ関連の活動を始めたよ。"}, {"type": "chat", "time": 2874.998, "timestamp": "00:47:54", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "nice"}, {"type": "subtitle", "time": 2876.87, "timestamp": "00:47:56", "text": "ブランド関連のスポンサー活動とか、"}]
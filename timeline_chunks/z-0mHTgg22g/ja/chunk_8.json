[{"type": "subtitle", "time": 483.189, "timestamp": "00:08:03", "text": "機能しないのはなぜですか？ だから、私はその1日から3日を見ています"}, {"type": "subtitle", "time": 485.11, "timestamp": "00:08:05", "text": "。 うん。 うん。 うん。 私たちは"}, {"type": "subtitle", "time": 488.95, "timestamp": "00:08:08", "text": "ジョアソンイベントのようなものをやっています。 ええ、そうですね。"}, {"type": "subtitle", "time": 491.43, "timestamp": "00:08:11", "text": "うん。 これはどちらかというと"}, {"type": "subtitle", "time": 493.35, "timestamp": "00:08:13", "text": "マラソンに近い。   むしろ"}, {"type": "subtitle", "time": 496.869, "timestamp": "00:08:16", "text": "ゴラトンとでも言うべきでしょうか。"}, {"type": "subtitle", "time": 501.27, "timestamp": "00:08:21", "text": "ええ、サバソンは"}, {"type": "subtitle", "time": 504.309, "timestamp": "00:08:24", "text": "このイベントには合わないと思います。サバソンというのは、"}, {"type": "subtitle", "time": 506.23, "timestamp": "00:08:26", "text": "Twitchの配信などを見ているとわかると思いますが"}, {"type": "subtitle", "time": 509.909, "timestamp": "00:08:29", "text": "、"}, {"type": "subtitle", "time": 513.5889999999999, "timestamp": "00:08:33", "text": "人々がサブスクや寄付などを送ってくれるイベントで、"}, {"type": "subtitle", "time": 524.55, "timestamp": "00:08:44", "text": "サポートしてくれる人が増えるほどタイマーが上がっていくようなものですよね"}, {"type": "subtitle", "time": 527.43, "timestamp": "00:08:47", "text": "？ 私の場合、どちらかというと決まった"}, {"type": "subtitle", "time": 530.389, "timestamp": "00:08:50", "text": "スケジュールがある感じです。 つまり、"}, {"type": "subtitle", "time": 532.389, "timestamp": "00:08:52", "text": "それはどちらかというと固定イベントのようなものだ。 つまり、"}, {"type": "subtitle", "time": 537.11, "timestamp": "00:08:57", "text": "私の理解が"}]
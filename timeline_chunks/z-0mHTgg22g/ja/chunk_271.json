[{"type": "subtitle", "time": 16276.55, "timestamp": "04:31:16", "text": "オーケー。 では、"}, {"type": "subtitle", "time": 16280.229, "timestamp": "04:31:20", "text": "この"}, {"type": "subtitle", "time": 16285.349, "timestamp": "04:31:25", "text": "サンプリングとして、ここから茎の下に戻ります。 わかった。 誤解を招くような、ええと、"}, {"type": "subtitle", "time": 16298.71, "timestamp": "04:31:38", "text": "使って、"}, {"type": "subtitle", "time": 16302.149, "timestamp": "04:31:42", "text": "誤解を招くようなブランディング、つまり、私は自分が、私は"}, {"type": "subtitle", "time": 16313.67, "timestamp": "04:31:53", "text": "飛んでいる、遊んでいる、ふりをしている、"}]
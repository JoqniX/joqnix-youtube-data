[{"type": "subtitle", "time": 3241.91, "timestamp": "00:54:01", "text": "これが"}, {"type": "subtitle", "time": 3245.19, "timestamp": "00:54:05", "text": "パトロンのメンバーシップで運営されているので、"}, {"type": "subtitle", "time": 3247.51, "timestamp": "00:54:07", "text": "Discordログインシステムを使用しているということです。つまり、"}, {"type": "subtitle", "time": 3252.069, "timestamp": "00:54:12", "text": "パトロンメンバーであれば、"}, {"type": "subtitle", "time": 3254.47, "timestamp": "00:54:14", "text": "すでにDiscordを持っているため、それを"}, {"type": "subtitle", "time": 3257.75, "timestamp": "00:54:17", "text": "確認して、"}, {"type": "subtitle", "time": 3265.349, "timestamp": "00:54:25", "text": "メンバー限定チャンネルやDiscordなどにアクセスできるようにしています。"}, {"type": "subtitle", "time": 3269.91, "timestamp": "00:54:29", "text": "DiscordにPatreonアカウントを連携させる必要があるんですよね？ いろいろありますよね"}, {"type": "subtitle", "time": 3271.91, "timestamp": "00:54:31", "text": "？ 理事会はそれを"}, {"type": "subtitle", "time": 3274.23, "timestamp": "00:54:34", "text": "すべて連携させる必要がある。 つまり、Discordアカウントで"}, {"type": "subtitle", "time": 3276.87, "timestamp": "00:54:36", "text": "Patreonメンバーシップが有効かどうかをスキャンする方法はこうです"}, {"type": "subtitle", "time": 3279.349, "timestamp": "00:54:39", "text": "。 そうすることで初めて、"}, {"type": "subtitle", "time": 3281.75, "timestamp": "00:54:41", "text": "ベータ版やアルファ版のようなバージョンにアクセスできるようになります"}, {"type": "subtitle", "time": 3284.95, "timestamp": "00:54:44", "text": "。 彼らは賢い。"}, {"type": "subtitle", "time": 3288.39, "timestamp": "00:54:48", "text": "彼らは、"}, {"type": "subtitle", "time": 3293.43, "timestamp": "00:54:53", "text": "人々がそれを悪用しないように、多くのセキュリティ機能を実装した。 それはとても素敵ですね。"}, {"type": "subtitle", "time": 3295.27, "timestamp": "00:54:55", "text": "また、このエフェクトは、マウスカーソルを重ねたときに"}, {"type": "subtitle", "time": 3299.43, "timestamp": "00:54:59", "text": "光る効果のように、今ではとても素敵です。"}]
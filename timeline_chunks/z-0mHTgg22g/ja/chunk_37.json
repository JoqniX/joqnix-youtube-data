[{"type": "subtitle", "time": 2233.19, "timestamp": "00:37:13", "text": "。"}, {"type": "subtitle", "time": 2244.23, "timestamp": "00:37:24", "text": "後で自分のシステムを構築する必要があります。 でも、少なくともそれくらいは動かせるようにしておきます"}, {"type": "subtitle", "time": 2247.67, "timestamp": "00:37:27", "text": "。 つまり、私はただ"}, {"type": "subtitle", "time": 2254.069, "timestamp": "00:37:34", "text": "[音楽]"}, {"type": "subtitle", "time": 2256.47, "timestamp": "00:37:36", "text": "スタートアップアプリを作りたいということです"}]
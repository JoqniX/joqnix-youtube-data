[{"type": "subtitle", "time": 11403.51, "timestamp": "03:10:03", "text": "。 それに、"}, {"type": "subtitle", "time": 11406.23, "timestamp": "03:10:06", "text": "ラジオのガイドラインをずっと作りたかったんです。というのも、"}, {"type": "chat", "time": 11408.917, "timestamp": "03:10:08", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "i feel you bro 😔"}, {"type": "subtitle", "time": 11413.19, "timestamp": "03:10:13", "text": "説明欄に「これは"}, {"type": "subtitle", "time": 11416.63, "timestamp": "03:10:16", "text": "ファンメイドの音楽です」とか「これは"}, {"type": "subtitle", "time": 11420.55, "timestamp": "03:10:20", "text": "ジョックのためのファンメイドの編集です」などときちんと書いていない人がいて、"}, {"type": "subtitle", "time": 11422.469, "timestamp": "03:10:22", "text": "人々は「ジョック、新しい音楽をリリースしたね」と思う"}, {"type": "subtitle", "time": 11425.349, "timestamp": "03:10:25", "text": "けど、実際はコミュニティの"}, {"type": "subtitle", "time": 11431.349, "timestamp": "03:10:31", "text": "メンバーが作ったファン作品で、"}, {"type": "subtitle", "time": 11433.51, "timestamp": "03:10:33", "text": "ロゴ画像などを使いたいだけだったりするんです。 私も"}, {"type": "subtitle", "time": 11435.99, "timestamp": "03:10:35", "text": "過去にそういう経験をしたことがあります。 いいえ。だから、"}, {"type": "subtitle", "time": 11437.83, "timestamp": "03:10:37", "text": "私はそれらを防ごうとしたのです。"}, {"type": "subtitle", "time": 11440.79, "timestamp": "03:10:40", "text": "きちんと体系化されたものがあれば役に立つと思ったんです"}, {"type": "subtitle", "time": 11443.03, "timestamp": "03:10:43", "text": "。"}, {"type": "subtitle", "time": 11448.389, "timestamp": "03:10:48", "text": "ええ、昨日、マイル"}, {"type": "subtitle", "time": 11451.67, "timestamp": "03:10:51", "text": "ストーンのページを完成させました。 これは文字通り、"}, {"type": "subtitle", "time": 11457.19, "timestamp": "03:10:57", "text": "ファンダムのwikiにあるすべての情報から来ています。"}]
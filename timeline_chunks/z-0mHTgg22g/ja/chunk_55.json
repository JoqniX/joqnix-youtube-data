[{"type": "subtitle", "time": 3302.95, "timestamp": "00:55:02", "text": "わあ、これはいいですね。"}, {"type": "subtitle", "time": 3306.069, "timestamp": "00:55:06", "text": "わあ、これは本当に素晴らしいですね。 どうすればいいですか"}, {"type": "subtitle", "time": 3311.75, "timestamp": "00:55:11", "text": "おお。"}, {"type": "subtitle", "time": 3313.349, "timestamp": "00:55:13", "text": "さて、"}, {"type": "subtitle", "time": 3318.069, "timestamp": "00:55:18", "text": "私は一体何をしていたんだっけ？ スピーカーボード。"}, {"type": "subtitle", "time": 3321.829, "timestamp": "00:55:21", "text": "これをダウンロードしないといけない。"}, {"type": "subtitle", "time": 3328.069, "timestamp": "00:55:28", "text": "ジョス、何してるの？ 話が脱線しそうだ"}, {"type": "subtitle", "time": 3332.15, "timestamp": "00:55:32", "text": "。 気にしないでください。   えっと"}, {"type": "subtitle", "time": 3343.28, "timestamp": "00:55:43", "text": "スピーカーボット"}, {"type": "subtitle", "time": 3346.23, "timestamp": "00:55:46", "text": "【音楽】"}, {"type": "subtitle", "time": 3352.23, "timestamp": "00:55:52", "text": "H、"}, {"type": "subtitle", "time": 3353.75, "timestamp": "00:55:53", "text": "このアプリケーションを開くのは初めてです"}, {"type": "subtitle", "time": 3357.349, "timestamp": "00:55:57", "text": "。 それでは、一緒に学んでいきましょうか"}]
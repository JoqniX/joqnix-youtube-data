[{"type": "subtitle", "time": 3423.47, "timestamp": "00:57:03", "text": "如果你让他们更生气，我就消失。"}, {"type": "subtitle", "time": 3434.109, "timestamp": "00:57:14", "text": "我宁愿我现在的这些朋友死去"}, {"type": "subtitle", "time": 3450.349, "timestamp": "00:57:30", "text": "你本可以逃离这种情况，但你却承担了所有重担。"}, {"type": "subtitle", "time": 3452.51, "timestamp": "00:57:32", "text": "在"}, {"type": "subtitle", "time": 3457.029, "timestamp": "00:57:37", "text": "我不喜欢那种生活方式。尽管如此"}]
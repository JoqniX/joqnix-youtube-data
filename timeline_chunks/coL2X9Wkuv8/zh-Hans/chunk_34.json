[{"type": "subtitle", "time": 2044.11, "timestamp": "00:34:04", "text": "现在想想，周末的时候周围人好像比平时少。"}, {"type": "subtitle", "time": 2048.069, "timestamp": "00:34:08", "text": "大家都躲起来了，因为他们知道我要来了。"}, {"type": "subtitle", "time": 2057.95, "timestamp": "00:34:17", "text": "那份沉默是帝王的标志吗？请给予一些安慰。"}, {"type": "subtitle", "time": 2061.31, "timestamp": "00:34:21", "text": "我以为你会把它给我。"}, {"type": "subtitle", "time": 2065.27, "timestamp": "00:34:25", "text": "集体规章制度负责保障学校安全。"}, {"type": "subtitle", "time": 2086.149, "timestamp": "00:34:46", "text": "如果我们在这里下车，就到花园区了，对吧？"}, {"type": "subtitle", "time": 2090.19, "timestamp": "00:34:50", "text": "前两个"}]
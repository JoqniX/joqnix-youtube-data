[{"type": "subtitle", "time": 4086.95, "timestamp": "01:08:06", "text": "因为"}, {"type": "subtitle", "time": 4096.95, "timestamp": "01:08:16", "text": "来不及做任何事。"}, {"type": "subtitle", "time": 4099.709, "timestamp": "01:08:19", "text": "尽管如此"}, {"type": "subtitle", "time": 4102.749, "timestamp": "01:08:22", "text": "我想选择一种有尊严的死亡方式。"}, {"type": "subtitle", "time": 4104.6, "timestamp": "01:08:24", "text": "。 至少"}, {"type": "subtitle", "time": 4106.6, "timestamp": "01:08:26", "text": "至少 像人类一样"}, {"type": "subtitle", "time": 4109.08, "timestamp": "01:08:29", "text": "像人类一样 承担责任"}, {"type": "subtitle", "time": 4112.04, "timestamp": "01:08:32", "text": "承担责任 好好道别之后"}, {"type": "subtitle", "time": 4115.679, "timestamp": "01:08:35", "text": "好好道别之后 我曾想过自杀。"}, {"type": "subtitle", "time": 4124.59, "timestamp": "01:08:44", "text": "但这真令人遗憾。"}, {"type": "subtitle", "time": 4128.47, "timestamp": "01:08:48", "text": "我选了个这么好的日子，但是……"}, {"type": "subtitle", "time": 4132.309, "timestamp": "01:08:52", "text": "我该如何道别？"}, {"type": "subtitle", "time": 4136.749, "timestamp": "01:08:56", "text": "我完全没听懂。"}, {"type": "subtitle", "time": 4139.669, "timestamp": "01:08:59", "text": "我擅长的是"}]
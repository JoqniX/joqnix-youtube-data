[{"type": "subtitle", "time": 2643.23, "timestamp": "00:44:03", "text": "我认为我们当时正朝着这个方向前进。"}, {"type": "subtitle", "time": 2688.589, "timestamp": "00:44:48", "text": "我不擅长打架。"}, {"type": "subtitle", "time": 2691.19, "timestamp": "00:44:51", "text": "仔细想想，伊伊酱，确实如此。"}, {"type": "subtitle", "time": 2693.829, "timestamp": "00:44:53", "text": "我得尽快给家人打电话。"}]
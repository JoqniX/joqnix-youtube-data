[{"type": "subtitle", "time": 4204.87, "timestamp": "01:10:04", "text": "正当我以为一切都会消失，我会回归虚无的时候"}, {"type": "subtitle", "time": 4214.308, "timestamp": "01:10:14", "text": "多年"}, {"type": "subtitle", "time": 4215.189, "timestamp": "01:10:15", "text": "[嗤笑]"}, {"type": "subtitle", "time": 4218.95, "timestamp": "01:10:18", "text": "从我第一次接触它那天起"}, {"type": "subtitle", "time": 4226.098, "timestamp": "01:10:26", "text": "即使你死了，明天的太阳也不会改变。"}, {"type": "subtitle", "time": 4229.79, "timestamp": "01:10:29", "text": "[音乐] 它会攀升。"}, {"type": "subtitle", "time": 4233.47, "timestamp": "01:10:33", "text": "我明白这一点。"}, {"type": "subtitle", "time": 4235.99, "timestamp": "01:10:35", "text": "这个世界"}, {"type": "subtitle", "time": 4240.189, "timestamp": "01:10:40", "text": "我的死也不会改变任何事情。"}]
[{"type": "subtitle", "time": 2280.27, "timestamp": "00:38:00", "text": "决不"}, {"type": "subtitle", "time": 2283.79, "timestamp": "00:38:03", "text": "我只是假装伤口还没愈合好几天而已。"}, {"type": "subtitle", "time": 2289.349, "timestamp": "00:38:09", "text": "。我不想马上回教室。"}, {"type": "subtitle", "time": 2293.119, "timestamp": "00:38:13", "text": "C Shichan会没事的。我想在公园里捉一只白鸟。我明白。前辈，你也一起来吧。嘿，妮雅酱，好像拍摄支援小组最近正在申请摄影棚执照。"}, {"type": "subtitle", "time": 2317.589, "timestamp": "00:38:37", "text": "你还有剩余资金吗？"}, {"type": "subtitle", "time": 2322.069, "timestamp": "00:38:42", "text": "我做梦也没想到前几天在学校活动上会获奖。"}, {"type": "subtitle", "time": 2325.71, "timestamp": "00:38:45", "text": "没错。大家都很喜欢妮雅酱"}]
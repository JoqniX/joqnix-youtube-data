[{"type": "subtitle", "time": 856.91, "timestamp": "00:14:16", "text": "德雷真是"}, {"type": "subtitle", "time": 876.99, "timestamp": "00:14:36", "text": "各项生命体征持续好转。"}, {"type": "subtitle", "time": 880.949, "timestamp": "00:14:40", "text": "其活动未发现异常。超过目标频率"}, {"type": "subtitle", "time": 883.31, "timestamp": "00:14:43", "text": "我还没恢复过来。第二"}, {"type": "subtitle", "time": 884.829, "timestamp": "00:14:44", "text": "我们将执行该计划。"}, {"type": "subtitle", "time": 891.629, "timestamp": "00:14:51", "text": "丹妮娅，你能听到我说话吗？"}]
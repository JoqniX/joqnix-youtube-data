[{"type": "subtitle", "time": 3634.43, "timestamp": "01:00:34", "text": "真的吗？这让我更加担心了。"}, {"type": "subtitle", "time": 3645.43, "timestamp": "01:00:45", "text": "是的，那是丹妮娅开学的第一周。"}, {"type": "subtitle", "time": 3647.71, "timestamp": "01:00:47", "text": "自从我以前住在这里的时候，我们就认识了。"}, {"type": "subtitle", "time": 3650.39, "timestamp": "01:00:50", "text": "就是这样。"}, {"type": "subtitle", "time": 3651.829, "timestamp": "01:00:51", "text": "我是博伊德斯塔。 [音乐]"}]
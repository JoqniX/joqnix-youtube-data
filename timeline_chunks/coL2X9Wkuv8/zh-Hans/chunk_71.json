[{"type": "subtitle", "time": 4262.83, "timestamp": "01:11:02", "text": "志久里卡和娜斯塔的生活将会发生改变。"}, {"type": "subtitle", "time": 4266.91, "timestamp": "01:11:06", "text": "他们俩将会失去一位非常重要的朋友。"}, {"type": "subtitle", "time": 4270.59, "timestamp": "01:11:10", "text": "他们最终或许能够康复。"}, {"type": "subtitle", "time": 4283.91, "timestamp": "01:11:23", "text": "居住"}, {"type": "subtitle", "time": 4293.189, "timestamp": "01:11:33", "text": "我不知道。"}, {"type": "subtitle", "time": 4294.95, "timestamp": "01:11:34", "text": "但"}, {"type": "subtitle", "time": 4298.39, "timestamp": "01:11:38", "text": "我是丽娜西塔，我和你很像。"}, {"type": "subtitle", "time": 4302.03, "timestamp": "01:11:42", "text": "我遇到过这样的人。所创造的生命"}, {"type": "subtitle", "time": 4306.11, "timestamp": "01:11:46", "text": "旅途中体验到的幸福，只是转瞬即逝的美好。"}, {"type": "subtitle", "time": 4308.43, "timestamp": "01:11:48", "text": "它不在那里。"}, {"type": "subtitle", "time": 4313.75, "timestamp": "01:11:53", "text": "只有平庸和恐惧会永远存在。"}, {"type": "subtitle", "time": 4315.47, "timestamp": "01:11:55", "text": "但"}, {"type": "subtitle", "time": 4318.51, "timestamp": "01:11:58", "text": "在最后一刻"}]
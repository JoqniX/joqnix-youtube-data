[{"type": "subtitle", "time": 2467.75, "timestamp": "00:41:07", "text": "我要3个。"}, {"type": "subtitle", "time": 2483.829, "timestamp": "00:41:23", "text": "已将照片保存到勒索者的设备上。"}, {"type": "subtitle", "time": 2488.27, "timestamp": "00:41:28", "text": "咦，照片里有一只幽灵般的白色鸟。"}, {"type": "subtitle", "time": 2501.91, "timestamp": "00:41:41", "text": "未经证实"}, {"type": "subtitle", "time": 2505.27, "timestamp": "00:41:45", "text": "一只纯白的鸟儿问道"}, {"type": "subtitle", "time": 2509.19, "timestamp": "00:41:49", "text": "距离我第一次目睹爆炸已经过去一年了，而且我只近距离看过一次。"}, {"type": "subtitle", "time": 2511.99, "timestamp": "00:41:51", "text": "我也没能观察到这种情况。"}, {"type": "subtitle", "time": 2517.03, "timestamp": "00:41:57", "text": "请冷静下来。某人的共鸣能力和"}]
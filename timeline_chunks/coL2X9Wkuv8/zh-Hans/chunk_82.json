[{"type": "subtitle", "time": 4957.79, "timestamp": "01:22:37", "text": "丹雅说我们必须这么做。"}, {"type": "subtitle", "time": 4959.95, "timestamp": "01:22:39", "text": "什么"}, {"type": "subtitle", "time": 4963.55, "timestamp": "01:22:43", "text": "或许迪马普伦家族的名字就来源于此。"}, {"type": "subtitle", "time": 4970.39, "timestamp": "01:22:50", "text": "组织领导的任务是找到丹雅。"}, {"type": "subtitle", "time": 4973.43, "timestamp": "01:22:53", "text": "如果这是计划的一部分"}]
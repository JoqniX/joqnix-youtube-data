[{"type": "subtitle", "time": 10266.71, "timestamp": "02:51:06", "text": "我的声音是我只是"}, {"type": "subtitle", "time": 10269.07, "timestamp": "02:51:09", "text": "和他们亲近"}, {"type": "subtitle", "time": 10274.03, "timestamp": "02:51:14", "text": "我们正在开放"}, {"type": "subtitle", "time": 10284.63, "timestamp": "02:51:24", "text": "我懂了。所以"}, {"type": "subtitle", "time": 10289.51, "timestamp": "02:51:29", "text": "绳子"}, {"type": "subtitle", "time": 10294.99, "timestamp": "02:51:34", "text": "到本周末"}]
[{"type": "subtitle", "time": 4021.349, "timestamp": "01:07:01", "text": "。我在那边。"}, {"type": "subtitle", "time": 4026.549, "timestamp": "01:07:06", "text": "我总是发现自己一次又一次地踏入同一个湖泊。"}, {"type": "subtitle", "time": 4029.549, "timestamp": "01:07:09", "text": "一名女子"}, {"type": "subtitle", "time": 4035.069, "timestamp": "01:07:15", "text": "我哭了，双臂在风中挥舞。"}, {"type": "subtitle", "time": 4040.23, "timestamp": "01:07:20", "text": "她总是远远地看着我。"}, {"type": "subtitle", "time": 4042.67, "timestamp": "01:07:22", "text": "坦娅"}, {"type": "subtitle", "time": 4057.51, "timestamp": "01:07:37", "text": "这就是原因"}, {"type": "subtitle", "time": 4062.029, "timestamp": "01:07:42", "text": "一旦你知道了姓名和生日"}, {"type": "subtitle", "time": 4064.75, "timestamp": "01:07:44", "text": "作为一个人"}]
[{"type": "subtitle", "time": 2956.27, "timestamp": "00:49:16", "text": "在这种时候，你的洞察力出乎意料地敏锐。"}, {"type": "subtitle", "time": 2966.19, "timestamp": "00:49:26", "text": "如果丹雅不想让我听到，那我之前已经说过很多次了。"}, {"type": "subtitle", "time": 2969.349, "timestamp": "00:49:29", "text": "我也要这样做。"}, {"type": "subtitle", "time": 2971.349, "timestamp": "00:49:31", "text": "但"}, {"type": "subtitle", "time": 2974.67, "timestamp": "00:49:34", "text": "我只想问你一件事。"}, {"type": "subtitle", "time": 2978.39, "timestamp": "00:49:38", "text": "丹妮娅明年将再次庆祝她的生日。"}]
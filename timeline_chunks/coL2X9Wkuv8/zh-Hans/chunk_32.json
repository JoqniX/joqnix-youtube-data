[{"type": "subtitle", "time": 1943.23, "timestamp": "00:32:23", "text": "你会陪我一起过生日，对吗？"}, {"type": "subtitle", "time": 1960.149, "timestamp": "00:32:40", "text": "没错，但他总是看起来很闷闷不乐。"}, {"type": "subtitle", "time": 1963.71, "timestamp": "00:32:43", "text": "我总不能露面吧？"}, {"type": "subtitle", "time": 1974.99, "timestamp": "00:32:54", "text": "我同意。"}]
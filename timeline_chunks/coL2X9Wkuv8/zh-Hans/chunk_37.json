[{"type": "subtitle", "time": 2266.309, "timestamp": "00:37:46", "text": "哦，你最近又开始做噩梦了吗？"}, {"type": "subtitle", "time": 2268.99, "timestamp": "00:37:48", "text": "我听说很多人都受到了这起事件的影响。"}, {"type": "subtitle", "time": 2271.069, "timestamp": "00:37:51", "text": "但，"}, {"type": "subtitle", "time": 2274.069, "timestamp": "00:37:54", "text": "丹雅也被虚空物质吞噬了。"}]
[{"type": "subtitle", "time": 3962.95, "timestamp": "01:06:02", "text": "因为"}, {"type": "subtitle", "time": 3967.029, "timestamp": "01:06:07", "text": "大家都这么说，不是吗？"}, {"type": "subtitle", "time": 3969.15, "timestamp": "01:06:09", "text": "生日"}, {"type": "subtitle", "time": 3973.789, "timestamp": "01:06:13", "text": "证明一个人出生的证据。"}, {"type": "subtitle", "time": 3977.75, "timestamp": "01:06:17", "text": "每个人都有生日。"}, {"type": "subtitle", "time": 4007.91, "timestamp": "01:06:47", "text": "存在的是"}, {"type": "subtitle", "time": 4012.309, "timestamp": "01:06:52", "text": "只有那些即使你想忘记也无法忘记的画面。"}, {"type": "subtitle", "time": 4017.269, "timestamp": "01:06:57", "text": "它在我的梦里一遍又一遍地播放"}]
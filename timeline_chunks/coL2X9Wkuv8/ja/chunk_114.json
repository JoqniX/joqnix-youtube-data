[{"type": "subtitle", "time": 6847.87, "timestamp": "01:54:07", "text": "でも"}, {"type": "subtitle", "time": 6850.75, "timestamp": "01:54:10", "text": "そんな結末はしぐりかちゃんや"}, {"type": "subtitle", "time": 6854.27, "timestamp": "01:54:14", "text": "ナスターシャン、そして全ての人を救おう"}, {"type": "subtitle", "time": 6857.99, "timestamp": "01:54:17", "text": "としているあなたにとって"}, {"type": "subtitle", "time": 6860.95, "timestamp": "01:54:20", "text": "何を意味しますか?"}, {"type": "subtitle", "time": 6864.189, "timestamp": "01:54:24", "text": "あなたを一番手ごい相手だと考えてる組織"}, {"type": "subtitle", "time": 6866.31, "timestamp": "01:54:26", "text": "長にとって"}, {"type": "subtitle", "time": 6880.189, "timestamp": "01:54:40", "text": "あなたも彼女と同じ道を歩む可能性を意味してるわけですから。でもあなたが本当にページを取り出したならかけられたを受け取ってから暴走します。"}]
[{"type": "subtitle", "time": 4086.95, "timestamp": "01:08:06", "text": "だって"}, {"type": "subtitle", "time": 4096.95, "timestamp": "01:08:16", "text": "何もかも間に合いません。"}, {"type": "subtitle", "time": 4099.709, "timestamp": "01:08:19", "text": "それでも"}, {"type": "subtitle", "time": 4102.749, "timestamp": "01:08:22", "text": "私はまともな死に方を選びたかったんです"}, {"type": "subtitle", "time": 4104.59, "timestamp": "01:08:24", "text": "。"}, {"type": "subtitle", "time": 4106.59, "timestamp": "01:08:26", "text": "せめて"}, {"type": "subtitle", "time": 4109.07, "timestamp": "01:08:29", "text": "人間らしく"}, {"type": "subtitle", "time": 4112.03, "timestamp": "01:08:32", "text": "責任を負って"}, {"type": "subtitle", "time": 4115.669, "timestamp": "01:08:35", "text": "きちんと別れを告げてから"}, {"type": "subtitle", "time": 4124.59, "timestamp": "01:08:44", "text": "でも残念ですね。"}, {"type": "subtitle", "time": 4128.47, "timestamp": "01:08:48", "text": "せっかくいい日を選んだのに"}, {"type": "subtitle", "time": 4132.309, "timestamp": "01:08:52", "text": "どうやって別れを告げればいいか"}, {"type": "subtitle", "time": 4136.749, "timestamp": "01:08:56", "text": "全然分かりませんでした。"}, {"type": "subtitle", "time": 4139.669, "timestamp": "01:08:59", "text": "私が得意なことは"}]
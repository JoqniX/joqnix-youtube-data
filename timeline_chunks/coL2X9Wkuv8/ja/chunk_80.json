[{"type": "subtitle", "time": 4836.189, "timestamp": "01:20:36", "text": "まさか名式だったりで症状の根源が分から"}, {"type": "subtitle", "time": 4838.99, "timestamp": "01:20:38", "text": "ないわけだ。"}, {"type": "subtitle", "time": 4843.43, "timestamp": "01:20:43", "text": "数日前と同じ扱いになるね。あなたの考え"}, {"type": "subtitle", "time": 4846.51, "timestamp": "01:20:46", "text": "ていることは分かっている。表白者さん。"}, {"type": "subtitle", "time": 4849.629, "timestamp": "01:20:49", "text": "彼女も被害者だってことは皆が分かって"}, {"type": "subtitle", "time": 4854.709, "timestamp": "01:20:54", "text": "いる。しかし今のところいい案は出せそう"}, {"type": "subtitle", "time": 4858.27, "timestamp": "01:20:58", "text": "にない。なあ。まだ取りに行っていない。"}]
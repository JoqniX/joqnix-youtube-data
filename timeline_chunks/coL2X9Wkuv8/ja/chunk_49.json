[{"type": "subtitle", "time": 2956.27, "timestamp": "00:49:16", "text": "こんな時に限って察しがいいですね。"}, {"type": "subtitle", "time": 2966.19, "timestamp": "00:49:26", "text": "ダニャが聞かないで欲しいなら私は今まで"}, {"type": "subtitle", "time": 2969.349, "timestamp": "00:49:29", "text": "と同じようにするよ。"}, {"type": "subtitle", "time": 2971.349, "timestamp": "00:49:31", "text": "けど"}, {"type": "subtitle", "time": 2974.67, "timestamp": "00:49:34", "text": "1つだけ聞かせて欲しいの。"}, {"type": "subtitle", "time": 2978.39, "timestamp": "00:49:38", "text": "また来年もダーニャは誕生日をお祝いする"}]
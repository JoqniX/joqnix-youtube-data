[{"type": "subtitle", "time": 3423.47, "timestamp": "00:57:03", "text": "もっと怒らせてしまえば私がいなくなって"}, {"type": "subtitle", "time": 3434.109, "timestamp": "00:57:14", "text": "今の友達が死ぬより"}, {"type": "subtitle", "time": 3450.349, "timestamp": "00:57:30", "text": "これ逃げてもいいところを全て背負い込ん"}, {"type": "subtitle", "time": 3452.51, "timestamp": "00:57:32", "text": "で"}, {"type": "subtitle", "time": 3457.029, "timestamp": "00:57:37", "text": "私はそういう生き方が嫌いです。それでも"}]
[{"type": "subtitle", "time": 4204.87, "timestamp": "01:10:04", "text": "何もかもが消えてまた虚に戻ると思ったら"}, {"type": "subtitle", "time": 4214.308, "timestamp": "01:10:14", "text": "何年も前から"}, {"type": "subtitle", "time": 4215.189, "timestamp": "01:10:15", "text": "[鼻息]"}, {"type": "subtitle", "time": 4218.95, "timestamp": "01:10:18", "text": "初めてあれと接触した日から"}, {"type": "subtitle", "time": 4226.098, "timestamp": "01:10:26", "text": "あなたが死んでも明日の太陽は変わらずに"}, {"type": "subtitle", "time": 4229.79, "timestamp": "01:10:29", "text": "[音楽]登るでしょう。"}, {"type": "subtitle", "time": 4233.47, "timestamp": "01:10:33", "text": "それくらい分かってますよ。"}, {"type": "subtitle", "time": 4235.99, "timestamp": "01:10:35", "text": "この世界が"}, {"type": "subtitle", "time": 4240.189, "timestamp": "01:10:40", "text": "私の死なんかで何も変わらないことくらい"}]
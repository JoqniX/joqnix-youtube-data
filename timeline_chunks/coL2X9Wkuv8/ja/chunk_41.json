[{"type": "subtitle", "time": 2467.75, "timestamp": "00:41:07", "text": "3取りますよ。"}, {"type": "subtitle", "time": 2483.829, "timestamp": "00:41:23", "text": "写真脅迫者さんのデバイスに保存し"}, {"type": "subtitle", "time": 2488.27, "timestamp": "00:41:28", "text": "え、写真に霊の白い鳥が"}, {"type": "subtitle", "time": 2501.91, "timestamp": "00:41:41", "text": "未確認の気少"}, {"type": "subtitle", "time": 2505.27, "timestamp": "00:41:45", "text": "に聞く真っ白の鳥"}, {"type": "subtitle", "time": 2509.19, "timestamp": "00:41:49", "text": "目爆目撃してから早1年近距離からは1度"}, {"type": "subtitle", "time": 2511.99, "timestamp": "00:41:51", "text": "も観察できてないの"}, {"type": "subtitle", "time": 2517.03, "timestamp": "00:41:57", "text": "?落ち着いてください。誰かの共鳴能力と"}]
[{"type": "subtitle", "time": 4322.87, "timestamp": "01:12:02", "text": "誰かに与えられたの間の幸せのために最後"}, {"type": "subtitle", "time": 4331.75, "timestamp": "01:12:11", "text": "前に私をからかった時"}, {"type": "subtitle", "time": 4334.99, "timestamp": "01:12:14", "text": "脅迫者さんは救世主ですねと言ってたよね"}, {"type": "subtitle", "time": 4338.39, "timestamp": "01:12:18", "text": "。だけど"}, {"type": "subtitle", "time": 4351.149, "timestamp": "01:12:31", "text": "彼らは救えなかった。でも"}, {"type": "subtitle", "time": 4353.55, "timestamp": "01:12:33", "text": "それは"}, {"type": "subtitle", "time": 4356.83, "timestamp": "01:12:36", "text": "彼らが自ら選択を下したからじゃないです"}, {"type": "subtitle", "time": 4359.669, "timestamp": "01:12:39", "text": "か。"}, {"type": "subtitle", "time": 4365.27, "timestamp": "01:12:45", "text": "え、あの時私を止めようとしたように"}, {"type": "subtitle", "time": 4370.03, "timestamp": "01:12:50", "text": "あなたも自分が思う最善の選択をしてる。"}, {"type": "subtitle", "time": 4373.83, "timestamp": "01:12:53", "text": "あなたも彼らと同じように1人でも多くの"}, {"type": "subtitle", "time": 4378.11, "timestamp": "01:12:58", "text": "人が生きていけるように頑張っていた。"}]
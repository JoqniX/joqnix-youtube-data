[{"type": "subtitle", "time": 2583.27, "timestamp": "00:43:03", "text": "の能力だ。やっぱり彼女でしたか。あの"}, {"type": "subtitle", "time": 2589.03, "timestamp": "00:43:09", "text": "冷たい周波数は結構印象に残りますし、"}, {"type": "subtitle", "time": 2592.79, "timestamp": "00:43:12", "text": "まさか今日はずっとそうやって監視する"}, {"type": "subtitle", "time": 2595.23, "timestamp": "00:43:15", "text": "つもりですか?"}, {"type": "subtitle", "time": 2599.23, "timestamp": "00:43:19", "text": "日行きは自分の責務を全倒してるだけ。"}, {"type": "subtitle", "time": 2609.069, "timestamp": "00:43:29", "text": "それくらいもちろん知ってますよ。あなた"}, {"type": "subtitle", "time": 2613.589, "timestamp": "00:43:33", "text": "と似てる部分を感じますから。でも残念"}, {"type": "subtitle", "time": 2617.309, "timestamp": "00:43:37", "text": "ですね。私"}]
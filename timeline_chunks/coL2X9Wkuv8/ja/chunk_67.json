[{"type": "subtitle", "time": 4021.349, "timestamp": "01:07:01", "text": "。あそこにいる私は"}, {"type": "subtitle", "time": 4026.549, "timestamp": "01:07:06", "text": "いつも同じ湖に足を踏み入れるんです。"}, {"type": "subtitle", "time": 4029.549, "timestamp": "01:07:09", "text": "1人の女の人が"}, {"type": "subtitle", "time": 4035.069, "timestamp": "01:07:15", "text": "風の中で腕を揺らしながら泣いてました。"}, {"type": "subtitle", "time": 4040.23, "timestamp": "01:07:20", "text": "いつも遠くから私を見つめる彼女は"}, {"type": "subtitle", "time": 4042.67, "timestamp": "01:07:22", "text": "ターニャ"}, {"type": "subtitle", "time": 4057.51, "timestamp": "01:07:37", "text": "だから"}, {"type": "subtitle", "time": 4062.029, "timestamp": "01:07:42", "text": "こうして名前と誕生日を手に入れたら"}, {"type": "subtitle", "time": 4064.75, "timestamp": "01:07:44", "text": "1人の人間として"}]
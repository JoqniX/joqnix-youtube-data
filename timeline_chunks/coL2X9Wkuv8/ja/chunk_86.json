[{"type": "subtitle", "time": 5175.03, "timestamp": "01:26:15", "text": "あのページ"}, {"type": "subtitle", "time": 5178.87, "timestamp": "01:26:18", "text": "たまには家に帰ってくるようにしか書かれ"}, {"type": "subtitle", "time": 5188.75, "timestamp": "01:26:28", "text": "やっぱりそうでしたか。ごめんなさい。で"}, {"type": "subtitle", "time": 5190.35, "timestamp": "01:26:30", "text": "も"}, {"type": "subtitle", "time": 5193.51, "timestamp": "01:26:33", "text": "あの物語と同じように"}, {"type": "subtitle", "time": 5197.43, "timestamp": "01:26:37", "text": "魔法というものは10日を過ぎると消えて"}, {"type": "subtitle", "time": 5202.109, "timestamp": "01:26:42", "text": "しまうんです。少なくとも"}]
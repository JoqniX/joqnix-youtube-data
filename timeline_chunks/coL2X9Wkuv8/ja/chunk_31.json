[{"type": "subtitle", "time": 1875.549, "timestamp": "00:31:15", "text": "あ、待って。"}, {"type": "subtitle", "time": 1887.75, "timestamp": "00:31:27", "text": "名式の周波数に関する問題ならブラック"}, {"type": "subtitle", "time": 1890.07, "timestamp": "00:31:30", "text": "ショアがもっといい治療案を出せるかも"}, {"type": "subtitle", "time": 1893.029, "timestamp": "00:31:33", "text": "しれないけど"}, {"type": "subtitle", "time": 1895.95, "timestamp": "00:31:35", "text": "研究のことで脅迫者さんの手を患らすこと"}, {"type": "subtitle", "time": 1900.149, "timestamp": "00:31:40", "text": "はない。それより今日はよろしく頼む。"}, {"type": "subtitle", "time": 1915.23, "timestamp": "00:31:55", "text": "もういい。"}, {"type": "subtitle", "time": 1916.789, "timestamp": "00:31:56", "text": "あ、いい"}]
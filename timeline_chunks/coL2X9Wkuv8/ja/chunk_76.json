[{"type": "subtitle", "time": 4562.709, "timestamp": "01:16:02", "text": "脅迫者さん、激しい周波数の揺れを観測し"}, {"type": "subtitle", "time": 4566.03, "timestamp": "01:16:06", "text": "たぞ。2人とも大丈夫か?"}, {"type": "subtitle", "time": 4568.27, "timestamp": "01:16:08", "text": "大丈夫だよ。"}, {"type": "subtitle", "time": 4569.35, "timestamp": "01:16:09", "text": "そうか。"}, {"type": "subtitle", "time": 4593.35, "timestamp": "01:16:33", "text": "ケーキがもったいないですよ。今日が"}, {"type": "subtitle", "time": 4606.002, "timestamp": "01:16:46", "text": "それはちょっと困りましたね。だって"}, {"type": "subtitle", "time": 4607.313, "timestamp": "01:16:47", "text": "[泣き声]"}, {"type": "subtitle", "time": 4608.43, "timestamp": "01:16:48", "text": "[鼻息]"}, {"type": "subtitle", "time": 4610.47, "timestamp": "01:16:50", "text": "今日が"}]
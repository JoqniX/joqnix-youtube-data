[{"type": "subtitle", "time": 4384.11, "timestamp": "01:13:04", "text": "そしてそれは私も同じ思いだよ。"}, {"type": "subtitle", "time": 4389.709, "timestamp": "01:13:09", "text": "だから人間と増物の教会が曖昧だとしたら"}, {"type": "subtitle", "time": 4392.669, "timestamp": "01:13:12", "text": "私たちが人間なのか増物なのか決めるもの"}, {"type": "subtitle", "time": 4400.79, "timestamp": "01:13:20", "text": "私には"}, {"type": "subtitle", "time": 4408.149, "timestamp": "01:13:28", "text": "心だよ。ダーニャ"}, {"type": "subtitle", "time": 4413.39, "timestamp": "01:13:33", "text": "自身を定義するのは執じゃなくて自分の心"}, {"type": "chat", "time": 4413.424, "timestamp": "01:13:33", "author": "@Clemdawg2k", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lm3b4NzP8EJSErqfdjskWyeLX6VULSKl-arEmGx3EgLtc=s64-c-k-c0x00ffffff-no-rj", "message": "Hello Joq! Just dropping in. Have a good stream. "}]
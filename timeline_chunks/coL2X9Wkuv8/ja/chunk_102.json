[{"type": "subtitle", "time": 6131.229, "timestamp": "01:42:11", "text": "目をかお前"}, {"type": "subtitle", "time": 6141.95, "timestamp": "01:42:21", "text": "プレゼントとは"}, {"type": "subtitle", "time": 6145.629, "timestamp": "01:42:25", "text": "一体何でしょうか?"}, {"type": "subtitle", "time": 6150.03, "timestamp": "01:42:30", "text": "要するに価格が書かれていない商品のこと"}, {"type": "subtitle", "time": 6154.43, "timestamp": "01:42:34", "text": "だ。それがあればルールを守るいい子に"}, {"type": "subtitle", "time": 6157.91, "timestamp": "01:42:37", "text": "なれるだろう。"}, {"type": "subtitle", "time": 6176.35, "timestamp": "01:42:56", "text": "Thisissodepressing"}]
[{"type": "subtitle", "time": 4262.83, "timestamp": "01:11:02", "text": "しぐリカとナスター社の人生は変わる。"}, {"type": "subtitle", "time": 4266.91, "timestamp": "01:11:06", "text": "2人は大事な友達を失うの。"}, {"type": "subtitle", "time": 4270.59, "timestamp": "01:11:10", "text": "いずれ立ち直るかもしれないけど、"}, {"type": "subtitle", "time": 4283.91, "timestamp": "01:11:23", "text": "生きて"}, {"type": "subtitle", "time": 4293.189, "timestamp": "01:11:33", "text": "私には分からない。"}, {"type": "subtitle", "time": 4294.95, "timestamp": "01:11:34", "text": "でも"}, {"type": "subtitle", "time": 4298.39, "timestamp": "01:11:38", "text": "私はリナシータであなたとよく似た人たち"}, {"type": "subtitle", "time": 4302.03, "timestamp": "01:11:42", "text": "に出会ったことがある。作られた命の"}, {"type": "subtitle", "time": 4306.11, "timestamp": "01:11:46", "text": "道乗りで幸福は一瞬で過ぎ去る存在に過ぎ"}, {"type": "subtitle", "time": 4308.43, "timestamp": "01:11:48", "text": "なかった。"}, {"type": "subtitle", "time": 4313.75, "timestamp": "01:11:53", "text": "普通と恐怖だけがいつまでも残り続ける。"}, {"type": "subtitle", "time": 4315.47, "timestamp": "01:11:55", "text": "でも"}, {"type": "subtitle", "time": 4318.51, "timestamp": "01:11:58", "text": "最後の最後になって"}]
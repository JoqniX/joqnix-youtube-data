[{"type": "subtitle", "time": 3731.109, "timestamp": "01:02:11", "text": "でもな治るならここを出る必要はないです"}, {"type": "subtitle", "time": 3734.15, "timestamp": "01:02:14", "text": "よね。スペーストレックコレクティブの"}, {"type": "subtitle", "time": 3736.67, "timestamp": "01:02:16", "text": "技術があれば"}, {"type": "subtitle", "time": 3740.19, "timestamp": "01:02:20", "text": "そうね。でもコレクティブから言われ"}, {"type": "subtitle", "time": 3743.95, "timestamp": "01:02:23", "text": "ちゃった。これ以上ここにいていい体じゃ"}, {"type": "subtitle", "time": 3746.15, "timestamp": "01:02:26", "text": "ないって。"}, {"type": "subtitle", "time": 3779.069, "timestamp": "01:02:59", "text": "確かにそんなことも言ってたよ。でもね、"}]
[{"type": "subtitle", "time": 7021.43, "timestamp": "01:57:01", "text": "脅迫者さんの生き方はあまりあなたは皆"}, {"type": "subtitle", "time": 7026.03, "timestamp": "01:57:06", "text": "さんから脅迫者と呼ばれているのに"}, {"type": "subtitle", "time": 7030.069, "timestamp": "01:57:10", "text": "自分がどこから来てどこへ表していくのか"}, {"type": "subtitle", "time": 7033.55, "timestamp": "01:57:13", "text": "分かってませんよね。"}, {"type": "subtitle", "time": 7039.069, "timestamp": "01:57:19", "text": "たえ理想をところで組織長の言葉の意味は"}, {"type": "subtitle", "time": 7041.43, "timestamp": "01:57:21", "text": "よくわかってないです。アレフ1"}, {"type": "subtitle", "time": 7049.149, "timestamp": "01:57:29", "text": "もう"}, {"type": "subtitle", "time": 7051.27, "timestamp": "01:57:31", "text": "せめただ"}, {"type": "subtitle", "time": 7067.55, "timestamp": "01:57:47", "text": "どう説明しまし。"}, {"type": "subtitle", "time": 7074.43, "timestamp": "01:57:54", "text": "あ、うん。"}]
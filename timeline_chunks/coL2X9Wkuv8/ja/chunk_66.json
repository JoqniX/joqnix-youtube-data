[{"type": "subtitle", "time": 3962.95, "timestamp": "01:06:02", "text": "だって"}, {"type": "subtitle", "time": 3967.029, "timestamp": "01:06:07", "text": "皆さん言ってるじゃないですか。"}, {"type": "subtitle", "time": 3969.15, "timestamp": "01:06:09", "text": "誕生日は"}, {"type": "subtitle", "time": 3973.789, "timestamp": "01:06:13", "text": "人が生まれてきた証。"}, {"type": "subtitle", "time": 3977.75, "timestamp": "01:06:17", "text": "誰もが誕生日を持ってるんですよ。"}, {"type": "subtitle", "time": 4007.91, "timestamp": "01:06:47", "text": "あるのは"}, {"type": "subtitle", "time": 4012.309, "timestamp": "01:06:52", "text": "忘れたくても忘れられない映像だけ。"}, {"type": "subtitle", "time": 4017.269, "timestamp": "01:06:57", "text": "何度も何度も夢の中で繰り返し再生される"}]
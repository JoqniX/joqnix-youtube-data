[{"type": "subtitle", "time": 3634.43, "timestamp": "01:00:34", "text": "本当ですか?そう言われると余計心配に"}, {"type": "subtitle", "time": 3645.43, "timestamp": "01:00:45", "text": "ええ、ダーニャさんが入学して最初の週に"}, {"type": "subtitle", "time": 3647.71, "timestamp": "01:00:47", "text": "ここでい眠りをしていた時からの付き合い"}, {"type": "subtitle", "time": 3650.39, "timestamp": "01:00:50", "text": "なんです。"}, {"type": "subtitle", "time": 3651.829, "timestamp": "01:00:51", "text": "私がボイドスタ。[音楽]"}]
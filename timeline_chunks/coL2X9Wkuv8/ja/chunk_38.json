[{"type": "subtitle", "time": 2280.27, "timestamp": "00:38:00", "text": "まさか"}, {"type": "subtitle", "time": 2283.79, "timestamp": "00:38:03", "text": "数日間治ってないふりをしてただけですよ"}, {"type": "subtitle", "time": 2289.349, "timestamp": "00:38:09", "text": "。すぐ授業に戻りたくないですし。"}, {"type": "subtitle", "time": 2293.119, "timestamp": "00:38:13", "text": "C しちゃん大丈夫ですから。公園で白い鳥を取りたい。分かった。先輩もついてきてね。あのね、にやちゃん、最近撮影同行会がスタジオを申請しようとしてるみたいなの。"}, {"type": "subtitle", "time": 2317.589, "timestamp": "00:38:37", "text": "まだ経費が余ってるんですか?"}, {"type": "subtitle", "time": 2322.069, "timestamp": "00:38:42", "text": "まさかこの間の学園のイベントで取った賞"}, {"type": "subtitle", "time": 2325.71, "timestamp": "00:38:45", "text": "で。そうだよ。みんなニやちゃんにすごく"}]
[{"type": "subtitle", "time": 4021.349, "timestamp": "01:07:01", "text": ".  I'm"}, {"type": "subtitle", "time": 4026.549, "timestamp": "01:07:06", "text": "always there, stepping into the same lake."}, {"type": "subtitle", "time": 4029.549, "timestamp": "01:07:09", "text": "A woman was"}, {"type": "subtitle", "time": 4035.069, "timestamp": "01:07:15", "text": "crying, her arms swaying in the wind."}, {"type": "subtitle", "time": 4040.23, "timestamp": "01:07:20", "text": "She always watches me from afar,"}, {"type": "subtitle", "time": 4062.029, "timestamp": "01:07:42", "text": "name and a birthday like this, don't you"}]
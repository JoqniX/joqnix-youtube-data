[{"type": "subtitle", "time": 3962.95, "timestamp": "01:06:02", "text": "因為"}, {"type": "subtitle", "time": 3967.029, "timestamp": "01:06:07", "text": "大家都這麼說，不是嗎？"}, {"type": "subtitle", "time": 3969.15, "timestamp": "01:06:09", "text": "生日"}, {"type": "subtitle", "time": 3973.789, "timestamp": "01:06:13", "text": "證明一個人出生的證據。"}, {"type": "subtitle", "time": 3977.75, "timestamp": "01:06:17", "text": "每個人都有生日。"}, {"type": "subtitle", "time": 4007.91, "timestamp": "01:06:47", "text": "存在的是"}, {"type": "subtitle", "time": 4012.309, "timestamp": "01:06:52", "text": "只有那些即使你想忘記也無法忘記的畫面。"}, {"type": "subtitle", "time": 4017.269, "timestamp": "01:06:57", "text": "它在我的夢裡一遍又一遍地播放"}]
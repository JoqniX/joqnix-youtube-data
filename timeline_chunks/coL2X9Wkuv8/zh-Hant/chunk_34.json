[{"type": "subtitle", "time": 2044.11, "timestamp": "00:34:04", "text": "現在想想，週末的時候周圍人好像比平常少。"}, {"type": "subtitle", "time": 2048.069, "timestamp": "00:34:08", "text": "大家都躲起來了，因為他們知道我要來了。"}, {"type": "subtitle", "time": 2057.95, "timestamp": "00:34:17", "text": "那份沉默是帝王的象徵嗎？請給予一些安慰。"}, {"type": "subtitle", "time": 2061.31, "timestamp": "00:34:21", "text": "我以為你會把它給我。"}, {"type": "subtitle", "time": 2065.27, "timestamp": "00:34:25", "text": "集體規章制度負責保障學校安全。"}, {"type": "subtitle", "time": 2086.149, "timestamp": "00:34:46", "text": "如果我們在這裡下車，就到花園區了，對吧？"}, {"type": "subtitle", "time": 2090.19, "timestamp": "00:34:50", "text": "前兩個"}]
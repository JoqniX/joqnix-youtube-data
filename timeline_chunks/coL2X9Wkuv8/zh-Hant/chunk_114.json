[{"type": "subtitle", "time": 6847.87, "timestamp": "01:54:07", "text": "但"}, {"type": "subtitle", "time": 6850.75, "timestamp": "01:54:10", "text": "那種結局只適合志久里香醬。"}, {"type": "subtitle", "time": 6854.27, "timestamp": "01:54:14", "text": "讓我們救出娜斯塔珊和所有人。"}, {"type": "subtitle", "time": 6857.99, "timestamp": "01:54:17", "text": "致你們這些"}, {"type": "subtitle", "time": 6860.95, "timestamp": "01:54:20", "text": "這意味著什麼？"}, {"type": "subtitle", "time": 6864.189, "timestamp": "01:54:24", "text": "那個視你為最強對手的組織"}, {"type": "subtitle", "time": 6866.31, "timestamp": "01:54:26", "text": "對於領導者而言"}, {"type": "subtitle", "time": 6880.189, "timestamp": "01:54:40", "text": "因為這意味著你最終可能會走上和她一樣的道路。但如果你真的把那張紙拿出來，它在收到它被呼喚的內容後就會發狂。"}]
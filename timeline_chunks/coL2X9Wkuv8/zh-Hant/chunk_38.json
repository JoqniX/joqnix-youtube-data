[{"type": "subtitle", "time": 2280.27, "timestamp": "00:38:00", "text": "決不"}, {"type": "subtitle", "time": 2283.79, "timestamp": "00:38:03", "text": "我只是假裝傷口還沒癒合好幾天而已。"}, {"type": "subtitle", "time": 2289.349, "timestamp": "00:38:09", "text": "。我不想馬上回教室。"}, {"type": "subtitle", "time": 2293.119, "timestamp": "00:38:13", "text": "C Shichan會沒事的。我想在公園裡捉一隻白鳥。我明白。前輩，你也一起來吧。嘿，妮雅醬，好像拍攝支援小組最近正在申請攝影棚執照。"}, {"type": "subtitle", "time": 2317.589, "timestamp": "00:38:37", "text": "你還有剩餘資金嗎？"}, {"type": "subtitle", "time": 2322.069, "timestamp": "00:38:42", "text": "我做夢也沒想到前幾天在學校活動上會獲獎。"}, {"type": "subtitle", "time": 2325.71, "timestamp": "00:38:45", "text": "沒錯。大家都很喜歡妮雅醬"}]
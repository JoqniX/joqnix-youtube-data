[{"type": "subtitle", "time": 4086.95, "timestamp": "01:08:06", "text": "因為"}, {"type": "subtitle", "time": 4096.95, "timestamp": "01:08:16", "text": "來不及做任何事。"}, {"type": "subtitle", "time": 4099.709, "timestamp": "01:08:19", "text": "儘管如此"}, {"type": "subtitle", "time": 4102.749, "timestamp": "01:08:22", "text": "我想選擇有尊嚴的死亡方式。"}, {"type": "subtitle", "time": 4104.6, "timestamp": "01:08:24", "text": "。 至少"}, {"type": "subtitle", "time": 4106.6, "timestamp": "01:08:26", "text": "至少 像人類一樣"}, {"type": "subtitle", "time": 4109.08, "timestamp": "01:08:29", "text": "像人類一樣 承擔責任"}, {"type": "subtitle", "time": 4112.04, "timestamp": "01:08:32", "text": "承擔責任 好好道別之後"}, {"type": "subtitle", "time": 4115.679, "timestamp": "01:08:35", "text": "好好道別之後 我曾想過自殺。"}, {"type": "subtitle", "time": 4124.59, "timestamp": "01:08:44", "text": "但這真令人遺憾。"}, {"type": "subtitle", "time": 4128.47, "timestamp": "01:08:48", "text": "我選了個這麼好的日子，但…"}, {"type": "subtitle", "time": 4132.309, "timestamp": "01:08:52", "text": "我該如何道別？"}, {"type": "subtitle", "time": 4136.749, "timestamp": "01:08:56", "text": "我完全沒聽懂。"}, {"type": "subtitle", "time": 4139.669, "timestamp": "01:08:59", "text": "我擅長的是"}]
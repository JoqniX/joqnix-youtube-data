[{"type": "subtitle", "time": 4021.349, "timestamp": "01:07:01", "text": "。我在那邊。"}, {"type": "subtitle", "time": 4026.549, "timestamp": "01:07:06", "text": "我總是發現自己一次又一次地踏入同一個湖泊。"}, {"type": "subtitle", "time": 4029.549, "timestamp": "01:07:09", "text": "一名女子"}, {"type": "subtitle", "time": 4035.069, "timestamp": "01:07:15", "text": "我哭了，雙臂在風中揮舞。"}, {"type": "subtitle", "time": 4040.23, "timestamp": "01:07:20", "text": "她總是遠遠地看著我。"}, {"type": "subtitle", "time": 4042.67, "timestamp": "01:07:22", "text": "坦婭"}, {"type": "subtitle", "time": 4057.51, "timestamp": "01:07:37", "text": "這就是原因"}, {"type": "subtitle", "time": 4062.029, "timestamp": "01:07:42", "text": "一旦你知道了姓名和生日"}, {"type": "subtitle", "time": 4064.75, "timestamp": "01:07:44", "text": "作為一個人"}]
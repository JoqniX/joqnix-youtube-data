[{"type": "subtitle", "time": 2266.309, "timestamp": "00:37:46", "text": "哦，你最近又開始做惡夢了嗎？"}, {"type": "subtitle", "time": 2268.99, "timestamp": "00:37:48", "text": "我聽說很多人都受到了這起事件的影響。"}, {"type": "subtitle", "time": 2271.069, "timestamp": "00:37:51", "text": "但，"}, {"type": "subtitle", "time": 2274.069, "timestamp": "00:37:54", "text": "丹雅也被虛空物質吞噬了。"}]
[{"type": "subtitle", "time": 2467.75, "timestamp": "00:41:07", "text": "我要3個。"}, {"type": "subtitle", "time": 2483.829, "timestamp": "00:41:23", "text": "已將照片儲存到勒索者的裝置上。"}, {"type": "subtitle", "time": 2488.27, "timestamp": "00:41:28", "text": "咦，照片裡有一隻幽靈般的白鳥。"}, {"type": "subtitle", "time": 2501.91, "timestamp": "00:41:41", "text": "未經證實"}, {"type": "subtitle", "time": 2505.27, "timestamp": "00:41:45", "text": "一隻純白的鳥兒問道"}, {"type": "subtitle", "time": 2509.19, "timestamp": "00:41:49", "text": "距離我第一次目睹爆炸已經過去一年了，而且我只近距離看過一次。"}, {"type": "subtitle", "time": 2511.99, "timestamp": "00:41:51", "text": "我也沒能觀察到這種情況。"}, {"type": "subtitle", "time": 2517.03, "timestamp": "00:41:57", "text": "請冷靜下來。某人的共鳴能力和"}]
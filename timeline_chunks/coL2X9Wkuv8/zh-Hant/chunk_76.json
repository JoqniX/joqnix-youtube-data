[{"type": "subtitle", "time": 4562.709, "timestamp": "01:16:02", "text": "勒索者觀察到頻率出現劇烈波動。"}, {"type": "subtitle", "time": 4566.03, "timestamp": "01:16:06", "text": "我做了。你們兩個都還好嗎？"}, {"type": "subtitle", "time": 4568.27, "timestamp": "01:16:08", "text": "沒關係。"}, {"type": "subtitle", "time": 4569.35, "timestamp": "01:16:09", "text": "我懂了。"}, {"type": "subtitle", "time": 4593.35, "timestamp": "01:16:33", "text": "那樣就浪費蛋糕了。今天"}, {"type": "subtitle", "time": 4606.002, "timestamp": "01:16:46", "text": "那有點麻煩。因為"}, {"type": "subtitle", "time": 4607.313, "timestamp": "01:16:47", "text": "[哭]"}, {"type": "subtitle", "time": 4608.43, "timestamp": "01:16:48", "text": "[嗤笑]"}, {"type": "subtitle", "time": 4610.47, "timestamp": "01:16:50", "text": "今天"}]
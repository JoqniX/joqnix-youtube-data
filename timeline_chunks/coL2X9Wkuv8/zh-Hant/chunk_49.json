[{"type": "subtitle", "time": 2956.27, "timestamp": "00:49:16", "text": "在這種時候，你的洞察力出乎意料地敏銳。"}, {"type": "subtitle", "time": 2966.19, "timestamp": "00:49:26", "text": "如果丹雅不想讓我聽到，那我之前已經說過很多次了。"}, {"type": "subtitle", "time": 2969.349, "timestamp": "00:49:29", "text": "我也要這樣做。"}, {"type": "subtitle", "time": 2971.349, "timestamp": "00:49:31", "text": "但"}, {"type": "subtitle", "time": 2974.67, "timestamp": "00:49:34", "text": "我只想問你一件事。"}, {"type": "subtitle", "time": 2978.39, "timestamp": "00:49:38", "text": "丹妮婭明年將再次慶祝她的生日。"}]
[{"type": "subtitle", "time": 3423.47, "timestamp": "00:57:03", "text": "如果你讓他們更生氣，我就消失。"}, {"type": "subtitle", "time": 3434.109, "timestamp": "00:57:14", "text": "我寧願我現在的這些朋友死去"}, {"type": "subtitle", "time": 3450.349, "timestamp": "00:57:30", "text": "你本來可以逃離這種情況，但你卻承擔了所有重擔。"}, {"type": "subtitle", "time": 3452.51, "timestamp": "00:57:32", "text": "在"}, {"type": "subtitle", "time": 3457.029, "timestamp": "00:57:37", "text": "我不喜歡那種生活方式。儘管如此"}]
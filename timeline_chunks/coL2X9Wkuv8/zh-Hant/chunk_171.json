[{"type": "subtitle", "time": 10266.71, "timestamp": "02:51:06", "text": "我的聲音是我只是"}, {"type": "subtitle", "time": 10269.07, "timestamp": "02:51:09", "text": "和他們親近"}, {"type": "subtitle", "time": 10274.03, "timestamp": "02:51:14", "text": "我們正在開放"}, {"type": "subtitle", "time": 10284.63, "timestamp": "02:51:24", "text": "我懂了。所以"}, {"type": "subtitle", "time": 10289.51, "timestamp": "02:51:29", "text": "繩子"}, {"type": "subtitle", "time": 10294.99, "timestamp": "02:51:34", "text": "到本週末"}]
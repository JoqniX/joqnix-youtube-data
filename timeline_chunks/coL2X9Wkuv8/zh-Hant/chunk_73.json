[{"type": "subtitle", "time": 4384.11, "timestamp": "01:13:04", "text": "我也有同感。"}, {"type": "subtitle", "time": 4389.709, "timestamp": "01:13:09", "text": "所以，如果人類與增長教會之間的關係是模糊的…"}, {"type": "subtitle", "time": 4392.669, "timestamp": "01:13:12", "text": "決定我們是人還是物體的因素是什麼？"}, {"type": "subtitle", "time": 4400.79, "timestamp": "01:13:20", "text": "為我"}, {"type": "subtitle", "time": 4408.149, "timestamp": "01:13:28", "text": "是心臟。丹雅"}, {"type": "subtitle", "time": 4413.39, "timestamp": "01:13:33", "text": "定義一個人的不是執念，而是自己的內心。"}, {"type": "chat", "time": 4413.424, "timestamp": "01:13:33", "author": "@Clemdawg2k", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lm3b4NzP8EJSErqfdjskWyeLX6VULSKl-arEmGx3EgLtc=s64-c-k-c0x00ffffff-no-rj", "message": "Hello Joq! Just dropping in. Have a good stream. "}]
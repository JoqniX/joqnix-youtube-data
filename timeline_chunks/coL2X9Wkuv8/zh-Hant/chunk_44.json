[{"type": "subtitle", "time": 2643.23, "timestamp": "00:44:03", "text": "我認為我們當時正朝著這個方向前進。"}, {"type": "subtitle", "time": 2688.589, "timestamp": "00:44:48", "text": "我不擅長打架。"}, {"type": "subtitle", "time": 2691.19, "timestamp": "00:44:51", "text": "仔細想想，伊伊醬，確實如此。"}, {"type": "subtitle", "time": 2693.829, "timestamp": "00:44:53", "text": "我得盡快打電話給家人。"}]
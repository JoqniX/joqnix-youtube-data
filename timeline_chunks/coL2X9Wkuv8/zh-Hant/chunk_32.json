[{"type": "subtitle", "time": 1943.23, "timestamp": "00:32:23", "text": "你會陪我過生日，對嗎？"}, {"type": "subtitle", "time": 1960.149, "timestamp": "00:32:40", "text": "沒錯，但他總是看起來很悶悶不樂。"}, {"type": "subtitle", "time": 1963.71, "timestamp": "00:32:43", "text": "我總不能露面吧？"}, {"type": "subtitle", "time": 1974.99, "timestamp": "00:32:54", "text": "我同意。"}]
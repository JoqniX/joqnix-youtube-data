[{"type": "subtitle", "time": 4957.79, "timestamp": "01:22:37", "text": "丹雅說我們必須這麼做。"}, {"type": "subtitle", "time": 4959.95, "timestamp": "01:22:39", "text": "什麼"}, {"type": "subtitle", "time": 4963.55, "timestamp": "01:22:43", "text": "或許迪馬普倫家族的名字就來自於此。"}, {"type": "subtitle", "time": 4970.39, "timestamp": "01:22:50", "text": "組織領導的任務是找到丹雅。"}, {"type": "subtitle", "time": 4973.43, "timestamp": "01:22:53", "text": "如果這是計劃的一部分"}]
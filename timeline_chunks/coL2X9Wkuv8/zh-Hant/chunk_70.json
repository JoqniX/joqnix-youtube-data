[{"type": "subtitle", "time": 4204.87, "timestamp": "01:10:04", "text": "正當我以為一切都會消失，我會回歸虛無的時候"}, {"type": "subtitle", "time": 4214.308, "timestamp": "01:10:14", "text": "多年"}, {"type": "subtitle", "time": 4215.189, "timestamp": "01:10:15", "text": "[嗤笑]"}, {"type": "subtitle", "time": 4218.95, "timestamp": "01:10:18", "text": "從我第一次接觸它那天起"}, {"type": "subtitle", "time": 4226.098, "timestamp": "01:10:26", "text": "即使你死了，明天的太陽也不會改變。"}, {"type": "subtitle", "time": 4229.79, "timestamp": "01:10:29", "text": "[音樂] 它會攀升。"}, {"type": "subtitle", "time": 4233.47, "timestamp": "01:10:33", "text": "我明白這一點。"}, {"type": "subtitle", "time": 4235.99, "timestamp": "01:10:35", "text": "這個世界"}, {"type": "subtitle", "time": 4240.189, "timestamp": "01:10:40", "text": "我的死也不會改變任何事。"}]
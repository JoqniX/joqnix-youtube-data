[{"type": "subtitle", "time": 3634.43, "timestamp": "01:00:34", "text": "真的嗎？這讓我更加擔心了。"}, {"type": "subtitle", "time": 3645.43, "timestamp": "01:00:45", "text": "是的，那是丹妮亞開學的第一週。"}, {"type": "subtitle", "time": 3647.71, "timestamp": "01:00:47", "text": "自從我以前住在這裡的時候，我們就認識了。"}, {"type": "subtitle", "time": 3650.39, "timestamp": "01:00:50", "text": "就是這樣。"}, {"type": "subtitle", "time": 3651.829, "timestamp": "01:00:51", "text": "我是博伊德斯塔。 [音樂]"}]
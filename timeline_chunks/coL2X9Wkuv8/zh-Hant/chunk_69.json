[{"type": "subtitle", "time": 4146.95, "timestamp": "01:09:06", "text": "他們只會說謊。"}, {"type": "subtitle", "time": 4178.709, "timestamp": "01:09:38", "text": "這會有一些幫助。"}, {"type": "subtitle", "time": 4194.47, "timestamp": "01:09:54", "text": "這是"}, {"type": "subtitle", "time": 4198.43, "timestamp": "01:09:58", "text": "這只是倒影。"}]
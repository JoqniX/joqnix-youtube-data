[{"type": "subtitle", "time": 856.91, "timestamp": "00:14:16", "text": "德雷真是"}, {"type": "subtitle", "time": 876.99, "timestamp": "00:14:36", "text": "各項生命徵象持續改善。"}, {"type": "subtitle", "time": 880.949, "timestamp": "00:14:40", "text": "其活動未發現異常。超過目標頻率"}, {"type": "subtitle", "time": 883.31, "timestamp": "00:14:43", "text": "我還沒恢復過來。第二"}, {"type": "subtitle", "time": 884.829, "timestamp": "00:14:44", "text": "我們將執行該計劃。"}, {"type": "subtitle", "time": 891.629, "timestamp": "00:14:51", "text": "丹妮婭，你聽得到我說話嗎？"}]
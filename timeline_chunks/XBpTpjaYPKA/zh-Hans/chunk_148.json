[{"type": "subtitle", "time": 8882.55, "timestamp": "02:28:02", "text": "我搬去日本的事，我"}, {"type": "subtitle", "time": 8885.27, "timestamp": "02:28:05", "text": "想。最后一个视频。"}, {"type": "subtitle", "time": 8888.55, "timestamp": "02:28:08", "text": "我录了我家。"}, {"type": "subtitle", "time": 8890.389, "timestamp": "02:28:10", "text": "但你知道吗？说实话，"}, {"type": "subtitle", "time": 8892.23, "timestamp": "02:28:12", "text": "不。"}, {"type": "subtitle", "time": 8896.87, "timestamp": "02:28:16", "text": "我觉得我唯一后悔的就是"}, {"type": "subtitle", "time": 8900.95, "timestamp": "02:28:20", "text": "公开"}, {"type": "subtitle", "time": 8906.15, "timestamp": "02:28:26", "text": "宣布我要去"}, {"type": "subtitle", "time": 8911.03, "timestamp": "02:28:31", "text": "日本，对吧？"}, {"type": "subtitle", "time": 8915.51, "timestamp": "02:28:35", "text": "我想如果我能回到过去"}, {"type": "subtitle", "time": 8918.23, "timestamp": "02:28:38", "text": "，我真的会"}, {"type": "subtitle", "time": 8922.07, "timestamp": "02:28:42", "text": "责备自己，而不是……"}, {"type": "subtitle", "time": 8924.55, "timestamp": "02:28:44", "text": "提醒自己不要……你不需要"}, {"type": "subtitle", "time": 8928.07, "timestamp": "02:28:48", "text": "公开一些事情"}, {"type": "subtitle", "time": 8931.27, "timestamp": "02:28:51", "text": "，对吧？是啊。我觉得这是"}, {"type": "subtitle", "time": 8934.15, "timestamp": "02:28:54", "text": "我唯一后悔的事。"}, {"type": "subtitle", "time": 8937.03, "timestamp": "02:28:57", "text": "呃，除此之外，一切都好。"}, {"type": "subtitle", "time": 8938.95, "timestamp": "02:28:58", "text": "通常来说，这有"}]
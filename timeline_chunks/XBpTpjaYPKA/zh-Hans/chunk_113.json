[{"type": "subtitle", "time": 6780.79, "timestamp": "01:53:00", "text": "直播的。   已经过去"}, {"type": "subtitle", "time": 6786.39, "timestamp": "01:53:06", "text": "一段时间了。   是"}, {"type": "subtitle", "time": 6798.07, "timestamp": "01:53:18", "text": "我想保持活跃，但是"}, {"type": "subtitle", "time": 6805.03, "timestamp": "01:53:25", "text": "因为最近我都没怎么"}, {"type": "subtitle", "time": 6809.03, "timestamp": "01:53:29", "text": "玩电子游戏。我发现我"}, {"type": "subtitle", "time": 6811.91, "timestamp": "01:53:31", "text": "不再玩《弧光突袭者》了。"}, {"type": "subtitle", "time": 6817.91, "timestamp": "01:53:37", "text": "我错过了我的"}, {"type": "subtitle", "time": 6819.83, "timestamp": "01:53:39", "text": "第二次远征，我本来应该完成的。"}, {"type": "subtitle", "time": 6822.79, "timestamp": "01:53:42", "text": "我不知道发生了什么，但是"}, {"type": "subtitle", "time": 6825.189, "timestamp": "01:53:45", "text": "马拉松服务器崩溃的时候出来了，"}, {"type": "subtitle", "time": 6827.27, "timestamp": "01:53:47", "text": "对吧？ 马拉松，一款由 Bungie 开发的游戏。"}, {"type": "subtitle", "time": 6831.109, "timestamp": "01:53:51", "text": "我的天啊，我还玩了一会儿，"}, {"type": "subtitle", "time": 6834.229, "timestamp": "01:53:54", "text": "然后它就关门了。 明天"}, {"type": "subtitle", "time": 6835.83, "timestamp": "01:53:55", "text": "马拉松就要上映了，对吧？ 是"}, {"type": "subtitle", "time": 6837.75, "timestamp": "01:53:57", "text": "2400。"}]
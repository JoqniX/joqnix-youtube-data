[{"type": "subtitle", "time": 10921.59, "timestamp": "03:02:01", "text": "呃，明天我们直播，"}, {"type": "subtitle", "time": 10927.83, "timestamp": "03:02:07", "text": "不会是游戏直播。"}, {"type": "subtitle", "time": 10931.429, "timestamp": "03:02:11", "text": "大概会是像这样的聊天直播，或者"}, {"type": "subtitle", "time": 10935.03, "timestamp": "03:02:15", "text": "稳定的直播，或者像“跟我一起工作”的"}, {"type": "subtitle", "time": 10938.55, "timestamp": "03:02:18", "text": "直播。也许我会一边在后台工作，一边"}, {"type": "subtitle", "time": 10945.83, "timestamp": "03:02:25", "text": "滔滔不绝地讲解"}, {"type": "subtitle", "time": 10948.87, "timestamp": "03:02:28", "text": "我正在做的事情。呃，也许我不会"}, {"type": "subtitle", "time": 10951.83, "timestamp": "03:02:31", "text": "在屏幕上展示，因为太技术性也太"}, {"type": "subtitle", "time": 10955.67, "timestamp": "03:02:35", "text": "无聊了。我就只会唠叨。呃，你只会"}, {"type": "subtitle", "time": 10957.91, "timestamp": "03:02:37", "text": "看到…… 大概是低保真音乐和这个"}, {"type": "subtitle", "time": 10960.55, "timestamp": "03:02:40", "text": "背景吧。"}, {"type": "subtitle", "time": 10964.79, "timestamp": "03:02:44", "text": "嗯，是的。而且，我可能"}, {"type": "subtitle", "time": 10967.269, "timestamp": "03:02:47", "text": "好久没练唱歌之类的了"}, {"type": "subtitle", "time": 10970.87, "timestamp": "03:02:50", "text": "。所以，也许哪天"}, {"type": "subtitle", "time": 10974.07, "timestamp": "03:02:54", "text": "我会练练。天哪，我"}, {"type": "subtitle", "time": 10977.03, "timestamp": "03:02:57", "text": "唱歌真难听，但我还是会学的"}]
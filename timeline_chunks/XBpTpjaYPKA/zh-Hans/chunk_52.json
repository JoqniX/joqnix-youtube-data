[{"type": "subtitle", "time": 3120.95, "timestamp": "00:52:00", "text": "终于做好了发票。"}, {"type": "subtitle", "time": 3124.39, "timestamp": "00:52:04", "text": "所以它会生成发票模板。 所以我"}, {"type": "subtitle", "time": 3132.39, "timestamp": "00:52:12", "text": "现在可以直接复制粘贴到PDF编辑器里。是的。是的。我"}, {"type": "subtitle", "time": 3135.349, "timestamp": "00:52:15", "text": "可以轻松地做一些修改，然后"}, {"type": "subtitle", "time": 3138.87, "timestamp": "00:52:18", "text": "轻松地把它密封起来，交给"}, {"type": "subtitle", "time": 3142.309, "timestamp": "00:52:22", "text": "银行，这样他们就可以批准我待处理的"}, {"type": "subtitle", "time": 3144.47, "timestamp": "00:52:24", "text": "款项了。"}, {"type": "subtitle", "time": 3148.549, "timestamp": "00:52:28", "text": "是的，我很久以前就这么做了。"}, {"type": "subtitle", "time": 3150.95, "timestamp": "00:52:30", "text": "我突然觉得这太蠢了"}, {"type": "subtitle", "time": 3153.349, "timestamp": "00:52:33", "text": "。为什么我明明"}, {"type": "subtitle", "time": 3156.309, "timestamp": "00:52:36", "text": "是公司，还要自己开发票？"}, {"type": "subtitle", "time": 3159.03, "timestamp": "00:52:39", "text": "不过，哇。"}, {"type": "subtitle", "time": 3164.309, "timestamp": "00:52:44", "text": "所以，我得输入00001 00002。"}, {"type": "subtitle", "time": 3167.27, "timestamp": "00:52:47", "text": "酷。节目。是的。以后，如果"}, {"type": "subtitle", "time": 3169.75, "timestamp": "00:52:49", "text": "我们有周边产品之类的，我"}, {"type": "subtitle", "time": 3171.75, "timestamp": "00:52:51", "text": "会用这个发票系统给"}, {"type": "subtitle", "time": 3178.23, "timestamp": "00:52:58", "text": "购买周边产品的人生成发票。"}]
[{"type": "subtitle", "time": 2221.75, "timestamp": "00:37:01", "text": "一件事。 好的。"}, {"type": "subtitle", "time": 2223.829, "timestamp": "00:37:03", "text": "这就"}, {"type": "subtitle", "time": 2225.51, "timestamp": "00:37:05", "text": "好比，如果我要迁移到另一个"}, {"type": "subtitle", "time": 2228.069, "timestamp": "00:37:08", "text": "平台，那我花了"}, {"type": "subtitle", "time": 2232.55, "timestamp": "00:37:12", "text": "三四个月的时间把"}, {"type": "subtitle", "time": 2235.75, "timestamp": "00:37:15", "text": "我的 Discord 所有功能自动化，那我该怎么办？ 所以"}, {"type": "subtitle", "time": 2237.99, "timestamp": "00:37:17", "text": "当我直播的时候，它会自动帮"}, {"type": "subtitle", "time": 2240.069, "timestamp": "00:37:20", "text": "我完成所有事情。 当我不直播的时候，它会自动帮"}, {"type": "subtitle", "time": 2244.55, "timestamp": "00:37:24", "text": "我完成所有事情。 当"}, {"type": "subtitle", "time": 2247.27, "timestamp": "00:37:27", "text": "我更新网站时，"}, {"type": "subtitle", "time": 2249.27, "timestamp": "00:37:29", "text": "它会在后台为我做一些事情"}, {"type": "subtitle", "time": 2252.87, "timestamp": "00:37:32", "text": "。 给我收据，呃，"}, {"type": "subtitle", "time": 2255.589, "timestamp": "00:37:35", "text": "帮我制作收据，"}, {"type": "subtitle", "time": 2259.349, "timestamp": "00:37:39", "text": "呃，在任何付款等情况下"}, {"type": "subtitle", "time": 2261.589, "timestamp": "00:37:41", "text": "。  YouTube 评委，那些东西我"}, {"type": "subtitle", "time": 2265.75, "timestamp": "00:37:45", "text": "也做过。 把它连接到"}, {"type": "subtitle", "time": 2268.39, "timestamp": "00:37:48", "text": "这个私有服务器上的某个东西上。"}, {"type": "subtitle", "time": 2272.87, "timestamp": "00:37:52", "text": "为了能去那里，我做了很多事。"}]
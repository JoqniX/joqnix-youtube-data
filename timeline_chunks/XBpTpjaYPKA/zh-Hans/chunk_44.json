[{"type": "subtitle", "time": 2650.23, "timestamp": "00:44:10", "text": "所以，嗯，对于像"}, {"type": "subtitle", "time": 2653.03, "timestamp": "00:44:13", "text": "这种直播之类的直播，"}, {"type": "subtitle", "time": 2656.309, "timestamp": "00:44:16", "text": "我有很多应用程序，它们"}, {"type": "subtitle", "time": 2659.51, "timestamp": "00:44:19", "text": "在电脑上运行，但不是在我自己的电脑上运行，"}, {"type": "subtitle", "time": 2666.55, "timestamp": "00:44:26", "text": "所以它们可以自动运行一些东西。"}, {"type": "subtitle", "time": 2668.95, "timestamp": "00:44:28", "text": "所以我不知道他们需要做什么。"}, {"type": "subtitle", "time": 2670.71, "timestamp": "00:44:30", "text": "没有"}, {"type": "subtitle", "time": 2672.95, "timestamp": "00:44:32", "text": "自动化，"}, {"type": "subtitle", "time": 2681.349, "timestamp": "00:44:41", "text": "自动化。"}, {"type": "subtitle", "time": 2684.71, "timestamp": "00:44:44", "text": "嗨，呃，如果我下个月"}, {"type": "subtitle", "time": 2687.67, "timestamp": "00:44:47", "text": "离开，"}, {"type": "subtitle", "time": 2691.19, "timestamp": "00:44:51", "text": "我没有电脑，我不会把电脑"}, {"type": "subtitle", "time": 2696.63, "timestamp": "00:44:56", "text": "直接带到日本。 所以我把它迁移到了云端，实现了云"}]
[{"type": "subtitle", "time": 9003.429, "timestamp": "02:30:03", "text": "透露"}, {"type": "subtitle", "time": 9005.349, "timestamp": "02:30:05", "text": "，发个视频或者"}, {"type": "subtitle", "time": 9007.19, "timestamp": "02:30:07", "text": "公告什么的。“哦，我要搬去日本了。"}, {"type": "subtitle", "time": 9012.309, "timestamp": "02:30:12", "text": "拜拜。”然后就不会有人觉得"}, {"type": "subtitle", "time": 9013.99, "timestamp": "02:30:13", "text": "意外或"}, {"type": "subtitle", "time": 9016.71, "timestamp": "02:30:16", "text": "高兴了。对，就是这样。 但是如果我一直"}, {"type": "subtitle", "time": 9019.11, "timestamp": "02:30:19", "text": "说这个，说我的兴奋之"}, {"type": "subtitle", "time": 9023.11, "timestamp": "02:30:23", "text": "情，我的意思是，没关系。是"}, {"type": "subtitle", "time": 9026.23, "timestamp": "02:30:26", "text": "的，我有一些很好的"}, {"type": "subtitle", "time": 9028.389, "timestamp": "02:30:28", "text": "经历，也有一些不好的经历。所以"}, {"type": "subtitle", "time": 9036.07, "timestamp": "02:30:36", "text": "是的，你知道，你的网络隐私，你"}, {"type": "subtitle", "time": 9038.469, "timestamp": "02:30:38", "text": "必须小心对待。"}, {"type": "subtitle", "time": 9041.75, "timestamp": "02:30:41", "text": "我以前在这方面非常粗心，"}, {"type": "subtitle", "time": 9045.19, "timestamp": "02:30:45", "text": "我为此付出了惨痛的代价。是的"}, {"type": "subtitle", "time": 9047.11, "timestamp": "02:30:47", "text": "，兄弟。如果你这样做，你会"}, {"type": "subtitle", "time": 9049.91, "timestamp": "02:30:49", "text": "吃苦头的。"}, {"type": "subtitle", "time": 9057.349, "timestamp": "02:30:57", "text": "你把我当成好事。最好的读者。"}, {"type": "subtitle", "time": 9059.67, "timestamp": "02:30:59", "text": "我们新的最好的观众。"}]
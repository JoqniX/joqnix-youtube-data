[{"type": "subtitle", "time": 7861.109, "timestamp": "02:11:01", "text": "，我要感谢"}, {"type": "subtitle", "time": 7871.27, "timestamp": "02:11:11", "text": "这对我来说意义重大。 我没想到会"}, {"type": "subtitle", "time": 7874.55, "timestamp": "02:11:14", "text": "有人来，因为我觉得我已经"}, {"type": "subtitle", "time": 7877.91, "timestamp": "02:11:17", "text": "四五个星期没露面了，"}, {"type": "subtitle", "time": 7880.47, "timestamp": "02:11:20", "text": "可能大家都忘了。 他们或许"}, {"type": "subtitle", "time": 7882.709, "timestamp": "02:11:22", "text": "不会收到通知。"}, {"type": "subtitle", "time": 7886.39, "timestamp": "02:11:26", "text": "但我真的很感谢"}, {"type": "subtitle", "time": 7888.629, "timestamp": "02:11:28", "text": "你们今天过来和"}, {"type": "subtitle", "time": 7891.35, "timestamp": "02:11:31", "text": "我聊天。 这真的是发自"}, {"type": "subtitle", "time": 7894.39, "timestamp": "02:11:34", "text": "内心的，对我意义重大。 是的，"}, {"type": "subtitle", "time": 7900.47, "timestamp": "02:11:40", "text": "呃，等等，我刚才点击了苏罗特"}, {"type": "subtitle", "time": 7902.709, "timestamp": "02:11:42", "text": "表情。"}, {"type": "subtitle", "time": 7904.95, "timestamp": "02:11:44", "text": "呃，上面写着订阅即可获得"}, {"type": "subtitle", "time": 7908.87, "timestamp": "02:11:48", "text": "表情符号。 哦，那就像一个机器人发出“呃呃”的表情符号"}, {"type": "subtitle", "time": 7913.109, "timestamp": "02:11:53", "text": "。 不，对于在"}, {"type": "subtitle", "time": 7919.189, "timestamp": "02:11:59", "text": "Twitch 上使用表情符号的人来说，如果你看到"}]
[{"type": "subtitle", "time": 10201.349, "timestamp": "02:50:01", "text": "感谢"}, {"type": "subtitle", "time": 10205.11, "timestamp": "02:50:05", "text": "你给了我灵感。真的吗？是"}, {"type": "subtitle", "time": 10208.389, "timestamp": "02:50:08", "text": "啊。我希望自己也能像你一样充满热情，"}, {"type": "subtitle", "time": 10211.91, "timestamp": "02:50:11", "text": "投入到学习中，比如像你一样热爱"}, {"type": "subtitle", "time": 10214.469, "timestamp": "02:50:14", "text": "科技。不，我"}, {"type": "subtitle", "time": 10217.75, "timestamp": "02:50:17", "text": "希望我能把这种热情运用到音乐，"}, {"type": "subtitle", "time": 10220.07, "timestamp": "02:50:20", "text": "甚至是语言方面。 就像"}, {"type": "subtitle", "time": 10224.71, "timestamp": "02:50:24", "text": "说话一样，甚至唱歌也特别棒，"}, {"type": "subtitle", "time": 10231.99, "timestamp": "02:50:31", "text": "我真希望自己能这么投入。不，"}, {"type": "subtitle", "time": 10234.63, "timestamp": "02:50:34", "text": "尤其是音乐，伙计。音乐是"}, {"type": "subtitle", "time": 10237.59, "timestamp": "02:50:37", "text": "我儿时的梦想，但我"}, {"type": "subtitle", "time": 10242.79, "timestamp": "02:50:42", "text": "现在却什么都没做，一点儿跟音乐有关的事情都没有。"}, {"type": "subtitle", "time": 10245.83, "timestamp": "02:50:45", "text": "我总是想着，以后再说吧。是啊"}, {"type": "subtitle", "time": 10247.83, "timestamp": "02:50:47", "text": "，我现在也需要为音乐做点什么"}, {"type": "subtitle", "time": 10251.67, "timestamp": "02:50:51", "text": "。希望下个月能做到。"}, {"type": "subtitle", "time": 10255.59, "timestamp": "02:50:55", "text": "我会调整时间。"}, {"type": "subtitle", "time": 10259.11, "timestamp": "02:50:59", "text": "我主要会专注于音乐制作方面的"}]
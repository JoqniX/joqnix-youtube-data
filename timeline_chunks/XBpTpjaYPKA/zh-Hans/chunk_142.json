[{"type": "subtitle", "time": 8522.23, "timestamp": "02:22:02", "text": "时间之类的。 我记得高中时好像参加过"}, {"type": "subtitle", "time": 8525.99, "timestamp": "02:22:05", "text": "社团之类的。"}, {"type": "subtitle", "time": 8528.55, "timestamp": "02:22:08", "text": "现在可选的活动不多，比如国际象棋"}, {"type": "subtitle", "time": 8531.349, "timestamp": "02:22:11", "text": "俱乐部、音乐俱乐部，"}, {"type": "subtitle", "time": 8532.95, "timestamp": "02:22:12", "text": "嗯，"}, {"type": "subtitle", "time": 8534.55, "timestamp": "02:22:14", "text": "室内和室外的都有。 高中里有"}, {"type": "subtitle", "time": 8536.55, "timestamp": "02:22:16", "text": "足球俱乐部、篮球俱乐部、"}, {"type": "subtitle", "time": 8539.349, "timestamp": "02:22:19", "text": "乒乓球俱乐部、"}, {"type": "subtitle", "time": 8541.349, "timestamp": "02:22:21", "text": "排球俱乐部，各种各样的社团和组织"}, {"type": "subtitle", "time": 8544.87, "timestamp": "02:22:24", "text": "。 我记得这件事。"}, {"type": "subtitle", "time": 8547.83, "timestamp": "02:22:27", "text": "简直就像“我的天哪”一样。"}, {"type": "subtitle", "time": 8555.83, "timestamp": "02:22:35", "text": "兄弟。 太棒了！"}, {"type": "subtitle", "time": 8557.75, "timestamp": "02:22:37", "text": "我们必须努力工作，因为我们"}, {"type": "subtitle", "time": 8559.51, "timestamp": "02:22:39", "text": "所有的事情都是自己做的。 是的。 没错，没错，"}, {"type": "subtitle", "time": 8562.23, "timestamp": "02:22:42", "text": "没错。 是的，"}, {"type": "subtitle", "time": 8575.11, "timestamp": "02:22:55", "text": "听起来很有趣。 听起来真的很"}]
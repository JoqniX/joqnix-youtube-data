[{"type": "subtitle", "time": 4600.95, "timestamp": "01:16:40", "text": "我一直在想，bit是什么，bit又是什么，"}, {"type": "subtitle", "time": 4604.39, "timestamp": "01:16:44", "text": "为什么不呢？它显示一个bit要195卢比。"}, {"type": "subtitle", "time": 4607.27, "timestamp": "01:16:47", "text": "等等，什么？"}, {"type": "subtitle", "time": 4608.95, "timestamp": "01:16:48", "text": "等等，他们涨价了吗"}, {"type": "subtitle", "time": 4618.95, "timestamp": "01:16:58", "text": "等等，一个。不。一个，138卢比，400个"}]
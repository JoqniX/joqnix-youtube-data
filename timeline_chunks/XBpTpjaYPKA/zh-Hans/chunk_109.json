[{"type": "subtitle", "time": 6548.39, "timestamp": "01:49:08", "text": "我有一个富频道积分。"}, {"type": "subtitle", "time": 6549.99, "timestamp": "01:49:09", "text": "我应该怎么办？ 由你决定。 你可以"}, {"type": "subtitle", "time": 6552.79, "timestamp": "01:49:12", "text": "保存它之类的。 我没有那么"}, {"type": "subtitle", "time": 6556.229, "timestamp": "01:49:16", "text": "多……嗯……自动化的……"}, {"type": "subtitle", "time": 6559.03, "timestamp": "01:49:19", "text": "呃……该怎么称呼它呢？ 频道点之类的"}, {"type": "subtitle", "time": 6561.51, "timestamp": "01:49:21", "text": "东西，其他三个主播也有，对吧，比如"}, {"type": "subtitle", "time": 6564.149, "timestamp": "01:49:24", "text": "控制模型，"}, {"type": "subtitle", "time": 6567.109, "timestamp": "01:49:27", "text": "呃，它会做一些事情。 不，"}, {"type": "subtitle", "time": 6570.709, "timestamp": "01:49:30", "text": "我没有设置那些。"}, {"type": "subtitle", "time": 6574.47, "timestamp": "01:49:34", "text": "我将来想这样做。"}, {"type": "subtitle", "time": 6577.43, "timestamp": "01:49:37", "text": "只是我"}, {"type": "subtitle", "time": 6581.669, "timestamp": "01:49:41", "text": "的电脑配置必须尽可能简化。 即使把"}, {"type": "subtitle", "time": 6584.31, "timestamp": "01:49:44", "text": "一切都简化到极致，"}, {"type": "subtitle", "time": 6586.39, "timestamp": "01:49:46", "text": "我仍然感到很吃力。"}, {"type": "subtitle", "time": 6589.91, "timestamp": "01:49:49", "text": "我的电脑串流很吃力，因为后台"}, {"type": "subtitle", "time": 6595.27, "timestamp": "01:49:55", "text": "运行着太多应用程序来维持整个"}, {"type": "subtitle", "time": 6596.79, "timestamp": "01:49:56", "text": "串流过程。"}, {"type": "subtitle", "time": 6599.75, "timestamp": "01:49:59", "text": "所以，这太过分了。  Salia"}]
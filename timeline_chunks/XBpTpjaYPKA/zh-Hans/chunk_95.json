[{"type": "subtitle", "time": 5700.95, "timestamp": "01:35:00", "text": "Twitch 用户而设。 我没有忘记你。"}, {"type": "subtitle", "time": 5703.99, "timestamp": "01:35:03", "text": "所以我设置了"}, {"type": "subtitle", "time": 5707.43, "timestamp": "01:35:07", "text": "存档功能。 目前它记录了我的 24 小时"}, {"type": "subtitle", "time": 5711.59, "timestamp": "01:35:11", "text": "频道。 所以它会有一个数据列表，"}, {"type": "subtitle", "time": 5714.55, "timestamp": "01:35:14", "text": "比如元数据。 呃，直播是什么时候"}, {"type": "subtitle", "time": 5717.11, "timestamp": "01:35:17", "text": "开始的？缩略图频道，所有"}, {"type": "subtitle", "time": 5718.95, "timestamp": "01:35:18", "text": "这些东西，"}, {"type": "subtitle", "time": 5722.95, "timestamp": "01:35:22", "text": "还有，呃，我有聊天窗口。"}, {"type": "subtitle", "time": 5724.95, "timestamp": "01:35:24", "text": "所以 Twitch 上的所有人，甚至包括"}, {"type": "subtitle", "time": 5726.95, "timestamp": "01:35:26", "text": "机器人，频道积分等等，"}, {"type": "subtitle", "time": 5729.03, "timestamp": "01:35:29", "text": "可能都会在这里，"}, {"type": "subtitle", "time": 5731.75, "timestamp": "01:35:31", "text": "聊天记录也会标准化，这是网站的"}, {"type": "subtitle", "time": 5735.43, "timestamp": "01:35:35", "text": "可读版本。 所以用户会在这里。"}, {"type": "subtitle", "time": 5739.35, "timestamp": "01:35:39", "text": "呃，那基本上我可以……我关闭我的"}, {"type": "subtitle", "time": 5742.149, "timestamp": "01:35:42", "text": "网站了吗？ 我做了。 哦，所以基本上我可以……"}, {"type": "subtitle", "time": 5745.189, "timestamp": "01:35:45", "text": "嗯……"}, {"type": "subtitle", "time": 5747.35, "timestamp": "01:35:47", "text": "直播录像存档。 基本上我只能在"}, {"type": "subtitle", "time": 5752.709, "timestamp": "01:35:52", "text": "这里添加 YouTube 聊天信息，不能添加 Twitch 聊天信息。"}, {"type": "subtitle", "time": 5755.189, "timestamp": "01:35:55", "text": "你好。"}, {"type": "subtitle", "time": 5759.43, "timestamp": "01:35:59", "text": "圣洁快乐。 等等，为什么加载不出来？ 所以，我"}]
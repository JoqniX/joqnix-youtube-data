[{"type": "subtitle", "time": 8168.31, "timestamp": "02:16:08", "text": "啊，也过去一段时间了。 你好。"}, {"type": "subtitle", "time": 8171.669, "timestamp": "02:16:11", "text": "再见。  AB，谢谢你的光临。   祝您"}, {"type": "subtitle", "time": 8175.189, "timestamp": "02:16:15", "text": "今晚愉快。 祝你好运。"}, {"type": "subtitle", "time": 8176.79, "timestamp": "02:16:16", "text": "那么，你什么时候离开？ 还有"}, {"type": "subtitle", "time": 8180.069, "timestamp": "02:16:20", "text": "几天？ 呃，月底。"}, {"type": "subtitle", "time": 8182.31, "timestamp": "02:16:22", "text": "我将在"}, {"type": "subtitle", "time": 8187.35, "timestamp": "02:16:27", "text": "29号、30号或31号离开。 尚未证实。"}, {"type": "subtitle", "time": 8191.75, "timestamp": "02:16:31", "text": "呃，但是到了四月份，我就……"}, {"type": "subtitle", "time": 8197.669, "timestamp": "02:16:37", "text": "呃，我就不在印度了。 呃，"}, {"type": "subtitle", "time": 8199.91, "timestamp": "02:16:39", "text": "我周日（"}, {"type": "subtitle", "time": 8202.79, "timestamp": "02:16:42", "text": "15号）有考试。 所以我必须复习备考。"}, {"type": "subtitle", "time": 8205.11, "timestamp": "02:16:45", "text": "考试结束后，我要飞快地"}, {"type": "subtitle", "time": 8215.669, "timestamp": "02:16:55", "text": "收拾东西，收拾这个那个的。是"}]
[{"type": "subtitle", "time": 5401.35, "timestamp": "01:30:01", "text": "简体中文版本。 所以，嗯，"}, {"type": "subtitle", "time": 5404.629, "timestamp": "01:30:04", "text": "英文 SRT 字幕看起来会是这样的。"}, {"type": "subtitle", "time": 5407.59, "timestamp": "01:30:07", "text": "普通的SRT字幕文件也支持视频编辑器"}, {"type": "subtitle", "time": 5411.189, "timestamp": "01:30:11", "text": "。 这次用的是虚拟桌面平台（VTT）。 这个 JSON"}, {"type": "subtitle", "time": 5415.11, "timestamp": "01:30:15", "text": "文件实际上是用于我的网站的。   是的"}, {"type": "subtitle", "time": 5418.39, "timestamp": "01:30:18", "text": "。 是的。  JSON 文件。 我有一个"}, {"type": "subtitle", "time": 5422.87, "timestamp": "01:30:22", "text": "时间线系统，如下所示。 时间线就像是"}, {"type": "subtitle", "time": 5426.229, "timestamp": "01:30:26", "text": "带有"}, {"type": "subtitle", "time": 5430.07, "timestamp": "01:30:30", "text": "字幕的聊天记录。 看到了吗？ 所以，呃，我该怎么做呢？嗯，"}, {"type": "subtitle", "time": 5432.79, "timestamp": "01:30:32", "text": "显示聊天记录，"}, {"type": "subtitle", "time": 5436.31, "timestamp": "01:30:36", "text": "呃，嗯，所以输入“抱歉，字幕”，"}, {"type": "subtitle", "time": 5439.27, "timestamp": "01:30:39", "text": "输入“聊天记录”，像这样，它就会显示出来。然后我"}, {"type": "subtitle", "time": 5441.83, "timestamp": "01:30:41", "text": "有一个数据块，因为字幕和"}, {"type": "subtitle", "time": 5444.229, "timestamp": "01:30:44", "text": "聊天记录，如果我进行12小时的直播，"}, {"type": "subtitle", "time": 5448.149, "timestamp": "01:30:48", "text": "如果它有很多聊天记录，"}, {"type": "subtitle", "time": 5451.75, "timestamp": "01:30:51", "text": "很多字幕，对吧？我"}, {"type": "subtitle", "time": 5455.75, "timestamp": "01:30:55", "text": "必须把"}, {"type": "subtitle", "time": 5458.709, "timestamp": "01:30:58", "text": "数据分成小块，对吧？ 所以，我认为这里大约有 200 个"}]
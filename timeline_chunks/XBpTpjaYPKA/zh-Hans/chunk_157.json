[{"type": "subtitle", "time": 9422.07, "timestamp": "02:37:02", "text": "推文之类的"}, {"type": "subtitle", "time": 9424.07, "timestamp": "02:37:04", "text": "公告也不会自动发布。"}, {"type": "subtitle", "time": 9427.59, "timestamp": "02:37:07", "text": "太多东西都出问题了，对吧？所以我意识到我"}, {"type": "subtitle", "time": 9430.23, "timestamp": "02:37:10", "text": "可以使用 Cloudflare Worker。"}, {"type": "subtitle", "time": 9432.79, "timestamp": "02:37:12", "text": "我有一个 Discord 引擎。这个引擎"}, {"type": "subtitle", "time": 9435.59, "timestamp": "02:37:15", "text": "每 10 分钟运行一次。所以它负责"}, {"type": "subtitle", "time": 9438.15, "timestamp": "02:37:18", "text": "处理"}, {"type": "subtitle", "time": 9440.87, "timestamp": "02:37:20", "text": "Discord 的相关工作，比如我"}, {"type": "subtitle", "time": 9443.03, "timestamp": "02:37:23", "text": "在 YouTube、Twitch 直播时发布公告"}, {"type": "subtitle", "time": 9445.67, "timestamp": "02:37:25", "text": "等等。它会自动创建"}, {"type": "subtitle", "time": 9449.19, "timestamp": "02:37:29", "text": "事件，对吧？所有这些。"}, {"type": "subtitle", "time": 9452.63, "timestamp": "02:37:32", "text": "我之前也做过同样的事情。 好了。嗯，我"}, {"type": "subtitle", "time": 9456.23, "timestamp": "02:37:36", "text": "在云端复制了一遍，然后我"}, {"type": "subtitle", "time": 9458.87, "timestamp": "02:37:38", "text": "得做一些事情，比如24小时"}, {"type": "subtitle", "time": 9460.469, "timestamp": "02:37:40", "text": "频道之类的，对吧，我"}, {"type": "subtitle", "time": 9463.51, "timestamp": "02:37:43", "text": "稍后再做。然后我有一个流媒体API，"}, {"type": "subtitle", "time": 9467.51, "timestamp": "02:37:47", "text": "它创建了这个网站。"}, {"type": "subtitle", "time": 9470.87, "timestamp": "02:37:50", "text": "所以我做的每一次直播都会在那里创建一个条目。"}, {"type": "subtitle", "time": 9475.27, "timestamp": "02:37:55", "text": "所以你可以看到所有这些完整的详细信息，"}, {"type": "subtitle", "time": 9477.83, "timestamp": "02:37:57", "text": "除了分析数据。"}]
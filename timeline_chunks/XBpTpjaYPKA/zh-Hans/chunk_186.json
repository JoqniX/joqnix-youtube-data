[{"type": "subtitle", "time": 11160.15, "timestamp": "03:06:00", "text": "非常感谢，祝你们有个美好的夜晚"}, {"type": "subtitle", "time": 11162.63, "timestamp": "03:06:02", "text": "、早晨、晚上，或者任何"}, {"type": "subtitle", "time": 11165.75, "timestamp": "03:06:05", "text": "你们觉得是的时间。祝你们今天一切"}, {"type": "subtitle", "time": 11167.269, "timestamp": "03:06:07", "text": "顺利。"}, {"type": "subtitle", "time": 11170.309, "timestamp": "03:06:10", "text": "别忘了今天也要做好事，好好"}, {"type": "subtitle", "time": 11181.03, "timestamp": "03:06:21", "text": "我就说到这里吧。嗨，我"}]
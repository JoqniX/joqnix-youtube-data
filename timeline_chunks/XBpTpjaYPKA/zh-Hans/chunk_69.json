[{"type": "subtitle", "time": 4142.309, "timestamp": "01:09:02", "text": "50 到 100 行代码就重现了我"}, {"type": "subtitle", "time": 4148.309, "timestamp": "01:09:08", "text": "在 Sammy 里花了三到四周才完成的工作。太疯狂了。"}, {"type": "subtitle", "time": 4152.55, "timestamp": "01:09:12", "text": "我的天哪。我当时就想，天哪，疯了"}, {"type": "subtitle", "time": 4160.95, "timestamp": "01:09:20", "text": "哦，钱。这是什么？"}, {"type": "subtitle", "time": 4163.669, "timestamp": "01:09:23", "text": "哦。我的天哪。"}, {"type": "subtitle", "time": 4166.55, "timestamp": "01:09:26", "text": "谢谢你的订阅。你不用订阅"}, {"type": "subtitle", "time": 4170.07, "timestamp": "01:09:30", "text": "。我的天哪。你不用订阅。等等。Twitch"}, {"type": "subtitle", "time": 4173.189, "timestamp": "01:09:33", "text": "不是挺贵的吗？"}, {"type": "subtitle", "time": 4176.07, "timestamp": "01:09:36", "text": "谢谢你的订阅。哦。别"}, {"type": "subtitle", "time": 4178.95, "timestamp": "01:09:38", "text": "在 Twitch 上订阅。"}, {"type": "subtitle", "time": 4181.91, "timestamp": "01:09:41", "text": "你不用订阅。你不用订阅。"}, {"type": "subtitle", "time": 4186.63, "timestamp": "01:09:46", "text": "实际上，Twitch 会抽成很多。Twitch"}, {"type": "subtitle", "time": 4195.35, "timestamp": "01:09:55", "text": "啊。我的天哪。虽然他们是从 YouTube 来的"}, {"type": "subtitle", "time": 4197.75, "timestamp": "01:09:57", "text": "。但是，但是，我仍然非常感谢"}]
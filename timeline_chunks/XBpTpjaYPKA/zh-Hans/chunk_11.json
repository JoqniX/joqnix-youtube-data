[{"type": "subtitle", "time": 661.43, "timestamp": "00:11:01", "text": "呃，路由设置。"}, {"type": "subtitle", "time": 666.15, "timestamp": "00:11:06", "text": "我把它弄丢了。 我重置了它。 所以所有的一切，"}, {"type": "subtitle", "time": 669.91, "timestamp": "00:11:09", "text": "所有复杂的插件，"}, {"type": "subtitle", "time": 685.91, "timestamp": "00:11:25", "text": "，那件事发生了。"}, {"type": "subtitle", "time": 688.79, "timestamp": "00:11:28", "text": "拿出来。"}, {"type": "subtitle", "time": 692.15, "timestamp": "00:11:32", "text": "我本来应该保留一个新的聊天"}, {"type": "subtitle", "time": 695.509, "timestamp": "00:11:35", "text": "小部件。 你看到底部了"}, {"type": "subtitle", "time": 698.47, "timestamp": "00:11:38", "text": "吗？ 最底下的那个。 不是这个"}, {"type": "subtitle", "time": 700.15, "timestamp": "00:11:40", "text": "。 那是……应该还有"}, {"type": "subtitle", "time": 702.47, "timestamp": "00:11:42", "text": "另一个。"}, {"type": "subtitle", "time": 706.87, "timestamp": "00:11:46", "text": "嗯，我的梅尔工作室承受不了这么多。"}, {"type": "subtitle", "time": 715.509, "timestamp": "00:11:55", "text": "所以，我大概会在下周左右重置我的"}, {"type": "subtitle", "time": 719.35, "timestamp": "00:11:59", "text": "电脑。"}]
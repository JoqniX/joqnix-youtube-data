[{"type": "subtitle", "time": 8641.03, "timestamp": "02:24:01", "text": "我一直在为我的事情做准备。"}, {"type": "subtitle", "time": 8644.71, "timestamp": "02:24:04", "text": "嗯，一直想直播，但"}, {"type": "subtitle", "time": 8647.27, "timestamp": "02:24:07", "text": "我一直忍着没直播，"}, {"type": "subtitle", "time": 8651.11, "timestamp": "02:24:11", "text": "因为嗯，"}, {"type": "subtitle", "time": 8653.91, "timestamp": "02:24:13", "text": "如果你太累、内心空虚，直播就不好"}, {"type": "subtitle", "time": 8656.15, "timestamp": "02:24:16", "text": "，对吧？"}, {"type": "subtitle", "time": 8660.63, "timestamp": "02:24:20", "text": "嗯，那就像是能量水平低下，对吧？"}, {"type": "subtitle", "time": 8663.11, "timestamp": "02:24:23", "text": "以前，为了直播我什么都愿意做"}, {"type": "subtitle", "time": 8665.91, "timestamp": "02:24:25", "text": "。 比如，如果我感到沮丧、"}, {"type": "subtitle", "time": 8670.15, "timestamp": "02:24:30", "text": "悲伤，或者开心，任何情绪，如果我"}, {"type": "subtitle", "time": 8672.389, "timestamp": "02:24:32", "text": "直播，我就会开心。 肾上腺素"}, {"type": "subtitle", "time": 8675.83, "timestamp": "02:24:35", "text": "飙升，诸如此类的事情都发生了。 现在，我不"}, {"type": "subtitle", "time": 8678.389, "timestamp": "02:24:38", "text": "知道发生了什么。 呃，也许是生活给了"}, {"type": "subtitle", "time": 8680.95, "timestamp": "02:24:40", "text": "我一些打击吧。 或者，也许是像"}, {"type": "subtitle", "time": 8685.83, "timestamp": "02:24:45", "text": "直播的压力，或者我……"}, {"type": "subtitle", "time": 8688.55, "timestamp": "02:24:48", "text": "我"}, {"type": "subtitle", "time": 8692.309, "timestamp": "02:24:52", "text": "看到的……我该怎么说呢？ 是的，以前"}, {"type": "subtitle", "time": 8694.87, "timestamp": "02:24:54", "text": "我直播的时候，把这当成一种"}, {"type": "subtitle", "time": 8697.91, "timestamp": "02:24:57", "text": "爱好，一种"}]
[{"type": "subtitle", "time": 10502.07, "timestamp": "02:55:02", "text": "我要搞 Kick 功能，然后我要"}, {"type": "subtitle", "time": 10505.349, "timestamp": "02:55:05", "text": "研究怎么把 Kick 聊天记录导出成"}, {"type": "subtitle", "time": 10508.389, "timestamp": "02:55:08", "text": "JSON 文件，这样我就可以把它放到网站上了，"}, {"type": "subtitle", "time": 10510.95, "timestamp": "02:55:10", "text": "这样人们在"}, {"type": "subtitle", "time": 10514.309, "timestamp": "02:55:14", "text": "浏览存档页面的时候就能看到 YouTube 和 Twitch 的 Kick 聊天记录了。"}, {"type": "subtitle", "time": 10522.23, "timestamp": "02:55:22", "text": "然后我又想到，我"}, {"type": "subtitle", "time": 10525.19, "timestamp": "02:55:25", "text": "以前有个合作者"}, {"type": "subtitle", "time": 10527.91, "timestamp": "02:55:27", "text": "数据库系统，我觉得用在"}, {"type": "subtitle", "time": 10530.63, "timestamp": "02:55:30", "text": "我的存档"}, {"type": "subtitle", "time": 10532.79, "timestamp": "02:55:32", "text": "页面上应该挺好。比如，如果我和一个"}, {"type": "subtitle", "time": 10535.19, "timestamp": "02:55:35", "text": "内容创作者合作，他们的"}, {"type": "subtitle", "time": 10536.79, "timestamp": "02:55:36", "text": "所有数据都会保存在一个"}, {"type": "subtitle", "time": 10539.349, "timestamp": "02:55:39", "text": "数据库里，比如他们的 YouTube"}, {"type": "subtitle", "time": 10544.07, "timestamp": "02:55:44", "text": "频道、Twitch 频道、社交媒体账号、用户名"}, {"type": "subtitle", "time": 10548.07, "timestamp": "02:55:48", "text": "、PG 等等。"}, {"type": "subtitle", "time": 10551.19, "timestamp": "02:55:51", "text": "这些信息都会保存在一个数据库里。这样，就可以像这样："}, {"type": "subtitle", "time": 10554.63, "timestamp": "02:55:54", "text": "Jo 和一位"}, {"type": "subtitle", "time": 10558.63, "timestamp": "02:55:58", "text": "创作者合作了，然后系统会提取数据并"}]
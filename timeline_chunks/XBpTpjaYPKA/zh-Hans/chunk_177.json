[{"type": "subtitle", "time": 10621.59, "timestamp": "02:57:01", "text": "你知道，对我来说，直播是我"}, {"type": "subtitle", "time": 10624.23, "timestamp": "02:57:04", "text": "热爱的事情。"}, {"type": "subtitle", "time": 10625.83, "timestamp": "02:57:05", "text": "所以"}, {"type": "subtitle", "time": 10627.75, "timestamp": "02:57:07", "text": "这很好，对吧？当你"}, {"type": "subtitle", "time": 10630.79, "timestamp": "02:57:10", "text": "这样想的时候，就像，哦，我做这些事情是为了我"}, {"type": "subtitle", "time": 10632.71, "timestamp": "02:57:12", "text": "自己的"}, {"type": "subtitle", "time": 10634.95, "timestamp": "02:57:14", "text": "方便。不，不是方便，而是"}, {"type": "subtitle", "time": 10638.71, "timestamp": "02:57:18", "text": "提升生活质量，对吧？"}, {"type": "subtitle", "time": 10643.19, "timestamp": "02:57:23", "text": "作为一个内容专业的"}, {"type": "subtitle", "time": 10644.79, "timestamp": "02:57:24", "text": "毕业生，你得操心"}, {"type": "subtitle", "time": 10647.429, "timestamp": "02:57:27", "text": "在多个平台上发帖、"}, {"type": "subtitle", "time": 10649.59, "timestamp": "02:57:29", "text": "发布公告、做这做那，而"}, {"type": "subtitle", "time": 10651.75, "timestamp": "02:57:31", "text": "我现在把所有事情都自动化了，"}, {"type": "subtitle", "time": 10658.87, "timestamp": "02:57:38", "text": "还做了额外的工作。 都是些没必要的"}, {"type": "subtitle", "time": 10665.91, "timestamp": "02:57:45", "text": "不过还不错，"}]
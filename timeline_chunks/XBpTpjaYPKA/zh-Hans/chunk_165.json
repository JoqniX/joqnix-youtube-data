[{"type": "subtitle", "time": 9901.11, "timestamp": "02:45:01", "text": "它不会再用 OBS 运行，而是会自动检测到我"}, {"type": "subtitle", "time": 9904.309, "timestamp": "02:45:04", "text": "在 YouTube、Twitch 等平台直播，"}, {"type": "subtitle", "time": 9907.67, "timestamp": "02:45:07", "text": "我可以设置直播面板，这样人们就能"}, {"type": "subtitle", "time": 9911.19, "timestamp": "02:45:11", "text": "看到帖子、回放、"}, {"type": "subtitle", "time": 9913.51, "timestamp": "02:45:13", "text": "日程安排，呃，还有"}, {"type": "subtitle", "time": 9916.95, "timestamp": "02:45:16", "text": "粉丝创作的作品"}, {"type": "subtitle", "time": 9919.269, "timestamp": "02:45:19", "text": "等等，"}, {"type": "subtitle", "time": 9921.59, "timestamp": "02:45:21", "text": "比如今年以来，呃，"}, {"type": "subtitle", "time": 9924.07, "timestamp": "02:45:24", "text": "这些年来为我创作粉丝作品的人，他们会看到粉丝作品，你会"}, {"type": "subtitle", "time": 9927.349, "timestamp": "02:45:27", "text": "看到背景音乐，所有的一切。 所有功能都"}, {"type": "subtitle", "time": 9930.309, "timestamp": "02:45:30", "text": "在网站里面。对。对。"}, {"type": "subtitle", "time": 9932.95, "timestamp": "02:45:32", "text": "它会显示直播时间表"}, {"type": "subtitle", "time": 9935.19, "timestamp": "02:45:35", "text": "之类的。所以如果正在"}, {"type": "subtitle", "time": 9937.19, "timestamp": "02:45:37", "text": "播放 Hongkey 的《Star Rail》，它会显示"}, {"type": "subtitle", "time": 9939.51, "timestamp": "02:45:39", "text": "数字……它坏了，但是，嗯，是"}, {"type": "subtitle", "time": 9941.75, "timestamp": "02:45:41", "text": "二号。它应该是……呃，对"}, {"type": "subtitle", "time": 9944.79, "timestamp": "02:45:44", "text": "，是五号，像这样。所有东西都……"}, {"type": "subtitle", "time": 9949.75, "timestamp": "02:45:49", "text": "显然不对。呃，"}, {"type": "subtitle", "time": 9952.79, "timestamp": "02:45:52", "text": "我该怎么改回来？好的，所以我得……呃，"}, {"type": "subtitle", "time": 9958.55, "timestamp": "02:45:58", "text": "等等。呃，"}]
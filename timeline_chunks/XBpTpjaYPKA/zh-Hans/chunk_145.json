[{"type": "subtitle", "time": 8700.95, "timestamp": "02:25:00", "text": "打发时间或者无聊的时候可以做的事情。 嗯，是啊，我"}, {"type": "subtitle", "time": 8703.19, "timestamp": "02:25:03", "text": "不太在意这些事。 现在我"}, {"type": "subtitle", "time": 8705.75, "timestamp": "02:25:05", "text": "开始在意“哦，我必须"}, {"type": "subtitle", "time": 8709.91, "timestamp": "02:25:09", "text": "做得更好，我必须付出这付出"}, {"type": "subtitle", "time": 8713.51, "timestamp": "02:25:13", "text": "那”，然后我"}, {"type": "subtitle", "time": 8717.03, "timestamp": "02:25:17", "text": "每天都像行尸走肉一样，做着各种事情，出去玩什么的。"}, {"type": "subtitle", "time": 8719.99, "timestamp": "02:25:19", "text": "然后我就想，“啊，"}, {"type": "subtitle", "time": 8722.55, "timestamp": "02:25:22", "text": "我需要直播吗？” 然后我就"}, {"type": "subtitle", "time": 8725.83, "timestamp": "02:25:25", "text": "想着直播的事，然后就睡着了。 我"}, {"type": "subtitle", "time": 8728.23, "timestamp": "02:25:28", "text": "醒来就会想，“啊，我错过了。”"}, {"type": "subtitle", "time": 8730.389, "timestamp": "02:25:30", "text": "第二天我又会想，“好吧，明天"}, {"type": "subtitle", "time": 8732.87, "timestamp": "02:25:32", "text": "我直播。”"}, {"type": "subtitle", "time": 8740.87, "timestamp": "02:25:40", "text": "肤色。我不能说。我"}, {"type": "subtitle", "time": 8744.23, "timestamp": "02:25:44", "text": "不能说。我的意思是，好吧，就让"}, {"type": "subtitle", "time": 8747.91, "timestamp": "02:25:47", "text": "你自己想象吧。"}, {"type": "subtitle", "time": 8750.15, "timestamp": "02:25:50", "text": "但是，"}, {"type": "subtitle", "time": 8754.55, "timestamp": "02:25:54", "text": "我觉得我的肤色是棕色的，像棕色或者"}, {"type": "subtitle", "time": 8758.23, "timestamp": "02:25:58", "text": "浅棕色。我不知道。"}]
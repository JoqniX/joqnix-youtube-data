[{"type": "subtitle", "time": 8401.99, "timestamp": "02:20:01", "text": "但现在我们有了自己的社团。"}, {"type": "subtitle", "time": 8403.75, "timestamp": "02:20:03", "text": "基本上，所有支持学生的活动都包括"}, {"type": "subtitle", "time": 8406.389, "timestamp": "02:20:06", "text": "帮助他们参与文化活动、节日"}, {"type": "subtitle", "time": 8408.15, "timestamp": "02:20:08", "text": "庆祝活动、国际"}, {"type": "subtitle", "time": 8410.95, "timestamp": "02:20:10", "text": "合作，以及与其他"}, {"type": "subtitle", "time": 8413.349, "timestamp": "02:20:13", "text": "俱乐部和大学的其他活动。"}, {"type": "subtitle", "time": 8426.07, "timestamp": "02:20:26", "text": "哇，"}, {"type": "subtitle", "time": 8436.55, "timestamp": "02:20:36", "text": "听起来真不错。 我想知道"}, {"type": "subtitle", "time": 8447.59, "timestamp": "02:20:47", "text": "大学和语言学校是否也会有社团。"}, {"type": "subtitle", "time": 8451.429, "timestamp": "02:20:51", "text": "我大概会加入俱乐部吧，因为"}, {"type": "subtitle", "time": 8455.19, "timestamp": "02:20:55", "text": "可能必须这样，他们"}]
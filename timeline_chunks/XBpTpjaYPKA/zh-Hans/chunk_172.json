[{"type": "subtitle", "time": 10320.95, "timestamp": "02:52:00", "text": "我可以出售自己的服务，"}, {"type": "subtitle", "time": 10322.469, "timestamp": "02:52:02", "text": "但"}, {"type": "subtitle", "time": 10326.07, "timestamp": "02:52:06", "text": "除非我足够优秀，"}, {"type": "subtitle", "time": 10327.91, "timestamp": "02:52:07", "text": "因为你知道，我这个人太完美"}, {"type": "subtitle", "time": 10330.55, "timestamp": "02:52:10", "text": "主义了，很"}, {"type": "subtitle", "time": 10332.469, "timestamp": "02:52:12", "text": "遗憾。"}, {"type": "subtitle", "time": 10334.87, "timestamp": "02:52:14", "text": "所以，"}, {"type": "subtitle", "time": 10336.95, "timestamp": "02:52:16", "text": "是的，我只想在"}, {"type": "subtitle", "time": 10339.59, "timestamp": "02:52:19", "text": "我足够优秀的时候才去做，比如我有很好的"}, {"type": "subtitle", "time": 10341.429, "timestamp": "02:52:21", "text": "潜力等等。"}, {"type": "subtitle", "time": 10345.03, "timestamp": "02:52:25", "text": "如果 我可以让客户满意，让"}, {"type": "subtitle", "time": 10347.269, "timestamp": "02:52:27", "text": "他们看到我制作的"}, {"type": "subtitle", "time": 10350.55, "timestamp": "02:52:30", "text": "成品，"}, {"type": "subtitle", "time": 10354.55, "timestamp": "02:52:34", "text": "只有这样我才会让他们"}, {"type": "subtitle", "time": 10357.59, "timestamp": "02:52:37", "text": "付钱，因为我不想像"}, {"type": "subtitle", "time": 10360.23, "timestamp": "02:52:40", "text": "那些GFX机器人一样，"}, {"type": "subtitle", "time": 10364.63, "timestamp": "02:52:44", "text": "试图让你委托"}, {"type": "subtitle", "time": 10367.75, "timestamp": "02:52:47", "text": "他们，就像那些骗子机器人、艺术家机器人"}, {"type": "subtitle", "time": 10370.87, "timestamp": "02:52:50", "text": "会到你的直播间，告诉你他们"}, {"type": "subtitle", "time": 10372.87, "timestamp": "02:52:52", "text": "可以为你做东西等等。然后他们"}, {"type": "subtitle", "time": 10375.03, "timestamp": "02:52:55", "text": "给你一个劣质产品，你会想，"}, {"type": "subtitle", "time": 10377.19, "timestamp": "02:52:57", "text": "“啊，这钱花得值。” 这东西不值这个"}, {"type": "subtitle", "time": 10379.91, "timestamp": "02:52:59", "text": "价钱。 我被骗了。  “我"}]
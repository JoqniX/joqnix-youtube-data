[{"type": "subtitle", "time": 1630.31, "timestamp": "00:27:10", "text": "好的，我到了。 我在这里。"}, {"type": "subtitle", "time": 1632.87, "timestamp": "00:27:12", "text": "你好。 你好。 你好。"}, {"type": "subtitle", "time": 1635.269, "timestamp": "00:27:15", "text": "嗯，"}, {"type": "subtitle", "time": 1650.87, "timestamp": "00:27:30", "text": "我可以把它删掉。   好了"}, {"type": "subtitle", "time": 1652.87, "timestamp": "00:27:32", "text": "，"}, {"type": "subtitle", "time": 1655.269, "timestamp": "00:27:35", "text": "我的茶到了。"}, {"type": "subtitle", "time": 1658.95, "timestamp": "00:27:38", "text": "你知道吗，我之前并不知道今天是圣日，"}, {"type": "subtitle", "time": 1663.029, "timestamp": "00:27:43", "text": "直到我看到一些邻居在"}, {"type": "subtitle", "time": 1677.11, "timestamp": "00:27:57", "text": "你"}]
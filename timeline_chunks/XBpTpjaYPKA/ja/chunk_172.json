[{"type": "subtitle", "time": 10320.95, "timestamp": "02:52:00", "text": "自分でサービスを売るのは構わない"}, {"type": "subtitle", "time": 10322.469, "timestamp": "02:52:02", "text": "けど、自分がうまくやっていけるようになるまではね。 もう"}, {"type": "subtitle", "time": 10326.07, "timestamp": "02:52:06", "text": "十分じゃない。というのも、"}, {"type": "subtitle", "time": 10332.469, "timestamp": "02:52:12", "text": "悲しいかな、僕は完璧主義者すぎるから。だから"}, {"type": "subtitle", "time": 10336.95, "timestamp": "02:52:16", "text": "、"}, {"type": "subtitle", "time": 10339.59, "timestamp": "02:52:19", "text": "自分が十分に優秀で、良い"}, {"type": "subtitle", "time": 10341.429, "timestamp": "02:52:21", "text": "可能性がある場合にのみ、仕事をしたい。"}, {"type": "subtitle", "time": 10345.03, "timestamp": "02:52:25", "text": "そして、僕が顧客を満足させて、"}, {"type": "subtitle", "time": 10350.55, "timestamp": "02:52:30", "text": "僕から何か良い完成品、何かを見せることができた場合のみ、"}, {"type": "subtitle", "time": 10354.55, "timestamp": "02:52:34", "text": "彼らに仕事をさせて、僕にお金を払わせる。だって、"}, {"type": "subtitle", "time": 10357.59, "timestamp": "02:52:37", "text": "僕は"}, {"type": "subtitle", "time": 10367.75, "timestamp": "02:52:47", "text": "あの詐欺ボットやアーティストボットのように、君に依頼させようとするような、"}, {"type": "subtitle", "time": 10370.87, "timestamp": "02:52:50", "text": "君のストリームに来て「君のために何かできる」などと言って、"}, {"type": "subtitle", "time": 10375.03, "timestamp": "02:52:55", "text": "粗悪な作品を渡されて"}, {"type": "subtitle", "time": 10377.19, "timestamp": "02:52:57", "text": "「ああ、お金を払っただけ」なんていうのは嫌なんだ。 これは"}, {"type": "subtitle", "time": 10379.91, "timestamp": "02:52:59", "text": "お金に見合う価値がありません。 詐欺に遭いました。"}]
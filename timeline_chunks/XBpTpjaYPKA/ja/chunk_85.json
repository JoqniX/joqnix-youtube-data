[{"type": "subtitle", "time": 5101.03, "timestamp": "01:25:01", "text": "記録しておく必要があるものなど、Notionに手動で記入します。"}, {"type": "subtitle", "time": 5103.11, "timestamp": "01:25:03", "text": "配信目標は、基本的に"}, {"type": "subtitle", "time": 5105.27, "timestamp": "01:25:05", "text": "特定の配信で私が達成した目標です。 配信？"}, {"type": "subtitle", "time": 5107.27, "timestamp": "01:25:07", "text": "何をやらなきゃいけないのか、そして"}, {"type": "subtitle", "time": 5110.39, "timestamp": "01:25:10", "text": "それを達成できたのか、できなかったのか"}, {"type": "subtitle", "time": 5112.709, "timestamp": "01:25:12", "text": "。"}, {"type": "subtitle", "time": 5114.55, "timestamp": "01:25:14", "text": "うん。"}, {"type": "subtitle", "time": 5116.95, "timestamp": "01:25:16", "text": "いいね。番組と、"}, {"type": "subtitle", "time": 5121.11, "timestamp": "01:25:21", "text": "将来的にはチャットベースの"}, {"type": "subtitle", "time": 5123.75, "timestamp": "01:25:23", "text": "リマインダーシステムを追加する予定なんだ。例えば、"}, {"type": "subtitle", "time": 5134.87, "timestamp": "01:25:34", "text": "誰かがリマインダーコマンドの感嘆符付きリマインダージョークを打つと、私のDiscordサーバーに表示されるんだけど、そこに"}, {"type": "subtitle", "time": 5142.55, "timestamp": "01:25:42", "text": "メッセージを追加するんだ"}, {"type": "subtitle", "time": 5145.27, "timestamp": "01:25:45", "text": "。つまり、基本的にはそういうこと。Websh"}, {"type": "subtitle", "time": 5149.35, "timestamp": "01:25:49", "text": "に追加するよ。ちょっと待って。"}, {"type": "subtitle", "time": 5150.87, "timestamp": "01:25:50", "text": "どこにある？"}, {"type": "subtitle", "time": 5156.709, "timestamp": "01:25:56", "text": "何？うん。うん、これ。これ。"}, {"type": "subtitle", "time": 5158.79, "timestamp": "01:25:58", "text": "わかった。"}]
[{"type": "subtitle", "time": 11101.349, "timestamp": "03:05:01", "text": "ああ、神様。"}, {"type": "subtitle", "time": 11103.429, "timestamp": "03:05:03", "text": "いや、遅れています。気に入らない。"}, {"type": "subtitle", "time": 11120.71, "timestamp": "03:05:20", "text": "配信を終了します。"}, {"type": "subtitle", "time": 11123.83, "timestamp": "03:05:23", "text": "それでは、今日"}, {"type": "subtitle", "time": 11127.59, "timestamp": "03:05:27", "text": "YouTube、Twitch、Kick and Beam など、"}, {"type": "subtitle", "time": 11129.59, "timestamp": "03:05:29", "text": "すべてのプラットフォームで来てくださった皆さんに感謝します。本当にありがとうございました"}, {"type": "subtitle", "time": 11133.429, "timestamp": "03:05:33", "text": "。 では、また明日の配信でお会いしましょう"}, {"type": "subtitle", "time": 11135.349, "timestamp": "03:05:35", "text": "。"}, {"type": "subtitle", "time": 11140.07, "timestamp": "03:05:40", "text": "皆さんが来てくれて、お話してくれたことが本当に心の底から嬉しかったです"}, {"type": "subtitle", "time": 11142.71, "timestamp": "03:05:42", "text": "。本当に久しぶりだったので、誰も来ないだろうと思っていました。忙しくて、"}, {"type": "subtitle", "time": 11148.309, "timestamp": "03:05:48", "text": "皆さんが私のことを忘れていたのかもしれません"}, {"type": "subtitle", "time": 11151.75, "timestamp": "03:05:51", "text": "。でも、貴重な"}, {"type": "subtitle", "time": 11157.51, "timestamp": "03:05:57", "text": "時間を割いて一緒に過ごしてくれて本当にありがとう。"}]
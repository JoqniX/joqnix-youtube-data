[{"type": "subtitle", "time": 6060.07, "timestamp": "01:41:00", "text": "、毎週土曜日にブラウザーが自動的に更新されます"}, {"type": "subtitle", "time": 6062.31, "timestamp": "01:41:02", "text": "。"}, {"type": "subtitle", "time": 6064.79, "timestamp": "01:41:04", "text": "VOD を視聴している場合、つまり、"}, {"type": "subtitle", "time": 6068.229, "timestamp": "01:41:08", "text": "ここでビデオを視聴している場合、"}, {"type": "subtitle", "time": 6070.79, "timestamp": "01:41:10", "text": "Web サイトから直接、または YouTube、"}, {"type": "subtitle", "time": 6072.47, "timestamp": "01:41:12", "text": "Twitch、その他のプラットフォームから、"}, {"type": "subtitle", "time": 6076.629, "timestamp": "01:41:16", "text": "ページが自動的に更新されます。"}, {"type": "subtitle", "time": 6078.47, "timestamp": "01:41:18", "text": "うん。"}, {"type": "subtitle", "time": 6084.709, "timestamp": "01:41:24", "text": "土曜日の12時に自動更新されるようにしました。 そのとき、新しい"}, {"type": "subtitle", "time": 6087.83, "timestamp": "01:41:27", "text": "プレイリストが更新されるんですよね？ うん。"}, {"type": "subtitle", "time": 6091.51, "timestamp": "01:41:31", "text": "うん。 ということで、今週のプレイリストは、"}, {"type": "subtitle", "time": 6093.91, "timestamp": "01:41:33", "text": "Poppy Playtime、Final Fantasy、Hongkey"}, {"type": "subtitle", "time": 6097.99, "timestamp": "01:41:37", "text": "Star real、Battle Bet Remastered で、"}, {"type": "subtitle", "time": 6100.39, "timestamp": "01:41:40", "text": "すべてランダムです。 そうです、すべては"}, {"type": "subtitle", "time": 6110.95, "timestamp": "01:41:50", "text": "私に言わせれば、本当に素晴らしいです。"}, {"type": "subtitle", "time": 6113.83, "timestamp": "01:41:53", "text": "これを全部やってよかったと思う。なぜなら、"}, {"type": "subtitle", "time": 6118.229, "timestamp": "01:41:58", "text": "今ストリーミングするたびに、以前は「そもそもなんで"}]
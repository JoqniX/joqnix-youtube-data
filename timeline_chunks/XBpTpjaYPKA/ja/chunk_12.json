[{"type": "subtitle", "time": 722.79, "timestamp": "00:12:02", "text": "たぶん来週ですよね？"}, {"type": "subtitle", "time": 724.389, "timestamp": "00:12:04", "text": "うん。 うん。 来週。 ああ、来週"}, {"type": "subtitle", "time": 726.31, "timestamp": "00:12:06", "text": "リセットするつもりです"}, {"type": "subtitle", "time": 728.47, "timestamp": "00:12:08", "text": "。 来週の月曜日か日曜日。 うん。"}, {"type": "subtitle", "time": 730.389, "timestamp": "00:12:10", "text": "うん。 うん。 つまり、私はバックエンドの"}, {"type": "subtitle", "time": 732.629, "timestamp": "00:12:12", "text": "多くの"}, {"type": "subtitle", "time": 734.389, "timestamp": "00:12:14", "text": "ものをスピード実行しているようなものです。"}, {"type": "subtitle", "time": 737.43, "timestamp": "00:12:17", "text": "うん。 そして、ある意味、"}, {"type": "subtitle", "time": 739.43, "timestamp": "00:12:19", "text": "このストリームをやろうと思った理由の 1 つは、いくつかの"}, {"type": "subtitle", "time": 743.11, "timestamp": "00:12:23", "text": "こと、つまり"}, {"type": "subtitle", "time": 750.71, "timestamp": "00:12:30", "text": "複数のことを行う必要があったからです。 ああ、そうだね、"}, {"type": "subtitle", "time": 753.75, "timestamp": "00:12:33", "text": "復習しなきゃいけないものや"}, {"type": "subtitle", "time": 757.269, "timestamp": "00:12:37", "text": "宿題もいくつかあるんだ。 基本的に画面は表示しません"}, {"type": "subtitle", "time": 759.67, "timestamp": "00:12:39", "text": "。 私たちはこのシーンに登場します。"}, {"type": "subtitle", "time": 763.509, "timestamp": "00:12:43", "text": "低い戦闘"}, {"type": "subtitle", "time": 766.15, "timestamp": "00:12:46", "text": "音楽や同じようなBGMをかけて、"}, {"type": "subtitle", "time": 768.47, "timestamp": "00:12:48", "text": "勉強などに集中します。"}, {"type": "subtitle", "time": 771.509, "timestamp": "00:12:51", "text": "数"}, {"type": "subtitle", "time": 775.03, "timestamp": "00:12:55", "text": "週間前の発表でも述べたように、私はただ"}, {"type": "subtitle", "time": 777.829, "timestamp": "00:12:57", "text": "定期的にストリームしたり、ちょっとしたチャットの"}]
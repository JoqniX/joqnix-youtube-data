[{"type": "subtitle", "time": 3977.43, "timestamp": "01:06:17", "text": "ちょっと待って。自分が何をしているのか"}, {"type": "subtitle", "time": 3983.43, "timestamp": "01:06:23", "text": "見せていないのに、"}, {"type": "subtitle", "time": 3988.95, "timestamp": "01:06:28", "text": "企業ロールIDももらえるなんて変な感じがする。"}, {"type": "subtitle", "time": 3993.029, "timestamp": "01:06:33", "text": "技術的すぎると思う。"}, {"type": "subtitle", "time": 3995.67, "timestamp": "01:06:35", "text": "うん。"}, {"type": "subtitle", "time": 4001.43, "timestamp": "01:06:41", "text": "こんなことでみんなを退屈させたくない。そうだ。わかった、コピペしよう"}]
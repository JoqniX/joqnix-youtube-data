[{"type": "subtitle", "time": 5700.95, "timestamp": "01:35:00", "text": "Twitch のユーザーのための Twitch。 あなたを忘れてませんよ。"}, {"type": "subtitle", "time": 5703.99, "timestamp": "01:35:03", "text": "なので"}, {"type": "subtitle", "time": 5707.43, "timestamp": "01:35:07", "text": "アーカイブが残るように作りました。 現在、24時間365日の"}, {"type": "subtitle", "time": 5711.59, "timestamp": "01:35:11", "text": "チャネルがログに記録されます。 つまり、メタデータのようなデータのリストが含まれます"}, {"type": "subtitle", "time": 5714.55, "timestamp": "01:35:14", "text": "。 えっと、"}, {"type": "subtitle", "time": 5717.11, "timestamp": "01:35:17", "text": "ストリームはいつ始まったのか、サムネイルチャンネル、"}, {"type": "subtitle", "time": 5718.95, "timestamp": "01:35:18", "text": "それらすべて、"}, {"type": "subtitle", "time": 5722.95, "timestamp": "01:35:22", "text": "そしてチャット行のチャットがあります。"}, {"type": "subtitle", "time": 5724.95, "timestamp": "01:35:24", "text": "つまり、Twitch のすべての人々の、"}, {"type": "subtitle", "time": 5726.95, "timestamp": "01:35:26", "text": "ボットのチャンネル ポイントもすべて"}, {"type": "subtitle", "time": 5729.03, "timestamp": "01:35:29", "text": "ここに表示され、"}, {"type": "subtitle", "time": 5731.75, "timestamp": "01:35:31", "text": "チャットが標準化され、Web サイトの"}, {"type": "subtitle", "time": 5735.43, "timestamp": "01:35:35", "text": "読み取り可能なバージョンになります。 つまり、ユーザーはここにいるのです。"}, {"type": "subtitle", "time": 5739.35, "timestamp": "01:35:39", "text": "えっと、基本的にはウェブサイトを閉じても大丈夫ですか"}, {"type": "subtitle", "time": 5742.149, "timestamp": "01:35:42", "text": "? そうしました。 ああ、基本的には"}, {"type": "subtitle", "time": 5747.35, "timestamp": "01:35:47", "text": "ライブストリームのアーカイブを視聴できるということですね。 基本的に、"}, {"type": "subtitle", "time": 5752.709, "timestamp": "01:35:52", "text": "ここに YouTube チャットは置けますが、Twitch チャットは置けません。"}, {"type": "subtitle", "time": 5755.189, "timestamp": "01:35:55", "text": "こんにちは。"}, {"type": "subtitle", "time": 5759.43, "timestamp": "01:35:59", "text": "神聖なる幸せ。 待ってください、なぜ読み込まれないのですか? つまり、"}]
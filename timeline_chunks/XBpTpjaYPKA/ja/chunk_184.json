[{"type": "subtitle", "time": 11052.55, "timestamp": "03:04:12", "text": "あ、配信終了。ああ、そうだ。"}, {"type": "subtitle", "time": 11064.389, "timestamp": "03:04:24", "text": "反対側でライブ配信させてください? わかりました、ライブ配信中です。"}, {"type": "subtitle", "time": 11073.429, "timestamp": "03:04:33", "text": "泣かないで。"}, {"type": "subtitle", "time": 11077.11, "timestamp": "03:04:37", "text": "たぶん明日はそこにいます。ええ、"}, {"type": "subtitle", "time": 11079.91, "timestamp": "03:04:39", "text": "明日はそこに行けるように最善を尽くします。"}, {"type": "subtitle", "time": 11081.91, "timestamp": "03:04:41", "text": "心配しないでください。"}, {"type": "subtitle", "time": 11083.429, "timestamp": "03:04:43", "text": "こんにちは。うまくいきますか"}, {"type": "subtitle", "time": 11087.269, "timestamp": "03:04:47", "text": "? はい、うまくいきました。こんにちは。"}, {"type": "subtitle", "time": 11098.07, "timestamp": "03:04:58", "text": "遅れています。遅れています。遅れています。"}]
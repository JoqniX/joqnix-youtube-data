[{"type": "subtitle", "time": 10921.59, "timestamp": "03:02:01", "text": "えっと、明日は配信だけど、"}, {"type": "subtitle", "time": 10927.83, "timestamp": "03:02:07", "text": "ゲーム配信はしないと思う。"}, {"type": "subtitle", "time": 10931.429, "timestamp": "03:02:11", "text": "主にこんな感じのおしゃべり配信か、えっと、"}, {"type": "subtitle", "time": 10935.03, "timestamp": "03:02:15", "text": "安定した配信か、僕と一緒に仕事する"}, {"type": "subtitle", "time": 10938.55, "timestamp": "03:02:18", "text": "配信になると思う。もしかしたら、"}, {"type": "subtitle", "time": 10941.59, "timestamp": "03:02:21", "text": "裏でやってる作業全部を、自分が"}, {"type": "subtitle", "time": 10945.83, "timestamp": "03:02:25", "text": "何をしているかを一生懸命喋りながらナレーションするかもしれない"}, {"type": "subtitle", "time": 10948.87, "timestamp": "03:02:28", "text": "。えっと、"}, {"type": "subtitle", "time": 10951.83, "timestamp": "03:02:31", "text": "画面には出さないかもしれない。技術的すぎてつまらないから"}, {"type": "subtitle", "time": 10955.67, "timestamp": "03:02:35", "text": "。 うんうん。うーん、"}, {"type": "subtitle", "time": 10957.91, "timestamp": "03:02:37", "text": "ローファイな音楽とこの"}, {"type": "subtitle", "time": 10960.55, "timestamp": "03:02:40", "text": "背景だけになると思う。"}, {"type": "subtitle", "time": 10964.79, "timestamp": "03:02:44", "text": "うんうん。それから、"}, {"type": "subtitle", "time": 10967.269, "timestamp": "03:02:47", "text": "歌とかそういうのもしばらく練習してないから、"}, {"type": "subtitle", "time": 10970.87, "timestamp": "03:02:50", "text": "いつかやろうかな。"}, {"type": "subtitle", "time": 10977.03, "timestamp": "03:02:57", "text": "歌は下手だけど、それでも何か学ぶことはある"}]
[{"type": "subtitle", "time": 8882.55, "timestamp": "02:28:02", "text": "日本に引っ越すっていうことについてのビデオをリリースすると思う"}, {"type": "subtitle", "time": 8885.27, "timestamp": "02:28:05", "text": "。最後のビデオ。"}, {"type": "subtitle", "time": 8888.55, "timestamp": "02:28:08", "text": "家の録画もしたんだ。"}, {"type": "subtitle", "time": 8890.389, "timestamp": "02:28:10", "text": "でもね、正直に言うと、"}, {"type": "subtitle", "time": 8892.23, "timestamp": "02:28:12", "text": "ないんだ。唯一"}, {"type": "subtitle", "time": 8896.87, "timestamp": "02:28:16", "text": "後悔しているのは、こうやって"}, {"type": "subtitle", "time": 8911.03, "timestamp": "02:28:31", "text": "日本に行くって公に発表して、言及したことだと思う。"}, {"type": "subtitle", "time": 8915.51, "timestamp": "02:28:35", "text": "もし"}, {"type": "subtitle", "time": 8918.23, "timestamp": "02:28:38", "text": "過去に戻れるなら、"}, {"type": "subtitle", "time": 8922.07, "timestamp": "02:28:42", "text": "正直に言って自分を叱ると思う。"}, {"type": "subtitle", "time": 8924.55, "timestamp": "02:28:44", "text": "自分に言い聞かせたりしないよね？ 公に公開する必要はないよね"}, {"type": "subtitle", "time": 8931.27, "timestamp": "02:28:51", "text": "？うん。後悔しているのはそれだけだと思う"}, {"type": "subtitle", "time": 8934.15, "timestamp": "02:28:54", "text": "。"}, {"type": "subtitle", "time": 8937.03, "timestamp": "02:28:57", "text": "それ以外は、すべて順調だよ。普通に言って、"}]
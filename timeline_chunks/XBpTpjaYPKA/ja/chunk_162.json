[{"type": "subtitle", "time": 9720.79, "timestamp": "02:42:00", "text": "Billy Billyにアップロードされるたびに、"}, {"type": "subtitle", "time": 9726.309, "timestamp": "02:42:06", "text": "プレビューがここに表示されます。すごく"}, {"type": "subtitle", "time": 9730.71, "timestamp": "02:42:10", "text": "クールでしょ？そして、これを"}, {"type": "subtitle", "time": 9733.03, "timestamp": "02:42:13", "text": "Twitter"}, {"type": "subtitle", "time": 9735.91, "timestamp": "02:42:15", "text": "x.com、つまりTwitterで送る場合は、"}, {"type": "subtitle", "time": 9739.83, "timestamp": "02:42:19", "text": "メタデータも一緒に送るんです"}, {"type": "subtitle", "time": 9741.349, "timestamp": "02:42:21", "text": "。Twitter"}, {"type": "subtitle", "time": 9744.23, "timestamp": "02:42:24", "text": "で送ると、"}, {"type": "subtitle", "time": 9748.23, "timestamp": "02:42:28", "text": "メタデータが出てきます。ほら、かなり大きいですよね？"}, {"type": "subtitle", "time": 9752.87, "timestamp": "02:42:32", "text": "私のウェブサイトのタイトルが入ったカードです。"}, {"type": "subtitle", "time": 9756.15, "timestamp": "02:42:36", "text": "クリックするとこれが表示されます。つまり、"}, {"type": "subtitle", "time": 9758.87, "timestamp": "02:42:38", "text": "ツイートを書かなくて済むということですよね？"}, {"type": "subtitle", "time": 9761.429, "timestamp": "02:42:41", "text": "今日は楽しい配信でした。あれこれあれこれやりました"}, {"type": "subtitle", "time": 9762.95, "timestamp": "02:42:42", "text": "。"}, {"type": "subtitle", "time": 9766.95, "timestamp": "02:42:46", "text": "書く必要はありません。自分のページにリンクを貼るだけで簡単です。ええ"}, {"type": "subtitle", "time": 9773.349, "timestamp": "02:42:53", "text": "、クレイジーですが、"}, {"type": "subtitle", "time": 9775.11, "timestamp": "02:42:55", "text": "複雑すぎます。でも、ええ、私はこれを公開しました"}, {"type": "subtitle", "time": 9777.91, "timestamp": "02:42:57", "text": "。"}]
[{"type": "subtitle", "time": 10440.79, "timestamp": "02:54:00", "text": "でも、SSDを買って、"}, {"type": "subtitle", "time": 10444.23, "timestamp": "02:54:04", "text": "整理して、昔の"}, {"type": "subtitle", "time": 10450.87, "timestamp": "02:54:10", "text": "ダウンロードとか、"}, {"type": "subtitle", "time": 10454.55, "timestamp": "02:54:14", "text": "プラグインとか、音楽とか、"}, {"type": "subtitle", "time": 10460.87, "timestamp": "02:54:20", "text": "プログラムとか、データとか、全部不要なバックアップを削除しなきゃ"}, {"type": "subtitle", "time": 10462.71, "timestamp": "02:54:22", "text": "。1週間くらいでPC全体を整理しなきゃいけないから、"}, {"type": "subtitle", "time": 10472.79, "timestamp": "02:54:32", "text": "「ああ、あれをやろう、あれをやろう"}, {"type": "subtitle", "time": 10475.03, "timestamp": "02:54:35", "text": "」って。"}, {"type": "subtitle", "time": 10477.03, "timestamp": "02:54:37", "text": "ヤバい。じゃあ、これからどうするか教えてあげるね"}, {"type": "subtitle", "time": 10481.11, "timestamp": "02:54:41", "text": "。さて。配信が終わったら、"}, {"type": "subtitle", "time": 10485.11, "timestamp": "02:54:45", "text": "Twitchのリンク機能を使うんだ。Twitchの"}, {"type": "subtitle", "time": 10488.55, "timestamp": "02:54:48", "text": "配信をどうやってリンクすればいいかとか。"}, {"type": "subtitle", "time": 10493.11, "timestamp": "02:54:53", "text": "YouTube IDとか、YouTube用の"}, {"type": "subtitle", "time": 10496.79, "timestamp": "02:54:56", "text": "データとか、そういうのを作ったら、「やっと"}, {"type": "subtitle", "time": 10499.03, "timestamp": "02:54:59", "text": "動いた！」って思うんです。それから、"}]
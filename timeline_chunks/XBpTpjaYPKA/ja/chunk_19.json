[{"type": "subtitle", "time": 1146.789, "timestamp": "00:19:06", "text": "そうですね、私もそのつもりですし、"}, {"type": "subtitle", "time": 1149.029, "timestamp": "00:19:09", "text": "今日の配信のたびに"}, {"type": "subtitle", "time": 1151.909, "timestamp": "00:19:11", "text": "Twitch チャットにリンクするつもりです。"}, {"type": "subtitle", "time": 1153.909, "timestamp": "00:19:13", "text": "Twitch チャットはそこに存在することになります。 そうですね、"}, {"type": "subtitle", "time": 1160.07, "timestamp": "00:19:20", "text": "ちなみに YouTube チャンネルもそこにあります。"}, {"type": "subtitle", "time": 1162.789, "timestamp": "00:19:22", "text": "そうですね、いろいろやってきたと思います"}, {"type": "subtitle", "time": 1167.029, "timestamp": "00:19:27", "text": "。 ちょっと不必要なんですが、"}, {"type": "subtitle", "time": 1171.75, "timestamp": "00:19:31", "text": "バックエンド側ですね。というのも、やはり"}, {"type": "subtitle", "time": 1176.15, "timestamp": "00:19:36", "text": "ワンマンショーとしてやりたいですね。"}, {"type": "subtitle", "time": 1180.23, "timestamp": "00:19:40", "text": "私自身がそこにいるので、以前のようにはできないからです"}, {"type": "subtitle", "time": 1183.909, "timestamp": "00:19:43", "text": "。 ただ乗り込んで、"}, {"type": "subtitle", "time": 1187.51, "timestamp": "00:19:47", "text": "自分のやりたいことをして、降りたいだけなんです。 右。 これらをすべて"}, {"type": "subtitle", "time": 1192.23, "timestamp": "00:19:52", "text": "バックアップしておくと、すべてをスケジュールするのに役立ちます。そのため、あまり"}, {"type": "subtitle", "time": 1199.11, "timestamp": "00:19:59", "text": "多くの作業を行う必要はありません。 本当に良いシステム"}]
[{"type": "subtitle", "time": 10800.95, "timestamp": "03:00:00", "text": "うん。H"}, {"type": "subtitle", "time": 10804.87, "timestamp": "03:00:04", "text": "3時間だ。もう終わりにしなきゃ。ああ、"}, {"type": "subtitle", "time": 10808.87, "timestamp": "03:00:08", "text": "700だ。夕食を食べて、"}, {"type": "subtitle", "time": 10811.59, "timestamp": "03:00:11", "text": "リフレッシュして、宿題をして、寝て、"}, {"type": "subtitle", "time": 10814.23, "timestamp": "03:00:14", "text": "6時に起きて、えーっと、4時に起きて、"}, {"type": "subtitle", "time": 10817.91, "timestamp": "03:00:17", "text": "復習して、授業に出なきゃ。それから、もしかしたら"}, {"type": "subtitle", "time": 10823.59, "timestamp": "03:00:23", "text": "朝に配信するかな。ああ、そうそう。"}, {"type": "subtitle", "time": 10825.349, "timestamp": "03:00:25", "text": "朝の"}, {"type": "subtitle", "time": 10827.11, "timestamp": "03:00:27", "text": "授業が"}, {"type": "subtitle", "time": 10830.79, "timestamp": "03:00:30", "text": "6時半とかだから、"}, {"type": "subtitle", "time": 10832.95, "timestamp": "03:00:32", "text": "技術的には"}, {"type": "subtitle", "time": 10839.349, "timestamp": "03:00:39", "text": "10時に朝の配信もできるかもしれない。"}, {"type": "subtitle", "time": 10841.83, "timestamp": "03:00:41", "text": "それとも、夕方とか、"}, {"type": "subtitle", "time": 10850.95, "timestamp": "03:00:50", "text": "試してみます。"}, {"type": "subtitle", "time": 10857.19, "timestamp": "03:00:57", "text": "もっと聞かせて。"}]
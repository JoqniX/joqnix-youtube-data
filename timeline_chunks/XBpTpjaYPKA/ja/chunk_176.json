[{"type": "subtitle", "time": 10560.87, "timestamp": "02:56:00", "text": "サイトに表示されるんです。"}, {"type": "subtitle", "time": 10563.11, "timestamp": "02:56:03", "text": "配信を開いたら、"}, {"type": "subtitle", "time": 10564.95, "timestamp": "02:56:04", "text": "「ああ、これはコラボ"}, {"type": "subtitle", "time": 10567.349, "timestamp": "02:56:07", "text": "配信だったんだ」って分かるんです。ここでコラボ"}, {"type": "subtitle", "time": 10569.67, "timestamp": "02:56:09", "text": "相手のソーシャルメディアを確認できます。"}, {"type": "subtitle", "time": 10572.469, "timestamp": "02:56:12", "text": "このクリエイターを応援したいなら、 コラボレーターの"}, {"type": "subtitle", "time": 10575.03, "timestamp": "02:56:15", "text": "リンクをクリックできるんです。例えば、"}, {"type": "subtitle", "time": 10578.71, "timestamp": "02:56:18", "text": "コールCTAとか、コールトゥアクションボタン"}, {"type": "subtitle", "time": 10583.349, "timestamp": "02:56:23", "text": "とか。すごく便利でしょ？"}, {"type": "subtitle", "time": 10585.83, "timestamp": "02:56:25", "text": "ええ。午前4時くらいだったかな"}, {"type": "subtitle", "time": 10589.51, "timestamp": "02:56:29", "text": "。"}, {"type": "subtitle", "time": 10591.99, "timestamp": "02:56:31", "text": "アイデアを練ったりいろいろ考えていたんだけど、"}, {"type": "subtitle", "time": 10593.83, "timestamp": "02:56:33", "text": "「よし、近いうちに"}, {"type": "subtitle", "time": 10598.23, "timestamp": "02:56:38", "text": "誰かとコラボしたり、"}, {"type": "subtitle", "time": 10601.19, "timestamp": "02:56:41", "text": "何かコラボしたりすることはないから、一体何の意味があるんだろう"}, {"type": "subtitle", "time": 10608.71, "timestamp": "02:56:48", "text": "ああ、もうやめなきゃ。もうやめなきゃ。"}, {"type": "subtitle", "time": 10610.95, "timestamp": "02:56:50", "text": "頭の中は"}, {"type": "subtitle", "time": 10613.51, "timestamp": "02:56:53", "text": "開発者モードみたいになっちゃった"}, {"type": "subtitle", "time": 10619.59, "timestamp": "02:56:59", "text": "でも、これは全部、ストリーミングのためなんだ。僕"}]
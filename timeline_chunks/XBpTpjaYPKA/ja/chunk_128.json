[{"type": "subtitle", "time": 7683.669, "timestamp": "02:08:03", "text": "でも、ええ、ええと、すべてがうまくいくことを願っています"}, {"type": "subtitle", "time": 7687.109, "timestamp": "02:08:07", "text": "。 ええ、"}, {"type": "subtitle", "time": 7690.629, "timestamp": "02:08:10", "text": "今週中にほとんどのことを終わらせるつもりです。 今日は"}, {"type": "subtitle", "time": 7694.629, "timestamp": "02:08:14", "text": "水曜日です。 明日は木曜日です。"}, {"type": "subtitle", "time": 7696.95, "timestamp": "02:08:16", "text": "今週の土曜日までに、たくさんの"}, {"type": "subtitle", "time": 7699.03, "timestamp": "02:08:19", "text": "ことを終わらせなければなりません。 よし。 毎日時間が"}, {"type": "subtitle", "time": 7703.189, "timestamp": "02:08:23", "text": "刻々と過ぎていくので、怠けてはいられません。"}, {"type": "subtitle", "time": 7705.589, "timestamp": "02:08:25", "text": "毎日2時間しか寝ていないので無理です"}, {"type": "subtitle", "time": 7707.91, "timestamp": "02:08:27", "text": "。 だから、最近は毎日頭が死んだように聞こえるんです"}, {"type": "subtitle", "time": 7713.75, "timestamp": "02:08:33", "text": "。 ああ、それはまずい。"}, {"type": "subtitle", "time": 7717.43, "timestamp": "02:08:37", "text": "うん。 ねえ、それは変だよ。 午前4時くらい。10"}, {"type": "subtitle", "time": 7722.55, "timestamp": "02:08:42", "text": "時に寝たような。 午前2時に目が覚めました。"}, {"type": "subtitle", "time": 7725.43, "timestamp": "02:08:45", "text": "そして、「よし、こんな"}, {"type": "subtitle", "time": 7728.31, "timestamp": "02:08:48", "text": "クレイジーなアイデアが浮かんだ」と思いました。 私はまるでチャドGBDと話しているようで、まるで声を出しているようでした"}, {"type": "subtitle", "time": 7735.27, "timestamp": "02:08:55", "text": "。 私は、ああそうだ"}, {"type": "subtitle", "time": 7737.51, "timestamp": "02:08:57", "text": "、こんなクレイジーなアイデアがあるんだ、と話していました。 さて、"}]
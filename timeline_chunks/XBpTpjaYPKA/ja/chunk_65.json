[{"type": "subtitle", "time": 3903.99, "timestamp": "01:05:03", "text": "あ、スマイルチェック。あ、スマイルチェックは"}, {"type": "subtitle", "time": 3907.829, "timestamp": "01:05:07", "text": "基本的にコミュニティの目標と"}, {"type": "subtitle", "time": 3911.029, "timestamp": "01:05:11", "text": "言えるものなんだ。つまり、"}, {"type": "subtitle", "time": 3913.27, "timestamp": "01:05:13", "text": "チャンネルポイントに余裕があれば、"}, {"type": "subtitle", "time": 3916.15, "timestamp": "01:05:16", "text": "それを目標に寄付できる。スマイルチェックは、えっと、"}, {"type": "subtitle", "time": 3924.069, "timestamp": "01:05:24", "text": "どう言えばいいかな、「"}, {"type": "subtitle", "time": 3927.349, "timestamp": "01:05:27", "text": "こんにちは、お元気ですか？"}, {"type": "subtitle", "time": 3930.069, "timestamp": "01:05:30", "text": "良い一日を過ごしていますか？"}, {"type": "subtitle", "time": 3941.109, "timestamp": "01:05:41", "text": "それが私がやりたかったことなんだ。"}, {"type": "subtitle", "time": 3950.23, "timestamp": "01:05:50", "text": "待って、なぜQ HQを使っているんだ？"}, {"type": "subtitle", "time": 3958.789, "timestamp": "01:05:58", "text": "ポイントを全部寄付したんだね。"}]
[{"type": "subtitle", "time": 377.99, "timestamp": "00:06:17", "text": "ああ、こんにちは。 待って、私はできるだろうか？"}, {"type": "subtitle", "time": 381.029, "timestamp": "00:06:21", "text": "こんにちは、みんな。 えっと、それは"}, {"type": "subtitle", "time": 383.11, "timestamp": "00:06:23", "text": "永遠に続いています。"}, {"type": "subtitle", "time": 386.87, "timestamp": "00:06:26", "text": "こんにちは。 えっと、ちょっと待ってください。"}, {"type": "subtitle", "time": 392.23, "timestamp": "00:06:32", "text": "ここでマイクを交換しなければなりません。"}, {"type": "subtitle", "time": 396.87, "timestamp": "00:06:36", "text": "ええ、私のPCはめちゃくちゃです。"}, {"type": "subtitle", "time": 400.79, "timestamp": "00:06:40", "text": "ああ、それは本当にひどいことだ。   こんなに"}, {"type": "subtitle", "time": 406.23, "timestamp": "00:06:46", "text": "長い間ストリーミングしていませんでした。"}, {"type": "subtitle", "time": 410.87, "timestamp": "00:06:50", "text": "えーっと、もう3ヶ月3週間経ちました。 もう"}, {"type": "subtitle", "time": 414.39, "timestamp": "00:06:54", "text": "3ヶ月くらいだと思います。 聖なる。"}, {"type": "subtitle", "time": 416.87, "timestamp": "00:06:56", "text": "えーっと。   わかった"}, {"type": "subtitle", "time": 418.71, "timestamp": "00:06:58", "text": "。  PCの動作が遅くなっています。"}]
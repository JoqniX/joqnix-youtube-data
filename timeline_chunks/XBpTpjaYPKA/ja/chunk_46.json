[{"type": "subtitle", "time": 2760.55, "timestamp": "00:46:00", "text": "うん。"}, {"type": "subtitle", "time": 2763.51, "timestamp": "00:46:03", "text": "こんにちは、カネキさん。 こんにちは。 こんにちは。 神聖なる幸せ。"}, {"type": "subtitle", "time": 2765.19, "timestamp": "00:46:05", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 2767.109, "timestamp": "00:46:07", "text": "あなたが日本語に戻る時間を探しています"}, {"type": "subtitle", "time": 2769.27, "timestamp": "00:46:09", "text": "。 うん。 はい。 はい。 はい。"}, {"type": "subtitle", "time": 2771.109, "timestamp": "00:46:11", "text": "来月。"}, {"type": "subtitle", "time": 2772.63, "timestamp": "00:46:12", "text": "興奮した。   そうですね"}, {"type": "subtitle", "time": 2775.27, "timestamp": "00:46:15", "text": "。 基本的に、私は"}, {"type": "subtitle", "time": 2778.71, "timestamp": "00:46:18", "text": "すべてのものをクラウドに移行してきました。   ええ"}, {"type": "subtitle", "time": 2783.75, "timestamp": "00:46:23", "text": "、"}, {"type": "subtitle", "time": 2804.15, "timestamp": "00:46:44", "text": "待って。 うーん、そうそう、お祝いはしません。"}, {"type": "subtitle", "time": 2807.109, "timestamp": "00:46:47", "text": "でも"}, {"type": "subtitle", "time": 2810.55, "timestamp": "00:46:50", "text": "待ってください、人々はホリーに願いをかけるんですよね？"}, {"type": "subtitle", "time": 2813.67, "timestamp": "00:46:53", "text": "今日はどうしてストリーミングするんですか？ それは長い"}, {"type": "subtitle", "time": 2815.67, "timestamp": "00:46:55", "text": "話です。"}, {"type": "subtitle", "time": 2817.19, "timestamp": "00:46:57", "text": "えーっと、"}]
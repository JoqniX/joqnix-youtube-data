[{"type": "subtitle", "time": 10980.309, "timestamp": "03:03:00", "text": "。もうしばらく練習してないから、"}, {"type": "subtitle", "time": 10982.95, "timestamp": "03:03:02", "text": "少なくとも何かしなきゃ。うん、"}, {"type": "subtitle", "time": 10984.63, "timestamp": "03:03:04", "text": "主にこういうチャット系の配信を期待してるんだ"}, {"type": "subtitle", "time": 10986.15, "timestamp": "03:03:06", "text": "。みんなとチャットしたい"}, {"type": "subtitle", "time": 10989.19, "timestamp": "03:03:09", "text": "。"}, {"type": "subtitle", "time": 10993.349, "timestamp": "03:03:13", "text": "来てもらえるとすごく嬉しいよ。うーん、"}, {"type": "subtitle", "time": 10995.59, "timestamp": "03:03:15", "text": "もう予期せぬ配信はしない。"}, {"type": "subtitle", "time": 10998.79, "timestamp": "03:03:18", "text": "早めにスケジュールするよ。"}, {"type": "subtitle", "time": 11001.75, "timestamp": "03:03:21", "text": "配信に遅延があったらツイートするか、"}, {"type": "subtitle", "time": 11005.67, "timestamp": "03:03:25", "text": "配信のチャットでメンションするよ。わかった。"}, {"type": "subtitle", "time": 11009.59, "timestamp": "03:03:29", "text": "心配しないで。さあ、"}, {"type": "subtitle", "time": 11013.59, "timestamp": "03:03:33", "text": "まとめるよ。待って。"}, {"type": "subtitle", "time": 11015.59, "timestamp": "03:03:35", "text": "ああ、そうそう。自動化を作らないと"}, {"type": "subtitle", "time": 11017.75, "timestamp": "03:03:37", "text": "。配信を終えたら、24時間"}, {"type": "subtitle", "time": 11024.71, "timestamp": "03:03:44", "text": "365日チャンネルに自動的に切り替わる。あ、"}, {"type": "subtitle", "time": 11027.19, "timestamp": "03:03:47", "text": "それと自動的にピン留めもね。 彼らに。ああ、待って。Twitch では"}]
[{"type": "subtitle", "time": 1021.99, "timestamp": "00:17:01", "text": "GitHub アクションなど、スケジュールに従って定期的に実行されます。"}, {"type": "subtitle", "time": 1024.309, "timestamp": "00:17:04", "text": "ということでアーカイブページを作りました。 えーっと、"}, {"type": "subtitle", "time": 1027.51, "timestamp": "00:17:07", "text": "Twitterの私のサブアカウントに気づいた方は、"}, {"type": "subtitle", "time": 1030.309, "timestamp": "00:17:10", "text": "リンクを4時間くらいちょっとだけ見たかもしれませんが、"}, {"type": "subtitle", "time": 1033.429, "timestamp": "00:17:13", "text": "その後"}, {"type": "subtitle", "time": 1036.71, "timestamp": "00:17:16", "text": "削除しました。 私は URL 関連のものをテストしていたのです"}, {"type": "subtitle", "time": 1038.789, "timestamp": "00:17:18", "text": "。"}, {"type": "subtitle", "time": 1042.23, "timestamp": "00:17:22", "text": "うん。 うん。 うん。 えっと、URL とか"}, {"type": "subtitle", "time": 1044.549, "timestamp": "00:17:24", "text": "その他いろいろ。 なぜ私はテクノロジーについて喋っているのでしょうか"}, {"type": "subtitle", "time": 1055.11, "timestamp": "00:17:35", "text": "ああ、でも、本当に、ああ、それをやれてよかったよ"}, {"type": "subtitle", "time": 1056.87, "timestamp": "00:17:36", "text": "。"}, {"type": "subtitle", "time": 1059.51, "timestamp": "00:17:39", "text": "本当によかったです。"}, {"type": "subtitle", "time": 1063.75, "timestamp": "00:17:43", "text": "あまり価値がない、もしくは、"}, {"type": "subtitle", "time": 1069.19, "timestamp": "00:17:49", "text": "YouTube ストリームのすべてに同じようになるだけかもしれませんね。 彼らの記録は"}, {"type": "subtitle", "time": 1071.27, "timestamp": "00:17:51", "text": "そこにあります。"}, {"type": "subtitle", "time": 1074.63, "timestamp": "00:17:54", "text": "YouTube で見るサブトランスクリプト全体、つまり YouTube では"}, {"type": "subtitle", "time": 1077.35, "timestamp": "00:17:57", "text": "動画のトランスクリプトなどを見ることができますよ"}, {"type": "subtitle", "time": 1079.59, "timestamp": "00:17:59", "text": "ね?"}]
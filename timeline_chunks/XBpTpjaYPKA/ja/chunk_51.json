[{"type": "subtitle", "time": 3063.75, "timestamp": "00:51:03", "text": "今月はGSTを申告しないといけないんです。ここ4ヶ月、"}, {"type": "subtitle", "time": 3067.589, "timestamp": "00:51:07", "text": "JocknのGSTの書類を申告してなかったんです"}, {"type": "subtitle", "time": 3069.829, "timestamp": "00:51:09", "text": "。税務署の人と話をして、「あまり"}, {"type": "subtitle", "time": 3076.069, "timestamp": "00:51:16", "text": "稼いでいないから、これを自動でやってくれないか」って言わないといけないし、"}, {"type": "chat", "time": 3081.992, "timestamp": "00:51:21", "author": "@abhaynair7276", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m3_pcx7bakRsuScPVawS3lNZlHTFLM8XHTpdd1EGU=s64-c-k-c0x00ffffff-no-rj", "message": "GST!!????"}, {"type": "subtitle", "time": 3082.23, "timestamp": "00:51:22", "text": "YouTubeの支払いもやらないといけないんです。"}, {"type": "subtitle", "time": 3085.67, "timestamp": "00:51:25", "text": "銀行と話をして、"}, {"type": "subtitle", "time": 3095.51, "timestamp": "00:51:35", "text": "YouTubeの支払いがあるたびに書類に捺印するために直接行かなくて済むように、自動的にやらないといけないんです。だって"}, {"type": "subtitle", "time": 3097.91, "timestamp": "00:51:37", "text": "銀行がお金を保留してくれるから。"}, {"type": "subtitle", "time": 3099.75, "timestamp": "00:51:39", "text": "だからそうしないといけないんです。YouTubeの"}, {"type": "subtitle", "time": 3107.99, "timestamp": "00:51:47", "text": "支払いとかが入るたびにDiscordに送られてくるような自動システムを作ったんですが、"}, {"type": "subtitle", "time": 3111.27, "timestamp": "00:51:51", "text": "金額を確認して"}, {"type": "subtitle", "time": 3114.15, "timestamp": "00:51:54", "text": "自動的に"}, {"type": "subtitle", "time": 3118.71, "timestamp": "00:51:58", "text": "請求書のテンプレートを作ってくれるんです。請求書システムがあるんです。 やっと"}]
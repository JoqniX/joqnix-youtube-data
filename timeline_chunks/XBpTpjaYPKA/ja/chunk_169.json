[{"type": "subtitle", "time": 10141.51, "timestamp": "02:49:01", "text": "人、つまり、私は"}, {"type": "subtitle", "time": 10146.15, "timestamp": "02:49:06", "text": "過剰に説明しがちな人っていうのがいるから。人はそんな過剰な"}, {"type": "subtitle", "time": 10150.07, "timestamp": "02:49:10", "text": "説明を聞かないよね？"}, {"type": "subtitle", "time": 10152.309, "timestamp": "02:49:12", "text": "その人が何"}, {"type": "subtitle", "time": 10155.11, "timestamp": "02:49:15", "text": "について話しているのか分かっていなければ、聞くよね。"}, {"type": "subtitle", "time": 10157.67, "timestamp": "02:49:17", "text": "普通の人だったら、ざっと目を通すだけで、"}, {"type": "subtitle", "time": 10163.51, "timestamp": "02:49:23", "text": "TLDDRみたいなものを好むよね？ ええ。それが、あの"}, {"type": "subtitle", "time": 10167.269, "timestamp": "02:49:27", "text": "技術的な詳細の動画をアップロードしなかった理由の一つでもあります。私は"}, {"type": "subtitle", "time": 10172.71, "timestamp": "02:49:32", "text": "、ええ、私たちが長々と何かについてしゃべりまくってるのを見て、"}, {"type": "subtitle", "time": 10175.51, "timestamp": "02:49:35", "text": "なぜ？"}]
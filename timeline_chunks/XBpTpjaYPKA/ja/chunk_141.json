[{"type": "subtitle", "time": 8461.51, "timestamp": "02:21:01", "text": "そうですね、そうだと思います。 うん。 うん。"}, {"type": "subtitle", "time": 8469.349, "timestamp": "02:21:09", "text": "とてもいいですね。"}, {"type": "subtitle", "time": 8477.99, "timestamp": "02:21:17", "text": "つまり、あなたが厳密に言うとクラブの会長であれば、"}, {"type": "subtitle", "time": 8483.99, "timestamp": "02:21:23", "text": "アニメなどにあるように、あなたは創立メンバーなので、"}, {"type": "subtitle", "time": 8487.75, "timestamp": "02:21:27", "text": "自分のクラブルームを持つことになります。 えっと、"}, {"type": "subtitle", "time": 8495.51, "timestamp": "02:21:35", "text": "クラブのメンバーと計画や活動について話し合ったり、"}, {"type": "subtitle", "time": 8500.55, "timestamp": "02:21:40", "text": "文化祭などの​​クラブの展示会があるときは、"}, {"type": "subtitle", "time": 8507.19, "timestamp": "02:21:47", "text": "クラブも何かをしなければなりませんよね、"}, {"type": "subtitle", "time": 8510.469, "timestamp": "02:21:50", "text": "準備をしたり、クラブメイトと話したり、"}, {"type": "subtitle", "time": 8514.79, "timestamp": "02:21:54", "text": "絆を深めたり。ああ、楽しかった。"}, {"type": "subtitle", "time": 8516.95, "timestamp": "02:21:56", "text": "えっと、"}, {"type": "subtitle", "time": 8519.91, "timestamp": "02:21:59", "text": "これは課外活動のPTP"}]
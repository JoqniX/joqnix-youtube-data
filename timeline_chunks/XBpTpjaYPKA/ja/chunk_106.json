[{"type": "subtitle", "time": 6361.43, "timestamp": "01:46:01", "text": "クリックしたときに効果音を鳴らしたりできる拡張機能があります"}, {"type": "subtitle", "time": 6364.149, "timestamp": "01:46:04", "text": "。 そういうのはたくさんあります"}, {"type": "subtitle", "time": 6366.149, "timestamp": "01:46:06", "text": "。 これらはすべて Twitch"}, {"type": "subtitle", "time": 6368.55, "timestamp": "01:46:08", "text": "拡張機能です。"}, {"type": "subtitle", "time": 6370.55, "timestamp": "01:46:10", "text": "あなたが見ているのはオーバーレイ拡張機能で、"}, {"type": "subtitle", "time": 6374.709, "timestamp": "01:46:14", "text": "下にスクロールすると、エモートのようなものが表示されます。"}, {"type": "subtitle", "time": 6382.95, "timestamp": "01:46:22", "text": "私のエモートは拡張機能です。次に、"}, {"type": "subtitle", "time": 6387.03, "timestamp": "01:46:27", "text": "場所を表示して移動します。これも"}, {"type": "subtitle", "time": 6389.83, "timestamp": "01:46:29", "text": "拡張機能です。これらはパネル"}, {"type": "subtitle", "time": 6391.59, "timestamp": "01:46:31", "text": "拡張機能です。Twitch"}, {"type": "subtitle", "time": 6396.149, "timestamp": "01:46:36", "text": "では、"}, {"type": "subtitle", "time": 6402.39, "timestamp": "01:46:42", "text": "Bits などでこれを行うことができます。 うん。 うん。 うん。 私は"}, {"type": "subtitle", "time": 6404.95, "timestamp": "01:46:44", "text": "BitsとMortとその他すべてを持っています。"}, {"type": "subtitle", "time": 6407.35, "timestamp": "01:46:47", "text": "7TVもあります。"}, {"type": "subtitle", "time": 6410.87, "timestamp": "01:46:50", "text": "ブラウザに 7TV 拡張機能がインストールされている場合は、"}, {"type": "subtitle", "time": 6415.109, "timestamp": "01:46:55", "text": "それらを使用できます。 より優れた Twitch"}]
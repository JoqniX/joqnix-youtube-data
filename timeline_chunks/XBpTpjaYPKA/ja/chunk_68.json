[{"type": "subtitle", "time": 4087.51, "timestamp": "01:08:07", "text": "順調だと思う。"}, {"type": "subtitle", "time": 4089.91, "timestamp": "01:08:09", "text": "うん。もし今、俺のウェブサイトのこととか、そういうことで何かアイデアがあれば、"}, {"type": "subtitle", "time": 4096.87, "timestamp": "01:08:16", "text": "教えてくれ。"}, {"type": "subtitle", "time": 4100.149, "timestamp": "01:08:20", "text": "提案は大歓迎だ。わかった。"}, {"type": "subtitle", "time": 4114.149, "timestamp": "01:08:34", "text": "コーディングはすごい。"}, {"type": "subtitle", "time": 4117.669, "timestamp": "01:08:37", "text": "サミーみたいに、"}, {"type": "subtitle", "time": 4120.87, "timestamp": "01:08:40", "text": "3週間以上もかかって、"}, {"type": "subtitle", "time": 4124.95, "timestamp": "01:08:44", "text": "構造化されて複雑で非常に詳細な"}, {"type": "subtitle", "time": 4126.789, "timestamp": "01:08:46", "text": "設定を全部やらなきゃいけないんだ。コーディングは詳しくない"}, {"type": "subtitle", "time": 4133.03, "timestamp": "01:08:53", "text": "けど、"}, {"type": "subtitle", "time": 4138.789, "timestamp": "01:08:58", "text": "チップを使ってコーディングしたりして。 あれ。"}]
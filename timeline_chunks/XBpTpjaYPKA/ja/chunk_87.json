[{"type": "subtitle", "time": 5221.51, "timestamp": "01:27:01", "text": "。うんうん。"}, {"type": "subtitle", "time": 5231.03, "timestamp": "01:27:11", "text": "新しいモデルのやつが手に入ったら、チャンネルのBFPとか全部更新するつもり"}, {"type": "subtitle", "time": 5241.27, "timestamp": "01:27:21", "text": "新しいモデルの公開は、"}, {"type": "subtitle", "time": 5245.99, "timestamp": "01:27:25", "text": "今年中にやろうと思ってたんだけど。いつになるかはわからないけど"}, {"type": "subtitle", "time": 5250.95, "timestamp": "01:27:30", "text": "。みんなに知らせるよ。"}, {"type": "subtitle", "time": 5252.47, "timestamp": "01:27:32", "text": "それで、"}, {"type": "subtitle", "time": 5256.229, "timestamp": "01:27:36", "text": "みんなに知らせるよ。"}, {"type": "subtitle", "time": 5261.189, "timestamp": "01:27:41", "text": "水を飲もう。"}, {"type": "subtitle", "time": 5263.11, "timestamp": "01:27:43", "text": "水分補給のリマインダー、ありがとう。みんなも"}, {"type": "subtitle", "time": 5273.59, "timestamp": "01:27:53", "text": "待って、もし"}, {"type": "subtitle", "time": 5277.669, "timestamp": "01:27:57", "text": "チャンネルポイントの引き換えをこんな風に記録できたらすごくいいな。そうすれば、"}]
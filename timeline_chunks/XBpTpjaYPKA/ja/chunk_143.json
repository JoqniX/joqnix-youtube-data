[{"type": "subtitle", "time": 8581.67, "timestamp": "02:23:01", "text": "本当に、本当に楽しそうですね。"}, {"type": "subtitle", "time": 8596.469, "timestamp": "02:23:16", "text": "ルームメイトがいます。 だから、"}, {"type": "subtitle", "time": 8602.55, "timestamp": "02:23:22", "text": "ルームメイトが私の部屋、つまりドムルームにいるから、私がストリーミングなどをしているときに、"}, {"type": "subtitle", "time": 8610.15, "timestamp": "02:23:30", "text": "私がしゃべったり話したりするのをただ見ているだけなので、このように大声でしゃべってもよいのかどうか分からない"}, {"type": "subtitle", "time": 8613.83, "timestamp": "02:23:33", "text": "。"}, {"type": "subtitle", "time": 8616.309, "timestamp": "02:23:36", "text": "他にできることは"}, {"type": "subtitle", "time": 8619.19, "timestamp": "02:23:39", "text": "カフェに行ってやることです。でも今は公共のスペースなので"}, {"type": "subtitle", "time": 8622.389, "timestamp": "02:23:42", "text": "ライブ配信するには負担が大きすぎます。"}, {"type": "subtitle", "time": 8625.83, "timestamp": "02:23:45", "text": "外出もできますし、"}, {"type": "subtitle", "time": 8630.469, "timestamp": "02:23:50", "text": "仕事などもできます"}, {"type": "subtitle", "time": 8633.91, "timestamp": "02:23:53", "text": "。 うん。   何か"}, {"type": "subtitle", "time": 8635.59, "timestamp": "02:23:55", "text": "新しいことを教えてくれませんか？   特に"}, {"type": "subtitle", "time": 8637.83, "timestamp": "02:23:57", "text": "新しいことは何もありません。 ええ、基本的には"}]
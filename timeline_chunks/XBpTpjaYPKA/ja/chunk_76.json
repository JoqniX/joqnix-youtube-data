[{"type": "subtitle", "time": 4600.95, "timestamp": "01:16:40", "text": "なぜビットって何なんだろうと思ってたら、"}, {"type": "subtitle", "time": 4604.39, "timestamp": "01:16:44", "text": "1ビットが195ルピーと表示されてた。"}, {"type": "subtitle", "time": 4607.27, "timestamp": "01:16:47", "text": "待って、何？待って"}, {"type": "subtitle", "time": 4608.95, "timestamp": "01:16:48", "text": "、ビットの値段が上がったの"}, {"type": "subtitle", "time": 4618.95, "timestamp": "01:16:58", "text": "待って、1ビット。いや、1ビット138ルピーが400"}]
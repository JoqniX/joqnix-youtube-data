[{"type": "subtitle", "time": 543.99, "timestamp": "00:09:03", "text": "PC が壊れてしまいました。 うん。 うん。   ええと、ええと、"}, {"type": "subtitle", "time": 551.75, "timestamp": "00:09:11", "text": "配信したかったけどできなかった理由の 1 つは、"}, {"type": "subtitle", "time": 553.43, "timestamp": "00:09:13", "text": "ええと、"}, {"type": "subtitle", "time": 557.03, "timestamp": "00:09:17", "text": "主に、たくさんのことをした後で毎日疲れてしまうことです。"}, {"type": "subtitle", "time": 566.15, "timestamp": "00:09:26", "text": "ええと、残りのライフ スタディの"}, {"type": "subtitle", "time": 568.63, "timestamp": "00:09:28", "text": "準備に触れたり、ええと、今月が"}, {"type": "subtitle", "time": 572.23, "timestamp": "00:09:32", "text": "最後の月なので、私のほうで多くのことが順調に進んでいます。"}, {"type": "subtitle", "time": 576.71, "timestamp": "00:09:36", "text": "配信したいのですが、"}, {"type": "subtitle", "time": 579.99, "timestamp": "00:09:39", "text": "配信できません。 でも、そうですね、今週はずっと、"}, {"type": "subtitle", "time": 582.55, "timestamp": "00:09:42", "text": "よし、"}, {"type": "subtitle", "time": 586.07, "timestamp": "00:09:46", "text": "ストリーミング配信しようって思ってたんです。 配信します。 えっと、"}, {"type": "subtitle", "time": 588.79, "timestamp": "00:09:48", "text": "月曜日はストリーミングするつもりでした。"}, {"type": "subtitle", "time": 591.59, "timestamp": "00:09:51", "text": "1時間か"}, {"type": "subtitle", "time": 595.19, "timestamp": "00:09:55", "text": "30分の短いストリームをやるつもりです。"}, {"type": "subtitle", "time": 596.949, "timestamp": "00:09:56", "text": "試験の準備のために復習したり勉強したりしましたが、それはまったく"}]
[{"type": "subtitle", "time": 10023.75, "timestamp": "02:47:03", "text": "技術的な話が多すぎる。いや、でもいいですね。でも"}, {"type": "subtitle", "time": 10039.429, "timestamp": "02:47:19", "text": "。でも、コーディングができるようになればいいのに。自分は"}, {"type": "subtitle", "time": 10044.79, "timestamp": "02:47:24", "text": "技術オタクというか、コーディングとかに詳しいみたいなところがあるんだけど、実は何も知らないんです"}, {"type": "subtitle", "time": 10055.51, "timestamp": "02:47:35", "text": "。HTMLも"}, {"type": "subtitle", "time": 10060.389, "timestamp": "02:47:40", "text": "CSSも何もわからない。YouTubeの"}, {"type": "subtitle", "time": 10064.87, "timestamp": "02:47:44", "text": "チュートリアルを見て「"}, {"type": "subtitle", "time": 10067.91, "timestamp": "02:47:47", "text": "これはこれだ」って理解してからやってみる。だから"}, {"type": "subtitle", "time": 10070.15, "timestamp": "02:47:50", "text": "私のウェブ"}, {"type": "subtitle", "time": 10072.55, "timestamp": "02:47:52", "text": "サイトも本当にひどい。CSSもあまり"}, {"type": "subtitle", "time": 10075.75, "timestamp": "02:47:55", "text": "知らないから"}]
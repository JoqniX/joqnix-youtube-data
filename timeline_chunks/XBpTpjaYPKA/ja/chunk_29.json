[{"type": "subtitle", "time": 1751.269, "timestamp": "00:29:11", "text": "そうですね、私の現在の設定は"}, {"type": "subtitle", "time": 1755.029, "timestamp": "00:29:15", "text": "良いのはわかっていますが、とにかく、"}, {"type": "subtitle", "time": 1768.07, "timestamp": "00:29:28", "text": "システム全体をクリーンアップして、"}, {"type": "subtitle", "time": 1770.63, "timestamp": "00:29:30", "text": "多くのものをクラウドにバックアップするために、必要なものをすべて削除するつもりです。 ああ"}, {"type": "subtitle", "time": 1773.83, "timestamp": "00:29:33", "text": "、投稿してしまいました。"}, {"type": "subtitle", "time": 1777.029, "timestamp": "00:29:37", "text": "一週間以内にやらなければいけません。"}, {"type": "subtitle", "time": 1779.35, "timestamp": "00:29:39", "text": "さて、これらのことをすぐにやって、安定した"}, {"type": "subtitle", "time": 1784.149, "timestamp": "00:29:44", "text": "ショーに戻りましょう。  30分くらいかな"}, {"type": "subtitle", "time": 1787.35, "timestamp": "00:29:47", "text": "？ うん。 はい、大丈夫ですよ。"}]
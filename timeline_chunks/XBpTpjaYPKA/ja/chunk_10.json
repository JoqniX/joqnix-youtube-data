[{"type": "subtitle", "time": 601.91, "timestamp": "00:10:01", "text": "起こりませんでした。"}, {"type": "subtitle", "time": 605.03, "timestamp": "00:10:05", "text": "火曜日。 同じことです。"}, {"type": "subtitle", "time": 606.79, "timestamp": "00:10:06", "text": "うん。"}, {"type": "subtitle", "time": 609.829, "timestamp": "00:10:09", "text": "今月はずっとラッシュアワーのような感じで、"}, {"type": "subtitle", "time": 616.389, "timestamp": "00:10:16", "text": "いろんなことを急いでやらないといけないんです。 すべてをやり遂げてください"}, {"type": "subtitle", "time": 618.47, "timestamp": "00:10:18", "text": "。"}, {"type": "subtitle", "time": 620.47, "timestamp": "00:10:20", "text": "うん。 うん。"}, {"type": "subtitle", "time": 623.43, "timestamp": "00:10:23", "text": "すべてをクラウドに移行する必要があります。 いろいろあります。"}, {"type": "subtitle", "time": 627.03, "timestamp": "00:10:27", "text": "まあ、それはクレイジーだよ。 正直、"}, {"type": "subtitle", "time": 629.35, "timestamp": "00:10:29", "text": "クレイジーです。"}, {"type": "subtitle", "time": 633.99, "timestamp": "00:10:33", "text": "うーん、私の音声が良いのか"}, {"type": "subtitle", "time": 638.63, "timestamp": "00:10:38", "text": "悪いのか分かりません。 えっと、昨日から"}, {"type": "subtitle", "time": 643.269, "timestamp": "00:10:43", "text": "Elgato が"}, {"type": "subtitle", "time": 645.99, "timestamp": "00:10:45", "text": "Wavelink 3.0 のアップデート、"}, {"type": "subtitle", "time": 649.269, "timestamp": "00:10:49", "text": "安定版のような完全なアップデートをリリースしました。 えーと、"}, {"type": "subtitle", "time": 654.87, "timestamp": "00:10:54", "text": "私はこのものを、えーと、全部失くしてしまいました"}, {"type": "subtitle", "time": 658.71, "timestamp": "00:10:58", "text": "。 失くしてしまいました。 私の背中全体が"}]
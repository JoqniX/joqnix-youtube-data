[{"type": "subtitle", "time": 10862.23, "timestamp": "03:01:02", "text": "ありがとう。君が僕の"}, {"type": "subtitle", "time": 10865.349, "timestamp": "03:01:05", "text": "話や"}, {"type": "subtitle", "time": 10884.79, "timestamp": "03:01:24", "text": "よし、スケジュールを確認させて。"}, {"type": "subtitle", "time": 10888.23, "timestamp": "03:01:28", "text": "今日は4時。よし、明日は配信できると思う"}, {"type": "subtitle", "time": 10890.55, "timestamp": "03:01:30", "text": "。いつか君と結婚したい"}, {"type": "subtitle", "time": 10913.99, "timestamp": "03:01:53", "text": "、そうだ。えっと、わかった。明日は配信するよ。"}, {"type": "subtitle", "time": 10918.07, "timestamp": "03:01:58", "text": "配信は頑張るよ。わかった。"}]
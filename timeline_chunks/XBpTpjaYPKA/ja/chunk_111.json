[{"type": "subtitle", "time": 6665.51, "timestamp": "01:51:05", "text": "思う。"}, {"type": "subtitle", "time": 6668.07, "timestamp": "01:51:08", "text": "うん。   そうそう"}, {"type": "subtitle", "time": 6683.59, "timestamp": "01:51:23", "text": "。 そういえば、えーっと、"}, {"type": "subtitle", "time": 6687.27, "timestamp": "01:51:27", "text": "その話ですが、えーっと、"}, {"type": "subtitle", "time": 6691.83, "timestamp": "01:51:31", "text": "前回の配信のとき、24時間"}, {"type": "subtitle", "time": 6699.35, "timestamp": "01:51:39", "text": "365日のチャンネルの作り方や技術的な"}, {"type": "subtitle", "time": 6701.589, "timestamp": "01:51:41", "text": "詳細などをビデオに録画していたんです。"}, {"type": "subtitle", "time": 6705.189, "timestamp": "01:51:45", "text": "ジョー、その 1 時間のセグメントをライブ ストリームで録画したのかと不思議に思うかもしれません"}, {"type": "subtitle", "time": 6708.07, "timestamp": "01:51:48", "text": "。 なぜアップロードしなかったのですか？"}, {"type": "subtitle", "time": 6713.99, "timestamp": "01:51:53", "text": "1時間以上あり、技術的すぎるため、アップロードしないことにしました。   あまりにも"}, {"type": "subtitle", "time": 6716.47, "timestamp": "01:51:56", "text": "複雑すぎます。 だから、こういうことを"}, {"type": "subtitle", "time": 6719.27, "timestamp": "01:51:59", "text": "過剰に説明しても意味がないと思ったんです。 そのままにしておきます"}]
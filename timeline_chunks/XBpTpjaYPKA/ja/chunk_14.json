[{"type": "subtitle", "time": 842.87, "timestamp": "00:14:02", "text": "そして、今日このストリームの後に、実際に"}, {"type": "subtitle", "time": 850.23, "timestamp": "00:14:10", "text": "ページが表示されるかもしれません。 えっと、つまりこれは私がここ"}, {"type": "subtitle", "time": 858.949, "timestamp": "00:14:18", "text": "数日間取り組んできた何かを意味します。"}, {"type": "subtitle", "time": 861.91, "timestamp": "00:14:21", "text": "ええと、あなたは私が"}, {"type": "subtitle", "time": 865.59, "timestamp": "00:14:25", "text": "ストリームやその他のことに関しては"}, {"type": "subtitle", "time": 868.31, "timestamp": "00:14:28", "text": "開発モードか何かを取得する傾向があることを知っていますが、それは"}, {"type": "subtitle", "time": 871.75, "timestamp": "00:14:31", "text": "良くありません。 それは"}, {"type": "subtitle", "time": 874.47, "timestamp": "00:14:34", "text": "複雑なもので、私たちはそれについて深く掘り下げていきます"}, {"type": "subtitle", "time": 878.629, "timestamp": "00:14:38", "text": "。 えっと、ちょっと待ってください"}, {"type": "subtitle", "time": 895.269, "timestamp": "00:14:55", "text": "、戻りました。"}, {"type": "subtitle", "time": 898.55, "timestamp": "00:14:58", "text": "それで、えーと、"}]
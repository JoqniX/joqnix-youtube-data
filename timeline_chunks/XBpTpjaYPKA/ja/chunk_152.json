[{"type": "subtitle", "time": 9130.309, "timestamp": "02:32:10", "text": "人生について、"}, {"type": "subtitle", "time": 9134.95, "timestamp": "02:32:14", "text": "もっとオープンに話すようにね。普通は"}, {"type": "subtitle", "time": 9138.71, "timestamp": "02:32:18", "text": "キャラクターを演じて、"}, {"type": "subtitle", "time": 9140.95, "timestamp": "02:32:20", "text": "感情を壊しちゃいけないし、そういうことを"}, {"type": "subtitle", "time": 9146.87, "timestamp": "02:32:26", "text": "3人で普通のストリーマーとしてやってる。"}, {"type": "subtitle", "time": 9149.349, "timestamp": "02:32:29", "text": "だから、"}, {"type": "subtitle", "time": 9151.51, "timestamp": "02:32:31", "text": "あちこちでちょっと気をつけないといけない。それが私が学んだこと。でも、それで"}, {"type": "subtitle", "time": 9159.03, "timestamp": "02:32:39", "text": "今の私って、よく叱られるんだよね"}, {"type": "subtitle", "time": 9163.11, "timestamp": "02:32:43", "text": "。一度口を開けば、"}, {"type": "subtitle", "time": 9166.15, "timestamp": "02:32:46", "text": "すごくオープンになる。例えば、"}, {"type": "subtitle", "time": 9173.83, "timestamp": "02:32:53", "text": "秘密にしなきゃいけないことがあったら、うっかり無意識に"}, {"type": "subtitle", "time": 9178.07, "timestamp": "02:32:58", "text": "それを明かしちゃう。「あら、ねえ、なんで"}]
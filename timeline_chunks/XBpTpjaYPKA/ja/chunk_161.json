[{"type": "subtitle", "time": 9661.67, "timestamp": "02:41:01", "text": "ここに何かを書き込むことができます。"}, {"type": "subtitle", "time": 9665.51, "timestamp": "02:41:05", "text": "ここをクリックして、ページを更新します。"}, {"type": "subtitle", "time": 9670.23, "timestamp": "02:41:10", "text": "待ってください。ほら、表示されます。"}, {"type": "subtitle", "time": 9673.59, "timestamp": "02:41:13", "text": "簡単ですね。さて、これからやることの一つは"}, {"type": "subtitle", "time": 9677.51, "timestamp": "02:41:17", "text": "この配信の後、「"}, {"type": "subtitle", "time": 9680.07, "timestamp": "02:41:20", "text": "コミュニティ貢献」という項目を作ります"}, {"type": "subtitle", "time": 9682.63, "timestamp": "02:41:22", "text": "。誰かが"}, {"type": "subtitle", "time": 9685.349, "timestamp": "02:41:25", "text": "私をフォローしてくれたり、寄付してくれたりしたら、"}, {"type": "subtitle", "time": 9688.71, "timestamp": "02:41:28", "text": "ここに表示されます。そうすると、"}, {"type": "subtitle", "time": 9691.03, "timestamp": "02:41:31", "text": "Zがこの配信、"}, {"type": "subtitle", "time": 9694.55, "timestamp": "02:41:34", "text": "Valerinの配信を1月13日にやったって分かります。"}, {"type": "subtitle", "time": 9696.79, "timestamp": "02:41:36", "text": "寄付してくれた人、フォローしてくれた人"}, {"type": "subtitle", "time": 9700.63, "timestamp": "02:41:40", "text": "、チャンネル登録してくれた人、そして時間が表示されています"}, {"type": "subtitle", "time": 9703.03, "timestamp": "02:41:43", "text": "。そう、これは私が作ったんです。"}, {"type": "subtitle", "time": 9706.95, "timestamp": "02:41:46", "text": "時間をクリックすると、"}, {"type": "subtitle", "time": 9709.19, "timestamp": "02:41:49", "text": "プレイヤーの頭が表示されます。いや、クリックすると"}, {"type": "subtitle", "time": 9712.389, "timestamp": "02:41:52", "text": "2分になります"}, {"type": "subtitle", "time": 9716.15, "timestamp": "02:41:56", "text": "。そうそう。Billy"}, {"type": "subtitle", "time": 9718.15, "timestamp": "02:41:58", "text": "Billyのボタンもあります。この配信が"}]
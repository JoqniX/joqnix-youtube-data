[{"type": "subtitle", "time": 9005.349, "timestamp": "02:30:05", "text": "動画を投稿したり、"}, {"type": "subtitle", "time": 9007.19, "timestamp": "02:30:07", "text": "アナウンスしたり、そういうことをさりげなく発表すればよかった。「あ、日本に引っ越すんだ。"}, {"type": "subtitle", "time": 9012.309, "timestamp": "02:30:12", "text": "じゃあね」って。誰も"}, {"type": "subtitle", "time": 9013.99, "timestamp": "02:30:13", "text": "驚かないだろうね。 そして"}, {"type": "subtitle", "time": 9016.71, "timestamp": "02:30:16", "text": "幸せ。ああ、それだけ。でも、もし私が"}, {"type": "subtitle", "time": 9019.11, "timestamp": "02:30:19", "text": "それについて話し続けて、興奮とか"}, {"type": "subtitle", "time": 9023.11, "timestamp": "02:30:23", "text": "、そういうのは構わないんです。"}, {"type": "subtitle", "time": 9026.23, "timestamp": "02:30:26", "text": "でもええ、私には良い"}, {"type": "subtitle", "time": 9028.389, "timestamp": "02:30:28", "text": "経験も悪い経験もありました。だから"}, {"type": "subtitle", "time": 9036.07, "timestamp": "02:30:36", "text": "、ご存知のとおり、オンラインのプライバシーについては、気をつけないといけません"}, {"type": "subtitle", "time": 9038.469, "timestamp": "02:30:38", "text": "。"}, {"type": "subtitle", "time": 9041.75, "timestamp": "02:30:41", "text": "私はそれにとても不注意で、"}, {"type": "subtitle", "time": 9045.19, "timestamp": "02:30:45", "text": "苦労してそれを学びました。"}, {"type": "subtitle", "time": 9047.11, "timestamp": "02:30:47", "text": "ええ、兄弟。あなたがそれをすると、あなたは"}, {"type": "subtitle", "time": 9049.91, "timestamp": "02:30:49", "text": "苦しむことになります。"}, {"type": "subtitle", "time": 9057.349, "timestamp": "02:30:57", "text": "あなたは私を良いものとして捉えています。最高の読者。"}, {"type": "subtitle", "time": 9059.67, "timestamp": "02:30:59", "text": "私たちは最高の視聴者です。"}]
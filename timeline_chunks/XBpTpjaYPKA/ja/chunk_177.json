[{"type": "subtitle", "time": 10621.59, "timestamp": "02:57:01", "text": "にとっては、チュービング（動画配信）っていう、"}, {"type": "subtitle", "time": 10624.23, "timestamp": "02:57:04", "text": "情熱を注いでいるもの。"}, {"type": "subtitle", "time": 10625.83, "timestamp": "02:57:05", "text": "だから、"}, {"type": "subtitle", "time": 10627.75, "timestamp": "02:57:07", "text": "いいことだよね？"}, {"type": "subtitle", "time": 10630.79, "timestamp": "02:57:10", "text": "こう考えると、自分の"}, {"type": "subtitle", "time": 10634.95, "timestamp": "02:57:14", "text": "都合のためにやってるって思える。いや、都合じゃなくて、"}, {"type": "subtitle", "time": 10638.71, "timestamp": "02:57:18", "text": "生活の質のためだよね？コンテンツ制作の"}, {"type": "subtitle", "time": 10644.79, "timestamp": "02:57:24", "text": "卒業生って、"}, {"type": "subtitle", "time": 10647.429, "timestamp": "02:57:27", "text": "複数のプラットフォームに投稿したり、"}, {"type": "subtitle", "time": 10649.59, "timestamp": "02:57:29", "text": "あれこれアナウンスしたり、あれこれやったり、そういうことを気にしなきゃいけないのに、全部"}, {"type": "subtitle", "time": 10651.75, "timestamp": "02:57:31", "text": "自動化して、余計な余計なことをやってるんだよね。"}, {"type": "subtitle", "time": 10665.91, "timestamp": "02:57:45", "text": "でも、いい感じだよ。だって、やり"}]
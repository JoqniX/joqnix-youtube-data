[{"type": "subtitle", "time": 7923.51, "timestamp": "02:12:03", "text": "他の人が送信した「いいね！」のようなエモートを見ると、"}, {"type": "subtitle", "time": 7926.31, "timestamp": "02:12:06", "text": "そのエモートはチャンネルに属しているものですよね"}, {"type": "subtitle", "time": 7929.27, "timestamp": "02:12:09", "text": "？ たとえば、あなたが"}, {"type": "subtitle", "time": 7931.109, "timestamp": "02:12:11", "text": "私のチャンネルの登録者であれば、"}, {"type": "subtitle", "time": 7936.069, "timestamp": "02:12:16", "text": "Twitch のどこでもこのエモートを使用できることになります。"}, {"type": "subtitle", "time": 7938.39, "timestamp": "02:12:18", "text": "誰を視聴していても、"}, {"type": "subtitle", "time": 7943.03, "timestamp": "02:12:23", "text": "このスポーツ選手に温かいハートの絵文字などを送ることができます。"}, {"type": "subtitle", "time": 7945.35, "timestamp": "02:12:25", "text": "ええ、Twitch のどこでもそれを使用できますよ"}, {"type": "subtitle", "time": 7946.79, "timestamp": "02:12:26", "text": "ね?"}, {"type": "subtitle", "time": 7949.189, "timestamp": "02:12:29", "text": "購読者だからですよね？ 同じことです。 他の"}, {"type": "subtitle", "time": 7950.95, "timestamp": "02:12:30", "text": "人がその絵文字を使用したい場合は、"}, {"type": "subtitle", "time": 7953.109, "timestamp": "02:12:33", "text": "その特定のチャンネルに登録する必要があります"}, {"type": "subtitle", "time": 7957.99, "timestamp": "02:12:37", "text": "。 同じこと、同じ論理。"}, {"type": "subtitle", "time": 7961.27, "timestamp": "02:12:41", "text": "YouTube では、世界中の"}, {"type": "subtitle", "time": 7964.31, "timestamp": "02:12:44", "text": "他のチャンネルの絵文字を使用できないようです"}, {"type": "subtitle", "time": 7965.669, "timestamp": "02:12:45", "text": "。"}, {"type": "subtitle", "time": 7968.629, "timestamp": "02:12:48", "text": "YouTubeで。 それは、"}, {"type": "subtitle", "time": 7971.27, "timestamp": "02:12:51", "text": "チャンネルのメンバーシップに申し込むと、"}, {"type": "subtitle", "time": 7974.55, "timestamp": "02:12:54", "text": "その特定のチャンネルでのみ使用できるようになるようなものですよね"}, {"type": "subtitle", "time": 7978.069, "timestamp": "02:12:58", "text": "? うん。"}]
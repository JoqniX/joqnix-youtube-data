[{"type": "subtitle", "time": 8700.95, "timestamp": "02:25:00", "text": "暇つぶしや退屈なときにやる楽しいこととして見ていました。 ああ、そうですね、私は"}, {"type": "subtitle", "time": 8703.19, "timestamp": "02:25:03", "text": "物事をあまり気にしていませんでした。 今は、"}, {"type": "subtitle", "time": 8709.91, "timestamp": "02:25:09", "text": "もっと頑張らなきゃ、あれこれ努力しなきゃ、と気にし始めて、えーっと、"}, {"type": "subtitle", "time": 8717.03, "timestamp": "02:25:17", "text": "毎日、何かをしたり、出かけたり、頭がぼーっとしてる感じ。"}, {"type": "subtitle", "time": 8719.99, "timestamp": "02:25:19", "text": "それで、「ああ、"}, {"type": "subtitle", "time": 8722.55, "timestamp": "02:25:22", "text": "ストリーミングする必要ある？」って思うんです。 そして、"}, {"type": "subtitle", "time": 8725.83, "timestamp": "02:25:25", "text": "ストリーミングのことだけ考えて、寝てしまいます。 目が覚めて"}, {"type": "subtitle", "time": 8728.23, "timestamp": "02:25:28", "text": "「あ、見逃した」って思う。"}, {"type": "subtitle", "time": 8730.389, "timestamp": "02:25:30", "text": "次の日は「よし、次の日"}, {"type": "subtitle", "time": 8732.87, "timestamp": "02:25:32", "text": "配信する」って感じ。"}, {"type": "subtitle", "time": 8740.87, "timestamp": "02:25:40", "text": "肌の色なの。そんな風には言えない。言え"}, {"type": "subtitle", "time": 8744.23, "timestamp": "02:25:44", "text": "ない。ええ、"}, {"type": "subtitle", "time": 8747.91, "timestamp": "02:25:47", "text": "想像にお任せするわね。"}, {"type": "subtitle", "time": 8750.15, "timestamp": "02:25:50", "text": "でも、ええ、"}, {"type": "subtitle", "time": 8754.55, "timestamp": "02:25:54", "text": "私は茶色だと思う。茶色か、"}, {"type": "subtitle", "time": 8758.23, "timestamp": "02:25:58", "text": "もっと明るい茶色。わからない。"}]
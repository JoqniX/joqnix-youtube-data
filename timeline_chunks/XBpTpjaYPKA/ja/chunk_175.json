[{"type": "subtitle", "time": 10502.07, "timestamp": "02:55:02", "text": "キックをやってみようかな。"}, {"type": "subtitle", "time": 10505.349, "timestamp": "02:55:05", "text": "キックチャットを"}, {"type": "subtitle", "time": 10508.389, "timestamp": "02:55:08", "text": "JSONファイルとして取得してウェブサイトに載せる方法を考えよう。そうすれば、"}, {"type": "subtitle", "time": 10514.309, "timestamp": "02:55:14", "text": "アーカイブページを見た時にYouTube Twitchのキックチャットも見られるようになる。それから、以前使っていた"}, {"type": "subtitle", "time": 10525.19, "timestamp": "02:55:25", "text": "コラボレーター"}, {"type": "subtitle", "time": 10527.91, "timestamp": "02:55:27", "text": "データベースシステムみたいなのを"}, {"type": "subtitle", "time": 10530.63, "timestamp": "02:55:30", "text": "アーカイブ"}, {"type": "subtitle", "time": 10532.79, "timestamp": "02:55:32", "text": "ページに使えるんじゃないかってアイデアも浮かんできました。例えば、"}, {"type": "subtitle", "time": 10535.19, "timestamp": "02:55:35", "text": "コンテンツクリエイターとコラボすると、彼らのデータが"}, {"type": "subtitle", "time": 10536.79, "timestamp": "02:55:36", "text": "すべてデータベースに保存されるんですよね。YouTube"}, {"type": "subtitle", "time": 10544.07, "timestamp": "02:55:44", "text": "チャンネル、Twitchチャンネル、ソーシャルメディア、ユーザー名"}, {"type": "subtitle", "time": 10548.07, "timestamp": "02:55:48", "text": "、PGなど。"}, {"type": "subtitle", "time": 10551.19, "timestamp": "02:55:51", "text": "これらはデータベースに保存されるんですよね。つまり、「"}, {"type": "subtitle", "time": 10554.63, "timestamp": "02:55:54", "text": "Joがあのクリエイターとコラボした」って感じで、"}, {"type": "subtitle", "time": 10558.63, "timestamp": "02:55:58", "text": "データが取得されてウェブ"}]
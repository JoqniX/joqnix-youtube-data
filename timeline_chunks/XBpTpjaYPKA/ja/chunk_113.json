[{"type": "subtitle", "time": 6780.79, "timestamp": "01:53:00", "text": "ストリーミングを見逃したと思います。"}, {"type": "subtitle", "time": 6786.39, "timestamp": "01:53:06", "text": "それはそれはしばらく経ちました。"}, {"type": "subtitle", "time": 6798.07, "timestamp": "01:53:18", "text": "アクティブになりたいけど、"}, {"type": "subtitle", "time": 6805.03, "timestamp": "01:53:25", "text": "最近は"}, {"type": "subtitle", "time": 6809.03, "timestamp": "01:53:29", "text": "ビデオゲームをプレイしていないので難しいです。Arc"}, {"type": "subtitle", "time": 6811.91, "timestamp": "01:53:31", "text": "Raidersをプレイしなくなったことに気付きました。2回"}, {"type": "subtitle", "time": 6819.83, "timestamp": "01:53:39", "text": "目の遠征を逃してしまいました。行くはずだったのですが、何が"}, {"type": "subtitle", "time": 6822.79, "timestamp": "01:53:42", "text": "起こったのかわかりませんが、"}, {"type": "subtitle", "time": 6825.189, "timestamp": "01:53:45", "text": "マッドマラソンサーバーのスラムが出ましたよ"}, {"type": "subtitle", "time": 6827.27, "timestamp": "01:53:47", "text": "ね?  Bungie によるゲーム「マラソン」。 ああ"}, {"type": "subtitle", "time": 6831.109, "timestamp": "01:53:51", "text": "、"}, {"type": "subtitle", "time": 6834.229, "timestamp": "01:53:54", "text": "閉店前にちょっとだけプレイしたのに。 明日は"}, {"type": "subtitle", "time": 6835.83, "timestamp": "01:53:55", "text": "マラソンが発売ですよね？"}, {"type": "subtitle", "time": 6837.75, "timestamp": "01:53:57", "text": "2,400です。"}]
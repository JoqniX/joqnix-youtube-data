[{"type": "subtitle", "time": 2061.27, "timestamp": "00:34:21", "text": "彩粉。  時間過得真快啊！  當你完全沉浸在很多事情中時，你根本不會注意到時間的流逝，你會忘記時間是如何飛逝而過的。  現在已經是三月了。  這豈不是"}, {"type": "subtitle", "time": 2080.23, "timestamp": "00:34:40", "text": "。"}, {"type": "subtitle", "time": 2086.55, "timestamp": "00:34:46", "text": "不過我得處理一下我的電腦問題了。"}, {"type": "subtitle", "time": 2095.99, "timestamp": "00:34:55", "text": "字面上來說，這"}]
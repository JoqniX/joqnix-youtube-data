[{"type": "subtitle", "time": 1751.269, "timestamp": "00:29:11", "text": "我的天啊。  呃，"}, {"type": "subtitle", "time": 1759.19, "timestamp": "00:29:19", "text": "總之，我去樓下拿我的瓶子。"}, {"type": "subtitle", "time": 1779.35, "timestamp": "00:29:39", "text": "給我一分鐘時間。呃，我真不想這麼做。呃，我不想"}, {"type": "subtitle", "time": 1781.99, "timestamp": "00:29:41", "text": "離開"}, {"type": "subtitle", "time": 1784.149, "timestamp": "00:29:44", "text": "直播間。它非常流暢。  我才看了24分鐘。我的天哪。  我的天啊。我剛開始。"}]
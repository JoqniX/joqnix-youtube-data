[{"type": "subtitle", "time": 5107.27, "timestamp": "01:25:07", "text": "我辦好了，"}, {"type": "subtitle", "time": 5110.39, "timestamp": "01:25:10", "text": "我就可以以更低的價格享受高級會員了。"}, {"type": "subtitle", "time": 5114.55, "timestamp": "01:25:14", "text": "所以，爸爸。邁阿密生活錯了。"}, {"type": "subtitle", "time": 5121.11, "timestamp": "01:25:21", "text": "我一直在想，bit是什麼，bit又是什麼，為什麼不呢？它顯示一個bit要195盧比。等等，"}, {"type": "subtitle", "time": 5150.87, "timestamp": "01:25:50", "text": "什麼？等等，他們漲價了嗎？"}, {"type": "subtitle", "time": 5156.709, "timestamp": "01:25:56", "text": "什麼？等等，一個。不。一個，138盧比，400個bit。哦，是啊。是啊，太瘋狂了。 100盧比，好多錢。"}]
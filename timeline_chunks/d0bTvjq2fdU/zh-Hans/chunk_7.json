[{"type": "subtitle", "time": 423.99, "timestamp": "00:07:03", "text": "记得吗？我之前做过那个 24 小时"}, {"type": "subtitle", "time": 428.07, "timestamp": "00:07:08", "text": "频道，是为了让"}, {"type": "subtitle", "time": 431.83, "timestamp": "00:07:11", "text": "那些想看我直播的人，"}, {"type": "subtitle", "time": 436.95, "timestamp": "00:07:16", "text": "比如"}, {"type": "subtitle", "time": 439.589, "timestamp": "00:07:19", "text": "三年前、四年前，可以随时观看和欣赏我的其他"}, {"type": "subtitle", "time": 443.51, "timestamp": "00:07:23", "text": "内容。 呃，"}, {"type": "subtitle", "time": 449.51, "timestamp": "00:07:29", "text": "如果你想看的话，可以在"}, {"type": "subtitle", "time": 453.35, "timestamp": "00:07:33", "text": "一个24小时不间断播放的频道上看，比如专门"}, {"type": "subtitle", "time": 456.15, "timestamp": "00:07:36", "text": "播放这类节目的频道。 是的。 我"}, {"type": "subtitle", "time": 460.629, "timestamp": "00:07:40", "text": "去年在我的电脑上运行过这个，自从"}, {"type": "subtitle", "time": 463.99, "timestamp": "00:07:43", "text": "我来到日本后，我就不能"}, {"type": "subtitle", "time": 467.749, "timestamp": "00:07:47", "text": "继续运行了，对吧？但是"}, {"type": "subtitle", "time": 471.589, "timestamp": "00:07:51", "text": "昨天的直播之后，我"}, {"type": "subtitle", "time": 474.23, "timestamp": "00:07:54", "text": "看了……"}, {"type": "subtitle", "time": 476.95, "timestamp": "00:07:56", "text": "就像我在看 Burn Peanut 一样。 好的。"}, {"type": "subtitle", "time": 479.83, "timestamp": "00:07:59", "text": "在他直播完战犬节目后，他又"}]
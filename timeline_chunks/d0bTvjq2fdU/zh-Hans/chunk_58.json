[{"type": "subtitle", "time": 3480.47, "timestamp": "00:58:00", "text": "现在一切都解决了，当我进行"}, {"type": "subtitle", "time": 3483.75, "timestamp": "00:58:03", "text": "空闲流时，它就能正常工作了。"}, {"type": "subtitle", "time": 3486.15, "timestamp": "00:58:06", "text": "喋喋不休很酷。 是的，我几乎不做"}, {"type": "subtitle", "time": 3489.51, "timestamp": "00:58:09", "text": "那些事。 我的意思是，几乎不说话，对吧？"}, {"type": "subtitle", "time": 3493.19, "timestamp": "00:58:13", "text": "嗯，我以前总是喋喋不休，"}, {"type": "subtitle", "time": 3495.349, "timestamp": "00:58:15", "text": "然后他们……是"}, {"type": "subtitle", "time": 3497.589, "timestamp": "00:58:17", "text": "啊，我现在太在意别人的看法了。 或许是"}, {"type": "subtitle", "time": 3521.27, "timestamp": "00:58:41", "text": "那是加号。 没什么"}, {"type": "subtitle", "time": 3523.43, "timestamp": "00:58:43", "text": "酷的。"}, {"type": "subtitle", "time": 3534.63, "timestamp": "00:58:54", "text": "以及我还需要什么才能更正"}, {"type": "subtitle", "time": 3536.39, "timestamp": "00:58:56", "text": "用户"}]
[{"type": "subtitle", "time": 2880.71, "timestamp": "00:48:00", "text": "嗯……"}, {"type": "subtitle", "time": 2884.15, "timestamp": "00:48:04", "text": "该怎么说呢？"}, {"type": "subtitle", "time": 2887.589, "timestamp": "00:48:07", "text": "你会观察、学习"}, {"type": "subtitle", "time": 2890.47, "timestamp": "00:48:10", "text": "创作者，或者更有名气的创作者是如何做事的，"}, {"type": "subtitle", "time": 2894.23, "timestamp": "00:48:14", "text": "然后尝试借鉴他们的做法"}, {"type": "subtitle", "time": 2897.829, "timestamp": "00:48:17", "text": "等等。最后用"}, {"type": "subtitle", "time": 2900.95, "timestamp": "00:48:20", "text": "你自己的方式去做，或者模仿，或者其他任何方式"}, {"type": "subtitle", "time": 2903.99, "timestamp": "00:48:23", "text": "。 抄袭不好，但"}, {"type": "subtitle", "time": 2906.15, "timestamp": "00:48:26", "text": "有时候奏效，有时候又"}, {"type": "subtitle", "time": 2908.549, "timestamp": "00:48:28", "text": "不行，对吧？   是的"}, {"type": "subtitle", "time": 2911.109, "timestamp": "00:48:31", "text": "。"}, {"type": "subtitle", "time": 2913.19, "timestamp": "00:48:33", "text": "所以我觉得，是啊，这些"}, {"type": "subtitle", "time": 2916.069, "timestamp": "00:48:36", "text": "自动化的东西等等，等等，（音乐）都是"}, {"type": "subtitle", "time": 2918.23, "timestamp": "00:48:38", "text": "太多不必要的"}, {"type": "subtitle", "time": 2921.03, "timestamp": "00:48:41", "text": "东西，"}, {"type": "subtitle", "time": 2924.71, "timestamp": "00:48:44", "text": "对吧？ 但仔细想想，"}, {"type": "subtitle", "time": 2929.43, "timestamp": "00:48:49", "text": "我真的很好奇他们是怎么做到的"}, {"type": "subtitle", "time": 2934.069, "timestamp": "00:48:54", "text": "？ 哦，所以我也想知道"}, {"type": "subtitle", "time": 2939.349, "timestamp": "00:48:59", "text": "背后的过程是怎样的，"}]
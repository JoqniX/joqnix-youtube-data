[{"type": "subtitle", "time": 900.55, "timestamp": "00:15:00", "text": "这终于比我的"}, {"type": "subtitle", "time": 905.189, "timestamp": "00:15:05", "text": "主播机器人和Sammy的设置好多了。是的，"}, {"type": "subtitle", "time": 907.509, "timestamp": "00:15:07", "text": "它存储在云端。你可以这样"}, {"type": "subtitle", "time": 910.87, "timestamp": "00:15:10", "text": "想：这会很有帮助。"}, {"type": "subtitle", "time": 916.069, "timestamp": "00:15:16", "text": "当我用手机直播时，"}, {"type": "subtitle", "time": 918.23, "timestamp": "00:15:18", "text": "如果有任何重要的提醒、"}, {"type": "subtitle", "time": 921.03, "timestamp": "00:15:21", "text": "重要的消息或"}, {"type": "subtitle", "time": 923.91, "timestamp": "00:15:23", "text": "任何需要审核或我需要查看的内容，我都可以在"}, {"type": "subtitle", "time": 927.829, "timestamp": "00:15:27", "text": "直播结束后查看，或者"}, {"type": "subtitle", "time": 930.31, "timestamp": "00:15:30", "text": "几年后、"}, {"type": "subtitle", "time": 933.03, "timestamp": "00:15:33", "text": "几个月后查看，我都"}, {"type": "subtitle", "time": 939.925, "timestamp": "00:15:39", "text": "可以查看日志。这很有帮助。"}, {"type": "subtitle", "time": 940.629, "timestamp": "00:15:40", "text": "[笑]"}, {"type": "subtitle", "time": 943.59, "timestamp": "00:15:43", "text": "我不需要在户外的时候一直开着我的电脑或笔记本电脑"}, {"type": "subtitle", "time": 946.79, "timestamp": "00:15:46", "text": "。 不，运行"}, {"type": "subtitle", "time": 950.71, "timestamp": "00:15:50", "text": "本地软件等等。 这是一项非常"}, {"type": "subtitle", "time": 954.629, "timestamp": "00:15:54", "text": "了不起的升级"}, {"type": "subtitle", "time": 957.189, "timestamp": "00:15:57", "text": "或改进。 略有"}]
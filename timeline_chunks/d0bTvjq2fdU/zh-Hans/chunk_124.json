[{"type": "subtitle", "time": 7441.51, "timestamp": "02:04:01", "text": "。 是的。 是的。"}, {"type": "subtitle", "time": 7451.75, "timestamp": "02:04:11", "text": "好吧，行。 去他妈的。"}, {"type": "subtitle", "time": 7454.31, "timestamp": "02:04:14", "text": "破碎的。"}, {"type": "subtitle", "time": 7456.87, "timestamp": "02:04:16", "text": "等待。 堡垒之夜。 至少我写了“是”，我"}, {"type": "subtitle", "time": 7459.75, "timestamp": "02:04:19", "text": "加了个点。 好吧，真他妈的。"}, {"type": "subtitle", "time": 7462.39, "timestamp": "02:04:22", "text": "画个点。 好吧，行。"}, {"type": "subtitle", "time": 7464.07, "timestamp": "02:04:24", "text": "所以，这些是模板。"}, {"type": "subtitle", "time": 7469.35, "timestamp": "02:04:29", "text": "每次"}, {"type": "subtitle", "time": 7473.189, "timestamp": "02:04:33", "text": "我使用 Sammy 时，它都会自动生成这个文件。"}, {"type": "subtitle", "time": 7480.629, "timestamp": "02:04:40", "text": "我不知道。"}, {"type": "subtitle", "time": 7483.43, "timestamp": "02:04:43", "text": "所以它原本应该"}, {"type": "subtitle", "time": 7498.229, "timestamp": "02:04:58", "text": "太多事情。"}]
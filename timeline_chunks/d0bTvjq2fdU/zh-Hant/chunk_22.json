[{"type": "subtitle", "time": 1334.71, "timestamp": "00:22:14", "text": "哦，我當時被靜音了，呃呃，我當時被靜音了。等等，我"}, {"type": "subtitle", "time": 1337.27, "timestamp": "00:22:17", "text": "開始"}, {"type": "subtitle", "time": 1339.029, "timestamp": "00:22:19", "text": "直播的時候並沒有被靜音，對吧？"}, {"type": "subtitle", "time": 1343.11, "timestamp": "00:22:23", "text": "請告訴我我沒有被靜音。  天哪，我什麼時候失聲的"}, {"type": "subtitle", "time": 1357.83, "timestamp": "00:22:37", "text": "當我解釋"}, {"type": "subtitle", "time": 1361.51, "timestamp": "00:22:41", "text": "V 播放器的即時模式時，一切都還算順利。好的。 V 重播播放器。"}, {"type": "subtitle", "time": 1367.99, "timestamp": "00:22:47", "text": "好的。呃，你好。嗯……哦，天哪。"}, {"type": "subtitle", "time": 1370.71, "timestamp": "00:22:50", "text": "現在它有點問題，但我稍後會修好"}, {"type": "subtitle", "time": 1373.11, "timestamp": "00:22:53", "text": "。這是 Jaji 的意大利麵法庭"}, {"type": "subtitle", "time": 1374.87, "timestamp": "00:22:54", "text": "。"}, {"type": "subtitle", "time": 1376.71, "timestamp": "00:22:56", "text": "沒關係。"}]
[{"type": "subtitle", "time": 600.23, "timestamp": "00:10:00", "text": "對吧？我是這輛車的主要所有者，所以"}, {"type": "subtitle", "time": 603.75, "timestamp": "00:10:03", "text": "沒問題。只要我這樣做是為了創作"}, {"type": "subtitle", "time": 606.23, "timestamp": "00:10:06", "text": "自己的內容，我覺得沒問題。"}, {"type": "subtitle", "time": 612.55, "timestamp": "00:10:12", "text": "沒有把握。是的。嗯，是的。嗯，"}, {"type": "subtitle", "time": 616.949, "timestamp": "00:10:16", "text": "今天我有很多任務要"}, {"type": "subtitle", "time": 619.91, "timestamp": "00:10:19", "text": "完成。今天我在直播的時候想，不如就放點"}, {"type": "subtitle", "time": 622.79, "timestamp": "00:10:22", "text": "音樂，"}, {"type": "subtitle", "time": 626.63, "timestamp": "00:10:26", "text": "跟大家聊聊天，或者說說你們有什麼"}, {"type": "subtitle", "time": 629.269, "timestamp": "00:10:29", "text": "問題，或者有什麼"}, {"type": "subtitle", "time": 632.389, "timestamp": "00:10:32", "text": "想法想讓我實現，或者其他什麼，都請告訴"}, {"type": "subtitle", "time": 635.43, "timestamp": "00:10:35", "text": "我，比如你們"}, {"type": "subtitle", "time": 637.509, "timestamp": "00:10:37", "text": "喜歡"}, {"type": "subtitle", "time": 641.75, "timestamp": "00:10:41", "text": "看我做什麼樣的內容等等等等，告訴我，"}, {"type": "subtitle", "time": 644.79, "timestamp": "00:10:44", "text": "我會試著和你們一起集思廣益，"}, {"type": "subtitle", "time": 649.03, "timestamp": "00:10:49", "text": "然後去做。因為"}, {"type": "subtitle", "time": 651.59, "timestamp": "00:10:51", "text": "過去幾週我一直在玩遊戲，不管是現實生活還是玩遊戲，嗯，對了，嗯，"}, {"type": "subtitle", "time": 658.23, "timestamp": "00:10:58", "text": "所以，"}]
[{"type": "subtitle", "time": 1622.47, "timestamp": "00:27:02", "text": "結束後，就變成 90 首歌曲中的兩首。"}, {"type": "subtitle", "time": 1624.31, "timestamp": "00:27:04", "text": "所以每個星期六（音樂）都會"}, {"type": "subtitle", "time": 1626.39, "timestamp": "00:27:06", "text": "更換。"}, {"type": "subtitle", "time": 1630.39, "timestamp": "00:27:10", "text": "每個星期六都會更換內容，你會看到"}, {"type": "subtitle", "time": 1632.95, "timestamp": "00:27:12", "text": "不同的內容。你會收到通知，但"}, {"type": "subtitle", "time": 1635.269, "timestamp": "00:27:15", "text": "日程安排會改變。今天的日程安排"}, {"type": "subtitle", "time": 1637.269, "timestamp": "00:27:17", "text": "是 Metagaman，"}, {"type": "subtitle", "time": 1639.19, "timestamp": "00:27:19", "text": "Vince 將與 PUBG 和高達"}, {"type": "subtitle", "time": 1641.19, "timestamp": "00:27:21", "text": "革命相遇，但日程安排將不斷"}, {"type": "subtitle", "time": 1645.51, "timestamp": "00:27:25", "text": "變化。這是件好事。所以"}, {"type": "subtitle", "time": 1648.07, "timestamp": "00:27:28", "text": "你不會一直看到修復後的影片之"}, {"type": "subtitle", "time": 1651.11, "timestamp": "00:27:31", "text": "類的東西。你好，Roaran"}, {"type": "subtitle", "time": 1658.47, "timestamp": "00:27:38", "text": "呃，我們今天只是閒聊，呃，"}, {"type": "subtitle", "time": 1661.35, "timestamp": "00:27:41", "text": "為他做計劃和準備。"}, {"type": "subtitle", "time": 1664.549, "timestamp": "00:27:44", "text": "哦，這真的很有意思，值得一看。"}, {"type": "subtitle", "time": 1668.95, "timestamp": "00:27:48", "text": "如果我再多解釋一下……呃，"}, {"type": "subtitle", "time": 1670.549, "timestamp": "00:27:50", "text": "我也不知道我為什麼要再解釋一次"}, {"type": "subtitle", "time": 1672.31, "timestamp": "00:27:52", "text": "。  從"}, {"type": "subtitle", "time": 1676.87, "timestamp": "00:27:56", "text": "某種意義上說，展示這個也挺有趣的。嗯，是的。"}]
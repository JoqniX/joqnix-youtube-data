[{"type": "subtitle", "time": 843.189, "timestamp": "00:14:03", "text": "這是我新做的東西。所以，嗯，"}, {"type": "subtitle", "time": 846.71, "timestamp": "00:14:06", "text": "對於那些不知道的人來說，我們有"}, {"type": "subtitle", "time": 849.509, "timestamp": "00:14:09", "text": "一個舊的東西，我通常會在上面記錄"}, {"type": "subtitle", "time": 853.829, "timestamp": "00:14:13", "text": "直播聊天記錄之類的東西"}, {"type": "subtitle", "time": 856.949, "timestamp": "00:14:16", "text": "。所以我做了一個新的"}, {"type": "subtitle", "time": 859.829, "timestamp": "00:14:19", "text": "更新版本，大概就是這樣。"}, {"type": "subtitle", "time": 862.31, "timestamp": "00:14:22", "text": "這是舊的那台。好的。舊版的東西"}, {"type": "subtitle", "time": 865.03, "timestamp": "00:14:25", "text": "太多了，例如一個小玩意兒，還有"}, {"type": "subtitle", "time": 868.069, "timestamp": "00:14:28", "text": "所有你需要自己"}, {"type": "subtitle", "time": 870.15, "timestamp": "00:14:30", "text": "發文討論的東西，對吧？以前是"}, {"type": "subtitle", "time": 874.069, "timestamp": "00:14:34", "text": "本地運行的。我需要運行一個軟體，"}, {"type": "subtitle", "time": 876.069, "timestamp": "00:14:36", "text": "而且這個軟體會在本地運行，"}, {"type": "subtitle", "time": 878.87, "timestamp": "00:14:38", "text": "對吧？但現在我把所有東西都換成"}, {"type": "subtitle", "time": 882.71, "timestamp": "00:14:42", "text": "Cloudflare 了。我現在使用的是雲端架構"}, {"type": "subtitle", "time": 887.509, "timestamp": "00:14:47", "text": "。所以，現在Twitch聊天記錄會"}, {"type": "subtitle", "time": 890.55, "timestamp": "00:14:50", "text": "顯示在這裡，踢人聊天記錄也會顯示在這裡。"}, {"type": "subtitle", "time": 894.55, "timestamp": "00:14:54", "text": "聊天用戶的每一則評論，你做的"}, {"type": "subtitle", "time": 897.11, "timestamp": "00:14:57", "text": "每一件事都會被記錄下來。"}]
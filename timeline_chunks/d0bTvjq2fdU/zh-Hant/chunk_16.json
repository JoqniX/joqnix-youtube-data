[{"type": "subtitle", "time": 960.949, "timestamp": "00:16:00", "text": "沒什麼大事，但是，"}, {"type": "subtitle", "time": 964.389, "timestamp": "00:16:04", "text": "嗯，它就是它就是它就是，而且當它回到背面時"}, {"type": "subtitle", "time": 967.829, "timestamp": "00:16:07", "text": "，就很難看了。"}, {"type": "subtitle", "time": 969.749, "timestamp": "00:16:09", "text": "我不知道怎麼編程，所以我不得不（笑）不停地打字，不停地提示，"}, {"type": "subtitle", "time": 977.189, "timestamp": "00:16:17", "text": "不停地提示，不停地提示，才能從Chatun Chap那裡"}, {"type": "subtitle", "time": 979.43, "timestamp": "00:16:19", "text": "得到"}, {"type": "subtitle", "time": 982.55, "timestamp": "00:16:22", "text": "正確的代碼，這很困難，但"}, {"type": "subtitle", "time": 985.91, "timestamp": "00:16:25", "text": "我最終還是成功了"}, {"type": "subtitle", "time": 989.67, "timestamp": "00:16:29", "text": "。嗯，是的，我很"}, {"type": "subtitle", "time": 991.43, "timestamp": "00:16:31", "text": "滿意。"}, {"type": "subtitle", "time": 994.87, "timestamp": "00:16:34", "text": "說到這裡，VA頻道目前也在本地播出。"}, {"type": "subtitle", "time": 1004.15, "timestamp": "00:16:44", "text": "所以每個星期六凌晨 12 點（"}, {"type": "subtitle", "time": 1006.31, "timestamp": "00:16:46", "text": "印度標準時間），我都必須把它改成 GST。是的。"}, {"type": "subtitle", "time": 1009.189, "timestamp": "00:16:49", "text": "但我會像以前一樣，保持"}, {"type": "subtitle", "time": 1012.47, "timestamp": "00:16:52", "text": "印度標準時間 (IST)。  所以這件事目前也是本地的。  所以"}]
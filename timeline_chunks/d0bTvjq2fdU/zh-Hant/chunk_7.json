[{"type": "subtitle", "time": 423.99, "timestamp": "00:07:03", "text": "記得嗎？我之前做過那個 24 小時"}, {"type": "subtitle", "time": 428.07, "timestamp": "00:07:08", "text": "頻道，是為了讓"}, {"type": "subtitle", "time": 431.83, "timestamp": "00:07:11", "text": "那些想看我直播的人，"}, {"type": "subtitle", "time": 436.95, "timestamp": "00:07:16", "text": "例如"}, {"type": "subtitle", "time": 439.589, "timestamp": "00:07:19", "text": "三年前、四年前，可以隨時觀看和欣賞我的"}, {"type": "subtitle", "time": 443.51, "timestamp": "00:07:23", "text": "其他內容。呃，如果想看的話，可以在一個"}, {"type": "subtitle", "time": 453.35, "timestamp": "00:07:33", "text": "24小時不間斷播放的頻道上看，例如專門播放這類節目的頻道"}, {"type": "subtitle", "time": 456.15, "timestamp": "00:07:36", "text": "。是的。我"}, {"type": "subtitle", "time": 460.629, "timestamp": "00:07:40", "text": "去年在我的電腦上運行過這個，自從"}, {"type": "subtitle", "time": 463.99, "timestamp": "00:07:43", "text": "我來到日本後，我就不能"}, {"type": "subtitle", "time": 467.749, "timestamp": "00:07:47", "text": "繼續運行了，對吧？但"}, {"type": "subtitle", "time": 471.589, "timestamp": "00:07:51", "text": "昨天的直播之後，我"}, {"type": "subtitle", "time": 474.23, "timestamp": "00:07:54", "text": "看了…"}, {"type": "subtitle", "time": 476.95, "timestamp": "00:07:56", "text": "就像我在看 Burn Peanut 一樣。好的。"}, {"type": "subtitle", "time": 479.83, "timestamp": "00:07:59", "text": "在他直播完戰犬節目後，他又"}]
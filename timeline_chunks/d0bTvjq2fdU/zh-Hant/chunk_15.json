[{"type": "subtitle", "time": 900.55, "timestamp": "00:15:00", "text": "這終於比我的"}, {"type": "subtitle", "time": 905.189, "timestamp": "00:15:05", "text": "主播機器人和Sammy的設定好多了。是的，"}, {"type": "subtitle", "time": 907.509, "timestamp": "00:15:07", "text": "它儲存在雲端。你可以"}, {"type": "subtitle", "time": 910.87, "timestamp": "00:15:10", "text": "這樣想：這會很有幫助。"}, {"type": "subtitle", "time": 916.069, "timestamp": "00:15:16", "text": "當我用手機直播時，如果有"}, {"type": "subtitle", "time": 918.23, "timestamp": "00:15:18", "text": "任何重要的提醒、"}, {"type": "subtitle", "time": 921.03, "timestamp": "00:15:21", "text": "重要的訊息或任何需要"}, {"type": "subtitle", "time": 923.91, "timestamp": "00:15:23", "text": "審核或我需要查看的內容，我都可以在"}, {"type": "subtitle", "time": 927.829, "timestamp": "00:15:27", "text": "直播結束後查看，"}, {"type": "subtitle", "time": 930.31, "timestamp": "00:15:30", "text": "或者幾年後、"}, {"type": "subtitle", "time": 933.03, "timestamp": "00:15:33", "text": "幾個月後查看，我都"}, {"type": "subtitle", "time": 939.925, "timestamp": "00:15:39", "text": "可以查看日誌。這很有幫助。"}, {"type": "subtitle", "time": 940.629, "timestamp": "00:15:40", "text": "[笑]"}, {"type": "subtitle", "time": 943.59, "timestamp": "00:15:43", "text": "我不需要在戶外的時候一直開著我的電腦或筆記型電腦。"}, {"type": "subtitle", "time": 946.79, "timestamp": "00:15:46", "text": "不，運行"}, {"type": "subtitle", "time": 950.71, "timestamp": "00:15:50", "text": "本地軟體等等。這是一項非常"}, {"type": "subtitle", "time": 954.629, "timestamp": "00:15:54", "text": "了不起的升級或改進。略有"}, {"type": "subtitle", "time": 957.189, "timestamp": "00:15:57", "text": "改進。"}]
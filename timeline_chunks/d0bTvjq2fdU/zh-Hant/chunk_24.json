[{"type": "subtitle", "time": 1443.59, "timestamp": "00:24:03", "text": "Ahasman"}, {"type": "subtitle", "time": 1447.99, "timestamp": "00:24:07", "text": "gold 24x7在哪裡？是的，就是這個。等等，讓我在直播中展示一下。呃，等等，"}, {"type": "subtitle", "time": 1455.909, "timestamp": "00:24:15", "text": "遊戲，"}, {"type": "subtitle", "time": 1459.51, "timestamp": "00:24:19", "text": "呃，展示窗口。"}, {"type": "subtitle", "time": 1463.59, "timestamp": "00:24:23", "text": "嘿，所以是 Aspen Gold，對吧？所以，呃，就是那些"}, {"type": "subtitle", "time": 1465.909, "timestamp": "00:24:25", "text": "經營 Aspen Gold"}, {"type": "subtitle", "time": 1470.149, "timestamp": "00:24:30", "text": "24x 24/7 Twitch 頻道的人，對吧？ [音樂]"}, {"type": "subtitle", "time": 1471.909, "timestamp": "00:24:31", "text": "他們當然有投票"}, {"type": "subtitle", "time": 1473.75, "timestamp": "00:24:33", "text": "系統等等，這真的"}, {"type": "subtitle", "time": 1477.029, "timestamp": "00:24:37", "text": "很棒。但正如你所看到的，我們來玩"}, {"type": "subtitle", "time": 1480.23, "timestamp": "00:24:40", "text": "一會兒。當然，聲音是靜音的。目前"}, {"type": "subtitle", "time": 1482.789, "timestamp": "00:24:42", "text": "是全螢幕顯示，對吧？所以它的"}, {"type": "subtitle", "time": 1486.789, "timestamp": "00:24:46", "text": "運作方式是，當 Asmin go 沒有"}, {"type": "subtitle", "time": 1490.39, "timestamp": "00:24:50", "text": "在他的主頻道上直播時，Vaude"}, {"type": "subtitle", "time": 1495.11, "timestamp": "00:24:55", "text": "頻道會顯示觀眾點播的視頻"}, {"type": "subtitle", "time": 1498.39, "timestamp": "00:24:58", "text": "或隨機播放列表中的 Vaude 內容，這些內容"}]
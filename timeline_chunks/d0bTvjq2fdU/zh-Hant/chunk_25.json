[{"type": "subtitle", "time": 1503.35, "timestamp": "00:25:03", "text": "將全屏顯示。好的。"}, {"type": "subtitle", "time": 1505.99, "timestamp": "00:25:05", "text": "當他直播的時候，"}, {"type": "subtitle", "time": 1510.31, "timestamp": "00:25:10", "text": "呃，他直播的時候，呃，我想不出有什麼"}, {"type": "subtitle", "time": 1516.47, "timestamp": "00:25:16", "text": "例子可以舉出來，"}, {"type": "subtitle", "time": 1519.51, "timestamp": "00:25:19", "text": "呃，很遺憾，沒有例子可以舉出來，"}, {"type": "subtitle", "time": 1525.669, "timestamp": "00:25:25", "text": "呃，當他直播的時候，"}, {"type": "subtitle", "time": 1528.549, "timestamp": "00:25:28", "text": "主屏幕會變小，"}, {"type": "subtitle", "time": 1530.549, "timestamp": "00:25:30", "text": "顯示一個日程表，然後會有"}, {"type": "subtitle", "time": 1534.87, "timestamp": "00:25:34", "text": "背景音樂之類的，等等，"}, {"type": "subtitle", "time": 1538.07, "timestamp": "00:25:38", "text": "對吧？"}, {"type": "subtitle", "time": 1544.07, "timestamp": "00:25:44", "text": "所以我在這裡重新製作了它。呃，讓我開啟"}, {"type": "subtitle", "time": 1547.59, "timestamp": "00:25:47", "text": "開發者工具，把[音樂]設定為即時"}, {"type": "subtitle", "time": 1551.909, "timestamp": "00:25:51", "text": "模式。我在這裡做了一些改變。"}, {"type": "subtitle", "time": 1554.39, "timestamp": "00:25:54", "text": "位置有點不好。我不知道"}, {"type": "subtitle", "time": 1558.23, "timestamp": "00:25:58", "text": "為什麼位置有點不好，但是"}]
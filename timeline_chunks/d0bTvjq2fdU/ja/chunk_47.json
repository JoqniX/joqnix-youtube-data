[{"type": "subtitle", "time": 2821.75, "timestamp": "00:47:01", "text": "俺からすると50ドルくらい高すぎるよ。"}, {"type": "subtitle", "time": 2828.39, "timestamp": "00:47:08", "text": "でも、"}, {"type": "subtitle", "time": 2832.23, "timestamp": "00:47:12", "text": "本当にクールだよね？"}, {"type": "subtitle", "time": 2835.589, "timestamp": "00:47:15", "text": "頭の中には、"}, {"type": "subtitle", "time": 2840.39, "timestamp": "00:47:20", "text": "それを自動化するためにできることがたくさんあるのですが、その"}, {"type": "subtitle", "time": 2844.069, "timestamp": "00:47:24", "text": "理由は、どう"}, {"type": "subtitle", "time": 2846.71, "timestamp": "00:47:26", "text": "言えばいいでしょうか？"}, {"type": "subtitle", "time": 2860.95, "timestamp": "00:47:40", "text": "例えば、えっと、"}, {"type": "subtitle", "time": 2869.75, "timestamp": "00:47:49", "text": "技術的には、私は"}, {"type": "subtitle", "time": 2873.109, "timestamp": "00:47:53", "text": "見た目が好きです、とか、"}, {"type": "subtitle", "time": 2875.43, "timestamp": "00:47:55", "text": "どう言えばいいかな？ 技術的には、えっと、なんて言うんだっけ"}]
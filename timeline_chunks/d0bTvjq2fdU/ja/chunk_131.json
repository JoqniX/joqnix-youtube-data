[{"type": "subtitle", "time": 7860.55, "timestamp": "02:11:00", "text": "私のインターネットは悪いよ。 あ、すみません。"}, {"type": "subtitle", "time": 7862.31, "timestamp": "02:11:02", "text": "おお。"}, {"type": "subtitle", "time": 7865.83, "timestamp": "02:11:05", "text": "ああ、忘れてた。 でも、えっと、"}, {"type": "subtitle", "time": 7884.069, "timestamp": "02:11:24", "text": "夕食を食べに行きます。 また後で"}, {"type": "subtitle", "time": 7910.55, "timestamp": "02:11:50", "text": "締めくくらなくちゃ。"}, {"type": "subtitle", "time": 7912.79, "timestamp": "02:11:52", "text": "12時だよ、みんな。 そろそろ締めくくらなければ。"}, {"type": "subtitle", "time": 7915.27, "timestamp": "02:11:55", "text": "寝なければならない。"}]
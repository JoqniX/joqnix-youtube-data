[{"type": "subtitle", "time": 7320.47, "timestamp": "02:02:00", "text": "マラソンって何？"}, {"type": "subtitle", "time": 7324.229, "timestamp": "02:02:04", "text": "最後の編集時間何？"}, {"type": "subtitle", "time": 7331.109, "timestamp": "02:02:11", "text": "待って、前回のアクセスで絞り込むにはどうすればいいの？ 私は"}, {"type": "subtitle", "time": 7334.47, "timestamp": "02:02:14", "text": "剣に力を込めた。"}, {"type": "subtitle", "time": 7337.35, "timestamp": "02:02:17", "text": "前回は全部そうだったの？"}, {"type": "subtitle", "time": 7343.27, "timestamp": "02:02:23", "text": "えーと、"}, {"type": "subtitle", "time": 7344.87, "timestamp": "02:02:24", "text": "最新の"}, {"type": "subtitle", "time": 7353.83, "timestamp": "02:02:33", "text": "何だ？   えっと"}, {"type": "subtitle", "time": 7356.629, "timestamp": "02:02:36", "text": "、"}, {"type": "subtitle", "time": 7361.589, "timestamp": "02:02:41", "text": "待って。 なぜ6月15日以降は停止したのですか？"}, {"type": "subtitle", "time": 7363.91, "timestamp": "02:02:43", "text": "待って。 私はこの配信をしていた時、日本にいました"}, {"type": "subtitle", "time": 7365.83, "timestamp": "02:02:45", "text": "。 一体どういうことだ？ ええと、"}, {"type": "subtitle", "time": 7368.47, "timestamp": "02:02:48", "text": "基本的には手動モードと"}, {"type": "subtitle", "time": 7372.39, "timestamp": "02:02:52", "text": "自動モードがあります。 では、マニュアルモードとは"}, {"type": "subtitle", "time": 7374.31, "timestamp": "02:02:54", "text": "こういうことです。 同じ配信"}, {"type": "subtitle", "time": 7377.43, "timestamp": "02:02:57", "text": "概要を書いて、スタンプを付けたり、"}]
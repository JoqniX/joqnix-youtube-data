[{"type": "subtitle", "time": 6303.35, "timestamp": "01:45:03", "text": "Twitchアーカイブが壊れています。 私は"}, {"type": "subtitle", "time": 6309.27, "timestamp": "01:45:09", "text": "行動に移すつもりだ。 はい、壊れています。"}, {"type": "subtitle", "time": 6311.669, "timestamp": "01:45:11", "text": "稼働していません。"}, {"type": "subtitle", "time": 6314.149, "timestamp": "01:45:14", "text": "ええ、動いていません。"}, {"type": "subtitle", "time": 6317.03, "timestamp": "01:45:17", "text": "キックはどうですか？"}, {"type": "subtitle", "time": 6319.75, "timestamp": "01:45:19", "text": "キックは走ることだ。 何？ キックは"}, {"type": "subtitle", "time": 6321.91, "timestamp": "01:45:21", "text": "今日も活動している。 ああ、それは"}, {"type": "subtitle", "time": 6329.83, "timestamp": "01:45:29", "text": "しかし問題は、"}, {"type": "subtitle", "time": 6335.03, "timestamp": "01:45:35", "text": "YouTube と Twitch のクッキーを設定して、"}, {"type": "subtitle", "time": 6336.229, "timestamp": "01:45:36", "text": "[咳払い]"}, {"type": "subtitle", "time": 6338.709, "timestamp": "01:45:38", "text": "YouTube と Twitch のクッキーをキックするのではなく、"}, {"type": "subtitle", "time": 6340.95, "timestamp": "01:45:40", "text": "ブラウザのログイン クッキーを確認する必要があることです。"}, {"type": "subtitle", "time": 6343.75, "timestamp": "01:45:43", "text": "それを GitHub に手動で設定する必要があります。"}, {"type": "subtitle", "time": 6348.39, "timestamp": "01:45:48", "text": "とても面倒なので、そんなことはしたくありません。"}, {"type": "subtitle", "time": 6354.79, "timestamp": "01:45:54", "text": "私のものの半分が壊れてしまいます。"}, {"type": "subtitle", "time": 6359.51, "timestamp": "01:45:59", "text": "動作させるにはクッキーが必要です。"}]
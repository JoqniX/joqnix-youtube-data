[{"type": "subtitle", "time": 3556.47, "timestamp": "00:59:16", "text": "通常の埋め込み"}, {"type": "subtitle", "time": 3559.03, "timestamp": "00:59:19", "text": "やフォーラムの"}, {"type": "subtitle", "time": 3560.789, "timestamp": "00:59:20", "text": "埋め込み"}, {"type": "subtitle", "time": 3567.99, "timestamp": "00:59:27", "text": "フォーラムでは、"}, {"type": "subtitle", "time": 3575.589, "timestamp": "00:59:35", "text": "スクリーンショットにあるように、ユーザー ID を共有する必要はありません。"}, {"type": "subtitle", "time": 3577.75, "timestamp": "00:59:37", "text": "すでに"}, {"type": "subtitle", "time": 3582.23, "timestamp": "00:59:42", "text": "チャンネル ID が表示されています。彼女の名前は誰ですか？"}]
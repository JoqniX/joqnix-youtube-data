[{"type": "subtitle", "time": 3483.75, "timestamp": "00:58:03", "text": "アイドルストリームを実行すると、すべて正常に動作するようになるので、問題は解決しました。"}, {"type": "subtitle", "time": 3486.15, "timestamp": "00:58:06", "text": "吠えるのはかっこいい。 ええ、"}, {"type": "subtitle", "time": 3489.51, "timestamp": "00:58:09", "text": "そういうのはほとんどやりません。 つまり、ほとんど話さないってことですよね？   えっと、昔はよく"}, {"type": "subtitle", "time": 3493.19, "timestamp": "00:58:13", "text": "言い返していたんだけど"}, {"type": "subtitle", "time": 3497.589, "timestamp": "00:58:17", "text": "、今は意識しすぎているんだ。 もしかしたら、"}, {"type": "subtitle", "time": 3521.27, "timestamp": "00:58:41", "text": "それはプラス記号です。 何もかもが"}, {"type": "subtitle", "time": 3523.43, "timestamp": "00:58:43", "text": "クールじゃない。"}, {"type": "subtitle", "time": 3534.63, "timestamp": "00:58:54", "text": "そしてユーザー名を修正するために他に何が必要ですか"}]
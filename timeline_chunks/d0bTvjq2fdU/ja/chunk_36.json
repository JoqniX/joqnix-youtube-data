[{"type": "subtitle", "time": 2164.069, "timestamp": "00:36:04", "text": "直さなければならないことがありました。 いくつか"}, {"type": "subtitle", "time": 2169.51, "timestamp": "00:36:09", "text": "話し合いたいことがあります。"}, {"type": "subtitle", "time": 2171.75, "timestamp": "00:36:11", "text": "さて、まずは基本から。 えっと、"}, {"type": "subtitle", "time": 2174.79, "timestamp": "00:36:14", "text": "Twitchのパネルを更新する必要があると思うんだけど、"}, {"type": "subtitle", "time": 2182.55, "timestamp": "00:36:22", "text": "そして、"}, {"type": "subtitle", "time": 2186.63, "timestamp": "00:36:26", "text": "現在のパネルは問題ありません。 つまり、"}, {"type": "subtitle", "time": 2190.39, "timestamp": "00:36:30", "text": "例えばYouTubeの場合、"}, {"type": "subtitle", "time": 2193.589, "timestamp": "00:36:33", "text": "YouTubeの言語が日本語"}, {"type": "subtitle", "time": 2197.829, "timestamp": "00:36:37", "text": "か別の言語であれば、"}, {"type": "subtitle", "time": 2200.71, "timestamp": "00:36:40", "text": "チャンネルの"}, {"type": "subtitle", "time": 2203.99, "timestamp": "00:36:43", "text": "説明や音楽などを"}, {"type": "subtitle", "time": 2206.23, "timestamp": "00:36:46", "text": "別の言語に設定できると思うんです。"}, {"type": "subtitle", "time": 2208.71, "timestamp": "00:36:48", "text": "それは手動で設定できます。"}, {"type": "subtitle", "time": 2211.99, "timestamp": "00:36:51", "text": "しかし、Twitchにはそのオプションはありません"}, {"type": "subtitle", "time": 2215.51, "timestamp": "00:36:55", "text": "。 だから、"}, {"type": "subtitle", "time": 2217.349, "timestamp": "00:36:57", "text": "物理的に、"}]
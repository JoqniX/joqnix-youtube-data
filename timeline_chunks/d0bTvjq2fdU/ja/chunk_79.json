[{"type": "subtitle", "time": 4743.43, "timestamp": "01:19:03", "text": "今日の配信で彼と私が"}, {"type": "subtitle", "time": 4747.43, "timestamp": "01:19:07", "text": "頭痛の種を一つずつ抱えたコードを渡した。"}, {"type": "subtitle", "time": 4750.229, "timestamp": "01:19:10", "text": "これは私が作った"}, {"type": "subtitle", "time": 4754.31, "timestamp": "01:19:14", "text": "クラウドチャットサービス、"}, {"type": "subtitle", "time": 4757.75, "timestamp": "01:19:17", "text": "チャットサービスのログ記録などです。"}, {"type": "subtitle", "time": 4759.75, "timestamp": "01:19:19", "text": "ステルス作戦は完了する。 私はとても"}, {"type": "subtitle", "time": 4766.63, "timestamp": "01:19:26", "text": "なぜなら、ここ数日間ずっとそれを"}, {"type": "subtitle", "time": 4769.189, "timestamp": "01:19:29", "text": "後ろのバインダーに入れて、"}, {"type": "subtitle", "time": 4773.189, "timestamp": "01:19:33", "text": "保留、保留、保留、保留、保留のようにしていたからです。"}, {"type": "subtitle", "time": 4780.31, "timestamp": "01:19:40", "text": "突然「ああ、これに"}, {"type": "subtitle", "time": 4790.47, "timestamp": "01:19:50", "text": "そして、私を自由にさせて、私の好きなことをさせてください、などなど。"}]
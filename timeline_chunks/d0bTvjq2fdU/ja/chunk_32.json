[{"type": "subtitle", "time": 1921.99, "timestamp": "00:32:01", "text": "ショーは本当にクールです。"}, {"type": "subtitle", "time": 1924.71, "timestamp": "00:32:04", "text": "このセットアップをクラウドにアップグレードしたいです"}, {"type": "subtitle", "time": 1926.389, "timestamp": "00:32:06", "text": "。"}, {"type": "subtitle", "time": 1930.31, "timestamp": "00:32:10", "text": "私は自分のことをしたくないし、"}, {"type": "subtitle", "time": 1935.19, "timestamp": "00:32:15", "text": "毎週土曜日にPCを開いたままにしておく必要もないし、バックグラウンドで"}, {"type": "subtitle", "time": 1944.95, "timestamp": "00:32:24", "text": "動作させるために手動でボタンを押して"}, {"type": "subtitle", "time": 1946.789, "timestamp": "00:32:26", "text": "サイクルを実行する必要もない。"}, {"type": "subtitle", "time": 1951.75, "timestamp": "00:32:31", "text": "だから、全部切り替えなきゃいけないんだ。"}, {"type": "subtitle", "time": 1957.269, "timestamp": "00:32:37", "text": "このコードの裏側、つまり内部のコーディング部分をご覧になりたいですか？   えっと"}, {"type": "subtitle", "time": 1960.149, "timestamp": "00:32:40", "text": "、待って。 少しはお見せできると思います"}, {"type": "subtitle", "time": 1962.149, "timestamp": "00:32:42", "text": "。"}, {"type": "subtitle", "time": 1978.31, "timestamp": "00:32:58", "text": "なぜ表示されないのですか？   そうそう"}]
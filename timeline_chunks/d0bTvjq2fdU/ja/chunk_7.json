[{"type": "subtitle", "time": 423.99, "timestamp": "00:07:03", "text": "覚えておいてください、あの 24 時間 7 日の"}, {"type": "subtitle", "time": 428.07, "timestamp": "00:07:08", "text": "チャンネルというものは、私を"}, {"type": "subtitle", "time": 431.83, "timestamp": "00:07:11", "text": "見ている人たちが、"}, {"type": "subtitle", "time": 439.589, "timestamp": "00:07:19", "text": "3 年前、4 年前の古い"}, {"type": "subtitle", "time": 443.51, "timestamp": "00:07:23", "text": "コンテンツや次のコンテンツなどを見て楽しむ方法の一つとして行いました。 ええと、"}, {"type": "subtitle", "time": 449.51, "timestamp": "00:07:29", "text": "もしよろしければ、24時間"}, {"type": "subtitle", "time": 453.35, "timestamp": "00:07:33", "text": "365日放送しているチャンネルなどで見ることができます"}, {"type": "subtitle", "time": 456.15, "timestamp": "00:07:36", "text": "。 うん。 そして、私は"}, {"type": "subtitle", "time": 460.629, "timestamp": "00:07:40", "text": "昨年これを自分のPCで実行していましたが、"}, {"type": "subtitle", "time": 463.99, "timestamp": "00:07:43", "text": "日本に来てからは、それを続けることができませんでした。"}, {"type": "subtitle", "time": 467.749, "timestamp": "00:07:47", "text": "しかし、"}, {"type": "subtitle", "time": 471.589, "timestamp": "00:07:51", "text": "昨日のストリームの後、"}, {"type": "subtitle", "time": 476.95, "timestamp": "00:07:56", "text": "バーンピーナッツを見ていました。 わかった。"}, {"type": "subtitle", "time": 479.83, "timestamp": "00:07:59", "text": "そして、軍用犬の配信が終わった後、彼は24時間"}]
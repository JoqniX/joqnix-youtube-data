[{"type": "subtitle", "time": 2524.71, "timestamp": "00:42:04", "text": "でも、まあ、これをしなくても大丈夫、諦める、というのは、"}, {"type": "subtitle", "time": 2549.109, "timestamp": "00:42:29", "text": "コラボレーションをするよりも、私は、ええと、オーケーが必要だと"}, {"type": "subtitle", "time": 2551.99, "timestamp": "00:42:31", "text": "感じています"}, {"type": "subtitle", "time": 2556.15, "timestamp": "00:42:36", "text": "。"}, {"type": "subtitle", "time": 2558.39, "timestamp": "00:42:38", "text": "ソロで、"}, {"type": "subtitle", "time": 2561.03, "timestamp": "00:42:41", "text": "特にハイな状態でもっと練習しよう。"}, {"type": "subtitle", "time": 2563.03, "timestamp": "00:42:43", "text": "うん。"}, {"type": "subtitle", "time": 2566.63, "timestamp": "00:42:46", "text": "ええと、"}, {"type": "subtitle", "time": 2571.91, "timestamp": "00:42:51", "text": "音楽をやるのに最適なタイミングは週末だと思うんです。"}, {"type": "subtitle", "time": 2574.79, "timestamp": "00:42:54", "text": "ええ、週末ですね。"}, {"type": "subtitle", "time": 2577.349, "timestamp": "00:42:57", "text": "それは"}]
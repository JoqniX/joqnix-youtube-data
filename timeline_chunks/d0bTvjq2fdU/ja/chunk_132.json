[{"type": "subtitle", "time": 7927.189, "timestamp": "02:12:07", "text": "今日は結局、僕たち（音楽関係者）はただおしゃべりしただけだったと思う。 ええと、いくつかうまくいくものもありました"}, {"type": "subtitle", "time": 7928.95, "timestamp": "02:12:08", "text": "。"}, {"type": "subtitle", "time": 7933.83, "timestamp": "02:12:13", "text": "YouTubeの機能を試せてよかった。   ええ"}, {"type": "subtitle", "time": 7937.589, "timestamp": "02:12:17", "text": "、"}, {"type": "subtitle", "time": 7940.229, "timestamp": "02:12:20", "text": "YouTubeの機能を試せてよかったです。 ある程度は機能している"}, {"type": "subtitle", "time": 7944.149, "timestamp": "02:12:24", "text": "が、Koda YouTube コーダーは終了した。"}, {"type": "subtitle", "time": 7946.629, "timestamp": "02:12:26", "text": "私が利用しているサービスの場合。"}, {"type": "subtitle", "time": 7955.27, "timestamp": "02:12:35", "text": "今日切り替えた新しいシステムではYouTubeのチャットをログに記録できますが、"}, {"type": "subtitle", "time": 7957.91, "timestamp": "02:12:37", "text": "古いシステムも正常に動作するので、チャットは"}, {"type": "subtitle", "time": 7961.99, "timestamp": "02:12:41", "text": "ログに記録されます。 ああ、昔の話だよ。"}, {"type": "subtitle", "time": 7966.229, "timestamp": "02:12:46", "text": "はい、info star c の統計情報がログインされています。"}, {"type": "subtitle", "time": 7967.91, "timestamp": "02:12:47", "text": "ニース。   よし"}, {"type": "subtitle", "time": 7969.91, "timestamp": "02:12:49", "text": "。"}, {"type": "subtitle", "time": 7971.99, "timestamp": "02:12:51", "text": "ともあれ、それ以外は、今日の"}, {"type": "subtitle", "time": 7974.95, "timestamp": "02:12:54", "text": "テスト配信は良かった。 えっと、"}, {"type": "subtitle", "time": 7977.03, "timestamp": "02:12:57", "text": "良いストリームとしてストリームをテストしていないような感じです。"}]
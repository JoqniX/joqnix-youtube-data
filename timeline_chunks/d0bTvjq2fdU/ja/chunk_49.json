[{"type": "subtitle", "time": 2943.109, "timestamp": "00:49:03", "text": "今日のことを考えてみてください。"}, {"type": "subtitle", "time": 2947.51, "timestamp": "00:49:07", "text": "ええと、今は15分、51分です。私はずっと"}, {"type": "subtitle", "time": 2949.75, "timestamp": "00:49:09", "text": "喋り続けていました。"}, {"type": "subtitle", "time": 2954.71, "timestamp": "00:49:14", "text": "私のV埋め込みやJocknikのセットアップを見せましたよね。何か"}, {"type": "subtitle", "time": 2957.829, "timestamp": "00:49:17", "text": "理解できましたか？たぶん理解できなかったでしょうが、"}, {"type": "subtitle", "time": 2972.15, "timestamp": "00:49:32", "text": "脳の隅っこで「ああ、"}, {"type": "subtitle", "time": 2975.75, "timestamp": "00:49:35", "text": "彼がやっていることはすごくクールだ」って考えている人がいるでしょう。"}, {"type": "subtitle", "time": 2978.15, "timestamp": "00:49:38", "text": "彼はどうやってやったんだろう。 そして私がそれら"}, {"type": "subtitle", "time": 2981.829, "timestamp": "00:49:41", "text": "全てを見せたら、あなたは「うわ、"}, {"type": "subtitle", "time": 2984.069, "timestamp": "00:49:44", "text": "それはすごい」と思うでしょう。   そういうことには、いろいろと手間がかかりすぎるよね"}, {"type": "subtitle", "time": 2988.309, "timestamp": "00:49:48", "text": "？"}, {"type": "subtitle", "time": 2992.15, "timestamp": "00:49:52", "text": "すべて。 でも、そうですね、同じような反応、"}, {"type": "subtitle", "time": 2995.19, "timestamp": "00:49:55", "text": "同じような奇妙なプロセスは、私がより"}]
[{"type": "subtitle", "time": 900.55, "timestamp": "00:15:00", "text": "私の"}, {"type": "subtitle", "time": 905.189, "timestamp": "00:15:05", "text": "ストリーマー ボットと Sammy の設定からようやく大きく改善されました。"}, {"type": "subtitle", "time": 907.509, "timestamp": "00:15:07", "text": "クラウドにあるので、"}, {"type": "subtitle", "time": 913.189, "timestamp": "00:15:13", "text": "IRL ストリームをするときに、"}, {"type": "subtitle", "time": 916.069, "timestamp": "00:15:16", "text": "携帯電話からストリーミングするときに、これが役立つと考えてください。重要な"}, {"type": "subtitle", "time": 921.03, "timestamp": "00:15:21", "text": "リマインダーや重要なメッセージ、または"}, {"type": "subtitle", "time": 923.91, "timestamp": "00:15:23", "text": "モデレーションや私が確認する必要のあるものがあれば、"}, {"type": "subtitle", "time": 927.829, "timestamp": "00:15:27", "text": "ストリームの後、または"}, {"type": "subtitle", "time": 930.31, "timestamp": "00:15:30", "text": "数年後、"}, {"type": "subtitle", "time": 933.03, "timestamp": "00:15:33", "text": "数ヶ月後、または任意のときに、"}, {"type": "subtitle", "time": 935.509, "timestamp": "00:15:35", "text": "ログがあるので、"}, {"type": "subtitle", "time": 939.925, "timestamp": "00:15:39", "text": "それを読むことができます。これは役立ちます"}, {"type": "subtitle", "time": 940.629, "timestamp": "00:15:40", "text": "[笑い]"}, {"type": "subtitle", "time": 946.79, "timestamp": "00:15:46", "text": "屋外などで PC やラップトップをオンにしておく必要はありません。 いいえ、"}, {"type": "subtitle", "time": 950.71, "timestamp": "00:15:50", "text": "ローカルソフトウェアなど全てを実行してください。 これは、非常に"}, {"type": "subtitle", "time": 954.629, "timestamp": "00:15:54", "text": "注目すべき追加のアップグレード"}, {"type": "subtitle", "time": 957.189, "timestamp": "00:15:57", "text": "または改善です。 ほんの少しの"}]
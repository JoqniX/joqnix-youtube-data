[{"type": "subtitle", "time": 3303.349, "timestamp": "00:55:03", "text": "ここにいて、積極的に活動しているので、考える必要性を解消できると思います。 とりあえず今ある状態で"}, {"type": "subtitle", "time": 3308.15, "timestamp": "00:55:08", "text": "更新します。"}, {"type": "subtitle", "time": 3330.87, "timestamp": "00:55:30", "text": "。 私はチャットを続けます。"}, {"type": "subtitle", "time": 3334.63, "timestamp": "00:55:34", "text": "チャットを読むことができます。 君たちをそこに留めておくよ。"}, {"type": "subtitle", "time": 3337.91, "timestamp": "00:55:37", "text": "だから、心配しないでください。 私はまだ読書中です。"}, {"type": "subtitle", "time": 3340.309, "timestamp": "00:55:40", "text": "でも"}, {"type": "subtitle", "time": 3342.63, "timestamp": "00:55:42", "text": "、"}, {"type": "subtitle", "time": 3345.829, "timestamp": "00:55:45", "text": "Discordのログを見る限り、"}, {"type": "subtitle", "time": 3349.829, "timestamp": "00:55:49", "text": "チャットIDは機能していて、ユーザー名も機能していて、"}, {"type": "subtitle", "time": 3359.27, "timestamp": "00:55:59", "text": "あなたがチャットをしている場合、"}]
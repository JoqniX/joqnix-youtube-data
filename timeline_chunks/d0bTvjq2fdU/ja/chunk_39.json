[{"type": "subtitle", "time": 2340.47, "timestamp": "00:39:00", "text": "仕事として曲げることの主なことは、"}, {"type": "subtitle", "time": 2345.27, "timestamp": "00:39:05", "text": "基本的に、ええと、ウェブ"}, {"type": "subtitle", "time": 2350.55, "timestamp": "00:39:10", "text": "サイトのことです。"}, {"type": "subtitle", "time": 2354.069, "timestamp": "00:39:14", "text": "知らない人のために説明すると、私は自分のウェブサイトを持っています。自分のウェブサイトを持っていますが、"}, {"type": "subtitle", "time": 2361.99, "timestamp": "00:39:21", "text": "まだ"}, {"type": "subtitle", "time": 2366.39, "timestamp": "00:39:26", "text": "完全に更新されていません。なので、"}, {"type": "subtitle", "time": 2370.069, "timestamp": "00:39:30", "text": "ウェブサイトの内容も更新する必要があります。   だから、やるべきことは山ほどあるんだ"}, {"type": "subtitle", "time": 2384.47, "timestamp": "00:39:44", "text": "待って、新しいホライブユニットが来るよ。"}, {"type": "subtitle", "time": 2387.03, "timestamp": "00:39:47", "text": "何？"}, {"type": "subtitle", "time": 2397.829, "timestamp": "00:39:57", "text": "約2年ぶりに新しいユニットが登場します"}]
[{"type": "subtitle", "time": 2281.19, "timestamp": "00:38:01", "text": "それは私が考えていたことの一つです"}, {"type": "subtitle", "time": 2283.99, "timestamp": "00:38:03", "text": "。"}, {"type": "subtitle", "time": 2286.47, "timestamp": "00:38:06", "text": "音楽に関するちょっとした短い"}, {"type": "subtitle", "time": 2287.99, "timestamp": "00:38:07", "text": "セクションとか、そういうのがあるでしょ"}, {"type": "subtitle", "time": 2290.55, "timestamp": "00:38:10", "text": "？ それで、もし前回の [音楽] の時みたいに、もし日本のストリーマーが僕をフォローしてくれていたら、"}, {"type": "subtitle", "time": 2303.51, "timestamp": "00:38:23", "text": "少し変えてもっと日本語を入れたりできたらいいなと思ったんです"}, {"type": "subtitle", "time": 2315.27, "timestamp": "00:38:35", "text": "のチャンネルが削除されてしまった"}, {"type": "subtitle", "time": 2333.829, "timestamp": "00:38:53", "text": "ゆっくりとそうしていきます。"}, {"type": "subtitle", "time": 2336.79, "timestamp": "00:38:56", "text": "そうですね、私が思うに、"}]
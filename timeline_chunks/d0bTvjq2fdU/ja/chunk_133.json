[{"type": "subtitle", "time": 7981.43, "timestamp": "02:13:01", "text": "いくつかテストしてみたり、以前配信でやっていたことについて話したりしました"}, {"type": "subtitle", "time": 7987.189, "timestamp": "02:13:07", "text": "。"}, {"type": "subtitle", "time": 7990.229, "timestamp": "02:13:10", "text": "それらのほとんどは、"}, {"type": "subtitle", "time": 7993.43, "timestamp": "02:13:13", "text": "画面の裏側で行われるようなバックエンド処理です。"}, {"type": "subtitle", "time": 7997.03, "timestamp": "02:13:17", "text": "調べたり、ウェブ"}, {"type": "subtitle", "time": 7999.43, "timestamp": "02:13:19", "text": "サイトなどにアクセスしたりしない限り、それらのシーンを見ることはできません。   ええと、それ"}, {"type": "subtitle", "time": 8003.669, "timestamp": "02:13:23", "text": "以外は良かったです。 そこで私たちは色々な"}, {"type": "subtitle", "time": 8011.83, "timestamp": "02:13:31", "text": "皆さん、改めてありがとうございました"}, {"type": "subtitle", "time": 8014.149, "timestamp": "02:13:34", "text": "。"}, {"type": "subtitle", "time": 8016.629, "timestamp": "02:13:36", "text": "えっと、こんにちは。"}, {"type": "subtitle", "time": 8019.27, "timestamp": "02:13:39", "text": "ゴリラの配信は楽しいですね。 えっと、"}, {"type": "subtitle", "time": 8022.47, "timestamp": "02:13:42", "text": "もっと"}, {"type": "subtitle", "time": 8025.189, "timestamp": "02:13:45", "text": "おしゃべりになる必要があるんです。"}, {"type": "subtitle", "time": 8028.95, "timestamp": "02:13:48", "text": "えっと、もっとやらなきゃ。 もっと話をする必要がある"}, {"type": "subtitle", "time": 8031.75, "timestamp": "02:13:51", "text": "。 うん。"}, {"type": "subtitle", "time": 8033.99, "timestamp": "02:13:53", "text": "ああ、パキッ。"}, {"type": "subtitle", "time": 8036.87, "timestamp": "02:13:56", "text": "でも、次回は"}, {"type": "subtitle", "time": 8039.189, "timestamp": "02:13:59", "text": "過去にやったこと"}]
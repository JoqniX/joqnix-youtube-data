[{"type": "subtitle", "time": 2641.43, "timestamp": "00:44:01", "text": "。 えっと、ちょっと待ってください"}, {"type": "subtitle", "time": 2643.349, "timestamp": "00:44:03", "text": "。 これから何をするかとか、まだやらなきゃいけないこととか、"}, {"type": "subtitle", "time": 2645.589, "timestamp": "00:44:05", "text": "そういうことを長々と話したくなかったんです"}, {"type": "subtitle", "time": 2647.75, "timestamp": "00:44:07", "text": "。"}, {"type": "subtitle", "time": 2649.495, "timestamp": "00:44:09", "text": "そして全て。  [音楽] でも"}, {"type": "subtitle", "time": 2650.87, "timestamp": "00:44:10", "text": "[咳払い]"}, {"type": "subtitle", "time": 2653.51, "timestamp": "00:44:13", "text": "まあ、"}, {"type": "subtitle", "time": 2655.75, "timestamp": "00:44:15", "text": "その話題になったからには、"}, {"type": "subtitle", "time": 2671.27, "timestamp": "00:44:31", "text": "M. 雲がどんな風に見えるか見てみたい"}, {"type": "subtitle", "time": 2673.589, "timestamp": "00:44:33", "text": "？   ちょっと"}, {"type": "subtitle", "time": 2683.829, "timestamp": "00:44:43", "text": "素晴らしいです。"}, {"type": "subtitle", "time": 2687.485, "timestamp": "00:44:47", "text": "待って、接続中です。 接続中です。"}]
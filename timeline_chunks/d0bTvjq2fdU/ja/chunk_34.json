[{"type": "subtitle", "time": 2041.59, "timestamp": "00:34:01", "text": "これが主な機能です。 これにより、"}, {"type": "subtitle", "time": 2044.23, "timestamp": "00:34:04", "text": "私のチャンネルのすべてのビデオ、"}, {"type": "subtitle", "time": 2045.75, "timestamp": "00:34:05", "text": "私のチャンネルのすべてのプレイリストが取得され、"}, {"type": "subtitle", "time": 2049.829, "timestamp": "00:34:09", "text": "ランダム化され、スケジュール マップが作成され、"}, {"type": "subtitle", "time": 2053.909, "timestamp": "00:34:13", "text": "ランダム化されたタイム スタンプなどが作成されます"}, {"type": "subtitle", "time": 2058.31, "timestamp": "00:34:18", "text": "。 ええ、この合計"}, {"type": "subtitle", "time": 2063.109, "timestamp": "00:34:23", "text": "最大動画数、グローバル動画数、その他諸々です"}, {"type": "subtitle", "time": 2065.99, "timestamp": "00:34:25", "text": "。"}, {"type": "subtitle", "time": 2068.389, "timestamp": "00:34:28", "text": "つまり、これは"}, {"type": "subtitle", "time": 2072.069, "timestamp": "00:34:32", "text": "私たちの種族のリスト全体を"}, {"type": "subtitle", "time": 2073.829, "timestamp": "00:34:33", "text": "このようにするということです。 これは"}, {"type": "subtitle", "time": 2075.909, "timestamp": "00:34:35", "text": "チャンネル全体の動画のようなものです。"}, {"type": "subtitle", "time": 2079.109, "timestamp": "00:34:39", "text": "これは、私が"}, {"type": "subtitle", "time": 2085.589, "timestamp": "00:34:45", "text": "100本以上の動画を持っていると思うのですが、どうでしょうか？"}, {"type": "subtitle", "time": 2094.95, "timestamp": "00:34:54", "text": "そう、私はそれが必要だ。確か"}, {"type": "subtitle", "time": 2098.63, "timestamp": "00:34:58", "text": "去年やったと思う。 いいえ、これは"}]
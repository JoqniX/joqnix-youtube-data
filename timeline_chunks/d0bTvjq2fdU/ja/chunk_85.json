[{"type": "subtitle", "time": 5101.83, "timestamp": "01:25:01", "text": "つまり、これは、えっと、ちょっと待ってください、ちょっと見せます、えっと、"}, {"type": "subtitle", "time": 5130.709, "timestamp": "01:25:30", "text": "デスクトップ用に描いた方がずっといいと思う。 よし。"}, {"type": "subtitle", "time": 5141.669, "timestamp": "01:25:41", "text": "それは私が見せたかったデスクトップ画面ではありません"}, {"type": "subtitle", "time": 5151.99, "timestamp": "01:25:51", "text": "待って、これ見えますか？"}, {"type": "subtitle", "time": 5155.669, "timestamp": "01:25:55", "text": "こんにちは。 えっと、これですね。 ご覧のとおり、以前はこのような"}]
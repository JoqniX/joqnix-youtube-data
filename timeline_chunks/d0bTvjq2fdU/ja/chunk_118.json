[{"type": "subtitle", "time": 7081.27, "timestamp": "01:58:01", "text": "現在、"}, {"type": "subtitle", "time": 7087.35, "timestamp": "01:58:07", "text": "アーカイブについても同じことが言えます。 それは"}, {"type": "subtitle", "time": 7092.87, "timestamp": "01:58:12", "text": "ウィリーとTwitchのチャンネルを表示するだけで、それだけです"}, {"type": "subtitle", "time": 7096.55, "timestamp": "01:58:16", "text": "。 でも、以前は"}, {"type": "subtitle", "time": 7099.91, "timestamp": "01:58:19", "text": "直接[音楽]のようなものがあって、"}, {"type": "subtitle", "time": 7106.95, "timestamp": "01:58:26", "text": "Twitch Vへの直接リンクを見ることができました。ストリームが終わったらクリックして"}, {"type": "subtitle", "time": 7110.709, "timestamp": "01:58:30", "text": "、"}, {"type": "subtitle", "time": 7113.35, "timestamp": "01:58:33", "text": "TwitchのストリームのTwitchアーカイブを視聴すると、"}, {"type": "subtitle", "time": 7118.55, "timestamp": "01:58:38", "text": "7日後には、"}, {"type": "subtitle", "time": 7121.99, "timestamp": "01:58:41", "text": "ここのものがtwitch.tv/dognet/videosのURLに自動的に切り替わります"}, {"type": "subtitle", "time": 7136.31, "timestamp": "01:58:56", "text": "7 日後か 14 日後に正しかったからですよね"}]
[{"type": "subtitle", "time": 1862.95, "timestamp": "00:31:02", "text": "月とかで90本くらい必要だよね？ つまり、"}, {"type": "subtitle", "time": 1873.029, "timestamp": "00:31:13", "text": "20から90までの残りの数字は"}, {"type": "subtitle", "time": 1874.71, "timestamp": "00:31:14", "text": "ランダム化されるということです。"}, {"type": "subtitle", "time": 1877.43, "timestamp": "00:31:17", "text": "私の最新動画を見ることもできますし、一番"}, {"type": "subtitle", "time": 1880.149, "timestamp": "00:31:20", "text": "古い動画を見ることもできます。 何が起こるかわからない"}, {"type": "subtitle", "time": 1882.789, "timestamp": "00:31:22", "text": "。 これはランダムなループです。"}, {"type": "subtitle", "time": 1884.95, "timestamp": "00:31:24", "text": "それで、これが君が"}, {"type": "subtitle", "time": 1889.269, "timestamp": "00:31:29", "text": "見せたいクールなもんだよ。"}, {"type": "subtitle", "time": 1893.029, "timestamp": "00:31:33", "text": "えっと、それはどこにあるの？ はい、これが"}, {"type": "subtitle", "time": 1896.789, "timestamp": "00:31:36", "text": "コントロールパネルです。 これらはすべて 90 の"}, {"type": "subtitle", "time": 1898.95, "timestamp": "00:31:38", "text": "ビデオ ID で、"}, {"type": "subtitle", "time": 1902.389, "timestamp": "00:31:42", "text": "これがスケジュールです。最初の"}, {"type": "subtitle", "time": 1904.47, "timestamp": "00:31:44", "text": "スケジュールはこれ [音楽]、2 番目のスケジュールは"}, {"type": "subtitle", "time": 1907.269, "timestamp": "00:31:47", "text": "これ、3 番目のスケジュールはこれ、"}, {"type": "subtitle", "time": 1909.269, "timestamp": "00:31:49", "text": "4 番目のスケジュールはこれ、5 番目のスケジュールは"}, {"type": "subtitle", "time": 1912.549, "timestamp": "00:31:52", "text": "ランダムで、これらはランダム ID などです。"}, {"type": "subtitle", "time": 1916.47, "timestamp": "00:31:56", "text": "メインのビデオ ID などがあり、"}]
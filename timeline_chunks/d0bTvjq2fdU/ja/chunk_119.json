[{"type": "subtitle", "time": 7144.95, "timestamp": "01:59:04", "text": "それで、[笑い]"}, {"type": "subtitle", "time": 7147.43, "timestamp": "01:59:07", "text": "私はこのことについてとても詳しく考えました。"}, {"type": "subtitle", "time": 7150.79, "timestamp": "01:59:10", "text": "特にこのVODをアップロードするときにはね。"}, {"type": "subtitle", "time": 7154.87, "timestamp": "01:59:14", "text": "このVODをBilly Billyにアップロードするときは"}, {"type": "subtitle", "time": 7158.31, "timestamp": "01:59:18", "text": "、"}, {"type": "subtitle", "time": 7162.149, "timestamp": "01:59:22", "text": "ここにBillyのビデオURLを載せますよね？"}, {"type": "subtitle", "time": 7167.51, "timestamp": "01:59:27", "text": "チャンネルのURLではなく。 それで、"}, {"type": "subtitle", "time": 7169.669, "timestamp": "01:59:29", "text": "何かしたと思うんだけど、"}, {"type": "subtitle", "time": 7174.39, "timestamp": "01:59:34", "text": "何だったか覚えてない。"}, {"type": "subtitle", "time": 7178.31, "timestamp": "01:59:38", "text": "何かをした記憶がある。"}, {"type": "subtitle", "time": 7195.91, "timestamp": "01:59:55", "text": "私は確かに何かをした。   ああ"}]
[{"type": "subtitle", "time": 1622.47, "timestamp": "00:27:02", "text": "終わると、90曲中2曲に切り替わります。"}, {"type": "subtitle", "time": 1624.31, "timestamp": "00:27:04", "text": "つまり、毎週土曜日に（音楽が）"}, {"type": "subtitle", "time": 1626.39, "timestamp": "00:27:06", "text": "変わります。"}, {"type": "subtitle", "time": 1630.39, "timestamp": "00:27:10", "text": "毎週土曜日に内容が変わり、毎回"}, {"type": "subtitle", "time": 1632.95, "timestamp": "00:27:12", "text": "異なるコンテンツが提供されます。"}, {"type": "subtitle", "time": 1635.269, "timestamp": "00:27:15", "text": "スケジュールが変更されます。 今日の予定は"}, {"type": "subtitle", "time": 1637.269, "timestamp": "00:27:17", "text": "メタガマンで、"}, {"type": "subtitle", "time": 1639.19, "timestamp": "00:27:19", "text": "ヴィンスがPUBGとガンダム"}, {"type": "subtitle", "time": 1641.19, "timestamp": "00:27:21", "text": "レボリューションに出会うという内容ですが、"}, {"type": "subtitle", "time": 1645.51, "timestamp": "00:27:25", "text": "変更される可能性があります。 それは良いことだ。 えっと、"}, {"type": "subtitle", "time": 1648.07, "timestamp": "00:27:28", "text": "修正されたビデオとかがいつも見られるわけじゃないんですよね"}, {"type": "subtitle", "time": 1651.11, "timestamp": "00:27:31", "text": "。 こんにちは、"}, {"type": "subtitle", "time": 1658.47, "timestamp": "00:27:38", "text": "ええと、今日はただおしゃべりして、"}, {"type": "subtitle", "time": 1661.35, "timestamp": "00:27:41", "text": "彼のために計画を立てて準備しています。"}, {"type": "subtitle", "time": 1664.549, "timestamp": "00:27:44", "text": "ああ、これは本当に興味深いですね。もっと詳しく説明すると、"}, {"type": "subtitle", "time": 1670.549, "timestamp": "00:27:50", "text": "なぜ"}, {"type": "subtitle", "time": 1672.31, "timestamp": "00:27:52", "text": "また説明しているのかわかりません。"}, {"type": "subtitle", "time": 1676.87, "timestamp": "00:27:56", "text": "これを披露するのは、ある意味楽しい。 ええ、そうですね"}]
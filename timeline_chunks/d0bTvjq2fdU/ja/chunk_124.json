[{"type": "subtitle", "time": 7441.51, "timestamp": "02:04:01", "text": "うん。 うん。 うん。   何てことだ"}, {"type": "subtitle", "time": 7451.75, "timestamp": "02:04:11", "text": "、いいよ。 もうどうでもいい。"}, {"type": "subtitle", "time": 7454.31, "timestamp": "02:04:14", "text": "壊れた。"}, {"type": "subtitle", "time": 7456.87, "timestamp": "02:04:16", "text": "待って。 フォートナイト。 少なくとも私は「うん、"}, {"type": "subtitle", "time": 7459.75, "timestamp": "02:04:19", "text": "ドットを入れたよ」と書きました。 ああ、くそ。   点を"}, {"type": "subtitle", "time": 7462.39, "timestamp": "02:04:22", "text": "打つ。 わかった、いいよ。"}, {"type": "subtitle", "time": 7464.07, "timestamp": "02:04:24", "text": "つまり、これらはテンプレートです。 これは毎回"}, {"type": "subtitle", "time": 7469.35, "timestamp": "02:04:29", "text": "自動的に作成されるので、私は"}, {"type": "subtitle", "time": 7473.189, "timestamp": "02:04:33", "text": "このためにSammyを使っていると思います。"}, {"type": "subtitle", "time": 7480.629, "timestamp": "02:04:40", "text": "ない。"}, {"type": "subtitle", "time": 7483.43, "timestamp": "02:04:43", "text": "つまり、"}, {"type": "subtitle", "time": 7498.229, "timestamp": "02:04:58", "text": "多くのことを処理できるはずだったということだ。"}]
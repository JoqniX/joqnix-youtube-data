[{"type": "subtitle", "time": 843.189, "timestamp": "00:14:03", "text": "これは私が作った新しいものです。 えっと、"}, {"type": "subtitle", "time": 846.71, "timestamp": "00:14:06", "text": "知らない人のために説明すると、"}, {"type": "subtitle", "time": 849.509, "timestamp": "00:14:09", "text": "昔からあるやつで、"}, {"type": "subtitle", "time": 853.829, "timestamp": "00:14:13", "text": "ストリームチャットとかその他諸々をログに記録しているんです"}, {"type": "subtitle", "time": 856.949, "timestamp": "00:14:16", "text": "。 それで、新しい"}, {"type": "subtitle", "time": 859.829, "timestamp": "00:14:19", "text": "アップデート版を作りました。それがこれです。"}, {"type": "subtitle", "time": 862.31, "timestamp": "00:14:22", "text": "これは古い方です。 わかった。 以前のバージョンは、"}, {"type": "subtitle", "time": 865.03, "timestamp": "00:14:25", "text": "小さなものとか、えーと、"}, {"type": "subtitle", "time": 868.069, "timestamp": "00:14:28", "text": "自分の"}, {"type": "subtitle", "time": 870.15, "timestamp": "00:14:30", "text": "スレッドとか、そういうものが多すぎたんだよね？ これは以前は"}, {"type": "subtitle", "time": 874.069, "timestamp": "00:14:34", "text": "ローカルで実行されていました。 ソフトウェアを実行する必要があるんですが、"}, {"type": "subtitle", "time": 876.069, "timestamp": "00:14:36", "text": "それはローカルで実行されるんですよね"}, {"type": "subtitle", "time": 878.87, "timestamp": "00:14:38", "text": "？ しかし今はすべてCloudflareに切り替えました"}, {"type": "subtitle", "time": 882.71, "timestamp": "00:14:42", "text": "。 現在はクラウドベースのシステムを使用しています"}, {"type": "subtitle", "time": 887.509, "timestamp": "00:14:47", "text": "。 それで、Twitch チャットが"}, {"type": "subtitle", "time": 890.55, "timestamp": "00:14:50", "text": "ここに表示され、キック チャットも"}, {"type": "subtitle", "time": 894.55, "timestamp": "00:14:54", "text": "ここに表示されます。チャット ユーザーのすべてのコメントが"}, {"type": "subtitle", "time": 897.11, "timestamp": "00:14:57", "text": "記録されます。これで、"}]
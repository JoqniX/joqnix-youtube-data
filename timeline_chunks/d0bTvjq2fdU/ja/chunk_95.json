[{"type": "subtitle", "time": 5702.79, "timestamp": "01:35:02", "text": "最初から最後まで再生して見ることができます。 ええ、"}, {"type": "subtitle", "time": 5706.709, "timestamp": "01:35:06", "text": "IDは同じままですが、Twitchでは"}, {"type": "subtitle", "time": 5711.11, "timestamp": "01:35:11", "text": "異なります。 ライブ配信には、"}, {"type": "subtitle", "time": 5715.27, "timestamp": "01:35:15", "text": "ビデオIDやライブID、"}, {"type": "subtitle", "time": 5718.39, "timestamp": "01:35:18", "text": "ライブビデオIDなど、"}, {"type": "subtitle", "time": 5721.11, "timestamp": "01:35:21", "text": "ライブストリームのようなものがあり、そのIDは"}, {"type": "subtitle", "time": 5725.75, "timestamp": "01:35:25", "text": "配信が終了して、"}, {"type": "subtitle", "time": 5728.629, "timestamp": "01:35:28", "text": "その配信がビデオ、つまり"}, {"type": "subtitle", "time": 5733.51, "timestamp": "01:35:33", "text": "オンデマンドビデオに変換されるときとは異なります。ええ、その"}, {"type": "subtitle", "time": 5736.229, "timestamp": "01:35:36", "text": "IDも異なります。"}, {"type": "subtitle", "time": 5745.669, "timestamp": "01:35:45", "text": "しかし、私は"}, {"type": "subtitle", "time": 5754.39, "timestamp": "01:35:54", "text": "その問題への対処法を見つけたと信じています。"}, {"type": "subtitle", "time": 5757.83, "timestamp": "01:35:57", "text": "GitHubに行ってみます。何か操作をしたような"}]
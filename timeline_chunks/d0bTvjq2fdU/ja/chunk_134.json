[{"type": "subtitle", "time": 8042.149, "timestamp": "02:14:02", "text": "とか技術的なことについては話さないようにします。複雑すぎるので、ほとんどの"}, {"type": "subtitle", "time": 8044.629, "timestamp": "02:14:04", "text": "人はショーの音楽を理解しないと思うからです"}, {"type": "subtitle", "time": 8049.03, "timestamp": "02:14:09", "text": "。 いいえ、"}, {"type": "subtitle", "time": 8052.069, "timestamp": "02:14:12", "text": "次回は今日のような"}, {"type": "subtitle", "time": 8055.83, "timestamp": "02:14:15", "text": "画面キャプチャのような方法で開かないようにします"}, {"type": "subtitle", "time": 8058.229, "timestamp": "02:14:18", "text": "。  API関連の情報など、音楽関連の情報を少し漏洩してしまったような気がします"}, {"type": "subtitle", "time": 8062.229, "timestamp": "02:14:22", "text": "。"}, {"type": "subtitle", "time": 8064.95, "timestamp": "02:14:24", "text": "つまり、たとえ誰かがそれを使っていたとしても、"}, {"type": "subtitle", "time": 8067.35, "timestamp": "02:14:27", "text": "何も起こらないだろう。 つまり、"}, {"type": "subtitle", "time": 8070.87, "timestamp": "02:14:30", "text": "アクセスできるのは私の情報と"}, {"type": "subtitle", "time": 8074.229, "timestamp": "02:14:34", "text": "YouTube動画の公開情報データだけになります。 それはYouTube APIを"}, {"type": "subtitle", "time": 8077.669, "timestamp": "02:14:37", "text": "使った簡単な操作で簡単に取得できますよ"}, {"type": "subtitle", "time": 8092.709, "timestamp": "02:14:52", "text": "私たちは本当にすごい存在だよ。"}, {"type": "subtitle", "time": 8095.27, "timestamp": "02:14:55", "text": "さあ、もう12時だ。ということで、そろそろ"}, {"type": "subtitle", "time": 8097.83, "timestamp": "02:14:57", "text": "締めくくりたいと思います。   来てくださった"}]
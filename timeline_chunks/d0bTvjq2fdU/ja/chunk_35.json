[{"type": "subtitle", "time": 2103.27, "timestamp": "00:35:03", "text": "私が日本に来る前に済ませたことです。 ええ、"}, {"type": "subtitle", "time": 2105.99, "timestamp": "00:35:05", "text": "これらはすべて完了しました。"}, {"type": "subtitle", "time": 2109.109, "timestamp": "00:35:09", "text": "そして、お気づきかもしれませんが、"}, {"type": "subtitle", "time": 2112.87, "timestamp": "00:35:12", "text": "最近はSammyを全く使っていません。これは、私のように"}, {"type": "subtitle", "time": 2122.47, "timestamp": "00:35:22", "text": "これを積極的に使っている人間からすると、本当に興味深いことです。"}, {"type": "subtitle", "time": 2125.75, "timestamp": "00:35:25", "text": "ええと、最近はあまり使っていないのですが、"}, {"type": "subtitle", "time": 2131.03, "timestamp": "00:35:31", "text": "それ自体が改善と言えるかもしれませんね"}, {"type": "subtitle", "time": 2139.51, "timestamp": "00:35:39", "text": "つまり、私がそれを使うことは滅多にないんです。"}, {"type": "subtitle", "time": 2151.75, "timestamp": "00:35:51", "text": "本当に興味深いですね。   では"}, {"type": "subtitle", "time": 2154.39, "timestamp": "00:35:54", "text": "、わかりました"}, {"type": "subtitle", "time": 2159.91, "timestamp": "00:35:59", "text": "。 さて、今日の話に戻りますが、いくつか"}]
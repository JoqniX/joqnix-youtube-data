[{"type": "subtitle", "time": 29641.19, "timestamp": "08:14:01", "text": "哦，我沒事。別理我。  我"}, {"type": "subtitle", "time": 29653.11, "timestamp": "08:14:13", "text": "只需要搞定他們的治療者，這才是關鍵。什麼？我被誰殺死了？  看起來"}, {"type": "subtitle", "time": 29657.19, "timestamp": "08:14:17", "text": "像是任務。你好。現在就來把它帶回家吧。不，我當時在看別的東西。該死的"}, {"type": "subtitle", "time": 29677.03, "timestamp": "08:14:37", "text": "。任務區域由你負責。  媽的。加油，團隊！我們掌控著局面。  無處可藏"}]
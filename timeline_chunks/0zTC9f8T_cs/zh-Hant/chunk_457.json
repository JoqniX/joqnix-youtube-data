[{"type": "subtitle", "time": 27442.628, "timestamp": "07:37:22", "text": "網站。  幫助。好冷。  耶穌。  這是怎麼回事？另一個人：那他媽是誰？  那是月光下的能力"}, {"type": "subtitle", "time": 27450.708, "timestamp": "07:37:30", "text": "。"}, {"type": "subtitle", "time": 27457.948, "timestamp": "07:37:37", "text": "你以為你能逃脫。  很公平。很公平。很公平。  是的，"}, {"type": "subtitle", "time": 27477.75, "timestamp": "07:37:57", "text": "我不喜歡這款遊戲裡的蜘蛛人。  是啊，我聽說很難。真是太煩了。小精靈。有人嗎？  啊，我的"}]
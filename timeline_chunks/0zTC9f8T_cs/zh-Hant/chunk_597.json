[{"type": "subtitle", "time": 35834.23, "timestamp": "09:57:14", "text": "你們會玩雪"}, {"type": "subtitle", "time": 35854.15, "timestamp": "09:57:34", "text": "嗎？對我來說，從來沒下過雪。我從來沒見過雪。我很"}, {"type": "subtitle", "time": 35857.47, "timestamp": "09:57:37", "text": "遺憾。我想摸摸雪。我好久沒見過雪了。老兄，"}, {"type": "subtitle", "time": 35866.55, "timestamp": "09:57:46", "text": "我冬天就看看動漫什麼的。這就是我整個冬天都在做的事。不過"}, {"type": "subtitle", "time": 35869.906, "timestamp": "09:57:49", "text": "我也想出去走走，你知道，"}, {"type": "subtitle", "time": 35872.07, "timestamp": "09:57:52", "text": "畢竟是冬天，假期就應該和朋友一起放鬆，舒舒服服地待在家裡。舒舒服服的。那感覺肯定很棒。對"}, {"type": "subtitle", "time": 35879.31, "timestamp": "09:57:59", "text": "，肯定很棒"}]
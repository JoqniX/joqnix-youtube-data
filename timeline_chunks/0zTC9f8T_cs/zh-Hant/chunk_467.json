[{"type": "subtitle", "time": 28029.51, "timestamp": "07:47:09", "text": "不"}, {"type": "subtitle", "time": 28033.91, "timestamp": "07:47:13", "text": "知道你是怎麼擁有這麼大"}, {"type": "subtitle", "time": 28035.75, "timestamp": "07:47:15", "text": "記憶體的。不，不過"}, {"type": "subtitle", "time": 28044.948, "timestamp": "07:47:24", "text": "喬的確家境富裕。低調。  破產了。"}, {"type": "subtitle", "time": 28052.19, "timestamp": "07:47:32", "text": "我的天啊。我們不評斷。離開。  Doc把直播當作嗜好。該死，我輸了。我死了。那可"}, {"type": "subtitle", "time": 28055.91, "timestamp": "07:47:35", "text": "不好。現在綠巨人生氣了。  如果沒有治療者，我就玩不了靈能術士。你他媽想讓我玩什麼？在孔裡"}, {"type": "subtitle", "time": 28059.19, "timestamp": "07:47:39", "text": "打孔。我不知道為什麼，但我認為它沒有療效。  從不失手，但敵人總會重新選一個"}]
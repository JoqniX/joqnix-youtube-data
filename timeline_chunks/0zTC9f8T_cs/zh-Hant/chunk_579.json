[{"type": "subtitle", "time": 34740.23, "timestamp": "09:39:00", "text": "但是，是的，我真的，"}, {"type": "subtitle", "time": 34742.51, "timestamp": "09:39:02", "text": "嗯，我有一個1660 Super。好的。對了，這是我的直播電腦，不是遊戲電腦"}, {"type": "subtitle", "time": 34746.07, "timestamp": "09:39:06", "text": "。遊戲電腦被我搞壞了。 CPU 晶片壞了。"}, {"type": "subtitle", "time": 34748.47, "timestamp": "09:39:08", "text": "不過，"}, {"type": "subtitle", "time": 34751.31, "timestamp": "09:39:11", "text": "我已經說過好幾次了"}, {"type": "subtitle", "time": 34753.79, "timestamp": "09:39:13", "text": "。"}, {"type": "subtitle", "time": 34775.11, "timestamp": "09:39:35", "text": "事。我得把所有東西都重新弄一遍。所以，呃，我漏掉了"}, {"type": "subtitle", "time": 34780.746, "timestamp": "09:39:40", "text": "什麼嗎？為什麼我覺得我漏掉了什麼？還是我真的漏掉了什麼？我漏掉了什麼？"}]
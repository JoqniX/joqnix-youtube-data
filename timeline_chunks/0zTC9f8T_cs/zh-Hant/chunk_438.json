[{"type": "subtitle", "time": 26282.99, "timestamp": "07:18:02", "text": "我就得"}, {"type": "subtitle", "time": 26287.03, "timestamp": "07:18:07", "text": "逃跑。"}, {"type": "subtitle", "time": 26289.99, "timestamp": "07:18:09", "text": "我還在想我怎麼說話的？好的，明白了。"}, {"type": "subtitle", "time": 26304.59, "timestamp": "07:18:24", "text": "呃，你在幹嘛？沒有什麼。我來了。我來了。我來了。我其實"}, {"type": "subtitle", "time": 26316.868, "timestamp": "07:18:36", "text": "沒有。  等等，老兄，你直播了這場比賽"}, {"type": "subtitle", "time": 26319.83, "timestamp": "07:18:39", "text": "，對吧？"}]
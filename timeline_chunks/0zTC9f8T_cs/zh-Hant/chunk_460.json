[{"type": "subtitle", "time": 27609.91, "timestamp": "07:40:09", "text": "等等，你午餐吃過了嗎"}, {"type": "subtitle", "time": 27611.99, "timestamp": "07:40:11", "text": "？"}, {"type": "subtitle", "time": 27615.67, "timestamp": "07:40:15", "text": "哦，是的，我們有。我們倆都沒有。這是其中之一。她剛醒，夥計。"}, {"type": "subtitle", "time": 27629.43, "timestamp": "07:40:29", "text": "剛醒。  好了，夠了。該死的。  不可能每場都贏"}, {"type": "subtitle", "time": 27637.628, "timestamp": "07:40:37", "text": "。加布拉是個英雄。是的，我扮演了英雄加布拉。她人還不錯。煩死人了。和加布拉一樣。  加博爾人挺好的。 Loki Guzi，那不可能是真的。  我"}]
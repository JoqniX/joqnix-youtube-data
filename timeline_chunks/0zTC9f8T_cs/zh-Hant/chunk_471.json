[{"type": "subtitle", "time": 28260.07, "timestamp": "07:51:00", "text": "不，不，不，不，不。我在這裡。我在這裡。  你當時好像不打算"}, {"type": "subtitle", "time": 28299.59, "timestamp": "07:51:39", "text": "為什麼我離得這麼遠？  小心蜘蛛窩。"}, {"type": "subtitle", "time": 28301.59, "timestamp": "07:51:41", "text": "我太擅長這個了"}, {"type": "subtitle", "time": 28304.388, "timestamp": "07:51:44", "text": "。醫生，沒人"}]
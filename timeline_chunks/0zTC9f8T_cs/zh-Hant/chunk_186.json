[{"type": "subtitle", "time": 11163.269, "timestamp": "03:06:03", "text": "這是我喜歡的款式，但是"}, {"type": "subtitle", "time": 11185.59, "timestamp": "03:06:25", "text": "哦，他們卸貨了。  還有更多變化或做和Lorde。  胚胎學。  B. 班上最後一名。  我是一塊布料。  保險絲是"}, {"type": "subtitle", "time": 11191.63, "timestamp": "03:06:31", "text": "什麼"}, {"type": "subtitle", "time": 11193.83, "timestamp": "03:06:33", "text": "？"}]
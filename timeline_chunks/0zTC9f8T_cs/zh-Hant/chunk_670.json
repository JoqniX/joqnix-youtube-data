[{"type": "subtitle", "time": 40200.15, "timestamp": "11:10:00", "text": "？哦不。不。走吧"}, {"type": "subtitle", "time": 40203.426, "timestamp": "11:10:03", "text": "。所以，是的，顯然我的"}, {"type": "subtitle", "time": 40211.51, "timestamp": "11:10:11", "text": "大交易有漲有"}, {"type": "subtitle", "time": 40214.55, "timestamp": "11:10:14", "text": "跌。有點……有點……負評。那很好。你知道，我應該做一個類似的東西，或者類似嗯，"}, {"type": "subtitle", "time": 40229.19, "timestamp": "11:10:29", "text": "我怎麼知道我的直播什麼時候斷了"}, {"type": "subtitle", "time": 40232.47, "timestamp": "11:10:32", "text": "？我在想有沒有辦法可以設定一個提醒，例如發出嗶嗶聲之類的，當直播明顯斷線的時候就發出提示音。我想知道你們是怎麼"}]
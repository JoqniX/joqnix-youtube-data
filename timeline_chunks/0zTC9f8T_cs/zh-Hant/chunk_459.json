[{"type": "subtitle", "time": 27540.948, "timestamp": "07:39:00", "text": "60 幀/秒的速度做這件事很難"}, {"type": "subtitle", "time": 27580.788, "timestamp": "07:39:40", "text": "，我正在跟他交涉。  你好嗎？做好事。  他們為什麼要"}, {"type": "subtitle", "time": 27583.59, "timestamp": "07:39:43", "text": "攻擊我？低調。  法官。"}, {"type": "subtitle", "time": 27591.19, "timestamp": "07:39:51", "text": "啊，當然。  我的天哪。"}, {"type": "subtitle", "time": 27594.628, "timestamp": "07:39:54", "text": "我的天哪。  我餓了。"}]
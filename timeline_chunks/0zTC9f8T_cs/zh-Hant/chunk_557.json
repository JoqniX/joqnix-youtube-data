[{"type": "subtitle", "time": 33429.388, "timestamp": "09:17:09", "text": "我關注他很久了，他的影片真的很好，他分享的射箭技巧，以及他如何用彎弓、鋼索弓、戰鬥弓等等"}, {"type": "subtitle", "time": 33453.51, "timestamp": "09:17:33", "text": "進行射擊。真的太棒了。我沒想到"}, {"type": "subtitle", "time": 33470.83, "timestamp": "09:17:50", "text": "今天會聊這麼多關於弓箭的事。哇。"}]
[{"type": "subtitle", "time": 29777.11, "timestamp": "08:16:17", "text": "他媽的誰在追我？別"}, {"type": "subtitle", "time": 29783.19, "timestamp": "08:16:23", "text": "追我了。  他媽的誰在追我？是哈。  海拉"}, {"type": "subtitle", "time": 29797.03, "timestamp": "08:16:37", "text": "一直在追我。媽的。拉屎"}, {"type": "subtitle", "time": 29806.468, "timestamp": "08:16:46", "text": "？  哦，是的。"}, {"type": "subtitle", "time": 29808.868, "timestamp": "08:16:48", "text": "我的天啊。  大家"}, {"type": "subtitle", "time": 29814.868, "timestamp": "08:16:54", "text": "好。她已經離開一段時間了。是的，我今天開始上班。  但是它運行起來很卡頓。"}]
[{"type": "subtitle", "time": 4742.59, "timestamp": "01:19:02", "text": "史萊姆"}, {"type": "subtitle", "time": 4746.87, "timestamp": "01:19:06", "text": "盔甲，戰士，蒸汽朋克。  哦，你可以擁有樂器。我的天哪，"}, {"type": "subtitle", "time": 4753.27, "timestamp": "01:19:13", "text": "你居然可以擁有一架"}, {"type": "subtitle", "time": 4771.83, "timestamp": "01:19:31", "text": "鋼琴。等等，我們應該加上這個。等等，"}, {"type": "subtitle", "time": 4775.11, "timestamp": "01:19:35", "text": "什麼？我們可以添置一架鋼琴。"}, {"type": "subtitle", "time": 4777.91, "timestamp": "01:19:37", "text": "呃，小號。等等，什麼？等等，什麼？我需要一把吉他"}, {"type": "subtitle", "time": 4780.39, "timestamp": "01:19:40", "text": "。  我想那裡應該有把吉他。 25 七種樂器。是的，那裡有把"}, {"type": "subtitle", "time": 4797.63, "timestamp": "01:19:57", "text": "樂器。  那裡有一支小號。這裡有一架鋼琴。  哇。你說什麼？什麼？裡面有鋼琴、吉他之類的"}]
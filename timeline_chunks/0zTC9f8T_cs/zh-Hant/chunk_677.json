[{"type": "subtitle", "time": 40620.47, "timestamp": "11:17:00", "text": "是的，做「空間」也很有趣，我很享受做「空間」的過程。是的"}, {"type": "subtitle", "time": 40649.71, "timestamp": "11:17:29", "text": "有時候會很卡頓，"}, {"type": "subtitle", "time": 40654.266, "timestamp": "11:17:34", "text": "而「空間」唯一的問題就是"}, {"type": "subtitle", "time": 40666.95, "timestamp": "11:17:46", "text": "因為我用的是麥克風，對吧？原始麥克風音訊。"}, {"type": "subtitle", "time": 40674.79, "timestamp": "11:17:54", "text": "所以你能聽到我做的所有事情。甚至我的呼吸聲，甚至我的呼吸聲，甚至風扇的聲音"}]
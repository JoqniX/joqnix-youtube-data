[{"type": "subtitle", "time": 3915.43, "timestamp": "01:05:15", "text": "做了。  等等"}, {"type": "subtitle", "time": 3918.349, "timestamp": "01:05:18", "text": "，是她嗎？是的，是她做的。  是的"}, {"type": "subtitle", "time": 3923.349, "timestamp": "01:05:23", "text": "。"}, {"type": "subtitle", "time": 3925.109, "timestamp": "01:05:25", "text": "為什麼我做不到？搞什麼鬼？等等，讓我再確認一下我的按鍵設置。右鍵，"}, {"type": "subtitle", "time": 3932.47, "timestamp": "01:05:32", "text": "放置物品。"}, {"type": "subtitle", "time": 3940.789, "timestamp": "01:05:40", "text": "西蘭花真好吃。  如果我下馬，我會在"}, {"type": "subtitle", "time": 3943.39, "timestamp": "01:05:43", "text": "哪裡"}, {"type": "subtitle", "time": 3946.349, "timestamp": "01:05:46", "text": "？哦，我的天。"}]
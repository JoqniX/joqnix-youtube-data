[{"type": "subtitle", "time": 10932.07, "timestamp": "03:02:12", "text": "歡迎來到鐵爐模組的入門指南，本指南將提供"}, {"type": "subtitle", "time": 10934.55, "timestamp": "03:02:14", "text": "諸如"}, {"type": "subtitle", "time": 10937.91, "timestamp": "03:02:17", "text": "製作配方等信息，幫助您逐步了解模組內容。介面與原版鐵爐的介面相比有一些新增功能。在這個選單中，"}, {"type": "subtitle", "time": 10965.83, "timestamp": "03:02:45", "text": "你不會看到爆破增強功能使熔爐能夠像爆破爐一樣工作，而熏烤"}]
[{"type": "subtitle", "time": 29890.468, "timestamp": "08:18:10", "text": "那樣。  是那個人殺了你嗎？當著我的面"}, {"type": "subtitle", "time": 29894.388, "timestamp": "08:18:14", "text": "殺了你。是的，我是一名士兵。雙殺你。  也喜歡斯科洛維奇。是的，斯科"}, {"type": "subtitle", "time": 29914.628, "timestamp": "08:18:34", "text": "洛維奇很棒。我很樂意幫忙。我這是在哪裡？  一場"}, {"type": "subtitle", "time": 29931.35, "timestamp": "08:18:51", "text": "有人來治好我了。問題是，敵方"}, {"type": "subtitle", "time": 29933.75, "timestamp": "08:18:53", "text": "隊伍得到了大量的治療，而我卻一點治療都沒有。故事幾乎就是你的了"}]
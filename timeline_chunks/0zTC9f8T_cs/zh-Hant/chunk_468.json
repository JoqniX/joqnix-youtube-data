[{"type": "subtitle", "time": 28102.15, "timestamp": "07:48:22", "text": "脈衝充電。火。  誰都打不穿這個洞。  我投擲球像女孩子嗎？進行切割。  自然提升。  好的。  顫抖吧，求"}, {"type": "subtitle", "time": 28105.11, "timestamp": "07:48:25", "text": "你"}, {"type": "subtitle", "time": 28108.708, "timestamp": "07:48:28", "text": "醫治我。該死的"}, {"type": "subtitle", "time": 28122.948, "timestamp": "07:48:42", "text": "治愈我。  哦，沒有人治好我。美國隊長。"}, {"type": "subtitle", "time": 28127.75, "timestamp": "07:48:47", "text": "嘿，至少我的箭筒又裝滿了箭。  瘋狂的。傷害驚人。瘋狂的。好好"}]
[{"type": "subtitle", "time": 847.91, "timestamp": "00:14:07", "text": "？ WHO？  嚇到我了"}, {"type": "subtitle", "time": 852.15, "timestamp": "00:14:12", "text": "。"}, {"type": "subtitle", "time": 859.99, "timestamp": "00:14:19", "text": "我的天哪，誰畢業了"}, {"type": "subtitle", "time": 869.269, "timestamp": "00:14:29", "text": "？呃，是我。嗯"}, {"type": "subtitle", "time": 871.829, "timestamp": "00:14:31", "text": "？  我們在玩《我的世界》。我需要添加這個資源。  我的天啊。還有多少？"}, {"type": "subtitle", "time": 897.99, "timestamp": "00:14:57", "text": "我今天拿到了一個。我下載了大約31個。是的。  嗯？"}]
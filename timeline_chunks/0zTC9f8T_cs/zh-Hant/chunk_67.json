[{"type": "subtitle", "time": 4021.51, "timestamp": "01:07:01", "text": "？我忘了。哦，"}, {"type": "subtitle", "time": 4025.75, "timestamp": "01:07:05", "text": "等等。嗯，燈光。呃，讓我"}, {"type": "subtitle", "time": 4046.43, "timestamp": "01:07:26", "text": "查一下。  呃，它叫什麼來著？沉浸式飛行體驗。是的。  我的天啊。"}, {"type": "subtitle", "time": 4065.91, "timestamp": "01:07:45", "text": "等等，什麼？  哦，"}, {"type": "subtitle", "time": 4068.43, "timestamp": "01:07:48", "text": "不。"}, {"type": "subtitle", "time": 4076.63, "timestamp": "01:07:56", "text": "哇。等等，我們馬上就要下來了。"}]
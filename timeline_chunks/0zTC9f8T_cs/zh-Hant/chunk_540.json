[{"type": "subtitle", "time": 32404.708, "timestamp": "09:00:04", "text": "直播愉快。"}, {"type": "subtitle", "time": 32408.548, "timestamp": "09:00:08", "text": "拜拜。你好。保重。注意安全。注意安全。謝謝你們來，團隊。我也很想你們。我很好。我很好。我很好。計程車.我的天哪。你錯了。沒關係。沒關係。帕特，別擔心。嗯，最近出了很多遊戲，對吧"}, {"type": "subtitle", "time": 32427.91, "timestamp": "09:00:27", "text": "？例如《無限"}, {"type": "subtitle", "time": 32435.59, "timestamp": "09:00:35", "text": "暖暖》。那是我期待已久的遊戲之一。是啊，《無限暖暖》。我喜歡它。我不知道"}, {"type": "subtitle", "time": 32440.07, "timestamp": "09:00:40", "text": "我有沒有分享過。就像"}, {"type": "subtitle", "time": 32442.868, "timestamp": "09:00:42", "text": "我一直很喜歡它一樣"}, {"type": "subtitle", "time": 32446.868, "timestamp": "09:00:46", "text": "。我算是個時尚達人吧"}, {"type": "subtitle", "time": 32456.548, "timestamp": "09:00:56", "text": "。"}]
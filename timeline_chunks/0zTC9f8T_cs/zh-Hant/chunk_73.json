[{"type": "subtitle", "time": 4392.63, "timestamp": "01:13:12", "text": "哦，走錯地方了。我們降落在那裡吧。  這不是飛機。  是的。  好的。一片"}, {"type": "subtitle", "time": 4408.709, "timestamp": "01:13:28", "text": "美麗的小天地。是的。"}, {"type": "subtitle", "time": 4423.189, "timestamp": "01:13:43", "text": "你為什麼沒有頭？什麼？哦，原來是冰掠者。"}, {"type": "subtitle", "time": 4428.87, "timestamp": "01:13:48", "text": "等待。  等待。我的等待。"}]
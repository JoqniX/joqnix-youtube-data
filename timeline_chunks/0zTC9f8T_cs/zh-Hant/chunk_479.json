[{"type": "subtitle", "time": 28751.59, "timestamp": "07:59:11", "text": "我的天哪。  殺了那個混蛋。基爾殺了他。  是的，我們一定會"}, {"type": "subtitle", "time": 28754.468, "timestamp": "07:59:14", "text": "戰勝它。我"}, {"type": "subtitle", "time": 28766.07, "timestamp": "07:59:26", "text": "的天啊。"}, {"type": "subtitle", "time": 28773.35, "timestamp": "07:59:33", "text": "我是如何起步的。祝"}, {"type": "subtitle", "time": 28783.75, "timestamp": "07:59:43", "text": "您觀看愉快。你好。祝你好運。  祝你考試順利，札基。祝你好運。  小心。  祝你好運。"}]
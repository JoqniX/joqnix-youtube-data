[{"type": "subtitle", "time": 10932.07, "timestamp": "03:02:12", "text": "好的。没有消息。我真的很想让我的"}, {"type": "subtitle", "time": 10934.55, "timestamp": "03:02:14", "text": "现在拥有了自己的房子，可以玩所有这些游戏了。"}, {"type": "subtitle", "time": 10937.91, "timestamp": "03:02:17", "text": "我会添置乐器，并搭建自己的工作室。"}, {"type": "subtitle", "time": 10953.389, "timestamp": "03:02:33", "text": "哇。我甚至连其中一半都不认识。"}, {"type": "subtitle", "time": 10963.11, "timestamp": "03:02:43", "text": "我去测试一下钻机。"}, {"type": "subtitle", "time": 10965.83, "timestamp": "03:02:45", "text": "等等，你想要的是一台钻孔机？"}, {"type": "subtitle", "time": 10968.15, "timestamp": "03:02:48", "text": "我想确认一下。"}, {"type": "subtitle", "time": 10978.429, "timestamp": "03:02:58", "text": "更多的？是的，我想确认一下。呃，一个"}]
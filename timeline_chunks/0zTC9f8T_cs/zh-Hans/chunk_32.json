[{"type": "subtitle", "time": 1923.909, "timestamp": "00:32:03", "text": "这是什么？全部开启/关闭"}, {"type": "subtitle", "time": 1926.389, "timestamp": "00:32:06", "text": "模组包更新。这不"}, {"type": "subtitle", "time": 1929.029, "timestamp": "00:32:09", "text": "影响模组的活动和安装"}, {"type": "subtitle", "time": 1932.149, "timestamp": "00:32:12", "text": "以及安装模组包。默认值"}, {"type": "subtitle", "time": 1933.149, "timestamp": "00:32:13", "text": "是"}, {"type": "subtitle", "time": 1948.07, "timestamp": "00:32:28", "text": "呃，没有改动。好吧，我不会"}, {"type": "subtitle", "time": 1949.71, "timestamp": "00:32:29", "text": "改变"}, {"type": "subtitle", "time": 1952.789, "timestamp": "00:32:32", "text": "那。保存内容。看着我。我是"}, {"type": "subtitle", "time": 1964.389, "timestamp": "00:32:44", "text": "什么？你不能见我的孩子。嗯"}, {"type": "subtitle", "time": 1972.149, "timestamp": "00:32:52", "text": "等待。好的。我能看到你的手在动。"}]
[{"type": "subtitle", "time": 23343.67, "timestamp": "06:29:03", "text": "皮革，一根绳子。哦，原来是这样。我"}, {"type": "subtitle", "time": 23345.51, "timestamp": "06:29:05", "text": "需要精心制作。我必须手动操作。"}, {"type": "subtitle", "time": 23362.75, "timestamp": "06:29:22", "text": "细绳，"}, {"type": "subtitle", "time": 23366.708, "timestamp": "06:29:26", "text": "兄弟。哦，无穷大。哦，瞧。它有一个"}, {"type": "subtitle", "time": 23373.23, "timestamp": "06:29:33", "text": "对不起。我"}, {"type": "subtitle", "time": 23381.67, "timestamp": "06:29:41", "text": "好的。明显的。好的。你看，它有"}, {"type": "subtitle", "time": 23383.91, "timestamp": "06:29:43", "text": "它闪闪发光。我的天啊。看"}, {"type": "subtitle", "time": 23398.27, "timestamp": "06:29:58", "text": "没错，等等，你如何装备一个"}]
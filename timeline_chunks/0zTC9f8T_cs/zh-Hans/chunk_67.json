[{"type": "subtitle", "time": 4021.51, "timestamp": "01:07:01", "text": "男人。我可以切换到水模式吗？哦，我撞到了"}, {"type": "subtitle", "time": 4022.91, "timestamp": "01:07:02", "text": "飞机。它是"}, {"type": "subtitle", "time": 4025.75, "timestamp": "01:07:05", "text": "美好的。无损。哦，等等。确实如此"}, {"type": "subtitle", "time": 4028.47, "timestamp": "01:07:08", "text": "拥有无限的生命吗？"}, {"type": "subtitle", "time": 4038.87, "timestamp": "01:07:18", "text": "呃，等等，你在哪里？我找到了红色"}, {"type": "subtitle", "time": 4041.43, "timestamp": "01:07:21", "text": "海盗船。"}, {"type": "subtitle", "time": 4044.309, "timestamp": "01:07:24", "text": "等等，你……等等，你在哪里？呃，"}, {"type": "subtitle", "time": 4046.43, "timestamp": "01:07:26", "text": "你能看吗？"}, {"type": "subtitle", "time": 4049.43, "timestamp": "01:07:29", "text": "五点五十八分？一秒钟。对不起。让我"}, {"type": "subtitle", "time": 4054.75, "timestamp": "01:07:34", "text": "逐个红色地创建航点"}, {"type": "subtitle", "time": 4058.75, "timestamp": "01:07:38", "text": "船。我拿到卡了。"}, {"type": "subtitle", "time": 4062.15, "timestamp": "01:07:42", "text": "呃，这个地方"}, {"type": "subtitle", "time": 4065.91, "timestamp": "01:07:45", "text": "呃，在聊天中分享要点。哦，等等，它"}, {"type": "subtitle", "time": 4068.43, "timestamp": "01:07:48", "text": "不说"}, {"type": "subtitle", "time": 4071.91, "timestamp": "01:07:51", "text": "呃，595。"}, {"type": "subtitle", "time": 4073.99, "timestamp": "01:07:53", "text": "595."}, {"type": "subtitle", "time": 4076.63, "timestamp": "01:07:56", "text": "是的。"}]
[{"type": "subtitle", "time": 10501.309, "timestamp": "02:55:01", "text": "一。"}, {"type": "subtitle", "time": 10516.23, "timestamp": "02:55:16", "text": "我喜欢我们增加了这么多奖励。"}, {"type": "subtitle", "time": 10528.71, "timestamp": "02:55:28", "text": "但是，哦，是的。我想要那把小提琴。我"}, {"type": "subtitle", "time": 10531.87, "timestamp": "02:55:31", "text": "想学小提琴"}, {"type": "subtitle", "time": 10535.349, "timestamp": "02:55:35", "text": "一次。必须握住B。哦，你必须握住。"}, {"type": "subtitle", "time": 10539.349, "timestamp": "02:55:39", "text": "你知道吗，我看了一部动漫"}, {"type": "subtitle", "time": 10542.15, "timestamp": "02:55:42", "text": "女孩帝国，还有这个女孩"}, {"type": "subtitle", "time": 10546.55, "timestamp": "02:55:46", "text": "她名叫Sing，以前经常打球。"}]
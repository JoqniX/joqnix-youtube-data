[{"type": "subtitle", "time": 4688.47, "timestamp": "01:18:08", "text": "是的，现在就可以查看了。"}, {"type": "subtitle", "time": 4690.709, "timestamp": "01:18:10", "text": "你要独自前往。"}, {"type": "subtitle", "time": 4693.35, "timestamp": "01:18:13", "text": "为什么只有一个人？两人"}, {"type": "subtitle", "time": 4697.27, "timestamp": "01:18:17", "text": "他说点击右键。啊，就是你现在看的那个。"}, {"type": "subtitle", "time": 4700.39, "timestamp": "01:18:20", "text": "现在。这是两个人，就像一个人"}, {"type": "subtitle", "time": 4702.95, "timestamp": "01:18:22", "text": "人。那只是一个人的事。"}, {"type": "subtitle", "time": 4705.229, "timestamp": "01:18:25", "text": "这。啊，我明白了"}]
[{"type": "subtitle", "time": 9540.63, "timestamp": "02:39:00", "text": "打开箱子后，程序就崩溃了。"}, {"type": "subtitle", "time": 9543.19, "timestamp": "02:39:03", "text": "观点。"}, {"type": "subtitle", "time": 9545.11, "timestamp": "02:39:05", "text": "哦，是因为……等等，让我再说一遍"}, {"type": "subtitle", "time": 9548.23, "timestamp": "02:39:08", "text": "检查一下我安装了什么。"}, {"type": "subtitle", "time": 9551.11, "timestamp": "02:39:11", "text": "让我再看一下。是的，胸部是"}, {"type": "subtitle", "time": 9553.51, "timestamp": "02:39:13", "text": "把它搞崩溃。"}, {"type": "subtitle", "time": 9555.91, "timestamp": "02:39:15", "text": "真的吗？是的，我想我们需要移除"}, {"type": "subtitle", "time": 9558.15, "timestamp": "02:39:18", "text": "胸部。"}, {"type": "subtitle", "time": 9560.389, "timestamp": "02:39:20", "text": "不，等等。真的吗？等等，你……"}, {"type": "subtitle", "time": 9563.67, "timestamp": "02:39:23", "text": "查看？我做了。我做了。我又检查了一遍。"}, {"type": "subtitle", "time": 9567.51, "timestamp": "02:39:27", "text": "哦，胸部。我无法安装。我该怎么做？"}, {"type": "subtitle", "time": 9570.23, "timestamp": "02:39:30", "text": "我的模组里也需要移除它吗？"}, {"type": "subtitle", "time": 9572.71, "timestamp": "02:39:32", "text": "哦，不。不，没关系。我可以做到……呃"}, {"type": "subtitle", "time": 9574.95, "timestamp": "02:39:34", "text": "我可以重新加载。它将自动"}, {"type": "subtitle", "time": 9578.55, "timestamp": "02:39:38", "text": "登录后将其删除。"}, {"type": "subtitle", "time": 9581.55, "timestamp": "02:39:41", "text": "它应该做什么。让我再确认一下"}, {"type": "subtitle", "time": 9585.51, "timestamp": "02:39:45", "text": "那。是的。是的。随身携带。和"}, {"type": "subtitle", "time": 9587.91, "timestamp": "02:39:47", "text": "我完全不知道你们俩在说什么。"}, {"type": "subtitle", "time": 9590.309, "timestamp": "02:39:50", "text": "关于。"}, {"type": "subtitle", "time": 9592.55, "timestamp": "02:39:52", "text": "不用担心。"}, {"type": "subtitle", "time": 9595.71, "timestamp": "02:39:55", "text": "是的，就像布料一样。现在我可以"}, {"type": "subtitle", "time": 9599.309, "timestamp": "02:39:59", "text": "只需回收利用即可。"}]
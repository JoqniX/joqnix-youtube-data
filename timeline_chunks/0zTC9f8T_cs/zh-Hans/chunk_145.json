[{"type": "subtitle", "time": 8704.55, "timestamp": "02:25:04", "text": "放大。"}, {"type": "subtitle", "time": 8708.71, "timestamp": "02:25:08", "text": "为什么？等等，什么？你可以放大吗？是的。"}, {"type": "subtitle", "time": 8712.23, "timestamp": "02:25:12", "text": "哦，从电影的角度来看，我可以放大画面。我有一个"}, {"type": "subtitle", "time": 8713.71, "timestamp": "02:25:13", "text": "非常好"}, {"type": "subtitle", "time": 8718.309, "timestamp": "02:25:18", "text": "主意。如果我们举办一场音乐会呢？"}, {"type": "subtitle", "time": 8721.349, "timestamp": "02:25:21", "text": "我们运用了所有电影特效，而且我们"}, {"type": "subtitle", "time": 8730.95, "timestamp": "02:25:30", "text": "记录。好的，那太好了。"}, {"type": "subtitle", "time": 8733.429, "timestamp": "02:25:33", "text": "有人在吃它。"}, {"type": "subtitle", "time": 8735.429, "timestamp": "02:25:35", "text": "是的，这也是给你的。另外，请看我的"}, {"type": "subtitle", "time": 8738.51, "timestamp": "02:25:38", "text": "狗现在有尾巴了"}, {"type": "subtitle", "time": 8745.349, "timestamp": "02:25:45", "text": "该死。他们有哦，等等。狗没有"}, {"type": "subtitle", "time": 8747.99, "timestamp": "02:25:47", "text": "一直都有尾巴。他们有"}, {"type": "subtitle", "time": 8750.63, "timestamp": "02:25:50", "text": "尾巴，但是呃，它就像一个普通的平原。"}, {"type": "subtitle", "time": 8753.51, "timestamp": "02:25:53", "text": "尾巴，不是那种动画尾巴。好的。"}, {"type": "subtitle", "time": 8755.19, "timestamp": "02:25:55", "text": "坐姿也不同了。"}, {"type": "subtitle", "time": 8758.83, "timestamp": "02:25:58", "text": "现在它们坐姿像真狗一样。"}]
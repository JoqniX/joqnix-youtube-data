[{"type": "subtitle", "time": 24674.51, "timestamp": "06:51:14", "text": "这？我知道这一点"}, {"type": "subtitle", "time": 24682.31, "timestamp": "06:51:22", "text": "镜头。谈论卡车"}, {"type": "subtitle", "time": 24684.39, "timestamp": "06:51:24", "text": "connector，一个适用于 F forge 的 Minecraft 模组"}, {"type": "subtitle", "time": 24686.788, "timestamp": "06:51:26", "text": "这样你就可以在 Fabric 上运行 Mod 了。"}, {"type": "subtitle", "time": 24689.11, "timestamp": "06:51:29", "text": "Forge，本质上是连接两者的桥梁"}, {"type": "subtitle", "time": 24691.03, "timestamp": "06:51:31", "text": "这两个平台。现在，虽然"}, {"type": "subtitle", "time": 24693.03, "timestamp": "06:51:33", "text": "并不完美，也不是每块布料都完美。"}, {"type": "subtitle", "time": 24695.43, "timestamp": "06:51:35", "text": "mod 实际上可以在 Forge 上运行"}, {"type": "subtitle", "time": 24697.43, "timestamp": "06:51:37", "text": "辛尼特拉，它给我们带来了很大一部分"}, {"type": "subtitle", "time": 24699.03, "timestamp": "06:51:39", "text": "还在路上。例如，它允许你"}, {"type": "subtitle", "time": 24701.51, "timestamp": "06:51:41", "text": "在 Forge 上运行回放模组，允许"}, {"type": "subtitle", "time": 24703.67, "timestamp": "06:51:43", "text": "让你拍摄出精彩的画面"}, {"type": "subtitle", "time": 24706.548, "timestamp": "06:51:46", "text": "Forge 独家模组。太棒了。"}, {"type": "subtitle", "time": 24708.31, "timestamp": "06:51:48", "text": "但与此同时，它又不支持"}, {"type": "subtitle", "time": 24711.59, "timestamp": "06:51:51", "text": "一些迪尔德面料的粉丝"}, {"type": "subtitle", "time": 24713.91, "timestamp": "06:51:53", "text": "是的，我们会看看。"}, {"type": "subtitle", "time": 24716.868, "timestamp": "06:51:56", "text": "今天就去做。没错，我目前"}, {"type": "subtitle", "time": 24718.468, "timestamp": "06:51:58", "text": "正在运行安装程序。所以，没错。"}]
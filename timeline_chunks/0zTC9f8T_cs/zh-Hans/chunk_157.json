[{"type": "subtitle", "time": 9423.349, "timestamp": "02:37:03", "text": "等等，我还需要一件乐器。"}, {"type": "subtitle", "time": 9426.469, "timestamp": "02:37:06", "text": "你不会给你的。"}, {"type": "subtitle", "time": 9428.15, "timestamp": "02:37:08", "text": "什么？"}, {"type": "subtitle", "time": 9433.389, "timestamp": "02:37:13", "text": "呃，那"}, {"type": "subtitle", "time": 9439.83, "timestamp": "02:37:19", "text": "嗯"}, {"type": "subtitle", "time": 9443.91, "timestamp": "02:37:23", "text": "测试。是的。沉浸式机械装置等等"}, {"type": "subtitle", "time": 9447.83, "timestamp": "02:37:27", "text": "国际象棋的事。机器设备。"}, {"type": "subtitle", "time": 9459.51, "timestamp": "02:37:39", "text": "我的天啊。不好吗？"}, {"type": "subtitle", "time": 9463.99, "timestamp": "02:37:43", "text": "是的。等待。就差一点。"}, {"type": "subtitle", "time": 9467.19, "timestamp": "02:37:47", "text": "是的。服务器为什么关闭了？得到"}, {"type": "subtitle", "time": 9469.91, "timestamp": "02:37:49", "text": "已挖出。等等，什么？让我看看。服务器"}, {"type": "subtitle", "time": 9472.79, "timestamp": "02:37:52", "text": "对我来说已经关闭了。是的，它也踢了我。"}]
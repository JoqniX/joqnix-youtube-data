[{"type": "subtitle", "time": 22500.948, "timestamp": "06:15:00", "text": "一。只有 Forge 和 NeoForge。"}, {"type": "subtitle", "time": 22505.99, "timestamp": "06:15:05", "text": "有没有办法加入锻造模式？"}, {"type": "subtitle", "time": 22509.51, "timestamp": "06:15:09", "text": "一种布料？没有兼容类型"}, {"type": "subtitle", "time": 22515.83, "timestamp": "06:15:15", "text": "任何事物？就像这里面有一整套呃"}, {"type": "subtitle", "time": 22522.548, "timestamp": "06:15:22", "text": "尽管。这包含一个完整的系统。你可以"}, {"type": "subtitle", "time": 22526.868, "timestamp": "06:15:26", "text": "为其添加升级功能。加快速度"}, {"type": "subtitle", "time": 22530.628, "timestamp": "06:15:30", "text": "或者做点什么，或者让它像爆炸一样发挥作用"}, {"type": "subtitle", "time": 22531.788, "timestamp": "06:15:31", "text": "或者"}, {"type": "subtitle", "time": 22533.948, "timestamp": "06:15:33", "text": "任何。太多了"}, {"type": "subtitle", "time": 22536.31, "timestamp": "06:15:36", "text": "东西。我在看这个视频。我当时"}, {"type": "subtitle", "time": 22538.47, "timestamp": "06:15:38", "text": "就像，“我的天哪，这太糟糕了。”好的。"}, {"type": "subtitle", "time": 22541.23, "timestamp": "06:15:41", "text": "然后，我想要的另一个是"}, {"type": "subtitle", "time": 22545.59, "timestamp": "06:15:45", "text": "这。它有个类似速度控制的东西，还有燃料。"}, {"type": "subtitle", "time": 22548.83, "timestamp": "06:15:48", "text": "效率等等。你可以把它做成"}, {"type": "subtitle", "time": 22553.11, "timestamp": "06:15:53", "text": "工厂，你知道，有投入和"}, {"type": "subtitle", "time": 22555.03, "timestamp": "06:15:55", "text": "输出装置。"}]
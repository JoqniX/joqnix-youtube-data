[{"type": "subtitle", "time": 11341.75, "timestamp": "03:09:01", "text": "这个。铜扇。所以就像……"}, {"type": "subtitle", "time": 11345.429, "timestamp": "03:09:05", "text": "水下潜艇之类的东西。"}, {"type": "subtitle", "time": 11348.269, "timestamp": "03:09:08", "text": "等等，你造了一艘潜艇。"}, {"type": "subtitle", "time": 11351.19, "timestamp": "03:09:11", "text": "是的，导管"}, {"type": "subtitle", "time": 11353.11, "timestamp": "03:09:13", "text": "导管。"}, {"type": "subtitle", "time": 11360.71, "timestamp": "03:09:20", "text": "是的。哇。"}, {"type": "subtitle", "time": 11363.15, "timestamp": "03:09:23", "text": "好的。我很惊讶，实际上"}, {"type": "subtitle", "time": 11370.67, "timestamp": "03:09:30", "text": "加载。等等，我应该如何添加？"}, {"type": "subtitle", "time": 11372.87, "timestamp": "03:09:32", "text": "公寓？空间不足。不够"}, {"type": "subtitle", "time": 11375.75, "timestamp": "03:09:35", "text": "空间。哦，你只要把它种在地里就行了。"}, {"type": "subtitle", "time": 11378.389, "timestamp": "03:09:38", "text": "哦，我需要把它种在地里。"}, {"type": "subtitle", "time": 11381.19, "timestamp": "03:09:41", "text": "哦，不。我确实必须这么做。它是"}, {"type": "subtitle", "time": 11383.59, "timestamp": "03:09:43", "text": "确实不错。"}, {"type": "subtitle", "time": 11385.63, "timestamp": "03:09:45", "text": "哦，我的天"}, {"type": "subtitle", "time": 11388.71, "timestamp": "03:09:48", "text": "上帝。等等，我觉得我应该把它放上去。但"}, {"type": "subtitle", "time": 11390.95, "timestamp": "03:09:50", "text": "我应该如何下水？"}]
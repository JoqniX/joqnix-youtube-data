[{"type": "subtitle", "time": 3960.069, "timestamp": "01:06:00", "text": "呃，我不知道。让我过来。让我"}, {"type": "subtitle", "time": 3963.309, "timestamp": "01:06:03", "text": "弄架自己的飞机。等等，我会"}, {"type": "subtitle", "time": 3968.15, "timestamp": "01:06:08", "text": "来。我加了一些。这是唯一的吗？"}, {"type": "subtitle", "time": 3972.23, "timestamp": "01:06:12", "text": "这游戏里有飞机吗？不。还有更多吗？"}, {"type": "subtitle", "time": 3976.069, "timestamp": "01:06:16", "text": "飞机的类型？还有更多。"}, {"type": "subtitle", "time": 3978.95, "timestamp": "01:06:18", "text": "我知道海拔之类的因素不会显示出来。"}, {"type": "subtitle", "time": 3995.91, "timestamp": "01:06:35", "text": "哇。好的。燃油系统是否足够？"}, {"type": "subtitle", "time": 3999.43, "timestamp": "01:06:39", "text": "是的，你按 E 键。按 E 键。"}, {"type": "subtitle", "time": 4008.39, "timestamp": "01:06:48", "text": "哦，糟糕。这里有个武器栏位。升级"}, {"type": "subtitle", "time": 4012.15, "timestamp": "01:06:52", "text": "投币口。哦，助推火箭。我的天啊。"}]
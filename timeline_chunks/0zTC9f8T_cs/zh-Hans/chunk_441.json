[{"type": "subtitle", "time": 26470.39, "timestamp": "07:21:10", "text": "疼痛难忍，我不知道该说什么。我"}, {"type": "subtitle", "time": 26477.35, "timestamp": "07:21:17", "text": "说。我的天啊。好的，罗坎是"}, {"type": "subtitle", "time": 26479.59, "timestamp": "07:21:19", "text": "流媒体。链接在里面吗？"}, {"type": "subtitle", "time": 26481.35, "timestamp": "07:21:21", "text": "描述。"}, {"type": "subtitle", "time": 26499.31, "timestamp": "07:21:39", "text": "呃，一旦我打开它，我就会打开它。"}, {"type": "subtitle", "time": 26501.548, "timestamp": "07:21:41", "text": "敲"}, {"type": "subtitle", "time": 26505.31, "timestamp": "07:21:45", "text": "你的东西，呃，你"}, {"type": "subtitle", "time": 26516.75, "timestamp": "07:21:56", "text": "好的。我觉得他不知道这件事。"}]
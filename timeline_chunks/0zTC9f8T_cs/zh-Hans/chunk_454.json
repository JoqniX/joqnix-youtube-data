[{"type": "subtitle", "time": 27244.19, "timestamp": "07:34:04", "text": "伙计们。我来了。我能被看到吗？是的，你是"}, {"type": "subtitle", "time": 27245.788, "timestamp": "07:34:05", "text": "可见的。"}, {"type": "subtitle", "time": 27258.75, "timestamp": "07:34:18", "text": "来了。"}, {"type": "subtitle", "time": 27263.11, "timestamp": "07:34:23", "text": "好的。为什么？我知道，对吧？是的，就是这样。"}, {"type": "subtitle", "time": 27265.83, "timestamp": "07:34:25", "text": "因为我们正在进行试验"}, {"type": "subtitle", "time": 27270.07, "timestamp": "07:34:30", "text": "就是那个分享聊天的东西。"}, {"type": "subtitle", "time": 27272.07, "timestamp": "07:34:32", "text": "等等，你两个聊天室里都有你吗？"}, {"type": "subtitle", "time": 27273.43, "timestamp": "07:34:33", "text": "两端都有很大的可能"}, {"type": "subtitle", "time": 27275.75, "timestamp": "07:34:35", "text": "图表。布雷特，我想布雷特和皮克"}, {"type": "subtitle", "time": 27278.948, "timestamp": "07:34:38", "text": "在我们的两张图表中都有。一切都已就绪"}, {"type": "subtitle", "time": 27281.67, "timestamp": "07:34:41", "text": "一。就像两者融合在了一起。"}, {"type": "subtitle", "time": 27285.19, "timestamp": "07:34:45", "text": "是的。是的。这样更好。这样做更好"}, {"type": "subtitle", "time": 27287.67, "timestamp": "07:34:47", "text": "你们注意了。是的。真是太"}, {"type": "subtitle", "time": 27289.99, "timestamp": "07:34:49", "text": "现在好了。"}, {"type": "subtitle", "time": 27292.31, "timestamp": "07:34:52", "text": "你们也可以互相交谈。打个招呼"}, {"type": "subtitle", "time": 27298.628, "timestamp": "07:34:58", "text": "是的，你们可以互相打招呼。"}]
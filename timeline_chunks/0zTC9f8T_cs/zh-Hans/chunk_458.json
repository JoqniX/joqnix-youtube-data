[{"type": "subtitle", "time": 27480.468, "timestamp": "07:38:00", "text": "哦，耶稣，你今天过得很艰难吧。"}, {"type": "subtitle", "time": 27484.15, "timestamp": "07:38:04", "text": "兄弟。是的，"}, {"type": "subtitle", "time": 27486.31, "timestamp": "07:38:06", "text": "在此之前，你可以先通过聊天功能聊聊。"}, {"type": "subtitle", "time": 27489.19, "timestamp": "07:38:09", "text": "我猜也是。我演奏的时候，你打个招呼。"}, {"type": "subtitle", "time": 27492.548, "timestamp": "07:38:12", "text": "您好，欢迎光临。"}, {"type": "subtitle", "time": 27494.15, "timestamp": "07:38:14", "text": "我的意思是，要么把你的商场规模缩小，要么"}, {"type": "subtitle", "time": 27497.51, "timestamp": "07:38:17", "text": "让运动型男更强壮。"}, {"type": "subtitle", "time": 27499.35, "timestamp": "07:38:19", "text": "嗯，其实我会做的。等等，我会"}, {"type": "subtitle", "time": 27504.548, "timestamp": "07:38:24", "text": "付诸行动。请稍等片刻。观察。"}, {"type": "subtitle", "time": 27509.03, "timestamp": "07:38:29", "text": "在此之前，我会把链接发给你。"}, {"type": "subtitle", "time": 27510.468, "timestamp": "07:38:30", "text": "看起来像吗？嗯，不像吗？"}, {"type": "subtitle", "time": 27511.67, "timestamp": "07:38:31", "text": "就像我们在接吻之类的"}, {"type": "subtitle", "time": 27519.91, "timestamp": "07:38:39", "text": "同性恋。呃，这有点同性恋的意味。"}, {"type": "subtitle", "time": 27522.548, "timestamp": "07:38:42", "text": "好了。这"}, {"type": "subtitle", "time": 27525.548, "timestamp": "07:38:45", "text": "反应性"}, {"type": "subtitle", "time": 27528.788, "timestamp": "07:38:48", "text": "如果可以的话，游戏结束后就换个东西。"}]
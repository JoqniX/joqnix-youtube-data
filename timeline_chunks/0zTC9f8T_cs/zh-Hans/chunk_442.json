[{"type": "subtitle", "time": 26520.23, "timestamp": "07:22:00", "text": "那。我想看看Twitch怎么样"}, {"type": "subtitle", "time": 26523.948, "timestamp": "07:22:03", "text": "好吧，他变了。我会尽力"}, {"type": "subtitle", "time": 26553.15, "timestamp": "07:22:33", "text": "哦，我的天"}, {"type": "subtitle", "time": 26557.27, "timestamp": "07:22:37", "text": "上帝。他得等着叫到自己的号码才能去做。"}, {"type": "subtitle", "time": 26561.628, "timestamp": "07:22:41", "text": "这。哦，不。没关系。让我突然出现"}]
[{"type": "subtitle", "time": 25461.15, "timestamp": "07:04:21", "text": "它。啊，给笨蛋做饭的冰箱"}, {"type": "subtitle", "time": 25476.708, "timestamp": "07:04:36", "text": "“哦，伙计，我们可以做点什么，然后捐赠。”"}, {"type": "subtitle", "time": 25478.35, "timestamp": "07:04:38", "text": "把它给每个人"}, {"type": "subtitle", "time": 25485.83, "timestamp": "07:04:45", "text": "真有趣。”我看到了烹饪用品，或者你可以"}, {"type": "subtitle", "time": 25488.67, "timestamp": "07:04:48", "text": "放在鸡肉厨房台面上或"}, {"type": "subtitle", "time": 25490.948, "timestamp": "07:04:50", "text": "某物。想象一下，那将是你的"}, {"type": "subtitle", "time": 25493.83, "timestamp": "07:04:53", "text": "自有住房。"}, {"type": "subtitle", "time": 25496.708, "timestamp": "07:04:56", "text": "你有一座桥。你热情地欢迎人们进来"}, {"type": "subtitle", "time": 25499.83, "timestamp": "07:04:59", "text": "你的房子。进来吧。你想喝奶茶吗？患病的"}]
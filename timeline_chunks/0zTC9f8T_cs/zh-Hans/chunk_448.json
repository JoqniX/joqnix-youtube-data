[{"type": "subtitle", "time": 26889.75, "timestamp": "07:28:09", "text": "这。好的。哦，直接在聊天框里输入就行了。我"}, {"type": "subtitle", "time": 26892.23, "timestamp": "07:28:12", "text": "我觉得你可以把它钉住。"}, {"type": "subtitle", "time": 26894.388, "timestamp": "07:28:14", "text": "我把它置顶。"}, {"type": "subtitle", "time": 26897.23, "timestamp": "07:28:17", "text": "我如何渲染"}, {"type": "subtitle", "time": 26899.75, "timestamp": "07:28:19", "text": "他？好的，"}, {"type": "subtitle", "time": 26902.07, "timestamp": "07:28:22", "text": "我必须写“启用投放”。我不"}, {"type": "subtitle", "time": 26903.948, "timestamp": "07:28:23", "text": "知道。滴"}, {"type": "subtitle", "time": 26907.83, "timestamp": "07:28:27", "text": "已启用？滴。顺便说一句，它是滴剂。"}, {"type": "subtitle", "time": 26909.67, "timestamp": "07:28:29", "text": "哦，"}, {"type": "subtitle", "time": 26911.83, "timestamp": "07:28:31", "text": "我想我得写下来。我认为"}, {"type": "subtitle", "time": 26919.91, "timestamp": "07:28:39", "text": "是一种冰淇淋。这是免费的冰块"}, {"type": "subtitle", "time": 26923.03, "timestamp": "07:28:43", "text": "顺便提一下，是奶油。"}, {"type": "subtitle", "time": 26924.388, "timestamp": "07:28:44", "text": "对了，你扮演的是哪个角色？"}, {"type": "subtitle", "time": 26929.03, "timestamp": "07:28:49", "text": "是指现在吗？拉屎。他妈的。"}, {"type": "subtitle", "time": 26930.868, "timestamp": "07:28:50", "text": "字符含义？我不知道。我"}, {"type": "subtitle", "time": 26932.788, "timestamp": "07:28:52", "text": "还没决定。我甚至还没玩过呢。"}, {"type": "subtitle", "time": 26935.51, "timestamp": "07:28:55", "text": "它。我只玩了教程部分。玩"}, {"type": "subtitle", "time": 26938.548, "timestamp": "07:28:58", "text": "杰夫。我猜你得扮演杰夫或者其他什么烦人的角色。"}]
[{"type": "subtitle", "time": 27000.468, "timestamp": "07:30:00", "text": "说什么好呢？我不知道该说什么。我"}, {"type": "subtitle", "time": 27003.788, "timestamp": "07:30:03", "text": "我不知道，我真的不知道。好的。"}, {"type": "subtitle", "time": 27007.43, "timestamp": "07:30:07", "text": "52% 的进度即将完成。"}, {"type": "subtitle", "time": 27009.59, "timestamp": "07:30:09", "text": "我觉得我得降低直播音量了。我的"}, {"type": "subtitle", "time": 27013.35, "timestamp": "07:30:13", "text": "就像它显示你可以优化"}, {"type": "subtitle", "time": 27014.788, "timestamp": "07:30:14", "text": "设置就像你可以玩游戏一样。"}, {"type": "subtitle", "time": 27017.35, "timestamp": "07:30:17", "text": "高，但如果你直播的话，我觉得低。"}, {"type": "subtitle", "time": 27022.31, "timestamp": "07:30:22", "text": "似乎需要10GB显存。什么？"}, {"type": "subtitle", "time": 27024.788, "timestamp": "07:30:24", "text": "我不"}, {"type": "subtitle", "time": 27030.07, "timestamp": "07:30:30", "text": "我觉得我得出去。该死。"}, {"type": "subtitle", "time": 27032.07, "timestamp": "07:30:32", "text": "连我都担心这个笑话会"}, {"type": "subtitle", "time": 27037.31, "timestamp": "07:30:37", "text": "顺便问一下，你在直播吗？"}, {"type": "subtitle", "time": 27040.868, "timestamp": "07:30:40", "text": "在 YouTube 上？我在YouTube上看不到你。"}, {"type": "subtitle", "time": 27043.51, "timestamp": "07:30:43", "text": "我正在YouTube上直播。不，不是这样的。"}, {"type": "subtitle", "time": 27045.35, "timestamp": "07:30:45", "text": "流媒体。"}, {"type": "subtitle", "time": 27048.468, "timestamp": "07:30:48", "text": "但他们确实是。不，没显示。"}, {"type": "subtitle", "time": 27050.75, "timestamp": "07:30:50", "text": "对我来说，YouTube 是首选。"}, {"type": "subtitle", "time": 27054.948, "timestamp": "07:30:54", "text": "什么？它应该会显示出来。"}]
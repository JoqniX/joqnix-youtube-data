[{"type": "subtitle", "time": 26701.27, "timestamp": "07:25:01", "text": "什么？什么？不。我的天哪。"}, {"type": "subtitle", "time": 26705.11, "timestamp": "07:25:05", "text": "我不知道。"}, {"type": "subtitle", "time": 26709.11, "timestamp": "07:25:09", "text": "我验证过游戏，它是……"}, {"type": "subtitle", "time": 26717.75, "timestamp": "07:25:17", "text": "我无话可说。没关系。我会看"}, {"type": "subtitle", "time": 26723.27, "timestamp": "07:25:23", "text": "你来玩。这他妈到底是什么意思？"}, {"type": "subtitle", "time": 26726.628, "timestamp": "07:25:26", "text": "停止。别再说这种话了。该死的。哦"}, {"type": "subtitle", "time": 26728.83, "timestamp": "07:25:28", "text": "我的"}, {"type": "subtitle", "time": 26733.51, "timestamp": "07:25:33", "text": "上帝。啊，这个呃"}, {"type": "subtitle", "time": 26735.27, "timestamp": "07:25:35", "text": "我不知道。我不知道该说什么。"}, {"type": "subtitle", "time": 26737.91, "timestamp": "07:25:37", "text": "我无话可说。"}, {"type": "subtitle", "time": 26745.83, "timestamp": "07:25:45", "text": "球坏了。现在这个人，"}, {"type": "subtitle", "time": 26749.27, "timestamp": "07:25:49", "text": "他确实很努力想打好比赛。我"}]
[{"type": "subtitle", "time": 25502.628, "timestamp": "07:05:02", "text": "给你做杯奶茶。你想吃苹果派吗？患病的"}, {"type": "subtitle", "time": 25504.19, "timestamp": "07:05:04", "text": "做个苹果"}, {"type": "subtitle", "time": 25506.59, "timestamp": "07:05:06", "text": "馅饼。哦，我的天"}, {"type": "subtitle", "time": 25510.11, "timestamp": "07:05:10", "text": "上帝。我当时就想，有趣的是……"}, {"type": "subtitle", "time": 25514.11, "timestamp": "07:05:14", "text": "这头牛在"}, {"type": "subtitle", "time": 25517.91, "timestamp": "07:05:17", "text": "罐。他们把一头牛放进了罐子里。那太过了。"}, {"type": "subtitle", "time": 25521.83, "timestamp": "07:05:21", "text": "那是一台烤面包机。哦"}, {"type": "subtitle", "time": 25524.59, "timestamp": "07:05:24", "text": "我的天，这里有个烤面包机"}, {"type": "subtitle", "time": 25528.91, "timestamp": "07:05:28", "text": "面包。是的，我可以吃"}, {"type": "subtitle", "time": 25537.51, "timestamp": "07:05:37", "text": "是的，我们可以弄块香料抹布。我们可以"}, {"type": "subtitle", "time": 25552.03, "timestamp": "07:05:52", "text": "好的。"}, {"type": "subtitle", "time": 25556.19, "timestamp": "07:05:56", "text": "该死。我看到了。我当时就想，"}]
[{"type": "subtitle", "time": 21360.51, "timestamp": "05:56:00", "text": "现在。所以，就像……你可以"}, {"type": "subtitle", "time": 21364.35, "timestamp": "05:56:04", "text": "一个容器中可容纳多个捆绑包"}, {"type": "subtitle", "time": 21367.19, "timestamp": "05:56:07", "text": "捆。你可以拥有全栈式"}, {"type": "subtitle", "time": 21375.47, "timestamp": "05:56:15", "text": "你怎么认为"}, {"type": "subtitle", "time": 21379.948, "timestamp": "05:56:19", "text": "D？嗯，问题是……1.12……"}, {"type": "subtitle", "time": 21381.628, "timestamp": "05:56:21", "text": "1"}, {"type": "subtitle", "time": 21385.51, "timestamp": "05:56:25", "text": "21.2 版本提供了捆绑包选项，如果您"}, {"type": "subtitle", "time": 21388.15, "timestamp": "05:56:28", "text": "右键单击，所有项目都将显示"}, {"type": "subtitle", "time": 21396.788, "timestamp": "05:56:36", "text": "1.21，那里没有。但"}, {"type": "subtitle", "time": 21399.27, "timestamp": "05:56:39", "text": "还行吧。我觉得没问题。"}, {"type": "subtitle", "time": 21403.31, "timestamp": "05:56:43", "text": "现在。存储方面，我们没问题。"}, {"type": "subtitle", "time": 21406.15, "timestamp": "05:56:46", "text": "嗯，就存储空间而言，我们没问题。我当时"}, {"type": "subtitle", "time": 21407.548, "timestamp": "05:56:47", "text": "想要制作"}, {"type": "subtitle", "time": 21412.83, "timestamp": "05:56:52", "text": "它更容易用于冶炼等工艺。"}, {"type": "subtitle", "time": 21415.67, "timestamp": "05:56:55", "text": "东西。是的，其他的事情都是"}, {"type": "subtitle", "time": 21417.23, "timestamp": "05:56:57", "text": "好的，我"}]
[{"type": "subtitle", "time": 4140.11, "timestamp": "01:09:00", "text": "听？是的，它正在运行。我"}, {"type": "subtitle", "time": 4143.309, "timestamp": "01:09:03", "text": "我想你知道，如果你只是漂浮一段时间的话"}, {"type": "subtitle", "time": 4145.349, "timestamp": "01:09:05", "text": "其次，你的引擎会停止运转。"}, {"type": "subtitle", "time": 4147.269, "timestamp": "01:09:07", "text": "自动地。我猜它在保护区内。"}, {"type": "subtitle", "time": 4149.47, "timestamp": "01:09:09", "text": "或者"}, {"type": "subtitle", "time": 4152.269, "timestamp": "01:09:12", "text": "某物。我们几乎"}, {"type": "subtitle", "time": 4156.149, "timestamp": "01:09:16", "text": "崩溃了。该死。"}]
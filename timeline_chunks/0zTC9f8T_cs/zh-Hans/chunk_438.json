[{"type": "subtitle", "time": 26282.99, "timestamp": "07:18:02", "text": "嗯，他不能和我一起玩，因为我不是"}, {"type": "subtitle", "time": 26287.03, "timestamp": "07:18:07", "text": "游侠。所以，因为所有这些事情，"}, {"type": "subtitle", "time": 26289.99, "timestamp": "07:18:09", "text": "我决定我们要开始刷瓦莱林了。"}, {"type": "subtitle", "time": 26294.868, "timestamp": "07:18:14", "text": "以后有机会再直播吧。呃，有时候"}, {"type": "subtitle", "time": 26298.35, "timestamp": "07:18:18", "text": "嗯，以后吧，不是今天，而是将来某一天。"}, {"type": "subtitle", "time": 26301.548, "timestamp": "07:18:21", "text": "之后。所以，今天我们要玩的是马罗"}, {"type": "subtitle", "time": 26304.59, "timestamp": "07:18:24", "text": "劲敌不断厮杀。我们会努力的。"}, {"type": "subtitle", "time": 26308.708, "timestamp": "07:18:28", "text": "嗯，我们会和 Rokuin 一起进行排位赛。"}, {"type": "subtitle", "time": 26310.75, "timestamp": "07:18:30", "text": "是的。希望一切顺利。希望你"}, {"type": "subtitle", "time": 26316.868, "timestamp": "07:18:36", "text": "享受今天吧。呃，Roachan还没有直播。"}, {"type": "subtitle", "time": 26319.83, "timestamp": "07:18:39", "text": "不过，我想也是。"}, {"type": "subtitle", "time": 26323.19, "timestamp": "07:18:43", "text": "呃，等等，等等，等等，等等，等等。让我"}, {"type": "subtitle", "time": 26330.39, "timestamp": "07:18:50", "text": "呃，我需要问问他。等等，他正在准备"}, {"type": "subtitle", "time": 26332.708, "timestamp": "07:18:52", "text": "为了他的直播。可能是在直播。呃，"}, {"type": "subtitle", "time": 26338.59, "timestamp": "07:18:58", "text": "流媒体？"}]
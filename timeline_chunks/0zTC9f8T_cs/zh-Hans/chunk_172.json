[{"type": "subtitle", "time": 10335.429, "timestamp": "02:52:15", "text": "老兄，我饿了。"}, {"type": "subtitle", "time": 10345.429, "timestamp": "02:52:25", "text": "阿斯特拉，你什么时候吃饭的？我没做对"}, {"type": "subtitle", "time": 10349.83, "timestamp": "02:52:29", "text": "现在。如何？等等，但是如果你在……吃饭"}, {"type": "subtitle", "time": 10351.91, "timestamp": "02:52:31", "text": "时机不对，你明白吗？"}, {"type": "subtitle", "time": 10354.55, "timestamp": "02:52:34", "text": "阑尾或附录或其他什么名字"}, {"type": "subtitle", "time": 10356.389, "timestamp": "02:52:36", "text": "问题是？"}, {"type": "subtitle", "time": 10360.15, "timestamp": "02:52:40", "text": "还有胃病之类的各种问题。"}, {"type": "subtitle", "time": 10362.23, "timestamp": "02:52:42", "text": "难道不好吗？"}, {"type": "subtitle", "time": 10364.79, "timestamp": "02:52:44", "text": "我正在节食，每天摄入近1500卡路里。"}, {"type": "subtitle", "time": 10369.309, "timestamp": "02:52:49", "text": "一天下来，我的卡路里应该几乎是"}, {"type": "subtitle", "time": 10371.75, "timestamp": "02:52:51", "text": "2500。我应该吃那么多，但我吃不下。"}]
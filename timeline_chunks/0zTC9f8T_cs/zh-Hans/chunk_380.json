[{"type": "subtitle", "time": 22801.99, "timestamp": "06:20:01", "text": "熔炉。看？看？看？如果我放更多"}, {"type": "subtitle", "time": 22809.15, "timestamp": "06:20:09", "text": "熔炉，也许我会写上“像”"}, {"type": "subtitle", "time": 22818.99, "timestamp": "06:20:18", "text": "嗯，我觉得方向是……"}, {"type": "subtitle", "time": 22828.868, "timestamp": "06:20:28", "text": "帮助。兄弟，为什么它不发热？"}, {"type": "subtitle", "time": 22830.59, "timestamp": "06:20:30", "text": "你应该发送"}, {"type": "subtitle", "time": 22834.35, "timestamp": "06:20:34", "text": "热。你也在骗我吗？哦，我的天"}, {"type": "subtitle", "time": 22836.99, "timestamp": "06:20:36", "text": "上帝。不，它的作用是散发热量。"}, {"type": "subtitle", "time": 22840.07, "timestamp": "06:20:40", "text": "等等，等等。它应该把我送走"}, {"type": "chat", "time": 22844.855, "timestamp": "06:20:44", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "Uk what I might join in like and hour"}, {"type": "subtitle", "time": 22848.788, "timestamp": "06:20:48", "text": "去。好的，它没亮，但我会把它放上去"}]
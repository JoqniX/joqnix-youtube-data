[{"type": "subtitle", "time": 9304.309, "timestamp": "02:35:04", "text": "晚安各位。晚安，各位。再见。"}, {"type": "subtitle", "time": 9311.07, "timestamp": "02:35:11", "text": "他们将彻夜难眠。给我打电话就好"}, {"type": "subtitle", "time": 9313.91, "timestamp": "02:35:13", "text": "塔。我会尽量记住这一点。"}, {"type": "subtitle", "time": 9316.469, "timestamp": "02:35:16", "text": "你回来了，"}, {"type": "subtitle", "time": 9319.19, "timestamp": "02:35:19", "text": "他们不睡觉。夜晚。"}, {"type": "subtitle", "time": 9321.99, "timestamp": "02:35:21", "text": "好的。那么，你添加了什么？"}, {"type": "subtitle", "time": 9324.309, "timestamp": "02:35:24", "text": "我添加了什么？等等，我到底添加了什么来着？"}, {"type": "subtitle", "time": 9328.23, "timestamp": "02:35:28", "text": "旅行。那是什么？ A B."}, {"type": "chat", "time": 9330.621, "timestamp": "02:35:30", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "i will sleep shio worry about yourself"}, {"type": "subtitle", "time": 9333.99, "timestamp": "02:35:33", "text": "A B. 哦，那是那个……音乐家之类的东西。"}, {"type": "subtitle", "time": 9335.79, "timestamp": "02:35:35", "text": "音乐"}, {"type": "chat", "time": 9337.861, "timestamp": "02:35:37", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "Bye guys"}, {"type": "subtitle", "time": 9341.23, "timestamp": "02:35:41", "text": "项目。我相信它应该是"}, {"type": "subtitle", "time": 9344.59, "timestamp": "02:35:44", "text": "是的，在创意领域，确实存在这种情况。"}]
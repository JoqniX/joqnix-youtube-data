[{"type": "subtitle", "time": 27300.548, "timestamp": "07:35:00", "text": "是的，你们可以互相打招呼，或者"}, {"type": "subtitle", "time": 27302.948, "timestamp": "07:35:02", "text": "彼此憎恨。别那样做。"}, {"type": "subtitle", "time": 27309.67, "timestamp": "07:35:09", "text": "我要去追那个钢铁侠。"}, {"type": "subtitle", "time": 27311.75, "timestamp": "07:35:11", "text": "你这个婊子养的混蛋。"}, {"type": "subtitle", "time": 27315.03, "timestamp": "07:35:15", "text": "哦，我的视频流正在缓冲。"}, {"type": "subtitle", "time": 27317.788, "timestamp": "07:35:17", "text": "我不播放音频的原因是"}, {"type": "subtitle", "time": 27321.19, "timestamp": "07:35:21", "text": "来自钢铁侠是因为我的音频"}, {"type": "subtitle", "time": 27322.59, "timestamp": "07:35:22", "text": "音频是"}, {"type": "subtitle", "time": 27325.11, "timestamp": "07:35:25", "text": "翻倍。哦，等等。或许我可以静音"}, {"type": "subtitle", "time": 27327.27, "timestamp": "07:35:27", "text": "我自己直播时关掉了音频。"}, {"type": "subtitle", "time": 27329.03, "timestamp": "07:35:29", "text": "别担心，别担心。他们想要"}, {"type": "subtitle", "time": 27331.51, "timestamp": "07:35:31", "text": "我也听到了。"}, {"type": "subtitle", "time": 27342.15, "timestamp": "07:35:42", "text": "游戏。为什么会出现延迟？让我换"}, {"type": "subtitle", "time": 27346.23, "timestamp": "07:35:46", "text": "解决方案。双杀。"}, {"type": "subtitle", "time": 27351.99, "timestamp": "07:35:51", "text": "呃，跳一段啦啦队舞蹈或者……"}]
[{"type": "subtitle", "time": 4803.31, "timestamp": "01:20:03", "text": "哦，那里有一把重型弩。"}, {"type": "subtitle", "time": 4806.229, "timestamp": "01:20:06", "text": "东西。罗氏飞机。哦，是的。她"}, {"type": "subtitle", "time": 4808.63, "timestamp": "01:20:08", "text": "已经添加了火箭助推器，所以你可以"}, {"type": "subtitle", "time": 4811.59, "timestamp": "01:20:11", "text": "同时提升性能。她甚至不知道该怎么做"}, {"type": "subtitle", "time": 4814.39, "timestamp": "01:20:14", "text": "启动引擎。她正要离开"}, {"type": "subtitle", "time": 4818.39, "timestamp": "01:20:18", "text": "我的天啊。呃，我知道怎么做。"}, {"type": "subtitle", "time": 4837.99, "timestamp": "01:20:37", "text": "哦，哇。我，我走了，好的，我走了"}, {"type": "subtitle", "time": 4839.27, "timestamp": "01:20:39", "text": "我要崩溃了。好的，我要走了"}, {"type": "subtitle", "time": 4845.83, "timestamp": "01:20:45", "text": "没关系。"}, {"type": "subtitle", "time": 4852.79, "timestamp": "01:20:52", "text": "她快要崩溃了。她正在飞行"}]
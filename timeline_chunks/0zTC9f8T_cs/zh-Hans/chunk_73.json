[{"type": "subtitle", "time": 4392.63, "timestamp": "01:13:12", "text": "好的。呃，我错过了什么？你好。"}, {"type": "subtitle", "time": 4395.83, "timestamp": "01:13:15", "text": "啊，我明白了。我看到了。它迫降了。"}, {"type": "subtitle", "time": 4398.55, "timestamp": "01:13:18", "text": "这边。"}, {"type": "subtitle", "time": 4401.59, "timestamp": "01:13:21", "text": "等等，我这就下来。"}, {"type": "subtitle", "time": 4408.709, "timestamp": "01:13:28", "text": "它显示检测到不兼容的情况。"}, {"type": "subtitle", "time": 4423.189, "timestamp": "01:13:43", "text": "你在水下吗？是的。嗯，我是"}, {"type": "subtitle", "time": 4427.27, "timestamp": "01:13:47", "text": "悬停在你上方。好吧，我还活着。"}, {"type": "subtitle", "time": 4428.87, "timestamp": "01:13:48", "text": "垂死。"}, {"type": "subtitle", "time": 4435.189, "timestamp": "01:13:55", "text": "地图上那是海豚吗？好的，就是这样。"}, {"type": "subtitle", "time": 4437.75, "timestamp": "01:13:57", "text": "地图上的一只海豚。"}, {"type": "subtitle", "time": 4439.63, "timestamp": "01:13:59", "text": "好吧，我就吃我的"}]
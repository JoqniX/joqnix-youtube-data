[{"type": "subtitle", "time": 4922.149, "timestamp": "01:22:02", "text": "她必须去救她。"}, {"type": "subtitle", "time": 4934.47, "timestamp": "01:22:14", "text": "佳能是如何运作的？"}, {"type": "subtitle", "time": 4936.39, "timestamp": "01:22:16", "text": "哦，等等。你想知道正典是如何规定的"}, {"type": "subtitle", "time": 4938.31, "timestamp": "01:22:18", "text": "工作？等待。"}, {"type": "subtitle", "time": 4943.87, "timestamp": "01:22:23", "text": "所以，升级就像是螺旋桨的问题一样。"}, {"type": "subtitle", "time": 4946.229, "timestamp": "01:22:26", "text": "升级？等待。"}, {"type": "subtitle", "time": 4957.83, "timestamp": "01:22:37", "text": "升级。它就像一门自动加农炮。它"}, {"type": "subtitle", "time": 4961.229, "timestamp": "01:22:41", "text": "它会跟随你。我的天啊。稳定性、风力、"}]
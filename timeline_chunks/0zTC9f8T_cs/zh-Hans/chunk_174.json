[{"type": "subtitle", "time": 10448.83, "timestamp": "02:54:08", "text": "不，不。你在哪里？我会给你一个"}, {"type": "subtitle", "time": 10452.95, "timestamp": "02:54:12", "text": "钢琴。等等，你想要一把吉他？"}, {"type": "subtitle", "time": 10454.63, "timestamp": "02:54:14", "text": "是的，"}, {"type": "subtitle", "time": 10457.91, "timestamp": "02:54:17", "text": "吉他。等待。呃，我想应该是等等，"}, {"type": "subtitle", "time": 10461.23, "timestamp": "02:54:21", "text": "哪个是吉他？小提琴，"}, {"type": "subtitle", "time": 10464.87, "timestamp": "02:54:24", "text": "尤克里里，钟琴。你有一把尤克里里。是的。"}, {"type": "subtitle", "time": 10466.469, "timestamp": "02:54:26", "text": "你想要那个吗？好的，我给你。"}, {"type": "subtitle", "time": 10469.75, "timestamp": "02:54:29", "text": "你在哪里？到跑道上来。我"}, {"type": "subtitle", "time": 10472.389, "timestamp": "02:54:32", "text": "我会留着它。"}, {"type": "subtitle", "time": 10474.95, "timestamp": "02:54:34", "text": "我在农场。"}, {"type": "subtitle", "time": 10478.23, "timestamp": "02:54:38", "text": "我在给你们做饭。"}, {"type": "subtitle", "time": 10484.83, "timestamp": "02:54:44", "text": "遗物，用于获取遗物和"}, {"type": "subtitle", "time": 10499.99, "timestamp": "02:54:59", "text": "我会把你的工作发给你。只需添加这件遗物即可"}]
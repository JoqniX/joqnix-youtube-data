[{"type": "subtitle", "time": 10628.79, "timestamp": "02:57:08", "text": "哦，你一定要来参加跑步比赛。患病的"}, {"type": "subtitle", "time": 10631.51, "timestamp": "02:57:11", "text": "来。我会给你"}, {"type": "subtitle", "time": 10641.03, "timestamp": "02:57:21", "text": "我在基地。"}, {"type": "subtitle", "time": 10644.309, "timestamp": "02:57:24", "text": "我向你身后看去。哦，是的。这边。"}, {"type": "subtitle", "time": 10647.55, "timestamp": "02:57:27", "text": "我会给你"}, {"type": "subtitle", "time": 10653.03, "timestamp": "02:57:33", "text": "尤克里里。好了。哇。好的。什么？"}, {"type": "subtitle", "time": 10656.79, "timestamp": "02:57:36", "text": "如果你愿意的话，这里还有一个说谎者。"}, {"type": "subtitle", "time": 10660.19, "timestamp": "02:57:40", "text": "不。你怎么做？等等，别点开。"}, {"type": "subtitle", "time": 10663.03, "timestamp": "02:57:43", "text": "优势。而乐器是一种"}, {"type": "subtitle", "time": 10667.99, "timestamp": "02:57:47", "text": "非官方的，而且是粉丝作品，绝非官方的"}, {"type": "subtitle", "time": 10675.23, "timestamp": "02:57:55", "text": "哦"}, {"type": "subtitle", "time": 10679.87, "timestamp": "02:57:59", "text": "不，有哦，我做了"}]
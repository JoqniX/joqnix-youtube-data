[{"type": "subtitle", "time": 26225.868, "timestamp": "07:17:05", "text": "啊，大家好"}, {"type": "subtitle", "time": 26228.67, "timestamp": "07:17:08", "text": "再次。你好。"}, {"type": "subtitle", "time": 26231.91, "timestamp": "07:17:11", "text": "呃，我的模型怎么了？在那里"}, {"type": "subtitle", "time": 26233.708, "timestamp": "07:17:13", "text": "去。你好"}, {"type": "subtitle", "time": 26236.43, "timestamp": "07:17:16", "text": "再次。"}, {"type": "subtitle", "time": 26246.628, "timestamp": "07:17:26", "text": "嗯，我们搞砸了。嗯，是的。呃，我们当时"}, {"type": "subtitle", "time": 26249.27, "timestamp": "07:17:29", "text": "我们本该玩耍的"}, {"type": "subtitle", "time": 26255.03, "timestamp": "07:17:35", "text": "播放一秒钟。呃"}, {"type": "subtitle", "time": 26257.99, "timestamp": "07:17:37", "text": "呃，我们本来应该玩《星际特工：千星之城》的，但是……"}, {"type": "subtitle", "time": 26260.15, "timestamp": "07:17:40", "text": "我的电脑需要重启，"}, {"type": "subtitle", "time": 26262.39, "timestamp": "07:17:42", "text": "一切都乱套了，直播也中断了。"}, {"type": "subtitle", "time": 26264.948, "timestamp": "07:17:44", "text": "我本来想同时玩《Valerant》和漫威游戏。"}, {"type": "subtitle", "time": 26268.868, "timestamp": "07:17:48", "text": "竞争对手，但它搞砸了，而且因为它"}, {"type": "subtitle", "time": 26271.75, "timestamp": "07:17:51", "text": "这是与 Roku 的合作直播，嗯，因为"}, {"type": "subtitle", "time": 26273.99, "timestamp": "07:17:53", "text": "我没有排名"}, {"type": "subtitle", "time": 26278.43, "timestamp": "07:17:58", "text": "嗯，它又出错了，因为"}]
[{"type": "subtitle", "time": 6720.87, "timestamp": "01:52:00", "text": "逃脱。"}, {"type": "subtitle", "time": 6724.03, "timestamp": "01:52:04", "text": "呃，只需呃，移除你的呃"}, {"type": "subtitle", "time": 6728.39, "timestamp": "01:52:08", "text": "戴上头盔。"}, {"type": "subtitle", "time": 6733.03, "timestamp": "01:52:13", "text": "它是如何彻底移除你的头部的？"}, {"type": "subtitle", "time": 6736.709, "timestamp": "01:52:16", "text": "我猜她那样做的时候应该是程序出了故障。"}, {"type": "subtitle", "time": 6740.47, "timestamp": "01:52:20", "text": "像我一样逃离。是啊，看看我。"}, {"type": "subtitle", "time": 6744.07, "timestamp": "01:52:24", "text": "但你得先把头放下。"}, {"type": "subtitle", "time": 6747.39, "timestamp": "01:52:27", "text": "因为我想我现在用的是官方版本。"}, {"type": "subtitle", "time": 6750.55, "timestamp": "01:52:30", "text": "正式情况下，我也应该有"}, {"type": "subtitle", "time": 6752.229, "timestamp": "01:52:32", "text": "它。"}, {"type": "subtitle", "time": 6754.39, "timestamp": "01:52:34", "text": "我使用的是官方版本。"}, {"type": "subtitle", "time": 6758.149, "timestamp": "01:52:38", "text": "所以这是个常见故障。"}, {"type": "subtitle", "time": 6761.03, "timestamp": "01:52:41", "text": "我不知道它在制造什么。"}, {"type": "subtitle", "time": 6768.79, "timestamp": "01:52:48", "text": "哦，我忘了。相信现在呃，不是"}, {"type": "subtitle", "time": 6771.75, "timestamp": "01:52:51", "text": "现在正在观看比赛。哦，对不起。"}, {"type": "subtitle", "time": 6776.149, "timestamp": "01:52:56", "text": "他们看到的只会是虚空。"}, {"type": "subtitle", "time": 6779.83, "timestamp": "01:52:59", "text": "等等，什么？为什么？呃，因为我参与了，我参与了"}]
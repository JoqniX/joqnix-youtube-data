[{"type": "subtitle", "time": 1142.71, "timestamp": "00:19:02", "text": "这是吗？直接复制“好的”。是的，我得到了"}, {"type": "subtitle", "time": 1145.909, "timestamp": "00:19:05", "text": "那边的这台机器。如果你不想"}, {"type": "subtitle", "time": 1151.15, "timestamp": "00:19:11", "text": "确认你不需要改进"}, {"type": "subtitle", "time": 1156.029, "timestamp": "00:19:16", "text": "从服务器私玩中获取百分之一。"}, {"type": "subtitle", "time": 1158.39, "timestamp": "00:19:18", "text": "好的。你只需要复制粘贴即可"}, {"type": "subtitle", "time": 1166.39, "timestamp": "00:19:26", "text": "哇。好的。"}, {"type": "subtitle", "time": 1177.19, "timestamp": "00:19:37", "text": "好的。它会下载我所有的资料。"}, {"type": "subtitle", "time": 1180.47, "timestamp": "00:19:40", "text": "猜测。你是不是又加了“呃，就像……”"}, {"type": "subtitle", "time": 1183.43, "timestamp": "00:19:43", "text": "客户"}, {"type": "subtitle", "time": 1186.23, "timestamp": "00:19:46", "text": "什么？好的。所以基本上每次你"}, {"type": "subtitle", "time": 1189.27, "timestamp": "00:19:49", "text": "只需要呃，把它收集起来就行了。"}, {"type": "subtitle", "time": 1191.99, "timestamp": "00:19:51", "text": "自动检查您的游戏文件"}, {"type": "subtitle", "time": 1193.75, "timestamp": "00:19:53", "text": "如果你安装了我修改过的所有模组，"}, {"type": "subtitle", "time": 1196.549, "timestamp": "00:19:56", "text": "服务器上会显示下载信息。"}, {"type": "subtitle", "time": 1198.63, "timestamp": "00:19:58", "text": "不管怎样。然后你只需点击即可"}]
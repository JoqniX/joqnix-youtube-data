[{"type": "subtitle", "time": 16200.229, "timestamp": "04:30:00", "text": "炉内会造成"}, {"type": "subtitle", "time": 16201.91, "timestamp": "04:30:01", "text": "熔炉发出红石信号"}, {"type": "subtitle", "time": 16205.67, "timestamp": "04:30:05", "text": "取决于里面有多少件物品。"}, {"type": "subtitle", "time": 16207.67, "timestamp": "04:30:07", "text": "此外，还有一个比较器"}, {"type": "subtitle", "time": 16209.429, "timestamp": "04:30:09", "text": "减法模式允许您"}, {"type": "subtitle", "time": 16211.269, "timestamp": "04:30:11", "text": "抵消红石信号量"}, {"type": "subtitle", "time": 16214.229, "timestamp": "04:30:14", "text": "这是炉子输出的物质。你可以"}, {"type": "subtitle", "time": 16216.189, "timestamp": "04:30:16", "text": "按加号键增加数值，或按加号键增加数值。"}, {"type": "subtitle", "time": 16218.95, "timestamp": "04:30:18", "text": "按住Shift键并点击以减小它。红色"}, {"type": "subtitle", "time": 16220.91, "timestamp": "04:30:20", "text": "绿色强化剂可能是"}, {"type": "subtitle", "time": 16223.11, "timestamp": "04:30:23", "text": "不言自明，我明白……"}, {"type": "subtitle", "time": 16224.71, "timestamp": "04:30:24", "text": "蓝色强化可能需要进一步改进"}, {"type": "subtitle", "time": 16226.309, "timestamp": "04:30:26", "text": "解释。这里有一套铁"}, {"type": "subtitle", "time": 16228.389, "timestamp": "04:30:28", "text": "熔炉在其合理的升级路径中"}, {"type": "subtitle", "time": 16230.469, "timestamp": "04:30:30", "text": "从铁到下界矿石。我们来看看"}, {"type": "subtitle", "time": 16232.07, "timestamp": "04:30:32", "text": "在他们身后。你可以看到它们是"}, {"type": "subtitle", "time": 16235.229, "timestamp": "04:30:35", "text": "由终极能量立方体连接"}, {"type": "subtitle", "time": 16237.349, "timestamp": "04:30:37", "text": "机制。现在我们可以给每个人提供这些"}, {"type": "subtitle", "time": 16243.99, "timestamp": "04:30:43", "text": "输出。请注意，任何形式的射频"}, {"type": "subtitle", "time": 16245.91, "timestamp": "04:30:45", "text": "交通运输没问题，但就这一点而言"}, {"type": "subtitle", "time": 16247.75, "timestamp": "04:30:47", "text": "例如，我只是在使用某种机制。"}, {"type": "subtitle", "time": 16249.269, "timestamp": "04:30:49", "text": "现在，我们可以逐一查看……"}, {"type": "subtitle", "time": 1625
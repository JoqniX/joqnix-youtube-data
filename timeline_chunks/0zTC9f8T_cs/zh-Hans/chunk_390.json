[{"type": "subtitle", "time": 23409.99, "timestamp": "06:30:09", "text": "C级。好的。所以如果我哦，一叠。"}, {"type": "subtitle", "time": 23417.31, "timestamp": "06:30:17", "text": "嗯，我可以把它放进去。"}, {"type": "subtitle", "time": 23420.59, "timestamp": "06:30:20", "text": "这里。我没错"}, {"type": "subtitle", "time": 23423.27, "timestamp": "06:30:23", "text": "点击。等等，为什么是“等等”，这是……"}, {"type": "chat", "time": 23428.893, "timestamp": "06:30:28", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "It is a scam"}, {"type": "subtitle", "time": 23433.03, "timestamp": "06:30:33", "text": "向上。等一下。不是“等等”，而是一个"}, {"type": "subtitle", "time": 23441.51, "timestamp": "06:30:41", "text": "什么？工艺。等等，不存储 X 可能"}, {"type": "subtitle", "time": 23443.548, "timestamp": "06:30:43", "text": "造成重大影响"}, {"type": "subtitle", "time": 23446.868, "timestamp": "06:30:46", "text": "落后。取回。好的。无限存储"}, {"type": "subtitle", "time": 23448.788, "timestamp": "06:30:48", "text": "单个捆绑包中的物品数量。使能够"}, {"type": "subtitle", "time": 23451.75, "timestamp": "06:30:51", "text": "无效的组织。只需放入"}, {"type": "subtitle", "time": 23453.99, "timestamp": "06:30:53", "text": "地面上的。扔掉你所有的物品"}, {"type": "subtitle", "time": 23456.23, "timestamp": "06:30:56", "text": "想要。哦，你可以把它披在身上。"}]
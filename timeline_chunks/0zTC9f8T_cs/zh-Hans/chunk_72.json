[{"type": "subtitle", "time": 4320.95, "timestamp": "01:12:00", "text": "这里。我刚才看到了。它在……下面"}, {"type": "subtitle", "time": 4345.83, "timestamp": "01:12:25", "text": "让我再玩一次。我的天哪，事情完全失控了"}, {"type": "subtitle", "time": 4351.03, "timestamp": "01:12:31", "text": "向下。我可以进入创造模式吗？"}, {"type": "subtitle", "time": 4356.63, "timestamp": "01:12:36", "text": "好的。就让它保持原样吧。不，"}, {"type": "subtitle", "time": 4367.189, "timestamp": "01:12:47", "text": "我只想得到它。"}, {"type": "subtitle", "time": 4370.75, "timestamp": "01:12:50", "text": "如果你想的话，可以去投资加密货币。"}, {"type": "subtitle", "time": 4373.47, "timestamp": "01:12:53", "text": "24. 如何"}, {"type": "subtitle", "time": 4376.199, "timestamp": "01:12:56", "text": "如何 远的？搞什么鬼？它在哪里？"}]
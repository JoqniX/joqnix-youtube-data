[{"type": "subtitle", "time": 16140.309, "timestamp": "04:29:00", "text": "这种配置的炉子。我想"}, {"type": "subtitle", "time": 16142.469, "timestamp": "04:29:02", "text": "这个箱子里的矿石需要进行处理。"}, {"type": "subtitle", "time": 16143.75, "timestamp": "04:29:03", "text": "炉子然后自动"}, {"type": "subtitle", "time": 16145.59, "timestamp": "04:29:05", "text": "输出到这个箱子里。我们会进入"}, {"type": "subtitle", "time": 16147.269, "timestamp": "04:29:07", "text": "然后配置炉体及其侧面"}, {"type": "subtitle", "time": 16151.189, "timestamp": "04:29:11", "text": "第一的。左侧输入，然后输出"}, {"type": "subtitle", "time": 16153.269, "timestamp": "04:29:13", "text": "在右侧。将燃料倒入……"}, {"type": "subtitle", "time": 16155.99, "timestamp": "04:29:15", "text": "先把矿石放进熔炉，然后再放进去。"}, {"type": "subtitle", "time": 16159.189, "timestamp": "04:29:19", "text": "被装进这个箱子里。然后启用"}, {"type": "subtitle", "time": 16161.389, "timestamp": "04:29:21", "text": "自动输入，然后自动"}, {"type": "subtitle", "time": 16163.83, "timestamp": "04:29:23", "text": "输出。然后炉子应该开始运转了。"}, {"type": "subtitle", "time": 16165.99, "timestamp": "04:29:25", "text": "冶炼矿石。如果我们仔细观察这一点……"}, {"type": "subtitle", "time": 16167.83, "timestamp": "04:29:27", "text": "箱子里可以看到铁。"}, {"type": "subtitle", "time": 16169.429, "timestamp": "04:29:29", "text": "这里面有锭块。假设我们想要一台暖气炉"}, {"type": "subtitle", "time": 16170.87, "timestamp": "04:29:30", "text": "仅在有……时开启"}, {"type": "subtitle", "time": 16173.349, "timestamp": "04:29:33", "text": "激活的红石信号。简单放置"}, {"type": "subtitle", "time": 16175.03, "timestamp": "04:29:35", "text": "你的肝脏放在炉子顶上，"}, {"type": "subtitle", "time": 16176.87, "timestamp": "04:29:36", "text": "然后将其红石信号设置为高电平。"}, {"type": "subtitle", "time": 16177.83, "timestamp": "04:29:37", "text": "炉子应该关闭"}, {"type": "subtitle", "time": 16178.95, "timestamp": "04:29:38", "text": "自动，因为没有"}, {"type": "subtitle", "time": 16180.63, "timestamp": "04:29:40", "text": "施加红石信号，然后"}, {"type": "subtitle", "time": 16182.79, "timestamp": "04:29:42", "text": "拉动控制杆。炉子应该"}, {"type": "subtitle", "time": 16184.63, "timestamp": "04:29:44", "text": "然后打开。如果我们关掉控制杆，"}, {"type": "subtitle", "time": 16186.07, "timestamp": "04:29:46", "text": "暖气炉又熄火了。就是这样"}, {"type": "subtitle", "time": 16187.83, "timestamp": "04:29:47", "text": "你用红石控制熔炉。"}, {"type": "subtitle", "time": 16189.429, "timestamp": "04:29:49", "text": "此外，你还可以控制红石信号。"}, {"type": "subtitle", "time": 16190.63, "timestamp": "04:29:50", "text": "它本身使用比较器"}, {"type": "subtitle", "time": 16192.469, "timestamp": "04:29:52", "text": "炉子的功能。直接走"}, {"type": "subtitle", "time": 16193.75, "timestamp": "04:29:53", "text": "进入炉子的接口并"}, {"type": "subtitle", "time": 16195.11, "timestamp": "04:29:55", "text": "启用比较器模式。这"}, {"type": "subtitle", "time": 16196.63, "timestamp": "04:29:56", "text": "现在，炉子将像有一个……一样运行。"}, {"type": "subtitle", "time": 16198.63, "timestamp": "04:29:58", "text": "它附带一个比较器。放置物品"}]
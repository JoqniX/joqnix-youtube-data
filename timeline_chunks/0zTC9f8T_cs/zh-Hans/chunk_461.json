[{"type": "subtitle", "time": 27660.388, "timestamp": "07:41:00", "text": "你在做什么？你在做什么？为什么？哦，我的天"}, {"type": "subtitle", "time": 27661.43, "timestamp": "07:41:01", "text": "上帝。"}, {"type": "subtitle", "time": 27663.03, "timestamp": "07:41:03", "text": "他们他妈的在检查我。该死的"}, {"type": "subtitle", "time": 27671.83, "timestamp": "07:41:11", "text": "现在。我需要从侧翼包抄他们，就像他们那样"}, {"type": "subtitle", "time": 27678.59, "timestamp": "07:41:18", "text": "他们预料到我会来吗？该死的"}, {"type": "subtitle", "time": 27707.35, "timestamp": "07:41:47", "text": "正在编译着色器。卧槽，他毁了"}, {"type": "subtitle", "time": 27712.948, "timestamp": "07:41:52", "text": "哦，是啊，我在你面前显得太高大了。"}]
[{"type": "subtitle", "time": 27364.15, "timestamp": "07:36:04", "text": "摇滚乐已经完成了，就像 2 4 6 8 一样。谁"}, {"type": "subtitle", "time": 27367.19, "timestamp": "07:36:07", "text": "我们很感激？我不，我从来没做过。"}, {"type": "subtitle", "time": 27370.31, "timestamp": "07:36:10", "text": "那。我们就是这么做的。你有没有过"}, {"type": "subtitle", "time": 27373.07, "timestamp": "07:36:13", "text": "你曾经参加过啦啦队吗？"}, {"type": "subtitle", "time": 27380.788, "timestamp": "07:36:20", "text": "真有趣，老兄。我真是太逊了。是的。我们开始吧"}, {"type": "subtitle", "time": 27388.99, "timestamp": "07:36:28", "text": "杰夫。杰夫是凶手。"}, {"type": "subtitle", "time": 27391.51, "timestamp": "07:36:31", "text": "补充水分。孩子。是的。补充水分。我需要"}, {"type": "subtitle", "time": 27393.19, "timestamp": "07:36:33", "text": "补充水分。该死的。谢谢"}, {"type": "subtitle", "time": 27394.43, "timestamp": "07:36:34", "text": "提醒"}, {"type": "subtitle", "time": 27397.03, "timestamp": "07:36:37", "text": "兄弟。乔在前面显得太矮小了"}, {"type": "subtitle", "time": 27400.59, "timestamp": "07:36:40", "text": "你的乳房。俄语。他说关于"}, {"type": "subtitle", "time": 27403.19, "timestamp": "07:36:43", "text": "那。乔克。你对此有何看法？"}, {"type": "subtitle", "time": 27407.43, "timestamp": "07:36:47", "text": "你知道吗，我不知道该说什么。"}, {"type": "subtitle", "time": 27409.91, "timestamp": "07:36:49", "text": "你喜欢你看到的东西吗？"}, {"type": "subtitle", "time": 27412.628, "timestamp": "07:36:52", "text": "你不喜欢看你吗？我不喜欢。"}, {"type": "subtitle", "time": 27418.388, "timestamp": "07:36:58", "text": "说。我可以保持沉默吗？我不。你是"}]
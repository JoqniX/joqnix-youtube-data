[{"type": "subtitle", "time": 16020.55, "timestamp": "04:27:00", "text": "炉子表现得就像它是一个"}, {"type": "subtitle", "time": 16022.71, "timestamp": "04:27:02", "text": "吸烟者。这两个强化装置都会锁定熔炉。"}, {"type": "subtitle", "time": 16024.87, "timestamp": "04:27:04", "text": "配方库，以便他们只能使用"}, {"type": "subtitle", "time": 16027.11, "timestamp": "04:27:07", "text": "无论是烟熏炉还是鼓风炉"}, {"type": "subtitle", "time": 16029.349, "timestamp": "04:27:09", "text": "配方库。绿色强化剂是"}, {"type": "subtitle", "time": 16031.75, "timestamp": "04:27:11", "text": "添加额外修饰符的强化"}, {"type": "subtitle", "time": 16034.55, "timestamp": "04:27:14", "text": "送入炉膛。这种速度强化效果有"}, {"type": "subtitle", "time": 16036.63, "timestamp": "04:27:16", "text": "所有食谱的烹饪时间都一样，但制作"}, {"type": "subtitle", "time": 16038.95, "timestamp": "04:27:18", "text": "该炉子消耗的燃料是原来的两倍。和"}, {"type": "subtitle", "time": 16040.63, "timestamp": "04:27:20", "text": "首先，燃油效率提升"}, {"type": "subtitle", "time": 16042.389, "timestamp": "04:27:22", "text": "这样可以减少炉子的燃料消耗。"}, {"type": "subtitle", "time": 16044.469, "timestamp": "04:27:24", "text": "它能闻到气味。然而，这增加了"}, {"type": "subtitle", "time": 16046.55, "timestamp": "04:27:26", "text": "熔炼这些物品所需的时间。"}, {"type": "subtitle", "time": 16048.79, "timestamp": "04:27:28", "text": "最后，但同样重要的是，蓝色"}, {"type": "subtitle", "time": 16050.79, "timestamp": "04:27:30", "text": "增强体是改变……的增强体。"}, {"type": "subtitle", "time": 16052.469, "timestamp": "04:27:32", "text": "炉子的工作原理，但允许"}, {"type": "subtitle", "time": 16054.469, "timestamp": "04:27:34", "text": "熔炉保留其配方池。这"}, {"type": "subtitle", "time": 16056.469, "timestamp": "04:27:36", "text": "工厂增补功能允许熔炉"}, {"type": "subtitle", "time": 16058.149, "timestamp": "04:27:38", "text": "成为一家工厂，这会增加"}, {"type": "subtitle", "time": 16059.91, "timestamp": "04:27:39", "text": "输入输出插槽的数量"}, {"type": "subtitle", "time": 16062.07, "timestamp": "04:27:42", "text": "炉子有。然而，炉子必须"}, {"type": "subtitle", "time": 16064.149, "timestamp": "04:27:44", "text": "用电力熔炼物品。发电机"}, {"type": "subtitle", "time": 16065.75, "timestamp": "04:27:45", "text": "增强功能将熔炉转换为"}, {"type": "subtitle", "time": 16067.59, "timestamp": "04:27:47", "text": "发电机。发电机随后会冒烟。"}, {"type": "subtitle", "time": 16070.309, "timestamp": "04:27:50", "text": "它利用燃料产生射频信号。然而，这"}, {"type": "subtitle", "time": 16071.99, "timestamp": "04:27:51", "text": "炉子将不再能够冒烟"}, {"type": "subtitle", "time": 16073.91, "timestamp": "04:27:53", "text": "物品并创造他们的产品。肯定"}, {"type": "subtitle", "time": 16075.83, "timestamp": "04:27:55", "text": "增强剂之间可以相互协同作用。这"}, {"type": "subtitle", "time": 16077.75, "timestamp": "04:27:57", "text": "生成器增强功能将与……产生协同效应"}, {"type": "subtitle", "time": 16079.83, "timestamp": "04:27:59", "text": "两个红色增强。使用生成器"}]
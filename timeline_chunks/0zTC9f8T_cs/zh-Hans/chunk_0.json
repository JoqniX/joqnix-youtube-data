[{"type": "subtitle", "time": 1.91, "timestamp": "00:00:01", "text": "那个人可以看到我在打开"}, {"type": "subtitle", "time": 3.71, "timestamp": "00:00:03", "text": "逃脱"}, {"type": "subtitle", "time": 11.95, "timestamp": "00:00:11", "text": "我"}, {"type": "subtitle", "time": 15.829, "timestamp": "00:00:15", "text": "无法加入部分流。"}, {"type": "subtitle", "time": 18.39, "timestamp": "00:00:18", "text": "我们会一起出去玩，然后我会去……"}, {"type": "subtitle", "time": 21.349, "timestamp": "00:00:21", "text": "晚点睡觉。我们会一起出去玩，我会"}, {"type": "subtitle", "time": 23.63, "timestamp": "00:00:23", "text": "前往“嘿，好大的箱子”"}, {"type": "subtitle", "time": 28.47, "timestamp": "00:00:28", "text": "我的世界线圈。你为什么看不到这一点"}, {"type": "subtitle", "time": 46.869, "timestamp": "00:00:46", "text": "正在做。呃，我做手工。好的，我需要补充"}, {"type": "subtitle", "time": 48.549, "timestamp": "00:00:48", "text": "更多的。"}]
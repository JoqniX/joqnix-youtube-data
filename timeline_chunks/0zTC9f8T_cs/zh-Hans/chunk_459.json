[{"type": "subtitle", "time": 27540.948, "timestamp": "07:39:00", "text": "我大概能拿到20分。好的。让我……让我"}, {"type": "subtitle", "time": 27544.628, "timestamp": "07:39:04", "text": "厨师。好的。是的。你一定可以的。"}, {"type": "subtitle", "time": 27552.07, "timestamp": "07:39:12", "text": "这是什么绿色的东西？它是"}, {"type": "subtitle", "time": 27558.59, "timestamp": "07:39:18", "text": "哦，你可以喜欢你"}, {"type": "subtitle", "time": 27560.99, "timestamp": "07:39:20", "text": "哦，"}, {"type": "subtitle", "time": 27563.99, "timestamp": "07:39:23", "text": "该死。比《守望先锋》好太多了。我也是"}, {"type": "subtitle", "time": 27566.868, "timestamp": "07:39:26", "text": "好的。好的，我可以启动游戏了。"}, {"type": "subtitle", "time": 27568.708, "timestamp": "07:39:28", "text": "请工作。游戏终于可以发布了。"}, {"type": "subtitle", "time": 27574.708, "timestamp": "07:39:34", "text": "选钢铁侠就行了，你就能立刻获得"}, {"type": "subtitle", "time": 27577.35, "timestamp": "07:39:37", "text": "杀戮。简单的。简单的。"}, {"type": "subtitle", "time": 27579.19, "timestamp": "07:39:39", "text": "是的。"}, {"type": "subtitle", "time": 27580.788, "timestamp": "07:39:40", "text": "你看，我就跟飘来飘去一样。"}, {"type": "subtitle", "time": 27583.59, "timestamp": "07:39:43", "text": "就是单纯地杀人。三次人头。"}, {"type": "subtitle", "time": 27591.19, "timestamp": "07:39:51", "text": "哦，我错过了。他妈的。我错过了。"}, {"type": "subtitle", "time": 27594.628, "timestamp": "07:39:54", "text": "我错过了我的，该死的。我是个白痴。"}]
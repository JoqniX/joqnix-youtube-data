[{"type": "subtitle", "time": 7081.51, "timestamp": "01:58:01", "text": "知道。我不知道你们为什么……"}, {"type": "subtitle", "time": 7089.27, "timestamp": "01:58:09", "text": "呃，我也不知道我为什么笑了。"}, {"type": "subtitle", "time": 7092.03, "timestamp": "01:58:12", "text": "是的，你是"}, {"type": "chat", "time": 7092.365, "timestamp": "01:58:12", "author": "@saii.", "avatar": "https://yt4.ggpht.com/3zUIW6dAQ6Lr5vLl0lqQ1SDX6_FlSHF5uPT02PbCpi3rR1u3H4KK3Clvc3h4GwayKUCSUkNFr_Y=s64-c-k-c0x00ffffff-no-rj", "message": "yeah, bro... yesss"}, {"type": "subtitle", "time": 7096.149, "timestamp": "01:58:16", "text": "绝对是红石羊竹蜂。"}, {"type": "subtitle", "time": 7099.51, "timestamp": "01:58:19", "text": "红石绵羊大战。红石羊"}, {"type": "chat", "time": 7101.507, "timestamp": "01:58:21", "author": "@BRUCELEE-wt7hk", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kywKa6HSckNVxhER8qedLRRVkcGIqFFytjQHe-071HyMo=s64-c-k-c0x00ffffff-no-rj", "message": "machinery"}, {"type": "subtitle", "time": 7102.39, "timestamp": "01:58:22", "text": "就像自动生成的表格一样。它能检测到。"}, {"type": "subtitle", "time": 7104.55, "timestamp": "01:58:24", "text": "草、植物和邻近收割"}, {"type": "subtitle", "time": 7106.229, "timestamp": "01:58:26", "text": "他们。当发动机怠速运转直至燃油耗尽时，"}, {"type": "subtitle", "time": 7108.31, "timestamp": "01:58:28", "text": "返回初始位置。我的天啊，"}, {"type": "subtitle", "time": 7110.79, "timestamp": "01:58:30", "text": "这是一只绵羊。"}, {"type": "subtitle", "time": 7112.709, "timestamp": "01:58:32", "text": "哦，原来有个模组……"}, {"type": "subtitle", "time": 7114.95, "timestamp": "01:58:34", "text": "酷炫的魔像。我不想做"}, {"type": "subtitle", "time": 7117.149, "timestamp": "01:58:37", "text": "这游戏角色扮演成分太重了，"}, {"type": "chat", "time": 7117.722, "timestamp": "01:58:37", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "missionary stuff > machinery stuff"}, {"type": "subtitle", "time": 7119.589, "timestamp": "01:58:39", "text": "正确的？我想要正常的生活。"}, {"type": "chat", "time": 7121.015, "timestamp": "01:58:41", "author": "@tengenUzui_flashy1", "avatar": "https://yt4.ggpht.com/U4bubkmDa5_iTX7UhU8yE4NYF3WqbD1yjlX5vpRZK99vtN8boUL9ZV-pbM8qJhCV69RI6ILr=s64-c-k-c0x00ffffff-no-rj", "message": "The Missionary Stuffs..."}, {"type": "subtitle", "time": 7122.669, "timestamp": "01:58:42", "text": "我的世界。有趣的我的世界。"}, {"type": "subtitle", "time": 7126.47, "timestamp": "01:58:46", "text": "是的，我对电钻很感兴趣。呃，"}, {"type": "subtitle", "time": 7129.43, "timestamp": "01:58:49", "text": "可以轻松挖穿泥土。所以，它"}, {"type": "subtitle", "time": 7131.55, "timestamp": "01:58:51", "text": "挖掘。你会得到吗？"}, {"type": "subtitle", "time": 7135.109, "timestamp": "01:58:55", "text": "积木？如果是操，你怎么样？"}, {"type": "subtitle", "time": 7138.109, "timestamp": "01:58:58", "text": "跑得这么快？我们开始吧"}]
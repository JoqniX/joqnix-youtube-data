[{"type": "subtitle", "time": 22983.67, "timestamp": "06:23:03", "text": "铁。那个太阳能灶简直就是个骗局。"}, {"type": "subtitle", "time": 22986.708, "timestamp": "06:23:06", "text": "男人。我应该……我不应该那样做。我"}, {"type": "subtitle", "time": 22988.628, "timestamp": "06:23:08", "text": "我想我可以把太阳能灶拆掉。"}, {"type": "subtitle", "time": 22996.43, "timestamp": "06:23:16", "text": "猜测。但是加热器是"}, {"type": "subtitle", "time": 22999.27, "timestamp": "06:23:19", "text": "好的。我希望有一种方法可以泡澡"}, {"type": "subtitle", "time": 23002.788, "timestamp": "06:23:22", "text": "这款游戏。我可以要个暖气吗？热的"}, {"type": "subtitle", "time": 23006.39, "timestamp": "06:23:26", "text": "淋浴。我的天啊。我一会儿就起来。然后我"}, {"type": "subtitle", "time": 23009.83, "timestamp": "06:23:29", "text": "我看到一个模组，它允许它……"}, {"type": "subtitle", "time": 23012.15, "timestamp": "06:23:32", "text": "实际上它会提醒你多喝水。它是"}, {"type": "subtitle", "time": 23014.708, "timestamp": "06:23:34", "text": "就像萨瓦一样。我会把它做得像……"}, {"type": "subtitle", "time": 23016.868, "timestamp": "06:23:36", "text": "生存游戏。就像你必须找到一个"}, {"type": "subtitle", "time": 23019.83, "timestamp": "06:23:39", "text": "水源和饮用水，便携式"}, {"type": "subtitle", "time": 23031.39, "timestamp": "06:23:51", "text": "水。呃，如果你喝酒"}, {"type": "subtitle", "time": 23034.31, "timestamp": "06:23:54", "text": "海水涌入空旷的地面"}, {"type": "subtitle", "time": 23037.43, "timestamp": "06:23:57", "text": "模型，你得到半颗心，半颗"}]
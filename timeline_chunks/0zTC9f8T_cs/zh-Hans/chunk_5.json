[{"type": "subtitle", "time": 307.189, "timestamp": "00:05:07", "text": "7. 我忘了日语。"}, {"type": "subtitle", "time": 309.749, "timestamp": "00:05:09", "text": "什么？你真的要去日本了。"}, {"type": "subtitle", "time": 312.629, "timestamp": "00:05:12", "text": "你怎么能忘记日语呢？全部"}, {"type": "subtitle", "time": 317.43, "timestamp": "00:05:17", "text": "东西。我忘了点时间了。"}, {"type": "subtitle", "time": 320.23, "timestamp": "00:05:20", "text": "我的天啊。那份PDF文件在哪儿来着？在哪里"}, {"type": "subtitle", "time": 323.83, "timestamp": "00:05:23", "text": "Edge 是 Edge 吗？我猜是Edge。我在这里打开的。"}, {"type": "subtitle", "time": 324.51, "timestamp": "00:05:24", "text": "但"}, {"type": "subtitle", "time": 330.469, "timestamp": "00:05:30", "text": "是啊，哦，它已经不在了。嗯"}, {"type": "subtitle", "time": 334.749, "timestamp": "00:05:34", "text": "嗯，是的，位置，地点，嗯"}, {"type": "subtitle", "time": 339.629, "timestamp": "00:05:39", "text": "日历，时间。嗯，是什么来着？"}, {"type": "subtitle", "time": 344.909, "timestamp": "00:05:44", "text": "和"}, {"type": "subtitle", "time": 349.43, "timestamp": "00:05:49", "text": "Naka，我把那些都忘了哪个是哪个了。"}, {"type": "subtitle", "time": 350.35, "timestamp": "00:05:50", "text": "哦，我的天"}, {"type": "subtitle", "time": 358.99, "timestamp": "00:05:58", "text": "呃，我还需要"}]
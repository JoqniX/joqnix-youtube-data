[{"type": "subtitle", "time": 15962.95, "timestamp": "04:26:02", "text": "您好，欢迎来到入门指南"}, {"type": "subtitle", "time": 15964.63, "timestamp": "04:26:04", "text": "铁炉模组指南"}, {"type": "subtitle", "time": 15966.469, "timestamp": "04:26:06", "text": "提供诸如制作工艺等信息的模组"}, {"type": "subtitle", "time": 15968.07, "timestamp": "04:26:08", "text": "食谱逐步呈现。请参阅"}, {"type": "subtitle", "time": 15969.67, "timestamp": "04:26:09", "text": "下面会提供维基百科的链接。和"}, {"type": "subtitle", "time": 15971.03, "timestamp": "04:26:11", "text": "先把这件事说完，这是我的一个。"}, {"type": "subtitle", "time": 15973.189, "timestamp": "04:26:13", "text": "巧妙地，你可以制作方块本身。"}, {"type": "subtitle", "time": 15975.83, "timestamp": "04:26:15", "text": "用这个食谱。所有现有的炉子"}, {"type": "subtitle", "time": 15977.349, "timestamp": "04:26:17", "text": "既然如此，我们来看一下……"}, {"type": "subtitle", "time": 15980.149, "timestamp": "04:26:20", "text": "揭开引擎盖下的秘密。你做的第一件事"}, {"type": "subtitle", "time": 15981.75, "timestamp": "04:26:21", "text": "应该注意铁炉的"}, {"type": "subtitle", "time": 15983.429, "timestamp": "04:26:23", "text": "界面方面，它增加了一些功能。"}, {"type": "subtitle", "time": 15985.429, "timestamp": "04:26:25", "text": "来自原版熔炉界面。在"}, {"type": "subtitle", "time": 15986.55, "timestamp": "04:26:26", "text": "炉子的左侧"}, {"type": "subtitle", "time": 15988.469, "timestamp": "04:26:28", "text": "界面上，你会注意到炉子的"}, {"type": "subtitle", "time": 15990.63, "timestamp": "04:26:30", "text": "配置选项卡。打开此标签页即可获得"}, {"type": "subtitle", "time": 15993.429, "timestamp": "04:26:33", "text": "自动输入和配置选项"}, {"type": "subtitle", "time": 15997.389, "timestamp": "04:26:37", "text": "输出侧输入和输出和"}, {"type": "subtitle", "time": 15999.59, "timestamp": "04:26:39", "text": "红石。在界面顶部，"}, {"type": "subtitle", "time": 16001.269, "timestamp": "04:26:41", "text": "就在炉子名称旁边，你"}, {"type": "subtitle", "time": 16003.91, "timestamp": "04:26:43", "text": "应该能看到增强按钮。点击"}, {"type": "subtitle", "time": 16006.309, "timestamp": "04:26:46", "text": "这样我们就能看到炉子的……"}, {"type": "subtitle", "time": 16008.55, "timestamp": "04:26:48", "text": "增强菜单。增强，恕我直言"}, {"type": "subtitle", "time": 16011.349, "timestamp": "04:26:51", "text": "观点，正是这个模组真正闪光之处。"}, {"type": "subtitle", "time": 16013.59, "timestamp": "04:26:53", "text": "整个菜单上，你不会看到“"}, {"type": "subtitle", "time": 16015.189, "timestamp": "04:26:55", "text": "爆破增效使熔炉能够"}, {"type": "subtitle", "time": 16017.189, "timestamp": "04:26:57", "text": "就像对待高炉一样，"}, {"type": "subtitle", "time": 16019.03, "timestamp": "04:26:59", "text": "吸烟增强功能允许"}]
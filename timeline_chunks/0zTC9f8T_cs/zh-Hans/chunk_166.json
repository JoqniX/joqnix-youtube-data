[{"type": "subtitle", "time": 9960.23, "timestamp": "02:46:00", "text": "可以做到。好的，我正在考虑添加"}, {"type": "subtitle", "time": 9961.469, "timestamp": "02:46:01", "text": "这个"}, {"type": "subtitle", "time": 9963.79, "timestamp": "02:46:03", "text": "出色地。瞧瞧"}, {"type": "subtitle", "time": 9966.91, "timestamp": "02:46:06", "text": "因为它会给我们带来更多武器，更多"}, {"type": "subtitle", "time": 9968.99, "timestamp": "02:46:08", "text": "如果你穿盔甲"}, {"type": "subtitle", "time": 9973.83, "timestamp": "02:46:13", "text": "想不想都行。完全取决于你。"}, {"type": "subtitle", "time": 9976.63, "timestamp": "02:46:16", "text": "我不想让事情变得太……呃，你"}, {"type": "subtitle", "time": 9980.15, "timestamp": "02:46:20", "text": "绝对知道这令人难以承受。是的。哦，一个"}, {"type": "subtitle", "time": 9986.07, "timestamp": "02:46:26", "text": "画廊牧师咒语。哦，角色扮演游戏系列。"}, {"type": "subtitle", "time": 9987.07, "timestamp": "02:46:27", "text": "我感觉"}, {"type": "subtitle", "time": 9990.469, "timestamp": "02:46:30", "text": "就像正常玩Minecraft一样。"}, {"type": "subtitle", "time": 9993.59, "timestamp": "02:46:33", "text": "现在我玩不了了。哦不，"}, {"type": "subtitle", "time": 9998.07, "timestamp": "02:46:38", "text": "Ro的Steam账号被盗了。他做了什么？"}, {"type": "subtitle", "time": 10002.55, "timestamp": "02:46:42", "text": "什么？ Roco的账号被盗了。我看到了蒸汽"}, {"type": "subtitle", "time": 10004.429, "timestamp": "02:46:44", "text": "信息"}, {"type": "subtitle", "time": 10008.87, "timestamp": "02:46:48", "text": "说：“我送你一份价值 50 美元的 Steam 礼物。”"}, {"type": "subtitle", "time": 10011.51, "timestamp": "02:46:51", "text": "呃，如果你遇到这种情况，千万别点开。"}]
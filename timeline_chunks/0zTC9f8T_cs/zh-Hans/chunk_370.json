[{"type": "subtitle", "time": 22206.51, "timestamp": "06:10:06", "text": "可能是天然形成的。"}, {"type": "subtitle", "time": 22211.23, "timestamp": "06:10:11", "text": "嗯，块。等待。呃，铁块，对吧？"}, {"type": "subtitle", "time": 22215.59, "timestamp": "06:10:15", "text": "铁。它闻起来也很香吗？我需要"}, {"type": "subtitle", "time": 22219.83, "timestamp": "06:10:19", "text": "检查一下。你愿意工作吗？为什么？为什么是"}, {"type": "subtitle", "time": 22222.868, "timestamp": "06:10:22", "text": "不能用吗？等等，这是……等等，是"}, {"type": "subtitle", "time": 22225.27, "timestamp": "06:10:25", "text": "这是，哦，现在可以了。"}, {"type": "subtitle", "time": 22233.628, "timestamp": "06:10:33", "text": "呃"}, {"type": "subtitle", "time": 22236.03, "timestamp": "06:10:36", "text": "被骗了。我的"}, {"type": "subtitle", "time": 22250.35, "timestamp": "06:10:50", "text": "呃"}, {"type": "subtitle", "time": 22253.19, "timestamp": "06:10:53", "text": "特征。我得到它。但是，但是什么是"}, {"type": "subtitle", "time": 22255.51, "timestamp": "06:10:55", "text": "原料？多少才算多？所以你可以"}, {"type": "subtitle", "time": 22258.15, "timestamp": "06:10:58", "text": "放一块闪亮的钻石块"}, {"type": "chat", "time": 22258.62, "timestamp": "06:10:58", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "DAAAMN"}]
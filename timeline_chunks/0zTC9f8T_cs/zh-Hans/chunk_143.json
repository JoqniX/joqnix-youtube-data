[{"type": "subtitle", "time": 8606.07, "timestamp": "02:23:26", "text": "你可以瞬间移动。不，我不知道。我"}, {"type": "subtitle", "time": 8614.75, "timestamp": "02:23:34", "text": "某物"}, {"type": "subtitle", "time": 8626.87, "timestamp": "02:23:46", "text": "哦，就像在《我的世界》里一样"}, {"type": "subtitle", "time": 8629.429, "timestamp": "02:23:49", "text": "基岩。哦，"}, {"type": "subtitle", "time": 8630.63, "timestamp": "02:23:50", "text": "等待。我再给你看点别的。"}, {"type": "subtitle", "time": 8635.469, "timestamp": "02:23:55", "text": "等等，让我走。哇。哇。好的。"}, {"type": "subtitle", "time": 8637.87, "timestamp": "02:23:57", "text": "好的。只是"}]
[{"type": "subtitle", "time": 11293.51, "timestamp": "03:08:13", "text": "这是什么？无人机。一个小"}, {"type": "subtitle", "time": 11295.75, "timestamp": "03:08:15", "text": "可编程无人机在物体周围移动。"}, {"type": "subtitle", "time": 11297.15, "timestamp": "03:08:17", "text": "你可以搬家"}, {"type": "subtitle", "time": 11300.87, "timestamp": "03:08:20", "text": "项目。想象一下，你必须得到"}, {"type": "subtitle", "time": 11305.15, "timestamp": "03:08:25", "text": "现在就把东西转移到你的"}, {"type": "subtitle", "time": 11309.83, "timestamp": "03:08:29", "text": "如果你带着这个，就把它带回家。"}, {"type": "subtitle", "time": 11311.67, "timestamp": "03:08:31", "text": "送货。"}, {"type": "subtitle", "time": 11313.75, "timestamp": "03:08:33", "text": "是的。你知道吗？让我们添加游戏和"}, {"type": "subtitle", "time": 11318.309, "timestamp": "03:08:38", "text": "我们也来制作一张《使命召唤》地图吧。"}, {"type": "subtitle", "time": 11319.63, "timestamp": "03:08:39", "text": "我们再加些枪支吧。"}, {"type": "subtitle", "time": 11321.91, "timestamp": "03:08:41", "text": "正确的？你知道吗？最好"}, {"type": "subtitle", "time": 11323.59, "timestamp": "03:08:43", "text": "让《使命召唤》服务器慢跑一下，不是吗？"}, {"type": "subtitle", "time": 11329.99, "timestamp": "03:08:49", "text": "我的天啊。你应该移除这些模组。"}, {"type": "subtitle", "time": 11338.15, "timestamp": "03:08:58", "text": "嗯，铜扇。哦，是的，我只是想"}]
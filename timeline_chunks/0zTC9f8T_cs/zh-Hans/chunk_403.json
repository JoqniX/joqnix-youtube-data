[{"type": "subtitle", "time": 24181.39, "timestamp": "06:43:01", "text": "名为 unloaded 的某个模组"}, {"type": "subtitle", "time": 24184.11, "timestamp": "06:43:04", "text": "活动。所以，就像"}, {"type": "subtitle", "time": 24187.708, "timestamp": "06:43:07", "text": "呃，我之前并不知道，直到我看到……"}, {"type": "subtitle", "time": 24192.67, "timestamp": "06:43:12", "text": "这。嗯……该怎么说呢？"}, {"type": "subtitle", "time": 24196.628, "timestamp": "06:43:16", "text": "它？所以当警察之类的事情发生时"}, {"type": "subtitle", "time": 24199.27, "timestamp": "06:43:19", "text": "超出模拟距离，通常"}, {"type": "subtitle", "time": 24201.59, "timestamp": "06:43:21", "text": "他们不肯去。这个模组改变了这一点。"}, {"type": "subtitle", "time": 24203.83, "timestamp": "06:43:23", "text": "一旦他们得到，就通过计算得出"}, {"type": "subtitle", "time": 24206.39, "timestamp": "06:43:26", "text": "在模拟范围内进行更新。"}, {"type": "subtitle", "time": 24207.91, "timestamp": "06:43:27", "text": "所以就好像他们从未离开过一样。"}, {"type": "subtitle", "time": 24209.99, "timestamp": "06:43:29", "text": "模拟范围。现在你可以探索了"}, {"type": "subtitle", "time": 24212.628, "timestamp": "06:43:32", "text": "在等待作物生长期间或"}, {"type": "subtitle", "time": 24215.99, "timestamp": "06:43:35", "text": "用炉子做饭。所以，这就像在我们这里一样。"}, {"type": "subtitle", "time": 24220.31, "timestamp": "06:43:40", "text": "根据。不，我们放东西是为了种作物。"}, {"type": "subtitle", "time": 24222.31, "timestamp": "06:43:42", "text": "呃，那个东西。它会更像"}, {"type": "subtitle", "time": 24225.59, "timestamp": "06:43:45", "text": "实际的。我们像……一样去冒险"}, {"type": "subtitle", "time": 24228.868, "timestamp": "06:43:48", "text": "非常遥远的地方，那里有我们的庄稼，"}, {"type": "subtitle", "time": 24231.83, "timestamp": "06:43:51", "text": "东西会生长，我们的"}, {"type": "subtitle", "time": 24233.99, "timestamp": "06:43:53", "text": "炉子将会已经"}, {"type": "subtitle", "time": 24236.708, "timestamp": "06:43:56", "text": "煮熟的东西，我们回来的时候……"}]
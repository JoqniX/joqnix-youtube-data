[{"type": "subtitle", "time": 27609.91, "timestamp": "07:40:09", "text": "那么，你午饭吃什么呢？"}, {"type": "subtitle", "time": 27611.99, "timestamp": "07:40:11", "text": "正确的？"}, {"type": "subtitle", "time": 27615.67, "timestamp": "07:40:15", "text": "嗯……早餐。我曾"}, {"type": "subtitle", "time": 27619.43, "timestamp": "07:40:19", "text": "嗯，恰巴提和"}, {"type": "subtitle", "time": 27622.31, "timestamp": "07:40:22", "text": "什么？恰巴提饼。"}, {"type": "subtitle", "time": 27624.388, "timestamp": "07:40:24", "text": "恰巴提，就像印度薄饼一样。该死的。"}, {"type": "subtitle", "time": 27626.868, "timestamp": "07:40:26", "text": "烤饼？等等，你的说法不一样？"}, {"type": "subtitle", "time": 27629.43, "timestamp": "07:40:29", "text": "等待。不，我根本没说过。我说"}, {"type": "subtitle", "time": 27630.948, "timestamp": "07:40:30", "text": "烤饼。"}, {"type": "subtitle", "time": 27632.548, "timestamp": "07:40:32", "text": "啊。"}, {"type": "subtitle", "time": 27634.868, "timestamp": "07:40:34", "text": "没关系。你想吃什么就吃什么。"}, {"type": "subtitle", "time": 27637.628, "timestamp": "07:40:37", "text": "伙伴。任何你想要的。"}, {"type": "subtitle", "time": 27652.07, "timestamp": "07:40:52", "text": "哇。好的。是的。你好。那好吧"}, {"type": "subtitle", "time": 27654.19, "timestamp": "07:40:54", "text": "欢迎来到"}, {"type": "subtitle", "time": 27657.67, "timestamp": "07:40:57", "text": "溪流。呃，游戏画面捕捉。快点。为什么"}]
[{"type": "subtitle", "time": 26761.67, "timestamp": "07:26:01", "text": "方式。罗，那边情况怎么样？"}, {"type": "subtitle", "time": 26764.788, "timestamp": "07:26:04", "text": "呃，一天。我感觉就像……呃，我刚醒。"}, {"type": "subtitle", "time": 26766.468, "timestamp": "07:26:06", "text": "我本来应该早点去健身房的。"}, {"type": "subtitle", "time": 26769.07, "timestamp": "07:26:09", "text": "早上好，但我确实"}, {"type": "subtitle", "time": 26772.07, "timestamp": "07:26:12", "text": "不是。我心想，我的天哪，我的骨头……"}, {"type": "subtitle", "time": 26779.35, "timestamp": "07:26:19", "text": "我当时只是觉得很累。你知道冬天"}, {"type": "subtitle", "time": 26782.23, "timestamp": "07:26:22", "text": "从来都不好，呃，从来都不是好日子。"}, {"type": "subtitle", "time": 26785.59, "timestamp": "07:26:25", "text": "这是我的想法。"}, {"type": "subtitle", "time": 26789.51, "timestamp": "07:26:29", "text": "啊，等等。但你几点睡的？"}, {"type": "subtitle", "time": 26791.51, "timestamp": "07:26:31", "text": "昨天？"}, {"type": "subtitle", "time": 26801.15, "timestamp": "07:26:41", "text": "你叫我喜欢"}, {"type": "subtitle", "time": 26807.468, "timestamp": "07:26:47", "text": "呃，去做吧。就像早晨一样。好的。"}, {"type": "subtitle", "time": 26811.43, "timestamp": "07:26:51", "text": "好的，我会等你。但规模有多大？"}, {"type": "subtitle", "time": 26815.51, "timestamp": "07:26:55", "text": "有多大？ 19.8 GB。"}, {"type": "subtitle", "time": 26818.468, "timestamp": "07:26:58", "text": "速度怎么样？似乎只有"}]
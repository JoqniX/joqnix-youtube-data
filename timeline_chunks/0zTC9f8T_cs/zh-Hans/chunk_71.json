[{"type": "subtitle", "time": 4261.83, "timestamp": "01:11:01", "text": "妈的。哦，不。我在水里。我是"}, {"type": "subtitle", "time": 4264.51, "timestamp": "01:11:04", "text": "水下。我在水下。哦"}, {"type": "subtitle", "time": 4268.31, "timestamp": "01:11:08", "text": "不。等待。我该怎么办？我该在哪里坠机"}, {"type": "subtitle", "time": 4272.31, "timestamp": "01:11:12", "text": "下马？呃，我把你的飞机弄坏了。到达"}, {"type": "subtitle", "time": 4276.149, "timestamp": "01:11:16", "text": "一片有东西的安全土地。糟糕。"}, {"type": "subtitle", "time": 4278.229, "timestamp": "01:11:18", "text": "哦，不。不，不，不，不，不，不，不，不。"}, {"type": "subtitle", "time": 4280.87, "timestamp": "01:11:20", "text": "等等，我可以把飞机弄坏。你可以"}, {"type": "subtitle", "time": 4284.55, "timestamp": "01:11:24", "text": "打破它。你看，就像这艘船一样。哦好的。"}, {"type": "subtitle", "time": 4288.87, "timestamp": "01:11:28", "text": "好的，等等。我会再去那里。"}, {"type": "subtitle", "time": 4290.39, "timestamp": "01:11:30", "text": "等等，船呢？在哪里？"}, {"type": "subtitle", "time": 4291.99, "timestamp": "01:11:31", "text": "飞机？"}, {"type": "subtitle", "time": 4305.91, "timestamp": "01:11:45", "text": "有。呃，我当时正试图关机"}, {"type": "subtitle", "time": 4309.75, "timestamp": "01:11:49", "text": "引擎，哦，等等。我看到了，哦，我看到了"}, {"type": "subtitle", "time": 4314.27, "timestamp": "01:11:54", "text": "感谢上帝，我们还有一辆迷你车"}]
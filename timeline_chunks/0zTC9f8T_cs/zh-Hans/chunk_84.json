[{"type": "subtitle", "time": 5041.51, "timestamp": "01:24:01", "text": "更像是由我来着陆。我会的"}, {"type": "subtitle", "time": 5044.709, "timestamp": "01:24:04", "text": "起落架。我们需要起落架。"}, {"type": "subtitle", "time": 5048.47, "timestamp": "01:24:08", "text": "是啊，就在哪里？"}, {"type": "subtitle", "time": 5056.629, "timestamp": "01:24:16", "text": "好的。这份清单"}, {"type": "subtitle", "time": 5065.59, "timestamp": "01:24:25", "text": "呃，就像放其他燃料一样，把煤放进去就行了。"}, {"type": "subtitle", "time": 5071.11, "timestamp": "01:24:31", "text": "哦，它不让你访问你的"}, {"type": "subtitle", "time": 5074.91, "timestamp": "01:24:34", "text": "现在玩家的物品栏已更新。不，不，不，不"}, {"type": "subtitle", "time": 5077.35, "timestamp": "01:24:37", "text": "不。对了，你还有个癌症患者。你"}, {"type": "subtitle", "time": 5080.31, "timestamp": "01:24:40", "text": "大炮型号正确吗？哦，你怎么……"}, {"type": "subtitle", "time": 5084.31, "timestamp": "01:24:44", "text": "使用大炮吗？让我看看。点击右键。"}, {"type": "subtitle", "time": 5088.03, "timestamp": "01:24:48", "text": "点击右键。不，并非如此。"}, {"type": "subtitle", "time": 5090.55, "timestamp": "01:24:50", "text": "工作。让我看看。让我看看。你需要"}, {"type": "subtitle", "time": 5096.87, "timestamp": "01:24:56", "text": "控制。"}]
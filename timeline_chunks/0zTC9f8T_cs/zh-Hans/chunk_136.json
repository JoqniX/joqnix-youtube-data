[{"type": "subtitle", "time": 8160.87, "timestamp": "02:16:00", "text": "我希望让她……"}, {"type": "subtitle", "time": 8164.189, "timestamp": "02:16:04", "text": "已经可以让她成为一名网络模特或"}, {"type": "subtitle", "time": 8167.43, "timestamp": "02:16:07", "text": "某种程度上来说，这有点像《我的世界》里的某种东西。我们"}, {"type": "subtitle", "time": 8171.27, "timestamp": "02:16:11", "text": "可以尝试用某种方式建模。"}, {"type": "subtitle", "time": 8173.35, "timestamp": "02:16:13", "text": "哦，太好了。"}, {"type": "subtitle", "time": 8175.83, "timestamp": "02:16:15", "text": "如果那样的话，现在情况会好得多。"}, {"type": "subtitle", "time": 8179.43, "timestamp": "02:16:19", "text": "我们可以像我的香蕉模型一样。"}, {"type": "subtitle", "time": 8181.109, "timestamp": "02:16:21", "text": "模型。她正在谈论这件事。是的。"}, {"type": "subtitle", "time": 8183.03, "timestamp": "02:16:23", "text": "是的。制作一个与你相似的皮肤"}, {"type": "subtitle", "time": 8185.83, "timestamp": "02:16:25", "text": "博博模特。有点像。嗯。"}, {"type": "subtitle", "time": 8188.79, "timestamp": "02:16:28", "text": "但是雷电，雷电很厉害。他是"}, {"type": "subtitle", "time": 8190.03, "timestamp": "02:16:30", "text": "有点像"}, {"type": "subtitle", "time": 8193.19, "timestamp": "02:16:33", "text": "我。我喜欢雷电。"}, {"type": "subtitle", "time": 8196.15, "timestamp": "02:16:36", "text": "先生，您太懒了，不愿意做。住口。"}, {"type": "subtitle", "time": 8199.99, "timestamp": "02:16:39", "text": "不，我真的很喜欢。"}, {"type": "subtitle", "time": 8201.509, "timestamp": "02:16:41", "text": "呃，"}, {"type": "chat", "time": 8202.101, "timestamp": "02:16:42", "author": "@RPGfanatic-i3z", "avatar": "https://yt4.ggpht.com/F9kA73IKR7TCeh1WUg7fNOkjcUJ6lPk8I6j69xenF_vJcjZ4GCnCIeYo88hJF8jUU3OAOsYG=s64-c-k-c0x00ffffff-no-rj", "message": "kya toot raha pyaar se? "}, {"type": "subtitle", "time": 8205.11, "timestamp": "02:16:45", "text": "我在想我们能不能加上……呃，不，"}, {"type": "chat", "time": 8206.759, "timestamp": "02:16:46", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "You are shorter then raiden"}, {"type": "subtitle", "time": 8214.87, "timestamp": "02:16:54", "text": "呃，我们是不是应该加上这个？呃，等等，"}, {"type": "subtitle", "time": 8217.11, "timestamp": "02:16:57", "text": "你见过我的着色器吗？"}]
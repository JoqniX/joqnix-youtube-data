[{"type": "subtitle", "time": 2644.71, "timestamp": "00:44:04", "text": "这里是从同步文件中生成的"}, {"type": "subtitle", "time": 2654.069, "timestamp": "00:44:14", "text": "模组生成是指创建"}, {"type": "subtitle", "time": 2655.91, "timestamp": "00:44:15", "text": "上面有自动打包功能，其中包含"}, {"type": "subtitle", "time": 2658.63, "timestamp": "00:44:18", "text": "每个文件的元数据"}, {"type": "subtitle", "time": 2660.23, "timestamp": "00:44:20", "text": "模。你不应该触碰这个文件"}, {"type": "subtitle", "time": 2664.829, "timestamp": "00:44:24", "text": "手动操作。我摸了它。对不起。"}, {"type": "subtitle", "time": 2669.109, "timestamp": "00:44:29", "text": "哦，我摸过了。我需要移除两个"}, {"type": "subtitle", "time": 2670.87, "timestamp": "00:44:30", "text": "模组。"}, {"type": "subtitle", "time": 2674.15, "timestamp": "00:44:34", "text": "什么？你要移除哪个？呃"}, {"type": "subtitle", "time": 2675.99, "timestamp": "00:44:35", "text": "就像我最近发给你的那张一样，"}, {"type": "subtitle", "time": 2678.39, "timestamp": "00:44:38", "text": "正确的？实体纹理呃特征和"}, {"type": "subtitle", "time": 2680.87, "timestamp": "00:44:40", "text": "实体模型特性。"}, {"type": "subtitle", "time": 2683.91, "timestamp": "00:44:43", "text": "哦，你不想那样吗？是的，因为"}, {"type": "subtitle", "time": 2685.829, "timestamp": "00:44:45", "text": "它干扰了其他一些东西。"}, {"type": "subtitle", "time": 2687.829, "timestamp": "00:44:47", "text": "更好的动画模组"}]
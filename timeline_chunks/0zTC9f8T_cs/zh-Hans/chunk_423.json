[{"type": "subtitle", "time": 25381.23, "timestamp": "07:03:01", "text": "如果没有工具使新用户能够获取"}, {"type": "subtitle", "time": 25383.51, "timestamp": "07:03:03", "text": "燧石。还有一些新增内容"}, {"type": "subtitle", "time": 25386.07, "timestamp": "07:03:06", "text": "变化。好的。木材香草配方"}, {"type": "subtitle", "time": 25388.59, "timestamp": "07:03:08", "text": "石头一直是"}, {"type": "subtitle", "time": 25391.43, "timestamp": "07:03:11", "text": "已移除。香草篝火食谱有"}, {"type": "subtitle", "time": 25394.35, "timestamp": "07:03:14", "text": "曾经使用过火"}, {"type": "subtitle", "time": 25397.67, "timestamp": "07:03:17", "text": "起动机。陶器可以被创造出来"}, {"type": "subtitle", "time": 25400.868, "timestamp": "07:03:20", "text": "黏土工具。刀具是……中的一种新工具"}, {"type": "subtitle", "time": 25403.43, "timestamp": "07:03:23", "text": "普通工具材料。你可以使用罐"}, {"type": "subtitle", "time": 25406.708, "timestamp": "07:03:26", "text": "可用作弱剑。哦，因为木头是"}, {"type": "subtitle", "time": 25408.59, "timestamp": "07:03:28", "text": "不是"}, {"type": "subtitle", "time": 25413.27, "timestamp": "07:03:33", "text": "那里。好的。刀子不好使。好的。看到一个"}, {"type": "subtitle", "time": 25417.708, "timestamp": "07:03:37", "text": "斧头的弱化版。哦，这样你的"}, {"type": "subtitle", "time": 25420.91, "timestamp": "07:03:40", "text": "基本工具"}, {"type": "subtitle", "time": 25423.75, "timestamp": "07:03:43", "text": "疯锁是终极全能型"}, {"type": "subtitle", "time": 25425.99, "timestamp": "07:03:45", "text": "工具。他们可以像挖矿一样挖矿。"}, {"type": "subtitle", "time": 25426.83, "timestamp": "07:03:46", "text": "有一个"}, {"type": "subtitle", "time": 25430.468, "timestamp": "07:03:50", "text": "铲子、斧子、锄头和剥木器"}, {"type": "subtitle", "time": 25435.19, "timestamp": "07:03:55", "text": "像斧头一样。该死。"}, {"type": "subtitle", "time": 25438.39, "timestamp": "07:03:58", "text": "不要用棍子打树。禁止砍伐森林。"}]
[{"type": "subtitle", "time": 16261.59, "timestamp": "04:31:01", "text": "此外，这种补充铁剂并没有说明它是如何增强铁的。"}, {"type": "subtitle", "time": 16263.71, "timestamp": "04:31:03", "text": "矿石将开始组装这个"}, {"type": "subtitle", "time": 16266.149, "timestamp": "04:31:06", "text": "演示输入输出插槽"}, {"type": "subtitle", "time": 16267.87, "timestamp": "04:31:07", "text": "保持完全"}, {"type": "subtitle", "time": 16270.55, "timestamp": "04:31:10", "text": "功能性的。自动分割功能输入"}, {"type": "subtitle", "time": 16273.389, "timestamp": "04:31:13", "text": "输出插槽保持完全"}, {"type": "subtitle", "time": 16275.91, "timestamp": "04:31:15", "text": "功能性的。自动分割功能"}, {"type": "subtitle", "time": 16277.51, "timestamp": "04:31:17", "text": "使数量相等"}, {"type": "subtitle", "time": 16279.51, "timestamp": "04:31:19", "text": "分配给"}, {"type": "subtitle", "time": 16281.55, "timestamp": "04:31:21", "text": "输入和输出"}, {"type": "subtitle", "time": 16283.67, "timestamp": "04:31:23", "text": "老虎机。现在让我们来看看……"}, {"type": "subtitle", "time": 16285.83, "timestamp": "04:31:25", "text": "其他增强，生成器增强。"}, {"type": "subtitle", "time": 16287.59, "timestamp": "04:31:27", "text": "其中一座炼铁炉是普通的"}, {"type": "subtitle", "time": 16289.189, "timestamp": "04:31:29", "text": "炼铁炉。另一个有一个"}, {"type": "subtitle", "time": 16290.79, "timestamp": "04:31:30", "text": "爆破强化。我可以把它们转换"}, {"type": "subtitle", "time": 16292.469, "timestamp": "04:31:32", "text": "两者都通过使用以下方式进入发电机："}, {"type": "subtitle", "time": 16295.67, "timestamp": "04:31:35", "text": "发电机"}]
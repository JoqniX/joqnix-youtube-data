[{"type": "subtitle", "time": 3900.309, "timestamp": "01:05:00", "text": "按住 W 键"}, {"type": "subtitle", "time": 3902.029, "timestamp": "01:05:02", "text": "并切换方向"}, {"type": "subtitle", "time": 3907.589, "timestamp": "01:05:07", "text": "向上。是的。换挡换挡换挡"}, {"type": "subtitle", "time": 3910.549, "timestamp": "01:05:10", "text": "以及 WD。你知道那种老套路。我"}, {"type": "subtitle", "time": 3915.43, "timestamp": "01:05:15", "text": "必须按住 W 键。不，不。等等，等等"}, {"type": "subtitle", "time": 3918.349, "timestamp": "01:05:18", "text": "空间。不，不，不。离开"}, {"type": "subtitle", "time": 3923.349, "timestamp": "01:05:23", "text": "空间。不，就是公元8年。明白了。知道了。"}, {"type": "subtitle", "time": 3925.109, "timestamp": "01:05:25", "text": "等等，你得打开雾机。这就是原因"}, {"type": "subtitle", "time": 3928.39, "timestamp": "01:05:28", "text": "你可以按 Esc 键。"}, {"type": "subtitle", "time": 3932.47, "timestamp": "01:05:32", "text": "呃，跳过。呃，逃脱选项。"}, {"type": "subtitle", "time": 3935.349, "timestamp": "01:05:35", "text": "是的，我要去拜访。"}, {"type": "subtitle", "time": 3937.99, "timestamp": "01:05:37", "text": "云雾。关掉就行了。这是"}, {"type": "subtitle", "time": 3940.789, "timestamp": "01:05:40", "text": "离开。云层散去了。"}, {"type": "subtitle", "time": 3943.39, "timestamp": "01:05:43", "text": "多雾路段。在哪里？"}, {"type": "subtitle", "time": 3946.349, "timestamp": "01:05:46", "text": "多雾路段？呃，"}, {"type": "subtitle", "time": 3949.75, "timestamp": "01:05:49", "text": "粒子。雾在哪里？应该有"}]
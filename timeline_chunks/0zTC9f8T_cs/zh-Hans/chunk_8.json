[{"type": "subtitle", "time": 489.83, "timestamp": "00:08:09", "text": "所以他们就买了"}, {"type": "subtitle", "time": 493.35, "timestamp": "00:08:13", "text": "购买并抽取角色，看看效果如何"}, {"type": "subtitle", "time": 496.23, "timestamp": "00:08:16", "text": "六套，得到六份副本"}, {"type": "subtitle", "time": 499.029, "timestamp": "00:08:19", "text": "性格坚韧，强大有力，能够造成破坏"}, {"type": "subtitle", "time": 499.95, "timestamp": "00:08:19", "text": "报告"}, {"type": "subtitle", "time": 502.95, "timestamp": "00:08:22", "text": "一切都经过分析，然后他们就走了"}, {"type": "subtitle", "time": 505.67, "timestamp": "00:08:25", "text": "我搞不懂扭蛋游戏里的数学原理。"}, {"type": "subtitle", "time": 508.39, "timestamp": "00:08:28", "text": "它"}, {"type": "subtitle", "time": 511.189, "timestamp": "00:08:31", "text": "但你需要，你需要努力"}, {"type": "subtitle", "time": 514.389, "timestamp": "00:08:34", "text": "你需要研磨，要研磨很多次，是的。"}, {"type": "subtitle", "time": 517.269, "timestamp": "00:08:37", "text": "猜猜我最终弄明白了什么"}, {"type": "subtitle", "time": 520.23, "timestamp": "00:08:40", "text": "添加最佳动画模式的方法"}, {"type": "subtitle", "time": 523.829, "timestamp": "00:08:43", "text": "曾经在服务器上为 Minecraft 制作过的游戏。哦，"}, {"type": "subtitle", "time": 526.07, "timestamp": "00:08:46", "text": "好的。等等，我这就发给你们。"}, {"type": "subtitle", "time": 527.67, "timestamp": "00:08:47", "text": "这里有一个资源包，而且有两个"}, {"type": "subtitle", "time": 529.67, "timestamp": "00:08:49", "text": "模组。"}, {"type": "subtitle", "time": 532.71, "timestamp": "00:08:52", "text": "另外，还要加上我刚刚添加的自动修改功能。"}, {"type": "subtitle", "time": 534.23, "timestamp": "00:08:54", "text": "发送。"}, {"type": "subtitle", "time": 536.389, "timestamp": "00:08:56", "text": "等等，那是什么？它是服务器端吗？"}, {"type": "subtitle", "time": 539.91, "timestamp": "00:08:59", "text": "模组？服务器端和客户端。"}]
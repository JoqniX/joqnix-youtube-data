[{"type": "subtitle", "time": 7923.35, "timestamp": "02:12:03", "text": "呃，我们所有人都以星座的形式存在"}, {"type": "subtitle", "time": 7926.39, "timestamp": "02:12:06", "text": "加上音乐元素，是的，已经添加了。"}, {"type": "subtitle", "time": 7931.35, "timestamp": "02:12:11", "text": "是添加它，嗯，我正在尝试找到它"}, {"type": "subtitle", "time": 7933.79, "timestamp": "02:12:13", "text": "嗯，它不在这里。"}, {"type": "subtitle", "time": 7937.95, "timestamp": "02:12:17", "text": "是不是我拼写错误了？"}, {"type": "subtitle", "time": 7958.069, "timestamp": "02:12:38", "text": "出血量虽然不少，但有点……"}, {"type": "subtitle", "time": 7963.75, "timestamp": "02:12:43", "text": "疼。你的整个指甲都掉了。"}, {"type": "subtitle", "time": 7974.43, "timestamp": "02:12:54", "text": "不是"}, {"type": "subtitle", "time": 7979.629, "timestamp": "02:12:59", "text": "曾是"}]
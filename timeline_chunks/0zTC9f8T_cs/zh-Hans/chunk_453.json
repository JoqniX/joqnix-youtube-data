[{"type": "subtitle", "time": 27184.548, "timestamp": "07:33:04", "text": "哦，没有印度服务器。孟买"}, {"type": "subtitle", "time": 27186.948, "timestamp": "07:33:06", "text": "服务器。你认为会有吗？"}, {"type": "subtitle", "time": 27188.548, "timestamp": "07:33:08", "text": "印度服务器？好好想想。但"}, {"type": "subtitle", "time": 27191.11, "timestamp": "07:33:11", "text": "好好想想再回答我。我"}, {"type": "subtitle", "time": 27193.27, "timestamp": "07:33:13", "text": "我不想听起来像个好人"}, {"type": "subtitle", "time": 27196.548, "timestamp": "07:33:16", "text": "居高临下。但是，呃，瓦莱林有一个"}, {"type": "subtitle", "time": 27199.27, "timestamp": "07:33:19", "text": "印度服务器。所以我就想，“想想"}, {"type": "subtitle", "time": 27200.35, "timestamp": "07:33:20", "text": "关于"}, {"type": "subtitle", "time": 27201.868, "timestamp": "07:33:21", "text": "它。"}, {"type": "subtitle", "time": 27204.67, "timestamp": "07:33:24", "text": "绝不"}, {"type": "subtitle", "time": 27208.43, "timestamp": "07:33:28", "text": "手表。兵不能越过"}, {"type": "subtitle", "time": 27218.75, "timestamp": "07:33:38", "text": "他们只是看着雷娜，然后……"}, {"type": "subtitle", "time": 27221.67, "timestamp": "07:33:41", "text": "比如，“为什么富士科技是那样的？”"}, {"type": "subtitle", "time": 27224.548, "timestamp": "07:33:44", "text": "你不能留住我吗？呃，你必须这么做。"}, {"type": "subtitle", "time": 27227.83, "timestamp": "07:33:47", "text": "从你那边操作。"}, {"type": "subtitle", "time": 27229.59, "timestamp": "07:33:49", "text": "等等，我给你看一张图片。难道我不是吗？"}, {"type": "subtitle", "time": 27232.868, "timestamp": "07:33:52", "text": "不给你图片？不。呃，你你"}, {"type": "subtitle", "time": 27235.59, "timestamp": "07:33:55", "text": "必须改成“我没有”或“我没有”。"}, {"type": "subtitle", "time": 27237.43, "timestamp": "07:33:57", "text": "我的屏幕上有一个模型。该死的。"}, {"type": "subtitle", "time": 27238.67, "timestamp": "07:33:58", "text": "告诉我，"}]
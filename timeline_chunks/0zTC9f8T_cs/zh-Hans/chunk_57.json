[{"type": "subtitle", "time": 3434.789, "timestamp": "00:57:14", "text": "嗯。为什么马匹模组包的路径这么长？"}, {"type": "subtitle", "time": 3441.91, "timestamp": "00:57:21", "text": "好的。这个模组会更新其他模组吗？"}, {"type": "subtitle", "time": 3443.71, "timestamp": "00:57:23", "text": "不，全是"}, {"type": "subtitle", "time": 3446.549, "timestamp": "00:57:26", "text": "拉屎。这个模组只同步一个"}, {"type": "subtitle", "time": 3448.789, "timestamp": "00:57:28", "text": "服务器模组包到客户端。哦，所以"}, {"type": "subtitle", "time": 3452.23, "timestamp": "00:57:32", "text": "从某种意义上说，我们应该更新……"}, {"type": "subtitle", "time": 3455.589, "timestamp": "00:57:35", "text": "其他模组包，例如添加更新后的模组。"}, {"type": "subtitle", "time": 3456.829, "timestamp": "00:57:36", "text": "在"}, {"type": "subtitle", "time": 3462.47, "timestamp": "00:57:42", "text": "服务器模组包。所以它是 G，所以每个"}, {"type": "subtitle", "time": 3465.47, "timestamp": "00:57:45", "text": "玩家获得了最新的模组"}, {"type": "subtitle", "time": 3469.43, "timestamp": "00:57:49", "text": "盒。呃"}, {"type": "subtitle", "time": 3472.95, "timestamp": "00:57:52", "text": "真麻烦。嗯，没关系。那里"}, {"type": "subtitle", "time": 3474.789, "timestamp": "00:57:54", "text": "是否有办法更新"}, {"type": "subtitle", "time": 3477.63, "timestamp": "00:57:57", "text": "它。"}]
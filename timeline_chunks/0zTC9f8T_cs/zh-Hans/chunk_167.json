[{"type": "subtitle", "time": 10020.07, "timestamp": "02:47:00", "text": "是啊，这些建筑看起来真棒。"}, {"type": "subtitle", "time": 10021.91, "timestamp": "02:47:01", "text": "我觉得会让人不知所措。绝不"}, {"type": "subtitle", "time": 10028.07, "timestamp": "02:47:08", "text": "但让我先把那本灵书做出来。"}, {"type": "subtitle", "time": 10076.55, "timestamp": "02:47:56", "text": "你知道吗？我们来看看模组。"}, {"type": "subtitle", "time": 10079.349, "timestamp": "02:47:59", "text": "我们添加了，让我们停止它。但它是"}]
[{"type": "subtitle", "time": 4987.189, "timestamp": "01:23:07", "text": "军舰。你能放一些吗？"}, {"type": "subtitle", "time": 4990.629, "timestamp": "01:23:10", "text": "好的，给它加个升级装置"}, {"type": "subtitle", "time": 4993.75, "timestamp": "01:23:13", "text": "首先是墙上的箱子。出来。来"}, {"type": "subtitle", "time": 4996.87, "timestamp": "01:23:16", "text": "出去。给我染料。给我染料。任何"}, {"type": "subtitle", "time": 5000.47, "timestamp": "01:23:20", "text": "你想要的颜色。给我三叠"}, {"type": "subtitle", "time": 5003.669, "timestamp": "01:23:23", "text": "煤块。"}, {"type": "subtitle", "time": 5006.03, "timestamp": "01:23:26", "text": "好的，我会给你一个"}, {"type": "subtitle", "time": 5010.59, "timestamp": "01:23:30", "text": "像胸膛一样死去，在的"}, {"type": "subtitle", "time": 5014.629, "timestamp": "01:23:34", "text": "弄艘战舰，再弄点TNT炸药，我"}, {"type": "subtitle", "time": 5019.55, "timestamp": "01:23:39", "text": "猜测。所以，染料和TNT，对吧？死，"}, {"type": "subtitle", "time": 5021.149, "timestamp": "01:23:41", "text": "TNT，"}, {"type": "subtitle", "time": 5023.75, "timestamp": "01:23:43", "text": "呃，还有一种升级之类的东西"}, {"type": "subtitle", "time": 5026.55, "timestamp": "01:23:46", "text": "任何你认为有效的方法。"}, {"type": "subtitle", "time": 5028.87, "timestamp": "01:23:48", "text": "我有工业齿轮。我没有下界"}, {"type": "subtitle", "time": 5031.83, "timestamp": "01:23:51", "text": "引擎。我有螺旋桨。我有Steam。"}, {"type": "subtitle", "time": 5035.35, "timestamp": "01:23:55", "text": "锅炉。我经久耐用。我需要像我"}, {"type": "subtitle", "time": 5038.11, "timestamp": "01:23:58", "text": "需要增援。我需要一些东西"}]
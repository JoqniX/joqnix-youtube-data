[{"type": "subtitle", "time": 4545.75, "timestamp": "01:15:45", "text": "おお、いいね。ああ、それでうまくいくんですね。モッド"}, {"type": "subtitle", "time": 4550.149, "timestamp": "01:15:50", "text": "戻る。何てことだ。さあ行こう。さあ行こう。"}, {"type": "subtitle", "time": 4555.35, "timestamp": "01:15:55", "text": "こんにちは。どうやってここから抜け出せばいいですか？"}, {"type": "subtitle", "time": 4558.39, "timestamp": "01:15:58", "text": "それにはショートカットキーを確認する必要があります。"}]
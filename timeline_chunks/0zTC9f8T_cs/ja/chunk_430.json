[{"type": "subtitle", "time": 25800.788, "timestamp": "07:10:00", "text": "例えば、もっと安い矢とか、その他諸々。"}, {"type": "subtitle", "time": 25803.788, "timestamp": "07:10:03", "text": "それで、それがどうなるか見て、"}, {"type": "subtitle", "time": 25806.948, "timestamp": "07:10:06", "text": "初期の戦闘のためのすべて"}, {"type": "subtitle", "time": 25807.948, "timestamp": "07:10:07", "text": "そして"}, {"type": "subtitle", "time": 25810.67, "timestamp": "07:10:10", "text": "ああ、必要だったんだ"}, {"type": "subtitle", "time": 25814.708, "timestamp": "07:10:14", "text": "何かあるか聞いてください。私は必要ない"}, {"type": "subtitle", "time": 25816.75, "timestamp": "07:10:16", "text": "そんな風にモードを見た"}, {"type": "subtitle", "time": 25819.91, "timestamp": "07:10:19", "text": "死んだら、"}, {"type": "subtitle", "time": 25825.628, "timestamp": "07:10:25", "text": "ああ、でもあなたは失うでしょう"}, {"type": "subtitle", "time": 25828.03, "timestamp": "07:10:28", "text": "アイテム。あなたが持っている"}, {"type": "subtitle", "time": 25831.11, "timestamp": "07:10:31", "text": "あなたには戻るチャンスがあり、"}, {"type": "subtitle", "time": 25834.948, "timestamp": "07:10:34", "text": "戦ってアイテムを取り戻せ、だが"}, {"type": "subtitle", "time": 25838.83, "timestamp": "07:10:38", "text": "最後に亡くなった。つまり、少なくとも鎧は持っているということだ。"}, {"type": "subtitle", "time": 25841.19, "timestamp": "07:10:41", "text": "今。そういう類のことです。私は感じます"}, {"type": "subtitle", "time": 25849.59, "timestamp": "07:10:49", "text": "多くの。でも、それは良いことだよ。の"}, {"type": "subtitle", "time": 25851.91, "timestamp": "07:10:51", "text": "潜水艦みたいなもの、"}, {"type": "subtitle", "time": 25854.708, "timestamp": "07:10:54", "text": "出て行け。何？夏モードがありました。"}]
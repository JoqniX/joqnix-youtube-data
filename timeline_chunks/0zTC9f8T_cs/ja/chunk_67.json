[{"type": "subtitle", "time": 4021.51, "timestamp": "01:07:01", "text": "男。ウォーターモードにできますか？ああ、私は"}, {"type": "subtitle", "time": 4022.91, "timestamp": "01:07:02", "text": "飛行機。その"}, {"type": "subtitle", "time": 4025.75, "timestamp": "01:07:05", "text": "大丈夫。損傷なし。あ、待って。そうです"}, {"type": "subtitle", "time": 4028.47, "timestamp": "01:07:08", "text": "無限の寿命を持つ？"}, {"type": "subtitle", "time": 4038.87, "timestamp": "01:07:18", "text": "えっと、待って、どこにいるの？私は赤を見つけた"}, {"type": "subtitle", "time": 4041.43, "timestamp": "01:07:21", "text": "海賊船。"}, {"type": "subtitle", "time": 4044.309, "timestamp": "01:07:24", "text": "待って、君は待って、君はどこにいるの？えっと、"}, {"type": "subtitle", "time": 4046.43, "timestamp": "01:07:26", "text": "見ることができますか"}, {"type": "subtitle", "time": 4049.43, "timestamp": "01:07:29", "text": "558？ 1秒。ごめん。私にさせて"}, {"type": "subtitle", "time": 4054.75, "timestamp": "01:07:34", "text": "ウェイポイントを赤から赤で作成する"}, {"type": "subtitle", "time": 4058.75, "timestamp": "01:07:38", "text": "船。カードを受け取りました。"}, {"type": "subtitle", "time": 4062.15, "timestamp": "01:07:42", "text": "えっと、この場所"}, {"type": "subtitle", "time": 4065.91, "timestamp": "01:07:45", "text": "チャットで共有ポイントを共有します。あ、待って、それは"}, {"type": "subtitle", "time": 4068.43, "timestamp": "01:07:48", "text": "言わない"}, {"type": "subtitle", "time": 4071.91, "timestamp": "01:07:51", "text": "えーと595。"}, {"type": "subtitle", "time": 4073.99, "timestamp": "01:07:53", "text": "595."}, {"type": "subtitle", "time": 4076.63, "timestamp": "01:07:56", "text": "うん。"}]
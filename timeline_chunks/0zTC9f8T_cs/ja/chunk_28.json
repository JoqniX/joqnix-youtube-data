[{"type": "subtitle", "time": 1687.59, "timestamp": "00:28:07", "text": "今の私には、それほど頭が良くないんです。"}, {"type": "subtitle", "time": 1689.51, "timestamp": "00:28:09", "text": "わかりました、ある程度のアクセス権を付与します。あなた"}, {"type": "subtitle", "time": 1692.63, "timestamp": "00:28:12", "text": "何だと思う？待って。わかった、"}, {"type": "subtitle", "time": 1694.669, "timestamp": "00:28:14", "text": "やってみて。"}, {"type": "subtitle", "time": 1698.07, "timestamp": "00:28:18", "text": "わかった。 URLは何ですか？"}, {"type": "subtitle", "time": 1699.99, "timestamp": "00:28:19", "text": "うん。えっと、メールを送ってください。できますか？"}, {"type": "subtitle", "time": 1703.51, "timestamp": "00:28:23", "text": "待って？同じメールですか？うん。うん。"}, {"type": "subtitle", "time": 1710.269, "timestamp": "00:28:30", "text": "そこには"}, {"type": "subtitle", "time": 1713.31, "timestamp": "00:28:33", "text": "1つ。そのサイトはどこだったっけ？スパーク、"}, {"type": "subtitle", "time": 1716.789, "timestamp": "00:28:36", "text": "右？ Sparkホスト。"}, {"type": "subtitle", "time": 1718.51, "timestamp": "00:28:38", "text": "メールが届きます、"}, {"type": "subtitle", "time": 1722.23, "timestamp": "00:28:42", "text": "ミッションから推測する。うん。わかった。私"}]
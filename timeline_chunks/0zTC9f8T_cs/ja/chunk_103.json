[{"type": "subtitle", "time": 6181.87, "timestamp": "01:43:01", "text": "クリック。右に進み続けてください"}, {"type": "subtitle", "time": 6183.95, "timestamp": "01:43:03", "text": "クリック"}, {"type": "subtitle", "time": 6187.03, "timestamp": "01:43:07", "text": "どうやら。でも、どんなアイテムを使って"}, {"type": "subtitle", "time": 6188.55, "timestamp": "01:43:08", "text": "修理？"}, {"type": "subtitle", "time": 6191.99, "timestamp": "01:43:11", "text": "そうかもしれないね。バッテリーをお見せします。"}, {"type": "subtitle", "time": 6195.35, "timestamp": "01:43:15", "text": "ああ、チャットストリームが見えない。もちろん。"}, {"type": "subtitle", "time": 6198.39, "timestamp": "01:43:18", "text": "どうですか？はい、どうぞ。"}, {"type": "subtitle", "time": 6208.59, "timestamp": "01:43:28", "text": "ちょっと待って。今はできない。"}, {"type": "subtitle", "time": 6217.51, "timestamp": "01:43:37", "text": "同じ。まあ、待ってみるか。わかった、そうしよう"}]
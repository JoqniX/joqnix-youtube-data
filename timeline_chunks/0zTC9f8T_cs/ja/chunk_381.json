[{"type": "subtitle", "time": 22867.47, "timestamp": "06:21:07", "text": "石炭。ほら、３つ点灯してる"}, {"type": "subtitle", "time": 22872.03, "timestamp": "06:21:12", "text": "上。それらはすべて同じ量の"}, {"type": "subtitle", "time": 22874.67, "timestamp": "06:21:14", "text": "熱。一人の力"}, {"type": "subtitle", "time": 22877.31, "timestamp": "06:21:17", "text": "石炭。あなたが"}, {"type": "subtitle", "time": 22889.83, "timestamp": "06:21:29", "text": "ええ、それらはすべて同じになります"}, {"type": "subtitle", "time": 22902.868, "timestamp": "06:21:42", "text": "右。複数のものを追加できます"}, {"type": "subtitle", "time": 22906.15, "timestamp": "06:21:46", "text": "そしてあなたはこう思うでしょう。「やった、もっと速く。私は"}, {"type": "subtitle", "time": 22916.708, "timestamp": "06:21:56", "text": "鉄。そして私は、私は、私は、私は、"}]
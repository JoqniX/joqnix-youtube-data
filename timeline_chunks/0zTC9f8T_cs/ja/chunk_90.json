[{"type": "subtitle", "time": 5400.709, "timestamp": "01:30:00", "text": "わからない。私はどこかにいる。"}, {"type": "subtitle", "time": 5404.07, "timestamp": "01:30:04", "text": "うん。戻ってくる。"}, {"type": "subtitle", "time": 5407.43, "timestamp": "01:30:07", "text": "どこ？そうそう。彼女はそこにいる。"}, {"type": "subtitle", "time": 5416.31, "timestamp": "01:30:16", "text": "停止。水上には着陸できません。"}, {"type": "subtitle", "time": 5419.669, "timestamp": "01:30:19", "text": "彼女は飛び降りなければならない。"}, {"type": "subtitle", "time": 5432.11, "timestamp": "01:30:32", "text": "おお。私はジャンプして右"}, {"type": "subtitle", "time": 5456.149, "timestamp": "01:30:56", "text": "この動画を見逃してしまった。"}]
[{"type": "subtitle", "time": 1382.789, "timestamp": "00:23:02", "text": "はい、モッドを再生成することを忘れないでください"}, {"type": "subtitle", "time": 1386.75, "timestamp": "00:23:06", "text": "スラッシュを使用してパックします。automo generate。"}, {"type": "subtitle", "time": 1402.39, "timestamp": "00:23:22", "text": "設定サーバーは専用モードを提供しますか？"}, {"type": "subtitle", "time": 1405.35, "timestamp": "00:23:25", "text": "真実。自動モード。わかった。専用をクリック"}, {"type": "subtitle", "time": 1407.31, "timestamp": "00:23:27", "text": "自動"}, {"type": "subtitle", "time": 1410.63, "timestamp": "00:23:30", "text": "モード。ああ、たとえあなたが持っていなくても"}, {"type": "subtitle", "time": 1413.029, "timestamp": "00:23:33", "text": "オートモードパックでは、"}, {"type": "subtitle", "time": 1416.63, "timestamp": "00:23:36", "text": "サーバーには専用のモードパックがあり、"}, {"type": "subtitle", "time": 1439.35, "timestamp": "00:23:59", "text": "何てことだ。それはとても面倒だろう"}]
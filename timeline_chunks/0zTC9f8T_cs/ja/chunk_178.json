[{"type": "subtitle", "time": 10689.51, "timestamp": "02:58:09", "text": "我々は持っています"}, {"type": "subtitle", "time": 10695.19, "timestamp": "02:58:15", "text": "ミニCって何？選択肢はあります。ああ、"}, {"type": "subtitle", "time": 10698.79, "timestamp": "02:58:18", "text": "神。ほら、うちの犬が変わったでしょ。"}, {"type": "subtitle", "time": 10701.11, "timestamp": "02:58:21", "text": "ほら、私はいくつかの異なるグッド"}, {"type": "subtitle", "time": 10703.67, "timestamp": "02:58:23", "text": "人形を見ている。"}, {"type": "subtitle", "time": 10705.51, "timestamp": "02:58:25", "text": "おお、"}, {"type": "subtitle", "time": 10707.91, "timestamp": "02:58:27", "text": "これらは通常のものですが、"}]
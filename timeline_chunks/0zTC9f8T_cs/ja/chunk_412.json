[{"type": "subtitle", "time": 24720.548, "timestamp": "06:52:00", "text": "これが私のいつものセットアップです。私は手に入れた"}, {"type": "subtitle", "time": 24722.788, "timestamp": "06:52:02", "text": "ナトリウムが設置されました。 Zumifiをインストールしました"}, {"type": "subtitle", "time": 24725.35, "timestamp": "06:52:05", "text": "そしてもちろん、アイリスシェーダーも。これはとても"}, {"type": "subtitle", "time": 24727.43, "timestamp": "06:52:07", "text": "まるで布製のインスタレーション作品のようだ。しかし、すべての"}, {"type": "subtitle", "time": 24729.83, "timestamp": "06:52:09", "text": "ブロックを一度見るだけで"}, {"type": "subtitle", "time": 24731.99, "timestamp": "06:52:11", "text": "そこに小さなポップアップが表示されます"}, {"type": "subtitle", "time": 24733.99, "timestamp": "06:52:13", "text": "一番上。これでMODを使えば解決できる"}, {"type": "subtitle", "time": 24736.948, "timestamp": "06:52:16", "text": "ジェイドと呼ばれています。そして、このMODは確かに"}, {"type": "subtitle", "time": 24738.868, "timestamp": "06:52:18", "text": "布地にも使用可能です。"}, {"type": "subtitle", "time": 24741.03, "timestamp": "06:52:21", "text": "現在、鍛冶場を運営していると申し上げました。"}, {"type": "subtitle", "time": 24742.788, "timestamp": "06:52:22", "text": "バージョン？しかし、それだけではありません。私は"}, {"type": "subtitle", "time": 24744.548, "timestamp": "06:52:24", "text": "また、Minecraft modも実行しています。"}, {"type": "subtitle", "time": 24747.11, "timestamp": "06:52:27", "text": "不死のクラフト可能なトーテムと"}, {"type": "subtitle", "time": 24749.27, "timestamp": "06:52:29", "text": "文字通り不死のトーテムを追加する"}, {"type": "subtitle", "time": 24750.868, "timestamp": "06:52:30", "text": "クラフトレシピ。さて、ここからが面白いところです。"}, {"type": "subtitle", "time": 24753.43, "timestamp": "06:52:33", "text": "このMODについて言えば、これはForgeです"}, {"type": "subtitle", "time": 24756.03, "timestamp": "06:52:36", "text": "エクスクルーシブ。ああ、それで"}, {"type": "subtitle", "time": 24775.708, "timestamp": "06:52:55", "text": "それは何という名前ですか？殺す、"}]
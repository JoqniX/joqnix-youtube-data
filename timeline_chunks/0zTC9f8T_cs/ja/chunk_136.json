[{"type": "subtitle", "time": 8160.87, "timestamp": "02:16:00", "text": "彼女が"}, {"type": "subtitle", "time": 8164.189, "timestamp": "02:16:04", "text": "すでに彼女はチューブモデルになれるか、"}, {"type": "subtitle", "time": 8167.43, "timestamp": "02:16:07", "text": "ある意味、マインクラフトの中にあるもの。私たちは"}, {"type": "subtitle", "time": 8171.27, "timestamp": "02:16:11", "text": "何らかの方法でそれをモデル化してみることもできるだろう。"}, {"type": "subtitle", "time": 8173.35, "timestamp": "02:16:13", "text": "ああ、よかった。"}, {"type": "subtitle", "time": 8175.83, "timestamp": "02:16:15", "text": "そうすれば今の方が良くなるだろう"}, {"type": "subtitle", "time": 8179.43, "timestamp": "02:16:19", "text": "私のバナナモデルに似たもの"}, {"type": "subtitle", "time": 8181.109, "timestamp": "02:16:21", "text": "モデル。彼女はそれについて話している。うん。"}, {"type": "subtitle", "time": 8183.03, "timestamp": "02:16:23", "text": "うん。あなたの肌と似た肌を作る"}, {"type": "subtitle", "time": 8185.83, "timestamp": "02:16:25", "text": "ボーバーモデル。似ているところがある。うん。"}, {"type": "subtitle", "time": 8188.79, "timestamp": "02:16:28", "text": "でも、ライデンは、ライデンは良い人だ。彼は"}, {"type": "subtitle", "time": 8190.03, "timestamp": "02:16:30", "text": "まるで"}, {"type": "subtitle", "time": 8193.19, "timestamp": "02:16:33", "text": "自分。私は雷電が好きです。"}, {"type": "subtitle", "time": 8196.15, "timestamp": "02:16:36", "text": "あなたはそれを作るのが面倒くさいんですね。黙れ。"}, {"type": "subtitle", "time": 8199.99, "timestamp": "02:16:39", "text": "いいえ、本当に気に入っています。"}, {"type": "subtitle", "time": 8201.509, "timestamp": "02:16:41", "text": "えっと、"}, {"type": "chat", "time": 8202.101, "timestamp": "02:16:42", "author": "@RPGfanatic-i3z", "avatar": "https://yt4.ggpht.com/F9kA73IKR7TCeh1WUg7fNOkjcUJ6lPk8I6j69xenF_vJcjZ4GCnCIeYo88hJF8jUU3OAOsYG=s64-c-k-c0x00ffffff-no-rj", "message": "kya toot raha pyaar se? "}, {"type": "subtitle", "time": 8205.11, "timestamp": "02:16:45", "text": "追加できるかどうか疑問に思っていましたが、いいえ、"}, {"type": "chat", "time": 8206.759, "timestamp": "02:16:46", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "You are shorter then raiden"}, {"type": "subtitle", "time": 8214.87, "timestamp": "02:16:54", "text": "えっと、これを追加した方がいいかな？待って、"}, {"type": "subtitle", "time": 8217.11, "timestamp": "02:16:57", "text": "私のシェーダーを見たことがありますか？"}]
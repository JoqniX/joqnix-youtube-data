[{"type": "subtitle", "time": 10769.19, "timestamp": "02:59:29", "text": "ああ、これは本当に私を"}, {"type": "subtitle", "time": 10771.99, "timestamp": "02:59:31", "text": "本物のウクレレのように演奏します。何てことだ、"}, {"type": "subtitle", "time": 10775.309, "timestamp": "02:59:35", "text": "これは本当に美味しい。"}, {"type": "subtitle", "time": 10778.469, "timestamp": "02:59:38", "text": "ニース。これで満足ですか？"}, {"type": "subtitle", "time": 10781.429, "timestamp": "02:59:41", "text": "ええ、今はとても幸せです。これはとても"}]
[{"type": "subtitle", "time": 1261.909, "timestamp": "00:21:01", "text": "側。いや、私は若者のより良い結末を見ている"}, {"type": "subtitle", "time": 1264.51, "timestamp": "00:21:04", "text": "島エンティティのテクスチャ。"}, {"type": "subtitle", "time": 1266.35, "timestamp": "00:21:06", "text": "何？"}, {"type": "subtitle", "time": 1271.51, "timestamp": "00:21:11", "text": "どんな生地ですか？それから肌修復剤"}, {"type": "subtitle", "time": 1284.39, "timestamp": "00:21:24", "text": "うん。ええと、私がそれを見ると、"}, {"type": "subtitle", "time": 1287.669, "timestamp": "00:21:27", "text": "クライアントのほとんどをダウンロードしてもサーバーは不要です"}, {"type": "subtitle", "time": 1290.149, "timestamp": "00:21:30", "text": "航空機のようなサイドアイテムは"}, {"type": "subtitle", "time": 1293.43, "timestamp": "00:21:33", "text": "そこには。待って、待って。ああ、2つ必要だよ"}, {"type": "subtitle", "time": 1296.149, "timestamp": "00:21:36", "text": "互換性MOD。待って、送信中"}, {"type": "subtitle", "time": 1297.549, "timestamp": "00:21:37", "text": "あなたたち二人も"}, {"type": "subtitle", "time": 1301.43, "timestamp": "00:21:41", "text": "モッズ。約束。"}, {"type": "subtitle", "time": 1303.83, "timestamp": "00:21:43", "text": "これはサーバーモードのようなものです。さあ、それを手に入れよう"}, {"type": "subtitle", "time": 1312.31, "timestamp": "00:21:52", "text": "待って、それはもう入れておかないといけない。"}, {"type": "subtitle", "time": 1315.59, "timestamp": "00:21:55", "text": "自動改造パックを1つ追加する必要があります。"}, {"type": "subtitle", "time": 1317.909, "timestamp": "00:21:57", "text": "私はそれをします"}, {"type": "subtitle", "time": 1319.59, "timestamp": "00:21:59", "text": "ええと、それはサーバー上にあるからです。そうではありません"}]
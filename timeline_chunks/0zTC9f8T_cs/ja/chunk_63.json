[{"type": "subtitle", "time": 3791.03, "timestamp": "01:03:11", "text": "滑走路？ただ"}, {"type": "subtitle", "time": 3792.91, "timestamp": "01:03:12", "text": "はい、参加します"}, {"type": "subtitle", "time": 3795.39, "timestamp": "01:03:15", "text": "ここ。おお"}, {"type": "subtitle", "time": 3797.309, "timestamp": "01:03:17", "text": "私の"}, {"type": "subtitle", "time": 3800.789, "timestamp": "01:03:20", "text": "それは何ですか？お皿？"}, {"type": "subtitle", "time": 3803.23, "timestamp": "01:03:23", "text": "ああ、そうだよ。"}, {"type": "subtitle", "time": 3810.87, "timestamp": "01:03:30", "text": "ええ、ただ回すだけです。回転させるのが好きです"}, {"type": "subtitle", "time": 3813.829, "timestamp": "01:03:33", "text": "WDより。"}, {"type": "subtitle", "time": 3817.43, "timestamp": "01:03:37", "text": "はい、ではシフトキーとWキーを同時に押してください。"}, {"type": "subtitle", "time": 3820.71, "timestamp": "01:03:40", "text": "その中にはほとんどいない。シフト。いや、いや、いや、いや、いや。 W"}, {"type": "subtitle", "time": 3822.39, "timestamp": "01:03:42", "text": "そしてスペースキー。スペースキー。スペースキー。"}, {"type": "subtitle", "time": 3831.75, "timestamp": "01:03:51", "text": "まずはこれ。シフト。まるで上昇していくように。来る"}]
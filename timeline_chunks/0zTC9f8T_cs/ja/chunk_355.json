[{"type": "subtitle", "time": 21301.83, "timestamp": "05:55:01", "text": "改造は可能です。うん。石炭。"}, {"type": "subtitle", "time": 21305.51, "timestamp": "05:55:05", "text": "うん。うん。問題は、それがあなたに"}, {"type": "subtitle", "time": 21309.19, "timestamp": "05:55:09", "text": "匂いを嗅いで調理する方が今の時期より速い"}, {"type": "subtitle", "time": 21311.19, "timestamp": "05:55:11", "text": "少し時間がかかります"}, {"type": "subtitle", "time": 21314.31, "timestamp": "05:55:14", "text": "もっと早く。ちょっと実験しているところです。"}, {"type": "subtitle", "time": 21317.39, "timestamp": "05:55:17", "text": "なぜこの商品は"}, {"type": "subtitle", "time": 21319.868, "timestamp": "05:55:19", "text": "働く？"}, {"type": "subtitle", "time": 21325.868, "timestamp": "05:55:25", "text": "神。ええと、そうですね、他に何か追加しましたっけ？私"}, {"type": "subtitle", "time": 21329.868, "timestamp": "05:55:29", "text": "忘れた。えっと、確認させてください"}, {"type": "subtitle", "time": 21337.548, "timestamp": "05:55:37", "text": "えっと、もっと強化する"}, {"type": "subtitle", "time": 21339.07, "timestamp": "05:55:39", "text": "あれ。"}, {"type": "subtitle", "time": 21343.07, "timestamp": "05:55:43", "text": "あらら。無制限のストレージが必要ですか？"}, {"type": "subtitle", "time": 21347.27, "timestamp": "05:55:47", "text": "バンドル？だから、えっと、私は"}, {"type": "subtitle", "time": 21348.99, "timestamp": "05:55:48", "text": "調べてみた"}, {"type": "subtitle", "time": 21352.39, "timestamp": "05:55:52", "text": "ここ。無制限ストレージバンドル。私は"}, {"type": "subtitle", "time": 21354.59, "timestamp": "05:55:54", "text": "バンドルを使用しているから考え"}]
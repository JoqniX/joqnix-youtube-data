[{"type": "subtitle", "time": 26761.67, "timestamp": "07:26:01", "text": "方法。それで、ロー、あそこはどうだった？"}, {"type": "subtitle", "time": 26764.788, "timestamp": "07:26:04", "text": "ああ、日。私は、えっと、今起きたばかりなんです。"}, {"type": "subtitle", "time": 26766.468, "timestamp": "07:26:06", "text": "私は早くジムに行く予定だった"}, {"type": "subtitle", "time": 26769.07, "timestamp": "07:26:09", "text": "朝ですが、"}, {"type": "subtitle", "time": 26772.07, "timestamp": "07:26:12", "text": "ない。ああ、私の骨は"}, {"type": "subtitle", "time": 26779.35, "timestamp": "07:26:19", "text": "ただ疲れていただけなんです。冬はご存知の通り"}, {"type": "subtitle", "time": 26782.23, "timestamp": "07:26:22", "text": "決して良い日ではない、決して良い日ではない"}, {"type": "subtitle", "time": 26785.59, "timestamp": "07:26:25", "text": "それが私の考えです。"}, {"type": "subtitle", "time": 26789.51, "timestamp": "07:26:29", "text": "あ、待って。でも、何時に寝たの？"}, {"type": "subtitle", "time": 26791.51, "timestamp": "07:26:31", "text": "昨日？"}, {"type": "subtitle", "time": 26801.15, "timestamp": "07:26:41", "text": "あなたは私に好きになるように言った"}, {"type": "subtitle", "time": 26807.468, "timestamp": "07:26:47", "text": "ああ、やってみて。つまり、朝のような感じ。わかった。"}, {"type": "subtitle", "time": 26811.43, "timestamp": "07:26:51", "text": "うん、待ってるよ。しかし、どれくらいの規模なのか？"}, {"type": "subtitle", "time": 26815.51, "timestamp": "07:26:55", "text": "どれくらいの大きさですか？ 19.8 GB。"}, {"type": "subtitle", "time": 26818.468, "timestamp": "07:26:58", "text": "スピードはどうですか？どうやらそれは"}]
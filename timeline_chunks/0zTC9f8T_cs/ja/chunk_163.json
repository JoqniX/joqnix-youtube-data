[{"type": "subtitle", "time": 9786.71, "timestamp": "02:43:06", "text": "引き出し。私も楽器が欲しいです。"}, {"type": "subtitle", "time": 9789.95, "timestamp": "02:43:09", "text": "うん、できるよ。いいえ"}, {"type": "subtitle", "time": 9792.07, "timestamp": "02:43:12", "text": "心配事。楽器を動かさないでください"}, {"type": "subtitle", "time": 9830.63, "timestamp": "02:43:50", "text": "とりあえず行って探検してみようかな？"}, {"type": "subtitle", "time": 9838.15, "timestamp": "02:43:58", "text": "これは君が反対するべきだ。こんな感じ"}]
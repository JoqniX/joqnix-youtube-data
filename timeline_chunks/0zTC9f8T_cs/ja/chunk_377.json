[{"type": "subtitle", "time": 22621.35, "timestamp": "06:17:01", "text": "調理用ではない食品、製錬用食品"}, {"type": "subtitle", "time": 22643.788, "timestamp": "06:17:23", "text": "炉。もしそれが最高なら"}, {"type": "subtitle", "time": 22646.15, "timestamp": "06:17:26", "text": "炉、そう、自動的に"}, {"type": "subtitle", "time": 22649.19, "timestamp": "06:17:29", "text": "温める。ほら、ほら、ほら、ほら。私はただ"}, {"type": "subtitle", "time": 22651.27, "timestamp": "06:17:31", "text": "これを温めるために。"}, {"type": "subtitle", "time": 22653.75, "timestamp": "06:17:33", "text": "ほら、こっちの方がいいでしょ？ただ"}, {"type": "subtitle", "time": 22656.11, "timestamp": "06:17:36", "text": "パイプを作り、"}, {"type": "subtitle", "time": 22658.628, "timestamp": "06:17:38", "text": "銅を混ぜ込む。すでに"}, {"type": "subtitle", "time": 22672.91, "timestamp": "06:17:52", "text": "いいえ。ええ。"}, {"type": "subtitle", "time": 22676.47, "timestamp": "06:17:56", "text": "簡単でしょ？私は思う。それは何ですか"}, {"type": "subtitle", "time": 22678.75, "timestamp": "06:17:58", "text": "ほとんど"}]
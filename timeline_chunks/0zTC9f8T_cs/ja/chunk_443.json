[{"type": "subtitle", "time": 26589.43, "timestamp": "07:23:09", "text": "待って。私たちはストリームとメッセージを見ています"}, {"type": "subtitle", "time": 26605.948, "timestamp": "07:23:25", "text": "待って。何てことだ。待って。あなたは＿＿したいですか"}, {"type": "subtitle", "time": 26616.11, "timestamp": "07:23:36", "text": "1つ？"}, {"type": "subtitle", "time": 26619.59, "timestamp": "07:23:39", "text": "待って。リンクをコピーします。あなたに送ります"}, {"type": "subtitle", "time": 26622.708, "timestamp": "07:23:42", "text": "リンクだよ、兄弟。"}]
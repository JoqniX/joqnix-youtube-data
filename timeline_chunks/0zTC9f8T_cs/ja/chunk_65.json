[{"type": "subtitle", "time": 3900.309, "timestamp": "01:05:00", "text": "バーを押してWを押す"}, {"type": "subtitle", "time": 3902.029, "timestamp": "01:05:02", "text": "そしてシフトして進む"}, {"type": "subtitle", "time": 3907.589, "timestamp": "01:05:07", "text": "上。うん。シフトシフトシフト"}, {"type": "subtitle", "time": 3910.549, "timestamp": "01:05:10", "text": "そしてWD。よくあるパターンですよね。私"}, {"type": "subtitle", "time": 3915.43, "timestamp": "01:05:15", "text": "Wを押し続けなければならない。いや、いや。待って、待って"}, {"type": "subtitle", "time": 3918.349, "timestamp": "01:05:18", "text": "空間。いや、いや、いや。離れる"}, {"type": "subtitle", "time": 3923.349, "timestamp": "01:05:23", "text": "空間。いいえ、AD 8だけで結構です。了解しました。わかった。"}, {"type": "subtitle", "time": 3925.109, "timestamp": "01:05:25", "text": "待って、霧をオンにしないといけないよ。それが理由です"}, {"type": "subtitle", "time": 3928.39, "timestamp": "01:05:28", "text": "えっと、エスケープキーを押してください。"}, {"type": "subtitle", "time": 3932.47, "timestamp": "01:05:32", "text": "あー、スキップ。ええと、脱出オプション。"}, {"type": "subtitle", "time": 3935.349, "timestamp": "01:05:35", "text": "ええ、訪問する予定です"}, {"type": "subtitle", "time": 3937.99, "timestamp": "01:05:37", "text": "雲と霧。電源を切ってください。それは"}, {"type": "subtitle", "time": 3940.789, "timestamp": "01:05:40", "text": "オフ。雲は消えました。"}, {"type": "subtitle", "time": 3943.39, "timestamp": "01:05:43", "text": "霧。どこ"}, {"type": "subtitle", "time": 3946.349, "timestamp": "01:05:46", "text": "霧？えっと、"}, {"type": "subtitle", "time": 3949.75, "timestamp": "01:05:49", "text": "粒子。霧はどこにありますか？存在するべきである"}]
[{"type": "subtitle", "time": 4803.31, "timestamp": "01:20:03", "text": "ああ、重いクロスボウがあって"}, {"type": "subtitle", "time": 4806.229, "timestamp": "01:20:06", "text": "もの。 Ro航空機。そうそう。彼女"}, {"type": "subtitle", "time": 4808.63, "timestamp": "01:20:08", "text": "すでにロケットブースターを追加したので、"}, {"type": "subtitle", "time": 4811.59, "timestamp": "01:20:11", "text": "ブースト効果もある。彼女はやり方さえ知らない"}, {"type": "subtitle", "time": 4814.39, "timestamp": "01:20:14", "text": "エンジンをかける。彼女はただ行くだけです"}, {"type": "subtitle", "time": 4818.39, "timestamp": "01:20:18", "text": "何てことだ。ええ、やり方は知っています。"}, {"type": "subtitle", "time": 4837.99, "timestamp": "01:20:37", "text": "わあ、すごい。行くよ、行くよ"}, {"type": "subtitle", "time": 4839.27, "timestamp": "01:20:39", "text": "私は墜落しそうです。わかった、行くよ"}, {"type": "subtitle", "time": 4845.83, "timestamp": "01:20:45", "text": "大丈夫。"}, {"type": "subtitle", "time": 4852.79, "timestamp": "01:20:52", "text": "彼女は今にも墜落しそうだ。彼女は飛んでいる"}]
[{"type": "subtitle", "time": 905.829, "timestamp": "00:15:05", "text": "怒りのコメント。"}, {"type": "subtitle", "time": 906.91, "timestamp": "00:15:06", "text": "待って、"}, {"type": "subtitle", "time": 910.47, "timestamp": "00:15:10", "text": "何？あ、すみません。"}, {"type": "subtitle", "time": 912.949, "timestamp": "00:15:12", "text": "ごめんね、みんな。みんな、もう終わりだ。みんな、"}, {"type": "subtitle", "time": 916.43, "timestamp": "00:15:16", "text": "私のmodファイルをあなたに渡してほしいですか？"}, {"type": "subtitle", "time": 918.79, "timestamp": "00:15:18", "text": "あれ？ドライブにアップロードするだけで"}, {"type": "subtitle", "time": 921.269, "timestamp": "00:15:21", "text": "それならお送りできますよ。それはいいです。"}, {"type": "subtitle", "time": 923.99, "timestamp": "00:15:23", "text": "コピー＆ペーストするだけでいいですよ。いいえ、あなた"}, {"type": "subtitle", "time": 925.99, "timestamp": "00:15:25", "text": "自動改造ではそれをする必要はありません"}, {"type": "subtitle", "time": 936.069, "timestamp": "00:15:36", "text": "なぜクライアント側なのか？追加するだけでいいんじゃない？"}, {"type": "subtitle", "time": 937.75, "timestamp": "00:15:37", "text": "サーバー上で、誰もが"}, {"type": "subtitle", "time": 943.87, "timestamp": "00:15:43", "text": "そういうことなんです"}, {"type": "subtitle", "time": 947.23, "timestamp": "00:15:47", "text": "作品。ありえない"}, {"type": "subtitle", "time": 956.31, "timestamp": "00:15:56", "text": "えっと、これに関するWikiがあります。私は思う"}, {"type": "subtitle", "time": 959.31, "timestamp": "00:15:59", "text": "これは必ず読んでください。"}]
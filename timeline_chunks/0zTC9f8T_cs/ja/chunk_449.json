[{"type": "subtitle", "time": 26943.27, "timestamp": "07:29:03", "text": "スパイダーマンは良い例だ。"}, {"type": "subtitle", "time": 26958.948, "timestamp": "07:29:18", "text": "今、位置を変えなきゃ。クソッ"}, {"type": "subtitle", "time": 26967.83, "timestamp": "07:29:27", "text": "くそっ。間違っている。"}, {"type": "subtitle", "time": 26969.35, "timestamp": "07:29:29", "text": "では、待ってください。プレイを始めましたか？"}, {"type": "subtitle", "time": 26973.27, "timestamp": "07:29:33", "text": "このゲームのランキングは？えっと、私が何をしたって？"}, {"type": "subtitle", "time": 26975.91, "timestamp": "07:29:35", "text": "このゲームのランク戦を始めましたか？"}, {"type": "subtitle", "time": 26977.43, "timestamp": "07:29:37", "text": "ゲーム？"}, {"type": "subtitle", "time": 26988.548, "timestamp": "07:29:48", "text": "去った。クラッシュしました。"}, {"type": "subtitle", "time": 26992.23, "timestamp": "07:29:52", "text": "なんてこった。墜落した。クラッシュしたばかりですか？"}, {"type": "subtitle", "time": 26997.59, "timestamp": "07:29:57", "text": "私に衝突する？わからない。わからない"}]
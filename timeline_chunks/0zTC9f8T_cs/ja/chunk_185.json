[{"type": "subtitle", "time": 11100.55, "timestamp": "03:05:00", "text": "アメットは掘削速度を速めるためのものです。待って、"}, {"type": "subtitle", "time": 11107.83, "timestamp": "03:05:07", "text": "おお。君たちは何をしているの？"}, {"type": "subtitle", "time": 11111.269, "timestamp": "03:05:11", "text": "アメス・シャナ。"}, {"type": "subtitle", "time": 11114.15, "timestamp": "03:05:14", "text": "そうねぇ。赤いものは何ですか"}, {"type": "subtitle", "time": 11116.03, "timestamp": "03:05:16", "text": "結晶"}, {"type": "subtitle", "time": 11118.67, "timestamp": "03:05:18", "text": "剣？もし私がこれらを持っていたら"}, {"type": "subtitle", "time": 11120.67, "timestamp": "03:05:20", "text": "剣？"}, {"type": "subtitle", "time": 11147.23, "timestamp": "03:05:47", "text": "ああ、しまった。簡単です。"}, {"type": "subtitle", "time": 11158.63, "timestamp": "03:05:58", "text": "私を見て。仕事。うちにおいで。私に"}]
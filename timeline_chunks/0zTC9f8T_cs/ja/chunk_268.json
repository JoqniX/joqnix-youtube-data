[{"type": "subtitle", "time": 16081.269, "timestamp": "04:28:01", "text": "さまざまなレシピプールで拡張する"}, {"type": "subtitle", "time": 16083.03, "timestamp": "04:28:03", "text": "発電機が異なるものを使用できる"}, {"type": "subtitle", "time": 16085.03, "timestamp": "04:28:05", "text": "発電するための燃料。見るために"}, {"type": "subtitle", "time": 16086.389, "timestamp": "04:28:06", "text": "これら2つを使用したレシピの変更"}, {"type": "subtitle", "time": 16088.389, "timestamp": "04:28:08", "text": "一緒に拡張するには、U を押すだけです"}, {"type": "subtitle", "time": 16089.91, "timestamp": "04:28:09", "text": "ジェネレーターを拡張します。次にクリックします"}, {"type": "subtitle", "time": 16091.349, "timestamp": "04:28:11", "text": "対応するタブ"}, {"type": "subtitle", "time": 16093.189, "timestamp": "04:28:13", "text": "相乗効果による増強。爆発"}, {"type": "subtitle", "time": 16095.51, "timestamp": "04:28:15", "text": "Augment により、ジェネレーターは"}, {"type": "subtitle", "time": 16098.07, "timestamp": "04:28:18", "text": "金属などの物質を使って発電する"}, {"type": "subtitle", "time": 16098.99, "timestamp": "04:28:18", "text": "された"}, {"type": "subtitle", "time": 16101.51, "timestamp": "04:28:21", "text": "洗練された。通常の拡張は"}, {"type": "subtitle", "time": 16104.229, "timestamp": "04:28:24", "text": "通常の燃料と喫煙の増加"}, {"type": "subtitle", "time": 16106.95, "timestamp": "04:28:26", "text": "食品などの有機物を使用する"}, {"type": "subtitle", "time": 16108.79, "timestamp": "04:28:28", "text": "もの。側面について話しましょう"}, {"type": "subtitle", "time": 16110.95, "timestamp": "04:28:30", "text": "設定、自動入力、出力"}, {"type": "subtitle", "time": 16112.63, "timestamp": "04:28:32", "text": "炉の機能。それぞれ"}, {"type": "subtitle", "time": 16114.71, "timestamp": "04:28:34", "text": "側面のこれらの正方形は、"}, {"type": "subtitle", "time": 16117.349, "timestamp": "04:28:37", "text": "炉の側面。 5つあります"}, {"type": "subtitle", "time": 16120.55, "timestamp": "04:28:40", "text": "各側の役割。ありません、"}, {"type": "subtitle", "time": 16124.389, "timestamp": "04:28:44", "text": "入力、出力、入力スラッシュ出力、"}, {"type": "subtitle", "time": 16127.189, "timestamp": "04:28:47", "text": "燃料投入量。各マスの上にカーソルを合わせる"}, {"type": "subtitle", "time": 16128.95, "timestamp": "04:28:48", "text": "正方形のどの面かを示します"}, {"type": "subtitle", "time": 16130.79, "timestamp": "04:28:50", "text": "対応する。もしあなたが"}, {"type": "subtitle", "time": 16132.309, "timestamp": "04:28:52", "text": "気に入らない設定、"}, {"type": "subtitle", "time": 16135.03, "timestamp": "04:28:55", "text": "中央部分をShiftキーを押しながらクリックするだけです。時間"}, {"type": "subtitle", "time": 16137.99, "timestamp": "04:28:57", "text": "仮説的な状況を想定して。仮に私が"}]
[{"type": "subtitle", "time": 27364.15, "timestamp": "07:36:04", "text": "ロックは2、4、6、8のように完了します。誰が"}, {"type": "subtitle", "time": 27367.19, "timestamp": "07:36:07", "text": "私たちは感謝しているでしょうか？私はしたことがない"}, {"type": "subtitle", "time": 27370.31, "timestamp": "07:36:10", "text": "それ。それが私たちのやり方です。今まで"}, {"type": "subtitle", "time": 27373.07, "timestamp": "07:36:13", "text": "チアリーディンググループに所属したことがありますか？"}, {"type": "subtitle", "time": 27380.788, "timestamp": "07:36:20", "text": "楽しかったよ、相棒。私はただただ最高だ。うん。さあ"}, {"type": "subtitle", "time": 27388.99, "timestamp": "07:36:28", "text": "ジェフ。ジェフが犯人だ。"}, {"type": "subtitle", "time": 27391.51, "timestamp": "07:36:31", "text": "水分補給をしましょう。子供。はい。水分補給をしましょう。する必要がある"}, {"type": "subtitle", "time": 27393.19, "timestamp": "07:36:33", "text": "水分補給をしましょう。ちくしょう。ありがとう"}, {"type": "subtitle", "time": 27394.43, "timestamp": "07:36:34", "text": "思い出させる"}, {"type": "subtitle", "time": 27397.03, "timestamp": "07:36:37", "text": "兄弟。ジョーは小さすぎる"}, {"type": "subtitle", "time": 27400.59, "timestamp": "07:36:40", "text": "君のおっぱい。ル。彼は言った"}, {"type": "subtitle", "time": 27403.19, "timestamp": "07:36:43", "text": "それ。ジョック。それについてどう思いますか？"}, {"type": "subtitle", "time": 27407.43, "timestamp": "07:36:47", "text": "正直、何と言っていいのか分からない。"}, {"type": "subtitle", "time": 27409.91, "timestamp": "07:36:49", "text": "あなたは見ているものが好きだ、あるいは"}, {"type": "subtitle", "time": 27412.628, "timestamp": "07:36:52", "text": "あなたは私が見たくないものを見たくない"}, {"type": "subtitle", "time": 27418.388, "timestamp": "07:36:58", "text": "言う。ノーコメントはできますか？私はそう思わない あなたは"}]
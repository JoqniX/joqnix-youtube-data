[{"type": "subtitle", "time": 27184.548, "timestamp": "07:33:04", "text": "ああ、インドにはサーバーがないんですね。ムンバイ"}, {"type": "subtitle", "time": 27186.948, "timestamp": "07:33:06", "text": "サーバ。そうなると思いますか？"}, {"type": "subtitle", "time": 27188.548, "timestamp": "07:33:08", "text": "インド人のサーバー？よく考えてみて。しかし"}, {"type": "subtitle", "time": 27191.11, "timestamp": "07:33:11", "text": "よく考えてから答えてください。私"}, {"type": "subtitle", "time": 27193.27, "timestamp": "07:33:13", "text": "良い音を出したくない"}, {"type": "subtitle", "time": 27196.548, "timestamp": "07:33:16", "text": "見下したような態度。でもヴァレリンは"}, {"type": "subtitle", "time": 27199.27, "timestamp": "07:33:19", "text": "インド人サーバー。だから私はこう思った。「考えてみて"}, {"type": "subtitle", "time": 27200.35, "timestamp": "07:33:20", "text": "について"}, {"type": "subtitle", "time": 27201.868, "timestamp": "07:33:21", "text": "それ。"}, {"type": "subtitle", "time": 27204.67, "timestamp": "07:33:24", "text": "一度もない"}, {"type": "subtitle", "time": 27208.43, "timestamp": "07:33:28", "text": "時計。ポーンは機能しません"}, {"type": "subtitle", "time": 27218.75, "timestamp": "07:33:38", "text": "彼らはライナを見て"}, {"type": "subtitle", "time": 27221.67, "timestamp": "07:33:41", "text": "「なぜフジテックなのか？」"}, {"type": "subtitle", "time": 27224.548, "timestamp": "07:33:44", "text": "「私を留めておけないの？」 ええと、あなたはそうしなければならない"}, {"type": "subtitle", "time": 27227.83, "timestamp": "07:33:47", "text": "それはあなたの側から行ってください。"}, {"type": "subtitle", "time": 27229.59, "timestamp": "07:33:49", "text": "待って、画像をお見せします。私はそうしなかった"}, {"type": "subtitle", "time": 27232.868, "timestamp": "07:33:52", "text": "画像が表示されない？いいえ。えっと、あなた、あなた"}, {"type": "subtitle", "time": 27235.59, "timestamp": "07:33:55", "text": "「私はしなかった、私はしない」から変更する必要がある"}, {"type": "subtitle", "time": 27237.43, "timestamp": "07:33:57", "text": "画面にモデルを表示している。ちくしょう。"}, {"type": "subtitle", "time": 27238.67, "timestamp": "07:33:58", "text": "教えて、"}]
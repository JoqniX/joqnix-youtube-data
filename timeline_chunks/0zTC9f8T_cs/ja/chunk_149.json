[{"type": "subtitle", "time": 8941.07, "timestamp": "02:29:01", "text": "だからビツキはそれを"}, {"type": "subtitle", "time": 8947.429, "timestamp": "02:29:07", "text": "えっと、あ、待って。あー、一つ追加し忘れてた"}, {"type": "subtitle", "time": 8957.11, "timestamp": "02:29:17", "text": "もの。またお腹が空いてきた。"}, {"type": "subtitle", "time": 8960.91, "timestamp": "02:29:20", "text": "おお。それは鍛造か"}, {"type": "subtitle", "time": 8999.83, "timestamp": "02:29:59", "text": "あなたのマンダールを作っています。"}]
[{"type": "subtitle", "time": 3313.349, "timestamp": "00:55:13", "text": "パック？内側に頭蓋骨があるようなワープ"}, {"type": "subtitle", "time": 3316.51, "timestamp": "00:55:16", "text": "パックはあったが、ワープパックはなかった"}, {"type": "subtitle", "time": 3318.91, "timestamp": "00:55:18", "text": "ここ。"}, {"type": "subtitle", "time": 3321.27, "timestamp": "00:55:21", "text": "ああ、それは"}, {"type": "subtitle", "time": 3326.99, "timestamp": "00:55:26", "text": "よし、新しい新しい"}]
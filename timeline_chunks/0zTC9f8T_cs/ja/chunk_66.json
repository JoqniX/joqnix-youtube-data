[{"type": "subtitle", "time": 3960.069, "timestamp": "01:06:00", "text": "うーん、わからない。行かせてください。私にさせて"}, {"type": "subtitle", "time": 3963.309, "timestamp": "01:06:03", "text": "自分の飛行機を手に入れる。待って、私は"}, {"type": "subtitle", "time": 3968.15, "timestamp": "01:06:08", "text": "来る。少し追加しました。これは唯一の"}, {"type": "subtitle", "time": 3972.23, "timestamp": "01:06:12", "text": "このゲームに飛行機は登場するの？いいえ。もっとありますか？"}, {"type": "subtitle", "time": 3976.069, "timestamp": "01:06:16", "text": "飛行機の種類は？まだ続きがあります。"}, {"type": "subtitle", "time": 3978.95, "timestamp": "01:06:18", "text": "高度などの要素は表示されないことは承知しています。"}, {"type": "subtitle", "time": 3995.91, "timestamp": "01:06:35", "text": "おお。わかった。燃料供給システムは十分ですか？"}, {"type": "subtitle", "time": 3999.43, "timestamp": "01:06:39", "text": "はい、Eを押します。Eを押します。"}, {"type": "subtitle", "time": 4008.39, "timestamp": "01:06:48", "text": "ああ、しまった。武器スロットがあります。アップグレード"}, {"type": "subtitle", "time": 4012.15, "timestamp": "01:06:52", "text": "スロット。ああ、ブースターロケットか。何てことだ。"}]
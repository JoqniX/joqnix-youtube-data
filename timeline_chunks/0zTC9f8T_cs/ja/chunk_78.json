[{"type": "subtitle", "time": 4688.47, "timestamp": "01:18:08", "text": "はい、今すぐ確認できますよ。"}, {"type": "subtitle", "time": 4690.709, "timestamp": "01:18:10", "text": "あなたは一人で行くのです。"}, {"type": "subtitle", "time": 4693.35, "timestamp": "01:18:13", "text": "なぜ一人だけなのですか？ 2人用"}, {"type": "subtitle", "time": 4697.27, "timestamp": "01:18:17", "text": "右クリックと言いました。ああ、あなたが乗っているやつですね"}, {"type": "subtitle", "time": 4700.39, "timestamp": "01:18:20", "text": "今すぐ。二人用です"}, {"type": "subtitle", "time": 4702.95, "timestamp": "01:18:22", "text": "人。それはたった一人の人に関する話です。"}, {"type": "subtitle", "time": 4705.229, "timestamp": "01:18:25", "text": "これ。ああ、手に入れた"}]
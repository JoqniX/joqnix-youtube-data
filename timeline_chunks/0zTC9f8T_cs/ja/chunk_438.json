[{"type": "subtitle", "time": 26282.99, "timestamp": "07:18:02", "text": "えっと、彼は私と遊べないよ、だって私は"}, {"type": "subtitle", "time": 26287.03, "timestamp": "07:18:07", "text": "レンジャーではない。だから、こうしたことすべてが原因で、"}, {"type": "subtitle", "time": 26289.99, "timestamp": "07:18:09", "text": "私たちはヴァレリンのグラインドをすることに決めた"}, {"type": "subtitle", "time": 26294.868, "timestamp": "07:18:14", "text": "後で配信します。えっと、いつか"}, {"type": "subtitle", "time": 26298.35, "timestamp": "07:18:18", "text": "えっと、後で、今日じゃなくて、いつか"}, {"type": "subtitle", "time": 26301.548, "timestamp": "07:18:21", "text": "後で。今日はマロをプレイします"}, {"type": "subtitle", "time": 26304.59, "timestamp": "07:18:24", "text": "ライバルたちはしのぎを削る。ええ、私たちはそれを磨き上げます。"}, {"type": "subtitle", "time": 26308.708, "timestamp": "07:18:28", "text": "えっと、六院と一緒にランクマッチを行います。"}, {"type": "subtitle", "time": 26310.75, "timestamp": "07:18:30", "text": "ええ、そうですね。うまくいくといいですね。願わくば"}, {"type": "subtitle", "time": 26316.868, "timestamp": "07:18:36", "text": "今日を楽しんでください。えーとローチャンは配信していません"}, {"type": "subtitle", "time": 26319.83, "timestamp": "07:18:39", "text": "でも、そうかもしれないね。"}, {"type": "subtitle", "time": 26323.19, "timestamp": "07:18:43", "text": "えっと、待って、待って、待って、待って、待って。私にさせて"}, {"type": "subtitle", "time": 26330.39, "timestamp": "07:18:50", "text": "えっと、彼に聞いてみないと。待って、彼は準備中"}, {"type": "subtitle", "time": 26332.708, "timestamp": "07:18:52", "text": "彼の配信のために。おそらくストリーミング配信だろう。えっと、"}, {"type": "subtitle", "time": 26338.59, "timestamp": "07:18:58", "text": "ストリーミング配信？"}]
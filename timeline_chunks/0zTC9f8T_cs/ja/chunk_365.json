[{"type": "subtitle", "time": 21913.03, "timestamp": "06:05:13", "text": "マインクラフトが"}, {"type": "subtitle", "time": 21914.67, "timestamp": "06:05:14", "text": "撃たれる"}, {"type": "subtitle", "time": 21923.99, "timestamp": "06:05:23", "text": "何か？うん。今、あなたは今私が"}, {"type": "subtitle", "time": 21927.35, "timestamp": "06:05:27", "text": "えっと、ダイヤモンドのやつを作ったよ。そうなるだろう"}, {"type": "subtitle", "time": 21930.31, "timestamp": "06:05:30", "text": "こんな感じです。今はストレージが本当にたくさんある。それで"}, {"type": "subtitle", "time": 21933.628, "timestamp": "06:05:33", "text": "必要なのは1つだけです。 2倍にしたら"}, {"type": "subtitle", "time": 21937.23, "timestamp": "06:05:37", "text": "これならたくさん手に入ります"}, {"type": "subtitle", "time": 21939.51, "timestamp": "06:05:39", "text": "ストレージ。うん。"}, {"type": "subtitle", "time": 21941.868, "timestamp": "06:05:41", "text": "それでは、確認してみます。"}, {"type": "subtitle", "time": 21949.47, "timestamp": "06:05:49", "text": "ヒーター"}, {"type": "subtitle", "time": 21952.628, "timestamp": "06:05:52", "text": "もの。うまくいくだろうか？よし、ヒーターは"}, {"type": "subtitle", "time": 21955.788, "timestamp": "06:05:55", "text": "働く。他の品物はどうですか？"}]
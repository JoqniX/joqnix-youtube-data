[{"type": "subtitle", "time": 2644.71, "timestamp": "00:44:04", "text": "同期内のファイルから生成する"}, {"type": "subtitle", "time": 2654.069, "timestamp": "00:44:14", "text": "モッド生成とは、"}, {"type": "subtitle", "time": 2655.91, "timestamp": "00:44:15", "text": "そこにオートパックがあり、"}, {"type": "subtitle", "time": 2658.63, "timestamp": "00:44:18", "text": "すべてのファイルのメタデータ"}, {"type": "subtitle", "time": 2660.23, "timestamp": "00:44:20", "text": "モッド。このファイルには触れないでください"}, {"type": "subtitle", "time": 2664.829, "timestamp": "00:44:24", "text": "手動で。私はそれを触った。ごめんなさい。"}, {"type": "subtitle", "time": 2669.109, "timestamp": "00:44:29", "text": "ああ、触ってしまった。 2つ削除する必要があります"}, {"type": "subtitle", "time": 2670.87, "timestamp": "00:44:30", "text": "モッズ。"}, {"type": "subtitle", "time": 2674.15, "timestamp": "00:44:34", "text": "何？どちらを取り外しますか？えっと"}, {"type": "subtitle", "time": 2675.99, "timestamp": "00:44:35", "text": "私が最近送ったもののように、"}, {"type": "subtitle", "time": 2678.39, "timestamp": "00:44:38", "text": "右？エンティティテクスチャ機能と"}, {"type": "subtitle", "time": 2680.87, "timestamp": "00:44:40", "text": "エンティティモデルの機能。"}, {"type": "subtitle", "time": 2683.91, "timestamp": "00:44:43", "text": "ああ、それは要らないんですか？ええ、なぜなら"}, {"type": "subtitle", "time": 2685.829, "timestamp": "00:44:45", "text": "他の何かに悪影響を与えている"}, {"type": "subtitle", "time": 2687.829, "timestamp": "00:44:47", "text": "実際にはより優れたアニメーションMOD"}]
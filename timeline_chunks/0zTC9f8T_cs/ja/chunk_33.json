[{"type": "subtitle", "time": 1980.549, "timestamp": "00:33:00", "text": "明らかに、私は普通に歩いていません。"}, {"type": "subtitle", "time": 1982.789, "timestamp": "00:33:02", "text": "うん。わかった。うん。今ならわかる。うん。"}, {"type": "subtitle", "time": 2008.07, "timestamp": "00:33:28", "text": "そうすると、彼らは私を見る。"}, {"type": "subtitle", "time": 2011.83, "timestamp": "00:33:31", "text": "なんてこった。見えない。"}, {"type": "subtitle", "time": 2014.35, "timestamp": "00:33:34", "text": "待って。ただ"}, {"type": "subtitle", "time": 2018.47, "timestamp": "00:33:38", "text": "行く。何か行動を起こしてください。"}, {"type": "subtitle", "time": 2020.83, "timestamp": "00:33:40", "text": "ええ、できます"}, {"type": "subtitle", "time": 2023.59, "timestamp": "00:33:43", "text": "見る。え、何？じゃあ、なぜ私にはできないの？"}, {"type": "subtitle", "time": 2028.789, "timestamp": "00:33:48", "text": "ああ、そうだ、そうだ、そうだ、そうだ、そうだ。今私は"}, {"type": "subtitle", "time": 2032.95, "timestamp": "00:33:52", "text": "見える。今ならわかる。えっと、"}]
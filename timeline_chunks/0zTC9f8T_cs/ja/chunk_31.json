[{"type": "subtitle", "time": 1891.71, "timestamp": "00:31:31", "text": "わかった。えっと、モッドパック"}, {"type": "subtitle", "time": 1897.029, "timestamp": "00:31:37", "text": "バージョン。わかった。サイズj以上。どうやって"}, {"type": "subtitle", "time": 1900.149, "timestamp": "00:31:40", "text": "これらも追加するのですか？"}, {"type": "subtitle", "time": 1902.43, "timestamp": "00:31:42", "text": "プロサーバーファイルにアクセスする必要があります。"}, {"type": "subtitle", "time": 1905.909, "timestamp": "00:31:45", "text": "次に、modsという名前のフォルダがあります。それから"}, {"type": "subtitle", "time": 1908.389, "timestamp": "00:31:48", "text": "それを追加する必要があります。"}, {"type": "subtitle", "time": 1911.43, "timestamp": "00:31:51", "text": "しかし、私はクライアントのドットを見ています。わかった。"}, {"type": "subtitle", "time": 1914.23, "timestamp": "00:31:54", "text": "モッドパックを変更しないでください。モッド自身をインストールします。"}, {"type": "subtitle", "time": 1919.149, "timestamp": "00:31:59", "text": "アップデート。よし、私はこうするべきだと思う"}]
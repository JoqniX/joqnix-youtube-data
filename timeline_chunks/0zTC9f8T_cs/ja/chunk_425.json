[{"type": "subtitle", "time": 25502.628, "timestamp": "07:05:02", "text": "チャイを作ってあげます。アップルパイが食べたいの？病気"}, {"type": "subtitle", "time": 25504.19, "timestamp": "07:05:04", "text": "リンゴを作る"}, {"type": "subtitle", "time": 25506.59, "timestamp": "07:05:06", "text": "パイ。ああ、"}, {"type": "subtitle", "time": 25510.11, "timestamp": "07:05:10", "text": "神。私はこう思った、そして面白いことに"}, {"type": "subtitle", "time": 25514.11, "timestamp": "07:05:14", "text": "この牛は"}, {"type": "subtitle", "time": 25517.91, "timestamp": "07:05:17", "text": "瓶。彼らは牛を瓶に入れた。それはあまりにも"}, {"type": "subtitle", "time": 25521.83, "timestamp": "07:05:21", "text": "それはパン用のトースターです。おお"}, {"type": "subtitle", "time": 25524.59, "timestamp": "07:05:24", "text": "なんてこった、"}, {"type": "subtitle", "time": 25528.91, "timestamp": "07:05:28", "text": "パン。うん、食べられるよ"}, {"type": "subtitle", "time": 25537.51, "timestamp": "07:05:37", "text": "うん、スパイス用の布巾は用意できるよ。我々はできる"}, {"type": "subtitle", "time": 25552.03, "timestamp": "07:05:52", "text": "ニース。"}, {"type": "subtitle", "time": 25556.19, "timestamp": "07:05:56", "text": "くそ。これを見たよ。私はこう思った。"}]
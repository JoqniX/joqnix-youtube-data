[{"type": "subtitle", "time": 307.189, "timestamp": "00:05:07", "text": "7. 日本語を忘れてしまった。"}, {"type": "subtitle", "time": 309.749, "timestamp": "00:05:09", "text": "何？あなたは文字通り日本に行くんです。"}, {"type": "subtitle", "time": 312.629, "timestamp": "00:05:12", "text": "日本語を忘れるなんて、どういうこと？すべての"}, {"type": "subtitle", "time": 317.43, "timestamp": "00:05:17", "text": "もの。時間を忘れて"}, {"type": "subtitle", "time": 320.23, "timestamp": "00:05:20", "text": "何てことだ。そのPDFファイルはどこにあるんだっけ？どこ"}, {"type": "subtitle", "time": 323.83, "timestamp": "00:05:23", "text": "Edgeは？エッジかな。ここで開封しました。"}, {"type": "subtitle", "time": 324.51, "timestamp": "00:05:24", "text": "しかし"}, {"type": "subtitle", "time": 330.469, "timestamp": "00:05:30", "text": "ああ、もうここにはないですね。おお、うーん"}, {"type": "subtitle", "time": 334.749, "timestamp": "00:05:34", "text": "ああ、そう、位置、場所、えーと"}, {"type": "subtitle", "time": 339.629, "timestamp": "00:05:39", "text": "カレンダー、時間。えっと、何でしたっけ？"}, {"type": "subtitle", "time": 344.909, "timestamp": "00:05:44", "text": "そして"}, {"type": "subtitle", "time": 349.43, "timestamp": "00:05:49", "text": "全部まとめて、どれがどれだったか忘れちゃった。"}, {"type": "subtitle", "time": 350.35, "timestamp": "00:05:50", "text": "ああ、"}, {"type": "subtitle", "time": 358.99, "timestamp": "00:05:58", "text": "えーと私も"}]
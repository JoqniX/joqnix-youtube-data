[{"type": "subtitle", "time": 5227.189, "timestamp": "01:27:07", "text": "ブロッコリー、とても美味しい。"}, {"type": "subtitle", "time": 5230.83, "timestamp": "01:27:10", "text": "もし私が降りたら、私はどこに"}, {"type": "subtitle", "time": 5233.669, "timestamp": "01:27:13", "text": "なれ？おお"}, {"type": "subtitle", "time": 5236.83, "timestamp": "01:27:16", "text": "自分。戻ってくる。おお"}, {"type": "subtitle", "time": 5241.189, "timestamp": "01:27:21", "text": "うん。わかった。右クリックしています"}, {"type": "subtitle", "time": 5243.43, "timestamp": "01:27:23", "text": "何も起こらない。"}, {"type": "subtitle", "time": 5246.629, "timestamp": "01:27:26", "text": "発砲禁止。そうそう。待っていてください。あなたには"}, {"type": "subtitle", "time": 5253.189, "timestamp": "01:27:33", "text": "手。あ、待って。あ、待って。必要がある"}, {"type": "subtitle", "time": 5264.83, "timestamp": "01:27:44", "text": "TNT。しかし、TNTを爆破するにはどうすればいいのだろうか？待って、"}, {"type": "subtitle", "time": 5268.39, "timestamp": "01:27:48", "text": "見る。 2番。前回追加した"}, {"type": "subtitle", "time": 5278.47, "timestamp": "01:27:58", "text": "このMODの名前は何でしたか？忘れた。そうだった"}]
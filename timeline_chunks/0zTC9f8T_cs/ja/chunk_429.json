[{"type": "subtitle", "time": 25741.99, "timestamp": "07:09:01", "text": "フェンスブラスター。そう、熱を加えているんだ"}, {"type": "subtitle", "time": 25746.83, "timestamp": "07:09:06", "text": "2つのものを別のものに置き換えるもの。"}, {"type": "subtitle", "time": 25750.15, "timestamp": "07:09:10", "text": "うん。他に何かありますか？戦闘は問題ない"}, {"type": "subtitle", "time": 25753.43, "timestamp": "07:09:13", "text": "なぜなら、私たちはたくさんの武器を持っているからです"}, {"type": "subtitle", "time": 25756.548, "timestamp": "07:09:16", "text": "発見し、見つけ出す必要がある。私は追加しました"}, {"type": "subtitle", "time": 25760.468, "timestamp": "07:09:20", "text": "複数の弓。弓を作る場合"}, {"type": "subtitle", "time": 25767.59, "timestamp": "07:09:27", "text": "弓か何か"}, {"type": "subtitle", "time": 25770.468, "timestamp": "07:09:30", "text": "えーと紙の矢印とか色々"}, {"type": "subtitle", "time": 25771.788, "timestamp": "07:09:31", "text": "使用"}, {"type": "subtitle", "time": 25774.628, "timestamp": "07:09:34", "text": "あの矢印。異なる矢印には"}, {"type": "subtitle", "time": 25776.948, "timestamp": "07:09:36", "text": "さまざまな効果も含まれる"}, {"type": "subtitle", "time": 25782.59, "timestamp": "07:09:42", "text": "RPGのMODは今や1つです。だからそういうわけで"}, {"type": "subtitle", "time": 25785.99, "timestamp": "07:09:45", "text": "良い。えっと、そうなるだろうね"}, {"type": "subtitle", "time": 25790.868, "timestamp": "07:09:50", "text": "今ではRPG用の矢を見つけるのは難しい。だから私は"}, {"type": "subtitle", "time": 25794.468, "timestamp": "07:09:54", "text": "よし、じゃあ行くことにしよう"}, {"type": "subtitle", "time": 25796.75, "timestamp": "07:09:56", "text": "と"}]
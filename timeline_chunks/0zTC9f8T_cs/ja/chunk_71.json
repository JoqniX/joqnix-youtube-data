[{"type": "subtitle", "time": 4261.83, "timestamp": "01:11:01", "text": "ああ、くそ。なんてこった。私は水の中にいます。私は"}, {"type": "subtitle", "time": 4264.51, "timestamp": "01:11:04", "text": "水中。私は水中にいる。おお"}, {"type": "subtitle", "time": 4268.31, "timestamp": "01:11:08", "text": "いいえ。待って。私は何をしますか？どこに泊まればいいですか？"}, {"type": "subtitle", "time": 4272.31, "timestamp": "01:11:12", "text": "降りる？えっと、君の飛行機を壊しちゃったよ。にたどり着く"}, {"type": "subtitle", "time": 4276.149, "timestamp": "01:11:16", "text": "何かがある安全な土地。ああ、しまった。"}, {"type": "subtitle", "time": 4278.229, "timestamp": "01:11:18", "text": "なんてこった。いや、だめ、だめ、だめ、だめ、だめ、だめ、だめ。"}, {"type": "subtitle", "time": 4280.87, "timestamp": "01:11:20", "text": "待て、飛行機を破壊できるぞ。あなたはできる"}, {"type": "subtitle", "time": 4284.55, "timestamp": "01:11:24", "text": "壊してしまえ。ほら、このボートみたいに。ああ、わかりました。"}, {"type": "subtitle", "time": 4288.87, "timestamp": "01:11:28", "text": "ちょっと待って。私はそこへ戻ります。"}, {"type": "subtitle", "time": 4290.39, "timestamp": "01:11:30", "text": "待って、ボートはどこ？どこにある"}, {"type": "subtitle", "time": 4291.99, "timestamp": "01:11:31", "text": "飛行機？"}, {"type": "subtitle", "time": 4305.91, "timestamp": "01:11:45", "text": "持っている。えっと、私はオフにしようとしていました"}, {"type": "subtitle", "time": 4309.75, "timestamp": "01:11:49", "text": "エンジンと、あ、待って。ああ、なるほど"}, {"type": "subtitle", "time": 4314.27, "timestamp": "01:11:54", "text": "ありがたいことにミニがあります"}]
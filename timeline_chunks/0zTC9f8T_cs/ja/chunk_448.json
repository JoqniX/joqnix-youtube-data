[{"type": "subtitle", "time": 26889.75, "timestamp": "07:28:09", "text": "これ。わかった。ああ、チャットに入力してください。私"}, {"type": "subtitle", "time": 26892.23, "timestamp": "07:28:12", "text": "ピン留めできると思います。"}, {"type": "subtitle", "time": 26894.388, "timestamp": "07:28:14", "text": "ピン留めしておきます。"}, {"type": "subtitle", "time": 26897.23, "timestamp": "07:28:17", "text": "レンダリングするにはどうすればいいですか"}, {"type": "subtitle", "time": 26899.75, "timestamp": "07:28:19", "text": "彼？わかった、"}, {"type": "subtitle", "time": 26902.07, "timestamp": "07:28:22", "text": "ドロップを有効にするように書き込む必要があります。私はしません"}, {"type": "subtitle", "time": 26903.948, "timestamp": "07:28:23", "text": "知る。ドロップ"}, {"type": "subtitle", "time": 26907.83, "timestamp": "07:28:27", "text": "有効になっていますか？滴。ちなみに、それは滴です。"}, {"type": "subtitle", "time": 26909.67, "timestamp": "07:28:29", "text": "おお、"}, {"type": "subtitle", "time": 26911.83, "timestamp": "07:28:31", "text": "書かなきゃいけないんだろうな。私は思う"}, {"type": "subtitle", "time": 26919.91, "timestamp": "07:28:39", "text": "アイスクリームです。これは無料のアイスです"}, {"type": "subtitle", "time": 26923.03, "timestamp": "07:28:43", "text": "ちなみに、クリームです。"}, {"type": "subtitle", "time": 26924.388, "timestamp": "07:28:44", "text": "ところで、あなたはどのキャラクターですか"}, {"type": "subtitle", "time": 26929.03, "timestamp": "07:28:49", "text": "今のことですか？くそっ。くそ。"}, {"type": "subtitle", "time": 26930.868, "timestamp": "07:28:50", "text": "文字の意味は？わからない。私"}, {"type": "subtitle", "time": 26932.788, "timestamp": "07:28:52", "text": "まだ決めていません。私はまだプレイしていません"}, {"type": "subtitle", "time": 26935.51, "timestamp": "07:28:55", "text": "それ。チュートリアルしかプレイしていません。遊ぶ"}, {"type": "subtitle", "time": 26938.548, "timestamp": "07:28:58", "text": "ジェフ。ジェフか何か迷惑な役を演じようかな"}]
[{"type": "subtitle", "time": 8704.55, "timestamp": "02:25:04", "text": "そしてズーム。"}, {"type": "subtitle", "time": 8708.71, "timestamp": "02:25:08", "text": "なぜ？え、何？ズームインできますか？うん。"}, {"type": "subtitle", "time": 8712.23, "timestamp": "02:25:12", "text": "ああ、映画的な表現ならズームできるよ。私は"}, {"type": "subtitle", "time": 8713.71, "timestamp": "02:25:13", "text": "とても良い"}, {"type": "subtitle", "time": 8718.309, "timestamp": "02:25:18", "text": "アイデア。コンサートをしたらどうだろう？"}, {"type": "subtitle", "time": 8721.349, "timestamp": "02:25:21", "text": "私たちはすべての映画的効果を使用し、"}, {"type": "subtitle", "time": 8730.95, "timestamp": "02:25:30", "text": "記録。はい、それはとてもありがたいです。"}, {"type": "subtitle", "time": 8733.429, "timestamp": "02:25:33", "text": "それを食べるという行為がある。"}, {"type": "subtitle", "time": 8735.429, "timestamp": "02:25:35", "text": "ええ、あなたのためでもありますよ。さらに、私の"}, {"type": "subtitle", "time": 8738.51, "timestamp": "02:25:38", "text": "犬に尻尾が生えた"}, {"type": "subtitle", "time": 8745.349, "timestamp": "02:25:45", "text": "くそ。彼らは持っている、ああ、待って。犬は"}, {"type": "subtitle", "time": 8747.99, "timestamp": "02:25:47", "text": "ずっと尻尾があった。彼らは持っている"}, {"type": "subtitle", "time": 8750.63, "timestamp": "02:25:50", "text": "尻尾が出たけど、普通の飛行機みたいだった"}, {"type": "subtitle", "time": 8753.51, "timestamp": "02:25:53", "text": "尻尾、アニメーションの尻尾のようなものではない。わかった。"}, {"type": "subtitle", "time": 8755.19, "timestamp": "02:25:55", "text": "座り方も違っていた。"}, {"type": "subtitle", "time": 8758.83, "timestamp": "02:25:58", "text": "今ではまるで本物の犬のように座っている。"}]
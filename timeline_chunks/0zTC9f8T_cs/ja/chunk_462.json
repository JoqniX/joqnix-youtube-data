[{"type": "subtitle", "time": 27723.19, "timestamp": "07:42:03", "text": "あなたは変わらなければならない。富士山を送ります"}, {"type": "subtitle", "time": 27725.83, "timestamp": "07:42:05", "text": "技術リンク。 Discordでログインして"}, {"type": "subtitle", "time": 27734.15, "timestamp": "07:42:14", "text": "そして、ジョーの看板に流れが見える。私"}, {"type": "subtitle", "time": 27735.948, "timestamp": "07:42:15", "text": "私は実際には"}, {"type": "subtitle", "time": 27746.468, "timestamp": "07:42:26", "text": "良い人物だ。"}, {"type": "subtitle", "time": 27762.19, "timestamp": "07:42:42", "text": "ああ、"}, {"type": "subtitle", "time": 27765.43, "timestamp": "07:42:45", "text": "ウルヴァリン。ニース。この中にウルフェンがいる"}, {"type": "subtitle", "time": 27768.23, "timestamp": "07:42:48", "text": "ゲーム。"}, {"type": "subtitle", "time": 27770.708, "timestamp": "07:42:50", "text": "しかし、このアイアンマンは私たちが知っているアイアンマンではない"}, {"type": "subtitle", "time": 27773.35, "timestamp": "07:42:53", "text": "マーベル作品でご存知ですよね？ええ、それは"}, {"type": "subtitle", "time": 27776.628, "timestamp": "07:42:56", "text": "なぜ。いや、いや、いや。これは私が思うことです"}, {"type": "subtitle", "time": 27778.07, "timestamp": "07:42:58", "text": "一つは装甲戦争で登場する。私はしません"}]
[{"type": "subtitle", "time": 27000.468, "timestamp": "07:30:00", "text": "何と言えばいいのか。何と言っていいかわからない。私"}, {"type": "subtitle", "time": 27003.788, "timestamp": "07:30:03", "text": "わからない、わからない。わかった。"}, {"type": "subtitle", "time": 27007.43, "timestamp": "07:30:07", "text": "52%完了。"}, {"type": "subtitle", "time": 27009.59, "timestamp": "07:30:09", "text": "配信は控えめにした方がいいと思う。私の"}, {"type": "subtitle", "time": 27013.35, "timestamp": "07:30:13", "text": "最適化できると表示されています"}, {"type": "subtitle", "time": 27014.788, "timestamp": "07:30:14", "text": "設定は、プレイできるようなものです"}, {"type": "subtitle", "time": 27017.35, "timestamp": "07:30:17", "text": "高いけどストリーミングするなら低いと思う"}, {"type": "subtitle", "time": 27022.31, "timestamp": "07:30:22", "text": "どうやら10ギガバイトのVRAMが必要なようだ。何？"}, {"type": "subtitle", "time": 27024.788, "timestamp": "07:30:24", "text": "私はしません"}, {"type": "subtitle", "time": 27030.07, "timestamp": "07:30:30", "text": "出かけなければならないと思う。くそ。"}, {"type": "subtitle", "time": 27032.07, "timestamp": "07:30:32", "text": "このジョークが"}, {"type": "subtitle", "time": 27037.31, "timestamp": "07:30:37", "text": "ところで、ストリーミング配信中"}, {"type": "subtitle", "time": 27040.868, "timestamp": "07:30:40", "text": "YouTubeで？ YouTubeであなたの姿が見えません。"}, {"type": "subtitle", "time": 27043.51, "timestamp": "07:30:43", "text": "私はYouTubeで配信しています。いいえ、違います"}, {"type": "subtitle", "time": 27045.35, "timestamp": "07:30:45", "text": "ストリーミング配信。"}, {"type": "subtitle", "time": 27048.468, "timestamp": "07:30:48", "text": "しかし、彼らはそうなのです。いいえ、表示されていません"}, {"type": "subtitle", "time": 27050.75, "timestamp": "07:30:50", "text": "私にとってはYouTubeです。"}, {"type": "subtitle", "time": 27054.948, "timestamp": "07:30:54", "text": "何？表示されるはずです。"}]
[{"type": "subtitle", "time": 16261.59, "timestamp": "04:31:01", "text": "追加は、これが鉄を増強する方法ではありません"}, {"type": "subtitle", "time": 16263.71, "timestamp": "04:31:03", "text": "モアはこれを組み立て始めるだろう"}, {"type": "subtitle", "time": 16266.149, "timestamp": "04:31:06", "text": "デモ用の入力および出力スロット"}, {"type": "subtitle", "time": 16267.87, "timestamp": "04:31:07", "text": "完全に"}, {"type": "subtitle", "time": 16270.55, "timestamp": "04:31:10", "text": "機能的。自動分割機能の入力"}, {"type": "subtitle", "time": 16273.389, "timestamp": "04:31:13", "text": "出力スロットは完全に"}, {"type": "subtitle", "time": 16275.91, "timestamp": "04:31:15", "text": "機能的。自動分割機能"}, {"type": "subtitle", "time": 16277.51, "timestamp": "04:31:17", "text": "量を均等にすることができます"}, {"type": "subtitle", "time": 16279.51, "timestamp": "04:31:19", "text": "分配されるアイテム"}, {"type": "subtitle", "time": 16281.55, "timestamp": "04:31:21", "text": "入出力"}, {"type": "subtitle", "time": 16283.67, "timestamp": "04:31:23", "text": "スロット。それでは、"}, {"type": "subtitle", "time": 16285.83, "timestamp": "04:31:25", "text": "他の拡張機能、ジェネレーター拡張機能。"}, {"type": "subtitle", "time": 16287.59, "timestamp": "04:31:27", "text": "これらの鉄炉の1つは通常の"}, {"type": "subtitle", "time": 16289.189, "timestamp": "04:31:29", "text": "製鉄炉。もう一方の"}, {"type": "subtitle", "time": 16290.79, "timestamp": "04:31:30", "text": "爆発増強。私はそれらを変換できます"}, {"type": "subtitle", "time": 16292.469, "timestamp": "04:31:32", "text": "両方とも発電機に"}, {"type": "subtitle", "time": 16295.67, "timestamp": "04:31:35", "text": "発電機オン"}]
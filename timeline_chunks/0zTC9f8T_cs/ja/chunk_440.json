[{"type": "subtitle", "time": 26404.39, "timestamp": "07:20:04", "text": "ゲーム？ディスラプターファイルを開けませんでした。"}, {"type": "subtitle", "time": 26408.03, "timestamp": "07:20:08", "text": "ディスラプターファイルとは何ですか？"}, {"type": "subtitle", "time": 26409.948, "timestamp": "07:20:09", "text": "言い訳"}, {"type": "subtitle", "time": 26411.708, "timestamp": "07:20:11", "text": "自分。"}, {"type": "subtitle", "time": 26416.27, "timestamp": "07:20:16", "text": "何？今日なぜ"}, {"type": "subtitle", "time": 26424.23, "timestamp": "07:20:24", "text": "ああ、これはまずい。これはまずい。確認する。"}, {"type": "subtitle", "time": 26431.35, "timestamp": "07:20:31", "text": "確認する。私のゲームを検証してください。誰かがジョギングと言った"}, {"type": "subtitle", "time": 26440.23, "timestamp": "07:20:40", "text": "はぁ？いいえ、私たちはヴァレルと"}, {"type": "subtitle", "time": 26444.15, "timestamp": "07:20:44", "text": "ストリームしたけど、私のゲームは、えっと、私は"}, {"type": "subtitle", "time": 26446.628, "timestamp": "07:20:46", "text": "ゲームのアップデートを忘れていました。私は遅刻した。私"}, {"type": "subtitle", "time": 26449.07, "timestamp": "07:20:49", "text": "散歩に出かけた。ああ、忘れてた"}, {"type": "subtitle", "time": 26453.75, "timestamp": "07:20:53", "text": "それ。そして私たちは完全に忘れていました"}, {"type": "subtitle", "time": 26455.91, "timestamp": "07:20:55", "text": "ランク戦は一度もプレイしたことがない。だから、私は遊べない"}, {"type": "subtitle", "time": 26459.948, "timestamp": "07:20:59", "text": "鉄より上位にランクされている人、または"}]
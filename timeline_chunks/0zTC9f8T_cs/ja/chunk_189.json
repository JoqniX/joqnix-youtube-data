[{"type": "subtitle", "time": 11341.75, "timestamp": "03:09:01", "text": "これです。銅製の扇風機。えっと、"}, {"type": "subtitle", "time": 11345.429, "timestamp": "03:09:05", "text": "水中潜水艦みたいなもの。"}, {"type": "subtitle", "time": 11348.269, "timestamp": "03:09:08", "text": "待って、君は潜水艦を作ったのか。"}, {"type": "subtitle", "time": 11351.19, "timestamp": "03:09:11", "text": "ええ、導管"}, {"type": "subtitle", "time": 11353.11, "timestamp": "03:09:13", "text": "導管。"}, {"type": "subtitle", "time": 11360.71, "timestamp": "03:09:20", "text": "うん。おお。"}, {"type": "subtitle", "time": 11363.15, "timestamp": "03:09:23", "text": "わかった。実際に驚いた"}, {"type": "subtitle", "time": 11370.67, "timestamp": "03:09:30", "text": "負荷。待って、どうやって追加すればいいの？"}, {"type": "subtitle", "time": 11372.87, "timestamp": "03:09:32", "text": "コンドミニアム？スペースが足りない。足りない"}, {"type": "subtitle", "time": 11375.75, "timestamp": "03:09:35", "text": "空間。ああ、あなたはそれを土地に置いたばかりだ。"}, {"type": "subtitle", "time": 11378.389, "timestamp": "03:09:38", "text": "ああ、それを土地に植えなければならない。"}, {"type": "subtitle", "time": 11381.19, "timestamp": "03:09:41", "text": "なんてこった。実際、そうしなければならないんです。その"}, {"type": "subtitle", "time": 11383.59, "timestamp": "03:09:43", "text": "実際、良い。"}, {"type": "subtitle", "time": 11385.63, "timestamp": "03:09:45", "text": "ああ、"}, {"type": "subtitle", "time": 11388.71, "timestamp": "03:09:48", "text": "神。待って、入れた方がいいと思う。しかし"}, {"type": "subtitle", "time": 11390.95, "timestamp": "03:09:50", "text": "どうやって水に入ればいいですか？"}]
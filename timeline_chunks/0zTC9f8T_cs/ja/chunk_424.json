[{"type": "subtitle", "time": 25461.15, "timestamp": "07:04:21", "text": "それ。ああ、バカの冷蔵庫のための料理"}, {"type": "subtitle", "time": 25476.708, "timestamp": "07:04:36", "text": "「ああ、何かを作って、"}, {"type": "subtitle", "time": 25478.35, "timestamp": "07:04:38", "text": "それぞれに"}, {"type": "subtitle", "time": 25485.83, "timestamp": "07:04:45", "text": "楽しい。」料理の材料を見たり、"}, {"type": "subtitle", "time": 25488.67, "timestamp": "07:04:48", "text": "鶏肉をキッチンカウンターに置くか"}, {"type": "subtitle", "time": 25490.948, "timestamp": "07:04:50", "text": "何か。それがあなたの"}, {"type": "subtitle", "time": 25493.83, "timestamp": "07:04:53", "text": "自分の家を持つ。"}, {"type": "subtitle", "time": 25496.708, "timestamp": "07:04:56", "text": "橋があります。人々を歓迎します"}, {"type": "subtitle", "time": 25499.83, "timestamp": "07:04:59", "text": "あなたの家。どうぞお入りください。チャイはいかがですか？病気"}]
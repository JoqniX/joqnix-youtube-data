[{"type": "subtitle", "time": 27300.548, "timestamp": "07:35:00", "text": "うん、お互いに挨拶したり、"}, {"type": "subtitle", "time": 27302.948, "timestamp": "07:35:02", "text": "お互いを憎み合っている。そんなことはしないで"}, {"type": "subtitle", "time": 27309.67, "timestamp": "07:35:09", "text": "アイアンマンを追いかけるぞ"}, {"type": "subtitle", "time": 27311.75, "timestamp": "07:35:11", "text": "クソ野郎。"}, {"type": "subtitle", "time": 27315.03, "timestamp": "07:35:15", "text": "あぁ、ストリームがバッファリングしてる。"}, {"type": "subtitle", "time": 27317.788, "timestamp": "07:35:17", "text": "音声を再生しない理由は"}, {"type": "subtitle", "time": 27321.19, "timestamp": "07:35:21", "text": "アイアンマンからというのは、私のオーディオが"}, {"type": "subtitle", "time": 27322.59, "timestamp": "07:35:22", "text": "音声は"}, {"type": "subtitle", "time": 27325.11, "timestamp": "07:35:25", "text": "2倍になった。あ、待って。ミュートできるかもしれない"}, {"type": "subtitle", "time": 27327.27, "timestamp": "07:35:27", "text": "配信中に自分の音声を消した。"}, {"type": "subtitle", "time": 27329.03, "timestamp": "07:35:29", "text": "心配しないで、心配しないで。彼らは"}, {"type": "subtitle", "time": 27331.51, "timestamp": "07:35:31", "text": "あなたの声も聞こえますよ。"}, {"type": "subtitle", "time": 27342.15, "timestamp": "07:35:42", "text": "ゲーム。なぜ動作が遅いのですか？着替えさせてください"}, {"type": "subtitle", "time": 27346.23, "timestamp": "07:35:46", "text": "決議。ダブルキル。"}, {"type": "subtitle", "time": 27351.99, "timestamp": "07:35:51", "text": "えーっと、チアリーディングダンスをするか、"}]
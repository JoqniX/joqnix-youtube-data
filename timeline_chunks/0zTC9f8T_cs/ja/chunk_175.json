[{"type": "subtitle", "time": 10501.309, "timestamp": "02:55:01", "text": "1つ。"}, {"type": "subtitle", "time": 10516.23, "timestamp": "02:55:16", "text": "たくさんの特典を追加できるのが嬉しいです"}, {"type": "subtitle", "time": 10528.71, "timestamp": "02:55:28", "text": "でもほら、ああ、そうだね。私はバイオリンが欲しい。私"}, {"type": "subtitle", "time": 10531.87, "timestamp": "02:55:31", "text": "バイオリンを習いたかった"}, {"type": "subtitle", "time": 10535.349, "timestamp": "02:55:35", "text": "一度。 Bを保持しなければならない。ああ、そうしなければならない。"}, {"type": "subtitle", "time": 10539.349, "timestamp": "02:55:39", "text": "アニメを見たよ"}, {"type": "subtitle", "time": 10542.15, "timestamp": "02:55:42", "text": "ガール・エンパイア、そしてこの女の子がいた"}, {"type": "subtitle", "time": 10546.55, "timestamp": "02:55:46", "text": "シングという名前で、ボール遊びをしていた"}]
[{"type": "subtitle", "time": 9195.03, "timestamp": "02:33:15", "text": "再起動にこんなに時間がかかるのはなぜですか？"}, {"type": "subtitle", "time": 9197.429, "timestamp": "02:33:17", "text": "そうすべきでしょうか？私はそうするべきだったのだろうか？いいえ。殺す。"}, {"type": "subtitle", "time": 9198.95, "timestamp": "02:33:18", "text": "それ。殺せ。なぜなら、"}, {"type": "subtitle", "time": 9201.75, "timestamp": "02:33:21", "text": "サーバーを停止する時が来た。殺せ。"}, {"type": "subtitle", "time": 9206.309, "timestamp": "02:33:26", "text": "待って。待って。うん。一度停止させてから再起動してください。"}, {"type": "subtitle", "time": 9209.03, "timestamp": "02:33:29", "text": "どうやら自動的に起動しているようです。"}, {"type": "chat", "time": 9226.505, "timestamp": "02:33:46", "author": "@saii.", "avatar": "https://yt4.ggpht.com/3zUIW6dAQ6Lr5vLl0lqQ1SDX6_FlSHF5uPT02PbCpi3rR1u3H4KK3Clvc3h4GwayKUCSUkNFr_Y=s64-c-k-c0x00ffffff-no-rj", "message": "🙂"}, {"type": "subtitle", "time": 9228.63, "timestamp": "02:33:48", "text": "わかった。時間、"}, {"type": "subtitle", "time": 9230.67, "timestamp": "02:33:50", "text": "あなたが知っている。えっと"}]
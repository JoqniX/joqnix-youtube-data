[{"type": "subtitle", "time": 27480.468, "timestamp": "07:38:00", "text": "ああ、イエス様、今日は大変な一日ですね。"}, {"type": "subtitle", "time": 27484.15, "timestamp": "07:38:04", "text": "兄弟。うん、"}, {"type": "subtitle", "time": 27486.31, "timestamp": "07:38:06", "text": "それまではチャットで話していればいいですよ。"}, {"type": "subtitle", "time": 27489.19, "timestamp": "07:38:09", "text": "私は推測する。私が演奏している間、何か言ってください。"}, {"type": "subtitle", "time": 27492.548, "timestamp": "07:38:12", "text": "こんにちは、ようこそ。"}, {"type": "subtitle", "time": 27494.15, "timestamp": "07:38:14", "text": "つまり、モールを小さくするか、"}, {"type": "subtitle", "time": 27497.51, "timestamp": "07:38:17", "text": "ジョックを大きくする。"}, {"type": "subtitle", "time": 27499.35, "timestamp": "07:38:19", "text": "ええ、実は私がやります。待って、"}, {"type": "subtitle", "time": 27504.548, "timestamp": "07:38:24", "text": "実際にやってみてください。少々お待ちください。注記"}, {"type": "subtitle", "time": 27509.03, "timestamp": "07:38:29", "text": "それまでは、リンクをお送りします。"}, {"type": "subtitle", "time": 27510.468, "timestamp": "07:38:30", "text": "えっと、そうは見えない？"}, {"type": "subtitle", "time": 27511.67, "timestamp": "07:38:31", "text": "まるでキスでもしているみたいに"}, {"type": "subtitle", "time": 27519.91, "timestamp": "07:38:39", "text": "ゲイ。えっと、それはちょっとゲイっぽいですね。"}, {"type": "subtitle", "time": 27522.548, "timestamp": "07:38:42", "text": "はい、どうぞ。の"}, {"type": "subtitle", "time": 27525.548, "timestamp": "07:38:45", "text": "反応性"}, {"type": "subtitle", "time": 27528.788, "timestamp": "07:38:48", "text": "試合後にできるなら、変更してください"}]
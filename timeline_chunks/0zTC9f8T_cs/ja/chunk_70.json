[{"type": "subtitle", "time": 4203.07, "timestamp": "01:10:03", "text": "きちんと。もしそれが可能だったら"}, {"type": "subtitle", "time": 4206.07, "timestamp": "01:10:06", "text": "もっと速く走るために。"}, {"type": "subtitle", "time": 4209.149, "timestamp": "01:10:09", "text": "そう、ロケットが必要だ。"}, {"type": "subtitle", "time": 4210.87, "timestamp": "01:10:10", "text": "ロケット。"}, {"type": "subtitle", "time": 4213.669, "timestamp": "01:10:13", "text": "岩を掘る穴の作り方。"}, {"type": "subtitle", "time": 4215.03, "timestamp": "01:10:15", "text": "そう、ライターみたいなものだよ。行ってもいいですよ"}, {"type": "subtitle", "time": 4216.55, "timestamp": "01:10:16", "text": "もっと早く。"}, {"type": "subtitle", "time": 4218.07, "timestamp": "01:10:18", "text": "うん、"}, {"type": "subtitle", "time": 4249.91, "timestamp": "01:10:49", "text": "待って、エンジンを切ったら"}, {"type": "subtitle", "time": 4253.27, "timestamp": "01:10:53", "text": "倒れる？私はします。おお、"}, {"type": "subtitle", "time": 4255.75, "timestamp": "01:10:55", "text": "待って。でも、エンジンの停止方法は？のように、"}, {"type": "subtitle", "time": 4259.669, "timestamp": "01:10:59", "text": "オフにする方法はありますか？"}]
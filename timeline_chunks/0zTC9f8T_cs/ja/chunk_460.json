[{"type": "subtitle", "time": 27609.91, "timestamp": "07:40:09", "text": "さて、昼食は何を食べますか？"}, {"type": "subtitle", "time": 27611.99, "timestamp": "07:40:11", "text": "右？"}, {"type": "subtitle", "time": 27615.67, "timestamp": "07:40:15", "text": "えっと、朝食。私は持っていた"}, {"type": "subtitle", "time": 27619.43, "timestamp": "07:40:19", "text": "ウムチャパティと"}, {"type": "subtitle", "time": 27622.31, "timestamp": "07:40:22", "text": "何？チャパティ。"}, {"type": "subtitle", "time": 27624.388, "timestamp": "07:40:24", "text": "チャパティとは、ロティのようなものを指します。ちくしょう。"}, {"type": "subtitle", "time": 27626.868, "timestamp": "07:40:26", "text": "ロティ？え、違う言い方をするんですか？"}, {"type": "subtitle", "time": 27629.43, "timestamp": "07:40:29", "text": "待って。いいえ、私は全くそうは言いません。私は言う"}, {"type": "subtitle", "time": 27630.948, "timestamp": "07:40:30", "text": "ロティ。"}, {"type": "subtitle", "time": 27632.548, "timestamp": "07:40:32", "text": "ああ。"}, {"type": "subtitle", "time": 27634.868, "timestamp": "07:40:34", "text": "どうでも。好きなものを何でも食べられます。"}, {"type": "subtitle", "time": 27637.628, "timestamp": "07:40:37", "text": "相棒。あなたが望むものは何でも。"}, {"type": "subtitle", "time": 27652.07, "timestamp": "07:40:52", "text": "おお。わかった。うん。こんにちは。では、"}, {"type": "subtitle", "time": 27654.19, "timestamp": "07:40:54", "text": "ようこそ"}, {"type": "subtitle", "time": 27657.67, "timestamp": "07:40:57", "text": "ストリーム。えっと、ゲームキャプチャですね。来て。なぜ"}]
[{"type": "subtitle", "time": 7923.35, "timestamp": "02:12:03", "text": "えーと、星座の形をした私たち全員"}, {"type": "subtitle", "time": 7926.39, "timestamp": "02:12:06", "text": "音楽的な要素を追加してください。追加しました。"}, {"type": "subtitle", "time": 7931.35, "timestamp": "02:12:11", "text": "それは追加します。えっと、私は探しています"}, {"type": "subtitle", "time": 7933.79, "timestamp": "02:12:13", "text": "えっと、ここにはない"}, {"type": "subtitle", "time": 7937.95, "timestamp": "02:12:17", "text": "私のスペルミスでしょうか"}, {"type": "subtitle", "time": 7958.069, "timestamp": "02:12:38", "text": "出血量は多いけど、まあ"}, {"type": "subtitle", "time": 7963.75, "timestamp": "02:12:43", "text": "痛い。あなたの爪は完全に抜け落ちました。"}, {"type": "subtitle", "time": 7974.43, "timestamp": "02:12:54", "text": "そうではなかった"}, {"type": "subtitle", "time": 7979.629, "timestamp": "02:12:59", "text": "だった"}]
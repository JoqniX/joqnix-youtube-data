[{"type": "subtitle", "time": 4140.11, "timestamp": "01:09:00", "text": "聞く？はい、うまくいっています。私"}, {"type": "subtitle", "time": 4143.309, "timestamp": "01:09:03", "text": "たぶん、ただ浮かんでいるだけならわかると思う"}, {"type": "subtitle", "time": 4145.349, "timestamp": "01:09:05", "text": "次に、エンジンが停止します。"}, {"type": "subtitle", "time": 4147.269, "timestamp": "01:09:07", "text": "自動的に。保護区にあるのだと思います"}, {"type": "subtitle", "time": 4149.47, "timestamp": "01:09:09", "text": "または"}, {"type": "subtitle", "time": 4152.269, "timestamp": "01:09:12", "text": "何か。私たちはほとんど"}, {"type": "subtitle", "time": 4156.149, "timestamp": "01:09:16", "text": "墜落しました。くそ。"}]
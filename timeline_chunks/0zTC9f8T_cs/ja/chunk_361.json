[{"type": "subtitle", "time": 21660.27, "timestamp": "06:01:00", "text": "仕事。なぜ働かないのですか？"}, {"type": "subtitle", "time": 21674.39, "timestamp": "06:01:14", "text": "MODパックの所有者は誰ですか。君とセックスしたい。"}, {"type": "subtitle", "time": 21678.708, "timestamp": "06:01:18", "text": "私は文字通り、"}, {"type": "subtitle", "time": 21682.23, "timestamp": "06:01:22", "text": "えっと、Discordサーバーで、こんな風に愚痴をこぼす"}, {"type": "subtitle", "time": 21685.59, "timestamp": "06:01:25", "text": "なぜ、なぜ君たちはポートを持っていないんだ"}, {"type": "subtitle", "time": 21688.43, "timestamp": "06:01:28", "text": "1.2の場合"}, {"type": "subtitle", "time": 21690.83, "timestamp": "06:01:30", "text": "1.21?最悪だ"}, {"type": "subtitle", "time": 21696.07, "timestamp": "06:01:36", "text": "けれど。なぜこのモードはバージョン1.21.1専用なのでしょうか？"}, {"type": "subtitle", "time": 21705.27, "timestamp": "06:01:45", "text": "いいえ、骨を殺すのは効果がありません。"}, {"type": "subtitle", "time": 21706.27, "timestamp": "06:01:46", "text": "だから、"}, {"type": "subtitle", "time": 21709.31, "timestamp": "06:01:49", "text": "大丈夫。こんにちは、次は"}]
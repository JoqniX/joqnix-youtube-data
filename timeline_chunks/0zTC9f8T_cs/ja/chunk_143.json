[{"type": "subtitle", "time": 8606.07, "timestamp": "02:23:26", "text": "テレポートできます。いいえ、わかりません。私"}, {"type": "subtitle", "time": 8614.75, "timestamp": "02:23:34", "text": "何か"}, {"type": "subtitle", "time": 8626.87, "timestamp": "02:23:46", "text": "ああ、まるでマインクラフトみたいに"}, {"type": "subtitle", "time": 8629.429, "timestamp": "02:23:49", "text": "岩盤。おお、"}, {"type": "subtitle", "time": 8630.63, "timestamp": "02:23:50", "text": "待って。もっとお見せしましょう。"}, {"type": "subtitle", "time": 8635.469, "timestamp": "02:23:55", "text": "待って、行かせてくれ、という声が上がった。おお。おお。わかった。"}, {"type": "subtitle", "time": 8637.87, "timestamp": "02:23:57", "text": "わかった。ただ"}]
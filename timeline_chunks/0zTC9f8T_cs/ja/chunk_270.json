[{"type": "subtitle", "time": 16200.229, "timestamp": "04:30:00", "text": "炉の中では"}, {"type": "subtitle", "time": 16201.91, "timestamp": "04:30:01", "text": "かまどがレッドストーン信号を発する"}, {"type": "subtitle", "time": 16205.67, "timestamp": "04:30:05", "text": "中身の数によります。"}, {"type": "subtitle", "time": 16207.67, "timestamp": "04:30:07", "text": "さらに、比較器があり、"}, {"type": "subtitle", "time": 16209.429, "timestamp": "04:30:09", "text": "減算モードでは、"}, {"type": "subtitle", "time": 16211.269, "timestamp": "04:30:11", "text": "レッドストーン信号の量をオフセットする"}, {"type": "subtitle", "time": 16214.229, "timestamp": "04:30:14", "text": "それは炉から出力されるものです。あなたはできる"}, {"type": "subtitle", "time": 16216.189, "timestamp": "04:30:16", "text": "プラスを押すか、"}, {"type": "subtitle", "time": 16218.95, "timestamp": "04:30:18", "text": "Shiftキーを押しながらクリックすると、小さくなります。赤色"}, {"type": "subtitle", "time": 16220.91, "timestamp": "04:30:20", "text": "そして緑色の強化は"}, {"type": "subtitle", "time": 16223.11, "timestamp": "04:30:23", "text": "自明です、私は理解しています"}, {"type": "subtitle", "time": 16224.71, "timestamp": "04:30:24", "text": "青色の強化にはさらに"}, {"type": "subtitle", "time": 16226.309, "timestamp": "04:30:26", "text": "説明。ここに鉄製のセットがあります"}, {"type": "subtitle", "time": 16228.389, "timestamp": "04:30:28", "text": "論理的なアップグレードパスにある炉"}, {"type": "subtitle", "time": 16230.469, "timestamp": "04:30:30", "text": "鉄からネザライトへ。見てみましょう"}, {"type": "subtitle", "time": 16232.07, "timestamp": "04:30:32", "text": "彼らの後ろに。ご覧のとおり、"}, {"type": "subtitle", "time": 16235.229, "timestamp": "04:30:35", "text": "究極のエネルギーキューブによってケーブル接続された"}, {"type": "subtitle", "time": 16237.349, "timestamp": "04:30:37", "text": "機構。これで、それぞれに"}, {"type": "subtitle", "time": 16243.99, "timestamp": "04:30:43", "text": "出力。あらゆる形態のRFに注意してください"}, {"type": "subtitle", "time": 16245.91, "timestamp": "04:30:45", "text": "交通手段は機能するが、"}, {"type": "subtitle", "time": 16247.75, "timestamp": "04:30:47", "text": "例えば、私は単にメカニズムを利用しています。"}, {"type": "subtitle", "time": 16249.269, "timestamp": "04:30:49", "text": "それでは、"}, {"type": "subtitle", "time": 16251.59, "timestamp": "04:30:51", "text": "個々の炉のインターフェース。起動"}, {"type": "subtitle", "time": 16254.07, "timestamp": "04:30:54", "text": "鉄の場合、炉が"}, {"type": "subtitle", "time": 16256.71, "timestamp": "04:30:56", "text": "入力と出力のスロットが2つになりました。"}, {"type": "subtitle", "time": 16259.75, "timestamp": "04:30:59", "text": "それに加えて、エナジーバーとボタンも付いています。"}]
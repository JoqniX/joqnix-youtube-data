[{"type": "subtitle", "time": 6901.669, "timestamp": "01:55:01", "text": "私たちと同じように、私たちは墓を追加していません"}, {"type": "subtitle", "time": 6903.669, "timestamp": "01:55:03", "text": "今。それで"}, {"type": "subtitle", "time": 6905.35, "timestamp": "01:55:05", "text": "しかし、すでに3回のクールダウンを実施しました"}, {"type": "subtitle", "time": 6906.95, "timestamp": "01:55:06", "text": "今。"}, {"type": "subtitle", "time": 6910.39, "timestamp": "01:55:10", "text": "うん、でもそうだよ、もし"}, {"type": "subtitle", "time": 6912.47, "timestamp": "01:55:12", "text": "物をなくす心配はないんですね？"}, {"type": "subtitle", "time": 6915.27, "timestamp": "01:55:15", "text": "そうそう。確かに、確かに。"}, {"type": "subtitle", "time": 6917.35, "timestamp": "01:55:17", "text": "このゲームはまだマインクラフトですか？うん、そうだね"}, {"type": "subtitle", "time": 6921.109, "timestamp": "01:55:21", "text": "は。えーと、それは飛行機で"}, {"type": "subtitle", "time": 6923.43, "timestamp": "01:55:23", "text": "航空機やその他が使用しているもの"}, {"type": "subtitle", "time": 6926.87, "timestamp": "01:55:26", "text": "工作道具。それでおしまい。うん、そうだよ"}, {"type": "subtitle", "time": 6928.709, "timestamp": "01:55:28", "text": "やはりそうだったか。"}, {"type": "subtitle", "time": 6931.03, "timestamp": "01:55:31", "text": "でも、手芸用品はすごくいいんだよね。私"}, {"type": "subtitle", "time": 6934.95, "timestamp": "01:55:34", "text": "機械のように追加できたらいいのに。"}, {"type": "subtitle", "time": 6936.87, "timestamp": "01:55:36", "text": "待って、追加してもいいですか？それは"}, {"type": "subtitle", "time": 6948.709, "timestamp": "01:55:48", "text": "アクション？浸けてみるよ。"}, {"type": "subtitle", "time": 6951.189, "timestamp": "01:55:51", "text": "あ、待って。あなたは絵画作品を作ることができます。"}, {"type": "subtitle", "time": 6954.39, "timestamp": "01:55:54", "text": "待って、絵画も追加すべきだ。芸術作品。"}, {"type": "subtitle", "time": 6956.47, "timestamp": "01:55:56", "text": "落書き。"}, {"type": "subtitle", "time": 6958.229, "timestamp": "01:55:58", "text": "好きなものを何でも追加できます。あなたが持っている"}, {"type": "subtitle", "time": 6959.51, "timestamp": "01:55:59", "text": "コンソールのことですよね？それは"}]
[{"type": "subtitle", "time": 10628.79, "timestamp": "02:57:08", "text": "ああ、ぜひランニングイベントに来てください。病気"}, {"type": "subtitle", "time": 10631.51, "timestamp": "02:57:11", "text": "来る。あなたにあげます"}, {"type": "subtitle", "time": 10641.03, "timestamp": "02:57:21", "text": "私は基地にいます。"}, {"type": "subtitle", "time": 10644.309, "timestamp": "02:57:24", "text": "君の後ろを振り返るよ。そうそう。こちらです。"}, {"type": "subtitle", "time": 10647.55, "timestamp": "02:57:27", "text": "あなたに"}, {"type": "subtitle", "time": 10653.03, "timestamp": "02:57:33", "text": "ウクレレ。はい、どうぞ。おお。わかった。何？"}, {"type": "subtitle", "time": 10656.79, "timestamp": "02:57:36", "text": "嘘つきもいますよ、もしよろしければ。"}, {"type": "subtitle", "time": 10660.19, "timestamp": "02:57:40", "text": "いいえ。どうやって待つか、クリックしないでください"}, {"type": "subtitle", "time": 10663.03, "timestamp": "02:57:43", "text": "アドバンテージ。そして楽器は"}, {"type": "subtitle", "time": 10667.99, "timestamp": "02:57:47", "text": "非公式でファンによるもので、決して"}, {"type": "subtitle", "time": 10675.23, "timestamp": "02:57:55", "text": "おお"}, {"type": "subtitle", "time": 10679.87, "timestamp": "02:57:59", "text": "いいえ、あります。ああ、私は作りました"}]
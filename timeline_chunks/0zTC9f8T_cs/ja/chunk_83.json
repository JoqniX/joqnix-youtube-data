[{"type": "subtitle", "time": 4987.189, "timestamp": "01:23:07", "text": "軍艦。少しだけ入れてもらえますか？"}, {"type": "subtitle", "time": 4990.629, "timestamp": "01:23:10", "text": "よし、アップグレード用のものを"}, {"type": "subtitle", "time": 4993.75, "timestamp": "01:23:13", "text": "まず壁の胸。出てくる。来る"}, {"type": "subtitle", "time": 4996.87, "timestamp": "01:23:16", "text": "外。染料をください。染料をください。どれでも"}, {"type": "subtitle", "time": 5000.47, "timestamp": "01:23:20", "text": "ご希望の色。そして3つのスタックをください"}, {"type": "subtitle", "time": 5003.669, "timestamp": "01:23:23", "text": "石炭ブロックの。"}, {"type": "subtitle", "time": 5006.03, "timestamp": "01:23:26", "text": "わかりました、"}, {"type": "subtitle", "time": 5010.59, "timestamp": "01:23:30", "text": "胸の中で死ぬ"}, {"type": "subtitle", "time": 5014.629, "timestamp": "01:23:34", "text": "軍艦とTNTもいくつか手に入れて、"}, {"type": "subtitle", "time": 5019.55, "timestamp": "01:23:39", "text": "推測。つまり、染料とTNTってことですよね？死ぬ、"}, {"type": "subtitle", "time": 5021.149, "timestamp": "01:23:41", "text": "TNT、"}, {"type": "subtitle", "time": 5023.75, "timestamp": "01:23:43", "text": "えーと、アップグレードみたいなもの"}, {"type": "subtitle", "time": 5026.55, "timestamp": "01:23:46", "text": "効率的だと思うものなら何でも。"}, {"type": "subtitle", "time": 5028.87, "timestamp": "01:23:48", "text": "私は工業用歯車を持っています。私はネザーを持っています"}, {"type": "subtitle", "time": 5031.83, "timestamp": "01:23:51", "text": "エンジン。私はプロペラを持っています。 Steamを持っています"}, {"type": "subtitle", "time": 5035.35, "timestamp": "01:23:55", "text": "ボイラー。私は耐久性がある。私は、"}, {"type": "subtitle", "time": 5038.11, "timestamp": "01:23:58", "text": "援軍が来る。何かが必要だ"}]
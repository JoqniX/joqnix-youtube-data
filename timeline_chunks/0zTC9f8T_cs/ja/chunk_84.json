[{"type": "subtitle", "time": 5041.51, "timestamp": "01:24:01", "text": "むしろ、私が着陸を担当する、といった感じだ。そうします"}, {"type": "subtitle", "time": 5044.709, "timestamp": "01:24:04", "text": "着陸装置。着陸装置が必要だ。"}, {"type": "subtitle", "time": 5048.47, "timestamp": "01:24:08", "text": "でも、どこが"}, {"type": "subtitle", "time": 5056.629, "timestamp": "01:24:16", "text": "わかった。この在庫"}, {"type": "subtitle", "time": 5065.59, "timestamp": "01:24:25", "text": "ええと、石炭を他の燃料と同じように入れてください"}, {"type": "subtitle", "time": 5071.11, "timestamp": "01:24:31", "text": "ああ、あなたの"}, {"type": "subtitle", "time": 5074.91, "timestamp": "01:24:34", "text": "プレイヤーのインベントリはこちら。いや、いや、いや、いや、"}, {"type": "subtitle", "time": 5077.35, "timestamp": "01:24:37", "text": "いいえ。ところで、あなたは癌を患っています。あなた"}, {"type": "subtitle", "time": 5080.31, "timestamp": "01:24:40", "text": "大砲は正しいですか？ああ、どうやって"}, {"type": "subtitle", "time": 5084.31, "timestamp": "01:24:44", "text": "大砲を使うのか？そうねぇ。右クリック。"}, {"type": "subtitle", "time": 5088.03, "timestamp": "01:24:48", "text": "右クリック。いいえ、そうではありません"}, {"type": "subtitle", "time": 5090.55, "timestamp": "01:24:50", "text": "仕事。そうねぇ。そうねぇ。あなたには"}, {"type": "subtitle", "time": 5096.87, "timestamp": "01:24:56", "text": "コントロール。"}]
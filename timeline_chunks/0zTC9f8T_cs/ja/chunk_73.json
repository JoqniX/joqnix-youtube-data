[{"type": "subtitle", "time": 4392.63, "timestamp": "01:13:12", "text": "わかった。えっと、どこを見落としたんだろう？こんにちは。"}, {"type": "subtitle", "time": 4395.83, "timestamp": "01:13:15", "text": "ああ、わかった。分かりますよ。墜落した"}, {"type": "subtitle", "time": 4398.55, "timestamp": "01:13:18", "text": "こっちの方だ。"}, {"type": "subtitle", "time": 4401.59, "timestamp": "01:13:21", "text": "待って、今降りるよ。"}, {"type": "subtitle", "time": 4408.709, "timestamp": "01:13:28", "text": "互換性のない製品が見つかりましたと表示されます。"}, {"type": "subtitle", "time": 4423.189, "timestamp": "01:13:43", "text": "あなたは水中にいますか？うん。えっと、私は"}, {"type": "subtitle", "time": 4427.27, "timestamp": "01:13:47", "text": "あなたの頭上に浮かんでいる。よし、生きてるよ。"}, {"type": "subtitle", "time": 4428.87, "timestamp": "01:13:48", "text": "死にかけている。"}, {"type": "subtitle", "time": 4435.189, "timestamp": "01:13:55", "text": "地図にイルカが描かれているのですか？はい、それは"}, {"type": "subtitle", "time": 4437.75, "timestamp": "01:13:57", "text": "地図上のイルカ。"}, {"type": "subtitle", "time": 4439.63, "timestamp": "01:13:59", "text": "わかった、私は食べるだけ"}]
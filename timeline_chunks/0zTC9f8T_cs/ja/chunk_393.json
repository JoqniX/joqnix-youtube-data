[{"type": "subtitle", "time": 23583.59, "timestamp": "06:33:03", "text": "入って、兄弟。入ってこない。入ってこない。"}, {"type": "subtitle", "time": 23593.468, "timestamp": "06:33:13", "text": "兄弟。"}, {"type": "subtitle", "time": 23596.43, "timestamp": "06:33:16", "text": "ああ、わからない"}, {"type": "subtitle", "time": 23600.788, "timestamp": "06:33:20", "text": "それ。わかった。そうするしかないんです。私は持っている"}, {"type": "chat", "time": 23617.223, "timestamp": "06:33:37", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "Uk that is pointless"}, {"type": "subtitle", "time": 23619.35, "timestamp": "06:33:39", "text": "中に入った。これで詰まってしまった。なぜ動かなくなったのですか？"}, {"type": "subtitle", "time": 23623.628, "timestamp": "06:33:43", "text": "入れろ。入れろ。ああ、まだ入るぞ。"}, {"type": "subtitle", "time": 23626.19, "timestamp": "06:33:46", "text": "ああ、それは"}, {"type": "subtitle", "time": 23629.03, "timestamp": "06:33:49", "text": "無意味だ。うん、今から始めよう"}, {"type": "subtitle", "time": 23632.468, "timestamp": "06:33:52", "text": "これは無意味に感じる。"}, {"type": "subtitle", "time": 23635.43, "timestamp": "06:33:55", "text": "しかし、ある意味では、たくさんのアイテムがあります"}, {"type": "subtitle", "time": 23638.75, "timestamp": "06:33:58", "text": "そしてあなたはただ投げ捨てたいだけ"}]
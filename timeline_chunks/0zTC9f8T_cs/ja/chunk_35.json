[{"type": "subtitle", "time": 2101.03, "timestamp": "00:35:01", "text": "ああ、なるほど。"}, {"type": "subtitle", "time": 2104.71, "timestamp": "00:35:04", "text": "なるほど。しばらく見てみると"}, {"type": "subtitle", "time": 2107.19, "timestamp": "00:35:07", "text": "髪の毛の中に。でも、まあいいか。"}, {"type": "subtitle", "time": 2116.31, "timestamp": "00:35:16", "text": "私があなたにオーラルセックスをしているのが見えるでしょう。そうではありません"}, {"type": "subtitle", "time": 2120.71, "timestamp": "00:35:20", "text": "ニース。君が僕にオーラルセックスをしてくれているのが感じられるよ。"}, {"type": "subtitle", "time": 2134.31, "timestamp": "00:35:34", "text": "えっと"}, {"type": "subtitle", "time": 2136.87, "timestamp": "00:35:36", "text": "えーとアレクサンダーはもっとモルを追加して"}, {"type": "subtitle", "time": 2139.589, "timestamp": "00:35:39", "text": "modフォルダを開き、modを配置します。それで"}, {"type": "subtitle", "time": 2142.19, "timestamp": "00:35:42", "text": "あるだろう"}, {"type": "subtitle", "time": 2146.19, "timestamp": "00:35:46", "text": "さらに、または追加する。ああ、わかりました。"}, {"type": "subtitle", "time": 2149.589, "timestamp": "00:35:49", "text": "だから、なんとなく理解できたような気がする。わかった。"}, {"type": "subtitle", "time": 2153.15, "timestamp": "00:35:53", "text": "新しいフォルダディレクトリ。必ずやり遂げる"}, {"type": "subtitle", "time": 2154.67, "timestamp": "00:35:54", "text": "モッズ"}, {"type": "subtitle", "time": 2158.55, "timestamp": "00:35:58", "text": "新しいディレクトリを作成しますか？"}]
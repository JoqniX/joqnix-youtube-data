[{"type": "subtitle", "time": 6720.87, "timestamp": "01:52:00", "text": "逃げる。"}, {"type": "subtitle", "time": 6724.03, "timestamp": "01:52:04", "text": "えーっと、あなたの"}, {"type": "subtitle", "time": 6728.39, "timestamp": "01:52:08", "text": "ヘルメットをかぶる。"}, {"type": "subtitle", "time": 6733.03, "timestamp": "01:52:13", "text": "どうやって頭部を完全に除去するのですか？"}, {"type": "subtitle", "time": 6736.709, "timestamp": "01:52:16", "text": "彼女がそうするのはバグだと思う"}, {"type": "subtitle", "time": 6740.47, "timestamp": "01:52:20", "text": "私のように逃げ出そう。ああ、私を見てごらん。"}, {"type": "subtitle", "time": 6744.07, "timestamp": "01:52:24", "text": "しかし、あなたの頭は"}, {"type": "subtitle", "time": 6747.39, "timestamp": "01:52:27", "text": "今は公式版を使っているからだと思う。"}, {"type": "subtitle", "time": 6750.55, "timestamp": "01:52:30", "text": "公式には私も持っているはずです"}, {"type": "subtitle", "time": 6752.229, "timestamp": "01:52:32", "text": "それ。"}, {"type": "subtitle", "time": 6754.39, "timestamp": "01:52:34", "text": "私は公式版を使用しています。"}, {"type": "subtitle", "time": 6758.149, "timestamp": "01:52:38", "text": "つまり、これはよくある不具合です。"}, {"type": "subtitle", "time": 6761.03, "timestamp": "01:52:41", "text": "それが何を作っているのか分かりません。"}, {"type": "subtitle", "time": 6768.79, "timestamp": "01:52:48", "text": "ああ、忘れてた。信じることは今はそうではない"}, {"type": "subtitle", "time": 6771.75, "timestamp": "01:52:51", "text": "試合の展開を今見ています。あ、すみません。"}, {"type": "subtitle", "time": 6776.149, "timestamp": "01:52:56", "text": "彼らはただ虚無を見るだけだろう。"}, {"type": "subtitle", "time": 6779.83, "timestamp": "01:52:59", "text": "え、何？なぜ？だって私は参加してるから"}]
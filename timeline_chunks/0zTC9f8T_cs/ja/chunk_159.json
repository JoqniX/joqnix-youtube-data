[{"type": "subtitle", "time": 9540.63, "timestamp": "02:39:00", "text": "宝箱を開けたら、そこでクラッシュした"}, {"type": "subtitle", "time": 9543.19, "timestamp": "02:39:03", "text": "ポイント。"}, {"type": "subtitle", "time": 9545.11, "timestamp": "02:39:05", "text": "ああ、それは、待って、もう一度確認させてください"}, {"type": "subtitle", "time": 9548.23, "timestamp": "02:39:08", "text": "私がインストールしたものを確認してください。"}, {"type": "subtitle", "time": 9551.11, "timestamp": "02:39:11", "text": "もう一度見せてください。ええ、胸は"}, {"type": "subtitle", "time": 9553.51, "timestamp": "02:39:13", "text": "クラッシュさせている。"}, {"type": "subtitle", "time": 9555.91, "timestamp": "02:39:15", "text": "本当に？うん、削除する必要があると思う"}, {"type": "subtitle", "time": 9558.15, "timestamp": "02:39:18", "text": "胸。"}, {"type": "subtitle", "time": 9560.389, "timestamp": "02:39:20", "text": "いや、待って。本当に？待って、君は"}, {"type": "subtitle", "time": 9563.67, "timestamp": "02:39:23", "text": "チェック？はい、そうしました。はい、そうしました。もう一度確認しました。"}, {"type": "subtitle", "time": 9567.51, "timestamp": "02:39:27", "text": "ああ、胸部。インストールできません。私は"}, {"type": "subtitle", "time": 9570.23, "timestamp": "02:39:30", "text": "私のMODからも削除する必要がありますか？"}, {"type": "subtitle", "time": 9572.71, "timestamp": "02:39:32", "text": "なんてこった。いいえ、大丈夫です。作れますよ"}, {"type": "subtitle", "time": 9574.95, "timestamp": "02:39:34", "text": "再読み込みできます。自動的に"}, {"type": "subtitle", "time": 9578.55, "timestamp": "02:39:38", "text": "ログイン時に削除してください。"}, {"type": "subtitle", "time": 9581.55, "timestamp": "02:39:41", "text": "それが果たすべき役割。もう一度確認させてください"}, {"type": "subtitle", "time": 9585.51, "timestamp": "02:39:45", "text": "それ。うん。うん。常に携帯してください。そして"}, {"type": "subtitle", "time": 9587.91, "timestamp": "02:39:47", "text": "あなたたち二人が何を話しているのか、私には全く分かりません。"}, {"type": "subtitle", "time": 9590.309, "timestamp": "02:39:50", "text": "について。"}, {"type": "subtitle", "time": 9592.55, "timestamp": "02:39:52", "text": "心配ない。"}, {"type": "subtitle", "time": 9595.71, "timestamp": "02:39:55", "text": "ええ、布地とよく似ていますね。今ならできる"}, {"type": "subtitle", "time": 9599.309, "timestamp": "02:39:59", "text": "リサイクルするだけ"}]
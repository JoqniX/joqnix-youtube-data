[{"type": "subtitle", "time": 16140.309, "timestamp": "04:29:00", "text": "この構成の炉。欲しい"}, {"type": "subtitle", "time": 16142.469, "timestamp": "04:29:02", "text": "この宝箱から鉱石を加工する"}, {"type": "subtitle", "time": 16143.75, "timestamp": "04:29:03", "text": "炉と自動的に"}, {"type": "subtitle", "time": 16145.59, "timestamp": "04:29:05", "text": "このチェストに出力してください。私たちは"}, {"type": "subtitle", "time": 16147.269, "timestamp": "04:29:07", "text": "炉と側面を構成する"}, {"type": "subtitle", "time": 16151.189, "timestamp": "04:29:11", "text": "初め。左側に入力し、次に出力する"}, {"type": "subtitle", "time": 16153.269, "timestamp": "04:29:13", "text": "右側に。燃料を"}, {"type": "subtitle", "time": 16155.99, "timestamp": "04:29:15", "text": "炉を設置してから、必要な鉱石を配置します。"}, {"type": "subtitle", "time": 16159.189, "timestamp": "04:29:19", "text": "この箱に詰め込まれた。次に有効にする"}, {"type": "subtitle", "time": 16161.389, "timestamp": "04:29:21", "text": "自動入力、そして自動"}, {"type": "subtitle", "time": 16163.83, "timestamp": "04:29:23", "text": "出力。炉はその後開始するはずです"}, {"type": "subtitle", "time": 16165.99, "timestamp": "04:29:25", "text": "鉱石を精錬する。そしてこれを見てみると"}, {"type": "subtitle", "time": 16167.83, "timestamp": "04:29:27", "text": "胸には鉄が入っているのがわかる"}, {"type": "subtitle", "time": 16169.429, "timestamp": "04:29:29", "text": "ここにインゴットがあります。炉が欲しいとしましょう"}, {"type": "subtitle", "time": 16170.87, "timestamp": "04:29:30", "text": "特定の状況下でのみオンになる"}, {"type": "subtitle", "time": 16173.349, "timestamp": "04:29:33", "text": "レッドストーン信号がアクティブになっています。単に置くだけ"}, {"type": "subtitle", "time": 16175.03, "timestamp": "04:29:35", "text": "炉の上に肝臓を置いて"}, {"type": "subtitle", "time": 16176.87, "timestamp": "04:29:36", "text": "次に、そのレッドストーン信号をハイに設定します。"}, {"type": "subtitle", "time": 16177.83, "timestamp": "04:29:37", "text": "炉は停止するはずです"}, {"type": "subtitle", "time": 16178.95, "timestamp": "04:29:38", "text": "自動的に存在しないため"}, {"type": "subtitle", "time": 16180.63, "timestamp": "04:29:40", "text": "レッドストーン信号が適用され、"}, {"type": "subtitle", "time": 16182.79, "timestamp": "04:29:42", "text": "レバーを操作してください。炉は"}, {"type": "subtitle", "time": 16184.63, "timestamp": "04:29:44", "text": "それから電源を入れてください。レバーをオフにすると、"}, {"type": "subtitle", "time": 16186.07, "timestamp": "04:29:46", "text": "暖房装置が再び停止する。そういうことです"}, {"type": "subtitle", "time": 16187.83, "timestamp": "04:29:47", "text": "かまどはレッドストーンで制御します。"}, {"type": "subtitle", "time": 16189.429, "timestamp": "04:29:49", "text": "さらに、レッドストーンを制御することもできます。"}, {"type": "subtitle", "time": 16190.63, "timestamp": "04:29:50", "text": "コンパレータ自体を使用する"}, {"type": "subtitle", "time": 16192.469, "timestamp": "04:29:52", "text": "炉の機能性。シンプルに行こう"}, {"type": "subtitle", "time": 16193.75, "timestamp": "04:29:53", "text": "炉のインターフェースへ、"}, {"type": "subtitle", "time": 16195.11, "timestamp": "04:29:55", "text": "コンパレータモードを有効にする。の"}, {"type": "subtitle", "time": 16196.63, "timestamp": "04:29:56", "text": "炉は、まるで"}, {"type": "subtitle", "time": 16198.63, "timestamp": "04:29:58", "text": "それには比較器が取り付けられている。アイテムを配置する"}]
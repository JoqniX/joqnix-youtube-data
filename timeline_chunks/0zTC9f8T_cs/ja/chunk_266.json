[{"type": "subtitle", "time": 15962.95, "timestamp": "04:26:02", "text": "こんにちは、はじめにへようこそ"}, {"type": "subtitle", "time": 15964.63, "timestamp": "04:26:04", "text": "鉄炉のモッドのガイド"}, {"type": "subtitle", "time": 15966.469, "timestamp": "04:26:06", "text": "クラフトなどの情報を提供するmod"}, {"type": "subtitle", "time": 15968.07, "timestamp": "04:26:08", "text": "レシピを順を追って紹介します。ご覧ください"}, {"type": "subtitle", "time": 15969.67, "timestamp": "04:26:09", "text": "下記にリンクを貼るWikiをご覧ください。と"}, {"type": "subtitle", "time": 15971.03, "timestamp": "04:26:11", "text": "それはさておき、私の"}, {"type": "subtitle", "time": 15973.189, "timestamp": "04:26:13", "text": "クラフトでブロック自体をクラフトできます"}, {"type": "subtitle", "time": 15975.83, "timestamp": "04:26:15", "text": "このレシピで。既存のすべての炉"}, {"type": "subtitle", "time": 15977.349, "timestamp": "04:26:17", "text": "さて、それはさておき、"}, {"type": "subtitle", "time": 15980.149, "timestamp": "04:26:20", "text": "ボンネットの下を覗いてみよう。まず最初に"}, {"type": "subtitle", "time": 15981.75, "timestamp": "04:26:21", "text": "鉄炉について注意すべき点"}, {"type": "subtitle", "time": 15983.429, "timestamp": "04:26:23", "text": "インターフェースにはいくつかの追加機能があります"}, {"type": "subtitle", "time": 15985.429, "timestamp": "04:26:25", "text": "バニラの炉インターフェースから。の上"}, {"type": "subtitle", "time": 15986.55, "timestamp": "04:26:26", "text": "炉の左側"}, {"type": "subtitle", "time": 15988.469, "timestamp": "04:26:28", "text": "インターフェースでは、炉の"}, {"type": "subtitle", "time": 15990.63, "timestamp": "04:26:30", "text": "設定タブ。このタブを開くと"}, {"type": "subtitle", "time": 15993.429, "timestamp": "04:26:33", "text": "自動入力の設定オプションと"}, {"type": "subtitle", "time": 15997.389, "timestamp": "04:26:37", "text": "出力側入力と出力と"}, {"type": "subtitle", "time": 15999.59, "timestamp": "04:26:39", "text": "レッドストーン。インターフェースの上部には、"}, {"type": "subtitle", "time": 16001.269, "timestamp": "04:26:41", "text": "炉の名前のすぐ隣に、"}, {"type": "subtitle", "time": 16003.91, "timestamp": "04:26:43", "text": "拡張ボタンが表示されるはずです。クリック"}, {"type": "subtitle", "time": 16006.309, "timestamp": "04:26:46", "text": "これにより、炉の"}, {"type": "subtitle", "time": 16008.55, "timestamp": "04:26:48", "text": "メニューを拡張する。拡張、私のささやかな"}, {"type": "subtitle", "time": 16011.349, "timestamp": "04:26:51", "text": "意見こそが、このMODの真価を発揮する部分です。"}, {"type": "subtitle", "time": 16013.59, "timestamp": "04:26:53", "text": "このメニューでは、"}, {"type": "subtitle", "time": 16015.189, "timestamp": "04:26:55", "text": "ブラスト増強により炉は"}, {"type": "subtitle", "time": 16017.189, "timestamp": "04:26:57", "text": "まるで溶鉱炉のように振る舞う、"}, {"type": "subtitle", "time": 16019.03, "timestamp": "04:26:59", "text": "喫煙は"}]
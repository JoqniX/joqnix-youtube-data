[{"type": "subtitle", "time": 21840.868, "timestamp": "06:04:00", "text": "でも、これから何が起こるかはわからない"}, {"type": "subtitle", "time": 21844.23, "timestamp": "06:04:04", "text": "今日の私にとって。私は"}, {"type": "subtitle", "time": 21852.15, "timestamp": "06:04:12", "text": "など。あれ、コラボの予定があるっけ？"}, {"type": "subtitle", "time": 21854.67, "timestamp": "06:04:14", "text": "ああ、神様、私は手を差し伸べなければならない"}, {"type": "subtitle", "time": 21859.35, "timestamp": "06:04:19", "text": "えっと、そして試合を決める。動く。うん、"}, {"type": "subtitle", "time": 21865.23, "timestamp": "06:04:25", "text": "私はこの広告サンドボックスゲームを持っています"}, {"type": "subtitle", "time": 21868.19, "timestamp": "06:04:28", "text": "呼ばれる"}, {"type": "subtitle", "time": 21871.628, "timestamp": "06:04:31", "text": "ウランズ。うん、それは"}, {"type": "subtitle", "time": 21878.23, "timestamp": "06:04:38", "text": "ウランズ。ウランズはいいところだけどね。まるで"}, {"type": "subtitle", "time": 21880.788, "timestamp": "06:04:40", "text": "マインクラフトじゃなくて、うん。親切"}, {"type": "subtitle", "time": 21883.11, "timestamp": "06:04:43", "text": "Forest、Minecraft、その他すべて"}, {"type": "subtitle", "time": 21884.39, "timestamp": "06:04:44", "text": "ゲームの種類。"}, {"type": "subtitle", "time": 21886.99, "timestamp": "06:04:46", "text": "サンドボックスのクラフターで親切な人"}, {"type": "subtitle", "time": 21888.75, "timestamp": "06:04:48", "text": "の"}]
[{"type": "subtitle", "time": 26520.23, "timestamp": "07:22:00", "text": "それ。 Twitch がどのように機能するか見たいです"}, {"type": "subtitle", "time": 26523.948, "timestamp": "07:22:03", "text": "ああ、彼は変わったんだ。私は、私は、"}, {"type": "subtitle", "time": 26553.15, "timestamp": "07:22:33", "text": "ああ、"}, {"type": "subtitle", "time": 26557.27, "timestamp": "07:22:37", "text": "神。彼は自分の番号が来るまで待たなければならない"}, {"type": "subtitle", "time": 26561.628, "timestamp": "07:22:41", "text": "これ。なんてこった。大丈夫。ポップアップさせてください"}]
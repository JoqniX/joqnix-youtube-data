[{"type": "subtitle", "time": 22441.19, "timestamp": "06:14:01", "text": "名詞私が本当に欲しかったのは炉でした"}, {"type": "subtitle", "time": 22443.91, "timestamp": "06:14:03", "text": "マーク2と"}, {"type": "subtitle", "time": 22446.948, "timestamp": "06:14:06", "text": "鉄炉とより良い炉"}, {"type": "subtitle", "time": 22450.67, "timestamp": "06:14:10", "text": "更新します。三つ。この３人。わかった。これ"}, {"type": "subtitle", "time": 22454.31, "timestamp": "06:14:14", "text": "1つで3つの店舗が手に入ります"}, {"type": "subtitle", "time": 22457.67, "timestamp": "06:14:17", "text": "3カップまで。こっちの方がいい。いいえ、あなた"}, {"type": "subtitle", "time": 22460.39, "timestamp": "06:14:20", "text": "アップグレードしてください。燃料系のものがある。"}, {"type": "subtitle", "time": 22463.51, "timestamp": "06:14:23", "text": "ここに石炭をたくさん置けば"}, {"type": "subtitle", "time": 22466.548, "timestamp": "06:14:26", "text": "後で経験を集めます"}, {"type": "subtitle", "time": 22469.75, "timestamp": "06:14:29", "text": "あなたが望むなら。それはそれを保管します"}, {"type": "subtitle", "time": 22472.948, "timestamp": "06:14:32", "text": "そして出力は4になります。いいえ、しかし"}, {"type": "subtitle", "time": 22476.27, "timestamp": "06:14:36", "text": "これはバージョン1.19.2専用です"}, {"type": "subtitle", "time": 22485.15, "timestamp": "06:14:45", "text": "もう。それが悲しいところだ。それは"}, {"type": "subtitle", "time": 22490.39, "timestamp": "06:14:50", "text": "1つ。そして鉄炉だけが稼働する"}, {"type": "subtitle", "time": 22494.11, "timestamp": "06:14:54", "text": "1.2"}]
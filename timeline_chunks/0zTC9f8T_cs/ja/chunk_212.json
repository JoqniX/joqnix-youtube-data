[{"type": "subtitle", "time": 12720.269, "timestamp": "03:32:00", "text": "アストラル。"}, {"type": "subtitle", "time": 12731.71, "timestamp": "03:32:11", "text": "一つは、おそらく私の足でしょう。さあ"}, {"type": "subtitle", "time": 12755.229, "timestamp": "03:32:35", "text": "神。見えない"}, {"type": "subtitle", "time": 12758.63, "timestamp": "03:32:38", "text": "言葉。何？人生とは何か？ああ、ああ、ああ"}]
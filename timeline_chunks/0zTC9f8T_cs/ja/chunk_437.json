[{"type": "subtitle", "time": 26225.868, "timestamp": "07:17:05", "text": "ああ、みなさんこんにちは"}, {"type": "subtitle", "time": 26228.67, "timestamp": "07:17:08", "text": "また。こんにちは、またお会いしましたね。"}, {"type": "subtitle", "time": 26231.91, "timestamp": "07:17:11", "text": "えっと、私のモデルはどうなったんですか？そこにいる"}, {"type": "subtitle", "time": 26233.708, "timestamp": "07:17:13", "text": "行く。こんにちは"}, {"type": "subtitle", "time": 26236.43, "timestamp": "07:17:16", "text": "また。"}, {"type": "subtitle", "time": 26246.628, "timestamp": "07:17:26", "text": "えっと、私たちはしくじってしまった。ええ、そうです。ええと、私たちは"}, {"type": "subtitle", "time": 26249.27, "timestamp": "07:17:29", "text": "演奏する予定だった"}, {"type": "subtitle", "time": 26255.03, "timestamp": "07:17:35", "text": "えっと、1秒再生してください。えっと"}, {"type": "subtitle", "time": 26257.99, "timestamp": "07:17:37", "text": "えっと、ヴァレランをプレイする予定だったんだけど、"}, {"type": "subtitle", "time": 26260.15, "timestamp": "07:17:40", "text": "PCを再起動しなければならず、"}, {"type": "subtitle", "time": 26262.39, "timestamp": "07:17:42", "text": "すべてがうまくいかず、配信もめちゃくちゃになった。"}, {"type": "subtitle", "time": 26264.948, "timestamp": "07:17:44", "text": "私はヴァレラントとマーベルの両方をやりたかった"}, {"type": "subtitle", "time": 26268.868, "timestamp": "07:17:48", "text": "ライバルだが、失敗して以来"}, {"type": "subtitle", "time": 26271.75, "timestamp": "07:17:51", "text": "Rokuとのコラボ配信なので、"}, {"type": "subtitle", "time": 26273.99, "timestamp": "07:17:53", "text": "私はランキングに入っていません"}, {"type": "subtitle", "time": 26278.43, "timestamp": "07:17:58", "text": "えっと、またおかしくなったのは"}]
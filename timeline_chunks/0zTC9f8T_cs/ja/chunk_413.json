[{"type": "subtitle", "time": 24801.07, "timestamp": "06:53:21", "text": "罪悪感。そこにないのですか？ K I"}, {"type": "subtitle", "time": 24807.43, "timestamp": "06:53:27", "text": "わかった。ああ、新しいああ、"}, {"type": "subtitle", "time": 24811.35, "timestamp": "06:53:31", "text": "この煙、この調理器具。"}, {"type": "subtitle", "time": 24814.07, "timestamp": "06:53:34", "text": "殺人装置。私もそれを見ました。"}, {"type": "subtitle", "time": 24815.83, "timestamp": "06:53:35", "text": "うん。スモーカーとブラストを比較すると"}, {"type": "subtitle", "time": 24819.15, "timestamp": "06:53:39", "text": "石を精錬するための炉と"}, {"type": "subtitle", "time": 24821.59, "timestamp": "06:53:41", "text": "すべて。新型の暖房器具の臭い"}, {"type": "subtitle", "time": 24823.83, "timestamp": "06:53:43", "text": "マニラで作れるレシピ。"}, {"type": "subtitle", "time": 24826.83, "timestamp": "06:53:46", "text": "高炉または"}, {"type": "subtitle", "time": 24829.99, "timestamp": "06:53:49", "text": "喫煙者。わかった。粘土の塊から作られたレンガ。"}, {"type": "subtitle", "time": 24832.35, "timestamp": "06:53:52", "text": "Bログから作られた木炭"}, {"type": "subtitle", "time": 24835.27, "timestamp": "06:53:55", "text": "やけど。ああ、また割れた。わかった。ガラス"}]
[{"type": "subtitle", "time": 26820.548, "timestamp": "07:27:00", "text": "これを使っています。ダウンロードされていません"}, {"type": "subtitle", "time": 26822.388, "timestamp": "07:27:02", "text": "何でも。これはパッチ適用です。だから、私は思う"}, {"type": "subtitle", "time": 26824.628, "timestamp": "07:27:04", "text": "ファイルをチェックして実行するだけです"}, {"type": "subtitle", "time": 26826.788, "timestamp": "07:27:06", "text": "それ。わかりました、簡単な試合をお見せします"}, {"type": "subtitle", "time": 26829.35, "timestamp": "07:27:09", "text": "それまで。ああ、じゃあ君のプレーを見てるよ。"}, {"type": "subtitle", "time": 26833.19, "timestamp": "07:27:13", "text": "配信で見せますよ。うん、"}, {"type": "subtitle", "time": 26835.91, "timestamp": "07:27:15", "text": "このゲームの遊び方を説明します。あなたがやる"}, {"type": "subtitle", "time": 26838.948, "timestamp": "07:27:18", "text": "このゲームのやり方がわからないんだよ。"}, {"type": "subtitle", "time": 26841.99, "timestamp": "07:27:21", "text": "あなたは聞いたことがありますか"}, {"type": "subtitle", "time": 26845.99, "timestamp": "07:27:25", "text": "あの有名なゲーム、オーバーウォッチのことですか？はい。"}, {"type": "subtitle", "time": 26855.03, "timestamp": "07:27:35", "text": "ちなみに、無料のスキンがもらえますよ。えっと、私は"}, {"type": "subtitle", "time": 26857.03, "timestamp": "07:27:37", "text": "メッセージをピン留めする方法がわかりません"}, {"type": "subtitle", "time": 26863.31, "timestamp": "07:27:43", "text": "ここ？はい、できますよ。そして、そして、"}, {"type": "subtitle", "time": 26867.83, "timestamp": "07:27:47", "text": "えっと、なんて呼ぶんだっけ？トゥイッチ。"}, {"type": "subtitle", "time": 26875.99, "timestamp": "07:27:55", "text": "私に無料のアイアンマンスキンコードを与えると、"}]
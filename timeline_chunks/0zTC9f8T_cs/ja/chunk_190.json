[{"type": "subtitle", "time": 11406.95, "timestamp": "03:10:06", "text": "水。はい、わかりました。わかった。しかし、どのように"}, {"type": "subtitle", "time": 11415.51, "timestamp": "03:10:15", "text": "ああ、これはちょっと厄介で難しいですね。私"}, {"type": "subtitle", "time": 11416.91, "timestamp": "03:10:16", "text": "行き方を知っている"}, {"type": "subtitle", "time": 11419.429, "timestamp": "03:10:19", "text": "内部。シフト。"}, {"type": "subtitle", "time": 11422.87, "timestamp": "03:10:22", "text": "私は今、水中にいます。"}, {"type": "subtitle", "time": 11438.269, "timestamp": "03:10:38", "text": "ミツキ死ぬの？どこ"}, {"type": "subtitle", "time": 11441.11, "timestamp": "03:10:41", "text": "彼女？ええと、彼女は基地にいます。彼女は"}, {"type": "subtitle", "time": 11442.87, "timestamp": "03:10:42", "text": "ベース。"}, {"type": "subtitle", "time": 11448.349, "timestamp": "03:10:48", "text": "はい、彼女に少し時間をください。そうそう。"}, {"type": "subtitle", "time": 11449.95, "timestamp": "03:10:49", "text": "TP"}, {"type": "subtitle", "time": 11452.67, "timestamp": "03:10:52", "text": "暗闇。それは"}]
[{"type": "subtitle", "time": 1080.95, "timestamp": "00:18:00", "text": "不明な自動車に接続しています"}, {"type": "subtitle", "time": 1083.59, "timestamp": "00:18:03", "text": "モードパック。"}, {"type": "subtitle", "time": 1086.71, "timestamp": "00:18:06", "text": "サーバーの証明書を確認してください"}, {"type": "subtitle", "time": 1096.23, "timestamp": "00:18:16", "text": "オートモードすら追加していません。ああ、君"}, {"type": "subtitle", "time": 1098.549, "timestamp": "00:18:18", "text": "教えて。なぜ？なぜゲームを起動したのか"}, {"type": "subtitle", "time": 1112.31, "timestamp": "00:18:32", "text": "えーと、それで、modパックを編集した後、"}, {"type": "subtitle", "time": 1115.75, "timestamp": "00:18:35", "text": "同期ファイルとかえっと、君は"}, {"type": "subtitle", "time": 1119.27, "timestamp": "00:18:39", "text": "更新するにはコマンドを再実行する必要があります"}, {"type": "subtitle", "time": 1125.75, "timestamp": "00:18:45", "text": "指紋は持っていません"}, {"type": "subtitle", "time": 1130.669, "timestamp": "00:18:50", "text": "セキュリティチェックでこれを防ぐにはどうすればいいですか？"}, {"type": "subtitle", "time": 1139.27, "timestamp": "00:18:59", "text": "OKを確認するにはどうすればいいですか？わかった。何"}]
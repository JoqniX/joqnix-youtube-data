[{"type": "subtitle", "time": 7081.51, "timestamp": "01:58:01", "text": "知る。君たちがなぜ"}, {"type": "subtitle", "time": 7089.27, "timestamp": "01:58:09", "text": "えっと、なんで笑ってたのか自分でもわからない。"}, {"type": "subtitle", "time": 7092.03, "timestamp": "01:58:12", "text": "うん、君は"}, {"type": "chat", "time": 7092.365, "timestamp": "01:58:12", "author": "@saii.", "avatar": "https://yt4.ggpht.com/3zUIW6dAQ6Lr5vLl0lqQ1SDX6_FlSHF5uPT02PbCpi3rR1u3H4KK3Clvc3h4GwayKUCSUkNFr_Y=s64-c-k-c0x00ffffff-no-rj", "message": "yeah, bro... yesss"}, {"type": "subtitle", "time": 7096.149, "timestamp": "01:58:16", "text": "間違いなくレッドストーン、羊、竹、蜂です。"}, {"type": "subtitle", "time": 7099.51, "timestamp": "01:58:19", "text": "レッドストーン羊の戦い。レッドストーン羊"}, {"type": "chat", "time": 7101.507, "timestamp": "01:58:21", "author": "@BRUCELEE-wt7hk", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kywKa6HSckNVxhER8qedLRRVkcGIqFFytjQHe-071HyMo=s64-c-k-c0x00ffffff-no-rj", "message": "machinery"}, {"type": "subtitle", "time": 7102.39, "timestamp": "01:58:22", "text": "自動フォームのようなものです。検出します"}, {"type": "subtitle", "time": 7104.55, "timestamp": "01:58:24", "text": "草、植物、近接収穫"}, {"type": "subtitle", "time": 7106.229, "timestamp": "01:58:26", "text": "彼ら。燃料切れでアイドリングすると、"}, {"type": "subtitle", "time": 7108.31, "timestamp": "01:58:28", "text": "元の位置に戻ります。何てことだ、"}, {"type": "subtitle", "time": 7110.79, "timestamp": "01:58:30", "text": "それは羊です。"}, {"type": "subtitle", "time": 7112.709, "timestamp": "01:58:32", "text": "ああ、いくつかのモッドがあった"}, {"type": "subtitle", "time": 7114.95, "timestamp": "01:58:34", "text": "かっこいいゴーレムたち。私は作りたくなかった"}, {"type": "subtitle", "time": 7117.149, "timestamp": "01:58:37", "text": "このゲームはRPG要素が強すぎる。"}, {"type": "chat", "time": 7117.722, "timestamp": "01:58:37", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "missionary stuff > machinery stuff"}, {"type": "subtitle", "time": 7119.589, "timestamp": "01:58:39", "text": "右？私は普通になりたかった"}, {"type": "chat", "time": 7121.015, "timestamp": "01:58:41", "author": "@tengenUzui_flashy1", "avatar": "https://yt4.ggpht.com/U4bubkmDa5_iTX7UhU8yE4NYF3WqbD1yjlX5vpRZK99vtN8boUL9ZV-pbM8qJhCV69RI6ILr=s64-c-k-c0x00ffffff-no-rj", "message": "The Missionary Stuffs..."}, {"type": "subtitle", "time": 7122.669, "timestamp": "01:58:42", "text": "マインクラフト。楽しいマインクラフト。"}, {"type": "subtitle", "time": 7126.47, "timestamp": "01:58:46", "text": "ええ、ドリルには興味があります。えっと、"}, {"type": "subtitle", "time": 7129.43, "timestamp": "01:58:49", "text": "土を容易に掘り進むことができる。だから、"}, {"type": "subtitle", "time": 7131.55, "timestamp": "01:58:51", "text": "発掘。あなたは手に入れますか"}, {"type": "subtitle", "time": 7135.109, "timestamp": "01:58:55", "text": "ブロック？もしそれが[ __ ]なら、あなたはどうですか"}, {"type": "subtitle", "time": 7138.109, "timestamp": "01:58:58", "text": "そんなに速く走っているの？さあ"}]
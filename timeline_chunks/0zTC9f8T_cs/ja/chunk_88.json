[{"type": "subtitle", "time": 5281.99, "timestamp": "01:28:01", "text": "あ、待って。えっと、"}, {"type": "subtitle", "time": 5286.709, "timestamp": "01:28:06", "text": "ライト。えっと、ちょっと確認させてください。"}, {"type": "subtitle", "time": 5293.59, "timestamp": "01:28:13", "text": "えっと、なんていう名前ですか？没入型"}, {"type": "subtitle", "time": 5313.83, "timestamp": "01:28:33", "text": "おお。待って、降りてくるよ。私たちには必要だ"}, {"type": "subtitle", "time": 5322.07, "timestamp": "01:28:42", "text": "いじってみる価値のあるもの。私は"}, {"type": "subtitle", "time": 5333.189, "timestamp": "01:28:53", "text": "蘇生させてくれませんか？射撃。"}]
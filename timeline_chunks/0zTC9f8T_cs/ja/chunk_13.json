[{"type": "subtitle", "time": 782.23, "timestamp": "00:13:02", "text": "いいえ。私は"}, {"type": "subtitle", "time": 784.949, "timestamp": "00:13:04", "text": "待って。何もするな。では、待ってください。"}, {"type": "subtitle", "time": 790.91, "timestamp": "00:13:10", "text": "えーっと、1 2 3 4 5 6"}, {"type": "subtitle", "time": 793.91, "timestamp": "00:13:13", "text": "7 このMODを追加する必要があるんですよね？ 15 14。"}, {"type": "subtitle", "time": 801.069, "timestamp": "00:13:21", "text": "はい。 15 16 17 18 19 20 21 22 23 34 35 36"}, {"type": "subtitle", "time": 805.67, "timestamp": "00:13:25", "text": "37 待って、なぜ27なの？え、何？ 1 2 3"}, {"type": "subtitle", "time": 809.829, "timestamp": "00:13:29", "text": "4 6 27 mod。いいえ、"}, {"type": "subtitle", "time": 811.99, "timestamp": "00:13:31", "text": "31ですよね？"}, {"type": "subtitle", "time": 815.55, "timestamp": "00:13:35", "text": "1 2 3 4 5 6 7"}, {"type": "subtitle", "time": 819.67, "timestamp": "00:13:39", "text": "3 11 12 13"}, {"type": "subtitle", "time": 823.19, "timestamp": "00:13:43", "text": "13 14 15 16"}, {"type": "subtitle", "time": 825.11, "timestamp": "00:13:45", "text": "正気か？アストラ、君は何者なんだ？"}, {"type": "subtitle", "time": 830.87, "timestamp": "00:13:50", "text": "4、5、6、7。グループ内で"}, {"type": "subtitle", "time": 832.55, "timestamp": "00:13:52", "text": "仕事です、この自動モードパックを送ってください。"}, {"type": "subtitle", "time": 834.47, "timestamp": "00:13:54", "text": "皆さんが必要としているので、ダウンロードしてください"}, {"type": "subtitle", "time": 836.629, "timestamp": "00:13:56", "text": "それ。あなたにとって面倒なことにはならないでしょう"}, {"type": "subtitle", "time": 839.269, "timestamp": "00:13:59", "text": "これさえ持っていれば、もう何もいらないですよね？"}]
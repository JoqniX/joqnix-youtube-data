[{"type": "subtitle", "time": 3756.069, "timestamp": "01:02:36", "text": "よし、ゲームを起動する。期待しよう"}, {"type": "subtitle", "time": 3757.87, "timestamp": "01:02:37", "text": "それ"}, {"type": "subtitle", "time": 3759.789, "timestamp": "01:02:39", "text": "作品。"}, {"type": "subtitle", "time": 3769.75, "timestamp": "01:02:49", "text": "実は私もそのゲームに参加しているんです。わかった。わかった。"}, {"type": "subtitle", "time": 3772.109, "timestamp": "01:02:52", "text": "うん。待って。お見せします"}, {"type": "subtitle", "time": 3777.109, "timestamp": "01:02:57", "text": "何か。これを追加してください。そして、こちらへ来てください。"}]
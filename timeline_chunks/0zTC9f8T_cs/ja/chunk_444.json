[{"type": "subtitle", "time": 26646.19, "timestamp": "07:24:06", "text": "わかった。ああ、チャットを共有しよう。それ"}, {"type": "subtitle", "time": 26648.788, "timestamp": "07:24:08", "text": "作品。わーい。"}, {"type": "subtitle", "time": 26652.11, "timestamp": "07:24:12", "text": "はい、チャットに参加しています"}, {"type": "subtitle", "time": 26655.59, "timestamp": "07:24:15", "text": "チャット。ああ、こんにちは。"}, {"type": "subtitle", "time": 26663.23, "timestamp": "07:24:23", "text": "はい、おっしゃることは分かります。"}, {"type": "subtitle", "time": 26666.628, "timestamp": "07:24:26", "text": "うん。それは富士の技術です。それは富士のカメラです"}, {"type": "subtitle", "time": 26677.43, "timestamp": "07:24:37", "text": "これが有名なフリーザです。私はそうではない"}, {"type": "subtitle", "time": 26679.75, "timestamp": "07:24:39", "text": "フリーザの有名な声優。私は決して"}, {"type": "subtitle", "time": 26682.07, "timestamp": "07:24:42", "text": "ちなみに、猿はそう言った。そして私は"}, {"type": "subtitle", "time": 26683.31, "timestamp": "07:24:43", "text": "された"}, {"type": "subtitle", "time": 26688.07, "timestamp": "07:24:48", "text": "ニース。ジョックに教えてみようと思う。"}, {"type": "subtitle", "time": 26696.27, "timestamp": "07:24:56", "text": "一体何やってんだ？"}]
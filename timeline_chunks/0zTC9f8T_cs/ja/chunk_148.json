[{"type": "subtitle", "time": 8886.95, "timestamp": "02:28:06", "text": "待って、待って、リソースを使わないの？"}, {"type": "subtitle", "time": 8889.59, "timestamp": "02:28:09", "text": "パックイン待機リソースパックインが必要ですか"}, {"type": "subtitle", "time": 8893.59, "timestamp": "02:28:13", "text": "サーバー側でもクライアント側で動作するようにする必要がありますか？"}, {"type": "subtitle", "time": 8897.429, "timestamp": "02:28:17", "text": "えーっと、私がやったことは、"}, {"type": "subtitle", "time": 8901.91, "timestamp": "02:28:21", "text": "クライアントパックとリソースパックの両方に対応しています。"}, {"type": "subtitle", "time": 8902.91, "timestamp": "02:28:22", "text": "通常は"}, {"type": "subtitle", "time": 8905.99, "timestamp": "02:28:25", "text": "クライアント向け。うん、うん、うん。のために"}, {"type": "subtitle", "time": 8909.309, "timestamp": "02:28:29", "text": "クライアント。いや、そう、私はそれを"}, {"type": "subtitle", "time": 8912.309, "timestamp": "02:28:32", "text": "もし私の理解が正しければ、クライアントですね。"}, {"type": "subtitle", "time": 8918.59, "timestamp": "02:28:38", "text": "ええ、でもフォルダは"}, {"type": "subtitle", "time": 8921.429, "timestamp": "02:28:41", "text": "そこには。待って、シェーダーを追加できるかもしれない"}, {"type": "subtitle", "time": 8925.59, "timestamp": "02:28:45", "text": "パックフォルダも一緒に。なぜだめですか？"}, {"type": "subtitle", "time": 8927.63, "timestamp": "02:28:47", "text": "自分のためにやりなさい。いやいや、"}, {"type": "subtitle", "time": 8930.83, "timestamp": "02:28:50", "text": "あなた自身。うん。うん。"}, {"type": "subtitle", "time": 8933.27, "timestamp": "02:28:53", "text": "右。そして、好きなMODをすべて追加してください。"}, {"type": "subtitle", "time": 8934.71, "timestamp": "02:28:54", "text": "付け加える。"}, {"type": "subtitle", "time": 8937.59, "timestamp": "02:28:57", "text": "ええ、追加します。図を追加しました。"}]
[{"type": "subtitle", "time": 25381.23, "timestamp": "07:03:01", "text": "新しいものを取得できるツールなしで"}, {"type": "subtitle", "time": 25383.51, "timestamp": "07:03:03", "text": "火打ち石。いくつか追加点があります"}, {"type": "subtitle", "time": 25386.07, "timestamp": "07:03:06", "text": "変更。わかった。木材用のバニラレシピ"}, {"type": "subtitle", "time": 25388.59, "timestamp": "07:03:08", "text": "そして石は"}, {"type": "subtitle", "time": 25391.43, "timestamp": "07:03:11", "text": "削除されました。バニラキャンプファイヤーレシピには"}, {"type": "subtitle", "time": 25394.35, "timestamp": "07:03:14", "text": "火を使って"}, {"type": "subtitle", "time": 25397.67, "timestamp": "07:03:17", "text": "スターター。陶器は"}, {"type": "subtitle", "time": 25400.868, "timestamp": "07:03:20", "text": "粘土細工道具。ナイフは新しいツールです"}, {"type": "subtitle", "time": 25403.43, "timestamp": "07:03:23", "text": "バニラツールの素材。缶を使用できます"}, {"type": "subtitle", "time": 25406.708, "timestamp": "07:03:26", "text": "弱い剣として使われる。ああ、だって木は"}, {"type": "subtitle", "time": 25408.59, "timestamp": "07:03:28", "text": "ない"}, {"type": "subtitle", "time": 25413.27, "timestamp": "07:03:33", "text": "そこには。わかった。切れ味の悪いナイフ。わかった。見た"}, {"type": "subtitle", "time": 25417.708, "timestamp": "07:03:37", "text": "斧の弱体版。ああ、それであなたの"}, {"type": "subtitle", "time": 25420.91, "timestamp": "07:03:40", "text": "基本的なツール"}, {"type": "subtitle", "time": 25423.75, "timestamp": "07:03:43", "text": "マッドロックスは究極のオールインワン"}, {"type": "subtitle", "time": 25425.99, "timestamp": "07:03:45", "text": "道具。彼らはブロックを採掘することができます"}, {"type": "subtitle", "time": 25426.83, "timestamp": "07:03:46", "text": "持っている"}, {"type": "subtitle", "time": 25430.468, "timestamp": "07:03:50", "text": "シャベル、斧、鍬、そして木材の皮を剥ぐ道具"}, {"type": "subtitle", "time": 25435.19, "timestamp": "07:03:55", "text": "斧のように作用する。くそ。"}, {"type": "subtitle", "time": 25438.39, "timestamp": "07:03:58", "text": "木を殴ってやってはいけません。森林伐採は行わない。"}]
[{"type": "subtitle", "time": 2223.19, "timestamp": "00:37:03", "text": "わかった。わかった。リソースパックが完成しました。それから"}, {"type": "subtitle", "time": 2227.589, "timestamp": "00:37:07", "text": "モッズ関連のものから、えーと、もしあなたが、えーと、"}, {"type": "subtitle", "time": 2229.589, "timestamp": "00:37:09", "text": "ええ、mods のやつから、それは"}, {"type": "subtitle", "time": 2232.39, "timestamp": "00:37:12", "text": "クライアント側モードはこちらです。"}, {"type": "subtitle", "time": 2234.79, "timestamp": "00:37:14", "text": "ええと、ほとんど全員ですね。"}, {"type": "subtitle", "time": 2239.91, "timestamp": "00:37:19", "text": "ええ、私があなたに送ったのは"}, {"type": "subtitle", "time": 2242.63, "timestamp": "00:37:22", "text": "クライアント側の改造。いいえ、だからもし"}, {"type": "subtitle", "time": 2243.91, "timestamp": "00:37:23", "text": "サーバー側だったのに、なぜ私が設定するのでしょうか"}, {"type": "subtitle", "time": 2246.55, "timestamp": "00:37:26", "text": "そのグループ？そうそう。うんうん、そうだね、"}, {"type": "subtitle", "time": 2249.19, "timestamp": "00:37:29", "text": "本当だ、本当だ、本当だ。わかりました、全部入れます"}, {"type": "subtitle", "time": 2252.79, "timestamp": "00:37:32", "text": "彼ら。そのリソースパケットは追加しないでください。"}, {"type": "subtitle", "time": 2254.63, "timestamp": "00:37:34", "text": "見てみましょう。"}, {"type": "subtitle", "time": 2257.27, "timestamp": "00:37:37", "text": "ええ、ええ。追加するだけです"}, {"type": "subtitle", "time": 2260.63, "timestamp": "00:37:40", "text": "とりあえず、動作するかどうか確認してみましょう。そして"}, {"type": "subtitle", "time": 2263.71, "timestamp": "00:37:43", "text": "もし追加されるとしたら、"}]
[{"type": "subtitle", "time": 1440.19, "timestamp": "00:24:00", "text": "自分"}, {"type": "subtitle", "time": 1443.11, "timestamp": "00:24:03", "text": "ジャスミンに人々に教える方法"}, {"type": "subtitle", "time": 1445.75, "timestamp": "00:24:05", "text": "これらのMODを今すぐ使ってみてください。"}, {"type": "subtitle", "time": 1449.35, "timestamp": "00:24:09", "text": "いや、いや、いや。えーっと、やってみよう"}, {"type": "subtitle", "time": 1453.19, "timestamp": "00:24:13", "text": "設定して、私ができるかどうか見てください。"}, {"type": "subtitle", "time": 1456.07, "timestamp": "00:24:16", "text": "私の側からすべてのMODを削除して、"}, {"type": "subtitle", "time": 1458.63, "timestamp": "00:24:18", "text": "この自動改造パックが実際に機能する場合"}, {"type": "subtitle", "time": 1461.909, "timestamp": "00:24:21", "text": "クライアント側も今では"}, {"type": "subtitle", "time": 1464.07, "timestamp": "00:24:24", "text": "そうねぇ"}, {"type": "subtitle", "time": 1467.51, "timestamp": "00:24:27", "text": "uhクライアント設定ファイル自動モードクライアント"}, {"type": "subtitle", "time": 1471.07, "timestamp": "00:24:31", "text": "ファイルバージョンまたは新しい自動構成用"}, {"type": "subtitle", "time": 1473.99, "timestamp": "00:24:33", "text": "ここに名前を入力する人は"}, {"type": "subtitle", "time": 1476.07, "timestamp": "00:24:36", "text": "ロードされるようにする"}, {"type": "subtitle", "time": 1478.59, "timestamp": "00:24:38", "text": "顧客データのインストール先"}, {"type": "subtitle", "time": 1482.07, "timestamp": "00:24:42", "text": "クライアントのオン/オフ自動モードパック"}, {"type": "subtitle", "time": 1483.51, "timestamp": "00:24:43", "text": "更新情報。これはモードを侵害します"}, {"type": "subtitle", "time": 1486.87, "timestamp": "00:24:46", "text": "作業内容とモーターパックの取り付け。ああ"}, {"type": "subtitle", "time": 1489.99, "timestamp": "00:24:49", "text": "ダウンロードと"}, {"type": "subtitle", "time": 1494.23, "timestamp": "00:24:54", "text": "zファイルを作成し、単一のサブファイルを送信する"}, {"type": "subtitle", "time": 1498.95, "timestamp": "00:24:58", "text": "そして、それを抽出して貼り付けることができる。"}]
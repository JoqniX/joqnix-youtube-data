[{"type": "subtitle", "time": 23409.99, "timestamp": "06:30:09", "text": "Cレベル。わかった。だから、もし私が、ああ、1つのスタック。"}, {"type": "subtitle", "time": 23417.31, "timestamp": "06:30:17", "text": "えっと、置くことができます"}, {"type": "subtitle", "time": 23420.59, "timestamp": "06:30:20", "text": "ここ。そうだね"}, {"type": "subtitle", "time": 23423.27, "timestamp": "06:30:23", "text": "クリック。待って、なぜこれは、待って、これは"}, {"type": "chat", "time": 23428.893, "timestamp": "06:30:28", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "It is a scam"}, {"type": "subtitle", "time": 23433.03, "timestamp": "06:30:33", "text": "上。ちょっと待って。待って、それは"}, {"type": "subtitle", "time": 23441.51, "timestamp": "06:30:41", "text": "何？クラフト。待って、Xを保存しないのは"}, {"type": "subtitle", "time": 23443.548, "timestamp": "06:30:43", "text": "重大な原因"}, {"type": "subtitle", "time": 23446.868, "timestamp": "06:30:46", "text": "遅れ。取得する。わかった。無限に保存"}, {"type": "subtitle", "time": 23448.788, "timestamp": "06:30:48", "text": "1つの束に含まれるアイテムの数。有効にする"}, {"type": "subtitle", "time": 23451.75, "timestamp": "06:30:51", "text": "効果のない組織。単に"}, {"type": "subtitle", "time": 23453.99, "timestamp": "06:30:53", "text": "地上にいる。捨てる"}, {"type": "subtitle", "time": 23456.23, "timestamp": "06:30:56", "text": "願わくばそうしたい。ああ、それを羽織ればいいよ"}]
[{"type": "subtitle", "time": 3434.789, "timestamp": "00:57:14", "text": "うん。馬のモッドパックのパスがなぜ"}, {"type": "subtitle", "time": 3441.91, "timestamp": "00:57:21", "text": "わかった。このMODは他のMODをアップデートしますか？"}, {"type": "subtitle", "time": 3443.71, "timestamp": "00:57:23", "text": "いいえ、それはすべて"}, {"type": "subtitle", "time": 3446.549, "timestamp": "00:57:26", "text": "くそっ。このMODは同期のみ"}, {"type": "subtitle", "time": 3448.789, "timestamp": "00:57:28", "text": "サーバー側のMODパックをクライアント側に送信します。ああ、そう"}, {"type": "subtitle", "time": 3452.23, "timestamp": "00:57:32", "text": "ある意味では、私たちは"}, {"type": "subtitle", "time": 3455.589, "timestamp": "00:57:35", "text": "他のMODパックのように、更新されたMODを配置する"}, {"type": "subtitle", "time": 3456.829, "timestamp": "00:57:36", "text": "で"}, {"type": "subtitle", "time": 3462.47, "timestamp": "00:57:42", "text": "サーバー用MODパック。つまりGなので、"}, {"type": "subtitle", "time": 3465.47, "timestamp": "00:57:45", "text": "プレイヤーには最新のMODが提供されます"}, {"type": "subtitle", "time": 3469.43, "timestamp": "00:57:49", "text": "パック。えっと"}, {"type": "subtitle", "time": 3472.95, "timestamp": "00:57:52", "text": "それは面倒だ。うん、大丈夫だよ。そこには"}, {"type": "subtitle", "time": 3474.789, "timestamp": "00:57:54", "text": "更新する方法があれば"}, {"type": "subtitle", "time": 3477.63, "timestamp": "00:57:57", "text": "それ。"}]
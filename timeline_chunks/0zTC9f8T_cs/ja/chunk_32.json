[{"type": "subtitle", "time": 1923.909, "timestamp": "00:32:03", "text": "これは一体何ですか？すべてオン/オフ"}, {"type": "subtitle", "time": 1926.389, "timestamp": "00:32:06", "text": "モッドパックのアップデートについて。これは"}, {"type": "subtitle", "time": 1929.029, "timestamp": "00:32:09", "text": "MODの活動とインストールに影響を与える"}, {"type": "subtitle", "time": 1932.149, "timestamp": "00:32:12", "text": "そして、MODパックのインストール。デフォルト値"}, {"type": "subtitle", "time": 1933.149, "timestamp": "00:32:13", "text": "は"}, {"type": "subtitle", "time": 1948.07, "timestamp": "00:32:28", "text": "いや、変更してないよ。わかった、しないよ"}, {"type": "subtitle", "time": 1949.71, "timestamp": "00:32:29", "text": "変化"}, {"type": "subtitle", "time": 1952.789, "timestamp": "00:32:32", "text": "それ。コンテンツを保存します。私を見て。私は"}, {"type": "subtitle", "time": 1964.389, "timestamp": "00:32:44", "text": "何？あなたは私の子供たちに会うことはできません。えっと"}, {"type": "subtitle", "time": 1972.149, "timestamp": "00:32:52", "text": "待って。わかった。あなたの手が動いているのが見えます。"}]
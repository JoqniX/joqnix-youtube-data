[{"type": "subtitle", "time": 27121.03, "timestamp": "07:32:01", "text": "ええ、全部低設定にしなければなりませんでした。"}, {"type": "subtitle", "time": 27122.91, "timestamp": "07:32:02", "text": "たくさんあります"}, {"type": "subtitle", "time": 27125.83, "timestamp": "07:32:05", "text": "もの。最適化すると高いと表示されますが、"}, {"type": "subtitle", "time": 27134.628, "timestamp": "07:32:14", "text": "それは一部の人にとっては台無しになると思う"}, {"type": "subtitle", "time": 27140.388, "timestamp": "07:32:20", "text": "私たちのチャットが共有されるときが大好きです"}, {"type": "subtitle", "time": 27142.59, "timestamp": "07:32:22", "text": "共有チャット"}, {"type": "subtitle", "time": 27147.03, "timestamp": "07:32:27", "text": "えっと、Twitchでですよね？私のボットはすでに"}, {"type": "subtitle", "time": 27150.868, "timestamp": "07:32:30", "text": "チャットでも挨拶してくれます。"}, {"type": "subtitle", "time": 27157.99, "timestamp": "07:32:37", "text": "いらっしゃいませ。いらっしゃいませ。"}, {"type": "subtitle", "time": 27170.628, "timestamp": "07:32:50", "text": "私は彼女が好きだ。例えば、彼女の声を聞いてみて。"}]
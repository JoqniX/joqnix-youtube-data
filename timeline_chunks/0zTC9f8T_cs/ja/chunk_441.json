[{"type": "subtitle", "time": 26470.39, "timestamp": "07:21:10", "text": "痛みを感じて、何と言っていいかわからない。私"}, {"type": "subtitle", "time": 26477.35, "timestamp": "07:21:17", "text": "言う。何てことだ。オーケー、ロシャンは"}, {"type": "subtitle", "time": 26479.59, "timestamp": "07:21:19", "text": "ストリーミング配信。リンクは"}, {"type": "subtitle", "time": 26481.35, "timestamp": "07:21:21", "text": "説明。"}, {"type": "subtitle", "time": 26499.31, "timestamp": "07:21:39", "text": "えっと、開けたら開けて"}, {"type": "subtitle", "time": 26501.548, "timestamp": "07:21:41", "text": "ノック"}, {"type": "subtitle", "time": 26505.31, "timestamp": "07:21:45", "text": "あなたの持ち物、えっと、あなた"}, {"type": "subtitle", "time": 26516.75, "timestamp": "07:21:56", "text": "わかった。彼は知らないと思う"}]
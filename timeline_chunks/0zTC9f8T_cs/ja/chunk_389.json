[{"type": "subtitle", "time": 23343.67, "timestamp": "06:29:03", "text": "革製、紐1本。ああ、それだ。私"}, {"type": "subtitle", "time": 23345.51, "timestamp": "06:29:05", "text": "それを作り上げる必要がある。手動で"}, {"type": "subtitle", "time": 23362.75, "timestamp": "06:29:22", "text": "弦、"}, {"type": "subtitle", "time": 23366.708, "timestamp": "06:29:26", "text": "兄弟。ああ、無限。ああ、見て。それは"}, {"type": "subtitle", "time": 23373.23, "timestamp": "06:29:33", "text": "ごめん。私"}, {"type": "subtitle", "time": 23381.67, "timestamp": "06:29:41", "text": "わかった。明らか。わかった。見て、"}, {"type": "subtitle", "time": 23383.91, "timestamp": "06:29:43", "text": "キラキラと輝く。何てことだ。見て"}, {"type": "subtitle", "time": 23398.27, "timestamp": "06:29:58", "text": "正しい、待って、どうやって装備するの？"}]
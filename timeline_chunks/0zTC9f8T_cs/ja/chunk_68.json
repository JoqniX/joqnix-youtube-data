[{"type": "subtitle", "time": 4089.27, "timestamp": "01:08:09", "text": "その周り。私は行く必要があります。あ、待って。私は見つけた"}, {"type": "subtitle", "time": 4091.23, "timestamp": "01:08:11", "text": "別の"}, {"type": "subtitle", "time": 4093.43, "timestamp": "01:08:13", "text": "村。しかし、私たちは"}, {"type": "subtitle", "time": 4094.95, "timestamp": "01:08:14", "text": "クリエイティブ。だから、私は何もマークしません"}, {"type": "subtitle", "time": 4097.189, "timestamp": "01:08:17", "text": "場所。"}, {"type": "subtitle", "time": 4100.309, "timestamp": "01:08:20", "text": "私たちは創造的な素材を使っています。うん、君"}, {"type": "subtitle", "time": 4102.07, "timestamp": "01:08:22", "text": "これを作らなければならない。どれだけ難しいか知っていますか"}, {"type": "subtitle", "time": 4109.99, "timestamp": "01:08:29", "text": "あ、待って。私たちは待っています、待って待って待って。"}, {"type": "subtitle", "time": 4115.189, "timestamp": "01:08:35", "text": "これはクリエイティブモードで作成されました。あ、こんにちは。"}, {"type": "subtitle", "time": 4117.55, "timestamp": "01:08:37", "text": "見て。ああ、"}, {"type": "subtitle", "time": 4125.51, "timestamp": "01:08:45", "text": "私のほうが君より速いんだよ。私は"}, {"type": "subtitle", "time": 4128.07, "timestamp": "01:08:48", "text": "ああ、エンジンがかかっていませんね。"}, {"type": "subtitle", "time": 4130.149, "timestamp": "01:08:50", "text": "どういう意味ですか？"}, {"type": "subtitle", "time": 4131.91, "timestamp": "01:08:51", "text": "プロペラが作動していないようです。"}, {"type": "subtitle", "time": 4134.07, "timestamp": "01:08:54", "text": "あなたは今、ただ漂っているだけです。"}, {"type": "subtitle", "time": 4137.11, "timestamp": "01:08:57", "text": "プロペラが作動していません。どうやって？できますか？"}]
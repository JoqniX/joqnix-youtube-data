[{"type": "subtitle", "time": 26701.27, "timestamp": "07:25:01", "text": "何？何？いや。ああ、なんてことだ。"}, {"type": "subtitle", "time": 26705.11, "timestamp": "07:25:05", "text": "わかりません。"}, {"type": "subtitle", "time": 26709.11, "timestamp": "07:25:09", "text": "ゲームを確認したところ、"}, {"type": "subtitle", "time": 26717.75, "timestamp": "07:25:17", "text": "言葉が出ません。大丈夫。見ます"}, {"type": "subtitle", "time": 26723.27, "timestamp": "07:25:23", "text": "君がプレイするんだ。それって一体どういう意味だよ？"}, {"type": "subtitle", "time": 26726.628, "timestamp": "07:25:26", "text": "停止。そんなこと言うのはやめてください。ちくしょう。おお"}, {"type": "subtitle", "time": 26728.83, "timestamp": "07:25:28", "text": "私の"}, {"type": "subtitle", "time": 26733.51, "timestamp": "07:25:33", "text": "神。ああ、これは"}, {"type": "subtitle", "time": 26735.27, "timestamp": "07:25:35", "text": "わからない。何と言っていいかわからない。"}, {"type": "subtitle", "time": 26737.91, "timestamp": "07:25:37", "text": "言葉が出ません。"}, {"type": "subtitle", "time": 26745.83, "timestamp": "07:25:45", "text": "ボールが機能しません。さて、この男は、"}, {"type": "subtitle", "time": 26749.27, "timestamp": "07:25:49", "text": "いや、彼は良いプレーをしようと努力しているんだよ。私"}]
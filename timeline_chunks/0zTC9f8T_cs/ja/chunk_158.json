[{"type": "subtitle", "time": 9493.11, "timestamp": "02:38:13", "text": "サーバーから切断されました。"}, {"type": "subtitle", "time": 9495.51, "timestamp": "02:38:15", "text": "ええ、サーバーがクラッシュしました。"}, {"type": "subtitle", "time": 9497.91, "timestamp": "02:38:17", "text": "では、再起動または強制終了する必要がありますか、それとも"}, {"type": "subtitle", "time": 9509.309, "timestamp": "02:38:29", "text": "ソケットオプションを取得します。"}, {"type": "subtitle", "time": 9530.55, "timestamp": "02:38:50", "text": "あの鍵みたいなものは使えないみたいですね。"}, {"type": "subtitle", "time": 9532.389, "timestamp": "02:38:52", "text": "どれ？"}, {"type": "subtitle", "time": 9538.71, "timestamp": "02:38:58", "text": "胸。ちょっと待って、見せて。いいえ、なぜなら私は"}]
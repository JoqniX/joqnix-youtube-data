[{"type": "subtitle", "time": 24181.39, "timestamp": "06:43:01", "text": "アンロードと呼ばれる特定のMOD"}, {"type": "subtitle", "time": 24184.11, "timestamp": "06:43:04", "text": "活動。つまり、"}, {"type": "subtitle", "time": 24187.708, "timestamp": "06:43:07", "text": "えっと、私は見るまでは知りませんでした"}, {"type": "subtitle", "time": 24192.67, "timestamp": "06:43:12", "text": "これ。えっと、それは、えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 24196.628, "timestamp": "06:43:16", "text": "それ？だから、警官が警官になるようなことが起こると"}, {"type": "subtitle", "time": 24199.27, "timestamp": "06:43:19", "text": "シミュレーション距離外では、通常"}, {"type": "subtitle", "time": 24201.59, "timestamp": "06:43:21", "text": "彼らは行かなかった。このMODはそれを変える"}, {"type": "subtitle", "time": 24203.83, "timestamp": "06:43:23", "text": "計算をすると"}, {"type": "subtitle", "time": 24206.39, "timestamp": "06:43:26", "text": "シミュレーション範囲内で更新する。"}, {"type": "subtitle", "time": 24207.91, "timestamp": "06:43:27", "text": "だから彼らは一度も"}, {"type": "subtitle", "time": 24209.99, "timestamp": "06:43:29", "text": "シミュレーション範囲。これで探索できます"}, {"type": "subtitle", "time": 24212.628, "timestamp": "06:43:32", "text": "作物が育つのを待っている間、または"}, {"type": "subtitle", "time": 24215.99, "timestamp": "06:43:35", "text": "調理用の炉。つまり、私たちの"}, {"type": "subtitle", "time": 24220.31, "timestamp": "06:43:40", "text": "ベース。いいえ、私たちは作物を植えるために物を入れます"}, {"type": "subtitle", "time": 24222.31, "timestamp": "06:43:42", "text": "えっと、あれ。それはもっと"}, {"type": "subtitle", "time": 24225.59, "timestamp": "06:43:45", "text": "現実的。私たちは冒険に出かけます"}, {"type": "subtitle", "time": 24228.868, "timestamp": "06:43:48", "text": "本当に遠く離れた場所に私たちの作物を置いて"}, {"type": "subtitle", "time": 24231.83, "timestamp": "06:43:51", "text": "作物は成長し、私たちの"}, {"type": "subtitle", "time": 24233.99, "timestamp": "06:43:53", "text": "炉はすでに"}, {"type": "subtitle", "time": 24236.708, "timestamp": "06:43:56", "text": "料理も全部戻ってきて"}]
[{"type": "subtitle", "time": 22920.07, "timestamp": "06:22:00", "text": "何かを作る。私が目にしたMODがありました。私"}, {"type": "subtitle", "time": 22922.19, "timestamp": "06:22:02", "text": "それについてあなたの意見を聞きたかったんです"}, {"type": "subtitle", "time": 22925.23, "timestamp": "06:22:05", "text": "後で。それは、例えばあなたが"}, {"type": "subtitle", "time": 22928.47, "timestamp": "06:22:08", "text": "ダイヤモンドのヘルメットでも、金のヘルメットでも、何でもいい。今"}, {"type": "subtitle", "time": 22930.43, "timestamp": "06:22:10", "text": "返金できます"}, {"type": "subtitle", "time": 22932.868, "timestamp": "06:22:12", "text": "アイテムを溶鉱炉に入れるか、"}, {"type": "subtitle", "time": 22934.948, "timestamp": "06:22:14", "text": "何か、ある"}, {"type": "subtitle", "time": 22937.39, "timestamp": "06:22:17", "text": "ええと、製錬所で返金されます"}, {"type": "subtitle", "time": 22940.31, "timestamp": "06:22:20", "text": "材料を少しだけ。例えば、"}, {"type": "subtitle", "time": 22941.31, "timestamp": "06:22:21", "text": "その"}, {"type": "subtitle", "time": 22945.51, "timestamp": "06:22:25", "text": "金は、製錬炉に入れて"}, {"type": "subtitle", "time": 22947.43, "timestamp": "06:22:27", "text": "金の延べ棒か何かを手に入れるか"}, {"type": "subtitle", "time": 22949.99, "timestamp": "06:22:29", "text": "金。いや、インゴットではないと思う。うん、行って。"}, {"type": "subtitle", "time": 22952.51, "timestamp": "06:22:32", "text": "金を手に入れる"}, {"type": "subtitle", "time": 22955.99, "timestamp": "06:22:35", "text": "戻る。まるでリサイクルしているみたいだ。だから私は"}]
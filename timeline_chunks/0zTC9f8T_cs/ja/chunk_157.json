[{"type": "subtitle", "time": 9423.349, "timestamp": "02:37:03", "text": "待って、楽器も必要だ。"}, {"type": "subtitle", "time": 9426.469, "timestamp": "02:37:06", "text": "あなたはそれをあなたに与えていない。"}, {"type": "subtitle", "time": 9428.15, "timestamp": "02:37:08", "text": "何？"}, {"type": "subtitle", "time": 9433.389, "timestamp": "02:37:13", "text": "えっと、それから"}, {"type": "subtitle", "time": 9439.83, "timestamp": "02:37:19", "text": "えっと"}, {"type": "subtitle", "time": 9443.91, "timestamp": "02:37:23", "text": "テスト。うん。没入型の機械など"}, {"type": "subtitle", "time": 9447.83, "timestamp": "02:37:27", "text": "チェス関連のもの。機械。"}, {"type": "subtitle", "time": 9459.51, "timestamp": "02:37:39", "text": "何てことだ。それは悪いことですか？"}, {"type": "subtitle", "time": 9463.99, "timestamp": "02:37:43", "text": "うん。待って。あと少しだったのに。"}, {"type": "subtitle", "time": 9467.19, "timestamp": "02:37:47", "text": "うん。サーバーが閉じているのはなぜですか？得る"}, {"type": "subtitle", "time": 9469.91, "timestamp": "02:37:49", "text": "すくい取った。え、何？そうねぇ。サーバ"}, {"type": "subtitle", "time": 9472.79, "timestamp": "02:37:52", "text": "私にとっては閉店です。うん、私も蹴られたよ"}]
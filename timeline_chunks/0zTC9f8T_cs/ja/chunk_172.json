[{"type": "subtitle", "time": 10335.429, "timestamp": "02:52:15", "text": "ああ、お腹が空いた。"}, {"type": "subtitle", "time": 10345.429, "timestamp": "02:52:25", "text": "アストラ、いつ食事をしたの？私は正しくなかった"}, {"type": "subtitle", "time": 10349.83, "timestamp": "02:52:29", "text": "今。どうやって？待って、でも、もしあなたが"}, {"type": "subtitle", "time": 10351.91, "timestamp": "02:52:31", "text": "タイミングが悪いんだよ、わからないの？"}, {"type": "subtitle", "time": 10354.55, "timestamp": "02:52:34", "text": "虫垂、または虫垂、または何であれ"}, {"type": "subtitle", "time": 10356.389, "timestamp": "02:52:36", "text": "問題は？"}, {"type": "subtitle", "time": 10360.15, "timestamp": "02:52:40", "text": "胃腸の不調とか、そういうの全部です。"}, {"type": "subtitle", "time": 10362.23, "timestamp": "02:52:42", "text": "悪いことじゃないですか？"}, {"type": "subtitle", "time": 10364.79, "timestamp": "02:52:44", "text": "私は1日約1500カロリーのダイエットをしています"}, {"type": "subtitle", "time": 10369.309, "timestamp": "02:52:49", "text": "1日あたりの摂取カロリーはほぼ"}, {"type": "subtitle", "time": 10371.75, "timestamp": "02:52:51", "text": "2500。これだけ食べるべきなのに食べていない。"}]
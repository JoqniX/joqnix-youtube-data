[{"type": "subtitle", "time": 9960.23, "timestamp": "02:46:00", "text": "できるよ。はい、追加しようと思っています"}, {"type": "subtitle", "time": 9961.469, "timestamp": "02:46:01", "text": "これは"}, {"type": "subtitle", "time": 9963.79, "timestamp": "02:46:03", "text": "良い。見てみて"}, {"type": "subtitle", "time": 9966.91, "timestamp": "02:46:06", "text": "それは私たちにより多くの武器を与え、"}, {"type": "subtitle", "time": 9968.99, "timestamp": "02:46:08", "text": "鎧を着るなら"}, {"type": "subtitle", "time": 9973.83, "timestamp": "02:46:13", "text": "望むか望まないか。すべてはあなた次第です。"}, {"type": "subtitle", "time": 9976.63, "timestamp": "02:46:16", "text": "あまり大げさにしたくないんだけど"}, {"type": "subtitle", "time": 9980.15, "timestamp": "02:46:20", "text": "圧倒的なことは間違いない。うん。ああ、"}, {"type": "subtitle", "time": 9986.07, "timestamp": "02:46:26", "text": "ギャラリー司祭の呪文。ああ、RPGシリーズですね。"}, {"type": "subtitle", "time": 9987.07, "timestamp": "02:46:27", "text": "私は感じる"}, {"type": "subtitle", "time": 9990.469, "timestamp": "02:46:30", "text": "通常のMinecraftのようにプレイしてみてください。"}, {"type": "subtitle", "time": 9993.59, "timestamp": "02:46:33", "text": "これでプレイできなくなってしまう。なんてこった、"}, {"type": "subtitle", "time": 9998.07, "timestamp": "02:46:38", "text": "RoがSteamでハッキングされた。彼は何をしたのですか？"}, {"type": "subtitle", "time": 10002.55, "timestamp": "02:46:42", "text": "何？ Rocoがハッキングされた。 Steamが見える"}, {"type": "subtitle", "time": 10004.429, "timestamp": "02:46:44", "text": "メッセージ"}, {"type": "subtitle", "time": 10008.87, "timestamp": "02:46:48", "text": "「50ドルのSteamギフトを受け取ります」と言って。"}, {"type": "subtitle", "time": 10011.51, "timestamp": "02:46:51", "text": "それは、もしあなたが"}]
[{"type": "subtitle", "time": 27841.67, "timestamp": "07:44:01", "text": "ジョーは女性ですか、それともフェムですか？ちくしょう。"}, {"type": "subtitle", "time": 27844.388, "timestamp": "07:44:04", "text": "彼は男だ。彼は男だ。わからない。"}, {"type": "subtitle", "time": 27848.15, "timestamp": "07:44:08", "text": "私は男です。はい。ジャグ、君は何か"}, {"type": "subtitle", "time": 27849.91, "timestamp": "07:44:09", "text": "私たちが知らないこと？私は"}, {"type": "subtitle", "time": 27851.91, "timestamp": "07:44:11", "text": "星座。忘れた。私は"}, {"type": "subtitle", "time": 27854.708, "timestamp": "07:44:14", "text": "人間。"}, {"type": "subtitle", "time": 27856.548, "timestamp": "07:44:16", "text": "けっこうだ。それはあなたの質問に答えるものです"}, {"type": "subtitle", "time": 27859.628, "timestamp": "07:44:19", "text": "質問ですね。"}, {"type": "subtitle", "time": 27863.628, "timestamp": "07:44:23", "text": "ええ、星座ですね。ジョックは"}, {"type": "subtitle", "time": 27866.23, "timestamp": "07:44:26", "text": "参加する。けっこうだ。それは良い答えですね。"}, {"type": "subtitle", "time": 27868.628, "timestamp": "07:44:28", "text": "チョークは"}, {"type": "subtitle", "time": 27871.35, "timestamp": "07:44:31", "text": "それは良い答えですね。うん。ああ、君たち"}, {"type": "subtitle", "time": 27873.43, "timestamp": "07:44:33", "text": "彼らは私の"}, {"type": "subtitle", "time": 27877.11, "timestamp": "07:44:37", "text": "ストリーム。何？"}, {"type": "subtitle", "time": 27879.07, "timestamp": "07:44:39", "text": "ああ、彼らはできる"}, {"type": "subtitle", "time": 27882.23, "timestamp": "07:44:42", "text": "聞く。くそ。これをやらなければならない。うん、君"}, {"type": "subtitle", "time": 27885.03, "timestamp": "07:44:45", "text": "了解しました。私たちには時間がない。だった"}]
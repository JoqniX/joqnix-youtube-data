[{"type": "subtitle", "time": 27660.388, "timestamp": "07:41:00", "text": "何をしているの？なぜそんなことをするのですか？なぜ？ああ、"}, {"type": "subtitle", "time": 27661.43, "timestamp": "07:41:01", "text": "神。"}, {"type": "subtitle", "time": 27663.03, "timestamp": "07:41:03", "text": "あいつら、俺を徹底的にチェックしてるんだ。くそっ"}, {"type": "subtitle", "time": 27671.83, "timestamp": "07:41:11", "text": "今。彼らを挟み撃ちにする必要があるので、"}, {"type": "subtitle", "time": 27678.59, "timestamp": "07:41:18", "text": "彼らは私のことを予想していたのだろうか？くそっ"}, {"type": "subtitle", "time": 27707.35, "timestamp": "07:41:47", "text": "シェーダーをコンパイルしています。ああ、彼は破壊した"}, {"type": "subtitle", "time": 27712.948, "timestamp": "07:41:52", "text": "ああ、君の前では僕は大きすぎるんだ、"}]
[{"type": "subtitle", "time": 3840.549, "timestamp": "01:04:00", "text": "このバックアップ処理を高速化するにはどうすればよいですか？"}, {"type": "subtitle", "time": 3843.87, "timestamp": "01:04:03", "text": "いいえ、遅いです。飛行機です。あなたは何を"}, {"type": "subtitle", "time": 3846.549, "timestamp": "01:04:06", "text": "期待する？これはすごくクールだ。どうやって"}, {"type": "subtitle", "time": 3855.75, "timestamp": "01:04:15", "text": "神。おお、これはすごい。"}, {"type": "subtitle", "time": 3857.75, "timestamp": "01:04:17", "text": "私が作ったランウェイ、すごくかっこよくなったでしょ？と"}, {"type": "subtitle", "time": 3859.91, "timestamp": "01:04:19", "text": "赤信号も。うん。うん。うん。"}, {"type": "subtitle", "time": 3871.109, "timestamp": "01:04:31", "text": "これは鉄の塊ですか？いいえ、滑らかです"}, {"type": "subtitle", "time": 3873.549, "timestamp": "01:04:33", "text": "石。"}, {"type": "subtitle", "time": 3876.069, "timestamp": "01:04:36", "text": "わかった。ご覧の通り、私は今席を外しています。"}, {"type": "subtitle", "time": 3880.349, "timestamp": "01:04:40", "text": "ほら、ホーム画面にいるでしょ。私を見て。"}, {"type": "subtitle", "time": 3887.51, "timestamp": "01:04:47", "text": "あ、あと、MODパックがうまく機能したような気がする。"}, {"type": "subtitle", "time": 3889.349, "timestamp": "01:04:49", "text": "全てのMODをダウンロードできたから"}, {"type": "subtitle", "time": 3892.549, "timestamp": "01:04:52", "text": "今すぐ参加しよう。よし、スペースキーを押します"}, {"type": "subtitle", "time": 3896.789, "timestamp": "01:04:56", "text": "プラス W. Go。スペースキーを押し続けてください。すべてのスペース"}]
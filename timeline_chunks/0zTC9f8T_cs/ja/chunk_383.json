[{"type": "subtitle", "time": 22983.67, "timestamp": "06:23:03", "text": "鉄。あのソーラークッカーは詐欺だ。"}, {"type": "subtitle", "time": 22986.708, "timestamp": "06:23:06", "text": "男。私はそうすべきではない。私"}, {"type": "subtitle", "time": 22988.628, "timestamp": "06:23:08", "text": "ソーラークッカーは取り外せると思う。"}, {"type": "subtitle", "time": 22996.43, "timestamp": "06:23:16", "text": "推測。しかしヒーターは"}, {"type": "subtitle", "time": 22999.27, "timestamp": "06:23:19", "text": "ニース。お風呂に入る方法があればいいのに"}, {"type": "subtitle", "time": 23002.788, "timestamp": "06:23:22", "text": "このゲーム。ヒーターをもらえますか？熱い"}, {"type": "subtitle", "time": 23006.39, "timestamp": "06:23:26", "text": "シャワー。何てことだ。起きます。それから私は"}, {"type": "subtitle", "time": 23009.83, "timestamp": "06:23:29", "text": "それを許可できるMODを見た"}, {"type": "subtitle", "time": 23012.15, "timestamp": "06:23:32", "text": "実際、水分補給を促してくれる。その"}, {"type": "subtitle", "time": 23014.708, "timestamp": "06:23:34", "text": "サヴァのように。私はそれを次のようにします"}, {"type": "subtitle", "time": 23016.868, "timestamp": "06:23:36", "text": "サバイバルゲーム。見つけなければならないように"}, {"type": "subtitle", "time": 23019.83, "timestamp": "06:23:39", "text": "水源と飲料水、携帯用"}, {"type": "subtitle", "time": 23031.39, "timestamp": "06:23:51", "text": "水。そして、もしあなたがお酒を飲むなら"}, {"type": "subtitle", "time": 23034.31, "timestamp": "06:23:54", "text": "空の海からの水"}, {"type": "subtitle", "time": 23037.43, "timestamp": "06:23:57", "text": "モデルでは、ハートの半分、"}]
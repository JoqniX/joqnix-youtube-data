[{"type": "subtitle", "time": 24674.51, "timestamp": "06:51:14", "text": "これ？私はこれを知っています"}, {"type": "subtitle", "time": 24682.31, "timestamp": "06:51:22", "text": "ショット。トラックについて話す"}, {"type": "subtitle", "time": 24684.39, "timestamp": "06:51:24", "text": "Connector、F forge用のMinecraft mod"}, {"type": "subtitle", "time": 24686.788, "timestamp": "06:51:26", "text": "ファブリックMODを実行できるようにする"}, {"type": "subtitle", "time": 24689.11, "timestamp": "06:51:29", "text": "Forgeは、基本的に橋渡しをします"}, {"type": "subtitle", "time": 24691.03, "timestamp": "06:51:31", "text": "これら2つのプラットフォーム。さて、それは"}, {"type": "subtitle", "time": 24693.03, "timestamp": "06:51:33", "text": "完璧ではなく、すべての生地が完璧というわけでもありません"}, {"type": "subtitle", "time": 24695.43, "timestamp": "06:51:35", "text": "実際には、mod は Forge 上で実行できます"}, {"type": "subtitle", "time": 24697.43, "timestamp": "06:51:37", "text": "シニトラは、私たちに大きな部分をもたらしました"}, {"type": "subtitle", "time": 24699.03, "timestamp": "06:51:39", "text": "そこへ行く途中。例えば、これによってあなたは"}, {"type": "subtitle", "time": 24701.51, "timestamp": "06:51:41", "text": "ForgeでリプレイMODを実行すると、"}, {"type": "subtitle", "time": 24703.67, "timestamp": "06:51:43", "text": "素晴らしい映像を撮影するために"}, {"type": "subtitle", "time": 24706.548, "timestamp": "06:51:46", "text": "Forge専用MOD。それは素晴らしいですね。"}, {"type": "subtitle", "time": 24708.31, "timestamp": "06:51:48", "text": "しかし同時に、それはサポートしていません"}, {"type": "subtitle", "time": 24711.59, "timestamp": "06:51:51", "text": "ディアードファブリックファン向けの"}, {"type": "subtitle", "time": 24713.91, "timestamp": "06:51:53", "text": "はい、見てみましょう"}, {"type": "subtitle", "time": 24716.868, "timestamp": "06:51:56", "text": "今日もそれをやっています。そうです、そして私は現在"}, {"type": "subtitle", "time": 24718.468, "timestamp": "06:51:58", "text": "インストールを実行しています。これは"}]
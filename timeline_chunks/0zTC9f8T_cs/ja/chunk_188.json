[{"type": "subtitle", "time": 11293.51, "timestamp": "03:08:13", "text": "これは何ですか？ドローン。小さな"}, {"type": "subtitle", "time": 11295.75, "timestamp": "03:08:15", "text": "プログラム可能なドローンが物体を移動させる。"}, {"type": "subtitle", "time": 11297.15, "timestamp": "03:08:17", "text": "移動できます"}, {"type": "subtitle", "time": 11300.87, "timestamp": "03:08:20", "text": "アイテム。想像してみてください、あなたは手に入れなければなりません"}, {"type": "subtitle", "time": 11305.15, "timestamp": "03:08:25", "text": "今すぐデータを転送"}, {"type": "subtitle", "time": 11309.83, "timestamp": "03:08:29", "text": "もしこれを持っていたら、家に帰れますよ。"}, {"type": "subtitle", "time": 11311.67, "timestamp": "03:08:31", "text": "配達。"}, {"type": "subtitle", "time": 11313.75, "timestamp": "03:08:33", "text": "うん。あのね？ゲームを追加して"}, {"type": "subtitle", "time": 11318.309, "timestamp": "03:08:38", "text": "コールオブデューティのマップも作ってみましょう。"}, {"type": "subtitle", "time": 11319.63, "timestamp": "03:08:39", "text": "銃を追加しましょう、"}, {"type": "subtitle", "time": 11321.91, "timestamp": "03:08:41", "text": "右？ああ、あのね？の方が良い"}, {"type": "subtitle", "time": 11323.59, "timestamp": "03:08:43", "text": "Call of Dutyのサーバージョグを作るのは、"}, {"type": "subtitle", "time": 11329.99, "timestamp": "03:08:49", "text": "何てことだ。これらのMODは削除すべきです。"}, {"type": "subtitle", "time": 11338.15, "timestamp": "03:08:58", "text": "えっと、銅製の扇風機。ああ、私はただ"}]
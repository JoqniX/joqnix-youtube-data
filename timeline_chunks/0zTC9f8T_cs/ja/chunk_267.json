[{"type": "subtitle", "time": 16020.55, "timestamp": "04:27:00", "text": "炉がまるで"}, {"type": "subtitle", "time": 16022.71, "timestamp": "04:27:02", "text": "喫煙者。どちらの拡張機能も炉をロックします"}, {"type": "subtitle", "time": 16024.87, "timestamp": "04:27:04", "text": "レシピプールを使用できるように"}, {"type": "subtitle", "time": 16027.11, "timestamp": "04:27:07", "text": "燻製炉または溶鉱炉"}, {"type": "subtitle", "time": 16029.349, "timestamp": "04:27:09", "text": "レシピ集。グリーンオーグメントは"}, {"type": "subtitle", "time": 16031.75, "timestamp": "04:27:11", "text": "追加の修飾子を加える強化"}, {"type": "subtitle", "time": 16034.55, "timestamp": "04:27:14", "text": "炉へ。このスピード増強には"}, {"type": "subtitle", "time": 16036.63, "timestamp": "04:27:16", "text": "すべてのレシピの調理時間ですが、"}, {"type": "subtitle", "time": 16038.95, "timestamp": "04:27:18", "text": "その炉は2倍の燃料を消費する。そして"}, {"type": "subtitle", "time": 16040.63, "timestamp": "04:27:20", "text": "まず、燃費効率が向上します"}, {"type": "subtitle", "time": 16042.389, "timestamp": "04:27:22", "text": "これにより炉の燃料消費量を減らすことができます。"}, {"type": "subtitle", "time": 16044.469, "timestamp": "04:27:24", "text": "それは匂いを嗅ぎ分けます。しかし、"}, {"type": "subtitle", "time": 16046.55, "timestamp": "04:27:26", "text": "それらの品物を精錬するのにかかる時間。"}, {"type": "subtitle", "time": 16048.79, "timestamp": "04:27:28", "text": "最後になりましたが、もちろん重要なことですが、青色"}, {"type": "subtitle", "time": 16050.79, "timestamp": "04:27:30", "text": "オーグメントは、"}, {"type": "subtitle", "time": 16052.469, "timestamp": "04:27:32", "text": "炉の仕組みですが、"}, {"type": "subtitle", "time": 16054.469, "timestamp": "04:27:34", "text": "炉がレシピプールを保持する。の"}, {"type": "subtitle", "time": 16056.469, "timestamp": "04:27:36", "text": "工場の増強により炉は"}, {"type": "subtitle", "time": 16058.149, "timestamp": "04:27:38", "text": "工場になる、"}, {"type": "subtitle", "time": 16059.91, "timestamp": "04:27:39", "text": "入力および出力スロットの数"}, {"type": "subtitle", "time": 16062.07, "timestamp": "04:27:42", "text": "炉があります。しかし、炉は"}, {"type": "subtitle", "time": 16064.149, "timestamp": "04:27:44", "text": "電力を使ってアイテムを精錬する。発電機"}, {"type": "subtitle", "time": 16065.75, "timestamp": "04:27:45", "text": "Augment は炉を"}, {"type": "subtitle", "time": 16067.59, "timestamp": "04:27:47", "text": "ジェネレータ。すると発電機から煙が出る"}, {"type": "subtitle", "time": 16070.309, "timestamp": "04:27:50", "text": "それはRFを生成するための燃料である。しかし、これは"}, {"type": "subtitle", "time": 16071.99, "timestamp": "04:27:51", "text": "炉は煙を出すことができなくなる"}, {"type": "subtitle", "time": 16073.91, "timestamp": "04:27:53", "text": "アイテムを選定し、製品を開発する。ある"}, {"type": "subtitle", "time": 16075.83, "timestamp": "04:27:55", "text": "増強要素は互いに相乗効果を発揮する。の"}, {"type": "subtitle", "time": 16077.75, "timestamp": "04:27:57", "text": "ジェネレーターの強化は、"}, {"type": "subtitle", "time": 16079.83, "timestamp": "04:27:59", "text": "両方とも赤色の強化パーツ。発電機を使用する"}]
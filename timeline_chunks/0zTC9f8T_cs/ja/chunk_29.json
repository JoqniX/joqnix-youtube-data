[{"type": "subtitle", "time": 1744.95, "timestamp": "00:29:04", "text": "わかった。そこでアニメーションモードを追加しましたが"}, {"type": "subtitle", "time": 1748.99, "timestamp": "00:29:08", "text": "座るのには適していません"}, {"type": "subtitle", "time": 1752.63, "timestamp": "00:29:12", "text": "そうですね、私たちは今、"}, {"type": "subtitle", "time": 1755.59, "timestamp": "00:29:15", "text": "物の上に座ることができる。だからそれは"}, {"type": "subtitle", "time": 1759.51, "timestamp": "00:29:19", "text": "アニメーションMODなので、それほど良くはありません"}, {"type": "subtitle", "time": 1761.669, "timestamp": "00:29:21", "text": "座ることはできるけど、見た目は"}, {"type": "subtitle", "time": 1784.389, "timestamp": "00:29:44", "text": "アカウント。なぜ私のユーザー名はW3Nなのですか？待って。"}, {"type": "subtitle", "time": 1797.43, "timestamp": "00:29:57", "text": "無効。はい。わーい。次。うん。接続する"}]
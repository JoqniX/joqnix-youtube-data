[{"type": "subtitle", "time": 1.91, "timestamp": "00:00:01", "text": "そして、その人は私が開いているのを見ることができる"}, {"type": "subtitle", "time": 3.71, "timestamp": "00:00:03", "text": "逃げる"}, {"type": "subtitle", "time": 11.95, "timestamp": "00:00:11", "text": "私"}, {"type": "subtitle", "time": 15.829, "timestamp": "00:00:15", "text": "パートストリームには参加できません。"}, {"type": "subtitle", "time": 18.39, "timestamp": "00:00:18", "text": "私たちは一緒に過ごし、私は"}, {"type": "subtitle", "time": 21.349, "timestamp": "00:00:21", "text": "後で寝る。私たちは一緒に過ごすでしょうし、私は"}, {"type": "subtitle", "time": 23.63, "timestamp": "00:00:23", "text": "頭を向けて、なんて胸だ"}, {"type": "subtitle", "time": 28.47, "timestamp": "00:00:28", "text": "コイル マインクラフト。なぜそれが分からないのか"}, {"type": "subtitle", "time": 46.869, "timestamp": "00:00:46", "text": "実行中。ええと、私はものづくりをしています。はい、追加する必要があります"}, {"type": "subtitle", "time": 48.549, "timestamp": "00:00:48", "text": "もっと。"}]
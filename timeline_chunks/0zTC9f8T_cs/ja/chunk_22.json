[{"type": "subtitle", "time": 1326.39, "timestamp": "00:22:06", "text": "Modサーバーではありません。"}, {"type": "subtitle", "time": 1328.029, "timestamp": "00:22:08", "text": "おお"}, {"type": "subtitle", "time": 1330.549, "timestamp": "00:22:10", "text": "神。オートモードは本当に面倒くさい。それから私は"}, {"type": "subtitle", "time": 1334.71, "timestamp": "00:22:14", "text": "今すぐ削除してください。ああ、できるよ"}, {"type": "subtitle", "time": 1336.95, "timestamp": "00:22:16", "text": "コンテンツを追加する方法は2つあります"}, {"type": "subtitle", "time": 1340.39, "timestamp": "00:22:20", "text": "再利用するMODパック。同期を使用できます"}, {"type": "subtitle", "time": 1343.149, "timestamp": "00:22:23", "text": "設定ファイル内のファイル。"}, {"type": "subtitle", "time": 1347.75, "timestamp": "00:22:27", "text": "ああ、だから、あなたも入れることができると思う"}, {"type": "subtitle", "time": 1354.23, "timestamp": "00:22:34", "text": "うん。そして私はホストになる必要がある"}, {"type": "subtitle", "time": 1356.87, "timestamp": "00:22:36", "text": "推測。待って待って待って。詳細は以下をご覧ください。"}, {"type": "subtitle", "time": 1358.789, "timestamp": "00:22:38", "text": "デフォルトの例としての設定"}, {"type": "subtitle", "time": 1361.59, "timestamp": "00:22:41", "text": "コンソール。各modファイルを作成します"}, {"type": "subtitle", "time": 1364.669, "timestamp": "00:22:44", "text": "サーバーからOKの返信がありました。"}, {"type": "subtitle", "time": 1366.59, "timestamp": "00:22:46", "text": "わかった。"}, {"type": "subtitle", "time": 1369.669, "timestamp": "00:22:49", "text": "はい、何でもMODに追加できます"}, {"type": "subtitle", "time": 1372.43, "timestamp": "00:22:52", "text": "パック。ああ、つまり何でも追加できるんですね。"}, {"type": "subtitle", "time": 1376.07, "timestamp": "00:22:56", "text": "わかりました、でもちょっと待ってください、この2つの方法は"}, {"type": "subtitle", "time": 1379.95, "timestamp": "00:22:59", "text": "クライアント側のMinecraftフォルダに移動してください。"}]
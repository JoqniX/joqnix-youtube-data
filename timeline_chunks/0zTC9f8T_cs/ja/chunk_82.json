[{"type": "subtitle", "time": 4922.149, "timestamp": "01:22:02", "text": "彼女は彼女を助けに行かなければならない。"}, {"type": "subtitle", "time": 4934.47, "timestamp": "01:22:14", "text": "大砲はどのように動作するのですか？"}, {"type": "subtitle", "time": 4936.39, "timestamp": "01:22:16", "text": "あ、待って。公式設定について知りたいですか"}, {"type": "subtitle", "time": 4938.31, "timestamp": "01:22:18", "text": "仕事？待って。"}, {"type": "subtitle", "time": 4943.87, "timestamp": "01:22:23", "text": "つまり、アップグレードとはプロペラのようなものだ。"}, {"type": "subtitle", "time": 4946.229, "timestamp": "01:22:26", "text": "アップグレードしますか？待って。"}, {"type": "subtitle", "time": 4957.83, "timestamp": "01:22:37", "text": "アップグレードします。まるで自動大砲のようだ。それ"}, {"type": "subtitle", "time": 4961.229, "timestamp": "01:22:41", "text": "あなたについていきます。何てことだ。安定性、風、"}]
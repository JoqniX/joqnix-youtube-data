[{"type": "subtitle", "time": 6674.189, "timestamp": "01:51:14", "text": "出口。それは"}, {"type": "subtitle", "time": 6684.39, "timestamp": "01:51:24", "text": "あれ。くそ。"}, {"type": "subtitle", "time": 6687.51, "timestamp": "01:51:27", "text": "くそ。さあ、今度はそれを建設しなければならない。おお。おお、"}, {"type": "subtitle", "time": 6691.109, "timestamp": "01:51:31", "text": "手動で行う必要があります。そうそう。"}, {"type": "subtitle", "time": 6692.629, "timestamp": "01:51:32", "text": "痛みがひどすぎる。"}, {"type": "subtitle", "time": 6699.51, "timestamp": "01:51:39", "text": "たくさんの武器を見つけなければならないし"}, {"type": "subtitle", "time": 6701.109, "timestamp": "01:51:41", "text": "すべて。"}, {"type": "subtitle", "time": 6704.55, "timestamp": "01:51:44", "text": "私たち二人とも鎧を着ている。私はしません"}, {"type": "subtitle", "time": 6706.149, "timestamp": "01:51:46", "text": "なぜなら、私たちがあなたに鎧を与えたからです。待って、"}, {"type": "subtitle", "time": 6707.91, "timestamp": "01:51:47", "text": "待って、待って。今の見た？待って、"}, {"type": "subtitle", "time": 6710.47, "timestamp": "01:51:50", "text": "アストラ。アストラ、これ見た？うん、"}, {"type": "subtitle", "time": 6713.589, "timestamp": "01:51:53", "text": "あなたの配信を見ています。削除する"}, {"type": "subtitle", "time": 6715.669, "timestamp": "01:51:55", "text": "ヘルメットか、あなたが外したもの"}, {"type": "subtitle", "time": 6719.03, "timestamp": "01:51:59", "text": "以前。手順をやり直してください。いいえ、違います"}]
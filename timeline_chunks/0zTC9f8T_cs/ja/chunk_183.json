[{"type": "subtitle", "time": 10981.59, "timestamp": "03:03:01", "text": "2番。十分な呪文が利用できません"}, {"type": "subtitle", "time": 10983.79, "timestamp": "03:03:03", "text": "彼の階。"}, {"type": "subtitle", "time": 10995.75, "timestamp": "03:03:15", "text": "神。ああ、でもそれは詐欺だよ、兄弟。何？"}, {"type": "subtitle", "time": 10997.99, "timestamp": "03:03:17", "text": "何もない。"}, {"type": "subtitle", "time": 10999.87, "timestamp": "03:03:19", "text": "待って、見たい。 1つ"}, {"type": "subtitle", "time": 11002.63, "timestamp": "03:03:22", "text": "2番。飛行機に似ています"}, {"type": "subtitle", "time": 11006.309, "timestamp": "03:03:26", "text": "あれ。おお。飛行機が今。同じもの。"}, {"type": "subtitle", "time": 11019.03, "timestamp": "03:03:39", "text": "レッドストーンの導管。"}, {"type": "subtitle", "time": 11021.71, "timestamp": "03:03:41", "text": "トンネル掘削機が必要です。"}, {"type": "subtitle", "time": 11024.03, "timestamp": "03:03:44", "text": "Hは"}, {"type": "subtitle", "time": 11027.87, "timestamp": "03:03:47", "text": "地下M。これ以上採掘しない"}, {"type": "subtitle", "time": 11031.75, "timestamp": "03:03:51", "text": "それは一体何ですか？"}]
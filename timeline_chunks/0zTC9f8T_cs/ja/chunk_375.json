[{"type": "subtitle", "time": 22500.948, "timestamp": "06:15:00", "text": "1つ。フォージとネオフォージだけです。"}, {"type": "subtitle", "time": 22505.99, "timestamp": "06:15:05", "text": "鍛冶モードを導入する方法はありますか？"}, {"type": "subtitle", "time": 22509.51, "timestamp": "06:15:09", "text": "布地？互換性タイプはありませんか？"}, {"type": "subtitle", "time": 22515.83, "timestamp": "06:15:15", "text": "何でも？これには全体的に"}, {"type": "subtitle", "time": 22522.548, "timestamp": "06:15:22", "text": "けれど。これには完全なシステムがある。あなたはできる"}, {"type": "subtitle", "time": 22526.868, "timestamp": "06:15:26", "text": "それにアップグレードを追加する。スピードを上げて"}, {"type": "subtitle", "time": 22530.628, "timestamp": "06:15:30", "text": "もしくは何か、もしくは爆発として機能させる"}, {"type": "subtitle", "time": 22531.788, "timestamp": "06:15:31", "text": "または"}, {"type": "subtitle", "time": 22533.948, "timestamp": "06:15:33", "text": "何でも。たくさん"}, {"type": "subtitle", "time": 22536.31, "timestamp": "06:15:36", "text": "もの。私はこのビデオを見ていました。私は"}, {"type": "subtitle", "time": 22538.47, "timestamp": "06:15:38", "text": "「ああ、なんてことだ、これはひどい」という感じ。良い。"}, {"type": "subtitle", "time": 22541.23, "timestamp": "06:15:41", "text": "そして私が欲しかったもう一つのものは"}, {"type": "subtitle", "time": 22545.59, "timestamp": "06:15:45", "text": "これ。スピードとか燃料とか"}, {"type": "subtitle", "time": 22548.83, "timestamp": "06:15:48", "text": "効率など。"}, {"type": "subtitle", "time": 22553.11, "timestamp": "06:15:53", "text": "工場では、入力があって、"}, {"type": "subtitle", "time": 22555.03, "timestamp": "06:15:55", "text": "出力物。"}]
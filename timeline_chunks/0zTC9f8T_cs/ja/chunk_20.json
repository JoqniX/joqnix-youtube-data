[{"type": "subtitle", "time": 1200.71, "timestamp": "00:20:00", "text": "ダウンロードすると再起動を求められます"}, {"type": "subtitle", "time": 1202.789, "timestamp": "00:20:02", "text": "既にダウンロード済みだからです。私はそれを"}, {"type": "subtitle", "time": 1205.029, "timestamp": "00:20:05", "text": "私のすべてのMODが検証されました。それは"}, {"type": "subtitle", "time": 1207.43, "timestamp": "00:20:07", "text": "働く。再起動するだけでいいんです。それは"}, {"type": "subtitle", "time": 1210.029, "timestamp": "00:20:10", "text": "実際、かなり良いMODだ。"}, {"type": "subtitle", "time": 1212.23, "timestamp": "00:20:12", "text": "うん。ダウンロードしますか？それ"}, {"type": "subtitle", "time": 1215.43, "timestamp": "00:20:15", "text": "危険かもしれない。うん。ああ、主よ、"}, {"type": "subtitle", "time": 1218.63, "timestamp": "00:20:18", "text": "何らかの問題が発生したと表示されます。何か"}, {"type": "subtitle", "time": 1220.39, "timestamp": "00:20:20", "text": "うまくいかなかった。何が問題だったのか？その"}, {"type": "subtitle", "time": 1222.87, "timestamp": "00:20:22", "text": "私のためにダウンロードしています。"}, {"type": "subtitle", "time": 1227.39, "timestamp": "00:20:27", "text": "彼らには音楽もある。何？はい、"}, {"type": "subtitle", "time": 1230.549, "timestamp": "00:20:30", "text": "パズルラボが必要です。よし、私たちは"}, {"type": "subtitle", "time": 1233.669, "timestamp": "00:20:33", "text": "不足している設定があります。おお、"}, {"type": "subtitle", "time": 1235.669, "timestamp": "00:20:35", "text": "あと2つ追加する必要があると思う。ファイルなし"}, {"type": "subtitle", "time": 1239.19, "timestamp": "00:20:39", "text": "ダウンロードするには。お待ちください。モルグパックには"}, {"type": "subtitle", "time": 1241.11, "timestamp": "00:20:41", "text": "ダウンロードされました。プレイしなければならないのですか？"}, {"type": "subtitle", "time": 1242.63, "timestamp": "00:20:42", "text": "ゲームを再起動する必要があります。あなたは"}, {"type": "subtitle", "time": 1246.95, "timestamp": "00:20:46", "text": "今すぐ再起動しますか？えっと、レビューの変更"}, {"type": "subtitle", "time": 1249.83, "timestamp": "00:20:49", "text": "ログ。待って、待って。"}, {"type": "subtitle", "time": 1251.83, "timestamp": "00:20:51", "text": "ええ、待ってください。私は電源を切っています"}, {"type": "subtitle", "time": 1253.99, "timestamp": "00:20:53", "text": "サーバ。わかった。あと2つ追加する必要がある"}, {"type": "subtitle", "time": 1255.75, "timestamp": "00:20:55", "text": "モッズ。クライアント側とサーバー側の問題だと思います。"}, {"type": "subtitle", "time": 1257.99, "timestamp": "00:20:57", "text": "のみ。それがクライアントかどうかはわかりません"}]
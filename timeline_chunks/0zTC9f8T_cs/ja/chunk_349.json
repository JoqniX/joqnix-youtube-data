[{"type": "subtitle", "time": 20990.23, "timestamp": "05:49:50", "text": "互換性があり、押し込むことができる"}, {"type": "subtitle", "time": 20993.03, "timestamp": "05:49:53", "text": "幅広の剣の熱を倍増させる。"}, {"type": "subtitle", "time": 20995.51, "timestamp": "05:49:55", "text": "これがうまくいくことを願おう。もしそうでないなら"}, {"type": "subtitle", "time": 20998.708, "timestamp": "05:49:58", "text": "そうなると、痛みを感じる。"}]
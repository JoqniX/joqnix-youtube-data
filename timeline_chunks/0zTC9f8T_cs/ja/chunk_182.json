[{"type": "subtitle", "time": 10932.07, "timestamp": "03:02:12", "text": "わかった。連絡なし。私は本当に自分の"}, {"type": "subtitle", "time": 10934.55, "timestamp": "03:02:14", "text": "今は自分の家を持っていて、これら全てをプレイしています"}, {"type": "subtitle", "time": 10937.91, "timestamp": "03:02:17", "text": "楽器を演奏して、自分のスタジオを作る。"}, {"type": "subtitle", "time": 10953.389, "timestamp": "03:02:33", "text": "おお。私は彼らの半分も知らない。"}, {"type": "subtitle", "time": 10963.11, "timestamp": "03:02:43", "text": "ドリルマシンを試運転してみます。"}, {"type": "subtitle", "time": 10965.83, "timestamp": "03:02:45", "text": "え、ドリルが欲しかったの？"}, {"type": "subtitle", "time": 10968.15, "timestamp": "03:02:48", "text": "確認したかったんです。"}, {"type": "subtitle", "time": 10978.429, "timestamp": "03:02:58", "text": "もっと？ええ、確認したかったんです。えーと、1つ"}]
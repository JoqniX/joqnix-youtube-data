[{"type": "subtitle", "time": 967.67, "timestamp": "00:16:07", "text": "コマンドはどこにありますか、えっと、私は"}, {"type": "subtitle", "time": 970.389, "timestamp": "00:16:10", "text": "ファイルを読む必要があると思います"}, {"type": "subtitle", "time": 972.509, "timestamp": "00:16:12", "text": "えっと、これは"}, {"type": "subtitle", "time": 974.87, "timestamp": "00:16:14", "text": "作品。コマンドとは何ですか？"}, {"type": "subtitle", "time": 976.87, "timestamp": "00:16:16", "text": "すべて？"}, {"type": "subtitle", "time": 978.87, "timestamp": "00:16:18", "text": "方法"}, {"type": "subtitle", "time": 981.829, "timestamp": "00:16:21", "text": "この自動改造パックはどうすればいいですか？"}, {"type": "subtitle", "time": 984.389, "timestamp": "00:16:24", "text": "ああ、インストールすればいいだけだよ。追加するだけです。"}, {"type": "subtitle", "time": 986.949, "timestamp": "00:16:26", "text": "追加するだけです。それでおしまい。"}, {"type": "subtitle", "time": 994.069, "timestamp": "00:16:34", "text": "つまり、構成サーバーの設定です。あなたが持っている"}, {"type": "subtitle", "time": 996.949, "timestamp": "00:16:36", "text": "それを読むために。私は推測する"}, {"type": "subtitle", "time": 1000.15, "timestamp": "00:16:40", "text": "サーバーが起動したら、コピーするだけでいい"}, {"type": "subtitle", "time": 1003.59, "timestamp": "00:16:43", "text": "自動モッドパックを貼り付けるか、これらは"}, {"type": "subtitle", "time": 1005.749, "timestamp": "00:16:45", "text": "その３つの道具。"}, {"type": "subtitle", "time": 1008.71, "timestamp": "00:16:48", "text": "他の３人も？"}, {"type": "subtitle", "time": 1017.91, "timestamp": "00:16:57", "text": "えっと、アストラ、君は正しくやってるよ"}]
[{"type": "subtitle", "time": 27244.19, "timestamp": "07:34:04", "text": "みんな。来たよ。私は見えていますか？はい、あなたは"}, {"type": "subtitle", "time": 27245.788, "timestamp": "07:34:05", "text": "見える。"}, {"type": "subtitle", "time": 27258.75, "timestamp": "07:34:18", "text": "来た。"}, {"type": "subtitle", "time": 27263.11, "timestamp": "07:34:23", "text": "わかった。なぜ？私は当然知っている？ええ、そうです"}, {"type": "subtitle", "time": 27265.83, "timestamp": "07:34:25", "text": "なぜなら私たちは実験しているからです"}, {"type": "subtitle", "time": 27270.07, "timestamp": "07:34:30", "text": "シェアチャット機能のことですね。"}, {"type": "subtitle", "time": 27272.07, "timestamp": "07:34:32", "text": "待って、あなたは両方のチャットに参加しているの？"}, {"type": "subtitle", "time": 27273.43, "timestamp": "07:34:33", "text": "両端が"}, {"type": "subtitle", "time": 27275.75, "timestamp": "07:34:35", "text": "グラフ。ブレット、ブレットとピーク"}, {"type": "subtitle", "time": 27278.948, "timestamp": "07:34:38", "text": "それらは私たちの両方のチャートに載っています。すべては"}, {"type": "subtitle", "time": 27281.67, "timestamp": "07:34:41", "text": "1つ。まるで両者が融合したかのようだ。"}, {"type": "subtitle", "time": 27285.19, "timestamp": "07:34:45", "text": "うん。うん。良くなった。それはより良い"}, {"type": "subtitle", "time": 27287.67, "timestamp": "07:34:47", "text": "君たちのことをよく見ておくよ。うん。それはとても"}, {"type": "subtitle", "time": 27289.99, "timestamp": "07:34:49", "text": "よし、これでいい。"}, {"type": "subtitle", "time": 27292.31, "timestamp": "07:34:52", "text": "お互いに話すこともできますよ。こんにちは"}, {"type": "subtitle", "time": 27298.628, "timestamp": "07:34:58", "text": "ええ、お互いに挨拶してもいいですよ。"}]
[{"type": "subtitle", "time": 10448.83, "timestamp": "02:54:08", "text": "いや、いや。どこにいるの？あなたに"}, {"type": "subtitle", "time": 10452.95, "timestamp": "02:54:12", "text": "ピアノ。え、ギターが欲しいの？"}, {"type": "subtitle", "time": 10454.63, "timestamp": "02:54:14", "text": "うん、"}, {"type": "subtitle", "time": 10457.91, "timestamp": "02:54:17", "text": "ギター。待って。えっと、それは、待って、"}, {"type": "subtitle", "time": 10461.23, "timestamp": "02:54:21", "text": "ギターはどれですか？バイオリン、"}, {"type": "subtitle", "time": 10464.87, "timestamp": "02:54:24", "text": "ウクレレ、チャイム。あなたはウクレレを持っていますね。うん。"}, {"type": "subtitle", "time": 10466.469, "timestamp": "02:54:26", "text": "それが欲しいのか？わかった、あげるよ。"}, {"type": "subtitle", "time": 10469.75, "timestamp": "02:54:29", "text": "どこにいるの？滑走路へお越しください。私"}, {"type": "subtitle", "time": 10472.389, "timestamp": "02:54:32", "text": "保管しておきます。"}, {"type": "subtitle", "time": 10474.95, "timestamp": "02:54:34", "text": "私は農場にいます。"}, {"type": "subtitle", "time": 10478.23, "timestamp": "02:54:38", "text": "皆さんのために料理を作っています。"}, {"type": "subtitle", "time": 10484.83, "timestamp": "02:54:44", "text": "遺物を入手して"}, {"type": "subtitle", "time": 10499.99, "timestamp": "02:54:59", "text": "あなたの求人情報を送ります。この遺物を追加するだけ"}]
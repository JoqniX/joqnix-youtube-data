[{"type": "subtitle", "time": 1503.11, "timestamp": "00:25:03", "text": "ba。总之，我就……把它放上船吧。"}, {"type": "subtitle", "time": 1519.549, "timestamp": "00:25:19", "text": "是啊，我真不该冒这个险。"}, {"type": "subtitle", "time": 1522.25, "timestamp": "00:25:22", "text": "这。对不起，各位。我要去"}, {"type": "subtitle", "time": 1523.71, "timestamp": "00:25:23", "text": "[音乐]"}, {"type": "subtitle", "time": 1551.99, "timestamp": "00:25:51", "text": "少量。我不想在我的……等等，"}, {"type": "subtitle", "time": 1554.789, "timestamp": "00:25:54", "text": "我应该尝试做我想驼背的动作吗？"}, {"type": "subtitle", "time": 1558.789, "timestamp": "00:25:58", "text": "我一直都坐在椅子上。我只会……我会"}]
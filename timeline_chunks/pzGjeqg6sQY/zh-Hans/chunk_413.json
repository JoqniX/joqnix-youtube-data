[{"type": "subtitle", "time": 24780.99, "timestamp": "06:53:00", "text": "临时到访的客人。"}, {"type": "subtitle", "time": 24784.468, "timestamp": "06:53:04", "text": "我今天玩得很开心。我呃去了"}, {"type": "subtitle", "time": 24786.788, "timestamp": "06:53:06", "text": "呃，我和朋友多尔去看电影了。"}, {"type": "subtitle", "time": 24790.15, "timestamp": "06:53:10", "text": "今天。我们的朋友。那太好了。"}, {"type": "subtitle", "time": 24795.67, "timestamp": "06:53:15", "text": "是的。是的。也让我活下去吧。"}, {"type": "subtitle", "time": 24797.99, "timestamp": "06:53:17", "text": "好的。"}, {"type": "subtitle", "time": 24801.03, "timestamp": "06:53:21", "text": "我的天啊。我的天啊。它磨损得很厉害。"}, {"type": "subtitle", "time": 24803.43, "timestamp": "06:53:23", "text": "我的天啊。等等，你能听到他说话吗？全部"}, {"type": "subtitle", "time": 24805.91, "timestamp": "06:53:25", "text": "没错。各位，稍等。让我"}, {"type": "subtitle", "time": 24808.468, "timestamp": "06:53:28", "text": "自我检查一下。哦，等等。我做了吗？哦，是的。"}, {"type": "subtitle", "time": 24819.59, "timestamp": "06:53:39", "text": "等待。那么，你今天感觉如何？"}, {"type": "subtitle", "time": 24822.31, "timestamp": "06:53:42", "text": "我的恐惧症？好的。你感觉怎么样？我"}, {"type": "subtitle", "time": 24824.868, "timestamp": "06:53:44", "text": "我吓死了。你感到害怕"}, {"type": "subtitle", "time": 24827.99, "timestamp": "06:53:47", "text": "他妈的。我的天哪。等待。等待。我感觉自己就像……"}, {"type": "subtitle", "time": 24830.548, "timestamp": "06:53:50", "text": "胆小鬼。比如，我无法忍受恐怖"}, {"type": "subtitle", "time": 24832.788, "timestamp": "06:53:52", "text": "我就是因为这个才玩到这款游戏的。"}, {"type": "subtitle", "time": 24835.83, "timestamp": "06:53:55", "text": "合作。相同的。我也买了这款游戏。"}]
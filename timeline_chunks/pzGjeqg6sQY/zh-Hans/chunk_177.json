[{"type": "subtitle", "time": 10622.79, "timestamp": "02:57:02", "text": "她努力尝试，我觉得她只是想……"}, {"type": "subtitle", "time": 10624.349, "timestamp": "02:57:04", "text": "让我继续工作"}, {"type": "subtitle", "time": 10627.75, "timestamp": "02:57:07", "text": "难的。她对现状非常不满"}, {"type": "subtitle", "time": 10630.389, "timestamp": "02:57:10", "text": "我审视着自己。"}, {"type": "subtitle", "time": 10632.349, "timestamp": "02:57:12", "text": "我记得她曾经"}, {"type": "subtitle", "time": 10634.24, "timestamp": "02:57:14", "text": "他说：“运气在于……”"}, {"type": "subtitle", "time": 10636.03, "timestamp": "02:57:16", "text": "[音乐]"}, {"type": "subtitle", "time": 10638.469, "timestamp": "02:57:18", "text": "决定你成功的因素，但是"}, {"type": "subtitle", "time": 10640.59, "timestamp": "02:57:20", "text": "你"}, {"type": "subtitle", "time": 10649.03, "timestamp": "02:57:29", "text": "诚实的。谢谢你帮我理解"}, {"type": "subtitle", "time": 10651.269, "timestamp": "02:57:31", "text": "我姐姐的想法。谢谢你的帮助"}, {"type": "subtitle", "time": 10652.95, "timestamp": "02:57:32", "text": "让我理解我的妹妹。我接受"}, {"type": "subtitle", "time": 10655.429, "timestamp": "02:57:35", "text": "向她倾诉衷肠，并表示欢迎"}, {"type": "subtitle", "time": 10657.99, "timestamp": "02:57:37", "text": "我人生的新篇章即将开启，非常棒！"}, {"type": "subtitle", "time": 10666.269, "timestamp": "02:57:46", "text": "感谢你一路陪伴我。"}, {"type": "subtitle", "time": 10669.03, "timestamp": "02:57:49", "text": "方式。起床。我的天哪，我当时在下面"}, {"type": "subtitle", "time": 10672.19, "timestamp": "02:57:52", "text": "桌子。我的天哪，我简直无法……"}, {"type": "subtitle", "time": 10675.99, "timestamp": "02:57:55", "text": "读。我喜欢我变得像个T恤衫一样。"}, {"type": "subtitle", "time": 10678.11, "timestamp": "02:57:58", "text": "像乌龟一样"}]
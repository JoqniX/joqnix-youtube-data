[{"type": "subtitle", "time": 25142.468, "timestamp": "06:59:02", "text": "等级？好的。亚洲得到了亚洲，然后在"}, {"type": "subtitle", "time": 25145.51, "timestamp": "06:59:05", "text": "中间人创建了大厅。哦好的。"}, {"type": "subtitle", "time": 25147.27, "timestamp": "06:59:07", "text": "玩恐怖游戏。是的。你想要它"}, {"type": "subtitle", "time": 25149.35, "timestamp": "06:59:09", "text": "保持隐私？"}, {"type": "subtitle", "time": 25150.708, "timestamp": "06:59:10", "text": "是的当然。它应该是"}, {"type": "subtitle", "time": 25152.07, "timestamp": "06:59:12", "text": "我想应该是私人的。哦，是的。是的，"}, {"type": "subtitle", "time": 25153.07, "timestamp": "06:59:13", "text": "课程。我"}, {"type": "subtitle", "time": 25158.868, "timestamp": "06:59:18", "text": "实际上，我们应该喜欢我们"}, {"type": "subtitle", "time": 25161.59, "timestamp": "06:59:21", "text": "最初我问的是塞拉斯蒂娅和"}, {"type": "subtitle", "time": 25164.31, "timestamp": "06:59:24", "text": "Armsus 也玩这个游戏。但后来我"}, {"type": "subtitle", "time": 25166.548, "timestamp": "06:59:26", "text": "你知道，如果那样会更有趣。"}, {"type": "subtitle", "time": 25169.03, "timestamp": "06:59:29", "text": "如果我们俩，只有我和 Jokish Empire"}, {"type": "subtitle", "time": 25171.67, "timestamp": "06:59:31", "text": "玩这个游戏是因为我们真的很害怕"}, {"type": "subtitle", "time": 25174.15, "timestamp": "06:59:34", "text": "像我们这样的人很容易被吓到。"}, {"type": "subtitle", "time": 25176.708, "timestamp": "06:59:36", "text": "差不多。所以当时我就是这样。"}, {"type": "subtitle", "time": 25180.708, "timestamp": "06:59:40", "text": "会是很好的内容。就这么办吧。"}, {"type": "subtitle", "time": 25184.19, "timestamp": "06:59:44", "text": "是的。是的。我的天哪。等不及了。"}, {"type": "subtitle", "time": 25186.948, "timestamp": "06:59:46", "text": "比如提供帮助。所以，我应该带两瓶吗？"}, {"type": "subtitle", "time": 25189.03, "timestamp": "06:59:49", "text": "双人游戏大厅？是的，我们应该玩……"}, {"type": "subtitle", "time": 25191.75, "timestamp": "06:59:51", "text": "双人游戏大厅。是的，双人游戏。"}, {"type": "subtitle", "time": 25193.51, "timestamp": "06:59:53", "text": "我相信那里应该有类似大厅密码之类的东西。"}, {"type": "subtitle", "time": 25196.788, "timestamp": "06:59:56", "text": "某物。所以，我还是把它藏起来吧。嗯。"}]
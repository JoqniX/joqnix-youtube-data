[{"type": "subtitle", "time": 10562.87, "timestamp": "02:56:02", "text": "高度。 V 膨胀之前"}, {"type": "subtitle", "time": 10566.269, "timestamp": "02:56:06", "text": "我自己不断地承担着我所有的负担"}, {"type": "subtitle", "time": 10568.309, "timestamp": "02:56:08", "text": "心。我觉得它真漂亮"}, {"type": "subtitle", "time": 10570.269, "timestamp": "02:56:10", "text": "地点"}, {"type": "subtitle", "time": 10572.389, "timestamp": "02:56:12", "text": "拉伸一下确实对我有帮助"}, {"type": "subtitle", "time": 10573.95, "timestamp": "02:56:13", "text": "通过"}, {"type": "subtitle", "time": 10577.03, "timestamp": "02:56:17", "text": "考试，还有另一个重要的问题。"}, {"type": "subtitle", "time": 10580.23, "timestamp": "02:56:20", "text": "课。最后有人放弃了"}, {"type": "subtitle", "time": 10582.23, "timestamp": "02:56:22", "text": "他们给了我机会，我就是这样逃脱的。"}, {"type": "subtitle", "time": 10588.389, "timestamp": "02:56:28", "text": "或许我会去爬山"}, {"type": "subtitle", "time": 10590.87, "timestamp": "02:56:30", "text": "一个又一个山峰等待着"}, {"type": "subtitle", "time": 10594.87, "timestamp": "02:56:34", "text": "让我攀登血汗的痛苦"}, {"type": "subtitle", "time": 10598.95, "timestamp": "02:56:38", "text": "眼泪最终会转化为"}, {"type": "subtitle", "time": 10600.269, "timestamp": "02:56:40", "text": "无边无际"}, {"type": "subtitle", "time": 10603.51, "timestamp": "02:56:43", "text": "登顶后的喜悦。有"}, {"type": "subtitle", "time": 10605.03, "timestamp": "02:56:45", "text": "你姐姐还在尝试做另一件事"}, {"type": "subtitle", "time": 10607.67, "timestamp": "02:56:47", "text": "告诉你。"}, {"type": "subtitle", "time": 10611.63, "timestamp": "02:56:51", "text": "嗯，你的过去深深地塑造了你。"}, {"type": "subtitle", "time": 10614.23, "timestamp": "02:56:54", "text": "是。听起来像我姐姐说的那样。"}, {"type": "subtitle", "time": 10615.79, "timestamp": "02:56:55", "text": "某物"}, {"type": "subtitle", "time": 10618.469, "timestamp": "02:56:58", "text": "大约。这些女孩记录了我的"}]
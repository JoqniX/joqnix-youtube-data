[{"type": "subtitle", "time": 4920.35, "timestamp": "01:22:00", "text": "我玩过的第一款中国游戏"}, {"type": "subtitle", "time": 4924.27, "timestamp": "01:22:04", "text": "玩过。哦，真有趣。实际上"}, {"type": "subtitle", "time": 4926.709, "timestamp": "01:22:06", "text": "乐趣。我喜欢你的模型。你设计过吗？"}, {"type": "subtitle", "time": 4930.149, "timestamp": "01:22:10", "text": "自己做？呃，设计"}, {"type": "subtitle", "time": 4933.43, "timestamp": "01:22:13", "text": "呃，这个模型的设计是由一个……完成的。"}, {"type": "subtitle", "time": 4936.47, "timestamp": "01:22:16", "text": "我的好朋友。呃，就像……"}, {"type": "subtitle", "time": 4940.07, "timestamp": "01:22:20", "text": "送给我的生日礼物。是的，设计"}, {"type": "subtitle", "time": 4942.149, "timestamp": "01:22:22", "text": "呃，这是最初的那种……"}, {"type": "subtitle", "time": 4943.149, "timestamp": "01:22:23", "text": "测试"}, {"type": "subtitle", "time": 4946.51, "timestamp": "01:22:26", "text": "Jock 的版本设计。"}, {"type": "subtitle", "time": 4949.91, "timestamp": "01:22:29", "text": "是的，我确实有一个原版。"}, {"type": "subtitle", "time": 4967.99, "timestamp": "01:22:47", "text": "是啊，我以为会是“我的天哪”。"}, {"type": "subtitle", "time": 4972.39, "timestamp": "01:22:52", "text": "呃，我只能礼貌地拒绝了。"}, {"type": "subtitle", "time": 4974.11, "timestamp": "01:22:54", "text": "因为"}, {"type": "subtitle", "time": 4978.709, "timestamp": "01:22:58", "text": "呃，因为呃，我的经理负责处理大部分事情"}]
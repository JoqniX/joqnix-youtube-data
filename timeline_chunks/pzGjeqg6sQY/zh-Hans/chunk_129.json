[{"type": "subtitle", "time": 7746.3, "timestamp": "02:09:06", "text": "做？哦，我做到了。我做到了。我做了"}, {"type": "subtitle", "time": 7747.79, "timestamp": "02:09:07", "text": "[音乐]"}, {"type": "subtitle", "time": 7761.51, "timestamp": "02:09:21", "text": "点击。点击。和……拍了一张集体照"}, {"type": "subtitle", "time": 7769.0, "timestamp": "02:09:29", "text": "孩子们。当然。"}, {"type": "subtitle", "time": 7775.99, "timestamp": "02:09:35", "text": "最后。哦，我什么也没挣到。哦"}, {"type": "subtitle", "time": 7783.99, "timestamp": "02:09:43", "text": "上帝。这是谁？"}, {"type": "subtitle", "time": 7785.99, "timestamp": "02:09:45", "text": "拿着，小猫咪。小猫咪。你的森林"}, {"type": "subtitle", "time": 7787.75, "timestamp": "02:09:47", "text": "那些酒吧。你很有个性吗？拿来。"}, {"type": "subtitle", "time": 7788.669, "timestamp": "02:09:48", "text": "喵。"}, {"type": "subtitle", "time": 7793.35, "timestamp": "02:09:53", "text": "obstac程序再次崩溃。甚至"}, {"type": "subtitle", "time": 7795.03, "timestamp": "02:09:55", "text": "虽然我已经优化过了。它似乎"}, {"type": "subtitle", "time": 7798.589, "timestamp": "02:09:58", "text": "就像多米诺骨牌仍然无法倒下一样"}]
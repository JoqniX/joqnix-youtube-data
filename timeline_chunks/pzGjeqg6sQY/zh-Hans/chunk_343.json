[{"type": "subtitle", "time": 20581.548, "timestamp": "05:43:01", "text": "淡入淡出"}, {"type": "subtitle", "time": 20588.788, "timestamp": "05:43:08", "text": "出去。淡入。淡入淡出是一种"}, {"type": "subtitle", "time": 20591.59, "timestamp": "05:43:11", "text": "更好的。所以，当我想要范围的时候"}, {"type": "subtitle", "time": 20600.868, "timestamp": "05:43:20", "text": "呃，我该怎么做？"}, {"type": "subtitle", "time": 20602.948, "timestamp": "05:43:22", "text": "动画状态应用之前"}, {"type": "subtitle", "time": 20606.11, "timestamp": "05:43:26", "text": "在"}, {"type": "subtitle", "time": 20607.788, "timestamp": "05:43:27", "text": "动画。"}, {"type": "subtitle", "time": 20612.99, "timestamp": "05:43:32", "text": "嗯。所以我认为射程终点会是……"}, {"type": "subtitle", "time": 20616.788, "timestamp": "05:43:36", "text": "中间。射程开始时间应该就是这样。"}, {"type": "subtitle", "time": 20620.27, "timestamp": "05:43:40", "text": "到此为止。"}, {"type": "subtitle", "time": 20626.39, "timestamp": "05:43:46", "text": "正确的。动画开启了这一主题"}, {"type": "subtitle", "time": 20630.548, "timestamp": "05:43:50", "text": "刚刚开始出现在视野中。"}, {"type": "subtitle", "time": 20632.868, "timestamp": "05:43:52", "text": "出现在视野中。是的，当它出现在"}, {"type": "subtitle", "time": 20636.548, "timestamp": "05:43:56", "text": "查看，它会像透明度一样。"}, {"type": "subtitle", "time": 20637.47, "timestamp": "05:43:57", "text": "是"}]
[{"type": "subtitle", "time": 21300.23, "timestamp": "05:55:00", "text": "这是吗？简化为两个简单的步骤。"}, {"type": "subtitle", "time": 21301.75, "timestamp": "05:55:01", "text": "我们将添加一个动画组"}, {"type": "subtitle", "time": 21303.35, "timestamp": "05:55:03", "text": "我们将设定一个持续时间"}, {"type": "subtitle", "time": 21305.59, "timestamp": "05:55:05", "text": "我们选择任何动画。我们"}, {"type": "subtitle", "time": 21306.788, "timestamp": "05:55:06", "text": "开始吧，一定要看完。"}, {"type": "subtitle", "time": 21308.47, "timestamp": "05:55:08", "text": "动画入门视频，因为它即将……"}, {"type": "subtitle", "time": 21309.75, "timestamp": "05:55:09", "text": "遮盖一些东西。"}, {"type": "subtitle", "time": 21311.27, "timestamp": "05:55:11", "text": "凌晨3点。我们开始吧。"}, {"type": "subtitle", "time": 21313.27, "timestamp": "05:55:13", "text": "首先添加动画。我不能"}, {"type": "subtitle", "time": 21315.27, "timestamp": "05:55:15", "text": "睡觉。这是一切的基础。"}, {"type": "subtitle", "time": 21317.43, "timestamp": "05:55:17", "text": "Web Studio 中的滚动驱动动画。"}, {"type": "subtitle", "time": 21319.43, "timestamp": "05:55:19", "text": "它的工作原理是通过动画化每个元素来实现的。"}, {"type": "subtitle", "time": 21321.27, "timestamp": "05:55:21", "text": "儿童内容。所以，我们要拖拽"}, {"type": "subtitle", "time": 21323.75, "timestamp": "05:55:23", "text": "我们希望每个孩子都能被动画化。"}, {"type": "subtitle", "time": 21325.99, "timestamp": "05:55:25", "text": "现在，让我们来看动画部分。"}, {"type": "subtitle", "time": 21329.35, "timestamp": "05:55:29", "text": "定义一个新的动画。我们开始吧"}, {"type": "subtitle", "time": 21331.99, "timestamp": "05:55:31", "text": "或许是视差效果。视差效果只是"}, {"type": "subtitle", "time": 21334.628, "timestamp": "05:55:34", "text": "基本上就是一个向上滑动的动画。经过"}, {"type": "subtitle", "time": 21335.91, "timestamp": "05:55:35", "text": "默认情况下，这种情况只会在以下情况下发生："}, {"type": "subtitle", "time": 21337.19, "timestamp": "05:55:37", "text": "滚动到视图中，但它已经在里面了。"}, {"type": "subtitle", "time": 21338.948, "timestamp": "05:55:38", "text": "视野开阔，所以我们什么也看不到。所以，我们"}, {"type": "subtitle", "time": 21340.548, "timestamp": "05:55:40", "text": "需要通过打开来更改持续时间。"}, {"type": "subtitle", "time": 21343.628, "timestamp": "05:55:43", "text": "启动动画并进行设置"}, {"type": "subtitle", "time": 21345.59, "timestamp": "05:55:45", "text": "期间。我们希望这种情况持续多久？"}, {"type": "subtitle", "time": 21348.07, "timestamp": "05:55:48", "text": "要拍摄动画吗？我们计时1秒钟。"}, {"type": "subtitle", "time": 21350.47, "timestamp": "05:55:50", "text": "呃，我们花两秒钟让它非常"}, {"type": "subtitle", "time": 21352.23, "timestamp": "05:55:52", "text": "显。"}, {"type": "subtitle", "time": 21354.23, "timestamp": "05:55:54", "text": "现在我们也可以看到范围的结束"}, {"type": "subtitle", "time": 21356.07, "timestamp": "05:55:56", "text": "这里显示为灰色，因为……"}, {"type": "subtitle", "time": 21357.99, "timestamp": "05:55:57", "text": "确定它的起始位置和"}]
[{"type": "subtitle", "time": 22504.99, "timestamp": "06:15:04", "text": "呃，这是在移动吗？还是我在移动？"}, {"type": "subtitle", "time": 22514.83, "timestamp": "06:15:14", "text": "我这样做吗？"}, {"type": "subtitle", "time": 22531.83, "timestamp": "06:15:31", "text": "秒。如果我们也旋转一下呢？我们开始吧"}, {"type": "subtitle", "time": 22534.51, "timestamp": "06:15:34", "text": "随便做什么都行，"}, {"type": "subtitle", "time": 22537.03, "timestamp": "06:15:37", "text": "男人。什么事都没发生。我正在获得"}, {"type": "subtitle", "time": 22544.39, "timestamp": "06:15:44", "text": "那里。哦，我忘了把它放在下面了。"}, {"type": "subtitle", "time": 22548.23, "timestamp": "06:15:48", "text": "团体。哦，我真是太笨了。我的天啊。"}, {"type": "subtitle", "time": 22549.628, "timestamp": "06:15:49", "text": "哦，我的"}, {"type": "subtitle", "time": 22559.11, "timestamp": "06:15:59", "text": "凉爽的。真好。我胡乱摆弄了一番"}]
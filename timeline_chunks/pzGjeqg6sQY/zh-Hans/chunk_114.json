[{"type": "subtitle", "time": 6842.47, "timestamp": "01:54:02", "text": "他们怎么知道我甚至"}, {"type": "subtitle", "time": 6846.47, "timestamp": "01:54:06", "text": "虽然像 YouTube 的标志一样被移除了。"}, {"type": "subtitle", "time": 6849.03, "timestamp": "01:54:09", "text": "他们怎么知道我在看电视？"}, {"type": "subtitle", "time": 6855.149, "timestamp": "01:54:15", "text": "视频？他们是如何做到的？"}, {"type": "subtitle", "time": 6856.91, "timestamp": "01:54:16", "text": "知道？"}, {"type": "subtitle", "time": 6860.589, "timestamp": "01:54:20", "text": "哇，他们的检测系统太酷了。"}, {"type": "subtitle", "time": 6869.709, "timestamp": "01:54:29", "text": "知道。它在监视"}, {"type": "subtitle", "time": 6876.95, "timestamp": "01:54:36", "text": "[音乐]"}, {"type": "subtitle", "time": 6882.83, "timestamp": "01:54:42", "text": "尽管，"}, {"type": "subtitle", "time": 6886.43, "timestamp": "01:54:46", "text": "男人。肯定是"}, {"type": "subtitle", "time": 6889.109, "timestamp": "01:54:49", "text": "小心。你看到摄像头了吗？我的相机是"}, {"type": "subtitle", "time": 6895.31, "timestamp": "01:54:55", "text": "电话。我的摄像头甚至都无法正常工作"}]
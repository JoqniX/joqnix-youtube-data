[{"type": "subtitle", "time": 12182.389, "timestamp": "03:23:02", "text": "浪费我的小行星。你知道吗？我们开始吧"}, {"type": "subtitle", "time": 12185.19, "timestamp": "03:23:05", "text": "保持原样。好的。"}, {"type": "subtitle", "time": 12187.51, "timestamp": "03:23:07", "text": "需要4小时20分钟。我本该"}, {"type": "subtitle", "time": 12191.03, "timestamp": "03:23:11", "text": "本来想早点结束这段话，但我现在还在这里。"}, {"type": "subtitle", "time": 12194.67, "timestamp": "03:23:14", "text": "一些尴尬而怪异"}, {"type": "subtitle", "time": 12196.86, "timestamp": "03:23:16", "text": "原因。是的。"}, {"type": "subtitle", "time": 12204.11, "timestamp": "03:23:24", "text": "嗯，我们到此为止。我"}, {"type": "subtitle", "time": 12212.309, "timestamp": "03:23:32", "text": "向上，对吧？"}, {"type": "subtitle", "time": 12221.75, "timestamp": "03:23:41", "text": "Jama 六个早晨鸡蛋是六个。她需要"}, {"type": "subtitle", "time": 12222.75, "timestamp": "03:23:42", "text": "六个"}, {"type": "subtitle", "time": 12225.67, "timestamp": "03:23:45", "text": "他们。是的。但这些材料就像"}, {"type": "subtitle", "time": 12229.11, "timestamp": "03:23:49", "text": "某种疼痛。她呢？哦，我可以"}, {"type": "subtitle", "time": 12232.83, "timestamp": "03:23:52", "text": "字面意思就像"}, {"type": "subtitle", "time": 12235.75, "timestamp": "03:23:55", "text": "哇。此时此刻，我只想说，我只想"}, {"type": "subtitle", "time": 12238.349, "timestamp": "03:23:58", "text": "只想去"}]
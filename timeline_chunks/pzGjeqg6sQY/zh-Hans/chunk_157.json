[{"type": "subtitle", "time": 9420.309, "timestamp": "02:37:00", "text": "[音乐]"}, {"type": "subtitle", "time": 9421.15, "timestamp": "02:37:01", "text": "感谢"}, {"type": "subtitle", "time": 9427.309, "timestamp": "02:37:07", "text": "上帝。胸口，胸口，胸口，胸口，胸口"}, {"type": "subtitle", "time": 9430.51, "timestamp": "02:37:10", "text": "胸部。哦，我的"}, {"type": "subtitle", "time": 9435.07, "timestamp": "02:37:15", "text": "上帝。好的。呃，74。"}, {"type": "subtitle", "time": 9438.27, "timestamp": "02:37:18", "text": "好的。是之前吗？"}, {"type": "subtitle", "time": 9443.15, "timestamp": "02:37:23", "text": "74？是吗？是74吗？"}, {"type": "subtitle", "time": 9446.15, "timestamp": "02:37:26", "text": "前？它没有增加。它没有"}, {"type": "subtitle", "time": 9448.07, "timestamp": "02:37:28", "text": "增加。"}, {"type": "subtitle", "time": 9450.309, "timestamp": "02:37:30", "text": "我希望你烧伤了，或者没有。不，"}, {"type": "subtitle", "time": 9452.19, "timestamp": "02:37:32", "text": "是，是嗯"}, {"type": "subtitle", "time": 9462.11, "timestamp": "02:37:42", "text": "去。嗯，我打算一次性完成。"}, {"type": "subtitle", "time": 9465.27, "timestamp": "02:37:45", "text": "走吧，因为我马上就要30岁了，因为我……"}, {"type": "subtitle", "time": 9475.99, "timestamp": "02:37:55", "text": "少量。你以前来过这里吗？"}, {"type": "subtitle", "time": 9478.309, "timestamp": "02:37:58", "text": "是的，那是我七岁的时候，在我"}]
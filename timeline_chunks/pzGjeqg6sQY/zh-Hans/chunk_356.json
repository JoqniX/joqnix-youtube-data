[{"type": "subtitle", "time": 21360.07, "timestamp": "05:56:00", "text": "它的终点在哪里，只有我们自己才能定义。"}, {"type": "subtitle", "time": 21362.47, "timestamp": "05:56:02", "text": "它的起始位置和持续时间是"}, {"type": "subtitle", "time": 21364.47, "timestamp": "05:56:04", "text": "去弄清楚它什么时候结束，不是"}, {"type": "subtitle", "time": 21367.99, "timestamp": "05:56:07", "text": "它在视口中的位置。后退"}, {"type": "subtitle", "time": 21370.868, "timestamp": "05:56:10", "text": "预览中。现在我们可以看到我们的两个"}, {"type": "subtitle", "time": 21373.11, "timestamp": "05:56:13", "text": "第二段动画正在播放。我们"}, {"type": "subtitle", "time": 21375.43, "timestamp": "05:56:15", "text": "如果……那就再加点，等等，所以不是……"}, {"type": "subtitle", "time": 21376.948, "timestamp": "05:56:16", "text": "与卷轴相连。那是"}, {"type": "subtitle", "time": 21379.19, "timestamp": "05:56:19", "text": "可能的。呃，我希望它淡入。"}, {"type": "subtitle", "time": 21381.51, "timestamp": "05:56:21", "text": "我将把不透明度设置为零。现在我们"}, {"type": "subtitle", "time": 21383.83, "timestamp": "05:56:23", "text": "可以看到它逐渐显现。100像素是"}, {"type": "subtitle", "time": 21385.83, "timestamp": "05:56:25", "text": "有点傻。我们就定为10吧"}, {"type": "subtitle", "time": 21388.23, "timestamp": "05:56:28", "text": "用像素点来增加微妙感。和"}, {"type": "subtitle", "time": 21390.39, "timestamp": "05:56:30", "text": "将持续时间改为"}, {"type": "subtitle", "time": 21391.91, "timestamp": "05:56:31", "text": "看起来会更好，比如500"}, {"type": "subtitle", "time": 21395.27, "timestamp": "05:56:35", "text": "毫秒。现在它要开始播放动画了。"}, {"type": "subtitle", "time": 21397.91, "timestamp": "05:56:37", "text": "通过淡入淡出和翻译的方式进入。所以"}, {"type": "subtitle", "time": 21399.75, "timestamp": "05:56:39", "text": "你可以在第一个阶段使用持续时间。"}, {"type": "subtitle", "time": 21401.91, "timestamp": "05:56:41", "text": "英雄部分或网站上的任何其他地方"}, {"type": "subtitle", "time": 21403.83, "timestamp": "05:56:43", "text": "地点。它的工作原理是启动"}, {"type": "subtitle", "time": 21405.83, "timestamp": "05:56:45", "text": "根据定义制作动画"}, {"type": "subtitle", "time": 21408.47, "timestamp": "05:56:48", "text": "根据范围的起始和结束位置进行划分。"}, {"type": "subtitle", "time": 21411.75, "timestamp": "05:56:51", "text": "期间。所以这个位置比较低，哦，我"}, {"type": "subtitle", "time": 21415.31, "timestamp": "05:56:55", "text": "我觉得我理解了我的大脑理解"}]
[{"type": "subtitle", "time": 12007.95, "timestamp": "03:20:07", "text": "我的天啊。我死了。差点死了。几乎"}, {"type": "subtitle", "time": 12010.469, "timestamp": "03:20:10", "text": "死了。我的天啊。真是不可思议"}, {"type": "subtitle", "time": 12019.03, "timestamp": "03:20:19", "text": "我必须在这个级别生存下去。它是"}, {"type": "subtitle", "time": 12022.309, "timestamp": "03:20:22", "text": "世界第四阶段的所有阶段。"}]
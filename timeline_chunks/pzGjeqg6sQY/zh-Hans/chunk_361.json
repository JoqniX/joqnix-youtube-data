[{"type": "subtitle", "time": 21663.03, "timestamp": "06:01:03", "text": "混合。我到底该怎么模糊处理？"}, {"type": "subtitle", "time": 21679.47, "timestamp": "06:01:19", "text": "背景虚化模式。"}, {"type": "subtitle", "time": 21686.83, "timestamp": "06:01:26", "text": "他们怎么会有"}, {"type": "subtitle", "time": 21691.03, "timestamp": "06:01:31", "text": "它？它会向左滑动。从左至右"}, {"type": "subtitle", "time": 21709.19, "timestamp": "06:01:49", "text": "[音乐]"}, {"type": "subtitle", "time": 21711.99, "timestamp": "06:01:51", "text": "我不希望它在这里。如果我这样做呢？"}, {"type": "subtitle", "time": 21718.548, "timestamp": "06:01:58", "text": "这里？真是跌宕起伏。我该怎么做？"}]
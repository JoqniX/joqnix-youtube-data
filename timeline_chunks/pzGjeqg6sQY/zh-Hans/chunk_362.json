[{"type": "subtitle", "time": 21723.83, "timestamp": "06:02:03", "text": "我该让它反过来吗？"}, {"type": "subtitle", "time": 21726.01, "timestamp": "06:02:06", "text": "我该如何反方向操作呢？"}, {"type": "subtitle", "time": 21735.11, "timestamp": "06:02:15", "text": "大约？哦，负五。哦，否定"}, {"type": "subtitle", "time": 21738.11, "timestamp": "06:02:18", "text": "积极的。哦，那是一个"}, {"type": "subtitle", "time": 21741.99, "timestamp": "06:02:21", "text": "事物。消极的。嗯，好的，我们快到了"}, {"type": "subtitle", "time": 21752.07, "timestamp": "06:02:32", "text": "在。它甚至还有技能功能。"}, {"type": "subtitle", "time": 21754.51, "timestamp": "06:02:34", "text": "我们不需要"}, {"type": "subtitle", "time": 21763.23, "timestamp": "06:02:43", "text": "特征。嗯，我们可以把它做到 50 毫秒。"}, {"type": "subtitle", "time": 21765.47, "timestamp": "06:02:45", "text": "不，"}, {"type": "subtitle", "time": 21771.07, "timestamp": "06:02:51", "text": "多发性硬化症。不，可能是 300 毫秒。 300种造型"}, {"type": "subtitle", "time": 21774.83, "timestamp": "06:02:54", "text": "好的。缓解我们可以改变"}]
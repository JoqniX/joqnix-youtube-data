[{"type": "subtitle", "time": 23163.27, "timestamp": "06:26:03", "text": "或许。正确的。所以如果我们使用那个"}, {"type": "subtitle", "time": 23164.91, "timestamp": "06:26:04", "text": "其他"}, {"type": "subtitle", "time": 23166.83, "timestamp": "06:26:06", "text": "图片"}, {"type": "subtitle", "time": 23169.31, "timestamp": "06:26:09", "text": "这是什么？"}, {"type": "subtitle", "time": 23171.948, "timestamp": "06:26:11", "text": "一个，我们把它放进去了。"}, {"type": "subtitle", "time": 23193.948, "timestamp": "06:26:33", "text": "恐惧。我要把这些删除。"}, {"type": "subtitle", "time": 23197.23, "timestamp": "06:26:37", "text": "出色地。它说要填满"}, {"type": "subtitle", "time": 23202.27, "timestamp": "06:26:42", "text": "受到影响，我可能不得不这样说："}, {"type": "subtitle", "time": 23205.628, "timestamp": "06:26:45", "text": "可能包含。"}, {"type": "subtitle", "time": 23209.03, "timestamp": "06:26:49", "text": "不可以。我可以改变物体的位置吗？"}, {"type": "subtitle", "time": 23211.07, "timestamp": "06:26:51", "text": "不，我不能。"}, {"type": "subtitle", "time": 23213.0, "timestamp": "06:26:53", "text": "好的。"}, {"type": "subtitle", "time": 23219.75, "timestamp": "06:26:59", "text": "嗯，这件事我能控制。我可以放"}]
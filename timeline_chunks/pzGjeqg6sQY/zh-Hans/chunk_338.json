[{"type": "subtitle", "time": 20281.75, "timestamp": "05:38:01", "text": "它们有这些设置。关键框架"}, {"type": "subtitle", "time": 20284.548, "timestamp": "05:38:04", "text": "这边。填充模式是反向的。"}, {"type": "subtitle", "time": 20287.19, "timestamp": "05:38:07", "text": "缓动设置已启用。范围。他们"}, {"type": "subtitle", "time": 20290.11, "timestamp": "05:38:10", "text": "有几个范围"}, {"type": "subtitle", "time": 20293.91, "timestamp": "05:38:13", "text": "这里。嗯，你可以自定义范围。"}, {"type": "subtitle", "time": 20299.07, "timestamp": "05:38:19", "text": "出色地。入口和呃入口以及"}, {"type": "subtitle", "time": 20302.788, "timestamp": "05:38:22", "text": "出口。好多定制的东西。他们有一个"}, {"type": "subtitle", "time": 20305.11, "timestamp": "05:38:25", "text": "关键帧也是个问题。我的天哪，他们"}, {"type": "subtitle", "time": 20307.15, "timestamp": "05:38:27", "text": "有一些关键帧之类的东西"}, {"type": "subtitle", "time": 20309.47, "timestamp": "05:38:29", "text": "出色地。疯狂的。"}, {"type": "subtitle", "time": 20313.628, "timestamp": "05:38:33", "text": "现在您可以添加任何 CSS 属性。"}, {"type": "subtitle", "time": 20317.39, "timestamp": "05:38:37", "text": "这里。而且你还可以继续添加"}, {"type": "subtitle", "time": 20325.11, "timestamp": "05:38:45", "text": "您可以创建新的动画"}, {"type": "subtitle", "time": 20326.43, "timestamp": "05:38:46", "text": "完全"}, {"type": "subtitle", "time": 20328.99, "timestamp": "05:38:48", "text": "也可以在各处使用。"}, {"type": "subtitle", "time": 20331.708, "timestamp": "05:38:51", "text": "一切都是"}, {"type": "chat", "time": 20336.456, "timestamp": "05:38:56", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "Hiiieeee JOQ!UCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2AkUCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2Ak"}]
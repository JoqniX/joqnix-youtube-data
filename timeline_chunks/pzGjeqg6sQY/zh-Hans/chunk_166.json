[{"type": "subtitle", "time": 9960.07, "timestamp": "02:46:00", "text": "学校引擎展示并设定她的高度"}, {"type": "subtitle", "time": 9961.349, "timestamp": "02:46:01", "text": "在为该部工作"}, {"type": "subtitle", "time": 9964.15, "timestamp": "02:46:04", "text": "发展。她一路走来，成就斐然。"}, {"type": "subtitle", "time": 9965.91, "timestamp": "02:46:05", "text": "我忍不住感到自豪和……"}, {"type": "subtitle", "time": 9968.23, "timestamp": "02:46:08", "text": "羡慕。与此同时，我还在琢磨……"}, {"type": "subtitle", "time": 9970.95, "timestamp": "02:46:10", "text": "走出自己的职业道路。水烟谈话"}, {"type": "subtitle", "time": 9972.79, "timestamp": "02:46:12", "text": "关于她，然后尽力做到最好"}, {"type": "subtitle", "time": 9975.83, "timestamp": "02:46:15", "text": "今天又来了。我知道她会通过的。"}, {"type": "subtitle", "time": 9977.67, "timestamp": "02:46:17", "text": "扮演卡洛斯。她一直都是"}, {"type": "subtitle", "time": 9979.99, "timestamp": "02:46:19", "text": "敬业，甚至连休息时间都不休息。"}, {"type": "subtitle", "time": 9982.87, "timestamp": "02:46:22", "text": "假期里和我一起玩。我"}, {"type": "subtitle", "time": 9985.429, "timestamp": "02:46:25", "text": "我简直不敢相信她这么幸运，但我"}, {"type": "subtitle", "time": 9987.23, "timestamp": "02:46:27", "text": "我简直太高兴了！"}, {"type": "subtitle", "time": 9988.75, "timestamp": "02:46:28", "text": "她。"}, {"type": "subtitle", "time": 9990.83, "timestamp": "02:46:30", "text": "好的"}, {"type": "subtitle", "time": 9994.87, "timestamp": "02:46:34", "text": "信。她什么都没告诉我。"}, {"type": "subtitle", "time": 9997.83, "timestamp": "02:46:37", "text": "亲自前往。这是什么？我做了这个"}, {"type": "subtitle", "time": 10000.269, "timestamp": "02:46:40", "text": "童年时期的模特，作为我的见证人"}, {"type": "subtitle", "time": 10004.59, "timestamp": "02:46:44", "text": "目标。最好的学校在节目中听起来"}, {"type": "subtitle", "time": 10007.349, "timestamp": "02:46:47", "text": "感人的。那就是我想要的那所老学校"}, {"type": "subtitle", "time": 10010.15, "timestamp": "02:46:50", "text": "让孩子们无人照看。我只得到了"}, {"type": "subtitle", "time": 10012.75, "timestamp": "02:46:52", "text": "靠运气被录取。你为什么这么说"}, {"type": "subtitle", "time": 10015.51, "timestamp": "02:46:55", "text": "所以？去年发生过类似的事情，需要考虑一下。"}, {"type": "subtitle", "time": 10018.67, "timestamp": "02:46:58", "text": "我老师讲的关键点"}]
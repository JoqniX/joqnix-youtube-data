[{"type": "subtitle", "time": 10682.95, "timestamp": "02:58:02", "text": "呃，就像……呃，该怎么说呢？像蜗牛一样"}, {"type": "subtitle", "time": 10684.429, "timestamp": "02:58:04", "text": "然后就走"}, {"type": "subtitle", "time": 10687.83, "timestamp": "02:58:07", "text": "趴在桌子底下，像个懒汉"}, {"type": "subtitle", "time": 10698.03, "timestamp": "02:58:18", "text": "是的。哦"}, {"type": "subtitle", "time": 10701.23, "timestamp": "02:58:21", "text": "[音乐]"}, {"type": "subtitle", "time": 10709.03, "timestamp": "02:58:29", "text": "分钟。你好。顺便说一句，她做了一个高个子"}, {"type": "subtitle", "time": 10711.269, "timestamp": "02:58:31", "text": "攀登这座山后做出的决定"}, {"type": "subtitle", "time": 10714.55, "timestamp": "02:58:34", "text": "她正在向西攀登，而且"}, {"type": "subtitle", "time": 10716.63, "timestamp": "02:58:36", "text": "就在那时，她决定成为"}, {"type": "subtitle", "time": 10719.87, "timestamp": "02:58:39", "text": "一名士兵，在前线战斗"}, {"type": "subtitle", "time": 10722.95, "timestamp": "02:58:42", "text": "线条。我现在有点想去参观一下"}, {"type": "subtitle", "time": 10726.269, "timestamp": "02:58:46", "text": "呃，峰会一号她"}, {"type": "subtitle", "time": 10728.95, "timestamp": "02:58:48", "text": "征服，所以我才能到达顶峰"}, {"type": "subtitle", "time": 10735.99, "timestamp": "02:58:55", "text": "下雨天自己带一个。我不想输"}, {"type": "subtitle", "time": 10736.91, "timestamp": "02:58:56", "text": "到"}]
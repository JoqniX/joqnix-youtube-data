[{"type": "subtitle", "time": 2700.309, "timestamp": "00:45:00", "text": "很多。对，就是那个宝箱。我"}, {"type": "subtitle", "time": 2702.67, "timestamp": "00:45:02", "text": "记得服用"}, {"type": "subtitle", "time": 2716.39, "timestamp": "00:45:16", "text": "申请。呃，我没看到，呃，你能……呃……"}, {"type": "subtitle", "time": 2741.91, "timestamp": "00:45:41", "text": "我的天啊。等等，你收到了吗？"}, {"type": "subtitle", "time": 2744.47, "timestamp": "00:45:44", "text": "是不是断线了？您的延迟是"}]
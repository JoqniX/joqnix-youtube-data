[{"type": "subtitle", "time": 12600.79, "timestamp": "03:30:00", "text": "今天就到1点了。"}, {"type": "subtitle", "time": 12603.51, "timestamp": "03:30:03", "text": "快凌晨一点了，我去睡觉。如果我"}, {"type": "subtitle", "time": 12605.429, "timestamp": "03:30:05", "text": "现在别睡，不然我就醒不了了。"}, {"type": "subtitle", "time": 12609.429, "timestamp": "03:30:09", "text": "5点、6点或6点。所以，什么是工作？"}, {"type": "subtitle", "time": 12611.91, "timestamp": "03:30:11", "text": "再见，大家晚安，我会的。"}, {"type": "subtitle", "time": 12613.51, "timestamp": "03:30:13", "text": "明天见。好的，明天"}, {"type": "subtitle", "time": 12625.87, "timestamp": "03:30:25", "text": "[音乐]"}, {"type": "subtitle", "time": 12651.74, "timestamp": "03:30:51", "text": "嘿，"}, {"type": "subtitle", "time": 12657.469, "timestamp": "03:30:57", "text": "[音乐]"}]
[{"type": "subtitle", "time": 12365.11, "timestamp": "03:26:05", "text": "那我就做卡利斯托吧。"}, {"type": "subtitle", "time": 12367.67, "timestamp": "03:26:07", "text": "是的，凯利苏是主要输出手。"}, {"type": "subtitle", "time": 12370.95, "timestamp": "03:26:10", "text": "尽管。无论如何，他都是主角"}, {"type": "subtitle", "time": 12373.63, "timestamp": "03:26:13", "text": "伤害输出者。所以"}, {"type": "subtitle", "time": 12379.63, "timestamp": "03:26:19", "text": "是的，我需要提升她的水平。"}, {"type": "subtitle", "time": 12382.269, "timestamp": "03:26:22", "text": "很快。"}, {"type": "subtitle", "time": 12385.83, "timestamp": "03:26:25", "text": "罗伯斯，老兄，这游戏太肝了。所以"}, {"type": "subtitle", "time": 12404.04, "timestamp": "03:26:44", "text": "好的。"}, {"type": "subtitle", "time": 12406.83, "timestamp": "03:26:46", "text": "[音乐]"}, {"type": "subtitle", "time": 12413.98, "timestamp": "03:26:53", "text": "我"}]
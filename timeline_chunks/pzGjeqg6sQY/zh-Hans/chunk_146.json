[{"type": "subtitle", "time": 8764.59, "timestamp": "02:26:04", "text": "但老板莫斯·莫斯利"}, {"type": "subtitle", "time": 8776.83, "timestamp": "02:26:16", "text": "正确的？对此"}, {"type": "subtitle", "time": 8780.55, "timestamp": "02:26:20", "text": "观点。此时，我想做一个"}, {"type": "subtitle", "time": 8784.23, "timestamp": "02:26:24", "text": "未经同意不得私信他人。"}, {"type": "subtitle", "time": 8816.15, "timestamp": "02:26:56", "text": "卷。好的，采取行动。"}, {"type": "subtitle", "time": 8818.91, "timestamp": "02:26:58", "text": "谈话越来越频繁"}]
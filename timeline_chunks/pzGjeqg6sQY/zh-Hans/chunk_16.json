[{"type": "subtitle", "time": 962.67, "timestamp": "00:16:02", "text": "手表。"}, {"type": "subtitle", "time": 966.47, "timestamp": "00:16:06", "text": "所以，我寸步未挪。"}, {"type": "subtitle", "time": 967.629, "timestamp": "00:16:07", "text": "我的"}, {"type": "subtitle", "time": 970.069, "timestamp": "00:16:10", "text": "椅子。我想触摸鼠标，"}, {"type": "subtitle", "time": 979.87, "timestamp": "00:16:19", "text": "我从镜子里看到了我的胳膊，对吧？"}, {"type": "subtitle", "time": 984.189, "timestamp": "00:16:24", "text": "现在。天哪，我……我变得如此"}, {"type": "subtitle", "time": 987.71, "timestamp": "00:16:27", "text": "薄的。是因为我不吃饭吗？"}, {"type": "subtitle", "time": 990.03, "timestamp": "00:16:30", "text": "适当地？有"}, {"type": "subtitle", "time": 992.189, "timestamp": "00:16:32", "text": "我"}, {"type": "subtitle", "time": 1005.15, "timestamp": "00:16:45", "text": "[音乐]"}, {"type": "subtitle", "time": 1013.389, "timestamp": "00:16:53", "text": "疼痛。我真的不想做这件事。"}]
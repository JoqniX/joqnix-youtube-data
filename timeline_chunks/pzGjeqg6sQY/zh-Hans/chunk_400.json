[{"type": "subtitle", "time": 24004.788, "timestamp": "06:40:04", "text": "秒。镜头拉远。好的。"}, {"type": "subtitle", "time": 24006.948, "timestamp": "06:40:06", "text": "我想知道你是否在做我……"}, {"type": "subtitle", "time": 24050.788, "timestamp": "06:40:50", "text": "呃，这个名字是你的来历吗？最后"}, {"type": "subtitle", "time": 24054.03, "timestamp": "06:40:54", "text": "夜晚啊，艾伦。你好。"}, {"type": "subtitle", "time": 24057.39, "timestamp": "06:40:57", "text": "你好。好的。下午好。不，很好"}]
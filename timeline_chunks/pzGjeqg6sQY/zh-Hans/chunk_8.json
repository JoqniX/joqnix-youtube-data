[{"type": "subtitle", "time": 489.98, "timestamp": "00:08:09", "text": "给"}, {"type": "subtitle", "time": 498.79, "timestamp": "00:08:18", "text": "我收到一个幽灵文件。我的天啊，"}, {"type": "subtitle", "time": 500.909, "timestamp": "00:08:20", "text": "有个鬼魂掉进我的房间里了"}, {"type": "subtitle", "time": 524.99, "timestamp": "00:08:44", "text": "我无法删除你，否则我可以"}, {"type": "subtitle", "time": 527.829, "timestamp": "00:08:47", "text": "不是。是的，我的文件资源管理器现在是"}]
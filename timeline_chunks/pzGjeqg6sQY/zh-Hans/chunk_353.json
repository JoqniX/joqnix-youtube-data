[{"type": "subtitle", "time": 21182.07, "timestamp": "05:53:02", "text": "离开。啊，那真不错。"}, {"type": "subtitle", "time": 21184.43, "timestamp": "05:53:04", "text": "文本在哪里？"}, {"type": "subtitle", "time": 21188.27, "timestamp": "05:53:08", "text": "动画片？他们搬走了吗？"}, {"type": "subtitle", "time": 21191.99, "timestamp": "05:53:11", "text": "那？进入章节模式以进行聚焦"}, {"type": "subtitle", "time": 21194.99, "timestamp": "05:53:14", "text": "更多的。进步"}, {"type": "subtitle", "time": 21198.948, "timestamp": "05:53:18", "text": "模式。批量删除用户。滚动事件。"}, {"type": "subtitle", "time": 21201.868, "timestamp": "05:53:21", "text": "哦，对，就是这个。我看了"}, {"type": "subtitle", "time": 21205.39, "timestamp": "05:53:25", "text": "它。所以如果我"}, {"type": "subtitle", "time": 21208.15, "timestamp": "05:53:28", "text": "没错，如果我没理解错的话，我应该……"}, {"type": "subtitle", "time": 21211.788, "timestamp": "05:53:31", "text": "只需添加动画组即可。把"}, {"type": "subtitle", "time": 21213.47, "timestamp": "05:53:33", "text": "事物"}, {"type": "subtitle", "time": 21222.868, "timestamp": "05:53:42", "text": "标签翻译成什么？所以它会稍微移动一下。"}, {"type": "subtitle", "time": 21233.15, "timestamp": "05:53:53", "text": "[音乐]"}]
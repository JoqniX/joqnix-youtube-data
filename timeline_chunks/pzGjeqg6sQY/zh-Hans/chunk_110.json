[{"type": "subtitle", "time": 6602.629, "timestamp": "01:50:02", "text": "等等，等等，等等，等等。系统锚点"}, {"type": "subtitle", "time": 6604.189, "timestamp": "01:50:04", "text": "创造美好生活"}, {"type": "subtitle", "time": 6606.87, "timestamp": "01:50:06", "text": "气氛。科学总分12分。"}, {"type": "subtitle", "time": 6609.55, "timestamp": "01:50:09", "text": "好的，我有12个。根据处罚规定。"}, {"type": "subtitle", "time": 6611.99, "timestamp": "01:50:11", "text": "条款，锚定生活工作可以是"}, {"type": "subtitle", "time": 6614.35, "timestamp": "01:50:14", "text": "相应的点数减少。"}, {"type": "subtitle", "time": 6617.149, "timestamp": "01:50:17", "text": "好的。呃，如果我"}, {"type": "subtitle", "time": 6619.99, "timestamp": "01:50:19", "text": "引入点为负-3。"}, {"type": "subtitle", "time": 6621.91, "timestamp": "01:50:21", "text": "好的。等待。"}, {"type": "subtitle", "time": 6623.83, "timestamp": "01:50:23", "text": "自然恢复。恢复期是"}, {"type": "subtitle", "time": 6625.83, "timestamp": "01:50:25", "text": "七天。从最后开始，如果"}, {"type": "subtitle", "time": 6628.149, "timestamp": "01:50:28", "text": "内部不存在任何偏差"}, {"type": "subtitle", "time": 6630.07, "timestamp": "01:50:30", "text": "自然七天，三分。"}, {"type": "subtitle", "time": 6633.27, "timestamp": "01:50:33", "text": "自然恢复等等。直到"}, {"type": "subtitle", "time": 6635.669, "timestamp": "01:50:35", "text": "如果全部12分都恢复了，那么就没有了。"}, {"type": "subtitle", "time": 6637.87, "timestamp": "01:50:37", "text": "分数将会追回。为了"}, {"type": "subtitle", "time": 6641.83, "timestamp": "01:50:41", "text": "例如，哦，好的。上诉和追偿。"}, {"type": "subtitle", "time": 6643.51, "timestamp": "01:50:43", "text": "主播可以通过这种方式提出上诉。"}, {"type": "subtitle", "time": 6645.43, "timestamp": "01:50:45", "text": "客户服务渠道。顾客"}, {"type": "subtitle", "time": 6647.59, "timestamp": "01:50:47", "text": "基于审查和恢复检测到的点"}, {"type": "subtitle", "time": 6650.709, "timestamp": "01:50:50", "text": "按实际扣除额计算。好的。普利蒂"}, {"type": "subtitle", "time": 6653.27, "timestamp": "01:50:53", "text": "条款。分区错误实时"}, {"type": "subtitle", "time": 6656.109, "timestamp": "01:50:56", "text": "并非指分区要求。好的。"}, {"type": "subtitle", "time": 6659.27, "timestamp": "01:50:59", "text": "异常受欢迎程度被怀疑"}]
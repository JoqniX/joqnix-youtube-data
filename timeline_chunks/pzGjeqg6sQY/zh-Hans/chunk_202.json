[{"type": "subtitle", "time": 12122.349, "timestamp": "03:22:02", "text": "不，不，那是我最后一个了。"}, {"type": "subtitle", "time": 12129.309, "timestamp": "03:22:09", "text": "那是我最后一次"}, {"type": "subtitle", "time": 12138.83, "timestamp": "03:22:18", "text": "Doio，我想要"}, {"type": "subtitle", "time": 12141.91, "timestamp": "03:22:21", "text": "你觉得值得吗？不，不，不。"}, {"type": "subtitle", "time": 12146.469, "timestamp": "03:22:26", "text": "不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不不"}, {"type": "subtitle", "time": 12152.51, "timestamp": "03:22:32", "text": "星状体。我不应该。我跳过"}, {"type": "subtitle", "time": 12163.15, "timestamp": "03:22:43", "text": "我？你觉得是吗？"}, {"type": "subtitle", "time": 12166.349, "timestamp": "03:22:46", "text": "好的？ 60岁很多了。"}, {"type": "subtitle", "time": 12174.91, "timestamp": "03:22:54", "text": "尽管。或者我可以礼貌地"}, {"type": "subtitle", "time": 12179.11, "timestamp": "03:22:59", "text": "等等。我真的不想"}]
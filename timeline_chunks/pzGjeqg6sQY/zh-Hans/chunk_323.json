[{"type": "subtitle", "time": 19382.43, "timestamp": "05:23:02", "text": "我拥有"}, {"type": "subtitle", "time": 19387.19, "timestamp": "05:23:07", "text": "呃，我其实有10万。"}, {"type": "subtitle", "time": 19390.31, "timestamp": "05:23:10", "text": "呃，每月页面浏览量。如果我拥有这么多"}, {"type": "subtitle", "time": 19393.75, "timestamp": "05:23:13", "text": "为了提高网站访问量，我可能不得不……"}, {"type": "subtitle", "time": 19396.19, "timestamp": "05:23:16", "text": "实际上必须"}, {"type": "subtitle", "time": 19400.31, "timestamp": "05:23:20", "text": "我想应该是付钱。但现在我安全了。我的意思是，我"}, {"type": "subtitle", "time": 19402.55, "timestamp": "05:23:22", "text": "之后也可以在本地托管，所以"}, {"type": "subtitle", "time": 19404.868, "timestamp": "05:23:24", "text": "没关系。大多数功能都是"}, {"type": "subtitle", "time": 19407.51, "timestamp": "05:23:27", "text": "在 cl 上可用，呃，是的，云意味着"}, {"type": "subtitle", "time": 19409.868, "timestamp": "05:23:29", "text": "他们为该网站提供托管服务。"}, {"type": "subtitle", "time": 19413.99, "timestamp": "05:23:33", "text": "我，我可以做，嗯，还有一种方法"}, {"type": "subtitle", "time": 19416.15, "timestamp": "05:23:36", "text": "对我来说"}, {"type": "subtitle", "time": 19422.628, "timestamp": "05:23:42", "text": "出色地。所以，是的，我打算就这么决定。"}, {"type": "subtitle", "time": 19425.91, "timestamp": "05:23:45", "text": "就像这样，有动画效果。所以"}, {"type": "subtitle", "time": 19428.15, "timestamp": "05:23:48", "text": "我们可以做很多事。能搞定"}, {"type": "subtitle", "time": 19430.03, "timestamp": "05:23:50", "text": "同时缓慢地"}, {"type": "subtitle", "time": 19431.708, "timestamp": "05:23:51", "text": "慢慢地。"}, {"type": "subtitle", "time": 19438.43, "timestamp": "05:23:58", "text": "后退。"}]
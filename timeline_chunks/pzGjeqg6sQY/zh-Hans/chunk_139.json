[{"type": "subtitle", "time": 8341.509, "timestamp": "02:19:01", "text": "小心。我得小心点。我得去"}, {"type": "subtitle", "time": 8350.309, "timestamp": "02:19:10", "text": "在这个阶段，这个部位会感到疼痛"}, {"type": "subtitle", "time": 8354.15, "timestamp": "02:19:14", "text": "我担心我的得分会很低"}, {"type": "subtitle", "time": 8357.309, "timestamp": "02:19:17", "text": "现在减少了，情况很糟糕，情况很糟糕"}, {"type": "subtitle", "time": 8360.429, "timestamp": "02:19:20", "text": "这样做不好。"}, {"type": "subtitle", "time": 8364.309, "timestamp": "02:19:24", "text": "所以，我必须表现得得体一些。"}, {"type": "subtitle", "time": 8368.75, "timestamp": "02:19:28", "text": "一周后，我的扣分就会到账。"}, {"type": "subtitle", "time": 8372.79, "timestamp": "02:19:32", "text": "回来后，违规行为就像3个三"}, {"type": "subtitle", "time": 8375.83, "timestamp": "02:19:35", "text": "沙子的价值点。每个账户"}, {"type": "subtitle", "time": 8379.99, "timestamp": "02:19:39", "text": "其标准值为 12。如果你如果那样的话"}, {"type": "subtitle", "time": 8381.95, "timestamp": "02:19:41", "text": "降低，就是"}, {"type": "subtitle", "time": 8385.629, "timestamp": "02:19:45", "text": "疼痛。是的，很多。"}, {"type": "subtitle", "time": 8387.349, "timestamp": "02:19:47", "text": "限制。好的，我会做我的"}, {"type": "subtitle", "time": 8394.309, "timestamp": "02:19:54", "text": "英国。你儿子的社会已经彻底崩溃了。"}, {"type": "subtitle", "time": 8394.9, "timestamp": "02:19:54", "text": "你的，它是"}]
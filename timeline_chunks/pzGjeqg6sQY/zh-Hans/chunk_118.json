[{"type": "subtitle", "time": 7081.189, "timestamp": "01:58:01", "text": "标题：我甚至不敢想"}, {"type": "subtitle", "time": 7083.75, "timestamp": "01:58:03", "text": "关于饮食或睡眠。快点。你"}, {"type": "subtitle", "time": 7085.589, "timestamp": "01:58:05", "text": "不应该像在外面追赶他们那样。"}, {"type": "subtitle", "time": 7088.39, "timestamp": "01:58:08", "text": "你这个年纪。你做什么？你为什么这样做？"}, {"type": "subtitle", "time": 7090.189, "timestamp": "01:58:10", "text": "必须得到"}, {"type": "subtitle", "time": 7092.79, "timestamp": "01:58:12", "text": "一？因为我喜欢的人想要"}, {"type": "subtitle", "time": 7096.91, "timestamp": "01:58:16", "text": "一。你喜欢的人。问号。"}, {"type": "subtitle", "time": 7099.43, "timestamp": "01:58:19", "text": "是的。你知道这对于一个男人来说并不常见。"}, {"type": "subtitle", "time": 7102.629, "timestamp": "01:58:22", "text": "侧耳倾听，想看看爱人。但我爱她。"}, {"type": "subtitle", "time": 7104.87, "timestamp": "01:58:24", "text": "她一直拒绝我。她喜欢"}, {"type": "subtitle", "time": 7107.589, "timestamp": "01:58:27", "text": "令人印象深刻的回声。我的发言到此结束。"}, {"type": "subtitle", "time": 7110.229, "timestamp": "01:58:30", "text": "莎莉，我只有恐怖玩具。圆形的"}, {"type": "subtitle", "time": 7112.35, "timestamp": "01:58:32", "text": "脸型圆圆的。远非如此"}, {"type": "subtitle", "time": 7114.709, "timestamp": "01:58:34", "text": "感人的。如果我能得到一个回声就好了"}, {"type": "subtitle", "time": 7116.39, "timestamp": "01:58:36", "text": "意味着一种标准。或许她会让我这么做。"}, {"type": "subtitle", "time": 7119.51, "timestamp": "01:58:39", "text": "给彼此一个机会。啊，你的沙巴。听起来"}, {"type": "subtitle", "time": 7120.95, "timestamp": "01:58:40", "text": "有点奇怪。你知道，每天你"}, {"type": "subtitle", "time": 7122.99, "timestamp": "01:58:42", "text": "看到一位女士热衷于"}, {"type": "subtitle", "time": 7125.75, "timestamp": "01:58:45", "text": "回声。她似乎是"}, {"type": "subtitle", "time": 7127.83, "timestamp": "01:58:47", "text": "尽管如此，通往她内心的唯一途径"}, {"type": "subtitle", "time": 7132.149, "timestamp": "01:58:52", "text": "展现出惊人的决心去尝试"}, {"type": "subtitle", "time": 7135.03, "timestamp": "01:58:55", "text": "你状态不太好。你真的"}, {"type": "subtitle", "time": 7137.99, "timestamp": "01:58:57", "text": "应该好好休息一下。谁知道呢"}]
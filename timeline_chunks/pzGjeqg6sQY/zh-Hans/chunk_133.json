[{"type": "subtitle", "time": 7980.709, "timestamp": "02:13:00", "text": "H：过来。我正在吃"}, {"type": "subtitle", "time": 7991.31, "timestamp": "02:13:11", "text": "饥饿的。哦，这个小家伙"}, {"type": "subtitle", "time": 7994.39, "timestamp": "02:13:14", "text": "女孩。是的，让我帮你擦干净你的"}, {"type": "subtitle", "time": 8003.03, "timestamp": "02:13:23", "text": "我可以放弃这个说法了，因为它是"}, {"type": "subtitle", "time": 8004.629, "timestamp": "02:13:24", "text": "只是没有这么做的意图。我不能"}, {"type": "subtitle", "time": 8006.56, "timestamp": "02:13:26", "text": "抽出点时间。她必须看起来有点"}, {"type": "subtitle", "time": 8017.27, "timestamp": "02:13:37", "text": "对于 See 来说，只有 Rain Bells 是唯一的"}, {"type": "subtitle", "time": 8020.39, "timestamp": "02:13:40", "text": "一款适合红头发玩家的游戏。好的，"}, {"type": "subtitle", "time": 8023.189, "timestamp": "02:13:43", "text": "他们有一个红头发的NPC。你敢相信吗？"}, {"type": "subtitle", "time": 8031.35, "timestamp": "02:13:51", "text": "正因为如此，我才要玩。"}]
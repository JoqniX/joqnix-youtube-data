[{"type": "subtitle", "time": 4264.229, "timestamp": "01:11:04", "text": "好吧，它不在那里。如何解锁？"}, {"type": "subtitle", "time": 4267.63, "timestamp": "01:11:07", "text": "你去你去"}, {"type": "subtitle", "time": 4271.83, "timestamp": "01:11:11", "text": "这里。去根肖。你去"}, {"type": "subtitle", "time": 4274.229, "timestamp": "01:11:14", "text": "先锋协会。而且你还得……"}, {"type": "subtitle", "time": 4277.51, "timestamp": "01:11:17", "text": "探索等等。提升你的先锋水平"}, {"type": "subtitle", "time": 4281.75, "timestamp": "01:11:21", "text": "比如三级、二级或四级。我猜"}, {"type": "subtitle", "time": 4287.75, "timestamp": "01:11:27", "text": "映射器。你加入了先锋协会"}, {"type": "subtitle", "time": 4306.99, "timestamp": "01:11:46", "text": "所以，迟来的"}]
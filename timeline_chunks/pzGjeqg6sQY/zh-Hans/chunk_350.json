[{"type": "subtitle", "time": 21001.11, "timestamp": "05:50:01", "text": "任何你能收到通知的内容。如果我是"}, {"type": "subtitle", "time": 21002.788, "timestamp": "05:50:02", "text": "在直播中玩新游戏时，我可以"}, {"type": "subtitle", "time": 21005.51, "timestamp": "05:50:05", "text": "请先在网站上发布通知。我可以"}, {"type": "subtitle", "time": 21007.27, "timestamp": "05:50:07", "text": "开发一款手机应用之类的东西。你可以"}, {"type": "subtitle", "time": 21010.31, "timestamp": "05:50:10", "text": "接收类似的推送通知等等。"}, {"type": "subtitle", "time": 21011.868, "timestamp": "05:50:11", "text": "等等。我没有"}, {"type": "subtitle", "time": 21015.75, "timestamp": "05:50:15", "text": "知道。我准备深入探讨这个问题，但是……"}, {"type": "subtitle", "time": 21018.47, "timestamp": "05:50:18", "text": "我需要有人帮我做这件事，因为我"}, {"type": "subtitle", "time": 21024.948, "timestamp": "05:50:24", "text": "编码。我不懂编程，还有很多"}, {"type": "subtitle", "time": 21027.97, "timestamp": "05:50:27", "text": "问题太多了。"}, {"type": "subtitle", "time": 21029.58, "timestamp": "05:50:29", "text": "[笑声]"}, {"type": "subtitle", "time": 21031.51, "timestamp": "05:50:31", "text": "[音乐]"}, {"type": "subtitle", "time": 21034.948, "timestamp": "05:50:34", "text": "没错，正是这个网站让我如此……"}, {"type": "subtitle", "time": 21037.11, "timestamp": "05:50:37", "text": "网站内容和定制内容"}, {"type": "subtitle", "time": 21039.03, "timestamp": "05:50:39", "text": "这一切都是因为我想要"}, {"type": "subtitle", "time": 21041.75, "timestamp": "05:50:41", "text": "该网站将成为全球之家"}, {"type": "subtitle", "time": 21044.27, "timestamp": "05:50:44", "text": "与此相关的一切"}, {"type": "subtitle", "time": 21047.11, "timestamp": "05:50:47", "text": "无论是粉丝艺术作品还是其他东西，我都喜欢。"}, {"type": "subtitle", "time": 21049.03, "timestamp": "05:50:49", "text": "未来。我希望实现这一点："}, {"type": "subtitle", "time": 21051.67, "timestamp": "05:50:51", "text": "人们可以上传他们的粉丝艺术广告"}, {"type": "subtitle", "time": 21054.948, "timestamp": "05:50:54", "text": "网站上的所有内容，或者如果你可以"}, {"type": "subtitle", "time": 21058.47, "timestamp": "05:50:58", "text": "分享你推特或帖子上的链接"}]
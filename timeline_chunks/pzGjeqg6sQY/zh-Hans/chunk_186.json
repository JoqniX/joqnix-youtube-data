[{"type": "subtitle", "time": 11160.19, "timestamp": "03:06:00", "text": "升到30级。"}, {"type": "subtitle", "time": 11166.389, "timestamp": "03:06:06", "text": "嗯，然后呢？哦，我的东西……哦，我"}, {"type": "subtitle", "time": 11169.269, "timestamp": "03:06:09", "text": "想刷新一下。呃，我该怎么办？"}, {"type": "subtitle", "time": 11171.71, "timestamp": "03:06:11", "text": "我该怎么办？我该怎么办？我该怎么办？"}, {"type": "subtitle", "time": 11175.59, "timestamp": "03:06:15", "text": "做？我该怎么办？"}, {"type": "subtitle", "time": 11178.269, "timestamp": "03:06:18", "text": "我想，我想，我想要，哦，"}, {"type": "subtitle", "time": 11181.07, "timestamp": "03:06:21", "text": "不。那些"}, {"type": "subtitle", "time": 11188.79, "timestamp": "03:06:28", "text": "你知道吗？呃，我们可以做老板吗？"}, {"type": "subtitle", "time": 11190.349, "timestamp": "03:06:30", "text": "为密宗而战"}, {"type": "subtitle", "time": 11197.91, "timestamp": "03:06:37", "text": "我们做完这件事就睡觉。呃，我们会"}, {"type": "subtitle", "time": 11201.269, "timestamp": "03:06:41", "text": "睡觉。好的。希望没问题。"}, {"type": "subtitle", "time": 11204.51, "timestamp": "03:06:44", "text": "我真的很想达到水平"}, {"type": "subtitle", "time": 11207.71, "timestamp": "03:06:47", "text": "卡利斯托上山。我是说"}, {"type": "subtitle", "time": 11217.23, "timestamp": "03:06:57", "text": "美好的。"}]
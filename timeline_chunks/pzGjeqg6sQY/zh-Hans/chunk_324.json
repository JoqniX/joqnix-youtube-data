[{"type": "subtitle", "time": 19441.47, "timestamp": "05:24:01", "text": "嗯，比利比利正在工作"}, {"type": "subtitle", "time": 19443.99, "timestamp": "05:24:03", "text": "好的。我正在向 Billy Billy 直播"}, {"type": "subtitle", "time": 19445.59, "timestamp": "05:24:05", "text": "出色地。"}, {"type": "subtitle", "time": 19447.868, "timestamp": "05:24:07", "text": "是啊，他们只看到了这个那个。"}, {"type": "subtitle", "time": 19450.948, "timestamp": "05:24:10", "text": "好吧，我只是为了保险起见才这么做的。"}, {"type": "subtitle", "time": 19452.91, "timestamp": "05:24:12", "text": "现在。我不想"}, {"type": "subtitle", "time": 19455.628, "timestamp": "05:24:15", "text": "视差"}, {"type": "subtitle", "time": 19458.948, "timestamp": "05:24:18", "text": "黏。啊，这很有意思。这"}, {"type": "subtitle", "time": 19461.11, "timestamp": "05:24:21", "text": "有点自相矛盾。是的，我想"}, {"type": "subtitle", "time": 19464.23, "timestamp": "05:24:24", "text": "我将以此作为我的作品和同人作品的创作主题。"}, {"type": "subtitle", "time": 19467.19, "timestamp": "05:24:27", "text": "那种东西。你们觉得怎么样？"}, {"type": "subtitle", "time": 19468.83, "timestamp": "05:24:28", "text": "是吗？"}, {"type": "subtitle", "time": 19471.75, "timestamp": "05:24:31", "text": "好的？我觉得可能不太好。我"}, {"type": "subtitle", "time": 19482.19, "timestamp": "05:24:42", "text": "我确实在这个问题上遇到了困难。"}, {"type": "subtitle", "time": 19484.868, "timestamp": "05:24:44", "text": "我可能在这方面会遇到问题"}, {"type": "subtitle", "time": 19491.51, "timestamp": "05:24:51", "text": "啊，我可能……我可能遇到问题了。"}, {"type": "subtitle", "time": 19494.23, "timestamp": "05:24:54", "text": "说到手机端视图，伙计。是的，我"}, {"type": "subtitle", "time": 19496.19, "timestamp": "05:24:56", "text": "不应该那样做。我不应该这样做"}, {"type": "subtitle", "time": 19498.948, "timestamp": "05:24:58", "text": "那。也许如果我换个配置的话。"}]
[{"type": "subtitle", "time": 1084.31, "timestamp": "00:18:04", "text": "[音乐]"}, {"type": "subtitle", "time": 1086.71, "timestamp": "00:18:06", "text": "唱歌的时候，我仍然感觉自己像在唱歌一样。"}, {"type": "subtitle", "time": 1087.85, "timestamp": "00:18:07", "text": "听起来如此"}, {"type": "subtitle", "time": 1090.75, "timestamp": "00:18:10", "text": "[音乐]"}, {"type": "subtitle", "time": 1092.43, "timestamp": "00:18:12", "text": "可怕。"}, {"type": "subtitle", "time": 1095.75, "timestamp": "00:18:15", "text": "但问题是，当我试图感受的时候"}, {"type": "subtitle", "time": 1098.23, "timestamp": "00:18:18", "text": "当我唱这首歌的时候，我感觉自己就像在做这件事一样。"}, {"type": "subtitle", "time": 1104.15, "timestamp": "00:18:24", "text": "好的。但其他人听到的却很糟糕。"}, {"type": "subtitle", "time": 1106.39, "timestamp": "00:18:26", "text": "我内心感觉自己像是在歌唱"}, {"type": "subtitle", "time": 1108.549, "timestamp": "00:18:28", "text": "出色地。"}, {"type": "subtitle", "time": 1114.87, "timestamp": "00:18:34", "text": "但当我的声音能被听见的时候"}, {"type": "subtitle", "time": 1118.51, "timestamp": "00:18:38", "text": "呃，从我的重新开始"}, {"type": "subtitle", "time": 1121.39, "timestamp": "00:18:41", "text": "呃，来自我的"}, {"type": "subtitle", "time": 1125.47, "timestamp": "00:18:45", "text": "当听到音频时，嘴巴会张开。"}, {"type": "subtitle", "time": 1130.71, "timestamp": "00:18:50", "text": "其他人的声音听起来就像什么声音。"}]
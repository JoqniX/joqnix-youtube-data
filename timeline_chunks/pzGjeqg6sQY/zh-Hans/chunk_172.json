[{"type": "subtitle", "time": 10321.83, "timestamp": "02:52:01", "text": "趁她忙，我有个机会问问她。"}, {"type": "subtitle", "time": 10328.87, "timestamp": "02:52:08", "text": "现在。这些照片是我学校的照片。"}, {"type": "subtitle", "time": 10331.99, "timestamp": "02:52:11", "text": "天。你为什么在获得之后感到不开心"}, {"type": "subtitle", "time": 10334.51, "timestamp": "02:52:14", "text": "进入小鬼"}, {"type": "subtitle", "time": 10336.71, "timestamp": "02:52:16", "text": "学院？因为我突然"}, {"type": "subtitle", "time": 10344.15, "timestamp": "02:52:24", "text": "人们。痛彻心扉。实际上疼痛"}, {"type": "subtitle", "time": 10345.87, "timestamp": "02:52:25", "text": "伪装成"}, {"type": "subtitle", "time": 10349.34, "timestamp": "02:52:29", "text": "运气。我总觉得好像有"}, {"type": "subtitle", "time": 10359.15, "timestamp": "02:52:39", "text": "投降。是的。再见。我打哈欠了"}, {"type": "subtitle", "time": 10362.71, "timestamp": "02:52:42", "text": "很多。这让我感到羞愧和迷茫。做"}, {"type": "subtitle", "time": 10364.07, "timestamp": "02:52:44", "text": "你明白那种感觉吗？就像你一样"}, {"type": "subtitle", "time": 10365.59, "timestamp": "02:52:45", "text": "知道前面有个酒吧。你不能就这么"}, {"type": "subtitle", "time": 10368.51, "timestamp": "02:52:48", "text": "突破它。是的，我感觉"}, {"type": "subtitle", "time": 10370.79, "timestamp": "02:52:50", "text": "你。我当时就是这种感觉，请帮帮我"}, {"type": "subtitle", "time": 10378.389, "timestamp": "02:52:58", "text": "令人敬畏的高度。不要陷入比较的陷阱。"}]
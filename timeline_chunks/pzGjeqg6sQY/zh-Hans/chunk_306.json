[{"type": "subtitle", "time": 18381.75, "timestamp": "05:06:21", "text": "我需要一大块盐。好的，我是"}, {"type": "subtitle", "time": 18384.03, "timestamp": "05:06:24", "text": "后退。我是"}, {"type": "subtitle", "time": 18387.628, "timestamp": "05:06:27", "text": "活。我回来了。而我"}, {"type": "subtitle", "time": 18401.23, "timestamp": "05:06:41", "text": "啊，我是"}, {"type": "subtitle", "time": 18402.99, "timestamp": "05:06:42", "text": "醒。好的"}, {"type": "subtitle", "time": 18405.788, "timestamp": "05:06:45", "text": "早晨。睡着了"}, {"type": "subtitle", "time": 18410.83, "timestamp": "05:06:50", "text": "关门了，这里很热。我刚刚拍了一张"}]
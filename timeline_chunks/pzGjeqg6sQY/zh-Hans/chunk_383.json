[{"type": "subtitle", "time": 22982.51, "timestamp": "06:23:02", "text": "[音乐]"}, {"type": "subtitle", "time": 22985.19, "timestamp": "06:23:05", "text": "嗯，我以前做过这件事。所以，我"}, {"type": "subtitle", "time": 22989.51, "timestamp": "06:23:09", "text": "应该知道该怎么做，对吧？难道我没有"}, {"type": "subtitle", "time": 22993.07, "timestamp": "06:23:13", "text": "尽快测试一下"}, {"type": "subtitle", "time": 23001.708, "timestamp": "06:23:21", "text": "是的，我做了。"}, {"type": "subtitle", "time": 23004.03, "timestamp": "06:23:24", "text": "测试。这些是什么？"}, {"type": "subtitle", "time": 23011.51, "timestamp": "06:23:31", "text": "部分。哦，是的。测试这个呃"}, {"type": "subtitle", "time": 23014.35, "timestamp": "06:23:34", "text": "战斗卷轴"}, {"type": "subtitle", "time": 23017.43, "timestamp": "06:23:37", "text": "影响。哦，对，就是这些。我不能"}, {"type": "subtitle", "time": 23019.628, "timestamp": "06:23:39", "text": "忘记"}, {"type": "subtitle", "time": 23024.03, "timestamp": "06:23:44", "text": "你。为什么？它坏了，对吧？"}, {"type": "subtitle", "time": 23026.27, "timestamp": "06:23:46", "text": "现在。"}, {"type": "subtitle", "time": 23029.628, "timestamp": "06:23:49", "text": "好了，我们继续。"}, {"type": "subtitle", "time": 23032.948, "timestamp": "06:23:52", "text": "动画片。我能做的就是……"}, {"type": "subtitle", "time": 23036.31, "timestamp": "06:23:56", "text": "盒子是这样折叠的，就是这样。"}]
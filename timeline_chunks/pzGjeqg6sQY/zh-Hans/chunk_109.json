[{"type": "subtitle", "time": 6548.47, "timestamp": "01:49:08", "text": "现在。我的天啊。这将产生影响"}, {"type": "subtitle", "time": 6552.35, "timestamp": "01:49:12", "text": "我的SAN评分。"}, {"type": "subtitle", "time": 6556.55, "timestamp": "01:49:16", "text": "我的S值是12。你知道如果我降低"}, {"type": "subtitle", "time": 6559.75, "timestamp": "01:49:19", "text": "如果我再减少任何金额，我的账户就会……"}, {"type": "subtitle", "time": 6575.51, "timestamp": "01:49:35", "text": "为什么？作为生活惯例，如果"}, {"type": "subtitle", "time": 6577.35, "timestamp": "01:49:37", "text": "积分期间有任何违规行为"}, {"type": "subtitle", "time": 6578.95, "timestamp": "01:49:38", "text": "根据特定方向进行指导"}, {"type": "subtitle", "time": 6583.27, "timestamp": "01:49:43", "text": "在这种情况下，您可以查询某个值"}, {"type": "subtitle", "time": 6584.87, "timestamp": "01:49:44", "text": "较上一年有所减少。"}, {"type": "subtitle", "time": 6595.39, "timestamp": "01:49:55", "text": "为什么？为什么"}, {"type": "subtitle", "time": 6599.59, "timestamp": "01:49:59", "text": "我真希望我有第二个显示器。好的。"}]
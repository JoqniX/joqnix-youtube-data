[{"type": "subtitle", "time": 19984.27, "timestamp": "05:33:04", "text": "找出他们做什么"}, {"type": "subtitle", "time": 19987.67, "timestamp": "05:33:07", "text": "呼叫球员重要吗？编号。半径。不。"}, {"type": "subtitle", "time": 19991.51, "timestamp": "05:33:11", "text": "两只公羊。黄金比例。阴影。不。"}, {"type": "subtitle", "time": 19994.548, "timestamp": "05:33:14", "text": "不，不，不，不，不，不，不。我在找"}, {"type": "subtitle", "time": 19997.67, "timestamp": "05:33:17", "text": "因为呃，那个，那个，那个东西"}, {"type": "subtitle", "time": 19999.15, "timestamp": "05:33:19", "text": "事物。"}, {"type": "subtitle", "time": 20001.47, "timestamp": "05:33:21", "text": "嗯"}, {"type": "subtitle", "time": 20011.548, "timestamp": "05:33:31", "text": "但你仍然无法点击它。"}, {"type": "subtitle", "time": 20015.47, "timestamp": "05:33:35", "text": "不。我该如何添加？再多给它一些"}, {"type": "subtitle", "time": 20018.47, "timestamp": "05:33:38", "text": "间距。页脚是固定的。"}, {"type": "subtitle", "time": 20020.47, "timestamp": "05:33:40", "text": "东西。这就是问题所在。"}, {"type": "subtitle", "time": 20025.43, "timestamp": "05:33:45", "text": "如图所示，重叠部分会重叠。"}, {"type": "subtitle", "time": 20039.27, "timestamp": "05:33:59", "text": "嗯，或许我会把它设置成自动模式。然后"}]
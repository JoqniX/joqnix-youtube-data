[{"type": "subtitle", "time": 13087.87, "timestamp": "03:38:07", "text": "所以这是一首简单的歌"}, {"type": "subtitle", "time": 13089.71, "timestamp": "03:38:09", "text": "喜欢"}, {"type": "subtitle", "time": 13100.95, "timestamp": "03:38:20", "text": "所以，今天我不能，我会做……"}, {"type": "subtitle", "time": 13105.03, "timestamp": "03:38:25", "text": "一些常规的事情，嗯，你……呃……"}, {"type": "subtitle", "time": 13107.51, "timestamp": "03:38:27", "text": "你管那些普通的东西叫什么？"}]
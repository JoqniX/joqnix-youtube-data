[{"type": "subtitle", "time": 3132.309, "timestamp": "00:52:12", "text": "出色地。什么？什么都没有。"}, {"type": "subtitle", "time": 3136.829, "timestamp": "00:52:16", "text": "还没做。我把胸部都打完了"}, {"type": "subtitle", "time": 3139.51, "timestamp": "00:52:19", "text": "尽管。这就是我感到困惑的原因。我"}, {"type": "subtitle", "time": 3149.589, "timestamp": "00:52:29", "text": "一切。那个故障"}, {"type": "subtitle", "time": 3152.309, "timestamp": "00:52:32", "text": "别处。我想那是唯一一个宝箱了。"}, {"type": "subtitle", "time": 3155.39, "timestamp": "00:52:35", "text": "我有。可能，也可能不"}, {"type": "subtitle", "time": 3162.17, "timestamp": "00:52:42", "text": "完毕。不过我也不确定。"}, {"type": "subtitle", "time": 3172.069, "timestamp": "00:52:52", "text": "是的。枪击指控。一切都是"}, {"type": "subtitle", "time": 3176.03, "timestamp": "00:52:56", "text": "完毕。是的。是的。是的。是的。是的。那些是"}, {"type": "subtitle", "time": 3179.75, "timestamp": "00:52:59", "text": "完毕。这就是它现在没有显示的原因。"}]
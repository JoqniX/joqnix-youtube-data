[{"type": "subtitle", "time": 25080.788, "timestamp": "06:58:00", "text": "她坐在我的腿上。我"}, {"type": "subtitle", "time": 25082.31, "timestamp": "06:58:02", "text": "不知道为什么。我的笔记本电脑就像"}, {"type": "subtitle", "time": 25084.948, "timestamp": "06:58:04", "text": "离我很远。因为她"}, {"type": "subtitle", "time": 25088.07, "timestamp": "06:58:08", "text": "放在我腿上。我不知道该怎么办。"}, {"type": "subtitle", "time": 25089.99, "timestamp": "06:58:09", "text": "好的。好的。好的。谁来创造"}, {"type": "subtitle", "time": 25091.27, "timestamp": "06:58:11", "text": "大厅？你打算创建……"}, {"type": "subtitle", "time": 25093.59, "timestamp": "06:58:13", "text": "不？嗯，是的，我乐意创建"}, {"type": "subtitle", "time": 25096.468, "timestamp": "06:58:16", "text": "大厅。嗯——还有，大家不要"}, {"type": "subtitle", "time": 25099.59, "timestamp": "06:58:19", "text": "忘了，呃，你可以两个都看。"}, {"type": "subtitle", "time": 25102.31, "timestamp": "06:58:22", "text": "从我们的角度来看，多表链接"}, {"type": "subtitle", "time": 25104.948, "timestamp": "06:58:24", "text": "下面。你把链接放在哪里了？"}, {"type": "subtitle", "time": 25108.07, "timestamp": "06:58:28", "text": "出色地？不，我没有。我刚刚把你的"}, {"type": "subtitle", "time": 25110.468, "timestamp": "06:58:30", "text": "直播链接在我的个人简介里。"}, {"type": "subtitle", "time": 25114.39, "timestamp": "06:58:34", "text": "是的，那样也行。这样可行。"}, {"type": "subtitle", "time": 25117.03, "timestamp": "06:58:37", "text": "是的。如果你想看他的PO视角"}, {"type": "subtitle", "time": 25120.788, "timestamp": "06:58:40", "text": "puff POV，然后你可以查看 Turan。"}, {"type": "subtitle", "time": 25123.75, "timestamp": "06:58:43", "text": "您可以查看描述。那是他的"}, {"type": "subtitle", "time": 25126.548, "timestamp": "06:58:46", "text": "里面有第一人称视角。是的，图兰。是的，我们得到了"}, {"type": "subtitle", "time": 25130.628, "timestamp": "06:58:50", "text": "它。你喜欢 Jok 前辈。我们明白了。哦，"}, {"type": "subtitle", "time": 25133.27, "timestamp": "06:58:53", "text": "我们明白了。"}, {"type": "subtitle", "time": 25135.19, "timestamp": "06:58:55", "text": "夏威夷。"}, {"type": "subtitle", "time": 25138.628, "timestamp": "06:58:58", "text": "是的。好的。等等，我该如何更改这个？"}]
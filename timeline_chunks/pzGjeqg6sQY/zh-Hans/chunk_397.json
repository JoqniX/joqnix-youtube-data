[{"type": "subtitle", "time": 23836.708, "timestamp": "06:37:16", "text": "它。不，它正在下降，不是吗？它是"}, {"type": "subtitle", "time": 23839.03, "timestamp": "06:37:19", "text": "向下。这不是我想要的。那"}, {"type": "subtitle", "time": 23841.27, "timestamp": "06:37:21", "text": "这不是我想要的。哦，不。那不是"}, {"type": "subtitle", "time": 23842.948, "timestamp": "06:37:22", "text": "我想要的。"}, {"type": "subtitle", "time": 23844.788, "timestamp": "06:37:24", "text": "它为什么会这样？哦，是的"}, {"type": "subtitle", "time": 23847.43, "timestamp": "06:37:27", "text": "转负。所以，它将要"}, {"type": "subtitle", "time": 23848.75, "timestamp": "06:37:28", "text": "翻动"}, {"type": "subtitle", "time": 23852.708, "timestamp": "06:37:32", "text": "后退。是的，它正在反转。我知道"}, {"type": "subtitle", "time": 23854.948, "timestamp": "06:37:34", "text": "它翻转了。不。我该怎么做？"}, {"type": "subtitle", "time": 23878.91, "timestamp": "06:37:58", "text": "仍然适用"}]
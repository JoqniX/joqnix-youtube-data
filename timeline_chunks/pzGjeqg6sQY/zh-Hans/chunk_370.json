[{"type": "subtitle", "time": 22201.83, "timestamp": "06:10:01", "text": "我也可以重现他们创造的东西，这样我就可以……"}, {"type": "subtitle", "time": 22204.788, "timestamp": "06:10:04", "text": "获取灵感，然后学习和自学。"}, {"type": "subtitle", "time": 22206.788, "timestamp": "06:10:06", "text": "啊，原来是这样。这就是方法"}, {"type": "subtitle", "time": 22208.788, "timestamp": "06:10:08", "text": "你别这么做。你应该这样做"}, {"type": "subtitle", "time": 22211.23, "timestamp": "06:10:11", "text": "它喜欢"}, {"type": "subtitle", "time": 22214.07, "timestamp": "06:10:14", "text": "那。这个悬浮装置真酷。有"}, {"type": "subtitle", "time": 22215.868, "timestamp": "06:10:15", "text": "一条蓝线"}, {"type": "subtitle", "time": 22220.27, "timestamp": "06:10:20", "text": "经过。哦，这就像……"}, {"type": "subtitle", "time": 22224.788, "timestamp": "06:10:24", "text": "嗯，背面哦，当悬停在背景上时"}, {"type": "subtitle", "time": 22228.31, "timestamp": "06:10:28", "text": "颜色发生变化，这里的图像变得"}, {"type": "subtitle", "time": 22231.628, "timestamp": "06:10:31", "text": "放大倍率"}, {"type": "subtitle", "time": 22233.39, "timestamp": "06:10:33", "text": "影响。"}, {"type": "subtitle", "time": 22236.23, "timestamp": "06:10:36", "text": "啊，我想他们有一个"}, {"type": "subtitle", "time": 22239.59, "timestamp": "06:10:39", "text": "缓解装置。所以当你离开的时候"}, {"type": "subtitle", "time": 22243.03, "timestamp": "06:10:43", "text": "把它拿走，它不像出现和"}, {"type": "subtitle", "time": 22245.75, "timestamp": "06:10:45", "text": "出现和不出现的效果。更甚"}, {"type": "subtitle", "time": 22247.868, "timestamp": "06:10:47", "text": "像滑动一样"}, {"type": "subtitle", "time": 22252.07, "timestamp": "06:10:52", "text": "影响。我觉得就像是“是啊，那个”"}, {"type": "subtitle", "time": 22256.43, "timestamp": "06:10:56", "text": "太酷了，兄弟。我尝试这样做"}, {"type": "subtitle", "time": 22259.88, "timestamp": "06:10:59", "text": "那。拿出证据来。"}]
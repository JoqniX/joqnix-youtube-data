[{"type": "subtitle", "time": 25260.27, "timestamp": "07:01:00", "text": "是"}, {"type": "subtitle", "time": 25262.708, "timestamp": "07:01:02", "text": "你好。我该说什么？我"}, {"type": "subtitle", "time": 25270.948, "timestamp": "07:01:10", "text": "你好。是的。你好。我是乔。下一个。你好。"}, {"type": "subtitle", "time": 25273.19, "timestamp": "07:01:13", "text": "你好，Joknix。"}, {"type": "subtitle", "time": 25276.868, "timestamp": "07:01:16", "text": "是的。这是什么？这是什么？是什么"}, {"type": "subtitle", "time": 25280.31, "timestamp": "07:01:20", "text": "在我的屏幕上？等等，是你吗？是吗？"}, {"type": "subtitle", "time": 25282.708, "timestamp": "07:01:22", "text": "你？哦，是的。是你。是我"}, {"type": "subtitle", "time": 25285.51, "timestamp": "07:01:25", "text": "我的屏幕上显示的是什么？等等，等等。"}, {"type": "subtitle", "time": 25288.788, "timestamp": "07:01:28", "text": "我加入了你们的游说团体。哦，不错。好的。"}, {"type": "subtitle", "time": 25291.83, "timestamp": "07:01:31", "text": "嗯。我的天哪。我不知道这个游戏是怎么玩的。"}, {"type": "subtitle", "time": 25293.51, "timestamp": "07:01:33", "text": "确实可行。难度应该是"}, {"type": "subtitle", "time": 25295.27, "timestamp": "07:01:35", "text": "业余。哦，原来是这样。哦，你是……"}, {"type": "subtitle", "time": 25298.39, "timestamp": "07:01:38", "text": "老太太。你老了，我的天哪。"}, {"type": "subtitle", "time": 25302.07, "timestamp": "07:01:42", "text": "你已经全部参与了。等等，我参与了。我可以改变"}, {"type": "subtitle", "time": 25305.83, "timestamp": "07:01:45", "text": "尽管。哦，是的。你可以。我在你里面"}, {"type": "subtitle", "time": 25309.51, "timestamp": "07:01:49", "text": "房间。是的，你就在我的房间里。"}, {"type": "subtitle", "time": 25311.548, "timestamp": "07:01:51", "text": "你好。"}, {"type": "subtitle", "time": 25315.27, "timestamp": "07:01:55", "text": "尚未准备好。尚未准备好。我该如何准备？"}, {"type": "subtitle", "time": 25317.67, "timestamp": "07:01:57", "text": "无法准备就绪。哦，你得做好准备"}]
[{"type": "subtitle", "time": 19030.27, "timestamp": "05:17:10", "text": "这是"}, {"type": "subtitle", "time": 19040.19, "timestamp": "05:17:20", "text": "冲床。这有点像自行车。"}, {"type": "subtitle", "time": 19044.07, "timestamp": "05:17:24", "text": "类似边疆那种感觉。就像那一刻"}, {"type": "subtitle", "time": 19046.31, "timestamp": "05:17:26", "text": "你看到一个人，你就身处他的生活中"}, {"type": "chat", "time": 19047.188, "timestamp": "05:17:27", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "but then again, it kinda reminds me of cycle: frontier"}, {"type": "subtitle", "time": 19049.11, "timestamp": "05:17:29", "text": "死亡情况。你可能会赢，也可能会输"}, {"type": "subtitle", "time": 19050.91, "timestamp": "05:17:30", "text": "可能会死，可能会输"}, {"type": "subtitle", "time": 19053.75, "timestamp": "05:17:33", "text": "一切。那个码头 waku waku"}, {"type": "chat", "time": 19054.43, "timestamp": "05:17:34", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "but we know how they ended up"}, {"type": "subtitle", "time": 19055.84, "timestamp": "05:17:35", "text": "感觉，"}, {"type": "subtitle", "time": 19066.31, "timestamp": "05:17:46", "text": "但你知道他们的结局是什么。是的，我"}, {"type": "subtitle", "time": 19069.59, "timestamp": "05:17:49", "text": "真的很想玩，我真的很想"}, {"type": "subtitle", "time": 19072.47, "timestamp": "05:17:52", "text": "玩“哦，那是我”。我真的很想"}, {"type": "subtitle", "time": 19076.708, "timestamp": "05:17:56", "text": "去玩塔罗夫，伙计。我需要一台性能好的电脑。"}, {"type": "subtitle", "time": 19078.59, "timestamp": "05:17:58", "text": "一副好耳机以及其他所有东西"}]
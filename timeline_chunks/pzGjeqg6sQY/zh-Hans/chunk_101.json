[{"type": "subtitle", "time": 6071.91, "timestamp": "01:41:11", "text": "所以，但最后没有机会了，什么？"}, {"type": "subtitle", "time": 6078.31, "timestamp": "01:41:18", "text": "平均提前供应通道我得到了这个回声"}, {"type": "subtitle", "time": 6082.59, "timestamp": "01:41:22", "text": "是的，我忽略这件事，我已经做了。"}, {"type": "subtitle", "time": 6086.03, "timestamp": "01:41:26", "text": "标准的补给巡逻"}, {"type": "subtitle", "time": 6089.35, "timestamp": "01:41:29", "text": "我在 Gentu 指南中读到的读者"}, {"type": "subtitle", "time": 6107.43, "timestamp": "01:41:47", "text": "流淌的流淌？嗯，我想我确实这么做了。"}, {"type": "subtitle", "time": 6109.229, "timestamp": "01:41:49", "text": "那"}, {"type": "subtitle", "time": 6117.149, "timestamp": "01:41:57", "text": "[音乐]"}, {"type": "subtitle", "time": 6118.669, "timestamp": "01:41:58", "text": "H."}]
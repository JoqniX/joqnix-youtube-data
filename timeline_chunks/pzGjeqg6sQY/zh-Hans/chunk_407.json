[{"type": "subtitle", "time": 24422.27, "timestamp": "06:47:02", "text": "想说雅虎儿子。雅虎。"}, {"type": "subtitle", "time": 24426.31, "timestamp": "06:47:06", "text": "雅虎。铃声响起。雅虎。雅虎。怎么样？"}, {"type": "subtitle", "time": 24428.43, "timestamp": "06:47:08", "text": "每个人"}, {"type": "subtitle", "time": 24430.948, "timestamp": "06:47:10", "text": "正在做？所以，"}, {"type": "subtitle", "time": 24432.35, "timestamp": "06:47:12", "text": "呃，醒了"}, {"type": "subtitle", "time": 24435.75, "timestamp": "06:47:15", "text": "晚的。加"}, {"type": "subtitle", "time": 24439.628, "timestamp": "06:47:19", "text": "呃呃，就像我本来应该直播的……"}, {"type": "subtitle", "time": 24443.468, "timestamp": "06:47:23", "text": "4，但是但是"}, {"type": "subtitle", "time": 24446.67, "timestamp": "06:47:26", "text": "像但是像"}, {"type": "subtitle", "time": 24451.43, "timestamp": "06:47:31", "text": "我睡着了，呃，之前……"}, {"type": "subtitle", "time": 24453.91, "timestamp": "06:47:33", "text": "在Discord上不太活跃。我"}, {"type": "subtitle", "time": 24456.51, "timestamp": "06:47:36", "text": "睡着了"}, {"type": "subtitle", "time": 24461.15, "timestamp": "06:47:41", "text": "再次。该拿我怎么办？你的痛苦"}, {"type": "subtitle", "time": 24463.23, "timestamp": "06:47:43", "text": "疼痛。是的。"}, {"type": "subtitle", "time": 24471.15, "timestamp": "06:47:51", "text": "再次？嘿，我正在做"}, {"type": "subtitle", "time": 24474.628, "timestamp": "06:47:54", "text": "好的。今天我们要玩Apex英雄。所以"}, {"type": "subtitle", "time": 24478.03, "timestamp": "06:47:58", "text": "这可能是"}]
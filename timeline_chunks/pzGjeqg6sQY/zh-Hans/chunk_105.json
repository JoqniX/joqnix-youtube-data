[{"type": "subtitle", "time": 6301.39, "timestamp": "01:45:01", "text": "很高兴你把它删了。所以，但总是"}, {"type": "subtitle", "time": 6304.03, "timestamp": "01:45:04", "text": "记住这一点"}, {"type": "subtitle", "time": 6306.95, "timestamp": "01:45:06", "text": "锁。我的意思是，我真的把它展示出来了"}, {"type": "subtitle", "time": 6310.75, "timestamp": "01:45:10", "text": "在我的聊天中，这个聊天呃……我"}, {"type": "subtitle", "time": 6313.149, "timestamp": "01:45:13", "text": "有。所以"}, {"type": "subtitle", "time": 6326.229, "timestamp": "01:45:26", "text": "是。我以为我做了什么事。是的。"}, {"type": "subtitle", "time": 6327.709, "timestamp": "01:45:27", "text": "好的。好的。"}, {"type": "subtitle", "time": 6331.229, "timestamp": "01:45:31", "text": "好的。超好的。"}, {"type": "subtitle", "time": 6335.87, "timestamp": "01:45:35", "text": "好的。我还少一个箱子。他"}, {"type": "subtitle", "time": 6339.51, "timestamp": "01:45:39", "text": "他说：“等一下。看看这个。”"}, {"type": "subtitle", "time": 6342.59, "timestamp": "01:45:42", "text": "获得了100%的分数"}, {"type": "subtitle", "time": 6346.07, "timestamp": "01:45:46", "text": "一切。”而他的中心层面是"}, {"type": "subtitle", "time": 6347.95, "timestamp": "01:45:47", "text": "99."}, {"type": "subtitle", "time": 6352.91, "timestamp": "01:45:52", "text": "如何？什么？打扰一下。什么？嗯？"}, {"type": "subtitle", "time": 6355.32, "timestamp": "01:45:55", "text": "嗯？ 嗯？"}, {"type": "subtitle", "time": 6357.32, "timestamp": "01:45:57", "text": "嗯？ 如何？如何？究竟如何？为什么？为什么？嗯？"}]
[{"type": "subtitle", "time": 7417.43, "timestamp": "02:03:37", "text": "它。看，我现在在吹泡泡了。所以，"}, {"type": "subtitle", "time": 7420.149, "timestamp": "02:03:40", "text": "呃，孩子们，你们会想象泡泡吗？等待，"}, {"type": "subtitle", "time": 7421.669, "timestamp": "02:03:41", "text": "等等，等等，等等，等等。我要放"}, {"type": "subtitle", "time": 7426.229, "timestamp": "02:03:46", "text": "你身上有泡泡。我会让你死。"}, {"type": "subtitle", "time": 7427.55, "timestamp": "02:03:47", "text": "嘿，过来"}, {"type": "subtitle", "time": 7430.589, "timestamp": "02:03:50", "text": "这里。我要在你脸上放泡泡。"}, {"type": "subtitle", "time": 7434.629, "timestamp": "02:03:54", "text": "等等，我要……我要……我要扔炸弹水"}]
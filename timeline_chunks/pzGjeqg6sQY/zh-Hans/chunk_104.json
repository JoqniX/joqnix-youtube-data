[{"type": "subtitle", "time": 6262.07, "timestamp": "01:44:22", "text": "胸部？我在这胸口待了两个小时了。一"}, {"type": "subtitle", "time": 6265.31, "timestamp": "01:44:25", "text": "单箱。我是"}, {"type": "subtitle", "time": 6283.95, "timestamp": "01:44:43", "text": "呃，你希望我做什么？"}, {"type": "subtitle", "time": 6287.35, "timestamp": "01:44:47", "text": "说？如果那条信息真的存在，我当时"}, {"type": "subtitle", "time": 6290.629, "timestamp": "01:44:50", "text": "我会请求你不要发送。说"}, {"type": "subtitle", "time": 6293.03, "timestamp": "01:44:53", "text": "一直谈论其他主播，直到我"}, {"type": "subtitle", "time": 6296.95, "timestamp": "01:44:56", "text": "提到他们。但从这个意义上讲，我是"}]
[{"type": "subtitle", "time": 1020.71, "timestamp": "00:17:00", "text": "疲劳的？我为保留……感到内疚"}, {"type": "subtitle", "time": 1024.39, "timestamp": "00:17:04", "text": "在 V 上直播，然后就离开了，不是"}, {"type": "subtitle", "time": 1028.309, "timestamp": "00:17:08", "text": "时刻在场。"}, {"type": "subtitle", "time": 1030.63, "timestamp": "00:17:10", "text": "这对新来的人来说很不利。"}, {"type": "subtitle", "time": 1031.76, "timestamp": "00:17:11", "text": "看着我"}, {"type": "subtitle", "time": 1036.75, "timestamp": "00:17:16", "text": "[音乐]"}, {"type": "subtitle", "time": 1039.35, "timestamp": "00:17:19", "text": "出色地。那就像主播一样"}, {"type": "subtitle", "time": 1052.63, "timestamp": "00:17:32", "text": "就好像事情真的会发生一样。但我也是"}, {"type": "subtitle", "time": 1059.11, "timestamp": "00:17:39", "text": "因为我没在直播，所以才会发生这种情况。所以，"}, {"type": "subtitle", "time": 1062.31, "timestamp": "00:17:42", "text": "我正在把它装上船。我要去"}]
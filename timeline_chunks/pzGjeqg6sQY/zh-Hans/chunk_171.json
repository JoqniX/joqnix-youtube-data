[{"type": "subtitle", "time": 10260.309, "timestamp": "02:51:00", "text": "呃，等等，她说她在工作。我不可能"}, {"type": "subtitle", "time": 10262.79, "timestamp": "02:51:02", "text": "很高兴，但话说回来，我也不知道。"}, {"type": "subtitle", "time": 10265.309, "timestamp": "02:51:05", "text": "我想做的事。好的。"}, {"type": "subtitle", "time": 10268.309, "timestamp": "02:51:08", "text": "尽管希沙最初有些犹豫，"}, {"type": "subtitle", "time": 10271.75, "timestamp": "02:51:11", "text": "她最后爬上了陡峭的山坡。"}, {"type": "subtitle", "time": 10273.99, "timestamp": "02:51:13", "text": "与我一起。达到这样的程度之后"}, {"type": "subtitle", "time": 10275.83, "timestamp": "02:51:15", "text": "身高相仿，很明显她"}, {"type": "subtitle", "time": 10277.75, "timestamp": "02:51:17", "text": "不会轻易退缩。"}, {"type": "subtitle", "time": 10285.389, "timestamp": "02:51:25", "text": "[音乐]"}, {"type": "subtitle", "time": 10290.15, "timestamp": "02:51:30", "text": "le 表示打哈欠。我太困了"}, {"type": "subtitle", "time": 10291.75, "timestamp": "02:51:31", "text": "否则她的腿就会"}, {"type": "subtitle", "time": 10298.63, "timestamp": "02:51:38", "text": "嗯，从学习中抽出一些时间回家。"}, {"type": "subtitle", "time": 10300.07, "timestamp": "02:51:40", "text": "我从未见过拥有这么多东西的人"}, {"type": "subtitle", "time": 10303.71, "timestamp": "02:51:43", "text": "教科书和持续的文学"}, {"type": "subtitle", "time": 10308.23, "timestamp": "02:51:48", "text": "卧室全年使用。学校里的恶霸"}, {"type": "subtitle", "time": 10311.67, "timestamp": "02:51:51", "text": "一定很可怕。但水烟似乎"}, {"type": "subtitle", "time": 10314.389, "timestamp": "02:51:54", "text": "她玩得很开心。我就是不明白"}, {"type": "subtitle", "time": 10316.23, "timestamp": "02:51:56", "text": "明白她为什么突然发疯了"}, {"type": "subtitle", "time": 10319.51, "timestamp": "02:51:59", "text": "考试取得好成绩后的心情。我应该带"}]
[{"type": "subtitle", "time": 10020.71, "timestamp": "02:47:00", "text": "强调。我之前不知道这件事。所以她"}, {"type": "subtitle", "time": 10022.07, "timestamp": "02:47:02", "text": "我以为自己足够聪明，可以"}, {"type": "subtitle", "time": 10024.429, "timestamp": "02:47:04", "text": "已确认。"}, {"type": "subtitle", "time": 10027.349, "timestamp": "02:47:07", "text": "哦，好的。妈妈，我迫不及待地想看看什么"}, {"type": "subtitle", "time": 10029.389, "timestamp": "02:47:09", "text": "她还有别的"}, {"type": "subtitle", "time": 10031.389, "timestamp": "02:47:11", "text": "店铺。"}, {"type": "subtitle", "time": 10059.63, "timestamp": "02:47:39", "text": "好的。什么是"}, {"type": "subtitle", "time": 10063.269, "timestamp": "02:47:43", "text": "这？布丁。去爬这座悬崖。"}, {"type": "subtitle", "time": 10065.75, "timestamp": "02:47:45", "text": "我们只能靠自己了。前方。这取决于"}, {"type": "subtitle", "time": 10068.55, "timestamp": "02:47:48", "text": "现在我们。放进乖孩子。回家去。"}, {"type": "subtitle", "time": 10070.15, "timestamp": "02:47:50", "text": "要乖。好的。我会带你美味的食物来。"}, {"type": "subtitle", "time": 10072.349, "timestamp": "02:47:52", "text": "当我喝饮料吃零食的时候"}]
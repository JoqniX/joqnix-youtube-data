[{"type": "subtitle", "time": 19743.708, "timestamp": "05:29:03", "text": "我想做一个 Joathon"}, {"type": "subtitle", "time": 19753.19, "timestamp": "05:29:13", "text": "那个东西，但我还是不太明白它是什么。"}, {"type": "subtitle", "time": 19754.51, "timestamp": "05:29:14", "text": "我"}, {"type": "subtitle", "time": 19758.31, "timestamp": "05:29:18", "text": "想要，因为现在我的呃，我想……"}, {"type": "subtitle", "time": 19761.83, "timestamp": "05:29:21", "text": "侧边栏有浅色和深色模式可选"}, {"type": "subtitle", "time": 19765.11, "timestamp": "05:29:25", "text": "就像这样，或者你把它弄成这样，嗯……"}, {"type": "subtitle", "time": 19769.11, "timestamp": "05:29:29", "text": "可以根据任何设备使用"}, {"type": "subtitle", "time": 19772.548, "timestamp": "05:29:32", "text": "你手里的那个设备。如果你的手机是"}, {"type": "subtitle", "time": 19774.47, "timestamp": "05:29:34", "text": "在浅色模式下，您可以看到浅色模式。"}, {"type": "subtitle", "time": 19777.51, "timestamp": "05:29:37", "text": "网站的精简版。如果你的"}, {"type": "subtitle", "time": 19779.75, "timestamp": "05:29:39", "text": "手机处于深色模式，你可以看到深色"}, {"type": "subtitle", "time": 19780.91, "timestamp": "05:29:40", "text": "版本的"}, {"type": "subtitle", "time": 19783.19, "timestamp": "05:29:43", "text": "网站。有点像那种感觉"}, {"type": "subtitle", "time": 19786.51, "timestamp": "05:29:46", "text": "系统。这就是我想要的。"}, {"type": "subtitle", "time": 19790.67, "timestamp": "05:29:50", "text": "做。是的。所以这意味着所有"}, {"type": "subtitle", "time": 19794.548, "timestamp": "05:29:54", "text": "变量，例如所有文本等等等等"}, {"type": "subtitle", "time": 19797.51, "timestamp": "05:29:57", "text": "这些必须在全国范围内统一起来。"}]
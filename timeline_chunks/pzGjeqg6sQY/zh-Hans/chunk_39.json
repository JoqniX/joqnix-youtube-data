[{"type": "subtitle", "time": 2369.39, "timestamp": "00:39:29", "text": "让我来找你"}, {"type": "subtitle", "time": 2385.349, "timestamp": "00:39:45", "text": "[音乐]"}, {"type": "subtitle", "time": 2388.15, "timestamp": "00:39:48", "text": "你正躺在椅子上。等等，让我"}, {"type": "subtitle", "time": 2389.63, "timestamp": "00:39:49", "text": "得到"}, {"type": "subtitle", "time": 2394.63, "timestamp": "00:39:54", "text": "向上。我睡着了，现在正在往下掉。我"}, {"type": "subtitle", "time": 2396.43, "timestamp": "00:39:56", "text": "就像"}, {"type": "subtitle", "time": 2398.349, "timestamp": "00:39:58", "text": "字面上地"}]
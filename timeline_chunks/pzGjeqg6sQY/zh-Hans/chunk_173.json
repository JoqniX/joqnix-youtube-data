[{"type": "subtitle", "time": 10380.07, "timestamp": "02:53:00", "text": "你对他人的态度。专注于自己"}, {"type": "subtitle", "time": 10382.55, "timestamp": "02:53:02", "text": "然后退后一步，看看距离有多远"}, {"type": "subtitle", "time": 10385.349, "timestamp": "02:53:05", "text": "你来了。那就是她"}, {"type": "subtitle", "time": 10388.63, "timestamp": "02:53:08", "text": "告诉我了。你知道吗，这太有共鸣了。"}, {"type": "subtitle", "time": 10390.99, "timestamp": "02:53:10", "text": "我会把它带走"}, {"type": "subtitle", "time": 10393.75, "timestamp": "02:53:13", "text": "我。他说对不起。我认为她是"}, {"type": "subtitle", "time": 10396.83, "timestamp": "02:53:16", "text": "更明智的那一个。对此我深感抱歉。"}, {"type": "subtitle", "time": 10399.79, "timestamp": "02:53:19", "text": "胡言乱语。没关系。"}, {"type": "subtitle", "time": 10401.91, "timestamp": "02:53:21", "text": "尤莎。跳过这部电影。只有一个"}, {"type": "subtitle", "time": 10404.469, "timestamp": "02:53:24", "text": "供我们检查的地方。是的，最后一个"}]
[{"type": "subtitle", "time": 12076.95, "timestamp": "03:21:16", "text": "好的。为什么我会听到这么多回声？"}, {"type": "subtitle", "time": 12078.59, "timestamp": "03:21:18", "text": "他"}, {"type": "subtitle", "time": 12080.19, "timestamp": "03:21:20", "text": "现在？"}, {"type": "subtitle", "time": 12083.07, "timestamp": "03:21:23", "text": "始终如一。"}, {"type": "subtitle", "time": 12093.269, "timestamp": "03:21:33", "text": "耶。我怀疑我能不能打败他。哦，我"}, {"type": "subtitle", "time": 12111.269, "timestamp": "03:21:51", "text": "总之，实际上实际上实际上得到了"}, {"type": "subtitle", "time": 12118.83, "timestamp": "03:21:58", "text": "事物。我钱不够。"}]
[{"type": "subtitle", "time": 9489.59, "timestamp": "02:38:09", "text": "意义？从第一次考试开始，我就站了起来。"}, {"type": "subtitle", "time": 9492.63, "timestamp": "02:38:12", "text": "因疏忽大意而卧床不起。我曾是其中之一"}, {"type": "subtitle", "time": 9494.87, "timestamp": "02:38:14", "text": "距离满分还差一点。虽然我的"}, {"type": "subtitle", "time": 9498.03, "timestamp": "02:38:18", "text": "后来，家人让我很生气。"}, {"type": "subtitle", "time": 9501.07, "timestamp": "02:38:21", "text": "我。回想起来，我当时"}, {"type": "subtitle", "time": 9503.03, "timestamp": "02:38:23", "text": "固执的。不，不，不。别误会我"}, {"type": "subtitle", "time": 9504.95, "timestamp": "02:38:24", "text": "错了，我不是在炫耀。你知道，"}, {"type": "subtitle", "time": 9506.71, "timestamp": "02:38:26", "text": "几乎每个人在以下方面得分都很高："}, {"type": "subtitle", "time": 9507.87, "timestamp": "02:38:27", "text": "基本的"}, {"type": "subtitle", "time": 9510.389, "timestamp": "02:38:30", "text": "学校。我可能是约书亚州人民的……"}, {"type": "subtitle", "time": 9513.59, "timestamp": "02:38:33", "text": "他们对成绩非常敏感。我们开始吧"}, {"type": "subtitle", "time": 9515.15, "timestamp": "02:38:35", "text": "保持"}, {"type": "subtitle", "time": 9518.91, "timestamp": "02:38:38", "text": "移动。是的，我需要做这件事。"}, {"type": "subtitle", "time": 9522.79, "timestamp": "02:38:42", "text": "所以，还有三份礼物。呃，我"}, {"type": "subtitle", "time": 9525.63, "timestamp": "02:38:45", "text": "对这个地方了如指掌，就像对我的后背一样熟悉。"}, {"type": "subtitle", "time": 9529.95, "timestamp": "02:38:49", "text": "手。利用攀登高山的方法"}]
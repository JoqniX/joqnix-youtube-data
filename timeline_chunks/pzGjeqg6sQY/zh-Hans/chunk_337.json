[{"type": "subtitle", "time": 20222.15, "timestamp": "05:37:02", "text": "这。我们有淡入、淡出、飞翔"}, {"type": "subtitle", "time": 20224.628, "timestamp": "05:37:04", "text": "进，飞出，擦拭进去，擦拭出来，乘客进来，"}, {"type": "subtitle", "time": 20226.59, "timestamp": "05:37:06", "text": "帕克斯"}, {"type": "subtitle", "time": 20230.99, "timestamp": "05:37:10", "text": "出去。呃，移动元素关闭"}, {"type": "subtitle", "time": 20234.11, "timestamp": "05:37:14", "text": "可以做淡入淡出"}, {"type": "subtitle", "time": 20238.47, "timestamp": "05:37:18", "text": "哦。哦，这个努力很好。看，"}, {"type": "subtitle", "time": 20241.35, "timestamp": "05:37:21", "text": "瞧，瞧。褪色了。正面朝外。什么时候"}, {"type": "subtitle", "time": 20244.548, "timestamp": "05:37:24", "text": "向下滚动页面，就能看到它。"}, {"type": "subtitle", "time": 20247.23, "timestamp": "05:37:27", "text": "这适用于任何事物。"}, {"type": "subtitle", "time": 20255.11, "timestamp": "05:37:35", "text": "凉爽的。问题是当你向上滚动时，"}, {"type": "subtitle", "time": 20257.67, "timestamp": "05:37:37", "text": "它最终还是会褪色的。如果我输入"}, {"type": "subtitle", "time": 20258.67, "timestamp": "05:37:38", "text": "某物？"}, {"type": "subtitle", "time": 20266.47, "timestamp": "05:37:46", "text": "有些东西，但它终究会褪色。"}, {"type": "subtitle", "time": 20268.948, "timestamp": "05:37:48", "text": "逐渐消失。那也是好的效果吗？我"}, {"type": "subtitle", "time": 20270.27, "timestamp": "05:37:50", "text": "可以"}, {"type": "subtitle", "time": 20273.39, "timestamp": "05:37:53", "text": "感到困惑"}, {"type": "subtitle", "time": 20276.51, "timestamp": "05:37:56", "text": "逐渐消失的噪音实际上是"}, {"type": "subtitle", "time": 20279.51, "timestamp": "05:37:59", "text": "好的。好的。好的。我可以调整一下。"}]
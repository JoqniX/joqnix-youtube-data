[{"type": "subtitle", "time": 860.31, "timestamp": "00:14:20", "text": "她。我知道我不应该露面"}, {"type": "subtitle", "time": 862.629, "timestamp": "00:14:22", "text": "我这一面，但我正在直播"}, {"type": "subtitle", "time": 867.069, "timestamp": "00:14:27", "text": "24小时。我希望你能做到。给我一个"}, {"type": "subtitle", "time": 870.389, "timestamp": "00:14:30", "text": "例外。我不想直播"}, {"type": "subtitle", "time": 877.28, "timestamp": "00:14:37", "text": "为什么我睡不着觉"}, {"type": "subtitle", "time": 878.91, "timestamp": "00:14:38", "text": "[音乐]"}, {"type": "subtitle", "time": 883.23, "timestamp": "00:14:43", "text": "夜晚？你知道，昨天我"}, {"type": "subtitle", "time": 886.389, "timestamp": "00:14:46", "text": "我把手机收起来了，然后我就……"}, {"type": "subtitle", "time": 887.55, "timestamp": "00:14:47", "text": "仍然"}, {"type": "subtitle", "time": 890.03, "timestamp": "00:14:50", "text": "凌晨三点感到无聊"}, {"type": "subtitle", "time": 893.269, "timestamp": "00:14:53", "text": "早上，我心想：“不，为什么我不能摔倒？”"}, {"type": "subtitle", "time": 895.67, "timestamp": "00:14:55", "text": "睡着了吗？"}]
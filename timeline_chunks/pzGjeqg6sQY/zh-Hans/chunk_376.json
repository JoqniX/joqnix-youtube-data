[{"type": "subtitle", "time": 22562.31, "timestamp": "06:16:02", "text": "它。好吧，我摆弄了一下。好的。"}, {"type": "subtitle", "time": 22563.99, "timestamp": "06:16:03", "text": "好的。好的。关键帧。好的。我们开始吧"}, {"type": "subtitle", "time": 22568.31, "timestamp": "06:16:08", "text": "移除旋转功能。我们不希望那样。"}, {"type": "subtitle", "time": 22572.708, "timestamp": "06:16:12", "text": "嗯，我希望你站着，保持原样。"}, {"type": "subtitle", "time": 22576.47, "timestamp": "06:16:16", "text": "如何进行后退动作？我想要"}, {"type": "subtitle", "time": 22586.39, "timestamp": "06:16:26", "text": "出色地。如果我制作一个新的动画并这样做"}, {"type": "subtitle", "time": 22602.32, "timestamp": "06:16:42", "text": "呃，应该去"}, {"type": "subtitle", "time": 22604.19, "timestamp": "06:16:44", "text": "[音乐]"}, {"type": "subtitle", "time": 22607.03, "timestamp": "06:16:47", "text": "从它应该变为负值"}, {"type": "subtitle", "time": 22608.64, "timestamp": "06:16:48", "text": "100，对吧？"}, {"type": "subtitle", "time": 22619.47, "timestamp": "06:16:59", "text": "翻转了吗？"}]
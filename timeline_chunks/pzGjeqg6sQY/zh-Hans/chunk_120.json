[{"type": "subtitle", "time": 7200.149, "timestamp": "02:00:00", "text": "别担心，我懂你。不，没问题。"}, {"type": "subtitle", "time": 7201.99, "timestamp": "02:00:01", "text": "完全没有。毕竟，这是巡逻队的职责。"}, {"type": "subtitle", "time": 7203.87, "timestamp": "02:00:03", "text": "照顾居民"}, {"type": "subtitle", "time": 7206.91, "timestamp": "02:00:06", "text": "需要。嗯，但这让我"}, {"type": "subtitle", "time": 7209.189, "timestamp": "02:00:09", "text": "不愿让你加班"}, {"type": "subtitle", "time": 7210.99, "timestamp": "02:00:10", "text": "处理我的个人事务"}, {"type": "subtitle", "time": 7213.43, "timestamp": "02:00:13", "text": "问题。如果你能帮我这个内部人士，你就会"}, {"type": "subtitle", "time": 7215.43, "timestamp": "02:00:15", "text": "接受补偿作为表示感谢的象征。"}, {"type": "subtitle", "time": 7222.35, "timestamp": "02:00:22", "text": "节省。哦，别担心。"}, {"type": "subtitle", "time": 7224.91, "timestamp": "02:00:24", "text": "赔偿。我的薪水完全够用。"}, {"type": "subtitle", "time": 7227.669, "timestamp": "02:00:27", "text": "足够的。实际上，我具备相当的能力。"}, {"type": "subtitle", "time": 7230.95, "timestamp": "02:00:30", "text": "心中有朋友。什么？如果我们雇佣"}, {"type": "subtitle", "time": 7234.629, "timestamp": "02:00:34", "text": "让她来帮忙？我的天啊。她呃"}, {"type": "subtitle", "time": 7238.27, "timestamp": "02:00:38", "text": "水烟，你打算把这份工作搞砸吗？"}, {"type": "subtitle", "time": 7243.35, "timestamp": "02:00:43", "text": "我？哇。哇。看着我。现在去"}, {"type": "subtitle", "time": 7245.43, "timestamp": "02:00:45", "text": "医院和你的伤情。现在她是"}, {"type": "subtitle", "time": 7248.63, "timestamp": "02:00:48", "text": "会来找我，不是吗？"}, {"type": "subtitle", "time": 7255.27, "timestamp": "02:00:55", "text": "她？ Jocknik应该已经到了。"}, {"type": "subtitle", "time": 7259.51, "timestamp": "02:00:59", "text": "很快。你这个笨蛋，往右边看！"}]
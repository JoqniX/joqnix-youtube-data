[{"type": "subtitle", "time": 10204.95, "timestamp": "02:50:04", "text": "地方。所以谜语中的“手”是"}, {"type": "subtitle", "time": 10207.59, "timestamp": "02:50:07", "text": "字面上来说，并不是另一只手。这是"}, {"type": "subtitle", "time": 10217.03, "timestamp": "02:50:17", "text": "H 既指太阳也指某事"}, {"type": "subtitle", "time": 10219.07, "timestamp": "02:50:19", "text": "我们的中心，以及心脏向下"}, {"type": "subtitle", "time": 10221.55, "timestamp": "02:50:21", "text": "很有可能。"}, {"type": "subtitle", "time": 10224.95, "timestamp": "02:50:24", "text": "好的，树枝指向旁边"}, {"type": "subtitle", "time": 10227.309, "timestamp": "02:50:27", "text": "观点。我需要做这个"}, {"type": "subtitle", "time": 10240.59, "timestamp": "02:50:40", "text": "它？你找到了一些照片和一个"}, {"type": "subtitle", "time": 10247.83, "timestamp": "02:50:47", "text": "这是一部严肃的剧情片。她使用了数字"}, {"type": "subtitle", "time": 10251.95, "timestamp": "02:50:51", "text": "为获得批准而进行的竞赛，其中这封信"}, {"type": "subtitle", "time": 10256.51, "timestamp": "02:50:56", "text": "居住地。已接受注射。"}]
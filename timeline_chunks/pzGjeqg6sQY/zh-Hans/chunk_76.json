[{"type": "subtitle", "time": 4565.83, "timestamp": "01:16:05", "text": "那？哦，埃​​米德·约翰。呃，埃姆特·约翰逊"}, {"type": "subtitle", "time": 4567.83, "timestamp": "01:16:07", "text": "感谢关注。欢迎来到"}, {"type": "subtitle", "time": 4569.51, "timestamp": "01:16:09", "text": "溪流。你好吗？你是怎么找到我们的？"}, {"type": "subtitle", "time": 4577.59, "timestamp": "01:16:17", "text": "你？嘿，这是……这是像B一样的吗？"}, {"type": "subtitle", "time": 4581.669, "timestamp": "01:16:21", "text": "突袭之类的？什么？ Zra，你好，"}, {"type": "subtitle", "time": 4584.47, "timestamp": "01:16:24", "text": "欢迎，欢迎。等等，这太可疑了。"}, {"type": "subtitle", "time": 4586.03, "timestamp": "01:16:26", "text": "我是如何得到两个"}, {"type": "subtitle", "time": 4588.709, "timestamp": "01:16:28", "text": "人们。你好吗？哦，我正在做"}, {"type": "subtitle", "time": 4590.79, "timestamp": "01:16:30", "text": "好的。你好。你好。你们是怎么做到的？"}, {"type": "subtitle", "time": 4593.149, "timestamp": "01:16:33", "text": "找到我？我真的……"}, {"type": "subtitle", "time": 4596.99, "timestamp": "01:16:36", "text": "好奇的。你们是怎么找到的？"}, {"type": "subtitle", "time": 4599.79, "timestamp": "01:16:39", "text": "我？"}, {"type": "subtitle", "time": 4603.59, "timestamp": "01:16:43", "text": "你好。逮捕巴卡。不，我想找到"}, {"type": "subtitle", "time": 4611.55, "timestamp": "01:16:51", "text": "尽管。它在哪里？我找不到"}, {"type": "subtitle", "time": 4615.38, "timestamp": "01:16:55", "text": "它。你好吗？我很好。"}, {"type": "subtitle", "time": 4618.47, "timestamp": "01:16:58", "text": "[音乐]"}]
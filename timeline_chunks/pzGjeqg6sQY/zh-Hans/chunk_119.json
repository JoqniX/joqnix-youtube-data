[{"type": "subtitle", "time": 7140.229, "timestamp": "01:59:00", "text": "如果你再服用一次会发生什么？"}, {"type": "subtitle", "time": 7143.109, "timestamp": "01:59:03", "text": "从山坡上滚落。我的天啊。"}, {"type": "subtitle", "time": 7146.39, "timestamp": "01:59:06", "text": "对不起。我不该说那些话。"}, {"type": "subtitle", "time": 7148.87, "timestamp": "01:59:08", "text": "小佩特罗拉，你太小了"}, {"type": "subtitle", "time": 7151.75, "timestamp": "01:59:11", "text": "明白爱的真谛。持久"}, {"type": "subtitle", "time": 7154.75, "timestamp": "01:59:14", "text": "身体上的疼痛是一回事，但身体上的疼痛又是另一回事。"}, {"type": "subtitle", "time": 7157.669, "timestamp": "01:59:17", "text": "单恋是一种挑战"}, {"type": "subtitle", "time": 7160.03, "timestamp": "01:59:20", "text": "没有英雄能够"}, {"type": "subtitle", "time": 7163.27, "timestamp": "01:59:23", "text": "克服。总之，我会抓捕并占领"}, {"type": "subtitle", "time": 7166.189, "timestamp": "01:59:26", "text": "亲爱的。你好，"}, {"type": "subtitle", "time": 7168.109, "timestamp": "01:59:28", "text": "凯特"}, {"type": "subtitle", "time": 7172.55, "timestamp": "01:59:32", "text": "贝伊。你可以抓任意数量。"}, {"type": "subtitle", "time": 7175.669, "timestamp": "01:59:35", "text": "等我康复后。但是孩子，我会长大，我会长大"}, {"type": "subtitle", "time": 7177.43, "timestamp": "01:59:37", "text": "等得不耐烦了。何时"}, {"type": "subtitle", "time": 7181.109, "timestamp": "01:59:41", "text": "机会再次出现吗？除了，"}, {"type": "subtitle", "time": 7182.87, "timestamp": "01:59:42", "text": "千言万语始终活跃"}, {"type": "subtitle", "time": 7184.149, "timestamp": "01:59:44", "text": "最近，所以现在是最佳时机"}, {"type": "subtitle", "time": 7187.189, "timestamp": "01:59:47", "text": "捕获回声。我不能让这个机会溜走。"}, {"type": "subtitle", "time": 7189.75, "timestamp": "01:59:49", "text": "悄悄溜走。好吧，这样如何？我去"}, {"type": "subtitle", "time": 7191.83, "timestamp": "01:59:51", "text": "捕捉回声，你就会去……"}, {"type": "subtitle", "time": 7194.229, "timestamp": "01:59:54", "text": "医院。这样可以吗？但我不想"}, {"type": "subtitle", "time": 7196.629, "timestamp": "01:59:56", "text": "不想用我的问题来打扰你。不"}]
[{"type": "subtitle", "time": 9601.03, "timestamp": "02:40:01", "text": "鱼。我迫不及待想尝尝。她"}, {"type": "subtitle", "time": 9604.91, "timestamp": "02:40:04", "text": "A 鼓掌时，所以可以"}, {"type": "subtitle", "time": 9608.19, "timestamp": "02:40:08", "text": "我可以抚摸宠物吗？"}, {"type": "subtitle", "time": 9616.07, "timestamp": "02:40:16", "text": "你？我要喂你吃这个"}, {"type": "subtitle", "time": 9653.23, "timestamp": "02:40:53", "text": "老兄，我的感冒好难受啊"}, {"type": "subtitle", "time": 9656.91, "timestamp": "02:40:56", "text": "疼痛。我已经很久没有放松过了。"}, {"type": "subtitle", "time": 9659.429, "timestamp": "02:40:59", "text": "这让我想起了我来的日子"}]
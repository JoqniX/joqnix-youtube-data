[{"type": "subtitle", "time": 11101.75, "timestamp": "03:05:01", "text": "必须格外小心。这是我的"}, {"type": "subtitle", "time": 11105.83, "timestamp": "03:05:05", "text": "第三个被禁的人。不是第二次60秒禁令"}, {"type": "subtitle", "time": 11108.95, "timestamp": "03:05:08", "text": "但我必须小心。我会"}, {"type": "subtitle", "time": 11111.75, "timestamp": "03:05:11", "text": "不，我试试把屏幕炸掉"}, {"type": "subtitle", "time": 11115.429, "timestamp": "03:05:15", "text": "从现在开始。我不会展示任何东西"}, {"type": "subtitle", "time": 11122.389, "timestamp": "03:05:22", "text": "害怕的。此时此刻，我感到害怕。你"}, {"type": "subtitle", "time": 11124.469, "timestamp": "03:05:24", "text": "这种情况发生在直播中，但VS"}, {"type": "subtitle", "time": 11126.87, "timestamp": "03:05:26", "text": "什么也没发生。好的？什么都没有"}, {"type": "subtitle", "time": 11130.07, "timestamp": "03:05:30", "text": "事情发生了。仅限直播。你从不"}, {"type": "subtitle", "time": 11137.19, "timestamp": "03:05:37", "text": "正在观看。是的，现在是12点30分。患病的"}, {"type": "subtitle", "time": 11139.55, "timestamp": "03:05:39", "text": "请您告辞，我会的。"}, {"type": "subtitle", "time": 11146.59, "timestamp": "03:05:46", "text": "它。今天是"}, {"type": "subtitle", "time": 11150.63, "timestamp": "03:05:50", "text": "乐趣。今天过得很开心。我们呃到达了呃"}, {"type": "subtitle", "time": 11153.67, "timestamp": "03:05:53", "text": "联盟等级29级。我再努力刷一下。"}, {"type": "subtitle", "time": 11155.429, "timestamp": "03:05:55", "text": "大概在我做日常练习的时候，我会"}]
[{"type": "subtitle", "time": 33251.112, "timestamp": "09:14:11", "text": "[Laughter]"}, {"type": "subtitle", "time": 33252.67, "timestamp": "09:14:12", "text": "The way I"}, {"type": "subtitle", "time": 33260.15, "timestamp": "09:14:20", "text": "You couldn't open the door. I couldn't"}, {"type": "subtitle", "time": 33262.63, "timestamp": "09:14:22", "text": "open the door."}, {"type": "subtitle", "time": 33266.19, "timestamp": "09:14:26", "text": "I opened it from outside."}, {"type": "subtitle", "time": 33268.15, "timestamp": "09:14:28", "text": "Yeah."}, {"type": "subtitle", "time": 33270.31, "timestamp": "09:14:30", "text": "I was like, you know, I got locked down."}, {"type": "subtitle", "time": 33272.708, "timestamp": "09:14:32", "text": "I could see your head. I could see your"}, {"type": "subtitle", "time": 33275.35, "timestamp": "09:14:35", "text": "head outside the door, but it was"}, {"type": "subtitle", "time": 33276.868, "timestamp": "09:14:36", "text": "closed."}, {"type": "subtitle", "time": 33294.708, "timestamp": "09:14:54", "text": "Oh boy. Okay. Okay. Okay. We got eight."}, {"type": "subtitle", "time": 33297.15, "timestamp": "09:14:57", "text": "I have 89 books now."}]
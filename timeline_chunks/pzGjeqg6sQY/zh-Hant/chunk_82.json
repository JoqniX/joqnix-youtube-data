[{"type": "subtitle", "time": 4920.35, "timestamp": "01:22:00", "text": "第一款中國遊戲"}, {"type": "subtitle", "time": 4924.27, "timestamp": "01:22:04", "text": "。哦，真有趣。其實"}, {"type": "subtitle", "time": 4926.709, "timestamp": "01:22:06", "text": "挺好玩的。我喜歡你的模型。這是你"}, {"type": "subtitle", "time": 4930.149, "timestamp": "01:22:10", "text": "自己設計的嗎？"}, {"type": "subtitle", "time": 4933.43, "timestamp": "01:22:13", "text": "這個模型的設計是由"}, {"type": "subtitle", "time": 4936.47, "timestamp": "01:22:16", "text": "我的一位好朋友製作的。嗯，這就像是"}, {"type": "subtitle", "time": 4940.07, "timestamp": "01:22:20", "text": "我收到的生日禮物。是的，這個設計，"}, {"type": "subtitle", "time": 4942.149, "timestamp": "01:22:22", "text": "呃，這是Jock的原始設計，有點像是"}, {"type": "subtitle", "time": 4943.149, "timestamp": "01:22:23", "text": "測試"}, {"type": "subtitle", "time": 4946.51, "timestamp": "01:22:26", "text": "版設計。  是的，"}, {"type": "subtitle", "time": 4949.91, "timestamp": "01:22:29", "text": "我確實正在製作一個PL的原始版本"}, {"type": "subtitle", "time": 4967.99, "timestamp": "01:22:47", "text": "反應是「我的天哪」。"}, {"type": "subtitle", "time": 4972.39, "timestamp": "01:22:52", "text": "呃，我不得不禮貌地拒絕，"}, {"type": "subtitle", "time": 4974.11, "timestamp": "01:22:54", "text": "因為……"}, {"type": "subtitle", "time": 4978.709, "timestamp": "01:22:58", "text": "因為我的經理會幫我處理大部分"}]
[{"type": "subtitle", "time": 5344.51, "timestamp": "01:29:04", "text": "[音樂]"}, {"type": "subtitle", "time": 5347.51, "timestamp": "01:29:07", "text": "。我認為我們不一樣，嗯，我認為"}, {"type": "subtitle", "time": 5350.669, "timestamp": "01:29:10", "text": "我們在玩"}, {"type": "subtitle", "time": 5354.35, "timestamp": "01:29:14", "text": "遊戲的方式等等方面都不一樣。"}, {"type": "subtitle", "time": 5361.47, "timestamp": "01:29:21", "text": "，我很喜歡這個故事和"}, {"type": "subtitle", "time": 5364.669, "timestamp": "01:29:24", "text": "背景設定，而且"}, {"type": "subtitle", "time": 5366.27, "timestamp": "01:29:26", "text": "因為"}, {"type": "subtitle", "time": 5369.55, "timestamp": "01:29:29", "text": "這是一款很"}, {"type": "subtitle", "time": 5371.47, "timestamp": "01:29:31", "text": "有趣的"}, {"type": "subtitle", "time": 5375.55, "timestamp": "01:29:35", "text": "遊戲，所以我有點"}, {"type": "subtitle", "time": 5381.669, "timestamp": "01:29:41", "text": "想把 1.0 版本的所有內容都體驗完。"}, {"type": "subtitle", "time": 5388.99, "timestamp": "01:29:48", "text": "所以我"}, {"type": "subtitle", "time": 5393.229, "timestamp": "01:29:53", "text": "不能相信他撒謊了。不過我確實很喜歡這個故事"}, {"type": "subtitle", "time": 5396.39, "timestamp": "01:29:56", "text": "。笨蛋，我要把阿什瑪的一切都解決掉，"}]
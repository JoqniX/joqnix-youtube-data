[{"type": "subtitle", "time": 28321.83, "timestamp": "07:52:01", "text": "我的天啊。你好。你好。你好嗎"}, {"type": "subtitle", "time": 28330.868, "timestamp": "07:52:10", "text": "？  希望你今天一切順利。為什麼燈不亮？你的遊戲太"}, {"type": "subtitle", "time": 28339.43, "timestamp": "07:52:19", "text": "黑暗了。  以防萬一。你是什​​麼意思"}, {"type": "subtitle", "time": 28345.19, "timestamp": "07:52:25", "text": "？如果我死了，請給我拍張照片。這樣你就能得到"}, {"type": "subtitle", "time": 28370.548, "timestamp": "07:52:50", "text": "黃金了。好的。如果我死了。現在我也"}, {"type": "subtitle", "time": 28371.868, "timestamp": "07:52:51", "text": "可以給你拍張照片嗎？現在不要。現在不要。當你看到我死後出現的鬼魂時，很可能我會是第一個死的。哦。"}]
[{"type": "subtitle", "time": 4386.35, "timestamp": "01:13:06", "text": "哦，"}, {"type": "subtitle", "time": 4389.83, "timestamp": "01:13:09", "text": "是的。我破解了多米諾骨牌並獲得了寶箱嗎？"}, {"type": "subtitle", "time": 4422.229, "timestamp": "01:13:42", "text": "夥計，想像一下，如果我和其他人一樣遭受這種痛苦。還有"}, {"type": "subtitle", "time": 4424.47, "timestamp": "01:13:44", "text": "更多"}, {"type": "subtitle", "time": 4438.55, "timestamp": "01:13:58", "text": "想像。是的。我確實破解了它，然後做了那些"}]
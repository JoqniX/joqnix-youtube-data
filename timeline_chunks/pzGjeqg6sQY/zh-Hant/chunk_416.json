[{"type": "subtitle", "time": 24960.788, "timestamp": "06:56:00", "text": "其他不說，這是我們第一次玩《恐"}, {"type": "subtitle", "time": 24961.99, "timestamp": "06:56:01", "text": "高症》，我們倆都很害怕。嗯，是的。是嗎"}, {"type": "subtitle", "time": 24980.548, "timestamp": "06:56:20", "text": "？嗯。是的。我很害怕，但我會盡我最大的努力，我真的很害怕。"}, {"type": "subtitle", "time": 24982.788, "timestamp": "06:56:22", "text": "我的意思是，我不知道遊戲裡的音量是否合適。我也不知道，因為我到家很晚了，"}, {"type": "subtitle", "time": 24989.59, "timestamp": "06:56:29", "text": "所以沒辦法設定音頻，不過應該沒問題，遊戲裡好像有靜音之類的功能。 Joker senpai 的音訊在遊戲和直播之間正常嗎？我不知道，讓我看看。喔等等，如果"}, {"type": "subtitle", "time": 24993.628, "timestamp": "06:56:33", "text": "我靜音"}, {"type": "subtitle", "time": 24996.628, "timestamp": "06:56:36", "text": "然後跟對方說話可以嗎？你們是怎麼操作的？你們"}, {"type": "subtitle", "time": 25001.19, "timestamp": "06:56:41", "text": "通常都是靜音嗎"}, {"type": "subtitle", "time": 25007.59, "timestamp": "06:56:47", "text": "？我不知道。  我不知道。  嘿，就像等等，你"}, {"type": "subtitle", "time": 25012.708, "timestamp": "06:56:52", "text": "說我們可以使用等等，你的遊戲在運行嗎？遊戲"}, {"type": "subtitle", "time": 25016.23, "timestamp": "06:56:56", "text": "運作正常嗎？是的，我的遊戲正在運行"}]
[{"type": "subtitle", "time": 33789.746, "timestamp": "09:23:09", "text": "用這些免費的東西。我們使用它。"}, {"type": "subtitle", "time": 33792.15, "timestamp": "09:23:12", "text": "我們做到了。"}, {"type": "subtitle", "time": 33795.906, "timestamp": "09:23:15", "text": "我們還是會做和"}, {"type": "subtitle", "time": 33798.15, "timestamp": "09:23:18", "text": "以前一樣的事情，嘗試完成一"}, {"type": "subtitle", "time": 33800.79, "timestamp": "09:23:20", "text": "兩個目標，用錢賺錢，然後做一些類似的事情。"}, {"type": "subtitle", "time": 33809.95, "timestamp": "09:23:29", "text": "我"}, {"type": "subtitle", "time": 33812.51, "timestamp": "09:23:32", "text": "不"}, {"type": "subtitle", "time": 33816.47, "timestamp": "09:23:36", "text": "知道你那裡還有廉價版這種東西。哦，是的。在 Val 中你也做同樣的事情，對吧？你不買任何槍支。"}, {"type": "subtitle", "time": 33821.83, "timestamp": "09:23:41", "text": "你拿著手槍到處玩，然後就像我一樣，最後買了機關槍之類的東西"}, {"type": "subtitle", "time": 33825.19, "timestamp": "09:23:45", "text": "。差不多是這樣。我的天哪。"}]
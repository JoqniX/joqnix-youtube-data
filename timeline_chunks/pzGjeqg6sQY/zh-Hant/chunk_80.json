[{"type": "subtitle", "time": 4811.39, "timestamp": "01:20:11", "text": "嗯？哦，你們在打架嗎？"}, {"type": "subtitle", "time": 4813.91, "timestamp": "01:20:13", "text": "哦，你直播的時候只玩凋零浪潮嗎？"}, {"type": "subtitle", "time": 4816.55, "timestamp": "01:20:16", "text": "還是也會玩其他遊戲"}, {"type": "subtitle", "time": 4819.75, "timestamp": "01:20:19", "text": "？我其實會做很多不同的事情。我"}, {"type": "subtitle", "time": 4821.91, "timestamp": "01:20:21", "text": "不玩枯萎的波浪。我不是那種會重複玩某一款遊戲的"}, {"type": "subtitle", "time": 4824.27, "timestamp": "01:20:24", "text": "人"}, {"type": "subtitle", "time": 4825.87, "timestamp": "01:20:25", "text": "。"}, {"type": "subtitle", "time": 4828.55, "timestamp": "01:20:28", "text": "嗯，這樣我就能把"}, {"type": "subtitle", "time": 4831.03, "timestamp": "01:20:31", "text": "這款遊戲玩到100%完成了，這樣我就可以休息一下了。但"}, {"type": "subtitle", "time": 4836.83, "timestamp": "01:20:36", "text": "我是遊戲主播，所以"}, {"type": "subtitle", "time": 4841.59, "timestamp": "01:20:41", "text": "我不會只玩一款遊戲，玩遊戲對我來說就像是"}, {"type": "subtitle", "time": 4846.709, "timestamp": "01:20:46", "text": "偶爾玩玩，或是有時候會比較"}, {"type": "subtitle", "time": 4848.11, "timestamp": "01:20:48", "text": "頻繁，"}, {"type": "subtitle", "time": 4851.35, "timestamp": "01:20:51", "text": "但我喜歡做遊戲以外的其他事情"}, {"type": "subtitle", "time": 4854.39, "timestamp": "01:20:54", "text": "。遊戲之外。是的，"}, {"type": "subtitle", "time": 4857.51, "timestamp": "01:20:57", "text": "內容與遊戲無關。例如"}]
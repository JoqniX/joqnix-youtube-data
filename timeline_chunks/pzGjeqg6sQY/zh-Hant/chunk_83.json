[{"type": "subtitle", "time": 4981.99, "timestamp": "01:23:01", "text": "事情。我們確實有一個專門的"}, {"type": "subtitle", "time": 4985.189, "timestamp": "01:23:05", "text": "團隊，他們會協助我進行"}, {"type": "subtitle", "time": 4988.03, "timestamp": "01:23:08", "text": "插畫、設計等等工作。"}, {"type": "subtitle", "time": 4993.59, "timestamp": "01:23:13", "text": "所以我不得不說不。嗯，哦，是的。"}, {"type": "subtitle", "time": 4996.07, "timestamp": "01:23:16", "text": "我可以給你看我的作品嗎？我的意思是，你可以給我看看，"}, {"type": "subtitle", "time": 4998.31, "timestamp": "01:23:18", "text": "但別指望我會接受你的"}, {"type": "subtitle", "time": 5000.149, "timestamp": "01:23:20", "text": "委託，例如畫畫"}]
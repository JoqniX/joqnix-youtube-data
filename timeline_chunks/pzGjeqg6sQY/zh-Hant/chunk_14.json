[{"type": "subtitle", "time": 860.31, "timestamp": "00:14:20", "text": "她也不是。我知道我不該展現"}, {"type": "subtitle", "time": 862.629, "timestamp": "00:14:22", "text": "我這一面，但我要直播"}, {"type": "subtitle", "time": 867.069, "timestamp": "00:14:27", "text": "24小時。我希望你能做到。給我"}, {"type": "subtitle", "time": 870.389, "timestamp": "00:14:30", "text": "破例一次。我不想以"}, {"type": "subtitle", "time": 877.28, "timestamp": "00:14:37", "text": "為什麼我在音樂之夜睡不著？你"}, {"type": "subtitle", "time": 883.23, "timestamp": "00:14:43", "text": "知道嗎，昨天我把"}, {"type": "subtitle", "time": 886.389, "timestamp": "00:14:46", "text": "手機收起來了，但到了凌晨"}, {"type": "subtitle", "time": 890.03, "timestamp": "00:14:50", "text": "3點我還是覺得無聊。我就想，"}, {"type": "subtitle", "time": 893.269, "timestamp": "00:14:53", "text": "「不，為什麼我"}, {"type": "subtitle", "time": 895.67, "timestamp": "00:14:55", "text": "睡不著？」"}]
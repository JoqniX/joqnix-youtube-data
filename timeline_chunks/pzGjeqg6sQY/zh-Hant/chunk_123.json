[{"type": "subtitle", "time": 7417.43, "timestamp": "02:03:37", "text": "所以他們蠻期待這份榜單的。"}, {"type": "subtitle", "time": 7421.669, "timestamp": "02:03:41", "text": "我會盡力。"}, {"type": "subtitle", "time": 7426.229, "timestamp": "02:03:46", "text": "我會幫你。跟我來，喬克斯。  好的。"}, {"type": "subtitle", "time": 7430.589, "timestamp": "02:03:50", "text": "我變成了迴聲。鳴叫，P 的 G 蓬鬆物。這就是"}]
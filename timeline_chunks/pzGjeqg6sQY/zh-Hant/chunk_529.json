[{"type": "subtitle", "time": 31752.468, "timestamp": "08:49:12", "text": "我的監視器前，我就直接出手。好的。什麼？如果他出現，"}, {"type": "subtitle", "time": 31768.67, "timestamp": "08:49:28", "text": "你就趕快跑過去。跑就行了。嗯？  直接跑到卡車那裡去。  跑到卡車那裡。是的。"}, {"type": "subtitle", "time": 31790.15, "timestamp": "08:49:50", "text": "我準備"}]
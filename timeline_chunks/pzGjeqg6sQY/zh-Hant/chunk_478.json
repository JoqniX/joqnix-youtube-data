[{"type": "subtitle", "time": 28699.99, "timestamp": "07:58:19", "text": "我本來只對別人的直播感興趣，反而讓事情變得不那麼可怕了，因為這種叫喊聲更讓我害怕。這是哪裡？我是誰？"}, {"type": "subtitle", "time": 28706.468, "timestamp": "07:58:26", "text": "哦，我當時在你屁股裡。  我的天啊。我的天啊。"}, {"type": "subtitle", "time": 28734.43, "timestamp": "07:58:54", "text": "我們該怎麼辦？我認為"}, {"type": "subtitle", "time": 28737.51, "timestamp": "07:58:57", "text": "我們可以先回去，以後再回來。就像我們又回到這裡一樣。是的。我們該如何做到這一點？"}]
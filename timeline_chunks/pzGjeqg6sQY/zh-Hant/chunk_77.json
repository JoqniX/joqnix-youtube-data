[{"type": "subtitle", "time": 4620.55, "timestamp": "01:17:00", "text": "我們現在真的在尋找"}, {"type": "subtitle", "time": 4623.31, "timestamp": "01:17:03", "text": "最後一個寶箱"}, {"type": "subtitle", "time": 4628.99, "timestamp": "01:17:08", "text": "和再生道具，這樣我就可以達到"}, {"type": "subtitle", "time": 4631.35, "timestamp": "01:17:11", "text": "100% 的再生能力了。所以我經常跟著教學"}, {"type": "subtitle", "time": 4633.669, "timestamp": "01:17:13", "text": "和影片一起看，以"}, {"type": "subtitle", "time": 4642.78, "timestamp": "01:17:22", "text": "任何內容。熱門頁面。我們把這件事也做成了音樂。"}, {"type": "subtitle", "time": 4647.27, "timestamp": "01:17:27", "text": "那條魚形的東西。等等，這是哪裡的"}, {"type": "subtitle", "time": 4652.03, "timestamp": "01:17:32", "text": "？"}, {"type": "subtitle", "time": 4655.87, "timestamp": "01:17:35", "text": "呃，你來自哪裡？我來自"}, {"type": "subtitle", "time": 4659.53, "timestamp": "01:17:39", "text": "太空。我是V，我不能透露"}, {"type": "subtitle", "time": 4663.55, "timestamp": "01:17:43", "text": "[音樂]"}, {"type": "subtitle", "time": 4666.51, "timestamp": "01:17:46", "text": "我，但我來自印度。  是的，我同意這一點。"}, {"type": "subtitle", "time": 4678.91, "timestamp": "01:17:58", "text": "[音樂]"}]
[{"type": "subtitle", "time": 26762.708, "timestamp": "07:26:02", "text": "天啊。  我的天啊。你是"}, {"type": "subtitle", "time": 26771.19, "timestamp": "07:26:11", "text": "怎麼死的？  我"}, {"type": "subtitle", "time": 26774.23, "timestamp": "07:26:14", "text": "不知道。就像，呃，我當時想，它從門口過來，把我困住了之類的。  我的天啊。  我的天啊。我不知道"}, {"type": "subtitle", "time": 26779.19, "timestamp": "07:26:19", "text": "這些"}, {"type": "subtitle", "time": 26782.83, "timestamp": "07:26:22", "text": "東西是做什麼用的？是啊，太難了。  我們該怎麼辦？沒錯。"}, {"type": "subtitle", "time": 26791.03, "timestamp": "07:26:31", "text": "等等，你獲得經驗值了嗎？我尖叫得好厲害。離開。好多冰淇淋"}, {"type": "subtitle", "time": 26816.868, "timestamp": "07:26:56", "text": "。  耳機用戶。  我的天哪，窗戶上面有鬼！  是的，你做到了。你知道嗎？我爸爸剛才打電話給我了。我問你，你還好嗎？發生了什麼事"}]
[{"type": "subtitle", "time": 22393.67, "timestamp": "06:13:13", "text": "測試一下。  嗯，我們會加上「我們會選擇它」這一項。我確實"}, {"type": "subtitle", "time": 22395.75, "timestamp": "06:13:15", "text": "上傳了很多我的模型和其他東西"}, {"type": "subtitle", "time": 22399.11, "timestamp": "06:13:19", "text": "。嗯，所以"}, {"type": "subtitle", "time": 22402.07, "timestamp": "06:13:22", "text": "我們可以在"}, {"type": "subtitle", "time": 22433.23, "timestamp": "06:13:53", "text": "彩色邊框。"}, {"type": "subtitle", "time": 22435.83, "timestamp": "06:13:55", "text": "我記得我用過這個，但我忘了是哪個伺服器用它做什麼了"}]
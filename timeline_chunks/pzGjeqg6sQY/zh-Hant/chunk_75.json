[{"type": "subtitle", "time": 4501.55, "timestamp": "01:15:01", "text": "更多任務之類的。對，就是這樣。"}, {"type": "subtitle", "time": 4506.79, "timestamp": "01:15:06", "text": "還有一個呃和一個"}, {"type": "subtitle", "time": 4510.55, "timestamp": "01:15:10", "text": "美人魚。我猜它只有一米。它在哪裡？"}, {"type": "subtitle", "time": 4513.51, "timestamp": "01:15:13", "text": "我只需要 Bobfly。只有一隻小蒼蠅"}, {"type": "subtitle", "time": 4516.39, "timestamp": "01:15:16", "text": "和一個補給箱。我的天哪。我還需要一個補給箱。"}, {"type": "subtitle", "time": 4523.39, "timestamp": "01:15:23", "text": "哦，這太"}, {"type": "subtitle", "time": 4530.31, "timestamp": "01:15:30", "text": "痛了。當然，我只需要一些補給"}, {"type": "subtitle", "time": 4531.92, "timestamp": "01:15:31", "text": "。是的，給音樂箱供貨，夥計。"}]
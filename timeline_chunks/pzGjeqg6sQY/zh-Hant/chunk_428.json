[{"type": "subtitle", "time": 25714.788, "timestamp": "07:08:34", "text": "？寶貝，怎麼了"}, {"type": "subtitle", "time": 25716.31, "timestamp": "07:08:36", "text": "？我的天啊。  我好像"}, {"type": "subtitle", "time": 25721.07, "timestamp": "07:08:41", "text": "看到了你的舌頭。寶貝，"}, {"type": "subtitle", "time": 25727.83, "timestamp": "07:08:47", "text": "你把我的舌頭都扯掉了。"}, {"type": "subtitle", "time": 25731.51, "timestamp": "07:08:51", "text": "嗯？那是什麼？什麼是「什麼」？看看你的眼球。什麼？嗯"}, {"type": "subtitle", "time": 25737.75, "timestamp": "07:08:57", "text": "？  你的胯部。  我的"}]
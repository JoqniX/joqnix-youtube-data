[{"type": "subtitle", "time": 10815.63, "timestamp": "03:00:15", "text": "感謝你一路陪伴我。起床。"}, {"type": "subtitle", "time": 10822.07, "timestamp": "03:00:22", "text": "我的天哪，我當時在桌子"}, {"type": "subtitle", "time": 10833.429, "timestamp": "03:00:33", "text": "音樂男孩。呃，"}, {"type": "subtitle", "time": 10842.79, "timestamp": "03:00:42", "text": "請稍等片刻。"}, {"type": "subtitle", "time": 10847.269, "timestamp": "03:00:47", "text": "你好。對了，她爬完這座山後做出了一個大膽的決定，她要向西攀登，就在那時，她"}]
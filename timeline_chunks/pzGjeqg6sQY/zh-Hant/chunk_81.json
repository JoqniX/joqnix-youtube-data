[{"type": "subtitle", "time": 4867.75, "timestamp": "01:21:07", "text": "。你最常玩的遊戲是什麼？呃，"}, {"type": "subtitle", "time": 4872.03, "timestamp": "01:21:12", "text": "我其實不知道。我的意思是，這要看情況。這取決於具體情況。"}, {"type": "subtitle", "time": 4882.63, "timestamp": "01:21:22", "text": "嗯，這主要取決於情況。例如，我只"}, {"type": "subtitle", "time": 4884.709, "timestamp": "01:21:24", "text": "喜歡多人遊戲，如果"}, {"type": "subtitle", "time": 4887.35, "timestamp": "01:21:27", "text": "有活動或其他什麼活動，"}, {"type": "subtitle", "time": 4890.709, "timestamp": "01:21:30", "text": "我會努力參與並完成它們，"}, {"type": "subtitle", "time": 4892.35, "timestamp": "01:21:32", "text": "大概就是"}, {"type": "subtitle", "time": 4895.87, "timestamp": "01:21:35", "text": "這樣。不過，"}, {"type": "subtitle", "time": 4899.07, "timestamp": "01:21:39", "text": "我不知道我最喜歡的遊戲是什麼，因為"}, {"type": "subtitle", "time": 4902.189, "timestamp": "01:21:42", "text": "我玩的所有遊戲都"}, {"type": "subtitle", "time": 4910.11, "timestamp": "01:21:50", "text": "喜歡的，畢竟「最喜歡的遊戲」就是你最喜歡的"}, {"type": "subtitle", "time": 4913.83, "timestamp": "01:21:53", "text": "遊戲。好的。是的，Calibio。我一直很"}, {"type": "subtitle", "time": 4917.11, "timestamp": "01:21:57", "text": "喜歡加州灣區。是的，因為這是我玩的"}]
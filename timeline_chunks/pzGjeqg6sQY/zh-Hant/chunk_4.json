[{"type": "subtitle", "time": 246.71, "timestamp": "00:04:06", "text": "[音樂]"}, {"type": "subtitle", "time": 249.75, "timestamp": "00:04:09", "text": "今天我將向大家簡單介紹一下"}, {"type": "subtitle", "time": 260.789, "timestamp": "00:04:20", "text": "今天要做的事情。首先，我們會做一些"}, {"type": "subtitle", "time": 263.629, "timestamp": "00:04:23", "text": "網站相關的工作。"}, {"type": "subtitle", "time": 267.749, "timestamp": "00:04:27", "text": "二。嗯，我今天打算翹掉"}, {"type": "subtitle", "time": 269.79, "timestamp": "00:04:29", "text": "音樂課"}, {"type": "subtitle", "time": 272.79, "timestamp": "00:04:32", "text": "。嗯，因為我有個會議要"}, {"type": "subtitle", "time": 273.629, "timestamp": "00:04:33", "text": "參加，"}, {"type": "subtitle", "time": 278.31, "timestamp": "00:04:38", "text": "時間跟"}, {"type": "subtitle", "time": 284.07, "timestamp": "00:04:44", "text": "我的音樂課有點衝突。所以，我必須"}, {"type": "subtitle", "time": 288.909, "timestamp": "00:04:48", "text": "完成這件事。所以，我不得不這麼做。"}, {"type": "subtitle", "time": 293.87, "timestamp": "00:04:53", "text": "我必須去做。是的。"}, {"type": "subtitle", "time": 296.51, "timestamp": "00:04:56", "text": "然後，"}]
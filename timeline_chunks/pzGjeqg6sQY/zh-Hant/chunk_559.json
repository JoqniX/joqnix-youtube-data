[{"type": "subtitle", "time": 33556.87, "timestamp": "09:19:16", "text": "我好像忘了關食物了。對，就是這樣。現在它不見了。哇。  是的。  好的。  那麼，我想，我們現在就"}, {"type": "subtitle", "time": 33563.35, "timestamp": "09:19:23", "text": "走吧。是的。  哦。呃，選擇地圖。  呃，"}, {"type": "subtitle", "time": 33567.79, "timestamp": "09:19:27", "text": "你想要第一張地圖還是最後一張"}, {"type": "subtitle", "time": 33570.79, "timestamp": "09:19:30", "text": "？我的意思是，"}, {"type": "subtitle", "time": 33579.51, "timestamp": "09:19:39", "text": "你可以選擇新地圖。  這還挺"}]
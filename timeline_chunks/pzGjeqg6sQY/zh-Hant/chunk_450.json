[{"type": "subtitle", "time": 27007.708, "timestamp": "07:30:07", "text": "呃，"}, {"type": "subtitle", "time": 27016.15, "timestamp": "07:30:16", "text": "恐音症，呃，麥克風"}, {"type": "subtitle", "time": 27020.07, "timestamp": "07:30:20", "text": "。參量式麥克風。  這就是你需要的。偏執狂。  這裡有一台攝影機。哦，原來是這樣。這件令人感到恐懼的事。我拿到莎莎醬了。我沒錢買。我覺得你得買它。  但我沒錢"}, {"type": "subtitle", "time": 27039.19, "timestamp": "07:30:39", "text": "但我們從哪裡弄到鹽呢"}, {"type": "subtitle", "time": 27050.23, "timestamp": "07:30:50", "text": "等等，那如果"}, {"type": "subtitle", "time": 27053.83, "timestamp": "07:30:53", "text": "我們賣點東西呢？  是的，我們可以"}, {"type": "subtitle", "time": 27057.948, "timestamp": "07:30:57", "text": "賣東西"}]
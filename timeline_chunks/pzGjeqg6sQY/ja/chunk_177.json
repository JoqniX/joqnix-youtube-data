[{"type": "subtitle", "time": 10622.79, "timestamp": "02:57:02", "text": "努力して、彼女はただ"}, {"type": "subtitle", "time": 10624.349, "timestamp": "02:57:04", "text": "私を働かせ続けてください"}, {"type": "subtitle", "time": 10627.75, "timestamp": "02:57:07", "text": "難しい。彼女は、"}, {"type": "subtitle", "time": 10630.389, "timestamp": "02:57:10", "text": "私は自分自身を見た。"}, {"type": "subtitle", "time": 10632.349, "timestamp": "02:57:12", "text": "彼女がかつて"}, {"type": "subtitle", "time": 10634.24, "timestamp": "02:57:14", "text": "「運は"}, {"type": "subtitle", "time": 10636.03, "timestamp": "02:57:16", "text": "[音楽]"}, {"type": "subtitle", "time": 10638.469, "timestamp": "02:57:18", "text": "あなたの成功を左右する決定要因ですが、"}, {"type": "subtitle", "time": 10640.59, "timestamp": "02:57:20", "text": "あなた"}, {"type": "subtitle", "time": 10649.03, "timestamp": "02:57:29", "text": "正直。理解するのを手伝ってくれてありがとう"}, {"type": "subtitle", "time": 10651.269, "timestamp": "02:57:31", "text": "妹の考え。手伝ってくれてありがとう"}, {"type": "subtitle", "time": 10652.95, "timestamp": "02:57:32", "text": "私は妹のことを理解している。私は"}, {"type": "subtitle", "time": 10655.429, "timestamp": "02:57:35", "text": "彼女への言葉は心に響き、歓迎される"}, {"type": "subtitle", "time": 10657.99, "timestamp": "02:57:37", "text": "私の人生の新たな章が素晴らしい"}, {"type": "subtitle", "time": 10666.269, "timestamp": "02:57:46", "text": "ずっと付き添ってくれてありがとう"}, {"type": "subtitle", "time": 10669.03, "timestamp": "02:57:49", "text": "方法。起きる。ああ、なんてことだ、私は下だった"}, {"type": "subtitle", "time": 10672.19, "timestamp": "02:57:52", "text": "テーブル。ああ、神様、私は"}, {"type": "subtitle", "time": 10675.99, "timestamp": "02:57:55", "text": "読む。私は自分がtのようになったのが大好きです"}, {"type": "subtitle", "time": 10678.11, "timestamp": "02:57:58", "text": "カメのように"}]
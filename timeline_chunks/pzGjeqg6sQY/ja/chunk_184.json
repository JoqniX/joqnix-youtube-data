[{"type": "subtitle", "time": 11040.309, "timestamp": "03:04:00", "text": "うん、明日1 2 3 4 5するよ"}, {"type": "subtitle", "time": 11041.07, "timestamp": "03:04:01", "text": "12"}, {"type": "subtitle", "time": 11046.389, "timestamp": "03:04:06", "text": "1時間でヘッドハンティングを完全に完了させる。"}, {"type": "subtitle", "time": 11048.91, "timestamp": "03:04:08", "text": "うん、クエストをやろう"}, {"type": "subtitle", "time": 11051.87, "timestamp": "03:04:11", "text": "など。また、"}, {"type": "subtitle", "time": 11054.71, "timestamp": "03:04:14", "text": "これ？中にあると思う。そうそう。"}, {"type": "subtitle", "time": 11057.75, "timestamp": "03:04:17", "text": "クエストライン全体がある"}, {"type": "subtitle", "time": 11060.51, "timestamp": "03:04:20", "text": "まるで百万を見つけるように"}, {"type": "subtitle", "time": 11063.349, "timestamp": "03:04:23", "text": "何か。うん。うん。うん。よし。"}, {"type": "subtitle", "time": 11066.11, "timestamp": "03:04:26", "text": "それは明日やります。"}, {"type": "subtitle", "time": 11069.95, "timestamp": "03:04:29", "text": "わかった。それ以外は全て順調です。"}, {"type": "subtitle", "time": 11072.71, "timestamp": "03:04:32", "text": "推測。私たちは多くのことを成し遂げました。私たちは"}, {"type": "subtitle", "time": 11075.07, "timestamp": "03:04:35", "text": "実際私たちは"}, {"type": "subtitle", "time": 11077.389, "timestamp": "03:04:37", "text": "多く。では、行く"}, {"type": "subtitle", "time": 11086.469, "timestamp": "03:04:46", "text": "良い。そして私は自分がしたようなことはしたくない"}, {"type": "subtitle", "time": 11089.87, "timestamp": "03:04:49", "text": "今日。配信中に寝たくない。"}, {"type": "subtitle", "time": 11092.91, "timestamp": "03:04:52", "text": "ええ、そうですね。そして"}, {"type": "subtitle", "time": 11095.91, "timestamp": "03:04:55", "text": "今日起こったことは教訓となるだろう"}, {"type": "subtitle", "time": 11098.79, "timestamp": "03:04:58", "text": "特にビリー・ビリーについて。私はします"}]
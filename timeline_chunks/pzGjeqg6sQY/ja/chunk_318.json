[{"type": "subtitle", "time": 19081.19, "timestamp": "05:18:01", "text": "タコス。それは私の夢のゲームの一つです"}, {"type": "subtitle", "time": 19083.15, "timestamp": "05:18:03", "text": "遊びたい"}, {"type": "subtitle", "time": 19086.35, "timestamp": "05:18:06", "text": "いつかはそうなるだろうが、それはサブスクリプションベースだ"}, {"type": "subtitle", "time": 19088.55, "timestamp": "05:18:08", "text": "ゲーム。シューティングゲームみたいだ。残念ながら、私は"}, {"type": "subtitle", "time": 19090.51, "timestamp": "05:18:10", "text": "主にサバイバル用モップRG"}, {"type": "subtitle", "time": 19093.948, "timestamp": "05:18:13", "text": "ゲーム。私も。私もMOが好きです"}, {"type": "subtitle", "time": 19097.19, "timestamp": "05:18:17", "text": "RPG。 Gを見つけなきゃ。"}, {"type": "subtitle", "time": 19100.31, "timestamp": "05:18:20", "text": "ファイナルファンタジー14をプレイしたいのですが、"}, {"type": "subtitle", "time": 19117.59, "timestamp": "05:18:37", "text": "わかった。えっと。ああ、ミツクはゾンビをストリーミング配信している"}, {"type": "subtitle", "time": 19120.948, "timestamp": "05:18:40", "text": "ワールドウォーZを狩る。ちくしょう。ああ、これらは"}, {"type": "subtitle", "time": 19124.708, "timestamp": "05:18:44", "text": "男たちはDlightをプレイしている。ニース。おい、"}, {"type": "subtitle", "time": 19127.708, "timestamp": "05:18:47", "text": "この人は誰ですか？は"}, {"type": "subtitle", "time": 19130.55, "timestamp": "05:18:50", "text": "そんなにいいの？待って、誰だと思うか当ててみよう"}, {"type": "subtitle", "time": 19134.55, "timestamp": "05:18:54", "text": "これらは？ドラッグノワール ナツキ・シビルと私"}]
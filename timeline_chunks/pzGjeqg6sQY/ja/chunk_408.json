[{"type": "subtitle", "time": 24482.67, "timestamp": "06:48:02", "text": "私たちの、待って、つまり次の"}, {"type": "subtitle", "time": 24487.35, "timestamp": "06:48:07", "text": "シーズンレガシー、壮大なレガシーシーズン。何ですか"}, {"type": "subtitle", "time": 24490.948, "timestamp": "06:48:10", "text": "シーズン番号をもう一度？ナン・レガシーは"}, {"type": "subtitle", "time": 24493.548, "timestamp": "06:48:13", "text": "リリースされる"}, {"type": "subtitle", "time": 24497.03, "timestamp": "06:48:17", "text": "リリース時にはインドでリリースされます"}, {"type": "subtitle", "time": 24501.39, "timestamp": "06:48:21", "text": "私たちの私の時間"}, {"type": "subtitle", "time": 24506.51, "timestamp": "06:48:26", "text": "午後10時30分午後10時30分H. それは"}, {"type": "subtitle", "time": 24510.35, "timestamp": "06:48:30", "text": "つまり、変更する必要があるかもしれない"}, {"type": "subtitle", "time": 24514.07, "timestamp": "06:48:34", "text": "私たちは変更する必要があるかもしれません"}, {"type": "subtitle", "time": 24517.03, "timestamp": "06:48:37", "text": "あれ。えーと、この物、出口"}, {"type": "subtitle", "time": 24519.99, "timestamp": "06:48:39", "text": "脱出ルートの最終部分、パート2。それで"}, {"type": "subtitle", "time": 24523.548, "timestamp": "06:48:43", "text": "ええと、時間を11時から変更する必要があります"}, {"type": "subtitle", "time": 24529.39, "timestamp": "06:48:49", "text": "午後明日早朝"}, {"type": "subtitle", "time": 24532.548, "timestamp": "06:48:52", "text": "6つくらい。えっと、私は"}, {"type": "subtitle", "time": 24535.99, "timestamp": "06:48:55", "text": "ストリームでアップデートをダウンロードできます"}, {"type": "subtitle", "time": 24539.03, "timestamp": "06:48:59", "text": "だって、新しいシーズンのアップデートは100％確実だから"}]
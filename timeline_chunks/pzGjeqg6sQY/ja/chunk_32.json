[{"type": "subtitle", "time": 1930.11, "timestamp": "00:32:10", "text": "待って。"}, {"type": "subtitle", "time": 1932.71, "timestamp": "00:32:12", "text": "何？何？それは宝箱のはず"}, {"type": "subtitle", "time": 1935.789, "timestamp": "00:32:15", "text": "しかし、そうではない"}, {"type": "subtitle", "time": 1939.07, "timestamp": "00:32:19", "text": "蝶。どの地域が"}, {"type": "subtitle", "time": 1949.99, "timestamp": "00:32:29", "text": "あ、待って、待って、待って、待って、待って。いいえ。"}, {"type": "subtitle", "time": 1951.669, "timestamp": "00:32:31", "text": "いや、いや、いや、いや、いや、いや、いや、"}, {"type": "subtitle", "time": 1953.75, "timestamp": "00:32:33", "text": "いいえ。それではない。それではない。"}, {"type": "subtitle", "time": 1964.31, "timestamp": "00:32:44", "text": "完了とマークしたのに、"}, {"type": "subtitle", "time": 1971.789, "timestamp": "00:32:51", "text": "何？限定"}, {"type": "subtitle", "time": 1974.95, "timestamp": "00:32:54", "text": "トライアル。楽しいとマークしたけど、"}]
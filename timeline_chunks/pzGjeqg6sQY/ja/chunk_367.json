[{"type": "subtitle", "time": 22027.43, "timestamp": "06:07:07", "text": "今私が欲しいのは、"}, {"type": "subtitle", "time": 22031.35, "timestamp": "06:07:11", "text": "ストリームのコレクションは、"}, {"type": "subtitle", "time": 22035.51, "timestamp": "06:07:15", "text": "最新のストリームがリストに追加されました"}, {"type": "subtitle", "time": 22038.708, "timestamp": "06:07:18", "text": "スクロールしてどれが"}, {"type": "subtitle", "time": 22041.83, "timestamp": "06:07:21", "text": "最新の10個か何か"}, {"type": "subtitle", "time": 22044.47, "timestamp": "06:07:24", "text": "それ。それが良い考えかどうかはわかりません"}, {"type": "subtitle", "time": 22046.11, "timestamp": "06:07:26", "text": "私の"}, {"type": "subtitle", "time": 22048.628, "timestamp": "06:07:28", "text": "はい。そして、もしあなたがこのことを疑問に思っているなら、"}, {"type": "subtitle", "time": 22050.91, "timestamp": "06:07:30", "text": "この効果はカスタムコードです"}, {"type": "subtitle", "time": 22054.628, "timestamp": "06:07:34", "text": "以前は、このためにGPTを使用する必要がありました。"}, {"type": "subtitle", "time": 22056.51, "timestamp": "06:07:36", "text": "アニメーションエンジンが登場"}, {"type": "subtitle", "time": 22059.75, "timestamp": "06:07:39", "text": "外。だから、これを再現できると思う"}, {"type": "subtitle", "time": 22061.948, "timestamp": "06:07:41", "text": "今すぐ有効です。"}, {"type": "subtitle", "time": 22065.47, "timestamp": "06:07:45", "text": "そしてこれは視差効果です"}, {"type": "subtitle", "time": 22068.868, "timestamp": "06:07:48", "text": "正しい。これを再現するには"}, {"type": "subtitle", "time": 22071.59, "timestamp": "06:07:51", "text": "アニメーションエンジンも同様です。"}, {"type": "subtitle", "time": 22073.91, "timestamp": "06:07:53", "text": "しかし、私が再現できない唯一のものは"}, {"type": "subtitle", "time": 22075.868, "timestamp": "06:07:55", "text": "感じる"}, {"type": "subtitle", "time": 22079.19, "timestamp": "06:07:59", "text": "ズームインとズームアウトの機能"}]
[{"type": "subtitle", "time": 12122.349, "timestamp": "03:22:02", "text": "いいえ。いいえ。あれが最後でした。"}, {"type": "subtitle", "time": 12129.309, "timestamp": "03:22:09", "text": "それが私の最後だった"}, {"type": "subtitle", "time": 12138.83, "timestamp": "03:22:18", "text": "土尾、私は"}, {"type": "subtitle", "time": 12141.91, "timestamp": "03:22:21", "text": "それは価値があると思いますか？いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 12146.469, "timestamp": "03:22:26", "text": "いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ。"}, {"type": "subtitle", "time": 12152.51, "timestamp": "03:22:32", "text": "アステリス。そうすべきではない。私はスキップします"}, {"type": "subtitle", "time": 12163.15, "timestamp": "03:22:43", "text": "私？それは"}, {"type": "subtitle", "time": 12166.349, "timestamp": "03:22:46", "text": "わかった？ 60は多い"}, {"type": "subtitle", "time": 12174.91, "timestamp": "03:22:54", "text": "けれど。または、丁寧に"}, {"type": "subtitle", "time": 12179.11, "timestamp": "03:22:59", "text": "ちょっと待って。私は本当にしたくない"}]
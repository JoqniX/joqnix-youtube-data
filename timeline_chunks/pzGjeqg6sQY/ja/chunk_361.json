[{"type": "subtitle", "time": 21663.03, "timestamp": "06:01:03", "text": "ブレンド。ぼかしはどうやってやるの？"}, {"type": "subtitle", "time": 21679.47, "timestamp": "06:01:19", "text": "背景をぼかすモード。"}, {"type": "subtitle", "time": 21686.83, "timestamp": "06:01:26", "text": "どうやって"}, {"type": "subtitle", "time": 21691.03, "timestamp": "06:01:31", "text": "それ？それは左にスライドします。左から"}, {"type": "subtitle", "time": 21709.19, "timestamp": "06:01:49", "text": "[音楽]"}, {"type": "subtitle", "time": 21711.99, "timestamp": "06:01:51", "text": "ここにあってほしくない。もし私がそうしたらどうなる？"}, {"type": "subtitle", "time": 21718.548, "timestamp": "06:01:58", "text": "ここ？それは浮き沈みがある。どうすればいいですか"}]
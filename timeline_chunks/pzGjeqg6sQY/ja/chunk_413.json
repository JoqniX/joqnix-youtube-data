[{"type": "subtitle", "time": 24780.99, "timestamp": "06:53:00", "text": "直前のゲスト。"}, {"type": "subtitle", "time": 24784.468, "timestamp": "06:53:04", "text": "今日は楽しかったみたいだ。私は行った"}, {"type": "subtitle", "time": 24786.788, "timestamp": "06:53:06", "text": "えっと、友達と映画に行く"}, {"type": "subtitle", "time": 24790.15, "timestamp": "06:53:10", "text": "今日。私たちの友人。それはいいですね。"}, {"type": "subtitle", "time": 24795.67, "timestamp": "06:53:15", "text": "うん。うん。私にも生きさせてください。"}, {"type": "subtitle", "time": 24797.99, "timestamp": "06:53:17", "text": "わかった。"}, {"type": "subtitle", "time": 24801.03, "timestamp": "06:53:21", "text": "何てことだ。何てことだ。ひどく傷だらけだ。"}, {"type": "subtitle", "time": 24803.43, "timestamp": "06:53:23", "text": "何てことだ。待って、彼の声が聞こえる？全て"}, {"type": "subtitle", "time": 24805.91, "timestamp": "06:53:25", "text": "そうですね。皆さん、お待ちください。私にさせて"}, {"type": "subtitle", "time": 24808.468, "timestamp": "06:53:28", "text": "自分自身を省みる。あ、待って。ああ、そうだよ。"}, {"type": "subtitle", "time": 24819.59, "timestamp": "06:53:39", "text": "待って。では、今日の気分はどうですか？"}, {"type": "subtitle", "time": 24822.31, "timestamp": "06:53:42", "text": "私の恐怖症？良い。ご気分はいかがですか？私"}, {"type": "subtitle", "time": 24824.868, "timestamp": "06:53:44", "text": "めちゃくちゃ怖い。あなたは怖がっています"}, {"type": "subtitle", "time": 24827.99, "timestamp": "06:53:47", "text": "くそ。ああ、神様。待って。待って。私はまるで"}, {"type": "subtitle", "time": 24830.548, "timestamp": "06:53:50", "text": "臆病者。ホラーはできない"}, {"type": "subtitle", "time": 24832.788, "timestamp": "06:53:52", "text": "そして私はこれがきっかけでこのゲームを手に入れた"}, {"type": "subtitle", "time": 24835.83, "timestamp": "06:53:55", "text": "コラボレーション。同じ。私もそのゲームを手に入れました"}]
[{"type": "subtitle", "time": 8834.27, "timestamp": "02:27:14", "text": "あなた。よし、これから書くよ"}, {"type": "subtitle", "time": 8837.15, "timestamp": "02:27:17", "text": "理由。私はしません"}, {"type": "subtitle", "time": 8864.469, "timestamp": "02:27:44", "text": "こんにちは。それで、それで、チラン、私は"}, {"type": "subtitle", "time": 8866.23, "timestamp": "02:27:46", "text": "あなたの名前を正しく発音できますか？こんにちは、"}, {"type": "subtitle", "time": 8867.53, "timestamp": "02:27:47", "text": "ストリームへようこそ。こんにちは。"}, {"type": "subtitle", "time": 8869.71, "timestamp": "02:27:49", "text": "[音楽]"}, {"type": "subtitle", "time": 8872.27, "timestamp": "02:27:52", "text": "こんにちは。こんにちは。"}, {"type": "subtitle", "time": 8877.309, "timestamp": "02:27:57", "text": "いらっしゃいませ。では、待ってください。もしGFXの1つが"}]
[{"type": "subtitle", "time": 12540.95, "timestamp": "03:29:00", "text": "60まで上げる。明日そうするよ。"}, {"type": "subtitle", "time": 12542.469, "timestamp": "03:29:02", "text": "私は推測する。うん。うん。うん。明日"}, {"type": "subtitle", "time": 12544.63, "timestamp": "03:29:04", "text": "そうします。うん。私はすべてを作ります"}, {"type": "subtitle", "time": 12552.03, "timestamp": "03:29:12", "text": "こんにちは。明日"}, {"type": "subtitle", "time": 12555.349, "timestamp": "03:29:15", "text": "私たちはこれらのサイドを終わらせようとします"}, {"type": "subtitle", "time": 12557.07, "timestamp": "03:29:17", "text": "残りのクエスト数。"}, {"type": "subtitle", "time": 12560.87, "timestamp": "03:29:20", "text": "わかった。そして、私たちは"}, {"type": "subtitle", "time": 12563.309, "timestamp": "03:29:23", "text": "タイガー、もっと私のもの、"}, {"type": "subtitle", "time": 12566.11, "timestamp": "03:29:26", "text": "などなど。ええ、そうですね。"}, {"type": "subtitle", "time": 12568.19, "timestamp": "03:29:28", "text": "こんにちは。"}, {"type": "subtitle", "time": 12585.51, "timestamp": "03:29:45", "text": "いい場所を探させてください。ええ、これは"}, {"type": "subtitle", "time": 12593.71, "timestamp": "03:29:53", "text": "場所。みんな、見せてあげよう。今日は"}, {"type": "subtitle", "time": 12596.87, "timestamp": "03:29:56", "text": "それには大いに関係がある。私は実際にそれを終わらせます"}]
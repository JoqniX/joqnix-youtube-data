[{"type": "subtitle", "time": 18482.628, "timestamp": "05:08:02", "text": "タイトルの通り、作業を進めます"}, {"type": "subtitle", "time": 18486.59, "timestamp": "05:08:06", "text": "ウェブサイト関連の作業に取り組みたい"}, {"type": "subtitle", "time": 18489.708, "timestamp": "05:08:09", "text": "今日は少し"}, {"type": "subtitle", "time": 18491.74, "timestamp": "05:08:11", "text": "ビットと"}, {"type": "subtitle", "time": 18503.39, "timestamp": "05:08:23", "text": "うん、そう思う"}, {"type": "subtitle", "time": 18506.51, "timestamp": "05:08:26", "text": "えーと"}, {"type": "subtitle", "time": 18509.99, "timestamp": "05:08:29", "text": "ショットを飲む。注射じゃないよ。私たちはそうします"}, {"type": "subtitle", "time": 18531.67, "timestamp": "05:08:51", "text": "[音楽]"}, {"type": "subtitle", "time": 18536.39, "timestamp": "05:08:56", "text": "だから私は5時半か6時半前に出発します"}, {"type": "subtitle", "time": 18538.99, "timestamp": "05:08:58", "text": "6時数分前。"}]
[{"type": "subtitle", "time": 12842.55, "timestamp": "03:34:02", "text": "Vishiが使えないので、読書をしているかもしれません"}, {"type": "subtitle", "time": 12848.389, "timestamp": "03:34:08", "text": "チャット、えーと、私の他のモンで、私の"}, {"type": "subtitle", "time": 12851.11, "timestamp": "03:34:11", "text": "Vishiをストリーミング配信する。そうですね、では"}, {"type": "subtitle", "time": 12853.269, "timestamp": "03:34:13", "text": "本日開始。だから、"}, {"type": "subtitle", "time": 12854.99, "timestamp": "03:34:14", "text": "来る"}, {"type": "subtitle", "time": 12867.349, "timestamp": "03:34:27", "text": "はい。こんにちは。では、ちょっと待ってください。聞きたいですか"}, {"type": "subtitle", "time": 12871.11, "timestamp": "03:34:31", "text": "ダウンロードせずにどのように聞こえるか"}, {"type": "subtitle", "time": 12893.11, "timestamp": "03:34:53", "text": "1. 音はこんな感じです。ご覧のとおり"}, {"type": "subtitle", "time": 12895.07, "timestamp": "03:34:55", "text": "うるさい"}]
[{"type": "subtitle", "time": 860.31, "timestamp": "00:14:20", "text": "彼女。見せてはいけないことは分かっています"}, {"type": "subtitle", "time": 862.629, "timestamp": "00:14:22", "text": "私のこの側面ですが、ストリーミング配信しています"}, {"type": "subtitle", "time": 867.069, "timestamp": "00:14:27", "text": "24時間。そう願っています。私に"}, {"type": "subtitle", "time": 870.389, "timestamp": "00:14:30", "text": "例外。私はストリーミングしたくない"}, {"type": "subtitle", "time": 877.28, "timestamp": "00:14:37", "text": "なぜ私は眠れないのでしょうか"}, {"type": "subtitle", "time": 878.91, "timestamp": "00:14:38", "text": "[音楽]"}, {"type": "subtitle", "time": 883.23, "timestamp": "00:14:43", "text": "夜？昨日私は"}, {"type": "subtitle", "time": 886.389, "timestamp": "00:14:46", "text": "私は電話をしまい、"}, {"type": "subtitle", "time": 887.55, "timestamp": "00:14:47", "text": "まだ"}, {"type": "subtitle", "time": 890.03, "timestamp": "00:14:50", "text": "3時に退屈"}, {"type": "subtitle", "time": 893.269, "timestamp": "00:14:53", "text": "午前中に私は「いや、どうして私は落ちないんだろう」と思った。"}, {"type": "subtitle", "time": 895.67, "timestamp": "00:14:55", "text": "眠っている？\""}]
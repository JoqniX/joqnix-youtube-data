[{"type": "subtitle", "time": 6262.07, "timestamp": "01:44:22", "text": "胸？私はこの胸を2時間抱えています。 1つ"}, {"type": "subtitle", "time": 6265.31, "timestamp": "01:44:25", "text": "胸部が1つ。私は"}, {"type": "subtitle", "time": 6283.95, "timestamp": "01:44:43", "text": "えっと、私に何を期待してるんですか？"}, {"type": "subtitle", "time": 6287.35, "timestamp": "01:44:47", "text": "言う？もしそのメッセージがそこにあったら、私は"}, {"type": "subtitle", "time": 6290.629, "timestamp": "01:44:50", "text": "送らないでほしいとお願いするつもりです。言う"}, {"type": "subtitle", "time": 6293.03, "timestamp": "01:44:53", "text": "他のストリーマーについて話すと、"}, {"type": "subtitle", "time": 6296.95, "timestamp": "01:44:56", "text": "それらについて言及してください。でも、そういう意味では、私は"}]
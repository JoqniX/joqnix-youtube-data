[{"type": "subtitle", "time": 23163.27, "timestamp": "06:26:03", "text": "多分。右。だから、それを使うなら"}, {"type": "subtitle", "time": 23164.91, "timestamp": "06:26:04", "text": "他の"}, {"type": "subtitle", "time": 23166.83, "timestamp": "06:26:06", "text": "画像"}, {"type": "subtitle", "time": 23169.31, "timestamp": "06:26:09", "text": "これですか"}, {"type": "subtitle", "time": 23171.948, "timestamp": "06:26:11", "text": "1つ置いて"}, {"type": "subtitle", "time": 23193.948, "timestamp": "06:26:33", "text": "恐怖。これらを削除します"}, {"type": "subtitle", "time": 23197.23, "timestamp": "06:26:37", "text": "良い。埋める"}, {"type": "subtitle", "time": 23202.27, "timestamp": "06:26:42", "text": "影響を受け、それを次のように記述する必要があるかもしれません"}, {"type": "subtitle", "time": 23205.628, "timestamp": "06:26:45", "text": "おそらく含まれている。"}, {"type": "subtitle", "time": 23209.03, "timestamp": "06:26:49", "text": "いいえ。オブジェクトの位置を変更できますか？"}, {"type": "subtitle", "time": 23211.07, "timestamp": "06:26:51", "text": "いいえ、できません。"}, {"type": "subtitle", "time": 23213.0, "timestamp": "06:26:53", "text": "わかった。"}, {"type": "subtitle", "time": 23219.75, "timestamp": "06:26:59", "text": "ええと、これは私がコントロールできます。私は置くことができます"}]
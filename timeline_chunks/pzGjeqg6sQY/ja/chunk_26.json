[{"type": "subtitle", "time": 1569.63, "timestamp": "00:26:09", "text": "重ねてお詫び申し上げます。私の"}, {"type": "subtitle", "time": 1585.149, "timestamp": "00:26:25", "text": "va."}, {"type": "subtitle", "time": 1588.47, "timestamp": "00:26:28", "text": "これらすべてのスキャンの後、私が見逃したことを想像してみてください"}, {"type": "subtitle", "time": 1590.51, "timestamp": "00:26:30", "text": "小さな"}, {"type": "subtitle", "time": 1599.11, "timestamp": "00:26:39", "text": "何か。そんなことしないわけがない"}, {"type": "subtitle", "time": 1601.029, "timestamp": "00:26:41", "text": "これを終わらせてください。これ、ちゃんと終わらせました。私"}, {"type": "subtitle", "time": 1603.64, "timestamp": "00:26:43", "text": "これを覚えておいてください。"}, {"type": "subtitle", "time": 1617.789, "timestamp": "00:26:57", "text": "そうしなくても構いません"}]
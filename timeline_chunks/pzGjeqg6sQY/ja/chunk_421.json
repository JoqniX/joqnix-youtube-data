[{"type": "subtitle", "time": 25260.27, "timestamp": "07:01:00", "text": "午前"}, {"type": "subtitle", "time": 25262.708, "timestamp": "07:01:02", "text": "こんにちは。なんて言えばいいの？私"}, {"type": "subtitle", "time": 25270.948, "timestamp": "07:01:10", "text": "こんにちは。うん。こんにちは。私はジョーです。次。こんにちは。"}, {"type": "subtitle", "time": 25273.19, "timestamp": "07:01:13", "text": "こんにちは、Joknixさん。"}, {"type": "subtitle", "time": 25276.868, "timestamp": "07:01:16", "text": "はい。これは何ですか？これは何ですか？何ですか"}, {"type": "subtitle", "time": 25280.31, "timestamp": "07:01:20", "text": "私の画面に？待って、もしかしてあなた？それは"}, {"type": "subtitle", "time": 25282.708, "timestamp": "07:01:22", "text": "あなた？そうそう。君だよ。それは私が"}, {"type": "subtitle", "time": 25285.51, "timestamp": "07:01:25", "text": "例えば、私の画面には何が表示されているの？待って、待って。"}, {"type": "subtitle", "time": 25288.788, "timestamp": "07:01:28", "text": "あなたのロビーに参加しました。おお、いいね。ニース。"}, {"type": "subtitle", "time": 25291.83, "timestamp": "07:01:31", "text": "うん。ああ、大変だ。このゲームがどうなっているのかわかりません"}, {"type": "subtitle", "time": 25293.51, "timestamp": "07:01:33", "text": "機能するけど、まあね。難易度は"}, {"type": "subtitle", "time": 25295.27, "timestamp": "07:01:35", "text": "アマチュア。ああ、それだ。ああ、あなたは"}, {"type": "subtitle", "time": 25298.39, "timestamp": "07:01:38", "text": "おばあさん。あなたは年寄りですね、ああ、なんてことだ。"}, {"type": "subtitle", "time": 25302.07, "timestamp": "07:01:42", "text": "あなたは全部参加しています。待って、私は参加しています。私は変わることができる"}, {"type": "subtitle", "time": 25305.83, "timestamp": "07:01:45", "text": "けれど。そうそう。あなたはできる。私はあなたの"}, {"type": "subtitle", "time": 25309.51, "timestamp": "07:01:49", "text": "部屋。ええ、あなたは私の部屋にいるんです。"}, {"type": "subtitle", "time": 25311.548, "timestamp": "07:01:51", "text": "こんにちは。"}, {"type": "subtitle", "time": 25315.27, "timestamp": "07:01:55", "text": "準備ができていません。準備ができていません。どのように準備すればいいですか？"}, {"type": "subtitle", "time": 25317.67, "timestamp": "07:01:57", "text": "準備ができません。ああ、準備しないといけない"}]
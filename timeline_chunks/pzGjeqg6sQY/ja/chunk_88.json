[{"type": "subtitle", "time": 5303.07, "timestamp": "01:28:23", "text": "18. クエストは何もやらなかった"}, {"type": "subtitle", "time": 5305.229, "timestamp": "01:28:25", "text": "まだ。私"}, {"type": "subtitle", "time": 5309.45, "timestamp": "01:28:29", "text": "仕上がりが気に入った"}, {"type": "subtitle", "time": 5326.07, "timestamp": "01:28:46", "text": "ええ、サイドクエストをやりました。"}, {"type": "subtitle", "time": 5329.629, "timestamp": "01:28:49", "text": "このエリアの壁クエスト"}, {"type": "subtitle", "time": 5333.229, "timestamp": "01:28:53", "text": "この地域。"}]
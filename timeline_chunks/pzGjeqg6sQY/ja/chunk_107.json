[{"type": "subtitle", "time": 6420.79, "timestamp": "01:47:00", "text": "私がビデオを見ていたからでしょうか？"}, {"type": "subtitle", "time": 6428.07, "timestamp": "01:47:08", "text": "ビデオ？ああ、この時点で私は"}, {"type": "subtitle", "time": 6431.39, "timestamp": "01:47:11", "text": "ビリー・ビリーのアカウント。何"}, {"type": "subtitle", "time": 6434.149, "timestamp": "01:47:14", "text": "この時点で、私はビリーを失うだろう"}, {"type": "subtitle", "time": 6437.55, "timestamp": "01:47:17", "text": "ビリーのアカウント。何てことだ。何が"}, {"type": "subtitle", "time": 6445.51, "timestamp": "01:47:25", "text": "これ。いいえ、私に言わないでください。言わないで。"}, {"type": "subtitle", "time": 6447.03, "timestamp": "01:47:27", "text": "まさか禁止令じゃないよね？言わないで"}, {"type": "subtitle", "time": 6456.43, "timestamp": "01:47:36", "text": "禁止。私は信じることに基づいて生きているわけではありません。"}, {"type": "subtitle", "time": 6459.629, "timestamp": "01:47:39", "text": "なぜ？待って、"}, {"type": "subtitle", "time": 6464.229, "timestamp": "01:47:44", "text": "なぜ？お願い、お願い、お願い、お願い。私"}, {"type": "subtitle", "time": 6471.79, "timestamp": "01:47:51", "text": "お願いします。お願い、お願い、お願い、お願い、"}, {"type": "subtitle", "time": 6474.07, "timestamp": "01:47:54", "text": "お願い、お願い、お願い、お願い、お願い"}]
[{"type": "subtitle", "time": 3720.309, "timestamp": "01:02:00", "text": "すると、胸部が手に入ります。でも私にとっては"}, {"type": "subtitle", "time": 3722.549, "timestamp": "01:02:02", "text": "そうではない。"}, {"type": "subtitle", "time": 3724.91, "timestamp": "01:02:04", "text": "2つの立方体"}, {"type": "subtitle", "time": 3730.829, "timestamp": "01:02:10", "text": "引き取り可能。"}, {"type": "subtitle", "time": 3741.349, "timestamp": "01:02:21", "text": "もちろん100％の献身で100％ですが"}, {"type": "subtitle", "time": 3748.109, "timestamp": "01:02:28", "text": "むしろ、そうあるべきなのだ"}, {"type": "subtitle", "time": 3750.03, "timestamp": "01:02:30", "text": "でもでもでもでも"}, {"type": "subtitle", "time": 3753.39, "timestamp": "01:02:33", "text": "しかし1時間"}, {"type": "subtitle", "time": 3756.47, "timestamp": "01:02:36", "text": "29 すみません、このうちの1つが欠けています"}, {"type": "subtitle", "time": 3757.75, "timestamp": "01:02:37", "text": "別のビデオでスピン"}, {"type": "subtitle", "time": 3759.23, "timestamp": "01:02:39", "text": "位置"}, {"type": "subtitle", "time": 3762.23, "timestamp": "01:02:42", "text": "わかった。ああ、ああ、ああ、なんてことだ。そこには"}, {"type": "subtitle", "time": 3765.43, "timestamp": "01:02:45", "text": "実際にはタイムスタンプがあります。何てことだ。"}, {"type": "subtitle", "time": 3768.39, "timestamp": "01:02:48", "text": "何？そして、ピンを更新します"}, {"type": "subtitle", "time": 3771.51, "timestamp": "01:02:51", "text": "両方。それはかなり良いと思います。"}, {"type": "subtitle", "time": 3775.23, "timestamp": "01:02:55", "text": "秘密に"}, {"type": "subtitle", "time": 3777.589, "timestamp": "01:02:57", "text": "ミッション。それは私たちを駆り立てるのに十分でしょう"}]
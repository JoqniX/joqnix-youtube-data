[{"type": "subtitle", "time": 489.98, "timestamp": "00:08:09", "text": "与える"}, {"type": "subtitle", "time": 498.79, "timestamp": "00:08:18", "text": "私はゴーストファイルを入手しました。何てことだ、"}, {"type": "subtitle", "time": 500.909, "timestamp": "00:08:20", "text": "私のところに幽霊が落ちてきた"}, {"type": "subtitle", "time": 524.99, "timestamp": "00:08:44", "text": "あなたを削除することはできない、あるいは削除できる"}, {"type": "subtitle", "time": 527.829, "timestamp": "00:08:47", "text": "ない。ええ、私のファイルエクスプローラーは今"}]
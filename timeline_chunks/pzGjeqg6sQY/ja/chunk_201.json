[{"type": "subtitle", "time": 12076.95, "timestamp": "03:21:16", "text": "ニース。どうしてこんなにたくさんの反響があるんだろう"}, {"type": "subtitle", "time": 12078.59, "timestamp": "03:21:18", "text": "彼"}, {"type": "subtitle", "time": 12080.19, "timestamp": "03:21:20", "text": "今？"}, {"type": "subtitle", "time": 12083.07, "timestamp": "03:21:23", "text": "一貫して。"}, {"type": "subtitle", "time": 12093.269, "timestamp": "03:21:33", "text": "わーい。彼に勝てるかどうかは疑わしい。ああ、私は"}, {"type": "subtitle", "time": 12111.269, "timestamp": "03:21:51", "text": "とにかく、実際に実際に実際に"}, {"type": "subtitle", "time": 12118.83, "timestamp": "03:21:58", "text": "もの。私には足りません。"}]
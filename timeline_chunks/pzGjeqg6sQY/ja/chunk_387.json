[{"type": "subtitle", "time": 23222.788, "timestamp": "06:27:02", "text": "真ん中に置く。だから、もし私が"}, {"type": "subtitle", "time": 23224.67, "timestamp": "06:27:04", "text": "アニメーショングループ"}, {"type": "subtitle", "time": 23231.91, "timestamp": "06:27:11", "text": "これ。ああ、やったと思うよ。私たちは"}, {"type": "subtitle", "time": 23241.73, "timestamp": "06:27:21", "text": "つまり、少しズームインした状態です。"}, {"type": "subtitle", "time": 23249.43, "timestamp": "06:27:29", "text": "右？そして、また元通りになった。私はしません"}, {"type": "subtitle", "time": 23253.28, "timestamp": "06:27:33", "text": "元に戻したい"}, {"type": "subtitle", "time": 23267.708, "timestamp": "06:27:47", "text": "つまり、これはズームインするということです"}, {"type": "subtitle", "time": 23274.03, "timestamp": "06:27:54", "text": "うーん、かなり近いかな。私たちは手に入れています"}, {"type": "subtitle", "time": 23276.39, "timestamp": "06:27:56", "text": "近い。なぜなら、私が見つけなければならないのは"}]
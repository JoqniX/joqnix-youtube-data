[{"type": "subtitle", "time": 20461.75, "timestamp": "05:41:01", "text": "私の別のサーバー。私は送っていません"}, {"type": "subtitle", "time": 20464.47, "timestamp": "05:41:04", "text": "メインサーバーにはまだ接続されていませんが、"}, {"type": "subtitle", "time": 20468.23, "timestamp": "05:41:08", "text": "制限。えっと、私は無料版を使っています"}, {"type": "subtitle", "time": 20471.91, "timestamp": "05:41:11", "text": "あ、待って。何を使っていたんだっけ？私"}, {"type": "subtitle", "time": 20473.788, "timestamp": "05:41:13", "text": "使っていたと思う"}, {"type": "subtitle", "time": 20475.628, "timestamp": "05:41:15", "text": "make.com"}, {"type": "subtitle", "time": 20479.628, "timestamp": "05:41:19", "text": "あれ。えっと、lenを使いたいんだけど"}, {"type": "subtitle", "time": 20482.868, "timestamp": "05:41:22", "text": "ノード、緯度ノード、または何か。彼らは持っている"}, {"type": "subtitle", "time": 20485.19, "timestamp": "05:41:25", "text": "生涯契約バージョンですが、"}, {"type": "subtitle", "time": 20489.19, "timestamp": "05:41:29", "text": "お金。でも、まあ、私が理解する方法では"}, {"type": "subtitle", "time": 20491.99, "timestamp": "05:41:31", "text": "えっと、ちょっと待って、これ見てないの？"}, {"type": "subtitle", "time": 20494.948, "timestamp": "05:41:34", "text": "右？連絡先送信に関する書類を受け取ります"}, {"type": "subtitle", "time": 20498.868, "timestamp": "05:41:38", "text": "この新しいお問い合わせフォームのようなウェブクック"}, {"type": "subtitle", "time": 20503.19, "timestamp": "05:41:43", "text": "メールからの送信タイプ"}, {"type": "subtitle", "time": 20506.35, "timestamp": "05:41:46", "text": "件名とメッセージは、"}, {"type": "subtitle", "time": 20509.35, "timestamp": "05:41:49", "text": "テストを受けて、実際に誰かが"}, {"type": "subtitle", "time": 20512.47, "timestamp": "05:41:52", "text": "AIキャラクターか何かがやった"}, {"type": "subtitle", "time": 20515.11, "timestamp": "05:41:55", "text": "知らないけど、彼らは私がAIだと思っていたらしい"}, {"type": "subtitle", "time": 20517.59, "timestamp": "05:41:57", "text": "キャラクターなので、私は彼らにメールを送り返しました"}, {"type": "subtitle", "time": 20519.75, "timestamp": "05:41:59", "text": "自分で調べなさいという格言"}]
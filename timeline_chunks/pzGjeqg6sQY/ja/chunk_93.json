[{"type": "subtitle", "time": 5583.99, "timestamp": "01:33:03", "text": "知る。まあ、大丈夫だけどね。その"}, {"type": "subtitle", "time": 5585.91, "timestamp": "01:33:05", "text": "今週中に終わるだろう。"}, {"type": "subtitle", "time": 5589.27, "timestamp": "01:33:09", "text": "心配しないで。このシリーズは"}, {"type": "subtitle", "time": 5592.149, "timestamp": "01:33:12", "text": "今週中に終了する。うん。私は"}, {"type": "subtitle", "time": 5594.229, "timestamp": "01:33:14", "text": "全てを終えたら、それを終わらせる"}, {"type": "subtitle", "time": 5597.79, "timestamp": "01:33:17", "text": "すべてです。"}, {"type": "subtitle", "time": 5600.39, "timestamp": "01:33:20", "text": "うん。その後は、"}, {"type": "subtitle", "time": 5608.83, "timestamp": "01:33:28", "text": "それで、"}, {"type": "subtitle", "time": 5611.79, "timestamp": "01:33:31", "text": "こんにちは。こんにちは。自分"}, {"type": "subtitle", "time": 5618.43, "timestamp": "01:33:38", "text": "ビデオ。こんにちは。取る"}, {"type": "subtitle", "time": 5623.149, "timestamp": "01:33:43", "text": "ケア。おやすみなさい"}]
[{"type": "subtitle", "time": 10682.95, "timestamp": "02:58:02", "text": "えーっと、なんて言うんだっけ？カタツムリのように"}, {"type": "subtitle", "time": 10684.429, "timestamp": "02:58:04", "text": "そしてただ行く"}, {"type": "subtitle", "time": 10687.83, "timestamp": "02:58:07", "text": "テーブルの下に潜り込んで、だらしない姿勢で"}, {"type": "subtitle", "time": 10698.03, "timestamp": "02:58:18", "text": "うん。おお"}, {"type": "subtitle", "time": 10701.23, "timestamp": "02:58:21", "text": "[音楽]"}, {"type": "subtitle", "time": 10709.03, "timestamp": "02:58:29", "text": "分。こんにちは。ところで、彼女は背が高かった"}, {"type": "subtitle", "time": 10711.269, "timestamp": "02:58:31", "text": "この山を登った後の決断"}, {"type": "subtitle", "time": 10714.55, "timestamp": "02:58:34", "text": "そして彼女は西のどこかへ登っていて、"}, {"type": "subtitle", "time": 10716.63, "timestamp": "02:58:36", "text": "そしてその時、彼女は"}, {"type": "subtitle", "time": 10719.87, "timestamp": "02:58:39", "text": "兵士として前線で戦う"}, {"type": "subtitle", "time": 10722.95, "timestamp": "02:58:42", "text": "線。今、私は"}, {"type": "subtitle", "time": 10726.269, "timestamp": "02:58:46", "text": "ええと、サミットワン彼女は"}, {"type": "subtitle", "time": 10728.95, "timestamp": "02:58:48", "text": "征服したので、私は頂上に到達できます"}, {"type": "subtitle", "time": 10735.99, "timestamp": "02:58:55", "text": "雨の日に所有する。負けたくない"}, {"type": "subtitle", "time": 10736.91, "timestamp": "02:58:56", "text": "に"}]
[{"type": "subtitle", "time": 4981.99, "timestamp": "01:23:01", "text": "私にとってはまさにこれだ。私たちには特定の"}, {"type": "subtitle", "time": 4985.189, "timestamp": "01:23:05", "text": "私を助けてくれるチーム"}, {"type": "subtitle", "time": 4988.03, "timestamp": "01:23:08", "text": "私のイラストやデザインなど。"}, {"type": "subtitle", "time": 4993.59, "timestamp": "01:23:13", "text": "だから、断らざるを得ないんです。ああ、そうだね。できる"}, {"type": "subtitle", "time": 4996.07, "timestamp": "01:23:16", "text": "私があなたに見せるのは、つまり、あなたが見せることができるのは、"}, {"type": "subtitle", "time": 4998.31, "timestamp": "01:23:18", "text": "しかし、私があなたを"}, {"type": "subtitle", "time": 5000.149, "timestamp": "01:23:20", "text": "委託、つまり委託のこと、または"}, {"type": "subtitle", "time": 5003.149, "timestamp": "01:23:23", "text": "何か、だって、ええ、私はただ"}, {"type": "subtitle", "time": 5012.709, "timestamp": "01:23:32", "text": "うん、でも、私は見せているし、私もそうする"}, {"type": "subtitle", "time": 5015.39, "timestamp": "01:23:35", "text": "私の持ち物、ほとんどの物"}]
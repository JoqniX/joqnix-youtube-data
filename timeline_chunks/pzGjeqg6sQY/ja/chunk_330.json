[{"type": "subtitle", "time": 19801.23, "timestamp": "05:30:01", "text": "サイト全体。いいえ、すべてがそうである必要はありません"}, {"type": "subtitle", "time": 19803.75, "timestamp": "05:30:03", "text": "統一された。ええ、私が"}, {"type": "subtitle", "time": 19805.83, "timestamp": "05:30:05", "text": "修正して、よかった、クリックして"}, {"type": "subtitle", "time": 19809.11, "timestamp": "05:30:09", "text": "これ。連絡先セクションを修正しましょう"}, {"type": "subtitle", "time": 19811.35, "timestamp": "05:30:11", "text": "手短に。"}, {"type": "subtitle", "time": 19817.868, "timestamp": "05:30:17", "text": "[音楽]"}, {"type": "subtitle", "time": 19835.708, "timestamp": "05:30:35", "text": "えっと、これは私がやるべきことですか？"}, {"type": "subtitle", "time": 19839.39, "timestamp": "05:30:39", "text": "変化？それは容器です。いいえ、コンテンツ"}, {"type": "subtitle", "time": 19852.43, "timestamp": "05:30:52", "text": "適切なコンテンツ"}, {"type": "subtitle", "time": 19856.03, "timestamp": "05:30:56", "text": "エリア。中央集権型です。高さは"}]
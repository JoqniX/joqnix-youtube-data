[{"type": "subtitle", "time": 5460.89, "timestamp": "01:31:00", "text": "もの。わからない。"}, {"type": "subtitle", "time": 5468.95, "timestamp": "01:31:08", "text": "私はただ探検しているだけです。私"}, {"type": "subtitle", "time": 5470.55, "timestamp": "01:31:10", "text": "努力もせず、"}, {"type": "subtitle", "time": 5472.669, "timestamp": "01:31:12", "text": "キャラクター"}, {"type": "subtitle", "time": 5475.07, "timestamp": "01:31:15", "text": "より強く。来る"}, {"type": "subtitle", "time": 5478.229, "timestamp": "01:31:18", "text": "の上。行く。私はこのクエストをクリアしました。うん。うん。"}, {"type": "subtitle", "time": 5479.87, "timestamp": "01:31:19", "text": "うん。私はこれをしました"}, {"type": "subtitle", "time": 5482.27, "timestamp": "01:31:22", "text": "クエスト。私はこれをしました"}, {"type": "subtitle", "time": 5494.51, "timestamp": "01:31:34", "text": "私はあなたの邪魔をしたくない"}, {"type": "subtitle", "time": 5503.149, "timestamp": "01:31:43", "text": "わかった。試してみるしかない。えーと、次に"}, {"type": "subtitle", "time": 5505.229, "timestamp": "01:31:45", "text": "仕上げる。どれの"}, {"type": "subtitle", "time": 5511.27, "timestamp": "01:31:51", "text": "えっと、私はあなたしか見ていません。他に何がありましたか"}, {"type": "subtitle", "time": 5514.31, "timestamp": "01:31:54", "text": "する？ほとんど警官とかじゃないよ。えっと、つまり私は"}, {"type": "subtitle", "time": 5516.229, "timestamp": "01:31:56", "text": "平均"}]
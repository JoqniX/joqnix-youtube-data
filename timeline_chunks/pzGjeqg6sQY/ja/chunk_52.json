[{"type": "subtitle", "time": 3132.309, "timestamp": "00:52:12", "text": "良い。何？ただ、私には何もない"}, {"type": "subtitle", "time": 3136.829, "timestamp": "00:52:16", "text": "まだやっていない。胸を全部叩きました"}, {"type": "subtitle", "time": 3139.51, "timestamp": "00:52:19", "text": "けれど。だから私は混乱しているんです。私"}, {"type": "subtitle", "time": 3149.589, "timestamp": "00:52:29", "text": "すべて。グリッチが発生した"}, {"type": "subtitle", "time": 3152.309, "timestamp": "00:52:32", "text": "場違いだ。それが唯一の宝箱だと思う"}, {"type": "subtitle", "time": 3155.39, "timestamp": "00:52:35", "text": "私は持っている。かもしれないし、そうでないかもしれない"}, {"type": "subtitle", "time": 3162.17, "timestamp": "00:52:42", "text": "終わり。よくわからないけど。"}, {"type": "subtitle", "time": 3172.069, "timestamp": "00:52:52", "text": "うん。発砲容疑。すべては"}, {"type": "subtitle", "time": 3176.03, "timestamp": "00:52:56", "text": "終わり。はい。はい。はい。はい。はい。それらは"}, {"type": "subtitle", "time": 3179.75, "timestamp": "00:52:59", "text": "終わり。だから今は表示されないのです。"}]
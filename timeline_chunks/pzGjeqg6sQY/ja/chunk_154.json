[{"type": "subtitle", "time": 9245.469, "timestamp": "02:34:05", "text": "ああ、これは何でしょう？それは"}, {"type": "subtitle", "time": 9247.87, "timestamp": "02:34:07", "text": "クエスト。"}, {"type": "subtitle", "time": 9250.83, "timestamp": "02:34:10", "text": "シーシャ。"}, {"type": "subtitle", "time": 9252.91, "timestamp": "02:34:12", "text": "こんにちは。それは"}, {"type": "subtitle", "time": 9256.75, "timestamp": "02:34:16", "text": "青い髪の少女。来る"}, {"type": "subtitle", "time": 9261.309, "timestamp": "02:34:21", "text": "了解。あと、ドゴちゃんかわいい"}, {"type": "subtitle", "time": 9264.69, "timestamp": "02:34:24", "text": "頭。主人公はヘアバンドを手に入れる。"}, {"type": "subtitle", "time": 9265.87, "timestamp": "02:34:25", "text": "[音楽]"}, {"type": "subtitle", "time": 9272.63, "timestamp": "02:34:32", "text": "パック。彼女がなぜあんな風に見えるのか分からない"}, {"type": "subtitle", "time": 9274.95, "timestamp": "02:34:34", "text": "鈴木ヅリコ。彼女はズキに似ている"}, {"type": "subtitle", "time": 9277.87, "timestamp": "02:34:37", "text": "青い頭の何らかの理由で"}, {"type": "subtitle", "time": 9280.59, "timestamp": "02:34:40", "text": "眼鏡、四角い"}, {"type": "subtitle", "time": 9284.429, "timestamp": "02:34:44", "text": "眼鏡。うん。また"}, {"type": "subtitle", "time": 9293.11, "timestamp": "02:34:53", "text": "ヘッドピングは信じられないほどの鼻で"}, {"type": "subtitle", "time": 9294.71, "timestamp": "02:34:54", "text": "ほとんどの場合、彼はどんな場所でも眠ることができます"}, {"type": "subtitle", "time": 9296.87, "timestamp": "02:34:56", "text": "地中に埋まっているが、この時"}, {"type": "subtitle", "time": 9298.95, "timestamp": "02:34:58", "text": "彼は見つけた、私はそれが"}]
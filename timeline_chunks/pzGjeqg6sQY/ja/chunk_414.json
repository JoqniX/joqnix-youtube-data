[{"type": "subtitle", "time": 24840.07, "timestamp": "06:54:00", "text": "コラボレーションのおかげで。うん、"}, {"type": "subtitle", "time": 24841.91, "timestamp": "06:54:01", "text": "このコラボレーションのおかげで、私はこのゲームを手に入れました。"}, {"type": "subtitle", "time": 24843.83, "timestamp": "06:54:03", "text": "どんな感じになるのか、私には分かりません。"}, {"type": "subtitle", "time": 24845.99, "timestamp": "06:54:05", "text": "わからない。物事がうまくいくことを願うばかりです"}, {"type": "subtitle", "time": 24848.868, "timestamp": "06:54:08", "text": "本日発売。うん、うまくいくといいな。"}, {"type": "subtitle", "time": 24851.51, "timestamp": "06:54:11", "text": "だって、このゲームの仕組みがよくわからないんだもん。"}, {"type": "subtitle", "time": 24855.03, "timestamp": "06:54:15", "text": "だから、私も痛みのようなものなんです。ご覧になりましたか？"}, {"type": "subtitle", "time": 24859.19, "timestamp": "06:54:19", "text": "配信はありますか？アイデアがあるんだけど、"}, {"type": "subtitle", "time": 24861.51, "timestamp": "06:54:21", "text": "コントロールは機能し、私たちが"}, {"type": "subtitle", "time": 24864.708, "timestamp": "06:54:24", "text": "やるべきこと。えっと、こんにちは。元気でいてくれるといいな"}, {"type": "subtitle", "time": 24868.75, "timestamp": "06:54:28", "text": "絶好調です。言い忘れた"}, {"type": "subtitle", "time": 24871.91, "timestamp": "06:54:31", "text": "それ。誰か私をからかってくれませんか？焼いてあげる"}, {"type": "subtitle", "time": 24874.75, "timestamp": "06:54:34", "text": "あなた。えっと"}, {"type": "subtitle", "time": 24878.868, "timestamp": "06:54:38", "text": "ええ、そうですね。わかった。私たちはゲームを手に入れました"}, {"type": "subtitle", "time": 24882.07, "timestamp": "06:54:42", "text": "本日のコラボレーションについて。私はわからない"}, {"type": "subtitle", "time": 24883.91, "timestamp": "06:54:43", "text": "良い買い物でした。"}, {"type": "subtitle", "time": 24886.788, "timestamp": "06:54:46", "text": "私たち二人ともホラーゲームをプレイしていると思う"}, {"type": "subtitle", "time": 24889.83, "timestamp": "06:54:49", "text": "頻繁。私たちはそうしません。私はただ"}, {"type": "subtitle", "time": 24892.948, "timestamp": "06:54:52", "text": "どちらもやめておこう。私はホラーゲームをほとんどプレイしません"}, {"type": "subtitle", "time": 24894.868, "timestamp": "06:54:54", "text": "そして私たちはそれを手に入れたのですが、私は"}, {"type": "subtitle", "time": 24896.548, "timestamp": "06:54:56", "text": "それが良い買い物だったかどうかを知る"}, {"type": "subtitle", "time": 24899.27, "timestamp": "06:54:59", "text": "いや、でもまあいいや、気にしないで。それを維持する"}]
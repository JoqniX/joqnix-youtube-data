[{"type": "subtitle", "time": 550.03, "timestamp": "00:09:10", "text": "私のタスクバーは"}, {"type": "subtitle", "time": 553.19, "timestamp": "00:09:13", "text": "ない。もし私がそう聞こえたらごめんなさい"}, {"type": "subtitle", "time": 561.03, "timestamp": "00:09:21", "text": "祝福あれ。ええと、私はよく眠れませんでした"}, {"type": "subtitle", "time": 567.07, "timestamp": "00:09:27", "text": "私は戻る必要があると思います"}]
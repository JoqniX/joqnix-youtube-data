[{"type": "subtitle", "time": 11160.19, "timestamp": "03:06:00", "text": "レベルを30まで上げてください。"}, {"type": "subtitle", "time": 11166.389, "timestamp": "03:06:06", "text": "えっと、それで？ああ、私の荷物が、ああ、私は"}, {"type": "subtitle", "time": 11169.269, "timestamp": "03:06:09", "text": "これを更新したい。えっと、どうすればいいですか？"}, {"type": "subtitle", "time": 11171.71, "timestamp": "03:06:11", "text": "私は何をしますか？私は何をしますか？何をすればいいですか"}, {"type": "subtitle", "time": 11175.59, "timestamp": "03:06:15", "text": "する？私は何をしますか？"}, {"type": "subtitle", "time": 11178.269, "timestamp": "03:06:18", "text": "したい、したい、したい、したい、ああ、"}, {"type": "subtitle", "time": 11181.07, "timestamp": "03:06:21", "text": "いいえ。それらの"}, {"type": "subtitle", "time": 11188.79, "timestamp": "03:06:28", "text": "ねえ、知ってる？ボスをやってみようか"}, {"type": "subtitle", "time": 11190.349, "timestamp": "03:06:30", "text": "タントラのための戦い"}, {"type": "subtitle", "time": 11197.91, "timestamp": "03:06:37", "text": "これをやってから寝よう。ええと、"}, {"type": "subtitle", "time": 11201.269, "timestamp": "03:06:41", "text": "寝る。わかった。大丈夫だといいのですが。"}, {"type": "subtitle", "time": 11204.51, "timestamp": "03:06:44", "text": "本当にレベルアップしたい"}, {"type": "subtitle", "time": 11207.71, "timestamp": "03:06:47", "text": "カリストを上げろ。つまり"}, {"type": "subtitle", "time": 11217.23, "timestamp": "03:06:57", "text": "大丈夫。"}]
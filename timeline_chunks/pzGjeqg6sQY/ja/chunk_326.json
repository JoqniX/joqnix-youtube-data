[{"type": "subtitle", "time": 19561.19, "timestamp": "05:26:01", "text": "fps？見た目は同じだ。一体どういうことだ？"}, {"type": "subtitle", "time": 19563.31, "timestamp": "05:26:03", "text": "なし"}, {"type": "subtitle", "time": 19565.868, "timestamp": "05:26:05", "text": "そこには。それは"}, {"type": "subtitle", "time": 19575.35, "timestamp": "05:26:15", "text": "いや、違いがあるんです。"}, {"type": "subtitle", "time": 19578.15, "timestamp": "05:26:18", "text": "違いがある。私にとってそれは"}, {"type": "subtitle", "time": 19581.67, "timestamp": "05:26:21", "text": "私は一度に16フレームを見ることができます。のために"}, {"type": "subtitle", "time": 19583.948, "timestamp": "05:26:23", "text": "君たちだけが限られた範囲しか見ることができない"}, {"type": "subtitle", "time": 19585.55, "timestamp": "05:26:25", "text": "フレーム。"}, {"type": "subtitle", "time": 19588.75, "timestamp": "05:26:28", "text": "ああ、ほら"}, {"type": "subtitle", "time": 19591.11, "timestamp": "05:26:31", "text": "見る。ええ、違いは分かります。私"}, {"type": "subtitle", "time": 19597.11, "timestamp": "05:26:37", "text": "違い。彼らはそう言っている。もし"}, {"type": "subtitle", "time": 19600.55, "timestamp": "05:26:40", "text": "あなたは非常に高いFPSモニターを持っています、"}, {"type": "subtitle", "time": 19604.07, "timestamp": "05:26:44", "text": "反応速度が速ければ、"}, {"type": "subtitle", "time": 19607.83, "timestamp": "05:26:47", "text": "などなど。優れたスペックが重要なのは、"}, {"type": "subtitle", "time": 19610.13, "timestamp": "05:26:50", "text": "結局"}, {"type": "subtitle", "time": 19618.59, "timestamp": "05:26:58", "text": "ゲーム。ええ、そうですね。えっと、私は"}]
[{"type": "subtitle", "time": 10502.429, "timestamp": "02:55:02", "text": "さようなら。"}, {"type": "subtitle", "time": 10530.51, "timestamp": "02:55:30", "text": "ニース。私は贈り物を探したが、"}, {"type": "subtitle", "time": 10533.19, "timestamp": "02:55:33", "text": "何もない。ゼナは彼女が私に望んだもの"}, {"type": "subtitle", "time": 10542.55, "timestamp": "02:55:42", "text": "私の質問は、彼女の妹はまだ"}, {"type": "subtitle", "time": 10557.349, "timestamp": "02:55:57", "text": "けれど？神様が私を招待してくださったことに感謝します"}, {"type": "subtitle", "time": 10559.389, "timestamp": "02:55:59", "text": "これに到達する"}]
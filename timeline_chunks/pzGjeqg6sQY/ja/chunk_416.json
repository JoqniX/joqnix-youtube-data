[{"type": "subtitle", "time": 24960.788, "timestamp": "06:56:00", "text": "ミュートしてお互いに話す"}, {"type": "subtitle", "time": 24961.99, "timestamp": "06:56:01", "text": "崩壊する"}, {"type": "subtitle", "time": 24964.39, "timestamp": "06:56:04", "text": "あなたは通常ミュートします 私は持っていません"}, {"type": "subtitle", "time": 24966.548, "timestamp": "06:56:06", "text": "アイデア。"}, {"type": "subtitle", "time": 24975.03, "timestamp": "06:56:15", "text": "ねえ、待って、君は私たちが使えるって言ったよね"}, {"type": "subtitle", "time": 24976.868, "timestamp": "06:56:16", "text": "の"}, {"type": "subtitle", "time": 24978.788, "timestamp": "06:56:18", "text": "待って、ゲームは起動してる？あなたのゲームは"}, {"type": "subtitle", "time": 24980.548, "timestamp": "06:56:20", "text": "走っている？うん、ゲームはちゃんと動いてるよ。"}, {"type": "subtitle", "time": 24982.788, "timestamp": "06:56:22", "text": "はい、そうです。お待​​ちください。ああ、わかりました。私"}, {"type": "subtitle", "time": 24984.468, "timestamp": "06:56:24", "text": "何か準備しているのかと思ったよ。"}, {"type": "subtitle", "time": 24989.59, "timestamp": "06:56:29", "text": "わかった。では、それでは今からプレイを始めましょう。"}, {"type": "subtitle", "time": 24991.11, "timestamp": "06:56:31", "text": "ええ、できますよ。うん。うん。うん。もちろん。"}, {"type": "subtitle", "time": 24993.628, "timestamp": "06:56:33", "text": "わかった。わかった。わかった。それで、私たちは"}, {"type": "subtitle", "time": 24996.628, "timestamp": "06:56:36", "text": "マルチプレイヤーがあり、参加できます"}, {"type": "subtitle", "time": 24998.628, "timestamp": "06:56:38", "text": "プライベートゲームまたはロビー作成。それで、"}, {"type": "subtitle", "time": 25001.19, "timestamp": "06:56:41", "text": "おそらくロビーを作成するでしょう。そしてこれ"}, {"type": "subtitle", "time": 25007.59, "timestamp": "06:56:47", "text": "何？うん。うん。行くべきだと思う"}, {"type": "subtitle", "time": 25009.59, "timestamp": "06:56:49", "text": "アジアとの関係において。"}, {"type": "subtitle", "time": 25012.708, "timestamp": "06:56:52", "text": "ええと、アジアでいいと思います。はい。"}, {"type": "subtitle", "time": 25016.23, "timestamp": "06:56:56", "text": "うん。そして、誰が作成するのか"}, {"type": "subtitle", "time": 25019.27, "timestamp": "06:56:59", "text": "ロビー？えっと、誰がいいですか？欲しいですか"}]
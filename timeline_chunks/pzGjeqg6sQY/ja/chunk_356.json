[{"type": "subtitle", "time": 21360.07, "timestamp": "05:56:00", "text": "それがどこで終わるかは、私たちが定義するだけです"}, {"type": "subtitle", "time": 21362.47, "timestamp": "05:56:02", "text": "開始地点と期間は"}, {"type": "subtitle", "time": 21364.47, "timestamp": "05:56:04", "text": "いつ終わるのかは分からないが、"}, {"type": "subtitle", "time": 21367.99, "timestamp": "05:56:07", "text": "ビューポート内のどこにあるのか。戻る"}, {"type": "subtitle", "time": 21370.868, "timestamp": "05:56:10", "text": "プレビュー版。そして今、私たちの2つを見ることができます"}, {"type": "subtitle", "time": 21373.11, "timestamp": "05:56:13", "text": "2つ目のアニメーションが進行中です。そして私たちは"}, {"type": "subtitle", "time": 21375.43, "timestamp": "05:56:15", "text": "これにさらに追加する 待って、そうではない"}, {"type": "subtitle", "time": 21376.948, "timestamp": "05:56:16", "text": "巻物に接続されています。それは"}, {"type": "subtitle", "time": 21379.19, "timestamp": "05:56:19", "text": "可能。えっと、フェードインさせたいんです。"}, {"type": "subtitle", "time": 21381.51, "timestamp": "05:56:21", "text": "透明度をゼロに設定します。今私たちは"}, {"type": "subtitle", "time": 21383.83, "timestamp": "05:56:23", "text": "フェードインするのを見ることができます。そして100ピクセルは"}, {"type": "subtitle", "time": 21385.83, "timestamp": "05:56:25", "text": "ちょっとばかげてる。 10にしよう"}, {"type": "subtitle", "time": 21388.23, "timestamp": "05:56:28", "text": "ピクセル数を増やして、より繊細な表現にする。そして"}, {"type": "subtitle", "time": 21390.39, "timestamp": "05:56:30", "text": "期間を"}, {"type": "subtitle", "time": 21391.91, "timestamp": "05:56:31", "text": "500 のように見栄えが良くなるだろう"}, {"type": "subtitle", "time": 21395.27, "timestamp": "05:56:35", "text": "ミリ秒。これからアニメーションが始まります"}, {"type": "subtitle", "time": 21397.91, "timestamp": "05:56:37", "text": "フェードインとトランスレーションインによって。"}, {"type": "subtitle", "time": 21399.75, "timestamp": "05:56:39", "text": "最初の段階で期間を使用できます"}, {"type": "subtitle", "time": 21401.91, "timestamp": "05:56:41", "text": "ヒーローセクションまたはその他"}, {"type": "subtitle", "time": 21403.83, "timestamp": "05:56:43", "text": "サイト。そしてそれは、"}, {"type": "subtitle", "time": 21405.83, "timestamp": "05:56:45", "text": "アニメーションは、"}, {"type": "subtitle", "time": 21408.47, "timestamp": "05:56:48", "text": "範囲の開始と終了は、"}, {"type": "subtitle", "time": 21411.75, "timestamp": "05:56:51", "text": "間隔。だからこれは、ああ、私は"}, {"type": "subtitle", "time": 21415.31, "timestamp": "05:56:55", "text": "私の脳が理解したと思う"}]
[{"type": "subtitle", "time": 20760.11, "timestamp": "05:46:00", "text": "男。やりたいことがたくさんある"}, {"type": "subtitle", "time": 20762.628, "timestamp": "05:46:02", "text": "修理。そうそう。私はTwitterで確認しました。"}, {"type": "subtitle", "time": 20764.948, "timestamp": "05:46:04", "text": "インスタグラム、ユーチューブ、"}, {"type": "subtitle", "time": 20767.91, "timestamp": "05:46:07", "text": "えーと、Twitch、これ、そして私は"}, {"type": "subtitle", "time": 20770.15, "timestamp": "05:46:10", "text": "キックとか色々入れるべきだったな。私はしません"}, {"type": "subtitle", "time": 20775.56, "timestamp": "05:46:15", "text": "ここ。"}, {"type": "subtitle", "time": 20777.31, "timestamp": "05:46:17", "text": "[音楽]"}, {"type": "subtitle", "time": 20788.98, "timestamp": "05:46:28", "text": "これですか？次に"}, {"type": "subtitle", "time": 20790.11, "timestamp": "05:46:30", "text": "[音楽]"}, {"type": "subtitle", "time": 20799.948, "timestamp": "05:46:39", "text": "えっと、これをこれに使おう"}, {"type": "subtitle", "time": 20803.83, "timestamp": "05:46:43", "text": "値下げ。次はテキストです"}, {"type": "subtitle", "time": 20805.868, "timestamp": "05:46:45", "text": "アニメーション"}, {"type": "subtitle", "time": 20808.708, "timestamp": "05:46:48", "text": "グループ。マークダウンの中にテキストを配置する"}, {"type": "subtitle", "time": 20812.15, "timestamp": "05:46:52", "text": "違反するよ、それを置く必要がある"}, {"type": "subtitle", "time": 20815.83, "timestamp": "05:46:55", "text": "アニメーショングループ内。アニメーション"}, {"type": "subtitle", "time": 20818.548, "timestamp": "05:46:58", "text": "グループはあらゆるもののコアコンポーネントになります"}]
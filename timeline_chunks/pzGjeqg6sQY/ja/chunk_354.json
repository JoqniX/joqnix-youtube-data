[{"type": "subtitle", "time": 21243.35, "timestamp": "05:54:03", "text": "けれど。どうやって作るのですか？どうやって作るの？"}, {"type": "subtitle", "time": 21245.07, "timestamp": "05:54:05", "text": "それは神聖なもののように"}, {"type": "subtitle", "time": 21248.59, "timestamp": "05:54:08", "text": "レベル？皆さんはホロウ・ライブズを見たことがありますか？"}, {"type": "subtitle", "time": 21250.91, "timestamp": "05:54:10", "text": "1つ？お見せします"}, {"type": "subtitle", "time": 21254.51, "timestamp": "05:54:14", "text": "あなた。それはフェードインアニメーションです"}, {"type": "subtitle", "time": 21258.948, "timestamp": "05:54:18", "text": "エントリ。いや、いや、いや。それは"}, {"type": "subtitle", "time": 21261.67, "timestamp": "05:54:21", "text": "えっと、ニュースをクリックすると、"}, {"type": "subtitle", "time": 21263.19, "timestamp": "05:54:23", "text": "ニュースで見たよ。うん、それ"}, {"type": "subtitle", "time": 21266.11, "timestamp": "05:54:26", "text": "アニメーション。ご覧のとおり、"}, {"type": "subtitle", "time": 21268.67, "timestamp": "05:54:28", "text": "それをロードする"}, {"type": "subtitle", "time": 21271.51, "timestamp": "05:54:31", "text": "もの？私もそうしたいです。ごきげんよう"}, {"type": "subtitle", "time": 21272.67, "timestamp": "05:54:32", "text": "オン"}, {"type": "subtitle", "time": 21280.23, "timestamp": "05:54:40", "text": "右？動画があったと思う"}, {"type": "subtitle", "time": 21289.67, "timestamp": "05:54:49", "text": "ロードページでヒーローをアニメーション化する方法"}, {"type": "subtitle", "time": 21292.03, "timestamp": "05:54:52", "text": "主。ええ、これです。はい、はい、はい、"}, {"type": "subtitle", "time": 21295.83, "timestamp": "05:54:55", "text": "はい。私に命を吹き込んで。私はこのヒーローが欲しい。私"}, {"type": "subtitle", "time": 21297.91, "timestamp": "05:54:57", "text": "正しいページだけアニメーション化すればいいのに。何"}]
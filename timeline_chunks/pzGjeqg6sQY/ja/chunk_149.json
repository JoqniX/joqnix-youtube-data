[{"type": "subtitle", "time": 8944.75, "timestamp": "02:29:04", "text": "それ？安全性。ああ、ありがとう"}, {"type": "subtitle", "time": 8947.27, "timestamp": "02:29:07", "text": "神は私たちのテキストを共有しませんでした"}, {"type": "subtitle", "time": 8948.99, "timestamp": "02:29:08", "text": "共振器は"}, {"type": "subtitle", "time": 8953.23, "timestamp": "02:29:13", "text": "戦う"}, {"type": "subtitle", "time": 8956.15, "timestamp": "02:29:16", "text": "サウスカロライナ州在住の、赤毛で気難しい研究者。 1つ"}, {"type": "subtitle", "time": 8959.51, "timestamp": "02:29:19", "text": "眼鏡をかけた状態で。おお"}, {"type": "subtitle", "time": 8962.23, "timestamp": "02:29:22", "text": "えっと、あなたは鍛冶屋のようで、"}, {"type": "subtitle", "time": 8963.83, "timestamp": "02:29:23", "text": "回転できないコマ"}, {"type": "subtitle", "time": 8966.71, "timestamp": "02:29:26", "text": "まな板。それは何だったのか？"}, {"type": "subtitle", "time": 8969.79, "timestamp": "02:29:29", "text": "怒っているスポーツマンがいるのか？何？"}, {"type": "subtitle", "time": 8978.11, "timestamp": "02:29:38", "text": "[音楽]"}]
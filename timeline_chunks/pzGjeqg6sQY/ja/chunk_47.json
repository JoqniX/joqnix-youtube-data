[{"type": "subtitle", "time": 2843.39, "timestamp": "00:47:23", "text": "おい、違う"}, {"type": "subtitle", "time": 2846.589, "timestamp": "00:47:26", "text": "方法。はい、2時間分見ています"}, {"type": "subtitle", "time": 2849.349, "timestamp": "00:47:29", "text": "ビデオ。それはまさに戦利品じゃないか"}, {"type": "subtitle", "time": 2852.309, "timestamp": "00:47:32", "text": "マッパー。ええ、私は使っています"}, {"type": "subtitle", "time": 2859.67, "timestamp": "00:47:39", "text": "私はこれらすべてを手に入れた。ただそれは"}, {"type": "subtitle", "time": 2863.19, "timestamp": "00:47:43", "text": "ルートマッパーの一部は"}, {"type": "subtitle", "time": 2865.91, "timestamp": "00:47:45", "text": "供給するものだが、課題は"}, {"type": "subtitle", "time": 2868.55, "timestamp": "00:47:48", "text": "そういうのはカウントされない。"}]
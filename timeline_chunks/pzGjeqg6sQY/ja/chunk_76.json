[{"type": "subtitle", "time": 4565.83, "timestamp": "01:16:05", "text": "それ？ああ、エメッド・ジョン。ええと、エムット・ジョンソン、"}, {"type": "subtitle", "time": 4567.83, "timestamp": "01:16:07", "text": "フォローありがとうございます。ようこそ"}, {"type": "subtitle", "time": 4569.51, "timestamp": "01:16:09", "text": "ストリーム。元気ですか？どうやって私たちを見つけましたか？"}, {"type": "subtitle", "time": 4577.59, "timestamp": "01:16:17", "text": "あなた？ねえ、これはBみたいなものですか？"}, {"type": "subtitle", "time": 4581.669, "timestamp": "01:16:21", "text": "襲撃か何か？何？ズラ、こんにちは、"}, {"type": "subtitle", "time": 4584.47, "timestamp": "01:16:24", "text": "ようこそ、ようこそ。待って、それってすごく怪しいよ。"}, {"type": "subtitle", "time": 4586.03, "timestamp": "01:16:26", "text": "どうやって2つ手に入れたか"}, {"type": "subtitle", "time": 4588.709, "timestamp": "01:16:28", "text": "人々。元気かい？ああ、私は"}, {"type": "subtitle", "time": 4590.79, "timestamp": "01:16:30", "text": "良い。こんにちは。こんにちは。皆さんはどうでしたか？"}, {"type": "subtitle", "time": 4593.149, "timestamp": "01:16:33", "text": "私を見つけられますか？私は本当に"}, {"type": "subtitle", "time": 4596.99, "timestamp": "01:16:36", "text": "好奇心旺盛。皆さんはどうやって見つけたのですか？"}, {"type": "subtitle", "time": 4599.79, "timestamp": "01:16:39", "text": "自分？"}, {"type": "subtitle", "time": 4603.59, "timestamp": "01:16:43", "text": "こんにちは。バカを逮捕しろ。いいえ、私は見つけたいと思っています"}, {"type": "subtitle", "time": 4611.55, "timestamp": "01:16:51", "text": "けれど。どこですか？見つかりません"}, {"type": "subtitle", "time": 4615.38, "timestamp": "01:16:55", "text": "それ。元気ですか？元気です。"}, {"type": "subtitle", "time": 4618.47, "timestamp": "01:16:58", "text": "[音楽]"}]
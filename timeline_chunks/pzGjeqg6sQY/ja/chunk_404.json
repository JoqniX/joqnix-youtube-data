[{"type": "subtitle", "time": 24250.91, "timestamp": "06:44:10", "text": "より良い。"}, {"type": "subtitle", "time": 24255.788, "timestamp": "06:44:15", "text": "こんにちは。ビリービリーの人たち全員を手に入れた"}, {"type": "subtitle", "time": 24258.62, "timestamp": "06:44:18", "text": "終了"}, {"type": "subtitle", "time": 24279.43, "timestamp": "06:44:39", "text": "そして、私は楽しんでいます。後で戻ってきます。わかった。"}, {"type": "subtitle", "time": 24285.948, "timestamp": "06:44:45", "text": "これ。彼女"}, {"type": "subtitle", "time": 24290.548, "timestamp": "06:44:50", "text": "こんにちは。私は戻ってきます。それでは、お楽しみください。持つ"}, {"type": "subtitle", "time": 24292.27, "timestamp": "06:44:52", "text": "良い"}, {"type": "subtitle", "time": 24299.468, "timestamp": "06:44:59", "text": "心配。"}]
[{"type": "subtitle", "time": 20281.75, "timestamp": "05:38:01", "text": "彼らにはこれらの設定があります。主要な枠組み"}, {"type": "subtitle", "time": 20284.548, "timestamp": "05:38:04", "text": "こちらです。フィルモードが逆になっています。"}, {"type": "subtitle", "time": 20287.19, "timestamp": "05:38:07", "text": "イージング設定はこちらです。範囲。彼らは"}, {"type": "subtitle", "time": 20290.11, "timestamp": "05:38:10", "text": "範囲がいくつかある"}, {"type": "subtitle", "time": 20293.91, "timestamp": "05:38:13", "text": "ここ。えーと、カスタム範囲を設定できます"}, {"type": "subtitle", "time": 20299.07, "timestamp": "05:38:19", "text": "良い。エントリーとエントリーとまた"}, {"type": "subtitle", "time": 20302.788, "timestamp": "05:38:22", "text": "出口。特注品がたくさんある。彼らは"}, {"type": "subtitle", "time": 20305.11, "timestamp": "05:38:25", "text": "キーフレームの件も同様です。ああ、なんてことだ、彼らは"}, {"type": "subtitle", "time": 20307.15, "timestamp": "05:38:27", "text": "キーフレームの要素として"}, {"type": "subtitle", "time": 20309.47, "timestamp": "05:38:29", "text": "良い。クレイジー。"}, {"type": "subtitle", "time": 20313.628, "timestamp": "05:38:33", "text": "これで、任意のCSSプロパティを追加できます"}, {"type": "subtitle", "time": 20317.39, "timestamp": "05:38:37", "text": "ここ。そして、さらに追加していくことができます"}, {"type": "subtitle", "time": 20325.11, "timestamp": "05:38:45", "text": "そして新しいアニメーションを作成できます"}, {"type": "subtitle", "time": 20326.43, "timestamp": "05:38:46", "text": "完全に"}, {"type": "subtitle", "time": 20328.99, "timestamp": "05:38:48", "text": "それをまた使用し、"}, {"type": "subtitle", "time": 20331.708, "timestamp": "05:38:51", "text": "すべては"}, {"type": "chat", "time": 20336.456, "timestamp": "05:38:56", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "Hiiieeee JOQ!UCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2AkUCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2Ak"}]
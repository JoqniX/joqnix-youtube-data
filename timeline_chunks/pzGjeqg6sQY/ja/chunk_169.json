[{"type": "subtitle", "time": 10151.469, "timestamp": "02:49:11", "text": "この下での私たちの贈り物"}, {"type": "subtitle", "time": 10154.469, "timestamp": "02:49:14", "text": "木の方向、手、保護"}, {"type": "subtitle", "time": 10156.83, "timestamp": "02:49:16", "text": "の"}, {"type": "subtitle", "time": 10159.19, "timestamp": "02:49:19", "text": "心臓。手の意味を理解する"}, {"type": "subtitle", "time": 10162.23, "timestamp": "02:49:22", "text": "そして心は見つけるのに十分であるはずです"}, {"type": "subtitle", "time": 10168.469, "timestamp": "02:49:28", "text": "さあ、周りを見渡してみましょう。"}, {"type": "subtitle", "time": 10169.63, "timestamp": "02:49:29", "text": "シートベルトを締める"}, {"type": "subtitle", "time": 10175.51, "timestamp": "02:49:35", "text": "右。ちょっと"}, {"type": "subtitle", "time": 10191.59, "timestamp": "02:49:51", "text": "理想を言えば、私は"}, {"type": "subtitle", "time": 10193.79, "timestamp": "02:49:53", "text": "今までに"}]
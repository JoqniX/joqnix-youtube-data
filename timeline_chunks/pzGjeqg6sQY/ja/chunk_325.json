[{"type": "subtitle", "time": 19501.948, "timestamp": "05:25:01", "text": "モバイルウェアの場合"}, {"type": "subtitle", "time": 19505.23, "timestamp": "05:25:05", "text": "仕事。これはとても"}, {"type": "subtitle", "time": 19508.788, "timestamp": "05:25:08", "text": "楽しい。私は240Hzモニターを使っているので、これは"}, {"type": "subtitle", "time": 19511.75, "timestamp": "05:25:11", "text": "速い。かなり速い。私はすべてを見ることができます"}, {"type": "subtitle", "time": 19514.948, "timestamp": "05:25:14", "text": "単一ピクセル。配信ではどうですか？そして私は"}, {"type": "subtitle", "time": 19519.07, "timestamp": "05:25:19", "text": "自分の配信を見させてくれ。"}, {"type": "subtitle", "time": 19532.31, "timestamp": "05:25:32", "text": "talk.com/live正直に言うと、"}, {"type": "subtitle", "time": 19538.53, "timestamp": "05:25:38", "text": "正直に。"}, {"type": "subtitle", "time": 19541.39, "timestamp": "05:25:41", "text": "[音楽]"}, {"type": "subtitle", "time": 19544.31, "timestamp": "05:25:44", "text": "えっと、ポップアップするものはどうやって"}, {"type": "subtitle", "time": 19545.628, "timestamp": "05:25:45", "text": "私の"}, {"type": "subtitle", "time": 19548.07, "timestamp": "05:25:48", "text": "ストリーム？なぜそれが表示されないのですか？"}, {"type": "subtitle", "time": 19549.708, "timestamp": "05:25:49", "text": "わかりました、置いてみます"}, {"type": "subtitle", "time": 19553.59, "timestamp": "05:25:53", "text": "ここ。よし、どこまでできるか見てみよう"}, {"type": "subtitle", "time": 19557.15, "timestamp": "05:25:57", "text": "どうですか？ 60で感じられますか？"}]
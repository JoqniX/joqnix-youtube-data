[{"type": "subtitle", "time": 9489.59, "timestamp": "02:38:09", "text": "意味？最初の試験から、私は立ち上がって"}, {"type": "subtitle", "time": 9492.63, "timestamp": "02:38:12", "text": "不注意によりベッドで寝ていた。私は1人でした"}, {"type": "subtitle", "time": 9494.87, "timestamp": "02:38:14", "text": "満点にはわずかに届かない。私の"}, {"type": "subtitle", "time": 9498.03, "timestamp": "02:38:18", "text": "家族が後に怒った"}, {"type": "subtitle", "time": 9501.07, "timestamp": "02:38:21", "text": "自分自身。振り返ってみると、私は"}, {"type": "subtitle", "time": 9503.03, "timestamp": "02:38:23", "text": "頑固。いや、いや、いや。私を誤解しないでください"}, {"type": "subtitle", "time": 9504.95, "timestamp": "02:38:24", "text": "違うよ、自慢なんかしてない。あなたが知っている、"}, {"type": "subtitle", "time": 9506.71, "timestamp": "02:38:26", "text": "ほぼ全員が高得点を獲得"}, {"type": "subtitle", "time": 9507.87, "timestamp": "02:38:27", "text": "主要な"}, {"type": "subtitle", "time": 9510.389, "timestamp": "02:38:30", "text": "学校。私はジョシュアの人々のために"}, {"type": "subtitle", "time": 9513.59, "timestamp": "02:38:33", "text": "彼らは成績に関して非常に敏感だ。さあ"}, {"type": "subtitle", "time": 9515.15, "timestamp": "02:38:35", "text": "保つ"}, {"type": "subtitle", "time": 9518.91, "timestamp": "02:38:38", "text": "移動中。うん、そうしないといけないね。"}, {"type": "subtitle", "time": 9522.79, "timestamp": "02:38:42", "text": "つまり、あと３つのプレゼントがあるということです。えっと、私は"}, {"type": "subtitle", "time": 9525.63, "timestamp": "02:38:45", "text": "この場所は私の家の裏庭のようによく知っています"}, {"type": "subtitle", "time": 9529.95, "timestamp": "02:38:49", "text": "手。高い山に登るには"}]
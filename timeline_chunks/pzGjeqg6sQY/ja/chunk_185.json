[{"type": "subtitle", "time": 11101.75, "timestamp": "03:05:01", "text": "細心の注意を払わなければならない。これは私の"}, {"type": "subtitle", "time": 11105.83, "timestamp": "03:05:05", "text": "3人目の禁止男。 2回目の60秒禁止ではない"}, {"type": "subtitle", "time": 11108.95, "timestamp": "03:05:08", "text": "でも、気をつけなきゃいけないんだ。私はします"}, {"type": "subtitle", "time": 11111.75, "timestamp": "03:05:11", "text": "試さないで、画面を吹き飛ばしてみます"}, {"type": "subtitle", "time": 11115.429, "timestamp": "03:05:15", "text": "さあ、これから先へ。私は何も見せません"}, {"type": "subtitle", "time": 11122.389, "timestamp": "03:05:22", "text": "怖がった。正直、怖いです。あなた"}, {"type": "subtitle", "time": 11124.469, "timestamp": "03:05:24", "text": "ライブ配信で起こるが、VS"}, {"type": "subtitle", "time": 11126.87, "timestamp": "03:05:26", "text": "何も起こらない。わかった？ヴァードは何も"}, {"type": "subtitle", "time": 11130.07, "timestamp": "03:05:30", "text": "起こる。ライブ配信限定。あなたは決して"}, {"type": "subtitle", "time": 11137.19, "timestamp": "03:05:37", "text": "見ている。ええ、今は12時30分です。病気"}, {"type": "subtitle", "time": 11139.55, "timestamp": "03:05:39", "text": "さあ、お別れしましょう。"}, {"type": "subtitle", "time": 11146.59, "timestamp": "03:05:46", "text": "それ。今日は"}, {"type": "subtitle", "time": 11150.63, "timestamp": "03:05:50", "text": "楽しい。今日は楽しかった。そして私たちは到達しました"}, {"type": "subtitle", "time": 11153.67, "timestamp": "03:05:53", "text": "組合レベル29。少しレベル上げをしよう。"}, {"type": "subtitle", "time": 11155.429, "timestamp": "03:05:55", "text": "おそらく、日々の作業をするときに、"}]
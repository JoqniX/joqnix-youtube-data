[{"type": "subtitle", "time": 19441.47, "timestamp": "05:24:01", "text": "えっと、ビリー・ビリーは働いています"}, {"type": "subtitle", "time": 19443.99, "timestamp": "05:24:03", "text": "良い。私はビリー・ビリーにストリーミング配信しています"}, {"type": "subtitle", "time": 19445.59, "timestamp": "05:24:05", "text": "良い。"}, {"type": "subtitle", "time": 19447.868, "timestamp": "05:24:07", "text": "ええ、彼らはこれしか見ていないんです。"}, {"type": "subtitle", "time": 19450.948, "timestamp": "05:24:10", "text": "わかった、私はただ安全策をとっているだけです"}, {"type": "subtitle", "time": 19452.91, "timestamp": "05:24:12", "text": "今。私はほしくない"}, {"type": "subtitle", "time": 19455.628, "timestamp": "05:24:15", "text": "視差をつけて"}, {"type": "subtitle", "time": 19458.948, "timestamp": "05:24:18", "text": "粘着性がある。ああ、これは興味深い。これ"}, {"type": "subtitle", "time": 19461.11, "timestamp": "05:24:21", "text": "一種のパラドックスみたいなもの。うん、そうしたい"}, {"type": "subtitle", "time": 19464.23, "timestamp": "05:24:24", "text": "私の作品やファンアートにはこれを使ってください"}, {"type": "subtitle", "time": 19467.19, "timestamp": "05:24:27", "text": "そういう類のもの。皆さんはどう思いますか？"}, {"type": "subtitle", "time": 19468.83, "timestamp": "05:24:28", "text": "それは"}, {"type": "subtitle", "time": 19471.75, "timestamp": "05:24:31", "text": "良い？あまり良くないかもしれないね。私"}, {"type": "subtitle", "time": 19482.19, "timestamp": "05:24:42", "text": "私には問題があるのですが"}, {"type": "subtitle", "time": 19484.868, "timestamp": "05:24:44", "text": "問題が発生するかもしれない"}, {"type": "subtitle", "time": 19491.51, "timestamp": "05:24:51", "text": "ああ、私は問題があるかもしれない"}, {"type": "subtitle", "time": 19494.23, "timestamp": "05:24:54", "text": "モバイルビューの話になるんだよ。ええ、私は"}, {"type": "subtitle", "time": 19496.19, "timestamp": "05:24:56", "text": "それはすべきではない。私はすべきではない"}, {"type": "subtitle", "time": 19498.948, "timestamp": "05:24:58", "text": "それ。別の設定にすれば"}]
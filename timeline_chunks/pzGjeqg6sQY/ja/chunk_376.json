[{"type": "subtitle", "time": 22562.31, "timestamp": "06:16:02", "text": "それ。よし、ちょっといじってみたよ。わかった。"}, {"type": "subtitle", "time": 22563.99, "timestamp": "06:16:03", "text": "わかった。わかった。キーフレーム。わかった。さあ"}, {"type": "subtitle", "time": 22568.31, "timestamp": "06:16:08", "text": "回転を削除します。私たちはそれを望んでいません。"}, {"type": "subtitle", "time": 22572.708, "timestamp": "06:16:12", "text": "えっと、そのままの姿勢で立っていてほしいんです。"}, {"type": "subtitle", "time": 22576.47, "timestamp": "06:16:16", "text": "後方への動作はどうすればできますか？私は"}, {"type": "subtitle", "time": 22586.39, "timestamp": "06:16:26", "text": "良い。新しいアニメーションを作成して、"}, {"type": "subtitle", "time": 22602.32, "timestamp": "06:16:42", "text": "行くはずだった"}, {"type": "subtitle", "time": 22604.19, "timestamp": "06:16:44", "text": "[音楽]"}, {"type": "subtitle", "time": 22607.03, "timestamp": "06:16:47", "text": "マイナスになるはずだった"}, {"type": "subtitle", "time": 22608.64, "timestamp": "06:16:48", "text": "100ですよね？"}, {"type": "subtitle", "time": 22619.47, "timestamp": "06:16:59", "text": "ひっくり返った？"}]
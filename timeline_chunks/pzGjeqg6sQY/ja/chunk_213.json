[{"type": "subtitle", "time": 12793.55, "timestamp": "03:33:13", "text": "H. こんにちは"}, {"type": "subtitle", "time": 12805.71, "timestamp": "03:33:25", "text": "遅い。それで、"}, {"type": "subtitle", "time": 12820.469, "timestamp": "03:33:40", "text": "では、2分だけ時間をください。わかった。ただ"}, {"type": "subtitle", "time": 12823.389, "timestamp": "03:33:43", "text": "2分だけ時間をください。"}, {"type": "subtitle", "time": 12832.07, "timestamp": "03:33:52", "text": "もう一度時間を調整する必要がある"}, {"type": "subtitle", "time": 12833.32, "timestamp": "03:33:53", "text": "えっと、"}, {"type": "subtitle", "time": 12836.03, "timestamp": "03:33:56", "text": "[音楽]"}, {"type": "subtitle", "time": 12839.67, "timestamp": "03:33:59", "text": "あれ。えっと、知らない人のために"}]
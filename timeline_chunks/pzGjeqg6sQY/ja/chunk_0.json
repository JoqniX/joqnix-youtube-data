[{"type": "subtitle", "time": 2.47, "timestamp": "00:00:02", "text": "バージョン。はい、どうぞ。わかりました、"}, {"type": "subtitle", "time": 4.87, "timestamp": "00:00:04", "text": "どうやってやるかというと、"}, {"type": "subtitle", "time": 7.07, "timestamp": "00:00:07", "text": "これとリンクを貼る"}, {"type": "subtitle", "time": 11.749, "timestamp": "00:00:11", "text": "IDを確認して削除します。さて、調子はどうですか？"}, {"type": "subtitle", "time": 15.79, "timestamp": "00:00:15", "text": "これをするために？私たちは大丈夫だと思います。私はただ"}, {"type": "subtitle", "time": 20.109, "timestamp": "00:00:20", "text": "削除したい短いリクエスト"}, {"type": "subtitle", "time": 22.79, "timestamp": "00:00:22", "text": "コピー＆ペースト。わかりました、私が交代します。私"}, {"type": "subtitle", "time": 25.429, "timestamp": "00:00:25", "text": "切り替えることすら忘れていた。"}, {"type": "subtitle", "time": 28.349, "timestamp": "00:00:28", "text": "アワム。おはよう"}, {"type": "subtitle", "time": 34.51, "timestamp": "00:00:34", "text": "皆さん、ようこそ44日目へ"}, {"type": "subtitle", "time": 39.389, "timestamp": "00:00:39", "text": "チョパソン。皆さんお元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 50.95, "timestamp": "00:00:50", "text": "キノ。私は1秒待つ。私は約"}]
[{"type": "subtitle", "time": 8460.63, "timestamp": "02:21:00", "text": "ああ、昨日のことだよ。ああ、それは、えっと、"}, {"type": "subtitle", "time": 8463.19, "timestamp": "02:21:03", "text": "ご存知の通り、私はギルドサーバーを持っています。"}, {"type": "subtitle", "time": 8465.83, "timestamp": "02:21:05", "text": "右？それで、このボードは"}, {"type": "subtitle", "time": 8468.07, "timestamp": "02:21:08", "text": "金箔と不和の橋。それで"}, {"type": "subtitle", "time": 8470.07, "timestamp": "02:21:10", "text": "ギルデッドで送信するメッセージは何であれ"}, {"type": "subtitle", "time": 8473.309, "timestamp": "02:21:13", "text": "一般チャットで"}, {"type": "subtitle", "time": 8477.429, "timestamp": "02:21:17", "text": "えーと、それらはDiscordに送られます"}, {"type": "subtitle", "time": 8479.51, "timestamp": "02:21:19", "text": "サーバーとDiscordで送信するものすべて"}, {"type": "subtitle", "time": 8482.23, "timestamp": "02:21:22", "text": "ギルドのようなシステムで送り返される。"}, {"type": "subtitle", "time": 8486.07, "timestamp": "02:21:26", "text": "それで昨日、私が何かを入力したとき"}, {"type": "subtitle", "time": 8489.349, "timestamp": "02:21:29", "text": "えっと、一般チャットでスパムされた"}, {"type": "subtitle", "time": 8490.75, "timestamp": "02:21:30", "text": "そして、"}, {"type": "subtitle", "time": 8493.91, "timestamp": "02:21:33", "text": "えっと、スパムされて、文字通り、えっと、何を"}, {"type": "subtitle", "time": 8496.71, "timestamp": "02:21:36", "text": "あなたはそれを何と呼ぶのですか？スパムで、文字通り"}, {"type": "subtitle", "time": 8500.349, "timestamp": "02:21:40", "text": "それはまるで集団反復のようだった"}, {"type": "subtitle", "time": 8502.87, "timestamp": "02:21:42", "text": "すべて。うん、蹴らなきゃいけなかった"}, {"type": "subtitle", "time": 8509.83, "timestamp": "02:21:49", "text": "開発者。誰かがDMを送って独裁者になった"}]
[{"type": "subtitle", "time": 20222.15, "timestamp": "05:37:02", "text": "これ。そしてフェードイン、フェードアウト、フライ"}, {"type": "subtitle", "time": 20224.628, "timestamp": "05:37:04", "text": "到着、出発、ワイプイン、ワイプアウト、乗客到着、"}, {"type": "subtitle", "time": 20226.59, "timestamp": "05:37:06", "text": "人数"}, {"type": "subtitle", "time": 20230.99, "timestamp": "05:37:10", "text": "外。要素を移動して閉じます"}, {"type": "subtitle", "time": 20234.11, "timestamp": "05:37:14", "text": "フェードすることができます"}, {"type": "subtitle", "time": 20238.47, "timestamp": "05:37:18", "text": "ああ。ああ、その努力は素晴らしい。見る、"}, {"type": "subtitle", "time": 20241.35, "timestamp": "05:37:21", "text": "ほら、ほら。フェードアウトです。外側を向いています。いつ"}, {"type": "subtitle", "time": 20244.548, "timestamp": "05:37:24", "text": "スクロールダウンすると、それが見える。"}, {"type": "subtitle", "time": 20247.23, "timestamp": "05:37:27", "text": "そしてこれはあらゆるものに当てはまります"}, {"type": "subtitle", "time": 20255.11, "timestamp": "05:37:35", "text": "いいね。問題は、上にスクロールすると、"}, {"type": "subtitle", "time": 20257.67, "timestamp": "05:37:37", "text": "それはいずれ消え去るだろう。もし私が入力したらどうなるか"}, {"type": "subtitle", "time": 20258.67, "timestamp": "05:37:38", "text": "何か？"}, {"type": "subtitle", "time": 20266.47, "timestamp": "05:37:46", "text": "何かがあって、それでもまだ消えていく"}, {"type": "subtitle", "time": 20268.948, "timestamp": "05:37:48", "text": "消えていった。それも良い効果と言えるのでしょうか？私"}, {"type": "subtitle", "time": 20270.27, "timestamp": "05:37:50", "text": "できた"}, {"type": "subtitle", "time": 20273.39, "timestamp": "05:37:53", "text": "混乱する"}, {"type": "subtitle", "time": 20276.51, "timestamp": "05:37:56", "text": "ノイズは実際にはフェードアウトです"}, {"type": "subtitle", "time": 20279.51, "timestamp": "05:37:59", "text": "良い。わかった。わかった。これは調整できます。"}]
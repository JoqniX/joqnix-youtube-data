[{"type": "subtitle", "time": 24720.03, "timestamp": "06:52:00", "text": "ザチ。私は自分のHiを持っていると思います。"}, {"type": "subtitle", "time": 24746.31, "timestamp": "06:52:26", "text": "カフト。うん。こんにちは。"}, {"type": "subtitle", "time": 24749.99, "timestamp": "06:52:29", "text": "こんにちは。元気ですか？ちょっと待って。待って"}, {"type": "subtitle", "time": 24753.59, "timestamp": "06:52:33", "text": "1分。あなた。私はあなたを設定してさえいません。"}, {"type": "subtitle", "time": 24756.15, "timestamp": "06:52:36", "text": "ごめんなさい。すごく遅刻しちゃった。ここに来て。待って、"}, {"type": "subtitle", "time": 24759.67, "timestamp": "06:52:39", "text": "あなたのコラボレーション、あなたのイメージを設定させてください。"}, {"type": "subtitle", "time": 24762.39, "timestamp": "06:52:42", "text": "我慢する。はい。はい。はい。心配しないで。私たちは"}, {"type": "subtitle", "time": 24767.11, "timestamp": "06:52:47", "text": "どちらも今日は傷がついているけど、まあいいか。"}, {"type": "subtitle", "time": 24770.31, "timestamp": "06:52:50", "text": "さて、今日はどんな一日でしたか？今日はどんな一日だった？それ"}, {"type": "subtitle", "time": 24772.548, "timestamp": "06:52:52", "text": "良かった。あなたの一日はどうでした？ああ、私の日"}, {"type": "subtitle", "time": 24775.67, "timestamp": "06:52:55", "text": "良かった。えっと、楽しんでたよ"}, {"type": "subtitle", "time": 24778.708, "timestamp": "06:52:58", "text": "終日。推測"}]
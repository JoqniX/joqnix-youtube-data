[{"type": "subtitle", "time": 3182.87, "timestamp": "00:53:02", "text": "フィールドにはエコーのみが表示される。"}, {"type": "subtitle", "time": 3185.43, "timestamp": "00:53:05", "text": "エコー。うん。エコーチャレンジが現れる。"}, {"type": "subtitle", "time": 3188.99, "timestamp": "00:53:08", "text": "一度やってしまえば、あとは全てうまくいく。"}, {"type": "subtitle", "time": 3191.589, "timestamp": "00:53:11", "text": "えっと、クエスト実行中です。それらすべて"}, {"type": "subtitle", "time": 3193.589, "timestamp": "00:53:13", "text": "プラットフォームプレートのようになるか、"}, {"type": "subtitle", "time": 3196.71, "timestamp": "00:53:16", "text": "ホログラムが表示されない何か"}, {"type": "subtitle", "time": 3199.43, "timestamp": "00:53:19", "text": "現れたということは、私が完了したということです"}, {"type": "subtitle", "time": 3236.43, "timestamp": "00:53:56", "text": "ええ、ここも"}]
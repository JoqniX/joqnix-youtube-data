[{"type": "subtitle", "time": 4501.55, "timestamp": "01:15:01", "text": "もっとクエストとか全部"}, {"type": "subtitle", "time": 4506.79, "timestamp": "01:15:06", "text": "ここ。ええ、そうです。そして、えーと"}, {"type": "subtitle", "time": 4510.55, "timestamp": "01:15:10", "text": "メル。たぶん、mだけだと思う​​。どこですか？"}, {"type": "subtitle", "time": 4513.51, "timestamp": "01:15:13", "text": "ボブフライだけが必要なんです。たった一匹のボブフライ"}, {"type": "subtitle", "time": 4516.39, "timestamp": "01:15:16", "text": "そして供給の一つはああ、なんてことだ。 1つ必要です"}, {"type": "subtitle", "time": 4523.39, "timestamp": "01:15:23", "text": "胸。ああ、これは"}, {"type": "subtitle", "time": 4530.31, "timestamp": "01:15:30", "text": "痛み。でも、もちろん、私には"}, {"type": "subtitle", "time": 4531.92, "timestamp": "01:15:31", "text": "供給。ええ、供給"}, {"type": "subtitle", "time": 4533.63, "timestamp": "01:15:33", "text": "[音楽]"}]
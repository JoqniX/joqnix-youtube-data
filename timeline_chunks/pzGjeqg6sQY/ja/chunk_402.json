[{"type": "subtitle", "time": 24132.15, "timestamp": "06:42:12", "text": "右？ええ、翻訳されていますよ。それは"}, {"type": "subtitle", "time": 24137.948, "timestamp": "06:42:17", "text": "アニメーション化。それは"}, {"type": "subtitle", "time": 24140.548, "timestamp": "06:42:20", "text": "良い。オーバーフローは望んでいません"}, {"type": "subtitle", "time": 24150.75, "timestamp": "06:42:30", "text": "立ち往生。私はほしくない"}, {"type": "subtitle", "time": 24155.11, "timestamp": "06:42:35", "text": "それ。しかし、私たちはこれを成し遂げたと確信しています。私たちは"}, {"type": "subtitle", "time": 24157.708, "timestamp": "06:42:37", "text": "えっと、ズームする方法がわかったんです"}, {"type": "subtitle", "time": 24175.59, "timestamp": "06:42:55", "text": "はい、申し訳ないのですが、"}, {"type": "subtitle", "time": 24178.23, "timestamp": "06:42:58", "text": "もうすぐ失礼します。私"}]
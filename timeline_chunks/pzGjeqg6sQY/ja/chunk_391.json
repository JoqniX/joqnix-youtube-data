[{"type": "subtitle", "time": 23467.99, "timestamp": "06:31:07", "text": "うーん、悪くないね。でも、もし"}, {"type": "subtitle", "time": 23469.99, "timestamp": "06:31:09", "text": "私たちが何をしているのか不思議に思っているでしょうが、"}, {"type": "subtitle", "time": 23473.67, "timestamp": "06:31:13", "text": "サブアニメーションを作成しただけです"}, {"type": "subtitle", "time": 23476.788, "timestamp": "06:31:16", "text": "私のビジュアル関連のもののためのもの。それは"}, {"type": "subtitle", "time": 23479.67, "timestamp": "06:31:19", "text": "実際にはカスタムコードです。 1つのコードが"}, {"type": "subtitle", "time": 23481.628, "timestamp": "06:31:21", "text": "ズームインすると、1 つのコードで"}, {"type": "subtitle", "time": 23485.39, "timestamp": "06:31:25", "text": "パラドックス。これはギャップだと私は考えています"}, {"type": "subtitle", "time": 23487.83, "timestamp": "06:31:27", "text": "あれ。えっと、あなたが読めるかどうかはわかりませんが"}, {"type": "subtitle", "time": 23491.43, "timestamp": "06:31:31", "text": "でも、ご覧のとおり、私たちは"}, {"type": "subtitle", "time": 23495.468, "timestamp": "06:31:35", "text": "視差効果を演出する。 Yが来る"}, {"type": "subtitle", "time": 23499.708, "timestamp": "06:31:39", "text": "スクロール時に画像を上に移動させる"}, {"type": "subtitle", "time": 23504.788, "timestamp": "06:31:44", "text": "下へ、そう、だからこれはフィットするけど、"}, {"type": "subtitle", "time": 23506.91, "timestamp": "06:31:46", "text": "これが私が探していたものだと思う"}, {"type": "subtitle", "time": 23510.07, "timestamp": "06:31:50", "text": "のために。背景ズーム用のGabアニメーション。"}, {"type": "subtitle", "time": 23513.868, "timestamp": "06:31:53", "text": "ええ、スケールは1.1、期間は"}, {"type": "subtitle", "time": 23517.51, "timestamp": "06:31:57", "text": "20秒だったと思います。繰り返しは"}]
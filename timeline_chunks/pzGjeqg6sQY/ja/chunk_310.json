[{"type": "subtitle", "time": 18600.31, "timestamp": "05:10:00", "text": "いくつか実験してみる"}, {"type": "subtitle", "time": 18603.39, "timestamp": "05:10:03", "text": "君たちと一緒に色々なことをするよ。"}, {"type": "subtitle", "time": 18607.07, "timestamp": "05:10:07", "text": "うん、場面転換するよ。"}, {"type": "subtitle", "time": 18610.39, "timestamp": "05:10:10", "text": "ええと、そうみたいですね。私も"}, {"type": "subtitle", "time": 18611.868, "timestamp": "05:10:11", "text": "混乱した"}, {"type": "subtitle", "time": 18614.628, "timestamp": "05:10:14", "text": "私も混乱しているかどうか"}, {"type": "subtitle", "time": 18616.43, "timestamp": "05:10:16", "text": "すべき"}, {"type": "subtitle", "time": 18627.99, "timestamp": "05:10:27", "text": "えっと、これをビリービリーに見せるか、それとも"}, {"type": "subtitle", "time": 18630.43, "timestamp": "05:10:30", "text": "試してみて"}, {"type": "subtitle", "time": 18634.83, "timestamp": "05:10:34", "text": "エラーなので、そのままにして、解決策を見つけてください。"}, {"type": "subtitle", "time": 18638.27, "timestamp": "05:10:38", "text": "ああ、何て言うんだっけ？あなた"}, {"type": "subtitle", "time": 18641.15, "timestamp": "05:10:41", "text": "苦労して学ぶような感じ"}, {"type": "subtitle", "time": 18643.91, "timestamp": "05:10:43", "text": "もの。理解したら殴られる"}, {"type": "subtitle", "time": 18646.23, "timestamp": "05:10:46", "text": "そういう類のもの。それを表す言葉は何ですか？"}, {"type": "subtitle", "time": 18650.27, "timestamp": "05:10:50", "text": "誰か、えっと、"}, {"type": "subtitle", "time": 18654.59, "timestamp": "05:10:54", "text": "つまり、魚をあちこち探して見つけるってことじゃない？"}, {"type": "subtitle", "time": 18658.15, "timestamp": "05:10:58", "text": "外？そう、魚はFワードを言う。魚"}, {"type": "chat", "time": 18659.814, "timestamp": "05:10:59", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "fk around and find out"}]
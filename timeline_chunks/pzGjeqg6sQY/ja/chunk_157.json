[{"type": "subtitle", "time": 9420.309, "timestamp": "02:37:00", "text": "[音楽]"}, {"type": "subtitle", "time": 9421.15, "timestamp": "02:37:01", "text": "感謝"}, {"type": "subtitle", "time": 9427.309, "timestamp": "02:37:07", "text": "神。胸、胸、胸、胸、胸、胸、"}, {"type": "subtitle", "time": 9430.51, "timestamp": "02:37:10", "text": "胸。ああ、"}, {"type": "subtitle", "time": 9435.07, "timestamp": "02:37:15", "text": "神。わかった。ああ、74。"}, {"type": "subtitle", "time": 9438.27, "timestamp": "02:37:18", "text": "わかった。以前でしたか"}, {"type": "subtitle", "time": 9443.15, "timestamp": "02:37:23", "text": "74？ 74年だったのか？"}, {"type": "subtitle", "time": 9446.15, "timestamp": "02:37:26", "text": "前に？増加はしなかった。それはしなかった"}, {"type": "subtitle", "time": 9448.07, "timestamp": "02:37:28", "text": "増加。"}, {"type": "subtitle", "time": 9450.309, "timestamp": "02:37:30", "text": "燃えているか燃えていないか、いいえ、"}, {"type": "subtitle", "time": 9452.19, "timestamp": "02:37:32", "text": "それはそれは、えっと"}, {"type": "subtitle", "time": 9462.11, "timestamp": "02:37:42", "text": "行く。えっと、1回でやります"}, {"type": "subtitle", "time": 9465.27, "timestamp": "02:37:45", "text": "行くよ、もうすぐ30歳になるから、"}, {"type": "subtitle", "time": 9475.99, "timestamp": "02:37:55", "text": "少し。以前にもここに来たことがありますか？"}, {"type": "subtitle", "time": 9478.309, "timestamp": "02:37:58", "text": "ええ、それは私が7歳の時でした"}]
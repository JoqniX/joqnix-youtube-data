[{"type": "subtitle", "time": 726.64, "timestamp": "00:12:06", "text": "うん、感じてるよ。私はとても"}, {"type": "subtitle", "time": 739.79, "timestamp": "00:12:19", "text": "それ？これはまずいですよね？"}, {"type": "subtitle", "time": 743.269, "timestamp": "00:12:23", "text": "それ？なんとなくそんな感じがする。私はちょっと"}, {"type": "subtitle", "time": 769.79, "timestamp": "00:12:49", "text": "[音楽]"}]
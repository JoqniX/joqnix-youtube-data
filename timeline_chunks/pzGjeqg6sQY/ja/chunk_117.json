[{"type": "subtitle", "time": 7023.79, "timestamp": "01:57:03", "text": "次に進む。私は文字通り引っ越すつもりです"}, {"type": "subtitle", "time": 7026.75, "timestamp": "01:57:06", "text": "の上。だから私は引っ越すつもりです"}, {"type": "subtitle", "time": 7030.79, "timestamp": "01:57:10", "text": "の上。私たちは先に進みます。私は時間を無駄にした"}, {"type": "subtitle", "time": 7034.589, "timestamp": "01:57:14", "text": "ここで3時間ほど過ごした。それは"}, {"type": "subtitle", "time": 7037.35, "timestamp": "01:57:17", "text": "大丈夫。キャンディみたいな声を出せますか？私"}, {"type": "subtitle", "time": 7040.87, "timestamp": "01:57:20", "text": "わからない。私は高く登ることができません。私はしません"}, {"type": "subtitle", "time": 7042.95, "timestamp": "01:57:22", "text": "低くできるか高くできるか、どちらがいいのか分かる。私"}, {"type": "subtitle", "time": 7055.83, "timestamp": "01:57:35", "text": "もの。ああ、そうだよ。私たちは"}, {"type": "subtitle", "time": 7057.709, "timestamp": "01:57:37", "text": "側"}, {"type": "subtitle", "time": 7070.669, "timestamp": "01:57:50", "text": "こんにちは、終わったらまた話しましょう"}, {"type": "subtitle", "time": 7072.35, "timestamp": "01:57:52", "text": "グランド"}, {"type": "subtitle", "time": 7075.91, "timestamp": "01:57:55", "text": "キャプションのことは今は忘れてください。頭"}, {"type": "subtitle", "time": 7078.149, "timestamp": "01:57:58", "text": "病院へ直行。はい、あなたはそうしません"}]
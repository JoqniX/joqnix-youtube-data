[{"type": "subtitle", "time": 21481.39, "timestamp": "05:58:01", "text": "[音楽]"}, {"type": "subtitle", "time": 21483.47, "timestamp": "05:58:03", "text": "えっと、あなたは"}, {"type": "subtitle", "time": 21487.31, "timestamp": "05:58:07", "text": "ボット？はぁ？それは"}, {"type": "subtitle", "time": 21489.67, "timestamp": "05:58:09", "text": "ボット？スケジュールはありますか？"}, {"type": "subtitle", "time": 21492.708, "timestamp": "05:58:12", "text": "ライブ？私は毎日ライブ配信をしています。私たちは"}, {"type": "subtitle", "time": 21494.35, "timestamp": "05:58:14", "text": "あ、あ"}, {"type": "subtitle", "time": 21502.07, "timestamp": "05:58:22", "text": "ええ、そうです、私たちは安息日マラソンを開催します。私は"}, {"type": "subtitle", "time": 21517.67, "timestamp": "05:58:37", "text": "Discord Adomって何？は"}, {"type": "subtitle", "time": 21523.91, "timestamp": "05:58:43", "text": "ボット？何てことだ。わかった。とにかく、えーと"}, {"type": "subtitle", "time": 21525.27, "timestamp": "05:58:45", "text": "翻訳する。私はそれを望んでいます"}, {"type": "subtitle", "time": 21526.99, "timestamp": "05:58:46", "text": "[音楽]"}, {"type": "subtitle", "time": 21538.43, "timestamp": "05:58:58", "text": "ここで私ができることは"}]
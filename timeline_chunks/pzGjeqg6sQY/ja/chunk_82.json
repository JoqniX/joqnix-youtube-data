[{"type": "subtitle", "time": 4920.35, "timestamp": "01:22:00", "text": "私が今までプレイした中で初めての中国製ゲーム"}, {"type": "subtitle", "time": 4924.27, "timestamp": "01:22:04", "text": "プレイしました。ああ、楽しいよ。実際は"}, {"type": "subtitle", "time": 4926.709, "timestamp": "01:22:06", "text": "楽しい。あなたのモデルが好きです。デザインしましたか？"}, {"type": "subtitle", "time": 4930.149, "timestamp": "01:22:10", "text": "自分でやるの？えっと、デザイン"}, {"type": "subtitle", "time": 4933.43, "timestamp": "01:22:13", "text": "えーと、このモデルは、"}, {"type": "subtitle", "time": 4936.47, "timestamp": "01:22:16", "text": "私の親友。えっと、それはまるで"}, {"type": "subtitle", "time": 4940.07, "timestamp": "01:22:20", "text": "私への誕生日プレゼント。ええ、デザイン"}, {"type": "subtitle", "time": 4942.149, "timestamp": "01:22:22", "text": "えーと、これはオリジナルみたいなもので"}, {"type": "subtitle", "time": 4943.149, "timestamp": "01:22:23", "text": "テスト"}, {"type": "subtitle", "time": 4946.51, "timestamp": "01:22:26", "text": "Jockのバージョンデザイン。"}, {"type": "subtitle", "time": 4949.91, "timestamp": "01:22:29", "text": "ええ、オリジナル版を持っています"}, {"type": "subtitle", "time": 4967.99, "timestamp": "01:22:47", "text": "ええ、予想通りでした。ああ、なんてことだ。"}, {"type": "subtitle", "time": 4972.39, "timestamp": "01:22:52", "text": "ええと、丁寧にお断りさせていただきます。"}, {"type": "subtitle", "time": 4974.11, "timestamp": "01:22:54", "text": "なぜなら"}, {"type": "subtitle", "time": 4978.709, "timestamp": "01:22:58", "text": "えーと、私のマネージャーがほとんどのことを処理してくれるので"}]
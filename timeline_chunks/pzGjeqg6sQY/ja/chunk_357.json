[{"type": "subtitle", "time": 21420.39, "timestamp": "05:57:00", "text": "何か。つまり、私が5つ入れると"}, {"type": "subtitle", "time": 21424.03, "timestamp": "05:57:04", "text": "こちらで数秒お待ちください。ああ、"}, {"type": "subtitle", "time": 21425.788, "timestamp": "05:57:05", "text": "神。"}, {"type": "subtitle", "time": 21428.628, "timestamp": "05:57:08", "text": "見て、見て、見て。ああ、なんてことだ。あ、待って。それ"}, {"type": "subtitle", "time": 21431.03, "timestamp": "05:57:11", "text": "アニメーションにおけるフェードイン・フェードアウト。見ることができます"}, {"type": "subtitle", "time": 21432.43, "timestamp": "05:57:12", "text": "その上で"}, {"type": "subtitle", "time": 21436.628, "timestamp": "05:57:16", "text": "バジル。わかった。わかった。わかった。わかった。見て。"}, {"type": "subtitle", "time": 21439.51, "timestamp": "05:57:19", "text": "わかった。わかった。わかった。理解しました。"}, {"type": "subtitle", "time": 21442.39, "timestamp": "05:57:22", "text": "わかった。わかった。わかった。かっこいい。わかった。"}, {"type": "subtitle", "time": 21447.27, "timestamp": "05:57:27", "text": "待って。ここで私にできることは何ですか？私はできると思います、えっと"}, {"type": "subtitle", "time": 21449.27, "timestamp": "05:57:29", "text": "待って、もっと設定項目を見るにはどうすればいいの？わかった。"}, {"type": "subtitle", "time": 21451.59, "timestamp": "05:57:31", "text": "これです。不透明度の代わりに。私たちはそうしません"}, {"type": "subtitle", "time": 21455.75, "timestamp": "05:57:35", "text": "不透明度が欲しい。私は自分が望むことを考える"}, {"type": "subtitle", "time": 21459.47, "timestamp": "05:57:39", "text": "翻訳される"}, {"type": "subtitle", "time": 21462.31, "timestamp": "05:57:42", "text": "えっと、これは一体何ですか？左右。"}, {"type": "subtitle", "time": 21463.91, "timestamp": "05:57:43", "text": "あ、待って。うん。うん。こうしよう"}, {"type": "subtitle", "time": 21466.708, "timestamp": "05:57:46", "text": "ホリデーライフのあれこれ。わかった。わかった。翻訳する"}, {"type": "subtitle", "time": 21476.948, "timestamp": "05:57:56", "text": "えっと、こんにちは。 7日目、良い一日でした。ようこそ"}, {"type": "subtitle", "time": 21479.72, "timestamp": "05:57:59", "text": "小川。フォローありがとうございます。"}]
[{"type": "subtitle", "time": 5220.47, "timestamp": "01:27:00", "text": "5つのサカを手に入れたと思う"}, {"type": "subtitle", "time": 5225.17, "timestamp": "01:27:05", "text": "すでに。えっと、私は"}, {"type": "subtitle", "time": 5226.91, "timestamp": "01:27:06", "text": "[音楽]"}, {"type": "subtitle", "time": 5229.79, "timestamp": "01:27:09", "text": "えっと"}, {"type": "subtitle", "time": 5241.07, "timestamp": "01:27:21", "text": "クマ。えっと、私"}, {"type": "subtitle", "time": 5245.95, "timestamp": "01:27:25", "text": "現在、向かおうとしている、探している"}, {"type": "subtitle", "time": 5249.55, "timestamp": "01:27:29", "text": "愛はまさにこの"}, {"type": "subtitle", "time": 5251.709, "timestamp": "01:27:31", "text": "エリアとして"}, {"type": "subtitle", "time": 5255.55, "timestamp": "01:27:35", "text": "それは"}, {"type": "subtitle", "time": 5258.11, "timestamp": "01:27:38", "text": "中央"}, {"type": "subtitle", "time": 5272.35, "timestamp": "01:27:52", "text": "名前。あぁ、えっと"}, {"type": "subtitle", "time": 5276.11, "timestamp": "01:27:56", "text": "データデータバンクは"}]
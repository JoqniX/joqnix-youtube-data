[{"type": "subtitle", "time": 2645.63, "timestamp": "00:44:05", "text": "彼はここにいるはずだ"}, {"type": "subtitle", "time": 2666.23, "timestamp": "00:44:26", "text": "けれど。同じことですよね？つまり、それは"}, {"type": "subtitle", "time": 2674.109, "timestamp": "00:44:34", "text": "[拍手]"}, {"type": "subtitle", "time": 2687.109, "timestamp": "00:44:47", "text": "ビデオにスキップして"}, {"type": "subtitle", "time": 2689.47, "timestamp": "00:44:49", "text": "隠された宝箱または"}, {"type": "subtitle", "time": 2693.91, "timestamp": "00:44:53", "text": "何か？物資がありません。ああ、いや、いや、いや。"}]
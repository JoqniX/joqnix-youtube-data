[{"type": "subtitle", "time": 4386.35, "timestamp": "01:13:06", "text": "また？おお、"}, {"type": "subtitle", "time": 4389.83, "timestamp": "01:13:09", "text": "うん。私はそのドミノをハッキングして、"}, {"type": "subtitle", "time": 4422.229, "timestamp": "01:13:42", "text": "ああ、もし私がこんな苦しみを味わっていたらどうなるだろうか"}, {"type": "subtitle", "time": 4424.47, "timestamp": "01:13:44", "text": "他の人たちと同じように隣に。さらに"}, {"type": "subtitle", "time": 4438.55, "timestamp": "01:13:58", "text": "想像する。はい。ハッキングして、"}]
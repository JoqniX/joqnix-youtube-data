[{"type": "subtitle", "time": 6548.47, "timestamp": "01:49:08", "text": "今。何てことだ。これは影響を与えるだろう"}, {"type": "subtitle", "time": 6552.35, "timestamp": "01:49:12", "text": "私のSANスコア。"}, {"type": "subtitle", "time": 6556.55, "timestamp": "01:49:16", "text": "私のS値は12です。もし私がそれを下げたらどうなるか分かりますか？"}, {"type": "subtitle", "time": 6559.75, "timestamp": "01:49:19", "text": "もし私がこれ以上減らしたら私の口座は"}, {"type": "subtitle", "time": 6575.51, "timestamp": "01:49:35", "text": "なぜ？人生における慣習として、もし"}, {"type": "subtitle", "time": 6577.35, "timestamp": "01:49:37", "text": "ポイント期間中に違反があった場合"}, {"type": "subtitle", "time": 6578.95, "timestamp": "01:49:38", "text": "特定の指示に従って"}, {"type": "subtitle", "time": 6583.27, "timestamp": "01:49:43", "text": "状況によっては、特定の値を照会することができます"}, {"type": "subtitle", "time": 6584.87, "timestamp": "01:49:44", "text": "前年比で減少します。"}, {"type": "subtitle", "time": 6595.39, "timestamp": "01:49:55", "text": "なぜ？なぜ"}, {"type": "subtitle", "time": 6599.59, "timestamp": "01:49:59", "text": "セカンドモニターがあればいいのに。はい、わかりました。"}]
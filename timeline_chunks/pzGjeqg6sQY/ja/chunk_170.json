[{"type": "subtitle", "time": 10204.95, "timestamp": "02:50:04", "text": "場所。では、なぞなぞの中の手は"}, {"type": "subtitle", "time": 10207.59, "timestamp": "02:50:07", "text": "文字通り、もう一方の手ではありません。それは"}, {"type": "subtitle", "time": 10217.03, "timestamp": "02:50:17", "text": "H 両方の太陽は何かを指しています"}, {"type": "subtitle", "time": 10219.07, "timestamp": "02:50:19", "text": "私たちの中心と心と共に"}, {"type": "subtitle", "time": 10221.55, "timestamp": "02:50:21", "text": "おそらくそうだろう。"}, {"type": "subtitle", "time": 10224.95, "timestamp": "02:50:24", "text": "はい、枝は横を向いています"}, {"type": "subtitle", "time": 10227.309, "timestamp": "02:50:27", "text": "ポイント。これを作らなければならない"}, {"type": "subtitle", "time": 10240.59, "timestamp": "02:50:40", "text": "それ？写真と"}, {"type": "subtitle", "time": 10247.83, "timestamp": "02:50:47", "text": "これは深刻なドラマだ。彼女は番号を使った"}, {"type": "subtitle", "time": 10251.95, "timestamp": "02:50:51", "text": "この手紙が承認されるレース"}, {"type": "subtitle", "time": 10256.51, "timestamp": "02:50:56", "text": "居住する。注射を受け付けます。"}]
[{"type": "subtitle", "time": 7746.3, "timestamp": "02:09:06", "text": "する？ああ、やったぞ。やったよ。私はそうしました"}, {"type": "subtitle", "time": 7747.79, "timestamp": "02:09:07", "text": "[音楽]"}, {"type": "subtitle", "time": 7761.51, "timestamp": "02:09:21", "text": "クリック。クリック。グループ写真を撮りました"}, {"type": "subtitle", "time": 7769.0, "timestamp": "02:09:29", "text": "子供たち。もちろん。"}, {"type": "subtitle", "time": 7775.99, "timestamp": "02:09:35", "text": "ついに。 O. 私は何も稼いでいません。おお"}, {"type": "subtitle", "time": 7783.99, "timestamp": "02:09:43", "text": "神。この人は誰ですか？"}, {"type": "subtitle", "time": 7785.99, "timestamp": "02:09:45", "text": "さあ、子猫ちゃん、受け取って。子猫ちゃん。あなたの森"}, {"type": "subtitle", "time": 7787.75, "timestamp": "02:09:47", "text": "あのバー。あなたはエキゾチックな人ですか？持ってこい。"}, {"type": "subtitle", "time": 7788.669, "timestamp": "02:09:48", "text": "ニャー。"}, {"type": "subtitle", "time": 7793.35, "timestamp": "02:09:53", "text": "obstacプログラムが再びクラッシュしました。平"}, {"type": "subtitle", "time": 7795.03, "timestamp": "02:09:55", "text": "既に最適化は済ませているのですが。そうみたいです"}, {"type": "subtitle", "time": 7798.589, "timestamp": "02:09:58", "text": "ドミノ倒しのように、まだできない"}]
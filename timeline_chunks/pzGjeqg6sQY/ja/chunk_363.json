[{"type": "subtitle", "time": 21781.28, "timestamp": "06:03:01", "text": "他の"}, {"type": "subtitle", "time": 21782.91, "timestamp": "06:03:02", "text": "[音楽]"}, {"type": "subtitle", "time": 21785.708, "timestamp": "06:03:05", "text": "速い。私の質問"}, {"type": "subtitle", "time": 21790.39, "timestamp": "06:03:10", "text": "翻訳するにはどうすればいいですか、または"}, {"type": "subtitle", "time": 21793.31, "timestamp": "06:03:13", "text": "背景フィルターのように"}, {"type": "subtitle", "time": 21803.948, "timestamp": "06:03:23", "text": "どうすればそれを渡せるの？"}, {"type": "subtitle", "time": 21805.69, "timestamp": "06:03:25", "text": "もの？"}, {"type": "subtitle", "time": 21807.15, "timestamp": "06:03:27", "text": "[音楽]"}, {"type": "subtitle", "time": 21809.43, "timestamp": "06:03:29", "text": "遷移。私は移行を望んでいません"}, {"type": "subtitle", "time": 21812.19, "timestamp": "06:03:32", "text": "不透明度。ぼかしたい"}, {"type": "subtitle", "time": 21814.14, "timestamp": "06:03:34", "text": "それ。背景幕"}, {"type": "subtitle", "time": 21836.47, "timestamp": "06:03:56", "text": "そうですね、そのためには学ぶべきです"}]
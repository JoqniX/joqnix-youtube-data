[{"type": "subtitle", "time": 21182.07, "timestamp": "05:53:02", "text": "オフ。ああ、それはいいですね。"}, {"type": "subtitle", "time": 21184.43, "timestamp": "05:53:04", "text": "テキストはどこにありましたか？"}, {"type": "subtitle", "time": 21188.27, "timestamp": "05:53:08", "text": "アニメーション？彼らは削除しましたか？"}, {"type": "subtitle", "time": 21191.99, "timestamp": "05:53:11", "text": "それ？セクションモードを進めて焦点を合わせる"}, {"type": "subtitle", "time": 21194.99, "timestamp": "05:53:14", "text": "もっと。前進"}, {"type": "subtitle", "time": 21198.948, "timestamp": "05:53:18", "text": "モード。ユーザーを一括削​​除します。スクロールイベント。"}, {"type": "subtitle", "time": 21201.868, "timestamp": "05:53:21", "text": "ああ、これだ。私は見た"}, {"type": "subtitle", "time": 21205.39, "timestamp": "05:53:25", "text": "それ。だからもし私が"}, {"type": "subtitle", "time": 21208.15, "timestamp": "05:53:28", "text": "正しい、もし私が正しければ、私は"}, {"type": "subtitle", "time": 21211.788, "timestamp": "05:53:31", "text": "アニメーショングループを追加するだけです。置く"}, {"type": "subtitle", "time": 21213.47, "timestamp": "05:53:33", "text": "もの"}, {"type": "subtitle", "time": 21222.868, "timestamp": "05:53:42", "text": "タグを翻訳すると？だから少し動く"}, {"type": "subtitle", "time": 21233.15, "timestamp": "05:53:53", "text": "[音楽]"}]
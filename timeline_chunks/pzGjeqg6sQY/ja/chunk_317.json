[{"type": "subtitle", "time": 19030.27, "timestamp": "05:17:10", "text": "これは"}, {"type": "subtitle", "time": 19040.19, "timestamp": "05:17:20", "text": "パンチ。サイクルを思い出させる"}, {"type": "subtitle", "time": 19044.07, "timestamp": "05:17:24", "text": "開拓時代のような感じ。まるでその瞬間のように"}, {"type": "subtitle", "time": 19046.31, "timestamp": "05:17:26", "text": "人を見ると、人生の中にいて、"}, {"type": "chat", "time": 19047.188, "timestamp": "05:17:27", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "but then again, it kinda reminds me of cycle: frontier"}, {"type": "subtitle", "time": 19049.11, "timestamp": "05:17:29", "text": "死亡状況。勝つかもしれないし、"}, {"type": "subtitle", "time": 19050.91, "timestamp": "05:17:30", "text": "死んで負けるかもしれない"}, {"type": "subtitle", "time": 19053.75, "timestamp": "05:17:33", "text": "すべて。あのドック、わくわくする"}, {"type": "chat", "time": 19054.43, "timestamp": "05:17:34", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "but we know how they ended up"}, {"type": "subtitle", "time": 19055.84, "timestamp": "05:17:35", "text": "フィーリング、"}, {"type": "subtitle", "time": 19066.31, "timestamp": "05:17:46", "text": "でも、彼らが最終的にどうなるかは、あなたも知っているでしょう。ええ、私は"}, {"type": "subtitle", "time": 19069.59, "timestamp": "05:17:49", "text": "本当にプレイしたかった、本当にプレイしたかった"}, {"type": "subtitle", "time": 19072.47, "timestamp": "05:17:52", "text": "「あ、それは私だ」を演奏する。私は本当に"}, {"type": "subtitle", "time": 19076.708, "timestamp": "05:17:56", "text": "タロフをプレイするんだよ。良いPCが必要です。"}, {"type": "subtitle", "time": 19078.59, "timestamp": "05:17:58", "text": "良いヘッドホンとその他すべて"}]
[{"type": "subtitle", "time": 22201.83, "timestamp": "06:10:01", "text": "彼らが作ったものを再現して、"}, {"type": "subtitle", "time": 22204.788, "timestamp": "06:10:04", "text": "アイデアを得て、学び、独学する。"}, {"type": "subtitle", "time": 22206.788, "timestamp": "06:10:06", "text": "ああ、こうやってやるんだ。こうすれば"}, {"type": "subtitle", "time": 22208.788, "timestamp": "06:10:08", "text": "あなたはそれをしてはいけません。こうすればいい"}, {"type": "subtitle", "time": 22211.23, "timestamp": "06:10:11", "text": "それはまるで"}, {"type": "subtitle", "time": 22214.07, "timestamp": "06:10:14", "text": "それ。このホバー機能はすごいですね。そこには"}, {"type": "subtitle", "time": 22215.868, "timestamp": "06:10:15", "text": "青い線が"}, {"type": "subtitle", "time": 22220.27, "timestamp": "06:10:20", "text": "による。ああ、これはまるで"}, {"type": "subtitle", "time": 22224.788, "timestamp": "06:10:24", "text": "えっと、ホバー背景のとき"}, {"type": "subtitle", "time": 22228.31, "timestamp": "06:10:28", "text": "色が変化し、ここにある画像が"}, {"type": "subtitle", "time": 22231.628, "timestamp": "06:10:31", "text": "ズームを拡大しました"}, {"type": "subtitle", "time": 22233.39, "timestamp": "06:10:33", "text": "効果。"}, {"type": "subtitle", "time": 22236.23, "timestamp": "06:10:36", "text": "ああ、私はこれが彼らに"}, {"type": "subtitle", "time": 22239.59, "timestamp": "06:10:39", "text": "緩和策。だからあなたが去るとき"}, {"type": "subtitle", "time": 22243.03, "timestamp": "06:10:43", "text": "それを取り除けば、それは現れて"}, {"type": "subtitle", "time": 22245.75, "timestamp": "06:10:45", "text": "出現と非出現の効果。それはもっと"}, {"type": "subtitle", "time": 22247.868, "timestamp": "06:10:47", "text": "滑り落ちるように"}, {"type": "subtitle", "time": 22252.07, "timestamp": "06:10:52", "text": "効果。それは、そうですね、"}, {"type": "subtitle", "time": 22256.43, "timestamp": "06:10:56", "text": "かっこいいよ。私は"}, {"type": "subtitle", "time": 22259.88, "timestamp": "06:10:59", "text": "それ。それを見せてください。"}]
[{"type": "subtitle", "time": 3972.029, "timestamp": "01:06:12", "text": "200クラブ入り。わかった。ありました"}, {"type": "subtitle", "time": 3973.95, "timestamp": "01:06:13", "text": "300。"}, {"type": "subtitle", "time": 3977.309, "timestamp": "01:06:17", "text": "ええと、それはカウントされません。"}, {"type": "subtitle", "time": 3985.39, "timestamp": "01:06:25", "text": "[音楽]"}, {"type": "subtitle", "time": 3990.15, "timestamp": "01:06:30", "text": "ええと、98歳の方なら、"}, {"type": "subtitle", "time": 3992.309, "timestamp": "01:06:32", "text": "素晴らしい精神。彼は"}, {"type": "subtitle", "time": 3995.309, "timestamp": "01:06:35", "text": "紫色になり、上昇した。"}, {"type": "subtitle", "time": 4000.87, "timestamp": "01:06:40", "text": "1％。おお。私は99歳です。ああ、"}]
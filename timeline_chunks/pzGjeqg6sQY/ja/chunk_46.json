[{"type": "subtitle", "time": 2773.15, "timestamp": "00:46:13", "text": "蝶のグービーパス。とてもグービー"}, {"type": "subtitle", "time": 2776.43, "timestamp": "00:46:16", "text": "パスが必要です。"}, {"type": "subtitle", "time": 2790.069, "timestamp": "00:46:30", "text": "蝶。ああ、エンジニアの宝箱だ。私"}, {"type": "subtitle", "time": 2814.069, "timestamp": "00:46:54", "text": "彼の紫色の胸も。わかった。の"}, {"type": "subtitle", "time": 2817.63, "timestamp": "00:46:57", "text": "金色のものも。私は手に入れた"}]
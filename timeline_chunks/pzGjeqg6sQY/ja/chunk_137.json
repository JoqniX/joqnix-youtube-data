[{"type": "subtitle", "time": 8220.309, "timestamp": "02:17:00", "text": "ビデオ。彼らは私が知っていることを知っている"}, {"type": "subtitle", "time": 8224.95, "timestamp": "02:17:04", "text": "YouTube を表示しても、私の"}, {"type": "subtitle", "time": 8226.349, "timestamp": "02:17:06", "text": "のように"}, {"type": "subtitle", "time": 8228.589, "timestamp": "02:17:08", "text": "使用済み"}, {"type": "subtitle", "time": 8232.469, "timestamp": "02:17:12", "text": "まるでオリジンをブロックしてフィルターをかけるように"}, {"type": "subtitle", "time": 8236.07, "timestamp": "02:17:16", "text": "ロゴとかそういうもの。"}, {"type": "subtitle", "time": 8238.389, "timestamp": "02:17:18", "text": "ロゴなどをフィルターで取り除く"}, {"type": "subtitle", "time": 8241.83, "timestamp": "02:17:21", "text": "YouTube向け。彼らは私が監視していることを知っている"}, {"type": "subtitle", "time": 8249.75, "timestamp": "02:17:29", "text": "360度方向転換しようとしていますか？いや、いや、いや。私"}, {"type": "subtitle", "time": 8251.07, "timestamp": "02:17:31", "text": "まるで"}, {"type": "subtitle", "time": 8254.19, "timestamp": "02:17:34", "text": "水筒と飲水"}, {"type": "subtitle", "time": 8266.87, "timestamp": "02:17:46", "text": "うん、360度回転はできないと思う。えっと、"}, {"type": "subtitle", "time": 8270.27, "timestamp": "02:17:50", "text": "ええ、できません"}, {"type": "subtitle", "time": 8272.27, "timestamp": "02:17:52", "text": "いや、それは"}, {"type": "subtitle", "time": 8278.429, "timestamp": "02:17:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 9662.79, "timestamp": "02:41:02", "text": "妹と一緒にいます。あなたは彼女がとても恋しいですね。"}, {"type": "subtitle", "time": 9666.03, "timestamp": "02:41:06", "text": "はい。私も彼女のことを心配しています"}, {"type": "subtitle", "time": 9675.27, "timestamp": "02:41:15", "text": "ああ、私は試験勉強をしながら育ったんだ"}, {"type": "subtitle", "time": 9678.15, "timestamp": "02:41:18", "text": "ほとんどの紳士と同じように。勉強した後、"}, {"type": "subtitle", "time": 9679.75, "timestamp": "02:41:19", "text": "何年も経って、ついに私は"}, {"type": "subtitle", "time": 9682.19, "timestamp": "02:41:22", "text": "のように。"}, {"type": "subtitle", "time": 9686.349, "timestamp": "02:41:26", "text": "わかった。私生活は、"}, {"type": "subtitle", "time": 9689.51, "timestamp": "02:41:29", "text": "人生は私の人生のようで、彼女はどうだった？"}, {"type": "subtitle", "time": 9691.27, "timestamp": "02:41:31", "text": "私の妹は生まれつきの共鳴体だ。彼女は"}, {"type": "subtitle", "time": 9693.67, "timestamp": "02:41:33", "text": "自分の能力をうまく活用できる。だから私たちは"}, {"type": "subtitle", "time": 9696.11, "timestamp": "02:41:36", "text": "それぞれ異なる役割を担うことになるだろう。"}, {"type": "subtitle", "time": 9698.309, "timestamp": "02:41:38", "text": "ああ、彼女は一人で旅をして時間を過ごしました"}, {"type": "subtitle", "time": 9699.67, "timestamp": "02:41:39", "text": "師匠と共に武術を習得する"}, {"type": "subtitle", "time": 9702.349, "timestamp": "02:41:42", "text": "芸術、彼女の才能を磨くための魅力的な概念"}, {"type": "subtitle", "time": 9704.11, "timestamp": "02:41:44", "text": "スキル。"}, {"type": "subtitle", "time": 9707.03, "timestamp": "02:41:47", "text": "ニース。男性同士で会ったら"}, {"type": "subtitle", "time": 9718.469, "timestamp": "02:41:58", "text": "ああ、彼女はいつも私の登山を支えてくれる。"}]
[{"type": "subtitle", "time": 19743.708, "timestamp": "05:29:03", "text": "私はジョアトンを作りたかった"}, {"type": "subtitle", "time": 19753.19, "timestamp": "05:29:13", "text": "何かだけど、まだよくわからない"}, {"type": "subtitle", "time": 19754.51, "timestamp": "05:29:14", "text": "私"}, {"type": "subtitle", "time": 19758.31, "timestamp": "05:29:18", "text": "欲しいのは、今私の言いたいことは、"}, {"type": "subtitle", "time": 19761.83, "timestamp": "05:29:21", "text": "側面にライトモードとダークモードがあります。"}, {"type": "subtitle", "time": 19765.11, "timestamp": "05:29:25", "text": "気に入ったら、または、そうするように作ります。"}, {"type": "subtitle", "time": 19769.11, "timestamp": "05:29:29", "text": "どんなデバイスでも使用できます"}, {"type": "subtitle", "time": 19772.548, "timestamp": "05:29:32", "text": "あなたが持っているデバイスのようなもの。もしあなたの電話が"}, {"type": "subtitle", "time": 19774.47, "timestamp": "05:29:34", "text": "ライトモードでは、ライトモードが表示されます。"}, {"type": "subtitle", "time": 19777.51, "timestamp": "05:29:37", "text": "uhウェブサイトの軽量版。もしあなたの"}, {"type": "subtitle", "time": 19779.75, "timestamp": "05:29:39", "text": "電話がダークモードになっているので、暗い画面が表示されます。"}, {"type": "subtitle", "time": 19780.91, "timestamp": "05:29:40", "text": "バージョン"}, {"type": "subtitle", "time": 19783.19, "timestamp": "05:29:43", "text": "Webサイト。そういう感じ"}, {"type": "subtitle", "time": 19786.51, "timestamp": "05:29:46", "text": "システム。それが私の望みです"}, {"type": "subtitle", "time": 19790.67, "timestamp": "05:29:50", "text": "する。うん。つまり、"}, {"type": "subtitle", "time": 19794.548, "timestamp": "05:29:54", "text": "テキストなどの変数など"}, {"type": "subtitle", "time": 19797.51, "timestamp": "05:29:57", "text": "それらは、"}]
[{"type": "subtitle", "time": 10562.87, "timestamp": "02:56:02", "text": "身長。 V字型に膨張する"}, {"type": "subtitle", "time": 10566.269, "timestamp": "02:56:06", "text": "私は常に自分のすべての重荷を"}, {"type": "subtitle", "time": 10568.309, "timestamp": "02:56:08", "text": "心臓。とても美しいと思います"}, {"type": "subtitle", "time": 10570.269, "timestamp": "02:56:10", "text": "サイト"}, {"type": "subtitle", "time": 10572.389, "timestamp": "02:56:12", "text": "ストレッチしたら、確かに効果があった。"}, {"type": "subtitle", "time": 10573.95, "timestamp": "02:56:13", "text": "通過"}, {"type": "subtitle", "time": 10577.03, "timestamp": "02:56:17", "text": "試験、そしてもう一つ重要なことがあります"}, {"type": "subtitle", "time": 10580.23, "timestamp": "02:56:20", "text": "レッスン。ついに誰かが諦めた"}, {"type": "subtitle", "time": 10582.23, "timestamp": "02:56:22", "text": "彼らにチャンスが訪れた、それが私が降りた方法だ"}, {"type": "subtitle", "time": 10588.389, "timestamp": "02:56:28", "text": "リストに載せると、私は山に登るかもしれません"}, {"type": "subtitle", "time": 10590.87, "timestamp": "02:56:30", "text": "次々とピークが待ち構えている"}, {"type": "subtitle", "time": 10594.87, "timestamp": "02:56:34", "text": "血と汗の苦しみを乗り越えて"}, {"type": "subtitle", "time": 10598.95, "timestamp": "02:56:38", "text": "そして涙は最終的に"}, {"type": "subtitle", "time": 10600.269, "timestamp": "02:56:40", "text": "無限"}, {"type": "subtitle", "time": 10603.51, "timestamp": "02:56:43", "text": "山頂に到達した時の喜び。そこには"}, {"type": "subtitle", "time": 10605.03, "timestamp": "02:56:45", "text": "妹がやろうとしていること"}, {"type": "subtitle", "time": 10607.67, "timestamp": "02:56:47", "text": "教えてあげるよ。"}, {"type": "subtitle", "time": 10611.63, "timestamp": "02:56:51", "text": "えっと、あなたの過去は今のあなたを形作っています"}, {"type": "subtitle", "time": 10614.23, "timestamp": "02:56:54", "text": "は。妹が言ったように聞こえる"}, {"type": "subtitle", "time": 10615.79, "timestamp": "02:56:55", "text": "何か"}, {"type": "subtitle", "time": 10618.469, "timestamp": "02:56:58", "text": "その周り。これらの少女たちは私の記録だった"}]
[{"type": "subtitle", "time": 13022.71, "timestamp": "03:37:02", "text": "赤ちゃん。こんにちは"}, {"type": "subtitle", "time": 13024.91, "timestamp": "03:37:04", "text": "私にも少し分けてくれませんか？"}, {"type": "subtitle", "time": 13027.269, "timestamp": "03:37:07", "text": "怖い？そう、そういう人たちは"}, {"type": "subtitle", "time": 13029.83, "timestamp": "03:37:09", "text": "参加しても構いませんよ。久しぶりですね"}, {"type": "subtitle", "time": 13033.03, "timestamp": "03:37:13", "text": "私がこのようなことをしたからです。私はしません"}, {"type": "subtitle", "time": 13070.55, "timestamp": "03:37:50", "text": "じゃあ、どれだけひどいか聞きたいんだけど"}]
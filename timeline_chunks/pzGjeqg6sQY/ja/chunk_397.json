[{"type": "subtitle", "time": 23836.708, "timestamp": "06:37:16", "text": "それ。いや、下降傾向にあるよね？その"}, {"type": "subtitle", "time": 23839.03, "timestamp": "06:37:19", "text": "下降している。それは私が望んでいることではない。それ"}, {"type": "subtitle", "time": 23841.27, "timestamp": "06:37:21", "text": "それは私が望むものではない。なんてこった。それは違う"}, {"type": "subtitle", "time": 23842.948, "timestamp": "06:37:22", "text": "私が欲しいもの。"}, {"type": "subtitle", "time": 23844.788, "timestamp": "06:37:24", "text": "なぜこのような動作をするのでしょうか？ああ、それは"}, {"type": "subtitle", "time": 23847.43, "timestamp": "06:37:27", "text": "マイナスに転じる。だから、"}, {"type": "subtitle", "time": 23848.75, "timestamp": "06:37:28", "text": "フリップ"}, {"type": "subtitle", "time": 23852.708, "timestamp": "06:37:32", "text": "戻る。ああ、元に戻ってるよ。知っている"}, {"type": "subtitle", "time": 23854.948, "timestamp": "06:37:34", "text": "逆さまになっている。いいえ。どうすればいいですか？"}, {"type": "subtitle", "time": 23878.91, "timestamp": "06:37:58", "text": "引き続き適用"}]
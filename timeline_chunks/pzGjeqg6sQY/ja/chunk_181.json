[{"type": "subtitle", "time": 10860.95, "timestamp": "03:01:00", "text": "ああ、だって昨日のこの時間頃私は"}, {"type": "subtitle", "time": 10876.51, "timestamp": "03:01:16", "text": "[音楽]"}, {"type": "subtitle", "time": 10878.79, "timestamp": "03:01:18", "text": "水分補給する。水を飲ませてください。私の"}, {"type": "subtitle", "time": 10882.11, "timestamp": "03:01:22", "text": "水が溢れそうなので、"}, {"type": "subtitle", "time": 10886.309, "timestamp": "03:01:26", "text": "再、私はそうしなければならない"}, {"type": "subtitle", "time": 10887.2, "timestamp": "03:01:27", "text": "えっと、これ"}, {"type": "subtitle", "time": 10895.11, "timestamp": "03:01:35", "text": "えっと、4になるよ"}, {"type": "subtitle", "time": 10897.51, "timestamp": "03:01:37", "text": "時間だよ、わかるだろ。終わらせるべきでしょうか"}, {"type": "subtitle", "time": 10900.79, "timestamp": "03:01:40", "text": "今日の配信は？"}, {"type": "subtitle", "time": 10906.71, "timestamp": "03:01:46", "text": "考える？皆さんはどう思いますか？それは それは"}, {"type": "subtitle", "time": 10909.87, "timestamp": "03:01:49", "text": "それは絶好の機会です"}, {"type": "subtitle", "time": 10912.469, "timestamp": "03:01:52", "text": "終わり。明日朝に続きをします。"}, {"type": "subtitle", "time": 10916.71, "timestamp": "03:01:56", "text": "わかった。午前5時。こんにちは。疲れましたか？えっと、"}, {"type": "subtitle", "time": 10919.03, "timestamp": "03:01:59", "text": "眠くて疲れている。十分な"}]
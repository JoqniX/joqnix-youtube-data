[{"type": "subtitle", "time": 8420.349, "timestamp": "02:20:20", "text": "[音楽]"}, {"type": "subtitle", "time": 8422.95, "timestamp": "02:20:22", "text": "刺激、スパマーはいますか"}, {"type": "subtitle", "time": 8424.99, "timestamp": "02:20:24", "text": "あなたのDiscordサーバーですか？何？"}, {"type": "subtitle", "time": 8427.99, "timestamp": "02:20:27", "text": "どこ？今は自分の"}, {"type": "subtitle", "time": 8430.349, "timestamp": "02:20:30", "text": "不和"}, {"type": "subtitle", "time": 8448.91, "timestamp": "02:20:48", "text": "意地悪な犬は行儀よくする"}, {"type": "subtitle", "time": 8452.75, "timestamp": "02:20:52", "text": "きちんと？信じられないことに、答えはノーです。ああ、私は"}, {"type": "subtitle", "time": 8455.15, "timestamp": "02:20:55", "text": "私"}, {"type": "subtitle", "time": 8458.07, "timestamp": "02:20:58", "text": "バカ。そうそう。昨日はスパマーだった。いいえ。"}]
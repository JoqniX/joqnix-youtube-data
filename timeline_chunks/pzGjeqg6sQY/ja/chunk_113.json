[{"type": "subtitle", "time": 6780.27, "timestamp": "01:53:00", "text": "持っている"}, {"type": "subtitle", "time": 6788.709, "timestamp": "01:53:08", "text": "えっと、今のところ私のアンカー値、砂値"}, {"type": "subtitle", "time": 6791.99, "timestamp": "01:53:11", "text": "12です。ありがたいことに、彼らはそれを差し引きませんでした。"}, {"type": "subtitle", "time": 6795.03, "timestamp": "01:53:15", "text": "もしそれが差し引かれたら、私は超"}, {"type": "subtitle", "time": 6803.149, "timestamp": "01:53:23", "text": "に。だから私のその弦"}, {"type": "subtitle", "time": 6807.75, "timestamp": "01:53:27", "text": "削除された。それでおしまい。それから彼らは"}, {"type": "subtitle", "time": 6810.95, "timestamp": "01:53:30", "text": "削除した。それでおしまい。"}, {"type": "subtitle", "time": 6828.55, "timestamp": "01:53:48", "text": "おお。今日ツイートしたように、"}, {"type": "subtitle", "time": 6831.189, "timestamp": "01:53:51", "text": "来たらすごく気をつけるつもり"}, {"type": "subtitle", "time": 6834.75, "timestamp": "01:53:54", "text": "プラットフォームガイドライン規則OSと"}]
[{"type": "subtitle", "time": 4620.55, "timestamp": "01:17:00", "text": "私たちは文字通り、その1つを探しています"}, {"type": "subtitle", "time": 4623.31, "timestamp": "01:17:03", "text": "最後の宝箱"}, {"type": "subtitle", "time": 4628.99, "timestamp": "01:17:08", "text": "再生して、こうなります"}, {"type": "subtitle", "time": 4631.35, "timestamp": "01:17:11", "text": "100%。だから私はガイドに従っている"}, {"type": "subtitle", "time": 4633.669, "timestamp": "01:17:13", "text": "そして、ウォークスルービデオなど"}, {"type": "subtitle", "time": 4642.78, "timestamp": "01:17:22", "text": "何でも。人気ページ。私たちはこれを"}, {"type": "subtitle", "time": 4644.03, "timestamp": "01:17:24", "text": "[音楽]"}, {"type": "subtitle", "time": 4647.27, "timestamp": "01:17:27", "text": "良い。魚みたいなやつ。待って、"}, {"type": "subtitle", "time": 4652.03, "timestamp": "01:17:32", "text": "から？"}, {"type": "subtitle", "time": 4655.87, "timestamp": "01:17:35", "text": "えっと、あなたはどちらのご出身ですか？私は"}, {"type": "subtitle", "time": 4659.53, "timestamp": "01:17:39", "text": "空間。私はVで、それを開示することはできません"}, {"type": "subtitle", "time": 4663.55, "timestamp": "01:17:43", "text": "[音楽]"}, {"type": "subtitle", "time": 4666.51, "timestamp": "01:17:46", "text": "私はインド出身です。"}, {"type": "subtitle", "time": 4678.91, "timestamp": "01:17:58", "text": "[音楽]"}]
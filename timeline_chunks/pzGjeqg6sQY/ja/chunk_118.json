[{"type": "subtitle", "time": 7081.189, "timestamp": "01:58:01", "text": "キャプション 考えるだけでも不安になる"}, {"type": "subtitle", "time": 7083.75, "timestamp": "01:58:03", "text": "食事や睡眠について。来て。あなた"}, {"type": "subtitle", "time": 7085.589, "timestamp": "01:58:05", "text": "彼らを追いかけるようなことはすべきではない"}, {"type": "subtitle", "time": 7088.39, "timestamp": "01:58:08", "text": "あなたの年齢で。何を、なぜあなたは"}, {"type": "subtitle", "time": 7090.189, "timestamp": "01:58:10", "text": "手に入れなければならない"}, {"type": "subtitle", "time": 7092.79, "timestamp": "01:58:12", "text": "1つ？私が好きな人は"}, {"type": "subtitle", "time": 7096.91, "timestamp": "01:58:16", "text": "1つ。あなたが好きな人。疑問符。"}, {"type": "subtitle", "time": 7099.43, "timestamp": "01:58:19", "text": "はい。男性にとってそれは普通ではないことは分かっています"}, {"type": "subtitle", "time": 7102.629, "timestamp": "01:58:22", "text": "恋人を見るために私の耳を。でも、僕は彼女を愛している。"}, {"type": "subtitle", "time": 7104.87, "timestamp": "01:58:24", "text": "彼女は私を拒絶し続けている。彼女は"}, {"type": "subtitle", "time": 7107.589, "timestamp": "01:58:27", "text": "印象的な反響。これで私の終わりだ。"}, {"type": "subtitle", "time": 7110.229, "timestamp": "01:58:30", "text": "サリー、私、ホラー系のおもちゃしか持ってないの。ラウンド"}, {"type": "subtitle", "time": 7112.35, "timestamp": "01:58:32", "text": "丸顔。どころか"}, {"type": "subtitle", "time": 7114.709, "timestamp": "01:58:34", "text": "印象的な。もし私がエコーを得ることができたら"}, {"type": "subtitle", "time": 7116.39, "timestamp": "01:58:36", "text": "標準を意味する。もしかしたら彼女は私に許してくれるかもしれない"}, {"type": "subtitle", "time": 7119.51, "timestamp": "01:58:39", "text": "チャンスはある。ああ、あなたのシャバ。聞こえます"}, {"type": "subtitle", "time": 7120.95, "timestamp": "01:58:40", "text": "少し奇妙だ。毎日"}, {"type": "subtitle", "time": 7122.99, "timestamp": "01:58:42", "text": "熱心な女性を見る"}, {"type": "subtitle", "time": 7125.75, "timestamp": "01:58:45", "text": "こだま。彼女は"}, {"type": "subtitle", "time": 7127.83, "timestamp": "01:58:47", "text": "彼女の心をつかむ唯一の方法は"}, {"type": "subtitle", "time": 7132.149, "timestamp": "01:58:52", "text": "それを試みる素晴らしい決意"}, {"type": "subtitle", "time": 7135.03, "timestamp": "01:58:55", "text": "あなたは最高の状態ではありません。君は本当に"}, {"type": "subtitle", "time": 7137.99, "timestamp": "01:58:57", "text": "しっかり休むべきだ。知るか"}]
[{"type": "subtitle", "time": 23040.39, "timestamp": "06:24:00", "text": "画像。私ができることは、箱を置くことです"}, {"type": "subtitle", "time": 23041.788, "timestamp": "06:24:01", "text": "と共に"}, {"type": "subtitle", "time": 23044.19, "timestamp": "06:24:04", "text": "透明性をもって"}, {"type": "subtitle", "time": 23047.948, "timestamp": "06:24:07", "text": "色。私たちが欲しいのは、箱が"}, {"type": "subtitle", "time": 23054.39, "timestamp": "06:24:14", "text": "前面と背面に表示する画像。右？"}, {"type": "subtitle", "time": 23057.35, "timestamp": "06:24:17", "text": "だから、私ができることはおそらく"}, {"type": "subtitle", "time": 23060.11, "timestamp": "06:24:20", "text": "新しい"}, {"type": "subtitle", "time": 23065.31, "timestamp": "06:24:25", "text": "アニメーションの外側のボックス"}, {"type": "subtitle", "time": 23074.11, "timestamp": "06:24:34", "text": "色を変えて"}, {"type": "subtitle", "time": 23077.05, "timestamp": "06:24:37", "text": "変更"}, {"type": "subtitle", "time": 23084.47, "timestamp": "06:24:44", "text": "位置。ああ、私たちは相対的にすべてを行わなければなりません"}, {"type": "subtitle", "time": 23088.868, "timestamp": "06:24:48", "text": "それら。ああ、わかりました。相対的なものであれば、"}, {"type": "subtitle", "time": 23091.788, "timestamp": "06:24:51", "text": "私はそうしたい"}, {"type": "subtitle", "time": 23095.67, "timestamp": "06:24:55", "text": "2つと画像は相対的に"}, {"type": "subtitle", "time": 23097.628, "timestamp": "06:24:57", "text": "ポジション"}]
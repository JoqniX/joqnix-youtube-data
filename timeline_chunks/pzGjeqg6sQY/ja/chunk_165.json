[{"type": "subtitle", "time": 9912.11, "timestamp": "02:45:12", "text": "そこには。少なくとも私たちは"}, {"type": "subtitle", "time": 9914.95, "timestamp": "02:45:14", "text": "宝箱。私は幸せです"}, {"type": "subtitle", "time": 9947.71, "timestamp": "02:45:47", "text": "ああ、デバイスのモデルが見つかりましたね。"}, {"type": "subtitle", "time": 9952.87, "timestamp": "02:45:52", "text": "わかった。ここで彼女は自分のスタンプを使った"}, {"type": "subtitle", "time": 9955.63, "timestamp": "02:45:55", "text": "この手紙が保管されている場所のどこか。"}, {"type": "subtitle", "time": 9958.23, "timestamp": "02:45:58", "text": "シーシャは最近トップにランクインしました"}]
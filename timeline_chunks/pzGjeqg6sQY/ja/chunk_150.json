[{"type": "subtitle", "time": 9001.07, "timestamp": "02:30:01", "text": "みんな"}, {"type": "subtitle", "time": 9002.91, "timestamp": "02:30:02", "text": "あなたの"}, {"type": "subtitle", "time": 9005.07, "timestamp": "02:30:05", "text": "容疑者"}, {"type": "subtitle", "time": 9014.95, "timestamp": "02:30:14", "text": "スポーン。よし、それで良さそうだ。どれの"}, {"type": "subtitle", "time": 9017.469, "timestamp": "02:30:17", "text": "これらのレシピの中で"}, {"type": "subtitle", "time": 9020.99, "timestamp": "02:30:20", "text": "うーん、スパイシーな"}, {"type": "subtitle", "time": 9023.59, "timestamp": "02:30:23", "text": "カロップ？ご覧のとおり、人々は"}, {"type": "subtitle", "time": 9025.99, "timestamp": "02:30:25", "text": "些細な質問に興味がある。多分"}, {"type": "subtitle", "time": 9028.79, "timestamp": "02:30:28", "text": "このようなクエストをもっと追加できます"}, {"type": "subtitle", "time": 9031.83, "timestamp": "02:30:31", "text": "1つ。面白い事実をいくつか追加するのは良いことです"}, {"type": "subtitle", "time": 9035.03, "timestamp": "02:30:35", "text": "コンテンツの正確性を維持する。彼はそれは"}, {"type": "subtitle", "time": 9037.83, "timestamp": "02:30:37", "text": "右。このQ&Aは私に"}, {"type": "subtitle", "time": 9041.429, "timestamp": "02:30:41", "text": "次号。それでは、さらに詳しく見ていきましょう。見逃した"}, {"type": "subtitle", "time": 9043.63, "timestamp": "02:30:43", "text": "一人で歩くことでたくさんのもの"}, {"type": "subtitle", "time": 9046.71, "timestamp": "02:30:46", "text": "前に。これらの報酬を受け取ってください。あなた"}, {"type": "subtitle", "time": 9047.79, "timestamp": "02:30:47", "text": "獲得した"}, {"type": "subtitle", "time": 9051.59, "timestamp": "02:30:51", "text": "彼ら。あなたのフィードバックは大変参考になります。"}, {"type": "subtitle", "time": 9053.19, "timestamp": "02:30:53", "text": "もう一度お願いしてもよろしいでしょうか"}, {"type": "subtitle", "time": 9055.91, "timestamp": "02:30:55", "text": "未来？もうこれ以上は面倒くさい"}, {"type": "subtitle", "time": 9058.95, "timestamp": "02:30:58", "text": "Jocknikはこんな感じが好き。手伝うのは構わない"}]
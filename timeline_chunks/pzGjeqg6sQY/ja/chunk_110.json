[{"type": "subtitle", "time": 6602.629, "timestamp": "01:50:02", "text": "待って、待って、待って、待って。システムアンカー"}, {"type": "subtitle", "time": 6604.189, "timestamp": "01:50:04", "text": "良い人生を築く"}, {"type": "subtitle", "time": 6606.87, "timestamp": "01:50:06", "text": "雰囲気。科学の合計得点は12点です。"}, {"type": "subtitle", "time": 6609.55, "timestamp": "01:50:09", "text": "はい、12個あります。ペナルティによると"}, {"type": "subtitle", "time": 6611.99, "timestamp": "01:50:11", "text": "条項、アンカーライフワークは"}, {"type": "subtitle", "time": 6614.35, "timestamp": "01:50:14", "text": "対応するポイント削減。"}, {"type": "subtitle", "time": 6617.149, "timestamp": "01:50:17", "text": "わかった。えっと、もし私が"}, {"type": "subtitle", "time": 6619.99, "timestamp": "01:50:19", "text": "導入点はマイナス-3です。"}, {"type": "subtitle", "time": 6621.91, "timestamp": "01:50:21", "text": "わかった。待って。"}, {"type": "subtitle", "time": 6623.83, "timestamp": "01:50:23", "text": "自然回復。回復期間は"}, {"type": "subtitle", "time": 6625.83, "timestamp": "01:50:25", "text": "7日間。最後から始めると、"}, {"type": "subtitle", "time": 6628.149, "timestamp": "01:50:28", "text": "内部で発生する変動はありません"}, {"type": "subtitle", "time": 6630.07, "timestamp": "01:50:30", "text": "7日間の自然期間で、3つのポイントが"}, {"type": "subtitle", "time": 6633.27, "timestamp": "01:50:33", "text": "自然回復など。まで"}, {"type": "subtitle", "time": 6635.669, "timestamp": "01:50:35", "text": "12ポイントすべてが回復したら、"}, {"type": "subtitle", "time": 6637.87, "timestamp": "01:50:37", "text": "ポイントは回復されます。のために"}, {"type": "subtitle", "time": 6641.83, "timestamp": "01:50:41", "text": "例えば、ああ、わかりました。控訴と賠償。"}, {"type": "subtitle", "time": 6643.51, "timestamp": "01:50:43", "text": "アンカーはこれを通じてアピールできる"}, {"type": "subtitle", "time": 6645.43, "timestamp": "01:50:45", "text": "カスタマーサービス窓口。顧客"}, {"type": "subtitle", "time": 6647.59, "timestamp": "01:50:47", "text": "検出されたポイントをレビューして復元します"}, {"type": "subtitle", "time": 6650.709, "timestamp": "01:50:50", "text": "実際の控除額に基づいて。わかった。平凡さ"}, {"type": "subtitle", "time": 6653.27, "timestamp": "01:50:53", "text": "条項。パーティションエラーライブは"}, {"type": "subtitle", "time": 6656.109, "timestamp": "01:50:56", "text": "ゾーニング規制を意味するものではありません。わかった。"}, {"type": "subtitle", "time": 6659.27, "timestamp": "01:50:59", "text": "異常な人気が疑われる"}]
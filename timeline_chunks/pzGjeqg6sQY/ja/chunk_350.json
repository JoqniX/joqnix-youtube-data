[{"type": "subtitle", "time": 21001.11, "timestamp": "05:50:01", "text": "通知を受け取れるものであれば何でも構いません。もし私が"}, {"type": "subtitle", "time": 21002.788, "timestamp": "05:50:02", "text": "ストリームで新しいゲームをプレイしています。"}, {"type": "subtitle", "time": 21005.51, "timestamp": "05:50:05", "text": "まずはウェブサイト上で告知してください。できました"}, {"type": "subtitle", "time": 21007.27, "timestamp": "05:50:07", "text": "モバイルアプリか何かを作ってみてはどうでしょう。あなたはできる"}, {"type": "subtitle", "time": 21010.31, "timestamp": "05:50:10", "text": "そのようなプッシュ通知を受け取るなど、"}, {"type": "subtitle", "time": 21011.868, "timestamp": "05:50:11", "text": "など。私は"}, {"type": "subtitle", "time": 21015.75, "timestamp": "05:50:15", "text": "知る。もっと深く掘り下げる準備はできていますが、"}, {"type": "subtitle", "time": 21018.47, "timestamp": "05:50:18", "text": "それには手伝ってくれる人が必要です。"}, {"type": "subtitle", "time": 21024.948, "timestamp": "05:50:24", "text": "コーディング。私はコーディングを知らないし、"}, {"type": "subtitle", "time": 21027.97, "timestamp": "05:50:27", "text": "問題が多すぎる。"}, {"type": "subtitle", "time": 21029.58, "timestamp": "05:50:29", "text": "[笑い]"}, {"type": "subtitle", "time": 21031.51, "timestamp": "05:50:31", "text": "[音楽]"}, {"type": "subtitle", "time": 21034.948, "timestamp": "05:50:34", "text": "でも、ウェブサイトのおかげで私は"}, {"type": "subtitle", "time": 21037.11, "timestamp": "05:50:37", "text": "ウェブサイト関連やカスタム関連"}, {"type": "subtitle", "time": 21039.03, "timestamp": "05:50:39", "text": "そして全ては私が望んだから"}, {"type": "subtitle", "time": 21041.75, "timestamp": "05:50:41", "text": "ウェブサイトは、"}, {"type": "subtitle", "time": 21044.27, "timestamp": "05:50:44", "text": "すべてに関連する"}, {"type": "subtitle", "time": 21047.11, "timestamp": "05:50:47", "text": "私にとって、それがファンアートやその他であるかどうか"}, {"type": "subtitle", "time": 21049.03, "timestamp": "05:50:49", "text": "未来。私はこうしたい"}, {"type": "subtitle", "time": 21051.67, "timestamp": "05:50:51", "text": "ファンアート広告をアップロードして"}, {"type": "subtitle", "time": 21054.948, "timestamp": "05:50:54", "text": "サイト上のすべて、またはもしあなたが"}, {"type": "subtitle", "time": 21058.47, "timestamp": "05:50:58", "text": "Twitterや投稿からリンクを共有する"}]
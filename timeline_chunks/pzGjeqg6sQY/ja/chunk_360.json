[{"type": "subtitle", "time": 21600.58, "timestamp": "06:00:00", "text": "いい考えがある。 [音楽]"}, {"type": "subtitle", "time": 21603.28, "timestamp": "06:00:03", "text": "[音楽] 私ができることは、フェードインではなく"}, {"type": "subtitle", "time": 21607.36, "timestamp": "06:00:07", "text": "私ができることは、フェードインではなく 争うのではなく、"}, {"type": "subtitle", "time": 21610.36, "timestamp": "06:00:10", "text": "争うのではなく、 ミリ秒なので、より速く表示されます。まるで"}, {"type": "subtitle", "time": 21620.43, "timestamp": "06:00:20", "text": "これ。えっと、聖なるウェブサイトはどのように機能するのですか？"}, {"type": "subtitle", "time": 21624.868, "timestamp": "06:00:24", "text": "また？彼らはこれを持っている。ぼやけていて"}, {"type": "subtitle", "time": 21626.948, "timestamp": "06:00:26", "text": "視界に入ってきますよね？ぼやけて"}, {"type": "subtitle", "time": 21630.47, "timestamp": "06:00:30", "text": "視界に入ってくる。ぼやけている。ぼやけている。ぼやけている。どうやって"}]
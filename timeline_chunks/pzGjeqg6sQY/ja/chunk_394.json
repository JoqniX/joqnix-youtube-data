[{"type": "subtitle", "time": 23641.35, "timestamp": "06:34:01", "text": "ストリーム。クッキーのためにDを取っておこう。"}, {"type": "subtitle", "time": 23645.15, "timestamp": "06:34:05", "text": "何？こんにちは、配信へようこ​​そ。"}, {"type": "subtitle", "time": 23647.23, "timestamp": "06:34:07", "text": "ランダマイザー。こんにちは。"}, {"type": "subtitle", "time": 23650.11, "timestamp": "06:34:10", "text": "こんにちは。良い"}, {"type": "subtitle", "time": 23652.708, "timestamp": "06:34:12", "text": "夕方。よし、あと10個くらいあるよ"}, {"type": "subtitle", "time": 23654.99, "timestamp": "06:34:14", "text": "数分後には、えっと、行かなくちゃ"}, {"type": "subtitle", "time": 23657.19, "timestamp": "06:34:17", "text": "どこかで会議に出席して"}, {"type": "subtitle", "time": 23660.868, "timestamp": "06:34:20", "text": "もの。それでは、V を装着します。"}, {"type": "subtitle", "time": 23665.27, "timestamp": "06:34:25", "text": "1～2時間以内には戻ります。"}, {"type": "subtitle", "time": 23668.548, "timestamp": "06:34:28", "text": "それに、音楽の授業も受けているんです。それで、"}, {"type": "subtitle", "time": 23672.07, "timestamp": "06:34:32", "text": "ええ、2時間くらいかな。病気"}, {"type": "subtitle", "time": 23675.99, "timestamp": "06:34:35", "text": "戻ってきます。 8は8より前だったのか？私はそこにいます。"}, {"type": "subtitle", "time": 23679.11, "timestamp": "06:34:39", "text": "さて、元の作業に戻りましょう。えっと、"}, {"type": "subtitle", "time": 23681.948, "timestamp": "06:34:41", "text": "アニメーショングループズーム"}, {"type": "chat", "time": 23693.205, "timestamp": "06:34:53", "author": "@ionomyself", "avatar": "https://yt4.ggpht.com/rj_4etD1zl9z355fBAbotBRNwdzb6hGprkYR7TbRFVqfRFUl3t50cJ8SM4OG2lVzupX6oBYi3w=s64-c-k-c0x00ffffff-no-rj", "message": "Say my name"}]
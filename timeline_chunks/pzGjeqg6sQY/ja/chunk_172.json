[{"type": "subtitle", "time": 10321.83, "timestamp": "02:52:01", "text": "彼女は忙しいので、質問するチャンスだ"}, {"type": "subtitle", "time": 10328.87, "timestamp": "02:52:08", "text": "今。これらの写真は私の学校のものです"}, {"type": "subtitle", "time": 10331.99, "timestamp": "02:52:11", "text": "日。なぜあなたは手に入れた後不満だったのですか"}, {"type": "subtitle", "time": 10334.51, "timestamp": "02:52:14", "text": "鬼の中へ"}, {"type": "subtitle", "time": 10336.71, "timestamp": "02:52:16", "text": "アカデミー？突然"}, {"type": "subtitle", "time": 10344.15, "timestamp": "02:52:24", "text": "人々。痛みの痛み。実際の痛み"}, {"type": "subtitle", "time": 10345.87, "timestamp": "02:52:25", "text": "偽装して"}, {"type": "subtitle", "time": 10349.34, "timestamp": "02:52:29", "text": "運。いつも感じていた"}, {"type": "subtitle", "time": 10359.15, "timestamp": "02:52:39", "text": "降伏。うん。さよなら。あくびをしているので"}, {"type": "subtitle", "time": 10362.71, "timestamp": "02:52:42", "text": "多くの。恥ずかしさと途方に暮れる気持ちになった。する"}, {"type": "subtitle", "time": 10364.07, "timestamp": "02:52:44", "text": "その気持ち、分かりますか？あなたのような"}, {"type": "subtitle", "time": 10365.59, "timestamp": "02:52:45", "text": "先にバーがあることを知っている。ただ"}, {"type": "subtitle", "time": 10368.51, "timestamp": "02:52:48", "text": "突破口を開く。はい、そう思います"}, {"type": "subtitle", "time": 10370.79, "timestamp": "02:52:50", "text": "あなた。それが私の感じたことで、私を助けてくれました"}, {"type": "subtitle", "time": 10378.389, "timestamp": "02:52:58", "text": "畏敬の念を抱かせる高さ。比較に囚われないでください"}]
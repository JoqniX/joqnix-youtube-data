[{"type": "subtitle", "time": 4461.55, "timestamp": "01:14:21", "text": "ええと、次の地域"}, {"type": "subtitle", "time": 4467.47, "timestamp": "01:14:27", "text": "つまり、この後、私は"}, {"type": "subtitle", "time": 4469.87, "timestamp": "01:14:29", "text": "ウィングをする"}, {"type": "subtitle", "time": 4474.75, "timestamp": "01:14:34", "text": "ベイタイとポートシティ"}, {"type": "subtitle", "time": 4477.59, "timestamp": "01:14:37", "text": "ほとばしる。中央平原の次は"}, {"type": "subtitle", "time": 4480.39, "timestamp": "01:14:40", "text": "私のようにサイドクエストをクリアする"}, {"type": "subtitle", "time": 4482.47, "timestamp": "01:14:42", "text": "玄祥。"}, {"type": "subtitle", "time": 4484.75, "timestamp": "01:14:44", "text": "宝箱が3つあります"}, {"type": "subtitle", "time": 4488.99, "timestamp": "01:14:48", "text": "残り。合計すると"}, {"type": "subtitle", "time": 4492.79, "timestamp": "01:14:52", "text": "10％。ええ、だいたいそんなところです。私は手に入れた"}, {"type": "subtitle", "time": 4494.83, "timestamp": "01:14:54", "text": "その他すべて"}, {"type": "subtitle", "time": 4498.87, "timestamp": "01:14:58", "text": "ショーの開催地域も同様です。私は、えっと、やらなければならないことがあります"}]
[{"type": "subtitle", "time": 7321.31, "timestamp": "02:02:01", "text": "彼らは"}, {"type": "subtitle", "time": 7323.39, "timestamp": "02:02:03", "text": "学校。"}, {"type": "subtitle", "time": 7326.83, "timestamp": "02:02:06", "text": "ニース。知っていますか"}, {"type": "subtitle", "time": 7329.589, "timestamp": "02:02:09", "text": "協力者？その通り。特別なものの一部"}, {"type": "subtitle", "time": 7332.43, "timestamp": "02:02:12", "text": "アイドル。私たちは"}, {"type": "subtitle", "time": 7339.47, "timestamp": "02:02:19", "text": "私をボランティアとして"}, {"type": "subtitle", "time": 7342.31, "timestamp": "02:02:22", "text": "遊ぶ。はい。私たちは観察して"}, {"type": "subtitle", "time": 7347.51, "timestamp": "02:02:27", "text": "だから彼らはこれを楽しみにしている"}, {"type": "subtitle", "time": 7349.31, "timestamp": "02:02:29", "text": "リスト。私が試してみます。手伝います"}, {"type": "subtitle", "time": 7362.87, "timestamp": "02:02:42", "text": "エコー。 GパフのPの移動を歌う。これ"}, {"type": "subtitle", "time": 7363.85, "timestamp": "02:02:43", "text": "は"}, {"type": "subtitle", "time": 7366.51, "timestamp": "02:02:46", "text": "[音楽]"}]
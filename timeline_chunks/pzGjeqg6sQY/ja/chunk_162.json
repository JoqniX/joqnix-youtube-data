[{"type": "subtitle", "time": 9720.79, "timestamp": "02:42:00", "text": "山の上の方へとどんどん登って"}, {"type": "subtitle", "time": 9724.23, "timestamp": "02:42:04", "text": "この山を共に登ろう。それは贈り物です"}, {"type": "subtitle", "time": 9727.99, "timestamp": "02:42:07", "text": "隠された欲望は私にとって障害となる。ああ、そう"}, {"type": "subtitle", "time": 9730.309, "timestamp": "02:42:10", "text": "彼女が恐らく"}, {"type": "subtitle", "time": 9732.309, "timestamp": "02:42:12", "text": "一歩引いて振り返るように"}, {"type": "subtitle", "time": 9738.71, "timestamp": "02:42:18", "text": "去った。しかし彼女はエラを打つことを隠した"}, {"type": "subtitle", "time": 9740.23, "timestamp": "02:42:20", "text": "これらの場所。ご迷惑をおかけして申し訳ありません。"}, {"type": "subtitle", "time": 9743.83, "timestamp": "02:42:23", "text": "私もただの共鳴器だった。大丈夫。"}, {"type": "subtitle", "time": 9745.75, "timestamp": "02:42:25", "text": "ここは本当に美しい場所だ。 A"}, {"type": "subtitle", "time": 9748.95, "timestamp": "02:42:28", "text": "ほとんど誰も来ないが、ほとんど誰も来ない"}, {"type": "subtitle", "time": 9751.75, "timestamp": "02:42:31", "text": "それを鑑賞するためにここに来ました。レックスはゆっくりと作業する。"}, {"type": "subtitle", "time": 9753.27, "timestamp": "02:42:33", "text": "この登山を"}, {"type": "subtitle", "time": 9765.78, "timestamp": "02:42:45", "text": "[音楽]"}, {"type": "subtitle", "time": 9769.23, "timestamp": "02:42:49", "text": "[拍手]"}, {"type": "subtitle", "time": 9771.51, "timestamp": "02:42:51", "text": "移動中。あなたはできないことを知っていましたか？"}]
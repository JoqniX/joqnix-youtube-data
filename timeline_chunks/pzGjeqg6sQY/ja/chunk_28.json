[{"type": "subtitle", "time": 1682.0, "timestamp": "00:28:02", "text": "それ。 X 疑問符。えっと、"}, {"type": "subtitle", "time": 1699.07, "timestamp": "00:28:19", "text": "念のため確認ですが、"}, {"type": "subtitle", "time": 1701.75, "timestamp": "00:28:21", "text": "補給箱のことですよね？うん。どれでも"}, {"type": "subtitle", "time": 1703.47, "timestamp": "00:28:23", "text": "進捗？"}, {"type": "subtitle", "time": 1706.389, "timestamp": "00:28:26", "text": "いいえ。問題は、私がすべてを手に入れたということです"}, {"type": "subtitle", "time": 1709.31, "timestamp": "00:28:29", "text": "今。確かに光がある"}, {"type": "subtitle", "time": 1712.07, "timestamp": "00:28:32", "text": "何もない。明かりが灯れば、もう何も残っていないだろう。それから"}, {"type": "subtitle", "time": 1714.19, "timestamp": "00:28:34", "text": "どうですか"}]
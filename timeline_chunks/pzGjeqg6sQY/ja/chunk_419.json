[{"type": "subtitle", "time": 25142.468, "timestamp": "06:59:02", "text": "レベル？わかった。アジアはアジアを手に入れ、そして"}, {"type": "subtitle", "time": 25145.51, "timestamp": "06:59:05", "text": "中央にロビーを作成する。ああ、わかりました。"}, {"type": "subtitle", "time": 25147.27, "timestamp": "06:59:07", "text": "ホラーゲームをプレイしている。はい。あなたはそれを望んでいる"}, {"type": "subtitle", "time": 25149.35, "timestamp": "06:59:09", "text": "プライベートなものとして？"}, {"type": "subtitle", "time": 25150.708, "timestamp": "06:59:10", "text": "はい、もちろん。それはそうあるべきだ"}, {"type": "subtitle", "time": 25152.07, "timestamp": "06:59:12", "text": "プライベートだと思います。そうそう。ええ、"}, {"type": "subtitle", "time": 25153.07, "timestamp": "06:59:13", "text": "コース。私"}, {"type": "subtitle", "time": 25158.868, "timestamp": "06:59:18", "text": "実際、私たちは"}, {"type": "subtitle", "time": 25161.59, "timestamp": "06:59:21", "text": "最初はセレスティアに尋ねて"}, {"type": "subtitle", "time": 25164.31, "timestamp": "06:59:24", "text": "Armsusもそれをプレイする。でも私は"}, {"type": "subtitle", "time": 25166.548, "timestamp": "06:59:26", "text": "ほら、もっと楽しいのは、"}, {"type": "subtitle", "time": 25169.03, "timestamp": "06:59:29", "text": "もし私たち二人が私とジョキッシュ帝国だけだったら"}, {"type": "subtitle", "time": 25171.67, "timestamp": "06:59:31", "text": "怖くてプレイする"}, {"type": "subtitle", "time": 25174.15, "timestamp": "06:59:34", "text": "私たちのような人間は、かなり簡単に怖がってしまう。"}, {"type": "subtitle", "time": 25176.708, "timestamp": "06:59:36", "text": "ほぼその通りです。だから私はそういう感じだった"}, {"type": "subtitle", "time": 25180.708, "timestamp": "06:59:40", "text": "良いコンテンツになるだろう。それでいきましょう。"}, {"type": "subtitle", "time": 25184.19, "timestamp": "06:59:44", "text": "うん。うん。ああ、大変だ。待てません。"}, {"type": "subtitle", "time": 25186.948, "timestamp": "06:59:46", "text": "助けが必要です。じゃあ、2つくらい取った方がいいかな？"}, {"type": "subtitle", "time": 25189.03, "timestamp": "06:59:49", "text": "2人用ロビー？うん、プレイするべきだ"}, {"type": "subtitle", "time": 25191.75, "timestamp": "06:59:51", "text": "2人用ロビー。はい、2人用です。"}, {"type": "subtitle", "time": 25193.51, "timestamp": "06:59:53", "text": "ロビーコードか何かがあると思う"}, {"type": "subtitle", "time": 25196.788, "timestamp": "06:59:56", "text": "何か。だから、隠しておきます。うん。"}]
[{"type": "subtitle", "time": 9960.07, "timestamp": "02:46:00", "text": "学校のエンジンショーで彼女の高さを設定した"}, {"type": "subtitle", "time": 9961.349, "timestamp": "02:46:01", "text": "省庁で働くことについて"}, {"type": "subtitle", "time": 9964.15, "timestamp": "02:46:04", "text": "発達。彼女は本当に遠くまで来たものだ。"}, {"type": "subtitle", "time": 9965.91, "timestamp": "02:46:05", "text": "誇りに思わずにはいられないし、"}, {"type": "subtitle", "time": 9968.23, "timestamp": "02:46:08", "text": "羨ましい。一方、私はまだ考えている"}, {"type": "subtitle", "time": 9970.95, "timestamp": "02:46:10", "text": "自分のキャリアパスを切り開く。シーシャトーク"}, {"type": "subtitle", "time": 9972.79, "timestamp": "02:46:12", "text": "彼女について、そして彼女のベストを設定する"}, {"type": "subtitle", "time": 9975.83, "timestamp": "02:46:15", "text": "今日もまた。彼女は合格するだろう"}, {"type": "subtitle", "time": 9977.67, "timestamp": "02:46:17", "text": "カルロス役を演じます。彼女はいつも"}, {"type": "subtitle", "time": 9979.99, "timestamp": "02:46:19", "text": "献身的で、休憩も取らない"}, {"type": "subtitle", "time": 9982.87, "timestamp": "02:46:22", "text": "休暇中に私と一緒に過ごしてくれる人。私"}, {"type": "subtitle", "time": 9985.429, "timestamp": "02:46:25", "text": "彼女の幸運が信じられないが、"}, {"type": "subtitle", "time": 9987.23, "timestamp": "02:46:27", "text": "これ以上嬉しいことはない"}, {"type": "subtitle", "time": 9988.75, "timestamp": "02:46:28", "text": "彼女。"}, {"type": "subtitle", "time": 9990.83, "timestamp": "02:46:30", "text": "良い"}, {"type": "subtitle", "time": 9994.87, "timestamp": "02:46:34", "text": "手紙。彼女は私に何も話さなかった"}, {"type": "subtitle", "time": 9997.83, "timestamp": "02:46:37", "text": "直接会って。これは一体何ですか？私はこれを作りました"}, {"type": "subtitle", "time": 10000.269, "timestamp": "02:46:40", "text": "子供の頃のモデルとして私の"}, {"type": "subtitle", "time": 10004.59, "timestamp": "02:46:44", "text": "目標。ショーの音の中で最高の学校"}, {"type": "subtitle", "time": 10007.349, "timestamp": "02:46:47", "text": "印象的な。それが私が欲しい学校です"}, {"type": "subtitle", "time": 10010.15, "timestamp": "02:46:50", "text": "子供たちを放置する。私は"}, {"type": "subtitle", "time": 10012.75, "timestamp": "02:46:52", "text": "運良く入学できた。なぜそう言うのですか"}, {"type": "subtitle", "time": 10015.51, "timestamp": "02:46:55", "text": "それで？それは昨年起こったことなので、"}, {"type": "subtitle", "time": 10018.67, "timestamp": "02:46:58", "text": "先生が教えてくれた重要なポイント"}]
[{"type": "subtitle", "time": 12304.72, "timestamp": "03:25:04", "text": "サイコロ。私は誰に"}, {"type": "subtitle", "time": 12306.11, "timestamp": "03:25:06", "text": "[音楽]"}, {"type": "subtitle", "time": 12308.12, "timestamp": "03:25:08", "text": "コーラが欲しい"}, {"type": "subtitle", "time": 12309.95, "timestamp": "03:25:09", "text": "[音楽]"}, {"type": "subtitle", "time": 12312.19, "timestamp": "03:25:12", "text": "花？これは"}, {"type": "subtitle", "time": 12334.79, "timestamp": "03:25:34", "text": "それ。そうすれば彼女のレベルを上げられる"}, {"type": "subtitle", "time": 12336.75, "timestamp": "03:25:36", "text": "直立"}, {"type": "subtitle", "time": 12339.309, "timestamp": "03:25:39", "text": "今。"}, {"type": "subtitle", "time": 12347.229, "timestamp": "03:25:47", "text": "私"}, {"type": "subtitle", "time": 12355.87, "timestamp": "03:25:55", "text": "いいえ、私は"}, {"type": "subtitle", "time": 12359.83, "timestamp": "03:25:59", "text": "でも心配です。いいえ、私はレベルアップします"}]
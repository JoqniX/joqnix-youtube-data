[{"type": "subtitle", "time": 5344.51, "timestamp": "01:29:04", "text": "[音楽]"}, {"type": "subtitle", "time": 5347.51, "timestamp": "01:29:07", "text": "それ。私たちは違うと思う、"}, {"type": "subtitle", "time": 5350.669, "timestamp": "01:29:10", "text": "遊び方が違います"}, {"type": "subtitle", "time": 5354.35, "timestamp": "01:29:14", "text": "ゲームなど。"}, {"type": "subtitle", "time": 5361.47, "timestamp": "01:29:21", "text": "うん、ストーリーを楽しんでるし"}, {"type": "subtitle", "time": 5364.669, "timestamp": "01:29:24", "text": "伝承と"}, {"type": "subtitle", "time": 5366.27, "timestamp": "01:29:26", "text": "以来"}, {"type": "subtitle", "time": 5369.55, "timestamp": "01:29:29", "text": "これは"}, {"type": "subtitle", "time": 5371.47, "timestamp": "01:29:31", "text": "楽しい"}, {"type": "subtitle", "time": 5375.55, "timestamp": "01:29:35", "text": "ゲーム、私はある種の"}, {"type": "subtitle", "time": 5381.669, "timestamp": "01:29:41", "text": "すべてを終わらせたかった"}, {"type": "subtitle", "time": 5384.99, "timestamp": "01:29:44", "text": "オフ"}, {"type": "subtitle", "time": 5388.99, "timestamp": "01:29:48", "text": "えーと、1.0。だから私は"}, {"type": "subtitle", "time": 5393.229, "timestamp": "01:29:53", "text": "彼は嘘をついた。私はこの物語を楽しんでいます"}, {"type": "subtitle", "time": 5396.39, "timestamp": "01:29:56", "text": "けれど。バカ、全部終わらせるよ"}]
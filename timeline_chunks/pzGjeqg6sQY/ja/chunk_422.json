[{"type": "subtitle", "time": 25321.75, "timestamp": "07:02:01", "text": "上。それから、準備を始めなければならない。"}, {"type": "subtitle", "time": 25325.51, "timestamp": "07:02:05", "text": "準備ができません。あなたはできません？準備ができていません。"}, {"type": "subtitle", "time": 25329.11, "timestamp": "07:02:09", "text": "私はできません。あなただと思いますよ。ああ、あなたはただ"}, {"type": "subtitle", "time": 25332.31, "timestamp": "07:02:12", "text": "機器を選択するか、何かを選択してください。"}, {"type": "subtitle", "time": 25334.39, "timestamp": "07:02:14", "text": "わかった。ああ、それで私たちは誰が"}, {"type": "subtitle", "time": 25335.99, "timestamp": "07:02:15", "text": "カメラを持って、誰が"}, {"type": "subtitle", "time": 25338.31, "timestamp": "07:02:18", "text": "EMFリーダー？"}, {"type": "subtitle", "time": 25342.468, "timestamp": "07:02:22", "text": "ああ、電磁波。つまり、EMFリーダーはEMFは、"}, {"type": "subtitle", "time": 25345.27, "timestamp": "07:02:25", "text": "えっと、放射線って"}, {"type": "subtitle", "time": 25348.07, "timestamp": "07:02:28", "text": "幽霊の葉。だから、それが"}, {"type": "subtitle", "time": 25351.99, "timestamp": "07:02:31", "text": "まさにその通りだと思います。"}, {"type": "subtitle", "time": 25354.39, "timestamp": "07:02:34", "text": "あるいは何か。うん。幽霊へ。それで"}, {"type": "subtitle", "time": 25358.628, "timestamp": "07:02:38", "text": "えっと、懐中電灯を持っていくと思います。"}, {"type": "subtitle", "time": 25361.83, "timestamp": "07:02:41", "text": "懐中電灯と私たちは はい、なぜなら"}, {"type": "subtitle", "time": 25368.788, "timestamp": "07:02:48", "text": "H です。ええ、どう思いますか"}, {"type": "subtitle", "time": 25372.07, "timestamp": "07:02:52", "text": "購入方法は？私にはお金がありません。何"}, {"type": "subtitle", "time": 25375.27, "timestamp": "07:02:55", "text": "はい。ああ、それは単に追加で買うためだよ"}, {"type": "subtitle", "time": 25376.868, "timestamp": "07:02:56", "text": "もの。君は普通の子供だと思う"}]
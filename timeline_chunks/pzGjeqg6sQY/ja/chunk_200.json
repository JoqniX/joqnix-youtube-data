[{"type": "subtitle", "time": 12007.95, "timestamp": "03:20:07", "text": "何てことだ。私は死んだ。死にかけた。ほとんど"}, {"type": "subtitle", "time": 12010.469, "timestamp": "03:20:10", "text": "亡くなった。何てことだ。なんて素晴らしい"}, {"type": "subtitle", "time": 12019.03, "timestamp": "03:20:19", "text": "私はこのレベルで生き残らなければならない。その"}, {"type": "subtitle", "time": 12022.309, "timestamp": "03:20:22", "text": "世界の第4段階すべて。"}]
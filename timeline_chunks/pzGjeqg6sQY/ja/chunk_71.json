[{"type": "subtitle", "time": 4264.229, "timestamp": "01:11:04", "text": "はい、そこにはありません。どうすればロックを解除できますか？"}, {"type": "subtitle", "time": 4267.63, "timestamp": "01:11:07", "text": "あなたは行く あなたは行く"}, {"type": "subtitle", "time": 4271.83, "timestamp": "01:11:11", "text": "ここ。ゲンショーへ行きなさい。あなたは"}, {"type": "subtitle", "time": 4274.229, "timestamp": "01:11:14", "text": "開拓者協会そしてあなたは"}, {"type": "subtitle", "time": 4277.51, "timestamp": "01:11:17", "text": "探検したり、いろいろしたりする。パイオニアのレベルを"}, {"type": "subtitle", "time": 4281.75, "timestamp": "01:11:21", "text": "レベル3か2か4くらい。私は推測する"}, {"type": "subtitle", "time": 4287.75, "timestamp": "01:11:27", "text": "マッパー。パイオニア協会に加入しました"}, {"type": "subtitle", "time": 4306.99, "timestamp": "01:11:46", "text": "ということで、遅れて"}]
[{"type": "subtitle", "time": 10020.71, "timestamp": "02:47:00", "text": "強調した。知らなかった。だから彼女は"}, {"type": "subtitle", "time": 10022.07, "timestamp": "02:47:02", "text": "私は十分賢いと思っていた"}, {"type": "subtitle", "time": 10024.429, "timestamp": "02:47:04", "text": "認めた。"}, {"type": "subtitle", "time": 10027.349, "timestamp": "02:47:07", "text": "ああ、わかりました。ママ、私は何を見るのが楽しみです"}, {"type": "subtitle", "time": 10029.389, "timestamp": "02:47:09", "text": "他に彼女は"}, {"type": "subtitle", "time": 10031.389, "timestamp": "02:47:11", "text": "店。"}, {"type": "subtitle", "time": 10059.63, "timestamp": "02:47:39", "text": "わかった。何が"}, {"type": "subtitle", "time": 10063.269, "timestamp": "02:47:43", "text": "これ？プリン。この崖を登ってみろ。"}, {"type": "subtitle", "time": 10065.75, "timestamp": "02:47:45", "text": "私たちは自分たちだけでやっていくしかない。前方。それは"}, {"type": "subtitle", "time": 10068.55, "timestamp": "02:47:48", "text": "今の私たち。いい子にしてあげて。家に帰りなさい。"}, {"type": "subtitle", "time": 10070.15, "timestamp": "02:47:50", "text": "いい子にしててね。わかった。おいしいものを持って行きます"}, {"type": "subtitle", "time": 10072.349, "timestamp": "02:47:52", "text": "飲み物とお菓子"}]
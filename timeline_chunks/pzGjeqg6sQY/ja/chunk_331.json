[{"type": "subtitle", "time": 19863.67, "timestamp": "05:31:03", "text": "モバイルでも、つまり"}, {"type": "subtitle", "time": 19866.628, "timestamp": "05:31:06", "text": "問題が発生しています。押すことはできません"}, {"type": "subtitle", "time": 19868.83, "timestamp": "05:31:08", "text": "送信"}, {"type": "subtitle", "time": 19871.19, "timestamp": "05:31:11", "text": "メッセージ。うん。遅いものに関しては"}, {"type": "subtitle", "time": 19873.03, "timestamp": "05:31:13", "text": "うん。うん。うん。うん。直したい"}, {"type": "subtitle", "time": 19883.43, "timestamp": "05:31:23", "text": "それ。私ができることはウェブです"}, {"type": "subtitle", "time": 19884.45, "timestamp": "05:31:24", "text": "フック型。"}, {"type": "subtitle", "time": 19885.628, "timestamp": "05:31:25", "text": "[音楽]"}, {"type": "subtitle", "time": 19899.27, "timestamp": "05:31:39", "text": "えっと、600ピクセルってどういう意味ですか？"}, {"type": "subtitle", "time": 19902.83, "timestamp": "05:31:42", "text": "パディングを追加したい"}, {"type": "subtitle", "time": 19904.99, "timestamp": "05:31:44", "text": "それ。"}, {"type": "subtitle", "time": 19908.11, "timestamp": "05:31:48", "text": "30. あ、待って。"}, {"type": "subtitle", "time": 19912.31, "timestamp": "05:31:52", "text": "60. ちょっと待って、ウェブフックのフォームはどこにあるの？"}, {"type": "subtitle", "time": 19914.948, "timestamp": "05:31:54", "text": "形態の種類。ああ、ここからですね。わかった。わかった。"}, {"type": "subtitle", "time": 19918.75, "timestamp": "05:31:58", "text": "わかった。いいえ、私はバカです。わかった。だから、私はあなたが欲しい"}]
[{"type": "subtitle", "time": 25080.788, "timestamp": "06:58:00", "text": "彼女は私の膝の上に座っています。私"}, {"type": "subtitle", "time": 25082.31, "timestamp": "06:58:02", "text": "理由はわからない。そして私のノートパソコンは"}, {"type": "subtitle", "time": 25084.948, "timestamp": "06:58:04", "text": "私からとても遠い。彼女は"}, {"type": "subtitle", "time": 25088.07, "timestamp": "06:58:08", "text": "私の膝の上に。どうすればいいのかわからない。"}, {"type": "subtitle", "time": 25089.99, "timestamp": "06:58:09", "text": "わかった。わかった。わかった。誰が作るのか"}, {"type": "subtitle", "time": 25091.27, "timestamp": "06:58:11", "text": "ロビー？あなたは作成するつもりですか"}, {"type": "subtitle", "time": 25093.59, "timestamp": "06:58:13", "text": "いいえ？ええ、作成することに問題はありません"}, {"type": "subtitle", "time": 25096.468, "timestamp": "06:58:16", "text": "ロビー。うーん、それからみんな、"}, {"type": "subtitle", "time": 25099.59, "timestamp": "06:58:19", "text": "忘れないでください、両方とも見ることができます"}, {"type": "subtitle", "time": 25102.31, "timestamp": "06:58:22", "text": "私たちの視点からすると、マルチウォッチのリンクは"}, {"type": "subtitle", "time": 25104.948, "timestamp": "06:58:24", "text": "以下に記載します。リンクを次のように配置しましたか？"}, {"type": "subtitle", "time": 25108.07, "timestamp": "06:58:28", "text": "良い？いいえ、していません。ちょうどあなたの"}, {"type": "subtitle", "time": 25110.468, "timestamp": "06:58:30", "text": "ストリームへのリンクは説明欄にあります。"}, {"type": "subtitle", "time": 25114.39, "timestamp": "06:58:34", "text": "ええ、それもいいですね。それで大丈夫です。"}, {"type": "subtitle", "time": 25117.03, "timestamp": "06:58:37", "text": "はい。彼のPOVを見たいなら"}, {"type": "subtitle", "time": 25120.788, "timestamp": "06:58:40", "text": "パフの視点、それからトゥランをチェックできます"}, {"type": "subtitle", "time": 25123.75, "timestamp": "06:58:43", "text": "説明文をご確認ください。それは彼のものです"}, {"type": "subtitle", "time": 25126.548, "timestamp": "06:58:46", "text": "そこはPOV（一人称視点）です。はい、トゥラン。はい、私たちは"}, {"type": "subtitle", "time": 25130.628, "timestamp": "06:58:50", "text": "それ。あなたはジョク先輩が大好きですね。了解しました。おお、"}, {"type": "subtitle", "time": 25133.27, "timestamp": "06:58:53", "text": "承知いたしました。"}, {"type": "subtitle", "time": 25135.19, "timestamp": "06:58:55", "text": "ハワイ。"}, {"type": "subtitle", "time": 25138.628, "timestamp": "06:58:58", "text": "はい。わかった。待って、これをどうやって変更するの？"}]
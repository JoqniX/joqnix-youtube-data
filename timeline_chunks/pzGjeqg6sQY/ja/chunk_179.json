[{"type": "subtitle", "time": 10740.309, "timestamp": "02:59:00", "text": "彼女。私は彼女に対等に挑む"}, {"type": "subtitle", "time": 10745.79, "timestamp": "02:59:05", "text": "参加したいですか？"}, {"type": "subtitle", "time": 10748.349, "timestamp": "02:59:08", "text": "自分？"}, {"type": "subtitle", "time": 10751.03, "timestamp": "02:59:11", "text": "わかった。一緒に山に登ろう。"}, {"type": "subtitle", "time": 10752.469, "timestamp": "02:59:12", "text": "私があなたにメッセージを送る頃には"}, {"type": "subtitle", "time": 10763.03, "timestamp": "02:59:23", "text": "くそ。私たちは別の山に登るつもりです"}, {"type": "subtitle", "time": 10769.429, "timestamp": "02:59:29", "text": "このクエストは"}]
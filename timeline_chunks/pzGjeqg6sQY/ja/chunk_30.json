[{"type": "subtitle", "time": 1800.23, "timestamp": "00:30:00", "text": "そこには。誰かを探している、みんな"}, {"type": "subtitle", "time": 1825.789, "timestamp": "00:30:25", "text": "[音楽]"}, {"type": "subtitle", "time": 1834.63, "timestamp": "00:30:34", "text": "しかし、それでも表示されるだろう。もしそれが"}, {"type": "subtitle", "time": 1844.029, "timestamp": "00:30:44", "text": "つまり、私はそれを手に入れたということです"}, {"type": "subtitle", "time": 1858.63, "timestamp": "00:30:58", "text": "神。私はその子と話しました。うん。"}]
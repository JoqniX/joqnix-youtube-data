[{"type": "subtitle", "time": 2369.39, "timestamp": "00:39:29", "text": "あなたのところへ行かせてください"}, {"type": "subtitle", "time": 2385.349, "timestamp": "00:39:45", "text": "[音楽]"}, {"type": "subtitle", "time": 2388.15, "timestamp": "00:39:48", "text": "あなたは椅子に横たわっています。待って、"}, {"type": "subtitle", "time": 2389.63, "timestamp": "00:39:49", "text": "得る"}, {"type": "subtitle", "time": 2394.63, "timestamp": "00:39:54", "text": "上。私は眠ってしまい、倒れています。私"}, {"type": "subtitle", "time": 2396.43, "timestamp": "00:39:56", "text": "まるで"}, {"type": "subtitle", "time": 2398.349, "timestamp": "00:39:58", "text": "文字通り"}]
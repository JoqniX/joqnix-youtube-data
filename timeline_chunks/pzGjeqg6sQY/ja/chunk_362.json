[{"type": "subtitle", "time": 21723.83, "timestamp": "06:02:03", "text": "逆にすればいいの？"}, {"type": "subtitle", "time": 21726.01, "timestamp": "06:02:06", "text": "逆方向にするにはどうすればいいですか？"}, {"type": "subtitle", "time": 21735.11, "timestamp": "06:02:15", "text": "その周り？ああ、マイナス5だ。ああ、否定的"}, {"type": "subtitle", "time": 21738.11, "timestamp": "06:02:18", "text": "そして、肯定的である。ああ、それは"}, {"type": "subtitle", "time": 21741.99, "timestamp": "06:02:21", "text": "もの。ネガティブ。えっと、もうすぐ"}, {"type": "subtitle", "time": 21752.07, "timestamp": "06:02:32", "text": "の上。スキル機能も搭載されています。"}, {"type": "subtitle", "time": 21754.51, "timestamp": "06:02:34", "text": "私たちは必要としません"}, {"type": "subtitle", "time": 21763.23, "timestamp": "06:02:43", "text": "特徴。ええと、50ミリ秒にすることができます。"}, {"type": "subtitle", "time": 21765.47, "timestamp": "06:02:45", "text": "いいえ、"}, {"type": "subtitle", "time": 21771.07, "timestamp": "06:02:51", "text": "MS。いや、おそらく300ミリ秒くらいだろう。 300ルック"}, {"type": "subtitle", "time": 21774.83, "timestamp": "06:02:54", "text": "良い。緩和することで変化を起こすことができる"}]
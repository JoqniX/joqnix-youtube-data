[{"type": "subtitle", "time": 1084.31, "timestamp": "00:18:04", "text": "[音楽]"}, {"type": "subtitle", "time": 1086.71, "timestamp": "00:18:06", "text": "歌っている時も、私は"}, {"type": "subtitle", "time": 1087.85, "timestamp": "00:18:07", "text": "聞こえは"}, {"type": "subtitle", "time": 1090.75, "timestamp": "00:18:10", "text": "[音楽]"}, {"type": "subtitle", "time": 1092.43, "timestamp": "00:18:12", "text": "最悪。"}, {"type": "subtitle", "time": 1095.75, "timestamp": "00:18:15", "text": "でも、感じようとすると"}, {"type": "subtitle", "time": 1098.23, "timestamp": "00:18:18", "text": "歌っていると、まるで自分が歌っているような気分になる"}, {"type": "subtitle", "time": 1104.15, "timestamp": "00:18:24", "text": "良い。しかし、他の人が耳にする話は、とてもひどいものだ。"}, {"type": "subtitle", "time": 1106.39, "timestamp": "00:18:26", "text": "心の中で歌っているような気がする"}, {"type": "subtitle", "time": 1108.549, "timestamp": "00:18:28", "text": "良い。"}, {"type": "subtitle", "time": 1114.87, "timestamp": "00:18:34", "text": "しかし、私の声が聞こえるとき"}, {"type": "subtitle", "time": 1118.51, "timestamp": "00:18:38", "text": "えっと、私のところから再起動します"}, {"type": "subtitle", "time": 1121.39, "timestamp": "00:18:41", "text": "えっと、私の"}, {"type": "subtitle", "time": 1125.47, "timestamp": "00:18:45", "text": "音声が聞こえるときに口"}, {"type": "subtitle", "time": 1130.71, "timestamp": "00:18:50", "text": "他の音 声 音は何であれ"}]
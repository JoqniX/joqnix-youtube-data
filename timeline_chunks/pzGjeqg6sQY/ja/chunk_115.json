[{"type": "subtitle", "time": 6902.87, "timestamp": "01:55:02", "text": "うん。はい、もう60秒以上経ちましたよね？"}, {"type": "subtitle", "time": 6904.589, "timestamp": "01:55:04", "text": "私は始めなければならない"}, {"type": "subtitle", "time": 6907.87, "timestamp": "01:55:07", "text": "信じられないほどストリーミング。私は手に入れた 私は私は"}, {"type": "subtitle", "time": 6909.47, "timestamp": "01:55:09", "text": "注意深い。"}, {"type": "subtitle", "time": 6928.87, "timestamp": "01:55:28", "text": "最悪だ。よし、私たちは生きている。こんにちは。"}, {"type": "subtitle", "time": 6932.79, "timestamp": "01:55:32", "text": "えっと、すみません、私は文字通り"}, {"type": "subtitle", "time": 6941.229, "timestamp": "01:55:41", "text": "信じて、でもそうだよ"}, {"type": "subtitle", "time": 6949.47, "timestamp": "01:55:49", "text": "こんにちは、そして"}, {"type": "subtitle", "time": 6953.95, "timestamp": "01:55:53", "text": "すべて。こんにちは。とにかく、私はただ"}, {"type": "subtitle", "time": 6957.669, "timestamp": "01:55:57", "text": "えっと、私が"}, {"type": "subtitle", "time": 6959.99, "timestamp": "01:55:59", "text": "ビデオの確認が完了しました。終了 I"}]
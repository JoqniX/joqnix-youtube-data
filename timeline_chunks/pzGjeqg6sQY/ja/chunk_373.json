[{"type": "subtitle", "time": 22381.708, "timestamp": "06:13:01", "text": "D？少しやってみよう"}, {"type": "subtitle", "time": 22385.35, "timestamp": "06:13:05", "text": "パディング。右に移動するにはどうすればいいですか？"}, {"type": "subtitle", "time": 22387.27, "timestamp": "06:13:07", "text": "よし、じゃあ真ん中に置こう。"}, {"type": "subtitle", "time": 22393.67, "timestamp": "06:13:13", "text": "マージン。気をつけろよ。私たちはただ"}, {"type": "subtitle", "time": 22395.75, "timestamp": "06:13:15", "text": "アニメーションエンジンをチェックする"}, {"type": "subtitle", "time": 22399.11, "timestamp": "06:13:19", "text": "私が使っているウェブサイト作成ツールはWeb Studioというものです。"}, {"type": "subtitle", "time": 22402.07, "timestamp": "06:13:22", "text": "そうすれば私は学ぶことができます"}, {"type": "subtitle", "time": 22403.99, "timestamp": "06:13:23", "text": "アニメーションエンジンをテストしているだけなので"}, {"type": "subtitle", "time": 22407.27, "timestamp": "06:13:27", "text": "将来的にはアニメーションを追加できます"}, {"type": "subtitle", "time": 22418.99, "timestamp": "06:13:38", "text": "[音楽]"}, {"type": "subtitle", "time": 22421.75, "timestamp": "06:13:41", "text": "うん。わかった。ズームイン効果。見てみましょう。"}, {"type": "subtitle", "time": 22433.23, "timestamp": "06:13:53", "text": "アニメーショングループ。必要なインスタンスを追加してください"}, {"type": "subtitle", "time": 22435.83, "timestamp": "06:13:55", "text": "アニメーション化する。私は、"}, {"type": "subtitle", "time": 22438.59, "timestamp": "06:13:58", "text": "この男は"}]
[{"type": "subtitle", "time": 2111.069, "timestamp": "00:35:11", "text": "えっと、あなた"}, {"type": "subtitle", "time": 2125.67, "timestamp": "00:35:25", "text": "何？なぜ彼の作品はこんな風なのか？わかった。"}, {"type": "subtitle", "time": 2128.19, "timestamp": "00:35:28", "text": "つまり、私は行く必要がないということです"}, {"type": "subtitle", "time": 2130.43, "timestamp": "00:35:30", "text": "グエ"}, {"type": "subtitle", "time": 2136.03, "timestamp": "00:35:36", "text": "合格。わかった。きっとこの辺りにあるはずだ。"}, {"type": "subtitle", "time": 2145.349, "timestamp": "00:35:45", "text": "雲の崖の記念碑的なすべてのもの"}, {"type": "subtitle", "time": 2146.27, "timestamp": "00:35:46", "text": "は"}]
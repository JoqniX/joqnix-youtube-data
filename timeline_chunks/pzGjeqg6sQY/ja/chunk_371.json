[{"type": "subtitle", "time": 22261.91, "timestamp": "06:11:01", "text": "[音楽]"}, {"type": "subtitle", "time": 22264.07, "timestamp": "06:11:04", "text": "中空の面は、"}, {"type": "subtitle", "time": 22271.54, "timestamp": "06:11:11", "text": "1つ？依然として"}, {"type": "subtitle", "time": 22274.27, "timestamp": "06:11:14", "text": "[音楽]"}, {"type": "subtitle", "time": 22277.43, "timestamp": "06:11:17", "text": "ああ、この物にも"}, {"type": "subtitle", "time": 22278.67, "timestamp": "06:11:18", "text": "ズーム"}, {"type": "subtitle", "time": 22281.43, "timestamp": "06:11:21", "text": "効果。ああ、もしあなたが携帯電話を使っているなら、"}, {"type": "subtitle", "time": 22283.99, "timestamp": "06:11:23", "text": "それは、"}, {"type": "subtitle", "time": 22286.03, "timestamp": "06:11:26", "text": "画像は1枚ずつ再生されます"}, {"type": "subtitle", "time": 22300.47, "timestamp": "06:11:40", "text": "ああ、ズームのやり方を覚えなきゃ。"}, {"type": "subtitle", "time": 22304.43, "timestamp": "06:11:44", "text": "えっと、画像ズームですよね？やってみよう"}, {"type": "subtitle", "time": 22308.83, "timestamp": "06:11:48", "text": "それ。私はテストをしています"}, {"type": "subtitle", "time": 22312.19, "timestamp": "06:11:52", "text": "ウェブサイトのテスト"}, {"type": "subtitle", "time": 22314.548, "timestamp": "06:11:54", "text": "ページ。あ、待って。テストページがあります。"}, {"type": "subtitle", "time": 22318.39, "timestamp": "06:11:58", "text": "ああ、それなら使えます。うん。ここ。では、"}]
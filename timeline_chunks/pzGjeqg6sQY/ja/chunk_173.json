[{"type": "subtitle", "time": 10380.07, "timestamp": "02:53:00", "text": "他人に自分自身を見せる。自分自身に集中する"}, {"type": "subtitle", "time": 10382.55, "timestamp": "02:53:02", "text": "そして、どれだけ遠くまで行けるかを確認するために一歩下がって"}, {"type": "subtitle", "time": 10385.349, "timestamp": "02:53:05", "text": "あなたはやって来た。彼女は"}, {"type": "subtitle", "time": 10388.63, "timestamp": "02:53:08", "text": "私にそう言った。これってすごく共感できるよね。"}, {"type": "subtitle", "time": 10390.99, "timestamp": "02:53:10", "text": "私はそれを持っていきます"}, {"type": "subtitle", "time": 10393.75, "timestamp": "02:53:13", "text": "自分自身。 「ごめんなさい」と言う。彼女は"}, {"type": "subtitle", "time": 10396.83, "timestamp": "02:53:16", "text": "より賢い方。こんなことになってごめんなさい"}, {"type": "subtitle", "time": 10399.79, "timestamp": "02:53:19", "text": "ぺちゃくちゃ喋ってる。大丈夫。"}, {"type": "subtitle", "time": 10401.91, "timestamp": "02:53:21", "text": "よっしゃ。映画をスキップします。一つしかない"}, {"type": "subtitle", "time": 10404.469, "timestamp": "02:53:24", "text": "私たちが確認する場所。ああ、最後"}]
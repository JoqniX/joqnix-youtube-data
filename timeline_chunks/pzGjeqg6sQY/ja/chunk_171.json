[{"type": "subtitle", "time": 10260.309, "timestamp": "02:51:00", "text": "えっと、彼女は「仕事中」って言ったわよ。私はそうできなかった"}, {"type": "subtitle", "time": 10262.79, "timestamp": "02:51:02", "text": "嬉しいけど、とにかく、私にはわからない"}, {"type": "subtitle", "time": 10265.309, "timestamp": "02:51:05", "text": "私がやりたいこと。わかった。"}, {"type": "subtitle", "time": 10268.309, "timestamp": "02:51:08", "text": "シーシャは最初はためらっていたものの、"}, {"type": "subtitle", "time": 10271.75, "timestamp": "02:51:11", "text": "彼女は結局、急な斜面を這い上がっていった"}, {"type": "subtitle", "time": 10273.99, "timestamp": "02:51:13", "text": "私と一緒に。このような状況に達した後"}, {"type": "subtitle", "time": 10275.83, "timestamp": "02:51:15", "text": "一緒にいると背が高く、彼女が"}, {"type": "subtitle", "time": 10277.75, "timestamp": "02:51:17", "text": "そう簡単に引き下がらないだろう。"}, {"type": "subtitle", "time": 10285.389, "timestamp": "02:51:25", "text": "[音楽]"}, {"type": "subtitle", "time": 10290.15, "timestamp": "02:51:30", "text": "あくびをするためのle。眠すぎる"}, {"type": "subtitle", "time": 10291.75, "timestamp": "02:51:31", "text": "そうでなければ彼女の足は"}, {"type": "subtitle", "time": 10298.63, "timestamp": "02:51:38", "text": "勉強から少し離れて家に帰る。"}, {"type": "subtitle", "time": 10300.07, "timestamp": "02:51:40", "text": "こんなにたくさんの人を見たことがない"}, {"type": "subtitle", "time": 10303.71, "timestamp": "02:51:43", "text": "教科書と一貫して文学"}, {"type": "subtitle", "time": 10308.23, "timestamp": "02:51:48", "text": "一年中寝室として使う。学校のいじめっ子"}, {"type": "subtitle", "time": 10311.67, "timestamp": "02:51:51", "text": "恐ろしいに違いない。しかしシーシャは"}, {"type": "subtitle", "time": 10314.389, "timestamp": "02:51:54", "text": "彼女は楽しんでいるようだ。私はただそう思わない"}, {"type": "subtitle", "time": 10316.23, "timestamp": "02:51:56", "text": "彼女が突然狂気に陥った理由を理解する"}, {"type": "subtitle", "time": 10319.51, "timestamp": "02:51:59", "text": "試験で満点を取った後の気分。私は取るべき"}]
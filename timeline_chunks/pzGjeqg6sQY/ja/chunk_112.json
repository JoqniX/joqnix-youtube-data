[{"type": "subtitle", "time": 6721.95, "timestamp": "01:52:01", "text": "法律。法定品のインフレ"}, {"type": "subtitle", "time": 6725.589, "timestamp": "01:52:05", "text": "電子商取引のライブ配信における軽微な違反について"}, {"type": "subtitle", "time": 6727.03, "timestamp": "01:52:07", "text": "ストリーミング配信。一般的な暴力"}, {"type": "subtitle", "time": 6728.95, "timestamp": "01:52:08", "text": "電子商取引のライブストリーミング。深刻な"}, {"type": "subtitle", "time": 6749.51, "timestamp": "01:52:29", "text": "真っ直ぐ。だから、私が"}, {"type": "subtitle", "time": 6751.91, "timestamp": "01:52:31", "text": "実際、私が"}, {"type": "subtitle", "time": 6753.75, "timestamp": "01:52:33", "text": "ビデオを見ている。はい、私は"}, {"type": "subtitle", "time": 6756.95, "timestamp": "01:52:36", "text": "リスクを冒したい、そして私の主な目的は"}, {"type": "subtitle", "time": 6762.47, "timestamp": "01:52:42", "text": "ゲームを持っている、いや、持っていない"}, {"type": "subtitle", "time": 6765.91, "timestamp": "01:52:45", "text": "私のゲームだけをキャプチャする方法は、デュアル"}, {"type": "subtitle", "time": 6769.75, "timestamp": "01:52:49", "text": "PCのセットアップと画面には私の"}, {"type": "subtitle", "time": 6773.35, "timestamp": "01:52:53", "text": "デスクトップモニター全体デスクトップデスクトップなので"}, {"type": "subtitle", "time": 6776.629, "timestamp": "01:52:56", "text": "私には自分を守る手段がない"}, {"type": "subtitle", "time": 6778.55, "timestamp": "01:52:58", "text": "つまり、血液を使わなければならないということです。だから私は"}]
[{"type": "subtitle", "time": 24422.27, "timestamp": "06:47:02", "text": "ヤフー月息子と言いたい。ヤフー。"}, {"type": "subtitle", "time": 24426.31, "timestamp": "06:47:06", "text": "ヤフー。そして、鳴り響く。ヤフー。ヤフー。調子はどうですか？"}, {"type": "subtitle", "time": 24428.43, "timestamp": "06:47:08", "text": "みんな"}, {"type": "subtitle", "time": 24430.948, "timestamp": "06:47:10", "text": "何をしているの？それで、"}, {"type": "subtitle", "time": 24432.35, "timestamp": "06:47:12", "text": "えっと、目が覚めた"}, {"type": "subtitle", "time": 24435.75, "timestamp": "06:47:15", "text": "遅い。プラス"}, {"type": "subtitle", "time": 24439.628, "timestamp": "06:47:19", "text": "えーっと、私はストリーミングする予定だったんだけど"}, {"type": "subtitle", "time": 24443.468, "timestamp": "06:47:23", "text": "4、しかししかし"}, {"type": "subtitle", "time": 24446.67, "timestamp": "06:47:26", "text": "好きだけど好き"}, {"type": "subtitle", "time": 24451.43, "timestamp": "06:47:31", "text": "私はまた眠ってしまった。"}, {"type": "subtitle", "time": 24453.91, "timestamp": "06:47:33", "text": "Discordでは少しだけ活動しています。私"}, {"type": "subtitle", "time": 24456.51, "timestamp": "06:47:36", "text": "眠ってしまった"}, {"type": "subtitle", "time": 24461.15, "timestamp": "06:47:41", "text": "また。私をどうしたらいいの？痛み"}, {"type": "subtitle", "time": 24463.23, "timestamp": "06:47:43", "text": "痛み。ええ、そうですね。"}, {"type": "subtitle", "time": 24471.15, "timestamp": "06:47:51", "text": "また？ねえ、私は"}, {"type": "subtitle", "time": 24474.628, "timestamp": "06:47:54", "text": "良い。今日はApex Legendsをプレイします。それで"}, {"type": "subtitle", "time": 24478.03, "timestamp": "06:47:58", "text": "これは"}]
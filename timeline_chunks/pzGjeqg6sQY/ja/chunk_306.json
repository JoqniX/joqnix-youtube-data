[{"type": "subtitle", "time": 18381.75, "timestamp": "05:06:21", "text": "大きな塩の塊が必要だ。はい、私は"}, {"type": "subtitle", "time": 18384.03, "timestamp": "05:06:24", "text": "戻る。私は"}, {"type": "subtitle", "time": 18387.628, "timestamp": "05:06:27", "text": "生きている。戻りました。そして私は"}, {"type": "subtitle", "time": 18401.23, "timestamp": "05:06:41", "text": "ああ、私は"}, {"type": "subtitle", "time": 18402.99, "timestamp": "05:06:42", "text": "起きている。良い"}, {"type": "subtitle", "time": 18405.788, "timestamp": "05:06:45", "text": "朝。寝た"}, {"type": "subtitle", "time": 18410.83, "timestamp": "05:06:50", "text": "電源を切ったら、ここは暑い。私はちょうど"}]
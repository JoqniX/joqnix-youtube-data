[{"type": "subtitle", "time": 962.67, "timestamp": "00:16:02", "text": "時計。"}, {"type": "subtitle", "time": 966.47, "timestamp": "00:16:06", "text": "だから、私は自分の"}, {"type": "subtitle", "time": 967.629, "timestamp": "00:16:07", "text": "私の"}, {"type": "subtitle", "time": 970.069, "timestamp": "00:16:10", "text": "椅子。マウスを触って"}, {"type": "subtitle", "time": 979.87, "timestamp": "00:16:19", "text": "鏡に映った自分の腕が見える"}, {"type": "subtitle", "time": 984.189, "timestamp": "00:16:24", "text": "今。神様、私はとても"}, {"type": "subtitle", "time": 987.71, "timestamp": "00:16:27", "text": "薄い。食べていないからでしょうか？"}, {"type": "subtitle", "time": 990.03, "timestamp": "00:16:30", "text": "きちんと？持っている"}, {"type": "subtitle", "time": 992.189, "timestamp": "00:16:32", "text": "私"}, {"type": "subtitle", "time": 1005.15, "timestamp": "00:16:45", "text": "[音楽]"}, {"type": "subtitle", "time": 1013.389, "timestamp": "00:16:53", "text": "痛み。私は本当にやりたくなかった"}]
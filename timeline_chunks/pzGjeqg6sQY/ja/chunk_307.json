[{"type": "subtitle", "time": 18427.31, "timestamp": "05:07:07", "text": "戻る。"}, {"type": "subtitle", "time": 18429.15, "timestamp": "05:07:09", "text": "こんにちは。それで、"}, {"type": "subtitle", "time": 18431.948, "timestamp": "05:07:11", "text": "うん。皆さんお元気ですか？"}, {"type": "subtitle", "time": 18437.27, "timestamp": "05:07:17", "text": "何をしているの？えっと、申し訳ありませんが、"}, {"type": "subtitle", "time": 18455.51, "timestamp": "05:07:35", "text": "ええ、でも、私はここにいます。だから私たちは"}, {"type": "subtitle", "time": 18456.44, "timestamp": "05:07:36", "text": "から"}, {"type": "subtitle", "time": 18457.788, "timestamp": "05:07:37", "text": "[音楽]"}, {"type": "subtitle", "time": 18461.23, "timestamp": "05:07:41", "text": "時間、私は"}, {"type": "subtitle", "time": 18464.43, "timestamp": "05:07:44", "text": "えっと、授業があるので"}, {"type": "subtitle", "time": 18478.788, "timestamp": "05:07:58", "text": "タイトルにあるように、私は"}]
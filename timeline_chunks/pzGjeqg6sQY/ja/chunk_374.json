[{"type": "subtitle", "time": 22440.99, "timestamp": "06:14:00", "text": "ここ。学ぶ"}, {"type": "subtitle", "time": 22444.39, "timestamp": "06:14:04", "text": "これでよし。私ができることは、"}, {"type": "subtitle", "time": 22451.59, "timestamp": "06:14:11", "text": "アクセント。えっと、新しいのを載せます"}, {"type": "subtitle", "time": 22454.03, "timestamp": "06:14:14", "text": "アニメーション。わからない。"}, {"type": "subtitle", "time": 22457.07, "timestamp": "06:14:17", "text": "えっと、私はこうしたいんです"}, {"type": "subtitle", "time": 22459.708, "timestamp": "06:14:19", "text": "1,000"}, {"type": "subtitle", "time": 22469.91, "timestamp": "06:14:29", "text": "上向き。だから、私はスケールアップしたかったのです"}, {"type": "subtitle", "time": 22470.83, "timestamp": "06:14:30", "text": "それ"}, {"type": "subtitle", "time": 22474.548, "timestamp": "06:14:34", "text": "200パーセント。それはどのようなものになるのでしょうか？さあ"}, {"type": "subtitle", "time": 22476.43, "timestamp": "06:14:36", "text": "実行"}, {"type": "subtitle", "time": 22480.67, "timestamp": "06:14:40", "text": "キャンバス。見てみて。何も動いていない"}, {"type": "subtitle", "time": 22483.59, "timestamp": "06:14:43", "text": "離れて。何も起こっていない。私がやったのか"}, {"type": "subtitle", "time": 22490.12, "timestamp": "06:14:50", "text": "間違っている？"}]
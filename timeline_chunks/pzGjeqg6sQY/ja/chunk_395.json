[{"type": "subtitle", "time": 23701.15, "timestamp": "06:35:01", "text": "1.2 1.2"}, {"type": "subtitle", "time": 23709.19, "timestamp": "06:35:09", "text": "ランダマイザー。今、あなたの名前を言いました。"}, {"type": "subtitle", "time": 23712.75, "timestamp": "06:35:12", "text": "ランダマイザー。私はあなたの"}, {"type": "subtitle", "time": 23714.63, "timestamp": "06:35:14", "text": "名前。あなたの"}, {"type": "subtitle", "time": 23730.07, "timestamp": "06:35:30", "text": "自分？あなたは私にクッキーをくれるでしょう。私は提供する"}, {"type": "subtitle", "time": 23732.31, "timestamp": "06:35:32", "text": "ヘッドパッドを装着してください。ヘッドパッドが届きます"}, {"type": "subtitle", "time": 23744.91, "timestamp": "06:35:44", "text": "逆行する？我が神よ。"}, {"type": "subtitle", "time": 23747.39, "timestamp": "06:35:47", "text": "えっと、これは"}, {"type": "subtitle", "time": 23749.468, "timestamp": "06:35:49", "text": "20歳"}, {"type": "chat", "time": 23751.681, "timestamp": "06:35:51", "author": "@ionomyself", "avatar": "https://yt4.ggpht.com/rj_4etD1zl9z355fBAbotBRNwdzb6hGprkYR7TbRFVqfRFUl3t50cJ8SM4OG2lVzupX6oBYi3w=s64-c-k-c0x00ffffff-no-rj", "message": "It WAS BUFFERING"}, {"type": "subtitle", "time": 23752.19, "timestamp": "06:35:52", "text": "秒。あ、待って。私はそう思った"}, {"type": "subtitle", "time": 23755.11, "timestamp": "06:35:55", "text": "それ。でも、ループはどうやって作るんですか？ヨーヨー"}, {"type": "subtitle", "time": 23757.11, "timestamp": "06:35:57", "text": "効果。"}]
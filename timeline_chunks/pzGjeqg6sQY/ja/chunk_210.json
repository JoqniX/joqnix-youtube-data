[{"type": "subtitle", "time": 12600.79, "timestamp": "03:30:00", "text": "今日は1になるので。"}, {"type": "subtitle", "time": 12603.51, "timestamp": "03:30:03", "text": "もう午前1時になる。寝るよ。もし私が"}, {"type": "subtitle", "time": 12605.429, "timestamp": "03:30:05", "text": "今は寝ないで、私は目を覚まさないから"}, {"type": "subtitle", "time": 12609.429, "timestamp": "03:30:09", "text": "5 か 6 か 6 のとき。それで、ジョーとは何ですか"}, {"type": "subtitle", "time": 12611.91, "timestamp": "03:30:11", "text": "みなさん、さようなら、おやすみなさい。"}, {"type": "subtitle", "time": 12613.51, "timestamp": "03:30:13", "text": "じゃあ、また明日ね。よし、明日"}, {"type": "subtitle", "time": 12625.87, "timestamp": "03:30:25", "text": "[音楽]"}, {"type": "subtitle", "time": 12651.74, "timestamp": "03:30:51", "text": "おい、"}, {"type": "subtitle", "time": 12657.469, "timestamp": "03:30:57", "text": "[音楽]"}]
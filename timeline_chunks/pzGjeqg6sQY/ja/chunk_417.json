[{"type": "subtitle", "time": 25022.23, "timestamp": "06:57:02", "text": "私に作らせる？私は行けます。待って、あなたは"}, {"type": "subtitle", "time": 25023.83, "timestamp": "06:57:03", "text": "プレイしましたか？チュートリアルはありますか、または"}, {"type": "subtitle", "time": 25026.708, "timestamp": "06:57:06", "text": "何か？私はプレイしたことがありません。わかった、"}, {"type": "subtitle", "time": 25028.628, "timestamp": "06:57:08", "text": "いいですか。私の知る限りでは"}, {"type": "subtitle", "time": 25031.03, "timestamp": "06:57:11", "text": "このゲームが何をするのか。こんにちは。こんにちは。どうやって"}, {"type": "subtitle", "time": 25032.39, "timestamp": "06:57:12", "text": "あなたは？今日は良い一日をお過ごしでしょうか。"}, {"type": "subtitle", "time": 25035.99, "timestamp": "06:57:15", "text": "こんにちは。だから、誰かを見たとき"}, {"type": "subtitle", "time": 25038.948, "timestamp": "06:57:18", "text": "このゲームをプレイしてください。えっと、あなたは"}, {"type": "subtitle", "time": 25043.03, "timestamp": "06:57:23", "text": "そういう場所に行くはずだったし、"}, {"type": "subtitle", "time": 25045.27, "timestamp": "06:57:25", "text": "それらの場所の人々は潜在的に"}, {"type": "subtitle", "time": 25047.67, "timestamp": "06:57:27", "text": "幽霊が出る。そこには幽霊のようなものがいて"}, {"type": "subtitle", "time": 25049.91, "timestamp": "06:57:29", "text": "あなたはカメラを持っているし、懐中電灯も持っている。"}, {"type": "subtitle", "time": 25052.07, "timestamp": "06:57:32", "text": "つまり、基本的には特定する必要があるということです"}, {"type": "subtitle", "time": 25053.99, "timestamp": "06:57:33", "text": "幽霊はどんな種類の幽霊なのか"}, {"type": "subtitle", "time": 25056.39, "timestamp": "06:57:36", "text": "なので、写真を撮らなければなりません"}, {"type": "subtitle", "time": 25060.15, "timestamp": "06:57:40", "text": "そして、そうすることで、"}, {"type": "subtitle", "time": 25062.708, "timestamp": "06:57:42", "text": "お金ドルで他のものを買うことができます"}, {"type": "subtitle", "time": 25065.27, "timestamp": "06:57:45", "text": "もの。ああ、そう、そしてそれは続く"}, {"type": "subtitle", "time": 25066.788, "timestamp": "06:57:46", "text": "延々と続く。あなたはさまざまな場所へ行きます"}, {"type": "subtitle", "time": 25068.868, "timestamp": "06:57:48", "text": "そして、あなたは何かを得る。うん。うん。うん。"}, {"type": "subtitle", "time": 25072.788, "timestamp": "06:57:52", "text": "そんな感じ。なるほど。はい。"}]
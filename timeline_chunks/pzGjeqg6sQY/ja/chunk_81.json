[{"type": "subtitle", "time": 4867.75, "timestamp": "01:21:07", "text": "うん。あなたは主にどのゲームをプレイしますか？えっと"}, {"type": "subtitle", "time": 4872.03, "timestamp": "01:21:12", "text": "正直、よくわかりません。私は真剣です"}, {"type": "subtitle", "time": 4875.95, "timestamp": "01:21:15", "text": "場合によります。場合によります"}, {"type": "subtitle", "time": 4878.27, "timestamp": "01:21:18", "text": "推測。"}, {"type": "subtitle", "time": 4882.63, "timestamp": "01:21:22", "text": "ええ、主に状況によりますね。まるで私が"}, {"type": "subtitle", "time": 4884.709, "timestamp": "01:21:24", "text": "例えばマルチプレイヤーゲームの場合"}, {"type": "subtitle", "time": 4887.35, "timestamp": "01:21:27", "text": "何かイベントや催し物がありますか？"}, {"type": "subtitle", "time": 4890.709, "timestamp": "01:21:30", "text": "私はそれをやり遂げようとします"}, {"type": "subtitle", "time": 4892.35, "timestamp": "01:21:32", "text": "まるで"}, {"type": "subtitle", "time": 4895.87, "timestamp": "01:21:35", "text": "まあ、だいたいそんな感じですね"}, {"type": "subtitle", "time": 4899.07, "timestamp": "01:21:39", "text": "でも、私の好きなゲームはわからない"}, {"type": "subtitle", "time": 4902.189, "timestamp": "01:21:42", "text": "私がプレイするゲームはどれも本当に"}, {"type": "subtitle", "time": 4910.11, "timestamp": "01:21:50", "text": "お気に入りはあなたのお気に入りです"}, {"type": "subtitle", "time": 4913.83, "timestamp": "01:21:53", "text": "ゲーム。ニース。ああ、カリビオだ。私は"}, {"type": "subtitle", "time": 4917.11, "timestamp": "01:21:57", "text": "カリ・バヨを楽しんでいます。はい、それは私のものです"}]
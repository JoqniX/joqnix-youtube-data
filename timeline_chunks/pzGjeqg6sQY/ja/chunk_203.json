[{"type": "subtitle", "time": 12182.389, "timestamp": "03:23:02", "text": "私の小惑星を無駄にする。あのね？さあ"}, {"type": "subtitle", "time": 12185.19, "timestamp": "03:23:05", "text": "そのままにしておいてください。わかった。"}, {"type": "subtitle", "time": 12187.51, "timestamp": "03:23:07", "text": "4時間20分です。私は"}, {"type": "subtitle", "time": 12191.03, "timestamp": "03:23:11", "text": "早く終わりたいけど、まだここにいる"}, {"type": "subtitle", "time": 12194.67, "timestamp": "03:23:14", "text": "ちょっと気まずい"}, {"type": "subtitle", "time": 12196.86, "timestamp": "03:23:16", "text": "理由。ええ、そうですね。"}, {"type": "subtitle", "time": 12204.11, "timestamp": "03:23:24", "text": "えっと、これで終わりにします。私"}, {"type": "subtitle", "time": 12212.309, "timestamp": "03:23:32", "text": "上ですよね？"}, {"type": "subtitle", "time": 12221.75, "timestamp": "03:23:41", "text": "ジャマの朝食の卵は6個です。彼女には"}, {"type": "subtitle", "time": 12222.75, "timestamp": "03:23:42", "text": "6つ"}, {"type": "subtitle", "time": 12225.67, "timestamp": "03:23:45", "text": "彼ら。はい。しかし、材料は"}, {"type": "subtitle", "time": 12229.11, "timestamp": "03:23:49", "text": "ある種の痛み。彼女はどうなの？ああ、できるよ"}, {"type": "subtitle", "time": 12232.83, "timestamp": "03:23:52", "text": "文字通り、えっと、"}, {"type": "subtitle", "time": 12235.75, "timestamp": "03:23:55", "text": "おお。この時点で、私はただ"}, {"type": "subtitle", "time": 12238.349, "timestamp": "03:23:58", "text": "ただ行きたいだけです"}]
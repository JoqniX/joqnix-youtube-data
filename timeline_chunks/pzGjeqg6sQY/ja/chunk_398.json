[{"type": "subtitle", "time": 23881.788, "timestamp": "06:38:01", "text": "活性化剤。よし、それを置こう"}, {"type": "subtitle", "time": 23890.11, "timestamp": "06:38:10", "text": "そしてこれを"}, {"type": "subtitle", "time": 23898.59, "timestamp": "06:38:18", "text": "秒。そしてこれは"}, {"type": "subtitle", "time": 23910.548, "timestamp": "06:38:30", "text": "1.2は動作しません。ズームインして、"}, {"type": "subtitle", "time": 23917.788, "timestamp": "06:38:37", "text": "外。これを公開させてください"}, {"type": "subtitle", "time": 23922.51, "timestamp": "06:38:42", "text": "今。こんにちは。あと2分。私はただ"}, {"type": "subtitle", "time": 23926.99, "timestamp": "06:38:46", "text": "包む 包むだけ"}, {"type": "subtitle", "time": 23936.67, "timestamp": "06:38:56", "text": "私が確認する必要があるのは"}, {"type": "subtitle", "time": 23939.99, "timestamp": "06:38:59", "text": "好きだけど、止まってしまう。それは"}]
[{"type": "subtitle", "time": 21917.67, "timestamp": "06:05:17", "text": "フィグですが、いくつか理解できます"}, {"type": "subtitle", "time": 21920.628, "timestamp": "06:05:20", "text": "あちこちに良いものがあるのは良いことだ。私"}, {"type": "subtitle", "time": 21947.19, "timestamp": "06:05:47", "text": "ここ。すると、このように表示されます。私はそれを持っています"}, {"type": "subtitle", "time": 21950.23, "timestamp": "06:05:50", "text": "ページ読み込み時に効果を発揮するようになりました。あなたはこれ"}, {"type": "subtitle", "time": 21958.31, "timestamp": "06:05:58", "text": "少なくとも見た目は悪くない。問題は私が"}]
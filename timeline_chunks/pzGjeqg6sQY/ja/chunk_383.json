[{"type": "subtitle", "time": 22982.51, "timestamp": "06:23:02", "text": "[音楽]"}, {"type": "subtitle", "time": 22985.19, "timestamp": "06:23:05", "text": "ええと、以前にもやったことがあります。だから私は"}, {"type": "subtitle", "time": 22989.51, "timestamp": "06:23:09", "text": "何をすべきか分かっているはずだよね？私はそうしなかった"}, {"type": "subtitle", "time": 22993.07, "timestamp": "06:23:13", "text": "近いうちにこれを試してみよう"}, {"type": "subtitle", "time": 23001.708, "timestamp": "06:23:21", "text": "ええ、そうしました。"}, {"type": "subtitle", "time": 23004.03, "timestamp": "06:23:24", "text": "テスト。これらは何ですか"}, {"type": "subtitle", "time": 23011.51, "timestamp": "06:23:31", "text": "セクション。そうそう。このテスト"}, {"type": "subtitle", "time": 23014.35, "timestamp": "06:23:34", "text": "バトルスクロール"}, {"type": "subtitle", "time": 23017.43, "timestamp": "06:23:37", "text": "効果。ああ、これだ。私はできませんでした"}, {"type": "subtitle", "time": 23019.628, "timestamp": "06:23:39", "text": "忘れる"}, {"type": "subtitle", "time": 23024.03, "timestamp": "06:23:44", "text": "あなた。なぜ？壊れてるよ"}, {"type": "subtitle", "time": 23026.27, "timestamp": "06:23:46", "text": "今。"}, {"type": "subtitle", "time": 23029.628, "timestamp": "06:23:49", "text": "えっと、本題に戻りましょう"}, {"type": "subtitle", "time": 23032.948, "timestamp": "06:23:52", "text": "アニメーション。私ができることは、"}, {"type": "subtitle", "time": 23036.31, "timestamp": "06:23:56", "text": "このように折りたたまれた箱は、"}]
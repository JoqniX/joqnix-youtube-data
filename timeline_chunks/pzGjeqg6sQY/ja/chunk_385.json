[{"type": "subtitle", "time": 23101.15, "timestamp": "06:25:01", "text": "良い。あなたは"}, {"type": "subtitle", "time": 23105.43, "timestamp": "06:25:05", "text": "1つ。つまり、このボックスの方がパワーがあるということだ。それは"}, {"type": "subtitle", "time": 23114.91, "timestamp": "06:25:14", "text": "えっと"}, {"type": "subtitle", "time": 23119.948, "timestamp": "06:25:19", "text": "ゼロ。ボックスを大きくすることができます"}, {"type": "subtitle", "time": 23124.51, "timestamp": "06:25:24", "text": "あれ。幅がずれる可能性がある"}, {"type": "subtitle", "time": 23131.43, "timestamp": "06:25:31", "text": "いいえ、幅は自動設定できます。高さは"}, {"type": "subtitle", "time": 23133.31, "timestamp": "06:25:33", "text": "私"}, {"type": "subtitle", "time": 23137.07, "timestamp": "06:25:37", "text": "欲しい。高さは"}, {"type": "subtitle", "time": 23141.548, "timestamp": "06:25:41", "text": "より大きく。そして私ができることはおそらく"}, {"type": "subtitle", "time": 23145.548, "timestamp": "06:25:45", "text": "それを変換する"}, {"type": "subtitle", "time": 23147.23, "timestamp": "06:25:47", "text": "ここ。"}, {"type": "subtitle", "time": 23150.47, "timestamp": "06:25:50", "text": "翻訳する。翻訳から私は"}, {"type": "subtitle", "time": 23152.19, "timestamp": "06:25:52", "text": "おそらく"}]
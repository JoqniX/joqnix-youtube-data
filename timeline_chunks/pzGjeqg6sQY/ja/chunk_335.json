[{"type": "subtitle", "time": 20100.548, "timestamp": "05:35:00", "text": "箱か何か、これは箱です"}, {"type": "subtitle", "time": 20103.99, "timestamp": "05:35:03", "text": "線は、この間にあります。"}, {"type": "subtitle", "time": 20106.23, "timestamp": "05:35:06", "text": "真ん中のポイントなので、もしあなたが電話を使っているなら"}, {"type": "subtitle", "time": 20107.91, "timestamp": "05:35:07", "text": "画面が小さい場合でも"}, {"type": "subtitle", "time": 20111.03, "timestamp": "05:35:11", "text": "メッセージを送信する右をクリックした。"}, {"type": "subtitle", "time": 20113.35, "timestamp": "05:35:13", "text": "ドラッグできるようにしました"}, {"type": "subtitle", "time": 20115.35, "timestamp": "05:35:15", "text": "送りたい長いメッセージ"}, {"type": "subtitle", "time": 20117.47, "timestamp": "05:35:17", "text": "に"}, {"type": "subtitle", "time": 20118.99, "timestamp": "05:35:18", "text": "自分"}, {"type": "subtitle", "time": 20122.628, "timestamp": "05:35:22", "text": "うん、これを変更しようと思う"}, {"type": "subtitle", "time": 20124.11, "timestamp": "05:35:24", "text": "上"}, {"type": "subtitle", "time": 20128.59, "timestamp": "05:35:28", "text": "後で、うん、今日はテキストが欲しかった"}, {"type": "subtitle", "time": 20131.788, "timestamp": "05:35:31", "text": "これらのアニメーション"}, {"type": "subtitle", "time": 20132.89, "timestamp": "05:35:32", "text": "みんな。"}, {"type": "subtitle", "time": 20134.83, "timestamp": "05:35:34", "text": "[音楽]"}, {"type": "subtitle", "time": 20137.788, "timestamp": "05:35:37", "text": "えっと、例えばあなたが"}, {"type": "subtitle", "time": 20140.868, "timestamp": "05:35:40", "text": "ウェブサイトで、これを表示させたい"}, {"type": "subtitle", "time": 20142.99, "timestamp": "05:35:42", "text": "スクロール"}, {"type": "subtitle", "time": 20145.91, "timestamp": "05:35:45", "text": "下。では、どうすればいいのでしょうか？考えてみよう"}, {"type": "subtitle", "time": 20147.708, "timestamp": "05:35:47", "text": "それを出す"}, {"type": "subtitle", "time": 20150.548, "timestamp": "05:35:50", "text": "私たち自身。そこで、ウェブフックフォームを用意しました。"}, {"type": "subtitle", "time": 20151.628, "timestamp": "05:35:51", "text": "それは"}, {"type": "subtitle", "time": 20154.15, "timestamp": "05:35:54", "text": "それ。この段落は何ですか？それは"}, {"type": "subtitle", "time": 20156.708, "timestamp": "05:35:56", "text": "この段落。わかった。"}, {"type": "subtitle", "time": 20158.75, "timestamp": "05:35:58", "text": "ウェブフックフォーム。"}]
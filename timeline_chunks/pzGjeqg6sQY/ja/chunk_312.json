[{"type": "subtitle", "time": 18720.23, "timestamp": "05:12:00", "text": "えっと、新しいアニメーションエンジンが登場しました"}, {"type": "subtitle", "time": 18724.948, "timestamp": "05:12:04", "text": "外。えーと、私たちは、えーと、私たちは、ふざけ合うことができます"}, {"type": "subtitle", "time": 18727.708, "timestamp": "05:12:07", "text": "そして、調べる"}, {"type": "subtitle", "time": 18729.948, "timestamp": "05:12:09", "text": "初め。ああ、"}, {"type": "chat", "time": 18730.24, "timestamp": "05:12:10", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "that zoom in is lowkey scary"}, {"type": "subtitle", "time": 18733.11, "timestamp": "05:12:13", "text": "神。アニメーションエンジンの例を見てみましょう。"}, {"type": "subtitle", "time": 18736.19, "timestamp": "05:12:16", "text": "わかった。開けてみましょう"}, {"type": "chat", "time": 18737.483, "timestamp": "05:12:17", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "that zoom in on that face"}, {"type": "subtitle", "time": 18739.27, "timestamp": "05:12:19", "text": "プロジェクト。こんにちは。どんな種類の"}, {"type": "subtitle", "time": 18742.15, "timestamp": "05:12:22", "text": "スクロール駆動アニメーションは、"}, {"type": "subtitle", "time": 18745.27, "timestamp": "05:12:25", "text": "当サイト。こんにちは。いくつか例を挙げました。"}, {"type": "subtitle", "time": 18746.35, "timestamp": "05:12:26", "text": "スクロール"}, {"type": "subtitle", "time": 18749.03, "timestamp": "05:12:29", "text": "インジケータ。スクロールインジケーターがあります。"}, {"type": "subtitle", "time": 18751.83, "timestamp": "05:12:31", "text": "上部に白い線があります。それは"}, {"type": "subtitle", "time": 18754.75, "timestamp": "05:12:34", "text": "いいね。それは素晴らしいですね。"}, {"type": "subtitle", "time": 18757.39, "timestamp": "05:12:37", "text": "基本。次"}, {"type": "subtitle", "time": 18760.15, "timestamp": "05:12:40", "text": "1つ。あ、待って。どうすれば家に帰れますか？"}, {"type": "subtitle", "time": 18765.59, "timestamp": "05:12:45", "text": "視差。これは視差の拡大と縮小です"}, {"type": "subtitle", "time": 18766.99, "timestamp": "05:12:46", "text": "アニメーション。"}, {"type": "subtitle", "time": 18770.51, "timestamp": "05:12:50", "text": "ああ。こんにちは。あの男。この男の"}, {"type": "subtitle", "time": 18773.27, "timestamp": "05:12:53", "text": "こんにちは。いらっしゃいませ。いらっしゃいませ。つまりこれは"}, {"type": "subtitle", "time": 18776.868, "timestamp": "05:12:56", "text": "視差効果と視差を持つ"}, {"type": "subtitle", "time": 18778.83, "timestamp": "05:12:58", "text": "視差を解消する。"}]
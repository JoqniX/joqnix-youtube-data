[{"type": "subtitle", "time": 6301.39, "timestamp": "01:45:01", "text": "削除してくれてよかった。だから、でもいつも"}, {"type": "subtitle", "time": 6304.03, "timestamp": "01:45:04", "text": "それを覚えておいてください"}, {"type": "subtitle", "time": 6306.95, "timestamp": "01:45:06", "text": "ロック。つまり、文字通りそれを見せているんです"}, {"type": "subtitle", "time": 6310.75, "timestamp": "01:45:10", "text": "このチャットでチャットのあのやつを"}, {"type": "subtitle", "time": 6313.149, "timestamp": "01:45:13", "text": "持っている。それで"}, {"type": "subtitle", "time": 6326.229, "timestamp": "01:45:26", "text": "は。私は何か良いことをしたと思った。うん。"}, {"type": "subtitle", "time": 6327.709, "timestamp": "01:45:27", "text": "良い。良い。"}, {"type": "subtitle", "time": 6331.229, "timestamp": "01:45:31", "text": "良い。とても良い。"}, {"type": "subtitle", "time": 6335.87, "timestamp": "01:45:35", "text": "良い。宝箱が1つ足りない。彼"}, {"type": "subtitle", "time": 6339.51, "timestamp": "01:45:39", "text": "「ちょっと待って。これを見て。」と彼は言う。"}, {"type": "subtitle", "time": 6342.59, "timestamp": "01:45:42", "text": "100%達成しました"}, {"type": "subtitle", "time": 6346.07, "timestamp": "01:45:46", "text": "すべてです。」そして彼の中心平面は"}, {"type": "subtitle", "time": 6347.95, "timestamp": "01:45:47", "text": "99."}, {"type": "subtitle", "time": 6352.91, "timestamp": "01:45:52", "text": "どうやって？何？すみません。何？はぁ？"}, {"type": "subtitle", "time": 6355.32, "timestamp": "01:45:55", "text": "はぁ？ はぁ？"}, {"type": "subtitle", "time": 6357.32, "timestamp": "01:45:57", "text": "はぁ？ どうやって？どうやって？一体どうやって？なぜ？なぜ？はぁ？"}]
[{"type": "subtitle", "time": 7980.709, "timestamp": "02:13:00", "text": "H. こっちへ来なさい。私はただ食べているだけです"}, {"type": "subtitle", "time": 7991.31, "timestamp": "02:13:11", "text": "お腹がすいた。ああ、この小さな"}, {"type": "subtitle", "time": 7994.39, "timestamp": "02:13:14", "text": "女の子。ええ、あなたの"}, {"type": "subtitle", "time": 8003.03, "timestamp": "02:13:23", "text": "私はその主張を諦めることができます"}, {"type": "subtitle", "time": 8004.629, "timestamp": "02:13:24", "text": "そうするつもりはなかっただけです。私はできません"}, {"type": "subtitle", "time": 8006.56, "timestamp": "02:13:26", "text": "時間を割いてください。彼女はある程度見えなければならない"}, {"type": "subtitle", "time": 8017.27, "timestamp": "02:13:37", "text": "レインベルズが唯一の"}, {"type": "subtitle", "time": 8020.39, "timestamp": "02:13:40", "text": "赤毛の人に有利なゲーム。わかった、"}, {"type": "subtitle", "time": 8023.189, "timestamp": "02:13:43", "text": "彼らには赤毛のNPCがいる。信じられますか？"}, {"type": "subtitle", "time": 8031.35, "timestamp": "02:13:51", "text": "だからこそ、私はプレイします"}]
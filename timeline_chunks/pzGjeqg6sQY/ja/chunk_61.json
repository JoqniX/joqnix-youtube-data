[{"type": "subtitle", "time": 3668.47, "timestamp": "01:01:08", "text": "[音楽]"}, {"type": "subtitle", "time": 3671.789, "timestamp": "01:01:11", "text": "よし、この男は"}, {"type": "subtitle", "time": 3697.87, "timestamp": "01:01:37", "text": "ええ、そうですね。ほら、胸にホログラムがあるよ"}, {"type": "subtitle", "time": 3700.87, "timestamp": "01:01:40", "text": "そして、それはそこには存在しない。これは違う"}, {"type": "subtitle", "time": 3703.51, "timestamp": "01:01:43", "text": "場所。これは私がすでに"}, {"type": "subtitle", "time": 3707.789, "timestamp": "01:01:47", "text": "終わった。ご覧のとおり、これらのものは"}, {"type": "subtitle", "time": 3709.63, "timestamp": "01:01:49", "text": "ピックアップ可能、"}, {"type": "subtitle", "time": 3712.67, "timestamp": "01:01:52", "text": "右？これらのものは"}, {"type": "subtitle", "time": 3715.27, "timestamp": "01:01:55", "text": "拾い上げて、ボールと戦う。これ"}, {"type": "subtitle", "time": 3716.67, "timestamp": "01:01:56", "text": "これらのもの"}]
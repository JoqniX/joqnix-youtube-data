[{"type": "subtitle", "time": 7140.229, "timestamp": "01:59:00", "text": "もう一つ服用したらどうなるか"}, {"type": "subtitle", "time": 7143.109, "timestamp": "01:59:03", "text": "丘の斜面を転がり落ちる。何てことだ。"}, {"type": "subtitle", "time": 7146.39, "timestamp": "01:59:06", "text": "ごめん。あんなことを言うべきじゃなかった。"}, {"type": "subtitle", "time": 7148.87, "timestamp": "01:59:08", "text": "リトル・ペトロラ、君はまだ若すぎるから"}, {"type": "subtitle", "time": 7151.75, "timestamp": "01:59:11", "text": "愛の意味を理解する。永続的"}, {"type": "subtitle", "time": 7154.75, "timestamp": "01:59:14", "text": "肉体的な痛みは一つのことだが、"}, {"type": "subtitle", "time": 7157.669, "timestamp": "01:59:17", "text": "片思いは困難だ"}, {"type": "subtitle", "time": 7160.03, "timestamp": "01:59:20", "text": "英雄は誰も"}, {"type": "subtitle", "time": 7163.27, "timestamp": "01:59:23", "text": "克服する。とにかく、私は捕獲して奪う"}, {"type": "subtitle", "time": 7166.189, "timestamp": "01:59:26", "text": "私の愛。こんにちは、"}, {"type": "subtitle", "time": 7168.109, "timestamp": "01:59:28", "text": "キャット"}, {"type": "subtitle", "time": 7172.55, "timestamp": "01:59:32", "text": "ベイ。好きなだけ捕まえることができます。"}, {"type": "subtitle", "time": 7175.669, "timestamp": "01:59:35", "text": "回復したら。でも、子どもよ、私は成長する、私は成長する"}, {"type": "subtitle", "time": 7177.43, "timestamp": "01:59:37", "text": "待つのに疲れた。いつ"}, {"type": "subtitle", "time": 7181.109, "timestamp": "01:59:41", "text": "再びチャンスが訪れるだろうか？その上、"}, {"type": "subtitle", "time": 7182.87, "timestamp": "01:59:42", "text": "千の議論は常に活発である"}, {"type": "subtitle", "time": 7184.149, "timestamp": "01:59:44", "text": "最近なので、今が最適な時期です"}, {"type": "subtitle", "time": 7187.189, "timestamp": "01:59:47", "text": "反響を捉える。この機会を逃すわけにはいかない"}, {"type": "subtitle", "time": 7189.75, "timestamp": "01:59:49", "text": "こっそりと姿を消す。では、これはどうでしょう？私が行きます"}, {"type": "subtitle", "time": 7191.83, "timestamp": "01:59:51", "text": "キャッチ・エコー・フォー・ユー・アンド・ユー・ゴー・トゥ・ザ・"}, {"type": "subtitle", "time": 7194.229, "timestamp": "01:59:54", "text": "病院。それでよろしいですか？でも私は"}, {"type": "subtitle", "time": 7196.629, "timestamp": "01:59:56", "text": "自分の問題でご迷惑をおかけして申し訳ありません。しないで"}]
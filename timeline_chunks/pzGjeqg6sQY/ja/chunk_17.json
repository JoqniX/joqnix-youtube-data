[{"type": "subtitle", "time": 1020.71, "timestamp": "00:17:00", "text": "疲れた？私は、"}, {"type": "subtitle", "time": 1024.39, "timestamp": "00:17:04", "text": "V でストリームして、ただ去って、"}, {"type": "subtitle", "time": 1028.309, "timestamp": "00:17:08", "text": "常にそこに存在すること。"}, {"type": "subtitle", "time": 1030.63, "timestamp": "00:17:10", "text": "それは新しく来る人にとって良くないことだ"}, {"type": "subtitle", "time": 1031.76, "timestamp": "00:17:11", "text": "私を見守る"}, {"type": "subtitle", "time": 1036.75, "timestamp": "00:17:16", "text": "[音楽]"}, {"type": "subtitle", "time": 1039.35, "timestamp": "00:17:19", "text": "良い。それはストリーマーが"}, {"type": "subtitle", "time": 1052.63, "timestamp": "00:17:32", "text": "まるでそれが起こるかのように物事を言う。でも私も"}, {"type": "subtitle", "time": 1059.11, "timestamp": "00:17:39", "text": "私が配信していないからこうなっているんです。それで"}, {"type": "subtitle", "time": 1062.31, "timestamp": "00:17:42", "text": "賛成します。私は行きます"}]
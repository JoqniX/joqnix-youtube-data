[{"type": "subtitle", "time": 19382.43, "timestamp": "05:23:02", "text": "私は持っている"}, {"type": "subtitle", "time": 19387.19, "timestamp": "05:23:07", "text": "えっと、実は10万持ってるんです"}, {"type": "subtitle", "time": 19390.31, "timestamp": "05:23:10", "text": "えーと、月間ページビュー数。もし私がそんなにたくさん持っていたら"}, {"type": "subtitle", "time": 19393.75, "timestamp": "05:23:13", "text": "ウェブサイトのトラフィックが、"}, {"type": "subtitle", "time": 19396.19, "timestamp": "05:23:16", "text": "実際に"}, {"type": "subtitle", "time": 19400.31, "timestamp": "05:23:20", "text": "支払うと思います。でも今は安全だ。つまり、私は"}, {"type": "subtitle", "time": 19402.55, "timestamp": "05:23:22", "text": "後でローカルでホストすることもできるので"}, {"type": "subtitle", "time": 19404.868, "timestamp": "05:23:24", "text": "大丈夫です。ほとんどの機能は"}, {"type": "subtitle", "time": 19407.51, "timestamp": "05:23:27", "text": "クラウドで利用可能とは、"}, {"type": "subtitle", "time": 19409.868, "timestamp": "05:23:29", "text": "彼らはサイトをホストしています"}, {"type": "subtitle", "time": 19413.99, "timestamp": "05:23:33", "text": "私と私にはできる方法もあります"}, {"type": "subtitle", "time": 19416.15, "timestamp": "05:23:36", "text": "私にとって"}, {"type": "subtitle", "time": 19422.628, "timestamp": "05:23:42", "text": "良い。ええ、私はただ決めるだけです"}, {"type": "subtitle", "time": 19425.91, "timestamp": "05:23:45", "text": "こんな感じで、アニメーションを付けるといいな。それで"}, {"type": "subtitle", "time": 19428.15, "timestamp": "05:23:48", "text": "私たちにできることはたくさんあります。理解できる"}, {"type": "subtitle", "time": 19430.03, "timestamp": "05:23:50", "text": "ゆっくりと"}, {"type": "subtitle", "time": 19431.708, "timestamp": "05:23:51", "text": "ゆっくり。"}, {"type": "subtitle", "time": 19438.43, "timestamp": "05:23:58", "text": "戻る。"}]
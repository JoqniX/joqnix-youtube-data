[{"type": "subtitle", "time": 18844.47, "timestamp": "05:14:04", "text": "タイプ。これがお好きですか？アルファベットを入力してください"}, {"type": "subtitle", "time": 18845.948, "timestamp": "05:14:05", "text": "詳細はこちら"}, {"type": "subtitle", "time": 18848.55, "timestamp": "05:14:08", "text": "詳細。キーが記載されたメールが送信されます"}, {"type": "subtitle", "time": 18849.68, "timestamp": "05:14:09", "text": "一週間後、"}, {"type": "subtitle", "time": 18851.02, "timestamp": "05:14:11", "text": "[笑い]"}, {"type": "subtitle", "time": 18859.75, "timestamp": "05:14:19", "text": "兄弟。 Bungieが開発したゲーム『マラソン』。バンディーズ"}, {"type": "chat", "time": 18862.937, "timestamp": "05:14:22", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "yea"}, {"type": "subtitle", "time": 18863.31, "timestamp": "05:14:23", "text": "Bungieの見解を取り入れる"}, {"type": "subtitle", "time": 18867.35, "timestamp": "05:14:27", "text": "えっと、これ。これはバンジーの"}, {"type": "subtitle", "time": 18870.19, "timestamp": "05:14:30", "text": "抽出に挑戦する"}, {"type": "chat", "time": 18874.738, "timestamp": "05:14:34", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "we were dissing it like weeks ago"}, {"type": "subtitle", "time": 18877.99, "timestamp": "05:14:37", "text": "遊びたい。遊びたい。それは私のタイプです"}, {"type": "subtitle", "time": 18880.868, "timestamp": "05:14:40", "text": "ゲーム。 Apex Legendsのようなファストパック"}, {"type": "subtitle", "time": 18883.99, "timestamp": "05:14:43", "text": "そしてテンポの速いもの。ペースが遅い"}, {"type": "subtitle", "time": 18886.628, "timestamp": "05:14:46", "text": "シューティングゲームとしては、テンポが速い。ああ、"}, {"type": "subtitle", "time": 18892.35, "timestamp": "05:14:52", "text": "とても美味しいです。それはとても"}, {"type": "subtitle", "time": 18895.868, "timestamp": "05:14:55", "text": "良い。私はこれを選びます"}, {"type": "subtitle", "time": 18899.55, "timestamp": "05:14:59", "text": "キャラクター。でも、本当に良いですね。"}]
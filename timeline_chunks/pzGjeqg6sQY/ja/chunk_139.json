[{"type": "subtitle", "time": 8341.509, "timestamp": "02:19:01", "text": "注意深い。気をつけないと。私は"}, {"type": "subtitle", "time": 8350.309, "timestamp": "02:19:10", "text": "この段階での痛み"}, {"type": "subtitle", "time": 8354.15, "timestamp": "02:19:14", "text": "私のスコアが怖い"}, {"type": "subtitle", "time": 8357.309, "timestamp": "02:19:17", "text": "今は減少している、それは悪い、それは悪い"}, {"type": "subtitle", "time": 8360.429, "timestamp": "02:19:20", "text": "それは良くない"}, {"type": "subtitle", "time": 8364.309, "timestamp": "02:19:24", "text": "だから私はきちんと振る舞わなければならない"}, {"type": "subtitle", "time": 8368.75, "timestamp": "02:19:28", "text": "1週間後に私の減点ポイントが"}, {"type": "subtitle", "time": 8372.79, "timestamp": "02:19:32", "text": "バックなので違反は3つになります"}, {"type": "subtitle", "time": 8375.83, "timestamp": "02:19:35", "text": "砂の価値を示すポイント。すべてのアカウント"}, {"type": "subtitle", "time": 8379.99, "timestamp": "02:19:39", "text": "スタンド値は12です。"}, {"type": "subtitle", "time": 8381.95, "timestamp": "02:19:41", "text": "下がると、"}, {"type": "subtitle", "time": 8385.629, "timestamp": "02:19:45", "text": "痛み。そう、本当にたくさん"}, {"type": "subtitle", "time": 8387.349, "timestamp": "02:19:47", "text": "制限。わかった、私は自分の"}, {"type": "subtitle", "time": 8394.309, "timestamp": "02:19:54", "text": "GB。あなたの息子の社会はとても壊れていて"}, {"type": "subtitle", "time": 8394.9, "timestamp": "02:19:54", "text": "あなたのそれは"}]
[{"type": "subtitle", "time": 7278.109, "timestamp": "02:01:18", "text": "支払う。わかった。ロール"}, {"type": "subtitle", "time": 7299.149, "timestamp": "02:01:39", "text": "これについても"}, {"type": "subtitle", "time": 7302.95, "timestamp": "02:01:42", "text": "私がアイスコールに失敗した男は"}, {"type": "subtitle", "time": 7304.629, "timestamp": "02:01:44", "text": "本当だよ、これを見てくれ、ゴルフの準備をしたんだ"}, {"type": "subtitle", "time": 7306.31, "timestamp": "02:01:46", "text": "ステッカー付きの観察日誌"}, {"type": "subtitle", "time": 7307.47, "timestamp": "02:01:47", "text": "毎"}, {"type": "subtitle", "time": 7311.189, "timestamp": "02:01:51", "text": "タイトルページに署名"}, {"type": "subtitle", "time": 7313.39, "timestamp": "02:01:53", "text": "お願いがあるのですが、誰に聞いているのですか？"}, {"type": "subtitle", "time": 7316.95, "timestamp": "02:01:56", "text": "あなた、それに関連して彼らは言った"}, {"type": "subtitle", "time": 7319.27, "timestamp": "02:01:59", "text": "ジンショースクールでの不和の生き物たち。"}]
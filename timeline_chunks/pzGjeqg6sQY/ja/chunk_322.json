[{"type": "subtitle", "time": 19321.23, "timestamp": "05:22:01", "text": "もの。しかし問題は"}, {"type": "subtitle", "time": 19324.27, "timestamp": "05:22:04", "text": "現在、私がウェブスタジオで行っていることは何でも"}, {"type": "subtitle", "time": 19327.708, "timestamp": "05:22:07", "text": "ビルダーがクラウドサーバーにプッシュされています。"}, {"type": "subtitle", "time": 19330.55, "timestamp": "05:22:10", "text": "右？もちろん、彼らは私にも何か方法を用意してくれている。"}, {"type": "subtitle", "time": 19333.11, "timestamp": "05:22:13", "text": "やり方を知っていれば、できる"}, {"type": "subtitle", "time": 19334.628, "timestamp": "05:22:14", "text": "文字通り"}, {"type": "subtitle", "time": 19339.11, "timestamp": "05:22:19", "text": "自分のサイトをエクスポートして"}, {"type": "subtitle", "time": 19341.35, "timestamp": "05:22:21", "text": "サーバー上のローカルインスタンスか何か"}, {"type": "subtitle", "time": 19344.47, "timestamp": "05:22:24", "text": "Dockerインスタンス化して、さらに"}, {"type": "subtitle", "time": 19347.75, "timestamp": "05:22:27", "text": "機能など、カスタムコード関連のもの"}, {"type": "subtitle", "time": 19350.788, "timestamp": "05:22:30", "text": "必要です。その選択肢はあります。しかし、"}, {"type": "subtitle", "time": 19352.39, "timestamp": "05:22:32", "text": "今は、"}, {"type": "subtitle", "time": 19353.628, "timestamp": "05:22:33", "text": "クラウド"}, {"type": "subtitle", "time": 19358.55, "timestamp": "05:22:38", "text": "あれ。そう、唯一の制限は"}, {"type": "subtitle", "time": 19362.23, "timestamp": "05:22:42", "text": "私自身は生涯取引で"}, {"type": "subtitle", "time": 19365.15, "timestamp": "05:22:45", "text": "プロプランはページビューです"}, {"type": "subtitle", "time": 19367.75, "timestamp": "05:22:47", "text": "あれ。将来的には、"}, {"type": "subtitle", "time": 19371.23, "timestamp": "05:22:51", "text": "ダッシュボードのページビュー数"}, {"type": "subtitle", "time": 19374.23, "timestamp": "05:22:54", "text": "えっと、私のページビュー数はいくつですか？"}, {"type": "subtitle", "time": 19377.19, "timestamp": "05:22:57", "text": "手配など1ヶ月以内に完了するなど。現在、"}, {"type": "subtitle", "time": 19379.31, "timestamp": "05:22:59", "text": "私はそう信じています"}]
[{"type": "subtitle", "time": 1880.43, "timestamp": "00:31:20", "text": "近く"}, {"type": "subtitle", "time": 1883.909, "timestamp": "00:31:23", "text": "王冠のない者。あれ、私、待ったっけ？私は"}, {"type": "subtitle", "time": 1886.75, "timestamp": "00:31:26", "text": "王冠のない男たちを捕まえろ"}, {"type": "subtitle", "time": 1890.789, "timestamp": "00:31:30", "text": "もの？実はあまり詳しく調べていませんでした。できる"}, {"type": "subtitle", "time": 1897.029, "timestamp": "00:31:37", "text": "私は自分がここに来たことを実際には覚えていない"}]
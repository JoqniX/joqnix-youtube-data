[{"type": "subtitle", "time": 5523.83, "timestamp": "01:32:03", "text": "えっと、どれですか？待って、つまり私はそうした"}, {"type": "subtitle", "time": 5527.79, "timestamp": "01:32:07", "text": "いろいろあるけど、どういう意味？"}, {"type": "subtitle", "time": 5534.99, "timestamp": "01:32:14", "text": "私は無制限にスパイスを買うのが好きです。えっと、"}, {"type": "subtitle", "time": 5538.26, "timestamp": "01:32:18", "text": "唐辛子。それ"}, {"type": "subtitle", "time": 5539.87, "timestamp": "01:32:19", "text": "[音楽]"}, {"type": "subtitle", "time": 5543.59, "timestamp": "01:32:23", "text": "カウントします。私は何をしたの？"}, {"type": "subtitle", "time": 5547.91, "timestamp": "01:32:27", "text": "うん、一緒にボスを倒したよ。"}, {"type": "subtitle", "time": 5575.51, "timestamp": "01:32:55", "text": "感じる。そうそう。"}, {"type": "subtitle", "time": 5578.55, "timestamp": "01:32:58", "text": "D、つまり、そのシリーズは？私は実際に"}]
[{"type": "subtitle", "time": 6661.75, "timestamp": "01:51:01", "text": "人気を過大評価している。いいえ。著作権"}, {"type": "subtitle", "time": 6663.189, "timestamp": "01:51:03", "text": "プライバシーと放送ライセンス"}, {"type": "subtitle", "time": 6665.59, "timestamp": "01:51:05", "text": "行為。ライセンスのないコンテンツ。わかった。"}, {"type": "subtitle", "time": 6667.59, "timestamp": "01:51:07", "text": "管理者を追放するよう注意喚起します。リマインダー"}, {"type": "subtitle", "time": 6670.55, "timestamp": "01:51:10", "text": "禁止コンテンツの。わかった。それは、それは"}, {"type": "subtitle", "time": 6673.669, "timestamp": "01:51:13", "text": "マイナス3点。ああ、神様。暴力"}, {"type": "subtitle", "time": 6675.669, "timestamp": "01:51:15", "text": "血。わかった。私は何もプレイすべきではない"}, {"type": "subtitle", "time": 6678.87, "timestamp": "01:51:18", "text": "暴力、血、動物虐待、ゲーム、または"}, {"type": "subtitle", "time": 6680.87, "timestamp": "01:51:20", "text": "何でも。わかった。ギャンブル行動、"}, {"type": "subtitle", "time": 6682.79, "timestamp": "01:51:22", "text": "プライバシーの侵害、写真撮影"}, {"type": "subtitle", "time": 6686.149, "timestamp": "01:51:26", "text": "彼らの許可なく、広告を宣伝する、"}, {"type": "subtitle", "time": 6688.03, "timestamp": "01:51:28", "text": "違反"}, {"type": "subtitle", "time": 6691.55, "timestamp": "01:51:31", "text": "該当する法律。何？国の使用"}, {"type": "subtitle", "time": 6694.03, "timestamp": "01:51:34", "text": "側面"}, {"type": "subtitle", "time": 6696.99, "timestamp": "01:51:36", "text": "コマーシャル。"}, {"type": "subtitle", "time": 6699.95, "timestamp": "01:51:39", "text": "ああ、それは"}, {"type": "subtitle", "time": 6702.95, "timestamp": "01:51:42", "text": "これ？噂を広めることは損害をもたらす。わかった。全て"}, {"type": "subtitle", "time": 6707.99, "timestamp": "01:51:47", "text": "違反行為。あ、待って。私はできません"}, {"type": "subtitle", "time": 6710.149, "timestamp": "01:51:50", "text": "私のDiscordサーバーを宣伝して"}, {"type": "subtitle", "time": 6711.47, "timestamp": "01:51:51", "text": "もの。"}, {"type": "subtitle", "time": 6714.669, "timestamp": "01:51:54", "text": "何？おお"}, {"type": "subtitle", "time": 6718.35, "timestamp": "01:51:58", "text": "いいえ。昇進後。交通違反"}]
[{"type": "subtitle", "time": 21540.59, "timestamp": "05:59:00", "text": "[音楽]"}, {"type": "subtitle", "time": 21549.43, "timestamp": "05:59:09", "text": "50ピクセルまたは30ピクセル。あ、待って。 RAMが10GBあれば十分です。"}, {"type": "subtitle", "time": 21552.59, "timestamp": "05:59:12", "text": "ああ、それはやりすぎだ。私は5つ手に入れる"}, {"type": "subtitle", "time": 21554.1, "timestamp": "05:59:14", "text": "ラム。三つ"}, {"type": "subtitle", "time": 21555.628, "timestamp": "05:59:15", "text": "[音楽]"}, {"type": "subtitle", "time": 21558.03, "timestamp": "05:59:18", "text": "ラム。ああ、３つ"}, {"type": "subtitle", "time": 21560.868, "timestamp": "05:59:20", "text": "ラム。料理させてください。よし、じゃあ料理しよう。私は"}, {"type": "subtitle", "time": 21567.83, "timestamp": "05:59:27", "text": "アイデア。引き違い窓。私たちはできない"}, {"type": "subtitle", "time": 21576.948, "timestamp": "05:59:36", "text": "うーん、それは良くないですね。えっと、たぶん私たちは"}, {"type": "subtitle", "time": 21578.868, "timestamp": "05:59:38", "text": "テキストアニメーションを削除できます"}, {"type": "subtitle", "time": 21598.548, "timestamp": "05:59:58", "text": "えっと、これで閉じます。いい考えがある。"}]
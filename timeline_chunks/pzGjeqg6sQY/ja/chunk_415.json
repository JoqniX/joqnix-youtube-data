[{"type": "subtitle", "time": 24901.19, "timestamp": "06:55:01", "text": "それとは別に、"}, {"type": "subtitle", "time": 24909.31, "timestamp": "06:55:09", "text": "ファスモフォビアと私たちは両方とも"}, {"type": "subtitle", "time": 24913.31, "timestamp": "06:55:13", "text": "本当に怖い。えっと"}, {"type": "subtitle", "time": 24918.03, "timestamp": "06:55:18", "text": "うん。私たちはそうでしょうか？うん。はい。怖いです"}, {"type": "subtitle", "time": 24928.468, "timestamp": "06:55:28", "text": "私は怖い。つまり、私はわからないのですが"}, {"type": "subtitle", "time": 24931.59, "timestamp": "06:55:31", "text": "音量はゲームと同様に問題ありません"}, {"type": "subtitle", "time": 24934.11, "timestamp": "06:55:34", "text": "あれ。私は知りません"}, {"type": "subtitle", "time": 24937.43, "timestamp": "06:55:37", "text": "だって、家に帰ったのがすごく遅かったから"}, {"type": "subtitle", "time": 24939.75, "timestamp": "06:55:39", "text": "だからオーディオの設定ができなかったのですが、"}, {"type": "subtitle", "time": 24942.788, "timestamp": "06:55:42", "text": "まあ、ゲーム内に抑制機能があるんだろうね"}, {"type": "subtitle", "time": 24945.75, "timestamp": "06:55:45", "text": "ゲーム内のものはジョーカー先輩です"}, {"type": "subtitle", "time": 24950.23, "timestamp": "06:55:50", "text": "ゲーム内の音声は問題ありません"}, {"type": "subtitle", "time": 24954.948, "timestamp": "06:55:54", "text": "配信で大丈夫かな？わからない"}, {"type": "subtitle", "time": 24958.868, "timestamp": "06:55:58", "text": "ちょっと確認させてください。あ、待って、もし私が"}]
[{"type": "subtitle", "time": 22320.43, "timestamp": "06:12:00", "text": "追加する"}, {"type": "subtitle", "time": 22323.548, "timestamp": "06:12:03", "text": "画像。テストしてみましょう"}, {"type": "subtitle", "time": 22325.548, "timestamp": "06:12:05", "text": "それ。"}, {"type": "subtitle", "time": 22328.708, "timestamp": "06:12:08", "text": "ええと、それを選ぶことにします。私はそうしました"}, {"type": "subtitle", "time": 22330.948, "timestamp": "06:12:10", "text": "私のモデルをたくさんアップロードしてください"}, {"type": "subtitle", "time": 22332.43, "timestamp": "06:12:12", "text": "そして"}, {"type": "subtitle", "time": 22335.948, "timestamp": "06:12:15", "text": "もの。えっと、"}, {"type": "subtitle", "time": 22340.39, "timestamp": "06:12:20", "text": "だから私は咳も入れることができる"}, {"type": "subtitle", "time": 22341.788, "timestamp": "06:12:21", "text": "あれ"}, {"type": "subtitle", "time": 22346.708, "timestamp": "06:12:26", "text": "私たちにはそれができる。"}, {"type": "subtitle", "time": 22350.75, "timestamp": "06:12:30", "text": "大きすぎますか？えーと、これをやろう"}, {"type": "subtitle", "time": 22354.07, "timestamp": "06:12:34", "text": "多分。うん、これは以前私のプロフィール画像だったんだ"}, {"type": "subtitle", "time": 22356.99, "timestamp": "06:12:36", "text": "あれ。長方形の方。参照"}, {"type": "subtitle", "time": 22359.75, "timestamp": "06:12:39", "text": "国境？色付きの枠線。私は信じます"}, {"type": "subtitle", "time": 22362.03, "timestamp": "06:12:42", "text": "これを使った"}, {"type": "subtitle", "time": 22365.19, "timestamp": "06:12:45", "text": "どのサーバーで何だったか忘れてしまったので"}, {"type": "subtitle", "time": 22367.59, "timestamp": "06:12:47", "text": "それを使っていました。でも、そう、"}, {"type": "subtitle", "time": 22371.19, "timestamp": "06:12:51", "text": "これに対応するズームインアニメーション。こんにちは"}, {"type": "subtitle", "time": 22375.43, "timestamp": "06:12:55", "text": "ジャスミン・チャマ。こんにちは。"}, {"type": "subtitle", "time": 22378.03, "timestamp": "06:12:58", "text": "元気かい、"}]
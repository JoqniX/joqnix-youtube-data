[{"type": "subtitle", "time": 20041.948, "timestamp": "05:34:01", "text": "おそらく私ができることは、"}, {"type": "subtitle", "time": 20044.43, "timestamp": "05:34:04", "text": "言い換えると"}, {"type": "subtitle", "time": 20047.03, "timestamp": "05:34:07", "text": "マージン。待て、マージンは必要ありません。私たちは"}, {"type": "subtitle", "time": 20053.788, "timestamp": "05:34:13", "text": "えっと、パディングはできます"}, {"type": "subtitle", "time": 20055.948, "timestamp": "05:34:15", "text": "20の"}, {"type": "subtitle", "time": 20064.39, "timestamp": "05:34:24", "text": "知る。あ、待って。 20GBのRAMは大きいですね。え、何？"}, {"type": "subtitle", "time": 20066.788, "timestamp": "05:34:26", "text": "RAMは約10MB？うん、これでうまくいくはずだ。"}, {"type": "subtitle", "time": 20072.788, "timestamp": "05:34:32", "text": "ええ、スペースはありますし、"}, {"type": "subtitle", "time": 20074.99, "timestamp": "05:34:34", "text": "整列する"}, {"type": "subtitle", "time": 20078.35, "timestamp": "05:34:38", "text": "これは何で"}, {"type": "subtitle", "time": 20080.868, "timestamp": "05:34:40", "text": "箱。ええ、あなたは同調しません"}, {"type": "subtitle", "time": 20086.628, "timestamp": "05:34:46", "text": "正しい。うん、ただ気軽にクリックするだけ"}, {"type": "subtitle", "time": 20089.67, "timestamp": "05:34:49", "text": "メッセージ送信時。うまくいくよ。できる"}, {"type": "subtitle", "time": 20092.27, "timestamp": "05:34:52", "text": "おそらくクリックできます"}, {"type": "subtitle", "time": 20095.59, "timestamp": "05:34:55", "text": "それ。これも、そうはならない、そうはならない"}, {"type": "subtitle", "time": 20098.15, "timestamp": "05:34:58", "text": "うん。うん。うん。うん。衝突"}]
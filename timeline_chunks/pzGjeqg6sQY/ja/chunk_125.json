[{"type": "subtitle", "time": 7502.95, "timestamp": "02:05:02", "text": "それ。ああ、あれがゴールだったんだ。"}, {"type": "subtitle", "time": 7505.27, "timestamp": "02:05:05", "text": "私ってば、バカ。"}, {"type": "subtitle", "time": 7507.83, "timestamp": "02:05:07", "text": "よし、あの赤毛の女性は"}, {"type": "subtitle", "time": 7510.109, "timestamp": "02:05:10", "text": "バター爆弾。ただ言ってるだけ"}, {"type": "subtitle", "time": 7533.43, "timestamp": "02:05:33", "text": "水爆攻撃。待って、やらなきゃいけないんだ"}, {"type": "subtitle", "time": 7536.51, "timestamp": "02:05:36", "text": "神。もう一度やらなければならない。 O"}, {"type": "subtitle", "time": 7539.75, "timestamp": "02:05:39", "text": "待って。私は何をしているのだろう？なぜ私はそうではないのか"}, {"type": "subtitle", "time": 7551.03, "timestamp": "02:05:51", "text": "右。多面的な側面がたくさんある"}]
[{"type": "subtitle", "time": 20581.548, "timestamp": "05:43:01", "text": "フェードフェード"}, {"type": "subtitle", "time": 20588.788, "timestamp": "05:43:08", "text": "外。フェードイン。フェードインは"}, {"type": "subtitle", "time": 20591.59, "timestamp": "05:43:11", "text": "より良い。だから、私が範囲を望むとき"}, {"type": "subtitle", "time": 20600.868, "timestamp": "05:43:20", "text": "えっと、これはどうすればいいんですか？"}, {"type": "subtitle", "time": 20602.948, "timestamp": "05:43:22", "text": "アニメーションの状態は、"}, {"type": "subtitle", "time": 20606.11, "timestamp": "05:43:26", "text": "活性化剤が好ましい"}, {"type": "subtitle", "time": 20607.788, "timestamp": "05:43:27", "text": "アニメーション。"}, {"type": "subtitle", "time": 20612.99, "timestamp": "05:43:32", "text": "はぁ。だから、レンジの終わりは"}, {"type": "subtitle", "time": 20616.788, "timestamp": "05:43:36", "text": "真ん中。レンジの開始は、あるべき姿になります"}, {"type": "subtitle", "time": 20620.27, "timestamp": "05:43:40", "text": "ここまでで終わりです。"}, {"type": "subtitle", "time": 20626.39, "timestamp": "05:43:46", "text": "正しい。アニメーションは主題を開始する"}, {"type": "subtitle", "time": 20630.548, "timestamp": "05:43:50", "text": "ちょうど視界に現れ始めたところだ。"}, {"type": "subtitle", "time": 20632.868, "timestamp": "05:43:52", "text": "視界に入る。ええ、"}, {"type": "subtitle", "time": 20636.548, "timestamp": "05:43:56", "text": "ビューでは、不透明度がfのようになります"}, {"type": "subtitle", "time": 20637.47, "timestamp": "05:43:57", "text": "なれ"}]
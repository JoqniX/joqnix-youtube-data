[{"type": "subtitle", "time": 18903.03, "timestamp": "05:15:03", "text": "男。かわいいですね。しかし、それはプレミアムです"}, {"type": "subtitle", "time": 18905.59, "timestamp": "05:15:05", "text": "ちなみに、タイトルです。地獄のダイバーのように、"}, {"type": "subtitle", "time": 18908.788, "timestamp": "05:15:08", "text": "あまりにも。実際、それは最悪だ。あなたが持っている"}, {"type": "subtitle", "time": 18912.83, "timestamp": "05:15:12", "text": "40ドルを支払う。 40ドルはいくらですか？"}, {"type": "subtitle", "time": 18915.628, "timestamp": "05:15:15", "text": "40ドルと"}, {"type": "subtitle", "time": 18918.27, "timestamp": "05:15:18", "text": "3インドルピー。ああ、"}, {"type": "chat", "time": 18918.539, "timestamp": "05:15:18", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "mhm, acc to them they wanna be like 'concord'"}, {"type": "subtitle", "time": 18922.708, "timestamp": "05:15:22", "text": "神。ああ、遊びたい。私はただ"}, {"type": "subtitle", "time": 18924.628, "timestamp": "05:15:24", "text": "ベータ版を試して、"}, {"type": "subtitle", "time": 18929.03, "timestamp": "05:15:29", "text": "好き嫌いは別として。えっと"}, {"type": "subtitle", "time": 18930.948, "timestamp": "05:15:30", "text": "もし私が気に入らなかったら、"}, {"type": "chat", "time": 18931.146, "timestamp": "05:15:31", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "wont be funny if they do end up like em"}, {"type": "subtitle", "time": 18932.948, "timestamp": "05:15:32", "text": "買わない。気に入ったら買います"}, {"type": "subtitle", "time": 18934.04, "timestamp": "05:15:34", "text": "それ。感じる"}, {"type": "subtitle", "time": 18942.07, "timestamp": "05:15:42", "text": "自分？しかし、もしそれが終わったら面白くないだろう"}, {"type": "subtitle", "time": 18945.91, "timestamp": "05:15:45", "text": "そうやって上げるんだ。したいのですが、できません。彼らは"}, {"type": "subtitle", "time": 18948.55, "timestamp": "05:15:48", "text": "コンロッドみたいになりたい。ああ、そうだね。うん、"}, {"type": "subtitle", "time": 18951.11, "timestamp": "05:15:51", "text": "はい、はい、はい。たくさんの動画を見た"}, {"type": "subtitle", "time": 18953.51, "timestamp": "05:15:53", "text": "YouTubeでだよ。人々が話している"}, {"type": "subtitle", "time": 18955.788, "timestamp": "05:15:55", "text": "これ、ドラマ、すべての"}]
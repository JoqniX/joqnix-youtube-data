[{"type": "subtitle", "time": 3786.63, "timestamp": "01:03:06", "text": "えっと、ピン留めしたの？あ、待って。"}, {"type": "subtitle", "time": 3788.39, "timestamp": "01:03:08", "text": "2つ見逃したけど、最後に"}, {"type": "subtitle", "time": 3789.99, "timestamp": "01:03:09", "text": "動画は編集していません"}, {"type": "subtitle", "time": 3793.43, "timestamp": "01:03:13", "text": "彼らは数えなかった。私は「わかった、数えて」と言った。"}, {"type": "subtitle", "time": 3795.589, "timestamp": "01:03:15", "text": "100%に向けて。"}, {"type": "subtitle", "time": 3798.71, "timestamp": "01:03:18", "text": "たぶん、私もそうだったから、"}, {"type": "subtitle", "time": 3801.67, "timestamp": "01:03:21", "text": "モッドシティ。私も予定より早く昇進した。"}, {"type": "subtitle", "time": 3803.349, "timestamp": "01:03:23", "text": "いいえ、まだです。それはトップに来るだろう"}, {"type": "subtitle", "time": 3804.589, "timestamp": "01:03:24", "text": "の"}, {"type": "subtitle", "time": 3812.43, "timestamp": "01:03:32", "text": "それ。潜入任務は"}, {"type": "subtitle", "time": 3814.43, "timestamp": "01:03:34", "text": "やり直しました。"}, {"type": "subtitle", "time": 3817.029, "timestamp": "01:03:37", "text": "何？浸潤？私は収集しませんでした"}, {"type": "subtitle", "time": 3826.95, "timestamp": "01:03:46", "text": "私は、"}, {"type": "subtitle", "time": 3833.589, "timestamp": "01:03:53", "text": "ミッション。無作為の祈りを破った。それ"}, {"type": "subtitle", "time": 3835.43, "timestamp": "01:03:55", "text": "姿を現した。これはただ"}]
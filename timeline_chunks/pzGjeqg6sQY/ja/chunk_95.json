[{"type": "subtitle", "time": 5712.31, "timestamp": "01:35:12", "text": "私の。私は人をからかうのが得意だ。待って、"}, {"type": "subtitle", "time": 5717.629, "timestamp": "01:35:17", "text": "それは損失だった。待てよ、あれは負けだった。"}, {"type": "subtitle", "time": 5720.07, "timestamp": "01:35:20", "text": "はぁ？あなたは本気だと思ったよ。何？"}, {"type": "subtitle", "time": 5756.62, "timestamp": "01:35:56", "text": "この"}]
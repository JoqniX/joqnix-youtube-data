[{"type": "subtitle", "time": 7200.149, "timestamp": "02:00:00", "text": "心配しないで、私がいるから。いいえ、問題ありません"}, {"type": "subtitle", "time": 7201.99, "timestamp": "02:00:01", "text": "まったく。結局のところ、それは巡回隊の任務だ"}, {"type": "subtitle", "time": 7203.87, "timestamp": "02:00:03", "text": "住民の世話をする"}, {"type": "subtitle", "time": 7206.91, "timestamp": "02:00:06", "text": "ニーズ。まあ、でもそれは私を"}, {"type": "subtitle", "time": 7209.189, "timestamp": "02:00:09", "text": "残業させるのは気が進まない"}, {"type": "subtitle", "time": 7210.99, "timestamp": "02:00:10", "text": "個人的な問題に対処する"}, {"type": "subtitle", "time": 7213.43, "timestamp": "02:00:13", "text": "問題。もしあなたが私を助けてくれるなら、"}, {"type": "subtitle", "time": 7215.43, "timestamp": "02:00:15", "text": "感謝の印として報酬を受け取る"}, {"type": "subtitle", "time": 7222.35, "timestamp": "02:00:22", "text": "節約。ああ、心配しないでください"}, {"type": "subtitle", "time": 7224.91, "timestamp": "02:00:24", "text": "補償。私の給料は完璧です"}, {"type": "subtitle", "time": 7227.669, "timestamp": "02:00:27", "text": "十分な。実際、私は有能な"}, {"type": "subtitle", "time": 7230.95, "timestamp": "02:00:30", "text": "友人を思い浮かべて。何？採用したらどうなるか"}, {"type": "subtitle", "time": 7234.629, "timestamp": "02:00:34", "text": "彼女に手伝ってもらうのはどうだろう？何てことだ。彼女は"}, {"type": "subtitle", "time": 7238.27, "timestamp": "02:00:38", "text": "シーシャ、この仕事をバカにするつもりですか"}, {"type": "subtitle", "time": 7243.35, "timestamp": "02:00:43", "text": "自分？おお。おお。私を見て。さあ、"}, {"type": "subtitle", "time": 7245.43, "timestamp": "02:00:45", "text": "病院とあなたの怪我について。今彼女は"}, {"type": "subtitle", "time": 7248.63, "timestamp": "02:00:48", "text": "私のところに来るつもりじゃない"}, {"type": "subtitle", "time": 7255.27, "timestamp": "02:00:55", "text": "彼女？ジョックニックはここに到着するはずです"}, {"type": "subtitle", "time": 7259.51, "timestamp": "02:00:59", "text": "すぐ。バカ、右側を見て、"}]
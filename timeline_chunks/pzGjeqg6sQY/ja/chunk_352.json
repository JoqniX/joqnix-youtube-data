[{"type": "subtitle", "time": 21122.59, "timestamp": "05:52:02", "text": "持っている。しかし"}, {"type": "subtitle", "time": 21133.34, "timestamp": "05:52:13", "text": "私は理解できません"}, {"type": "subtitle", "time": 21141.14, "timestamp": "05:52:21", "text": "質感。見てみましょう"}, {"type": "subtitle", "time": 21144.03, "timestamp": "05:52:24", "text": "[音楽]"}, {"type": "subtitle", "time": 21146.35, "timestamp": "05:52:26", "text": "不透明度。"}, {"type": "subtitle", "time": 21149.91, "timestamp": "05:52:29", "text": "えっと、これに関するチュートリアルがありますよ。私はできる"}, {"type": "subtitle", "time": 21152.628, "timestamp": "05:52:32", "text": "今のあれを見てください。"}, {"type": "subtitle", "time": 21168.708, "timestamp": "05:52:48", "text": "昨日スタジオで撮影しました。私はこれらを見ていました"}, {"type": "subtitle", "time": 21170.548, "timestamp": "05:52:50", "text": "私が寝ている間に、そして私は寝たと思います"}, {"type": "subtitle", "time": 21173.51, "timestamp": "05:52:53", "text": "パラドックスアニメーションの後にオフ。私は思う"}]
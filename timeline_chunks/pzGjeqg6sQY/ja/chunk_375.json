[{"type": "subtitle", "time": 22504.99, "timestamp": "06:15:04", "text": "えっと、これは動いてるの？それとも私が"}, {"type": "subtitle", "time": 22514.83, "timestamp": "06:15:14", "text": "私はそれをやっているのか"}, {"type": "subtitle", "time": 22531.83, "timestamp": "06:15:31", "text": "秒。回転させてみたらどうでしょう？さあ"}, {"type": "subtitle", "time": 22534.51, "timestamp": "06:15:34", "text": "何でもやっていいよ、"}, {"type": "subtitle", "time": 22537.03, "timestamp": "06:15:37", "text": "男。何も起こっていない。私は手に入れている"}, {"type": "subtitle", "time": 22544.39, "timestamp": "06:15:44", "text": "そこには。ああ、それを下に置くのを忘れていました"}, {"type": "subtitle", "time": 22548.23, "timestamp": "06:15:48", "text": "グループ。ああ、私はなんてバカなんだろう。何てことだ。"}, {"type": "subtitle", "time": 22549.628, "timestamp": "06:15:49", "text": "ああ、"}, {"type": "subtitle", "time": 22559.11, "timestamp": "06:15:59", "text": "いいね。いいですね。私は"}]
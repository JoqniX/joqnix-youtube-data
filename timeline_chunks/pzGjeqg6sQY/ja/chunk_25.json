[{"type": "subtitle", "time": 1503.11, "timestamp": "00:25:03", "text": "ba。とにかく、とりあえず、機内に載せておきます。"}, {"type": "subtitle", "time": 1519.549, "timestamp": "00:25:19", "text": "うん、本当にリスクを冒すべきじゃない"}, {"type": "subtitle", "time": 1522.25, "timestamp": "00:25:22", "text": "これ。ごめんね、みんな。私は行きます"}, {"type": "subtitle", "time": 1523.71, "timestamp": "00:25:23", "text": "[音楽]"}, {"type": "subtitle", "time": 1551.99, "timestamp": "00:25:51", "text": "少し。私は怠けたくない、待って、"}, {"type": "subtitle", "time": 1554.789, "timestamp": "00:25:54", "text": "猫背になりたいのですが、試してみればいいでしょうか？"}, {"type": "subtitle", "time": 1558.789, "timestamp": "00:25:58", "text": "いつも椅子に座っている。私はただ私は"}]
[{"type": "subtitle", "time": 7920.47, "timestamp": "02:12:00", "text": "配信は全く予定外だった。"}, {"type": "chat", "time": 7921.986, "timestamp": "02:12:01", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ-7tIYCO_9EPt-GMgAwUCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ-7tIYCO_9EPt-GMgAwUCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ-7tIYCO_9EPt-GMgAw"}, {"type": "subtitle", "time": 7922.87, "timestamp": "02:12:02", "text": "君の息子。   正直に言うと、"}, {"type": "subtitle", "time": 7929.189, "timestamp": "02:12:09", "text": "ここに来て「"}, {"type": "subtitle", "time": 7932.47, "timestamp": "02:12:12", "text": "ミナ、今日が最終日だよ」って言いたかったんです。"}, {"type": "subtitle", "time": 7935.669, "timestamp": "02:12:15", "text": "少しだけ話しましょう。 正直、私は、"}, {"type": "subtitle", "time": 7945.75, "timestamp": "02:12:25", "text": "明日への準備が全くできていないことや、"}, {"type": "subtitle", "time": 7950.39, "timestamp": "02:12:30", "text": "学校やアルバイトなどで全く時間がないことを、長々と話したり、長々と話したりするつもりでした"}, {"type": "subtitle", "time": 7953.589, "timestamp": "02:12:33", "text": "。 本当に辛かったし、"}, {"type": "subtitle", "time": 7959.43, "timestamp": "02:12:39", "text": "今日は何も話さなかったよ。"}, {"type": "subtitle", "time": 7962.31, "timestamp": "02:12:42", "text": "心配事も、緊張も、不安も"}, {"type": "subtitle", "time": 7965.109, "timestamp": "02:12:45", "text": "、何もない。 今日はただ、私が楽しむだけの一日でした"}, {"type": "subtitle", "time": 7968.39, "timestamp": "02:12:48", "text": "。 そして、皆さんは、ありのままの"}, {"type": "subtitle", "time": 7975.35, "timestamp": "02:12:55", "text": "自分でいることを楽しんでいる、"}]
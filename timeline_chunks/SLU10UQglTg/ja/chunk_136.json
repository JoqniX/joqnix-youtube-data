[{"type": "subtitle", "time": 8165.669, "timestamp": "02:16:05", "text": "7年か6年くらい経ったと"}, {"type": "subtitle", "time": 8168.39, "timestamp": "02:16:08", "text": "思う。  6年だと思います。  6年"}, {"type": "subtitle", "time": 8172.069, "timestamp": "02:16:12", "text": "以上。 だから私はまず、スポーツマンとしてこの旅を始めたのです"}, {"type": "subtitle", "time": 8174.79, "timestamp": "02:16:14", "text": "。 まだ自分の答えが見つかってないんだ。"}, {"type": "subtitle", "time": 8178.87, "timestamp": "02:16:18", "text": "あぁ、水が"}, {"type": "subtitle", "time": 8184.229, "timestamp": "02:16:24", "text": "顔に落ちてきたよ。 話させてください。 わかった。 ええ、"}, {"type": "subtitle", "time": 8186.069, "timestamp": "02:16:26", "text": "そうですね、まだ"}, {"type": "subtitle", "time": 8189.75, "timestamp": "02:16:29", "text": "自分の旅の答えは見つかっていません。 私はまだ"}, {"type": "subtitle", "time": 8193.91, "timestamp": "02:16:33", "text": "探していて、これからも一緒に"}, {"type": "subtitle", "time": 8197.11, "timestamp": "02:16:37", "text": "探し続けたいと思っています"}, {"type": "subtitle", "time": 8204.23, "timestamp": "02:16:44", "text": "。"}, {"type": "subtitle", "time": 8207.83, "timestamp": "02:16:47", "text": "うん、一緒に探し続けよう。"}, {"type": "subtitle", "time": 8212.15, "timestamp": "02:16:52", "text": "それで、えっと、ああ"}, {"type": "subtitle", "time": 8214.629, "timestamp": "02:16:54", "text": "、喉が渇いた。"}, {"type": "subtitle", "time": 8217.99, "timestamp": "02:16:57", "text": "私はADHDか何かでしょうか？ 私は、私は、私はまるで"}]
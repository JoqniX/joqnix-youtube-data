[{"type": "subtitle", "time": 9001.83, "timestamp": "02:30:01", "text": "。"}, {"type": "subtitle", "time": 9006.389, "timestamp": "02:30:06", "text": "でも、うん、今日はいい天気だったよ。公平に言ってね。私は"}, {"type": "subtitle", "time": 9009.91, "timestamp": "02:30:09", "text": "乾いてるから。だから聞いたんだけど、"}, {"type": "subtitle", "time": 9014.55, "timestamp": "02:30:14", "text": "夜にまた公園に行って、"}, {"type": "subtitle", "time": 9017.19, "timestamp": "02:30:17", "text": "一度だけ君が"}, {"type": "subtitle", "time": 9020.389, "timestamp": "02:30:20", "text": "濡れるようにしようかって。"}, {"type": "subtitle", "time": 9022.79, "timestamp": "02:30:22", "text": "でも君は昼間派だって言ってたよね"}, {"type": "subtitle", "time": 9025.11, "timestamp": "02:30:25", "text": "。"}, {"type": "subtitle", "time": 9029.349, "timestamp": "02:30:29", "text": "だから、申し訳ない気持ちになった。えっと、"}, {"type": "subtitle", "time": 9031.83, "timestamp": "02:30:31", "text": "この時間帯に配信してるんだけど、いや、"}, {"type": "subtitle", "time": 9033.99, "timestamp": "02:30:33", "text": "この時間帯に配信を終えてるんだ。たいてい君はそれを見逃すことが多いよね"}, {"type": "subtitle", "time": 9056.71, "timestamp": "02:30:56", "text": "、ダイアナ、ワークアウトに切り替えよう。あれは"}]
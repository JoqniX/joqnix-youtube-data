[{"type": "subtitle", "time": 9783.99, "timestamp": "02:43:03", "text": "うん。楽しいよ。"}, {"type": "subtitle", "time": 9786.55, "timestamp": "02:43:06", "text": "今みたいに片手でやるよ。"}, {"type": "subtitle", "time": 9790.15, "timestamp": "02:43:10", "text": "地面がびしょびしょ濡れになる。"}, {"type": "subtitle", "time": 9791.99, "timestamp": "02:43:11", "text": "でもうん。"}, {"type": "subtitle", "time": 9795.429, "timestamp": "02:43:15", "text": "オーケー、ミナ。もう一度やるよ。3"}, {"type": "subtitle", "time": 9799.19, "timestamp": "02:43:19", "text": "。"}, {"type": "subtitle", "time": 9802.71, "timestamp": "02:43:22", "text": "カメラを持っている間、自分が映らないといいんだけど。オーケー。3、2、1"}, {"type": "subtitle", "time": 9805.11, "timestamp": "02:43:25", "text": "。あ、待って。待って。 失敗、失敗、失敗。"}, {"type": "subtitle", "time": 9807.67, "timestamp": "02:43:27", "text": "それで？"}, {"type": "subtitle", "time": 9812.23, "timestamp": "02:43:32", "text": "３、３、２、１。誰かいる？よし、ちょっと"}, {"type": "subtitle", "time": 9816.23, "timestamp": "02:43:36", "text": "待って。３、２、１。やべぇ。なんてこった。なんてこった。なんてこった。やべぇ。よし。よし、１人だ。誰もいないよね"}, {"type": "subtitle", "time": 9831.19, "timestamp": "02:43:51", "text": "？誰もいないよね？よし。誰もいないよね"}]
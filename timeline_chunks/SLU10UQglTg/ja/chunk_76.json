[{"type": "subtitle", "time": 4560.31, "timestamp": "01:16:00", "text": "子供向けの公園を探検してみようかな。"}, {"type": "subtitle", "time": 4575.51, "timestamp": "01:16:15", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 4578.149, "timestamp": "01:16:18", "text": "ああ、神様。 ああ、神様。 ああ、神様。 あ、待って。 それは来た。"}, {"type": "subtitle", "time": 4586.149, "timestamp": "01:16:26", "text": "あと、ボールはこっちで見つけました。 いいえ。私はそれを"}, {"type": "subtitle", "time": 4588.39, "timestamp": "01:16:28", "text": "保管しておきます。"}, {"type": "subtitle", "time": 4591.189, "timestamp": "01:16:31", "text": "それは私の物ではありません。"}, {"type": "subtitle", "time": 4597.83, "timestamp": "01:16:37", "text": "こんにちは、クラウド。 よし、それを"}, {"type": "subtitle", "time": 4601.669, "timestamp": "01:16:41", "text": "３回やらなきゃ。 さあ行こう。"}, {"type": "subtitle", "time": 4604.63, "timestamp": "01:16:44", "text": "はい、あなたが彼女に見ているあのものです。 待って、"}, {"type": "subtitle", "time": 4607.75, "timestamp": "01:16:47", "text": "誰かいるの？"}, {"type": "subtitle", "time": 4609.35, "timestamp": "01:16:49", "text": "待って、"}, {"type": "subtitle", "time": 4613.189, "timestamp": "01:16:53", "text": "待って。   あれは"}]
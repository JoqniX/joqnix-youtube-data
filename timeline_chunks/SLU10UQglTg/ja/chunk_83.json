[{"type": "subtitle", "time": 4984.95, "timestamp": "01:23:04", "text": "よし、これで1つ目だ。"}, {"type": "subtitle", "time": 4988.31, "timestamp": "01:23:08", "text": "よし、今度はこっち側からやってみよう。"}, {"type": "subtitle", "time": 4998.31, "timestamp": "01:23:18", "text": "ああ、赤だ。 ああ、青。"}, {"type": "subtitle", "time": 5008.709, "timestamp": "01:23:28", "text": "叫べ。 ああ。 ああ、神様。 わかった。 わかった。 何てことだ"}, {"type": "subtitle", "time": 5015.59, "timestamp": "01:23:35", "text": "。"}, {"type": "subtitle", "time": 5024.39, "timestamp": "01:23:44", "text": "これは忍者のためのものだ。 ああ、くそ。   よし"}, {"type": "subtitle", "time": 5026.55, "timestamp": "01:23:46", "text": "。   わかった"}, {"type": "subtitle", "time": 5030.87, "timestamp": "01:23:50", "text": "。 雲が一つ近づいてくる。"}, {"type": "subtitle", "time": 5032.87, "timestamp": "01:23:52", "text": "最初に作ったもう一つは、"}, {"type": "subtitle", "time": 5035.75, "timestamp": "01:23:55", "text": "Dash用だった。 言い忘れていました。"}, {"type": "subtitle", "time": 5037.59, "timestamp": "01:23:57", "text": "なぜ私は、来てくれる"}, {"type": "subtitle", "time": 5039.75, "timestamp": "01:23:59", "text": "視聴者全員のためにそれをやろうとするのか、自分でもわからない。 これが"}]
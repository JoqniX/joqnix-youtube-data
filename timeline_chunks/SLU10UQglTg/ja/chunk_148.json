[{"type": "subtitle", "time": 8881.03, "timestamp": "02:28:01", "text": "ええ、知っています。見ることができなかったのです"}, {"type": "subtitle", "time": 8883.67, "timestamp": "02:28:03", "text": "が、Twitterでいくつかのクリップを見ました"}, {"type": "subtitle", "time": 8891.27, "timestamp": "02:28:11", "text": "、面白そうですね。"}, {"type": "subtitle", "time": 8896.07, "timestamp": "02:28:16", "text": "時間がなくて見られなかったんです。"}, {"type": "subtitle", "time": 8901.83, "timestamp": "02:28:21", "text": "明日のビッグシュリンプの準備をする時間さえありませんでした。  [鼻を鳴らす] もうすぐ"}, {"type": "subtitle", "time": 8905.03, "timestamp": "02:28:25", "text": "終わりにしようと"}, {"type": "subtitle", "time": 8907.19, "timestamp": "02:28:27", "text": "思うんだけど、うん、明日もし時間があったら、"}, {"type": "subtitle", "time": 8912.63, "timestamp": "02:28:32", "text": "この時間くらいに遊びに来てね。デビューするから、来てね。"}, {"type": "subtitle", "time": 8916.23, "timestamp": "02:28:36", "text": "大々的なデビューとかじゃなくて、"}, {"type": "subtitle", "time": 8921.51, "timestamp": "02:28:41", "text": "モデルを紹介したり、私のことを"}]
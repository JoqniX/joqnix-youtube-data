[{"type": "subtitle", "time": 3182.069, "timestamp": "00:53:02", "text": "いいね。ここ"}, {"type": "subtitle", "time": 3184.069, "timestamp": "00:53:04", "text": "3日間、私の心は"}, {"type": "subtitle", "time": 3192.87, "timestamp": "00:53:12", "text": "私はここで楽しんでる。"}, {"type": "subtitle", "time": 3196.426, "timestamp": "00:53:16", "text": "明日のデビュー配信の準備すらしてない。"}, {"type": "subtitle", "time": 3197.109, "timestamp": "00:53:17", "text": "[笑]"}, {"type": "subtitle", "time": 3199.99, "timestamp": "00:53:19", "text": "文字通り雨の中でクレイジーなことをしてるけど、"}, {"type": "subtitle", "time": 3204.79, "timestamp": "00:53:24", "text": "誰もいない。もし"}, {"type": "subtitle", "time": 3215.75, "timestamp": "00:53:35", "text": "「よし、もう一度だ。」"}, {"type": "subtitle", "time": 3218.39, "timestamp": "00:53:38", "text": "水しぶきを浴びるだろう。"}, {"type": "subtitle", "time": 3221.75, "timestamp": "00:53:41", "text": "私の足がそれに乗っている。 わかった。 こんにちは。  ３、２、１"}, {"type": "subtitle", "time": 3225.109, "timestamp": "00:53:45", "text": "。 しゃがむ。 ああ、くそ。  [咳払い] しゃがんでください"}, {"type": "subtitle", "time": 3229.349, "timestamp": "00:53:49", "text": "。"}, {"type": "subtitle", "time": 3233.99, "timestamp": "00:53:53", "text": "ああ、神様。 二。"}, {"type": "subtitle", "time": 3236.309, "timestamp": "00:53:56", "text": "三つ。 黄色。   わかった"}]
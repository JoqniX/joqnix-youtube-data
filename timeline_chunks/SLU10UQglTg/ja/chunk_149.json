[{"type": "subtitle", "time": 8944.55, "timestamp": "02:29:04", "text": "とにかく、2時間、2時間30"}, {"type": "subtitle", "time": 8947.03, "timestamp": "02:29:07", "text": "分。オーケー。2時間30分。オーケー、"}, {"type": "subtitle", "time": 8951.03, "timestamp": "02:29:11", "text": "ミナ、そろそろ終わりにしないといけないね。じゃあ、"}, {"type": "subtitle", "time": 8952.95, "timestamp": "02:29:12", "text": "君が自分を見せるんだね。私は"}, {"type": "subtitle", "time": 8956.55, "timestamp": "02:29:16", "text": "この男を見せるよ。うん、"}, {"type": "subtitle", "time": 8959.11, "timestamp": "02:29:19", "text": "この男がこれから"}, {"type": "subtitle", "time": 8971.83, "timestamp": "02:29:31", "text": "このゲームやってるよ。わかってるよ。心配しないで。だって、"}, {"type": "subtitle", "time": 8973.83, "timestamp": "02:29:33", "text": "配信を午後5時"}, {"type": "subtitle", "time": 8979.75, "timestamp": "02:29:39", "text": "30分に始めて、8時30分に終わらせるんだもん。8時、"}, {"type": "subtitle", "time": 8981.349, "timestamp": "02:29:41", "text": "85分。"}, {"type": "subtitle", "time": 8986.71, "timestamp": "02:29:46", "text": "ルームメイトに叱られるよ。"}, {"type": "subtitle", "time": 8989.429, "timestamp": "02:29:49", "text": "彼は、私は 7時までには戻るよ。今は"}, {"type": "subtitle", "time": 8996.95, "timestamp": "02:29:56", "text": "でも今日はすごく雨が降ってたんだ。"}, {"type": "subtitle", "time": 8999.19, "timestamp": "02:29:59", "text": "雷雨とか、雷鳴みたいなのもあった"}]
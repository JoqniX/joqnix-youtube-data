[{"type": "subtitle", "time": 10980.07, "timestamp": "03:03:00", "text": "電車の中ではインターネットが切れて"}, {"type": "subtitle", "time": 10984.63, "timestamp": "03:03:04", "text": "話せなくなっちゃうから。"}, {"type": "subtitle", "time": 10986.95, "timestamp": "03:03:06", "text": "だから、"}, {"type": "subtitle", "time": 10997.51, "timestamp": "03:03:17", "text": "東京に着いてから配信した方がいいと思うんです。"}, {"type": "subtitle", "time": 11004.63, "timestamp": "03:03:24", "text": "東京まで4時間かけて行ってから配信するよりは"}, {"type": "subtitle", "time": 11006.63, "timestamp": "03:03:26", "text": "。現地に"}, {"type": "subtitle", "time": 11011.349, "timestamp": "03:03:31", "text": "いる間は配信できないと思うんです。でも、"}, {"type": "subtitle", "time": 11013.349, "timestamp": "03:03:33", "text": "その場所が終わったら"}, {"type": "subtitle", "time": 11015.99, "timestamp": "03:03:35", "text": "家に帰ります。4時間かけて"}, {"type": "subtitle", "time": 11018.63, "timestamp": "03:03:38", "text": "家に帰るんです。ええ"}, {"type": "subtitle", "time": 11023.349, "timestamp": "03:03:43", "text": "。"}, {"type": "subtitle", "time": 11026.389, "timestamp": "03:03:46", "text": "うーん。どうやって配信するかわかりません"}, {"type": "subtitle", "time": 11028.309, "timestamp": "03:03:48", "text": "。あと"}, {"type": "subtitle", "time": 11031.91, "timestamp": "03:03:51", "text": "、これはおもちゃの車です。"}, {"type": "subtitle", "time": 11035.83, "timestamp": "03:03:55", "text": "実物です。SOATオンラインガンを外したんです"}, {"type": "subtitle", "time": 11037.349, "timestamp": "03:03:57", "text": "。フロント"}]
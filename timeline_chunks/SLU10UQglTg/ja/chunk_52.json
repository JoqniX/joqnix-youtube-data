[{"type": "subtitle", "time": 3122.23, "timestamp": "00:52:02", "text": "洗うつもりだし。"}, {"type": "subtitle", "time": 3124.71, "timestamp": "00:52:04", "text": "だから、うん。"}, {"type": "subtitle", "time": 3126.95, "timestamp": "00:52:06", "text": "ベーコンとアリサと、私が会えなかった参加してくれたみんなはどう？"}, {"type": "subtitle", "time": 3134.15, "timestamp": "00:52:14", "text": "みんな元気だといいな。"}, {"type": "subtitle", "time": 3137.99, "timestamp": "00:52:17", "text": "人生で一番楽しんでる。今までこんなことなかったと思う"}, {"type": "subtitle", "time": 3140.63, "timestamp": "00:52:20", "text": "。あぁ"}, {"type": "subtitle", "time": 3143.51, "timestamp": "00:52:23", "text": "、雨がもっと強くなってきた。"}, {"type": "subtitle", "time": 3165.19, "timestamp": "00:52:45", "text": "あぁ、ハエが口に入ってきた。"}, {"type": "subtitle", "time": 3168.261, "timestamp": "00:52:48", "text": "何だよ？"}, {"type": "subtitle", "time": 3175.43, "timestamp": "00:52:55", "text": "よし、最後にもう一度。"}]
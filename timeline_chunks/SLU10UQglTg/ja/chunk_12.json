[{"type": "subtitle", "time": 723.59, "timestamp": "00:12:03", "text": "インスタグラムのストーリーをサッと投稿してくるね"}, {"type": "subtitle", "time": 725.19, "timestamp": "00:12:05", "text": "。"}, {"type": "subtitle", "time": 736.31, "timestamp": "00:12:16", "text": "ライブ配信を忘れてた。外にいるよ"}, {"type": "subtitle", "time": 745.75, "timestamp": "00:12:25", "text": "。   一緒に"}, {"type": "subtitle", "time": 755.67, "timestamp": "00:12:35", "text": "。"}, {"type": "subtitle", "time": 757.91, "timestamp": "00:12:37", "text": "私はまだ生きているのか？ 私はまだ生きているのか？ こんにちは。"}, {"type": "subtitle", "time": 761.829, "timestamp": "00:12:41", "text": "こんにちは。 私はこの車と共に暮らしています。"}, {"type": "chat", "time": 761.964, "timestamp": "00:12:41", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "yesh"}, {"type": "subtitle", "time": 764.949, "timestamp": "00:12:44", "text": "えっと、私は"}, {"type": "subtitle", "time": 767.43, "timestamp": "00:12:47", "text": "マルチタスクをしていて、まだ"}, {"type": "subtitle", "time": 770.15, "timestamp": "00:12:50", "text": "ライブ配信中だと思うんですけど、合ってますか？   そう思います。"}, {"type": "chat", "time": 778.776, "timestamp": "00:12:58", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "still live"}]
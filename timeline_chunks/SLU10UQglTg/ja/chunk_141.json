[{"type": "subtitle", "time": 8462.63, "timestamp": "02:21:02", "text": "今日、えっと、なぜ私はあんなに喋っていたんだろう？ ええ、今日が"}, {"type": "subtitle", "time": 8466.79, "timestamp": "02:21:06", "text": "最終日です。 だから私は"}, {"type": "subtitle", "time": 8472.389, "timestamp": "02:21:12", "text": "[笑い声と驚きの声]"}, {"type": "subtitle", "time": 8476.309, "timestamp": "02:21:16", "text": "「あ、"}, {"type": "subtitle", "time": 8481.59, "timestamp": "02:21:21", "text": "猫カフェがあるんだ。猫カフェに行こう。うん、"}, {"type": "subtitle", "time": 8483.429, "timestamp": "02:21:23", "text": "そうしよう。うん、うん、うん。そうしよう。そうしよう。うーん、"}, {"type": "subtitle", "time": 8489.83, "timestamp": "02:21:29", "text": "近くに猫カフェがあるかどうかわからない。"}, {"type": "subtitle", "time": 8493.83, "timestamp": "02:21:33", "text": "待って、待って、待って。ある。"}, {"type": "subtitle", "time": 8495.429, "timestamp": "02:21:35", "text": "ああ、うん、ある。"}, {"type": "subtitle", "time": 8498.07, "timestamp": "02:21:38", "text": "そこに行こう。ああ、うん。うん、うん、うん、うん。ああ"}, {"type": "subtitle", "time": 8499.91, "timestamp": "02:21:39", "text": "、うん、うん、うん、うん、うん。よし、"}, {"type": "subtitle", "time": 8501.83, "timestamp": "02:21:41", "text": "明日デビューしたら、日曜か"}, {"type": "subtitle", "time": 8504.469, "timestamp": "02:21:44", "text": "何かだ。ちょっと見てみよう。あ、待って。えっと、"}, {"type": "subtitle", "time": 8506.71, "timestamp": "02:21:46", "text": "お金あるかな？うん、"}, {"type": "subtitle", "time": 8508.71, "timestamp": "02:21:48", "text": "クレジットカードで払える。"}, {"type": "subtitle", "time": 8510.469, "timestamp": "02:21:50", "text": "支払いがあるといいな。"}, {"type": "subtitle", "time": 8512.79, "timestamp": "02:21:52", "text": "現金だったら、私は終わりだ。でも、うん、うん、そうしよう"}, {"type": "subtitle", "time": 8515.11, "timestamp": "02:21:55", "text": "。[笑い声]"}, {"type": "subtitle", "time": 8519.83, "timestamp": "02:21:59", "text": "猫カフェに行って、1"}]
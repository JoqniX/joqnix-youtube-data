[{"type": "subtitle", "time": 6601.83, "timestamp": "01:50:01", "text": "。 ええと、それは午後のことでした"}, {"type": "subtitle", "time": 6607.75, "timestamp": "01:50:07", "text": "えっと、"}, {"type": "subtitle", "time": 6621.189, "timestamp": "01:50:21", "text": "彼は私たちにドクシングするための情報をたくさん与えすぎている、"}, {"type": "subtitle", "time": 6624.95, "timestamp": "01:50:24", "text": "いいぞ、ああ神様、いや、私がストリームをしている間に、あなたが私のいるここまで来て、"}, {"type": "subtitle", "time": 6630.79, "timestamp": "01:50:30", "text": "私の顔の前で「こんにちは、ジョックネック」と言うことはできない"}, {"type": "subtitle", "time": 6633.91, "timestamp": "01:50:33", "text": "。 ああ、"}, {"type": "subtitle", "time": 6643.59, "timestamp": "01:50:43", "text": "どこかへ連れて行って。"}, {"type": "subtitle", "time": 6646.709, "timestamp": "01:50:46", "text": "私にはここに友達があまりいません。"}, {"type": "subtitle", "time": 6653.83, "timestamp": "01:50:53", "text": "。 何かが引っかかった。 何てことだ。"}, {"type": "subtitle", "time": 6657.59, "timestamp": "01:50:57", "text": "あれはバッタですか？  M."}, {"type": "subtitle", "time": 6658.87, "timestamp": "01:50:58", "text": "待って、待って、待って。 バッタ。"}]
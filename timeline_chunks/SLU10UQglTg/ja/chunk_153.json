[{"type": "subtitle", "time": 9184.309, "timestamp": "02:33:04", "text": "ストリームで初めてありのままの自分を見せていると思うから。だから"}, {"type": "subtitle", "time": 9191.349, "timestamp": "02:33:11", "text": "夜にあそこに戻るよ。"}, {"type": "subtitle", "time": 9195.67, "timestamp": "02:33:15", "text": "空に星があればいいのに。なんで曇ってるんだろう？ない。オーケー。えっと"}, {"type": "subtitle", "time": 9200.309, "timestamp": "02:33:20", "text": "、ちょっと"}, {"type": "subtitle", "time": 9206.55, "timestamp": "02:33:26", "text": "待って。えっと、オーケー。こっち。近道。"}, {"type": "subtitle", "time": 9209.67, "timestamp": "02:33:29", "text": "これが正しい道だと思う。"}, {"type": "subtitle", "time": 9217.51, "timestamp": "02:33:37", "text": "えっと、"}, {"type": "subtitle", "time": 9221.03, "timestamp": "02:33:41", "text": "歩いていたんだけど、えっと、"}, {"type": "subtitle", "time": 9228.95, "timestamp": "02:33:48", "text": "何？ああ、"}, {"type": "subtitle", "time": 9231.429, "timestamp": "02:33:51", "text": "すごくいい。"}, {"type": "subtitle", "time": 9235.19, "timestamp": "02:33:55", "text": "待って、ここはどこ？うんうん。えっと、"}, {"type": "subtitle", "time": 9239.429, "timestamp": "02:33:59", "text": "ここから左、右。"}]
[{"type": "subtitle", "time": 9724.389, "timestamp": "02:42:04", "text": "やってきた場所です。あれはシーソーです。あれは"}, {"type": "subtitle", "time": 9728.07, "timestamp": "02:42:08", "text": "シーソーです。これは物です。"}, {"type": "subtitle", "time": 9730.87, "timestamp": "02:42:10", "text": "もう一度やります。あの人が"}, {"type": "subtitle", "time": 9733.11, "timestamp": "02:42:13", "text": "真ん中にいるプレイです。オーケー。"}, {"type": "subtitle", "time": 9740.95, "timestamp": "02:42:20", "text": "。ああ、雨が降ってる。"}, {"type": "subtitle", "time": 9745.429, "timestamp": "02:42:25", "text": "さようなら。オーケー、行こう。D、"}, {"type": "subtitle", "time": 9748.07, "timestamp": "02:42:28", "text": "あなたのためにやるよ。行こう"}, {"type": "subtitle", "time": 9759.03, "timestamp": "02:42:39", "text": "ああ、雨が降ってる。"}, {"type": "subtitle", "time": 9761.349, "timestamp": "02:42:41", "text": "蜘蛛の女王はまだ生きている。まだ"}, {"type": "subtitle", "time": 9772.55, "timestamp": "02:42:52", "text": "何をしてるの？片手でやるよ"}, {"type": "subtitle", "time": 9774.07, "timestamp": "02:42:54", "text": "。"}, {"type": "subtitle", "time": 9779.67, "timestamp": "02:42:59", "text": "スマホを手に持ちながら片手でやるよ。"}]
[{"type": "subtitle", "time": 10561.91, "timestamp": "02:56:01", "text": "どこかで読んだんだけど、ずっと"}, {"type": "subtitle", "time": 10566.55, "timestamp": "02:56:06", "text": "歩かなきゃいけなかったんだ。 家に戻ってきました。あれは"}, {"type": "subtitle", "time": 10571.11, "timestamp": "02:56:11", "text": "クレイジーな出来事でした。どうやってやったのか自分でもわかりません"}, {"type": "subtitle", "time": 10577.99, "timestamp": "02:56:17", "text": "いつか配信でやってみたいです。"}, {"type": "subtitle", "time": 10581.03, "timestamp": "02:56:21", "text": "その日は公園に行く予定でした。自動"}, {"type": "subtitle", "time": 10583.11, "timestamp": "02:56:23", "text": "販売機で何か食べました。"}, {"type": "subtitle", "time": 10588.389, "timestamp": "02:56:28", "text": "スープみたいなもので、すごくまずかったです。"}, {"type": "subtitle", "time": 10591.03, "timestamp": "02:56:31", "text": "ああ、なんてこと。そしてどういうわけか"}, {"type": "subtitle", "time": 10593.429, "timestamp": "02:56:33", "text": "全部飲み干してしまいました。"}, {"type": "subtitle", "time": 10600.87, "timestamp": "02:56:40", "text": "よし、戻りましょう。さあ、来た。"}, {"type": "subtitle", "time": 10607.91, "timestamp": "02:56:47", "text": "それで、実はちょっと待って、"}, {"type": "subtitle", "time": 10610.309, "timestamp": "02:56:50", "text": "少しお見せできると思います。"}, {"type": "subtitle", "time": 10615.429, "timestamp": "02:56:55", "text": "ここが実はあのエリアです。あの"}, {"type": "subtitle", "time": 10618.55, "timestamp": "02:56:58", "text": "大きな大聖堂みたいなものが見えますか？あれはもう"}]
[{"type": "subtitle", "time": 7020.95, "timestamp": "01:57:00", "text": "ルールを破っている場合、"}, {"type": "subtitle", "time": 7023.51, "timestamp": "01:57:03", "text": "おじ茶の場合、"}, {"type": "subtitle", "time": 7027.43, "timestamp": "01:57:07", "text": "彼らがそう言うと、彼らは「えー、"}, {"type": "subtitle", "time": 7032.95, "timestamp": "01:57:12", "text": "デモ」と言うでしょう。 それ以外は、誰も気にしない。"}, {"type": "subtitle", "time": 7035.83, "timestamp": "01:57:15", "text": "あなたは好きなようにすればいいんです。 しかし、"}, {"type": "subtitle", "time": 7037.51, "timestamp": "01:57:17", "text": "ルールを守っていれば"}, {"type": "subtitle", "time": 7040.31, "timestamp": "01:57:20", "text": "安全です。 はい、ルールに従ってください。 こんにちは、こんにちは、"}, {"type": "subtitle", "time": 7042.229, "timestamp": "01:57:22", "text": "こんにちは。"}, {"type": "subtitle", "time": 7044.55, "timestamp": "01:57:24", "text": "でも、誰も何も言わないんだよね。 でも"}, {"type": "subtitle", "time": 7053.766, "timestamp": "01:57:33", "text": "UFOか。"}, {"type": "subtitle", "time": 7065.51, "timestamp": "01:57:45", "text": "ずぶ濡れで、しかも"}, {"type": "subtitle", "time": 7069.91, "timestamp": "01:57:49", "text": "汚れているのに、7号室に入るべきかどうかわからない。"}, {"type": "subtitle", "time": 7072.229, "timestamp": "01:57:52", "text": "ああ"}]
[{"type": "subtitle", "time": 2358.71, "timestamp": "00:39:18", "text": "他のことは全部忘れて、"}, {"type": "subtitle", "time": 2362.71, "timestamp": "00:39:22", "text": "この瞬間を楽しみたい。"}, {"type": "subtitle", "time": 2365.19, "timestamp": "00:39:25", "text": "だから、"}, {"type": "subtitle", "time": 2368.95, "timestamp": "00:39:28", "text": "明日の配信のこととか、"}, {"type": "subtitle", "time": 2372.15, "timestamp": "00:39:32", "text": "心配したり、"}, {"type": "subtitle", "time": 2376.71, "timestamp": "00:39:36", "text": "ストレスとか緊張とか不安とか、そういうことは全部忘れて"}, {"type": "subtitle", "time": 2379.632, "timestamp": "00:39:39", "text": "。そして私はここで"}, {"type": "subtitle", "time": 2380.31, "timestamp": "00:39:40", "text": "[笑い]"}, {"type": "subtitle", "time": 2383.43, "timestamp": "00:39:43", "text": "人生最高の時間を過ごすつもり。そして"}, {"type": "subtitle", "time": 2385.43, "timestamp": "00:39:45", "text": "明日は 私が緊張しているのがわかるでしょ"}, {"type": "subtitle", "time": 2388.55, "timestamp": "00:39:48", "text": "。"}]
[{"type": "subtitle", "time": 1759.35, "timestamp": "00:29:19", "text": "ああ、なんてこった。くそ。"}, {"type": "chat", "time": 1761.19, "timestamp": "00:29:21", "author": "@ProjectAizen", "avatar": "https://yt4.ggpht.com/J4g8YNWAMR7duRA_MC0DvcSZYNpONwi8eZHcWl3kui9q7oBp930GwOoPZ17Ct3rJcBQWDIsOKA=s64-c-k-c0x00ffffff-no-rj", "message": "you climb up"}, {"type": "subtitle", "time": 1763.669, "timestamp": "00:29:23", "text": "とても暑い。いや。 いや。いや。でき"}, {"type": "chat", "time": 1779.971, "timestamp": "00:29:39", "author": "@ProjectAizen", "avatar": "https://yt4.ggpht.com/J4g8YNWAMR7duRA_MC0DvcSZYNpONwi8eZHcWl3kui9q7oBp930GwOoPZ17Ct3rJcBQWDIsOKA=s64-c-k-c0x00ffffff-no-rj", "message": "you trust in the power of your hands and feet to climb up"}, {"type": "subtitle", "time": 1784.07, "timestamp": "00:29:44", "text": "。でも無理。雨が降ってる。雨が"}, {"type": "chat", "time": 1784.087, "timestamp": "00:29:44", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "he's trying with one hand"}, {"type": "subtitle", "time": 1786.87, "timestamp": "00:29:46", "text": "降ってる。D。"}, {"type": "subtitle", "time": 1790.31, "timestamp": "00:29:50", "text": "よし、やってみよう。よし、"}, {"type": "subtitle", "time": 1794.23, "timestamp": "00:29:54", "text": "死ぬと思う。落ちそう。自分の手を晒したく"}, {"type": "subtitle", "time": 1796.149, "timestamp": "00:29:56", "text": "ない。もう指は晒しちゃったし。片手。うん、片手でやるよ。くそ。くそ。ああ、"}]
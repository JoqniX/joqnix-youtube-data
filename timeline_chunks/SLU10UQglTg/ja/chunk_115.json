[{"type": "subtitle", "time": 6901.75, "timestamp": "01:55:01", "text": "。"}, {"type": "subtitle", "time": 6903.589, "timestamp": "01:55:03", "text": "誰にも見られていない時にこれをやりたい"}, {"type": "subtitle", "time": 6907.03, "timestamp": "01:55:07", "text": "。 叱られるのかな？"}, {"type": "subtitle", "time": 6911.35, "timestamp": "01:55:11", "text": "こんなことをしたら、夜に叱られるのかな？"}, {"type": "subtitle", "time": 6914.229, "timestamp": "01:55:14", "text": "彼は投げるためにここにいるのか？ ああ、彼は"}, {"type": "subtitle", "time": 6918.31, "timestamp": "01:55:18", "text": "トイレに行くんだ。"}, {"type": "subtitle", "time": 6929.589, "timestamp": "01:55:29", "text": "大丈夫ですか？ よし、彼はもう行ってしまった。 彼はもういない。"}, {"type": "subtitle", "time": 6931.83, "timestamp": "01:55:31", "text": "どうですか？ あの"}, {"type": "subtitle", "time": 6934.47, "timestamp": "01:55:34", "text": "バスにはもう一人乗っているはずだったんだけど、まあいいか。 私はただやるだけです"}, {"type": "subtitle", "time": 6936.629, "timestamp": "01:55:36", "text": "。 わかった。 なぜ"}, {"type": "subtitle", "time": 6940.55, "timestamp": "01:55:40", "text": "短く感じるのだろうか？ わかった。  3 2 ちょっと待って、"}, {"type": "subtitle", "time": 6943.35, "timestamp": "01:55:43", "text": "ブロックさせて。 えっと、"}, {"type": "subtitle", "time": 6959.669, "timestamp": "01:55:59", "text": "、やったぞ。 よし、いいぞ。 やったよ"}]
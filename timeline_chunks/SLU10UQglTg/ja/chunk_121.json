[{"type": "subtitle", "time": 7262.87, "timestamp": "02:01:02", "text": "30分、そして7時30分まで。 ああ、もう"}, {"type": "subtitle", "time": 7265.109, "timestamp": "02:01:05", "text": "工場とかそういう感じになってるよ。  2時間。 ああ、もう"}, {"type": "subtitle", "time": 7267.109, "timestamp": "02:01:07", "text": "2時間以上経ってる。"}, {"type": "subtitle", "time": 7269.91, "timestamp": "02:01:09", "text": "うん。"}, {"type": "subtitle", "time": 7272.95, "timestamp": "02:01:12", "text": "アパートをこんな風に見てください。 さあ、"}, {"type": "subtitle", "time": 7274.629, "timestamp": "02:01:14", "text": "ショーに行きましょう。 あれはフラットか"}, {"type": "chat", "time": 7276.812, "timestamp": "02:01:16", "author": "@KairoxGOAT", "avatar": "https://yt4.ggpht.com/ytc/AIdro_k3Uj98NXbkVdT_8NBl8-xyo_6GOGggHuqlTBhRCFll3O7ebUx3TA2UIOiS--bGrjiboA=s64-c-k-c0x00ffffff-no-rj", "message": "alien"}, {"type": "subtitle", "time": 7277.91, "timestamp": "02:01:17", "text": "何かでしょう。 あ、待って。 見つけたかって？ああ、"}, {"type": "subtitle", "time": 7280.47, "timestamp": "02:01:20", "text": "そうだ。 これじゃない、これだ。"}, {"type": "subtitle", "time": 7283.51, "timestamp": "02:01:23", "text": "番組に出てきたアパートは良かったね。 うん。"}, {"type": "subtitle", "time": 7286.709, "timestamp": "02:01:26", "text": "あそこで手に入れられたらいいのに。 そうそう。"}, {"type": "subtitle", "time": 7303.43, "timestamp": "02:01:43", "text": "よし、渡るよ。 ええ、ここは"}, {"type": "subtitle", "time": 7307.669, "timestamp": "02:01:47", "text": "私がいつも来て話をする公園で、"}, {"type": "subtitle", "time": 7313.189, "timestamp": "02:01:53", "text": "以前は音声のみのストリーミング配信をしていました。 ええ、"}, {"type": "subtitle", "time": 7316.709, "timestamp": "02:01:56", "text": "ここが私が初めて来た公園だったと思います。"}, {"type": "subtitle", "time": 7318.229, "timestamp": "02:01:58", "text": "では、私が"}]
[{"type": "subtitle", "time": 1326.95, "timestamp": "00:22:06", "text": "ああ、大変だ、私のスマホが濡れてる。"}, {"type": "subtitle", "time": 1331.029, "timestamp": "00:22:11", "text": "おお。 いいえ、私たちはこちらへ行きます。"}, {"type": "subtitle", "time": 1333.11, "timestamp": "00:22:13", "text": "誰かがこれを見たら、"}, {"type": "subtitle", "time": 1336.149, "timestamp": "00:22:16", "text": "「この子、頭おかしいんじゃないの"}, {"type": "subtitle", "time": 1340.07, "timestamp": "00:22:20", "text": "？走ってるよ。"}, {"type": "subtitle", "time": 1342.87, "timestamp": "00:22:22", "text": "雨の中走ってる。"}, {"type": "subtitle", "time": 1360.47, "timestamp": "00:22:40", "text": "待って、誰もいないよね？"}, {"type": "subtitle", "time": 1364.07, "timestamp": "00:22:44", "text": "誰も見えないよね？わかった。何？"}]
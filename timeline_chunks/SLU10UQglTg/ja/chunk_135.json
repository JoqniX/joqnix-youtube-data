[{"type": "subtitle", "time": 8100.55, "timestamp": "02:15:00", "text": "でも、"}, {"type": "subtitle", "time": 8104.069, "timestamp": "02:15:04", "text": "デスクトップ"}, {"type": "subtitle", "time": 8107.43, "timestamp": "02:15:07", "text": "ストリームではこういうことはできないかもしれないと思っています。なぜなら、アパートの"}, {"type": "subtitle", "time": 8109.99, "timestamp": "02:15:09", "text": "ルームメイトがいるから、今のように"}, {"type": "subtitle", "time": 8113.589, "timestamp": "02:15:13", "text": "一人ぼっちではないからです。今、私は"}, {"type": "subtitle", "time": 8121.189, "timestamp": "02:15:21", "text": "アパートからとても遠く離れた公園の真ん中にいますが、"}, {"type": "subtitle", "time": 8128.79, "timestamp": "02:15:28", "text": "気にしないでください。 私は自分のやりたいことをやるだけです"}, {"type": "subtitle", "time": 8145.91, "timestamp": "02:15:45", "text": "そして、長年にわたり私を支えてくださった皆様に心から感謝申し上げます"}, {"type": "subtitle", "time": 8148.79, "timestamp": "02:15:48", "text": "。"}, {"type": "subtitle", "time": 8152.39, "timestamp": "02:15:52", "text": "えっと、長年の"}, {"type": "subtitle", "time": 8155.27, "timestamp": "02:15:55", "text": "視聴者の方も、"}, {"type": "subtitle", "time": 8158.39, "timestamp": "02:15:58", "text": "これから配信を見る方や"}]
[{"type": "subtitle", "time": 4746.87, "timestamp": "01:19:06", "text": "。 ああ、くそ。"}, {"type": "subtitle", "time": 4749.669, "timestamp": "01:19:09", "text": "よし、これで1つ目だ。 ああ、神様。 私の手。 ああ、"}, {"type": "subtitle", "time": 4752.709, "timestamp": "01:19:12", "text": "私の手。 ああ、くそ。 ああ、なんてことだ。 ああ、そうだね"}, {"type": "subtitle", "time": 4771.75, "timestamp": "01:19:31", "text": "、あそこに水があるよ。"}, {"type": "subtitle", "time": 4774.95, "timestamp": "01:19:34", "text": "それが清潔であることを願っています。 よし、行こう。"}, {"type": "subtitle", "time": 4780.149, "timestamp": "01:19:40", "text": "、[息切れしながら]"}, {"type": "subtitle", "time": 4786.149, "timestamp": "01:19:46", "text": "[鼻を鳴らす]"}]
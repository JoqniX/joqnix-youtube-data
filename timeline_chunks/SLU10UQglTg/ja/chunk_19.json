[{"type": "subtitle", "time": 1140.23, "timestamp": "00:19:00", "text": "ライブ配信日です。 お時間があればぜひお立ち寄りください。"}, {"type": "subtitle", "time": 1146.63, "timestamp": "00:19:06", "text": "準備するには、ちょっと時間が足りないだろうな。 それはただ、"}, {"type": "subtitle", "time": 1149.27, "timestamp": "00:19:09", "text": "私が自己紹介を改めてするだけのことです。"}, {"type": "subtitle", "time": 1153.43, "timestamp": "00:19:13", "text": "私は誰？ えーっと、あれこれあって、"}, {"type": "subtitle", "time": 1158.87, "timestamp": "00:19:18", "text": "ストリーミングを始めて7年目なのに、今までデビューしたことがなくて、"}, {"type": "subtitle", "time": 1195.35, "timestamp": "00:19:55", "text": "明日の配信の準備もあまりできてなくて、全然"}, {"type": "subtitle", "time": 1199.19, "timestamp": "00:19:59", "text": "時間がなかったんです。 でも、ああ、確かにあそこに鳥がいるよ"}]
[{"type": "subtitle", "time": 5644.229, "timestamp": "01:34:04", "text": "ええ。 しかし、夜間には"}, {"type": "subtitle", "time": 5646.79, "timestamp": "01:34:06", "text": "家全体がLEDライトで覆われるエリアがある"}, {"type": "subtitle", "time": 5651.51, "timestamp": "01:34:11", "text": "。 待っていれば行きたいのですが、"}, {"type": "subtitle", "time": 5654.55, "timestamp": "01:34:14", "text": "その地域についてはよく知りません。"}, {"type": "subtitle", "time": 5656.87, "timestamp": "01:34:16", "text": "でも、まあ、"}, {"type": "subtitle", "time": 5659.59, "timestamp": "01:34:19", "text": "いいでしょう。 風邪をひかないように。 気をつけて。   来てくれて"}, {"type": "subtitle", "time": 5661.75, "timestamp": "01:34:21", "text": "ありがとう"}, {"type": "subtitle", "time": 5667.99, "timestamp": "01:34:27", "text": "明日お時間があれば、ぜひお立ち寄りください。 えっと、あと"}, {"type": "subtitle", "time": 5671.83, "timestamp": "01:34:31", "text": "1時間で配信が始まります。   うーん、多分"}, {"type": "subtitle", "time": 5674.629, "timestamp": "01:34:34", "text": "緊張すると思う"}, {"type": "subtitle", "time": 5678.629, "timestamp": "01:34:38", "text": "。 だって、私が配信するから、"}, {"type": "subtitle", "time": 5682.629, "timestamp": "01:34:42", "text": "ルームメイトが私の後ろで見てることになるんだ。"}, {"type": "subtitle", "time": 5685.83, "timestamp": "01:34:45", "text": "うん。 でも、そうだよ"}, {"type": "subtitle", "time": 5688.31, "timestamp": "01:34:48", "text": "。 こんなアパートがあったらいいのに"}, {"type": "subtitle", "time": 5694.709, "timestamp": "01:34:54", "text": "いや、いや、いや。 いいアパートをお見せしますよ。"}]
[{"type": "subtitle", "time": 3069.43, "timestamp": "00:51:09", "text": "私のズボン。"}, {"type": "subtitle", "time": 3073.94, "timestamp": "00:51:13", "text": "全部濡れてる。なんてこった。"}, {"type": "subtitle", "time": 3075.19, "timestamp": "00:51:15", "text": "[笑い]"}, {"type": "subtitle", "time": 3085.109, "timestamp": "00:51:25", "text": "石。ああ、神様。いいね。とても良かった。わかった。"}, {"type": "subtitle", "time": 3088.23, "timestamp": "00:51:28", "text": "ああ、待って。あれは何？"}, {"type": "subtitle", "time": 3091.03, "timestamp": "00:51:31", "text": "小さい方を選ばなかった。"}, {"type": "subtitle", "time": 3094.069, "timestamp": "00:51:34", "text": "もう一度行くべきかな？"}, {"type": "subtitle", "time": 3097.67, "timestamp": "00:51:37", "text": "この男のために5回やったんだ。"}, {"type": "subtitle", "time": 3107.51, "timestamp": "00:51:47", "text": "また同じことをしたらおかしいかな？わから"}, {"type": "subtitle", "time": 3113.24, "timestamp": "00:51:53", "text": "つまり、人生を楽しんで。でも"}, {"type": "subtitle", "time": 3113.829, "timestamp": "00:51:53", "text": "[笑]、"}, {"type": "subtitle", "time": 3115.51, "timestamp": "00:51:55", "text": "大丈夫。"}, {"type": "subtitle", "time": 3118.63, "timestamp": "00:51:58", "text": "お風呂に入ろうと思う。ドレスの服は全部"}]
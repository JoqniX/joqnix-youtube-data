[{"type": "subtitle", "time": 10323.91, "timestamp": "02:52:03", "text": "、家に帰ろう。 本当に"}, {"type": "subtitle", "time": 10325.67, "timestamp": "02:52:05", "text": "遅い時間だ。"}, {"type": "subtitle", "time": 10329.19, "timestamp": "02:52:09", "text": "うん、この時間くらいだよ、レックス。えっと"}, {"type": "subtitle", "time": 10330.87, "timestamp": "02:52:10", "text": "、この時間くらいなら"}, {"type": "subtitle", "time": 10333.03, "timestamp": "02:52:13", "text": "プレゼンテーションは終わってるはずだった。"}, {"type": "subtitle", "time": 10336.71, "timestamp": "02:52:16", "text": "明日どれくらい配信するか分からない。"}, {"type": "subtitle", "time": 10347.429, "timestamp": "02:52:27", "text": "いや。待って。それは、それはドクシングだ。いや、"}, {"type": "subtitle", "time": 10349.429, "timestamp": "02:52:29", "text": "できない。"}, {"type": "subtitle", "time": 10351.349, "timestamp": "02:52:31", "text": "待って。待って。どうすればスマホを"}, {"type": "subtitle", "time": 10353.51, "timestamp": "02:52:33", "text": "防水にできる？待って、待って、待って、待って、"}, {"type": "subtitle", "time": 10356.79, "timestamp": "02:52:36", "text": "待って。いい考えがある。いい考えがある。"}, {"type": "subtitle", "time": 10359.429, "timestamp": "02:52:39", "text": "これはクレイジーかもしれない。死ぬかもしれない。"}, {"type": "subtitle", "time": 10361.11, "timestamp": "02:52:41", "text": "これは生死に関わる状況だ"}, {"type": "subtitle", "time": 10364.79, "timestamp": "02:52:44", "text": "けど、"}, {"type": "subtitle", "time": 10369.67, "timestamp": "02:52:49", "text": "死ぬ可能性もある。でも待って、いい考えがある。"}, {"type": "subtitle", "time": 10372.15, "timestamp": "02:52:52", "text": "ルームメイトと先輩がやったんだ。あとは僕しか残ってない"}, {"type": "subtitle", "time": 10374.23, "timestamp": "02:52:54", "text": "。だから、この"}, {"type": "subtitle", "time": 10378.95, "timestamp": "02:52:58", "text": "防水の、あの、ショーみたいなものを"}]
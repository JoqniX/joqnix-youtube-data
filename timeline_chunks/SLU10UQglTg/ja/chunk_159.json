[{"type": "subtitle", "time": 9540.469, "timestamp": "02:39:00", "text": "いや、いや。あれは猫だ。待って、"}, {"type": "subtitle", "time": 9542.71, "timestamp": "02:39:02", "text": "待って。あれは猫だ。あれはああ、待って。"}, {"type": "subtitle", "time": 9549.429, "timestamp": "02:39:09", "text": "何だ。なぜぼやけているんだ？よし。よし、直った"}, {"type": "subtitle", "time": 9553.03, "timestamp": "02:39:13", "text": "。 えっと、ねえ、ベイビー。猫がいるよ。"}, {"type": "subtitle", "time": 9563.83, "timestamp": "02:39:23", "text": "ただの冗談だよ。何？ハニー。わかった。わかった"}, {"type": "subtitle", "time": 9566.95, "timestamp": "02:39:26", "text": "。あの人はあそこにいる。"}, {"type": "subtitle", "time": 9568.79, "timestamp": "02:39:28", "text": "光が見える？"}, {"type": "subtitle", "time": 9571.429, "timestamp": "02:39:31", "text": "あそこに行ってやれると思う。"}, {"type": "subtitle", "time": 9573.83, "timestamp": "02:39:33", "text": "片手でやるつもりだけど、"}, {"type": "subtitle", "time": 9576.23, "timestamp": "02:39:36", "text": "夜になるから"}, {"type": "subtitle", "time": 9579.67, "timestamp": "02:39:39", "text": "大丈夫だと思う。わかった、あそこにいる。"}, {"type": "subtitle", "time": 9582.07, "timestamp": "02:39:42", "text": "だから、私の計算が正しければ、私が手を伸ばして、彼らが"}, {"type": "subtitle", "time": 9588.71, "timestamp": "02:39:48", "text": "こちらに手を伸ばしたら、ここに戻ってくる。その頃には終わっている。わかった。わかった。わかった。2つやらなきゃいけないことがある"}, {"type": "subtitle", "time": 9595.11, "timestamp": "02:39:55", "text": "。1つはグラップル、もう1つ"}, {"type": "subtitle", "time": 9599.19, "timestamp": "02:39:59", "text": "はスライド。わかった"}]
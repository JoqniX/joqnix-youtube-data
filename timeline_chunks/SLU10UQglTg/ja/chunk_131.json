[{"type": "subtitle", "time": 7861.589, "timestamp": "02:11:01", "text": "変わらないよ。 ただ私だけです（咳払い）"}, {"type": "subtitle", "time": 7864.31, "timestamp": "02:11:04", "text": "ただ私の外見と、ええと、いろいろなものが"}, {"type": "subtitle", "time": 7867.83, "timestamp": "02:11:07", "text": "変わるだけです。 でも、"}, {"type": "subtitle", "time": 7872.709, "timestamp": "02:11:12", "text": "明日は新しい時代の幕開けってことだよね。 そして、"}, {"type": "subtitle", "time": 7876.709, "timestamp": "02:11:16", "text": "今日の配信が"}, {"type": "subtitle", "time": 7881.51, "timestamp": "02:11:21", "text": "古いスポーツマンのデモの最後の日のようなものだったとしても"}, {"type": "subtitle", "time": 7885.27, "timestamp": "02:11:25", "text": "、今日はある意味で"}, {"type": "subtitle", "time": 7888.229, "timestamp": "02:11:28", "text": "新しいジョークの始まり、小さな"}, {"type": "subtitle", "time": 7891.27, "timestamp": "02:11:31", "text": "予告編だったように感じます。 そう思います（笑）"}, {"type": "subtitle", "time": 7893.51, "timestamp": "02:11:33", "text": "。"}, {"type": "subtitle", "time": 7896.629, "timestamp": "02:11:36", "text": "そして私は、何も心配することなく、ありのままの自分でいられた"}, {"type": "subtitle", "time": 7900.31, "timestamp": "02:11:40", "text": "。 楽しむ。 そして、僕たちはあの"}, {"type": "subtitle", "time": 7903.43, "timestamp": "02:11:43", "text": "フープに2回得点したんだよね？ ボールを使って、私たちは"}, {"type": "subtitle", "time": 7907.109, "timestamp": "02:11:47", "text": "見つけました。"}, {"type": "subtitle", "time": 7909.75, "timestamp": "02:11:49", "text": "うん。"}, {"type": "subtitle", "time": 7917.91, "timestamp": "02:11:57", "text": "なぜ私はあんなことをしてしまったのだろう？ 今日の"}]
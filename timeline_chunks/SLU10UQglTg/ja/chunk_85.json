[{"type": "subtitle", "time": 5101.51, "timestamp": "01:25:01", "text": "今日はただ探検して楽しみたいだけだった。"}, {"type": "subtitle", "time": 5103.03, "timestamp": "01:25:03", "text": "だから、私のことは気にしないでください。"}, {"type": "subtitle", "time": 5109.35, "timestamp": "01:25:09", "text": "[笑い]"}, {"type": "subtitle", "time": 5111.11, "timestamp": "01:25:11", "text": "ああ、神様。"}, {"type": "subtitle", "time": 5113.91, "timestamp": "01:25:13", "text": "うん。 さよなら。 ああ、なんてことだ、私の足が。 ああ、"}, {"type": "subtitle", "time": 5116.47, "timestamp": "01:25:16", "text": "何もかも濡れている。"}, {"type": "subtitle", "time": 5119.51, "timestamp": "01:25:19", "text": "雨に濡れたように見えるけど、濡れてないよ"}, {"type": "subtitle", "time": 5132.87, "timestamp": "01:25:32", "text": "、本当に楽しかった。 ああ、さようなら"}, {"type": "subtitle", "time": 5141.03, "timestamp": "01:25:41", "text": "少なくとも今はビーチが見える。"}, {"type": "subtitle", "time": 5143.75, "timestamp": "01:25:43", "text": "それはとても素晴らしいですね。"}, {"type": "subtitle", "time": 5146.709, "timestamp": "01:25:46", "text": "カブトムシのお守りが来た。"}, {"type": "subtitle", "time": 5157.99, "timestamp": "01:25:57", "text": "日本の水はきれいだと私は信じています。 じゃあ、あそこの"}, {"type": "subtitle", "time": 5159.669, "timestamp": "01:25:59", "text": "パイプから飲もうかな"}]
[{"type": "subtitle", "time": 6540.31, "timestamp": "01:49:00", "text": "。 フラッシュを使った何かを作る必要がある"}, {"type": "subtitle", "time": 6543.27, "timestamp": "01:49:03", "text": "。"}, {"type": "subtitle", "time": 6544.87, "timestamp": "01:49:04", "text": "自分。   ああ"}, {"type": "subtitle", "time": 6548.31, "timestamp": "01:49:08", "text": "、カメラの上に落ちてきた。 あと、"}, {"type": "subtitle", "time": 6550.95, "timestamp": "01:49:10", "text": "これ、これ忘れてた。   あれって"}, {"type": "subtitle", "time": 6553.27, "timestamp": "01:49:13", "text": "何ていう名前だったっけ？ 酸っぱいし、なんか変な感じ"}, {"type": "subtitle", "time": 6555.109, "timestamp": "01:49:15", "text": "。"}, {"type": "chat", "time": 6560.153, "timestamp": "01:49:20", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "naisu"}, {"type": "subtitle", "time": 6560.47, "timestamp": "01:49:20", "text": "ああ、ここにはこういうのがたくさんあるね。"}, {"type": "subtitle", "time": 6562.31, "timestamp": "01:49:22", "text": "うん。"}, {"type": "subtitle", "time": 6564.07, "timestamp": "01:49:24", "text": "今は雨が降っているので、"}, {"type": "subtitle", "time": 6566.87, "timestamp": "01:49:26", "text": "ここには木々などがあって降りて来られません"}, {"type": "subtitle", "time": 6570.79, "timestamp": "01:49:30", "text": "。 ええと、それは"}, {"type": "subtitle", "time": 6574.629, "timestamp": "01:49:34", "text": "雨から身を隠す方法ではなく、雨宿りする方法です。"}, {"type": "subtitle", "time": 6586.95, "timestamp": "01:49:46", "text": "このエリアも素敵ですね。"}, {"type": "subtitle", "time": 6589.189, "timestamp": "01:49:49", "text": "どうやらここは学校か"}, {"type": "subtitle", "time": 6593.43, "timestamp": "01:49:53", "text": "何からしい。 私は何人かの人がブカトゥをしているのを見ました。ええと、私はそのような"}, {"type": "subtitle", "time": 6598.79, "timestamp": "01:49:58", "text": "ものを見たと思います"}]
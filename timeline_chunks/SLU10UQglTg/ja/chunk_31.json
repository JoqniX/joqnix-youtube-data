[{"type": "subtitle", "time": 1862.87, "timestamp": "00:31:02", "text": "。ああ、神様。自分で自分の顔を晒しちゃった？"}, {"type": "subtitle", "time": 1864.796, "timestamp": "00:31:04", "text": "私の顔でも見たの？"}, {"type": "subtitle", "time": 1865.59, "timestamp": "00:31:05", "text": "[ため息と息切れ]"}, {"type": "subtitle", "time": 1869.19, "timestamp": "00:31:09", "text": "ああ、神様。ああ ああ、神様。本当にやっちゃった。"}, {"type": "subtitle", "time": 1872.24, "timestamp": "00:31:12", "text": "ああ、神様。本当にやっちゃった。 ああ、神様。本当にやっちゃった。誰かが"}, {"type": "subtitle", "time": 1875.2, "timestamp": "00:31:15", "text": "ああ、神様。本当にやっちゃった。誰かが それを切り取った。ああ、神様。傘がなくなってしまった"}, {"type": "chat", "time": 1876.618, "timestamp": "00:31:16", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "nyo"}, {"type": "subtitle", "time": 1879.36, "timestamp": "00:31:19", "text": "それを切り取った。ああ、神様。傘がなくなってしまった 。何？"}, {"type": "subtitle", "time": 1882.88, "timestamp": "00:31:22", "text": "。何？ ああ、神様。"}, {"type": "subtitle", "time": 1885.12, "timestamp": "00:31:25", "text": "ああ、神様。 ああ、"}, {"type": "subtitle", "time": 1886.64, "timestamp": "00:31:26", "text": "ああ、 私の手が"}, {"type": "chat", "time": 1894.257, "timestamp": "00:31:34", "author": "@ProjectAizen", "avatar": "https://yt4.ggpht.com/J4g8YNWAMR7duRA_MC0DvcSZYNpONwi8eZHcWl3kui9q7oBp930GwOoPZ17Ct3rJcBQWDIsOKA=s64-c-k-c0x00ffffff-no-rj", "message": "I think I saw your face... but the Rain Water droplet on your camera made it look like a Hippo"}, {"type": "subtitle", "time": 1896.149, "timestamp": "00:31:36", "text": "ああ、神様。さよなら。私の手が"}, {"type": "subtitle", "time": 1897.909, "timestamp": "00:31:37", "text": "震えている。さよなら。わかった。"}, {"type": "subtitle", "time": 1906.149, "timestamp": "00:31:46", "text": "今度こそ死ぬかもしれない。この水たまり。でも、もし私が"}, {"type": "subtitle", "time": 1909.19, "timestamp": "00:31:49", "text": "落ちたら、なに、"}, {"type": "subtitle", "time": 1911.99, "timestamp": "00:31:51", "text": "あなたの顔を見たと思うけど、"}, {"type": "subtitle", "time": 1914.47, "timestamp": "00:31:54", "text": "雨水がカメラに落ちた。それで、何？"}, {"type": "subtitle", "time": 1917.19, "timestamp": "00:31:57", "text": "私の友達を見なかった。なに。"}, {"type": "subtitle", "time": 1919.83, "timestamp": "00:31:59", "text": "え？"}]
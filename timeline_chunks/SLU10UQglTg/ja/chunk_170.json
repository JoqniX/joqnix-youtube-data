[{"type": "subtitle", "time": 10204.71, "timestamp": "02:50:04", "text": "私は、私は、私は完全に"}, {"type": "subtitle", "time": 10217.99, "timestamp": "02:50:17", "text": "ああ、とても楽しかった。"}, {"type": "subtitle", "time": 10230.71, "timestamp": "02:50:30", "text": "来週東京に行ったときに、こんなクレイジーなことを全部できたらいいのに。"}, {"type": "subtitle", "time": 10233.83, "timestamp": "02:50:33", "text": "うーん、でも、"}, {"type": "subtitle", "time": 10237.11, "timestamp": "02:50:37", "text": "ショーのために家に帰らなければならないし、できないと思う。"}, {"type": "subtitle", "time": 10243.51, "timestamp": "02:50:43", "text": "うん、どうなるか気になる"}, {"type": "subtitle", "time": 10245.59, "timestamp": "02:50:45", "text": "。でも、"}, {"type": "subtitle", "time": 10247.75, "timestamp": "02:50:47", "text": "近くだったら、好きなことをして、"}, {"type": "subtitle", "time": 10250.55, "timestamp": "02:50:50", "text": "家に帰って身を"}, {"type": "subtitle", "time": 10252.309, "timestamp": "02:50:52", "text": "清めることができる。"}, {"type": "subtitle", "time": 10254.23, "timestamp": "02:50:54", "text": "全部。"}, {"type": "subtitle", "time": 10257.429, "timestamp": "02:50:57", "text": "足を洗った。もう一度ここに行くべきかな"}]
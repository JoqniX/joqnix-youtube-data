[{"type": "subtitle", "time": 7203.35, "timestamp": "02:00:03", "text": "ああ、わかりました。 赤色です。 あ、待って。"}, {"type": "subtitle", "time": 7206.31, "timestamp": "02:00:06", "text": "ガラスのある場所から離しておいた方がいいですね。"}, {"type": "subtitle", "time": 7210.229, "timestamp": "02:00:10", "text": "自分のシルエットが映り込むかもしれない。"}, {"type": "subtitle", "time": 7213.589, "timestamp": "02:00:13", "text": "つまり、私の影が見えるでしょう。"}, {"type": "subtitle", "time": 7216.709, "timestamp": "02:00:16", "text": "でも、ええ、そうですね"}, {"type": "subtitle", "time": 7220.79, "timestamp": "02:00:20", "text": "。"}, {"type": "subtitle", "time": 7226.87, "timestamp": "02:00:26", "text": "だから"}, {"type": "subtitle", "time": 7229.189, "timestamp": "02:00:29", "text": "神様、私は自分自身にあまり執着しないつもりです"}, {"type": "subtitle", "time": 7232.149, "timestamp": "02:00:32", "text": "。 私はただ"}, {"type": "subtitle", "time": 7234.39, "timestamp": "02:00:34", "text": "楽しむだけです。 でも、今日は本当に楽しかったよ"}, {"type": "subtitle", "time": 7238.39, "timestamp": "02:00:38", "text": "。 最後に、もう1つの公園を訪れて、締めくくりたいと思います"}, {"type": "subtitle", "time": 7243.109, "timestamp": "02:00:43", "text": "。 わかった。"}, {"type": "subtitle", "time": 7246.229, "timestamp": "02:00:46", "text": "カ・サイゴナ公園。 それで、私たちは３つの"}, {"type": "subtitle", "time": 7248.87, "timestamp": "02:00:48", "text": "場所を訪れました。  3つ目を訪れて、これで"}, {"type": "subtitle", "time": 7251.35, "timestamp": "02:00:51", "text": "締めくくりです。 よし"}, {"type": "subtitle", "time": 7253.669, "timestamp": "02:00:53", "text": "。"}, {"type": "subtitle", "time": 7255.75, "timestamp": "02:00:55", "text": "いつ配信を開始したか？ ショーは5時30分から"}, {"type": "subtitle", "time": 7258.87, "timestamp": "02:00:58", "text": "。  5時30分から6時"}]
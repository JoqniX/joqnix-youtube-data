[{"type": "subtitle", "time": 4620.07, "timestamp": "01:17:00", "text": "誰かですか？"}, {"type": "subtitle", "time": 4621.83, "timestamp": "01:17:01", "text": "待って、"}, {"type": "subtitle", "time": 4631.189, "timestamp": "01:17:11", "text": "私は楽しみたいんだ。"}, {"type": "subtitle", "time": 4634.07, "timestamp": "01:17:14", "text": "あれはブザーですか？"}, {"type": "subtitle", "time": 4637.189, "timestamp": "01:17:17", "text": "待って、あれ見える？ え、何？ ああ、"}, {"type": "subtitle", "time": 4640.55, "timestamp": "01:17:20", "text": "ただの木だよ。 わかった、気にしないで。   さあ行こう"}, {"type": "subtitle", "time": 4648.63, "timestamp": "01:17:28", "text": "ああ、雨が降ってる。 それほど"}, {"type": "subtitle", "time": 4652.229, "timestamp": "01:17:32", "text": "雨は降っていない。 小雨が降っているだけです。"}, {"type": "subtitle", "time": 4656.07, "timestamp": "01:17:36", "text": "天気はもう終わりだ。 こんにちは、クラウド。 久しぶりですね"}, {"type": "subtitle", "time": 4657.99, "timestamp": "01:17:37", "text": "。 ディオ、元気かい？ 会いたかったよ"}, {"type": "subtitle", "time": 4661.35, "timestamp": "01:17:41", "text": "。  D. わかりました。 ああ、水たまりだ。 ああ、くそ"}, {"type": "subtitle", "time": 4663.03, "timestamp": "01:17:43", "text": "。"}, {"type": "subtitle", "time": 4665.35, "timestamp": "01:17:45", "text": "ああ、神様。"}, {"type": "subtitle", "time": 4669.99, "timestamp": "01:17:49", "text": "こんにちは。 この男は私がそれをするのを"}, {"type": "subtitle", "time": 4672.709, "timestamp": "01:17:52", "text": "一度だけ見ていた。 えっと、片手で。   わーい"}, {"type": "subtitle", "time": 4674.87, "timestamp": "01:17:54", "text": "。"}, {"type": "subtitle", "time": 4678.31, "timestamp": "01:17:58", "text": "傘をここに置いて"}]
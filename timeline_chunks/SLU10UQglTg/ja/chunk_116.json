[{"type": "subtitle", "time": 6961.03, "timestamp": "01:56:01", "text": "。 あれは（鼻を鳴らして）とても"}, {"type": "subtitle", "time": 6962.709, "timestamp": "01:56:02", "text": "恥ずかしかった。"}, {"type": "subtitle", "time": 6966.149, "timestamp": "01:56:06", "text": "二度とあんなことはしない。 うん。 さよなら。 うん。 さよなら。 ああ、ああ、ああ"}, {"type": "subtitle", "time": 6969.27, "timestamp": "01:56:09", "text": "、足が痛い。"}, {"type": "subtitle", "time": 6980.87, "timestamp": "01:56:20", "text": "私はそれを公共の場所で行いました。 くそ。   何てことだ"}, {"type": "subtitle", "time": 6993.99, "timestamp": "01:56:33", "text": "ああ、彼は一人だった。 わかった。 誰もそれを見ていなかった。"}, {"type": "subtitle", "time": 6998.09, "timestamp": "01:56:38", "text": "うん。 うん。 ああ、でも君たちはそれを見たんだね。"}, {"type": "subtitle", "time": 7012.31, "timestamp": "01:56:52", "text": "うん、誰も批判したりしないよ。 私は自分のやりたいことをやるだけです"}, {"type": "subtitle", "time": 7014.79, "timestamp": "01:56:54", "text": "。 しかし、それが"}, {"type": "subtitle", "time": 7017.43, "timestamp": "01:56:57", "text": "日本の良いところでもあるのです。"}, {"type": "subtitle", "time": 7018.95, "timestamp": "01:56:58", "text": "誰も何も言わないだろう。 つまり、"}]
[{"type": "subtitle", "time": 4386.149, "timestamp": "01:13:06", "text": "よし、行こう。"}, {"type": "subtitle", "time": 4389.03, "timestamp": "01:13:09", "text": "誰もいないよね？"}, {"type": "subtitle", "time": 4392.79, "timestamp": "01:13:12", "text": "３、２、１、８"}, {"type": "subtitle", "time": 4396.47, "timestamp": "01:13:16", "text": "。 ああ、やばい、あれは"}, {"type": "subtitle", "time": 4400.79, "timestamp": "01:13:20", "text": "女の子っぽい投げ方だ。 ああ、"}, {"type": "subtitle", "time": 4403.03, "timestamp": "01:13:23", "text": "スポーツモードに切り替えよう。 待って、"}, {"type": "subtitle", "time": 4406.229, "timestamp": "01:13:26", "text": "傘を下ろして。 よし、行こう"}, {"type": "subtitle", "time": 4409.35, "timestamp": "01:13:29", "text": "。 片手投げ。"}, {"type": "subtitle", "time": 4415.189, "timestamp": "01:13:35", "text": "ああ、実はやってしまいました。 そうだったっけ？"}, {"type": "subtitle", "time": 4417.27, "timestamp": "01:13:37", "text": "ああ、"}, {"type": "subtitle", "time": 4430.47, "timestamp": "01:13:50", "text": "それが一つ目です。 わかった。  FLは非常に短い。"}, {"type": "subtitle", "time": 4432.95, "timestamp": "01:13:52", "text": "こんにちは。 片手投げ。 これは何ですか？"}, {"type": "subtitle", "time": 4435.35, "timestamp": "01:13:55", "text": "円盤投げ。"}]
[{"type": "subtitle", "time": 2701.99, "timestamp": "00:45:01", "text": "、待って。私がやるよ。わかった、"}, {"type": "subtitle", "time": 2705.91, "timestamp": "00:45:05", "text": "この男を私がやるよ。わかった、"}, {"type": "subtitle", "time": 2707.43, "timestamp": "00:45:07", "text": "画面をロックする。"}, {"type": "subtitle", "time": 2710.39, "timestamp": "00:45:10", "text": "えーと、アプリをロックする。そうすれば何もクリックし"}, {"type": "subtitle", "time": 2713.43, "timestamp": "00:45:13", "text": "たり、ソースや"}, {"type": "subtitle", "time": 2715.589, "timestamp": "00:45:15", "text": "シーンをクリックしたりしない。わかった"}, {"type": "subtitle", "time": 2725.67, "timestamp": "00:45:25", "text": "。"}, {"type": "subtitle", "time": 2728.95, "timestamp": "00:45:28", "text": "今、落ちないといいな。わかった"}, {"type": "subtitle", "time": 2738.71, "timestamp": "00:45:38", "text": "傘はここにあるよ。わかった。三度目の正直だよ"}, {"type": "subtitle", "time": 2741.91, "timestamp": "00:45:41", "text": "、ミナ。ああ、"}, {"type": "subtitle", "time": 2744.39, "timestamp": "00:45:44", "text": "スマホと"}, {"type": "subtitle", "time": 2747.03, "timestamp": "00:45:47", "text": "モバイルバッテリーを同時に持つのは難しい。わかった、"}, {"type": "subtitle", "time": 2753.43, "timestamp": "00:45:53", "text": "3、2、くそ、助けて。3、2、1"}, {"type": "subtitle", "time": 2754.95, "timestamp": "00:45:54", "text": "。"}, {"type": "chat", "time": 2757.967, "timestamp": "00:45:57", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "last day as joq huh? been a journey."}, {"type": "subtitle", "time": 2758.226, "timestamp": "00:45:58", "text": "ああ、くそ。[うめき声]"}]
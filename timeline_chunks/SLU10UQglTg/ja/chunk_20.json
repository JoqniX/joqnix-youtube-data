[{"type": "subtitle", "time": 1202.47, "timestamp": "00:20:02", "text": "。 見えますか？ あ、待って。 私の"}, {"type": "subtitle", "time": 1214.789, "timestamp": "00:20:14", "text": "ああ、神様。 これは何ですか？"}, {"type": "subtitle", "time": 1216.549, "timestamp": "00:20:16", "text": "ああ、"}, {"type": "subtitle", "time": 1220.63, "timestamp": "00:20:20", "text": "今日はすごく雨が降っているね。 道路がひどく濡れている。"}, {"type": "subtitle", "time": 1222.71, "timestamp": "00:20:22", "text": "道がとても濡れている。 草むらを通って行くべきでしょうか"}, {"type": "subtitle", "time": 1225.35, "timestamp": "00:20:25", "text": "？ 一緒に草に触れてみませんか？"}, {"type": "subtitle", "time": 1231.27, "timestamp": "00:20:31", "text": "草を触りに行こう。"}, {"type": "subtitle", "time": 1234.39, "timestamp": "00:20:34", "text": "草に触りに行こう。"}, {"type": "subtitle", "time": 1244.31, "timestamp": "00:20:44", "text": "なあ、今すぐ走りたい気分だよ。"}, {"type": "subtitle", "time": 1247.99, "timestamp": "00:20:47", "text": "逃げるべきだろうか？ 今日走りたいですか？"}, {"type": "subtitle", "time": 1251.11, "timestamp": "00:20:51", "text": "雨が降っている。  Y. ちょっと"}, {"type": "subtitle", "time": 1257.75, "timestamp": "00:20:57", "text": "ロック機能を使うためにスマホをロックさせて。 これらの"}]
[{"type": "subtitle", "time": 2173.43, "timestamp": "00:36:13", "text": "まだもっとやりたいことがある。"}, {"type": "subtitle", "time": 2175.589, "timestamp": "00:36:15", "text": "ほら。雨が"}, {"type": "subtitle", "time": 2177.91, "timestamp": "00:36:17", "text": "降っていて、"}, {"type": "subtitle", "time": 2182.31, "timestamp": "00:36:22", "text": "この場所に自分以外誰もいない時、幸せを感じない？"}, {"type": "subtitle", "time": 2186.63, "timestamp": "00:36:26", "text": "自分だけ。自然と雨。"}, {"type": "subtitle", "time": 2209.19, "timestamp": "00:36:49", "text": "待って、できない。ああ、そうだ。"}, {"type": "subtitle", "time": 2212.069, "timestamp": "00:36:52", "text": "ロック機能を追加しないといけない。少なくとも"}, {"type": "subtitle", "time": 2215.03, "timestamp": "00:36:55", "text": "ドックのロック機能をフルスクリーンで。わかった。"}]
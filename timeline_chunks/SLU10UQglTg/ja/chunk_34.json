[{"type": "subtitle", "time": 2044.07, "timestamp": "00:34:04", "text": "ああ、神様。私は何を言っていたのですか？"}, {"type": "chat", "time": 2045.097, "timestamp": "00:34:05", "author": "@ProjectAizen", "avatar": "https://yt4.ggpht.com/J4g8YNWAMR7duRA_MC0DvcSZYNpONwi8eZHcWl3kui9q7oBp930GwOoPZ17Ct3rJcBQWDIsOKA=s64-c-k-c0x00ffffff-no-rj", "message": "I think I saw the Hippo... instead of your face... Ahhhh maybe thats what I saw 😅😅"}, {"type": "subtitle", "time": 2045.909, "timestamp": "00:34:05", "text": "明日デビューがあります。だから今日は"}, {"type": "subtitle", "time": 2050.47, "timestamp": "00:34:10", "text": "ただ楽しみたいと思っていました。"}, {"type": "subtitle", "time": 2057.75, "timestamp": "00:34:17", "text": "顔の代わりに見たと思います。ああ、"}, {"type": "subtitle", "time": 2063.909, "timestamp": "00:34:23", "text": "この水たまりを歩いて通り抜けましょう。"}, {"type": "subtitle", "time": 2067.109, "timestamp": "00:34:27", "text": "水たまりを通るのは楽しいからです。"}, {"type": "chat", "time": 2067.956, "timestamp": "00:34:27", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "what a odd thing to say"}, {"type": "subtitle", "time": 2070.31, "timestamp": "00:34:30", "text": "もしオイシャンか誰かがこれをずっと見ていたらどうなるか想像してみてください"}, {"type": "subtitle", "time": 2074.869, "timestamp": "00:34:34", "text": "。ああ、それはとても恥ずかしいです。"}, {"type": "subtitle", "time": 2093.43, "timestamp": "00:34:53", "text": "、ベンチム"}, {"type": "subtitle", "time": 2095.43, "timestamp": "00:34:55", "text": "。"}]
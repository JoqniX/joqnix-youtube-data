[{"type": "subtitle", "time": 3609.27, "timestamp": "01:00:09", "text": "ナニー、"}, {"type": "subtitle", "time": 3613.43, "timestamp": "01:00:13", "text": "あなたは私のことをよくやってくれました。私はここにいませんでした"}, {"type": "subtitle", "time": 3615.99, "timestamp": "01:00:15", "text": "。 ナニの"}, {"type": "subtitle", "time": 3624.39, "timestamp": "01:00:24", "text": "それから、探検してみましょう。"}, {"type": "subtitle", "time": 3627.109, "timestamp": "01:00:27", "text": "私はこれらの地域を調査したことがありません。 はい、あそこにあるのが"}, {"type": "subtitle", "time": 3629.91, "timestamp": "01:00:29", "text": "小さな仕切り付きの個室です"}, {"type": "subtitle", "time": 3652.71, "timestamp": "01:00:52", "text": "ここでは野球ができるよ。 でも、本当に"}, {"type": "subtitle", "time": 3656.71, "timestamp": "01:00:56", "text": "素敵ですね。 これは野球用です。"}, {"type": "subtitle", "time": 3659.03, "timestamp": "01:00:59", "text": "ああ、ここに野球の試合があるよ"}]
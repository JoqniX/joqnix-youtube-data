[{"type": "subtitle", "time": 8356.95, "timestamp": "02:19:16", "text": "変わった。別の先生が来て、"}, {"type": "subtitle", "time": 8359.27, "timestamp": "02:19:19", "text": "このクラスは本当に迷惑だ。いつも"}, {"type": "subtitle", "time": 8361.27, "timestamp": "02:19:21", "text": "携帯"}, {"type": "subtitle", "time": 8365.11, "timestamp": "02:19:25", "text": "電話を見ている。」 それで、えっと、先生が"}, {"type": "subtitle", "time": 8367.429, "timestamp": "02:19:27", "text": "みんなの携帯電話を集めたんです。"}, {"type": "subtitle", "time": 8371.19, "timestamp": "02:19:31", "text": "あれはネコですか？ ああ、ミナ。 わかった。   わかりました"}, {"type": "subtitle", "time": 8375.11, "timestamp": "02:19:35", "text": "、必要です。 わかった。 待って。  M.ネコ。"}, {"type": "subtitle", "time": 8377.669, "timestamp": "02:19:37", "text": "ネコ。 ネコ。 ネオ。 ネオ。 ネオ。 何てことだ。"}, {"type": "subtitle", "time": 8384.79, "timestamp": "02:19:44", "text": "何？"}, {"type": "subtitle", "time": 8389.67, "timestamp": "02:19:49", "text": "見えますか？ あれが見えますか？ 彼はあそこにいる"}, {"type": "subtitle", "time": 8392.79, "timestamp": "02:19:52", "text": "。 あれが見えますか？ 見えますか"}, {"type": "subtitle", "time": 8395.99, "timestamp": "02:19:55", "text": "？ 彼はそこにいる。 猫がいる。"}]
[{"type": "subtitle", "time": 10921.19, "timestamp": "03:02:01", "text": "抹茶と、"}, {"type": "subtitle", "time": 10926.469, "timestamp": "03:02:06", "text": "えーとアイスコーヒーとかがある。"}, {"type": "subtitle", "time": 10929.03, "timestamp": "03:02:09", "text": "すごくいい。"}, {"type": "subtitle", "time": 10932.15, "timestamp": "03:02:12", "text": "オンラインでメニューを見た。"}, {"type": "subtitle", "time": 10935.59, "timestamp": "03:02:15", "text": "いつか試してみたい。あと、"}, {"type": "subtitle", "time": 10944.389, "timestamp": "03:02:24", "text": "質問がある。今私に。あと、"}, {"type": "subtitle", "time": 10946.23, "timestamp": "03:02:26", "text": "なんでこのウィスパーチャットが機能しないの"}, {"type": "subtitle", "time": 10948.07, "timestamp": "03:02:28", "text": "？"}, {"type": "subtitle", "time": 10956.23, "timestamp": "03:02:36", "text": "あと、質問がある。"}, {"type": "subtitle", "time": 10963.75, "timestamp": "03:02:43", "text": "土曜日、日曜日。えーと、"}, {"type": "subtitle", "time": 10966.23, "timestamp": "03:02:46", "text": "東京に行くんだけど。でも、私がやる"}, {"type": "subtitle", "time": 10967.83, "timestamp": "03:02:47", "text": "配信は全部地下鉄に乗るところから配信したいんだけど"}, {"type": "subtitle", "time": 10973.269, "timestamp": "03:02:53", "text": "。でも、問題は"}, {"type": "subtitle", "time": 10976.15, "timestamp": "03:02:56", "text": "地下鉄の中からは配信できないんです。"}]
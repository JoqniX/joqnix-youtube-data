[{"type": "subtitle", "time": 9067.75, "timestamp": "02:31:07", "text": "、すごく濡れてる。じゃあ、"}, {"type": "subtitle", "time": 9073.51, "timestamp": "02:31:13", "text": "あ、待って、喉が渇いた。"}, {"type": "subtitle", "time": 9082.389, "timestamp": "02:31:22", "text": "ああ、明日熱が出ないことを祈るばかりだ"}, {"type": "subtitle", "time": 9084.95, "timestamp": "02:31:24", "text": "。あ、待って。そんなこと言わないで。"}, {"type": "subtitle", "time": 9107.91, "timestamp": "02:31:47", "text": "うん、すごく雨が降ってた。"}]
[{"type": "subtitle", "time": 6481.35, "timestamp": "01:48:01", "text": "仕事が終わった後に私が君に電話した日のことを覚えているかい"}, {"type": "subtitle", "time": 6484.31, "timestamp": "01:48:04", "text": "？ ええ、私もそこで食事をしていましたよ"}, {"type": "subtitle", "time": 6488.39, "timestamp": "01:48:08", "text": "。 ここからそこへ。 私は"}, {"type": "subtitle", "time": 6491.51, "timestamp": "01:48:11", "text": "午後、ここで食事をしていました。"}, {"type": "subtitle", "time": 6498.47, "timestamp": "01:48:18", "text": "金曜日の仕事の後だったと思うけど、あの時のこと覚えてる？ ええ、ここにいましたよ"}, {"type": "subtitle", "time": 6503.27, "timestamp": "01:48:23", "text": "。 私はチップスとカップ"}, {"type": "subtitle", "time": 6508.87, "timestamp": "01:48:28", "text": "ヌードルをその上に置いて食べました。"}, {"type": "subtitle", "time": 6517.35, "timestamp": "01:48:37", "text": "ここは私が"}, {"type": "subtitle", "time": 6519.99, "timestamp": "01:48:39", "text": "初めてVispoライブカメラをテストした場所です。"}, {"type": "subtitle", "time": 6522.79, "timestamp": "01:48:42", "text": "私が配信に使っているこのアプリは、"}, {"type": "subtitle", "time": 6526.07, "timestamp": "01:48:46", "text": "現在チャドにいるユーラがYouTubeで作成したものです"}, {"type": "subtitle", "time": 6529.189, "timestamp": "01:48:49", "text": "。 ええ、ここが私が"}, {"type": "subtitle", "time": 6534.07, "timestamp": "01:48:54", "text": "カメラのテストをした最初の場所です。 男だ。 でも、本当に"}, {"type": "subtitle", "time": 6536.55, "timestamp": "01:48:56", "text": "素敵ですね。 あ、待って。 フラッシュして。"}, {"type": "subtitle", "time": 6538.149, "timestamp": "01:48:58", "text": "待って。   そうそう"}]
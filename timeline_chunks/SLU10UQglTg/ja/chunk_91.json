[{"type": "subtitle", "time": 5460.31, "timestamp": "01:31:00", "text": "私はこの場所を探索したことがありません。"}, {"type": "subtitle", "time": 5468.95, "timestamp": "01:31:08", "text": "あ、待って。 反射面。"}, {"type": "subtitle", "time": 5490.79, "timestamp": "01:31:30", "text": "今日はすごく楽しかった。"}, {"type": "subtitle", "time": 5500.79, "timestamp": "01:31:40", "text": "顔にタオルを巻いている。"}, {"type": "subtitle", "time": 5504.95, "timestamp": "01:31:44", "text": "今、私の首には青いフェイスタオルがかかっていて、その中に携帯電話と"}, {"type": "subtitle", "time": 5507.59, "timestamp": "01:31:47", "text": "モバイルバッテリーと傘が入っています。"}, {"type": "subtitle", "time": 5510.629, "timestamp": "01:31:50", "text": "メガネがびしょ濡れだ。 えっと、今、あの楽しい時間のせいで、"}, {"type": "subtitle", "time": 5513.188, "timestamp": "01:31:53", "text": "泥とか変なものが体中に付いてると思うよ"}]
[{"type": "subtitle", "time": 1630.789, "timestamp": "00:27:10", "text": "からここ、ここ、ここ、ここへ来て、"}, {"type": "subtitle", "time": 1634.549, "timestamp": "00:27:14", "text": "時々このベンチ"}, {"type": "subtitle", "time": 1637.35, "timestamp": "00:27:17", "text": "かあそこの木のベンチに座るか、あ、"}, {"type": "subtitle", "time": 1641.11, "timestamp": "00:27:21", "text": "待って、物を置くことができるから、このここ、このえーと、あそこの物を見せてあげるよ"}, {"type": "subtitle", "time": 1646.07, "timestamp": "00:27:26", "text": "。あそこの物"}]
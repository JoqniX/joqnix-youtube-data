[{"type": "subtitle", "time": 9602.79, "timestamp": "02:40:02", "text": "。やってみよう。"}, {"type": "subtitle", "time": 9606.07, "timestamp": "02:40:06", "text": "ちょっと続けて。"}, {"type": "subtitle", "time": 9609.51, "timestamp": "02:40:09", "text": "ああ、夜もまた楽しくなりそうだ"}, {"type": "subtitle", "time": 9612.95, "timestamp": "02:40:12", "text": "。夜にやるんだ。やったー。"}, {"type": "subtitle", "time": 9615.19, "timestamp": "02:40:15", "text": "あらまあ。"}, {"type": "subtitle", "time": 9618.15, "timestamp": "02:40:18", "text": "ちなみに、あれはランタンみたいなものだよ。"}, {"type": "subtitle", "time": 9624.55, "timestamp": "02:40:24", "text": "[笑い]"}, {"type": "subtitle", "time": 9644.87, "timestamp": "02:40:44", "text": "走り始めた方がいいかな？それで、私たちは"}, {"type": "subtitle", "time": 9646.87, "timestamp": "02:40:46", "text": "あそこで雨の中、地面に座っていた。ここは私が"}, {"type": "subtitle", "time": 9654.95, "timestamp": "02:40:54", "text": "夜、午後11時とか午前0時とかに空を見上げるために来る場所なんだ"}, {"type": "subtitle", "time": 9657.91, "timestamp": "02:40:57", "text": "。えーと、"}]
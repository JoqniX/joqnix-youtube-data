[{"type": "subtitle", "time": 4681.03, "timestamp": "01:18:01", "text": "節約しよう。 じゃあ、この男をやって、"}, {"type": "subtitle", "time": 4683.51, "timestamp": "01:18:03", "text": "滑って、びしょ濡れになるよ"}, {"type": "subtitle", "time": 4697.99, "timestamp": "01:18:17", "text": "皆さん、心配しないでください。 ああ、なんて"}, {"type": "subtitle", "time": 4702.07, "timestamp": "01:18:22", "text": "たくさんのハエがいるんだ。 もう奴らを殺せ。 スパイダー"}, {"type": "subtitle", "time": 4705.51, "timestamp": "01:18:25", "text": "コン。 なぜ何百万匹もの"}, {"type": "subtitle", "time": 4708.95, "timestamp": "01:18:28", "text": "ハエがここに群がっているのだろうか？"}, {"type": "subtitle", "time": 4710.79, "timestamp": "01:18:30", "text": "そして、そのうちのいくつかは私の"}, {"type": "subtitle", "time": 4720.55, "timestamp": "01:18:40", "text": "。 全員ここにいる。 よし。"}, {"type": "subtitle", "time": 4729.75, "timestamp": "01:18:49", "text": "。  ３、２、ちゃんと"}, {"type": "subtitle", "time": 4732.31, "timestamp": "01:18:52", "text": "持たせてください。 ああ、"}, {"type": "subtitle", "time": 4734.07, "timestamp": "01:18:54", "text": "スマホとモバイルバッテリーを同時に持たなきゃいけないなんて"}, {"type": "subtitle", "time": 4738.87, "timestamp": "01:18:58", "text": "。 わかった。  ３、２、１、"}]
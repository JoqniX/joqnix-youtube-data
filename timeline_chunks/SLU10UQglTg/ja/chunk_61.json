[{"type": "subtitle", "time": 3660.87, "timestamp": "01:01:00", "text": "。"}, {"type": "subtitle", "time": 3664.23, "timestamp": "01:01:04", "text": "野球チームがある。"}, {"type": "subtitle", "time": 3667.03, "timestamp": "01:01:07", "text": "これはロックされていますか？ ああ、鍵がかかっている。 わかった。"}, {"type": "subtitle", "time": 3668.789, "timestamp": "01:01:08", "text": "ロックシステムを見てください。 それは"}, {"type": "subtitle", "time": 3680.15, "timestamp": "01:01:20", "text": "何ですか？ それは時間の問題だ。"}, {"type": "subtitle", "time": 3682.87, "timestamp": "01:01:22", "text": "これはロックされていますか？"}, {"type": "subtitle", "time": 3692.549, "timestamp": "01:01:32", "text": "これはロックされているはずですよね？   わかった"}, {"type": "subtitle", "time": 3695.349, "timestamp": "01:01:35", "text": "。 わからない。 あれは"}, {"type": "subtitle", "time": 3703.67, "timestamp": "01:01:43", "text": "、まるで"}, {"type": "subtitle", "time": 3706.47, "timestamp": "01:01:46", "text": "森の中を旅しているみたいだ。"}, {"type": "subtitle", "time": 3709.19, "timestamp": "01:01:49", "text": "ああ、コオロギや"}, {"type": "subtitle", "time": 3712.23, "timestamp": "01:01:52", "text": "カブトムシの鳴き声が聞こえるよ。 聞こえますか？"}, {"type": "subtitle", "time": 3715.51, "timestamp": "01:01:55", "text": "こちらは夏です。 そう、ここは"}]
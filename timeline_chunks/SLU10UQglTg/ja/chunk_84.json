[{"type": "subtitle", "time": 5041.59, "timestamp": "01:24:01", "text": "最後になるだろう。  7時になります。 私は自分の"}, {"type": "subtitle", "time": 5045.189, "timestamp": "01:24:05", "text": "部屋に戻らなければならない。"}, {"type": "subtitle", "time": 5067.27, "timestamp": "01:24:27", "text": "ああ、"}, {"type": "subtitle", "time": 5073.91, "timestamp": "01:24:33", "text": "これをする前に一つ言っておきたいのですが、"}, {"type": "subtitle", "time": 5076.95, "timestamp": "01:24:36", "text": "私がTik Tok対"}, {"type": "subtitle", "time": 5079.03, "timestamp": "01:24:39", "text": "Tik TokとかYouTubeの変な人たちが視聴者のために"}, {"type": "subtitle", "time": 5081.11, "timestamp": "01:24:41", "text": "変なことをしているのを"}, {"type": "subtitle", "time": 5083.75, "timestamp": "01:24:43", "text": "毎回見ていると思わないでくれますか？確かに"}, {"type": "subtitle", "time": 5088.743, "timestamp": "01:24:48", "text": "番組はそういう雰囲気を出している"}, {"type": "subtitle", "time": 5091.43, "timestamp": "01:24:51", "text": "けど（笑）、そうじゃないんです。"}, {"type": "subtitle", "time": 5094.39, "timestamp": "01:24:54", "text": "明日はデビューだから、今日はとにかく楽しみたい。"}, {"type": "subtitle", "time": 5098.79, "timestamp": "01:24:58", "text": "最近すごくストレスが溜まってるんだ。"}]
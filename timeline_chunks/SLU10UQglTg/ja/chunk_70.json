[{"type": "subtitle", "time": 4217.99, "timestamp": "01:10:17", "text": "バスケットボールがあればよかったのに。 そうやって引っ掛ければいいんです"}, {"type": "subtitle", "time": 4228.229, "timestamp": "01:10:28", "text": "ドラゴン"}, {"type": "subtitle", "time": 4230.55, "timestamp": "01:10:30", "text": "オーシャンと忍者がいるから、またそこに戻るんだ。 だから、またあの"}, {"type": "subtitle", "time": 4232.79, "timestamp": "01:10:32", "text": "クレイジーなことをして、びしょ濡れになってくるよ"}, {"type": "subtitle", "time": 4234.39, "timestamp": "01:10:34", "text": "。"}, {"type": "subtitle", "time": 4238.39, "timestamp": "01:10:38", "text": "ああ、これが最後だ。   もう"}, {"type": "subtitle", "time": 4242.149, "timestamp": "01:10:42", "text": "数えきれないくらいだけどね。"}, {"type": "subtitle", "time": 4246.07, "timestamp": "01:10:46", "text": "もう数えきれない。"}, {"type": "subtitle", "time": 4254.87, "timestamp": "01:10:54", "text": "サインを見せてくれ。 わかった。"}, {"type": "subtitle", "time": 4256.95, "timestamp": "01:10:56", "text": "持続する。"}]
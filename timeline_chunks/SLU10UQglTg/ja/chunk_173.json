[{"type": "subtitle", "time": 10383.83, "timestamp": "02:53:03", "text": "使って、"}, {"type": "subtitle", "time": 10387.75, "timestamp": "02:53:07", "text": "いつかあのショーに行くんだ。今日じゃない。いつか。"}, {"type": "subtitle", "time": 10390.389, "timestamp": "02:53:10", "text": "どうやってやるか分からない。"}, {"type": "subtitle", "time": 10392.63, "timestamp": "02:53:12", "text": "たぶんルームメイトに頼むと思うけど、"}, {"type": "subtitle", "time": 10394.15, "timestamp": "02:53:14", "text": "彼が言わないようにしないと。 私の"}, {"type": "subtitle", "time": 10398.469, "timestamp": "02:53:18", "text": "名前。ここに見えるもの、"}, {"type": "subtitle", "time": 10403.429, "timestamp": "02:53:23", "text": "川の音。あれは"}, {"type": "subtitle", "time": 10406.309, "timestamp": "02:53:26", "text": "川だと思う。川じゃない。これは"}, {"type": "subtitle", "time": 10408.63, "timestamp": "02:53:28", "text": "滝みたいなもの。わからない。"}, {"type": "subtitle", "time": 10412.71, "timestamp": "02:53:32", "text": "カバー。川の湖みたいなもの。すごく"}, {"type": "subtitle", "time": 10414.71, "timestamp": "02:53:34", "text": "長い。"}, {"type": "subtitle", "time": 10418.15, "timestamp": "02:53:38", "text": "うん。これ。それで、どうやら"}, {"type": "subtitle", "time": 10420.15, "timestamp": "02:53:40", "text": "泳げる場所があるらしい。"}, {"type": "subtitle", "time": 10422.55, "timestamp": "02:53:42", "text": "橋の下にあるから、誰も"}, {"type": "subtitle", "time": 10424.469, "timestamp": "02:53:44", "text": "見ない。"}, {"type": "subtitle", "time": 10428.71, "timestamp": "02:53:48", "text": "安全。安全。うん、"}, {"type": "chat", "time": 10431.317, "timestamp": "02:53:51", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "visit a pool nearby to learn swimming"}, {"type": "subtitle", "time": 10432.15, "timestamp": "02:53:52", "text": "安全。安全。泳げる。"}, {"type": "subtitle", "time": 10434.07, "timestamp": "02:53:54", "text": "誰もやらないと思うけど、違法だから。"}, {"type": "subtitle", "time": 10436.469, "timestamp": "02:53:56", "text": "捕まる。捕まる。でも、やりたかった。"}]
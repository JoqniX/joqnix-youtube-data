[{"type": "subtitle", "time": 5881.51, "timestamp": "01:38:01", "text": "30回以上は食事をしたと思う。"}, {"type": "subtitle", "time": 5883.35, "timestamp": "01:38:03", "text": "それで、"}, {"type": "subtitle", "time": 5886.31, "timestamp": "01:38:06", "text": "最初は味噌汁が嫌いだったのですが、日本人がやってきて"}, {"type": "subtitle", "time": 5890.07, "timestamp": "01:38:10", "text": "。 とても嬉しかった。   私は"}, {"type": "subtitle", "time": 5893.109, "timestamp": "01:38:13", "text": "その味が好きではありませんでした。 しかし初日は"}, {"type": "subtitle", "time": 5896.149, "timestamp": "01:38:16", "text": "ザリガニだった。  2日目はまあまあだった。  3日目はまあ"}, {"type": "subtitle", "time": 5900.229, "timestamp": "01:38:20", "text": "まあだった。 わかった。  4日目、彼のえーと"}, {"type": "subtitle", "time": 5902.31, "timestamp": "01:38:22", "text": "おいしい。"}, {"type": "subtitle", "time": 5905.43, "timestamp": "01:38:25", "text": "私の席を見てみたいですか？"}, {"type": "subtitle", "time": 5909.27, "timestamp": "01:38:29", "text": "私の席をご案内します。 ええと、私はいつも"}, {"type": "subtitle", "time": 5911.51, "timestamp": "01:38:31", "text": "窓際の席を選びます。  3番目です。えっと"}, {"type": "subtitle", "time": 5914.149, "timestamp": "01:38:34", "text": "、1、2、3。 それは2番目か"}, {"type": "subtitle", "time": 5918.229, "timestamp": "01:38:38", "text": "3番目の席ですね。 あのエリアに入れば、"}, {"type": "subtitle", "time": 5923.59, "timestamp": "01:38:43", "text": "車とか色々見ることができるんだ。   ああ"}, {"type": "subtitle", "time": 5931.75, "timestamp": "01:38:51", "text": "、赤だ。 緑色です。"}, {"type": "subtitle", "time": 5933.59, "timestamp": "01:38:53", "text": "渡るべきでしょうか？ 私は渡りたくない。 わかった、"}]
[{"type": "subtitle", "time": 7326.629, "timestamp": "02:02:06", "text": "毎回訪れる近隣エリアをすべて表示するのは問題ないのでしょうか？"}, {"type": "subtitle", "time": 7328.47, "timestamp": "02:02:08", "text": "でも、ここは"}, {"type": "subtitle", "time": 7332.47, "timestamp": "02:02:12", "text": "私のお気に入りの場所の一つです。 私はここに来る。 同じ"}, {"type": "subtitle", "time": 7336.55, "timestamp": "02:02:16", "text": "地域。 あ、待って。 あなたには見えないでしょう。"}, {"type": "subtitle", "time": 7338.39, "timestamp": "02:02:18", "text": "カメラの"}, {"type": "subtitle", "time": 7340.47, "timestamp": "02:02:20", "text": "フラッシュ。"}, {"type": "subtitle", "time": 7343.03, "timestamp": "02:02:23", "text": "2番目の公園と同じです。   何かが"}, {"type": "subtitle", "time": 7346.47, "timestamp": "02:02:26", "text": "生えてきてるんだよ。"}, {"type": "subtitle", "time": 7355.99, "timestamp": "02:02:35", "text": "ええと、スイングもありますね。"}, {"type": "subtitle", "time": 7359.589, "timestamp": "02:02:39", "text": "いつか必ずそうする。 今日は無理です。"}, {"type": "subtitle", "time": 7361.669, "timestamp": "02:02:41", "text": "うん。   雨が降っていて、じめじめしている"}, {"type": "subtitle", "time": 7364.55, "timestamp": "02:02:44", "text": "。"}, {"type": "subtitle", "time": 7366.95, "timestamp": "02:02:46", "text": "濡れている。   わかった"}]
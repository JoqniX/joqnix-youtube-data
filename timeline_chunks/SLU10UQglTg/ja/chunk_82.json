[{"type": "subtitle", "time": 4922.39, "timestamp": "01:22:02", "text": "コースか何かに参加したら、きっと死ぬと思うよ。 それで、ダイアナ、"}, {"type": "subtitle", "time": 4926.229, "timestamp": "01:22:06", "text": "私は障害物コースをやりたいんです。 ああ、"}, {"type": "subtitle", "time": 4928.95, "timestamp": "01:22:08", "text": "メガネが涙で濡れて何も見えない。"}, {"type": "subtitle", "time": 4932.149, "timestamp": "01:22:12", "text": "よし、これだ。"}, {"type": "subtitle", "time": 4936.149, "timestamp": "01:22:16", "text": "よし、しゃがんで。 ああ、神様、"}, {"type": "subtitle", "time": 4945.669, "timestamp": "01:22:25", "text": "さて、これは"}, {"type": "subtitle", "time": 4948.79, "timestamp": "01:22:28", "text": "誰宛てだったかな？ ドラゴナーと、えーと、ニンジャが来たんだよね"}, {"type": "subtitle", "time": 4952.229, "timestamp": "01:22:32", "text": "？ わかった。"}, {"type": "subtitle", "time": 4963.03, "timestamp": "01:22:43", "text": "ああ、神様。 ああ、神様。 ああ、神様。 ああ、くそ。 わかった。"}, {"type": "subtitle", "time": 4966.95, "timestamp": "01:22:46", "text": "３、２、１。"}]
[{"type": "subtitle", "time": 10621.03, "timestamp": "02:57:01", "text": "使えないと思います。あの"}, {"type": "subtitle", "time": 10623.91, "timestamp": "02:57:03", "text": "教会はもう機能していません。"}, {"type": "subtitle", "time": 10627.59, "timestamp": "02:57:07", "text": "いつも閉まっています。ええ、あのエリアには、左右に"}, {"type": "subtitle", "time": 10635.67, "timestamp": "02:57:15", "text": "ガードレールがあって、"}, {"type": "subtitle", "time": 10640.87, "timestamp": "02:57:20", "text": "狭い道があって、その横には"}, {"type": "subtitle", "time": 10643.75, "timestamp": "02:57:23", "text": "湖のようなカバーのようなものがあります"}, {"type": "subtitle", "time": 10647.91, "timestamp": "02:57:27", "text": "。ええ、あのエリアは広いです。"}, {"type": "subtitle", "time": 10651.91, "timestamp": "02:57:31", "text": "そしてまっすぐ歩いていきます。"}, {"type": "subtitle", "time": 10655.11, "timestamp": "02:57:35", "text": "うん、ところで、すごくいい"}, {"type": "subtitle", "time": 10658.23, "timestamp": "02:57:38", "text": "場所だよ。"}, {"type": "subtitle", "time": 10664.71, "timestamp": "02:57:44", "text": "見えるかな？"}, {"type": "subtitle", "time": 10669.11, "timestamp": "02:57:49", "text": "お城みたいなんだ。お城だよ。"}, {"type": "subtitle", "time": 10671.51, "timestamp": "02:57:51", "text": "うん。わかった"}, {"type": "subtitle", "time": 10674.79, "timestamp": "02:57:54", "text": "。家に帰ろう。"}]
[{"type": "subtitle", "time": 7803.03, "timestamp": "02:10:03", "text": "えっと、自己宣伝はやめてください。 えーと、えーと、何とかかんとか"}, {"type": "subtitle", "time": 7807.27, "timestamp": "02:10:07", "text": "。 えっと、それはやめとかせてください"}, {"type": "subtitle", "time": 7809.99, "timestamp": "02:10:09", "text": "。"}, {"type": "subtitle", "time": 7811.669, "timestamp": "02:10:11", "text": "ああ、"}, {"type": "subtitle", "time": 7813.51, "timestamp": "02:10:13", "text": "私は"}, {"type": "subtitle", "time": 7816.31, "timestamp": "02:10:16", "text": "ガンジが誰なのか知りたくない。知りたくない。"}, {"type": "subtitle", "time": 7818.39, "timestamp": "02:10:18", "text": "えっと、"}, {"type": "subtitle", "time": 7820.629, "timestamp": "02:10:20", "text": "私の配信で宣伝しに来ないでください。"}, {"type": "subtitle", "time": 7823.589, "timestamp": "02:10:23", "text": "これは私の配信です。 これからは私のルールだ。"}, {"type": "subtitle", "time": 7833.109, "timestamp": "02:10:33", "text": "とにかく、今日は"}, {"type": "subtitle", "time": 7837.35, "timestamp": "02:10:37", "text": "とても楽しかったので、もっとこういうことをし"}, {"type": "subtitle", "time": 7841.99, "timestamp": "02:10:41", "text": "たいです。"}, {"type": "subtitle", "time": 7847.03, "timestamp": "02:10:47", "text": "今日と同じようにストリーミングをお楽しみください。"}, {"type": "subtitle", "time": 7853.75, "timestamp": "02:10:53", "text": "そして明日は私にとって新たな始まりです。   だから"}, {"type": "subtitle", "time": 7856.31, "timestamp": "02:10:56", "text": "明日は私にとって新たな始まりとなる"}, {"type": "subtitle", "time": 7859.51, "timestamp": "02:10:59", "text": "。 新しいモデル…いや、何も"}]
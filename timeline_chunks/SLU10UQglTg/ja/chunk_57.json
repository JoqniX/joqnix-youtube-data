[{"type": "subtitle", "time": 3420.47, "timestamp": "00:57:00", "text": "[咳払い]"}, {"type": "subtitle", "time": 3438.71, "timestamp": "00:57:18", "text": "今日は金曜日だから。 いいえ、だって明日"}, {"type": "subtitle", "time": 3440.23, "timestamp": "00:57:20", "text": "デビューするんですもの。"}, {"type": "subtitle", "time": 3443.27, "timestamp": "00:57:23", "text": "今日は、僕がスポーツマンとしての自分らしくいられる最後の日だ"}, {"type": "subtitle", "time": 3451.51, "timestamp": "00:57:31", "text": "思う。 いや、これは"}, {"type": "subtitle", "time": 3457.67, "timestamp": "00:57:37", "text": "新時代の幕開けだ。 こんにちは。 さあ行こう。  ３、２"}, {"type": "subtitle", "time": 3459.51, "timestamp": "00:57:39", "text": "。"}, {"type": "subtitle", "time": 3462.069, "timestamp": "00:57:42", "text": "あぁ、待って、待って、待って、待って、待って、待って。"}, {"type": "subtitle", "time": 3467.43, "timestamp": "00:57:47", "text": "M電話、電話。 モバイルバッテリー。 わかった。"}, {"type": "subtitle", "time": 3470.789, "timestamp": "00:57:50", "text": "３、２。   わかった"}, {"type": "subtitle", "time": 3475.51, "timestamp": "00:57:55", "text": "。  ３、２、１、ゴー。 くそ。 くそっ。"}, {"type": "subtitle", "time": 3479.27, "timestamp": "00:57:59", "text": "くそっ。 くそっ。 ああ、高すぎる。 高すぎる。"}]
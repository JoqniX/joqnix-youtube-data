[{"type": "subtitle", "time": 9846.71, "timestamp": "02:44:06", "text": "子供の追跡にはハイすぎる。なあ"}, {"type": "subtitle", "time": 9849.59, "timestamp": "02:44:09", "text": "、人生で一度はこれを雨の"}, {"type": "subtitle", "time": 9852.07, "timestamp": "02:44:12", "text": "中、手にスマホを持ってやってみるべきだよ"}, {"type": "subtitle", "time": 9855.59, "timestamp": "02:44:15", "text": "。土砂降りの雨の中で。"}, {"type": "subtitle", "time": 9861.59, "timestamp": "02:44:21", "text": "よし、今度は"}, {"type": "subtitle", "time": 9871.67, "timestamp": "02:44:31", "text": "フラッシュがあると変だと思う。"}, {"type": "subtitle", "time": 9873.99, "timestamp": "02:44:33", "text": "なんでぼやけてるの？あ、フォーカス、フォーカス、"}, {"type": "subtitle", "time": 9876.63, "timestamp": "02:44:36", "text": "フォーカス、フォーカス。"}, {"type": "subtitle", "time": 9888.71, "timestamp": "02:44:48", "text": "。よし。"}, {"type": "subtitle", "time": 9899.59, "timestamp": "02:44:59", "text": "こんにちは。３、２、３、２、１"}]
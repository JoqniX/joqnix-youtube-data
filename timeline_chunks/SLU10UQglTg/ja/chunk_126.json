[{"type": "subtitle", "time": 7563.189, "timestamp": "02:06:03", "text": "尻をびしょ濡れにした。 あの"}, {"type": "subtitle", "time": 7567.27, "timestamp": "02:06:07", "text": "場所。 ああ、夜になったら"}, {"type": "subtitle", "time": 7570.79, "timestamp": "02:06:10", "text": "そこへ行って、地面で寝るんだ。 あ、待って。   もし"}, {"type": "subtitle", "time": 7574.149, "timestamp": "02:06:14", "text": "バッタがやってきたらどうなる？ ああ"}, {"type": "subtitle", "time": 7577.35, "timestamp": "02:06:17", "text": "、夏だね。 いつかそうなるかもしれないね。 ある"}, {"type": "subtitle", "time": 7582.07, "timestamp": "02:06:22", "text": "日。 だから、いつかまた戻ってきます。"}, {"type": "subtitle", "time": 7585.91, "timestamp": "02:06:25", "text": "君たちと一緒に星空を眺めたい。いつか必ずそうするつもりだ"}, {"type": "subtitle", "time": 7589.189, "timestamp": "02:06:29", "text": "。"}, {"type": "subtitle", "time": 7593.109, "timestamp": "02:06:33", "text": "もちろん。 星空観察は楽しいけどね。"}, {"type": "subtitle", "time": 7594.802, "timestamp": "02:06:34", "text": "私たちは点と点をつなぎ合わせることができる。"}, {"type": "subtitle", "time": 7595.99, "timestamp": "02:06:35", "text": "[笑い]"}, {"type": "subtitle", "time": 7598.39, "timestamp": "02:06:38", "text": "星同士をつなげたりできるんだよ"}, {"type": "subtitle", "time": 7601.109, "timestamp": "02:06:41", "text": "。 とても素敵です。"}, {"type": "subtitle", "time": 7603.43, "timestamp": "02:06:43", "text": "君たちは"}, {"type": "subtitle", "time": 7606.87, "timestamp": "02:06:46", "text": "地上エリアに行くべきだ。 つまり、埃っぽすぎるなら行かない方がいいってこと"}, {"type": "subtitle", "time": 7608.87, "timestamp": "02:06:48", "text": "。 でも、地面が"}, {"type": "subtitle", "time": 7611.83, "timestamp": "02:06:51", "text": "こんな感じなら、えーと、こんな感じじゃなくて、えーと、濡れて"}, {"type": "subtitle", "time": 7615.35, "timestamp": "02:06:55", "text": "なくて、安定していて"}, {"type": "subtitle", "time": 7619.43, "timestamp": "02:06:59", "text": "、えーと、そういう感じなら。 うん、横になるか"}]
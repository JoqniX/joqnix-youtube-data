[{"type": "subtitle", "time": 7500.149, "timestamp": "02:05:00", "text": "暑かった。 一昨日、私はゆで卵になりかけていた"}, {"type": "subtitle", "time": 7502.79, "timestamp": "02:05:02", "text": "。"}, {"type": "subtitle", "time": 7513.91, "timestamp": "02:05:13", "text": "とても暑い。 インドよりもずっと暑い。"}, {"type": "subtitle", "time": 7515.83, "timestamp": "02:05:15", "text": "インドの夏なんて、"}, {"type": "subtitle", "time": 7518.87, "timestamp": "02:05:18", "text": "日本のどこかの夏の暑さに比べたら何でもない。"}, {"type": "subtitle", "time": 7521.27, "timestamp": "02:05:21", "text": "うん。"}, {"type": "subtitle", "time": 7525.27, "timestamp": "02:05:25", "text": "こんにちは。 チャットの内容は把握できたと思います。"}, {"type": "subtitle", "time": 7528.07, "timestamp": "02:05:28", "text": "こんにちは。 とにかく、そろそろ"}, {"type": "subtitle", "time": 7531.99, "timestamp": "02:05:31", "text": "締めくくりたいと思います。 えっと、待って。 星は見えますか？"}, {"type": "chat", "time": 7539.565, "timestamp": "02:05:39", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "otsu"}, {"type": "chat", "time": 7545.42, "timestamp": "02:05:45", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ5L1KpS3_9EP-duW6Qo"}, {"type": "subtitle", "time": 7550.39, "timestamp": "02:05:50", "text": "。 いつか午前"}, {"type": "subtitle", "time": 7552.629, "timestamp": "02:05:52", "text": "0時に配信するつもりだ。よし。"}, {"type": "subtitle", "time": 7555.109, "timestamp": "02:05:55", "text": "いつか、"}, {"type": "subtitle", "time": 7557.35, "timestamp": "02:05:57", "text": "星が見える日が来たら。 また公園に来ています。 公園。   雨が降る"}, {"type": "subtitle", "time": 7559.83, "timestamp": "02:05:59", "text": "中、私たちは草の上に座り、お"}]
[{"type": "subtitle", "time": 4442.47, "timestamp": "01:14:02", "text": "。 最後に一つだけ。 そして私はその作業に取り掛かる"}, {"type": "subtitle", "time": 4444.709, "timestamp": "01:14:04", "text": "。"}, {"type": "subtitle", "time": 4448.229, "timestamp": "01:14:08", "text": "えっと、脇道に逸れてしまいました。"}, {"type": "subtitle", "time": 4456.31, "timestamp": "01:14:16", "text": "誰かが私の名前を呼んだのだから、私は喜ぶべきだった。 あと、"}, {"type": "subtitle", "time": 4470.31, "timestamp": "01:14:30", "text": "３、２、１。 はい。 二。 よし、"}, {"type": "subtitle", "time": 4473.27, "timestamp": "01:14:33", "text": "5時まで続けよう。それでは終了だ。   わかった"}, {"type": "chat", "time": 4485.109, "timestamp": "01:14:45", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ8LuIYCO_9EPt-GMgAw"}, {"type": "subtitle", "time": 4489.669, "timestamp": "01:14:49", "text": "もう一度。   痛い。"}, {"type": "subtitle", "time": 4497.83, "timestamp": "01:14:57", "text": "最後です。   なんてこった"}]
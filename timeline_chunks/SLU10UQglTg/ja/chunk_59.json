[{"type": "subtitle", "time": 3562.789, "timestamp": "00:59:22", "text": "誰かが私を見たら、"}, {"type": "subtitle", "time": 3565.03, "timestamp": "00:59:25", "text": "「うわあ、なんで"}, {"type": "subtitle", "time": 3573.109, "timestamp": "00:59:33", "text": "。 こんにちは。 家に帰りましょう。"}, {"type": "subtitle", "time": 3576.23, "timestamp": "00:59:36", "text": "厳密には自宅ではない。"}, {"type": "subtitle", "time": 3582.95, "timestamp": "00:59:42", "text": "びしょ濡れのまま行ける、他に何か公園はありますか？ 私はそれを証明できると思います"}, {"type": "subtitle", "time": 3586.15, "timestamp": "00:59:46", "text": "。 私の足は濡れている。 ああ、なんてことだ、"}, {"type": "subtitle", "time": 3589.349, "timestamp": "00:59:49", "text": "私の体全体が濡れている。 ああ、"}, {"type": "subtitle", "time": 3591.67, "timestamp": "00:59:51", "text": "それは石ですか？"}, {"type": "subtitle", "time": 3594.23, "timestamp": "00:59:54", "text": "ああ、滑りやすい。 もう"}, {"type": "subtitle", "time": 3596.15, "timestamp": "00:59:56", "text": "十分だ。   走ろう"}, {"type": "subtitle", "time": 3599.99, "timestamp": "00:59:59", "text": "。 わかった。 くそ。"}]
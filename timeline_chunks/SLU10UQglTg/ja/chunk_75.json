[{"type": "subtitle", "time": 4514.229, "timestamp": "01:15:14", "text": "片手で作業していたので、手が痛いです"}, {"type": "subtitle", "time": 4518.709, "timestamp": "01:15:18", "text": "。 ああ、そうだね。 やったよ。"}, {"type": "subtitle", "time": 4523.59, "timestamp": "01:15:23", "text": "ニース。 よし、ボールを持って戻ろう"}, {"type": "subtitle", "time": 4526.39, "timestamp": "01:15:26", "text": "。"}, {"type": "subtitle", "time": 4528.07, "timestamp": "01:15:28", "text": "えっと、"}, {"type": "subtitle", "time": 4531.43, "timestamp": "01:15:31", "text": "NinjaとJagnoserが"}, {"type": "subtitle", "time": 4532.87, "timestamp": "01:15:32", "text": "ここにいるかどうかは分かりません。"}, {"type": "subtitle", "time": 4536.63, "timestamp": "01:15:36", "text": "チャットに参加しているなら、何か合図を送ってください。"}, {"type": "subtitle", "time": 4538.31, "timestamp": "01:15:38", "text": "これは君に捧げるよ、"}, {"type": "subtitle", "time": 4539.99, "timestamp": "01:15:39", "text": "いいかい？"}, {"type": "subtitle", "time": 4541.43, "timestamp": "01:15:41", "text": "あなたがここにいる限り、私は来てくれた"}, {"type": "subtitle", "time": 4544.79, "timestamp": "01:15:44", "text": "視聴者全員のためにそれをやってきました。 もしあなたが"}, {"type": "subtitle", "time": 4549.03, "timestamp": "01:15:49", "text": "ここにいるなら、ぜひ教えてください。 何かサインを見せてくれ。"}, {"type": "subtitle", "time": 4554.47, "timestamp": "01:15:54", "text": "そして、ちょっと変わったことをしようと思っています。"}]
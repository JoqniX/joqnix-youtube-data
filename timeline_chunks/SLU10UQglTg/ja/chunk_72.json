[{"type": "subtitle", "time": 4320.79, "timestamp": "01:12:00", "text": "。 よし、ボールを見つけたぞ。"}, {"type": "subtitle", "time": 4322.55, "timestamp": "01:12:02", "text": "バスケットボールをしよう。"}, {"type": "subtitle", "time": 4346.95, "timestamp": "01:12:26", "text": "誰かが来る前に、まずは"}, {"type": "subtitle", "time": 4353.27, "timestamp": "01:12:33", "text": "全体を撮影しようと思います。"}, {"type": "subtitle", "time": 4355.91, "timestamp": "01:12:35", "text": "ああ、手ブレ映像が出るまで待ってて。"}, {"type": "subtitle", "time": 4358.63, "timestamp": "01:12:38", "text": "ところで、もう少しお金に余裕ができたら、いつかジンバル"}, {"type": "subtitle", "time": 4361.51, "timestamp": "01:12:41", "text": "か何かを買おうと思ってるんだ"}, {"type": "subtitle", "time": 4365.03, "timestamp": "01:12:45", "text": "。"}, {"type": "subtitle", "time": 4366.55, "timestamp": "01:12:46", "text": "うん。   わかった"}, {"type": "subtitle", "time": 4369.51, "timestamp": "01:12:49", "text": "。 ここにあります。 私たちはそれをやり遂げるつもりだ。   何てことだ"}, {"type": "subtitle", "time": 4371.35, "timestamp": "01:12:51", "text": "。"}, {"type": "subtitle", "time": 4375.83, "timestamp": "01:12:55", "text": "今日は本当にたくさんの活動があります。 だから、私たちはこんなにたくさんの"}]
[{"type": "subtitle", "time": 9902.15, "timestamp": "02:45:02", "text": "。やべぇ。やべぇ。やべぇ"}, {"type": "subtitle", "time": 9904.309, "timestamp": "02:45:04", "text": "。僕の手。僕の"}, {"type": "subtitle", "time": 9907.349, "timestamp": "02:45:07", "text": "手。僕の手。"}, {"type": "subtitle", "time": 9915.11, "timestamp": "02:45:15", "text": "ああ、神様、私の手。ああ、くそ。ああ、"}, {"type": "subtitle", "time": 9921.349, "timestamp": "02:45:21", "text": "神様。ああ、くそ。ああ、"}, {"type": "subtitle", "time": 9925.03, "timestamp": "02:45:25", "text": "神様、私の手。ああ、くそ"}, {"type": "subtitle", "time": 9927.75, "timestamp": "02:45:27", "text": "。ああ、"}, {"type": "subtitle", "time": 9931.99, "timestamp": "02:45:31", "text": "神様。あなたのお尻。ああ、あなたのお尻。痛い"}, {"type": "subtitle", "time": 9934.55, "timestamp": "02:45:34", "text": "。痛い。"}, {"type": "subtitle", "time": 9936.87, "timestamp": "02:45:36", "text": "前にやった時は6回も痛くなかったのに、なぜ"}, {"type": "subtitle", "time": 9949.429, "timestamp": "02:45:49", "text": "ああ、集中。よし、次はスライドだ。"}, {"type": "subtitle", "time": 9952.469, "timestamp": "02:45:52", "text": "いいスライドだ。あそこに大きな水たまりがある"}, {"type": "subtitle", "time": 9957.269, "timestamp": "02:45:57", "text": "。よし​​、やるぞ。しゃがむ。"}, {"type": "chat", "time": 9957.557, "timestamp": "02:45:57", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "did you hurt yourself?"}]
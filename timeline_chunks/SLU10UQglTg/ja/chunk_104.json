[{"type": "subtitle", "time": 6241.03, "timestamp": "01:44:01", "text": "私はあそこ、あの"}, {"type": "subtitle", "time": 6243.189, "timestamp": "01:44:03", "text": "角にいました。 そこに周期性が見られますか"}, {"type": "subtitle", "time": 6244.47, "timestamp": "01:44:04", "text": "？ あなたには見えるかどうか分かりません。   この"}, {"type": "subtitle", "time": 6248.07, "timestamp": "01:44:08", "text": "番組は不安定だ。"}, {"type": "subtitle", "time": 6250.07, "timestamp": "01:44:10", "text": "えっと、ちょっと"}, {"type": "subtitle", "time": 6253.75, "timestamp": "01:44:13", "text": "待って、UFOをお見せできますよ。  UFOが私です。"}, {"type": "subtitle", "time": 6257.27, "timestamp": "01:44:17", "text": "UFOをお見せしましょう。 実際のUFO。 待って、"}, {"type": "subtitle", "time": 6261.75, "timestamp": "01:44:21", "text": "このエリアにはどうやって入るの？ えっと、"}, {"type": "subtitle", "time": 6263.91, "timestamp": "01:44:23", "text": "UFO。"}, {"type": "subtitle", "time": 6265.59, "timestamp": "01:44:25", "text": "ホン"}, {"type": "subtitle", "time": 6269.75, "timestamp": "01:44:29", "text": "UFO。 待って、でもどうやって入るの？"}, {"type": "subtitle", "time": 6281.109, "timestamp": "01:44:41", "text": "ここから入ると何ですか。 私はここにいるべきなの"}, {"type": "subtitle", "time": 6282.709, "timestamp": "01:44:42", "text": "？ ここは"}, {"type": "chat", "time": 6282.877, "timestamp": "01:44:42", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "UFO!?"}, {"type": "subtitle", "time": 6286.229, "timestamp": "01:44:46", "text": "立ち入り禁止区域ですか？ 見て。 えっと、待って。"}, {"type": "subtitle", "time": 6288.229, "timestamp": "01:44:48", "text": "カメラがある。"}, {"type": "chat", "time": 6295.108, "timestamp": "01:44:55", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "lmao"}]
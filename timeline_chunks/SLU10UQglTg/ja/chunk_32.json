[{"type": "subtitle", "time": 1921.509, "timestamp": "00:32:01", "text": "待って。アディちゃんが水を取った。"}, {"type": "subtitle", "time": 1924.789, "timestamp": "00:32:04", "text": "お願い、できるなら。"}, {"type": "subtitle", "time": 1935.75, "timestamp": "00:32:15", "text": "、最後。今回は、今回は生で行く。"}, {"type": "subtitle", "time": 1941.269, "timestamp": "00:32:21", "text": "待って、カサちゃん。"}, {"type": "subtitle", "time": 1945.99, "timestamp": "00:32:25", "text": "今回はカサちゃんが地面にいる。濡れたまま、やる。"}, {"type": "subtitle", "time": 1949.59, "timestamp": "00:32:29", "text": "わかった、1番。3、2"}, {"type": "subtitle", "time": 1953.669, "timestamp": "00:32:33", "text": "。ああ、神様、これは"}, {"type": "subtitle", "time": 1957.11, "timestamp": "00:32:37", "text": "難しい。これは難しい。3、2、1"}, {"type": "subtitle", "time": 1961.082, "timestamp": "00:32:41", "text": "。"}, {"type": "subtitle", "time": 1962.63, "timestamp": "00:32:42", "text": "[叫び声] ああ、神様。やった。やった。やった。ああ、くそ。ああ、くそ。ああ、"}, {"type": "subtitle", "time": 1969.99, "timestamp": "00:32:49", "text": "くそ。ああ、私の手。私の手。ああ、くそ。ああ、くそ。ああ、くそ。"}, {"type": "subtitle", "time": 1974.47, "timestamp": "00:32:54", "text": "私の"}, {"type": "subtitle", "time": 1979.75, "timestamp": "00:32:59", "text": "手。ああ、くそ。ええ。私の[ため息]"}]
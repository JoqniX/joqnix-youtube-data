[{"type": "subtitle", "time": 9360.95, "timestamp": "02:36:00", "text": "確信している。"}, {"type": "subtitle", "time": 9364.71, "timestamp": "02:36:04", "text": "それとも右だったかな？いやいやいやいや。"}, {"type": "subtitle", "time": 9405.349, "timestamp": "02:36:45", "text": "あ、待って。えっと、暗いから、"}, {"type": "subtitle", "time": 9411.19, "timestamp": "02:36:51", "text": "もう一度あの乗り物に乗るときにフラッシュをオンにした方がいいかな？"}, {"type": "subtitle", "time": 9415.75, "timestamp": "02:36:55", "text": "人が来る気がする。"}, {"type": "subtitle", "time": 9418.07, "timestamp": "02:36:58", "text": "音を立てれば立てるほど"}, {"type": "subtitle", "time": 9419.67, "timestamp": "02:36:59", "text": "通報される。それはまずい。"}]
[{"type": "subtitle", "time": 5409.03, "timestamp": "01:30:09", "text": "「私は通り過ぎた。彼も一度通り過ぎた。あなたは"}, {"type": "subtitle", "time": 5411.99, "timestamp": "01:30:11", "text": "また通り過ぎるのよ。」 あ、待って。 ここは"}, {"type": "subtitle", "time": 5419.35, "timestamp": "01:30:19", "text": "あ、待って。 これは正しい。 あ、待って。"}, {"type": "subtitle", "time": 5423.59, "timestamp": "01:30:23", "text": "あなたは去った。 そこで待っています。"}, {"type": "subtitle", "time": 5449.27, "timestamp": "01:30:49", "text": "？   えっと、"}, {"type": "subtitle", "time": 5457.35, "timestamp": "01:30:57", "text": "ここから一番近い公園はどこですか？ 近道を使えそうだ。"}]
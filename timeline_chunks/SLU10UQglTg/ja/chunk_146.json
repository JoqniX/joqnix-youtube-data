[{"type": "subtitle", "time": 8760.55, "timestamp": "02:26:00", "text": "思う。いや、5回か4回かな。うん。"}, {"type": "subtitle", "time": 8762.309, "timestamp": "02:26:02", "text": "それから"}, {"type": "subtitle", "time": 8766.389, "timestamp": "02:26:06", "text": "大きな水しぶきのところを通った。"}, {"type": "subtitle", "time": 8770.23, "timestamp": "02:26:10", "text": "それから、他に何があったかな？"}, {"type": "subtitle", "time": 8772.23, "timestamp": "02:26:12", "text": "野球ボールを見つけて、それを"}, {"type": "subtitle", "time": 8775.91, "timestamp": "02:26:15", "text": "バスケットボールのフックにかけたんだ。"}, {"type": "subtitle", "time": 8780.63, "timestamp": "02:26:20", "text": "バスケットボールのフックみたいなやつがあって、それを投げたんだ。10回くらいやったと"}, {"type": "subtitle", "time": 8784.23, "timestamp": "02:26:24", "text": "思う"}, {"type": "subtitle", "time": 8787.27, "timestamp": "02:26:27", "text": "。近いのは良かったけど、遠いのは"}, {"type": "subtitle", "time": 8789.67, "timestamp": "02:26:29", "text": "片手でできなかった。"}, {"type": "subtitle", "time": 8792.15, "timestamp": "02:26:32", "text": "今は電話を持たなきゃいけないから。"}, {"type": "subtitle", "time": 8800.63, "timestamp": "02:26:40", "text": "うん。それからセブンイレブンのエリアに行って、"}, {"type": "subtitle", "time": 8806.63, "timestamp": "02:26:46", "text": "公園を見つけたんだ。午前11時か午後11時頃に、"}, {"type": "subtitle", "time": 8809.429, "timestamp": "02:26:49", "text": "君が来てたくさん"}, {"type": "subtitle", "time": 8811.83, "timestamp": "02:26:51", "text": "質問してた時のストリームを覚えてる？僕が夕食か何かを食べていた時のこと。うん"}, {"type": "subtitle", "time": 8816.23, "timestamp": "02:26:56", "text": "、あの公園だよ。そこに行ったんだ。"}]
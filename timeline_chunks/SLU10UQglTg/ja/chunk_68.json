[{"type": "subtitle", "time": 4081.589, "timestamp": "01:08:01", "text": "ああ、ここは強いな。"}, {"type": "subtitle", "time": 4083.829, "timestamp": "01:08:03", "text": "私はこのエリアの中に入りたいんです。"}, {"type": "subtitle", "time": 4086.95, "timestamp": "01:08:06", "text": "いつも鍵がかかっている。 なぜこんな素敵な"}, {"type": "subtitle", "time": 4090.069, "timestamp": "01:08:10", "text": "小さな場所が閉まっているの？ なぜ"}, {"type": "subtitle", "time": 4092.87, "timestamp": "01:08:12", "text": "日本人だけが犬を連れてここに来られるのですか"}, {"type": "subtitle", "time": 4094.47, "timestamp": "01:08:14", "text": "？"}, {"type": "subtitle", "time": 4107.829, "timestamp": "01:08:27", "text": "探検してみようと思います。"}, {"type": "subtitle", "time": 4110.789, "timestamp": "01:08:30", "text": "あそこのダムに行きたいんだけど、そこは"}, {"type": "subtitle", "time": 4113.43, "timestamp": "01:08:33", "text": "文字通り森なんだ。 行ってみることはできる"}, {"type": "subtitle", "time": 4122.709, "timestamp": "01:08:42", "text": "あの場所に入るにはどうすればいいですか"}, {"type": "subtitle", "time": 4132.95, "timestamp": "01:08:52", "text": "これを開けてもいいですか？ ああ、これは開けない。"}]
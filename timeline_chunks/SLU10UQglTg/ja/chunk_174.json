[{"type": "subtitle", "time": 10442.15, "timestamp": "02:54:02", "text": "そのためにストリームをやろう。[笑い]"}, {"type": "subtitle", "time": 10446.389, "timestamp": "02:54:06", "text": "わかってるよ。水中の"}, {"type": "subtitle", "time": 10450.309, "timestamp": "02:54:10", "text": "映像を見せるよ。うん。ああ、なんてことだ。待って、私にもできる"}, {"type": "subtitle", "time": 10454.63, "timestamp": "02:54:14", "text": "。待って、やらなきゃ。ああ、"}, {"type": "subtitle", "time": 10460.87, "timestamp": "02:54:20", "text": "泳ぐって言ったとき、"}, {"type": "subtitle", "time": 10465.03, "timestamp": "02:54:25", "text": "私はすぐに「ああ、待って」って思った。"}, {"type": "subtitle", "time": 10468.07, "timestamp": "02:54:28", "text": "プールに行ってもいいですよ。"}, {"type": "subtitle", "time": 10469.59, "timestamp": "02:54:29", "text": "「実はプールがあるんだよ。」"}, {"type": "subtitle", "time": 10472.79, "timestamp": "02:54:32", "text": "えっと、ああ、なんてことだ。ああ、今日は雨の日だ。ああ"}, {"type": "subtitle", "time": 10479.11, "timestamp": "02:54:39", "text": "えっと、プールに行くか、屋根のある場所に行くか"}, {"type": "subtitle", "time": 10481.349, "timestamp": "02:54:41", "text": "。"}, {"type": "subtitle", "time": 10483.99, "timestamp": "02:54:43", "text": "この大きな屋根。"}, {"type": "subtitle", "time": 10487.51, "timestamp": "02:54:47", "text": "そのアイデアありがとう。"}, {"type": "subtitle", "time": 10491.11, "timestamp": "02:54:51", "text": "近くのプールに行って泳ぐ。うん。"}, {"type": "subtitle", "time": 10493.269, "timestamp": "02:54:53", "text": "もちろん。ダイアナ。"}, {"type": "subtitle", "time": 10497.75, "timestamp": "02:54:57", "text": "ところで、チャットがまたフリーズしてる。"}]
[{"type": "subtitle", "time": 9660.71, "timestamp": "02:41:00", "text": "4月にも金曜日に暇だったので、スターゲイズに来たんだ"}, {"type": "subtitle", "time": 9665.67, "timestamp": "02:41:05", "text": "。バッテリー。うん、"}, {"type": "subtitle", "time": 9667.91, "timestamp": "02:41:07", "text": "いい気分だった。"}, {"type": "subtitle", "time": 9672.07, "timestamp": "02:41:12", "text": "よし、何も触らないようにUIをドッキングしよう"}, {"type": "subtitle", "time": 9677.429, "timestamp": "02:41:17", "text": "。よし、行こう。着いた。"}, {"type": "subtitle", "time": 9680.87, "timestamp": "02:41:20", "text": "誰もいないといいな。いつものように、"}, {"type": "subtitle", "time": 9683.51, "timestamp": "02:41:23", "text": "傘を木の近くに置いて、やろう"}, {"type": "subtitle", "time": 9686.95, "timestamp": "02:41:26", "text": "。あの人、"}, {"type": "subtitle", "time": 9689.429, "timestamp": "02:41:29", "text": "あの人が"}, {"type": "subtitle", "time": 9694.79, "timestamp": "02:41:34", "text": "犬と一緒にあそこにいる。ここには人が検知されず、"}, {"type": "subtitle", "time": 9698.15, "timestamp": "02:41:38", "text": "誰も座っていない。よし、"}, {"type": "subtitle", "time": 9701.27, "timestamp": "02:41:41", "text": "できると思う。あ、待って。すごく暗い。何だ"}, {"type": "subtitle", "time": 9703.429, "timestamp": "02:41:43", "text": "？"}, {"type": "subtitle", "time": 9709.429, "timestamp": "02:41:49", "text": "フラッシュを点ける。ロック"}, {"type": "subtitle", "time": 9719.75, "timestamp": "02:41:59", "text": "ここは私たちが"}]
[{"type": "subtitle", "time": 5583.75, "timestamp": "01:33:03", "text": "お話しましょう。"}, {"type": "subtitle", "time": 5585.51, "timestamp": "01:33:05", "text": "どのコース、"}, {"type": "subtitle", "time": 5588.47, "timestamp": "01:33:08", "text": "どの授業に出席する必要があるか、まだ決めていません。 それは"}, {"type": "subtitle", "time": 5591.59, "timestamp": "01:33:11", "text": "音楽とユーチューバーの間のことです。"}, {"type": "subtitle", "time": 5606.149, "timestamp": "01:33:26", "text": "私は自分がどこへ向かっているのか分からない。 えっと、"}, {"type": "subtitle", "time": 5609.669, "timestamp": "01:33:29", "text": "これがメインのアンドロイドなら、"}, {"type": "subtitle", "time": 5613.189, "timestamp": "01:33:33", "text": "ああ、そう、スキアね。ああ、"}, {"type": "subtitle", "time": 5615.75, "timestamp": "01:33:35", "text": "犬は飼わないよ。反射するエリアはない。"}, {"type": "subtitle", "time": 5624.07, "timestamp": "01:33:44", "text": "このエリア覚えてる？一度"}, {"type": "subtitle", "time": 5627.189, "timestamp": "01:33:47", "text": "ここに来たとき、音声のみのストリームで、"}, {"type": "subtitle", "time": 5630.629, "timestamp": "01:33:50", "text": "クリスマスみたいなビープ音が鳴る"}, {"type": "subtitle", "time": 5633.189, "timestamp": "01:33:53", "text": "ライトがあって、"}, {"type": "subtitle", "time": 5636.984, "timestamp": "01:33:56", "text": "夜にここに来たんだ。 確か午前0時だったと思います。"}]
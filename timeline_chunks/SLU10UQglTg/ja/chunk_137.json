[{"type": "subtitle", "time": 8263.75, "timestamp": "02:17:43", "text": "土曜日で、"}, {"type": "subtitle", "time": 8267.19, "timestamp": "02:17:47", "text": "早起きしないといけないし、明日は"}, {"type": "subtitle", "time": 8270.309, "timestamp": "02:17:50", "text": "夜8時にデビューするんです。 今、まさに今"}, {"type": "subtitle", "time": 8273.669, "timestamp": "02:17:53", "text": "、私は"}, {"type": "subtitle", "time": 8276.389, "timestamp": "02:17:56", "text": "パニック状態になるだろう。   ビーチに行くまであと"}]
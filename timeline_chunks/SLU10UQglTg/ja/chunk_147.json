[{"type": "subtitle", "time": 8820.389, "timestamp": "02:27:00", "text": "公園で、"}, {"type": "subtitle", "time": 8823.75, "timestamp": "02:27:03", "text": "あの大きな公園でやったことを発見したんです。あれは"}, {"type": "subtitle", "time": 8826.87, "timestamp": "02:27:06", "text": "あそこにありました。人前でやったんですが、"}, {"type": "subtitle", "time": 8830.07, "timestamp": "02:27:10", "text": "誰もいなかったと思いますが、"}, {"type": "subtitle", "time": 8832.389, "timestamp": "02:27:12", "text": "車が通っていました。"}, {"type": "subtitle", "time": 8836.55, "timestamp": "02:27:16", "text": "バスに乗っていた男性がトイレに行くために少し停車しました"}, {"type": "subtitle", "time": 8838.389, "timestamp": "02:27:18", "text": "。私が"}, {"type": "subtitle", "time": 8842.79, "timestamp": "02:27:22", "text": "また片手でやった時に叫んだのが聞こえたと思います。ええ。じゃあね"}, {"type": "subtitle", "time": 8846.55, "timestamp": "02:27:26", "text": "。でも今日はすごく楽しかったです。"}, {"type": "subtitle", "time": 8849.03, "timestamp": "02:27:29", "text": "今日はたくさんやりました。[笑い]"}, {"type": "subtitle", "time": 8851.75, "timestamp": "02:27:31", "text": "そして、"}, {"type": "subtitle", "time": 8854.63, "timestamp": "02:27:34", "text": "あの大きな公園でやったことを終える前に、私は"}, {"type": "subtitle", "time": 8858.389, "timestamp": "02:27:38", "text": "水鉄砲になりました。ただ[笑い]"}, {"type": "subtitle", "time": 8862.87, "timestamp": "02:27:42", "text": "パイプから水を飲んでいる時に、"}, {"type": "subtitle", "time": 8869.51, "timestamp": "02:27:49", "text": "水をたくさん飲んでから"}, {"type": "subtitle", "time": 8874.309, "timestamp": "02:27:54", "text": "水鉄砲になったんです。ああ、なんてこと。"}, {"type": "subtitle", "time": 8876.469, "timestamp": "02:27:56", "text": "楽しかったですか？ええ、カイセンが"}, {"type": "subtitle", "time": 8878.07, "timestamp": "02:27:58", "text": "大学で配信を始めたんですよ。ええ、"}]
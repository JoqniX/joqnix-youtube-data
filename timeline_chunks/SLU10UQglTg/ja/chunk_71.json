[{"type": "subtitle", "time": 4260.159, "timestamp": "01:11:00", "text": "よし、画面をロックするよ。"}, {"type": "subtitle", "time": 4264.55, "timestamp": "01:11:04", "text": "これには少し時間がかかります。"}, {"type": "subtitle", "time": 4268.55, "timestamp": "01:11:08", "text": "ハッシュ化しましょう。 よし、走ろう。   さあ行こう"}, {"type": "subtitle", "time": 4276.709, "timestamp": "01:11:16", "text": "雨の中、濡れた野原を走る。"}, {"type": "subtitle", "time": 4281.11, "timestamp": "01:11:21", "text": "見て。 ああ、傘が壊れてしまった。"}, {"type": "subtitle", "time": 4284.07, "timestamp": "01:11:24", "text": "ああ、くそ。 ああ、くそ。 ああ、くそ。 ああ、くそ。 なんてこった"}, {"type": "subtitle", "time": 4292.95, "timestamp": "01:11:32", "text": "おお。   わかった"}, {"type": "subtitle", "time": 4295.35, "timestamp": "01:11:35", "text": "。"}, {"type": "subtitle", "time": 4300.47, "timestamp": "01:11:40", "text": "ああ、くそ。 ああ、神様。 ああ、大変だ。"}, {"type": "subtitle", "time": 4302.63, "timestamp": "01:11:42", "text": "おお、それは良い発見ですね。 あ、"}, {"type": "subtitle", "time": 4307.43, "timestamp": "01:11:47", "text": "ボールを見つけたよ。 あ、ボールを見つけたよ。"}, {"type": "subtitle", "time": 4309.27, "timestamp": "01:11:49", "text": "私たちはどうすべきでしょうか？"}, {"type": "subtitle", "time": 4313.75, "timestamp": "01:11:53", "text": "えっと、そこに行きたいんです。"}, {"type": "subtitle", "time": 4316.709, "timestamp": "01:11:56", "text": "そこに行きたいけど、それをうまく利用したい"}, {"type": "chat", "time": 4317.637, "timestamp": "01:11:57", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "it's yours now"}]
[{"type": "subtitle", "time": 3781.43, "timestamp": "01:03:01", "text": "あそこまで登るのは実際難しいんですよ。"}, {"type": "subtitle", "time": 3784.95, "timestamp": "01:03:04", "text": "ええ、ここは私がウォーキング配信をする場所なんです"}, {"type": "subtitle", "time": 3791.91, "timestamp": "01:03:11", "text": "。以前は、ここに来てからずっと、ウォーキング配信をしていました。   でも"}, {"type": "subtitle", "time": 3795.75, "timestamp": "01:03:15", "text": "実際、すごくいい感じなんです。"}, {"type": "subtitle", "time": 3797.51, "timestamp": "01:03:17", "text": "あ、待って。   何か"}, {"type": "subtitle", "time": 3800.23, "timestamp": "01:03:20", "text": "忘れてたかな？"}, {"type": "subtitle", "time": 3803.99, "timestamp": "01:03:23", "text": "ああ、わかった。 モバイルバッテリーは持っています。 ああ、わかった"}, {"type": "subtitle", "time": 3806.71, "timestamp": "01:03:26", "text": "。  P. わかりました。 全て揃っている。"}, {"type": "subtitle", "time": 3809.67, "timestamp": "01:03:29", "text": "ただ濡れているだけです。 あ、待って。 私の財布が"}, {"type": "subtitle", "time": 3813.029, "timestamp": "01:03:33", "text": "濡れてしまった。 ああ、大丈夫です。"}, {"type": "subtitle", "time": 3814.63, "timestamp": "01:03:34", "text": "クレジットカードとか、そういうもの全部です。"}, {"type": "subtitle", "time": 3821.67, "timestamp": "01:03:41", "text": "私はどうしてこれをやるべきなのか不思議に思うだろうか？ あ、待って。 あそこに"}, {"type": "subtitle", "time": 3825.43, "timestamp": "01:03:45", "text": "探索エリアがあります。"}, {"type": "subtitle", "time": 3828.15, "timestamp": "01:03:48", "text": "泥の中。 ええ、あそこに座っていました。 あちらの"}, {"type": "subtitle", "time": 3830.87, "timestamp": "01:03:50", "text": "水っぽい方じゃないよ。 ここは"}, {"type": "subtitle", "time": 3834.23, "timestamp": "01:03:54", "text": "私が夜中の午前"}, {"type": "chat", "time": 3835.135, "timestamp": "01:03:55", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "he's unlocking more map"}, {"type": "subtitle", "time": 3839.589, "timestamp": "01:03:59", "text": "0時と午後11時に座って空を見上げる場所です。 星を見て、"}]
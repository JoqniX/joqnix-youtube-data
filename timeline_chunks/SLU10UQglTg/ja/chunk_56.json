[{"type": "subtitle", "time": 3360.309, "timestamp": "00:56:00", "text": "私が死ぬためだ。 自分は馴染めないと思う。いや、"}, {"type": "subtitle", "time": 3377.208, "timestamp": "00:56:17", "text": "ああ、（ため息）"}, {"type": "subtitle", "time": 3379.109, "timestamp": "00:56:19", "text": "（笑い）"}, {"type": "subtitle", "time": 3388.39, "timestamp": "00:56:28", "text": "私が"}, {"type": "subtitle", "time": 3390.95, "timestamp": "00:56:30", "text": "叫んだり泣いたりするのを聞いた人もいたでしょうね。 あ、待って"}, {"type": "subtitle", "time": 3393.19, "timestamp": "00:56:33", "text": "。 ソードフィッシュがここにいます。"}, {"type": "subtitle", "time": 3395.51, "timestamp": "00:56:35", "text": "もう一度やってみましょう。"}, {"type": "subtitle", "time": 3398.23, "timestamp": "00:56:38", "text": "6回目。 来てくれる視聴者全員に、私はこれを何度も繰り返してやるつもりです"}, {"type": "subtitle", "time": 3401.99, "timestamp": "00:56:41", "text": "。"}, {"type": "subtitle", "time": 3404.23, "timestamp": "00:56:44", "text": "今日ここにいる限り、私は"}, {"type": "subtitle", "time": 3410.309, "timestamp": "00:56:50", "text": "こんにちは。"}, {"type": "subtitle", "time": 3412.39, "timestamp": "00:56:52", "text": "この男は片手で。"}, {"type": "subtitle", "time": 3416.87, "timestamp": "00:56:56", "text": "6回目になるけど、また片手でやってみるよ。"}, {"type": "subtitle", "time": 3419.784, "timestamp": "00:56:59", "text": "死なないことを祈ろう。"}]
[{"type": "subtitle", "time": 6361.59, "timestamp": "01:46:01", "text": "スタンド全体が今、びしょ濡れです。"}, {"type": "subtitle", "time": 6365.75, "timestamp": "01:46:05", "text": "えっと、メガネが曇ってるんです。   ああ"}, {"type": "subtitle", "time": 6368.79, "timestamp": "01:46:08", "text": "、今日は楽しかった。 ああ、そうそう、そこだよ"}, {"type": "subtitle", "time": 6371.35, "timestamp": "01:46:11", "text": "。"}, {"type": "subtitle", "time": 6374.95, "timestamp": "01:46:14", "text": "私がやった配信の一つを覚えていますか？ルームメイトが、午後"}, {"type": "subtitle", "time": 6380.229, "timestamp": "01:46:20", "text": "12時か11時以降に来てくれと言ったんです。 えっと、"}, {"type": "subtitle", "time": 6384.95, "timestamp": "01:46:24", "text": "それで麺を食べたんだけど、なんだか変なデザートみたいな感じ"}, {"type": "subtitle", "time": 6390.39, "timestamp": "01:46:30", "text": "。 それはコーヒーと"}, {"type": "subtitle", "time": 6392.95, "timestamp": "01:46:32", "text": "ゼリーが混ざったようなものだった。 それはとても、ええと、"}, {"type": "subtitle", "time": 6395.669, "timestamp": "01:46:35", "text": "ザリガニでした。 でも、少しは食べました。 私は"}, {"type": "subtitle", "time": 6398.31, "timestamp": "01:46:38", "text": "その公園でそれを食べた。 あそこにウサギがいるよ。"}, {"type": "subtitle", "time": 6400.79, "timestamp": "01:46:40", "text": "うさぎの子ども向けグッズ。   えっと、"}, {"type": "subtitle", "time": 6405.91, "timestamp": "01:46:45", "text": "渡るチャンスを逃してしまいました。  M."}, {"type": "subtitle", "time": 6407.59, "timestamp": "01:46:47", "text": "ああ。"}, {"type": "subtitle", "time": 6409.35, "timestamp": "01:46:49", "text": "あ、待って。 ピアノのある"}, {"type": "subtitle", "time": 6411.99, "timestamp": "01:46:51", "text": "場所をご案内します。 これです。 ところで、"}, {"type": "subtitle", "time": 6413.83, "timestamp": "01:46:53", "text": "ちょっと"}, {"type": "subtitle", "time": 6416.47, "timestamp": "01:46:56", "text": "待って。 ああ、くそ。"}]
[{"type": "subtitle", "time": 8700.23, "timestamp": "02:25:00", "text": "。ただそれをもう一度やりたいだけ"}, {"type": "subtitle", "time": 8702.87, "timestamp": "02:25:02", "text": "。でも、暗いでしょう"}, {"type": "subtitle", "time": 8706.79, "timestamp": "02:25:06", "text": "。暗い体験をしたい？"}, {"type": "subtitle", "time": 8710.23, "timestamp": "02:25:10", "text": "夜の暗い雨の中で、私が"}, {"type": "subtitle", "time": 8713.429, "timestamp": "02:25:13", "text": "濡れて子供のように遊ぶ体験"}, {"type": "subtitle", "time": 8716.79, "timestamp": "02:25:16", "text": "。ただ、子供のように、私らしくいる。"}, {"type": "subtitle", "time": 8718.71, "timestamp": "02:25:18", "text": "でも今は、"}, {"type": "subtitle", "time": 8726.23, "timestamp": "02:25:26", "text": "私はデート派です。わかりました。では、ただ"}, {"type": "subtitle", "time": 8728.55, "timestamp": "02:25:28", "text": "見たいだけではないのですね。"}, {"type": "subtitle", "time": 8729.99, "timestamp": "02:25:29", "text": "ええと、[笑い]"}, {"type": "subtitle", "time": 8733.59, "timestamp": "02:25:33", "text": "私はそれを8回やりました。"}, {"type": "subtitle", "time": 8737.99, "timestamp": "02:25:37", "text": "片手でグラップルして、"}, {"type": "subtitle", "time": 8741.11, "timestamp": "02:25:41", "text": "片手でロープのようなものがあって、今は大きなロープのようなものがあって、"}, {"type": "subtitle", "time": 8744.23, "timestamp": "02:25:44", "text": "ある場所から別の場所に移動します。"}, {"type": "subtitle", "time": 8746.95, "timestamp": "02:25:46", "text": "うん、電話を持ちながら片手でやったんだけど、"}, {"type": "subtitle", "time": 8750.87, "timestamp": "02:25:50", "text": "子供用のシーソーみたいな"}, {"type": "subtitle", "time": 8754.07, "timestamp": "02:25:54", "text": "滑り台があったんだ。たぶん"}, {"type": "subtitle", "time": 8757.91, "timestamp": "02:25:57", "text": "4回くらい登ったと"}]
[{"type": "subtitle", "time": 8651.349, "timestamp": "02:24:11", "text": "、デビューの"}, {"type": "subtitle", "time": 8653.51, "timestamp": "02:24:13", "text": "イベントに来てくれてありがとう。"}, {"type": "subtitle", "time": 8657.91, "timestamp": "02:24:17", "text": "こんにちは、キキ。いつものように遅刻だよ、"}, {"type": "subtitle", "time": 8662.389, "timestamp": "02:24:22", "text": "兄弟。本当に申し訳ない。ああ、本当に気の毒だ。"}, {"type": "subtitle", "time": 8671.349, "timestamp": "02:24:31", "text": "どうして今来たの？どうして私がやった"}, {"type": "subtitle", "time": 8674.23, "timestamp": "02:24:34", "text": "ことをこんなに見逃したの"}, {"type": "subtitle", "time": 8682.63, "timestamp": "02:24:42", "text": "。ただ、ただ、ただ、"}, {"type": "subtitle", "time": 8688.23, "timestamp": "02:24:48", "text": "私は狂ったモードになって、あなたが"}, {"type": "subtitle", "time": 8697.83, "timestamp": "02:24:57", "text": "ここにいるから楽しかった。ただそれをやりたいだけ"}]
[{"type": "subtitle", "time": 11041.11, "timestamp": "03:04:01", "text": "ガラス"}, {"type": "subtitle", "time": 11043.51, "timestamp": "03:04:03", "text": "カバーみたいなやつ。"}, {"type": "subtitle", "time": 11046.63, "timestamp": "03:04:06", "text": "熱とかから守ってくれるやつですよね"}, {"type": "subtitle", "time": 11049.67, "timestamp": "03:04:09", "text": "？大きなフロントガラスに付いていた車のカバーみたいなやつ"}, {"type": "subtitle", "time": 11053.11, "timestamp": "03:04:13", "text": "。ええ、雨が"}, {"type": "subtitle", "time": 11055.83, "timestamp": "03:04:15", "text": "降っていたので外したんです。でも、"}, {"type": "subtitle", "time": 11057.19, "timestamp": "03:04:17", "text": "写真があるんです。ちょっと待って、待って、待って。"}, {"type": "subtitle", "time": 11066.07, "timestamp": "03:04:26", "text": "それ。見つけさせてください。"}, {"type": "subtitle", "time": 11068.23, "timestamp": "03:04:28", "text": "ええ、これです。"}, {"type": "subtitle", "time": 11070.23, "timestamp": "03:04:30", "text": "この"}, {"type": "subtitle", "time": 11073.59, "timestamp": "03:04:33", "text": "線です。線みたいなものです。"}, {"type": "subtitle", "time": 11076.15, "timestamp": "03:04:36", "text": "ご覧のとおり、線みたいなものです。"}, {"type": "subtitle", "time": 11078.79, "timestamp": "03:04:38", "text": "ほら？ほら？ほら？あれはジオンです。あれはキリトです。あれは"}, {"type": "subtitle", "time": 11085.91, "timestamp": "03:04:45", "text": "キリトです。そしてジオン。ああ、なんてことだ。"}, {"type": "subtitle", "time": 11088.612, "timestamp": "03:04:48", "text": "ええ。あれです。"}, {"type": "subtitle", "time": 11090.07, "timestamp": "03:04:50", "text": "[笑い]"}, {"type": "subtitle", "time": 11097.99, "timestamp": "03:04:57", "text": "ルームメイトの女王に叱られそうです"}]
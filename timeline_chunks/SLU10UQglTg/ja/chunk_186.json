[{"type": "subtitle", "time": 11161.83, "timestamp": "03:06:01", "text": "この時間頃に、"}, {"type": "subtitle", "time": 11164.389, "timestamp": "03:06:04", "text": "新しいモデルを紹介するデビュー配信を配信します"}, {"type": "subtitle", "time": 11166.87, "timestamp": "03:06:06", "text": "。もし来ていただけたら、本当に楽しみで大好きです"}, {"type": "subtitle", "time": 11170.87, "timestamp": "03:06:10", "text": "。ええと、それは"}, {"type": "subtitle", "time": 11174.79, "timestamp": "03:06:14", "text": "私にとって本当に大きな意味があります。 だから、"}, {"type": "subtitle", "time": 11177.67, "timestamp": "03:06:17", "text": "もし時間があれば、ぜひ来てください"}, {"type": "subtitle", "time": 11182.71, "timestamp": "03:06:22", "text": "。そして、"}, {"type": "subtitle", "time": 11186.63, "timestamp": "03:06:26", "text": "今日もありがとうございました。そろそろ終わりにします。今日は楽しかったです"}, {"type": "subtitle", "time": 11189.67, "timestamp": "03:06:29", "text": "。"}, {"type": "subtitle", "time": 11191.19, "timestamp": "03:06:31", "text": "今日はたくさん楽しかったので、"}, {"type": "subtitle", "time": 11194.63, "timestamp": "03:06:34", "text": "この気持ちを忘れてはいけません。"}, {"type": "subtitle", "time": 11198.15, "timestamp": "03:06:38", "text": "新しいジョックニックとして、"}, {"type": "subtitle", "time": 11202.07, "timestamp": "03:06:42", "text": "この楽しい気持ちを常に覚えておいて、"}, {"type": "subtitle", "time": 11205.19, "timestamp": "03:06:45", "text": "ストリーミングやVubingを、"}, {"type": "subtitle", "time": 11209.67, "timestamp": "03:06:49", "text": "あれこれルールに従わなければならないとか、過度に心配しすぎたりしてはいけません。"}, {"type": "subtitle", "time": 11214.07, "timestamp": "03:06:54", "text": "私の"}, {"type": "subtitle", "time": 11216.389, "timestamp": "03:06:56", "text": "ジョシュ[音楽]の"}, {"type": "subtitle", "time": 11217.99, "timestamp": "03:06:57", "text": "強みと弱みについては、皆さんもご存知だと思いますが、"}]
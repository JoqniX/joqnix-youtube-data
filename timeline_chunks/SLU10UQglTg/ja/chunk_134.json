[{"type": "subtitle", "time": 8041.109, "timestamp": "02:14:01", "text": "午後8時までには行きます。 寒くなると。 大丈夫です。"}, {"type": "subtitle", "time": 8042.709, "timestamp": "02:14:02", "text": "えっと、"}, {"type": "subtitle", "time": 8046.47, "timestamp": "02:14:06", "text": "こんにちは。 それで、要するに"}, {"type": "subtitle", "time": 8049.35, "timestamp": "02:14:09", "text": "最近すごく"}, {"type": "subtitle", "time": 8052.709, "timestamp": "02:14:12", "text": "混乱していたんだ"}, {"type": "subtitle", "time": 8055.189, "timestamp": "02:14:15", "text": "けど、"}, {"type": "subtitle", "time": 8064.069, "timestamp": "02:14:24", "text": "あなたの言う通りだと分かった。"}, {"type": "subtitle", "time": 8080.069, "timestamp": "02:14:40", "text": "パノシヤシは生意気でベタベタした感じ"}, {"type": "subtitle", "time": 8091.91, "timestamp": "02:14:51", "text": "。"}, {"type": "subtitle", "time": 8097.43, "timestamp": "02:14:57", "text": "それについて、ええ、とても素敵でした。"}]
[{"type": "subtitle", "time": 11111.429, "timestamp": "03:05:11", "text": "この種の放出についてあなたに話すと、"}, {"type": "subtitle", "time": 11116.95, "timestamp": "03:05:16", "text": "電子のようなもので、これは"}, {"type": "subtitle", "time": 11119.51, "timestamp": "03:05:19", "text": "現金のみのものです。デジタルの"}, {"type": "subtitle", "time": 11123.269, "timestamp": "03:05:23", "text": "ものがあればよかったのに。ショーを買いたいのですが、雨が降っているので、"}, {"type": "subtitle", "time": 11139.03, "timestamp": "03:05:39", "text": "今は雨が降っています。とにかく、まとめます。たくさん"}, {"type": "subtitle", "time": 11143.67, "timestamp": "03:05:43", "text": "歩かなければなりません。ああ、もう"}, {"type": "subtitle", "time": 11145.99, "timestamp": "03:05:45", "text": "時間です。"}, {"type": "subtitle", "time": 11152.309, "timestamp": "03:05:52", "text": "今日はありがとうございました。そして、私が"}, {"type": "subtitle", "time": 11155.19, "timestamp": "03:05:55", "text": "去る前に、明日の"}, {"type": "subtitle", "time": 11158.87, "timestamp": "03:05:58", "text": "この時間頃にお別れします。いいえ、43分前の"}]
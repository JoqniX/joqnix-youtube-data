[{"type": "subtitle", "time": 6182.149, "timestamp": "01:43:02", "text": "等等。 那里有个公园。 呃，等等。   我的"}, {"type": "subtitle", "time": 6185.189, "timestamp": "01:43:05", "text": "天哪。 我无法过马路。 什么？"}, {"type": "subtitle", "time": 6187.669, "timestamp": "01:43:07", "text": "哦，是的。 既然来了，就让我带"}, {"type": "subtitle", "time": 6191.99, "timestamp": "01:43:11", "text": "你们看看这间儿童房的钢琴吧。"}, {"type": "subtitle", "time": 6194.87, "timestamp": "01:43:14", "text": "所以，呃，现在几点了？ 晚上7点至8点"}, {"type": "subtitle", "time": 6198.39, "timestamp": "01:43:18", "text": "呃，如果是晚上 8 点，你就能听到他们"}, {"type": "subtitle", "time": 6201.83, "timestamp": "01:43:21", "text": "弹钢琴了。 他们播放的音乐"}, {"type": "subtitle", "time": 6204.229, "timestamp": "01:43:24", "text": "真好听。"}, {"type": "subtitle", "time": 6206.79, "timestamp": "01:43:26", "text": "呃，等等，那不是我的室友，对吧"}, {"type": "subtitle", "time": 6210.87, "timestamp": "01:43:30", "text": "？ 好的。 这就是日本。 好的。"}, {"type": "subtitle", "time": 6215.51, "timestamp": "01:43:35", "text": "呃，好的。 好的。 好的。 呃，"}, {"type": "subtitle", "time": 6218.629, "timestamp": "01:43:38", "text": "他说他会来这里。 呃，"}, {"type": "subtitle", "time": 6220.55, "timestamp": "01:43:40", "text": "不想被"}, {"type": "subtitle", "time": 6224.629, "timestamp": "01:43:44", "text": "他抓住。"}, {"type": "subtitle", "time": 6227.109, "timestamp": "01:43:47", "text": "捉迷藏。"}]
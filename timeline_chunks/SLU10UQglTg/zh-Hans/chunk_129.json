[{"type": "subtitle", "time": 7744.87, "timestamp": "02:09:04", "text": "我至今仍在想，"}, {"type": "subtitle", "time": 7748.229, "timestamp": "02:09:08", "text": "我为什么会选择今天这样做呢？"}, {"type": "subtitle", "time": 7751.349, "timestamp": "02:09:11", "text": "是因为明天我要去静音吗？"}, {"type": "subtitle", "time": 7752.55, "timestamp": "02:09:12", "text": "（清嗓子）"}, {"type": "subtitle", "time": 7756.229, "timestamp": "02:09:16", "text": "还是因为其他什么"}, {"type": "subtitle", "time": 7760.95, "timestamp": "02:09:20", "text": "原因？"}, {"type": "subtitle", "time": 7766.229, "timestamp": "02:09:26", "text": "呃，好吧，我把它放在那里。"}, {"type": "subtitle", "time": 7770.709, "timestamp": "02:09:30", "text": "好的。 但我只知道今天我玩得很"}, {"type": "subtitle", "time": 7775.35, "timestamp": "02:09:35", "text": "开心。 我的力量啊。 天哪，我的"}, {"type": "subtitle", "time": 7779.91, "timestamp": "02:09:39", "text": "耳机湿了。 哦，没事。   嗯"}, {"type": "subtitle", "time": 7790.47, "timestamp": "02:09:50", "text": "我今天有点精神失常，"}, {"type": "subtitle", "time": 7798.229, "timestamp": "02:09:58", "text": "。"}]
[{"type": "subtitle", "time": 5225.35, "timestamp": "01:27:05", "text": "我变成了“等等，我想那样做”。 我想"}, {"type": "subtitle", "time": 5228.229, "timestamp": "01:27:08", "text": "瞬间变成水母。 等等，让我"}, {"type": "subtitle", "time": 5254.31, "timestamp": "01:27:34", "text": "为什么它不再属于我了？  [笑声]"}, {"type": "subtitle", "time": 5261.11, "timestamp": "01:27:41", "text": "哦，"}, {"type": "subtitle", "time": 5263.27, "timestamp": "01:27:43", "text": "再见。 好的，再见。 谁来阻止我。 我"}, {"type": "subtitle", "time": 5266.149, "timestamp": "01:27:46", "text": "今天太疯狂了。 我钻头钻进去，哦，"}, {"type": "subtitle", "time": 5274.87, "timestamp": "01:27:54", "text": "是的，有人拦住了我。 我今天太疯狂了"}, {"type": "subtitle", "time": 5276.47, "timestamp": "01:27:56", "text": "。"}]
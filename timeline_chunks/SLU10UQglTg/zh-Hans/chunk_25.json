[{"type": "subtitle", "time": 1506.95, "timestamp": "00:25:06", "text": "一朵向日葵，我 想想。哦，等等。"}, {"type": "subtitle", "time": 1535.75, "timestamp": "00:25:35", "text": "哦，真漂亮。"}, {"type": "subtitle", "time": 1548.63, "timestamp": "00:25:48", "text": "所以，你们还记得我在"}, {"type": "subtitle", "time": 1551.909, "timestamp": "00:25:51", "text": "日本溪边散步，当时我"}]
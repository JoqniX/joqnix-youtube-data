[{"type": "subtitle", "time": 3360.309, "timestamp": "00:56:00", "text": "我就会死。 我觉得我格格不入。好吧，其实"}, {"type": "subtitle", "time": 3377.208, "timestamp": "00:56:17", "text": "唉……"}, {"type": "subtitle", "time": 3388.39, "timestamp": "00:56:28", "text": "你知道，有些人可能会听到我的"}, {"type": "subtitle", "time": 3390.95, "timestamp": "00:56:30", "text": "尖叫、哭泣等等。 哦，"}, {"type": "subtitle", "time": 3393.19, "timestamp": "00:56:33", "text": "等等。 剑鱼来了。 我们再来一次"}, {"type": "subtitle", "time": 3395.51, "timestamp": "00:56:35", "text": "。"}, {"type": "subtitle", "time": 3398.23, "timestamp": "00:56:38", "text": "第六次。 我会一遍又一遍地重复这个动作，献给每一位到场的观众"}, {"type": "subtitle", "time": 3401.99, "timestamp": "00:56:41", "text": "。"}, {"type": "subtitle", "time": 3404.23, "timestamp": "00:56:44", "text": "只要今天我能在这里，我就要好好"}, {"type": "subtitle", "time": 3410.309, "timestamp": "00:56:50", "text": "你好。"}, {"type": "subtitle", "time": 3412.39, "timestamp": "00:56:52", "text": "这家伙只有一只手。 我又要单手拿着"}, {"type": "subtitle", "time": 3416.87, "timestamp": "00:56:56", "text": "它了，这已经是第六次了。"}, {"type": "subtitle", "time": 3419.784, "timestamp": "00:56:59", "text": "但愿我不会死。"}]
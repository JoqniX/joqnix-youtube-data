[{"type": "subtitle", "time": 2123.75, "timestamp": "00:35:23", "text": "呃，好的。有人能告诉我怎么"}, {"type": "subtitle", "time": 2127.109, "timestamp": "00:35:27", "text": "系裤子吗？这样它就不会……"}, {"type": "subtitle", "time": 2131.43, "timestamp": "00:35:31", "text": "淋成这样？我的天啊，这太难了。"}, {"type": "subtitle", "time": 2134.23, "timestamp": "00:35:34", "text": "我像转圈圈一样转了好多次"}, {"type": "subtitle", "time": 2144.55, "timestamp": "00:35:44", "text": "好吧，"}, {"type": "subtitle", "time": 2146.23, "timestamp": "00:35:46", "text": "我要把裤子变成"}]
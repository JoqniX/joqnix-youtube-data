[{"type": "subtitle", "time": 7389.83, "timestamp": "02:03:09", "text": "好的。"}, {"type": "subtitle", "time": 7392.709, "timestamp": "02:03:12", "text": "哦，等等。 聊天群是不是已经没了？ 聊天框……它又"}, {"type": "subtitle", "time": 7402.229, "timestamp": "02:03:22", "text": "让我先回忆一下。 哦，它又死机了。"}, {"type": "subtitle", "time": 7412.87, "timestamp": "02:03:32", "text": "外星人。 你好，Kairo Exot。 欢迎。"}, {"type": "subtitle", "time": 7419.91, "timestamp": "02:03:39", "text": "你好。"}, {"type": "subtitle", "time": 7421.83, "timestamp": "02:03:41", "text": "我觉得那是用来聊天的。 如果警察"}, {"type": "subtitle", "time": 7423.83, "timestamp": "02:03:43", "text": "来抓他，我们就赶紧跑"}, {"type": "subtitle", "time": 7427.03, "timestamp": "02:03:47", "text": "。 很抱歉这么晚才回复这些信息"}, {"type": "subtitle", "time": 7430.55, "timestamp": "02:03:50", "text": "。 我的天啊。"}, {"type": "subtitle", "time": 7432.31, "timestamp": "02:03:52", "text": "可能有人看到了。 从"}]
[{"type": "subtitle", "time": 7203.35, "timestamp": "02:00:03", "text": "哦好的。 它是红色的。 哦，等等。 我应该"}, {"type": "subtitle", "time": 7206.31, "timestamp": "02:00:06", "text": "让它远离玻璃区域。 我"}, {"type": "subtitle", "time": 7210.229, "timestamp": "02:00:10", "text": "可能会看到自己轮廓的倒影。"}, {"type": "subtitle", "time": 7213.589, "timestamp": "02:00:13", "text": "我的意思是，你能看到我的影子。"}, {"type": "subtitle", "time": 7216.709, "timestamp": "02:00:16", "text": "但是，"}, {"type": "subtitle", "time": 7218.55, "timestamp": "02:00:18", "text": "呃，是的"}, {"type": "subtitle", "time": 7220.79, "timestamp": "02:00:20", "text": "。"}, {"type": "subtitle", "time": 7226.87, "timestamp": "02:00:26", "text": "所以"}, {"type": "subtitle", "time": 7229.189, "timestamp": "02:00:29", "text": "上帝，我不会"}, {"type": "subtitle", "time": 7232.149, "timestamp": "02:00:32", "text": "太自责。 我只想好好"}, {"type": "subtitle", "time": 7234.39, "timestamp": "02:00:34", "text": "享受。 不过，今天我真的玩"}, {"type": "subtitle", "time": 7238.39, "timestamp": "02:00:38", "text": "得很开心。 我们将参观最后一个"}, {"type": "subtitle", "time": 7240.149, "timestamp": "02:00:40", "text": "公园，"}, {"type": "subtitle", "time": 7243.109, "timestamp": "02:00:43", "text": "然后结束行程。 好的。"}, {"type": "subtitle", "time": 7246.229, "timestamp": "02:00:46", "text": "卡赛戈纳公园。 所以，我们参观了三个"}, {"type": "subtitle", "time": 7248.87, "timestamp": "02:00:48", "text": "部分。 我们将参观第三个景点，"}, {"type": "subtitle", "time": 7251.35, "timestamp": "02:00:51", "text": "然后就结束这次行程了。"}, {"type": "subtitle", "time": 7253.669, "timestamp": "02:00:53", "text": "好的。"}, {"type": "subtitle", "time": 7255.75, "timestamp": "02:00:55", "text": "我什么时候开始直播的？  5:30"}, {"type": "subtitle", "time": 7258.87, "timestamp": "02:00:58", "text": "演出。  5:30"}]
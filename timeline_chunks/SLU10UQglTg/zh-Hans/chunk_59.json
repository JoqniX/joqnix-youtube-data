[{"type": "subtitle", "time": 3562.789, "timestamp": "00:59:22", "text": "如果有人看到我，他们会说："}, {"type": "subtitle", "time": 3565.03, "timestamp": "00:59:25", "text": "“我的天哪，为什么这里有这么多苍蝇"}, {"type": "subtitle", "time": 3573.109, "timestamp": "00:59:33", "text": "好的。 你好。 我们回家吧。   这"}, {"type": "subtitle", "time": 3576.23, "timestamp": "00:59:36", "text": "不算是家。"}, {"type": "subtitle", "time": 3579.03, "timestamp": "00:59:39", "text": "我浑身湿透的时候，还有其他公园可以去吗"}, {"type": "subtitle", "time": 3582.95, "timestamp": "00:59:42", "text": "？ 我想我可以向"}, {"type": "subtitle", "time": 3586.15, "timestamp": "00:59:46", "text": "你证明这一点。 我的腿湿了。 我的天哪，"}, {"type": "subtitle", "time": 3589.349, "timestamp": "00:59:49", "text": "你看我全身都湿透了。 哦，"}, {"type": "subtitle", "time": 3591.67, "timestamp": "00:59:51", "text": "那是一块石头吗？"}, {"type": "subtitle", "time": 3594.23, "timestamp": "00:59:54", "text": "哦，好滑啊。 好了，"}, {"type": "subtitle", "time": 3596.15, "timestamp": "00:59:56", "text": "够了。"}, {"type": "subtitle", "time": 3599.99, "timestamp": "00:59:59", "text": "我们跑吧。 好的。 他妈的。"}]
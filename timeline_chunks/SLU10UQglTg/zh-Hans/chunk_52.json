[{"type": "subtitle", "time": 3122.23, "timestamp": "00:52:02", "text": "洗。"}, {"type": "subtitle", "time": 3124.71, "timestamp": "00:52:04", "text": "所以，嗯。"}, {"type": "subtitle", "time": 3126.95, "timestamp": "00:52:06", "text": "培根怎么样？艾丽莎，还有"}, {"type": "subtitle", "time": 3131.27, "timestamp": "00:52:11", "text": "其他所有参加但没参加的人怎么样？ 看吧。"}, {"type": "subtitle", "time": 3134.15, "timestamp": "00:52:14", "text": "希望你们一切都好。我玩得特别开心"}, {"type": "subtitle", "time": 3137.99, "timestamp": "00:52:17", "text": "，我觉得我"}, {"type": "subtitle", "time": 3140.63, "timestamp": "00:52:20", "text": "以前从来没有过这种感觉。"}, {"type": "subtitle", "time": 3143.51, "timestamp": "00:52:23", "text": "哦天哪，雨下得更大了。"}, {"type": "subtitle", "time": 3165.19, "timestamp": "00:52:45", "text": "哦我的天哪，苍蝇飞进我嘴里了。"}, {"type": "subtitle", "time": 3168.261, "timestamp": "00:52:48", "text": "搞什么鬼？"}, {"type": "subtitle", "time": 3172.79, "timestamp": "00:52:52", "text": "N。"}, {"type": "subtitle", "time": 3175.43, "timestamp": "00:52:55", "text": "好吧，最后一次。我"}]
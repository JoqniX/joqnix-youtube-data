[{"type": "subtitle", "time": 4320.79, "timestamp": "01:12:00", "text": "它钩住。 好了，我找到一个球。 咱们打"}, {"type": "subtitle", "time": 4322.55, "timestamp": "01:12:02", "text": "篮球吧。"}, {"type": "subtitle", "time": 4346.95, "timestamp": "01:12:26", "text": "任何人到来之前，我要先拍一张照片，把"}, {"type": "subtitle", "time": 4353.27, "timestamp": "01:12:33", "text": "整个东西都拍下来。"}, {"type": "subtitle", "time": 4355.91, "timestamp": "01:12:35", "text": "哦，等着看画面抖动吧。"}, {"type": "subtitle", "time": 4358.63, "timestamp": "01:12:38", "text": "对了，等我没那么穷的时候，总有一天我会买个稳定器之类的东西"}, {"type": "subtitle", "time": 4365.03, "timestamp": "01:12:45", "text": "。   是的"}, {"type": "subtitle", "time": 4366.55, "timestamp": "01:12:46", "text": "。"}, {"type": "subtitle", "time": 4369.51, "timestamp": "01:12:49", "text": "好的。 它在这里。 我们打算这么做。"}, {"type": "subtitle", "time": 4371.35, "timestamp": "01:12:51", "text": "我的天啊。"}, {"type": "subtitle", "time": 4375.83, "timestamp": "01:12:55", "text": "今天我们这里活动很多。 所以，你知道，这就是我们能做这么多"}]
[{"type": "subtitle", "time": 7985.75, "timestamp": "02:13:05", "text": "戴安娜。   是的"}, {"type": "subtitle", "time": 7988.95, "timestamp": "02:13:08", "text": "。 所以我希望"}, {"type": "subtitle", "time": 7995.51, "timestamp": "02:13:15", "text": "以后能继续做这件事，嗯，"}, {"type": "subtitle", "time": 8000.069, "timestamp": "02:13:20", "text": "从现在开始之类的。"}, {"type": "subtitle", "time": 8007.03, "timestamp": "02:13:27", "text": "好的。"}, {"type": "subtitle", "time": 8010.149, "timestamp": "02:13:30", "text": "你好。 嗯，我回来了。 哦，等等。 我又要"}, {"type": "subtitle", "time": 8011.99, "timestamp": "02:13:31", "text": "穿过草地了。 我为什么"}, {"type": "subtitle", "time": 8014.39, "timestamp": "02:13:34", "text": "又洗脚了？"}, {"type": "subtitle", "time": 8023.83, "timestamp": "02:13:43", "text": "他们正带着狗去散步。"}, {"type": "subtitle", "time": 8033.75, "timestamp": "02:13:53", "text": "好的。 你好。 是的。 嗯，在结束之前，"}, {"type": "subtitle", "time": 8036.629, "timestamp": "02:13:56", "text": "因为今天是慢跑的最后一天，"}, {"type": "subtitle", "time": 8038.31, "timestamp": "02:13:58", "text": "我再说几句。 我会在晚上"}]
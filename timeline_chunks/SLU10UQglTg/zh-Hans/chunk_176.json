[{"type": "subtitle", "time": 10561.91, "timestamp": "02:56:01", "text": "我在某个地方读到，我不得不一路"}, {"type": "subtitle", "time": 10566.55, "timestamp": "02:56:06", "text": "走回来，呃……” 回家。"}, {"type": "subtitle", "time": 10571.11, "timestamp": "02:56:11", "text": "呃，那真是太疯狂了。我"}, {"type": "subtitle", "time": 10577.99, "timestamp": "02:56:17", "text": "我以后想在直播里也这么做。"}, {"type": "subtitle", "time": 10581.03, "timestamp": "02:56:21", "text": "那天我们要去公园。我"}, {"type": "subtitle", "time": 10583.11, "timestamp": "02:56:23", "text": "从自动售货机里买了点东西吃。那"}, {"type": "subtitle", "time": 10588.389, "timestamp": "02:56:28", "text": "像汤，味道糟透了。我的"}, {"type": "subtitle", "time": 10591.03, "timestamp": "02:56:31", "text": "天哪。我居然一口气全喝光了"}, {"type": "subtitle", "time": 10593.429, "timestamp": "02:56:33", "text": "。"}, {"type": "subtitle", "time": 10600.87, "timestamp": "02:56:40", "text": "好了，我们回去。"}, {"type": "subtitle", "time": 10607.91, "timestamp": "02:56:47", "text": "所以，其实是……等等，我想我可以给"}, {"type": "subtitle", "time": 10610.309, "timestamp": "02:56:50", "text": "你们带看一小段。"}, {"type": "subtitle", "time": 10612.309, "timestamp": "02:56:52", "text": "呃，"}, {"type": "subtitle", "time": 10615.429, "timestamp": "02:56:55", "text": "这其实就是那片区域。你们看到"}, {"type": "subtitle", "time": 10618.55, "timestamp": "02:56:58", "text": "那个大教堂一样的东西了吗？我"}]
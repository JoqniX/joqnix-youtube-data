[{"type": "subtitle", "time": 5291.03, "timestamp": "01:28:11", "text": "公园里只有我一个人。"}, {"type": "subtitle", "time": 5295.83, "timestamp": "01:28:15", "text": "我听见山猫"}, {"type": "subtitle", "time": 5309.43, "timestamp": "01:28:29", "text": "你好。"}, {"type": "subtitle", "time": 5311.43, "timestamp": "01:28:31", "text": "那位女士应该"}, {"type": "subtitle", "time": 5313.99, "timestamp": "01:28:33", "text": "又在车里睡觉了。 节目。"}, {"type": "subtitle", "time": 5316.79, "timestamp": "01:28:36", "text": "是的，我不应该打扰她。 就让"}, {"type": "subtitle", "time": 5319.669, "timestamp": "01:28:39", "text": "我直走吧。   是的"}, {"type": "subtitle", "time": 5333.11, "timestamp": "01:28:53", "text": "我做了那件事。 你相信吗？"}, {"type": "subtitle", "time": 5336.79, "timestamp": "01:28:56", "text": "你相信这一切吗？"}, {"type": "subtitle", "time": 5339.11, "timestamp": "01:28:59", "text": "你相信这一刻吗？"}]
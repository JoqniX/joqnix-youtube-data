[{"type": "subtitle", "time": 4984.95, "timestamp": "01:23:04", "text": "好的，这是第一个。"}, {"type": "subtitle", "time": 4988.31, "timestamp": "01:23:08", "text": "好的，这次我从这边走。"}, {"type": "subtitle", "time": 4998.31, "timestamp": "01:23:18", "text": "哦，红色。 哦，蓝色。"}, {"type": "subtitle", "time": 5008.709, "timestamp": "01:23:28", "text": "吹吧。 啊。 我的天哪。 好的。 好的。 我的"}, {"type": "subtitle", "time": 5015.59, "timestamp": "01:23:35", "text": "好的。"}, {"type": "subtitle", "time": 5024.39, "timestamp": "01:23:44", "text": "这是给忍者的。 妈的。"}, {"type": "subtitle", "time": 5026.55, "timestamp": "01:23:46", "text": "好的。"}, {"type": "subtitle", "time": 5032.87, "timestamp": "01:23:52", "text": "我一开始做的另一幅画是"}, {"type": "subtitle", "time": 5035.75, "timestamp": "01:23:55", "text": "给Dash的。 我忘了说这件事。 我不"}, {"type": "subtitle", "time": 5037.59, "timestamp": "01:23:57", "text": "知道为什么我会如此疯狂，想要为每一个"}, {"type": "subtitle", "time": 5039.75, "timestamp": "01:23:59", "text": "观看的人都这样做。 我要让它成为"}]
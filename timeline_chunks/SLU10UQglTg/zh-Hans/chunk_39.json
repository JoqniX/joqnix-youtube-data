[{"type": "subtitle", "time": 2358.71, "timestamp": "00:39:18", "text": "我只想忘记一切，"}, {"type": "subtitle", "time": 2362.71, "timestamp": "00:39:22", "text": "享受当下。"}, {"type": "subtitle", "time": 2365.19, "timestamp": "00:39:25", "text": "所以，"}, {"type": "subtitle", "time": 2368.95, "timestamp": "00:39:28", "text": "忘记我明天的直播，忘记我的"}, {"type": "subtitle", "time": 2372.15, "timestamp": "00:39:32", "text": "担忧等等。"}, {"type": "subtitle", "time": 2376.71, "timestamp": "00:39:36", "text": "呃，压力、紧张、焦虑等等"}, {"type": "subtitle", "time": 2379.632, "timestamp": "00:39:39", "text": "。我要在这里"}, {"type": "subtitle", "time": 2380.31, "timestamp": "00:39:40", "text": "[笑]"}, {"type": "subtitle", "time": 2383.43, "timestamp": "00:39:43", "text": "享受我人生中最美好的时光。"}, {"type": "subtitle", "time": 2385.43, "timestamp": "00:39:45", "text": "明天你们可能会看到我紧张兮兮的"}, {"type": "subtitle", "time": 2388.55, "timestamp": "00:39:48", "text": "样子。"}]
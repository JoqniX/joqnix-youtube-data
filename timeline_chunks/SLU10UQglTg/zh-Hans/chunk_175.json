[{"type": "subtitle", "time": 10500.15, "timestamp": "02:55:00", "text": "我去刷新一下。"}, {"type": "subtitle", "time": 10520.87, "timestamp": "02:55:20", "text": "呃，"}, {"type": "subtitle", "time": 10523.91, "timestamp": "02:55:23", "text": "好的。那是个征兆。好的，那是个"}, {"type": "subtitle", "time": 10526.95, "timestamp": "02:55:26", "text": "征兆。好的，我安全了。"}, {"type": "subtitle", "time": 10528.469, "timestamp": "02:55:28", "text": "啊，"}, {"type": "subtitle", "time": 10530.79, "timestamp": "02:55:30", "text": "还有更多的地方我想带你们去"}, {"type": "subtitle", "time": 10534.309, "timestamp": "02:55:34", "text": "，但是如果我不用"}, {"type": "subtitle", "time": 10537.11, "timestamp": "02:55:37", "text": "早点回家，我是说，我迟到了会被"}, {"type": "subtitle", "time": 10539.11, "timestamp": "02:55:39", "text": "骂的，但是如果我不用……"}, {"type": "subtitle", "time": 10542.23, "timestamp": "02:55:42", "text": "呃，"}, {"type": "subtitle", "time": 10546.23, "timestamp": "02:55:46", "text": "我走了五七公里，呃，一边"}, {"type": "subtitle", "time": 10550.23, "timestamp": "02:55:50", "text": "和我的岳父岳母朋友打电话，"}, {"type": "subtitle", "time": 10553.03, "timestamp": "02:55:53", "text": "呃，就像这个公园一样。我"}, {"type": "subtitle", "time": 10556.55, "timestamp": "02:55:56", "text": "去了七个公园，我一直在打电话，走啊走啊走啊走啊走啊，"}]
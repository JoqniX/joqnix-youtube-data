[{"type": "subtitle", "time": 9181.91, "timestamp": "02:33:01", "text": "我应该在直播中展现真实的自己。"}, {"type": "subtitle", "time": 9184.309, "timestamp": "02:33:04", "text": "所以"}, {"type": "subtitle", "time": 9187.99, "timestamp": "02:33:07", "text": "我打算"}, {"type": "subtitle", "time": 9191.349, "timestamp": "02:33:11", "text": "晚上再去一次。真希望天上有星星"}, {"type": "subtitle", "time": 9195.67, "timestamp": "02:33:15", "text": "。为什么是阴天？没有。"}, {"type": "subtitle", "time": 9200.309, "timestamp": "02:33:20", "text": "好吧。呃，我们去"}, {"type": "subtitle", "time": 9206.55, "timestamp": "02:33:26", "text": "等等。嗯，好的。这边走。近路。"}, {"type": "subtitle", "time": 9209.67, "timestamp": "02:33:29", "text": "我觉得这条路是对的。"}, {"type": "subtitle", "time": 9221.03, "timestamp": "02:33:41", "text": "我刚才走在……呃，好像没"}, {"type": "subtitle", "time": 9228.95, "timestamp": "02:33:48", "text": "是什么？我的天，这里"}, {"type": "subtitle", "time": 9231.429, "timestamp": "02:33:51", "text": "真漂亮。"}, {"type": "subtitle", "time": 9235.19, "timestamp": "02:33:55", "text": "等等，这是哪儿？呃，对，对。呃，从"}, {"type": "subtitle", "time": 9239.429, "timestamp": "02:33:59", "text": "这里往左，往右。"}]
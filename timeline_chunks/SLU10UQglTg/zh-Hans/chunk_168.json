[{"type": "subtitle", "time": 10082.15, "timestamp": "02:48:02", "text": "不，我想玩。我觉得我太小了。"}, {"type": "subtitle", "time": 10084.15, "timestamp": "02:48:04", "text": "那是给小孩子玩的。"}, {"type": "subtitle", "time": 10087.83, "timestamp": "02:48:07", "text": "糟糕。哎呀，你小子。你小子。糟糕。我的天哪。"}, {"type": "subtitle", "time": 10091.51, "timestamp": "02:48:11", "text": "小心点。小心点。小心点。好的。糟糕。"}, {"type": "subtitle", "time": 10094.63, "timestamp": "02:48:14", "text": "我的头。我的天哪。我撞到"}, {"type": "subtitle", "time": 10097.269, "timestamp": "02:48:17", "text": "头了。"}, {"type": "subtitle", "time": 10098.896, "timestamp": "02:48:18", "text": "哦。"}, {"type": "subtitle", "time": 10100.71, "timestamp": "02:48:20", "text": "[笑声]"}, {"type": "subtitle", "time": 10103.11, "timestamp": "02:48:23", "text": "哦，我还小。"}, {"type": "subtitle", "time": 10104.87, "timestamp": "02:48:24", "text": "我才"}, {"type": "subtitle", "time": 10112.07, "timestamp": "02:48:32", "text": "啊。但是，"}, {"type": "subtitle", "time": 10113.83, "timestamp": "02:48:33", "text": "哦，[笑声] 是的，"}, {"type": "subtitle", "time": 10124.07, "timestamp": "02:48:44", "text": "天哪。"}, {"type": "chat", "time": 10133.02, "timestamp": "02:48:53", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/oPgfY_DoKfSXkNAPq8-AgAo"}, {"type": "subtitle", "time": 10137.11, "timestamp": "02:48:57", "text": "哦，那位女士没看见我。我想"}]
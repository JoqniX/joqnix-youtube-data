[{"type": "subtitle", "time": 7145.27, "timestamp": "01:59:05", "text": "我们喝了杯拿铁，那真是"}, {"type": "subtitle", "time": 7149.03, "timestamp": "01:59:09", "text": "太棒了。 所以，我有没有跟你讲过我和你第一天上班差点被"}, {"type": "chat", "time": 7149.107, "timestamp": "01:59:09", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "OwO"}, {"type": "subtitle", "time": 7156.629, "timestamp": "01:59:16", "text": "警察抓的故事？"}, {"type": "subtitle", "time": 7164.55, "timestamp": "01:59:24", "text": "我的天哪，这真是个离奇的故事。"}, {"type": "subtitle", "time": 7167.189, "timestamp": "01:59:27", "text": "但是我们当时很安全，而且我们没有"}, {"type": "subtitle", "time": 7172.229, "timestamp": "01:59:32", "text": "调整z值。"}, {"type": "subtitle", "time": 7174.47, "timestamp": "01:59:34", "text": "我的天啊。 想象一下如果我保持沉默会怎样。 我的"}, {"type": "subtitle", "time": 7181.43, "timestamp": "01:59:41", "text": "我得怪那些孩子，呃，比如几个凌晨一点"}, {"type": "subtitle", "time": 7184.87, "timestamp": "01:59:44", "text": "来的青少年。而且天气也"}, {"type": "subtitle", "time": 7188.709, "timestamp": "01:59:48", "text": "很冷。"}]
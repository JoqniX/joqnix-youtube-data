[{"type": "subtitle", "time": 1921.509, "timestamp": "00:32:01", "text": "等等。阿迪昌只是把水拿走了。"}, {"type": "subtitle", "time": 1924.789, "timestamp": "00:32:04", "text": "拜托，如果可以的话。"}, {"type": "subtitle", "time": 1935.75, "timestamp": "00:32:15", "text": "好吧，最后一个。这次，这次我"}, {"type": "subtitle", "time": 1941.269, "timestamp": "00:32:21", "text": "要去纳玛了。等等，卡萨昌。"}, {"type": "subtitle", "time": 1943.35, "timestamp": "00:32:23", "text": "卡萨昌"}, {"type": "subtitle", "time": 1945.99, "timestamp": "00:32:25", "text": "这次会在地上。趁我浑身湿透，我要"}, {"type": "subtitle", "time": 1949.59, "timestamp": "00:32:29", "text": "去做。好吧，第一个"}, {"type": "subtitle", "time": 1953.669, "timestamp": "00:32:33", "text": "。三，二。我的天哪，这"}, {"type": "subtitle", "time": 1957.11, "timestamp": "00:32:37", "text": "太难了。这太难了。"}, {"type": "subtitle", "time": 1961.082, "timestamp": "00:32:41", "text": "三，二，一。"}, {"type": "subtitle", "time": 1962.63, "timestamp": "00:32:42", "text": "（尖叫）我的天哪。我做到了。我做到了"}, {"type": "subtitle", "time": 1965.11, "timestamp": "00:32:45", "text": "搞定了。我做到了。"}, {"type": "subtitle", "time": 1969.99, "timestamp": "00:32:49", "text": "哦，操。哦，糟了。哦，操。哦，我的手"}, {"type": "subtitle", "time": 1974.47, "timestamp": "00:32:54", "text": "。我的手。哦，糟了。哦，糟了。哦，糟了"}, {"type": "subtitle", "time": 1979.75, "timestamp": "00:32:59", "text": "。我的手。哦，操。是啊。我的[叹气]"}]
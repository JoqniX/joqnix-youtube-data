[{"type": "subtitle", "time": 3069.43, "timestamp": "00:51:09", "text": "。我的天啊。我的裤子。全"}, {"type": "subtitle", "time": 3073.94, "timestamp": "00:51:13", "text": "湿了。"}, {"type": "subtitle", "time": 3097.67, "timestamp": "00:51:37", "text": "我的天哪。[笑]哦。哦。哦。哦。好吧。哦，天哪。天哪。哦，天哪。真棒。太棒了。好吧。哦，等等。那是什么？我没选小的那个。我应该再来一次吗？我们为了这家伙做了五次。"}, {"type": "subtitle", "time": 3105.27, "timestamp": "00:51:45", "text": "如果我再来一次，我会不会疯掉"}, {"type": "subtitle", "time": 3107.51, "timestamp": "00:51:47", "text": "？"}, {"type": "subtitle", "time": 3113.24, "timestamp": "00:51:53", "text": "意思是，享受生活吧。但是"}, {"type": "subtitle", "time": 3113.829, "timestamp": "00:51:53", "text": "[笑]"}, {"type": "subtitle", "time": 3115.51, "timestamp": "00:51:55", "text": "不，没事。我要去"}, {"type": "subtitle", "time": 3118.63, "timestamp": "00:51:58", "text": "洗个澡。反正我的所有礼服都要"}]
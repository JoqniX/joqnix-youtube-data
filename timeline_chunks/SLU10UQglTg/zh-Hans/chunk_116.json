[{"type": "subtitle", "time": 6961.03, "timestamp": "01:56:01", "text": "做到了。 真是太尴尬了（嗤笑）"}, {"type": "subtitle", "time": 6962.709, "timestamp": "01:56:02", "text": "。 我以后再也不会那样做了"}, {"type": "subtitle", "time": 6966.149, "timestamp": "01:56:06", "text": "。 是的。 再见。 是的。 再见。 我的天哪，"}, {"type": "subtitle", "time": 6969.27, "timestamp": "01:56:09", "text": "我的腿好痛。"}, {"type": "subtitle", "time": 6980.87, "timestamp": "01:56:20", "text": "我是在公共场所做的。 他妈的。"}, {"type": "subtitle", "time": 6993.99, "timestamp": "01:56:33", "text": "哦，他当时是一个人。 好的。 没人看到。   是的。 是的。"}, {"type": "subtitle", "time": 6998.09, "timestamp": "01:56:38", "text": "哦，但是你们都看到了。"}, {"type": "subtitle", "time": 7012.31, "timestamp": "01:56:52", "text": "啊，没人会评判你。 我"}, {"type": "subtitle", "time": 7014.79, "timestamp": "01:56:54", "text": "打算做我自己的事。 但这就是"}, {"type": "subtitle", "time": 7017.43, "timestamp": "01:56:57", "text": "日本的好处所在。"}, {"type": "subtitle", "time": 7018.95, "timestamp": "01:56:58", "text": "没人会说什么。 我的意思是，"}]
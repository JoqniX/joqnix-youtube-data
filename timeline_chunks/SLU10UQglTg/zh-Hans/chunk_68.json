[{"type": "subtitle", "time": 4081.589, "timestamp": "01:08:01", "text": "哦，这边的浓度很高。"}, {"type": "subtitle", "time": 4083.829, "timestamp": "01:08:03", "text": "不过，我还是想进入这个区域。"}, {"type": "subtitle", "time": 4086.95, "timestamp": "01:08:06", "text": "它一直处于锁定状态。 为什么这个很棒的"}, {"type": "subtitle", "time": 4090.069, "timestamp": "01:08:10", "text": "小地方被锁上了？ 为什么"}, {"type": "subtitle", "time": 4092.87, "timestamp": "01:08:12", "text": "只有日本人才能"}, {"type": "subtitle", "time": 4094.47, "timestamp": "01:08:14", "text": "带狗来这里？"}, {"type": "subtitle", "time": 4107.829, "timestamp": "01:08:27", "text": "我要去探索一番。 我真想去"}, {"type": "subtitle", "time": 4110.789, "timestamp": "01:08:30", "text": "那边的水坝看看，但是那里实际上是一片"}, {"type": "subtitle", "time": 4113.43, "timestamp": "01:08:33", "text": "森林。 我们可以去那里试试，"}, {"type": "subtitle", "time": 4122.709, "timestamp": "01:08:42", "text": "我该如何进入上面那个地方"}, {"type": "subtitle", "time": 4132.95, "timestamp": "01:08:52", "text": "我可以打开这个吗？ 哦，我打不开这个。"}]
[{"type": "subtitle", "time": 4746.87, "timestamp": "01:19:06", "text": "我的天啊。 妈的。"}, {"type": "subtitle", "time": 4749.669, "timestamp": "01:19:09", "text": "好的，这是第一个。 我的天哪。 我的双手。"}, {"type": "subtitle", "time": 4752.709, "timestamp": "01:19:12", "text": "我的手啊。 哦，该死。 我的天哪，孩子。 是啊，"}, {"type": "subtitle", "time": 4771.75, "timestamp": "01:19:31", "text": "哦，对，那边有水。 我"}, {"type": "subtitle", "time": 4774.95, "timestamp": "01:19:34", "text": "希望那里干净。 好了，我们走吧。"}, {"type": "subtitle", "time": 4780.149, "timestamp": "01:19:40", "text": "二、（喘息）"}, {"type": "subtitle", "time": 4786.149, "timestamp": "01:19:46", "text": "[嗤笑]"}]
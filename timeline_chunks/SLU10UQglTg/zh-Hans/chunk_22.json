[{"type": "subtitle", "time": 1326.95, "timestamp": "00:22:06", "text": "我的天哪，我的手机要湿了。"}, {"type": "subtitle", "time": 1331.029, "timestamp": "00:22:11", "text": "哇。 不，我们要走这条路。"}, {"type": "subtitle", "time": 1333.11, "timestamp": "00:22:13", "text": "如果别人看到我这么做，"}, {"type": "subtitle", "time": 1336.149, "timestamp": "00:22:16", "text": "他们肯定会说：“这小子是不是"}, {"type": "subtitle", "time": 1340.07, "timestamp": "00:22:20", "text": "疯了？他在跑。"}, {"type": "subtitle", "time": 1342.87, "timestamp": "00:22:22", "text": "他在雨里跑。"}, {"type": "subtitle", "time": 1360.47, "timestamp": "00:22:40", "text": "等等，这里没人吧？你没"}, {"type": "subtitle", "time": 1364.07, "timestamp": "00:22:44", "text": "看到任何人吧？好吧。什么？我"}]
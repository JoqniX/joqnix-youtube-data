[{"type": "subtitle", "time": 8284.309, "timestamp": "02:18:04", "text": "我会非常非常担心，大概在离"}, {"type": "subtitle", "time": 8290.87, "timestamp": "02:18:10", "text": "海滩活动开始还有 7 或 10 分钟的时候。"}, {"type": "subtitle", "time": 8293.695, "timestamp": "02:18:13", "text": "明天同一时间。"}, {"type": "subtitle", "time": 8294.389, "timestamp": "02:18:14", "text": "[笑声]"}, {"type": "subtitle", "time": 8298.87, "timestamp": "02:18:18", "text": "所以，嗯，是的，明天一定要过来看看。"}, {"type": "subtitle", "time": 8314.15, "timestamp": "02:18:34", "text": "我宣传一下，我"}, {"type": "subtitle", "time": 8316.309, "timestamp": "02:18:36", "text": "明天会在推特和Reddit上直播W赛事"}, {"type": "subtitle", "time": 8324.309, "timestamp": "02:18:44", "text": "而且你知道吗，今天老师"}, {"type": "subtitle", "time": 8326.79, "timestamp": "02:18:46", "text": "打电话给我，把"}, {"type": "subtitle", "time": 8329.429, "timestamp": "02:18:49", "text": "我的手机拿走了。"}, {"type": "subtitle", "time": 8335.03, "timestamp": "02:18:55", "text": "我当时正在写一条"}, {"type": "subtitle", "time": 8337.589, "timestamp": "02:18:57", "text": "类似Reddit帖子之类的消息，"}, {"type": "subtitle", "time": 8339.349, "timestamp": "02:18:59", "text": "准备发送出去。 然后我的老师"}]
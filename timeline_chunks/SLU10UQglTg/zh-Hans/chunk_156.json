[{"type": "subtitle", "time": 9360.95, "timestamp": "02:36:00", "text": "确定吗？"}, {"type": "subtitle", "time": 9364.71, "timestamp": "02:36:04", "text": "还是右转了？不，不，不，不。是"}, {"type": "subtitle", "time": 9405.349, "timestamp": "02:36:45", "text": "哦，等等。呃，因为天黑了，"}, {"type": "subtitle", "time": 9407.99, "timestamp": "02:36:47", "text": "我"}, {"type": "subtitle", "time": 9411.19, "timestamp": "02:36:51", "text": "下次去坐那个东西的时候要不要打开闪光灯？"}, {"type": "subtitle", "time": 9413.99, "timestamp": "02:36:53", "text": "我觉得那里会"}, {"type": "subtitle", "time": 9415.75, "timestamp": "02:36:55", "text": "有人。"}, {"type": "subtitle", "time": 9418.07, "timestamp": "02:36:58", "text": "我发出的声音越大，就越容易被"}, {"type": "subtitle", "time": 9419.67, "timestamp": "02:36:59", "text": "举报。"}]
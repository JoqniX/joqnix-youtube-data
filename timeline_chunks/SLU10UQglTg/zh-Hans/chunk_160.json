[{"type": "subtitle", "time": 9602.79, "timestamp": "02:40:02", "text": "好了。我们去吧。继续往前走"}, {"type": "subtitle", "time": 9606.07, "timestamp": "02:40:06", "text": "。"}, {"type": "subtitle", "time": 9609.51, "timestamp": "02:40:09", "text": "哦天哪，晚上玩肯定更有趣"}, {"type": "subtitle", "time": 9612.95, "timestamp": "02:40:12", "text": "。我要晚上玩。耶。"}, {"type": "subtitle", "time": 9615.19, "timestamp": "02:40:15", "text": "哦，我的天。"}, {"type": "subtitle", "time": 9618.15, "timestamp": "02:40:18", "text": "顺便说一下，那就像个灯笼。"}, {"type": "subtitle", "time": 9624.55, "timestamp": "02:40:24", "text": "[笑声]"}, {"type": "subtitle", "time": 9644.87, "timestamp": "02:40:44", "text": "我应该开始跑吗？所以，我们坐在"}, {"type": "subtitle", "time": 9646.87, "timestamp": "02:40:46", "text": "那边的地上淋雨。"}, {"type": "subtitle", "time": 9651.75, "timestamp": "02:40:51", "text": "我经常来这里仰望天空。"}, {"type": "subtitle", "time": 9654.95, "timestamp": "02:40:54", "text": "晚上大概11点到12点左右吧"}, {"type": "subtitle", "time": 9657.91, "timestamp": "02:40:57", "text": "。呃，就像"}]
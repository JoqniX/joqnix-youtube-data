[{"type": "subtitle", "time": 8462.63, "timestamp": "02:21:02", "text": "呃，今天我为什么说了这么多话？ 是的，今天"}, {"type": "subtitle", "time": 8466.79, "timestamp": "02:21:06", "text": "是最后一天。 我"}, {"type": "subtitle", "time": 8472.389, "timestamp": "02:21:12", "text": "[笑声和倒吸一口凉气]"}, {"type": "subtitle", "time": 8476.309, "timestamp": "02:21:16", "text": "我当时想，“哦，"}, {"type": "subtitle", "time": 8481.59, "timestamp": "02:21:21", "text": "去猫咖。对，我要去"}, {"type": "subtitle", "time": 8483.429, "timestamp": "02:21:23", "text": "。对。对。对。我要去。"}, {"type": "subtitle", "time": 8487.349, "timestamp": "02:21:27", "text": "我要去。嗯，我不知道"}, {"type": "subtitle", "time": 8489.83, "timestamp": "02:21:29", "text": "附近有没有猫咖。"}, {"type": "subtitle", "time": 8493.83, "timestamp": "02:21:33", "text": "等等，等等，等等。有。哦，"}, {"type": "subtitle", "time": 8495.429, "timestamp": "02:21:35", "text": "对，有。我要去"}, {"type": "subtitle", "time": 8498.07, "timestamp": "02:21:38", "text": "那里。哦，对。对，对，对，对。哦，对，对，对，对。"}, {"type": "subtitle", "time": 8499.91, "timestamp": "02:21:39", "text": "好吧，"}, {"type": "subtitle", "time": 8501.83, "timestamp": "02:21:41", "text": "明天出道之后，就是星期天什么的"}, {"type": "subtitle", "time": 8504.469, "timestamp": "02:21:44", "text": "。让我看看……哦，等等。呃，"}, {"type": "subtitle", "time": 8506.71, "timestamp": "02:21:46", "text": "我有钱吗？对，我可以"}, {"type": "subtitle", "time": 8508.71, "timestamp": "02:21:48", "text": "从信用卡里取。我希望他们有"}, {"type": "subtitle", "time": 8510.469, "timestamp": "02:21:50", "text": "现金支付。"}, {"type": "subtitle", "time": 8512.79, "timestamp": "02:21:52", "text": "如果是现金，我就完蛋了。但是，对，呃，"}, {"type": "subtitle", "time": 8515.11, "timestamp": "02:21:55", "text": "对，我可以这么做。[笑声]"}, {"type": "subtitle", "time": 8519.83, "timestamp": "02:21:59", "text": "去猫咖，撸一个"}]
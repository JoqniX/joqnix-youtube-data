[{"type": "subtitle", "time": 4026.069, "timestamp": "01:07:06", "text": "等等，明天就是我的首秀了。 所以，我只是在"}, {"type": "subtitle", "time": 4029.589, "timestamp": "01:07:09", "text": "玩而已。 所以，别在意我。 好的。"}, {"type": "subtitle", "time": 4032.789, "timestamp": "01:07:12", "text": "现在正在下雨。 哦，等等。"}, {"type": "subtitle", "time": 4034.87, "timestamp": "01:07:14", "text": "说到下雨，现在不下雨了"}, {"type": "subtitle", "time": 4038.47, "timestamp": "01:07:18", "text": "，但是，哦，又下雨了。 好的。 不"}, {"type": "subtitle", "time": 4046.95, "timestamp": "01:07:26", "text": "好的。 所以，呃，你可以听到披头士乐队的歌。"}, {"type": "subtitle", "time": 4049.43, "timestamp": "01:07:29", "text": "你听到了吗？ 就像日本动漫里那样"}, {"type": "subtitle", "time": 4056.71, "timestamp": "01:07:36", "text": "奥托，"}, {"type": "subtitle", "time": 4059.75, "timestamp": "01:07:39", "text": "这是披头士D。不是披头士乐队，"}, {"type": "subtitle", "time": 4062.789, "timestamp": "01:07:42", "text": "而是现在正在树上看着我们的真正的昆虫"}, {"type": "subtitle", "time": 4067.99, "timestamp": "01:07:47", "text": "。   我的天啊"}, {"type": "subtitle", "time": 4070.309, "timestamp": "01:07:50", "text": "。"}, {"type": "subtitle", "time": 4072.47, "timestamp": "01:07:52", "text": "不。"}]
[{"type": "subtitle", "time": 10861.59, "timestamp": "03:01:01", "text": "车。"}, {"type": "subtitle", "time": 10868.15, "timestamp": "03:01:08", "text": "你玩得开心吗？开心。今天玩得很开心"}, {"type": "subtitle", "time": 10869.59, "timestamp": "03:01:09", "text": "。"}, {"type": "subtitle", "time": 10880.15, "timestamp": "03:01:20", "text": "我好累。"}, {"type": "subtitle", "time": 10917.11, "timestamp": "03:01:57", "text": "我听说它很贵，但是很好喝"}, {"type": "subtitle", "time": 10919.59, "timestamp": "03:01:59", "text": "。很好喝。他们的抹茶很好喝，还有"}]
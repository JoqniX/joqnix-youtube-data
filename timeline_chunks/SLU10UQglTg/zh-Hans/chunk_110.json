[{"type": "subtitle", "time": 6601.83, "timestamp": "01:50:01", "text": "类似的事情。 呃，不过那是在下午"}, {"type": "subtitle", "time": 6607.75, "timestamp": "01:50:07", "text": "呃，"}, {"type": "subtitle", "time": 6621.189, "timestamp": "01:50:21", "text": "他给了我们太多信息来人肉搜索"}, {"type": "subtitle", "time": 6624.95, "timestamp": "01:50:24", "text": "他，真好啊，我的天哪，你不可能大老远"}, {"type": "subtitle", "time": 6627.189, "timestamp": "01:50:27", "text": "跑到我这里，在"}, {"type": "subtitle", "time": 6633.91, "timestamp": "01:50:33", "text": "我直播的时候对着我的脸说“你好，肌肉男”。 我的天，"}, {"type": "subtitle", "time": 6643.59, "timestamp": "01:50:43", "text": "带我出去玩玩。"}, {"type": "subtitle", "time": 6646.709, "timestamp": "01:50:46", "text": "我在这里朋友不多。"}, {"type": "subtitle", "time": 6653.83, "timestamp": "01:50:53", "text": "我的天啊。 有什么东西卡住了。 我的天啊。"}, {"type": "subtitle", "time": 6657.59, "timestamp": "01:50:57", "text": "那是只蚱蜢吗？  M."}, {"type": "subtitle", "time": 6658.87, "timestamp": "01:50:58", "text": "等等，等等，等等。 蚱蜢。"}]
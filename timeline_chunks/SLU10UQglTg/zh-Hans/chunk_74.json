[{"type": "subtitle", "time": 4442.47, "timestamp": "01:14:02", "text": "好的。 最后还有一件事。 然后我就去做那"}, {"type": "subtitle", "time": 4444.709, "timestamp": "01:14:04", "text": "件事了。"}, {"type": "subtitle", "time": 4448.229, "timestamp": "01:14:08", "text": "呃，我误入了一个岔路口。 我当时应该"}, {"type": "subtitle", "time": 4456.31, "timestamp": "01:14:16", "text": "有人叫了我的名字。 还有，那辆"}, {"type": "subtitle", "time": 4470.31, "timestamp": "01:14:30", "text": "三、二、一。 是的。 二。 好的，我们"}, {"type": "subtitle", "time": 4473.27, "timestamp": "01:14:33", "text": "做到五点就结束。"}, {"type": "chat", "time": 4485.109, "timestamp": "01:14:45", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ8LuIYCO_9EPt-GMgAw"}, {"type": "subtitle", "time": 4489.669, "timestamp": "01:14:49", "text": "再一次。"}, {"type": "subtitle", "time": 4497.83, "timestamp": "01:14:57", "text": "最后一个。   我的天哪"}]
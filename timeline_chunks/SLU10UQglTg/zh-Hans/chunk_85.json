[{"type": "subtitle", "time": 5101.51, "timestamp": "01:25:01", "text": "今天只想四处逛逛，玩得开心。"}, {"type": "subtitle", "time": 5103.03, "timestamp": "01:25:03", "text": "所以，别在意我。 我会被水溅到"}, {"type": "subtitle", "time": 5109.35, "timestamp": "01:25:09", "text": "[笑声]"}, {"type": "subtitle", "time": 5111.11, "timestamp": "01:25:11", "text": "我的天哪。   是的"}, {"type": "subtitle", "time": 5113.91, "timestamp": "01:25:13", "text": "。 再见。 我的天哪，我的脚。 哦，"}, {"type": "subtitle", "time": 5116.47, "timestamp": "01:25:16", "text": "到处都湿透了。"}, {"type": "subtitle", "time": 5119.51, "timestamp": "01:25:19", "text": "看起来我好像被雨淋湿了，但"}, {"type": "subtitle", "time": 5132.87, "timestamp": "01:25:32", "text": "天哪，我玩得太开心了。 哦，"}, {"type": "subtitle", "time": 5141.03, "timestamp": "01:25:41", "text": "至少我现在能看到海滩。"}, {"type": "subtitle", "time": 5143.75, "timestamp": "01:25:43", "text": "那真是太好了。"}, {"type": "subtitle", "time": 5146.709, "timestamp": "01:25:46", "text": "甲虫护身符"}, {"type": "subtitle", "time": 5149.43, "timestamp": "01:25:49", "text": "到了，"}, {"type": "subtitle", "time": 5157.99, "timestamp": "01:25:57", "text": "我认为日本的水质很干净。 所以"}, {"type": "subtitle", "time": 5159.669, "timestamp": "01:25:59", "text": "我打算从那边的管子里喝水"}]
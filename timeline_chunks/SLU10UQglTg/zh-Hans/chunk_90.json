[{"type": "subtitle", "time": 5409.03, "timestamp": "01:30:09", "text": "“我路过过。他路过过一次。你还要"}, {"type": "subtitle", "time": 5411.99, "timestamp": "01:30:11", "text": "再路过一次。” 哦，等等。 这里"}, {"type": "subtitle", "time": 5419.35, "timestamp": "01:30:19", "text": "哦，等等。 这是正确的。 哦，等等。"}, {"type": "subtitle", "time": 5423.59, "timestamp": "01:30:23", "text": "你离开了。 我会在那儿等。   我的"}, {"type": "subtitle", "time": 5449.27, "timestamp": "01:30:49", "text": "我这是在哪儿来着？"}, {"type": "subtitle", "time": 5453.11, "timestamp": "01:30:53", "text": "请问，离这里最近的公园在哪里"}, {"type": "subtitle", "time": 5457.35, "timestamp": "01:30:57", "text": "？ 我觉得我可以走捷径。"}]
[{"type": "subtitle", "time": 8100.55, "timestamp": "02:15:00", "text": "我希望，虽然我可能无法"}, {"type": "subtitle", "time": 8104.069, "timestamp": "02:15:04", "text": "在我的电脑直播上做这样的事情，"}, {"type": "subtitle", "time": 8107.43, "timestamp": "02:15:07", "text": "因为你知道，我和室友合租，"}, {"type": "subtitle", "time": 8113.589, "timestamp": "02:15:13", "text": "我不是一个人，我现在在一个"}, {"type": "subtitle", "time": 8116.55, "timestamp": "02:15:16", "text": "公园里，离"}, {"type": "subtitle", "time": 8121.189, "timestamp": "02:15:21", "text": "公寓很远，但是，是的"}, {"type": "subtitle", "time": 8128.79, "timestamp": "02:15:28", "text": "其他事就不用担心了。 我只想"}, {"type": "subtitle", "time": 8145.91, "timestamp": "02:15:45", "text": "感谢大家"}, {"type": "subtitle", "time": 8148.79, "timestamp": "02:15:48", "text": "这些年来对我的支持。"}, {"type": "subtitle", "time": 8152.39, "timestamp": "02:15:52", "text": "嗯，我相信，嗯，既有老"}, {"type": "subtitle", "time": 8155.27, "timestamp": "02:15:55", "text": "观众，也有新观众，他们可能"}, {"type": "subtitle", "time": 8158.39, "timestamp": "02:15:58", "text": "稍后会观看直播，也可能"}]
[{"type": "subtitle", "time": 4620.07, "timestamp": "01:17:00", "text": "那是谁？"}, {"type": "subtitle", "time": 4621.83, "timestamp": "01:17:01", "text": "等等，"}, {"type": "subtitle", "time": 4631.189, "timestamp": "01:17:11", "text": "我想玩得开心。"}, {"type": "subtitle", "time": 4634.07, "timestamp": "01:17:14", "text": "那是蜂鸣器吗？"}, {"type": "subtitle", "time": 4637.189, "timestamp": "01:17:17", "text": "等等，你看到了吗？ 等等，什么？ 哦，"}, {"type": "subtitle", "time": 4640.55, "timestamp": "01:17:20", "text": "它只是一棵树。 好吧，没事了。   我们"}, {"type": "subtitle", "time": 4648.63, "timestamp": "01:17:28", "text": "我的天哪，下雨了。"}, {"type": "subtitle", "time": 4652.229, "timestamp": "01:17:32", "text": "雨下得不大。 只是毛毛雨。"}, {"type": "subtitle", "time": 4656.07, "timestamp": "01:17:36", "text": "天气就是这样。 你好，云端。"}, {"type": "subtitle", "time": 4657.99, "timestamp": "01:17:37", "text": "好久不见了。 迪奥，你好吗？ 想"}, {"type": "subtitle", "time": 4661.35, "timestamp": "01:17:41", "text": "你了。  D. 好的。 我的天，那是水坑。 妈的"}, {"type": "subtitle", "time": 4663.03, "timestamp": "01:17:43", "text": "。"}, {"type": "subtitle", "time": 4665.35, "timestamp": "01:17:45", "text": "我的天哪。"}, {"type": "subtitle", "time": 4669.99, "timestamp": "01:17:49", "text": "你好。 这家伙只看过我做"}, {"type": "subtitle", "time": 4672.709, "timestamp": "01:17:52", "text": "一次。 呃，单手操作。"}, {"type": "subtitle", "time": 4674.87, "timestamp": "01:17:54", "text": "耶。"}, {"type": "subtitle", "time": 4678.31, "timestamp": "01:17:58", "text": "我把伞放在这边，这样可以"}]
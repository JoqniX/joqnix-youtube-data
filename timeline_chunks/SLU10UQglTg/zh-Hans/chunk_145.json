[{"type": "subtitle", "time": 8700.23, "timestamp": "02:25:00", "text": "我只想再来一次"}, {"type": "subtitle", "time": 8702.87, "timestamp": "02:25:02", "text": "。不过会很黑"}, {"type": "subtitle", "time": 8706.79, "timestamp": "02:25:06", "text": "。你想体验一下黑暗的感觉吗？在"}, {"type": "subtitle", "time": 8710.23, "timestamp": "02:25:10", "text": "夜晚的雨中，我"}, {"type": "subtitle", "time": 8713.429, "timestamp": "02:25:13", "text": "淋湿了，像个孩子一样玩耍，"}, {"type": "subtitle", "time": 8716.79, "timestamp": "02:25:16", "text": "做我自己。"}, {"type": "subtitle", "time": 8718.71, "timestamp": "02:25:18", "text": "但是现在"}, {"type": "subtitle", "time": 8726.23, "timestamp": "02:25:26", "text": "不，我喜欢约会。好吧。所以你不想只是"}, {"type": "subtitle", "time": 8728.55, "timestamp": "02:25:28", "text": "看看。嗯，"}, {"type": "subtitle", "time": 8729.99, "timestamp": "02:25:29", "text": "是的[笑]"}, {"type": "subtitle", "time": 8733.59, "timestamp": "02:25:33", "text": "我做了，我做了八次。单"}, {"type": "subtitle", "time": 8737.99, "timestamp": "02:25:37", "text": "手抓取，就像那种单"}, {"type": "subtitle", "time": 8741.11, "timestamp": "02:25:41", "text": "手绳子的东西，现在又是一个大绳子的东西，"}, {"type": "subtitle", "time": 8744.23, "timestamp": "02:25:44", "text": "然后你从一个地方到另一个地方。"}, {"type": "subtitle", "time": 8746.95, "timestamp": "02:25:46", "text": "是的，我做过。 一只手拿着"}, {"type": "subtitle", "time": 8750.87, "timestamp": "02:25:50", "text": "手机，旁边有个儿童"}, {"type": "subtitle", "time": 8754.07, "timestamp": "02:25:54", "text": "跷跷板，不是那种滑梯。"}, {"type": "subtitle", "time": 8757.91, "timestamp": "02:25:57", "text": "我爬上去大概四次吧"}]
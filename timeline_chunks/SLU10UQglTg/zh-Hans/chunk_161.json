[{"type": "subtitle", "time": 9660.71, "timestamp": "02:41:00", "text": "四月份的时候，我"}, {"type": "subtitle", "time": 9665.67, "timestamp": "02:41:05", "text": "周五无聊的时候来Stargaz玩。电池。嗯，"}, {"type": "subtitle", "time": 9667.91, "timestamp": "02:41:07", "text": "感觉真好。"}, {"type": "subtitle", "time": 9672.07, "timestamp": "02:41:12", "text": "好了，我把UI收起来，免得碰到"}, {"type": "subtitle", "time": 9677.429, "timestamp": "02:41:17", "text": "什么东西。好了，开始吧。到了。"}, {"type": "subtitle", "time": 9680.87, "timestamp": "02:41:20", "text": "希望没人。所以，像往常一样，我们"}, {"type": "subtitle", "time": 9683.51, "timestamp": "02:41:23", "text": "把伞放在树旁边，准备"}, {"type": "subtitle", "time": 9686.95, "timestamp": "02:41:26", "text": "开始。那个人，"}, {"type": "subtitle", "time": 9689.429, "timestamp": "02:41:29", "text": "那个人带着他的"}, {"type": "subtitle", "time": 9694.79, "timestamp": "02:41:34", "text": "狗狗在那边。这边没检测到人，也"}, {"type": "subtitle", "time": 9698.15, "timestamp": "02:41:38", "text": "没人坐在那里。好了，我想我"}, {"type": "subtitle", "time": 9701.27, "timestamp": "02:41:41", "text": "可以了。哦，等等。好黑啊。什么？"}, {"type": "subtitle", "time": 9703.429, "timestamp": "02:41:43", "text": "你知道吗？我要打开"}, {"type": "subtitle", "time": 9709.429, "timestamp": "02:41:49", "text": "我要打开闪光灯。"}, {"type": "subtitle", "time": 9713.11, "timestamp": "02:41:53", "text": "呃，锁定"}, {"type": "subtitle", "time": 9719.75, "timestamp": "02:41:59", "text": "这就是"}]
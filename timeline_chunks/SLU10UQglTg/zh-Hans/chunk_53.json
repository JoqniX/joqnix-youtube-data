[{"type": "subtitle", "time": 3182.069, "timestamp": "00:53:02", "text": "好。"}, {"type": "subtitle", "time": 3184.069, "timestamp": "00:53:04", "text": "过去三天，我的思绪一直在"}, {"type": "subtitle", "time": 3192.87, "timestamp": "00:53:12", "text": "我在这里玩得很开心。我甚至还没"}, {"type": "subtitle", "time": 3196.426, "timestamp": "00:53:16", "text": "准备明天的首播直播。"}, {"type": "subtitle", "time": 3197.109, "timestamp": "00:53:17", "text": "[笑]"}, {"type": "subtitle", "time": 3199.99, "timestamp": "00:53:19", "text": "我现在真的在雨里做着疯狂的"}, {"type": "subtitle", "time": 3201.829, "timestamp": "00:53:21", "text": "事情，"}, {"type": "subtitle", "time": 3204.79, "timestamp": "00:53:24", "text": "而且这里一个人也没有。如果"}, {"type": "subtitle", "time": 3215.75, "timestamp": "00:53:35", "text": "“好吧，再来一次。” 我会被水溅到"}, {"type": "subtitle", "time": 3218.39, "timestamp": "00:53:38", "text": "。"}, {"type": "subtitle", "time": 3221.75, "timestamp": "00:53:41", "text": "我的腿放在上面。 好的。 你好。 三、二、"}, {"type": "subtitle", "time": 3225.109, "timestamp": "00:53:45", "text": "一。 蹲伏。 妈的。  [清嗓子]"}, {"type": "subtitle", "time": 3229.349, "timestamp": "00:53:49", "text": "蹲下。"}, {"type": "subtitle", "time": 3233.99, "timestamp": "00:53:53", "text": "我的天哪。 二。"}, {"type": "subtitle", "time": 3236.309, "timestamp": "00:53:56", "text": "三。 黄色的。"}]
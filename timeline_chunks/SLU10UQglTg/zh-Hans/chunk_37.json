[{"type": "subtitle", "time": 2232.069, "timestamp": "00:37:12", "text": "对，那个日志功能。如果能用"}, {"type": "subtitle", "time": 2235.03, "timestamp": "00:37:15", "text": "深色全屏模式就好了"}, {"type": "subtitle", "time": 2236.63, "timestamp": "00:37:16", "text": "。这样"}, {"type": "subtitle", "time": 2238.79, "timestamp": "00:37:18", "text": "我只想"}, {"type": "subtitle", "time": 2241.19, "timestamp": "00:37:21", "text": "看聊天记录的时候就方便多了。我为什么结婚了？"}, {"type": "subtitle", "time": 2248.47, "timestamp": "00:37:28", "text": "你可以在那边玩板球或者棒球"}, {"type": "subtitle", "time": 2251.99, "timestamp": "00:37:31", "text": "。去吧。去吧"}, {"type": "subtitle", "time": 2254.87, "timestamp": "00:37:34", "text": "前面。"}, {"type": "subtitle", "time": 2257.67, "timestamp": "00:37:37", "text": "所以，这就是我晚上来这里"}, {"type": "subtitle", "time": 2260.95, "timestamp": "00:37:40", "text": "看星星的地方。我抬头看着天空，就像"}, {"type": "subtitle", "time": 2263.43, "timestamp": "00:37:43", "text": "这样，"}, {"type": "subtitle", "time": 2269.91, "timestamp": "00:37:49", "text": "一起坐着。我的"}, {"type": "subtitle", "time": 2272.55, "timestamp": "00:37:52", "text": "屁股已经湿了，所以就算再"}, {"type": "subtitle", "time": 2276.55, "timestamp": "00:37:56", "text": "湿一点也没关系。反正我也要去"}]
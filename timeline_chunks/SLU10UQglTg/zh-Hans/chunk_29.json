[{"type": "subtitle", "time": 1759.35, "timestamp": "00:29:19", "text": "我的天哪。"}, {"type": "chat", "time": 1761.19, "timestamp": "00:29:21", "author": "@ProjectAizen", "avatar": "https://yt4.ggpht.com/J4g8YNWAMR7duRA_MC0DvcSZYNpONwi8eZHcWl3kui9q7oBp930GwOoPZ17Ct3rJcBQWDIsOKA=s64-c-k-c0x00ffffff-no-rj", "message": "you climb up"}, {"type": "subtitle", "time": 1763.669, "timestamp": "00:29:23", "text": "操。太热了。不。不。"}, {"type": "chat", "time": 1779.971, "timestamp": "00:29:39", "author": "@ProjectAizen", "avatar": "https://yt4.ggpht.com/J4g8YNWAMR7duRA_MC0DvcSZYNpONwi8eZHcWl3kui9q7oBp930GwOoPZ17Ct3rJcBQWDIsOKA=s64-c-k-c0x00ffffff-no-rj", "message": "you trust in the power of your hands and feet to climb up"}, {"type": "subtitle", "time": 1784.07, "timestamp": "00:29:44", "text": "你爬上去。但我做不到。下雨了。"}, {"type": "chat", "time": 1784.087, "timestamp": "00:29:44", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "he's trying with one hand"}, {"type": "subtitle", "time": 1786.87, "timestamp": "00:29:46", "text": "下雨了。D。"}, {"type": "subtitle", "time": 1790.31, "timestamp": "00:29:50", "text": "好吧，让我试试。好吧，我"}, {"type": "subtitle", "time": 1794.23, "timestamp": "00:29:54", "text": "觉得我会死。我觉得我会摔下去。"}, {"type": "subtitle", "time": 1796.149, "timestamp": "00:29:56", "text": "我不想泄露我的手。我的意思是，我"}]
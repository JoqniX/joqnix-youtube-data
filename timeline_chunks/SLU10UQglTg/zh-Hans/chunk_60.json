[{"type": "subtitle", "time": 3609.27, "timestamp": "01:00:09", "text": "保姆，"}, {"type": "subtitle", "time": 3613.43, "timestamp": "01:00:13", "text": "你真厉害，如果我在的话，"}, {"type": "subtitle", "time": 3615.99, "timestamp": "01:00:15", "text": "我就不会在这里了。 纳尼"}, {"type": "subtitle", "time": 3624.39, "timestamp": "01:00:24", "text": "另外，我们来做个探索吧。"}, {"type": "subtitle", "time": 3627.109, "timestamp": "01:00:27", "text": "我还没有考察过这些地区。 好的，"}, {"type": "subtitle", "time": 3629.91, "timestamp": "01:00:29", "text": "这是那边这些小小的隔间盒子"}, {"type": "subtitle", "time": 3652.71, "timestamp": "01:00:52", "text": "我们这里可以打棒球。 真是太好了"}, {"type": "subtitle", "time": 3656.71, "timestamp": "01:00:56", "text": "。 这是棒球相关的。"}, {"type": "subtitle", "time": 3659.03, "timestamp": "01:00:59", "text": "是的，这边有个棒球之类的东西"}]
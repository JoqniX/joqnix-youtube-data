[{"type": "subtitle", "time": 4155.669, "timestamp": "01:09:15", "text": "这只狗，一只狗，狗，呃，喂食站"}, {"type": "subtitle", "time": 4157.91, "timestamp": "01:09:17", "text": "也是。"}, {"type": "subtitle", "time": 4162.55, "timestamp": "01:09:22", "text": "苏戈伊。 好的，我要走了。 去他妈的。"}, {"type": "subtitle", "time": 4164.95, "timestamp": "01:09:24", "text": "哦，等等。 它被锁住了。 哦，等等。 它被"}, {"type": "subtitle", "time": 4166.63, "timestamp": "01:09:26", "text": "锁住了。"}, {"type": "subtitle", "time": 4169.91, "timestamp": "01:09:29", "text": "等等，它被锁住了。 糟了，"}, {"type": "subtitle", "time": 4173.189, "timestamp": "01:09:33", "text": "锁上了。"}, {"type": "subtitle", "time": 4174.87, "timestamp": "01:09:34", "text": "拉屎。"}, {"type": "subtitle", "time": 4184.55, "timestamp": "01:09:44", "text": "没人看见我，对吧？ 你看到我这么做了吧"}, {"type": "subtitle", "time": 4188.95, "timestamp": "01:09:48", "text": "？ 好的。 悄悄逃走。"}, {"type": "subtitle", "time": 4197.91, "timestamp": "01:09:57", "text": "好的。 哦，灯亮了。 哦，"}]
[{"type": "subtitle", "time": 9846.71, "timestamp": "02:44:06", "text": "孩子玩得太嗨了。"}, {"type": "subtitle", "time": 9849.59, "timestamp": "02:44:09", "text": "兄弟，你这辈子应该在雨里拿着手机做一次这个"}, {"type": "subtitle", "time": 9855.59, "timestamp": "02:44:15", "text": "。在瓢泼大雨里。"}, {"type": "subtitle", "time": 9861.59, "timestamp": "02:44:21", "text": "好的，这次我们关掉闪光灯"}, {"type": "subtitle", "time": 9871.67, "timestamp": "02:44:31", "text": "我觉得闪光灯让画面有点怪。"}, {"type": "subtitle", "time": 9873.99, "timestamp": "02:44:33", "text": "为什么这么模糊？哦，对焦，对焦，"}, {"type": "subtitle", "time": 9876.63, "timestamp": "02:44:36", "text": "对焦，对焦。"}, {"type": "subtitle", "time": 9888.71, "timestamp": "02:44:48", "text": "好的。我们再来一次。好的"}, {"type": "subtitle", "time": 9899.59, "timestamp": "02:44:59", "text": "嗨。三，二，"}]
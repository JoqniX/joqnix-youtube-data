[{"type": "subtitle", "time": 10323.91, "timestamp": "02:52:03", "text": "好吧，我们回家吧。真的"}, {"type": "subtitle", "time": 10325.67, "timestamp": "02:52:05", "text": "太晚了。是"}, {"type": "subtitle", "time": 10329.19, "timestamp": "02:52:09", "text": "啊，差不多这个时候，Lex。呃，差不多这个时候"}, {"type": "subtitle", "time": 10330.87, "timestamp": "02:52:10", "text": "，我的"}, {"type": "subtitle", "time": 10333.03, "timestamp": "02:52:13", "text": "演示就结束了。"}, {"type": "subtitle", "time": 10334.71, "timestamp": "02:52:14", "text": "我不知道明天要直播多久"}, {"type": "subtitle", "time": 10336.71, "timestamp": "02:52:16", "text": "。"}, {"type": "subtitle", "time": 10349.429, "timestamp": "02:52:29", "text": "不能。"}, {"type": "subtitle", "time": 10351.349, "timestamp": "02:52:31", "text": "等等。等等。我怎么才能让我的手机"}, {"type": "subtitle", "time": 10353.51, "timestamp": "02:52:33", "text": "防水？等等，等等，等等，等等，"}, {"type": "subtitle", "time": 10356.79, "timestamp": "02:52:36", "text": "等等。我有个主意。我有个主意。"}, {"type": "subtitle", "time": 10359.429, "timestamp": "02:52:39", "text": "这可能有点疯狂。 我可能会……我可能会……"}, {"type": "subtitle", "time": 10361.11, "timestamp": "02:52:41", "text": "这就像生死攸关的情况，"}, {"type": "subtitle", "time": 10364.79, "timestamp": "02:52:44", "text": "但我可能会……我可能会"}, {"type": "subtitle", "time": 10369.67, "timestamp": "02:52:49", "text": "死。等等，我有个主意。我的"}, {"type": "subtitle", "time": 10372.15, "timestamp": "02:52:52", "text": "室友和学长学姐们都做过。现在只剩"}, {"type": "subtitle", "time": 10374.23, "timestamp": "02:52:54", "text": "下我一个人了。所以，"}, {"type": "subtitle", "time": 10378.95, "timestamp": "02:52:58", "text": "我有个防水的……呃……东西"}]
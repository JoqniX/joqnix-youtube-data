[{"type": "subtitle", "time": 4875.91, "timestamp": "01:21:15", "text": "天哪。 上帝。 苍蝇。 哦，苍蝇。 苍蝇。"}, {"type": "subtitle", "time": 4878.55, "timestamp": "01:21:18", "text": "哦。 哦。"}, {"type": "subtitle", "time": 4895.03, "timestamp": "01:21:35", "text": "。 很可能就是你。 所以我做了"}, {"type": "subtitle", "time": 4898.709, "timestamp": "01:21:38", "text": "四次。 等等，我无法滑动解锁。"}, {"type": "subtitle", "time": 4919.35, "timestamp": "01:21:59", "text": "我打赌如果他去参加障碍"}]
[{"type": "subtitle", "time": 4514.229, "timestamp": "01:15:14", "text": "因为我一直单手操作，所以手都疼了"}, {"type": "subtitle", "time": 4518.709, "timestamp": "01:15:18", "text": "。 是啊，小子。 我做到了。"}, {"type": "subtitle", "time": 4523.59, "timestamp": "01:15:23", "text": "好的。 好的，我们接过球回去吧"}, {"type": "subtitle", "time": 4526.39, "timestamp": "01:15:26", "text": "。"}, {"type": "subtitle", "time": 4528.07, "timestamp": "01:15:28", "text": "呃，"}, {"type": "subtitle", "time": 4531.43, "timestamp": "01:15:31", "text": "我不知道 Ninja 和 Jagnoser 是否在"}, {"type": "subtitle", "time": 4532.87, "timestamp": "01:15:32", "text": "这里。"}, {"type": "subtitle", "time": 4536.63, "timestamp": "01:15:36", "text": "如果你在聊天室里，请给我一个信号。"}, {"type": "subtitle", "time": 4538.31, "timestamp": "01:15:38", "text": "我要把这个献给你，"}, {"type": "subtitle", "time": 4539.99, "timestamp": "01:15:39", "text": "好吗？"}, {"type": "subtitle", "time": 4541.43, "timestamp": "01:15:41", "text": "既然你们来了，我就一直"}, {"type": "subtitle", "time": 4544.79, "timestamp": "01:15:44", "text": "为每一位到场的观众这样做。 所以，如果你在"}, {"type": "subtitle", "time": 4549.03, "timestamp": "01:15:49", "text": "这里，请告诉我。 给我一个信号。"}, {"type": "subtitle", "time": 4554.47, "timestamp": "01:15:54", "text": "我打算做一件疯狂的事——去"}]
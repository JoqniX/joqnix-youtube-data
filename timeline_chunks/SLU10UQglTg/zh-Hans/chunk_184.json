[{"type": "subtitle", "time": 11041.11, "timestamp": "03:04:01", "text": "呃……挡风玻璃……呃……那个"}, {"type": "subtitle", "time": 11043.51, "timestamp": "03:04:03", "text": "遮挡物……呃……就是那个可以"}, {"type": "subtitle", "time": 11046.63, "timestamp": "03:04:06", "text": "保护你免受……高温之类的东西，"}, {"type": "subtitle", "time": 11049.67, "timestamp": "03:04:09", "text": "对吧？就是他们用来遮挡大挡风玻璃的那个车罩"}, {"type": "subtitle", "time": 11053.11, "timestamp": "03:04:13", "text": "。对，他把它取下来了，"}, {"type": "subtitle", "time": 11055.83, "timestamp": "03:04:15", "text": "因为下雨了。不过我现在有一张"}, {"type": "subtitle", "time": 11057.19, "timestamp": "03:04:17", "text": "照片。等等，等等，等等，等等。"}, {"type": "subtitle", "time": 11066.07, "timestamp": "03:04:26", "text": "让我找找。让我找找。"}, {"type": "subtitle", "time": 11068.23, "timestamp": "03:04:28", "text": "对，就是这张。"}, {"type": "subtitle", "time": 11070.23, "timestamp": "03:04:30", "text": "这条"}, {"type": "subtitle", "time": 11073.59, "timestamp": "03:04:33", "text": "线。它有点像…… 线。"}, {"type": "subtitle", "time": 11076.15, "timestamp": "03:04:36", "text": "正如你所见，它有点像一条线。"}, {"type": "subtitle", "time": 11078.79, "timestamp": "03:04:38", "text": "看到了吗？看到了吗？看到了吗？那是吉翁。那是"}, {"type": "subtitle", "time": 11081.349, "timestamp": "03:04:41", "text": "桐人"}, {"type": "subtitle", "time": 11085.91, "timestamp": "03:04:45", "text": "。那是桐人。还有吉翁。我的天哪。对"}, {"type": "subtitle", "time": 11088.612, "timestamp": "03:04:48", "text": "。就是那个。"}, {"type": "subtitle", "time": 11090.07, "timestamp": "03:04:50", "text": "[笑声]"}, {"type": "subtitle", "time": 11097.99, "timestamp": "03:04:57", "text": "我要被我的室友"}]
[{"type": "subtitle", "time": 4217.99, "timestamp": "01:10:17", "text": "希望我有个篮球。 我可以那样钩住"}, {"type": "subtitle", "time": 4228.229, "timestamp": "01:10:28", "text": "我们要回去那里，因为龙之"}, {"type": "subtitle", "time": 4230.55, "timestamp": "01:10:30", "text": "海洋和忍者桑都在那里。 所以我打算再"}, {"type": "subtitle", "time": 4232.79, "timestamp": "01:10:32", "text": "去做那些疯狂的事，再淋一次雨"}, {"type": "subtitle", "time": 4234.39, "timestamp": "01:10:34", "text": "。   是的"}, {"type": "subtitle", "time": 4238.39, "timestamp": "01:10:38", "text": "，最后一次了。"}, {"type": "subtitle", "time": 4242.149, "timestamp": "01:10:42", "text": "我已经数不清了。"}, {"type": "subtitle", "time": 4254.87, "timestamp": "01:10:54", "text": "给我一个信号。 好的。"}, {"type": "subtitle", "time": 4256.95, "timestamp": "01:10:56", "text": "坚持，稍等。"}]
[{"type": "subtitle", "time": 3900.63, "timestamp": "01:05:00", "text": "哦，糟糕。 他妈的。 我的天啊。 我今天说了"}, {"type": "subtitle", "time": 3936.63, "timestamp": "01:05:36", "text": "厕所。 这里也有厕所。"}, {"type": "subtitle", "time": 3938.95, "timestamp": "01:05:38", "text": "我找到了厕所。"}, {"type": "subtitle", "time": 3943.27, "timestamp": "01:05:43", "text": "哦，那是厕所。 哦，原来是厕所。"}, {"type": "subtitle", "time": 3952.789, "timestamp": "01:05:52", "text": "哦，车里有位女士。"}, {"type": "subtitle", "time": 3954.309, "timestamp": "01:05:54", "text": "他妈的。"}]
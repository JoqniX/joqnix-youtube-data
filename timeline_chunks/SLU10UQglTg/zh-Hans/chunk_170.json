[{"type": "subtitle", "time": 10204.71, "timestamp": "02:50:04", "text": "我觉得我完全被"}, {"type": "subtitle", "time": 10217.99, "timestamp": "02:50:17", "text": "啊，真好玩。"}, {"type": "subtitle", "time": 10224.469, "timestamp": "02:50:24", "text": "真希望我下周去东京的时候也能做这些疯狂的事情。"}, {"type": "subtitle", "time": 10233.83, "timestamp": "02:50:33", "text": "嗯，但我认为我不能，"}, {"type": "subtitle", "time": 10237.11, "timestamp": "02:50:37", "text": "因为我得回家看演出，"}, {"type": "subtitle", "time": 10238.63, "timestamp": "02:50:38", "text": "而且"}, {"type": "subtitle", "time": 10240.63, "timestamp": "02:50:40", "text": "我必须……我想……是的"}, {"type": "subtitle", "time": 10243.51, "timestamp": "02:50:43", "text": "，我不知道会怎么样"}, {"type": "subtitle", "time": 10245.59, "timestamp": "02:50:45", "text": "。但如果离得"}, {"type": "subtitle", "time": 10247.75, "timestamp": "02:50:47", "text": "近，我就可以做任何我想做的事情了。 想，"}, {"type": "subtitle", "time": 10250.55, "timestamp": "02:50:50", "text": "然后回家"}, {"type": "subtitle", "time": 10252.309, "timestamp": "02:50:52", "text": "洗个澡。"}, {"type": "subtitle", "time": 10254.23, "timestamp": "02:50:54", "text": "所有东西都洗了。"}, {"type": "subtitle", "time": 10257.429, "timestamp": "02:50:57", "text": "我洗了脚。我还要再去这里吗"}]
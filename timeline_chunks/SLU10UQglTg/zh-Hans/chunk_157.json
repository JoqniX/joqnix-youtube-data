[{"type": "subtitle", "time": 9427.27, "timestamp": "02:37:07", "text": "因为之前下"}, {"type": "subtitle", "time": 9428.79, "timestamp": "02:37:08", "text": "大雨的时候，那里一个人也"}, {"type": "subtitle", "time": 9430.95, "timestamp": "02:37:10", "text": "没有。"}, {"type": "subtitle", "time": 9440.389, "timestamp": "02:37:20", "text": "所以我很担心。"}, {"type": "subtitle", "time": 9448.07, "timestamp": "02:37:28", "text": "坐。嗯，我们要去坐那个"}, {"type": "subtitle", "time": 9465.27, "timestamp": "02:37:45", "text": "庆幸。是的"}, {"type": "subtitle", "time": 9477.19, "timestamp": "02:37:57", "text": "，"}, {"type": "subtitle", "time": 9479.83, "timestamp": "02:37:59", "text": "我们今天把这片区域的每个角落都探索了一遍"}]
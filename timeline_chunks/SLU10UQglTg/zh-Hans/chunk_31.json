[{"type": "subtitle", "time": 1862.87, "timestamp": "00:31:02", "text": "。我的天哪。我泄露了自己的信息吗？你"}, {"type": "subtitle", "time": 1864.796, "timestamp": "00:31:04", "text": "看到我的脸了吗？"}, {"type": "subtitle", "time": 1865.59, "timestamp": "00:31:05", "text": "[叹气和喘息] 我"}, {"type": "subtitle", "time": 1869.19, "timestamp": "00:31:09", "text": "的天哪。我的天哪。我真的做到了。我"}, {"type": "subtitle", "time": 1872.23, "timestamp": "00:31:12", "text": "的 天哪。我真的做到了。我"}, {"type": "subtitle", "time": 1875.19, "timestamp": "00:31:15", "text": "的天哪。我真的做到了。有人"}, {"type": "chat", "time": 1876.618, "timestamp": "00:31:16", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "nyo"}, {"type": "subtitle", "time": 1879.35, "timestamp": "00:31:19", "text": "剪掉了。我的天哪。我的伞"}, {"type": "subtitle", "time": 1882.87, "timestamp": "00:31:22", "text": "不见了。什么？"}, {"type": "subtitle", "time": 1885.11, "timestamp": "00:31:25", "text": "我的天哪。"}, {"type": "subtitle", "time": 1886.63, "timestamp": "00:31:26", "text": "哦，"}, {"type": "chat", "time": 1894.257, "timestamp": "00:31:34", "author": "@ProjectAizen", "avatar": "https://yt4.ggpht.com/J4g8YNWAMR7duRA_MC0DvcSZYNpONwi8eZHcWl3kui9q7oBp930GwOoPZ17Ct3rJcBQWDIsOKA=s64-c-k-c0x00ffffff-no-rj", "message": "I think I saw your face... but the Rain Water droplet on your camera made it look like a Hippo"}, {"type": "subtitle", "time": 1896.149, "timestamp": "00:31:36", "text": "我的天哪。拜拜。我的手在"}, {"type": "subtitle", "time": 1897.909, "timestamp": "00:31:37", "text": "抖。"}, {"type": "subtitle", "time": 1899.83, "timestamp": "00:31:39", "text": "拜拜。"}, {"type": "subtitle", "time": 1906.149, "timestamp": "00:31:46", "text": "我这次可能要死了。这个水坑。如果我"}, {"type": "subtitle", "time": 1909.19, "timestamp": "00:31:49", "text": "摔倒了，"}, {"type": "subtitle", "time": 1911.99, "timestamp": "00:31:51", "text": "娜妮，我好像看到你的脸了，但是雨水"}, {"type": "subtitle", "time": 1914.47, "timestamp": "00:31:54", "text": "滴到相机上了。所以呢？你"}, {"type": "subtitle", "time": 1917.19, "timestamp": "00:31:57", "text": "没看到我的朋友。娜妮。"}, {"type": "subtitle", "time": 1919.83, "timestamp": "00:31:59", "text": "嗯？"}]
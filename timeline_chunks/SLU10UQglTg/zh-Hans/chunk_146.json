[{"type": "subtitle", "time": 8760.55, "timestamp": "02:26:00", "text": "。不，五次，四次。对。"}, {"type": "subtitle", "time": 8762.309, "timestamp": "02:26:02", "text": "然后"}, {"type": "subtitle", "time": 8766.389, "timestamp": "02:26:06", "text": "穿过那个大水花池。"}, {"type": "subtitle", "time": 8770.23, "timestamp": "02:26:10", "text": "然后……然后呢？我找到一个"}, {"type": "subtitle", "time": 8772.23, "timestamp": "02:26:12", "text": "棒球，把它放进篮球架里"}, {"type": "subtitle", "time": 8775.91, "timestamp": "02:26:15", "text": "。就是那个"}, {"type": "subtitle", "time": 8777.91, "timestamp": "02:26:17", "text": "篮球架，"}, {"type": "subtitle", "time": 8780.63, "timestamp": "02:26:20", "text": "我把它扔了出去。我"}, {"type": "subtitle", "time": 8784.23, "timestamp": "02:26:24", "text": "想我扔了十次，几次都"}, {"type": "subtitle", "time": 8787.27, "timestamp": "02:26:27", "text": "挺好。有一次我"}, {"type": "subtitle", "time": 8789.67, "timestamp": "02:26:29", "text": "单手扔不了，因为我得"}, {"type": "subtitle", "time": 8792.15, "timestamp": "02:26:32", "text": "拿着手机。"}, {"type": "subtitle", "time": 8800.63, "timestamp": "02:26:40", "text": "对。然后我们去了"}, {"type": "subtitle", "time": 8804.389, "timestamp": "02:26:44", "text": "7-11便利店附近，在那里我找到了一个"}, {"type": "subtitle", "time": 8806.63, "timestamp": "02:26:46", "text": "公园。你还记得"}, {"type": "subtitle", "time": 8809.429, "timestamp": "02:26:49", "text": "你来的时候问了我好多"}, {"type": "subtitle", "time": 8811.83, "timestamp": "02:26:51", "text": "问题吗？当时我正在吃晚饭，大概是上午"}, {"type": "subtitle", "time": 8814.23, "timestamp": "02:26:54", "text": "11点还是晚上11点？"}, {"type": "subtitle", "time": 8816.23, "timestamp": "02:26:56", "text": "对，就是那个公园。我去那个"}]
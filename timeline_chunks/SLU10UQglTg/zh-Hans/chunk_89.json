[{"type": "subtitle", "time": 5343.03, "timestamp": "01:29:03", "text": "你相信吗？ 我做了那件事，结果一只"}, {"type": "subtitle", "time": 5360.07, "timestamp": "01:29:20", "text": "[清嗓子]我的"}, {"type": "subtitle", "time": 5370.55, "timestamp": "01:29:30", "text": "天哪，我好紧张。 所以，嗯，我不"}, {"type": "subtitle", "time": 5373.59, "timestamp": "01:29:33", "text": "介意别人小声说话。 我太紧张了。 嗯，是的，"}, {"type": "subtitle", "time": 5375.51, "timestamp": "01:29:35", "text": "我当时在"}, {"type": "subtitle", "time": 5379.99, "timestamp": "01:29:39", "text": "火堆里玩耍。 我完成了最后的烧焦工序，现在"}, {"type": "subtitle", "time": 5382.39, "timestamp": "01:29:42", "text": "我要爬上楼梯了。 我不在"}, {"type": "subtitle", "time": 5384.95, "timestamp": "01:29:44", "text": "那里。 这位女士就在这里。 不，我"}, {"type": "subtitle", "time": 5387.11, "timestamp": "01:29:47", "text": "不应该去那里。"}, {"type": "subtitle", "time": 5389.83, "timestamp": "01:29:49", "text": "呃，"}, {"type": "subtitle", "time": 5391.51, "timestamp": "01:29:51", "text": "但我们可以"}]
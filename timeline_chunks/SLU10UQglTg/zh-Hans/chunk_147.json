[{"type": "subtitle", "time": 8820.389, "timestamp": "02:27:00", "text": "公园，然后我发现了那个东西。 我就是在那边"}, {"type": "subtitle", "time": 8823.75, "timestamp": "02:27:03", "text": "那个大公园里做的。那东西就在"}, {"type": "subtitle", "time": 8826.87, "timestamp": "02:27:06", "text": "那边。我是在公共场合做的，当时好像"}, {"type": "subtitle", "time": 8830.07, "timestamp": "02:27:10", "text": "没人，不过有"}, {"type": "subtitle", "time": 8832.389, "timestamp": "02:27:12", "text": "车经过。"}, {"type": "subtitle", "time": 8836.55, "timestamp": "02:27:16", "text": "有个家伙在公交车上，他停下来"}, {"type": "subtitle", "time": 8838.389, "timestamp": "02:27:18", "text": "去上厕所。我觉得他听到我"}, {"type": "subtitle", "time": 8842.79, "timestamp": "02:27:22", "text": "单手做的时候尖叫了。是啊。"}, {"type": "subtitle", "time": 8846.55, "timestamp": "02:27:26", "text": "拜拜。不过今天真是太棒了。我们"}, {"type": "subtitle", "time": 8849.03, "timestamp": "02:27:29", "text": "今天做了好多事。[笑声] 在"}, {"type": "subtitle", "time": 8851.75, "timestamp": "02:27:31", "text": "结束之前，"}, {"type": "subtitle", "time": 8854.63, "timestamp": "02:27:34", "text": "在那个大公园里，我变成了"}, {"type": "subtitle", "time": 8858.389, "timestamp": "02:27:38", "text": "喷水怪。我当时就……[笑声]"}, {"type": "subtitle", "time": 8862.87, "timestamp": "02:27:42", "text": "我一边喝着水管里的水，嗯，"}, {"type": "subtitle", "time": 8869.51, "timestamp": "02:27:49", "text": "我喝了很多水，然后就"}, {"type": "subtitle", "time": 8874.309, "timestamp": "02:27:54", "text": "变成了喷水怪。我的天哪。"}, {"type": "subtitle", "time": 8876.469, "timestamp": "02:27:56", "text": "希望你玩得开心。是啊，Kaisen"}, {"type": "subtitle", "time": 8878.07, "timestamp": "02:27:58", "text": "在大学里开了个直播。是的，"}]
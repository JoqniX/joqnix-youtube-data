[{"type": "subtitle", "time": 5881.51, "timestamp": "01:38:01", "text": "30多次了。"}, {"type": "subtitle", "time": 5883.35, "timestamp": "01:38:03", "text": "所以"}, {"type": "subtitle", "time": 5886.31, "timestamp": "01:38:06", "text": "日本人一开始很讨厌味噌"}, {"type": "subtitle", "time": 5890.07, "timestamp": "01:38:10", "text": "汤。 太棒了！"}, {"type": "subtitle", "time": 5893.109, "timestamp": "01:38:13", "text": "我不喜欢这个味道。 但第一天就"}, {"type": "subtitle", "time": 5896.149, "timestamp": "01:38:16", "text": "糟透了。 第二天还不错。 第三天还"}, {"type": "subtitle", "time": 5900.229, "timestamp": "01:38:20", "text": "不错。 好的。 第四天，他吃得很"}, {"type": "subtitle", "time": 5902.31, "timestamp": "01:38:22", "text": "开心。"}, {"type": "subtitle", "time": 5905.43, "timestamp": "01:38:25", "text": "你想看看我的座位吗？ 我带你去看"}, {"type": "subtitle", "time": 5909.27, "timestamp": "01:38:29", "text": "我的座位。 嗯，我总是选"}, {"type": "subtitle", "time": 5911.51, "timestamp": "01:38:31", "text": "靠窗的那个座位。 那是第三个，呃，"}, {"type": "subtitle", "time": 5914.149, "timestamp": "01:38:34", "text": "一、二、三。 那是第二个或"}, {"type": "subtitle", "time": 5918.229, "timestamp": "01:38:38", "text": "第三个座位。 如果我拿到那个区域，我就"}, {"type": "subtitle", "time": 5923.59, "timestamp": "01:38:43", "text": "可以看看车什么的。   糟糕"}, {"type": "subtitle", "time": 5931.75, "timestamp": "01:38:51", "text": "，是红色的。 它是绿色的。 我该过"}, {"type": "subtitle", "time": 5933.59, "timestamp": "01:38:53", "text": "马路吗？ 我不想过马路。 好吧，"}]
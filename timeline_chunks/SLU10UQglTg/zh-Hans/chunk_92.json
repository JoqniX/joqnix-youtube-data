[{"type": "subtitle", "time": 5528.149, "timestamp": "01:32:08", "text": "我一直在思考这个问题。 我以前从未享受过这样的乐趣"}, {"type": "subtitle", "time": 5532.229, "timestamp": "01:32:12", "text": "，对吧？ 还有，"}, {"type": "subtitle", "time": 5533.99, "timestamp": "01:32:13", "text": "我这是在哪儿？"}, {"type": "subtitle", "time": 5535.75, "timestamp": "01:32:15", "text": "什么？"}, {"type": "subtitle", "time": 5537.75, "timestamp": "01:32:17", "text": "等待。"}, {"type": "subtitle", "time": 5541.03, "timestamp": "01:32:21", "text": "呃，不在那里。"}, {"type": "subtitle", "time": 5543.59, "timestamp": "01:32:23", "text": "呃，"}, {"type": "subtitle", "time": 5547.11, "timestamp": "01:32:27", "text": "我想我应该去这里。 好的。"}, {"type": "subtitle", "time": 5553.99, "timestamp": "01:32:33", "text": "我希望我能向你展示我上下班去"}, {"type": "subtitle", "time": 5559.669, "timestamp": "01:32:39", "text": "迪奥的路上要走的路。 就像一个巨大的"}, {"type": "subtitle", "time": 5561.91, "timestamp": "01:32:41", "text": "村庄一样。 有很多"}, {"type": "subtitle", "time": 5566.709, "timestamp": "01:32:46", "text": "领域。 这里有很多很棒的地方。"}, {"type": "subtitle", "time": 5570.149, "timestamp": "01:32:50", "text": "是的，如果我当时正处于发情期，我可能早就"}, {"type": "subtitle", "time": 5572.07, "timestamp": "01:32:52", "text": "骑到那儿了。 你可以像乘坐"}, {"type": "subtitle", "time": 5575.189, "timestamp": "01:32:55", "text": "日本火车一样看到它。 我感觉就像在等过"}, {"type": "subtitle", "time": 5579.27, "timestamp": "01:32:59", "text": "马路一样。 嗯，我"}]
[{"type": "subtitle", "time": 6129.91, "timestamp": "01:42:09", "text": "因为手机支架坏了，只能用"}, {"type": "subtitle", "time": 6146.55, "timestamp": "01:42:26", "text": "我当时就拿着它一"}, {"type": "subtitle", "time": 6149.59, "timestamp": "01:42:29", "text": "秒钟，就被发现了。"}, {"type": "subtitle", "time": 6159.91, "timestamp": "01:42:39", "text": "他们看到我带着包，嗯，包，是"}, {"type": "subtitle", "time": 6163.83, "timestamp": "01:42:43", "text": "的。 哦，是的。 我现在不能去"}, {"type": "subtitle", "time": 6167.43, "timestamp": "01:42:47", "text": "7-Eleven便利店。 但我可以吗？我应该吗？"}, {"type": "subtitle", "time": 6169.83, "timestamp": "01:42:49", "text": "我不知道。 哦，是的。 是这里"}, {"type": "subtitle", "time": 6174.95, "timestamp": "01:42:54", "text": "吗？ 哦，是的。 萨尔，等等。 嗯？"}, {"type": "subtitle", "time": 6177.27, "timestamp": "01:42:57", "text": "但我接下来该做什么呢？"}, {"type": "subtitle", "time": 6179.51, "timestamp": "01:42:59", "text": "等等，说不定我会见到我的室友。 哦，"}]
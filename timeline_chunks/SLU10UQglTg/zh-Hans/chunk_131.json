[{"type": "subtitle", "time": 7861.589, "timestamp": "02:11:01", "text": "变。 只是我[清了清嗓子]，"}, {"type": "subtitle", "time": 7864.31, "timestamp": "02:11:04", "text": "只是我的外表和一些东西发生了"}, {"type": "subtitle", "time": 7867.83, "timestamp": "02:11:07", "text": "变化。 不过，"}, {"type": "subtitle", "time": 7872.709, "timestamp": "02:11:12", "text": "我想明天将会是一个全新的时代。"}, {"type": "subtitle", "time": 7876.709, "timestamp": "02:11:16", "text": "即使今天的直播更像是"}, {"type": "subtitle", "time": 7881.51, "timestamp": "02:11:21", "text": "老派运动员表演的最后一天，但"}, {"type": "subtitle", "time": 7885.27, "timestamp": "02:11:25", "text": "我感觉今天"}, {"type": "subtitle", "time": 7888.229, "timestamp": "02:11:28", "text": "某种程度上也是一个新的笑话的开始，一个小小的"}, {"type": "subtitle", "time": 7891.27, "timestamp": "02:11:31", "text": "预告片。 我想是的（笑）"}, {"type": "subtitle", "time": 7893.51, "timestamp": "02:11:33", "text": "。"}, {"type": "subtitle", "time": 7896.629, "timestamp": "02:11:36", "text": "我可以做回自己，不用担心"}, {"type": "subtitle", "time": 7900.31, "timestamp": "02:11:40", "text": "任何事情。 玩得开心。 我们"}, {"type": "subtitle", "time": 7903.43, "timestamp": "02:11:43", "text": "投篮得分两次，对吧？"}, {"type": "subtitle", "time": 7907.109, "timestamp": "02:11:47", "text": "我们找到了那个球。   是的"}, {"type": "subtitle", "time": 7909.75, "timestamp": "02:11:49", "text": "。"}, {"type": "subtitle", "time": 7917.91, "timestamp": "02:11:57", "text": "我当时为什么要做那些事？ 今天的"}]
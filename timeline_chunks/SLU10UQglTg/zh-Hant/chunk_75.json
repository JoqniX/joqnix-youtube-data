[{"type": "subtitle", "time": 4518.709, "timestamp": "01:15:18", "text": "我的天啊。  不。為什麼我們不能"}, {"type": "subtitle", "time": 4523.59, "timestamp": "01:15:23", "text": "再去一次？  哦，這邊的濃度很高。  不過，"}, {"type": "subtitle", "time": 4531.43, "timestamp": "01:15:31", "text": "我還是想進入這個區域。  它一直處於鎖定狀態。為什麼這個很棒的小地方被鎖上了？為什麼只有日本人才能帶狗來這裡？  為什麼"}, {"type": "subtitle", "time": 4541.43, "timestamp": "01:15:41", "text": "我進不去？"}, {"type": "subtitle", "time": 4554.47, "timestamp": "01:15:54", "text": "我要去"}, {"type": "subtitle", "time": 4556.31, "timestamp": "01:15:56", "text": "探索一番"}]
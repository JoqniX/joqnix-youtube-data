[{"type": "subtitle", "time": 9783.99, "timestamp": "02:43:03", "text": "。是的。這很有趣。"}, {"type": "subtitle", "time": 9786.55, "timestamp": "02:43:06", "text": "我要單手做，就像現在這樣，雨水真的會濺"}, {"type": "subtitle", "time": 9790.15, "timestamp": "02:43:10", "text": "濕地面。"}, {"type": "subtitle", "time": 9791.99, "timestamp": "02:43:11", "text": "但是，是的。"}, {"type": "subtitle", "time": 9795.429, "timestamp": "02:43:15", "text": "好的，米娜。我們再來一次。"}, {"type": "subtitle", "time": 9799.19, "timestamp": "02:43:19", "text": "三。希望我不會在拿著相機的時候露出自己。"}, {"type": "subtitle", "time": 9802.71, "timestamp": "02:43:22", "text": "好的。三，二，"}, {"type": "subtitle", "time": 9805.11, "timestamp": "02:43:25", "text": "一。哦，等等。等等。失敗，失敗，失敗。那"}, {"type": "subtitle", "time": 9807.67, "timestamp": "02:43:27", "text": "怎麼辦？三，三"}, {"type": "subtitle", "time": 9812.23, "timestamp": "02:43:32", "text": "，"}, {"type": "subtitle", "time": 9816.23, "timestamp": "02:43:36", "text": "二，一。"}, {"type": "subtitle", "time": 9831.19, "timestamp": "02:43:51", "text": "有人嗎？"}, {"type": "subtitle", "time": 9833.59, "timestamp": "02:43:53", "text": "好的，等等。三，二，一。哦，糟糕。哦我的天哪。哦我的天哪。哦我的天哪。"}]
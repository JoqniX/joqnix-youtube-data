[{"type": "subtitle", "time": 5045.189, "timestamp": "01:24:05", "text": "做。"}, {"type": "subtitle", "time": 5073.91, "timestamp": "01:24:33", "text": "這裡，請告訴我。給我一個信號。  我打算"}, {"type": "subtitle", "time": 5081.11, "timestamp": "01:24:41", "text": "做一件瘋狂的事——去兒童公園探險。  他媽的。"}, {"type": "subtitle", "time": 5091.43, "timestamp": "01:24:51", "text": "我的天哪。快點。  我再澆一次水。我們走吧。"}]
[{"type": "subtitle", "time": 9724.389, "timestamp": "02:42:04", "text": "。拜拜。好的，我們走吧。我要為你做，D。我們走吧。哦我的天哪，下雨了。蜘蛛女王還活著。你還在嗎？"}, {"type": "subtitle", "time": 9733.11, "timestamp": "02:42:13", "text": "好的。你在幹什麼？我要單"}, {"type": "subtitle", "time": 9776.79, "timestamp": "02:42:56", "text": "我要單手做，同時"}, {"type": "subtitle", "time": 9779.67, "timestamp": "02:42:59", "text": "手裡拿著手機"}]
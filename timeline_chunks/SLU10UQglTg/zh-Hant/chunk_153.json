[{"type": "subtitle", "time": 9191.349, "timestamp": "02:33:11", "text": "我希望他們有現金支付。如果是現金，"}, {"type": "subtitle", "time": 9200.309, "timestamp": "02:33:20", "text": "我就完蛋了。但是，對，呃，對，我可以"}, {"type": "subtitle", "time": 9209.67, "timestamp": "02:33:29", "text": "這麼做。 [笑聲] 去貓咖，擼一個小時貓，然後回家"}, {"type": "subtitle", "time": 9235.19, "timestamp": "02:33:55", "text": "，我的天哪"}]
[{"type": "subtitle", "time": 3484.87, "timestamp": "00:58:04", "text": "。太高了。 M. 三、二、一。"}, {"type": "subtitle", "time": 3492.47, "timestamp": "00:58:12", "text": "太慢了。不，不，不，不。我的天哪。"}, {"type": "subtitle", "time": 3497.03, "timestamp": "00:58:17", "text": "哦，不錯。"}, {"type": "subtitle", "time": 3498.71, "timestamp": "00:58:18", "text": "好的。"}, {"type": "subtitle", "time": 3500.95, "timestamp": "00:58:20", "text": "實際上，我正在把腿搭上去，"}, {"type": "subtitle", "time": 3511.27, "timestamp": "00:58:31", "text": "你說的“首次亮相”是什麼意思？"}, {"type": "subtitle", "time": 3514.23, "timestamp": "00:58:34", "text": "D：呃，這"}]
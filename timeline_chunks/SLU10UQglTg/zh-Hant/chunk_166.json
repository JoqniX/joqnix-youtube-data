[{"type": "subtitle", "time": 9965.99, "timestamp": "02:46:05", "text": "不，如果沒有閃光燈"}, {"type": "subtitle", "time": 9975.429, "timestamp": "02:46:15", "text": "我什麼都看不見"}, {"type": "subtitle", "time": 9978.23, "timestamp": "02:46:18", "text": "。我的手。 哦，該死。死。我的天啊。你的屁股。"}, {"type": "subtitle", "time": 9983.429, "timestamp": "02:46:23", "text": "哦，"}, {"type": "subtitle", "time": 9985.19, "timestamp": "02:46:25", "text": "你的屁股。好痛。好痛。為什麼"}, {"type": "subtitle", "time": 9993.11, "timestamp": "02:46:33", "text": "我之前做六次的時候不痛？為什麼最後會痛？哦，對焦。好的，下一個。是"}, {"type": "subtitle", "time": 9995.91, "timestamp": "02:46:35", "text": "幻燈片。不錯的幻燈片。那邊有個很大的水坑。好了，開始吧。蹲下。"}]
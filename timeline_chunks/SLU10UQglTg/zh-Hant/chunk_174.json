[{"type": "subtitle", "time": 10446.389, "timestamp": "02:54:06", "text": "我不知道我是怎麼做到的。我以後想在直播裡也這麼做。那天我們要去公園。我從自動販賣機買了點東西吃。那像湯，味道糟透了。我的天哪。"}, {"type": "subtitle", "time": 10454.63, "timestamp": "02:54:14", "text": "我居然一口氣全喝光了"}, {"type": "subtitle", "time": 10465.03, "timestamp": "02:54:25", "text": "哇。好了，"}, {"type": "subtitle", "time": 10468.07, "timestamp": "02:54:28", "text": "我們回去。我們來了。從……來"}, {"type": "subtitle", "time": 10469.59, "timestamp": "02:54:29", "text": "。所以，其實"}, {"type": "subtitle", "time": 10493.269, "timestamp": "02:54:53", "text": "等等，我想我可以帶一小段給你們看。"}]
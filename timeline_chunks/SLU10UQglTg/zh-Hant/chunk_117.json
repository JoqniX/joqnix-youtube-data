[{"type": "subtitle", "time": 7020.95, "timestamp": "01:57:00", "text": "你既能在白天看到不明飛行物，也能在夜間看到不明飛行物。 呃，好的"}, {"type": "subtitle", "time": 7032.95, "timestamp": "01:57:12", "text": "。  天哪，今天真開心。哦，對，就是那部分。"}, {"type": "subtitle", "time": 7035.83, "timestamp": "01:57:15", "text": "你還記得我之前直播的那次嗎？當時我的室友讓我晚上"}, {"type": "subtitle", "time": 7062.95, "timestamp": "01:57:42", "text": "12點或11點以後來。嗯，我吃了麵條，現在"}]
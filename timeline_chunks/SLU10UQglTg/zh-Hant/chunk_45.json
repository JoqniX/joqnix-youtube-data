[{"type": "subtitle", "time": 2710.39, "timestamp": "00:45:10", "text": "功能。看星星的地方。我抬頭看著天空，就像這樣，一起坐著。我的屁股已經濕了，所以就算再濕一點也沒關係。"}, {"type": "subtitle", "time": 2725.67, "timestamp": "00:45:25", "text": "反正我也要去洗澡。沒人能看到我，對吧？"}, {"type": "subtitle", "time": 2741.91, "timestamp": "00:45:41", "text": "。"}, {"type": "subtitle", "time": 2744.39, "timestamp": "00:45:44", "text": "呃，我覺得這裡不錯"}, {"type": "chat", "time": 2757.967, "timestamp": "00:45:57", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "last day as joq huh? been a journey."}]
[{"type": "subtitle", "time": 15601.67, "timestamp": "04:20:01", "text": "但感觉大部分都是小公寓，或者"}, {"type": "subtitle", "time": 15605.149, "timestamp": "04:20:05", "text": "东京的这家黎明主题酒店。"}, {"type": "subtitle", "time": 15608.189, "timestamp": "04:20:08", "text": "所以我的意思是，你会习惯的。"}, {"type": "subtitle", "time": 15611.51, "timestamp": "04:20:11", "text": "最终。但如果你留下来，还是会感觉很舒服。"}, {"type": "subtitle", "time": 15615.269, "timestamp": "04:20:15", "text": "在房间里待太久，你会有点……"}, {"type": "subtitle", "time": 15617.99, "timestamp": "04:20:17", "text": "开始失去理智。"}, {"type": "subtitle", "time": 15621.269, "timestamp": "04:20:21", "text": "我建议你到户外去。我是认真的"}, {"type": "subtitle", "time": 15622.91, "timestamp": "04:20:22", "text": "视情况而定。我"}, {"type": "subtitle", "time": 15627.51, "timestamp": "04:20:27", "text": "猜测取决于你是否等待。你是做"}, {"type": "subtitle", "time": 15629.75, "timestamp": "04:20:29", "text": "你更喜欢待在室内，或者"}, {"type": "subtitle", "time": 15632.87, "timestamp": "04:20:32", "text": "多进行户外活动？我喜欢待在室内。"}, {"type": "subtitle", "time": 15636.149, "timestamp": "04:20:36", "text": "更多的。那么你的意思是，那么……"}, {"type": "subtitle", "time": 15640.95, "timestamp": "04:20:40", "text": "情况略有恶化。好的。哦，不。"}, {"type": "subtitle", "time": 15643.429, "timestamp": "04:20:43", "text": "呃，你大概没事吧。可能是"}, {"type": "subtitle", "time": 15645.99, "timestamp": "04:20:45", "text": "好的。我认为"}, {"type": "subtitle", "time": 15650.309, "timestamp": "04:20:50", "text": "我肯定会像……嗯……我会……"}, {"type": "subtitle", "time": 15652.63, "timestamp": "04:20:52", "text": "大约一周后，当我"}, {"type": "subtitle", "time": 15656.229, "timestamp": "04:20:56", "text": "弄台笔记本电脑，或者如果我尝试直播"}, {"type": "subtitle", "time": 15659.229, "timestamp": "04:20:59", "text": "呃，我会通过手机或其他方式联系上我。"}]
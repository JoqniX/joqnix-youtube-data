[{"type": "subtitle", "time": 301.39, "timestamp": "00:05:01", "text": "是的，我希望如此。"}, {"type": "subtitle", "time": 304.189, "timestamp": "00:05:04", "text": "好的。那呃，让我"}, {"type": "subtitle", "time": 307.749, "timestamp": "00:05:07", "text": "嗯，把ID放到这个流里，这样你"}, {"type": "subtitle", "time": 308.99, "timestamp": "00:05:08", "text": "男生可以"}, {"type": "subtitle", "time": 312.15, "timestamp": "00:05:12", "text": "控制，你管它叫什么？控制"}, {"type": "subtitle", "time": 316.23, "timestamp": "00:05:16", "text": "命令之类的。所以让我把所有"}, {"type": "subtitle", "time": 318.55, "timestamp": "00:05:18", "text": "已经完成的事情。我想实现自动化。"}, {"type": "subtitle", "time": 320.31, "timestamp": "00:05:20", "text": "但我不知道这是否有可能"}, {"type": "subtitle", "time": 323.43, "timestamp": "00:05:23", "text": "实现自动化。所以这就是我为什么会这样想的原因……"}, {"type": "subtitle", "time": 328.07, "timestamp": "00:05:28", "text": "不做。但是，你知道的。"}, {"type": "subtitle", "time": 330.99, "timestamp": "00:05:30", "text": "话虽如此，让我开始吧。"}, {"type": "subtitle", "time": 334.51, "timestamp": "00:05:34", "text": "游戏。检查"}, {"type": "subtitle", "time": 339.15, "timestamp": "00:05:39", "text": "模。让我切换到个人资料"}, {"type": "subtitle", "time": 341.909, "timestamp": "00:05:41", "text": "出色地。我喜欢我目前的游戏方式。"}, {"type": "subtitle", "time": 344.07, "timestamp": "00:05:44", "text": "Valerant，我还没换过我的"}, {"type": "subtitle", "time": 357.67, "timestamp": "00:05:57", "text": "守望先锋。等等，我想起来我确实有"}]
[{"type": "subtitle", "time": 15663.59, "timestamp": "04:21:03", "text": "我好像想回家。这真是太"}, {"type": "subtitle", "time": 15670.07, "timestamp": "04:21:10", "text": "我会有那种感觉，我能感觉到。我"}, {"type": "subtitle", "time": 15672.309, "timestamp": "04:21:12", "text": "能感觉到。"}, {"type": "subtitle", "time": 15675.03, "timestamp": "04:21:15", "text": "我能感觉到。那就是那张脸"}, {"type": "subtitle", "time": 15679.03, "timestamp": "04:21:19", "text": "有时会过来。"}, {"type": "subtitle", "time": 15681.269, "timestamp": "04:21:21", "text": "是的，我觉得我以前感觉就像"}, {"type": "subtitle", "time": 15683.11, "timestamp": "04:21:23", "text": "有时候，你知道，当我第一次"}, {"type": "subtitle", "time": 15686.71, "timestamp": "04:21:26", "text": "我在这里待了大概两个月，我可以"}, {"type": "subtitle", "time": 15691.71, "timestamp": "04:21:31", "text": "感觉不像是在日本。喜欢"}, {"type": "subtitle", "time": 15694.75, "timestamp": "04:21:34", "text": "我当时主要想的是"}, {"type": "subtitle", "time": 15698.11, "timestamp": "04:21:38", "text": "就像我平常的日常生活一样"}, {"type": "subtitle", "time": 15702.55, "timestamp": "04:21:42", "text": "我以前的日常习惯让我感觉非常奇怪"}, {"type": "subtitle", "time": 15706.229, "timestamp": "04:21:46", "text": "感觉格格不入，有点像，不是我"}, {"type": "subtitle", "time": 15709.51, "timestamp": "04:21:49", "text": "跟这里实际情况不一样，这一切都只是"}, {"type": "subtitle", "time": 15711.87, "timestamp": "04:21:51", "text": "一个梦"}, {"type": "subtitle", "time": 15715.229, "timestamp": "04:21:55", "text": "但我有点明白了"}, {"type": "subtitle", "time": 15717.79, "timestamp": "04:21:57", "text": "就像我"}]
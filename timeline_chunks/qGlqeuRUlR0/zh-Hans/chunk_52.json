[{"type": "subtitle", "time": 3121.95, "timestamp": "00:52:01", "text": "啊，来自"}, {"type": "subtitle", "time": 3125.43, "timestamp": "00:52:05", "text": "在后面。所以，呃，我们完成了"}, {"type": "subtitle", "time": 3128.15, "timestamp": "00:52:08", "text": "接住雪球，还有"}, {"type": "subtitle", "time": 3131.109, "timestamp": "00:52:11", "text": "赢得这场比赛，这"}, {"type": "subtitle", "time": 3134.349, "timestamp": "00:52:14", "text": "这种模式。所以，我们需要一个"}, {"type": "subtitle", "time": 3137.589, "timestamp": "00:52:17", "text": "堵塞。呃，我想还需要四个雪球。"}, {"type": "subtitle", "time": 3141.19, "timestamp": "00:52:21", "text": "对，靠墙。啊，它死了。"}, {"type": "subtitle", "time": 3143.91, "timestamp": "00:52:23", "text": "没关系。我们试图阻挡这堵墙。"}, {"type": "subtitle", "time": 3146.589, "timestamp": "00:52:26", "text": "我们试图让人们"}, {"type": "subtitle", "time": 3152.99, "timestamp": "00:52:32", "text": "[音乐]"}, {"type": "subtitle", "time": 3166.109, "timestamp": "00:52:46", "text": "看着我。看着我。看"}, {"type": "subtitle", "time": 3175.03, "timestamp": "00:52:55", "text": "墙。啊，他们，他们都开枪了"}]
[{"type": "subtitle", "time": 13104.07, "timestamp": "03:38:24", "text": "好的。我不想用长短不一的语言。"}, {"type": "subtitle", "time": 13111.03, "timestamp": "03:38:31", "text": "又是那玩意儿。又是那只狗狗。为什么"}, {"type": "subtitle", "time": 13113.07, "timestamp": "03:38:33", "text": "我是谁？"}, {"type": "subtitle", "time": 13116.07, "timestamp": "03:38:36", "text": "不是狗狗吗？好的，我得加倍。"}, {"type": "subtitle", "time": 13136.03, "timestamp": "03:38:56", "text": "快点。"}]
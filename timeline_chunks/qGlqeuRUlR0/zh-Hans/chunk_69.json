[{"type": "subtitle", "time": 4148.669, "timestamp": "01:09:08", "text": "烧焦了。我们开始吧"}, {"type": "subtitle", "time": 4152.55, "timestamp": "01:09:12", "text": "去。他们得到了一个。"}, {"type": "subtitle", "time": 4164.43, "timestamp": "01:09:24", "text": "所以你只能得到一个"}, {"type": "subtitle", "time": 4167.99, "timestamp": "01:09:27", "text": "子弹，你可以从雪中补充弹药。"}, {"type": "subtitle", "time": 4169.87, "timestamp": "01:09:29", "text": "堆积"}]
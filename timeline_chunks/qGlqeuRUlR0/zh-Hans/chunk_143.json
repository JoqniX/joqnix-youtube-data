[{"type": "subtitle", "time": 8582.15, "timestamp": "02:23:02", "text": "做。我需要做的主要事情之一。"}, {"type": "subtitle", "time": 8591.19, "timestamp": "02:23:11", "text": "安息日。好了，我这就把那场比赛打完。"}, {"type": "subtitle", "time": 8594.07, "timestamp": "02:23:14", "text": "在此之前，让我先找到我的……"}, {"type": "subtitle", "time": 8596.389, "timestamp": "02:23:16", "text": "炸弹什么的。所以，我还会回来的。"}, {"type": "subtitle", "time": 8600.07, "timestamp": "02:23:20", "text": "一点。呃，很抱歉我又犯了同样的错误。"}, {"type": "subtitle", "time": 8607.51, "timestamp": "02:23:27", "text": "但是，但是我会回来的。好了，我热了"}, {"type": "subtitle", "time": 8610.07, "timestamp": "02:23:30", "text": "水。我把所有东西都加满了。我是"}, {"type": "subtitle", "time": 8613.51, "timestamp": "02:23:33", "text": "我睡在楼上。我的闹钟响了"}, {"type": "subtitle", "time": 8618.03, "timestamp": "02:23:38", "text": "早上5点或6点准备好。"}, {"type": "subtitle", "time": 8622.67, "timestamp": "02:23:42", "text": "嗯，我们准时在中午12点睡觉。"}, {"type": "subtitle", "time": 8626.87, "timestamp": "02:23:46", "text": "上午。好的。呃，我们晚上12点准时睡觉。"}, {"type": "subtitle", "time": 8629.99, "timestamp": "02:23:49", "text": "我们早上五六点起床。好的。是"}, {"type": "subtitle", "time": 8631.99, "timestamp": "02:23:51", "text": "去做锻炼什么的"}, {"type": "subtitle", "time": 8635.15, "timestamp": "02:23:55", "text": "我们开始直播。好的。"}, {"type": "subtitle", "time": 8638.55, "timestamp": "02:23:58", "text": "你好。嗯，是的。"}]
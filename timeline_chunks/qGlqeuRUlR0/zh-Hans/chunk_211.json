[{"type": "subtitle", "time": 12695.63, "timestamp": "03:31:35", "text": "啊，我走了。"}, {"type": "subtitle", "time": 12704.309, "timestamp": "03:31:44", "text": "[音乐]"}, {"type": "subtitle", "time": 12706.87, "timestamp": "03:31:46", "text": "好的。我是如何像约翰一样躲过子弹的？"}, {"type": "subtitle", "time": 12708.349, "timestamp": "03:31:48", "text": "又是维克？我"}, {"type": "subtitle", "time": 12712.71, "timestamp": "03:31:52", "text": "我都忘了我就是约翰·威克了。疾速追杀博士。"}]
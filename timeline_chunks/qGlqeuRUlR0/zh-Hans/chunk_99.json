[{"type": "subtitle", "time": 5940.109, "timestamp": "01:39:00", "text": "霰弹枪"}, {"type": "subtitle", "time": 5982.31, "timestamp": "01:39:42", "text": "我想说，请帮帮我们。请"}, {"type": "subtitle", "time": 5984.149, "timestamp": "01:39:44", "text": "帮助。"}, {"type": "subtitle", "time": 5986.31, "timestamp": "01:39:46", "text": "哦，这是个新英雄。好的，我来测试一下。"}, {"type": "subtitle", "time": 5993.35, "timestamp": "01:39:53", "text": "然后。哦，这位英雄出来观看了。"}, {"type": "subtitle", "time": 5994.51, "timestamp": "01:39:54", "text": "也。"}]
[{"type": "subtitle", "time": 16500.47, "timestamp": "04:35:00", "text": "然后坐在袋子上，然后关上了袋子。"}, {"type": "subtitle", "time": 16507.869, "timestamp": "04:35:07", "text": "是的，但是我的行李有点……"}, {"type": "subtitle", "time": 16512.949, "timestamp": "04:35:12", "text": "那时他已经超重了。哦，不。但是呃"}, {"type": "subtitle", "time": 16516.07, "timestamp": "04:35:16", "text": "你的航空公司怎么样？你有我吗？"}, {"type": "subtitle", "time": 16518.869, "timestamp": "04:35:18", "text": "对此我并不了解。我不，我不"}, {"type": "subtitle", "time": 16521.59, "timestamp": "04:35:21", "text": "目前还没有相关信息，因为"}, {"type": "subtitle", "time": 16524.789, "timestamp": "04:35:24", "text": "学院人员在获得 COE 后"}, {"type": "subtitle", "time": 16528.15, "timestamp": "04:35:28", "text": "从日本，然后他们会在之后……"}, {"type": "subtitle", "time": 16530.709, "timestamp": "04:35:30", "text": "需要查找航班并预订。"}, {"type": "subtitle", "time": 16533.429, "timestamp": "04:35:33", "text": "只有到那时我才能获得详细信息。"}, {"type": "subtitle", "time": 16545.189, "timestamp": "04:35:45", "text": "我觉得你得看看……"}, {"type": "subtitle", "time": 16548.869, "timestamp": "04:35:48", "text": "呃，航空公司网站。"}, {"type": "subtitle", "time": 16552.07, "timestamp": "04:35:52", "text": "他们什么都有，比如关于……"}, {"type": "subtitle", "time": 16555.59, "timestamp": "04:35:55", "text": "随身行李和托运行李"}, {"type": "subtitle", "time": 16557.51, "timestamp": "04:35:57", "text": "比如你能带来什么，你不能带来什么"}]
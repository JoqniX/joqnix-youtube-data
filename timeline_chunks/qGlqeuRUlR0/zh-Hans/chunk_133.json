[{"type": "subtitle", "time": 7993.27, "timestamp": "02:13:13", "text": "我只需要这种二极管，随便一个就行。"}, {"type": "subtitle", "time": 7995.99, "timestamp": "02:13:15", "text": "至少其中之一，当一款游戏尚未……"}, {"type": "subtitle", "time": 8000.629, "timestamp": "02:13:20", "text": "或者像五月或雪人那样，这就是我全部的请求。"}, {"type": "subtitle", "time": 8002.43, "timestamp": "02:13:22", "text": "我喜欢你"}, {"type": "subtitle", "time": 8005.03, "timestamp": "02:13:25", "text": "知道了，拿到皮肤就完事了。"}, {"type": "subtitle", "time": 8006.109, "timestamp": "02:13:26", "text": "这"}, {"type": "subtitle", "time": 8008.109, "timestamp": "02:13:28", "text": "天。"}, {"type": "subtitle", "time": 8010.75, "timestamp": "02:13:30", "text": "耶。真麻烦"}, {"type": "subtitle", "time": 8018.629, "timestamp": "02:13:38", "text": "游戏。那我来扮演雪人吧。我需要我"}, {"type": "subtitle", "time": 8020.709, "timestamp": "02:13:40", "text": "我从没玩过温斯顿，所以我不知道"}, {"type": "subtitle", "time": 8023.35, "timestamp": "02:13:43", "text": "我应该怎么做，以及所有的一切"}, {"type": "subtitle", "time": 8025.99, "timestamp": "02:13:45", "text": "我应该做什么。那就是"}, {"type": "subtitle", "time": 8028.589, "timestamp": "02:13:48", "text": "我的理由"}, {"type": "subtitle", "time": 8032.31, "timestamp": "02:13:52", "text": "猜猜是枫树。哦，我变成M了。等等，"}]
[{"type": "subtitle", "time": 19680.39, "timestamp": "05:28:00", "text": "最终意味着就像那些人一样"}, {"type": "subtitle", "time": 19683.11, "timestamp": "05:28:03", "text": "把你当成真正的朋友"}, {"type": "subtitle", "time": 19685.99, "timestamp": "05:28:05", "text": "朋友会一直陪着你，无论发生什么"}, {"type": "subtitle", "time": 19690.47, "timestamp": "05:28:10", "text": "什么。真的。还有像……这样的人"}, {"type": "subtitle", "time": 19693.83, "timestamp": "05:28:13", "text": "其他人只是为了……而来"}, {"type": "subtitle", "time": 19697.51, "timestamp": "05:28:17", "text": "就像他们自己的兴趣一样"}, {"type": "subtitle", "time": 19699.628, "timestamp": "05:28:19", "text": "类似他们自己的"}, {"type": "subtitle", "time": 19703.11, "timestamp": "05:28:23", "text": "收益。他们到时候就会离开。"}, {"type": "subtitle", "time": 19706.15, "timestamp": "05:28:26", "text": "该离开了。他们想离开。"}, {"type": "subtitle", "time": 19707.23, "timestamp": "05:28:27", "text": "他们会"}, {"type": "subtitle", "time": 19712.35, "timestamp": "05:28:32", "text": "居住。但就像不要"}, {"type": "subtitle", "time": 19714.59, "timestamp": "05:28:34", "text": "就像"}, {"type": "subtitle", "time": 19719.11, "timestamp": "05:28:39", "text": "我也不知道该怎么说，但是"}, {"type": "subtitle", "time": 19722.948, "timestamp": "05:28:42", "text": "比如，让它把你击垮。是的。只是"}, {"type": "subtitle", "time": 19724.868, "timestamp": "05:28:44", "text": "照顾那些和你有相似经历的人"}, {"type": "subtitle", "time": 19727.59, "timestamp": "05:28:47", "text": "和你很亲近，就像真的和你很亲近一样"}, {"type": "subtitle", "time": 19732.23, "timestamp": "05:28:52", "text": "你。所以，我觉得应该没问题。"}, {"type": "subtitle", "time": 19737.27, "timestamp": "05:28:57", "text": "你会看到谁才是真正的人"}]
[{"type": "subtitle", "time": 5725.03, "timestamp": "01:35:25", "text": "啊，他们都出汗了。是的，他们是"}, {"type": "subtitle", "time": 5726.27, "timestamp": "01:35:26", "text": "正因如此"}, {"type": "subtitle", "time": 5745.43, "timestamp": "01:35:45", "text": "基科。哦，这皮肤。罗伯·基里科"}, {"type": "subtitle", "time": 5747.68, "timestamp": "01:35:47", "text": "皮肤。这很酷"}, {"type": "subtitle", "time": 5749.55, "timestamp": "01:35:49", "text": "[音乐]"}, {"type": "subtitle", "time": 5754.73, "timestamp": "01:35:54", "text": "尽管。还是我该离开游戏圈？"}]
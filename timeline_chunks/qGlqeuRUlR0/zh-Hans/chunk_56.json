[{"type": "subtitle", "time": 3387.349, "timestamp": "00:56:27", "text": "我接受挑战了吗？我收到吗？"}, {"type": "subtitle", "time": 3388.87, "timestamp": "00:56:28", "text": "挑战？"}, {"type": "subtitle", "time": 3401.349, "timestamp": "00:56:41", "text": "不，我甚至都没用我的终极技能。它是"}, {"type": "subtitle", "time": 3402.829, "timestamp": "00:56:42", "text": "美好的"}, {"type": "subtitle", "time": 3405.51, "timestamp": "00:56:45", "text": "尽管。我获得了代言。某人"}, {"type": "subtitle", "time": 3410.71, "timestamp": "00:56:50", "text": "他认可了我。谢谢。"}]
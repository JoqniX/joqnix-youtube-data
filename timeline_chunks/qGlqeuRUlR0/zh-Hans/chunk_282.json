[{"type": "subtitle", "time": 16920.31, "timestamp": "04:42:00", "text": "我搬到这里就是因为喜欢你们这座城市。"}, {"type": "subtitle", "time": 16922.59, "timestamp": "04:42:02", "text": "他们会指导你完成……"}, {"type": "subtitle", "time": 16926.07, "timestamp": "04:42:06", "text": "按照流程操作，你就会知道他们是否喜欢。"}, {"type": "subtitle", "time": 16929.99, "timestamp": "04:42:09", "text": "你告诉他们，是的，我想他们会说话"}, {"type": "subtitle", "time": 16932.31, "timestamp": "04:42:12", "text": "英语和表格也都是用英语写的。"}, {"type": "subtitle", "time": 16934.628, "timestamp": "04:42:14", "text": "英语所以"}, {"type": "subtitle", "time": 16937.19, "timestamp": "04:42:17", "text": "你会没事的。我觉得你只需要……"}, {"type": "subtitle", "time": 16940.708, "timestamp": "04:42:20", "text": "填写一些信息，然后他们"}, {"type": "subtitle", "time": 16943.27, "timestamp": "04:42:23", "text": "比如给你提供医疗保险"}, {"type": "subtitle", "time": 16946.31, "timestamp": "04:42:26", "text": "他们还会把你的地址印在背面。"}, {"type": "subtitle", "time": 16948.19, "timestamp": "04:42:28", "text": "您的居民"}, {"type": "subtitle", "time": 16952.23, "timestamp": "04:42:32", "text": "卡片就够了。大概需要30分钟"}, {"type": "subtitle", "time": 16953.99, "timestamp": "04:42:33", "text": "分钟。我要学习如何写作"}, {"type": "subtitle", "time": 16957.39, "timestamp": "04:42:37", "text": "是日本地址，对吧？"}, {"type": "subtitle", "time": 16962.67, "timestamp": "04:42:42", "text": "嗯，或许你会没事的。我觉得像"}, {"type": "subtitle", "time": 16966.628, "timestamp": "04:42:46", "text": "如果是的话，我想他们会……哦，是的。我 我"}, {"type": "subtitle", "time": 16970.39, "timestamp": "04:42:50", "text": "他们认为他们使用平假名。嗯，不，不是。"}, {"type": "subtitle", "time": 16975.03, "timestamp": "04:42:55", "text": "平假名。嗯，罗马。就像你只是"}, {"type": "subtitle", "time": 16978.15, "timestamp": "04:42:58", "text": "用朗姆酒写，就没事了。就像在"}]
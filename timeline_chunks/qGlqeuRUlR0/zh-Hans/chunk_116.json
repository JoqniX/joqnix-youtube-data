[{"type": "subtitle", "time": 6973.47, "timestamp": "01:56:13", "text": "未来。他拿到了肉。他得到了"}, {"type": "subtitle", "time": 6976.35, "timestamp": "01:56:16", "text": "肉。"}, {"type": "subtitle", "time": 6979.669, "timestamp": "01:56:19", "text": "为什么？我的天啊。他拿到了肉。什么？"}, {"type": "subtitle", "time": 7014.95, "timestamp": "01:56:54", "text": "[音乐]"}, {"type": "subtitle", "time": 7018.07, "timestamp": "01:56:58", "text": "所以这些食物我觉得对你没问题，是的。"}]
[{"type": "subtitle", "time": 6243.669, "timestamp": "01:44:03", "text": "我。该死。哦。哦。哦。艾米在里面。"}, {"type": "subtitle", "time": 6246.629, "timestamp": "01:44:06", "text": "好的。呃，你们还想再去一次吗？还是我们应该……"}, {"type": "subtitle", "time": 6248.59, "timestamp": "01:44:08", "text": "做点别的吗？我们赢了一场比赛。"}, {"type": "subtitle", "time": 6253.31, "timestamp": "01:44:13", "text": "正确的？真的吗？我们赢了。或者说"}, {"type": "subtitle", "time": 6256.27, "timestamp": "01:44:16", "text": "我们？因为我们正在为这次活动努力备战。"}, {"type": "subtitle", "time": 6259.629, "timestamp": "01:44:19", "text": "正确的？我们可以做雪人"}, {"type": "subtitle", "time": 6263.55, "timestamp": "01:44:23", "text": "猎人。你想做什么都可以。"}, {"type": "subtitle", "time": 6266.03, "timestamp": "01:44:26", "text": "你好。呃，雪人"}, {"type": "subtitle", "time": 6269.79, "timestamp": "01:44:29", "text": "本田，你想进来吗？"}, {"type": "subtitle", "time": 6271.87, "timestamp": "01:44:31", "text": "或者你想"}, {"type": "subtitle", "time": 6275.99, "timestamp": "01:44:35", "text": "到？所以，我需要像五月或雪人那样去"}, {"type": "subtitle", "time": 6279.79, "timestamp": "01:44:39", "text": "把东西拿来。好的，我们走吧"}, {"type": "subtitle", "time": 6286.03, "timestamp": "01:44:46", "text": "我。"}, {"type": "subtitle", "time": 6289.31, "timestamp": "01:44:49", "text": "如果……就更好了"}]
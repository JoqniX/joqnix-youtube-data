[{"type": "subtitle", "time": 20942.03, "timestamp": "05:49:02", "text": "服务之类的，但就像……"}, {"type": "subtitle", "time": 20947.03, "timestamp": "05:49:07", "text": "朋友或像同事一样"}, {"type": "subtitle", "time": 20949.548, "timestamp": "05:49:09", "text": "人们确实会跟你说话。"}, {"type": "subtitle", "time": 20952.948, "timestamp": "05:49:12", "text": "他们有时他们他们"}, {"type": "subtitle", "time": 20954.43, "timestamp": "05:49:14", "text": "有时会得到"}, {"type": "subtitle", "time": 20955.948, "timestamp": "05:49:15", "text": "惊讶"}, {"type": "subtitle", "time": 20960.27, "timestamp": "05:49:20", "text": "但它和日语不太像。"}, {"type": "subtitle", "time": 20963.59, "timestamp": "05:49:23", "text": "或者类似"}, {"type": "subtitle", "time": 20966.11, "timestamp": "05:49:26", "text": "你会日语，"}, {"type": "subtitle", "time": 20969.91, "timestamp": "05:49:29", "text": "就像你在YouTube上看到的那样。"}, {"type": "subtitle", "time": 20973.03, "timestamp": "05:49:33", "text": "嗯。比如在机场那样"}, {"type": "subtitle", "time": 20976.15, "timestamp": "05:49:36", "text": "你会说一些日语，嗯。"}, {"type": "subtitle", "time": 20980.23, "timestamp": "05:49:40", "text": "移民局或海关之类的官员，"}, {"type": "subtitle", "time": 20994.548, "timestamp": "05:49:54", "text": "你就像一两次……"}, {"type": "subtitle", "time": 20998.31, "timestamp": "05:49:58", "text": "嗯，就像我去买我的全新"}]
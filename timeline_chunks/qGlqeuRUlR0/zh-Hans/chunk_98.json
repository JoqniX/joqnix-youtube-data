[{"type": "subtitle", "time": 5916.07, "timestamp": "01:38:36", "text": "好了，我们走吧。我们将开始"}, {"type": "subtitle", "time": 5919.109, "timestamp": "01:38:39", "text": "真实的。好的，那我选阿什。我"}, {"type": "subtitle", "time": 5920.109, "timestamp": "01:38:40", "text": "爱"}, {"type": "subtitle", "time": 5924.149, "timestamp": "01:38:44", "text": "灰。持枪女士。我喜欢你知道为什么"}, {"type": "subtitle", "time": 5927.43, "timestamp": "01:38:47", "text": "我喜欢阿什？因为头发。白发"}, {"type": "subtitle", "time": 5931.43, "timestamp": "01:38:51", "text": "像我这样的。我喜欢白头发。短途旅行。"}, {"type": "subtitle", "time": 5933.149, "timestamp": "01:38:53", "text": "手枪真是太"}]
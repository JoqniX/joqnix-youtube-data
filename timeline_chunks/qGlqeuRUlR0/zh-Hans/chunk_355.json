[{"type": "subtitle", "time": 21301.51, "timestamp": "05:55:01", "text": "就像那些卖印度菜的商店一样"}, {"type": "subtitle", "time": 21304.948, "timestamp": "05:55:04", "text": "巴基斯坦人喜欢食物和食材"}, {"type": "subtitle", "time": 21307.99, "timestamp": "05:55:07", "text": "还有零食，你可能会找到一些东西。"}, {"type": "subtitle", "time": 21311.15, "timestamp": "05:55:11", "text": "那边也是。"}, {"type": "subtitle", "time": 21314.39, "timestamp": "05:55:14", "text": "哦，是的，我想你会没事的。"}, {"type": "subtitle", "time": 21317.51, "timestamp": "05:55:17", "text": "就像在东京那样，尤其像你可以……"}, {"type": "subtitle", "time": 21321.19, "timestamp": "05:55:21", "text": "像在餐厅一样，可以找到很多食物"}, {"type": "subtitle", "time": 21323.83, "timestamp": "05:55:23", "text": "以及杂货店。"}, {"type": "subtitle", "time": 21327.19, "timestamp": "05:55:27", "text": "你会没事的。哦"}, {"type": "subtitle", "time": 21330.31, "timestamp": "05:55:30", "text": "是的。你也可以点赞并获得点赞"}, {"type": "subtitle", "time": 21334.39, "timestamp": "05:55:34", "text": "印度或巴基斯坦的大米也可以。"}, {"type": "subtitle", "time": 21336.868, "timestamp": "05:55:36", "text": "它们的价格差不多，而且"}, {"type": "subtitle", "time": 21338.948, "timestamp": "05:55:38", "text": "有些情况，比如日本大米，则更为常见。"}, {"type": "subtitle", "time": 21341.23, "timestamp": "05:55:41", "text": "昂贵的。"}, {"type": "subtitle", "time": 21345.91, "timestamp": "05:55:45", "text": "所以，记住这一点。我喜欢"}, {"type": "subtitle", "time": 21349.51, "timestamp": "05:55:49", "text": "唉，喝酒吧。欢迎来到“我喜欢”"}, {"type": "subtitle", "time": 21353.548, "timestamp": "05:55:53", "text": "喝呃呃"}, {"type": "subtitle", "time": 21357.75, "timestamp": "05:55:57", "text": "酪乳。这里的黄油就像"}]
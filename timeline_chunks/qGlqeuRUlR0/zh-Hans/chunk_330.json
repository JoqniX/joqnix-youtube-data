[{"type": "subtitle", "time": 19801.43, "timestamp": "05:30:01", "text": "在我的一生中，我喜欢我，呃，站立"}, {"type": "subtitle", "time": 19804.15, "timestamp": "05:30:04", "text": "振作起来，没有哭。"}, {"type": "subtitle", "time": 19807.35, "timestamp": "05:30:07", "text": "求他们，求他们喜欢我，让我成为他们的"}, {"type": "subtitle", "time": 19810.39, "timestamp": "05:30:10", "text": "又成了朋友之类的。我只是"}, {"type": "subtitle", "time": 19812.708, "timestamp": "05:30:12", "text": "比如，“是啊，你不尊重我”"}, {"type": "subtitle", "time": 19815.27, "timestamp": "05:30:15", "text": "界限以及一切的一切"}, {"type": "subtitle", "time": 19817.15, "timestamp": "05:30:17", "text": "也可以试试"}, {"type": "subtitle", "time": 19821.11, "timestamp": "05:30:21", "text": "攻击我自己的爱好和"}, {"type": "subtitle", "time": 19823.99, "timestamp": "05:30:23", "text": "社区等等，但也要尝试"}, {"type": "subtitle", "time": 19826.708, "timestamp": "05:30:26", "text": "“把我所有信息都曝光了。”所以，我就想，"}, {"type": "subtitle", "time": 19829.43, "timestamp": "05:30:29", "text": "我要彻底和你断绝关系。"}, {"type": "subtitle", "time": 19831.75, "timestamp": "05:30:31", "text": "那真是一场戏剧，就像他们来了一样。"}, {"type": "subtitle", "time": 19834.548, "timestamp": "05:30:34", "text": "到我家来，还朝我家扔石头"}, {"type": "subtitle", "time": 19837.868, "timestamp": "05:30:37", "text": "呃，窗户之类的东西。当时仍然"}, {"type": "subtitle", "time": 19852.868, "timestamp": "05:30:52", "text": "自从我决定不再说之后，我就一直这样。"}, {"type": "subtitle", "time": 19855.75, "timestamp": "05:30:55", "text": "不再和任何朋友来往。"}, {"type": "subtitle", "time": 19859.15, "timestamp": "05:30:59", "text": "我真是太笨了。我明白了。我明白了。"}]
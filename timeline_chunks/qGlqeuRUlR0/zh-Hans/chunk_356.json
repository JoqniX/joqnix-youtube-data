[{"type": "subtitle", "time": 21360.99, "timestamp": "05:56:00", "text": "因为我来自南方，所以现在觉得有点辣。"}, {"type": "subtitle", "time": 21365.03, "timestamp": "05:56:05", "text": "所以，我看看有没有"}, {"type": "subtitle", "time": 21367.27, "timestamp": "05:56:07", "text": "日本也有类似的情况，而且是"}, {"type": "subtitle", "time": 21371.51, "timestamp": "05:56:11", "text": "像粉末状的。我当时就想，为什么会这样？"}, {"type": "subtitle", "time": 21373.43, "timestamp": "05:56:13", "text": "粉末状的？"}, {"type": "subtitle", "time": 21376.788, "timestamp": "05:56:16", "text": "脱脂奶粉。是的，你会有"}, {"type": "subtitle", "time": 21380.788, "timestamp": "05:56:20", "text": "自己动手做。我认为"}, {"type": "subtitle", "time": 21382.868, "timestamp": "05:56:22", "text": "再见。"}, {"type": "subtitle", "time": 21386.708, "timestamp": "05:56:26", "text": "你可以找到各种各样的拉西。"}, {"type": "subtitle", "time": 21391.27, "timestamp": "05:56:31", "text": "那东西没味道。哦，是的。我是说"}, {"type": "subtitle", "time": 21393.948, "timestamp": "05:56:33", "text": "它看起来有点像酸奶"}, {"type": "subtitle", "time": 21395.47, "timestamp": "05:56:35", "text": "饮料"}, {"type": "subtitle", "time": 21399.59, "timestamp": "05:56:39", "text": "就像我的印度朋友一样，"}, {"type": "subtitle", "time": 21403.91, "timestamp": "05:56:43", "text": "工作。他们喜欢喝酸奶之类的饮料"}, {"type": "subtitle", "time": 21407.67, "timestamp": "05:56:47", "text": "这里可以喝点东西。我本人从未拥有过。"}, {"type": "subtitle", "time": 21409.628, "timestamp": "05:56:49", "text": "但他们喜欢"}, {"type": "subtitle", "time": 21412.99, "timestamp": "05:56:52", "text": "它。而我"}, {"type": "subtitle", "time": 21415.83, "timestamp": "05:56:55", "text": "想想你能做的绝大多数事情"}, {"type": "subtitle", "time": 21418.15, "timestamp": "05:56:58", "text": "请点击此处查找。你只需要做出你的"}]
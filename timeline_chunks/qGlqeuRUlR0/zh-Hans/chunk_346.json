[{"type": "subtitle", "time": 20761.43, "timestamp": "05:46:01", "text": "现在大概有5000人了。所以，既然我还在做我的"}, {"type": "subtitle", "time": 20764.868, "timestamp": "05:46:04", "text": "这里仍然有正常的24小时直播。"}, {"type": "subtitle", "time": 20766.948, "timestamp": "05:46:06", "text": "数了一点，一点点"}, {"type": "subtitle", "time": 20770.23, "timestamp": "05:46:10", "text": "一点。所以这对我仍然很有帮助。"}, {"type": "subtitle", "time": 20773.27, "timestamp": "05:46:13", "text": "呃，别让它掉下来。所以当我击中"}, {"type": "subtitle", "time": 20777.19, "timestamp": "05:46:17", "text": "一千个关注者，没有订阅者"}, {"type": "subtitle", "time": 20779.75, "timestamp": "05:46:19", "text": "那帮我解锁了那个东西。"}, {"type": "subtitle", "time": 20782.39, "timestamp": "05:46:22", "text": "我当时想，“哦，它又要回去了。”"}, {"type": "subtitle", "time": 20785.628, "timestamp": "05:46:25", "text": "我将无法获得最后一个"}, {"type": "subtitle", "time": 20788.47, "timestamp": "05:46:28", "text": "一个。”但我很高兴我能得到"}, {"type": "subtitle", "time": 20789.47, "timestamp": "05:46:29", "text": "最后的"}, {"type": "subtitle", "time": 20794.23, "timestamp": "05:46:34", "text": "一。所以，这会非常困难。不，"}, {"type": "subtitle", "time": 20798.43, "timestamp": "05:46:38", "text": "就像再次这样，这花费了太多时间"}, {"type": "subtitle", "time": 20802.788, "timestamp": "05:46:42", "text": "精神状态就像直播时的状态一样"}, {"type": "subtitle", "time": 20806.39, "timestamp": "05:46:46", "text": "等等等等。还有，事实上我"}, {"type": "subtitle", "time": 20808.788, "timestamp": "05:46:48", "text": "我七个星期都没关电脑。"}, {"type": "subtitle", "time": 20812.868, "timestamp": "05:46:52", "text": "七天或更长时间内发生这么多事简直太疯狂了。"}, {"type": "subtitle", "time": 20816.07, "timestamp": "05:46:56", "text": "我记得我最高纪录是14分。"}]
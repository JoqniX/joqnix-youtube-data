[{"type": "subtitle", "time": 19562.59, "timestamp": "05:26:02", "text": "截取我的直播片段，或者如果其中一个"}, {"type": "subtitle", "time": 19565.51, "timestamp": "05:26:05", "text": "代表们要查看这些，而我"}, {"type": "subtitle", "time": 19568.15, "timestamp": "05:26:08", "text": "剪下来，他们就会说：“是啊，你"}, {"type": "subtitle", "time": 19571.67, "timestamp": "05:26:11", "text": "你的驾照将被吊销，因为"}, {"type": "subtitle", "time": 19574.47, "timestamp": "05:26:14", "text": "你曾提到过这件事，甚至还违反了它。"}, {"type": "subtitle", "time": 19577.99, "timestamp": "05:26:17", "text": "我们的保密协议之类的。没有签署保密协议或"}, {"type": "subtitle", "time": 19579.75, "timestamp": "05:26:19", "text": "有什么进展吗？不过，是的，但仍然"}, {"type": "subtitle", "time": 19582.708, "timestamp": "05:26:22", "text": "双方同意。但是，是的，我"}, {"type": "subtitle", "time": 19584.708, "timestamp": "05:26:24", "text": "我不想那样。就是这样。"}, {"type": "subtitle", "time": 19586.55, "timestamp": "05:26:26", "text": "这"}, {"type": "subtitle", "time": 19592.15, "timestamp": "05:26:32", "text": "你得小心点。所以，所以"}, {"type": "subtitle", "time": 19595.59, "timestamp": "05:26:35", "text": "呃，得小心点。是的。是的。但"}, {"type": "subtitle", "time": 19596.51, "timestamp": "05:26:36", "text": "是的，"}, {"type": "subtitle", "time": 19599.47, "timestamp": "05:26:39", "text": "就像最终我感觉"}, {"type": "subtitle", "time": 19602.708, "timestamp": "05:26:42", "text": "我的情况真是太悲惨了。我不知道。"}, {"type": "subtitle", "time": 19606.15, "timestamp": "05:26:46", "text": "太令人沮丧了。我不知道。我"}, {"type": "subtitle", "time": 19609.11, "timestamp": "05:26:49", "text": "只希望没有人会经历这种事。"}, {"type": "subtitle", "time": 19612.948, "timestamp": "05:26:52", "text": "但我也觉得，一旦……"}, {"type": "subtitle", "time": 19615.23, "timestamp": "05:26:55", "text": "只要我能坚持下去，我就能度过这一天。"}, {"type": "subtitle", "time": 19618.31, "timestamp": "05:26:58", "text": "一切，还有出道等等。"}]
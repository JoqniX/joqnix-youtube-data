[{"type": "subtitle", "time": 4507.51, "timestamp": "01:15:07", "text": "[音乐]"}, {"type": "subtitle", "time": 4531.63, "timestamp": "01:15:31", "text": "上帝。想象一下你的"}, {"type": "subtitle", "time": 4534.51, "timestamp": "01:15:34", "text": "最好的。等待。哦，等等。谁有那个"}, {"type": "subtitle", "time": 4536.27, "timestamp": "01:15:36", "text": "头像？"}, {"type": "subtitle", "time": 4540.07, "timestamp": "01:15:40", "text": "啊。我的天啊。我被噎住了。把它烤熟。"}, {"type": "subtitle", "time": 4541.149, "timestamp": "01:15:41", "text": "哦"}, {"type": "subtitle", "time": 4544.79, "timestamp": "01:15:44", "text": "是的。我的意思是，这样也挺好的。我不"}, {"type": "subtitle", "time": 4546.669, "timestamp": "01:15:46", "text": "知道这样是否合适。我不是"}, {"type": "subtitle", "time": 4549.669, "timestamp": "01:15:49", "text": "自信的。我们进入了游戏。好的。我"}, {"type": "subtitle", "time": 4552.87, "timestamp": "01:15:52", "text": "需要一个喷子。巨魔又在干什么？"}, {"type": "subtitle", "time": 4555.27, "timestamp": "01:15:55", "text": "这个游戏？我不知道。他们都有"}, {"type": "subtitle", "time": 4557.27, "timestamp": "01:15:57", "text": "不同的武器。是的。每个英雄都有"}, {"type": "subtitle", "time": 4559.35, "timestamp": "01:15:59", "text": "就像《Valerant》里那样，武器也各不相同。"}]
[{"type": "subtitle", "time": 16082.349, "timestamp": "04:28:02", "text": "那可真不少。等等，真的吗？"}, {"type": "subtitle", "time": 16085.269, "timestamp": "04:28:05", "text": "哦，我死定了，伙计。我觉得我不能"}, {"type": "subtitle", "time": 16087.59, "timestamp": "04:28:07", "text": "今年首次亮相。我想我会"}, {"type": "subtitle", "time": 16090.149, "timestamp": "04:28:10", "text": "耗时四年才出道。我会保存"}, {"type": "subtitle", "time": 16098.59, "timestamp": "04:28:18", "text": "希望你能做到。"}, {"type": "subtitle", "time": 16102.03, "timestamp": "04:28:22", "text": "是的，的确如此。"}, {"type": "subtitle", "time": 16107.349, "timestamp": "04:28:27", "text": "难的。数量很多。是的，但是"}, {"type": "subtitle", "time": 16110.55, "timestamp": "04:28:30", "text": "什么？呃，10？等等，10000日元？"}, {"type": "subtitle", "time": 16113.429, "timestamp": "04:28:33", "text": "多少钱来着？"}, {"type": "subtitle", "time": 16115.229, "timestamp": "04:28:35", "text": "10,000。"}, {"type": "subtitle", "time": 16124.55, "timestamp": "04:28:44", "text": "哦，日常必需品怎么样了？"}, {"type": "subtitle", "time": 16126.95, "timestamp": "04:28:46", "text": "像洗发水之类的东西，还有……"}, {"type": "subtitle", "time": 16128.55, "timestamp": "04:28:48", "text": "你可以从那里买到它"}, {"type": "subtitle", "time": 16130.87, "timestamp": "04:28:50", "text": "便利店，对吧？"}, {"type": "subtitle", "time": 16135.269, "timestamp": "04:28:55", "text": "呃，你可以在便利店买到洗发水。"}, {"type": "subtitle", "time": 16139.229, "timestamp": "04:28:59", "text": "我想应该是商店。我主要就是卖东西。"}]
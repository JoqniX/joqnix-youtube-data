[{"type": "subtitle", "time": 240.869, "timestamp": "00:04:00", "text": "是的，板子也在上传。"}, {"type": "subtitle", "time": 243.03, "timestamp": "00:04:03", "text": "我会在月底之前公开它。"}, {"type": "subtitle", "time": 245.67, "timestamp": "00:04:05", "text": "溪流。所以如果你错过了，"}, {"type": "subtitle", "time": 247.99, "timestamp": "00:04:07", "text": "别担心，你还是可以看的。"}, {"type": "subtitle", "time": 252.149, "timestamp": "00:04:12", "text": "它。是的。嗯。让我关上"}, {"type": "subtitle", "time": 254.39, "timestamp": "00:04:14", "text": "那些东西。而且我也不知道你是否"}, {"type": "subtitle", "time": 256.87, "timestamp": "00:04:16", "text": "注意到推特横幅广告。你是什​​么"}, {"type": "subtitle", "time": 258.59, "timestamp": "00:04:18", "text": "想想推特"}, {"type": "subtitle", "time": 261.59, "timestamp": "00:04:21", "text": "横幅？等等，让我放大一下再点赞"}, {"type": "subtitle", "time": 267.27, "timestamp": "00:04:27", "text": "这。是的。是的。你们觉得怎么样？"}, {"type": "subtitle", "time": 269.909, "timestamp": "00:04:29", "text": "这是这条推特横幅吗？希望你们玩得开心。"}, {"type": "subtitle", "time": 272.469, "timestamp": "00:04:32", "text": "我希望这样可以。现在你们这些人"}, {"type": "subtitle", "time": 274.15, "timestamp": "00:04:34", "text": "我知道我认为这是最终的了。"}, {"type": "subtitle", "time": 277.629, "timestamp": "00:04:37", "text": "Twitter 横幅 1.0 版本。"}, {"type": "subtitle", "time": 280.55, "timestamp": "00:04:40", "text": "我们很喜欢我们想出的设计方案，"}, {"type": "subtitle", "time": 282.55, "timestamp": "00:04:42", "text": "Twitch 直播上的所有内容以及我们"}, {"type": "subtitle", "time": 284.95, "timestamp": "00:04:44", "text": "今天在 Twitch 上最终敲定了。"}, {"type": "subtitle", "time": 287.59000000000003, "timestamp": "00:04:47", "text": "溪流。是的，现在看起来是这样的。"}, {"type": "subtitle", "time": 289.67, "timestamp": "00:04:49", "text": "所以我不需要这个标题。"}, {"type": "subtitle", "time": 292.629, "timestamp": "00:04:52", "text": "这样我就能准时了。"}, {"type": "subtitle", "time": 295.71, "timestamp": "00:04:55", "text": "像今天这样直播。眨眼眨眼"}, {"type": "subtitle", "time": 298.95, "timestamp": "00:04:58", "text": "像这样眨眨眼。是的。是的。是的。所以"}]
[{"type": "subtitle", "time": 5281.669, "timestamp": "01:28:01", "text": "好的。阿卡比，过来一下。过来。"}, {"type": "subtitle", "time": 5283.07, "timestamp": "01:28:03", "text": "过来。过来。来"}, {"type": "subtitle", "time": 5286.55, "timestamp": "01:28:06", "text": "这里。阿比，快来快来。来戏弄我吧。"}, {"type": "subtitle", "time": 5300.07, "timestamp": "01:28:20", "text": "哦，有人长高了。"}, {"type": "subtitle", "time": 5302.31, "timestamp": "01:28:22", "text": "我去。我去。我去。我去。患病的"}, {"type": "subtitle", "time": 5304.68, "timestamp": "01:28:24", "text": "去。"}]
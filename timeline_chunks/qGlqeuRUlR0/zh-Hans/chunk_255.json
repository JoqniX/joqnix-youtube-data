[{"type": "subtitle", "time": 15301.59, "timestamp": "04:15:01", "text": "就像我之后不会出门一样"}, {"type": "subtitle", "time": 15304.149, "timestamp": "04:15:04", "text": "晚上10点"}, {"type": "subtitle", "time": 15311.189, "timestamp": "04:15:11", "text": "随时都可以去。那是个好兆头"}, {"type": "subtitle", "time": 15314.55, "timestamp": "04:15:14", "text": "事物。我认为这是一件好事吗？"}, {"type": "subtitle", "time": 15317.75, "timestamp": "04:15:17", "text": "晚上是不是很可怕？"}, {"type": "subtitle", "time": 15321.67, "timestamp": "04:15:21", "text": "一些超级安全的东西，比如，哦，我的意思是"}, {"type": "subtitle", "time": 15324.99, "timestamp": "04:15:24", "text": "基本安全。穆斯林传统"}, {"type": "subtitle", "time": 15328.51, "timestamp": "04:15:28", "text": "就像日本以……而闻名"}, {"type": "subtitle", "time": 15330.03, "timestamp": "04:15:30", "text": "安全"}, {"type": "subtitle", "time": 15333.67, "timestamp": "04:15:33", "text": "但坏事哪里都会发生。所以，我"}, {"type": "subtitle", "time": 15345.83, "timestamp": "04:15:45", "text": "那很好。网络状况如何？"}, {"type": "subtitle", "time": 15348.83, "timestamp": "04:15:48", "text": "哦，互联网就像我"}, {"type": "subtitle", "time": 15352.71, "timestamp": "04:15:52", "text": "意思是说它大部分情况下都不错，但也要看情况。"}, {"type": "subtitle", "time": 15355.83, "timestamp": "04:15:55", "text": "就像你居住的那栋楼一样。所以如果"}, {"type": "subtitle", "time": 15359.269, "timestamp": "04:15:59", "text": "你就像在建造一座超级老旧的建筑。"}]
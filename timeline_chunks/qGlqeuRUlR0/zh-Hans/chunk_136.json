[{"type": "subtitle", "time": 8160.75, "timestamp": "02:16:00", "text": "还有很多天的时间。"}, {"type": "subtitle", "time": 8163.39, "timestamp": "02:16:03", "text": "事件？是的，我想直到"}, {"type": "subtitle", "time": 8166.229, "timestamp": "02:16:06", "text": "十二月底。是的，会有的。"}, {"type": "subtitle", "time": 8168.149, "timestamp": "02:16:08", "text": "时间到了。我会尽量把它完成。"}, {"type": "subtitle", "time": 8170.189, "timestamp": "02:16:10", "text": "我想，对于"}, {"type": "subtitle", "time": 8173.189, "timestamp": "02:16:13", "text": "现在。是的。 Adigata，大家好"}, {"type": "subtitle", "time": 8174.95, "timestamp": "02:16:14", "text": "今天过来。所有来的人"}, {"type": "subtitle", "time": 8178.39, "timestamp": "02:16:18", "text": "截至今日"}, {"type": "subtitle", "time": 8182.27, "timestamp": "02:16:22", "text": "今天来的所有人"}, {"type": "subtitle", "time": 8185.39, "timestamp": "02:16:25", "text": "哲学。感谢"}, {"type": "subtitle", "time": 8192.709, "timestamp": "02:16:32", "text": "到。我会尽量让自己自由，这样我们才能……"}, {"type": "subtitle", "time": 8195.549, "timestamp": "02:16:35", "text": "简单点儿。所以"}, {"type": "subtitle", "time": 8208.19, "timestamp": "02:16:48", "text": "感谢爱德华的到来"}, {"type": "subtitle", "time": 8211.349, "timestamp": "02:16:51", "text": "期待您的光临。已经过去很久了。"}, {"type": "subtitle", "time": 8213.91, "timestamp": "02:16:53", "text": "希望您喜欢。谢谢你"}, {"type": "subtitle", "time": 8214.83, "timestamp": "02:16:54", "text": "未来"}, {"type": "subtitle", "time": 8218.549, "timestamp": "02:16:58", "text": "感谢你的到来。我正在速通它，因为"}]
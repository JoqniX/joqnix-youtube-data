[{"type": "subtitle", "time": 18240.39, "timestamp": "05:04:00", "text": "出道之后，我只是和他们聊了聊，然后就……"}, {"type": "subtitle", "time": 18243.948, "timestamp": "05:04:03", "text": "有点像法国人那种友好"}, {"type": "subtitle", "time": 18247.67, "timestamp": "05:04:07", "text": "建立关系之后，我问了他们。"}, {"type": "subtitle", "time": 18250.788, "timestamp": "05:04:10", "text": "我曾问过他们是否愿意"}, {"type": "subtitle", "time": 18254.55, "timestamp": "05:04:14", "text": "可以合作一下什么的。有时他们"}, {"type": "subtitle", "time": 18257.75, "timestamp": "05:04:17", "text": "扪心自问"}, {"type": "subtitle", "time": 18260.07, "timestamp": "05:04:20", "text": "比如，如果他们想和你合作的话"}, {"type": "subtitle", "time": 18264.07, "timestamp": "05:04:24", "text": "不。哦，你把呃变成了"}, {"type": "subtitle", "time": 18266.07, "timestamp": "05:04:26", "text": "和他们一起的朋友们慢慢地接受了它"}, {"type": "subtitle", "time": 18270.868, "timestamp": "05:04:30", "text": "慢点说，对吧？是的。是的。库兹"}, {"type": "subtitle", "time": 18274.23, "timestamp": "05:04:34", "text": "现在我经常群发私信给别人"}, {"type": "subtitle", "time": 18277.99, "timestamp": "05:04:37", "text": "而且以前从来没有人合作过，"}, {"type": "subtitle", "time": 18279.83, "timestamp": "05:04:39", "text": "他们没事，因为他们已经合作过了。"}, {"type": "subtitle", "time": 18281.15, "timestamp": "05:04:41", "text": "与我一起。他们知道其中的氛围，"}, {"type": "subtitle", "time": 18284.31, "timestamp": "05:04:44", "text": "即使是很久以前的事。但"}, {"type": "subtitle", "time": 18287.91, "timestamp": "05:04:47", "text": "对于新来的人来说，不，他们觉得我像……"}, {"type": "subtitle", "time": 18290.39, "timestamp": "05:04:50", "text": "就像凭空冒出来一样。我的意思是"}, {"type": "subtitle", "time": 18299.43, "timestamp": "05:04:59", "text": "协作类似于交易"}]
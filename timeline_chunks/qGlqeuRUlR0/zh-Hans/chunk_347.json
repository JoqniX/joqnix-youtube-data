[{"type": "subtitle", "time": 20821.19, "timestamp": "05:47:01", "text": "14天未注意到关闭或"}, {"type": "subtitle", "time": 20824.868, "timestamp": "05:47:04", "text": "正在重启电脑。那可真是件了不起的事。那"}, {"type": "subtitle", "time": 20827.35, "timestamp": "05:47:07", "text": "这是我的最高纪录。我一直在工作"}, {"type": "subtitle", "time": 20828.43, "timestamp": "05:47:08", "text": "难的。"}, {"type": "subtitle", "time": 20831.75, "timestamp": "05:47:11", "text": "所以，我很喜欢。"}, {"type": "subtitle", "time": 20836.39, "timestamp": "05:47:16", "text": "是的。仍然感觉不像"}, {"type": "subtitle", "time": 20838.548, "timestamp": "05:47:18", "text": "我直播的次数不多。只是"}, {"type": "subtitle", "time": 20840.948, "timestamp": "05:47:20", "text": "就像我只是个流媒体用户一样，这是一个新的"}, {"type": "subtitle", "time": 20844.23, "timestamp": "05:47:24", "text": "溪流。这只是新的一天，或者就像我"}, {"type": "subtitle", "time": 20845.91, "timestamp": "05:47:25", "text": "刚刚开始直播。我没有直播"}, {"type": "subtitle", "time": 20848.628, "timestamp": "05:47:28", "text": "这几天。感觉就像"}, {"type": "subtitle", "time": 20850.628, "timestamp": "05:47:30", "text": "那。我不知道为什么。那很好"}, {"type": "subtitle", "time": 20853.19, "timestamp": "05:47:33", "text": "事物。这是件好事。一致性"}, {"type": "subtitle", "time": 20858.23, "timestamp": "05:47:38", "text": "这一点至关重要。"}, {"type": "subtitle", "time": 20863.59, "timestamp": "05:47:43", "text": "我希望我能把那份东西留在日本。"}, {"type": "subtitle", "time": 20866.548, "timestamp": "05:47:46", "text": "是啊，我也希望如此。"}, {"type": "subtitle", "time": 20875.19, "timestamp": "05:47:55", "text": "是的。你与……的互动如何？"}]
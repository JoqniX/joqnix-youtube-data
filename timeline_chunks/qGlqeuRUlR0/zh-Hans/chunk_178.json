[{"type": "subtitle", "time": 10682.83, "timestamp": "02:58:02", "text": "来吧，来吧，快点，快点，来"}, {"type": "subtitle", "time": 10684.91, "timestamp": "02:58:04", "text": "在。"}, {"type": "subtitle", "time": 10692.94, "timestamp": "02:58:12", "text": "延迟。等待。"}, {"type": "subtitle", "time": 10721.349, "timestamp": "02:58:41", "text": "我觉得这个方法确实有效。如果我"}, {"type": "subtitle", "time": 10725.03, "timestamp": "02:58:45", "text": "当然，那时候还没有死神。"}, {"type": "subtitle", "time": 10738.15, "timestamp": "02:58:58", "text": "我如何关上门，透过门"}]
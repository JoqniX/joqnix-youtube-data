[{"type": "subtitle", "time": 17461.67, "timestamp": "04:51:01", "text": "你买了吗？你呃，你买了吗？"}, {"type": "subtitle", "time": 17463.59, "timestamp": "04:51:03", "text": "你是带了笔记本电脑还是买了笔记本电脑？"}, {"type": "subtitle", "time": 17465.75, "timestamp": "04:51:05", "text": "从那里开始呢？"}, {"type": "subtitle", "time": 17467.23, "timestamp": "04:51:07", "text": "哦，我"}, {"type": "subtitle", "time": 17471.59, "timestamp": "04:51:11", "text": "我带了笔记本电脑。我 我"}, {"type": "subtitle", "time": 17473.83, "timestamp": "04:51:13", "text": "还买不了。"}, {"type": "subtitle", "time": 17476.39, "timestamp": "04:51:16", "text": "太贵了。等等，太过了"}, {"type": "subtitle", "time": 17479.948, "timestamp": "04:51:19", "text": "在日本很贵吗？不太像。"}, {"type": "subtitle", "time": 17483.99, "timestamp": "04:51:23", "text": "贵得像你能买到的那种贵。"}, {"type": "subtitle", "time": 17487.43, "timestamp": "04:51:27", "text": "有些笔记本电脑甚至只要1万日元左右。"}, {"type": "subtitle", "time": 17488.27, "timestamp": "04:51:28", "text": "喜欢"}, {"type": "subtitle", "time": 17491.83, "timestamp": "04:51:31", "text": "虽然是二手的，但我很喜欢，我想买的"}, {"type": "subtitle", "time": 17495.35, "timestamp": "04:51:35", "text": "一款游戏笔记本电脑"}, {"type": "subtitle", "time": 17497.91, "timestamp": "04:51:37", "text": "或者至少像一台配置不错的笔记本电脑。"}, {"type": "subtitle", "time": 17501.83, "timestamp": "04:51:41", "text": "如果你想要那样，你就会花很多钱。"}, {"type": "subtitle", "time": 17503.47, "timestamp": "04:51:43", "text": "最多两个"}, {"type": "subtitle", "time": 17507.59, "timestamp": "04:51:47", "text": "20万日元轻而易举。"}, {"type": "subtitle", "time": 17511.27, "timestamp": "04:51:51", "text": "是的。所以，是的，我放弃了。"}, {"type": "subtitle", "time": 17512.67, "timestamp": "04:51:52", "text": "我自带的"}, {"type": "subtitle", "time": 17516.35, "timestamp": "04:51:56", "text": "笔记本电脑，我还在工作"}]
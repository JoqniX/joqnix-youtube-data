[{"type": "subtitle", "time": 10150.429, "timestamp": "02:49:10", "text": "镰？它会在我的车里。"}, {"type": "subtitle", "time": 10153.03, "timestamp": "02:49:13", "text": "正确的？但愿如此。如果不是，我就走了"}, {"type": "subtitle", "time": 10163.309, "timestamp": "02:49:23", "text": "迪奥两颗子弹。锤子威力很大。"}, {"type": "subtitle", "time": 10166.87, "timestamp": "02:49:26", "text": "刀，战术冲锋枪。我想要这些狙击手"}, {"type": "subtitle", "time": 10169.15, "timestamp": "02:49:29", "text": "还有一些其他的东西。压制"}, {"type": "subtitle", "time": 10171.83, "timestamp": "02:49:31", "text": "跟踪者。压制手枪。哦，头"}, {"type": "subtitle", "time": 10172.99, "timestamp": "02:49:32", "text": "猎人。"}, {"type": "subtitle", "time": 10175.51, "timestamp": "02:49:35", "text": "哦，我们可以晚点再买。我们得到了"}]
[{"type": "subtitle", "time": 18600.55, "timestamp": "05:10:00", "text": "让他们像打仗一样决一死战吧"}, {"type": "subtitle", "time": 18603.19, "timestamp": "05:10:03", "text": "皇家风格"}, {"type": "subtitle", "time": 18606.31, "timestamp": "05:10:06", "text": "而像你这样幸存下来的人可以"}, {"type": "subtitle", "time": 18609.31, "timestamp": "05:10:09", "text": "与他们合作。"}, {"type": "subtitle", "time": 18612.47, "timestamp": "05:10:12", "text": "嗯。你经历过什么戏剧性事件吗？"}, {"type": "subtitle", "time": 18615.31, "timestamp": "05:10:15", "text": "任何与虚拟管相关的内容"}, {"type": "subtitle", "time": 18618.948, "timestamp": "05:10:18", "text": "领域？呃"}, {"type": "subtitle", "time": 18621.2, "timestamp": "05:10:21", "text": "呃 如果你不介意分享的话，呃，我只是"}, {"type": "subtitle", "time": 18624.08, "timestamp": "05:10:24", "text": "如果你不介意分享的话，呃，我只是 想知道你有没有"}, {"type": "subtitle", "time": 18626.32, "timestamp": "05:10:26", "text": "想知道你有没有 体验过任何日本方面的事"}, {"type": "subtitle", "time": 18629.16, "timestamp": "05:10:29", "text": "体验过任何日本方面的事 是误会还是其他什么原因？"}, {"type": "subtitle", "time": 18631.68, "timestamp": "05:10:31", "text": "是误会还是其他什么原因？ 这个问题可以解决吗？是的，我有，但是喜欢"}, {"type": "subtitle", "time": 18635.92, "timestamp": "05:10:35", "text": "这个问题可以解决吗？是的，我有，但是喜欢 这不像是一场狗血剧情。更甚"}, {"type": "subtitle", "time": 18638.718, "timestamp": "05:10:38", "text": "这不像是一场狗血剧情。更甚 就像个人情感纠葛。哦，就像"}, {"type": "subtitle", "time": 18648.11, "timestamp": "05:10:48", "text": "嗯，闹翻了，或者说不说话了。"}, {"type": "subtitle", "time": 18651.31, "timestamp": "05:10:51", "text": "再也没有其他类型的戏剧了。"}, {"type": "subtitle", "time": 18655.75, "timestamp": "05:10:55", "text": "啊，你说的“分手”是指“呃，你很忙”之类的。"}, {"type": "subtitle", "time": 18657.67, "timestamp": "05:10:57", "text": "因为生活所迫，你无法……"}, {"type": "subtitle", "time": 18659.91, "timestamp": "05:10:59", "text": "主动与他们沟通。所以，他们认为"}]
[{"type": "subtitle", "time": 18181.67, "timestamp": "05:03:01", "text": "如果他们想走，请礼貌地回答。"}, {"type": "subtitle", "time": 18184.788, "timestamp": "05:03:04", "text": "合作或者类似玩这个游戏"}, {"type": "subtitle", "time": 18187.91, "timestamp": "05:03:07", "text": "或者谈谈这件事。我的意思是，如果他们"}, {"type": "subtitle", "time": 18190.99, "timestamp": "05:03:10", "text": "他们想的话，他们会说好的。"}, {"type": "subtitle", "time": 18195.99, "timestamp": "05:03:15", "text": "然后你就可以聊聊诸如“如何”之类的话题了。"}, {"type": "subtitle", "time": 18198.55, "timestamp": "05:03:18", "text": "你想进行合作吗？"}, {"type": "subtitle", "time": 18201.59, "timestamp": "05:03:21", "text": "某物。是的。你知道，计划一下"}, {"type": "subtitle", "time": 18204.07, "timestamp": "05:03:24", "text": "确定日期并计划时间，然后就可以了。"}, {"type": "subtitle", "time": 18205.99, "timestamp": "05:03:25", "text": "是的。是的。比如提前三周"}, {"type": "subtitle", "time": 18209.47, "timestamp": "05:03:29", "text": "东西。我的天啊。"}, {"type": "subtitle", "time": 18213.19, "timestamp": "05:03:33", "text": "是的。是的。我认为这是正确的做法。"}, {"type": "subtitle", "time": 18218.708, "timestamp": "05:03:38", "text": "关于它。而我的情况纯粹是运气。我"}, {"type": "subtitle", "time": 18223.91, "timestamp": "05:03:43", "text": "在 YouTube 上发现了一些像 YouTuber 一样的人"}, {"type": "subtitle", "time": 18227.51, "timestamp": "05:03:47", "text": "Twitter 就像太空一样。是的。"}, {"type": "subtitle", "time": 18232.11, "timestamp": "05:03:52", "text": "我刚才跟他们聊了聊，"}, {"type": "subtitle", "time": 18236.35, "timestamp": "05:03:56", "text": "甚至在我……之前"}]
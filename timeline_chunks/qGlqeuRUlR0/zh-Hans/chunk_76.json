[{"type": "subtitle", "time": 4561.91, "timestamp": "01:16:01", "text": "经纪人如何运作，他们各自有不同的"}, {"type": "subtitle", "time": 4565.43, "timestamp": "01:16:05", "text": "能力，对吧？就像那样"}, {"type": "subtitle", "time": 4567.99, "timestamp": "01:16:07", "text": "守望先锋里的每个英雄都有"}, {"type": "subtitle", "time": 4571.11, "timestamp": "01:16:11", "text": "他们拥有自己的能力和武器。所以"}, {"type": "subtitle", "time": 4573.75, "timestamp": "01:16:13", "text": "是的，你想像弓一样演奏。"}, {"type": "subtitle", "time": 4576.39, "timestamp": "01:16:16", "text": "角色方面，你必须选半藏，因为"}, {"type": "subtitle", "time": 4579.07, "timestamp": "01:16:19", "text": "那是唯一一个拥有"}, {"type": "subtitle", "time": 4583.59, "timestamp": "01:16:23", "text": "像这样鞠躬。所以让我们尽力而为吧"}, {"type": "subtitle", "time": 4585.88, "timestamp": "01:16:25", "text": "争取赢得这场比赛。"}, {"type": "subtitle", "time": 4599.51, "timestamp": "01:16:39", "text": "巨魔（troll）到底是什么意思？什么？什么是巨魔"}]
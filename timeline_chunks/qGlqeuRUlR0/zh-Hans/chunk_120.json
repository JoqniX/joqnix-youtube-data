[{"type": "subtitle", "time": 7202.149, "timestamp": "02:00:02", "text": "两个都。狂野奔跑的速度跟其他游戏相比慢太多了"}, {"type": "subtitle", "time": 7205.35, "timestamp": "02:00:05", "text": "这款快节奏的游戏。所以，正如我一直以来所经历的"}, {"type": "subtitle", "time": 7215.03, "timestamp": "02:00:15", "text": "嗯，当我第一次玩这个游戏的时候"}, {"type": "subtitle", "time": 7218.149, "timestamp": "02:00:18", "text": "现在就看直播，感觉真好。"}, {"type": "subtitle", "time": 7219.229, "timestamp": "02:00:19", "text": "所以"}, {"type": "subtitle", "time": 7222.39, "timestamp": "02:00:22", "text": "因为节奏太快而显得很奇怪"}, {"type": "subtitle", "time": 7224.92, "timestamp": "02:00:24", "text": "敏感性和"}, {"type": "subtitle", "time": 7227.229, "timestamp": "02:00:27", "text": "[音乐]"}, {"type": "subtitle", "time": 7230.51, "timestamp": "02:00:30", "text": "一切。但总的来说，我们的手表是"}, {"type": "subtitle", "time": 7233.83, "timestamp": "02:00:33", "text": "真是个好游戏。你玩得很开心。"}, {"type": "subtitle", "time": 7244.87, "timestamp": "02:00:44", "text": "是的。谭，你呢？你玩吗？"}]
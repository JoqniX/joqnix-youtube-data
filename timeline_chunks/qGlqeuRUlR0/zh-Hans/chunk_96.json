[{"type": "subtitle", "time": 5767.03, "timestamp": "01:36:07", "text": "有点疯，还有点灰尘？是的。"}, {"type": "subtitle", "time": 5768.629, "timestamp": "01:36:08", "text": "他还在打球吗？我这就邀请"}, {"type": "subtitle", "time": 5772.95, "timestamp": "01:36:12", "text": "又是他。他想加入。哦，他"}, {"type": "subtitle", "time": 5774.27, "timestamp": "01:36:14", "text": "做过"}, {"type": "subtitle", "time": 5780.83, "timestamp": "01:36:20", "text": "去。"}, {"type": "subtitle", "time": 5784.83, "timestamp": "01:36:24", "text": "呃，更多农业活动"}, {"type": "subtitle", "time": 5800.43, "timestamp": "01:36:40", "text": "是的，攀岩也是。"}, {"type": "subtitle", "time": 5802.669, "timestamp": "01:36:42", "text": "难的。就在那里"}, {"type": "subtitle", "time": 5808.51, "timestamp": "01:36:48", "text": "是。等等，等队友阵亡"}]
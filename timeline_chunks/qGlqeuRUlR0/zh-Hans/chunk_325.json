[{"type": "subtitle", "time": 19500.15, "timestamp": "05:25:00", "text": "对吧？是的。所以，是的，它使"}, {"type": "subtitle", "time": 19503.708, "timestamp": "05:25:03", "text": "我觉得你很坚强。"}, {"type": "subtitle", "time": 19506.55, "timestamp": "05:25:06", "text": "所以，唐娜，"}, {"type": "subtitle", "time": 19509.99, "timestamp": "05:25:09", "text": "但我希望一切顺利。"}, {"type": "subtitle", "time": 19513.51, "timestamp": "05:25:13", "text": "未来，还有，因为，呃，我有"}, {"type": "subtitle", "time": 19516.39, "timestamp": "05:25:16", "text": "给你看过我的模型吗？"}, {"type": "subtitle", "time": 19518.47, "timestamp": "05:25:18", "text": "哦，你还没有？"}, {"type": "subtitle", "time": 19521.03, "timestamp": "05:25:21", "text": "我不知道我……这一事实是否……"}, {"type": "subtitle", "time": 19523.83, "timestamp": "05:25:23", "text": "实际上把它透露给客人，"}, {"type": "subtitle", "time": 19526.31, "timestamp": "05:25:26", "text": "比如，我没能一直保守秘密。"}, {"type": "subtitle", "time": 19529.03, "timestamp": "05:25:29", "text": "确实有件法律上的事要办。"}, {"type": "subtitle", "time": 19532.83, "timestamp": "05:25:32", "text": "继续进行模型设计，我当时就想："}, {"type": "subtitle", "time": 19536.23, "timestamp": "05:25:36", "text": "兄弟，这游戏你懂的。"}, {"type": "subtitle", "time": 19540.23, "timestamp": "05:25:40", "text": "那个，嗯，呃，这叫什么名字？"}, {"type": "subtitle", "time": 19543.35, "timestamp": "05:25:43", "text": "再次？所以，嗯，那位主播去了"}, {"type": "subtitle", "time": 19545.83, "timestamp": "05:25:45", "text": "去了韩国，然后因为……被打了一顿。"}, {"type": "subtitle", "time": 19548.07, "timestamp": "05:25:48", "text": "即使在日本，情况也一团糟。你"}, {"type": "subtitle", "time": 19550.47, "timestamp": "05:25:50", "text": "记住"}, {"type": "subtitle", "time": 19552.708, "timestamp": "05:25:52", "text": "他叫什么名字？约翰尼·索马里。是的，"}, {"type": "subtitle", "time": 19556.15, "timestamp": "05:25:56", "text": "约翰尼·索马里。我感觉自己也一样。"}, {"type": "subtitle", "time": 19558.31, "timestamp": "05:25:58", "text": "当前情况。就像你真的可以那样"}]
[{"type": "subtitle", "time": 19863.43, "timestamp": "05:31:03", "text": "呃，比如亲戚或者父母之类的。"}, {"type": "subtitle", "time": 19865.03, "timestamp": "05:31:05", "text": "我不想告诉我的父母"}, {"type": "subtitle", "time": 19868.868, "timestamp": "05:31:08", "text": "有时候我会后悔告诉别人"}, {"type": "subtitle", "time": 19876.47, "timestamp": "05:31:16", "text": "我愿意"}, {"type": "subtitle", "time": 19885.788, "timestamp": "05:31:25", "text": "所以确实如此。"}, {"type": "subtitle", "time": 19888.11, "timestamp": "05:31:28", "text": "如此多的痛苦"}, {"type": "subtitle", "time": 19891.99, "timestamp": "05:31:31", "text": "事物，但经验能帮助你。"}, {"type": "subtitle", "time": 19895.27, "timestamp": "05:31:35", "text": "走出自己的路，开辟自己的道路"}, {"type": "subtitle", "time": 19897.51, "timestamp": "05:31:37", "text": "是的"}, {"type": "subtitle", "time": 19902.15, "timestamp": "05:31:42", "text": "这是生活美好的一部分。"}, {"type": "subtitle", "time": 19906.19, "timestamp": "05:31:46", "text": "是的，继续前进。我"}, {"type": "subtitle", "time": 19908.868, "timestamp": "05:31:48", "text": "意思是你会没事的。是的。"}, {"type": "subtitle", "time": 19911.19, "timestamp": "05:31:51", "text": "别太……别太……"}, {"type": "subtitle", "time": 19914.39, "timestamp": "05:31:54", "text": "正如杠杆男孩所说，他被卷入其中了。什么"}, {"type": "subtitle", "time": 19916.47, "timestamp": "05:31:56", "text": "不要太纠结于此。"}]
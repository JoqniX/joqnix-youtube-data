[{"type": "subtitle", "time": 8282.27, "timestamp": "02:18:02", "text": "注意补充水分，也要注意保暖。"}, {"type": "subtitle", "time": 8286.99, "timestamp": "02:18:06", "text": "好的。是的，我会再见的。"}, {"type": "subtitle", "time": 8308.27, "timestamp": "02:18:28", "text": "是的。"}, {"type": "subtitle", "time": 8310.99, "timestamp": "02:18:30", "text": "你好。希望你"}, {"type": "subtitle", "time": 8318.709, "timestamp": "02:18:38", "text": "描述我们活着的希望。您好，我们是"}, {"type": "subtitle", "time": 8322.309, "timestamp": "02:18:42", "text": "居住。欢迎来到第二天的第二部分。"}, {"type": "subtitle", "time": 8326.15, "timestamp": "02:18:46", "text": "乔森之一。所以，在这个过程中，我们将"}, {"type": "subtitle", "time": 8329.309, "timestamp": "02:18:49", "text": "继续我们上次中断的地方。等等"}, {"type": "subtitle", "time": 8333.19, "timestamp": "02:18:53", "text": "是的，让我们尽情享受吧！"}, {"type": "subtitle", "time": 8336.389, "timestamp": "02:18:56", "text": "我们尽力了。所以，正在收看的人们"}, {"type": "subtitle", "time": 8337.83, "timestamp": "02:18:57", "text": "感谢观看，也感谢您"}]
[{"type": "subtitle", "time": 1080.71, "timestamp": "00:18:00", "text": "等等，接住六个雪球。什么"}, {"type": "subtitle", "time": 1089.11, "timestamp": "00:18:09", "text": "呃，无法在自定义游戏中完成。"}, {"type": "subtitle", "time": 1091.47, "timestamp": "00:18:11", "text": "所以，练习的内容就是打招呼。"}, {"type": "subtitle", "time": 1095.23, "timestamp": "00:18:15", "text": "好的。呃，等等。"}, {"type": "subtitle", "time": 1100.029, "timestamp": "00:18:20", "text": "嗯，在雪球游戏中赢一局。好的。等待。"}, {"type": "subtitle", "time": 1103.99, "timestamp": "00:18:23", "text": "不，呃，我们还是集中精力讨论这个吧。堵塞"}, {"type": "subtitle", "time": 1109.83, "timestamp": "00:18:29", "text": "用冷冻剂或冰块阻挡雪球"}, {"type": "subtitle", "time": 1112.39, "timestamp": "00:18:32", "text": "雪球墙上的匹配或可能"}, {"type": "subtitle", "time": 1114.909, "timestamp": "00:18:34", "text": "雪球效应"}, {"type": "subtitle", "time": 1119.19, "timestamp": "00:18:39", "text": "进攻。捉猫捉六个雪球"}, {"type": "subtitle", "time": 1121.789, "timestamp": "00:18:41", "text": "并像滚雪球一样越滚越大。"}, {"type": "subtitle", "time": 1135.75, "timestamp": "00:18:55", "text": "进攻。哦好的。我们进去吧"}]
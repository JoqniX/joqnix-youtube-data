[{"type": "subtitle", "time": 5042.11, "timestamp": "01:24:02", "text": "哦，但我确实遇到了一个挑战"}, {"type": "subtitle", "time": 5044.709, "timestamp": "01:24:04", "text": "完毕。我们确实完成了一项挑战。"}, {"type": "subtitle", "time": 5048.43, "timestamp": "01:24:08", "text": "尽管。我的天哪，他得逞了"}, {"type": "subtitle", "time": 5052.95, "timestamp": "01:24:12", "text": "他把所有挨过拳头的人都打死了。所以，呃，什么？"}, {"type": "subtitle", "time": 5055.83, "timestamp": "01:24:15", "text": "正在发生什么？所以，我正在尝试做……"}, {"type": "subtitle", "time": 5059.51, "timestamp": "01:24:19", "text": "赢得这个活动挑战"}, {"type": "subtitle", "time": 5061.95, "timestamp": "01:24:21", "text": "远的。等等，让我排队。"}, {"type": "subtitle", "time": 5066.39, "timestamp": "01:24:26", "text": "第一的。到目前为止，我们都赢了。那"}, {"type": "subtitle", "time": 5069.51, "timestamp": "01:24:29", "text": "完成了。我们需要15条生命。那"}, {"type": "subtitle", "time": 5072.39, "timestamp": "01:24:32", "text": "这意味着如果你被杀了，你就会进入一个"}, {"type": "subtitle", "time": 5075.189, "timestamp": "01:24:35", "text": "我们之前看到的自由冷冻状态。"}, {"type": "subtitle", "time": 5077.11, "timestamp": "01:24:37", "text": "所以你的队友，不管是谁，"}, {"type": "subtitle", "time": 5079.189, "timestamp": "01:24:39", "text": "如果他们还活着，就需要把你解冻。那是"}, {"type": "subtitle", "time": 5080.51, "timestamp": "01:24:40", "text": "称为"}, {"type": "subtitle", "time": 5083.59, "timestamp": "01:24:43", "text": "投掷。新砖屏。是的。以及新的"}, {"type": "subtitle", "time": 5086.95, "timestamp": "01:24:46", "text": "砖红色皮肤。是的。所以如果我们得到这个，我们"}, {"type": "subtitle", "time": 5089.11, "timestamp": "01:24:49", "text": "完成了。我们将获得这个武器护符"}, {"type": "subtitle", "time": 5090.91, "timestamp": "01:24:50", "text": "皮肤"}, {"type": "subtitle", "time": 5095.39, "timestamp": "01:24:55", "text": "出色地。是的，我们只是在做"}]
[{"type": "subtitle", "time": 18840.75, "timestamp": "05:14:00", "text": "喜欢"}, {"type": "subtitle", "time": 18845.11, "timestamp": "05:14:05", "text": "归根结底，这取决于你喜欢什么。"}, {"type": "subtitle", "time": 18848.07, "timestamp": "05:14:08", "text": "你想做什么，比如你如何去做"}, {"type": "subtitle", "time": 18852.07, "timestamp": "05:14:12", "text": "事物。我觉得也没多少。"}, {"type": "subtitle", "time": 18855.07, "timestamp": "05:14:15", "text": "即使是坏事，也不用担心。"}, {"type": "subtitle", "time": 18872.708, "timestamp": "05:14:32", "text": "事物。是的。像大多数人一样"}, {"type": "subtitle", "time": 18876.39, "timestamp": "05:14:36", "text": "最糟糕的情况是这样的"}, {"type": "subtitle", "time": 18879.51, "timestamp": "05:14:39", "text": "你玩得很开心，而且就像……"}, {"type": "subtitle", "time": 18882.39, "timestamp": "05:14:42", "text": "那家伙有点像个喷子。有些人"}, {"type": "subtitle", "time": 18883.31, "timestamp": "05:14:43", "text": "巨魔"}, {"type": "subtitle", "time": 18886.27, "timestamp": "05:14:46", "text": "你有时在"}, {"type": "subtitle", "time": 18890.83, "timestamp": "05:14:50", "text": "呃，日本方面，你知道的。"}, {"type": "subtitle", "time": 18895.07, "timestamp": "05:14:55", "text": "罗利奥。是的，没错。他们称之为"}, {"type": "subtitle", "time": 18898.708, "timestamp": "05:14:58", "text": "就像日语里那样。它叫做呃"}]
[{"type": "subtitle", "time": 3544.309, "timestamp": "00:59:04", "text": "英雄完成100场游戏。赢得拨款"}, {"type": "subtitle", "time": 3547.349, "timestamp": "00:59:07", "text": "双倍进展。好的。我会得到"}, {"type": "subtitle", "time": 3548.829, "timestamp": "00:59:08", "text": "呃"}, {"type": "subtitle", "time": 3553.349, "timestamp": "00:59:13", "text": "堡垒和僵尸。然后是破坏球"}, {"type": "subtitle", "time": 3557.19, "timestamp": "00:59:17", "text": "最后是Echo。那么，现在是什么季节呢？"}, {"type": "subtitle", "time": 3560.51, "timestamp": "00:59:20", "text": "那么本季情况如何呢？"}, {"type": "subtitle", "time": 3563.39, "timestamp": "00:59:23", "text": "一？战斗通行证"}, {"type": "subtitle", "time": 3567.549, "timestamp": "00:59:27", "text": "英雄。这是战斗通行证的新内容"}, {"type": "subtitle", "time": 3571.71, "timestamp": "00:59:31", "text": "英雄。拉·拉玛特拉。"}, {"type": "subtitle", "time": 3574.63, "timestamp": "00:59:34", "text": "拉玛特拉。哦，真棒。"}, {"type": "subtitle", "time": 3576.67, "timestamp": "00:59:36", "text": "他是"}, {"type": "subtitle", "time": 3580.27, "timestamp": "00:59:40", "text": "凉爽的。所以，共有八个等级。那是"}, {"type": "subtitle", "time": 3582.51, "timestamp": "00:59:42", "text": "80. 80"}, {"type": "subtitle", "time": 3584.03, "timestamp": "00:59:44", "text": "层级。"}, {"type": "subtitle", "time": 3595.109, "timestamp": "00:59:55", "text": "[音乐]"}, {"type": "subtitle", "time": 3598.75, "timestamp": "00:59:58", "text": "你明白我的意思。这就是皮肤，对吧？"}]
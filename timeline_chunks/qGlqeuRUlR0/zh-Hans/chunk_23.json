[{"type": "subtitle", "time": 1381.51, "timestamp": "00:23:01", "text": "疼痛。疼痛。他被躺在那里。"}, {"type": "subtitle", "time": 1383.83, "timestamp": "00:23:03", "text": "我正抓起一些东西的时候，他看着我。"}, {"type": "subtitle", "time": 1386.82, "timestamp": "00:23:06", "text": "雪。"}, {"type": "subtitle", "time": 1389.47, "timestamp": "00:23:09", "text": "[音乐]"}, {"type": "subtitle", "time": 1391.549, "timestamp": "00:23:11", "text": "好的。别来烦我"}, {"type": "subtitle", "time": 1395.07, "timestamp": "00:23:15", "text": "我。我把他拉黑了。"}, {"type": "subtitle", "time": 1399.11, "timestamp": "00:23:19", "text": "尽管。啊，真不错，Raji G。我简直不敢相信。"}, {"type": "subtitle", "time": 1401.99, "timestamp": "00:23:21", "text": "我已经走了，但我会尽力而为。"}, {"type": "subtitle", "time": 1404.19, "timestamp": "00:23:24", "text": "我得到了一些奖励，那就是"}, {"type": "subtitle", "time": 1407.35, "timestamp": "00:23:27", "text": "好的。等等，这看起来像琪琪。这"}, {"type": "subtitle", "time": 1410.11, "timestamp": "00:23:30", "text": "皮肤看起来像琪琪。"}, {"type": "subtitle", "time": 1414.149, "timestamp": "00:23:34", "text": "哇。该死，这些人居然有皮囊，我的天。"}, {"type": "subtitle", "time": 1416.19, "timestamp": "00:23:36", "text": "男人。"}, {"type": "subtitle", "time": 1420.149, "timestamp": "00:23:40", "text": "哇。这些人都有皮肤。哇。看"}, {"type": "subtitle", "time": 1422.71, "timestamp": "00:23:42", "text": "就这么办。看起来像琪琪。这是"}, {"type": "subtitle", "time": 1425.99, "timestamp": "00:23:45", "text": "我们不知道。这是中国妖怪，"}, {"type": "subtitle", "time": 1429.19, "timestamp": "00:23:49", "text": "一个鬼魂。我忘了它的名字，但是"}, {"type": "subtitle", "time": 1431.71, "timestamp": "00:23:51", "text": "背后的故事真的很酷"}, {"type": "subtitle", "time": 1437.31, "timestamp": "00:23:57", "text": "它。赢得一场雪地游戏。等等，我赢了。哦，"}]
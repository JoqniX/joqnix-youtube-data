[{"type": "subtitle", "time": 18120.708, "timestamp": "05:02:00", "text": "就像我做的一样，继续。"}, {"type": "subtitle", "time": 18124.35, "timestamp": "05:02:04", "text": "什么？前进。前进。呃"}, {"type": "subtitle", "time": 18127.628, "timestamp": "05:02:07", "text": "呃，因为问题是……"}, {"type": "subtitle", "time": 18131.948, "timestamp": "05:02:11", "text": "嗯，我想做，但问题是该怎么做？"}, {"type": "subtitle", "time": 18134.948, "timestamp": "05:02:14", "text": "日本的YouTube博主们对此非常重视。"}, {"type": "subtitle", "time": 18137.83, "timestamp": "05:02:17", "text": "从专业和交易的角度来看，它是"}, {"type": "subtitle", "time": 18140.39, "timestamp": "05:02:20", "text": "疯狂的。不"}, {"type": "subtitle", "time": 18142.628, "timestamp": "05:02:22", "text": "就像传统格式一样"}, {"type": "subtitle", "time": 18144.708, "timestamp": "05:02:24", "text": "格式化所有内容。我的天哪，这太……"}, {"type": "subtitle", "time": 18147.83, "timestamp": "05:02:27", "text": "疼痛。但那不是疼痛。这是合适的"}, {"type": "subtitle", "time": 18157.03, "timestamp": "05:02:37", "text": "这取决于人。我认为"}, {"type": "subtitle", "time": 18159.23, "timestamp": "05:02:39", "text": "这里肯定有一些很随和的人。"}, {"type": "subtitle", "time": 18162.11, "timestamp": "05:02:42", "text": "那里就像"}, {"type": "subtitle", "time": 18163.868, "timestamp": "05:02:43", "text": "嗯"}, {"type": "subtitle", "time": 18166.948, "timestamp": "05:02:46", "text": "大多数人都喜欢我"}, {"type": "subtitle", "time": 18170.99, "timestamp": "05:02:50", "text": "合作方对此都很冷静。"}, {"type": "subtitle", "time": 18174.07, "timestamp": "05:02:54", "text": "但我认为，就像你一样，你只需要……"}, {"type": "subtitle", "time": 18178.39, "timestamp": "05:02:58", "text": "找个人，然后问问他们"}]
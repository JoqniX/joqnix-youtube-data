[{"type": "subtitle", "time": 20161.91, "timestamp": "05:36:01", "text": "是的。那也是事实。是的。"}, {"type": "subtitle", "time": 20167.27, "timestamp": "05:36:07", "text": "是的。就像李小子说的那样"}, {"type": "subtitle", "time": 20175.67, "timestamp": "05:36:15", "text": "我的天啊"}, {"type": "subtitle", "time": 20178.548, "timestamp": "05:36:18", "text": "做你自己，并不断进步"}, {"type": "subtitle", "time": 20180.23, "timestamp": "05:36:20", "text": "你自己"}, {"type": "subtitle", "time": 20182.948, "timestamp": "05:36:22", "text": "然后剩下的部分就会随之而来。"}, {"type": "subtitle", "time": 20185.43, "timestamp": "05:36:25", "text": "我觉得是这样。"}, {"type": "subtitle", "time": 20189.67, "timestamp": "05:36:29", "text": "我认为你应该那样做。"}, {"type": "subtitle", "time": 20192.788, "timestamp": "05:36:32", "text": "就像瞄准"}, {"type": "subtitle", "time": 20195.75, "timestamp": "05:36:35", "text": "做你想做的事。做什么"}, {"type": "subtitle", "time": 20198.31, "timestamp": "05:36:38", "text": "你想做，人们就会跟随。"}, {"type": "subtitle", "time": 20201.19, "timestamp": "05:36:41", "text": "那。"}, {"type": "subtitle", "time": 20203.15, "timestamp": "05:36:43", "text": "我"}, {"type": "subtitle", "time": 20209.27, "timestamp": "05:36:49", "text": "出色地。你有没有想过去"}, {"type": "subtitle", "time": 20211.67, "timestamp": "05:36:51", "text": "实时2D？我相信你确实谈到过这件事。"}, {"type": "subtitle", "time": 20213.91, "timestamp": "05:36:53", "text": "曾经和我在一起"}, {"type": "subtitle", "time": 20216.868, "timestamp": "05:36:56", "text": "很久以前。是的。那方面有进展吗？"}, {"type": "subtitle", "time": 20219.75, "timestamp": "05:36:59", "text": "最近怎么样？"}]
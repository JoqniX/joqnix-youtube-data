[{"type": "subtitle", "time": 21189.43, "timestamp": "05:53:09", "text": "这是我昨晚做的炒饭。油煎"}, {"type": "subtitle", "time": 21191.03, "timestamp": "05:53:11", "text": "米。"}, {"type": "subtitle", "time": 21193.67, "timestamp": "05:53:13", "text": "是的，我昨晚做了炒饭。"}, {"type": "subtitle", "time": 21203.27, "timestamp": "05:53:23", "text": "所以，我需要学习。等等，你刚才有……"}, {"type": "subtitle", "time": 21206.39, "timestamp": "05:53:26", "text": "连炉灶也要一起买吗？带上炊具"}, {"type": "subtitle", "time": 21207.91, "timestamp": "05:53:27", "text": "那里。"}, {"type": "subtitle", "time": 21211.11, "timestamp": "05:53:31", "text": "在日本是买不到的。"}, {"type": "subtitle", "time": 21215.91, "timestamp": "05:53:35", "text": "哦，不，不。我，我没有，嗯，我的朋友们"}, {"type": "subtitle", "time": 21221.35, "timestamp": "05:53:41", "text": "比如，嗯，三个同事朋友。"}, {"type": "subtitle", "time": 21223.91, "timestamp": "05:53:43", "text": "这些人来自印度，他们带来了"}, {"type": "subtitle", "time": 21226.43, "timestamp": "05:53:46", "text": "他们自己的压力锅"}, {"type": "subtitle", "time": 21231.11, "timestamp": "05:53:51", "text": "家。哦，原来还有这回事。但是你可以"}, {"type": "subtitle", "time": 21234.23, "timestamp": "05:53:54", "text": "买个价格合理的电饭煲"}, {"type": "subtitle", "time": 21237.03, "timestamp": "05:53:57", "text": "价格在此。所以我觉得不是这样。"}]
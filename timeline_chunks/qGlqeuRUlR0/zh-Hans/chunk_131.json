[{"type": "subtitle", "time": 7861.87, "timestamp": "02:11:01", "text": "我心情不好。这条溪流我本应该"}, {"type": "subtitle", "time": 7865.109, "timestamp": "02:11:05", "text": "我原本应该扮演恩佐，但是"}, {"type": "subtitle", "time": 7867.669, "timestamp": "02:11:07", "text": "最后我参加了雪地挑战赛。这"}, {"type": "subtitle", "time": 7888.629, "timestamp": "02:11:28", "text": "以猎人身份完成游戏将增加"}, {"type": "subtitle", "time": 7891.99, "timestamp": "02:11:31", "text": "熊先生，这是你被选中的机会。"}, {"type": "subtitle", "time": 7916.39, "timestamp": "02:11:56", "text": "等待。我想查看一下横幅广告。我 我"}, {"type": "subtitle", "time": 7918.79, "timestamp": "02:11:58", "text": "想给，我想让你们给我"}]
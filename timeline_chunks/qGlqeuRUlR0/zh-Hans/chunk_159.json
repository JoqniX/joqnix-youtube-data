[{"type": "subtitle", "time": 9544.23, "timestamp": "02:39:04", "text": "哦，孟买的网。说实话，当我"}, {"type": "subtitle", "time": 9545.91, "timestamp": "02:39:05", "text": "很小，说实话，它"}, {"type": "subtitle", "time": 9592.87, "timestamp": "02:39:52", "text": "死。尽量来孟买。我不认为"}, {"type": "subtitle", "time": 9597.03, "timestamp": "02:39:57", "text": "我父母不会再允许我去了。"}]
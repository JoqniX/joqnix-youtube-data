[{"type": "subtitle", "time": 16381.349, "timestamp": "04:33:01", "text": "然后一切都会变得很糟糕，然后就会"}, {"type": "subtitle", "time": 16391.189, "timestamp": "04:33:11", "text": "这取决于你要打包什么东西。什么"}, {"type": "subtitle", "time": 16393.109, "timestamp": "04:33:13", "text": "你为你的行李做了什么？"}, {"type": "subtitle", "time": 16395.67, "timestamp": "04:33:15", "text": "东西？"}, {"type": "subtitle", "time": 16399.67, "timestamp": "04:33:19", "text": "哦，就像在东京一样。是的。来自呃来自"}, {"type": "subtitle", "time": 16403.429, "timestamp": "04:33:23", "text": "回到日本。 B 呃 初始"}, {"type": "subtitle", "time": 16405.67, "timestamp": "04:33:25", "text": "东西。"}, {"type": "subtitle", "time": 16408.709, "timestamp": "04:33:28", "text": "是的，我"}, {"type": "subtitle", "time": 16410.99, "timestamp": "04:33:30", "text": "呃，我只是"}, {"type": "subtitle", "time": 16415.59, "timestamp": "04:33:35", "text": "带了一些烹饪用品之类的东西，"}, {"type": "subtitle", "time": 16420.949, "timestamp": "04:33:40", "text": "不像大多数香料和一些其他的东西"}, {"type": "subtitle", "time": 16423.83, "timestamp": "04:33:43", "text": "被允许了。没关系。类似过程"}, {"type": "subtitle", "time": 16427.99, "timestamp": "04:33:47", "text": "生食是不允许的，对吗？"}, {"type": "subtitle", "time": 16432.07, "timestamp": "04:33:52", "text": "是的。嗯，我觉得香料还可以。"}, {"type": "subtitle", "time": 16435.269, "timestamp": "04:33:55", "text": "他们允许一切香料等等。"}, {"type": "subtitle", "time": 16437.91, "timestamp": "04:33:57", "text": "豆类，还有蒜粉之类的东西"}, {"type": "subtitle", "time": 16439.91, "timestamp": "04:33:59", "text": "某物"}]
[{"type": "subtitle", "time": 15180.79, "timestamp": "04:13:00", "text": "我想东京有些地方是这样，但我在"}, {"type": "subtitle", "time": 15183.83, "timestamp": "04:13:03", "text": "现在这座主要城市就像一座城市一样，所以"}, {"type": "subtitle", "time": 15187.269, "timestamp": "04:13:07", "text": "它是日本第二大城市。"}, {"type": "subtitle", "time": 15194.63, "timestamp": "04:13:14", "text": "哇，啊！"}, {"type": "subtitle", "time": 15198.59, "timestamp": "04:13:18", "text": "我以为我看到了照片。这是"}, {"type": "subtitle", "time": 15201.83, "timestamp": "04:13:21", "text": "极具未来感，酷炫十足。应该进去。"}, {"type": "subtitle", "time": 15211.11, "timestamp": "04:13:31", "text": "是的，就像东京那样，非常像一个"}, {"type": "subtitle", "time": 15213.149, "timestamp": "04:13:33", "text": "大量游客"}, {"type": "subtitle", "time": 15218.309, "timestamp": "04:13:38", "text": "但没那么多。我认为"}, {"type": "subtitle", "time": 15222.71, "timestamp": "04:13:42", "text": "就像它以……而闻名"}, {"type": "subtitle", "time": 15227.349, "timestamp": "04:13:47", "text": "这里的食物超级好吃。"}, {"type": "subtitle", "time": 15230.79, "timestamp": "04:13:50", "text": "是的。我也喜欢拉面。"}, {"type": "subtitle", "time": 15234.67, "timestamp": "04:13:54", "text": "呃，它以拉面闻名。"}, {"type": "subtitle", "time": 15238.07, "timestamp": "04:13:58", "text": "嗯，当我来这里的时候"}]
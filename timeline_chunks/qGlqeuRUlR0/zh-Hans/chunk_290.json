[{"type": "subtitle", "time": 17402.31, "timestamp": "04:50:02", "text": "是的。如果你真的喜欢这种感觉"}, {"type": "subtitle", "time": 17405.91, "timestamp": "04:50:05", "text": "比如，你好像不知道某些事。"}, {"type": "subtitle", "time": 17409.51, "timestamp": "04:50:09", "text": "你没办法真的问别人，你"}, {"type": "subtitle", "time": 17412.31, "timestamp": "04:50:12", "text": "你随时都可以给我打电话。我总是"}, {"type": "subtitle", "time": 17414.43, "timestamp": "04:50:14", "text": "这里。所以"}, {"type": "subtitle", "time": 17424.71, "timestamp": "04:50:24", "text": "是的。是的。是的。"}, {"type": "subtitle", "time": 17429.31, "timestamp": "04:50:29", "text": "[音乐]"}, {"type": "subtitle", "time": 17432.31, "timestamp": "04:50:32", "text": "两个"}, {"type": "subtitle", "time": 17441.11, "timestamp": "04:50:41", "text": "[音乐]"}, {"type": "subtitle", "time": 17448.47, "timestamp": "04:50:48", "text": "呃，问题是我不知道，我希望……"}, {"type": "subtitle", "time": 17450.47, "timestamp": "04:50:50", "text": "事情进展顺利，但我却很担心。"}, {"type": "subtitle", "time": 17452.91, "timestamp": "04:50:52", "text": "仍然感到焦虑"}]
[{"type": "subtitle", "time": 21600.548, "timestamp": "06:00:00", "text": "我不擅长说话，但你很擅长。"}, {"type": "subtitle", "time": 21602.27, "timestamp": "06:00:02", "text": "喜欢"}, {"type": "subtitle", "time": 21604.788, "timestamp": "06:00:04", "text": "对话。嗯？一段对话"}, {"type": "subtitle", "time": 21606.39, "timestamp": "06:00:06", "text": "伙伴？"}, {"type": "subtitle", "time": 21610.708, "timestamp": "06:00:10", "text": "我有。是的，你很好说话。"}, {"type": "subtitle", "time": 21612.39, "timestamp": "06:00:12", "text": "是的，"}, {"type": "subtitle", "time": 21617.36, "timestamp": "06:00:17", "text": "我觉得这样很有帮助。"}, {"type": "subtitle", "time": 21620.548, "timestamp": "06:00:20", "text": "[音乐]"}, {"type": "subtitle", "time": 21630.788, "timestamp": "06:00:30", "text": "所以我们应该多出去玩。"}, {"type": "subtitle", "time": 21632.628, "timestamp": "06:00:32", "text": "未来。"}, {"type": "subtitle", "time": 21634.47, "timestamp": "06:00:34", "text": "是的，"}, {"type": "subtitle", "time": 21646.31, "timestamp": "06:00:46", "text": "[音乐]"}, {"type": "subtitle", "time": 21649.35, "timestamp": "06:00:49", "text": "我们应该多出去玩，多玩游戏。"}, {"type": "subtitle", "time": 21652.948, "timestamp": "06:00:52", "text": "就像你提到的那样。是的。是的。它"}, {"type": "subtitle", "time": 21655.51, "timestamp": "06:00:55", "text": "会很有趣。"}, {"type": "subtitle", "time": 21658.708, "timestamp": "06:00:58", "text": "太好玩了。是的。"}]
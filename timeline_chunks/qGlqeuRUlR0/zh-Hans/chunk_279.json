[{"type": "subtitle", "time": 16742.07, "timestamp": "04:39:02", "text": "需要居民卡，对吧？你……"}, {"type": "subtitle", "time": 16746.07, "timestamp": "04:39:06", "text": "用那个机器标志？是的。是的。"}, {"type": "subtitle", "time": 16750.709, "timestamp": "04:39:10", "text": "当你第一次来的时候，我"}, {"type": "subtitle", "time": 16755.109, "timestamp": "04:39:15", "text": "建议您在来之前先喜欢一下"}, {"type": "subtitle", "time": 16759.109, "timestamp": "04:39:19", "text": "日本，你喜欢填写在线表格吗？"}, {"type": "subtitle", "time": 16762.789, "timestamp": "04:39:22", "text": "海关和移民"}, {"type": "subtitle", "time": 16765.67, "timestamp": "04:39:25", "text": "如果你知道的话。你知道吗？"}, {"type": "subtitle", "time": 16769.189, "timestamp": "04:39:29", "text": "它？我对此一无所知。"}, {"type": "subtitle", "time": 16771.83, "timestamp": "04:39:31", "text": "好的，我会把链接发给你。如果你"}, {"type": "subtitle", "time": 16774.31, "timestamp": "04:39:34", "text": "就像来日本之前那样做，"}, {"type": "subtitle", "time": 16776.31, "timestamp": "04:39:36", "text": "即使是在你的航班上，我也不认为"}, {"type": "subtitle", "time": 16778.07, "timestamp": "04:39:38", "text": "等等，算了。我不认为"}, {"type": "subtitle", "time": 16779.868, "timestamp": "04:39:39", "text": "你可以在飞机上完成。"}, {"type": "subtitle", "time": 16783.35, "timestamp": "04:39:43", "text": "但要在您登机之前。无线上网？自由的"}, {"type": "subtitle", "time": 16786.23, "timestamp": "04:39:46", "text": "无线上网？呃，不。不，我不认为有。"}, {"type": "subtitle", "time": 16788.788, "timestamp": "04:39:48", "text": "那里有免费Wi-Fi。哦，哇。它们很便宜。"}, {"type": "subtitle", "time": 16790.628, "timestamp": "04:39:50", "text": "就是这样。"}, {"type": "subtitle", "time": 16792.948, "timestamp": "04:39:52", "text": "我的天啊。"}, {"type": "subtitle", "time": 16796.628, "timestamp": "04:39:56", "text": "没有网络。我的天啊。没有网络。"}, {"type": "subtitle", "time": 16799.99, "timestamp": "04:39:59", "text": "兄弟。下载一些音乐，然后充电"}]
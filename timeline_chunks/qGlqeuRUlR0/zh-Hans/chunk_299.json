[{"type": "subtitle", "time": 17941.23, "timestamp": "04:59:01", "text": "很久以前我就没做过任何事了"}, {"type": "subtitle", "time": 17944.31, "timestamp": "04:59:04", "text": "点赞频道。"}, {"type": "subtitle", "time": 17946.59, "timestamp": "04:59:06", "text": "是的。"}, {"type": "subtitle", "time": 17954.88, "timestamp": "04:59:14", "text": "事情发生了。"}, {"type": "subtitle", "time": 17956.35, "timestamp": "04:59:16", "text": "[音乐]"}, {"type": "subtitle", "time": 17959.59, "timestamp": "04:59:19", "text": "所以等我的东西都整理好之后，我们应该就……"}, {"type": "subtitle", "time": 17961.99, "timestamp": "04:59:21", "text": "一切都安顿好了，你的东西也都完好无损。"}, {"type": "subtitle", "time": 17964.628, "timestamp": "04:59:24", "text": "我们应该合作什么的。"}, {"type": "subtitle", "time": 17966.31, "timestamp": "04:59:26", "text": "是的。"}, {"type": "subtitle", "time": 17967.07, "timestamp": "04:59:27", "text": "做"}, {"type": "subtitle", "time": 17970.55, "timestamp": "04:59:30", "text": "多做事。是的。"}, {"type": "subtitle", "time": 17974.788, "timestamp": "04:59:34", "text": "是的。我想和你一起玩游戏。"}, {"type": "subtitle", "time": 17985.67, "timestamp": "04:59:45", "text": "我当时想的是这样的"}, {"type": "subtitle", "time": 17988.788, "timestamp": "04:59:48", "text": "几天时间。几天就是几天"}, {"type": "subtitle", "time": 17992.31, "timestamp": "04:59:52", "text": "前。是的。我当时在想，如果……"}, {"type": "subtitle", "time": 17993.628, "timestamp": "04:59:53", "text": "我们可以"}]
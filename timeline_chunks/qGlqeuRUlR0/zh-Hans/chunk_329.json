[{"type": "subtitle", "time": 19740.708, "timestamp": "05:29:00", "text": "而他/她只是喜欢玩闹或"}, {"type": "subtitle", "time": 19742.788, "timestamp": "05:29:02", "text": "某物。有趣的是，我"}, {"type": "subtitle", "time": 19745.27, "timestamp": "05:29:05", "text": "那种喜欢给更多机会的人"}, {"type": "subtitle", "time": 19747.75, "timestamp": "05:29:07", "text": "伤害过我的人，以及喜欢我的人"}, {"type": "subtitle", "time": 19750.07, "timestamp": "05:29:10", "text": "被摧毁而不是被摧毁这件事深深地伤害了我。"}, {"type": "subtitle", "time": 19752.548, "timestamp": "05:29:12", "text": "很多。我感觉我原谅他们了。如果他们"}, {"type": "subtitle", "time": 19755.51, "timestamp": "05:29:15", "text": "想回来，我张开双臂"}, {"type": "subtitle", "time": 19758.948, "timestamp": "05:29:18", "text": "并以那种欢迎他们的态度来对待他们，我是"}, {"type": "subtitle", "time": 19767.31, "timestamp": "05:29:27", "text": "哈哈，这对我来说很难"}, {"type": "subtitle", "time": 19771.27, "timestamp": "05:29:31", "text": "我觉得我很聪明，我尽力了。"}, {"type": "subtitle", "time": 19773.23, "timestamp": "05:29:33", "text": "比如逃离有毒环境"}, {"type": "subtitle", "time": 19776.948, "timestamp": "05:29:36", "text": "友谊，然后是我的一部分"}, {"type": "subtitle", "time": 19780.47, "timestamp": "05:29:40", "text": "是啊，人都会变，不是吗？"}, {"type": "subtitle", "time": 19784.15, "timestamp": "05:29:44", "text": "正确的？所以，我仍然可以尝试和他们交谈。"}, {"type": "subtitle", "time": 19787.35, "timestamp": "05:29:47", "text": "他们和好。然后我就想，“但是……”"}, {"type": "subtitle", "time": 19790.548, "timestamp": "05:29:50", "text": "骑师，你想再次受伤吗？"}, {"type": "subtitle", "time": 19793.868, "timestamp": "05:29:53", "text": "人们不会忘记事情，"}, {"type": "subtitle", "time": 19797.67, "timestamp": "05:29:57", "text": "正确的？因为那是第一次"}]
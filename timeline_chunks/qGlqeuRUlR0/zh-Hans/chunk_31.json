[{"type": "subtitle", "time": 1860.31, "timestamp": "00:31:00", "text": "呃，不不，我的意思是你应该给你你的"}, {"type": "subtitle", "time": 1861.95, "timestamp": "00:31:01", "text": "最好但"}, {"type": "subtitle", "time": 1866.23, "timestamp": "00:31:06", "text": "还有，别把自己弄丢了，车子得赶紧开走。"}, {"type": "subtitle", "time": 1869.63, "timestamp": "00:31:09", "text": "别忘了休息一下。"}, {"type": "subtitle", "time": 1871.95, "timestamp": "00:31:11", "text": "东西。所以"}, {"type": "subtitle", "time": 1874.549, "timestamp": "00:31:14", "text": "是的，如果你需要一点点"}, {"type": "subtitle", "time": 1877.99, "timestamp": "00:31:17", "text": "享受事物，喜欢它是没问题的。"}, {"type": "subtitle", "time": 1879.75, "timestamp": "00:31:19", "text": "休息一下，看看电视什么的。"}, {"type": "subtitle", "time": 1883.19, "timestamp": "00:31:23", "text": "某物或某事。没关系。"}, {"type": "subtitle", "time": 1899.35, "timestamp": "00:31:39", "text": "很高兴你被摸头了"}]
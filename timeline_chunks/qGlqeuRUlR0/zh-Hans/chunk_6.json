[{"type": "subtitle", "time": 361.39, "timestamp": "00:06:01", "text": "这是《守望先锋》的个人资料，对吧？我觉得我"}, {"type": "subtitle", "time": 364.11, "timestamp": "00:06:04", "text": "做过。是吗？做过"}, {"type": "subtitle", "time": 368.43, "timestamp": "00:06:08", "text": "我？是的，我确实注册过《守望先锋》账号。"}, {"type": "subtitle", "time": 370.79, "timestamp": "00:06:10", "text": "是的。好的。无需赘言，"}, {"type": "subtitle", "time": 373.27, "timestamp": "00:06:13", "text": "就像切换开关一样，我们就完成了大部分工作。"}, {"type": "subtitle", "time": 375.87, "timestamp": "00:06:15", "text": "这个平台和"}, {"type": "subtitle", "time": 377.629, "timestamp": "00:06:17", "text": "东西。"}, {"type": "subtitle", "time": 380.39, "timestamp": "00:06:20", "text": "是的。是的。当我直播的时候，对吧，我"}, {"type": "subtitle", "time": 383.309, "timestamp": "00:06:23", "text": "我不得不有点不"}, {"type": "subtitle", "time": 386.79, "timestamp": "00:06:26", "text": "无意中担心这些事"}, {"type": "subtitle", "time": 389.51, "timestamp": "00:06:29", "text": "啊，我发推了吗？哦，"}, {"type": "subtitle", "time": 392.15, "timestamp": "00:06:32", "text": "是我做的吗？是我做的吗？我做了吗？"}, {"type": "subtitle", "time": 393.55, "timestamp": "00:06:33", "text": "那？有点像"}, {"type": "subtitle", "time": 395.99, "timestamp": "00:06:35", "text": "那。诸如此类的事情很多。所以，"}, {"type": "subtitle", "time": 408.1, "timestamp": "00:06:48", "text": "好的。让我看看，好让你们也看看。"}, {"type": "subtitle", "time": 409.189, "timestamp": "00:06:49", "text": "[音乐]"}, {"type": "subtitle", "time": 411.189, "timestamp": "00:06:51", "text": "我不知道发生了什么，但是"}, {"type": "subtitle", "time": 413.83, "timestamp": "00:06:53", "text": "很奇怪。那可把我吓了一跳。"}, {"type": "subtitle", "time": 416.909, "timestamp": "00:06:56", "text": "有点因为我以为我的直播呃"}]
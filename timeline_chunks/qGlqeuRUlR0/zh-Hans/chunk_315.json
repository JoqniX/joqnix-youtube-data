[{"type": "subtitle", "time": 18902.23, "timestamp": "05:15:02", "text": "有一个词叫Arasi，还有那些"}, {"type": "subtitle", "time": 18905.27, "timestamp": "05:15:05", "text": "就是那些来你直播的人"}, {"type": "subtitle", "time": 18908.628, "timestamp": "05:15:08", "text": "别忘了留下恶意评论或点赞"}, {"type": "subtitle", "time": 18912.15, "timestamp": "05:15:12", "text": "煽动愤怒的评论，或者他们喜欢……"}, {"type": "subtitle", "time": 18915.59, "timestamp": "05:15:15", "text": "你正在享受点赞"}, {"type": "subtitle", "time": 18919.35, "timestamp": "05:15:19", "text": "呃，等等，就像在打电话一样，直播在哪里？"}, {"type": "subtitle", "time": 18922.39, "timestamp": "05:15:22", "text": "人们通过你的 Discord 给你打电话"}, {"type": "subtitle", "time": 18925.11, "timestamp": "05:15:25", "text": "频道之类的，他们可能会喜欢"}, {"type": "subtitle", "time": 18927.99, "timestamp": "05:15:27", "text": "请到您的 Discord 频道上来"}, {"type": "subtitle", "time": 18933.11, "timestamp": "05:15:33", "text": "在语音通话中，他们说了一些"}, {"type": "subtitle", "time": 18936.948, "timestamp": "05:15:36", "text": "就像那种奇怪的诱饵之类的东西"}, {"type": "subtitle", "time": 18939.19, "timestamp": "05:15:39", "text": "日语中的某事"}, {"type": "subtitle", "time": 18942.628, "timestamp": "05:15:42", "text": "是的，日语或英语"}, {"type": "subtitle", "time": 18944.788, "timestamp": "05:15:44", "text": "大部分是日语，但也有日语"}, {"type": "subtitle", "time": 18946.99, "timestamp": "05:15:46", "text": "人们和他们"}, {"type": "subtitle", "time": 18949.83, "timestamp": "05:15:49", "text": "可能就像发生的事一样。"}, {"type": "subtitle", "time": 18953.67, "timestamp": "05:15:53", "text": "在我生日直播的时候，和我一起的还有……"}, {"type": "subtitle", "time": 18956.15, "timestamp": "05:15:56", "text": "嗯，一个类似私人 Discord 频道。"}, {"type": "subtitle", "time": 18959.27, "timestamp": "05:15:59", "text": "Discord 不是私密的，但用于该直播"}]
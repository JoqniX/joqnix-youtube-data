[{"type": "subtitle", "time": 8704.15, "timestamp": "02:25:04", "text": "第二部分在上午9点。嗯。"}, {"type": "subtitle", "time": 8708.71, "timestamp": "02:25:08", "text": "呃，就像那样，不是囚犯。好的，我是"}, {"type": "subtitle", "time": 8712.11, "timestamp": "02:25:12", "text": "屁股真翘。欢迎。我刚刚"}, {"type": "subtitle", "time": 8715.91, "timestamp": "02:25:15", "text": "我的晚餐，我得找到我的"}, {"type": "subtitle", "time": 8718.309, "timestamp": "02:25:18", "text": "药品和杂物"}, {"type": "subtitle", "time": 8720.469, "timestamp": "02:25:20", "text": "呃，为了退烧和感冒。"}, {"type": "subtitle", "time": 8722.55, "timestamp": "02:25:22", "text": "一切。所以，我下楼去。"}, {"type": "subtitle", "time": 8723.87, "timestamp": "02:25:23", "text": "问问我父母"}, {"type": "subtitle", "time": 8728.389, "timestamp": "02:25:28", "text": "再次。你好。在此之前，我会先……"}, {"type": "subtitle", "time": 8731.27, "timestamp": "02:25:31", "text": "战争那件事。好的。你好。关注战争"}, {"type": "subtitle", "time": 8732.91, "timestamp": "02:25:32", "text": "一会儿。我会"}, {"type": "subtitle", "time": 8738.27, "timestamp": "02:25:38", "text": "后退。我们现在能得到什么？呃"}, {"type": "subtitle", "time": 8741.309, "timestamp": "02:25:41", "text": "阿萨。又一个阿萨德。哦，它是垂直的"}, {"type": "subtitle", "time": 8745.79, "timestamp": "02:25:45", "text": "溪流。嗨，祝您愉快。我会"}, {"type": "subtitle", "time": 8748.469, "timestamp": "02:25:48", "text": "后退。插件已发布在那里。高级"}, {"type": "subtitle", "time": 8758.67, "timestamp": "02:25:58", "text": "我看到一些 OBS 插件"}]
[{"type": "subtitle", "time": 20640.708, "timestamp": "05:44:00", "text": "第一步完成。好的。"}, {"type": "subtitle", "time": 20643.91, "timestamp": "05:44:03", "text": "是的，我确实在你的网站上看到了广告。"}, {"type": "subtitle", "time": 20647.75, "timestamp": "05:44:07", "text": "溪流。你现在在我的YouTube频道上投放广告了。"}, {"type": "subtitle", "time": 20650.39, "timestamp": "05:44:10", "text": "我的天啊。什么？"}, {"type": "subtitle", "time": 20654.15, "timestamp": "05:44:14", "text": "是的。哦，"}, {"type": "subtitle", "time": 20656.628, "timestamp": "05:44:16", "text": "就像我一样，我的直播正在播放。"}, {"type": "subtitle", "time": 20660.708, "timestamp": "05:44:20", "text": "背景，然后我收到一些广告。"}, {"type": "subtitle", "time": 20664.868, "timestamp": "05:44:24", "text": "时间。是的。等等，这种情况经常发生吗？"}, {"type": "subtitle", "time": 20667.51, "timestamp": "05:44:27", "text": "频繁吗？还是像 Twitch 那样？"}, {"type": "subtitle", "time": 20669.67, "timestamp": "05:44:29", "text": "每隔10分钟或5分钟就会出现一次"}, {"type": "subtitle", "time": 20671.75, "timestamp": "05:44:31", "text": "广告播放中"}, {"type": "subtitle", "time": 20674.788, "timestamp": "05:44:34", "text": "几乎无法观看？"}, {"type": "subtitle", "time": 20677.75, "timestamp": "05:44:37", "text": "几乎没怎么看。是的，不是这样的。"}, {"type": "subtitle", "time": 20681.35, "timestamp": "05:44:41", "text": "这种情况并不常见。"}, {"type": "subtitle", "time": 20683.43, "timestamp": "05:44:43", "text": "你可以像观看直播一样观看直播。"}, {"type": "subtitle", "time": 20690.07, "timestamp": "05:44:50", "text": "我的直播是在后台播放的，而且"}, {"type": "subtitle", "time": 20691.99, "timestamp": "05:44:51", "text": "从未见过这条广告。是吗？"}, {"type": "subtitle", "time": 20695.47, "timestamp": "05:44:55", "text": "因为我安装了广告拦截器？"}, {"type": "subtitle", "time": 20699.11, "timestamp": "05:44:59", "text": "没错，那样就行了。"}]
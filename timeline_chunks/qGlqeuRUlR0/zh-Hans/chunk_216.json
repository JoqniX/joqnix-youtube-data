[{"type": "subtitle", "time": 12972.71, "timestamp": "03:36:12", "text": "等等，我杀了他……我的天哪。为什么？"}, {"type": "subtitle", "time": 12976.229, "timestamp": "03:36:16", "text": "你从哪里出生？你去了哪里？"}, {"type": "subtitle", "time": 12978.71, "timestamp": "03:36:18", "text": "是从哪里诞生的，迪奥？你从哪里弄来的"}, {"type": "subtitle", "time": 12985.67, "timestamp": "03:36:25", "text": "跑步。好，好，好，我们开始速通吧"}, {"type": "subtitle", "time": 13016.11, "timestamp": "03:36:56", "text": "战斗霰弹枪是"}, {"type": "subtitle", "time": 13019.349, "timestamp": "03:36:59", "text": "楼主的东西。所有的一切，唯一的事"}]
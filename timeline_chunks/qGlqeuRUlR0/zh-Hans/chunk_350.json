[{"type": "subtitle", "time": 21007.19, "timestamp": "05:50:07", "text": "有时候在商店里，嗯……"}, {"type": "subtitle", "time": 21011.868, "timestamp": "05:50:11", "text": "工作人员会与您交谈。"}, {"type": "subtitle", "time": 21014.868, "timestamp": "05:50:14", "text": "英语或者就像我当时在和……说话"}, {"type": "subtitle", "time": 21018.628, "timestamp": "05:50:18", "text": "员工都像日本人一样，就像所有日本人一样。"}, {"type": "subtitle", "time": 21022.23, "timestamp": "05:50:22", "text": "最后就像我跟别人说话一样"}, {"type": "chat", "time": 21023.384, "timestamp": "05:50:23", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "hey hey fellas how's it going?"}, {"type": "subtitle", "time": 21024.47, "timestamp": "05:50:24", "text": "跟她谈了一件事。我当时有一个"}, {"type": "subtitle", "time": 21028.868, "timestamp": "05:50:28", "text": "她问了一个问题，然后她带着一个"}, {"type": "subtitle", "time": 21031.59, "timestamp": "05:50:31", "text": "有会说英语的员工"}, {"type": "subtitle", "time": 21035.99, "timestamp": "05:50:35", "text": "它开始用英语和我说话，然后它"}, {"type": "subtitle", "time": 21038.31, "timestamp": "05:50:38", "text": "很突然。所以我一直说个不停"}, {"type": "subtitle", "time": 21040.548, "timestamp": "05:50:40", "text": "他们一直用日语交谈。"}, {"type": "subtitle", "time": 21043.67, "timestamp": "05:50:43", "text": "英语，而且感觉超级奇怪，就像"}, {"type": "subtitle", "time": 21046.548, "timestamp": "05:50:46", "text": "什么？"}, {"type": "subtitle", "time": 21051.31, "timestamp": "05:50:51", "text": "就像我告诉他们的那样，他们可以接受。"}, {"type": "subtitle", "time": 21056.11, "timestamp": "05:50:56", "text": "就像日语里说的“没关系”一样。"}, {"type": "subtitle", "time": 21059.75, "timestamp": "05:50:59", "text": "但他们一直用英语交谈"}]
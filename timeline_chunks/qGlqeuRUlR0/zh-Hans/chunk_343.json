[{"type": "subtitle", "time": 20584.51, "timestamp": "05:43:04", "text": "索马里人和其他一些人一样，有点奇怪。"}, {"type": "subtitle", "time": 20587.31, "timestamp": "05:43:07", "text": "YouTuber 或内容创作者"}, {"type": "subtitle", "time": 20590.47, "timestamp": "05:43:10", "text": "[音乐]"}, {"type": "subtitle", "time": 20593.27, "timestamp": "05:43:13", "text": "情况好转了。是啊，我想是的。"}, {"type": "subtitle", "time": 20596.15, "timestamp": "05:43:16", "text": "现在好多了。是的，他们不是。"}, {"type": "subtitle", "time": 20599.35, "timestamp": "05:43:19", "text": "做那些价值百万美元的事"}, {"type": "subtitle", "time": 20601.67, "timestamp": "05:43:21", "text": "独家协议之类的。哦，是的。"}, {"type": "subtitle", "time": 20603.83, "timestamp": "05:43:23", "text": "我确实查过他们的踢球搭档那件事。"}, {"type": "subtitle", "time": 20607.75, "timestamp": "05:43:27", "text": "它们确实允许多路复用。"}, {"type": "subtitle", "time": 20609.99, "timestamp": "05:43:29", "text": "这很酷。那真不错"}, {"type": "subtitle", "time": 20614.91, "timestamp": "05:43:34", "text": "但"}, {"type": "subtitle", "time": 20618.788, "timestamp": "05:43:38", "text": "是的，已经完成了。我的下一个目标"}, {"type": "subtitle", "time": 20621.75, "timestamp": "05:43:41", "text": "不知何故，因为我能够得到"}, {"type": "subtitle", "time": 20624.548, "timestamp": "05:43:44", "text": "YouTube上的盈利模式，以便在……"}, {"type": "subtitle", "time": 20626.788, "timestamp": "05:43:46", "text": "我感觉自己就像是 YouTube 的合作伙伴。"}, {"type": "subtitle", "time": 20629.27, "timestamp": "05:43:49", "text": "是的，接下来我非常希望……"}, {"type": "subtitle", "time": 20632.27, "timestamp": "05:43:52", "text": "Twitch合作伙伴。那是不可能的"}, {"type": "subtitle", "time": 20637.75, "timestamp": "05:43:57", "text": "难的。是的。但第一步"}]
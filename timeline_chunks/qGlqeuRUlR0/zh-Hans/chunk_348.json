[{"type": "subtitle", "time": 20883.31, "timestamp": "05:48:03", "text": "就像人们用英语和你交谈一样"}, {"type": "subtitle", "time": 20886.39, "timestamp": "05:48:06", "text": "或者就像你说话时他们会那样"}, {"type": "subtitle", "time": 20888.11, "timestamp": "05:48:08", "text": "喜欢"}, {"type": "subtitle", "time": 20891.11, "timestamp": "05:48:11", "text": "哦，就像你懂日语，他们也会说话一样。"}, {"type": "subtitle", "time": 20894.99, "timestamp": "05:48:14", "text": "随便跟你聊聊什么的。"}, {"type": "subtitle", "time": 20900.99, "timestamp": "05:48:20", "text": "呃，就像平时每天都这样"}, {"type": "subtitle", "time": 20906.15, "timestamp": "05:48:26", "text": "我的日常作息基本就是这样，我几乎不说话。"}, {"type": "subtitle", "time": 20908.47, "timestamp": "05:48:28", "text": "感觉别人都不怎么跟你说话了。"}, {"type": "subtitle", "time": 20911.35, "timestamp": "05:48:31", "text": "就像你去……"}, {"type": "subtitle", "time": 20914.788, "timestamp": "05:48:34", "text": "便利店或超市"}, {"type": "subtitle", "time": 20918.15, "timestamp": "05:48:38", "text": "就像他们会说的那样，就像他们会做的那样"}, {"type": "subtitle", "time": 20921.67, "timestamp": "05:48:41", "text": "你做他们的工作，你很少需要"}, {"type": "subtitle", "time": 20925.51, "timestamp": "05:48:45", "text": "和某人交谈，或者即使你这样做"}, {"type": "subtitle", "time": 20928.43, "timestamp": "05:48:48", "text": "好像他们什么也没说。"}, {"type": "subtitle", "time": 20932.07, "timestamp": "05:48:52", "text": "额外的东西，至少对我来说是这样，就像我"}, {"type": "subtitle", "time": 20934.51, "timestamp": "05:48:54", "text": "还没怎么跟人说过话"}, {"type": "subtitle", "time": 20938.31, "timestamp": "05:48:58", "text": "店里有人，就像顾客一样。"}]
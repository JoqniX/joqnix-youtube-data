[{"type": "subtitle", "time": 16142.91, "timestamp": "04:29:02", "text": "潘婷。嗯，"}, {"type": "subtitle", "time": 16145.229, "timestamp": "04:29:05", "text": "和"}, {"type": "subtitle", "time": 16148.95, "timestamp": "04:29:08", "text": "我从来没在便利店买过东西。"}, {"type": "subtitle", "time": 16150.51, "timestamp": "04:29:10", "text": "商店，"}, {"type": "subtitle", "time": 16156.149, "timestamp": "04:29:16", "text": "但可能像2000以下的那种"}, {"type": "subtitle", "time": 16164.51, "timestamp": "04:29:24", "text": "2000年。哦"}, {"type": "subtitle", "time": 16169.59, "timestamp": "04:29:29", "text": "是的。前进。你说你买东西就像……"}, {"type": "subtitle", "time": 16172.87, "timestamp": "04:29:32", "text": "洗面奶、护发素和洗发水"}, {"type": "subtitle", "time": 16177.11, "timestamp": "04:29:37", "text": "从本地药店购买。等待。等待。"}, {"type": "subtitle", "time": 16180.389, "timestamp": "04:29:40", "text": "什么？药物酸性药物。好的。"}, {"type": "subtitle", "time": 16182.389, "timestamp": "04:29:42", "text": "是的。"}, {"type": "subtitle", "time": 16191.269, "timestamp": "04:29:51", "text": "感觉很奇怪。我的天啊。"}, {"type": "subtitle", "time": 16194.469, "timestamp": "04:29:54", "text": "药店出售各种各样的东西，比如"}, {"type": "subtitle", "time": 16198.95, "timestamp": "04:29:58", "text": "像洗发水之类的东西"}]
[{"type": "subtitle", "time": 5356.79, "timestamp": "01:29:16", "text": "啊，我的意思是，是的，我们需要一个V，但是我们……"}, {"type": "subtitle", "time": 5370.51, "timestamp": "01:29:30", "text": "跳跃。"}, {"type": "subtitle", "time": 5373.55, "timestamp": "01:29:33", "text": "呃是"}, {"type": "subtitle", "time": 5376.99, "timestamp": "01:29:36", "text": "它游戏你"}, {"type": "subtitle", "time": 5394.03, "timestamp": "01:29:54", "text": "电话？他们说了什么吗？"}, {"type": "subtitle", "time": 5397.35, "timestamp": "01:29:57", "text": "不。我的天哪，我死定了。"}, {"type": "subtitle", "time": 5399.51, "timestamp": "01:29:59", "text": "哦，对了，赤比，如果你……可以给我打电话。"}]
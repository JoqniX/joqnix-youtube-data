[{"type": "subtitle", "time": 18961.83, "timestamp": "05:16:01", "text": "就像设置了一个 Discord 频道一样"}, {"type": "subtitle", "time": 18964.23, "timestamp": "05:16:04", "text": "人们会从评论区打电话进来。"}, {"type": "subtitle", "time": 18969.11, "timestamp": "05:16:09", "text": "我们会分门别类地进行讨论。但确实存在"}, {"type": "subtitle", "time": 18974.31, "timestamp": "05:16:14", "text": "这个呃，像巨魔一样的人进来了。"}, {"type": "subtitle", "time": 18976.39, "timestamp": "05:16:16", "text": "语音频道，他就像……"}, {"type": "subtitle", "time": 18980.07, "timestamp": "05:16:20", "text": "超级喜欢不合适的呃个人资料"}, {"type": "subtitle", "time": 18981.788, "timestamp": "05:16:21", "text": "图片"}, {"type": "subtitle", "time": 18984.788, "timestamp": "05:16:24", "text": "就像他们说的那样，超级棒"}, {"type": "subtitle", "time": 18987.83, "timestamp": "05:16:27", "text": "不恰当的内容"}, {"type": "subtitle", "time": 18990.708, "timestamp": "05:16:30", "text": "然后他们就离开了。"}, {"type": "subtitle", "time": 18992.47, "timestamp": "05:16:32", "text": "让我猜猜。这是种族歧视吗？"}, {"type": "subtitle", "time": 18995.11, "timestamp": "05:16:35", "text": "某物？是的。"}, {"type": "subtitle", "time": 19004.03, "timestamp": "05:16:44", "text": "所以，我的意思是，这种情况只会发生。"}, {"type": "subtitle", "time": 19008.31, "timestamp": "05:16:48", "text": "我觉得很少，大概偶尔吧"}, {"type": "subtitle", "time": 19010.628, "timestamp": "05:16:50", "text": "或许"}, {"type": "subtitle", "time": 19014.19, "timestamp": "05:16:54", "text": "我只遇到过一两次这种情况。"}, {"type": "subtitle", "time": 19018.628, "timestamp": "05:16:58", "text": "所以，这就是它的缺点所在。"}]
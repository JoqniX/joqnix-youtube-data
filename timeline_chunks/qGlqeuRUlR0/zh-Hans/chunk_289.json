[{"type": "subtitle", "time": 17340.868, "timestamp": "04:49:00", "text": "我想应该是垃圾桶里的东西。"}, {"type": "subtitle", "time": 17343.75, "timestamp": "04:49:03", "text": "你不能把它烧掉吗？或者……"}, {"type": "subtitle", "time": 17347.03, "timestamp": "04:49:07", "text": "扔到哪里去了？不，那是"}, {"type": "subtitle", "time": 17353.83, "timestamp": "04:49:13", "text": "你会没事的。"}, {"type": "subtitle", "time": 17356.948, "timestamp": "04:49:16", "text": "我也这么认为。其实没那么难。"}, {"type": "subtitle", "time": 17358.948, "timestamp": "04:49:18", "text": "是的，"}, {"type": "subtitle", "time": 17362.628, "timestamp": "04:49:22", "text": "尤其是在东京，那里有英语"}, {"type": "subtitle", "time": 17367.91, "timestamp": "04:49:27", "text": "到处都是，还有垃圾桶上的呃……"}, {"type": "subtitle", "time": 17371.75, "timestamp": "04:49:31", "text": "呃，主要是在垃圾桶上。"}, {"type": "subtitle", "time": 17374.83, "timestamp": "04:49:34", "text": "呃，它说的是你可以往里面扔什么"}, {"type": "subtitle", "time": 17377.91, "timestamp": "04:49:37", "text": "垃圾。还有一些图片"}, {"type": "subtitle", "time": 17379.59, "timestamp": "04:49:39", "text": "比如你能扔什么，以及你"}, {"type": "subtitle", "time": 17380.51, "timestamp": "04:49:40", "text": "不能"}, {"type": "subtitle", "time": 17383.83, "timestamp": "04:49:43", "text": "扔。还有，如果你直接问的话……"}, {"type": "subtitle", "time": 17395.67, "timestamp": "04:49:55", "text": "你会没事的。别担心。我"}, {"type": "subtitle", "time": 17397.91, "timestamp": "04:49:57", "text": "但愿如此。"}]
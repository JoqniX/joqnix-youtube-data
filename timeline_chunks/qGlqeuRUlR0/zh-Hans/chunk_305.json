[{"type": "subtitle", "time": 18301.59, "timestamp": "05:05:01", "text": "合作之类的。但在"}, {"type": "subtitle", "time": 18303.75, "timestamp": "05:05:03", "text": "方式不同，我的意图与此不同。"}, {"type": "subtitle", "time": 18313.47, "timestamp": "05:05:13", "text": "也是。我感觉就像……"}, {"type": "subtitle", "time": 18316.31, "timestamp": "05:05:16", "text": "坏的。是的。不，没关系。别，别"}, {"type": "subtitle", "time": 18320.15, "timestamp": "05:05:20", "text": "感觉很糟糕。我的意思是，如果他们愿意的话"}, {"type": "subtitle", "time": 18322.55, "timestamp": "05:05:22", "text": "他们会合作的。是的。是的。是的。喜欢"}, {"type": "subtitle", "time": 18324.19, "timestamp": "05:05:24", "text": "日本人"}, {"type": "subtitle", "time": 18329.11, "timestamp": "05:05:29", "text": "尤其是大多数，我的意思是，并非如此。"}, {"type": "subtitle", "time": 18332.628, "timestamp": "05:05:32", "text": "他们所有人，他们中的大多数人，他们不"}, {"type": "subtitle", "time": 18335.51, "timestamp": "05:05:35", "text": "他们真的像他们做的那样合作。"}, {"type": "subtitle", "time": 18340.628, "timestamp": "05:05:40", "text": "他们自己的东西，比如他们不喜欢"}, {"type": "subtitle", "time": 18343.99, "timestamp": "05:05:43", "text": "与人互动如此频繁，或许"}, {"type": "subtitle", "time": 18353.55, "timestamp": "05:05:53", "text": "所以，你永远不知道你会和谁在一起。"}, {"type": "subtitle", "time": 18357.51, "timestamp": "05:05:57", "text": "寻找。所以我觉得应该继续下去"}]
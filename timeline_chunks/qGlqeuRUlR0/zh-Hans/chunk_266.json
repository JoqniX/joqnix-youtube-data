[{"type": "subtitle", "time": 15961.149, "timestamp": "04:26:01", "text": "比如你最好在……购买"}, {"type": "subtitle", "time": 15964.11, "timestamp": "04:26:04", "text": "超市比自动售货机更像超市。"}, {"type": "subtitle", "time": 15966.87, "timestamp": "04:26:06", "text": "机器。而且你也可以接受"}, {"type": "subtitle", "time": 15969.389, "timestamp": "04:26:09", "text": "只有"}, {"type": "subtitle", "time": 15972.99, "timestamp": "04:26:12", "text": "50,000 或最多 50 或"}, {"type": "subtitle", "time": 15975.88, "timestamp": "04:26:15", "text": "80,000，你能活下来"}, {"type": "subtitle", "time": 15977.91, "timestamp": "04:26:17", "text": "[音乐]"}, {"type": "subtitle", "time": 15980.309, "timestamp": "04:26:20", "text": "就像……"}, {"type": "subtitle", "time": 15981.91, "timestamp": "04:26:21", "text": "你自己"}, {"type": "subtitle", "time": 15991.63, "timestamp": "04:26:31", "text": "等等，你还指望什么？"}, {"type": "subtitle", "time": 15996.55, "timestamp": "04:26:36", "text": "呃，你到底在期待什么？"}, {"type": "subtitle", "time": 15999.189, "timestamp": "04:26:39", "text": "我其实没想到会这样。"}, {"type": "subtitle", "time": 16002.51, "timestamp": "04:26:42", "text": "痛苦到那种程度。"}, {"type": "subtitle", "time": 16005.91, "timestamp": "04:26:45", "text": "呃，我就想，我得吃点东西。我 我"}, {"type": "subtitle", "time": 16010.07, "timestamp": "04:26:50", "text": "为了生存，因为除非我得到"}, {"type": "subtitle", "time": 16012.71, "timestamp": "04:26:52", "text": "我找不到工作，我活不下去。"}, {"type": "subtitle", "time": 16014.87, "timestamp": "04:26:54", "text": "那里。无需努力工作"}, {"type": "subtitle", "time": 16017.83, "timestamp": "04:26:57", "text": "一切。我不想做。为什么"}]
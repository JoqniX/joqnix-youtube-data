[{"type": "subtitle", "time": 7701.75, "timestamp": "02:08:21", "text": "我当时真是个糟糕的雪人。我的天哪，我"}, {"type": "subtitle", "time": 7703.47, "timestamp": "02:08:23", "text": "这样的"}, {"type": "subtitle", "time": 7705.95, "timestamp": "02:08:25", "text": "一个"}, {"type": "subtitle", "time": 7717.39, "timestamp": "02:08:37", "text": "哦。是的。你好，"}, {"type": "subtitle", "time": 7719.99, "timestamp": "02:08:39", "text": "朋友。阿卡比，你的挑战来了。"}, {"type": "subtitle", "time": 7722.24, "timestamp": "02:08:42", "text": "正确的？因为你是在五月份。"}, {"type": "subtitle", "time": 7726.03, "timestamp": "02:08:46", "text": "[音乐]"}, {"type": "subtitle", "time": 7729.55, "timestamp": "02:08:49", "text": "呃，我做过一个"}, {"type": "subtitle", "time": 7732.75, "timestamp": "02:08:52", "text": "一。好了，我们离开了。"}]
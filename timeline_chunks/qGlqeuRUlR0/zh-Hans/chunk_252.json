[{"type": "subtitle", "time": 15123.429, "timestamp": "04:12:03", "text": "你在东京的哪个位置？又回到日本了。"}, {"type": "subtitle", "time": 15128.189, "timestamp": "04:12:08", "text": "嗯哼。我现在在福卡。"}, {"type": "subtitle", "time": 15132.55, "timestamp": "04:12:12", "text": "富科卡。富士山，或富士山。哦，不错。哦，"}, {"type": "subtitle", "time": 15136.07, "timestamp": "04:12:16", "text": "不。不是富士山。我认为呃，Koka是"}, {"type": "subtitle", "time": 15138.469, "timestamp": "04:12:18", "text": "喜欢"}, {"type": "subtitle", "time": 15141.59, "timestamp": "04:12:21", "text": "嗯，日本西部地区。"}, {"type": "subtitle", "time": 15144.03, "timestamp": "04:12:24", "text": "离东京非常远。喜欢"}, {"type": "subtitle", "time": 15150.51, "timestamp": "04:12:30", "text": "呃，大概1000公里左右。哦，是的。"}, {"type": "subtitle", "time": 15153.83, "timestamp": "04:12:33", "text": "但这是"}, {"type": "subtitle", "time": 15156.229, "timestamp": "04:12:36", "text": "呃，我第一次来这里的时候，是在东京。"}, {"type": "subtitle", "time": 15159.99, "timestamp": "04:12:39", "text": "但我刚搬到福冈。"}, {"type": "subtitle", "time": 15163.269, "timestamp": "04:12:43", "text": "另一个城市。正确的。"}, {"type": "subtitle", "time": 15165.91, "timestamp": "04:12:45", "text": "我想他是我的一位同学，他去了……"}, {"type": "subtitle", "time": 15170.309, "timestamp": "04:12:50", "text": "因为现在那里更偏远一些，所以才这样。"}, {"type": "subtitle", "time": 15173.189, "timestamp": "04:12:53", "text": "城市地区和"}, {"type": "subtitle", "time": 15176.71, "timestamp": "04:12:56", "text": "呃，不，嗯，就像如果你把它和……比较的话"}]
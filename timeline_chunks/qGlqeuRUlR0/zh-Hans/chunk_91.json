[{"type": "subtitle", "time": 5473.03, "timestamp": "01:31:13", "text": "好的。选个子高的。"}, {"type": "subtitle", "time": 5475.43, "timestamp": "01:31:15", "text": "至少我会让你，至少我会让你"}, {"type": "subtitle", "time": 5488.75, "timestamp": "01:31:28", "text": "我是一台HP。哇。"}, {"type": "subtitle", "time": 5495.44, "timestamp": "01:31:35", "text": "我死了。"}, {"type": "subtitle", "time": 5497.27, "timestamp": "01:31:37", "text": "[音乐]"}, {"type": "subtitle", "time": 5499.83, "timestamp": "01:31:39", "text": "哦，只有一个。"}, {"type": "subtitle", "time": 5503.43, "timestamp": "01:31:43", "text": "是的，这是“是”。是的。这把剑"}, {"type": "subtitle", "time": 5507.189, "timestamp": "01:31:47", "text": "这家伙真难搞。他们不会。好的，我们开始吧"}, {"type": "subtitle", "time": 5509.39, "timestamp": "01:31:49", "text": "让我们来谈谈一些大的事。"}, {"type": "subtitle", "time": 5512.229, "timestamp": "01:31:52", "text": "男生。带个大男孩来。我选择"}, {"type": "subtitle", "time": 5514.79, "timestamp": "01:31:54", "text": "破碎球。"}]
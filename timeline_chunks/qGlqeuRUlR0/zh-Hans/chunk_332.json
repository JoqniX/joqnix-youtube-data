[{"type": "subtitle", "time": 19920.708, "timestamp": "05:32:00", "text": "意思是？你能举个例子吗？"}, {"type": "subtitle", "time": 19922.47, "timestamp": "05:32:02", "text": "问题。"}, {"type": "subtitle", "time": 19925.99, "timestamp": "05:32:05", "text": "如果你喜欢，就继续思考吧"}, {"type": "subtitle", "time": 19929.19, "timestamp": "05:32:09", "text": "让你烦恼的事情，比如如果"}, {"type": "subtitle", "time": 19930.948, "timestamp": "05:32:10", "text": "你总是想着他们，"}, {"type": "subtitle", "time": 19933.91, "timestamp": "05:32:13", "text": "你深陷其中。就像赶上了一样"}, {"type": "subtitle", "time": 19940.07, "timestamp": "05:32:20", "text": "是的。别想太多。"}, {"type": "subtitle", "time": 19943.27, "timestamp": "05:32:23", "text": "为什么？为什么会有这种事？为什么会这样？"}, {"type": "subtitle", "time": 19943.99, "timestamp": "05:32:23", "text": "事物？"}, {"type": "subtitle", "time": 19947.67, "timestamp": "05:32:27", "text": "是啊，因为我太爱胡思乱想了，而且我"}, {"type": "subtitle", "time": 19951.27, "timestamp": "05:32:31", "text": "比如，“是的，我今天需要一个孩子。”"}, {"type": "subtitle", "time": 19958.91, "timestamp": "05:32:38", "text": "老的"}, {"type": "subtitle", "time": 19961.91, "timestamp": "05:32:41", "text": "是的。我们需要停止过度思考。所以，"}, {"type": "subtitle", "time": 19964.708, "timestamp": "05:32:44", "text": "我不是那个有资格说这话的人，因为我"}, {"type": "subtitle", "time": 19968.708, "timestamp": "05:32:48", "text": "总是想太多。但我正在努力"}, {"type": "subtitle", "time": 19971.99, "timestamp": "05:32:51", "text": "最好不要想太多。"}, {"type": "subtitle", "time": 19974.11, "timestamp": "05:32:54", "text": "是的。"}, {"type": "subtitle", "time": 19975.868, "timestamp": "05:32:55", "text": "抓住"}]
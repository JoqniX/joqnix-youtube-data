[{"type": "subtitle", "time": 18360.31, "timestamp": "05:06:00", "text": "直到你找到一个愿意……的人"}, {"type": "subtitle", "time": 18363.03, "timestamp": "05:06:03", "text": "合作。是的，我很幸运能有机会"}, {"type": "subtitle", "time": 18365.628, "timestamp": "05:06:05", "text": "至少有一名"}, {"type": "subtitle", "time": 18369.83, "timestamp": "05:06:09", "text": "向下。但我最近看的另一个"}, {"type": "subtitle", "time": 18371.83, "timestamp": "05:06:11", "text": "已经联系过。我当时感觉很糟糕"}, {"type": "subtitle", "time": 18374.07, "timestamp": "05:06:14", "text": "看起来，我感觉好像我知道了，我想我"}, {"type": "subtitle", "time": 18375.83, "timestamp": "05:06:15", "text": "跟你聊过，也跟你简单提过。"}, {"type": "subtitle", "time": 18377.868, "timestamp": "05:06:17", "text": "少量。正确的。所以是"}, {"type": "subtitle", "time": 18380.708, "timestamp": "05:06:20", "text": "我知道他们是英国人。"}, {"type": "subtitle", "time": 18385.11, "timestamp": "05:06:25", "text": "和日本的YouTuber们聊天，我真的"}, {"type": "subtitle", "time": 18387.55, "timestamp": "05:06:27", "text": "想和他们联系，但我以为他们"}, {"type": "subtitle", "time": 18390.55, "timestamp": "05:06:30", "text": "我们在学习英语之类的。我"}, {"type": "subtitle", "time": 18393.83, "timestamp": "05:06:33", "text": "没有进行充分的研究或了解他们的"}, {"type": "subtitle", "time": 18394.91, "timestamp": "05:06:34", "text": "内容"}, {"type": "subtitle", "time": 18397.19, "timestamp": "05:06:37", "text": "适当地。那种样子"}, {"type": "subtitle", "time": 18400.07, "timestamp": "05:06:40", "text": "简直就像一个环境类主播的瞬间"}, {"type": "subtitle", "time": 18401.708, "timestamp": "05:06:41", "text": "所有的表情包和"}, {"type": "subtitle", "time": 18405.708, "timestamp": "05:06:45", "text": "所有的一切，所有的能量"}, {"type": "subtitle", "time": 18409.83, "timestamp": "05:06:49", "text": "是啊，感觉就像……我没有"}, {"type": "subtitle", "time": 18412.708, "timestamp": "05:06:52", "text": "研究得当，听起来像是我在……"}, {"type": "subtitle", "time": 18415.75, "timestamp": "05:06:55", "text": "贬低他们的英语或其他什么"}, {"type": "subtitle", "time": 18417.67, "timestamp": "05:06:57", "text": "不知道，也许是我多虑了。"}]
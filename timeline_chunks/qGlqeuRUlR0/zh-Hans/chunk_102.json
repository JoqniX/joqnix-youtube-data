[{"type": "subtitle", "time": 6121.83, "timestamp": "01:42:01", "text": "太难了。而这个角色是"}, {"type": "subtitle", "time": 6125.229, "timestamp": "01:42:05", "text": "凉爽的。凉爽的。我可以做到"}, {"type": "subtitle", "time": 6134.229, "timestamp": "01:42:14", "text": "人们。我们走吧。末日铁拳。等等，我会"}, {"type": "subtitle", "time": 6136.03, "timestamp": "01:42:16", "text": "选择第二个。"}, {"type": "subtitle", "time": 6139.669, "timestamp": "01:42:19", "text": "一。哦，在《守望先锋》里更大。"}, {"type": "subtitle", "time": 6178.99, "timestamp": "01:42:58", "text": "我的天啊，我在击碎子弹。"}]
[{"type": "subtitle", "time": 10261.75, "timestamp": "02:51:01", "text": "好的。我的天啊。所以"}, {"type": "subtitle", "time": 10264.83, "timestamp": "02:51:04", "text": "[音乐]"}, {"type": "subtitle", "time": 10268.63, "timestamp": "02:51:08", "text": "好的。啊。我为什么要打他？而且我可以"}, {"type": "subtitle", "time": 10274.11, "timestamp": "02:51:14", "text": "锯。"}, {"type": "subtitle", "time": 10286.95, "timestamp": "02:51:26", "text": "势头。是的，别忘了……"}, {"type": "subtitle", "time": 10307.349, "timestamp": "02:51:47", "text": "[音乐]"}, {"type": "subtitle", "time": 10317.83, "timestamp": "02:51:57", "text": "死神。我喜欢我这种大杀四方的感觉。"}, {"type": "subtitle", "time": 10319.74, "timestamp": "02:51:59", "text": "像这样的人。"}]
[{"type": "subtitle", "time": 15241.349, "timestamp": "04:14:01", "text": "就像出租车司机经常跟我说的那样。"}, {"type": "subtitle", "time": 15245.03, "timestamp": "04:14:05", "text": "很多人来这里居住。所以"}, {"type": "subtitle", "time": 15247.149, "timestamp": "04:14:07", "text": "它正变得越来越像某种"}, {"type": "subtitle", "time": 15250.55, "timestamp": "04:14:10", "text": "人很多，但就像人们离开东京一样。"}, {"type": "subtitle", "time": 15254.55, "timestamp": "04:14:14", "text": "来到这里生活，喜欢和……一起生活"}, {"type": "subtitle", "time": 15258.07, "timestamp": "04:14:18", "text": "无论他们是否与家人同住，或者独自生活。"}, {"type": "subtitle", "time": 15260.07, "timestamp": "04:14:20", "text": "啊"}, {"type": "subtitle", "time": 15262.149, "timestamp": "04:14:22", "text": "生物怎么样了？情况如何？"}, {"type": "subtitle", "time": 15265.11, "timestamp": "04:14:25", "text": "生物以及一切事物？"}, {"type": "subtitle", "time": 15269.07, "timestamp": "04:14:29", "text": "很好。我的意思是，你有"}, {"type": "subtitle", "time": 15271.83, "timestamp": "04:14:31", "text": "你知道，组合式割草机上的所有东西"}, {"type": "subtitle", "time": 15274.07, "timestamp": "04:14:34", "text": "像你这样的便利店"}, {"type": "subtitle", "time": 15276.429, "timestamp": "04:14:36", "text": "那里有什么吗？"}, {"type": "subtitle", "time": 15280.149, "timestamp": "04:14:40", "text": "而我喜欢的就是……"}, {"type": "subtitle", "time": 15282.87, "timestamp": "04:14:42", "text": "便利店就像你可以去的地方"}, {"type": "subtitle", "time": 15285.67, "timestamp": "04:14:45", "text": "一天中的任何时间，比如午夜"}, {"type": "subtitle", "time": 15289.11, "timestamp": "04:14:49", "text": "比如凌晨三点，你需要吃点零食，你只需要"}, {"type": "subtitle", "time": 15294.149, "timestamp": "04:14:54", "text": "出去买点零食，就像这样"}, {"type": "subtitle", "time": 15297.75, "timestamp": "04:14:57", "text": "和家里不一样。回到家后，"}]
[{"type": "subtitle", "time": 420.95, "timestamp": "00:07:00", "text": "我的电脑好像崩溃了，但是……"}, {"type": "subtitle", "time": 423.95, "timestamp": "00:07:03", "text": "太可怕了。新油箱"}, {"type": "subtitle", "time": 427.749, "timestamp": "00:07:07", "text": "英雄。罗摩陀罗摩。哦，等等。这是"}, {"type": "subtitle", "time": 432.15, "timestamp": "00:07:12", "text": "新英雄。哦，新的战斗通行证上线了。"}, {"type": "subtitle", "time": 435.189, "timestamp": "00:07:15", "text": "哦，冬日仙境。"}, {"type": "subtitle", "time": 437.27, "timestamp": "00:07:17", "text": "新皮肤。强力喷雾武器挂件。哦，"}, {"type": "subtitle", "time": 440.11, "timestamp": "00:07:20", "text": "等待。哦，不。我需要为此努力，或者"}, {"type": "subtitle", "time": 451.629, "timestamp": "00:07:31", "text": "这？"}, {"type": "subtitle", "time": 459.67, "timestamp": "00:07:39", "text": "事件。完成六大奇迹冬季"}, {"type": "subtitle", "time": 463.27, "timestamp": "00:07:43", "text": "仙境挑战，像冰一样冰"}, {"type": "subtitle", "time": 466.469, "timestamp": "00:07:46", "text": "女王们一次可以获得六个雪球"}, {"type": "subtitle", "time": 468.71, "timestamp": "00:07:48", "text": "雪球匹配免费星星。赢得"}, {"type": "subtitle", "time": 470.83, "timestamp": "00:07:50", "text": "游戏作为一种"}, {"type": "subtitle", "time": 474.83, "timestamp": "00:07:54", "text": "雪人。在雪球游戏中赢得一局"}, {"type": "subtitle", "time": 476.88, "timestamp": "00:07:56", "text": "匹配。"}, {"type": "subtitle", "time": 478.11, "timestamp": "00:07:58", "text": "[音乐]"}]
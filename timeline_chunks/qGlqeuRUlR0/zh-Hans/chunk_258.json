[{"type": "subtitle", "time": 15481.75, "timestamp": "04:18:01", "text": "粘贴。这是我的，这将是我的"}, {"type": "subtitle", "time": 15484.99, "timestamp": "04:18:04", "text": "学校部分。呃，度规"}, {"type": "subtitle", "time": 15488.51, "timestamp": "04:18:08", "text": "东西。你怎么认为？"}, {"type": "subtitle", "time": 15490.51, "timestamp": "04:18:10", "text": "哦。"}, {"type": "subtitle", "time": 15495.67, "timestamp": "04:18:15", "text": "哦，不错。是吗？是吗？难道不是吗？"}, {"type": "subtitle", "time": 15497.389, "timestamp": "04:18:17", "text": "小巧而"}, {"type": "subtitle", "time": 15500.55, "timestamp": "04:18:20", "text": "东西？我不知道。你应该"}, {"type": "subtitle", "time": 15503.59, "timestamp": "04:18:23", "text": "看过我的房间了。等等，你怎么样了？"}, {"type": "subtitle", "time": 15506.189, "timestamp": "04:18:26", "text": "房间？是不是太过了"}, {"type": "subtitle", "time": 15509.59, "timestamp": "04:18:29", "text": "小的？就像我现在这样喜欢我的公寓"}, {"type": "subtitle", "time": 15511.91, "timestamp": "04:18:31", "text": "挺好的，但我以前是合租的。"}, {"type": "subtitle", "time": 15515.189, "timestamp": "04:18:35", "text": "类似宿舍的房子。"}, {"type": "subtitle", "time": 15518.309, "timestamp": "04:18:38", "text": "等等，如果我觉得我有一张照片"}, {"type": "subtitle", "time": 15521.67, "timestamp": "04:18:41", "text": "我会发给你。"}, {"type": "subtitle", "time": 15524.07, "timestamp": "04:18:44", "text": "你会感到有点惊讶。我想我"}, {"type": "subtitle", "time": 15527.189, "timestamp": "04:18:47", "text": "意思是说它在东京吗？"}, {"type": "subtitle", "time": 15528.67, "timestamp": "04:18:48", "text": "它在东京。"}, {"type": "subtitle", "time": 15531.67, "timestamp": "04:18:51", "text": "好的。我不知道为什么当我看着"}, {"type": "subtitle", "time": 15533.91, "timestamp": "04:18:53", "text": "想想东京的公寓或合租房"}, {"type": "subtitle", "time": 15535.51, "timestamp": "04:18:55", "text": "房子，我觉得会超级棒"}, {"type": "subtitle", "time": 15537.51, "timestamp": "04:18:57", "text": "因为它很小或者其他什么原因。"}]
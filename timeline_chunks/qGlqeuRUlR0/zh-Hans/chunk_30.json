[{"type": "subtitle", "time": 1802.35, "timestamp": "00:30:02", "text": "我抓到了多少只？"}, {"type": "subtitle", "time": 1805.669, "timestamp": "00:30:05", "text": "尽管？哦，我已经把它吃完了。现在我"}, {"type": "subtitle", "time": 1806.59, "timestamp": "00:30:06", "text": "需要一个"}, {"type": "subtitle", "time": 1808.43, "timestamp": "00:30:08", "text": "堵塞。八"}, {"type": "subtitle", "time": 1812.029, "timestamp": "00:30:12", "text": "雪球。好了，是时候了"}, {"type": "subtitle", "time": 1813.18, "timestamp": "00:30:13", "text": "堵塞。"}, {"type": "subtitle", "time": 1821.95, "timestamp": "00:30:21", "text": "好了，是时候筑墙了。嗯，"}, {"type": "subtitle", "time": 1825.43, "timestamp": "00:30:25", "text": "是的，我们会经常利用墙壁。"}, {"type": "subtitle", "time": 1829.149, "timestamp": "00:30:29", "text": "把事情安排好，这样我们才能完成……"}, {"type": "subtitle", "time": 1832.87, "timestamp": "00:30:32", "text": "挑战更大。但是，是的，皮洛萨，我"}, {"type": "subtitle", "time": 1834.99, "timestamp": "00:30:34", "text": "不知道你是否还在，"}, {"type": "subtitle", "time": 1839.389, "timestamp": "00:30:39", "text": "但是，是的，那确实"}, {"type": "subtitle", "time": 1842.87, "timestamp": "00:30:42", "text": "整个1月都非常痛苦，直到1月23日。"}, {"type": "subtitle", "time": 1850.19, "timestamp": "00:30:50", "text": "但我不知道，我不知道该怎么做。"}, {"type": "subtitle", "time": 1854.19, "timestamp": "00:30:54", "text": "通常所有科目都像G一样"}, {"type": "subtitle", "time": 1858.149, "timestamp": "00:30:58", "text": "考试。但你还是知道，不能完全"}]
[{"type": "subtitle", "time": 122.23, "timestamp": "00:02:02", "text": "我们已经完成了那件事，现在我们回来了。"}, {"type": "subtitle", "time": 124.03, "timestamp": "00:02:04", "text": "现在我们回来了"}, {"type": "subtitle", "time": 126.87, "timestamp": "00:02:06", "text": "这里。希望你们一切都好。"}, {"type": "subtitle", "time": 130.22899999999998, "timestamp": "00:02:10", "text": "嗯，我觉得是对的。"}, {"type": "subtitle", "time": 132.71, "timestamp": "00:02:12", "text": "现在几点？是的，4点。"}, {"type": "subtitle", "time": 136.47, "timestamp": "00:02:16", "text": "所以，今天的直播至少会持续到……"}, {"type": "subtitle", "time": 138.949, "timestamp": "00:02:18", "text": "一到两个小时。呃，我们将结束"}, {"type": "subtitle", "time": 143.35, "timestamp": "00:02:23", "text": "再次以6点频率直播。呃，提醒一下，我"}, {"type": "subtitle", "time": 146.39, "timestamp": "00:02:26", "text": "不会进行更长时间的直播。"}, {"type": "subtitle", "time": 150.63, "timestamp": "00:02:30", "text": "暂时会这样，因为我有些事情要处理。"}, {"type": "subtitle", "time": 153.43, "timestamp": "00:02:33", "text": "需要弄清楚，并且喜欢这样做，还有"}, {"type": "subtitle", "time": 157.19, "timestamp": "00:02:37", "text": "我需要做出调整，因为我们家的情况。所以，"}, {"type": "subtitle", "time": 159.82999999999998, "timestamp": "00:02:39", "text": "是的，希望没问题。"}, {"type": "subtitle", "time": 161.47, "timestamp": "00:02:41", "text": "我真希望如此。"}, {"type": "subtitle", "time": 164.03, "timestamp": "00:02:44", "text": "阿娜。"}, {"type": "subtitle", "time": 166.869, "timestamp": "00:02:46", "text": "是的。感谢所有到场的人。"}, {"type": "subtitle", "time": 170.35, "timestamp": "00:02:50", "text": "前往 Twitch 直播"}, {"type": "subtitle", "time": 172.71, "timestamp": "00:02:52", "text": "更早。你知道，你知道，我们应该"}, {"type": "subtitle", "time": 173.63, "timestamp": "00:02:53", "text": "制作"}, {"type": "subtitle", "time": 176.71, "timestamp": "00:02:56", "text": "某物。我们应该像个秘密一样行事。"}, {"type": "subtitle", "time": 178.949, "timestamp": "00:02:58", "text": "给那些做了这件事的人留言或一些事情"}]
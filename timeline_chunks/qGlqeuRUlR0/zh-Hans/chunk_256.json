[{"type": "subtitle", "time": 15364.59, "timestamp": "04:16:04", "text": "就像我的，呃，我的就像是内置的"}, {"type": "subtitle", "time": 15367.99, "timestamp": "04:16:07", "text": "1999年。所以互联网连接是"}, {"type": "subtitle", "time": 15370.95, "timestamp": "04:16:10", "text": "有点老旧了，就像你知道的VDSL一样。"}, {"type": "subtitle", "time": 15375.269, "timestamp": "04:16:15", "text": "我想应该是连接方式或者ADSL。所以旧的"}, {"type": "subtitle", "time": 15378.71, "timestamp": "04:16:18", "text": "他们利用电话线来……"}, {"type": "subtitle", "time": 15381.03, "timestamp": "04:16:21", "text": "就像传输互联网信号一样。所以"}, {"type": "subtitle", "time": 15385.149, "timestamp": "04:16:25", "text": "大概相当于 40 Mbps"}, {"type": "subtitle", "time": 15389.229, "timestamp": "04:16:29", "text": "向下 80 度，向上 80 度，或者类似这样"}, {"type": "subtitle", "time": 15392.469, "timestamp": "04:16:32", "text": "那。所以我的意思是，为什么他们不能像这样写呢？"}, {"type": "subtitle", "time": 15395.03, "timestamp": "04:16:35", "text": "Jio 在印度就像他们可以一样"}, {"type": "subtitle", "time": 15399.99, "timestamp": "04:16:39", "text": "就加了个新玩意儿，嗯，是的，就像"}, {"type": "subtitle", "time": 15402.469, "timestamp": "04:16:42", "text": "在附近安装一个新的连接或其他什么装置"}, {"type": "subtitle", "time": 15406.63, "timestamp": "04:16:46", "text": "哦，是的。嗯，这取决于……"}, {"type": "subtitle", "time": 15411.11, "timestamp": "04:16:51", "text": "你的大楼。我的生活有点像这样"}, {"type": "subtitle", "time": 15414.309, "timestamp": "04:16:54", "text": "高处。我住在六楼，"}, {"type": "subtitle", "time": 15416.389, "timestamp": "04:16:56", "text": "他们不能像其他人那样获得一个新的"}, {"type": "subtitle", "time": 15418.469, "timestamp": "04:16:58", "text": "联系"}]
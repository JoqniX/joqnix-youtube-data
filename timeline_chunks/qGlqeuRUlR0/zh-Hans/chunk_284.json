[{"type": "subtitle", "time": 17040.39, "timestamp": "04:44:00", "text": "我需要充电。"}, {"type": "subtitle", "time": 17044.23, "timestamp": "04:44:04", "text": "互联网，就是互联网。这就是为什么要谈论"}, {"type": "subtitle", "time": 17048.59, "timestamp": "04:44:08", "text": "基本上就像你需要付费一样"}, {"type": "subtitle", "time": 17051.75, "timestamp": "04:44:11", "text": "每月一次。我认为是预付的。"}, {"type": "subtitle", "time": 17055.19, "timestamp": "04:44:15", "text": "哦。所以，几个月后，就像取决于……"}, {"type": "subtitle", "time": 17058.47, "timestamp": "04:44:18", "text": "他们会根据您的付款方式向您发送一封邮件。"}, {"type": "subtitle", "time": 17061.03, "timestamp": "04:44:21", "text": "发票上会显示付款信息，您必须在以下情况下付款："}, {"type": "subtitle", "time": 17064.31, "timestamp": "04:44:24", "text": "便利店，或者你喜欢它是"}, {"type": "subtitle", "time": 17068.11, "timestamp": "04:44:28", "text": "从您的信用卡或借记卡中扣除"}, {"type": "subtitle", "time": 17072.15, "timestamp": "04:44:32", "text": "卡片。所以你不需要充值"}, {"type": "subtitle", "time": 17074.39, "timestamp": "04:44:34", "text": "就像已经修好了一样"}, {"type": "subtitle", "time": 17076.22, "timestamp": "04:44:36", "text": "固定方案。"}, {"type": "subtitle", "time": 17083.83, "timestamp": "04:44:43", "text": "所以我打算像……我是说我的父母那样"}, {"type": "subtitle", "time": 17085.91, "timestamp": "04:44:45", "text": "就像打包行李一样，因为我不……"}, {"type": "subtitle", "time": 17088.23, "timestamp": "04:44:48", "text": "什么都不懂。我只是在这里专注于……"}, {"type": "subtitle", "time": 17091.19, "timestamp": "04:44:51", "text": "我目前正在忙着做马拉松之类​​的事情。但"}, {"type": "subtitle", "time": 17094.47, "timestamp": "04:44:54", "text": "是啊，就像我想要的那些东西一样。"}, {"type": "subtitle", "time": 17098.11, "timestamp": "04:44:58", "text": "当时的感觉就像……嗯，我该怎么说呢？"}]
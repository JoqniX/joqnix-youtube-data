[{"type": "subtitle", "time": 3906.109, "timestamp": "01:05:06", "text": "一个盟军董事会。那是"}, {"type": "subtitle", "time": 3936.43, "timestamp": "01:05:36", "text": "等等，我收到什么了？"}, {"type": "subtitle", "time": 3939.069, "timestamp": "01:05:39", "text": "它？"}, {"type": "subtitle", "time": 3942.87, "timestamp": "01:05:42", "text": "啊，等等。我的声音啊。哦，我的"}, {"type": "subtitle", "time": 3951.71, "timestamp": "01:05:51", "text": "天哪，我忘了人们能听到声音"}, {"type": "subtitle", "time": 3955.309, "timestamp": "01:05:55", "text": "我。我的天哪，那是"}, {"type": "subtitle", "time": 3959.51, "timestamp": "01:05:59", "text": "令人尴尬。你迅速换步"}]
[{"type": "subtitle", "time": 16802.23, "timestamp": "04:40:02", "text": "你的耳机。"}, {"type": "subtitle", "time": 16805.67, "timestamp": "04:40:05", "text": "我甚至都无法使用SIM卡。"}, {"type": "subtitle", "time": 16808.788, "timestamp": "04:40:08", "text": "哦，是的。"}, {"type": "subtitle", "time": 16810.948, "timestamp": "04:40:10", "text": "安宁。"}, {"type": "subtitle", "time": 16816.07, "timestamp": "04:40:16", "text": "没关系。那是痛苦。但仅限像这样"}, {"type": "subtitle", "time": 16820.07, "timestamp": "04:40:20", "text": "一天。一天，或者说，多久？"}, {"type": "subtitle", "time": 16822.07, "timestamp": "04:40:22", "text": "你的航班号？我不知道。还没有"}, {"type": "subtitle", "time": 16824.55, "timestamp": "04:40:24", "text": "尚未确认。我不知道。他们有"}, {"type": "subtitle", "time": 16838.47, "timestamp": "04:40:38", "text": "就像……"}, {"type": "subtitle", "time": 16842.31, "timestamp": "04:40:42", "text": "等等，你做了什么？你对健康做了什么？"}, {"type": "subtitle", "time": 16845.23, "timestamp": "04:40:45", "text": "保险之类的东西？"}, {"type": "subtitle", "time": 16848.948, "timestamp": "04:40:48", "text": "是的，我愿意这么做。告诉你"}, {"type": "subtitle", "time": 16856.708, "timestamp": "04:40:56", "text": "比如，当你来到机场的时候"}, {"type": "subtitle", "time": 16859.43, "timestamp": "04:40:59", "text": "当你抵达机场时"}]
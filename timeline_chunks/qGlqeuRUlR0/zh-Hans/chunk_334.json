[{"type": "subtitle", "time": 20040.03, "timestamp": "05:34:00", "text": "昂贵的。不算太贵，但仍然"}, {"type": "subtitle", "time": 20043.91, "timestamp": "05:34:03", "text": "比如疼痛。但你多少能理解。"}, {"type": "subtitle", "time": 20048.47, "timestamp": "05:34:08", "text": "不，嗯，是的。呃，比如如果一个模型是"}, {"type": "subtitle", "time": 20051.75, "timestamp": "05:34:11", "text": "你设置的这些东西真的很好。"}, {"type": "subtitle", "time": 20056.628, "timestamp": "05:34:16", "text": "更高的期望或标准"}, {"type": "subtitle", "time": 20060.628, "timestamp": "05:34:20", "text": "为了你自己，所以资产背景"}, {"type": "subtitle", "time": 20062.23, "timestamp": "05:34:22", "text": "叠加层"}, {"type": "subtitle", "time": 20065.11, "timestamp": "05:34:25", "text": "嗯，音乐视频，一切的一切"}, {"type": "subtitle", "time": 20067.51, "timestamp": "05:34:27", "text": "你作为一名 YouTuber 在你的频道里做的事情"}, {"type": "subtitle", "time": 20069.868, "timestamp": "05:34:29", "text": "那必须是"}, {"type": "subtitle", "time": 20073.07, "timestamp": "05:34:33", "text": "必须达到同样的质量标准，而且"}, {"type": "subtitle", "time": 20077.03, "timestamp": "05:34:37", "text": "东西，因为我买不起那些东西。"}, {"type": "subtitle", "time": 20079.83, "timestamp": "05:34:39", "text": "将会属于这类人群。"}, {"type": "subtitle", "time": 20081.75, "timestamp": "05:34:41", "text": "拥有优秀、酷炫、帅气模特的人"}, {"type": "subtitle", "time": 20084.59, "timestamp": "05:34:44", "text": "但他买不起其他东西。"}, {"type": "subtitle", "time": 20087.75, "timestamp": "05:34:47", "text": "那一刻，人们就会有这种感觉。"}, {"type": "subtitle", "time": 20090.708, "timestamp": "05:34:50", "text": "他们看我直播的时候会对此议论纷纷。"}, {"type": "subtitle", "time": 20092.788, "timestamp": "05:34:52", "text": "拥有优秀的模型，但背景"}, {"type": "subtitle", "time": 20095.27, "timestamp": "05:34:55", "text": "一切都那么不对劲，就像低落的情绪一样。"}, {"type": "subtitle", "time": 20098.31, "timestamp": "05:34:58", "text": "质量差的人，他们会"}]
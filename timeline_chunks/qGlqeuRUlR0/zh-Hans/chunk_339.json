[{"type": "subtitle", "time": 20345.83, "timestamp": "05:39:05", "text": "正确的？所以，是的，我希望……可以这样"}, {"type": "subtitle", "time": 20348.31, "timestamp": "05:39:08", "text": "给我惊喜，别让我失望。不，"}, {"type": "subtitle", "time": 20351.19, "timestamp": "05:39:11", "text": "不，我相信他们，也信任他们。但"}, {"type": "subtitle", "time": 20353.59, "timestamp": "05:39:13", "text": "是的，要有信心。是的。我只是觉得"}, {"type": "subtitle", "time": 20356.39, "timestamp": "05:39:16", "text": "我希望我不会再做我做过的那件事。"}, {"type": "subtitle", "time": 20358.47, "timestamp": "05:39:18", "text": "与艺术家互动，并试图用某种方式惹恼他们。"}, {"type": "chat", "time": 20358.783, "timestamp": "05:39:18", "author": "@anime_worlda3", "avatar": "https://yt4.ggpht.com/p33G8DLNzbqQ6niBlFYlaIKulLqoOC0WjBSo8YqOSiofweaj-hNDTXZDx3515mTlopGt5_1klA=s64-c-k-c0x00ffffff-no-rj", "message": "hii"}, {"type": "subtitle", "time": 20361.11, "timestamp": "05:39:21", "text": "就像指出这样的事情一样"}, {"type": "chat", "time": 20361.369, "timestamp": "05:39:21", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Anime world ~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "chat", "time": 20362.042, "timestamp": "05:39:22", "author": "@anime_worlda3", "avatar": "https://yt4.ggpht.com/p33G8DLNzbqQ6niBlFYlaIKulLqoOC0WjBSo8YqOSiofweaj-hNDTXZDx3515mTlopGt5_1klA=s64-c-k-c0x00ffffff-no-rj", "message": "hii"}, {"type": "subtitle", "time": 20364.43, "timestamp": "05:39:24", "text": "不对，这不是那样等等"}, {"type": "subtitle", "time": 20367.75, "timestamp": "05:39:27", "text": "等等。是的。"}, {"type": "subtitle", "time": 20369.43, "timestamp": "05:39:29", "text": "你好，动漫世界。欢迎来到"}, {"type": "subtitle", "time": 20371.99, "timestamp": "05:39:31", "text": "溪流。你好。你好，亲爱的。"}, {"type": "subtitle", "time": 20374.11, "timestamp": "05:39:34", "text": "你好。"}, {"type": "chat", "time": 20379.242, "timestamp": "05:39:39", "author": "@anime_worlda3", "avatar": "https://yt4.ggpht.com/p33G8DLNzbqQ6niBlFYlaIKulLqoOC0WjBSo8YqOSiofweaj-hNDTXZDx3515mTlopGt5_1klA=s64-c-k-c0x00ffffff-no-rj", "message": "hii"}, {"type": "subtitle", "time": 20380.948, "timestamp": "05:39:40", "text": "那。我当时就想，“是啊，希望它能成功。”"}, {"type": "subtitle", "time": 20383.83, "timestamp": "05:39:43", "text": "嗯，我想是吧。你喜欢……"}, {"type": "subtitle", "time": 20387.51, "timestamp": "05:39:47", "text": "设计？你觉得怎么样？"}]
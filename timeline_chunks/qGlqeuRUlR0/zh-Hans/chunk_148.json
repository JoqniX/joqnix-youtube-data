[{"type": "subtitle", "time": 8884.79, "timestamp": "02:28:04", "text": "尤诺斯和我，我不想那样玩。"}, {"type": "subtitle", "time": 8887.27, "timestamp": "02:28:07", "text": "星形轨道。"}, {"type": "subtitle", "time": 8888.51, "timestamp": "02:28:08", "text": "我不知道我是否"}, {"type": "subtitle", "time": 8893.23, "timestamp": "02:28:13", "text": "应该，但感觉很有趣，你"}, {"type": "subtitle", "time": 8898.03, "timestamp": "02:28:18", "text": "[音乐]"}, {"type": "subtitle", "time": 8901.15, "timestamp": "02:28:21", "text": "感觉如此"}, {"type": "subtitle", "time": 8904.75, "timestamp": "02:28:24", "text": "挺有意思的，我想。"}, {"type": "subtitle", "time": 8914.99, "timestamp": "02:28:34", "text": "嗯，关于那个新的"}, {"type": "subtitle", "time": 8918.07, "timestamp": "02:28:38", "text": "就像你一样，一直在发生一些事情。"}, {"type": "subtitle", "time": 8920.59, "timestamp": "02:28:40", "text": "新的 2.0 版本"}, {"type": "subtitle", "time": 8924.23, "timestamp": "02:28:44", "text": "发布预告片之类的东西"}, {"type": "subtitle", "time": 8925.59, "timestamp": "02:28:45", "text": "它塑造的角色让我……"}, {"type": "subtitle", "time": 8927.59, "timestamp": "02:28:47", "text": "感兴趣，但我也知道即使"}, {"type": "subtitle", "time": 8929.389, "timestamp": "02:28:49", "text": "我正在获得"}, {"type": "subtitle", "time": 8933.23, "timestamp": "02:28:53", "text": "我知道，我感兴趣的这种事不会长久。"}, {"type": "subtitle", "time": 8938.59, "timestamp": "02:28:58", "text": "它就像在让我告诉你一样"}]
[{"type": "subtitle", "time": 21481.99, "timestamp": "05:58:01", "text": "要坚强。要坚强。是的。是的，如果"}, {"type": "subtitle", "time": 21484.15, "timestamp": "05:58:04", "text": "如果你觉得"}, {"type": "subtitle", "time": 21486.708, "timestamp": "05:58:06", "text": "嗯，如果你想和人谈谈，你可以"}, {"type": "subtitle", "time": 21491.03, "timestamp": "05:58:11", "text": "记得给我打电话。你好。或者也像你一样"}, {"type": "subtitle", "time": 21493.03, "timestamp": "05:58:13", "text": "带上你的手机，这样你就可以给任何人打电话了。"}, {"type": "subtitle", "time": 21494.08, "timestamp": "05:58:14", "text": "实际上。"}, {"type": "subtitle", "time": 21496.03, "timestamp": "05:58:16", "text": "[音乐]"}, {"type": "subtitle", "time": 21499.27, "timestamp": "05:58:19", "text": "是的。不喜欢待在房间里"}, {"type": "subtitle", "time": 21501.27, "timestamp": "05:58:21", "text": "不喜欢待在你的房间里"}, {"type": "subtitle", "time": 21506.31, "timestamp": "05:58:26", "text": "时间太长了。或者你可能会感到悲伤"}, {"type": "subtitle", "time": 21509.67, "timestamp": "05:58:29", "text": "或者就像你快要疯了一样"}, {"type": "subtitle", "time": 21511.31, "timestamp": "05:58:31", "text": "有时。"}, {"type": "subtitle", "time": 21513.75, "timestamp": "05:58:33", "text": "有时候，大部分时间你都会……"}, {"type": "subtitle", "time": 21516.548, "timestamp": "05:58:36", "text": "美好的。比如你会交到朋友，而且你"}, {"type": "subtitle", "time": 21521.47, "timestamp": "05:58:41", "text": "你会发现一些新的事情可以做，比如我"}, {"type": "subtitle", "time": 21537.59, "timestamp": "05:58:57", "text": "是的。所以，我想现在日本那边应该已经很晚了。"}, {"type": "subtitle", "time": 21539.99, "timestamp": "05:58:59", "text": "正确的？天哪，太晚了。你必须"}]
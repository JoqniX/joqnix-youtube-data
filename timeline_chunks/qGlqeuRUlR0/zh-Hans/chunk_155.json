[{"type": "subtitle", "time": 9308.03, "timestamp": "02:35:08", "text": "好的，各位。发给我还是我的电脑"}, {"type": "subtitle", "time": 9325.61, "timestamp": "02:35:25", "text": "是。"}, {"type": "subtitle", "time": 9328.429, "timestamp": "02:35:28", "text": "[音乐]"}, {"type": "subtitle", "time": 9333.23, "timestamp": "02:35:33", "text": "好的。你好。我们还需要两个呃才能得到"}, {"type": "subtitle", "time": 9336.71, "timestamp": "02:35:36", "text": "镰。之后，我打算去……"}, {"type": "subtitle", "time": 9338.63, "timestamp": "02:35:38", "text": "杀戮狂潮啊。字面上来说"}, {"type": "subtitle", "time": 9341.11, "timestamp": "02:35:41", "text": "杀戮狂潮。你们将会见证"}, {"type": "subtitle", "time": 9343.79, "timestamp": "02:35:43", "text": "我杀人"}, {"type": "subtitle", "time": 9346.11, "timestamp": "02:35:46", "text": "狂欢。"}, {"type": "subtitle", "time": 9348.55, "timestamp": "02:35:48", "text": "是的。好的。我需要把它放在我的"}]
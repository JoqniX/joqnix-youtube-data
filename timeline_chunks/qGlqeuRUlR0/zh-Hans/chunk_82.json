[{"type": "subtitle", "time": 4928.02, "timestamp": "01:22:08", "text": "有人过来吗？过来。过来。"}, {"type": "subtitle", "time": 4935.83, "timestamp": "01:22:15", "text": "啊，疼痛。你的目标是赢得比赛。"}, {"type": "subtitle", "time": 4939.59, "timestamp": "01:22:19", "text": "我们开始吧。我的天啊。我不认为我"}, {"type": "subtitle", "time": 4960.39, "timestamp": "01:22:40", "text": "我认为是这样。我需要多少次？"}, {"type": "subtitle", "time": 4962.229, "timestamp": "01:22:42", "text": "又高了？"}, {"type": "subtitle", "time": 4965.31, "timestamp": "01:22:45", "text": "15. 零分（满分15分）。我的天哪。"}, {"type": "subtitle", "time": 4968.229, "timestamp": "01:22:48", "text": "好的。请。我只会等，我会……"}, {"type": "subtitle", "time": 4970.629, "timestamp": "01:22:50", "text": "就像在这里一样，等着等着。患病的"}]
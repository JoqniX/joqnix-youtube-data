[{"type": "subtitle", "time": 18661.75, "timestamp": "05:11:01", "text": "你没有和他们交谈，而且你是"}, {"type": "subtitle", "time": 18663.67, "timestamp": "05:11:03", "text": "取消关注之类的。"}, {"type": "subtitle", "time": 18672.55, "timestamp": "05:11:12", "text": "是像你这样的竞争性方面吗？"}, {"type": "subtitle", "time": 18674.948, "timestamp": "05:11:14", "text": "浏览量下降了吗？你算什么东西？"}, {"type": "subtitle", "time": 18677.91, "timestamp": "05:11:17", "text": "你是不是无关紧要了？"}, {"type": "subtitle", "time": 18680.628, "timestamp": "05:11:20", "text": "啊，有点像那样，但又不太像。"}, {"type": "subtitle", "time": 18682.59, "timestamp": "05:11:22", "text": "就像……"}, {"type": "subtitle", "time": 18687.788, "timestamp": "05:11:27", "text": "想走另一条路的人"}, {"type": "subtitle", "time": 18692.15, "timestamp": "05:11:32", "text": "是啊，也没那么大。"}, {"type": "subtitle", "time": 18696.788, "timestamp": "05:11:36", "text": "像这样的交易，我不知道该怎么做"}, {"type": "subtitle", "time": 18700.948, "timestamp": "05:11:40", "text": "他们想解释，但他们就此作罢。"}, {"type": "subtitle", "time": 18703.91, "timestamp": "05:11:43", "text": "我们之间的互动和以前一样多"}, {"type": "subtitle", "time": 18705.868, "timestamp": "05:11:45", "text": "前。"}, {"type": "subtitle", "time": 18710.15, "timestamp": "05:11:50", "text": "啊，有些人认为一个人就像"}, {"type": "subtitle", "time": 18713.91, "timestamp": "05:11:53", "text": "超验之事。如果他们带来的话，就不行。"}, {"type": "subtitle", "time": 18716.47, "timestamp": "05:11:56", "text": "你的观点和一切，然后你他们"}, {"type": "subtitle", "time": 18718.948, "timestamp": "05:11:58", "text": "展现他们好的一面，如果他们"}]
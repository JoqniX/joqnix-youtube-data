[{"type": "subtitle", "time": 14942.15, "timestamp": "04:09:02", "text": "好的，一起来吧。是的。对我来说，嗯"}, {"type": "subtitle", "time": 14944.95, "timestamp": "04:09:04", "text": "是一样的。生活每况愈下"}, {"type": "subtitle", "time": 14949.83, "timestamp": "04:09:09", "text": "这里那里有些地方是上坡路。但是，嗯……"}, {"type": "subtitle", "time": 14952.07, "timestamp": "04:09:12", "text": "下个月我要去日本。所以"}, {"type": "subtitle", "time": 14955.189, "timestamp": "04:09:15", "text": "我既兴奋又害怕"}, {"type": "subtitle", "time": 14958.469, "timestamp": "04:09:18", "text": "也是。不是害怕，而是紧张。"}, {"type": "subtitle", "time": 14961.91, "timestamp": "04:09:21", "text": "哦，我也为你感到兴奋。是的。"}, {"type": "subtitle", "time": 14964.95, "timestamp": "04:09:24", "text": "我听说你跟我说过，呃，你"}, {"type": "subtitle", "time": 14967.51, "timestamp": "04:09:27", "text": "现在你们在日本，对吧？上次我们"}, {"type": "subtitle", "time": 14969.67, "timestamp": "04:09:29", "text": "谈话中，你说你会去"}, {"type": "subtitle", "time": 14972.87, "timestamp": "04:09:32", "text": "二月份左右就能到了。"}, {"type": "subtitle", "time": 14975.11, "timestamp": "04:09:35", "text": "是的。"}, {"type": "subtitle", "time": 14980.95, "timestamp": "04:09:40", "text": "二月中旬"}, {"type": "subtitle", "time": 14985.03, "timestamp": "04:09:45", "text": "是的，我一直都在这里。"}, {"type": "subtitle", "time": 14992.229, "timestamp": "04:09:52", "text": "日本那边一切都好吗？"}, {"type": "subtitle", "time": 14993.229, "timestamp": "04:09:53", "text": "我"}, {"type": "subtitle", "time": 14999.59, "timestamp": "04:09:59", "text": "意思是说，它和我预期的一样好，就像我……"}]
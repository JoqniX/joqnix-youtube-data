[{"type": "subtitle", "time": 1020.15, "timestamp": "00:17:00", "text": "上帝。不。我们可以在结尾添加VC吗？"}, {"type": "subtitle", "time": 1023.789, "timestamp": "00:17:03", "text": "细绳？嗯，我会试着找找。"}, {"type": "subtitle", "time": 1039.87, "timestamp": "00:17:19", "text": "玩。我抓到好多"}, {"type": "subtitle", "time": 1042.59, "timestamp": "00:17:22", "text": "现在。"}, {"type": "subtitle", "time": 1046.51, "timestamp": "00:17:26", "text": "GG。伙计，这家伙"}, {"type": "subtitle", "time": 1050.669, "timestamp": "00:17:30", "text": "兄弟。瞧我这雪和枪声！"}, {"type": "subtitle", "time": 1057.07, "timestamp": "00:17:37", "text": "代言。好的，我选择……"}, {"type": "subtitle", "time": 1060.57, "timestamp": "00:17:40", "text": "萨法。你做到了"}, {"type": "subtitle", "time": 1062.029, "timestamp": "00:17:42", "text": "[音乐]"}, {"type": "subtitle", "time": 1065.47, "timestamp": "00:17:45", "text": "最好的。我获得了支持。"}, {"type": "subtitle", "time": 1068.71, "timestamp": "00:17:48", "text": "A. 那么，呃，让我看看挑战是什么。"}, {"type": "subtitle", "time": 1071.07, "timestamp": "00:17:51", "text": "好的。"}, {"type": "subtitle", "time": 1073.63, "timestamp": "00:17:53", "text": "事件。"}, {"type": "subtitle", "time": 1077.11, "timestamp": "00:17:57", "text": "呃，接住六个雪球，然后打雪仗。"}]
[{"type": "subtitle", "time": 2341.15, "timestamp": "00:39:01", "text": "呃"}, {"type": "subtitle", "time": 2346.15, "timestamp": "00:39:06", "text": "四五比特。所以我需要一个三弯。"}, {"type": "subtitle", "time": 2347.99, "timestamp": "00:39:07", "text": "稻草动画和迷宫正常"}, {"type": "subtitle", "time": 2350.39, "timestamp": "00:39:10", "text": "为了得到这个，采取了冒犯性手段。好的，所以"}, {"type": "subtitle", "time": 2352.43, "timestamp": "00:39:12", "text": "我们走吧"}, {"type": "subtitle", "time": 2355.03, "timestamp": "00:39:15", "text": "再次。无球。我们需要保持静止"}, {"type": "subtitle", "time": 2357.069, "timestamp": "00:39:17", "text": "继续封锁"}, {"type": "subtitle", "time": 2359.589, "timestamp": "00:39:19", "text": "球。是的，这就是我这次的直播。"}, {"type": "subtitle", "time": 2361.829, "timestamp": "00:39:21", "text": "只是为了完成活动才能获得皮肤"}, {"type": "subtitle", "time": 2363.19, "timestamp": "00:39:23", "text": "还有所有的一切，喷雾剂和"}, {"type": "subtitle", "time": 2364.87, "timestamp": "00:39:24", "text": "一切。那太好了。我从未"}, {"type": "subtitle", "time": 2367.51, "timestamp": "00:39:27", "text": "以前做过这件事。我当时想，是啊。"}, {"type": "subtitle", "time": 2369.71, "timestamp": "00:39:29", "text": "这样做没问题。"}, {"type": "subtitle", "time": 2373.23, "timestamp": "00:39:33", "text": "正确的？我相信我们有"}, {"type": "subtitle", "time": 2376.349, "timestamp": "00:39:36", "text": "我猜是雪人吧。我不"}, {"type": "subtitle", "time": 2380.069, "timestamp": "00:39:40", "text": "知道。只剩下寥寥几个英雄供我选择了。"}, {"type": "subtitle", "time": 2380.91, "timestamp": "00:39:40", "text": "到"}, {"type": "subtitle", "time": 2390.55, "timestamp": "00:39:50", "text": "呃，等它到了，哦，你可以"}]
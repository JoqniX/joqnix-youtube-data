[{"type": "subtitle", "time": 20281.99, "timestamp": "05:38:01", "text": "或者我自己做。是的，我没有"}, {"type": "subtitle", "time": 20284.15, "timestamp": "05:38:04", "text": "不知道该选哪个，对吧？"}, {"type": "subtitle", "time": 20286.39, "timestamp": "05:38:06", "text": "现在，但是"}, {"type": "subtitle", "time": 20289.628, "timestamp": "05:38:09", "text": "一切都会好起来的。它会奏效的。"}, {"type": "subtitle", "time": 20292.788, "timestamp": "05:38:12", "text": "出去。我意识到我真的很难相处"}, {"type": "subtitle", "time": 20295.43, "timestamp": "05:38:15", "text": "与受委托的艺术家合作，因为"}, {"type": "subtitle", "time": 20298.39, "timestamp": "05:38:18", "text": "我太挑剔，也太注重专业性。"}, {"type": "subtitle", "time": 20302.788, "timestamp": "05:38:22", "text": "我就像看到一个字面意义上的单层 f 层"}, {"type": "subtitle", "time": 20306.15, "timestamp": "05:38:26", "text": "名称错误，我就想：嘿，图层名称"}, {"type": "subtitle", "time": 20308.75, "timestamp": "05:38:28", "text": "这有点不对劲"}, {"type": "subtitle", "time": 20311.99, "timestamp": "05:38:31", "text": "路，我指出了一点点"}, {"type": "subtitle", "time": 20314.708, "timestamp": "05:38:34", "text": "我觉得我犯了错误，我感觉我感觉"}, {"type": "subtitle", "time": 20317.67, "timestamp": "05:38:37", "text": "你这样做不好。不，那是艺术家的事。"}, {"type": "subtitle", "time": 20319.75, "timestamp": "05:38:39", "text": "好的，接下来会发生什么？"}, {"type": "subtitle", "time": 20322.67, "timestamp": "05:38:42", "text": "索具工，我的天哪，我是"}, {"type": "subtitle", "time": 20325.75, "timestamp": "05:38:45", "text": "我很担心，希望这种情况不会发生。"}, {"type": "subtitle", "time": 20327.07, "timestamp": "05:38:47", "text": "管状物"}, {"type": "subtitle", "time": 20330.07, "timestamp": "05:38:50", "text": "好吧，因为我只有"}, {"type": "subtitle", "time": 20332.548, "timestamp": "05:38:52", "text": "照片，包括发动机和其他部件。"}, {"type": "subtitle", "time": 20335.75, "timestamp": "05:38:55", "text": "正确的？但它的运动方式以及一切"}, {"type": "subtitle", "time": 20338.948, "timestamp": "05:38:58", "text": "这将会是一件大事，对吧？大事，"}]
[{"type": "subtitle", "time": 18420.31, "timestamp": "05:07:00", "text": "而且他们的数量也很多"}, {"type": "subtitle", "time": 18422.39, "timestamp": "05:07:02", "text": "他们就像是Twitch的合作伙伴一样。"}, {"type": "subtitle", "time": 18426.23, "timestamp": "05:07:06", "text": "一堆乱七八糟的东西，而我却像个无名小卒。"}, {"type": "subtitle", "time": 18428.39, "timestamp": "05:07:08", "text": "我认为在某种程度上，就这些而言"}, {"type": "subtitle", "time": 18431.51, "timestamp": "05:07:11", "text": "日本人，呃，就像……状态"}, {"type": "subtitle", "time": 18434.628, "timestamp": "05:07:14", "text": "事情对"}, {"type": "subtitle", "time": 18436.868, "timestamp": "05:07:16", "text": "增长状况等等这些东西"}, {"type": "subtitle", "time": 18440.628, "timestamp": "05:07:20", "text": "这很重要，我更想知道为什么。"}, {"type": "subtitle", "time": 18444.43, "timestamp": "05:07:24", "text": "总是数字越多越好"}, {"type": "subtitle", "time": 18448.07, "timestamp": "05:07:28", "text": "确实，这在某些方面确实存在。"}, {"type": "subtitle", "time": 18450.628, "timestamp": "05:07:30", "text": "人们喜欢他们，他们超级棒"}, {"type": "subtitle", "time": 18455.51, "timestamp": "05:07:35", "text": "像 YouTube 这样的专业人士"}, {"type": "subtitle", "time": 18456.8, "timestamp": "05:07:36", "text": "但"}, {"type": "subtitle", "time": 18458.628, "timestamp": "05:07:38", "text": "[音乐]"}, {"type": "subtitle", "time": 18463.35, "timestamp": "05:07:43", "text": "但还是希望大家不要太担心。"}, {"type": "subtitle", "time": 18465.83, "timestamp": "05:07:45", "text": "有时候你知道，有些事情就是会发生。你"}, {"type": "subtitle", "time": 18467.59, "timestamp": "05:07:47", "text": "犯错"}, {"type": "subtitle", "time": 18471.75, "timestamp": "05:07:51", "text": "但愿下次好运。喜欢"}, {"type": "subtitle", "time": 18474.948, "timestamp": "05:07:54", "text": "不要停下你正在做的事情。喜欢"}, {"type": "subtitle", "time": 18478.55, "timestamp": "05:07:58", "text": "你就一直往前走。我认为"}]
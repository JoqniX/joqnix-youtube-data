[{"type": "subtitle", "time": 17163.28, "timestamp": "04:46:03", "text": "这是好事还是坏事？你怎么认为？"}, {"type": "subtitle", "time": 17176.628, "timestamp": "04:46:16", "text": "116. 这是坏事还是坏事"}, {"type": "subtitle", "time": 17180.788, "timestamp": "04:46:20", "text": "我的意思是，还不错，不算太糟。所以如果我要买"}, {"type": "subtitle", "time": 17182.868, "timestamp": "04:46:22", "text": "东西的话，最好还是从日本买。"}, {"type": "subtitle", "time": 17190.11, "timestamp": "04:46:30", "text": "为了质量，最好是"}, {"type": "subtitle", "time": 17192.91, "timestamp": "04:46:32", "text": "在日本购买。"}, {"type": "subtitle", "time": 17196.788, "timestamp": "04:46:36", "text": "但如果你能把它带在身边的话，"}, {"type": "subtitle", "time": 17199.03, "timestamp": "04:46:39", "text": "带上一些东西或者从……购买"}, {"type": "subtitle", "time": 17202.15, "timestamp": "04:46:42", "text": "那里就像印度一样，"}, {"type": "subtitle", "time": 17205.75, "timestamp": "04:46:45", "text": "我觉得你最好还是买一些。"}, {"type": "subtitle", "time": 17209.67, "timestamp": "04:46:49", "text": "比如，呃，拿一些东西"}, {"type": "subtitle", "time": 17211.91, "timestamp": "04:46:51", "text": "你不需要购买任何东西"}, {"type": "subtitle", "time": 17214.788, "timestamp": "04:46:54", "text": "日本。是的。如果你已经有了，那就点赞吧。"}, {"type": "subtitle", "time": 17217.708, "timestamp": "04:46:57", "text": "带点东西，最好带上。"}]
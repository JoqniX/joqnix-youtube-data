[{"type": "subtitle", "time": 8403.87, "timestamp": "02:20:03", "text": "12:00。好的。呃，12:00 我们将"}, {"type": "subtitle", "time": 8406.67, "timestamp": "02:20:06", "text": "睡觉。所以对于6"}, {"type": "subtitle", "time": 8410.15, "timestamp": "02:20:10", "text": "几个小时，好的，6个小时"}, {"type": "subtitle", "time": 8412.71, "timestamp": "02:20:12", "text": "呃，我们要睡觉了。你们将会"}, {"type": "subtitle", "time": 8417.309, "timestamp": "02:20:17", "text": "连续看了好几集。好的。"}, {"type": "subtitle", "time": 8420.55, "timestamp": "02:20:20", "text": "是的。希望一切顺利。我"}, {"type": "subtitle", "time": 8424.07, "timestamp": "02:20:24", "text": "会放进播放列表之类的。所以"}, {"type": "subtitle", "time": 8428.59, "timestamp": "02:20:28", "text": "呃，你可以趁我犯困的时候看《避免》。"}, {"type": "subtitle", "time": 8430.75, "timestamp": "02:20:30", "text": "好的。"}, {"type": "subtitle", "time": 8433.15, "timestamp": "02:20:33", "text": "我们只会这样做"}, {"type": "subtitle", "time": 8436.83, "timestamp": "02:20:36", "text": "那是因为休息很重要，你"}, {"type": "subtitle", "time": 8440.91, "timestamp": "02:20:40", "text": "知道。我想尽我所能"}, {"type": "subtitle", "time": 8443.99, "timestamp": "02:20:43", "text": "明天。我明天的计划是做一件事"}, {"type": "subtitle", "time": 8446.11, "timestamp": "02:20:46", "text": "音乐流。我"}, {"type": "subtitle", "time": 8448.99, "timestamp": "02:20:48", "text": "我想我们可以做音乐。"}, {"type": "subtitle", "time": 8456.15, "timestamp": "02:20:56", "text": "明天我的计划是听音乐。"}, {"type": "subtitle", "time": 8459.309, "timestamp": "02:20:59", "text": "溪流。我们会的"}]
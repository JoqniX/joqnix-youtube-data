[{"type": "subtitle", "time": 17101.91, "timestamp": "04:45:01", "text": "嗯，我想等等，呃，你检查过吗？"}, {"type": "subtitle", "time": 17104.07, "timestamp": "04:45:04", "text": "电子设备和麦克风之类的东西"}, {"type": "subtitle", "time": 17108.11, "timestamp": "04:45:08", "text": "东西？它哪里贵了？昂贵的？"}, {"type": "subtitle", "time": 17111.31, "timestamp": "04:45:11", "text": "不，这取决于你是否购买它。"}, {"type": "subtitle", "time": 17114.51, "timestamp": "04:45:14", "text": "新旧程度取决于你在哪里购买"}, {"type": "subtitle", "time": 17118.91, "timestamp": "04:45:18", "text": "从。我认为你会买到很划算的商品"}, {"type": "subtitle", "time": 17120.43, "timestamp": "04:45:20", "text": "亚马逊。"}, {"type": "subtitle", "time": 17123.83, "timestamp": "04:45:23", "text": "对，麦克风。我其实从来没查过。"}, {"type": "subtitle", "time": 17126.868, "timestamp": "04:45:26", "text": "等等，让我查一下。"}, {"type": "subtitle", "time": 17129.35, "timestamp": "04:45:29", "text": "但就像其他事物一样，有点……"}, {"type": "subtitle", "time": 17132.07, "timestamp": "04:45:32", "text": "我觉得很贵。但不要太多。"}, {"type": "subtitle", "time": 17134.47, "timestamp": "04:45:34", "text": "就像你可以买到好东西一样"}, {"type": "subtitle", "time": 17135.55, "timestamp": "04:45:35", "text": "[音乐]"}, {"type": "subtitle", "time": 17139.84, "timestamp": "04:45:39", "text": "亚马逊上的价格也很合理。"}, {"type": "subtitle", "time": 17142.31, "timestamp": "04:45:42", "text": "[音乐]"}, {"type": "subtitle", "time": 17144.23, "timestamp": "04:45:44", "text": "问题是我不想麻烦我"}, {"type": "subtitle", "time": 17149.47, "timestamp": "04:45:49", "text": "P 就像我喜欢，所以一卢比就像"}, {"type": "subtitle", "time": 17153.03, "timestamp": "04:45:53", "text": "我猜是0.60日元。"}, {"type": "subtitle", "time": 17159.43, "timestamp": "04:45:59", "text": "M：所以，是的，速度慢了些，对吧？所以"}]
[{"type": "subtitle", "time": 15540.229, "timestamp": "04:19:00", "text": "人满为患，而且还有更多"}, {"type": "subtitle", "time": 15542.309, "timestamp": "04:19:02", "text": "人需要生存。所以，他们就在这里。"}, {"type": "subtitle", "time": 15544.67, "timestamp": "04:19:04", "text": "打造生活空间"}, {"type": "subtitle", "time": 15547.51, "timestamp": "04:19:07", "text": "更小一些之类的。我不知道。如何"}, {"type": "subtitle", "time": 15551.149, "timestamp": "04:19:11", "text": "人类能生存下来吗？我"}, {"type": "subtitle", "time": 15554.63, "timestamp": "04:19:14", "text": "大多数情况下都是这样，就像你需要……"}, {"type": "subtitle", "time": 15557.429, "timestamp": "04:19:17", "text": "你会习惯的。没有"}, {"type": "subtitle", "time": 15560.63, "timestamp": "04:19:20", "text": "图片中这些座位位于此处"}, {"type": "subtitle", "time": 15564.11, "timestamp": "04:19:24", "text": "这是我的学校学生"}, {"type": "subtitle", "time": 15576.389, "timestamp": "04:19:36", "text": "嗯，这里和印度很不一样。"}, {"type": "subtitle", "time": 15580.349, "timestamp": "04:19:40", "text": "是的，差别很大。喜欢，"}, {"type": "subtitle", "time": 15583.87, "timestamp": "04:19:43", "text": "嗯，回到家，就像"}, {"type": "subtitle", "time": 15587.99, "timestamp": "04:19:47", "text": "我以前的宿舍房间大概是现在的四倍。"}, {"type": "subtitle", "time": 15593.55, "timestamp": "04:19:53", "text": "跟我住的那栋房子一样大"}, {"type": "subtitle", "time": 15596.389, "timestamp": "04:19:56", "text": "行进。等等，我看看能不能找到"}, {"type": "subtitle", "time": 15598.389, "timestamp": "04:19:58", "text": "图片。"}]
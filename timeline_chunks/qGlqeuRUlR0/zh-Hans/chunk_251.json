[{"type": "subtitle", "time": 15062.07, "timestamp": "04:11:02", "text": "但我觉得大家都挺冷静的。"}, {"type": "subtitle", "time": 15065.349, "timestamp": "04:11:05", "text": "他们不太容易出汗，如果你喜欢的话。"}, {"type": "subtitle", "time": 15068.87, "timestamp": "04:11:08", "text": "准时到，或者大概两三个人。"}, {"type": "subtitle", "time": 15072.309, "timestamp": "04:11:12", "text": "迟到了几分钟。我的意思是，这很糟糕，但仍然"}, {"type": "subtitle", "time": 15075.67, "timestamp": "04:11:15", "text": "就好像这不是世界末日一样。"}, {"type": "subtitle", "time": 15078.229, "timestamp": "04:11:18", "text": "搞定了。就像今天一样，我也有东西。"}, {"type": "subtitle", "time": 15080.71, "timestamp": "04:11:20", "text": "事情还在继续，所以我没法过来。"}, {"type": "subtitle", "time": 15083.67, "timestamp": "04:11:23", "text": "时间。我们错过了，就像我们应该错过一样。"}, {"type": "subtitle", "time": 15087.349, "timestamp": "04:11:27", "text": "做两个小时"}, {"type": "subtitle", "time": 15089.75, "timestamp": "04:11:29", "text": "没关系。没关系。希望我能"}, {"type": "subtitle", "time": 15092.75, "timestamp": "04:11:32", "text": "了解了很多关于这方面的信息。"}, {"type": "subtitle", "time": 15097.67, "timestamp": "04:11:37", "text": "呃，我在那里的时候就得适应那里的情况了。"}, {"type": "subtitle", "time": 15101.429, "timestamp": "04:11:41", "text": "准时上班、整天打卡什么的，"}, {"type": "subtitle", "time": 15103.429, "timestamp": "04:11:43", "text": "纪律，"}, {"type": "subtitle", "time": 15111.189, "timestamp": "04:11:51", "text": "你会有很多经历。"}, {"type": "subtitle", "time": 15114.55, "timestamp": "04:11:54", "text": "嗯。是的。我为此感到无比高兴"}, {"type": "subtitle", "time": 15115.95, "timestamp": "04:11:55", "text": "你。"}, {"type": "subtitle", "time": 15119.75, "timestamp": "04:11:59", "text": "你好。不好意思，请问一下在哪里？"}]
[{"type": "subtitle", "time": 15601.67, "timestamp": "04:20:01", "text": "でも、ほとんどが小さなアパートか"}, {"type": "subtitle", "time": 15605.149, "timestamp": "04:20:05", "text": "東京にある夜明けの部屋。"}, {"type": "subtitle", "time": 15608.189, "timestamp": "04:20:08", "text": "つまり、慣れるよ"}, {"type": "subtitle", "time": 15611.51, "timestamp": "04:20:11", "text": "最終的に。でも、もしあなたがここにいるなら"}, {"type": "subtitle", "time": 15615.269, "timestamp": "04:20:15", "text": "部屋に長くいると、"}, {"type": "subtitle", "time": 15617.99, "timestamp": "04:20:17", "text": "正気を失い始める。"}, {"type": "subtitle", "time": 15621.269, "timestamp": "04:20:21", "text": "外に出ることをお勧めします。私は真剣です"}, {"type": "subtitle", "time": 15622.91, "timestamp": "04:20:22", "text": "場合によります。私"}, {"type": "subtitle", "time": 15627.51, "timestamp": "04:20:27", "text": "待つかどうかによると思います。あなたは"}, {"type": "subtitle", "time": 15629.75, "timestamp": "04:20:29", "text": "あなたは屋内にいる方が好きですか、それとも"}, {"type": "subtitle", "time": 15632.87, "timestamp": "04:20:32", "text": "もっとアウトドアを楽しみたい？私は屋内にいるのが好きです"}, {"type": "subtitle", "time": 15636.149, "timestamp": "04:20:36", "text": "もっと。それで、あなたはこう言っているのですね"}, {"type": "subtitle", "time": 15640.95, "timestamp": "04:20:40", "text": "少し悪化した。わかった。なんてこった。"}, {"type": "subtitle", "time": 15643.429, "timestamp": "04:20:43", "text": "まあ、おそらく大丈夫でしょう。おそらく"}, {"type": "subtitle", "time": 15645.99, "timestamp": "04:20:45", "text": "わかった。私は思う"}, {"type": "subtitle", "time": 15650.309, "timestamp": "04:20:50", "text": "きっと私はこう思うと思う、えっと、私は"}, {"type": "subtitle", "time": 15652.63, "timestamp": "04:20:52", "text": "最初の1週間か何かで私が"}, {"type": "subtitle", "time": 15656.229, "timestamp": "04:20:56", "text": "ノートパソコンを手に入れるか、ストリーミングを試みれば"}, {"type": "subtitle", "time": 15659.229, "timestamp": "04:20:59", "text": "電話か何かから"}]
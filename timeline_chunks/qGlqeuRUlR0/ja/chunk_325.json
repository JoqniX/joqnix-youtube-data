[{"type": "subtitle", "time": 19500.15, "timestamp": "05:25:00", "text": "そういうことですよね？うん。そう、それは"}, {"type": "subtitle", "time": 19503.708, "timestamp": "05:25:03", "text": "あなたは強いと思うよ。"}, {"type": "subtitle", "time": 19506.55, "timestamp": "05:25:06", "text": "それで、ドナ、"}, {"type": "subtitle", "time": 19509.99, "timestamp": "05:25:09", "text": "でも、すべてがうまくいくことを願っています。"}, {"type": "subtitle", "time": 19513.51, "timestamp": "05:25:13", "text": "未来も、それに私は"}, {"type": "subtitle", "time": 19516.39, "timestamp": "05:25:16", "text": "私のモデルを見せてくれましたか？"}, {"type": "subtitle", "time": 19518.47, "timestamp": "05:25:18", "text": "え、まだだったの？"}, {"type": "subtitle", "time": 19521.03, "timestamp": "05:25:21", "text": "私は自分が"}, {"type": "subtitle", "time": 19523.83, "timestamp": "05:25:23", "text": "実際にそれをゲストに明かし、"}, {"type": "subtitle", "time": 19526.31, "timestamp": "05:25:26", "text": "秘密にしないでいるように、"}, {"type": "subtitle", "time": 19529.03, "timestamp": "05:25:29", "text": "文字通りの法的問題を抱えている"}, {"type": "subtitle", "time": 19532.83, "timestamp": "05:25:32", "text": "モデルデザインに取り掛かると、私はこう思う"}, {"type": "subtitle", "time": 19536.23, "timestamp": "05:25:36", "text": "おい、このゲームは君が知ってるだろ"}, {"type": "subtitle", "time": 19540.23, "timestamp": "05:25:40", "text": "えっと、この名前は何ですか？"}, {"type": "subtitle", "time": 19543.35, "timestamp": "05:25:43", "text": "また？それで、あのストリーマーは"}, {"type": "subtitle", "time": 19545.83, "timestamp": "05:25:45", "text": "韓国に行って、"}, {"type": "subtitle", "time": 19548.07, "timestamp": "05:25:48", "text": "日本でも混乱が生じている。あなた"}, {"type": "subtitle", "time": 19550.47, "timestamp": "05:25:50", "text": "覚えて"}, {"type": "subtitle", "time": 19552.708, "timestamp": "05:25:52", "text": "彼のお名前は？ジョニー・ソマリ。うん、"}, {"type": "subtitle", "time": 19556.15, "timestamp": "05:25:56", "text": "ジョニー・ソマリ。私は同じ"}, {"type": "subtitle", "time": 19558.31, "timestamp": "05:25:58", "text": "現在の状況。文字通り"}]
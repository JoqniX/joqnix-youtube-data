[{"type": "subtitle", "time": 21121.67, "timestamp": "05:52:01", "text": "ええ、それはする必要はありません。うん、そうだよ"}, {"type": "subtitle", "time": 21124.67, "timestamp": "05:52:04", "text": "フルタイムで働く。おお。"}, {"type": "subtitle", "time": 21126.708, "timestamp": "05:52:06", "text": "[音楽]"}, {"type": "subtitle", "time": 21130.43, "timestamp": "05:52:10", "text": "それと一緒にそれそれ"}, {"type": "subtitle", "time": 21132.868, "timestamp": "05:52:12", "text": "優越性。 IT業界で働いているなら、"}, {"type": "subtitle", "time": 21134.99, "timestamp": "05:52:14", "text": "リモコンが手に入るかもしれない"}, {"type": "subtitle", "time": 21138.11, "timestamp": "05:52:18", "text": "仕事。えっと、でも"}, {"type": "subtitle", "time": 21140.35, "timestamp": "05:52:20", "text": "で"}, {"type": "subtitle", "time": 21142.788, "timestamp": "05:52:22", "text": "あなたはどうするつもりですか？"}, {"type": "subtitle", "time": 21145.83, "timestamp": "05:52:25", "text": "パートタイムの仕事みたいなことをしてるの？ええ、だいたい"}, {"type": "subtitle", "time": 21153.27, "timestamp": "05:52:33", "text": "うん。それが私にできる唯一のことです。それで"}, {"type": "subtitle", "time": 21157.03, "timestamp": "05:52:37", "text": "それから、私も勉強しているから"}, {"type": "subtitle", "time": 21159.11, "timestamp": "05:52:39", "text": "そこには。"}, {"type": "subtitle", "time": 21164.99, "timestamp": "05:52:44", "text": "だからそれは"}, {"type": "subtitle", "time": 21176.548, "timestamp": "05:52:56", "text": "はい。あと、悟飯悟飯を追加しましたか？"}]
[{"type": "subtitle", "time": 3062.63, "timestamp": "00:51:02", "text": "彼。でも、もっと考えてみると"}, {"type": "subtitle", "time": 3079.99, "timestamp": "00:51:19", "text": "ああ、彼女に殺されずに済んで本当に良かった。"}, {"type": "subtitle", "time": 3083.109, "timestamp": "00:51:23", "text": "ああ、このゲームのおかげで、ああ、神様に感謝。それで"}, {"type": "subtitle", "time": 3085.15, "timestamp": "00:51:25", "text": "うん、考えてみると、"}, {"type": "subtitle", "time": 3087.589, "timestamp": "00:51:27", "text": "そうですね、それは難しいですね、私は"}, {"type": "subtitle", "time": 3089.67, "timestamp": "00:51:29", "text": "1時間や2時間の配信も可能です"}, {"type": "subtitle", "time": 3093.27, "timestamp": "00:51:33", "text": "もう。私は本当に怖いです"}, {"type": "subtitle", "time": 3096.829, "timestamp": "00:51:36", "text": "与えないこと、好きにならないこと"}, {"type": "subtitle", "time": 3100.15, "timestamp": "00:51:40", "text": "もの。私は何人いるだろうか"}]
[{"type": "subtitle", "time": 18301.59, "timestamp": "05:05:01", "text": "コラボレーションとか何とか。しかし、"}, {"type": "subtitle", "time": 18303.75, "timestamp": "05:05:03", "text": "つまり、私の意図は"}, {"type": "subtitle", "time": 18313.47, "timestamp": "05:05:13", "text": "それもまた然り。そして私は感じた"}, {"type": "subtitle", "time": 18316.31, "timestamp": "05:05:16", "text": "悪い。うん。いいえ、大丈夫です。やめて、やめて"}, {"type": "subtitle", "time": 18320.15, "timestamp": "05:05:20", "text": "気分が悪い。つまり、もし彼らが望めば"}, {"type": "subtitle", "time": 18322.55, "timestamp": "05:05:22", "text": "彼らは協力するだろう。はい。はい。はい。のように"}, {"type": "subtitle", "time": 18324.19, "timestamp": "05:05:24", "text": "日本人"}, {"type": "subtitle", "time": 18329.11, "timestamp": "05:05:29", "text": "特にほとんどの、つまりそうではない"}, {"type": "subtitle", "time": 18332.628, "timestamp": "05:05:32", "text": "全員、ほとんどはそうではない"}, {"type": "subtitle", "time": 18335.51, "timestamp": "05:05:35", "text": "本当にコラボレーションしているように、"}, {"type": "subtitle", "time": 18340.628, "timestamp": "05:05:40", "text": "主に自分のものが好きではない"}, {"type": "subtitle", "time": 18343.99, "timestamp": "05:05:43", "text": "人と交流する頻度が高いので、"}, {"type": "subtitle", "time": 18353.55, "timestamp": "05:05:53", "text": "だから、誰を好きになるかは分からない"}, {"type": "subtitle", "time": 18357.51, "timestamp": "05:05:57", "text": "探す。だから私はこう言うと思う"}]
[{"type": "subtitle", "time": 17163.28, "timestamp": "04:46:03", "text": "それは良いことなのか、悪いことなのか？どう思いますか？"}, {"type": "subtitle", "time": 17176.628, "timestamp": "04:46:16", "text": "116. それは悪いですか、それとも"}, {"type": "subtitle", "time": 17180.788, "timestamp": "04:46:20", "text": "まあ、悪くはないですね。だから私が買うなら"}, {"type": "subtitle", "time": 17182.868, "timestamp": "04:46:22", "text": "物を買うなら日本から買った方がいいし、"}, {"type": "subtitle", "time": 17190.11, "timestamp": "04:46:30", "text": "品質を重視するなら、"}, {"type": "subtitle", "time": 17192.91, "timestamp": "04:46:32", "text": "日本で購入。"}, {"type": "subtitle", "time": 17196.788, "timestamp": "04:46:36", "text": "でも、もしあなたがそれを一緒に持って来られるなら、"}, {"type": "subtitle", "time": 17199.03, "timestamp": "04:46:39", "text": "何か持参するか、または"}, {"type": "subtitle", "time": 17202.15, "timestamp": "04:46:42", "text": "インドのような場所、"}, {"type": "subtitle", "time": 17205.75, "timestamp": "04:46:45", "text": "いくつか買った方がいいと思います"}, {"type": "subtitle", "time": 17209.67, "timestamp": "04:46:49", "text": "何かを取ることから"}, {"type": "subtitle", "time": 17211.91, "timestamp": "04:46:51", "text": "あなたと一緒に、購入する必要がない"}, {"type": "subtitle", "time": 17214.788, "timestamp": "04:46:54", "text": "日本。うん。すでに持っている場合"}, {"type": "subtitle", "time": 17217.708, "timestamp": "04:46:57", "text": "何か、持ってきてくれるといいのですが"}]
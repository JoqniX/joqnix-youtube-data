[{"type": "subtitle", "time": 5042.11, "timestamp": "01:24:02", "text": "ああ、でも私は1つのチャレンジを受けました"}, {"type": "subtitle", "time": 5044.709, "timestamp": "01:24:04", "text": "終わり。私たちは1つの課題を達成しました"}, {"type": "subtitle", "time": 5048.43, "timestamp": "01:24:08", "text": "けれど。ああ、彼は"}, {"type": "subtitle", "time": 5052.95, "timestamp": "01:24:12", "text": "彼は殴った人全員を殺した。それで、えっと、何"}, {"type": "subtitle", "time": 5055.83, "timestamp": "01:24:15", "text": "何が起こっているのか？だから、私は"}, {"type": "subtitle", "time": 5059.51, "timestamp": "01:24:19", "text": "このイベントのチャレンジに勝つ"}, {"type": "subtitle", "time": 5061.95, "timestamp": "01:24:21", "text": "遠い。ちょっと待って、列に並ぶよ。"}, {"type": "subtitle", "time": 5066.39, "timestamp": "01:24:26", "text": "初め。これまでのところ、我々は勝利を収めることができている。それ"}, {"type": "subtitle", "time": 5069.51, "timestamp": "01:24:29", "text": "完了しました。私たちは15人全員の命を救う必要がありました。それ"}, {"type": "subtitle", "time": 5072.39, "timestamp": "01:24:32", "text": "つまり、殺されたら、"}, {"type": "subtitle", "time": 5075.189, "timestamp": "01:24:35", "text": "先ほど見た、凍結状態からの解放状態です。"}, {"type": "subtitle", "time": 5077.11, "timestamp": "01:24:37", "text": "つまり、あなたのチームメイトは誰であれ"}, {"type": "subtitle", "time": 5079.189, "timestamp": "01:24:39", "text": "生きてるなら、彼らは君を解凍する必要がある。それは"}, {"type": "subtitle", "time": 5080.51, "timestamp": "01:24:40", "text": "呼ばれる"}, {"type": "subtitle", "time": 5083.59, "timestamp": "01:24:43", "text": "投げる。新しいレンガのスクリーン。はい。そして新しい"}, {"type": "subtitle", "time": 5086.95, "timestamp": "01:24:46", "text": "レンガの外壁。はい。だから、これを手に入れたら、"}, {"type": "subtitle", "time": 5089.11, "timestamp": "01:24:49", "text": "完了しました。この武器のお守りを手に入れよう"}, {"type": "subtitle", "time": 5090.91, "timestamp": "01:24:50", "text": "そして皮膚は"}, {"type": "subtitle", "time": 5095.39, "timestamp": "01:24:55", "text": "良い。ええ、私たちはただ"}]
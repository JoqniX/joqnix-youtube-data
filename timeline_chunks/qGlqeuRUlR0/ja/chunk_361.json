[{"type": "subtitle", "time": 21660.4, "timestamp": "06:01:00", "text": "うん。 もちろん。もちろん。気をつけて。気をつけて。感謝"}, {"type": "subtitle", "time": 21663.12, "timestamp": "06:01:03", "text": "もちろん。もちろん。気をつけて。気をつけて。感謝 今日はあなたへ。"}, {"type": "subtitle", "time": 21665.68, "timestamp": "06:01:05", "text": "今日はあなたへ。 こんにちは、"}, {"type": "subtitle", "time": 21667.36, "timestamp": "06:01:07", "text": "こんにちは、 感謝"}, {"type": "subtitle", "time": 21673.83, "timestamp": "06:01:13", "text": "あなた。チャットを聞いてくれてありがとう。"}, {"type": "subtitle", "time": 21675.23, "timestamp": "06:01:15", "text": "感謝"}, {"type": "subtitle", "time": 21677.75, "timestamp": "06:01:17", "text": "あなた。そして、購読もお忘れなく"}, {"type": "subtitle", "time": 21679.99, "timestamp": "06:01:19", "text": "カヤ。"}, {"type": "subtitle", "time": 21682.708, "timestamp": "06:01:22", "text": "私を購読しないでください。"}, {"type": "subtitle", "time": 21685.75, "timestamp": "06:01:25", "text": "コンテンツが一切ありません。"}, {"type": "subtitle", "time": 21686.83, "timestamp": "06:01:26", "text": "その"}, {"type": "subtitle", "time": 21690.07, "timestamp": "06:01:30", "text": "わかった。過去のコンテンツをチェックしてみてください。"}, {"type": "subtitle", "time": 21692.07, "timestamp": "06:01:32", "text": "良いチャンネルです。バカ、何してるの？"}, {"type": "subtitle", "time": 21699.19, "timestamp": "06:01:39", "text": "こんにちは。わかった。"}, {"type": "subtitle", "time": 21719.99, "timestamp": "06:01:59", "text": "あなた。それがケイ・ニッキーでした。"}]
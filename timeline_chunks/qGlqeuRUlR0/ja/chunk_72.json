[{"type": "subtitle", "time": 4322.31, "timestamp": "01:12:02", "text": "すぐ。ああ、君が彼らを殺したんだね。ニース。それは"}, {"type": "subtitle", "time": 4355.31, "timestamp": "01:12:35", "text": "もうない。彼らは私を殺します。うん。"}, {"type": "subtitle", "time": 4359.83, "timestamp": "01:12:39", "text": "何？私たちは勝った。はい、私が勝ちました。チャレンジ。 1つ"}, {"type": "subtitle", "time": 4361.709, "timestamp": "01:12:41", "text": "チャレンジ完了。さあ"}, {"type": "subtitle", "time": 4364.75, "timestamp": "01:12:44", "text": "行く。私たちは勝った。私たちは"}, {"type": "subtitle", "time": 4368.27, "timestamp": "01:12:48", "text": "勝利した。ねえ、誰がいい選手だったっけ？"}, {"type": "subtitle", "time": 4371.59, "timestamp": "01:12:51", "text": "あらら。私はその試合の最優秀選手だった。"}, {"type": "subtitle", "time": 4372.43, "timestamp": "01:12:52", "text": "待って、"}, {"type": "subtitle", "time": 4374.95, "timestamp": "01:12:54", "text": "何？私は何をしたの？私は何をしたの？それ"}, {"type": "subtitle", "time": 4379.149, "timestamp": "01:12:59", "text": "1対1のキル。わかった。そして私は"}]
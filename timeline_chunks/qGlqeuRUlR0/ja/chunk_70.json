[{"type": "subtitle", "time": 4211.43, "timestamp": "01:10:11", "text": "はい。もう一人いる。"}, {"type": "subtitle", "time": 4218.63, "timestamp": "01:10:18", "text": "やったー、勝った！"}, {"type": "subtitle", "time": 4220.39, "timestamp": "01:10:20", "text": "あなたは何を、あなたは何を、あなたは安定した運動選手ですか、"}, {"type": "subtitle", "time": 4222.47, "timestamp": "01:10:22", "text": "息子？私は英文学を専攻しています"}, {"type": "subtitle", "time": 4224.79, "timestamp": "01:10:24", "text": "あれ。何が"}, {"type": "subtitle", "time": 4226.11, "timestamp": "01:10:26", "text": "何が起こっているのか"}, {"type": "subtitle", "time": 4228.55, "timestamp": "01:10:28", "text": "それ。何が何だか分からない"}, {"type": "subtitle", "time": 4232.229, "timestamp": "01:10:32", "text": "実際、そういうことが起きているんです。"}, {"type": "subtitle", "time": 4236.149, "timestamp": "01:10:36", "text": "自分の専門分野の勉強すらしていない。"}, {"type": "subtitle", "time": 4238.11, "timestamp": "01:10:38", "text": "私は"}, {"type": "subtitle", "time": 4240.87, "timestamp": "01:10:40", "text": "私の持ち物と、その他やらなければならないこと"}, {"type": "subtitle", "time": 4242.669, "timestamp": "01:10:42", "text": "なぜなら"}, {"type": "subtitle", "time": 4246.11, "timestamp": "01:10:46", "text": "優先事項として、私もそれをする必要があります"}]
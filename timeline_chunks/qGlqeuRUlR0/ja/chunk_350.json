[{"type": "subtitle", "time": 21007.19, "timestamp": "05:50:07", "text": "そして、お店では時々、"}, {"type": "subtitle", "time": 21011.868, "timestamp": "05:50:11", "text": "スタッフがあなたに話しかけます"}, {"type": "subtitle", "time": 21014.868, "timestamp": "05:50:14", "text": "英語、あるいは私が話していたように"}, {"type": "subtitle", "time": 21018.628, "timestamp": "05:50:18", "text": "スタッフは日本人のように、すべての日本人のように"}, {"type": "subtitle", "time": 21022.23, "timestamp": "05:50:22", "text": "そして最後に私が話していたように"}, {"type": "chat", "time": 21023.384, "timestamp": "05:50:23", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "hey hey fellas how's it going?"}, {"type": "subtitle", "time": 21024.47, "timestamp": "05:50:24", "text": "彼女に問題について相談した。私は"}, {"type": "subtitle", "time": 21028.868, "timestamp": "05:50:28", "text": "質問して彼女は行って持ってきました"}, {"type": "subtitle", "time": 21031.59, "timestamp": "05:50:31", "text": "英語を話せるスタッフと"}, {"type": "subtitle", "time": 21035.99, "timestamp": "05:50:35", "text": "英語で話しかけてきて、"}, {"type": "subtitle", "time": 21038.31, "timestamp": "05:50:38", "text": "それは突然のことだった。だから私は話し続けた"}, {"type": "subtitle", "time": 21040.548, "timestamp": "05:50:40", "text": "日本語で話し続け"}, {"type": "subtitle", "time": 21043.67, "timestamp": "05:50:43", "text": "英語で、すごく変な感じだった"}, {"type": "subtitle", "time": 21046.548, "timestamp": "05:50:46", "text": "何？"}, {"type": "subtitle", "time": 21051.31, "timestamp": "05:50:51", "text": "私が彼らに言ったように、彼らはこれを承認します"}, {"type": "subtitle", "time": 21056.11, "timestamp": "05:50:56", "text": "日本語で「大丈夫」みたいな感じ"}, {"type": "subtitle", "time": 21059.75, "timestamp": "05:50:59", "text": "しかし彼らは英語で話し続けた"}]
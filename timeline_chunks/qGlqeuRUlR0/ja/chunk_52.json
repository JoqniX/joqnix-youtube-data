[{"type": "subtitle", "time": 3121.95, "timestamp": "00:52:01", "text": "ああ、"}, {"type": "subtitle", "time": 3125.43, "timestamp": "00:52:05", "text": "後ろに。それで、えーと、私たちは"}, {"type": "subtitle", "time": 3128.15, "timestamp": "00:52:08", "text": "雪玉をキャッチして、"}, {"type": "subtitle", "time": 3131.109, "timestamp": "00:52:11", "text": "この試合に勝つ、"}, {"type": "subtitle", "time": 3134.349, "timestamp": "00:52:14", "text": "このモード。だから、私たちは"}, {"type": "subtitle", "time": 3137.589, "timestamp": "00:52:17", "text": "ブロック。えっと、あと4つ雪玉が必要だと思う。"}, {"type": "subtitle", "time": 3141.19, "timestamp": "00:52:21", "text": "そうです、壁の方です。ああ、死んでしまった。"}, {"type": "subtitle", "time": 3143.91, "timestamp": "00:52:23", "text": "大丈夫です。私たちは壁を塞ごうとした。"}, {"type": "subtitle", "time": 3146.589, "timestamp": "00:52:26", "text": "私たちは人々を集めようとしました"}, {"type": "subtitle", "time": 3152.99, "timestamp": "00:52:32", "text": "[音楽]"}, {"type": "subtitle", "time": 3166.109, "timestamp": "00:52:46", "text": "私を見て。私を見て。見て"}, {"type": "subtitle", "time": 3175.03, "timestamp": "00:52:55", "text": "壁。ああ、彼らはみんな撃つとき"}]
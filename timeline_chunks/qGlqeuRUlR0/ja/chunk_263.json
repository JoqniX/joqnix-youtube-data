[{"type": "subtitle", "time": 15781.189, "timestamp": "04:23:01", "text": "騒音苦情のようなことは考えません"}, {"type": "subtitle", "time": 15782.349, "timestamp": "04:23:02", "text": "だろう"}, {"type": "subtitle", "time": 15786.389, "timestamp": "04:23:06", "text": "特に寮ではできるだけ"}, {"type": "subtitle", "time": 15791.03, "timestamp": "04:23:11", "text": "部屋なら大丈夫ですよ。そうだといい。うん、"}, {"type": "subtitle", "time": 15795.87, "timestamp": "04:23:15", "text": "ほとんどの場合、まあ、もし"}, {"type": "subtitle", "time": 15799.189, "timestamp": "04:23:19", "text": "あなたが寮にいるなら、"}, {"type": "subtitle", "time": 15801.91, "timestamp": "04:23:21", "text": "おそらく大丈夫でしょう。そしてあなたは行くことができます"}, {"type": "subtitle", "time": 15804.87, "timestamp": "04:23:24", "text": "マンガカフェやインターネットカフェに行くけど、"}, {"type": "subtitle", "time": 15808.229, "timestamp": "04:23:28", "text": "そこは静かだとは思わないで"}, {"type": "subtitle", "time": 15811.75, "timestamp": "04:23:31", "text": "同じくらい。それも重要な点です。私"}, {"type": "subtitle", "time": 15814.149, "timestamp": "04:23:34", "text": "ボーカルのような楽器をどこでレンタルできるかわかりません"}, {"type": "subtitle", "time": 15816.87, "timestamp": "04:23:36", "text": "ブースや防音室のような"}, {"type": "subtitle", "time": 15820.469, "timestamp": "04:23:40", "text": "空間。ああ、仕事用のオフィスみたいなものがある"}, {"type": "subtitle", "time": 15824.95, "timestamp": "04:23:44", "text": "カプセルのような場所もある。"}, {"type": "subtitle", "time": 15828.229, "timestamp": "04:23:48", "text": "実際に見たことはないけど、"}, {"type": "subtitle", "time": 15837.59, "timestamp": "04:23:57", "text": "他にどんなものがあるかな"}]
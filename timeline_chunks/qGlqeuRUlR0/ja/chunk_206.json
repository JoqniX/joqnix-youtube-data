[{"type": "subtitle", "time": 12374.91, "timestamp": "03:26:14", "text": "見る。私は自分が何ができるかを知っている"}, {"type": "subtitle", "time": 12381.11, "timestamp": "03:26:21", "text": "実は。ジョアトンって何？ジョアトンは"}, {"type": "subtitle", "time": 12383.83, "timestamp": "03:26:23", "text": "サブマラソンとか寄付とか、そういうの。"}, {"type": "subtitle", "time": 12387.03, "timestamp": "03:26:27", "text": "クラウドファンディングみたいなもの。むしろ私は"}, {"type": "subtitle", "time": 12390.229, "timestamp": "03:26:30", "text": "それはマラソン配信のようなもので、私は"}, {"type": "subtitle", "time": 12393.51, "timestamp": "03:26:33", "text": "しばらくストリーミングを続けてください"}, {"type": "subtitle", "time": 12397.269, "timestamp": "03:26:37", "text": "間隔。私は4ヶ月間ジョアソンに参加します"}, {"type": "subtitle", "time": 12406.3, "timestamp": "03:26:46", "text": "ええ、そうです"}, {"type": "subtitle", "time": 12408.59, "timestamp": "03:26:48", "text": "[音楽]"}, {"type": "subtitle", "time": 12411.75, "timestamp": "03:26:51", "text": "えっと、クラウドファンディングみたいな感じなので"}, {"type": "subtitle", "time": 12414.63, "timestamp": "03:26:54", "text": "V2モデルとリギングを初披露できます"}, {"type": "subtitle", "time": 12418.229, "timestamp": "03:26:58", "text": "そして全て。少し値段が高いので"}]
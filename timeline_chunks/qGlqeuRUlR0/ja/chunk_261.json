[{"type": "subtitle", "time": 15663.59, "timestamp": "04:21:03", "text": "家に帰りたい気分だ。これはとても"}, {"type": "subtitle", "time": 15670.07, "timestamp": "04:21:10", "text": "私はそんな風に感じるだろう、私はそれを感じることができる。私"}, {"type": "subtitle", "time": 15672.309, "timestamp": "04:21:12", "text": "感じ取れる。"}, {"type": "subtitle", "time": 15675.03, "timestamp": "04:21:15", "text": "感じるよ。それが顔です"}, {"type": "subtitle", "time": 15679.03, "timestamp": "04:21:19", "text": "時々やって来る。"}, {"type": "subtitle", "time": 15681.269, "timestamp": "04:21:21", "text": "うん、昔はこう感じていたと思う"}, {"type": "subtitle", "time": 15683.11, "timestamp": "04:21:23", "text": "時々、ほら、私が最初に"}, {"type": "subtitle", "time": 15686.71, "timestamp": "04:21:26", "text": "2ヶ月くらいここに来たんだけど、"}, {"type": "subtitle", "time": 15691.71, "timestamp": "04:21:31", "text": "まるで自分が日本にいるかのように信じたくない。のように"}, {"type": "subtitle", "time": 15694.75, "timestamp": "04:21:34", "text": "ほとんどの場合、私は"}, {"type": "subtitle", "time": 15698.11, "timestamp": "04:21:38", "text": "普段通りの日々を過ごす"}, {"type": "subtitle", "time": 15702.55, "timestamp": "04:21:42", "text": "以前はすごく変な感じがしていたルーティン"}, {"type": "subtitle", "time": 15706.229, "timestamp": "04:21:46", "text": "場違いな感じ、いや、私は"}, {"type": "subtitle", "time": 15709.51, "timestamp": "04:21:49", "text": "実際にはここにあるわけではなく、すべてはただ"}, {"type": "subtitle", "time": 15711.87, "timestamp": "04:21:51", "text": "夢"}, {"type": "subtitle", "time": 15715.229, "timestamp": "04:21:55", "text": "でも、私は"}, {"type": "subtitle", "time": 15717.79, "timestamp": "04:21:57", "text": "まるで私が"}]
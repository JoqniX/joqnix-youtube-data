[{"type": "subtitle", "time": 17520.55, "timestamp": "04:52:00", "text": "それ。さらに、私の会社は私に"}, {"type": "subtitle", "time": 17523.27, "timestamp": "04:52:03", "text": "開発や仕事などに適したノートパソコン。"}, {"type": "subtitle", "time": 17528.31, "timestamp": "04:52:08", "text": "だから、私は本当に買う必要はない"}, {"type": "subtitle", "time": 17532.47, "timestamp": "04:52:12", "text": "できるだけ早く。そう、私は勝てる"}, {"type": "subtitle", "time": 17534.47, "timestamp": "04:52:14", "text": "それについてあなたに話してください。"}, {"type": "subtitle", "time": 17544.55, "timestamp": "04:52:24", "text": "ああ、だってノートパソコンはもう諦めたんだもん"}, {"type": "subtitle", "time": 17549.03, "timestamp": "04:52:29", "text": "そういうもの、そして私はPCを買う予定です"}, {"type": "subtitle", "time": 17552.31, "timestamp": "04:52:32", "text": "パーツ選びとゲーミングPCの組み立て"}, {"type": "subtitle", "time": 17558.03, "timestamp": "04:52:38", "text": "すぐ。うん。私の最初のゲーミングPC。"}, {"type": "subtitle", "time": 17562.23, "timestamp": "04:52:42", "text": "ええ、そうですね。そうすれば、"}, {"type": "subtitle", "time": 17566.11, "timestamp": "04:52:46", "text": "YouTube関連のコンテンツ。うん。"}, {"type": "subtitle", "time": 17570.07, "timestamp": "04:52:50", "text": "うん、楽しそうだね。私も買いたい"}, {"type": "subtitle", "time": 17574.83, "timestamp": "04:52:54", "text": "今はノートパソコンを使っています。だから私はこう思う、私は"}, {"type": "subtitle", "time": 17579.19, "timestamp": "04:52:59", "text": "買う？どんな「君の瞬間」？"}]
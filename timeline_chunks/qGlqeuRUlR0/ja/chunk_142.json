[{"type": "subtitle", "time": 8543.309, "timestamp": "02:22:23", "text": "えーと、どうやって隠れればいいの？"}, {"type": "subtitle", "time": 8552.83, "timestamp": "02:22:32", "text": "店？えっと、私の"}, {"type": "subtitle", "time": 8555.63, "timestamp": "02:22:35", "text": "[音楽]"}, {"type": "subtitle", "time": 8564.63, "timestamp": "02:22:44", "text": "うん。私たちはコラボレーションを行います"}, {"type": "subtitle", "time": 8567.309, "timestamp": "02:22:47", "text": "4日目か5日目。"}, {"type": "subtitle", "time": 8571.03, "timestamp": "02:22:51", "text": "わかった。だって、私はまだ作ってないんだ"}, {"type": "subtitle", "time": 8573.469, "timestamp": "02:22:53", "text": "コラボサーバー"}, {"type": "subtitle", "time": 8577.79, "timestamp": "02:22:57", "text": "まだ。だから、私がしなければならないことの一つは"}]
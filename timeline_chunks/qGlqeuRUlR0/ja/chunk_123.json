[{"type": "subtitle", "time": 7412.109, "timestamp": "02:03:32", "text": "いいえ"}, {"type": "subtitle", "time": 7420.149, "timestamp": "02:03:40", "text": "[拍手]"}, {"type": "subtitle", "time": 7423.43, "timestamp": "02:03:43", "text": "ヒーラーはいません。何てことだ。"}, {"type": "subtitle", "time": 7425.42, "timestamp": "02:03:45", "text": "つまり、ヒーラーになるのは構わないんだけど。"}, {"type": "subtitle", "time": 7427.55, "timestamp": "02:03:47", "text": "[音楽]"}, {"type": "subtitle", "time": 7431.109, "timestamp": "02:03:51", "text": "モード。うん。さよなら。私は"}, {"type": "subtitle", "time": 7433.99, "timestamp": "02:03:53", "text": "背が高い、勝利ではない。彼らはそうではない"}, {"type": "subtitle", "time": 7435.709, "timestamp": "02:03:55", "text": "私たちに"}]
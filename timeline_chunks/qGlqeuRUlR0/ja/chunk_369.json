[{"type": "subtitle", "time": 22143.39, "timestamp": "06:09:03", "text": "あなたが望むなら、私たちはできます"}, {"type": "subtitle", "time": 22145.548, "timestamp": "06:09:05", "text": "スケジュールを変更する"}, {"type": "subtitle", "time": 22149.51, "timestamp": "06:09:09", "text": "いつになったら彼女を元の場所に戻せるのでしょうか？えっと、いつ"}, {"type": "subtitle", "time": 22150.43, "timestamp": "06:09:10", "text": "私は"}, {"type": "subtitle", "time": 22152.91, "timestamp": "06:09:12", "text": "彼女"}, {"type": "subtitle", "time": 22156.31, "timestamp": "06:09:16", "text": "明日？私はサボットを装着しています"}, {"type": "subtitle", "time": 22167.75, "timestamp": "06:09:27", "text": "はい、この種類の"}, {"type": "subtitle", "time": 22170.948, "timestamp": "06:09:30", "text": "そういうことは起こらない。それは"}, {"type": "subtitle", "time": 22174.628, "timestamp": "06:09:34", "text": "計画全体を台無しにするが、"}, {"type": "subtitle", "time": 22177.788, "timestamp": "06:09:37", "text": "直前まで営業を続けなければならない"}, {"type": "subtitle", "time": 22180.868, "timestamp": "06:09:40", "text": "調整。ええ、順応できますよ。だから私は"}, {"type": "subtitle", "time": 22182.948, "timestamp": "06:09:42", "text": "桃を乗せてみようかなと考えていました"}, {"type": "subtitle", "time": 22185.23, "timestamp": "06:09:45", "text": "明日のために"}, {"type": "subtitle", "time": 22187.708, "timestamp": "06:09:47", "text": "そして、次のようにする"}, {"type": "subtitle", "time": 22191.868, "timestamp": "06:09:51", "text": "それ。それは役に立つかもしれない。"}, {"type": "subtitle", "time": 22195.548, "timestamp": "06:09:55", "text": "ああ、フォローありがとうございます"}, {"type": "subtitle", "time": 22198.47, "timestamp": "06:09:58", "text": "カイ、君はTwitchに来たね。ありがとう。"}]
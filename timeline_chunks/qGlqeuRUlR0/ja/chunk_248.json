[{"type": "subtitle", "time": 14880.87, "timestamp": "04:08:00", "text": "みんな。こんにちは。それで、申し訳ないのですが"}, {"type": "subtitle", "time": 14882.95, "timestamp": "04:08:02", "text": "今まさに現れている。えっと、そうじゃない"}, {"type": "subtitle", "time": 14885.11, "timestamp": "04:08:05", "text": "すみませんが、ランニングをしなければならなかったので"}, {"type": "subtitle", "time": 14887.59, "timestamp": "04:08:07", "text": "すべて。それでは、86日目へようこそ"}, {"type": "subtitle", "time": 14890.87, "timestamp": "04:08:10", "text": "ジャカソン。今日は、えーと"}, {"type": "subtitle", "time": 14893.87, "timestamp": "04:08:13", "text": "私たちはカと一緒にウィングします"}, {"type": "subtitle", "time": 14897.91, "timestamp": "04:08:17", "text": "ニッキー。こんにちは、カイサン。"}, {"type": "subtitle", "time": 14900.63, "timestamp": "04:08:20", "text": "こんにちは。"}, {"type": "subtitle", "time": 14903.83, "timestamp": "04:08:23", "text": "本当に久しぶりですね。"}, {"type": "subtitle", "time": 14906.63, "timestamp": "04:08:26", "text": "逃す、"}, {"type": "subtitle", "time": 14910.309, "timestamp": "04:08:30", "text": "私もあなたがいなくて寂しい。そうですね、"}, {"type": "subtitle", "time": 14913.67, "timestamp": "04:08:33", "text": "長さ。長すぎる。私たちには 1 つだけありました"}, {"type": "subtitle", "time": 14917.229, "timestamp": "04:08:37", "text": "コラボレーション。はい。 1つしかなかった"}, {"type": "subtitle", "time": 14921.03, "timestamp": "04:08:41", "text": "コラボレーション。それで、"}, {"type": "chat", "time": 14930.561, "timestamp": "04:08:50", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "Yooo"}]
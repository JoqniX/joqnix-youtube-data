[{"type": "subtitle", "time": 16802.23, "timestamp": "04:40:02", "text": "あなたのヘッドホン。"}, {"type": "subtitle", "time": 16805.67, "timestamp": "04:40:05", "text": "SIMカードすら使えない。"}, {"type": "subtitle", "time": 16808.788, "timestamp": "04:40:08", "text": "そうそう。"}, {"type": "subtitle", "time": 16810.948, "timestamp": "04:40:10", "text": "平和の中で。"}, {"type": "subtitle", "time": 16816.07, "timestamp": "04:40:16", "text": "大丈夫。それは痛みだ。しかし、"}, {"type": "subtitle", "time": 16820.07, "timestamp": "04:40:20", "text": "ある日。 1日か、どれくらいかかるか"}, {"type": "subtitle", "time": 16822.07, "timestamp": "04:40:22", "text": "あなたのフライトは？わからない。まだ"}, {"type": "subtitle", "time": 16824.55, "timestamp": "04:40:24", "text": "まだ確認されていません。わからない。彼らは持っている"}, {"type": "subtitle", "time": 16838.47, "timestamp": "04:40:38", "text": "えっと、"}, {"type": "subtitle", "time": 16842.31, "timestamp": "04:40:42", "text": "待って、あなたは健康のために何をしたのですか"}, {"type": "subtitle", "time": 16845.23, "timestamp": "04:40:45", "text": "保険とかそういう類のもの？"}, {"type": "subtitle", "time": 16848.948, "timestamp": "04:40:48", "text": "ええ、そうしたいです。教えてあげる"}, {"type": "subtitle", "time": 16856.708, "timestamp": "04:40:56", "text": "えっと、空港に着いたら"}, {"type": "subtitle", "time": 16859.43, "timestamp": "04:40:59", "text": "空港に到着したら"}]
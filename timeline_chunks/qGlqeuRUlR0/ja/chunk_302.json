[{"type": "subtitle", "time": 18120.708, "timestamp": "05:02:00", "text": "私が作ったように、どうぞ。"}, {"type": "subtitle", "time": 18124.35, "timestamp": "05:02:04", "text": "何？どうぞ。どうぞ。えっと"}, {"type": "subtitle", "time": 18127.628, "timestamp": "05:02:07", "text": "えーと、問題は"}, {"type": "subtitle", "time": 18131.948, "timestamp": "05:02:11", "text": "えっと、やりたいんだけど、どうすればいいか"}, {"type": "subtitle", "time": 18134.948, "timestamp": "05:02:14", "text": "日本のユーチューバーはこれを"}, {"type": "subtitle", "time": 18137.83, "timestamp": "05:02:17", "text": "専門的にも取引的にも"}, {"type": "subtitle", "time": 18140.39, "timestamp": "05:02:20", "text": "非常識な。いいえ"}, {"type": "subtitle", "time": 18142.628, "timestamp": "05:02:22", "text": "伝統的な形式のように"}, {"type": "subtitle", "time": 18144.708, "timestamp": "05:02:24", "text": "すべてをフォーマットしてください。ああ、それはとても"}, {"type": "subtitle", "time": 18147.83, "timestamp": "05:02:27", "text": "痛み。しかし、それは痛みではない。それは適切です"}, {"type": "subtitle", "time": 18157.03, "timestamp": "05:02:37", "text": "それは人による、ということだ。私は思う"}, {"type": "subtitle", "time": 18159.23, "timestamp": "05:02:39", "text": "確かに、落ち着いた人たちもいる"}, {"type": "subtitle", "time": 18162.11, "timestamp": "05:02:42", "text": "そこは"}, {"type": "subtitle", "time": 18163.868, "timestamp": "05:02:43", "text": "えっと"}, {"type": "subtitle", "time": 18166.948, "timestamp": "05:02:46", "text": "ほとんど私のような人"}, {"type": "subtitle", "time": 18170.99, "timestamp": "05:02:50", "text": "コラボレーションした人たちは、それについて寛容だった。"}, {"type": "subtitle", "time": 18174.07, "timestamp": "05:02:54", "text": "でも、あなたと同じように、"}, {"type": "subtitle", "time": 18178.39, "timestamp": "05:02:58", "text": "誰かを見つけて、その人に聞いてみて"}]
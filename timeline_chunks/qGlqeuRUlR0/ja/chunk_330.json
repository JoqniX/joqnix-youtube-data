[{"type": "subtitle", "time": 19801.43, "timestamp": "05:30:01", "text": "私の人生で、私は、私が立っているのが好きです"}, {"type": "subtitle", "time": 19804.15, "timestamp": "05:30:04", "text": "自分のために立ち上がり、泣かず、"}, {"type": "subtitle", "time": 19807.35, "timestamp": "05:30:07", "text": "彼らに私を彼らのものにするように懇願してください"}, {"type": "subtitle", "time": 19810.39, "timestamp": "05:30:10", "text": "また友達に戻れるとか、そんな感じ。私はただ"}, {"type": "subtitle", "time": 19812.708, "timestamp": "05:30:12", "text": "「ああ、あなたは私の"}, {"type": "subtitle", "time": 19815.27, "timestamp": "05:30:15", "text": "境界線とすべてとすべて"}, {"type": "subtitle", "time": 19817.15, "timestamp": "05:30:17", "text": "また、試してみて"}, {"type": "subtitle", "time": 19821.11, "timestamp": "05:30:21", "text": "自分の趣味を攻撃し、"}, {"type": "subtitle", "time": 19823.99, "timestamp": "05:30:23", "text": "コミュニティとか色々あるけど、"}, {"type": "subtitle", "time": 19826.708, "timestamp": "05:30:26", "text": "「私の個人情報を全部晒して」だから私はこう思った。"}, {"type": "subtitle", "time": 19829.43, "timestamp": "05:30:29", "text": "お前とは完全に縁を切るつもりだ。"}, {"type": "subtitle", "time": 19831.75, "timestamp": "05:30:31", "text": "そしてそれはまるでドラマのようだった"}, {"type": "subtitle", "time": 19834.548, "timestamp": "05:30:34", "text": "私の家や物に石を投げつけ、"}, {"type": "subtitle", "time": 19837.868, "timestamp": "05:30:37", "text": "えーと、窓とかそういうもの。まだ"}, {"type": "subtitle", "time": 19852.868, "timestamp": "05:30:52", "text": "それ以来、私は「うん、言わないよ」って感じ"}, {"type": "subtitle", "time": 19855.75, "timestamp": "05:30:55", "text": "もはや友人ではない。"}, {"type": "subtitle", "time": 19859.15, "timestamp": "05:30:59", "text": "私はなんてバカなんだろう。それは分かります。それは分かります。"}]
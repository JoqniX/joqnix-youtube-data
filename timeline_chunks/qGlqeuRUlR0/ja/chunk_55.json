[{"type": "subtitle", "time": 3310.829, "timestamp": "00:55:10", "text": "準備ができて。ああ、"}, {"type": "subtitle", "time": 3312.67, "timestamp": "00:55:12", "text": "神。"}, {"type": "subtitle", "time": 3315.75, "timestamp": "00:55:15", "text": "待って。ブロックできたはずなのに"}, {"type": "subtitle", "time": 3318.71, "timestamp": "00:55:18", "text": "なぜ私はそれをブロックできなかったのだろうか？おお"}, {"type": "subtitle", "time": 3319.87, "timestamp": "00:55:19", "text": "私の"}, {"type": "subtitle", "time": 3323.309, "timestamp": "00:55:23", "text": "神。何てことだ。"}, {"type": "subtitle", "time": 3327.03, "timestamp": "00:55:27", "text": "わかった。皆さん、手伝っていただけますか？待って、私はできる"}, {"type": "subtitle", "time": 3331.03, "timestamp": "00:55:31", "text": "チャットで質問してください。よし。"}, {"type": "subtitle", "time": 3333.04, "timestamp": "00:55:33", "text": "私のところへ来なさい。"}, {"type": "subtitle", "time": 3340.39, "timestamp": "00:55:40", "text": "おそらく残り5分。"}, {"type": "subtitle", "time": 3342.549, "timestamp": "00:55:42", "text": "うん。こんにちは、エドワード。うん。あなたは何を"}, {"type": "subtitle", "time": 3344.91, "timestamp": "00:55:44", "text": "平均？それは"}, {"type": "subtitle", "time": 3353.43, "timestamp": "00:55:53", "text": "はい。ストリーミング配信は行われなかった。はい。"}]
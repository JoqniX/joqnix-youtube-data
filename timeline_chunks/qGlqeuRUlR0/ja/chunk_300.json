[{"type": "subtitle", "time": 18001.11, "timestamp": "05:00:01", "text": "うん。軽いゲームとか。何ですか"}, {"type": "subtitle", "time": 18003.71, "timestamp": "05:00:03", "text": "良い？"}, {"type": "subtitle", "time": 18005.19, "timestamp": "05:00:05", "text": "[音楽]"}, {"type": "subtitle", "time": 18007.35, "timestamp": "05:00:07", "text": "何がいいかな？うん、遊びたい"}, {"type": "subtitle", "time": 18012.31, "timestamp": "05:00:12", "text": "またゴルフの話か。そうそう。"}, {"type": "subtitle", "time": 18015.628, "timestamp": "05:00:15", "text": "うん。私は自分の"}, {"type": "subtitle", "time": 18020.59, "timestamp": "05:00:20", "text": "古いYouTubeファイルを見つけたのですが、"}, {"type": "subtitle", "time": 18022.19, "timestamp": "05:00:22", "text": "ゴルフ"}, {"type": "subtitle", "time": 18025.99, "timestamp": "05:00:25", "text": "私が撮影した動画は、ゴルフの試合のようなものです。私"}, {"type": "subtitle", "time": 18027.99, "timestamp": "05:00:27", "text": "何だったか覚えていない"}, {"type": "subtitle", "time": 18031.23, "timestamp": "05:00:31", "text": "と呼ばれた。それだけの価値はあると思う。"}, {"type": "subtitle", "time": 18035.91, "timestamp": "05:00:35", "text": "そして、またプレイしたいと思っていたんです。"}, {"type": "subtitle", "time": 18039.59, "timestamp": "05:00:39", "text": "だから、いつかまた一緒に遊べたらいいなと思っています。"}, {"type": "subtitle", "time": 18058.788, "timestamp": "05:00:58", "text": "うん。どうやら、私の2人目のゲストは"}]
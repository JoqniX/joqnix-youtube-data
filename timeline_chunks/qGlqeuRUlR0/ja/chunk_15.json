[{"type": "subtitle", "time": 910.35, "timestamp": "00:15:10", "text": "雪。どうしてそうじゃないの？"}, {"type": "subtitle", "time": 914.84, "timestamp": "00:15:14", "text": "死にかけている？どうしてそうじゃないの？"}, {"type": "subtitle", "time": 931.91, "timestamp": "00:15:31", "text": "いいえ。ジョー、元気ですか？私はすべてやっています"}, {"type": "subtitle", "time": 950.84, "timestamp": "00:15:50", "text": "何もない。わーい。遅刻だ。私は彼らを殺す。"}, {"type": "subtitle", "time": 957.509, "timestamp": "00:15:57", "text": "[音楽]"}]
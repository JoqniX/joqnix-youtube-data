[{"type": "subtitle", "time": 19920.708, "timestamp": "05:32:00", "text": "平均？例を挙げてもらえますか？"}, {"type": "subtitle", "time": 19922.47, "timestamp": "05:32:02", "text": "問題。"}, {"type": "subtitle", "time": 19925.99, "timestamp": "05:32:05", "text": "もしあなたが考え続けるのが好きなら"}, {"type": "subtitle", "time": 19929.19, "timestamp": "05:32:09", "text": "あなたを悩ませていること、例えば"}, {"type": "subtitle", "time": 19930.948, "timestamp": "05:32:10", "text": "あなたはただ彼らのことを考え続ける、"}, {"type": "subtitle", "time": 19933.91, "timestamp": "05:32:13", "text": "あなたはそれらに巻き込まれている。追いついたように"}, {"type": "subtitle", "time": 19940.07, "timestamp": "05:32:20", "text": "うん。考えすぎるのはやめよう。"}, {"type": "subtitle", "time": 19943.27, "timestamp": "05:32:23", "text": "なぜ？なぜそんなことが問題になるのか？なぜそれが"}, {"type": "subtitle", "time": 19943.99, "timestamp": "05:32:23", "text": "もの？"}, {"type": "subtitle", "time": 19947.67, "timestamp": "05:32:27", "text": "そう、だって私は考えすぎちゃうし、"}, {"type": "subtitle", "time": 19951.27, "timestamp": "05:32:31", "text": "「ああ、今日は子供が必要だ」みたいな感じ。"}, {"type": "subtitle", "time": 19958.91, "timestamp": "05:32:38", "text": "古い"}, {"type": "subtitle", "time": 19961.91, "timestamp": "05:32:41", "text": "うん。考えすぎるのはやめよう。それで、"}, {"type": "subtitle", "time": 19964.708, "timestamp": "05:32:44", "text": "私は、私が言うべき人ではないので、"}, {"type": "subtitle", "time": 19968.708, "timestamp": "05:32:48", "text": "いつも考えすぎてしまうんです。でも私は"}, {"type": "subtitle", "time": 19971.99, "timestamp": "05:32:51", "text": "考えすぎない方が良い。"}, {"type": "subtitle", "time": 19974.11, "timestamp": "05:32:54", "text": "うん。"}, {"type": "subtitle", "time": 19975.868, "timestamp": "05:32:55", "text": "所有"}]
[{"type": "subtitle", "time": 7861.87, "timestamp": "02:11:01", "text": "申し訳ありません。このストリームは"}, {"type": "subtitle", "time": 7865.109, "timestamp": "02:11:05", "text": "私はエンツォとしてプレイする予定だったのですが、"}, {"type": "subtitle", "time": 7867.669, "timestamp": "02:11:07", "text": "結局、雪上チャレンジに挑戦することになった。の"}, {"type": "subtitle", "time": 7888.629, "timestamp": "02:11:28", "text": "ハンターとしてゲームを完了すると、"}, {"type": "subtitle", "time": 7891.99, "timestamp": "02:11:31", "text": "ベアさん、選ばれるチャンスです"}, {"type": "subtitle", "time": 7916.39, "timestamp": "02:11:56", "text": "待って。バナーを確認したい。私 私"}, {"type": "subtitle", "time": 7918.79, "timestamp": "02:11:58", "text": "君たちにあげたいんだ 君たちにあげてほしいんだ"}]
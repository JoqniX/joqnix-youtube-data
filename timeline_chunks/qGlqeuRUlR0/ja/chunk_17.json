[{"type": "subtitle", "time": 1020.15, "timestamp": "00:17:00", "text": "神。いいえ。最後にVCを追加できますか？"}, {"type": "subtitle", "time": 1023.789, "timestamp": "00:17:03", "text": "弦？えっと、探してみます"}, {"type": "subtitle", "time": 1039.87, "timestamp": "00:17:19", "text": "遊ぶ。たくさん捕まえる"}, {"type": "subtitle", "time": 1042.59, "timestamp": "00:17:22", "text": "今。"}, {"type": "subtitle", "time": 1046.51, "timestamp": "00:17:26", "text": "GG。おい、こいつは"}, {"type": "subtitle", "time": 1050.669, "timestamp": "00:17:30", "text": "兄弟。雪と教会を捕まえている様子を見てください"}, {"type": "subtitle", "time": 1057.07, "timestamp": "00:17:37", "text": "推薦。わかりました、"}, {"type": "subtitle", "time": 1060.57, "timestamp": "00:17:40", "text": "サファ。あなたは"}, {"type": "subtitle", "time": 1062.029, "timestamp": "00:17:42", "text": "[音楽]"}, {"type": "subtitle", "time": 1065.47, "timestamp": "00:17:45", "text": "最高。推薦状をもらった。"}, {"type": "subtitle", "time": 1068.71, "timestamp": "00:17:48", "text": "A. では、課題を確認してみましょう。"}, {"type": "subtitle", "time": 1071.07, "timestamp": "00:17:51", "text": "わかった。"}, {"type": "subtitle", "time": 1073.63, "timestamp": "00:17:53", "text": "イベント。"}, {"type": "subtitle", "time": 1077.11, "timestamp": "00:17:57", "text": "えっと、雪玉を6個キャッチして、雪合戦をしよう。"}]
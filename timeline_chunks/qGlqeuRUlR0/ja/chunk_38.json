[{"type": "subtitle", "time": 2280.67, "timestamp": "00:38:00", "text": "おお。それは"}, {"type": "subtitle", "time": 2291.87, "timestamp": "00:38:11", "text": "[音楽]"}, {"type": "subtitle", "time": 2294.27, "timestamp": "00:38:14", "text": "自分。"}, {"type": "subtitle", "time": 2297.15, "timestamp": "00:38:17", "text": "おお。彼らは3、4人くらい殺した。"}, {"type": "subtitle", "time": 2299.39, "timestamp": "00:38:19", "text": "連続して。"}, {"type": "subtitle", "time": 2303.27, "timestamp": "00:38:23", "text": "おお。それは本当に素晴らしいですね。しかし私たちはそうしなかった"}, {"type": "subtitle", "time": 2312.47, "timestamp": "00:38:32", "text": "おお、新しい戦車がアンロックされました。"}, {"type": "subtitle", "time": 2313.95, "timestamp": "00:38:33", "text": "[音楽]"}, {"type": "subtitle", "time": 2317.87, "timestamp": "00:38:37", "text": "ドゥームフェストの挑戦。終わったかな"}, {"type": "subtitle", "time": 2325.43, "timestamp": "00:38:45", "text": "それ。ああ、8つのうち5つだ。ああ、わかりました。"}, {"type": "subtitle", "time": 2327.23, "timestamp": "00:38:47", "text": "はい、はい、はい、はい。"}, {"type": "subtitle", "time": 2330.23, "timestamp": "00:38:50", "text": "待って、6つ完了する必要があるんだよね？それで、"}, {"type": "subtitle", "time": 2331.63, "timestamp": "00:38:51", "text": "１、２、私"}, {"type": "subtitle", "time": 2334.75, "timestamp": "00:38:54", "text": "3つ完了しました。これは"}]
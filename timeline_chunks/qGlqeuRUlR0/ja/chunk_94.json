[{"type": "subtitle", "time": 5641.87, "timestamp": "01:34:01", "text": "いいえ、それは"}, {"type": "subtitle", "time": 5645.35, "timestamp": "01:34:05", "text": "私の。消え失せろ。"}, {"type": "subtitle", "time": 5652.229, "timestamp": "01:34:12", "text": "彼らを癒やしてあげましょう。大丈夫です。大丈夫です。させて"}, {"type": "subtitle", "time": 5654.95, "timestamp": "01:34:14", "text": "どうか、彼らを癒してください。"}, {"type": "subtitle", "time": 5660.95, "timestamp": "01:34:20", "text": "彼らは私たちに背の高い植物を栽培させてくれない。"}, {"type": "subtitle", "time": 5671.59, "timestamp": "01:34:31", "text": "時間。それならウィンストンで行こう。いいえ。"}, {"type": "subtitle", "time": 5676.59, "timestamp": "01:34:36", "text": "ええと、シグマ。ええ、この人の名前は"}, {"type": "subtitle", "time": 5679.55, "timestamp": "01:34:39", "text": "シグマ。"}]
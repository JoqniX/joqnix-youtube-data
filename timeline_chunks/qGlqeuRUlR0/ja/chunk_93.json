[{"type": "subtitle", "time": 5587.39, "timestamp": "01:33:07", "text": "[音楽]"}, {"type": "subtitle", "time": 5590.6, "timestamp": "01:33:10", "text": "何？これは難しい。"}, {"type": "subtitle", "time": 5592.709, "timestamp": "01:33:12", "text": "[音楽]"}, {"type": "subtitle", "time": 5595.07, "timestamp": "01:33:15", "text": "ああ、これは私の肌です。私は肌を持っています"}, {"type": "subtitle", "time": 5598.39, "timestamp": "01:33:18", "text": "ゴミ箱用タンク。ヴァン・ウルフを手に入れた"}, {"type": "subtitle", "time": 5601.189, "timestamp": "01:33:21", "text": "戦術。ああ、私はタクティカルを選びます。"}, {"type": "subtitle", "time": 5605.11, "timestamp": "01:33:25", "text": "大丈夫です。大丈夫です。これは難しい。"}, {"type": "subtitle", "time": 5615.669, "timestamp": "01:33:35", "text": "[拍手]"}, {"type": "subtitle", "time": 5629.87, "timestamp": "01:33:49", "text": "[音楽]"}, {"type": "subtitle", "time": 5632.709, "timestamp": "01:33:52", "text": "良い。チームメイトが"}, {"type": "subtitle", "time": 5635.39, "timestamp": "01:33:55", "text": "試す。ああ、わかった。そこには"}, {"type": "subtitle", "time": 5638.95, "timestamp": "01:33:58", "text": "1つ。一人だけいる。"}]
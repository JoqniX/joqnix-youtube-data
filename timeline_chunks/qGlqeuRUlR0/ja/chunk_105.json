[{"type": "subtitle", "time": 6303.51, "timestamp": "01:45:03", "text": "私は5月かYを取らなければならない"}, {"type": "subtitle", "time": 6305.03, "timestamp": "01:45:05", "text": "チャレンジ。私は必ずそうしなければならない"}, {"type": "subtitle", "time": 6307.31, "timestamp": "01:45:07", "text": "私が最初に取ります"}, {"type": "subtitle", "time": 6311.79, "timestamp": "01:45:11", "text": "そうしないと私は"}, {"type": "subtitle", "time": 6323.83, "timestamp": "01:45:23", "text": "疑問符。はい、試合が成立しました。"}, {"type": "subtitle", "time": 6325.31, "timestamp": "01:45:25", "text": "ペイパル"}, {"type": "subtitle", "time": 6340.27, "timestamp": "01:45:40", "text": "これ？ああ、彼は"}]
[{"type": "subtitle", "time": 15961.149, "timestamp": "04:26:01", "text": "購入の方が良いのは"}, {"type": "subtitle", "time": 15964.11, "timestamp": "04:26:04", "text": "スーパーマーケットは自動販売機よりも"}, {"type": "subtitle", "time": 15966.87, "timestamp": "04:26:06", "text": "機械。また、あなたは一緒に暮らすこともできます"}, {"type": "subtitle", "time": 15969.389, "timestamp": "04:26:09", "text": "まるで"}, {"type": "subtitle", "time": 15972.99, "timestamp": "04:26:12", "text": "50,000 または最大 50 または"}, {"type": "subtitle", "time": 15975.88, "timestamp": "04:26:15", "text": "80,000人なら生き残れる"}, {"type": "subtitle", "time": 15977.91, "timestamp": "04:26:17", "text": "[音楽]"}, {"type": "subtitle", "time": 15980.309, "timestamp": "04:26:20", "text": "えーと、"}, {"type": "subtitle", "time": 15981.91, "timestamp": "04:26:21", "text": "あなた自身"}, {"type": "subtitle", "time": 15991.63, "timestamp": "04:26:31", "text": "待って、何を期待してたの？"}, {"type": "subtitle", "time": 15996.55, "timestamp": "04:26:36", "text": "えっと、何を期待してたんですか？"}, {"type": "subtitle", "time": 15999.189, "timestamp": "04:26:39", "text": "私は実際にはこれを予想していませんでした"}, {"type": "subtitle", "time": 16002.51, "timestamp": "04:26:42", "text": "それほどの痛みだ。"}, {"type": "subtitle", "time": 16005.91, "timestamp": "04:26:45", "text": "えっと、何か食べようかなって思ったんです。私 私"}, {"type": "subtitle", "time": 16010.07, "timestamp": "04:26:50", "text": "生き残るために、私が手に入れるまで"}, {"type": "subtitle", "time": 16012.71, "timestamp": "04:26:52", "text": "仕事が見つからない、生活できない"}, {"type": "subtitle", "time": 16014.87, "timestamp": "04:26:54", "text": "そこには。一生懸命働く必要はなく、"}, {"type": "subtitle", "time": 16017.83, "timestamp": "04:26:57", "text": "すべて。やりたくない。なぜ"}]
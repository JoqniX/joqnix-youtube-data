[{"type": "subtitle", "time": 420.95, "timestamp": "00:07:00", "text": "私のPCがクラッシュしたか何かだけど、"}, {"type": "subtitle", "time": 423.95, "timestamp": "00:07:03", "text": "あれは怖かった。新しいタンク"}, {"type": "subtitle", "time": 427.749, "timestamp": "00:07:07", "text": "ヒーロー。ラマトラ・ラマ。あ、待って。これは"}, {"type": "subtitle", "time": 432.15, "timestamp": "00:07:12", "text": "新たなヒーロー。おお、新しいバトルパスが出たよ。"}, {"type": "subtitle", "time": 435.189, "timestamp": "00:07:15", "text": "ああ、冬のワンダーランド。"}, {"type": "subtitle", "time": 437.27, "timestamp": "00:07:17", "text": "新しい肌。フォーススプレー武器のお守り。おお、"}, {"type": "subtitle", "time": 440.11, "timestamp": "00:07:20", "text": "待って。なんてこった。これには努力が必要だ、"}, {"type": "subtitle", "time": 451.629, "timestamp": "00:07:31", "text": "これ？"}, {"type": "subtitle", "time": 459.67, "timestamp": "00:07:39", "text": "イベント。冬の六不思議を完成させよう"}, {"type": "subtitle", "time": 463.27, "timestamp": "00:07:43", "text": "氷のように素晴らしいワンダーランドチャレンジ"}, {"type": "subtitle", "time": 466.469, "timestamp": "00:07:46", "text": "女王は雪玉を6個手に入れることができる"}, {"type": "subtitle", "time": 468.71, "timestamp": "00:07:48", "text": "無料のスターとマッチするスノーボール。勝つ"}, {"type": "subtitle", "time": 470.83, "timestamp": "00:07:50", "text": "ゲームとして"}, {"type": "subtitle", "time": 474.83, "timestamp": "00:07:54", "text": "イエティ。スノーボールでゲームに勝つ"}, {"type": "subtitle", "time": 476.88, "timestamp": "00:07:56", "text": "マッチ。"}, {"type": "subtitle", "time": 478.11, "timestamp": "00:07:58", "text": "[音楽]"}]
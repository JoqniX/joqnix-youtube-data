[{"type": "subtitle", "time": 21422.15, "timestamp": "05:57:02", "text": "自分の。そして時には手頃な価格で"}, {"type": "subtitle", "time": 21423.36, "timestamp": "05:57:03", "text": "本当に"}, {"type": "subtitle", "time": 21424.59, "timestamp": "05:57:04", "text": "[音楽]"}, {"type": "subtitle", "time": 21428.31, "timestamp": "05:57:08", "text": "例えば、"}, {"type": "subtitle", "time": 21434.15, "timestamp": "05:57:14", "text": "自分で料理をしましょう。だから、私はそれをお勧めします。"}, {"type": "subtitle", "time": 21446.23, "timestamp": "05:57:26", "text": "したいのですが、わかりません。私は私は"}, {"type": "subtitle", "time": 21448.708, "timestamp": "05:57:28", "text": "緊張しているような感じだけど、うん、という感じでもある。それは"}, {"type": "subtitle", "time": 21455.47, "timestamp": "05:57:35", "text": "やめてください"}, {"type": "subtitle", "time": 21458.628, "timestamp": "05:57:38", "text": "悲しまないで。"}, {"type": "subtitle", "time": 21464.75, "timestamp": "05:57:44", "text": "私も"}, {"type": "subtitle", "time": 21467.99, "timestamp": "05:57:47", "text": "センシティブ。私は泣いてしまうでしょう。こう言って、"}, {"type": "subtitle", "time": 21478.628, "timestamp": "05:57:58", "text": "家に帰らないで。"}]
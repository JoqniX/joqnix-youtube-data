[{"type": "subtitle", "time": 9308.03, "timestamp": "02:35:08", "text": "はい、皆さん。私に送ってください、または私のPCです"}, {"type": "subtitle", "time": 9325.61, "timestamp": "02:35:25", "text": "は。"}, {"type": "subtitle", "time": 9328.429, "timestamp": "02:35:28", "text": "[音楽]"}, {"type": "subtitle", "time": 9333.23, "timestamp": "02:35:33", "text": "わかった。こんにちは。あと２つ必要です"}, {"type": "subtitle", "time": 9336.71, "timestamp": "02:35:36", "text": "鎌。その後、私は"}, {"type": "subtitle", "time": 9338.63, "timestamp": "02:35:38", "text": "殺人の連続だよ。文字通り"}, {"type": "subtitle", "time": 9341.11, "timestamp": "02:35:41", "text": "連続殺人。君たちは目撃することになる"}, {"type": "subtitle", "time": 9343.79, "timestamp": "02:35:43", "text": "殺人事件"}, {"type": "subtitle", "time": 9346.11, "timestamp": "02:35:46", "text": "乱痴気騒ぎ。"}, {"type": "subtitle", "time": 9348.55, "timestamp": "02:35:48", "text": "うん。よし。私はそれを私の"}]
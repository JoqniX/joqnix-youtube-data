[{"type": "subtitle", "time": 20281.99, "timestamp": "05:38:01", "text": "一つ作るか、自分で作るか。ええ、そうは思いません"}, {"type": "subtitle", "time": 20284.15, "timestamp": "05:38:04", "text": "どちらを選べばいいかわからない"}, {"type": "subtitle", "time": 20286.39, "timestamp": "05:38:06", "text": "今は、"}, {"type": "subtitle", "time": 20289.628, "timestamp": "05:38:09", "text": "うまくいくよ。うまくいくでしょう"}, {"type": "subtitle", "time": 20292.788, "timestamp": "05:38:12", "text": "外。私は自分が本当に難しいことに気づいた"}, {"type": "subtitle", "time": 20295.43, "timestamp": "05:38:15", "text": "依頼を受けたアーティストと仕事をするため"}, {"type": "subtitle", "time": 20298.39, "timestamp": "05:38:18", "text": "私はこだわりが強く、プロ意識が高すぎるんです。"}, {"type": "subtitle", "time": 20302.788, "timestamp": "05:38:22", "text": "文字通りの1層を見たら"}, {"type": "subtitle", "time": 20306.15, "timestamp": "05:38:26", "text": "名前が間違ってる。レイヤー名が間違ってる。"}, {"type": "subtitle", "time": 20308.75, "timestamp": "05:38:28", "text": "ちょっと間違っている"}, {"type": "subtitle", "time": 20311.99, "timestamp": "05:38:31", "text": "方法と私が指摘した小さな小さな"}, {"type": "subtitle", "time": 20314.708, "timestamp": "05:38:34", "text": "間違いだと思う 私は自分が感じていると思う"}, {"type": "subtitle", "time": 20317.67, "timestamp": "05:38:37", "text": "それは悪いことだ、いや、それはアーティストのためのものだ"}, {"type": "subtitle", "time": 20319.75, "timestamp": "05:38:39", "text": "さて、これからどうなるでしょうか"}, {"type": "subtitle", "time": 20322.67, "timestamp": "05:38:42", "text": "リガー、ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 20325.75, "timestamp": "05:38:45", "text": "心配です。そんなことが起こらないことを願っています。"}, {"type": "subtitle", "time": 20327.07, "timestamp": "05:38:47", "text": "チューブ状のもの"}, {"type": "subtitle", "time": 20330.07, "timestamp": "05:38:50", "text": "はい、なぜならまた、私は"}, {"type": "subtitle", "time": 20332.548, "timestamp": "05:38:52", "text": "その写真、モーターとその他、"}, {"type": "subtitle", "time": 20335.75, "timestamp": "05:38:55", "text": "右？しかし、その動き方やその他すべて"}, {"type": "subtitle", "time": 20338.948, "timestamp": "05:38:58", "text": "それは大きな問題になるだろうね？大きなこと、"}]
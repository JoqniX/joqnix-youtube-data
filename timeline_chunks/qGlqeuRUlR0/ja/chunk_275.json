[{"type": "subtitle", "time": 16500.47, "timestamp": "04:35:00", "text": "そしてバッグの上に座り、そして閉じた"}, {"type": "subtitle", "time": 16507.869, "timestamp": "04:35:07", "text": "ええ、でも私の荷物はちょっと"}, {"type": "subtitle", "time": 16512.949, "timestamp": "04:35:12", "text": "その頃には既に太り気味だった。なんてこった。でも、"}, {"type": "subtitle", "time": 16516.07, "timestamp": "04:35:16", "text": "あなたの航空会社はどんな感じですか？私は持っていますか"}, {"type": "subtitle", "time": 16518.869, "timestamp": "04:35:18", "text": "それについては知りません。私はそうは思わない、私はそうは思わない"}, {"type": "subtitle", "time": 16521.59, "timestamp": "04:35:21", "text": "それに関する情報はまだありません。"}, {"type": "subtitle", "time": 16524.789, "timestamp": "04:35:24", "text": "COEを取得した後のアカデミー関係者"}, {"type": "subtitle", "time": 16528.15, "timestamp": "04:35:28", "text": "日本から、その後彼らは"}, {"type": "subtitle", "time": 16530.709, "timestamp": "04:35:30", "text": "フライトを探して予約しなければならない。"}, {"type": "subtitle", "time": 16533.429, "timestamp": "04:35:33", "text": "そうすれば詳細がわかる"}, {"type": "subtitle", "time": 16545.189, "timestamp": "04:35:45", "text": "見てみると"}, {"type": "subtitle", "time": 16548.869, "timestamp": "04:35:48", "text": "航空会社のウェブサイト。"}, {"type": "subtitle", "time": 16552.07, "timestamp": "04:35:52", "text": "彼らは、ええと、"}, {"type": "subtitle", "time": 16555.59, "timestamp": "04:35:55", "text": "機内持ち込み手荷物と預け入れ手荷物"}, {"type": "subtitle", "time": 16557.51, "timestamp": "04:35:57", "text": "あなたが持てるもの、持てないもの"}]
[{"type": "subtitle", "time": 16920.31, "timestamp": "04:42:00", "text": "あなたの街が好きになってここに引っ越してきて、それから"}, {"type": "subtitle", "time": 16922.59, "timestamp": "04:42:02", "text": "彼らはあなたを案内してくれるでしょう"}, {"type": "subtitle", "time": 16926.07, "timestamp": "04:42:06", "text": "プロセスを実行すると、彼らが好むかどうかがわかります"}, {"type": "subtitle", "time": 16929.99, "timestamp": "04:42:09", "text": "彼らに伝えてください。ええ、彼らは話すと思います"}, {"type": "subtitle", "time": 16932.31, "timestamp": "04:42:12", "text": "英語とフォームも"}, {"type": "subtitle", "time": 16934.628, "timestamp": "04:42:14", "text": "英語なので"}, {"type": "subtitle", "time": 16937.19, "timestamp": "04:42:17", "text": "大丈夫だよ。あなたはただ"}, {"type": "subtitle", "time": 16940.708, "timestamp": "04:42:20", "text": "情報を入力して、"}, {"type": "subtitle", "time": 16943.27, "timestamp": "04:42:23", "text": "健康保険をあなたに提供し、"}, {"type": "subtitle", "time": 16946.31, "timestamp": "04:42:26", "text": "裏面には住所も印刷されます"}, {"type": "subtitle", "time": 16948.19, "timestamp": "04:42:28", "text": "あなたの居住者の"}, {"type": "subtitle", "time": 16952.23, "timestamp": "04:42:32", "text": "カード、それだけです。 30分くらいかかる"}, {"type": "subtitle", "time": 16953.99, "timestamp": "04:42:33", "text": "分。書き方を学ぶつもりです"}, {"type": "subtitle", "time": 16957.39, "timestamp": "04:42:37", "text": "日本の住所ですよね？"}, {"type": "subtitle", "time": 16962.67, "timestamp": "04:42:42", "text": "まあ、大丈夫かもしれませんよ。私はこう思う"}, {"type": "subtitle", "time": 16966.628, "timestamp": "04:42:46", "text": "ええ、そう思います。ああ、そうですね。私 私"}, {"type": "subtitle", "time": 16970.39, "timestamp": "04:42:50", "text": "彼らはひらがなを使うと思う。いや、違う、違う"}, {"type": "subtitle", "time": 16975.03, "timestamp": "04:42:55", "text": "ひらがな。ウム・ローマ。まるであなたがただ"}, {"type": "subtitle", "time": 16978.15, "timestamp": "04:42:58", "text": "ラム酒で書いておけば大丈夫だよ。例えば"}]
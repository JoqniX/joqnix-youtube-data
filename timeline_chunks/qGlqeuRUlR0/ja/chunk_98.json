[{"type": "subtitle", "time": 5916.07, "timestamp": "01:38:36", "text": "よし、行こう。私たちはこれから始めます"}, {"type": "subtitle", "time": 5919.109, "timestamp": "01:38:39", "text": "本物。よし、じゃあアッシュで行くよ。私"}, {"type": "subtitle", "time": 5920.109, "timestamp": "01:38:40", "text": "愛"}, {"type": "subtitle", "time": 5924.149, "timestamp": "01:38:44", "text": "灰。ショットガンを持った女性。私は大好きです。理由はわかりますか？"}, {"type": "subtitle", "time": 5927.43, "timestamp": "01:38:47", "text": "アッシュが好き？髪の毛のせいだよ。白髪"}, {"type": "subtitle", "time": 5931.43, "timestamp": "01:38:51", "text": "私のような。私は白髪が好きです。短い時間で終わる。"}, {"type": "subtitle", "time": 5933.149, "timestamp": "01:38:53", "text": "ピストルはとても"}]
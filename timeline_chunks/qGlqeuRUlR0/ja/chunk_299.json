[{"type": "subtitle", "time": 17941.23, "timestamp": "04:59:01", "text": "私が何かをしてからずいぶん経ちますが、"}, {"type": "subtitle", "time": 17944.31, "timestamp": "04:59:04", "text": "チャンネルのように。"}, {"type": "subtitle", "time": 17946.59, "timestamp": "04:59:06", "text": "うん。"}, {"type": "subtitle", "time": 17954.88, "timestamp": "04:59:14", "text": "起こる。"}, {"type": "subtitle", "time": 17956.35, "timestamp": "04:59:16", "text": "[音楽]"}, {"type": "subtitle", "time": 17959.59, "timestamp": "04:59:19", "text": "だから私の荷物が全部揃ったら"}, {"type": "subtitle", "time": 17961.99, "timestamp": "04:59:21", "text": "問題は解決しましたし、あなたの持ち物もすべて問題ありません。"}, {"type": "subtitle", "time": 17964.628, "timestamp": "04:59:24", "text": "コラボレーションとかしようよ。"}, {"type": "subtitle", "time": 17966.31, "timestamp": "04:59:26", "text": "うん。"}, {"type": "subtitle", "time": 17967.07, "timestamp": "04:59:27", "text": "ドゥドゥ"}, {"type": "subtitle", "time": 17970.55, "timestamp": "04:59:30", "text": "もっと多くのことをする。うん。"}, {"type": "subtitle", "time": 17974.788, "timestamp": "04:59:34", "text": "うん。君とゲームをしたい。"}, {"type": "subtitle", "time": 17985.67, "timestamp": "04:59:45", "text": "私はこう考えていました"}, {"type": "subtitle", "time": 17988.788, "timestamp": "04:59:48", "text": "数日間。数日は数日"}, {"type": "subtitle", "time": 17992.31, "timestamp": "04:59:52", "text": "前。うん。私は考えていた"}, {"type": "subtitle", "time": 17993.628, "timestamp": "04:59:53", "text": "我々は出来た"}]
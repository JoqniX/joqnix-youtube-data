[{"type": "subtitle", "time": 16201.55, "timestamp": "04:30:01", "text": "化粧品のように、"}, {"type": "subtitle", "time": 16203.229, "timestamp": "04:30:03", "text": "補う、"}, {"type": "subtitle", "time": 16207.07, "timestamp": "04:30:07", "text": "そして、他にもいくつか。私"}, {"type": "subtitle", "time": 16209.83, "timestamp": "04:30:09", "text": "聞いた話だと、彼らは計測して売っていると思う"}, {"type": "subtitle", "time": 16213.59, "timestamp": "04:30:13", "text": "テープは、あなたが測定方法を知っているようなものです"}, {"type": "subtitle", "time": 16217.03, "timestamp": "04:30:17", "text": "テープとは？ええ、メジャーですね。はい。"}, {"type": "subtitle", "time": 16220.309, "timestamp": "04:30:20", "text": "メジャー。うん。私が聞いたところによると"}, {"type": "subtitle", "time": 16223.11, "timestamp": "04:30:23", "text": "彼らが測定テープを販売している"}, {"type": "subtitle", "time": 16237.349, "timestamp": "04:30:37", "text": "面白い。ああ、写真が見えるよ。おお"}, {"type": "subtitle", "time": 16240.389, "timestamp": "04:30:40", "text": "ああ、今見つけたよ。車型ベッド。おお、"}, {"type": "subtitle", "time": 16242.229, "timestamp": "04:30:42", "text": "無料のミニ冷蔵庫をもらいましたか？"}, {"type": "subtitle", "time": 16244.07, "timestamp": "04:30:44", "text": "何か？"}, {"type": "subtitle", "time": 16247.429, "timestamp": "04:30:47", "text": "ええと、私の部屋に1つあります。ああ、あなたは買った"}, {"type": "subtitle", "time": 16251.75, "timestamp": "04:30:51", "text": "自分でやるの？いや、いや、いや。私はすでに持っていた"}, {"type": "subtitle", "time": 16254.87, "timestamp": "04:30:54", "text": "エアコンやミニのような部屋に置いて"}, {"type": "subtitle", "time": 16257.99, "timestamp": "04:30:57", "text": "冷蔵庫。おお。"}]
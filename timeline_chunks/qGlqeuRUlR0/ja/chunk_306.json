[{"type": "subtitle", "time": 18360.31, "timestamp": "05:06:00", "text": "誰かが望むまで"}, {"type": "subtitle", "time": 18363.03, "timestamp": "05:06:03", "text": "コラボレーション。ええ、私は幸運にも"}, {"type": "subtitle", "time": 18365.628, "timestamp": "05:06:05", "text": "少なくとも1人が"}, {"type": "subtitle", "time": 18369.83, "timestamp": "05:06:09", "text": "下。しかし、私が最近"}, {"type": "subtitle", "time": 18371.83, "timestamp": "05:06:11", "text": "連絡があった。私は気分が悪かった"}, {"type": "subtitle", "time": 18374.07, "timestamp": "05:06:14", "text": "見た感じ、知ってたと思う"}, {"type": "subtitle", "time": 18375.83, "timestamp": "05:06:15", "text": "話した、少し話した"}, {"type": "subtitle", "time": 18377.868, "timestamp": "05:06:17", "text": "少し。右。だからそれは"}, {"type": "subtitle", "time": 18380.708, "timestamp": "05:06:20", "text": "私は彼らがイギリス人だと知っています"}, {"type": "subtitle", "time": 18385.11, "timestamp": "05:06:25", "text": "日本語を話すユーチューバーと本当に"}, {"type": "subtitle", "time": 18387.55, "timestamp": "05:06:27", "text": "繋がりたかったのですが、"}, {"type": "subtitle", "time": 18390.55, "timestamp": "05:06:30", "text": "英語を勉強していたか何かだった。私"}, {"type": "subtitle", "time": 18393.83, "timestamp": "05:06:33", "text": "十分に調査もせず、"}, {"type": "subtitle", "time": 18394.91, "timestamp": "05:06:34", "text": "コンテンツ"}, {"type": "subtitle", "time": 18397.19, "timestamp": "05:06:37", "text": "きちんと。そういう見た目"}, {"type": "subtitle", "time": 18400.07, "timestamp": "05:06:40", "text": "文字通りENV Tuberの瞬間"}, {"type": "subtitle", "time": 18401.708, "timestamp": "05:06:41", "text": "すべてのミームと"}, {"type": "subtitle", "time": 18405.708, "timestamp": "05:06:45", "text": "すべて、すべてのもの、エネルギー"}, {"type": "subtitle", "time": 18409.83, "timestamp": "05:06:49", "text": "ええ、そう感じました、私は"}, {"type": "subtitle", "time": 18412.708, "timestamp": "05:06:52", "text": "きちんと調べると、まるで私が"}, {"type": "subtitle", "time": 18415.75, "timestamp": "05:06:55", "text": "彼らの英語を軽視したり、何か"}, {"type": "subtitle", "time": 18417.67, "timestamp": "05:06:57", "text": "わからない、もしかしたら考えすぎなのかもしれない"}]
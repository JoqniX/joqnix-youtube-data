[{"type": "subtitle", "time": 15241.349, "timestamp": "04:14:01", "text": "タクシーの運転手が私によくそう言っていた"}, {"type": "subtitle", "time": 15245.03, "timestamp": "04:14:05", "text": "多くの人々がここに住むためにやって来ている。それで"}, {"type": "subtitle", "time": 15247.149, "timestamp": "04:14:07", "text": "それはまるで"}, {"type": "subtitle", "time": 15250.55, "timestamp": "04:14:10", "text": "混雑しているが、東京から出発する人々のようだ"}, {"type": "subtitle", "time": 15254.55, "timestamp": "04:14:14", "text": "ここに来て、一緒に暮らして、一緒に暮らすのが好きです"}, {"type": "subtitle", "time": 15258.07, "timestamp": "04:14:18", "text": "家族と暮らしている人も、一人暮らしの人も、どちらでも構いません。"}, {"type": "subtitle", "time": 15260.07, "timestamp": "04:14:20", "text": "ああ"}, {"type": "subtitle", "time": 15262.149, "timestamp": "04:14:22", "text": "生き物たちの調子はどうですか？どうですか"}, {"type": "subtitle", "time": 15265.11, "timestamp": "04:14:25", "text": "生き物と、その他すべて？"}, {"type": "subtitle", "time": 15269.07, "timestamp": "04:14:29", "text": "それは良いです。つまり、あなたは"}, {"type": "subtitle", "time": 15271.83, "timestamp": "04:14:31", "text": "コンビンにあるものすべて、わかるでしょ"}, {"type": "subtitle", "time": 15274.07, "timestamp": "04:14:34", "text": "コンビニエンスストアは、"}, {"type": "subtitle", "time": 15276.429, "timestamp": "04:14:36", "text": "そこに何かあるか"}, {"type": "subtitle", "time": 15280.149, "timestamp": "04:14:40", "text": "そして私が好きなのは"}, {"type": "subtitle", "time": 15282.87, "timestamp": "04:14:42", "text": "コンビニエンスストアは、"}, {"type": "subtitle", "time": 15285.67, "timestamp": "04:14:45", "text": "真夜中など、一日のどの時間帯でも"}, {"type": "subtitle", "time": 15289.11, "timestamp": "04:14:49", "text": "午前3時頃、軽食が必要になったとき、"}, {"type": "subtitle", "time": 15294.149, "timestamp": "04:14:54", "text": "外に出て軽食をとろう、まるで"}, {"type": "subtitle", "time": 15297.75, "timestamp": "04:14:57", "text": "まるで家にいるような感覚とは違う。家に帰って、"}]
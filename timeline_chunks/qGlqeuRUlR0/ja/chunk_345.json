[{"type": "subtitle", "time": 20703.11, "timestamp": "05:45:03", "text": "何てことだ。うん、"}, {"type": "subtitle", "time": 20706.708, "timestamp": "05:45:06", "text": "おめでとうございます。ありがとう。私は考えたこともなかった"}, {"type": "subtitle", "time": 20711.91, "timestamp": "05:45:11", "text": "それは起こりうるだろう。そしてそれは狂気じみている"}, {"type": "subtitle", "time": 20715.43, "timestamp": "05:45:15", "text": "ヨアトンの初期段階で"}, {"type": "subtitle", "time": 20717.43, "timestamp": "05:45:17", "text": "私はそう思わない人たちがいた"}, {"type": "subtitle", "time": 20719.35, "timestamp": "05:45:19", "text": "何が起こったのかはわかりませんが、"}, {"type": "subtitle", "time": 20721.35, "timestamp": "05:45:21", "text": "多くの人が潜伏している"}, {"type": "subtitle", "time": 20723.59, "timestamp": "05:45:23", "text": "コメントしています。だから私は「え、私は"}, {"type": "subtitle", "time": 20726.23, "timestamp": "05:45:26", "text": "ビューボットか何かで"}, {"type": "subtitle", "time": 20728.47, "timestamp": "05:45:28", "text": "それはずっと続いています"}, {"type": "subtitle", "time": 20729.788, "timestamp": "05:45:29", "text": "三つ"}, {"type": "subtitle", "time": 20733.27, "timestamp": "05:45:33", "text": "3週間まるまる3週間、そしてその3週間"}, {"type": "subtitle", "time": 20737.03, "timestamp": "05:45:37", "text": "同時接続人数が30人か40人くらい"}, {"type": "subtitle", "time": 20739.99, "timestamp": "05:45:39", "text": "ストリームを見て、いいね"}, {"type": "subtitle", "time": 20744.788, "timestamp": "05:45:44", "text": "どういうわけか、5,000 時間の視聴と"}, {"type": "subtitle", "time": 20747.35, "timestamp": "05:45:47", "text": "助けた。私は「ああ、あの人たちは"}, {"type": "subtitle", "time": 20750.31, "timestamp": "05:45:50", "text": "YouTube を手に入れた後、go は消えました"}, {"type": "subtitle", "time": 20752.548, "timestamp": "05:45:52", "text": "パートナー。彼らは戻ってこない。おお"}, {"type": "subtitle", "time": 20755.75, "timestamp": "05:45:55", "text": "いいえ。」そしてありがたいことに、彼らは"}, {"type": "subtitle", "time": 20758.23, "timestamp": "05:45:58", "text": "すでに支払った金額は"}]
[{"type": "subtitle", "time": 16863.19, "timestamp": "04:41:03", "text": "えっと、リンクを送りました。だから、もしあなたが"}, {"type": "subtitle", "time": 16865.35, "timestamp": "04:41:05", "text": "あなたはすでにフォームに記入済みです"}, {"type": "subtitle", "time": 16867.83, "timestamp": "04:41:07", "text": "このウェブサイトは、登録済みの場合、"}, {"type": "subtitle", "time": 16870.868, "timestamp": "04:41:10", "text": "QRコードが2つまたは1つ取得できます。"}, {"type": "subtitle", "time": 16873.35, "timestamp": "04:41:13", "text": "思うに、スキャンするだけでいい"}, {"type": "subtitle", "time": 16876.948, "timestamp": "04:41:16", "text": "カウンターにあるようなQRコードで"}, {"type": "subtitle", "time": 16878.708, "timestamp": "04:41:18", "text": "移民と"}, {"type": "subtitle", "time": 16881.91, "timestamp": "04:41:21", "text": "税関。つまり、すごく速いんです。いいえ"}, {"type": "subtitle", "time": 16884.75, "timestamp": "04:41:24", "text": "尋問、何もなし。"}, {"type": "subtitle", "time": 16889.19, "timestamp": "04:41:29", "text": "そして彼らはあなたにあなたの"}, {"type": "subtitle", "time": 16892.19, "timestamp": "04:41:32", "text": "居住者カードは"}, {"type": "subtitle", "time": 16895.91, "timestamp": "04:41:35", "text": "空港でQRコードをスキャンしたいときにご利用ください。"}, {"type": "subtitle", "time": 16899.83, "timestamp": "04:41:39", "text": "そしてその居住者カードがあれば、"}, {"type": "subtitle", "time": 16903.91, "timestamp": "04:41:43", "text": "到着後いつでも、例えば"}, {"type": "subtitle", "time": 16906.03, "timestamp": "04:41:46", "text": "時間があるなら、"}, {"type": "subtitle", "time": 16910.99, "timestamp": "04:41:50", "text": "えーと、市役所とか都道府県とか"}, {"type": "subtitle", "time": 16914.15, "timestamp": "04:41:54", "text": "オフィスで、それから私は"}]
[{"type": "subtitle", "time": 18240.39, "timestamp": "05:04:00", "text": "デビューしたばかりで、私は彼らと話して"}, {"type": "subtitle", "time": 18243.948, "timestamp": "05:04:03", "text": "フランス風のフレンドリーな感じ"}, {"type": "subtitle", "time": 18247.67, "timestamp": "05:04:07", "text": "関係を始めて、その後彼らに尋ねました"}, {"type": "subtitle", "time": 18250.788, "timestamp": "05:04:10", "text": "いつか私は彼らに尋ねた"}, {"type": "subtitle", "time": 18254.55, "timestamp": "05:04:14", "text": "コラボでも何でもやろうよ。時々彼らは"}, {"type": "subtitle", "time": 18257.75, "timestamp": "05:04:17", "text": "自問自答する"}, {"type": "subtitle", "time": 18260.07, "timestamp": "05:04:20", "text": "コラボレーションしたい場合、"}, {"type": "subtitle", "time": 18264.07, "timestamp": "05:04:24", "text": "いいえ。ああ、あなたは築き上げた"}, {"type": "subtitle", "time": 18266.07, "timestamp": "05:04:26", "text": "彼らと友達になって、ゆっくりとそれを受け入れた"}, {"type": "subtitle", "time": 18270.868, "timestamp": "05:04:30", "text": "ゆっくり進むってことだよね？うん。うん。なぜなら"}, {"type": "subtitle", "time": 18274.23, "timestamp": "05:04:34", "text": "今はみんなにDMを送っている"}, {"type": "subtitle", "time": 18277.99, "timestamp": "05:04:37", "text": "そして、これまで誰もコラボレーションしたことがないような、"}, {"type": "subtitle", "time": 18279.83, "timestamp": "05:04:39", "text": "彼らは既にコラボレーションしているので問題ありません"}, {"type": "subtitle", "time": 18281.15, "timestamp": "05:04:41", "text": "私と一緒に。彼らは雰囲気を知っていて"}, {"type": "subtitle", "time": 18284.31, "timestamp": "05:04:44", "text": "たとえどれほど昔のことであっても、すべて。しかし"}, {"type": "subtitle", "time": 18287.91, "timestamp": "05:04:47", "text": "新しい人にとっては、いいえ、彼らは私が"}, {"type": "subtitle", "time": 18290.39, "timestamp": "05:04:50", "text": "まるでどこからともなく現れたかのようだ。私はこう言っている"}, {"type": "subtitle", "time": 18299.43, "timestamp": "05:04:59", "text": "トランザクションのようなコラボレーション"}]
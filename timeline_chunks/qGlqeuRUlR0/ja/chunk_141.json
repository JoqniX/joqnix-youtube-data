[{"type": "subtitle", "time": 8462.75, "timestamp": "02:21:02", "text": "えっと、それはウォッチでした"}, {"type": "subtitle", "time": 8465.67, "timestamp": "02:21:05", "text": "それにはEPが必要だ。特別な方法でやります"}, {"type": "subtitle", "time": 8468.71, "timestamp": "02:21:08", "text": "ストリーム。心配しないで。えっと、つまり、あなたは"}, {"type": "subtitle", "time": 8471.349, "timestamp": "02:21:11", "text": "4ヶ月間ここに滞在します。だから、"}, {"type": "subtitle", "time": 8475.67, "timestamp": "02:21:15", "text": "心配して、バカ。私は文字通り"}, {"type": "subtitle", "time": 8478.91, "timestamp": "02:21:18", "text": "えっと、私は文字通り"}, {"type": "subtitle", "time": 8482.63, "timestamp": "02:21:22", "text": "えっと、文字通りこう言おうと思う"}, {"type": "subtitle", "time": 8485.59, "timestamp": "02:21:25", "text": "マイクを私の近くに置けば、"}, {"type": "subtitle", "time": 8488.15, "timestamp": "02:21:28", "text": "睡眠中のASMR配信をしよう。そうします"}, {"type": "subtitle", "time": 8489.15, "timestamp": "02:21:29", "text": "のために"}, {"type": "subtitle", "time": 8491.83, "timestamp": "02:21:31", "text": "初日はその日のために。病気"}, {"type": "subtitle", "time": 8509.79, "timestamp": "02:21:49", "text": "ジョー、私はいびきをかかない"}, {"type": "subtitle", "time": 8517.07, "timestamp": "02:21:57", "text": "私はいびきをかかないと思う"}]
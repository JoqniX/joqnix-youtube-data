[{"type": "subtitle", "time": 3906.109, "timestamp": "01:05:06", "text": "同盟関係にある理事会。それは"}, {"type": "subtitle", "time": 3936.43, "timestamp": "01:05:36", "text": "待って、私は"}, {"type": "subtitle", "time": 3939.069, "timestamp": "01:05:39", "text": "それ？"}, {"type": "subtitle", "time": 3942.87, "timestamp": "01:05:42", "text": "あ、待って。ああ、私の声。ああ、"}, {"type": "subtitle", "time": 3951.71, "timestamp": "01:05:51", "text": "ああ、人に聞こえていることを忘れてた"}, {"type": "subtitle", "time": 3955.309, "timestamp": "01:05:55", "text": "自分。ああ、それは"}, {"type": "subtitle", "time": 3959.51, "timestamp": "01:05:59", "text": "恥ずかしい。素早くステップを踏む"}]
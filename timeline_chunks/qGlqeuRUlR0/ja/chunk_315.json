[{"type": "subtitle", "time": 18902.23, "timestamp": "05:15:02", "text": "Arasi という単語があり、"}, {"type": "subtitle", "time": 18905.27, "timestamp": "05:15:05", "text": "あなたの配信に来る人たちは"}, {"type": "subtitle", "time": 18908.628, "timestamp": "05:15:08", "text": "そして、嫌なコメントを残したり、"}, {"type": "subtitle", "time": 18912.15, "timestamp": "05:15:12", "text": "怒りを煽るコメント、または彼らが気に入った場合"}, {"type": "subtitle", "time": 18915.59, "timestamp": "05:15:15", "text": "いいね"}, {"type": "subtitle", "time": 18919.35, "timestamp": "05:15:19", "text": "えっと、ストリームを呼び出すような感じで、どこに"}, {"type": "subtitle", "time": 18922.39, "timestamp": "05:15:22", "text": "Discordから電話がかかってくる"}, {"type": "subtitle", "time": 18925.11, "timestamp": "05:15:25", "text": "チャンネルか何かで、彼らは気に入るかもしれない"}, {"type": "subtitle", "time": 18927.99, "timestamp": "05:15:27", "text": "あなたのチャンネルのDiscordチャンネルに登場"}, {"type": "subtitle", "time": 18933.11, "timestamp": "05:15:33", "text": "そして、音声通話で彼らはこう言います"}, {"type": "subtitle", "time": 18936.948, "timestamp": "05:15:36", "text": "変な襲撃の餌みたいなもの"}, {"type": "subtitle", "time": 18939.19, "timestamp": "05:15:39", "text": "日本語で何か"}, {"type": "subtitle", "time": 18942.628, "timestamp": "05:15:42", "text": "日本語でも英語でも、うん"}, {"type": "subtitle", "time": 18944.788, "timestamp": "05:15:44", "text": "ほとんど日本語ですが、日本語もあります"}, {"type": "subtitle", "time": 18946.99, "timestamp": "05:15:46", "text": "人々と彼らは"}, {"type": "subtitle", "time": 18949.83, "timestamp": "05:15:49", "text": "おそらく、起こったことと同じように"}, {"type": "subtitle", "time": 18953.67, "timestamp": "05:15:53", "text": "私の誕生日配信には、"}, {"type": "subtitle", "time": 18956.15, "timestamp": "05:15:56", "text": "えっと、プライベートのようなDiscordチャンネル"}, {"type": "subtitle", "time": 18959.27, "timestamp": "05:15:59", "text": "Discordは非公開ではないが、その配信用"}]
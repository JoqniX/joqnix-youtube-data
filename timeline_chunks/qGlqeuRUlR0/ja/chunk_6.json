[{"type": "subtitle", "time": 361.39, "timestamp": "00:06:01", "text": "Overwatchのプロフィールですよね？私は思う"}, {"type": "subtitle", "time": 364.11, "timestamp": "00:06:04", "text": "した。そうでしょうか？した"}, {"type": "subtitle", "time": 368.43, "timestamp": "00:06:08", "text": "私？はい、オーバーウォッチのプロフィールを持っていました。"}, {"type": "subtitle", "time": 370.79, "timestamp": "00:06:10", "text": "はい。よし。それでは早速、"}, {"type": "subtitle", "time": 373.27, "timestamp": "00:06:13", "text": "スイッチのように、ほとんど完了しました"}, {"type": "subtitle", "time": 375.87, "timestamp": "00:06:15", "text": "このプラットフォームと"}, {"type": "subtitle", "time": 377.629, "timestamp": "00:06:17", "text": "もの。"}, {"type": "subtitle", "time": 380.39, "timestamp": "00:06:20", "text": "はい。うん。ストリーミング配信をしているとき、"}, {"type": "subtitle", "time": 383.309, "timestamp": "00:06:23", "text": "私はある意味"}, {"type": "subtitle", "time": 386.79, "timestamp": "00:06:26", "text": "意図せずこれらのことを心配する"}, {"type": "subtitle", "time": 389.51, "timestamp": "00:06:29", "text": "えっと、私、ツイートしたっけ？おお、"}, {"type": "subtitle", "time": 392.15, "timestamp": "00:06:32", "text": "私がそんなことしたの？私がこれをやったのか？私はそうしましたか？"}, {"type": "subtitle", "time": 393.55, "timestamp": "00:06:33", "text": "それ？まるで"}, {"type": "subtitle", "time": 395.99, "timestamp": "00:06:35", "text": "それ。そういうことがたくさんあります。それで、"}, {"type": "subtitle", "time": 408.1, "timestamp": "00:06:48", "text": "わかった。皆さんに見ていただくために、私が見せます。"}, {"type": "subtitle", "time": 409.189, "timestamp": "00:06:49", "text": "[音楽]"}, {"type": "subtitle", "time": 411.189, "timestamp": "00:06:51", "text": "何が起こったのかはわかりませんが、"}, {"type": "subtitle", "time": 413.83, "timestamp": "00:06:53", "text": "奇妙だった。ちょっと怖かった"}, {"type": "subtitle", "time": 416.909, "timestamp": "00:06:56", "text": "ちょっと、私の配信が"}]
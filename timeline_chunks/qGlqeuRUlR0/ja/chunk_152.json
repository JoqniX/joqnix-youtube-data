[{"type": "subtitle", "time": 9125.92, "timestamp": "02:32:05", "text": "これと、そう、これがやってくる"}, {"type": "subtitle", "time": 9127.95, "timestamp": "02:32:07", "text": "[音楽]"}, {"type": "subtitle", "time": 9130.63, "timestamp": "02:32:10", "text": "ここ。見ていて面白いのは分かっていますが、"}, {"type": "subtitle", "time": 9131.95, "timestamp": "02:32:11", "text": "しかし"}, {"type": "subtitle", "time": 9136.23, "timestamp": "02:32:16", "text": "ええ、最近更新していませんでした。私"}, {"type": "subtitle", "time": 9137.75, "timestamp": "02:32:17", "text": "現時点では完全にアップデートされていると認識しています"}, {"type": "subtitle", "time": 9141.19, "timestamp": "02:32:21", "text": "でも、私はまだ全部の手配をしていないんです。"}, {"type": "subtitle", "time": 9143.11, "timestamp": "02:32:23", "text": "正しくアップロードされましたが、"}, {"type": "subtitle", "time": 9145.67, "timestamp": "02:32:25", "text": "まだプレイリストを作成していません。そうしなければならなかった"}, {"type": "subtitle", "time": 9147.83, "timestamp": "02:32:27", "text": "手動で配置してここに追加してください。いいえ、"}, {"type": "subtitle", "time": 9156.67, "timestamp": "02:32:36", "text": "[音楽]"}, {"type": "subtitle", "time": 9166.55, "timestamp": "02:32:46", "text": "この動画を楽しんでいただければ幸いです。私たちは戻ってきました。私は"}, {"type": "subtitle", "time": 9168.23, "timestamp": "02:32:48", "text": "ごめん。"}, {"type": "subtitle", "time": 9172.23, "timestamp": "02:32:52", "text": "何てことだ。なぜあんなに酔ったような声だったんだろう？えっと"}, {"type": "subtitle", "time": 9176.19, "timestamp": "02:32:56", "text": "ああ、あれは朝の騎手だったね。"}, {"type": "subtitle", "time": 9179.87, "timestamp": "02:32:59", "text": "ああ、長いvを楽しんでいただければ幸いです"}]
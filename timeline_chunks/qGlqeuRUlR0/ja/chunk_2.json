[{"type": "subtitle", "time": 122.23, "timestamp": "00:02:02", "text": "それをやり遂げたので、戻ってきました。"}, {"type": "subtitle", "time": 124.03, "timestamp": "00:02:04", "text": "さあ、戻ってきました"}, {"type": "subtitle", "time": 126.87, "timestamp": "00:02:06", "text": "ここ。皆さんがお元気でいらっしゃることを願っています。"}, {"type": "subtitle", "time": 130.22899999999998, "timestamp": "00:02:10", "text": "ええと、それは正しいと思います"}, {"type": "subtitle", "time": 132.71, "timestamp": "00:02:12", "text": "今何時ですか？ええ、4時です。"}, {"type": "subtitle", "time": 136.47, "timestamp": "00:02:16", "text": "ということで、今日の配信は少なくとも"}, {"type": "subtitle", "time": 138.949, "timestamp": "00:02:18", "text": "1時間か2時間。ええと、私たちは"}, {"type": "subtitle", "time": 143.35, "timestamp": "00:02:23", "text": "6時までに再び配信開始。えーっと、私が"}, {"type": "subtitle", "time": 146.39, "timestamp": "00:02:26", "text": "長時間の配信は行いません"}, {"type": "subtitle", "time": 150.63, "timestamp": "00:02:30", "text": "しばらくの間、私にはいくつか物があるので"}, {"type": "subtitle", "time": 153.43, "timestamp": "00:02:33", "text": "理解する必要があるし、好きだし、"}, {"type": "subtitle", "time": 157.19, "timestamp": "00:02:37", "text": "家族のために調整する必要がある。それで、"}, {"type": "subtitle", "time": 159.82999999999998, "timestamp": "00:02:39", "text": "うん、大丈夫だといいんだけど。"}, {"type": "subtitle", "time": 161.47, "timestamp": "00:02:41", "text": "本当にそうであってほしい"}, {"type": "subtitle", "time": 164.03, "timestamp": "00:02:44", "text": "アーナ。"}, {"type": "subtitle", "time": 166.869, "timestamp": "00:02:46", "text": "はい。来てくださった皆様、ありがとうございました。"}, {"type": "subtitle", "time": 170.35, "timestamp": "00:02:50", "text": "Twitchストリームへ"}, {"type": "subtitle", "time": 172.71, "timestamp": "00:02:52", "text": "以前。ほら、ほら、私たちは"}, {"type": "subtitle", "time": 173.63, "timestamp": "00:02:53", "text": "作る"}, {"type": "subtitle", "time": 176.71, "timestamp": "00:02:56", "text": "何か。秘密にしておきましょう"}, {"type": "subtitle", "time": 178.949, "timestamp": "00:02:58", "text": "メッセージか何か"}]
[{"type": "subtitle", "time": 9182.83, "timestamp": "02:33:02", "text": "前。こんにちは、私たちは戻ってきました"}, {"type": "subtitle", "time": 9186.63, "timestamp": "02:33:06", "text": "私たちの現在に目を向けてみましょう"}, {"type": "subtitle", "time": 9195.55, "timestamp": "02:33:15", "text": "わかった。"}, {"type": "subtitle", "time": 9200.429, "timestamp": "02:33:20", "text": "[音楽]"}, {"type": "subtitle", "time": 9203.11, "timestamp": "02:33:23", "text": "えーと、こんにちは海兵隊員の皆さん、ようこそ"}, {"type": "subtitle", "time": 9204.75, "timestamp": "02:33:24", "text": "ストリーム。こんにちは。"}, {"type": "subtitle", "time": 9216.83, "timestamp": "02:33:36", "text": "それで、私は源氏のポンのコスプレをしています"}, {"type": "subtitle", "time": 9220.429, "timestamp": "02:33:40", "text": "インパクト。ああ、なるほど。"}]
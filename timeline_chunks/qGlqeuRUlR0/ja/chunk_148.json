[{"type": "subtitle", "time": 8884.79, "timestamp": "02:28:04", "text": "ユノスと私は、私は遊びたくない"}, {"type": "subtitle", "time": 8887.27, "timestamp": "02:28:07", "text": "スターレール。"}, {"type": "subtitle", "time": 8888.51, "timestamp": "02:28:08", "text": "私は自分が"}, {"type": "subtitle", "time": 8893.23, "timestamp": "02:28:13", "text": "すべきだけど、楽しそうに感じる、"}, {"type": "subtitle", "time": 8898.03, "timestamp": "02:28:18", "text": "[音楽]"}, {"type": "subtitle", "time": 8901.15, "timestamp": "02:28:21", "text": "とても感じます"}, {"type": "subtitle", "time": 8904.75, "timestamp": "02:28:24", "text": "まあ、楽しいかな。"}, {"type": "subtitle", "time": 8914.99, "timestamp": "02:28:34", "text": "えーと、新しい"}, {"type": "subtitle", "time": 8918.07, "timestamp": "02:28:38", "text": "君がまさにやっていたこと"}, {"type": "subtitle", "time": 8920.59, "timestamp": "02:28:40", "text": "新しい2.0は知っている"}, {"type": "subtitle", "time": 8924.23, "timestamp": "02:28:44", "text": "予告編などを公開して"}, {"type": "subtitle", "time": 8925.59, "timestamp": "02:28:45", "text": "キャラクターたちが私を"}, {"type": "subtitle", "time": 8927.59, "timestamp": "02:28:47", "text": "興味はあるが、たとえ"}, {"type": "subtitle", "time": 8929.389, "timestamp": "02:28:49", "text": "私は手に入れている"}, {"type": "subtitle", "time": 8933.23, "timestamp": "02:28:53", "text": "興味はあるけど、長続きしないだろうね。"}, {"type": "subtitle", "time": 8938.59, "timestamp": "02:28:58", "text": "それは、私があなたに言うように、"}]
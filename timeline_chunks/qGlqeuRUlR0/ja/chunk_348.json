[{"type": "subtitle", "time": 20883.31, "timestamp": "05:48:03", "text": "英語で話しかけてくる人"}, {"type": "subtitle", "time": 20886.39, "timestamp": "05:48:06", "text": "あるいは、あなたが話すと彼らは"}, {"type": "subtitle", "time": 20888.11, "timestamp": "05:48:08", "text": "のように"}, {"type": "subtitle", "time": 20891.11, "timestamp": "05:48:11", "text": "ああ、日本語を知っていて、彼らが話すように"}, {"type": "subtitle", "time": 20894.99, "timestamp": "05:48:14", "text": "あなたと気軽に話すとか、そういう感じで。"}, {"type": "subtitle", "time": 20900.99, "timestamp": "05:48:20", "text": "えーっと、普段は"}, {"type": "subtitle", "time": 20906.15, "timestamp": "05:48:26", "text": "普段は、ほとんど話さない。"}, {"type": "subtitle", "time": 20908.47, "timestamp": "05:48:28", "text": "まるで誰もあなたに話しかけてこないみたい"}, {"type": "subtitle", "time": 20911.35, "timestamp": "05:48:31", "text": "それはまるであなたが"}, {"type": "subtitle", "time": 20914.788, "timestamp": "05:48:34", "text": "コンビニエンスストアまたはスーパーマーケット"}, {"type": "subtitle", "time": 20918.15, "timestamp": "05:48:38", "text": "彼らは言うとおりに、実行するだろう"}, {"type": "subtitle", "time": 20921.67, "timestamp": "05:48:41", "text": "あなたは彼らの仕事をし、あなたはめったに必要としません"}, {"type": "subtitle", "time": 20925.51, "timestamp": "05:48:45", "text": "誰かと話す、あるいはたとえあなたが"}, {"type": "subtitle", "time": 20928.43, "timestamp": "05:48:48", "text": "まるで何も言わないかのように"}, {"type": "subtitle", "time": 20932.07, "timestamp": "05:48:52", "text": "少なくとも私の場合は、"}, {"type": "subtitle", "time": 20934.51, "timestamp": "05:48:54", "text": "あまり話していない"}, {"type": "subtitle", "time": 20938.31, "timestamp": "05:48:58", "text": "店内の誰か、まるで客のような人"}]
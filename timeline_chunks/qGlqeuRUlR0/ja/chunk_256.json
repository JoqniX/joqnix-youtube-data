[{"type": "subtitle", "time": 15364.59, "timestamp": "04:16:04", "text": "私のは、えっと、内蔵型です"}, {"type": "subtitle", "time": 15367.99, "timestamp": "04:16:07", "text": "1999年。インターネット接続は"}, {"type": "subtitle", "time": 15370.95, "timestamp": "04:16:10", "text": "VDSLみたいな古いもの"}, {"type": "subtitle", "time": 15375.269, "timestamp": "04:16:15", "text": "接続方式はADSLだと思います。だから古い"}, {"type": "subtitle", "time": 15378.71, "timestamp": "04:16:18", "text": "電話回線、彼らはその回線を使って"}, {"type": "subtitle", "time": 15381.03, "timestamp": "04:16:21", "text": "インターネット信号を送信するようなものだ。それで"}, {"type": "subtitle", "time": 15385.149, "timestamp": "04:16:25", "text": "40Mbpsくらいかな"}, {"type": "subtitle", "time": 15389.229, "timestamp": "04:16:29", "text": "下降と80上昇、あるいはそんな感じ"}, {"type": "subtitle", "time": 15392.469, "timestamp": "04:16:32", "text": "それ。つまり、なぜ彼らは"}, {"type": "subtitle", "time": 15395.03, "timestamp": "04:16:35", "text": "インドでは、Jio は"}, {"type": "subtitle", "time": 15399.99, "timestamp": "04:16:39", "text": "新しいものを置いて、ええ、"}, {"type": "subtitle", "time": 15402.469, "timestamp": "04:16:42", "text": "近くに新しい接続を設置するなど"}, {"type": "subtitle", "time": 15406.63, "timestamp": "04:16:46", "text": "ああ、そうだね。えっと、それは状況によります。"}, {"type": "subtitle", "time": 15411.11, "timestamp": "04:16:51", "text": "あなたの建物。まるで私が住んでいるような"}, {"type": "subtitle", "time": 15414.309, "timestamp": "04:16:54", "text": "高いところ。私は6階に住んでいて"}, {"type": "subtitle", "time": 15416.389, "timestamp": "04:16:56", "text": "彼らは新しいものを手に入れることはできない"}, {"type": "subtitle", "time": 15418.469, "timestamp": "04:16:58", "text": "繋がり"}]
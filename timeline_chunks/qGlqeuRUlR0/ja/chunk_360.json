[{"type": "subtitle", "time": 21600.548, "timestamp": "06:00:00", "text": "私は話すのが苦手ですが、あなたは良い"}, {"type": "subtitle", "time": 21602.27, "timestamp": "06:00:02", "text": "のように"}, {"type": "subtitle", "time": 21604.788, "timestamp": "06:00:04", "text": "会話。はぁ？会話"}, {"type": "subtitle", "time": 21606.39, "timestamp": "06:00:06", "text": "パートナー？"}, {"type": "subtitle", "time": 21610.708, "timestamp": "06:00:10", "text": "私は持っている。うん、君とは話しやすいね。"}, {"type": "subtitle", "time": 21612.39, "timestamp": "06:00:12", "text": "うん、"}, {"type": "subtitle", "time": 21617.36, "timestamp": "06:00:17", "text": "そう思います、それは役に立ちますね。"}, {"type": "subtitle", "time": 21620.548, "timestamp": "06:00:20", "text": "[音楽]"}, {"type": "subtitle", "time": 21630.788, "timestamp": "06:00:30", "text": "だから、もっと一緒に過ごすべきだ"}, {"type": "subtitle", "time": 21632.628, "timestamp": "06:00:32", "text": "未来。"}, {"type": "subtitle", "time": 21634.47, "timestamp": "06:00:34", "text": "うん、"}, {"type": "subtitle", "time": 21646.31, "timestamp": "06:00:46", "text": "[音楽]"}, {"type": "subtitle", "time": 21649.35, "timestamp": "06:00:49", "text": "もっと一緒に遊んでゲームをしよう"}, {"type": "subtitle", "time": 21652.948, "timestamp": "06:00:52", "text": "あなたが言ったようなことですね。はい。はい。それ"}, {"type": "subtitle", "time": 21655.51, "timestamp": "06:00:55", "text": "楽しいだろう。"}, {"type": "subtitle", "time": 21658.708, "timestamp": "06:00:58", "text": "とても楽しかった。うん。"}]
[{"type": "subtitle", "time": 18782.39, "timestamp": "05:13:02", "text": "ポイント。"}, {"type": "subtitle", "time": 18784.47, "timestamp": "05:13:04", "text": "そして私はこう思った。"}, {"type": "subtitle", "time": 18787.11, "timestamp": "05:13:07", "text": "えーと、私は苦労して学んだんです、"}, {"type": "subtitle", "time": 18791.27, "timestamp": "05:13:11", "text": "人は、ほら、人が"}, {"type": "subtitle", "time": 18793.75, "timestamp": "05:13:13", "text": "物事を違った視点で見たり、対立を好んだりする"}, {"type": "subtitle", "time": 18796.31, "timestamp": "05:13:16", "text": "あるいは何か、あるいはあなたがそうでないとしても"}, {"type": "subtitle", "time": 18799.91, "timestamp": "05:13:19", "text": "関わっている人は、ある意味でそれを試みるだろう"}, {"type": "subtitle", "time": 18801.99, "timestamp": "05:13:21", "text": "あなたを巻き込んであなたを落ち込ませたり、"}, {"type": "subtitle", "time": 18805.99, "timestamp": "05:13:25", "text": "まあ、何でもいいよ。たくさんのもの"}, {"type": "subtitle", "time": 18808.948, "timestamp": "05:13:28", "text": "私も考えているのですが、JPサイトには"}, {"type": "subtitle", "time": 18811.23, "timestamp": "05:13:31", "text": "多くのユーチューバー"}, {"type": "subtitle", "time": 18814.31, "timestamp": "05:13:34", "text": "人々は同じものを持っていた"}, {"type": "subtitle", "time": 18817.19, "timestamp": "05:13:37", "text": "疑問符が付いて、うん"}, {"type": "subtitle", "time": 18820.31, "timestamp": "05:13:40", "text": "こういう経験をする人もいると思う"}, {"type": "subtitle", "time": 18822.39, "timestamp": "05:13:42", "text": "右"}, {"type": "subtitle", "time": 18825.83, "timestamp": "05:13:45", "text": "うん、良い面と悪い面があると思う"}, {"type": "subtitle", "time": 18828.628, "timestamp": "05:13:48", "text": "どこにでもあるので、"}, {"type": "subtitle", "time": 18831.75, "timestamp": "05:13:51", "text": "これらのこともそうですが、あなたが"}, {"type": "subtitle", "time": 18834.788, "timestamp": "05:13:54", "text": "とにかく楽しんでください。あなたは"}]
[{"type": "subtitle", "time": 19621.03, "timestamp": "05:27:01", "text": "これからは、"}, {"type": "subtitle", "time": 19623.83, "timestamp": "05:27:03", "text": "新しいデザインと"}, {"type": "subtitle", "time": 19626.868, "timestamp": "05:27:06", "text": "すべてを知るためではなく"}, {"type": "subtitle", "time": 19630.15, "timestamp": "05:27:10", "text": "彼らがあなたを狙っている人、あなたの"}, {"type": "subtitle", "time": 19633.35, "timestamp": "05:27:13", "text": "数字か何かですよね？"}, {"type": "subtitle", "time": 19635.91, "timestamp": "05:27:15", "text": "うん、わからない、難しい"}, {"type": "subtitle", "time": 19639.35, "timestamp": "05:27:19", "text": "それらを区別する、しかし"}, {"type": "subtitle", "time": 19643.99, "timestamp": "05:27:23", "text": "あなたとあなたに何かが起こったとき"}, {"type": "subtitle", "time": 19646.47, "timestamp": "05:27:26", "text": "えっと、彼らはあなたの近くにいると思います"}, {"type": "subtitle", "time": 19649.03, "timestamp": "05:27:29", "text": "仲間とかそういう関係で、彼らは気にしない"}, {"type": "subtitle", "time": 19651.99, "timestamp": "05:27:31", "text": "または、普通にあなたを見ない"}, {"type": "subtitle", "time": 19654.948, "timestamp": "05:27:34", "text": "以前あなたが言ったように、いいえ"}, {"type": "subtitle", "time": 19657.43, "timestamp": "05:27:37", "text": "あなたの経験から。ああ、そういうやつね"}, {"type": "subtitle", "time": 19662.07, "timestamp": "05:27:42", "text": "それも面倒だと思う。そして私はある意味"}, {"type": "subtitle", "time": 19664.868, "timestamp": "05:27:44", "text": "少しずつ試しています。新しいサイトを見ています。"}, {"type": "subtitle", "time": 19665.548, "timestamp": "05:27:45", "text": "の"}, {"type": "subtitle", "time": 19668.708, "timestamp": "05:27:48", "text": "みんな、私がこの大規模なコラボレーションをやっているから"}, {"type": "subtitle", "time": 19674.628, "timestamp": "05:27:54", "text": "正気の沙汰じゃない。"}, {"type": "subtitle", "time": 19677.35, "timestamp": "05:27:57", "text": "つまり、あまり深く考えない方がいいってことだよ。私"}]
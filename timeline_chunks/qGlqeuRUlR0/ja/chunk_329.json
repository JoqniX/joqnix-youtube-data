[{"type": "subtitle", "time": 19740.708, "timestamp": "05:29:00", "text": "そして、ただ遊んでいるだけの人や"}, {"type": "subtitle", "time": 19742.788, "timestamp": "05:29:02", "text": "何か。そして面白いことに私は"}, {"type": "subtitle", "time": 19745.27, "timestamp": "05:29:05", "text": "より多くのチャンスを与えるタイプ"}, {"type": "subtitle", "time": 19747.75, "timestamp": "05:29:07", "text": "私を傷つけた人たち、そして"}, {"type": "subtitle", "time": 19750.07, "timestamp": "05:29:10", "text": "破壊されたのではなく、私を傷つけたので"}, {"type": "subtitle", "time": 19752.548, "timestamp": "05:29:12", "text": "多くの。私は彼らを許します。もし彼らが"}, {"type": "subtitle", "time": 19755.51, "timestamp": "05:29:15", "text": "戻ってきたい、私は両手を広げる"}, {"type": "subtitle", "time": 19758.948, "timestamp": "05:29:18", "text": "そして、彼らを歓迎するようなタイプで、私は"}, {"type": "subtitle", "time": 19767.31, "timestamp": "05:29:27", "text": "はは、私にとっては難しい"}, {"type": "subtitle", "time": 19771.27, "timestamp": "05:29:31", "text": "賢明だと思うように最善を尽くした"}, {"type": "subtitle", "time": 19773.23, "timestamp": "05:29:33", "text": "毒のある場所から抜け出す"}, {"type": "subtitle", "time": 19776.948, "timestamp": "05:29:36", "text": "友情、そして私の一部は"}, {"type": "subtitle", "time": 19780.47, "timestamp": "05:29:40", "text": "そう、人は変わるものだよね"}, {"type": "subtitle", "time": 19784.15, "timestamp": "05:29:44", "text": "右？だから私はまだ話そうとすることができる"}, {"type": "subtitle", "time": 19787.35, "timestamp": "05:29:47", "text": "それらに化粧をする。すると私はこう思う。「でも"}, {"type": "subtitle", "time": 19790.548, "timestamp": "05:29:50", "text": "騎手、また怪我をしたいのか？"}, {"type": "subtitle", "time": 19793.868, "timestamp": "05:29:53", "text": "そして人は物事を忘れない、"}, {"type": "subtitle", "time": 19797.67, "timestamp": "05:29:57", "text": "右？だってそれが初めてだったから"}]
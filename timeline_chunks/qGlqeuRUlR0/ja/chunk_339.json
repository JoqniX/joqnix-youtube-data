[{"type": "subtitle", "time": 20345.83, "timestamp": "05:39:05", "text": "右？そうですね、それが"}, {"type": "subtitle", "time": 20348.31, "timestamp": "05:39:08", "text": "私を驚かせてくれ、失望させないでくれ。いいえ、"}, {"type": "subtitle", "time": 20351.19, "timestamp": "05:39:11", "text": "いいえ、私は彼らを信じ、信頼しています。しかし"}, {"type": "subtitle", "time": 20353.59, "timestamp": "05:39:13", "text": "そう、信じればいいんだ。うん。私はただ感じる"}, {"type": "subtitle", "time": 20356.39, "timestamp": "05:39:16", "text": "自分がしたことを二度と繰り返したくない"}, {"type": "subtitle", "time": 20358.47, "timestamp": "05:39:18", "text": "アーティストと一緒に、彼らをイライラさせるような"}, {"type": "chat", "time": 20358.783, "timestamp": "05:39:18", "author": "@anime_worlda3", "avatar": "https://yt4.ggpht.com/p33G8DLNzbqQ6niBlFYlaIKulLqoOC0WjBSo8YqOSiofweaj-hNDTXZDx3515mTlopGt5_1klA=s64-c-k-c0x00ffffff-no-rj", "message": "hii"}, {"type": "subtitle", "time": 20361.11, "timestamp": "05:39:21", "text": "物事を指摘するというのは、"}, {"type": "chat", "time": 20361.369, "timestamp": "05:39:21", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Anime world ~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "chat", "time": 20362.042, "timestamp": "05:39:22", "author": "@anime_worlda3", "avatar": "https://yt4.ggpht.com/p33G8DLNzbqQ6niBlFYlaIKulLqoOC0WjBSo8YqOSiofweaj-hNDTXZDx3515mTlopGt5_1klA=s64-c-k-c0x00ffffff-no-rj", "message": "hii"}, {"type": "subtitle", "time": 20364.43, "timestamp": "05:39:24", "text": "正しくない、これはあれではない、など"}, {"type": "subtitle", "time": 20367.75, "timestamp": "05:39:27", "text": "など。ええ。"}, {"type": "subtitle", "time": 20369.43, "timestamp": "05:39:29", "text": "こんにちは、アニメの世界。ようこそ"}, {"type": "subtitle", "time": 20371.99, "timestamp": "05:39:31", "text": "ストリーム。こんにちは。こんにちは、愛しい人。"}, {"type": "subtitle", "time": 20374.11, "timestamp": "05:39:34", "text": "こんにちは。"}, {"type": "chat", "time": 20379.242, "timestamp": "05:39:39", "author": "@anime_worlda3", "avatar": "https://yt4.ggpht.com/p33G8DLNzbqQ6niBlFYlaIKulLqoOC0WjBSo8YqOSiofweaj-hNDTXZDx3515mTlopGt5_1klA=s64-c-k-c0x00ffffff-no-rj", "message": "hii"}, {"type": "subtitle", "time": 20380.948, "timestamp": "05:39:40", "text": "それ。そして私は「うん、うまくいくといいな」って感じ"}, {"type": "subtitle", "time": 20383.83, "timestamp": "05:39:43", "text": "まあ、そうかな。」"}, {"type": "subtitle", "time": 20387.51, "timestamp": "05:39:47", "text": "デザイン？それについてどう思いますか？"}]
[{"type": "subtitle", "time": 10084.88, "timestamp": "02:48:04", "text": "外。はい、結構です。"}, {"type": "subtitle", "time": 10108.59, "timestamp": "02:48:28", "text": "わかった。でも、お前を殺すことはできるぞ。うん。わかった。"}, {"type": "subtitle", "time": 10110.83, "timestamp": "02:48:30", "text": "GG。殺害された"}, {"type": "subtitle", "time": 10114.309, "timestamp": "02:48:34", "text": "あなた。私はすべての吸血鬼を殺したい。"}, {"type": "subtitle", "time": 10122.95, "timestamp": "02:48:42", "text": "わかった。おお、いいね。ソウルは250まで行く。"}, {"type": "subtitle", "time": 10124.87, "timestamp": "02:48:44", "text": "よし、鎌を手に入れよう。私たちは手に入れることができます"}, {"type": "subtitle", "time": 10127.469, "timestamp": "02:48:47", "text": "サイト。さあ行こう。行け、行け、行け、行け、行け、"}, {"type": "subtitle", "time": 10130.07, "timestamp": "02:48:50", "text": "話す。視界を確保せよ。視界を確保せよ。得る"}, {"type": "subtitle", "time": 10131.389, "timestamp": "02:48:51", "text": "の"}, {"type": "subtitle", "time": 10137.63, "timestamp": "02:48:57", "text": "視力。視界を確保せよ。側面を入手してください。よお。"}, {"type": "subtitle", "time": 10139.71, "timestamp": "02:48:59", "text": "はい。"}]
[{"type": "subtitle", "time": 8941.07, "timestamp": "02:29:01", "text": "何て呼ぶんだっけ"}, {"type": "subtitle", "time": 8975.51, "timestamp": "02:29:35", "text": "えっと、なんて呼ぶんだっけ？むしろこうだ"}, {"type": "subtitle", "time": 8979.27, "timestamp": "02:29:39", "text": "えっと、何か見たんだけど"}, {"type": "subtitle", "time": 8982.23, "timestamp": "02:29:42", "text": "面白いし、プレイしてみたら、"}, {"type": "subtitle", "time": 8985.87, "timestamp": "02:29:45", "text": "ストーリー生成に追いつかなければならない"}, {"type": "subtitle", "time": 8987.389, "timestamp": "02:29:47", "text": "そして"}, {"type": "subtitle", "time": 8989.55, "timestamp": "02:29:49", "text": "インパクトを開始"}, {"type": "subtitle", "time": 8998.83, "timestamp": "02:29:58", "text": "良い。それが問題なのです。手に入れた"}]
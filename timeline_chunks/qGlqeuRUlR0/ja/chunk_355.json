[{"type": "subtitle", "time": 21301.51, "timestamp": "05:55:01", "text": "インド製品を販売する店のように"}, {"type": "subtitle", "time": 21304.948, "timestamp": "05:55:04", "text": "パキスタン人は食べ物や食材が好きです"}, {"type": "subtitle", "time": 21307.99, "timestamp": "05:55:07", "text": "スナック類も見つかるかもしれません。"}, {"type": "subtitle", "time": 21311.15, "timestamp": "05:55:11", "text": "あちらでも。"}, {"type": "subtitle", "time": 21314.39, "timestamp": "05:55:14", "text": "ああ、大丈夫だと思うよ。"}, {"type": "subtitle", "time": 21317.51, "timestamp": "05:55:17", "text": "特に東京では、"}, {"type": "subtitle", "time": 21321.19, "timestamp": "05:55:21", "text": "レストランのような食べ物がたくさん見つかる"}, {"type": "subtitle", "time": 21323.83, "timestamp": "05:55:23", "text": "そして食料品店。"}, {"type": "subtitle", "time": 21327.19, "timestamp": "05:55:27", "text": "大丈夫だよ。おお"}, {"type": "subtitle", "time": 21330.31, "timestamp": "05:55:30", "text": "うん。そして、あなたも同じように手に入れることができます"}, {"type": "subtitle", "time": 21334.39, "timestamp": "05:55:34", "text": "インド産またはパキスタン産の米も。"}, {"type": "subtitle", "time": 21336.868, "timestamp": "05:55:36", "text": "値段はほぼ同じで、"}, {"type": "subtitle", "time": 21338.948, "timestamp": "05:55:38", "text": "日本米のようなケースでは"}, {"type": "subtitle", "time": 21341.23, "timestamp": "05:55:41", "text": "高い。"}, {"type": "subtitle", "time": 21345.91, "timestamp": "05:55:45", "text": "そうですね、その点は覚えておいてください。私は好きです"}, {"type": "subtitle", "time": 21349.51, "timestamp": "05:55:49", "text": "ああ、飲んでいる。 「I like」へようこそ"}, {"type": "subtitle", "time": 21353.548, "timestamp": "05:55:53", "text": "飲んでる、あぁあぁ"}, {"type": "subtitle", "time": 21357.75, "timestamp": "05:55:57", "text": "バターミルク。ここのバターは"}]
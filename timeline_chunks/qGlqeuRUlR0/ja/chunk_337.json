[{"type": "subtitle", "time": 20223.91, "timestamp": "05:37:03", "text": "いいえ。ええと、忙しすぎて。"}, {"type": "subtitle", "time": 20227.35, "timestamp": "05:37:07", "text": "昔のファイルを失くしたみたいに、YouTuber"}, {"type": "subtitle", "time": 20230.07, "timestamp": "05:37:10", "text": "モデルファイルなど全て。私はこう思った"}, {"type": "subtitle", "time": 20232.788, "timestamp": "05:37:12", "text": "新しいモデルとハードドライブを作成する"}, {"type": "subtitle", "time": 20235.35, "timestamp": "05:37:15", "text": "失敗した。私のメインハード両方が好きです"}, {"type": "subtitle", "time": 20237.99, "timestamp": "05:37:17", "text": "ドライブとバックアップドライブの両方が故障しました"}, {"type": "subtitle", "time": 20241.35, "timestamp": "05:37:21", "text": "そして私は全てを失った。いいえ。そして私も"}, {"type": "subtitle", "time": 20245.19, "timestamp": "05:37:25", "text": "すごく忙しかったので、実際には"}, {"type": "subtitle", "time": 20248.39, "timestamp": "05:37:28", "text": "何かした"}, {"type": "subtitle", "time": 20254.548, "timestamp": "05:37:34", "text": "でも、一度PCを手に入れたら"}, {"type": "subtitle", "time": 20258.708, "timestamp": "05:37:38", "text": "すべて準備が整いました。自分で作るかもしれません。"}, {"type": "subtitle", "time": 20261.83, "timestamp": "05:37:41", "text": "えーと、新しいモデルとか、あるいは私は"}, {"type": "subtitle", "time": 20266.47, "timestamp": "05:37:46", "text": "2Dアートのようなアート作品を依頼する"}, {"type": "subtitle", "time": 20269.91, "timestamp": "05:37:49", "text": "そして、それに対して何か行動を起こす、例えば"}, {"type": "subtitle", "time": 20274.788, "timestamp": "05:37:54", "text": "PNGから始めて、その後2Dに移行するかもしれません"}, {"type": "subtitle", "time": 20277.75, "timestamp": "05:37:57", "text": "委託されたモデルのようなもの"}]
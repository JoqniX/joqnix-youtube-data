[{"type": "subtitle", "time": 13706.95, "timestamp": "03:48:26", "text": "いいえ。先生、失礼します。眠気を覚ましてください。"}, {"type": "subtitle", "time": 13710.99, "timestamp": "03:48:30", "text": "何てことだ。あれは一体何だったんだ？ああ、"}, {"type": "subtitle", "time": 13714.95, "timestamp": "03:48:34", "text": "神。ああ、あと少しだったのに。あと少しだったのに。"}, {"type": "subtitle", "time": 13717.99, "timestamp": "03:48:37", "text": "何？私に何が起こったの？なぜ私は"}, {"type": "subtitle", "time": 13720.61, "timestamp": "03:48:40", "text": "私はそんな馬鹿なことをしたのか？"}, {"type": "subtitle", "time": 13727.349, "timestamp": "03:48:47", "text": "動く？おお。"}]
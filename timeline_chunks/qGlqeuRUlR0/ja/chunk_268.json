[{"type": "subtitle", "time": 16082.349, "timestamp": "04:28:02", "text": "それはすごい量ですね。え、本当に？"}, {"type": "subtitle", "time": 16085.269, "timestamp": "04:28:05", "text": "ああ、俺はもう死んじゃうよ。私には無理だと思う"}, {"type": "subtitle", "time": 16087.59, "timestamp": "04:28:07", "text": "今年デビュー。私はそう思う"}, {"type": "subtitle", "time": 16090.149, "timestamp": "04:28:10", "text": "デビューまでに4年かかる。私は保存します"}, {"type": "subtitle", "time": 16098.59, "timestamp": "04:28:18", "text": "あなたならできるといいですね。"}, {"type": "subtitle", "time": 16102.03, "timestamp": "04:28:22", "text": "ええ、そうです"}, {"type": "subtitle", "time": 16107.349, "timestamp": "04:28:27", "text": "難しい。かなりの量だ。ええ、でも"}, {"type": "subtitle", "time": 16110.55, "timestamp": "04:28:30", "text": "何？えっと、10円はどうですか？待って、1万円です。"}, {"type": "subtitle", "time": 16113.429, "timestamp": "04:28:33", "text": "えっと、いくらでしたっけ？"}, {"type": "subtitle", "time": 16115.229, "timestamp": "04:28:35", "text": "10,000。"}, {"type": "subtitle", "time": 16124.55, "timestamp": "04:28:44", "text": "ああ、日々の必需品と"}, {"type": "subtitle", "time": 16126.95, "timestamp": "04:28:46", "text": "シャンプーとか全部とか"}, {"type": "subtitle", "time": 16128.55, "timestamp": "04:28:48", "text": "それらは、"}, {"type": "subtitle", "time": 16130.87, "timestamp": "04:28:50", "text": "コンビニですよね？"}, {"type": "subtitle", "time": 16135.269, "timestamp": "04:28:55", "text": "ええと、シャンプーはコンビニで買えますよ"}, {"type": "subtitle", "time": 16139.229, "timestamp": "04:28:59", "text": "店だと思います。私は主に販売しています"}]
[{"type": "subtitle", "time": 8704.15, "timestamp": "02:25:04", "text": "午前9時、第2部。"}, {"type": "subtitle", "time": 8708.71, "timestamp": "02:25:08", "text": "ええと、囚人ではなく、そういうことです。はい、私は"}, {"type": "subtitle", "time": 8712.11, "timestamp": "02:25:12", "text": "いい尻してるね。いらっしゃいませ。私はちょうど"}, {"type": "subtitle", "time": 8715.91, "timestamp": "02:25:15", "text": "私の夕食と、私は見つける必要がある"}, {"type": "subtitle", "time": 8718.309, "timestamp": "02:25:18", "text": "薬とかそういうもの"}, {"type": "subtitle", "time": 8720.469, "timestamp": "02:25:20", "text": "熱と風邪のために"}, {"type": "subtitle", "time": 8722.55, "timestamp": "02:25:22", "text": "すべて。では、階下へ降りて"}, {"type": "subtitle", "time": 8723.87, "timestamp": "02:25:23", "text": "両親に聞いてみて"}, {"type": "subtitle", "time": 8728.389, "timestamp": "02:25:28", "text": "また。こんにちは。その前に、えーと準備します"}, {"type": "subtitle", "time": 8731.27, "timestamp": "02:25:31", "text": "戦争の件。わかった。こんにちは。戦争を見る"}, {"type": "subtitle", "time": 8732.91, "timestamp": "02:25:32", "text": "しばらくの間。私は"}, {"type": "subtitle", "time": 8738.27, "timestamp": "02:25:38", "text": "戻る。今度は何が手に入るの？えっと"}, {"type": "subtitle", "time": 8741.309, "timestamp": "02:25:41", "text": "アサ。またアサドか。ああ、それは縦型だ"}, {"type": "subtitle", "time": 8745.79, "timestamp": "02:25:45", "text": "ストリーム。こんにちは、楽しんでください。私は"}, {"type": "subtitle", "time": 8748.469, "timestamp": "02:25:48", "text": "戻る。プラグインはそこでリリースされました。アドバンス"}, {"type": "subtitle", "time": 8758.67, "timestamp": "02:25:58", "text": "OBSプラグインがいくつか見えます"}]
[{"type": "subtitle", "time": 4561.91, "timestamp": "01:16:01", "text": "エージェントはそれぞれ異なる"}, {"type": "subtitle", "time": 4565.43, "timestamp": "01:16:05", "text": "能力のことですよね？そんな感じで"}, {"type": "subtitle", "time": 4567.99, "timestamp": "01:16:07", "text": "オーバーウォッチのヒーローはみんな"}, {"type": "subtitle", "time": 4571.11, "timestamp": "01:16:11", "text": "彼ら自身の能力と武器。それで"}, {"type": "subtitle", "time": 4573.75, "timestamp": "01:16:13", "text": "そう、弓のように演奏したいんだ"}, {"type": "subtitle", "time": 4576.39, "timestamp": "01:16:16", "text": "キャラクターを選ぶなら、ハンゾーを選ぶべきだ。"}, {"type": "subtitle", "time": 4579.07, "timestamp": "01:16:19", "text": "それは、"}, {"type": "subtitle", "time": 4583.59, "timestamp": "01:16:23", "text": "そうやってお辞儀をするんだ。それでは最善を尽くしましょう"}, {"type": "subtitle", "time": 4585.88, "timestamp": "01:16:25", "text": "これをやって、これを勝ち取ろう。"}, {"type": "subtitle", "time": 4599.51, "timestamp": "01:16:39", "text": "トロールって何でしたっけ？何？トロールとは何か"}]
[{"type": "subtitle", "time": 17402.31, "timestamp": "04:50:02", "text": "うん。そして、もしあなたが本当にそう感じるなら"}, {"type": "subtitle", "time": 17405.91, "timestamp": "04:50:05", "text": "えっと、あなたは何かを知らない"}, {"type": "subtitle", "time": 17409.51, "timestamp": "04:50:09", "text": "そして、あなたは本当に誰かに尋ねることはできません、"}, {"type": "subtitle", "time": 17412.31, "timestamp": "04:50:12", "text": "いつでも電話してください。私はいつも"}, {"type": "subtitle", "time": 17414.43, "timestamp": "04:50:14", "text": "ここ。それで"}, {"type": "subtitle", "time": 17424.71, "timestamp": "04:50:24", "text": "うん。うん。うん。"}, {"type": "subtitle", "time": 17429.31, "timestamp": "04:50:29", "text": "[音楽]"}, {"type": "subtitle", "time": 17432.31, "timestamp": "04:50:32", "text": "ちょうど2つ"}, {"type": "subtitle", "time": 17441.11, "timestamp": "04:50:41", "text": "[音楽]"}, {"type": "subtitle", "time": 17448.47, "timestamp": "04:50:48", "text": "えっと、実はよくわからないんです。"}, {"type": "subtitle", "time": 17450.47, "timestamp": "04:50:50", "text": "物事がうまくいっているのに、心配している"}, {"type": "subtitle", "time": 17452.91, "timestamp": "04:50:52", "text": "依然として不安"}]
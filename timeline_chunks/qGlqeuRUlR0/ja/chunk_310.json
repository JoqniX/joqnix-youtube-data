[{"type": "subtitle", "time": 18600.55, "timestamp": "05:10:00", "text": "彼らに戦いを挑ませよう"}, {"type": "subtitle", "time": 18603.19, "timestamp": "05:10:03", "text": "ロイヤルスタイル"}, {"type": "subtitle", "time": 18606.31, "timestamp": "05:10:06", "text": "そして、あなたのように生き残る人は"}, {"type": "subtitle", "time": 18609.31, "timestamp": "05:10:09", "text": "彼らと協力する。"}, {"type": "subtitle", "time": 18612.47, "timestamp": "05:10:12", "text": "うん。ドラマやドラマを経験したことがありますか？"}, {"type": "subtitle", "time": 18615.31, "timestamp": "05:10:15", "text": "vtubing 内のもの"}, {"type": "subtitle", "time": 18618.948, "timestamp": "05:10:18", "text": "球？えっと"}, {"type": "subtitle", "time": 18621.19, "timestamp": "05:10:21", "text": "えーと"}, {"type": "subtitle", "time": 18624.07, "timestamp": "05:10:24", "text": "もし共有しても構わないなら、"}, {"type": "subtitle", "time": 18626.31, "timestamp": "05:10:26", "text": "知りたいのですが、もしあなたが持っているなら"}, {"type": "subtitle", "time": 18629.15, "timestamp": "05:10:29", "text": "JP側の事情を経験した人はいますか？"}, {"type": "subtitle", "time": 18631.67, "timestamp": "05:10:31", "text": "誤解とか何かあったのか、そしてそれは"}, {"type": "subtitle", "time": 18635.91, "timestamp": "05:10:35", "text": "解決可能か？うん、持ってるけど、"}, {"type": "subtitle", "time": 18638.708, "timestamp": "05:10:38", "text": "ドラマチックな展開とは違います。それはもっと"}, {"type": "subtitle", "time": 18648.11, "timestamp": "05:10:48", "text": "えっと、仲違いしたり、話さなくなったり"}, {"type": "subtitle", "time": 18651.31, "timestamp": "05:10:51", "text": "もうこれ以上ドラマはごめんだ。"}, {"type": "subtitle", "time": 18655.75, "timestamp": "05:10:55", "text": "ああ、忙しいからって、仲違いするってこと？"}, {"type": "subtitle", "time": 18657.67, "timestamp": "05:10:57", "text": "人生にはいろいろあって、あなたは"}, {"type": "subtitle", "time": 18659.91, "timestamp": "05:10:59", "text": "積極的に彼らと話し合ってください。だから彼らはこう考えている"}]
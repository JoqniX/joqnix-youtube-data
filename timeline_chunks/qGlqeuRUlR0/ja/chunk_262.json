[{"type": "subtitle", "time": 15721.349, "timestamp": "04:22:01", "text": "最近私がここにいることを受け入れた"}, {"type": "subtitle", "time": 15724.51, "timestamp": "04:22:04", "text": "実際ここにあり、それは単なる"}, {"type": "subtitle", "time": 15727.55, "timestamp": "04:22:07", "text": "夢。だから、あなたはこう感じるかもしれないと思う"}, {"type": "subtitle", "time": 15732.79, "timestamp": "04:22:12", "text": "そうかもしれないね。だから、それは起こるだろう。私"}, {"type": "subtitle", "time": 15737.03, "timestamp": "04:22:17", "text": "見えるよ。自分がそう言うかもしれない。"}, {"type": "subtitle", "time": 15740.07, "timestamp": "04:22:20", "text": "うん。トレーニング中や"}, {"type": "subtitle", "time": 15743.83, "timestamp": "04:22:23", "text": "私が貸し出していたクラスはどこにあるのか"}, {"type": "subtitle", "time": 15753.07, "timestamp": "04:22:33", "text": "さようなら。くそ。見つかりません"}, {"type": "subtitle", "time": 15757.469, "timestamp": "04:22:37", "text": "私の部屋の写真が見つかりません。おお、"}, {"type": "subtitle", "time": 15763.229, "timestamp": "04:22:43", "text": "それは私の"}, {"type": "subtitle", "time": 15765.83, "timestamp": "04:22:45", "text": "ええと、騒音の苦情についてです。私はしません"}, {"type": "subtitle", "time": 15768.87, "timestamp": "04:22:48", "text": "何をすべきかを知っている。チェックしましたか？"}, {"type": "subtitle", "time": 15771.99, "timestamp": "04:22:51", "text": "もしあなたがコックルームを借りることができたら"}, {"type": "subtitle", "time": 15774.55, "timestamp": "04:22:54", "text": "もしくは何か、もしくはカフェか何か"}, {"type": "subtitle", "time": 15778.63, "timestamp": "04:22:58", "text": "インターネットルームか何か、"}]
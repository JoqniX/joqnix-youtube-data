[{"type": "subtitle", "time": 18063.03, "timestamp": "05:01:03", "text": "君の翌晩。おお。えーと、彼らは"}, {"type": "subtitle", "time": 18066.708, "timestamp": "05:01:06", "text": "彼らは適切に入ることができないでしょう"}, {"type": "subtitle", "time": 18070.39, "timestamp": "05:01:10", "text": "えーと、時間通りに、彼らは"}, {"type": "subtitle", "time": 18073.75, "timestamp": "05:01:13", "text": "家族数人がやって来た。それで"}, {"type": "subtitle", "time": 18076.19, "timestamp": "05:01:16", "text": "ええ、だから私たちはもう少し時間があります"}, {"type": "subtitle", "time": 18080.15, "timestamp": "05:01:20", "text": "2番目のコーラパートナーが"}, {"type": "subtitle", "time": 18082.55, "timestamp": "05:01:22", "text": "2番目のコーラパートナーの準備が整いました。そうですね、"}, {"type": "subtitle", "time": 18085.35, "timestamp": "05:01:25", "text": "私は嬉しい。ええ、少し"}, {"type": "subtitle", "time": 18089.99, "timestamp": "05:01:29", "text": "もっと時間が必要だ。それはすべて良いことです。"}, {"type": "subtitle", "time": 18092.07, "timestamp": "05:01:32", "text": "ニース。"}, {"type": "subtitle", "time": 18092.83, "timestamp": "05:01:32", "text": "それは"}, {"type": "subtitle", "time": 18096.91, "timestamp": "05:01:36", "text": "良い。時間はあっという間に過ぎ去る。"}, {"type": "subtitle", "time": 18099.35, "timestamp": "05:01:39", "text": "[音楽]"}, {"type": "subtitle", "time": 18101.67, "timestamp": "05:01:41", "text": "持続する。"}, {"type": "subtitle", "time": 18105.67, "timestamp": "05:01:45", "text": "えっと、あと、どうだったか聞きたかったんだけど"}]
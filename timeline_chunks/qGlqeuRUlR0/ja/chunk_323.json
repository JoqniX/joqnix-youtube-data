[{"type": "subtitle", "time": 19380.4, "timestamp": "05:23:00", "text": "彼らが望むものを何でも与える 昔のあれ。そして私はそれを学んだ"}, {"type": "subtitle", "time": 19382.798, "timestamp": "05:23:02", "text": "昔のあれ。そして私はそれを学んだ 困難な道。あれはひどかった。"}, {"type": "subtitle", "time": 19391.43, "timestamp": "05:23:11", "text": "それは痛いだろう。ごめんなさい。もしあなたが持っていたら"}, {"type": "subtitle", "time": 19394.23, "timestamp": "05:23:14", "text": "それを乗り越える？ええ、それは"}, {"type": "subtitle", "time": 19396.788, "timestamp": "05:23:16", "text": "は。"}, {"type": "subtitle", "time": 19399.19, "timestamp": "05:23:19", "text": "少なくとも私の場合は、"}, {"type": "subtitle", "time": 19403.43, "timestamp": "05:23:23", "text": "常連視聴者。しかしそれでも、"}, {"type": "subtitle", "time": 19405.11, "timestamp": "05:23:25", "text": "痛いよ。"}, {"type": "subtitle", "time": 19406.43, "timestamp": "05:23:26", "text": "それでも"}, {"type": "subtitle", "time": 19410.15, "timestamp": "05:23:30", "text": "痛い。そして私は、そう、ある意味で"}, {"type": "subtitle", "time": 19412.99, "timestamp": "05:23:32", "text": "その人物は子供だった。 16歳か"}, {"type": "subtitle", "time": 19416.55, "timestamp": "05:23:36", "text": "何か。えーと、UAEに住んでいるとか、"}, {"type": "subtitle", "time": 19418.708, "timestamp": "05:23:38", "text": "何か。わからない。でも、できるよ"}, {"type": "subtitle", "time": 19421.11, "timestamp": "05:23:41", "text": "子供はそういう風になりたがるものだということは理解できる。"}, {"type": "subtitle", "time": 19423.59, "timestamp": "05:23:43", "text": "でも、いつになったら成長するの？"}, {"type": "subtitle", "time": 19425.31, "timestamp": "05:23:45", "text": "上？それが"}, {"type": "subtitle", "time": 19433.51, "timestamp": "05:23:53", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 19436.47, "timestamp": "05:23:56", "text": "子供は子供だから、まあ仕方ないよね。うん。のように"}, {"type": "subtitle", "time": 19439.83, "timestamp": "05:23:59", "text": "そのことが一部の人にとって消えない"}]
[{"type": "subtitle", "time": 4023.829, "timestamp": "01:07:03", "text": "待って。ああ、わかりました。わかった。わかった。それで、"}, {"type": "subtitle", "time": 4026.19, "timestamp": "01:07:06", "text": "テレポートできます。それがシフトシップです"}, {"type": "subtitle", "time": 4029.829, "timestamp": "01:07:09", "text": "は。こんにちは。これで、私はすべてを完了しました"}, {"type": "subtitle", "time": 4033.67, "timestamp": "01:07:13", "text": "このキコの製品。私はただ、"}, {"type": "subtitle", "time": 4036.71, "timestamp": "01:07:16", "text": "良いプレー、あるいは制限なしのプレー。よくやった"}, {"type": "subtitle", "time": 4040.87, "timestamp": "01:07:20", "text": "すべてのものを取り出して、"}, {"type": "subtitle", "time": 4049.63, "timestamp": "01:07:29", "text": "ジャマ。 10分が経過しました。ああ、私は"}, {"type": "subtitle", "time": 4053.349, "timestamp": "01:07:33", "text": "ゲーム。ありがとう。 10分かかりました。"}, {"type": "subtitle", "time": 4054.87, "timestamp": "01:07:34", "text": "何てことだ。"}, {"type": "subtitle", "time": 4057.109, "timestamp": "01:07:37", "text": "ノーボール攻撃は10分かかりました"}, {"type": "subtitle", "time": 4060.87, "timestamp": "01:07:40", "text": "ゲームに参加しよう。おお。"}, {"type": "subtitle", "time": 4063.589, "timestamp": "01:07:43", "text": "VCの使用は支配または攻撃にもなります"}, {"type": "subtitle", "time": 4066.51, "timestamp": "01:07:46", "text": "司令官。私は苦手です"}]
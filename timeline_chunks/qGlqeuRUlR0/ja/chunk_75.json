[{"type": "subtitle", "time": 4507.51, "timestamp": "01:15:07", "text": "[音楽]"}, {"type": "subtitle", "time": 4531.63, "timestamp": "01:15:31", "text": "神。あなたの想像"}, {"type": "subtitle", "time": 4534.51, "timestamp": "01:15:34", "text": "最高。待って。あ、待って。誰がそれを持っていたのか"}, {"type": "subtitle", "time": 4536.27, "timestamp": "01:15:36", "text": "アバター？"}, {"type": "subtitle", "time": 4540.07, "timestamp": "01:15:40", "text": "ああ。何てことだ。むせてしまった。敬う。"}, {"type": "subtitle", "time": 4541.149, "timestamp": "01:15:41", "text": "おお"}, {"type": "subtitle", "time": 4544.79, "timestamp": "01:15:44", "text": "うん。まあ、いいんですけどね。私はしません"}, {"type": "subtitle", "time": 4546.669, "timestamp": "01:15:46", "text": "それが問題ないかどうかを知る。私は違います"}, {"type": "subtitle", "time": 4549.669, "timestamp": "01:15:49", "text": "自信がある。 Hはゲームに参加しました。わかった。私"}, {"type": "subtitle", "time": 4552.87, "timestamp": "01:15:52", "text": "荒らしが必要だ。トロールって何？"}, {"type": "subtitle", "time": 4555.27, "timestamp": "01:15:55", "text": "このゲーム？分かりません。それらはすべて"}, {"type": "subtitle", "time": 4557.27, "timestamp": "01:15:57", "text": "異なる武器。うん。すべてのヒーローは"}, {"type": "subtitle", "time": 4559.35, "timestamp": "01:15:59", "text": "ヴァレラントと同じような別の武器"}]
[{"type": "subtitle", "time": 21062.75, "timestamp": "05:51:02", "text": "何らかの理由で"}, {"type": "subtitle", "time": 21067.91, "timestamp": "05:51:07", "text": "うん、そういうことは時々起こるよね。"}, {"type": "subtitle", "time": 21071.67, "timestamp": "05:51:11", "text": "そしてそれはすごく面白くて、同時に気まずい。"}, {"type": "subtitle", "time": 21078.628, "timestamp": "05:51:18", "text": "うん、きっとこんな感じだったんだろうね"}, {"type": "subtitle", "time": 21080.708, "timestamp": "05:51:20", "text": "彼らにとっても気まずいので、"}, {"type": "subtitle", "time": 21096.19, "timestamp": "05:51:36", "text": "仕事はどうですか"}, {"type": "subtitle", "time": 21098.51, "timestamp": "05:51:38", "text": "された？おお、"}, {"type": "subtitle", "time": 21100.59, "timestamp": "05:51:40", "text": "仕事です"}, {"type": "subtitle", "time": 21102.11, "timestamp": "05:51:42", "text": "1"}, {"type": "subtitle", "time": 21105.27, "timestamp": "05:51:45", "text": "痛いけど、良いことだ。"}, {"type": "subtitle", "time": 21108.47, "timestamp": "05:51:48", "text": "私は幸運にも在宅勤務をしている"}, {"type": "subtitle", "time": 21113.23, "timestamp": "05:51:53", "text": "今のところはそれで良い。"}, {"type": "subtitle", "time": 21116.31, "timestamp": "05:51:56", "text": "ああ、待って、爆弾から作業するので、"}, {"type": "subtitle", "time": 21118.15, "timestamp": "05:51:58", "text": "行かなければならないのですが、パートタイムはどうでしょうか？"}, {"type": "subtitle", "time": 21119.99, "timestamp": "05:51:59", "text": "もの？あ、待って、あなたは会社員なんですね。おお"}]
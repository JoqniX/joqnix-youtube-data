[{"type": "subtitle", "time": 10261.75, "timestamp": "02:51:01", "text": "わかった。何てことだ。それで"}, {"type": "subtitle", "time": 10264.83, "timestamp": "02:51:04", "text": "[音楽]"}, {"type": "subtitle", "time": 10268.63, "timestamp": "02:51:08", "text": "良い。ああ。なぜ私は彼を殴ったのか？そして私はできる"}, {"type": "subtitle", "time": 10274.11, "timestamp": "02:51:14", "text": "見た。"}, {"type": "subtitle", "time": 10286.95, "timestamp": "02:51:26", "text": "勢い。ああ、忘れないで"}, {"type": "subtitle", "time": 10307.349, "timestamp": "02:51:47", "text": "[音楽]"}, {"type": "subtitle", "time": 10317.83, "timestamp": "02:51:57", "text": "リーパー。自分が殺しているのが気に入ってる"}, {"type": "subtitle", "time": 10319.74, "timestamp": "02:51:59", "text": "こういう人たち。"}]
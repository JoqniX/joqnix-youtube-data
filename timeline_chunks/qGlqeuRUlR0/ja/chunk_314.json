[{"type": "subtitle", "time": 18840.75, "timestamp": "05:14:00", "text": "気に入った"}, {"type": "subtitle", "time": 18845.11, "timestamp": "05:14:05", "text": "結局は、あなたが何を好きかということに尽きる"}, {"type": "subtitle", "time": 18848.07, "timestamp": "05:14:08", "text": "やりたいこと、例えばどのように進めるか"}, {"type": "subtitle", "time": 18852.07, "timestamp": "05:14:12", "text": "もの。そして、あまりないと思います"}, {"type": "subtitle", "time": 18855.07, "timestamp": "05:14:15", "text": "たとえ悪いことであっても心配する"}, {"type": "subtitle", "time": 18872.708, "timestamp": "05:14:32", "text": "もの。うん。最も"}, {"type": "subtitle", "time": 18876.39, "timestamp": "05:14:36", "text": "最悪の事態は"}, {"type": "subtitle", "time": 18879.51, "timestamp": "05:14:39", "text": "楽しんでいると、"}, {"type": "subtitle", "time": 18882.39, "timestamp": "05:14:42", "text": "一種の荒らし行為ですね。人々が"}, {"type": "subtitle", "time": 18883.31, "timestamp": "05:14:43", "text": "トロール"}, {"type": "subtitle", "time": 18886.27, "timestamp": "05:14:46", "text": "時々"}, {"type": "subtitle", "time": 18890.83, "timestamp": "05:14:50", "text": "ええと、日本側ですね。"}, {"type": "subtitle", "time": 18895.07, "timestamp": "05:14:55", "text": "ロリオ。うん、本当だね。彼らはそれを"}, {"type": "subtitle", "time": 18898.708, "timestamp": "05:14:58", "text": "「likei」は日本語です。えーっと、"}]
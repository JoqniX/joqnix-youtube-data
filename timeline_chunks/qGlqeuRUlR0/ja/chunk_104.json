[{"type": "subtitle", "time": 6243.669, "timestamp": "01:44:03", "text": "自分。くそ。おお。おお。おお。エイミーは中にいる。"}, {"type": "subtitle", "time": 6246.629, "timestamp": "01:44:06", "text": "わかった。えっと、もう一度行きたいですか、それとも"}, {"type": "subtitle", "time": 6248.59, "timestamp": "01:44:08", "text": "何か別のことをする？私たちは1試合勝ちました。"}, {"type": "subtitle", "time": 6253.31, "timestamp": "01:44:13", "text": "右？本当に？私たちは勝った。それとも"}, {"type": "subtitle", "time": 6256.27, "timestamp": "01:44:16", "text": "私たちは？イベントに向けて頑張っているから、"}, {"type": "subtitle", "time": 6259.629, "timestamp": "01:44:19", "text": "右？イエティを作れます"}, {"type": "subtitle", "time": 6263.55, "timestamp": "01:44:23", "text": "ハンター。好きなようにできますよ。"}, {"type": "subtitle", "time": 6266.03, "timestamp": "01:44:26", "text": "こんにちは。えっと、イエティ"}, {"type": "subtitle", "time": 6269.79, "timestamp": "01:44:29", "text": "ホンダさん、入ってきてください"}, {"type": "subtitle", "time": 6271.87, "timestamp": "01:44:31", "text": "または、あなたが望む"}, {"type": "subtitle", "time": 6275.99, "timestamp": "01:44:35", "text": "に？だから、メイかイエティとして連れて行く必要がある"}, {"type": "subtitle", "time": 6279.79, "timestamp": "01:44:39", "text": "必要なものを手に入れろ。よし、行こう"}, {"type": "subtitle", "time": 6286.03, "timestamp": "01:44:46", "text": "自分。"}, {"type": "subtitle", "time": 6289.31, "timestamp": "01:44:49", "text": "できれば"}]
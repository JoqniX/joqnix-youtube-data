[{"type": "subtitle", "time": 5767.03, "timestamp": "01:36:07", "text": "ちょっと狂気じみてて、埃っぽい？はい。"}, {"type": "subtitle", "time": 5768.629, "timestamp": "01:36:08", "text": "彼はまだプレーしているの？招待するだけです"}, {"type": "subtitle", "time": 5772.95, "timestamp": "01:36:12", "text": "また彼か。彼は参加したいと思っている。ああ、彼は"}, {"type": "subtitle", "time": 5774.27, "timestamp": "01:36:14", "text": "した"}, {"type": "subtitle", "time": 5780.83, "timestamp": "01:36:20", "text": "行く。"}, {"type": "subtitle", "time": 5784.83, "timestamp": "01:36:24", "text": "ええと、もっと農業を"}, {"type": "subtitle", "time": 5800.43, "timestamp": "01:36:40", "text": "ええ、登山も"}, {"type": "subtitle", "time": 5802.669, "timestamp": "01:36:42", "text": "難しい。そこにある"}, {"type": "subtitle", "time": 5808.51, "timestamp": "01:36:48", "text": "は。待って、チームメイトが死ぬのを待って"}]
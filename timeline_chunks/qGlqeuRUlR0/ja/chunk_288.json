[{"type": "subtitle", "time": 17280.59, "timestamp": "04:48:00", "text": "マイクとマイクアーム"}, {"type": "subtitle", "time": 17284.39, "timestamp": "04:48:04", "text": "多分。ああ、もちろんできますよ。うん。"}, {"type": "subtitle", "time": 17286.83, "timestamp": "04:48:06", "text": "うん。そして"}, {"type": "subtitle", "time": 17289.19, "timestamp": "04:48:09", "text": "ああ、そうしようと思ったんだ"}, {"type": "subtitle", "time": 17291.19, "timestamp": "04:48:11", "text": "必需品"}, {"type": "subtitle", "time": 17295.788, "timestamp": "04:48:15", "text": "ああ、どういうわけか、そしてそれがどうなるか見てみましょう"}, {"type": "subtitle", "time": 17298.91, "timestamp": "04:48:18", "text": "行くとか色々あるよ。だから私は"}, {"type": "subtitle", "time": 17302.31, "timestamp": "04:48:22", "text": "MIDIキーボードは必要ないと思う"}, {"type": "subtitle", "time": 17305.47, "timestamp": "04:48:25", "text": "鍵となるもの。うん、必要かもしれない"}, {"type": "subtitle", "time": 17308.47, "timestamp": "04:48:28", "text": "キーボード。待って。えっと、それで、あなたは"}, {"type": "subtitle", "time": 17310.628, "timestamp": "04:48:30", "text": "慣れてくると、もう"}, {"type": "subtitle", "time": 17313.11, "timestamp": "04:48:33", "text": "生ごみ処理システムに慣れた"}, {"type": "subtitle", "time": 17314.708, "timestamp": "04:48:34", "text": "まさにそこです。"}, {"type": "subtitle", "time": 17318.47, "timestamp": "04:48:38", "text": "ええと、まだです。まあ、そうかもしれないけど、まだそこまでではない。もし"}, {"type": "subtitle", "time": 17320.55, "timestamp": "04:48:40", "text": "もしあなたが間違いを犯したら、"}, {"type": "subtitle", "time": 17323.59, "timestamp": "04:48:43", "text": "彼らはあなたを殴ったのですか？彼らはあなたを見つけるでしょうか？"}, {"type": "subtitle", "time": 17328.55, "timestamp": "04:48:48", "text": "いいえ。いいえ、そうは思いません。あぁ、あぁ、もしあなたが"}, {"type": "subtitle", "time": 17331.91, "timestamp": "04:48:51", "text": "彼らは大きな間違いを犯すだろう"}, {"type": "subtitle", "time": 17333.67, "timestamp": "04:48:53", "text": "彼らは去るだろう、彼らは持っていかないだろう"}, {"type": "subtitle", "time": 17336.628, "timestamp": "04:48:56", "text": "ゴミを捨ててステッカーを貼る"}, {"type": "subtitle", "time": 17337.47, "timestamp": "04:48:57", "text": "または"}]
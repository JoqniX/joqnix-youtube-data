[{"type": "subtitle", "time": 4928.02, "timestamp": "01:22:08", "text": "誰かここに来て。ここに来て。ここに来て。"}, {"type": "subtitle", "time": 4935.83, "timestamp": "01:22:15", "text": "ああ、痛み。あなたはゲームに勝ちたいと思っている。"}, {"type": "subtitle", "time": 4939.59, "timestamp": "01:22:19", "text": "それでは始めましょう。何てことだ。私はそうは思わない"}, {"type": "subtitle", "time": 4960.39, "timestamp": "01:22:40", "text": "私はそう信じています。何回必要ですか"}, {"type": "subtitle", "time": 4962.229, "timestamp": "01:22:42", "text": "また背が高くなった？"}, {"type": "subtitle", "time": 4965.31, "timestamp": "01:22:45", "text": "15. 15点満点中0点。なんてことだ。"}, {"type": "subtitle", "time": 4968.229, "timestamp": "01:22:48", "text": "ニース。お願いします。私はただ待って、"}, {"type": "subtitle", "time": 4970.629, "timestamp": "01:22:50", "text": "こっちと同じように、ひたすら待つだけです。病気"}]
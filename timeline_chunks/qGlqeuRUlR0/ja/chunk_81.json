[{"type": "subtitle", "time": 4865.83, "timestamp": "01:21:05", "text": "誰も私にチャンスを与えてくれなかった。誰か"}, {"type": "subtitle", "time": 4872.31, "timestamp": "01:21:12", "text": "なぜ。ああ、キャラクターは持ち去ることはできません"}, {"type": "subtitle", "time": 4878.55, "timestamp": "01:21:18", "text": "ああ、そういうことか。わかりました、料金をいただきます"}, {"type": "subtitle", "time": 4881.43, "timestamp": "01:21:21", "text": "それから。新しいイベント。はい、新しい"}, {"type": "subtitle", "time": 4896.43, "timestamp": "01:21:36", "text": "皆さん、私を着陸させていただけますか？"}, {"type": "subtitle", "time": 4898.43, "timestamp": "01:21:38", "text": "として"}, {"type": "subtitle", "time": 4905.709, "timestamp": "01:21:45", "text": "私は手に入れたい"}, {"type": "subtitle", "time": 4910.31, "timestamp": "01:21:50", "text": "けれど。トッドを呼んでください。"}, {"type": "subtitle", "time": 4917.229, "timestamp": "01:21:57", "text": "トッド。"}]
[{"type": "subtitle", "time": 8640.83, "timestamp": "02:24:00", "text": "私は永遠に"}, {"type": "subtitle", "time": 8644.55, "timestamp": "02:24:04", "text": "ここ。でも、心配しないでください。ああ、心配しないでください。"}, {"type": "subtitle", "time": 8649.11, "timestamp": "02:24:09", "text": "ところで、えーと、私はこれを、えーと、"}, {"type": "subtitle", "time": 8651.27, "timestamp": "02:24:11", "text": "毎日 毎日 毎日 毎日 毎日 毎日"}, {"type": "subtitle", "time": 8653.59, "timestamp": "02:24:13", "text": "あれ。いいえ。こんにちは。こんにちは、みんな。ようこそ"}, {"type": "subtitle", "time": 8656.469, "timestamp": "02:24:16", "text": "小川。こんにちは。こんにちは。私はそれをしません。"}, {"type": "subtitle", "time": 8660.469, "timestamp": "02:24:20", "text": "1週間は24時間365日の配信はしません。私"}, {"type": "subtitle", "time": 8662.65, "timestamp": "02:24:22", "text": "やりたいけど、"}, {"type": "subtitle", "time": 8665.71, "timestamp": "02:24:25", "text": "[音楽]"}, {"type": "subtitle", "time": 8669.03, "timestamp": "02:24:29", "text": "できる。待って。 14日は授業がオフラインです"}, {"type": "subtitle", "time": 8671.429, "timestamp": "02:24:31", "text": "クラス。皆さんはご覧になりますか？"}, {"type": "subtitle", "time": 8673.67, "timestamp": "02:24:33", "text": "君たちは年配の人たちを辛抱強く見守っている"}, {"type": "subtitle", "time": 8677.07, "timestamp": "02:24:37", "text": "私が戻ってくるまで、ジョックが配信します"}, {"type": "subtitle", "time": 8680.59, "timestamp": "02:24:40", "text": "授業を始めましょうか、それとも私が始めたいですか？"}, {"type": "subtitle", "time": 8685.23, "timestamp": "02:24:45", "text": "私が戻ってきた後の流れ"}, {"type": "subtitle", "time": 8688.99, "timestamp": "02:24:48", "text": "タイプ？私はそれを動かし続けることができます"}, {"type": "subtitle", "time": 8693.59, "timestamp": "02:24:53", "text": "知る。ええ、稼働させ続けることができます。"}, {"type": "subtitle", "time": 8696.03, "timestamp": "02:24:56", "text": "ああ、だって午前9時だから"}, {"type": "subtitle", "time": 8699.03, "timestamp": "02:24:59", "text": "午前9時に開始し、夜には"}]
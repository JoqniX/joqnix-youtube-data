[{"type": "subtitle", "time": 5473.03, "timestamp": "01:31:13", "text": "わかった。背の高いものを手に入れよう。"}, {"type": "subtitle", "time": 5475.43, "timestamp": "01:31:15", "text": "少なくとも、私はあなたに許します 少なくとも、私は許します"}, {"type": "subtitle", "time": 5488.75, "timestamp": "01:31:28", "text": "私はHP1です。おお。"}, {"type": "subtitle", "time": 5495.44, "timestamp": "01:31:35", "text": "私は死んだ。"}, {"type": "subtitle", "time": 5497.27, "timestamp": "01:31:37", "text": "[音楽]"}, {"type": "subtitle", "time": 5499.83, "timestamp": "01:31:39", "text": "ああ、一つしかないよ。"}, {"type": "subtitle", "time": 5503.43, "timestamp": "01:31:43", "text": "うん、これはうん。うん。この剣"}, {"type": "subtitle", "time": 5507.189, "timestamp": "01:31:47", "text": "あいつはタフだ。彼らはそうしないだろう。よし、やろう"}, {"type": "subtitle", "time": 5509.39, "timestamp": "01:31:49", "text": "大きなものをいくつか取ってみよう"}, {"type": "subtitle", "time": 5512.229, "timestamp": "01:31:52", "text": "男の子。大きな男の子を連れて行ってください。私は"}, {"type": "subtitle", "time": 5514.79, "timestamp": "01:31:54", "text": "鋼球。"}]
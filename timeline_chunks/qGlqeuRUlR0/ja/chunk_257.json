[{"type": "subtitle", "time": 15421.11, "timestamp": "04:17:01", "text": "建物のせいか、"}, {"type": "subtitle", "time": 15424.389, "timestamp": "04:17:04", "text": "オーナーが許可しないか、あなたも住んでいます"}, {"type": "subtitle", "time": 15427.75, "timestamp": "04:17:07", "text": "高いところにいるから、直接走ることはできない"}, {"type": "subtitle", "time": 15429.63, "timestamp": "04:17:09", "text": "ケーブルをあなたの"}, {"type": "subtitle", "time": 15431.91, "timestamp": "04:17:11", "text": "アパートに住んでいる場合を除いて、1階に住んでいる場合は"}, {"type": "subtitle", "time": 15434.55, "timestamp": "04:17:14", "text": "床か何か。"}, {"type": "subtitle", "time": 15437.11, "timestamp": "04:17:17", "text": "おお。"}, {"type": "subtitle", "time": 15440.63, "timestamp": "04:17:20", "text": "でも、大抵は大丈夫でしょう。私"}, {"type": "subtitle", "time": 15443.349, "timestamp": "04:17:23", "text": "そう願っています。それは私が見たものです 私はあなたを送ったのですか"}, {"type": "subtitle", "time": 15450.59, "timestamp": "04:17:30", "text": "えっと、私の荷物を受け取って？えっと、ちょっと待ってください。"}, {"type": "subtitle", "time": 15455.389, "timestamp": "04:17:35", "text": "JP。私の家はこんな感じになります"}, {"type": "subtitle", "time": 15464.07, "timestamp": "04:17:44", "text": "2番。はい、これはコピーできます。"}, {"type": "subtitle", "time": 15465.83, "timestamp": "04:17:45", "text": "わかりました、写真を送ります。えっと、"}, {"type": "subtitle", "time": 15468.189, "timestamp": "04:17:48", "text": "だから簡単にチェックできます"}, {"type": "subtitle", "time": 15471.04, "timestamp": "04:17:51", "text": "電話。よし。えっと、"}, {"type": "subtitle", "time": 15473.59, "timestamp": "04:17:53", "text": "[音楽]"}, {"type": "subtitle", "time": 15476.11, "timestamp": "04:17:56", "text": "えっと、コピー"}, {"type": "subtitle", "time": 15478.429, "timestamp": "04:17:58", "text": "そして"}]
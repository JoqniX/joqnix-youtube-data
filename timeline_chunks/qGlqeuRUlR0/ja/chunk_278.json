[{"type": "subtitle", "time": 16682.47, "timestamp": "04:38:02", "text": "保険やスタンプなど"}, {"type": "subtitle", "time": 16684.31, "timestamp": "04:38:04", "text": "出国前にパスポート"}, {"type": "subtitle", "time": 16686.949, "timestamp": "04:38:06", "text": "仕事のために。"}, {"type": "subtitle", "time": 16689.91, "timestamp": "04:38:09", "text": "つまり、それは追加の要件であり、"}, {"type": "subtitle", "time": 16694.39, "timestamp": "04:38:14", "text": "公には知られていないか、"}, {"type": "subtitle", "time": 16697.31, "timestamp": "04:38:17", "text": "周囲の人々には知られていない"}, {"type": "subtitle", "time": 16701.67, "timestamp": "04:38:21", "text": "自分。そう、それは一種のニュースだった"}, {"type": "subtitle", "time": 16707.109, "timestamp": "04:38:27", "text": "私にとっては、まるで聞いたこともない話のようだった。それで"}, {"type": "subtitle", "time": 16711.19, "timestamp": "04:38:31", "text": "うん、あれは大変だったね。 Mとは"}, {"type": "subtitle", "time": 16712.67, "timestamp": "04:38:32", "text": "[音楽]"}, {"type": "subtitle", "time": 16716.47, "timestamp": "04:38:36", "text": "大丈夫。それから、銀行はどうですか？"}, {"type": "subtitle", "time": 16720.269, "timestamp": "04:38:40", "text": "もの？銀行口座は開設しましたか？"}, {"type": "subtitle", "time": 16724.029, "timestamp": "04:38:44", "text": "ああ、銀行口座。"}, {"type": "subtitle", "time": 16729.189, "timestamp": "04:38:49", "text": "いや、違うよ。うん。私は持っていきませんでした"}, {"type": "subtitle", "time": 16732.91, "timestamp": "04:38:52", "text": "私のデビットカードのようなカードも持ち歩いています"}, {"type": "subtitle", "time": 16736.629, "timestamp": "04:38:56", "text": "そして私は新しい銀行口座を開設しました"}, {"type": "subtitle", "time": 16739.99, "timestamp": "04:38:59", "text": "ここにあるような郵便局。えっと、それであなたは"}]
[{"type": "subtitle", "time": 20640.708, "timestamp": "05:44:00", "text": "最初のステップをクリアしました。ニース。"}, {"type": "subtitle", "time": 20643.91, "timestamp": "05:44:03", "text": "ええ、あなたの広告を見ました"}, {"type": "subtitle", "time": 20647.75, "timestamp": "05:44:07", "text": "ストリーム。あなたは私のYouTubeチャンネルに広告を掲載しましたね。"}, {"type": "subtitle", "time": 20650.39, "timestamp": "05:44:10", "text": "何てことだ。何？"}, {"type": "subtitle", "time": 20654.15, "timestamp": "05:44:14", "text": "うん。おお、"}, {"type": "subtitle", "time": 20656.628, "timestamp": "05:44:16", "text": "ストリームを再生しているとき"}, {"type": "subtitle", "time": 20660.708, "timestamp": "05:44:20", "text": "背景と広告がしばらくすると表示されます"}, {"type": "subtitle", "time": 20664.868, "timestamp": "05:44:24", "text": "時間。うん。待って、それは頻繁に起こるの？"}, {"type": "subtitle", "time": 20667.51, "timestamp": "05:44:27", "text": "頻繁に、それともTwitchのように毎回"}, {"type": "subtitle", "time": 20669.67, "timestamp": "05:44:29", "text": "10分ごと、または5分ごとに"}, {"type": "subtitle", "time": 20671.75, "timestamp": "05:44:31", "text": "広告再生中"}, {"type": "subtitle", "time": 20674.788, "timestamp": "05:44:34", "text": "ほとんど見られないほどひどいものになっているのか？"}, {"type": "subtitle", "time": 20677.75, "timestamp": "05:44:37", "text": "ほとんど見ていない。ええ、そうじゃないんです"}, {"type": "subtitle", "time": 20681.35, "timestamp": "05:44:41", "text": "そんなに頻繁ではない"}, {"type": "subtitle", "time": 20683.43, "timestamp": "05:44:43", "text": "ストリームをそのまま見ることができます"}, {"type": "subtitle", "time": 20690.07, "timestamp": "05:44:50", "text": "ストリームをバックグラウンドで再生していて、"}, {"type": "subtitle", "time": 20691.99, "timestamp": "05:44:51", "text": "この広告は一度も見たことがない。それは"}, {"type": "subtitle", "time": 20695.47, "timestamp": "05:44:55", "text": "広告ブロッカーを使っているから？"}, {"type": "subtitle", "time": 20699.11, "timestamp": "05:44:59", "text": "うん、それでいいだろう。"}]
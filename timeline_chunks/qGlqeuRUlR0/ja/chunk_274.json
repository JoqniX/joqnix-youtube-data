[{"type": "subtitle", "time": 16443.07, "timestamp": "04:34:03", "text": "ほとんどの場合、そうでない場合は"}, {"type": "subtitle", "time": 16446.709, "timestamp": "04:34:06", "text": "可燃性で、また、そうでない場合は"}, {"type": "subtitle", "time": 16450.789, "timestamp": "04:34:10", "text": "生鮮食品なら許可されていると思います。"}, {"type": "subtitle", "time": 16454.47, "timestamp": "04:34:14", "text": "私はそれについてあまりよく知らないのですが、"}, {"type": "subtitle", "time": 16458.869, "timestamp": "04:34:18", "text": "彼らは私に対して何の問題も感じていなかった。だから、私はただ"}, {"type": "subtitle", "time": 16461.109, "timestamp": "04:34:21", "text": "スパイスとスナックを持ってきて"}, {"type": "subtitle", "time": 16465.189, "timestamp": "04:34:25", "text": "服と枕も持ってきました"}, {"type": "subtitle", "time": 16467.269, "timestamp": "04:34:27", "text": "自宅から。"}, {"type": "subtitle", "time": 16469.67, "timestamp": "04:34:29", "text": "靴とかはどうですか？何個"}, {"type": "subtitle", "time": 16471.99, "timestamp": "04:34:31", "text": "何個持ち帰りましたか？"}, {"type": "subtitle", "time": 16474.67, "timestamp": "04:34:34", "text": "靴。私"}, {"type": "subtitle", "time": 16478.99, "timestamp": "04:34:38", "text": "1、2、"}, {"type": "subtitle", "time": 16482.07, "timestamp": "04:34:42", "text": "３、２。そうそう。 2組。私は思う"}, {"type": "subtitle", "time": 16486.551, "timestamp": "04:34:46", "text": "靴を2、3足。"}, {"type": "subtitle", "time": 16488.39, "timestamp": "04:34:48", "text": "それから服については、"}, {"type": "subtitle", "time": 16490.551, "timestamp": "04:34:50", "text": "真空シーラー？"}, {"type": "subtitle", "time": 16494.629, "timestamp": "04:34:54", "text": "いえ、違います。私はただ、混雑しているのが好きなだけです"}, {"type": "subtitle", "time": 16497.109, "timestamp": "04:34:57", "text": "それらはとてもきつい"}]
[{"type": "subtitle", "time": 7803.03, "timestamp": "02:10:03", "text": "難しい。では、この私はどうでしょうか？ただ与えるだけ"}, {"type": "subtitle", "time": 7815.589, "timestamp": "02:10:15", "text": "今日。また明日も"}, {"type": "subtitle", "time": 7817.91, "timestamp": "02:10:17", "text": "私たちは遊ぶつもりです。私はそう思います"}, {"type": "subtitle", "time": 7819.229, "timestamp": "02:10:19", "text": "満杯"}, {"type": "subtitle", "time": 7820.75, "timestamp": "02:10:20", "text": "みんな。"}, {"type": "subtitle", "time": 7823.35, "timestamp": "02:10:23", "text": "うん、明日はフルでプレーするよ"}, {"type": "subtitle", "time": 7825.83, "timestamp": "02:10:25", "text": "みんな。だから、もしあなたが保持したいなら"}, {"type": "subtitle", "time": 7834.629, "timestamp": "02:10:34", "text": "わかった。うまくいったってことだよね。ああ、私は"}, {"type": "subtitle", "time": 7837.27, "timestamp": "02:10:37", "text": "わからない。ああ、デートはどうだった？私"}, {"type": "subtitle", "time": 7840.43, "timestamp": "02:10:40", "text": "それを忘れてた。ええ、"}]
[{"type": "subtitle", "time": 1567.549, "timestamp": "00:26:07", "text": "上。"}, {"type": "subtitle", "time": 1572.149, "timestamp": "00:26:12", "text": "あぁ、まさに私の顔面に。"}, {"type": "subtitle", "time": 1574.71, "timestamp": "00:26:14", "text": "ジョック。 Gのデート日程が分かりました。これをマークしてください"}, {"type": "subtitle", "time": 1578.789, "timestamp": "00:26:18", "text": "毎日殺すため。何てことだ。"}, {"type": "subtitle", "time": 1581.59, "timestamp": "00:26:21", "text": "うん。さよなら。"}, {"type": "subtitle", "time": 1584.75, "timestamp": "00:26:24", "text": "ああ、1月まではね。ああ、"}, {"type": "subtitle", "time": 1590.83, "timestamp": "00:26:30", "text": "神。来る"}, {"type": "subtitle", "time": 1594.95, "timestamp": "00:26:34", "text": "の上。心配しないで。君ならできるよ。つまり、"}, {"type": "subtitle", "time": 1597.87, "timestamp": "00:26:37", "text": "とにかく最善を尽くしてください。落ち着きなさい。"}]
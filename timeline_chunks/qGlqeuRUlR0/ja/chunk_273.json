[{"type": "subtitle", "time": 16381.349, "timestamp": "04:33:01", "text": "そうすれば全てが悪くなり、"}, {"type": "subtitle", "time": 16391.189, "timestamp": "04:33:11", "text": "荷造りの内容によりますね。何"}, {"type": "subtitle", "time": 16393.109, "timestamp": "04:33:13", "text": "荷物と"}, {"type": "subtitle", "time": 16395.67, "timestamp": "04:33:15", "text": "もの？"}, {"type": "subtitle", "time": 16399.67, "timestamp": "04:33:19", "text": "ああ、東京みたいにね。うん。えーと、"}, {"type": "subtitle", "time": 16403.429, "timestamp": "04:33:23", "text": "日本へ帰る。 B ええと、最初の"}, {"type": "subtitle", "time": 16405.67, "timestamp": "04:33:25", "text": "もの。"}, {"type": "subtitle", "time": 16408.709, "timestamp": "04:33:28", "text": "ええ、私は"}, {"type": "subtitle", "time": 16410.99, "timestamp": "04:33:30", "text": "えっと、ただ"}, {"type": "subtitle", "time": 16415.59, "timestamp": "04:33:35", "text": "調理器具などを持ってきました。"}, {"type": "subtitle", "time": 16420.949, "timestamp": "04:33:40", "text": "主にスパイスといくつかの"}, {"type": "subtitle", "time": 16423.83, "timestamp": "04:33:43", "text": "許可された。それでよかった。プロセスと同様"}, {"type": "subtitle", "time": 16427.99, "timestamp": "04:33:47", "text": "生食には含まれていないんですよね？"}, {"type": "subtitle", "time": 16432.07, "timestamp": "04:33:52", "text": "うん。えっと、スパイスは大丈夫だと思います。"}, {"type": "subtitle", "time": 16435.269, "timestamp": "04:33:55", "text": "彼らはあらゆるスパイスを許可し、"}, {"type": "subtitle", "time": 16437.91, "timestamp": "04:33:57", "text": "豆やニンニクパウダーなど"}, {"type": "subtitle", "time": 16439.91, "timestamp": "04:33:59", "text": "何か"}]
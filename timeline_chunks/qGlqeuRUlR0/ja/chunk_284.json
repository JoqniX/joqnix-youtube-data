[{"type": "subtitle", "time": 17040.39, "timestamp": "04:44:00", "text": "充電しなければならないもの"}, {"type": "subtitle", "time": 17044.23, "timestamp": "04:44:04", "text": "インターネットはただのインターネットだ。だから話すんだ"}, {"type": "subtitle", "time": 17048.59, "timestamp": "04:44:08", "text": "ほとんどの場合、支払う必要があるように"}, {"type": "subtitle", "time": 17051.75, "timestamp": "04:44:11", "text": "毎月。前払いだと思います。"}, {"type": "subtitle", "time": 17055.19, "timestamp": "04:44:15", "text": "おお。だから数ヶ月後には、状況に応じて"}, {"type": "subtitle", "time": 17058.47, "timestamp": "04:44:18", "text": "お支払い方法に応じて、"}, {"type": "subtitle", "time": 17061.03, "timestamp": "04:44:21", "text": "請求書を受け取り、以下のいずれかの方法で支払う必要があります。"}, {"type": "subtitle", "time": 17064.31, "timestamp": "04:44:24", "text": "コンビニエンスストア、またはあなたが好きなのは"}, {"type": "subtitle", "time": 17068.11, "timestamp": "04:44:28", "text": "クレジットカードまたはデビットカードから差し引かれます"}, {"type": "subtitle", "time": 17072.15, "timestamp": "04:44:32", "text": "カード。だから、チャージする必要はありません"}, {"type": "subtitle", "time": 17074.39, "timestamp": "04:44:34", "text": "まるで直ったみたい"}, {"type": "subtitle", "time": 17076.22, "timestamp": "04:44:36", "text": "固定プラン。"}, {"type": "subtitle", "time": 17083.83, "timestamp": "04:44:43", "text": "だから、えっと、両親に"}, {"type": "subtitle", "time": 17085.91, "timestamp": "04:44:45", "text": "荷造りをするのは、"}, {"type": "subtitle", "time": 17088.23, "timestamp": "04:44:48", "text": "何も知らない。私はただここで集中している"}, {"type": "subtitle", "time": 17091.19, "timestamp": "04:44:51", "text": "今の私のマラソン大会。しかし"}, {"type": "subtitle", "time": 17094.47, "timestamp": "04:44:54", "text": "そう、私が欲しかったもの"}, {"type": "subtitle", "time": 17098.11, "timestamp": "04:44:58", "text": "テイクは「えっと、どう言えばいいかな？」って感じだった。"}]
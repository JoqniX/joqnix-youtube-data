[{"type": "subtitle", "time": 12972.71, "timestamp": "03:36:12", "text": "待って、私が彼を殺した、ああ、なんてことだ。なぜ？"}, {"type": "subtitle", "time": 12976.229, "timestamp": "03:36:16", "text": "あなたはどこから出現しましたか？どこで"}, {"type": "subtitle", "time": 12978.71, "timestamp": "03:36:18", "text": "ディオから生まれたのか？どこで手に入れたの？"}, {"type": "subtitle", "time": 12985.67, "timestamp": "03:36:25", "text": "走る。わかった、わかった、わかった、スピードランしよう"}, {"type": "subtitle", "time": 13016.11, "timestamp": "03:36:56", "text": "戦闘用ショットガンは"}, {"type": "subtitle", "time": 13019.349, "timestamp": "03:36:59", "text": "OPのこと。すべて、すべて、唯一の"}]
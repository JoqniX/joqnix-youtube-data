[{"type": "subtitle", "time": 2341.15, "timestamp": "00:39:01", "text": "えーと"}, {"type": "subtitle", "time": 2346.15, "timestamp": "00:39:06", "text": "4 5 ビット。だから私は3つ目の曲がりが必要なのです"}, {"type": "subtitle", "time": 2347.99, "timestamp": "00:39:07", "text": "ストローアニメーションと迷路ノーマル"}, {"type": "subtitle", "time": 2350.39, "timestamp": "00:39:10", "text": "これを手に入れるためには攻撃的な手段も必要だ。わかりました、"}, {"type": "subtitle", "time": 2352.43, "timestamp": "00:39:12", "text": "さあ行こう"}, {"type": "subtitle", "time": 2355.03, "timestamp": "00:39:15", "text": "また。ノーボール。私たちはじっとしていなければならない"}, {"type": "subtitle", "time": 2357.069, "timestamp": "00:39:17", "text": "ブロックし続ける"}, {"type": "subtitle", "time": 2359.589, "timestamp": "00:39:19", "text": "ボール。そう、これが私が配信している"}, {"type": "subtitle", "time": 2361.829, "timestamp": "00:39:21", "text": "スキンを手に入れるためにイベントに参加するだけ"}, {"type": "subtitle", "time": 2363.19, "timestamp": "00:39:23", "text": "そして、スプレーと"}, {"type": "subtitle", "time": 2364.87, "timestamp": "00:39:24", "text": "すべて。それは素晴らしいですね。私は決して"}, {"type": "subtitle", "time": 2367.51, "timestamp": "00:39:27", "text": "以前にもこんなことしたことがあっただろうか。そうだなと思った。"}, {"type": "subtitle", "time": 2369.71, "timestamp": "00:39:29", "text": "そうしても構いません。"}, {"type": "subtitle", "time": 2373.23, "timestamp": "00:39:33", "text": "右？私たちは"}, {"type": "subtitle", "time": 2376.349, "timestamp": "00:39:36", "text": "イエティかな。私はしません"}, {"type": "subtitle", "time": 2380.069, "timestamp": "00:39:40", "text": "知る。私にとって残された英雄はほんのわずかだ"}, {"type": "subtitle", "time": 2380.91, "timestamp": "00:39:40", "text": "に"}, {"type": "subtitle", "time": 2390.55, "timestamp": "00:39:50", "text": "えっと、それが届いたら、ああ、"}]
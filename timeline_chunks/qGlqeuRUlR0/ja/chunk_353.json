[{"type": "subtitle", "time": 21189.43, "timestamp": "05:53:09", "text": "昨晩作ったチャーハン。揚げ物"}, {"type": "subtitle", "time": 21191.03, "timestamp": "05:53:11", "text": "米。"}, {"type": "subtitle", "time": 21193.67, "timestamp": "05:53:13", "text": "ええ、昨晩チャーハンを作りました。"}, {"type": "subtitle", "time": 21203.27, "timestamp": "05:53:23", "text": "だから、私は学ぶ必要がある。待って、あなたは"}, {"type": "subtitle", "time": 21206.39, "timestamp": "05:53:26", "text": "調理器具も一緒に手に入れる？調理器具を持参してください"}, {"type": "subtitle", "time": 21207.91, "timestamp": "05:53:27", "text": "そこには。"}, {"type": "subtitle", "time": 21211.11, "timestamp": "05:53:31", "text": "それは日本では買えないということです。"}, {"type": "subtitle", "time": 21215.91, "timestamp": "05:53:35", "text": "ああ、いや、いや。私は友達に"}, {"type": "subtitle", "time": 21221.35, "timestamp": "05:53:41", "text": "えっと、職場の友達が3人いるんだけど"}, {"type": "subtitle", "time": 21223.91, "timestamp": "05:53:43", "text": "人々はインド出身で、"}, {"type": "subtitle", "time": 21226.43, "timestamp": "05:53:46", "text": "独自の圧力鍋"}, {"type": "subtitle", "time": 21231.11, "timestamp": "05:53:51", "text": "家。ああ、そういうこともあるんですね。でもあなたは"}, {"type": "subtitle", "time": 21234.23, "timestamp": "05:53:54", "text": "リーズナブルな価格で炊飯器を購入する"}, {"type": "subtitle", "time": 21237.03, "timestamp": "05:53:57", "text": "価格はこちら。だから私はそうは思わない"}]
[{"type": "subtitle", "time": 15481.75, "timestamp": "04:18:01", "text": "ペースト。これは私の これは私の"}, {"type": "subtitle", "time": 15484.99, "timestamp": "04:18:04", "text": "学校に関する部分。ええと、ドメトリー"}, {"type": "subtitle", "time": 15488.51, "timestamp": "04:18:08", "text": "あれ。どう思いますか？"}, {"type": "subtitle", "time": 15490.51, "timestamp": "04:18:10", "text": "おお。"}, {"type": "subtitle", "time": 15495.67, "timestamp": "04:18:15", "text": "おお、いいね。それはそうでしょうか、そうでしょうか、そうではないでしょうか"}, {"type": "subtitle", "time": 15497.389, "timestamp": "04:18:17", "text": "小さくて"}, {"type": "subtitle", "time": 15500.55, "timestamp": "04:18:20", "text": "もの？分かりません。あなたがすべき"}, {"type": "subtitle", "time": 15503.59, "timestamp": "04:18:23", "text": "私の部屋を見たことがある。待って、あなたの"}, {"type": "subtitle", "time": 15506.189, "timestamp": "04:18:26", "text": "部屋？それはあまりにも"}, {"type": "subtitle", "time": 15509.59, "timestamp": "04:18:29", "text": "小さい？今の私のアパートみたいに"}, {"type": "subtitle", "time": 15511.91, "timestamp": "04:18:31", "text": "いいんだけど、私は以前シェアハウスに住んでいた"}, {"type": "subtitle", "time": 15515.189, "timestamp": "04:18:35", "text": "家のような、一種の寮。"}, {"type": "subtitle", "time": 15518.309, "timestamp": "04:18:38", "text": "待って、もし私が写真を持っていると思うなら"}, {"type": "subtitle", "time": 15521.67, "timestamp": "04:18:41", "text": "送りますよ。"}, {"type": "subtitle", "time": 15524.07, "timestamp": "04:18:44", "text": "きっと驚くでしょう。私は"}, {"type": "subtitle", "time": 15527.189, "timestamp": "04:18:47", "text": "それは東京にあるということですか？"}, {"type": "subtitle", "time": 15528.67, "timestamp": "04:18:48", "text": "それは東京にあります。"}, {"type": "subtitle", "time": 15531.67, "timestamp": "04:18:51", "text": "わかった。なぜか分からないけど、"}, {"type": "subtitle", "time": 15533.91, "timestamp": "04:18:53", "text": "東京のアパートやシェアハウスについて考えてみましょう"}, {"type": "subtitle", "time": 15535.51, "timestamp": "04:18:55", "text": "家々、とても"}, {"type": "subtitle", "time": 15537.51, "timestamp": "04:18:57", "text": "小さいとか何かだから"}]
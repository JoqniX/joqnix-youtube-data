[{"type": "subtitle", "time": 17761.99, "timestamp": "04:56:01", "text": "とても良いものですね。うん。しかし、"}, {"type": "subtitle", "time": 17763.67, "timestamp": "04:56:03", "text": "パワーのこと。そうそう。では"}, {"type": "subtitle", "time": 17766.15, "timestamp": "04:56:06", "text": "延長ケーブル？拡張機能を使用できますか？"}, {"type": "subtitle", "time": 17769.75, "timestamp": "04:56:09", "text": "コードと延長コード？まあ、そういうことです。"}, {"type": "subtitle", "time": 17772.15, "timestamp": "04:56:12", "text": "あの箱、知ってますよね？プラグを差し込む"}, {"type": "subtitle", "time": 17774.39, "timestamp": "04:56:14", "text": "それを差し込むと、プラグを差し込むための追加のスロットがあります"}, {"type": "subtitle", "time": 17779.03, "timestamp": "04:56:19", "text": "もの。ええ、持っていますよ。ああ。ええと、できます"}, {"type": "subtitle", "time": 17780.27, "timestamp": "04:56:20", "text": "それらを購入してください"}, {"type": "subtitle", "time": 17783.59, "timestamp": "04:56:23", "text": "どこでもドンキー・コートのように考える"}, {"type": "subtitle", "time": 17784.99, "timestamp": "04:56:24", "text": "または"}, {"type": "subtitle", "time": 17788.47, "timestamp": "04:56:28", "text": "オンラインでは、例えばAmazonで購入できます"}, {"type": "subtitle", "time": 17793.03, "timestamp": "04:56:33", "text": "約1,500円"}, {"type": "subtitle", "time": 17794.43, "timestamp": "04:56:34", "text": "貨物輸送"}, {"type": "subtitle", "time": 17798.31, "timestamp": "04:56:38", "text": "あらゆるものをストリップしてケーブル化する。"}, {"type": "subtitle", "time": 17801.11, "timestamp": "04:56:41", "text": "うん。それで、日本に到着したとき、"}, {"type": "subtitle", "time": 17803.27, "timestamp": "04:56:43", "text": "お金はいくら持っていきましたか"}, {"type": "subtitle", "time": 17809.708, "timestamp": "04:56:49", "text": "えっと、私は"}]
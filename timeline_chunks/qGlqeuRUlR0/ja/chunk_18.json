[{"type": "subtitle", "time": 1080.71, "timestamp": "00:18:00", "text": "待って、雪玉を6個キャッチして。何が"}, {"type": "subtitle", "time": 1089.11, "timestamp": "00:18:09", "text": "ええと、カスタムゲームでは完了できません。"}, {"type": "subtitle", "time": 1091.47, "timestamp": "00:18:11", "text": "だから、練習内容は「こんにちは」と言うことだった。"}, {"type": "subtitle", "time": 1095.23, "timestamp": "00:18:15", "text": "わかった。えっと、待って。"}, {"type": "subtitle", "time": 1100.029, "timestamp": "00:18:20", "text": "えっと、スノーボールでゲームに勝つ。わかった。待って。"}, {"type": "subtitle", "time": 1103.99, "timestamp": "00:18:23", "text": "いいえ。ええと、これに集中しましょう。ブロック"}, {"type": "subtitle", "time": 1109.83, "timestamp": "00:18:29", "text": "雪玉を冷凍庫または氷でブロックする"}, {"type": "subtitle", "time": 1112.39, "timestamp": "00:18:32", "text": "一致するか、またはかもしれない雪玉の壁"}, {"type": "subtitle", "time": 1114.909, "timestamp": "00:18:34", "text": "スノーボール"}, {"type": "subtitle", "time": 1119.19, "timestamp": "00:18:39", "text": "攻撃。猫が雪玉を6個捕まえる"}, {"type": "subtitle", "time": 1121.789, "timestamp": "00:18:41", "text": "そしてそれを雪だるま式に増やす"}, {"type": "subtitle", "time": 1135.75, "timestamp": "00:18:55", "text": "攻撃。ああ、わかりました。 1つで行こう"}]
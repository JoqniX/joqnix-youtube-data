[{"type": "subtitle", "time": 6900.83, "timestamp": "01:55:00", "text": "その間。お元気でお過ごしでしょうか。お母さん、"}, {"type": "subtitle", "time": 6903.31, "timestamp": "01:55:03", "text": "もっと。"}, {"type": "subtitle", "time": 6907.91, "timestamp": "01:55:07", "text": "うん。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 6909.149, "timestamp": "01:55:09", "text": "どうでしたか？"}, {"type": "subtitle", "time": 6911.99, "timestamp": "01:55:11", "text": "日？待って、君にとっては朝じゃないの？"}, {"type": "subtitle", "time": 6919.63, "timestamp": "01:55:19", "text": "右？おお、"}, {"type": "subtitle", "time": 6930.95, "timestamp": "01:55:30", "text": "[音楽]"}, {"type": "subtitle", "time": 6948.229, "timestamp": "01:55:48", "text": "ゲームのプレイのイエティは"}, {"type": "subtitle", "time": 6950.07, "timestamp": "01:55:50", "text": "純粋に私がスナック菓子を全部食べているところ"}]
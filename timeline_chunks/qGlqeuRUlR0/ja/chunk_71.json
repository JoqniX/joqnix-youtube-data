[{"type": "subtitle", "time": 4262.91, "timestamp": "01:11:02", "text": "[音楽]"}, {"type": "subtitle", "time": 4275.85, "timestamp": "01:11:15", "text": "神。ああ、"}, {"type": "subtitle", "time": 4278.75, "timestamp": "01:11:18", "text": "[音楽]"}, {"type": "subtitle", "time": 4287.03, "timestamp": "01:11:27", "text": "あまりにも。はい、あなたはヘッドパッチを装着することになります。"}, {"type": "subtitle", "time": 4295.91, "timestamp": "01:11:35", "text": "そう、正しく話せば、"}, {"type": "subtitle", "time": 4302.39, "timestamp": "01:11:42", "text": "アニメーションが少し遅いか、"}, {"type": "subtitle", "time": 4304.229, "timestamp": "01:11:44", "text": "何か。なぜか分からないけど、"}, {"type": "subtitle", "time": 4306.11, "timestamp": "01:11:46", "text": "凍えるような"}]
[{"type": "subtitle", "time": 18661.75, "timestamp": "05:11:01", "text": "あなたは彼らと話していませんし、"}, {"type": "subtitle", "time": 18663.67, "timestamp": "05:11:03", "text": "友達解除とか、そういう類のこと"}, {"type": "subtitle", "time": 18672.55, "timestamp": "05:11:12", "text": "それはあなたの競争的な側面ですか"}, {"type": "subtitle", "time": 18674.948, "timestamp": "05:11:14", "text": "視聴回数が減っている？お前は誰でもない。"}, {"type": "subtitle", "time": 18677.91, "timestamp": "05:11:17", "text": "あなたはどうでもいい存在なの？"}, {"type": "subtitle", "time": 18680.628, "timestamp": "05:11:20", "text": "ああ、そんな感じだけど、そこまでではない"}, {"type": "subtitle", "time": 18682.59, "timestamp": "05:11:22", "text": "えーっと、"}, {"type": "subtitle", "time": 18687.788, "timestamp": "05:11:27", "text": "別の道に行きたがっていた人"}, {"type": "subtitle", "time": 18692.15, "timestamp": "05:11:32", "text": "ええ、そんなに大きなものではなかったです"}, {"type": "subtitle", "time": 18696.788, "timestamp": "05:11:36", "text": "取引のやり方がわからない"}, {"type": "subtitle", "time": 18700.948, "timestamp": "05:11:40", "text": "説明しようとしたが、彼らはただ止まった。"}, {"type": "subtitle", "time": 18703.91, "timestamp": "05:11:43", "text": "私たちと同じくらい交流する"}, {"type": "subtitle", "time": 18705.868, "timestamp": "05:11:45", "text": "前に。"}, {"type": "subtitle", "time": 18710.15, "timestamp": "05:11:50", "text": "ああ、一部の人は、"}, {"type": "subtitle", "time": 18713.91, "timestamp": "05:11:53", "text": "超越的なもの。彼らが持ってきたらいいえ"}, {"type": "subtitle", "time": 18716.47, "timestamp": "05:11:56", "text": "あなたの見解とすべて、そして彼らは"}, {"type": "subtitle", "time": 18718.948, "timestamp": "05:11:58", "text": "彼らの良い面を見せて、もし彼らが"}]
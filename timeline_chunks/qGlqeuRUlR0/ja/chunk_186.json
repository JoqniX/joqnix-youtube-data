[{"type": "subtitle", "time": 11169.23, "timestamp": "03:06:09", "text": "私は見ていません。私は彼らを見かけません。"}, {"type": "subtitle", "time": 11171.71, "timestamp": "03:06:11", "text": "何？"}, {"type": "subtitle", "time": 11176.11, "timestamp": "03:06:16", "text": "待って。あ、待って。ドア。の"}, {"type": "subtitle", "time": 11195.51, "timestamp": "03:06:35", "text": "[音楽]"}, {"type": "subtitle", "time": 11205.75, "timestamp": "03:06:45", "text": "より使いやすくするために下げる"}, {"type": "subtitle", "time": 11210.75, "timestamp": "03:06:50", "text": "[音楽]"}, {"type": "subtitle", "time": 11215.15, "timestamp": "03:06:55", "text": "ここ。ああ、忘れてた"}]
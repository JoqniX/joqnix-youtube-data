[{"type": "subtitle", "time": 5103.35, "timestamp": "01:25:03", "text": "今。最高だ。また、"}, {"type": "subtitle", "time": 5105.75, "timestamp": "01:25:05", "text": "ヘッドパッドの部分を交換してください。あ、待って。"}, {"type": "subtitle", "time": 5108.47, "timestamp": "01:25:08", "text": "よし、一緒にやろう。我々はできる"}, {"type": "subtitle", "time": 5112.07, "timestamp": "01:25:12", "text": "私たちは一緒にグループを作って、"}, {"type": "subtitle", "time": 5115.95, "timestamp": "01:25:15", "text": "うん。飲みたいなら"}, {"type": "subtitle", "time": 5132.11, "timestamp": "01:25:32", "text": "ウィンク"}, {"type": "subtitle", "time": 5151.47, "timestamp": "01:25:51", "text": "時間。"}]
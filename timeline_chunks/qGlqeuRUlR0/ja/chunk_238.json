[{"type": "subtitle", "time": 14306.52, "timestamp": "03:58:26", "text": "ついに、他のすべてを手に入れることができる。そして"}, {"type": "subtitle", "time": 14315.429, "timestamp": "03:58:35", "text": "うん。待って、全部クリアしたっけ？"}, {"type": "subtitle", "time": 14317.07, "timestamp": "03:58:37", "text": "はい、そうしました。"}, {"type": "subtitle", "time": 14320.349, "timestamp": "03:58:40", "text": "右？倍にさせてください"}, {"type": "subtitle", "time": 14322.99, "timestamp": "03:58:42", "text": "チェック。はい、私は"}]
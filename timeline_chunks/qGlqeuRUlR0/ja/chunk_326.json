[{"type": "subtitle", "time": 19562.59, "timestamp": "05:26:02", "text": "私のストリームクリップを取るか、"}, {"type": "subtitle", "time": 19565.51, "timestamp": "05:26:05", "text": "代表者たちはこれらを見ることになっていたし、私は"}, {"type": "subtitle", "time": 19568.15, "timestamp": "05:26:08", "text": "切り取って、彼らはこう言うでしょう。「うん、君"}, {"type": "subtitle", "time": 19571.67, "timestamp": "05:26:11", "text": "あなたの免許は取り消されます。"}, {"type": "subtitle", "time": 19574.47, "timestamp": "05:26:14", "text": "あなたはこれについて言及し、違反さえしました"}, {"type": "subtitle", "time": 19577.99, "timestamp": "05:26:17", "text": "私たちのNDAとか何とか。 NDA もなかったし、"}, {"type": "subtitle", "time": 19579.75, "timestamp": "05:26:19", "text": "「まだ何もない。」でも、そうだけど、それでも"}, {"type": "subtitle", "time": 19582.708, "timestamp": "05:26:22", "text": "相互合意。でも、そう、私は"}, {"type": "subtitle", "time": 19584.708, "timestamp": "05:26:24", "text": "それは望んでいない。それはそうなるだろう"}, {"type": "subtitle", "time": 19586.55, "timestamp": "05:26:26", "text": "の"}, {"type": "subtitle", "time": 19592.15, "timestamp": "05:26:32", "text": "それには気をつけないと。それで、それで"}, {"type": "subtitle", "time": 19595.59, "timestamp": "05:26:35", "text": "気をつけないと。はい。はい。しかし"}, {"type": "subtitle", "time": 19596.51, "timestamp": "05:26:36", "text": "うん、"}, {"type": "subtitle", "time": 19599.47, "timestamp": "05:26:39", "text": "最終的には私は"}, {"type": "subtitle", "time": 19602.708, "timestamp": "05:26:42", "text": "私のケースはとても悲しい。わからない。"}, {"type": "subtitle", "time": 19606.15, "timestamp": "05:26:46", "text": "本当に気が滅入る。わからない。私"}, {"type": "subtitle", "time": 19609.11, "timestamp": "05:26:49", "text": "誰もそんな目に遭わないことを願うばかりです。"}, {"type": "subtitle", "time": 19612.948, "timestamp": "05:26:52", "text": "でも、一度"}, {"type": "subtitle", "time": 19615.23, "timestamp": "05:26:55", "text": "私は一日乗り越えることができる"}, {"type": "subtitle", "time": 19618.31, "timestamp": "05:26:58", "text": "すべて、デビューなど"}]
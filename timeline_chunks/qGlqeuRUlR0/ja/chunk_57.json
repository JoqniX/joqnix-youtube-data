[{"type": "subtitle", "time": 3423.589, "timestamp": "00:57:03", "text": "わかった。ああ、終わったよ。終わったよ。"}, {"type": "subtitle", "time": 3427.03, "timestamp": "00:57:07", "text": "いいぞ、いいぞ、いいぞ、いいぞ。今度は、"}, {"type": "subtitle", "time": 3429.23, "timestamp": "00:57:09", "text": "迷路攻撃。"}, {"type": "subtitle", "time": 3433.15, "timestamp": "00:57:13", "text": "右。迷路を完成させるには何が必要ですか？"}, {"type": "subtitle", "time": 3436.87, "timestamp": "00:57:16", "text": "攻撃？吐き出したいんです。はい、私は"}, {"type": "subtitle", "time": 3439.829, "timestamp": "00:57:19", "text": "それを見る必要がある。それだけです。"}, {"type": "subtitle", "time": 3443.43, "timestamp": "00:57:23", "text": "メイス攻撃とイエティ。 Vメイスが必要です"}, {"type": "subtitle", "time": 3447.03, "timestamp": "00:57:27", "text": "えっと、攻撃的ですね。そしてイエティ・ホンダ。私は必要としている"}, {"type": "subtitle", "time": 3451.71, "timestamp": "00:57:31", "text": "イエティのために取る。メイとしてVが勝つ必要がある。"}, {"type": "subtitle", "time": 3456.349, "timestamp": "00:57:36", "text": "よし、じゃあこっちの３つは"}, {"type": "subtitle", "time": 3458.19, "timestamp": "00:57:38", "text": "勝つ。おお"}, {"type": "subtitle", "time": 3461.99, "timestamp": "00:57:41", "text": "男の子。私はゲームに勝ちたいし、イエティは"}, {"type": "subtitle", "time": 3465.03, "timestamp": "00:57:45", "text": "イエティ。よし、私もこれをやりたい。"}, {"type": "subtitle", "time": 3467.23, "timestamp": "00:57:47", "text": "私たちはどこへ行くのですか？"}, {"type": "subtitle", "time": 3471.87, "timestamp": "00:57:51", "text": "男性ですよね？最善を尽くしましょう"}, {"type": "subtitle", "time": 3473.87, "timestamp": "00:57:53", "text": "それ。しかし"}, {"type": "subtitle", "time": 3478.27, "timestamp": "00:57:58", "text": "はい、生存している15人全員を表示してください。"}]
[{"type": "subtitle", "time": 15540.229, "timestamp": "04:19:00", "text": "混雑していて、あらゆるものが"}, {"type": "subtitle", "time": 15542.309, "timestamp": "04:19:02", "text": "人は生きる必要がある。そういうわけで、彼らは"}, {"type": "subtitle", "time": 15544.67, "timestamp": "04:19:04", "text": "生活空間を作る"}, {"type": "subtitle", "time": 15547.51, "timestamp": "04:19:07", "text": "もっと小さいサイズとか。わからない。どうやって"}, {"type": "subtitle", "time": 15551.149, "timestamp": "04:19:11", "text": "人々は生き残るのか？私"}, {"type": "subtitle", "time": 15554.63, "timestamp": "04:19:14", "text": "ほとんどの場合、必要なのは"}, {"type": "subtitle", "time": 15557.429, "timestamp": "04:19:17", "text": "すぐに慣れますよ。ない"}, {"type": "subtitle", "time": 15560.63, "timestamp": "04:19:20", "text": "この写真の座席は"}, {"type": "subtitle", "time": 15564.11, "timestamp": "04:19:24", "text": "これは私の学校の生徒です"}, {"type": "subtitle", "time": 15576.389, "timestamp": "04:19:36", "text": "ええと、インドとは全く違いますね。"}, {"type": "subtitle", "time": 15580.349, "timestamp": "04:19:40", "text": "うん、全然違うね。のように、"}, {"type": "subtitle", "time": 15583.87, "timestamp": "04:19:43", "text": "えーっと、家に帰って、"}, {"type": "subtitle", "time": 15587.99, "timestamp": "04:19:47", "text": "私の寮の部屋は以前は4倍くらいだった"}, {"type": "subtitle", "time": 15593.55, "timestamp": "04:19:53", "text": "私が住んでいたのと同じくらい大きい"}, {"type": "subtitle", "time": 15596.389, "timestamp": "04:19:56", "text": "行進。待って、見つけられるか確認してみます"}, {"type": "subtitle", "time": 15598.389, "timestamp": "04:19:58", "text": "その写真。"}]
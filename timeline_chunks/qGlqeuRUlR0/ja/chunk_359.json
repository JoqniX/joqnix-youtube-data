[{"type": "subtitle", "time": 21541.67, "timestamp": "05:59:01", "text": "仕事ですよね？あなたを引き留めて申し訳ありません"}, {"type": "subtitle", "time": 21543.91, "timestamp": "05:59:03", "text": "長い間。"}, {"type": "subtitle", "time": 21546.708, "timestamp": "05:59:06", "text": "いいえ、大丈夫です。楽しいよ。"}, {"type": "subtitle", "time": 21549.83, "timestamp": "05:59:09", "text": "あなたと話していると、時間が経つのがあっという間です。"}, {"type": "subtitle", "time": 21552.31, "timestamp": "05:59:12", "text": "時が経つのは早い。うん。当初は"}, {"type": "subtitle", "time": 21556.15, "timestamp": "05:59:16", "text": "本来は1時間しか持たないはずだったのに、"}, {"type": "subtitle", "time": 21560.03, "timestamp": "05:59:20", "text": "奇跡的に私たちは"}, {"type": "subtitle", "time": 21563.23, "timestamp": "05:59:23", "text": "時間。それで"}, {"type": "subtitle", "time": 21566.708, "timestamp": "05:59:26", "text": "でも、すべて順調です。"}, {"type": "subtitle", "time": 21570.31, "timestamp": "05:59:30", "text": "うん。だから、ごめんなさい、私は"}, {"type": "subtitle", "time": 21573.11, "timestamp": "05:59:33", "text": "おしゃべりモード。ああ、それは良いことだ。それは"}, {"type": "subtitle", "time": 21575.51, "timestamp": "05:59:35", "text": "良い。私はたくさん喋った。それが私です"}, {"type": "subtitle", "time": 21579.59, "timestamp": "05:59:39", "text": "良い会話ができてよかった。"}, {"type": "subtitle", "time": 21583.83, "timestamp": "05:59:43", "text": "ええ、私も嬉しいです。つまり、すべては"}, {"type": "subtitle", "time": 21585.67, "timestamp": "05:59:45", "text": "良い。"}, {"type": "subtitle", "time": 21587.59, "timestamp": "05:59:47", "text": "うん。"}, {"type": "subtitle", "time": 21589.83, "timestamp": "05:59:49", "text": "そして、あなたが言っていたのは"}, {"type": "subtitle", "time": 21592.31, "timestamp": "05:59:52", "text": "ちなみに、私は話すのがあまり得意ではありません。"}, {"type": "subtitle", "time": 21594.39, "timestamp": "05:59:54", "text": "そして今のあなたを見てください。あなたは得意です"}, {"type": "subtitle", "time": 21597.19, "timestamp": "05:59:57", "text": "話している。"}]
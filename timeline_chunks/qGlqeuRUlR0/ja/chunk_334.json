[{"type": "subtitle", "time": 20040.03, "timestamp": "05:34:00", "text": "高い。それほど高価ではないが、それでも"}, {"type": "subtitle", "time": 20043.91, "timestamp": "05:34:03", "text": "痛みのように。でも、なんとなく分かるよね。"}, {"type": "subtitle", "time": 20048.47, "timestamp": "05:34:08", "text": "いや、そうですね。えーと、モデルが"}, {"type": "subtitle", "time": 20051.75, "timestamp": "05:34:11", "text": "本当に良い、良い、そしてあなたがこれを設定したもの"}, {"type": "subtitle", "time": 20056.628, "timestamp": "05:34:16", "text": "より高い、より高い期待または基準"}, {"type": "subtitle", "time": 20060.628, "timestamp": "05:34:20", "text": "あなた自身のために、資産の背景"}, {"type": "subtitle", "time": 20062.23, "timestamp": "05:34:22", "text": "オーバーレイ"}, {"type": "subtitle", "time": 20065.11, "timestamp": "05:34:25", "text": "えっと、ミュージックビデオのすべてシングル"}, {"type": "subtitle", "time": 20067.51, "timestamp": "05:34:27", "text": "YouTuberとして自分のチャンネルで何をするか"}, {"type": "subtitle", "time": 20069.868, "timestamp": "05:34:29", "text": "それは"}, {"type": "subtitle", "time": 20073.07, "timestamp": "05:34:33", "text": "同じ品質でなければならないし、"}, {"type": "subtitle", "time": 20077.03, "timestamp": "05:34:37", "text": "物、そして私にはそれが買えないから"}, {"type": "subtitle", "time": 20079.83, "timestamp": "05:34:39", "text": "そのカテゴリーに属する人々"}, {"type": "subtitle", "time": 20081.75, "timestamp": "05:34:41", "text": "かっこよくてかっこいいモデルがいる人"}, {"type": "subtitle", "time": 20084.59, "timestamp": "05:34:44", "text": "しかし、残りのものは買えない"}, {"type": "subtitle", "time": 20087.75, "timestamp": "05:34:47", "text": "その時、人々は感じるような"}, {"type": "subtitle", "time": 20090.708, "timestamp": "05:34:50", "text": "彼らが私の配信を見ている時に、それについて不満を言う"}, {"type": "subtitle", "time": 20092.788, "timestamp": "05:34:52", "text": "良いモデルだが背景"}, {"type": "subtitle", "time": 20095.27, "timestamp": "05:34:55", "text": "すべてがおかしくて、低"}, {"type": "subtitle", "time": 20098.31, "timestamp": "05:34:58", "text": "質の悪い貧乏人のもの、そして彼らは"}]
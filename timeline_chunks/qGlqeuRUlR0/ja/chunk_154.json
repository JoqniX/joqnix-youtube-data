[{"type": "subtitle", "time": 9240.309, "timestamp": "02:34:00", "text": "日？わかった。えーと、"}, {"type": "subtitle", "time": 9243.27, "timestamp": "02:34:03", "text": "ゲームですよね？ええ、私たちは終わらせます"}, {"type": "subtitle", "time": 9244.83, "timestamp": "02:34:04", "text": "それ"}, {"type": "subtitle", "time": 9248.309, "timestamp": "02:34:08", "text": "今日。私は爆弾を"}, {"type": "subtitle", "time": 9251.389, "timestamp": "02:34:11", "text": "額。だから頭痛はない"}, {"type": "subtitle", "time": 9265.349, "timestamp": "02:34:25", "text": "もの。えっと、まだホラーゲームをプレイする必要がある"}, {"type": "subtitle", "time": 9268.71, "timestamp": "02:34:28", "text": "ゲームですよね？いや、いや、いや。私たちがプレイするゲーム"}, {"type": "subtitle", "time": 9271.03, "timestamp": "02:34:31", "text": "遊んでいるのは、ある意味ホラーです"}, {"type": "subtitle", "time": 9273.349, "timestamp": "02:34:33", "text": "ゲームですよね？ご心配なく、私たちが"}, {"type": "subtitle", "time": 9275.95, "timestamp": "02:34:35", "text": "もっとホラーゲーム"}, {"type": "subtitle", "time": 9277.469, "timestamp": "02:34:37", "text": "ストリーム。"}, {"type": "subtitle", "time": 9280.51, "timestamp": "02:34:40", "text": "ですから、私たちはそうするつもりです。しないで"}, {"type": "subtitle", "time": 9283.23, "timestamp": "02:34:43", "text": "心配。そして"}, {"type": "subtitle", "time": 9284.83, "timestamp": "02:34:44", "text": "えーと"}, {"type": "subtitle", "time": 9289.59, "timestamp": "02:34:49", "text": "よし、では、えーと、"}]
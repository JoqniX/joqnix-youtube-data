[{"type": "subtitle", "time": 240.869, "timestamp": "00:04:00", "text": "はい、ボードもアップロードされています"}, {"type": "subtitle", "time": 243.03, "timestamp": "00:04:03", "text": "そして、私はそれを年末までに公開します"}, {"type": "subtitle", "time": 245.67, "timestamp": "00:04:05", "text": "小川。もし見逃したなら、"}, {"type": "subtitle", "time": 247.99, "timestamp": "00:04:07", "text": "心配しないで、まだ見ることができます"}, {"type": "subtitle", "time": 252.149, "timestamp": "00:04:12", "text": "それ。ええ、そうですね。うん。最後に"}, {"type": "subtitle", "time": 254.39, "timestamp": "00:04:14", "text": "その物。また、あなたが"}, {"type": "subtitle", "time": 256.87, "timestamp": "00:04:16", "text": "Twitterのバナーに気づきました。あなたは何を"}, {"type": "subtitle", "time": 258.59, "timestamp": "00:04:18", "text": "Twitterについて考えてみてください"}, {"type": "subtitle", "time": 261.59, "timestamp": "00:04:21", "text": "バナー？ちょっと待って、ズームインして"}, {"type": "subtitle", "time": 267.27, "timestamp": "00:04:27", "text": "これ。うん。うん。皆さんはどう思いますか？"}, {"type": "subtitle", "time": 269.909, "timestamp": "00:04:29", "text": "このTwitterバナーのことですか？楽しいといいな。"}, {"type": "subtitle", "time": 272.469, "timestamp": "00:04:32", "text": "これが良いことだといいのですが。さあ、君たち"}, {"type": "subtitle", "time": 274.15, "timestamp": "00:04:34", "text": "これが最後だと思う"}, {"type": "subtitle", "time": 277.629, "timestamp": "00:04:37", "text": "Twitterバナーのバージョン1.0。"}, {"type": "subtitle", "time": 280.55, "timestamp": "00:04:40", "text": "私たちはデザインを思いつき、"}, {"type": "subtitle", "time": 282.55, "timestamp": "00:04:42", "text": "Twitchストリームですべて、そして私たちは"}, {"type": "subtitle", "time": 284.95, "timestamp": "00:04:44", "text": "本日Twitchで最終決定しました"}, {"type": "subtitle", "time": 287.59000000000003, "timestamp": "00:04:47", "text": "ストリーム。ええ、今はこんな感じです。"}, {"type": "subtitle", "time": 289.67, "timestamp": "00:04:49", "text": "だからタイトルは必要ない"}, {"type": "subtitle", "time": 292.629, "timestamp": "00:04:52", "text": "もう時間通りに行けるように"}, {"type": "subtitle", "time": 295.71, "timestamp": "00:04:55", "text": "今日のような配信をしてください。ウインク、ウインク、ウインク"}, {"type": "subtitle", "time": 298.95, "timestamp": "00:04:58", "text": "そんな風にウインクする。うん。うん。うん。それで"}]
[{"type": "subtitle", "time": 15180.79, "timestamp": "04:13:00", "text": "東京は、いくつかの場所がそうだと思うけど、私は"}, {"type": "subtitle", "time": 15183.83, "timestamp": "04:13:03", "text": "今は主要な都市のような都市なので"}, {"type": "subtitle", "time": 15187.269, "timestamp": "04:13:07", "text": "日本で2番目に大きな都市です"}, {"type": "subtitle", "time": 15194.63, "timestamp": "04:13:14", "text": "わあ、ああ、"}, {"type": "subtitle", "time": 15198.59, "timestamp": "04:13:18", "text": "私は写真を見ているのかと思った。それは"}, {"type": "subtitle", "time": 15201.83, "timestamp": "04:13:21", "text": "未来的なクールさ。そこに入るべきだ。"}, {"type": "subtitle", "time": 15211.11, "timestamp": "04:13:31", "text": "うん、東京にはすごく"}, {"type": "subtitle", "time": 15213.149, "timestamp": "04:13:33", "text": "多数の観光客、"}, {"type": "subtitle", "time": 15218.309, "timestamp": "04:13:38", "text": "しかし、それほど多くはない。私は思う"}, {"type": "subtitle", "time": 15222.71, "timestamp": "04:13:42", "text": "それは、えーと、で有名な"}, {"type": "subtitle", "time": 15227.349, "timestamp": "04:13:47", "text": "ここの料理はすごく美味しいです。"}, {"type": "subtitle", "time": 15230.79, "timestamp": "04:13:50", "text": "うん。ラーメンも好きです"}, {"type": "subtitle", "time": 15234.67, "timestamp": "04:13:54", "text": "ラーメンで有名です"}, {"type": "subtitle", "time": 15238.07, "timestamp": "04:13:58", "text": "そして、私がここに来たとき"}]
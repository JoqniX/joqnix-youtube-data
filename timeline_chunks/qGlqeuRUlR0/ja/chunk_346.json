[{"type": "subtitle", "time": 20761.43, "timestamp": "05:46:01", "text": "今は5000ドルくらいかな。だから私はまだ"}, {"type": "subtitle", "time": 20764.868, "timestamp": "05:46:04", "text": "通常の24時間配信はまだ"}, {"type": "subtitle", "time": 20766.948, "timestamp": "05:46:06", "text": "少しずつ数えてみました"}, {"type": "subtitle", "time": 20770.23, "timestamp": "05:46:10", "text": "若干。だからそれはまだ"}, {"type": "subtitle", "time": 20773.27, "timestamp": "05:46:13", "text": "ええと、下げないようにしてください。だから私が打ったとき"}, {"type": "subtitle", "time": 20777.19, "timestamp": "05:46:17", "text": "1000人のサブフォロワー、購読者なし、"}, {"type": "subtitle", "time": 20779.75, "timestamp": "05:46:19", "text": "おかげで、そのロックを解除することができました。"}, {"type": "subtitle", "time": 20782.39, "timestamp": "05:46:22", "text": "「ああ、元に戻るだろう」"}, {"type": "subtitle", "time": 20785.628, "timestamp": "05:46:25", "text": "最後のものを手に入れることができない"}, {"type": "subtitle", "time": 20788.47, "timestamp": "05:46:28", "text": "1つ。でも、手に入れることができてよかった。"}, {"type": "subtitle", "time": 20789.47, "timestamp": "05:46:29", "text": "最後"}, {"type": "subtitle", "time": 20794.23, "timestamp": "05:46:34", "text": "1つ。だから、それは本当に難しいだろう。いいえ、"}, {"type": "subtitle", "time": 20798.43, "timestamp": "05:46:38", "text": "またこれと同じように、これはとても多くの"}, {"type": "subtitle", "time": 20802.788, "timestamp": "05:46:42", "text": "ストリーム配信中の精神状態は"}, {"type": "subtitle", "time": 20806.39, "timestamp": "05:46:46", "text": "長いなど。そして私が"}, {"type": "subtitle", "time": 20808.788, "timestamp": "05:46:48", "text": "7日間PCの電源すら切らなかった"}, {"type": "subtitle", "time": 20812.868, "timestamp": "05:46:52", "text": "7日間以上で数日というのは異常だ。"}, {"type": "subtitle", "time": 20816.07, "timestamp": "05:46:56", "text": "私がやった最高記録は14だったと思います。"}]
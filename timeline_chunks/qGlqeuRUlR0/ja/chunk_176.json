[{"type": "subtitle", "time": 10560.51, "timestamp": "02:56:00", "text": "チャンス。うわぁ。うわぁ。うわぁ。"}, {"type": "subtitle", "time": 10602.95, "timestamp": "02:56:42", "text": "ああ。あ、待って。私は実際に殺すことができる"}, {"type": "subtitle", "time": 10604.95, "timestamp": "02:56:44", "text": "リーパーを持っている人はみんなそうだけどね。待って、"}, {"type": "subtitle", "time": 10606.95, "timestamp": "02:56:46", "text": "その挑戦、やってみよう。リーパー専用"}, {"type": "subtitle", "time": 10610.75, "timestamp": "02:56:50", "text": "挑戦だよ、おい。私はできると分かっています"}]
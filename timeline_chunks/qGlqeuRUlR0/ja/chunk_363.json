[{"type": "subtitle", "time": 21782.31, "timestamp": "06:03:02", "text": "ツイッターで彼らと話すべきだ。なぜ私は"}, {"type": "subtitle", "time": 21784.83, "timestamp": "06:03:04", "text": "それを声に出して言うの？"}, {"type": "subtitle", "time": 21787.07, "timestamp": "06:03:07", "text": "さあ、どうぞ"}, {"type": "subtitle", "time": 21791.788, "timestamp": "06:03:11", "text": "2番目に、そしてライブアップデートを受け取ります"}, {"type": "subtitle", "time": 21813.11, "timestamp": "06:03:33", "text": "つまり、最終的には、最終的には"}, {"type": "subtitle", "time": 21814.91, "timestamp": "06:03:34", "text": "支払うために"}]
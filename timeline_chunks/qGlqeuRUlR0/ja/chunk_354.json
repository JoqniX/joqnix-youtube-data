[{"type": "subtitle", "time": 21241.19, "timestamp": "05:54:01", "text": "料理と同じように、それくらい持っていく必要があります"}, {"type": "subtitle", "time": 21243.35, "timestamp": "05:54:03", "text": "調理器具。"}, {"type": "subtitle", "time": 21245.51, "timestamp": "05:54:05", "text": "液体カレーとかはどうですか？する"}, {"type": "subtitle", "time": 21248.39, "timestamp": "05:54:08", "text": "液体状の液体のようなものが手に入る"}, {"type": "subtitle", "time": 21251.19, "timestamp": "05:54:11", "text": "例えば、あなたが食事をしているとしましょう"}, {"type": "subtitle", "time": 21253.59, "timestamp": "05:54:13", "text": "インドの米とかそういうもの？いいえ。もしそれが"}, {"type": "subtitle", "time": 21256.628, "timestamp": "05:54:16", "text": "ご飯だけだと、少し違和感を感じるでしょう。いいえ、"}, {"type": "subtitle", "time": 21259.03, "timestamp": "05:54:19", "text": "でも、だからこそ人々はサンバルを食べ、"}, {"type": "subtitle", "time": 21260.948, "timestamp": "05:54:20", "text": "他のことですよね？液体カレーのように"}, {"type": "subtitle", "time": 21265.03, "timestamp": "05:54:25", "text": "そして全て。だから日本では、"}, {"type": "subtitle", "time": 21266.948, "timestamp": "05:54:26", "text": "お米はもち米なので、"}, {"type": "subtitle", "time": 21269.67, "timestamp": "05:54:29", "text": "持ちやすくて、何もかも完璧です。そうですね、"}, {"type": "subtitle", "time": 21272.47, "timestamp": "05:54:32", "text": "そして彼らはトッピングなどを置く"}, {"type": "subtitle", "time": 21274.628, "timestamp": "05:54:34", "text": "卵か何かだよね？では、"}, {"type": "subtitle", "time": 21277.03, "timestamp": "05:54:37", "text": "液体？液体は"}, {"type": "subtitle", "time": 21279.03, "timestamp": "05:54:39", "text": "置く？"}, {"type": "subtitle", "time": 21282.548, "timestamp": "05:54:42", "text": "えっと、見つけられると思います"}, {"type": "subtitle", "time": 21286.708, "timestamp": "05:54:46", "text": "カレー、カレー、パック入りカレーなど。あなたはできる"}, {"type": "subtitle", "time": 21290.11, "timestamp": "05:54:50", "text": "それを茹でて、その上に乗せる"}, {"type": "subtitle", "time": 21293.67, "timestamp": "05:54:53", "text": "日本のカレーのようなご飯。"}, {"type": "subtitle", "time": 21297.628, "timestamp": "05:54:57", "text": "また、インド系のお店や"}]
[{"type": "subtitle", "time": 9725.91, "timestamp": "02:42:05", "text": "可能。よし。来て。覚えて"}, {"type": "subtitle", "time": 9743.11, "timestamp": "02:42:23", "text": "それは良くない考えだ。わかった、待って、"}, {"type": "subtitle", "time": 9751.27, "timestamp": "02:42:31", "text": "多分。よし、逆さまのあの男"}, {"type": "subtitle", "time": 9774.11, "timestamp": "02:42:54", "text": "私は視力が必要で、"}, {"type": "subtitle", "time": 9776.19, "timestamp": "02:42:56", "text": "男。"}]
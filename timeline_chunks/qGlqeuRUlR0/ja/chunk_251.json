[{"type": "subtitle", "time": 15062.07, "timestamp": "04:11:02", "text": "でも、みんな落ち着いてると思うよ。"}, {"type": "subtitle", "time": 15065.349, "timestamp": "04:11:05", "text": "彼らはあまり汗をかかないよ、もし君が"}, {"type": "subtitle", "time": 15068.87, "timestamp": "04:11:08", "text": "時間通りに来るか、それとも2時か5時くらいかな"}, {"type": "subtitle", "time": 15072.309, "timestamp": "04:11:12", "text": "数分遅れました。つまり、それは悪いことだけど、それでも"}, {"type": "subtitle", "time": 15075.67, "timestamp": "04:11:15", "text": "まるで世界の終わりではないかのように。"}, {"type": "subtitle", "time": 15078.229, "timestamp": "04:11:18", "text": "完了です。今日もそうだったけど、"}, {"type": "subtitle", "time": 15080.71, "timestamp": "04:11:20", "text": "続いていて、私はここに来ることができなかった"}, {"type": "subtitle", "time": 15083.67, "timestamp": "04:11:23", "text": "時間。私たちは、予定通りミスをしました"}, {"type": "subtitle", "time": 15087.349, "timestamp": "04:11:27", "text": "2時間かけてそれをやって"}, {"type": "subtitle", "time": 15089.75, "timestamp": "04:11:29", "text": "大丈夫。大丈夫。うまくいけばそうなるだろう"}, {"type": "subtitle", "time": 15092.75, "timestamp": "04:11:32", "text": "これについてたくさん学ぶ"}, {"type": "subtitle", "time": 15097.67, "timestamp": "04:11:37", "text": "えーと、そこにいる間にそれに適応する"}, {"type": "subtitle", "time": 15101.429, "timestamp": "04:11:41", "text": "時間厳守、一日中タイムカードを押すこと、"}, {"type": "subtitle", "time": 15103.429, "timestamp": "04:11:43", "text": "規律、"}, {"type": "subtitle", "time": 15111.189, "timestamp": "04:11:51", "text": "あなたは多くの経験をすることになるでしょう。"}, {"type": "subtitle", "time": 15114.55, "timestamp": "04:11:54", "text": "うん。うん。そして私はとても幸せです"}, {"type": "subtitle", "time": 15115.95, "timestamp": "04:11:55", "text": "あなた。"}, {"type": "subtitle", "time": 15119.75, "timestamp": "04:11:59", "text": "こんにちは。どこで聞いても構わないかすみません"}]
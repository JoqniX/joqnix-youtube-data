[{"type": "subtitle", "time": 14342.55, "timestamp": "03:59:02", "text": "明日食べるべきですね。わからない。"}, {"type": "subtitle", "time": 14345.189, "timestamp": "03:59:05", "text": "私はそれを食べます。お腹が空きました。私はそうは思わない"}, {"type": "subtitle", "time": 14346.99, "timestamp": "03:59:06", "text": "知ってるけど私は"}, {"type": "subtitle", "time": 14349.469, "timestamp": "03:59:09", "text": "お腹がすいた。入手する"}, {"type": "subtitle", "time": 14351.469, "timestamp": "03:59:11", "text": "アライグマ"}]
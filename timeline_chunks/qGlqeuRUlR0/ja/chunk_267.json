[{"type": "subtitle", "time": 16020.79, "timestamp": "04:27:00", "text": "私はなれないのか なぜなれるのか なぜ私はなれないのか"}, {"type": "subtitle", "time": 16023.71, "timestamp": "04:27:03", "text": "今日必要ですか？"}, {"type": "subtitle", "time": 16035.269, "timestamp": "04:27:15", "text": "人生は厳しい。今になってようやく気づいた。"}, {"type": "subtitle", "time": 16037.99, "timestamp": "04:27:17", "text": "お元気でいらっしゃることを願っています。私はちょっと"}, {"type": "subtitle", "time": 16039.83, "timestamp": "04:27:19", "text": "心配になってきた。"}, {"type": "subtitle", "time": 16042.87, "timestamp": "04:27:22", "text": "わからない。"}, {"type": "subtitle", "time": 16045.67, "timestamp": "04:27:25", "text": "えっと、それにモデルの問題もあるんですよね？"}, {"type": "subtitle", "time": 16047.75, "timestamp": "04:27:27", "text": "モデル関連のことは心配しなければならない"}, {"type": "subtitle", "time": 16051.75, "timestamp": "04:27:31", "text": "それについて今話しましょう。だから私はこう思う"}, {"type": "subtitle", "time": 16052.75, "timestamp": "04:27:32", "text": "買う"}, {"type": "subtitle", "time": 16057.469, "timestamp": "04:27:37", "text": "どうすればいいですか、いくらになりますか"}, {"type": "subtitle", "time": 16060.51, "timestamp": "04:27:40", "text": "えーと2,000"}, {"type": "subtitle", "time": 16066.389, "timestamp": "04:27:46", "text": "円に？いくらになりますか？二"}, {"type": "subtitle", "time": 16071.03, "timestamp": "04:27:51", "text": "えーと、86,000 55円。"}, {"type": "subtitle", "time": 16072.55, "timestamp": "04:27:52", "text": "何？"}, {"type": "subtitle", "time": 16076.63, "timestamp": "04:27:56", "text": "それはいくらになりますか？"}, {"type": "subtitle", "time": 16079.75, "timestamp": "04:27:59", "text": "それはすごい量ですね。それは実際、かなりの量ですね。"}]
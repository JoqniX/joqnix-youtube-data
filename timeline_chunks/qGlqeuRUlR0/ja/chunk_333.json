[{"type": "subtitle", "time": 19981.19, "timestamp": "05:33:01", "text": "の上。確かに痛みはあるが、それが現実だ。"}, {"type": "subtitle", "time": 19983.19, "timestamp": "05:33:03", "text": "はい。"}, {"type": "subtitle", "time": 19985.06, "timestamp": "05:33:05", "text": "それはまさに必要なものだ。"}, {"type": "subtitle", "time": 19987.39, "timestamp": "05:33:07", "text": "[音楽]"}, {"type": "subtitle", "time": 19992.15, "timestamp": "05:33:12", "text": "うん。それで、えっと、それは何だったんですか？ああ、私は"}, {"type": "subtitle", "time": 19995.43, "timestamp": "05:33:15", "text": "問題ないと思います。うん。ちょっとさせてください"}, {"type": "subtitle", "time": 20000.628, "timestamp": "05:33:20", "text": "面白いことに、私は"}, {"type": "subtitle", "time": 20002.788, "timestamp": "05:33:22", "text": "私は、知ってる、私は"}, {"type": "subtitle", "time": 20004.708, "timestamp": "05:33:24", "text": "これを共有していますが、"}, {"type": "subtitle", "time": 20007.35, "timestamp": "05:33:27", "text": "リンクを期限切れにするべきだと思う"}, {"type": "subtitle", "time": 20016.8, "timestamp": "05:33:36", "text": "こんにちは。ちょっと覗いてみます。"}, {"type": "subtitle", "time": 20024.788, "timestamp": "05:33:44", "text": "ただただ悲しい。私の中に入らないで"}, {"type": "subtitle", "time": 20027.27, "timestamp": "05:33:47", "text": "ポジションだよ、みんな。"}, {"type": "subtitle", "time": 20035.11, "timestamp": "05:33:55", "text": "だから、流れに身を任せよう。ええ、それは"}, {"type": "subtitle", "time": 20037.15, "timestamp": "05:33:57", "text": "いいんだけど、ちょっと"}]
[{"type": "subtitle", "time": 17340.868, "timestamp": "04:49:00", "text": "ゴミの上に何かあったと思う。"}, {"type": "subtitle", "time": 17343.75, "timestamp": "04:49:03", "text": "どこかで燃やしたり、"}, {"type": "subtitle", "time": 17347.03, "timestamp": "04:49:07", "text": "どこかに捨ててしまえばいいのでは？いいえ、それは"}, {"type": "subtitle", "time": 17353.83, "timestamp": "04:49:13", "text": "大丈夫だよ。"}, {"type": "subtitle", "time": 17356.948, "timestamp": "04:49:16", "text": "そう思います。それほど難しくはない。"}, {"type": "subtitle", "time": 17358.948, "timestamp": "04:49:18", "text": "うん、"}, {"type": "subtitle", "time": 17362.628, "timestamp": "04:49:22", "text": "特に東京では英語が通じる"}, {"type": "subtitle", "time": 17367.91, "timestamp": "04:49:27", "text": "至る所に、そしてゴミの上に"}, {"type": "subtitle", "time": 17371.75, "timestamp": "04:49:31", "text": "えーと、ほとんどはゴミ箱の上で"}, {"type": "subtitle", "time": 17374.83, "timestamp": "04:49:34", "text": "それは、何を入れることができるかを示しています"}, {"type": "subtitle", "time": 17377.91, "timestamp": "04:49:37", "text": "ごみ。写真もあります"}, {"type": "subtitle", "time": 17379.59, "timestamp": "04:49:39", "text": "投げられるものと"}, {"type": "subtitle", "time": 17380.51, "timestamp": "04:49:40", "text": "できない"}, {"type": "subtitle", "time": 17383.83, "timestamp": "04:49:43", "text": "投げる。また、もしあなたがただ尋ねるだけなら"}, {"type": "subtitle", "time": 17395.67, "timestamp": "04:49:55", "text": "大丈夫だよ。ご心配なく。私"}, {"type": "subtitle", "time": 17397.91, "timestamp": "04:49:57", "text": "そう願っています。"}]
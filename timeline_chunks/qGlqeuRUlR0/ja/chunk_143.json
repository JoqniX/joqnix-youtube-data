[{"type": "subtitle", "time": 8582.15, "timestamp": "02:23:02", "text": "する。私がやらなければならない主なことの一つ。"}, {"type": "subtitle", "time": 8591.19, "timestamp": "02:23:11", "text": "シャバ。だから、そのゲームを終わらせるよ。"}, {"type": "subtitle", "time": 8594.07, "timestamp": "02:23:14", "text": "その前に、えーと、"}, {"type": "subtitle", "time": 8596.389, "timestamp": "02:23:16", "text": "爆弾も何もかも。ということで、私は戻ってきます"}, {"type": "subtitle", "time": 8600.07, "timestamp": "02:23:20", "text": "少しだけ。えっと、またやってしまってすみません"}, {"type": "subtitle", "time": 8607.51, "timestamp": "02:23:27", "text": "でも、でも、私は戻ってきます。よし、熱い"}, {"type": "subtitle", "time": 8610.07, "timestamp": "02:23:30", "text": "水。すべて補充しました。私は"}, {"type": "subtitle", "time": 8613.51, "timestamp": "02:23:33", "text": "私は上の階で寝ています。目覚まし時計が鳴った"}, {"type": "subtitle", "time": 8618.03, "timestamp": "02:23:38", "text": "午前5時または午前6時には準備完了。"}, {"type": "subtitle", "time": 8622.67, "timestamp": "02:23:42", "text": "えっと、私たちはきっかり12時に寝ます。"}, {"type": "subtitle", "time": 8626.87, "timestamp": "02:23:46", "text": "午前。了解。えっと、私たちは午前0時ちょうどに寝ます"}, {"type": "subtitle", "time": 8629.99, "timestamp": "02:23:49", "text": "そして私たちは5時か6時に起きます。わかりました。だった"}, {"type": "subtitle", "time": 8631.99, "timestamp": "02:23:51", "text": "運動とか色々やるつもりだし"}, {"type": "subtitle", "time": 8635.15, "timestamp": "02:23:55", "text": "配信を開始します。わかった。"}, {"type": "subtitle", "time": 8638.55, "timestamp": "02:23:58", "text": "こんにちは。ええ、そうですね。"}]
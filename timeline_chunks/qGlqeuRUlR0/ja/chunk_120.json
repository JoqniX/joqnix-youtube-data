[{"type": "subtitle", "time": 7202.149, "timestamp": "02:00:02", "text": "両方。ワイルドランは、"}, {"type": "subtitle", "time": 7205.35, "timestamp": "02:00:05", "text": "このテンポの速いゲーム。だから、私がこれまでしてきたように"}, {"type": "subtitle", "time": 7215.03, "timestamp": "02:00:15", "text": "えっと、最初にゲームをプレイしたとき、"}, {"type": "subtitle", "time": 7218.149, "timestamp": "02:00:18", "text": "今すぐストリームで見てください、感じました"}, {"type": "subtitle", "time": 7219.229, "timestamp": "02:00:19", "text": "それで"}, {"type": "subtitle", "time": 7222.39, "timestamp": "02:00:22", "text": "ペースが速いので奇妙です"}, {"type": "subtitle", "time": 7224.92, "timestamp": "02:00:24", "text": "感度と"}, {"type": "subtitle", "time": 7227.229, "timestamp": "02:00:27", "text": "[音楽]"}, {"type": "subtitle", "time": 7230.51, "timestamp": "02:00:30", "text": "すべて。しかし全体的に見て、私たちの時計は"}, {"type": "subtitle", "time": 7233.83, "timestamp": "02:00:33", "text": "本当に良いゲームだった。あなたはとても楽しんでいますね。"}, {"type": "subtitle", "time": 7244.87, "timestamp": "02:00:44", "text": "うん。タン、君はどう？プレイしますか？"}]
[{"type": "subtitle", "time": 8160.75, "timestamp": "02:16:00", "text": "これにはまだ多くの日が残っている"}, {"type": "subtitle", "time": 8163.39, "timestamp": "02:16:03", "text": "イベント？ええ、"}, {"type": "subtitle", "time": 8166.229, "timestamp": "02:16:06", "text": "12月末。うん、"}, {"type": "subtitle", "time": 8168.149, "timestamp": "02:16:08", "text": "時間だ。最後までやり遂げてみます。"}, {"type": "subtitle", "time": 8170.189, "timestamp": "02:16:10", "text": "たぶん、"}, {"type": "subtitle", "time": 8173.189, "timestamp": "02:16:13", "text": "今。ええ、そうですね。アディガタ、皆さん"}, {"type": "subtitle", "time": 8174.95, "timestamp": "02:16:14", "text": "本日伺います。来たすべての人々"}, {"type": "subtitle", "time": 8178.39, "timestamp": "02:16:18", "text": "今日までに"}, {"type": "subtitle", "time": 8182.27, "timestamp": "02:16:22", "text": "今日訪れたすべての人々"}, {"type": "subtitle", "time": 8185.39, "timestamp": "02:16:25", "text": "哲学。感謝"}, {"type": "subtitle", "time": 8192.709, "timestamp": "02:16:32", "text": "に。私は自由になれるように努力します"}, {"type": "subtitle", "time": 8195.549, "timestamp": "02:16:35", "text": "気楽にやろうよ。それで"}, {"type": "subtitle", "time": 8208.19, "timestamp": "02:16:48", "text": "エドワードが来てくれること"}, {"type": "subtitle", "time": 8211.349, "timestamp": "02:16:51", "text": "来てくれてありがとう。もうずいぶん時間が経ちましたね。"}, {"type": "subtitle", "time": 8213.91, "timestamp": "02:16:53", "text": "楽しんでいただけたなら幸いです。ありがとうございます"}, {"type": "subtitle", "time": 8214.83, "timestamp": "02:16:54", "text": "来る"}, {"type": "subtitle", "time": 8218.549, "timestamp": "02:16:58", "text": "来てくれてありがとう。スピードランしてるよ"}]
[{"type": "subtitle", "time": 3544.309, "timestamp": "00:59:04", "text": "ヒーローは100試合をクリアした。助成金を獲得する"}, {"type": "subtitle", "time": 3547.349, "timestamp": "00:59:07", "text": "二倍の進歩。わかった。手に入れます"}, {"type": "subtitle", "time": 3548.829, "timestamp": "00:59:08", "text": "えーと"}, {"type": "subtitle", "time": 3553.349, "timestamp": "00:59:13", "text": "バスティードとゾンブラ。そしてレッキングボール"}, {"type": "subtitle", "time": 3557.19, "timestamp": "00:59:17", "text": "そして最後にエコー。では、季節はいつなのでしょうか？"}, {"type": "subtitle", "time": 3560.51, "timestamp": "00:59:20", "text": "今シーズンはどうですか？"}, {"type": "subtitle", "time": 3563.39, "timestamp": "00:59:23", "text": "1つ？バトルパス"}, {"type": "subtitle", "time": 3567.549, "timestamp": "00:59:27", "text": "ヒーロー。これはバトルパスの新バージョンです"}, {"type": "subtitle", "time": 3571.71, "timestamp": "00:59:31", "text": "ヒーロー。ラ・ラマトラ。"}, {"type": "subtitle", "time": 3574.63, "timestamp": "00:59:34", "text": "ラマトラ。おお、いいね。"}, {"type": "subtitle", "time": 3576.67, "timestamp": "00:59:36", "text": "彼は"}, {"type": "subtitle", "time": 3580.27, "timestamp": "00:59:40", "text": "いいね。つまり、8つの階層があるということです。それは"}, {"type": "subtitle", "time": 3582.51, "timestamp": "00:59:42", "text": "80. 80"}, {"type": "subtitle", "time": 3584.03, "timestamp": "00:59:44", "text": "階層。"}, {"type": "subtitle", "time": 3595.109, "timestamp": "00:59:55", "text": "[音楽]"}, {"type": "subtitle", "time": 3598.75, "timestamp": "00:59:58", "text": "お分かりですね。これは皮膚ですよね？"}]
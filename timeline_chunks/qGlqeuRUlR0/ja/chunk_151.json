[{"type": "subtitle", "time": 9076.79, "timestamp": "02:31:16", "text": "ああ、私に見せてほしいの"}, {"type": "subtitle", "time": 9079.59, "timestamp": "02:31:19", "text": "私が何をしているかって？"}, {"type": "subtitle", "time": 9082.71, "timestamp": "02:31:22", "text": "私はただ、あなたができるようにアレンジしているだけです"}, {"type": "subtitle", "time": 9090.389, "timestamp": "02:31:30", "text": "これは文字通り私の配置です"}, {"type": "subtitle", "time": 9092.87, "timestamp": "02:31:32", "text": "ビリー・ビリーの物。あなたは私を見たい"}, {"type": "subtitle", "time": 9101.95, "timestamp": "02:31:41", "text": "面白かったけど、まあ、ただ"}, {"type": "subtitle", "time": 9105.71, "timestamp": "02:31:45", "text": "私のすべてのVSを正しくソートします"}, {"type": "subtitle", "time": 9107.469, "timestamp": "02:31:47", "text": "ストリーム"}, {"type": "subtitle", "time": 9109.67, "timestamp": "02:31:49", "text": "その通りです。そうですね、それが"}, {"type": "subtitle", "time": 9112.03, "timestamp": "02:31:52", "text": "興味深いですが、"}, {"type": "subtitle", "time": 9116.03, "timestamp": "02:31:56", "text": "うん、パパと私でストリーミング配信"}]
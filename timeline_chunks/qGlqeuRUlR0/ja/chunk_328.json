[{"type": "subtitle", "time": 19680.39, "timestamp": "05:28:00", "text": "結局は、"}, {"type": "subtitle", "time": 19683.11, "timestamp": "05:28:03", "text": "あなたを真の友人として見てくれる人"}, {"type": "subtitle", "time": 19685.99, "timestamp": "05:28:05", "text": "友達はどんなことがあってもあなたと一緒にいてくれる"}, {"type": "subtitle", "time": 19690.47, "timestamp": "05:28:10", "text": "何。真実。そして、"}, {"type": "subtitle", "time": 19693.83, "timestamp": "05:28:13", "text": "他の人たちはただ"}, {"type": "subtitle", "time": 19697.51, "timestamp": "05:28:17", "text": "彼ら自身の同様の関心事や"}, {"type": "subtitle", "time": 19699.628, "timestamp": "05:28:19", "text": "彼ら自身のもののようなもの"}, {"type": "subtitle", "time": 19703.11, "timestamp": "05:28:23", "text": "利益。彼らは自分たちの"}, {"type": "subtitle", "time": 19706.15, "timestamp": "05:28:26", "text": "そろそろ去る時だ。彼らは去りたいと思っている。"}, {"type": "subtitle", "time": 19707.23, "timestamp": "05:28:27", "text": "彼らは"}, {"type": "subtitle", "time": 19712.35, "timestamp": "05:28:32", "text": "ライブ。でも、やめて"}, {"type": "subtitle", "time": 19714.59, "timestamp": "05:28:34", "text": "のように"}, {"type": "subtitle", "time": 19719.11, "timestamp": "05:28:39", "text": "どう言えばいいのかわからないけど、"}, {"type": "subtitle", "time": 19722.948, "timestamp": "05:28:42", "text": "落ち込むようなことにならないように。うん。ただ"}, {"type": "subtitle", "time": 19724.868, "timestamp": "05:28:44", "text": "次のような人々の世話をする"}, {"type": "subtitle", "time": 19727.59, "timestamp": "05:28:47", "text": "あなたに近い、つまり実際に近い"}, {"type": "subtitle", "time": 19732.23, "timestamp": "05:28:52", "text": "あなた。だから、大丈夫だと思うよ。"}, {"type": "subtitle", "time": 19737.27, "timestamp": "05:28:57", "text": "誰が本物の人間か分かるでしょう"}]
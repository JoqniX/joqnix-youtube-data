[{"type": "subtitle", "time": 20942.03, "timestamp": "05:49:02", "text": "サービスか何かだけど、"}, {"type": "subtitle", "time": 20947.03, "timestamp": "05:49:07", "text": "友人や職場の仲間など"}, {"type": "subtitle", "time": 20949.548, "timestamp": "05:49:09", "text": "人々はあなたに話しかけます"}, {"type": "subtitle", "time": 20952.948, "timestamp": "05:49:12", "text": "そして彼らは時々彼らは"}, {"type": "subtitle", "time": 20954.43, "timestamp": "05:49:14", "text": "時々"}, {"type": "subtitle", "time": 20955.948, "timestamp": "05:49:15", "text": "驚いた"}, {"type": "subtitle", "time": 20960.27, "timestamp": "05:49:20", "text": "でもそれは日本語とそれほど似ていない"}, {"type": "subtitle", "time": 20963.59, "timestamp": "05:49:23", "text": "または、"}, {"type": "subtitle", "time": 20966.11, "timestamp": "05:49:26", "text": "日本語がわかるし、"}, {"type": "subtitle", "time": 20969.91, "timestamp": "05:49:29", "text": "YouTubeで見かけるようなものが好きな人。"}, {"type": "subtitle", "time": 20973.03, "timestamp": "05:49:33", "text": "うん。例えば空港で"}, {"type": "subtitle", "time": 20976.15, "timestamp": "05:49:36", "text": "日本語を話して"}, {"type": "subtitle", "time": 20980.23, "timestamp": "05:49:40", "text": "入国審査官や税関職員など、"}, {"type": "subtitle", "time": 20994.548, "timestamp": "05:49:54", "text": "あなたは1回か2回"}, {"type": "subtitle", "time": 20998.31, "timestamp": "05:49:58", "text": "えっと、新しいものを手に入れようと思って"}]
[{"type": "subtitle", "time": 16742.07, "timestamp": "04:39:02", "text": "住民カードが必要ですよね？あなたは"}, {"type": "subtitle", "time": 16746.07, "timestamp": "04:39:06", "text": "道化師の看板でサインする？うん。うん。"}, {"type": "subtitle", "time": 16750.709, "timestamp": "04:39:10", "text": "あなたが最初に私と同じように来たとき"}, {"type": "subtitle", "time": 16755.109, "timestamp": "04:39:15", "text": "来る前にあなたが好きなものをおすすめします"}, {"type": "subtitle", "time": 16759.109, "timestamp": "04:39:19", "text": "日本にお住まいの方は、オンラインフォームにご記入ください。"}, {"type": "subtitle", "time": 16762.789, "timestamp": "04:39:22", "text": "税関と入国管理局"}, {"type": "subtitle", "time": 16765.67, "timestamp": "04:39:25", "text": "もしあなたがそれを知っているなら。ご存知ですか？"}, {"type": "subtitle", "time": 16769.189, "timestamp": "04:39:29", "text": "それ？私はそれについて何も知りません。"}, {"type": "subtitle", "time": 16771.83, "timestamp": "04:39:31", "text": "はい、リンクを送ります。そしてもしあなたが"}, {"type": "subtitle", "time": 16774.31, "timestamp": "04:39:34", "text": "日本に来る前にそうしてください。"}, {"type": "subtitle", "time": 16776.31, "timestamp": "04:39:36", "text": "飛行機の中でも、"}, {"type": "subtitle", "time": 16778.07, "timestamp": "04:39:38", "text": "いや、待て、やっぱりいいや。私はそうは思わない"}, {"type": "subtitle", "time": 16779.868, "timestamp": "04:39:39", "text": "フライト中にできます。"}, {"type": "subtitle", "time": 16783.35, "timestamp": "04:39:43", "text": "しかし、フライト前に。 Wi-Fi？無料"}, {"type": "subtitle", "time": 16786.23, "timestamp": "04:39:46", "text": "Wi-Fi？いや、違うよ。いいえ、ないと思います"}, {"type": "subtitle", "time": 16788.788, "timestamp": "04:39:48", "text": "そこには無料Wi-Fiがあります。わあ、すごい。安い"}, {"type": "subtitle", "time": 16790.628, "timestamp": "04:39:50", "text": "そんな感じ。"}, {"type": "subtitle", "time": 16792.948, "timestamp": "04:39:52", "text": "何てことだ。"}, {"type": "subtitle", "time": 16796.628, "timestamp": "04:39:56", "text": "インターネット接続なし。何てことだ。インターネットなし、"}, {"type": "subtitle", "time": 16799.99, "timestamp": "04:39:59", "text": "兄弟。音楽をダウンロードして充電しよう"}]
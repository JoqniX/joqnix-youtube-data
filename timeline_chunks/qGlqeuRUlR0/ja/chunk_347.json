[{"type": "subtitle", "time": 20821.19, "timestamp": "05:47:01", "text": "14日間のメモをオフにするか、"}, {"type": "subtitle", "time": 20824.868, "timestamp": "05:47:04", "text": "PCを再起動しています。あれはすごいことだった。それ"}, {"type": "subtitle", "time": 20827.35, "timestamp": "05:47:07", "text": "それが私の最高記録でした。私は働いています"}, {"type": "subtitle", "time": 20828.43, "timestamp": "05:47:08", "text": "難しい。"}, {"type": "subtitle", "time": 20831.75, "timestamp": "05:47:11", "text": "だから、私はそれが好きなんです。"}, {"type": "subtitle", "time": 20836.39, "timestamp": "05:47:16", "text": "うん。それでもまだそんな感じがしない"}, {"type": "subtitle", "time": 20838.548, "timestamp": "05:47:18", "text": "こんなに配信したのは初めてだ。ただ"}, {"type": "subtitle", "time": 20840.948, "timestamp": "05:47:20", "text": "私はただの新しいストリームです"}, {"type": "subtitle", "time": 20844.23, "timestamp": "05:47:24", "text": "ストリーム。それはただの新しい日、あるいは私が"}, {"type": "subtitle", "time": 20845.91, "timestamp": "05:47:25", "text": "配信を始めたばかりです。私は配信しませんでした"}, {"type": "subtitle", "time": 20848.628, "timestamp": "05:47:28", "text": "この何日間も。まるで"}, {"type": "subtitle", "time": 20850.628, "timestamp": "05:47:30", "text": "それ。理由がわからない。それは良い"}, {"type": "subtitle", "time": 20853.19, "timestamp": "05:47:33", "text": "もの。それは良いことだ。一貫性"}, {"type": "subtitle", "time": 20858.23, "timestamp": "05:47:38", "text": "これらに関しては、が鍵となります。"}, {"type": "subtitle", "time": 20863.59, "timestamp": "05:47:43", "text": "それを日本で維持できればいいな"}, {"type": "subtitle", "time": 20866.548, "timestamp": "05:47:46", "text": "ええ、私もそう願っています。"}, {"type": "subtitle", "time": 20875.19, "timestamp": "05:47:55", "text": "うん。人との交流はどうですか？"}]
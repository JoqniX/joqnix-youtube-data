[{"type": "subtitle", "time": 4381.63, "timestamp": "01:13:01", "text": "補充しました。私は何をしたのか"}, {"type": "subtitle", "time": 4383.95, "timestamp": "01:13:03", "text": "する？する"}, {"type": "subtitle", "time": 4388.59, "timestamp": "01:13:08", "text": "それ。ああ、それだ。二"}, {"type": "subtitle", "time": 4393.55, "timestamp": "01:13:13", "text": "殺す。昨年も同じようなことがありました。さあ"}, {"type": "subtitle", "time": 4395.63, "timestamp": "01:13:15", "text": "行く。"}, {"type": "subtitle", "time": 4399.51, "timestamp": "01:13:19", "text": "H. わかりました。 6人中4人目。わかった。だから、私たちは"}, {"type": "subtitle", "time": 4402.51, "timestamp": "01:13:22", "text": "する"}, {"type": "subtitle", "time": 4404.669, "timestamp": "01:13:24", "text": "えっと"}, {"type": "subtitle", "time": 4411.189, "timestamp": "01:13:31", "text": "排除。わかった。金を勝ち取ろう。私たちには"}, {"type": "subtitle", "time": 4414.55, "timestamp": "01:13:34", "text": "勝者ゲーム、そして背の高い15人が必要です"}, {"type": "subtitle", "time": 4416.39, "timestamp": "01:13:36", "text": "同盟国。それが何なのか分かりません"}, {"type": "subtitle", "time": 4417.31, "timestamp": "01:13:37", "text": "手段、"}, {"type": "subtitle", "time": 4419.47, "timestamp": "01:13:39", "text": "でも、まあいいでしょう。さあ"}, {"type": "subtitle", "time": 4422.669, "timestamp": "01:13:42", "text": "行く。アーケードは冬です。"}, {"type": "subtitle", "time": 4426.63, "timestamp": "01:13:46", "text": "兄弟。アニメーションをお願いします。さあ行こう。"}, {"type": "subtitle", "time": 4428.87, "timestamp": "01:13:48", "text": "あのジャンプが上がるまで待ちましょう。えーと来る"}]
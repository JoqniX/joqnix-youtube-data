[{"type": "subtitle", "time": 301.39, "timestamp": "00:05:01", "text": "ええ、そうだといいですね"}, {"type": "subtitle", "time": 304.189, "timestamp": "00:05:04", "text": "良い。では、えっと、"}, {"type": "subtitle", "time": 307.749, "timestamp": "00:05:07", "text": "えっと、このストリームにIDを付けて、"}, {"type": "subtitle", "time": 308.99, "timestamp": "00:05:08", "text": "男たちは"}, {"type": "subtitle", "time": 312.15, "timestamp": "00:05:12", "text": "コントロールって、なんて呼ぶんだっけ？コントロール"}, {"type": "subtitle", "time": 316.23, "timestamp": "00:05:16", "text": "コマンドとかそういう類。では、すべて"}, {"type": "subtitle", "time": 318.55, "timestamp": "00:05:18", "text": "やるべきことは終わった。それを自動化したい、"}, {"type": "subtitle", "time": 320.31, "timestamp": "00:05:20", "text": "しかし、それが可能かどうかはわかりません"}, {"type": "subtitle", "time": 323.43, "timestamp": "00:05:23", "text": "自動化する。だから私はこう思うんです"}, {"type": "subtitle", "time": 328.07, "timestamp": "00:05:28", "text": "やらない。まあ、そうですね。"}, {"type": "subtitle", "time": 330.99, "timestamp": "00:05:30", "text": "ということで、"}, {"type": "subtitle", "time": 334.51, "timestamp": "00:05:34", "text": "ゲーム。チェック"}, {"type": "subtitle", "time": 339.15, "timestamp": "00:05:39", "text": "モッド。プロファイルを切り替えて"}, {"type": "subtitle", "time": 341.909, "timestamp": "00:05:41", "text": "良い。自分がプレイしている様子が気に入っています"}, {"type": "subtitle", "time": 344.07, "timestamp": "00:05:44", "text": "Valerantと私はまだ切り替えていません"}, {"type": "subtitle", "time": 357.67, "timestamp": "00:05:57", "text": "オーバーウォッチ。待って、私は持っていたことを思い出しました"}]
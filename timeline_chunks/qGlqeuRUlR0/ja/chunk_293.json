[{"type": "subtitle", "time": 17580.59, "timestamp": "04:53:00", "text": "君なら分かるよ"}, {"type": "subtitle", "time": 17584.628, "timestamp": "04:53:04", "text": "外。それはあなたの使い方によります"}, {"type": "subtitle", "time": 17587.99, "timestamp": "04:53:07", "text": "あなたは動画編集などをしているんですね。私はただ"}, {"type": "subtitle", "time": 17590.83, "timestamp": "04:53:10", "text": "私はただ手に入れたいだけです"}, {"type": "subtitle", "time": 17592.83, "timestamp": "04:53:12", "text": "えっと、"}, {"type": "subtitle", "time": 17596.51, "timestamp": "04:53:16", "text": "50シリーズまたは40シリーズのノートパソコン"}, {"type": "subtitle", "time": 17599.948, "timestamp": "04:53:19", "text": "より良いシリーズになると思う"}, {"type": "subtitle", "time": 17604.708, "timestamp": "04:53:24", "text": "今は、でももし高いなら"}, {"type": "subtitle", "time": 17607.99, "timestamp": "04:53:27", "text": "それはすごく高いと思う"}, {"type": "subtitle", "time": 17610.708, "timestamp": "04:53:30", "text": "えっと、オンラインではどちらが良いですか？"}, {"type": "subtitle", "time": 17615.03, "timestamp": "04:53:35", "text": "Amazon JPのようなeコマースサイトの方が優れている"}, {"type": "subtitle", "time": 17616.91, "timestamp": "04:53:36", "text": "[音楽]"}, {"type": "subtitle", "time": 17620.03, "timestamp": "04:53:40", "text": "アマゾンは、"}, {"type": "subtitle", "time": 17621.868, "timestamp": "04:53:41", "text": "すべて"}, {"type": "subtitle", "time": 17629.59, "timestamp": "04:53:49", "text": "新しいものを購入したい場合は、"}, {"type": "subtitle", "time": 17633.19, "timestamp": "04:53:53", "text": "Amazonが最適だと思う"}, {"type": "subtitle", "time": 17637.27, "timestamp": "04:53:57", "text": "ええ、Amazonとか、例えば"}, {"type": "subtitle", "time": 17639.15, "timestamp": "04:53:59", "text": "地元"}]
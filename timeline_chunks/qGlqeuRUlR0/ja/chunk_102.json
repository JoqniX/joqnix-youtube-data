[{"type": "subtitle", "time": 6121.83, "timestamp": "01:42:01", "text": "とても難しい。そしてこのキャラクターは"}, {"type": "subtitle", "time": 6125.229, "timestamp": "01:42:05", "text": "いいね。いいね。私はできた、私はできた"}, {"type": "subtitle", "time": 6134.229, "timestamp": "01:42:14", "text": "人々。さあ行こう。ドゥームフィスト。待って、"}, {"type": "subtitle", "time": 6136.03, "timestamp": "01:42:16", "text": "2番目を選ぶ"}, {"type": "subtitle", "time": 6139.669, "timestamp": "01:42:19", "text": "1つ。ああ、オーバーウォッチではもっと大きいですね"}, {"type": "subtitle", "time": 6178.99, "timestamp": "01:42:58", "text": "ああ、私は弾丸を粉砕している。"}]
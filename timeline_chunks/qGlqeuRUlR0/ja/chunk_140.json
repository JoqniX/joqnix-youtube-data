[{"type": "subtitle", "time": 8403.87, "timestamp": "02:20:03", "text": "12:00わかった。ええと、12:00に私たちは"}, {"type": "subtitle", "time": 8406.67, "timestamp": "02:20:06", "text": "寝る。 6の場合"}, {"type": "subtitle", "time": 8410.15, "timestamp": "02:20:10", "text": "時間、よし、6時間"}, {"type": "subtitle", "time": 8412.71, "timestamp": "02:20:12", "text": "ええと、私たちは寝ます。君たちは"}, {"type": "subtitle", "time": 8417.309, "timestamp": "02:20:17", "text": "VをV、VをV、そしてVを観る。オーケー。"}, {"type": "subtitle", "time": 8420.55, "timestamp": "02:20:20", "text": "うん。うまくいきますように。私"}, {"type": "subtitle", "time": 8424.07, "timestamp": "02:20:24", "text": "プレイリストか何かをかけるつもりだ。それで"}, {"type": "subtitle", "time": 8428.59, "timestamp": "02:20:28", "text": "えっと、私が眠い間は、アボイドを見てもいいですよ。"}, {"type": "subtitle", "time": 8430.75, "timestamp": "02:20:30", "text": "わかった。"}, {"type": "subtitle", "time": 8433.15, "timestamp": "02:20:33", "text": "私たちがすることは"}, {"type": "subtitle", "time": 8436.83, "timestamp": "02:20:36", "text": "休息は大切だから、"}, {"type": "subtitle", "time": 8440.91, "timestamp": "02:20:40", "text": "知る。そして私はベストを尽くしたい"}, {"type": "subtitle", "time": 8443.99, "timestamp": "02:20:43", "text": "明日。明日の私の計画は"}, {"type": "subtitle", "time": 8446.11, "timestamp": "02:20:46", "text": "音楽ストリーミング。私"}, {"type": "subtitle", "time": 8448.99, "timestamp": "02:20:48", "text": "音楽もできると思う"}, {"type": "subtitle", "time": 8456.15, "timestamp": "02:20:56", "text": "そして明日は、えっと、音楽の予定があります"}, {"type": "subtitle", "time": 8459.309, "timestamp": "02:20:59", "text": "ストリーム。そうします"}]
[{"type": "subtitle", "time": 16990.15, "timestamp": "04:43:10", "text": "ええ、何も修正していません。"}, {"type": "subtitle", "time": 16993.59, "timestamp": "04:43:13", "text": "ああ、大変だ。私は窮地に立たされている。"}, {"type": "subtitle", "time": 17001.27, "timestamp": "04:43:21", "text": "Dualingo。 DuallingoとGoogle。"}, {"type": "subtitle", "time": 17004.07, "timestamp": "04:43:24", "text": "[音楽]"}, {"type": "subtitle", "time": 17007.47, "timestamp": "04:43:27", "text": "モバイルデータについては、"}, {"type": "subtitle", "time": 17015.03, "timestamp": "04:43:35", "text": "[音楽]"}, {"type": "subtitle", "time": 17018.23, "timestamp": "04:43:38", "text": "ほとんどの人がそう思うように、"}, {"type": "subtitle", "time": 17021.83, "timestamp": "04:43:41", "text": "クレジットカードなどの銀行情報"}, {"type": "subtitle", "time": 17024.47, "timestamp": "04:43:44", "text": "またはデビットカード"}, {"type": "subtitle", "time": 17028.23, "timestamp": "04:43:48", "text": "国際的なものもそうだと思います"}, {"type": "subtitle", "time": 17038.628, "timestamp": "04:43:58", "text": "ダクト、そうだけど、それはプリペイドですか、それとも"}]
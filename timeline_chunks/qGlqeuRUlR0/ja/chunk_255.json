[{"type": "subtitle", "time": 15301.59, "timestamp": "04:15:01", "text": "まるで、その後は外に出ないような感じ"}, {"type": "subtitle", "time": 15304.149, "timestamp": "04:15:04", "text": "午後10時"}, {"type": "subtitle", "time": 15311.189, "timestamp": "04:15:11", "text": "いつでも行ける。そしてそれは良いことだ"}, {"type": "subtitle", "time": 15314.55, "timestamp": "04:15:14", "text": "もの。それは良いことだと思いますか？"}, {"type": "subtitle", "time": 15317.75, "timestamp": "04:15:17", "text": "夜って怖くない？"}, {"type": "subtitle", "time": 15321.67, "timestamp": "04:15:21", "text": "すごく安全なもの、例えば、ああ、つまり"}, {"type": "subtitle", "time": 15324.99, "timestamp": "04:15:24", "text": "概ね安全。イスラム教徒の旅"}, {"type": "subtitle", "time": 15328.51, "timestamp": "04:15:28", "text": "日本が知られているように、"}, {"type": "subtitle", "time": 15330.03, "timestamp": "04:15:30", "text": "安全性"}, {"type": "subtitle", "time": 15333.67, "timestamp": "04:15:33", "text": "しかし、悪いことはどこでも起こる。だから私は"}, {"type": "subtitle", "time": 15345.83, "timestamp": "04:15:45", "text": "それはすばらしい。インターネットの調子はどうですか？"}, {"type": "subtitle", "time": 15348.83, "timestamp": "04:15:48", "text": "ああ、インターネットはまるで私が"}, {"type": "subtitle", "time": 15352.71, "timestamp": "04:15:52", "text": "概ね良いのですが、"}, {"type": "subtitle", "time": 15355.83, "timestamp": "04:15:55", "text": "あなたが住んでいる建物のように。"}, {"type": "subtitle", "time": 15359.269, "timestamp": "04:15:59", "text": "建物はすごく古い感じ"}]
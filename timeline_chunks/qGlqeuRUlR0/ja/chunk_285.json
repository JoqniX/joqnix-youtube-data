[{"type": "subtitle", "time": 17101.91, "timestamp": "04:45:01", "text": "えっと、ちょっと待って、えっと、確認しましたか？"}, {"type": "subtitle", "time": 17104.07, "timestamp": "04:45:04", "text": "電子機器やマイクなど"}, {"type": "subtitle", "time": 17108.11, "timestamp": "04:45:08", "text": "もの？なぜ高いのですか？高い？"}, {"type": "subtitle", "time": 17111.31, "timestamp": "04:45:11", "text": "いいえ、それはあなたがそれを買うかどうかによります"}, {"type": "subtitle", "time": 17114.51, "timestamp": "04:45:14", "text": "新品同様かどうかは購入場所によります"}, {"type": "subtitle", "time": 17118.91, "timestamp": "04:45:18", "text": "から。きっと良い取引ができると思います"}, {"type": "subtitle", "time": 17120.43, "timestamp": "04:45:20", "text": "アマゾン。"}, {"type": "subtitle", "time": 17123.83, "timestamp": "04:45:23", "text": "ええ、マイクですね。実は確認したことがないんです。"}, {"type": "subtitle", "time": 17126.868, "timestamp": "04:45:26", "text": "ちょっと待って、確認させて。"}, {"type": "subtitle", "time": 17129.35, "timestamp": "04:45:29", "text": "でも他のものと同じように"}, {"type": "subtitle", "time": 17132.07, "timestamp": "04:45:32", "text": "高いと思う。しかし、やりすぎは禁物だ。"}, {"type": "subtitle", "time": 17134.47, "timestamp": "04:45:34", "text": "良いものを買える"}, {"type": "subtitle", "time": 17135.55, "timestamp": "04:45:35", "text": "[音楽]"}, {"type": "subtitle", "time": 17139.84, "timestamp": "04:45:39", "text": "Amazonでは、同様にリーズナブルな価格で購入できます。"}, {"type": "subtitle", "time": 17142.31, "timestamp": "04:45:42", "text": "[音楽]"}, {"type": "subtitle", "time": 17144.23, "timestamp": "04:45:44", "text": "問題は、私は自分の"}, {"type": "subtitle", "time": 17149.47, "timestamp": "04:45:49", "text": "Pは私が好きなので、1ルピーは"}, {"type": "subtitle", "time": 17153.03, "timestamp": "04:45:53", "text": "0.60円くらいかな。"}, {"type": "subtitle", "time": 17159.43, "timestamp": "04:45:59", "text": "M. そうですね、動作が遅くなるということですよね？それで"}]
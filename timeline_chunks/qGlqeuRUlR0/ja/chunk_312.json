[{"type": "subtitle", "time": 18721.11, "timestamp": "05:12:01", "text": "もし彼らに与えなければ"}, {"type": "subtitle", "time": 18723.51, "timestamp": "05:12:03", "text": "ビューや数字など、"}, {"type": "subtitle", "time": 18725.99, "timestamp": "05:12:05", "text": "彼らのチャンネルやコラボレーションの成長"}, {"type": "subtitle", "time": 18728.31, "timestamp": "05:12:08", "text": "または、あなたのプリンセスが"}, {"type": "subtitle", "time": 18731.19, "timestamp": "05:12:11", "text": "そこには。ああ、私もそう思っていました"}, {"type": "subtitle", "time": 18733.59, "timestamp": "05:12:13", "text": "私が誰かに連絡を取ろうとしたとき、"}, {"type": "subtitle", "time": 18736.31, "timestamp": "05:12:16", "text": "前のそれはそれほど大きなものではありません"}, {"type": "subtitle", "time": 18739.43, "timestamp": "05:12:19", "text": "もの。まるでそれはただ珍しいことだった"}, {"type": "subtitle", "time": 18743.03, "timestamp": "05:12:23", "text": "自分。そしてもう一人の人もこうでした"}, {"type": "subtitle", "time": 18748.03, "timestamp": "05:12:28", "text": "悪くはないけど、彼はただ"}, {"type": "subtitle", "time": 18751.83, "timestamp": "05:12:31", "text": "プロのように別の道を選ぶ"}, {"type": "subtitle", "time": 18755.91, "timestamp": "05:12:35", "text": "それについてどうするか。ああ、そうだね。でも大抵は"}, {"type": "subtitle", "time": 18759.03, "timestamp": "05:12:39", "text": "大丈夫だよ。いや、あまりないよ"}, {"type": "subtitle", "time": 18763.03, "timestamp": "05:12:43", "text": "まるでドラマみたい。"}, {"type": "subtitle", "time": 18765.11, "timestamp": "05:12:45", "text": "うん。"}, {"type": "subtitle", "time": 18767.35, "timestamp": "05:12:47", "text": "私が尋ねている理由は、ええ。うん。あなた"}, {"type": "subtitle", "time": 18769.27, "timestamp": "05:12:49", "text": "言う"}, {"type": "subtitle", "time": 18772.47, "timestamp": "05:12:52", "text": "最初の人は「こんにちは」と言います。ああ、こんにちは、ザフラス。"}, {"type": "subtitle", "time": 18775.27, "timestamp": "05:12:55", "text": "こんにちは。どうして入ってきたの？私が"}, {"type": "subtitle", "time": 18777.75, "timestamp": "05:12:57", "text": "質問は、私はもう十分だということです"}, {"type": "subtitle", "time": 18779.91, "timestamp": "05:12:59", "text": "INVユーチューバーの騒動で"}]
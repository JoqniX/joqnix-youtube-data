[{"type": "subtitle", "time": 17222.07, "timestamp": "04:47:02", "text": "一番安いマイクだから"}, {"type": "subtitle", "time": 17226.75, "timestamp": "04:47:06", "text": "えーと、一番安いUSBマイクは"}, {"type": "subtitle", "time": 17230.07, "timestamp": "04:47:10", "text": "3,597円"}, {"type": "subtitle", "time": 17237.43, "timestamp": "04:47:17", "text": "私にさせて"}, {"type": "subtitle", "time": 17240.15, "timestamp": "04:47:20", "text": "3,50097"}, {"type": "subtitle", "time": 17241.78, "timestamp": "04:47:21", "text": "3,500"}, {"type": "subtitle", "time": 17244.27, "timestamp": "04:47:24", "text": "[音楽]"}, {"type": "subtitle", "time": 17248.19, "timestamp": "04:47:28", "text": "3597。つまり、"}, {"type": "subtitle", "time": 17256.19, "timestamp": "04:47:36", "text": "あ、待って。ああ、それ。おお。おお。"}, {"type": "subtitle", "time": 17261.03, "timestamp": "04:47:41", "text": "わかった。はぁ。だから私は"}, {"type": "subtitle", "time": 17262.83, "timestamp": "04:47:42", "text": "両方ともですが、私は"}, {"type": "subtitle", "time": 17266.23, "timestamp": "04:47:46", "text": "重さのせいだと思った"}, {"type": "subtitle", "time": 17269.11, "timestamp": "04:47:49", "text": "荷物の重量は計測されます。いいえ。だから私の"}, {"type": "subtitle", "time": 17272.39, "timestamp": "04:47:52", "text": "父は「大きなスーツケースを持って行って」と言いました"}, {"type": "subtitle", "time": 17274.788, "timestamp": "04:47:54", "text": "持ち帰り用のバッグとか、そういうものも付いてるよ。だから私は"}, {"type": "subtitle", "time": 17277.23, "timestamp": "04:47:57", "text": "キャリーバッグに入れることを考えて"}]
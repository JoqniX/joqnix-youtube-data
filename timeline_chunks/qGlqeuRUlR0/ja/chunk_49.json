[{"type": "subtitle", "time": 2982.349, "timestamp": "00:49:42", "text": "うん。こんにちは。私は"}, {"type": "subtitle", "time": 2985.75, "timestamp": "00:49:45", "text": "戻る。前回の接続が切断されました"}, {"type": "subtitle", "time": 2992.87, "timestamp": "00:49:52", "text": "アフロはもう完全に終わった。"}, {"type": "subtitle", "time": 2996.47, "timestamp": "00:49:56", "text": "ようこそ、そしてようこそ。いらっしゃいませ。感謝"}, {"type": "subtitle", "time": 2997.71, "timestamp": "00:49:57", "text": "あなたへ"}, {"type": "subtitle", "time": 2999.91, "timestamp": "00:49:59", "text": "来るよ。皆さんお元気でお過ごしでしょうか。"}]
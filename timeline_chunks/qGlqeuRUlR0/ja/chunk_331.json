[{"type": "subtitle", "time": 19863.43, "timestamp": "05:31:03", "text": "親戚や両親のような人でも、"}, {"type": "subtitle", "time": 19865.03, "timestamp": "05:31:05", "text": "両親には言いたくない"}, {"type": "subtitle", "time": 19868.868, "timestamp": "05:31:08", "text": "時々、自分の"}, {"type": "subtitle", "time": 19876.47, "timestamp": "05:31:16", "text": "私はします"}, {"type": "subtitle", "time": 19885.788, "timestamp": "05:31:25", "text": "そうなんです"}, {"type": "subtitle", "time": 19888.11, "timestamp": "05:31:28", "text": "痛みがあまりにも多い"}, {"type": "subtitle", "time": 19891.99, "timestamp": "05:31:31", "text": "物事ではなく経験があなたを助けます"}, {"type": "subtitle", "time": 19895.27, "timestamp": "05:31:35", "text": "自分の道を切り開く、自分の道を切り開く"}, {"type": "subtitle", "time": 19897.51, "timestamp": "05:31:37", "text": "うん"}, {"type": "subtitle", "time": 19902.15, "timestamp": "05:31:42", "text": "それは人生の良いところですね。"}, {"type": "subtitle", "time": 19906.19, "timestamp": "05:31:46", "text": "そう、そのまま続けて。そして私は"}, {"type": "subtitle", "time": 19908.868, "timestamp": "05:31:48", "text": "つまり、あなたは大丈夫でしょう。うん。"}, {"type": "subtitle", "time": 19911.19, "timestamp": "05:31:51", "text": "あまり、あまり、あまり、あまり"}, {"type": "subtitle", "time": 19914.39, "timestamp": "05:31:54", "text": "レバーボーイが言うように、それに巻き込まれてしまった。何"}, {"type": "subtitle", "time": 19916.47, "timestamp": "05:31:56", "text": "それにあまり囚われないでください"}]
[{"type": "subtitle", "time": 16142.91, "timestamp": "04:29:02", "text": "パンテーン。えっと、"}, {"type": "subtitle", "time": 16145.229, "timestamp": "04:29:05", "text": "そして"}, {"type": "subtitle", "time": 16148.95, "timestamp": "04:29:08", "text": "私はコンビニで買ったことがない"}, {"type": "subtitle", "time": 16150.51, "timestamp": "04:29:10", "text": "店舗、"}, {"type": "subtitle", "time": 16156.149, "timestamp": "04:29:16", "text": "しかし、2,000ドル以下のものかもしれない"}, {"type": "subtitle", "time": 16164.51, "timestamp": "04:29:24", "text": "2000年。ああ"}, {"type": "subtitle", "time": 16169.59, "timestamp": "04:29:29", "text": "うん。どうぞ。あなたは、あなたが買うように言う"}, {"type": "subtitle", "time": 16172.87, "timestamp": "04:29:32", "text": "洗顔料、コンディショナー、シャンプー"}, {"type": "subtitle", "time": 16177.11, "timestamp": "04:29:37", "text": "こちらの薬局で購入できます。待って。待って。"}, {"type": "subtitle", "time": 16180.389, "timestamp": "04:29:40", "text": "何？酸性薬。よし。"}, {"type": "subtitle", "time": 16182.389, "timestamp": "04:29:42", "text": "うん。"}, {"type": "subtitle", "time": 16191.269, "timestamp": "04:29:51", "text": "奇妙だと思った。何てことだ。"}, {"type": "subtitle", "time": 16194.469, "timestamp": "04:29:54", "text": "ドラッグストアではあらゆるものが売られています"}, {"type": "subtitle", "time": 16198.95, "timestamp": "04:29:58", "text": "シャンプーから"}]
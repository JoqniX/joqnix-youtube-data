[{"type": "subtitle", "time": 17461.67, "timestamp": "04:51:01", "text": "買いましたか？"}, {"type": "subtitle", "time": 17463.59, "timestamp": "04:51:03", "text": "ノートパソコンは持参しましたか、それとも購入しましたか？"}, {"type": "subtitle", "time": 17465.75, "timestamp": "04:51:05", "text": "そこから？"}, {"type": "subtitle", "time": 17467.23, "timestamp": "04:51:07", "text": "ああ、私は"}, {"type": "subtitle", "time": 17471.59, "timestamp": "04:51:11", "text": "私はノートパソコンを持参しました。私 私"}, {"type": "subtitle", "time": 17473.83, "timestamp": "04:51:13", "text": "まだ購入できません。"}, {"type": "subtitle", "time": 17476.39, "timestamp": "04:51:16", "text": "高すぎる。待って、それは"}, {"type": "subtitle", "time": 17479.948, "timestamp": "04:51:19", "text": "日本は物価が高い？あまり"}, {"type": "subtitle", "time": 17483.99, "timestamp": "04:51:23", "text": "高価というのは、あなたが買えるような"}, {"type": "subtitle", "time": 17487.43, "timestamp": "04:51:27", "text": "中には1万円程度のノートパソコンもある"}, {"type": "subtitle", "time": 17488.27, "timestamp": "04:51:28", "text": "のように"}, {"type": "subtitle", "time": 17491.83, "timestamp": "04:51:31", "text": "中古だけど、私は欲しかった"}, {"type": "subtitle", "time": 17495.35, "timestamp": "04:51:35", "text": "ゲーミングノートパソコン"}, {"type": "subtitle", "time": 17497.91, "timestamp": "04:51:37", "text": "あるいは少なくとも高性能なノートパソコンのようなもので"}, {"type": "subtitle", "time": 17501.83, "timestamp": "04:51:41", "text": "もしあなたがそれを望むなら、あなたは次のように費やすことになるでしょう"}, {"type": "subtitle", "time": 17503.47, "timestamp": "04:51:43", "text": "2つまで"}, {"type": "subtitle", "time": 17507.59, "timestamp": "04:51:47", "text": "20万円くらいなら簡単に手に入る。"}, {"type": "subtitle", "time": 17511.27, "timestamp": "04:51:51", "text": "うん。それで、そう、私はそれを諦めて"}, {"type": "subtitle", "time": 17512.67, "timestamp": "04:51:52", "text": "自分のものを持参しました"}, {"type": "subtitle", "time": 17516.35, "timestamp": "04:51:56", "text": "ラップトップで作業しているのですが、"}]
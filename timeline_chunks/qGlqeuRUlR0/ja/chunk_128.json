[{"type": "subtitle", "time": 7701.75, "timestamp": "02:08:21", "text": "私は本当にダメなイエティだった。ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 7703.47, "timestamp": "02:08:23", "text": "そのような"}, {"type": "subtitle", "time": 7705.95, "timestamp": "02:08:25", "text": "1"}, {"type": "subtitle", "time": 7717.39, "timestamp": "02:08:37", "text": "おお。うん。こんにちは、"}, {"type": "subtitle", "time": 7719.99, "timestamp": "02:08:39", "text": "友人。アカビ、君の挑戦状が届いたぞ。"}, {"type": "subtitle", "time": 7722.24, "timestamp": "02:08:42", "text": "右？だって君は5月だったんだから。"}, {"type": "subtitle", "time": 7726.03, "timestamp": "02:08:46", "text": "[音楽]"}, {"type": "subtitle", "time": 7729.55, "timestamp": "02:08:49", "text": "えっと、1つやったよ"}, {"type": "subtitle", "time": 7732.75, "timestamp": "02:08:52", "text": "1つ。はい、私たちは出発しました。"}]
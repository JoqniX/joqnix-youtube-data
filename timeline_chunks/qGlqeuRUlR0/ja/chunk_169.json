[{"type": "subtitle", "time": 10143.23, "timestamp": "02:49:03", "text": "うん。カロンから武器を購入してください。"}, {"type": "subtitle", "time": 10146.83, "timestamp": "02:49:06", "text": "はい。どうすれば入手できますか"}, {"type": "subtitle", "time": 10150.429, "timestamp": "02:49:10", "text": "鎌？私の車の中にあるよ。"}, {"type": "subtitle", "time": 10153.03, "timestamp": "02:49:13", "text": "右？うまくいけば。そうでない場合は、"}, {"type": "subtitle", "time": 10163.309, "timestamp": "02:49:23", "text": "ディオは2発の弾丸を撃った。ハンマーは強い。"}, {"type": "subtitle", "time": 10166.87, "timestamp": "02:49:26", "text": "ナイフ、戦術用短機関銃。私はこれらのスナイパーが欲しい"}, {"type": "subtitle", "time": 10169.15, "timestamp": "02:49:29", "text": "などなど。抑制する"}, {"type": "subtitle", "time": 10171.83, "timestamp": "02:49:31", "text": "ストーカー。ピストルの消音器。おお、頭"}, {"type": "subtitle", "time": 10172.99, "timestamp": "02:49:32", "text": "ハンター。"}, {"type": "subtitle", "time": 10175.51, "timestamp": "02:49:35", "text": "ああ、それは後で買えるよ。私たちは"}]
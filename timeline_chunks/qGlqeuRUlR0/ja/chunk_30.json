[{"type": "subtitle", "time": 1802.35, "timestamp": "00:30:02", "text": "何匹釣ったか"}, {"type": "subtitle", "time": 1805.669, "timestamp": "00:30:05", "text": "けれど？ああ、ちゃんと終わらせたよ。今私は"}, {"type": "subtitle", "time": 1806.59, "timestamp": "00:30:06", "text": "必要"}, {"type": "subtitle", "time": 1808.43, "timestamp": "00:30:08", "text": "ブロック。八"}, {"type": "subtitle", "time": 1812.029, "timestamp": "00:30:12", "text": "雪玉。よし、時間だ"}, {"type": "subtitle", "time": 1813.18, "timestamp": "00:30:13", "text": "ブロック。"}, {"type": "subtitle", "time": 1821.95, "timestamp": "00:30:21", "text": "よし、壁を塞ぐ時間だ。えっと、"}, {"type": "subtitle", "time": 1825.43, "timestamp": "00:30:25", "text": "ええ、壁をたくさん使って"}, {"type": "subtitle", "time": 1829.149, "timestamp": "00:30:29", "text": "作業を終わらせるためにブロックします"}, {"type": "subtitle", "time": 1832.87, "timestamp": "00:30:32", "text": "より多くの課題に挑戦する。でも、ピロサ、私は"}, {"type": "subtitle", "time": 1834.99, "timestamp": "00:30:34", "text": "あなたがまだここにいるかどうかわかりませんが、"}, {"type": "subtitle", "time": 1839.389, "timestamp": "00:30:39", "text": "でも、それは本当に"}, {"type": "subtitle", "time": 1842.87, "timestamp": "00:30:42", "text": "1月23日までの1ヶ月間はずっと苦痛だった。"}, {"type": "subtitle", "time": 1850.19, "timestamp": "00:30:50", "text": "でも、どうすればいいのかわからない"}, {"type": "subtitle", "time": 1854.19, "timestamp": "00:30:54", "text": "通常、すべての科目はGのようなもの"}, {"type": "subtitle", "time": 1858.149, "timestamp": "00:30:58", "text": "試験。でも、まだ完全にはそうじゃない"}]
[{"type": "subtitle", "time": 622.47, "timestamp": "00:10:22", "text": "悪い。ああ、私が慣れていない感覚"}, {"type": "subtitle", "time": 625.35, "timestamp": "00:10:25", "text": "感度。何てことだ。"}, {"type": "subtitle", "time": 627.55, "timestamp": "00:10:27", "text": "私は慣れていない"}, {"type": "subtitle", "time": 629.71, "timestamp": "00:10:29", "text": "感度。"}, {"type": "subtitle", "time": 631.23, "timestamp": "00:10:31", "text": "待って。"}, {"type": "subtitle", "time": 637.15, "timestamp": "00:10:37", "text": "念のためもう一度確認させてください。"}, {"type": "subtitle", "time": 645.35, "timestamp": "00:10:45", "text": "わかった。下げる必要があると思うか、"}, {"type": "subtitle", "time": 647.99, "timestamp": "00:10:47", "text": "ゲーム内の何か。ゲームに慣れる"}, {"type": "subtitle", "time": 649.91, "timestamp": "00:10:49", "text": "なぜなら私は低センスなゲームをたくさんプレイしてきたから"}]
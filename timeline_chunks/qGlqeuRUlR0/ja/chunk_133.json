[{"type": "subtitle", "time": 7993.27, "timestamp": "02:13:13", "text": "私はこのダイオードを1つだけ必要としています"}, {"type": "subtitle", "time": 7995.99, "timestamp": "02:13:15", "text": "ゲームがまだ"}, {"type": "subtitle", "time": 8000.629, "timestamp": "02:13:20", "text": "あるいはメイやイエティのような、私が求めるのはそれだけです。"}, {"type": "subtitle", "time": 8002.43, "timestamp": "02:13:22", "text": "私はあなたを好きになれる"}, {"type": "subtitle", "time": 8005.03, "timestamp": "02:13:25", "text": "皮膚を手に入れれば、それで終わりです"}, {"type": "subtitle", "time": 8006.109, "timestamp": "02:13:26", "text": "の"}, {"type": "subtitle", "time": 8008.109, "timestamp": "02:13:28", "text": "日。"}, {"type": "subtitle", "time": 8010.75, "timestamp": "02:13:30", "text": "わーい。痛み"}, {"type": "subtitle", "time": 8018.629, "timestamp": "02:13:38", "text": "ゲーム。じゃあ、私がイエティ役をやろう。私は必要としている"}, {"type": "subtitle", "time": 8020.709, "timestamp": "02:13:40", "text": "ウィンストンはプレイしたことがないので、わかりません"}, {"type": "subtitle", "time": 8023.35, "timestamp": "02:13:43", "text": "自分がどうすべきかとか、その他すべて"}, {"type": "subtitle", "time": 8025.99, "timestamp": "02:13:45", "text": "私がすべきこと。それは"}, {"type": "subtitle", "time": 8028.589, "timestamp": "02:13:48", "text": "私が"}, {"type": "subtitle", "time": 8032.31, "timestamp": "02:13:52", "text": "メープルだと思う。ああ、私はMになった。待って、"}]
[{"type": "subtitle", "time": 20584.51, "timestamp": "05:43:04", "text": "ソマリア人とその他変な人"}, {"type": "subtitle", "time": 20587.31, "timestamp": "05:43:07", "text": "YouTuberまたはコンテンツクリエイター"}, {"type": "subtitle", "time": 20590.47, "timestamp": "05:43:10", "text": "[音楽]"}, {"type": "subtitle", "time": 20593.27, "timestamp": "05:43:13", "text": "良くなっている。うん、そうだね"}, {"type": "subtitle", "time": 20596.15, "timestamp": "05:43:16", "text": "今は良くなってきています。ええ、そうではありません"}, {"type": "subtitle", "time": 20599.35, "timestamp": "05:43:19", "text": "それらの百万ドルを"}, {"type": "subtitle", "time": 20601.67, "timestamp": "05:43:21", "text": "独占契約か何か。そうそう。"}, {"type": "subtitle", "time": 20603.83, "timestamp": "05:43:23", "text": "彼らのキックパートナー制度も確認しました。"}, {"type": "subtitle", "time": 20607.75, "timestamp": "05:43:27", "text": "複数回のリーミングは許可されています。"}, {"type": "subtitle", "time": 20609.99, "timestamp": "05:43:29", "text": "かっこいい。それは本当に良いですね"}, {"type": "subtitle", "time": 20614.91, "timestamp": "05:43:34", "text": "しかし"}, {"type": "subtitle", "time": 20618.788, "timestamp": "05:43:38", "text": "うん、やったよ。そして私の次の目標は"}, {"type": "subtitle", "time": 20621.75, "timestamp": "05:43:41", "text": "どういうわけか、私は手に入れることができたので"}, {"type": "subtitle", "time": 20624.548, "timestamp": "05:43:44", "text": "YouTube での収益化により、"}, {"type": "subtitle", "time": 20626.788, "timestamp": "05:43:46", "text": "つまり、私はYouTubeパートナーみたいなものだと思う。"}, {"type": "subtitle", "time": 20629.27, "timestamp": "05:43:49", "text": "でも、次はぜひ手に入れたい"}, {"type": "subtitle", "time": 20632.27, "timestamp": "05:43:52", "text": "Twitchパートナー。それは不可能だ"}, {"type": "subtitle", "time": 20637.75, "timestamp": "05:43:57", "text": "難しい。まあ、そうですね。しかし最初のステップ"}]
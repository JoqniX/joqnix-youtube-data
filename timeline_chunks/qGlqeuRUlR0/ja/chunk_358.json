[{"type": "subtitle", "time": 21481.99, "timestamp": "05:58:01", "text": "強くあれ。強くあれ。うん。ええ、もし"}, {"type": "subtitle", "time": 21484.15, "timestamp": "05:58:04", "text": "もしあなたが"}, {"type": "subtitle", "time": 21486.708, "timestamp": "05:58:06", "text": "えっと、誰かと話したいなら、"}, {"type": "subtitle", "time": 21491.03, "timestamp": "05:58:11", "text": "いつも電話してね。こんにちは。あるいはあなたと同じように"}, {"type": "subtitle", "time": 21493.03, "timestamp": "05:58:13", "text": "携帯電話を持っていれば、誰にでも電話できます"}, {"type": "subtitle", "time": 21494.08, "timestamp": "05:58:14", "text": "実は。"}, {"type": "subtitle", "time": 21496.03, "timestamp": "05:58:16", "text": "[音楽]"}, {"type": "subtitle", "time": 21499.27, "timestamp": "05:58:19", "text": "うん。自分の部屋に閉じこもるのは好きじゃない"}, {"type": "subtitle", "time": 21501.27, "timestamp": "05:58:21", "text": "自分の部屋にいてください"}, {"type": "subtitle", "time": 21506.31, "timestamp": "05:58:26", "text": "長すぎた。または悲しい気持ちになるかもしれません"}, {"type": "subtitle", "time": 21509.67, "timestamp": "05:58:29", "text": "あるいは、まるで気が狂いそう"}, {"type": "subtitle", "time": 21511.31, "timestamp": "05:58:31", "text": "時々。"}, {"type": "subtitle", "time": 21513.75, "timestamp": "05:58:33", "text": "時々、ほとんどの場合、"}, {"type": "subtitle", "time": 21516.548, "timestamp": "05:58:36", "text": "大丈夫。友達もできるし、"}, {"type": "subtitle", "time": 21521.47, "timestamp": "05:58:41", "text": "あなたは新しいことを見つける、私は"}, {"type": "subtitle", "time": 21537.59, "timestamp": "05:58:57", "text": "うん。だから、日本ではもう遅い時間だと思うんだけど、"}, {"type": "subtitle", "time": 21539.99, "timestamp": "05:58:59", "text": "右？ああ、もう遅い時間だ。あなたがしなければならない"}]
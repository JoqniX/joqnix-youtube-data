[{"type": "subtitle", "time": 5281.669, "timestamp": "01:28:01", "text": "わかった。あぁ、アカビ、こっちに来て。ここに来て。"}, {"type": "subtitle", "time": 5283.07, "timestamp": "01:28:03", "text": "ここに来て。ここに来て。来る"}, {"type": "subtitle", "time": 5286.55, "timestamp": "01:28:06", "text": "ここ。アビ、おいおいおい。私をからかってみて。"}, {"type": "subtitle", "time": 5300.07, "timestamp": "01:28:20", "text": "ああ、背が高くなった人がいる。"}, {"type": "subtitle", "time": 5302.31, "timestamp": "01:28:22", "text": "私が行きます。私が行きます。私が行きます。私が行きます。病気"}, {"type": "subtitle", "time": 5304.68, "timestamp": "01:28:24", "text": "行く。"}]
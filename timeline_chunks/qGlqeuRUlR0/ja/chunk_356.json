[{"type": "subtitle", "time": 21360.99, "timestamp": "05:56:00", "text": "私は南部出身なので、今は辛いものが好きです。"}, {"type": "subtitle", "time": 21365.03, "timestamp": "05:56:05", "text": "だから、もしあったら見てみよう"}, {"type": "subtitle", "time": 21367.27, "timestamp": "05:56:07", "text": "日本にも似たようなものがあって、"}, {"type": "subtitle", "time": 21371.51, "timestamp": "05:56:11", "text": "粉末状のもの。私は「どうしてこうなんだろう」と思いました"}, {"type": "subtitle", "time": 21373.43, "timestamp": "05:56:13", "text": "粉末？"}, {"type": "subtitle", "time": 21376.788, "timestamp": "05:56:16", "text": "粉末バターミルク。ええ、"}, {"type": "subtitle", "time": 21380.788, "timestamp": "05:56:20", "text": "自分で作る。私は思う"}, {"type": "subtitle", "time": 21382.868, "timestamp": "05:56:22", "text": "さよなら。"}, {"type": "subtitle", "time": 21386.708, "timestamp": "05:56:26", "text": "ラッシーは、他の種類と同じように見つけることができます。"}, {"type": "subtitle", "time": 21391.27, "timestamp": "05:56:31", "text": "味がない、それだけだ。そうそう。つまり"}, {"type": "subtitle", "time": 21393.948, "timestamp": "05:56:33", "text": "ヨーグルトに似ている"}, {"type": "subtitle", "time": 21395.47, "timestamp": "05:56:35", "text": "ドリンク"}, {"type": "subtitle", "time": 21399.59, "timestamp": "05:56:39", "text": "私の好きなインドの友達から"}, {"type": "subtitle", "time": 21403.91, "timestamp": "05:56:43", "text": "仕事。彼らはヨーグルトのように飲むのが大好きです"}, {"type": "subtitle", "time": 21407.67, "timestamp": "05:56:47", "text": "ここで飲み物をどうぞ。私自身は一度も持ったことがないのですが、"}, {"type": "subtitle", "time": 21409.628, "timestamp": "05:56:49", "text": "しかし彼らは"}, {"type": "subtitle", "time": 21412.99, "timestamp": "05:56:52", "text": "それ。そして私は"}, {"type": "subtitle", "time": 21415.83, "timestamp": "05:56:55", "text": "ほとんどのものと同じように考えてください"}, {"type": "subtitle", "time": 21418.15, "timestamp": "05:56:58", "text": "こちらで見つけてください。あなたは自分の"}]
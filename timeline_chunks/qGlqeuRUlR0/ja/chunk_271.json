[{"type": "subtitle", "time": 16260.87, "timestamp": "04:31:00", "text": "あ、エアコンがあるよ。わかった。わかった。えっと、待って、私は"}, {"type": "subtitle", "time": 16262.469, "timestamp": "04:31:02", "text": "疑問があります。支払わなければならない"}, {"type": "subtitle", "time": 16264.389, "timestamp": "04:31:04", "text": "部屋の家賃のためですよね？では"}, {"type": "subtitle", "time": 16268.51, "timestamp": "04:31:08", "text": "弾力性、水、すべて？"}, {"type": "subtitle", "time": 16273.189, "timestamp": "04:31:13", "text": "ああ、あなたの場合、"}, {"type": "subtitle", "time": 16275.269, "timestamp": "04:31:15", "text": "ええと、それは別物です。ええ、都市は"}, {"type": "subtitle", "time": 16278.149, "timestamp": "04:31:18", "text": "別。うん。"}, {"type": "subtitle", "time": 16279.95, "timestamp": "04:31:19", "text": "持っているもの"}, {"type": "subtitle", "time": 16283.91, "timestamp": "04:31:23", "text": "寮の部屋で支払うような"}, {"type": "subtitle", "time": 16286.469, "timestamp": "04:31:26", "text": "電気や"}, {"type": "subtitle", "time": 16289.59, "timestamp": "04:31:29", "text": "水と部屋の家賃は"}, {"type": "subtitle", "time": 16290.99, "timestamp": "04:31:30", "text": "1つでそれと同じように"}, {"type": "subtitle", "time": 16294.229, "timestamp": "04:31:34", "text": "パッケージ。でも私の会社が払ってくれたように"}, {"type": "subtitle", "time": 16296.389, "timestamp": "04:31:36", "text": "すべてにおいて、私はそれを生きていた"}, {"type": "subtitle", "time": 16298.389, "timestamp": "04:31:38", "text": "無料で利用できます。"}, {"type": "subtitle", "time": 16308.11, "timestamp": "04:31:48", "text": "私は私はあなたと共有します"}, {"type": "subtitle", "time": 16311.189, "timestamp": "04:31:51", "text": "良いものを共有します"}, {"type": "subtitle", "time": 16315.87, "timestamp": "04:31:55", "text": "学校のものなので、見ることができます"}]
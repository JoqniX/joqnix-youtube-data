[{"type": "subtitle", "time": 1381.51, "timestamp": "00:23:01", "text": "痛み。痛み。彼はそこに横たわっていた"}, {"type": "subtitle", "time": 1383.83, "timestamp": "00:23:03", "text": "私が何かを取っている間、私を見ていた"}, {"type": "subtitle", "time": 1386.82, "timestamp": "00:23:06", "text": "雪。"}, {"type": "subtitle", "time": 1389.47, "timestamp": "00:23:09", "text": "[音楽]"}, {"type": "subtitle", "time": 1391.549, "timestamp": "00:23:11", "text": "わかった。来ないで"}, {"type": "subtitle", "time": 1395.07, "timestamp": "00:23:15", "text": "自分。私は彼をブロックした"}, {"type": "subtitle", "time": 1399.11, "timestamp": "00:23:19", "text": "けれど。ああ、いいラジG。私はできなかった"}, {"type": "subtitle", "time": 1401.99, "timestamp": "00:23:21", "text": "行きましたが、最善を尽くしています。"}, {"type": "subtitle", "time": 1404.19, "timestamp": "00:23:24", "text": "私はある種の報酬を得ました。"}, {"type": "subtitle", "time": 1407.35, "timestamp": "00:23:27", "text": "良い。待って、これってチチに似てる。の"}, {"type": "subtitle", "time": 1410.11, "timestamp": "00:23:30", "text": "肌がチチに似ている。"}, {"type": "subtitle", "time": 1414.149, "timestamp": "00:23:34", "text": "おお。くそ、こいつらは皮膚を持ってる、私の"}, {"type": "subtitle", "time": 1416.19, "timestamp": "00:23:36", "text": "男。"}, {"type": "subtitle", "time": 1420.149, "timestamp": "00:23:40", "text": "おお。これらの人々には皮膚がある。おお。見て"}, {"type": "subtitle", "time": 1422.71, "timestamp": "00:23:42", "text": "それに取り組む。チチに似ている。これは"}, {"type": "subtitle", "time": 1425.99, "timestamp": "00:23:45", "text": "分かりません。これは中国の妖怪です。"}, {"type": "subtitle", "time": 1429.19, "timestamp": "00:23:49", "text": "幽霊。名前は忘れてしまったのですが、"}, {"type": "subtitle", "time": 1431.71, "timestamp": "00:23:51", "text": "その背景にあるストーリーは本当に素晴らしい"}, {"type": "subtitle", "time": 1437.31, "timestamp": "00:23:57", "text": "それ。雪のゲームに勝つ。待って、私が勝った。おお、"}]
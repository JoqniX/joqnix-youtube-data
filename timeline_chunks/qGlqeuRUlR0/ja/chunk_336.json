[{"type": "subtitle", "time": 20161.91, "timestamp": "05:36:01", "text": "うん。それもまた真実だ。はい。"}, {"type": "subtitle", "time": 20167.27, "timestamp": "05:36:07", "text": "うん。うん、そう、少年が言うように"}, {"type": "subtitle", "time": 20175.67, "timestamp": "05:36:15", "text": "何てことだ"}, {"type": "subtitle", "time": 20178.548, "timestamp": "05:36:18", "text": "ありのままの自分で、向上心を持って"}, {"type": "subtitle", "time": 20180.23, "timestamp": "05:36:20", "text": "あなた自身"}, {"type": "subtitle", "time": 20182.948, "timestamp": "05:36:22", "text": "そして残りは"}, {"type": "subtitle", "time": 20185.43, "timestamp": "05:36:25", "text": "そう思います"}, {"type": "subtitle", "time": 20189.67, "timestamp": "05:36:29", "text": "それがあなたのあるべき姿だと思います"}, {"type": "subtitle", "time": 20192.788, "timestamp": "05:36:32", "text": "目標とする"}, {"type": "subtitle", "time": 20195.75, "timestamp": "05:36:35", "text": "自分のやりたいことをすればいい。何を作るか"}, {"type": "subtitle", "time": 20198.31, "timestamp": "05:36:38", "text": "あなたが作りたいものを作れば、人々はついてくるでしょう"}, {"type": "subtitle", "time": 20201.19, "timestamp": "05:36:41", "text": "それ。"}, {"type": "subtitle", "time": 20203.15, "timestamp": "05:36:43", "text": "私"}, {"type": "subtitle", "time": 20206.99, "timestamp": "05:36:46", "text": "うん、うまくいくといいな"}, {"type": "subtitle", "time": 20209.27, "timestamp": "05:36:49", "text": "良い。行くことを考えたことはありますか？"}, {"type": "subtitle", "time": 20211.67, "timestamp": "05:36:51", "text": "2Dでライブ配信？あなたはそれについて話したと思います"}, {"type": "subtitle", "time": 20213.91, "timestamp": "05:36:53", "text": "かつて私と一緒だった"}, {"type": "subtitle", "time": 20216.868, "timestamp": "05:36:56", "text": "ずっと昔。うん。何か進展はありましたか？"}, {"type": "subtitle", "time": 20219.75, "timestamp": "05:36:59", "text": "最近どうですか？"}]
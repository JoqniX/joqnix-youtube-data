[{"type": "subtitle", "time": 17825.628, "timestamp": "04:57:05", "text": "50,000。それはああ、ほとんど"}, {"type": "subtitle", "time": 17829.83, "timestamp": "04:57:09", "text": "30,000。そうそう。"}, {"type": "subtitle", "time": 17831.51, "timestamp": "04:57:11", "text": "これで十分だったでしょう？購入するために"}, {"type": "subtitle", "time": 17834.39, "timestamp": "04:57:14", "text": "必需品とその他すべて。"}, {"type": "subtitle", "time": 17839.708, "timestamp": "04:57:19", "text": "いや、違うよ。それはほとんど次のようなものでした"}, {"type": "subtitle", "time": 17842.59, "timestamp": "04:57:22", "text": "のために"}, {"type": "subtitle", "time": 17845.628, "timestamp": "04:57:25", "text": "生き延びている。まるで私がそうしなかったかのように"}, {"type": "subtitle", "time": 17849.43, "timestamp": "04:57:29", "text": "拡張機能以外はほとんど何も買わない。良い、"}, {"type": "subtitle", "time": 17853.11, "timestamp": "04:57:33", "text": "延長ではなく、私の"}, {"type": "subtitle", "time": 17856.47, "timestamp": "04:57:36", "text": "充電器、私のノートパソコンの充電器、そして私の"}, {"type": "subtitle", "time": 17858.59, "timestamp": "04:57:38", "text": "携帯電話の充電器。"}, {"type": "subtitle", "time": 17861.788, "timestamp": "04:57:41", "text": "そしてそして"}, {"type": "subtitle", "time": 17865.83, "timestamp": "04:57:45", "text": "ええ、ちょうどそれらを買ったところです。"}, {"type": "subtitle", "time": 17866.67, "timestamp": "04:57:46", "text": "それは"}, {"type": "subtitle", "time": 17870.19, "timestamp": "04:57:50", "text": "それ。そして私は生き延びなければならなかった"}, {"type": "subtitle", "time": 17875.03, "timestamp": "04:57:55", "text": "それ。それから私は実家からお金を受け取りました"}, {"type": "subtitle", "time": 17879.19, "timestamp": "04:57:59", "text": "両親が私にお金を送ってくれたとき"}]
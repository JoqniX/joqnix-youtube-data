[{"type": "subtitle", "time": 8282.27, "timestamp": "02:18:02", "text": "水分補給をしっかり行い、体を温かく保ちましょう。"}, {"type": "subtitle", "time": 8286.99, "timestamp": "02:18:06", "text": "わかった。はい、またお会いしましょう"}, {"type": "subtitle", "time": 8308.27, "timestamp": "02:18:28", "text": "うん。"}, {"type": "subtitle", "time": 8310.99, "timestamp": "02:18:30", "text": "こんにちは。元気でいることを願っています"}, {"type": "subtitle", "time": 8318.709, "timestamp": "02:18:38", "text": "私たちが生きている希望について説明してください。こんにちは、私たちは"}, {"type": "subtitle", "time": 8322.309, "timestamp": "02:18:42", "text": "ライブ。一日の後半へようこそ"}, {"type": "subtitle", "time": 8326.15, "timestamp": "02:18:46", "text": "ヨアトンの1人。では、"}, {"type": "subtitle", "time": 8329.309, "timestamp": "02:18:49", "text": "前回の続きから始めましょう。など"}, {"type": "subtitle", "time": 8333.19, "timestamp": "02:18:53", "text": "そう、楽しもう"}, {"type": "subtitle", "time": 8336.389, "timestamp": "02:18:56", "text": "私たちの最善。視聴している皆さん"}, {"type": "subtitle", "time": 8337.83, "timestamp": "02:18:57", "text": "ご視聴ありがとうございました。"}]
[{"type": "subtitle", "time": 16320.07, "timestamp": "04:32:00", "text": "それ。わかった。私は21ヶ月目です"}, {"type": "subtitle", "time": 16324.189, "timestamp": "04:32:04", "text": "コースは7月開講。つまり合計で"}, {"type": "subtitle", "time": 16328.07, "timestamp": "04:32:08", "text": "397 750 それは、"}, {"type": "subtitle", "time": 16331.189, "timestamp": "04:32:11", "text": "学校関連の費用と授業料。それから"}, {"type": "subtitle", "time": 16335.349, "timestamp": "04:32:15", "text": "ドメトリー1を見ると、1%あたり1"}, {"type": "subtitle", "time": 16340.99, "timestamp": "04:32:20", "text": "1部屋あたり合計312,000円"}, {"type": "subtitle", "time": 16349.349, "timestamp": "04:32:29", "text": "1部屋2名につき2個。 2人用"}, {"type": "subtitle", "time": 16358.87, "timestamp": "04:32:38", "text": "エネルギー料金およびその他の個人支払い"}, {"type": "subtitle", "time": 16361.06, "timestamp": "04:32:41", "text": "そうみたいです。"}, {"type": "subtitle", "time": 16375.59, "timestamp": "04:32:55", "text": "うん。私は理解したい"}, {"type": "subtitle", "time": 16379.269, "timestamp": "04:32:59", "text": "ドメトリからストリームを出力できるが、"}]
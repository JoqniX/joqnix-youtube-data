[{"type": "subtitle", "time": 18961.83, "timestamp": "05:16:01", "text": "Discordチャンネルの設定だけと"}, {"type": "subtitle", "time": 18964.23, "timestamp": "05:16:04", "text": "人々はコメントから電話をかけてくるだろう"}, {"type": "subtitle", "time": 18969.11, "timestamp": "05:16:09", "text": "そのセクションで話し合いました。しかし、"}, {"type": "subtitle", "time": 18974.31, "timestamp": "05:16:14", "text": "この、えーと、トロールみたいなやつがやって来た"}, {"type": "subtitle", "time": 18976.39, "timestamp": "05:16:16", "text": "音声チャンネルで、彼は"}, {"type": "subtitle", "time": 18980.07, "timestamp": "05:16:20", "text": "不適切なプロフィールに超いいね"}, {"type": "subtitle", "time": 18981.788, "timestamp": "05:16:21", "text": "写真"}, {"type": "subtitle", "time": 18984.788, "timestamp": "05:16:24", "text": "そして彼らが言ったように、スーパー"}, {"type": "subtitle", "time": 18987.83, "timestamp": "05:16:27", "text": "不適切なもの"}, {"type": "subtitle", "time": 18990.708, "timestamp": "05:16:30", "text": "そして彼らは去っていった。"}, {"type": "subtitle", "time": 18992.47, "timestamp": "05:16:32", "text": "当ててみようか。それは人種差別だったのか、それとも"}, {"type": "subtitle", "time": 18995.11, "timestamp": "05:16:35", "text": "何か？はい。"}, {"type": "subtitle", "time": 19004.03, "timestamp": "05:16:44", "text": "つまり、それは"}, {"type": "subtitle", "time": 19008.31, "timestamp": "05:16:48", "text": "めったにないと思う、たまに"}, {"type": "subtitle", "time": 19010.628, "timestamp": "05:16:50", "text": "多分"}, {"type": "subtitle", "time": 19014.19, "timestamp": "05:16:54", "text": "私の場合、そういうことは1回か2回しか起こりません。"}, {"type": "subtitle", "time": 19018.628, "timestamp": "05:16:58", "text": "だから、それは悪い面でもある"}]
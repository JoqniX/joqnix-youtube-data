[{"type": "subtitle", "time": 21902.27, "timestamp": "06:05:02", "text": "ああ、なんてたくさんの子供たちだ。なぜ彼らは皆"}, {"type": "subtitle", "time": 21935.75, "timestamp": "06:05:35", "text": "これ？とにかく、えーと、切り替えます"}, {"type": "subtitle", "time": 21937.75, "timestamp": "06:05:37", "text": "新しいものにストリーミングする。 6時間です。"}, {"type": "subtitle", "time": 21943.11, "timestamp": "06:05:43", "text": "右？えっと、ちょっと切り替えてみますね。"}, {"type": "subtitle", "time": 21946.07, "timestamp": "06:05:46", "text": "PTの息子はできないと思う"}, {"type": "subtitle", "time": 21947.15, "timestamp": "06:05:47", "text": "作る"}, {"type": "subtitle", "time": 21950.708, "timestamp": "06:05:50", "text": "家族が彼女のそばにいるから"}, {"type": "subtitle", "time": 21953.43, "timestamp": "06:05:53", "text": "家。それで"}, {"type": "subtitle", "time": 21956.788, "timestamp": "06:05:56", "text": "彼女は自分の配信を終了せざるを得なかった。彼女"}, {"type": "subtitle", "time": 21959.83, "timestamp": "06:05:59", "text": "ストリーミング配信中でした。彼女は自分の"}]
[{"type": "subtitle", "time": 5595.07, "timestamp": "01:33:15", "text": "我花了10分鐘才進入"}, {"type": "subtitle", "time": 5598.39, "timestamp": "01:33:18", "text": "比賽狀態。"}, {"type": "subtitle", "time": 5615.669, "timestamp": "01:33:35", "text": "[幀左右了。你這穩重的運動員，兒子？ 我在學英國文學。我只專注於我自己的事情和其他我需要做的事情，因為這些也是我必須優先完成的事情。 所以[音樂]"}, {"type": "subtitle", "time": 5629.87, "timestamp": "01:33:49", "text": "[音樂]是的，我錯過了哦我的天哪。  動畫有點慢。我不知道為什麼中間會突然變得"}]
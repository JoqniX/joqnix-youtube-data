[{"type": "subtitle", "time": 16512.949, "timestamp": "04:35:12", "text": "在意。嗯。但是，呃，我剛來這裡的時候，我在"}, {"type": "subtitle", "time": 16528.15, "timestamp": "04:35:28", "text": "東京，但後來我搬到了福岡，這是另一個城市"}, {"type": "subtitle", "time": 16530.709, "timestamp": "04:35:30", "text": "。是的，就像，東京"}, {"type": "subtitle", "time": 16552.07, "timestamp": "04:35:52", "text": "有很多遊客，但也"}, {"type": "subtitle", "time": 16557.51, "timestamp": "04:35:57", "text": "沒那麼多。"}]
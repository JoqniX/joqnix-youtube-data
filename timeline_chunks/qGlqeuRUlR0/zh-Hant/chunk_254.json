[{"type": "subtitle", "time": 15247.149, "timestamp": "04:14:07", "text": "這是雙重的。兩個音樂人。又是一個漫長的夜晚。  [音樂] [音樂] [音樂] [音樂] 這很簡單，對吧，"}, {"type": "subtitle", "time": 15258.07, "timestamp": "04:14:18", "text": "兄弟？  你殺不死我。我是約翰·維克。  我是約翰·維卡。哦，等等。好的，等等"}, {"type": "subtitle", "time": 15269.07, "timestamp": "04:14:29", "text": "。  等等，他打"}]
[{"type": "subtitle", "time": 19925.99, "timestamp": "05:32:05", "text": "看待你"}, {"type": "subtitle", "time": 19929.19, "timestamp": "05:32:09", "text": "，就像"}, {"type": "subtitle", "time": 19930.948, "timestamp": "05:32:10", "text": "你之前說的，根據你的經驗。他們太瘋狂了。"}, {"type": "subtitle", "time": 19933.91, "timestamp": "05:32:13", "text": "他們會活下去。這樣你就能看出誰是真人，誰只是在玩鬧而已。"}, {"type": "subtitle", "time": 19947.67, "timestamp": "05:32:27", "text": "哈，這對我來說很難，我覺得我明智地盡力擺脫了一段有害的友誼，"}]
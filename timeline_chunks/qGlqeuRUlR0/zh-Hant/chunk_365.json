[{"type": "subtitle", "time": 21902.27, "timestamp": "06:05:02", "text": "為什麼會把這些話說出口呢"}, {"type": "subtitle", "time": 21935.75, "timestamp": "06:05:35", "text": "我就能收到"}, {"type": "subtitle", "time": 21937.75, "timestamp": "06:05:37", "text": "一秒鐘的實時更新。是的。"}, {"type": "subtitle", "time": 21946.07, "timestamp": "06:05:46", "text": "我的意思是，即使到了現在，我最終還是要為她"}, {"type": "subtitle", "time": 21956.788, "timestamp": "06:05:56", "text": "所做的改變付出代價。所以，嗯，讓我看看。他們提供的是過渡期限。"}]
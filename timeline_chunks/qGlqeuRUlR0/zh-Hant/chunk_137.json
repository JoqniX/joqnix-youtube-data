[{"type": "subtitle", "time": 8230.23, "timestamp": "02:17:10", "text": "鐵拳。等等，"}, {"type": "subtitle", "time": 8232.79, "timestamp": "02:17:12", "text": "我選第二個。哦，在《守望先鋒2》裡更大。哦，走吧。  我的天哪，我驚呆了。  我的天啊，我在擊碎"}, {"type": "subtitle", "time": 8235.429, "timestamp": "02:17:15", "text": "子彈。  不，不，不，不，不，隊友。"}, {"type": "subtitle", "time": 8257.509, "timestamp": "02:17:37", "text": "不，請讓我恢復"}, {"type": "subtitle", "time": 8259.91, "timestamp": "02:17:39", "text": "播放。  好的。呃"}]
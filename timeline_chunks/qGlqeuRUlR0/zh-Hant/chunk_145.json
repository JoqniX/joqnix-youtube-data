[{"type": "subtitle", "time": 8718.309, "timestamp": "02:25:18", "text": "零食都吃光的產物"}, {"type": "subtitle", "time": 8722.55, "timestamp": "02:25:22", "text": "。我會負責這裡。  糟了，他來了。他拿到了肉。他拿到了肉。  為什麼？"}, {"type": "subtitle", "time": 8732.91, "timestamp": "02:25:32", "text": "我的天啊。他拿到了肉。"}, {"type": "subtitle", "time": 8738.27, "timestamp": "02:25:38", "text": "什麼？  沒有人這樣做。我的天啊。  我在躲藏"}, {"type": "subtitle", "time": 8748.469, "timestamp": "02:25:48", "text": "。"}]
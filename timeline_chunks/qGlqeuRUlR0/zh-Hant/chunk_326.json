[{"type": "subtitle", "time": 19562.59, "timestamp": "05:26:02", "text": "創投公司，結果沒多久，他就在"}, {"type": "subtitle", "time": 19565.51, "timestamp": "05:26:05", "text": "合夥人面前貶低我，還做了其他種種事情。我當時就想，我該怎麼辦？"}, {"type": "subtitle", "time": 19602.708, "timestamp": "05:26:42", "text": "我當時並沒有察覺。 Jo，他明明知道自己很敏感之類的。 ，因為我想，如果同樣的事情再次發生，我能不能再經歷那種情況？道，"}, {"type": "subtitle", "time": 19606.15, "timestamp": "05:26:46", "text": "我"}, {"type": "subtitle", "time": 19609.11, "timestamp": "05:26:49", "text": "猜我是個討好型"}]
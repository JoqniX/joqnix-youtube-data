[{"type": "subtitle", "time": 21245.51, "timestamp": "05:54:05", "text": "液態咖哩之類的東西呢？"}, {"type": "subtitle", "time": 21260.948, "timestamp": "05:54:20", "text": "吧？ 例如液態咖哩之類的"}, {"type": "subtitle", "time": 21265.03, "timestamp": "05:54:25", "text": "東西。嗯，我的意思是，"}, {"type": "subtitle", "time": 21282.548, "timestamp": "05:54:42", "text": "我覺得你可以找到咖哩粉之類的東西，比如咖哩包。你會沒事的。 哦，是的。脫脂奶粉。不過，你也能找到各種口味的"}, {"type": "subtitle", "time": 21286.708, "timestamp": "05:54:46", "text": "酸奶昔，比如無味的那種。"}]
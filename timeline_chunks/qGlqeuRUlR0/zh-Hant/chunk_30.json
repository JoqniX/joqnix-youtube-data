[{"type": "subtitle", "time": 1805.669, "timestamp": "00:30:05", "text": "我今天一切都好。  是的。啊。我的天啊。我死得悄無聲息。耶。我來晚了。我殺了他們。"}, {"type": "subtitle", "time": 1821.95, "timestamp": "00:30:21", "text": "，他殺了他們。  我的天啊。"}, {"type": "subtitle", "time": 1834.99, "timestamp": "00:30:34", "text": "你是怎麼做到的？他是怎麼做到的？[音樂][音樂]我對他使用了我的終極技能。"}]
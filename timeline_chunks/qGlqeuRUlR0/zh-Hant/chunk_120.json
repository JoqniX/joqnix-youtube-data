[{"type": "subtitle", "time": 7205.35, "timestamp": "02:00:05", "text": "好吧，"}, {"type": "subtitle", "time": 7230.51, "timestamp": "02:00:30", "text": "我們就等著有人死吧。"}, {"type": "subtitle", "time": 7233.83, "timestamp": "02:00:33", "text": "好的。阿卡比，過來一下。過來。  過來。過來。過來。阿比，快來快來。來戲弄我吧。來戲弄我。"}, {"type": "subtitle", "time": 7244.87, "timestamp": "02:00:44", "text": "呃，這是個需要連接手機的遊戲嗎？他們說了什麼嗎？"}]
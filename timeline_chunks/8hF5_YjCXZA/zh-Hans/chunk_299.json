[{"type": "subtitle", "time": 17941.11, "timestamp": "04:59:01", "text": "因为我想在线上进行这艘船的建造。"}, {"type": "subtitle", "time": 17945.03, "timestamp": "04:59:05", "text": "商店那边，然后他们转发了"}, {"type": "subtitle", "time": 17948.07, "timestamp": "04:59:08", "text": "对我来说，这，呃，人们称之为"}, {"type": "subtitle", "time": 17950.628, "timestamp": "04:59:10", "text": "注册 Ko 先生的人，他们打电话"}, {"type": "subtitle", "time": 17956.15, "timestamp": "04:59:16", "text": "我和他们当时就说，呃，是3000，"}, {"type": "subtitle", "time": 17957.75, "timestamp": "04:59:17", "text": "呃"}, {"type": "subtitle", "time": 17959.91, "timestamp": "04:59:19", "text": "所有的文件和所有东西"}, {"type": "subtitle", "time": 17963.35, "timestamp": "04:59:23", "text": "将在15至20天内完成。"}, {"type": "subtitle", "time": 17964.948, "timestamp": "04:59:24", "text": "一切。他们就像在说你"}, {"type": "subtitle", "time": 17968.55, "timestamp": "04:59:28", "text": "今天得付3000块钱之类的。然后"}, {"type": "subtitle", "time": 17970.868, "timestamp": "04:59:30", "text": "我当时就想，我有点缺钱。我"}, {"type": "subtitle", "time": 17973.43, "timestamp": "04:59:33", "text": "我的UPI账户里没钱了，银行"}, {"type": "subtitle", "time": 17975.27, "timestamp": "04:59:35", "text": "帐户。我持有现金。"}, {"type": "subtitle", "time": 17977.83, "timestamp": "04:59:37", "text": "一切。我算是问了问"}, {"type": "subtitle", "time": 17979.91, "timestamp": "04:59:39", "text": "安装等等。他们只能"}, {"type": "subtitle", "time": 17981.91, "timestamp": "04:59:41", "text": "做2000次。"}, {"type": "subtitle", "time": 17985.19, "timestamp": "04:59:45", "text": "然后，之后他们说，就像"}, {"type": "subtitle", "time": 17987.03, "timestamp": "04:59:47", "text": "他们好像在告诉我，你必须这样做"}, {"type": "subtitle", "time": 17989.11, "timestamp": "04:59:49", "text": "今天就买。今天这种事。我当时"}, {"type": "subtitle", "time": 17992.788, "timestamp": "04:59:52", "text": "好吧，下午3点到4点。我愿意做。然后"}, {"type": "subtitle", "time": 17996.47, "timestamp": "04:59:56", "text": "之后他们又给我打电话了。"}]
[{"type": "subtitle", "time": 15551.349, "timestamp": "04:19:11", "text": "不，我不会那样做，因为问题是……"}, {"type": "subtitle", "time": 15554.87, "timestamp": "04:19:14", "text": "我只有在以下情况下才能选择 SER 服务："}, {"type": "subtitle", "time": 15559.03, "timestamp": "04:19:19", "text": "如果他们是正规的，那它就在那里。"}, {"type": "subtitle", "time": 15561.75, "timestamp": "04:19:21", "text": "他们先拿到钱，然后才去做事。"}, {"type": "subtitle", "time": 15564.07, "timestamp": "04:19:24", "text": "你知道吗，我已经被骗过了。"}, {"type": "subtitle", "time": 15566.07, "timestamp": "04:19:26", "text": "在我的生活中。我不想被骗。"}, {"type": "subtitle", "time": 15583.349, "timestamp": "04:19:43", "text": "问题是"}, {"type": "subtitle", "time": 15587.75, "timestamp": "04:19:47", "text": "我自己也不清楚。真糟糕。我是说，"}, {"type": "subtitle", "time": 15590.55, "timestamp": "04:19:50", "text": "至少，我很高兴我曾经拥有过。"}, {"type": "subtitle", "time": 15593.189, "timestamp": "04:19:53", "text": "你们可以问问这个问题。想象一下如果我"}, {"type": "subtitle", "time": 15596.95, "timestamp": "04:19:56", "text": "事先没有询问就做了。天哪，他们"}, {"type": "subtitle", "time": 15599.11, "timestamp": "04:19:59", "text": "甚至还提到了周转时间之类的事情"}]
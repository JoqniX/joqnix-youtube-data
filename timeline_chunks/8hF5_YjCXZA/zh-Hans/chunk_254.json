[{"type": "subtitle", "time": 15249.349, "timestamp": "04:14:09", "text": "但我担心的是……"}, {"type": "subtitle", "time": 15252.55, "timestamp": "04:14:12", "text": "如果他们告诉我呢？"}, {"type": "subtitle", "time": 15255.429, "timestamp": "04:14:15", "text": "如果他们……比如说我付了3000美元呢？"}, {"type": "subtitle", "time": 15257.269, "timestamp": "04:14:17", "text": "一切都很好，然后一切就都好了。"}, {"type": "subtitle", "time": 15259.03, "timestamp": "04:14:19", "text": "他们来找我说你必须付钱"}, {"type": "subtitle", "time": 15261.269, "timestamp": "04:14:21", "text": "16,000"}, {"type": "subtitle", "time": 15263.91, "timestamp": "04:14:23", "text": "报税之类的事情我该怎么办？"}, {"type": "subtitle", "time": 15266.07, "timestamp": "04:14:26", "text": "我将在哪里获得我应得的钱"}, {"type": "subtitle", "time": 15283.75, "timestamp": "04:14:43", "text": "这有点像，"}, {"type": "subtitle", "time": 15286.149, "timestamp": "04:14:46", "text": "兄弟，为什么邮件发不出去？什么"}, {"type": "subtitle", "time": 15289.189, "timestamp": "04:14:49", "text": "搞什么鬼？等待，"}, {"type": "subtitle", "time": 15293.99, "timestamp": "04:14:53", "text": "到"}]
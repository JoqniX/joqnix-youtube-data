[{"type": "subtitle", "time": 17220.948, "timestamp": "04:47:00", "text": "我的药在哪儿来着？"}, {"type": "subtitle", "time": 17223.11, "timestamp": "04:47:03", "text": "我昨天买的吗？哦，那"}, {"type": "subtitle", "time": 17231.19, "timestamp": "04:47:11", "text": "[音乐]"}, {"type": "subtitle", "time": 17237.83, "timestamp": "04:47:17", "text": "想复制你的脸吗？就这么说"}, {"type": "subtitle", "time": 17241.75, "timestamp": "04:47:21", "text": "那。好的。希望情况不会太糟。你"}, {"type": "subtitle", "time": 17245.03, "timestamp": "04:47:25", "text": "认识我。好的。给我一段复制粘贴的文字"}, {"type": "subtitle", "time": 17250.868, "timestamp": "04:47:30", "text": "对我来说，这就是我想要表达的方式。"}, {"type": "subtitle", "time": 17254.07, "timestamp": "04:47:34", "text": "性格温和但不那么咄咄逼人"}, {"type": "subtitle", "time": 17256.39, "timestamp": "04:47:36", "text": "理解"}, {"type": "subtitle", "time": 17259.67, "timestamp": "04:47:39", "text": "呃，类型。他"}, {"type": "subtitle", "time": 17268.47, "timestamp": "04:47:48", "text": "对不起。如果是的话，我可以练习吗？"}, {"type": "subtitle", "time": 17270.628, "timestamp": "04:47:50", "text": "好的？"}]
[{"type": "subtitle", "time": 20885.03, "timestamp": "05:48:05", "text": "撤销。好的。呃"}, {"type": "subtitle", "time": 20889.27, "timestamp": "05:48:09", "text": "看得清了。好的。等待。如果什么"}, {"type": "subtitle", "time": 20892.47, "timestamp": "05:48:12", "text": "我可以要一份样品吗？"}, {"type": "subtitle", "time": 20894.47, "timestamp": "05:48:14", "text": "它是量化的吗？"}, {"type": "subtitle", "time": 20896.788, "timestamp": "05:48:16", "text": "它不是。好的。"}, {"type": "subtitle", "time": 20899.91, "timestamp": "05:48:19", "text": "顺便说一句，祝你一切顺利！"}, {"type": "subtitle", "time": 20915.91, "timestamp": "05:48:35", "text": "你可以这样做。这就是你如何发声。"}, {"type": "subtitle", "time": 20920.23, "timestamp": "05:48:40", "text": "顺便一提，是排骨。切片。啊，"}, {"type": "subtitle", "time": 20923.11, "timestamp": "05:48:43", "text": "事情不是那样运作的。好的，我们"}, {"type": "subtitle", "time": 20925.67, "timestamp": "05:48:45", "text": "我做不到。"}, {"type": "subtitle", "time": 20930.07, "timestamp": "05:48:50", "text": "呃，我们可以做一些类似的事情"}, {"type": "subtitle", "time": 20933.19, "timestamp": "05:48:53", "text": "我可以改变声音，但我该不该这么做呢？"}, {"type": "subtitle", "time": 20937.83, "timestamp": "05:48:57", "text": "必须这么做吗？我不知道。"}]
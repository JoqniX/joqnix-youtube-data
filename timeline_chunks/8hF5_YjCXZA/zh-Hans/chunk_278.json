[{"type": "subtitle", "time": 16684.15, "timestamp": "04:38:04", "text": "别在意那个手。"}, {"type": "subtitle", "time": 16704.869, "timestamp": "04:38:24", "text": "太多事情了。呃，我的手不得不"}, {"type": "subtitle", "time": 16707.59, "timestamp": "04:38:27", "text": "也会被烧伤，"}, {"type": "subtitle", "time": 16717.189, "timestamp": "04:38:37", "text": "我只是我我我笨笨地像个傻瓜一样说"}, {"type": "subtitle", "time": 16721.99, "timestamp": "04:38:41", "text": "塑料杯，而水……"}, {"type": "subtitle", "time": 16724.709, "timestamp": "04:38:44", "text": "用大水壶加热，大水壶，大"}, {"type": "subtitle", "time": 16728.23, "timestamp": "04:38:48", "text": "用具。我把它放进去，然后我进入了雾中。"}, {"type": "subtitle", "time": 16732.07, "timestamp": "04:38:52", "text": "不要让水蒸气起雾，对吧？"}, {"type": "subtitle", "time": 16737.67, "timestamp": "04:38:57", "text": "呃，雾气之类的东西。天气非常热，我"}]
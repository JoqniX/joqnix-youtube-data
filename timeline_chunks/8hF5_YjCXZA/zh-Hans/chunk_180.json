[{"type": "subtitle", "time": 10803.269, "timestamp": "03:00:03", "text": "[音乐]"}, {"type": "subtitle", "time": 10806.15, "timestamp": "03:00:06", "text": "在我们深入探讨之前"}, {"type": "subtitle", "time": 10808.79, "timestamp": "03:00:08", "text": "溪流，"}, {"type": "subtitle", "time": 10811.59, "timestamp": "03:00:11", "text": "让我确认一下"}, {"type": "subtitle", "time": 10814.15, "timestamp": "03:00:14", "text": "我不会碰自己或任何东西。任何"}, {"type": "subtitle", "time": 10816.15, "timestamp": "03:00:16", "text": "任何事物？"}, {"type": "subtitle", "time": 10818.55, "timestamp": "03:00:18", "text": "呃，这是真正的相机，对吧？想象"}, {"type": "subtitle", "time": 10822.07, "timestamp": "03:00:22", "text": "如果我不小心点到了音乐。我"}, {"type": "subtitle", "time": 10826.55, "timestamp": "03:00:26", "text": "点击这个东西。我的天哪，我会"}, {"type": "subtitle", "time": 10830.55, "timestamp": "03:00:30", "text": "死。如果我"}, {"type": "subtitle", "time": 10833.19, "timestamp": "03:00:33", "text": "希望我的脸没露出来。"}, {"type": "subtitle", "time": 10842.63, "timestamp": "03:00:42", "text": "它应该会弹出。它应该会弹出。"}, {"type": "subtitle", "time": 10857.51, "timestamp": "03:00:57", "text": "我的手机语音评论。"}]
[{"type": "subtitle", "time": 5046.31, "timestamp": "01:24:06", "text": "不，这些人没有给我……"}, {"type": "subtitle", "time": 5053.43, "timestamp": "01:24:13", "text": "你不能通过一些批评来改变这一点"}, {"type": "subtitle", "time": 5054.95, "timestamp": "01:24:14", "text": "接触。"}, {"type": "subtitle", "time": 5056.47, "timestamp": "01:24:16", "text": "有些创作者会改变业务。"}, {"type": "subtitle", "time": 5060.47, "timestamp": "01:24:20", "text": "仅用于联系客户的姓名。"}, {"type": "subtitle", "time": 5063.189, "timestamp": "01:24:23", "text": "呃，看看设置。看看这身打扮。"}, {"type": "subtitle", "time": 5065.59, "timestamp": "01:24:25", "text": "好的。好的。橡皮擦支付左账户和"}, {"type": "subtitle", "time": 5067.189, "timestamp": "01:24:27", "text": "设置。查看设置。查看"}, {"type": "subtitle", "time": 5069.11, "timestamp": "01:24:29", "text": "造型。好的。好的。那我稍后回来"}, {"type": "subtitle", "time": 5071.51, "timestamp": "01:24:31", "text": "稍后。一秒钟。呃账户"}, {"type": "subtitle", "time": 5073.27, "timestamp": "01:24:33", "text": "设置。"}, {"type": "subtitle", "time": 5075.43, "timestamp": "01:24:35", "text": "呃，结账，结账，结账，结账"}, {"type": "subtitle", "time": 5079.669, "timestamp": "01:24:39", "text": "出去看看造型。好的。"}]
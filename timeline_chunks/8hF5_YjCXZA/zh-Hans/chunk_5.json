[{"type": "subtitle", "time": 306.71, "timestamp": "00:05:06", "text": "再一次，我会是哦，天哪，飞蛾"}, {"type": "subtitle", "time": 308.629, "timestamp": "00:05:08", "text": "就在这里。飞蛾来了。你们"}, {"type": "subtitle", "time": 311.99, "timestamp": "00:05:11", "text": "看到了吗？魔力来了。哦，天哪，我"}, {"type": "subtitle", "time": 313.59, "timestamp": "00:05:13", "text": "杀了他。我要杀了他。过来，"}, {"type": "subtitle", "time": 317.35, "timestamp": "00:05:17", "text": "男生。我死了"}, {"type": "subtitle", "time": 331.27, "timestamp": "00:05:31", "text": "天哪，我走了。我走了。我要去。"}, {"type": "subtitle", "time": 333.99, "timestamp": "00:05:33", "text": "感谢上帝，蚊子来了，蝙蝠来了"}, {"type": "subtitle", "time": 336.07, "timestamp": "00:05:36", "text": "为了节省开支。"}, {"type": "subtitle", "time": 339.67, "timestamp": "00:05:39", "text": "看看他被烤成什么样了。"}, {"type": "subtitle", "time": 342.87, "timestamp": "00:05:42", "text": "这就是你将得到的。哦，"}, {"type": "subtitle", "time": 347.909, "timestamp": "00:05:47", "text": "就像接近我的笨蛋一样。"}, {"type": "subtitle", "time": 350.71, "timestamp": "00:05:50", "text": "我好害怕，万一……"}, {"type": "subtitle", "time": 353.83, "timestamp": "00:05:53", "text": "吃昆虫之类的吗？"}, {"type": "subtitle", "time": 355.99, "timestamp": "00:05:55", "text": "将会发生什么？"}, {"type": "subtitle", "time": 358.15, "timestamp": "00:05:58", "text": "我害怕那个二极管。那就是"}]
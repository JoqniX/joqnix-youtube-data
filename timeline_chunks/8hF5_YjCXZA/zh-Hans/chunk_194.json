[{"type": "subtitle", "time": 11641.03, "timestamp": "03:14:01", "text": "就像买个便宜的鼠标一样，但是"}, {"type": "subtitle", "time": 11644.229, "timestamp": "03:14:04", "text": "因为这件东西，Razor"}, {"type": "subtitle", "time": 11646.79, "timestamp": "03:14:06", "text": "第二代机械鼠标开关"}, {"type": "subtitle", "time": 11649.51, "timestamp": "03:14:09", "text": "这意味着不会出现双击问题，而且"}, {"type": "subtitle", "time": 11652.55, "timestamp": "03:14:12", "text": "我目前鼠标的问题是……"}, {"type": "subtitle", "time": 11654.469, "timestamp": "03:14:14", "text": "我一直遇到双击问题，"}, {"type": "subtitle", "time": 11657.75, "timestamp": "03:14:17", "text": "东西。所以这就是我为什么认为无线"}, {"type": "subtitle", "time": 11660.71, "timestamp": "03:14:20", "text": "会好起来的。不，"}, {"type": "subtitle", "time": 11663.51, "timestamp": "03:14:23", "text": "我们得把电池之类的东西装上去。 AAA"}, {"type": "subtitle", "time": 11665.51, "timestamp": "03:14:25", "text": "电池。"}, {"type": "subtitle", "time": 11667.19, "timestamp": "03:14:27", "text": "好的。"}, {"type": "subtitle", "time": 11671.269, "timestamp": "03:14:31", "text": "是的，这些就是我买的东西。"}, {"type": "subtitle", "time": 11673.99, "timestamp": "03:14:33", "text": "我周四之前就能收到。"}, {"type": "subtitle", "time": 11676.55, "timestamp": "03:14:36", "text": "周三。"}, {"type": "subtitle", "time": 11679.67, "timestamp": "03:14:39", "text": "有薪酬的。我的银行账户快空了。"}, {"type": "subtitle", "time": 11683.03, "timestamp": "03:14:43", "text": "你只有像我真的只有"}, {"type": "subtitle", "time": 11686.309, "timestamp": "03:14:46", "text": "还剩大约4K。所以，我不是"}, {"type": "subtitle", "time": 11690.63, "timestamp": "03:14:50", "text": "应该完全用完它"}, {"type": "subtitle", "time": 11693.91, "timestamp": "03:14:53", "text": "因为我得活过这个月。"}, {"type": "subtitle", "time": 11695.99, "timestamp": "03:14:55", "text": "呃"}, {"type": "subtitle", "time": 11699.67, "timestamp": "03:14:59", "text": "但是，是的，我已经花了大约6000块钱了。"}]
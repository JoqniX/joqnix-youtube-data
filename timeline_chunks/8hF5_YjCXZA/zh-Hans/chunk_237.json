[{"type": "subtitle", "time": 14227.99, "timestamp": "03:57:07", "text": "但就像说“想想看”一样"}, {"type": "subtitle", "time": 14230.15, "timestamp": "03:57:10", "text": "我这边也是如此。比如我付钱给你"}, {"type": "subtitle", "time": 14232.63, "timestamp": "03:57:12", "text": "2000，假设我没有收到。"}, {"type": "subtitle", "time": 14234.79, "timestamp": "03:57:14", "text": "任何东西，你仍然会得到"}]
[{"type": "subtitle", "time": 11101.03, "timestamp": "03:05:01", "text": "是我错觉吗？哦，是的。饲料是"}, {"type": "subtitle", "time": 11103.67, "timestamp": "03:05:03", "text": "卡住。进料口堵塞了。"}, {"type": "subtitle", "time": 11105.83, "timestamp": "03:05:05", "text": "好吧，我的错。"}, {"type": "subtitle", "time": 11108.63, "timestamp": "03:05:08", "text": "呃，视频流卡住了。好了，就是这样。"}, {"type": "subtitle", "time": 11111.19, "timestamp": "03:05:11", "text": "去。"}, {"type": "subtitle", "time": 11115.19, "timestamp": "03:05:15", "text": "别学我。过度喂养的英雄。我想"}, {"type": "subtitle", "time": 11146.95, "timestamp": "03:05:46", "text": "有一个大"}, {"type": "subtitle", "time": 11149.269, "timestamp": "03:05:49", "text": "洞"}, {"type": "subtitle", "time": 11152.95, "timestamp": "03:05:52", "text": "这样我们就知道我把它旋转到哪里了。好的，"}, {"type": "subtitle", "time": 11155.67, "timestamp": "03:05:55", "text": "现在我们可以看到右边"}]
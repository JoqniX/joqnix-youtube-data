[{"type": "subtitle", "time": 16325.03, "timestamp": "04:32:05", "text": "[音乐]"}, {"type": "subtitle", "time": 16327.99, "timestamp": "04:32:07", "text": "我觉得这都是网络因素造成的。为什么"}, {"type": "subtitle", "time": 16341.429, "timestamp": "04:32:21", "text": "人们为什么会进行诈骗？你为什么不能……"}, {"type": "subtitle", "time": 16343.03, "timestamp": "04:32:23", "text": "真的？"}, {"type": "subtitle", "time": 16345.67, "timestamp": "04:32:25", "text": "人们为什么会行骗？"}, {"type": "subtitle", "time": 16348.389, "timestamp": "04:32:28", "text": "为什么？你能得到什么好处？你怎么能……"}, {"type": "subtitle", "time": 16351.189, "timestamp": "04:32:31", "text": "骗子骗了人，晚上还能睡得着觉吗？"}, {"type": "subtitle", "time": 16355.11, "timestamp": "04:32:35", "text": "某个人？我总是会想到这件事。"}, {"type": "subtitle", "time": 16357.349, "timestamp": "04:32:37", "text": "当我观看这个印度骗子的视频时"}, {"type": "subtitle", "time": 16361.59, "timestamp": "04:32:41", "text": "在 YouTube 上。现在我感到很难过，我该如何面对这一切？"}, {"type": "subtitle", "time": 16364.309, "timestamp": "04:32:44", "text": "他们晚上睡觉"}, {"type": "subtitle", "time": 16367.349, "timestamp": "04:32:47", "text": "还有别的什么？"}, {"type": "subtitle", "time": 16370.87, "timestamp": "04:32:50", "text": "我当然会哭"}, {"type": "subtitle", "time": 16373.67, "timestamp": "04:32:53", "text": "带着愧疚感或其他什么感觉。如果我"}, {"type": "subtitle", "time": 16376.07, "timestamp": "04:32:56", "text": "诈骗任何人"}, {"type": "subtitle", "time": 16378.79, "timestamp": "04:32:58", "text": "那我还是会想办法回到他们身边。"}]
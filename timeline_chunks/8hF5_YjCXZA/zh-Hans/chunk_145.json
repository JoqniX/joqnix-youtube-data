[{"type": "subtitle", "time": 8700.71, "timestamp": "02:25:00", "text": "去海岛旅行怎么样？"}, {"type": "subtitle", "time": 8702.87, "timestamp": "02:25:02", "text": "爷爷一直很喜欢去那里。"}, {"type": "subtitle", "time": 8704.71, "timestamp": "02:25:04", "text": "好的。外面到底有什么？出色地，"}, {"type": "subtitle", "time": 8706.15, "timestamp": "02:25:06", "text": "那里有很多鱼可以钓。"}, {"type": "subtitle", "time": 8707.99, "timestamp": "02:25:07", "text": "至少。"}, {"type": "subtitle", "time": 8711.91, "timestamp": "02:25:11", "text": "你什么时候吃饭？呃，在呃"}, {"type": "subtitle", "time": 8714.55, "timestamp": "02:25:14", "text": "1:00。"}, {"type": "subtitle", "time": 8717.67, "timestamp": "02:25:17", "text": "我会等东西到货。呃，"}, {"type": "subtitle", "time": 8721.19, "timestamp": "02:25:21", "text": "仙人。欢迎来到汝拉岛。"}, {"type": "subtitle", "time": 8722.79, "timestamp": "02:25:22", "text": "幸好它很小。"}, {"type": "subtitle", "time": 8725.75, "timestamp": "02:25:25", "text": "过马路。通常情况下，数量要多得多。"}, {"type": "subtitle", "time": 8732.63, "timestamp": "02:25:32", "text": "嗯，"}, {"type": "subtitle", "time": 8735.11, "timestamp": "02:25:35", "text": "总之，你说你还没见过……"}, {"type": "subtitle", "time": 8738.87, "timestamp": "02:25:38", "text": "爷爷的老朋友。"}, {"type": "subtitle", "time": 8741.83, "timestamp": "02:25:41", "text": "我来这里是为了完成我的生物学课程。"}, {"type": "subtitle", "time": 8743.91, "timestamp": "02:25:43", "text": "不知道"}, {"type": "subtitle", "time": 8746.389, "timestamp": "02:25:46", "text": "是的，这座岛屿。湖。那是"}, {"type": "subtitle", "time": 8749.51, "timestamp": "02:25:49", "text": "之一"}, {"type": "subtitle", "time": 8751.91, "timestamp": "02:25:51", "text": "探索"}, {"type": "subtitle", "time": 8754.71, "timestamp": "02:25:54", "text": "我就在这里。好的。"}]
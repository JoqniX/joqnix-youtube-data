[{"type": "subtitle", "time": 15602.229, "timestamp": "04:20:02", "text": "句号之类的。嗯，就像甚至"}, {"type": "subtitle", "time": 15603.91, "timestamp": "04:20:03", "text": "付款等手续办完后，他们会添加"}, {"type": "subtitle", "time": 15605.51, "timestamp": "04:20:05", "text": "我被拉进了一个WhatsApp群组，等等。"}, {"type": "subtitle", "time": 15608.71, "timestamp": "04:20:08", "text": "呃，我得和那些人谈谈。"}, {"type": "subtitle", "time": 15610.87, "timestamp": "04:20:10", "text": "他们会安排好法律事宜，"}, {"type": "subtitle", "time": 15613.75, "timestamp": "04:20:13", "text": "一切。而且还有大约10个小时"}, {"type": "subtitle", "time": 15616.71, "timestamp": "04:20:16", "text": "时间段，比如，呃，两小时后"}, {"type": "subtitle", "time": 15619.51, "timestamp": "04:20:19", "text": "或者他们会继续做其他事情。他们必须"}, {"type": "subtitle", "time": 15621.67, "timestamp": "04:20:21", "text": "专注于其他客户和其他事情"}, {"type": "subtitle", "time": 15624.63, "timestamp": "04:20:24", "text": "诸如此类的事情"}, {"type": "subtitle", "time": 15628.149, "timestamp": "04:20:28", "text": "就像你必须与专业人士沟通一样"}, {"type": "subtitle", "time": 15629.99, "timestamp": "04:20:29", "text": "正规渠道或其他什么"}, {"type": "subtitle", "time": 15637.59, "timestamp": "04:20:37", "text": "写负面评论的人"}, {"type": "subtitle", "time": 15640.79, "timestamp": "04:20:40", "text": "呃，你为什么老是跟人说这些？"}, {"type": "subtitle", "time": 15642.55, "timestamp": "04:20:42", "text": "关于频道，我没说过关于黑暗的事情。"}, {"type": "subtitle", "time": 15646.469, "timestamp": "04:20:46", "text": "脖子，我刚才说，我刚才说"}, {"type": "subtitle", "time": 15650.229, "timestamp": "04:20:50", "text": "我想要的只是一个UPI用户名，但是"}, {"type": "subtitle", "time": 15653.269, "timestamp": "04:20:53", "text": "我不想，我不想拥有我的真实"}, {"type": "subtitle", "time": 15655.11, "timestamp": "04:20:55", "text": "名字写在里面。我必须拥有我"}, {"type": "subtitle", "time": 15657.67, "timestamp": "04:20:57", "text": "只希望它是 mos。我没有说我的"}, {"type": "subtitle", "time": 15659.91, "timestamp": "04:20:59", "text": "频道之类的东西。"}]
[{"type": "subtitle", "time": 15722.63, "timestamp": "04:22:02", "text": "呃，给了我一个类似 raer pay 的链接或者"}, {"type": "subtitle", "time": 15725.51, "timestamp": "04:22:05", "text": "某物和"}, {"type": "subtitle", "time": 15727.59, "timestamp": "04:22:07", "text": "他们不停地询问模式"}, {"type": "subtitle", "time": 15730.55, "timestamp": "04:22:10", "text": "支付。"}, {"type": "subtitle", "time": 15732.55, "timestamp": "04:22:12", "text": "我们为什么关注观看"}, {"type": "subtitle", "time": 15736.149, "timestamp": "04:22:16", "text": "溪流？哦，是的。哦，不。因为因为"}, {"type": "subtitle", "time": 15739.99, "timestamp": "04:22:19", "text": "Racer pay 我把我的账户名填成了"}, {"type": "subtitle", "time": 15742.55, "timestamp": "04:22:22", "text": "Jocnex。"}, {"type": "subtitle", "time": 15745.59, "timestamp": "04:22:25", "text": "是的。账户名为 Joex。因为怎么会这样"}, {"type": "subtitle", "time": 15748.71, "timestamp": "04:22:28", "text": "他们拿到我的电话号码了吗？赛车手支付"}, {"type": "subtitle", "time": 15751.03, "timestamp": "04:22:31", "text": "该网站已将此信息分享给这些公司。"}, {"type": "subtitle", "time": 15754.229, "timestamp": "04:22:34", "text": "正确的？他们也会和我共享我的名字。"}, {"type": "subtitle", "time": 15757.429, "timestamp": "04:22:37", "text": "我的小玩意儿，对吧？"}, {"type": "subtitle", "time": 15760.71, "timestamp": "04:22:40", "text": "好好想想。"}, {"type": "subtitle", "time": 15763.51, "timestamp": "04:22:43", "text": "所以，我担心他们会不会再次核实"}, {"type": "subtitle", "time": 15767.11, "timestamp": "04:22:47", "text": "那个假名到底是什么，以及其他所有细节。"}, {"type": "subtitle", "time": 15770.55, "timestamp": "04:22:50", "text": "如果他们检查了那个，然后发现……"}, {"type": "subtitle", "time": 15772.79, "timestamp": "04:22:52", "text": "在直播中看到他们和我说话"}, {"type": "subtitle", "time": 15775.429, "timestamp": "04:22:55", "text": "他们是不是在直播什么的？"}, {"type": "subtitle", "time": 15778.07, "timestamp": "04:22:58", "text": "这就是我担心的原因。谁知道呢"}]
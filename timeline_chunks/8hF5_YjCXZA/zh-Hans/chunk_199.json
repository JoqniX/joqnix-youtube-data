[{"type": "subtitle", "time": 11945.91, "timestamp": "03:19:05", "text": "我们能来吗？我想喂她，但是"}, {"type": "subtitle", "time": 11947.59, "timestamp": "03:19:07", "text": "我不被允许这样做。没有。为什么是"}, {"type": "subtitle", "time": 11951.03, "timestamp": "03:19:11", "text": "你不允许吗？"}, {"type": "subtitle", "time": 11953.73, "timestamp": "03:19:13", "text": "为什么不允许你这样做？"}, {"type": "subtitle", "time": 11956.55, "timestamp": "03:19:16", "text": "[音乐]"}, {"type": "subtitle", "time": 11960.54, "timestamp": "03:19:20", "text": "好的。好的，我需要"}, {"type": "subtitle", "time": 11963.269, "timestamp": "03:19:23", "text": "[音乐]"}, {"type": "subtitle", "time": 11965.03, "timestamp": "03:19:25", "text": "呃"}, {"type": "subtitle", "time": 11969.99, "timestamp": "03:19:29", "text": "登录我的账户。我的天啊。"}, {"type": "subtitle", "time": 11972.87, "timestamp": "03:19:32", "text": "好的，"}, {"type": "subtitle", "time": 11975.03, "timestamp": "03:19:35", "text": "嗯"}, {"type": "subtitle", "time": 11977.67, "timestamp": "03:19:37", "text": "他在哪儿？"}, {"type": "subtitle", "time": 11980.63, "timestamp": "03:19:40", "text": "这个。"}, {"type": "subtitle", "time": 11982.95, "timestamp": "03:19:42", "text": "不，他是最近才关注我的。"}, {"type": "subtitle", "time": 11985.11, "timestamp": "03:19:45", "text": "正确的？"}, {"type": "subtitle", "time": 11988.309, "timestamp": "03:19:48", "text": "好的，等等。跟随。"}, {"type": "subtitle", "time": 11991.349, "timestamp": "03:19:51", "text": "我的天啊，我该如何找到“我的天啊”？在哪里"}, {"type": "subtitle", "time": 11992.95, "timestamp": "03:19:52", "text": "是"}, {"type": "subtitle", "time": 11997.4, "timestamp": "03:19:57", "text": "圣主啊？在哪里？我该如何找到"}, {"type": "subtitle", "time": 11999.269, "timestamp": "03:19:59", "text": "[音乐]"}]
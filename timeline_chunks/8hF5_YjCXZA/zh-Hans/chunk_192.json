[{"type": "subtitle", "time": 11524.55, "timestamp": "03:12:04", "text": "还有，呃，当它达到12的时候，就是……"}, {"type": "subtitle", "time": 11527.51, "timestamp": "03:12:07", "text": "今天是房东孩子的生日"}, {"type": "subtitle", "time": 11532.87, "timestamp": "03:12:12", "text": "明天。我的意思是，7月11日。"}, {"type": "subtitle", "time": 11535.75, "timestamp": "03:12:15", "text": "我得祝他生日快乐。他"}, {"type": "subtitle", "time": 11546.15, "timestamp": "03:12:26", "text": "[音乐]"}, {"type": "subtitle", "time": 11549.51, "timestamp": "03:12:29", "text": "幸好我把屏幕模糊处理了。"}, {"type": "subtitle", "time": 11553.99, "timestamp": "03:12:33", "text": "我需要……我需要躲起来"}, {"type": "subtitle", "time": 11556.33, "timestamp": "03:12:36", "text": "一些东西"}, {"type": "subtitle", "time": 11558.07, "timestamp": "03:12:38", "text": "[音乐]"}, {"type": "subtitle", "time": 11562.309, "timestamp": "03:12:42", "text": "从亚马逊那个平台来的，对吧？所以，我"}, {"type": "subtitle", "time": 11563.72, "timestamp": "03:12:43", "text": "不要放纵自己。"}, {"type": "subtitle", "time": 11565.75, "timestamp": "03:12:45", "text": "[音乐]"}, {"type": "subtitle", "time": 11567.83, "timestamp": "03:12:47", "text": "为什么？好的，这样应该足够了。"}, {"type": "subtitle", "time": 11570.23, "timestamp": "03:12:50", "text": "正确的？呃"}, {"type": "subtitle", "time": 11571.75, "timestamp": "03:12:51", "text": "你给他的是什么？我不"}, {"type": "subtitle", "time": 11573.349, "timestamp": "03:12:53", "text": "知道。我不知道我给了什么。我"}, {"type": "subtitle", "time": 11577.83, "timestamp": "03:12:57", "text": "给他们送了糖果之类的东西。所以"}]
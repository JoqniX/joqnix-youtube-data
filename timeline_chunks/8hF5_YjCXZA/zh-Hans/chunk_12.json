[{"type": "subtitle", "time": 721.509, "timestamp": "00:12:01", "text": "是65000。"}, {"type": "subtitle", "time": 725.59, "timestamp": "00:12:05", "text": "音乐制作费用为 65,000 美元。是的，"}, {"type": "subtitle", "time": 729.99, "timestamp": "00:12:09", "text": "我不得不申请分期付款。所以，我"}, {"type": "subtitle", "time": 733.43, "timestamp": "00:12:13", "text": "得付给他们大约16700元"}, {"type": "subtitle", "time": 735.509, "timestamp": "00:12:15", "text": "每月一次。"}, {"type": "subtitle", "time": 737.59, "timestamp": "00:12:17", "text": "这门课程从一月份开始。"}, {"type": "subtitle", "time": 739.509, "timestamp": "00:12:19", "text": "继续。一月、二月，两个月"}, {"type": "subtitle", "time": 742.069, "timestamp": "00:12:22", "text": "完成了。 3月1日，我还没收到"}, {"type": "subtitle", "time": 748.629, "timestamp": "00:12:28", "text": "你好。是的，我们遇到了一些问题。"}, {"type": "subtitle", "time": 752.23, "timestamp": "00:12:32", "text": "PayPal。我真的非常抱歉。"}, {"type": "subtitle", "time": 755.67, "timestamp": "00:12:35", "text": "我真的非常抱歉。但我已经解决了。我已发送"}, {"type": "subtitle", "time": 759.19, "timestamp": "00:12:39", "text": "一封发给我银行的电子邮件，呃，呃，我的区"}, {"type": "subtitle", "time": 762.949, "timestamp": "00:12:42", "text": "银行分行。我确实告诉过他们我"}, {"type": "subtitle", "time": 764.79, "timestamp": "00:12:44", "text": "不小心犯了个错误"}, {"type": "subtitle", "time": 767.509, "timestamp": "00:12:47", "text": "帐号。一位数。只有一个"}, {"type": "subtitle", "time": 769.75, "timestamp": "00:12:49", "text": "出错的数字。所以，我花的钱"}, {"type": "subtitle", "time": 772.71, "timestamp": "00:12:52", "text": "从科菲那里意外地去了"}, {"type": "subtitle", "time": 775.59, "timestamp": "00:12:55", "text": "他人。"}, {"type": "subtitle", "time": 779.11, "timestamp": "00:12:59", "text": "但我会把它拿回来的。不用担心。"}]
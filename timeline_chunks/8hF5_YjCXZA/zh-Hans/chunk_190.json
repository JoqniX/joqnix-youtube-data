[{"type": "subtitle", "time": 11400.469, "timestamp": "03:10:00", "text": "那也是其中之一。我差点忘了我的新"}, {"type": "subtitle", "time": 11404.309, "timestamp": "03:10:04", "text": "我用的是我自己那把牙刷。"}, {"type": "subtitle", "time": 11405.91, "timestamp": "03:10:05", "text": "父母家。"}, {"type": "subtitle", "time": 11410.63, "timestamp": "03:10:10", "text": "呃，还有一件事我忘了。"}, {"type": "subtitle", "time": 11412.55, "timestamp": "03:10:12", "text": "呃"}, {"type": "subtitle", "time": 11416.15, "timestamp": "03:10:16", "text": "我其实忘了……嗯，是的，我"}, {"type": "subtitle", "time": 11423.34, "timestamp": "03:10:23", "text": "这是什么？"}, {"type": "subtitle", "time": 11425.91, "timestamp": "03:10:25", "text": "[音乐]"}, {"type": "subtitle", "time": 11429.429, "timestamp": "03:10:29", "text": "什么？什么？"}, {"type": "subtitle", "time": 11435.51, "timestamp": "03:10:35", "text": "哦好的。嗯，天哪，我忘了……"}, {"type": "subtitle", "time": 11438.07, "timestamp": "03:10:38", "text": "我忘了请假。我把它放进去了"}, {"type": "subtitle", "time": 11440.389, "timestamp": "03:10:40", "text": "就像在外面一样。当时正值午餐时间。"}, {"type": "subtitle", "time": 11443.75, "timestamp": "03:10:43", "text": "好的。 1 凌晨 12:00 至 下午 12:00那就是"}, {"type": "subtitle", "time": 11446.55, "timestamp": "03:10:46", "text": "我回家的时候，正好从……"}, {"type": "subtitle", "time": 11451.349, "timestamp": "03:10:51", "text": "呃，英雄。嗯，所以我把它放在外面了"}, {"type": "subtitle", "time": 11453.91, "timestamp": "03:10:53", "text": "外面，呃，车和东西的地方"}, {"type": "subtitle", "time": 11456.79, "timestamp": "03:10:56", "text": "车库就在那里，车库在哪儿，呃，因为"}, {"type": "subtitle", "time": 11459.349, "timestamp": "03:10:59", "text": "阳光非常明亮。"}]
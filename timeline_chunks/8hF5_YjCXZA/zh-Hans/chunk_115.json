[{"type": "subtitle", "time": 6903.75, "timestamp": "01:55:03", "text": "我的房子。呃，所以我当时就想："}, {"type": "subtitle", "time": 6923.669, "timestamp": "01:55:23", "text": "本地治里（Puducher）的首府是哪里？是什么"}, {"type": "subtitle", "time": 6925.589, "timestamp": "01:55:25", "text": "普杜切尔？"}, {"type": "subtitle", "time": 6927.91, "timestamp": "01:55:27", "text": "等等，那是一个州。等等，那是……"}, {"type": "subtitle", "time": 6937.75, "timestamp": "01:55:37", "text": "樱桃"}, {"type": "subtitle", "time": 6955.91, "timestamp": "01:55:55", "text": "哦，对，我其实是一名信息与通信工程专业的学生。"}, {"type": "subtitle", "time": 6958.149, "timestamp": "01:55:58", "text": "你觉得我为什么不得不搬到"}]
[{"type": "subtitle", "time": 2523.75, "timestamp": "00:42:03", "text": "而且，问题也不在于加拿大"}, {"type": "subtitle", "time": 2526.23, "timestamp": "00:42:06", "text": "我尝试添加的银行账户无法添加。"}, {"type": "subtitle", "time": 2529.19, "timestamp": "00:42:09", "text": "完全是因为上面写着这个账户"}, {"type": "subtitle", "time": 2531.829, "timestamp": "00:42:11", "text": "银行账户已加入多个PayPal账户"}, {"type": "subtitle", "time": 2533.91, "timestamp": "00:42:13", "text": "账户。我甚至都不记得是哪个了。"}, {"type": "subtitle", "time": 2536.39, "timestamp": "00:42:16", "text": "它所在的账户。"}, {"type": "subtitle", "time": 2540.069, "timestamp": "00:42:20", "text": "我的天啊。我犯了个错误"}, {"type": "subtitle", "time": 2542.15, "timestamp": "00:42:22", "text": "我最初创建PayPal账户时犯了个错误。"}, {"type": "subtitle", "time": 2546.15, "timestamp": "00:42:26", "text": "帐户。我填的是假年份。我不是"}, {"type": "subtitle", "time": 2549.19, "timestamp": "00:42:29", "text": "当时18岁。好的。我填了一个假日期"}, {"type": "subtitle", "time": 2551.19, "timestamp": "00:42:31", "text": "出生之类的。当我"}, {"type": "subtitle", "time": 2553.43, "timestamp": "00:42:33", "text": "我提交了我的法律文件，它们是"}, {"type": "subtitle", "time": 2558.71, "timestamp": "00:42:38", "text": "比如，“嗯，打扰一下，乔克。你的详细信息"}, {"type": "subtitle", "time": 2560.87, "timestamp": "00:42:40", "text": "他们在这里错了。"}, {"type": "subtitle", "time": 2563.27, "timestamp": "00:42:43", "text": "他们简直就是明目张胆地禁止了……"}, {"type": "subtitle", "time": 2565.27, "timestamp": "00:42:45", "text": "我的PayPal账户被限制了。所以，我当时"}, {"type": "subtitle", "time": 2567.829, "timestamp": "00:42:47", "text": "创建第二个账户。"}, {"type": "subtitle", "time": 2569.75, "timestamp": "00:42:49", "text": "嗯，这是我目前用的那个。"}, {"type": "subtitle", "time": 2572.87, "timestamp": "00:42:52", "text": "目前是第二个账户。但问题是"}]
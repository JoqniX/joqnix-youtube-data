[{"type": "subtitle", "time": 2.629, "timestamp": "00:00:02", "text": "大概30岁或40岁左右吧。"}, {"type": "subtitle", "time": 5.91, "timestamp": "00:00:05", "text": "然后我们达到50。然后是下一个"}, {"type": "subtitle", "time": 9.589, "timestamp": "00:00:09", "text": "直播里会有完整版。"}, {"type": "subtitle", "time": 13.509, "timestamp": "00:00:13", "text": "好的。所以 60、70、80，一直到 80 结束。"}, {"type": "subtitle", "time": 17.269, "timestamp": "00:00:17", "text": "接下来，嗯，猫咪们整齐地排列着。"}, {"type": "subtitle", "time": 19.67, "timestamp": "00:00:19", "text": "溪流。好的。好的。所以，谢谢你。"}, {"type": "subtitle", "time": 22.07, "timestamp": "00:00:22", "text": "再次感谢米娜的到来。果阿"}, {"type": "subtitle", "time": 25.83, "timestamp": "00:00:25", "text": "虽然视频很短，但我仍然很享受。"}, {"type": "subtitle", "time": 31.669, "timestamp": "00:00:31", "text": "今天来的所有人都是"}, {"type": "subtitle", "time": 38.069, "timestamp": "00:00:38", "text": "呃，今天所有来过的人都会"}, {"type": "subtitle", "time": 40.229, "timestamp": "00:00:40", "text": "是"}, {"type": "subtitle", "time": 43.43, "timestamp": "00:00:43", "text": "等等，嗯"}, {"type": "subtitle", "time": 45.11, "timestamp": "00:00:45", "text": "是的"}, {"type": "subtitle", "time": 55.029, "timestamp": "00:00:55", "text": "谢谢你当时的到来"}, {"type": "subtitle", "time": 58.79, "timestamp": "00:00:58", "text": "期待您的光临。非常非常感谢！"}]
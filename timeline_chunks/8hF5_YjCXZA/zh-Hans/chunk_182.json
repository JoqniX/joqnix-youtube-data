[{"type": "subtitle", "time": 10922.469, "timestamp": "03:02:02", "text": "天哪，要是我真的关机了怎么办。"}, {"type": "subtitle", "time": 10925.349, "timestamp": "03:02:05", "text": "那肯定有问题。"}, {"type": "subtitle", "time": 10927.75, "timestamp": "03:02:07", "text": "这就是钓鱼。"}, {"type": "subtitle", "time": 10929.99, "timestamp": "03:02:09", "text": "如果我把手机摄像头放在……"}, {"type": "subtitle", "time": 10931.59, "timestamp": "03:02:11", "text": "那里？"}, {"type": "subtitle", "time": 10933.67, "timestamp": "03:02:13", "text": "字面上地，"}, {"type": "subtitle", "time": 10936.98, "timestamp": "03:02:16", "text": "我的手机快没电了。"}, {"type": "subtitle", "time": 10939.75, "timestamp": "03:02:19", "text": "[音乐]"}, {"type": "subtitle", "time": 10942.79, "timestamp": "03:02:22", "text": "我应该吗？我不知道我是否可以。"}, {"type": "subtitle", "time": 10946.0, "timestamp": "03:02:26", "text": "其实就保持这样吧。"}, {"type": "subtitle", "time": 10948.15, "timestamp": "03:02:28", "text": "[音乐]"}, {"type": "subtitle", "time": 10950.79, "timestamp": "03:02:30", "text": "但是你知道，"}, {"type": "subtitle", "time": 10954.23, "timestamp": "03:02:34", "text": "想象。我的天，这太冒险了。"}, {"type": "subtitle", "time": 10957.91, "timestamp": "03:02:37", "text": "这是奥创，风险很大。"}, {"type": "subtitle", "time": 10961.349, "timestamp": "03:02:41", "text": "但我仍然在做这件事。"}, {"type": "subtitle", "time": 10964.87, "timestamp": "03:02:44", "text": "我还在做。"}, {"type": "subtitle", "time": 10966.71, "timestamp": "03:02:46", "text": "全部"}, {"type": "subtitle", "time": 10969.269, "timestamp": "03:02:49", "text": "想象一下，如果它能映照出我的身影。"}, {"type": "subtitle", "time": 10971.269, "timestamp": "03:02:51", "text": "我会哭的。"}, {"type": "subtitle", "time": 10976.15, "timestamp": "03:02:56", "text": "我会哭"}, {"type": "subtitle", "time": 10978.67, "timestamp": "03:02:58", "text": "自然。我会哭的。"}]
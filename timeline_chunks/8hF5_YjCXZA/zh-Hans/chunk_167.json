[{"type": "subtitle", "time": 10021.11, "timestamp": "02:47:01", "text": "它就像被剥了皮一样。"}, {"type": "subtitle", "time": 10025.91, "timestamp": "02:47:05", "text": "那是一条真鱼。把我铸成青铜。"}, {"type": "subtitle", "time": 10033.429, "timestamp": "02:47:13", "text": "我得把这个卖掉，然后我就能得到。"}, {"type": "subtitle", "time": 10064.469, "timestamp": "02:47:44", "text": "那我之后就去吃午饭了。"}, {"type": "subtitle", "time": 10078.55, "timestamp": "02:47:58", "text": "更高级的鱼竿。能够钓到鱼"}]
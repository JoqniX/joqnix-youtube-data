[{"type": "subtitle", "time": 9720.15, "timestamp": "02:42:00", "text": "我觉得我今天需要洗个澡。我需要我"}, {"type": "subtitle", "time": 9723.67, "timestamp": "02:42:03", "text": "晚上洗澡了。昨天我没有"}, {"type": "subtitle", "time": 9726.07, "timestamp": "02:42:06", "text": "淋浴头"}, {"type": "subtitle", "time": 9749.03, "timestamp": "02:42:29", "text": "昨天。我们都做了些什么？我"}]
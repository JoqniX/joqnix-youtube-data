[{"type": "subtitle", "time": 15008.95, "timestamp": "04:10:08", "text": "但就像他们会告诉你的那样，要制作一个"}, {"type": "subtitle", "time": 15010.229, "timestamp": "04:10:10", "text": "因为他们确实是一家公司，所以"}, {"type": "subtitle", "time": 15011.83, "timestamp": "04:10:11", "text": "灵感促使他们唱歌。哦"}, {"type": "subtitle", "time": 15018.389, "timestamp": "04:10:18", "text": "但问题是，情况还是一样。"}, {"type": "subtitle", "time": 15021.349, "timestamp": "04:10:21", "text": "我的音乐设备出了点问题。"}, {"type": "subtitle", "time": 15024.71, "timestamp": "04:10:24", "text": "你知道我做了什么吗？我当时就像"}, {"type": "subtitle", "time": 15027.189, "timestamp": "04:10:27", "text": "我恳求我的家人，让他们看看这是怎么回事"}, {"type": "subtitle", "time": 15029.51, "timestamp": "04:10:29", "text": "好事。但他们说有个呃"}, {"type": "subtitle", "time": 15031.349, "timestamp": "04:10:31", "text": "座位有限"}, {"type": "subtitle", "time": 15039.91, "timestamp": "04:10:39", "text": "如果我嗯"}, {"type": "subtitle", "time": 15042.71, "timestamp": "04:10:42", "text": "如果我喜欢他，一秒钟后我就得发送"}, {"type": "subtitle", "time": 15044.229, "timestamp": "04:10:44", "text": "银行那玩意儿。一秒钟。一秒钟。"}, {"type": "subtitle", "time": 15051.91, "timestamp": "04:10:51", "text": "他们真的说过，如果我们……如果我们"}, {"type": "subtitle", "time": 15054.389, "timestamp": "04:10:54", "text": "希望我们能直接挂断电话。"}, {"type": "subtitle", "time": 15059.189, "timestamp": "04:10:59", "text": "然后，呃呃呃，走开吧。为什么要这样做"}]
[{"type": "subtitle", "time": 14959.51, "timestamp": "04:09:19", "text": "我不知道，伙计。"}, {"type": "subtitle", "time": 14963.91, "timestamp": "04:09:23", "text": "如果我是？是的。和像人一样"}, {"type": "subtitle", "time": 14966.389, "timestamp": "04:09:26", "text": "他们身在印度，无法通过PayPal捐款。"}, {"type": "subtitle", "time": 14968.63, "timestamp": "04:09:28", "text": "现在是因为本地交易不起作用。"}, {"type": "subtitle", "time": 14971.349, "timestamp": "04:09:31", "text": "用PayPal和所有这些愚蠢的网站"}, {"type": "subtitle", "time": 14974.63, "timestamp": "04:09:34", "text": "他们的主要支付方式是PayPal，速度更快。"}, {"type": "subtitle", "time": 14978.63, "timestamp": "04:09:38", "text": "结账费率和安全平台等。"}, {"type": "subtitle", "time": 14980.07, "timestamp": "04:09:40", "text": "如果你因为自己的原因而被骗"}, {"type": "subtitle", "time": 14981.75, "timestamp": "04:09:41", "text": "如果给人留下不好的印象，那也是你的责任。"}, {"type": "subtitle", "time": 14983.67, "timestamp": "04:09:43", "text": "这是真的。"}, {"type": "subtitle", "time": 14986.15, "timestamp": "04:09:46", "text": "问题是我对这方面一无所知。"}, {"type": "subtitle", "time": 14989.09, "timestamp": "04:09:49", "text": "生意或其他任何事情。"}, {"type": "subtitle", "time": 14990.229, "timestamp": "04:09:50", "text": "[音乐]"}, {"type": "subtitle", "time": 14993.67, "timestamp": "04:09:53", "text": "我只是用了Razor Pay，然后试了一下。"}, {"type": "subtitle", "time": 14996.229, "timestamp": "04:09:56", "text": "注册成为一家企业"}, {"type": "subtitle", "time": 14998.63, "timestamp": "04:09:58", "text": "有人给我打电话了。他们是怎么来的"}]
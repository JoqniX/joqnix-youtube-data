[{"type": "subtitle", "time": 12902.15, "timestamp": "03:35:02", "text": "快点。我只需要路由"}, {"type": "subtitle", "time": 12904.79, "timestamp": "03:35:04", "text": "声音的。我们不想经历"}, {"type": "subtitle", "time": 12911.429, "timestamp": "03:35:11", "text": "这"}, {"type": "subtitle", "time": 12915.19, "timestamp": "03:35:15", "text": "表格 a 好的，等等。哈哈。嗯，作为一名"}, {"type": "subtitle", "time": 12918.15, "timestamp": "03:35:18", "text": "从某种意义上说，冒险就是我的工作。我爱"}, {"type": "subtitle", "time": 12919.75, "timestamp": "03:35:19", "text": "在不同的环境中探索和战斗"}, {"type": "subtitle", "time": 12922.79, "timestamp": "03:35:22", "text": "Worlds 让我能够分享我的冒险经历"}, {"type": "subtitle", "time": 12926.63, "timestamp": "03:35:26", "text": "你们所有人。所以，你可以说，"}, {"type": "subtitle", "time": 12929.99, "timestamp": "03:35:29", "text": "这是我咧嘴大笑时的二头肌。"}, {"type": "subtitle", "time": 12932.95, "timestamp": "03:35:32", "text": "你好，忍者。你今天怎么样？"}, {"type": "subtitle", "time": 12935.269, "timestamp": "03:35:35", "text": "很高兴在这里见到你。张开嘴"}, {"type": "subtitle", "time": 12950.309, "timestamp": "03:35:50", "text": "[音乐]"}, {"type": "subtitle", "time": 12953.99, "timestamp": "03:35:53", "text": "哦，我也可以那样做。哦，"}]
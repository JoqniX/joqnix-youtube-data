[{"type": "subtitle", "time": 8942.87, "timestamp": "02:29:02", "text": "约拿去钓鱼。"}, {"type": "subtitle", "time": 8945.59, "timestamp": "02:29:05", "text": "我说过你或许能帮上忙。"}, {"type": "subtitle", "time": 8947.11, "timestamp": "02:29:07", "text": "它们在……上获得了生命"}, {"type": "subtitle", "time": 8949.67, "timestamp": "02:29:09", "text": "岛。我会稍后为你重新打开。"}, {"type": "subtitle", "time": 8951.19, "timestamp": "02:29:11", "text": "分钟。拿起渔网。你将会"}, {"type": "subtitle", "time": 8952.55, "timestamp": "02:29:12", "text": "能在河里抓到一些东西"}, {"type": "subtitle", "time": 8955.83, "timestamp": "02:29:15", "text": "沿着海岸线。"}, {"type": "subtitle", "time": 8959.429, "timestamp": "02:29:19", "text": "好了，我们弄了个钓鱼用的东西。"}]
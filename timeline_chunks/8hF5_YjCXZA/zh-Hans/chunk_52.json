[{"type": "subtitle", "time": 3123.43, "timestamp": "00:52:03", "text": "一切都好，但你明白我必须……"}, {"type": "subtitle", "time": 3126.549, "timestamp": "00:52:06", "text": "提供运行这些程序的详细信息"}, {"type": "subtitle", "time": 3129.91, "timestamp": "00:52:09", "text": "像 Razer Pay 这样的服务"}, {"type": "subtitle", "time": 3131.829, "timestamp": "00:52:11", "text": "一切。我甚至都没做过雷蛇"}, {"type": "subtitle", "time": 3145.349, "timestamp": "00:52:25", "text": "所以我才决定就此罢休。"}, {"type": "subtitle", "time": 3147.67, "timestamp": "00:52:27", "text": "我不会做定制的。我将使用"}, {"type": "subtitle", "time": 3149.67, "timestamp": "00:52:29", "text": "第四面墙。"}, {"type": "subtitle", "time": 3156.23, "timestamp": "00:52:36", "text": "我"}, {"type": "subtitle", "time": 3162.47, "timestamp": "00:52:42", "text": "因为我还是不懂编程。不，"}, {"type": "subtitle", "time": 3164.95, "timestamp": "00:52:44", "text": "有很多东西，"}, {"type": "subtitle", "time": 3167.349, "timestamp": "00:52:47", "text": "发生在支付网关上"}, {"type": "subtitle", "time": 3170.39, "timestamp": "00:52:50", "text": "一切。所以"}, {"type": "subtitle", "time": 3173.03, "timestamp": "00:52:53", "text": "是的，"}]
[{"type": "subtitle", "time": 16380.71, "timestamp": "04:33:00", "text": "然后还钱给他们之类的。那是"}, {"type": "subtitle", "time": 16393.87, "timestamp": "04:33:13", "text": "我不知道。"}, {"type": "subtitle", "time": 16396.15, "timestamp": "04:33:16", "text": "[音乐]"}, {"type": "subtitle", "time": 16399.59, "timestamp": "04:33:19", "text": "你骗了我们。你什么时候骗了我？"}, {"type": "subtitle", "time": 16401.51, "timestamp": "04:33:21", "text": "你们呢？"}, {"type": "subtitle", "time": 16410.47, "timestamp": "04:33:30", "text": "我不知道。"}, {"type": "subtitle", "time": 16413.429, "timestamp": "04:33:33", "text": "确实如此"}, {"type": "subtitle", "time": 16422.551, "timestamp": "04:33:42", "text": "去年十月。"}, {"type": "subtitle", "time": 16431.189, "timestamp": "04:33:51", "text": "十月。你忘了"}, {"type": "subtitle", "time": 16433.75, "timestamp": "04:33:53", "text": "我当时处于休假状态。"}, {"type": "subtitle", "time": 16435.349, "timestamp": "04:33:55", "text": "啊。"}, {"type": "subtitle", "time": 16437.029, "timestamp": "04:33:57", "text": "好的。"}]
[{"type": "subtitle", "time": 15843.59, "timestamp": "04:24:03", "text": "这次我没说我是女的。"}, {"type": "subtitle", "time": 15846.71, "timestamp": "04:24:06", "text": "所以就像女士之类的称呼，因为我"}, {"type": "subtitle", "time": 15850.309, "timestamp": "04:24:10", "text": "我觉得他们核实了我的真实姓名。"}, {"type": "subtitle", "time": 15852.149, "timestamp": "04:24:12", "text": "我认为"}, {"type": "subtitle", "time": 15855.189, "timestamp": "04:24:15", "text": "他们可能……是的，他们没有……他们没有"}, {"type": "subtitle", "time": 15857.349, "timestamp": "04:24:17", "text": "他们竟然因为我的声音而评判我。"}, {"type": "subtitle", "time": 15859.83, "timestamp": "04:24:19", "text": "通常当我与人通话时"}, {"type": "subtitle", "time": 15861.59, "timestamp": "04:24:21", "text": "那些随机出现的罪人，他们认定我是个……"}, {"type": "subtitle", "time": 15869.429, "timestamp": "04:24:29", "text": "好的。我只是说说而已。"}, {"type": "subtitle", "time": 15871.75, "timestamp": "04:24:31", "text": "我只是说说而已。好的。我只是说说而已。"}, {"type": "subtitle", "time": 15873.99, "timestamp": "04:24:33", "text": "另外，我生病了。我的声音听起来更低沉一些。"}, {"type": "subtitle", "time": 15880.74, "timestamp": "04:24:40", "text": "祸根。"}]
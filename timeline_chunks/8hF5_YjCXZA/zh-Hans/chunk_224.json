[{"type": "subtitle", "time": 13444.55, "timestamp": "03:44:04", "text": "我得到了排名第一的老公司。什么？"}, {"type": "subtitle", "time": 13458.48, "timestamp": "03:44:18", "text": "在付款请求完成之前。"}, {"type": "subtitle", "time": 13464.63, "timestamp": "03:44:24", "text": "所以我还没付款。我还没付款。我"}, {"type": "subtitle", "time": 13466.87, "timestamp": "03:44:26", "text": "我本来打算去银行存钱。"}, {"type": "subtitle", "time": 13469.99, "timestamp": "03:44:29", "text": "我只有钱，我身上只有钱。"}, {"type": "subtitle", "time": 13473.75, "timestamp": "03:44:33", "text": "钱包，价值 2,000。而我，我会我"}, {"type": "subtitle", "time": 13477.59, "timestamp": "03:44:37", "text": "想着要不要寄给他们。"}, {"type": "subtitle", "time": 13479.75, "timestamp": "03:44:39", "text": "疼痛。"}, {"type": "subtitle", "time": 13482.389, "timestamp": "03:44:42", "text": "不，问题是现在他们叫我"}, {"type": "subtitle", "time": 13492.469, "timestamp": "03:44:52", "text": "等等，他们是在看直播吗？兄弟，"}]
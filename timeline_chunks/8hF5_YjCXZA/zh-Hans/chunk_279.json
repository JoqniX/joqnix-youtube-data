[{"type": "subtitle", "time": 16741.349, "timestamp": "04:39:01", "text": "杯子直接掉地上了。天气很热。"}, {"type": "subtitle", "time": 16743.269, "timestamp": "04:39:03", "text": "然后我又把它捡了起来。哦，是的。"}, {"type": "subtitle", "time": 16748.07, "timestamp": "04:39:08", "text": "蒸汽。谢谢。蒸汽太烫了。和"}, {"type": "subtitle", "time": 16750.31, "timestamp": "04:39:10", "text": "是的，"}, {"type": "subtitle", "time": 16752.949, "timestamp": "04:39:12", "text": "我当时正试图把冰块放进去，然后……"}, {"type": "subtitle", "time": 16755.75, "timestamp": "04:39:15", "text": "把它放进水里等等。"}, {"type": "subtitle", "time": 16759.8, "timestamp": "04:39:19", "text": "然后这些人打电话给我。"}, {"type": "subtitle", "time": 16762.07, "timestamp": "04:39:22", "text": "[音乐]"}, {"type": "subtitle", "time": 16764.789, "timestamp": "04:39:24", "text": "我很少接到电话。"}, {"type": "subtitle", "time": 16767.189, "timestamp": "04:39:27", "text": "也。"}, {"type": "subtitle", "time": 16769.189, "timestamp": "04:39:29", "text": "现在他们会给我打垃圾电话或"}, {"type": "subtitle", "time": 16770.949, "timestamp": "04:39:30", "text": "某物。"}, {"type": "subtitle", "time": 16773.67, "timestamp": "04:39:33", "text": "我只想说，我和我的……谈过了。"}, {"type": "subtitle", "time": 16778.31, "timestamp": "04:39:38", "text": "父母，还有我那无所不知的爸爸。"}, {"type": "subtitle", "time": 16783.35, "timestamp": "04:39:43", "text": "我以前做过类似的事情，呃，我的"}, {"type": "subtitle", "time": 16787.83, "timestamp": "04:39:47", "text": "爸爸说，呃，我爸爸不愿意。"}, {"type": "subtitle", "time": 16791.19, "timestamp": "04:39:51", "text": "呃，愿意做这件事之类的"}, {"type": "subtitle", "time": 16794.15, "timestamp": "04:39:54", "text": "我只想说声对不起，谢谢。"}, {"type": "subtitle", "time": 16799.11, "timestamp": "04:39:59", "text": "感谢您抽出时间，通话就到此结束。"}]
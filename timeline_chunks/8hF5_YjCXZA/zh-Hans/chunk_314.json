[{"type": "subtitle", "time": 18849.11, "timestamp": "05:14:09", "text": "[音乐]"}, {"type": "subtitle", "time": 18853.43, "timestamp": "05:14:13", "text": "达。呃，欢迎来到夜晚。今天"}, {"type": "subtitle", "time": 18855.91, "timestamp": "05:14:15", "text": "您的租购计划适用于售后市场。所以它"}, {"type": "subtitle", "time": 18859.67, "timestamp": "05:14:19", "text": "已取消。我发帖说我没钱了。"}, {"type": "subtitle", "time": 18862.708, "timestamp": "05:14:22", "text": "但我没钱。"}, {"type": "subtitle", "time": 18865.51, "timestamp": "05:14:25", "text": "疼痛。我必须付钱"}, {"type": "subtitle", "time": 18869.11, "timestamp": "05:14:29", "text": "我得付21.7美元。"}, {"type": "subtitle", "time": 18871.19, "timestamp": "05:14:31", "text": "每月"}, {"type": "subtitle", "time": 18873.43, "timestamp": "05:14:33", "text": "至多"}, {"type": "subtitle", "time": 18876.55, "timestamp": "05:14:36", "text": "呃，我错过了一个月。所以，呃，我"}, {"type": "subtitle", "time": 18879.11, "timestamp": "05:14:39", "text": "之前发过。哦哦，是的。所以，呃……"}, {"type": "subtitle", "time": 18881.75, "timestamp": "05:14:41", "text": "将成为"}, {"type": "subtitle", "time": 18884.47, "timestamp": "05:14:44", "text": "呃"}, {"type": "subtitle", "time": 18893.59, "timestamp": "05:14:53", "text": "如果我没记错的话，是为了获得许可证。"}]
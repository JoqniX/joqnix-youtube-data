[{"type": "subtitle", "time": 1861.11, "timestamp": "00:31:01", "text": "早晨？我不想太累。"}, {"type": "subtitle", "time": 1863.029, "timestamp": "00:31:03", "text": "昨天我们玩了很多游戏，"}, {"type": "subtitle", "time": 1865.83, "timestamp": "00:31:05", "text": "正确的？"}, {"type": "subtitle", "time": 1869.99, "timestamp": "00:31:09", "text": "今天我觉得我应该会"}, {"type": "subtitle", "time": 1873.11, "timestamp": "00:31:13", "text": "呃，课程。"}, {"type": "subtitle", "time": 1876.23, "timestamp": "00:31:16", "text": "等等，我收到一封邮件。一秒钟。是吗？"}, {"type": "subtitle", "time": 1897.909, "timestamp": "00:31:37", "text": "好的。呃，"}, {"type": "subtitle", "time": 1901.11, "timestamp": "00:31:41", "text": "一名二级订阅用户。"}, {"type": "subtitle", "time": 1904.789, "timestamp": "00:31:44", "text": "哦，总收入 1146 美元。"}, {"type": "subtitle", "time": 1907.669, "timestamp": "00:31:47", "text": "哇。好的。等待。来自两个 110 位"}, {"type": "subtitle", "time": 1911.59, "timestamp": "00:31:51", "text": "层级。 22 位一级订阅用户。一层"}, {"type": "subtitle", "time": 1913.269, "timestamp": "00:31:53", "text": "2 位订阅者。三级"}, {"type": "subtitle", "time": 1917.59, "timestamp": "00:31:57", "text": "订阅者。总收入146。哦，"}]
[{"type": "subtitle", "time": 6841.669, "timestamp": "01:54:01", "text": "是我的"}, {"type": "subtitle", "time": 6843.51, "timestamp": "01:54:03", "text": "我以为那两个人就像"}, {"type": "subtitle", "time": 6850.55, "timestamp": "01:54:10", "text": "[音乐]"}, {"type": "subtitle", "time": 6864.229, "timestamp": "01:54:24", "text": "呃，我这就把链接发给你。好的。"}, {"type": "subtitle", "time": 6865.99, "timestamp": "01:54:25", "text": "澳大利亚希望得到你的一些帮助。"}, {"type": "subtitle", "time": 6868.31, "timestamp": "01:54:28", "text": "聊天记录也一样。"}, {"type": "subtitle", "time": 6871.109, "timestamp": "01:54:31", "text": "不，班加罗尔在"}, {"type": "subtitle", "time": 6876.39, "timestamp": "01:54:36", "text": "我知道我去过班加罗尔。"}, {"type": "subtitle", "time": 6878.229, "timestamp": "01:54:38", "text": "我会说明教师资格证的情况。谁说的"}, {"type": "subtitle", "time": 6881.109, "timestamp": "01:54:41", "text": "你懂地理吗？"}, {"type": "subtitle", "time": 6883.99, "timestamp": "01:54:43", "text": "事情是这样的，我遇到了我的地理老师。"}, {"type": "subtitle", "time": 6888.79, "timestamp": "01:54:48", "text": "在我的兴奋中，就像重聚一样"}, {"type": "subtitle", "time": 6892.31, "timestamp": "01:54:52", "text": "嗯，不，她来自IC银级。"}, {"type": "subtitle", "time": 6895.109, "timestamp": "01:54:55", "text": "学校。现在她在CB教书。"}, {"type": "subtitle", "time": 6897.43, "timestamp": "01:54:57", "text": "州立学校就在这所学校前面"}]
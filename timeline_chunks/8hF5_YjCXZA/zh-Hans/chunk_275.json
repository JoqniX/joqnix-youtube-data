[{"type": "subtitle", "time": 16503.429, "timestamp": "04:35:03", "text": "哦，等等，等等，等等。我需要发送"}, {"type": "subtitle", "time": 16515.51, "timestamp": "04:35:15", "text": "我爸爸在哪里分享报纸"}, {"type": "subtitle", "time": 16517.91, "timestamp": "04:35:17", "text": "收据"}, {"type": "subtitle", "time": 16524.31, "timestamp": "04:35:24", "text": "好的，抱歉，我忘了这件事。我的爸爸"}, {"type": "subtitle", "time": 16527.269, "timestamp": "04:35:27", "text": "在银行。"}, {"type": "subtitle", "time": 16529.51, "timestamp": "04:35:29", "text": "嗯，"}, {"type": "subtitle", "time": 16531.189, "timestamp": "04:35:31", "text": "因为我早上就发了邮件。"}, {"type": "subtitle", "time": 16534.23, "timestamp": "04:35:34", "text": "现在我需要的钱就到手了。"}, {"type": "subtitle", "time": 16537.99, "timestamp": "04:35:37", "text": "已转账回我的账户"}, {"type": "subtitle", "time": 16545.83, "timestamp": "04:35:45", "text": "说实话，我"}, {"type": "subtitle", "time": 16556.629, "timestamp": "04:35:56", "text": "我完全投入其中，这在独立性方面是毋庸置疑的。"}, {"type": "subtitle", "time": 16559.429, "timestamp": "04:35:59", "text": "优柔寡断"}]
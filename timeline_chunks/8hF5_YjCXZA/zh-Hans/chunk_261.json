[{"type": "subtitle", "time": 15662.149, "timestamp": "04:21:02", "text": "他们这么说是为了施加压力。那是"}, {"type": "subtitle", "time": 15672.71, "timestamp": "04:21:12", "text": "你说你通过WhatsApp给他们发了信息。"}, {"type": "subtitle", "time": 15676.79, "timestamp": "04:21:16", "text": "不，我没有。"}, {"type": "subtitle", "time": 15682.07, "timestamp": "04:21:22", "text": "我什么时候说过我说过我说过那个"}, {"type": "subtitle", "time": 15683.99, "timestamp": "04:21:23", "text": "跟我说话的那位女士"}, {"type": "subtitle", "time": 15686.389, "timestamp": "04:21:26", "text": "以第一人称开始，不不不不"}, {"type": "subtitle", "time": 15688.87, "timestamp": "04:21:28", "text": "然后，是一个男人跟我说话的"}, {"type": "subtitle", "time": 15690.79, "timestamp": "04:21:30", "text": "我说，因为我想单独写论文。"}, {"type": "subtitle", "time": 15693.11, "timestamp": "04:21:33", "text": "他们把我转送到了另一艘船上。"}, {"type": "subtitle", "time": 15695.83, "timestamp": "04:21:35", "text": "那位女士给我打了电话，我告诉了她。"}, {"type": "subtitle", "time": 15699.51, "timestamp": "04:21:39", "text": "如果他们是这样，我只是想要一个"}, {"type": "subtitle", "time": 15702.55, "timestamp": "04:21:42", "text": "在线过渡之类的东西"}, {"type": "subtitle", "time": 15705.91, "timestamp": "04:21:45", "text": "仅此一家网店，别的什么都没有。"}, {"type": "subtitle", "time": 15708.95, "timestamp": "04:21:48", "text": "他们把一切都告诉我了，他们说"}, {"type": "subtitle", "time": 15712.309, "timestamp": "04:21:52", "text": "我告诉他们我无法支付这笔款项。"}, {"type": "subtitle", "time": 15714.79, "timestamp": "04:21:54", "text": "现在，现在，你能把它发给我吗？"}, {"type": "subtitle", "time": 15716.71, "timestamp": "04:21:56", "text": "他们通过WhatsApp或其他方式联系我，然后他们"}, {"type": "subtitle", "time": 15719.269, "timestamp": "04:21:59", "text": "他通过 WhatsApp 发给我的。"}]
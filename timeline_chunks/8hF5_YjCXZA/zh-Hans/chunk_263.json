[{"type": "subtitle", "time": 15782.469, "timestamp": "04:23:02", "text": "公司如何分享你的信息"}, {"type": "subtitle", "time": 15785.349, "timestamp": "04:23:05", "text": "这是什么？我不知道。"}, {"type": "subtitle", "time": 15788.55, "timestamp": "04:23:08", "text": "他们想要什么，我不知道。我只是"}, {"type": "subtitle", "time": 15790.79, "timestamp": "04:23:10", "text": "假设"}, {"type": "subtitle", "time": 15792.389, "timestamp": "04:23:12", "text": "疼痛。"}, {"type": "subtitle", "time": 15795.11, "timestamp": "04:23:15", "text": "天哪，如果我爸知道了，他会杀了我的。"}, {"type": "subtitle", "time": 15798.149, "timestamp": "04:23:18", "text": "我正要做的事。"}, {"type": "subtitle", "time": 15801.349, "timestamp": "04:23:21", "text": "呃，他就是那种会问别人他"}, {"type": "subtitle", "time": 15803.83, "timestamp": "04:23:23", "text": "在最终确定之后，他知道一切。"}, {"type": "subtitle", "time": 15806.55, "timestamp": "04:23:26", "text": "令人信服的是，它是合法的"}, {"type": "subtitle", "time": 15809.189, "timestamp": "04:23:29", "text": "只有到那时他才会去做。他没有"}, {"type": "subtitle", "time": 15811.91, "timestamp": "04:23:31", "text": "信任网络上的事物，还是信任其他陌生人？"}, {"type": "subtitle", "time": 15813.59, "timestamp": "04:23:33", "text": "说。"}, {"type": "subtitle", "time": 15817.349, "timestamp": "04:23:37", "text": "啊，我真想成为他那样的人。"}, {"type": "subtitle", "time": 15837.349, "timestamp": "04:23:57", "text": "哦，好痛。"}, {"type": "subtitle", "time": 15839.349, "timestamp": "04:23:59", "text": "我担心的一点是，他们"}]
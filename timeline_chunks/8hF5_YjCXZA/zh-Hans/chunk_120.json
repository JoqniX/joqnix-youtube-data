[{"type": "subtitle", "time": 7220.709, "timestamp": "02:00:20", "text": "你觉得我知道这件事吗？我忘了我"}, {"type": "subtitle", "time": 7223.27, "timestamp": "02:00:23", "text": "学习过。"}, {"type": "subtitle", "time": 7226.31, "timestamp": "02:00:26", "text": "我当时想，我只需要好好学习就行了。"}, {"type": "subtitle", "time": 7228.39, "timestamp": "02:00:28", "text": "考试。我不需要记住这个。所以"}, {"type": "subtitle", "time": 7231.75, "timestamp": "02:00:31", "text": "我把我的所有事情都忘了。"}, {"type": "subtitle", "time": 7238.629, "timestamp": "02:00:38", "text": "所有化学式、化学，呃"}, {"type": "subtitle", "time": 7241.75, "timestamp": "02:00:41", "text": "物理学、政治学、经济学，一切的一切"}, {"type": "subtitle", "time": 7243.75, "timestamp": "02:00:43", "text": "我学习过了。"}, {"type": "subtitle", "time": 7249.109, "timestamp": "02:00:49", "text": "[音乐]"}]
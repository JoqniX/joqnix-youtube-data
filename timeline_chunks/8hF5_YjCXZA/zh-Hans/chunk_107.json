[{"type": "subtitle", "time": 6421.91, "timestamp": "01:47:01", "text": "该账户有 300。"}, {"type": "subtitle", "time": 6424.149, "timestamp": "01:47:04", "text": "我用来直播的主要账号"}, {"type": "subtitle", "time": 6425.669, "timestamp": "01:47:05", "text": "是"}, {"type": "subtitle", "time": 6429.27, "timestamp": "01:47:09", "text": "600 至。我的天啊，我好难过"}, {"type": "subtitle", "time": 6432.07, "timestamp": "01:47:12", "text": "最低余额。我不能。好吧，行吧。"}, {"type": "subtitle", "time": 6435.43, "timestamp": "01:47:15", "text": "那我稍后再做。对不起，各位。"}, {"type": "subtitle", "time": 6438.31, "timestamp": "01:47:18", "text": "我不能拿走……呃……流媒体的钱"}, {"type": "subtitle", "time": 6442.39, "timestamp": "01:47:22", "text": "也包括所有这些呃……事情。我 我 我"}, {"type": "subtitle", "time": 6444.229, "timestamp": "01:47:24", "text": "我只需要在我的首秀上用它就行了。"}, {"type": "subtitle", "time": 6447.669, "timestamp": "01:47:27", "text": "准备工作和资金"}, {"type": "subtitle", "time": 6454.229, "timestamp": "01:47:34", "text": "[音乐]"}, {"type": "subtitle", "time": 6468.95, "timestamp": "01:47:48", "text": "但首先是我们那一部分"}, {"type": "subtitle", "time": 6470.95, "timestamp": "01:47:50", "text": "要么暑假后上高中"}, {"type": "subtitle", "time": 6477.03, "timestamp": "01:47:57", "text": "马和精彩的表演，还有其他少女"}]
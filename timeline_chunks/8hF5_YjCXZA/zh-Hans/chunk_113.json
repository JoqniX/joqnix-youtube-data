[{"type": "subtitle", "time": 6791.75, "timestamp": "01:53:11", "text": "试着了解一下这个国家。"}, {"type": "subtitle", "time": 6793.91, "timestamp": "01:53:13", "text": "你居住的地方。"}, {"type": "subtitle", "time": 6796.55, "timestamp": "01:53:16", "text": "此时此刻，我觉得自己像个冒牌货。"}, {"type": "subtitle", "time": 6803.83, "timestamp": "01:53:23", "text": "我生活丰富多彩。"}, {"type": "subtitle", "time": 6806.07, "timestamp": "01:53:26", "text": "我只是个安慰。你觉得我知道吗？"}, {"type": "subtitle", "time": 6814.39, "timestamp": "01:53:34", "text": "呃，现在你明白我为什么给他打电话了吧？"}, {"type": "subtitle", "time": 6824.87, "timestamp": "01:53:44", "text": "我当时想的是浦那和马哈拉施特拉邦"}, {"type": "subtitle", "time": 6826.87, "timestamp": "01:53:46", "text": "就像不同的州一样"}, {"type": "subtitle", "time": 6829.75, "timestamp": "01:53:49", "text": "印度。"}, {"type": "subtitle", "time": 6832.07, "timestamp": "01:53:52", "text": "我去浦那的时候，心想……"}, {"type": "subtitle", "time": 6839.669, "timestamp": "01:53:59", "text": "浦那"}]
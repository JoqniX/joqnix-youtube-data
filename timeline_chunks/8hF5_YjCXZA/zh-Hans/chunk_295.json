[{"type": "subtitle", "time": 17707.67, "timestamp": "04:55:07", "text": "呃，我父母告诉我不要……"}, {"type": "subtitle", "time": 17714.55, "timestamp": "04:55:14", "text": "是的。"}, {"type": "subtitle", "time": 17721.51, "timestamp": "04:55:21", "text": "好的。"}, {"type": "subtitle", "time": 17727.11, "timestamp": "04:55:27", "text": "我没说对不起。我没说对不起。"}, {"type": "subtitle", "time": 17730.47, "timestamp": "04:55:30", "text": "各位，我没说对不起。我没说"}, {"type": "subtitle", "time": 17731.99, "timestamp": "04:55:31", "text": "对不起。"}, {"type": "subtitle", "time": 17742.15, "timestamp": "04:55:42", "text": "现在。他们会把我当成……"}, {"type": "subtitle", "time": 17744.788, "timestamp": "04:55:44", "text": "被宠坏的孩子或者其他不好的孩子"}, {"type": "subtitle", "time": 17747.51, "timestamp": "04:55:47", "text": "某物。无法做出任何决定"}, {"type": "subtitle", "time": 17754.948, "timestamp": "04:55:54", "text": "但这也有他们的错。这是他们的"}, {"type": "subtitle", "time": 17758.948, "timestamp": "04:55:58", "text": "错在太没耐心，问太多"}]
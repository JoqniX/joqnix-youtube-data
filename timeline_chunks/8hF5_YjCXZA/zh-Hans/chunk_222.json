[{"type": "subtitle", "time": 13322.55, "timestamp": "03:42:02", "text": "他们想这么做，但是，是的，我会"}, {"type": "subtitle", "time": 13324.95, "timestamp": "03:42:04", "text": "直接说出公司名称就行了，没那么简单。"}, {"type": "subtitle", "time": 13326.79, "timestamp": "03:42:06", "text": "他们会看我的直播吗？"}, {"type": "subtitle", "time": 13333.11, "timestamp": "03:42:13", "text": "他们给我的任何东西，嗯，那玩意儿。他们呃他们"}, {"type": "subtitle", "time": 13337.19, "timestamp": "03:42:17", "text": "它们被称为注册卡罗或其他什么。"}, {"type": "subtitle", "time": 13344.07, "timestamp": "03:42:24", "text": "好的。在线业务合规性"}, {"type": "subtitle", "time": 13345.83, "timestamp": "03:42:25", "text": "帮助企业和其他"}, {"type": "subtitle", "time": 13347.59, "timestamp": "03:42:27", "text": "拥有各种注册信息的个人"}, {"type": "subtitle", "time": 13350.389, "timestamp": "03:42:30", "text": "税务申报及其他法律事务。何"}, {"type": "subtitle", "time": 13357.429, "timestamp": "03:42:37", "text": "我看了评论。最糟糕的之一"}, {"type": "subtitle", "time": 13359.11, "timestamp": "03:42:39", "text": "服务和不专业的啤酒都让我很失望。"}, {"type": "subtitle", "time": 13361.269, "timestamp": "03:42:41", "text": "来自这家公司。我的天啊。伟大的"}, {"type": "subtitle", "time": 13363.67, "timestamp": "03:42:43", "text": "服务。响应速度快。价格实惠"}, {"type": "subtitle", "time": 13365.51, "timestamp": "03:42:45", "text": "价格。"}, {"type": "subtitle", "time": 13367.269, "timestamp": "03:42:47", "text": "指导非常到位，速度很快。过程"}, {"type": "subtitle", "time": 13370.71, "timestamp": "03:42:50", "text": "公司注册。好的。"}]
[{"type": "subtitle", "time": 18973.11, "timestamp": "05:16:13", "text": "好的。我们该怎么办？呃，我需要一个"}, {"type": "subtitle", "time": 18975.91, "timestamp": "05:16:15", "text": "我还是去做作业吧？好的。"}, {"type": "subtitle", "time": 18977.59, "timestamp": "05:16:17", "text": "等待。"}, {"type": "subtitle", "time": 18979.67, "timestamp": "05:16:19", "text": "我现在得做作业了。好的。让"}, {"type": "subtitle", "time": 18982.55, "timestamp": "05:16:22", "text": "让我把这些都删掉。"}, {"type": "subtitle", "time": 18986.07, "timestamp": "05:16:26", "text": "好的。等待。那东西在哪儿？"}, {"type": "subtitle", "time": 18989.27, "timestamp": "05:16:29", "text": "我收到了这个文件。"}, {"type": "subtitle", "time": 18993.67, "timestamp": "05:16:33", "text": "这是Zakura乐器。呃"}, {"type": "subtitle", "time": 18996.39, "timestamp": "05:16:36", "text": "这是关于量化的一堂课，"}, {"type": "subtitle", "time": 18998.07, "timestamp": "05:16:38", "text": "变形"}, {"type": "subtitle", "time": 19004.47, "timestamp": "05:16:44", "text": "而且我认为他们属于同一类人。"}, {"type": "subtitle", "time": 19006.628, "timestamp": "05:16:46", "text": "教我们如何进行人声切片和"}, {"type": "subtitle", "time": 19008.47, "timestamp": "05:16:48", "text": "东西。"}, {"type": "subtitle", "time": 19011.03, "timestamp": "05:16:51", "text": "是的。这是因为我是唯一一个"}, {"type": "subtitle", "time": 19012.868, "timestamp": "05:16:52", "text": "谁在学习日式风格"}, {"type": "subtitle", "time": 19016.47, "timestamp": "05:16:56", "text": "音乐，对吧？成语和日本流行音乐"}, {"type": "subtitle", "time": 19019.75, "timestamp": "05:16:59", "text": "类型。他好像是因为这跟我讨论的话题有关。"}]
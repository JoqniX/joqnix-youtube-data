[{"type": "subtitle", "time": 7140.95, "timestamp": "01:59:00", "text": "什么？等等，那是在印度。"}, {"type": "subtitle", "time": 7144.31, "timestamp": "01:59:04", "text": "那是在克什米尔。什么？你们那里下雪了"}, {"type": "subtitle", "time": 7147.27, "timestamp": "01:59:07", "text": "在印度？哦，是现金。好的。好的。"}, {"type": "subtitle", "time": 7149.92, "timestamp": "01:59:09", "text": "好的。 [音乐]"}, {"type": "subtitle", "time": 7159.99, "timestamp": "01:59:19", "text": "对我来说，那里有枪。哦，原来是音乐。"}, {"type": "subtitle", "time": 7174.709, "timestamp": "01:59:34", "text": "对不起。"}, {"type": "subtitle", "time": 7188.87, "timestamp": "01:59:48", "text": "我知道我们也有甜点。"}, {"type": "subtitle", "time": 7191.99, "timestamp": "01:59:51", "text": "那是什么？"}, {"type": "subtitle", "time": 7195.669, "timestamp": "01:59:55", "text": "别让我爸妈知道我有多糟糕"}, {"type": "subtitle", "time": 7198.47, "timestamp": "01:59:58", "text": "像这样。我的天啊。他们会像这样"}]
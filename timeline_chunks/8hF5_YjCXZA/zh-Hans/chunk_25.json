[{"type": "subtitle", "time": 1501.909, "timestamp": "00:25:01", "text": "我们需要等待表情。嗯，有一些。"}, {"type": "subtitle", "time": 1504.95, "timestamp": "00:25:04", "text": "我还没有添加表情符号，添加它，这曾经是"}, {"type": "subtitle", "time": 1510.63, "timestamp": "00:25:10", "text": "用面包做的。呃，你可以添加这些"}, {"type": "subtitle", "time": 1515.35, "timestamp": "00:25:15", "text": "呃，但是呃，为了实例化"}, {"type": "subtitle", "time": 1519.11, "timestamp": "00:25:19", "text": "呃，我相信嗯"}, {"type": "subtitle", "time": 1526.549, "timestamp": "00:25:26", "text": "在这样的时刻，我多么希望自己有一个"}, {"type": "subtitle", "time": 1529.669, "timestamp": "00:25:29", "text": "打印机，那个打印机玩意儿，不在哪儿"}, {"type": "subtitle", "time": 1532.87, "timestamp": "00:25:32", "text": "你可以在那里打印人们的呃，比如"}, {"type": "subtitle", "time": 1541.99, "timestamp": "00:25:41", "text": "或者像 Twitch 那样，嗯，所以当一个 Twitch"}, {"type": "subtitle", "time": 1543.99, "timestamp": "00:25:43", "text": "订阅、积分或其​​他什么东西"}, {"type": "subtitle", "time": 1546.71, "timestamp": "00:25:46", "text": "如果发生了这种情况，你可以把它打印出来，对吧？那"}, {"type": "subtitle", "time": 1548.47, "timestamp": "00:25:48", "text": "东西。我希望我能有个便携式的"}, {"type": "subtitle", "time": 1550.87, "timestamp": "00:25:50", "text": "打印机。"}, {"type": "subtitle", "time": 1554.47, "timestamp": "00:25:54", "text": "我可以保证它的安全。"}, {"type": "subtitle", "time": 1557.43, "timestamp": "00:25:57", "text": "就像笔记本一样"}]
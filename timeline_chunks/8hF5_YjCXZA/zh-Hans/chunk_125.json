[{"type": "subtitle", "time": 7500.629, "timestamp": "02:05:00", "text": "我们每年都学习。啊，我睡过头了。"}, {"type": "subtitle", "time": 7506.629, "timestamp": "02:05:06", "text": "你是什​​么意思？北、南、东"}, {"type": "subtitle", "time": 7510.229, "timestamp": "02:05:10", "text": "当他把所有事情都搞砸时，韦斯特。"}, {"type": "subtitle", "time": 7513.43, "timestamp": "02:05:13", "text": "我的天啊，"}, {"type": "subtitle", "time": 7516.55, "timestamp": "02:05:16", "text": "完全是。"}, {"type": "subtitle", "time": 7522.229, "timestamp": "02:05:22", "text": "但说实话，我不应该那样做。"}, {"type": "subtitle", "time": 7531.83, "timestamp": "02:05:31", "text": "呃，我以前五点就睡觉了。不，不，我以前"}, {"type": "subtitle", "time": 7535.589, "timestamp": "02:05:35", "text": "不。嗯，"}, {"type": "subtitle", "time": 7537.669, "timestamp": "02:05:37", "text": "他打电话"}]
[{"type": "subtitle", "time": 12605.19, "timestamp": "03:30:05", "text": "正如你所听到的，就像我没有提高我的"}, {"type": "subtitle", "time": 12608.15, "timestamp": "03:30:08", "text": "大声说话或大声"}, {"type": "subtitle", "time": 12622.55, "timestamp": "03:30:22", "text": "好的。哦，等等。我知道。"}, {"type": "subtitle", "time": 12627.11, "timestamp": "03:30:27", "text": "关闭。关闭。关闭。"}, {"type": "subtitle", "time": 12633.23, "timestamp": "03:30:33", "text": "花愿"}, {"type": "subtitle", "time": 12639.269, "timestamp": "03:30:39", "text": "[音乐]"}, {"type": "subtitle", "time": 12656.8, "timestamp": "03:30:56", "text": "疼痛。不。"}]
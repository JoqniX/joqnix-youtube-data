[{"type": "subtitle", "time": 11220.23, "timestamp": "03:07:00", "text": "我差点被吓到了。"}, {"type": "subtitle", "time": 11223.269, "timestamp": "03:07:03", "text": "天哪，我差点被吓到了。我当时想"}, {"type": "subtitle", "time": 11225.03, "timestamp": "03:07:05", "text": "我给他看了我的脸之类的。我当时"}, {"type": "subtitle", "time": 11228.23, "timestamp": "03:07:08", "text": "我闭上眼睛休息了一会儿。我"}, {"type": "subtitle", "time": 11231.83, "timestamp": "03:07:11", "text": "当时我就想，“我的天哪，"}, {"type": "subtitle", "time": 11234.07, "timestamp": "03:07:14", "text": "时机已到。"}, {"type": "subtitle", "time": 11236.469, "timestamp": "03:07:16", "text": "我得跑了。"}, {"type": "subtitle", "time": 11239.83, "timestamp": "03:07:19", "text": "好的，呃，它们应该没问题吧？我"}, {"type": "subtitle", "time": 11244.309, "timestamp": "03:07:24", "text": "这是广角镜头。"}, {"type": "subtitle", "time": 11246.63, "timestamp": "03:07:26", "text": "顺便说一下，我只能把手机放在那里"}, {"type": "subtitle", "time": 11250.309, "timestamp": "03:07:30", "text": "那玩意儿……呃，我只能这么说……呃……"}, {"type": "subtitle", "time": 11253.51, "timestamp": "03:07:33", "text": "相机就拍了一会儿，因为我"}, {"type": "subtitle", "time": 11256.95, "timestamp": "03:07:36", "text": "手机随时都可能没电了"}, {"type": "subtitle", "time": 11260.71, "timestamp": "03:07:40", "text": "现在。就这样吧。我进不去"}, {"type": "subtitle", "time": 11261.97, "timestamp": "03:07:41", "text": "现在。"}, {"type": "subtitle", "time": 11271.99, "timestamp": "03:07:51", "text": "别担心你的狗会不会把它关起来。"}, {"type": "subtitle", "time": 11274.23, "timestamp": "03:07:54", "text": "秘密。现在我得把虾切开。"}]
[{"type": "subtitle", "time": 19320.948, "timestamp": "05:22:00", "text": "我在 Twitch 频道上直播的时候"}, {"type": "subtitle", "time": 19324.23, "timestamp": "05:22:04", "text": "家庭作业和一切都很好"}, {"type": "subtitle", "time": 19328.07, "timestamp": "05:22:08", "text": "我做了很多实验性的事情"}, {"type": "subtitle", "time": 19330.39, "timestamp": "05:22:10", "text": "然后你就说，好吧，那我们来学习。"}, {"type": "subtitle", "time": 19333.11, "timestamp": "05:22:13", "text": "稍后会详细说明，你不需要……"}, {"type": "subtitle", "time": 19336.07, "timestamp": "05:22:16", "text": "现在担心吧，我们……我们必须……"}, {"type": "subtitle", "time": 19338.868, "timestamp": "05:22:18", "text": "确保每个人都走正确的路线。"}, {"type": "subtitle", "time": 19340.868, "timestamp": "05:22:20", "text": "节奏差不多。他确实这么说过"}, {"type": "subtitle", "time": 19342.948, "timestamp": "05:22:22", "text": "那"}, {"type": "subtitle", "time": 19344.948, "timestamp": "05:22:24", "text": "我把事情想得太复杂了"}, {"type": "subtitle", "time": 19356.47, "timestamp": "05:22:36", "text": "呃，通常情况下，如果你学得好，就会学习很多东西。"}, {"type": "subtitle", "time": 19359.83, "timestamp": "05:22:39", "text": "现在要创作音乐等等。"}, {"type": "subtitle", "time": 19362.31, "timestamp": "05:22:42", "text": "嗯，通常当你学习的时候"}, {"type": "subtitle", "time": 19365.75, "timestamp": "05:22:45", "text": "做些音乐之类的东西，你不需要"}, {"type": "subtitle", "time": 19368.39, "timestamp": "05:22:48", "text": "别太担心音乐"}, {"type": "subtitle", "time": 19370.15, "timestamp": "05:22:50", "text": "理论或类似符号"}, {"type": "subtitle", "time": 19372.31, "timestamp": "05:22:52", "text": "像复杂的东西，对吧？我去了"}, {"type": "subtitle", "time": 19375.19, "timestamp": "05:22:55", "text": "这条复杂的路线已经，就像……"}, {"type": "subtitle", "time": 19377.59, "timestamp": "05:22:57", "text": "笨蛋。"}]
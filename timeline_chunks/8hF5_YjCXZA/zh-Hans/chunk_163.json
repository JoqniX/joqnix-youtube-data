[{"type": "subtitle", "time": 9781.59, "timestamp": "02:43:01", "text": "是的，做代班就是那样。"}, {"type": "subtitle", "time": 9785.27, "timestamp": "02:43:05", "text": "真的会让人筋疲力尽。"}, {"type": "subtitle", "time": 9787.67, "timestamp": "02:43:07", "text": "这是一件事。"}, {"type": "subtitle", "time": 9792.15, "timestamp": "02:43:12", "text": "我必须熬过这四个月。"}, {"type": "subtitle", "time": 9814.95, "timestamp": "02:43:34", "text": "呃，请问有什么奖励措施吗？"}, {"type": "subtitle", "time": 9818.07, "timestamp": "02:43:38", "text": "那玩意儿？正确的。好的。所以我可以把它添加为"}, {"type": "subtitle", "time": 9825.349, "timestamp": "02:43:45", "text": "如果有人有任何"}]
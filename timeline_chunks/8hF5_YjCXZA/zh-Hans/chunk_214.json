[{"type": "subtitle", "time": 12842.389, "timestamp": "03:34:02", "text": "哦，稍等一下。一秒钟。一秒钟。一秒钟。"}, {"type": "subtitle", "time": 12845.75, "timestamp": "03:34:05", "text": "摄像头。无音频。天哪，不是我"}, {"type": "subtitle", "time": 12850.309, "timestamp": "03:34:10", "text": "没有设置。哦，又是我的错。"}, {"type": "subtitle", "time": 12861.75, "timestamp": "03:34:21", "text": "[音乐]"}, {"type": "subtitle", "time": 12876.63, "timestamp": "03:34:36", "text": "你在躲起来吗，兄弟？"}, {"type": "subtitle", "time": 12879.03, "timestamp": "03:34:39", "text": "我找不到你。"}, {"type": "subtitle", "time": 12881.51, "timestamp": "03:34:41", "text": "等等，让我来解决这个问题。好的，让我"}, {"type": "subtitle", "time": 12884.63, "timestamp": "03:34:44", "text": "解决这个问题。我们不会搬家"}, {"type": "subtitle", "time": 12889.11, "timestamp": "03:34:49", "text": "一寸一寸地挪动，直到我把这只眼睛固定住。"}, {"type": "subtitle", "time": 12898.95, "timestamp": "03:34:58", "text": "[音乐]"}]
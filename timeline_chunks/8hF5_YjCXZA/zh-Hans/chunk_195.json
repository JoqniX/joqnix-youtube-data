[{"type": "subtitle", "time": 11703.91, "timestamp": "03:15:03", "text": "给我的东西。意义"}, {"type": "subtitle", "time": 11707.75, "timestamp": "03:15:07", "text": "意思是，呃，就像是头发的药。"}, {"type": "subtitle", "time": 11709.91, "timestamp": "03:15:09", "text": "是的，我忘了提一下那些……"}, {"type": "subtitle", "time": 11714.71, "timestamp": "03:15:14", "text": "正在收听，呃，我试着剪掉了我的头发"}, {"type": "subtitle", "time": 11716.229, "timestamp": "03:15:16", "text": "因为头皮屑问题，"}, {"type": "subtitle", "time": 11719.75, "timestamp": "03:15:19", "text": "一切。你猜怎么着？就像"}, {"type": "subtitle", "time": 11722.79, "timestamp": "03:15:22", "text": "非常严重的事情。最后，我"}, {"type": "subtitle", "time": 11727.11, "timestamp": "03:15:27", "text": "真是我的天哪。是的。哇。我无法拖动。我"}, {"type": "subtitle", "time": 11732.55, "timestamp": "03:15:32", "text": "不行，我不能拖拽。我无法拖动。"}, {"type": "subtitle", "time": 11735.91, "timestamp": "03:15:35", "text": "哇。哇。"}, {"type": "subtitle", "time": 11738.63, "timestamp": "03:15:38", "text": "请。哦。哦。"}, {"type": "subtitle", "time": 11741.83, "timestamp": "03:15:41", "text": "哦，我忘了。我为什么会玩这个游戏？"}, {"type": "subtitle", "time": 11744.55, "timestamp": "03:15:44", "text": "我无法拖动。"}, {"type": "subtitle", "time": 11753.75, "timestamp": "03:15:53", "text": "哦，有时候管用。它不起作用。"}, {"type": "subtitle", "time": 11755.03, "timestamp": "03:15:55", "text": "有时。"}]
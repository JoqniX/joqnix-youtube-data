[{"type": "subtitle", "time": 2580.069, "timestamp": "00:43:00", "text": "呃，问题是我不记得了。"}, {"type": "subtitle", "time": 2589.109, "timestamp": "00:43:09", "text": "我不记得我注册过哪些账号了。呃"}, {"type": "subtitle", "time": 2592.069, "timestamp": "00:43:12", "text": "我知道我像个奥尼克西亚人一样。"}, {"type": "subtitle", "time": 2594.87, "timestamp": "00:43:14", "text": "呃，Onexia PayPal 账户，然后就……"}, {"type": "subtitle", "time": 2598.069, "timestamp": "00:43:18", "text": "也受到限制，因为"}, {"type": "subtitle", "time": 2600.95, "timestamp": "00:43:20", "text": "我无法证实。我没有"}, {"type": "subtitle", "time": 2605.829, "timestamp": "00:43:25", "text": "注册的东西"}, {"type": "subtitle", "time": 2609.19, "timestamp": "00:43:29", "text": "然后呃"}, {"type": "subtitle", "time": 2612.47, "timestamp": "00:43:32", "text": "竞速磷虾钱包，但我没有"}, {"type": "subtitle", "time": 2616.63, "timestamp": "00:43:36", "text": "虽然是注册企业，但对运动员来说"}, {"type": "subtitle", "time": 2618.47, "timestamp": "00:43:38", "text": "一切"}, {"type": "subtitle", "time": 2621.589, "timestamp": "00:43:41", "text": "那不是个问题。"}, {"type": "subtitle", "time": 2624.47, "timestamp": "00:43:44", "text": "说实话，我希望我能拥有……"}, {"type": "subtitle", "time": 2628.069, "timestamp": "00:43:48", "text": "自定义付费，呃，就像付费墙之类的东西"}, {"type": "subtitle", "time": 2629.91, "timestamp": "00:43:49", "text": "在我的网站上或其他地方"}, {"type": "subtitle", "time": 2633.03, "timestamp": "00:43:53", "text": "捐款。但为此我需要跑步"}, {"type": "subtitle", "time": 2635.67, "timestamp": "00:43:55", "text": "在印度办公室附近转转，然后去"}, {"type": "subtitle", "time": 2638.71, "timestamp": "00:43:58", "text": "与 Racer Prey 和很多呃……东西"}]
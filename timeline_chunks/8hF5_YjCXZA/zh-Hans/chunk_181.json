[{"type": "subtitle", "time": 10860.87, "timestamp": "03:01:00", "text": "你想看看这个东西吗？好的，"}, {"type": "subtitle", "time": 10862.71, "timestamp": "03:01:02", "text": "让我"}, {"type": "subtitle", "time": 10872.15, "timestamp": "03:01:12", "text": "好的，我们来谈谈抛光。好的，就是这样。"}, {"type": "subtitle", "time": 10874.95, "timestamp": "03:01:14", "text": "应该像这样：我把这个调低一点。"}, {"type": "subtitle", "time": 10877.11, "timestamp": "03:01:17", "text": "少量。"}, {"type": "subtitle", "time": 10879.429, "timestamp": "03:01:19", "text": "把这个调低一点，这样你就能看到了。"}, {"type": "subtitle", "time": 10884.309, "timestamp": "03:01:24", "text": "它。看，把它放在角落里。好的，"}, {"type": "subtitle", "time": 10887.91, "timestamp": "03:01:27", "text": "三、二、一。快点。"}, {"type": "subtitle", "time": 10890.469, "timestamp": "03:01:30", "text": "哦，等等。我忘了充电。哦，我的"}, {"type": "subtitle", "time": 10895.11, "timestamp": "03:01:35", "text": "上帝。你在开玩笑吧？好的。 3 2 1。"}, {"type": "subtitle", "time": 10907.99, "timestamp": "03:01:47", "text": "呃，等等。我需要把它横过来吗？"}, {"type": "subtitle", "time": 10913.83, "timestamp": "03:01:53", "text": "那就是鱼。"}, {"type": "subtitle", "time": 10917.51, "timestamp": "03:01:57", "text": "呃，它真的可见吗？"}]
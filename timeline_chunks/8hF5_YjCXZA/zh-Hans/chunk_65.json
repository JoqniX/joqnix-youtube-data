[{"type": "subtitle", "time": 3901.51, "timestamp": "01:05:01", "text": "06"}, {"type": "subtitle", "time": 3908.47, "timestamp": "01:05:08", "text": "顺便说一句，那是另一个账号。"}, {"type": "subtitle", "time": 3911.67, "timestamp": "01:05:11", "text": "不是我之前告诉的那个人。"}, {"type": "subtitle", "time": 3918.63, "timestamp": "01:05:18", "text": "你必须记住你的账号。"}, {"type": "subtitle", "time": 3921.109, "timestamp": "01:05:21", "text": "那确实有这么回事。"}, {"type": "subtitle", "time": 3923.91, "timestamp": "01:05:23", "text": "我把它作为联系方式放进了我的邮箱里。"}, {"type": "subtitle", "time": 3925.75, "timestamp": "01:05:25", "text": "电话"}, {"type": "subtitle", "time": 3928.069, "timestamp": "01:05:28", "text": "比如银行账号，我把它填进去了。"}, {"type": "subtitle", "time": 3958.35, "timestamp": "01:05:58", "text": "好的，我已经添加了我的银行账户。"}]
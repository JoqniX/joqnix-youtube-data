[{"type": "subtitle", "time": 18000.23, "timestamp": "05:00:00", "text": "再给我打电话，说“呃，任何喜欢的东西”。"}, {"type": "subtitle", "time": 18001.75, "timestamp": "05:00:01", "text": "你已经付款了吗？我"}, {"type": "subtitle", "time": 18005.67, "timestamp": "05:00:05", "text": "我当时说：不，我还没有。呃，就像"}, {"type": "subtitle", "time": 18007.59, "timestamp": "05:00:07", "text": "问题是你们太着急了。"}, {"type": "subtitle", "time": 18010.628, "timestamp": "05:00:10", "text": "她。我真的以为我已经跟他说过了"}, {"type": "subtitle", "time": 18013.75, "timestamp": "05:00:13", "text": "女孩把信息发给了那位女士，然后她又转发了过去。"}, {"type": "subtitle", "time": 18016.07, "timestamp": "05:00:16", "text": "跟她的经理之类的，还有那个人"}, {"type": "subtitle", "time": 18019.27, "timestamp": "05:00:19", "text": "是那个说话的人，他们呃"}, {"type": "subtitle", "time": 18022.23, "timestamp": "05:00:22", "text": "呃，就像他们聊了很多之后"}, {"type": "subtitle", "time": 18023.99, "timestamp": "05:00:23", "text": "就像"}, {"type": "subtitle", "time": 18027.27, "timestamp": "05:00:27", "text": "呃，他们就好像在说，你付了2000美元。"}, {"type": "subtitle", "time": 18029.51, "timestamp": "05:00:29", "text": "我们负责归档和其他一切事宜。"}, {"type": "subtitle", "time": 18031.67, "timestamp": "05:00:31", "text": "可以核对所有内容是否正确，或者"}, {"type": "subtitle", "time": 18034.708, "timestamp": "05:00:34", "text": "如果一切顺利，那就不是之后的事了。"}, {"type": "subtitle", "time": 18037.91, "timestamp": "05:00:37", "text": "然后只需要付那一千块钱之类的。"}, {"type": "subtitle", "time": 18040.948, "timestamp": "05:00:40", "text": "他竟敢说2000就像"}, {"type": "subtitle", "time": 18044.628, "timestamp": "05:00:44", "text": "对你我来说，什么事都没有。你怎么能这样？"}, {"type": "subtitle", "time": 18047.11, "timestamp": "05:00:47", "text": "你说2000不算什么？有许多"}, {"type": "subtitle", "time": 18050.868, "timestamp": "05:00:50", "text": "那些字面意义上的人"}, {"type": "subtitle", "time": 18053.75, "timestamp": "05:00:53", "text": "想要至少有10卢比，但是"}, {"type": "subtitle", "time": 18056.55, "timestamp": "05:00:56", "text": "街上那些人甚至连……都没有"}, {"type": "subtitle", "time": 18059.83, "timestamp": "05:00:59", "text": "吃饭和买东西的钱。还有那个小鬼"}]
[{"type": "subtitle", "time": 1142.23, "timestamp": "00:19:02", "text": "捐赠，进行财务"}, {"type": "subtitle", "time": 1145.19, "timestamp": "00:19:05", "text": "支持目标以及所有的一切"}, {"type": "subtitle", "time": 1149.029, "timestamp": "00:19:09", "text": "这意义重大。"}, {"type": "subtitle", "time": 1153.27, "timestamp": "00:19:13", "text": "这算是信任的一部分吧。不，我"}, {"type": "subtitle", "time": 1183.27, "timestamp": "00:19:43", "text": "我可能需要增加计时器的时间。"}, {"type": "subtitle", "time": 1186.549, "timestamp": "00:19:46", "text": "正确的？没关系。让它降下来"}, {"type": "subtitle", "time": 1190.23, "timestamp": "00:19:50", "text": "零，然后呃，到五之类的。"}, {"type": "subtitle", "time": 1193.669, "timestamp": "00:19:53", "text": "那我只需增加时间即可"}, {"type": "subtitle", "time": 1196.07, "timestamp": "00:19:56", "text": "因为我们做的不是像无上限那样"}, {"type": "subtitle", "time": 1199.19, "timestamp": "00:19:59", "text": "是萨巴顿乐队之类的，对吧？那就像"}]
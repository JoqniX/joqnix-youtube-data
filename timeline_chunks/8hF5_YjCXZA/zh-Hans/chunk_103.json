[{"type": "subtitle", "time": 6180.47, "timestamp": "01:43:00", "text": "这让我想起了我写“呃”的那段时间"}, {"type": "subtitle", "time": 6182.95, "timestamp": "01:43:02", "text": "就像动漫剧情一样，我的英语"}, {"type": "subtitle", "time": 6191.51, "timestamp": "01:43:11", "text": "它与战争有关，或者与英国战争有关。"}, {"type": "subtitle", "time": 6193.91, "timestamp": "01:43:13", "text": "我遇到了一些事，但我不知道答案。"}, {"type": "subtitle", "time": 6197.43, "timestamp": "01:43:17", "text": "我当时就想，我要写一些动漫战争题材的作品。"}, {"type": "subtitle", "time": 6200.39, "timestamp": "01:43:20", "text": "基于地势的图。我忘了是哪部动漫了"}, {"type": "subtitle", "time": 6202.629, "timestamp": "01:43:22", "text": "写。"}, {"type": "subtitle", "time": 6205.43, "timestamp": "01:43:25", "text": "呃"}, {"type": "subtitle", "time": 6212.31, "timestamp": "01:43:32", "text": "说到这个，回到……"}, {"type": "subtitle", "time": 6220.55, "timestamp": "01:43:40", "text": "最喜欢的动漫角色。我觉得是这样。"}, {"type": "subtitle", "time": 6223.99, "timestamp": "01:43:43", "text": "我会说，呃，我不能说我不知道​​。"}, {"type": "subtitle", "time": 6225.669, "timestamp": "01:43:45", "text": "我最喜欢的角色是谁？我爱"}, {"type": "subtitle", "time": 6232.55, "timestamp": "01:43:52", "text": "英语考试一直都很简单，但是……"}, {"type": "subtitle", "time": 6237.03, "timestamp": "01:43:57", "text": "有七到九份过刊"}]
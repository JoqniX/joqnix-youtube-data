[{"type": "subtitle", "time": 14282.87, "timestamp": "03:58:02", "text": "呃，就像我说的，你看，我当时正在……"}, {"type": "subtitle", "time": 14285.59, "timestamp": "03:58:05", "text": "准备好出门去做这件事"}, {"type": "subtitle", "time": 14296.79, "timestamp": "03:58:16", "text": "问题是，我想做这件事，但同时"}, {"type": "subtitle", "time": 14300.63, "timestamp": "03:58:20", "text": "你们这种人真是……特别执着。"}, {"type": "subtitle", "time": 14302.95, "timestamp": "03:58:22", "text": "我，我，我存在信任问题。"}, {"type": "subtitle", "time": 14306.309, "timestamp": "03:58:26", "text": "问题所在。另外，我还注意到了一些评论。"}, {"type": "subtitle", "time": 14309.349, "timestamp": "03:58:29", "text": "你的收银车。"}, {"type": "subtitle", "time": 14311.83, "timestamp": "03:58:31", "text": "一些"}, {"type": "subtitle", "time": 14314.79, "timestamp": "03:58:34", "text": "呃，我看了你的评价。"}]
[{"type": "subtitle", "time": 7320.709, "timestamp": "02:02:00", "text": "嗯，好的。我会的"}, {"type": "subtitle", "time": 7334.31, "timestamp": "02:02:14", "text": "是的，奢侈品。"}, {"type": "subtitle", "time": 7337.27, "timestamp": "02:02:17", "text": "上面写的是斯里兰卡。哦，是的。和"}, {"type": "subtitle", "time": 7341.51, "timestamp": "02:02:21", "text": "哦，奢侈品曾经是件很时髦的事。我忘了。"}, {"type": "subtitle", "time": 7344.87, "timestamp": "02:02:24", "text": "是印度的岛屿还是"}, {"type": "subtitle", "time": 7352.629, "timestamp": "02:02:32", "text": "苏拉"}, {"type": "subtitle", "time": 7355.43, "timestamp": "02:02:35", "text": "P"}, {"type": "subtitle", "time": 7358.47, "timestamp": "02:02:38", "text": "该地貌从大陆延伸而出，"}, {"type": "subtitle", "time": 7361.43, "timestamp": "02:02:41", "text": "与土地相连"}, {"type": "subtitle", "time": 7365.27, "timestamp": "02:02:45", "text": "每个大洲都存在一个这样的阵营。我只是"}, {"type": "subtitle", "time": 7367.91, "timestamp": "02:02:47", "text": "曾是阿拉伯半岛。"}, {"type": "subtitle", "time": 7379.109, "timestamp": "02:02:59", "text": "好的。所以印度是一个"}]
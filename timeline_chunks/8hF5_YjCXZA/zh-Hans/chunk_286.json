[{"type": "subtitle", "time": 17162.15, "timestamp": "04:46:02", "text": "请为我的错误道歉。什么"}, {"type": "subtitle", "time": 17165.03, "timestamp": "04:46:05", "text": "你没有"}, {"type": "subtitle", "time": 17171.73, "timestamp": "04:46:11", "text": "等等，什么？"}, {"type": "subtitle", "time": 17179.67, "timestamp": "04:46:19", "text": "啊，还有五分钟。他将要"}, {"type": "subtitle", "time": 17181.51, "timestamp": "04:46:21", "text": "打电话给男人。"}, {"type": "subtitle", "time": 17210.708, "timestamp": "04:46:50", "text": "我为什么表现不好？为什么我会服用劣质药物？"}, {"type": "subtitle", "time": 17214.23, "timestamp": "04:46:54", "text": "我人生中的决定？啊，"}, {"type": "subtitle", "time": 17216.23, "timestamp": "04:46:56", "text": "真糟糕。"}]
[{"type": "subtitle", "time": 18182.788, "timestamp": "05:03:02", "text": "问题是，我什么都不知道。"}, {"type": "subtitle", "time": 18185.99, "timestamp": "05:03:05", "text": "关于商业或法律方面的事情。"}, {"type": "subtitle", "time": 18189.67, "timestamp": "05:03:09", "text": "我感觉自己如此脆弱，以至于你可以"}, {"type": "subtitle", "time": 18194.23, "timestamp": "05:03:14", "text": "尽我所能地利用我"}, {"type": "subtitle", "time": 18198.39, "timestamp": "05:03:18", "text": "因为我不懂事。"}, {"type": "subtitle", "time": 18206.15, "timestamp": "05:03:26", "text": "所以"}, {"type": "subtitle", "time": 18208.47, "timestamp": "05:03:28", "text": "如果她确定自己无法绑架颜色"}]
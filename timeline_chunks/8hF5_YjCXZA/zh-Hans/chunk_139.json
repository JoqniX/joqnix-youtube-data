[{"type": "subtitle", "time": 8340.87, "timestamp": "02:19:00", "text": "基于物理的恐怖游戏，没有交流"}, {"type": "subtitle", "time": 8354.389, "timestamp": "02:19:14", "text": "我不用担心董事会的事。"}, {"type": "subtitle", "time": 8356.95, "timestamp": "02:19:16", "text": "不到一周就崩溃了。它是"}, {"type": "subtitle", "time": 8358.629, "timestamp": "02:19:18", "text": "从第二周开始，所以是"}, {"type": "subtitle", "time": 8360.309, "timestamp": "02:19:20", "text": "美好的。"}, {"type": "subtitle", "time": 8362.95, "timestamp": "02:19:22", "text": "好的。那么，我们该怎么办？它是"}, {"type": "subtitle", "time": 8365.429, "timestamp": "02:19:25", "text": "快到午饭时间了。所以，我应该玩吗？"}, {"type": "subtitle", "time": 8367.75, "timestamp": "02:19:27", "text": "聊点轻松的话题，还是我们应该聊聊天？"}, {"type": "subtitle", "time": 8376.469, "timestamp": "02:19:36", "text": "东西。"}, {"type": "subtitle", "time": 8378.309, "timestamp": "02:19:38", "text": "伊科鲁斯。"}, {"type": "subtitle", "time": 8380.629, "timestamp": "02:19:40", "text": "我下载了Valerant。我应该就……"}, {"type": "subtitle", "time": 8388.309, "timestamp": "02:19:48", "text": "我注意到来了一位新代理人。我必须"}, {"type": "subtitle", "time": 8392.71, "timestamp": "02:19:52", "text": "现在开始向多个代理进发。 Sio，"}, {"type": "subtitle", "time": 8395.83, "timestamp": "02:19:55", "text": "我有很多经纪人。我需要好的"}, {"type": "subtitle", "time": 8399.27, "timestamp": "02:19:59", "text": "Apex那玩意儿也一样。 Apex 改变了"}]
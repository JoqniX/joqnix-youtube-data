[{"type": "subtitle", "time": 661.59, "timestamp": "00:11:01", "text": "今天会有一些变动。呃"}, {"type": "subtitle", "time": 664.31, "timestamp": "00:11:04", "text": "因为我今天有音乐课。"}, {"type": "subtitle", "time": 668.63, "timestamp": "00:11:08", "text": "显示我有音乐课。耶。我"}, {"type": "subtitle", "time": 670.389, "timestamp": "00:11:10", "text": "我会和你一起参加。"}, {"type": "subtitle", "time": 672.31, "timestamp": "00:11:12", "text": "伙计们。我当然不会露面"}, {"type": "subtitle", "time": 674.55, "timestamp": "00:11:14", "text": "会议、音频或我的音频。"}, {"type": "subtitle", "time": 676.389, "timestamp": "00:11:16", "text": "你们会观看我的所有视频"}, {"type": "subtitle", "time": 678.87, "timestamp": "00:11:18", "text": "在我处理我的董事会事务时"}, {"type": "subtitle", "time": 682.23, "timestamp": "00:11:22", "text": "课程。但今天的特色是……"}, {"type": "subtitle", "time": 685.99, "timestamp": "00:11:25", "text": "今天会演奏音乐。"}, {"type": "subtitle", "time": 687.67, "timestamp": "00:11:27", "text": "[音乐]"}, {"type": "subtitle", "time": 689.67, "timestamp": "00:11:29", "text": "我们今天会演奏音乐。我"}, {"type": "subtitle", "time": 692.47, "timestamp": "00:11:32", "text": "还没收到工资。所以，呃，我有"}, {"type": "subtitle", "time": 697.19, "timestamp": "00:11:37", "text": "付款方式我还在和我的……协商中"}, {"type": "subtitle", "time": 700.389, "timestamp": "00:11:40", "text": "音乐老师，就像我会付钱一样"}, {"type": "subtitle", "time": 703.67, "timestamp": "00:11:43", "text": "本月稍后将按计划分期付款"}, {"type": "subtitle", "time": 706.069, "timestamp": "00:11:46", "text": "过了几天，因为我没收到"}, {"type": "subtitle", "time": 708.47, "timestamp": "00:11:48", "text": "有薪酬的"}, {"type": "subtitle", "time": 714.15, "timestamp": "00:11:54", "text": "下个月的刊物发行之后，就是"}, {"type": "subtitle", "time": 718.87, "timestamp": "00:11:58", "text": "在我的音乐制作课程期间。"}]
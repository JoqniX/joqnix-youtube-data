[{"type": "subtitle", "time": 10740.79, "timestamp": "02:59:00", "text": "你想见她吗？"}, {"type": "subtitle", "time": 10749.75, "timestamp": "02:59:09", "text": "我得确保自己不会把自己困在那里。"}, {"type": "subtitle", "time": 10752.63, "timestamp": "02:59:12", "text": "因为这就是真正的手机。"}, {"type": "subtitle", "time": 10754.87, "timestamp": "02:59:14", "text": "框架设置"}, {"type": "subtitle", "time": 10757.83, "timestamp": "02:59:17", "text": "将会"}, {"type": "subtitle", "time": 10763.83, "timestamp": "02:59:23", "text": "仍在播放。等待仍在进行中"}, {"type": "subtitle", "time": 10767.51, "timestamp": "02:59:27", "text": "流媒体。哇。好的，那很棒。"}, {"type": "subtitle", "time": 10769.91, "timestamp": "02:59:29", "text": "这已经是12小时的直播了。好的。"}, {"type": "subtitle", "time": 10772.79, "timestamp": "02:59:32", "text": "总之，呃，让我赶紧把这件事做完。我"}, {"type": "subtitle", "time": 10776.309, "timestamp": "02:59:36", "text": "当时我正在我的设备上进行测试直播。"}, {"type": "subtitle", "time": 10781.03, "timestamp": "02:59:41", "text": "今天用这个老账号大概7个小时。所以"}, {"type": "subtitle", "time": 10783.91, "timestamp": "02:59:43", "text": "这就是我如此疲惫的原因，因为我不知道"}, {"type": "subtitle", "time": 10785.75, "timestamp": "02:59:45", "text": "总会找到那个频道的。但我仍然"}, {"type": "subtitle", "time": 10789.03, "timestamp": "02:59:49", "text": "当时我就想，呃，笨蛋，你本来可以像我一样。"}, {"type": "subtitle", "time": 10790.95, "timestamp": "02:59:50", "text": "就像我真的直播过一样"}, {"type": "subtitle", "time": 10793.11, "timestamp": "02:59:53", "text": "我的 Jockling 频道，但我感觉……呃，我会"}, {"type": "subtitle", "time": 10796.15, "timestamp": "02:59:56", "text": "把这些都修好就行了，嗯。"}]
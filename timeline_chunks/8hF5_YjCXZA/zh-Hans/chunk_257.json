[{"type": "subtitle", "time": 15423.03, "timestamp": "04:17:03", "text": "胡言乱语，就像我刚才说的那样"}, {"type": "subtitle", "time": 15425.51, "timestamp": "04:17:05", "text": "呃，就像……呃，像针一样，精确地指出了……"}, {"type": "subtitle", "time": 15427.429, "timestamp": "04:17:07", "text": "评论负面评价之类的东西"}, {"type": "subtitle", "time": 15430.95, "timestamp": "04:17:10", "text": "我当时就像希望我能把他放进去一样"}, {"type": "subtitle", "time": 15432.79, "timestamp": "04:17:12", "text": "发言人，但问题是他称他为“他”。"}, {"type": "subtitle", "time": 15434.87, "timestamp": "04:17:14", "text": "他说他叫的是我的真名，所以才这样。"}, {"type": "subtitle", "time": 15439.83, "timestamp": "04:17:19", "text": "我不想泄露自己的个人信息，所以……"}, {"type": "subtitle", "time": 15451.11, "timestamp": "04:17:31", "text": "嗯……我应该直接给他们发信息说吗？"}, {"type": "subtitle", "time": 15462.63, "timestamp": "04:17:42", "text": "他们会像这样看待这个人。"}, {"type": "subtitle", "time": 15468.469, "timestamp": "04:17:48", "text": "呃，我真的不知道"}, {"type": "subtitle", "time": 15473.59, "timestamp": "04:17:53", "text": "浪费了我们的时间。他们说，他们就是。"}, {"type": "subtitle", "time": 15475.51, "timestamp": "04:17:55", "text": "他们很着急，因为明天……"}]
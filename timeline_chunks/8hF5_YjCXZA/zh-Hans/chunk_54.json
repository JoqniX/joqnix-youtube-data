[{"type": "subtitle", "time": 3255.51, "timestamp": "00:54:15", "text": "从虫害中幸存下来，而且它甚至还不是神圣的。"}, {"type": "subtitle", "time": 3259.99, "timestamp": "00:54:19", "text": "哦，对了，洒红节快到了。哦，"}, {"type": "subtitle", "time": 3262.71, "timestamp": "00:54:22", "text": "你们为圣徒做了些什么？我从未"}, {"type": "subtitle", "time": 3265.91, "timestamp": "00:54:25", "text": "庆祝过圣日，所以我不会"}, {"type": "subtitle", "time": 3267.589, "timestamp": "00:54:27", "text": "知道，"}, {"type": "subtitle", "time": 3270.79, "timestamp": "00:54:30", "text": "男人。如果我还在浦那之类的地方，我"}, {"type": "subtitle", "time": 3274.63, "timestamp": "00:54:34", "text": "本来可以体验一下户外洒红节的。"}]
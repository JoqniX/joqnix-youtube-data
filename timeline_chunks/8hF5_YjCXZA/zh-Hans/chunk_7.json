[{"type": "subtitle", "time": 420.07, "timestamp": "00:07:00", "text": "我爸好像带了个蚊帐之类的东西。"}, {"type": "subtitle", "time": 422.95, "timestamp": "00:07:02", "text": "东西。我可以把它放在窗户上。"}, {"type": "subtitle", "time": 426.23, "timestamp": "00:07:06", "text": "因为这些苍蝇和各种各样的"}, {"type": "subtitle", "time": 430.79, "timestamp": "00:07:10", "text": "奇怪的昆虫从左边飞进来"}, {"type": "subtitle", "time": 433.83, "timestamp": "00:07:13", "text": "正确的。有点疼，"}, {"type": "subtitle", "time": 438.95, "timestamp": "00:07:18", "text": "但事情就是这样。但即便如此，"}, {"type": "subtitle", "time": 441.43, "timestamp": "00:07:21", "text": "我需要尽我所能做好装饰工作。"}, {"type": "subtitle", "time": 444.23, "timestamp": "00:07:24", "text": "所有物品。"}, {"type": "subtitle", "time": 469.35, "timestamp": "00:07:49", "text": "哦，还有什么没发生？哦，等等。没关系。"}, {"type": "subtitle", "time": 476.469, "timestamp": "00:07:56", "text": "我的天啊。我到底在说什么？不"}, {"type": "subtitle", "time": 478.869, "timestamp": "00:07:58", "text": "记住我的话。"}]
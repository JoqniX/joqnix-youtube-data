[{"type": "subtitle", "time": 16440.15, "timestamp": "04:34:00", "text": "我的天啊。"}, {"type": "subtitle", "time": 16442.949, "timestamp": "04:34:02", "text": "我的天，你害怕了。我当时就是这样，我当时就是这样"}, {"type": "subtitle", "time": 16451.83, "timestamp": "04:34:11", "text": "你知道你能做什么吗？切之前"}, {"type": "subtitle", "time": 16453.189, "timestamp": "04:34:13", "text": "打电话时，把手机放在球下面。"}, {"type": "subtitle", "time": 16456.551, "timestamp": "04:34:16", "text": "用这个攻击他们。"}, {"type": "subtitle", "time": 16459.91, "timestamp": "04:34:19", "text": "那样做太没礼貌了。"}, {"type": "subtitle", "time": 16463.109, "timestamp": "04:34:23", "text": "那岂不是很糟糕吗？"}, {"type": "subtitle", "time": 16465.83, "timestamp": "04:34:25", "text": "天哪，我觉得这样和这样"}, {"type": "subtitle", "time": 16470.629, "timestamp": "04:34:30", "text": "性格和我喜欢的东西，"}, {"type": "subtitle", "time": 16472.789, "timestamp": "04:34:32", "text": "嗯，"}, {"type": "subtitle", "time": 16476.07, "timestamp": "04:34:36", "text": "我怀疑自己能否在现实世界中生存下来。"}, {"type": "subtitle", "time": 16484.551, "timestamp": "04:34:44", "text": "你今天想做什么？这"}, {"type": "subtitle", "time": 16487.109, "timestamp": "04:34:47", "text": "问题是，现在我犯了个错误"}, {"type": "subtitle", "time": 16489.189, "timestamp": "04:34:49", "text": "PayPal。"}, {"type": "subtitle", "time": 16492.31, "timestamp": "04:34:52", "text": "我其实打错了字，把“my”写成了“my”。"}, {"type": "subtitle", "time": 16499.91, "timestamp": "04:34:59", "text": "是的。嗯"}]
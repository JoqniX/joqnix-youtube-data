[{"type": "subtitle", "time": 19927.03, "timestamp": "05:32:07", "text": "如果听起来像那样，那么我们就可以"}, {"type": "subtitle", "time": 19929.67, "timestamp": "05:32:09", "text": "我们需要架设鼓。我们会的"}, {"type": "subtitle", "time": 19932.628, "timestamp": "05:32:12", "text": "稍后会讲到。但，"}, {"type": "subtitle", "time": 19936.548, "timestamp": "05:32:16", "text": "呃，就是速度那个东西，"}, {"type": "subtitle", "time": 19942.868, "timestamp": "05:32:22", "text": "我们可以帮中间人，我们可以"}, {"type": "subtitle", "time": 19951.91, "timestamp": "05:32:31", "text": "[音乐]"}, {"type": "subtitle", "time": 19953.99, "timestamp": "05:32:33", "text": "不知道这样听起来是否合适，或者"}, {"type": "subtitle", "time": 19974.15, "timestamp": "05:32:54", "text": "更大的音量平移。我可以做"}, {"type": "subtitle", "time": 19977.03, "timestamp": "05:32:57", "text": "用那个方式平移。有数百万个"}]
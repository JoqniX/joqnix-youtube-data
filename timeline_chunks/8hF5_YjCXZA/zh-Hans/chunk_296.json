[{"type": "subtitle", "time": 17762.55, "timestamp": "04:56:02", "text": "为了金钱，为了一切。"}, {"type": "subtitle", "time": 17770.47, "timestamp": "04:56:10", "text": "呃呃，欢迎来到 Roku 直播间。"}, {"type": "subtitle", "time": 17774.47, "timestamp": "04:56:14", "text": "你正在见证我痛苦的时刻。"}, {"type": "subtitle", "time": 17786.07, "timestamp": "04:56:26", "text": "我躲过了这场骗局。为什么？"}, {"type": "subtitle", "time": 17788.55, "timestamp": "04:56:28", "text": "十分之六？因为我说过"}, {"type": "subtitle", "time": 17791.11, "timestamp": "04:56:31", "text": "因为我说了那句话。"}, {"type": "subtitle", "time": 17794.55, "timestamp": "04:56:34", "text": "我的意思是，他说话的方式，他"}, {"type": "subtitle", "time": 17800.07, "timestamp": "04:56:40", "text": "他说他说话的方式，他说他说话的方式"}, {"type": "subtitle", "time": 17807.27, "timestamp": "04:56:47", "text": "就像他问的那样，有没有什么技术方面的问题？"}, {"type": "subtitle", "time": 17810.788, "timestamp": "04:56:50", "text": "至于原因，我说是因为"}]
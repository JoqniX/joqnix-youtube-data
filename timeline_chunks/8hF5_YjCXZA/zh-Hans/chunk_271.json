[{"type": "subtitle", "time": 16273.75, "timestamp": "04:31:13", "text": "呃，现在应该是2点30分了。哦，他们是"}, {"type": "subtitle", "time": 16277.349, "timestamp": "04:31:17", "text": "准备打电话。"}, {"type": "subtitle", "time": 16279.59, "timestamp": "04:31:19", "text": "所以，如果他们打电话给我，我会说什么？"}, {"type": "subtitle", "time": 16282.07, "timestamp": "04:31:22", "text": "再次？呃，你看，呃，我很抱歉"}, {"type": "subtitle", "time": 16285.429, "timestamp": "04:31:25", "text": "虽然这么说，但我已经改变主意了。"}, {"type": "subtitle", "time": 16289.83, "timestamp": "04:31:29", "text": "呃，我不会，我会，呃，我会尽量不"}, {"type": "subtitle", "time": 16293.51, "timestamp": "04:31:33", "text": "我今晚不试了。呃，你看，我有"}, {"type": "subtitle", "time": 16295.99, "timestamp": "04:31:35", "text": "我改变主意了。我对此不感兴趣"}, {"type": "subtitle", "time": 16298.55, "timestamp": "04:31:38", "text": "和你们一起做这件事。谢谢你"}, {"type": "subtitle", "time": 16300.389, "timestamp": "04:31:40", "text": "你的时间。"}, {"type": "subtitle", "time": 16304.389, "timestamp": "04:31:44", "text": "再见。我接的电话没错。"}]
[{"type": "subtitle", "time": 15909.51, "timestamp": "04:25:09", "text": "你知道吗？我会依靠"}, {"type": "subtitle", "time": 15912.63, "timestamp": "04:25:12", "text": "还有香兰叶制品。他们认识那两个人"}, {"type": "subtitle", "time": 15915.59, "timestamp": "04:25:15", "text": "人与生意无关。他们很友善"}, {"type": "subtitle", "time": 15917.91, "timestamp": "04:25:17", "text": "与法律方面关系良好。我会 我会 我会"}, {"type": "subtitle", "time": 15920.149, "timestamp": "04:25:20", "text": "接近他们"}, {"type": "subtitle", "time": 15922.309, "timestamp": "04:25:22", "text": "和"}, {"type": "subtitle", "time": 15926.71, "timestamp": "04:25:26", "text": "问问该怎么做以及所有事情"}, {"type": "subtitle", "time": 15928.95, "timestamp": "04:25:28", "text": "适当地。"}, {"type": "subtitle", "time": 15936.229, "timestamp": "04:25:36", "text": "这时我可能会被骗。"}, {"type": "subtitle", "time": 15938.71, "timestamp": "04:25:38", "text": "真正的印度骗局，或者类似的东西"}, {"type": "subtitle", "time": 15941.91, "timestamp": "04:25:41", "text": "我看到评论的方式。你为什么这么……"}, {"type": "subtitle", "time": 15945.75, "timestamp": "04:25:45", "text": "对他们很好，诸如此类"}, {"type": "subtitle", "time": 15948.07, "timestamp": "04:25:48", "text": "难道不应该尊重他人吗？"}, {"type": "subtitle", "time": 15950.389, "timestamp": "04:25:50", "text": "你不应该有那种自私的想法。"}, {"type": "subtitle", "time": 15952.07, "timestamp": "04:25:52", "text": "态度问题之类的，对吧？什么时候"}, {"type": "subtitle", "time": 15953.91, "timestamp": "04:25:53", "text": "与……交谈"}, {"type": "subtitle", "time": 15955.429, "timestamp": "04:25:55", "text": "人们，"}, {"type": "subtitle", "time": 15957.51, "timestamp": "04:25:57", "text": "正确的？"}]
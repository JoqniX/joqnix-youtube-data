[{"type": "subtitle", "time": 11340.469, "timestamp": "03:09:00", "text": "两组，我的意思是，是的，两种不同的"}, {"type": "subtitle", "time": 11343.59, "timestamp": "03:09:03", "text": "两种我都买了"}, {"type": "subtitle", "time": 11346.87, "timestamp": "03:09:06", "text": "无线设置。所以，这些愚蠢的家伙就到此为止吧。"}, {"type": "subtitle", "time": 11350.63, "timestamp": "03:09:10", "text": "笨重的电线玩意儿。我真的可以这么说"}, {"type": "subtitle", "time": 11352.63, "timestamp": "03:09:12", "text": "绕着"}, {"type": "subtitle", "time": 11354.87, "timestamp": "03:09:14", "text": "嗯，你刚才说的那个新试点计划。"}, {"type": "subtitle", "time": 11357.91, "timestamp": "03:09:17", "text": "不过话说回来。是的。问题是我"}, {"type": "subtitle", "time": 11360.95, "timestamp": "03:09:20", "text": "急着离开，就像急着……"}, {"type": "subtitle", "time": 11363.83, "timestamp": "03:09:23", "text": "因为我爸点餐的方式就像我爸没点餐一样"}, {"type": "subtitle", "time": 11366.389, "timestamp": "03:09:26", "text": "他想表现得好像很累似的"}, {"type": "subtitle", "time": 11368.63, "timestamp": "03:09:28", "text": "旅行。好的。"}, {"type": "subtitle", "time": 11371.67, "timestamp": "03:09:31", "text": "他返程回来后非常疲惫。"}, {"type": "subtitle", "time": 11374.55, "timestamp": "03:09:34", "text": "从他家"}, {"type": "subtitle", "time": 11377.51, "timestamp": "03:09:37", "text": "但有点远。所以他又回来了。"}, {"type": "subtitle", "time": 11379.59, "timestamp": "03:09:39", "text": "从火车上下来。他太累了。我当时就像"}, {"type": "subtitle", "time": 11382.309, "timestamp": "03:09:42", "text": "我不想烦他，让他放弃我。"}, {"type": "subtitle", "time": 11385.75, "timestamp": "03:09:45", "text": "我要去我的新地方了。所以呢"}, {"type": "subtitle", "time": 11388.309, "timestamp": "03:09:48", "text": "我问他，这样做是否可以……"}, {"type": "subtitle", "time": 11391.349, "timestamp": "03:09:51", "text": "比如叫Uber之类的。然后我"}, {"type": "subtitle", "time": 11394.469, "timestamp": "03:09:54", "text": "我买了，但是因为……我迟到了。"}, {"type": "subtitle", "time": 11397.83, "timestamp": "03:09:57", "text": "东西带齐了，我忘了带药。但"}]
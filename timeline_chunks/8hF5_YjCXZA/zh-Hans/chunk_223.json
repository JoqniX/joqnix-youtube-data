[{"type": "subtitle", "time": 13413.51, "timestamp": "03:43:33", "text": "他们给我的操作是正确的"}, {"type": "subtitle", "time": 13415.03, "timestamp": "03:43:35", "text": "正确提取最大金额"}, {"type": "subtitle", "time": 13417.75, "timestamp": "03:43:37", "text": "至少那里"}, {"type": "subtitle", "time": 13425.59, "timestamp": "03:43:45", "text": "我和妻子损失了一大笔钱。"}, {"type": "subtitle", "time": 13427.429, "timestamp": "03:43:47", "text": "工作还没完成，团队没有回应。"}, {"type": "subtitle", "time": 13429.59, "timestamp": "03:43:49", "text": "收到钱后，我却被指责有错。"}, {"type": "subtitle", "time": 13432.79, "timestamp": "03:43:52", "text": "如果你曾是哦的受害者"}, {"type": "subtitle", "time": 13435.67, "timestamp": "03:43:55", "text": "我的天啊，我看到了好多糟糕的事情。"}, {"type": "subtitle", "time": 13438.79, "timestamp": "03:43:58", "text": "关于他们"}]
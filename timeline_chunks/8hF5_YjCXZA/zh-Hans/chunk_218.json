[{"type": "subtitle", "time": 13081.51, "timestamp": "03:38:01", "text": "好的。希望你喜欢那场滑稽剧。"}, {"type": "subtitle", "time": 13096.15, "timestamp": "03:38:16", "text": "呃，我想听听你的意见。"}, {"type": "subtitle", "time": 13099.429, "timestamp": "03:38:19", "text": "所以，呃，你还记得我们当时试图做什么吗？"}, {"type": "subtitle", "time": 13103.429, "timestamp": "03:38:23", "text": "呃，我试着用剃须胶带做点什么，"}, {"type": "subtitle", "time": 13104.95, "timestamp": "03:38:24", "text": "正确的？"}, {"type": "subtitle", "time": 13109.67, "timestamp": "03:38:29", "text": "所以，那些人显然给我打了电话。"}, {"type": "subtitle", "time": 13112.229, "timestamp": "03:38:32", "text": "呃，然后问了关于"}, {"type": "subtitle", "time": 13113.91, "timestamp": "03:38:33", "text": "呃，我想做的是"}, {"type": "subtitle", "time": 13116.389, "timestamp": "03:38:36", "text": "注册公司等等。"}, {"type": "subtitle", "time": 13118.229, "timestamp": "03:38:38", "text": "所以，"}, {"type": "subtitle", "time": 13121.11, "timestamp": "03:38:41", "text": "所以对于单人木瓜船这件事来说，是这样的"}, {"type": "subtitle", "time": 13123.269, "timestamp": "03:38:43", "text": "3,000"}, {"type": "subtitle", "time": 13125.349, "timestamp": "03:38:45", "text": "不知为何，我"}, {"type": "subtitle", "time": 13128.309, "timestamp": "03:38:48", "text": "我不知怎么地苦苦哀求，请求他让我做"}, {"type": "subtitle", "time": 13130.79, "timestamp": "03:38:50", "text": "开始分期付款。他们答应了。"}, {"type": "subtitle", "time": 13132.95, "timestamp": "03:38:52", "text": "和"}, {"type": "subtitle", "time": 13134.79, "timestamp": "03:38:54", "text": "我现在唯一的钱是"}, {"type": "subtitle", "time": 13137.59, "timestamp": "03:38:57", "text": "2,000。所以，我要去银行。"}]
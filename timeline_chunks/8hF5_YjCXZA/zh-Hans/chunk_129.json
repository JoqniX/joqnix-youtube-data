[{"type": "subtitle", "time": 7758.87, "timestamp": "02:09:18", "text": "还。我今天刚在Steam上看到这个。哦"}, {"type": "subtitle", "time": 7760.55, "timestamp": "02:09:20", "text": "我的上帝。等等，等等，等等，等等。让我"}, {"type": "subtitle", "time": 7762.55, "timestamp": "02:09:22", "text": "打开Steam。让我打开Steam。让我"}, {"type": "subtitle", "time": 7765.83, "timestamp": "02:09:25", "text": "打开Steam。 Steam.com。等等，等等，等等。"}, {"type": "subtitle", "time": 7775.669, "timestamp": "02:09:35", "text": "吉娅"}, {"type": "subtitle", "time": 7778.629, "timestamp": "02:09:38", "text": "官方说法是“我的天哪”。未来"}, {"type": "subtitle", "time": 7781.43, "timestamp": "02:09:41", "text": "巴基斯坦复兴计划出台了。哦，我的"}, {"type": "subtitle", "time": 7785.51, "timestamp": "02:09:45", "text": "上帝。轻小说。没有视觉小说。"}]
[{"type": "subtitle", "time": 14880.79, "timestamp": "04:08:00", "text": "我不知道。我在做什么？那个东西"}, {"type": "subtitle", "time": 14883.83, "timestamp": "04:08:03", "text": "你们都知道我很容易被骗。我是"}, {"type": "subtitle", "time": 14887.11, "timestamp": "04:08:07", "text": "容易说服。我很容易被说服"}, {"type": "subtitle", "time": 14894.229, "timestamp": "04:08:14", "text": "我害怕它不起作用。我正在做"}, {"type": "subtitle", "time": 14896.79, "timestamp": "04:08:16", "text": "这样做是为了你们，这样你们将来也能做到。"}, {"type": "subtitle", "time": 14907.83, "timestamp": "04:08:27", "text": "不知道。问题不在于“如果……如果”"}, {"type": "subtitle", "time": 14917.03, "timestamp": "04:08:37", "text": "那个东西"}, {"type": "subtitle", "time": 14919.349, "timestamp": "04:08:39", "text": "那个打电话给你的人是不是像你这样？"}, {"type": "subtitle", "time": 14921.51, "timestamp": "04:08:41", "text": "一个你无法拒绝的朋友，或者一个叔叔"}, {"type": "subtitle", "time": 14938.71, "timestamp": "04:08:58", "text": "如果我爸知道这件事，他肯定会……"}]
[{"type": "subtitle", "time": 10981.11, "timestamp": "03:03:01", "text": "[音乐]"}, {"type": "subtitle", "time": 10984.55, "timestamp": "03:03:04", "text": "所以，我买了一个类似 Skya 坦克的东西"}, {"type": "subtitle", "time": 10986.389, "timestamp": "03:03:06", "text": "东西。"}, {"type": "subtitle", "time": 10988.63, "timestamp": "03:03:08", "text": "哦，是的。"}, {"type": "subtitle", "time": 10992.15, "timestamp": "03:03:12", "text": "那就是他。这就是我吃的食物。"}, {"type": "subtitle", "time": 10995.75, "timestamp": "03:03:15", "text": "给了他五条小鱼"}, {"type": "subtitle", "time": 10999.349, "timestamp": "03:03:19", "text": "东西。其中五个。五小块。"}, {"type": "subtitle", "time": 11002.87, "timestamp": "03:03:22", "text": "五。是的。五。嗯，小的。是的，小"}, {"type": "subtitle", "time": 11005.349, "timestamp": "03:03:25", "text": "早上分批进行。然后我给了他"}, {"type": "subtitle", "time": 11008.71, "timestamp": "03:03:28", "text": "过滤器在哪里？没有过滤器。"}, {"type": "subtitle", "time": 11011.83, "timestamp": "03:03:31", "text": "我需要一片叶子，就像某种特定的叶子。"}, {"type": "subtitle", "time": 11013.83, "timestamp": "03:03:33", "text": "干叶。如果我放进去，就不会有"}, {"type": "subtitle", "time": 11017.75, "timestamp": "03:03:37", "text": "各种真菌之类的东西。我需要做这件事。"}, {"type": "subtitle", "time": 11019.75, "timestamp": "03:03:39", "text": "清除真菌之类的东西。我需要"}, {"type": "subtitle", "time": 11023.11, "timestamp": "03:03:43", "text": "摘一片树叶。我忘了"}, {"type": "subtitle", "time": 11025.67, "timestamp": "03:03:45", "text": "那是什么树？嗯，我得去看看。"}, {"type": "subtitle", "time": 11027.59, "timestamp": "03:03:47", "text": "那个和"}, {"type": "subtitle", "time": 11031.429, "timestamp": "03:03:51", "text": "尽快拿到。"}, {"type": "subtitle", "time": 11033.99, "timestamp": "03:03:53", "text": "他们把它挂牌出售。"}, {"type": "subtitle", "time": 11036.63, "timestamp": "03:03:56", "text": "它能充电吗？我不"}]
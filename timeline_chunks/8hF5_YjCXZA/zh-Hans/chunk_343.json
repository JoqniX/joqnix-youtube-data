[{"type": "subtitle", "time": 20585.99, "timestamp": "05:43:05", "text": "我想带我的库鲁来。我想带来"}, {"type": "subtitle", "time": 20589.91, "timestamp": "05:43:09", "text": "库鲁。我可以带库鲁来吗？库尔很好。"}, {"type": "subtitle", "time": 20591.67, "timestamp": "05:43:11", "text": "告诉你"}, {"type": "subtitle", "time": 20595.51, "timestamp": "05:43:15", "text": "对我来说，这是英国之战。"}, {"type": "subtitle", "time": 20599.99, "timestamp": "05:43:19", "text": "但如果我要展示的话，那就很好了"}, {"type": "subtitle", "time": 20606.47, "timestamp": "05:43:26", "text": "嗯，我们需要珍惜这一点。"}, {"type": "subtitle", "time": 20609.3, "timestamp": "05:43:29", "text": "呃"}, {"type": "subtitle", "time": 20622.59, "timestamp": "05:43:42", "text": "等等，如果可以的话，回到这里。"}]
[{"type": "subtitle", "time": 12428.87, "timestamp": "03:27:08", "text": "[音乐]"}, {"type": "subtitle", "time": 12432.55, "timestamp": "03:27:12", "text": "是的。我抢到了第一名。再试一次。"}, {"type": "subtitle", "time": 12436.55, "timestamp": "03:27:16", "text": "标签：猫 GPD。冷笑。冷笑。哦，瞧。"}, {"type": "subtitle", "time": 12439.83, "timestamp": "03:27:19", "text": "你找到了一只新猫。烟。一位非常健谈的人"}, {"type": "subtitle", "time": 12443.11, "timestamp": "03:27:23", "text": "一只表情丰富的猫。"}, {"type": "subtitle", "time": 12445.59, "timestamp": "03:27:25", "text": "人们总能分辨出它是否快乐或快乐。"}, {"type": "subtitle", "time": 12451.91, "timestamp": "03:27:31", "text": "不是。好的。烟。这个人是Sm。你好。"}, {"type": "subtitle", "time": 12455.17, "timestamp": "03:27:35", "text": "你好，猴子。"}, {"type": "subtitle", "time": 12473.83, "timestamp": "03:27:53", "text": "我的鼠标坏了。有时候"}, {"type": "subtitle", "time": 12475.67, "timestamp": "03:27:55", "text": "有时候能用，有时候不行。"}]
[{"type": "subtitle", "time": 12121.91, "timestamp": "03:22:01", "text": "生日。好了，现在是双轨制了。快乐的"}, {"type": "subtitle", "time": 12124.63, "timestamp": "03:22:04", "text": "祝房东生日快乐"}, {"type": "subtitle", "time": 12127.59, "timestamp": "03:22:07", "text": "那是他的名字。是的。是的。是的。是的。"}, {"type": "subtitle", "time": 12131.51, "timestamp": "03:22:11", "text": "你认识那个叫巴布的人。"}, {"type": "subtitle", "time": 12133.59, "timestamp": "03:22:13", "text": "我的天啊。因为他没有使用……的名字"}, {"type": "subtitle", "time": 12136.71, "timestamp": "03:22:16", "text": "那。我的天啊。我们差点就说他"}, {"type": "subtitle", "time": 12139.83, "timestamp": "03:22:19", "text": "姓名。我的天啊。"}, {"type": "subtitle", "time": 12142.79, "timestamp": "03:22:22", "text": "我的天啊。好的。祝他们幸福。现在回到"}, {"type": "subtitle", "time": 12158.79, "timestamp": "03:22:38", "text": "我差点露面了？我的天啊。哦"}, {"type": "subtitle", "time": 12162.71, "timestamp": "03:22:42", "text": "我神圣的圣母。"}, {"type": "subtitle", "time": 12165.59, "timestamp": "03:22:45", "text": "上帝。"}, {"type": "subtitle", "time": 12174.95, "timestamp": "03:22:54", "text": "鱼腥味。"}, {"type": "subtitle", "time": 12177.91, "timestamp": "03:22:57", "text": "你知道，这就是我花10美元的原因。"}]
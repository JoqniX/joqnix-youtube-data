[{"type": "subtitle", "time": 1561.35, "timestamp": "00:26:01", "text": "或者日记。把每个人的照片都贴上去"}, {"type": "subtitle", "time": 1563.99, "timestamp": "00:26:03", "text": "以及所有的一切。"}, {"type": "subtitle", "time": 1566.23, "timestamp": "00:26:06", "text": "是的，我本来也可以那样做，但我"}, {"type": "subtitle", "time": 1568.31, "timestamp": "00:26:08", "text": "我没有打印机。"}, {"type": "subtitle", "time": 1572.92, "timestamp": "00:26:12", "text": "不，不过没关系。"}, {"type": "subtitle", "time": 1581.12, "timestamp": "00:26:21", "text": "但没关系。"}, {"type": "subtitle", "time": 1584.789, "timestamp": "00:26:24", "text": "[音乐]"}, {"type": "subtitle", "time": 1586.53, "timestamp": "00:26:26", "text": "呃，"}, {"type": "subtitle", "time": 1593.75, "timestamp": "00:26:33", "text": "我会把你所有的 Twitch 账号都添加进去。"}, {"type": "subtitle", "time": 1596.95, "timestamp": "00:26:36", "text": "关注并喜爱他们。请稍等。"}, {"type": "subtitle", "time": 1600.39, "timestamp": "00:26:40", "text": "帕卡，你为什么要这么做？"}, {"type": "subtitle", "time": 1603.59, "timestamp": "00:26:43", "text": "只做那几个。呃，最好这样做"}, {"type": "subtitle", "time": 1607.19, "timestamp": "00:26:47", "text": "那些捐款的人"}, {"type": "subtitle", "time": 1612.149, "timestamp": "00:26:52", "text": "一切。不，这样好多了。哦，"}, {"type": "subtitle", "time": 1613.83, "timestamp": "00:26:53", "text": "问题是，我本来可以拥有它。"}]
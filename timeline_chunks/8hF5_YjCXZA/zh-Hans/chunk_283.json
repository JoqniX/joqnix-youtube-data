[{"type": "subtitle", "time": 16980.788, "timestamp": "04:43:00", "text": "到"}, {"type": "subtitle", "time": 16985.19, "timestamp": "04:43:05", "text": "负责这项工作。和"}, {"type": "subtitle", "time": 16988.628, "timestamp": "04:43:08", "text": "他肯定在忙自己的事情。和"}, {"type": "subtitle", "time": 17008.47, "timestamp": "04:43:28", "text": "[音乐]"}, {"type": "subtitle", "time": 17010.23, "timestamp": "04:43:30", "text": "你知道警察也能让你喝醉吗？"}, {"type": "subtitle", "time": 17014.01, "timestamp": "04:43:34", "text": "糖浆笑话？那确实有这么回事。"}, {"type": "subtitle", "time": 17022.23, "timestamp": "04:43:42", "text": "所以，我很担心。呃"}, {"type": "subtitle", "time": 17024.15, "timestamp": "04:43:44", "text": "我也很抱歉提起这件事。"}, {"type": "subtitle", "time": 17034.788, "timestamp": "04:43:54", "text": "如果那家伙生我的气了"}, {"type": "subtitle", "time": 17037.43, "timestamp": "04:43:57", "text": "他们又生气了，因为我浪费了他们的时间。"}]
[{"type": "subtitle", "time": 21545.19, "timestamp": "05:59:05", "text": "[笑声]"}, {"type": "subtitle", "time": 21553.03, "timestamp": "05:59:13", "text": "呃"}, {"type": "subtitle", "time": 21556.39, "timestamp": "05:59:16", "text": "那是什么来着？嗯"}, {"type": "subtitle", "time": 21565.59, "timestamp": "05:59:25", "text": "我一直在看一个叫……的东西"}, {"type": "subtitle", "time": 21567.67, "timestamp": "05:59:27", "text": "是的。呃，《我独自升级》。我正在观看。"}, {"type": "subtitle", "time": 21571.03, "timestamp": "05:59:31", "text": "这是其中之一。然后是前台接待员那位，"}, {"type": "subtitle", "time": 21572.628, "timestamp": "05:59:32", "text": "这"}, {"type": "subtitle", "time": 21577.27, "timestamp": "05:59:37", "text": "香馥香格里拉边境第二季"}, {"type": "subtitle", "time": 21579.59, "timestamp": "05:59:39", "text": "和"}]
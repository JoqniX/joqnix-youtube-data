[{"type": "subtitle", "time": 10520.07, "timestamp": "02:55:20", "text": "This is a river, right? Okay."}, {"type": "subtitle", "time": 10528.469, "timestamp": "02:55:28", "text": "Imagine if you can fish in the beach."}, {"type": "subtitle", "time": 10531.03, "timestamp": "02:55:31", "text": "Fish it like this."}, {"type": "subtitle", "time": 10534.15, "timestamp": "02:55:34", "text": "That would be so cool."}, {"type": "subtitle", "time": 10538.469, "timestamp": "02:55:38", "text": "I think you can do it."}, {"type": "subtitle", "time": 10540.79, "timestamp": "02:55:40", "text": "You have to be lucky"}]
[{"type": "subtitle", "time": 8467.83, "timestamp": "02:21:07", "text": "還是之後？"}, {"type": "subtitle", "time": 8491.67, "timestamp": "02:21:31", "text": "？我知道。朋友建議我這麼做，所以我就採納了。  你覺得"}, {"type": "subtitle", "time": 8497.349, "timestamp": "02:21:37", "text": "我了解這件事嗎？"}, {"type": "subtitle", "time": 8501.75, "timestamp": "02:21:41", "text": "不貴。  遊戲很貴。我想玩這款分裂式"}, {"type": "subtitle", "time": 8505.349, "timestamp": "02:21:45", "text": "虛構遊戲，但是它要 24.99 美元。盧比。好的。變化很大。"}]
[{"type": "subtitle", "time": 25387.59, "timestamp": "07:03:07", "text": "好的。  Sassy 床鋪 [音樂] 耳機又在我的鍵盤上。  你害怕我。  是不是只有我一個人"}, {"type": "subtitle", "time": 25395.19, "timestamp": "07:03:15", "text": "聽到什麼"}, {"type": "subtitle", "time": 25401.19, "timestamp": "07:03:21", "text": "？等等，你們聽到什麼了嗎？哦，這個聲音讓"}, {"type": "subtitle", "time": 25424.07, "timestamp": "07:03:44", "text": "我很反感。  總有一天我想買下這個許可證。  在此之前，就隨便亂搞吧"}]
[{"type": "subtitle", "time": 22140.47, "timestamp": "06:09:00", "text": "輪迴轉世之類的東西。  對，輪迴轉世和升級之類的。  對，就是那個。讀完之後，我覺得我現在需要做的就是跟上這股魔力。"}, {"type": "subtitle", "time": 22153.99, "timestamp": "06:09:13", "text": "我覺得我接下來需要的是那種高中生打架的比賽，就像"}, {"type": "subtitle", "time": 22159.67, "timestamp": "06:09:19", "text": "高中生打架的那種比賽。"}, {"type": "subtitle", "time": 22164.39, "timestamp": "06:09:24", "text": "我想這就是我接下來要做的事，但我不知道。"}]
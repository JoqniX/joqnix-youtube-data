[{"type": "subtitle", "time": 19881.27, "timestamp": "05:31:21", "text": "希望你一切都好。"}, {"type": "subtitle", "time": 19899.35, "timestamp": "05:31:39", "text": "天哪，"}, {"type": "subtitle", "time": 19902.07, "timestamp": "05:31:42", "text": "我覺得好睏。呃，困。你怎麼樣？希望你一切都好。我很好。我發燒了。我還在恢復中。我在生病期間就開始做我的直播，然後我就來了。好的，"}, {"type": "subtitle", "time": 19918.47, "timestamp": "05:31:58", "text": "現在是4點。馬上就4點半了。我5點有課。"}]
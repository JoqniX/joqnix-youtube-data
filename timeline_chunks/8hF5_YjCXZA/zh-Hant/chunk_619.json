[{"type": "subtitle", "time": 37148.07, "timestamp": "10:19:08", "text": "我要添加縮圖，製作"}, {"type": "subtitle", "time": 37151.11, "timestamp": "10:19:11", "text": "縮圖之類的，然後切換到下一個直播串流。好的，我們的客人正在等候"}, {"type": "subtitle", "time": 37167.11, "timestamp": "10:19:27", "text": "。  呃，讓我受傷。  速通這個關卡。"}, {"type": "subtitle", "time": 37176.63, "timestamp": "10:19:36", "text": "我的天啊。"}, {"type": "subtitle", "time": 37182.63, "timestamp": "10:19:42", "text": "我跑上樓去了，老兄"}]
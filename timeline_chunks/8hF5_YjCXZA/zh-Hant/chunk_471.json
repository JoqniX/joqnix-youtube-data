[{"type": "subtitle", "time": 28270.03, "timestamp": "07:51:10", "text": "一支栓動式步槍。好的。  哦，我的"}, {"type": "subtitle", "time": 28286.548, "timestamp": "07:51:26", "text": "東西用完了。"}, {"type": "subtitle", "time": 28289.27, "timestamp": "07:51:29", "text": "是的。你好。  歡迎來到直播間。 Ch，"}, {"type": "subtitle", "time": 28293.51, "timestamp": "07:51:33", "text": "你好嗎？  我很好。我回來了。我家停電了，所以…… 殺了他們。  也把他們殺了。"}]
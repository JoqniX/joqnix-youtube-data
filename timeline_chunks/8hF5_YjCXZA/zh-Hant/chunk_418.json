[{"type": "subtitle", "time": 25094.708, "timestamp": "06:58:14", "text": "，在我們"}, {"type": "subtitle", "time": 25101.43, "timestamp": "06:58:21", "text": "離開之前，我知道如果我把它留著取暖的話。我再也玩不下去這個"}, {"type": "subtitle", "time": 25106.628, "timestamp": "06:58:26", "text": "遊戲了，但我還是會排隊去玩，因為我知道你不會排隊的，對吧？熱浪查瑪。我不知道為什麼沒人玩"}, {"type": "subtitle", "time": 25129.75, "timestamp": "06:58:49", "text": "這個遊戲模式之類的。  在哪裡？"}, {"type": "subtitle", "time": 25137.99, "timestamp": "06:58:57", "text": "我這就去泡杯茶。  我們會回來的。嗯？"}]
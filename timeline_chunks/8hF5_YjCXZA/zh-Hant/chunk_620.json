[{"type": "subtitle", "time": 37229.03, "timestamp": "10:20:29", "text": "為什麼現在崩潰了？聖。"}, {"type": "subtitle", "time": 37231.746, "timestamp": "10:20:31", "text": "一分鐘。  我的天哪。"}, {"type": "subtitle", "time": 37237.83, "timestamp": "10:20:37", "text": "發發慈悲。  嗯嗯，這就是為什麼，這就是為什麼人們會告訴你，這就是為什麼我會告訴你。這就是我告訴你"}]
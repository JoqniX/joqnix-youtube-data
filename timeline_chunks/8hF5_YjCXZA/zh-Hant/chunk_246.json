[{"type": "subtitle", "time": 14782.87, "timestamp": "04:06:22", "text": "30分。  我很害怕。我很害怕。我很害怕。我很害怕。  我懂了。不，我開玩笑的。"}, {"type": "subtitle", "time": 14784.79, "timestamp": "04:06:24", "text": "我當然會難過，你知道我當然會難過。  我的意思是"}, {"type": "subtitle", "time": 14798.309, "timestamp": "04:06:38", "text": "，你這麼說過，"}, {"type": "subtitle", "time": 14801.67, "timestamp": "04:06:41", "text": "但我知道，面對上帝，我無法呼吸"}]
[{"type": "subtitle", "time": 23280.468, "timestamp": "06:28:00", "text": "等等。  它關門了。好的。沒關係。"}, {"type": "subtitle", "time": 23285.99, "timestamp": "06:28:05", "text": "這些地方人很多。  不，不"}, {"type": "subtitle", "time": 23288.708, "timestamp": "06:28:08", "text": "應該問南德。"}, {"type": "subtitle", "time": 23296.788, "timestamp": "06:28:16", "text": "更像是「哦，不」。  並不是說我想要你們。"}, {"type": "subtitle", "time": 23307.83, "timestamp": "06:28:27", "text": "我的意思是，我當然希望你希望有人能再次光臨。挑戰。  當然，這樣"}, {"type": "subtitle", "time": 23312.948, "timestamp": "06:28:32", "text": "我們就能完成前十名的"}, {"type": "subtitle", "time": 23316.628, "timestamp": "06:28:36", "text": "評選了。如果"}, {"type": "subtitle", "time": 23319.83, "timestamp": "06:28:39", "text": "我至少能殺一個"}]
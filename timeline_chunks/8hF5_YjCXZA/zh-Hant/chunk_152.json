[{"type": "subtitle", "time": 9143.27, "timestamp": "02:32:23", "text": "[音樂] [音樂] 如何嗨起來？呃，（音樂）唐納德在哪兒？  我的天啊。"}, {"type": "subtitle", "time": 9145.19, "timestamp": "02:32:25", "text": "不，我被困住了。  它絕對沒那麼好。  大概就是"}, {"type": "subtitle", "time": 9166.07, "timestamp": "02:32:46", "text": "我說過"}, {"type": "subtitle", "time": 9167.75, "timestamp": "02:32:47", "text": "你或許能幫上忙"}, {"type": "subtitle", "time": 9170.63, "timestamp": "02:32:50", "text": "。  它們在島上安家落戶。"}, {"type": "subtitle", "time": 9172.55, "timestamp": "02:32:52", "text": "我馬上就為你重新打開。拿起漁網"}]
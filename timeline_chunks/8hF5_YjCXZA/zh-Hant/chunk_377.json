[{"type": "subtitle", "time": 22635.91, "timestamp": "06:17:15", "text": "這些就是我一直在讀的書。不是這個。我也不知道為什麼會突然"}, {"type": "subtitle", "time": 22651.99, "timestamp": "06:17:31", "text": "提到這件事。好的。第二人生，對吧？是的。就像任務已經結束了。我的意思就是這樣。這就是你們在談論的右翼主義。"}, {"type": "subtitle", "time": 22660.868, "timestamp": "06:17:40", "text": "就像壞男孩和探索主義一樣相似"}, {"type": "subtitle", "time": 22668.868, "timestamp": "06:17:48", "text": "快點。我被困住了"}]
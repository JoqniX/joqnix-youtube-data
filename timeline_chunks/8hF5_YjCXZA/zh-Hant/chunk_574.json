[{"type": "subtitle", "time": 34442.55, "timestamp": "09:34:02", "text": "我會好好保管它，把它放在我的……嗯……嗯……放在我的……我身邊。  目前我有一台"}, {"type": "subtitle", "time": 34444.71, "timestamp": "09:34:04", "text": "電腦。  我來"}, {"type": "subtitle", "time": 34469.03, "timestamp": "09:34:29", "text": "嗯，我知道我的銀行帳號嗎？  我想我的確有。  我得去辦卡什麼的，但我已經有卡了。"}]
[{"type": "subtitle", "time": 2.629, "timestamp": "00:00:02", "text": "大概30歲或40歲左右吧。"}, {"type": "subtitle", "time": 5.91, "timestamp": "00:00:05", "text": "然後我們就達到50了。接下來的"}, {"type": "subtitle", "time": 9.589, "timestamp": "00:00:09", "text": "直播就會有完整的內容了。"}, {"type": "subtitle", "time": 13.509, "timestamp": "00:00:13", "text": "好的。所以 60 70 80 到 80 結束。"}, {"type": "subtitle", "time": 17.269, "timestamp": "00:00:17", "text": "接下來，嗯，貓咪們整齊地"}, {"type": "subtitle", "time": 19.67, "timestamp": "00:00:19", "text": "排列著。好的。好的。"}, {"type": "subtitle", "time": 22.07, "timestamp": "00:00:22", "text": "再次感謝米娜的光臨。雖然只是短暫地去了果阿，"}, {"type": "subtitle", "time": 25.83, "timestamp": "00:00:25", "text": "但我今天仍然玩得很開心"}, {"type": "subtitle", "time": 31.669, "timestamp": "00:00:31", "text": "今天來的所有人都是"}]
[{"type": "subtitle", "time": 26161.59, "timestamp": "07:16:01", "text": "我為什麼要"}, {"type": "subtitle", "time": 26164.948, "timestamp": "07:16:04", "text": "連接B線和D線？我把它們放在那裡是做什麼用的？"}, {"type": "subtitle", "time": 26170.868, "timestamp": "07:16:10", "text": "所以 Cable Z 就像"}, {"type": "subtitle", "time": 26173.83, "timestamp": "07:16:13", "text": "外部軟體一樣，把一切都連接到串流媒體。所有音訊都應該透過 C 線傳輸。然後"}]
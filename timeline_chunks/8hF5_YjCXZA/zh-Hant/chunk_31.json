[{"type": "subtitle", "time": 1863.029, "timestamp": "00:31:03", "text": "他們會一直直播、直播、直播、直播、直播、直播，"}, {"type": "subtitle", "time": 1869.99, "timestamp": "00:31:09", "text": "但在 YouTube 上我不能，必須在 12 小時後結束直播等等。所以"}, {"type": "subtitle", "time": 1876.23, "timestamp": "00:31:16", "text": "我才想到這麼做，因為我注意到有些人也在 YouTube 上這樣做，他們會一直直播下去。  走吧。"}, {"type": "subtitle", "time": 1907.669, "timestamp": "00:31:47", "text": "哦，對啊，我得製作"}]
[{"type": "subtitle", "time": 360.71, "timestamp": "00:06:00", "text": "我應該盡量"}, {"type": "subtitle", "time": 363.59, "timestamp": "00:06:03", "text": "避免像以前那樣讓它過載"}, {"type": "subtitle", "time": 365.749, "timestamp": "00:06:05", "text": "。所以我會密切注意一切，希望它不要吃太多"}, {"type": "subtitle", "time": 369.27, "timestamp": "00:06:09", "text": "，你知道的。"}, {"type": "subtitle", "time": 371.51, "timestamp": "00:06:11", "text": "但是，是的，我又要說了，哦，天哪，"}, {"type": "subtitle", "time": 377.99, "timestamp": "00:06:17", "text": "飛蛾來了"}, {"type": "subtitle", "time": 380.15, "timestamp": "00:06:20", "text": "。飛蛾來了。你們看到了嗎？魔力來了。我的天啊，"}, {"type": "subtitle", "time": 387.189, "timestamp": "00:06:27", "text": "我要殺了他。我要殺了他。過來，孩子。我要殺了你。"}, {"type": "subtitle", "time": 403.67, "timestamp": "00:06:43", "text": "天哪，我走了。我走了。"}]
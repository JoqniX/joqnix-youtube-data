[{"type": "subtitle", "time": 20221.67, "timestamp": "05:37:01", "text": "80歳で。ああ、そんなことはない。おお。そうそう。"}, {"type": "subtitle", "time": 20224.708, "timestamp": "05:37:04", "text": "ザキさん、思い出させてくれてありがとう。"}, {"type": "subtitle", "time": 20227.51, "timestamp": "05:37:07", "text": "ええと、あなたが尋ねたので、思い出したので"}, {"type": "subtitle", "time": 20231.74, "timestamp": "05:37:11", "text": "ところで、80歳までに何か目標はありますか？"}, {"type": "subtitle", "time": 20235.19, "timestamp": "05:37:15", "text": "[音楽]"}, {"type": "subtitle", "time": 20238.948, "timestamp": "05:37:18", "text": "キャシディは悪い子だ。リズムゲームならできるかもしれないね。"}, {"type": "subtitle", "time": 20248.548, "timestamp": "05:37:28", "text": "えっと、コントロールY。待って、コントロール。削除しました"}, {"type": "subtitle", "time": 20251.83, "timestamp": "05:37:31", "text": "すべて。待って。"}]
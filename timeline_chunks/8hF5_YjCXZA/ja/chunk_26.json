[{"type": "subtitle", "time": 1561.35, "timestamp": "00:26:01", "text": "または日記。みんなの写真を貼って"}, {"type": "subtitle", "time": 1563.99, "timestamp": "00:26:03", "text": "そして全て。"}, {"type": "subtitle", "time": 1566.23, "timestamp": "00:26:06", "text": "ああ、そうすることもできたけど、"}, {"type": "subtitle", "time": 1568.31, "timestamp": "00:26:08", "text": "プリンターを持っていません。"}, {"type": "subtitle", "time": 1572.92, "timestamp": "00:26:12", "text": "いいえ、でも大丈夫です。"}, {"type": "subtitle", "time": 1581.12, "timestamp": "00:26:21", "text": "でも大丈夫。"}, {"type": "subtitle", "time": 1584.789, "timestamp": "00:26:24", "text": "[音楽]"}, {"type": "subtitle", "time": 1586.53, "timestamp": "00:26:26", "text": "えっと、"}, {"type": "subtitle", "time": 1593.75, "timestamp": "00:26:33", "text": "あなたのTwitchアカウントをすべて追加します"}, {"type": "subtitle", "time": 1596.95, "timestamp": "00:26:36", "text": "彼らをフォローし、崇拝しています。少々お待ちください。"}, {"type": "subtitle", "time": 1600.39, "timestamp": "00:26:40", "text": "パカ、なぜそんなことをしたいんだ？"}, {"type": "subtitle", "time": 1603.59, "timestamp": "00:26:43", "text": "一つずつやってみよう。ええと、"}, {"type": "subtitle", "time": 1607.19, "timestamp": "00:26:47", "text": "寄付をしている人たちと"}, {"type": "subtitle", "time": 1612.149, "timestamp": "00:26:52", "text": "すべて。いや、そっちの方がずっといい。おお、"}, {"type": "subtitle", "time": 1613.83, "timestamp": "00:26:53", "text": "問題は、私がそれを手に入れることができたはずだということだ。"}]
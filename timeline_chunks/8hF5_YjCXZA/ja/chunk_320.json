[{"type": "subtitle", "time": 19215.92, "timestamp": "05:20:15", "text": "順調に進んでいる"}, {"type": "subtitle", "time": 19230.948, "timestamp": "05:20:30", "text": "プラグインは無効になっています。"}, {"type": "subtitle", "time": 19234.23, "timestamp": "05:20:34", "text": "ああ、わかった。待って。それで、"}, {"type": "subtitle", "time": 19236.23, "timestamp": "05:20:36", "text": "このプロジェクトファイルは何に関するものですか？"}, {"type": "subtitle", "time": 19238.948, "timestamp": "05:20:38", "text": "え、何？我慢する。"}, {"type": "subtitle", "time": 19241.91, "timestamp": "05:20:41", "text": "これは一例です。"}, {"type": "subtitle", "time": 19244.628, "timestamp": "05:20:44", "text": "作物のファン。ラムラック。ラム酒は何"}, {"type": "subtitle", "time": 19252.47, "timestamp": "05:20:52", "text": "サンプルとは何ですか？サンプルは"}]
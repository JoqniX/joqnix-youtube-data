[{"type": "subtitle", "time": 13882.63, "timestamp": "03:51:22", "text": "ああ、さっきも言ったように、行かなきゃいけないんだ"}, {"type": "subtitle", "time": 13884.469, "timestamp": "03:51:24", "text": "銀行に行って、お金を追加してください。私はしません"}, {"type": "subtitle", "time": 13888.71, "timestamp": "03:51:28", "text": "まだアカウントに入金されていません。"}, {"type": "subtitle", "time": 13896.15, "timestamp": "03:51:36", "text": "ええ、クレジットカードは持っていません"}, {"type": "subtitle", "time": 13904.63, "timestamp": "03:51:44", "text": "うん。うん。うん。私は行くつもりです"}, {"type": "subtitle", "time": 13906.71, "timestamp": "03:51:46", "text": "銀行に預けて、今すぐ追加してください"}]
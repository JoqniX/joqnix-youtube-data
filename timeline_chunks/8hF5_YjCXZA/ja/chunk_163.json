[{"type": "subtitle", "time": 9781.59, "timestamp": "02:43:01", "text": "ええ、サブアトンを実行するのは"}, {"type": "subtitle", "time": 9785.27, "timestamp": "02:43:05", "text": "本当に疲れるよ。"}, {"type": "subtitle", "time": 9787.67, "timestamp": "02:43:07", "text": "それは一つのことだ"}, {"type": "subtitle", "time": 9792.15, "timestamp": "02:43:12", "text": "私は4ヶ月間生き延びなければならなかった"}, {"type": "subtitle", "time": 9814.95, "timestamp": "02:43:34", "text": "えっと、インセンティブについて教えていただけますか？"}, {"type": "subtitle", "time": 9818.07, "timestamp": "02:43:38", "text": "あれ？右。わかった。だから追加できる"}, {"type": "subtitle", "time": 9825.349, "timestamp": "02:43:45", "text": "誰か持っている人がいたら"}]
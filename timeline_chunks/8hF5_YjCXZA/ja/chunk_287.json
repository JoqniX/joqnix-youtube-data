[{"type": "subtitle", "time": 17220.948, "timestamp": "04:47:00", "text": "えっと、私の薬はどこにあるんだっけ？"}, {"type": "subtitle", "time": 17223.11, "timestamp": "04:47:03", "text": "これ、昨日買ったっけ？ああ、"}, {"type": "subtitle", "time": 17231.19, "timestamp": "04:47:11", "text": "[音楽]"}, {"type": "subtitle", "time": 17237.83, "timestamp": "04:47:17", "text": "あなたの顔をコピーしてあげましょうか？ただ言うだけ"}, {"type": "subtitle", "time": 17241.75, "timestamp": "04:47:21", "text": "それ。わかった。あまりひどいことにならないといいんだけど。あなた"}, {"type": "subtitle", "time": 17245.03, "timestamp": "04:47:25", "text": "私のことを知ってください。わかった。コピペをください"}, {"type": "subtitle", "time": 17250.868, "timestamp": "04:47:30", "text": "それは私にとってうまくいきます。どう言えばいいでしょうか。"}, {"type": "subtitle", "time": 17254.07, "timestamp": "04:47:34", "text": "穏やかだが攻撃性は低いタイプで"}, {"type": "subtitle", "time": 17256.39, "timestamp": "04:47:36", "text": "理解"}, {"type": "subtitle", "time": 17259.67, "timestamp": "04:47:39", "text": "えーとタイプ。彼"}, {"type": "subtitle", "time": 17268.47, "timestamp": "04:47:48", "text": "ごめんなさい。 H 練習できますか、もしそれが"}, {"type": "subtitle", "time": 17270.628, "timestamp": "04:47:50", "text": "わかった？"}]
[{"type": "subtitle", "time": 6421.91, "timestamp": "01:47:01", "text": "アカウントには300があります。"}, {"type": "subtitle", "time": 6424.149, "timestamp": "01:47:04", "text": "配信に使用しているメインアカウント"}, {"type": "subtitle", "time": 6425.669, "timestamp": "01:47:05", "text": "は"}, {"type": "subtitle", "time": 6429.27, "timestamp": "01:47:09", "text": "600から。ああ神様、私は苦労しています"}, {"type": "subtitle", "time": 6432.07, "timestamp": "01:47:12", "text": "最低残高。私はできません。わかった、大丈夫。"}, {"type": "subtitle", "time": 6435.43, "timestamp": "01:47:15", "text": "じゃあ、後でやります。ごめんね、みんな。"}, {"type": "subtitle", "time": 6438.31, "timestamp": "01:47:18", "text": "そして、ストリームのお金を受け取ることはできません"}, {"type": "subtitle", "time": 6442.39, "timestamp": "01:47:22", "text": "こうしたことすべてについても同様です。私 私 私"}, {"type": "subtitle", "time": 6444.229, "timestamp": "01:47:24", "text": "デビューの時だけ使う必要がある"}, {"type": "subtitle", "time": 6447.669, "timestamp": "01:47:27", "text": "準備物資と資金"}, {"type": "subtitle", "time": 6454.229, "timestamp": "01:47:34", "text": "[音楽]"}, {"type": "subtitle", "time": 6468.95, "timestamp": "01:47:48", "text": "しかし、最初に私たちの"}, {"type": "subtitle", "time": 6470.95, "timestamp": "01:47:50", "text": "夏休みを取ってから高校へ"}, {"type": "subtitle", "time": 6477.03, "timestamp": "01:47:57", "text": "馬と他の少女たちとの素敵なショー"}]
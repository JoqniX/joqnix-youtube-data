[{"type": "subtitle", "time": 13725.91, "timestamp": "03:48:45", "text": "うん、それでいいよ。はい。"}, {"type": "subtitle", "time": 13727.99, "timestamp": "03:48:47", "text": "うん。うん。その件は、えっと"}, {"type": "subtitle", "time": 13731.189, "timestamp": "03:48:51", "text": "えっと、それは、えっと、思った通りで、"}, {"type": "subtitle", "time": 13733.429, "timestamp": "03:48:53", "text": "君たちが急いでいたのも好きだった"}, {"type": "subtitle", "time": 13735.03, "timestamp": "03:48:55", "text": "今日支払う必要があるように、"}, {"type": "subtitle", "time": 13736.79, "timestamp": "03:48:56", "text": "すべて。だから私は少し"}]
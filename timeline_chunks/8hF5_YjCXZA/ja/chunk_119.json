[{"type": "subtitle", "time": 7140.95, "timestamp": "01:59:00", "text": "何？待って、それはインドの話だよ。"}, {"type": "subtitle", "time": 7144.31, "timestamp": "01:59:04", "text": "それはカシミール地方にある。何？雪が降っています"}, {"type": "subtitle", "time": 7147.27, "timestamp": "01:59:07", "text": "インドで？ああ、現金だよ。わかった。わかった。"}, {"type": "subtitle", "time": 7149.92, "timestamp": "01:59:09", "text": "わかった。 [音楽]"}, {"type": "subtitle", "time": 7159.99, "timestamp": "01:59:19", "text": "私にとって銃は銃だ。ああ、これは音楽だ。"}, {"type": "subtitle", "time": 7174.709, "timestamp": "01:59:34", "text": "ごめんなさい。"}, {"type": "subtitle", "time": 7188.87, "timestamp": "01:59:48", "text": "デザートもあるのは知っていますよ。"}, {"type": "subtitle", "time": 7191.99, "timestamp": "01:59:51", "text": "何だって？"}, {"type": "subtitle", "time": 7195.669, "timestamp": "01:59:55", "text": "両親が私の悪さを知っているかどうかは気にしない"}, {"type": "subtitle", "time": 7198.47, "timestamp": "01:59:58", "text": "このような。何てことだ。彼らはこう言うだろう"}]
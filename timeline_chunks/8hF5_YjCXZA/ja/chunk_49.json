[{"type": "subtitle", "time": 2943.67, "timestamp": "00:49:03", "text": "いいえ、UPI IDのことではありません。私は"}, {"type": "subtitle", "time": 2948.309, "timestamp": "00:49:08", "text": "ジョックニックセット/何か何かうーんアップ"}, {"type": "subtitle", "time": 2951.27, "timestamp": "00:49:11", "text": "ID。名前と商人のことです"}, {"type": "subtitle", "time": 2953.51, "timestamp": "00:49:13", "text": "名前。"}, {"type": "subtitle", "time": 2956.23, "timestamp": "00:49:16", "text": "GitHub で作業を続けてください。私は"}, {"type": "subtitle", "time": 2963.67, "timestamp": "00:49:23", "text": "もちろんそうです。"}, {"type": "subtitle", "time": 2965.67, "timestamp": "00:49:25", "text": "私のRepletアカウントはどこにありますか？私の"}, {"type": "subtitle", "time": 2969.03, "timestamp": "00:49:29", "text": "Joexのユーザー名は？わかった。あなたはここにいます。"}, {"type": "subtitle", "time": 2972.47, "timestamp": "00:49:32", "text": "ありがとう。こんにちは。あなたに会いたかった。あなたが持っている"}, {"type": "subtitle", "time": 2977.109, "timestamp": "00:49:37", "text": "私はこれを使ってアプリを作りました。待って。"}, {"type": "subtitle", "time": 2980.15, "timestamp": "00:49:40", "text": "おお。そうそう。 Discordの使い方チュートリアル。えっと"}, {"type": "subtitle", "time": 2984.95, "timestamp": "00:49:44", "text": "RPC。これを削除させてください。消去"}, {"type": "subtitle", "time": 2988.47, "timestamp": "00:49:48", "text": "無料アプリ。あなたのパブリックな無料アプリの制限"}, {"type": "subtitle", "time": 2991.91, "timestamp": "00:49:51", "text": "超過しました。何てことだ。アプリの数はいくつですか？"}, {"type": "subtitle", "time": 2997.51, "timestamp": "00:49:57", "text": "私が作ったの？ RPCチュートリアル。わかった。消去。"}]
[{"type": "subtitle", "time": 64.95, "timestamp": "00:01:04", "text": "それから、えっと"}, {"type": "subtitle", "time": 66.789, "timestamp": "00:01:06", "text": "来るために"}, {"type": "subtitle", "time": 75.27, "timestamp": "00:01:15", "text": "来る"}, {"type": "subtitle", "time": 78.63, "timestamp": "00:01:18", "text": "来てくれてありがとう"}, {"type": "subtitle", "time": 81.51, "timestamp": "00:01:21", "text": "お越しいただきありがとうございます。それは文字通り"}, {"type": "subtitle", "time": 84.55, "timestamp": "00:01:24", "text": "みんなそうですよね？うん。皆様、ありがとうございました。"}, {"type": "subtitle", "time": 87.83, "timestamp": "00:01:27", "text": "通りかかる人々と"}, {"type": "subtitle", "time": 89.35, "timestamp": "00:01:29", "text": "ボードを見守ってくださり、ありがとうございます。"}, {"type": "subtitle", "time": 91.83, "timestamp": "00:01:31", "text": "ボードの動きも見ています。人々は"}, {"type": "subtitle", "time": 94.069, "timestamp": "00:01:34", "text": "見ている"}, {"type": "subtitle", "time": 97.19, "timestamp": "00:01:37", "text": "ご視聴いただき、本当にありがとうございました。"}, {"type": "subtitle", "time": 104.95, "timestamp": "00:01:44", "text": "これが私がこんなに疲れている理由なのか"}, {"type": "subtitle", "time": 106.789, "timestamp": "00:01:46", "text": "疲れた？"}, {"type": "subtitle", "time": 108.71000000000001, "timestamp": "00:01:48", "text": "テスト配信はするべきではなかった"}, {"type": "subtitle", "time": 111.99000000000001, "timestamp": "00:01:51", "text": "けれど。私はストリーミング配信をしすぎました"}, {"type": "subtitle", "time": 114.149, "timestamp": "00:01:54", "text": "テストストリーム。ストリーミング配信もできたのに"}, {"type": "subtitle", "time": 116.469, "timestamp": "00:01:56", "text": "ジョーについて"}, {"type": "subtitle", "time": 119.91, "timestamp": "00:01:59", "text": "アカウントだが"}]
[{"type": "subtitle", "time": 18726.07, "timestamp": "05:12:06", "text": "じゃあ、音楽を聴こう。"}, {"type": "subtitle", "time": 18748.39, "timestamp": "05:12:28", "text": "そして、もし私が"}, {"type": "subtitle", "time": 18756.31, "timestamp": "05:12:36", "text": "ああ、ちょっと専門的になりすぎるかもしれないね。私"}, {"type": "subtitle", "time": 18758.788, "timestamp": "05:12:38", "text": "もしかしたら、私はしゃべりすぎてしまうかもしれない"}, {"type": "subtitle", "time": 18764.948, "timestamp": "05:12:44", "text": "これは音楽関連のデモです。"}, {"type": "subtitle", "time": 18767.99, "timestamp": "05:12:47", "text": "ああ、そうだね。"}, {"type": "subtitle", "time": 18770.47, "timestamp": "05:12:50", "text": "でも、批判しないでください。よし、みんな約束してくれ"}, {"type": "subtitle", "time": 18778.55, "timestamp": "05:12:58", "text": "わかった、約束して"}]
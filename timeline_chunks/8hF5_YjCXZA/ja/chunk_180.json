[{"type": "subtitle", "time": 10803.269, "timestamp": "03:00:03", "text": "[音楽]"}, {"type": "subtitle", "time": 10806.15, "timestamp": "03:00:06", "text": "始める前に"}, {"type": "subtitle", "time": 10808.79, "timestamp": "03:00:08", "text": "ストリーム、"}, {"type": "subtitle", "time": 10811.59, "timestamp": "03:00:11", "text": "確認させてください"}, {"type": "subtitle", "time": 10814.15, "timestamp": "03:00:14", "text": "私は自分自身にも何も触りません。どれでも"}, {"type": "subtitle", "time": 10816.15, "timestamp": "03:00:16", "text": "何でも？"}, {"type": "subtitle", "time": 10818.55, "timestamp": "03:00:18", "text": "えっと、これって本物のカメラですよね？想像する"}, {"type": "subtitle", "time": 10822.07, "timestamp": "03:00:22", "text": "もし誤って音楽をクリックしてしまったら。私"}, {"type": "subtitle", "time": 10826.55, "timestamp": "03:00:26", "text": "これをクリックしてください。ああ、神様、私は"}, {"type": "subtitle", "time": 10830.55, "timestamp": "03:00:30", "text": "死ぬ。もし私が泣いたら"}, {"type": "subtitle", "time": 10833.19, "timestamp": "03:00:33", "text": "私の顔が映っていないといいのですが。"}, {"type": "subtitle", "time": 10842.63, "timestamp": "03:00:42", "text": "ポップアップ表示されるはずです。ポップアップ表示されるはずです"}, {"type": "subtitle", "time": 10857.51, "timestamp": "03:00:57", "text": "私の携帯電話からの音声コメント。"}]
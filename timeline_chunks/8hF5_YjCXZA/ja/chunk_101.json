[{"type": "subtitle", "time": 6062.629, "timestamp": "01:41:02", "text": "それでは、これに関するドキュメントを見てみましょう。"}, {"type": "subtitle", "time": 6068.629, "timestamp": "01:41:08", "text": "あ、今「次へ」って入力したよね？わかった、"}, {"type": "subtitle", "time": 6071.75, "timestamp": "01:41:11", "text": "わかった。ええ、コミュニケーションは"}, {"type": "subtitle", "time": 6075.99, "timestamp": "01:41:15", "text": "大学プラスアクションへようこそ。うん、"}, {"type": "subtitle", "time": 6079.27, "timestamp": "01:41:19", "text": "大学も一緒に。そう、一緒に集まって、"}, {"type": "subtitle", "time": 6082.95, "timestamp": "01:41:22", "text": "団結して実行するために"}, {"type": "subtitle", "time": 6085.669, "timestamp": "01:41:25", "text": "アクション。"}, {"type": "subtitle", "time": 6088.47, "timestamp": "01:41:28", "text": "わーい。次。"}, {"type": "subtitle", "time": 6096.629, "timestamp": "01:41:36", "text": "オリジナルシュリンプ。あなたのお気に入りは何ですか？"}, {"type": "subtitle", "time": 6100.229, "timestamp": "01:41:40", "text": "アニメキャラクターとその理由は？ああ、もう、"}, {"type": "subtitle", "time": 6102.07, "timestamp": "01:41:42", "text": "コンピュータサイエンスの試験から来たもので、"}, {"type": "subtitle", "time": 6105.03, "timestamp": "01:41:45", "text": "明らかに失敗している。ああ、心配しないで"}, {"type": "subtitle", "time": 6108.79, "timestamp": "01:41:48", "text": "あなたが今何かを書いたということですね。私"}, {"type": "subtitle", "time": 6110.55, "timestamp": "01:41:50", "text": "うまく書いて勉強したことを願っています"}]
[{"type": "subtitle", "time": 12304.32, "timestamp": "03:25:04", "text": "ニャー。ニャー。"}, {"type": "subtitle", "time": 12312.71, "timestamp": "03:25:12", "text": "[音楽]"}, {"type": "subtitle", "time": 12318.63, "timestamp": "03:25:18", "text": "おお、"}, {"type": "subtitle", "time": 12327.67, "timestamp": "03:25:27", "text": "[音楽]"}, {"type": "subtitle", "time": 12330.55, "timestamp": "03:25:30", "text": "わかった。わかった。わかった。何てことだ。私は手に入れた"}, {"type": "subtitle", "time": 12333.67, "timestamp": "03:25:33", "text": "一発で成功。一発で成功しました。"}, {"type": "subtitle", "time": 12351.19, "timestamp": "03:25:51", "text": "充電が止まっているのが気に入っています"}, {"type": "subtitle", "time": 12352.87, "timestamp": "03:25:52", "text": "13％。"}]
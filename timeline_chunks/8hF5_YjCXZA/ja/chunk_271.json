[{"type": "subtitle", "time": 16273.75, "timestamp": "04:31:13", "text": "ええと、2時半になります。ああ、彼らは"}, {"type": "subtitle", "time": 16277.349, "timestamp": "04:31:17", "text": "電話するつもりです。"}, {"type": "subtitle", "time": 16279.59, "timestamp": "04:31:19", "text": "では、もし彼らが私に電話をかけてきたら、私は何と答えるだろうか？"}, {"type": "subtitle", "time": 16282.07, "timestamp": "04:31:22", "text": "また？えっと、あの、すみません"}, {"type": "subtitle", "time": 16285.429, "timestamp": "04:31:25", "text": "そうは言っていたけれど、考えが変わった。"}, {"type": "subtitle", "time": 16289.83, "timestamp": "04:31:29", "text": "えーと、私は、えーと、私はそうしないように努力します"}, {"type": "subtitle", "time": 16293.51, "timestamp": "04:31:33", "text": "今夜は試さないでおこう。えっと、私は"}, {"type": "subtitle", "time": 16295.99, "timestamp": "04:31:35", "text": "考えが変わりました。私は興味がない"}, {"type": "subtitle", "time": 16298.55, "timestamp": "04:31:38", "text": "これを君たちと一緒にやろう。ありがとうございます"}, {"type": "subtitle", "time": 16300.389, "timestamp": "04:31:40", "text": "あなたの時間。"}, {"type": "subtitle", "time": 16304.389, "timestamp": "04:31:44", "text": "さよなら。そして、私はその電話を正しく受けた。"}]
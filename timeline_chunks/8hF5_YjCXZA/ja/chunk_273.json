[{"type": "subtitle", "time": 16380.71, "timestamp": "04:33:00", "text": "そして彼らに返済するなどする。それは"}, {"type": "subtitle", "time": 16393.87, "timestamp": "04:33:13", "text": "わからない。"}, {"type": "subtitle", "time": 16396.15, "timestamp": "04:33:16", "text": "[音楽]"}, {"type": "subtitle", "time": 16399.59, "timestamp": "04:33:19", "text": "あなたは私たちを騙しました。いつ私が詐欺を働いたのですか？"}, {"type": "subtitle", "time": 16401.51, "timestamp": "04:33:21", "text": "君たち？"}, {"type": "subtitle", "time": 16410.47, "timestamp": "04:33:30", "text": "わからない。"}, {"type": "subtitle", "time": 16413.429, "timestamp": "04:33:33", "text": "そしてそれは"}, {"type": "subtitle", "time": 16422.551, "timestamp": "04:33:42", "text": "昨年10月。"}, {"type": "subtitle", "time": 16431.189, "timestamp": "04:33:51", "text": "10月。あなたは忘れた"}, {"type": "subtitle", "time": 16433.75, "timestamp": "04:33:53", "text": "私は活動休止中でした。"}, {"type": "subtitle", "time": 16435.349, "timestamp": "04:33:55", "text": "ああ。"}, {"type": "subtitle", "time": 16437.029, "timestamp": "04:33:57", "text": "わかった。"}]
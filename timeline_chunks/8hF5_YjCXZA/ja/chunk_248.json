[{"type": "subtitle", "time": 14880.79, "timestamp": "04:08:00", "text": "わからない。私は何をしているのだろう？そのこと"}, {"type": "subtitle", "time": 14883.83, "timestamp": "04:08:03", "text": "君たちは私が騙されやすいって知ってるよね。私は"}, {"type": "subtitle", "time": 14887.11, "timestamp": "04:08:07", "text": "説得しやすい。私は騙されやすい"}, {"type": "subtitle", "time": 14894.229, "timestamp": "04:08:14", "text": "うまくいかなかったら怖い。私は"}, {"type": "subtitle", "time": 14896.79, "timestamp": "04:08:16", "text": "将来君たちが"}, {"type": "subtitle", "time": 14907.83, "timestamp": "04:08:27", "text": "わからない。問題はもしもしもしではなく"}, {"type": "subtitle", "time": 14917.03, "timestamp": "04:08:37", "text": "その物"}, {"type": "subtitle", "time": 14919.349, "timestamp": "04:08:39", "text": "あなたに電話をかけてくる人はフレームのように"}, {"type": "subtitle", "time": 14921.51, "timestamp": "04:08:41", "text": "断れない友人、または叔父"}, {"type": "subtitle", "time": 14938.71, "timestamp": "04:08:58", "text": "父がこれを知ったら、"}]
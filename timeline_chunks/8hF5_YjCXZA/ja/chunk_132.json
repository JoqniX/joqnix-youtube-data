[{"type": "subtitle", "time": 7935.03, "timestamp": "02:12:15", "text": "エンジン警告灯のようにすべてが奇妙だ"}, {"type": "subtitle", "time": 7945.35, "timestamp": "02:12:25", "text": "ええ、1.13ポイントです。ええ、もちろんです"}, {"type": "subtitle", "time": 7948.629, "timestamp": "02:12:28", "text": "それは良いです。"}, {"type": "subtitle", "time": 7953.03, "timestamp": "02:12:33", "text": "私もようやく幸せになれた。気をつけて。取る"}, {"type": "subtitle", "time": 7956.069, "timestamp": "02:12:36", "text": "ケア。私の先生は突然現れる。こんにちは。"}, {"type": "subtitle", "time": 7958.39, "timestamp": "02:12:38", "text": "気をつけて。気をつけて。"}, {"type": "subtitle", "time": 7961.35, "timestamp": "02:12:41", "text": "おすすめですよ。もうご覧になりましたか？"}, {"type": "subtitle", "time": 7972.149, "timestamp": "02:12:52", "text": "もちろん、女の子たちを応援したいですよね。"}, {"type": "subtitle", "time": 7973.99, "timestamp": "02:12:53", "text": "今。"}, {"type": "subtitle", "time": 7976.149, "timestamp": "02:12:56", "text": "待って、待って。ほら、私は地域大会にいたんです。"}, {"type": "subtitle", "time": 7979.03, "timestamp": "02:12:59", "text": "え、何？"}]
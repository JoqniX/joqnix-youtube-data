[{"type": "subtitle", "time": 18313.83, "timestamp": "05:05:13", "text": "それは専門分野によって異なります"}, {"type": "subtitle", "time": 18323.67, "timestamp": "05:05:23", "text": "私の性格からすると"}, {"type": "subtitle", "time": 18331.75, "timestamp": "05:05:31", "text": "私は騙されやすいんです。"}, {"type": "subtitle", "time": 18337.35, "timestamp": "05:05:37", "text": "荒らし。私はいたずらされたり、何でもされたりしやすいんです。"}, {"type": "subtitle", "time": 18342.15, "timestamp": "05:05:42", "text": "リストはまだまだ続く。"}, {"type": "subtitle", "time": 18350.47, "timestamp": "05:05:50", "text": "[音楽]"}, {"type": "subtitle", "time": 18352.628, "timestamp": "05:05:52", "text": "君には友達が必要だ。誰が誰を"}]
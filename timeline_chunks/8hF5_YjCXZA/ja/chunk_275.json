[{"type": "subtitle", "time": 16503.429, "timestamp": "04:35:03", "text": "あ、待って、待って、待って。私は送る必要があります"}, {"type": "subtitle", "time": 16515.51, "timestamp": "04:35:15", "text": "父はどこで新聞を共有していますか？"}, {"type": "subtitle", "time": 16517.91, "timestamp": "04:35:17", "text": "レシート"}, {"type": "subtitle", "time": 16524.31, "timestamp": "04:35:24", "text": "はい、すみません、これを忘れていました。私の父"}, {"type": "subtitle", "time": 16527.269, "timestamp": "04:35:27", "text": "銀行にいます。"}, {"type": "subtitle", "time": 16529.51, "timestamp": "04:35:29", "text": "えっと、"}, {"type": "subtitle", "time": 16531.189, "timestamp": "04:35:31", "text": "朝にメールを送ってから"}, {"type": "subtitle", "time": 16534.23, "timestamp": "04:35:34", "text": "お金が必要なので、"}, {"type": "subtitle", "time": 16537.99, "timestamp": "04:35:37", "text": "私の口座に返金されました"}, {"type": "subtitle", "time": 16545.83, "timestamp": "04:35:45", "text": "正直に言うと"}, {"type": "subtitle", "time": 16556.629, "timestamp": "04:35:56", "text": "私はこれに夢中です"}, {"type": "subtitle", "time": 16559.429, "timestamp": "04:35:59", "text": "優柔不断"}]
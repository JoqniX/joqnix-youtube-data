[{"type": "subtitle", "time": 20300.23, "timestamp": "05:38:20", "text": "いいえ、それはうまくいきません。"}, {"type": "subtitle", "time": 20307.91, "timestamp": "05:38:27", "text": "しかし、それをクロマチックメジャースケールに設定することもできます"}, {"type": "subtitle", "time": 20309.91, "timestamp": "05:38:29", "text": "C の。"}, {"type": "subtitle", "time": 20312.23, "timestamp": "05:38:32", "text": "速度を追加する"}, {"type": "subtitle", "time": 20323.35, "timestamp": "05:38:43", "text": "もしかしたら、"}, {"type": "subtitle", "time": 20334.47, "timestamp": "05:38:54", "text": "ATM詐欺の男。うん。うん。いくつかの"}, {"type": "subtitle", "time": 20336.48, "timestamp": "05:38:56", "text": "少し前に何かが起こった。"}]
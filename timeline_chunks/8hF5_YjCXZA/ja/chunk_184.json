[{"type": "subtitle", "time": 11054.15, "timestamp": "03:04:14", "text": "岩。ええ、私は"}, {"type": "subtitle", "time": 11055.75, "timestamp": "03:04:15", "text": "家。ええ、私は飾り付けをするつもりです"}, {"type": "subtitle", "time": 11063.19, "timestamp": "03:04:23", "text": "時々、彼はじっと動かないことがある。"}, {"type": "subtitle", "time": 11066.95, "timestamp": "03:04:26", "text": "それは怖いですね。彼がじっとしているときはいつでも、"}, {"type": "subtitle", "time": 11070.07, "timestamp": "03:04:30", "text": "そうですね、でもそれはちょっと怖いですね。私はこう思う、"}, {"type": "subtitle", "time": 11073.349, "timestamp": "03:04:33", "text": "待って、何が起こっているの？彼は大丈夫ですか？"}, {"type": "subtitle", "time": 11076.63, "timestamp": "03:04:36", "text": "それから私は友人に電話をかけた。彼はこう言った。"}, {"type": "subtitle", "time": 11079.11, "timestamp": "03:04:39", "text": "「ドクター、"}, {"type": "subtitle", "time": 11081.91, "timestamp": "03:04:41", "text": "ドクター、えっと、もし泳いでいるなら、"}, {"type": "subtitle", "time": 11086.389, "timestamp": "03:04:46", "text": "24時間365日泳ぎ続けるわけじゃないよね？"}, {"type": "subtitle", "time": 11089.19, "timestamp": "03:04:49", "text": "そして私は「わかった、君の言う通りだ」と思った。"}]
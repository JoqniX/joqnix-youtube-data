[{"type": "subtitle", "time": 7758.87, "timestamp": "02:09:18", "text": "また。今日Steamでこれを見かけました。おお"}, {"type": "subtitle", "time": 7760.55, "timestamp": "02:09:20", "text": "我が神よ。待って、待って、待って、待って。私にさせて"}, {"type": "subtitle", "time": 7762.55, "timestamp": "02:09:22", "text": "Steamを開く。 Steamを開いてみます。私にさせて"}, {"type": "subtitle", "time": 7765.83, "timestamp": "02:09:25", "text": "Steamを開く。 Steam.com待って、待って、待って。"}, {"type": "subtitle", "time": 7775.669, "timestamp": "02:09:35", "text": "ジア"}, {"type": "subtitle", "time": 7778.629, "timestamp": "02:09:38", "text": "公式の「オーマイゴッド」と言ってください。近日公開"}, {"type": "subtitle", "time": 7781.43, "timestamp": "02:09:41", "text": "パキスタン再生が実現した。ああ、"}, {"type": "subtitle", "time": 7785.51, "timestamp": "02:09:45", "text": "神。ライトノベル。ビジュアルノベルはありません。"}]
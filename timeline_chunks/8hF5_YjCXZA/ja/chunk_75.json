[{"type": "subtitle", "time": 4506.79, "timestamp": "01:15:06", "text": "待って。 1ルピーの金額は"}, {"type": "subtitle", "time": 4516.149, "timestamp": "01:15:16", "text": "ああ、それは私が、ええと、オーケーをやっているからですか。"}, {"type": "subtitle", "time": 4519.91, "timestamp": "01:15:19", "text": "Y字型のもの。それが理由ですか？わかった。"}, {"type": "subtitle", "time": 4522.229, "timestamp": "01:15:22", "text": "何てことだ。私は水を落としてしまった。ああ、君"}, {"type": "subtitle", "time": 4523.83, "timestamp": "01:15:23", "text": "ダミー。キーボードの上に落としてしまったんですね。"}, {"type": "subtitle", "time": 4533.99, "timestamp": "01:15:33", "text": "大丈夫です。"}, {"type": "subtitle", "time": 4542.709, "timestamp": "01:15:42", "text": "なぜ私はなぜ私はなぜ私はしなかったのか"}, {"type": "subtitle", "time": 4546.709, "timestamp": "01:15:46", "text": "飲む？それがお茶だったらどうでしょう。私は覚えています"}, {"type": "subtitle", "time": 4549.669, "timestamp": "01:15:49", "text": "キーボードにお茶をこぼしてしまった"}, {"type": "subtitle", "time": 4551.669, "timestamp": "01:15:51", "text": "衰退していく波の流れ。あれは12だった"}, {"type": "subtitle", "time": 4554.63, "timestamp": "01:15:54", "text": "1時間配信。ああ、あれはひどかった。私"}, {"type": "subtitle", "time": 4558.31, "timestamp": "01:15:58", "text": "配信終了後、その日泣いた"}]
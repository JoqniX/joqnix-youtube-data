[{"type": "subtitle", "time": 5715.91, "timestamp": "01:35:15", "text": "はい、これでうまくいきます。良さそうですね。"}, {"type": "subtitle", "time": 5718.47, "timestamp": "01:35:18", "text": "右？わかった。わかった。わかった。こんにちは。方法"}, {"type": "subtitle", "time": 5721.99, "timestamp": "01:35:21", "text": "通信する？さて、別の話に戻りましょう。"}, {"type": "subtitle", "time": 5725.99, "timestamp": "01:35:25", "text": "どのように話せばよいか？どのようにコミュニケーションを取るか？"}, {"type": "subtitle", "time": 5728.95, "timestamp": "01:35:28", "text": "人との話し方は一般的な"}, {"type": "subtitle", "time": 5730.709, "timestamp": "01:35:30", "text": "質問。"}, {"type": "subtitle", "time": 5734.709, "timestamp": "01:35:34", "text": "つまり、内向的な人間として、"}, {"type": "subtitle", "time": 5739.75, "timestamp": "01:35:39", "text": "現実世界でもバーチャル世界でも超シャイ"}, {"type": "subtitle", "time": 5742.01, "timestamp": "01:35:42", "text": "えっと、他の人と一緒にいるときは"}, {"type": "subtitle", "time": 5743.83, "timestamp": "01:35:43", "text": "[音楽]"}, {"type": "subtitle", "time": 5746.47, "timestamp": "01:35:46", "text": "それは痛みを伴う"}, {"type": "subtitle", "time": 5749.27, "timestamp": "01:35:49", "text": "なぜなら、開けるのが難しく、"}, {"type": "subtitle", "time": 5753.99, "timestamp": "01:35:53", "text": "すべて。しかし私が思うのは"}, {"type": "subtitle", "time": 5756.709, "timestamp": "01:35:56", "text": "心配しすぎているなら、"}, {"type": "subtitle", "time": 5758.629, "timestamp": "01:35:58", "text": "話して、考えすぎていることすべて"}]
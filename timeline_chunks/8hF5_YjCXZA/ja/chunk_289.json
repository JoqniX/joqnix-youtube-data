[{"type": "subtitle", "time": 17341.35, "timestamp": "04:49:01", "text": "ドリームは"}, {"type": "subtitle", "time": 17347.27, "timestamp": "04:49:07", "text": "待って。"}, {"type": "subtitle", "time": 17349.67, "timestamp": "04:49:09", "text": "何てことだ。"}, {"type": "subtitle", "time": 17356.15, "timestamp": "04:49:16", "text": "一度謝れば、"}, {"type": "subtitle", "time": 17364.788, "timestamp": "04:49:24", "text": "私は、ああ、私は"}, {"type": "subtitle", "time": 17367.99, "timestamp": "04:49:27", "text": "これとそれ以降のすべての結果"}, {"type": "subtitle", "time": 17370.788, "timestamp": "04:49:30", "text": "両親に相談して、"}, {"type": "subtitle", "time": 17372.628, "timestamp": "04:49:32", "text": "持ち帰り"}, {"type": "subtitle", "time": 17375.91, "timestamp": "04:49:35", "text": "私はその方法を試さないことにした"}, {"type": "subtitle", "time": 17379.83, "timestamp": "04:49:39", "text": "取引。お時間をいただきありがとうございました。持つ"}, {"type": "subtitle", "time": 17383.19, "timestamp": "04:49:43", "text": "良い一日をお過ごしください。わかった。"}, {"type": "subtitle", "time": 17397.51, "timestamp": "04:49:57", "text": "私は決心しました"}]
[{"type": "subtitle", "time": 14471.75, "timestamp": "04:01:11", "text": "私がもっと心配しているのは"}, {"type": "subtitle", "time": 14473.83, "timestamp": "04:01:13", "text": "支払いを受け取ったら、あなたたちは止まる"}, {"type": "subtitle", "time": 14475.83, "timestamp": "04:01:15", "text": "応答中。それが私が唯一"}, {"type": "subtitle", "time": 14479.349, "timestamp": "04:01:19", "text": "心配している、私があなたに支払うと言ったら"}]
[{"type": "subtitle", "time": 16980.788, "timestamp": "04:43:00", "text": "に"}, {"type": "subtitle", "time": 16985.19, "timestamp": "04:43:05", "text": "これについて取り組んでください。そして"}, {"type": "subtitle", "time": 16988.628, "timestamp": "04:43:08", "text": "彼は自分のことで忙しいに違いない。そして"}, {"type": "subtitle", "time": 17008.47, "timestamp": "04:43:28", "text": "[音楽]"}, {"type": "subtitle", "time": 17010.23, "timestamp": "04:43:30", "text": "警官から酔っぱらうことができるって知ってる？"}, {"type": "subtitle", "time": 17014.01, "timestamp": "04:43:34", "text": "シロップのジョーク？それは確かに存在する。"}, {"type": "subtitle", "time": 17022.23, "timestamp": "04:43:42", "text": "つまり、私は心配しているんです。えっと"}, {"type": "subtitle", "time": 17024.15, "timestamp": "04:43:44", "text": "この件を持ち出して申し訳ないです"}, {"type": "subtitle", "time": 17034.788, "timestamp": "04:43:54", "text": "もしあの男が私に腹を立てたら"}, {"type": "subtitle", "time": 17037.43, "timestamp": "04:43:57", "text": "また、彼らの"}]
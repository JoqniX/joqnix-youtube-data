[{"type": "subtitle", "time": 1142.23, "timestamp": "00:19:02", "text": "寄付をする 財政的な"}, {"type": "subtitle", "time": 1145.19, "timestamp": "00:19:05", "text": "目標への支援とその他すべて"}, {"type": "subtitle", "time": 1149.029, "timestamp": "00:19:09", "text": "それはとても大きな意味を持つ。"}, {"type": "subtitle", "time": 1153.27, "timestamp": "00:19:13", "text": "それらは信頼関係に繋がる要素の一つだ。いいえ、私は"}, {"type": "subtitle", "time": 1183.27, "timestamp": "00:19:43", "text": "タイマーを長くする必要があるかもしれない。"}, {"type": "subtitle", "time": 1186.549, "timestamp": "00:19:46", "text": "右？大丈夫です。それを下げて"}, {"type": "subtitle", "time": 1190.23, "timestamp": "00:19:50", "text": "ゼロから、えっと、5とかそんな感じ。"}, {"type": "subtitle", "time": 1193.669, "timestamp": "00:19:53", "text": "それなら時間を延ばせばいい"}, {"type": "subtitle", "time": 1196.07, "timestamp": "00:19:56", "text": "なぜなら、私たちは無制限の"}, {"type": "subtitle", "time": 1199.19, "timestamp": "00:19:59", "text": "サバトンとかいうやつだよね？それはまるで"}]
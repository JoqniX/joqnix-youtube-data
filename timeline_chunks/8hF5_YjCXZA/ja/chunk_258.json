[{"type": "subtitle", "time": 15483.51, "timestamp": "04:18:03", "text": "その人たちは"}, {"type": "subtitle", "time": 15499.59, "timestamp": "04:18:19", "text": "えーと"}, {"type": "subtitle", "time": 15507.03, "timestamp": "04:18:27", "text": "ああ、まさにその通りだ。なぜ神聖でなければならないのか"}, {"type": "subtitle", "time": 15509.75, "timestamp": "04:18:29", "text": "その通り？"}, {"type": "subtitle", "time": 15512.389, "timestamp": "04:18:32", "text": "なぜ彼らは私にそれを正しくやるように急がせたのか"}, {"type": "subtitle", "time": 15514.71, "timestamp": "04:18:34", "text": "今？今回で2回目ですが、"}, {"type": "subtitle", "time": 15522.95, "timestamp": "04:18:42", "text": "私が思うに、ペは"}, {"type": "subtitle", "time": 15529.269, "timestamp": "04:18:49", "text": "正しい。"}, {"type": "subtitle", "time": 15534.469, "timestamp": "04:18:54", "text": "彼らはそうしないだろう。わかった。わかった、いいよ。えっと、"}, {"type": "subtitle", "time": 15536.55, "timestamp": "04:18:56", "text": "SCを手に入れよう。いいえ、私は"}]
[{"type": "subtitle", "time": 16801.11, "timestamp": "04:40:01", "text": "あるいは「うん」みたいな感じ。そして私は言う"}, {"type": "subtitle", "time": 16818.15, "timestamp": "04:40:18", "text": "それは映画で見るようなもので、"}, {"type": "subtitle", "time": 16821.59, "timestamp": "04:40:21", "text": "もの？彼らは本当にその売上を必要としている。えっと"}, {"type": "subtitle", "time": 16823.67, "timestamp": "04:40:23", "text": "1日に販売する数"}, {"type": "subtitle", "time": 16825.03, "timestamp": "04:40:25", "text": "日、昇進して"}]
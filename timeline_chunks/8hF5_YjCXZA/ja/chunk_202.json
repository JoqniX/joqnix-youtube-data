[{"type": "subtitle", "time": 12121.91, "timestamp": "03:22:01", "text": "誕生日。よし、これでデュアルになった。ハッピー"}, {"type": "subtitle", "time": 12124.63, "timestamp": "03:22:04", "text": "大家さんの誕生日"}, {"type": "subtitle", "time": 12127.59, "timestamp": "03:22:07", "text": "彼の名前はそうです。うん。うん。うん。"}, {"type": "subtitle", "time": 12131.51, "timestamp": "03:22:11", "text": "あのバブーという男を知ってるだろ。"}, {"type": "subtitle", "time": 12133.59, "timestamp": "03:22:13", "text": "何てことだ。なぜなら彼は名前を使わなかったから"}, {"type": "subtitle", "time": 12136.71, "timestamp": "03:22:16", "text": "それ。何てことだ。私たちは彼の"}, {"type": "subtitle", "time": 12139.83, "timestamp": "03:22:19", "text": "名前。何てことだ。"}, {"type": "subtitle", "time": 12142.79, "timestamp": "03:22:22", "text": "何てことだ。わかった。彼らにそう願う。さて、"}, {"type": "subtitle", "time": 12158.79, "timestamp": "03:22:38", "text": "危うく顔を出すところだった？何てことだ。おお"}, {"type": "subtitle", "time": 12162.71, "timestamp": "03:22:42", "text": "私の聖なる聖母よ。"}, {"type": "subtitle", "time": 12165.59, "timestamp": "03:22:45", "text": "神。"}, {"type": "subtitle", "time": 12174.95, "timestamp": "03:22:54", "text": "怪しい。"}, {"type": "subtitle", "time": 12177.91, "timestamp": "03:22:57", "text": "ほら、だから私は10ドルを費やしたんだよ"}]
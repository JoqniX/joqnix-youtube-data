[{"type": "subtitle", "time": 1742.95, "timestamp": "00:29:02", "text": "ギフトサブやその他"}, {"type": "subtitle", "time": 1745.19, "timestamp": "00:29:05", "text": "だから、何人のギフトを贈ったかを簡単に記入できます"}, {"type": "subtitle", "time": 1747.669, "timestamp": "00:29:07", "text": "交代要員がいた、"}, {"type": "subtitle", "time": 1758.23, "timestamp": "00:29:18", "text": "そして、あなたはただ、その階層を取るだけです"}, {"type": "subtitle", "time": 1761.59, "timestamp": "00:29:21", "text": "才能のある人たち、ですよね？そっちの方がいいでしょう。"}, {"type": "subtitle", "time": 1784.789, "timestamp": "00:29:44", "text": "あ、待って。取り外す必要はありません"}, {"type": "subtitle", "time": 1786.549, "timestamp": "00:29:46", "text": "ブガ。取り外す必要はありません"}, {"type": "subtitle", "time": 1789.51, "timestamp": "00:29:49", "text": "カチカチと音を立てているもの。時計を動かし続けることができます"}, {"type": "subtitle", "time": 1792.31, "timestamp": "00:29:52", "text": "あれ。"}, {"type": "subtitle", "time": 1795.51, "timestamp": "00:29:55", "text": "ああ、いい感じだ。大丈夫。あなたに任せます"}, {"type": "subtitle", "time": 1799.909, "timestamp": "00:29:59", "text": "ああ、やってみて。わかった。こんにちは。こんにちは。こんにちは。"}]
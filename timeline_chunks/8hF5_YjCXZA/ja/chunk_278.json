[{"type": "subtitle", "time": 16684.15, "timestamp": "04:38:04", "text": "手のことは気にしないでください。"}, {"type": "subtitle", "time": 16704.869, "timestamp": "04:38:24", "text": "たくさんのこと。ああ、そして私の手は"}, {"type": "subtitle", "time": 16707.59, "timestamp": "04:38:27", "text": "火傷もする、"}, {"type": "subtitle", "time": 16717.189, "timestamp": "04:38:37", "text": "私はただ、私はバカバカなように"}, {"type": "subtitle", "time": 16721.99, "timestamp": "04:38:41", "text": "プラスチックのガラス、水は"}, {"type": "subtitle", "time": 16724.709, "timestamp": "04:38:44", "text": "大きな水差しで加熱、大きな水差しで加熱"}, {"type": "subtitle", "time": 16728.23, "timestamp": "04:38:48", "text": "器具。そして私はそれを置いて霧と"}, {"type": "subtitle", "time": 16732.07, "timestamp": "04:38:52", "text": "水蒸気を曇らせないようにするんだよね？"}, {"type": "subtitle", "time": 16737.67, "timestamp": "04:38:57", "text": "えっと、霧みたいなやつ。すごく暑かったので"}]
[{"type": "subtitle", "time": 20105.75, "timestamp": "05:35:05", "text": "それは何という名前でしたか？それは何だったのか"}, {"type": "subtitle", "time": 20107.11, "timestamp": "05:35:07", "text": "電話した？それは何という名前ですか？それは何？"}, {"type": "subtitle", "time": 20109.51, "timestamp": "05:35:09", "text": "電話した？えっと"}, {"type": "subtitle", "time": 20112.07, "timestamp": "05:35:12", "text": "これです。"}, {"type": "subtitle", "time": 20116.708, "timestamp": "05:35:16", "text": "うん。アルペジエーターエフェクトを追加するか"}, {"type": "subtitle", "time": 20119.67, "timestamp": "05:35:19", "text": "MIDI えーと MIDI エフェクト、もしくは私はそれを"}, {"type": "subtitle", "time": 20121.75, "timestamp": "05:35:21", "text": "ピアノロール。"}, {"type": "subtitle", "time": 20130.02, "timestamp": "05:35:30", "text": "この部分をどこでループさせればいいですか？"}, {"type": "subtitle", "time": 20131.67, "timestamp": "05:35:31", "text": "[音楽]"}, {"type": "subtitle", "time": 20133.43, "timestamp": "05:35:33", "text": "ループ再生するにはどうすればいいですか？忘れた。えっと、"}, {"type": "subtitle", "time": 20136.07, "timestamp": "05:35:36", "text": "コントロール、コントロール、コントロール。そこにいる"}, {"type": "subtitle", "time": 20137.75, "timestamp": "05:35:37", "text": "は。"}]
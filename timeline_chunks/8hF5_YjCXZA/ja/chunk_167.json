[{"type": "subtitle", "time": 10021.11, "timestamp": "02:47:01", "text": "まるで皮を剥がされたみたいだ。"}, {"type": "subtitle", "time": 10025.91, "timestamp": "02:47:05", "text": "あれは正真正銘の魚だ。私を銅像にしてくれ。"}, {"type": "subtitle", "time": 10033.429, "timestamp": "02:47:13", "text": "これを売って、"}, {"type": "subtitle", "time": 10064.469, "timestamp": "02:47:44", "text": "それでは、この後昼食に行きます。"}, {"type": "subtitle", "time": 10078.55, "timestamp": "02:47:58", "text": "より高度なロッド。魚を捕まえることができる"}]
[{"type": "subtitle", "time": 8581.83, "timestamp": "02:23:01", "text": "いや、待って。"}, {"type": "subtitle", "time": 8585.03, "timestamp": "02:23:05", "text": "実は、ダウンロードする必要があるんです。"}, {"type": "subtitle", "time": 8586.63, "timestamp": "02:23:06", "text": "えっと、"}, {"type": "subtitle", "time": 8591.91, "timestamp": "02:23:11", "text": "もしかして、組み立ては完了しましたか？いいえ、私は"}, {"type": "subtitle", "time": 8593.51, "timestamp": "02:23:13", "text": "まだ読み終えていません。私はそれを保管しています"}, {"type": "subtitle", "time": 8597.27, "timestamp": "02:23:17", "text": "最後に、長い時間がかかることは分かっているから"}, {"type": "subtitle", "time": 8599.91, "timestamp": "02:23:19", "text": "死の大胆さは、長いものになるだろう。いいえ、"}, {"type": "subtitle", "time": 8602.87, "timestamp": "02:23:22", "text": "第三幕。今日中に終わらせなければならない。"}, {"type": "subtitle", "time": 8605.51, "timestamp": "02:23:25", "text": "心配ない。私はそれをしようと考えました"}, {"type": "subtitle", "time": 8607.349, "timestamp": "02:23:27", "text": "夜。"}]
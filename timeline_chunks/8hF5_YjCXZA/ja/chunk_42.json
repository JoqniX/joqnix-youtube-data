[{"type": "subtitle", "time": 2523.75, "timestamp": "00:42:03", "text": "また、問題はカナダが"}, {"type": "subtitle", "time": 2526.23, "timestamp": "00:42:06", "text": "銀行を追加しようとしていますが、追加できません。"}, {"type": "subtitle", "time": 2529.19, "timestamp": "00:42:09", "text": "なぜなら、このアカウントは"}, {"type": "subtitle", "time": 2531.829, "timestamp": "00:42:11", "text": "銀行口座は複数のPayPalアカウントに"}, {"type": "subtitle", "time": 2533.91, "timestamp": "00:42:13", "text": "アカウント。どれだったかさえ覚えていない"}, {"type": "subtitle", "time": 2536.39, "timestamp": "00:42:16", "text": "それが登録されているアカウント。"}, {"type": "subtitle", "time": 2540.069, "timestamp": "00:42:20", "text": "何てことだ。私はミスをしてしまった"}, {"type": "subtitle", "time": 2542.15, "timestamp": "00:42:22", "text": "PayPalを最初に作成したときの間違い"}, {"type": "subtitle", "time": 2546.15, "timestamp": "00:42:26", "text": "アカウント。私は偽の年を記入しました。私はそうではなかった"}, {"type": "subtitle", "time": 2549.19, "timestamp": "00:42:29", "text": "当時18歳だった。わかった。偽の日付を入力しました"}, {"type": "subtitle", "time": 2551.19, "timestamp": "00:42:31", "text": "出生か何かで。そして私が"}, {"type": "subtitle", "time": 2553.43, "timestamp": "00:42:33", "text": "私の法的文書を提出しました。"}, {"type": "subtitle", "time": 2558.71, "timestamp": "00:42:38", "text": "「えっと、すみません、ジョック。あなたの詳細情報"}, {"type": "subtitle", "time": 2560.87, "timestamp": "00:42:40", "text": "ここでは間違っている。"}, {"type": "subtitle", "time": 2563.27, "timestamp": "00:42:43", "text": "そして彼らは文字通り禁止した"}, {"type": "subtitle", "time": 2565.27, "timestamp": "00:42:45", "text": "PayPalアカウントが制限されました。だから私は"}, {"type": "subtitle", "time": 2567.829, "timestamp": "00:42:47", "text": "2つ目のアカウントを作成する。"}, {"type": "subtitle", "time": 2569.75, "timestamp": "00:42:49", "text": "ええと、それが私が現在使用しているものです"}, {"type": "subtitle", "time": 2572.87, "timestamp": "00:42:52", "text": "現在、2つ目のアカウントです。しかし、"}]
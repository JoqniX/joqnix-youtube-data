[{"type": "subtitle", "time": 15662.149, "timestamp": "04:21:02", "text": "彼らはプレッシャーをかけるためにそう言うのだ。それは"}, {"type": "subtitle", "time": 15672.71, "timestamp": "04:21:12", "text": "あなたは彼らにWhatsAppでメッセージを送ったと言いましたね。"}, {"type": "subtitle", "time": 15676.79, "timestamp": "04:21:16", "text": "いいえ。いいえ、していません。"}, {"type": "subtitle", "time": 15682.07, "timestamp": "04:21:22", "text": "私が言ったのはいつ"}, {"type": "subtitle", "time": 15683.99, "timestamp": "04:21:23", "text": "私に話しかけてきた女性"}, {"type": "subtitle", "time": 15686.389, "timestamp": "04:21:26", "text": "一人称から始める いやいやいやいや"}, {"type": "subtitle", "time": 15688.87, "timestamp": "04:21:28", "text": "私に話しかけてきたのは男だった。"}, {"type": "subtitle", "time": 15690.79, "timestamp": "04:21:30", "text": "ソロ論文を書きたかったので"}, {"type": "subtitle", "time": 15693.11, "timestamp": "04:21:33", "text": "船は私を別の船に転送した"}, {"type": "subtitle", "time": 15695.83, "timestamp": "04:21:35", "text": "その女性が私に電話をかけてきて、私は"}, {"type": "subtitle", "time": 15699.51, "timestamp": "04:21:39", "text": "彼らにこれがケースです私はただ"}, {"type": "subtitle", "time": 15702.55, "timestamp": "04:21:42", "text": "オンラインのトランジションのあれこれ"}, {"type": "subtitle", "time": 15705.91, "timestamp": "04:21:45", "text": "オンラインストア、それだけです。"}, {"type": "subtitle", "time": 15708.95, "timestamp": "04:21:48", "text": "彼らは私にすべてを話してくれた、そして彼らは言った"}, {"type": "subtitle", "time": 15712.309, "timestamp": "04:21:52", "text": "私は彼らにその金額を支払うことができないと伝えました"}, {"type": "subtitle", "time": 15714.79, "timestamp": "04:21:54", "text": "今すぐ今すぐ送っていただけますか？"}, {"type": "subtitle", "time": 15716.71, "timestamp": "04:21:56", "text": "WhatsAppか何かで私に連絡して、"}, {"type": "subtitle", "time": 15719.269, "timestamp": "04:21:59", "text": "WhatsAppで送ってくれた"}]
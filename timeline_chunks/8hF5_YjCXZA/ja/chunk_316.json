[{"type": "subtitle", "time": 18973.11, "timestamp": "05:16:13", "text": "わかった。私たちはどうすればいいのでしょうか？えっと、私は"}, {"type": "subtitle", "time": 18975.91, "timestamp": "05:16:15", "text": "代わりに宿題をしましょうか？わかった。"}, {"type": "subtitle", "time": 18977.59, "timestamp": "05:16:17", "text": "待って。"}, {"type": "subtitle", "time": 18979.67, "timestamp": "05:16:19", "text": "宿題をやらなきゃ。わかった。させて"}, {"type": "subtitle", "time": 18982.55, "timestamp": "05:16:22", "text": "私がこれら全てを削除します。"}, {"type": "subtitle", "time": 18986.07, "timestamp": "05:16:26", "text": "わかった。待って。あれはどこにあるの？"}, {"type": "subtitle", "time": 18989.27, "timestamp": "05:16:29", "text": "このファイルを入手しました。"}, {"type": "subtitle", "time": 18993.67, "timestamp": "05:16:33", "text": "これはザクラ製の楽器です。えっと"}, {"type": "subtitle", "time": 18996.39, "timestamp": "05:16:36", "text": "これは量子化についてのレッスンで、"}, {"type": "subtitle", "time": 18998.07, "timestamp": "05:16:38", "text": "歪み"}, {"type": "subtitle", "time": 19004.47, "timestamp": "05:16:44", "text": "そして、同じクラスだと思うのですが"}, {"type": "subtitle", "time": 19006.628, "timestamp": "05:16:46", "text": "ボーカルチョップのやり方を教えてくれて、"}, {"type": "subtitle", "time": 19008.47, "timestamp": "05:16:48", "text": "もの。"}, {"type": "subtitle", "time": 19011.03, "timestamp": "05:16:51", "text": "うん。これは私が唯一の者だから"}, {"type": "subtitle", "time": 19012.868, "timestamp": "05:16:52", "text": "誰が日本式のやり方を学んでいるのか"}, {"type": "subtitle", "time": 19016.47, "timestamp": "05:16:56", "text": "音楽ですよね？慣用句と日本のJポップ"}, {"type": "subtitle", "time": 19019.75, "timestamp": "05:16:59", "text": "タイプ。彼は、それが私のトピックだったから"}]
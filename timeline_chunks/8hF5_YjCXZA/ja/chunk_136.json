[{"type": "subtitle", "time": 8160.95, "timestamp": "02:16:00", "text": "他のクリエイターや友人たちと、"}, {"type": "subtitle", "time": 8162.629, "timestamp": "02:16:02", "text": "パズルストリームの構成要素。私"}, {"type": "subtitle", "time": 8166.149, "timestamp": "02:16:06", "text": "パズルストリームを取得できませんでした"}, {"type": "subtitle", "time": 8168.229, "timestamp": "02:16:08", "text": "パズルとこれ。それはある意味"}, {"type": "subtitle", "time": 8170.709, "timestamp": "02:16:10", "text": "ポケモンコミコンでは高価だった。私"}, {"type": "subtitle", "time": 8179.589, "timestamp": "02:16:19", "text": "えっと、かぎ針編みの配信。かぎ針編みを買う必要がある"}, {"type": "subtitle", "time": 8184.709, "timestamp": "02:16:24", "text": "えっと、あれ。毛糸と、それ。"}, {"type": "subtitle", "time": 8186.55, "timestamp": "02:16:26", "text": "音楽ストリームを作成する。それが私たちです"}, {"type": "subtitle", "time": 8193.75, "timestamp": "02:16:33", "text": "えっと、オメガの小説を声に出して読んでください。うん、"}, {"type": "subtitle", "time": 8195.99, "timestamp": "02:16:35", "text": "それもそうだ。それが何なのか、私には分かりません。"}, {"type": "subtitle", "time": 8198.549, "timestamp": "02:16:38", "text": "それから、相棒のサイファーをプレイしよう。それは恐ろしい"}, {"type": "subtitle", "time": 8201.91, "timestamp": "02:16:41", "text": "ゲームかな。愛の前か後か"}, {"type": "subtitle", "time": 8204.87, "timestamp": "02:16:44", "text": "魚？ H"}, {"type": "subtitle", "time": 8206.629, "timestamp": "02:16:46", "text": "わからない。私は一度もプレイしたことがありません"}, {"type": "subtitle", "time": 8211.19, "timestamp": "02:16:51", "text": "それで、試してみようと思ったんです。"}, {"type": "subtitle", "time": 8214.709, "timestamp": "02:16:54", "text": "その変態的なやり方って、変態的なの？私"}, {"type": "subtitle", "time": 8219.27, "timestamp": "02:16:59", "text": "知る。友人に勧められたのですが、"}]
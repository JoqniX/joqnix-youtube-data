[{"type": "subtitle", "time": 5462.55, "timestamp": "01:31:02", "text": "そしてTwitchもね。"}, {"type": "subtitle", "time": 5473.35, "timestamp": "01:31:13", "text": "念のため確認させてください。少し時間をください。"}, {"type": "subtitle", "time": 5480.55, "timestamp": "01:31:20", "text": "質疑応答をしていますが、"}, {"type": "subtitle", "time": 5484.47, "timestamp": "01:31:24", "text": "買ったものを使わせてください"}, {"type": "subtitle", "time": 5486.79, "timestamp": "01:31:26", "text": "無駄にしてはいけません。"}, {"type": "subtitle", "time": 5489.669, "timestamp": "01:31:29", "text": "うん。また、位置を調整する必要があります"}, {"type": "subtitle", "time": 5499.51, "timestamp": "01:31:39", "text": "[音楽]"}, {"type": "subtitle", "time": 5502.47, "timestamp": "01:31:42", "text": "わかった。コマンド。"}, {"type": "subtitle", "time": 5513.75, "timestamp": "01:31:53", "text": "えっと。ああ、それは感嘆符ですね。聞く。わかった。のために"}, {"type": "subtitle", "time": 5516.47, "timestamp": "01:31:56", "text": "この物。私から始めましょう。"}, {"type": "subtitle", "time": 5518.87, "timestamp": "01:31:58", "text": "だから、それを使うんだ。感嘆"}]
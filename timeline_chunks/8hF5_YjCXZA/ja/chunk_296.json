[{"type": "subtitle", "time": 17762.55, "timestamp": "04:56:02", "text": "お金のため、そしてその他すべてのために。"}, {"type": "subtitle", "time": 17770.47, "timestamp": "04:56:10", "text": "ああ、Rokuのストリームへようこそ。"}, {"type": "subtitle", "time": 17774.47, "timestamp": "04:56:14", "text": "あなたは私の苦痛の瞬間を目撃している"}, {"type": "subtitle", "time": 17786.07, "timestamp": "04:56:26", "text": "そして私は、その詐欺を回避しました。なぜなぜ"}, {"type": "subtitle", "time": 17788.55, "timestamp": "04:56:28", "text": "10点満点中6点？私がそう言ったから"}, {"type": "subtitle", "time": 17791.11, "timestamp": "04:56:31", "text": "私がそう言ったからだ。"}, {"type": "subtitle", "time": 17794.55, "timestamp": "04:56:34", "text": "つまり、彼の声の出し方、彼の"}, {"type": "subtitle", "time": 17800.07, "timestamp": "04:56:40", "text": "彼が言ったように、彼が言ったように"}, {"type": "subtitle", "time": 17807.27, "timestamp": "04:56:47", "text": "彼が尋ねたように、技術的なことは何かありますか"}, {"type": "subtitle", "time": 17810.788, "timestamp": "04:56:50", "text": "理由があろうとなかろうと、私は言った。"}]
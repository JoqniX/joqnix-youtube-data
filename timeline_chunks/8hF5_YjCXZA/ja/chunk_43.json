[{"type": "subtitle", "time": 2580.069, "timestamp": "00:43:00", "text": "えっと、これについては覚えていないのですが"}, {"type": "subtitle", "time": 2589.109, "timestamp": "00:43:09", "text": "どの口座を作成したのか覚えていません。えっと"}, {"type": "subtitle", "time": 2592.069, "timestamp": "00:43:12", "text": "私はオネクシアのようなことをしたと分かっています"}, {"type": "subtitle", "time": 2594.87, "timestamp": "00:43:14", "text": "えっと、OnexiaのPayPalアカウントで、"}, {"type": "subtitle", "time": 2598.069, "timestamp": "00:43:18", "text": "制限されている理由"}, {"type": "subtitle", "time": 2600.95, "timestamp": "00:43:20", "text": "私はそれを確認できませんでした。私は持っていません"}, {"type": "subtitle", "time": 2605.829, "timestamp": "00:43:25", "text": "登録されたもの"}, {"type": "subtitle", "time": 2609.19, "timestamp": "00:43:29", "text": "それから、えーと"}, {"type": "subtitle", "time": 2612.47, "timestamp": "00:43:32", "text": "レースクリルウォレットですが、私は持っていません"}, {"type": "subtitle", "time": 2616.63, "timestamp": "00:43:36", "text": "登録ビジネスだが、スポーツ選手向けで、"}, {"type": "subtitle", "time": 2618.47, "timestamp": "00:43:38", "text": "すべて"}, {"type": "subtitle", "time": 2621.589, "timestamp": "00:43:41", "text": "それは問題ではありません"}, {"type": "subtitle", "time": 2624.47, "timestamp": "00:43:44", "text": "正直言って、私も"}, {"type": "subtitle", "time": 2628.069, "timestamp": "00:43:48", "text": "カスタムペイ、つまりペイウォールみたいなもの"}, {"type": "subtitle", "time": 2629.91, "timestamp": "00:43:49", "text": "私のウェブサイトか何かのために"}, {"type": "subtitle", "time": 2633.03, "timestamp": "00:43:53", "text": "寄付。しかしそのためには走らなければならない"}, {"type": "subtitle", "time": 2635.67, "timestamp": "00:43:55", "text": "インドのオフィスとかの周りを回って行く"}, {"type": "subtitle", "time": 2638.71, "timestamp": "00:43:58", "text": "Racer Prey とその他いろいろ"}]
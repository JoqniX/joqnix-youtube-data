[{"type": "subtitle", "time": 9121.11, "timestamp": "02:32:01", "text": "えっと、私たちは「オンワン」というゲームをプレイしています"}, {"type": "subtitle", "time": 9123.75, "timestamp": "02:32:03", "text": "2番"}, {"type": "subtitle", "time": 9126.79, "timestamp": "02:32:06", "text": "ジュラ島。"}, {"type": "subtitle", "time": 9143.27, "timestamp": "02:32:23", "text": "[音楽]"}, {"type": "subtitle", "time": 9145.19, "timestamp": "02:32:25", "text": "とんでもない。あなたは私にできないと言っているの？"}, {"type": "subtitle", "time": 9157.75, "timestamp": "02:32:37", "text": "[音楽]"}, {"type": "subtitle", "time": 9166.07, "timestamp": "02:32:46", "text": "誰かがいる。在庫状況はよくわかりません"}, {"type": "subtitle", "time": 9167.75, "timestamp": "02:32:47", "text": "現時点で。顔があれば、"}, {"type": "subtitle", "time": 9170.63, "timestamp": "02:32:50", "text": "喜んで購入させていただきます。"}, {"type": "subtitle", "time": 9172.55, "timestamp": "02:32:52", "text": "実際には"}]
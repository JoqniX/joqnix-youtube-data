[{"type": "subtitle", "time": 4560.63, "timestamp": "01:16:00", "text": "それ。私はこう思った。「そして、その日は"}, {"type": "subtitle", "time": 4562.79, "timestamp": "01:16:02", "text": "キーボードが壊れた。"}, {"type": "subtitle", "time": 4565.43, "timestamp": "01:16:05", "text": "そしてそのキーボードはなぜか生きている"}, {"type": "subtitle", "time": 4574.31, "timestamp": "01:16:14", "text": "はい、私の間違いでした。"}, {"type": "subtitle", "time": 4577.27, "timestamp": "01:16:17", "text": "よし、予備のタオルが1枚あった。私"}, {"type": "subtitle", "time": 4590.149, "timestamp": "01:16:30", "text": "待って。えっと、このコメントは削除します。による"}, {"type": "subtitle", "time": 4591.91, "timestamp": "01:16:31", "text": "その方法で、メッセージを削除します"}, {"type": "subtitle", "time": 4607.03, "timestamp": "01:16:47", "text": "わかった、"}, {"type": "subtitle", "time": 4610.55, "timestamp": "01:16:50", "text": "私は、えーと、アルダーのやつが必要なんです。私の"}, {"type": "subtitle", "time": 4613.03, "timestamp": "01:16:53", "text": "電話？"}, {"type": "subtitle", "time": 4615.99, "timestamp": "01:16:55", "text": "また、Googleフォトスキャンは"}, {"type": "subtitle", "time": 4619.35, "timestamp": "01:16:59", "text": "本当に良い？"}]
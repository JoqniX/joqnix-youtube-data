[{"type": "subtitle", "time": 6791.75, "timestamp": "01:53:11", "text": "その国について何か学んでみよう"}, {"type": "subtitle", "time": 6793.91, "timestamp": "01:53:13", "text": "あなたが住んでいる場所。"}, {"type": "subtitle", "time": 6796.55, "timestamp": "01:53:16", "text": "この時点で、私は自分が偽物だと感じている"}, {"type": "subtitle", "time": 6803.83, "timestamp": "01:53:23", "text": "私は住んでいて、たくさんいます。"}, {"type": "subtitle", "time": 6806.07, "timestamp": "01:53:26", "text": "私は慰めです。私が知っていると思いますか？"}, {"type": "subtitle", "time": 6814.39, "timestamp": "01:53:34", "text": "ええと、私が彼に電話した理由がこれで分かりますか？"}, {"type": "subtitle", "time": 6824.87, "timestamp": "01:53:44", "text": "プネとマハラシュトラ州は"}, {"type": "subtitle", "time": 6826.87, "timestamp": "01:53:46", "text": "さまざまな州のように"}, {"type": "subtitle", "time": 6829.75, "timestamp": "01:53:49", "text": "インド。"}, {"type": "subtitle", "time": 6832.07, "timestamp": "01:53:52", "text": "プネーに行ったとき、私はこう思った"}, {"type": "subtitle", "time": 6839.669, "timestamp": "01:53:59", "text": "プネ"}]
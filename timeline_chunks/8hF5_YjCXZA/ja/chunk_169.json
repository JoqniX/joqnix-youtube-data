[{"type": "subtitle", "time": 10146.309, "timestamp": "02:49:06", "text": "いいえ。なぜ私は、いいえ。なぜあなたはそれをしたのですか。"}, {"type": "subtitle", "time": 10150.87, "timestamp": "02:49:10", "text": "ああ、"}, {"type": "subtitle", "time": 10171.349, "timestamp": "02:49:31", "text": "私はまだ病気から回復している最中です。"}, {"type": "subtitle", "time": 10174.469, "timestamp": "02:49:34", "text": "剣の喉とかそういうやつ。"}, {"type": "subtitle", "time": 10197.67, "timestamp": "02:49:57", "text": "いや、待って。私はどうすればいいのでしょうか？私"}]
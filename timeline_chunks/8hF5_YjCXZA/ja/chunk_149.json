[{"type": "subtitle", "time": 8942.87, "timestamp": "02:29:02", "text": "ヨナから釣りのために。"}, {"type": "subtitle", "time": 8945.59, "timestamp": "02:29:05", "text": "あなたなら助けてくれるかもしれないと言ったんです。"}, {"type": "subtitle", "time": 8947.11, "timestamp": "02:29:07", "text": "そして彼らは生命を獲得した"}, {"type": "subtitle", "time": 8949.67, "timestamp": "02:29:09", "text": "島。後であなたのために再開します"}, {"type": "subtitle", "time": 8951.19, "timestamp": "02:29:11", "text": "分。魚網を持って行ってください。あなたは"}, {"type": "subtitle", "time": 8952.55, "timestamp": "02:29:12", "text": "川でいくつか魚を捕まえることができました"}, {"type": "subtitle", "time": 8955.83, "timestamp": "02:29:15", "text": "海岸沿いに。"}, {"type": "subtitle", "time": 8959.429, "timestamp": "02:29:19", "text": "よし、釣り道具を手に入れたぞ。"}]
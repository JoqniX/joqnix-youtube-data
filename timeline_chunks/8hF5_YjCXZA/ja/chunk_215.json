[{"type": "subtitle", "time": 12902.15, "timestamp": "03:35:02", "text": "来て。私はただルーティングが必要だった"}, {"type": "subtitle", "time": 12904.79, "timestamp": "03:35:04", "text": "オーディオ。私たちは"}, {"type": "subtitle", "time": 12911.429, "timestamp": "03:35:11", "text": "これ"}, {"type": "subtitle", "time": 12915.19, "timestamp": "03:35:15", "text": "表a　よし、待って。ハハ。まあ、"}, {"type": "subtitle", "time": 12918.15, "timestamp": "03:35:18", "text": "ある意味、冒険家というのは私の仕事だ。私は愛する"}, {"type": "subtitle", "time": 12919.75, "timestamp": "03:35:19", "text": "さまざまな場所を探索し、戦う"}, {"type": "subtitle", "time": 12922.79, "timestamp": "03:35:22", "text": "Worldsは私の冒険を共有させてくれる"}, {"type": "subtitle", "time": 12926.63, "timestamp": "03:35:26", "text": "皆さん全員。つまり、"}, {"type": "subtitle", "time": 12929.99, "timestamp": "03:35:29", "text": "私の口を開けた笑顔の時の上腕二頭筋です。"}, {"type": "subtitle", "time": 12932.95, "timestamp": "03:35:32", "text": "こんにちは、忍者さん。今日の調子はどうですか？"}, {"type": "subtitle", "time": 12935.269, "timestamp": "03:35:35", "text": "ここでお会いできて嬉しいです。口を開ける"}, {"type": "subtitle", "time": 12950.309, "timestamp": "03:35:50", "text": "[音楽]"}, {"type": "subtitle", "time": 12953.99, "timestamp": "03:35:53", "text": "ああ、それならそうしてもいいかな。おお、"}]
[{"type": "subtitle", "time": 17882.948, "timestamp": "04:58:02", "text": "すべて、ええと、など。しかし、ビジネス名は"}, {"type": "subtitle", "time": 17884.948, "timestamp": "04:58:04", "text": "それは私の本名だったので、変更しなければなりません"}, {"type": "subtitle", "time": 17887.51, "timestamp": "04:58:07", "text": "今すぐやろう。そこで私はある選択肢を見ました"}, {"type": "subtitle", "time": 17890.47, "timestamp": "04:58:10", "text": "Razer Payに登録すれば、"}, {"type": "subtitle", "time": 17892.628, "timestamp": "04:58:12", "text": "ビジネスもその他すべて。だから私は"}, {"type": "subtitle", "time": 17895.11, "timestamp": "04:58:15", "text": "私の番号と全てを教えますが、"}, {"type": "subtitle", "time": 17899.83, "timestamp": "04:58:19", "text": "太陽光発電の所有権を選び、"}, {"type": "subtitle", "time": 17903.11, "timestamp": "04:58:23", "text": "それに、ええ、太陽光発電もやりました"}, {"type": "subtitle", "time": 17905.75, "timestamp": "04:58:25", "text": "所有権の件で、彼らは"}, {"type": "subtitle", "time": 17908.23, "timestamp": "04:58:28", "text": "予約のみで、予約のみ"}, {"type": "subtitle", "time": 17910.868, "timestamp": "04:58:30", "text": "LLCとすべてのことに焦点を当てて"}, {"type": "subtitle", "time": 17913.27, "timestamp": "04:58:33", "text": "一瞬。太陽光発電の所有権は"}, {"type": "subtitle", "time": 17916.15, "timestamp": "04:58:36", "text": "利用可能とか、そういう感じ。それから私は降りる"}, {"type": "subtitle", "time": 17918.47, "timestamp": "04:58:38", "text": "朝食ではなく、"}, {"type": "subtitle", "time": 17921.51, "timestamp": "04:58:41", "text": "ランチ。電話がかかってきて、彼らが"}, {"type": "subtitle", "time": 17925.51, "timestamp": "04:58:45", "text": "カミソリを表す何かから"}, {"type": "subtitle", "time": 17927.43, "timestamp": "04:58:47", "text": "給料か何かスタッフか何か"}, {"type": "subtitle", "time": 17929.11, "timestamp": "04:58:49", "text": "私がどんなビジネスをしたいのか教えてくれた"}, {"type": "subtitle", "time": 17932.31, "timestamp": "04:58:52", "text": "作るものすべて"}, {"type": "subtitle", "time": 17935.51, "timestamp": "04:58:55", "text": "そして、えっと"}, {"type": "subtitle", "time": 17939.11, "timestamp": "04:58:59", "text": "えーと、えーと、えーと、私は、すべてが明るいと言いました"}]
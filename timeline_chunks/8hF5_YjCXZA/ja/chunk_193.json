[{"type": "subtitle", "time": 11581.349, "timestamp": "03:13:01", "text": "これは私が買ったもので、これらは"}, {"type": "subtitle", "time": 11584.71, "timestamp": "03:13:04", "text": "これは両方とも膜のメンバーです"}, {"type": "subtitle", "time": 11587.75, "timestamp": "03:13:07", "text": "キーボードがないので、"}, {"type": "subtitle", "time": 11592.07, "timestamp": "03:13:12", "text": "カザック、カザックの音。そして私は"}, {"type": "subtitle", "time": 11593.59, "timestamp": "03:13:13", "text": "カミソリ"}, {"type": "subtitle", "time": 11599.67, "timestamp": "03:13:19", "text": "ええ、これとキーボードを選びました。"}, {"type": "subtitle", "time": 11602.95, "timestamp": "03:13:22", "text": "これはメンブレン式の60%キーボードです。私"}, {"type": "subtitle", "time": 11606.07, "timestamp": "03:13:26", "text": "60%キーボードが本当に好きです。"}, {"type": "subtitle", "time": 11609.11, "timestamp": "03:13:29", "text": "本当に小さいのに、すごく広い。その"}, {"type": "subtitle", "time": 11612.389, "timestamp": "03:13:32", "text": "ご覧のとおり、ワイヤレス接続も可能です。"}, {"type": "subtitle", "time": 11614.87, "timestamp": "03:13:34", "text": "充電するんです。 1、2回充電してください。"}, {"type": "subtitle", "time": 11618.63, "timestamp": "03:13:38", "text": "それでおしまい。それは良いです。"}, {"type": "subtitle", "time": 11620.63, "timestamp": "03:13:40", "text": "これはタイプライターのキーボードのようなものです。"}, {"type": "subtitle", "time": 11623.429, "timestamp": "03:13:43", "text": "これは1つくらいで、"}, {"type": "subtitle", "time": 11627.19, "timestamp": "03:13:47", "text": "マウスも無料で、それも"}, {"type": "subtitle", "time": 11629.429, "timestamp": "03:13:49", "text": "ワイヤレス"}, {"type": "subtitle", "time": 11633.269, "timestamp": "03:13:53", "text": "また、60％というのは、これも良いですね。"}, {"type": "subtitle", "time": 11637.75, "timestamp": "03:13:57", "text": "それで私はそれを選び、"}]
[{"type": "subtitle", "time": 8045.91, "timestamp": "02:14:05", "text": "[音楽]"}, {"type": "subtitle", "time": 8049.43, "timestamp": "02:14:09", "text": "熱いお湯を飲む。"}, {"type": "subtitle", "time": 8052.55, "timestamp": "02:14:12", "text": "私は少し後に昼食に行きます"}, {"type": "subtitle", "time": 8057.03, "timestamp": "02:14:17", "text": "午後1時か2時頃私は推測する。"}, {"type": "subtitle", "time": 8080.229, "timestamp": "02:14:40", "text": "ノエルになりたいの？おお。えっと、それは"}, {"type": "subtitle", "time": 8083.75, "timestamp": "02:14:43", "text": "ええと、それは実は目標の一つなんです。"}, {"type": "subtitle", "time": 8086.79, "timestamp": "02:14:46", "text": "私はそのゲームをプレイします。えっと、どこが"}, {"type": "subtitle", "time": 8089.43, "timestamp": "02:14:49", "text": "私の考えは実際どうだったか？"}, {"type": "subtitle", "time": 8092.069, "timestamp": "02:14:52", "text": "大丈夫だと思います。今ならこれをお見せできます"}, {"type": "subtitle", "time": 8094.95, "timestamp": "02:14:54", "text": "皆さんへ。"}]
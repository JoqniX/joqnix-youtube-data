[{"type": "subtitle", "time": 14282.87, "timestamp": "03:58:02", "text": "えっと、さっき言ったように、私は"}, {"type": "subtitle", "time": 14285.59, "timestamp": "03:58:05", "text": "外に出てそれをする準備をして"}, {"type": "subtitle", "time": 14296.79, "timestamp": "03:58:16", "text": "問題は、これをやりたいということだが、"}, {"type": "subtitle", "time": 14300.63, "timestamp": "03:58:20", "text": "君たちの粘り強さ"}, {"type": "subtitle", "time": 14302.95, "timestamp": "03:58:22", "text": "私は信頼の問題を抱えています"}, {"type": "subtitle", "time": 14306.309, "timestamp": "03:58:26", "text": "問題点。さらに、"}, {"type": "subtitle", "time": 14309.349, "timestamp": "03:58:29", "text": "あなたの車の登録情報。"}, {"type": "subtitle", "time": 14311.83, "timestamp": "03:58:31", "text": "いくつかの"}, {"type": "subtitle", "time": 14314.79, "timestamp": "03:58:34", "text": "えっと、あなたのレビューを見ました"}]
[{"type": "subtitle", "time": 3255.51, "timestamp": "00:54:15", "text": "バグから来ていて、まだ神聖なものでもない。"}, {"type": "subtitle", "time": 3259.99, "timestamp": "00:54:19", "text": "ああ、ホーリー祭が近づいている。おお、"}, {"type": "subtitle", "time": 3262.71, "timestamp": "00:54:22", "text": "皆さんは聖なる日のために何をするんですか？私は決して"}, {"type": "subtitle", "time": 3265.91, "timestamp": "00:54:25", "text": "聖なる日を祝ったので、私は"}, {"type": "subtitle", "time": 3267.589, "timestamp": "00:54:27", "text": "知る、"}, {"type": "subtitle", "time": 3270.79, "timestamp": "00:54:30", "text": "男。もし私がまだプネーなどにいたら、"}, {"type": "subtitle", "time": 3274.63, "timestamp": "00:54:34", "text": "ホーリー祭を体験できたかもしれない"}]
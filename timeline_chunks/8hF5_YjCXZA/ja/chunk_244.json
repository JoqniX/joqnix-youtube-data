[{"type": "subtitle", "time": 14671.59, "timestamp": "04:04:31", "text": "理解しているのですが"}, {"type": "subtitle", "time": 14679.11, "timestamp": "04:04:39", "text": "いいえ、私が必要なのは"}, {"type": "subtitle", "time": 14681.99, "timestamp": "04:04:41", "text": "UPIサービスで本名を隠して"}, {"type": "subtitle", "time": 14684.469, "timestamp": "04:04:44", "text": "人々が支払いを行う際のすべて。"}, {"type": "subtitle", "time": 14686.71, "timestamp": "04:04:46", "text": "私が望むのはそれだけです。だから私は"}, {"type": "subtitle", "time": 14689.429, "timestamp": "04:04:49", "text": "Razor Payでは、"}, {"type": "subtitle", "time": 14692.15, "timestamp": "04:04:52", "text": "事業登録などができる。"}, {"type": "subtitle", "time": 14695.51, "timestamp": "04:04:55", "text": "うん。そして選択肢があったので"}, {"type": "subtitle", "time": 14697.91, "timestamp": "04:04:57", "text": "ソロのために「えー」と言わなかった"}]
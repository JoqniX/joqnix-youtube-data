[{"type": "subtitle", "time": 18067.99, "timestamp": "05:01:07", "text": "そして私は2,000しか持っていませんでした"}, {"type": "subtitle", "time": 18071.27, "timestamp": "05:01:11", "text": "えっと、私の財布の中に。そして私は"}, {"type": "subtitle", "time": 18075.03, "timestamp": "05:01:15", "text": "私の財布に入っていた現金はそれだけだった"}, {"type": "subtitle", "time": 18077.83, "timestamp": "05:01:17", "text": "えっと、銀行の件で、"}, {"type": "subtitle", "time": 18081.19, "timestamp": "05:01:21", "text": "彼らに送ったりするけど、私は嬉しい"}, {"type": "subtitle", "time": 18096.708, "timestamp": "05:01:36", "text": "ええ、コフィは2ドル受け取ったと思います。いいえ、"}, {"type": "subtitle", "time": 18098.708, "timestamp": "05:01:38", "text": "それはPayPalです。コフィは"}, {"type": "subtitle", "time": 18107.67, "timestamp": "05:01:47", "text": "KofiはPayPalと連携しています。"}, {"type": "subtitle", "time": 18115.51, "timestamp": "05:01:55", "text": "私は考えていた"}, {"type": "subtitle", "time": 18117.67, "timestamp": "05:01:57", "text": "君たち。わかった。"}]
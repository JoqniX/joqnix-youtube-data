[{"type": "subtitle", "time": 243.11, "timestamp": "00:04:03", "text": "ストリーミングできるように全て設定してください。しないで"}, {"type": "subtitle", "time": 245.99, "timestamp": "00:04:05", "text": "ジョーイをオンにする必要がある。ストリーミング配信できます"}, {"type": "subtitle", "time": 248.63, "timestamp": "00:04:08", "text": "私の場合、2つのバージョンを作成する必要があります。 1つ"}, {"type": "subtitle", "time": 252.22899999999998, "timestamp": "00:04:12", "text": "これは、楽しいセットアップのためのものです。もう一つは"}, {"type": "subtitle", "time": 254.07, "timestamp": "00:04:14", "text": "設定。"}, {"type": "subtitle", "time": 257.03, "timestamp": "00:04:17", "text": "だから両方ともやるつもりです。"}, {"type": "subtitle", "time": 271.43, "timestamp": "00:04:31", "text": "なぜ私のOBSは60～78%なのでしょうか？"}, {"type": "subtitle", "time": 274.87, "timestamp": "00:04:34", "text": "ああ、64まで下がるよ。わかった。"}, {"type": "subtitle", "time": 278.55, "timestamp": "00:04:38", "text": "今のところ、私たちの明らかな"}, {"type": "subtitle", "time": 282.23, "timestamp": "00:04:42", "text": "とても安定していて嬉しいです"}, {"type": "subtitle", "time": 284.07, "timestamp": "00:04:44", "text": "しかし"}, {"type": "subtitle", "time": 288.07, "timestamp": "00:04:48", "text": "私はそうしないように努めるべきです"}, {"type": "subtitle", "time": 291.03, "timestamp": "00:04:51", "text": "以前と同じように過負荷をかけてください。だから私は"}, {"type": "subtitle", "time": 294.87, "timestamp": "00:04:54", "text": "すべてに目を向け、希望と祈りを捧げます"}, {"type": "subtitle", "time": 299.43, "timestamp": "00:04:59", "text": "食べ過ぎないようにね。"}]
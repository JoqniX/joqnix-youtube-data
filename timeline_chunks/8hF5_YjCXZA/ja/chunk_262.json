[{"type": "subtitle", "time": 15722.63, "timestamp": "04:22:02", "text": "えっと、レアペイリンクをくれたか、"}, {"type": "subtitle", "time": 15725.51, "timestamp": "04:22:05", "text": "何かと"}, {"type": "subtitle", "time": 15727.59, "timestamp": "04:22:07", "text": "彼らはその方法について尋ね続けた"}, {"type": "subtitle", "time": 15730.55, "timestamp": "04:22:10", "text": "支払い。"}, {"type": "subtitle", "time": 15732.55, "timestamp": "04:22:12", "text": "なぜ私たちは、"}, {"type": "subtitle", "time": 15736.149, "timestamp": "04:22:16", "text": "ストリーム？そうそう。なんてこった。なぜなら、なぜなら"}, {"type": "subtitle", "time": 15739.99, "timestamp": "04:22:19", "text": "Racer pay 私はアカウント名を次のように入力しました"}, {"type": "subtitle", "time": 15742.55, "timestamp": "04:22:22", "text": "ジョクネックス。"}, {"type": "subtitle", "time": 15745.59, "timestamp": "04:22:25", "text": "うん。アカウント名はJoexです。だってどうやって"}, {"type": "subtitle", "time": 15748.71, "timestamp": "04:22:28", "text": "彼らは私の電話番号を知っているのか？レーサーは支払う"}, {"type": "subtitle", "time": 15751.03, "timestamp": "04:22:31", "text": "ウェブサイトはそれをこれらの企業と共有しました。"}, {"type": "subtitle", "time": 15754.229, "timestamp": "04:22:34", "text": "右？彼らは私の名前も共有し、"}, {"type": "subtitle", "time": 15757.429, "timestamp": "04:22:37", "text": "私のものですよね？"}, {"type": "subtitle", "time": 15760.71, "timestamp": "04:22:40", "text": "よく考えてみて。"}, {"type": "subtitle", "time": 15763.51, "timestamp": "04:22:43", "text": "だから、彼らが二重チェックするんじゃないかと心配だった"}, {"type": "subtitle", "time": 15767.11, "timestamp": "04:22:47", "text": "その偽名が何なのか、その他すべて。"}, {"type": "subtitle", "time": 15770.55, "timestamp": "04:22:50", "text": "彼らがそれをチェックして、えーっと見て"}, {"type": "subtitle", "time": 15772.79, "timestamp": "04:22:52", "text": "ストリームを見て、私が話しているのを見てください"}, {"type": "subtitle", "time": 15775.429, "timestamp": "04:22:55", "text": "彼らはライブ配信でもするのかな？"}, {"type": "subtitle", "time": 15778.07, "timestamp": "04:22:58", "text": "だから心配だったんです。何が起こるかわからない"}]
[{"type": "subtitle", "time": 7815.76, "timestamp": "02:10:15", "text": "ええと、コーヒーを買います。遅いですよね？"}, {"type": "subtitle", "time": 7817.35, "timestamp": "02:10:17", "text": "[拍手]"}, {"type": "subtitle", "time": 7821.96, "timestamp": "02:10:21", "text": "私はこれをそこから再生したい"}, {"type": "subtitle", "time": 7824.149, "timestamp": "02:10:24", "text": "[音楽]"}, {"type": "subtitle", "time": 7828.55, "timestamp": "02:10:28", "text": "工事中。はい、ついに。"}, {"type": "subtitle", "time": 7832.73, "timestamp": "02:10:32", "text": "近いうちにアニメ化される予定だよ。"}, {"type": "subtitle", "time": 7835.109, "timestamp": "02:10:35", "text": "[音楽]"}, {"type": "subtitle", "time": 7837.91, "timestamp": "02:10:37", "text": "そして、ここがハムバクの街です。エリア5"}, {"type": "subtitle", "time": 7841.03, "timestamp": "02:10:41", "text": "4 3 2 1。"}, {"type": "subtitle", "time": 7845.05, "timestamp": "02:10:45", "text": "その地域を見てください。とても美味しいです。いいえ。"}]
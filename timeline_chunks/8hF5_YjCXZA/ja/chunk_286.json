[{"type": "subtitle", "time": 17162.15, "timestamp": "04:46:02", "text": "私の過ちを謝ります。何"}, {"type": "subtitle", "time": 17165.03, "timestamp": "04:46:05", "text": "あなたはしない"}, {"type": "subtitle", "time": 17171.73, "timestamp": "04:46:11", "text": "え、何？"}, {"type": "subtitle", "time": 17179.67, "timestamp": "04:46:19", "text": "ああ、あと5分だ。彼は"}, {"type": "subtitle", "time": 17181.51, "timestamp": "04:46:21", "text": "男を呼べ。"}, {"type": "subtitle", "time": 17210.708, "timestamp": "04:46:50", "text": "なぜ私は成績が悪いのでしょうか？なぜ私は体調が悪いのでしょうか"}, {"type": "subtitle", "time": 17214.23, "timestamp": "04:46:54", "text": "私の人生における決断？ああ、"}, {"type": "subtitle", "time": 17216.23, "timestamp": "04:46:56", "text": "最悪だ。"}]
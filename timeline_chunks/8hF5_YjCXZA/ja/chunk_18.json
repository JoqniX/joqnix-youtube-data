[{"type": "subtitle", "time": 1081.27, "timestamp": "00:18:01", "text": "はい、どうぞ。ツイートしました。ない"}, {"type": "subtitle", "time": 1084.63, "timestamp": "00:18:04", "text": "ツイートした。えっと、投稿しました。私は思う"}, {"type": "subtitle", "time": 1089.75, "timestamp": "00:18:09", "text": "インスタグラムにも投稿しました。あと、えっと、"}, {"type": "subtitle", "time": 1093.75, "timestamp": "00:18:13", "text": "昨日の分析結果を投稿しました"}, {"type": "subtitle", "time": 1097.029, "timestamp": "00:18:17", "text": "ソーシャルメディア初日。もしあなたが"}, {"type": "subtitle", "time": 1099.51, "timestamp": "00:18:19", "text": "なぜそんなことをしたのかと聞かれたら、それは"}, {"type": "subtitle", "time": 1102.07, "timestamp": "00:18:22", "text": "証拠を示すため"}, {"type": "subtitle", "time": 1104.87, "timestamp": "00:18:24", "text": "そして、あなたが"}, {"type": "subtitle", "time": 1106.87, "timestamp": "00:18:26", "text": "言える"}, {"type": "subtitle", "time": 1110.71, "timestamp": "00:18:30", "text": "なぜなら、それらは努力と科学だから"}, {"type": "subtitle", "time": 1113.669, "timestamp": "00:18:33", "text": "君たちが僕を信じてくれて"}, {"type": "subtitle", "time": 1115.909, "timestamp": "00:18:35", "text": "そしてすべて"}, {"type": "subtitle", "time": 1119.43, "timestamp": "00:18:39", "text": "そしてそれは私が破ってはならない信頼であり、"}, {"type": "subtitle", "time": 1121.43, "timestamp": "00:18:41", "text": "それは必須事項です。"}, {"type": "subtitle", "time": 1130.15, "timestamp": "00:18:50", "text": "ええと、あらゆる形態のあらゆる"}, {"type": "subtitle", "time": 1132.87, "timestamp": "00:18:52", "text": "あなたが見ているかどうかに関わらず、サポートの形"}, {"type": "subtitle", "time": 1135.27, "timestamp": "00:18:55", "text": "私が好きな"}, {"type": "subtitle", "time": 1138.71, "timestamp": "00:18:58", "text": "クリップを作成するサポート"}]
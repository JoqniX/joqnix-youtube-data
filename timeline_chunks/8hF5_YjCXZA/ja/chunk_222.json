[{"type": "subtitle", "time": 13322.55, "timestamp": "03:42:02", "text": "彼らはそれをやりたいと思っているが、そう、私は"}, {"type": "subtitle", "time": 13324.95, "timestamp": "03:42:04", "text": "会社名を言うだけでいいのに、"}, {"type": "subtitle", "time": 13326.79, "timestamp": "03:42:06", "text": "彼らは私の配信を見るつもりです、"}, {"type": "subtitle", "time": 13333.11, "timestamp": "03:42:13", "text": "彼らが私に何か、えっと、あれを。彼らは、彼らは"}, {"type": "subtitle", "time": 13337.19, "timestamp": "03:42:17", "text": "レジスターカロとかいう名前のやつです。"}, {"type": "subtitle", "time": 13344.07, "timestamp": "03:42:24", "text": "わかった。オンラインビジネスコンプライアンス"}, {"type": "subtitle", "time": 13345.83, "timestamp": "03:42:25", "text": "企業やその他の組織を支援するプラットフォーム"}, {"type": "subtitle", "time": 13347.59, "timestamp": "03:42:27", "text": "さまざまな登録を持つ個人、"}, {"type": "subtitle", "time": 13350.389, "timestamp": "03:42:30", "text": "税務申告およびその他の法的問題。ホー"}, {"type": "subtitle", "time": 13357.429, "timestamp": "03:42:37", "text": "レビューを見ました。最悪の部類に入る"}, {"type": "subtitle", "time": 13359.11, "timestamp": "03:42:39", "text": "サービスもビールもプロ意識に欠けていた。"}, {"type": "subtitle", "time": 13361.269, "timestamp": "03:42:41", "text": "この会社から。何てことだ。素晴らしい"}, {"type": "subtitle", "time": 13363.67, "timestamp": "03:42:43", "text": "サービス。迅速な対応時間。手頃な価格"}, {"type": "subtitle", "time": 13365.51, "timestamp": "03:42:45", "text": "価格。"}, {"type": "subtitle", "time": 13367.269, "timestamp": "03:42:47", "text": "非常に的確で迅速な案内でした。プロセス"}, {"type": "subtitle", "time": 13370.71, "timestamp": "03:42:50", "text": "会社登記。わかった。"}]
[{"type": "subtitle", "time": 124.63, "timestamp": "00:02:04", "text": "明日、私は最初のテストを行います"}, {"type": "subtitle", "time": 127.749, "timestamp": "00:02:07", "text": "ええと、歩く小川。いや、最初のクソ野郎じゃない"}, {"type": "subtitle", "time": 133.11, "timestamp": "00:02:13", "text": "ストリーム。私の最初のモバイルPCは"}, {"type": "subtitle", "time": 137.51, "timestamp": "00:02:17", "text": "フレーム。つまり、私は生放送に出演するということです。私は"}, {"type": "subtitle", "time": 140.949, "timestamp": "00:02:20", "text": "動画を送信します。いいえ、ビデオ音声ではありません"}, {"type": "subtitle", "time": 143.35, "timestamp": "00:02:23", "text": "餌。音声・映像。うん。うん。うん。"}, {"type": "subtitle", "time": 145.19, "timestamp": "00:02:25", "text": "もしそれが"}, {"type": "subtitle", "time": 149.75, "timestamp": "00:02:29", "text": "PC は、私がただ魚を見せているだけです"}, {"type": "subtitle", "time": 153.67000000000002, "timestamp": "00:02:33", "text": "えっと、ヒオケンがそのままあそこに来たんです。"}, {"type": "subtitle", "time": 156.869, "timestamp": "00:02:36", "text": "私はフィードを送信します"}, {"type": "subtitle", "time": 158.949, "timestamp": "00:02:38", "text": "電話。私は携帯電話からストリーミング配信します"}, {"type": "subtitle", "time": 161.589, "timestamp": "00:02:41", "text": "PC。するとPCは"}, {"type": "subtitle", "time": 164.71, "timestamp": "00:02:44", "text": "自動的にライブ配信される"}, {"type": "subtitle", "time": 168.07, "timestamp": "00:02:48", "text": "チャットコマンドはYouTubeでライブ配信されます。"}, {"type": "subtitle", "time": 170.63, "timestamp": "00:02:50", "text": "プラットフォームがどこにあろうとも。そして"}, {"type": "subtitle", "time": 173.99, "timestamp": "00:02:53", "text": "うん、ライブ配信されるから、"}, {"type": "subtitle", "time": 175.67000000000002, "timestamp": "00:02:55", "text": "ストリーム。"}, {"type": "subtitle", "time": 178.79, "timestamp": "00:02:58", "text": "きっと楽しいよ。私はYouTubeをやっていません"}]
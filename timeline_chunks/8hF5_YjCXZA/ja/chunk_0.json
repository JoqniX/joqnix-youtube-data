[{"type": "subtitle", "time": 2.629, "timestamp": "00:00:02", "text": "30歳か40歳くらいかな。"}, {"type": "subtitle", "time": 5.91, "timestamp": "00:00:05", "text": "そして50まで到達します。そして次"}, {"type": "subtitle", "time": 9.589, "timestamp": "00:00:09", "text": "ストリームには完全なものが含まれます。"}, {"type": "subtitle", "time": 13.509, "timestamp": "00:00:13", "text": "わかった。だから60、70、80、80で終わる。"}, {"type": "subtitle", "time": 17.269, "timestamp": "00:00:17", "text": "次の猫たちはきちんと整理されていて"}, {"type": "subtitle", "time": 19.67, "timestamp": "00:00:19", "text": "ストリーム。わかった。よし。ありがとうございます"}, {"type": "subtitle", "time": 22.07, "timestamp": "00:00:22", "text": "ミナ、来てくれてありがとう。ゴアで"}, {"type": "subtitle", "time": 25.83, "timestamp": "00:00:25", "text": "短い配信だったけど、とても楽しかった。"}, {"type": "subtitle", "time": 31.669, "timestamp": "00:00:31", "text": "今日訪れた人は皆"}, {"type": "subtitle", "time": 38.069, "timestamp": "00:00:38", "text": "ええと、今日来てくれた人はみんな"}, {"type": "subtitle", "time": 40.229, "timestamp": "00:00:40", "text": "なれ"}, {"type": "subtitle", "time": 43.43, "timestamp": "00:00:43", "text": "ちょっと待って"}, {"type": "subtitle", "time": 45.11, "timestamp": "00:00:45", "text": "うん"}, {"type": "subtitle", "time": 55.029, "timestamp": "00:00:55", "text": "来てくれてありがとう"}]
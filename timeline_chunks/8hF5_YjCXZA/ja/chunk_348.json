[{"type": "subtitle", "time": 20885.03, "timestamp": "05:48:05", "text": "元に戻す。わかった。えっと"}, {"type": "subtitle", "time": 20889.27, "timestamp": "05:48:09", "text": "これ以上よく見えることはない。わかった。待って。もしも"}, {"type": "subtitle", "time": 20892.47, "timestamp": "05:48:12", "text": "サンプルを入手できますか？"}, {"type": "subtitle", "time": 20894.47, "timestamp": "05:48:14", "text": "量子化されていますか？"}, {"type": "subtitle", "time": 20896.788, "timestamp": "05:48:16", "text": "そうではありません。わかった。"}, {"type": "subtitle", "time": 20899.91, "timestamp": "05:48:19", "text": "ところで、"}, {"type": "subtitle", "time": 20915.91, "timestamp": "05:48:35", "text": "声を出す方法はこうです"}, {"type": "subtitle", "time": 20920.23, "timestamp": "05:48:40", "text": "ちなみに、チョップのことだよ。スライスしてください。ああ、"}, {"type": "subtitle", "time": 20923.11, "timestamp": "05:48:43", "text": "そんな風にはいかないよ。はい、"}, {"type": "subtitle", "time": 20925.67, "timestamp": "05:48:45", "text": "これに関しては無理だ。"}, {"type": "subtitle", "time": 20930.07, "timestamp": "05:48:50", "text": "ええと、私たちは次のようなことができます"}, {"type": "subtitle", "time": 20933.19, "timestamp": "05:48:53", "text": "音を変えることはできるけど、"}, {"type": "subtitle", "time": 20937.83, "timestamp": "05:48:57", "text": "やらなければならないのですか？わからない。"}]
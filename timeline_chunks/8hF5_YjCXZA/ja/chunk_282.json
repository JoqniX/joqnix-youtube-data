[{"type": "subtitle", "time": 16922.47, "timestamp": "04:42:02", "text": "そして彼は金色のゴールを決めた"}, {"type": "subtitle", "time": 16925.03, "timestamp": "04:42:05", "text": "配布進捗状況の追跡"}, {"type": "subtitle", "time": 16930.39, "timestamp": "04:42:10", "text": "アラートとすべての履歴設定。"}, {"type": "subtitle", "time": 16935.11, "timestamp": "04:42:15", "text": "どうやってこれを全部コーディングしたの？"}, {"type": "subtitle", "time": 16940.708, "timestamp": "04:42:20", "text": "オーバーレイを表示しますか？うん。ああ、兄弟。"}, {"type": "subtitle", "time": 16943.11, "timestamp": "04:42:23", "text": "ありえない"}, {"type": "subtitle", "time": 16948.708, "timestamp": "04:42:28", "text": "どうやって？"}, {"type": "subtitle", "time": 16965.19, "timestamp": "04:42:45", "text": "そう、これらのボタンは"}, {"type": "subtitle", "time": 16967.67, "timestamp": "04:42:47", "text": "責任者。うん、これはすごくクールだね。"}, {"type": "subtitle", "time": 16969.75, "timestamp": "04:42:49", "text": "そうじゃない？"}, {"type": "subtitle", "time": 16979.27, "timestamp": "04:42:59", "text": "彼が費やしたであろう時間"}]
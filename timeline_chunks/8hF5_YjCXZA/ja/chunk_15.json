[{"type": "subtitle", "time": 900.31, "timestamp": "00:15:00", "text": "私はTwitchで最初の視聴者だと主張します。"}, {"type": "subtitle", "time": 916.949, "timestamp": "00:15:16", "text": "ああ、喉が痛い。"}, {"type": "subtitle", "time": 919.03, "timestamp": "00:15:19", "text": "ログに基づいて作成されました。ああ、ありがとうございます。ありがとう。"}, {"type": "subtitle", "time": 936.87, "timestamp": "00:15:36", "text": "ヨアトンの主な目標は"}, {"type": "subtitle", "time": 941.75, "timestamp": "00:15:41", "text": "寄付やその他すべてだけでなく"}, {"type": "subtitle", "time": 945.59, "timestamp": "00:15:45", "text": "私は自分の快適な領域から抜け出さなければならなかった。"}, {"type": "subtitle", "time": 949.91, "timestamp": "00:15:49", "text": "私は自分の限界を超えなければならない。"}, {"type": "subtitle", "time": 953.43, "timestamp": "00:15:53", "text": "自分の限界を突破するにはどうすればいいのか。"}, {"type": "subtitle", "time": 956.23, "timestamp": "00:15:56", "text": "限界によって、限界によって、つまり"}, {"type": "subtitle", "time": 959.03, "timestamp": "00:15:59", "text": "24時間放送やストリーミング配信ではない"}]
[{"type": "subtitle", "time": 7090.29, "timestamp": "01:58:10", "text": "そして、leは国です。いいえは状態です。"}, {"type": "subtitle", "time": 7091.83, "timestamp": "01:58:11", "text": "[音楽]"}, {"type": "subtitle", "time": 7094.79, "timestamp": "01:58:14", "text": "ラダックはドバイにはありません。"}, {"type": "subtitle", "time": 7125.51, "timestamp": "01:58:45", "text": "ごめんなさい。ごめんなさい。私はまだ"}, {"type": "subtitle", "time": 7129.27, "timestamp": "01:58:49", "text": "何かの状態を発見する"}, {"type": "subtitle", "time": 7137.91, "timestamp": "01:58:57", "text": "[音楽]"}]
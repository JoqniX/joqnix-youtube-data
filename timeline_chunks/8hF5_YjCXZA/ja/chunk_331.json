[{"type": "subtitle", "time": 19862.39, "timestamp": "05:31:02", "text": "4バールのグリットになるまで待つ。いいえ、エイトボール"}, {"type": "subtitle", "time": 19871.01, "timestamp": "05:31:11", "text": "はぁ。"}, {"type": "subtitle", "time": 19881.27, "timestamp": "05:31:21", "text": "変化をつけるために、私は"}, {"type": "subtitle", "time": 19884.628, "timestamp": "05:31:24", "text": "次のような"}, {"type": "subtitle", "time": 19886.39, "timestamp": "05:31:26", "text": "えーと"}, {"type": "subtitle", "time": 19891.35, "timestamp": "05:31:31", "text": "私はこれを16ビットでできます"}, {"type": "subtitle", "time": 19899.35, "timestamp": "05:31:39", "text": "いいえ、それは8です。八。"}, {"type": "subtitle", "time": 19902.07, "timestamp": "05:31:42", "text": "忘れた。ああ、しまった、必要なものを忘れてしまった。"}, {"type": "subtitle", "time": 19904.708, "timestamp": "05:31:44", "text": "でも、そうですね、もしかしたら私たちは"}, {"type": "subtitle", "time": 19907.91, "timestamp": "05:31:47", "text": "これに速度変化を加えてください。"}, {"type": "subtitle", "time": 19911.98, "timestamp": "05:31:51", "text": "えっと、"}, {"type": "subtitle", "time": 19915.75, "timestamp": "05:31:55", "text": "[音楽]"}, {"type": "subtitle", "time": 19918.47, "timestamp": "05:31:58", "text": "今はそんな感じに聞こえる。じゃあソロでやらせてくれ"}]
[{"type": "subtitle", "time": 8289.589, "timestamp": "02:18:09", "text": "これはどこ？ああ、そうだ、そうだね。"}, {"type": "subtitle", "time": 8301.53, "timestamp": "02:18:21", "text": "ところで、どのコピーについて話しているのですか？"}, {"type": "subtitle", "time": 8308.709, "timestamp": "02:18:28", "text": "35ドルだったので、これを買いたかったんです。"}, {"type": "subtitle", "time": 8310.709, "timestamp": "02:18:30", "text": "ルピー。しかし私はそうではないと気づいた"}, {"type": "subtitle", "time": 8313.27, "timestamp": "02:18:33", "text": "カードに最低残高が必要です。だから私は"}, {"type": "subtitle", "time": 8315.589, "timestamp": "02:18:35", "text": "購入はできません。"}, {"type": "subtitle", "time": 8322.07, "timestamp": "02:18:42", "text": "みんな、みんな、私が気付いた"}, {"type": "subtitle", "time": 8326.95, "timestamp": "02:18:46", "text": "みんなが怖いゲームをプレイしている"}, {"type": "subtitle", "time": 8329.11, "timestamp": "02:18:49", "text": "えーと、この絵文字を見てください"}, {"type": "subtitle", "time": 8330.709, "timestamp": "02:18:50", "text": "なんでこんな風に作ったの？"}]
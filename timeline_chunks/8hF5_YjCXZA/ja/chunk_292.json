[{"type": "subtitle", "time": 17523.59, "timestamp": "04:52:03", "text": "また、3つになる予定です。えっと、"}, {"type": "subtitle", "time": 17526.628, "timestamp": "04:52:06", "text": "僕たち、音楽関係の仕事してるの？いいえ、"}, {"type": "subtitle", "time": 17529.27, "timestamp": "04:52:09", "text": "電話の後。いいえ、3つ後に"}, {"type": "subtitle", "time": 17536.31, "timestamp": "04:52:16", "text": "先生が音楽を教えてくれるかどうかわかりません"}, {"type": "subtitle", "time": 17538.55, "timestamp": "04:52:18", "text": "先生は私をクラスに入れてくれるだろう、なぜなら私は"}, {"type": "subtitle", "time": 17541.91, "timestamp": "04:52:21", "text": "彼らに支払っていない"}, {"type": "subtitle", "time": 17548.868, "timestamp": "04:52:28", "text": "えっと"}]
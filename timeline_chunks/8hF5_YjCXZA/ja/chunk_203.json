[{"type": "subtitle", "time": 12182.71, "timestamp": "03:23:02", "text": "サービス。これをやってよかった。"}, {"type": "subtitle", "time": 12186.79, "timestamp": "03:23:06", "text": "私はそうでしょうか？私はこれをやって本当に良かったと思っています"}, {"type": "subtitle", "time": 12190.15, "timestamp": "03:23:10", "text": "実を言うと。"}, {"type": "subtitle", "time": 12191.59, "timestamp": "03:23:11", "text": "こうすればポートは不要です"}, {"type": "subtitle", "time": 12194.55, "timestamp": "03:23:14", "text": "フォワードとか、そういうバカげたことは全部ダメ。私"}, {"type": "subtitle", "time": 12218.71, "timestamp": "03:23:38", "text": "大きなものを忘れていました。はい、これは"}, {"type": "subtitle", "time": 12222.63, "timestamp": "03:23:42", "text": "マグロですよね？マグロ玉"}, {"type": "subtitle", "time": 12227.429, "timestamp": "03:23:47", "text": "マグロ。彼はちょっと落ちぶれている。"}]
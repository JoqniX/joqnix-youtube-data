[{"type": "subtitle", "time": 5881.189, "timestamp": "01:38:01", "text": "行動を起こすが、彼らは行動を控える"}, {"type": "subtitle", "time": 5883.91, "timestamp": "01:38:03", "text": "行動を起こすか、あるいは動くことを恐れているかのどちらかだ。いいえ、"}, {"type": "subtitle", "time": 5886.149, "timestamp": "01:38:06", "text": "あなたはそういうタイプになりたくないでしょう。"}, {"type": "subtitle", "time": 5888.629, "timestamp": "01:38:08", "text": "最終的には、"}, {"type": "subtitle", "time": 5893.91, "timestamp": "01:38:13", "text": "あなたがそういう人なら何でも。右？それで"}, {"type": "subtitle", "time": 5897.51, "timestamp": "01:38:17", "text": "時には自分の"}, {"type": "subtitle", "time": 5902.39, "timestamp": "01:38:22", "text": "自分自身で行動を起こしましょう。わかった。"}, {"type": "subtitle", "time": 5906.31, "timestamp": "01:38:26", "text": "うん。それが問題なんです"}, {"type": "subtitle", "time": 5908.79, "timestamp": "01:38:28", "text": "人とコミュニケーションを取り、あらゆることと関わる。"}, {"type": "subtitle", "time": 5911.27, "timestamp": "01:38:31", "text": "小さな一歩から始めましょう。自分自身に話しかける"}, {"type": "subtitle", "time": 5914.47, "timestamp": "01:38:34", "text": "鏡も何もかも。自分自身に話しかける"}, {"type": "subtitle", "time": 5918.07, "timestamp": "01:38:38", "text": "あなたが望むなら。自己愛は大切です。"}, {"type": "subtitle", "time": 5921.27, "timestamp": "01:38:41", "text": "家族と話し合ってください。ペットに話しかけてみましょう。"}, {"type": "subtitle", "time": 5923.51, "timestamp": "01:38:43", "text": "そして全て。それは一つの形態である"}, {"type": "subtitle", "time": 5925.51, "timestamp": "01:38:45", "text": "コミュニケーション。"}, {"type": "subtitle", "time": 5929.03, "timestamp": "01:38:49", "text": "そして家族の後は、"}, {"type": "subtitle", "time": 5931.109, "timestamp": "01:38:51", "text": "隣人や"}, {"type": "subtitle", "time": 5935.189, "timestamp": "01:38:55", "text": "心地よく感じる。うん。それから"}, {"type": "subtitle", "time": 5938.47, "timestamp": "01:38:58", "text": "買い物に行くときは、食料品店に行くと"}]
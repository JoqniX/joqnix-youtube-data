[{"type": "subtitle", "time": 15423.03, "timestamp": "04:17:03", "text": "私が言ったようなことについておしゃべりしている"}, {"type": "subtitle", "time": 15425.51, "timestamp": "04:17:05", "text": "えーっと、ピンポイントでピンポイントで"}, {"type": "subtitle", "time": 15427.429, "timestamp": "04:17:07", "text": "否定的なレビューやその他"}, {"type": "subtitle", "time": 15430.95, "timestamp": "04:17:10", "text": "彼を"}, {"type": "subtitle", "time": 15432.79, "timestamp": "04:17:12", "text": "スピーカーですが、問題は彼が彼を呼んだことです"}, {"type": "subtitle", "time": 15434.87, "timestamp": "04:17:14", "text": "彼は私の本名を言ったので、"}, {"type": "subtitle", "time": 15439.83, "timestamp": "04:17:19", "text": "自分を晒したくなかったから"}, {"type": "subtitle", "time": 15451.11, "timestamp": "04:17:31", "text": "えっと、メッセージを送ってこう言えばいいかな"}, {"type": "subtitle", "time": 15462.63, "timestamp": "04:17:42", "text": "そして彼らはこう言うだろう、この男はただ"}, {"type": "subtitle", "time": 15468.469, "timestamp": "04:17:48", "text": "文字通り、えっと、わからない"}, {"type": "subtitle", "time": 15473.59, "timestamp": "04:17:53", "text": "時間を無駄にした。彼らは言った"}, {"type": "subtitle", "time": 15475.51, "timestamp": "04:17:55", "text": "彼らは明日の予定があったため急いでいた"}]
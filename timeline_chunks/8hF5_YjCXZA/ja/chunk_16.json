[{"type": "subtitle", "time": 961.99, "timestamp": "00:16:01", "text": "継続的に。いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、"}, {"type": "subtitle", "time": 963.91, "timestamp": "00:16:03", "text": "そうじゃない。"}, {"type": "subtitle", "time": 967.749, "timestamp": "00:16:07", "text": "つまり、あの、"}, {"type": "subtitle", "time": 970.629, "timestamp": "00:16:10", "text": "ほら、実際に自分を宣伝して"}, {"type": "subtitle", "time": 973.189, "timestamp": "00:16:13", "text": "クリップやその他すべて"}, {"type": "subtitle", "time": 976.15, "timestamp": "00:16:16", "text": "これらの寄付金から、"}, {"type": "subtitle", "time": 983.43, "timestamp": "00:16:23", "text": "そして、ええと、あらゆることをやっています。私たちはやらなければならない"}, {"type": "subtitle", "time": 985.59, "timestamp": "00:16:25", "text": "今、それが実現する。"}, {"type": "subtitle", "time": 989.59, "timestamp": "00:16:29", "text": "だから、私たちはそれをやらなければならない。そうします。"}, {"type": "subtitle", "time": 991.59, "timestamp": "00:16:31", "text": "うん。"}, {"type": "subtitle", "time": 993.189, "timestamp": "00:16:33", "text": "昨日私は、"}, {"type": "subtitle", "time": 996.949, "timestamp": "00:16:36", "text": "イベントを宣伝するためのビデオを録画する"}, {"type": "subtitle", "time": 999.829, "timestamp": "00:16:39", "text": "しかし、私たちはすでにジョカソンを開始したので"}, {"type": "subtitle", "time": 1003.67, "timestamp": "00:16:43", "text": "まあいいと思うけど、どうしようもないよね"}, {"type": "subtitle", "time": 1007.67, "timestamp": "00:16:47", "text": "ジョアソンの件で、ソーシャルな感じ"}, {"type": "subtitle", "time": 1010.31, "timestamp": "00:16:50", "text": "メディアプロモーションの権利があり、私は"}, {"type": "subtitle", "time": 1013.67, "timestamp": "00:16:53", "text": "えっと、これはまだ言えることです"}, {"type": "subtitle", "time": 1018.55, "timestamp": "00:16:58", "text": "進行中、私たちは正しく開始しました"}]
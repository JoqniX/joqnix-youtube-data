[{"type": "subtitle", "time": 20645.35, "timestamp": "05:44:05", "text": "多くのことを変えることができる。言えることは"}, {"type": "subtitle", "time": 20648.31, "timestamp": "05:44:08", "text": "カットローのものがたくさんあるし、"}, {"type": "subtitle", "time": 20650.39, "timestamp": "05:44:10", "text": "ゲートも凍結する。あ、待って。あなたはしない"}, {"type": "subtitle", "time": 20652.47, "timestamp": "05:44:12", "text": "これ、見えますか？私が言いたいこと、分かりますか？あ、待って。"}, {"type": "subtitle", "time": 20655.43, "timestamp": "05:44:15", "text": "え、これ見えないの？わかった。えっと、"}, {"type": "subtitle", "time": 20657.67, "timestamp": "05:44:17", "text": "このキャプチャ。わかった。見て、見て、見て、見て"}, {"type": "subtitle", "time": 20667.35, "timestamp": "05:44:27", "text": "とても美味しいです。わかった。待って。うっかり"}, {"type": "subtitle", "time": 20693.35, "timestamp": "05:44:53", "text": "でもすごくクールだよ"}, {"type": "subtitle", "time": 20695.35, "timestamp": "05:44:55", "text": "そして右クリックで削除できます。"}]
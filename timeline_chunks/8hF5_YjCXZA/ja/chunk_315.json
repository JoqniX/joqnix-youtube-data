[{"type": "subtitle", "time": 18901.51, "timestamp": "05:15:01", "text": "そして問題は、太陽が"}, {"type": "subtitle", "time": 18903.03, "timestamp": "05:15:03", "text": "のように"}, {"type": "subtitle", "time": 18905.59, "timestamp": "05:15:05", "text": "うん、342.8 80。待って、待って、待って。いいえ、"}, {"type": "subtitle", "time": 18908.15, "timestamp": "05:15:08", "text": "それが残っている部分です。わかった。私は31ドル支払いました。それで、"}, {"type": "subtitle", "time": 18911.59, "timestamp": "05:15:11", "text": "367なんとかです。"}, {"type": "subtitle", "time": 18913.99, "timestamp": "05:15:13", "text": "私は教育免許を取得しました。いいえ、だから"}, {"type": "subtitle", "time": 18917.59, "timestamp": "05:15:17", "text": "30%オフ。いいえ、30% から 30,000 を引いた値です。"}, {"type": "subtitle", "time": 18924.23, "timestamp": "05:15:24", "text": "つまり、通常のレートは64ドル649ドルです。"}, {"type": "subtitle", "time": 18926.07, "timestamp": "05:15:26", "text": "しかし教育免許のため、"}, {"type": "subtitle", "time": 18930.47, "timestamp": "05:15:30", "text": "369ドルちょっとで手に入れました。"}, {"type": "subtitle", "time": 18933.51, "timestamp": "05:15:33", "text": "えっと、30歳"}, {"type": "subtitle", "time": 18937.43, "timestamp": "05:15:37", "text": "うん、個人差とかそういうことかな。"}, {"type": "subtitle", "time": 18939.75, "timestamp": "05:15:39", "text": "とにかくこんにちは"}, {"type": "subtitle", "time": 18943.91, "timestamp": "05:15:43", "text": "後で。はい。保存できません"}, {"type": "subtitle", "time": 18946.708, "timestamp": "05:15:46", "text": "し"}]
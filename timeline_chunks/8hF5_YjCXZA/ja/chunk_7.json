[{"type": "subtitle", "time": 420.07, "timestamp": "00:07:00", "text": "父が蚊帳を持ってきてくれる"}, {"type": "subtitle", "time": 422.95, "timestamp": "00:07:02", "text": "あれ。窓に貼ることができます"}, {"type": "subtitle", "time": 426.23, "timestamp": "00:07:06", "text": "これらのハエやあらゆる種類の"}, {"type": "subtitle", "time": 430.79, "timestamp": "00:07:10", "text": "変な虫が左から入ってきて"}, {"type": "subtitle", "time": 433.83, "timestamp": "00:07:13", "text": "右。それは一種の痛みで、"}, {"type": "subtitle", "time": 438.95, "timestamp": "00:07:18", "text": "しかし、それが現実だ。しかしそれでも、"}, {"type": "subtitle", "time": 441.43, "timestamp": "00:07:21", "text": "装飾のために最善を尽くす必要がある"}, {"type": "subtitle", "time": 444.23, "timestamp": "00:07:24", "text": "アイテムも全て。"}, {"type": "subtitle", "time": 469.35, "timestamp": "00:07:49", "text": "ああ、何がそうじゃなかったの？あ、待って。どうでも。"}, {"type": "subtitle", "time": 476.469, "timestamp": "00:07:56", "text": "何てことだ。私は一体何を言っているんだ？しないで"}, {"type": "subtitle", "time": 478.869, "timestamp": "00:07:58", "text": "気にしないで。"}]
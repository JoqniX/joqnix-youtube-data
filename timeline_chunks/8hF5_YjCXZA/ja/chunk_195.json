[{"type": "subtitle", "time": 11703.91, "timestamp": "03:15:03", "text": "私の持ち物のために。意味"}, {"type": "subtitle", "time": 11707.75, "timestamp": "03:15:07", "text": "つまり、髪のための薬みたいなもの。"}, {"type": "subtitle", "time": 11709.91, "timestamp": "03:15:09", "text": "ああ、言い忘れたけど、"}, {"type": "subtitle", "time": 11714.71, "timestamp": "03:15:14", "text": "聴いてるよ、えっと、髪を切ってみたんだ"}, {"type": "subtitle", "time": 11716.229, "timestamp": "03:15:16", "text": "フケの問題と"}, {"type": "subtitle", "time": 11719.75, "timestamp": "03:15:19", "text": "すべて。そして、なんと！まるで"}, {"type": "subtitle", "time": 11722.79, "timestamp": "03:15:22", "text": "深刻な種類のもの。そして最後に、"}, {"type": "subtitle", "time": 11727.11, "timestamp": "03:15:27", "text": "ああ、神様。うん。おお。引きずることはできません。私"}, {"type": "subtitle", "time": 11732.55, "timestamp": "03:15:32", "text": "引きずることができません。私は引きずることができません。"}, {"type": "subtitle", "time": 11735.91, "timestamp": "03:15:35", "text": "おお。おお。"}, {"type": "subtitle", "time": 11738.63, "timestamp": "03:15:38", "text": "お願いします。おお。おお。"}, {"type": "subtitle", "time": 11741.83, "timestamp": "03:15:41", "text": "ああ、忘れてた。なぜ私はこのゲームをプレイしたのか？"}, {"type": "subtitle", "time": 11744.55, "timestamp": "03:15:44", "text": "引きずることはできません。"}, {"type": "subtitle", "time": 11753.75, "timestamp": "03:15:53", "text": "ああ、時々はうまくいくよ。うまくいかない"}, {"type": "subtitle", "time": 11755.03, "timestamp": "03:15:55", "text": "時々。"}]
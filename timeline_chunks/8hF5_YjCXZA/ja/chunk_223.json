[{"type": "subtitle", "time": 13413.51, "timestamp": "03:43:33", "text": "彼らが私に与えた手術は正しい"}, {"type": "subtitle", "time": 13415.03, "timestamp": "03:43:35", "text": "正しい抽出で最大金額"}, {"type": "subtitle", "time": 13417.75, "timestamp": "03:43:37", "text": "少なくともそこには"}, {"type": "subtitle", "time": 13425.59, "timestamp": "03:43:45", "text": "私と妻は大金を失った"}, {"type": "subtitle", "time": 13427.429, "timestamp": "03:43:47", "text": "作業が完了していない。チームからの応答がない。"}, {"type": "subtitle", "time": 13429.59, "timestamp": "03:43:49", "text": "お金を受け取った後、私は非難された"}, {"type": "subtitle", "time": 13432.79, "timestamp": "03:43:52", "text": "もしあなたが、"}, {"type": "subtitle", "time": 13435.67, "timestamp": "03:43:55", "text": "ああ、私はたくさんの悪い記事を読んでいる"}, {"type": "subtitle", "time": 13438.79, "timestamp": "03:43:58", "text": "彼らについて"}]
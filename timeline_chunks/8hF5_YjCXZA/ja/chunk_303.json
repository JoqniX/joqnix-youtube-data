[{"type": "subtitle", "time": 18182.788, "timestamp": "05:03:02", "text": "問題は、私が何も知らないからです"}, {"type": "subtitle", "time": 18185.99, "timestamp": "05:03:05", "text": "ビジネスや法律に関することについて。"}, {"type": "subtitle", "time": 18189.67, "timestamp": "05:03:09", "text": "私はとても傷つきやすいと感じています"}, {"type": "subtitle", "time": 18194.23, "timestamp": "05:03:14", "text": "私をできる限り利用してください"}, {"type": "subtitle", "time": 18198.39, "timestamp": "05:03:18", "text": "だって、私は物事を正しく理解していないから。"}, {"type": "subtitle", "time": 18206.15, "timestamp": "05:03:26", "text": "それで"}, {"type": "subtitle", "time": 18208.47, "timestamp": "05:03:28", "text": "彼女が色を誘拐できないと確信しているなら"}]
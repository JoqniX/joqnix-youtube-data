[{"type": "subtitle", "time": 4740.07, "timestamp": "01:19:00", "text": "そうそう。私はあまり歌を歌っていません"}, {"type": "subtitle", "time": 4742.95, "timestamp": "01:19:02", "text": "ストリーム。いいえ。"}, {"type": "subtitle", "time": 4767.99, "timestamp": "01:19:27", "text": "待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 4770.39, "timestamp": "01:19:30", "text": "待って、待って、待って。私は自分の"}, {"type": "subtitle", "time": 4773.11, "timestamp": "01:19:33", "text": "そのためのウィジェットを購入しました。待って、待って、"}, {"type": "subtitle", "time": 4775.669, "timestamp": "01:19:35", "text": "待って、待って、待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 4777.27, "timestamp": "01:19:37", "text": "待って。待って、待って、待って、待って"}, {"type": "subtitle", "time": 4779.11, "timestamp": "01:19:39", "text": "ちょっと待って、みんな。ちょっと待って、ちょっと待って、"}, {"type": "subtitle", "time": 4781.189, "timestamp": "01:19:41", "text": "ちょっと待って。他のものをアップロードさせてください"}, {"type": "subtitle", "time": 4784.39, "timestamp": "01:19:44", "text": "カード。 1秒。"}, {"type": "subtitle", "time": 4787.11, "timestamp": "01:19:47", "text": "えっと、"}, {"type": "subtitle", "time": 4790.63, "timestamp": "01:19:50", "text": "来て。来て。アップロード。わかった。提出する。"}, {"type": "subtitle", "time": 4793.34, "timestamp": "01:19:53", "text": "理解した。提出する。"}, {"type": "subtitle", "time": 4795.51, "timestamp": "01:19:55", "text": "[音楽]"}, {"type": "subtitle", "time": 4799.51, "timestamp": "01:19:59", "text": "忘れた。あぁ、これ忘れてた。それで、"}]
[{"type": "subtitle", "time": 5941.109, "timestamp": "01:39:01", "text": "普通の会話みたいな感じだよね？一般的な"}, {"type": "subtitle", "time": 5943.27, "timestamp": "01:39:03", "text": "何かを買うとき、どのように"}, {"type": "subtitle", "time": 5945.35, "timestamp": "01:39:05", "text": "価格やその他諸々がほぼ同じです。"}, {"type": "subtitle", "time": 5949.51, "timestamp": "01:39:09", "text": "そんな単純な会話。"}, {"type": "subtitle", "time": 5951.91, "timestamp": "01:39:11", "text": "ああ、やればやるほど"}, {"type": "subtitle", "time": 5955.669, "timestamp": "01:39:15", "text": "どう反応すればいいか、どう対処すればいいか、"}, {"type": "subtitle", "time": 5959.59, "timestamp": "01:39:19", "text": "いろいろなことを言ったり、そういうことを全部言ったりする。"}, {"type": "subtitle", "time": 5964.55, "timestamp": "01:39:24", "text": "つまり、一番大切なのは勇敢な信念です"}, {"type": "subtitle", "time": 5967.83, "timestamp": "01:39:27", "text": "君ならできるし、必ずやるよ"}, {"type": "subtitle", "time": 5969.35, "timestamp": "01:39:29", "text": "そして"}, {"type": "subtitle", "time": 5972.79, "timestamp": "01:39:32", "text": "怖がらないで"}, {"type": "subtitle", "time": 5976.149, "timestamp": "01:39:36", "text": "行動を起こす。それが一番重要な点です。"}, {"type": "subtitle", "time": 5979.91, "timestamp": "01:39:39", "text": "コミュニケーションに関しては、ええと"}, {"type": "subtitle", "time": 5983.75, "timestamp": "01:39:43", "text": "小さな目標を書き出す"}, {"type": "subtitle", "time": 5986.87, "timestamp": "01:39:46", "text": "両親と話したり、ペットと話したり、"}, {"type": "subtitle", "time": 5989.83, "timestamp": "01:39:49", "text": "何か、カシンか誰かに話しかけて"}, {"type": "subtitle", "time": 5993.51, "timestamp": "01:39:53", "text": "誰かが、より大きな目標を達成する"}, {"type": "subtitle", "time": 5996.87, "timestamp": "01:39:56", "text": "大きな公の場でのスピーチのように話す"}, {"type": "subtitle", "time": 5998.79, "timestamp": "01:39:58", "text": "あるいは何か、あるいは大きな人のようなもの、あるいは"}]
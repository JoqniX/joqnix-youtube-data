[{"type": "subtitle", "time": 7682.55, "timestamp": "02:08:02", "text": "私はしなければならない"}, {"type": "subtitle", "time": 7683.91, "timestamp": "02:08:03", "text": "[音楽]"}, {"type": "subtitle", "time": 7687.109, "timestamp": "02:08:07", "text": "東洋のために人種差別をする。人種差別がある"}, {"type": "subtitle", "time": 7721.99, "timestamp": "02:08:41", "text": "私が知っているのは、誰に対しても平等に接するということだけだ。"}, {"type": "subtitle", "time": 7724.069, "timestamp": "02:08:44", "text": "人種、肌の色、"}, {"type": "subtitle", "time": 7727.27, "timestamp": "02:08:47", "text": "彼らがどの地域出身であろうと"}]
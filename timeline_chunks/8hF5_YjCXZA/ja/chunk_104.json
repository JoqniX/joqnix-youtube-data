[{"type": "subtitle", "time": 6240.629, "timestamp": "01:44:00", "text": "だって私は勉強しないから。ただただ"}, {"type": "subtitle", "time": 6244.47, "timestamp": "01:44:04", "text": "勉強せずに書く"}, {"type": "subtitle", "time": 6250.39, "timestamp": "01:44:10", "text": "ダミは目を覚まし、配信を横取りした。の"}, {"type": "subtitle", "time": 6252.07, "timestamp": "01:44:12", "text": "もちろん、停電は発生した。それは"}, {"type": "subtitle", "time": 6254.629, "timestamp": "01:44:14", "text": "なぜ彼ら二人は、それが私が"}, {"type": "subtitle", "time": 6257.59, "timestamp": "01:44:17", "text": "2回目の配信をやり直さなければならなかった。参加します"}, {"type": "subtitle", "time": 6268.709, "timestamp": "01:44:28", "text": "取締役会レベルの話かどうかは別として。"}, {"type": "subtitle", "time": 6275.75, "timestamp": "01:44:35", "text": "わかった。えーと、好きなキャラクターは"}, {"type": "subtitle", "time": 6283.91, "timestamp": "01:44:43", "text": "えっと、0ero2でいいですか？"}, {"type": "subtitle", "time": 6286.149, "timestamp": "01:44:46", "text": "私の愛しいフランス人は私の最初の"}, {"type": "subtitle", "time": 6289.99, "timestamp": "01:44:49", "text": "アニメ。私はおそらくプロだと思います"}, {"type": "subtitle", "time": 6292.229, "timestamp": "01:44:52", "text": "海賊版アニメを正しく視聴する"}, {"type": "subtitle", "time": 6297.189, "timestamp": "01:44:57", "text": "いつ"}]
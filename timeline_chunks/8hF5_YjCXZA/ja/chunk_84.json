[{"type": "subtitle", "time": 5046.31, "timestamp": "01:24:06", "text": "いいえ、彼らは私に"}, {"type": "subtitle", "time": 5053.43, "timestamp": "01:24:13", "text": "このことを変えるために批判することはできません"}, {"type": "subtitle", "time": 5054.95, "timestamp": "01:24:14", "text": "接触。"}, {"type": "subtitle", "time": 5056.47, "timestamp": "01:24:16", "text": "クリエイターがビジネスを変える"}, {"type": "subtitle", "time": 5060.47, "timestamp": "01:24:20", "text": "顧客に連絡するだけの名称。"}, {"type": "subtitle", "time": 5063.189, "timestamp": "01:24:23", "text": "えっと、設定を確認してみてください。スタイルをチェックしてみてください。"}, {"type": "subtitle", "time": 5065.59, "timestamp": "01:24:25", "text": "わかった。わかった。消しゴムは左側のアカウントに支払い、"}, {"type": "subtitle", "time": 5067.189, "timestamp": "01:24:27", "text": "設定。設定を確認してください。チェックアウト"}, {"type": "subtitle", "time": 5069.11, "timestamp": "01:24:29", "text": "スタイリング。わかった。わかった。それでは、また戻ってきます"}, {"type": "subtitle", "time": 5071.51, "timestamp": "01:24:31", "text": "もう少ししたら。 1秒。えっと、アカウント"}, {"type": "subtitle", "time": 5073.27, "timestamp": "01:24:33", "text": "設定。"}, {"type": "subtitle", "time": 5075.43, "timestamp": "01:24:35", "text": "えっと、チェックアウト、チェックアウト、チェックアウト、チェック"}, {"type": "subtitle", "time": 5079.669, "timestamp": "01:24:39", "text": "チェックアウト、チェックアウト、スタイリングをチェックしてください。わかった。"}]
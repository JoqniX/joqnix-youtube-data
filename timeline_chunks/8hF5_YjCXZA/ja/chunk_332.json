[{"type": "subtitle", "time": 19927.03, "timestamp": "05:32:07", "text": "もしそう聞こえるなら、"}, {"type": "subtitle", "time": 19929.67, "timestamp": "05:32:09", "text": "ドラムセットを準備する必要がある。そうします"}, {"type": "subtitle", "time": 19932.628, "timestamp": "05:32:12", "text": "それは後ほど。しかし、"}, {"type": "subtitle", "time": 19936.548, "timestamp": "05:32:16", "text": "えーと、速度のやつ、"}, {"type": "subtitle", "time": 19942.868, "timestamp": "05:32:22", "text": "真ん中の人なら、"}, {"type": "subtitle", "time": 19951.91, "timestamp": "05:32:31", "text": "[音楽]"}, {"type": "subtitle", "time": 19953.99, "timestamp": "05:32:33", "text": "これが良い音に聞こえるかどうかわかりませんが、"}, {"type": "subtitle", "time": 19974.15, "timestamp": "05:32:54", "text": "音量パンニングをさらに強化する。私は"}, {"type": "subtitle", "time": 19977.03, "timestamp": "05:32:57", "text": "それに合わせてパンニングする。何百万もの"}]
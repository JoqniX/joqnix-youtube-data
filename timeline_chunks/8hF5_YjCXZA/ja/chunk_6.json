[{"type": "subtitle", "time": 360.71, "timestamp": "00:06:00", "text": "私が唯一望まないもの。だから、私は"}, {"type": "subtitle", "time": 363.59, "timestamp": "00:06:03", "text": "蓋か何かでたくさん保管する"}, {"type": "subtitle", "time": 365.749, "timestamp": "00:06:05", "text": "あるいは、そんな感じ。でも私は心配しています"}, {"type": "subtitle", "time": 369.27, "timestamp": "00:06:09", "text": "空気の通り道とか、そういうやつだよ。"}, {"type": "subtitle", "time": 371.51, "timestamp": "00:06:11", "text": "まあ、どうなるか見てみましょう。主に、"}, {"type": "subtitle", "time": 373.59, "timestamp": "00:06:13", "text": "いくつか必要なものがある"}, {"type": "subtitle", "time": 377.99, "timestamp": "00:06:17", "text": "この水槽の装飾品を"}, {"type": "subtitle", "time": 380.15, "timestamp": "00:06:20", "text": "配信とかで自慢しちゃおうよ。"}, {"type": "subtitle", "time": 382.15, "timestamp": "00:06:22", "text": "今は自慢しているところだけど"}, {"type": "subtitle", "time": 384.95, "timestamp": "00:06:24", "text": "それでも私は"}, {"type": "subtitle", "time": 387.189, "timestamp": "00:06:27", "text": "本当に飾り付けをしないといけない"}, {"type": "subtitle", "time": 390.79, "timestamp": "00:06:30", "text": "計画や石など、"}, {"type": "subtitle", "time": 395.11, "timestamp": "00:06:35", "text": "見た目も綺麗だし、何も問題ない。いいえ、"}, {"type": "subtitle", "time": 398.23, "timestamp": "00:06:38", "text": "それを買うために買い物に行かなければならない。"}, {"type": "subtitle", "time": 401.67, "timestamp": "00:06:41", "text": "そうする可能性が高いでしょう。"}, {"type": "subtitle", "time": 403.67, "timestamp": "00:06:43", "text": "うん、"}, {"type": "subtitle", "time": 417.11, "timestamp": "00:06:57", "text": "ええ、主に私は必要ないです。私は言いました"}]
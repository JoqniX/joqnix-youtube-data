[{"type": "subtitle", "time": 1206.549, "timestamp": "00:20:06", "text": "右？"}, {"type": "subtitle", "time": 1210.31, "timestamp": "00:20:10", "text": "うん。そう、時間は関係ない"}, {"type": "subtitle", "time": 1212.789, "timestamp": "00:20:12", "text": "実は。ただ"}, {"type": "subtitle", "time": 1216.789, "timestamp": "00:20:16", "text": "それはただそこにあるだけです。気にしないでください。"}, {"type": "subtitle", "time": 1218.87, "timestamp": "00:20:18", "text": "正直に言うと、私は文字通り"}, {"type": "subtitle", "time": 1223.19, "timestamp": "00:20:23", "text": "4か月分くらいの時間"}, {"type": "subtitle", "time": 1225.19, "timestamp": "00:20:25", "text": "時間ですよね？"}, {"type": "subtitle", "time": 1238.71, "timestamp": "00:20:38", "text": "待って。えっと、"}, {"type": "subtitle", "time": 1241.75, "timestamp": "00:20:41", "text": "3月12日から"}, {"type": "subtitle", "time": 1243.43, "timestamp": "00:20:43", "text": "6月。"}, {"type": "subtitle", "time": 1247.11, "timestamp": "00:20:47", "text": "何時間ですか？では、私が取りましょう。"}, {"type": "subtitle", "time": 1251.75, "timestamp": "00:20:51", "text": "1,9444時間"}]
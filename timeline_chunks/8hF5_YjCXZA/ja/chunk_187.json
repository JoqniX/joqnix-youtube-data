[{"type": "subtitle", "time": 11220.23, "timestamp": "03:07:00", "text": "危うく怖くなるところだった。"}, {"type": "subtitle", "time": 11223.269, "timestamp": "03:07:03", "text": "ああ、危うく怖くなるところだった。私は思った"}, {"type": "subtitle", "time": 11225.03, "timestamp": "03:07:05", "text": "私は彼に自分の顔を見せたか何かした。私は"}, {"type": "subtitle", "time": 11228.23, "timestamp": "03:07:08", "text": "えっと、一瞬目を閉じたんです。私"}, {"type": "subtitle", "time": 11231.83, "timestamp": "03:07:11", "text": "「ああ、なんてことだ、"}, {"type": "subtitle", "time": 11234.07, "timestamp": "03:07:14", "text": "その時が来た。"}, {"type": "subtitle", "time": 11236.469, "timestamp": "03:07:16", "text": "走らなければならない。"}, {"type": "subtitle", "time": 11239.83, "timestamp": "03:07:19", "text": "ええと、それらは良いはずですよね？私"}, {"type": "subtitle", "time": 11244.309, "timestamp": "03:07:24", "text": "これは広角レンズです。"}, {"type": "subtitle", "time": 11246.63, "timestamp": "03:07:26", "text": "ちなみに、電話しか置けません"}, {"type": "subtitle", "time": 11250.309, "timestamp": "03:07:30", "text": "えっと、これしか置けないんだけど、えっと"}, {"type": "subtitle", "time": 11253.51, "timestamp": "03:07:33", "text": "カメラを少しの間だけ使うのは、"}, {"type": "subtitle", "time": 11256.95, "timestamp": "03:07:36", "text": "電話のバッテリーが今にも切れそうだ"}, {"type": "subtitle", "time": 11260.71, "timestamp": "03:07:40", "text": "今。まあ、そういうことだ。中に入ることができません"}, {"type": "subtitle", "time": 11261.97, "timestamp": "03:07:41", "text": "今。"}, {"type": "subtitle", "time": 11271.99, "timestamp": "03:07:51", "text": "犬がそれを"}, {"type": "subtitle", "time": 11274.23, "timestamp": "03:07:54", "text": "秘密。今度はエビを切って"}]
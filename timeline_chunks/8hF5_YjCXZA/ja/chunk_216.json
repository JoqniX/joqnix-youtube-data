[{"type": "subtitle", "time": 12966.389, "timestamp": "03:36:06", "text": "ただこの男だけだ。このベイビーバカ、"}, {"type": "subtitle", "time": 12970.35, "timestamp": "03:36:10", "text": "彼をどうすべきか、私には分かっている。"}, {"type": "subtitle", "time": 12973.75, "timestamp": "03:36:13", "text": "[音楽]"}, {"type": "subtitle", "time": 12977.37, "timestamp": "03:36:17", "text": "私は何をしているのだろうか"}, {"type": "subtitle", "time": 12983.91, "timestamp": "03:36:23", "text": "[音楽]"}, {"type": "subtitle", "time": 12986.64, "timestamp": "03:36:26", "text": "ああ、私ならできる。"}, {"type": "subtitle", "time": 12989.03, "timestamp": "03:36:29", "text": "[音楽]"}, {"type": "subtitle", "time": 12991.1, "timestamp": "03:36:31", "text": "片面はこれで終わりです。"}, {"type": "subtitle", "time": 13011.91, "timestamp": "03:36:51", "text": "これはどうでしょう？この部分。"}, {"type": "subtitle", "time": 13015.429, "timestamp": "03:36:55", "text": "しかし、それはうまくいかないだろう。"}, {"type": "subtitle", "time": 13017.83, "timestamp": "03:36:57", "text": "あなたが知っている"}]
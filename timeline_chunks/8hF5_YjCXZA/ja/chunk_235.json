[{"type": "subtitle", "time": 14101.189, "timestamp": "03:55:01", "text": "でも、あなたが言っていることは"}, {"type": "subtitle", "time": 14104.07, "timestamp": "03:55:04", "text": "おかげでストレスが軽減された。それは"}, {"type": "subtitle", "time": 14106.71, "timestamp": "03:55:06", "text": "もの。"}, {"type": "subtitle", "time": 14108.55, "timestamp": "03:55:08", "text": "あなたが知っている、"}, {"type": "subtitle", "time": 14129.429, "timestamp": "03:55:29", "text": "うん。うん。それが私たちが話し合ったことです"}, {"type": "subtitle", "time": 14131.83, "timestamp": "03:55:31", "text": "今すぐ。私もあなたと同じように理解しています"}, {"type": "subtitle", "time": 14134.07, "timestamp": "03:55:34", "text": "すべてを相互チェックした後、"}]
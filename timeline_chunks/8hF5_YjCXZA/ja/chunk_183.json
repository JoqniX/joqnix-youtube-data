[{"type": "subtitle", "time": 10981.11, "timestamp": "03:03:01", "text": "[音楽]"}, {"type": "subtitle", "time": 10984.55, "timestamp": "03:03:04", "text": "それで、スカイアタンクみたいなのを買ったんだけど"}, {"type": "subtitle", "time": 10986.389, "timestamp": "03:03:06", "text": "あれ。"}, {"type": "subtitle", "time": 10988.63, "timestamp": "03:03:08", "text": "そうそう。"}, {"type": "subtitle", "time": 10992.15, "timestamp": "03:03:12", "text": "彼だ。そしてそれが私が食べた食べ物です"}, {"type": "subtitle", "time": 10995.75, "timestamp": "03:03:15", "text": "彼にその小さな魚を5匹あげた"}, {"type": "subtitle", "time": 10999.349, "timestamp": "03:03:19", "text": "あれ。 5人。小さなピースが5つ。"}, {"type": "subtitle", "time": 11002.87, "timestamp": "03:03:22", "text": "五。うん。五。ええと、小さいです。ええ、小さいです"}, {"type": "subtitle", "time": 11005.349, "timestamp": "03:03:25", "text": "朝に作品を見る。それから私は彼に"}, {"type": "subtitle", "time": 11008.71, "timestamp": "03:03:28", "text": "フィルターはどこにあるの？フィルターは一切ありません。"}, {"type": "subtitle", "time": 11011.83, "timestamp": "03:03:31", "text": "私には、ある種の葉っぱのようなものが必要です。"}, {"type": "subtitle", "time": 11013.83, "timestamp": "03:03:33", "text": "乾燥した葉。私がそれを置けば、"}, {"type": "subtitle", "time": 11017.75, "timestamp": "03:03:37", "text": "カビとかそういう類。私はそれをしなければならない"}, {"type": "subtitle", "time": 11019.75, "timestamp": "03:03:39", "text": "カビなどを除去するため。私は必要とする"}, {"type": "subtitle", "time": 11023.11, "timestamp": "03:03:43", "text": "ある木の葉を手に入れる。忘れた"}, {"type": "subtitle", "time": 11025.67, "timestamp": "03:03:45", "text": "それは何の木ですか、でも、そうですね、私は"}, {"type": "subtitle", "time": 11027.59, "timestamp": "03:03:47", "text": "それと"}, {"type": "subtitle", "time": 11031.429, "timestamp": "03:03:51", "text": "それを早く手に入れよう。"}, {"type": "subtitle", "time": 11033.99, "timestamp": "03:03:53", "text": "彼らはそれを充電した。"}, {"type": "subtitle", "time": 11036.63, "timestamp": "03:03:56", "text": "そもそも充電できるのでしょうか？私はしません"}]
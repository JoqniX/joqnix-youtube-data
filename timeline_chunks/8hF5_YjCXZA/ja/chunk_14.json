[{"type": "subtitle", "time": 843.269, "timestamp": "00:14:03", "text": "えっと、さっき停電があったので"}, {"type": "subtitle", "time": 845.67, "timestamp": "00:14:05", "text": "なぜ私たちは弦を切ってしまったのか"}, {"type": "subtitle", "time": 849.75, "timestamp": "00:14:09", "text": "オフにして、Valerantもインストールしました。私 私"}, {"type": "subtitle", "time": 851.59, "timestamp": "00:14:11", "text": "valをダウンロードしてインストールしました。それが理由です"}, {"type": "subtitle", "time": 855.189, "timestamp": "00:14:15", "text": "今日は少し出勤が遅れました。しかし"}, {"type": "subtitle", "time": 857.11, "timestamp": "00:14:17", "text": "大丈夫です。"}, {"type": "subtitle", "time": 863.99, "timestamp": "00:14:23", "text": "気のせいかな、それとも私、咳が多すぎるのかな？"}, {"type": "subtitle", "time": 871.509, "timestamp": "00:14:31", "text": "シロップを1カップくらい欲しいんだけど"}, {"type": "subtitle", "time": 882.47, "timestamp": "00:14:42", "text": "ところで、皆さんお元気ですか？調子はどうですか？"}, {"type": "subtitle", "time": 885.509, "timestamp": "00:14:45", "text": "みんなやってる？"}, {"type": "subtitle", "time": 895.99, "timestamp": "00:14:55", "text": "私は主張する"}]
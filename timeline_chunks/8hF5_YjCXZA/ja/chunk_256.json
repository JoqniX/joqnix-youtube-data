[{"type": "subtitle", "time": 15374.07, "timestamp": "04:16:14", "text": "ありがとう。"}, {"type": "subtitle", "time": 15381.67, "timestamp": "04:16:21", "text": "えっと、あなたはバカですか？待って、待って、待って。"}, {"type": "subtitle", "time": 15384.55, "timestamp": "04:16:24", "text": "なぜ？"}, {"type": "subtitle", "time": 15388.309, "timestamp": "04:16:28", "text": "つまり、税金に関しては16から始めるということです。いいえ、私は"}, {"type": "subtitle", "time": 15397.429, "timestamp": "04:16:37", "text": "ほら、これって3000個みたいな数じゃないでしょ。これらは"}, {"type": "subtitle", "time": 15400.63, "timestamp": "04:16:40", "text": "とても高価です。"}, {"type": "subtitle", "time": 15403.75, "timestamp": "04:16:43", "text": "彼は文字通り、2000は何でもないと言った。"}, {"type": "subtitle", "time": 15407.189, "timestamp": "04:16:47", "text": "いいえ。つまり、どうして2000が"}, {"type": "subtitle", "time": 15419.99, "timestamp": "04:16:59", "text": "彼が"}]
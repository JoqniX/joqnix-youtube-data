[{"type": "subtitle", "time": 9720.15, "timestamp": "02:42:00", "text": "今日はシャワーを浴びたい気分だ。私は必要としている"}, {"type": "subtitle", "time": 9723.67, "timestamp": "02:42:03", "text": "夜に風呂に入った。昨日はそうしなかった"}, {"type": "subtitle", "time": 9726.07, "timestamp": "02:42:06", "text": "シャワーを浴びて頭を洗う"}, {"type": "subtitle", "time": 9749.03, "timestamp": "02:42:29", "text": "昨日。私たちはどんなことをしたの？私"}]
[{"type": "subtitle", "time": 8822.79, "timestamp": "02:27:02", "text": "[音楽]"}, {"type": "subtitle", "time": 8831.11, "timestamp": "02:27:11", "text": "なんて素晴らしいのでしょう。見つけたら教えてください"}, {"type": "subtitle", "time": 8833.67, "timestamp": "02:27:13", "text": "興味深いものなら何でも。人々は"}, {"type": "subtitle", "time": 8836.389, "timestamp": "02:27:16", "text": "アーティファクトはかなり頻繁に"}, {"type": "subtitle", "time": 8839.75, "timestamp": "02:27:19", "text": "終わり。ボールは蜂が飛び乗るのを見ている"}, {"type": "subtitle", "time": 8842.309, "timestamp": "02:27:22", "text": "川。それが私の考えです。私は確信しています"}, {"type": "subtitle", "time": 8846.72, "timestamp": "02:27:26", "text": "釣りをしていると見つかるでしょう。ありがとう。"}, {"type": "subtitle", "time": 8868.55, "timestamp": "02:27:48", "text": "どうやって降りるか？えっと、"}]
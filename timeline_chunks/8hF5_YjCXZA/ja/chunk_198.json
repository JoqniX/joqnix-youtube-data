[{"type": "subtitle", "time": 11881.4, "timestamp": "03:18:01", "text": "私は何をしているの？"}, {"type": "subtitle", "time": 11900.229, "timestamp": "03:18:20", "text": "やっと分かりました。どうやって？分かりません。でも私は"}, {"type": "subtitle", "time": 11904.79, "timestamp": "03:18:24", "text": "わかった。何てことだ。わかった。"}, {"type": "subtitle", "time": 11909.11, "timestamp": "03:18:29", "text": "おお。一体どうやって手に入れたんだろう？マグロ。おお、"}, {"type": "subtitle", "time": 11913.91, "timestamp": "03:18:33", "text": "見て。新しい猫を見つけましたね。マグロです。"}, {"type": "subtitle", "time": 11923.349, "timestamp": "03:18:43", "text": "あ、待って。モバイルを一時停止できますか？"}, {"type": "subtitle", "time": 11924.95, "timestamp": "03:18:44", "text": "ストリーム？"}, {"type": "subtitle", "time": 11928.469, "timestamp": "03:18:48", "text": "待って、待って、待って、待って。"}, {"type": "subtitle", "time": 11931.44, "timestamp": "03:18:51", "text": "DMは開いたままにしておきます。わかった。"}, {"type": "subtitle", "time": 11933.429, "timestamp": "03:18:53", "text": "[音楽]"}, {"type": "subtitle", "time": 11936.63, "timestamp": "03:18:56", "text": "そして私は"}, {"type": "subtitle", "time": 11938.63, "timestamp": "03:18:58", "text": "置く"}]
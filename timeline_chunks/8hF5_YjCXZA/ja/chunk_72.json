[{"type": "subtitle", "time": 4332.47, "timestamp": "01:12:12", "text": "そしてストリーマー。"}, {"type": "subtitle", "time": 4351.27, "timestamp": "01:12:31", "text": "ああ、わかりました。わかった。わかった。ごめん。ごめん。私"}, {"type": "subtitle", "time": 4353.59, "timestamp": "01:12:33", "text": "忘れた。えっと、"}, {"type": "subtitle", "time": 4357.27, "timestamp": "01:12:37", "text": "私はバカだ。ああ、神様。俺はバカだよ、兄弟。"}, {"type": "subtitle", "time": 4366.229, "timestamp": "01:12:46", "text": "私はなんてバカなんだろう。私はなんてバカなんだろう。"}]
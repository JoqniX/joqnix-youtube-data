[{"type": "subtitle", "time": 7440.709, "timestamp": "02:04:00", "text": "三つの角を持つ土地がやってくる。あなた"}, {"type": "subtitle", "time": 7443.669, "timestamp": "02:04:03", "text": "待てる。ああ、覚えておかないといけない"}, {"type": "subtitle", "time": 7446.87, "timestamp": "02:04:06", "text": "これらすべて。あなたはそうする必要はないと思います"}, {"type": "subtitle", "time": 7451.99, "timestamp": "02:04:11", "text": "有名になろう。"}, {"type": "subtitle", "time": 7453.589, "timestamp": "02:04:13", "text": "いいえ。"}, {"type": "subtitle", "time": 7458.47, "timestamp": "02:04:18", "text": "終わり。終わり。終わり。これらを買ってきます。"}, {"type": "subtitle", "time": 7473.75, "timestamp": "02:04:33", "text": "国。どうやって？"}, {"type": "subtitle", "time": 7477.589, "timestamp": "02:04:37", "text": "簡単です。わかった。"}, {"type": "subtitle", "time": 7484.07, "timestamp": "02:04:44", "text": "基本的なことを覚える必要はありません"}, {"type": "subtitle", "time": 7486.79, "timestamp": "02:04:46", "text": "知識。 H"}, {"type": "subtitle", "time": 7494.709, "timestamp": "02:04:54", "text": "これを忘れてた。"}, {"type": "subtitle", "time": 7497.43, "timestamp": "02:04:57", "text": "うん。"}]
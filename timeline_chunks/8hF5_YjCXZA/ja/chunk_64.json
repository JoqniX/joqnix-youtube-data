[{"type": "subtitle", "time": 3846.15, "timestamp": "01:04:06", "text": "うん、見えないよね？うん、そんな感じ"}, {"type": "subtitle", "time": 3849.99, "timestamp": "01:04:09", "text": "文字通りそう書いてある。"}, {"type": "subtitle", "time": 3854.15, "timestamp": "01:04:14", "text": "それはサポートしているが、そうではない"}, {"type": "subtitle", "time": 3857.43, "timestamp": "01:04:17", "text": "支払い用の口座を追加してください。収益"}, {"type": "subtitle", "time": 3858.789, "timestamp": "01:04:18", "text": "受信するものはここに送信されます"}, {"type": "subtitle", "time": 3860.789, "timestamp": "01:04:20", "text": "アカウント。ああ、RFCコードを追加しないといけない"}, {"type": "subtitle", "time": 3863.75, "timestamp": "01:04:23", "text": "口座番号とか、そういうもの。よし、これ"}, {"type": "subtitle", "time": 3866.069, "timestamp": "01:04:26", "text": "今度は正しく追加します。待って、君"}, {"type": "subtitle", "time": 3867.67, "timestamp": "01:04:27", "text": "何だと思う？追加しておきます。待って、どこに"}, {"type": "subtitle", "time": 3869.67, "timestamp": "01:04:29", "text": "もう一度その画像？銀行をダウンロードしました"}, {"type": "subtitle", "time": 3873.589, "timestamp": "01:04:33", "text": "アカウント情報。待って。"}, {"type": "subtitle", "time": 3884.069, "timestamp": "01:04:44", "text": "わかった。今回は正解です。わかった。待って。"}, {"type": "subtitle", "time": 3884.47, "timestamp": "01:04:44", "text": "C Z C Z C Z C Z C Z C Z C Z C Z C Z C Z"}, {"type": "subtitle", "time": 3886.63, "timestamp": "01:04:46", "text": "C ZN RB"}, {"type": "subtitle", "time": 3890.069, "timestamp": "01:04:50", "text": "1 2 3 4 ゼロ。"}, {"type": "subtitle", "time": 3893.27, "timestamp": "01:04:53", "text": "わかった。口座番号。わかった。これは"}, {"type": "subtitle", "time": 3898.069, "timestamp": "01:04:58", "text": "パート1　私は間違いを犯してはならない。"}, {"type": "subtitle", "time": 3899.829, "timestamp": "01:04:59", "text": "08"}]
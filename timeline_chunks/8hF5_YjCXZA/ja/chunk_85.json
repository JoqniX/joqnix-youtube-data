[{"type": "subtitle", "time": 5100.87, "timestamp": "01:25:00", "text": "スタイリングブランドと名前をチェックしてみてください。ブランド"}, {"type": "subtitle", "time": 5112.55, "timestamp": "01:25:12", "text": "おお。ブランド名のロゴ。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 5117.669, "timestamp": "01:25:17", "text": "引き続き応募してください。そうそう。ブランド名。"}, {"type": "subtitle", "time": 5120.47, "timestamp": "01:25:20", "text": "わかった。わかった。わかった。ジョック。待って。待って。する"}, {"type": "subtitle", "time": 5122.87, "timestamp": "01:25:22", "text": "うまくいった？いや、待って。ファイルをドラッグ"}, {"type": "subtitle", "time": 5124.95, "timestamp": "01:25:24", "text": "ここ。ああ、わかった。わかった。わかった。私の"}, {"type": "subtitle", "time": 5126.79, "timestamp": "01:25:26", "text": "ロゴ？ロゴはありますか？もちろん持っています"}, {"type": "subtitle", "time": 5135.35, "timestamp": "01:25:35", "text": "ロゴを作成してください。何てことだ。私のロゴはどこにあるの？"}, {"type": "subtitle", "time": 5138.8, "timestamp": "01:25:38", "text": "ねえ、私のロゴ"}, {"type": "subtitle", "time": 5140.07, "timestamp": "01:25:40", "text": "[音楽]"}, {"type": "subtitle", "time": 5142.39, "timestamp": "01:25:42", "text": "ブランディング。いや。俺のロゴはどこだ、兄弟？"}, {"type": "subtitle", "time": 5152.31, "timestamp": "01:25:52", "text": "ロゴ。そこにいたんですね。ここに来て。来て"}, {"type": "subtitle", "time": 5155.43, "timestamp": "01:25:55", "text": "自分。白いロゴです。ああ、大丈夫です。"}, {"type": "subtitle", "time": 5159.189, "timestamp": "01:25:59", "text": "大丈夫。何でも。寸法。"}]
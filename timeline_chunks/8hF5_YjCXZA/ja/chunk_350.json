[{"type": "subtitle", "time": 21005.03, "timestamp": "05:50:05", "text": "大気として実行"}, {"type": "subtitle", "time": 21022.23, "timestamp": "05:50:22", "text": "自分が何をしているのか、さっぱりわからないよ。私はできる"}, {"type": "subtitle", "time": 21024.788, "timestamp": "05:50:24", "text": "パターンを作るだけ。私は音楽を作れません。"}, {"type": "subtitle", "time": 21027.91, "timestamp": "05:50:27", "text": "やってみます。"}, {"type": "subtitle", "time": 21048.47, "timestamp": "05:50:48", "text": "どんな音楽ですか？分かりません。私は"}]
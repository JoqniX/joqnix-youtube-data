[{"type": "subtitle", "time": 20585.99, "timestamp": "05:43:05", "text": "私のクルを連れて行きたいです。持ってきたい"}, {"type": "subtitle", "time": 20589.91, "timestamp": "05:43:09", "text": "クルル。クルを連れて行ってもいいですか？カルは良い。"}, {"type": "subtitle", "time": 20591.67, "timestamp": "05:43:11", "text": "あなたに伝える"}, {"type": "subtitle", "time": 20595.51, "timestamp": "05:43:15", "text": "私にとってはイギリスの戦いだ"}, {"type": "subtitle", "time": 20599.99, "timestamp": "05:43:19", "text": "でも、もし私が見せたらいいと思う"}, {"type": "subtitle", "time": 20606.47, "timestamp": "05:43:26", "text": "ええと、私たちはこれを評価する必要があります"}, {"type": "subtitle", "time": 20609.3, "timestamp": "05:43:29", "text": "えーと"}, {"type": "subtitle", "time": 20622.59, "timestamp": "05:43:42", "text": "待ってください、これに戻ります。"}]
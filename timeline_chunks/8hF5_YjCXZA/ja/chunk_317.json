[{"type": "subtitle", "time": 19022.31, "timestamp": "05:17:02", "text": "えっと、彼は「うん、それを使って"}, {"type": "subtitle", "time": 19025.91, "timestamp": "05:17:05", "text": "これは授業用です。だからみんな"}, {"type": "subtitle", "time": 19028.788, "timestamp": "05:17:08", "text": "さまざまなジャンル。 1つは"}, {"type": "subtitle", "time": 19031.83, "timestamp": "05:17:11", "text": "アフロ、アフロハウスとかそんな感じ。別の"}, {"type": "subtitle", "time": 19034.708, "timestamp": "05:17:14", "text": "一つは、あのカメみたいなものです"}, {"type": "subtitle", "time": 19037.75, "timestamp": "05:17:17", "text": "水受け皿か何か、"}, {"type": "subtitle", "time": 19040.15, "timestamp": "05:17:20", "text": "亀の体か何か、"}, {"type": "subtitle", "time": 19042.708, "timestamp": "05:17:22", "text": "ドラムで音を出したり何か"}, {"type": "subtitle", "time": 19044.23, "timestamp": "05:17:24", "text": "右。あれって何ていう名前だったっけ？それ"}, {"type": "subtitle", "time": 19054.948, "timestamp": "05:17:34", "text": "えっと、なんていう名前ですか？"}, {"type": "subtitle", "time": 19062.788, "timestamp": "05:17:42", "text": "皆さんはそれを知っていますか？それは何と呼ばれていますか？"}]
[{"type": "subtitle", "time": 19320.948, "timestamp": "05:22:00", "text": "Twitch のチャンネルで、私がやっていたとき"}, {"type": "subtitle", "time": 19324.23, "timestamp": "05:22:04", "text": "宿題もすべて正しく"}, {"type": "subtitle", "time": 19328.07, "timestamp": "05:22:08", "text": "私はたくさんの実験的なことをしました"}, {"type": "subtitle", "time": 19330.39, "timestamp": "05:22:10", "text": "そしてあなたは「よし、勉強しよう」と言う"}, {"type": "subtitle", "time": 19333.11, "timestamp": "05:22:13", "text": "後ほど詳しく説明しますが、"}, {"type": "subtitle", "time": 19336.07, "timestamp": "05:22:16", "text": "今は心配しなくていいよ、私たちは"}, {"type": "subtitle", "time": 19338.868, "timestamp": "05:22:18", "text": "全員が正しい方向へ進むようにしてください"}, {"type": "subtitle", "time": 19340.868, "timestamp": "05:22:20", "text": "同じペースで、同じような内容です。彼は文字通りこう言った"}, {"type": "subtitle", "time": 19342.948, "timestamp": "05:22:22", "text": "それ"}, {"type": "subtitle", "time": 19344.948, "timestamp": "05:22:24", "text": "私が物事を複雑にしすぎた方法"}, {"type": "subtitle", "time": 19353.67, "timestamp": "05:22:33", "text": "私がこれをどれだけ複雑にしすぎたかというと"}, {"type": "subtitle", "time": 19356.47, "timestamp": "05:22:36", "text": "えーと、普通は、大きいと学習が"}, {"type": "subtitle", "time": 19359.83, "timestamp": "05:22:39", "text": "音楽を作るなど、今はあらゆることを"}, {"type": "subtitle", "time": 19362.31, "timestamp": "05:22:42", "text": "ええ、通常は、"}, {"type": "subtitle", "time": 19365.75, "timestamp": "05:22:45", "text": "音楽とか、必要のないものを作る"}, {"type": "subtitle", "time": 19368.39, "timestamp": "05:22:48", "text": "音楽についてあまり心配しすぎる"}, {"type": "subtitle", "time": 19370.15, "timestamp": "05:22:50", "text": "理論または類似のシンボル"}, {"type": "subtitle", "time": 19372.31, "timestamp": "05:22:52", "text": "複雑なものが好きなんですよね？私は"}, {"type": "subtitle", "time": 19375.19, "timestamp": "05:22:55", "text": "すでに複雑なルート、"}, {"type": "subtitle", "time": 19377.59, "timestamp": "05:22:57", "text": "バカバカ。"}]
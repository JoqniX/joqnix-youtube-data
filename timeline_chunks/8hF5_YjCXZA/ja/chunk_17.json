[{"type": "subtitle", "time": 1022.79, "timestamp": "00:17:02", "text": "そうであれば、うまくいくと思います。"}, {"type": "subtitle", "time": 1025.189, "timestamp": "00:17:05", "text": "それで"}, {"type": "subtitle", "time": 1029.829, "timestamp": "00:17:09", "text": "残りは私次第です。えっと、まだ"}, {"type": "subtitle", "time": 1032.71, "timestamp": "00:17:12", "text": "問題は、熱が出てから、えーと"}, {"type": "subtitle", "time": 1035.75, "timestamp": "00:17:15", "text": "準備もあまりできなかったのは、"}, {"type": "subtitle", "time": 1038.309, "timestamp": "00:17:18", "text": "そこへ旅行すると、"}, {"type": "subtitle", "time": 1041.35, "timestamp": "00:17:21", "text": "コラボレーションですが、問題は私が"}, {"type": "subtitle", "time": 1042.71, "timestamp": "00:17:22", "text": "いつ始めるべきかわからない"}, {"type": "subtitle", "time": 1046.23, "timestamp": "00:17:26", "text": "コラボレーションは無料です"}, {"type": "subtitle", "time": 1048.549, "timestamp": "00:17:28", "text": "そして、私はそのためのサーバーをまだ作成していません。おお"}, {"type": "subtitle", "time": 1051.43, "timestamp": "00:17:31", "text": "ああ、やらなきゃいけないことが山ほどある。うん、"}, {"type": "subtitle", "time": 1061.51, "timestamp": "00:17:41", "text": "あ、待って。えーと、私は、えーと、私は必要ないですか？"}, {"type": "subtitle", "time": 1064.23, "timestamp": "00:17:44", "text": "よし、ジェイトン2日目は"}, {"type": "subtitle", "time": 1078.15, "timestamp": "00:17:58", "text": "#冗談です。"}]
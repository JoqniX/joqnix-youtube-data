[{"type": "subtitle", "time": 8651.51, "timestamp": "02:24:11", "text": "わかった。わかった。"}, {"type": "subtitle", "time": 8654.71, "timestamp": "02:24:14", "text": "あなたの目に恐怖が宿っているのがわかる。いいえ。"}, {"type": "subtitle", "time": 8658.309, "timestamp": "02:24:18", "text": "つまり、楽しいゲームだよ。"}, {"type": "subtitle", "time": 8659.88, "timestamp": "02:24:19", "text": "楽しいゲームです。"}, {"type": "subtitle", "time": 8674.309, "timestamp": "02:24:34", "text": "ねえ、ママ。"}, {"type": "subtitle", "time": 8676.309, "timestamp": "02:24:36", "text": "調子はどう？何か作りましたか？"}, {"type": "subtitle", "time": 8679.91, "timestamp": "02:24:39", "text": "進捗？いいえ。この調子だと、私は決して"}, {"type": "subtitle", "time": 8687.83, "timestamp": "02:24:47", "text": "イライラしても無駄だ。"}, {"type": "subtitle", "time": 8692.389, "timestamp": "02:24:52", "text": "レポートには具体的に何が必要ですか？"}, {"type": "subtitle", "time": 8696.389, "timestamp": "02:24:56", "text": "標本、データ、その他諸々。"}, {"type": "subtitle", "time": 8697.99, "timestamp": "02:24:57", "text": "H."}]
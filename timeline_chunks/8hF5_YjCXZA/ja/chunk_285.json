[{"type": "subtitle", "time": 17103.91, "timestamp": "04:45:03", "text": "ベイビー。"}, {"type": "subtitle", "time": 17136.948, "timestamp": "04:45:36", "text": "私は大人です。私は大人です。"}, {"type": "subtitle", "time": 17148.55, "timestamp": "04:45:48", "text": "しかし"}, {"type": "subtitle", "time": 17150.31, "timestamp": "04:45:50", "text": "パートナーができたら、さらに"}, {"type": "subtitle", "time": 17154.708, "timestamp": "04:45:54", "text": "問題。ああ、それもそうだね。真実。"}, {"type": "subtitle", "time": 17157.99, "timestamp": "04:45:57", "text": "私がどれではないかなんて言わないでください。私は"}]
[{"type": "subtitle", "time": 18660.628, "timestamp": "05:11:00", "text": "待てよ、俺はもう何年もゾーンに入っているのか？"}, {"type": "subtitle", "time": 18663.83, "timestamp": "05:11:03", "text": "そうだと思います。おお、"}, {"type": "subtitle", "time": 18666.31, "timestamp": "05:11:06", "text": "でも問題は、たとえ私がそれを手に入れたとしても"}, {"type": "subtitle", "time": 18668.948, "timestamp": "05:11:08", "text": "ヤドリギとその他すべて、"}, {"type": "subtitle", "time": 18673.27, "timestamp": "05:11:13", "text": "私はそのソフトウェアで音楽を制作します。"}, {"type": "subtitle", "time": 18675.91, "timestamp": "05:11:15", "text": "私は苦労するだろう。"}, {"type": "subtitle", "time": 18680.15, "timestamp": "05:11:20", "text": "私はまだまともな音楽を作れない。"}, {"type": "subtitle", "time": 18683.11, "timestamp": "05:11:23", "text": "基本を忘れてしまった。"}, {"type": "subtitle", "time": 18685.59, "timestamp": "05:11:25", "text": "私はすべてを忘れてしまった。"}, {"type": "subtitle", "time": 18689.51, "timestamp": "05:11:29", "text": "Mの痛みも、私も変えました"}, {"type": "subtitle", "time": 18702.868, "timestamp": "05:11:42", "text": "ああ、私はまだユダ諸島にいる。ああ、神様。"}, {"type": "subtitle", "time": 18705.03, "timestamp": "05:11:45", "text": "えっと"}, {"type": "subtitle", "time": 18707.59, "timestamp": "05:11:47", "text": "特別なイベント。"}, {"type": "subtitle", "time": 18709.51, "timestamp": "05:11:49", "text": "いや、僕たちは音楽をやっているんだよね？私は思う"}]
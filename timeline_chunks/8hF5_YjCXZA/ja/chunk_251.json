[{"type": "subtitle", "time": 15066.95, "timestamp": "04:11:06", "text": "えっと、２番目？なぜ彼らは行方不明なのか"}, {"type": "subtitle", "time": 15068.469, "timestamp": "04:11:08", "text": "彼らが正当な存在だと信じ込ませるためですか？おお、"}, {"type": "subtitle", "time": 15078.07, "timestamp": "04:11:18", "text": "また、helloをフォローしていただきありがとうございます。"}, {"type": "subtitle", "time": 15080.469, "timestamp": "04:11:20", "text": "ストリームへようこそ。ジャスミン様"}, {"type": "subtitle", "time": 15082.389, "timestamp": "04:11:22", "text": "来る。皆さんにこんな私を見せてしまってごめんなさい"}, {"type": "subtitle", "time": 15084.07, "timestamp": "04:11:24", "text": "これ。"}, {"type": "subtitle", "time": 15087.14, "timestamp": "04:11:27", "text": "そして彼らはジョークを思いついた。進む。"}, {"type": "subtitle", "time": 15095.91, "timestamp": "04:11:35", "text": "彼らはあなたを説得するだろうから、信じてみなさい。私"}, {"type": "subtitle", "time": 15098.229, "timestamp": "04:11:38", "text": "少なくとも音楽制作"}, {"type": "subtitle", "time": 15101.11, "timestamp": "04:11:41", "text": "私が受講しているコースはそうではなく、"}, {"type": "subtitle", "time": 15104.71, "timestamp": "04:11:44", "text": "実際は良かったんだけど、まあ、"}, {"type": "subtitle", "time": 15107.269, "timestamp": "04:11:47", "text": "種子が限られています"}, {"type": "subtitle", "time": 15109.59, "timestamp": "04:11:49", "text": "えっと、私はとてもたくさん手に入れているので、"}, {"type": "subtitle", "time": 15118.12, "timestamp": "04:11:58", "text": "わからない"}]
[{"type": "subtitle", "time": 5644.629, "timestamp": "01:34:04", "text": "ああ、質問はどんどん追加できますよ"}, {"type": "subtitle", "time": 5648.07, "timestamp": "01:34:08", "text": "そうすれば、私たちはそのことを実行することになる。"}, {"type": "subtitle", "time": 5654.31, "timestamp": "01:34:14", "text": "[音楽]"}, {"type": "subtitle", "time": 5657.03, "timestamp": "01:34:17", "text": "わかった。あの、ロックしてもいいですか？ちょっと"}, {"type": "subtitle", "time": 5659.189, "timestamp": "01:34:19", "text": "ちょっと見てみる？わかった、ロックするよ"}, {"type": "subtitle", "time": 5666.07, "timestamp": "01:34:26", "text": "そして次に、"}, {"type": "subtitle", "time": 5669.189, "timestamp": "01:34:29", "text": "ダークニックによるコミュニケーション方法。ただ"}, {"type": "subtitle", "time": 5672.709, "timestamp": "01:34:32", "text": "この番組、すごくクールだよ。とてもクールです"}, {"type": "subtitle", "time": 5674.87, "timestamp": "01:34:34", "text": "見せる。ああ、なんて素晴らしいんだ。それはとても"}, {"type": "subtitle", "time": 5677.27, "timestamp": "01:34:37", "text": "可愛いですね。"}, {"type": "subtitle", "time": 5681.75, "timestamp": "01:34:41", "text": "また、その位置を調整させてください。"}]
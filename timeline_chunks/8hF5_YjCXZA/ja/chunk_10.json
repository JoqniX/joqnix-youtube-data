[{"type": "subtitle", "time": 619.59, "timestamp": "00:10:19", "text": "そうするつもりだったんです。"}, {"type": "subtitle", "time": 631.509, "timestamp": "00:10:31", "text": "温かい温かいおはようございます、ようこそ"}, {"type": "subtitle", "time": 634.47, "timestamp": "00:10:34", "text": "ジョッカソン2日目。はい、"}, {"type": "subtitle", "time": 637.03, "timestamp": "00:10:37", "text": "初日、私の配信が途切れてしまいました"}, {"type": "subtitle", "time": 639.75, "timestamp": "00:10:39", "text": "停電のため。でも大丈夫。私たちは"}, {"type": "subtitle", "time": 642.389, "timestamp": "00:10:42", "text": "初日はそこで終了です。そして"}, {"type": "subtitle", "time": 645.99, "timestamp": "00:10:45", "text": "これは新しい配信で、2日目です。"}, {"type": "subtitle", "time": 648.069, "timestamp": "00:10:48", "text": "わーい。"}, {"type": "subtitle", "time": 653.19, "timestamp": "00:10:53", "text": "今日は2日目です。パート1、パート2"}, {"type": "subtitle", "time": 658.15, "timestamp": "00:10:58", "text": "24時間配信。ウィンク。うん。しかし今日は"}]
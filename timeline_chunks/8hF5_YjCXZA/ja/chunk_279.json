[{"type": "subtitle", "time": 16741.349, "timestamp": "04:39:01", "text": "文字通りグラスを落としてしまった。暑かった。"}, {"type": "subtitle", "time": 16743.269, "timestamp": "04:39:03", "text": "それから私はそれを再び手に取った。そうそう、"}, {"type": "subtitle", "time": 16748.07, "timestamp": "04:39:08", "text": "スチーム。ありがとう。蒸気が熱すぎた。そして"}, {"type": "subtitle", "time": 16750.31, "timestamp": "04:39:10", "text": "うん、"}, {"type": "subtitle", "time": 16752.949, "timestamp": "04:39:12", "text": "そして私は氷を入れようとしていて、"}, {"type": "subtitle", "time": 16755.75, "timestamp": "04:39:15", "text": "水に入れて、全部やってみて。"}, {"type": "subtitle", "time": 16759.8, "timestamp": "04:39:19", "text": "それから、この人たちが私に電話をかけてきて、"}, {"type": "subtitle", "time": 16762.07, "timestamp": "04:39:22", "text": "[音楽]"}, {"type": "subtitle", "time": 16764.789, "timestamp": "04:39:24", "text": "電話がかかってくることはめったにない"}, {"type": "subtitle", "time": 16767.189, "timestamp": "04:39:27", "text": "あまりにも。"}, {"type": "subtitle", "time": 16769.189, "timestamp": "04:39:29", "text": "今度はスパム電話がかかってくるか、"}, {"type": "subtitle", "time": 16770.949, "timestamp": "04:39:30", "text": "何か。"}, {"type": "subtitle", "time": 16773.67, "timestamp": "04:39:33", "text": "私はただ、私が私の"}, {"type": "subtitle", "time": 16778.31, "timestamp": "04:39:38", "text": "両親、何でも知っている父"}, {"type": "subtitle", "time": 16783.35, "timestamp": "04:39:43", "text": "以前にもこれをやったことがあるし、私の"}, {"type": "subtitle", "time": 16787.83, "timestamp": "04:39:47", "text": "父は言った、父は乗り気ではない"}, {"type": "subtitle", "time": 16791.19, "timestamp": "04:39:51", "text": "ええと、やる気があるとか"}, {"type": "subtitle", "time": 16794.15, "timestamp": "04:39:54", "text": "そして私はただ「ごめんなさい」と言い、感謝します"}, {"type": "subtitle", "time": 16799.11, "timestamp": "04:39:59", "text": "お時間をいただきありがとうございました。これで通話を終了いたします。"}]
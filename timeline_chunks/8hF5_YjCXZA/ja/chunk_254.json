[{"type": "subtitle", "time": 15249.349, "timestamp": "04:14:09", "text": "でも私が心配しているのは"}, {"type": "subtitle", "time": 15252.55, "timestamp": "04:14:12", "text": "もし彼らが私に言ったらどうなるだろう"}, {"type": "subtitle", "time": 15255.429, "timestamp": "04:14:15", "text": "もし私が3,000ドル支払ったとしたらどうなるでしょうか"}, {"type": "subtitle", "time": 15257.269, "timestamp": "04:14:17", "text": "すべては順調で、それから"}, {"type": "subtitle", "time": 15259.03, "timestamp": "04:14:19", "text": "彼らは私のところに来て、支払わなければならないと言います"}, {"type": "subtitle", "time": 15261.269, "timestamp": "04:14:21", "text": "16,000"}, {"type": "subtitle", "time": 15263.91, "timestamp": "04:14:23", "text": "税金とか何かでどうすればいいの？"}, {"type": "subtitle", "time": 15266.07, "timestamp": "04:14:26", "text": "お金はどこで手に入れるつもりですか？"}, {"type": "subtitle", "time": 15283.75, "timestamp": "04:14:43", "text": "それは少し似ている、"}, {"type": "subtitle", "time": 15286.149, "timestamp": "04:14:46", "text": "なあ、なんでメールが送信されないんだ？何"}, {"type": "subtitle", "time": 15289.189, "timestamp": "04:14:49", "text": "一体どういうことだ？待って、"}, {"type": "subtitle", "time": 15293.99, "timestamp": "04:14:53", "text": "に"}]
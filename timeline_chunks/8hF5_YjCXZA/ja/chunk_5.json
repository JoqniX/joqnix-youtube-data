[{"type": "subtitle", "time": 306.71, "timestamp": "00:05:06", "text": "また、私はああ神よ蛾になるでしょう"}, {"type": "subtitle", "time": 308.629, "timestamp": "00:05:08", "text": "ここです。蛾が来た。君たちは"}, {"type": "subtitle", "time": 311.99, "timestamp": "00:05:11", "text": "見えますか？モーが来た。ああ神様、私は"}, {"type": "subtitle", "time": 313.59, "timestamp": "00:05:13", "text": "彼を殺せ。あいつを殺してやる。ここに来て、"}, {"type": "subtitle", "time": 317.35, "timestamp": "00:05:17", "text": "男の子。私は殺される"}, {"type": "subtitle", "time": 331.27, "timestamp": "00:05:31", "text": "ああ、もうダメだ。私はもう行ってしまう。私は行きます。"}, {"type": "subtitle", "time": 333.99, "timestamp": "00:05:33", "text": "ありがたいことに、蚊がコウモリが来た"}, {"type": "subtitle", "time": 336.07, "timestamp": "00:05:36", "text": "節約のために。"}, {"type": "subtitle", "time": 339.67, "timestamp": "00:05:39", "text": "彼が揚げられているのを見てみろ。"}, {"type": "subtitle", "time": 342.87, "timestamp": "00:05:42", "text": "これがその結果だ。おお、"}, {"type": "subtitle", "time": 347.909, "timestamp": "00:05:47", "text": "私のバカに近づくようなもの。"}, {"type": "subtitle", "time": 350.71, "timestamp": "00:05:50", "text": "怖いよ、もしも"}, {"type": "subtitle", "time": 353.83, "timestamp": "00:05:53", "text": "昆虫か何かを食べるの？"}, {"type": "subtitle", "time": 355.99, "timestamp": "00:05:55", "text": "何が起こるだろうか？"}, {"type": "subtitle", "time": 358.15, "timestamp": "00:05:58", "text": "私はあのダイオードが怖い。それは"}]
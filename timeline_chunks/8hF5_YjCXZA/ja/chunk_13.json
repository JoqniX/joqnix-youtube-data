[{"type": "subtitle", "time": 782.15, "timestamp": "00:13:02", "text": "ごめんなさい。 Twitchの報酬に感謝！"}, {"type": "subtitle", "time": 785.829, "timestamp": "00:13:05", "text": "来なかった。知っている。とても悲しいです。"}, {"type": "subtitle", "time": 789.19, "timestamp": "00:13:09", "text": "ヨアトンの終わりに想像してみてください"}, {"type": "subtitle", "time": 792.069, "timestamp": "00:13:12", "text": "それに気づいた。何てことだ。私は"}, {"type": "subtitle", "time": 794.629, "timestamp": "00:13:14", "text": "泣いてるよ、男。"}, {"type": "subtitle", "time": 796.389, "timestamp": "00:13:16", "text": "でも、ありがたいことに私たちはそれに気付いた。"}, {"type": "subtitle", "time": 801.19, "timestamp": "00:13:21", "text": "今日。ああ、よかった。ああ、助かった。"}, {"type": "subtitle", "time": 803.19, "timestamp": "00:13:23", "text": "ええ、それは修正します。心配しないで。"}, {"type": "subtitle", "time": 806.23, "timestamp": "00:13:26", "text": "Kofiで寄付していただいても構いません。私"}, {"type": "subtitle", "time": 810.069, "timestamp": "00:13:30", "text": "コフィからゴールを決めた。私は言った"}, {"type": "subtitle", "time": 813.35, "timestamp": "00:13:33", "text": "目標って何ですか？"}, {"type": "subtitle", "time": 815.35, "timestamp": "00:13:35", "text": "目標に関する詳細も。あなたはできる"}, {"type": "subtitle", "time": 821.269, "timestamp": "00:13:41", "text": "YouTubeの説明欄に書いてあります"}, {"type": "subtitle", "time": 823.59, "timestamp": "00:13:43", "text": "または、Twitch の場合は、"}, {"type": "subtitle", "time": 828.23, "timestamp": "00:13:48", "text": "Twitchパネル。わかった。こんにちは"}, {"type": "subtitle", "time": 831.11, "timestamp": "00:13:51", "text": "また、オリジナルのトランプも歓迎します"}, {"type": "subtitle", "time": 833.829, "timestamp": "00:13:53", "text": "ようこそ、こんにちは、ようこそ"}]
[{"type": "subtitle", "time": 3901.51, "timestamp": "01:05:01", "text": "06"}, {"type": "subtitle", "time": 3908.47, "timestamp": "01:05:08", "text": "ちなみにそれは別の話です。"}, {"type": "subtitle", "time": 3911.67, "timestamp": "01:05:11", "text": "以前お話しした人ではありません。"}, {"type": "subtitle", "time": 3918.63, "timestamp": "01:05:18", "text": "口座番号を暗記しなければならなかった。"}, {"type": "subtitle", "time": 3921.109, "timestamp": "01:05:21", "text": "それは確かに存在する。"}, {"type": "subtitle", "time": 3923.91, "timestamp": "01:05:23", "text": "連絡先情報として登録しました"}, {"type": "subtitle", "time": 3925.75, "timestamp": "01:05:25", "text": "電話"}, {"type": "subtitle", "time": 3928.069, "timestamp": "01:05:28", "text": "銀行口座番号のようなもので、それを入力しました"}, {"type": "subtitle", "time": 3958.35, "timestamp": "01:05:58", "text": "はい、銀行口座を追加しました。"}]
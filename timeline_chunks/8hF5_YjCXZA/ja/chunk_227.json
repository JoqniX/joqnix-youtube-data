[{"type": "subtitle", "time": 13626.07, "timestamp": "03:47:06", "text": "税金のようなものはありますか？"}, {"type": "subtitle", "time": 13638.309, "timestamp": "03:47:18", "text": "えーと"}, {"type": "subtitle", "time": 13641.349, "timestamp": "03:47:21", "text": "もし私が受け取らなかった場合"}, {"type": "subtitle", "time": 13643.51, "timestamp": "03:47:23", "text": "ライセンスとその他すべて、私は何ができるでしょうか"}, {"type": "subtitle", "time": 13675.03, "timestamp": "03:47:55", "text": "えっと、私が持っているガリアって何ですか？いいね"}]
[{"type": "subtitle", "time": 10447.51, "timestamp": "02:54:07", "text": "また釣りだ。"}, {"type": "subtitle", "time": 10450.07, "timestamp": "02:54:10", "text": "えっと、私が本当に"}, {"type": "subtitle", "time": 10453.349, "timestamp": "02:54:13", "text": "皆さんが一緒に釣りに行くために買いたい"}, {"type": "subtitle", "time": 10456.63, "timestamp": "02:54:16", "text": "他の人たちと共通しているのはこれです。 Twitchにはこんなものがある"}, {"type": "subtitle", "time": 10459.59, "timestamp": "02:54:19", "text": "フィッシュラークと呼ばれるインタラクティブゲーム"}, {"type": "subtitle", "time": 10462.63, "timestamp": "02:54:22", "text": "釣りとか、何か。"}, {"type": "subtitle", "time": 10466.23, "timestamp": "02:54:26", "text": "ええ、私はそう願っています"}, {"type": "subtitle", "time": 10469.11, "timestamp": "02:54:29", "text": "だって、今は寝る配信をするときは、"}, {"type": "subtitle", "time": 10471.429, "timestamp": "02:54:31", "text": "Twitchでは誰でも釣りなどができる"}, {"type": "subtitle", "time": 10475.429, "timestamp": "02:54:35", "text": "サイト。 YouTubeではできません。しかし"}, {"type": "subtitle", "time": 10493.59, "timestamp": "02:54:53", "text": "ログ。"}, {"type": "subtitle", "time": 10498.07, "timestamp": "02:54:58", "text": "そう、トゥイッチフィッシングの丸太餌ね。"}]
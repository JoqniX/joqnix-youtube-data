[{"type": "subtitle", "time": 2701.829, "timestamp": "00:45:01", "text": "私はバングラデシュという国をリクエストしました。"}, {"type": "subtitle", "time": 2703.91, "timestamp": "00:45:03", "text": "PayPalを削除できますか？PayPalが"}, {"type": "subtitle", "time": 2707.03, "timestamp": "00:45:07", "text": "機能しません。支払いを追加できますか、または"}, {"type": "subtitle", "time": 2709.99, "timestamp": "00:45:09", "text": "可能であれば、他のプラットフォームも利用できますか？そして"}, {"type": "subtitle", "time": 2712.23, "timestamp": "00:45:12", "text": "彼らはイエスと答え、そして実際にそうした。今は"}, {"type": "subtitle", "time": 2715.109, "timestamp": "00:45:15", "text": "去った。"}, {"type": "subtitle", "time": 2716.87, "timestamp": "00:45:16", "text": "この時点で、私はただ自分の"}, {"type": "subtitle", "time": 2721.27, "timestamp": "00:45:21", "text": "自分のもの。わからない。"}, {"type": "subtitle", "time": 2728.63, "timestamp": "00:45:28", "text": "自分専用のUPIも持ってるかもしれないから"}, {"type": "subtitle", "time": 2741.67, "timestamp": "00:45:41", "text": "ジョックナブル星座。"}, {"type": "subtitle", "time": 2752.069, "timestamp": "00:45:52", "text": "[音楽]"}, {"type": "subtitle", "time": 2754.95, "timestamp": "00:45:54", "text": "のようなもの"}, {"type": "subtitle", "time": 2756.95, "timestamp": "00:45:56", "text": "最終的に"}]
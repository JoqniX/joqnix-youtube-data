[{"type": "subtitle", "time": 16142.63, "timestamp": "04:29:02", "text": "それを受け取る。えっと、"}, {"type": "subtitle", "time": 16145.349, "timestamp": "04:29:05", "text": "そこには必ずひねりがある。私はしません"}, {"type": "subtitle", "time": 16148.71, "timestamp": "04:29:08", "text": "それほど安いとは思わない。"}, {"type": "subtitle", "time": 16151.03, "timestamp": "04:29:11", "text": "つまり、3000は安くはないが、それでも"}, {"type": "subtitle", "time": 16159.67, "timestamp": "04:29:19", "text": "別の男が小さいものを頼んだと言っていた"}, {"type": "subtitle", "time": 16163.67, "timestamp": "04:29:23", "text": "量。何てことだ。"}, {"type": "subtitle", "time": 16171.99, "timestamp": "04:29:31", "text": "そこだけは後悔したくないんです。"}, {"type": "subtitle", "time": 16175.429, "timestamp": "04:29:35", "text": "わかった。例えば、応募すると言ったら"}, {"type": "subtitle", "time": 16179.67, "timestamp": "04:29:39", "text": "商標、または出願書類、"}, {"type": "subtitle", "time": 16182.55, "timestamp": "04:29:42", "text": "すべては現在Joxという名前で、"}, {"type": "subtitle", "time": 16195.269, "timestamp": "04:29:55", "text": "直接会ってやった方がいいと思う。"}]
[{"type": "subtitle", "time": 6180.47, "timestamp": "01:43:00", "text": "それは私が書いた時のことを思い出させる"}, {"type": "subtitle", "time": 6182.95, "timestamp": "01:43:02", "text": "私の英語のアニメのプロットみたい"}, {"type": "subtitle", "time": 6191.51, "timestamp": "01:43:11", "text": "それは戦争かイギリスの戦争か"}, {"type": "subtitle", "time": 6193.91, "timestamp": "01:43:13", "text": "何か質問があったのですが、答えが分かりませんでした。"}, {"type": "subtitle", "time": 6197.43, "timestamp": "01:43:17", "text": "私はアニメの戦争を書いてみようと思った"}, {"type": "subtitle", "time": 6200.39, "timestamp": "01:43:20", "text": "プロットに基づいています。どのアニメだったか忘れた"}, {"type": "subtitle", "time": 6202.629, "timestamp": "01:43:22", "text": "書いた。"}, {"type": "subtitle", "time": 6205.43, "timestamp": "01:43:25", "text": "えっと"}, {"type": "subtitle", "time": 6212.31, "timestamp": "01:43:32", "text": "そういえば、"}, {"type": "subtitle", "time": 6220.55, "timestamp": "01:43:40", "text": "好きなアニメキャラクター。思うに"}, {"type": "subtitle", "time": 6223.99, "timestamp": "01:43:43", "text": "うーん、わからないとは言えない"}, {"type": "subtitle", "time": 6225.669, "timestamp": "01:43:45", "text": "それは私の一番好きなキャラクターです。私は愛する"}, {"type": "subtitle", "time": 6232.55, "timestamp": "01:43:52", "text": "英語の試験はいつも簡単だったけど、"}, {"type": "subtitle", "time": 6237.03, "timestamp": "01:43:57", "text": "7枚か9枚のバックナンバーがある"}]
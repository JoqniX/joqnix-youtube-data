[{"type": "subtitle", "time": 15551.349, "timestamp": "04:19:11", "text": "いいえ、それはしません。なぜなら、"}, {"type": "subtitle", "time": 15554.87, "timestamp": "04:19:14", "text": "私は、サービスが"}, {"type": "subtitle", "time": 15559.03, "timestamp": "04:19:19", "text": "彼らが正当な業者であれば、そこに存在するはずです。"}, {"type": "subtitle", "time": 15561.75, "timestamp": "04:19:21", "text": "彼らはまずお金を手に入れ、それから仕事に取り掛かる。"}, {"type": "subtitle", "time": 15564.07, "timestamp": "04:19:24", "text": "ご存知の通り、私はすでに詐欺に遭っています"}, {"type": "subtitle", "time": 15566.07, "timestamp": "04:19:26", "text": "私の人生において。詐欺に遭いたくない"}, {"type": "subtitle", "time": 15583.349, "timestamp": "04:19:43", "text": "問題は"}, {"type": "subtitle", "time": 15587.75, "timestamp": "04:19:47", "text": "私自身もよくわからない。最悪だ。つまり、"}, {"type": "subtitle", "time": 15590.55, "timestamp": "04:19:50", "text": "少なくとも私は持っていてよかった"}, {"type": "subtitle", "time": 15593.189, "timestamp": "04:19:53", "text": "これについて皆さんに質問してみます。もし私が"}, {"type": "subtitle", "time": 15596.95, "timestamp": "04:19:56", "text": "以前にも許可なくやったことがある。神よ、彼らは"}, {"type": "subtitle", "time": 15599.11, "timestamp": "04:19:59", "text": "ターンオーバー時間についてさえ言った"}]
[{"type": "subtitle", "time": 10740.79, "timestamp": "02:59:00", "text": "彼女に会いたいの？"}, {"type": "subtitle", "time": 10749.75, "timestamp": "02:59:09", "text": "自分が挟まってしまわないように気をつけなければならない"}, {"type": "subtitle", "time": 10752.63, "timestamp": "02:59:12", "text": "なぜなら、これは文字通りのモバイルだから"}, {"type": "subtitle", "time": 10754.87, "timestamp": "02:59:14", "text": "フレーム設定"}, {"type": "subtitle", "time": 10757.83, "timestamp": "02:59:17", "text": "それは"}, {"type": "subtitle", "time": 10763.83, "timestamp": "02:59:23", "text": "まだ配信中です。待つことはまだ"}, {"type": "subtitle", "time": 10767.51, "timestamp": "02:59:27", "text": "ストリーミング配信。おお。わかった、それはいいよ。"}, {"type": "subtitle", "time": 10769.91, "timestamp": "02:59:29", "text": "これで12時間の配信になった。わかった。"}, {"type": "subtitle", "time": 10772.79, "timestamp": "02:59:32", "text": "とにかく、えっと、手短に説明させてください。私"}, {"type": "subtitle", "time": 10776.309, "timestamp": "02:59:36", "text": "私のテストストリームをやっていました"}, {"type": "subtitle", "time": 10781.03, "timestamp": "02:59:41", "text": "今日7時間ほど古いアカウントを使っていました。それで"}, {"type": "subtitle", "time": 10783.91, "timestamp": "02:59:43", "text": "だから私はとても疲れているの、私は知らない"}, {"type": "subtitle", "time": 10785.75, "timestamp": "02:59:45", "text": "そのチャンネルは必ず見つかるだろう。でも私は"}, {"type": "subtitle", "time": 10789.03, "timestamp": "02:59:49", "text": "バカ、君はこうできたのに"}, {"type": "subtitle", "time": 10790.95, "timestamp": "02:59:50", "text": "文字通りストリーミング配信できた"}, {"type": "subtitle", "time": 10793.11, "timestamp": "02:59:53", "text": "私のジョックリングチャンネルだけど、私は「えーと、"}, {"type": "subtitle", "time": 10796.15, "timestamp": "02:59:56", "text": "これを直して全部済ませるだけだけど、うん"}]
[{"type": "subtitle", "time": 17941.11, "timestamp": "04:59:01", "text": "船はオンラインでやりたかったから"}, {"type": "subtitle", "time": 17945.03, "timestamp": "04:59:05", "text": "ショップの件で、それから転送されました"}, {"type": "subtitle", "time": 17948.07, "timestamp": "04:59:08", "text": "私にとってこれは、この人々と呼ばれる"}, {"type": "subtitle", "time": 17950.628, "timestamp": "04:59:10", "text": "コ氏を登録し、彼らは電話をかけました"}, {"type": "subtitle", "time": 17956.15, "timestamp": "04:59:16", "text": "私と彼らは「えーと、3000で"}, {"type": "subtitle", "time": 17957.75, "timestamp": "04:59:17", "text": "えーと"}, {"type": "subtitle", "time": 17959.91, "timestamp": "04:59:19", "text": "すべての提出書類とその他すべて"}, {"type": "subtitle", "time": 17963.35, "timestamp": "04:59:23", "text": "15～20日以内に完了し、"}, {"type": "subtitle", "time": 17964.948, "timestamp": "04:59:24", "text": "すべて。彼らは、"}, {"type": "subtitle", "time": 17968.55, "timestamp": "04:59:28", "text": "今日3000ドル払わなきゃいけないし、他にもいろいろある。それから"}, {"type": "subtitle", "time": 17970.868, "timestamp": "04:59:30", "text": "私は「ちょっとお金が足りないんだ」と思った。私"}, {"type": "subtitle", "time": 17973.43, "timestamp": "04:59:33", "text": "UPIアカウントにお金がありません、銀行"}, {"type": "subtitle", "time": 17975.27, "timestamp": "04:59:35", "text": "アカウント。現金で持っています"}, {"type": "subtitle", "time": 17977.83, "timestamp": "04:59:37", "text": "すべて。そして私はある意味、"}, {"type": "subtitle", "time": 17979.91, "timestamp": "04:59:39", "text": "分割払いとか色々。彼らは"}, {"type": "subtitle", "time": 17981.91, "timestamp": "04:59:41", "text": "2,000 する。"}, {"type": "subtitle", "time": 17985.19, "timestamp": "04:59:45", "text": "そしてその後彼らはこう言った"}, {"type": "subtitle", "time": 17987.03, "timestamp": "04:59:47", "text": "彼らは私にこう言わなければならない"}, {"type": "subtitle", "time": 17989.11, "timestamp": "04:59:49", "text": "今日それを。今日的な話題。私は"}, {"type": "subtitle", "time": 17992.788, "timestamp": "04:59:52", "text": "まあいいや、午後3時か4時。私がやります。それから"}, {"type": "subtitle", "time": 17996.47, "timestamp": "04:59:56", "text": "その後、彼らは再び私に電話をかけてきた。"}]
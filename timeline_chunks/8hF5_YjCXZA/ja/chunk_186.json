[{"type": "subtitle", "time": 11161.51, "timestamp": "03:06:01", "text": "ええ、それは視覚的に確認できる音声です。私たちは"}, {"type": "subtitle", "time": 11169.91, "timestamp": "03:06:09", "text": "正しい方法がわからない"}, {"type": "subtitle", "time": 11177.59, "timestamp": "03:06:17", "text": "もし私がうっかりあの傾斜をしたらどうなるか想像してみて"}, {"type": "subtitle", "time": 11180.309, "timestamp": "03:06:20", "text": "水槽に当てて。"}, {"type": "subtitle", "time": 11194.389, "timestamp": "03:06:34", "text": "[音楽]"}, {"type": "subtitle", "time": 11197.75, "timestamp": "03:06:37", "text": "このポジションは良いと思う。"}, {"type": "subtitle", "time": 11201.429, "timestamp": "03:06:41", "text": "しかし、彼が飛び去ってしまったら良いことだろうか？私"}, {"type": "subtitle", "time": 11205.15, "timestamp": "03:06:45", "text": "えーっと、爆発する。"}]
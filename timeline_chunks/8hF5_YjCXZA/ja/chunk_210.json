[{"type": "subtitle", "time": 12605.19, "timestamp": "03:30:05", "text": "お聞きの通り、私は自分の"}, {"type": "subtitle", "time": 12608.15, "timestamp": "03:30:08", "text": "声が大きい、または大声で"}, {"type": "subtitle", "time": 12622.55, "timestamp": "03:30:22", "text": "わかった。あ、待って。知っている。"}, {"type": "subtitle", "time": 12627.11, "timestamp": "03:30:27", "text": "近い。近い。近い。"}, {"type": "subtitle", "time": 12633.23, "timestamp": "03:30:33", "text": "花の願い"}, {"type": "subtitle", "time": 12639.269, "timestamp": "03:30:39", "text": "[音楽]"}, {"type": "subtitle", "time": 12656.8, "timestamp": "03:30:56", "text": "痛み。いいえ。"}]
[{"type": "subtitle", "time": 11524.55, "timestamp": "03:12:04", "text": "また、12に達すると、"}, {"type": "subtitle", "time": 11527.51, "timestamp": "03:12:07", "text": "今日は大家さんの子供の誕生日です。"}, {"type": "subtitle", "time": 11532.87, "timestamp": "03:12:12", "text": "明日。つまり、7月11日の11日です。"}, {"type": "subtitle", "time": 11535.75, "timestamp": "03:12:15", "text": "彼に誕生日おめでとうと言わなきゃ。彼"}, {"type": "subtitle", "time": 11546.15, "timestamp": "03:12:26", "text": "[音楽]"}, {"type": "subtitle", "time": 11549.51, "timestamp": "03:12:29", "text": "画面をぼかしておいてよかった。"}, {"type": "subtitle", "time": 11553.99, "timestamp": "03:12:33", "text": "隠れる必要があったんです"}, {"type": "subtitle", "time": 11556.33, "timestamp": "03:12:36", "text": "いくつか"}, {"type": "subtitle", "time": 11558.07, "timestamp": "03:12:38", "text": "[音楽]"}, {"type": "subtitle", "time": 11562.309, "timestamp": "03:12:42", "text": "Amazonのやつからですよね？だから私は"}, {"type": "subtitle", "time": 11563.72, "timestamp": "03:12:43", "text": "甘やかしてはいけない。"}, {"type": "subtitle", "time": 11565.75, "timestamp": "03:12:45", "text": "[音楽]"}, {"type": "subtitle", "time": 11567.83, "timestamp": "03:12:47", "text": "なぜ？よし、これで十分だろう。"}, {"type": "subtitle", "time": 11570.23, "timestamp": "03:12:50", "text": "右？えっと"}, {"type": "subtitle", "time": 11571.75, "timestamp": "03:12:51", "text": "あなたは彼に何を与えているのですか？私はしません"}, {"type": "subtitle", "time": 11573.349, "timestamp": "03:12:53", "text": "知る。私は自分が何を与えているのか分からない。私"}, {"type": "subtitle", "time": 11577.83, "timestamp": "03:12:57", "text": "彼らにキャンディーとかをあげたんだ。それで"}]
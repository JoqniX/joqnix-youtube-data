[{"type": "subtitle", "time": 7320.709, "timestamp": "02:02:00", "text": "ええと、わかりました。そうします"}, {"type": "subtitle", "time": 7334.31, "timestamp": "02:02:14", "text": "そう、贅沢だね。"}, {"type": "subtitle", "time": 7337.27, "timestamp": "02:02:17", "text": "スリランカって書いてあるけど。そうそう。そして"}, {"type": "subtitle", "time": 7341.51, "timestamp": "02:02:21", "text": "ああ、贅沢というものはかつて存在したのだ。忘れた。"}, {"type": "subtitle", "time": 7344.87, "timestamp": "02:02:24", "text": "インドの島か"}, {"type": "subtitle", "time": 7352.629, "timestamp": "02:02:32", "text": "スーラ"}, {"type": "subtitle", "time": 7355.43, "timestamp": "02:02:35", "text": "P"}, {"type": "subtitle", "time": 7358.47, "timestamp": "02:02:38", "text": "形成は本土から広がり、"}, {"type": "subtitle", "time": 7361.43, "timestamp": "02:02:41", "text": "土地に繋がっている"}, {"type": "subtitle", "time": 7365.27, "timestamp": "02:02:45", "text": "各大陸に片方の側が存在する。私はただ"}, {"type": "subtitle", "time": 7367.91, "timestamp": "02:02:47", "text": "アラビア半島だった。"}, {"type": "subtitle", "time": 7379.109, "timestamp": "02:02:59", "text": "わかった。インドは"}]
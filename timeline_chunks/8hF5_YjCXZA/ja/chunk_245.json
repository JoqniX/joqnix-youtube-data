[{"type": "subtitle", "time": 14700.63, "timestamp": "04:05:00", "text": "所有権なので、そのままにしておきました"}, {"type": "subtitle", "time": 14703.59, "timestamp": "04:05:03", "text": "そして諦めた。そして君たちは私に電話をかけてきた"}, {"type": "subtitle", "time": 14705.67, "timestamp": "04:05:05", "text": "私に、"}, {"type": "subtitle", "time": 14708.229, "timestamp": "04:05:08", "text": "仕事も何もかも。準備できました"}, {"type": "subtitle", "time": 14711.83, "timestamp": "04:05:11", "text": "Razer Payを見たとき"}, {"type": "subtitle", "time": 14713.83, "timestamp": "04:05:13", "text": "許可していない"}, {"type": "subtitle", "time": 14716.469, "timestamp": "04:05:16", "text": "ええと、今のところ太陽光発電の所有権"}, {"type": "subtitle", "time": 14720.07, "timestamp": "04:05:20", "text": "彼らは非公開で、LLCを優先し、"}, {"type": "subtitle", "time": 14722.63, "timestamp": "04:05:22", "text": "すべて。だから私はその場所で諦めた"}, {"type": "subtitle", "time": 14725.269, "timestamp": "04:05:25", "text": "なぜなら私はそれをLLCに変えたくないから"}, {"type": "subtitle", "time": 14728.95, "timestamp": "04:05:28", "text": "その瞬間。えっと、それから君たち"}, {"type": "subtitle", "time": 14732.63, "timestamp": "04:05:32", "text": "今電話してくれて、希望を与えてくれて、"}, {"type": "subtitle", "time": 14734.55, "timestamp": "04:05:34", "text": "何でもまだ手に入れることができる"}, {"type": "subtitle", "time": 14737.269, "timestamp": "04:05:37", "text": "ランニングとか、その他いろいろ。うん、それ"}, {"type": "subtitle", "time": 14739.429, "timestamp": "04:05:39", "text": "だからこそ、私はそれを解決しようと努力するつもりです。"}, {"type": "subtitle", "time": 14753.59, "timestamp": "04:05:53", "text": "うん。"}]
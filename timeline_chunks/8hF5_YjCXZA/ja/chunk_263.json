[{"type": "subtitle", "time": 15782.469, "timestamp": "04:23:02", "text": "企業があなたの"}, {"type": "subtitle", "time": 15785.349, "timestamp": "04:23:05", "text": "これは何ですか？わからない。"}, {"type": "subtitle", "time": 15788.55, "timestamp": "04:23:08", "text": "彼らが何を望んでいるのか、私には分かりません。私はただ"}, {"type": "subtitle", "time": 15790.79, "timestamp": "04:23:10", "text": "想定"}, {"type": "subtitle", "time": 15792.389, "timestamp": "04:23:12", "text": "痛み。"}, {"type": "subtitle", "time": 15795.11, "timestamp": "04:23:15", "text": "ああ、父が知ったら私を殺すだろう"}, {"type": "subtitle", "time": 15798.149, "timestamp": "04:23:18", "text": "私がこれからやろうとしていたこと。"}, {"type": "subtitle", "time": 15801.349, "timestamp": "04:23:21", "text": "彼は人に尋ねるのが好きなタイプで、"}, {"type": "subtitle", "time": 15803.83, "timestamp": "04:23:23", "text": "最終決定後にはすべてを知っていて"}, {"type": "subtitle", "time": 15806.55, "timestamp": "04:23:26", "text": "それが正真正銘の正真正銘のものであると納得させる"}, {"type": "subtitle", "time": 15809.189, "timestamp": "04:23:29", "text": "そうすれば彼はそれを実行するだろう。彼はそうしない"}, {"type": "subtitle", "time": 15811.91, "timestamp": "04:23:31", "text": "オンラインを信頼するか、他の見知らぬ人はどう思うか"}, {"type": "subtitle", "time": 15813.59, "timestamp": "04:23:33", "text": "言う。"}, {"type": "subtitle", "time": 15817.349, "timestamp": "04:23:37", "text": "ああ、私も彼みたいになりたい。"}, {"type": "subtitle", "time": 15837.349, "timestamp": "04:23:57", "text": "ああ、痛い。"}, {"type": "subtitle", "time": 15839.349, "timestamp": "04:23:59", "text": "そして私が心配していることの一つは、"}]
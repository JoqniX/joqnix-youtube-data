[{"type": "subtitle", "time": 11641.03, "timestamp": "03:14:01", "text": "安いマウスを買うようなものだけど、"}, {"type": "subtitle", "time": 11644.229, "timestamp": "03:14:04", "text": "このことでレイザーは"}, {"type": "subtitle", "time": 11646.79, "timestamp": "03:14:06", "text": "メカニカルマウススイッチ第2世代"}, {"type": "subtitle", "time": 11649.51, "timestamp": "03:14:09", "text": "つまり、ダブルクリックは発生せず、"}, {"type": "subtitle", "time": 11652.55, "timestamp": "03:14:12", "text": "私のマウスの現在の問題は"}, {"type": "subtitle", "time": 11654.469, "timestamp": "03:14:14", "text": "ダブルクリックが発生していて、"}, {"type": "subtitle", "time": 11657.75, "timestamp": "03:14:17", "text": "もの。だからワイヤレスがいいと思ったんです"}, {"type": "subtitle", "time": 11660.71, "timestamp": "03:14:20", "text": "良くなるだろう。いいえ、"}, {"type": "subtitle", "time": 11663.51, "timestamp": "03:14:23", "text": "バッテリーとか色々入れなきゃ。 AAA"}, {"type": "subtitle", "time": 11665.51, "timestamp": "03:14:25", "text": "バッテリー。"}, {"type": "subtitle", "time": 11667.19, "timestamp": "03:14:27", "text": "ニース。"}, {"type": "subtitle", "time": 11671.269, "timestamp": "03:14:31", "text": "ええ、これらは私が買ったものです"}, {"type": "subtitle", "time": 11673.99, "timestamp": "03:14:33", "text": "そして、木曜日までには手に入れるつもりです。"}, {"type": "subtitle", "time": 11676.55, "timestamp": "03:14:36", "text": "水曜日。"}, {"type": "subtitle", "time": 11679.67, "timestamp": "03:14:39", "text": "支払い済み。私の銀行口座は空っぽになりそうだ。"}, {"type": "subtitle", "time": 11683.03, "timestamp": "03:14:43", "text": "あなたは本当に私だけを持っている"}, {"type": "subtitle", "time": 11686.309, "timestamp": "03:14:46", "text": "残り4000くらいです。だから、私はそうではない"}, {"type": "subtitle", "time": 11690.63, "timestamp": "03:14:50", "text": "完全に使い切るべきだ"}, {"type": "subtitle", "time": 11693.91, "timestamp": "03:14:53", "text": "だって、今月を生き延びなきゃいけないんだもん。"}, {"type": "subtitle", "time": 11695.99, "timestamp": "03:14:55", "text": "えっと"}, {"type": "subtitle", "time": 11699.67, "timestamp": "03:14:59", "text": "でも、もう6000ドルくらい使って"}]
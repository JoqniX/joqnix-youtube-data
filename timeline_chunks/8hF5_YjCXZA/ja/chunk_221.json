[{"type": "subtitle", "time": 13260.95, "timestamp": "03:41:00", "text": "そして、そのプロセスを手伝ってくれる？それで"}, {"type": "subtitle", "time": 13262.469, "timestamp": "03:41:02", "text": "私は彼らに何をすべきかを指示できます"}, {"type": "subtitle", "time": 13265.269, "timestamp": "03:41:05", "text": "すべて。私は全く知りません"}, {"type": "subtitle", "time": 13269.429, "timestamp": "03:41:09", "text": "これらのビジネス関連の事柄すべて。うん。そして私は"}, {"type": "subtitle", "time": 13272.71, "timestamp": "03:41:12", "text": "私の2000ドルを無駄にしたくない。"}, {"type": "subtitle", "time": 13274.95, "timestamp": "03:41:14", "text": "わかった。私は彼らに千ドル支払います"}, {"type": "subtitle", "time": 13278.389, "timestamp": "03:41:18", "text": "後で。今、経済的に苦しい状況に陥っています。"}, {"type": "subtitle", "time": 13281.83, "timestamp": "03:41:21", "text": "両親にも頼めないんです。ええ、そうですね"}, {"type": "subtitle", "time": 13284.309, "timestamp": "03:41:24", "text": "そして、あなたたちにも同じことを頼むことはできません。いいえ"}, {"type": "subtitle", "time": 13286.15, "timestamp": "03:41:26", "text": "皆さんが与えるものは何でも"}, {"type": "subtitle", "time": 13289.349, "timestamp": "03:41:29", "text": "モデル以外には何もありません。他には何もありません。"}, {"type": "subtitle", "time": 13291.349, "timestamp": "03:41:31", "text": "うん。"}, {"type": "subtitle", "time": 13295.269, "timestamp": "03:41:35", "text": "これは私個人の作品です。それで"}, {"type": "subtitle", "time": 13298.87, "timestamp": "03:41:38", "text": "ああ、私が対処します。心配しないで。だから私は"}, {"type": "subtitle", "time": 13300.87, "timestamp": "03:41:40", "text": "良いことだと思うよね？えっと、私たちは"}, {"type": "subtitle", "time": 13303.59, "timestamp": "03:41:43", "text": "独自のUPIのようなものを手に入れて"}, {"type": "subtitle", "time": 13306.309, "timestamp": "03:41:46", "text": "すべて、そしてあなたは、私は得られないでしょう、私は得られないでしょう"}, {"type": "subtitle", "time": 13309.51, "timestamp": "03:41:49", "text": "もう個人情報を晒されることはない、文字通り"}, {"type": "subtitle", "time": 13312.63, "timestamp": "03:41:52", "text": "権利が保護され、それが良いものであれば"}, {"type": "subtitle", "time": 13314.309, "timestamp": "03:41:54", "text": "手続きやその他全てが合法であれば"}, {"type": "subtitle", "time": 13316.07, "timestamp": "03:41:56", "text": "そして、私がお勧めできる良いものすべて"}, {"type": "subtitle", "time": 13319.03, "timestamp": "03:41:59", "text": "他のユーチューバーも、もしできるなら"}]
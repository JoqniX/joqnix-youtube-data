[{"type": "subtitle", "time": 1385.029, "timestamp": "00:23:05", "text": "寄付をする人は"}, {"type": "subtitle", "time": 1388.07, "timestamp": "00:23:08", "text": "1時間"}, {"type": "subtitle", "time": 1391.83, "timestamp": "00:23:11", "text": "1～2時間、または健康的な"}, {"type": "subtitle", "time": 1398.71, "timestamp": "00:23:18", "text": "ええ、それは私の意見では実際には良いことです。"}, {"type": "subtitle", "time": 1401.75, "timestamp": "00:23:21", "text": "それは良いことです。そっちの方が健康的だ。"}, {"type": "subtitle", "time": 1403.909, "timestamp": "00:23:23", "text": "あなたは私と同じようにする必要はありません。私"}, {"type": "subtitle", "time": 1405.99, "timestamp": "00:23:25", "text": "1週間だけやってみて様子を見ようと思っただけ"}, {"type": "subtitle", "time": 1408.63, "timestamp": "00:23:28", "text": "どうなることやら。もちろん、その後"}, {"type": "subtitle", "time": 1413.11, "timestamp": "00:23:33", "text": "影響は大きすぎるだろうけど、まあね。"}, {"type": "subtitle", "time": 1415.43, "timestamp": "00:23:35", "text": "だから、"}, {"type": "subtitle", "time": 1419.11, "timestamp": "00:23:39", "text": "正直に言うと、"}, {"type": "subtitle", "time": 1423.27, "timestamp": "00:23:43", "text": "むしろ、ずっとやりたかったんです"}, {"type": "subtitle", "time": 1426.07, "timestamp": "00:23:46", "text": "Twitchの配信者がやっているようにね。あなた"}, {"type": "subtitle", "time": 1429.27, "timestamp": "00:23:49", "text": "彼らがストリーミングを続けていることを知っているし"}, {"type": "subtitle", "time": 1433.029, "timestamp": "00:23:53", "text": "ストリーミング、ストリーミング、ストリーミング"}, {"type": "subtitle", "time": 1437.35, "timestamp": "00:23:57", "text": "そしてストリーミングとストリーミング"}]
[{"type": "subtitle", "time": 6903.75, "timestamp": "01:55:03", "text": "私の家。えっと、それで私はこう思ったんです"}, {"type": "subtitle", "time": 6923.669, "timestamp": "01:55:23", "text": "プドゥチェルの首都はどこですか？何ですか"}, {"type": "subtitle", "time": 6925.589, "timestamp": "01:55:25", "text": "プドゥチャー？"}, {"type": "subtitle", "time": 6927.91, "timestamp": "01:55:27", "text": "待てよ、それは州の名前だ。待って、それは"}, {"type": "subtitle", "time": 6937.75, "timestamp": "01:55:37", "text": "チェリー"}, {"type": "subtitle", "time": 6955.91, "timestamp": "01:55:55", "text": "ああ、実は私はICSの学生なんです。"}, {"type": "subtitle", "time": 6958.149, "timestamp": "01:55:58", "text": "なぜ私が引っ越さなければならなかったと思うのですか"}]
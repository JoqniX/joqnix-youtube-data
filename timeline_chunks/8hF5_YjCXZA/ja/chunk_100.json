[{"type": "subtitle", "time": 6002.07, "timestamp": "01:40:02", "text": "そんな感じの、そんな感じの、それは"}, {"type": "subtitle", "time": 6005.27, "timestamp": "01:40:05", "text": "マイルストーンのように、"}, {"type": "subtitle", "time": 6007.83, "timestamp": "01:40:07", "text": "例えば、ジョアトンの件を取り上げると、"}, {"type": "subtitle", "time": 6010.79, "timestamp": "01:40:10", "text": "私たちの究極の目標は何ですか？ 2,000ドル"}, {"type": "subtitle", "time": 6014.47, "timestamp": "01:40:14", "text": "右？ 2,000ドルで、私は好きになれません"}, {"type": "subtitle", "time": 6017.03, "timestamp": "01:40:17", "text": "ただ飛び上がって「1000ドル必要です」と言えばいい。"}, {"type": "subtitle", "time": 6021.03, "timestamp": "01:40:21", "text": "いや、いや。私たちは小さなことから始めなければならない"}, {"type": "subtitle", "time": 6024.95, "timestamp": "01:40:24", "text": "目標の増分とかそういうの"}, {"type": "subtitle", "time": 6027.83, "timestamp": "01:40:27", "text": "少しずつ全てを完成させる"}, {"type": "subtitle", "time": 6031.27, "timestamp": "01:40:31", "text": "最終目標に到達するまで。右？のように"}, {"type": "subtitle", "time": 6032.95, "timestamp": "01:40:32", "text": "それ。"}, {"type": "subtitle", "time": 6036.79, "timestamp": "01:40:36", "text": "私ならそう言うでしょう。"}, {"type": "subtitle", "time": 6040.31, "timestamp": "01:40:40", "text": "うん。こんにちは。いらっしゃいませ。いらっしゃいませ。いらっしゃいませ"}, {"type": "subtitle", "time": 6042.55, "timestamp": "01:40:42", "text": "小川へ。"}, {"type": "subtitle", "time": 6055.91, "timestamp": "01:40:55", "text": "こんにちは。さて、これをスキップする方法を見てみましょう"}, {"type": "subtitle", "time": 6059.43, "timestamp": "01:40:59", "text": "質問があった場合、または私がそれに答えた場合に「いいね」をお願いします。いいえ。"}]
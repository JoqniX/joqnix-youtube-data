[{"type": "subtitle", "time": 17707.67, "timestamp": "04:55:07", "text": "えーと、えーと、両親は、私にそうしないように言った"}, {"type": "subtitle", "time": 17714.55, "timestamp": "04:55:14", "text": "うん。"}, {"type": "subtitle", "time": 17721.51, "timestamp": "04:55:21", "text": "わかった。"}, {"type": "subtitle", "time": 17727.11, "timestamp": "04:55:27", "text": "私は謝らなかった。私は謝らなかった。"}, {"type": "subtitle", "time": 17730.47, "timestamp": "04:55:30", "text": "私は謝ってないよ、みんな。私は言っていません"}, {"type": "subtitle", "time": 17731.99, "timestamp": "04:55:31", "text": "ごめん。"}, {"type": "subtitle", "time": 17742.15, "timestamp": "04:55:42", "text": "今。彼らは私を"}, {"type": "subtitle", "time": 17744.788, "timestamp": "04:55:44", "text": "甘やかされたわがままな子供か何か悪いことか、子供か"}, {"type": "subtitle", "time": 17747.51, "timestamp": "04:55:47", "text": "何か。決定を下すことができません"}, {"type": "subtitle", "time": 17754.948, "timestamp": "04:55:54", "text": "しかし、彼らにも責任がある。それは彼らの"}, {"type": "subtitle", "time": 17758.948, "timestamp": "04:55:58", "text": "せっかちすぎて質問したのが悪い"}]
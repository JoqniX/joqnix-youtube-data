[{"type": "subtitle", "time": 8700.71, "timestamp": "02:25:00", "text": "島への旅行はいかがですか？"}, {"type": "subtitle", "time": 8702.87, "timestamp": "02:25:02", "text": "おじいちゃんはいつもそこに行くのが大好きだった。"}, {"type": "subtitle", "time": 8704.71, "timestamp": "02:25:04", "text": "わかった。一体外の世界には何があるのか​​？良い、"}, {"type": "subtitle", "time": 8706.15, "timestamp": "02:25:06", "text": "たくさんの魚が釣れます"}, {"type": "subtitle", "time": 8707.99, "timestamp": "02:25:07", "text": "少しでも。"}, {"type": "subtitle", "time": 8711.91, "timestamp": "02:25:11", "text": "いつご飯食べるの？えーと、えーと"}, {"type": "subtitle", "time": 8714.55, "timestamp": "02:25:14", "text": "1:00"}, {"type": "subtitle", "time": 8717.67, "timestamp": "02:25:17", "text": "商品が届くのを待ちます。えっと、"}, {"type": "subtitle", "time": 8721.19, "timestamp": "02:25:21", "text": "妖精男。ジュラ島へようこそ。"}, {"type": "subtitle", "time": 8722.79, "timestamp": "02:25:22", "text": "小さな事件でよかったですね"}, {"type": "subtitle", "time": 8725.75, "timestamp": "02:25:25", "text": "横断。通常はもっとずっと"}, {"type": "subtitle", "time": 8732.63, "timestamp": "02:25:32", "text": "えっと、"}, {"type": "subtitle", "time": 8735.11, "timestamp": "02:25:35", "text": "とにかく、あなたはまだ見ていないと言いました"}, {"type": "subtitle", "time": 8738.87, "timestamp": "02:25:38", "text": "祖父の旧友。"}, {"type": "subtitle", "time": 8741.83, "timestamp": "02:25:41", "text": "私は生物学の単位を取得するためにここに来ました。"}, {"type": "subtitle", "time": 8743.91, "timestamp": "02:25:43", "text": "わからない"}, {"type": "subtitle", "time": 8746.389, "timestamp": "02:25:46", "text": "はい、その島です。湖の。それは"}, {"type": "subtitle", "time": 8749.51, "timestamp": "02:25:49", "text": "の 1 つ"}, {"type": "subtitle", "time": 8751.91, "timestamp": "02:25:51", "text": "探検する"}, {"type": "subtitle", "time": 8754.71, "timestamp": "02:25:54", "text": "私はここにいます。わかった。"}]
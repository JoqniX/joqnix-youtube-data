[{"type": "subtitle", "time": 14227.99, "timestamp": "03:57:07", "text": "でも、考えてみて、とも言える"}, {"type": "subtitle", "time": 14230.15, "timestamp": "03:57:10", "text": "私も同じ気持ちです。例えば私があなたに支払うと"}, {"type": "subtitle", "time": 14232.63, "timestamp": "03:57:12", "text": "2,000、そして私が受け取らないとしましょう"}, {"type": "subtitle", "time": 14234.79, "timestamp": "03:57:14", "text": "何でも、それでもあなたは"}]
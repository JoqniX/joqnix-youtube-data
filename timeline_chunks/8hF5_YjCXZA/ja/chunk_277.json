[{"type": "subtitle", "time": 16621.51, "timestamp": "04:37:01", "text": "ああ、この人たち、残り15分。"}, {"type": "subtitle", "time": 16625.51, "timestamp": "04:37:05", "text": "彼らが私に電話してくるでしょう。えっと"}, {"type": "subtitle", "time": 16649.51, "timestamp": "04:37:29", "text": "[音楽]"}, {"type": "subtitle", "time": 16652.15, "timestamp": "04:37:32", "text": "えっと、３つになる予定です。"}, {"type": "subtitle", "time": 16654.789, "timestamp": "04:37:34", "text": "2時半になるだろう。"}, {"type": "subtitle", "time": 16658.07, "timestamp": "04:37:38", "text": "私たちは一日中何をして過ごしたの？私たちはそうしなかった"}, {"type": "subtitle", "time": 16661.189, "timestamp": "04:37:41", "text": "ゲームをたくさんするよね？"}, {"type": "subtitle", "time": 16663.429, "timestamp": "04:37:43", "text": "昨日のものはアクションゲームで、"}, {"type": "subtitle", "time": 16665.349, "timestamp": "04:37:45", "text": "実は。"}, {"type": "subtitle", "time": 16669.429, "timestamp": "04:37:49", "text": "しかし、それはホラーゲームだと聞いていました。"}, {"type": "subtitle", "time": 16671.269, "timestamp": "04:37:51", "text": "しかし、それはアクションゲームだった。大丈夫。する"}, {"type": "subtitle", "time": 16673.67, "timestamp": "04:37:53", "text": "心配しないでください。私はまだホラーをやる"}, {"type": "subtitle", "time": 16675.67, "timestamp": "04:37:55", "text": "ゲーム配信。心配しないで。私はそれでも"}]
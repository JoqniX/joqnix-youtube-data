[{"type": "subtitle", "time": 11340.469, "timestamp": "03:09:00", "text": "2セット、つまり、2つの異なる"}, {"type": "subtitle", "time": 11343.59, "timestamp": "03:09:03", "text": "両方の種類を買いました"}, {"type": "subtitle", "time": 11346.87, "timestamp": "03:09:06", "text": "ワイヤレス設定。だからもうこんな馬鹿げたことはしない"}, {"type": "subtitle", "time": 11350.63, "timestamp": "03:09:10", "text": "ダムワイヤーみたいなもの。文字通り"}, {"type": "subtitle", "time": 11352.63, "timestamp": "03:09:12", "text": "回り込む"}, {"type": "subtitle", "time": 11354.87, "timestamp": "03:09:14", "text": "えっと、新しいパイロットプランの話だったんだけど。"}, {"type": "subtitle", "time": 11357.91, "timestamp": "03:09:17", "text": "しかし、それについては。うん。問題は私が"}, {"type": "subtitle", "time": 11360.95, "timestamp": "03:09:20", "text": "急いで出て行こうとして、急いでいるような感じ"}, {"type": "subtitle", "time": 11363.83, "timestamp": "03:09:23", "text": "だって私の父は注文しなかったから"}, {"type": "subtitle", "time": 11366.389, "timestamp": "03:09:26", "text": "彼は疲れていたようだった"}, {"type": "subtitle", "time": 11368.63, "timestamp": "03:09:28", "text": "旅行。わかった。"}, {"type": "subtitle", "time": 11371.67, "timestamp": "03:09:31", "text": "彼は帰路で本当に疲れていた"}, {"type": "subtitle", "time": 11374.55, "timestamp": "03:09:34", "text": "自宅から"}, {"type": "subtitle", "time": 11377.51, "timestamp": "03:09:37", "text": "でも、ちょっと遠いんです。それで彼は戻ってきた"}, {"type": "subtitle", "time": 11379.59, "timestamp": "03:09:39", "text": "電車から。彼はとても疲れていた。私はこう思った"}, {"type": "subtitle", "time": 11382.309, "timestamp": "03:09:42", "text": "彼に私を放っておいてほしいと頼むのは気が引けた"}, {"type": "subtitle", "time": 11385.75, "timestamp": "03:09:45", "text": "新しい場所へ出発します。だから何"}, {"type": "subtitle", "time": 11388.309, "timestamp": "03:09:48", "text": "私がしたことは、彼に、もしよろしければ"}, {"type": "subtitle", "time": 11391.349, "timestamp": "03:09:51", "text": "Uberを呼ぶとか、そういう感じ。それから私は"}, {"type": "subtitle", "time": 11394.469, "timestamp": "03:09:54", "text": "注文したのですが、遅れてしまいました。"}, {"type": "subtitle", "time": 11397.83, "timestamp": "03:09:57", "text": "荷物がいっぱいで、薬を忘れてしまいました。しかし"}]
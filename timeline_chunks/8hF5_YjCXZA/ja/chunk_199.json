[{"type": "subtitle", "time": 11945.91, "timestamp": "03:19:05", "text": "彼女に餌をあげたいのですが、"}, {"type": "subtitle", "time": 11947.59, "timestamp": "03:19:07", "text": "許可されていません。そこには何もありませんでした。なぜ"}, {"type": "subtitle", "time": 11951.03, "timestamp": "03:19:11", "text": "許可されていないのですか？"}, {"type": "subtitle", "time": 11953.73, "timestamp": "03:19:13", "text": "なぜ許可されないのですか？"}, {"type": "subtitle", "time": 11956.55, "timestamp": "03:19:16", "text": "[音楽]"}, {"type": "subtitle", "time": 11960.54, "timestamp": "03:19:20", "text": "わかった。はい、私は"}, {"type": "subtitle", "time": 11963.269, "timestamp": "03:19:23", "text": "[音楽]"}, {"type": "subtitle", "time": 11965.03, "timestamp": "03:19:25", "text": "えーと"}, {"type": "subtitle", "time": 11969.99, "timestamp": "03:19:29", "text": "マイアカウントにアクセスしてください。何てことだ。"}, {"type": "subtitle", "time": 11972.87, "timestamp": "03:19:32", "text": "わかった、"}, {"type": "subtitle", "time": 11975.03, "timestamp": "03:19:35", "text": "えっと"}, {"type": "subtitle", "time": 11977.67, "timestamp": "03:19:37", "text": "彼はどこにいますか？"}, {"type": "subtitle", "time": 11980.63, "timestamp": "03:19:40", "text": "これです。"}, {"type": "subtitle", "time": 11982.95, "timestamp": "03:19:42", "text": "いいえ、それは彼が最近フォローした人でした。"}, {"type": "subtitle", "time": 11985.11, "timestamp": "03:19:45", "text": "右？"}, {"type": "subtitle", "time": 11988.309, "timestamp": "03:19:48", "text": "ちょっと待って。フォローする。"}, {"type": "subtitle", "time": 11991.349, "timestamp": "03:19:51", "text": "ああ神様、どうすればああ神様を見つけられるのでしょうか。どこ"}, {"type": "subtitle", "time": 11992.95, "timestamp": "03:19:52", "text": "は"}, {"type": "subtitle", "time": 11997.4, "timestamp": "03:19:57", "text": "聖なる主よ？どこ？どうすれば見つけられますか"}, {"type": "subtitle", "time": 11999.269, "timestamp": "03:19:59", "text": "[音楽]"}]
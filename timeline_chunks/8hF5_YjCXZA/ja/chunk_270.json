[{"type": "subtitle", "time": 16217.59, "timestamp": "04:30:17", "text": "[音楽]"}, {"type": "subtitle", "time": 16220.07, "timestamp": "04:30:20", "text": "問題は、私がいつも疑問に思うのは、"}, {"type": "subtitle", "time": 16222.469, "timestamp": "04:30:22", "text": "商人や企業、そして競争ではない"}, {"type": "subtitle", "time": 16224.63, "timestamp": "04:30:24", "text": "文字通り小さな店のような企業"}, {"type": "subtitle", "time": 16228.469, "timestamp": "04:30:28", "text": "彼らのUPIは文字通り商標登録されている"}, {"type": "subtitle", "time": 16232.309, "timestamp": "04:30:32", "text": "または、事業として登録されている。"}, {"type": "subtitle", "time": 16234.309, "timestamp": "04:30:34", "text": "だから私は文字通り"}, {"type": "subtitle", "time": 16242.07, "timestamp": "04:30:42", "text": "しかし、私が商標を登録する場合、"}, {"type": "subtitle", "time": 16244.389, "timestamp": "04:30:44", "text": "商標とは、店舗や事業などのことです。いいえ、"}, {"type": "subtitle", "time": 16246.63, "timestamp": "04:30:46", "text": "そうでなければならない"}, {"type": "subtitle", "time": 16253.67, "timestamp": "04:30:53", "text": "お店でなければならない"}, {"type": "subtitle", "time": 16256.87, "timestamp": "04:30:56", "text": "Shopjixとかで買い物すればいいんじゃない？または"}]
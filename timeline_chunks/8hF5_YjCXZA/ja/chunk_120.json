[{"type": "subtitle", "time": 7220.709, "timestamp": "02:00:20", "text": "私がそんなこと知っているとでも思っているの？私は自分が何だったか忘れてしまった"}, {"type": "subtitle", "time": 7223.27, "timestamp": "02:00:23", "text": "研究した。"}, {"type": "subtitle", "time": 7226.31, "timestamp": "02:00:26", "text": "私はただ勉強しなければならないと思った"}, {"type": "subtitle", "time": 7228.39, "timestamp": "02:00:28", "text": "テスト。これを覚えておく必要はない。それで"}, {"type": "subtitle", "time": 7231.75, "timestamp": "02:00:31", "text": "私は自分の"}, {"type": "subtitle", "time": 7238.629, "timestamp": "02:00:38", "text": "すべての化学式、化学、ええと"}, {"type": "subtitle", "time": 7241.75, "timestamp": "02:00:41", "text": "物理学、政治学、経済学、すべて"}, {"type": "subtitle", "time": 7243.75, "timestamp": "02:00:43", "text": "私は勉強しました。"}, {"type": "subtitle", "time": 7249.109, "timestamp": "02:00:49", "text": "[音楽]"}]
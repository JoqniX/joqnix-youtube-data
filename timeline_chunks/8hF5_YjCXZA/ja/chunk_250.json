[{"type": "subtitle", "time": 15008.95, "timestamp": "04:10:08", "text": "しかし、彼らはあなたに"}, {"type": "subtitle", "time": 15010.229, "timestamp": "04:10:10", "text": "企業はそうするので"}, {"type": "subtitle", "time": 15011.83, "timestamp": "04:10:11", "text": "彼らにインスピレーションを与え、ただ歌わせる。おお"}, {"type": "subtitle", "time": 15018.389, "timestamp": "04:10:18", "text": "しかし、状況は同じです"}, {"type": "subtitle", "time": 15021.349, "timestamp": "04:10:21", "text": "私の音楽関係で起こったことです。"}, {"type": "subtitle", "time": 15024.71, "timestamp": "04:10:24", "text": "私が何をしたか知ってる？私は、私は"}, {"type": "subtitle", "time": 15027.189, "timestamp": "04:10:27", "text": "家族に懇願して、これは"}, {"type": "subtitle", "time": 15029.51, "timestamp": "04:10:29", "text": "良いことだ。しかし彼らは、"}, {"type": "subtitle", "time": 15031.349, "timestamp": "04:10:31", "text": "座席数に限りがあります"}, {"type": "subtitle", "time": 15039.91, "timestamp": "04:10:39", "text": "もし私が"}, {"type": "subtitle", "time": 15044.229, "timestamp": "04:10:44", "text": "銀行のやつ。 1秒。 1秒。"}, {"type": "subtitle", "time": 15051.91, "timestamp": "04:10:51", "text": "彼らは文字通り、もし私たちが"}, {"type": "subtitle", "time": 15054.389, "timestamp": "04:10:54", "text": "文字通り通話を切断したい"}, {"type": "subtitle", "time": 15059.189, "timestamp": "04:10:59", "text": "そして、あなぜ"}]
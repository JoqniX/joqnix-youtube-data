[{"type": "subtitle", "time": 6841.669, "timestamp": "01:54:01", "text": "私の"}, {"type": "subtitle", "time": 6843.51, "timestamp": "01:54:03", "text": "私はあの二人が"}, {"type": "subtitle", "time": 6850.55, "timestamp": "01:54:10", "text": "[音楽]"}, {"type": "subtitle", "time": 6864.229, "timestamp": "01:54:24", "text": "えっと、リンクを送りますね。わかった。"}, {"type": "subtitle", "time": 6865.99, "timestamp": "01:54:25", "text": "オーストラリアであなたから好意を得るには"}, {"type": "subtitle", "time": 6868.31, "timestamp": "01:54:28", "text": "チャットも同様です。"}, {"type": "subtitle", "time": 6871.109, "timestamp": "01:54:31", "text": "いいえ、バンガロールは"}, {"type": "subtitle", "time": 6876.39, "timestamp": "01:54:36", "text": "私はバンガロールに行ったことを知っています。"}, {"type": "subtitle", "time": 6878.229, "timestamp": "01:54:38", "text": "教員免許に伝えます。誰が言ったのか"}, {"type": "subtitle", "time": 6881.109, "timestamp": "01:54:41", "text": "あなたは地理学ですか？"}, {"type": "subtitle", "time": 6883.99, "timestamp": "01:54:43", "text": "実は、私は地理の先生に会ったんです"}, {"type": "subtitle", "time": 6888.79, "timestamp": "01:54:48", "text": "私のハイな再会のように"}, {"type": "subtitle", "time": 6892.31, "timestamp": "01:54:52", "text": "いや、彼女はICシルバーから来たんだ"}, {"type": "subtitle", "time": 6895.109, "timestamp": "01:54:55", "text": "学校。彼女は今CBで教えている"}, {"type": "subtitle", "time": 6897.43, "timestamp": "01:54:57", "text": "ここの州立学校は文字通り目の前にあります"}]
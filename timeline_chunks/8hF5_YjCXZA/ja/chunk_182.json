[{"type": "subtitle", "time": 10922.469, "timestamp": "03:02:02", "text": "ああ、もし私が電源を切ったらどうなるんだろう。"}, {"type": "subtitle", "time": 10925.349, "timestamp": "03:02:05", "text": "怪しいぞ。"}, {"type": "subtitle", "time": 10927.75, "timestamp": "03:02:07", "text": "それが釣りだ。"}, {"type": "subtitle", "time": 10929.99, "timestamp": "03:02:09", "text": "もしスマホのカメラを"}, {"type": "subtitle", "time": 10931.59, "timestamp": "03:02:11", "text": "そこには？"}, {"type": "subtitle", "time": 10933.67, "timestamp": "03:02:13", "text": "文字通り、"}, {"type": "subtitle", "time": 10936.98, "timestamp": "03:02:16", "text": "私の携帯電話のバッテリーが切れそうです。"}, {"type": "subtitle", "time": 10939.75, "timestamp": "03:02:19", "text": "[音楽]"}, {"type": "subtitle", "time": 10942.79, "timestamp": "03:02:22", "text": "私はそうすべきでしょうか、できるかどうかわかりません"}, {"type": "subtitle", "time": 10946.0, "timestamp": "03:02:26", "text": "実際、このままにしておいてください。"}, {"type": "subtitle", "time": 10948.15, "timestamp": "03:02:28", "text": "[音楽]"}, {"type": "subtitle", "time": 10950.79, "timestamp": "03:02:30", "text": "でもね、"}, {"type": "subtitle", "time": 10954.23, "timestamp": "03:02:34", "text": "想像する。ああ、これはとても危険だよ。"}, {"type": "subtitle", "time": 10957.91, "timestamp": "03:02:37", "text": "これはウルトロンにとって危険な行為だ。"}, {"type": "subtitle", "time": 10961.349, "timestamp": "03:02:41", "text": "それでも、私はそれをやっている。"}, {"type": "subtitle", "time": 10964.87, "timestamp": "03:02:44", "text": "私は今もそれを続けています。"}, {"type": "subtitle", "time": 10966.71, "timestamp": "03:02:46", "text": "全て"}, {"type": "subtitle", "time": 10969.269, "timestamp": "03:02:49", "text": "もしそれが私の姿を映し出したらどうなるか想像してみて。"}, {"type": "subtitle", "time": 10971.269, "timestamp": "03:02:51", "text": "泣いちゃう。"}, {"type": "subtitle", "time": 10976.15, "timestamp": "03:02:56", "text": "私は泣くでしょう"}, {"type": "subtitle", "time": 10978.67, "timestamp": "03:02:58", "text": "当然。泣いちゃう。"}]
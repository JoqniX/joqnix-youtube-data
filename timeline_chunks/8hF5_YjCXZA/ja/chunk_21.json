[{"type": "subtitle", "time": 1263.99, "timestamp": "00:21:03", "text": "待って。しかし、"}, {"type": "subtitle", "time": 1268.23, "timestamp": "00:21:08", "text": "ええと、イベントなど"}, {"type": "subtitle", "time": 1271.11, "timestamp": "00:21:11", "text": "どうすればいいですか？付け加えるべきでしょうか"}, {"type": "subtitle", "time": 1292.95, "timestamp": "00:21:32", "text": "そして、もしあなたがそうなら。ウー・ハラス氏はどのように尋ねたか"}, {"type": "subtitle", "time": 1295.669, "timestamp": "00:21:35", "text": "私は元気です。私はカフスをしている"}, {"type": "subtitle", "time": 1297.909, "timestamp": "00:21:37", "text": "多く。私の"}, {"type": "subtitle", "time": 1301.909, "timestamp": "00:21:41", "text": "喉の痛みは、うーん、泣きそうだけど、うん、私は"}, {"type": "subtitle", "time": 1304.87, "timestamp": "00:21:44", "text": "今日はたくさん話すつもりだ。それで"}, {"type": "subtitle", "time": 1308.149, "timestamp": "00:21:48", "text": "それもそうだ。"}, {"type": "subtitle", "time": 1311.35, "timestamp": "00:21:51", "text": "体がもっと休息を必要としているように感じる。"}, {"type": "subtitle", "time": 1314.39, "timestamp": "00:21:54", "text": "私も無理しすぎているような気がする。"}, {"type": "subtitle", "time": 1319.59, "timestamp": "00:21:59", "text": "でも、午後5時からの授業のためにも。私"}]
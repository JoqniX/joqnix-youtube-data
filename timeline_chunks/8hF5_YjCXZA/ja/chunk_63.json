[{"type": "subtitle", "time": 3782.309, "timestamp": "01:03:02", "text": "Google Payはどこにありますか？"}, {"type": "subtitle", "time": 3787.99, "timestamp": "01:03:07", "text": "文字通り言う"}, {"type": "subtitle", "time": 3790.15, "timestamp": "01:03:10", "text": "そのサイトには文字通り「Google Pay」と書いてあった。"}, {"type": "subtitle", "time": 3792.63, "timestamp": "01:03:12", "text": "世界中で利用可能です。"}, {"type": "subtitle", "time": 3795.829, "timestamp": "01:03:15", "text": "Google Payはどこにありますか？ナンダ、あなたは"}, {"type": "subtitle", "time": 3806.51, "timestamp": "01:03:26", "text": "請求と支払い。"}, {"type": "subtitle", "time": 3807.67, "timestamp": "01:03:27", "text": "[音楽]"}, {"type": "subtitle", "time": 3811.029, "timestamp": "01:03:31", "text": "ペイヤードの設定。ああ、銀行口座を追加しました"}, {"type": "subtitle", "time": 3813.27, "timestamp": "01:03:33", "text": "ここ。ええ、そうしました。ええと、繋がっています"}, {"type": "subtitle", "time": 3815.829, "timestamp": "01:03:35", "text": "Stripe経由。うん。はい。はい。忘れた。"}, {"type": "subtitle", "time": 3819.349, "timestamp": "01:03:39", "text": "はい。何の壁？接続先"}, {"type": "subtitle", "time": 3827.51, "timestamp": "01:03:47", "text": "うん。検証コードを試してください"}, {"type": "subtitle", "time": 3829.99, "timestamp": "01:03:49", "text": "44"}]
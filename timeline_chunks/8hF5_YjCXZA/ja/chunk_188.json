[{"type": "subtitle", "time": 11291.19, "timestamp": "03:08:11", "text": "ちょっと待って。私には次のようなものが必要です"}, {"type": "subtitle", "time": 11310.309, "timestamp": "03:08:30", "text": "おっと。"}, {"type": "subtitle", "time": 11314.95, "timestamp": "03:08:34", "text": "よし、それでうまくいくはずだ。"}, {"type": "subtitle", "time": 11317.83, "timestamp": "03:08:37", "text": "目を閉じる。うん、"}, {"type": "subtitle", "time": 11319.51, "timestamp": "03:08:39", "text": "どれでも"}, {"type": "subtitle", "time": 11322.79, "timestamp": "03:08:42", "text": "良さそうでしょう？"}, {"type": "subtitle", "time": 11331.75, "timestamp": "03:08:51", "text": "私の古いものは気にしない"}, {"type": "subtitle", "time": 11334.55, "timestamp": "03:08:54", "text": "マウスみたいなもので、マウスではない。"}, {"type": "subtitle", "time": 11337.67, "timestamp": "03:08:57", "text": "そうそう、ところでワイヤレスを注文したんだ"}]
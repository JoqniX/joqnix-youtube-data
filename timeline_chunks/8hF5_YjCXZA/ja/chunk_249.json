[{"type": "subtitle", "time": 14959.51, "timestamp": "04:09:19", "text": "さあ、どうだろうね。"}, {"type": "subtitle", "time": 14963.91, "timestamp": "04:09:23", "text": "もし私がそうなら、それは？うん。そして、そして人々のように"}, {"type": "subtitle", "time": 14966.389, "timestamp": "04:09:26", "text": "インドからはPayPal経由で寄付することはできません"}, {"type": "subtitle", "time": 14968.63, "timestamp": "04:09:28", "text": "ローカルトランザクションが機能しないため"}, {"type": "subtitle", "time": 14971.349, "timestamp": "04:09:31", "text": "PayPalやその他諸々のくだらないサイト"}, {"type": "subtitle", "time": 14974.63, "timestamp": "04:09:34", "text": "PayPalをメインに使うと、より速く"}, {"type": "subtitle", "time": 14978.63, "timestamp": "04:09:38", "text": "チェックアウト料金、安全なプラットフォームなど"}, {"type": "subtitle", "time": 14980.07, "timestamp": "04:09:40", "text": "あなた自身のせいで詐欺に遭った場合"}, {"type": "subtitle", "time": 14981.75, "timestamp": "04:09:41", "text": "印象が悪ければ、それもあなたの責任です。"}, {"type": "subtitle", "time": 14983.67, "timestamp": "04:09:43", "text": "それは本当だ。"}, {"type": "subtitle", "time": 14986.15, "timestamp": "04:09:46", "text": "問題は、私は何も知らないということです"}, {"type": "subtitle", "time": 14989.09, "timestamp": "04:09:49", "text": "ビジネスでも何でも。"}, {"type": "subtitle", "time": 14990.229, "timestamp": "04:09:50", "text": "[音楽]"}, {"type": "subtitle", "time": 14993.67, "timestamp": "04:09:53", "text": "私がやったことは、Razor Payを使って試しただけです"}, {"type": "subtitle", "time": 14996.229, "timestamp": "04:09:56", "text": "事業者として登録し、"}, {"type": "subtitle", "time": 14998.63, "timestamp": "04:09:58", "text": "私に電話をかけてきた人たちを見つけた。どうやって手に入れたのか"}]
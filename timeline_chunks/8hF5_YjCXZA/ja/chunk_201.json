[{"type": "subtitle", "time": 12066.55, "timestamp": "03:21:06", "text": "[音楽]"}, {"type": "subtitle", "time": 12068.77, "timestamp": "03:21:08", "text": "1秒。"}, {"type": "chat", "time": 12081.348, "timestamp": "03:21:21", "author": "@aayu-19", "avatar": "https://yt4.ggpht.com/CBsyJxkz41gID2BRWrJvmYUTnzlstGEbVu5WQvOg1qhhP-BUDRcz3NW0COP4b8vhEiJhN9fP=s64-c-k-c0x00ffffff-no-rj", "message": "hlw joq"}, {"type": "chat", "time": 12084.524, "timestamp": "03:21:24", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Shhh... ayu, Joq is resting. 🌙 Welcome to the Guild, and enjoy the past joq's memories!"}, {"type": "subtitle", "time": 12087.59, "timestamp": "03:21:27", "text": "[音楽]"}, {"type": "subtitle", "time": 12090.79, "timestamp": "03:21:30", "text": "ポテトチップスを買ったよ、バカ。ニャー。"}, {"type": "subtitle", "time": 12094.63, "timestamp": "03:21:34", "text": "ああ、神様。ニャー。何と言えばいいでしょうか？"}, {"type": "subtitle", "time": 12096.309, "timestamp": "03:21:36", "text": "あなたの住所を教えてください。いくつか送ります"}, {"type": "subtitle", "time": 12099.75, "timestamp": "03:21:39", "text": "おやつ。私は「バカ、そんなことできないよ」って感じだった。"}, {"type": "subtitle", "time": 12103.51, "timestamp": "03:21:43", "text": "なぜなら、1つと同じように、白い"}, {"type": "subtitle", "time": 12105.19, "timestamp": "03:21:45", "text": "子犬たち"}, {"type": "subtitle", "time": 12108.87, "timestamp": "03:21:48", "text": "檻から出て、その場所を守っていた。"}, {"type": "subtitle", "time": 12112.07, "timestamp": "03:21:52", "text": "2つ目は、家族が目を覚ますことです。 ３つ、えーと"}, {"type": "subtitle", "time": 12114.87, "timestamp": "03:21:54", "text": "家族は既に起きている。"}, {"type": "subtitle", "time": 12116.55, "timestamp": "03:21:56", "text": "えっと"}, {"type": "subtitle", "time": 12119.83, "timestamp": "03:21:59", "text": "ああ、それは幸せの乗り物かもしれない"}]
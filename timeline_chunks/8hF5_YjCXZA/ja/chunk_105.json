[{"type": "subtitle", "time": 6301.99, "timestamp": "01:45:01", "text": "もしくはキリトか、えっと、ベルでもいいかな"}, {"type": "subtitle", "time": 6304.55, "timestamp": "01:45:04", "text": "『ダンまち』のクラネル。その2人は"}, {"type": "subtitle", "time": 6307.59, "timestamp": "01:45:07", "text": "あの二人がアニメに似ているのは良いことだ"}, {"type": "subtitle", "time": 6310.79, "timestamp": "01:45:10", "text": "私は見た"}, {"type": "subtitle", "time": 6316.229, "timestamp": "01:45:16", "text": "私は実際にYouTubeでアニメを見ました"}, {"type": "subtitle", "time": 6320.55, "timestamp": "01:45:20", "text": "D.io 文字通りプレイリストがあった"}, {"type": "subtitle", "time": 6323.189, "timestamp": "01:45:23", "text": "えっと"}, {"type": "subtitle", "time": 6335.83, "timestamp": "01:45:35", "text": "うん、私は「うわー、これすごくクールだね」って思ったよ。"}, {"type": "subtitle", "time": 6339.35, "timestamp": "01:45:39", "text": "もっと見たい。それから私は発見しました"}, {"type": "subtitle", "time": 6341.75, "timestamp": "01:45:41", "text": "ダンまちの別のプレイリスト。それから私は"}, {"type": "subtitle", "time": 6345.43, "timestamp": "01:45:45", "text": "Dhachiを見始めた。うん。それから、えーと"}, {"type": "subtitle", "time": 6348.709, "timestamp": "01:45:48", "text": "3番目のアニメは『ダーリン・イン・ザ・フランクス』でした。"}, {"type": "subtitle", "time": 6351.35, "timestamp": "01:45:51", "text": "私はとても悲しいです。たくさん泣きました。"}, {"type": "subtitle", "time": 6354.55, "timestamp": "01:45:54", "text": "フランスで人気者。その話はあまりにも"}, {"type": "subtitle", "time": 6356.31, "timestamp": "01:45:56", "text": "急いでいたとか、何かあったんだろう。わからない。それ"}]
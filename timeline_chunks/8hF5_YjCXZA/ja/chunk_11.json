[{"type": "subtitle", "time": 661.59, "timestamp": "00:11:01", "text": "本日、いくつか変更がございます。えっと"}, {"type": "subtitle", "time": 664.31, "timestamp": "00:11:04", "text": "今日は音楽の授業があるから。"}, {"type": "subtitle", "time": 668.63, "timestamp": "00:11:08", "text": "私は音楽の授業を受けています。わーい。私"}, {"type": "subtitle", "time": 670.389, "timestamp": "00:11:10", "text": "あなたと一緒に参加します"}, {"type": "subtitle", "time": 672.31, "timestamp": "00:11:12", "text": "みんな。もちろん私は見せません"}, {"type": "subtitle", "time": 674.55, "timestamp": "00:11:14", "text": "会議、音声、または私の音声。"}, {"type": "subtitle", "time": 676.389, "timestamp": "00:11:16", "text": "皆さんは私のすべてを見ています"}, {"type": "subtitle", "time": 678.87, "timestamp": "00:11:18", "text": "私がボードの対応をしている間に"}, {"type": "subtitle", "time": 682.23, "timestamp": "00:11:22", "text": "クラス。しかし、今日の専門は"}, {"type": "subtitle", "time": 685.99, "timestamp": "00:11:25", "text": "今日は音楽をやります。"}, {"type": "subtitle", "time": 687.67, "timestamp": "00:11:27", "text": "[音楽]"}, {"type": "subtitle", "time": 689.67, "timestamp": "00:11:29", "text": "今日は音楽をやります。そして私は"}, {"type": "subtitle", "time": 692.47, "timestamp": "00:11:32", "text": "まだ給料をもらっていない。それで、えっと、私は"}, {"type": "subtitle", "time": 697.19, "timestamp": "00:11:37", "text": "支払うために、私はまだ交渉中です"}, {"type": "subtitle", "time": 700.389, "timestamp": "00:11:40", "text": "音楽の先生に、私が支払うように"}, {"type": "subtitle", "time": 703.67, "timestamp": "00:11:43", "text": "今月の分割払いは後日"}, {"type": "subtitle", "time": 706.069, "timestamp": "00:11:46", "text": "数日後、私は"}, {"type": "subtitle", "time": 708.47, "timestamp": "00:11:48", "text": "支払い済み"}, {"type": "subtitle", "time": 714.15, "timestamp": "00:11:54", "text": "来月の分以降は"}, {"type": "subtitle", "time": 718.87, "timestamp": "00:11:58", "text": "私の音楽制作コースを通して。"}]
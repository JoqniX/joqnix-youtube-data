[{"type": "subtitle", "time": 1321.11, "timestamp": "00:22:01", "text": "すべきではない"}, {"type": "subtitle", "time": 1323.35, "timestamp": "00:22:03", "text": "疲れすぎている。"}, {"type": "subtitle", "time": 1326.87, "timestamp": "00:22:06", "text": "だから、おそらく私はいくつか持っていくと思います"}, {"type": "subtitle", "time": 1330.39, "timestamp": "00:22:10", "text": "午後3時から休憩以降"}, {"type": "subtitle", "time": 1334.87, "timestamp": "00:22:14", "text": "ちょっと昼寝でもしようかな。"}, {"type": "subtitle", "time": 1337.83, "timestamp": "00:22:17", "text": "7時頃には戻ってきます"}, {"type": "subtitle", "time": 1340.549, "timestamp": "00:22:20", "text": "授業終了。皆さんはご覧になるでしょう"}, {"type": "subtitle", "time": 1343.27, "timestamp": "00:22:23", "text": "ブログとか、その他諸々。"}, {"type": "subtitle", "time": 1348.23, "timestamp": "00:22:28", "text": "うん。"}, {"type": "subtitle", "time": 1352.07, "timestamp": "00:22:32", "text": "そんな感じのことです。そして、私たちは"}, {"type": "subtitle", "time": 1355.51, "timestamp": "00:22:35", "text": "いくつか修正する必要があるよね？"}, {"type": "subtitle", "time": 1359.59, "timestamp": "00:22:39", "text": "ええ、メモしていませんでした。忘​​れていました。"}, {"type": "subtitle", "time": 1363.029, "timestamp": "00:22:43", "text": "結び付けて固定する。"}, {"type": "subtitle", "time": 1365.59, "timestamp": "00:22:45", "text": "しっかり結び付けておくべきだった。ああ、それは"}, {"type": "subtitle", "time": 1379.99, "timestamp": "00:22:59", "text": "どうやって、どれくらいの期間、私は知っている、私は気づいている"}]
[{"type": "subtitle", "time": 21545.19, "timestamp": "05:59:05", "text": "[笑い]"}, {"type": "subtitle", "time": 21553.03, "timestamp": "05:59:13", "text": "えーと"}, {"type": "subtitle", "time": 21556.39, "timestamp": "05:59:16", "text": "あれは何だったっけ？えっと"}, {"type": "subtitle", "time": 21565.59, "timestamp": "05:59:25", "text": "私は、えーと、ある番組を見ています"}, {"type": "subtitle", "time": 21567.67, "timestamp": "05:59:27", "text": "うん。えっと、ソロレベリング。見ていますよ。"}, {"type": "subtitle", "time": 21571.03, "timestamp": "05:59:31", "text": "それが一つ目です。それから受付係の"}, {"type": "subtitle", "time": 21572.638, "timestamp": "05:59:32", "text": "の シャン・ファ・ウー シャングリラ フロンティア シーズン 2"}, {"type": "subtitle", "time": 21577.28, "timestamp": "05:59:37", "text": "シャン・ファ・ウー シャングリラ フロンティア シーズン 2 そして"}]
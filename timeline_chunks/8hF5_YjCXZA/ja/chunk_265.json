[{"type": "subtitle", "time": 15909.51, "timestamp": "04:25:09", "text": "あのね？私は頼るだろう"}, {"type": "subtitle", "time": 15912.63, "timestamp": "04:25:12", "text": "それと、パンダン関連のもの。彼らはあの二人を知っている"}, {"type": "subtitle", "time": 15915.59, "timestamp": "04:25:15", "text": "人はビジネスの対象ではない。彼らは"}, {"type": "subtitle", "time": 15917.91, "timestamp": "04:25:17", "text": "法律的に良い。私は、私は、私は"}, {"type": "subtitle", "time": 15920.149, "timestamp": "04:25:20", "text": "彼らに近づく"}, {"type": "subtitle", "time": 15922.309, "timestamp": "04:25:22", "text": "そして"}, {"type": "subtitle", "time": 15926.71, "timestamp": "04:25:26", "text": "何をすべきか尋ねて、すべて"}, {"type": "subtitle", "time": 15928.95, "timestamp": "04:25:28", "text": "きちんと。"}, {"type": "subtitle", "time": 15936.229, "timestamp": "04:25:36", "text": "この時点で私は詐欺に遭うかもしれない"}, {"type": "subtitle", "time": 15938.71, "timestamp": "04:25:38", "text": "実際のインドの詐欺か何か"}, {"type": "subtitle", "time": 15941.91, "timestamp": "04:25:41", "text": "私がそのコメントを見た時の状況です。なぜあなたは"}, {"type": "subtitle", "time": 15945.75, "timestamp": "04:25:45", "text": "彼らに優しくして、"}, {"type": "subtitle", "time": 15948.07, "timestamp": "04:25:48", "text": "敬意を払うべきではないのですか？"}, {"type": "subtitle", "time": 15950.389, "timestamp": "04:25:50", "text": "そんな自己中心的な考えを持つべきではない"}, {"type": "subtitle", "time": 15952.07, "timestamp": "04:25:52", "text": "態度とか、そういうことですよね？いつ"}, {"type": "subtitle", "time": 15953.91, "timestamp": "04:25:53", "text": "と話している"}, {"type": "subtitle", "time": 15955.429, "timestamp": "04:25:55", "text": "人々、"}, {"type": "subtitle", "time": 15957.51, "timestamp": "04:25:57", "text": "右？"}]
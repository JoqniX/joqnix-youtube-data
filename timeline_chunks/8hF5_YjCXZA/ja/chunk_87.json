[{"type": "subtitle", "time": 5230.18, "timestamp": "01:27:10", "text": "兄弟？"}, {"type": "subtitle", "time": 5241.51, "timestamp": "01:27:21", "text": "私はそれが嫌いです。"}, {"type": "subtitle", "time": 5245.03, "timestamp": "01:27:25", "text": "人生が嫌いだ。"}, {"type": "subtitle", "time": 5248.87, "timestamp": "01:27:28", "text": "何てことだ。大丈夫。"}, {"type": "subtitle", "time": 5252.07, "timestamp": "01:27:32", "text": "会社を登録する。これは何ですか？"}, {"type": "subtitle", "time": 5254.39, "timestamp": "01:27:34", "text": "数千人に加わろう。おお。おお。会社"}, {"type": "subtitle", "time": 5260.39, "timestamp": "01:27:40", "text": "登録。 A. いくらですか？"}, {"type": "subtitle", "time": 5271.669, "timestamp": "01:27:51", "text": "わずか2時間で法人化できます。1,500ドル以上"}, {"type": "subtitle", "time": 5275.03, "timestamp": "01:27:55", "text": "政府手数料。くそ。"}]
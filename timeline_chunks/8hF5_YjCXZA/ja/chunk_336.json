[{"type": "subtitle", "time": 20168.708, "timestamp": "05:36:08", "text": "３つですよね？三つ。いいえ、それは"}, {"type": "subtitle", "time": 20173.11, "timestamp": "05:36:13", "text": "あれって何て呼ばれてたっけ？忘れた。"}, {"type": "subtitle", "time": 20177.19, "timestamp": "05:36:17", "text": "倍音。いいえ。えっと、なんて言うんだっけ？おお、"}, {"type": "subtitle", "time": 20180.39, "timestamp": "05:36:20", "text": "神を探し求めている。ああ、"}, {"type": "subtitle", "time": 20198.548, "timestamp": "05:36:38", "text": "私たちはこれを望んでいませんが、私たちは"}, {"type": "subtitle", "time": 20201.51, "timestamp": "05:36:41", "text": "種を使うことはできますか"}, {"type": "subtitle", "time": 20205.11, "timestamp": "05:36:45", "text": "システム。待って、リズムをシードしない。待って、"}, {"type": "subtitle", "time": 20208.47, "timestamp": "05:36:48", "text": "いいえ。それは何という名前でしたか？"}, {"type": "subtitle", "time": 20211.05, "timestamp": "05:36:51", "text": "見る、"}, {"type": "subtitle", "time": 20214.07, "timestamp": "05:36:54", "text": "[音楽]"}, {"type": "subtitle", "time": 20216.23, "timestamp": "05:36:56", "text": "80歳にしては素晴らしいゴールだ。ああ、ゴールがある。"}]
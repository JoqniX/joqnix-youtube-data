[{"type": "subtitle", "time": 13081.51, "timestamp": "03:38:01", "text": "わかった。あのヴォードを楽しんでいただけたなら幸いです。"}, {"type": "subtitle", "time": 13096.15, "timestamp": "03:38:16", "text": "あの、あなたの意見を聞きたいんです。"}, {"type": "subtitle", "time": 13099.429, "timestamp": "03:38:19", "text": "それで、あの、覚えてる？僕たちは"}, {"type": "subtitle", "time": 13103.429, "timestamp": "03:38:23", "text": "えっと、カミソリテープみたいなことをやろうとしてるんだけど、"}, {"type": "subtitle", "time": 13104.95, "timestamp": "03:38:24", "text": "右？"}, {"type": "subtitle", "time": 13109.67, "timestamp": "03:38:29", "text": "それで、どうやらその人たちから電話があったらしい"}, {"type": "subtitle", "time": 13112.229, "timestamp": "03:38:32", "text": "えーと、質問しました"}, {"type": "subtitle", "time": 13113.91, "timestamp": "03:38:33", "text": "えーと、私がやりたかったことは"}, {"type": "subtitle", "time": 13116.389, "timestamp": "03:38:36", "text": "事業登録とか、その他諸々。"}, {"type": "subtitle", "time": 13118.229, "timestamp": "03:38:38", "text": "それで、"}, {"type": "subtitle", "time": 13121.11, "timestamp": "03:38:41", "text": "だからソロパパイヤシップの件は、"}, {"type": "subtitle", "time": 13123.269, "timestamp": "03:38:43", "text": "3,000"}, {"type": "subtitle", "time": 13125.349, "timestamp": "03:38:45", "text": "そして私はどういうわけか"}, {"type": "subtitle", "time": 13128.309, "timestamp": "03:38:48", "text": "私はどうにかしてお願いして、"}, {"type": "subtitle", "time": 13130.79, "timestamp": "03:38:50", "text": "分割払いを設定する。彼らはイエスと答えた。"}, {"type": "subtitle", "time": 13132.95, "timestamp": "03:38:52", "text": "そして"}, {"type": "subtitle", "time": 13134.79, "timestamp": "03:38:54", "text": "今私が持っているお金は"}, {"type": "subtitle", "time": 13137.59, "timestamp": "03:38:57", "text": "2,000。だから、銀行に行って"}]
[{"type": "subtitle", "time": 11101.03, "timestamp": "03:05:01", "text": "私だけでしょうか、それともそうでしょうか。ああ、そうですね。フィードは"}, {"type": "subtitle", "time": 11103.67, "timestamp": "03:05:03", "text": "立ち往生。フィードが詰まっています。"}, {"type": "subtitle", "time": 11105.83, "timestamp": "03:05:05", "text": "はい、私の間違いでした。"}, {"type": "subtitle", "time": 11108.63, "timestamp": "03:05:08", "text": "えっと、フィードが止まってます。はい、どうぞ"}, {"type": "subtitle", "time": 11111.19, "timestamp": "03:05:11", "text": "行く。"}, {"type": "subtitle", "time": 11115.19, "timestamp": "03:05:15", "text": "私みたいにならないで。ヒーローに餌を与えすぎろ。欲しい"}, {"type": "subtitle", "time": 11146.95, "timestamp": "03:05:46", "text": "大きな"}, {"type": "subtitle", "time": 11149.269, "timestamp": "03:05:49", "text": "穴"}, {"type": "subtitle", "time": 11152.95, "timestamp": "03:05:52", "text": "そうすれば、私がそれをどこで回転させるかがわかります。わかった、"}, {"type": "subtitle", "time": 11155.67, "timestamp": "03:05:55", "text": "今なら右が見える"}]
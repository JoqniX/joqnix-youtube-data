[{"type": "subtitle", "time": 5762.31, "timestamp": "01:36:02", "text": "多すぎるし、すべてはただ"}, {"type": "subtitle", "time": 5765.669, "timestamp": "01:36:05", "text": "些細なことで、考えすぎなだけかもしれない。"}, {"type": "subtitle", "time": 5769.91, "timestamp": "01:36:09", "text": "それについてたくさん話しますね。それで、私が"}, {"type": "subtitle", "time": 5772.149, "timestamp": "01:36:12", "text": "言うことは"}, {"type": "subtitle", "time": 5775.189, "timestamp": "01:36:15", "text": "たとえそれが"}, {"type": "subtitle", "time": 5777.75, "timestamp": "01:36:17", "text": "たとえ相手が気づいても、些細なことだ"}, {"type": "subtitle", "time": 5780.709, "timestamp": "01:36:20", "text": "君がぎこちなくて変なことをしている"}, {"type": "subtitle", "time": 5783.91, "timestamp": "01:36:23", "text": "恥ずかしがり屋でも大丈夫。"}, {"type": "subtitle", "time": 5787.189, "timestamp": "01:36:27", "text": "話そうと試みてください"}, {"type": "subtitle", "time": 5789.27, "timestamp": "01:36:29", "text": "もし可能なら"}, {"type": "subtitle", "time": 5791.59, "timestamp": "01:36:31", "text": "なぜならそれが重要なことだから"}, {"type": "subtitle", "time": 5793.91, "timestamp": "01:36:33", "text": "コミュニケーション、"}, {"type": "subtitle", "time": 5796.31, "timestamp": "01:36:36", "text": "右？"}, {"type": "subtitle", "time": 5799.75, "timestamp": "01:36:39", "text": "テキストメッセージでも対面でも、"}, {"type": "subtitle", "time": 5802.229, "timestamp": "01:36:42", "text": "会話に面して、"}, {"type": "subtitle", "time": 5804.39, "timestamp": "01:36:44", "text": "あまり深く考えすぎない"}, {"type": "subtitle", "time": 5806.47, "timestamp": "01:36:46", "text": "それ。"}, {"type": "subtitle", "time": 5808.79, "timestamp": "01:36:48", "text": "えーと、彼らはどう思うだろう、"}, {"type": "subtitle", "time": 5810.79, "timestamp": "01:36:50", "text": "あなたは、彼らがこの返答をすると言いました"}, {"type": "subtitle", "time": 5815.189, "timestamp": "01:36:55", "text": "彼らが言うかもしれないことを言うなどなど、言わないで"}, {"type": "subtitle", "time": 5817.99, "timestamp": "01:36:57", "text": "考えすぎて結論に飛びつくと、"}]
[{"type": "subtitle", "time": 18000.23, "timestamp": "05:00:00", "text": "もう一度電話して、何かあるか"}, {"type": "subtitle", "time": 18001.75, "timestamp": "05:00:01", "text": "支払いなどは済ませましたか？私"}, {"type": "subtitle", "time": 18005.67, "timestamp": "05:00:05", "text": "「いいえ、まだです」と答えた。そして、えっと、"}, {"type": "subtitle", "time": 18007.59, "timestamp": "05:00:07", "text": "問題は、君たちが急いでいるということだ"}, {"type": "subtitle", "time": 18010.628, "timestamp": "05:00:10", "text": "彼女。文字通りそう思った"}, {"type": "subtitle", "time": 18013.75, "timestamp": "05:00:13", "text": "少女が女性にそれを転送した"}, {"type": "subtitle", "time": 18016.07, "timestamp": "05:00:16", "text": "彼女のマネージャーか何かに、そしてあの男"}, {"type": "subtitle", "time": 18019.27, "timestamp": "05:00:19", "text": "話していたのは彼で、彼らは"}, {"type": "subtitle", "time": 18022.23, "timestamp": "05:00:22", "text": "えーっと、たくさん話し合った後、"}, {"type": "subtitle", "time": 18023.99, "timestamp": "05:00:23", "text": "まるで"}, {"type": "subtitle", "time": 18027.27, "timestamp": "05:00:27", "text": "えっと、彼らは「2,000ドル払った」みたいな感じだった"}, {"type": "subtitle", "time": 18029.51, "timestamp": "05:00:29", "text": "そして私たちは書類作成など全てを代行します"}, {"type": "subtitle", "time": 18031.67, "timestamp": "05:00:31", "text": "すべてが相互チェックできる、または"}, {"type": "subtitle", "time": 18034.708, "timestamp": "05:00:34", "text": "すべてが順調であれば、その後はそうではなく、"}, {"type": "subtitle", "time": 18037.91, "timestamp": "05:00:37", "text": "そして千ドルとその他諸々を支払う"}, {"type": "subtitle", "time": 18040.948, "timestamp": "05:00:40", "text": "彼は2000をまるで"}, {"type": "subtitle", "time": 18044.628, "timestamp": "05:00:44", "text": "君と僕にとっては何でもない。どうして"}, {"type": "subtitle", "time": 18047.11, "timestamp": "05:00:47", "text": "2000なんて大したことないって言うの？沢山あります"}, {"type": "subtitle", "time": 18050.868, "timestamp": "05:00:50", "text": "文字通り"}, {"type": "subtitle", "time": 18053.75, "timestamp": "05:00:53", "text": "少なくとも10ルピー欲しいのですが"}, {"type": "subtitle", "time": 18056.55, "timestamp": "05:00:56", "text": "外の路上には"}, {"type": "subtitle", "time": 18059.83, "timestamp": "05:00:59", "text": "食費とか色々買うためのお金。そしてあのガキ"}]
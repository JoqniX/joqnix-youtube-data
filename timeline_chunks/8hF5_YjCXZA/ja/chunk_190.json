[{"type": "subtitle", "time": 11400.469, "timestamp": "03:10:00", "text": "それも一つですね。新しい"}, {"type": "subtitle", "time": 11404.309, "timestamp": "03:10:04", "text": "私が使った歯ブラシ"}, {"type": "subtitle", "time": 11405.91, "timestamp": "03:10:05", "text": "両親の家。"}, {"type": "subtitle", "time": 11410.63, "timestamp": "03:10:10", "text": "それから、もう一つ忘れてたことがある"}, {"type": "subtitle", "time": 11412.55, "timestamp": "03:10:12", "text": "えーと"}, {"type": "subtitle", "time": 11416.15, "timestamp": "03:10:16", "text": "実は忘れてたんだ、えーっと、うん、"}, {"type": "subtitle", "time": 11423.34, "timestamp": "03:10:23", "text": "これは何ですか？"}, {"type": "subtitle", "time": 11425.91, "timestamp": "03:10:25", "text": "[音楽]"}, {"type": "subtitle", "time": 11429.429, "timestamp": "03:10:29", "text": "何？何？"}, {"type": "subtitle", "time": 11435.51, "timestamp": "03:10:35", "text": "ああ、わかりました。えっと、ああ、忘れてたよ。"}, {"type": "subtitle", "time": 11438.07, "timestamp": "03:10:38", "text": "そして、休暇を取るのを忘れてしまった。私はそれを置いた"}, {"type": "subtitle", "time": 11440.389, "timestamp": "03:10:40", "text": "外のような感じ。昼食時だった。"}, {"type": "subtitle", "time": 11443.75, "timestamp": "03:10:43", "text": "わかった。 1 午前0時 午後0時それは"}, {"type": "subtitle", "time": 11446.55, "timestamp": "03:10:46", "text": "家に帰ってきたとき"}, {"type": "subtitle", "time": 11451.349, "timestamp": "03:10:51", "text": "えーと、ヒーロー。えっと、それで私はそれを外に置きました"}, {"type": "subtitle", "time": 11453.91, "timestamp": "03:10:53", "text": "外には車とか色々あるんだけど"}, {"type": "subtitle", "time": 11456.79, "timestamp": "03:10:56", "text": "ガレージがある場所、ガレージがあるのは、"}, {"type": "subtitle", "time": 11459.349, "timestamp": "03:10:59", "text": "まるで本当に明るい日差しが"}]
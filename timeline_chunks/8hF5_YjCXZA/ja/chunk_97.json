[{"type": "subtitle", "time": 5820.79, "timestamp": "01:37:00", "text": "飛び込むのではなく"}, {"type": "subtitle", "time": 5824.47, "timestamp": "01:37:04", "text": "結論は文字通り"}, {"type": "subtitle", "time": 5828.149, "timestamp": "01:37:08", "text": "えっと、文字通りこうすればいいと思います"}, {"type": "subtitle", "time": 5831.189, "timestamp": "01:37:11", "text": "それは何であれ、あなたが感じていることは"}, {"type": "subtitle", "time": 5834.149, "timestamp": "01:37:14", "text": "何を言いたいのですか？"}, {"type": "subtitle", "time": 5838.229, "timestamp": "01:37:18", "text": "たとえ理解されなくても、ただ言ってみて"}, {"type": "subtitle", "time": 5840.47, "timestamp": "01:37:20", "text": "投票で落選"}, {"type": "subtitle", "time": 5842.07, "timestamp": "01:37:22", "text": "の中へ"}, {"type": "subtitle", "time": 5844.229, "timestamp": "01:37:24", "text": "えっと、何が欲しいの？"}, {"type": "subtitle", "time": 5846.629, "timestamp": "01:37:26", "text": "大丈夫。入れるだけでもいいですよ"}, {"type": "subtitle", "time": 5849.27, "timestamp": "01:37:29", "text": "彼らは私が言葉遣いが下手だと知っている。"}, {"type": "subtitle", "time": 5852.95, "timestamp": "01:37:32", "text": "しかし、これが私が試したかったことです"}, {"type": "subtitle", "time": 5857.43, "timestamp": "01:37:37", "text": "伝えるなど。うん、"}, {"type": "subtitle", "time": 5860.79, "timestamp": "01:37:40", "text": "主な部分は、あなたがしようとしていることです"}, {"type": "subtitle", "time": 5864.95, "timestamp": "01:37:44", "text": "何か。あなたは"}, {"type": "subtitle", "time": 5868.39, "timestamp": "01:37:48", "text": "コミュニケーション、コミュニケーション活動"}, {"type": "subtitle", "time": 5871.189, "timestamp": "01:37:51", "text": "一歩前進して"}, {"type": "subtitle", "time": 5872.79, "timestamp": "01:37:52", "text": "アクション。"}, {"type": "subtitle", "time": 5876.31, "timestamp": "01:37:56", "text": "それが重要なのです、なぜなら人々がいるからです"}, {"type": "subtitle", "time": 5878.31, "timestamp": "01:37:58", "text": "コミュニケーションを取り、"}]
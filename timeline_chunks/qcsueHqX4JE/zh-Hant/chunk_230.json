[{"type": "subtitle", "time": 13811.91, "timestamp": "03:50:11", "text": "唯一特別之處在於他們與大學和語言學校有聯繫。"}, {"type": "subtitle", "time": 13815.11, "timestamp": "03:50:15", "text": "不。其他地方就像 SSW 之類的，而這裡的"}, {"type": "subtitle", "time": 13818.469, "timestamp": "03:50:18", "text": "人卻告訴我，先在當地的學院學習基礎水平，然後去日本，從那裡一路打到更高水平。所以，你就會"}, {"type": "subtitle", "time": 13828.63, "timestamp": "03:50:28", "text": "感覺自己置身於日本的環境。這樣你就能輕鬆跟上所有事情的進度了。  他們就是這麼說的，"}, {"type": "subtitle", "time": 13852.07, "timestamp": "03:50:52", "text": "我覺得他們人脈很廣，事實也的確如此。就我"}]
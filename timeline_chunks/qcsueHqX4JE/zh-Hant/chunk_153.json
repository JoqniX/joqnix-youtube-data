[{"type": "subtitle", "time": 9201.11, "timestamp": "02:33:21", "text": "外觀高階。哦，惠普GPU。  我喜歡"}, {"type": "subtitle", "time": 9210.95, "timestamp": "02:33:30", "text": "你的回答，歡迎"}, {"type": "subtitle", "time": 9215.19, "timestamp": "02:33:35", "text": "你列出簡短的答案。"}, {"type": "subtitle", "time": 9217.75, "timestamp": "02:33:37", "text": "日本使用100V A型插座。這些充電器都是100至250瓦的通用型。但很多磚都是三爪的。"}, {"type": "subtitle", "time": 9228.469, "timestamp": "02:33:48", "text": "在日本買一個 2 3 轉 2 的轉換器。考慮在咖啡館使用小巧的 USB-C PD 充電器。把那塊大磚放在家裡和工作室裡。"}]
[{"type": "subtitle", "time": 15304.55, "timestamp": "04:15:04", "text": "開始的，對吧？所以現在是2020年9月23日，也就是202年，"}, {"type": "subtitle", "time": 15325.03, "timestamp": "04:15:25", "text": "我想是5年、5年、6年了。我聽人說過，他們說我來自俄羅斯，他們說我來自…我不是印度，我來自…你為什麼這麼執著？"}, {"type": "subtitle", "time": 15326.95, "timestamp": "04:15:26", "text": "他們會說各種各樣的國家名字，我就想，天哪，有那麼嚴重嗎？"}, {"type": "subtitle", "time": 15335.91, "timestamp": "04:15:35", "text": "我什至不知道"}, {"type": "subtitle", "time": 15337.67, "timestamp": "04:15:37", "text": "我有沒有口音。對"}, {"type": "subtitle", "time": 15349.99, "timestamp": "04:15:49", "text": "我來說，我開始直播的時候，我的英文真的非常非常差，我幾乎從不開口說話，即使在學校、"}]
[{"type": "subtitle", "time": 22024.548, "timestamp": "06:07:04", "text": "。我把所有東西都保留了下來。太酷了。"}, {"type": "subtitle", "time": 22027.19, "timestamp": "06:07:07", "text": "我為此做了很多事情，因為Dakadon 對我來說就像一個"}, {"type": "subtitle", "time": 22030.628, "timestamp": "06:07:10", "text": "實驗階段，因為我知道不可能拿到 2000 美元來製作模型，再加上 500它的授權費、綁定費"}, {"type": "subtitle", "time": 22057.19, "timestamp": "06:07:37", "text": "以及所有其他首秀所需的費用。是一種企業級的高端大型機型。"}, {"type": "subtitle", "time": 22059.03, "timestamp": "06:07:39", "text": "我"}, {"type": "subtitle", "time": 22062.708, "timestamp": "06:07:42", "text": "現在必須為此付出代價。所以"}, {"type": "subtitle", "time": 22065.884, "timestamp": "06:07:45", "text": "很多事情來來回回地討論著。呃，如果你想看的話，真的很好看，對吧？"}]
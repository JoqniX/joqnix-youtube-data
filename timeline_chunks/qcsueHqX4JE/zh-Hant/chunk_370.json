[{"type": "subtitle", "time": 22207.35, "timestamp": "06:10:07", "text": "不得不查看他們的私信，然後刪除"}, {"type": "subtitle", "time": 22213.51, "timestamp": "06:10:13", "text": "谷歌雲端硬碟文件。[倒吸一口氣] 所以，是"}, {"type": "subtitle", "time": 22215.43, "timestamp": "06:10:15", "text": "啊，這麼漂亮的模特兒[嘆氣和倒吸一口氣"}, {"type": "subtitle", "time": 22218.15, "timestamp": "06:10:18", "text": "]，而且，因為我已經和藝術家以及唱片公司談過了，我還告訴他們我正在發起"}, {"type": "subtitle", "time": 22228.47, "timestamp": "06:10:28", "text": "活動來支付這一切。我只希望他們不要現在就拋棄我。  他們都是韓國人。呃"}, {"type": "subtitle", "time": 22232.15, "timestamp": "06:10:32", "text": "，韓國藝術家兼索"}, {"type": "subtitle", "time": 22236.788, "timestamp": "06:10:36", "text": "具師。那位藝術家向我推薦了"}, {"type": "subtitle", "time": 22239.83, "timestamp": "06:10:39", "text": "索具工。所以"}]
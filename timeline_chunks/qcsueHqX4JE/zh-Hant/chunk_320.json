[{"type": "subtitle", "time": 19205.27, "timestamp": "05:20:05", "text": "網站之類的。我不知道。但是，嗯，如果"}, {"type": "subtitle", "time": 19229.51, "timestamp": "05:20:29", "text": "我要談談經紀人的事，對吧？嗯，我的意思是，他們已經在評論了。是的。是的。是的。所以，是的。哦，是的。如果我要談談經紀人的事，對吧？嗯，"}, {"type": "subtitle", "time": 19240.55, "timestamp": "05:20:40", "text": "我想"}, {"type": "subtitle", "time": 19243.51, "timestamp": "05:20:43", "text": "我已經沒有那種關係了。呃，真正的管理。是的，在其中一個影片裡，我遇到了一個問題，我摔車了，然後……嗯，我……嗯"}, {"type": "subtitle", "time": 19251.27, "timestamp": "05:20:51", "text": "，就是那"}, {"type": "subtitle", "time": 19253.83, "timestamp": "05:20:53", "text": "個人。你知道嗎？我爸說，他反對我去浦那"}]
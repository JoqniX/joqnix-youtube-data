[{"type": "subtitle", "time": 5463.669, "timestamp": "01:31:03", "text": "你是做YouTuber之類的嗎？我覺得這樣很好。呃，就像那樣，會有各種比較之類的，對吧？"}, {"type": "subtitle", "time": 5466.149, "timestamp": "01:31:06", "text": "你會到場，對吧？  但我很高興，至少我的父母允許我追求自己的夢想"}, {"type": "subtitle", "time": 5468.39, "timestamp": "01:31:08", "text": "。  從某種程度上"}, {"type": "subtitle", "time": 5477.35, "timestamp": "01:31:17", "text": "說，我在學術方面有點晚了，因為在某種程度上，我當時很迷茫，很困惑，不知道"}, {"type": "subtitle", "time": 5485.35, "timestamp": "01:31:25", "text": "自己想要什麼，對吧？我知道有些家庭的父母會強迫孩子從事某些職業，像是成為律師、醫生之類的，對吧？  所以就我而言（哭泣），"}, {"type": "subtitle", "time": 5511.75, "timestamp": "01:31:51", "text": "謝天謝地，"}, {"type": "subtitle", "time": 5514.79, "timestamp": "01:31:54", "text": "這種情況從未發生過，雖然他們也談論過這件事，但我說不，我"}]
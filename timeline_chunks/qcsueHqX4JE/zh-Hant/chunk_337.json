[{"type": "subtitle", "time": 20252.23, "timestamp": "05:37:32", "text": "如果你仔細想想，這一切對任何人有幫助嗎？"}, {"type": "subtitle", "time": 20255.27, "timestamp": "05:37:35", "text": "沒有。對。對任何人有幫助嗎？對南加州那邊有幫助嗎？對他們有幫助嗎？沒有。對我"}, {"type": "subtitle", "time": 20265.99, "timestamp": "05:37:45", "text": "有幫助嗎？沒有。"}, {"type": "subtitle", "time": 20270.07, "timestamp": "05:37:50", "text": "排球。我做過他們那樣的事[笑聲和倒吸一口涼氣]，問題是"}, {"type": "subtitle", "time": 20272.31, "timestamp": "05:37:52", "text": "現在"}]
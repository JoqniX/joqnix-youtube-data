[{"type": "subtitle", "time": 19320.39, "timestamp": "05:22:00", "text": "我們聊了聊，然後我們坐火車去浦那，見到了那個讓我住進他們家的人，他們的家人讓我住在他們家。"}, {"type": "subtitle", "time": 19327.43, "timestamp": "05:22:07", "text": "諸如此類。所以，當我告訴他們，"}, {"type": "subtitle", "time": 19338.47, "timestamp": "05:22:18", "text": "當我給他們看那些人的評論時，我爸就說，好吧，我早就跟你說過"}, {"type": "subtitle", "time": 19344.628, "timestamp": "05:22:24", "text": "。永遠不要相信別人，但他從來不聽我的，因為他反對"}, {"type": "subtitle", "time": 19358.628, "timestamp": "05:22:38", "text": "我不得不求助於我的叔叔，呃，叔叔，來勸我爸讓我和那些素未謀面的"}, {"type": "subtitle", "time": 19364.632, "timestamp": "05:22:44", "text": "網友朋友們最後見一面，因為我要去日本了，以後就再也見不到他們了。不，我求他讓我去吧之類的。但他就是不肯。他說，"}, {"type": "subtitle", "time": 19377.11, "timestamp": "05:22:57", "text": "現在"}]
[{"type": "subtitle", "time": 18972.31, "timestamp": "05:16:12", "text": "天黑了，那我就會那樣做了"}, {"type": "subtitle", "time": 18974.628, "timestamp": "05:16:14", "text": "。"}, {"type": "subtitle", "time": 18993.75, "timestamp": "05:16:33", "text": "日程、尋找贊助商、確保數據分析等等等等，對"}, {"type": "subtitle", "time": 18997.67, "timestamp": "05:16:37", "text": "吧？然後她解釋了一些關於“婚姻”如何被用作“男朋友”的用法。兄弟。哦，對。對。對。我看到了。 Q版。不是Q版。"}, {"type": "subtitle", "time": 19002.31, "timestamp": "05:16:42", "text": "呃，墮落的"}]
[{"type": "subtitle", "time": 12200.55, "timestamp": "03:23:20", "text": "。我想用一種正經的方式去做，認真工作，盡我所能，然後拿到我應得的錢。有了這些錢，"}, {"type": "subtitle", "time": 12206.95, "timestamp": "03:23:26", "text": "我就會感到滿足，因為"}, {"type": "subtitle", "time": 12219.11, "timestamp": "03:23:39", "text": "這是我辛苦賺來的錢。等一切都結束了，"}, {"type": "subtitle", "time": 12225.269, "timestamp": "03:23:45", "text": "我終於可以退休，拿到我的"}, {"type": "subtitle", "time": 12232.95, "timestamp": "03:23:52", "text": "工資，享受我的假期什麼的，或者在我30歲、60歲，或者某個年紀之後——我不知道——我當時就是這麼想的。"}]
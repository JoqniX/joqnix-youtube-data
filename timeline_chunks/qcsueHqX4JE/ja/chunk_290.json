[{"type": "subtitle", "time": 17400.55, "timestamp": "04:50:00", "text": "私を助けてくれる人たちのためのもの"}, {"type": "subtitle", "time": 17403.35, "timestamp": "04:50:03", "text": "私の配信やモデレーター"}, {"type": "subtitle", "time": 17407.51, "timestamp": "04:50:07", "text": "当初は人々に報酬を支払いたかった。"}, {"type": "subtitle", "time": 17410.31, "timestamp": "04:50:10", "text": "私はいつも人々に言っているようにしたい"}, {"type": "subtitle", "time": 17412.23, "timestamp": "04:50:12", "text": "モデレーターとかスタッフとか"}, {"type": "subtitle", "time": 17415.11, "timestamp": "04:50:15", "text": "チャンネルでは、どのように支払えばよいかなど"}, {"type": "subtitle", "time": 17418.23, "timestamp": "04:50:18", "text": "私は無一文で、収入も全くありません。"}, {"type": "subtitle", "time": 17421.19, "timestamp": "04:50:21", "text": "その時間帯に支払いたい"}, {"type": "subtitle", "time": 17425.51, "timestamp": "04:50:25", "text": "pal.gg がリリースされました。それは新しい"}, {"type": "subtitle", "time": 17427.59, "timestamp": "04:50:27", "text": "Twitchコミュニティのトレンドと"}, {"type": "subtitle", "time": 17430.39, "timestamp": "04:50:30", "text": "物、ストリーマーコミュニティ、"}, {"type": "subtitle", "time": 17433.51, "timestamp": "04:50:33", "text": "人々がモデレーターなどに報酬を支払う"}, {"type": "subtitle", "time": 17436.31, "timestamp": "04:50:36", "text": "カットとかそういうの全部、"}, {"type": "subtitle", "time": 17438.948, "timestamp": "04:50:38", "text": "右？パル・G私は、使いたいと思った"}, {"type": "subtitle", "time": 17441.11, "timestamp": "04:50:41", "text": "pali.gg とかそういうもの。そして私は気づいた、"}, {"type": "subtitle", "time": 17443.59, "timestamp": "04:50:43", "text": "まあ、Twitchではあまり稼げないんだけどね"}, {"type": "subtitle", "time": 17445.75, "timestamp": "04:50:45", "text": "とにかく、支払わないのは難しい"}, {"type": "subtitle", "time": 17448.47, "timestamp": "04:50:48", "text": "モデレーター。これ、必要かな？それから私が"}, {"type": "subtitle", "time": 17450.708, "timestamp": "04:50:50", "text": "これについて言ったら、彼らはこう言った"}, {"type": "subtitle", "time": 17452.948, "timestamp": "04:50:52", "text": "わかったよジョー、君は必要ないよ、私たちはここにいるから"}, {"type": "subtitle", "time": 17455.11, "timestamp": "04:50:55", "text": "私たちはボランティアで、あなたのためにお手伝いします。"}, {"type": "subtitle", "time": 17459.67, "timestamp": "04:50:59", "text": "そういうこともあったし、それに私は"}]
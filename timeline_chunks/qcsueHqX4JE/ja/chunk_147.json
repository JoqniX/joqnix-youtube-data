[{"type": "subtitle", "time": 8823.67, "timestamp": "02:27:03", "text": "だから私は"}, {"type": "subtitle", "time": 8827.27, "timestamp": "02:27:07", "text": "Steveの遮音パッドを入手してください。おお"}, {"type": "subtitle", "time": 8829.59, "timestamp": "02:27:09", "text": "うん。"}, {"type": "subtitle", "time": 8833.27, "timestamp": "02:27:13", "text": "それは生み出す。ああ、そうそう。"}, {"type": "subtitle", "time": 8854.309, "timestamp": "02:27:34", "text": "正直に言うと、"}, {"type": "subtitle", "time": 8856.71, "timestamp": "02:27:36", "text": "レコーディングスタジオ"}, {"type": "subtitle", "time": 8859.75, "timestamp": "02:27:39", "text": "またはボーカルブースのように、それをレンタルして"}, {"type": "subtitle", "time": 8864.07, "timestamp": "02:27:44", "text": "1時間、1時間の配信を行う"}, {"type": "subtitle", "time": 8867.349, "timestamp": "02:27:47", "text": "そして、その日は終わりにする。パートタイムに戻る"}, {"type": "subtitle", "time": 8871.11, "timestamp": "02:27:51", "text": "仕事。家に帰ってきてください。"}, {"type": "subtitle", "time": 8873.75, "timestamp": "02:27:53", "text": "録画したビデオの編集作業または編集作業"}, {"type": "subtitle", "time": 8876.63, "timestamp": "02:27:56", "text": "あるいは、そんな感じ。"}, {"type": "subtitle", "time": 8879.27, "timestamp": "02:27:59", "text": "そんな感じですね。"}]
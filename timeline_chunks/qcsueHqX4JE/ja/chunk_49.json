[{"type": "subtitle", "time": 2944.71, "timestamp": "00:49:04", "text": "さて、他に何かありますか？えっと、どこが"}, {"type": "subtitle", "time": 2946.71, "timestamp": "00:49:06", "text": "リアカ？"}, {"type": "subtitle", "time": 2956.95, "timestamp": "00:49:16", "text": "これが核心だ。"}, {"type": "subtitle", "time": 2963.27, "timestamp": "00:49:23", "text": "プライム・モラリ。"}, {"type": "subtitle", "time": 2968.79, "timestamp": "00:49:28", "text": "ブレイズ・ナナ。いいえ。ブレイズ。"}, {"type": "subtitle", "time": 2973.589, "timestamp": "00:49:33", "text": "ああ。炎のインスピレーション。どこにいるの？ 65. ああ。"}, {"type": "subtitle", "time": 2976.23, "timestamp": "00:49:36", "text": "えっと。"}, {"type": "subtitle", "time": 2980.309, "timestamp": "00:49:40", "text": "ブレイズとスポ。どこ？どの燃えるようなスポ"}, {"type": "subtitle", "time": 2982.87, "timestamp": "00:49:42", "text": "私たちに必要なものは？複数の異なる"}, {"type": "subtitle", "time": 2984.95, "timestamp": "00:49:44", "text": "種類"}, {"type": "subtitle", "time": 2986.87, "timestamp": "00:49:46", "text": "ああ、水力発電。あ、待って、待って、待って、待って。"}, {"type": "subtitle", "time": 2990.79, "timestamp": "00:49:50", "text": "水力発電のものが必要だ。いいえ。"}, {"type": "subtitle", "time": 2997.829, "timestamp": "00:49:57", "text": "ああ、水力発電にはいろいろな種類があるんだ"}, {"type": "subtitle", "time": 2999.589, "timestamp": "00:49:59", "text": "傘。 [息を呑む]"}]
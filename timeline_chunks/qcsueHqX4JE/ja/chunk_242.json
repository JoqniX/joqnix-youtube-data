[{"type": "subtitle", "time": 14536.71, "timestamp": "04:02:16", "text": "うん、アニメにハマりすぎてたんだ。うん、"}, {"type": "subtitle", "time": 14540.15, "timestamp": "04:02:20", "text": "言いたいことは分かります。今は好きじゃない。私 私"}, {"type": "subtitle", "time": 14543.51, "timestamp": "04:02:23", "text": "読んだ時に、それがどれほど恥ずかしいことだったか理解しました"}, {"type": "subtitle", "time": 14547.59, "timestamp": "04:02:27", "text": "私が人々に送ったメッセージ。いいえ、私は"}, {"type": "subtitle", "time": 14550.07, "timestamp": "04:02:30", "text": "まるで、「おい、"}, {"type": "subtitle", "time": 14553.189, "timestamp": "04:02:33", "text": "非常識な。のように、"}, {"type": "subtitle", "time": 14565.189, "timestamp": "04:02:45", "text": "素晴らしいものが恋しいが、それは追放された"}, {"type": "subtitle", "time": 14574.63, "timestamp": "04:02:54", "text": "うん。"}, {"type": "subtitle", "time": 14576.95, "timestamp": "04:02:56", "text": "ある意味、私はこういう"}]
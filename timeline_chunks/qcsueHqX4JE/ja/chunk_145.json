[{"type": "subtitle", "time": 8700.63, "timestamp": "02:25:00", "text": "私はこう考えていました"}, {"type": "subtitle", "time": 8702.79, "timestamp": "02:25:02", "text": "あなたはこれまで海外に住んだことがないんですよね？"}, {"type": "subtitle", "time": 8705.27, "timestamp": "02:25:05", "text": "いいえ、していません。"}, {"type": "subtitle", "time": 8709.429, "timestamp": "02:25:09", "text": "私にとっては初めてになります。"}, {"type": "subtitle", "time": 8712.71, "timestamp": "02:25:12", "text": "だから私はこう考えていた"}, {"type": "subtitle", "time": 8716.63, "timestamp": "02:25:16", "text": "ええ、あの曲"}, {"type": "subtitle", "time": 8719.429, "timestamp": "02:25:19", "text": "今は気をつけなければならない。何が起こるかわからない"}, {"type": "subtitle", "time": 8725.99, "timestamp": "02:25:25", "text": "そして"}, {"type": "subtitle", "time": 8729.349, "timestamp": "02:25:29", "text": "だから私は考えていた、"}, {"type": "subtitle", "time": 8732.71, "timestamp": "02:25:32", "text": "語学コースは2年で終わりました。"}, {"type": "subtitle", "time": 8736.469, "timestamp": "02:25:36", "text": "4年間の大学に行かないといけないんだよね"}, {"type": "subtitle", "time": 8738.87, "timestamp": "02:25:38", "text": "学位とか色々持って"}, {"type": "subtitle", "time": 8743.75, "timestamp": "02:25:43", "text": "信用スコアがあるので、私は安全です"}, {"type": "subtitle", "time": 8747.429, "timestamp": "02:25:47", "text": "ビザとかそういうの全部"}, {"type": "subtitle", "time": 8749.27, "timestamp": "02:25:49", "text": "今、私はその重要性を理解しました"}, {"type": "subtitle", "time": 8752.71, "timestamp": "02:25:52", "text": "現在の信用スコア"}, {"type": "subtitle", "time": 8755.349, "timestamp": "02:25:55", "text": "よし、自分で見つけなければならない"}, {"type": "subtitle", "time": 8759.19, "timestamp": "02:25:59", "text": "宿泊場所。おそらく私は"}]
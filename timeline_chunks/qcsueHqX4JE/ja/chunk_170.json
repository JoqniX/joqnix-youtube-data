[{"type": "subtitle", "time": 10200.07, "timestamp": "02:50:00", "text": "日本に着いたら、私の"}, {"type": "subtitle", "time": 10202.79, "timestamp": "02:50:02", "text": "自分自身で、すべてに対処しなければならない"}, {"type": "subtitle", "time": 10205.269, "timestamp": "02:50:05", "text": "自分自身。今、"}, {"type": "subtitle", "time": 10212.15, "timestamp": "02:50:12", "text": "それは何かになるだろう"}, {"type": "subtitle", "time": 10215.11, "timestamp": "02:50:15", "text": "バブル崩壊以来、日本は熟練した"}, {"type": "subtitle", "time": 10217.51, "timestamp": "02:50:17", "text": "重い国に場所を"}, {"type": "subtitle", "time": 10219.75, "timestamp": "02:50:19", "text": "そこに住んでいると、彼らは"}, {"type": "subtitle", "time": 10223.349, "timestamp": "02:50:23", "text": "雇用は、そうよりも。それもそうだ。"}, {"type": "subtitle", "time": 10225.269, "timestamp": "02:50:25", "text": "はい。はい。はい。はい。"}, {"type": "subtitle", "time": 10233.99, "timestamp": "02:50:33", "text": "それはかなりお金の中心となる男だ"}, {"type": "subtitle", "time": 10235.51, "timestamp": "02:50:35", "text": "それは価値が下がることを意味するだけです"}, {"type": "subtitle", "time": 10237.349, "timestamp": "02:50:37", "text": "インフレのため。あなたの"}, {"type": "subtitle", "time": 10239.19, "timestamp": "02:50:39", "text": "貯蓄は多くのものに投資されるべきである"}, {"type": "subtitle", "time": 10241.269, "timestamp": "02:50:41", "text": "投資信託。だから受動態にする"}]
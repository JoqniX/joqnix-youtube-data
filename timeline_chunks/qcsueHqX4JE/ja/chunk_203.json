[{"type": "subtitle", "time": 12181.59, "timestamp": "03:23:01", "text": "ルームメイトのためにできることはたくさんあります"}, {"type": "subtitle", "time": 12185.429, "timestamp": "03:23:05", "text": "今。私は料理をします。彼らは交代する。"}, {"type": "subtitle", "time": 12194.15, "timestamp": "03:23:14", "text": "幸せにはならないだろうと分かっている"}, {"type": "subtitle", "time": 12197.91, "timestamp": "03:23:17", "text": "golucky は、私が思うに、"}, {"type": "subtitle", "time": 12200.55, "timestamp": "03:23:20", "text": "アニメ。"}, {"type": "subtitle", "time": 12206.95, "timestamp": "03:23:26", "text": "ぜひ見てみたいですね。ええ、"}, {"type": "subtitle", "time": 12210.229, "timestamp": "03:23:30", "text": "今は誰かと話したり、そういうことをしてくれる人が欲しい。"}, {"type": "subtitle", "time": 12212.71, "timestamp": "03:23:32", "text": "でも、私もそうなるんじゃないかと心配なんです"}, {"type": "subtitle", "time": 12217.03, "timestamp": "03:23:37", "text": "ここは私の部屋にはうるさいし、色々問題があるんです。全て"}, {"type": "subtitle", "time": 12219.11, "timestamp": "03:23:39", "text": "右。それは小さな部屋のようなもので、"}, {"type": "subtitle", "time": 12221.83, "timestamp": "03:23:41", "text": "右？だから私は「私はそうしない」って言うんです"}, {"type": "subtitle", "time": 12225.269, "timestamp": "03:23:45", "text": "部屋が2つ欲しい。私はしたいです"}, {"type": "subtitle", "time": 12227.269, "timestamp": "03:23:47", "text": "シングルルームですが、それはまた"}, {"type": "subtitle", "time": 12229.67, "timestamp": "03:23:49", "text": "今は高価です。 6ヶ月間支払わなければならない"}, {"type": "subtitle", "time": 12232.95, "timestamp": "03:23:52", "text": "6か月ごとのドメトリー料金と"}, {"type": "subtitle", "time": 12235.59, "timestamp": "03:23:55", "text": "もの。どうやらあなたは選択できるようです"}]
[{"type": "subtitle", "time": 13981.83, "timestamp": "03:53:01", "text": "このドラマ、あるいは彼が言った、彼女が言った、これ"}, {"type": "subtitle", "time": 14000.389, "timestamp": "03:53:20", "text": "これが私が"}, {"type": "subtitle", "time": 14013.91, "timestamp": "03:53:33", "text": "なんてこった。"}, {"type": "subtitle", "time": 14031.269, "timestamp": "03:53:51", "text": "ああ、パラソーシャリズム、ヤンドレ、好きだよ"}, {"type": "subtitle", "time": 14035.11, "timestamp": "03:53:55", "text": "そういう類のもの。うん。うん。"}, {"type": "subtitle", "time": 14037.51, "timestamp": "03:53:57", "text": "昔はそういう感じだったんだけど"}]
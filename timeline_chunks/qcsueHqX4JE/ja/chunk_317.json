[{"type": "subtitle", "time": 19028.07, "timestamp": "05:17:08", "text": "人々はより多くの視聴回数があるドラマを求めている"}, {"type": "subtitle", "time": 19033.75, "timestamp": "05:17:13", "text": "人々がドラマを愛する理由がわからない"}, {"type": "subtitle", "time": 19047.11, "timestamp": "05:17:27", "text": "でも正直に言うと、私は"}, {"type": "subtitle", "time": 19050.47, "timestamp": "05:17:30", "text": "今日もまだ仕返しをするのは"}, {"type": "subtitle", "time": 19054.07, "timestamp": "05:17:34", "text": "なぜ謝罪がないのか？"}, {"type": "subtitle", "time": 19058.07, "timestamp": "05:17:38", "text": "なぜ公式謝罪がないのか？"}, {"type": "subtitle", "time": 19061.59, "timestamp": "05:17:41", "text": "えーと、被害者からとかではなく"}, {"type": "subtitle", "time": 19064.15, "timestamp": "05:17:44", "text": "ポスター"}, {"type": "subtitle", "time": 19067.67, "timestamp": "05:17:47", "text": "あなたは間違いを犯しました。あなたはそうしなかった"}, {"type": "subtitle", "time": 19071.51, "timestamp": "05:17:51", "text": "実際にはすべてを指していたわけではない"}, {"type": "subtitle", "time": 19075.43, "timestamp": "05:17:55", "text": "提供された情報。"}]
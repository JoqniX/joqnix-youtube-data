[{"type": "subtitle", "time": 12368.55, "timestamp": "03:26:08", "text": "それは正気の沙汰ではない。"}, {"type": "subtitle", "time": 12372.07, "timestamp": "03:26:12", "text": "本当にありがとうございました。"}, {"type": "subtitle", "time": 12374.71, "timestamp": "03:26:14", "text": "そして、私は、私は、私は、"}, {"type": "subtitle", "time": 12376.389, "timestamp": "03:26:16", "text": "あなたのコメント。読んだと思うけど、"}, {"type": "subtitle", "time": 12378.229, "timestamp": "03:26:18", "text": "読むのを忘れていました。"}, {"type": "subtitle", "time": 12387.83, "timestamp": "03:26:27", "text": "スピンモーター sh。おお。"}, {"type": "subtitle", "time": 12395.03, "timestamp": "03:26:35", "text": "何てことだ。"}, {"type": "subtitle", "time": 12398.469, "timestamp": "03:26:38", "text": "それはとても素晴らしいことですね。いいえ、できません"}, {"type": "subtitle", "time": 12401.75, "timestamp": "03:26:41", "text": "良い収入を得るなんて想像もできない"}, {"type": "subtitle", "time": 12404.469, "timestamp": "03:26:44", "text": "安定した金額。あなたが好きなもの"}, {"type": "subtitle", "time": 12406.71, "timestamp": "03:26:46", "text": "誰かを見ていて、あなたが望むのは"}, {"type": "subtitle", "time": 12409.349, "timestamp": "03:26:49", "text": "彼らを支援する"}, {"type": "subtitle", "time": 12411.91, "timestamp": "03:26:51", "text": "などなど。私もそうしたい"}, {"type": "subtitle", "time": 12415.83, "timestamp": "03:26:55", "text": "する。私は十分なお金を稼ぎたいし、"}, {"type": "subtitle", "time": 12417.67, "timestamp": "03:26:57", "text": "十分に安定しているので、他のものもサポートできます"}]
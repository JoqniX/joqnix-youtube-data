[{"type": "subtitle", "time": 8641.75, "timestamp": "02:24:01", "text": "盗まれた、それは特に"}, {"type": "subtitle", "time": 8646.23, "timestamp": "02:24:06", "text": "マイク、この男にこのマイクを渡さなければならない"}, {"type": "subtitle", "time": 8649.27, "timestamp": "02:24:09", "text": "コンデンサーマイクと"}, {"type": "subtitle", "time": 8651.67, "timestamp": "02:24:11", "text": "ダイナミックマイク"}, {"type": "subtitle", "time": 8653.83, "timestamp": "02:24:13", "text": "ASMRに使っているものと、"}, {"type": "subtitle", "time": 8656.87, "timestamp": "02:24:16", "text": "現代の通常のストリーミングでは。私は"}, {"type": "subtitle", "time": 8660.55, "timestamp": "02:24:20", "text": "両方取る。右。問題は私が感じたこと"}, {"type": "subtitle", "time": 8664.95, "timestamp": "02:24:24", "text": "私はとにかくその後"}, {"type": "subtitle", "time": 8669.03, "timestamp": "02:24:29", "text": "2年または"}, {"type": "subtitle", "time": 8672.79, "timestamp": "02:24:32", "text": "6ヶ月間、えっと、測定学のことです。"}, {"type": "subtitle", "time": 8676.389, "timestamp": "02:24:36", "text": "またしても、ややこしい出費がかさむ。だからその後"}, {"type": "subtitle", "time": 8682.55, "timestamp": "02:24:42", "text": "以前のドメトリ関連の作業は2年間で完了しました。"}, {"type": "subtitle", "time": 8685.27, "timestamp": "02:24:45", "text": "私はある意味で考えていました"}, {"type": "subtitle", "time": 8688.07, "timestamp": "02:24:48", "text": "最終的に"}, {"type": "subtitle", "time": 8690.63, "timestamp": "02:24:50", "text": "自分で住む場所を見つけなければならない"}, {"type": "subtitle", "time": 8693.03, "timestamp": "02:24:53", "text": "アパートとかフラットとか、そんな感じのもの"}, {"type": "subtitle", "time": 8698.15, "timestamp": "02:24:58", "text": "右にとどまる。えっと、"}]
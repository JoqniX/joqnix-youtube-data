[{"type": "subtitle", "time": 2765.589, "timestamp": "00:46:05", "text": "夜"}, {"type": "subtitle", "time": 2793.829, "timestamp": "00:46:33", "text": "[ため息] わかった。えーと、ミスティベール、それは"}, {"type": "subtitle", "time": 2796.95, "timestamp": "00:46:36", "text": "翼の進化、プライムのようだ"}, {"type": "subtitle", "time": 2800.47, "timestamp": "00:46:40", "text": "士気。 [ため息] えーと、待って、なぜ彼は"}, {"type": "subtitle", "time": 2803.43, "timestamp": "00:46:43", "text": "最高の静寂を手に入れる"}, {"type": "subtitle", "time": 2805.03, "timestamp": "00:46:45", "text": "ブラオフォン？"}, {"type": "subtitle", "time": 2813.589, "timestamp": "00:46:53", "text": "では、見てみましょう。"}, {"type": "subtitle", "time": 2816.309, "timestamp": "00:46:56", "text": "この人の動画。待って、誰がどこにいるの？"}, {"type": "subtitle", "time": 2818.39, "timestamp": "00:46:58", "text": "彼はそうなのか？"}]
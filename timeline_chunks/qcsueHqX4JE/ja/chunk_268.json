[{"type": "subtitle", "time": 16082.149, "timestamp": "04:28:02", "text": "私はインドでよくあるように、ひどいストリームです。"}, {"type": "subtitle", "time": 16096.55, "timestamp": "04:28:16", "text": "つまり、どのゲームかということですか？"}, {"type": "subtitle", "time": 16100.389, "timestamp": "04:28:20", "text": "ほとんどの人はストリーミングしません"}, {"type": "subtitle", "time": 16102.149, "timestamp": "04:28:22", "text": "えーと"}, {"type": "subtitle", "time": 16106.149, "timestamp": "04:28:26", "text": "メガ？ええ、私はメボンをプレイしたかったのですが"}, {"type": "subtitle", "time": 16110.555, "timestamp": "04:28:30", "text": "お金がない。通報しようかとさえ考えました。"}, {"type": "subtitle", "time": 16113.269, "timestamp": "04:28:33", "text": "[笑い] それで私はこう思った、ああ、そうなるだろう"}, {"type": "subtitle", "time": 16117.189, "timestamp": "04:28:37", "text": "君みたいになる"}, {"type": "subtitle", "time": 16120.63, "timestamp": "04:28:40", "text": "待って、世界記録みたいなものがあるよ。あなた"}, {"type": "subtitle", "time": 16138.07, "timestamp": "04:28:58", "text": "ゲーム開始。おお、いいね。"}]
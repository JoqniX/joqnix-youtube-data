[{"type": "subtitle", "time": 5461.11, "timestamp": "01:31:01", "text": "あるイベントで、「ああ、君は"}, {"type": "subtitle", "time": 5463.669, "timestamp": "01:31:03", "text": "人生の意味を理解した。あなたは自分が何を持っているか知っています"}, {"type": "subtitle", "time": 5466.149, "timestamp": "01:31:06", "text": "やるべきこと。あなたは人生において明確な目標を持っている"}, {"type": "subtitle", "time": 5468.39, "timestamp": "01:31:08", "text": "今。"}, {"type": "subtitle", "time": 5471.43, "timestamp": "01:31:11", "text": "あなたたちは、何が起こっているのかさえ知らない人たちです"}, {"type": "subtitle", "time": 5474.629, "timestamp": "01:31:14", "text": "ストリーミングや再アップロードは今や。」だから私が"}, {"type": "subtitle", "time": 5477.35, "timestamp": "01:31:17", "text": "これらすべてについて情熱的に語る"}, {"type": "subtitle", "time": 5480.709, "timestamp": "01:31:20", "text": "私の情熱的な口調で、彼らは"}, {"type": "subtitle", "time": 5484.07, "timestamp": "01:31:24", "text": "「わあ、本当にたくさんのものがあるんだな」という感じ。"}, {"type": "subtitle", "time": 5485.35, "timestamp": "01:31:25", "text": "どう思いますか？今でもプレイしていますか？"}, {"type": "subtitle", "time": 5488.07, "timestamp": "01:31:28", "text": "将来はこんな感じになるのかな？願わくば"}, {"type": "subtitle", "time": 5492.31, "timestamp": "01:31:32", "text": "できた。私はしたいです。"}, {"type": "subtitle", "time": 5494.87, "timestamp": "01:31:34", "text": "たとえビデオゲームがプレイできなくても、"}, {"type": "subtitle", "time": 5498.07, "timestamp": "01:31:38", "text": "少なくとも、自分が好きなことをできるなら"}, {"type": "subtitle", "time": 5501.99, "timestamp": "01:31:41", "text": "ライブ配信やトーク、シェアなど"}, {"type": "subtitle", "time": 5504.95, "timestamp": "01:31:44", "text": "私の人生についての知識や共有、または"}, {"type": "subtitle", "time": 5508.149, "timestamp": "01:31:48", "text": "何らかの方法で何かを作る"}, {"type": "subtitle", "time": 5511.75, "timestamp": "01:31:51", "text": "幸せそうな笑顔"}, {"type": "subtitle", "time": 5514.79, "timestamp": "01:31:54", "text": "それで十分だと思う。"}]
[{"type": "subtitle", "time": 18361.11, "timestamp": "05:06:01", "text": "このDiscordサーバーに参加して、"}, {"type": "subtitle", "time": 18362.868, "timestamp": "05:06:02", "text": "つながって友達を作り、"}, {"type": "subtitle", "time": 18365.59, "timestamp": "05:06:05", "text": "この空間にたった一人きり、ですよね？平"}, {"type": "subtitle", "time": 18368.47, "timestamp": "05:06:08", "text": "Twitch、K YouTube を利用しているなら、"}, {"type": "subtitle", "time": 18371.35, "timestamp": "05:06:11", "text": "どこでも。私は彼らが互いに繋がることを望んでいた"}, {"type": "subtitle", "time": 18374.47, "timestamp": "05:06:14", "text": "その他、うまく繋がり、良い友達を作る、"}, {"type": "subtitle", "time": 18377.03, "timestamp": "05:06:17", "text": "協力して、何かを作り、"}, {"type": "subtitle", "time": 18380.47, "timestamp": "05:06:20", "text": "良いコンテンツです。楽しんでください。"}, {"type": "subtitle", "time": 18382.55, "timestamp": "05:06:22", "text": "結局、それは劇的なものになった"}, {"type": "subtitle", "time": 18392.15, "timestamp": "05:06:32", "text": "Discordのボイスチャットに24時間365日時間を費やしている人々"}, {"type": "subtitle", "time": 18394.31, "timestamp": "05:06:34", "text": "ストリーミングではなく"}, {"type": "subtitle", "time": 18397.11, "timestamp": "05:06:37", "text": "あれこれ。 O"}, {"type": "subtitle", "time": 18400.07, "timestamp": "05:06:40", "text": "そして私はVCやDiscordにはほとんど参加しませんでした"}, {"type": "subtitle", "time": 18403.99, "timestamp": "05:06:43", "text": "VCs 主にストリーミングに集中していたので"}, {"type": "subtitle", "time": 18407.012, "timestamp": "05:06:47", "text": "私の持ち物について。"}, {"type": "subtitle", "time": 18407.75, "timestamp": "05:06:47", "text": "[ため息と息を呑む音]"}, {"type": "subtitle", "time": 18411.11, "timestamp": "05:06:51", "text": "わからない。うん、Discordのボイスチャットは楽しいね"}, {"type": "subtitle", "time": 18414.55, "timestamp": "05:06:54", "text": "正直に。はい。"}, {"type": "subtitle", "time": 18416.628, "timestamp": "05:06:56", "text": "今日私はDiscordに参加していました"}]
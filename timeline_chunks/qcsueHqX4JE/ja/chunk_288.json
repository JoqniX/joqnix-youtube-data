[{"type": "subtitle", "time": 17281.59, "timestamp": "04:48:01", "text": "YouTuberのマネージャーたちの間で何かが起こった"}, {"type": "subtitle", "time": 17283.59, "timestamp": "04:48:03", "text": "などなど。"}, {"type": "subtitle", "time": 17286.39, "timestamp": "04:48:06", "text": "彼らは多くのことを処理してくれる。"}, {"type": "subtitle", "time": 17289.35, "timestamp": "04:48:09", "text": "財政、あれこれ。"}, {"type": "subtitle", "time": 17292.788, "timestamp": "04:48:12", "text": "そして、その人と一緒に、"}, {"type": "subtitle", "time": 17295.51, "timestamp": "04:48:15", "text": "私がドラマで言及しなければならなかったこと"}, {"type": "subtitle", "time": 17297.83, "timestamp": "04:48:17", "text": "そして引きずらなければならなかったものすべて"}, {"type": "subtitle", "time": 17300.868, "timestamp": "04:48:20", "text": "彼女をこの状況に引きずり込んだ人々によって"}, {"type": "subtitle", "time": 17305.91, "timestamp": "04:48:25", "text": "彼女にとってこれはまるで声優のようだった。"}, {"type": "subtitle", "time": 17308.788, "timestamp": "04:48:28", "text": "彼女は声優のマネージャーみたいな存在だ"}, {"type": "subtitle", "time": 17312.55, "timestamp": "04:48:32", "text": "彼女がよく話していたことなど"}, {"type": "subtitle", "time": 17315.91, "timestamp": "04:48:35", "text": "彼女の物について、例えば彼女が昔どのように"}, {"type": "subtitle", "time": 17318.948, "timestamp": "04:48:38", "text": "声優やその他諸々を管理し、"}, {"type": "subtitle", "time": 17321.83, "timestamp": "04:48:41", "text": "彼女のスタジオとすべてのもの"}, {"type": "subtitle", "time": 17323.67, "timestamp": "04:48:43", "text": "そして全て。なんとなく理解できた"}, {"type": "subtitle", "time": 17326.708, "timestamp": "04:48:46", "text": "ああ、たくさんのことが"}, {"type": "subtitle", "time": 17329.19, "timestamp": "04:48:49", "text": "このマネジメントってやつ、知ってるでしょ、そして"}, {"type": "subtitle", "time": 17331.59, "timestamp": "04:48:51", "text": "それ自体が狂気だ"}, {"type": "subtitle", "time": 17335.03, "timestamp": "04:48:55", "text": "そして、これらのトップクリエイターの多くは、"}, {"type": "subtitle", "time": 17337.67, "timestamp": "04:48:57", "text": "彼らには独自のマネージャーやスタッフがいて"}]
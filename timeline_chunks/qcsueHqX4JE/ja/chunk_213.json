[{"type": "subtitle", "time": 12790.71, "timestamp": "03:33:10", "text": "これらすべてを自分で解決しなければならない。だからもし私が"}, {"type": "subtitle", "time": 12792.55, "timestamp": "03:33:12", "text": "誰かを自分の望む場所に置きたい、私はいつも"}, {"type": "subtitle", "time": 12796.95, "timestamp": "03:33:16", "text": "手伝ってみる。ああ、私もそう思う。"}, {"type": "subtitle", "time": 12799.51, "timestamp": "03:33:19", "text": "もしそれが私が知っていて、すでに"}, {"type": "subtitle", "time": 12801.67, "timestamp": "03:33:21", "text": "そのことで苦しんだ。例えば、"}, {"type": "subtitle", "time": 12805.19, "timestamp": "03:33:25", "text": "テクニカルサポート関連。"}, {"type": "subtitle", "time": 12808.15, "timestamp": "03:33:28", "text": "だから、これらの新しいユーチューバーたちは"}, {"type": "subtitle", "time": 12811.429, "timestamp": "03:33:31", "text": "そしてインドの企業系ユーチューバーたち、"}, {"type": "subtitle", "time": 12813.269, "timestamp": "03:33:33", "text": "彼らが問題を抱えているときはいつでも"}, {"type": "subtitle", "time": 12816.389, "timestamp": "03:33:36", "text": "OBSとか、こういうコンピューター関係のことは全部、"}, {"type": "subtitle", "time": 12819.349, "timestamp": "03:33:39", "text": "まあ、大丈夫だよ。手伝いますよ。私にさせて"}, {"type": "subtitle", "time": 12822.15, "timestamp": "03:33:42", "text": "私があなたの頭痛を引き受けて、"}, {"type": "subtitle", "time": 12824.469, "timestamp": "03:33:44", "text": "ゆっくりとやり方を教えます。たとえ"}, {"type": "subtitle", "time": 12834.15, "timestamp": "03:33:54", "text": "でも、あなたはストリーミング配信もしていますよね。"}, {"type": "subtitle", "time": 12836.87, "timestamp": "03:33:56", "text": "おお、"}, {"type": "subtitle", "time": 12839.349, "timestamp": "03:33:59", "text": "待って。あなたは配信者だった。どのように"}]
[{"type": "subtitle", "time": 18482.15, "timestamp": "05:08:02", "text": "待って、私たちはたくさんの話題について話しましたね。えっと"}, {"type": "subtitle", "time": 18483.91, "timestamp": "05:08:03", "text": "私たちはどのようにしてこの件に再び関わってくるのでしょうか？しかし"}, {"type": "subtitle", "time": 18493.75, "timestamp": "05:08:13", "text": "つまり、今日でも"}, {"type": "subtitle", "time": 18496.948, "timestamp": "05:08:16", "text": "関係した人々は、"}, {"type": "subtitle", "time": 18500.708, "timestamp": "05:08:20", "text": "直接的なもの。えっと"}, {"type": "subtitle", "time": 18504.23, "timestamp": "05:08:24", "text": "そう、私が名指しした人たちや"}, {"type": "subtitle", "time": 18507.83, "timestamp": "05:08:27", "text": "いわゆる少数の人々の友人"}, {"type": "subtitle", "time": 18510.15, "timestamp": "05:08:30", "text": "そして仲間のイアンのユーチューバーは誰も"}, {"type": "subtitle", "time": 18513.35, "timestamp": "05:08:33", "text": "謝罪した男性"}, {"type": "subtitle", "time": 18516.628, "timestamp": "05:08:36", "text": "もしくは、ただ私と話してください。できました"}, {"type": "subtitle", "time": 18518.628, "timestamp": "05:08:38", "text": "私は彼らを許したと言ったばかりです"}, {"type": "subtitle", "time": 18521.91, "timestamp": "05:08:41", "text": "実際、私は全員を許しました。"}, {"type": "subtitle", "time": 18523.83, "timestamp": "05:08:43", "text": "何？何？何が意味があるの？"}, {"type": "subtitle", "time": 18538.868, "timestamp": "05:08:58", "text": "えっと、問題はあなたが押しなかったことだと思います"}]
[{"type": "subtitle", "time": 2647.349, "timestamp": "00:44:07", "text": "待て、炎だ。ニラナ。涅槃"}, {"type": "subtitle", "time": 2679.43, "timestamp": "00:44:39", "text": "コア？私はイグナイトすら持っていません。どこ"}, {"type": "subtitle", "time": 2681.829, "timestamp": "00:44:41", "text": "点火ですか？"}, {"type": "subtitle", "time": 2684.309, "timestamp": "00:44:44", "text": "私はイグナイトを持っていません。私はそれを栽培しなければならない。"}, {"type": "subtitle", "time": 2687.67, "timestamp": "00:44:47", "text": "何てことだ。"}, {"type": "subtitle", "time": 2689.27, "timestamp": "00:44:49", "text": "えっと、"}, {"type": "subtitle", "time": 2699.349, "timestamp": "00:44:59", "text": "これは一体何ですか？炎のスペクトル。"}]
[{"type": "subtitle", "time": 11281.429, "timestamp": "03:08:01", "text": "ずっと緊張していた"}, {"type": "subtitle", "time": 11284.55, "timestamp": "03:08:04", "text": "9月。私はすごく"}, {"type": "subtitle", "time": 11287.11, "timestamp": "03:08:07", "text": "弁護士にあれこれ頼んで走り回って"}, {"type": "subtitle", "time": 11290.55, "timestamp": "03:08:10", "text": "これらのもの。えーっと、えーっと、まるで、えーっと、"}, {"type": "subtitle", "time": 11293.51, "timestamp": "03:08:13", "text": "休憩して、すべてから心を解放する"}, {"type": "subtitle", "time": 11298.15, "timestamp": "03:08:18", "text": "あれのことですよね？そして私は自分のイグノを恋しく思った"}, {"type": "subtitle", "time": 11301.429, "timestamp": "03:08:21", "text": "登録手続き。"}, {"type": "subtitle", "time": 11303.91, "timestamp": "03:08:23", "text": "通常登録時と同様"}, {"type": "subtitle", "time": 11307.11, "timestamp": "03:08:27", "text": "開く"}, {"type": "subtitle", "time": 11310.23, "timestamp": "03:08:30", "text": "えーっと、開くと、登録します"}, {"type": "subtitle", "time": 11312.79, "timestamp": "03:08:32", "text": "すぐに近くの"}, {"type": "subtitle", "time": 11317.11, "timestamp": "03:08:37", "text": "試験地域内の試験センターの近く。"}, {"type": "subtitle", "time": 11319.19, "timestamp": "03:08:39", "text": "だから私は15分か"}, {"type": "subtitle", "time": 11321.19, "timestamp": "03:08:41", "text": "試験会場まで10分。全て"}, {"type": "subtitle", "time": 11324.79, "timestamp": "03:08:44", "text": "右。しかし今回は、私はひどく遅れてしまった。私"}, {"type": "subtitle", "time": 11327.51, "timestamp": "03:08:47", "text": "10月に登録しなければならなかった。"}, {"type": "subtitle", "time": 11332.389, "timestamp": "03:08:52", "text": "最終日の1日前と"}, {"type": "subtitle", "time": 11334.469, "timestamp": "03:08:54", "text": "最終日の前日。だから私は"}, {"type": "subtitle", "time": 11337.03, "timestamp": "03:08:57", "text": "持ち帰り"}]
[{"type": "subtitle", "time": 3065.27, "timestamp": "00:51:05", "text": "そうそう。神秘的な魔術師はいつ"}, {"type": "subtitle", "time": 3075.589, "timestamp": "00:51:15", "text": "2日間。今回はこれを終わらせることができます"}, {"type": "subtitle", "time": 3080.87, "timestamp": "00:51:20", "text": "良い。今日は"}, {"type": "subtitle", "time": 3082.47, "timestamp": "00:51:22", "text": "私は自分が何をすべきか決めなければならない。"}, {"type": "subtitle", "time": 3110.95, "timestamp": "00:51:50", "text": "また、1.38も持っています。"}, {"type": "subtitle", "time": 3113.67, "timestamp": "00:51:53", "text": "えっと、秘密の文字みたいな。"}, {"type": "subtitle", "time": 3115.91, "timestamp": "00:51:55", "text": "レベッカを走らせるべきか考えていた"}, {"type": "subtitle", "time": 3119.51, "timestamp": "00:51:59", "text": "そして2つ目の重複品を入手する"}]
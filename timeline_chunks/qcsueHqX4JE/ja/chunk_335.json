[{"type": "subtitle", "time": 20102.628, "timestamp": "05:35:02", "text": "ああ、フォートナイトの配信は一度もやったことがないんです。私"}, {"type": "subtitle", "time": 20106.39, "timestamp": "05:35:06", "text": "フォートナイトの配信をしていたのを覚えている。"}, {"type": "subtitle", "time": 20109.03, "timestamp": "05:35:09", "text": "私の本名はアペリオンです。"}, {"type": "subtitle", "time": 20112.31, "timestamp": "05:35:12", "text": "アパリオン。アパロン。私は正しく発音しただろうか"}, {"type": "subtitle", "time": 20114.868, "timestamp": "05:35:14", "text": "正しく理解できましたか？"}, {"type": "subtitle", "time": 20117.67, "timestamp": "05:35:17", "text": "アパロン。"}, {"type": "subtitle", "time": 20122.31, "timestamp": "05:35:22", "text": "ああ、わかりました。プレイリストを入手しました。 17. ということで、"}, {"type": "subtitle", "time": 20125.91, "timestamp": "05:35:25", "text": "18歳ですよね？"}, {"type": "subtitle", "time": 20128.628, "timestamp": "05:35:28", "text": "また、その順序も間違っています。その"}, {"type": "subtitle", "time": 20131.19, "timestamp": "05:35:31", "text": "新しい動画のトップ"}, {"type": "subtitle", "time": 20133.35, "timestamp": "05:35:33", "text": "プレイリスト。"}, {"type": "subtitle", "time": 20136.708, "timestamp": "05:35:36", "text": "16. ああ、明久のやつだ。だから私は"}, {"type": "subtitle", "time": 20139.03, "timestamp": "05:35:39", "text": "配信はしていません。"}]
[{"type": "subtitle", "time": 19753.43, "timestamp": "05:29:13", "text": "では、さらに何が必要なのでしょうか？ Googleで調べてみよう"}, {"type": "subtitle", "time": 19768.708, "timestamp": "05:29:28", "text": "ええ、その話題はドラマを通して持ち上がりました。"}, {"type": "subtitle", "time": 19772.23, "timestamp": "05:29:32", "text": "夜には本物を手に入れよう。すみません、私はよく喋ります"}, {"type": "subtitle", "time": 19773.99, "timestamp": "05:29:33", "text": "夜になると。うん、そうだよ"}, {"type": "subtitle", "time": 19776.31, "timestamp": "05:29:36", "text": "それには気づきました。取り残されることへの恐怖。わかった。"}, {"type": "subtitle", "time": 19778.31, "timestamp": "05:29:38", "text": "こんにちは。ありがとう。"}, {"type": "subtitle", "time": 19780.15, "timestamp": "05:29:40", "text": "ロックっぽい感じはしないな。"}, {"type": "subtitle", "time": 19783.59, "timestamp": "05:29:43", "text": "ああ、知らなかったよ。それも1つです"}, {"type": "subtitle", "time": 19791.59, "timestamp": "05:29:51", "text": "だからd"}, {"type": "subtitle", "time": 19794.548, "timestamp": "05:29:54", "text": "俺たちはただ、兄弟が何について話してるか"}, {"type": "subtitle", "time": 19798.39, "timestamp": "05:29:58", "text": "私の演劇活動で実際に起こったことです。"}]
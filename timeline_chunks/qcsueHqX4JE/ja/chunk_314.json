[{"type": "subtitle", "time": 18842.39, "timestamp": "05:14:02", "text": "なぜなら彼はたくさん調査して話をしたから"}, {"type": "subtitle", "time": 18845.19, "timestamp": "05:14:05", "text": "他の人は自分の意見をすべて得て"}, {"type": "subtitle", "time": 18846.868, "timestamp": "05:14:06", "text": "コミュニティ全体に関する事柄"}, {"type": "subtitle", "time": 18849.11, "timestamp": "05:14:09", "text": "あれこれ全部"}, {"type": "subtitle", "time": 18853.67, "timestamp": "05:14:13", "text": "そして彼は理解しました"}, {"type": "subtitle", "time": 18856.39, "timestamp": "05:14:16", "text": "コミュニティはそれをどのように使うかについて正しい"}, {"type": "subtitle", "time": 18859.03, "timestamp": "05:14:19", "text": "彼らが私に対して使った力は、他の者たちを倒すために使われた。"}, {"type": "subtitle", "time": 18861.35, "timestamp": "05:14:21", "text": "人々はこれを集団的に嫌っており、"}, {"type": "subtitle", "time": 18865.27, "timestamp": "05:14:25", "text": "その通り"}, {"type": "subtitle", "time": 18867.11, "timestamp": "05:14:27", "text": "そして"}, {"type": "subtitle", "time": 18870.948, "timestamp": "05:14:30", "text": "ええ、それに彼は依頼された仕事で忙しいんです。"}, {"type": "subtitle", "time": 18874.55, "timestamp": "05:14:34", "text": "それで彼は「ああ、彼はそれを持っている」と言った"}, {"type": "subtitle", "time": 18876.788, "timestamp": "05:14:36", "text": "保存しましたが、何か起こった場合は"}, {"type": "subtitle", "time": 18878.868, "timestamp": "05:14:38", "text": "将来彼はそれをリリースするだけか"}, {"type": "subtitle", "time": 18881.75, "timestamp": "05:14:41", "text": "何かあるけど、もし彼が"}, {"type": "subtitle", "time": 18883.91, "timestamp": "05:14:43", "text": "パート2の動画をアップロードしました"}, {"type": "subtitle", "time": 18886.47, "timestamp": "05:14:46", "text": "動画を更新すると、"}, {"type": "subtitle", "time": 18890.47, "timestamp": "05:14:50", "text": "またドラマですね、でもそれは続くでしょう"}, {"type": "subtitle", "time": 18893.19, "timestamp": "05:14:53", "text": "ビデオ証拠、歴史的証拠として、"}, {"type": "subtitle", "time": 18897.83, "timestamp": "05:14:57", "text": "右？そう、この空間にはドラマがあった。"}]
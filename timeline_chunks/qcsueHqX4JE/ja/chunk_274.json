[{"type": "subtitle", "time": 16444.789, "timestamp": "04:34:04", "text": "だから私は、"}, {"type": "subtitle", "time": 16451.83, "timestamp": "04:34:11", "text": "バスのようなものの依頼"}, {"type": "subtitle", "time": 16456.15, "timestamp": "04:34:16", "text": "手数料は、実際には"}, {"type": "subtitle", "time": 16458.551, "timestamp": "04:34:18", "text": "私はコミッションをやることさえ考えました"}, {"type": "subtitle", "time": 16461.51, "timestamp": "04:34:21", "text": "オープニングなどのコミッション"}, {"type": "subtitle", "time": 16463.349, "timestamp": "04:34:23", "text": "Discordの設定などのコミッション"}, {"type": "subtitle", "time": 16465.349, "timestamp": "04:34:25", "text": "サーバーとかそういうの、昔やってたから"}, {"type": "subtitle", "time": 16467.83, "timestamp": "04:34:27", "text": "インド人ユーチューバー全員にとって良いことだ。"}, {"type": "subtitle", "time": 16471.029, "timestamp": "04:34:31", "text": "英語でも企業向け"}, {"type": "subtitle", "time": 16473.189, "timestamp": "04:34:33", "text": "など"}, {"type": "subtitle", "time": 16475.75, "timestamp": "04:34:35", "text": "えーと、死体とかそういうやつ。"}, {"type": "subtitle", "time": 16479.029, "timestamp": "04:34:39", "text": "以前は無料でやっていました"}, {"type": "subtitle", "time": 16481.349, "timestamp": "04:34:41", "text": "技術サポート関連"}, {"type": "subtitle", "time": 16482.869, "timestamp": "04:34:42", "text": "無料。"}, {"type": "subtitle", "time": 16487.59, "timestamp": "04:34:47", "text": "それで私はこうなった"}, {"type": "subtitle", "time": 16489.51, "timestamp": "04:34:49", "text": "ああ、そう、私はこういう人間になったんだ（笑）。"}, {"type": "subtitle", "time": 16491.769, "timestamp": "04:34:51", "text": "以前はDiscordサーバーをセットアップしていた人"}, {"type": "subtitle", "time": 16496.15, "timestamp": "04:34:56", "text": "[息を呑む] 2021年にYouTuberがそれを使って"}, {"type": "subtitle", "time": 16499.029, "timestamp": "04:34:59", "text": "そして私は燃え尽きてしまい、正直"}]
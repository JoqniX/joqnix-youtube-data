[{"type": "subtitle", "time": 8342.23, "timestamp": "02:19:02", "text": "それに、屋外にいるときもそうですよね？プラス、"}, {"type": "subtitle", "time": 8345.03, "timestamp": "02:19:05", "text": "旅行中"}, {"type": "subtitle", "time": 8348.549, "timestamp": "02:19:08", "text": "それに、PCを最後まで持ち運ぶこともできない"}, {"type": "subtitle", "time": 8350.709, "timestamp": "02:19:10", "text": "日本へ、ですよね？"}, {"type": "subtitle", "time": 8353.509, "timestamp": "02:19:13", "text": "荷物の問題とその他すべて、"}, {"type": "subtitle", "time": 8356.709, "timestamp": "02:19:16", "text": "重量とか、フライトとか。"}, {"type": "subtitle", "time": 8358.389, "timestamp": "02:19:18", "text": "神のみぞ知る、私はどんなフライトに乗るのか"}, {"type": "subtitle", "time": 8361.27, "timestamp": "02:19:21", "text": "重量がどれくらいになるかを知るために"}, {"type": "subtitle", "time": 8364.23, "timestamp": "02:19:24", "text": "なれ。"}, {"type": "subtitle", "time": 8371.19, "timestamp": "02:19:31", "text": "私は一部のMTXとは話せません。ああ。"}, {"type": "subtitle", "time": 8375.75, "timestamp": "02:19:35", "text": "ええ、それは本当です。私はMacを使っています。"}, {"type": "subtitle", "time": 8378.389, "timestamp": "02:19:38", "text": "仕事用のノートパソコンとして使いたいんです。"}, {"type": "subtitle", "time": 8385.83, "timestamp": "02:19:45", "text": "だから、主に私がやりたいことは"}, {"type": "subtitle", "time": 8388.309, "timestamp": "02:19:48", "text": "YouTube、ゲーム、ストリーミング。私はしませんでした"}, {"type": "subtitle", "time": 8390.63, "timestamp": "02:19:50", "text": "全てやり直す。それでおしまい。"}, {"type": "subtitle", "time": 8393.59, "timestamp": "02:19:53", "text": "つまり、50シリーズのノートパソコン、良い"}]
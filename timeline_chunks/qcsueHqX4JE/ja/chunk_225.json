[{"type": "subtitle", "time": 13502.229, "timestamp": "03:45:02", "text": "それは小さいですね。本当に小さいものです。"}, {"type": "subtitle", "time": 13506.229, "timestamp": "03:45:06", "text": "私はそれを買って、練習を始めた。"}, {"type": "subtitle", "time": 13508.63, "timestamp": "03:45:08", "text": "私が初めて話したのは"}, {"type": "subtitle", "time": 13512.55, "timestamp": "03:45:12", "text": "マルチプレイヤーゲーム ビデオゲーム"}, {"type": "subtitle", "time": 13516.07, "timestamp": "03:45:16", "text": "えっと、ボイスチャットを使っています。私は本当に"}, {"type": "subtitle", "time": 13518.469, "timestamp": "03:45:18", "text": "楽しかった。それから私はゆっくりと"}, {"type": "subtitle", "time": 13521.269, "timestamp": "03:45:21", "text": "これらを保管してください"}, {"type": "subtitle", "time": 13525.03, "timestamp": "03:45:25", "text": "課題や優先事項、あるいはこのタスク"}, {"type": "subtitle", "time": 13527.429, "timestamp": "03:45:27", "text": "私自身は英語を話すつもりです"}, {"type": "subtitle", "time": 13530.63, "timestamp": "03:45:30", "text": "もっと。もっと話します"}, {"type": "subtitle", "time": 13532.87, "timestamp": "03:45:32", "text": "そして時間が経つにつれて私はかなり"}, {"type": "subtitle", "time": 13535.83, "timestamp": "03:45:35", "text": "心地よく、それが今の私を形作った。"}, {"type": "subtitle", "time": 13539.269, "timestamp": "03:45:39", "text": "今日はそうかな。わからない。"}, {"type": "subtitle", "time": 13541.269, "timestamp": "03:45:41", "text": "ネジのアクセント。あなたが持っているかどうかもわかりません"}, {"type": "subtitle", "time": 13543.11, "timestamp": "03:45:43", "text": "性別。"}]
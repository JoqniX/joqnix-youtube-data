[{"type": "subtitle", "time": 14166.229, "timestamp": "03:56:06", "text": "その名前 [笑い]"}, {"type": "subtitle", "time": 14174.469, "timestamp": "03:56:14", "text": "最近はよくわかりません。あまりない。いいえ、違います"}, {"type": "subtitle", "time": 14191.03, "timestamp": "03:56:31", "text": "私は本当の友達でいることに抵抗はありません"}, {"type": "subtitle", "time": 14193.67, "timestamp": "03:56:33", "text": "ストリーマー、でも私がお願いするのは"}, {"type": "subtitle", "time": 14202.469, "timestamp": "03:56:42", "text": "友達になっても構わない"}, {"type": "subtitle", "time": 14205.349, "timestamp": "03:56:45", "text": "制作者または視聴者"}, {"type": "subtitle", "time": 14210.79, "timestamp": "03:56:50", "text": "彼らが私を普通に扱ってくれる限り"}, {"type": "subtitle", "time": 14213.11, "timestamp": "03:56:53", "text": "普通の友達として、といった感じで。ない"}]
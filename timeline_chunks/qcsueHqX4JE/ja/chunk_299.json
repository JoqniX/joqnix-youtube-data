[{"type": "subtitle", "time": 17941.75, "timestamp": "04:59:01", "text": "えっと"}, {"type": "subtitle", "time": 17944.628, "timestamp": "04:59:04", "text": "たくさんのいいえ"}, {"type": "subtitle", "time": 17949.27, "timestamp": "04:59:09", "text": "でも、本当にいろいろなことがありました。"}, {"type": "subtitle", "time": 17950.868, "timestamp": "04:59:10", "text": "嘘はつきません。ちょうど"}, {"type": "subtitle", "time": 17953.11, "timestamp": "04:59:13", "text": "あなたの"}, {"type": "subtitle", "time": 17954.788, "timestamp": "04:59:14", "text": "ドラマの内容はこうだった。挑戦だと思います"}, {"type": "subtitle", "time": 17957.83, "timestamp": "04:59:17", "text": "いつも言う"}, {"type": "subtitle", "time": 17960.95, "timestamp": "04:59:20", "text": "はい、わかりました。"}, {"type": "subtitle", "time": 17963.67, "timestamp": "04:59:23", "text": "[笑い声とため息] ええ、私は"}, {"type": "subtitle", "time": 17965.67, "timestamp": "04:59:25", "text": "でもメッセージを読んだら、"}, {"type": "subtitle", "time": 17968.948, "timestamp": "04:59:28", "text": "これはラジオドラマだと気づいた"}, {"type": "subtitle", "time": 17977.03, "timestamp": "04:59:37", "text": "実際に読んでいる人はあまりいない"}, {"type": "subtitle", "time": 17980.868, "timestamp": "04:59:40", "text": "全体を見るか、もっと深く掘り下げて"}, {"type": "subtitle", "time": 17985.27, "timestamp": "04:59:45", "text": "オレンジと"}, {"type": "subtitle", "time": 17987.35, "timestamp": "04:59:47", "text": "スピリットとエマはよくやった"}, {"type": "subtitle", "time": 17991.75, "timestamp": "04:59:51", "text": "まるで、その全てを否定するようなものだ。"}, {"type": "subtitle", "time": 17993.51, "timestamp": "04:59:53", "text": "待って、自動機があった。待って、"}, {"type": "subtitle", "time": 17997.75, "timestamp": "04:59:57", "text": "Twitchで確認してみてください。ちょっと待って。"}, {"type": "subtitle", "time": 17999.83, "timestamp": "04:59:59", "text": "彼らは、"}]
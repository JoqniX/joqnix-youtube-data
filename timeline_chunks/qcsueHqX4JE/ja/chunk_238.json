[{"type": "subtitle", "time": 14289.349, "timestamp": "03:58:09", "text": "久しぶりですね。いいえ、それは"}, {"type": "subtitle", "time": 14292.95, "timestamp": "03:58:12", "text": "そうですよね？私は信じている"}, {"type": "subtitle", "time": 14295.59, "timestamp": "03:58:15", "text": "えっと"}, {"type": "subtitle", "time": 14313.51, "timestamp": "03:58:33", "text": "うん。うん。うん。サブマラソンの前に、"}, {"type": "subtitle", "time": 14317.83, "timestamp": "03:58:37", "text": "君は僕がサバマラソンをしている最中に来てくれたんだね。"}, {"type": "subtitle", "time": 14321.11, "timestamp": "03:58:41", "text": "今思い出した"}, {"type": "subtitle", "time": 14325.11, "timestamp": "03:58:45", "text": "私は、Valerantで私を追加することはできません。"}, {"type": "subtitle", "time": 14327.51, "timestamp": "03:58:47", "text": "あなたが望むなら。"}, {"type": "subtitle", "time": 14332.469, "timestamp": "03:58:52", "text": "ええと、もしプレイすることがあったら追加しておきますね。"}, {"type": "subtitle", "time": 14336.07, "timestamp": "03:58:56", "text": "次はジョット・ネクスト・オックスであるべきだ。"}, {"type": "subtitle", "time": 14338.55, "timestamp": "03:58:58", "text": "私の連絡先はそのままにしておいてください。私たちは遊ぶことができます"}]
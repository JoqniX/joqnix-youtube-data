[{"type": "subtitle", "time": 13811.91, "timestamp": "03:50:11", "text": "スピリットとオレンジだけだと思う​​。"}, {"type": "subtitle", "time": 13815.11, "timestamp": "03:50:15", "text": "アジア人向けMODのみ。ああ、エドゥマも"}, {"type": "subtitle", "time": 13818.469, "timestamp": "03:50:18", "text": "別の人。"}, {"type": "subtitle", "time": 13822.79, "timestamp": "03:50:22", "text": "私も毛皮の方に惹かれていました。"}, {"type": "subtitle", "time": 13825.429, "timestamp": "03:50:25", "text": "ヴィマがたくさんある。"}, {"type": "subtitle", "time": 13828.63, "timestamp": "03:50:28", "text": "今は面白いですね。待って、気づいた"}, {"type": "subtitle", "time": 13831.51, "timestamp": "03:50:31", "text": "今すぐそうする。"}, {"type": "subtitle", "time": 13834.469, "timestamp": "03:50:34", "text": "それは人々が次のように考えているからでしょうか"}, {"type": "subtitle", "time": 13838.229, "timestamp": "03:50:38", "text": "そう、この業界、つまりこれ"}, {"type": "subtitle", "time": 13842.229, "timestamp": "03:50:42", "text": "スペースは支配的なリーダーの槍の中にあります"}, {"type": "subtitle", "time": 13845.269, "timestamp": "03:50:45", "text": "女性ユーチューバーが圧倒的に多いですよね"}, {"type": "subtitle", "time": 13848.309, "timestamp": "03:50:48", "text": "彼らがそれについて笑うなら"}, {"type": "subtitle", "time": 13852.07, "timestamp": "03:50:52", "text": "うまくいくかもしれないし、よくわからない"}, {"type": "subtitle", "time": 13854.87, "timestamp": "03:50:54", "text": "男性ユーチューバーにとっては運次第みたいなものだ"}]
[{"type": "subtitle", "time": 18662.868, "timestamp": "05:11:02", "text": "あれこれとこんな感じ"}, {"type": "subtitle", "time": 18665.67, "timestamp": "05:11:05", "text": "そして私はよく叱られました[笑]"}, {"type": "subtitle", "time": 18667.35, "timestamp": "05:11:07", "text": "手伝ってくれた人たちとか。"}, {"type": "subtitle", "time": 18670.788, "timestamp": "05:11:10", "text": "いいえ、ジョーのように、あなたは自分がどれだけ"}, {"type": "subtitle", "time": 18672.628, "timestamp": "05:11:12", "text": "失った"}, {"type": "subtitle", "time": 18676.07, "timestamp": "05:11:16", "text": "そして、あなたはそれを続けなければならない"}, {"type": "subtitle", "time": 18677.91, "timestamp": "05:11:17", "text": "のように"}, {"type": "subtitle", "time": 18681.99, "timestamp": "05:11:21", "text": "攻撃的にならないように言ってください"}, {"type": "subtitle", "time": 18684.55, "timestamp": "05:11:24", "text": "攻撃側にならなくて、ただ"}, {"type": "subtitle", "time": 18692.07, "timestamp": "05:11:32", "text": "そして話が終わってしばらく経ってから"}, {"type": "subtitle", "time": 18693.59, "timestamp": "05:11:33", "text": "私は「よし、明かそう」と思った"}, {"type": "subtitle", "time": 18701.11, "timestamp": "05:11:41", "text": "そして今となってはもう手遅れのような気がする"}, {"type": "subtitle", "time": 18706.948, "timestamp": "05:11:46", "text": "今となっては、私にはもう手遅れです"}, {"type": "subtitle", "time": 18709.91, "timestamp": "05:11:49", "text": "そこから何か対策を講じる。さらに、私は"}, {"type": "subtitle", "time": 18714.07, "timestamp": "05:11:54", "text": "そもそもそれが動くかどうかもわからない。"}, {"type": "subtitle", "time": 18717.27, "timestamp": "05:11:57", "text": "それが何なのかさえわからない。"}, {"type": "subtitle", "time": 18719.91, "timestamp": "05:11:59", "text": "それがどんなものかさえわからない"}]
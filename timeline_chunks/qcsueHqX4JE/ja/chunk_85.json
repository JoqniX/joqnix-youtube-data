[{"type": "subtitle", "time": 5101.75, "timestamp": "01:25:01", "text": "人々のことやあらゆること、"}, {"type": "subtitle", "time": 5104.229, "timestamp": "01:25:04", "text": "だから私は「ああ、私は一人ぼっちだ」と思った。私はしません"}, {"type": "subtitle", "time": 5105.83, "timestamp": "01:25:05", "text": "人数が多いので、私一人でやります。"}, {"type": "subtitle", "time": 5110.229, "timestamp": "01:25:10", "text": "それが私の考え方だった。以前は"}, {"type": "subtitle", "time": 5113.669, "timestamp": "01:25:13", "text": "すべて自分でやります。"}, {"type": "subtitle", "time": 5116.629, "timestamp": "01:25:16", "text": "私は以前は人に頼ったり依存したりしていなかった"}, {"type": "subtitle", "time": 5118.149, "timestamp": "01:25:18", "text": "なぜなら"}, {"type": "subtitle", "time": 5120.31, "timestamp": "01:25:20", "text": "人々は他の人は遅いし私は"}, {"type": "subtitle", "time": 5122.39, "timestamp": "01:25:22", "text": "自分でやればもっと"}, {"type": "subtitle", "time": 5125.91, "timestamp": "01:25:25", "text": "それら全てを一貫して"}, {"type": "subtitle", "time": 5129.11, "timestamp": "01:25:29", "text": "そしてある意味で私は自分が"}, {"type": "subtitle", "time": 5132.87, "timestamp": "01:25:32", "text": "何でも屋だが、どれも一流ではない、ということでしょうか。"}, {"type": "subtitle", "time": 5137.03, "timestamp": "01:25:37", "text": "常にすべてをバランスよく保つのは難しい"}, {"type": "subtitle", "time": 5139.11, "timestamp": "01:25:39", "text": "燃え尽きた後、私は理解した"}, {"type": "subtitle", "time": 5142.39, "timestamp": "01:25:42", "text": "うん、時々ね"}, {"type": "subtitle", "time": 5144.709, "timestamp": "01:25:44", "text": "だから彼女はそんなことはしないだろう。集中するだけ"}, {"type": "subtitle", "time": 5149.11, "timestamp": "01:25:49", "text": "あなたがやりたいたった一つのことに集中して"}, {"type": "subtitle", "time": 5150.95, "timestamp": "01:25:50", "text": "あなたが何をしたいのかまだ理解しています"}, {"type": "subtitle", "time": 5159.75, "timestamp": "01:25:59", "text": "そして私にとっては、"}, {"type": "chat", "time": 5159.971, "timestamp": "01:25:59", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "that's why Im asking you you can't be all time joqnix"}]
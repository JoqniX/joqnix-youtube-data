[{"type": "subtitle", "time": 10020.71, "timestamp": "02:47:00", "text": "マーク。"}, {"type": "subtitle", "time": 10022.95, "timestamp": "02:47:02", "text": "それは"}, {"type": "subtitle", "time": 10025.91, "timestamp": "02:47:05", "text": "知っている"}, {"type": "subtitle", "time": 10029.429, "timestamp": "02:47:09", "text": "私の場合は、座って"}, {"type": "subtitle", "time": 10032.55, "timestamp": "02:47:12", "text": "15分か10分くらい考えて質問するような感じ"}, {"type": "subtitle", "time": 10034.87, "timestamp": "02:47:14", "text": "犬みたいに、私に何ができるだろうか"}, {"type": "subtitle", "time": 10037.51, "timestamp": "02:47:17", "text": "私にとっては良い戦略であり、"}, {"type": "subtitle", "time": 10039.19, "timestamp": "02:47:19", "text": "すべて"}, {"type": "subtitle", "time": 10042.87, "timestamp": "02:47:22", "text": "まるで、"}, {"type": "subtitle", "time": 10045.51, "timestamp": "02:47:25", "text": "4歳まではそれを何と呼ぶのですか"}, {"type": "subtitle", "time": 10049.59, "timestamp": "02:47:29", "text": "コースの残りの部分は、まるで私の上にあるかのようです"}, {"type": "subtitle", "time": 10051.67, "timestamp": "02:47:31", "text": "右"}, {"type": "subtitle", "time": 10053.67, "timestamp": "02:47:33", "text": "仕事もすべてでしたが、"}, {"type": "subtitle", "time": 10058.15, "timestamp": "02:47:38", "text": "共同大学を探すような"}, {"type": "subtitle", "time": 10059.91, "timestamp": "02:47:39", "text": "日本には統一された信用制度がない"}, {"type": "subtitle", "time": 10064.07, "timestamp": "02:47:44", "text": "FIやSILのようなスコアシステムとは何ですか？"}, {"type": "subtitle", "time": 10067.11, "timestamp": "02:47:47", "text": "それらは私が知らないものです"}, {"type": "subtitle", "time": 10069.429, "timestamp": "02:47:49", "text": "私もこのクレジットについて混乱しています"}]
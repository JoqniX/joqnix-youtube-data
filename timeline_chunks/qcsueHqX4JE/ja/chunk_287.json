[{"type": "subtitle", "time": 17223.99, "timestamp": "04:47:03", "text": "だから、それで、私の、あの人の"}, {"type": "subtitle", "time": 17228.39, "timestamp": "04:47:08", "text": "ケースでは、彼らは良い成長を遂げました"}, {"type": "subtitle", "time": 17231.91, "timestamp": "04:47:11", "text": "彼らが始めた頃はYouTuberとして"}, {"type": "subtitle", "time": 17234.628, "timestamp": "04:47:14", "text": "それから私は彼らのファンの一人だと思うか"}, {"type": "subtitle", "time": 17236.868, "timestamp": "04:47:16", "text": "何かまたは誰かが"}, {"type": "subtitle", "time": 17240.07, "timestamp": "04:47:20", "text": "一般的に彼らのマネージャーになる"}, {"type": "subtitle", "time": 17243.27, "timestamp": "04:47:23", "text": "えーと彼らのマネージャーになって、彼らは"}, {"type": "subtitle", "time": 17246.47, "timestamp": "04:47:26", "text": "彼らのアパートの住居として"}, {"type": "subtitle", "time": 17250.07, "timestamp": "04:47:30", "text": "彼らは今、フラットのような"}, {"type": "subtitle", "time": 17253.59, "timestamp": "04:47:33", "text": "アパートを運営する両親"}, {"type": "subtitle", "time": 17255.91, "timestamp": "04:47:35", "text": "アパートみたいなもの。それで彼らはこう言った"}, {"type": "subtitle", "time": 17259.99, "timestamp": "04:47:39", "text": "彼らは今では隣人のようなマネージャーなので"}, {"type": "subtitle", "time": 17265.67, "timestamp": "04:47:45", "text": "無料 無料 無料 住宅 生活 生活"}, {"type": "subtitle", "time": 17269.91, "timestamp": "04:47:49", "text": "などなど。だからあなたの給料は、あなたが管理する"}, {"type": "subtitle", "time": 17271.91, "timestamp": "04:47:51", "text": "チャンネルを利用すれば無料で生活できます"}, {"type": "subtitle", "time": 17276.39, "timestamp": "04:47:56", "text": "そして、その場合はまさにそれです。うん。"}, {"type": "subtitle", "time": 17278.708, "timestamp": "04:47:58", "text": "でも、本当に多くのことを学びました。"}]
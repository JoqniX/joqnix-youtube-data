[{"type": "subtitle", "time": 12903.03, "timestamp": "03:35:03", "text": "そして、私の演劇活動が終わった後に話をした。"}, {"type": "subtitle", "time": 12904.87, "timestamp": "03:35:04", "text": "起こった。"}, {"type": "subtitle", "time": 12908.229, "timestamp": "03:35:08", "text": "どうやらみんな私のことを知っていたようで、"}, {"type": "subtitle", "time": 12911.75, "timestamp": "03:35:11", "text": "私たちは少し話をした。彼はストリーミング配信している"}, {"type": "subtitle", "time": 12916.229, "timestamp": "03:35:16", "text": "新しい別のTwitchチャンネル、"}, {"type": "subtitle", "time": 12918.95, "timestamp": "03:35:18", "text": "もっと違うタイプの"}, {"type": "subtitle", "time": 12921.03, "timestamp": "03:35:21", "text": "コンテンツ。あなたの配信をずっと見ています"}, {"type": "subtitle", "time": 12926.71, "timestamp": "03:35:26", "text": "Twitchで個人的な友達がいるのは誰？"}, {"type": "subtitle", "time": 12930.15, "timestamp": "03:35:30", "text": "もの？ああ、"}, {"type": "subtitle", "time": 12933.59, "timestamp": "03:35:33", "text": "そうだね"}, {"type": "subtitle", "time": 12936.469, "timestamp": "03:35:36", "text": "それはすごくクールだね。"}, {"type": "subtitle", "time": 12939.11, "timestamp": "03:35:39", "text": "ジョージにスタッフがいるなんて知らなかった"}]
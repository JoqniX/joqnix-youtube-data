[{"type": "subtitle", "time": 9000.63, "timestamp": "02:30:00", "text": "私のために [笑い]"}, {"type": "subtitle", "time": 9002.79, "timestamp": "02:30:02", "text": "私のために来てくれるんでしょ？そう思うよ"}, {"type": "subtitle", "time": 9009.429, "timestamp": "02:30:09", "text": "安全。それから、仕事を探さなきゃいけない"}, {"type": "subtitle", "time": 9012.15, "timestamp": "02:30:12", "text": "右。"}, {"type": "subtitle", "time": 9016.87, "timestamp": "02:30:16", "text": "それで先生が言った"}, {"type": "subtitle", "time": 9019.27, "timestamp": "02:30:19", "text": "えーと、どんなコースを受講しても"}, {"type": "subtitle", "time": 9021.99, "timestamp": "02:30:21", "text": "案件。それは大学のブランドです"}, {"type": "subtitle", "time": 9024.79, "timestamp": "02:30:24", "text": "それは就職に関係する。もしあなたが"}, {"type": "subtitle", "time": 9029.349, "timestamp": "02:30:29", "text": "大学に入学したら"}, {"type": "subtitle", "time": 9034.07, "timestamp": "02:30:34", "text": "良い評判を持っている"}, {"type": "subtitle", "time": 9037.83, "timestamp": "02:30:37", "text": "えーといい名前とか、すごく大きいとか"}, {"type": "subtitle", "time": 9041.75, "timestamp": "02:30:41", "text": "そうすれば簡単に良い仕事に就くことができ、"}, {"type": "subtitle", "time": 9044.469, "timestamp": "02:30:44", "text": "彼らが言ったこと、私は混乱しています"}, {"type": "subtitle", "time": 9048.15, "timestamp": "02:30:48", "text": "音響音楽大学に行くべきでしょうか？"}, {"type": "subtitle", "time": 9050.87, "timestamp": "02:30:50", "text": "今は音楽を追求したいと思っているので"}, {"type": "subtitle", "time": 9055.11, "timestamp": "02:30:55", "text": "4番目はそれでいいですか？ はい。"}, {"type": "subtitle", "time": 9057.67, "timestamp": "02:30:57", "text": "そして私が選んだ学校は、言語"}]
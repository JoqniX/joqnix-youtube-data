[{"type": "subtitle", "time": 19260.948, "timestamp": "05:21:00", "text": "私は、もし私が完全に"}, {"type": "subtitle", "time": 19268.868, "timestamp": "05:21:08", "text": "ああ、一人ぼっち、"}, {"type": "subtitle", "time": 19271.19, "timestamp": "05:21:11", "text": "私は...するだろう"}, {"type": "subtitle", "time": 19275.59, "timestamp": "05:21:15", "text": "どうしたらいいのかわからない"}, {"type": "subtitle", "time": 19277.83, "timestamp": "05:21:17", "text": "だって、まるで私がドラマに出演したことがないみたいだから。"}, {"type": "subtitle", "time": 19281.91, "timestamp": "05:21:21", "text": "いいえ、何をすればいいのか全く分かりません。"}, {"type": "subtitle", "time": 19284.23, "timestamp": "05:21:24", "text": "私はツイッターのドラマを消費し、"}, {"type": "subtitle", "time": 19286.788, "timestamp": "05:21:26", "text": "面白半分で"}, {"type": "subtitle", "time": 19290.55, "timestamp": "05:21:30", "text": "またはこれらのユーチューバードラマをオンラインで視聴する"}, {"type": "subtitle", "time": 19293.51, "timestamp": "05:21:33", "text": "ドラマやビデオなどを見て、"}, {"type": "subtitle", "time": 19296.708, "timestamp": "05:21:36", "text": "退屈だから夜寝る。私はできません"}, {"type": "subtitle", "time": 19298.39, "timestamp": "05:21:38", "text": "寝る。だから私はただ聞いて"}, {"type": "subtitle", "time": 19300.23, "timestamp": "05:21:40", "text": "何が何だか分からないままビデオ"}, {"type": "subtitle", "time": 19302.708, "timestamp": "05:21:42", "text": "本当に落ち込んだ。私は実際には支払いません"}, {"type": "subtitle", "time": 19305.59, "timestamp": "05:21:45", "text": "これらの点に注意を払う。"}, {"type": "subtitle", "time": 19308.55, "timestamp": "05:21:48", "text": "そして私自身のドラマに巻き込まれたとき"}, {"type": "subtitle", "time": 19311.03, "timestamp": "05:21:51", "text": "サブ、私はこう思った、"}, {"type": "subtitle", "time": 19318.07, "timestamp": "05:21:58", "text": "でも、たくさんの人が私にこう言った"}]
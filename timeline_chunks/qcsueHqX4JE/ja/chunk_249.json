[{"type": "subtitle", "time": 14941.03, "timestamp": "04:09:01", "text": "認証済みの電話番号とか、"}, {"type": "subtitle", "time": 14943.59, "timestamp": "04:09:03", "text": "すべて。そこで私は話をした"}, {"type": "subtitle", "time": 14947.189, "timestamp": "04:09:07", "text": "このボットの問題について。いいえ。"}, {"type": "subtitle", "time": 14950.79, "timestamp": "04:09:10", "text": "そう、そしてそのうちの1つもすべて"}, {"type": "subtitle", "time": 14952.95, "timestamp": "04:09:12", "text": "以下のことについて説明しました"}, {"type": "subtitle", "time": 14957.11, "timestamp": "04:09:17", "text": "チャットと私は最近よく"}, {"type": "subtitle", "time": 14961.51, "timestamp": "04:09:21", "text": "インド人は皆従っている"}, {"type": "subtitle", "time": 14963.83, "timestamp": "04:09:23", "text": "それから私は、もしそれが"}, {"type": "subtitle", "time": 14966.07, "timestamp": "04:09:26", "text": "フォロワー限定"}, {"type": "subtitle", "time": 14968.309, "timestamp": "04:09:28", "text": "いや、むしろ私は"}, {"type": "subtitle", "time": 14971.11, "timestamp": "04:09:31", "text": "フォローするというのは、むしろ人々が欲しいということです"}, {"type": "subtitle", "time": 14978.469, "timestamp": "04:09:38", "text": "人々は拭き取りのようなものを手に入れると思っていた"}, {"type": "subtitle", "time": 14980.71, "timestamp": "04:09:40", "text": "チェックして、1つくらい見てください"}, {"type": "subtitle", "time": 14982.389, "timestamp": "04:09:42", "text": "1分または30秒。では、こうすれば"}, {"type": "subtitle", "time": 14985.03, "timestamp": "04:09:45", "text": "ストリーマーが興味があればそれで構いません"}, {"type": "subtitle", "time": 14987.51, "timestamp": "04:09:47", "text": "そして彼らはついてきて、"}, {"type": "subtitle", "time": 14992.63, "timestamp": "04:09:52", "text": "会話か何か正しい"}, {"type": "subtitle", "time": 14995.51, "timestamp": "04:09:55", "text": "確認には対話が必要です。"}]
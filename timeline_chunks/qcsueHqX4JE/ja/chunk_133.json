[{"type": "subtitle", "time": 7983.109, "timestamp": "02:13:03", "text": "えっと、もっとコメントください"}, {"type": "subtitle", "time": 7986.79, "timestamp": "02:13:06", "text": "など。よし、見てみよう。私は「どんな感じ？」と尋ねました。"}, {"type": "subtitle", "time": 7989.43, "timestamp": "02:13:09", "text": "よし、それではどうなるか見てみよう"}, {"type": "subtitle", "time": 7993.35, "timestamp": "02:13:13", "text": "言う。また、ジャジップはジャジップです"}, {"type": "subtitle", "time": 7995.83, "timestamp": "02:13:15", "text": "インディアナ州ではGoは無料です。とても美味しいです。私"}, {"type": "subtitle", "time": 8010.629, "timestamp": "02:13:30", "text": "検索中です。時間がかかるので、"}, {"type": "subtitle", "time": 8015.189, "timestamp": "02:13:35", "text": "探すのにとても時間がかかった。一体どういうことだ？"}, {"type": "subtitle", "time": 8018.47, "timestamp": "02:13:38", "text": "これは何ですか？時間がかかりすぎている。"}, {"type": "subtitle", "time": 8021.109, "timestamp": "02:13:41", "text": "日本に特化した検索をするようなものだ"}, {"type": "subtitle", "time": 8023.99, "timestamp": "02:13:43", "text": "ノートパソコン。 Lenovoのように検索しています"}, {"type": "subtitle", "time": 8026.55, "timestamp": "02:13:46", "text": "ギガバイト。"}, {"type": "subtitle", "time": 8028.87, "timestamp": "02:13:48", "text": "一体どういうことだ？それは徹底的な調査だ。何"}, {"type": "subtitle", "time": 8039.03, "timestamp": "02:13:59", "text": "私は簡単な質問をした。"}]
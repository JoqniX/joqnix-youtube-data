[{"type": "subtitle", "time": 14102.469, "timestamp": "03:55:02", "text": "友人や"}, {"type": "subtitle", "time": 14109.349, "timestamp": "03:55:09", "text": "あの友達全員"}, {"type": "subtitle", "time": 14114.95, "timestamp": "03:55:14", "text": "だって私の場合は、以前は私は"}, {"type": "subtitle", "time": 14117.83, "timestamp": "03:55:17", "text": "私は人に好かれようとするタイプだと感じています。"}, {"type": "subtitle", "time": 14120.79, "timestamp": "03:55:20", "text": "私はまず他のことを優先し、それから"}, {"type": "subtitle", "time": 14124.15, "timestamp": "03:55:24", "text": "自分自身。それは悪い考え方だった。"}, {"type": "subtitle", "time": 14126.79, "timestamp": "03:55:26", "text": "今はゆっくりと試してみます"}, {"type": "subtitle", "time": 14134.229, "timestamp": "03:55:34", "text": "自分自身を向上させるために今取り組んでいる"}, {"type": "subtitle", "time": 14137.269, "timestamp": "03:55:37", "text": "そして私は自分が以前そうしていたことに気づいた"}, {"type": "subtitle", "time": 14140.469, "timestamp": "03:55:40", "text": "視聴者も同様です。どんな"}, {"type": "subtitle", "time": 14142.79, "timestamp": "03:55:42", "text": "視聴者の要望に応えます。"}, {"type": "subtitle", "time": 14147.189, "timestamp": "03:55:47", "text": "そういう、そういう、そういうこと。"}, {"type": "subtitle", "time": 14148.87, "timestamp": "03:55:48", "text": "しかし"}, {"type": "subtitle", "time": 14152.63, "timestamp": "03:55:52", "text": "そして、それは良くないことだと気づいた。いいえ、"}, {"type": "subtitle", "time": 14155.429, "timestamp": "03:55:55", "text": "私はエンターテイナーです。私の仕事は何ですか？私の"}]
[{"type": "subtitle", "time": 10380.389, "timestamp": "02:53:00", "text": "他に欲しいものは、"}, {"type": "subtitle", "time": 10382.71, "timestamp": "02:53:02", "text": "インフレーション。デイトレードはフルタイムの仕事です"}, {"type": "subtitle", "time": 10384.23, "timestamp": "02:53:04", "text": "成熟して分割する仕事"}, {"type": "subtitle", "time": 10386.389, "timestamp": "02:53:06", "text": "株式とややリスクのあるポートフォリオ"}, {"type": "subtitle", "time": 10401.269, "timestamp": "02:53:21", "text": "受動収入って、正直言ってね"}, {"type": "subtitle", "time": 10404.07, "timestamp": "02:53:24", "text": "話すと、私はいつもあなたが"}, {"type": "subtitle", "time": 10407.429, "timestamp": "02:53:27", "text": "一生懸命働けば、何らかの形で報われる"}, {"type": "subtitle", "time": 10411.03, "timestamp": "02:53:31", "text": "もの。だから私は"}, {"type": "subtitle", "time": 10414.55, "timestamp": "02:53:34", "text": "うん、一生懸命頑張れば、"}, {"type": "subtitle", "time": 10418.15, "timestamp": "02:53:38", "text": "よくやった、私は"}, {"type": "subtitle", "time": 10420.95, "timestamp": "02:53:40", "text": "いつか人生で報われる日が来るでしょう。平"}, {"type": "subtitle", "time": 10422.63, "timestamp": "02:53:42", "text": "私は苦しみ、もがいているけれど"}, {"type": "subtitle", "time": 10425.99, "timestamp": "02:53:45", "text": "今、いつか私の努力が報われる日が来る"}, {"type": "subtitle", "time": 10429.03, "timestamp": "02:53:49", "text": "支払いは済ませるだろうし、いろいろと。だから私は"}, {"type": "subtitle", "time": 10430.63, "timestamp": "02:53:50", "text": "のように"}, {"type": "subtitle", "time": 10432.95, "timestamp": "02:53:52", "text": "私はこれらの暗号通貨をすべてやりたくない"}, {"type": "subtitle", "time": 10436.469, "timestamp": "02:53:56", "text": "これら他のお金の稼ぎ方。欲しい"}]
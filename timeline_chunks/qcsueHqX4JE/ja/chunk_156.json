[{"type": "subtitle", "time": 9375.99, "timestamp": "02:36:15", "text": "つまり、給与は私の収入に連動しているということです。"}, {"type": "subtitle", "time": 9384.55, "timestamp": "02:36:24", "text": "インド。待って、あなたは今どこにいますか？"}, {"type": "subtitle", "time": 9387.27, "timestamp": "02:36:27", "text": "あなたは今インドにいますか、それとも別の場所にいますか？"}, {"type": "subtitle", "time": 9394.95, "timestamp": "02:36:34", "text": "それはなかなかいいですね。現在旅行中で"}, {"type": "subtitle", "time": 9396.87, "timestamp": "02:36:36", "text": "もの。"}, {"type": "subtitle", "time": 9399.03, "timestamp": "02:36:39", "text": "旅行することは私の夢の一つでもあります"}, {"type": "subtitle", "time": 9401.99, "timestamp": "02:36:41", "text": "世界。"}, {"type": "subtitle", "time": 9404.23, "timestamp": "02:36:44", "text": "のように"}, {"type": "subtitle", "time": 9407.59, "timestamp": "02:36:47", "text": "人々がいることを知ったとき"}, {"type": "subtitle", "time": 9410.95, "timestamp": "02:36:50", "text": "世界中を旅してお金を稼ぐ、私は"}, {"type": "subtitle", "time": 9414.309, "timestamp": "02:36:54", "text": "いや、マジで、"}, {"type": "subtitle", "time": 9418.15, "timestamp": "02:36:58", "text": "ああ、私もそんな生活を送りたい。"}]
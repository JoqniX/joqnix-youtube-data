[{"type": "subtitle", "time": 12720.469, "timestamp": "03:32:00", "text": "これにはたくさんの要素が詰まっている。とても"}, {"type": "subtitle", "time": 12729.83, "timestamp": "03:32:09", "text": "今の生活。これらを体験しなければならない"}, {"type": "subtitle", "time": 12731.99, "timestamp": "03:32:11", "text": "苦難。それはまるで障害物のようだ。その"}, {"type": "subtitle", "time": 12738.87, "timestamp": "03:32:18", "text": "専門的な立場で。私は"}, {"type": "subtitle", "time": 12742.15, "timestamp": "03:32:22", "text": "お勧めしません。"}, {"type": "subtitle", "time": 12745.782, "timestamp": "03:32:25", "text": "でも僕はただのチャット参加者です。"}, {"type": "subtitle", "time": 12746.87, "timestamp": "03:32:26", "text": "[笑い]"}, {"type": "subtitle", "time": 12749.349, "timestamp": "03:32:29", "text": "でも、あなたは私にたくさんの知識を与えてくれています。"}, {"type": "subtitle", "time": 12752.15, "timestamp": "03:32:32", "text": "だから私は決して"}, {"type": "subtitle", "time": 12756.79, "timestamp": "03:32:36", "text": "私は今まで知らなかったんです。だから、私は本当に"}]
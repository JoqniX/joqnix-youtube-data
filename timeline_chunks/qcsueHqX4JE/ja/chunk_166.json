[{"type": "subtitle", "time": 9968.71, "timestamp": "02:46:08", "text": "私はインドでインターンをしているので幸せです"}, {"type": "subtitle", "time": 9971.429, "timestamp": "02:46:11", "text": "私は国際給与を受け取っていますが、"}, {"type": "subtitle", "time": 9987.75, "timestamp": "02:46:27", "text": "待って、待って、待って、待って、待って、待って。また"}, {"type": "subtitle", "time": 9995.91, "timestamp": "02:46:35", "text": "あなたの言語発火センターが始動すると"}, {"type": "subtitle", "time": 9997.91, "timestamp": "02:46:37", "text": "カーソルについて話すと、彼らはすでに"}, {"type": "subtitle", "time": 9999.67, "timestamp": "02:46:39", "text": "もはやあなたの最善の利益にはならない"}, {"type": "subtitle", "time": 10001.349, "timestamp": "02:46:41", "text": "心。それはどういう意味ですか？"}, {"type": "subtitle", "time": 10004.23, "timestamp": "02:46:44", "text": "精巧な。いや、いや。まるで彼らは"}, {"type": "subtitle", "time": 10006.95, "timestamp": "02:46:46", "text": "私にいいねをくれる"}, {"type": "subtitle", "time": 10010.469, "timestamp": "02:46:50", "text": "私に教えてくれる、えっと、"}, {"type": "subtitle", "time": 10012.95, "timestamp": "02:46:52", "text": "重要なことですよね？"}, {"type": "subtitle", "time": 10016.389, "timestamp": "02:46:56", "text": "私にできることとか、そういうことですよね？"}, {"type": "subtitle", "time": 10018.15, "timestamp": "02:46:58", "text": "疑問符。疑問符 疑問"}]
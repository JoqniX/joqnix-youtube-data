[{"type": "subtitle", "time": 12600.07, "timestamp": "03:30:00", "text": "UPI のせいで日記を書いたのは、"}, {"type": "subtitle", "time": 12604.55, "timestamp": "03:30:04", "text": "仕事と私のための当座預金口座を作る"}, {"type": "subtitle", "time": 12607.11, "timestamp": "03:30:07", "text": "銀行"}, {"type": "subtitle", "time": 12608.87, "timestamp": "03:30:08", "text": "当座預金口座には、"}, {"type": "subtitle", "time": 12611.19, "timestamp": "03:30:11", "text": "個人事業主が登録済み"}, {"type": "subtitle", "time": 12614.95, "timestamp": "03:30:14", "text": "仕事。だから、そうせざるを得なかったんです。となることによって"}, {"type": "subtitle", "time": 12619.429, "timestamp": "03:30:19", "text": "インド出身の人が"}, {"type": "subtitle", "time": 12623.349, "timestamp": "03:30:23", "text": "私のUPIに直接寄付を送ると、"}, {"type": "subtitle", "time": 12626.07, "timestamp": "03:30:26", "text": "自分の名前とか個人情報を晒したりはしませんよ。それで"}, {"type": "subtitle", "time": 12628.309, "timestamp": "03:30:28", "text": "私はそうせざるを得なかった"}, {"type": "subtitle", "time": 12631.349, "timestamp": "03:30:31", "text": "そしてどうやら私は"}, {"type": "subtitle", "time": 12634.87, "timestamp": "03:30:34", "text": "学生たちは、"}, {"type": "subtitle", "time": 12638.309, "timestamp": "03:30:38", "text": "私が通うのと同じ学校です。彼らは行った"}, {"type": "subtitle", "time": 12641.51, "timestamp": "03:30:41", "text": "次のように続けた"}, {"type": "subtitle", "time": 12645.349, "timestamp": "03:30:45", "text": "えーと、彼らは、えーと、彼らは、"}, {"type": "subtitle", "time": 12649.51, "timestamp": "03:30:49", "text": "今年の4月にLAの語学学校に通います。"}, {"type": "subtitle", "time": 12651.349, "timestamp": "03:30:51", "text": "ええ、私は7月にいるはずなんです"}, {"type": "subtitle", "time": 12654.95, "timestamp": "03:30:54", "text": "今年のバッチですが、"}, {"type": "subtitle", "time": 12657.51, "timestamp": "03:30:57", "text": "遅延などの何らかの問題が発生しました"}]
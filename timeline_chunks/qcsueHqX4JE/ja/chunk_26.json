[{"type": "subtitle", "time": 1591.669, "timestamp": "00:26:31", "text": "もっとこういうことをする必要がある気がする"}, {"type": "subtitle", "time": 1595.029, "timestamp": "00:26:35", "text": "悪魔、えーと悪魔バッジまたはキャラクター"}, {"type": "subtitle", "time": 1597.43, "timestamp": "00:26:37", "text": "何かしてない気がするから"}, {"type": "subtitle", "time": 1600.31, "timestamp": "00:26:40", "text": "甚大な被害。"}, {"type": "subtitle", "time": 1602.63, "timestamp": "00:26:42", "text": "特に私のレベッカ。私はそうではない、私はそうではない"}]
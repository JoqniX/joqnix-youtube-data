[{"type": "subtitle", "time": 5775.27, "timestamp": "01:36:15", "text": "私たちはそれをあそこに置いて、"}, {"type": "subtitle", "time": 5778.31, "timestamp": "01:36:18", "text": "さあ、水を飲んでください。皆さん、水分補給をしてください。"}, {"type": "subtitle", "time": 5805.669, "timestamp": "01:36:45", "text": "ああ、それは悪い考えだった"}, {"type": "subtitle", "time": 5808.55, "timestamp": "01:36:48", "text": "今。よし、それで彼を数回殴って"}, {"type": "subtitle", "time": 5810.709, "timestamp": "01:36:50", "text": "そして、究極のことをする。その時は"}, {"type": "subtitle", "time": 5812.79, "timestamp": "01:36:52", "text": "さらなる被害。"}]
[{"type": "subtitle", "time": 9780.79, "timestamp": "02:43:00", "text": "ああ、この男は臭いか何かだ"}, {"type": "subtitle", "time": 9783.59, "timestamp": "02:43:03", "text": "そして、そして"}, {"type": "subtitle", "time": 9785.75, "timestamp": "02:43:05", "text": "アメリカ人の男が彼を何と見ているのか"}, {"type": "subtitle", "time": 9788.07, "timestamp": "02:43:08", "text": "一体どういうことだ"}, {"type": "subtitle", "time": 9791.67, "timestamp": "02:43:11", "text": "そしてサラリーマンは、私は全員を尊敬している"}, {"type": "subtitle", "time": 9794.55, "timestamp": "02:43:14", "text": "外国人とかそういうの全部で、私はこう思う、"}, {"type": "subtitle", "time": 9796.23, "timestamp": "02:43:16", "text": "\"おお、"}, {"type": "subtitle", "time": 9799.11, "timestamp": "02:43:19", "text": "私は今その治療を受けるつもりです、"}, {"type": "subtitle", "time": 9803.429, "timestamp": "02:43:23", "text": "何か。分からない。場合による。"}, {"type": "subtitle", "time": 9805.83, "timestamp": "02:43:25", "text": "なぜなら"}, {"type": "subtitle", "time": 9807.83, "timestamp": "02:43:27", "text": "自分がいる方がずっといい気がする"}, {"type": "subtitle", "time": 9811.19, "timestamp": "02:43:31", "text": "一人でいるよりも、グループでいる方が良い。それで、"}, {"type": "subtitle", "time": 9813.27, "timestamp": "02:43:33", "text": "もっと安全に過ごせるようになると思う。私"}, {"type": "subtitle", "time": 9821.429, "timestamp": "02:43:41", "text": "彼は子供が欲しいが、"}, {"type": "subtitle", "time": 9823.03, "timestamp": "02:43:43", "text": "日本の労働文化と事実"}, {"type": "subtitle", "time": 9825.103, "timestamp": "02:43:45", "text": "彼は本当にひどい給料をもらっている、よくあることだ"}, {"type": "subtitle", "time": 9827.429, "timestamp": "02:43:47", "text": "[音楽] 日本で、有料のスキル、ええと、"}, {"type": "subtitle", "time": 9829.75, "timestamp": "02:43:49", "text": "給与スキルは最悪だ。彼は"}, {"type": "subtitle", "time": 9833.03, "timestamp": "02:43:53", "text": "一つ持っています。ああ、人生を"}, {"type": "subtitle", "time": 9835.83, "timestamp": "02:43:55", "text": "アニメに関する決定。 [笑い]"}, {"type": "subtitle", "time": 9838.309, "timestamp": "02:43:58", "text": "うん。"}]
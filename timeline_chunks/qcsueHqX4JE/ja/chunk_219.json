[{"type": "subtitle", "time": 13146.646, "timestamp": "03:39:06", "text": "火災の消火活動をしています。"}, {"type": "subtitle", "time": 13169.429, "timestamp": "03:39:29", "text": "私は良い関係を築いたと感じています"}, {"type": "subtitle", "time": 13171.269, "timestamp": "03:39:31", "text": "会社っぽい、"}, {"type": "subtitle", "time": 13174.389, "timestamp": "03:39:34", "text": "しかし、今はまだスタートアップ企業ですが、"}, {"type": "subtitle", "time": 13177.99, "timestamp": "03:39:37", "text": "それも、良い結末にはならなかった。しかし、"}, {"type": "subtitle", "time": 13180.07, "timestamp": "03:39:40", "text": "契約内容も全て素晴らしかったです。"}, {"type": "subtitle", "time": 13182.79, "timestamp": "03:39:42", "text": "わかった。"}, {"type": "subtitle", "time": 13185.269, "timestamp": "03:39:45", "text": "人々が"}, {"type": "subtitle", "time": 13187.51, "timestamp": "03:39:47", "text": "これは本当の種類のものだとわかるでしょう"}, {"type": "subtitle", "time": 13190.95, "timestamp": "03:39:50", "text": "あれ。しかし残念ながら、それは単なるスタイルであり"}, {"type": "subtitle", "time": 13194.309, "timestamp": "03:39:54", "text": "うまくいかなかった。"}, {"type": "subtitle", "time": 13197.51, "timestamp": "03:39:57", "text": "もし物事がうまくいけば、私は"}, {"type": "subtitle", "time": 13199.83, "timestamp": "03:39:59", "text": "才能を見れば、そこにいただろう。私"}]
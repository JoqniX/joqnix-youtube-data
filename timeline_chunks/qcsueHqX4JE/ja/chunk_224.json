[{"type": "subtitle", "time": 13440.15, "timestamp": "03:44:00", "text": "学校でも話していたし、"}, {"type": "subtitle", "time": 13442.309, "timestamp": "03:44:02", "text": "高校とかそういうこと。"}, {"type": "subtitle", "time": 13445.269, "timestamp": "03:44:05", "text": "私は昔は物静かな子供だった。"}, {"type": "subtitle", "time": 13446.79, "timestamp": "03:44:06", "text": "でもストリーミングを始めたときは、"}, {"type": "subtitle", "time": 13449.51, "timestamp": "03:44:09", "text": "例えば、私はYouTuberになりたいんです。しかし"}, {"type": "subtitle", "time": 13452.71, "timestamp": "03:44:12", "text": "自分の顔でビデオを録画するのはまるで"}, {"type": "subtitle", "time": 13456.55, "timestamp": "03:44:16", "text": "恥ずかしくて、本当に気まずい。私はこう思った。"}, {"type": "subtitle", "time": 13459.67, "timestamp": "03:44:19", "text": "私は、ストリーマーではない人たちと同じように、"}, {"type": "subtitle", "time": 13463.189, "timestamp": "03:44:23", "text": "ゲームプレイとかそういうことだけ。だから私はそうした"}, {"type": "subtitle", "time": 13465.189, "timestamp": "03:44:25", "text": "しばらくの間。そして私はVtubingを発見した。"}, {"type": "subtitle", "time": 13467.67, "timestamp": "03:44:27", "text": "そして、それに従って行動しようとした。だから"}, {"type": "subtitle", "time": 13469.83, "timestamp": "03:44:29", "text": "最初は、私はこのように設定していました"}, {"type": "subtitle", "time": 13473.03, "timestamp": "03:44:33", "text": "目標は、私が5分間話すことです"}, {"type": "subtitle", "time": 13478.229, "timestamp": "03:44:38", "text": "あるいは1段落、もしくは10文程度"}, {"type": "subtitle", "time": 13481.99, "timestamp": "03:44:41", "text": "えっと、私がストリームで10文を書いている間に"}, {"type": "subtitle", "time": 13486.469, "timestamp": "03:44:46", "text": "ゲームとか色々やってるよ。"}, {"type": "subtitle", "time": 13488.469, "timestamp": "03:44:48", "text": "そして私は初めて"}, {"type": "subtitle", "time": 13490.389, "timestamp": "03:44:50", "text": "マイクロフォン"}, {"type": "subtitle", "time": 13494.07, "timestamp": "03:44:54", "text": "100ルピーくらいの安いマイク"}, {"type": "subtitle", "time": 13498.07, "timestamp": "03:44:58", "text": "Amazonでは200ルピーです。"}]
[{"type": "subtitle", "time": 17701.59, "timestamp": "04:55:01", "text": "4人か5人の変な人たち。"}, {"type": "subtitle", "time": 17705.27, "timestamp": "04:55:05", "text": "一人は自殺願望があり、もう一人は攻撃的で、"}, {"type": "subtitle", "time": 17709.99, "timestamp": "04:55:09", "text": "1つは奇妙で奇妙で、もう1つは"}, {"type": "subtitle", "time": 17712.708, "timestamp": "04:55:12", "text": "えっと、一方はもう一方と友達になりたかった"}, {"type": "subtitle", "time": 17717.19, "timestamp": "04:55:17", "text": "私が友達のYouTuberなどなど。"}, {"type": "subtitle", "time": 17718.868, "timestamp": "04:55:18", "text": "それ以来、私は「よし、私は"}, {"type": "subtitle", "time": 17721.19, "timestamp": "04:55:21", "text": "友達として人を追加するのが終わりました"}, {"type": "subtitle", "time": 17722.868, "timestamp": "04:55:22", "text": "不和"}, {"type": "subtitle", "time": 17725.43, "timestamp": "04:55:25", "text": "視聴者とかそういうのが好きなんです。"}, {"type": "subtitle", "time": 17729.27, "timestamp": "04:55:29", "text": "これを制限してください。覚えておいてください"}, {"type": "subtitle", "time": 17731.83, "timestamp": "04:55:31", "text": "状況は戻って、あなたは単純に私の"}, {"type": "subtitle", "time": 17735.11, "timestamp": "04:55:35", "text": "ケース 私は好奇心が強すぎたので、なぜ"}, {"type": "subtitle", "time": 17738.07, "timestamp": "04:55:38", "text": "彼らはこのような考え方を持っているが、私は"}, {"type": "subtitle", "time": 17740.23, "timestamp": "04:55:40", "text": "なぜ彼らがこれを好きなのか知りたい"}, {"type": "subtitle", "time": 17745.59, "timestamp": "04:55:45", "text": "そして、どうすればそれらをインプットできるか、あるいは何か"}, {"type": "subtitle", "time": 17747.51, "timestamp": "04:55:47", "text": "まるで私が直せるようなもの"}, {"type": "subtitle", "time": 17750.23, "timestamp": "04:55:50", "text": "考えてみて、ああ、できないと気づいた"}, {"type": "subtitle", "time": 17752.55, "timestamp": "04:55:52", "text": "他の人を直して、他の人にアドバイスをする"}, {"type": "subtitle", "time": 17756.23, "timestamp": "04:55:56", "text": "私自身が自分の"}]
[{"type": "subtitle", "time": 18541.35, "timestamp": "05:09:01", "text": "十分に難しい。"}, {"type": "subtitle", "time": 18543.99, "timestamp": "05:09:03", "text": "兄弟を許してはいけません。"}, {"type": "subtitle", "time": 18546.31, "timestamp": "05:09:06", "text": "彼らはあなたのために祈った。それは本当です。はい、"}, {"type": "subtitle", "time": 18548.494, "timestamp": "05:09:08", "text": "彼らはそうした。"}, {"type": "subtitle", "time": 18549.802, "timestamp": "05:09:09", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 18555.11, "timestamp": "05:09:15", "text": "ええ、まさに今言おうと思っていたんです。なぜ"}, {"type": "subtitle", "time": 18557.43, "timestamp": "05:09:17", "text": "私はそれを法的な問題として扱うことができず、"}, {"type": "subtitle", "time": 18558.948, "timestamp": "05:09:18", "text": "もの？"}, {"type": "subtitle", "time": 18561.27, "timestamp": "05:09:21", "text": "つまり、私ならまだできるんです。私はまだ"}, {"type": "subtitle", "time": 18563.11, "timestamp": "05:09:23", "text": "弁護士と相談しなければならない。彼らはただ"}, {"type": "subtitle", "time": 18565.67, "timestamp": "05:09:25", "text": "とってもとっても忙しい。さらに、彼らは"}, {"type": "subtitle", "time": 18568.07, "timestamp": "05:09:28", "text": "父とか、そういうもの。"}, {"type": "subtitle", "time": 18571.11, "timestamp": "05:09:31", "text": "それも確かにありますね。"}, {"type": "subtitle", "time": 18573.99, "timestamp": "05:09:33", "text": "なぜなら、電話をかけてきた人がいたから"}, {"type": "subtitle", "time": 18576.868, "timestamp": "05:09:36", "text": "法律事務所、あのツイートがあったから"}, {"type": "subtitle", "time": 18580.55, "timestamp": "05:09:40", "text": "鍵屋のジョーは実在しない Google"}, {"type": "subtitle", "time": 18582.23, "timestamp": "05:09:42", "text": "検索したり、"}, {"type": "subtitle", "time": 18585.19, "timestamp": "05:09:45", "text": "偽者がそのツイートに現れた"}, {"type": "subtitle", "time": 18587.51, "timestamp": "05:09:47", "text": "それは直接的な脅威のように感じさせた"}, {"type": "subtitle", "time": 18590.39, "timestamp": "05:09:50", "text": "実際の法律事務所へ。 [笑い] それで"}, {"type": "subtitle", "time": 18592.23, "timestamp": "05:09:52", "text": "電話をかけた人もいた"}, {"type": "subtitle", "time": 18595.27, "timestamp": "05:09:55", "text": "法律事務所とかそういう類のもの。私はあの人たちが誰なのか知っています"}, {"type": "subtitle", "time": 18599.03, "timestamp": "05:09:59", "text": "そうですが、実際に試した人は"}]
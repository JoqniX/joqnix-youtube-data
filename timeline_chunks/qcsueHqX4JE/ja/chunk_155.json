[{"type": "subtitle", "time": 9301.349, "timestamp": "02:35:01", "text": "でも、私が"}, {"type": "subtitle", "time": 9303.11, "timestamp": "02:35:03", "text": "聞いたよ"}, {"type": "subtitle", "time": 9308.79, "timestamp": "02:35:08", "text": "オンラインやアニメなどを通じて"}, {"type": "subtitle", "time": 9312.55, "timestamp": "02:35:12", "text": "大学は大学のようなもの"}, {"type": "subtitle", "time": 9315.349, "timestamp": "02:35:15", "text": "高い"}, {"type": "subtitle", "time": 9325.19, "timestamp": "02:35:25", "text": "日本語"}, {"type": "subtitle", "time": 9326.87, "timestamp": "02:35:26", "text": "住居と日本語研修。"}, {"type": "subtitle", "time": 9329.429, "timestamp": "02:35:29", "text": "ああ、そうそう、それに似たような"}, {"type": "subtitle", "time": 9333.75, "timestamp": "02:35:33", "text": "その人、その男、彼らのために"}, {"type": "subtitle", "time": 9336.07, "timestamp": "02:35:36", "text": "ああ、彼らが処理するだろう"}, {"type": "subtitle", "time": 9338.15, "timestamp": "02:35:38", "text": "宿泊施設と住宅全般"}, {"type": "subtitle", "time": 9341.99, "timestamp": "02:35:41", "text": "それらの物すべて"}, {"type": "subtitle", "time": 9344.95, "timestamp": "02:35:44", "text": "それは狂ってる、"}, {"type": "subtitle", "time": 9347.67, "timestamp": "02:35:47", "text": "違う国だからそれはわかるよ"}, {"type": "subtitle", "time": 9351.532, "timestamp": "02:35:51", "text": "スポンサーシップとか、すごくクールだよね"}]
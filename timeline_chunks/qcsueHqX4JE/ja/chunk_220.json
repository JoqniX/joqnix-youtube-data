[{"type": "subtitle", "time": 13202.309, "timestamp": "03:40:02", "text": "私の新しいモデルをデビューさせる予定だった。私"}, {"type": "subtitle", "time": 13204.63, "timestamp": "03:40:04", "text": "安息日を過ごす必要はなかっただろう"}, {"type": "subtitle", "time": 13206.79, "timestamp": "03:40:06", "text": "私のモデルを支持してください。"}, {"type": "subtitle", "time": 13208.87, "timestamp": "03:40:08", "text": "明日買い戻そう。だから私は米を見る"}, {"type": "subtitle", "time": 13210.63, "timestamp": "03:40:10", "text": "そしてすべて"}, {"type": "subtitle", "time": 13212.71, "timestamp": "03:40:12", "text": "たくさんの"}, {"type": "subtitle", "time": 13215.349, "timestamp": "03:40:15", "text": "でもまた、私はこれの下にいるような感じでした"}, {"type": "subtitle", "time": 13217.269, "timestamp": "03:40:17", "text": "印象"}, {"type": "subtitle", "time": 13220.55, "timestamp": "03:40:20", "text": "ずっと昔、私は「もし私が最善を尽くせば」と思っていました"}, {"type": "subtitle", "time": 13223.59, "timestamp": "03:40:23", "text": "もし私がいつか企業のような存在になれるなら"}, {"type": "subtitle", "time": 13226.229, "timestamp": "03:40:26", "text": "YouTuberになれば、私の人生は安泰だ。私はしません"}, {"type": "subtitle", "time": 13228.87, "timestamp": "03:40:28", "text": "金銭面で心配したくない"}, {"type": "subtitle", "time": 13232.309, "timestamp": "03:40:32", "text": "クリエイターとして、ここで"}, {"type": "subtitle", "time": 13234.87, "timestamp": "03:40:34", "text": "もの。資産を購入し、お金を使わなければならない"}, {"type": "subtitle", "time": 13238.55, "timestamp": "03:40:38", "text": "ゲームとか、あれこれのことですよね？もし私が"}, {"type": "subtitle", "time": 13240.389, "timestamp": "03:40:40", "text": "代理店か何かの下で、私は"}, {"type": "subtitle", "time": 13243.51, "timestamp": "03:40:43", "text": "お小遣い制度のようなもの"}, {"type": "subtitle", "time": 13251.91, "timestamp": "03:40:51", "text": "それら全て。私がいたのは、えーと"}, {"type": "subtitle", "time": 13254.71, "timestamp": "03:40:54", "text": "私が話していたのはインド人ではない"}, {"type": "subtitle", "time": 13258.309, "timestamp": "03:40:58", "text": "1つ。どちらかというとアメリカを拠点とする代理店です。私"}, {"type": "subtitle", "time": 13259.99, "timestamp": "03:40:59", "text": "つまり、インド製のものは、きっと"}]
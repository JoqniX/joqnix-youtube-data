[{"type": "subtitle", "time": 2111.589, "timestamp": "00:35:11", "text": "リセットが必要です。ああ、"}, {"type": "chat", "time": 2113.773, "timestamp": "00:35:13", "author": "@mishereshu", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mc4Y9gQCEiemTFxftMBzkVs4f2dFVKIi2EzfEXVVougJ-byH1unVlcX4jadECPvzh2lg=s64-c-k-c0x00ffffff-no-rj", "message": "the problems are stil there, im just happier and well adjusted to deal with it"}, {"type": "subtitle", "time": 2121.03, "timestamp": "00:35:21", "text": "もう一つは、私が気にしすぎるということです"}, {"type": "subtitle", "time": 2122.87, "timestamp": "00:35:22", "text": "他の人々がどう考えているかについて。それ"}, {"type": "subtitle", "time": 2124.63, "timestamp": "00:35:24", "text": "それが原因で、私はひどく怪我をしてしまった。の"}, {"type": "subtitle", "time": 2126.15, "timestamp": "00:35:26", "text": "私が気にしなくなり、主体性を発揮した瞬間、"}, {"type": "subtitle", "time": 2129.03, "timestamp": "00:35:29", "text": "私は以前よりもずっと幸せだった。"}, {"type": "subtitle", "time": 2131.19, "timestamp": "00:35:31", "text": "問題は依然として残っている。私はただ幸せです"}, {"type": "subtitle", "time": 2133.19, "timestamp": "00:35:33", "text": "私はただそれに対処するだけだ。ええ、つまり"}, {"type": "subtitle", "time": 2134.55, "timestamp": "00:35:34", "text": "それは起こったことと同じです"}, {"type": "subtitle", "time": 2137.27, "timestamp": "00:35:37", "text": "私と一緒に、ですよね？"}, {"type": "subtitle", "time": 2141.829, "timestamp": "00:35:41", "text": "私は人々のことを気にしすぎた"}, {"type": "subtitle", "time": 2144.39, "timestamp": "00:35:44", "text": "他人がどう思うかとかそういうこと"}, {"type": "subtitle", "time": 2153.67, "timestamp": "00:35:53", "text": "そして私は多くを失った"}, {"type": "subtitle", "time": 2157.349, "timestamp": "00:35:57", "text": "そして、今日でも私はただ"}]
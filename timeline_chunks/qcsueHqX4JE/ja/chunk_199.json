[{"type": "subtitle", "time": 11940.79, "timestamp": "03:19:00", "text": "全てが順調に進んでいて、私が望むなら"}, {"type": "subtitle", "time": 11943.59, "timestamp": "03:19:03", "text": "追求する"}, {"type": "subtitle", "time": 11947.75, "timestamp": "03:19:07", "text": "大学に行けば、やらなきゃいけない"}, {"type": "subtitle", "time": 11949.51, "timestamp": "03:19:09", "text": "あなたの"}, {"type": "subtitle", "time": 11954.389, "timestamp": "03:19:14", "text": "国。ええと、ローカル学習コースでは"}, {"type": "subtitle", "time": 11957.269, "timestamp": "03:19:17", "text": "支払いを済ませ、すべての書類と同様に"}, {"type": "subtitle", "time": 11958.95, "timestamp": "03:19:18", "text": "翻訳"}, {"type": "subtitle", "time": 11961.67, "timestamp": "03:19:21", "text": "そしてその物"}, {"type": "subtitle", "time": 11964.79, "timestamp": "03:19:24", "text": "それと、言語もね。うん、そう思う"}, {"type": "subtitle", "time": 11967.83, "timestamp": "03:19:27", "text": "私は半分を支払いました"}, {"type": "subtitle", "time": 11972.07, "timestamp": "03:19:32", "text": "えーと、語学コース、6ヶ月の6"}, {"type": "subtitle", "time": 11981.03, "timestamp": "03:19:41", "text": "そして、私たちはリストを取得します"}, {"type": "subtitle", "time": 11984.63, "timestamp": "03:19:44", "text": "ドメトリーの費用はいくらですか"}, {"type": "subtitle", "time": 11987.349, "timestamp": "03:19:47", "text": "2月かな。"}, {"type": "subtitle", "time": 11989.59, "timestamp": "03:19:49", "text": "2月。ええ、4月を基準にしています。いいえ、"}, {"type": "subtitle", "time": 11998.309, "timestamp": "03:19:58", "text": "いや、それは「じゃあ、教えてあげるよ」みたいな感じだよ。"}]
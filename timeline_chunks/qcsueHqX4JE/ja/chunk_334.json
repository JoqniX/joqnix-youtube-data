[{"type": "subtitle", "time": 20041.19, "timestamp": "05:34:01", "text": "フォートナイトの配信。いいえ、それほど多くはありません。私は"}, {"type": "subtitle", "time": 20045.11, "timestamp": "05:34:05", "text": "ザトンですよね？"}, {"type": "subtitle", "time": 20049.59, "timestamp": "05:34:09", "text": "フォートナイトのためのフォートナイト。"}, {"type": "subtitle", "time": 20053.19, "timestamp": "05:34:13", "text": "PUBGボディカム。ええ、ボディカムは"}, {"type": "subtitle", "time": 20055.99, "timestamp": "05:34:15", "text": "ゲーム用PCが壊れてしまいました。それは"}, {"type": "subtitle", "time": 20059.43, "timestamp": "05:34:19", "text": "私のゲーム用PCが壊れた日。 CPU が壊れました、GPU"}, {"type": "subtitle", "time": 20062.628, "timestamp": "05:34:22", "text": "その試合を配信中に亡くなった。私は決して"}, {"type": "subtitle", "time": 20064.948, "timestamp": "05:34:24", "text": "このゲームは忘れろ。 [笑い]"}, {"type": "subtitle", "time": 20067.99, "timestamp": "05:34:27", "text": "ゲーム用PCを失った日、私のジョッキー"}, {"type": "subtitle", "time": 20070.07, "timestamp": "05:34:30", "text": "ちゃん、"}, {"type": "subtitle", "time": 20073.67, "timestamp": "05:34:33", "text": "以前は自分のPCに名前を付けていました。私が使っているこのPC"}, {"type": "subtitle", "time": 20077.67, "timestamp": "05:34:37", "text": "チャンと呼ばれ、ゲームPCは"}, {"type": "subtitle", "time": 20079.246, "timestamp": "05:34:39", "text": "ジョユン。"}, {"type": "subtitle", "time": 20088.31, "timestamp": "05:34:48", "text": "私はその試合を見逃しました。"}]
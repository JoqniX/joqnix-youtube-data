[{"type": "subtitle", "time": 4984.229, "timestamp": "01:23:04", "text": "そして、"}, {"type": "subtitle", "time": 4988.31, "timestamp": "01:23:08", "text": "私は自分の旅路を見ています"}, {"type": "subtitle", "time": 4991.99, "timestamp": "01:23:11", "text": "人生において、私が何を発見するかを知る方法として"}, {"type": "chat", "time": 4992.057, "timestamp": "01:23:12", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "at first I want to be painter but my dad wouldn't let me go to painting classes"}, {"type": "subtitle", "time": 4996.07, "timestamp": "01:23:16", "text": "今やりたいこととか色々。"}, {"type": "subtitle", "time": 4998.87, "timestamp": "01:23:18", "text": "そして今日でも私は"}, {"type": "subtitle", "time": 5000.39, "timestamp": "01:23:20", "text": "発見する"}, {"type": "subtitle", "time": 5002.87, "timestamp": "01:23:22", "text": "私がしたいこと"}, {"type": "subtitle", "time": 5007.35, "timestamp": "01:23:27", "text": "犬になれ。現実世界のこととか、そういうこと全部。"}, {"type": "subtitle", "time": 5009.27, "timestamp": "01:23:29", "text": "つまり私は、"}, {"type": "subtitle", "time": 5013.35, "timestamp": "01:23:33", "text": "すべて。私は音楽を作ることから"}, {"type": "subtitle", "time": 5016.55, "timestamp": "01:23:36", "text": "私は音楽関係のことにとても魅了されていました。"}, {"type": "subtitle", "time": 5019.59, "timestamp": "01:23:39", "text": "私はそれを続けた。それから私は"}, {"type": "subtitle", "time": 5022.229, "timestamp": "01:23:42", "text": "えっと、混乱して、途方に暮れて、行き詰まっています。それから私は"}, {"type": "subtitle", "time": 5025.35, "timestamp": "01:23:45", "text": "さまざまな"}, {"type": "subtitle", "time": 5029.27, "timestamp": "01:23:49", "text": "えっと、クリエイティブな絵を描くようなことは使ったことがない"}, {"type": "subtitle", "time": 5032.629, "timestamp": "01:23:52", "text": "えーと、イラストみたいな感じ。"}, {"type": "subtitle", "time": 5033.83, "timestamp": "01:23:53", "text": "ええ、それはグロテスクな表現に該当します"}, {"type": "subtitle", "time": 5036.229, "timestamp": "01:23:56", "text": "デザインする。それから私は芸術のようなことをしようとしました"}]
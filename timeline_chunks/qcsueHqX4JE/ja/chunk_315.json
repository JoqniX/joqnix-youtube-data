[{"type": "subtitle", "time": 18900.948, "timestamp": "05:15:00", "text": "これとあれとこれが現実です"}, {"type": "subtitle", "time": 18904.47, "timestamp": "05:15:04", "text": "コミュニティ全体、コミュニティがどのように"}, {"type": "subtitle", "time": 18908.31, "timestamp": "05:15:08", "text": "これはあれで私の側、私の私の"}, {"type": "subtitle", "time": 18911.51, "timestamp": "05:15:11", "text": "ドラマ関連のこととか、そういうこと。ええ、それら全部"}, {"type": "subtitle", "time": 18914.39, "timestamp": "05:15:14", "text": "そういうことですよね？そしておそらくもっと大きな"}, {"type": "subtitle", "time": 18916.948, "timestamp": "05:15:16", "text": "YouTuberとか誰かがカバーしてくれるかも"}, {"type": "subtitle", "time": 18920.15, "timestamp": "05:15:20", "text": "あるいは遠い未来に物事が"}, {"type": "subtitle", "time": 18923.11, "timestamp": "05:15:23", "text": "このコミュニティで下り坂をインド人が"}, {"type": "subtitle", "time": 18925.99, "timestamp": "05:15:25", "text": "コミュニティでさらにドラマや大きなドラマが起こる"}, {"type": "subtitle", "time": 18929.11, "timestamp": "05:15:29", "text": "何かが起こったか何か"}, {"type": "subtitle", "time": 18932.868, "timestamp": "05:15:32", "text": "彼らは「ああ、待って、2025年には"}, {"type": "subtitle", "time": 18936.39, "timestamp": "05:15:36", "text": "このドラマではジョックは"}, {"type": "subtitle", "time": 18938.15, "timestamp": "05:15:38", "text": "暗殺された"}, {"type": "subtitle", "time": 18939.99, "timestamp": "05:15:39", "text": "あれこれとやって、彼らが育てられるように"}, {"type": "subtitle", "time": 18942.788, "timestamp": "05:15:42", "text": "あるいは、もしその人たち"}, {"type": "subtitle", "time": 18944.708, "timestamp": "05:15:44", "text": "将来のドラマにもまだ関わっているか、"}, {"type": "subtitle", "time": 18951.35, "timestamp": "05:15:51", "text": "[息を呑む]"}, {"type": "subtitle", "time": 18953.27, "timestamp": "05:15:53", "text": "えーと"}, {"type": "subtitle", "time": 18955.27, "timestamp": "05:15:55", "text": "問題は"}, {"type": "subtitle", "time": 18959.35, "timestamp": "05:15:59", "text": "でも、ある意味ではもう終わったことだよね"}]
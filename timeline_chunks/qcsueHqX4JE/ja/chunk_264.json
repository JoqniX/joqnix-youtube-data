[{"type": "subtitle", "time": 15850.469, "timestamp": "04:24:10", "text": "ええ、正直、自分が"}, {"type": "subtitle", "time": 15853.75, "timestamp": "04:24:13", "text": "YouTubeのメンバーシップに登録したことはありますか？わかった。私は"}, {"type": "subtitle", "time": 15855.99, "timestamp": "04:24:15", "text": "「うん、Twitchの方が簡単だよ。」みたいな感じ。私は手に入れた"}, {"type": "subtitle", "time": 15859.51, "timestamp": "04:24:19", "text": "アフィリエイトにヒット。これで完了です。パートナー、"}, {"type": "subtitle", "time": 15862.309, "timestamp": "04:24:22", "text": "それは大きな夢だ。でも、いつかはね。"}, {"type": "subtitle", "time": 15863.99, "timestamp": "04:24:23", "text": "でもYouTubeは私が本当に"}, {"type": "subtitle", "time": 15866.469, "timestamp": "04:24:26", "text": "良い特徴があったから欲しかった"}, {"type": "subtitle", "time": 15868.71, "timestamp": "04:24:28", "text": "襲撃のようにロックされ、"}, {"type": "subtitle", "time": 15872.71, "timestamp": "04:24:32", "text": "リダイレクト、チャットルールのやつ。それは"}, {"type": "subtitle", "time": 15875.91, "timestamp": "04:24:35", "text": "YouTubeパートナー機能のようなものです。のように"}, {"type": "subtitle", "time": 15879.51, "timestamp": "04:24:39", "text": "なぜ？それは、そこに住む人々にとって必要である"}, {"type": "subtitle", "time": 15881.269, "timestamp": "04:24:41", "text": "ストリーム。チャットルールを入力すると"}, {"type": "subtitle", "time": 15885.51, "timestamp": "04:24:45", "text": "チャットではルールがポップアップ表示されます。なぜ"}, {"type": "subtitle", "time": 15890.389, "timestamp": "04:24:50", "text": "そういうのは全部ケータリングされてるの？"}, {"type": "subtitle", "time": 15894.63, "timestamp": "04:24:54", "text": "物事と、私がこれをやっていたから"}, {"type": "subtitle", "time": 15898.149, "timestamp": "04:24:58", "text": "ジョッカソン・サバソンみたいなやつだよね？"}]
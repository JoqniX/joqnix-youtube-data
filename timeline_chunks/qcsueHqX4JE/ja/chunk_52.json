[{"type": "subtitle", "time": 3123.91, "timestamp": "00:52:03", "text": "もしくは、103回くらい走らせることもできるよ"}, {"type": "subtitle", "time": 3125.685, "timestamp": "00:52:05", "text": "非常識な。"}, {"type": "subtitle", "time": 3132.15, "timestamp": "00:52:12", "text": "ロックを解除する必要があるものがたくさんあります。いいえ、"}, {"type": "subtitle", "time": 3136.63, "timestamp": "00:52:16", "text": "タイミングの問題みたいなものですね。"}, {"type": "subtitle", "time": 3139.109, "timestamp": "00:52:19", "text": "誰もができるわけではない"}, {"type": "subtitle", "time": 3141.75, "timestamp": "00:52:21", "text": "消防士になるために、そんなに多くの時間を費やす。消防士、"}, {"type": "subtitle", "time": 3144.47, "timestamp": "00:52:24", "text": "消防士、消防士。右。"}]
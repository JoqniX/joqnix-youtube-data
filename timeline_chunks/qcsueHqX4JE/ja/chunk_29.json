[{"type": "subtitle", "time": 1753.35, "timestamp": "00:29:13", "text": "今ここでやる方が良いのか、それとも"}, {"type": "subtitle", "time": 1757.43, "timestamp": "00:29:17", "text": "そうする方が良い"}, {"type": "subtitle", "time": 1767.029, "timestamp": "00:29:27", "text": "レベルアップしたいんだけど、"}, {"type": "subtitle", "time": 1770.47, "timestamp": "00:29:30", "text": "でも彼女は大丈夫です。"}, {"type": "subtitle", "time": 1774.149, "timestamp": "00:29:34", "text": "彼女は私に必要な"}, {"type": "subtitle", "time": 1784.149, "timestamp": "00:29:44", "text": "よし、キャラクターの経験値稼ぎをしよう"}, {"type": "subtitle", "time": 1791.35, "timestamp": "00:29:51", "text": "これは苦痛を伴うだろう。血清"}]
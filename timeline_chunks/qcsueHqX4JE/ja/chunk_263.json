[{"type": "subtitle", "time": 15780.71, "timestamp": "04:23:00", "text": "29."}, {"type": "subtitle", "time": 15791.03, "timestamp": "04:23:11", "text": "だって私は、人々に"}, {"type": "subtitle", "time": 15793.189, "timestamp": "04:23:13", "text": "私にお金を使いすぎないでください。私はそうではない"}, {"type": "subtitle", "time": 15795.189, "timestamp": "04:23:15", "text": "面白いとか、そういうことでも何もない。私はただ"}, {"type": "subtitle", "time": 15797.91, "timestamp": "04:23:17", "text": "人々が本当に望むならそうしてほしい"}, {"type": "subtitle", "time": 15801.11, "timestamp": "04:23:21", "text": "彼らは支援することができる。それでおしまい。必要ない"}, {"type": "chat", "time": 15802.63, "timestamp": "04:23:22", "author": "@WhiteGlint4Answer", "avatar": "https://yt4.ggpht.com/ytc/AIdro_naBVNcSxiu5dSXWZ9sg7-zrOuDci98mvg4tI6NAFMNEIQ=s64-c-k-c0x00ffffff-no-rj", "message": "WHAT DOES ONE DO WITH 29 RUPEES?!"}, {"type": "subtitle", "time": 15805.269, "timestamp": "04:23:25", "text": "過剰な給料とかそういうもの。"}, {"type": "subtitle", "time": 15807.349, "timestamp": "04:23:27", "text": "200ルピーあれば、一体何ができるだろうか？私"}, {"type": "subtitle", "time": 15808.87, "timestamp": "04:23:28", "text": "考える"}, {"type": "subtitle", "time": 15811.51, "timestamp": "04:23:31", "text": "それはただのバッジといくつかの"}, {"type": "subtitle", "time": 15814.79, "timestamp": "04:23:34", "text": "絵文字が使えるようになりました。だから私は「うん」って感じだった。"}, {"type": "subtitle", "time": 15817.83, "timestamp": "04:23:37", "text": "安い方が良い。私はいくつか見たことがあります"}, {"type": "subtitle", "time": 15820.63, "timestamp": "04:23:40", "text": "YouTuberたちは89を選ぶ。"}, {"type": "subtitle", "time": 15824.79, "timestamp": "04:23:44", "text": "いいえ。ええと、89ルピーか129ルピーくらいです。"}, {"type": "subtitle", "time": 15829.03, "timestamp": "04:23:49", "text": "そういうことをする人もいるよね？"}, {"type": "subtitle", "time": 15832.149, "timestamp": "04:23:52", "text": "それも私が持っていない理由の一つです"}, {"type": "chat", "time": 15833.28, "timestamp": "04:23:53", "author": "@WhiteGlint4Answer", "avatar": "https://yt4.ggpht.com/ytc/AIdro_naBVNcSxiu5dSXWZ9sg7-zrOuDci98mvg4tI6NAFMNEIQ=s64-c-k-c0x00ffffff-no-rj", "message": "yeah that's a dollar"}, {"type": "chat", "time": 15835.235, "timestamp": "04:23:55", "author": "@WhiteGlint4Answer", "avatar": "https://yt4.ggpht.com/ytc/AIdro_naBVNcSxiu5dSXWZ9sg7-zrOuDci98mvg4tI6NAFMNEIQ=s64-c-k-c0x00ffffff-no-rj", "message": "or more"}]
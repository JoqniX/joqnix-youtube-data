[{"type": "subtitle", "time": 18962.628, "timestamp": "05:16:02", "text": "みんなもう前に進んだんだろうね"}, {"type": "subtitle", "time": 18966.55, "timestamp": "05:16:06", "text": "鳥のパーティーのビデオのみ"}, {"type": "subtitle", "time": 18969.67, "timestamp": "05:16:09", "text": "ドラマについて"}, {"type": "subtitle", "time": 18972.31, "timestamp": "05:16:12", "text": "オレンジみたいで、これを吐き出す"}, {"type": "subtitle", "time": 18974.628, "timestamp": "05:16:14", "text": "ライブ配信。いいえ。"}, {"type": "subtitle", "time": 18976.868, "timestamp": "05:16:16", "text": "非常に否定的な意味での物思いにふける様子。うん、"}, {"type": "subtitle", "time": 18980.15, "timestamp": "05:16:20", "text": "それが問題なんです。"}, {"type": "subtitle", "time": 18987.59, "timestamp": "05:16:27", "text": "そこが問題なんだよ。おお。そして私も"}, {"type": "subtitle", "time": 18990.708, "timestamp": "05:16:30", "text": "何人かの人がそれを渡そうとしたと聞いた"}, {"type": "subtitle", "time": 18993.75, "timestamp": "05:16:33", "text": "リーマ、パウリディ、その他大勢のユーチューバー"}, {"type": "subtitle", "time": 18997.67, "timestamp": "05:16:37", "text": "ドラマを紹介するYouTuberのことですよね？それで"}, {"type": "subtitle", "time": 18999.91, "timestamp": "05:16:39", "text": "彼らは私のドラマをあちらに持ち込もうとする。それから"}, {"type": "subtitle", "time": 19002.31, "timestamp": "05:16:42", "text": "みんな「ああ、小さな蜂だよ」って言うんだ"}, {"type": "subtitle", "time": 19004.07, "timestamp": "05:16:44", "text": "ドラマ。私たちはこれを取り上げたくないし、"}]
[{"type": "subtitle", "time": 16020.07, "timestamp": "04:27:00", "text": "そうそう。 Spiritは今日配信しなかったの？"}, {"type": "subtitle", "time": 16022.79, "timestamp": "04:27:02", "text": "彼はその男に配信したと思う。彼は配信している"}, {"type": "subtitle", "time": 16025.404, "timestamp": "04:27:05", "text": "最近は原神をよくプレイしています。"}, {"type": "subtitle", "time": 16027.11, "timestamp": "04:27:07", "text": "[笑い] 彼はあの原神になった"}, {"type": "subtitle", "time": 16038.79, "timestamp": "04:27:18", "text": "友達がストリーミングを始めたことを考えると"}, {"type": "subtitle", "time": 16042.07, "timestamp": "04:27:22", "text": "もう一度、私は試さなければなりません。それは良いことです。"}, {"type": "subtitle", "time": 16044.229, "timestamp": "04:27:24", "text": "頑張れ。"}]
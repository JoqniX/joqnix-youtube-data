[{"type": "subtitle", "time": 11520.95, "timestamp": "03:12:00", "text": "ええ、ヒンディー語は私の第一言語ではありません"}, {"type": "subtitle", "time": 11531.67, "timestamp": "03:12:11", "text": "私もヒンディー語が話せます。私はヒンディー語が苦手です。私"}, {"type": "subtitle", "time": 11536.63, "timestamp": "03:12:16", "text": "高校時代にその点で失敗したが、"}, {"type": "subtitle", "time": 11539.83, "timestamp": "03:12:19", "text": "あなたが知っている。私は夜更かしが苦手です。はい、私は"}, {"type": "subtitle", "time": 11543.269, "timestamp": "03:12:23", "text": "あまりにもひどかったので、私は"}, {"type": "subtitle", "time": 11545.269, "timestamp": "03:12:25", "text": "ヒンディー語で行く予定"}, {"type": "subtitle", "time": 11557.19, "timestamp": "03:12:37", "text": "インディーをやめて本当に良かったよ（笑）"}, {"type": "subtitle", "time": 11561.67, "timestamp": "03:12:41", "text": "取った。ああ、あなたには友達がいたんですね。おお。"}, {"type": "subtitle", "time": 11569.83, "timestamp": "03:12:49", "text": "ノイズ。"}, {"type": "subtitle", "time": 11572.469, "timestamp": "03:12:52", "text": "私は地下組織の仲間です。ああ、"}, {"type": "subtitle", "time": 11576.309, "timestamp": "03:12:56", "text": "ニース。フランスはどうですか？"}, {"type": "subtitle", "time": 11579.11, "timestamp": "03:12:59", "text": "今日もパンで遊んだよね？私"}]
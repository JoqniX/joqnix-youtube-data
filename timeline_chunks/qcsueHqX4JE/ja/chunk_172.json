[{"type": "subtitle", "time": 10325.91, "timestamp": "02:52:05", "text": "私は「うわあ」と思いました。そして彼もこう言った"}, {"type": "subtitle", "time": 10327.83, "timestamp": "02:52:07", "text": "それ。"}, {"type": "subtitle", "time": 10330.469, "timestamp": "02:52:10", "text": "彼もそう言っていた。本当にそう思いますか？"}, {"type": "subtitle", "time": 10337.51, "timestamp": "02:52:17", "text": "会社を立ち上げるか、"}, {"type": "subtitle", "time": 10340.79, "timestamp": "02:52:20", "text": "ここに何かあるから、株に投資するだけ"}, {"type": "subtitle", "time": 10344.87, "timestamp": "02:52:24", "text": "または投資信託はこちら。大丈夫だよ。"}, {"type": "subtitle", "time": 10350.63, "timestamp": "02:52:30", "text": "さあ、どうだろう。"}, {"type": "subtitle", "time": 10352.469, "timestamp": "02:52:32", "text": "つまり、私が16歳の時からずっと。"}, {"type": "subtitle", "time": 10356.23, "timestamp": "02:52:36", "text": "豊かな経験。おお。"}]
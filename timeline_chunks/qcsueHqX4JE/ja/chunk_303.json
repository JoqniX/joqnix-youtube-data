[{"type": "subtitle", "time": 18186.788, "timestamp": "05:03:06", "text": "人の人生を台無しにするのはほんの一瞬だ"}, {"type": "subtitle", "time": 18188.39, "timestamp": "05:03:08", "text": "CL向け。でもまあ、ただ"}, {"type": "subtitle", "time": 18189.99, "timestamp": "05:03:09", "text": "考えずに夫を見つめる"}, {"type": "subtitle", "time": 18193.19, "timestamp": "05:03:13", "text": "説明責任。うん、"}, {"type": "subtitle", "time": 18196.628, "timestamp": "05:03:16", "text": "正直言って悲しい。"}, {"type": "subtitle", "time": 18204.55, "timestamp": "05:03:24", "text": "私の場合は、子供とは一切話さないことです。"}, {"type": "subtitle", "time": 18209.03, "timestamp": "05:03:29", "text": "ええ、正直言って、私は何も知らなかったんです"}, {"type": "subtitle", "time": 18211.03, "timestamp": "05:03:31", "text": "その時。 「ああ、オンラインで」"}, {"type": "subtitle", "time": 18213.59, "timestamp": "05:03:33", "text": "友達。」そしてその時、私たちは"}, {"type": "subtitle", "time": 18216.948, "timestamp": "05:03:36", "text": "年齢のこととか、そういう話をする。いいえ。"}, {"type": "subtitle", "time": 18220.31, "timestamp": "05:03:40", "text": "ええと、だからあまり気にしませんでした。私はこう思った。"}, {"type": "subtitle", "time": 18222.31, "timestamp": "05:03:42", "text": "「ああ、親愛なる友人たちよ。これから話をしよう。」"}, {"type": "subtitle", "time": 18224.868, "timestamp": "05:03:44", "text": "私のあれこれ。」そして時間が経つにつれて"}, {"type": "subtitle", "time": 18234.708, "timestamp": "05:03:54", "text": "ええと、そういうことが起きました。"}, {"type": "subtitle", "time": 18237.27, "timestamp": "05:03:57", "text": "うん。"}]
[{"type": "subtitle", "time": 16681.67, "timestamp": "04:38:01", "text": "そして、他の二人が大騒ぎを起こした"}, {"type": "subtitle", "time": 16685.51, "timestamp": "04:38:05", "text": "でもそれは"}, {"type": "subtitle", "time": 16696.39, "timestamp": "04:38:16", "text": "喉が渇いた。うん。上へ行け。飲んでください"}, {"type": "subtitle", "time": 16705.429, "timestamp": "04:38:25", "text": "[笑い]"}, {"type": "subtitle", "time": 16726.261, "timestamp": "04:38:46", "text": "何てことだ。"}, {"type": "subtitle", "time": 16727.189, "timestamp": "04:38:47", "text": "[笑い]"}, {"type": "subtitle", "time": 16730.847, "timestamp": "04:38:50", "text": "ありがとうございます。"}, {"type": "subtitle", "time": 16730.949, "timestamp": "04:38:50", "text": "[笑い]"}, {"type": "subtitle", "time": 16733.349, "timestamp": "04:38:53", "text": "何てことだ、"}, {"type": "subtitle", "time": 16736.088, "timestamp": "04:38:56", "text": "私はそれを次のように読みました"}]
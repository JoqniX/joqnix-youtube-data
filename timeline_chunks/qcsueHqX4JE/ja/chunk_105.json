[{"type": "subtitle", "time": 6300.87, "timestamp": "01:45:00", "text": "ゲームの音声が聞こえるようにしたい"}, {"type": "subtitle", "time": 6303.99, "timestamp": "01:45:03", "text": "またはストリームストリームですが、私は"}, {"type": "subtitle", "time": 6307.03, "timestamp": "01:45:07", "text": "ヘッドホンにルーティングされる"}, {"type": "subtitle", "time": 6308.55, "timestamp": "01:45:08", "text": "事例。"}, {"type": "subtitle", "time": 6311.35, "timestamp": "01:45:11", "text": "でも、もし私が少しだけ欲しいなら、もし私が"}, {"type": "subtitle", "time": 6313.189, "timestamp": "01:45:13", "text": "同じことを何度も聞かされて飽き飽きしている"}, {"type": "subtitle", "time": 6315.43, "timestamp": "01:45:15", "text": "またまたこのゲームは何"}, {"type": "subtitle", "time": 6317.27, "timestamp": "01:45:17", "text": "あれのことですよね？もし私が何かを聴いているなら"}, {"type": "subtitle", "time": 6320.55, "timestamp": "01:45:20", "text": "音楽か何か、"}, {"type": "subtitle", "time": 6323.43, "timestamp": "01:45:23", "text": "そうすれば私は"}, {"type": "subtitle", "time": 6327.109, "timestamp": "01:45:27", "text": "ちょっと聞いてみてください。"}, {"type": "subtitle", "time": 6329.669, "timestamp": "01:45:29", "text": "あるいは、そんな感じ。"}, {"type": "subtitle", "time": 6332.31, "timestamp": "01:45:32", "text": "もちろん。あれ、ベータ版をダウンロードしたはずじゃなかったっけ？"}, {"type": "subtitle", "time": 6341.109, "timestamp": "01:45:41", "text": "ベータ版をダウンロードしたのを覚えています。"}]
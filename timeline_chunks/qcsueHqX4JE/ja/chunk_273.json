[{"type": "subtitle", "time": 16381.91, "timestamp": "04:33:01", "text": "作品の依頼"}, {"type": "subtitle", "time": 16384.23, "timestamp": "04:33:04", "text": "男"}, {"type": "subtitle", "time": 16395.189, "timestamp": "04:33:15", "text": "でも正直なところ、私は"}, {"type": "subtitle", "time": 16398.07, "timestamp": "04:33:18", "text": "いつか依頼を受けて仕事をするようになりたいと思っています。"}, {"type": "subtitle", "time": 16400.31, "timestamp": "04:33:20", "text": "でも、このプロ意識の高い人が"}, {"type": "subtitle", "time": 16403.029, "timestamp": "04:33:23", "text": "症候群か何か。わかった。"}, {"type": "subtitle", "time": 16405.349, "timestamp": "04:33:25", "text": "そのため"}, {"type": "subtitle", "time": 16408.15, "timestamp": "04:33:28", "text": "この完璧主義症候群のため、または"}, {"type": "subtitle", "time": 16409.91, "timestamp": "04:33:29", "text": "何か"}, {"type": "subtitle", "time": 16414.15, "timestamp": "04:33:34", "text": "完璧じゃなければ完璧じゃない"}, {"type": "subtitle", "time": 16417.91, "timestamp": "04:33:37", "text": "依頼したくないのは、"}, {"type": "subtitle", "time": 16421.75, "timestamp": "04:33:41", "text": "私は依頼を受けて仕事をしています。"}, {"type": "subtitle", "time": 16426.07, "timestamp": "04:33:46", "text": "満足して、"}, {"type": "subtitle", "time": 16428.709, "timestamp": "04:33:48", "text": "仕事は"}, {"type": "subtitle", "time": 16431.91, "timestamp": "04:33:51", "text": "ええと、ちゃんとした完成品というより"}, {"type": "subtitle", "time": 16435.109, "timestamp": "04:33:55", "text": "中途半端にパスするよりはマシだ。"}, {"type": "subtitle", "time": 16438.39, "timestamp": "04:33:58", "text": "それが私の得意分野なんです。"}]
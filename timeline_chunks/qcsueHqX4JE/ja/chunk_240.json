[{"type": "subtitle", "time": 14400.15, "timestamp": "04:00:00", "text": "時間が経つにつれて、私は"}, {"type": "subtitle", "time": 14403.11, "timestamp": "04:00:03", "text": "自分のテキストメッセージの送り方などは"}, {"type": "subtitle", "time": 14405.269, "timestamp": "04:00:05", "text": "すごく恥ずかしい"}, {"type": "subtitle", "time": 14410.15, "timestamp": "04:00:10", "text": "そして時が経つにつれて、私はそれをしなくなりました。"}, {"type": "subtitle", "time": 14411.83, "timestamp": "04:00:11", "text": "わかった。"}, {"type": "subtitle", "time": 14415.59, "timestamp": "04:00:15", "text": "そして問題は、私は人に簡単に心を許してしまうということだ。"}, {"type": "subtitle", "time": 14418.15, "timestamp": "04:00:18", "text": "それらの全てを説得し、操るために"}, {"type": "subtitle", "time": 14420.95, "timestamp": "04:00:20", "text": "きちんと詰め込む。だから、私にはわからない"}, {"type": "subtitle", "time": 14426.309, "timestamp": "04:00:26", "text": "問題や課題はありますか？"}, {"type": "subtitle", "time": 14428.63, "timestamp": "04:00:28", "text": "えーと、他の人と一緒に、あるいは"}, {"type": "subtitle", "time": 14430.229, "timestamp": "04:00:30", "text": "自分自身？"}, {"type": "subtitle", "time": 14432.95, "timestamp": "04:00:32", "text": "わかりません。 [笑い]"}, {"type": "subtitle", "time": 14435.67, "timestamp": "04:00:35", "text": "AKS 5。わかりました、"}, {"type": "subtitle", "time": 14444.71, "timestamp": "04:00:44", "text": "それでおしまい。こんにちは。ありがとう。付け加えておきます"}, {"type": "subtitle", "time": 14447.59, "timestamp": "04:00:47", "text": "あなた。ああ。"}, {"type": "subtitle", "time": 14455.91, "timestamp": "04:00:55", "text": "何てことだ。"}, {"type": "subtitle", "time": 14459.189, "timestamp": "04:00:59", "text": "そうです。そうです。正直に言うと、"}]
[{"type": "subtitle", "time": 10621.99, "timestamp": "02:57:01", "text": "ええ、それも事実です。いいえ、"}, {"type": "subtitle", "time": 10624.469, "timestamp": "02:57:04", "text": "正直言って、そうだよ。私はただ家族に"}, {"type": "subtitle", "time": 10627.67, "timestamp": "02:57:07", "text": "手に負えない。"}, {"type": "subtitle", "time": 10633.11, "timestamp": "02:57:13", "text": "私はただ良い仕事に就きたいだけです"}, {"type": "subtitle", "time": 10636.389, "timestamp": "02:57:16", "text": "私は家族のためなら何でもできる"}, {"type": "subtitle", "time": 10638.389, "timestamp": "02:57:18", "text": "そして、彼らは平和に暮らせるようになる。しないで"}, {"type": "subtitle", "time": 10642.15, "timestamp": "02:57:22", "text": "お金とか、何か心配事がある。"}, {"type": "subtitle", "time": 10648.71, "timestamp": "02:57:28", "text": "日本の若手管理職は"}, {"type": "subtitle", "time": 10662.23, "timestamp": "02:57:42", "text": "イギリスでは約15万ポンド稼いでいると想像してください。おお"}]
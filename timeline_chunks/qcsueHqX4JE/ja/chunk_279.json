[{"type": "subtitle", "time": 16742.789, "timestamp": "04:39:02", "text": "男の子。"}, {"type": "subtitle", "time": 16751.349, "timestamp": "04:39:11", "text": "まあ、そうですね。こんにちは。ほとんどの人は20代です"}, {"type": "subtitle", "time": 16753.429, "timestamp": "04:39:13", "text": "20歳で"}, {"type": "subtitle", "time": 16757.99, "timestamp": "04:39:17", "text": "20代半ばくらいですよね？うん。"}, {"type": "subtitle", "time": 16760.47, "timestamp": "04:39:20", "text": "それでそれは"}, {"type": "subtitle", "time": 16772.07, "timestamp": "04:39:32", "text": "ああ、私が話したいことは一つあります"}, {"type": "subtitle", "time": 16775.67, "timestamp": "04:39:35", "text": "推測。えっと、私もある意味で"}, {"type": "subtitle", "time": 16778.15, "timestamp": "04:39:38", "text": "マネージャー"}, {"type": "subtitle", "time": 16783.91, "timestamp": "04:39:43", "text": "正真正銘のマネージャー"}, {"type": "subtitle", "time": 16788.47, "timestamp": "04:39:48", "text": "うまくいかなかった。むしろ悪化させてしまった。"}, {"type": "subtitle", "time": 16791.19, "timestamp": "04:39:51", "text": "神様ありがとう、誰かが神様ありがとうって言ってくれてよかった"}]
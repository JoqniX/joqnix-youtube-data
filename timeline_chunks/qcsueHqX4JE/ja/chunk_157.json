[{"type": "subtitle", "time": 9421.27, "timestamp": "02:37:01", "text": "今すぐにでもそんな生活を送りたい。"}, {"type": "subtitle", "time": 9423.51, "timestamp": "02:37:03", "text": "インスタグラムでそういう人たちを見かけるよね"}, {"type": "subtitle", "time": 9426.95, "timestamp": "02:37:06", "text": "コンテンツの作成と共有など"}, {"type": "subtitle", "time": 9431.67, "timestamp": "02:37:11", "text": "彼らの旅行用品を見て、「わあ、"}, {"type": "subtitle", "time": 9449.19, "timestamp": "02:37:29", "text": "数ヶ月間"}, {"type": "subtitle", "time": 9451.27, "timestamp": "02:37:31", "text": "そうそう"}, {"type": "subtitle", "time": 9454.469, "timestamp": "02:37:34", "text": "そうだね"}, {"type": "subtitle", "time": 9456.55, "timestamp": "02:37:36", "text": "私が働きたい場所は日本です"}, {"type": "subtitle", "time": 9460.87, "timestamp": "02:37:40", "text": "今日私の感覚が私に尋ねたのはなぜか"}, {"type": "subtitle", "time": 9463.83, "timestamp": "02:37:43", "text": "あなたは日本式の"}, {"type": "subtitle", "time": 9466.55, "timestamp": "02:37:46", "text": "仕事"}, {"type": "subtitle", "time": 9470.15, "timestamp": "02:37:50", "text": "職場または英語の外国語タイプ"}, {"type": "subtitle", "time": 9473.03, "timestamp": "02:37:53", "text": "職場。私はこう思った"}, {"type": "subtitle", "time": 9475.91, "timestamp": "02:37:55", "text": "これ、ほら、私は大丈夫って感じだった"}, {"type": "subtitle", "time": 9479.11, "timestamp": "02:37:59", "text": "日本人は"}]
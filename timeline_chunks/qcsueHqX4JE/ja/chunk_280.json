[{"type": "subtitle", "time": 16800.07, "timestamp": "04:40:00", "text": "それで"}, {"type": "subtitle", "time": 16802.55, "timestamp": "04:40:02", "text": "遠隔撮影の写真が見つかりました。"}, {"type": "subtitle", "time": 16805.27, "timestamp": "04:40:05", "text": "OPの袋には良い。"}, {"type": "subtitle", "time": 16807.51, "timestamp": "04:40:07", "text": "だから犬を飼わないと、何も"}, {"type": "subtitle", "time": 16809.19, "timestamp": "04:40:09", "text": "起こる"}, {"type": "subtitle", "time": 16820.868, "timestamp": "04:40:20", "text": "神は誰が、神はいつ"}, {"type": "subtitle", "time": 16823.59, "timestamp": "04:40:23", "text": "私の写真を持っている人は実際に"}, {"type": "subtitle", "time": 16826.15, "timestamp": "04:40:26", "text": "実際に個人情報を晒すような人たちに渡してください"}, {"type": "subtitle", "time": 16828.948, "timestamp": "04:40:28", "text": "私とか、そういう人。私を特定しないで、アップロードします"}, {"type": "subtitle", "time": 16832.07, "timestamp": "04:40:32", "text": "それを公開ウェブサイトか何かに掲載する。"}, {"type": "subtitle", "time": 16835.59, "timestamp": "04:40:35", "text": "わからない。うん、"}, {"type": "subtitle", "time": 16838.23, "timestamp": "04:40:38", "text": "さて、もし私が経営について話すとしたら"}, {"type": "subtitle", "time": 16842.47, "timestamp": "04:40:42", "text": "あれのことですよね？"}, {"type": "subtitle", "time": 16845.19, "timestamp": "04:40:45", "text": "えっと、つまり、彼らはすでにコメントしていたんです"}, {"type": "subtitle", "time": 16848.948, "timestamp": "04:40:48", "text": "について。うん。うん。うん。"}, {"type": "subtitle", "time": 16858.948, "timestamp": "04:40:58", "text": "そうそう。もし私が"}]
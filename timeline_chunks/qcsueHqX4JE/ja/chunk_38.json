[{"type": "subtitle", "time": 2285.91, "timestamp": "00:38:05", "text": "だから正直言うと、今日からずっと"}, {"type": "subtitle", "time": 2288.39, "timestamp": "00:38:08", "text": "私の先生はまだ「うん、なぜなら"}, {"type": "subtitle", "time": 2290.95, "timestamp": "00:38:10", "text": "今日のように私のセンサーが尋ねていた"}, {"type": "subtitle", "time": 2293.829, "timestamp": "00:38:13", "text": "生徒たちはあなたがその後何をするかを気に入っています"}, {"type": "subtitle", "time": 2295.51, "timestamp": "00:38:15", "text": "あなたの語学コースとその他すべて"}, {"type": "subtitle", "time": 2299.43, "timestamp": "00:38:19", "text": "彼らと話した後、私はこう思った"}, {"type": "subtitle", "time": 2313.67, "timestamp": "00:38:33", "text": "そして特に私は"}, {"type": "subtitle", "time": 2316.15, "timestamp": "00:38:36", "text": "音楽は、私には必要で、私には必要で"}, {"type": "subtitle", "time": 2318.31, "timestamp": "00:38:38", "text": "強力なポートフォリオ"}, {"type": "subtitle", "time": 2329.03, "timestamp": "00:38:49", "text": "そうそう。えっと、ガイドはどこで入手できますか？"}, {"type": "subtitle", "time": 2332.63, "timestamp": "00:38:52", "text": "えっと、DNA？私は推測する"}, {"type": "subtitle", "time": 2338.95, "timestamp": "00:38:58", "text": "DNA"}]
[{"type": "subtitle", "time": 10982.55, "timestamp": "03:03:02", "text": "6年間の有料教育の計算"}, {"type": "subtitle", "time": 10984.55, "timestamp": "03:03:04", "text": "日本で初級レベルの仕事に就く"}, {"type": "subtitle", "time": 10987.75, "timestamp": "03:03:07", "text": "あまりうまくいかない。うん、"}, {"type": "subtitle", "time": 10990.55, "timestamp": "03:03:10", "text": "私の場合、あまりうまくいかないし"}, {"type": "subtitle", "time": 10993.91, "timestamp": "03:03:13", "text": "6年で時間がなくなってきた"}, {"type": "subtitle", "time": 11010.389, "timestamp": "03:03:30", "text": "バイバイ。"}, {"type": "subtitle", "time": 11013.19, "timestamp": "03:03:33", "text": "そして今、私はその重要性に気づきました"}, {"type": "subtitle", "time": 11015.349, "timestamp": "03:03:35", "text": "安定させる。集中すべきだった"}, {"type": "subtitle", "time": 11018.63, "timestamp": "03:03:38", "text": "きちんと。もっと落ち着いて行動すべきだった。"}]
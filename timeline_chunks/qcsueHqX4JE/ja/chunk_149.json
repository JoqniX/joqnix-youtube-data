[{"type": "subtitle", "time": 8941.91, "timestamp": "02:29:01", "text": "大学進学でも就職でも何でもいい。そして"}, {"type": "subtitle", "time": 8945.91, "timestamp": "02:29:05", "text": "ええと、Nは重要です。だから私は"}, {"type": "subtitle", "time": 8949.11, "timestamp": "02:29:09", "text": "語学学校に行く、えっと、これ"}, {"type": "subtitle", "time": 8954.63, "timestamp": "02:29:14", "text": "来年4月。 2026年4月から202まで待つ"}, {"type": "subtitle", "time": 8960.07, "timestamp": "02:29:20", "text": "2026年から2027年は1年で、2028年4月です。"}, {"type": "subtitle", "time": 8962.87, "timestamp": "02:29:22", "text": "私のコースが終わったら、"}, {"type": "subtitle", "time": 8966.87, "timestamp": "02:29:26", "text": "レネは大学に入学しようとしています"}, {"type": "subtitle", "time": 8968.469, "timestamp": "02:29:28", "text": "そこで私は4年間"}, {"type": "subtitle", "time": 8971.51, "timestamp": "02:29:31", "text": "独身者って、えっと、独身者じゃなくて、"}, {"type": "subtitle", "time": 8974.71, "timestamp": "02:29:34", "text": "学位、学士号、何でもいいよ"}, {"type": "subtitle", "time": 8977.19, "timestamp": "02:29:37", "text": "えーと"}, {"type": "subtitle", "time": 8979.83, "timestamp": "02:29:39", "text": "もし私が [鼻を鳴らして] イグヌのものを片付けられないなら"}, {"type": "subtitle", "time": 8982.95, "timestamp": "02:29:42", "text": "インドからだよ、だって今からそこに行くから"}, {"type": "subtitle", "time": 8985.349, "timestamp": "02:29:45", "text": "年。だから、もし私がそれをクリアできないなら"}, {"type": "subtitle", "time": 8988.309, "timestamp": "02:29:48", "text": "チャンスがあれば、私は4年間"}, {"type": "subtitle", "time": 8991.349, "timestamp": "02:29:51", "text": "日本。そうすれば十分な"}, {"type": "subtitle", "time": 8995.349, "timestamp": "02:29:55", "text": "信用スコアは120点くらい。えっと、"}, {"type": "subtitle", "time": 8998.389, "timestamp": "02:29:58", "text": "移民やビザの担当者は行かない"}]
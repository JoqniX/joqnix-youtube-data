[{"type": "subtitle", "time": 16622.07, "timestamp": "04:37:02", "text": "私はそういうタイプのマネージャーではない"}, {"type": "subtitle", "time": 16628.629, "timestamp": "04:37:08", "text": "マネージャーの仕事ってどんな感じ？"}, {"type": "subtitle", "time": 16631.029, "timestamp": "04:37:11", "text": "スケジュールを維持し、"}, {"type": "subtitle", "time": 16632.869, "timestamp": "04:37:12", "text": "スポンサーシップと"}, {"type": "subtitle", "time": 16635.99, "timestamp": "04:37:15", "text": "分析とあれこれ"}, {"type": "subtitle", "time": 16646.23, "timestamp": "04:37:26", "text": "それから彼女は説明した"}, {"type": "subtitle", "time": 16648.47, "timestamp": "04:37:28", "text": "結婚という言葉がどのように使われているか"}, {"type": "subtitle", "time": 16652.15, "timestamp": "04:37:32", "text": "彼氏のために。ブラザー。そうそう。うん。"}, {"type": "subtitle", "time": 16655.59, "timestamp": "04:37:35", "text": "うん。私はそれを見ました。ちびキャラ。ない"}, {"type": "subtitle", "time": 16660.07, "timestamp": "04:37:40", "text": "ちび。ええと、落ちた影と弓。"}, {"type": "subtitle", "time": 16663.83, "timestamp": "04:37:43", "text": "クジラ。それはバだったのか？忘れた。忘れた"}, {"type": "subtitle", "time": 16668.47, "timestamp": "04:37:48", "text": "誰が誰だったのか。あのドラマチックなやつ。"}, {"type": "subtitle", "time": 16674.949, "timestamp": "04:37:54", "text": "そして、それがその女の子です。彼女は幸せだった"}]
[{"type": "subtitle", "time": 18138.07, "timestamp": "05:02:18", "text": "母親。彼はまだ禁止されていた"}, {"type": "subtitle", "time": 18139.91, "timestamp": "05:02:19", "text": "トーナメント。"}, {"type": "subtitle", "time": 18142.948, "timestamp": "05:02:22", "text": "ああ、このスマブラプレイヤーは"}, {"type": "subtitle", "time": 18148.23, "timestamp": "05:02:28", "text": "何"}, {"type": "subtitle", "time": 18150.39, "timestamp": "05:02:30", "text": "なぜ私が行ったものが"}, {"type": "subtitle", "time": 18152.788, "timestamp": "05:02:32", "text": "を通して？ [笑い]"}, {"type": "subtitle", "time": 18155.11, "timestamp": "05:02:35", "text": "彼のゲームは彼のすべての"}, {"type": "subtitle", "time": 18156.868, "timestamp": "05:02:36", "text": "スポンサーが撤退しました。彼はまだ禁止されていた"}, {"type": "subtitle", "time": 18160.788, "timestamp": "05:02:40", "text": "トーナメント。 H それなら同じですね"}, {"type": "subtitle", "time": 18163.03, "timestamp": "05:02:43", "text": "ここで私に起こったこと。あなた"}, {"type": "subtitle", "time": 18164.55, "timestamp": "05:02:44", "text": "知る、"}, {"type": "subtitle", "time": 18167.67, "timestamp": "05:02:47", "text": "欲しい人は私に次のようなリソースを与えてくれました"}, {"type": "subtitle", "time": 18171.03, "timestamp": "05:02:51", "text": "ストリームアセットと"}, {"type": "subtitle", "time": 18174.31, "timestamp": "05:02:54", "text": "私自身が作ったファンメイドの音楽アルバムなど"}, {"type": "subtitle", "time": 18177.27, "timestamp": "05:02:57", "text": "私のために物を作ってくれた人たち。それは使えません"}, {"type": "subtitle", "time": 18179.75, "timestamp": "05:02:59", "text": "もう。"}]
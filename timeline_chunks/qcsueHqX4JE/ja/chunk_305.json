[{"type": "subtitle", "time": 18303.99, "timestamp": "05:05:03", "text": "えっと"}, {"type": "subtitle", "time": 18306.788, "timestamp": "05:05:06", "text": "よく考えてみれば、それは役に立っただろうか？"}, {"type": "subtitle", "time": 18315.91, "timestamp": "05:05:15", "text": "それは誰かの役に立ったのでしょうか？それは役に立ちましたか？"}, {"type": "subtitle", "time": 18318.708, "timestamp": "05:05:18", "text": "南カリフォルニアのあの辺りのこと？役に立ちましたか？"}, {"type": "subtitle", "time": 18320.948, "timestamp": "05:05:20", "text": "彼ら？いいえ。"}, {"type": "subtitle", "time": 18324.15, "timestamp": "05:05:24", "text": "それは私にとって役に立ったか？いいえ。"}, {"type": "subtitle", "time": 18326.446, "timestamp": "05:05:26", "text": "バレーボール。私はそれらを次のようにしました"}, {"type": "subtitle", "time": 18327.99, "timestamp": "05:05:27", "text": "[笑い声と息を呑む音] 問題は今"}, {"type": "subtitle", "time": 18331.19, "timestamp": "05:05:31", "text": "人々は、"}, {"type": "subtitle", "time": 18333.83, "timestamp": "05:05:33", "text": "私の持ち物の後ろの様子とか"}, {"type": "subtitle", "time": 18335.67, "timestamp": "05:05:35", "text": "今"}, {"type": "subtitle", "time": 18338.708, "timestamp": "05:05:38", "text": "そして、彼らが理解したほとんどのユーチューバー"}, {"type": "subtitle", "time": 18342.31, "timestamp": "05:05:42", "text": "私のドラマはうん"}, {"type": "subtitle", "time": 18345.99, "timestamp": "05:05:45", "text": "人を信用しないこと。中には、"}, {"type": "subtitle", "time": 18348.39, "timestamp": "05:05:48", "text": "コミュニティ全体を去った"}, {"type": "subtitle", "time": 18351.27, "timestamp": "05:05:51", "text": "サーバー なぜなら私は以前は全員を招待していたから"}, {"type": "subtitle", "time": 18354.31, "timestamp": "05:05:54", "text": "インドのユーチューバーたちですよね？"}, {"type": "subtitle", "time": 18355.91, "timestamp": "05:05:55", "text": "えっと"}, {"type": "subtitle", "time": 18358.628, "timestamp": "05:05:58", "text": "私は出会ったインド人全員を招待していた"}]
[{"type": "subtitle", "time": 5858.39, "timestamp": "01:37:38", "text": "えっと、待って。私がこれを実行しているなら"}, {"type": "subtitle", "time": 5860.87, "timestamp": "01:37:40", "text": "2分間で何回走ればいいですか"}, {"type": "subtitle", "time": 5862.07, "timestamp": "01:37:42", "text": "私たちはそうします"}, {"type": "subtitle", "time": 5864.31, "timestamp": "01:37:44", "text": "1時間で？"}, {"type": "subtitle", "time": 5872.149, "timestamp": "01:37:52", "text": "でも、いいことですよね。私が話すように"}, {"type": "subtitle", "time": 5874.31, "timestamp": "01:37:54", "text": "ランダムなトピック"}, {"type": "subtitle", "time": 5877.27, "timestamp": "01:37:57", "text": "そして私は"}]
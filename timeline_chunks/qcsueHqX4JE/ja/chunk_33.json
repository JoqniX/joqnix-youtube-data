[{"type": "subtitle", "time": 1983.509, "timestamp": "00:33:03", "text": "大学の学士号のようなもの"}, {"type": "subtitle", "time": 1986.07, "timestamp": "00:33:06", "text": "日本の大学"}, {"type": "subtitle", "time": 1988.47, "timestamp": "00:33:08", "text": "だって今は信用スコアとか全部"}, {"type": "subtitle", "time": 1991.75, "timestamp": "00:33:11", "text": "移民とビザのため"}, {"type": "subtitle", "time": 1998.95, "timestamp": "00:33:18", "text": "えっと"}, {"type": "subtitle", "time": 2001.59, "timestamp": "00:33:21", "text": "最後には私は30代か"}, {"type": "subtitle", "time": 2015.75, "timestamp": "00:33:35", "text": "でも、私の場合はそうしないといけないんです"}, {"type": "subtitle", "time": 2018.07, "timestamp": "00:33:38", "text": "行こうと思っている"}, {"type": "subtitle", "time": 2021.35, "timestamp": "00:33:41", "text": "私は音楽を追求しているので、ある意味で私は"}, {"type": "subtitle", "time": 2023.509, "timestamp": "00:33:43", "text": "ポートフォリオを構築するには、"}, {"type": "subtitle", "time": 2026.95, "timestamp": "00:33:46", "text": "日本のユーチューバーと繋がって、えーと"}, {"type": "subtitle", "time": 2029.509, "timestamp": "00:33:49", "text": "プロデューサーや歌う人、"}, {"type": "subtitle", "time": 2032.07, "timestamp": "00:33:52", "text": "すべてにつながり、"}, {"type": "subtitle", "time": 2035.029, "timestamp": "00:33:55", "text": "産業もその他すべて。もし私がそうできるなら"}, {"type": "subtitle", "time": 2037.669, "timestamp": "00:33:57", "text": "何とか仕事とかを確保して、それから"}]
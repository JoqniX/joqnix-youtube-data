[{"type": "subtitle", "time": 2882.71, "timestamp": "00:48:02", "text": "わかった。えっと"}, {"type": "subtitle", "time": 2884.309, "timestamp": "00:48:04", "text": "戦闘"}, {"type": "subtitle", "time": 2887.51, "timestamp": "00:48:07", "text": "これ。いや、いや、いや。悪魔の棺。うん。"}, {"type": "subtitle", "time": 2892.23, "timestamp": "00:48:12", "text": "それがどこにあるのか確認してみましょう。わかった。えっと"}, {"type": "subtitle", "time": 2899.19, "timestamp": "00:48:19", "text": "発火。イグナイトはどこで入手できますか？"}, {"type": "subtitle", "time": 2902.87, "timestamp": "00:48:22", "text": "なあ、ここからは俺がやるよ。おお。"}, {"type": "subtitle", "time": 2906.95, "timestamp": "00:48:26", "text": "あ、待って。買えますよ。彼彼"}, {"type": "subtitle", "time": 2909.67, "timestamp": "00:48:29", "text": "全て完了しました。私はすべてをクリアしました"}, {"type": "subtitle", "time": 2911.75, "timestamp": "00:48:31", "text": "地図の隅々まで、"}, {"type": "subtitle", "time": 2919.27, "timestamp": "00:48:39", "text": "それを忘れていました。うん、"}, {"type": "subtitle", "time": 2932.71, "timestamp": "00:48:52", "text": "これも売り切れにしちゃおう。"}, {"type": "subtitle", "time": 2936.15, "timestamp": "00:48:56", "text": "なぜ私には一つだけ残っているのだろう？"}, {"type": "subtitle", "time": 2938.63, "timestamp": "00:48:58", "text": "よし、探検家みたいなやつね。私は終えた"}]
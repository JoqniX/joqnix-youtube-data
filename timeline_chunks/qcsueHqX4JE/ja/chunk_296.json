[{"type": "subtitle", "time": 17760.47, "timestamp": "04:56:00", "text": "自分の問題、ああ、その現実が私に突き刺さった。"}, {"type": "subtitle", "time": 17764.07, "timestamp": "04:56:04", "text": "こんにちは。戻ってきました。ごめん。えっと、たくさん"}, {"type": "subtitle", "time": 17768.31, "timestamp": "04:56:08", "text": "みんなが私をブロックしたりしてる。"}, {"type": "subtitle", "time": 17770.628, "timestamp": "04:56:10", "text": "Jコールの曲の歌詞にこんなものがあります"}, {"type": "subtitle", "time": 17773.43, "timestamp": "04:56:13", "text": "「オーケー、たくさんの人が"}, {"type": "subtitle", "time": 17774.868, "timestamp": "04:56:14", "text": "私をブロックして友達になり、"}, {"type": "subtitle", "time": 17776.628, "timestamp": "04:56:16", "text": "「だから、彼らは私に返信できなかったんだ。」"}, {"type": "subtitle", "time": 17778.31, "timestamp": "04:56:18", "text": "右？もしくは、私を友達に追加してください。"}, {"type": "subtitle", "time": 17781.35, "timestamp": "04:56:21", "text": "右？まあ、そういうことだ。"}, {"type": "subtitle", "time": 17783.19, "timestamp": "04:56:23", "text": "彼女のことは言わないで。彼女はなりたくない"}, {"type": "subtitle", "time": 17786.07, "timestamp": "04:56:26", "text": "保存しました。"}, {"type": "subtitle", "time": 17793.51, "timestamp": "04:56:33", "text": "えっと、人を直すのはあなたの仕事じゃないよ。"}, {"type": "subtitle", "time": 17796.708, "timestamp": "04:56:36", "text": "うん、本当だね。それは私の仕事ではありません。その通り。"}, {"type": "subtitle", "time": 17799.51, "timestamp": "04:56:39", "text": "私はセラピストではありません。"}, {"type": "subtitle", "time": 17801.43, "timestamp": "04:56:41", "text": "うん。"}, {"type": "subtitle", "time": 17804.15, "timestamp": "04:56:44", "text": "ええ、そうですね。戻ってきました。えっと、私は"}, {"type": "subtitle", "time": 17806.47, "timestamp": "04:56:46", "text": "これはパラソーシャルに該当するのだろうか。"}, {"type": "subtitle", "time": 17809.67, "timestamp": "04:56:49", "text": "いいえ、違います。そうではないと思います。"}, {"type": "subtitle", "time": 17811.19, "timestamp": "04:56:51", "text": "そうではないとは思いません。私たちはただ"}, {"type": "subtitle", "time": 17813.59, "timestamp": "04:56:53", "text": "会話をしている。私たちは"}, {"type": "subtitle", "time": 17816.708, "timestamp": "04:56:56", "text": "ランダムな話題。 [笑い]"}]
[{"type": "subtitle", "time": 12307.11, "timestamp": "03:25:07", "text": "相互扶助によれば、人生は苦痛である"}, {"type": "subtitle", "time": 12310.95, "timestamp": "03:25:10", "text": "今日。 18％くらいになります"}, {"type": "subtitle", "time": 12313.59, "timestamp": "03:25:13", "text": "変動により月が1ヶ月で、私は"}, {"type": "subtitle", "time": 12316.229, "timestamp": "03:25:16", "text": "それが何なのか理解してください。"}, {"type": "subtitle", "time": 12318.15, "timestamp": "03:25:18", "text": "それは良いことだと思います。私はそうは思わない"}, {"type": "subtitle", "time": 12321.269, "timestamp": "03:25:21", "text": "分散とは何かを知る。わからない"}]
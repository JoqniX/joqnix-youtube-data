[{"type": "subtitle", "time": 5162.47, "timestamp": "01:26:02", "text": "唯一の"}, {"type": "subtitle", "time": 5164.229, "timestamp": "01:26:04", "text": "だから私は尋ねているのです、あなたはすべてではない"}, {"type": "subtitle", "time": 5166.79, "timestamp": "01:26:06", "text": "いつもダークニック。"}, {"type": "subtitle", "time": 5171.43, "timestamp": "01:26:11", "text": "ええ、つまり、今になってそれに気づいたんです。"}, {"type": "subtitle", "time": 5176.07, "timestamp": "01:26:16", "text": "ああ、私のようにね。冗談じゃないよ"}, {"type": "subtitle", "time": 5180.149, "timestamp": "01:26:20", "text": "私の持ち物すべて。私の署名"}, {"type": "subtitle", "time": 5182.79, "timestamp": "01:26:22", "text": "すべてがスポーツマン風だ。はい、私の法律"}, {"type": "subtitle", "time": 5184.39, "timestamp": "01:26:24", "text": "ドキュメントはすべてジョックニックです"}, {"type": "subtitle", "time": 5186.709, "timestamp": "01:26:26", "text": "サイン。冗談だよ"}, {"type": "subtitle", "time": 5202.55, "timestamp": "01:26:42", "text": "だから、最終的にはそうしなければならない"}, {"type": "subtitle", "time": 5206.79, "timestamp": "01:26:46", "text": "現実世界にも目を向けよう。それは重要です"}, {"type": "subtitle", "time": 5209.99, "timestamp": "01:26:49", "text": "趣味か何かと見なすこともできる"}, {"type": "subtitle", "time": 5218.95, "timestamp": "01:26:58", "text": "そういうものがたくさんあります。えーっと"}]
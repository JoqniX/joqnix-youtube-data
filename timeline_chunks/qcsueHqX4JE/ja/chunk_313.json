[{"type": "subtitle", "time": 18782.07, "timestamp": "05:13:02", "text": "それ。私が作ったあのビデオのように"}, {"type": "subtitle", "time": 18785.51, "timestamp": "05:13:05", "text": "午前3時にわめき散らす。正直に言うと"}, {"type": "subtitle", "time": 18788.15, "timestamp": "05:13:08", "text": "オレンジが実際にリリースする"}, {"type": "subtitle", "time": 18791.51, "timestamp": "05:13:11", "text": "動画、アップデート動画。多分"}, {"type": "subtitle", "time": 18794.23, "timestamp": "05:13:14", "text": "動画はまだ公開されていると思います。ジョックは"}, {"type": "subtitle", "time": 18797.83, "timestamp": "05:13:17", "text": "捕食動物か何か。そうなんですか？私は"}, {"type": "subtitle", "time": 18800.788, "timestamp": "05:13:20", "text": "コミュニティ投稿をするように彼に言った"}, {"type": "subtitle", "time": 18803.35, "timestamp": "05:13:23", "text": "ツイートでも何でもいいから。なぜあなたが"}, {"type": "subtitle", "time": 18806.868, "timestamp": "05:13:26", "text": "彼が言ったようにプライベートが好きだから"}, {"type": "subtitle", "time": 18810.23, "timestamp": "05:13:30", "text": "などなど。でも、できれば作りたいな"}, {"type": "subtitle", "time": 18813.27, "timestamp": "05:13:33", "text": "全体をカバーするような2つ目のビデオ"}, {"type": "subtitle", "time": 18815.75, "timestamp": "05:13:35", "text": "全体として。私のドラマだけじゃない"}, {"type": "subtitle", "time": 18827.11, "timestamp": "05:13:47", "text": "彼は、彼が言ったように、いいえ"}, {"type": "subtitle", "time": 18829.59, "timestamp": "05:13:49", "text": "一人がそれについて話していて、すべてが"}, {"type": "subtitle", "time": 18831.35, "timestamp": "05:13:51", "text": "ここで閉じた方が良い"}, {"type": "subtitle", "time": 18833.03, "timestamp": "05:13:53", "text": "すべて。だから彼は選ばなかった"}, {"type": "subtitle", "time": 18835.99, "timestamp": "05:13:55", "text": "それをアップロードするには、2番目のパートのように"}, {"type": "subtitle", "time": 18839.67, "timestamp": "05:13:59", "text": "私の側からの更新部分はすべて問題ありません"}]
[{"type": "subtitle", "time": 12120.15, "timestamp": "03:22:00", "text": "コネクションとか色々あって、彼らはそれをやったんだ。で"}, {"type": "subtitle", "time": 12123.269, "timestamp": "03:22:03", "text": "私の場合は他の部分にアクセスできませんでした"}, {"type": "subtitle", "time": 12126.55, "timestamp": "03:22:06", "text": "日本全国にある他の語学学校の"}, {"type": "subtitle", "time": 12134.07, "timestamp": "03:22:14", "text": "うん。"}, {"type": "subtitle", "time": 12165.349, "timestamp": "03:22:45", "text": "ドメトリについても、私は"}, {"type": "subtitle", "time": 12169.349, "timestamp": "03:22:49", "text": "まるで一つの部屋のように。なぜ？なぜなら私は"}, {"type": "subtitle", "time": 12172.95, "timestamp": "03:22:52", "text": "ストリーミング配信する。やりたいことがある"}, {"type": "subtitle", "time": 12175.83, "timestamp": "03:22:55", "text": "もしそれが"}, {"type": "subtitle", "time": 12178.95, "timestamp": "03:22:58", "text": "ここにルームメイトがいます。"}]
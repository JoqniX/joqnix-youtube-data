[{"type": "subtitle", "time": 17827.51, "timestamp": "04:57:07", "text": "えーと、もし彼らがそうしたいなら、そうしたいなら"}, {"type": "subtitle", "time": 17830.708, "timestamp": "04:57:10", "text": "修正済み、そうでなければ努力する"}, {"type": "subtitle", "time": 17834.23, "timestamp": "04:57:14", "text": "それはただ注目を集めようとしているだけだ。本当です。"}, {"type": "subtitle", "time": 17837.43, "timestamp": "04:57:17", "text": "そうですね、ほとんどの人はそうですね。"}, {"type": "subtitle", "time": 17840.47, "timestamp": "04:57:20", "text": "今、私を友達リストから削除した人たち。だから私は"}, {"type": "subtitle", "time": 17844.07, "timestamp": "04:57:24", "text": "それを得る。後になってその理由がわかった"}, {"type": "subtitle", "time": 17846.31, "timestamp": "04:57:26", "text": "ほとんどの人は、"}, {"type": "subtitle", "time": 17850.23, "timestamp": "04:57:30", "text": "私、もしくは友達解除とか何かで切り捨てる"}, {"type": "subtitle", "time": 17852.628, "timestamp": "04:57:32", "text": "公の場で私と話すことを拒否し、"}, {"type": "subtitle", "time": 17855.43, "timestamp": "04:57:35", "text": "ドラマの時みたいなもの"}, {"type": "subtitle", "time": 17858.708, "timestamp": "04:57:38", "text": "そう、だってディディの物とディドラー"}, {"type": "subtitle", "time": 17861.11, "timestamp": "04:57:41", "text": "そういうこと、知らなかったよ"}, {"type": "subtitle", "time": 17865.67, "timestamp": "04:57:45", "text": "実は知らなかったんです。"}, {"type": "subtitle", "time": 17869.19, "timestamp": "04:57:49", "text": "彼らのうちの一人が私に言わない限り"}, {"type": "subtitle", "time": 17871.99, "timestamp": "04:57:51", "text": "だから、私は友達になりたくなかった"}, {"type": "subtitle", "time": 17874.39, "timestamp": "04:57:54", "text": "児童虐待の容疑をかけられた人、"}, {"type": "subtitle", "time": 17876.788, "timestamp": "04:57:56", "text": "何か。それで実際に調べてみたところ"}]
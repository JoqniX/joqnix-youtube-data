[{"type": "subtitle", "time": 13021.75, "timestamp": "03:37:01", "text": "まあ、そういうことですね。"}, {"type": "subtitle", "time": 13024.55, "timestamp": "03:37:04", "text": "それは本当に素晴らしいですね。"}, {"type": "subtitle", "time": 13027.83, "timestamp": "03:37:07", "text": "それは私の場合と似ています"}, {"type": "subtitle", "time": 13029.91, "timestamp": "03:37:09", "text": "そうですよね？最初のパッチではないと思います"}, {"type": "subtitle", "time": 13032.15, "timestamp": "03:37:12", "text": "2回目のバッチだと思います。ビデオにあるように。"}, {"type": "subtitle", "time": 13036.07, "timestamp": "03:37:16", "text": "ギア比の感覚。ニサンジが来て、"}, {"type": "subtitle", "time": 13042.229, "timestamp": "03:37:22", "text": "そして、えっと"}, {"type": "subtitle", "time": 13045.19, "timestamp": "03:37:25", "text": "ええ、それからいくつかあります"}, {"type": "subtitle", "time": 13048.229, "timestamp": "03:37:28", "text": "インドのメイシュとかそういうもの。"}, {"type": "subtitle", "time": 13052.469, "timestamp": "03:37:32", "text": "ああ、インドから流れ出るんだ。それは私だった、私はまだ"}, {"type": "subtitle", "time": 13055.99, "timestamp": "03:37:35", "text": "二人とも楽しい目だったらよかったのに"}, {"type": "subtitle", "time": 13057.59, "timestamp": "03:37:37", "text": "のように"}, {"type": "subtitle", "time": 13060.389, "timestamp": "03:37:40", "text": "私はよく彼らの番組を見ていた。私は楽しんでいます"}, {"type": "subtitle", "time": 13062.87, "timestamp": "03:37:42", "text": "彼らのコンテンツ、"}]
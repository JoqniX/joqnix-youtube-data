[{"type": "subtitle", "time": 17581.11, "timestamp": "04:53:01", "text": "彼らが私と繋がれるように"}, {"type": "subtitle", "time": 17584.23, "timestamp": "04:53:04", "text": "タスク YouTuber または他の YouTuber と一緒に"}, {"type": "subtitle", "time": 17587.51, "timestamp": "04:53:07", "text": "今は友達で、昔は"}, {"type": "subtitle", "time": 17589.75, "timestamp": "04:53:09", "text": "あまりにも"}, {"type": "subtitle", "time": 17593.75, "timestamp": "04:53:13", "text": "トラウマの排出のような有害な痛みと"}, {"type": "subtitle", "time": 17597.43, "timestamp": "04:53:17", "text": "攻撃性とかあれこれ、私は"}, {"type": "subtitle", "time": 17601.19, "timestamp": "04:53:21", "text": "もう十分苦しんだ"}, {"type": "subtitle", "time": 17603.27, "timestamp": "04:53:23", "text": "私は人を許しすぎるタイプです"}, {"type": "subtitle", "time": 17607.03, "timestamp": "04:53:27", "text": "今、そこにいた同じ人々が"}, {"type": "subtitle", "time": 17609.75, "timestamp": "04:53:29", "text": "私を助けて、あのユーチューバーたちみたいに"}, {"type": "subtitle", "time": 17612.31, "timestamp": "04:53:32", "text": "私を助けて、そう言ってくれる"}, {"type": "subtitle", "time": 17614.868, "timestamp": "04:53:34", "text": "そして彼らはまた、そうだと言っていた"}, {"type": "subtitle", "time": 17617.11, "timestamp": "04:53:37", "text": "切り取るべきです"}, {"type": "subtitle", "time": 17619.35, "timestamp": "04:53:39", "text": "境界線を設定するなど。それは"}, {"type": "subtitle", "time": 17623.27, "timestamp": "04:53:43", "text": "どうやって気づいたかというと、そうすべきではなかったと。"}, {"type": "subtitle", "time": 17626.948, "timestamp": "04:53:46", "text": "アドバイスをください、そして、えっと、あなたは"}, {"type": "subtitle", "time": 17629.67, "timestamp": "04:53:49", "text": "助けようとしない人たちを助けよう"}, {"type": "subtitle", "time": 17632.708, "timestamp": "04:53:52", "text": "私の助けを今すぐ、あるいは正しい人々の話を聞くこと"}, {"type": "subtitle", "time": 17635.35, "timestamp": "04:53:55", "text": "ウィルは、"}, {"type": "subtitle", "time": 17638.23, "timestamp": "04:53:58", "text": "他の人に不気味に思われる人"}]
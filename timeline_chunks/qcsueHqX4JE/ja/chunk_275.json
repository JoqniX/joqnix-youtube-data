[{"type": "subtitle", "time": 16501.51, "timestamp": "04:35:01", "text": "深刻な燃え尽き症候群になった。"}, {"type": "subtitle", "time": 16503.269, "timestamp": "04:35:03", "text": "私はこれをやりたくないと思っています"}, {"type": "subtitle", "time": 16504.949, "timestamp": "04:35:04", "text": "もう。"}, {"type": "subtitle", "time": 16508.31, "timestamp": "04:35:08", "text": "でも、もし私がそれをできるなら"}, {"type": "subtitle", "time": 16510.39, "timestamp": "04:35:10", "text": "そして給料をもらえれば、それはまた別の話だ。"}, {"type": "subtitle", "time": 16512.709, "timestamp": "04:35:12", "text": "もう一つやりたいことは音楽です"}, {"type": "subtitle", "time": 16515.349, "timestamp": "04:35:15", "text": "私は音楽の依頼しか受け付けられない"}, {"type": "subtitle", "time": 16519.429, "timestamp": "04:35:19", "text": "一度私が"}, {"type": "subtitle", "time": 16522.551, "timestamp": "04:35:22", "text": "良い音楽を作ろう。"}, {"type": "subtitle", "time": 16524.869, "timestamp": "04:35:24", "text": "うん。"}, {"type": "subtitle", "time": 16527.269, "timestamp": "04:35:27", "text": "そしてまた一つ。"}, {"type": "subtitle", "time": 16529.75, "timestamp": "04:35:29", "text": "私は自分がどこにいるのか、どこにいるのかわからない"}, {"type": "subtitle", "time": 16537.189, "timestamp": "04:35:37", "text": "自分のスキルが何なのかさえ分からない。"}, {"type": "subtitle", "time": 16539.109, "timestamp": "04:35:39", "text": "動画編集関連のもの。ええ、私は昔"}, {"type": "subtitle", "time": 16546.551, "timestamp": "04:35:46", "text": "えっと、私は以前そのグループのポッドキャストを編集していました"}, {"type": "subtitle", "time": 16553.109, "timestamp": "04:35:53", "text": "私は仮想現実の件に関わっていました"}, {"type": "subtitle", "time": 16555.109, "timestamp": "04:35:55", "text": "そして"}, {"type": "subtitle", "time": 16557.269, "timestamp": "04:35:57", "text": "しかし"}]
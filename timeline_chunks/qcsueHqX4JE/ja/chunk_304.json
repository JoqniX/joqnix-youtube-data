[{"type": "subtitle", "time": 18240.39, "timestamp": "05:04:00", "text": "でも今なら、私はそうできたはずだと理解しています"}, {"type": "subtitle", "time": 18243.99, "timestamp": "05:04:03", "text": "多くのこと。えっと"}, {"type": "subtitle", "time": 18248.31, "timestamp": "05:04:08", "text": "ああ、君自身じゃないよ。そう、まさにその通り。"}, {"type": "subtitle", "time": 18251.91, "timestamp": "05:04:11", "text": "これらすべてを見て、私は多くのことを学びました。"}, {"type": "subtitle", "time": 18253.51, "timestamp": "05:04:13", "text": "ハプニング"}, {"type": "subtitle", "time": 18261.27, "timestamp": "05:04:21", "text": "そしてそれは古い問題で、"}, {"type": "subtitle", "time": 18264.47, "timestamp": "05:04:24", "text": "理由。それはそうならざるを得なかった"}, {"type": "subtitle", "time": 18272.07, "timestamp": "05:04:32", "text": "えっと、"}, {"type": "subtitle", "time": 18274.47, "timestamp": "05:04:34", "text": "私は自分のことに集中していた。取った"}, {"type": "subtitle", "time": 18277.67, "timestamp": "05:04:37", "text": "セラピー、癒され、私の"}, {"type": "subtitle", "time": 18281.59, "timestamp": "05:04:41", "text": "サバタソンでモデル代を払う"}, {"type": "subtitle", "time": 18285.11, "timestamp": "05:04:45", "text": "そして実際にデビュー"}, {"type": "subtitle", "time": 18286.868, "timestamp": "05:04:46", "text": "すべて。"}, {"type": "subtitle", "time": 18290.47, "timestamp": "05:04:50", "text": "下水道に入ったんだと思う、ダンプカー、私は"}, {"type": "subtitle", "time": 18293.91, "timestamp": "05:04:53", "text": "推測。他の"}, {"type": "subtitle", "time": 18295.27, "timestamp": "05:04:55", "text": "側。彼らが"}]
[{"type": "subtitle", "time": 16861.91, "timestamp": "04:41:01", "text": "管理業務みたいなものですよね？"}, {"type": "subtitle", "time": 16863.83, "timestamp": "04:41:03", "text": "えっと、"}, {"type": "subtitle", "time": 16867.91, "timestamp": "04:41:07", "text": "私はそのつながりがないと思います"}, {"type": "subtitle", "time": 16875.67, "timestamp": "04:41:15", "text": "ええと、本当のマネジメントですね。ええ、誰かが"}, {"type": "subtitle", "time": 16877.43, "timestamp": "04:41:17", "text": "私が来たビデオの1つには"}, {"type": "subtitle", "time": 16879.91, "timestamp": "04:41:19", "text": "クラッシュして、ああ、ああ、"}, {"type": "subtitle", "time": 16882.628, "timestamp": "04:41:22", "text": "人。うん、そうだね。私の父"}, {"type": "subtitle", "time": 16884.15, "timestamp": "04:41:24", "text": "言った、"}, {"type": "subtitle", "time": 16888.788, "timestamp": "04:41:28", "text": "父は私がプネーに行くことに反対だった"}, {"type": "subtitle", "time": 16892.39, "timestamp": "04:41:32", "text": "コミコンに行く予定なので"}, {"type": "subtitle", "time": 16896.39, "timestamp": "04:41:36", "text": "日本とかそういうやつ。私はそこにいるべきではない"}, {"type": "subtitle", "time": 16899.03, "timestamp": "04:41:39", "text": "何らかのトラブルがあって、それが私の最初の"}, {"type": "subtitle", "time": 16903.35, "timestamp": "04:41:43", "text": "スカララ地方の外へ出かける時間さえも"}, {"type": "subtitle", "time": 16906.31, "timestamp": "04:41:46", "text": "あるいは私の州やその他全てを私一人で"}, {"type": "subtitle", "time": 16910.788, "timestamp": "04:41:50", "text": "それについても彼は懐疑的だった。"}, {"type": "subtitle", "time": 16914.55, "timestamp": "04:41:54", "text": "同じく"}, {"type": "subtitle", "time": 16919.03, "timestamp": "04:41:59", "text": "ケララ出身の人も好きだった"}]
[{"type": "subtitle", "time": 5400.229, "timestamp": "01:30:00", "text": "うん。"}, {"type": "subtitle", "time": 5413.83, "timestamp": "01:30:13", "text": "そして、私の父もそれを知っています。ええ、私は"}, {"type": "subtitle", "time": 5415.83, "timestamp": "01:30:15", "text": "情熱を持ってやっているからやるんだ"}, {"type": "subtitle", "time": 5419.43, "timestamp": "01:30:19", "text": "ストリーミングと私がやりたいこと、"}, {"type": "subtitle", "time": 5420.629, "timestamp": "01:30:20", "text": "すべて。"}, {"type": "subtitle", "time": 5424.229, "timestamp": "01:30:24", "text": "それは良い。私が出会う人々と同じように"}, {"type": "subtitle", "time": 5426.79, "timestamp": "01:30:26", "text": "次のような人たち"}, {"type": "subtitle", "time": 5428.709, "timestamp": "01:30:28", "text": "一つ気づいたことがあります。わかった。"}, {"type": "chat", "time": 5430.393, "timestamp": "01:30:30", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "what do you think you still play games like this in future?"}, {"type": "subtitle", "time": 5431.669, "timestamp": "01:30:31", "text": "正直に言うと、私が新しく出会う人々は"}, {"type": "subtitle", "time": 5434.55, "timestamp": "01:30:34", "text": "私が知らない人たちに"}, {"type": "subtitle", "time": 5436.229, "timestamp": "01:30:36", "text": "それ"}, {"type": "subtitle", "time": 5439.75, "timestamp": "01:30:39", "text": "ええと、私が彼らにこう言うと、"}, {"type": "subtitle", "time": 5441.51, "timestamp": "01:30:41", "text": "それ"}, {"type": "subtitle", "time": 5445.27, "timestamp": "01:30:45", "text": "私はこれに情熱を注いでいます"}, {"type": "subtitle", "time": 5454.31, "timestamp": "01:30:54", "text": "そしてそれは私をも幸せにするけれど、私は"}, {"type": "subtitle", "time": 5457.11, "timestamp": "01:30:57", "text": "ああ、それほど大きな感覚ではない"}, {"type": "subtitle", "time": 5459.03, "timestamp": "01:30:59", "text": "のように"}]
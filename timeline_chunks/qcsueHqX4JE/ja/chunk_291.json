[{"type": "subtitle", "time": 17462.948, "timestamp": "04:51:02", "text": "このプロ意識が気に入ったので、"}, {"type": "subtitle", "time": 17465.75, "timestamp": "04:51:05", "text": "すべてが完璧になるように私は"}, {"type": "subtitle", "time": 17468.07, "timestamp": "04:51:08", "text": "物のように"}, {"type": "subtitle", "time": 17472.23, "timestamp": "04:51:12", "text": "すべてが完全に自動化されている場所で"}, {"type": "subtitle", "time": 17475.11, "timestamp": "04:51:15", "text": "Sammy streamot を全て使用して"}, {"type": "subtitle", "time": 17477.67, "timestamp": "04:51:17", "text": "自動的にその人を大声で叫ぶ"}, {"type": "subtitle", "time": 17480.31, "timestamp": "04:51:20", "text": "彼らの料金とあれは自動的に"}, {"type": "subtitle", "time": 17483.43, "timestamp": "04:51:23", "text": "旗や、自動モードのタイムアウト回数など"}, {"type": "subtitle", "time": 17485.91, "timestamp": "04:51:25", "text": "また、Discordのログも保存している。"}, {"type": "subtitle", "time": 17488.31, "timestamp": "04:51:28", "text": "つまり、モデレーターには仕事がないということだ"}, {"type": "subtitle", "time": 17490.55, "timestamp": "04:51:30", "text": "する。 [笑い]"}, {"type": "subtitle", "time": 17497.51, "timestamp": "04:51:37", "text": "そう、微妙な判断が求められる。確かに、確かに、"}, {"type": "subtitle", "time": 17505.27, "timestamp": "04:51:45", "text": "ショーの"}, {"type": "subtitle", "time": 17513.27, "timestamp": "04:51:53", "text": "現時点でモデレーターはいますか？私"}, {"type": "subtitle", "time": 17516.788, "timestamp": "04:51:56", "text": "わからない。私はモデレーターを置いていません。それで、"}, {"type": "subtitle", "time": 17518.788, "timestamp": "04:51:58", "text": "問題は、私が多くのことに気づいたことです"}]
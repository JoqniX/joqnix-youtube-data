[{"type": "subtitle", "time": 5221.99, "timestamp": "01:27:01", "text": "最初の質問は正しい"}, {"type": "subtitle", "time": 5225.03, "timestamp": "01:27:05", "text": "えっと、あなたの両親はあなたに"}, {"type": "subtitle", "time": 5229.03, "timestamp": "01:27:09", "text": "父が私を助けてくれてよかった"}, {"type": "subtitle", "time": 5231.75, "timestamp": "01:27:11", "text": "自分を器として登録するなど"}, {"type": "subtitle", "time": 5234.149, "timestamp": "01:27:14", "text": "魂そのもの"}, {"type": "subtitle", "time": 5246.39, "timestamp": "01:27:26", "text": "そしてそれもまた大きなこと"}, {"type": "subtitle", "time": 5249.03, "timestamp": "01:27:29", "text": "そう、それは自分の"}, {"type": "subtitle", "time": 5252.149, "timestamp": "01:27:32", "text": "ビジネスや自分のオフィスを開設する"}, {"type": "subtitle", "time": 5263.11, "timestamp": "01:27:43", "text": "ええ、私は彼から完全に独立しています"}, {"type": "subtitle", "time": 5265.59, "timestamp": "01:27:45", "text": "彼は実際にそれを手伝ってくれた。平"}, {"type": "subtitle", "time": 5268.39, "timestamp": "01:27:48", "text": "あまり稼げないだろうけど"}, {"type": "chat", "time": 5269.325, "timestamp": "01:27:49", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "Hm"}, {"type": "subtitle", "time": 5271.03, "timestamp": "01:27:51", "text": "ストリーミングとかそういうの、"}, {"type": "subtitle", "time": 5273.99, "timestamp": "01:27:53", "text": "彼は実際に私がGSTの件を好きにならないように助けてくれた"}, {"type": "subtitle", "time": 5277.03, "timestamp": "01:27:57", "text": "それと、登録手続きのこと。"}, {"type": "subtitle", "time": 5278.95, "timestamp": "01:27:58", "text": "えっと"}]
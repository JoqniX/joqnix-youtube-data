[{"type": "subtitle", "time": 12968.71, "timestamp": "03:36:08", "text": "ああ、そうそう、私が使っていたストリーマーがいたんだ"}, {"type": "subtitle", "time": 12971.51, "timestamp": "03:36:11", "text": "見るために。インド人ストリーマーだった。"}, {"type": "subtitle", "time": 12973.03, "timestamp": "03:36:13", "text": "えっと"}, {"type": "subtitle", "time": 12975.83, "timestamp": "03:36:15", "text": "彼の名前は何でしたか？アクセルライブまたは"}, {"type": "subtitle", "time": 12978.71, "timestamp": "03:36:18", "text": "何か。アクセル。"}, {"type": "subtitle", "time": 12981.59, "timestamp": "03:36:21", "text": "彼は以前、よくPUBGの配信をしていた。以前はよく＿＿していた"}, {"type": "subtitle", "time": 12988.389, "timestamp": "03:36:28", "text": "アクセル"}, {"type": "subtitle", "time": 12990.309, "timestamp": "03:36:30", "text": "除外"}, {"type": "subtitle", "time": 12993.51, "timestamp": "03:36:33", "text": "何か何か。"}, {"type": "subtitle", "time": 12995.349, "timestamp": "03:36:35", "text": "わからない。"}, {"type": "subtitle", "time": 12998.55, "timestamp": "03:36:38", "text": "それはおそらく"}, {"type": "subtitle", "time": 13000.07, "timestamp": "03:36:40", "text": "十分。"}, {"type": "subtitle", "time": 13010.15, "timestamp": "03:36:50", "text": "つまり、私は"}, {"type": "subtitle", "time": 13015.59, "timestamp": "03:36:55", "text": "誰か。それは本当にすごいことだった。"}, {"type": "subtitle", "time": 13018.55, "timestamp": "03:36:58", "text": "私たちは基本的に速攻型です"}]
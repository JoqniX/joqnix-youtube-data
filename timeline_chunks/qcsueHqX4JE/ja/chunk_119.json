[{"type": "subtitle", "time": 7155.75, "timestamp": "01:59:15", "text": "あなたは今年の3月にそれを成し遂げました"}, {"type": "subtitle", "time": 7162.39, "timestamp": "01:59:22", "text": "だから、そうだと思うよ。"}, {"type": "subtitle", "time": 7166.47, "timestamp": "01:59:26", "text": "チャットの検証があり、"}, {"type": "subtitle", "time": 7175.589, "timestamp": "01:59:35", "text": "例えば、Twitchを持っていなくても、Twitchを持っている人。"}, {"type": "subtitle", "time": 7181.91, "timestamp": "01:59:41", "text": "わかった。認証済みの電話番号をお持ちでない方"}, {"type": "subtitle", "time": 7184.709, "timestamp": "01:59:44", "text": "数字は後からしか来られません。"}, {"type": "subtitle", "time": 7187.43, "timestamp": "01:59:47", "text": "うん。古いアカウントをお持ちのユーザー"}, {"type": "subtitle", "time": 7189.51, "timestamp": "01:59:49", "text": "1週間以上"}, {"type": "subtitle", "time": 7192.229, "timestamp": "01:59:52", "text": "電話なしで1週間以上"}, {"type": "subtitle", "time": 7196.95, "timestamp": "01:59:56", "text": "彼らが従うことができる検証と彼らの"}]
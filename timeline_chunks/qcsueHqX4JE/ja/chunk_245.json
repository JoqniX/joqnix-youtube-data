[{"type": "subtitle", "time": 14709.03, "timestamp": "04:05:09", "text": "何が起こったのか知りたい。"}, {"type": "subtitle", "time": 14712.469, "timestamp": "04:05:12", "text": "今はシーズン2ですが、反対意見もあると思います。"}, {"type": "subtitle", "time": 14715.389, "timestamp": "04:05:15", "text": "シーズン1へ"}, {"type": "subtitle", "time": 14716.07, "timestamp": "04:05:16", "text": "[笑い]"}, {"type": "subtitle", "time": 14718.15, "timestamp": "04:05:18", "text": "ええ、TLDDRバージョンがあります"}, {"type": "subtitle", "time": 14720.229, "timestamp": "04:05:20", "text": "その動画のコメント。あなたが望むなら、"}, {"type": "subtitle", "time": 14721.91, "timestamp": "04:05:21", "text": "読んでいただければ"}, {"type": "subtitle", "time": 14725.429, "timestamp": "04:05:25", "text": "理解したいなら理解してもいいですよ。それで、しかし"}, {"type": "subtitle", "time": 14727.179, "timestamp": "04:05:27", "text": "うん。 [笑い]"}, {"type": "subtitle", "time": 14727.99, "timestamp": "04:05:27", "text": "[息を呑む]"}, {"type": "subtitle", "time": 14730.55, "timestamp": "04:05:30", "text": "ああ、もっとひどい。心配しないで。私 私 私"}, {"type": "subtitle", "time": 14733.269, "timestamp": "04:05:33", "text": "文字通り殺された。ドクミックスが"}, {"type": "subtitle", "time": 14736.87, "timestamp": "04:05:36", "text": "殺された。死亡した。人格攻撃"}, {"type": "subtitle", "time": 14739.51, "timestamp": "04:05:39", "text": "もの。私は多くの友人を失った。違う"}, {"type": "subtitle", "time": 14741.349, "timestamp": "04:05:41", "text": "それ"}, {"type": "subtitle", "time": 14743.83, "timestamp": "04:05:43", "text": "彼は今や物悲しいピアノのオープニングテーマとして"}, {"type": "subtitle", "time": 14747.51, "timestamp": "04:05:47", "text": "以前のJpoと比べてどうですか？うん、"}, {"type": "subtitle", "time": 14750.71, "timestamp": "04:05:50", "text": "我々は持っています。うん。 [笑い]"}, {"type": "subtitle", "time": 14757.91, "timestamp": "04:05:57", "text": "でも、まあ、合格は合格だ。えっと、引っ越しました"}]
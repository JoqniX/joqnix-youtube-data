[{"type": "subtitle", "time": 11341.19, "timestamp": "03:09:01", "text": "行かなければならないのですが、移動に1時間かかります。私"}, {"type": "subtitle", "time": 11344.72, "timestamp": "03:09:04", "text": "電車か何かで行かないといけない。"}, {"type": "subtitle", "time": 11345.99, "timestamp": "03:09:05", "text": "[笑い]"}, {"type": "subtitle", "time": 11350.63, "timestamp": "03:09:10", "text": "それは、とても遠いんです。前回私が"}, {"type": "subtitle", "time": 11355.03, "timestamp": "03:09:15", "text": "私の家からは車で5時間くらいかかる距離だった。私"}, {"type": "subtitle", "time": 11359.19, "timestamp": "03:09:19", "text": "午前5時にバスに乗らなければならなかった"}, {"type": "subtitle", "time": 11371.349, "timestamp": "03:09:31", "text": "私は今は南部出身です。"}, {"type": "subtitle", "time": 11373.51, "timestamp": "03:09:33", "text": "それで"}, {"type": "subtitle", "time": 11376.71, "timestamp": "03:09:36", "text": "ああ、行かなきゃ。"}, {"type": "subtitle", "time": 11378.87, "timestamp": "03:09:38", "text": "昨夜は火事の旅で、"}, {"type": "subtitle", "time": 11383.67, "timestamp": "03:09:43", "text": "4番目。私は心がとても死んでいて、"}, {"type": "subtitle", "time": 11386.71, "timestamp": "03:09:46", "text": "日本語コース N41"}, {"type": "subtitle", "time": 11391.269, "timestamp": "03:09:51", "text": "それは12月10日までに終わるか、"}, {"type": "subtitle", "time": 11393.849, "timestamp": "03:09:53", "text": "12日。彼はそう言った。私が"}, {"type": "subtitle", "time": 11395.99, "timestamp": "03:09:55", "text": "[音楽]がそう言ったので、私はそう思ったので、彼は"}, {"type": "subtitle", "time": 11399.19, "timestamp": "03:09:59", "text": "彼が尋ねたように、"}]
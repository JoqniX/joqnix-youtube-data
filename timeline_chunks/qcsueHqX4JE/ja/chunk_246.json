[{"type": "subtitle", "time": 14760.71, "timestamp": "04:06:00", "text": "そうでしょうね。ええ、もう前に進みました。はい。そして"}, {"type": "subtitle", "time": 14765.429, "timestamp": "04:06:05", "text": "今は自分のことに集中しています。"}, {"type": "subtitle", "time": 14775.349, "timestamp": "04:06:15", "text": "男。クレーンの話（笑）"}, {"type": "subtitle", "time": 14777.75, "timestamp": "04:06:17", "text": "複雑なバスケットボール。"}, {"type": "subtitle", "time": 14781.269, "timestamp": "04:06:21", "text": "真実。真実。真実。の"}, {"type": "subtitle", "time": 14788.15, "timestamp": "04:06:28", "text": "面白いこと知ってる？"}, {"type": "subtitle", "time": 14790.15, "timestamp": "04:06:30", "text": "本当に、皆さんが"}, {"type": "subtitle", "time": 14794.389, "timestamp": "04:06:34", "text": "更新された、えーと、これらを見るような、えーと"}, {"type": "subtitle", "time": 14797.189, "timestamp": "04:06:37", "text": "配信者同士のゴタゴタみたいな話だよね？ Mskeffのように"}, {"type": "subtitle", "time": 14801.51, "timestamp": "04:06:41", "text": "それとエミー賞関連のこと。私はアサン・ゴーを見ています。それで"}, {"type": "subtitle", "time": 14805.429, "timestamp": "04:06:45", "text": "その件については最新情報をもらってるよね？"}, {"type": "subtitle", "time": 14808.87, "timestamp": "04:06:48", "text": "私はあることに気づいた。"}, {"type": "subtitle", "time": 14812.71, "timestamp": "04:06:52", "text": "ということで、私のドラマ関連の動画タイトルは"}, {"type": "subtitle", "time": 14814.95, "timestamp": "04:06:54", "text": "だった"}, {"type": "subtitle", "time": 14817.83, "timestamp": "04:06:57", "text": "あれは何だったっけ？真実…"}, {"type": "subtitle", "time": 14819.83, "timestamp": "04:06:59", "text": "ドット。右。"}]
[{"type": "subtitle", "time": 13261.99, "timestamp": "03:41:01", "text": "まるで奴隷のようになるだろう"}, {"type": "subtitle", "time": 13263.51, "timestamp": "03:41:03", "text": "契約書か何か。わからない。あなた"}, {"type": "subtitle", "time": 13266.63, "timestamp": "03:41:06", "text": "契約内容が全く分からない。しかし"}, {"type": "subtitle", "time": 13268.63, "timestamp": "03:41:08", "text": "私の場合、契約は本当に"}, {"type": "subtitle", "time": 13271.67, "timestamp": "03:41:11", "text": "良い。しかし、まだスタートアップ企業だ。いいえ、彼らは"}, {"type": "subtitle", "time": 13282.63, "timestamp": "03:41:22", "text": "インドはヴァレラントCSだけです。ああ、そうだね。"}, {"type": "subtitle", "time": 13287.03, "timestamp": "03:41:27", "text": "YouTubeで何度も見かけますが、"}, {"type": "subtitle", "time": 13289.91, "timestamp": "03:41:29", "text": "なんで違うプレイができないの？"}, {"type": "subtitle", "time": 13294.15, "timestamp": "03:41:34", "text": "ゲーム？ああ、なるほど、"}, {"type": "subtitle", "time": 13297.03, "timestamp": "03:41:37", "text": "ストリーマーよりも多くの人が同じように"}, {"type": "subtitle", "time": 13299.83, "timestamp": "03:41:39", "text": "原神"}, {"type": "subtitle", "time": 13304.469, "timestamp": "03:41:44", "text": "私は、ああ、そして、"}, {"type": "subtitle", "time": 13307.51, "timestamp": "03:41:47", "text": "これもまた別のことだ"}, {"type": "subtitle", "time": 13311.03, "timestamp": "03:41:51", "text": "ニッチに基づいてコンテンツを設定する"}, {"type": "subtitle", "time": 13313.429, "timestamp": "03:41:53", "text": "あなたにはそれに基づいた観客しかいない"}, {"type": "subtitle", "time": 13316.469, "timestamp": "03:41:56", "text": "ニッチなので、ある意味で私が持っているのは"}, {"type": "subtitle", "time": 13318.95, "timestamp": "03:41:58", "text": "求めているのは来てくれる観客です"}]
[{"type": "subtitle", "time": 13622.63, "timestamp": "03:47:02", "text": "知っている。以前は、人が"}, {"type": "subtitle", "time": 13626.309, "timestamp": "03:47:06", "text": "私をフェムとか呼ぶのは、彼らが"}, {"type": "subtitle", "time": 13629.349, "timestamp": "03:47:09", "text": "彼らは私の声に基づいて私を判断していた"}, {"type": "subtitle", "time": 13632.79, "timestamp": "03:47:12", "text": "そして、私は恐怖というものが何なのかさえ知らなかった。"}, {"type": "subtitle", "time": 13635.99, "timestamp": "03:47:15", "text": "Googleから分かったのは、"}, {"type": "subtitle", "time": 13638.79, "timestamp": "03:47:18", "text": "女性らしい振る舞いをする人"}, {"type": "subtitle", "time": 13641.429, "timestamp": "03:47:21", "text": "そして、その他諸々。それから私は"}, {"type": "subtitle", "time": 13647.349, "timestamp": "03:47:27", "text": "私は女性らしいのだろうか、と自問自答した。"}, {"type": "subtitle", "time": 13650.79, "timestamp": "03:47:30", "text": "わかった。私は可愛いものが好きです。"}, {"type": "subtitle", "time": 13655.75, "timestamp": "03:47:35", "text": "時間をかけて、私はこれを手に入れたと思います"}, {"type": "subtitle", "time": 13662.07, "timestamp": "03:47:42", "text": "えっと、女性的な性質だと思う、あるいは"}, {"type": "subtitle", "time": 13664.95, "timestamp": "03:47:44", "text": "たぶん私がソフトボール好きだから"}, {"type": "subtitle", "time": 13667.75, "timestamp": "03:47:47", "text": "推測。わからない。"}, {"type": "subtitle", "time": 13670.389, "timestamp": "03:47:50", "text": "そういう可能性もあるのかもしれない。"}, {"type": "subtitle", "time": 13673.03, "timestamp": "03:47:53", "text": "わからない。"}, {"type": "subtitle", "time": 13674.95, "timestamp": "03:47:54", "text": "そして、"}, {"type": "subtitle", "time": 13677.189, "timestamp": "03:47:57", "text": "うん、そうだね"}]
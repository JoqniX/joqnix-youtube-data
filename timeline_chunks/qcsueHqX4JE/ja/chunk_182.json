[{"type": "subtitle", "time": 10920.71, "timestamp": "03:02:00", "text": "私の将来に関すること"}, {"type": "subtitle", "time": 10923.91, "timestamp": "03:02:03", "text": "でも時間が経つにつれて、よし、行くよって思うようになった"}, {"type": "subtitle", "time": 10926.07, "timestamp": "03:02:06", "text": "この[音楽]パートと共に"}, {"type": "subtitle", "time": 10928.71, "timestamp": "03:02:08", "text": "だから私は「よし、私はできる」と思った"}, {"type": "subtitle", "time": 10934.55, "timestamp": "03:02:14", "text": "そして私はそこにいた"}, {"type": "subtitle", "time": 10936.95, "timestamp": "03:02:16", "text": "そして私は日本に行くことを考えたことがなかった"}, {"type": "subtitle", "time": 10939.83, "timestamp": "03:02:19", "text": "実際、私はただランダムに"}, {"type": "subtitle", "time": 10943.349, "timestamp": "03:02:23", "text": "「うん、興味あるよ」って感じだった。"}, {"type": "subtitle", "time": 10945.821, "timestamp": "03:02:25", "text": "語学学校に通うことを考えた"}, {"type": "subtitle", "time": 10948.309, "timestamp": "03:02:28", "text": "[音楽]コースは、ただそれを学ぶためのものです"}, {"type": "subtitle", "time": 10950.309, "timestamp": "03:02:30", "text": "そのように。こんなことになるとは思ってもみなかった"}, {"type": "subtitle", "time": 10954.55, "timestamp": "03:02:34", "text": "そこへ行くとか、何か。しかし"}, {"type": "subtitle", "time": 10957.51, "timestamp": "03:02:37", "text": "時間が経つにつれて、私は両親に会うようになった"}, {"type": "subtitle", "time": 10960.23, "timestamp": "03:02:40", "text": "何かを勉強していることに喜びを感じる"}, {"type": "subtitle", "time": 10961.91, "timestamp": "03:02:41", "text": "興味を持って [音楽]"}, {"type": "subtitle", "time": 10963.99, "timestamp": "03:02:43", "text": "そして彼らは私がこれを話すことを既に知っている"}, {"type": "subtitle", "time": 10967.03, "timestamp": "03:02:47", "text": "中国語か日本語か何かで"}, {"type": "subtitle", "time": 10968.95, "timestamp": "03:02:48", "text": "彼らは「ああ、彼は良い人だ」と言った。"}, {"type": "subtitle", "time": 10971.11, "timestamp": "03:02:51", "text": "実際に彼の興味に従って"}, {"type": "subtitle", "time": 10973.83, "timestamp": "03:02:53", "text": "時間を無駄にするよりも、"}, {"type": "subtitle", "time": 10976.71, "timestamp": "03:02:56", "text": "君が知ってると思う"}, {"type": "subtitle", "time": 10979.349, "timestamp": "03:02:59", "text": "えーと"}]
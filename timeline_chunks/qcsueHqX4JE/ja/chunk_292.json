[{"type": "subtitle", "time": 17521.91, "timestamp": "04:52:01", "text": "サーバーを退出したモデレーター。願っています"}, {"type": "subtitle", "time": 17525.51, "timestamp": "04:52:05", "text": "えっと、ブロックされたか、ああ、そうだね。私はできませんでした"}, {"type": "subtitle", "time": 17527.83, "timestamp": "04:52:07", "text": "それについては先ほど話しました。いいえ、私たちは"}, {"type": "subtitle", "time": 17529.35, "timestamp": "04:52:09", "text": "話が逸れた。"}, {"type": "subtitle", "time": 17532.55, "timestamp": "04:52:12", "text": "だから、ドラマの後、あるいはドラマの最中に、"}, {"type": "subtitle", "time": 17535.03, "timestamp": "04:52:15", "text": "何人かの人が私をブロックするように言われ、"}, {"type": "subtitle", "time": 17536.23, "timestamp": "04:52:16", "text": "もの。"}, {"type": "subtitle", "time": 17539.35, "timestamp": "04:52:19", "text": "一緒に行く人たちによって"}, {"type": "subtitle", "time": 17541.99, "timestamp": "04:52:21", "text": "彼らの意識啓発キャンペーン。"}, {"type": "subtitle", "time": 17545.91, "timestamp": "04:52:25", "text": "さて、ほとんどの人が私にログインしたり、"}, {"type": "subtitle", "time": 17548.47, "timestamp": "04:52:28", "text": "Discordアカウントを持っているから、今すぐ友達解除して"}, {"type": "subtitle", "time": 17551.27, "timestamp": "04:52:31", "text": "プライバシー設定により、追加しない限り"}, {"type": "subtitle", "time": 17553.83, "timestamp": "04:52:33", "text": "彼らを友達として、彼らは私にメッセージを送ることができません。"}, {"type": "subtitle", "time": 17556.39, "timestamp": "04:52:36", "text": "右？私は多くの理由でそうしなければならなかった"}, {"type": "subtitle", "time": 17560.31, "timestamp": "04:52:40", "text": "パラソーシャルなPE視聴者。それは、"}, {"type": "subtitle", "time": 17563.75, "timestamp": "04:52:43", "text": "私は友達だったか、あるいはモデレーターのような存在だった。"}, {"type": "subtitle", "time": 17567.91, "timestamp": "04:52:47", "text": "あるいは、あのヘッドを何と呼ぶか​​はモッドのようなもの"}, {"type": "subtitle", "time": 17572.07, "timestamp": "04:52:52", "text": "企業向けMOD、uh vtubing"}, {"type": "subtitle", "time": 17575.43, "timestamp": "04:52:55", "text": "企業のタスクは今ではDiscordのようなものだ"}, {"type": "subtitle", "time": 17579.27, "timestamp": "04:52:59", "text": "友達になりたい人がたくさんいた"}]
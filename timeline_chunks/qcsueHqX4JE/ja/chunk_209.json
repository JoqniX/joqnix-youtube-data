[{"type": "subtitle", "time": 12541.83, "timestamp": "03:29:01", "text": "日本でこれ以上苦しみたくない、"}, {"type": "subtitle", "time": 12544.55, "timestamp": "03:29:04", "text": "何か。"}, {"type": "subtitle", "time": 12547.429, "timestamp": "03:29:07", "text": "私もそう感じることがあります。私は作るかもしれない"}, {"type": "subtitle", "time": 12555.19, "timestamp": "03:29:15", "text": "何てことだ。だって私はすでに計画しているから"}, {"type": "subtitle", "time": 12557.19, "timestamp": "03:29:17", "text": "ブログを投稿する"}, {"type": "subtitle", "time": 12560.15, "timestamp": "03:29:20", "text": "そして私の人生経験とかそういうもの"}, {"type": "subtitle", "time": 12562.469, "timestamp": "03:29:22", "text": "日本からの動画"}, {"type": "subtitle", "time": 12565.51, "timestamp": "03:29:25", "text": "将来。"}, {"type": "subtitle", "time": 12568.87, "timestamp": "03:29:28", "text": "だから私はこう思う"}, {"type": "subtitle", "time": 12571.91, "timestamp": "03:29:31", "text": "私はそれがどういう仕組みなのか知らないし、"}, {"type": "subtitle", "time": 12575.99, "timestamp": "03:29:35", "text": "あなたの配信が爆発的に盛り上がります。うん。"}, {"type": "subtitle", "time": 12585.11, "timestamp": "03:29:45", "text": "私もこれらのGSTをすべてやらなければならない"}, {"type": "subtitle", "time": 12587.349, "timestamp": "03:29:47", "text": "物事、ですよね？"}, {"type": "subtitle", "time": 12589.83, "timestamp": "03:29:49", "text": "日本に行くので、"}, {"type": "subtitle", "time": 12593.19, "timestamp": "03:29:53", "text": "IGSTか何かに"}, {"type": "subtitle", "time": 12595.91, "timestamp": "03:29:55", "text": "ジョエックスのために。私はそれを魂のプロフィールに変える"}]
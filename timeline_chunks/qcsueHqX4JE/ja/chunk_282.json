[{"type": "subtitle", "time": 16921.11, "timestamp": "04:42:01", "text": "私が彼らのことを知らなかったという事実"}, {"type": "subtitle", "time": 16923.99, "timestamp": "04:42:03", "text": "個人情報、氏名、住所、"}, {"type": "subtitle", "time": 16926.15, "timestamp": "04:42:06", "text": "彼らが誰なのかとか、そういうこと。私は彼らしか知らない"}, {"type": "subtitle", "time": 16929.19, "timestamp": "04:42:09", "text": "オンラインユーザー名でオンラインに接続します。彼は"}, {"type": "subtitle", "time": 16932.628, "timestamp": "04:42:12", "text": "非常に懐疑的だったが、"}, {"type": "subtitle", "time": 16935.99, "timestamp": "04:42:15", "text": "ずっとずっと"}, {"type": "subtitle", "time": 16939.19, "timestamp": "04:42:19", "text": "まるで"}, {"type": "subtitle", "time": 16942.628, "timestamp": "04:42:22", "text": "大変だったけど、ついに説得できた"}, {"type": "subtitle", "time": 16947.19, "timestamp": "04:42:27", "text": "彼と彼の家族に会い、私たち二人とも"}, {"type": "subtitle", "time": 16949.43, "timestamp": "04:42:29", "text": "お互いの家族が顔を合わせたりした。私たちは"}, {"type": "subtitle", "time": 16952.788, "timestamp": "04:42:32", "text": "話をしてから、電車に乗った"}, {"type": "subtitle", "time": 16956.788, "timestamp": "04:42:36", "text": "プネーに行って、私を"}, {"type": "subtitle", "time": 16959.51, "timestamp": "04:42:39", "text": "彼らの家、彼らの家族、そして彼らは"}, {"type": "subtitle", "time": 16968.708, "timestamp": "04:42:48", "text": "そう、父はこう言ったんだ、"}, {"type": "subtitle", "time": 16971.27, "timestamp": "04:42:51", "text": "私が彼らに見せたとき、"}, {"type": "subtitle", "time": 16973.91, "timestamp": "04:42:53", "text": "それらの人々のコメント、今の私の"}, {"type": "subtitle", "time": 16976.948, "timestamp": "04:42:56", "text": "父は「ほら、言った通りだろ」と言った。決して信用してはならない"}]
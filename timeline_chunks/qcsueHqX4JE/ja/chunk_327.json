[{"type": "subtitle", "time": 19622.708, "timestamp": "05:27:02", "text": "そして、私のことをよく知っている人たちが"}, {"type": "subtitle", "time": 19625.67, "timestamp": "05:27:05", "text": "5年間、4、5、4"}, {"type": "subtitle", "time": 19628.868, "timestamp": "05:27:08", "text": "私たちがチューブに乗って以来、何年も彼らは"}, {"type": "subtitle", "time": 19631.99, "timestamp": "05:27:11", "text": "わざわざ私のことを悪く言うために来た"}, {"type": "subtitle", "time": 19634.23, "timestamp": "05:27:14", "text": "など"}, {"type": "subtitle", "time": 19636.47, "timestamp": "05:27:16", "text": "彼らは私の性格を知っている。彼らは知っている"}, {"type": "subtitle", "time": 19639.59, "timestamp": "05:27:19", "text": "私は意図的に"}, {"type": "subtitle", "time": 19642.47, "timestamp": "05:27:22", "text": "あれこれ。私が"}, {"type": "subtitle", "time": 19644.948, "timestamp": "05:27:24", "text": "私の幼少期のドラマについても話しました"}, {"type": "subtitle", "time": 19647.35, "timestamp": "05:27:27", "text": "私は"}, {"type": "subtitle", "time": 19649.75, "timestamp": "05:27:29", "text": "家族と話せなかったから。私は"}, {"type": "subtitle", "time": 19653.43, "timestamp": "05:27:33", "text": "私が信頼する数人に伝える"}, {"type": "subtitle", "time": 19656.31, "timestamp": "05:27:36", "text": "そして彼らは私に、交流しないようにと言った"}, {"type": "subtitle", "time": 19657.99, "timestamp": "05:27:37", "text": "たくさん"}, {"type": "subtitle", "time": 19661.83, "timestamp": "05:27:41", "text": "ああ、あれこれと切り捨てるんだ。"}, {"type": "subtitle", "time": 19665.11, "timestamp": "05:27:45", "text": "それが私の心を掴んだんです。"}, {"type": "subtitle", "time": 19668.31, "timestamp": "05:27:48", "text": "それだけではなく、"}, {"type": "subtitle", "time": 19671.51, "timestamp": "05:27:51", "text": "私が望んでいた人々"}, {"type": "subtitle", "time": 19673.75, "timestamp": "05:27:53", "text": "本当に会いたかった人たちがいた"}, {"type": "subtitle", "time": 19675.27, "timestamp": "05:27:55", "text": "手数料"}, {"type": "subtitle", "time": 19678.07, "timestamp": "05:27:58", "text": "しばらく前から彼らを知らないし"}]
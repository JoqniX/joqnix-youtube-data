[{"type": "subtitle", "time": 17160.07, "timestamp": "04:46:00", "text": "多くのことの世話とあなたの"}, {"type": "subtitle", "time": 17163.11, "timestamp": "04:46:03", "text": "スケジュールとか色々あって、"}, {"type": "subtitle", "time": 17165.99, "timestamp": "04:46:05", "text": "基本的にトレーニングに参加して、"}, {"type": "subtitle", "time": 17167.83, "timestamp": "04:46:07", "text": "それらのもの"}, {"type": "subtitle", "time": 17169.91, "timestamp": "04:46:09", "text": "サウンドチェック、コンサートチェック、これと"}, {"type": "subtitle", "time": 17173.19, "timestamp": "04:46:13", "text": "それからストリームとか、それから"}, {"type": "subtitle", "time": 17176.07, "timestamp": "04:46:16", "text": "YouTuberとのコラボレーションと"}, {"type": "subtitle", "time": 17179.03, "timestamp": "04:46:19", "text": "あれこれスポンサーになってください"}, {"type": "subtitle", "time": 17182.31, "timestamp": "04:46:22", "text": "これらすべてのことですよね？そしてまた"}, {"type": "subtitle", "time": 17185.19, "timestamp": "04:46:25", "text": "その人の精神的な健康状態、私は"}, {"type": "subtitle", "time": 17187.43, "timestamp": "04:46:27", "text": "推測。それを何と呼ぶべきかわかりません"}, {"type": "subtitle", "time": 17190.47, "timestamp": "04:46:30", "text": "オールインワンマネージャーのようなものですが、"}, {"type": "subtitle", "time": 17194.788, "timestamp": "04:46:34", "text": "そんな感じで、もっとトレーニングを受けさせてください"}, {"type": "subtitle", "time": 17197.99, "timestamp": "04:46:37", "text": "あれこれ話して、それから"}, {"type": "subtitle", "time": 17200.31, "timestamp": "04:46:40", "text": "分析的なこと、もしあなたが"}, {"type": "subtitle", "time": 17202.868, "timestamp": "04:46:42", "text": "ストリーム"}, {"type": "subtitle", "time": 17205.75, "timestamp": "04:46:45", "text": "えーと、ストリーム配信をしていて、あなたがそうでないなら、"}, {"type": "subtitle", "time": 17208.15, "timestamp": "04:46:48", "text": "個人的なサポート。うん、そう思うよ"}, {"type": "subtitle", "time": 17210.23, "timestamp": "04:46:50", "text": "あれは個人的な援助だったと思います。"}, {"type": "subtitle", "time": 17212.788, "timestamp": "04:46:52", "text": "それで"}, {"type": "subtitle", "time": 17215.51, "timestamp": "04:46:55", "text": "そう、パーソナルアシスタントみたいな感じ。"}]
[{"type": "subtitle", "time": 10440.07, "timestamp": "02:54:00", "text": "きちんと誠実な方法でそれを行う"}, {"type": "subtitle", "time": 10448.63, "timestamp": "02:54:08", "text": "そして、私は最善を尽くし、そして私の"}, {"type": "subtitle", "time": 10451.269, "timestamp": "02:54:11", "text": "お金、そしてそのお金で私は"}, {"type": "subtitle", "time": 10453.269, "timestamp": "02:54:13", "text": "苦労して稼いだものだから満足だ"}, {"type": "subtitle", "time": 10455.429, "timestamp": "02:54:15", "text": "お金"}, {"type": "subtitle", "time": 10458.07, "timestamp": "02:54:18", "text": "そして全てが終わったら私は"}, {"type": "subtitle", "time": 10462.07, "timestamp": "02:54:22", "text": "ついに引退して給料をもらう"}, {"type": "subtitle", "time": 10466.55, "timestamp": "02:54:26", "text": "休暇とかその後の何か"}, {"type": "subtitle", "time": 10471.19, "timestamp": "02:54:31", "text": "30代、60代、わからない"}, {"type": "subtitle", "time": 10473.11, "timestamp": "02:54:33", "text": "ある年齢"}, {"type": "subtitle", "time": 10485.75, "timestamp": "02:54:45", "text": "正直、私は何も知りません"}, {"type": "subtitle", "time": 10488.07, "timestamp": "02:54:48", "text": "成人男性"}, {"type": "subtitle", "time": 10491.83, "timestamp": "02:54:51", "text": "まるで生まれたばかりの赤ちゃんのようだ"}, {"type": "subtitle", "time": 10493.99, "timestamp": "02:54:53", "text": "私はこういうことはよく知らないし、"}, {"type": "subtitle", "time": 10495.99, "timestamp": "02:54:55", "text": "まだ私の非現実の中に"}, {"type": "subtitle", "time": 10498.71, "timestamp": "02:54:58", "text": "私はまだ"}]
[{"type": "subtitle", "time": 15542.229, "timestamp": "04:19:02", "text": "YouTube。私がYouTubeに行ったのは"}, {"type": "subtitle", "time": 15544.55, "timestamp": "04:19:04", "text": "これらのインド人ユーチューバー、元祖たち"}, {"type": "subtitle", "time": 15547.349, "timestamp": "04:19:07", "text": "1つは、オリジナルのもので、私はそこにいました。"}, {"type": "subtitle", "time": 15550.469, "timestamp": "04:19:10", "text": "丸。彼らは全員YouTubeのインド人だった"}, {"type": "subtitle", "time": 15553.51, "timestamp": "04:19:13", "text": "YouTuberはたくさんいるけど、Twitchで活動しているのは私だけ"}, {"type": "subtitle", "time": 15556.309, "timestamp": "04:19:16", "text": "そして私は（音楽は）見捨てられ、置き去りにされたように感じた"}, {"type": "subtitle", "time": 15558.229, "timestamp": "04:19:18", "text": "一人で。だから私は「わかった、わかった」って言ったの。"}, {"type": "subtitle", "time": 15561.189, "timestamp": "04:19:21", "text": "するつもりです 私はするつもりです"}, {"type": "subtitle", "time": 15564.229, "timestamp": "04:19:24", "text": "「じゃあ、YouTubeでストリーミングしよう。」"}, {"type": "subtitle", "time": 15567.03, "timestamp": "04:19:27", "text": "だから私の初めての配信は"}, {"type": "subtitle", "time": 15572.87, "timestamp": "04:19:32", "text": "前面にはストリームすら表示されない"}, {"type": "subtitle", "time": 15575.11, "timestamp": "04:19:35", "text": "半分くらいの時間はペースが速い。ああ、それもそうだね。"}, {"type": "subtitle", "time": 15578.229, "timestamp": "04:19:38", "text": "はい。はい。"}, {"type": "subtitle", "time": 15598.469, "timestamp": "04:19:58", "text": "わからない。なぜなのか、自分でもわからない。"}]
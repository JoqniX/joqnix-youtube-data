[{"type": "subtitle", "time": 18421.19, "timestamp": "05:07:01", "text": "パン好きで、あまりに人とは違う。"}, {"type": "subtitle", "time": 18423.43, "timestamp": "05:07:03", "text": "楽しかった。"}, {"type": "subtitle", "time": 18426.55, "timestamp": "05:07:06", "text": "彼らが去る限り、あなたも去る。えっと"}, {"type": "subtitle", "time": 18455.19, "timestamp": "05:07:35", "text": "タコス、"}, {"type": "subtitle", "time": 18463.91, "timestamp": "05:07:43", "text": "[ため息]"}, {"type": "subtitle", "time": 18465.91, "timestamp": "05:07:45", "text": "しかし"}]
[{"type": "subtitle", "time": 6242.39, "timestamp": "01:44:02", "text": "アプリケーションの音声を制御する"}, {"type": "subtitle", "time": 6246.79, "timestamp": "01:44:06", "text": "どれだけの量が送られているか"}, {"type": "subtitle", "time": 6256.31, "timestamp": "01:44:16", "text": "えっと、例えば、"}, {"type": "subtitle", "time": 6261.109, "timestamp": "01:44:21", "text": "私は自分の"}, {"type": "subtitle", "time": 6264.709, "timestamp": "01:44:24", "text": "ゲームをプレイしながらこのゲームを聞いています"}, {"type": "subtitle", "time": 6268.149, "timestamp": "01:44:28", "text": "ヘッドホンで"}, {"type": "subtitle", "time": 6271.51, "timestamp": "01:44:31", "text": "そしてそれはストリームで聞こえます"}, {"type": "subtitle", "time": 6273.27, "timestamp": "01:44:33", "text": "しかし"}, {"type": "subtitle", "time": 6275.189, "timestamp": "01:44:35", "text": "もし私が"}, {"type": "subtitle", "time": 6277.51, "timestamp": "01:44:37", "text": "しかし、私にはそれをコントロールする方法がない"}, {"type": "subtitle", "time": 6280.79, "timestamp": "01:44:40", "text": "それは私が実行しない限り、"}, {"type": "subtitle", "time": 6283.83, "timestamp": "01:44:43", "text": "仮想ケーブルを介して、"}, {"type": "subtitle", "time": 6288.229, "timestamp": "01:44:48", "text": "遅延やレイテンシーがかなり大きいですよね？"}, {"type": "subtitle", "time": 6292.55, "timestamp": "01:44:52", "text": "だから私は監視する方法が欲しい"}, {"type": "subtitle", "time": 6294.87, "timestamp": "01:44:54", "text": "音声か何か。"}, {"type": "subtitle", "time": 6296.87, "timestamp": "01:44:56", "text": "私の言いたいこと、分かりますか？"}]
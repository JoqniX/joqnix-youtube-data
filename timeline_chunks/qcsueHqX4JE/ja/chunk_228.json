[{"type": "subtitle", "time": 13682.87, "timestamp": "03:48:02", "text": "すると、たまたまそこに"}, {"type": "subtitle", "time": 13684.55, "timestamp": "03:48:04", "text": "この視聴者はファンボーイか"}, {"type": "subtitle", "time": 13687.11, "timestamp": "03:48:07", "text": "何か。ずいぶん昔のことだ。私は尋ねた"}, {"type": "subtitle", "time": 13691.429, "timestamp": "03:48:11", "text": "彼らに、何があるのか​​教えていただけますか、そして"}, {"type": "subtitle", "time": 13694.55, "timestamp": "03:48:14", "text": "もの。私は彼らに自分の悩みや心配事を話しました"}, {"type": "subtitle", "time": 13696.469, "timestamp": "03:48:16", "text": "などなど。人々がこう言うのが嫌いです"}, {"type": "subtitle", "time": 13700.07, "timestamp": "03:48:20", "text": "あれこれと判断を下す。そして彼は私に言った"}, {"type": "subtitle", "time": 13703.349, "timestamp": "03:48:23", "text": "これら様々なタイプの"}, {"type": "subtitle", "time": 13707.59, "timestamp": "03:48:27", "text": "ファンボーイはたくさんいるけど、ファンボーイは何をしたいの？"}, {"type": "subtitle", "time": 13711.429, "timestamp": "03:48:31", "text": "分類は正しかったか"}, {"type": "subtitle", "time": 13714.07, "timestamp": "03:48:34", "text": "それは何ですか"}, {"type": "subtitle", "time": 13717.11, "timestamp": "03:48:37", "text": "そしてその間にはたくさんのファンボーイがいる"}, {"type": "subtitle", "time": 13718.79, "timestamp": "03:48:38", "text": "球体 私はそれらを見つけたのは"}, {"type": "subtitle", "time": 13723.269, "timestamp": "03:48:43", "text": "ドラマの種類は"}, {"type": "subtitle", "time": 13728.15, "timestamp": "03:48:48", "text": "ああ、オレンジ、待って、うん、オレンジ、うん。おお"}, {"type": "subtitle", "time": 13730.95, "timestamp": "03:48:50", "text": "うん。スピリットは、"}, {"type": "subtitle", "time": 13733.67, "timestamp": "03:48:53", "text": "似たような"}, {"type": "subtitle", "time": 13736.55, "timestamp": "03:48:56", "text": "えっと、声のやつ、ですよね？それは違う"}, {"type": "subtitle", "time": 13738.07, "timestamp": "03:48:58", "text": "の"}]
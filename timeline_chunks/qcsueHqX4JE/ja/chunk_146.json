[{"type": "subtitle", "time": 8762.15, "timestamp": "02:26:02", "text": "アパートを探すか、支払いのようなもの"}, {"type": "subtitle", "time": 8764.55, "timestamp": "02:26:04", "text": "家賃とか、見たとおりのもの"}, {"type": "subtitle", "time": 8769.429, "timestamp": "02:26:09", "text": "アニメとかで。私はそれをしなければならない"}, {"type": "subtitle", "time": 8775.429, "timestamp": "02:26:15", "text": "えっと"}, {"type": "subtitle", "time": 8777.03, "timestamp": "02:26:17", "text": "できなかった理由は言えません"}, {"type": "subtitle", "time": 8780.23, "timestamp": "02:26:20", "text": "何が起こるか見てみましょう。開いていて、私は"}, {"type": "subtitle", "time": 8790.469, "timestamp": "02:26:30", "text": "小型の太陽光発電式のものを作ってもらいましょう。うん、"}, {"type": "subtitle", "time": 8793.03, "timestamp": "02:26:33", "text": "彼らはそうする。でも、ストリーミング配信はできないんです。いいえ、考えてください"}, {"type": "subtitle", "time": 8797.19, "timestamp": "02:26:37", "text": "私の件について。ストリーミング配信はできません"}, {"type": "subtitle", "time": 8801.83, "timestamp": "02:26:41", "text": "例えば、ここ、私の家のように。私は叫ぶことができる、"}, {"type": "subtitle", "time": 8804.55, "timestamp": "02:26:44", "text": "泣いたり、好きなことを何でもしていいよね？いいえ"}, {"type": "subtitle", "time": 8807.349, "timestamp": "02:26:47", "text": "騒音に関する苦情など、誰からも寄せられる。"}, {"type": "subtitle", "time": 8809.67, "timestamp": "02:26:49", "text": "でも日本とかでは、"}, {"type": "subtitle", "time": 8813.19, "timestamp": "02:26:53", "text": "あの騒音苦情のことね。"}, {"type": "subtitle", "time": 8818.309, "timestamp": "02:26:58", "text": "日本は騒音を抱えているだろう"}]
[{"type": "subtitle", "time": 10860.309, "timestamp": "03:01:00", "text": "全てがどうなるかは、私には分からないと思う"}, {"type": "subtitle", "time": 10863.269, "timestamp": "03:01:03", "text": "私がそこに1、2年滞在した後。病気"}, {"type": "subtitle", "time": 10865.59, "timestamp": "03:01:05", "text": "理解する。こういうのがある"}, {"type": "subtitle", "time": 10868.87, "timestamp": "03:01:08", "text": "YouTubeの映像ですよね？男が来たら"}, {"type": "subtitle", "time": 10871.99, "timestamp": "03:01:11", "text": "ドイツでは、1日1ヶ月間"}, {"type": "subtitle", "time": 10874.71, "timestamp": "03:01:14", "text": "ドイツ、ドイツに6ヶ月滞在、10"}, {"type": "subtitle", "time": 10876.71, "timestamp": "03:01:16", "text": "ドイツでの年月、彼らの現在の違い、"}, {"type": "subtitle", "time": 10878.23, "timestamp": "03:01:18", "text": "彼らがどのように生活様式に適応し、"}, {"type": "subtitle", "time": 10879.83, "timestamp": "03:01:19", "text": "すべて。"}, {"type": "subtitle", "time": 10882.79, "timestamp": "03:01:22", "text": "様子を見てみます。 [笑い]"}, {"type": "subtitle", "time": 10884.55, "timestamp": "03:01:24", "text": "そうすれば、あなたの言ったことを覚えておきます。そして"}, {"type": "subtitle", "time": 10887.83, "timestamp": "03:01:27", "text": "「おい、お前の"}, {"type": "subtitle", "time": 10889.67, "timestamp": "03:01:29", "text": "当時、そのような答えが返ってきたのですか？私"}, {"type": "subtitle", "time": 10897.35, "timestamp": "03:01:37", "text": "「本当に落ち込んでるね。」いや、つまり、"}, {"type": "subtitle", "time": 10899.349, "timestamp": "03:01:39", "text": "[笑い]"}, {"type": "subtitle", "time": 10912.15, "timestamp": "03:01:52", "text": "正直に言うと、"}, {"type": "subtitle", "time": 10918.07, "timestamp": "03:01:58", "text": "自分が何を望んでいるのか、実はよくわからない"}]
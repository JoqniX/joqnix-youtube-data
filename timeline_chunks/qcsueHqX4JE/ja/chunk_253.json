[{"type": "subtitle", "time": 15181.429, "timestamp": "04:13:01", "text": "あれらはそれを持っていた。"}, {"type": "subtitle", "time": 15190.229, "timestamp": "04:13:10", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 15205.83, "timestamp": "04:13:25", "text": "多くの視聴者が気にしているのは"}, {"type": "subtitle", "time": 15208.87, "timestamp": "04:13:28", "text": "彼らはそれに続く。多くの人が文字通り"}, {"type": "subtitle", "time": 15210.63, "timestamp": "04:13:30", "text": "30分間交流してから"}, {"type": "subtitle", "time": 15214.149, "timestamp": "04:13:34", "text": "フォローを解除することにしました。おお、"}, {"type": "subtitle", "time": 15220.149, "timestamp": "04:13:40", "text": "あのね？私は、私は向きを変えるつもりです"}, {"type": "subtitle", "time": 15223.189, "timestamp": "04:13:43", "text": "フォローする。うん、"}, {"type": "subtitle", "time": 15226.149, "timestamp": "04:13:46", "text": "だって、見て、確認したいから"}, {"type": "subtitle", "time": 15235.99, "timestamp": "04:13:55", "text": "ほぼその通りです。"}, {"type": "subtitle", "time": 15239.83, "timestamp": "04:13:59", "text": "わかりました、では私がやります。では、"}]
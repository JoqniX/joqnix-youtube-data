[{"type": "subtitle", "time": 18601.51, "timestamp": "05:10:01", "text": "電話して確認する、これが"}, {"type": "subtitle", "time": 18603.43, "timestamp": "05:10:03", "text": "実際の"}, {"type": "subtitle", "time": 18607.27, "timestamp": "05:10:07", "text": "えーっと、あれこれとか [笑い]"}, {"type": "subtitle", "time": 18609.51, "timestamp": "05:10:09", "text": "だってここは最高裁判所の芝生だから。だから"}, {"type": "subtitle", "time": 18616.868, "timestamp": "05:10:16", "text": "でも、4Kで撮影して"}, {"type": "subtitle", "time": 18619.75, "timestamp": "05:10:19", "text": "これを買うならビデオを作った"}, {"type": "subtitle", "time": 18621.67, "timestamp": "05:10:21", "text": "彼らが嘘をついたことを知っている問題"}, {"type": "subtitle", "time": 18624.868, "timestamp": "05:10:24", "text": "法廷で彼らに会ったら、有名人だと思う。彼らは"}, {"type": "subtitle", "time": 18628.07, "timestamp": "05:10:28", "text": "私を殺そうとした。うん、行けたんだけど"}, {"type": "subtitle", "time": 18630.47, "timestamp": "05:10:30", "text": "攻撃面ではね。そして"}, {"type": "subtitle", "time": 18633.59, "timestamp": "05:10:33", "text": "面白いわけじゃないけど"}, {"type": "subtitle", "time": 18635.43, "timestamp": "05:10:35", "text": "面白いけど、私自身の一番悲しいところ"}, {"type": "subtitle", "time": 18637.19, "timestamp": "05:10:37", "text": "それは"}, {"type": "subtitle", "time": 18641.83, "timestamp": "05:10:41", "text": "私自身もまだ防御的だった"}, {"type": "subtitle", "time": 18644.47, "timestamp": "05:10:44", "text": "彼ら"}, {"type": "subtitle", "time": 18648.788, "timestamp": "05:10:48", "text": "うん、私は受け取らない方がいいと思う。"}, {"type": "subtitle", "time": 18654.07, "timestamp": "05:10:54", "text": "ハードハードのように行けたはず"}, {"type": "subtitle", "time": 18657.27, "timestamp": "05:10:57", "text": "でも私はまだ行くつもりだった"}, {"type": "subtitle", "time": 18659.67, "timestamp": "05:10:59", "text": "ああ、名前は明かすべきじゃないな"}]
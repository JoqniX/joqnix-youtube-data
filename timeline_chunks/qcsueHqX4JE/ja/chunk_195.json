[{"type": "subtitle", "time": 11703.11, "timestamp": "03:15:03", "text": "私は、あなたが経験を持っているように感じます"}, {"type": "subtitle", "time": 11705.349, "timestamp": "03:15:05", "text": "あなたはもうそれを済ませたかもしれませんね。それが理由です"}, {"type": "subtitle", "time": 11713.67, "timestamp": "03:15:13", "text": "私は仕事と生活のバランスをとても重視しています。"}, {"type": "subtitle", "time": 11741.349, "timestamp": "03:15:41", "text": "私の仕事が"}, {"type": "subtitle", "time": 11759.99, "timestamp": "03:15:59", "text": "無料の大学。待って、無料の"}]
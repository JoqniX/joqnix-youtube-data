[{"type": "subtitle", "time": 10080.95, "timestamp": "02:48:00", "text": "私はこの信用スコアシステムがよく理解できません。"}, {"type": "subtitle", "time": 10083.83, "timestamp": "02:48:03", "text": "彼らは持っている"}, {"type": "subtitle", "time": 10088.469, "timestamp": "02:48:08", "text": "例えばPG向けとかPG向けじゃないとか、PR向けとか"}, {"type": "subtitle", "time": 10093.67, "timestamp": "02:48:13", "text": "日本でクレジットカードを作るということは"}, {"type": "subtitle", "time": 10095.429, "timestamp": "02:48:15", "text": "あなたを罠にかけて全てを奪い取るための手段"}, {"type": "subtitle", "time": 10097.269, "timestamp": "02:48:17", "text": "深みと日本の経済への参入"}, {"type": "subtitle", "time": 10102.309, "timestamp": "02:48:22", "text": "システム。ああ、それもね。今"}, {"type": "subtitle", "time": 10104.71, "timestamp": "02:48:24", "text": "正直言って、私は"}, {"type": "subtitle", "time": 10108.63, "timestamp": "02:48:28", "text": "深淵。殺したい。"}, {"type": "subtitle", "time": 10122.15, "timestamp": "02:48:42", "text": "それは私が知られていることです"}, {"type": "subtitle", "time": 10124.87, "timestamp": "02:48:44", "text": "必ず時間をかける。"}, {"type": "subtitle", "time": 10133.99, "timestamp": "02:48:53", "text": "これは本当にアメリカの制度です"}]
[{"type": "subtitle", "time": 19512.31, "timestamp": "05:25:12", "text": "ああ、彼らね。わかった。つまり、両方とも"}, {"type": "subtitle", "time": 19514.55, "timestamp": "05:25:14", "text": "つまり、みんなは"}, {"type": "subtitle", "time": 19516.31, "timestamp": "05:25:16", "text": "先に進んだ。彼らは"}, {"type": "subtitle", "time": 19518.948, "timestamp": "05:25:18", "text": "彼らはストリーミング配信をしている。"}, {"type": "subtitle", "time": 19522.55, "timestamp": "05:25:22", "text": "私の罪は、ああ、わかった、みたいなものです。わかった。"}, {"type": "subtitle", "time": 19524.628, "timestamp": "05:25:24", "text": "わからない。"}, {"type": "subtitle", "time": 19527.19, "timestamp": "05:25:27", "text": "ええ、彼らは配信していますよ。"}, {"type": "subtitle", "time": 19531.03, "timestamp": "05:25:31", "text": "彼らは"}, {"type": "subtitle", "time": 19532.948, "timestamp": "05:25:32", "text": "何も起こらなかった。私はただ引っ越すだけです"}, {"type": "subtitle", "time": 19536.868, "timestamp": "05:25:36", "text": "の上。いいえ、声明も何もなし。しないで"}, {"type": "subtitle", "time": 19540.39, "timestamp": "05:25:40", "text": "彼らはもうこれ以上関わりたくないと思っている。"}, {"type": "subtitle", "time": 19543.35, "timestamp": "05:25:43", "text": "それら全て。"}, {"type": "subtitle", "time": 19545.75, "timestamp": "05:25:45", "text": "私はそれが好きです。"}, {"type": "subtitle", "time": 19548.55, "timestamp": "05:25:48", "text": "そしてそれは、私が本当に望んでいたことだった"}, {"type": "subtitle", "time": 19556.868, "timestamp": "05:25:56", "text": "私は自分のカウンターを見たいと思っていました"}, {"type": "subtitle", "time": 19559.67, "timestamp": "05:25:59", "text": "ビデオと声明を所有し、"}]
[{"type": "subtitle", "time": 16262.149, "timestamp": "04:31:02", "text": "おお。"}, {"type": "subtitle", "time": 16270.63, "timestamp": "04:31:10", "text": "何てことだ。"}, {"type": "subtitle", "time": 16273.67, "timestamp": "04:31:13", "text": "あなたにとってはもう遅い時間です。仕事がある"}, {"type": "subtitle", "time": 16276.229, "timestamp": "04:31:16", "text": "明日。"}, {"type": "subtitle", "time": 16282.63, "timestamp": "04:31:22", "text": "待って、週末は仕事がないよね"}, {"type": "subtitle", "time": 16311.349, "timestamp": "04:31:51", "text": "そうそう。本の執筆状況はどうですか？"}, {"type": "subtitle", "time": 16313.83, "timestamp": "04:31:53", "text": "行くの？えっと、あなたが言ったんですよね、"}, {"type": "subtitle", "time": 16316.79, "timestamp": "04:31:56", "text": "「いや、君は文章を書いたりする人だろ。」"}]
[{"type": "subtitle", "time": 16981.03, "timestamp": "04:43:01", "text": "人々は、彼は決して私の言うことを聞かなかった。"}, {"type": "subtitle", "time": 16984.868, "timestamp": "04:43:04", "text": "彼はそれに反対だった。叔父に頼らざるを得なかった"}, {"type": "subtitle", "time": 16987.67, "timestamp": "04:43:07", "text": "えっと、叔父が父を説得して"}, {"type": "subtitle", "time": 16990.948, "timestamp": "04:43:10", "text": "私にこの最後の瞬間を一緒に過ごして"}, {"type": "subtitle", "time": 16993.11, "timestamp": "04:43:13", "text": "オンラインの友達や友達のような友達は"}, {"type": "subtitle", "time": 16996.15, "timestamp": "04:43:16", "text": "以前会ったことがあるのは、日本に行く予定だから"}, {"type": "subtitle", "time": 16998.39, "timestamp": "04:43:18", "text": "もう二度と彼らに会わない。いいえ、"}, {"type": "subtitle", "time": 17001.11, "timestamp": "04:43:21", "text": "私は「お願いだから行かせて」と言いました"}, {"type": "subtitle", "time": 17004.47, "timestamp": "04:43:24", "text": "などなど。そして彼は「いや」と言った。彼は"}, {"type": "subtitle", "time": 17006.628, "timestamp": "04:43:26", "text": "これで本当の友達が誰なのかがわかったね"}, {"type": "subtitle", "time": 17011.83, "timestamp": "04:43:31", "text": "は。そして彼はこう言った。「ああ、えっと、君は"}, {"type": "subtitle", "time": 17016.23, "timestamp": "04:43:36", "text": "彼らを親友とか呼んでください。今"}, {"type": "subtitle", "time": 17018.31, "timestamp": "04:43:38", "text": "あなたは彼らの本当の顔を知っていて、"}, {"type": "subtitle", "time": 17020.628, "timestamp": "04:43:40", "text": "すべて。"}, {"type": "subtitle", "time": 17023.91, "timestamp": "04:43:43", "text": "「みんな、読書をする必要があるよ。」うん。"}, {"type": "subtitle", "time": 17028.788, "timestamp": "04:43:48", "text": "私の場合は、誰に対しても盲目的に信頼していた。"}, {"type": "subtitle", "time": 17030.788, "timestamp": "04:43:50", "text": "それは人々が"}, {"type": "subtitle", "time": 17035.43, "timestamp": "04:43:55", "text": "もうあなたを束ねました。うん。真実。"}]
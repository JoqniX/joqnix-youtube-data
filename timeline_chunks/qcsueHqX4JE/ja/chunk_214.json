[{"type": "subtitle", "time": 12841.19, "timestamp": "03:34:01", "text": "ストリーミング配信していたのですか？"}, {"type": "subtitle", "time": 12859.349, "timestamp": "03:34:19", "text": "私は3番目のインド人ストリーマーだった"}, {"type": "subtitle", "time": 12862.55, "timestamp": "03:34:22", "text": "Twitchで。トゥイッチ。ああ、あなたは"}, {"type": "subtitle", "time": 12864.71, "timestamp": "03:34:24", "text": "そこには"}, {"type": "subtitle", "time": 12877.19, "timestamp": "03:34:37", "text": "私も同じような経験をした人を知っています"}, {"type": "subtitle", "time": 12879.99, "timestamp": "03:34:39", "text": "パートナーモードとか、そんな感じのやつ。"}, {"type": "subtitle", "time": 12892.15, "timestamp": "03:34:52", "text": "ねじれた水と彼が私にたくさん話してくれた"}, {"type": "subtitle", "time": 12895.99, "timestamp": "03:34:55", "text": "クリスチャンがどれだけキリスト教徒だったかということについて"}]
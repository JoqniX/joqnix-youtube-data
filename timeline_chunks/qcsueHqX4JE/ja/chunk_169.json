[{"type": "subtitle", "time": 10142.07, "timestamp": "02:49:02", "text": "問題は、私には"}, {"type": "subtitle", "time": 10144.389, "timestamp": "02:49:04", "text": "貯蓄口座。つまり、私には貯金があるんです"}, {"type": "subtitle", "time": 10149.269, "timestamp": "02:49:09", "text": "アカウントですが、トポロジーがわかりません"}, {"type": "subtitle", "time": 10152.07, "timestamp": "02:49:12", "text": "給料や給与を受け取ったら"}, {"type": "subtitle", "time": 10155.429, "timestamp": "02:49:15", "text": "一部を保管しておくことになっている"}, {"type": "subtitle", "time": 10159.269, "timestamp": "02:49:19", "text": "保存して、それはそこにはない"}, {"type": "subtitle", "time": 10161.99, "timestamp": "02:49:21", "text": "そして私はそれがどれほど重要か知らなかった"}, {"type": "subtitle", "time": 10171.349, "timestamp": "02:49:31", "text": "私は奨学金の管理が苦手です"}, {"type": "subtitle", "time": 10181.349, "timestamp": "02:49:41", "text": "うん、"}, {"type": "subtitle", "time": 10183.99, "timestamp": "02:49:43", "text": "それと、もう一つ。いいえ、"}, {"type": "subtitle", "time": 10186.87, "timestamp": "02:49:46", "text": "今私は私は甘やかされている"}, {"type": "subtitle", "time": 10190.55, "timestamp": "02:49:50", "text": "一人っ子として育った。私の父と母"}, {"type": "subtitle", "time": 10192.71, "timestamp": "02:49:52", "text": "物事を手伝ってくれるだろうし、"}, {"type": "subtitle", "time": 10196.71, "timestamp": "02:49:56", "text": "私がインドにいる間にすべて。しかし"}]
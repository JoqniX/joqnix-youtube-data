[{"type": "subtitle", "time": 19440.47, "timestamp": "05:24:00", "text": "わかりました。"}, {"type": "subtitle", "time": 19443.51, "timestamp": "05:24:03", "text": "では、泣いていたのは誰だったのでしょうか？狼"}, {"type": "subtitle", "time": 19473.67, "timestamp": "05:24:33", "text": "待って、よく分からなかった。それは冗談だったのか？"}, {"type": "subtitle", "time": 19475.59, "timestamp": "05:24:35", "text": "待って、私が下手だって言ったっけ？"}, {"type": "subtitle", "time": 19477.35, "timestamp": "05:24:37", "text": "理解"}, {"type": "subtitle", "time": 19482.15, "timestamp": "05:24:42", "text": "ジョークとかそういうの？より高密度。"}, {"type": "subtitle", "time": 19484.708, "timestamp": "05:24:44", "text": "わかった。えっと、"}, {"type": "subtitle", "time": 19487.11, "timestamp": "05:24:47", "text": "スクリーンショットでは、"}, {"type": "subtitle", "time": 19489.74, "timestamp": "05:24:49", "text": "泣いた。私が泣き虫なんだよね？"}]
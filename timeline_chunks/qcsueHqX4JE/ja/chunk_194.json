[{"type": "subtitle", "time": 11643.349, "timestamp": "03:14:03", "text": "まるで私が"}, {"type": "subtitle", "time": 11646.07, "timestamp": "03:14:06", "text": "素晴らしいパーティーシーン、素晴らしいジムシーン。素晴らしい"}, {"type": "subtitle", "time": 11648.309, "timestamp": "03:14:08", "text": "デートシーン、女の子の食べ物。ああ、彼らは"}, {"type": "subtitle", "time": 11654.63, "timestamp": "03:14:14", "text": "n と"}, {"type": "subtitle", "time": 11656.95, "timestamp": "03:14:16", "text": "それもまた事実です。"}, {"type": "subtitle", "time": 11660.469, "timestamp": "03:14:20", "text": "それは本当だ、本当だ、本当だ。"}, {"type": "subtitle", "time": 11677.91, "timestamp": "03:14:37", "text": "いつも通り行く。私はドイツ語を好きになれる。"}, {"type": "subtitle", "time": 11693.349, "timestamp": "03:14:53", "text": "友人たちを説得する方法"}, {"type": "subtitle", "time": 11694.79, "timestamp": "03:14:54", "text": "ドイツ人は間違っている"}, {"type": "subtitle", "time": 11699.75, "timestamp": "03:14:59", "text": "[笑い]"}]
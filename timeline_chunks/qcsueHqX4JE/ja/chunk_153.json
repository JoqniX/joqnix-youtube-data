[{"type": "subtitle", "time": 9187.27, "timestamp": "02:33:07", "text": "だから先生が私に"}, {"type": "subtitle", "time": 9189.349, "timestamp": "02:33:09", "text": "生徒全員に尋ねて"}, {"type": "subtitle", "time": 9191.27, "timestamp": "02:33:11", "text": "言語の後に何をするつもりですか"}, {"type": "subtitle", "time": 9194.469, "timestamp": "02:33:14", "text": "コースや、これら全てを与えるのが好きです"}, {"type": "subtitle", "time": 9197.27, "timestamp": "02:33:17", "text": "アドバイスと、あなたがしなければならないこと"}, {"type": "subtitle", "time": 9201.11, "timestamp": "02:33:21", "text": "信用スコアやその他諸々"}, {"type": "subtitle", "time": 9203.349, "timestamp": "02:33:23", "text": "なぜなら私たちのバッジには、"}, {"type": "subtitle", "time": 9207.99, "timestamp": "02:33:27", "text": "すでに仕事の招待状を受け取っています。"}, {"type": "subtitle", "time": 9210.95, "timestamp": "02:33:30", "text": "会社はこう言うでしょう"}, {"type": "subtitle", "time": 9215.19, "timestamp": "02:33:35", "text": "日本に行くためのスポンサーになってくれれば、"}, {"type": "subtitle", "time": 9217.75, "timestamp": "02:33:37", "text": "日本部門で仕事を与えるか、"}, {"type": "subtitle", "time": 9219.83, "timestamp": "02:33:39", "text": "何かあるよね？うん。うん。うん。"}, {"type": "subtitle", "time": 9225.03, "timestamp": "02:33:45", "text": "ある男がいて、"}, {"type": "subtitle", "time": 9228.469, "timestamp": "02:33:48", "text": "彼は仕事が確保されている"}, {"type": "subtitle", "time": 9233.99, "timestamp": "02:33:53", "text": "日本。彼がやらなければならないことは、N4をクリアすることだけです"}, {"type": "subtitle", "time": 9236.95, "timestamp": "02:33:56", "text": "またはN3"}]
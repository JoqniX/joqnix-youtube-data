[{"type": "subtitle", "time": 14580.07, "timestamp": "04:03:00", "text": "物事が起こったのは、私が理解できるからです"}, {"type": "subtitle", "time": 14581.67, "timestamp": "04:03:01", "text": "どうやって"}, {"type": "subtitle", "time": 14584.389, "timestamp": "04:03:04", "text": "悪いことばかりだ。"}, {"type": "subtitle", "time": 14586.79, "timestamp": "04:03:06", "text": "しかし、私はすでに自分のやり方を理解していました"}, {"type": "subtitle", "time": 14588.95, "timestamp": "04:03:08", "text": "ウブ語ですよね？私は以前はタイプしていました"}, {"type": "subtitle", "time": 14593.83, "timestamp": "04:03:13", "text": "2020年、2021年、2022年の時代。それは本当に"}, {"type": "subtitle", "time": 14597.189, "timestamp": "04:03:17", "text": "見ていて恥ずかしくなるほどひどい。時間が経つにつれて私は"}, {"type": "subtitle", "time": 14601.429, "timestamp": "04:03:21", "text": "ヘッドパッドで止まり、"}, {"type": "subtitle", "time": 14609.349, "timestamp": "04:03:29", "text": "何てことだ。"}]
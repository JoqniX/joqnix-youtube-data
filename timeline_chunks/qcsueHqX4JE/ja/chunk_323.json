[{"type": "subtitle", "time": 19380.788, "timestamp": "05:23:00", "text": "私たちの本当の名前と情報"}, {"type": "subtitle", "time": 19383.03, "timestamp": "05:23:03", "text": "アバター。だから、私にとっては手に入れるのがとても難しい"}, {"type": "subtitle", "time": 19388.15, "timestamp": "05:23:08", "text": "[ため息]"}, {"type": "subtitle", "time": 19391.27, "timestamp": "05:23:11", "text": "それは本当だ。"}, {"type": "subtitle", "time": 19393.83, "timestamp": "05:23:13", "text": "季節を送ることはないでしょう"}, {"type": "subtitle", "time": 19396.788, "timestamp": "05:23:16", "text": "もうバカじゃないよ [笑い] 私はそうしない"}, {"type": "subtitle", "time": 19402.39, "timestamp": "05:23:22", "text": "これらすべてを知ってる、えーっと、待って、これらすべて、だからあなたは"}, {"type": "subtitle", "time": 19406.23, "timestamp": "05:23:26", "text": "日本ではお金を燃やすことができる。 [笑い]"}, {"type": "subtitle", "time": 19408.868, "timestamp": "05:23:28", "text": "あなたは名誉毀損を訴え、"}, {"type": "subtitle", "time": 19415.67, "timestamp": "05:23:35", "text": "正直に言って名誉毀損をしたかった"}, {"type": "subtitle", "time": 19417.99, "timestamp": "05:23:37", "text": "あれ。"}, {"type": "subtitle", "time": 19419.67, "timestamp": "05:23:39", "text": "私にはまだできるかどうかわからない"}, {"type": "subtitle", "time": 19421.83, "timestamp": "05:23:41", "text": "けれど。私はまだ彼らと話したい"}, {"type": "subtitle", "time": 19429.11, "timestamp": "05:23:49", "text": "あのね？明日彼らにDMを送ります"}, {"type": "subtitle", "time": 19431.75, "timestamp": "05:23:51", "text": "朝。"}, {"type": "subtitle", "time": 19434.708, "timestamp": "05:23:54", "text": "話し合いましょう。"}, {"type": "subtitle", "time": 19437.67, "timestamp": "05:23:57", "text": "ちなみに、それは会社の仕事です。ああ、"}]
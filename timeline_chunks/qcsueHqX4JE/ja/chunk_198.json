[{"type": "subtitle", "time": 11894.55, "timestamp": "03:18:14", "text": "ああ、考え始めなきゃ"}, {"type": "subtitle", "time": 11910.71, "timestamp": "03:18:30", "text": "正直言って、分かりません。えーと、私にはできない"}, {"type": "subtitle", "time": 11913.922, "timestamp": "03:18:33", "text": "現時点で何か変更を加えるのは時期尚早です。"}, {"type": "subtitle", "time": 11915.11, "timestamp": "03:18:35", "text": "[笑い]"}, {"type": "subtitle", "time": 11917.75, "timestamp": "03:18:37", "text": "すでに私の家族が支払ったように"}, {"type": "subtitle", "time": 11919.83, "timestamp": "03:18:39", "text": "のために"}, {"type": "subtitle", "time": 11922.15, "timestamp": "03:18:42", "text": "手数料など"}, {"type": "subtitle", "time": 11924.63, "timestamp": "03:18:44", "text": "と共に"}, {"type": "subtitle", "time": 11929.429, "timestamp": "03:18:49", "text": "それはもう変えられないことだ。だから私は"}, {"type": "subtitle", "time": 11931.51, "timestamp": "03:18:51", "text": "できることは、成り行きを見守ることくらいだ。の"}, {"type": "subtitle", "time": 11935.67, "timestamp": "03:18:55", "text": "言語が進むにつれて、私は理解するでしょう"}, {"type": "subtitle", "time": 11938.15, "timestamp": "03:18:58", "text": "物事がどうなるか。"}]
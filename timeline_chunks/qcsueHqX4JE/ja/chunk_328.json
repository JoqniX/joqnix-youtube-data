[{"type": "subtitle", "time": 19682.39, "timestamp": "05:28:02", "text": "彼らは、ええと、いろいろなことをします。そして私たちは"}, {"type": "subtitle", "time": 19686.07, "timestamp": "05:28:06", "text": "ずっと昔に交流があった。突然彼らは"}, {"type": "subtitle", "time": 19690.39, "timestamp": "05:28:10", "text": "「うん、わかってるよ。私は"}, {"type": "subtitle", "time": 19693.59, "timestamp": "05:28:13", "text": "右。こいつは最初から変だったんだ。"}, {"type": "subtitle", "time": 19695.59, "timestamp": "05:28:15", "text": "あれこれ。彼は私にとって奇妙で、"}, {"type": "subtitle", "time": 19699.67, "timestamp": "05:28:19", "text": "私がとても礼儀正しかった時のこと"}, {"type": "subtitle", "time": 19702.15, "timestamp": "05:28:22", "text": "そしてすべてにおいて平等に扱われる"}, {"type": "subtitle", "time": 19708.31, "timestamp": "05:28:28", "text": "みんなに敬意を払って、私はこう思った"}, {"type": "subtitle", "time": 19712.15, "timestamp": "05:28:32", "text": "私はこう思いました、そしてチェックしていました"}, {"type": "subtitle", "time": 19717.19, "timestamp": "05:28:37", "text": "DM。わかった。私はすごく礼儀正しく振る舞いました。"}, {"type": "subtitle", "time": 19719.11, "timestamp": "05:28:39", "text": "もちろん、あの気まずい場面はあった。"}, {"type": "subtitle", "time": 19723.03, "timestamp": "05:28:43", "text": "ディオとヘッドパッドとその他諸々"}, {"type": "subtitle", "time": 19725.75, "timestamp": "05:28:45", "text": "それは理解できることだ。"}, {"type": "subtitle", "time": 19727.51, "timestamp": "05:28:47", "text": "それ以外には何もない"}, {"type": "subtitle", "time": 19730.788, "timestamp": "05:28:50", "text": "不気味または奇妙に見える、または"}, {"type": "subtitle", "time": 19733.402, "timestamp": "05:28:53", "text": "捕食的とか、そういう類のものではない。"}]
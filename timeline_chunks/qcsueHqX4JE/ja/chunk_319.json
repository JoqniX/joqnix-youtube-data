[{"type": "subtitle", "time": 19140.31, "timestamp": "05:19:00", "text": "それに、もっと良い人間になるとか、そういうこともね。いいえ。"}, {"type": "subtitle", "time": 19142.628, "timestamp": "05:19:02", "text": "それが一番良い方法ではないでしょうか？"}, {"type": "subtitle", "time": 19149.91, "timestamp": "05:19:09", "text": "間違いを犯したことを認める"}, {"type": "subtitle", "time": 19152.31, "timestamp": "05:19:12", "text": "あなたは間違いを犯したので、"}, {"type": "subtitle", "time": 19154.23, "timestamp": "05:19:14", "text": "より良い人間になり、同じ過ちを繰り返さない"}, {"type": "subtitle", "time": 19156.15, "timestamp": "05:19:16", "text": "間違い。"}, {"type": "subtitle", "time": 19167.43, "timestamp": "05:19:27", "text": "そして私の弁護士は実際に私を叱責したので"}, {"type": "subtitle", "time": 19169.99, "timestamp": "05:19:29", "text": "頼まずに物事を行う人"}, {"type": "subtitle", "time": 19171.83, "timestamp": "05:19:31", "text": "彼ら"}, {"type": "subtitle", "time": 19176.39, "timestamp": "05:19:36", "text": "私のドキュメントみたいなやつ。ある意味で私は"}, {"type": "subtitle", "time": 19179.03, "timestamp": "05:19:39", "text": "削除するのを忘れた"}, {"type": "subtitle", "time": 19182.628, "timestamp": "05:19:42", "text": "謝罪の件。"}, {"type": "subtitle", "time": 19185.99, "timestamp": "05:19:45", "text": "そして彼はこう言った。"}, {"type": "subtitle", "time": 19187.59, "timestamp": "05:19:47", "text": "「兄弟、"}, {"type": "subtitle", "time": 19197.03, "timestamp": "05:19:57", "text": "そして私は「ごめんなさい」と言いました。"}, {"type": "subtitle", "time": 19199.83, "timestamp": "05:19:59", "text": "やはりそうだったか。人々が"}]
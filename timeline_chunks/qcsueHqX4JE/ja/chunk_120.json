[{"type": "subtitle", "time": 7206.79, "timestamp": "02:00:06", "text": "待って、たとえこれらを全部入れたとしても、"}, {"type": "subtitle", "time": 7209.109, "timestamp": "02:00:09", "text": "どうして"}, {"type": "subtitle", "time": 7212.55, "timestamp": "02:00:12", "text": "これらのGFXボットはどのようにして、"}, {"type": "subtitle", "time": 7215.03, "timestamp": "02:00:15", "text": "に"}, {"type": "subtitle", "time": 7218.87, "timestamp": "02:00:18", "text": "彼らはこれら全てを迂回するのが好きだ"}, {"type": "subtitle", "time": 7222.79, "timestamp": "02:00:22", "text": "モデレーション、つまりセキュリティ関連のことです。"}]
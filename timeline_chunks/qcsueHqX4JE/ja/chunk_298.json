[{"type": "subtitle", "time": 17880.948, "timestamp": "04:58:00", "text": "それは、私がそのウサギの中に入った時のことでした"}, {"type": "subtitle", "time": 17883.03, "timestamp": "04:58:03", "text": "何が起こったのか理解できない"}, {"type": "subtitle", "time": 17886.39, "timestamp": "04:58:06", "text": "そこに行って、私は「わあ」って感じ"}, {"type": "subtitle", "time": 17889.19, "timestamp": "04:58:09", "text": "そして、私は彼らの立場も理解できます。"}, {"type": "subtitle", "time": 17891.03, "timestamp": "04:58:11", "text": "そうですね"}, {"type": "subtitle", "time": 17892.628, "timestamp": "04:58:12", "text": "そして"}, {"type": "subtitle", "time": 17896.31, "timestamp": "04:58:16", "text": "誰もが勝ちたいと願う"}, {"type": "subtitle", "time": 17897.83, "timestamp": "04:58:17", "text": "たとえ勝利側が文字通り"}, {"type": "subtitle", "time": 17899.91, "timestamp": "04:58:19", "text": "嘘をついている。そう、そう、それが私が"}, {"type": "subtitle", "time": 17902.55, "timestamp": "04:58:22", "text": "理解した。それで、そして（鼻を鳴らして）"}, {"type": "subtitle", "time": 17905.75, "timestamp": "04:58:25", "text": "実際に私にメールをくれた人たちは、"}, {"type": "subtitle", "time": 17908.55, "timestamp": "04:58:28", "text": "メールが使えるようになりました。そして、えーと"}, {"type": "subtitle", "time": 17911.27, "timestamp": "04:58:31", "text": "Instagram の DM が開いていたから、Instagram で。私"}, {"type": "subtitle", "time": 17913.99, "timestamp": "04:58:33", "text": "閉じるのを忘れていました。 Twitterは閉鎖されました。"}, {"type": "subtitle", "time": 17917.99, "timestamp": "04:58:37", "text": "Discordは閉鎖されました。 Facebookは開いていた。"}, {"type": "subtitle", "time": 17920.708, "timestamp": "04:58:40", "text": "スレッドが開いていました。では、他に何があるだろうか？"}, {"type": "subtitle", "time": 17923.51, "timestamp": "04:58:43", "text": "ほかに何か？タンブラー。私は、私は"}, {"type": "subtitle", "time": 17925.59, "timestamp": "04:58:45", "text": "どこにでも。"}, {"type": "subtitle", "time": 17927.83, "timestamp": "04:58:47", "text": "私はどこにでもいます。たとえ"}, {"type": "subtitle", "time": 17931.35, "timestamp": "04:58:51", "text": "WhatsApp WhatsAppグループを持っていた"}, {"type": "subtitle", "time": 17933.67, "timestamp": "04:58:53", "text": "えっと、それは地域団体の活動だったんです。いいえ、"}, {"type": "subtitle", "time": 17936.708, "timestamp": "04:58:56", "text": "Telegramもそこにあった。チャットルーム版"}, {"type": "subtitle", "time": 17939.35, "timestamp": "04:58:59", "text": "それ。"}]
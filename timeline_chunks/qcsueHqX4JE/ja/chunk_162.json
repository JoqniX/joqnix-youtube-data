[{"type": "subtitle", "time": 9722.15, "timestamp": "02:42:02", "text": "このYouTubeの映像か何かで"}, {"type": "subtitle", "time": 9727.429, "timestamp": "02:42:07", "text": "あるいは、何か突然の"}, {"type": "subtitle", "time": 9733.27, "timestamp": "02:42:13", "text": "それはアメリカ人です"}, {"type": "subtitle", "time": 9738.79, "timestamp": "02:42:18", "text": "えーと、肌の色が濃い人。わかった。彼は"}, {"type": "subtitle", "time": 9742.15, "timestamp": "02:42:22", "text": "えっと、彼はえっと"}, {"type": "subtitle", "time": 9745.67, "timestamp": "02:42:25", "text": "電車や地下鉄の中に座って"}, {"type": "subtitle", "time": 9751.19, "timestamp": "02:42:31", "text": "えーと"}, {"type": "subtitle", "time": 9753.75, "timestamp": "02:42:33", "text": "電車と、もう1つは3つあります"}, {"type": "subtitle", "time": 9756.71, "timestamp": "02:42:36", "text": "日本人の一人のサラリーマンとその他普通の人"}, {"type": "subtitle", "time": 9761.349, "timestamp": "02:42:41", "text": "たぶん10代か30代くらいかな"}, {"type": "subtitle", "time": 9765.59, "timestamp": "02:42:45", "text": "50代、60代に1人。左側は"}, {"type": "subtitle", "time": 9768.389, "timestamp": "02:42:48", "text": "サラリーマンは礼儀正しい"}, {"type": "subtitle", "time": 9772.309, "timestamp": "02:42:52", "text": "しかし、もう一人の男はただ立ち去るだけだ"}, {"type": "subtitle", "time": 9776.95, "timestamp": "02:42:56", "text": "嫌悪感を露わにした表情で"}]
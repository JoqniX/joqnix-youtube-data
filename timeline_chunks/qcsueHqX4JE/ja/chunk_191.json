[{"type": "subtitle", "time": 11460.07, "timestamp": "03:11:00", "text": "年齢層も同様です。そして、"}, {"type": "subtitle", "time": 11463.349, "timestamp": "03:11:03", "text": "私がこれらの配信を行ったのは、"}, {"type": "subtitle", "time": 11465.03, "timestamp": "03:11:05", "text": "今回私が持っていたのは"}, {"type": "subtitle", "time": 11468.71, "timestamp": "03:11:08", "text": "他の実験で実験する"}, {"type": "subtitle", "time": 11470.309, "timestamp": "03:11:10", "text": "インド人"}, {"type": "subtitle", "time": 11473.59, "timestamp": "03:11:13", "text": "えーと、モッドのようなプラットビデオプラットフォーム"}, {"type": "subtitle", "time": 11475.67, "timestamp": "03:11:15", "text": "ライブ配信とか、そういうの。"}, {"type": "subtitle", "time": 11479.03, "timestamp": "03:11:19", "text": "そこから"}, {"type": "subtitle", "time": 11482.309, "timestamp": "03:11:22", "text": "私は動物の配信をちょっと好きでした。それで"}, {"type": "subtitle", "time": 11486.469, "timestamp": "03:11:26", "text": "そこから私はある意味で私は昔"}, {"type": "subtitle", "time": 11489.349, "timestamp": "03:11:29", "text": "誰にも言わない"}, {"type": "subtitle", "time": 11491.429, "timestamp": "03:11:31", "text": "私がどこから来たのか、あるいは私の最初のものは何か"}, {"type": "subtitle", "time": 11494.63, "timestamp": "03:11:34", "text": "言語とか色々あって、それで私は「わかった」って感じだった"}, {"type": "subtitle", "time": 11496.87, "timestamp": "03:11:36", "text": "私はそれを言うか、あるいは私が"}, {"type": "subtitle", "time": 11499.51, "timestamp": "03:11:39", "text": "この第一言語を知る"}, {"type": "subtitle", "time": 11502.389, "timestamp": "03:11:42", "text": "そしてそれ以来ずっと"}, {"type": "subtitle", "time": 11511.75, "timestamp": "03:11:51", "text": "だって、変な感じがするから"}, {"type": "subtitle", "time": 11513.59, "timestamp": "03:11:53", "text": "ああ、わかりました。この男はインド人のメーターで、"}, {"type": "subtitle", "time": 11516.469, "timestamp": "03:11:56", "text": "でも彼はヒンディー語を知らないんだよ（笑）"}, {"type": "subtitle", "time": 11519.11, "timestamp": "03:11:59", "text": "そして私はこう言える、"}]
[{"type": "subtitle", "time": 11580.309, "timestamp": "03:13:00", "text": "あなたがそこにいたかどうかはわかりませんが"}, {"type": "subtitle", "time": 11583.59, "timestamp": "03:13:03", "text": "朝の小川は、まるで3月のライバルたちのようだ。"}, {"type": "subtitle", "time": 11588.309, "timestamp": "03:13:08", "text": "ああ、パンはフランスの音楽にも関係している。"}, {"type": "subtitle", "time": 11592.55, "timestamp": "03:13:12", "text": "ブレはフランスにいる。"}, {"type": "subtitle", "time": 11595.75, "timestamp": "03:13:15", "text": "彼もインド人です。でも、彼は"}, {"type": "subtitle", "time": 11599.59, "timestamp": "03:13:19", "text": "彼はフランスに定住している。"}, {"type": "subtitle", "time": 11601.83, "timestamp": "03:13:21", "text": "懐かしいです。大丈夫です。いいえ"}, {"type": "subtitle", "time": 11603.83, "timestamp": "03:13:23", "text": "心配事。"}, {"type": "subtitle", "time": 11619.11, "timestamp": "03:13:39", "text": "フランスにはまだ何人か友達がいます。"}, {"type": "subtitle", "time": 11621.83, "timestamp": "03:13:41", "text": "ボーイフレンドと"}, {"type": "subtitle", "time": 11623.59, "timestamp": "03:13:43", "text": "見せる。"}, {"type": "subtitle", "time": 11626.71, "timestamp": "03:13:46", "text": "私が理解していることの一つは、"}, {"type": "subtitle", "time": 11628.63, "timestamp": "03:13:48", "text": "に"}, {"type": "subtitle", "time": 11633.19, "timestamp": "03:13:53", "text": "友達を作って、"}, {"type": "subtitle", "time": 11635.349, "timestamp": "03:13:55", "text": "人々とつながる。いいえ、あなたは"}, {"type": "subtitle", "time": 11639.99, "timestamp": "03:13:59", "text": "引きこもりの内向的な人、うん。"}]
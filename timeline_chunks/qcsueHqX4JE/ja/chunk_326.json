[{"type": "subtitle", "time": 19561.67, "timestamp": "05:26:01", "text": "もの"}, {"type": "subtitle", "time": 19563.59, "timestamp": "05:26:03", "text": "しかし"}, {"type": "subtitle", "time": 19565.59, "timestamp": "05:26:05", "text": "そう、"}, {"type": "subtitle", "time": 19568.31, "timestamp": "05:26:08", "text": "人々が今知りたがっているのは"}, {"type": "subtitle", "time": 19572.47, "timestamp": "05:26:12", "text": "ジョーが言ったことは全て本当だったのか"}, {"type": "subtitle", "time": 19576.868, "timestamp": "05:26:16", "text": "そしてもしそうなら、彼が言ったことは私たちに"}, {"type": "subtitle", "time": 19579.19, "timestamp": "05:26:19", "text": "それに対する反応"}, {"type": "subtitle", "time": 19582.39, "timestamp": "05:26:22", "text": "そうですね、その理由を教えてください。"}, {"type": "subtitle", "time": 19586.628, "timestamp": "05:26:26", "text": "今、この件を持ち出してください。なぜ"}, {"type": "subtitle", "time": 19589.43, "timestamp": "05:26:29", "text": "あれこれ、そうですよね？たくさん。彼らは持っている"}, {"type": "subtitle", "time": 19592.708, "timestamp": "05:26:32", "text": "いろいろな質問に答えるためですよね？"}, {"type": "subtitle", "time": 19600.31, "timestamp": "05:26:40", "text": "なぜ他の人々や指名手配犯を巻き込むのか"}, {"type": "subtitle", "time": 19602.628, "timestamp": "05:26:42", "text": "この"}, {"type": "subtitle", "time": 19607.59, "timestamp": "05:26:47", "text": "そうすれば、もっと多くの人に"}, {"type": "subtitle", "time": 19609.99, "timestamp": "05:26:49", "text": "ええと、人々を彼らの味方につける。これと"}, {"type": "subtitle", "time": 19615.83, "timestamp": "05:26:55", "text": "たくさんのこと。"}, {"type": "subtitle", "time": 19617.75, "timestamp": "05:26:57", "text": "そしてその理由は？"}]
[{"type": "subtitle", "time": 16321.67, "timestamp": "04:32:01", "text": "それとも、別の人だったのだろうか？待って、それはえっと"}, {"type": "subtitle", "time": 16324.309, "timestamp": "04:32:04", "text": "ああ神様、私は"}, {"type": "subtitle", "time": 16338.469, "timestamp": "04:32:18", "text": "あれはワンサだったのか？あれは誰？"}, {"type": "subtitle", "time": 16340.95, "timestamp": "04:32:20", "text": "今はもう混乱しています。でも、あるよ"}, {"type": "subtitle", "time": 16343.269, "timestamp": "04:32:23", "text": "グラフィックデザイナー"}, {"type": "subtitle", "time": 16346.95, "timestamp": "04:32:26", "text": "そして、それをする人さえも"}, {"type": "subtitle", "time": 16350.469, "timestamp": "04:32:30", "text": "文章を書いたり、そういうことですよね？"}, {"type": "subtitle", "time": 16360.389, "timestamp": "04:32:40", "text": "非常識な？"}, {"type": "subtitle", "time": 16364.389, "timestamp": "04:32:44", "text": "500ドルあれば、"}, {"type": "subtitle", "time": 16367.03, "timestamp": "04:32:47", "text": "新しいモデルの所有権を取得しました。"}, {"type": "subtitle", "time": 16374.469, "timestamp": "04:32:54", "text": "私は自分の所有権を得ることができた"}, {"type": "subtitle", "time": 16376.95, "timestamp": "04:32:56", "text": "所有権は、彼らが使ったお金です"}, {"type": "subtitle", "time": 16378.469, "timestamp": "04:32:58", "text": "の上"}]
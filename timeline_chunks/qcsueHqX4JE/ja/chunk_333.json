[{"type": "subtitle", "time": 19981.67, "timestamp": "05:33:01", "text": "コピー"}, {"type": "subtitle", "time": 19983.27, "timestamp": "05:33:03", "text": "バス。"}, {"type": "subtitle", "time": 19987.27, "timestamp": "05:33:07", "text": "私は決して私は私はかつて遊んでいた私は決して"}, {"type": "subtitle", "time": 19989.51, "timestamp": "05:33:09", "text": "以前フォートナイトをプレイしたことがある。つまり、楽しいってことだよ"}, {"type": "subtitle", "time": 20001.11, "timestamp": "05:33:21", "text": "汗をかくこともある"}, {"type": "subtitle", "time": 20003.67, "timestamp": "05:33:23", "text": "けれど。"}, {"type": "subtitle", "time": 20006.948, "timestamp": "05:33:26", "text": "そこが問題なんです。"}, {"type": "subtitle", "time": 20032.15, "timestamp": "05:33:52", "text": "ストリーム数はいくつになるのでしょうか"}, {"type": "subtitle", "time": 20035.43, "timestamp": "05:33:55", "text": "また？プレイリストを確認してみます。どうやって"}, {"type": "subtitle", "time": 20037.91, "timestamp": "05:33:57", "text": "多くの？私はたくさんのことを成し遂げたと思う"}]
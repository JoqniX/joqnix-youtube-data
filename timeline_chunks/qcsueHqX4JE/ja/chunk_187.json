[{"type": "subtitle", "time": 11222.23, "timestamp": "03:07:02", "text": "私は3年間、英文学の学士号を取得しました。"}, {"type": "subtitle", "time": 11225.11, "timestamp": "03:07:05", "text": "インドでの数年間はそんな感じだった、それだけだ"}, {"type": "subtitle", "time": 11228.469, "timestamp": "03:07:08", "text": "他に何もないが、仕事を得たいなら"}, {"type": "subtitle", "time": 11231.03, "timestamp": "03:07:11", "text": "そして日本にあるもの全て"}, {"type": "subtitle", "time": 11233.59, "timestamp": "03:07:13", "text": "日本人にとっての価値"}, {"type": "subtitle", "time": 11237.269, "timestamp": "03:07:17", "text": "学位認定証とかそういう類のもの"}, {"type": "subtitle", "time": 11242.55, "timestamp": "03:07:22", "text": "一般的に4年間のコースです。待って、"}, {"type": "subtitle", "time": 11249.269, "timestamp": "03:07:29", "text": "ええ、彼らは一般的にあなたを"}, {"type": "subtitle", "time": 11253.99, "timestamp": "03:07:33", "text": "食べ物を手に入れて、ここに入れてください。うん、"}, {"type": "subtitle", "time": 11255.59, "timestamp": "03:07:35", "text": "男。私はそうすべきではなかったと思う"}, {"type": "subtitle", "time": 11263.429, "timestamp": "03:07:43", "text": "おお。そうそう。彼らは交代させられる"}, {"type": "subtitle", "time": 11266.309, "timestamp": "03:07:46", "text": "AIによって。本当だ、本当だ、本当だ、本当だ。次"}, {"type": "subtitle", "time": 11271.67, "timestamp": "03:07:51", "text": "今月は試験があります。わかった。私はとても遅刻しました"}, {"type": "subtitle", "time": 11275.429, "timestamp": "03:07:55", "text": "くだらないドラマのせいで私は"}, {"type": "subtitle", "time": 11278.55, "timestamp": "03:07:58", "text": "引きずり込まれた。私はとても"}]
[{"type": "subtitle", "time": 15005.03, "timestamp": "04:10:05", "text": "ああ、なんてことだ [咳払い]"}, {"type": "subtitle", "time": 15007.189, "timestamp": "04:10:07", "text": "ああ、なんてことだ、1時間半もかかるのか。"}, {"type": "subtitle", "time": 15009.59, "timestamp": "04:10:09", "text": "ええ、TLDDRを読んでください。あなたは手に入れるでしょう"}, {"type": "subtitle", "time": 15016.87, "timestamp": "04:10:16", "text": "ええ、それも確かにありますね。さて、"}, {"type": "subtitle", "time": 15019.269, "timestamp": "04:10:19", "text": "ああ、なんてことだ、私は手探り状態だ。"}, {"type": "subtitle", "time": 15021.75, "timestamp": "04:10:21", "text": "それから、こんなこともあります。"}, {"type": "subtitle", "time": 15023.75, "timestamp": "04:10:23", "text": "は"}, {"type": "subtitle", "time": 15025.83, "timestamp": "04:10:25", "text": "それは何ですか？それは何ですか？それは何ですか？の"}, {"type": "subtitle", "time": 15028.63, "timestamp": "04:10:28", "text": "Twitchの文化は文化とは言えない。"}, {"type": "subtitle", "time": 15032.15, "timestamp": "04:10:32", "text": "そういうことってありますよね？隠れた"}, {"type": "subtitle", "time": 15035.269, "timestamp": "04:10:35", "text": "役割を担うか、話し続けなければならない"}, {"type": "subtitle", "time": 15038.07, "timestamp": "04:10:38", "text": "頻繁に交流している。そこにはいつも"}, {"type": "subtitle", "time": 15041.83, "timestamp": "04:10:41", "text": "こっそり見ている人たちやあなたの"}, {"type": "subtitle", "time": 15044.469, "timestamp": "04:10:44", "text": "ストリーマーの仕事は、"}, {"type": "subtitle", "time": 15046.55, "timestamp": "04:10:46", "text": "潜伏していた場所から出て、"}, {"type": "subtitle", "time": 15054.79, "timestamp": "04:10:54", "text": "それもそうだ"}, {"type": "subtitle", "time": 15057.99, "timestamp": "04:10:57", "text": "もの。玉ねぎだけの話ですか？それは"}]
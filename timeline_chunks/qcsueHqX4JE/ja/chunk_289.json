[{"type": "subtitle", "time": 17347.51, "timestamp": "04:49:07", "text": "経営管理を生業とする人"}, {"type": "subtitle", "time": 17349.75, "timestamp": "04:49:09", "text": "ストレスは溜まるけど、なんとかやってる"}, {"type": "subtitle", "time": 17352.07, "timestamp": "04:49:12", "text": "数百万ドル規模のフランチャイズを複数展開"}, {"type": "subtitle", "time": 17367.27, "timestamp": "04:49:27", "text": "マネージャーを見つけるのは難しい"}, {"type": "subtitle", "time": 17370.15, "timestamp": "04:49:30", "text": "正直に、"}, {"type": "subtitle", "time": 17373.75, "timestamp": "04:49:33", "text": "でも私も彼らにお金を払ってあげたい"}, {"type": "subtitle", "time": 17376.15, "timestamp": "04:49:36", "text": "どうにか。"}, {"type": "subtitle", "time": 17379.43, "timestamp": "04:49:39", "text": "つまり、あなたは小規模なクリエイターみたいなものですよね。"}, {"type": "subtitle", "time": 17382.628, "timestamp": "04:49:42", "text": "えっと、もし誰かを捕まえることができたら"}, {"type": "subtitle", "time": 17385.27, "timestamp": "04:49:45", "text": "ボランティアで手伝ってくれるのは良いことですが"}, {"type": "subtitle", "time": 17388.708, "timestamp": "04:49:48", "text": "時間が経つにつれて、成長したり、"}, {"type": "subtitle", "time": 17391.91, "timestamp": "04:49:51", "text": "あなたは彼らに料金を支払わなければならないでしょう。ええ、"}, {"type": "subtitle", "time": 17394.628, "timestamp": "04:49:54", "text": "もちろん私はスタッフに次のように支払いたい"}, {"type": "subtitle", "time": 17397.67, "timestamp": "04:49:57", "text": "最初はモデレーターがいて"}]
[{"type": "subtitle", "time": 13740.15, "timestamp": "03:49:00", "text": "女性の声、やや紛らわしい声"}, {"type": "subtitle", "time": 13742.87, "timestamp": "03:49:02", "text": "そういう感じですよね？私も"}, {"type": "subtitle", "time": 13747.349, "timestamp": "03:49:07", "text": "驚いた。いや、正直に言うと、私が"}, {"type": "subtitle", "time": 13751.189, "timestamp": "03:49:11", "text": "最初にスピリットについて知ったとき、私は"}, {"type": "subtitle", "time": 13753.349, "timestamp": "03:49:13", "text": "のように"}, {"type": "subtitle", "time": 13756.469, "timestamp": "03:49:16", "text": "私は「ちょっと待って。これは男だ、"}, {"type": "subtitle", "time": 13763.189, "timestamp": "03:49:23", "text": "それから私は自信を持ち始めました"}, {"type": "subtitle", "time": 13765.75, "timestamp": "03:49:25", "text": "混乱する。"}, {"type": "subtitle", "time": 13769.189, "timestamp": "03:49:29", "text": "そして、その時、ハッと気づいた。あ、待って。だからこれは"}, {"type": "subtitle", "time": 13771.75, "timestamp": "03:49:31", "text": "他の人がかつて考えていたのは"}, {"type": "subtitle", "time": 13774.87, "timestamp": "03:49:34", "text": "自分。私が抱えているこの混乱のように"}, {"type": "subtitle", "time": 13777.59, "timestamp": "03:49:37", "text": "見守る霊。私は"}, {"type": "subtitle", "time": 13780.229, "timestamp": "03:49:40", "text": "それは他の人も持っている方法です"}, {"type": "subtitle", "time": 13782.79, "timestamp": "03:49:42", "text": "混乱。"}, {"type": "subtitle", "time": 13786.389, "timestamp": "03:49:46", "text": "何てことだ。私はアングリーバード2を初公開しました"}, {"type": "subtitle", "time": 13789.99, "timestamp": "03:49:49", "text": "このビデオでは、宇宙のビデオを試みています。"}, {"type": "subtitle", "time": 13792.15, "timestamp": "03:49:52", "text": "何？"}, {"type": "subtitle", "time": 13794.309, "timestamp": "03:49:54", "text": "アングリーバード。しばらくぶりに聞いた"}, {"type": "subtitle", "time": 13799.11, "timestamp": "03:49:59", "text": "アングリーバードについて。私はその試合を見逃しました。"}]
[{"type": "subtitle", "time": 11401.75, "timestamp": "03:10:01", "text": "試験を受けたい学生は"}, {"type": "subtitle", "time": 11405.349, "timestamp": "03:10:05", "text": "12月のNAT試験またはJPT試験"}, {"type": "subtitle", "time": 11407.03, "timestamp": "03:10:07", "text": "あるいは誰かがそれを書き込むつもりなら"}, {"type": "subtitle", "time": 11409.83, "timestamp": "03:10:09", "text": "1月、NATのやつを選びたかった"}, {"type": "subtitle", "time": 11412.23, "timestamp": "03:10:12", "text": "1月になったら、私はただ"}, {"type": "subtitle", "time": 11424.15, "timestamp": "03:10:24", "text": "タミル語のようにプネーから来ているのかもしれません"}, {"type": "subtitle", "time": 11425.59, "timestamp": "03:10:25", "text": "などなど。私の第一言語は"}, {"type": "subtitle", "time": 11427.83, "timestamp": "03:10:27", "text": "マラヤーラム語。そう、私は決して"}, {"type": "subtitle", "time": 11433.99, "timestamp": "03:10:33", "text": "それで"}, {"type": "subtitle", "time": 11443.67, "timestamp": "03:10:43", "text": "はい。 [笑い]"}, {"type": "subtitle", "time": 11449.11, "timestamp": "03:10:49", "text": "だから、BBCの記事を読んで"}, {"type": "subtitle", "time": 11453.269, "timestamp": "03:10:53", "text": "私の地域性が露呈してしまった"}, {"type": "subtitle", "time": 11455.91, "timestamp": "03:10:55", "text": "私はインド出身です"}]
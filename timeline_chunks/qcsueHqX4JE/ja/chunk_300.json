[{"type": "subtitle", "time": 18002.31, "timestamp": "05:00:02", "text": "全体と、"}, {"type": "subtitle", "time": 18004.23, "timestamp": "05:00:04", "text": "そうすることで。ちょっと待って、確認させて。何？"}, {"type": "subtitle", "time": 18041.59, "timestamp": "05:00:41", "text": "はぁ？ここには何もない。えっと、"}, {"type": "subtitle", "time": 18044.15, "timestamp": "05:00:44", "text": "私はそうしてはいけないのですか？私はそうしてはいけないのですか？"}, {"type": "subtitle", "time": 18046.55, "timestamp": "05:00:46", "text": "自動メッセージが表示されますよね？なぜ"}, {"type": "subtitle", "time": 18048.39, "timestamp": "05:00:48", "text": "ここじゃないの？"}, {"type": "subtitle", "time": 18049.99, "timestamp": "05:00:49", "text": "えっと、"}, {"type": "subtitle", "time": 18052.39, "timestamp": "05:00:52", "text": "そして、人々が70を見つけたときのように、"}, {"type": "subtitle", "time": 18055.35, "timestamp": "05:00:55", "text": "彼らを喜ばせることを楽しんでいると気づいてください"}]
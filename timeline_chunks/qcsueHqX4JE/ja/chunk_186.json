[{"type": "subtitle", "time": 11162.55, "timestamp": "03:06:02", "text": "日本は、その認証があれば"}, {"type": "subtitle", "time": 11164.309, "timestamp": "03:06:04", "text": "のように"}, {"type": "subtitle", "time": 11168.07, "timestamp": "03:06:08", "text": "翻訳者か何か"}, {"type": "subtitle", "time": 11171.11, "timestamp": "03:06:11", "text": "だからセンスは"}, {"type": "subtitle", "time": 11174.87, "timestamp": "03:06:14", "text": "えっと、それは3年だけなので、いいえ"}, {"type": "subtitle", "time": 11178.63, "timestamp": "03:06:18", "text": "IGN 1 は現在 IGNU のようなもので、4 年間ですが"}, {"type": "subtitle", "time": 11181.03, "timestamp": "03:06:21", "text": "えっと、まだ３年生の"}, {"type": "subtitle", "time": 11183.349, "timestamp": "03:06:23", "text": "昔の"}, {"type": "subtitle", "time": 11185.269, "timestamp": "03:06:25", "text": "4年目があるかどうかはわかりませんが、"}, {"type": "subtitle", "time": 11188.309, "timestamp": "03:06:28", "text": "何かあるけど、まあ、そうだね。"}, {"type": "subtitle", "time": 11199.19, "timestamp": "03:06:39", "text": "それで、それはどういうことなのか"}, {"type": "subtitle", "time": 11204.23, "timestamp": "03:06:44", "text": "それで彼は、そのイグノの件について"}, {"type": "subtitle", "time": 11208.87, "timestamp": "03:06:48", "text": "それは証明書のようなものにしかなり得ない。それはしないだろう"}, {"type": "subtitle", "time": 11212.71, "timestamp": "03:06:52", "text": "日本ではそれほど重要ではない、私の"}, {"type": "subtitle", "time": 11216.15, "timestamp": "03:06:56", "text": "ポートフォリオは今や、私はただ「えーと、私は"}, {"type": "subtitle", "time": 11219.99, "timestamp": "03:06:59", "text": "英文学の学士号を取得"}]
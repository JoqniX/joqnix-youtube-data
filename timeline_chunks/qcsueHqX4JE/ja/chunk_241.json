[{"type": "subtitle", "time": 14462.229, "timestamp": "04:01:02", "text": "戻って、私は、兄弟、"}, {"type": "subtitle", "time": 14464.95, "timestamp": "04:01:04", "text": "もし過去に戻れるなら、"}, {"type": "subtitle", "time": 14470.95, "timestamp": "04:01:10", "text": "過去の自分を叩く"}, {"type": "subtitle", "time": 14474.07, "timestamp": "04:01:14", "text": "そして「一体どういうことだ？」と思う。"}, {"type": "subtitle", "time": 14480.241, "timestamp": "04:01:20", "text": "[息を呑む]"}, {"type": "subtitle", "time": 14481.51, "timestamp": "04:01:21", "text": "[泣き声]"}, {"type": "subtitle", "time": 14486.55, "timestamp": "04:01:26", "text": "ウーファイト版みたいだね"}, {"type": "subtitle", "time": 14489.83, "timestamp": "04:01:29", "text": "コーヒーパスタ。ああ、問題は今私が"}, {"type": "subtitle", "time": 14493.91, "timestamp": "04:01:33", "text": "このu言語に夢中になりすぎた"}, {"type": "subtitle", "time": 14496.79, "timestamp": "04:01:36", "text": "昔は"}, {"type": "subtitle", "time": 14499.429, "timestamp": "04:01:39", "text": "そして誰も何も言わなかった"}, {"type": "subtitle", "time": 14502.87, "timestamp": "04:01:42", "text": "日。わかった。わかった。みんなは"}, {"type": "subtitle", "time": 14505.269, "timestamp": "04:01:45", "text": "ああ、ジョグ、それが君のアイデンティティだ、俺たちは知ってる"}, {"type": "subtitle", "time": 14507.269, "timestamp": "04:01:47", "text": "このために、私たちはあなたにやめてほしいとは思っていません"}, {"type": "subtitle", "time": 14509.59, "timestamp": "04:01:49", "text": "バカにこれを言って、"}, {"type": "subtitle", "time": 14512.63, "timestamp": "04:01:52", "text": "だから私たちは君のことをスポーツマンとして知っているんだ"}, {"type": "subtitle", "time": 14515.51, "timestamp": "04:01:55", "text": "ラング、ジョック、スラング、あれこれ、すべて"}]
[{"type": "subtitle", "time": 17642.15, "timestamp": "04:54:02", "text": "YouTuberたちは私を"}, {"type": "subtitle", "time": 17644.708, "timestamp": "04:54:04", "text": "兄弟姉妹やその他"}, {"type": "subtitle", "time": 17648.47, "timestamp": "04:54:08", "text": "私の名前を使って、他のユーチューバーが"}, {"type": "subtitle", "time": 17650.47, "timestamp": "04:54:10", "text": "その人物の影響を受けると、彼らは"}, {"type": "subtitle", "time": 17653.43, "timestamp": "04:54:13", "text": "「ああ、次はスポーツマンか。よし、私は"}, {"type": "subtitle", "time": 17655.27, "timestamp": "04:54:15", "text": "「彼をブロックする」か、彼らは私のところに来て"}, {"type": "subtitle", "time": 17657.43, "timestamp": "04:54:17", "text": "なぜ彼らはこんなことをしているのかと言っている"}, {"type": "subtitle", "time": 17661.03, "timestamp": "04:54:21", "text": "そして、それ。それでは、"}, {"type": "subtitle", "time": 17664.47, "timestamp": "04:54:24", "text": "その人に「本当にごめんなさい」と言う。"}, {"type": "subtitle", "time": 17666.868, "timestamp": "04:54:26", "text": "えっと、"}, {"type": "subtitle", "time": 17669.91, "timestamp": "04:54:29", "text": "彼は根は優しい人だ。彼はそうしない"}, {"type": "subtitle", "time": 17672.31, "timestamp": "04:54:32", "text": "何をすべきか、そういうことを知っておく。彼はそうしない"}, {"type": "subtitle", "time": 17674.708, "timestamp": "04:54:34", "text": "友達を正しく作る方法を知っている。私"}, {"type": "subtitle", "time": 17677.35, "timestamp": "04:54:37", "text": "そう言って、それからアドバイスします"}, {"type": "subtitle", "time": 17679.51, "timestamp": "04:54:39", "text": "その人は、それが間違っていることに気づく。これ"}, {"type": "subtitle", "time": 17681.51, "timestamp": "04:54:41", "text": "それは友達を作る方法ではない。あなたはしない"}, {"type": "subtitle", "time": 17684.23, "timestamp": "04:54:44", "text": "こういう風に不気味に振る舞う。それから"}, {"type": "subtitle", "time": 17686.708, "timestamp": "04:54:46", "text": "私も影響を受けます。それから、"}, {"type": "subtitle", "time": 17689.43, "timestamp": "04:54:49", "text": "終わりに私は「もう、やりすぎだ」と思った"}, {"type": "subtitle", "time": 17691.11, "timestamp": "04:54:51", "text": "このことで感情的に影響を受け、"}, {"type": "subtitle", "time": 17694.55, "timestamp": "04:54:54", "text": "精神的に。 Dと"}, {"type": "subtitle", "time": 17697.19, "timestamp": "04:54:57", "text": "もの。平均的には、"}]
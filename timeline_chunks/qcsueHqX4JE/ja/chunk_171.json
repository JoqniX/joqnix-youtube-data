[{"type": "subtitle", "time": 10263.83, "timestamp": "02:51:03", "text": "私の友人、幼馴染の彼は"}, {"type": "subtitle", "time": 10266.87, "timestamp": "02:51:06", "text": "投資信託をたくさんやっていて"}, {"type": "subtitle", "time": 10268.87, "timestamp": "02:51:08", "text": "もの"}, {"type": "subtitle", "time": 10271.11, "timestamp": "02:51:11", "text": "そして取引。私は、"}, {"type": "subtitle", "time": 10273.19, "timestamp": "02:51:13", "text": "株とか、そういう類のものですよね？私はしません"}, {"type": "subtitle", "time": 10275.19, "timestamp": "02:51:15", "text": "知る。私にはそういうのは理解できない。しかし彼は"}, {"type": "subtitle", "time": 10277.11, "timestamp": "02:51:17", "text": "相互扶助に加入するように勧められてきた"}, {"type": "subtitle", "time": 10279.91, "timestamp": "02:51:19", "text": "資金の話"}, {"type": "subtitle", "time": 10283.11, "timestamp": "02:51:23", "text": "それで彼は落ち着いて"}, {"type": "subtitle", "time": 10287.75, "timestamp": "02:51:27", "text": "何らかの理由でこれらのものすべて"}, {"type": "subtitle", "time": 10292.309, "timestamp": "02:51:32", "text": "まるで彼は「えーと、君は"}, {"type": "subtitle", "time": 10295.99, "timestamp": "02:51:35", "text": "その医者をフィールドドクターと呼ぶ"}, {"type": "subtitle", "time": 10298.23, "timestamp": "02:51:38", "text": "スポーツとかその他"}, {"type": "subtitle", "time": 10300.309, "timestamp": "02:51:40", "text": "彼はそれを研究したが、"}, {"type": "subtitle", "time": 10302.87, "timestamp": "02:51:42", "text": "興味が大きかったので彼は切り替えた"}, {"type": "subtitle", "time": 10306.469, "timestamp": "02:51:46", "text": "どんなキャリアパスが好きになりたいか"}, {"type": "subtitle", "time": 10309.75, "timestamp": "02:51:49", "text": "そちら側にもっと焦点を当てる"}, {"type": "subtitle", "time": 10312.23, "timestamp": "02:51:52", "text": "投資信託とか、そういう類のもの"}]
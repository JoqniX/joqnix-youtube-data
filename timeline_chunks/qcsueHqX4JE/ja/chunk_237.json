[{"type": "subtitle", "time": 14224.309, "timestamp": "03:57:04", "text": "うん。ドラマなし"}, {"type": "subtitle", "time": 14228.469, "timestamp": "03:57:08", "text": "こんにちは、カダサ。いらっしゃいませ。"}, {"type": "subtitle", "time": 14230.71, "timestamp": "03:57:10", "text": "これ"}, {"type": "subtitle", "time": 14245.99, "timestamp": "03:57:25", "text": "えっと、あなたは来なかったと思います。"}, {"type": "subtitle", "time": 14276.55, "timestamp": "03:57:56", "text": "あなたが望むなら。私はヴァルを持っていません"}]
[{"type": "subtitle", "time": 15300.95, "timestamp": "04:15:00", "text": "もの。もっともっと。改めて感謝申し上げます"}, {"type": "subtitle", "time": 15304.55, "timestamp": "04:15:04", "text": "通りかかるよ。今このタイミングで来てくれたことは、とても大きな意味があります。"}, {"type": "subtitle", "time": 15320.389, "timestamp": "04:15:20", "text": "わかった。あらら。うん。うん。こんなことがあった"}, {"type": "subtitle", "time": 15325.03, "timestamp": "04:15:25", "text": "インドのメチューバー、私は発見しました、誰が"}, {"type": "subtitle", "time": 15326.95, "timestamp": "04:15:26", "text": "キックで提携した。彼らは"}, {"type": "subtitle", "time": 15329.189, "timestamp": "04:15:29", "text": "パートナーファーストを獲得した最初の人物の一人"}, {"type": "subtitle", "time": 15331.83, "timestamp": "04:15:31", "text": "インドのユーチューバーが提携"}, {"type": "subtitle", "time": 15335.91, "timestamp": "04:15:35", "text": "キック。えっと、彼らが考えているかどうかはわかりません"}, {"type": "subtitle", "time": 15337.67, "timestamp": "04:15:37", "text": "もう友達として付き合ってくれない。私はしていません"}, {"type": "subtitle", "time": 15340.309, "timestamp": "04:15:40", "text": "彼らと交流した、ずっと"}, {"type": "subtitle", "time": 15342.389, "timestamp": "04:15:42", "text": "以来。"}, {"type": "subtitle", "time": 15344.229, "timestamp": "04:15:44", "text": "えっと"}, {"type": "subtitle", "time": 15349.99, "timestamp": "04:15:49", "text": "でも、ええ、彼らは私にこうも言いました。"}, {"type": "subtitle", "time": 15354.149, "timestamp": "04:15:54", "text": "彼らはまた、次のように私に言いました。"}, {"type": "subtitle", "time": 15357.51, "timestamp": "04:15:57", "text": "フォロワーをオフにする"}]
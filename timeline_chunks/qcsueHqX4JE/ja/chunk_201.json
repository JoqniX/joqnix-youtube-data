[{"type": "subtitle", "time": 12061.91, "timestamp": "03:21:01", "text": "ええと、研究所とかJPみたいなもの全部"}, {"type": "subtitle", "time": 12065.19, "timestamp": "03:21:05", "text": "教育機関など。"}, {"type": "subtitle", "time": 12069.03, "timestamp": "03:21:09", "text": "しかし、私が選んだこの一つでは、"}, {"type": "subtitle", "time": 12070.95, "timestamp": "03:21:10", "text": "この特別なことは"}, {"type": "subtitle", "time": 12072.87, "timestamp": "03:21:12", "text": "彼らがつながりを持っているのは"}, {"type": "subtitle", "time": 12076.55, "timestamp": "03:21:16", "text": "大学と語学学校。いいえ。"}, {"type": "subtitle", "time": 12080.07, "timestamp": "03:21:20", "text": "他の場所はSSWみたいな感じだった"}, {"type": "subtitle", "time": 12084.309, "timestamp": "03:21:24", "text": "この人たちは"}, {"type": "subtitle", "time": 12088.55, "timestamp": "03:21:28", "text": "えーと、この人たちは"}, {"type": "subtitle", "time": 12090.95, "timestamp": "03:21:30", "text": "これらの人々は私にこう言っていました"}, {"type": "subtitle", "time": 12094.55, "timestamp": "03:21:34", "text": "地元の学校で基礎レベルを学ぶ"}, {"type": "subtitle", "time": 12099.03, "timestamp": "03:21:39", "text": "それから日本に行って片付ける"}, {"type": "subtitle", "time": 12101.429, "timestamp": "03:21:41", "text": "そこからさらに上のレベルを目指す。だからあなたは"}, {"type": "subtitle", "time": 12106.07, "timestamp": "03:21:46", "text": "手に入れれば、あなたは"}, {"type": "subtitle", "time": 12107.91, "timestamp": "03:21:47", "text": "今の日本の環境において。それで"}, {"type": "subtitle", "time": 12110.79, "timestamp": "03:21:50", "text": "すべてに簡単に追いつくことができます"}, {"type": "subtitle", "time": 12112.79, "timestamp": "03:21:52", "text": "などなど。"}, {"type": "subtitle", "time": 12114.79, "timestamp": "03:21:54", "text": "それが彼らの正体だった"}, {"type": "subtitle", "time": 12117.349, "timestamp": "03:21:57", "text": "言って、彼らは良いと感じた"}]
[{"type": "subtitle", "time": 2285.91, "timestamp": "00:38:05", "text": "所以老实说，嗯，自从今天以来……"}, {"type": "subtitle", "time": 2288.39, "timestamp": "00:38:08", "text": "我的老师仍然说“是啊”，因为"}, {"type": "subtitle", "time": 2290.95, "timestamp": "00:38:10", "text": "就像今天我的传感器在询问"}, {"type": "subtitle", "time": 2293.829, "timestamp": "00:38:13", "text": "学生们喜欢你接下来要做什么"}, {"type": "subtitle", "time": 2295.51, "timestamp": "00:38:15", "text": "你的语言课程以及所有的一切"}, {"type": "subtitle", "time": 2299.43, "timestamp": "00:38:19", "text": "跟他们聊完之后，我心想：唉"}, {"type": "subtitle", "time": 2313.67, "timestamp": "00:38:33", "text": "尤其是因为我想做这件事"}, {"type": "subtitle", "time": 2316.15, "timestamp": "00:38:36", "text": "音乐 我必须拥有 我必须拥有"}, {"type": "subtitle", "time": 2318.31, "timestamp": "00:38:38", "text": "如果没有强大的投资组合，我就无法做到这一点。"}, {"type": "subtitle", "time": 2320.55, "timestamp": "00:38:40", "text": "我拥有强大的投资组合。"}, {"type": "subtitle", "time": 2329.03, "timestamp": "00:38:49", "text": "哦，是的。呃，请问哪里可以找到指南？"}, {"type": "subtitle", "time": 2332.63, "timestamp": "00:38:52", "text": "呃，DNA？我猜"}, {"type": "subtitle", "time": 2338.95, "timestamp": "00:38:58", "text": "脱氧核糖核酸"}]
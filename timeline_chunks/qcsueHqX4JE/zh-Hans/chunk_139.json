[{"type": "subtitle", "time": 8342.23, "timestamp": "02:19:02", "text": "而且，当我在户外的时候，对吧？加，"}, {"type": "subtitle", "time": 8345.03, "timestamp": "02:19:05", "text": "当我旅行时"}, {"type": "subtitle", "time": 8348.549, "timestamp": "02:19:08", "text": "而且我也不能把我的电脑完全带走"}, {"type": "subtitle", "time": 8350.709, "timestamp": "02:19:10", "text": "去日本，对吧？"}, {"type": "subtitle", "time": 8353.509, "timestamp": "02:19:13", "text": "行李问题等等，"}, {"type": "subtitle", "time": 8356.709, "timestamp": "02:19:16", "text": "重量和其他东西，还有航班。"}, {"type": "subtitle", "time": 8358.389, "timestamp": "02:19:18", "text": "天知道我要坐的是什么航班。"}, {"type": "subtitle", "time": 8361.27, "timestamp": "02:19:21", "text": "要弄清楚重量是多少"}, {"type": "subtitle", "time": 8364.23, "timestamp": "02:19:24", "text": "是。"}, {"type": "subtitle", "time": 8371.19, "timestamp": "02:19:31", "text": "我无法与某些 MTX 进行沟通。啊。"}, {"type": "subtitle", "time": 8375.75, "timestamp": "02:19:35", "text": "是的，没错。我有一台Mac电脑。"}, {"type": "subtitle", "time": 8378.389, "timestamp": "02:19:38", "text": "我想把它用作工作笔记本电脑。"}, {"type": "subtitle", "time": 8385.83, "timestamp": "02:19:45", "text": "所以，我主要想做的就是"}, {"type": "subtitle", "time": 8388.309, "timestamp": "02:19:48", "text": "YouTube、游戏、直播。我没有"}, {"type": "subtitle", "time": 8390.63, "timestamp": "02:19:50", "text": "全部重做。就是这样。"}, {"type": "subtitle", "time": 8393.59, "timestamp": "02:19:53", "text": "所以，50系列笔记本电脑，一款不错的笔记本电脑"}]
[{"type": "subtitle", "time": 8700.63, "timestamp": "02:25:00", "text": "我当时在想……"}, {"type": "subtitle", "time": 8702.79, "timestamp": "02:25:02", "text": "你以前没有在国外生活过，对吧？"}, {"type": "subtitle", "time": 8705.27, "timestamp": "02:25:05", "text": "不，我没有。"}, {"type": "subtitle", "time": 8709.429, "timestamp": "02:25:09", "text": "这是我的第一次。"}, {"type": "subtitle", "time": 8712.71, "timestamp": "02:25:12", "text": "所以，我当时就在想……"}, {"type": "subtitle", "time": 8716.63, "timestamp": "02:25:16", "text": "嗯，是的，那首歌"}, {"type": "subtitle", "time": 8719.429, "timestamp": "02:25:19", "text": "我现在必须小心谨慎。谁知道呢"}, {"type": "subtitle", "time": 8725.99, "timestamp": "02:25:25", "text": "和"}, {"type": "subtitle", "time": 8729.349, "timestamp": "02:25:29", "text": "所以我一直在想，一旦我……呃，一旦我的"}, {"type": "subtitle", "time": 8732.71, "timestamp": "02:25:32", "text": "语言课程两年后完成，我将"}, {"type": "subtitle", "time": 8736.469, "timestamp": "02:25:36", "text": "必须读四年大学，对吧？"}, {"type": "subtitle", "time": 8738.87, "timestamp": "02:25:38", "text": "学位之类的东西，这样我就可以拥有"}, {"type": "subtitle", "time": 8743.75, "timestamp": "02:25:43", "text": "信用评分，这样我才能安全无虞"}, {"type": "subtitle", "time": 8747.429, "timestamp": "02:25:47", "text": "签证之类的东西，因为"}, {"type": "subtitle", "time": 8749.27, "timestamp": "02:25:49", "text": "现在我明白了……的重要性"}, {"type": "subtitle", "time": 8752.71, "timestamp": "02:25:52", "text": "现在的信用评分"}, {"type": "subtitle", "time": 8755.349, "timestamp": "02:25:55", "text": "所以，好吧，我得自己想办法。"}, {"type": "subtitle", "time": 8759.19, "timestamp": "02:25:59", "text": "住宿地点。我可能不得不"}]
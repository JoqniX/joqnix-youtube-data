[{"type": "subtitle", "time": 10621.99, "timestamp": "02:57:01", "text": "嗯，那也是事实。不，"}, {"type": "subtitle", "time": 10624.469, "timestamp": "02:57:04", "text": "说真的，老兄。我只希望我的家人"}, {"type": "subtitle", "time": 10627.67, "timestamp": "02:57:07", "text": "超出能力范围。"}, {"type": "subtitle", "time": 10633.11, "timestamp": "02:57:13", "text": "我只想找到一份好工作，这样我就可以"}, {"type": "subtitle", "time": 10636.389, "timestamp": "02:57:16", "text": "我可以为我的家人做任何事"}, {"type": "subtitle", "time": 10638.389, "timestamp": "02:57:18", "text": "就像他们可以和平相处一样。不"}, {"type": "subtitle", "time": 10642.15, "timestamp": "02:57:22", "text": "担心钱的事之类的。"}, {"type": "subtitle", "time": 10648.71, "timestamp": "02:57:28", "text": "日本的初级管理人员"}, {"type": "subtitle", "time": 10662.23, "timestamp": "02:57:42", "text": "你想象一下，英国人的收入大约是15万英镑。哦"}]
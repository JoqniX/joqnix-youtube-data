[{"type": "subtitle", "time": 18662.868, "timestamp": "05:11:02", "text": "这个那个之类的"}, {"type": "subtitle", "time": 18665.67, "timestamp": "05:11:05", "text": "我被狠狠地训斥了好多次[笑]"}, {"type": "subtitle", "time": 18667.35, "timestamp": "05:11:07", "text": "那些帮忙的人等等。"}, {"type": "subtitle", "time": 18670.788, "timestamp": "05:11:10", "text": "不，就像乔一样，你意识到你有多么……"}, {"type": "subtitle", "time": 18672.628, "timestamp": "05:11:12", "text": "已经失去"}, {"type": "subtitle", "time": 18676.07, "timestamp": "05:11:16", "text": "你仍然得这么做。"}, {"type": "subtitle", "time": 18677.91, "timestamp": "05:11:17", "text": "喜欢"}, {"type": "subtitle", "time": 18681.99, "timestamp": "05:11:21", "text": "比如说不要咄咄逼人，呃，走"}, {"type": "subtitle", "time": 18684.55, "timestamp": "05:11:24", "text": "不要采取进攻姿态，就让……"}, {"type": "subtitle", "time": 18692.07, "timestamp": "05:11:32", "text": "谈话结束后过了一会儿，我……"}, {"type": "subtitle", "time": 18693.59, "timestamp": "05:11:33", "text": "我当时想，好吧，那我就透露一下吧。"}, {"type": "subtitle", "time": 18701.11, "timestamp": "05:11:41", "text": "我觉得现在一切都太迟了。"}, {"type": "subtitle", "time": 18706.948, "timestamp": "05:11:46", "text": "现在我连做这件事都太晚了。"}, {"type": "subtitle", "time": 18709.91, "timestamp": "05:11:49", "text": "把箱子拿出来之类的。此外，我"}, {"type": "subtitle", "time": 18714.07, "timestamp": "05:11:54", "text": "甚至不知道它能不能去。"}, {"type": "subtitle", "time": 18717.27, "timestamp": "05:11:57", "text": "我甚至不知道是不是……呃，我不知道"}, {"type": "subtitle", "time": 18719.91, "timestamp": "05:11:59", "text": "甚至不知道它是否像"}]
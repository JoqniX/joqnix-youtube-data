[{"type": "subtitle", "time": 14166.229, "timestamp": "03:56:06", "text": "这个名字[笑声]"}, {"type": "subtitle", "time": 14174.469, "timestamp": "03:56:14", "text": "我最近不太清楚。不多。不，不是"}, {"type": "subtitle", "time": 14191.03, "timestamp": "03:56:31", "text": "我并不介意和他们成为真正的朋友"}, {"type": "subtitle", "time": 14193.67, "timestamp": "03:56:33", "text": "主播们，但我只要求不要制作"}, {"type": "subtitle", "time": 14202.469, "timestamp": "03:56:42", "text": "我不介意和……成为朋友"}, {"type": "subtitle", "time": 14205.349, "timestamp": "03:56:45", "text": "创作者或观众"}, {"type": "subtitle", "time": 14210.79, "timestamp": "03:56:50", "text": "只要他们正常对待我。"}, {"type": "subtitle", "time": 14213.11, "timestamp": "03:56:53", "text": "就像普通朋友一样。不是"}]
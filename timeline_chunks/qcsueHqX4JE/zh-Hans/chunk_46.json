[{"type": "subtitle", "time": 2765.589, "timestamp": "00:46:05", "text": "夜晚"}, {"type": "subtitle", "time": 2793.829, "timestamp": "00:46:33", "text": "[叹气] 好吧。所以，呃，迷雾面纱，它"}, {"type": "subtitle", "time": 2796.95, "timestamp": "00:46:36", "text": "看起来像是翅膀的进化，巅峰"}, {"type": "subtitle", "time": 2800.47, "timestamp": "00:46:40", "text": "士气。 [叹气]呃，等等，他为什么不……"}, {"type": "subtitle", "time": 2803.43, "timestamp": "00:46:43", "text": "拥有至高无上的宁静"}, {"type": "subtitle", "time": 2805.03, "timestamp": "00:46:45", "text": "短笛？"}, {"type": "subtitle", "time": 2813.589, "timestamp": "00:46:53", "text": "嗯，让我看看……"}, {"type": "subtitle", "time": 2816.309, "timestamp": "00:46:56", "text": "这个人的视频。等等，谁在哪儿？"}, {"type": "subtitle", "time": 2818.39, "timestamp": "00:46:58", "text": "是他吗？"}]
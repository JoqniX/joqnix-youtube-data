[{"type": "subtitle", "time": 12061.91, "timestamp": "03:21:01", "text": "呃，研究所和所有类似JP的东西"}, {"type": "subtitle", "time": 12065.19, "timestamp": "03:21:05", "text": "教育机构之类的。"}, {"type": "subtitle", "time": 12069.03, "timestamp": "03:21:09", "text": "但在我选择的这个版本中，"}, {"type": "subtitle", "time": 12070.95, "timestamp": "03:21:10", "text": "这件事唯一特别之处就在于此"}, {"type": "subtitle", "time": 12072.87, "timestamp": "03:21:12", "text": "是因为他们与……有联系"}, {"type": "subtitle", "time": 12076.55, "timestamp": "03:21:16", "text": "大学和语言学校。不。"}, {"type": "subtitle", "time": 12080.07, "timestamp": "03:21:20", "text": "所以其他地方就像SSW之类的东西"}, {"type": "subtitle", "time": 12084.309, "timestamp": "03:21:24", "text": "而这些人当时就像"}, {"type": "subtitle", "time": 12088.55, "timestamp": "03:21:28", "text": "呃，这些人就像……"}, {"type": "subtitle", "time": 12090.95, "timestamp": "03:21:30", "text": "这些人就像在跟我说……"}, {"type": "subtitle", "time": 12094.55, "timestamp": "03:21:34", "text": "在当地学院学习基础知识"}, {"type": "subtitle", "time": 12099.03, "timestamp": "03:21:39", "text": "然后去日本，把一切都清空。"}, {"type": "subtitle", "time": 12101.429, "timestamp": "03:21:41", "text": "比如更高级别的级别。所以你"}, {"type": "subtitle", "time": 12106.07, "timestamp": "03:21:46", "text": "得到它，你会像那样，你会是"}, {"type": "subtitle", "time": 12107.91, "timestamp": "03:21:47", "text": "现在在日本的这种环境下。所以"}, {"type": "subtitle", "time": 12110.79, "timestamp": "03:21:50", "text": "你很快就能赶上所有事情"}, {"type": "subtitle", "time": 12112.79, "timestamp": "03:21:52", "text": "还有一些其他的东西。"}, {"type": "subtitle", "time": 12114.79, "timestamp": "03:21:54", "text": "那就是他们的样子。"}, {"type": "subtitle", "time": 12117.349, "timestamp": "03:21:57", "text": "他们说，我觉得他们说得对。"}]
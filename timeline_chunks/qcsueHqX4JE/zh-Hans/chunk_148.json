[{"type": "subtitle", "time": 8883.75, "timestamp": "02:28:03", "text": "我可以做得比这个更便宜。你好。"}, {"type": "subtitle", "time": 8887.27, "timestamp": "02:28:07", "text": "我只能想象它是如何发生的。"}, {"type": "subtitle", "time": 8890.79, "timestamp": "02:28:10", "text": "那是因为我其实不知道怎么做。"}, {"type": "subtitle", "time": 8908.71, "timestamp": "02:28:28", "text": "就是这样。"}, {"type": "subtitle", "time": 8910.87, "timestamp": "02:28:30", "text": "你对它投入了很多心血。是的，我"}, {"type": "subtitle", "time": 8913.19, "timestamp": "02:28:33", "text": "需要做大量的研究"}, {"type": "subtitle", "time": 8921.99, "timestamp": "02:28:41", "text": "但你到底想要什么？"}, {"type": "subtitle", "time": 8925.349, "timestamp": "02:28:45", "text": "日本？这将是一门语言课程"}, {"type": "subtitle", "time": 8929.19, "timestamp": "02:28:49", "text": "持续了两年。我必须通过N1。我的目标是"}, {"type": "subtitle", "time": 8933.349, "timestamp": "02:28:53", "text": "清除N1。如果我……，我必须清除N2。"}, {"type": "subtitle", "time": 8937.19, "timestamp": "02:28:57", "text": "想去日本的任何地方，比如……"}]
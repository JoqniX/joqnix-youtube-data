[{"type": "subtitle", "time": 19512.31, "timestamp": "05:25:12", "text": "啊，他们。好的。我的意思是，他们两个都是"}, {"type": "subtitle", "time": 19514.55, "timestamp": "05:25:14", "text": "我的意思是，所有人都像……一样。"}, {"type": "subtitle", "time": 19516.31, "timestamp": "05:25:16", "text": "继续前进。我猜他们一直都是他们"}, {"type": "subtitle", "time": 19518.948, "timestamp": "05:25:18", "text": "他们一直在直播。"}, {"type": "subtitle", "time": 19522.55, "timestamp": "05:25:22", "text": "我的罪行就像是“哦，好吧”。好的。"}, {"type": "subtitle", "time": 19524.628, "timestamp": "05:25:24", "text": "我不知道。"}, {"type": "subtitle", "time": 19527.19, "timestamp": "05:25:27", "text": "是的，他们一直在直播。"}, {"type": "subtitle", "time": 19531.03, "timestamp": "05:25:31", "text": "我猜他们就像"}, {"type": "subtitle", "time": 19532.948, "timestamp": "05:25:32", "text": "什么也没发生。我打算搬走。"}, {"type": "subtitle", "time": 19536.868, "timestamp": "05:25:36", "text": "在。不，没有声明，什么都没有。不"}, {"type": "subtitle", "time": 19540.39, "timestamp": "05:25:40", "text": "他们不想再参与其中了。"}, {"type": "subtitle", "time": 19543.35, "timestamp": "05:25:43", "text": "所有那些东西。"}, {"type": "subtitle", "time": 19545.75, "timestamp": "05:25:45", "text": "我喜欢这个。"}, {"type": "subtitle", "time": 19548.55, "timestamp": "05:25:48", "text": "而那正是我真正想要的。"}, {"type": "subtitle", "time": 19556.868, "timestamp": "05:25:56", "text": "我想看看我的计数器。"}, {"type": "subtitle", "time": 19559.67, "timestamp": "05:25:59", "text": "拥有视频和声明"}]
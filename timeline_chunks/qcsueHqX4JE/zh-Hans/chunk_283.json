[{"type": "subtitle", "time": 16981.03, "timestamp": "04:43:01", "text": "人们都听不进我的话，因为"}, {"type": "subtitle", "time": 16984.868, "timestamp": "04:43:04", "text": "他反对这项提议。我不得不求助于我叔叔。"}, {"type": "subtitle", "time": 16987.67, "timestamp": "04:43:07", "text": "谁，呃，叔叔，去说服我爸爸让"}, {"type": "subtitle", "time": 16990.948, "timestamp": "04:43:10", "text": "让我和他/她一起享受这最后的时光。"}, {"type": "subtitle", "time": 16993.11, "timestamp": "04:43:13", "text": "网络朋友和像朋友一样的朋友，我从未"}, {"type": "subtitle", "time": 16996.15, "timestamp": "04:43:16", "text": "之前见过面，因为我要去日本，所以我"}, {"type": "subtitle", "time": 16998.39, "timestamp": "04:43:18", "text": "甚至都不想再见到他们了。不，"}, {"type": "subtitle", "time": 17001.11, "timestamp": "04:43:21", "text": "我当时想，求求你们放我走吧"}, {"type": "subtitle", "time": 17004.47, "timestamp": "04:43:24", "text": "还有一些其他的东西。他当时就说不。他是"}, {"type": "subtitle", "time": 17006.628, "timestamp": "04:43:26", "text": "现在你知道谁才是你真正的朋友了。"}, {"type": "subtitle", "time": 17011.83, "timestamp": "04:43:31", "text": "是。他当时就说：“是啊，嗯，你"}, {"type": "subtitle", "time": 17016.23, "timestamp": "04:43:36", "text": "称他们为好朋友之类的。现在"}, {"type": "subtitle", "time": 17018.31, "timestamp": "04:43:38", "text": "你知道他们的真面目"}, {"type": "subtitle", "time": 17020.628, "timestamp": "04:43:40", "text": "一切。"}, {"type": "subtitle", "time": 17023.91, "timestamp": "04:43:43", "text": "你需要了解人们的想法。“是的。”"}, {"type": "subtitle", "time": 17028.788, "timestamp": "04:43:48", "text": "我的情况是，我盲目地信任了所有人。"}, {"type": "subtitle", "time": 17030.788, "timestamp": "04:43:50", "text": "这种情况只有在人们拥有……之后才会发生。"}, {"type": "subtitle", "time": 17035.43, "timestamp": "04:43:55", "text": "你们已经聚在一起了。是的。真的。"}]
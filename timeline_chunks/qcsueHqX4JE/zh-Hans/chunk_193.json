[{"type": "subtitle", "time": 11580.309, "timestamp": "03:13:00", "text": "不知道你当时是否在那里"}, {"type": "subtitle", "time": 11583.59, "timestamp": "03:13:03", "text": "早晨的溪流就像三月份的竞争对手一样。"}, {"type": "subtitle", "time": 11588.309, "timestamp": "03:13:08", "text": "嗯，面包在法国音乐中也占有一席之地。"}, {"type": "subtitle", "time": 11592.55, "timestamp": "03:13:12", "text": "布雷在法国。"}, {"type": "subtitle", "time": 11595.75, "timestamp": "03:13:15", "text": "他也是印度人。是的，他"}, {"type": "subtitle", "time": 11599.59, "timestamp": "03:13:19", "text": "他已经在法国定居了。"}, {"type": "subtitle", "time": 11601.83, "timestamp": "03:13:21", "text": "我想念它，因为我曾经是……没关系。不"}, {"type": "subtitle", "time": 11603.83, "timestamp": "03:13:23", "text": "担忧。"}, {"type": "subtitle", "time": 11619.11, "timestamp": "03:13:39", "text": "我还有几个朋友在法国。"}, {"type": "subtitle", "time": 11621.83, "timestamp": "03:13:41", "text": "男朋友和"}, {"type": "subtitle", "time": 11623.59, "timestamp": "03:13:43", "text": "展示。"}, {"type": "subtitle", "time": 11626.71, "timestamp": "03:13:46", "text": "我明白的一点是，你拥有"}, {"type": "subtitle", "time": 11628.63, "timestamp": "03:13:48", "text": "到"}, {"type": "subtitle", "time": 11633.19, "timestamp": "03:13:53", "text": "你得学会交朋友，"}, {"type": "subtitle", "time": 11635.349, "timestamp": "03:13:55", "text": "与人建立联系。不，你不能成为"}, {"type": "subtitle", "time": 11639.99, "timestamp": "03:13:59", "text": "像个封闭的内向者，是啊。"}]
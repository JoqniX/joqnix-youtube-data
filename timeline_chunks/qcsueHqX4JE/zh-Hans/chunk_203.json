[{"type": "subtitle", "time": 12181.59, "timestamp": "03:23:01", "text": "我可以为我的室友做很多事。"}, {"type": "subtitle", "time": 12185.429, "timestamp": "03:23:05", "text": "现在。我做饭。他们轮流进行。"}, {"type": "subtitle", "time": 12194.15, "timestamp": "03:23:14", "text": "我知道这不会是件好事。"}, {"type": "subtitle", "time": 12197.91, "timestamp": "03:23:17", "text": "就像我认为它是基于……一样，乐天派"}, {"type": "subtitle", "time": 12200.55, "timestamp": "03:23:20", "text": "日本动画片。"}, {"type": "subtitle", "time": 12206.95, "timestamp": "03:23:26", "text": "我很想看看。是的，我们会有的。"}, {"type": "subtitle", "time": 12210.229, "timestamp": "03:23:30", "text": "现在终于有人可以聊天了。"}, {"type": "subtitle", "time": 12212.71, "timestamp": "03:23:32", "text": "但我只是担心自己会不会太过分。"}, {"type": "subtitle", "time": 12217.03, "timestamp": "03:23:37", "text": "我房间有点吵。全部"}, {"type": "subtitle", "time": 12219.11, "timestamp": "03:23:39", "text": "正确的。它就像一个小房间，"}, {"type": "subtitle", "time": 12221.83, "timestamp": "03:23:41", "text": "正确的？所以这就是为什么我会说我不"}, {"type": "subtitle", "time": 12225.269, "timestamp": "03:23:45", "text": "想要两间房。我很乐意"}, {"type": "subtitle", "time": 12227.269, "timestamp": "03:23:47", "text": "只有一个房间，但那是另一回事了。"}, {"type": "subtitle", "time": 12229.67, "timestamp": "03:23:49", "text": "现在很贵。我需要付6个月的款"}, {"type": "subtitle", "time": 12232.95, "timestamp": "03:23:52", "text": "每6个月缴纳一次居家隔离费"}, {"type": "subtitle", "time": 12235.59, "timestamp": "03:23:55", "text": "东西。所以显然你可以选择"}]
[{"type": "subtitle", "time": 13502.229, "timestamp": "03:45:02", "text": "那很小。它真的很小。"}, {"type": "subtitle", "time": 13506.229, "timestamp": "03:45:06", "text": "我买了那本书，然后就开始练习。"}, {"type": "subtitle", "time": 13508.63, "timestamp": "03:45:08", "text": "那是我第一次谈论……"}, {"type": "subtitle", "time": 13512.55, "timestamp": "03:45:12", "text": "多人游戏视频游戏"}, {"type": "subtitle", "time": 13516.07, "timestamp": "03:45:16", "text": "呃，使用语音聊天。我真的"}, {"type": "subtitle", "time": 13518.469, "timestamp": "03:45:18", "text": "很喜欢。然后我慢慢地开始"}, {"type": "subtitle", "time": 13521.269, "timestamp": "03:45:21", "text": "把这些留着"}, {"type": "subtitle", "time": 13525.03, "timestamp": "03:45:25", "text": "挑战、优先事项或这项任务"}, {"type": "subtitle", "time": 13527.429, "timestamp": "03:45:27", "text": "就我个人而言，我会说英语"}, {"type": "subtitle", "time": 13530.63, "timestamp": "03:45:30", "text": "更多的。我会继续讲下去。"}, {"type": "subtitle", "time": 13532.87, "timestamp": "03:45:32", "text": "随着时间的推移，我会变得相当"}, {"type": "subtitle", "time": 13535.83, "timestamp": "03:45:35", "text": "舒适感造就了现在的我"}, {"type": "subtitle", "time": 13539.269, "timestamp": "03:45:39", "text": "今天大概是这样吧。我不知道。"}, {"type": "subtitle", "time": 13541.269, "timestamp": "03:45:41", "text": "螺丝口音。我甚至不确定你是否拥有"}, {"type": "subtitle", "time": 13543.11, "timestamp": "03:45:43", "text": "性别。"}]
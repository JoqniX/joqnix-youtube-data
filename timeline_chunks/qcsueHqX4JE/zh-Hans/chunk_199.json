[{"type": "subtitle", "time": 11940.79, "timestamp": "03:19:00", "text": "如果一切顺利，如果我想要"}, {"type": "subtitle", "time": 11943.59, "timestamp": "03:19:03", "text": "追求"}, {"type": "subtitle", "time": 11947.75, "timestamp": "03:19:07", "text": "如果上大学，那我就得这么做了。"}, {"type": "subtitle", "time": 11949.51, "timestamp": "03:19:09", "text": "为了您"}, {"type": "subtitle", "time": 11954.389, "timestamp": "03:19:14", "text": "国家。嗯，所以本地学习课程我们"}, {"type": "subtitle", "time": 11957.269, "timestamp": "03:19:17", "text": "已支付，并且像所有文件一样。"}, {"type": "subtitle", "time": 11958.95, "timestamp": "03:19:18", "text": "翻译"}, {"type": "subtitle", "time": 11961.67, "timestamp": "03:19:21", "text": "还有那个东西"}, {"type": "subtitle", "time": 11964.79, "timestamp": "03:19:24", "text": "还有语言方面。是的，我想"}, {"type": "subtitle", "time": 11967.83, "timestamp": "03:19:27", "text": "我付了一半的钱"}, {"type": "subtitle", "time": 11972.07, "timestamp": "03:19:32", "text": "语言课程，6个月的……"}, {"type": "subtitle", "time": 11981.03, "timestamp": "03:19:41", "text": "我们会拿到这份清单。"}, {"type": "subtitle", "time": 11984.63, "timestamp": "03:19:44", "text": "测量费用是多少？"}, {"type": "subtitle", "time": 11987.349, "timestamp": "03:19:47", "text": "大概是二月份吧。"}, {"type": "subtitle", "time": 11989.59, "timestamp": "03:19:49", "text": "二月。是的，我打算四月份再说。不，"}, {"type": "subtitle", "time": 11998.309, "timestamp": "03:19:58", "text": "不，就像你看，我告诉你。"}]
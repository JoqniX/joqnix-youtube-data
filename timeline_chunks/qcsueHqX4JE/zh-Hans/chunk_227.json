[{"type": "subtitle", "time": 13622.63, "timestamp": "03:47:02", "text": "我知道。我以前很讨厌人们使用"}, {"type": "subtitle", "time": 13626.309, "timestamp": "03:47:06", "text": "叫我女装什么的，因为他们来自"}, {"type": "subtitle", "time": 13629.349, "timestamp": "03:47:09", "text": "他们过去常常根据我的声音来评判我。"}, {"type": "subtitle", "time": 13632.79, "timestamp": "03:47:12", "text": "我当时甚至不知道什么是恐惧。"}, {"type": "subtitle", "time": 13635.99, "timestamp": "03:47:15", "text": "我从谷歌上只知道它是……"}, {"type": "subtitle", "time": 13638.79, "timestamp": "03:47:18", "text": "就像那种举止女性化的人一样"}, {"type": "subtitle", "time": 13641.429, "timestamp": "03:47:21", "text": "以及其他各种各样的事情。然后我"}, {"type": "subtitle", "time": 13647.349, "timestamp": "03:47:27", "text": "我问自己：我算女性吗？"}, {"type": "subtitle", "time": 13650.79, "timestamp": "03:47:30", "text": "好的。我喜欢可爱的东西。"}, {"type": "subtitle", "time": 13655.75, "timestamp": "03:47:35", "text": "我觉得随着时间的推移，我明白了这一点。"}, {"type": "subtitle", "time": 13662.07, "timestamp": "03:47:42", "text": "嗯，大概是女性特质吧。"}, {"type": "subtitle", "time": 13664.95, "timestamp": "03:47:44", "text": "也许只是因为我喜欢垒球吧"}, {"type": "subtitle", "time": 13667.75, "timestamp": "03:47:47", "text": "猜测。我不知道。"}, {"type": "subtitle", "time": 13670.389, "timestamp": "03:47:50", "text": "或许有那么一点吧。"}, {"type": "subtitle", "time": 13673.03, "timestamp": "03:47:53", "text": "我不知道。"}, {"type": "subtitle", "time": 13674.95, "timestamp": "03:47:54", "text": "就像"}, {"type": "subtitle", "time": 13677.189, "timestamp": "03:47:57", "text": "嗯，是的"}]
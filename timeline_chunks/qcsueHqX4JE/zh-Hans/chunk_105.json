[{"type": "subtitle", "time": 6300.87, "timestamp": "01:45:00", "text": "我希望游戏音效能被听到。"}, {"type": "subtitle", "time": 6303.99, "timestamp": "01:45:03", "text": "或者直播，但我不想直播我的"}, {"type": "subtitle", "time": 6307.03, "timestamp": "01:45:07", "text": "被路由到我的耳机一段时间"}, {"type": "subtitle", "time": 6308.55, "timestamp": "01:45:08", "text": "案例。"}, {"type": "subtitle", "time": 6311.35, "timestamp": "01:45:11", "text": "但如果我只是想要片刻宁静，如果我只是"}, {"type": "subtitle", "time": 6313.189, "timestamp": "01:45:13", "text": "就像听腻了同样的话一样"}, {"type": "subtitle", "time": 6315.43, "timestamp": "01:45:15", "text": "又来了，这游戏到底是什么？"}, {"type": "subtitle", "time": 6317.27, "timestamp": "01:45:17", "text": "就是那个东西，对吧？如果我正在听一些"}, {"type": "subtitle", "time": 6320.55, "timestamp": "01:45:20", "text": "音乐之类的，我很想拥有。"}, {"type": "subtitle", "time": 6323.43, "timestamp": "01:45:23", "text": "这样我就可以"}, {"type": "subtitle", "time": 6327.109, "timestamp": "01:45:27", "text": "就听一小会儿。"}, {"type": "subtitle", "time": 6329.669, "timestamp": "01:45:29", "text": "或者别的什么。"}, {"type": "subtitle", "time": 6332.31, "timestamp": "01:45:32", "text": "当然。等等，我不是下载了测试版吗？"}, {"type": "subtitle", "time": 6341.109, "timestamp": "01:45:41", "text": "我记得我下载过测试版。"}]
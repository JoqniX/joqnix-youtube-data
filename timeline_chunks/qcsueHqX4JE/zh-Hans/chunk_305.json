[{"type": "subtitle", "time": 18303.99, "timestamp": "05:05:03", "text": "呃"}, {"type": "subtitle", "time": 18306.788, "timestamp": "05:05:06", "text": "仔细想想，这有帮助吗？"}, {"type": "subtitle", "time": 18315.91, "timestamp": "05:05:15", "text": "这对任何人有帮助吗？它对呃有帮助吗？"}, {"type": "subtitle", "time": 18318.708, "timestamp": "05:05:18", "text": "南加州那边？它有帮助吗？"}, {"type": "subtitle", "time": 18320.948, "timestamp": "05:05:20", "text": "他们？不。"}, {"type": "subtitle", "time": 18324.15, "timestamp": "05:05:24", "text": "它对我有帮助吗？不。"}, {"type": "subtitle", "time": 18326.446, "timestamp": "05:05:26", "text": "排球。我像这样做过它们"}, {"type": "subtitle", "time": 18327.99, "timestamp": "05:05:27", "text": "[笑声和喘息声] 现在的问题是"}, {"type": "subtitle", "time": 18331.19, "timestamp": "05:05:31", "text": "人们知道他们是如何看待那些人的。"}, {"type": "subtitle", "time": 18333.83, "timestamp": "05:05:33", "text": "我的东西背后是什么样的人等等"}, {"type": "subtitle", "time": 18335.67, "timestamp": "05:05:35", "text": "现在"}, {"type": "subtitle", "time": 18338.708, "timestamp": "05:05:38", "text": "他们从大多数 YouTuber 那里了解到了这一点。"}, {"type": "subtitle", "time": 18342.31, "timestamp": "05:05:42", "text": "我的剧就像是……"}, {"type": "subtitle", "time": 18345.99, "timestamp": "05:05:45", "text": "呃，不要相信别人。有些甚至"}, {"type": "subtitle", "time": 18348.39, "timestamp": "05:05:48", "text": "整个社区就像……"}, {"type": "subtitle", "time": 18351.27, "timestamp": "05:05:51", "text": "服务器，因为我以前会邀请所有人"}, {"type": "subtitle", "time": 18354.31, "timestamp": "05:05:54", "text": "是印度的 YouTuber，对吧？"}, {"type": "subtitle", "time": 18355.91, "timestamp": "05:05:55", "text": "嗯"}, {"type": "subtitle", "time": 18358.628, "timestamp": "05:05:58", "text": "我过去常常邀请我遇到的每一个印度人。"}]
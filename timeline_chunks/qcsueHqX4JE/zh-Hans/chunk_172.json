[{"type": "subtitle", "time": 10325.91, "timestamp": "02:52:05", "text": "我当时就想：“哇。”甚至他也说过"}, {"type": "subtitle", "time": 10327.83, "timestamp": "02:52:07", "text": "它。"}, {"type": "subtitle", "time": 10330.469, "timestamp": "02:52:10", "text": "连他自己也这么说过。你确定吗？"}, {"type": "subtitle", "time": 10337.51, "timestamp": "02:52:17", "text": "就像创办一家公司或拥有……"}, {"type": "subtitle", "time": 10340.79, "timestamp": "02:52:20", "text": "这里有些东西，然后就投资股票吧。"}, {"type": "subtitle", "time": 10344.87, "timestamp": "02:52:24", "text": "或者这里指的是共同基金。你会没事的。"}, {"type": "subtitle", "time": 10350.63, "timestamp": "02:52:30", "text": "我不知道。"}, {"type": "subtitle", "time": 10352.469, "timestamp": "02:52:32", "text": "我是说从我16岁开始。非常"}, {"type": "subtitle", "time": 10356.23, "timestamp": "02:52:36", "text": "丰富的体验。哇。"}]
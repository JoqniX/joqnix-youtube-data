[{"type": "subtitle", "time": 17050.07, "timestamp": "04:44:10", "text": "但是，我当时到底是什么呢？"}, {"type": "subtitle", "time": 17059.59, "timestamp": "04:44:19", "text": "很多次重新发布，而且发布时间并不早。"}, {"type": "subtitle", "time": 17070.788, "timestamp": "04:44:30", "text": "所以，我30岁的时候有10个朋友，"}, {"type": "subtitle", "time": 17072.55, "timestamp": "04:44:32", "text": "数百人之后是手。"}, {"type": "subtitle", "time": 17074.47, "timestamp": "04:44:34", "text": "熟人。"}, {"type": "subtitle", "time": 17078.23, "timestamp": "04:44:38", "text": "啊，不错。"}, {"type": "subtitle", "time": 17093.19, "timestamp": "04:44:53", "text": "即使到了今天，就现实生活而言，我也只能说我"}]
[{"type": "subtitle", "time": 4984.229, "timestamp": "01:23:04", "text": "和喜欢"}, {"type": "subtitle", "time": 4988.31, "timestamp": "01:23:08", "text": "我看到了我的旅程"}, {"type": "subtitle", "time": 4991.99, "timestamp": "01:23:11", "text": "在生活中，这是一种发现自我的方式。"}, {"type": "chat", "time": 4992.057, "timestamp": "01:23:12", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "at first I want to be painter but my dad wouldn't let me go to painting classes"}, {"type": "subtitle", "time": 4996.07, "timestamp": "01:23:16", "text": "现在想做这些事。"}, {"type": "subtitle", "time": 4998.87, "timestamp": "01:23:18", "text": "即使到了今天，我仍然"}, {"type": "subtitle", "time": 5000.39, "timestamp": "01:23:20", "text": "发现"}, {"type": "subtitle", "time": 5002.87, "timestamp": "01:23:22", "text": "我想做什么"}, {"type": "subtitle", "time": 5007.35, "timestamp": "01:23:27", "text": "做条狗吧。所以现实生活中的事情等等。"}, {"type": "subtitle", "time": 5009.27, "timestamp": "01:23:29", "text": "我的意思是，我是一个尝试过的人。"}, {"type": "subtitle", "time": 5013.35, "timestamp": "01:23:33", "text": "一切。我从制作音乐开始"}, {"type": "subtitle", "time": 5016.55, "timestamp": "01:23:36", "text": "我当时对音乐方面的东西非常着迷。"}, {"type": "subtitle", "time": 5019.59, "timestamp": "01:23:39", "text": "我一直这样做。然后我就"}, {"type": "subtitle", "time": 5022.229, "timestamp": "01:23:42", "text": "呃，感到困惑、迷茫和不知所措。然后我"}, {"type": "subtitle", "time": 5025.35, "timestamp": "01:23:45", "text": "尝试了不同的方法"}, {"type": "subtitle", "time": 5029.27, "timestamp": "01:23:49", "text": "呃，创意方面，我还没用过，比如画画。"}, {"type": "subtitle", "time": 5032.629, "timestamp": "01:23:52", "text": "呃，比如插画。"}, {"type": "subtitle", "time": 5033.83, "timestamp": "01:23:53", "text": "是的，这属于图形设计范畴。"}, {"type": "subtitle", "time": 5036.229, "timestamp": "01:23:56", "text": "设计。然后我尝试做一些艺术创作。"}]
[{"type": "subtitle", "time": 17400.55, "timestamp": "04:50:00", "text": "送给那些愿意帮助我的人的东西"}, {"type": "subtitle", "time": 17403.35, "timestamp": "04:50:03", "text": "我的直播和其他内容，版主们"}, {"type": "subtitle", "time": 17407.51, "timestamp": "04:50:07", "text": "最初是想付钱给别人。"}, {"type": "subtitle", "time": 17410.31, "timestamp": "04:50:10", "text": "我希望我像以前那样告诉人们"}, {"type": "subtitle", "time": 17412.23, "timestamp": "04:50:12", "text": "比如版主之类的工作人员"}, {"type": "subtitle", "time": 17415.11, "timestamp": "04:50:15", "text": "频道就像我该如何支付你费用一样"}, {"type": "subtitle", "time": 17418.23, "timestamp": "04:50:18", "text": "虽然我身无分文，但我没有任何收入。"}, {"type": "subtitle", "time": 17421.19, "timestamp": "04:50:21", "text": "我想在那段时间前后付款"}, {"type": "subtitle", "time": 17425.51, "timestamp": "04:50:25", "text": "pal.gg上线了。这就像一个全新的"}, {"type": "subtitle", "time": 17427.59, "timestamp": "04:50:27", "text": "Twitch社区的趋势和"}, {"type": "subtitle", "time": 17430.39, "timestamp": "04:50:30", "text": "东西，主播社区，一种方式"}, {"type": "subtitle", "time": 17433.51, "timestamp": "04:50:33", "text": "人们需要付费给版主之类的东西"}, {"type": "subtitle", "time": 17436.31, "timestamp": "04:50:36", "text": "比如伤口之类的，所有那些东西，"}, {"type": "subtitle", "time": 17438.948, "timestamp": "04:50:38", "text": "正确的？帕尔·G我当时就想，我想用"}, {"type": "subtitle", "time": 17441.11, "timestamp": "04:50:41", "text": "pali.gg 等等。然后我意识到，"}, {"type": "subtitle", "time": 17443.59, "timestamp": "04:50:43", "text": "好吧，我在Twitch上赚不了多少钱。"}, {"type": "subtitle", "time": 17445.75, "timestamp": "04:50:45", "text": "总之，很难不付钱。"}, {"type": "subtitle", "time": 17448.47, "timestamp": "04:50:48", "text": "版主。我需要这个吗？然后当我"}, {"type": "subtitle", "time": 17450.708, "timestamp": "04:50:50", "text": "他们当时谈到这件事时说，这就像……"}, {"type": "subtitle", "time": 17452.948, "timestamp": "04:50:52", "text": "好的，乔，你不需要，我们在这里是为了……"}, {"type": "subtitle", "time": 17455.11, "timestamp": "04:50:55", "text": "我们是志愿者，可以为您提供帮助。"}, {"type": "subtitle", "time": 17459.67, "timestamp": "04:50:59", "text": "诸如此类的事情，也因为我当时"}]
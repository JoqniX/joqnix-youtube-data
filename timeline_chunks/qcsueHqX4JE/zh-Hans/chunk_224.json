[{"type": "subtitle", "time": 13440.15, "timestamp": "03:44:00", "text": "以前甚至在学校里也经常说话，"}, {"type": "subtitle", "time": 13442.309, "timestamp": "03:44:02", "text": "高中之类的。"}, {"type": "subtitle", "time": 13445.269, "timestamp": "03:44:05", "text": "我以前是个沉默寡言的孩子。"}, {"type": "subtitle", "time": 13446.79, "timestamp": "03:44:06", "text": "但当我开始直播时，我"}, {"type": "subtitle", "time": 13449.51, "timestamp": "03:44:09", "text": "我想成为一名 YouTuber。但"}, {"type": "subtitle", "time": 13452.71, "timestamp": "03:44:12", "text": "用我的脸录制视频感觉就像"}, {"type": "subtitle", "time": 13456.55, "timestamp": "03:44:16", "text": "尴尬又难堪。我当时就想，"}, {"type": "subtitle", "time": 13459.67, "timestamp": "03:44:19", "text": "我会像那些非主播一样……"}, {"type": "subtitle", "time": 13463.189, "timestamp": "03:44:23", "text": "就是游戏玩法之类的。所以我这么做了。"}, {"type": "subtitle", "time": 13465.189, "timestamp": "03:44:25", "text": "一阵子。然后我发现了虚拟主播。"}, {"type": "subtitle", "time": 13467.67, "timestamp": "03:44:27", "text": "然后就试着这么做了。所以在"}, {"type": "subtitle", "time": 13469.83, "timestamp": "03:44:29", "text": "一开始我习惯这样摆放。"}, {"type": "subtitle", "time": 13473.03, "timestamp": "03:44:33", "text": "目标就像我将要讲五分钟一样"}, {"type": "subtitle", "time": 13478.229, "timestamp": "03:44:38", "text": "或者像一段话或十句话"}, {"type": "subtitle", "time": 13481.99, "timestamp": "03:44:41", "text": "嗯，我当时在我的信息流里写了10句话"}, {"type": "subtitle", "time": 13486.469, "timestamp": "03:44:46", "text": "玩游戏之类的。"}, {"type": "subtitle", "time": 13488.469, "timestamp": "03:44:48", "text": "然后，我第一次买了一个"}, {"type": "subtitle", "time": 13490.389, "timestamp": "03:44:50", "text": "麦克风"}, {"type": "subtitle", "time": 13494.07, "timestamp": "03:44:54", "text": "一个便宜的麦克风，大概100卢比左右。"}, {"type": "subtitle", "time": 13498.07, "timestamp": "03:44:58", "text": "亚马逊售价200卢比。"}]
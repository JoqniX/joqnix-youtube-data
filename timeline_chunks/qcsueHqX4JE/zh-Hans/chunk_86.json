[{"type": "subtitle", "time": 5162.47, "timestamp": "01:26:02", "text": "唯一的事情"}, {"type": "subtitle", "time": 5164.229, "timestamp": "01:26:04", "text": "所以我才问你，你不可能面面俱到。"}, {"type": "subtitle", "time": 5166.79, "timestamp": "01:26:06", "text": "一直都是 darknik。"}, {"type": "subtitle", "time": 5171.43, "timestamp": "01:26:11", "text": "是的，我现在意识到了。"}, {"type": "subtitle", "time": 5176.07, "timestamp": "01:26:16", "text": "哦，就像我一样。我当时就想，这不是开玩笑吗？"}, {"type": "subtitle", "time": 5180.149, "timestamp": "01:26:20", "text": "我的所有东西。我的签名"}, {"type": "subtitle", "time": 5182.79, "timestamp": "01:26:22", "text": "一切都跟运动有关。好的，我的法律"}, {"type": "subtitle", "time": 5184.39, "timestamp": "01:26:24", "text": "文件上全是jocknik"}, {"type": "subtitle", "time": 5186.709, "timestamp": "01:26:26", "text": "签名。我当时想，我开玩笑的。"}, {"type": "subtitle", "time": 5202.55, "timestamp": "01:26:42", "text": "所以，就像我最终不得不……"}, {"type": "subtitle", "time": 5206.79, "timestamp": "01:26:46", "text": "也要关注现实生活。这很重要"}, {"type": "subtitle", "time": 5209.99, "timestamp": "01:26:49", "text": "可以把它看作是一种爱好或者我"}, {"type": "subtitle", "time": 5218.95, "timestamp": "01:26:58", "text": "有很多类似的东西。比如……"}]
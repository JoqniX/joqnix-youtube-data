[{"type": "subtitle", "time": 17581.11, "timestamp": "04:53:01", "text": "他们跟我联系只是为了能跟我建立联系。"}, {"type": "subtitle", "time": 17584.23, "timestamp": "04:53:04", "text": "与任务型 YouTuber 或其他 YouTuber 我"}, {"type": "subtitle", "time": 17587.51, "timestamp": "04:53:07", "text": "我现在和他们是朋友，他们以前也是。"}, {"type": "subtitle", "time": 17589.75, "timestamp": "04:53:09", "text": "以至于变得太"}, {"type": "subtitle", "time": 17593.75, "timestamp": "04:53:13", "text": "像创伤倾倒一样，有毒的痛苦和"}, {"type": "subtitle", "time": 17597.43, "timestamp": "04:53:17", "text": "比如，呃，侵略性这个，还有那个，我当时"}, {"type": "subtitle", "time": 17601.19, "timestamp": "04:53:21", "text": "好吧，我已经受够了。"}, {"type": "subtitle", "time": 17603.27, "timestamp": "04:53:23", "text": "我是一个太容易原谅别人的人。"}, {"type": "subtitle", "time": 17607.03, "timestamp": "04:53:27", "text": "现在，还是那些当时在那里的人……"}, {"type": "subtitle", "time": 17609.75, "timestamp": "04:53:29", "text": "帮帮我，就像那些YouTube博主一样"}, {"type": "subtitle", "time": 17612.31, "timestamp": "04:53:32", "text": "在那里帮助我，并说，是的，这"}, {"type": "subtitle", "time": 17614.868, "timestamp": "04:53:34", "text": "他们还说，是的。"}, {"type": "subtitle", "time": 17617.11, "timestamp": "04:53:37", "text": "你应该像你应该放置一样把它切掉"}, {"type": "subtitle", "time": 17619.35, "timestamp": "04:53:39", "text": "设定界限之类的。那是"}, {"type": "subtitle", "time": 17623.27, "timestamp": "04:53:43", "text": "我是如何意识到这一点的，是的，我不应该"}, {"type": "subtitle", "time": 17626.948, "timestamp": "04:53:46", "text": "给出建议，还有，嗯，你……"}, {"type": "subtitle", "time": 17629.67, "timestamp": "04:53:49", "text": "称之为帮助那些甚至不愿接受的人"}, {"type": "subtitle", "time": 17632.708, "timestamp": "04:53:52", "text": "现在我需要帮助，或者至少听听大家的意见。"}, {"type": "subtitle", "time": 17635.35, "timestamp": "04:53:55", "text": "仍然会像以前那样。"}, {"type": "subtitle", "time": 17638.23, "timestamp": "04:53:58", "text": "对其他人来说会令人毛骨悚然的人"}]
[{"type": "subtitle", "time": 5221.99, "timestamp": "01:27:01", "text": "最初的问题是正确的"}, {"type": "subtitle", "time": 5225.03, "timestamp": "01:27:05", "text": "呃，你的父母会这样跟你说话吗？"}, {"type": "subtitle", "time": 5229.03, "timestamp": "01:27:09", "text": "我很庆幸爸爸帮助了我"}, {"type": "subtitle", "time": 5231.75, "timestamp": "01:27:11", "text": "登记自己为船只之类的东西"}, {"type": "subtitle", "time": 5234.149, "timestamp": "01:27:14", "text": "真正的灵魂"}, {"type": "subtitle", "time": 5246.39, "timestamp": "01:27:26", "text": "像这样也是一件大事。"}, {"type": "subtitle", "time": 5249.03, "timestamp": "01:27:29", "text": "对，就像自己创业一样。"}, {"type": "subtitle", "time": 5252.149, "timestamp": "01:27:32", "text": "创业或开设自己的办公室，例如"}, {"type": "subtitle", "time": 5263.11, "timestamp": "01:27:43", "text": "是的，我完全独立于他。"}, {"type": "subtitle", "time": 5265.59, "timestamp": "01:27:45", "text": "他确实帮了我。甚至"}, {"type": "subtitle", "time": 5268.39, "timestamp": "01:27:48", "text": "虽然感觉我赚不了多少钱"}, {"type": "chat", "time": 5269.325, "timestamp": "01:27:49", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "Hm"}, {"type": "subtitle", "time": 5271.03, "timestamp": "01:27:51", "text": "流媒体之类的，"}, {"type": "subtitle", "time": 5273.99, "timestamp": "01:27:53", "text": "他确实帮了我，不像消费税那件事。"}, {"type": "subtitle", "time": 5277.03, "timestamp": "01:27:57", "text": "还有注册那件事。"}, {"type": "subtitle", "time": 5278.95, "timestamp": "01:27:58", "text": "呃"}]
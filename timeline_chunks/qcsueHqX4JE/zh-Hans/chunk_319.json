[{"type": "subtitle", "time": 19140.31, "timestamp": "05:19:00", "text": "也要努力成为一个更好的人等等。不。"}, {"type": "subtitle", "time": 19142.628, "timestamp": "05:19:02", "text": "难道这不是最好的办法吗？"}, {"type": "subtitle", "time": 19149.91, "timestamp": "05:19:09", "text": "就像你犯了个错误一样，你承认了。"}, {"type": "subtitle", "time": 19152.31, "timestamp": "05:19:12", "text": "你犯了个错误，你会成为一个"}, {"type": "subtitle", "time": 19154.23, "timestamp": "05:19:14", "text": "做一个更好的人，不再重蹈覆辙。"}, {"type": "subtitle", "time": 19156.15, "timestamp": "05:19:16", "text": "错误。"}, {"type": "subtitle", "time": 19167.43, "timestamp": "05:19:27", "text": "我的律师们竟然还训斥了我。"}, {"type": "subtitle", "time": 19169.99, "timestamp": "05:19:29", "text": "这个人很擅长不问就做事。"}, {"type": "subtitle", "time": 19171.83, "timestamp": "05:19:31", "text": "他们"}, {"type": "subtitle", "time": 19176.39, "timestamp": "05:19:36", "text": "就像我的文档一样。在某种程度上，我"}, {"type": "subtitle", "time": 19179.03, "timestamp": "05:19:39", "text": "忘记移除"}, {"type": "subtitle", "time": 19182.628, "timestamp": "05:19:42", "text": "道歉之类的。"}, {"type": "subtitle", "time": 19185.99, "timestamp": "05:19:45", "text": "他当时就说："}, {"type": "subtitle", "time": 19187.59, "timestamp": "05:19:47", "text": "“兄弟，"}, {"type": "subtitle", "time": 19197.03, "timestamp": "05:19:57", "text": "然后我就说：“戈梅，对不起。”"}, {"type": "subtitle", "time": 19199.83, "timestamp": "05:19:59", "text": "我就知道。只是人们接受了"}]
[{"type": "subtitle", "time": 1591.669, "timestamp": "00:26:31", "text": "感觉我需要多做一些这样的事。"}, {"type": "subtitle", "time": 1595.029, "timestamp": "00:26:35", "text": "恶魔，呃，恶魔徽章或角色"}, {"type": "subtitle", "time": 1597.43, "timestamp": "00:26:37", "text": "因为我觉得我没做什么，所以才想做这件事。"}, {"type": "subtitle", "time": 1600.31, "timestamp": "00:26:40", "text": "损失惨重。"}, {"type": "subtitle", "time": 1602.63, "timestamp": "00:26:42", "text": "尤其是我的丽贝卡。我不是，我没有"}]
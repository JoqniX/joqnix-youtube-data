[{"type": "subtitle", "time": 9301.349, "timestamp": "02:35:01", "text": "但当我仔细想想，就像我曾经那样……"}, {"type": "subtitle", "time": 9303.11, "timestamp": "02:35:03", "text": "听到了"}, {"type": "subtitle", "time": 9308.79, "timestamp": "02:35:08", "text": "在线上，还有一些人通过类似动漫的方式进行交流。"}, {"type": "subtitle", "time": 9312.55, "timestamp": "02:35:12", "text": "就像大学一样"}, {"type": "subtitle", "time": 9315.349, "timestamp": "02:35:15", "text": "昂贵的"}, {"type": "subtitle", "time": 9325.19, "timestamp": "02:35:25", "text": "日本人"}, {"type": "subtitle", "time": 9326.87, "timestamp": "02:35:26", "text": "住宿和日语培训。"}, {"type": "subtitle", "time": 9329.429, "timestamp": "02:35:29", "text": "哦，对对对，类似那样。"}, {"type": "subtitle", "time": 9333.75, "timestamp": "02:35:33", "text": "那个人，那个家伙，呃，为了他们"}, {"type": "subtitle", "time": 9336.07, "timestamp": "02:35:36", "text": "嗯，是的，他们会处理的。"}, {"type": "subtitle", "time": 9338.15, "timestamp": "02:35:38", "text": "住宿和所有住房相关事宜"}, {"type": "subtitle", "time": 9341.99, "timestamp": "02:35:41", "text": "把那些东西都塞进去"}, {"type": "subtitle", "time": 9344.95, "timestamp": "02:35:44", "text": "这太疯狂了，竟然不能在……工作"}, {"type": "subtitle", "time": 9347.67, "timestamp": "02:35:47", "text": "在另一个国家，我明白了。"}, {"type": "subtitle", "time": 9351.532, "timestamp": "02:35:51", "text": "赞助之类的东西，真是太酷了"}]
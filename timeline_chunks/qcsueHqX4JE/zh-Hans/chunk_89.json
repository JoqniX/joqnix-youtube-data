[{"type": "subtitle", "time": 5340.87, "timestamp": "01:29:00", "text": "变成 IGST 之类的东西"}, {"type": "subtitle", "time": 5344.149, "timestamp": "01:29:04", "text": "国际消费税之类的东西"}, {"type": "subtitle", "time": 5347.59, "timestamp": "01:29:07", "text": "现在有很多格式方面的规定。"}, {"type": "subtitle", "time": 5350.87, "timestamp": "01:29:10", "text": "文件方面等等"}, {"type": "subtitle", "time": 5353.03, "timestamp": "01:29:13", "text": "但即便如此，我仍然很高兴……"}, {"type": "subtitle", "time": 5355.51, "timestamp": "01:29:15", "text": "至少他们支持正义，不管怎样"}, {"type": "subtitle", "time": 5359.11, "timestamp": "01:29:19", "text": "我想做，但当我的东西……"}, {"type": "subtitle", "time": 5361.35, "timestamp": "01:29:21", "text": "就像那些戏剧之类的事情一样，"}, {"type": "subtitle", "time": 5368.39, "timestamp": "01:29:28", "text": "学校里很多人都跟我说要像我爸爸一样。"}, {"type": "subtitle", "time": 5370.31, "timestamp": "01:29:30", "text": "他们让我停止直播。"}, {"type": "subtitle", "time": 5372.629, "timestamp": "01:29:32", "text": "不要上网，专心致志。"}, {"type": "chat", "time": 5373.21, "timestamp": "01:29:33", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "I am still playing games but who knows if I still continue playing games like this"}, {"type": "subtitle", "time": 5375.11, "timestamp": "01:29:35", "text": "红外"}, {"type": "subtitle", "time": 5385.43, "timestamp": "01:29:45", "text": "因为就我而言，我就像那些人一样。"}, {"type": "subtitle", "time": 5389.27, "timestamp": "01:29:49", "text": "发生了一些事，我算是彻底搞清楚了。"}, {"type": "subtitle", "time": 5391.99, "timestamp": "01:29:51", "text": "当时的情况变得一团糟，"}]
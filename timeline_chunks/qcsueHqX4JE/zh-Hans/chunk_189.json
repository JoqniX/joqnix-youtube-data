[{"type": "subtitle", "time": 11341.19, "timestamp": "03:09:01", "text": "我必须去，路程需要一个小时。我"}, {"type": "subtitle", "time": 11344.72, "timestamp": "03:09:04", "text": "得坐火车之类的交通工具去。"}, {"type": "subtitle", "time": 11345.99, "timestamp": "03:09:05", "text": "[笑声]"}, {"type": "subtitle", "time": 11350.63, "timestamp": "03:09:10", "text": "呃，它太远了。上次我"}, {"type": "subtitle", "time": 11355.03, "timestamp": "03:09:15", "text": "从我家出发，大概要花5个小时的车程。我"}, {"type": "subtitle", "time": 11359.19, "timestamp": "03:09:19", "text": "早上5点就得坐公交车去"}, {"type": "subtitle", "time": 11371.349, "timestamp": "03:09:31", "text": "我现在住在南部。"}, {"type": "subtitle", "time": 11373.51, "timestamp": "03:09:33", "text": "所以"}, {"type": "subtitle", "time": 11376.71, "timestamp": "03:09:36", "text": "是的，我得走了。"}, {"type": "subtitle", "time": 11378.87, "timestamp": "03:09:38", "text": "昨晚回程途中遇到了火灾。"}, {"type": "subtitle", "time": 11383.67, "timestamp": "03:09:43", "text": "第四。我内心一片死寂，就像我的"}, {"type": "subtitle", "time": 11386.71, "timestamp": "03:09:46", "text": "日语课程 N41"}, {"type": "subtitle", "time": 11391.269, "timestamp": "03:09:51", "text": "这件事将在12月10日之前结束，或者"}, {"type": "subtitle", "time": 11393.849, "timestamp": "03:09:53", "text": "第十二。他就是这么说的。因为我"}, {"type": "subtitle", "time": 11395.99, "timestamp": "03:09:55", "text": "[音乐]这么说，我就想，所以他就那样了"}, {"type": "subtitle", "time": 11399.19, "timestamp": "03:09:59", "text": "就像他问的那样，如果有的话"}]
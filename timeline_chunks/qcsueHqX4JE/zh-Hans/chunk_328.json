[{"type": "subtitle", "time": 19682.39, "timestamp": "05:28:02", "text": "他们喜欢做一些事情，我们有"}, {"type": "subtitle", "time": 19686.07, "timestamp": "05:28:06", "text": "很久以前就认识了。他们突然出现"}, {"type": "subtitle", "time": 19690.39, "timestamp": "05:28:10", "text": "就像，“是啊，我知道。我喜欢我以前的样子。”"}, {"type": "subtitle", "time": 19693.59, "timestamp": "05:28:13", "text": "正确的。这家伙一直都很古怪。"}, {"type": "subtitle", "time": 19695.59, "timestamp": "05:28:15", "text": "这个那个。他给我的感觉很奇怪。"}, {"type": "subtitle", "time": 19699.67, "timestamp": "05:28:19", "text": "当我表现得如此尊重的时候，却发生了这样的事"}, {"type": "subtitle", "time": 19702.15, "timestamp": "05:28:22", "text": "所有事情都一视同仁。"}, {"type": "subtitle", "time": 19708.31, "timestamp": "05:28:28", "text": "大家都很尊重我，我当时就想："}, {"type": "subtitle", "time": 19712.15, "timestamp": "05:28:32", "text": "我当时就想，老兄，然后我就去查看了"}, {"type": "subtitle", "time": 19717.19, "timestamp": "05:28:37", "text": "私信。好的。我当时表现得非常尊重对方。"}, {"type": "subtitle", "time": 19719.11, "timestamp": "05:28:39", "text": "当然，尴尬的部分还是有的。"}, {"type": "subtitle", "time": 19723.03, "timestamp": "05:28:43", "text": "那个场景模型、头垫之类的东西"}, {"type": "subtitle", "time": 19725.75, "timestamp": "05:28:45", "text": "这可以理解。"}, {"type": "subtitle", "time": 19727.51, "timestamp": "05:28:47", "text": "除此之外，没有别的了。"}, {"type": "subtitle", "time": 19730.788, "timestamp": "05:28:50", "text": "这可能被视为令人毛骨悚然或怪异，或者"}, {"type": "subtitle", "time": 19733.402, "timestamp": "05:28:53", "text": "掠夺性或其他什么。"}]
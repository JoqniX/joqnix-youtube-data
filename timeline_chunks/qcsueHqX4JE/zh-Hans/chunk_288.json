[{"type": "subtitle", "time": 17281.59, "timestamp": "04:48:01", "text": "YouTuber 经纪人出了点问题"}, {"type": "subtitle", "time": 17283.59, "timestamp": "04:48:03", "text": "还有一些其他的东西。"}, {"type": "subtitle", "time": 17286.39, "timestamp": "04:48:06", "text": "他们负责很多事情，"}, {"type": "subtitle", "time": 17289.35, "timestamp": "04:48:09", "text": "财务方面的事情。"}, {"type": "subtitle", "time": 17292.788, "timestamp": "04:48:12", "text": "就这样，当……"}, {"type": "subtitle", "time": 17295.51, "timestamp": "04:48:15", "text": "这一点我必须在我的戏剧中提及。"}, {"type": "subtitle", "time": 17297.83, "timestamp": "04:48:17", "text": "以及所有需要拖拽的东西"}, {"type": "subtitle", "time": 17300.868, "timestamp": "04:48:20", "text": "是那些把她拖进这件事里的人造成的。"}, {"type": "subtitle", "time": 17305.91, "timestamp": "04:48:25", "text": "对她来说，她就像个虚拟助理。"}, {"type": "subtitle", "time": 17308.788, "timestamp": "04:48:28", "text": "她就像是配音演员的经纪人。"}, {"type": "subtitle", "time": 17312.55, "timestamp": "04:48:32", "text": "还有她以前喜欢说的话"}, {"type": "subtitle", "time": 17315.91, "timestamp": "04:48:35", "text": "关于她过去的事情，比如她以前是怎样的"}, {"type": "subtitle", "time": 17318.948, "timestamp": "04:48:38", "text": "管理配音演员及其他所有事宜"}, {"type": "subtitle", "time": 17321.83, "timestamp": "04:48:41", "text": "她的工作室和一切"}, {"type": "subtitle", "time": 17323.67, "timestamp": "04:48:43", "text": "以及所有的一切。我大概明白了"}, {"type": "subtitle", "time": 17326.708, "timestamp": "04:48:46", "text": "比如，哦，很多事情都会影响到它。"}, {"type": "subtitle", "time": 17329.19, "timestamp": "04:48:49", "text": "你知道，就是那种管理方面的事情。"}, {"type": "subtitle", "time": 17331.59, "timestamp": "04:48:51", "text": "这本身就是疯狂的"}, {"type": "subtitle", "time": 17335.03, "timestamp": "04:48:55", "text": "许多顶级创作者都拥有这种能力。"}, {"type": "subtitle", "time": 17337.67, "timestamp": "04:48:57", "text": "他们有自己的经理和工作人员"}]
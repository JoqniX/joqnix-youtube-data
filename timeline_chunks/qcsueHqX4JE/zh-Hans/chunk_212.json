[{"type": "subtitle", "time": 12720.469, "timestamp": "03:32:00", "text": "这里面包含的信息太多了。有这么多"}, {"type": "subtitle", "time": 12729.83, "timestamp": "03:32:09", "text": "现在的生活。有幸体验过这些"}, {"type": "subtitle", "time": 12731.99, "timestamp": "03:32:11", "text": "艰辛。这就像一道障碍。它是"}, {"type": "subtitle", "time": 12738.87, "timestamp": "03:32:18", "text": "以专业身份。我会"}, {"type": "subtitle", "time": 12742.15, "timestamp": "03:32:22", "text": "不建议这样做。"}, {"type": "subtitle", "time": 12745.782, "timestamp": "03:32:25", "text": "但我只是个聊天室里的人。"}, {"type": "subtitle", "time": 12746.87, "timestamp": "03:32:26", "text": "[笑声]"}, {"type": "subtitle", "time": 12749.349, "timestamp": "03:32:29", "text": "但你给了我很多知识。"}, {"type": "subtitle", "time": 12752.15, "timestamp": "03:32:32", "text": "所以，我从来没有"}, {"type": "subtitle", "time": 12756.79, "timestamp": "03:32:36", "text": "我以前从未……知道。所以，我真的"}]
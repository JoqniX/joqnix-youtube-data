[{"type": "subtitle", "time": 10263.83, "timestamp": "02:51:03", "text": "我的朋友，我的儿时好友，他"}, {"type": "subtitle", "time": 10266.87, "timestamp": "02:51:06", "text": "一直在做很多共同基金和"}, {"type": "subtitle", "time": 10268.87, "timestamp": "02:51:08", "text": "东西"}, {"type": "subtitle", "time": 10271.11, "timestamp": "02:51:11", "text": "以及交易。我知道购买"}, {"type": "subtitle", "time": 10273.19, "timestamp": "02:51:13", "text": "股票之类的，对吧？我不"}, {"type": "subtitle", "time": 10275.19, "timestamp": "02:51:15", "text": "知道。我不懂那些东西。但他"}, {"type": "subtitle", "time": 10277.11, "timestamp": "02:51:17", "text": "一直跟我说要建立互惠关系"}, {"type": "subtitle", "time": 10279.91, "timestamp": "02:51:19", "text": "资金谈话"}, {"type": "subtitle", "time": 10283.11, "timestamp": "02:51:23", "text": "诸如此类的事情，他一直在努力稳定局面。"}, {"type": "subtitle", "time": 10287.75, "timestamp": "02:51:27", "text": "所有这些东西，不知何故"}, {"type": "subtitle", "time": 10292.309, "timestamp": "02:51:32", "text": "他当时就好像在说，呃，你……"}, {"type": "subtitle", "time": 10295.99, "timestamp": "02:51:35", "text": "把那位医生叫做野战医生，就像"}, {"type": "subtitle", "time": 10298.23, "timestamp": "02:51:38", "text": "体育之类的"}, {"type": "subtitle", "time": 10300.309, "timestamp": "02:51:40", "text": "他研究过那个，但他没有"}, {"type": "subtitle", "time": 10302.87, "timestamp": "02:51:42", "text": "他对此非常感兴趣，所以他转换了"}, {"type": "subtitle", "time": 10306.469, "timestamp": "02:51:46", "text": "想知道自己喜欢哪些职业道路"}, {"type": "subtitle", "time": 10309.75, "timestamp": "02:51:49", "text": "多关注那一边"}, {"type": "subtitle", "time": 10312.23, "timestamp": "02:51:52", "text": "比如共同基金等等"}]
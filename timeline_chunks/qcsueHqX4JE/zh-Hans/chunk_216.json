[{"type": "subtitle", "time": 12968.71, "timestamp": "03:36:08", "text": "哦，对，我之前用过一个主播。"}, {"type": "subtitle", "time": 12971.51, "timestamp": "03:36:11", "text": "值得一看。曾是印度主播。"}, {"type": "subtitle", "time": 12973.03, "timestamp": "03:36:13", "text": "呃"}, {"type": "subtitle", "time": 12975.83, "timestamp": "03:36:15", "text": "他叫什么名字？呃，Axel 现场演出或"}, {"type": "subtitle", "time": 12978.71, "timestamp": "03:36:18", "text": "某物。阿克塞尔。"}, {"type": "subtitle", "time": 12981.59, "timestamp": "03:36:21", "text": "他以前经常直播玩绝地求生。我曾经"}, {"type": "subtitle", "time": 12988.389, "timestamp": "03:36:28", "text": "阿克塞尔"}, {"type": "subtitle", "time": 12990.309, "timestamp": "03:36:30", "text": "不包括"}, {"type": "subtitle", "time": 12993.51, "timestamp": "03:36:33", "text": "某某事。"}, {"type": "subtitle", "time": 12995.349, "timestamp": "03:36:35", "text": "我不知道。"}, {"type": "subtitle", "time": 12998.55, "timestamp": "03:36:38", "text": "那大概是"}, {"type": "subtitle", "time": 13000.07, "timestamp": "03:36:40", "text": "足够的。"}, {"type": "subtitle", "time": 13010.15, "timestamp": "03:36:50", "text": "所以这意味着我正在和……说话"}, {"type": "subtitle", "time": 13015.59, "timestamp": "03:36:55", "text": "某人。真是太令人惊叹了。"}, {"type": "subtitle", "time": 13018.55, "timestamp": "03:36:58", "text": "我们基本上是一支快速攻击型队伍。"}]
[{"type": "subtitle", "time": 14881.59, "timestamp": "04:08:01", "text": "这是因为现在有太多聊天机器人出现了。"}, {"type": "subtitle", "time": 14885.91, "timestamp": "04:08:05", "text": "例如，就像踢球时发生的情况一样。"}, {"type": "subtitle", "time": 14887.91, "timestamp": "04:08:07", "text": "也一样。就在此刻。"}, {"type": "subtitle", "time": 14891.03, "timestamp": "04:08:11", "text": "有四个机器人真的……"}, {"type": "subtitle", "time": 14893.75, "timestamp": "04:08:13", "text": "因自动化操作而被禁止"}, {"type": "subtitle", "time": 14897.75, "timestamp": "04:08:17", "text": "因为他们的促销活动而被禁言"}, {"type": "subtitle", "time": 14901.269, "timestamp": "04:08:21", "text": "促销信息，因为事实并非如此，我当时是"}, {"type": "subtitle", "time": 14904.55, "timestamp": "04:08:24", "text": "好吧，我收到了很多"}, {"type": "subtitle", "time": 14909.83, "timestamp": "04:08:29", "text": "这些嗯，Twitch上的GFX机器人"}, {"type": "subtitle", "time": 14912.15, "timestamp": "04:08:32", "text": "我当时就想："}, {"type": "subtitle", "time": 14915.189, "timestamp": "04:08:35", "text": "呃，但是他们没有关注聊天功能"}, {"type": "subtitle", "time": 14916.87, "timestamp": "04:08:36", "text": "有些人不太愿意互动，"}, {"type": "subtitle", "time": 14920.55, "timestamp": "04:08:40", "text": "你说“嗯，是吗？”然后我"}, {"type": "subtitle", "time": 14923.67, "timestamp": "04:08:43", "text": "好吧，就像我之前谈过这件事一样。"}, {"type": "subtitle", "time": 14926.79, "timestamp": "04:08:46", "text": "我很久以前想直播的时候"}, {"type": "subtitle", "time": 14928.71, "timestamp": "04:08:48", "text": "只实现跟随者功能，你"}, {"type": "subtitle", "time": 14932.389, "timestamp": "04:08:52", "text": "知道。然后，当一位主播突袭时"}, {"type": "subtitle", "time": 14935.269, "timestamp": "04:08:55", "text": "我和他们当时也在讨论为什么"}, {"type": "subtitle", "time": 14937.83, "timestamp": "04:08:57", "text": "你的 Twitch 聊天室设置好了吗？"}]
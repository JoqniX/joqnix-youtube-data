[{"type": "subtitle", "time": 14102.469, "timestamp": "03:55:02", "text": "加入朋友的社交观众"}, {"type": "subtitle", "time": 14109.349, "timestamp": "03:55:09", "text": "那些朋友"}, {"type": "subtitle", "time": 14114.95, "timestamp": "03:55:14", "text": "因为就我而言，我过去常常这样，我就像……"}, {"type": "subtitle", "time": 14117.83, "timestamp": "03:55:17", "text": "感觉自己像个讨好型人格。"}, {"type": "subtitle", "time": 14120.79, "timestamp": "03:55:20", "text": "我优先考虑其他事项，然后再考虑其他事项。"}, {"type": "subtitle", "time": 14124.15, "timestamp": "03:55:24", "text": "我。那是一种错误的心态。"}, {"type": "subtitle", "time": 14126.79, "timestamp": "03:55:26", "text": "现在我必须慢慢地尝试"}, {"type": "subtitle", "time": 14134.229, "timestamp": "03:55:34", "text": "同时，我也在努力提升自己。"}, {"type": "subtitle", "time": 14137.269, "timestamp": "03:55:37", "text": "我注意到我以前也这样做过。"}, {"type": "subtitle", "time": 14140.469, "timestamp": "03:55:40", "text": "观众也是如此。无论如何"}, {"type": "subtitle", "time": 14142.79, "timestamp": "03:55:42", "text": "观众想看什么，我就满足大家。"}, {"type": "subtitle", "time": 14147.189, "timestamp": "03:55:47", "text": "差不多就是那种事儿。"}, {"type": "subtitle", "time": 14148.87, "timestamp": "03:55:48", "text": "但"}, {"type": "subtitle", "time": 14152.63, "timestamp": "03:55:52", "text": "我意识到那样做不好。不，"}, {"type": "subtitle", "time": 14155.429, "timestamp": "03:55:55", "text": "我是一名艺人。我的工作是什么？我的"}]
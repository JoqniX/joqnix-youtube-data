[{"type": "subtitle", "time": 11401.75, "timestamp": "03:10:01", "text": "任何想参加考试的学生"}, {"type": "subtitle", "time": 11405.349, "timestamp": "03:10:05", "text": "12月参加NAT考试或JPT考试"}, {"type": "subtitle", "time": 11407.03, "timestamp": "03:10:07", "text": "或者如果有人要把它写在……"}, {"type": "subtitle", "time": 11409.83, "timestamp": "03:10:09", "text": "一月份的NAT，我想选的那个。"}, {"type": "subtitle", "time": 11412.23, "timestamp": "03:10:12", "text": "一月份的时候，我就觉得我可以就这么"}, {"type": "subtitle", "time": 11424.15, "timestamp": "03:10:24", "text": "它可能来自浦那，就像来自泰米尔语一样。"}, {"type": "subtitle", "time": 11425.59, "timestamp": "03:10:25", "text": "还有一些其他的东西。我的第一语言是"}, {"type": "subtitle", "time": 11427.83, "timestamp": "03:10:27", "text": "马拉雅拉姆语。所以，是的，我从来都不是来自"}, {"type": "subtitle", "time": 11433.99, "timestamp": "03:10:33", "text": "所以"}, {"type": "subtitle", "time": 11443.67, "timestamp": "03:10:43", "text": "是的。 [笑声]"}, {"type": "subtitle", "time": 11449.11, "timestamp": "03:10:49", "text": "所以我觉得我有点……嗯，BBC 的文章"}, {"type": "subtitle", "time": 11453.269, "timestamp": "03:10:53", "text": "某种程度上暴露了我的地域性"}, {"type": "subtitle", "time": 11455.91, "timestamp": "03:10:55", "text": "我来自印度"}]
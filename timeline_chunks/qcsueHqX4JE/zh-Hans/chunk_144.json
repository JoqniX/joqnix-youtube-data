[{"type": "subtitle", "time": 8641.75, "timestamp": "02:24:01", "text": "被偷是一回事，尤其是"}, {"type": "subtitle", "time": 8646.23, "timestamp": "02:24:06", "text": "我得把这麦克风给这家伙。"}, {"type": "subtitle", "time": 8649.27, "timestamp": "02:24:09", "text": "两个麦克风，包括电容式麦克风和"}, {"type": "subtitle", "time": 8651.67, "timestamp": "02:24:11", "text": "动圈麦克风"}, {"type": "subtitle", "time": 8653.83, "timestamp": "02:24:13", "text": "我用来做ASMR的那个和我用的"}, {"type": "subtitle", "time": 8656.87, "timestamp": "02:24:16", "text": "如今，这对于普通流媒体来说很常见。我要"}, {"type": "subtitle", "time": 8660.55, "timestamp": "02:24:20", "text": "两者都要。正确的。问题是我觉得"}, {"type": "subtitle", "time": 8664.95, "timestamp": "02:24:24", "text": "我当时想，反正之后"}, {"type": "subtitle", "time": 8669.03, "timestamp": "02:24:29", "text": "2年或"}, {"type": "subtitle", "time": 8672.79, "timestamp": "02:24:32", "text": "6个月，嗯，Dometry之类的东西，对吧？"}, {"type": "subtitle", "time": 8676.389, "timestamp": "02:24:36", "text": "另一项繁琐的开支。所以之后"}, {"type": "subtitle", "time": 8682.55, "timestamp": "02:24:42", "text": "前多米提里相关工作已经完成了两年，"}, {"type": "subtitle", "time": 8685.27, "timestamp": "02:24:45", "text": "我当时在想，我会……"}, {"type": "subtitle", "time": 8688.07, "timestamp": "02:24:48", "text": "最终"}, {"type": "subtitle", "time": 8690.63, "timestamp": "02:24:50", "text": "我得自己找个地方住。"}, {"type": "subtitle", "time": 8693.03, "timestamp": "02:24:53", "text": "比如公寓、套房之类的"}, {"type": "subtitle", "time": 8698.15, "timestamp": "02:24:58", "text": "保持正确。嗯，所以"}]
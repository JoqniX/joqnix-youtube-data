[{"type": "subtitle", "time": 9968.71, "timestamp": "02:46:08", "text": "我在印度很开心，因为我是一名实习生"}, {"type": "subtitle", "time": 9971.429, "timestamp": "02:46:11", "text": "我拿的是国际工资，但我只有"}, {"type": "subtitle", "time": 9987.75, "timestamp": "02:46:27", "text": "等等，等等，等等，等等，等等，等等。还"}, {"type": "subtitle", "time": 9995.91, "timestamp": "02:46:35", "text": "当你的语言导致中心开始时"}, {"type": "subtitle", "time": 9997.91, "timestamp": "02:46:37", "text": "说到光标，他们已经"}, {"type": "subtitle", "time": 9999.67, "timestamp": "02:46:39", "text": "不再以你的最佳利益为出发点"}, {"type": "subtitle", "time": 10001.349, "timestamp": "02:46:41", "text": "头脑。你这话是什么意思？"}, {"type": "subtitle", "time": 10004.23, "timestamp": "02:46:44", "text": "精心制作的。不，不。就好像他们是"}, {"type": "subtitle", "time": 10006.95, "timestamp": "02:46:46", "text": "给我感觉"}, {"type": "subtitle", "time": 10010.469, "timestamp": "02:46:50", "text": "给我告诉我，呃，就像"}, {"type": "subtitle", "time": 10012.95, "timestamp": "02:46:52", "text": "重要的事情，对吧？"}, {"type": "subtitle", "time": 10016.389, "timestamp": "02:46:56", "text": "我能做的事情等等，对吧？"}, {"type": "subtitle", "time": 10018.15, "timestamp": "02:46:58", "text": "问号。问号问题"}]
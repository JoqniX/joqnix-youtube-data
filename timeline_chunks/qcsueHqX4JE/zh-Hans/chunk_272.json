[{"type": "subtitle", "time": 16321.67, "timestamp": "04:32:01", "text": "还是另有其人？等等，是……呃……"}, {"type": "subtitle", "time": 16324.309, "timestamp": "04:32:04", "text": "我的天啊，我一直都在，那部电影叫什么名字来着？"}, {"type": "subtitle", "time": 16338.469, "timestamp": "04:32:18", "text": "是万萨吗？那是谁？"}, {"type": "subtitle", "time": 16340.95, "timestamp": "04:32:20", "text": "我现在彻底糊涂了。是的，确实有。"}, {"type": "subtitle", "time": 16343.269, "timestamp": "04:32:23", "text": "平面设计师"}, {"type": "subtitle", "time": 16346.95, "timestamp": "04:32:26", "text": "甚至包括那些正在做这件事的人。"}, {"type": "subtitle", "time": 16350.469, "timestamp": "04:32:30", "text": "写作之类的，对吧？"}, {"type": "subtitle", "time": 16360.389, "timestamp": "04:32:40", "text": "疯狂的？"}, {"type": "subtitle", "time": 16364.389, "timestamp": "04:32:44", "text": "你知道，如果我有500美元，我就可以……"}, {"type": "subtitle", "time": 16367.03, "timestamp": "04:32:47", "text": "我已获得新车型的所有权，"}, {"type": "subtitle", "time": 16374.469, "timestamp": "04:32:54", "text": "我本可以得到我的所有权"}, {"type": "subtitle", "time": 16376.95, "timestamp": "04:32:56", "text": "是的，他们花的钱就是所有权。"}, {"type": "subtitle", "time": 16378.469, "timestamp": "04:32:58", "text": "在"}]
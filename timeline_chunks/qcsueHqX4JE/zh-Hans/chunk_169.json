[{"type": "subtitle", "time": 10142.07, "timestamp": "02:49:02", "text": "问题是我甚至连一个……"}, {"type": "subtitle", "time": 10144.389, "timestamp": "02:49:04", "text": "储蓄账户。我的意思是，我还有一些积蓄。"}, {"type": "subtitle", "time": 10149.269, "timestamp": "02:49:09", "text": "账户，但我不知道拓扑结构"}, {"type": "subtitle", "time": 10152.07, "timestamp": "02:49:12", "text": "当你拿到工资或薪水时"}, {"type": "subtitle", "time": 10155.429, "timestamp": "02:49:15", "text": "应该将其中一部分保留在……"}, {"type": "subtitle", "time": 10159.269, "timestamp": "02:49:19", "text": "先别管它，那东西不在那儿。"}, {"type": "subtitle", "time": 10161.99, "timestamp": "02:49:21", "text": "我当时并不知道这件事有多重要。"}, {"type": "subtitle", "time": 10171.349, "timestamp": "02:49:31", "text": "我不擅长管理助学金"}, {"type": "subtitle", "time": 10181.349, "timestamp": "02:49:41", "text": "是的，"}, {"type": "subtitle", "time": 10183.99, "timestamp": "02:49:43", "text": "还有一件事。不，"}, {"type": "subtitle", "time": 10186.87, "timestamp": "02:49:46", "text": "我现在被我的宠坏了"}, {"type": "subtitle", "time": 10190.55, "timestamp": "02:49:50", "text": "以独生子女身份加入家庭。我的爸爸妈妈"}, {"type": "subtitle", "time": 10192.71, "timestamp": "02:49:52", "text": "他会在那里帮我处理一些事情，"}, {"type": "subtitle", "time": 10196.71, "timestamp": "02:49:56", "text": "我在印度期间的所有事情。但"}]
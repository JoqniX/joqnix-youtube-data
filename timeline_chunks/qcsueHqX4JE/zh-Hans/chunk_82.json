[{"type": "subtitle", "time": 4921.669, "timestamp": "01:22:01", "text": "呃，我迷茫又困惑，不知道自己想要什么。"}, {"type": "subtitle", "time": 4926.07, "timestamp": "01:22:06", "text": "有吧？我知道，就像某些人一样。"}, {"type": "subtitle", "time": 4930.149, "timestamp": "01:22:10", "text": "家庭，呃，他们的父母会"}, {"type": "subtitle", "time": 4935.03, "timestamp": "01:22:15", "text": "强迫他们像那样追求这个职业"}, {"type": "subtitle", "time": 4937.51, "timestamp": "01:22:17", "text": "变得像 成为律师 成为"}, {"type": "chat", "time": 4939.781, "timestamp": "01:22:19", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "all have there own hobbies"}, {"type": "subtitle", "time": 4940.47, "timestamp": "01:22:20", "text": "医生之类的吧？"}, {"type": "subtitle", "time": 4943.51, "timestamp": "01:22:23", "text": "所以对我来说（哭泣）谢天谢地"}, {"type": "subtitle", "time": 4945.91, "timestamp": "01:22:25", "text": "虽然他们看起来像，但从未发生过。"}, {"type": "chat", "time": 4948.417, "timestamp": "01:22:28", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "but they don't understand"}, {"type": "subtitle", "time": 4949.03, "timestamp": "01:22:29", "text": "他谈到这件事，但我当时想，不，我"}, {"type": "subtitle", "time": 4954.79, "timestamp": "01:22:34", "text": "我觉得我比我的父母幸运多了。"}, {"type": "subtitle", "time": 4958.47, "timestamp": "01:22:38", "text": "至少明白这一点"}, {"type": "subtitle", "time": 4961.91, "timestamp": "01:22:41", "text": "但我……我无法成为完美主义者。"}, {"type": "subtitle", "time": 4964.87, "timestamp": "01:22:44", "text": "他们希望我成为的自己"}, {"type": "subtitle", "time": 4972.39, "timestamp": "01:22:52", "text": "都是“是”。是的。是的。整只蜜蜂。"}, {"type": "subtitle", "time": 4977.59, "timestamp": "01:22:57", "text": "所以，"}]
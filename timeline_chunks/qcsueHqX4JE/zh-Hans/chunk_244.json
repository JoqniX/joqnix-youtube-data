[{"type": "subtitle", "time": 14642.87, "timestamp": "04:04:02", "text": "那是一个模型。我没有使用我的模型"}, {"type": "subtitle", "time": 14646.55, "timestamp": "04:04:06", "text": "由于发生的一些事情，我不再那样做了。"}, {"type": "subtitle", "time": 14648.579, "timestamp": "04:04:08", "text": "为犯罪行为付出代价。"}, {"type": "subtitle", "time": 14650.389, "timestamp": "04:04:10", "text": "[笑声]"}, {"type": "subtitle", "time": 14652.87, "timestamp": "04:04:12", "text": "所以，呃，发生了很多事，因为"}, {"type": "subtitle", "time": 14657.269, "timestamp": "04:04:17", "text": "我想就是这个吧。"}, {"type": "subtitle", "time": 14661.67, "timestamp": "04:04:21", "text": "是的，发生了一些事。所以，嗯"}, {"type": "subtitle", "time": 14664.309, "timestamp": "04:04:24", "text": "我曾想过不使用我的凡人之力"}, {"type": "subtitle", "time": 14666.55, "timestamp": "04:04:26", "text": "不再是了。"}, {"type": "subtitle", "time": 14670.55, "timestamp": "04:04:30", "text": "我记得它是紫色的。"}, {"type": "subtitle", "time": 14673.429, "timestamp": "04:04:33", "text": "呃"}, {"type": "subtitle", "time": 14675.189, "timestamp": "04:04:35", "text": "这里经历了一场汽车角色扮演"}, {"type": "subtitle", "time": 14677.99, "timestamp": "04:04:37", "text": "弧。是的。所以基本上我们有一些"}, {"type": "subtitle", "time": 14682.07, "timestamp": "04:04:42", "text": "呃，我被卷入了一些戏剧性事件。"}, {"type": "subtitle", "time": 14684.389, "timestamp": "04:04:44", "text": "关于过去的事情等等。如果你"}, {"type": "subtitle", "time": 14686.87, "timestamp": "04:04:46", "text": "想知道它是什么以及它是什么"}, {"type": "subtitle", "time": 14689.429, "timestamp": "04:04:49", "text": "事情真的发生了，这是我这边的叙述。"}, {"type": "subtitle", "time": 14692.229, "timestamp": "04:04:52", "text": "以及那东西的实际情况，我如何如何"}, {"type": "subtitle", "time": 14694.87, "timestamp": "04:04:54", "text": "一切都装裱好了。"}, {"type": "subtitle", "time": 14697.59, "timestamp": "04:04:57", "text": "我的 YouTube 频道上有一个视频"}, {"type": "subtitle", "time": 14699.99, "timestamp": "04:04:59", "text": "被称为深层真相。这是一台黑色的收音机。"}]
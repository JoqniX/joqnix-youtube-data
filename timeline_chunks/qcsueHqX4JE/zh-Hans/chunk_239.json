[{"type": "subtitle", "time": 14341.59, "timestamp": "03:59:01", "text": "如果我玩这个游戏，未来会怎样？在线观看。"}, {"type": "subtitle", "time": 14344.63, "timestamp": "03:59:04", "text": "你知道，我可以从 Riot 把你加进来。"}, {"type": "subtitle", "time": 14347.189, "timestamp": "03:59:07", "text": "Riot 手机应用，对吧？当我"}, {"type": "subtitle", "time": 14349.75, "timestamp": "03:59:09", "text": "安装 Valeran 时，当我执行 Valerin 操作时"}, {"type": "subtitle", "time": 14352.63, "timestamp": "03:59:12", "text": "直播的话，如果你还在的话我们可以一起玩。"}, {"type": "subtitle", "time": 14355.349, "timestamp": "03:59:15", "text": "玩那个游戏。当我直播时"}, {"type": "subtitle", "time": 14359.269, "timestamp": "03:59:19", "text": "东西。不。是的。是的。那段时间如果你"}, {"type": "subtitle", "time": 14361.11, "timestamp": "03:59:21", "text": "想。 [笑声]"}, {"type": "subtitle", "time": 14363.67, "timestamp": "03:59:23", "text": "如果你想要的就是"}, {"type": "subtitle", "time": 14370.389, "timestamp": "03:59:30", "text": "你好。我看了你的剧。真是如此"}, {"type": "subtitle", "time": 14373.189, "timestamp": "03:59:33", "text": "一件微不足道的事。 [笑声]"}, {"type": "subtitle", "time": 14375.189, "timestamp": "03:59:35", "text": "好像你唯一的罪过就是"}, {"type": "subtitle", "time": 14377.11, "timestamp": "03:59:37", "text": "那些信息让我感到尴尬"}, {"type": "subtitle", "time": 14379.03, "timestamp": "03:59:39", "text": "这让我感到二次尴尬。它"}, {"type": "subtitle", "time": 14380.79, "timestamp": "03:59:40", "text": "看起来像是一个简单明了的案例"}, {"type": "subtitle", "time": 14383.301, "timestamp": "03:59:43", "text": "诽谤，所以你可以起诉他们。"}, {"type": "subtitle", "time": 14385.429, "timestamp": "03:59:45", "text": "[音乐] 是的，"}, {"type": "subtitle", "time": 14387.91, "timestamp": "03:59:47", "text": "兄弟。说实话，现在如果我要说话的话"}, {"type": "subtitle", "time": 14392.469, "timestamp": "03:59:52", "text": "[叹气]"}]
[{"type": "subtitle", "time": 17827.51, "timestamp": "04:57:07", "text": "呃，如果他们想成为……想成为……"}, {"type": "subtitle", "time": 17830.708, "timestamp": "04:57:10", "text": "问题解决了，否则他们会努力"}, {"type": "subtitle", "time": 17834.23, "timestamp": "04:57:14", "text": "它只是在博取关注。 M 是真的。"}, {"type": "subtitle", "time": 17837.43, "timestamp": "04:57:17", "text": "所以，是的，我猜大多数人是这样的。"}, {"type": "subtitle", "time": 17840.47, "timestamp": "04:57:20", "text": "现在那些已经取消关注我的人。所以我可以"}, {"type": "subtitle", "time": 17844.07, "timestamp": "04:57:24", "text": "得到它。后来我才明白为什么。"}, {"type": "subtitle", "time": 17846.31, "timestamp": "04:57:26", "text": "大多数人选择不与他/她来往"}, {"type": "subtitle", "time": 17850.23, "timestamp": "04:57:30", "text": "我或者像取消好友之类的那样切断联系"}, {"type": "subtitle", "time": 17852.628, "timestamp": "04:57:32", "text": "她选择不公开与我交谈，"}, {"type": "subtitle", "time": 17855.43, "timestamp": "04:57:35", "text": "比如戏剧表演期间的那些事"}, {"type": "subtitle", "time": 17858.708, "timestamp": "04:57:38", "text": "对，因为呃，那些小玩意儿和小偷"}, {"type": "subtitle", "time": 17861.11, "timestamp": "04:57:41", "text": "对，那些东西我以前不知道。"}, {"type": "subtitle", "time": 17865.67, "timestamp": "04:57:45", "text": "其实我不知道，好吧。"}, {"type": "subtitle", "time": 17869.19, "timestamp": "04:57:49", "text": "除非他们中有人告诉我"}, {"type": "subtitle", "time": 17871.99, "timestamp": "04:57:51", "text": "所以，呃，我不想和他们做朋友。"}, {"type": "subtitle", "time": 17874.39, "timestamp": "04:57:54", "text": "被指控为猥亵者的人"}, {"type": "subtitle", "time": 17876.788, "timestamp": "04:57:56", "text": "某物。所以我就查了一下。"}]
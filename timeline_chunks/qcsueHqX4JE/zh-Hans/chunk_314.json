[{"type": "subtitle", "time": 18842.39, "timestamp": "05:14:02", "text": "因为他做了很多研究，也和很多人交谈过。"}, {"type": "subtitle", "time": 18845.19, "timestamp": "05:14:05", "text": "其他人都会发表他们的观点。"}, {"type": "subtitle", "time": 18846.868, "timestamp": "05:14:06", "text": "关于整个社区的事情"}, {"type": "subtitle", "time": 18849.11, "timestamp": "05:14:09", "text": "整个这个和那个"}, {"type": "subtitle", "time": 18853.67, "timestamp": "05:14:13", "text": "诸如此类的事情，他明白了。"}, {"type": "subtitle", "time": 18856.39, "timestamp": "05:14:16", "text": "社区的说法是对的，他们就是这样用的。"}, {"type": "subtitle", "time": 18859.03, "timestamp": "05:14:19", "text": "他们利用我的力量来扳倒其他人"}, {"type": "subtitle", "time": 18861.35, "timestamp": "05:14:21", "text": "人们普遍憎恨这一点，"}, {"type": "subtitle", "time": 18865.27, "timestamp": "05:14:25", "text": "那个权利"}, {"type": "subtitle", "time": 18867.11, "timestamp": "05:14:27", "text": "和"}, {"type": "subtitle", "time": 18870.948, "timestamp": "05:14:30", "text": "是的，而且他现在忙着接委托呢。"}, {"type": "subtitle", "time": 18874.55, "timestamp": "05:14:34", "text": "诸如此类，所以他就说，是的，他有。"}, {"type": "subtitle", "time": 18876.788, "timestamp": "05:14:36", "text": "已保存，但如果发生任何情况"}, {"type": "subtitle", "time": 18878.868, "timestamp": "05:14:38", "text": "未来他可能会直接发布，或者"}, {"type": "subtitle", "time": 18881.75, "timestamp": "05:14:41", "text": "虽然有点什么，但我感觉如果他有"}, {"type": "subtitle", "time": 18883.91, "timestamp": "05:14:43", "text": "第二部分视频已上传"}, {"type": "subtitle", "time": 18886.47, "timestamp": "05:14:46", "text": "更新视频后，就会打开……"}, {"type": "subtitle", "time": 18890.47, "timestamp": "05:14:50", "text": "是的，又一场闹剧开始了，但它也会继续下去。"}, {"type": "subtitle", "time": 18893.19, "timestamp": "05:14:53", "text": "有视频证据，有历史记录证据。"}, {"type": "subtitle", "time": 18897.83, "timestamp": "05:14:57", "text": "正确的？是的，这个地方确实充满戏剧性。"}]
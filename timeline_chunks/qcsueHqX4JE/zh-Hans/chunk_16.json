[{"type": "subtitle", "time": 962.79, "timestamp": "00:16:02", "text": "不，它叫做环境设计师。"}, {"type": "chat", "time": 963.729, "timestamp": "00:16:03", "author": "@mishereshu", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mc4Y9gQCEiemTFxftMBzkVs4f2dFVKIi2EzfEXVVougJ-byH1unVlcX4jadECPvzh2lg=s64-c-k-c0x00ffffff-no-rj", "message": "Its Environment designer, not graphic designer. their job i different"}, {"type": "subtitle", "time": 965.91, "timestamp": "00:16:05", "text": "呃，不是平面设计。平面设计"}, {"type": "subtitle", "time": 970.31, "timestamp": "00:16:10", "text": "就像徽标之类的东西，用户界面图标等等。"}, {"type": "subtitle", "time": 973.11, "timestamp": "00:16:13", "text": "东西。情况不一样。"}, {"type": "subtitle", "time": 975.509, "timestamp": "00:16:15", "text": "看平面设计师就像看……"}, {"type": "subtitle", "time": 977.99, "timestamp": "00:16:17", "text": "菜单图标"}, {"type": "subtitle", "time": 980.23, "timestamp": "00:16:20", "text": "这个和那个图标是图形"}, {"type": "chat", "time": 982.664, "timestamp": "00:16:22", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "I know"}, {"type": "subtitle", "time": 983.749, "timestamp": "00:16:23", "text": "设计或 UI/UX 人员"}, {"type": "subtitle", "time": 988.069, "timestamp": "00:16:28", "text": "呃，环境方面会是3D的，而且3D建模师也是。"}, {"type": "subtitle", "time": 991.11, "timestamp": "00:16:31", "text": "就像一般情况下你可以说的那样"}, {"type": "subtitle", "time": 995.829, "timestamp": "00:16:35", "text": "我猜是图形主题或者3D团队"}, {"type": "subtitle", "time": 1000.23, "timestamp": "00:16:40", "text": "当然，昨天我也磨了，我磨了。"}, {"type": "subtitle", "time": 1004.629, "timestamp": "00:16:44", "text": "我把整张地图都刷了个遍，所有的一切"}, {"type": "chat", "time": 1005.354, "timestamp": "00:16:45", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "in here all fucking say"}, {"type": "subtitle", "time": 1007.509
[{"type": "subtitle", "time": 13381.75, "timestamp": "03:43:01", "text": "就像所有这些一样，我想我已经有多久了。"}, {"type": "subtitle", "time": 13383.99, "timestamp": "03:43:03", "text": "我又开始看直播了，我都忘了，就像我"}, {"type": "subtitle", "time": 13388.15, "timestamp": "03:43:08", "text": "2019年开局不错，所以就上了YouTube。"}, {"type": "subtitle", "time": 13393.83, "timestamp": "03:43:13", "text": "2020年9月23日，所以是202，我想是5"}, {"type": "subtitle", "time": 13397.429, "timestamp": "03:43:17", "text": "五六年来我一直在直播"}, {"type": "subtitle", "time": 13399.51, "timestamp": "03:43:19", "text": "我听人说过他们跟我说过的话"}, {"type": "subtitle", "time": 13401.189, "timestamp": "03:43:21", "text": "那"}, {"type": "subtitle", "time": 13404.389, "timestamp": "03:43:24", "text": "嗯，他们告诉我我来自"}, {"type": "subtitle", "time": 13407.51, "timestamp": "03:43:27", "text": "我来自俄罗斯，我不是印度人。"}, {"type": "subtitle", "time": 13409.189, "timestamp": "03:43:29", "text": "你为何如此投入"}, {"type": "subtitle", "time": 13410.79, "timestamp": "03:43:30", "text": "不同的国家"}, {"type": "subtitle", "time": 13415.67, "timestamp": "03:43:35", "text": "他们会说出一些名字，我心想：天哪"}, {"type": "subtitle", "time": 13418.87, "timestamp": "03:43:38", "text": "真的有那么多吗？我甚至不知道我是否……"}, {"type": "subtitle", "time": 13429.59, "timestamp": "03:43:49", "text": "就像我开始直播的时候一样"}, {"type": "subtitle", "time": 13433.03, "timestamp": "03:43:53", "text": "我的英语真的很差"}, {"type": "subtitle", "time": 13435.429, "timestamp": "03:43:55", "text": "我可以，我是一个永远不会敞开心扉的人。"}, {"type": "subtitle", "time": 13438.15, "timestamp": "03:43:58", "text": "我的嘴巴有点儿……真的"}]
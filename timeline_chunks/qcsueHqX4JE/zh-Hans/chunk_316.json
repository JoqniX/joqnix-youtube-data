[{"type": "subtitle", "time": 18962.628, "timestamp": "05:16:02", "text": "我想大家都已经释怀了。"}, {"type": "subtitle", "time": 18966.55, "timestamp": "05:16:06", "text": "这段视频仅来自鸟类聚会。"}, {"type": "subtitle", "time": 18969.67, "timestamp": "05:16:09", "text": "关于这部剧"}, {"type": "subtitle", "time": 18972.31, "timestamp": "05:16:12", "text": "它可能像橙子一样，然后吐出来。"}, {"type": "subtitle", "time": 18974.628, "timestamp": "05:16:14", "text": "直播。不。"}, {"type": "subtitle", "time": 18976.868, "timestamp": "05:16:16", "text": "沉思，但语气非常消极。是的，"}, {"type": "subtitle", "time": 18980.15, "timestamp": "05:16:20", "text": "就是这样。"}, {"type": "subtitle", "time": 18987.59, "timestamp": "05:16:27", "text": "就是这样，伙计。哦，就像我"}, {"type": "subtitle", "time": 18990.708, "timestamp": "05:16:30", "text": "听说有些人试图把它送给"}, {"type": "subtitle", "time": 18993.75, "timestamp": "05:16:33", "text": "Reema、Paulidi，还有那些大牌 YouTuber"}, {"type": "subtitle", "time": 18997.67, "timestamp": "05:16:37", "text": "就是那些点评电视剧的博主，对吧？所以"}, {"type": "subtitle", "time": 18999.91, "timestamp": "05:16:39", "text": "他们试图把我的戏剧作品放到那里。然后"}, {"type": "subtitle", "time": 19002.31, "timestamp": "05:16:42", "text": "他们都会说：“是啊，是只小蜜蜂。”"}, {"type": "subtitle", "time": 19004.07, "timestamp": "05:16:44", "text": "戏剧。我们不想报道这件事，或者"}]
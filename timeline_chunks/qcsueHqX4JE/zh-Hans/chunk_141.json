[{"type": "subtitle", "time": 8461.19, "timestamp": "02:21:01", "text": "你的预算。是的，我得告诉我爸。"}, {"type": "subtitle", "time": 8463.27, "timestamp": "02:21:03", "text": "尽管。"}, {"type": "subtitle", "time": 8466.15, "timestamp": "02:21:06", "text": "所以现在的问题是"}, {"type": "subtitle", "time": 8469.429, "timestamp": "02:21:09", "text": "我必须告诉他们"}, {"type": "subtitle", "time": 8473.822, "timestamp": "02:21:13", "text": "呃，告诉他们，嗯，告诉我的家人，就像"}, {"type": "subtitle", "time": 8477.91, "timestamp": "02:21:17", "text": "[音乐] 我想要什么样的笔记本电脑？"}, {"type": "subtitle", "time": 8480.23, "timestamp": "02:21:20", "text": "呃，我得告诉我，所以要么"}, {"type": "subtitle", "time": 8483.429, "timestamp": "02:21:23", "text": "将成为日本呃研究所"}, {"type": "subtitle", "time": 8487.11, "timestamp": "02:21:27", "text": "在印度，他们说他们会这样做，因为"}, {"type": "subtitle", "time": 8490.469, "timestamp": "02:21:30", "text": "他们有自己的员工和人员"}, {"type": "chat", "time": 8490.988, "timestamp": "02:21:30", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "tell them it's for study 😅😅😂"}, {"type": "subtitle", "time": 8493.03, "timestamp": "02:21:33", "text": "呃，来自日本"}, {"type": "subtitle", "time": 8495.83, "timestamp": "02:21:35", "text": "印度，印度到日本正在上升"}, {"type": "subtitle", "time": 8498.87, "timestamp": "02:21:38", "text": "向下，对吧？所以他们可以，所以我给了"}, {"type": "subtitle", "time": 8500.55, "timestamp": "02:21:40", "text": "给他们钱，他们就会买。"}, {"type": "chat", "time": 8500.725, "timestamp": "02:21:40", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "it's important for study"}, {"type": "subtitle", "time": 8504.63, "timestamp": "02:21:44", "text": "给我一台笔记本电脑，然后把它给我。"}, {"type": "subtitle", "time": 8508.15, "timestamp": "02:21:48", "text": "正确的？这样我就可以在这里把一切都安排好了。"}, {"type": "subtitle", "time": 8511.03, "timestamp": "02:21:51", "text": "在我走之前。所以现在我的模型更容易了。"}, {"type": "subtitle", "time": 8519.349, "timestamp": "02:21:59", "text": "我把它们放在我的车载包里。啊，我的访客"}]
[{"type": "subtitle", "time": 11894.55, "timestamp": "03:18:14", "text": "唉，我得开始考虑一下了。"}, {"type": "subtitle", "time": 11910.71, "timestamp": "03:18:30", "text": "说实话，我不知道。呃，我好像做不到。"}, {"type": "subtitle", "time": 11913.922, "timestamp": "03:18:33", "text": "现在改变任何事情都为时尚早。"}, {"type": "subtitle", "time": 11915.11, "timestamp": "03:18:35", "text": "[笑声]"}, {"type": "subtitle", "time": 11917.75, "timestamp": "03:18:37", "text": "就像我们家已经付过款一样"}, {"type": "subtitle", "time": 11919.83, "timestamp": "03:18:39", "text": "为了"}, {"type": "subtitle", "time": 11922.15, "timestamp": "03:18:42", "text": "费用和其他东西"}, {"type": "subtitle", "time": 11924.63, "timestamp": "03:18:44", "text": "和"}, {"type": "subtitle", "time": 11929.429, "timestamp": "03:18:49", "text": "事情就是这样，我现在无法改变了。所以，我的一切"}, {"type": "subtitle", "time": 11931.51, "timestamp": "03:18:51", "text": "可以做的就是看看情况如何。这"}, {"type": "subtitle", "time": 11935.67, "timestamp": "03:18:55", "text": "如果语言表达清楚了，我就能理解了。"}, {"type": "subtitle", "time": 11938.15, "timestamp": "03:18:58", "text": "事情将会如何发展。"}]
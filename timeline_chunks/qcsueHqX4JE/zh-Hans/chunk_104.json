[{"type": "subtitle", "time": 6242.39, "timestamp": "01:44:02", "text": "控制应用程序的音频"}, {"type": "subtitle", "time": 6246.79, "timestamp": "01:44:06", "text": "取决于发送的流量是多少"}, {"type": "subtitle", "time": 6256.31, "timestamp": "01:44:16", "text": "呃，我的意思是，比如你看，举个例子"}, {"type": "subtitle", "time": 6261.109, "timestamp": "01:44:21", "text": "我正在听比赛的声音"}, {"type": "subtitle", "time": 6264.709, "timestamp": "01:44:24", "text": "我一边玩游戏一边听这个游戏。"}, {"type": "subtitle", "time": 6268.149, "timestamp": "01:44:28", "text": "嗯，就在我的耳机里"}, {"type": "subtitle", "time": 6271.51, "timestamp": "01:44:31", "text": "而且在直播中也能听到。"}, {"type": "subtitle", "time": 6273.27, "timestamp": "01:44:33", "text": "但"}, {"type": "subtitle", "time": 6275.189, "timestamp": "01:44:35", "text": "如果我"}, {"type": "subtitle", "time": 6277.51, "timestamp": "01:44:37", "text": "但我无力控制"}, {"type": "subtitle", "time": 6280.79, "timestamp": "01:44:40", "text": "除非我运行它。"}, {"type": "subtitle", "time": 6283.83, "timestamp": "01:44:43", "text": "通过虚拟电缆，这又……"}, {"type": "subtitle", "time": 6288.229, "timestamp": "01:44:48", "text": "延迟和卡顿很多，对吧？"}, {"type": "subtitle", "time": 6292.55, "timestamp": "01:44:52", "text": "所以我就想，我想要一种监控方式。"}, {"type": "subtitle", "time": 6294.87, "timestamp": "01:44:54", "text": "音频之类的。"}, {"type": "subtitle", "time": 6296.87, "timestamp": "01:44:56", "text": "你明白我的意思吗？"}]
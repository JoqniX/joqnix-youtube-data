[{"type": "subtitle", "time": 19260.948, "timestamp": "05:21:00", "text": "我感觉如果我完全"}, {"type": "subtitle", "time": 19268.868, "timestamp": "05:21:08", "text": "呃，独自一人，独自一人，"}, {"type": "subtitle", "time": 19271.19, "timestamp": "05:21:11", "text": "我会"}, {"type": "subtitle", "time": 19275.59, "timestamp": "05:21:15", "text": "我不知道我该如何表现。"}, {"type": "subtitle", "time": 19277.83, "timestamp": "05:21:17", "text": "因为这就像我从来没演过电视剧一样。"}, {"type": "subtitle", "time": 19281.91, "timestamp": "05:21:21", "text": "不，我甚至不知道该做什么事。"}, {"type": "subtitle", "time": 19284.23, "timestamp": "05:21:24", "text": "即使我经常浏览推特上的各种八卦，"}, {"type": "subtitle", "time": 19286.788, "timestamp": "05:21:26", "text": "这些东西，以及为了娱乐而喜欢的东西"}, {"type": "subtitle", "time": 19290.55, "timestamp": "05:21:30", "text": "或者在线观看这些 YouTuber 的剧集"}, {"type": "subtitle", "time": 19293.51, "timestamp": "05:21:33", "text": "电视剧、视频之类的东西，这样我就可以……"}, {"type": "subtitle", "time": 19296.708, "timestamp": "05:21:36", "text": "晚上睡觉是因为无聊。我不能"}, {"type": "subtitle", "time": 19298.39, "timestamp": "05:21:38", "text": "睡觉。所以我只是听着，保持沉默。"}, {"type": "subtitle", "time": 19300.23, "timestamp": "05:21:40", "text": "视频拍摄，甚至不知道是什么"}, {"type": "subtitle", "time": 19302.708, "timestamp": "05:21:42", "text": "情况真的恶化了。我实际上并不付钱。"}, {"type": "subtitle", "time": 19305.59, "timestamp": "05:21:45", "text": "注意这些事项。"}, {"type": "subtitle", "time": 19308.55, "timestamp": "05:21:48", "text": "当我陷入自己的麻烦事中时"}, {"type": "subtitle", "time": 19311.03, "timestamp": "05:21:51", "text": "我当时就想，"}, {"type": "subtitle", "time": 19318.07, "timestamp": "05:21:58", "text": "但是，很多人都跟我说过类似的话。"}]
[{"type": "subtitle", "time": 12001.349, "timestamp": "03:20:01", "text": "大概有6万"}, {"type": "subtitle", "time": 12005.269, "timestamp": "03:20:05", "text": "我想，大概是为了所有事情吧。"}, {"type": "subtitle", "time": 12009.91, "timestamp": "03:20:09", "text": "不，不，不。 N5课程30美元。好的。"}, {"type": "subtitle", "time": 12013.67, "timestamp": "03:20:13", "text": "还有30个，很多"}, {"type": "subtitle", "time": 12016.71, "timestamp": "03:20:16", "text": "文档以及所有这些东西"}, {"type": "subtitle", "time": 12019.19, "timestamp": "03:20:19", "text": "住宿方面，包括食物和"}, {"type": "subtitle", "time": 12020.79, "timestamp": "03:20:20", "text": "一切。"}, {"type": "subtitle", "time": 12031.99, "timestamp": "03:20:31", "text": "然后，总共有16个来自"}, {"type": "subtitle", "time": 12035.19, "timestamp": "03:20:35", "text": "来自印度的当地学院"}, {"type": "subtitle", "time": 12038.309, "timestamp": "03:20:38", "text": "他们会为你处理好一切。"}, {"type": "subtitle", "time": 12049.75, "timestamp": "03:20:49", "text": "是的"}, {"type": "subtitle", "time": 12052.389, "timestamp": "03:20:52", "text": "就像是“嘿，这东西太贵了”"}, {"type": "subtitle", "time": 12055.269, "timestamp": "03:20:55", "text": "其他地方也一样。我检查了每一个"}, {"type": "subtitle", "time": 12058.15, "timestamp": "03:20:58", "text": "其他呃本地"}]
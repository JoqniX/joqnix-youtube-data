[{"type": "subtitle", "time": 2882.71, "timestamp": "00:48:02", "text": "好的。呃"}, {"type": "subtitle", "time": 2884.309, "timestamp": "00:48:04", "text": "战斗"}, {"type": "subtitle", "time": 2887.51, "timestamp": "00:48:07", "text": "这。不，不，不。恶魔棺材。是的。"}, {"type": "subtitle", "time": 2892.23, "timestamp": "00:48:12", "text": "我们来看看它在哪里。好的。嗯"}, {"type": "subtitle", "time": 2899.19, "timestamp": "00:48:19", "text": "点燃。哪里可以买到引燃剂？"}, {"type": "subtitle", "time": 2902.87, "timestamp": "00:48:22", "text": "兄弟，我得从这儿接过来。哦。"}, {"type": "subtitle", "time": 2906.95, "timestamp": "00:48:26", "text": "哦，等等。我可以买。何何"}, {"type": "subtitle", "time": 2909.67, "timestamp": "00:48:29", "text": "全部完成了。我清空了所有"}, {"type": "subtitle", "time": 2911.75, "timestamp": "00:48:31", "text": "地图上的每一个角落，所以它是"}, {"type": "subtitle", "time": 2919.27, "timestamp": "00:48:39", "text": "我把那件事忘了。是的，"}, {"type": "subtitle", "time": 2932.71, "timestamp": "00:48:52", "text": "这个也卖光了。"}, {"type": "subtitle", "time": 2936.15, "timestamp": "00:48:56", "text": "为什么我还有一个？"}, {"type": "subtitle", "time": 2938.63, "timestamp": "00:48:58", "text": "好的，就是那个探索器之类的东西。我完成了"}]
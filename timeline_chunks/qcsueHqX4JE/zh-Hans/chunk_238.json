[{"type": "subtitle", "time": 14289.349, "timestamp": "03:58:09", "text": "好久不见了。不，一直以来都是"}, {"type": "subtitle", "time": 14292.95, "timestamp": "03:58:12", "text": "是吗？我相信"}, {"type": "subtitle", "time": 14295.59, "timestamp": "03:58:15", "text": "嗯"}, {"type": "subtitle", "time": 14300.309, "timestamp": "03:58:20", "text": "呃，你对我来说，在我之前……"}, {"type": "subtitle", "time": 14313.51, "timestamp": "03:58:33", "text": "是的。是的。是的。在我参加马拉松比赛之前"}, {"type": "subtitle", "time": 14317.83, "timestamp": "03:58:37", "text": "你来参加我的马拉松比赛的时候我正好路过。"}, {"type": "subtitle", "time": 14321.11, "timestamp": "03:58:41", "text": "我现在想起来了"}, {"type": "subtitle", "time": 14325.11, "timestamp": "03:58:45", "text": "我不知道，呃，你可以在Valerant里加我好友。"}, {"type": "subtitle", "time": 14327.51, "timestamp": "03:58:47", "text": "如果你想。"}, {"type": "subtitle", "time": 14332.469, "timestamp": "03:58:52", "text": "嗯，如果我玩的话，我会把它加进去的。"}, {"type": "subtitle", "time": 14336.07, "timestamp": "03:58:56", "text": "应该是 Jot Next Ox。"}, {"type": "subtitle", "time": 14338.55, "timestamp": "03:58:58", "text": "你可以随时添加我。我们可以玩"}]
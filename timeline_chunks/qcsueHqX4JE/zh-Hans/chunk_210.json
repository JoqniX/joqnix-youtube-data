[{"type": "subtitle", "time": 12600.07, "timestamp": "03:30:00", "text": "因为我想写这篇日记，所以就写了，因为我想写，因为UPI"}, {"type": "subtitle", "time": 12604.55, "timestamp": "03:30:04", "text": "为工作和我的账户开设一个活期账户"}, {"type": "subtitle", "time": 12607.11, "timestamp": "03:30:07", "text": "银行"}, {"type": "subtitle", "time": 12608.87, "timestamp": "03:30:08", "text": "要开立活期账户，您需要具备以下条件："}, {"type": "subtitle", "time": 12611.19, "timestamp": "03:30:11", "text": "个体经营者现已注册"}, {"type": "subtitle", "time": 12614.95, "timestamp": "03:30:14", "text": "商业。所以我不得不这么做。以便"}, {"type": "subtitle", "time": 12619.429, "timestamp": "03:30:19", "text": "如果有来自印度的人想要……"}, {"type": "subtitle", "time": 12623.349, "timestamp": "03:30:23", "text": "请直接向我的UPI账户捐款，他们"}, {"type": "subtitle", "time": 12626.07, "timestamp": "03:30:26", "text": "我不会泄露我的姓名之类的信息。所以"}, {"type": "subtitle", "time": 12628.309, "timestamp": "03:30:28", "text": "我不得不那样做。"}, {"type": "subtitle", "time": 12631.349, "timestamp": "03:30:31", "text": "而且显然我从其中一位那里听说了"}, {"type": "subtitle", "time": 12634.87, "timestamp": "03:30:34", "text": "像同班同学一样的学生"}, {"type": "subtitle", "time": 12638.309, "timestamp": "03:30:38", "text": "我要去的也是同一所学校。他们去了"}, {"type": "subtitle", "time": 12641.51, "timestamp": "03:30:41", "text": "继续这样"}, {"type": "subtitle", "time": 12645.349, "timestamp": "03:30:45", "text": "呃，他们去了，呃，他们去了……"}, {"type": "subtitle", "time": 12649.51, "timestamp": "03:30:49", "text": "今年四月，语言学校将在这里开课。"}, {"type": "subtitle", "time": 12651.349, "timestamp": "03:30:51", "text": "是的，我应该在七月份。"}, {"type": "subtitle", "time": 12654.95, "timestamp": "03:30:54", "text": "今年的这批货，但是"}, {"type": "subtitle", "time": 12657.51, "timestamp": "03:30:57", "text": "有些事情发生了，比如延迟。"}]
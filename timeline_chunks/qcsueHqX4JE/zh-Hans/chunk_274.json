[{"type": "subtitle", "time": 16444.789, "timestamp": "04:34:04", "text": "所以我就想，我不想……"}, {"type": "subtitle", "time": 16451.83, "timestamp": "04:34:11", "text": "类似巴士的佣金"}, {"type": "subtitle", "time": 16456.15, "timestamp": "04:34:16", "text": "佣金，就像任何事情一样，实际上"}, {"type": "subtitle", "time": 16458.551, "timestamp": "04:34:18", "text": "我甚至想过委托别人来做这件事。"}, {"type": "subtitle", "time": 16461.51, "timestamp": "04:34:21", "text": "佣金就像……嗯，开业"}, {"type": "subtitle", "time": 16463.349, "timestamp": "04:34:23", "text": "佣金，例如搭建 Discord 服务器"}, {"type": "subtitle", "time": 16465.349, "timestamp": "04:34:25", "text": "服务器之类的东西，因为我以前做过那些。"}, {"type": "subtitle", "time": 16467.83, "timestamp": "04:34:27", "text": "这对所有这些印度YouTube博主来说都很好。"}, {"type": "subtitle", "time": 16471.029, "timestamp": "04:34:31", "text": "英语甚至企业"}, {"type": "subtitle", "time": 16473.189, "timestamp": "04:34:33", "text": "等等"}, {"type": "subtitle", "time": 16475.75, "timestamp": "04:34:35", "text": "呃，尸体之类的。"}, {"type": "subtitle", "time": 16479.029, "timestamp": "04:34:39", "text": "我以前免费做过这件事。"}, {"type": "subtitle", "time": 16481.349, "timestamp": "04:34:41", "text": "以及技术支持方面的内容"}, {"type": "subtitle", "time": 16482.869, "timestamp": "04:34:42", "text": "自由的。"}, {"type": "subtitle", "time": 16487.59, "timestamp": "04:34:47", "text": "所以我变成了这样……"}, {"type": "subtitle", "time": 16489.51, "timestamp": "04:34:49", "text": "嗯，是的，我变成了这样的人[笑声]"}, {"type": "subtitle", "time": 16491.769, "timestamp": "04:34:51", "text": "曾经有人搭建过Discord服务器"}, {"type": "subtitle", "time": 16496.15, "timestamp": "04:34:56", "text": "[倒吸一口凉气] 2021年YouTube用户又回来了"}, {"type": "subtitle", "time": 16499.029, "timestamp": "04:34:59", "text": "然后我就筋疲力尽了，老实说，"}]
[{"type": "subtitle", "time": 11222.23, "timestamp": "03:07:02", "text": "我攻读了三年英国文学学士学位。"}, {"type": "subtitle", "time": 11225.11, "timestamp": "03:07:05", "text": "在印度待了那么几年，就那样了。"}, {"type": "subtitle", "time": 11228.469, "timestamp": "03:07:08", "text": "除此之外，没有别的意思，只是如果我想找到工作的话。"}, {"type": "subtitle", "time": 11231.03, "timestamp": "03:07:11", "text": "在日本，我想要的一切"}, {"type": "subtitle", "time": 11233.59, "timestamp": "03:07:13", "text": "与日本人的价值"}, {"type": "subtitle", "time": 11237.269, "timestamp": "03:07:17", "text": "呃，学位证书等等"}, {"type": "subtitle", "time": 11242.55, "timestamp": "03:07:22", "text": "一般为四年制课程。等待，"}, {"type": "subtitle", "time": 11249.269, "timestamp": "03:07:29", "text": "是的，他们通常只是为了让你……"}, {"type": "subtitle", "time": 11253.99, "timestamp": "03:07:33", "text": "把你的食物放进去。是的，"}, {"type": "subtitle", "time": 11255.59, "timestamp": "03:07:35", "text": "男人。我觉得我不应该"}, {"type": "subtitle", "time": 11263.429, "timestamp": "03:07:43", "text": "哦。哦，是的。他们将被替换。"}, {"type": "subtitle", "time": 11266.309, "timestamp": "03:07:46", "text": "由人工智能驱动。没错，没错，没错，没错。下一个"}, {"type": "subtitle", "time": 11271.67, "timestamp": "03:07:51", "text": "这个月我要考试。好的。我迟到了。"}, {"type": "subtitle", "time": 11275.429, "timestamp": "03:07:55", "text": "因为那场愚蠢的闹剧，我当时"}, {"type": "subtitle", "time": 11278.55, "timestamp": "03:07:58", "text": "被拖入。我当时真是太"}]
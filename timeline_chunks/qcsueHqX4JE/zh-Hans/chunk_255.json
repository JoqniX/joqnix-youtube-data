[{"type": "subtitle", "time": 15300.95, "timestamp": "04:15:00", "text": "东西。更多更多。再次感谢您"}, {"type": "subtitle", "time": 15304.55, "timestamp": "04:15:04", "text": "路过。此刻前来意义非凡。"}, {"type": "subtitle", "time": 15320.389, "timestamp": "04:15:20", "text": "好的。糟糕。是的。是的。有这么一件事"}, {"type": "subtitle", "time": 15325.03, "timestamp": "04:15:25", "text": "印度网红呃，我发现呃，谁得到了"}, {"type": "subtitle", "time": 15326.95, "timestamp": "04:15:26", "text": "搭档踢球。他们就像……"}, {"type": "subtitle", "time": 15329.189, "timestamp": "04:15:29", "text": "最早一批获得合伙人资格的人之一"}, {"type": "subtitle", "time": 15331.83, "timestamp": "04:15:31", "text": "印度 YouTuber 将获得合作机会"}, {"type": "subtitle", "time": 15335.91, "timestamp": "04:15:35", "text": "踢。嗯，我不知道他们是否考虑过。"}, {"type": "subtitle", "time": 15337.67, "timestamp": "04:15:37", "text": "我们不再是朋友了。我没有"}, {"type": "subtitle", "time": 15340.309, "timestamp": "04:15:40", "text": "和他们互动过，一直都……"}, {"type": "subtitle", "time": 15342.389, "timestamp": "04:15:42", "text": "自从。"}, {"type": "subtitle", "time": 15344.229, "timestamp": "04:15:44", "text": "呃"}, {"type": "subtitle", "time": 15349.99, "timestamp": "04:15:49", "text": "但是，呃，他们也告诉我……"}, {"type": "subtitle", "time": 15354.149, "timestamp": "04:15:54", "text": "他们还告诉我，最好是……"}, {"type": "subtitle", "time": 15357.51, "timestamp": "04:15:57", "text": "关闭跟随者"}]
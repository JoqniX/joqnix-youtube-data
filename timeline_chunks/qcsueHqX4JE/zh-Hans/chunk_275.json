[{"type": "subtitle", "time": 16501.51, "timestamp": "04:35:01", "text": "严重倦怠。"}, {"type": "subtitle", "time": 16503.269, "timestamp": "04:35:03", "text": "我心想，我不想做这件事。"}, {"type": "subtitle", "time": 16504.949, "timestamp": "04:35:04", "text": "不再是了。"}, {"type": "subtitle", "time": 16508.31, "timestamp": "04:35:08", "text": "但我想，如果我能做到这一点的话"}, {"type": "subtitle", "time": 16510.39, "timestamp": "04:35:10", "text": "如果能拿到工资，那是一回事。"}, {"type": "subtitle", "time": 16512.709, "timestamp": "04:35:12", "text": "我还想做另一件事，那就是喜欢音乐。"}, {"type": "subtitle", "time": 16515.349, "timestamp": "04:35:15", "text": "我只能接受音乐委托创作。"}, {"type": "subtitle", "time": 16519.429, "timestamp": "04:35:19", "text": "一旦我达到能够……的水平"}, {"type": "subtitle", "time": 16522.551, "timestamp": "04:35:22", "text": "创作优秀的音乐。"}, {"type": "subtitle", "time": 16524.869, "timestamp": "04:35:24", "text": "是的。"}, {"type": "subtitle", "time": 16527.269, "timestamp": "04:35:27", "text": "然后又一个。"}, {"type": "subtitle", "time": 16529.75, "timestamp": "04:35:29", "text": "我不知道我在哪里，我到底在哪儿？"}, {"type": "subtitle", "time": 16537.189, "timestamp": "04:35:37", "text": "我甚至不知道自己有哪些技能。"}, {"type": "subtitle", "time": 16539.109, "timestamp": "04:35:39", "text": "视频剪辑相关内容。是的，我以前"}, {"type": "subtitle", "time": 16546.551, "timestamp": "04:35:46", "text": "呃，我以前为这个团队剪辑播客。"}, {"type": "subtitle", "time": 16553.109, "timestamp": "04:35:53", "text": "我当时在玩虚拟现实游戏"}, {"type": "subtitle", "time": 16555.109, "timestamp": "04:35:55", "text": "和"}, {"type": "subtitle", "time": 16557.269, "timestamp": "04:35:57", "text": "但"}]
[{"type": "subtitle", "time": 11281.429, "timestamp": "03:08:01", "text": "为此紧张了整整一段时间"}, {"type": "subtitle", "time": 11284.55, "timestamp": "03:08:04", "text": "九月。我当时超级喜欢"}, {"type": "subtitle", "time": 11287.11, "timestamp": "03:08:07", "text": "到处跑，找律师什么的"}, {"type": "subtitle", "time": 11290.55, "timestamp": "03:08:10", "text": "这些东西。呃，把呃当作呃"}, {"type": "subtitle", "time": 11293.51, "timestamp": "03:08:13", "text": "休息的时候，我把所有事情都抛在脑后。"}, {"type": "subtitle", "time": 11298.15, "timestamp": "03:08:18", "text": "就是那东西，对吧？我错过了我的igno"}, {"type": "subtitle", "time": 11301.429, "timestamp": "03:08:21", "text": "注册之类的东西。"}, {"type": "subtitle", "time": 11303.91, "timestamp": "03:08:23", "text": "就像平时注册时一样"}, {"type": "subtitle", "time": 11307.11, "timestamp": "03:08:27", "text": "打开"}, {"type": "subtitle", "time": 11310.23, "timestamp": "03:08:30", "text": "嗯，打开后，我会注册"}, {"type": "subtitle", "time": 11312.79, "timestamp": "03:08:32", "text": "我得马上过去，这样我才能到附近。"}, {"type": "subtitle", "time": 11317.11, "timestamp": "03:08:37", "text": "在考试区域附近有考试中心。"}, {"type": "subtitle", "time": 11319.19, "timestamp": "03:08:39", "text": "所以我只需要走个15分钟左右或者"}, {"type": "subtitle", "time": 11321.19, "timestamp": "03:08:41", "text": "距离考场还有10分钟。全部"}, {"type": "subtitle", "time": 11324.79, "timestamp": "03:08:44", "text": "正确的。但这次我迟到了。我"}, {"type": "subtitle", "time": 11327.51, "timestamp": "03:08:47", "text": "必须在十月份登记。"}, {"type": "subtitle", "time": 11332.389, "timestamp": "03:08:52", "text": "最后期限的前一天和"}, {"type": "subtitle", "time": 11334.469, "timestamp": "03:08:54", "text": "最后期限的前一天。所以我有"}, {"type": "subtitle", "time": 11337.03, "timestamp": "03:08:57", "text": "去"}]
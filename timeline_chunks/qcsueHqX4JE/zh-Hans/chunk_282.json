[{"type": "subtitle", "time": 16921.11, "timestamp": "04:42:01", "text": "我甚至不知道他们是谁。"}, {"type": "subtitle", "time": 16923.99, "timestamp": "04:42:03", "text": "个人信息，包括姓名、地址等。"}, {"type": "subtitle", "time": 16926.15, "timestamp": "04:42:06", "text": "他们是谁等等。我只认识他们"}, {"type": "subtitle", "time": 16929.19, "timestamp": "04:42:09", "text": "通过他们的在线用户名在线访问。他是"}, {"type": "subtitle", "time": 16932.628, "timestamp": "04:42:12", "text": "我当时非常怀疑，而且确实花了很长时间。"}, {"type": "subtitle", "time": 16935.99, "timestamp": "04:42:15", "text": "整个过程"}, {"type": "subtitle", "time": 16939.19, "timestamp": "04:42:19", "text": "就像那样"}, {"type": "subtitle", "time": 16942.628, "timestamp": "04:42:22", "text": "虽然很难，但我最终还是说服了对方。"}, {"type": "subtitle", "time": 16947.19, "timestamp": "04:42:27", "text": "他见了他们的家人，我们俩都见了面。"}, {"type": "subtitle", "time": 16949.43, "timestamp": "04:42:29", "text": "我们两家人见面等等。我们"}, {"type": "subtitle", "time": 16952.788, "timestamp": "04:42:32", "text": "聊了一会儿，然后我们就去了火车站。"}, {"type": "subtitle", "time": 16956.788, "timestamp": "04:42:36", "text": "到了浦那，我们遇到了让我……的人"}, {"type": "subtitle", "time": 16959.51, "timestamp": "04:42:39", "text": "在他们的家中，他们的家人，他们允许"}, {"type": "subtitle", "time": 16968.708, "timestamp": "04:42:48", "text": "所以，是的，我爸当时就说，好吧，当我"}, {"type": "subtitle", "time": 16971.27, "timestamp": "04:42:51", "text": "我告诉他们，当我给他们看的时候"}, {"type": "subtitle", "time": 16973.91, "timestamp": "04:42:53", "text": "现在那些人的评论，我的"}, {"type": "subtitle", "time": 16976.948, "timestamp": "04:42:56", "text": "爸爸说：“我早就跟你说过。”永远不要相信"}]
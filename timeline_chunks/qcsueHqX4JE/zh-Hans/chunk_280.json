[{"type": "subtitle", "time": 16800.07, "timestamp": "04:40:00", "text": "所以"}, {"type": "subtitle", "time": 16802.55, "timestamp": "04:40:02", "text": "是的，在那里找到了远程照片。"}, {"type": "subtitle", "time": 16805.27, "timestamp": "04:40:05", "text": "对OP包来说不错。"}, {"type": "subtitle", "time": 16807.51, "timestamp": "04:40:07", "text": "所以如果你不养狗，那就什么都不会发生。"}, {"type": "subtitle", "time": 16809.19, "timestamp": "04:40:09", "text": "发生"}, {"type": "subtitle", "time": 16820.868, "timestamp": "04:40:20", "text": "天知道是谁，呃，天知道什么时候"}, {"type": "subtitle", "time": 16823.59, "timestamp": "04:40:23", "text": "拥有我照片的人实际上会"}, {"type": "subtitle", "time": 16826.15, "timestamp": "04:40:26", "text": "把它交给那些会人肉搜索的人"}, {"type": "subtitle", "time": 16828.948, "timestamp": "04:40:28", "text": "我或者别的什么人。不要人肉搜索我，我会上传"}, {"type": "subtitle", "time": 16832.07, "timestamp": "04:40:32", "text": "把它放到公共网站或其他什么地方。"}, {"type": "subtitle", "time": 16835.59, "timestamp": "04:40:35", "text": "我不知道。是的，"}, {"type": "subtitle", "time": 16838.23, "timestamp": "04:40:38", "text": "嗯，如果我要谈论管理的话。"}, {"type": "subtitle", "time": 16842.47, "timestamp": "04:40:42", "text": "就是那个东西，对吧？"}, {"type": "subtitle", "time": 16845.19, "timestamp": "04:40:45", "text": "嗯，我的意思是，他们当时已经在评论了。"}, {"type": "subtitle", "time": 16848.948, "timestamp": "04:40:48", "text": "关于。是的。是的。是的。"}, {"type": "subtitle", "time": 16858.948, "timestamp": "04:40:58", "text": "哦，是的。如果我要谈论……"}]
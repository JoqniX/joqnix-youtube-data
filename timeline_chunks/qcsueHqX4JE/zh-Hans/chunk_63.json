[{"type": "subtitle", "time": 3785.589, "timestamp": "01:03:05", "text": "我被锁住了。我被锁住了。我被锁住了。"}, {"type": "subtitle", "time": 3816.23, "timestamp": "01:03:36", "text": "不会吧，又来了。所以如果60级有三个"}, {"type": "subtitle", "time": 3819.349, "timestamp": "01:03:39", "text": "正义宣言之类的东西"}, {"type": "subtitle", "time": 3821.029, "timestamp": "01:03:41", "text": "最终的"}, {"type": "subtitle", "time": 3825.51, "timestamp": "01:03:45", "text": "从她当时的70级开始，将会有"}, {"type": "subtitle", "time": 3827.75, "timestamp": "01:03:47", "text": "四五个"}, {"type": "subtitle", "time": 3831.27, "timestamp": "01:03:51", "text": "这取决于你能排出多少水。"}]
[{"type": "subtitle", "time": 8762.15, "timestamp": "02:26:02", "text": "找公寓或者类似支付之类的"}, {"type": "subtitle", "time": 8764.55, "timestamp": "02:26:04", "text": "房租之类的东西，就像你看到的那样。"}, {"type": "subtitle", "time": 8769.429, "timestamp": "02:26:09", "text": "动漫之类的。我必须这么做。"}, {"type": "subtitle", "time": 8775.429, "timestamp": "02:26:15", "text": "嗯"}, {"type": "subtitle", "time": 8777.03, "timestamp": "02:26:17", "text": "我无法告诉你我不能这么做的原因。"}, {"type": "subtitle", "time": 8780.23, "timestamp": "02:26:20", "text": "看看会发生什么，一切都是开放的，而我当时"}, {"type": "subtitle", "time": 8790.469, "timestamp": "02:26:30", "text": "他们有做小型太阳能的吗？是的，"}, {"type": "subtitle", "time": 8793.03, "timestamp": "02:26:33", "text": "确实如此。但我无法观看视频。不，想想"}, {"type": "subtitle", "time": 8797.19, "timestamp": "02:26:37", "text": "关于我的案子。我将无法进行流媒体播放。"}, {"type": "subtitle", "time": 8801.83, "timestamp": "02:26:41", "text": "就像在我自己​​的地方一样。我可以尖叫，"}, {"type": "subtitle", "time": 8804.55, "timestamp": "02:26:44", "text": "哭一场，然后做任何我想做的事，对吧？不"}, {"type": "subtitle", "time": 8807.349, "timestamp": "02:26:47", "text": "任何人的噪音投诉等等。"}, {"type": "subtitle", "time": 8809.67, "timestamp": "02:26:49", "text": "但在日本等地，他们会有"}, {"type": "subtitle", "time": 8813.19, "timestamp": "02:26:53", "text": "就是噪音投诉那件事。"}, {"type": "subtitle", "time": 8818.309, "timestamp": "02:26:58", "text": "虽然日本也会有噪音。"}]
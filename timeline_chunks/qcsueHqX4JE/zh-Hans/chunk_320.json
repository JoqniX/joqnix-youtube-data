[{"type": "subtitle", "time": 19205.27, "timestamp": "05:20:05", "text": "换个角度来说我的话等等，"}, {"type": "subtitle", "time": 19209.27, "timestamp": "05:20:09", "text": "所有那些东西。”他还给了我"}, {"type": "subtitle", "time": 19214.31, "timestamp": "05:20:14", "text": "关于道歉的本质。"}, {"type": "subtitle", "time": 19216.708, "timestamp": "05:20:16", "text": "道歉就如同承认有罪。这"}, {"type": "subtitle", "time": 19229.51, "timestamp": "05:20:29", "text": "当我和橙酒交谈时"}, {"type": "subtitle", "time": 19231.91, "timestamp": "05:20:31", "text": "还有很多其他的事情，他们让我明白了很多。"}, {"type": "subtitle", "time": 19240.55, "timestamp": "05:20:40", "text": "我仍然心存感激。至少我的意思是"}, {"type": "subtitle", "time": 19243.51, "timestamp": "05:20:43", "text": "某种程度上，我当时处在这样的境地："}, {"type": "subtitle", "time": 19247.03, "timestamp": "05:20:47", "text": "我不是……我不是……我该怎么说呢？"}, {"type": "subtitle", "time": 19248.948, "timestamp": "05:20:48", "text": "在某种程度上，我当时处在这样的境地："}, {"type": "subtitle", "time": 19251.27, "timestamp": "05:20:51", "text": "谁都不能相信。但是，我"}, {"type": "subtitle", "time": 19253.83, "timestamp": "05:20:53", "text": "选择信任他人。"}, {"type": "subtitle", "time": 19258.15, "timestamp": "05:20:58", "text": "那本身就是一个严重的错误。但是，"}]
[{"type": "subtitle", "time": 9780.79, "timestamp": "02:43:00", "text": "啊，这家伙身上有股臭味什么的。"}, {"type": "subtitle", "time": 9783.59, "timestamp": "02:43:03", "text": "和"}, {"type": "subtitle", "time": 9785.75, "timestamp": "02:43:05", "text": "一个美国人看着他，好像在说："}, {"type": "subtitle", "time": 9788.07, "timestamp": "02:43:08", "text": "这到底是怎么回事"}, {"type": "subtitle", "time": 9791.67, "timestamp": "02:43:11", "text": "而那位上班族则表示，我尊重所有人。"}, {"type": "subtitle", "time": 9794.55, "timestamp": "02:43:14", "text": "都是外国人或者其他什么东西，我就想，"}, {"type": "subtitle", "time": 9796.23, "timestamp": "02:43:16", "text": "“哇，"}, {"type": "subtitle", "time": 9799.11, "timestamp": "02:43:19", "text": "我现在就要接受治疗。"}, {"type": "subtitle", "time": 9803.429, "timestamp": "02:43:23", "text": "“有些事。”我不知道。这要看情况。"}, {"type": "subtitle", "time": 9805.83, "timestamp": "02:43:25", "text": "因为"}, {"type": "subtitle", "time": 9807.83, "timestamp": "02:43:27", "text": "感觉如果我在……会好得多"}, {"type": "subtitle", "time": 9811.19, "timestamp": "02:43:31", "text": "和一群人在一起比独自一人要好。所以，"}, {"type": "subtitle", "time": 9813.27, "timestamp": "02:43:33", "text": "我想这样我可能会更安全一些。我"}, {"type": "subtitle", "time": 9821.429, "timestamp": "02:43:41", "text": "他想要孩子，但是介于"}, {"type": "subtitle", "time": 9823.03, "timestamp": "02:43:43", "text": "日本的工作文化以及以下事实"}, {"type": "subtitle", "time": 9825.103, "timestamp": "02:43:45", "text": "他工资真的很低，这很常见。"}, {"type": "subtitle", "time": 9827.429, "timestamp": "02:43:47", "text": "日本的音乐行业，付费技能，呃，"}, {"type": "subtitle", "time": 9829.75, "timestamp": "02:43:49", "text": "薪资技能太差了。他负担不起"}, {"type": "subtitle", "time": 9833.03, "timestamp": "02:43:53", "text": "有一个。哦，别把你的生活建立在……之上"}, {"type": "subtitle", "time": 9835.83, "timestamp": "02:43:55", "text": "关于动漫的决定。 [笑声]"}, {"type": "subtitle", "time": 9838.309, "timestamp": "02:43:58", "text": "是的。"}]
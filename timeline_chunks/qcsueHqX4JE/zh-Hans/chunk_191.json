[{"type": "subtitle", "time": 11460.07, "timestamp": "03:11:00", "text": "年龄范围也包括在内。然后结束"}, {"type": "subtitle", "time": 11463.349, "timestamp": "03:11:03", "text": "我记得我当时就是在那段时间做这些直播的。"}, {"type": "subtitle", "time": 11465.03, "timestamp": "03:11:05", "text": "这次我究竟经历了什么？"}, {"type": "subtitle", "time": 11468.71, "timestamp": "03:11:08", "text": "在其他方面进行实验"}, {"type": "subtitle", "time": 11470.309, "timestamp": "03:11:10", "text": "印度"}, {"type": "subtitle", "time": 11473.59, "timestamp": "03:11:13", "text": "呃，就像 plat 视频平台，比如 mod"}, {"type": "subtitle", "time": 11475.67, "timestamp": "03:11:15", "text": "现场直播之类的。"}, {"type": "subtitle", "time": 11479.03, "timestamp": "03:11:19", "text": "所以由此可见"}, {"type": "subtitle", "time": 11482.309, "timestamp": "03:11:22", "text": "我其实挺喜欢动物直播的。所以"}, {"type": "subtitle", "time": 11486.469, "timestamp": "03:11:26", "text": "从那以后，我在某种程度上，我过去常常"}, {"type": "subtitle", "time": 11489.349, "timestamp": "03:11:29", "text": "不要告诉任何人"}, {"type": "subtitle", "time": 11491.429, "timestamp": "03:11:31", "text": "我来自哪里，或者我的第一个是什么"}, {"type": "subtitle", "time": 11494.63, "timestamp": "03:11:34", "text": "语言之类的东西，然后我就觉得好吧。"}, {"type": "subtitle", "time": 11496.87, "timestamp": "03:11:36", "text": "我大概会说出来，或者说，或者说我"}, {"type": "subtitle", "time": 11499.51, "timestamp": "03:11:39", "text": "了解这门语言"}, {"type": "subtitle", "time": 11502.389, "timestamp": "03:11:42", "text": "从那以后，我就一直保持着这种状态。"}, {"type": "subtitle", "time": 11511.75, "timestamp": "03:11:51", "text": "因为那样的话，你会感觉很奇怪。"}, {"type": "subtitle", "time": 11513.59, "timestamp": "03:11:53", "text": "哦，好的。这家伙是个印度计量员，"}, {"type": "subtitle", "time": 11516.469, "timestamp": "03:11:56", "text": "但他不懂印地语。[笑声]"}, {"type": "subtitle", "time": 11519.11, "timestamp": "03:11:59", "text": "我可以这样说："}]
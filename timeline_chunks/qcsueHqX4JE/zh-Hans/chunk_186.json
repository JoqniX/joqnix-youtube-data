[{"type": "subtitle", "time": 11162.55, "timestamp": "03:06:02", "text": "日本如果获得该认证将会怎样？"}, {"type": "subtitle", "time": 11164.309, "timestamp": "03:06:04", "text": "喜欢"}, {"type": "subtitle", "time": 11168.07, "timestamp": "03:06:08", "text": "翻译员之类的"}, {"type": "subtitle", "time": 11171.11, "timestamp": "03:06:11", "text": "这就是为什么感觉喜欢"}, {"type": "subtitle", "time": 11174.87, "timestamp": "03:06:14", "text": "嗯，因为它只是三年的合同，所以……"}, {"type": "subtitle", "time": 11178.63, "timestamp": "03:06:18", "text": "IGN 现在是 IGNU，大概有四年了，但是"}, {"type": "subtitle", "time": 11181.03, "timestamp": "03:06:21", "text": "嗯，还在大三那会儿呢。"}, {"type": "subtitle", "time": 11183.349, "timestamp": "03:06:23", "text": "就像以前那样"}, {"type": "subtitle", "time": 11185.269, "timestamp": "03:06:25", "text": "我不知道是否有第四年，或者"}, {"type": "subtitle", "time": 11188.309, "timestamp": "03:06:28", "text": "有点什么，但总之就是这样。"}, {"type": "subtitle", "time": 11199.19, "timestamp": "03:06:39", "text": "所以它是怎么做到的？"}, {"type": "subtitle", "time": 11204.23, "timestamp": "03:06:44", "text": "所以他说，那个igno东西"}, {"type": "subtitle", "time": 11208.87, "timestamp": "03:06:48", "text": "只能像证书一样。不会"}, {"type": "subtitle", "time": 11212.71, "timestamp": "03:06:52", "text": "在日本，这很重要，就像在我的世界里一样。"}, {"type": "subtitle", "time": 11216.15, "timestamp": "03:06:56", "text": "现在我可以像这样展示我的作品集了：呃，我"}, {"type": "subtitle", "time": 11219.99, "timestamp": "03:06:59", "text": "已获得英语文学学士学位"}]
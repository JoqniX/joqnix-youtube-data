[{"type": "subtitle", "time": 9545.03, "timestamp": "02:39:05", "text": "啊，确实如此。他们永远不会见到你"}, {"type": "subtitle", "time": 9554.389, "timestamp": "02:39:14", "text": "是的。"}, {"type": "subtitle", "time": 9558.71, "timestamp": "02:39:18", "text": "我想我会怀念印度人的那种感觉。"}, {"type": "subtitle", "time": 9561.83, "timestamp": "02:39:21", "text": "就像我们所有家庭都友好一样。"}, {"type": "subtitle", "time": 9564.79, "timestamp": "02:39:24", "text": "就像我们一样，我们互相帮助所有这些"}, {"type": "subtitle", "time": 9567.03, "timestamp": "02:39:27", "text": "东西对，而且即使是这样也行"}, {"type": "subtitle", "time": 9570.71, "timestamp": "02:39:30", "text": "工作场所里，我们也互相尊重。"}, {"type": "subtitle", "time": 9573.91, "timestamp": "02:39:33", "text": "其他人的角色以及把事情做好，并且"}, {"type": "subtitle", "time": 9582.07, "timestamp": "02:39:42", "text": "或许我还没看到它的阴暗面。"}, {"type": "subtitle", "time": 9584.15, "timestamp": "02:39:44", "text": "但仍然"}, {"type": "subtitle", "time": 9597.51, "timestamp": "02:39:57", "text": "我认识一个五年前搬到那里的人。"}]
[{"type": "subtitle", "time": 19320.39, "timestamp": "05:22:00", "text": "在那场风波之后，当他们与……交谈时"}, {"type": "subtitle", "time": 19322.15, "timestamp": "05:22:02", "text": "很多人告诉我，你可以"}, {"type": "subtitle", "time": 19325.43, "timestamp": "05:22:05", "text": "变得超级激进"}, {"type": "subtitle", "time": 19327.43, "timestamp": "05:22:07", "text": "还有一些其他的东西。"}, {"type": "subtitle", "time": 19338.47, "timestamp": "05:22:18", "text": "是的，就我目前的情况而言，如果我有合法权利"}, {"type": "subtitle", "time": 19341.67, "timestamp": "05:22:21", "text": "案件仍在进行中，这将影响我的出行。"}, {"type": "subtitle", "time": 19344.628, "timestamp": "05:22:24", "text": "去日本。我当时很害怕，因为"}, {"type": "subtitle", "time": 19348.23, "timestamp": "05:22:28", "text": "一个案子可能会持续数月、数周，甚至更久。"}, {"type": "subtitle", "time": 19350.39, "timestamp": "05:22:30", "text": "年。现在，"}, {"type": "subtitle", "time": 19352.15, "timestamp": "05:22:32", "text": "这就是我所担心的，我一直都很担心。"}, {"type": "subtitle", "time": 19358.628, "timestamp": "05:22:38", "text": "而我，我没有地址。"}, {"type": "subtitle", "time": 19362.15, "timestamp": "05:22:42", "text": "几乎所有这些"}, {"type": "subtitle", "time": 19364.632, "timestamp": "05:22:44", "text": "YouTube 用户。"}, {"type": "subtitle", "time": 19365.91, "timestamp": "05:22:45", "text": "[笑声]"}, {"type": "subtitle", "time": 19369.03, "timestamp": "05:22:49", "text": "你需要我才能让我发送C和这个"}, {"type": "subtitle", "time": 19374.39, "timestamp": "05:22:54", "text": "信中提到了这一点，对吧？"}, {"type": "subtitle", "time": 19377.11, "timestamp": "05:22:57", "text": "因为我们现在是 YouTuber 了。我们隐藏"}]
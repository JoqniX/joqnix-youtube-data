[{"type": "subtitle", "time": 2111.589, "timestamp": "00:35:11", "text": "需要重置。哦，有一个"}, {"type": "chat", "time": 2113.773, "timestamp": "00:35:13", "author": "@mishereshu", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mc4Y9gQCEiemTFxftMBzkVs4f2dFVKIi2EzfEXVVougJ-byH1unVlcX4jadECPvzh2lg=s64-c-k-c0x00ffffff-no-rj", "message": "the problems are stil there, im just happier and well adjusted to deal with it"}, {"type": "subtitle", "time": 2121.03, "timestamp": "00:35:21", "text": "还有一件事，我太在意了。"}, {"type": "subtitle", "time": 2122.87, "timestamp": "00:35:22", "text": "关于其他人的想法。那"}, {"type": "subtitle", "time": 2124.63, "timestamp": "00:35:24", "text": "结果导致我受到太多伤害。这"}, {"type": "subtitle", "time": 2126.15, "timestamp": "00:35:26", "text": "当我不再在意别人的看法并开始掌控自己的命运时，"}, {"type": "subtitle", "time": 2129.03, "timestamp": "00:35:29", "text": "我当时快乐多了。"}, {"type": "subtitle", "time": 2131.19, "timestamp": "00:35:31", "text": "问题依然存在。我很高兴"}, {"type": "subtitle", "time": 2133.19, "timestamp": "00:35:33", "text": "我只能自己想办法解决。是啊，我的意思是"}, {"type": "subtitle", "time": 2134.55, "timestamp": "00:35:34", "text": "那件事和之前发生的事情一模一样。"}, {"type": "subtitle", "time": 2137.27, "timestamp": "00:35:37", "text": "跟我一起，对吧？"}, {"type": "subtitle", "time": 2141.829, "timestamp": "00:35:41", "text": "我太在意别人了。"}, {"type": "subtitle", "time": 2144.39, "timestamp": "00:35:44", "text": "别人的想法等等"}, {"type": "subtitle", "time": 2153.67, "timestamp": "00:35:53", "text": "我损失了很多。"}, {"type": "subtitle", "time": 2157.349, "timestamp": "00:35:57", "text": "是的，即使是今天，我也不得不这么做。"}]
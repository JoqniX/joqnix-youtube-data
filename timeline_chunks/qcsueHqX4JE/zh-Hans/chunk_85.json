[{"type": "subtitle", "time": 5101.75, "timestamp": "01:25:01", "text": "人以及一切事物"}, {"type": "subtitle", "time": 5104.229, "timestamp": "01:25:04", "text": "所以我就想，唉，我一个人孤零零的。我不"}, {"type": "subtitle", "time": 5105.83, "timestamp": "01:25:05", "text": "人太多了，所以我一个人做。"}, {"type": "subtitle", "time": 5110.229, "timestamp": "01:25:10", "text": "我当时就是这么想的。即使我过去"}, {"type": "subtitle", "time": 5113.669, "timestamp": "01:25:13", "text": "所有事情都由我自己做。"}, {"type": "subtitle", "time": 5116.629, "timestamp": "01:25:16", "text": "我以前从不依赖任何人。"}, {"type": "subtitle", "time": 5118.149, "timestamp": "01:25:18", "text": "因为"}, {"type": "subtitle", "time": 5120.31, "timestamp": "01:25:20", "text": "其他人反应很慢，而我……"}, {"type": "subtitle", "time": 5122.39, "timestamp": "01:25:22", "text": "如果我自己做，我会更……"}, {"type": "subtitle", "time": 5125.91, "timestamp": "01:25:25", "text": "把所有这些都保持一致"}, {"type": "subtitle", "time": 5129.11, "timestamp": "01:25:29", "text": "在某种程度上，我意识到我无法成为……"}, {"type": "subtitle", "time": 5132.87, "timestamp": "01:25:32", "text": "样样通，样样松，对吧？"}, {"type": "subtitle", "time": 5137.03, "timestamp": "01:25:37", "text": "平衡一切总是很难的。"}, {"type": "subtitle", "time": 5139.11, "timestamp": "01:25:39", "text": "筋疲力尽之后，我才明白"}, {"type": "subtitle", "time": 5142.39, "timestamp": "01:25:42", "text": "是啊，有时候"}, {"type": "subtitle", "time": 5144.709, "timestamp": "01:25:44", "text": "所以她不会那样做。你只需要集中注意力"}, {"type": "subtitle", "time": 5149.11, "timestamp": "01:25:49", "text": "你想做的一件事"}, {"type": "subtitle", "time": 5150.95, "timestamp": "01:25:50", "text": "仍然明白你想做什么"}, {"type": "subtitle", "time": 5159.75, "timestamp": "01:25:59", "text": "对我来说，某种程度上我认为"}, {"type": "chat", "time": 5159.971, "timestamp": "01:25:59", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "that's why Im asking you you can't be all time joqnix"}]
[{"type": "subtitle", "time": 2647.349, "timestamp": "00:44:07", "text": "等等，着火了。尼拉纳。涅槃"}, {"type": "subtitle", "time": 2679.43, "timestamp": "00:44:39", "text": "核？我甚至连 Ignite 都没有。在哪里"}, {"type": "subtitle", "time": 2681.829, "timestamp": "00:44:41", "text": "是点燃吗？"}, {"type": "subtitle", "time": 2684.309, "timestamp": "00:44:44", "text": "我没有 Ignite。我得去种它。"}, {"type": "subtitle", "time": 2687.67, "timestamp": "00:44:47", "text": "我的天啊。"}, {"type": "subtitle", "time": 2689.27, "timestamp": "00:44:49", "text": "呃，"}, {"type": "subtitle", "time": 2699.349, "timestamp": "00:44:59", "text": "这是什么类型的？烈焰光谱。"}]
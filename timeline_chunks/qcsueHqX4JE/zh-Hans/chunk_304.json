[{"type": "subtitle", "time": 18240.39, "timestamp": "05:04:00", "text": "但我现在明白我本来可以拥有这一切。"}, {"type": "subtitle", "time": 18243.99, "timestamp": "05:04:03", "text": "很多事情。嗯"}, {"type": "subtitle", "time": 18248.31, "timestamp": "05:04:08", "text": "是啊，不是你自己。对，没错。"}, {"type": "subtitle", "time": 18251.91, "timestamp": "05:04:11", "text": "现在我从这一切中学到了很多。"}, {"type": "subtitle", "time": 18253.51, "timestamp": "05:04:13", "text": "发生"}, {"type": "subtitle", "time": 18261.27, "timestamp": "05:04:21", "text": "而且这事由来已久，因为"}, {"type": "subtitle", "time": 18264.47, "timestamp": "05:04:24", "text": "原因。事情必须如此发展。"}, {"type": "subtitle", "time": 18272.07, "timestamp": "05:04:32", "text": "嗯，"}, {"type": "subtitle", "time": 18274.47, "timestamp": "05:04:34", "text": "我当时在做自己的事。拿"}, {"type": "subtitle", "time": 18277.67, "timestamp": "05:04:37", "text": "接受治疗，痊愈，专注于我的"}, {"type": "subtitle", "time": 18281.59, "timestamp": "05:04:41", "text": "参加安息日活动，这样我就可以支付模型的费用了。"}, {"type": "subtitle", "time": 18285.11, "timestamp": "05:04:45", "text": "实际上，他首次亮相就……"}, {"type": "subtitle", "time": 18286.868, "timestamp": "05:04:46", "text": "一切。"}, {"type": "subtitle", "time": 18290.47, "timestamp": "05:04:50", "text": "我猜是掉进下水道了，垃圾倾倒器，我"}, {"type": "subtitle", "time": 18293.91, "timestamp": "05:04:53", "text": "猜测。其他"}, {"type": "subtitle", "time": 18295.27, "timestamp": "05:04:55", "text": "边。我感觉他们正在逐渐……"}]
[{"type": "subtitle", "time": 16622.07, "timestamp": "04:37:02", "text": "我不是那种类型的经理。"}, {"type": "subtitle", "time": 16628.629, "timestamp": "04:37:08", "text": "比如，经理会做些什么来达到这种效果呢？"}, {"type": "subtitle", "time": 16631.029, "timestamp": "04:37:11", "text": "维持日程安排并寻找"}, {"type": "subtitle", "time": 16632.869, "timestamp": "04:37:12", "text": "赞助和确保"}, {"type": "subtitle", "time": 16635.99, "timestamp": "04:37:15", "text": "分析等等"}, {"type": "subtitle", "time": 16646.23, "timestamp": "04:37:26", "text": "然后她解释说"}, {"type": "subtitle", "time": 16648.47, "timestamp": "04:37:28", "text": "婚姻这个词在某种程度上被用作一个词。"}, {"type": "subtitle", "time": 16652.15, "timestamp": "04:37:32", "text": "送给男朋友。兄弟。哦，是的。是的。"}, {"type": "subtitle", "time": 16655.59, "timestamp": "04:37:35", "text": "是的。我看到了。 Q版人物。不是"}, {"type": "subtitle", "time": 16660.07, "timestamp": "04:37:40", "text": "Q版。呃，坠落的阴影和弓。"}, {"type": "subtitle", "time": 16663.83, "timestamp": "04:37:43", "text": "鲸鱼。是Ba吗？我忘了。我忘了"}, {"type": "subtitle", "time": 16668.47, "timestamp": "04:37:48", "text": "谁是谁？那部电视剧。"}, {"type": "subtitle", "time": 16674.949, "timestamp": "04:37:54", "text": "那就是那个女孩。她很高兴。"}]
[{"type": "subtitle", "time": 16262.149, "timestamp": "04:31:02", "text": "哇。"}, {"type": "subtitle", "time": 16270.63, "timestamp": "04:31:10", "text": "我的天啊。"}, {"type": "subtitle", "time": 16273.67, "timestamp": "04:31:13", "text": "对你来说已经很晚了。你有工作"}, {"type": "subtitle", "time": 16276.229, "timestamp": "04:31:16", "text": "明天。"}, {"type": "subtitle", "time": 16282.63, "timestamp": "04:31:22", "text": "等等，你周末不用上班。"}, {"type": "subtitle", "time": 16311.349, "timestamp": "04:31:51", "text": "哦，是的。你的书写得怎么样了？"}, {"type": "subtitle", "time": 16313.83, "timestamp": "04:31:53", "text": "去？呃，是你说的，"}, {"type": "subtitle", "time": 16316.79, "timestamp": "04:31:56", "text": "“不，你是做写作之类的。”"}]
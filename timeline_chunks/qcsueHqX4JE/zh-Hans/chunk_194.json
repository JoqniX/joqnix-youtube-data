[{"type": "subtitle", "time": 11643.349, "timestamp": "03:14:03", "text": "就像我"}, {"type": "subtitle", "time": 11646.07, "timestamp": "03:14:06", "text": "精彩的派对场景和健身房场景。伟大的"}, {"type": "subtitle", "time": 11648.309, "timestamp": "03:14:08", "text": "约会场景，女孩的食物。哦，是的，他们"}, {"type": "subtitle", "time": 11654.63, "timestamp": "03:14:14", "text": "除非n和，否则没人喜欢和你说话。"}, {"type": "subtitle", "time": 11656.95, "timestamp": "03:14:16", "text": "这也没错。"}, {"type": "subtitle", "time": 11660.469, "timestamp": "03:14:20", "text": "没错，没错，没错。"}, {"type": "subtitle", "time": 11677.91, "timestamp": "03:14:37", "text": "照常去。我可以做德语。"}, {"type": "subtitle", "time": 11693.349, "timestamp": "03:14:53", "text": "如何说服他们的朋友"}, {"type": "subtitle", "time": 11694.79, "timestamp": "03:14:54", "text": "德国人认为他们错了"}, {"type": "subtitle", "time": 11699.75, "timestamp": "03:14:59", "text": "[笑声]"}]
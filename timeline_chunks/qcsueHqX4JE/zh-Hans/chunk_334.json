[{"type": "subtitle", "time": 20041.19, "timestamp": "05:34:01", "text": "Fortnite 直播。不，不多。我做了"}, {"type": "subtitle", "time": 20045.11, "timestamp": "05:34:05", "text": "是扎顿，对吧？"}, {"type": "subtitle", "time": 20049.59, "timestamp": "05:34:09", "text": "Fortnite 为 Fortnite 而生。"}, {"type": "subtitle", "time": 20053.19, "timestamp": "05:34:13", "text": "PUBG 随身摄像头。是的，执法记录仪是"}, {"type": "subtitle", "time": 20055.99, "timestamp": "05:34:15", "text": "我的游戏电脑坏了。那就是"}, {"type": "subtitle", "time": 20059.43, "timestamp": "05:34:19", "text": "那天我的游戏电脑坏了。我的CPU坏了，GPU也坏了。"}, {"type": "subtitle", "time": 20062.628, "timestamp": "05:34:22", "text": "直播那场比赛时去世了。我永远不会"}, {"type": "subtitle", "time": 20064.948, "timestamp": "05:34:24", "text": "忘了这游戏吧。 [笑声]"}, {"type": "subtitle", "time": 20067.99, "timestamp": "05:34:27", "text": "我丢失游戏电脑的那天，我的骑师"}, {"type": "subtitle", "time": 20070.07, "timestamp": "05:34:30", "text": "chan，"}, {"type": "subtitle", "time": 20073.67, "timestamp": "05:34:33", "text": "我以前会给我的电脑取名字。我正在使用的这台电脑"}, {"type": "subtitle", "time": 20077.67, "timestamp": "05:34:37", "text": "被叫到 Chan，游戏 PC 是"}, {"type": "subtitle", "time": 20079.246, "timestamp": "05:34:39", "text": "乔云。"}, {"type": "subtitle", "time": 20088.31, "timestamp": "05:34:48", "text": "我错过了那场比赛。"}]
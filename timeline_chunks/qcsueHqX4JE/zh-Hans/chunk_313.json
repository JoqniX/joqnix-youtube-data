[{"type": "subtitle", "time": 18782.07, "timestamp": "05:13:02", "text": "那。就像我刚做的那些视频一样"}, {"type": "subtitle", "time": 18785.51, "timestamp": "05:13:05", "text": "凌晨三点还在喋喋不休。我真希望……"}, {"type": "subtitle", "time": 18788.15, "timestamp": "05:13:08", "text": "就像Orange真的会发布他的"}, {"type": "subtitle", "time": 18791.51, "timestamp": "05:13:11", "text": "视频，即更新视频。我可能"}, {"type": "subtitle", "time": 18794.23, "timestamp": "05:13:14", "text": "我觉得视频还在。乔克是个"}, {"type": "subtitle", "time": 18797.83, "timestamp": "05:13:17", "text": "捕食者之类的东西。是吗？我甚至"}, {"type": "subtitle", "time": 18800.788, "timestamp": "05:13:20", "text": "告诉他去发个社区帖子"}, {"type": "subtitle", "time": 18803.35, "timestamp": "05:13:23", "text": "然后发条推特什么的。你为什么是"}, {"type": "subtitle", "time": 18806.868, "timestamp": "05:13:26", "text": "就像他说的，他会喜欢私人生活。"}, {"type": "subtitle", "time": 18810.23, "timestamp": "05:13:30", "text": "还有一些其他的东西。但是，是的，我希望我能做到"}, {"type": "subtitle", "time": 18813.27, "timestamp": "05:13:33", "text": "第二个视频，内容涵盖了整个过程。"}, {"type": "subtitle", "time": 18815.75, "timestamp": "05:13:35", "text": "整体而言。不仅仅是我的戏剧"}, {"type": "subtitle", "time": 18827.11, "timestamp": "05:13:47", "text": "他说过，就像因为没有"}, {"type": "subtitle", "time": 18829.59, "timestamp": "05:13:49", "text": "有人在谈论这件事，以及所有的一切。"}, {"type": "subtitle", "time": 18831.35, "timestamp": "05:13:51", "text": "最好就此结束。"}, {"type": "subtitle", "time": 18833.03, "timestamp": "05:13:53", "text": "一切。这就是他没有选择的原因。"}, {"type": "subtitle", "time": 18835.99, "timestamp": "05:13:55", "text": "上传第二部分，就像这样"}, {"type": "subtitle", "time": 18839.67, "timestamp": "05:13:59", "text": "我这边更新一下，一切都好。"}]
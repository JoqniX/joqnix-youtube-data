[{"type": "subtitle", "time": 10380.389, "timestamp": "02:53:00", "text": "想要其他任何东西都比"}, {"type": "subtitle", "time": 10382.71, "timestamp": "02:53:02", "text": "通货膨胀。日内交易是一项全职工作"}, {"type": "subtitle", "time": 10384.23, "timestamp": "02:53:04", "text": "工作就是成熟并划分你的"}, {"type": "subtitle", "time": 10386.389, "timestamp": "02:53:06", "text": "投资组合介于股票之间，风险略高"}, {"type": "subtitle", "time": 10401.269, "timestamp": "02:53:21", "text": "被动收入，说实话"}, {"type": "subtitle", "time": 10404.07, "timestamp": "02:53:24", "text": "说到说话，我一直觉得如果你"}, {"type": "subtitle", "time": 10407.429, "timestamp": "02:53:27", "text": "努力工作，你会得到某种形式的回报。"}, {"type": "subtitle", "time": 10411.03, "timestamp": "02:53:31", "text": "事物。所以我一直有这样的印象"}, {"type": "subtitle", "time": 10414.55, "timestamp": "02:53:34", "text": "是的，如果我努力工作，尽我所能……"}, {"type": "subtitle", "time": 10418.15, "timestamp": "02:53:38", "text": "干得好，我会"}, {"type": "subtitle", "time": 10420.95, "timestamp": "02:53:40", "text": "嗯，总有一天你会得到回报的。甚至"}, {"type": "subtitle", "time": 10422.63, "timestamp": "02:53:42", "text": "虽然我正在经历挣扎和痛苦。"}, {"type": "subtitle", "time": 10425.99, "timestamp": "02:53:45", "text": "现在，总有一天我会得到我努力的回报。"}, {"type": "subtitle", "time": 10429.03, "timestamp": "02:53:49", "text": "会付清款项之类的。所以当时"}, {"type": "subtitle", "time": 10430.63, "timestamp": "02:53:50", "text": "喜欢"}, {"type": "subtitle", "time": 10432.95, "timestamp": "02:53:52", "text": "我不想做所有这些加密货币相关的事情"}, {"type": "subtitle", "time": 10436.469, "timestamp": "02:53:56", "text": "其他赚钱的方式。我想"}]
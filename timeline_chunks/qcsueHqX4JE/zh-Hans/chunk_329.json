[{"type": "subtitle", "time": 19753.43, "timestamp": "05:29:13", "text": "还有什么需要更多呢？让我谷歌一下"}, {"type": "subtitle", "time": 19768.708, "timestamp": "05:29:28", "text": "是的，这个话题是从戏剧中传出来的。"}, {"type": "subtitle", "time": 19772.23, "timestamp": "05:29:32", "text": "晚上要认真对待。抱歉，我话很多。"}, {"type": "subtitle", "time": 19773.99, "timestamp": "05:29:33", "text": "说到夜晚。是的，我"}, {"type": "subtitle", "time": 19776.31, "timestamp": "05:29:36", "text": "我注意到了。害怕错过机会。好的。"}, {"type": "subtitle", "time": 19778.31, "timestamp": "05:29:38", "text": "你好。谢谢。"}, {"type": "subtitle", "time": 19780.15, "timestamp": "05:29:40", "text": "我觉得它不太像摇滚乐。"}, {"type": "subtitle", "time": 19783.59, "timestamp": "05:29:43", "text": "是啊，我不知道。那也是其中之一"}, {"type": "subtitle", "time": 19791.59, "timestamp": "05:29:51", "text": "所以 d"}, {"type": "subtitle", "time": 19794.548, "timestamp": "05:29:54", "text": "我们只是在闲聊一些事情而已。"}, {"type": "subtitle", "time": 19798.39, "timestamp": "05:29:58", "text": "我演戏的时候也遇到过这种情况。"}]
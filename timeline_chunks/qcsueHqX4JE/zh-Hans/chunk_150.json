[{"type": "subtitle", "time": 9000.63, "timestamp": "02:30:00", "text": "对我来说[笑声]"}, {"type": "subtitle", "time": 9002.79, "timestamp": "02:30:02", "text": "来找我吧？我想我会的"}, {"type": "subtitle", "time": 9009.429, "timestamp": "02:30:09", "text": "安全的。然后我就得去找工作了。"}, {"type": "subtitle", "time": 9012.15, "timestamp": "02:30:12", "text": "正确的。"}, {"type": "subtitle", "time": 9016.87, "timestamp": "02:30:16", "text": "所以，我的老师说"}, {"type": "subtitle", "time": 9019.27, "timestamp": "02:30:19", "text": "呃，无论你选择什么课程，都不会……"}, {"type": "subtitle", "time": 9021.99, "timestamp": "02:30:21", "text": "事情。这是大学的品牌。"}, {"type": "subtitle", "time": 9024.79, "timestamp": "02:30:24", "text": "这对找工作很重要。如果你"}, {"type": "subtitle", "time": 9029.349, "timestamp": "02:30:29", "text": "如果你考上大学，那会怎样？"}, {"type": "subtitle", "time": 9034.07, "timestamp": "02:30:34", "text": "名字好"}, {"type": "subtitle", "time": 9037.83, "timestamp": "02:30:37", "text": "嗯，好名字之类的，比如很大很大"}, {"type": "subtitle", "time": 9041.75, "timestamp": "02:30:41", "text": "这样你就能轻松找到好工作了。"}, {"type": "subtitle", "time": 9044.469, "timestamp": "02:30:44", "text": "他们说的话让我很困惑。"}, {"type": "subtitle", "time": 9048.15, "timestamp": "02:30:48", "text": "我应该去音乐大学吗？"}, {"type": "subtitle", "time": 9050.87, "timestamp": "02:30:50", "text": "因为我现在想从事音乐行业。"}, {"type": "subtitle", "time": 9055.11, "timestamp": "02:30:55", "text": "我应该选择4号吗？是的。"}, {"type": "subtitle", "time": 9057.67, "timestamp": "02:30:57", "text": "我选择的学校，语言"}]
[{"type": "subtitle", "time": 3065.27, "timestamp": "00:51:05", "text": "哦，是的。神秘法师何时出现？"}, {"type": "subtitle", "time": 3075.589, "timestamp": "00:51:15", "text": "两天。这次我可以完成这件事了。"}, {"type": "subtitle", "time": 3080.87, "timestamp": "00:51:20", "text": "出色地。今天我想"}, {"type": "subtitle", "time": 3082.47, "timestamp": "00:51:22", "text": "我必须决定我该做什么。"}, {"type": "subtitle", "time": 3110.95, "timestamp": "00:51:50", "text": "另外，我还有1.38"}, {"type": "subtitle", "time": 3113.67, "timestamp": "00:51:53", "text": "嗯，秘密的字母。"}, {"type": "subtitle", "time": 3115.91, "timestamp": "00:51:55", "text": "所以我在想，我是否应该让丽贝卡参选？"}, {"type": "subtitle", "time": 3119.51, "timestamp": "00:51:59", "text": "并获得第二个重复项。"}]
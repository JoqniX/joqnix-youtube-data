[{"type": "subtitle", "time": 18421.19, "timestamp": "05:07:01", "text": "Vishy 拿着面包，像少数人一样。"}, {"type": "subtitle", "time": 18423.43, "timestamp": "05:07:03", "text": "那真有趣。"}, {"type": "subtitle", "time": 18426.55, "timestamp": "05:07:06", "text": "只要他们离开，你也离开。呃"}, {"type": "subtitle", "time": 18455.19, "timestamp": "05:07:35", "text": "塔可饼，"}, {"type": "subtitle", "time": 18463.91, "timestamp": "05:07:43", "text": "[叹气]"}, {"type": "subtitle", "time": 18465.91, "timestamp": "05:07:45", "text": "但"}]
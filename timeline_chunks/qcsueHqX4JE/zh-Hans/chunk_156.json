[{"type": "subtitle", "time": 9375.99, "timestamp": "02:36:15", "text": "所以，我的工资与我的收入挂钩。"}, {"type": "subtitle", "time": 9384.55, "timestamp": "02:36:24", "text": "印度。等等，你现在在哪里？"}, {"type": "subtitle", "time": 9387.27, "timestamp": "02:36:27", "text": "你现在在印度吗？还是在其他地方？"}, {"type": "subtitle", "time": 9394.95, "timestamp": "02:36:34", "text": "那真不错。现在正在旅行"}, {"type": "subtitle", "time": 9396.87, "timestamp": "02:36:36", "text": "东西。"}, {"type": "subtitle", "time": 9399.03, "timestamp": "02:36:39", "text": "旅行也是我的梦想之一。"}, {"type": "subtitle", "time": 9401.99, "timestamp": "02:36:41", "text": "世界。"}, {"type": "subtitle", "time": 9404.23, "timestamp": "02:36:44", "text": "喜欢"}, {"type": "subtitle", "time": 9407.59, "timestamp": "02:36:47", "text": "当我得知有些人"}, {"type": "subtitle", "time": 9410.95, "timestamp": "02:36:50", "text": "我通过环游世界赚钱。"}, {"type": "subtitle", "time": 9414.309, "timestamp": "02:36:54", "text": "真是的，"}, {"type": "subtitle", "time": 9418.15, "timestamp": "02:36:58", "text": "我心想，老兄，我也想要那样的生活。"}]
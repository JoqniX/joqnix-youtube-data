[{"type": "subtitle", "time": 14400.15, "timestamp": "04:00:00", "text": "我意识到，就像我随着时间的推移……"}, {"type": "subtitle", "time": 14403.11, "timestamp": "04:00:03", "text": "意识到我的短信交流方式等等是"}, {"type": "subtitle", "time": 14405.269, "timestamp": "04:00:05", "text": "太尴尬了"}, {"type": "subtitle", "time": 14410.15, "timestamp": "04:00:10", "text": "随着时间的推移，我就不再那样做了。"}, {"type": "subtitle", "time": 14411.83, "timestamp": "04:00:11", "text": "好的。"}, {"type": "subtitle", "time": 14415.59, "timestamp": "04:00:15", "text": "问题是我太容易被人接受了。"}, {"type": "subtitle", "time": 14418.15, "timestamp": "04:00:18", "text": "说服和操纵所有那些人"}, {"type": "subtitle", "time": 14420.95, "timestamp": "04:00:20", "text": "把东西放好。所以我根本不知道"}, {"type": "subtitle", "time": 14426.309, "timestamp": "04:00:26", "text": "是否有任何问题或疑虑"}, {"type": "subtitle", "time": 14428.63, "timestamp": "04:00:28", "text": "呃，和另一个人，甚至为了"}, {"type": "subtitle", "time": 14430.229, "timestamp": "04:00:30", "text": "我？"}, {"type": "subtitle", "time": 14432.95, "timestamp": "04:00:32", "text": "我不知道。 [笑声]"}, {"type": "subtitle", "time": 14435.67, "timestamp": "04:00:35", "text": "AKS 五。好的，我会随时向你汇报最新情况。"}, {"type": "subtitle", "time": 14444.71, "timestamp": "04:00:44", "text": "就是这样。你好。谢谢。我再补充一点"}, {"type": "subtitle", "time": 14447.59, "timestamp": "04:00:47", "text": "你。啊。"}, {"type": "subtitle", "time": 14455.91, "timestamp": "04:00:55", "text": "我的天啊。"}, {"type": "subtitle", "time": 14459.189, "timestamp": "04:00:59", "text": "这是。这是。说实话，当我看着"}]
[{"type": "subtitle", "time": 9187.27, "timestamp": "02:33:07", "text": "所以当我的老师跟我讲到类似的事情时……"}, {"type": "subtitle", "time": 9189.349, "timestamp": "02:33:09", "text": "我问所有学生诸如“什么？”之类的问题"}, {"type": "subtitle", "time": 9191.27, "timestamp": "02:33:11", "text": "语言学习之后你打算做什么？"}, {"type": "subtitle", "time": 9194.469, "timestamp": "02:33:14", "text": "当然，就像给予所有这些一样。"}, {"type": "subtitle", "time": 9197.27, "timestamp": "02:33:17", "text": "建议以及你需要做的事情"}, {"type": "subtitle", "time": 9201.11, "timestamp": "02:33:21", "text": "信用评分等等这些东西"}, {"type": "subtitle", "time": 9203.349, "timestamp": "02:33:23", "text": "因为我们的徽章里有些人"}, {"type": "subtitle", "time": 9207.99, "timestamp": "02:33:27", "text": "已经收到工作邀请了，就像这样"}, {"type": "subtitle", "time": 9210.95, "timestamp": "02:33:30", "text": "你说这就像一家公司会"}, {"type": "subtitle", "time": 9215.19, "timestamp": "02:33:35", "text": "他们会资助你去日本。"}, {"type": "subtitle", "time": 9217.75, "timestamp": "02:33:37", "text": "给你日本部门的工作"}, {"type": "subtitle", "time": 9219.83, "timestamp": "02:33:39", "text": "算是吧？是的。是的。是的。"}, {"type": "subtitle", "time": 9225.03, "timestamp": "02:33:45", "text": "有那么一个人，呃，我想是这样的"}, {"type": "subtitle", "time": 9228.469, "timestamp": "02:33:48", "text": "所以他有份工作了，而且这份工作是有保障的。"}, {"type": "subtitle", "time": 9233.99, "timestamp": "02:33:53", "text": "日本。他只需要清除N4即可。"}, {"type": "subtitle", "time": 9236.95, "timestamp": "02:33:56", "text": "或N3"}]
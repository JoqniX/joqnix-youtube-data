[{"type": "subtitle", "time": 13740.15, "timestamp": "03:49:00", "text": "女性的声音，有点令人困惑的声音"}, {"type": "subtitle", "time": 13742.87, "timestamp": "03:49:02", "text": "就是那种事，对吧？我也是"}, {"type": "subtitle", "time": 13747.349, "timestamp": "03:49:07", "text": "惊讶。不，老实说，当我"}, {"type": "subtitle", "time": 13751.189, "timestamp": "03:49:11", "text": "最初了解灵性的时候，我……"}, {"type": "subtitle", "time": 13753.349, "timestamp": "03:49:13", "text": "喜欢"}, {"type": "subtitle", "time": 13756.469, "timestamp": "03:49:16", "text": "我当时想，“好吧，等等。这是个男的，"}, {"type": "subtitle", "time": 13763.189, "timestamp": "03:49:23", "text": "然后我开始感到自信，我开始……"}, {"type": "subtitle", "time": 13765.75, "timestamp": "03:49:25", "text": "感到困惑。"}, {"type": "subtitle", "time": 13769.189, "timestamp": "03:49:29", "text": "然后我突然明白了。哦，等等。所以这个"}, {"type": "subtitle", "time": 13771.75, "timestamp": "03:49:31", "text": "其他人过去就是这样想的"}, {"type": "subtitle", "time": 13774.87, "timestamp": "03:49:34", "text": "我。就像我遇到的这种困惑"}, {"type": "subtitle", "time": 13777.59, "timestamp": "03:49:37", "text": "注视着灵魂。我觉得我感觉"}, {"type": "subtitle", "time": 13780.229, "timestamp": "03:49:40", "text": "其他人也是这样。"}, {"type": "subtitle", "time": 13782.79, "timestamp": "03:49:42", "text": "混乱。"}, {"type": "subtitle", "time": 13786.389, "timestamp": "03:49:46", "text": "我的天啊。我首映了《愤怒的小鸟2》"}, {"type": "subtitle", "time": 13789.99, "timestamp": "03:49:49", "text": "这段视频尝试拍摄太空题材的视频。"}, {"type": "subtitle", "time": 13792.15, "timestamp": "03:49:52", "text": "什么？"}, {"type": "subtitle", "time": 13794.309, "timestamp": "03:49:54", "text": "愤怒的小鸟。好久没听到了"}, {"type": "subtitle", "time": 13799.11, "timestamp": "03:49:59", "text": "关于愤怒的小鸟。我错过了那场比赛。"}]
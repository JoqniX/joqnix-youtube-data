[{"type": "subtitle", "time": 10020.71, "timestamp": "02:47:00", "text": "标记。"}, {"type": "subtitle", "time": 10022.95, "timestamp": "02:47:02", "text": "难道不是吗？"}, {"type": "subtitle", "time": 10025.91, "timestamp": "02:47:05", "text": "我知道"}, {"type": "subtitle", "time": 10029.429, "timestamp": "02:47:09", "text": "比如我，呃，我坐下来……"}, {"type": "subtitle", "time": 10032.55, "timestamp": "02:47:12", "text": "比如思考、提问，大概需要15到10分钟。"}, {"type": "subtitle", "time": 10034.87, "timestamp": "02:47:14", "text": "就像狗一样，我能做什么？"}, {"type": "subtitle", "time": 10037.51, "timestamp": "02:47:17", "text": "对我来说，这将是一个不错的策略。"}, {"type": "subtitle", "time": 10039.19, "timestamp": "02:47:19", "text": "一切"}, {"type": "subtitle", "time": 10042.87, "timestamp": "02:47:22", "text": "就像直到直到"}, {"type": "subtitle", "time": 10045.51, "timestamp": "02:47:25", "text": "直到第四年，你管它叫什么？"}, {"type": "subtitle", "time": 10049.59, "timestamp": "02:47:29", "text": "课程部分其余部分就像在我身上一样。"}, {"type": "subtitle", "time": 10051.67, "timestamp": "02:47:31", "text": "正确的"}, {"type": "subtitle", "time": 10053.67, "timestamp": "02:47:33", "text": "工作和一切都安排妥当了，但我被告知……"}, {"type": "subtitle", "time": 10058.15, "timestamp": "02:47:38", "text": "比如找一所合作大学"}, {"type": "subtitle", "time": 10059.91, "timestamp": "02:47:39", "text": "日本没有统一信用评级"}, {"type": "subtitle", "time": 10064.07, "timestamp": "02:47:44", "text": "像FI或SIL这样的评分系统是什么？"}, {"type": "subtitle", "time": 10067.11, "timestamp": "02:47:47", "text": "那些我甚至都不认识的人。"}, {"type": "subtitle", "time": 10069.429, "timestamp": "02:47:49", "text": "我对这个信用额度也感到困惑。"}]
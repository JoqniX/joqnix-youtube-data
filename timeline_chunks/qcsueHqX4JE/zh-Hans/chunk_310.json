[{"type": "subtitle", "time": 18601.51, "timestamp": "05:10:01", "text": "打电话确认一下，比如这是否是……"}, {"type": "subtitle", "time": 18603.43, "timestamp": "05:10:03", "text": "真实"}, {"type": "subtitle", "time": 18607.27, "timestamp": "05:10:07", "text": "呃，那玩意儿之类的[笑声]"}, {"type": "subtitle", "time": 18609.51, "timestamp": "05:10:09", "text": "因为这里是高等法院的草坪。所以"}, {"type": "subtitle", "time": 18616.868, "timestamp": "05:10:16", "text": "但是，是的，本来可以开到 4K 分辨率的。"}, {"type": "subtitle", "time": 18619.75, "timestamp": "05:10:19", "text": "如果他们买了这个，就拍个视频。"}, {"type": "subtitle", "time": 18621.67, "timestamp": "05:10:21", "text": "知道他们撒谎上诉的事。"}, {"type": "subtitle", "time": 18624.868, "timestamp": "05:10:24", "text": "如果我在法庭上看到他们，我会称他们为名人。他们"}, {"type": "subtitle", "time": 18628.07, "timestamp": "05:10:28", "text": "他们试图杀了我。是的，我本来可以去的。"}, {"type": "subtitle", "time": 18630.47, "timestamp": "05:10:30", "text": "你知道，在进攻方面。和"}, {"type": "subtitle", "time": 18633.59, "timestamp": "05:10:33", "text": "你知道，那种不好笑的搞笑"}, {"type": "subtitle", "time": 18635.43, "timestamp": "05:10:35", "text": "我自己身上既搞笑又悲哀的一点"}, {"type": "subtitle", "time": 18637.19, "timestamp": "05:10:37", "text": "是这样的"}, {"type": "subtitle", "time": 18641.83, "timestamp": "05:10:41", "text": "甚至我当时还在为自己辩护"}, {"type": "subtitle", "time": 18644.47, "timestamp": "05:10:44", "text": "他们"}, {"type": "subtitle", "time": 18648.788, "timestamp": "05:10:48", "text": "是啊，我不应该那样做，就像我……"}, {"type": "subtitle", "time": 18654.07, "timestamp": "05:10:54", "text": "本来可以像硬汉一样拼命"}, {"type": "subtitle", "time": 18657.27, "timestamp": "05:10:57", "text": "但我仍然要去，我仍然"}, {"type": "subtitle", "time": 18659.67, "timestamp": "05:10:59", "text": "哦，对，我不应该透露名字"}]
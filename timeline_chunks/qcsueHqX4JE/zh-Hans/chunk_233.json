[{"type": "subtitle", "time": 13981.83, "timestamp": "03:53:01", "text": "这部剧，或者说他说，她说，这"}, {"type": "subtitle", "time": 14000.389, "timestamp": "03:53:20", "text": "我不知道这样说会不会显得我"}, {"type": "subtitle", "time": 14013.91, "timestamp": "03:53:33", "text": "哦，不。"}, {"type": "subtitle", "time": 14031.269, "timestamp": "03:53:51", "text": "啊，对，准社会主义，我喜欢这个病态人格。"}, {"type": "subtitle", "time": 14035.11, "timestamp": "03:53:55", "text": "就是那种事。是的。是的。"}, {"type": "subtitle", "time": 14037.51, "timestamp": "03:53:57", "text": "你知道，我以前也有过那种感觉。"}]
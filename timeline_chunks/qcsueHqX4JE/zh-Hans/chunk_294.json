[{"type": "subtitle", "time": 17642.15, "timestamp": "04:54:02", "text": "YouTuber们，因为他们把我视为……"}, {"type": "subtitle", "time": 17644.708, "timestamp": "04:54:04", "text": "兄弟姐妹之类的"}, {"type": "subtitle", "time": 17648.47, "timestamp": "04:54:08", "text": "用我的名字，然后其他YouTube用户也用了。"}, {"type": "subtitle", "time": 17650.47, "timestamp": "04:54:10", "text": "受那个人影响，他们会……"}, {"type": "subtitle", "time": 17653.43, "timestamp": "04:54:13", "text": "比如，“哦，下一个是运动员。好吧，我要……”"}, {"type": "subtitle", "time": 17655.27, "timestamp": "04:54:15", "text": "阻止他。”或者他们来找我，"}, {"type": "subtitle", "time": 17657.43, "timestamp": "04:54:17", "text": "他们说，为什么他们要这样做？"}, {"type": "subtitle", "time": 17661.03, "timestamp": "04:54:21", "text": "就是这样。然后我代表……道歉"}, {"type": "subtitle", "time": 17664.47, "timestamp": "04:54:24", "text": "对那个人说：“我非常抱歉。”"}, {"type": "subtitle", "time": 17666.868, "timestamp": "04:54:26", "text": "嗯，就像"}, {"type": "subtitle", "time": 17669.91, "timestamp": "04:54:29", "text": "他本性善良。他没有"}, {"type": "subtitle", "time": 17672.31, "timestamp": "04:54:32", "text": "知道该做什么之类的。他没有"}, {"type": "subtitle", "time": 17674.708, "timestamp": "04:54:34", "text": "懂得如何正确地交朋友。我"}, {"type": "subtitle", "time": 17677.35, "timestamp": "04:54:37", "text": "我会这么说，然后我会建议"}, {"type": "subtitle", "time": 17679.51, "timestamp": "04:54:39", "text": "那个人会觉得那样做是错的。这"}, {"type": "subtitle", "time": 17681.51, "timestamp": "04:54:41", "text": "这不是交朋友的方式。你没有"}, {"type": "subtitle", "time": 17684.23, "timestamp": "04:54:44", "text": "做些令人毛骨悚然的事，比如这样那样。然后"}, {"type": "subtitle", "time": 17686.708, "timestamp": "04:54:46", "text": "我受到了影响。然后，在里面"}, {"type": "subtitle", "time": 17689.43, "timestamp": "04:54:49", "text": "最后我心想，好吧，我摄入量太多了。"}, {"type": "subtitle", "time": 17691.11, "timestamp": "04:54:51", "text": "这件事在情感上影响了我"}, {"type": "subtitle", "time": 17694.55, "timestamp": "04:54:54", "text": "精神上。我打算限制我的D和"}, {"type": "subtitle", "time": 17697.19, "timestamp": "04:54:57", "text": "东西。平均而言，经过"}]
[{"type": "subtitle", "time": 18361.11, "timestamp": "05:06:01", "text": "加入这个Discord服务器，这样他们就可以"}, {"type": "subtitle", "time": 18362.868, "timestamp": "05:06:02", "text": "联系并结交朋友，而不是"}, {"type": "subtitle", "time": 18365.59, "timestamp": "05:06:05", "text": "只有你一个人在这个空间里，对吗？甚至"}, {"type": "subtitle", "time": 18368.47, "timestamp": "05:06:08", "text": "如果你在Twitch或YouTube上，那就关注K YouTube吧。"}, {"type": "subtitle", "time": 18371.35, "timestamp": "05:06:11", "text": "任何地方。我希望他们彼此联系。"}, {"type": "subtitle", "time": 18374.47, "timestamp": "05:06:14", "text": "其他方面，善于沟通，结交好朋友"}, {"type": "subtitle", "time": 18377.03, "timestamp": "05:06:17", "text": "合作，创造，做一些"}, {"type": "subtitle", "time": 18380.47, "timestamp": "05:06:20", "text": "内容不错，玩得开心。"}, {"type": "subtitle", "time": 18382.55, "timestamp": "05:06:22", "text": "最终，它变成了一场戏剧性的"}, {"type": "subtitle", "time": 18392.15, "timestamp": "05:06:32", "text": "人们24小时不间断地泡在Discord语音频道上"}, {"type": "subtitle", "time": 18394.31, "timestamp": "05:06:34", "text": "而不是流媒体"}, {"type": "subtitle", "time": 18397.11, "timestamp": "05:06:37", "text": "这个那个。哦"}, {"type": "subtitle", "time": 18400.07, "timestamp": "05:06:40", "text": "我几乎没怎么用过像 VC 或 Discord 这样的平台。"}, {"type": "subtitle", "time": 18403.99, "timestamp": "05:06:43", "text": "因为我当时主要专注于直播，所以关注了风险投资。"}, {"type": "subtitle", "time": 18407.012, "timestamp": "05:06:47", "text": "在我的东西上。"}, {"type": "subtitle", "time": 18407.75, "timestamp": "05:06:47", "text": "[叹息和喘息]"}, {"type": "subtitle", "time": 18411.11, "timestamp": "05:06:51", "text": "我不知道。是的，Discord语音聊天很有趣。"}, {"type": "subtitle", "time": 18414.55, "timestamp": "05:06:54", "text": "诚实地。是的。"}, {"type": "subtitle", "time": 18416.628, "timestamp": "05:06:56", "text": "所以今天我在Discord上。"}]
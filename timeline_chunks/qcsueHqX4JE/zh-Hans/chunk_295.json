[{"type": "subtitle", "time": 17701.59, "timestamp": "04:55:01", "text": "就像四五个怪人。"}, {"type": "subtitle", "time": 17705.27, "timestamp": "04:55:05", "text": "其中一人有自杀倾向，一人具有攻击性。"}, {"type": "subtitle", "time": 17709.99, "timestamp": "04:55:09", "text": "一个很奇怪，一个像"}, {"type": "subtitle", "time": 17712.708, "timestamp": "04:55:12", "text": "呃，其中一个想和另一个交朋友。"}, {"type": "subtitle", "time": 17717.19, "timestamp": "04:55:17", "text": "我认识的一些 YouTuber 朋友等等。"}, {"type": "subtitle", "time": 17718.868, "timestamp": "04:55:18", "text": "从那以后，我就一直想着：“好吧，我……”"}, {"type": "subtitle", "time": 17721.19, "timestamp": "04:55:21", "text": "已完成添加好友的操作"}, {"type": "subtitle", "time": 17722.868, "timestamp": "04:55:22", "text": "Discord"}, {"type": "subtitle", "time": 17725.43, "timestamp": "04:55:25", "text": "观众什么的。”这就是我喜欢的原因"}, {"type": "subtitle", "time": 17729.27, "timestamp": "04:55:29", "text": "限制这个东西。记住"}, {"type": "subtitle", "time": 17731.83, "timestamp": "04:55:31", "text": "情况恢复正常后，你可以简单地说，是的，在我的"}, {"type": "subtitle", "time": 17735.11, "timestamp": "04:55:35", "text": "我当时也太好奇了，好吧，为什么呢？"}, {"type": "subtitle", "time": 17738.07, "timestamp": "04:55:38", "text": "他们有这种心态，我怎么能这样？"}, {"type": "subtitle", "time": 17740.23, "timestamp": "04:55:40", "text": "想知道他们为什么会这样做"}, {"type": "subtitle", "time": 17745.59, "timestamp": "04:55:45", "text": "那我该如何干扰他们呢？"}, {"type": "subtitle", "time": 17747.51, "timestamp": "04:55:47", "text": "就像我可以修好它们之类的。"}, {"type": "subtitle", "time": 17750.23, "timestamp": "04:55:50", "text": "然后我意识到，是的，我不能。"}, {"type": "subtitle", "time": 17752.55, "timestamp": "04:55:52", "text": "帮助别人，所以也要给别人建议。"}, {"type": "subtitle", "time": 17756.23, "timestamp": "04:55:56", "text": "我自己都修不好自己的车，别人却还在修车。"}]
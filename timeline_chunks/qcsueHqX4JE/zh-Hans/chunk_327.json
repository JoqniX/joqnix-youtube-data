[{"type": "subtitle", "time": 19622.708, "timestamp": "05:27:02", "text": "以及为什么那些非常了解我的人会……"}, {"type": "subtitle", "time": 19625.67, "timestamp": "05:27:05", "text": "五年，四年，五年，四年"}, {"type": "subtitle", "time": 19628.868, "timestamp": "05:27:08", "text": "多年来，自从我们开始玩管道游戏以来，他们"}, {"type": "subtitle", "time": 19631.99, "timestamp": "05:27:11", "text": "他们故意来羞辱我。"}, {"type": "subtitle", "time": 19634.23, "timestamp": "05:27:14", "text": "等等"}, {"type": "subtitle", "time": 19636.47, "timestamp": "05:27:16", "text": "当他们了解我的为人之后。他们知道这一点。"}, {"type": "subtitle", "time": 19639.59, "timestamp": "05:27:19", "text": "我不会故意做任何……"}, {"type": "subtitle", "time": 19642.47, "timestamp": "05:27:22", "text": "这个这个那个。我认识的那些人"}, {"type": "subtitle", "time": 19644.948, "timestamp": "05:27:24", "text": "甚至还讲述了我童年时期的戏剧"}, {"type": "subtitle", "time": 19647.35, "timestamp": "05:27:27", "text": "我经历了"}, {"type": "subtitle", "time": 19649.75, "timestamp": "05:27:29", "text": "因为我无法和家人沟通。我使用"}, {"type": "subtitle", "time": 19653.43, "timestamp": "05:27:33", "text": "告诉一些我信任的人"}, {"type": "subtitle", "time": 19656.31, "timestamp": "05:27:36", "text": "他们告诉我不要和他们互动。"}, {"type": "subtitle", "time": 19657.99, "timestamp": "05:27:37", "text": "很多和"}, {"type": "subtitle", "time": 19661.83, "timestamp": "05:27:41", "text": "呃，把它们从这个和那个地方剪掉。"}, {"type": "subtitle", "time": 19665.11, "timestamp": "05:27:45", "text": "就是这一点让我很震惊。"}, {"type": "subtitle", "time": 19668.31, "timestamp": "05:27:48", "text": "不仅如此，还有……"}, {"type": "subtitle", "time": 19671.51, "timestamp": "05:27:51", "text": "我想见的人"}, {"type": "subtitle", "time": 19673.75, "timestamp": "05:27:53", "text": "有一些我真的很想……的人"}, {"type": "subtitle", "time": 19675.27, "timestamp": "05:27:55", "text": "委员会"}, {"type": "subtitle", "time": 19678.07, "timestamp": "05:27:58", "text": "因为我已经有一段时间没认识他们了，"}]
[{"type": "subtitle", "time": 5400.229, "timestamp": "01:30:00", "text": "是的。"}, {"type": "subtitle", "time": 5413.83, "timestamp": "01:30:13", "text": "我爸爸也知道这一点。是的，我"}, {"type": "subtitle", "time": 5415.83, "timestamp": "01:30:15", "text": "我做这件事是因为我充满热情。"}, {"type": "subtitle", "time": 5419.43, "timestamp": "01:30:19", "text": "流媒体以及我想做的事情"}, {"type": "subtitle", "time": 5420.629, "timestamp": "01:30:20", "text": "一切。"}, {"type": "subtitle", "time": 5424.229, "timestamp": "01:30:24", "text": "那挺好的。就像我遇到的那些人一样"}, {"type": "subtitle", "time": 5426.79, "timestamp": "01:30:26", "text": "像"}, {"type": "subtitle", "time": 5428.709, "timestamp": "01:30:28", "text": "我注意到了一件事。好的。"}, {"type": "chat", "time": 5430.393, "timestamp": "01:30:30", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "what do you think you still play games like this in future?"}, {"type": "subtitle", "time": 5431.669, "timestamp": "01:30:31", "text": "说实话，我遇到的新朋友"}, {"type": "subtitle", "time": 5434.55, "timestamp": "01:30:34", "text": "当我分享这些事情时，我不认识的人也会听到。"}, {"type": "subtitle", "time": 5436.229, "timestamp": "01:30:36", "text": "那"}, {"type": "subtitle", "time": 5439.75, "timestamp": "01:30:39", "text": "呃，当我告诉他们，是的，我做这个"}, {"type": "subtitle", "time": 5441.51, "timestamp": "01:30:41", "text": "那"}, {"type": "subtitle", "time": 5445.27, "timestamp": "01:30:45", "text": "我对此充满热情。"}, {"type": "subtitle", "time": 5454.31, "timestamp": "01:30:54", "text": "这让我很高兴，但我也是"}, {"type": "subtitle", "time": 5457.11, "timestamp": "01:30:57", "text": "感觉好像没那么强烈。"}, {"type": "subtitle", "time": 5459.03, "timestamp": "01:30:59", "text": "喜欢"}]
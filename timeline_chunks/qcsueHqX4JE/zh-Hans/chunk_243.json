[{"type": "subtitle", "time": 14580.07, "timestamp": "04:03:00", "text": "事情发生是因为我能理解。"}, {"type": "subtitle", "time": 14581.67, "timestamp": "04:03:01", "text": "如何"}, {"type": "subtitle", "time": 14584.389, "timestamp": "04:03:04", "text": "糟糕透了，一切都糟透了。"}, {"type": "subtitle", "time": 14586.79, "timestamp": "04:03:06", "text": "但我已经明白了，就像我的方式一样"}, {"type": "subtitle", "time": 14588.95, "timestamp": "04:03:08", "text": "是乌布语吧？我以前打字"}, {"type": "subtitle", "time": 14593.83, "timestamp": "04:03:13", "text": "在 2020、2021、2022 年时代。那真是"}, {"type": "subtitle", "time": 14597.189, "timestamp": "04:03:17", "text": "令人尴尬，很糟糕。我认为随着时间的推移，我"}, {"type": "subtitle", "time": 14601.429, "timestamp": "04:03:21", "text": "停止使用头垫"}, {"type": "subtitle", "time": 14609.349, "timestamp": "04:03:29", "text": "我的天啊。"}]
[{"type": "subtitle", "time": 16742.789, "timestamp": "04:39:02", "text": "男生。"}, {"type": "subtitle", "time": 16751.349, "timestamp": "04:39:11", "text": "是的。你好。大多数人都是二十多岁。"}, {"type": "subtitle", "time": 16753.429, "timestamp": "04:39:13", "text": "在他们20岁的时候"}, {"type": "subtitle", "time": 16757.99, "timestamp": "04:39:17", "text": "二十五六岁吧？是的。"}, {"type": "subtitle", "time": 16760.47, "timestamp": "04:39:20", "text": "所以，然后它"}, {"type": "subtitle", "time": 16772.07, "timestamp": "04:39:32", "text": "哦，是的，我可以谈谈一件事……"}, {"type": "subtitle", "time": 16775.67, "timestamp": "04:39:35", "text": "猜测。嗯，因为我在某种程度上也有过"}, {"type": "subtitle", "time": 16778.15, "timestamp": "04:39:38", "text": "现在的经理"}, {"type": "subtitle", "time": 16783.91, "timestamp": "04:39:43", "text": "一位真正称职的经理人"}, {"type": "subtitle", "time": 16788.47, "timestamp": "04:39:48", "text": "呃，没用，我反而弄巧成拙了。"}, {"type": "subtitle", "time": 16791.19, "timestamp": "04:39:51", "text": "就像谢天谢地，有人会说“谢天谢地”。"}]
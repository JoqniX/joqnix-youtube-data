[{"type": "subtitle", "time": 11520.95, "timestamp": "03:12:00", "text": "嗯，是的，印地语不是我的母语。"}, {"type": "subtitle", "time": 11531.67, "timestamp": "03:12:11", "text": "我也会说印地语。我的印地语很差。我"}, {"type": "subtitle", "time": 11536.63, "timestamp": "03:12:16", "text": "高中时就没能做到这一点，"}, {"type": "subtitle", "time": 11539.83, "timestamp": "03:12:19", "text": "你知道。我做夜班很差劲。好吧，我当时"}, {"type": "subtitle", "time": 11543.269, "timestamp": "03:12:23", "text": "糟糕到我当时就想，好吧，我"}, {"type": "subtitle", "time": 11545.269, "timestamp": "03:12:25", "text": "打算用印地语作为我的"}, {"type": "subtitle", "time": 11557.19, "timestamp": "03:12:37", "text": "我真庆幸我放弃了 Indie（笑声）"}, {"type": "subtitle", "time": 11561.67, "timestamp": "03:12:41", "text": "拿走了。哦，你还有朋友。哇。"}, {"type": "subtitle", "time": 11569.83, "timestamp": "03:12:49", "text": "噪音。"}, {"type": "subtitle", "time": 11572.469, "timestamp": "03:12:52", "text": "我是我地下世界的朋友。啊，"}, {"type": "subtitle", "time": 11576.309, "timestamp": "03:12:56", "text": "好的。法国怎么样？"}, {"type": "subtitle", "time": 11579.11, "timestamp": "03:12:59", "text": "就像我今天玩面包一样，对吧？我"}]
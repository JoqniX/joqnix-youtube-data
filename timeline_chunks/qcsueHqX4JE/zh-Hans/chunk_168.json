[{"type": "subtitle", "time": 10080.95, "timestamp": "02:48:00", "text": "我不太明白这个信用评分系统。"}, {"type": "subtitle", "time": 10083.83, "timestamp": "02:48:03", "text": "他们有"}, {"type": "subtitle", "time": 10088.469, "timestamp": "02:48:08", "text": "比如PG级和非PG级，呃，PR级和"}, {"type": "subtitle", "time": 10093.67, "timestamp": "02:48:13", "text": "所以，在日本建立信用卡业务是"}, {"type": "subtitle", "time": 10095.429, "timestamp": "02:48:15", "text": "这只是诱使你接受所有东西的一种手段。"}, {"type": "subtitle", "time": 10097.269, "timestamp": "02:48:17", "text": "深入日本经济"}, {"type": "subtitle", "time": 10102.309, "timestamp": "02:48:22", "text": "系统。啊，还有那个。现在"}, {"type": "subtitle", "time": 10104.71, "timestamp": "02:48:24", "text": "说实话，我不想待在那里。"}, {"type": "subtitle", "time": 10108.63, "timestamp": "02:48:28", "text": "深度。想要大杀四方。"}, {"type": "subtitle", "time": 10122.15, "timestamp": "02:48:42", "text": "这就是我为人所知的一点。"}, {"type": "subtitle", "time": 10124.87, "timestamp": "02:48:44", "text": "一定要抽出一些时间。"}, {"type": "subtitle", "time": 10133.99, "timestamp": "02:48:53", "text": "确实是一个真正的美国机构"}]
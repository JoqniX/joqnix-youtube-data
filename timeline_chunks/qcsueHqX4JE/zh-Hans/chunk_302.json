[{"type": "subtitle", "time": 18138.07, "timestamp": "05:02:18", "text": "母亲。他仍然被禁止入内"}, {"type": "subtitle", "time": 18139.91, "timestamp": "05:02:19", "text": "锦标赛。"}, {"type": "subtitle", "time": 18142.948, "timestamp": "05:02:22", "text": "哦，这位《任天堂明星大乱斗》玩家的目标是成为"}, {"type": "subtitle", "time": 18148.23, "timestamp": "05:02:28", "text": "什么？"}, {"type": "subtitle", "time": 18150.39, "timestamp": "05:02:30", "text": "为什么感觉就像我去过的地方一样？"}, {"type": "subtitle", "time": 18152.788, "timestamp": "05:02:32", "text": "通过？ [笑声]"}, {"type": "subtitle", "time": 18155.11, "timestamp": "05:02:35", "text": "他的游戏通过他所有的……都变得清晰起来"}, {"type": "subtitle", "time": 18156.868, "timestamp": "05:02:36", "text": "赞助商撤资了。他仍然被禁止入内"}, {"type": "subtitle", "time": 18160.788, "timestamp": "05:02:40", "text": "锦标赛。所以，那是一样的。"}, {"type": "subtitle", "time": 18163.03, "timestamp": "05:02:43", "text": "这里发生在我身上的事。你"}, {"type": "subtitle", "time": 18164.55, "timestamp": "05:02:44", "text": "知道，"}, {"type": "subtitle", "time": 18167.67, "timestamp": "05:02:47", "text": "那些愿意给我提供资源的人，比如"}, {"type": "subtitle", "time": 18171.03, "timestamp": "05:02:51", "text": "流资产和"}, {"type": "subtitle", "time": 18174.31, "timestamp": "05:02:54", "text": "我自制的粉丝音乐专辑之类的东西"}, {"type": "subtitle", "time": 18177.27, "timestamp": "05:02:57", "text": "谁为我做了东西。不能用那个"}, {"type": "subtitle", "time": 18179.75, "timestamp": "05:02:59", "text": "不再是了。"}]
[{"type": "subtitle", "time": 16381.91, "timestamp": "04:33:01", "text": "委托创作这幅艺术作品"}, {"type": "subtitle", "time": 16384.23, "timestamp": "04:33:04", "text": "男人"}, {"type": "subtitle", "time": 16395.189, "timestamp": "04:33:15", "text": "但说实话，我想做这样的事"}, {"type": "subtitle", "time": 16398.07, "timestamp": "04:33:18", "text": "我希望将来有机会能接一些委托。"}, {"type": "subtitle", "time": 16400.31, "timestamp": "04:33:20", "text": "但是，嗯，我有一位专业人士"}, {"type": "subtitle", "time": 16403.029, "timestamp": "04:33:23", "text": "某种综合症或其他疾病。好的。"}, {"type": "subtitle", "time": 16405.349, "timestamp": "04:33:25", "text": "由于这个原因"}, {"type": "subtitle", "time": 16408.15, "timestamp": "04:33:28", "text": "由于这种完美主义综合症或"}, {"type": "subtitle", "time": 16409.91, "timestamp": "04:33:29", "text": "某物"}, {"type": "subtitle", "time": 16414.15, "timestamp": "04:33:34", "text": "我觉得，如果它不完美，那就不是完美。"}, {"type": "subtitle", "time": 16417.91, "timestamp": "04:33:37", "text": "我不想接委托，因为如果"}, {"type": "subtitle", "time": 16421.75, "timestamp": "04:33:41", "text": "我正在接一个委托，我想让我的客户……"}, {"type": "subtitle", "time": 16426.07, "timestamp": "04:33:46", "text": "要感到满意，并且对……"}, {"type": "subtitle", "time": 16428.709, "timestamp": "04:33:48", "text": "这项工作是"}, {"type": "subtitle", "time": 16431.91, "timestamp": "04:33:51", "text": "呃，就像一个完整的产品一样"}, {"type": "subtitle", "time": 16435.109, "timestamp": "04:33:55", "text": "而不是敷衍了事地传球。"}, {"type": "subtitle", "time": 16438.39, "timestamp": "04:33:58", "text": "那是我的强项。"}]
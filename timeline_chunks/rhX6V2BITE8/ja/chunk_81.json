[{"type": "subtitle", "time": 4861.43, "timestamp": "01:21:01", "text": "これをスクロール可能にすることは可能ですか？"}, {"type": "subtitle", "time": 4863.99, "timestamp": "01:21:03", "text": "これは走り書きできると思いますか、それとも"}, {"type": "subtitle", "time": 4868.229, "timestamp": "01:21:08", "text": "えっと、これをどうにかして使う"}, {"type": "subtitle", "time": 4875.87, "timestamp": "01:21:15", "text": "何か？これはそうではないと思います"}, {"type": "subtitle", "time": 4878.55, "timestamp": "01:21:18", "text": "可能。でも、もし"}, {"type": "subtitle", "time": 4881.83, "timestamp": "01:21:21", "text": "曲が"}, {"type": "subtitle", "time": 4884.229, "timestamp": "01:21:24", "text": "バックエンドで歌詞を探すことができます"}, {"type": "subtitle", "time": 4885.79, "timestamp": "01:21:25", "text": "具体的な"}, {"type": "subtitle", "time": 4888.229, "timestamp": "01:21:28", "text": "歌、だって君はもう"}, {"type": "subtitle", "time": 4890.07, "timestamp": "01:21:30", "text": "データ。日本の歌なら、"}, {"type": "subtitle", "time": 4893.709, "timestamp": "01:21:33", "text": "英語バージョンは、"}, {"type": "subtitle", "time": 4895.61, "timestamp": "01:21:35", "text": "プラットフォーム。"}, {"type": "subtitle", "time": 4897.79, "timestamp": "01:21:37", "text": "[音楽]"}, {"type": "subtitle", "time": 4900.669, "timestamp": "01:21:40", "text": "ええと、わかりました。"}, {"type": "subtitle", "time": 4904.55, "timestamp": "01:21:44", "text": "えっと、待って、試してみたら迷子になっちゃった"}, {"type": "subtitle", "time": 4907.11, "timestamp": "01:21:47", "text": "あなたのコメントを読ませていただきます。"}, {"type": "subtitle", "time": 4908.95, "timestamp": "01:21:48", "text": "EPAはどうでしょうか？アクセス権を与えても大丈夫ですか？"}, {"type": "subtitle", "time": 4911.27, "timestamp": "01:21:51", "text": "Spotifyのようなユーザーデータを簡単に"}, {"type": "subtitle", "time": 4912.95, "timestamp": "01:21:52", "text": "以前は私がそれを壊すのが好きだった？あなたが知っている"}]
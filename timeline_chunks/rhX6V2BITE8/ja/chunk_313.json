[{"type": "subtitle", "time": 18780.83, "timestamp": "05:13:00", "text": "チャット。"}, {"type": "subtitle", "time": 18783.11, "timestamp": "05:13:03", "text": "わかった。わかった。血ですよね？その"}, {"type": "subtitle", "time": 18785.91, "timestamp": "05:13:05", "text": "血のことですよね？私は大丈夫ですか？大丈夫です。私"}, {"type": "subtitle", "time": 18788.31, "timestamp": "05:13:08", "text": "次は私が考え出すだろう"}, {"type": "subtitle", "time": 18791.51, "timestamp": "05:13:11", "text": "ビリーのためにバブジアンをストリーミングするカテゴリ"}, {"type": "subtitle", "time": 18793.43, "timestamp": "05:13:13", "text": "ビリー、カテゴリーがわからないから"}, {"type": "subtitle", "time": 18796.55, "timestamp": "05:13:16", "text": "あれ。今は中国語版です。だからそれは"}, {"type": "subtitle", "time": 18799.07, "timestamp": "05:13:19", "text": "ヴァレラントにとっては難しい状況だ。彼らはそれを"}, {"type": "subtitle", "time": 18802.59, "timestamp": "05:13:22", "text": "恐れ知らずの恐れ知らずの勝利か"}, {"type": "subtitle", "time": 18805.67, "timestamp": "05:13:25", "text": "何か。うん。だから、ある意味、ある意味"}, {"type": "subtitle", "time": 18807.39, "timestamp": "05:13:27", "text": "種の"}, {"type": "subtitle", "time": 18809.07, "timestamp": "05:13:29", "text": "奇妙な。"}, {"type": "subtitle", "time": 18811.91, "timestamp": "05:13:31", "text": "ああ、私もその試合をプレイしています。あなた"}, {"type": "subtitle", "time": 18821.67, "timestamp": "05:13:41", "text": "[拍手]"}, {"type": "subtitle", "time": 18824.19, "timestamp": "05:13:44", "text": "人々はこれをプレイします"}, {"type": "subtitle", "time": 18828.75, "timestamp": "05:13:48", "text": "ゲーム。えーと、救急箱は8"}]
[{"type": "subtitle", "time": 3001.069, "timestamp": "00:50:01", "text": "クレメンは午後9時10分です。"}, {"type": "subtitle", "time": 3007.589, "timestamp": "00:50:07", "text": "えっと、9時を過ぎると、午後10時くらいになります。 IST。"}, {"type": "subtitle", "time": 3009.95, "timestamp": "00:50:09", "text": "えーと、2番目"}, {"type": "subtitle", "time": 3013.549, "timestamp": "00:50:13", "text": "週。えっと"}, {"type": "subtitle", "time": 3017.549, "timestamp": "00:50:17", "text": "シャンは、非イモ類で、良い"}, {"type": "subtitle", "time": 3020.39, "timestamp": "00:50:20", "text": "友人。いや、むしろ最初のやり取りといった感じかな"}, {"type": "subtitle", "time": 3022.43, "timestamp": "00:50:22", "text": "彼女と一緒に。"}, {"type": "chat", "time": 3031.906, "timestamp": "00:50:31", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "so organised o.0"}, {"type": "subtitle", "time": 3033.71, "timestamp": "00:50:33", "text": "[音楽]"}, {"type": "subtitle", "time": 3039.87, "timestamp": "00:50:39", "text": "ええ、そうですね。ああ、彼女はもっと"}, {"type": "subtitle", "time": 3042.95, "timestamp": "00:50:42", "text": "柔軟でより柔軟だが、彼女は"}, {"type": "subtitle", "time": 3045.829, "timestamp": "00:50:45", "text": "彼女のマイクを修理して。それで彼女は明日と言った"}, {"type": "subtitle", "time": 3048.63, "timestamp": "00:50:48", "text": "おそらくうまくいくでしょうが、"}, {"type": "subtitle", "time": 3050.79, "timestamp": "00:50:50", "text": "私にとって初めてのやり取りです。ぜひ"}, {"type": "subtitle", "time": 3053.069, "timestamp": "00:50:53", "text": "彼女と少なくとも2時間過ごす"}, {"type": "subtitle", "time": 3056.03, "timestamp": "00:50:56", "text": "見せる。スペースがあるのですが、できますか？"}, {"type": "subtitle", "time": 3059.75, "timestamp": "00:50:59", "text": "明日？明日、私は思う、待って、私は"}]
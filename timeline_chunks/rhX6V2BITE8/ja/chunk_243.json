[{"type": "subtitle", "time": 14594.429, "timestamp": "04:03:14", "text": "しかし色は"}, {"type": "subtitle", "time": 14607.79, "timestamp": "04:03:27", "text": "私は一体何を飲んだんだっけ？私はしません"}, {"type": "subtitle", "time": 14609.79, "timestamp": "04:03:29", "text": "知る"}, {"type": "subtitle", "time": 14613.67, "timestamp": "04:03:33", "text": "ああ、この男は何を売っているんだ。こんにちは、"}, {"type": "subtitle", "time": 14617.07, "timestamp": "04:03:37", "text": "爪。それを買うことにします。それを手に入れろ。"}, {"type": "subtitle", "time": 14619.63, "timestamp": "04:03:39", "text": "ええと、それで"}, {"type": "subtitle", "time": 14630.51, "timestamp": "04:03:50", "text": "これらの戦い。短機関銃の弾薬。すべて購入"}, {"type": "subtitle", "time": 14633.67, "timestamp": "04:03:53", "text": "全て。私は数百万ドルの現金を持っています。作ろう"}, {"type": "subtitle", "time": 14639.63, "timestamp": "04:03:59", "text": "それは一つだ。つまり、すべてネジでできているということだ。はい。分野"}]
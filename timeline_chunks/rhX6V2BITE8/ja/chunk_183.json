[{"type": "subtitle", "time": 10980.95, "timestamp": "03:03:00", "text": "心。このDLCが大好きです。たくさん追加します"}, {"type": "subtitle", "time": 10983.83, "timestamp": "03:03:03", "text": "ストーリーと新しいゲームシステム。楽しめ"}, {"type": "subtitle", "time": 10987.83, "timestamp": "03:03:07", "text": "心から。あなたにも気に入ってもらえると嬉しいです。"}, {"type": "subtitle", "time": 10989.71, "timestamp": "03:03:09", "text": "私も"}, {"type": "subtitle", "time": 10992.99, "timestamp": "03:03:12", "text": "盛り上がっている。これは何ですか"}, {"type": "subtitle", "time": 10996.07, "timestamp": "03:03:16", "text": "サイン？もちろん、弾薬は持っていません"}, {"type": "subtitle", "time": 10999.75, "timestamp": "03:03:19", "text": "その銃の中に。ドイツ製のサイレンサー付きピストル。"}, {"type": "subtitle", "time": 11003.99, "timestamp": "03:03:23", "text": "消音弾は持っていません。ああ、私は"}, {"type": "subtitle", "time": 11005.79, "timestamp": "03:03:25", "text": "実際には持っていない"}, {"type": "subtitle", "time": 11009.63, "timestamp": "03:03:29", "text": "弾薬？私はとても"}, {"type": "subtitle", "time": 11013.83, "timestamp": "03:03:33", "text": "もの。 14 ゴージャス。おお。わかった。えっと、もし"}, {"type": "subtitle", "time": 11015.83, "timestamp": "03:03:35", "text": "そうです、待ってください"}, {"type": "subtitle", "time": 11024.79, "timestamp": "03:03:44", "text": "推測。えっと、リボンはつけようかな。いいえ"}, {"type": "subtitle", "time": 11039.83, "timestamp": "03:03:59", "text": "剣。ああ、これは私が今まで見たことのない新しいシムです"}]
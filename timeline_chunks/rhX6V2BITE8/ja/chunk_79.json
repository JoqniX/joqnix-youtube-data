[{"type": "subtitle", "time": 4746.149, "timestamp": "01:19:06", "text": "配信で公開しても大丈夫ですか？は"}, {"type": "subtitle", "time": 4748.55, "timestamp": "01:19:08", "text": "それで大丈夫ですか？点火しても大丈夫ですか？"}, {"type": "subtitle", "time": 4785.75, "timestamp": "01:19:45", "text": "DM。ええ、もしあなたがよろしければ"}, {"type": "subtitle", "time": 4787.75, "timestamp": "01:19:47", "text": "ストリームを表示していますが、それは私や"}, {"type": "subtitle", "time": 4789.55, "timestamp": "01:19:49", "text": "イフィ、それは"}, {"type": "subtitle", "time": 4793.39, "timestamp": "01:19:53", "text": "なぜ。わかった。こんにちは。"}, {"type": "subtitle", "time": 4795.99, "timestamp": "01:19:55", "text": "わかりました、後で話しましょう。こんにちは。"}, {"type": "subtitle", "time": 4798.149, "timestamp": "01:19:58", "text": "気をつけて。ヘロンの息子よ、幸運を祈る"}]
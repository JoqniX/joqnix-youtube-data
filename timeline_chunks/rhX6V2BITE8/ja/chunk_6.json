[{"type": "subtitle", "time": 362.35, "timestamp": "00:06:02", "text": "これ？ 2時間前。待って、"}, {"type": "subtitle", "time": 373.75, "timestamp": "00:06:13", "text": "そこには。感謝"}, {"type": "subtitle", "time": 375.23, "timestamp": "00:06:15", "text": "[音楽]"}, {"type": "subtitle", "time": 377.909, "timestamp": "00:06:17", "text": "あなた、悪名高きカレン。わからない"}, {"type": "subtitle", "time": 379.43, "timestamp": "00:06:19", "text": "あなたはまだここにいますが、"}, {"type": "subtitle", "time": 381.15, "timestamp": "00:06:21", "text": "フォローもお願いします。"}, {"type": "subtitle", "time": 384.71, "timestamp": "00:06:24", "text": "いらっしゃいませ。えっと、スカイ・マシャンです。こんにちは。えっと、"}, {"type": "subtitle", "time": 386.23, "timestamp": "00:06:26", "text": "彼女はベッドにいるんだよ、息子よ。あなたが"}, {"type": "subtitle", "time": 387.83, "timestamp": "00:06:27", "text": "まだここにいますが、来てくれてありがとう"}, {"type": "subtitle", "time": 389.83, "timestamp": "00:06:29", "text": "Twitchで配信中。あなたは3時に来ました"}, {"type": "subtitle", "time": 391.469, "timestamp": "00:06:31", "text": "昨日の午前中。私は"}, {"type": "subtitle", "time": 398.15, "timestamp": "00:06:38", "text": "えっと、アマン、いつも来てくれてありがとう"}, {"type": "subtitle", "time": 401.749, "timestamp": "00:06:41", "text": "本外帝国の三男、ありがとう"}, {"type": "subtitle", "time": 404.39, "timestamp": "00:06:44", "text": "Twitchでフォローしていただき、またお越しいただきありがとうございます。"}, {"type": "subtitle", "time": 406.71, "timestamp": "00:06:46", "text": "どうもありがとう。ジョブズさん、ありがとう"}, {"type": "subtitle", "time": 409.35, "timestamp": "00:06:49", "text": "通りかかるよ。お越しいただきありがとうございます。希望"}, {"type": "subtitle", "time": 412.23, "timestamp": "00:06:52", "text": "お元気でお過ごしでしょうか。でも、そうだね、"}, {"type": "subtitle", "time": 413.99, "timestamp": "00:06:53", "text": "私たちはコラボレーションする予定です"}, {"type": "subtitle", "time": 419.189, "timestamp": "00:06:59", "text": "ヒジャブ・シスタンは日曜日の午後12時30分に放送されます。"}]
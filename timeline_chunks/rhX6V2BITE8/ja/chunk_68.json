[{"type": "subtitle", "time": 4082.109, "timestamp": "01:08:02", "text": "つまり、つまり"}, {"type": "subtitle", "time": 4084.789, "timestamp": "01:08:04", "text": "うん。うん。私たちは話したのを覚えているし"}, {"type": "subtitle", "time": 4087.43, "timestamp": "01:08:07", "text": "もの。私はあなたが遊んでいたと思います"}, {"type": "subtitle", "time": 4089.95, "timestamp": "01:08:09", "text": "覚えてる？"}, {"type": "subtitle", "time": 4095.109, "timestamp": "01:08:15", "text": "Sky Children of the Light をストリーミング配信する"}, {"type": "subtitle", "time": 4097.829, "timestamp": "01:08:17", "text": "そして、それについてあなたに尋ねたところ、"}, {"type": "subtitle", "time": 4100.87, "timestamp": "01:08:20", "text": "モバイルゲームだと説明して"}, {"type": "subtitle", "time": 4103.43, "timestamp": "01:08:23", "text": "これとこれ、えっと、私の記憶が正しければ"}, {"type": "subtitle", "time": 4105.189, "timestamp": "01:08:25", "text": "その通りです。どこで"}, {"type": "subtitle", "time": 4107.309, "timestamp": "01:08:27", "text": "それ"}, {"type": "subtitle", "time": 4109.39, "timestamp": "01:08:29", "text": "会話、"}, {"type": "subtitle", "time": 4113.789, "timestamp": "01:08:33", "text": "ああ、覚えてるよ"}, {"type": "subtitle", "time": 4116.55, "timestamp": "01:08:36", "text": "ついに。うん。うん。そして私は一度もプレイしたことがない"}, {"type": "subtitle", "time": 4119.229, "timestamp": "01:08:39", "text": "そのゲームは"}, {"type": "subtitle", "time": 4122.149, "timestamp": "01:08:42", "text": "今。 Steamにはまだ持ってるけど、うん、"}, {"type": "subtitle", "time": 4124.829, "timestamp": "01:08:44", "text": "プレイしなきゃ。覚えていますか"}, {"type": "subtitle", "time": 4127.91, "timestamp": "01:08:47", "text": "それ？今は本当にめちゃくちゃだ。私はまだ"}, {"type": "subtitle", "time": 4130.51, "timestamp": "01:08:50", "text": "これを覚えておいてください。ああ、"}]
[{"type": "subtitle", "time": 20942.11, "timestamp": "05:49:02", "text": "[音楽]"}, {"type": "subtitle", "time": 20943.788, "timestamp": "05:49:03", "text": "仕事。"}, {"type": "subtitle", "time": 20947.868, "timestamp": "05:49:07", "text": "わかった。まあ、でも、楽しかったよ"}, {"type": "subtitle", "time": 20952.15, "timestamp": "05:49:12", "text": "正直。ジムなんて誰が必要とするの？何？使用する"}, {"type": "subtitle", "time": 20956.15, "timestamp": "05:49:16", "text": "足場をつかんでメカニズムを2回実行します。あなた"}, {"type": "subtitle", "time": 20967.548, "timestamp": "05:49:27", "text": "何？ああ、わかりました。私たちは行く"}, {"type": "subtitle", "time": 20970.91, "timestamp": "05:49:30", "text": "中。滑り台はありません"}, {"type": "subtitle", "time": 20974.15, "timestamp": "05:49:34", "text": "低い。うん、僕はApexに慣れすぎてるんだ"}, {"type": "subtitle", "time": 20975.75, "timestamp": "05:49:35", "text": "けれど。私はほとんどそのゲームをプレイしません。"}, {"type": "subtitle", "time": 20985.788, "timestamp": "05:49:45", "text": "おい、パンチの威力を弱めろよ。"}, {"type": "subtitle", "time": 20990.23, "timestamp": "05:49:50", "text": "パンチ、パンチ、パンチ、パンチ。こんにちは。ニース"}, {"type": "subtitle", "time": 20993.03, "timestamp": "05:49:53", "text": "あなたにお会いできて嬉しいです。はじめまして。いい"}, {"type": "subtitle", "time": 20996.948, "timestamp": "05:49:56", "text": "お会いしましょう。はじめまして。お会いできて嬉しいです"}]
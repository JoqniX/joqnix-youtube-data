[{"type": "subtitle", "time": 3661.109, "timestamp": "01:01:01", "text": "訪問した"}, {"type": "subtitle", "time": 3662.27, "timestamp": "01:01:02", "text": "私の"}, {"type": "subtitle", "time": 3664.549, "timestamp": "01:01:04", "text": "おばあちゃんに最後にもう一度会って抱きしめてあげて"}, {"type": "subtitle", "time": 3665.549, "timestamp": "01:01:05", "text": "そして"}, {"type": "subtitle", "time": 3670.309, "timestamp": "01:01:10", "text": "物と可能であれば私が訪問するすべての人"}, {"type": "subtitle", "time": 3674.23, "timestamp": "01:01:14", "text": "実際に会って話をした全員"}, {"type": "subtitle", "time": 3676.71, "timestamp": "01:01:16", "text": "良い人たちとかそういうの、私がやってるなら"}, {"type": "subtitle", "time": 3679.51, "timestamp": "01:01:19", "text": "もちろんオンラインでやるよ"}, {"type": "subtitle", "time": 3681.829, "timestamp": "01:01:21", "text": "もちろんオフラインでも行くので"}, {"type": "subtitle", "time": 3684.51, "timestamp": "01:01:24", "text": "一日中それをやるのは、おそらく"}, {"type": "subtitle", "time": 3688.95, "timestamp": "01:01:28", "text": "私自身が行く可能性もあるし、ご存知の通り"}, {"type": "subtitle", "time": 3692.03, "timestamp": "01:01:32", "text": "彼に伝えて"}, {"type": "subtitle", "time": 3695.589, "timestamp": "01:01:35", "text": "うん。ええ、そうですね、そうするべきですね。私"}, {"type": "subtitle", "time": 3698.829, "timestamp": "01:01:38", "text": "そうすべきだ。絶対にそうすべきだ"}, {"type": "subtitle", "time": 3701.51, "timestamp": "01:01:41", "text": "それ。なるほど、そういうことか。たった1つだけ"}, {"type": "subtitle", "time": 3703.349, "timestamp": "01:01:43", "text": "時間とか何とか。たとえ彼らが"}, {"type": "subtitle", "time": 3705.75, "timestamp": "01:01:45", "text": "遠く離れていても、できる限り近づきます"}, {"type": "subtitle", "time": 3707.87, "timestamp": "01:01:47", "text": "で"}, {"type": "subtitle", "time": 3710.63, "timestamp": "01:01:50", "text": "時間。もちろん、私はただそうしなければならない"}, {"type": "subtitle", "time": 3713.63, "timestamp": "01:01:53", "text": "気をつけて、私はスクーターに乗っているから"}, {"type": "subtitle", "time": 3716.71, "timestamp": "01:01:56", "text": "迅速に。それはまずい。私は"}, {"type": "subtitle", "time": 3719.03, "timestamp": "01:01:59", "text": "日本。私はきちんと体調を整えていなければならない。"}]
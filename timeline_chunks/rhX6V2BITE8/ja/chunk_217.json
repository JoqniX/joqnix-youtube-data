[{"type": "subtitle", "time": 13020.429, "timestamp": "03:37:00", "text": "そうしなかった、"}, {"type": "subtitle", "time": 13022.79, "timestamp": "03:37:02", "text": "男。わかった、いいよ。少なくとも私は"}, {"type": "subtitle", "time": 13026.03, "timestamp": "03:37:06", "text": "今回は弾薬を用意しました。"}, {"type": "subtitle", "time": 13028.469, "timestamp": "03:37:08", "text": "いや。少なくとも弾薬は手に入るだろう"}, {"type": "subtitle", "time": 13056.389, "timestamp": "03:37:36", "text": "彼を殺せ。彼はなぜ死んでいないのか"}, {"type": "subtitle", "time": 13067.83, "timestamp": "03:37:47", "text": "お守りを2つ手に入れた。それでは、"}, {"type": "subtitle", "time": 13069.79, "timestamp": "03:37:49", "text": "このヘッド"}]
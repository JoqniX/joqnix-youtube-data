[{"type": "subtitle", "time": 20347.99, "timestamp": "05:39:07", "text": "神。こんにちは。えっと、クロノス。私は手に入れたい"}, {"type": "subtitle", "time": 20350.99, "timestamp": "05:39:10", "text": "彼の戦利品だが、それは"}, {"type": "subtitle", "time": 20354.548, "timestamp": "05:39:14", "text": "危険？しかし、他にも人はいる。"}, {"type": "subtitle", "time": 20376.03, "timestamp": "05:39:36", "text": "ああ。あ、こんにちは。"}, {"type": "subtitle", "time": 20396.19, "timestamp": "05:39:56", "text": "あなた。"}]
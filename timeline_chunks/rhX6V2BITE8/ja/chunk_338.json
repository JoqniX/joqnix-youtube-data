[{"type": "subtitle", "time": 20294.51, "timestamp": "05:38:14", "text": "言い訳"}, {"type": "subtitle", "time": 20297.99, "timestamp": "05:38:17", "text": "私、ピク？えっと、私は自分が公の場にいることは分かっていますが、"}, {"type": "subtitle", "time": 20299.39, "timestamp": "05:38:19", "text": "しかしそれは"}, {"type": "subtitle", "time": 20306.868, "timestamp": "05:38:26", "text": "犬。撃ち抜くことすらできない"}, {"type": "subtitle", "time": 20319.07, "timestamp": "05:38:39", "text": "フープ。私をからかってるの？このゲーム"}, {"type": "subtitle", "time": 20321.868, "timestamp": "05:38:41", "text": "は"}, {"type": "subtitle", "time": 20327.628, "timestamp": "05:38:47", "text": "バカ。私を処刑してください。撮影中です。"}, {"type": "subtitle", "time": 20330.35, "timestamp": "05:38:50", "text": "わかった。"}, {"type": "subtitle", "time": 20333.41, "timestamp": "05:38:53", "text": "おお。ああ、"}]
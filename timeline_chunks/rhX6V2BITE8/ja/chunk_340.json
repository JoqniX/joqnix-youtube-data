[{"type": "subtitle", "time": 20425.07, "timestamp": "05:40:25", "text": "わかった、行ってみるよ。私は必要としている"}, {"type": "subtitle", "time": 20429.19, "timestamp": "05:40:29", "text": "戦利品。よし。戦術的、戦術的、"}, {"type": "subtitle", "time": 20431.19, "timestamp": "05:40:31", "text": "位置変更。"}, {"type": "subtitle", "time": 20432.35, "timestamp": "05:40:32", "text": "それをやってください"}, {"type": "subtitle", "time": 20457.868, "timestamp": "05:40:57", "text": "行く。待って。あの男は一体どこにいたんだっけ？以上"}]
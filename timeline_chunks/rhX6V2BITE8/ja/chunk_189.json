[{"type": "subtitle", "time": 11363.75, "timestamp": "03:09:23", "text": "男。つまり、これは"}, {"type": "subtitle", "time": 11365.67, "timestamp": "03:09:25", "text": "太陽。"}, {"type": "subtitle", "time": 11367.389, "timestamp": "03:09:27", "text": "つまりあなたは"}, {"type": "subtitle", "time": 11369.95, "timestamp": "03:09:29", "text": "リーダー。あなたはリーダーです。"}, {"type": "subtitle", "time": 11372.95, "timestamp": "03:09:32", "text": "いや、私にはできると思う、私はあなたを神と呼ぶか"}, {"type": "subtitle", "time": 11377.03, "timestamp": "03:09:37", "text": "太陽の息子、あるいは太陽の女神。うん。こんにちは、ブラッド。"}, {"type": "subtitle", "time": 11378.269, "timestamp": "03:09:38", "text": "[音楽]"}, {"type": "subtitle", "time": 11381.71, "timestamp": "03:09:41", "text": "いらっしゃいませ。そしてこちらは腕時計です"}, {"type": "subtitle", "time": 11391.15, "timestamp": "03:09:51", "text": "おお。こういう開店とかが懐かしいな。"}]
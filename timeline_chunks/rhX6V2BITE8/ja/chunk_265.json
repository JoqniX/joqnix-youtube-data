[{"type": "subtitle", "time": 15910.429, "timestamp": "04:25:10", "text": "スポナー。ああ、"}, {"type": "subtitle", "time": 15913.55, "timestamp": "04:25:13", "text": "神。キャッチ"}, {"type": "subtitle", "time": 15916.67, "timestamp": "04:25:16", "text": "あなた。私はどうですか"}, {"type": "subtitle", "time": 15932.51, "timestamp": "04:25:32", "text": "来て"}, {"type": "subtitle", "time": 15937.51, "timestamp": "04:25:37", "text": "自分。かかってこい。ジャンプ。あ、待って。いいえ、私は"}, {"type": "subtitle", "time": 15939.71, "timestamp": "04:25:39", "text": "君があんな風にジャンプするとは思わなかったよ。"}, {"type": "subtitle", "time": 15942.389, "timestamp": "04:25:42", "text": "こんにちは。君があんなにジャンプするとは思わなかった"}, {"type": "subtitle", "time": 15945.75, "timestamp": "04:25:45", "text": "それ。私はただあなたに"}, {"type": "subtitle", "time": 15949.03, "timestamp": "04:25:49", "text": "水に飛び込んで死ぬ、でもああ、いや。"}]
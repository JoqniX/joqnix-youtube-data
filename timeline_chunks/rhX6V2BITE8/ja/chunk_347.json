[{"type": "subtitle", "time": 20824.15, "timestamp": "05:47:04", "text": "AKM。何てことだ。最初の試合。後"}, {"type": "subtitle", "time": 20834.628, "timestamp": "05:47:14", "text": "何？これは一体どういう主張ですか？これは何ですか？"}, {"type": "subtitle", "time": 20843.23, "timestamp": "05:47:23", "text": "金庫。何が"}, {"type": "subtitle", "time": 20847.47, "timestamp": "05:47:27", "text": "この鍵？鍵は必要ありません。"}, {"type": "subtitle", "time": 20853.99, "timestamp": "05:47:33", "text": "クレジットって何？家まで連れて帰ってください。 1回プレイする。"}, {"type": "subtitle", "time": 20857.99, "timestamp": "05:47:37", "text": "3回プレイしてください。トップ10に10回ランクインする。"}, {"type": "subtitle", "time": 20860.948, "timestamp": "05:47:40", "text": "5回。 『サヴァ』の上映時間は合計60分です。"}, {"type": "subtitle", "time": 20863.35, "timestamp": "05:47:43", "text": "観戦時間を含む節約時間"}, {"type": "subtitle", "time": 20867.03, "timestamp": "05:47:47", "text": "あなたのチームメイト。おお。ああ、400ドルもらえるよ"}, {"type": "subtitle", "time": 20868.35, "timestamp": "05:47:48", "text": "コイン。"}, {"type": "subtitle", "time": 20870.11, "timestamp": "05:47:50", "text": "おお。ニース"}, {"type": "subtitle", "time": 20875.83, "timestamp": "05:47:55", "text": "1つ。それは良い。はい、またプレイします。"}, {"type": "subtitle", "time": 20879.23, "timestamp": "05:47:59", "text": "何てことだ。うん。ああ、私は"}]
[{"type": "subtitle", "time": 18545.628, "timestamp": "05:09:05", "text": "[拍手]"}, {"type": "subtitle", "time": 18553.07, "timestamp": "05:09:13", "text": "頭"}, {"type": "subtitle", "time": 18566.15, "timestamp": "05:09:26", "text": "ああ、彼は私を見つけて、彼はただ単に"}, {"type": "subtitle", "time": 18568.03, "timestamp": "05:09:28", "text": "取り壊されたばかり"}, {"type": "subtitle", "time": 18576.67, "timestamp": "05:09:36", "text": "ショット。あ、待って。忘れた。忘れた。私"}, {"type": "subtitle", "time": 18596.868, "timestamp": "05:09:56", "text": "忘れた。待って。なぜぼかすことができないのですか？何？"}]
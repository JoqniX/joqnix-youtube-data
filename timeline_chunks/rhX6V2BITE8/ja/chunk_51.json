[{"type": "subtitle", "time": 3063.99, "timestamp": "00:51:03", "text": "彼女のタイムゾーンがわからない。だから私は"}, {"type": "subtitle", "time": 3067.43, "timestamp": "00:51:07", "text": "えっと、彼女にそれを聞いてみて。でも、私はできる"}, {"type": "subtitle", "time": 3070.39, "timestamp": "00:51:10", "text": "明日の固定タイムゾーンを設定してください"}, {"type": "subtitle", "time": 3072.99, "timestamp": "00:51:12", "text": "彼女。うん。シャン"}, {"type": "subtitle", "time": 3077.829, "timestamp": "00:51:17", "text": "ああ、カイ・カイアマにDMする必要があるカイ・チャマは言いました"}, {"type": "subtitle", "time": 3080.069, "timestamp": "00:51:20", "text": "WhatsAppで彼が言った「待って、私に"}, {"type": "subtitle", "time": 3082.15, "timestamp": "00:51:22", "text": "私のWhatsAppを確認してください。私の"}, {"type": "subtitle", "time": 3084.47, "timestamp": "00:51:24", "text": "WhatsApp。彼は何て言ったの？何が"}, {"type": "subtitle", "time": 3088.15, "timestamp": "00:51:28", "text": "彼はそう言った？現実世界で最高の自分を手に入れるにはどうすればいいですか？"}, {"type": "subtitle", "time": 3091.589, "timestamp": "00:51:31", "text": "友達がここに来て話をして"}, {"type": "subtitle", "time": 3094.39, "timestamp": "00:51:34", "text": "私はあまりそうではないことを彼に示して、彼は"}, {"type": "subtitle", "time": 3098.39, "timestamp": "00:51:38", "text": "ドクはストリーミングを停止し、"}, {"type": "subtitle", "time": 3100.39, "timestamp": "00:51:40", "text": "人生と私がまだ見せたいものすべて"}, {"type": "subtitle", "time": 3101.71, "timestamp": "00:51:41", "text": "彼に"}, {"type": "subtitle", "time": 3104.71, "timestamp": "00:51:44", "text": "ああ、君を僕の"}, {"type": "subtitle", "time": 3109.03, "timestamp": "00:51:49", "text": "快適さ 快適さ 空間をお見せします"}, {"type": "subtitle", "time": 3110.03, "timestamp": "00:51:50", "text": "えーと"}, {"type": "subtitle", "time": 3112.99, "timestamp": "00:51:52", "text": "うん、私は"}, {"type": "subtitle", "time": 3115.91, "timestamp": "00:51:55", "text": "彼が言ったのは「ああ、君は作っていない」ということだった"}, {"type": "chat", "time": 3116.168, "timestamp": "00:51:56", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no
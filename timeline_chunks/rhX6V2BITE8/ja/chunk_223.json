[{"type": "subtitle", "time": 13381.229, "timestamp": "03:43:01", "text": "それで"}, {"type": "subtitle", "time": 13385.63, "timestamp": "03:43:05", "text": "バカ。上から順に。全てはこれだった"}, {"type": "subtitle", "time": 13389.11, "timestamp": "03:43:09", "text": "時間。開けゴマ。"}, {"type": "subtitle", "time": 13398.71, "timestamp": "03:43:18", "text": "わかった、本当にああ、怖い"}, {"type": "subtitle", "time": 13401.07, "timestamp": "03:43:21", "text": "自分。おお"}, {"type": "subtitle", "time": 13406.99, "timestamp": "03:43:26", "text": "神。なんてこった、おい。この男、怖かったよ。"}, {"type": "subtitle", "time": 13409.67, "timestamp": "03:43:29", "text": "自分。どうしたんだ？何てことだ。"}, {"type": "subtitle", "time": 13412.79, "timestamp": "03:43:32", "text": "ジャジールが私を派遣した。ええ、エスキはそうしましたよ。あなたは"}, {"type": "subtitle", "time": 13415.03, "timestamp": "03:43:35", "text": "迷子になった３人のうちの１人。唯一の"}, {"type": "subtitle", "time": 13417.51, "timestamp": "03:43:37", "text": "残り1つ。私はアリーです。あなたは投げ込まれた"}, {"type": "subtitle", "time": 13419.67, "timestamp": "03:43:39", "text": "あの獣。彼らはその状況に放り込まれた"}, {"type": "subtitle", "time": 13422.07, "timestamp": "03:43:42", "text": "あの獣。いいかい、アリ。この場所"}, {"type": "subtitle", "time": 13423.91, "timestamp": "03:43:43", "text": "少なくともある程度は機能していなければならない。"}, {"type": "subtitle", "time": 13425.349, "timestamp": "03:43:45", "text": "そうでなければ、山賊たちは"}, {"type": "subtitle", "time": 13428.229, "timestamp": "03:43:48", "text": "水なら何でも。盗賊たちはここに水を持っている、"}, {"type": "subtitle", "time": 13431.67, "timestamp": "03:43:51", "text": "しかし、農場にはそのようなものはない。多分"}, {"type": "subtitle", "time": 13434.63, "timestamp": "03:43:54", "text": "彼らを別の方向に誘導することができます。はい、私たちはそれを望んでいました。私たちは"}]
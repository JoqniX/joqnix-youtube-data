[{"type": "subtitle", "time": 10297.269, "timestamp": "02:51:37", "text": "[音楽]"}, {"type": "subtitle", "time": 10303.55, "timestamp": "02:51:43", "text": "みんな。つまり"}, {"type": "subtitle", "time": 10306.469, "timestamp": "02:51:46", "text": "オハイオ州。何てことだ。うん。こんにちは、みんな。"}, {"type": "subtitle", "time": 10311.59, "timestamp": "02:51:51", "text": "皆さん、お元気ですか？ヤフー。ヤフー。"}, {"type": "subtitle", "time": 10314.349, "timestamp": "02:51:54", "text": "仕事。今日、"}, {"type": "subtitle", "time": 10318.309, "timestamp": "02:51:58", "text": "今日は、私たちは遊ぶつもりです"}]
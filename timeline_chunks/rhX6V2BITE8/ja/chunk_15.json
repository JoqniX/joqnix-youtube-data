[{"type": "subtitle", "time": 901.59, "timestamp": "00:15:01", "text": "あなた。それでもあなたは私のことを覚えていてくれた。それ"}, {"type": "subtitle", "time": 903.03, "timestamp": "00:15:03", "text": "本当に大きな意味があります。ということで、ありがとうございます"}, {"type": "subtitle", "time": 910.11, "timestamp": "00:15:10", "text": "モデル。しかしもし"}, {"type": "subtitle", "time": 911.949, "timestamp": "00:15:11", "text": "私"}, {"type": "subtitle", "time": 914.269, "timestamp": "00:15:14", "text": "ああ、嬉しいよ"}, {"type": "subtitle", "time": 917.59, "timestamp": "00:15:17", "text": "今のところ、みんな親切にしてくれている。全て"}, {"type": "subtitle", "time": 920.11, "timestamp": "00:15:20", "text": "私がDMを送った人たち、"}, {"type": "subtitle", "time": 922.55, "timestamp": "00:15:22", "text": "右？縁起でもないことを言うべきかどうかわからない"}, {"type": "subtitle", "time": 926.15, "timestamp": "00:15:26", "text": "そうですが、怖いです。でも、えっと"}, {"type": "subtitle", "time": 928.87, "timestamp": "00:15:28", "text": "これまでDMを送った人たち、えーと全員"}, {"type": "subtitle", "time": 932.629, "timestamp": "00:15:32", "text": "良かったよ。えーと、新しいものに関しては"}, {"type": "subtitle", "time": 934.23, "timestamp": "00:15:34", "text": "これまでコラボレーションしたことのない新しい人々、"}, {"type": "subtitle", "time": 936.71, "timestamp": "00:15:36", "text": "以前にやり取りしたことがあるなら、必ずそうします"}, {"type": "subtitle", "time": 939.67, "timestamp": "00:15:39", "text": "VCワイプチェックみたいな感じで、"}, {"type": "subtitle", "time": 943.949, "timestamp": "00:15:43", "text": "可能であれば事前に。"}, {"type": "subtitle", "time": 946.949, "timestamp": "00:15:46", "text": "えーと、一部の人にとっては、私は"}, {"type": "subtitle", "time": 949.99, "timestamp": "00:15:49", "text": "私のことを見ていて知っている人たち"}, {"type": "subtitle", "time": 953.03, "timestamp": "00:15:53", "text": "私と私のことはそれで大丈夫です。彼らはその方法を知っている"}, {"type": "subtitle", "time": 956.629, "timestamp": "00:15:56", "text": "そうですよね？ええと、その他すべて。しかし"}, {"type": "subtitle", "time": 959.67, "timestamp": "00:15:59", "text": "ええ、新しい人たちには、"}]
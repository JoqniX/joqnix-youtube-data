[{"type": "subtitle", "time": 12540.95, "timestamp": "03:29:00", "text": "ここにあったんじゃないの？"}, {"type": "subtitle", "time": 12543.03, "timestamp": "03:29:03", "text": "あなたは私の質問に答えていません。もちろん"}, {"type": "subtitle", "time": 12545.269, "timestamp": "03:29:05", "text": "私はしませんでした。あなたも同じ目的でここにいる"}, {"type": "subtitle", "time": 12547.67, "timestamp": "03:29:07", "text": "彼がそうだった理由。山賊たちと同じ理由"}, {"type": "subtitle", "time": 12549.91, "timestamp": "03:29:09", "text": "私たちを放っておいてくれない。そして私たちは"}, {"type": "subtitle", "time": 12551.83, "timestamp": "03:29:11", "text": "あなたを信頼します。きっとあるはずだ"}, {"type": "subtitle", "time": 12553.83, "timestamp": "03:29:13", "text": "あなたを納得させるために、私にできることを一つ。あなた"}, {"type": "subtitle", "time": 12557.19, "timestamp": "03:29:17", "text": "私を説得する必要はありません。私は気にしない。"}, {"type": "subtitle", "time": 12559.349, "timestamp": "03:29:19", "text": "あなたが与えるためにここにいることを他の人全員に示してください。"}, {"type": "subtitle", "time": 12561.99, "timestamp": "03:29:21", "text": "ただ奪うだけではない。そして私はエスキです、"}, {"type": "subtitle", "time": 12563.99, "timestamp": "03:29:23", "text": "方法。"}, {"type": "subtitle", "time": 12567.429, "timestamp": "03:29:27", "text": "アリ。カイル・クレーン。エスキ、私にくれますか？"}, {"type": "subtitle", "time": 12569.349, "timestamp": "03:29:29", "text": "せめて何かヒントは？君たちはどう思う？"}, {"type": "subtitle", "time": 12571.99, "timestamp": "03:29:31", "text": "必要？お手伝いできるかもしれません。"}, {"type": "subtitle", "time": 12573.99, "timestamp": "03:29:33", "text": "覚えておいてください、"}, {"type": "subtitle", "time": 12578.469, "timestamp": "03:29:38", "text": "いつか恩恵を受ける日が来るだろう。ある日。はい、わかりました。"}, {"type": "subtitle", "time": 12580.229, "timestamp": "03:29:40", "text": "地下水がしばらく汚染されていた"}, {"type": "subtitle", "time": 12582.63, "timestamp": "03:29:42", "text": "戻る。もしあなたが"}, {"type": "subtitle", "time": 12584.469, "timestamp": "03:29:44", "text": "水道が再び使えるようになった。推測する"}, {"type": "subtitle", "time": 12587.349, "timestamp": "03:29:47", "text": "これを実現する方法はあります。はい、そこに"}, {"type": "subtitle", "time": 12589.429, "timestamp": "03:29:49", "text": "は。配管工事をたくさんやってきました"}, {"type": "subtitle", "time": 12592.229, "timestamp": "03:29:52", "text": "このゲームはキャンペーンモードです。だから、私は知っている"}, {"type": "subtitle", "time": 12594.469, "timestamp": "03:29:54", "text": "そこへ行きなさい。ああ、なんてことだ、"}, {"type": "subtitle", "time": 12597.19, "timestamp": "03:29:57", "text": "水道の問題を解決するための多くの任務。いいえ、"}, {"type": "subtitle", "time": 12598.63, "timestamp": "03:29:58", "text": "死亡事故でもない限りは。だったと思います"}]
[{"type": "subtitle", "time": 13154.63, "timestamp": "03:39:14", "text": "待って。いや、いや。先ほど使ったツールは何だったか"}, {"type": "subtitle", "time": 13156.83, "timestamp": "03:39:16", "text": "手に入れた？待って、"}, {"type": "subtitle", "time": 13161.07, "timestamp": "03:39:21", "text": "それ？えーと、何らかの"}, {"type": "subtitle", "time": 13164.63, "timestamp": "03:39:24", "text": "道具。何らかのブレーキ溝部品。"}, {"type": "subtitle", "time": 13166.99, "timestamp": "03:39:26", "text": "さっき使ったツールは何だったっけ？"}, {"type": "subtitle", "time": 13169.59, "timestamp": "03:39:29", "text": "取った？そのツールの名前は何でしたか？"}, {"type": "subtitle", "time": 13176.95, "timestamp": "03:39:36", "text": "可燃性食品。いいえ、あれは"}, {"type": "subtitle", "time": 13182.349, "timestamp": "03:39:42", "text": "何"}, {"type": "subtitle", "time": 13185.03, "timestamp": "03:39:45", "text": "ランク？待って、いや、いや、いや。それはどこですか"}, {"type": "subtitle", "time": 13194.389, "timestamp": "03:39:54", "text": "ああ、あのスパンみたいに、あのやつを"}, {"type": "subtitle", "time": 13198.389, "timestamp": "03:39:58", "text": "電源を入れるところ、ほら、"}]
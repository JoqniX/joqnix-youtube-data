[{"type": "subtitle", "time": 19152.19, "timestamp": "05:19:12", "text": "このアプローチと私の"}, {"type": "subtitle", "time": 19155.03, "timestamp": "05:19:15", "text": "できません。ああ、ひどく叩かれてるよ。"}, {"type": "subtitle", "time": 19160.868, "timestamp": "05:19:20", "text": "わかった。私は負けない、私は倒れない。私"}, {"type": "subtitle", "time": 19180.31, "timestamp": "05:19:40", "text": "彼はどこにいますか？彼はどこにいますか？彼はどこにいますか？"}, {"type": "subtitle", "time": 19193.55, "timestamp": "05:19:53", "text": "来るよ。"}, {"type": "subtitle", "time": 19197.04, "timestamp": "05:19:57", "text": "ああ、君は科学を突き刺す。"}]
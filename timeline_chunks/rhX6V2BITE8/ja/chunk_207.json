[{"type": "subtitle", "time": 12422.309, "timestamp": "03:27:02", "text": "今。うん、フリーロールするよ"}, {"type": "subtitle", "time": 12431.469, "timestamp": "03:27:11", "text": "私のサスペンションは"}, {"type": "subtitle", "time": 12432.97, "timestamp": "03:27:12", "text": "去った。 1つ"}, {"type": "subtitle", "time": 12441.67, "timestamp": "03:27:21", "text": "もの。これは鉄道の線路ですか？それは"}, {"type": "subtitle", "time": 12443.229, "timestamp": "03:27:23", "text": "鉄道"}, {"type": "subtitle", "time": 12460.389, "timestamp": "03:27:40", "text": "[音楽]"}, {"type": "subtitle", "time": 12471.71, "timestamp": "03:27:51", "text": "推測。よし。どうすればいいですか"}, {"type": "subtitle", "time": 12475.95, "timestamp": "03:27:55", "text": "出口？えーと。"}, {"type": "subtitle", "time": 12479.309, "timestamp": "03:27:59", "text": "わかった。あなたの"}]
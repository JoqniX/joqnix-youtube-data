[{"type": "subtitle", "time": 20042.35, "timestamp": "05:34:02", "text": "から？あなたが見えてます。なるほど"}, {"type": "subtitle", "time": 20049.868, "timestamp": "05:34:09", "text": "私はあなたにヘッドショットを決めているのでしょうか？はい、わかりました"}, {"type": "subtitle", "time": 20053.15, "timestamp": "05:34:13", "text": "私の"}, {"type": "subtitle", "time": 20058.99, "timestamp": "05:34:18", "text": "あなた。"}, {"type": "subtitle", "time": 20061.99, "timestamp": "05:34:21", "text": "待って、歩いてノックする"}, {"type": "subtitle", "time": 20071.67, "timestamp": "05:34:31", "text": "また。ああ、わかった。待って。ええと、鎮痛剤。"}, {"type": "subtitle", "time": 20073.07, "timestamp": "05:34:33", "text": "えっと、それ必要？"}, {"type": "subtitle", "time": 20077.07, "timestamp": "05:34:37", "text": "今？いや、違うよ。その"}, {"type": "subtitle", "time": 20080.11, "timestamp": "05:34:40", "text": "わかった。素敵な鐘ですよね？それを受け取ります。"}, {"type": "subtitle", "time": 20082.23, "timestamp": "05:34:42", "text": "道具。あのね？あなたの"}, {"type": "subtitle", "time": 20087.07, "timestamp": "05:34:47", "text": "完全に休養する。ありがとう。だってそれは私だから"}, {"type": "subtitle", "time": 20092.548, "timestamp": "05:34:52", "text": "えっと、9mmは必要ないですよね？ 45口径が必要です"}, {"type": "subtitle", "time": 20094.11, "timestamp": "05:34:54", "text": "ACP"}, {"type": "subtitle", "time": 20098.19, "timestamp": "05:34:58", "text": "あれ。そして私は必要としない"}]
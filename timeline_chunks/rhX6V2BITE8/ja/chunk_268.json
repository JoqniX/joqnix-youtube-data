[{"type": "subtitle", "time": 16083.229, "timestamp": "04:28:03", "text": "えーと、行方不明者"}, {"type": "subtitle", "time": 16085.229, "timestamp": "04:28:05", "text": "あれ。"}, {"type": "subtitle", "time": 16097.07, "timestamp": "04:28:17", "text": "わかりました。"}, {"type": "subtitle", "time": 16102.189, "timestamp": "04:28:22", "text": "えーと、1つ、2つ、"}, {"type": "subtitle", "time": 16105.95, "timestamp": "04:28:25", "text": "３つ、それはかなり不安定だ"}, {"type": "subtitle", "time": 16110.389, "timestamp": "04:28:30", "text": "ネスト。 １、２、３、４、５、６、"}, {"type": "subtitle", "time": 16116.229, "timestamp": "04:28:36", "text": "7、8、9。 9ボルトの巣。"}, {"type": "subtitle", "time": 16118.83, "timestamp": "04:28:38", "text": "１、２、"}, {"type": "subtitle", "time": 16122.79, "timestamp": "04:28:42", "text": "３、４くらい、"}, {"type": "subtitle", "time": 16125.71, "timestamp": "04:28:45", "text": "えっと、安全"}, {"type": "subtitle", "time": 16128.63, "timestamp": "04:28:48", "text": "家。その謎を解明せよ。いいえ。"}, {"type": "subtitle", "time": 16131.269, "timestamp": "04:28:51", "text": "わかった。それでね、知ってる？最後に"}, {"type": "subtitle", "time": 16136.51, "timestamp": "04:28:56", "text": "今日は、"}, {"type": "subtitle", "time": 16139.11, "timestamp": "04:28:59", "text": "実際にセーフハウスに行くと、"}]
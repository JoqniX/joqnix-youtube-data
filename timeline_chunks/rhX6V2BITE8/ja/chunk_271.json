[{"type": "subtitle", "time": 16269.149, "timestamp": "04:31:09", "text": "神。聖なる"}, {"type": "subtitle", "time": 16276.189, "timestamp": "04:31:16", "text": "神。何が"}, {"type": "subtitle", "time": 16278.87, "timestamp": "04:31:18", "text": "それ？よし、これが私が必要としていた方法だ"}, {"type": "subtitle", "time": 16291.28, "timestamp": "04:31:31", "text": "私にとって。ロックしたかった"}, {"type": "subtitle", "time": 16293.63, "timestamp": "04:31:33", "text": "[音楽]"}, {"type": "subtitle", "time": 16318.79, "timestamp": "04:31:58", "text": "木材の比率。"}]
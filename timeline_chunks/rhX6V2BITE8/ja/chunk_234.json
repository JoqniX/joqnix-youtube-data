[{"type": "subtitle", "time": 14042.189, "timestamp": "03:54:02", "text": "これらを保管するだけ"}, {"type": "subtitle", "time": 14045.51, "timestamp": "03:54:05", "text": "もの。実際には彼女は必要ないのですが、"}, {"type": "subtitle", "time": 14058.55, "timestamp": "03:54:18", "text": "私たちはただ私たちの井戸が"}, {"type": "subtitle", "time": 14060.55, "timestamp": "03:54:20", "text": "過去1ヶ月間汚染され、人々は"}, {"type": "subtitle", "time": 14063.429, "timestamp": "03:54:23", "text": "容態はどんどん悪化していった。たぶん私は"}, {"type": "subtitle", "time": 14066.469, "timestamp": "03:54:26", "text": "見知らぬ人よ、君のことを誤解していたよ。はい。それで"}, {"type": "subtitle", "time": 14068.309, "timestamp": "03:54:28", "text": "今、私の質問に答えていただくことは可能でしょうか？私たちは"}, {"type": "subtitle", "time": 14071.189, "timestamp": "03:54:31", "text": "フォローミー機能を改善しました。私たちは"}, {"type": "subtitle", "time": 14074.63, "timestamp": "03:54:34", "text": "私たちは最善を尽くし、さらに向上しました"}, {"type": "subtitle", "time": 14076.71, "timestamp": "03:54:36", "text": "えっと、なんて呼ぶんだっけ？繰り返し"}, {"type": "subtitle", "time": 14078.67, "timestamp": "03:54:38", "text": "または、その前の画像"}, {"type": "subtitle", "time": 14081.91, "timestamp": "03:54:41", "text": "ジョシア。それは良い。子供たちを見て"}, {"type": "subtitle", "time": 14086.41, "timestamp": "03:54:46", "text": "プレイ中。彼らは水に満足している。"}, {"type": "subtitle", "time": 14092.59, "timestamp": "03:54:52", "text": "彼女は何者ですか？"}, {"type": "subtitle", "time": 14096.309, "timestamp": "03:54:56", "text": "ない？ハランからこんにちは。私たちは走っています"}, {"type": "subtitle", "time": 14098.63, "timestamp": "03:54:58", "text": "抗シンから。何でも探しています"}]
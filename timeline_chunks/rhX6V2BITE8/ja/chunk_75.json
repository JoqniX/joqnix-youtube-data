[{"type": "subtitle", "time": 4501.95, "timestamp": "01:15:01", "text": "期待。"}, {"type": "subtitle", "time": 4504.55, "timestamp": "01:15:04", "text": "期待は大きいでしょう"}, {"type": "subtitle", "time": 4512.709, "timestamp": "01:15:12", "text": "右。うん。こんにちは、カル・タカン。はい、私は"}, {"type": "subtitle", "time": 4514.47, "timestamp": "01:15:14", "text": "あなたにすべてを与えることを覚えておいてください"}, {"type": "subtitle", "time": 4522.43, "timestamp": "01:15:22", "text": "あの、ちょっとお待ちください。与える"}, {"type": "subtitle", "time": 4525.43, "timestamp": "01:15:25", "text": "私は、えっと、少し時間をください。だから、"}, {"type": "subtitle", "time": 4528.47, "timestamp": "01:15:28", "text": "数分後、確認してみます。"}, {"type": "subtitle", "time": 4530.55, "timestamp": "01:15:30", "text": "そして配信中にリアルタイムでフィードバックを提供します"}, {"type": "subtitle", "time": 4533.83, "timestamp": "01:15:33", "text": "もしあなたがまだここにいるなら。あなたはまだここにいる。"}, {"type": "subtitle", "time": 4535.83, "timestamp": "01:15:35", "text": "ライブフィードバックをお送りします"}, {"type": "subtitle", "time": 4539.55, "timestamp": "01:15:39", "text": "配信中の"}, {"type": "subtitle", "time": 4545.149, "timestamp": "01:15:45", "text": "あなたがコーディングしているアプリケーションのUTI"}, {"type": "subtitle", "time": 4548.47, "timestamp": "01:15:48", "text": "そうですね、まだ確認していませんが"}, {"type": "subtitle", "time": 4555.11, "timestamp": "01:15:55", "text": "それに関していくつかアイデアがあったんです"}, {"type": "subtitle", "time": 4557.47, "timestamp": "01:15:57", "text": "どうしてそうしないの？"}, {"type": "subtitle", "time": 4559.63, "timestamp": "01:15:59", "text": "1"}]
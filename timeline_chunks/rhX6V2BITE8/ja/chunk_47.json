[{"type": "subtitle", "time": 2821.03, "timestamp": "00:47:01", "text": "コルダマ、彼を手に入れなければならない。そしてハンハンは"}, {"type": "subtitle", "time": 2823.79, "timestamp": "00:47:03", "text": "私は彼を直したと思います"}, {"type": "subtitle", "time": 2827.67, "timestamp": "00:47:07", "text": "明日午後7時30分完了しました。パーリ語"}, {"type": "subtitle", "time": 2828.829, "timestamp": "00:47:08", "text": "彼を手に入れる"}, {"type": "subtitle", "time": 2832.63, "timestamp": "00:47:12", "text": "今日。悪魔ともも今日は3日です"}, {"type": "subtitle", "time": 2836.79, "timestamp": "00:47:16", "text": "6月。だから明日、彼にダイレクトメッセージを送らなきゃ。"}, {"type": "subtitle", "time": 2838.79, "timestamp": "00:47:18", "text": "えっと、明日か明後日には"}, {"type": "subtitle", "time": 2842.63, "timestamp": "00:47:22", "text": "彼にDMを送って聞いてみて。素晴らしい。 K 私は持っています"}, {"type": "subtitle", "time": 2846.39, "timestamp": "00:47:26", "text": "6月中旬に彼にダイレクトメッセージを送る。それは13 14です"}, {"type": "subtitle", "time": 2850.15, "timestamp": "00:47:30", "text": "その頃の15年。後で彼にDMを送るよ。"}, {"type": "subtitle", "time": 2853.109, "timestamp": "00:47:33", "text": "ベーコン。それはベーコンのためだ。私は思う"}, {"type": "subtitle", "time": 2855.069, "timestamp": "00:47:35", "text": "彼を"}, {"type": "subtitle", "time": 2858.069, "timestamp": "00:47:38", "text": "どこかで。ベーコンは6月16日です。だから私は"}, {"type": "subtitle", "time": 2860.51, "timestamp": "00:47:40", "text": "彼を排除せよ。"}, {"type": "subtitle", "time": 2865.19, "timestamp": "00:47:45", "text": "ラーン。ラアンは私が覚えている"}, {"type": "subtitle", "time": 2867.67, "timestamp": "00:47:47", "text": "彼女はどこかにいるはずだ。うん。ええ、6月12日です。私"}, {"type": "subtitle", "time": 2871.39, "timestamp": "00:47:51", "text": "彼女を排除できる。ウォルターの息子は言った"}, {"type": "subtitle", "time": 2875.349, "timestamp": "00:47:55", "text": "何か。えっと、神様、私、DMを漏らしてるの？"}, {"type": "subtitle", "time": 2876.67, "timestamp": "00:47:56", "text": "今すぐ？私はしません"}, {"type": "subtitle", "time": 2878.88, "timestamp": "00:47:58", "text": "知る。私はしなければならない"}]
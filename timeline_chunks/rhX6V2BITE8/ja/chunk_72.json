[{"type": "subtitle", "time": 4320.95, "timestamp": "01:12:00", "text": "12時になったら、少し休憩します。昼寝をした"}, {"type": "subtitle", "time": 4322.95, "timestamp": "01:12:02", "text": "若干。体を動かすことができなかったが、"}, {"type": "subtitle", "time": 4327.63, "timestamp": "01:12:07", "text": "午前2時半に目が覚めた、いや、午後3時だった。 3:00"}, {"type": "subtitle", "time": 4330.79, "timestamp": "01:12:10", "text": "午前 起床、6時までコラボ作業をしました。"}, {"type": "subtitle", "time": 4334.79, "timestamp": "01:12:14", "text": "それから、5時まで、それから少し休憩しました"}, {"type": "subtitle", "time": 4339.99, "timestamp": "01:12:19", "text": "6時半以降はちょっと。私たちは"}, {"type": "subtitle", "time": 4343.91, "timestamp": "01:12:23", "text": "私は日本のVTuberのオープンコラボに参加しました。"}, {"type": "subtitle", "time": 4346.95, "timestamp": "01:12:26", "text": "そうやって私は人々と出会ったんです。私はまだ"}, {"type": "chat", "time": 4348.556, "timestamp": "01:12:28", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! definitely not Taki ~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 4350.39, "timestamp": "01:12:30", "text": "まるで順番待ちの列みたいだった。私のもの"}, {"type": "subtitle", "time": 4355.11, "timestamp": "01:12:35", "text": "午後10時か7時か8時頃に来た。または"}, {"type": "subtitle", "time": 4356.59, "timestamp": "01:12:36", "text": "何か。"}, {"type": "subtitle", "time": 4361.27, "timestamp": "01:12:41", "text": "だから、8時から10時まで待たなければならなかった"}, {"type": "subtitle", "time": 4363.03, "timestamp": "01:12:43", "text": "あるいは、そんな感じ。あれは楽しい瞬間だった。私"}, {"type": "subtitle", "time": 4365.99, "timestamp": "01:12:45", "text": "リポジトリの件は楽しかった。クールな新しい"}, {"type": "subtitle", "time": 4369.11, "timestamp": "01:12:49", "text": "みんな、えっと、Twitchを壊しちゃったと思う"}, {"type": "subtitle", "time": 4372.31, "timestamp": "01:12:52", "text": "記録もプロ並みに、だって家宅捜索を受けたんだもん"}, {"type": "subtitle", "time": 4374.709, "timestamp": "01:12:54", "text": "そこにいた4人のストリーマー全員によって。五"}, {"type": "subtitle", "time": 4376.95, "timestamp": "01:12:56", "text": "そこに配信者がいた。大手JPでさえ"}, {"type": "subtitle", "time": 4379.87, "timestamp": "01:12:59", "text": "YouTuberも"}]
[{"type": "subtitle", "time": 13621.229, "timestamp": "03:47:01", "text": "私は作れないと思う"}, {"type": "subtitle", "time": 13641.51, "timestamp": "03:47:21", "text": "ヘルプ。少なくとも私たちは近いところにいる。ええと、私たちは"}, {"type": "subtitle", "time": 13651.15, "timestamp": "03:47:31", "text": "自由に歩き回れないのですか？"}, {"type": "subtitle", "time": 13656.91, "timestamp": "03:47:36", "text": "男。わかった、そうしよう"}, {"type": "subtitle", "time": 13660.429, "timestamp": "03:47:40", "text": "えっと、失敗しました、私は"}, {"type": "subtitle", "time": 13675.11, "timestamp": "03:47:55", "text": "戻る。うん、そのままにしておこう。大丈夫。"}, {"type": "subtitle", "time": 13677.87, "timestamp": "03:47:57", "text": "やり直します"}]
[{"type": "subtitle", "time": 6486.47, "timestamp": "01:48:06", "text": "売る。いいえ、次のようなものを買うことができます"}, {"type": "subtitle", "time": 6493.83, "timestamp": "01:48:13", "text": "私たちのコンステラやコンサートのようなもの"}, {"type": "subtitle", "time": 6496.669, "timestamp": "01:48:16", "text": "プレートアバターストア。あなたはできる"}, {"type": "subtitle", "time": 6500.91, "timestamp": "01:48:20", "text": "自分の物を買うか、自分で作る"}, {"type": "subtitle", "time": 6508.109, "timestamp": "01:48:28", "text": "それ。私はしません"}, {"type": "subtitle", "time": 6511.669, "timestamp": "01:48:31", "text": "知る。あくまでもアイデアのコンセプトです。私は"}, {"type": "subtitle", "time": 6514.43, "timestamp": "01:48:34", "text": "いつでもそれを改良できると考えている"}, {"type": "subtitle", "time": 6517.43, "timestamp": "01:48:37", "text": "アイデア。もう進む道はない"}, {"type": "subtitle", "time": 6519.55, "timestamp": "01:48:39", "text": "について"}, {"type": "subtitle", "time": 6522.03, "timestamp": "01:48:42", "text": "これ。それで"}, {"type": "subtitle", "time": 6534.39, "timestamp": "01:48:54", "text": "けれど。試してみてもいいけど、約束はできないよ。"}, {"type": "subtitle", "time": 6535.99, "timestamp": "01:48:55", "text": "うん。うん。約束しないでください。大丈夫。いいえ"}, {"type": "subtitle", "time": 6539.35, "timestamp": "01:48:59", "text": "心配事。また。一度十分な"}]
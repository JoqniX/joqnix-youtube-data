[{"type": "subtitle", "time": 20220.59, "timestamp": "05:37:00", "text": "ついに、より広い視野を持つことができました。ニース"}, {"type": "subtitle", "time": 20237.51, "timestamp": "05:37:17", "text": "それ。どういうわけか、集中状態に入っている。私はしませんでした"}, {"type": "subtitle", "time": 20239.788, "timestamp": "05:37:19", "text": "チェックする"}, {"type": "subtitle", "time": 20244.01, "timestamp": "05:37:24", "text": "地図。どうすればいいですか"}, {"type": "subtitle", "time": 20254.07, "timestamp": "05:37:34", "text": "彼は手に入れたのか？誰が彼を殺したのか？待って、彼は"}, {"type": "subtitle", "time": 20256.11, "timestamp": "05:37:36", "text": "殺された。トコ、犯人は誰？"}, {"type": "subtitle", "time": 20259.43, "timestamp": "05:37:39", "text": "待って。えっと、この場所は"}, {"type": "subtitle", "time": 20260.59, "timestamp": "05:37:40", "text": "それで"}]
[{"type": "subtitle", "time": 4442.55, "timestamp": "01:14:02", "text": "幸せだったけど、それでも気分が悪かった。"}, {"type": "subtitle", "time": 4445.75, "timestamp": "01:14:05", "text": "そう、私が話したように、"}, {"type": "subtitle", "time": 4447.75, "timestamp": "01:14:07", "text": "今はそこにあるものだと思います"}, {"type": "subtitle", "time": 4450.31, "timestamp": "01:14:10", "text": "新しいストリーマーにアドバイスを与える"}, {"type": "subtitle", "time": 4454.39, "timestamp": "01:14:14", "text": "新しいユーチューバーなので、えっと、私はちょっと"}, {"type": "subtitle", "time": 4457.35, "timestamp": "01:14:17", "text": "多くのことについて批判的すぎる"}, {"type": "subtitle", "time": 4460.47, "timestamp": "01:14:20", "text": "あなたが見なければ彼ができること"}, {"type": "subtitle", "time": 4463.83, "timestamp": "01:14:23", "text": "数字も何もかも。ただ持っていればいい"}, {"type": "subtitle", "time": 4466.229, "timestamp": "01:14:26", "text": "もっと前向きな考え方を持つ。のように"}, {"type": "subtitle", "time": 4469.669, "timestamp": "01:14:29", "text": "メカニックとして少しだけ挑戦してみるのもいいでしょう"}, {"type": "subtitle", "time": 4472.47, "timestamp": "01:14:32", "text": "最初は情熱的な趣味だったが、最終的には"}, {"type": "subtitle", "time": 4474.43, "timestamp": "01:14:34", "text": "あなたはある地点に到達するでしょう"}, {"type": "subtitle", "time": 4478.39, "timestamp": "01:14:38", "text": "そうなると、"}, {"type": "subtitle", "time": 4481.03, "timestamp": "01:14:41", "text": "ビジネス、あるいはより取引的なもの"}, {"type": "subtitle", "time": 4483.189, "timestamp": "01:14:43", "text": "もっと"}, {"type": "subtitle", "time": 4486.229, "timestamp": "01:14:46", "text": "時間をかけてプロフェッショナルになる。たくさんのこと、"}, {"type": "subtitle", "time": 4488.07, "timestamp": "01:14:48", "text": "右？"}, {"type": "subtitle", "time": 4490.229, "timestamp": "01:14:50", "text": "そして、私がまだ続けられるかどうかは神のみぞ知る"}, {"type": "subtitle", "time": 4492.709, "timestamp": "01:14:52", "text": "今の自分と何をしているのか"}, {"type": "subtitle", "time": 4495.43, "timestamp": "01:14:55", "text": "新モデルが今すぐ手に入れられる"}]
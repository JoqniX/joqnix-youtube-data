[{"type": "subtitle", "time": 1202.63, "timestamp": "00:20:02", "text": "その場所。私はすごく窮地に立たされている"}, {"type": "subtitle", "time": 1205.59, "timestamp": "00:20:05", "text": "スケジュールみたいなもの。崩壊が起きている。"}, {"type": "subtitle", "time": 1208.23, "timestamp": "00:20:08", "text": "体が動かなくなったので眠ってしまった"}, {"type": "subtitle", "time": 1212.549, "timestamp": "00:20:12", "text": "全く動かないとか、そういう感じ。そこには"}, {"type": "subtitle", "time": 1214.95, "timestamp": "00:20:14", "text": "何日も話すことも、声を出すこともできなかった"}, {"type": "subtitle", "time": 1218.15, "timestamp": "00:20:18", "text": "言葉の瞬間だったが、それでも私は"}, {"type": "subtitle", "time": 1222.31, "timestamp": "00:20:22", "text": "会話とか、そういうこと全部。だから私はああ"}, {"type": "subtitle", "time": 1225.19, "timestamp": "00:20:25", "text": "私はこれを本当に乗り越えなければならない"}, {"type": "subtitle", "time": 1233.63, "timestamp": "00:20:33", "text": "自分。それで、"}]
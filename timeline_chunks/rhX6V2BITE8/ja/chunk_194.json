[{"type": "subtitle", "time": 11640.95, "timestamp": "03:14:00", "text": "パンを少し召し上がってください、友よ。戻る"}, {"type": "subtitle", "time": 11644.99, "timestamp": "03:14:04", "text": "彼女。何？いや、撃たないでくれ。私"}, {"type": "subtitle", "time": 11647.87, "timestamp": "03:14:07", "text": "bash。"}, {"type": "subtitle", "time": 11651.59, "timestamp": "03:14:11", "text": "いや。冗談でしょ。"}, {"type": "subtitle", "time": 11654.429, "timestamp": "03:14:14", "text": "少なくとも私は周りをくまなくチェックします"}, {"type": "subtitle", "time": 11657.03, "timestamp": "03:14:17", "text": "もの。そして、あなたが言ったパンはどこにあるのですか？"}, {"type": "subtitle", "time": 11658.67, "timestamp": "03:14:18", "text": "自分"}, {"type": "subtitle", "time": 11665.349, "timestamp": "03:14:25", "text": "何？そのパンはどこにあるの？はい、できます"}, {"type": "subtitle", "time": 11668.63, "timestamp": "03:14:28", "text": "私は推測する。あの女性は私たちを助けてくれると思う。"}, {"type": "subtitle", "time": 11675.75, "timestamp": "03:14:35", "text": "くそ。ここはまさに荒廃した土地だ。"}, {"type": "subtitle", "time": 11678.55, "timestamp": "03:14:38", "text": "おい。ああ、君がここに来るんだ。ああ、これは"}, {"type": "subtitle", "time": 11681.349, "timestamp": "03:14:41", "text": "手伝いに行くよ。もっと近づいて。噛みつきませんよ"}, {"type": "subtitle", "time": 11683.75, "timestamp": "03:14:43", "text": "あなた。彼は商品を売っていると思うか、"}, {"type": "subtitle", "time": 11686.309, "timestamp": "03:14:46", "text": "何か。たくさんの木を見てください"}, {"type": "subtitle", "time": 11689.429, "timestamp": "03:14:49", "text": "箱や木箱に入った物。だから、あなたは"}, {"type": "subtitle", "time": 11692.63, "timestamp": "03:14:52", "text": "そのうちの一人？彼は商人だと思う"}, {"type": "subtitle", "time": 11694.71, "timestamp": "03:14:54", "text": "最も可能性が高い。だって俺は"}, {"type": "subtitle", "time": 11697.429, "timestamp": "03:14:57", "text": "ただのパン。ちなみに、私の名前はカーンです。"}, {"type": "subtitle", "time": 11699.03, "timestamp": "03:14:59", "text": "カーン。"}]
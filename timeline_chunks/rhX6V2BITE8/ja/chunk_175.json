[{"type": "subtitle", "time": 10500.469, "timestamp": "02:55:00", "text": "ほら、またスケジュールを立ててるよ"}, {"type": "subtitle", "time": 10509.79, "timestamp": "02:55:09", "text": "長いVHSはスケジュールから言うことができます"}, {"type": "subtitle", "time": 10513.03, "timestamp": "02:55:13", "text": "ストリーム。私の最後の配信スケジュールはいつですか？"}, {"type": "subtitle", "time": 10516.63, "timestamp": "02:55:16", "text": "また？確かずっと昔のことだったと思う"}, {"type": "subtitle", "time": 10519.269, "timestamp": "02:55:19", "text": "どのような"}, {"type": "subtitle", "time": 10523.83, "timestamp": "02:55:23", "text": "えーと、1月14日が最後でした"}, {"type": "subtitle", "time": 10527.349, "timestamp": "02:55:27", "text": "ええ、1月8日から14日の週ですね。"}, {"type": "subtitle", "time": 10530.51, "timestamp": "02:55:30", "text": "私が生まれて最後の日だった"}, {"type": "subtitle", "time": 10535.59, "timestamp": "02:55:35", "text": "えーっと、ストリーム配信したことありますか？"}, {"type": "subtitle", "time": 10537.99, "timestamp": "02:55:37", "text": "スケジュール配信とかそういうもの。それで"}, {"type": "subtitle", "time": 10541.83, "timestamp": "02:55:41", "text": "昨日、えっと、ちょっと"}, {"type": "subtitle", "time": 10545.349, "timestamp": "02:55:45", "text": "抑えたり、持ち上げたり、修正したり"}, {"type": "subtitle", "time": 10548.389, "timestamp": "02:55:48", "text": "ストリーム、えーと、アセットのようなもの"}, {"type": "subtitle", "time": 10550.95, "timestamp": "02:55:50", "text": "もの。だから私は何時間もそれに取り組んでいた"}, {"type": "subtitle", "time": 10553.03, "timestamp": "02:55:53", "text": "だって、コーディングがわからないから。"}, {"type": "subtitle", "time": 10556.07, "timestamp": "02:55:56", "text": "Figmaの訪問とか色々。まあまあ"}, {"type": "subtitle", "time": 10558.95, "timestamp": "02:55:58", "text": "そうすれば、私にとってはやりやすくなるでしょう。そうですね"}]
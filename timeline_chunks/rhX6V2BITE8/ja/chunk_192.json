[{"type": "subtitle", "time": 11526.95, "timestamp": "03:12:06", "text": "これが絆ですよね？あなたは"}, {"type": "subtitle", "time": 11528.95, "timestamp": "03:12:08", "text": "さあ、私もあなたと話しましょう。"}, {"type": "subtitle", "time": 11531.91, "timestamp": "03:12:11", "text": "母に祝福あれ。彼はタトゥーを入れている"}, {"type": "subtitle", "time": 11533.99, "timestamp": "03:12:13", "text": "彼の胸に。聞いてくれ、私はただ"}, {"type": "subtitle", "time": 11536.55, "timestamp": "03:12:16", "text": "情報。私は何も知りません。あなた"}, {"type": "subtitle", "time": 11539.75, "timestamp": "03:12:19", "text": "ジャジールに聞いてみるべきだ。ジャズ？ああ、わかった。どこ"}, {"type": "subtitle", "time": 11542.87, "timestamp": "03:12:22", "text": "彼を見つけるにはどうすればいいですか？納屋の中。で"}, {"type": "subtitle", "time": 11545.07, "timestamp": "03:12:25", "text": "納屋。わかった。"}, {"type": "subtitle", "time": 11549.19, "timestamp": "03:12:29", "text": "ありがとう、Mさん。彼は最後の一人ですか、それとも"}, {"type": "subtitle", "time": 11550.79, "timestamp": "03:12:30", "text": "他に誰かいますか？話そうかな"}, {"type": "subtitle", "time": 11554.19, "timestamp": "03:12:34", "text": "この人物にもライフルで攻撃した。"}, {"type": "subtitle", "time": 11556.23, "timestamp": "03:12:36", "text": "こんにちは。私はそこから登った"}, {"type": "subtitle", "time": 11559.19, "timestamp": "03:12:39", "text": "行列。ここに来て。でも私は話せない"}, {"type": "subtitle", "time": 11566.71, "timestamp": "03:12:46", "text": "わかった。ここです。この人、この人ですか？"}, {"type": "subtitle", "time": 11567.469, "timestamp": "03:12:47", "text": "これ"}, {"type": "subtitle", "time": 11571.51, "timestamp": "03:12:51", "text": "車。待って、ここは納屋じゃないの？こんにちは？"}, {"type": "subtitle", "time": 11573.07, "timestamp": "03:12:53", "text": "とは"}, {"type": "subtitle", "time": 11576.19, "timestamp": "03:12:56", "text": "禁止？これ"}, {"type": "subtitle", "time": 11579.11, "timestamp": "03:12:59", "text": "1つ。ブラ、私には必要なものがあるの。あなたは"}]
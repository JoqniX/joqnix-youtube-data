[{"type": "subtitle", "time": 6884.47, "timestamp": "01:54:44", "text": "それ以外？ 14日は予定を空けることができます"}, {"type": "subtitle", "time": 6886.189, "timestamp": "01:54:46", "text": "私が"}, {"type": "subtitle", "time": 6889.91, "timestamp": "01:54:49", "text": "午前。 14日。 14日。 14日。 14日はいつですか？いつ"}, {"type": "subtitle", "time": 6892.589, "timestamp": "01:54:52", "text": "14番目だよ、兄弟？いつ"}]
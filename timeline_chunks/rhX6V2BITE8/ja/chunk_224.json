[{"type": "subtitle", "time": 13447.51, "timestamp": "03:44:07", "text": "よし。さあ、やってみよう。クロス"}, {"type": "subtitle", "time": 13450.469, "timestamp": "03:44:10", "text": "指。ポンプの問題です。右。では"}, {"type": "subtitle", "time": 13451.91, "timestamp": "03:44:11", "text": "数分後には水が"}, {"type": "subtitle", "time": 13453.48, "timestamp": "03:44:13", "text": "また農場へ。"}, {"type": "subtitle", "time": 13454.71, "timestamp": "03:44:14", "text": "[音楽]"}, {"type": "subtitle", "time": 13457.229, "timestamp": "03:44:17", "text": "ああ、それは赤だ"}, {"type": "subtitle", "time": 13459.91, "timestamp": "03:44:19", "text": "緑。 3つのグリーン。それは良い兆候だ。"}, {"type": "subtitle", "time": 13464.95, "timestamp": "03:44:24", "text": "右？うまくいかない。なぜでしょうか？"}, {"type": "subtitle", "time": 13471.91, "timestamp": "03:44:31", "text": "なんてこった。くそっ。閉店したに違いない。"}, {"type": "subtitle", "time": 13474.63, "timestamp": "03:44:34", "text": "この機器はめちゃくちゃ古い。"}, {"type": "subtitle", "time": 13477.03, "timestamp": "03:44:37", "text": "水道管が破裂しても、私たちは皆無事で"}, {"type": "subtitle", "time": 13479.189, "timestamp": "03:44:39", "text": "本当に最悪だ。バルブを開けます。"}, {"type": "subtitle", "time": 13482.229, "timestamp": "03:44:42", "text": "どこですか？もう本当にうんざりだ。"}, {"type": "subtitle", "time": 13484.55, "timestamp": "03:44:44", "text": "しかし、私はそのパイプラインを知っている。わかった。フォローする"}, {"type": "subtitle", "time": 13487.55, "timestamp": "03:44:47", "text": "パイプライン。まったく、"}, {"type": "subtitle", "time": 13491.189, "timestamp": "03:44:51", "text": "急いで。行く。こちら側でも引き続き努力してみます。"}, {"type": "subtitle", "time": 13493.95, "timestamp": "03:44:53", "text": "行って"}, {"type": "subtitle", "time": 13495.38, "timestamp": "03:44:55", "text": "急いで。得る"}, {"type": "subtitle", "time": 13496.99, "timestamp": "03:44:56", "text": "[音楽]"}]
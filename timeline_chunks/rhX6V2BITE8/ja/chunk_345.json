[{"type": "subtitle", "time": 20711.27, "timestamp": "05:45:11", "text": "走れ、走れ、走れ、命がけで走れ。"}, {"type": "subtitle", "time": 20720.75, "timestamp": "05:45:20", "text": "お願いします。君ならできるよ。信じる"}, {"type": "subtitle", "time": 20729.99, "timestamp": "05:45:29", "text": "生き残りよ、君ならできる。私は遭遇しています"}, {"type": "subtitle", "time": 20732.548, "timestamp": "05:45:32", "text": "開けた野原。何てことだ。"}, {"type": "subtitle", "time": 20735.548, "timestamp": "05:45:35", "text": "私は開けた野原へと走り出している。ああ、"}, {"type": "subtitle", "time": 20738.59, "timestamp": "05:45:38", "text": "神。何てことだ。私は行きます"}, {"type": "subtitle", "time": 20741.75, "timestamp": "05:45:41", "text": "取得するため"}, {"type": "subtitle", "time": 20752.99, "timestamp": "05:45:52", "text": "押しつぶされた。何てことだ。何てことだ。ああ、"}]
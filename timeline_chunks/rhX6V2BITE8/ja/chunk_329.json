[{"type": "subtitle", "time": 19744.11, "timestamp": "05:29:04", "text": "ショットガン"}, {"type": "subtitle", "time": 19747.11, "timestamp": "05:29:07", "text": "補償器。これ、必要かな？はい、私は"}, {"type": "subtitle", "time": 19749.07, "timestamp": "05:29:09", "text": "すべき"}, {"type": "subtitle", "time": 19752.11, "timestamp": "05:29:12", "text": "喫煙する"}, {"type": "subtitle", "time": 19755.27, "timestamp": "05:29:15", "text": "手榴弾バックパック レベル3。はい、私は"}, {"type": "subtitle", "time": 19757.548, "timestamp": "05:29:17", "text": "感謝している。待て、バイソン。これは何ですか？"}, {"type": "subtitle", "time": 19762.39, "timestamp": "05:29:22", "text": "SMG。それは良いSMGですか？"}, {"type": "subtitle", "time": 19766.31, "timestamp": "05:29:26", "text": "弾丸ループ。それは必要だろうか？私は投げます"}, {"type": "subtitle", "time": 19781.03, "timestamp": "05:29:41", "text": "ランク ジョー。いいえ、これは一度限りのことです。"}, {"type": "subtitle", "time": 19783.03, "timestamp": "05:29:43", "text": "とりあえずストリーミング配信します"}, {"type": "subtitle", "time": 19784.548, "timestamp": "05:29:44", "text": "ストリームして、アンインストールします"}, {"type": "subtitle", "time": 19785.788, "timestamp": "05:29:45", "text": "それ。しないで"}, {"type": "subtitle", "time": 19789.19, "timestamp": "05:29:49", "text": "心配。心配しないで。わかった。私のお気に入り"}, {"type": "subtitle", "time": 19794.51, "timestamp": "05:29:54", "text": "ゲーム全体におけるエアガン。えっと"}, {"type": "subtitle", "time": 19796.91, "timestamp": "05:29:56", "text": "AK-47。最高の"}, {"type": "subtitle", "time": 19798.83, "timestamp": "05:29:58", "text": "銃。それはあなたの"}]
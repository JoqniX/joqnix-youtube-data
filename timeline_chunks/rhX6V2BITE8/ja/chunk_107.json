[{"type": "subtitle", "time": 6420.59, "timestamp": "01:47:00", "text": "仲介業者が再び働く場所"}, {"type": "subtitle", "time": 6425.109, "timestamp": "01:47:05", "text": "地元の仲介業者と"}, {"type": "subtitle", "time": 6428.07, "timestamp": "01:47:08", "text": "その人の名前を確認します"}, {"type": "subtitle", "time": 6430.629, "timestamp": "01:47:10", "text": "口座チェックを行った"}, {"type": "subtitle", "time": 6433.91, "timestamp": "01:47:13", "text": "プラットフォームのユーザー名をチェックします"}, {"type": "subtitle", "time": 6437.189, "timestamp": "01:47:17", "text": "このローカルデータをチェックします。"}, {"type": "subtitle", "time": 6439.189, "timestamp": "01:47:19", "text": "だから、その方法で私は"}, {"type": "subtitle", "time": 6442.47, "timestamp": "01:47:22", "text": "人々にXPポイントを与える"}, {"type": "subtitle", "time": 6444.39, "timestamp": "01:47:24", "text": "私を見て、おしゃべりしたり"}, {"type": "subtitle", "time": 6448.709, "timestamp": "01:47:28", "text": "特定のプラットフォームで積極的に情報を提供する"}, {"type": "subtitle", "time": 6452.189, "timestamp": "01:47:32", "text": "などに基づいてポイントを加算するなど"}, {"type": "subtitle", "time": 6455.109, "timestamp": "01:47:35", "text": "それはそうだけど、それは将来的にあり得る"}, {"type": "subtitle", "time": 6457.35, "timestamp": "01:47:37", "text": "あまり考えるべきではないけれど、"}, {"type": "subtitle", "time": 6466.03, "timestamp": "01:47:46", "text": "普遍的なものが欲しかった"}, {"type": "subtitle", "time": 6468.59, "timestamp": "01:47:48", "text": "ドアのポイントシステムみたいなもの"}, {"type": "subtitle", "time": 6470.43, "timestamp": "01:47:50", "text": "[音楽]"}, {"type": "subtitle", "time": 6473.41, "timestamp": "01:47:53", "text": "モノの経済。ええ、経済"}, {"type": "subtitle", "time": 6475.95, "timestamp": "01:47:55", "text": "[音楽]"}, {"type": "subtitle", "time": 6477.629, "timestamp": "01:47:57", "text": "あれ。"}]
[{"type": "subtitle", "time": 2703.72, "timestamp": "00:45:03", "text": "午後4時頃4～5、5～6。だからたぶん 8から"}, {"type": "subtitle", "time": 2707.24, "timestamp": "00:45:07", "text": "8から 9か10に、そして私たちは"}, {"type": "subtitle", "time": 2710.56, "timestamp": "00:45:10", "text": "9か10に、そして私たちは グループでの共同作業も検討してみては。待って、それはもしかしたら"}, {"type": "subtitle", "time": 2713.8, "timestamp": "00:45:13", "text": "グループでの共同作業も検討してみては。待って、それはもしかしたら 仕事。それは実際にうまくいくかもしれない。したい"}, {"type": "subtitle", "time": 2716.4, "timestamp": "00:45:16", "text": "仕事。それは実際にうまくいくかもしれない。したい 午後8時までにやってください。後"}, {"type": "subtitle", "time": 2718.52, "timestamp": "00:45:18", "text": "午後8時までにやってください。後 それまでに昼食をとるのはどうですか？移行するまで"}, {"type": "subtitle", "time": 2725.04, "timestamp": "00:45:25", "text": "それまでに昼食をとるのはどうですか？移行するまで に"}, {"type": "subtitle", "time": 2726.76, "timestamp": "00:45:26", "text": "に の"}, {"type": "subtitle", "time": 2728.92, "timestamp": "00:45:28", "text": "の 実験室そうだとすれば、私は彼の"}, {"type": "subtitle", "time": 2731.92, "timestamp": "00:45:31", "text": "実験室そうだとすれば、私は彼の 完全に最終最終"}, {"type": "subtitle", "time": 2735.319, "timestamp": "00:45:35", "text": "完全に最終最終 完了しました。"}, {"type": "subtitle", "time": 2737.72, "timestamp": "00:45:37", "text": "完了しました。 午前8時 午後8時"}, {"type": "subtitle", "time": 2746.349, "timestamp": "00:45:46", "text": "インド標準時午前8時"}, {"type": "subtitle", "time": 2751.109, "timestamp": "00:45:51", "text": "午後それができるなら、そうします"}, {"type": "subtitle", "time": 2754.03, "timestamp": "00:45:54", "text": "えーと、ゲームを始めましょうか。私はただ"}]
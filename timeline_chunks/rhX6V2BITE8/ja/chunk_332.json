[{"type": "subtitle", "time": 19922.07, "timestamp": "05:32:02", "text": "ハプニング？待って、みんな聞いてるよ"}, {"type": "subtitle", "time": 19923.67, "timestamp": "05:32:03", "text": "歩くこと？ターンしたいですか"}, {"type": "subtitle", "time": 19925.91, "timestamp": "05:32:05", "text": "配信外の音楽？聞こえますか、それとも"}, {"type": "subtitle", "time": 19927.868, "timestamp": "05:32:07", "text": "私だけでしょうか？"}, {"type": "subtitle", "time": 19938.15, "timestamp": "05:32:18", "text": "あ、待って。 3Dオーディオが再び使えるようになったのでしょうか？えっと、"}, {"type": "subtitle", "time": 19940.868, "timestamp": "05:32:20", "text": "それって何ていう名前でしたっけ？えっと、神様、何"}, {"type": "subtitle", "time": 19943.948, "timestamp": "05:32:23", "text": "それは再び呼ばれるのですか？えっと、これ持ってる？"}, {"type": "subtitle", "time": 19955.47, "timestamp": "05:32:35", "text": "落とす。それはそこから来ているのですか？"}, {"type": "subtitle", "time": 19968.67, "timestamp": "05:32:48", "text": "よし、誰も"}, {"type": "subtitle", "time": 19972.35, "timestamp": "05:32:52", "text": "ここ。ああ、これをいただきます。どうもありがとうございました"}, {"type": "subtitle", "time": 19975.43, "timestamp": "05:32:55", "text": "多くの。 Flashって一体何をするものなの？"}]
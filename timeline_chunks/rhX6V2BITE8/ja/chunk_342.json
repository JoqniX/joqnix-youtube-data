[{"type": "subtitle", "time": 20528.708, "timestamp": "05:42:08", "text": "ジャカール。ああ、神様。ああ、神様。ああ、神様。おお"}, {"type": "subtitle", "time": 20530.07, "timestamp": "05:42:10", "text": "神。私には無理だと思う。私"}, {"type": "subtitle", "time": 20531.51, "timestamp": "05:42:11", "text": "私はそうは思わない、私はそうは思わない"}, {"type": "subtitle", "time": 20534.15, "timestamp": "05:42:14", "text": "それ。救急キットが6個くらいある。私"}, {"type": "subtitle", "time": 20536.39, "timestamp": "05:42:16", "text": "できるかもしれないけど、わからない。どのように"}, {"type": "subtitle", "time": 20538.23, "timestamp": "05:42:18", "text": "このゲームでまた自動運転するの？する"}, {"type": "subtitle", "time": 20541.47, "timestamp": "05:42:21", "text": "キーバインドを知っている人はいますか？彼らは倒れたのか"}, {"type": "subtitle", "time": 20544.788, "timestamp": "05:42:24", "text": "キーバインド？ Tですか？いいえ、それはTではありません。"}, {"type": "subtitle", "time": 20546.75, "timestamp": "05:42:26", "text": "人々がいる"}, {"type": "subtitle", "time": 20549.628, "timestamp": "05:42:29", "text": "射撃。どれくらい遠いですか"}, {"type": "subtitle", "time": 20552.39, "timestamp": "05:42:32", "text": "これ？本当に遠い。私はそうすべきだった"}, {"type": "subtitle", "time": 20554.628, "timestamp": "05:42:34", "text": "早めに引っ越しました。バカ、こうなるんだよ"}, {"type": "subtitle", "time": 20556.35, "timestamp": "05:42:36", "text": "チェックしない場合"}, {"type": "subtitle", "time": 20557.948, "timestamp": "05:42:37", "text": "の"}, {"type": "subtitle", "time": 20560.548, "timestamp": "05:42:40", "text": "もの。君たちがあそこで戦っているのが見えるよ。"}, {"type": "subtitle", "time": 20562.43, "timestamp": "05:42:42", "text": "真っ直ぐ"}, {"type": "subtitle", "time": 20565.15, "timestamp": "05:42:45", "text": "上。"}, {"type": "subtitle", "time": 20569.07, "timestamp": "05:42:49", "text": "ああ。えっと、このゲームは"}, {"type": "subtitle", "time": 20576.628, "timestamp": "05:42:56", "text": "右？このゲームは、ああ、そうだね。それは歩く"}]
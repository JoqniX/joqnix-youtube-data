[{"type": "subtitle", "time": 13740.55, "timestamp": "03:49:00", "text": "もの。ええ、大丈夫です。ほら、私たちは到達した"}, {"type": "subtitle", "time": 13742.429, "timestamp": "03:49:02", "text": "ここには"}, {"type": "subtitle", "time": 13750.03, "timestamp": "03:49:10", "text": "ここ。ああ、それは、それは、それは"}, {"type": "subtitle", "time": 13754.63, "timestamp": "03:49:14", "text": "遅い。なんてこった。なんてこった。その夜"}, {"type": "subtitle", "time": 13758.71, "timestamp": "03:49:18", "text": "クローラーやその他諸々が到着するでしょう。"}, {"type": "subtitle", "time": 13765.55, "timestamp": "03:49:25", "text": "神。なぜ？私は既にこの場所に到着しました。"}, {"type": "subtitle", "time": 13774.79, "timestamp": "03:49:34", "text": "歩いてあげるよ。私は何らかのポンプのところにいる"}, {"type": "subtitle", "time": 13776.87, "timestamp": "03:49:36", "text": "駅。パイプラインはここで終了です。彼らは"}, {"type": "subtitle", "time": 13779.67, "timestamp": "03:49:39", "text": "メインを探してください。ちくしょう。これらは"}]
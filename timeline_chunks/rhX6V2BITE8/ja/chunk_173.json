[{"type": "subtitle", "time": 10382.309, "timestamp": "02:53:02", "text": "今日。では、楽しんでください"}, {"type": "subtitle", "time": 10383.309, "timestamp": "02:53:03", "text": "心を落ち着かせる"}, {"type": "subtitle", "time": 10386.63, "timestamp": "02:53:06", "text": "今。ということで、今日の配信は"}, {"type": "subtitle", "time": 10389.429, "timestamp": "02:53:09", "text": "短いもの。最大限努力していると思います"}, {"type": "subtitle", "time": 10391.67, "timestamp": "02:53:11", "text": "少なくとも2時間まで持たせるために、"}, {"type": "subtitle", "time": 10395.03, "timestamp": "02:53:15", "text": "まとめてください。わかった。最大と2時間。"}, {"type": "subtitle", "time": 10399.83, "timestamp": "02:53:19", "text": "こんにちは。それは続くでしょう"}, {"type": "subtitle", "time": 10401.87, "timestamp": "02:53:21", "text": "次の日も薄明かりが続く"}, {"type": "subtitle", "time": 10404.389, "timestamp": "02:53:24", "text": "おそらく来週ストリーミング配信されるか、"}, {"type": "subtitle", "time": 10408.469, "timestamp": "02:53:28", "text": "何か。でも、そうですね、それから、"}, {"type": "subtitle", "time": 10413.309, "timestamp": "02:53:33", "text": "ちょっと時間をください。待って"}, {"type": "subtitle", "time": 10415.71, "timestamp": "02:53:35", "text": "トト、これをどうやって開けるの？"}, {"type": "subtitle", "time": 10418.63, "timestamp": "02:53:38", "text": "上？これを外すにはどうすればいいですか？"}, {"type": "subtitle", "time": 10422.87, "timestamp": "02:53:42", "text": "えーと、これを外すにはどうすればいいですか？"}, {"type": "subtitle", "time": 10434.59, "timestamp": "02:53:54", "text": "待って。こいつをぶっ飛ばしてやる"}]
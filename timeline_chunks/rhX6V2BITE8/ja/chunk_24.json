[{"type": "subtitle", "time": 1440.789, "timestamp": "00:24:00", "text": "次回は何も頑張らない"}, {"type": "subtitle", "time": 1474.269, "timestamp": "00:24:34", "text": "タブが多すぎる。"}, {"type": "subtitle", "time": 1476.43, "timestamp": "00:24:36", "text": "わかった。わかった。それで、"}, {"type": "subtitle", "time": 1479.269, "timestamp": "00:24:39", "text": "えっと、サムネイルを用意しておきますね。私"}, {"type": "subtitle", "time": 1480.71, "timestamp": "00:24:40", "text": "私のサムネイルは届いていません"}, {"type": "subtitle", "time": 1482.87, "timestamp": "00:24:42", "text": "まだコラボレーションパートナーはいません。私は彼らにDMを送りました"}, {"type": "subtitle", "time": 1485.35, "timestamp": "00:24:45", "text": "もう昨日だったのに、忘れてた。えっと、でも"}, {"type": "subtitle", "time": 1487.269, "timestamp": "00:24:47", "text": "彼らはまだ返答していません。しかし、"}, {"type": "subtitle", "time": 1491.029, "timestamp": "00:24:51", "text": "それ。えっと、要約を書かないといけないんです。"}, {"type": "subtitle", "time": 1493.909, "timestamp": "00:24:53", "text": "要約を書かせてください。君たちは"}]
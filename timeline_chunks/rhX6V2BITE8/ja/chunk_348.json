[{"type": "subtitle", "time": 20882.39, "timestamp": "05:48:02", "text": "怖がった。持続する。何？私は実際に"}, {"type": "subtitle", "time": 20886.19, "timestamp": "05:48:06", "text": "正直に言うと超"}, {"type": "subtitle", "time": 20888.948, "timestamp": "05:48:08", "text": "時々怖い。これらのゲームは"}, {"type": "subtitle", "time": 20892.15, "timestamp": "05:48:12", "text": "ホラー映画のような感じ"}, {"type": "subtitle", "time": 20895.03, "timestamp": "05:48:15", "text": "まるで自分が唯一の生存者だと知っているかのように"}, {"type": "subtitle", "time": 20897.27, "timestamp": "05:48:17", "text": "あなたは自分一人しかいないことを知っている"}, {"type": "subtitle", "time": 20900.31, "timestamp": "05:48:20", "text": "人生は一度きり。生き抜かなければならない。もし"}, {"type": "subtitle", "time": 20902.31, "timestamp": "05:48:22", "text": "もし私にチームメイトがいたら、私は"}, {"type": "subtitle", "time": 20905.03, "timestamp": "05:48:25", "text": "うん、君は私のことをチェックするだろう、君は言うだろう"}, {"type": "subtitle", "time": 20907.91, "timestamp": "05:48:27", "text": "私の背中を守るとか何とかだけど、ここに"}, {"type": "subtitle", "time": 20911.15, "timestamp": "05:48:31", "text": "それはまるで"}, {"type": "subtitle", "time": 20913.99, "timestamp": "05:48:33", "text": "そう、一人で生き残らなければならないし"}, {"type": "subtitle", "time": 20916.19, "timestamp": "05:48:36", "text": "すべて。いいえ"}, {"type": "subtitle", "time": 20924.03, "timestamp": "05:48:44", "text": "痛み。えっと、どうすれば"}, {"type": "subtitle", "time": 20933.51, "timestamp": "05:48:53", "text": "ウルトラの視野距離も"}]
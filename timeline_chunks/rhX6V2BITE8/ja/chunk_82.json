[{"type": "subtitle", "time": 4920.95, "timestamp": "01:22:00", "text": "うん。そうねぇ。そうねぇ。私にさせて"}, {"type": "subtitle", "time": 4922.43, "timestamp": "01:22:02", "text": "見る。ちょっと考えさせてください。"}, {"type": "subtitle", "time": 4929.59, "timestamp": "01:22:09", "text": "右？念のため、安全のために。そして私にさせてください"}, {"type": "subtitle", "time": 4951.189, "timestamp": "01:22:31", "text": "私は本物のメールアドレスを使っただろうか？どういう意味"}, {"type": "subtitle", "time": 4972.11, "timestamp": "01:22:52", "text": "心配。"}, {"type": "subtitle", "time": 4979.629, "timestamp": "01:22:59", "text": "次に"}]
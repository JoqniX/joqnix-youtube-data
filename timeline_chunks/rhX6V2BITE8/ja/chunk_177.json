[{"type": "subtitle", "time": 10620.23, "timestamp": "02:57:00", "text": "ストリーミング配信。私は家にいません。しかし少なくとも"}, {"type": "subtitle", "time": 10622.79, "timestamp": "02:57:02", "text": "チャンネルなどを開く"}, {"type": "subtitle", "time": 10625.349, "timestamp": "02:57:05", "text": "Discordチャンネルなど"}, {"type": "subtitle", "time": 10627.269, "timestamp": "02:57:07", "text": "願い事などを送ることができます。ないだろう"}, {"type": "subtitle", "time": 10628.19, "timestamp": "02:57:08", "text": "なれ"}, {"type": "subtitle", "time": 10631.269, "timestamp": "02:57:11", "text": "VCはおそらくVC関連のもので、"}, {"type": "subtitle", "time": 10633.83, "timestamp": "02:57:13", "text": "誰もが参加できるものすべて"}, {"type": "subtitle", "time": 10636.87, "timestamp": "02:57:16", "text": "PCとか、ウィッシュとか、その他いろいろ"}, {"type": "subtitle", "time": 10638.95, "timestamp": "02:57:18", "text": "私たちは一緒に過ごすと、それらのものはすべて"}, {"type": "subtitle", "time": 10643.03, "timestamp": "02:57:23", "text": "8月12日（土）わかった。こんにちは。えっと"}, {"type": "subtitle", "time": 10645.67, "timestamp": "02:57:25", "text": "たとえ私が本当に疲れていても"}, {"type": "subtitle", "time": 10649.349, "timestamp": "02:57:29", "text": "8月11日までに帰宅します。"}, {"type": "subtitle", "time": 10651.389, "timestamp": "02:57:31", "text": "家に帰る、つまり新しい"}, {"type": "subtitle", "time": 10655.429, "timestamp": "02:57:35", "text": "両親の家から来た場所です。それで"}, {"type": "subtitle", "time": 10659.309, "timestamp": "02:57:39", "text": "うん、誕生日配信をやってみるよ"}, {"type": "subtitle", "time": 10661.99, "timestamp": "02:57:41", "text": "12日。今回も短い配信になります。"}, {"type": "subtitle", "time": 10665.349, "timestamp": "02:57:45", "text": "ええ、短いものを作ろうとしています"}, {"type": "subtitle", "time": 10668.87, "timestamp": "02:57:48", "text": "ストリームアーク。そうですね、明日は"}, {"type": "subtitle", "time": 10670.55, "timestamp": "02:57:50", "text": "Nidi ストリームの過負荷と翌日"}, {"type": "subtitle", "time": 10673.349, "timestamp": "02:57:53", "text": "明日はホグワーツと"}, {"type": "subtitle", "time": 10675.91, "timestamp": "02:57:55", "text": "水曜日はGoogle Earthを使います。もし"}, {"type": "subtitle", "time": 10678.23, "timestamp": "02:57:58", "text": "Google Earthとは何か疑問に思っているでしょう。"}]
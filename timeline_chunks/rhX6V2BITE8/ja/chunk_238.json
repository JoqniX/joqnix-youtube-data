[{"type": "subtitle", "time": 14282.03, "timestamp": "03:58:02", "text": "デメットは何かあるかどうか見に行った"}, {"type": "subtitle", "time": 14284.63, "timestamp": "03:58:04", "text": "珍しい、オアシスには役に立つものは何もない"}, {"type": "subtitle", "time": 14287.429, "timestamp": "03:58:07", "text": "それは勇敢な行為だったが、愚かな行為だった。"}, {"type": "subtitle", "time": 14289.349, "timestamp": "03:58:09", "text": "できません。愚かなことは受け入れられない。"}, {"type": "subtitle", "time": 14291.83, "timestamp": "03:58:11", "text": "うん。買えない。"}, {"type": "subtitle", "time": 14294.309, "timestamp": "03:58:14", "text": "ボーは、それは良い考えだと彼らに言った。"}, {"type": "subtitle", "time": 14295.87, "timestamp": "03:58:15", "text": "地獄へ"}, {"type": "subtitle", "time": 14300.15, "timestamp": "03:58:20", "text": "あなた。母の慈悲が彼を守ってくれることを願います。"}, {"type": "subtitle", "time": 14301.91, "timestamp": "03:58:21", "text": "彼らから何か連絡があったら、"}, {"type": "subtitle", "time": 14303.7, "timestamp": "03:58:23", "text": "もし私が"}, {"type": "subtitle", "time": 14306.11, "timestamp": "03:58:26", "text": "[音楽]"}, {"type": "subtitle", "time": 14309.75, "timestamp": "03:58:29", "text": "皆さん、ウサギの穴に飛び込んでみてください。"}, {"type": "subtitle", "time": 14312.309, "timestamp": "03:58:32", "text": "私たちはただ、新たな高みの風に乗って進むだけです"}, {"type": "subtitle", "time": 14313.15, "timestamp": "03:58:33", "text": "から"}, {"type": "subtitle", "time": 14315.349, "timestamp": "03:58:35", "text": "顔のない。生き残りたいなら、"}, {"type": "subtitle", "time": 14317.91, "timestamp": "03:58:37", "text": "古い橋には絶対に近づかないでください。"}, {"type": "subtitle", "time": 14320.91, "timestamp": "03:58:40", "text": "避けるだけでいい。見つけて見つける"}, {"type": "subtitle", "time": 14323.229, "timestamp": "03:58:43", "text": "代替部品"}, {"type": "subtitle", "time": 14326.71, "timestamp": "03:58:46", "text": "変更する、そして私が近くで言うとき"}, {"type": "subtitle", "time": 14329.71, "timestamp": "03:58:49", "text": "本気で言ってるよ。わかった。"}, {"type": "subtitle", "time": 14332.189, "timestamp": "03:58:52", "text": "ちょうどshが死んだ。"}, {"type": "subtitle", "time": 14336.229, "timestamp": "03:58:56", "text": "わかった。すべての巣箱はWの巣箱です"}, {"type": "subtitle", "time": 14339.59, "timestamp": "03:58:59", "text": "繁殖地と田園地帯は"}]
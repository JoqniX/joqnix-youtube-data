[{"type": "subtitle", "time": 6025.51, "timestamp": "01:40:25", "text": "それ。私は自分の"}, {"type": "subtitle", "time": 6028.07, "timestamp": "01:40:28", "text": "最終更新日。"}, {"type": "subtitle", "time": 6031.669, "timestamp": "01:40:31", "text": "私のウェブサイト関連情報。誰かに手伝ってもらいたい"}, {"type": "subtitle", "time": 6035.47, "timestamp": "01:40:35", "text": "ウェブサイト関連の作業をしている私。私は"}, {"type": "subtitle", "time": 6037.89, "timestamp": "01:40:37", "text": "とてもたくさん"}, {"type": "subtitle", "time": 6041.149, "timestamp": "01:40:41", "text": "[音楽]"}, {"type": "subtitle", "time": 6044.229, "timestamp": "01:40:44", "text": "もの。でも、ほら、こう思ってたんだよ"}, {"type": "subtitle", "time": 6046.629, "timestamp": "01:40:46", "text": "他のアプリの使い方がわかりません"}, {"type": "subtitle", "time": 6054.07, "timestamp": "01:40:54", "text": "適切なアプリと素晴らしい方法のようなもの"}, {"type": "subtitle", "time": 6056.149, "timestamp": "01:40:56", "text": "そして全て。えっと、私は"}]
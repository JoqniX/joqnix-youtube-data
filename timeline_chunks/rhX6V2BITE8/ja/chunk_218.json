[{"type": "subtitle", "time": 13084.91, "timestamp": "03:38:04", "text": "くそ。"}, {"type": "subtitle", "time": 13088.79, "timestamp": "03:38:08", "text": "ヘルプ。ヘルプ。ヘルプ。ヘルプ。助けて。私は"}, {"type": "subtitle", "time": 13091.11, "timestamp": "03:38:11", "text": "お手伝いします。待って。"}, {"type": "subtitle", "time": 13098.429, "timestamp": "03:38:18", "text": "いらっしゃいませ。ああ、この突然変異。"}, {"type": "subtitle", "time": 13103.59, "timestamp": "03:38:23", "text": "ああ、鼻水が出るんだね。何てことだ。待って。おお。"}, {"type": "subtitle", "time": 13105.07, "timestamp": "03:38:25", "text": "おお。おお、"}, {"type": "subtitle", "time": 13108.389, "timestamp": "03:38:28", "text": "銃。何てことだ。どこ？どこにでも"}, {"type": "subtitle", "time": 13111.51, "timestamp": "03:38:31", "text": "銃。私は銃が大好きです。私にさせて"}, {"type": "subtitle", "time": 13114.99, "timestamp": "03:38:34", "text": "この短機関銃を受け取れ。削除します"}, {"type": "subtitle", "time": 13119.87, "timestamp": "03:38:39", "text": "私たちのですが、よくわかりません。 SMG"}, {"type": "subtitle", "time": 13122.03, "timestamp": "03:38:42", "text": "時間。ああ、"}]
[{"type": "subtitle", "time": 11470.469, "timestamp": "03:11:10", "text": "わかった。こんにちは。"}, {"type": "subtitle", "time": 11472.469, "timestamp": "03:11:12", "text": "なんでしょう？話をする必要がある"}, {"type": "subtitle", "time": 11475.19, "timestamp": "03:11:15", "text": "責任者。私はハラン出身です。おお、"}, {"type": "subtitle", "time": 11478.469, "timestamp": "03:11:18", "text": "お前は密輸業者だ。あなたは悪党のために働いているのですか？"}, {"type": "subtitle", "time": 11480.07, "timestamp": "03:11:20", "text": "誰が？見てください、私は何も知りません"}, {"type": "subtitle", "time": 11481.75, "timestamp": "03:11:21", "text": "密輸はダメだよ、相棒。私はここにいます。ちょうど私"}, {"type": "subtitle", "time": 11484.71, "timestamp": "03:11:24", "text": "助けが必要です。ヤセルに関しては、ヤセルは、"}, {"type": "subtitle", "time": 11488.07, "timestamp": "03:11:28", "text": "これを理解してください。何かを盗んだ場合、"}, {"type": "subtitle", "time": 11491.67, "timestamp": "03:11:31", "text": "両手を失う。何てことだ。彼は"}, {"type": "subtitle", "time": 11493.87, "timestamp": "03:11:33", "text": "最初は私を脅迫していた"}, {"type": "subtitle", "time": 11498.59, "timestamp": "03:11:38", "text": "視力。カイではない。それから中に入ります。私"}, {"type": "subtitle", "time": 11503.83, "timestamp": "03:11:43", "text": "中に入ることはできないみたいですね。わかった。 N"}, {"type": "subtitle", "time": 11507.03, "timestamp": "03:11:47", "text": "見知らぬ人よ、私はあなたを監視している。わかった。"}, {"type": "subtitle", "time": 11509.67, "timestamp": "03:11:49", "text": "彼は私の心を掴んだ。わかった。こんにちは。すみません。私"}, {"type": "subtitle", "time": 11511.99, "timestamp": "03:11:51", "text": "何も知らない。ねえ、"}, {"type": "subtitle", "time": 11513.269, "timestamp": "03:11:53", "text": "誰かを見つける場所を教えてください"}, {"type": "subtitle", "time": 11516.23, "timestamp": "03:11:56", "text": "何か知っているのだろうか？ジャザーを探してください。"}, {"type": "subtitle", "time": 11517.99, "timestamp": "03:11:57", "text": "彼は納屋の中にいるだろう。内部"}]
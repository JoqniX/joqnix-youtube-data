[{"type": "subtitle", "time": 15001.07, "timestamp": "04:10:01", "text": "チェックイン"}, {"type": "subtitle", "time": 15016.07, "timestamp": "04:10:16", "text": "ベス・ドロ。わかった。ああ、私たちは"}, {"type": "subtitle", "time": 15017.79, "timestamp": "04:10:17", "text": "これを終わらせてください。わかった。わかった。一度もない"}, {"type": "subtitle", "time": 15027.389, "timestamp": "04:10:27", "text": "わかった。重度の揮発性物質"}, {"type": "subtitle", "time": 15029.55, "timestamp": "04:10:29", "text": "活動。"}, {"type": "subtitle", "time": 15033.75, "timestamp": "04:10:33", "text": "うん。秘密の採掘場のように見える"}, {"type": "subtitle", "time": 15036.15, "timestamp": "04:10:36", "text": "あるいは、そんな感じ。穴がたくさんある"}]
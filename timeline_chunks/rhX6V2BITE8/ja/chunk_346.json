[{"type": "subtitle", "time": 20773.15, "timestamp": "05:46:13", "text": "神。ああ、"}, {"type": "subtitle", "time": 20776.11, "timestamp": "05:46:16", "text": "神。待て、あれは最後の男だった。"}, {"type": "subtitle", "time": 20788.39, "timestamp": "05:46:28", "text": "その？何てことだ。待って、私は実際に勝ちました"}, {"type": "subtitle", "time": 20791.15, "timestamp": "05:46:31", "text": "喉だよ、男。私"}, {"type": "subtitle", "time": 20794.91, "timestamp": "05:46:34", "text": "叫んだ。何てことだ。五"}, {"type": "subtitle", "time": 20804.75, "timestamp": "05:46:44", "text": "何？ああ、"}, {"type": "subtitle", "time": 20807.868, "timestamp": "05:46:47", "text": "神。ああ、"}, {"type": "subtitle", "time": 20811.35, "timestamp": "05:46:51", "text": "神。何てことだ。実はそれ、着たことがあるんです。"}, {"type": "subtitle", "time": 20817.51, "timestamp": "05:46:57", "text": "それ？おお。"}]
[{"type": "subtitle", "time": 5105.47, "timestamp": "01:25:05", "text": "天才？どうやって"}, {"type": "subtitle", "time": 5110.59, "timestamp": "01:25:10", "text": "天才？ああ、なんてことだ、君は天才だ。見てください"}, {"type": "subtitle", "time": 5113.51, "timestamp": "01:25:13", "text": "あなた。それは文字通りあなたに待ってくれます、"}, {"type": "subtitle", "time": 5115.59, "timestamp": "01:25:15", "text": "UTFIのロゴが表示されますか？お願いします"}, {"type": "subtitle", "time": 5116.99, "timestamp": "01:25:16", "text": "教えて"}, {"type": "subtitle", "time": 5125.03, "timestamp": "01:25:25", "text": "読み込み中です。これは何ですか？日本。それは"}, {"type": "subtitle", "time": 5126.83, "timestamp": "01:25:26", "text": "本I"}, {"type": "subtitle", "time": 5133.87, "timestamp": "01:25:33", "text": "はぁ？これは何ですか？それは日本ですか"}, {"type": "subtitle", "time": 5158.149, "timestamp": "01:25:58", "text": "うん、日本の何かを入れたんだ"}]
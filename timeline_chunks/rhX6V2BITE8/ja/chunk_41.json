[{"type": "subtitle", "time": 2460.95, "timestamp": "00:41:00", "text": "取引処理をしなくてもいい"}, {"type": "subtitle", "time": 2463.99, "timestamp": "00:41:03", "text": "最後に取っておくけど、よくわからないけど"}, {"type": "subtitle", "time": 2466.23, "timestamp": "00:41:06", "text": "彼らは賛成で、"}, {"type": "subtitle", "time": 2468.39, "timestamp": "00:41:08", "text": "数人の人"}, {"type": "subtitle", "time": 2475.23, "timestamp": "00:41:15", "text": "ええと、たくさんのこと、そうですね、すべて"}, {"type": "subtitle", "time": 2478.15, "timestamp": "00:41:18", "text": "それは、あなたが"}, {"type": "subtitle", "time": 2481.349, "timestamp": "00:41:21", "text": "ビデオブラシを持ってきてください。うん。えっと"}, {"type": "subtitle", "time": 2483.349, "timestamp": "00:41:23", "text": "ええ、ストリーミングをしている人や"}, {"type": "subtitle", "time": 2486.23, "timestamp": "00:41:26", "text": "いろいろなものを手に入れ、私も特定のものを手に入れています"}, {"type": "subtitle", "time": 2488.47, "timestamp": "00:41:28", "text": "人。彼はどこにいますか？私が思うところ"}, {"type": "subtitle", "time": 2491.75, "timestamp": "00:41:31", "text": "彼をここに連れてきてください。待って、デートの約束したっけ？"}, {"type": "subtitle", "time": 2492.75, "timestamp": "00:41:32", "text": "のために"}, {"type": "subtitle", "time": 2496.79, "timestamp": "00:41:36", "text": "彼？私はしていません。右。オーはどこにいる？"}, {"type": "subtitle", "time": 2500.39, "timestamp": "00:41:40", "text": "彼は試験を受けている。わかった。週から"}, {"type": "subtitle", "time": 2502.47, "timestamp": "00:41:42", "text": "待って、どこかに置いたはずなんだけど。"}, {"type": "subtitle", "time": 2505.43, "timestamp": "00:41:45", "text": "私は彼をどこに置かなかったのだろうか？があります"}, {"type": "subtitle", "time": 2509.43, "timestamp": "00:41:49", "text": "デビューしたことのないバカだが"}, {"type": "subtitle", "time": 2513.95, "timestamp": "00:41:53", "text": "彼は永遠にデビュー前の段階にいる"}, {"type": "subtitle", "time": 2516.87, "timestamp": "00:41:56", "text": "一瞬。 6月中旬の午後、昼食後。"}, {"type": "subtitle", "time": 2519.99, "timestamp": "00:41:59", "text": "わかった。ショーは6月中旬。それはまるで私が"}]
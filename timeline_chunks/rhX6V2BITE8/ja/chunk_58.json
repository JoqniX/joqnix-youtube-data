[{"type": "subtitle", "time": 3481.91, "timestamp": "00:58:01", "text": "人々は、私に"}, {"type": "subtitle", "time": 3484.95, "timestamp": "00:58:04", "text": "予定日。私は自分のことで忙しい"}, {"type": "subtitle", "time": 3490.309, "timestamp": "00:58:10", "text": "物やその他すべて。ええ、その物"}, {"type": "subtitle", "time": 3491.75, "timestamp": "00:58:11", "text": "そして先週は荷造りをしなければならなかった"}, {"type": "subtitle", "time": 3493.829, "timestamp": "00:58:13", "text": "すべて、すべてをバックアップ、ファイル"}, {"type": "subtitle", "time": 3496.47, "timestamp": "00:58:16", "text": "そして全て。これらのファイルすべて"}, {"type": "subtitle", "time": 3498.63, "timestamp": "00:58:18", "text": "そして、YouTube Studio関連のものすべて、"}, {"type": "subtitle", "time": 3502.87, "timestamp": "00:58:22", "text": "音楽制作関係、えーと、モデル関係、"}, {"type": "subtitle", "time": 3506.069, "timestamp": "00:58:26", "text": "すべて。彼らを援護しなければならない。"}, {"type": "subtitle", "time": 3509.109, "timestamp": "00:58:29", "text": "SSDをいくつか持って行って、バックアップも取って"}, {"type": "subtitle", "time": 3512.23, "timestamp": "00:58:32", "text": "家族写真とか、全部。えっと、そして"}, {"type": "subtitle", "time": 3514.63, "timestamp": "00:58:34", "text": "そこに入れてください、私の"}, {"type": "subtitle", "time": 3517.27, "timestamp": "00:58:37", "text": "家族のアカウント、Googleドライブまたは"}, {"type": "subtitle", "time": 3519.51, "timestamp": "00:58:39", "text": "私が対処しなければならないこと"}, {"type": "subtitle", "time": 3524.23, "timestamp": "00:58:44", "text": "本当にたくさんのことがあるんだよ、兄弟。私は死にかけている。"}, {"type": "subtitle", "time": 3527.19, "timestamp": "00:58:47", "text": "ああ、でも最終的には私のフライトは"}, {"type": "subtitle", "time": 3531.71, "timestamp": "00:58:51", "text": "6月30日または6月1日"}, {"type": "subtitle", "time": 3534.549, "timestamp": "00:58:54", "text": "7月には私はここを去り、泣くでしょう"}, {"type": "subtitle", "time": 3536.95, "timestamp": "00:58:56", "text": "または、もし私がまだストリーミング配信を続けているなら"}, {"type": "subtitle", "time": 3539.91, "timestamp": "00:58:59", "text": "4週目頃にストリーミング配信される"}]
[{"type": "subtitle", "time": 18000.99, "timestamp": "05:00:00", "text": "ある意味、システムのようなものだ。それで、"}, {"type": "subtitle", "time": 18003.27, "timestamp": "05:00:03", "text": "うん。まあ、心配しないでください。ソロと"}, {"type": "subtitle", "time": 18006.75, "timestamp": "05:00:06", "text": "得点は有利になる"}, {"type": "subtitle", "time": 18010.15, "timestamp": "05:00:10", "text": "利点。それで、えっと、私たちは、"}, {"type": "subtitle", "time": 18013.51, "timestamp": "05:00:13", "text": "我々はイランと対戦できる。だから新しいことは"}, {"type": "subtitle", "time": 18017.43, "timestamp": "05:00:17", "text": "このアップデートは、"}, {"type": "subtitle", "time": 18020.07, "timestamp": "05:00:20", "text": "10日間、それは10日間か11日間のイベントです。"}, {"type": "subtitle", "time": 18023.19, "timestamp": "05:00:23", "text": "古典的なもの"}, {"type": "subtitle", "time": 18025.75, "timestamp": "05:00:25", "text": "このマップがゲームに戻ってくる"}, {"type": "subtitle", "time": 18029.27, "timestamp": "05:00:29", "text": "どうやら。私はソロで行くつもりで、まず"}, {"type": "subtitle", "time": 18031.35, "timestamp": "05:00:31", "text": "人物モード。私はサードではプレーしません"}, {"type": "subtitle", "time": 18035.23, "timestamp": "05:00:35", "text": "全くの人間ではない。あ、ウインク。しかし"}, {"type": "subtitle", "time": 18036.91, "timestamp": "05:00:36", "text": "うん、そうしよう"}, {"type": "subtitle", "time": 18040.23, "timestamp": "05:00:40", "text": "チェック。えっと、私は、私は、私は"}, {"type": "subtitle", "time": 18042.39, "timestamp": "05:00:42", "text": "電車に乗ってみる？トレーニングをするべきか、それとも"}, {"type": "subtitle", "time": 18049.07, "timestamp": "05:00:49", "text": "知る。友達が増えました。すべては私のせいだ"}, {"type": "subtitle", "time": 18051.59, "timestamp": "05:00:51", "text": "また。つまり、私には友達がいないんです"}, {"type": "subtitle", "time": 18054.948, "timestamp": "05:00:54", "text": "PUBGをプレイする人たち。そうですね、そうは思いません"}, {"type": "subtitle", "time": 18057.43, "timestamp": "05:00:57", "text": "ほとんどの人はプレイすらしないだろう。それで"}]
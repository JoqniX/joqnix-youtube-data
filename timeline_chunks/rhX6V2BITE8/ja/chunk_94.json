[{"type": "subtitle", "time": 5663.91, "timestamp": "01:34:23", "text": "えっと、私はちょっと、わからないんだけど"}, {"type": "subtitle", "time": 5666.31, "timestamp": "01:34:26", "text": "誰でもできることだけど、うん、"}, {"type": "subtitle", "time": 5668.55, "timestamp": "01:34:28", "text": "もしあなたがそれをしたいのなら、"}, {"type": "subtitle", "time": 5672.149, "timestamp": "01:34:32", "text": "あなたがそれをやるのを見たいです。私はそうしなければならない"}, {"type": "subtitle", "time": 5682.79, "timestamp": "01:34:42", "text": "欲しいものはたくさんあるけど"}, {"type": "subtitle", "time": 5689.35, "timestamp": "01:34:49", "text": "可能。それはやりすぎかもしれない。多分"}, {"type": "subtitle", "time": 5696.229, "timestamp": "01:34:56", "text": "知る。わからない。私の究極を見てください"}, {"type": "subtitle", "time": 5699.91, "timestamp": "01:34:59", "text": "目標は、皆さんと同じように"}]
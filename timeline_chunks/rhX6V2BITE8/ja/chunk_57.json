[{"type": "subtitle", "time": 3422.549, "timestamp": "00:57:02", "text": "6か月ぶりに配信開始。私は"}, {"type": "subtitle", "time": 3425.99, "timestamp": "00:57:05", "text": "できないよ、今は収益化されている"}, {"type": "subtitle", "time": 3429.15, "timestamp": "00:57:09", "text": "jockathonで収益化を実現できました"}, {"type": "subtitle", "time": 3432.87, "timestamp": "00:57:12", "text": "ああ、私は全部捨てることはできない"}, {"type": "subtitle", "time": 3435.589, "timestamp": "00:57:15", "text": "皆さんが応援してくださったアート作品と"}, {"type": "subtitle", "time": 3439.109, "timestamp": "00:57:19", "text": "すべて正しかったので、再研削する必要がありました"}, {"type": "subtitle", "time": 3442.47, "timestamp": "00:57:22", "text": "全体的にすごく大変だろうね"}, {"type": "subtitle", "time": 3447.43, "timestamp": "00:57:27", "text": "だから私は何とかして道を切り開くつもりだった"}, {"type": "subtitle", "time": 3449.589, "timestamp": "00:57:29", "text": "もし方法があるなら、もし意志があるなら"}, {"type": "subtitle", "time": 3451.43, "timestamp": "00:57:31", "text": "必ず方法はある。わかった。それで、"}, {"type": "subtitle", "time": 3453.67, "timestamp": "00:57:33", "text": "うん、心配しないで。ジョギング、行かないで"}, {"type": "subtitle", "time": 3455.19, "timestamp": "00:57:35", "text": "日本。寂しくなるよ。心配しないで、"}, {"type": "subtitle", "time": 3456.43, "timestamp": "00:57:36", "text": "私はじっとしている"}, {"type": "subtitle", "time": 3458.789, "timestamp": "00:57:38", "text": "その周り。全てがうまくいくことを祈りましょう。"}, {"type": "subtitle", "time": 3461.47, "timestamp": "00:57:41", "text": "まだできることを願おう"}, {"type": "subtitle", "time": 3463.829, "timestamp": "00:57:43", "text": "ストリーム。ええ、そうですね。ええと、その頃には彼らは"}, {"type": "subtitle", "time": 3466.23, "timestamp": "00:57:46", "text": "COEを取得して、それから全てを実行する。"}, {"type": "subtitle", "time": 3469.829, "timestamp": "00:57:49", "text": "すると、出発は3回目くらいになるだろう"}, {"type": "subtitle", "time": 3472.71, "timestamp": "00:57:52", "text": "確か1週間だったと思います。だから、それは"}, {"type": "subtitle", "time": 3476.309, "timestamp": "00:57:56", "text": "衝突する。いつその物が。"}, {"type": "subtitle", "time": 3478.39, "timestamp": "00:57:58", "text": "アカデミーに電話する必要があるかもしれない"}]
[{"type": "subtitle", "time": 16982.67, "timestamp": "04:43:02", "text": "4 くらいにしすぎる"}, {"type": "subtitle", "time": 16987.868, "timestamp": "04:43:07", "text": "でも少なくとも最大2時間"}, {"type": "subtitle", "time": 16991.27, "timestamp": "04:43:11", "text": "こうして世界の監視者たちは"}, {"type": "subtitle", "time": 16993.03, "timestamp": "04:43:13", "text": "アーカイブなどを見ている人たち"}, {"type": "subtitle", "time": 16995.35, "timestamp": "04:43:15", "text": "追いつくのに時間がかからない"}, {"type": "subtitle", "time": 16997.03, "timestamp": "04:43:17", "text": "すべて、そして今すべて。全て"}, {"type": "subtitle", "time": 17001.11, "timestamp": "04:43:21", "text": "右。それと、テレグラムのあのやつも"}, {"type": "subtitle", "time": 17002.788, "timestamp": "04:43:22", "text": "リンクは説明欄にあります。あなたはできる"}, {"type": "subtitle", "time": 17006.788, "timestamp": "04:43:26", "text": "ソーシャルメディアのセクションで確認してください。それで"}, {"type": "subtitle", "time": 17009.788, "timestamp": "04:43:29", "text": "確認してみてください。"}, {"type": "subtitle", "time": 17014.708, "timestamp": "04:43:34", "text": "また、ええ、たとえ"}, {"type": "subtitle", "time": 17017.35, "timestamp": "04:43:37", "text": "スケジュール配信 えーと、投稿しただけです"}, {"type": "subtitle", "time": 17020.788, "timestamp": "04:43:40", "text": "今日はYouTube関連の投稿です。今週は"}, {"type": "subtitle", "time": 17025.11, "timestamp": "04:43:45", "text": "もし私が、もし私が、リフレームしたら、覚えておいてください"}, {"type": "subtitle", "time": 17026.99, "timestamp": "04:43:46", "text": "ストリーミング配信されます"}, {"type": "subtitle", "time": 17029.35, "timestamp": "04:43:49", "text": "Twitch の一部ではない"}, {"type": "subtitle", "time": 17033.03, "timestamp": "04:43:53", "text": "スケジュールですが、それは、ええと、私は"}, {"type": "subtitle", "time": 17035.67, "timestamp": "04:43:55", "text": "それを発表する。もし私がライブ配信するなら"}, {"type": "subtitle", "time": 17037.91, "timestamp": "04:43:57", "text": "Twitch、Discordで発表します。"}]
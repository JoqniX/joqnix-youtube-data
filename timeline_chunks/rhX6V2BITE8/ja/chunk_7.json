[{"type": "subtitle", "time": 423.83, "timestamp": "00:07:03", "text": "IST。そう、それで私は見に行こうとしていた"}, {"type": "subtitle", "time": 426.309, "timestamp": "00:07:06", "text": "私の友達リストにいるすべての人A"}, {"type": "subtitle", "time": 428.39, "timestamp": "00:07:08", "text": "Zまで"}, {"type": "subtitle", "time": 431.629, "timestamp": "00:07:11", "text": "えーとAからZまで、たくさんの人に連絡を取りました"}, {"type": "subtitle", "time": 434.39, "timestamp": "00:07:14", "text": "この時点で私が到達した人より"}, {"type": "subtitle", "time": 437.589, "timestamp": "00:07:17", "text": "たくさんの人に届いて、私は「わあ」って感じ"}, {"type": "subtitle", "time": 439.589, "timestamp": "00:07:19", "text": "それは正気の沙汰ではない。"}, {"type": "subtitle", "time": 442.029, "timestamp": "00:07:22", "text": "それは実際には"}, {"type": "subtitle", "time": 444.43, "timestamp": "00:07:24", "text": "非常識な。"}, {"type": "subtitle", "time": 447.11, "timestamp": "00:07:27", "text": "ああ、そうだよ、だって私は人々のことを覚えているから"}, {"type": "subtitle", "time": 449.39, "timestamp": "00:07:29", "text": "人を大切にする、"}, {"type": "subtitle", "time": 452.67, "timestamp": "00:07:32", "text": "ピンク色を忘れる。それで"}, {"type": "subtitle", "time": 454.199, "timestamp": "00:07:34", "text": "それで とにかく、とにかく、それで私はいくつか手に入れたい"}, {"type": "subtitle", "time": 458.319, "timestamp": "00:07:38", "text": "とにかく、とにかく、それで私はいくつか手に入れたい 作業完了。えーと、タスクリスト タスクリスト"}, {"type": "subtitle", "time": 462.479, "timestamp": "00:07:42", "text": "作業完了。えーと、タスクリスト タスクリスト 今日の作業は、2つ書くことです"}, {"type": "subtitle", "time": 465.84000000000003, "timestamp": "00:07:45", "text": "今日の作業は、2つ書くことです 過去2回の配信の概要"}, {"type": "subtitle", "time": 467.36, "timestamp": "00:07:47", "text": "過去2回の配信の概要 昨日と一昨日"}, {"type": "subtitle", "time": 469.28, "timestamp": "00:07:49", "text": "昨日と一昨日 Twitterの要約は1つ2つです"}, {"type": "subtitle", "time": 473.12, "timestamp": "00:07:53", "text": "Twitterの要約は1つ2つです 最終決定して"}, {"type": "subtitle", "time": 475.68, "timestamp": "00:07:55", "text": "最終決定して ジョックアソン関連のものに興味がある人たち"}, {"type": "subtitle", "time": 478.639, "timestamp": "00:07:58", "text": "ジ
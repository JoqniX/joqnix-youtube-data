[{"type": "subtitle", "time": 15960.429, "timestamp": "04:26:00", "text": "の上。わかった。それで、"}, {"type": "subtitle", "time": 15965.389, "timestamp": "04:26:05", "text": "えっと、この物には毛羽が欠けているか、"}, {"type": "subtitle", "time": 15972.189, "timestamp": "04:26:12", "text": "ああ、どこに"}, {"type": "subtitle", "time": 15976.07, "timestamp": "04:26:16", "text": "彼？ここの中みたいな感じですか、それとも"}, {"type": "subtitle", "time": 15978.11, "timestamp": "04:26:18", "text": "どこかで"}, {"type": "subtitle", "time": 15982.03, "timestamp": "04:26:22", "text": "それ以外？あるいは、そうかもしれない。"}, {"type": "subtitle", "time": 15993.349, "timestamp": "04:26:33", "text": "そこには？わかった。だから、起き上がれないんだね。おお、"}, {"type": "subtitle", "time": 15994.83, "timestamp": "04:26:34", "text": "待って。あなた"}, {"type": "subtitle", "time": 16000.349, "timestamp": "04:26:40", "text": "できる。さて、行方不明の"}, {"type": "subtitle", "time": 16002.95, "timestamp": "04:26:42", "text": "人？それは疑問ですね。私も"}, {"type": "subtitle", "time": 16014.95, "timestamp": "04:26:54", "text": "キルポイントは獲得していません。だから私は"}, {"type": "subtitle", "time": 16017.79, "timestamp": "04:26:57", "text": "一番上か、"}]
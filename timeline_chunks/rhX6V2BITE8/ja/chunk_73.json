[{"type": "subtitle", "time": 4382.91, "timestamp": "01:13:02", "text": "そして、そう、それは私を幸せにしてくれた"}, {"type": "subtitle", "time": 4386.79, "timestamp": "01:13:06", "text": "ええ、でもまだまだ改善すべき点はたくさんあります。"}, {"type": "subtitle", "time": 4389.83, "timestamp": "01:13:09", "text": "たとえ今襲撃を受けたとしても、"}, {"type": "subtitle", "time": 4393.27, "timestamp": "01:13:13", "text": "面白く、かつ"}, {"type": "subtitle", "time": 4395.91, "timestamp": "01:13:15", "text": "視聴者や実際の視聴者に彼らを分類する"}, {"type": "subtitle", "time": 4398.149, "timestamp": "01:13:18", "text": "そして、時間をかけて物事を進めたり、後で願いを叶えたりします。"}, {"type": "subtitle", "time": 4401.59, "timestamp": "01:13:21", "text": "の上。潜伏者と、潜伏者を見る"}, {"type": "subtitle", "time": 4405.189, "timestamp": "01:13:25", "text": "いつでもどこにでも、キックでも"}, {"type": "subtitle", "time": 4407.03, "timestamp": "01:13:27", "text": "今すぐ"}, {"type": "subtitle", "time": 4409.03, "timestamp": "01:13:29", "text": "キックやその他のプラットフォームは"}, {"type": "subtitle", "time": 4411.91, "timestamp": "01:13:31", "text": "潜伏者は実際に彼らを改宗させるために潜伏している"}, {"type": "subtitle", "time": 4415.43, "timestamp": "01:13:35", "text": "フォロワーか、あるいは"}, {"type": "subtitle", "time": 4417.35, "timestamp": "01:13:37", "text": "最終的には購読またはフォローしてください"}, {"type": "subtitle", "time": 4419.99, "timestamp": "01:13:39", "text": "内容は少し難しいが、やらなければならない"}, {"type": "subtitle", "time": 4422.55, "timestamp": "01:13:42", "text": "私の最善の権利は、私がそれについて話したことです"}, {"type": "subtitle", "time": 4424.55, "timestamp": "01:13:44", "text": "私がこのことについて話していたときの詳細"}, {"type": "subtitle", "time": 4429.189, "timestamp": "01:13:49", "text": "配信中のゲストで、どうやら"}, {"type": "subtitle", "time": 4431.83, "timestamp": "01:13:51", "text": "あのレイド配信者の1人が"}, {"type": "subtitle", "time": 4434.83, "timestamp": "01:13:54", "text": "土曜日のコラボレーションはそこにあり、彼らは"}, {"type": "subtitle", "time": 4437.99, "timestamp": "01:13:57", "text": "まだ盗聴していたので、"}]
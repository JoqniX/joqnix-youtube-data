[{"type": "subtitle", "time": 14943.469, "timestamp": "04:09:03", "text": "在庫に移動するような"}, {"type": "subtitle", "time": 14952.269, "timestamp": "04:09:12", "text": "え、何？何が欠けているのか"}, {"type": "subtitle", "time": 14954.91, "timestamp": "04:09:14", "text": "多くの？あまりにも多くのことが"}, {"type": "subtitle", "time": 14964.79, "timestamp": "04:09:24", "text": "感じているのは私だけでしょうか、そして"}, {"type": "subtitle", "time": 14966.99, "timestamp": "04:09:26", "text": "これですか"}, {"type": "subtitle", "time": 14971.87, "timestamp": "04:09:31", "text": "行方不明者を破壊する"}, {"type": "subtitle", "time": 14993.269, "timestamp": "04:09:53", "text": "わかった、あのね？私は興味があります"}, {"type": "subtitle", "time": 14999.15, "timestamp": "04:09:59", "text": "ハイキング。私にさせて"}]
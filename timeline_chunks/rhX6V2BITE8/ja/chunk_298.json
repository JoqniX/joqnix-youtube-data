[{"type": "subtitle", "time": 17881.948, "timestamp": "04:58:01", "text": "昼食は召し上がりましたか？"}, {"type": "subtitle", "time": 17893.19, "timestamp": "04:58:13", "text": "ああ、よし、これで大丈夫だろう。ラーのポーズ。する"}, {"type": "subtitle", "time": 17895.99, "timestamp": "04:58:15", "text": "その翻訳、分かりますか？はい、そうです"}, {"type": "subtitle", "time": 17902.51, "timestamp": "04:58:22", "text": "ニース。あ、待って。これはまるで"}, {"type": "subtitle", "time": 17906.868, "timestamp": "04:58:26", "text": "えっと、忘れてました。しかしPUBGの場合、これは"}, {"type": "subtitle", "time": 17911.19, "timestamp": "04:58:31", "text": "それは、えーと、あちら側ですね。いいえ。"}, {"type": "subtitle", "time": 17914.31, "timestamp": "04:58:34", "text": "音声は正しいですか？よし、それは良いことだ。あなたは"}, {"type": "subtitle", "time": 17915.99, "timestamp": "04:58:35", "text": "ソロで行くか、スコットと行くか？もちろん行くよ"}, {"type": "subtitle", "time": 17924.31, "timestamp": "04:58:44", "text": "私はソロで行くつもりです。もちろん、"}, {"type": "subtitle", "time": 17928.19, "timestamp": "04:58:48", "text": "一人でいること。ソロ"}, {"type": "subtitle", "time": 17931.948, "timestamp": "04:58:51", "text": "ギャングミーはソロです"}, {"type": "subtitle", "time": 17934.47, "timestamp": "04:58:54", "text": "ギャング。あ、待って。あぁ、忘れてた。えっと、"}, {"type": "subtitle", "time": 17938.35, "timestamp": "04:58:58", "text": "昨日は完全に終わらせなかった"}]
[{"type": "subtitle", "time": 4260.47, "timestamp": "01:11:00", "text": "もう5つくらいやったよ。だから私は"}, {"type": "subtitle", "time": 4263.47, "timestamp": "01:11:03", "text": "そうですね、私は7回のうち6回はできます。"}, {"type": "subtitle", "time": 4266.51, "timestamp": "01:11:06", "text": "1日2時間ずつ、または1時間ずつ"}, {"type": "subtitle", "time": 4269.43, "timestamp": "01:11:09", "text": "それぞれ。しかし、ほとんどの人は"}, {"type": "subtitle", "time": 4273.189, "timestamp": "01:11:13", "text": "同じタイムゾーン、または3時間または4時間"}, {"type": "subtitle", "time": 4277.27, "timestamp": "01:11:17", "text": "時間進んでいるか遅れているか。そう、それは"}, {"type": "subtitle", "time": 4278.709, "timestamp": "01:11:18", "text": "少し"}, {"type": "subtitle", "time": 4284.75, "timestamp": "01:11:24", "text": "難しい。もっとカナダ人が必要だと感じる"}, {"type": "subtitle", "time": 4286.51, "timestamp": "01:11:26", "text": "今。"}, {"type": "subtitle", "time": 4291.39, "timestamp": "01:11:31", "text": "でも、タイミングも間違えてしまったんです。のみ"}, {"type": "subtitle", "time": 4295.87, "timestamp": "01:11:35", "text": "1つ。私と一緒の場合のみ。ミオアン。やったよ"}, {"type": "subtitle", "time": 4298.55, "timestamp": "01:11:38", "text": "きちんと。私は眠れなかったと思う。それとも"}, {"type": "subtitle", "time": 4301.189, "timestamp": "01:11:41", "text": "私は寝る？忘れた。熱があった"}, {"type": "subtitle", "time": 4304.229, "timestamp": "01:11:44", "text": "その日、私は4つのコラボレーションをしました"}, {"type": "subtitle", "time": 4307.51, "timestamp": "01:11:47", "text": "土曜日にだよ、兄弟。"}, {"type": "subtitle", "time": 4315.27, "timestamp": "01:11:55", "text": "午後10時以降の発熱コラボレーション。後"}, {"type": "subtitle", "time": 4317.95, "timestamp": "01:11:57", "text": "それを終わらせることで"}]
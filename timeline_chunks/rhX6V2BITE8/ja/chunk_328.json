[{"type": "subtitle", "time": 19688.788, "timestamp": "05:28:08", "text": "シュート。今行ってる。今行ってる。私は"}, {"type": "subtitle", "time": 19690.91, "timestamp": "05:28:10", "text": "来るよ。"}, {"type": "subtitle", "time": 19702.948, "timestamp": "05:28:22", "text": "神。何てことだ。"}, {"type": "subtitle", "time": 19719.708, "timestamp": "05:28:39", "text": "ニース。"}, {"type": "subtitle", "time": 19721.47, "timestamp": "05:28:41", "text": "おお、"}, {"type": "subtitle", "time": 19732.47, "timestamp": "05:28:52", "text": "えっと、私は「as」を使うべきでしょうか？なぜダメなのですか？"}, {"type": "subtitle", "time": 19736.39, "timestamp": "05:28:56", "text": "ほら、レーザーがあるでしょ。ニース。誰の銃が"}]
[{"type": "subtitle", "time": 10680.63, "timestamp": "02:58:00", "text": "私たちは文字通りこれを探検するでしょう"}, {"type": "subtitle", "time": 10683.83, "timestamp": "02:58:03", "text": "私たちの地球。よし、これから探検しよう"}, {"type": "subtitle", "time": 10687.59, "timestamp": "02:58:07", "text": "惑星を透視するようなこと。いいえ、"}, {"type": "subtitle", "time": 10690.269, "timestamp": "02:58:10", "text": "惑星ではなく、地球の物、"}, {"type": "subtitle", "time": 10694.469, "timestamp": "02:58:14", "text": "知る。こんにちは。でも、短いストリームARは"}, {"type": "subtitle", "time": 10696.87, "timestamp": "02:58:16", "text": "たった2時間だと思います。私はしようとしています"}, {"type": "subtitle", "time": 10699.269, "timestamp": "02:58:19", "text": "そうすることで、私は"}, {"type": "subtitle", "time": 10703.03, "timestamp": "02:58:23", "text": "スピードランでたくさんのものをこなす。うん。"}, {"type": "subtitle", "time": 10705.59, "timestamp": "02:58:25", "text": "うん。また、私は何も言及しませんでした"}, {"type": "subtitle", "time": 10707.99, "timestamp": "02:58:27", "text": "Twitchの配信はこちらです。だから、"}, {"type": "subtitle", "time": 10711.67, "timestamp": "02:58:31", "text": "心配。えっと、TWについて言及します。"}, {"type": "subtitle", "time": 10713.99, "timestamp": "02:58:33", "text": "えっと、このTwitchストリームを配信します"}, {"type": "subtitle", "time": 10718.309, "timestamp": "02:58:38", "text": "ダイナミックなライブの"}, {"type": "subtitle", "time": 10721.75, "timestamp": "02:58:41", "text": "チャンネルだけど自動投稿するやつ"}, {"type": "subtitle", "time": 10723.91, "timestamp": "02:58:43", "text": "私がライブ配信をしているときはいつでも、"}, {"type": "subtitle", "time": 10726.99, "timestamp": "02:58:46", "text": "ディスコードと、時間も表示されます"}, {"type": "subtitle", "time": 10730.63, "timestamp": "02:58:50", "text": "回。だから、もしあなたが"}, {"type": "subtitle", "time": 10732.87, "timestamp": "02:58:52", "text": "スケジュールが正しい場合、"}, {"type": "subtitle", "time": 10735.99, "timestamp": "02:58:55", "text": "えーと、それらの時間を使うのは誰ですか？"}]
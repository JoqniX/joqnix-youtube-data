[{"type": "subtitle", "time": 14161.429, "timestamp": "03:56:01", "text": "あなたは、一人の人間よりも多くの仕事を見つけるでしょう"}, {"type": "subtitle", "time": 14164.389, "timestamp": "03:56:04", "text": "対処できる。"}, {"type": "subtitle", "time": 14166.55, "timestamp": "03:56:06", "text": "信頼度。発見する唯一の方法は"}, {"type": "subtitle", "time": 14168.229, "timestamp": "03:56:08", "text": "太陽の子らの秘密"}, {"type": "subtitle", "time": 14171.389, "timestamp": "03:56:11", "text": "獲得された受容"}, {"type": "subtitle", "time": 14175.269, "timestamp": "03:56:15", "text": "P. 母の最も献身的な守護者。"}, {"type": "subtitle", "time": 14177.99, "timestamp": "03:56:17", "text": "クエストを完了する。出会った人々を助けて"}, {"type": "subtitle", "time": 14181.429, "timestamp": "03:56:21", "text": "野生。安全地帯を確保する。ただし、試してみてください"}, {"type": "subtitle", "time": 14189.91, "timestamp": "03:56:29", "text": "わかった。つまり、レベルアップするということです"}, {"type": "subtitle", "time": 14191.15, "timestamp": "03:56:31", "text": "私たちの"}, {"type": "subtitle", "time": 14195.03, "timestamp": "03:56:35", "text": "信仰。信頼度が十分ではない。あなたは"}, {"type": "subtitle", "time": 14197.55, "timestamp": "03:56:37", "text": "今では見知らぬ人だ。"}, {"type": "subtitle", "time": 14210.51, "timestamp": "03:56:50", "text": "おばあさんが私にポーズをとるようにしつこく言ってくる"}, {"type": "subtitle", "time": 14213.99, "timestamp": "03:56:53", "text": "これは、発情期の猫がいることを示しています"}, {"type": "subtitle", "time": 14218.99, "timestamp": "03:56:58", "text": "または、病気の猫がバルブの近くで泣き出す"}]
[{"type": "subtitle", "time": 16022.03, "timestamp": "04:27:02", "text": "何か。しかし、もしそれがオンだったら"}, {"type": "subtitle", "time": 16025.269, "timestamp": "04:27:05", "text": "上部には、それだけが表示されているはずです。"}, {"type": "subtitle", "time": 16026.269, "timestamp": "04:27:06", "text": "いいえ、"}, {"type": "subtitle", "time": 16030.95, "timestamp": "04:27:10", "text": "でも、何も表示されないんですよね。"}, {"type": "subtitle", "time": 16034.67, "timestamp": "04:27:14", "text": "どこで入手して使うべきなのですか？"}, {"type": "subtitle", "time": 16043.8, "timestamp": "04:27:23", "text": "人？では、どのように使用すればよいのでしょうか？"}, {"type": "subtitle", "time": 16057.83, "timestamp": "04:27:37", "text": "何もない。もし私がスキャンして停止したら、"}, {"type": "subtitle", "time": 16069.59, "timestamp": "04:27:49", "text": "秋。わかった。あの、あのね？それは"}, {"type": "subtitle", "time": 16075.83, "timestamp": "04:27:55", "text": "戻る。実際にはやり方がわからない"}, {"type": "subtitle", "time": 16079.389, "timestamp": "04:27:59", "text": "適切に見つける"}]
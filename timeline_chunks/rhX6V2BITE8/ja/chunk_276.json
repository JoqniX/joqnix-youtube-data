[{"type": "subtitle", "time": 16562.67, "timestamp": "04:36:02", "text": "まだ配信されていません。それでは、AR に行って"}, {"type": "subtitle", "time": 16565.709, "timestamp": "04:36:05", "text": "いいね！して保存してください。"}, {"type": "subtitle", "time": 16568.349, "timestamp": "04:36:08", "text": "わかった。聖なる"}, {"type": "subtitle", "time": 16570.189, "timestamp": "04:36:10", "text": "神よ、私は"}, {"type": "subtitle", "time": 16572.869, "timestamp": "04:36:12", "text": "左。車両を修理する必要があります"}, {"type": "subtitle", "time": 16574.67, "timestamp": "04:36:14", "text": "アルーダ"}, {"type": "subtitle", "time": 16577.869, "timestamp": "04:36:17", "text": "後で。しかし今は"}, {"type": "subtitle", "time": 16580.91, "timestamp": "04:36:20", "text": "大丈夫。私"}, {"type": "subtitle", "time": 16583.189, "timestamp": "04:36:23", "text": "仮定する。ええ、セーフハウスですね。私は"}, {"type": "subtitle", "time": 16586.429, "timestamp": "04:36:26", "text": "セーフハウス。ええ、それは"}, {"type": "subtitle", "time": 16589.47, "timestamp": "04:36:29", "text": "近い。わーい。"}, {"type": "subtitle", "time": 16592.429, "timestamp": "04:36:32", "text": "最後に、ガス"}, {"type": "subtitle", "time": 16596.75, "timestamp": "04:36:36", "text": "燃料。ねえ、君ならできると思うよ"}, {"type": "subtitle", "time": 16601.39, "timestamp": "04:36:41", "text": "ええと、給油できますよ。"}, {"type": "subtitle", "time": 16604.23, "timestamp": "04:36:44", "text": "ああ、それはすごくクールだね。わかった、それは"}, {"type": "subtitle", "time": 16605.789, "timestamp": "04:36:45", "text": "いいね。それはとても"}, {"type": "subtitle", "time": 16608.91, "timestamp": "04:36:48", "text": "いいね。何回できますか"}, {"type": "subtitle", "time": 16611.51, "timestamp": "04:36:51", "text": "燃料補給？つまり、これはガスのはず"}, {"type": "subtitle", "time": 16613.39, "timestamp": "04:36:53", "text": "タンク。いいえ、"}]
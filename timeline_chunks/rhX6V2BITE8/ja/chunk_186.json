[{"type": "subtitle", "time": 11167.79, "timestamp": "03:06:07", "text": "秒はい、あなたは"}, {"type": "subtitle", "time": 11170.03, "timestamp": "03:06:10", "text": "行くよ。"}, {"type": "subtitle", "time": 11175.469, "timestamp": "03:06:15", "text": "えっと、それはビンです。いらっしゃいませ"}, {"type": "subtitle", "time": 11179.07, "timestamp": "03:06:19", "text": "ビン。よし、そこへ行かなきゃ。"}, {"type": "subtitle", "time": 11183.99, "timestamp": "03:06:23", "text": "右？ああ、そんなやり方ではダメだ。"}, {"type": "subtitle", "time": 11187.469, "timestamp": "03:06:27", "text": "しかし、私は正しい道を歩んでいるのだろうか？"}, {"type": "subtitle", "time": 11191.429, "timestamp": "03:06:31", "text": "パス？ただ知りたいだけです。つまり、"}, {"type": "subtitle", "time": 11197.15, "timestamp": "03:06:37", "text": "ここ、"}, {"type": "subtitle", "time": 11199.63, "timestamp": "03:06:39", "text": "右？それから"}, {"type": "subtitle", "time": 11202.23, "timestamp": "03:06:42", "text": "なぜ？なぜ私はこうしなければならないと感じるのだろうか"}, {"type": "subtitle", "time": 11204.03, "timestamp": "03:06:44", "text": "ジャンプ"}, {"type": "subtitle", "time": 11209.59, "timestamp": "03:06:49", "text": "うわぁ。こうやってやるんだ、"}, {"type": "subtitle", "time": 11211.62, "timestamp": "03:06:51", "text": "右？わかりません。"}, {"type": "subtitle", "time": 11214.469, "timestamp": "03:06:54", "text": "[音楽]"}, {"type": "subtitle", "time": 11218.15, "timestamp": "03:06:58", "text": "H. わかりました。ジャンプ。ああ、それは愚かなことだった。それ"}]
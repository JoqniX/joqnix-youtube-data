[{"type": "subtitle", "time": 14761.11, "timestamp": "04:06:01", "text": "道路では、車が壊れてしまうでしょう"}, {"type": "subtitle", "time": 14762.349, "timestamp": "04:06:02", "text": "または"}, {"type": "subtitle", "time": 14764.87, "timestamp": "04:06:04", "text": "何か。いや、そうでもないかもしれない。わからない。"}, {"type": "subtitle", "time": 14766.269, "timestamp": "04:06:06", "text": "たぶん私は"}, {"type": "subtitle", "time": 14772.99, "timestamp": "04:06:12", "text": "[音楽]"}, {"type": "subtitle", "time": 14775.59, "timestamp": "04:06:15", "text": "知る。ええ、彼らは準備しています"}, {"type": "subtitle", "time": 14794.95, "timestamp": "04:06:34", "text": "フォローする。よし、私たちは"}, {"type": "subtitle", "time": 14810.41, "timestamp": "04:06:50", "text": "道。わかった、ちょっと待って"}]
[{"type": "subtitle", "time": 10441.15, "timestamp": "02:54:01", "text": "上。彼はどこにいますか？さあ、心を開いて。開ける"}, {"type": "subtitle", "time": 10442.75, "timestamp": "02:54:02", "text": "上"}, {"type": "subtitle", "time": 10447.11, "timestamp": "02:54:07", "text": "開ける。わかった。だから、そうでない人たちのために"}, {"type": "subtitle", "time": 10449.429, "timestamp": "02:54:09", "text": "連絡を取り続けている人たち"}, {"type": "subtitle", "time": 10450.67, "timestamp": "02:54:10", "text": "私の"}, {"type": "subtitle", "time": 10455.23, "timestamp": "02:54:15", "text": "物事、私たちは始めています"}, {"type": "subtitle", "time": 10459.83, "timestamp": "02:54:19", "text": "またスケジュールの件ですね。そうですね、"}, {"type": "subtitle", "time": 10463.15, "timestamp": "02:54:23", "text": "文字通りスケジュールから始めます"}, {"type": "subtitle", "time": 10465.95, "timestamp": "02:54:25", "text": "もの。もし私ができるなら"}, {"type": "subtitle", "time": 10471.269, "timestamp": "02:54:31", "text": "どこを探せばいいか。待って、ちょっと待って。"}, {"type": "subtitle", "time": 10473.75, "timestamp": "02:54:33", "text": "私のどこ？ ああ、入れてないよ"}, {"type": "subtitle", "time": 10475.99, "timestamp": "02:54:35", "text": "シーン。あ、ごめんなさい。私のミスです。私のミスです。私"}, {"type": "subtitle", "time": 10478.15, "timestamp": "02:54:38", "text": "私はこのシーンには入れていません。"}, {"type": "subtitle", "time": 10480.269, "timestamp": "02:54:40", "text": "はい、私の"}, {"type": "subtitle", "time": 10483.389, "timestamp": "02:54:43", "text": "悪い。えっと、コピーさせてください"}, {"type": "subtitle", "time": 10489.07, "timestamp": "02:54:49", "text": "これ。技術的な話で申し訳ありません。しかし"}, {"type": "subtitle", "time": 10491.469, "timestamp": "02:54:51", "text": "うん、終わったよ。もうすぐ終わります。ほとんど"}, {"type": "subtitle", "time": 10496.51, "timestamp": "02:54:56", "text": "終わり。こんにちは。これです。こんにちは。そうすれば"}]
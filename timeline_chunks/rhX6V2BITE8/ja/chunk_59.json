[{"type": "subtitle", "time": 3541.99, "timestamp": "00:59:01", "text": "コラボレーションやその他一切なし"}, {"type": "subtitle", "time": 3545.03, "timestamp": "00:59:05", "text": "それは私だけでしょう、私は自分の"}, {"type": "subtitle", "time": 3548.789, "timestamp": "00:59:08", "text": "最後の配信かな"}, {"type": "subtitle", "time": 3552.87, "timestamp": "00:59:12", "text": "ええ、泣いて感情的になる"}, {"type": "subtitle", "time": 3554.99, "timestamp": "00:59:14", "text": "ジェットコースターを振り返ってみると"}, {"type": "subtitle", "time": 3560.549, "timestamp": "00:59:20", "text": "ええ、笑顔で入っていきましょう"}, {"type": "subtitle", "time": 3562.789, "timestamp": "00:59:22", "text": "顔。はい、皆さんに最新情報をお伝えします。"}, {"type": "subtitle", "time": 3566.19, "timestamp": "00:59:26", "text": "可能であればDiscordまたはTwitterで"}, {"type": "subtitle", "time": 3569.75, "timestamp": "00:59:29", "text": "いつも全て。 Vlogを投稿してみます"}, {"type": "subtitle", "time": 3572.789, "timestamp": "00:59:32", "text": "コンテンツか何かかもしれない。私は欲しい"}, {"type": "subtitle", "time": 3575.47, "timestamp": "00:59:35", "text": "YouTubeチャンネルをアクティブに保つため"}, {"type": "subtitle", "time": 3579.589, "timestamp": "00:59:39", "text": "活動的で、信者に関する最新情報。私はとても"}, {"type": "subtitle", "time": 3585.349, "timestamp": "00:59:45", "text": "まだ理解できていない、まだ理解できていない"}, {"type": "subtitle", "time": 3587.589, "timestamp": "00:59:47", "text": "公式サーバーに招待され、"}, {"type": "subtitle", "time": 3589.91, "timestamp": "00:59:49", "text": "信じられないことに、ストリーミングができません。負けました"}, {"type": "subtitle", "time": 3592.789, "timestamp": "00:59:52", "text": "公式に失効し、アクセスも失った"}, {"type": "subtitle", "time": 3596.789, "timestamp": "00:59:56", "text": "私が所属していた代理店のホワイトリスト登録のため"}]
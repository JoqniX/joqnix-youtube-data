[{"type": "subtitle", "time": 8463.469, "timestamp": "02:21:03", "text": "保存"}, {"type": "subtitle", "time": 8467.349, "timestamp": "02:21:07", "text": "一時的に。なあ、俺は名前を変えられないんだ"}, {"type": "subtitle", "time": 8469.15, "timestamp": "02:21:09", "text": "で"}, {"type": "subtitle", "time": 8472.99, "timestamp": "02:21:12", "text": "これ。私は"}, {"type": "subtitle", "time": 8476.55, "timestamp": "02:21:16", "text": "ボット。それは何ですか？なぜなら私はそうしなければならないから"}, {"type": "subtitle", "time": 8484.309, "timestamp": "02:21:24", "text": "待つべきでしょうか？自分にはどれくらい必要か分かっている。しないで"}, {"type": "subtitle", "time": 8486.469, "timestamp": "02:21:26", "text": "よく知っている。たくさん面白い"}, {"type": "subtitle", "time": 8488.389, "timestamp": "02:21:28", "text": "ちょっと面白いディテール。私の言葉は"}, {"type": "subtitle", "time": 8490.309, "timestamp": "02:21:30", "text": "中国語コンテンツ。私は知らない"}, {"type": "subtitle", "time": 8493.07, "timestamp": "02:21:33", "text": "翻訳翻訳者は"}, {"type": "subtitle", "time": 8494.67, "timestamp": "02:21:34", "text": "正確な。"}, {"type": "subtitle", "time": 8498.91, "timestamp": "02:21:38", "text": "うん、いつか中国語を習うよ"}, {"type": "subtitle", "time": 8503.389, "timestamp": "02:21:43", "text": "そして、"}, {"type": "subtitle", "time": 8507.67, "timestamp": "02:21:47", "text": "適切にコミュニケーションをとる。でも、私も"}, {"type": "subtitle", "time": 8510.67, "timestamp": "02:21:50", "text": "名前は変更できません"}]
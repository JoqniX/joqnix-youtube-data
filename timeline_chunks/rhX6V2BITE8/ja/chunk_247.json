[{"type": "subtitle", "time": 14826.51, "timestamp": "04:07:06", "text": "迷彩服を着て中に入る"}, {"type": "subtitle", "time": 14833.59, "timestamp": "04:07:13", "text": "この鉄の流入。よし、行こう。何"}, {"type": "subtitle", "time": 14863.51, "timestamp": "04:07:43", "text": "エリア。あ、待って。私はいつか死ぬだろう"}, {"type": "subtitle", "time": 14866.15, "timestamp": "04:07:46", "text": "今この瞬間。何てことだ。待って。私はしません"}, {"type": "subtitle", "time": 14875.07, "timestamp": "04:07:55", "text": "癒す。どのように癒されますか？"}]
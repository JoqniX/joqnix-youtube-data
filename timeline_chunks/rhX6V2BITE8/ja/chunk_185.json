[{"type": "subtitle", "time": 11100.71, "timestamp": "03:05:00", "text": "こんな風に山を飛び越える。これは私の"}, {"type": "subtitle", "time": 11102.11, "timestamp": "03:05:02", "text": "夢見る"}, {"type": "subtitle", "time": 11106.07, "timestamp": "03:05:06", "text": "パルクール。ああ、なんてこった。 1つを想像してみてください"}, {"type": "subtitle", "time": 11108.79, "timestamp": "03:05:08", "text": "もし私がパルクールを習得したら、その日が来るんですよね？私"}, {"type": "subtitle", "time": 11112.75, "timestamp": "03:05:12", "text": "ぜひそうしたいです。すごくかっこいい。人々が"}, {"type": "subtitle", "time": 11116.03, "timestamp": "03:05:16", "text": "パルクールはまあまあ"}, {"type": "subtitle", "time": 11119.389, "timestamp": "03:05:19", "text": "良い。文字通りそれは"}, {"type": "subtitle", "time": 11126.23, "timestamp": "03:05:26", "text": "良い。彼を見て。彼はジャンプしている"}, {"type": "subtitle", "time": 11128.55, "timestamp": "03:05:28", "text": "山々。"}, {"type": "subtitle", "time": 11130.75, "timestamp": "03:05:30", "text": "待って、誰かが拍手したり、"}, {"type": "subtitle", "time": 11137.23, "timestamp": "03:05:37", "text": "[音楽]"}, {"type": "subtitle", "time": 11140.15, "timestamp": "03:05:40", "text": "いいえ。Dying Light の主な点は"}, {"type": "subtitle", "time": 11143.67, "timestamp": "03:05:43", "text": "このシリーズの特徴は、膨大なゲームメカニクスです。"}, {"type": "subtitle", "time": 11145.91, "timestamp": "03:05:45", "text": "公園での通話とか、そういうこと。それが"}, {"type": "subtitle", "time": 11147.55, "timestamp": "03:05:47", "text": "それは私の好みです"}]
[{"type": "subtitle", "time": 13320.83, "timestamp": "03:42:00", "text": "[音楽]"}, {"type": "subtitle", "time": 13323.99, "timestamp": "03:42:03", "text": "それ。これと関係がありますか？ありますか"}, {"type": "subtitle", "time": 13332.309, "timestamp": "03:42:12", "text": "は。ではなぜ開発者たちは"}, {"type": "subtitle", "time": 13335.95, "timestamp": "03:42:15", "text": "これを載せて登れるようにする"}, {"type": "subtitle", "time": 13339.63, "timestamp": "03:42:19", "text": "トップ？ただ旗を奪うためだけに。ああ、"}, {"type": "subtitle", "time": 13342.349, "timestamp": "03:42:22", "text": "神。"}, {"type": "subtitle", "time": 13344.11, "timestamp": "03:42:24", "text": "おお。"}, {"type": "subtitle", "time": 13346.83, "timestamp": "03:42:26", "text": "ニース。本当に"}, {"type": "subtitle", "time": 13349.75, "timestamp": "03:42:29", "text": "ニース。死ぬかと思ったけど、神に感謝"}, {"type": "subtitle", "time": 13374.349, "timestamp": "03:42:54", "text": "ポイント。それは私です"}, {"type": "subtitle", "time": 13376.269, "timestamp": "03:42:56", "text": "考える"}, {"type": "subtitle", "time": 13379.91, "timestamp": "03:42:59", "text": "ああ、それは上からのことだ。ああ、なんてことだ、私は"}]
[{"type": "subtitle", "time": 11881.83, "timestamp": "03:18:01", "text": "迷彩柄みたいですね。はい、"}, {"type": "subtitle", "time": 11884.389, "timestamp": "03:18:04", "text": "一瞬カモフラージュする。女王様、あなたは"}, {"type": "subtitle", "time": 11886.63, "timestamp": "03:18:06", "text": "彼を何とかしろ。聞いてくれ、私は対処しなければならない"}, {"type": "subtitle", "time": 11888.87, "timestamp": "03:18:08", "text": "一部の顧客。一度だけサインをください"}, {"type": "subtitle", "time": 11892.469, "timestamp": "03:18:12", "text": "あなたは車を手に入れました。ああ、神様。資金調達タワー"}, {"type": "subtitle", "time": 11906.19, "timestamp": "03:18:26", "text": "[音楽]"}, {"type": "subtitle", "time": 11909.15, "timestamp": "03:18:29", "text": "のために？これ、かっこいいですね。"}, {"type": "subtitle", "time": 11912.63, "timestamp": "03:18:32", "text": "これは戦利品を増やす方法のように思えます"}, {"type": "subtitle", "time": 11916.389, "timestamp": "03:18:36", "text": "あるいは、そんな感じ。それともそれは古い"}, {"type": "subtitle", "time": 11928.55, "timestamp": "03:18:48", "text": "私はこのようなものを見たことがないと思います"}, {"type": "subtitle", "time": 11930.51, "timestamp": "03:18:50", "text": "主なメカニズム"}, {"type": "subtitle", "time": 11933.269, "timestamp": "03:18:53", "text": "キャンペーン中のゲーム。メインゲームではありません。"}, {"type": "subtitle", "time": 11935.229, "timestamp": "03:18:55", "text": "わかった。キャンペーン。"}, {"type": "subtitle", "time": 11938.51, "timestamp": "03:18:58", "text": "キャンペーン。顕著"}]
[{"type": "subtitle", "time": 4021.95, "timestamp": "01:07:01", "text": "そして"}, {"type": "subtitle", "time": 4028.43, "timestamp": "01:07:08", "text": "たくさんの"}, {"type": "subtitle", "time": 4032.069, "timestamp": "01:07:12", "text": "YouTuberや人々、良い人、素敵な人"}, {"type": "subtitle", "time": 4033.83, "timestamp": "01:07:13", "text": "人々"}, {"type": "subtitle", "time": 4036.43, "timestamp": "01:07:16", "text": "[音楽]"}, {"type": "subtitle", "time": 4040.71, "timestamp": "01:07:20", "text": "えっと、そして私はそれらから"}, {"type": "subtitle", "time": 4044.19, "timestamp": "01:07:24", "text": "そこから来たたくさんの人に会って、"}, {"type": "subtitle", "time": 4046.23, "timestamp": "01:07:26", "text": "すべて。なぜ私は"}, {"type": "subtitle", "time": 4049.309, "timestamp": "01:07:29", "text": "外向的？一体どういうことだ？私は 私は"}, {"type": "subtitle", "time": 4052.63, "timestamp": "01:07:32", "text": "内向的な性格。なぜ？なぜ誰かが"}, {"type": "subtitle", "time": 4059.15, "timestamp": "01:07:39", "text": "しかし私にとって"}, {"type": "subtitle", "time": 4062.95, "timestamp": "01:07:42", "text": "今、私はこれらのつながりを気にしています"}, {"type": "subtitle", "time": 4067.63, "timestamp": "01:07:47", "text": "それらは私にとって大切なものです。だからできない"}, {"type": "subtitle", "time": 4070.43, "timestamp": "01:07:50", "text": "忘れずに"}, {"type": "subtitle", "time": 4072.71, "timestamp": "01:07:52", "text": "もの。あなたはいい人ですね。私は覚えています"}, {"type": "subtitle", "time": 4075.19, "timestamp": "01:07:55", "text": "今。いつでも私を手渡してください。右。私は"}, {"type": "subtitle", "time": 4077.87, "timestamp": "01:07:57", "text": "そこには。こんにちは。うん。"}, {"type": "subtitle", "time": 4079.71, "timestamp": "01:07:59", "text": "うん。私"}]
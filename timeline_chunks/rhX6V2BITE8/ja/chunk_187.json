[{"type": "subtitle", "time": 11220.83, "timestamp": "03:07:00", "text": "は"}, {"type": "subtitle", "time": 11224.07, "timestamp": "03:07:04", "text": "いや、実際に飛び上がろうと思ったんだ"}, {"type": "subtitle", "time": 11226.55, "timestamp": "03:07:06", "text": "あの岩のところまで戻ったけど、それは"}, {"type": "subtitle", "time": 11227.469, "timestamp": "03:07:07", "text": "間違っている"}, {"type": "subtitle", "time": 11229.63, "timestamp": "03:07:09", "text": "選択。"}, {"type": "subtitle", "time": 11237.83, "timestamp": "03:07:17", "text": "また。それはより自由な走りであり、そして"}, {"type": "subtitle", "time": 11246.389, "timestamp": "03:07:26", "text": "私は降りるべきではないと思う"}, {"type": "subtitle", "time": 11254.469, "timestamp": "03:07:34", "text": "方法。こうやって考えてみましょう。私は感じる"}, {"type": "subtitle", "time": 11265.71, "timestamp": "03:07:45", "text": "それ。ああ、例えば"}, {"type": "subtitle", "time": 11269.469, "timestamp": "03:07:49", "text": "うん。何？それも"}, {"type": "subtitle", "time": 11272.59, "timestamp": "03:07:52", "text": "私のサボポイントが減っていく。"}, {"type": "subtitle", "time": 11275.429, "timestamp": "03:07:55", "text": "いいえ。太陽の子らは"}, {"type": "subtitle", "time": 11278.309, "timestamp": "03:07:58", "text": "腕と他の意志を特定する"}, {"type": "subtitle", "time": 11279.83, "timestamp": "03:07:59", "text": "ジャムの人々はあなたに"}]
[{"type": "subtitle", "time": 20461.67, "timestamp": "05:41:01", "text": "ここ。彼はここにいなかったか？離れて。待って、私は"}, {"type": "subtitle", "time": 20463.51, "timestamp": "05:41:03", "text": "見失った。どこ？どこ？ああ、そうだった"}, {"type": "subtitle", "time": 20466.59, "timestamp": "05:41:06", "text": "正しくマークされていない。おお、ああ、"}, {"type": "subtitle", "time": 20469.75, "timestamp": "05:41:09", "text": "ダミー。彼はここまで来ていなかったと思う。"}, {"type": "subtitle", "time": 20472.628, "timestamp": "05:41:12", "text": "ああ、そこにいたんですね。そこにいたんですね。近日公開"}, {"type": "subtitle", "time": 20474.11, "timestamp": "05:41:14", "text": "のために"}, {"type": "subtitle", "time": 20477.23, "timestamp": "05:41:17", "text": "あなた。うん。こんにちは。"}, {"type": "subtitle", "time": 20480.39, "timestamp": "05:41:20", "text": "こんにちは。 3回。えっと、待って。救急キット。あなたには"}, {"type": "subtitle", "time": 20482.628, "timestamp": "05:41:22", "text": "それ。あなたが必要とされています。あなたが必要とされています。あなた"}, {"type": "subtitle", "time": 20486.15, "timestamp": "05:41:26", "text": "必要です。尋ねると、私はこれらだと言います"}, {"type": "subtitle", "time": 20487.83, "timestamp": "05:41:27", "text": "狙撃兵。"}, {"type": "subtitle", "time": 20489.91, "timestamp": "05:41:29", "text": "スナイパーがいるのは良いことではないでしょうか、それとも"}, {"type": "subtitle", "time": 20491.39, "timestamp": "05:41:31", "text": "私はしない"}, {"type": "subtitle", "time": 20495.43, "timestamp": "05:41:35", "text": "それ？実用的な狙撃銃。若菜。"}, {"type": "subtitle", "time": 20502.39, "timestamp": "05:41:42", "text": "うーん、わからない。待って。十分ありますか？"}, {"type": "subtitle", "time": 20508.99, "timestamp": "05:41:48", "text": "弾薬？ 153. ああ、だめだ。いいえ。行け。私はどこにいるの？"}, {"type": "subtitle", "time": 20511.948, "timestamp": "05:41:51", "text": "歩いている？どうすればいいですか どうすればいいですか"}]
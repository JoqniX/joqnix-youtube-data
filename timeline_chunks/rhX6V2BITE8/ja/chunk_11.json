[{"type": "subtitle", "time": 660.79, "timestamp": "00:11:00", "text": "自分でそれを証明するために、ですよね？特に"}, {"type": "subtitle", "time": 663.67, "timestamp": "00:11:03", "text": "ジョッカソンの配信。私は今、正しいと言った"}, {"type": "subtitle", "time": 668.31, "timestamp": "00:11:08", "text": "初日、3月20日"}, {"type": "subtitle", "time": 670.71, "timestamp": "00:11:10", "text": "12日か15日か15日頃か"}, {"type": "subtitle", "time": 673.59, "timestamp": "00:11:13", "text": "24時間かけてやります"}, {"type": "subtitle", "time": 675.75, "timestamp": "00:11:15", "text": "そして私はそれをしたが、私は"}, {"type": "subtitle", "time": 677.67, "timestamp": "00:11:17", "text": "私はWSを着るのが好きで罪を犯しました"}, {"type": "subtitle", "time": 680.31, "timestamp": "00:11:20", "text": "休息とかそういうのだから私の"}, {"type": "subtitle", "time": 683.11, "timestamp": "00:11:23", "text": "弱い体は実際に休息を取ることができ、"}, {"type": "subtitle", "time": 685.35, "timestamp": "00:11:25", "text": "エネルギー不足とかは感じないけど"}, {"type": "subtitle", "time": 687.829, "timestamp": "00:11:27", "text": "それでも私は3回やり遂げた"}, {"type": "subtitle", "time": 689.43, "timestamp": "00:11:29", "text": "3ヶ月連続で、これが"}, {"type": "subtitle", "time": 691.79, "timestamp": "00:11:31", "text": "最後の4ヶ月目は"}, {"type": "subtitle", "time": 696.069, "timestamp": "00:11:36", "text": "左。だから、嬉しいよ。私は幸せです。そして私は"}, {"type": "subtitle", "time": 698.91, "timestamp": "00:11:38", "text": "ここにいられることを光栄に思います"}, {"type": "subtitle", "time": 701.23, "timestamp": "00:11:41", "text": "に"}, {"type": "subtitle", "time": 703.19, "timestamp": "00:11:43", "text": "はい。"}, {"type": "subtitle", "time": 704.75, "timestamp": "00:11:44", "text": "[音楽]"}]
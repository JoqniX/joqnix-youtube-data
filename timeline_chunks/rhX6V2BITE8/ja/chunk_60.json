[{"type": "subtitle", "time": 3600.069, "timestamp": "01:00:00", "text": "えーと、私が一緒にいたのは誰だったかって"}, {"type": "subtitle", "time": 3602.39, "timestamp": "01:00:02", "text": "ホワイトリスト登録の手続きを手伝ってくれる"}, {"type": "subtitle", "time": 3606.23, "timestamp": "01:00:06", "text": "ビリービリーのオンボーディングのこと。それで、"}, {"type": "subtitle", "time": 3608.309, "timestamp": "01:00:08", "text": "えーと、でも私は作らなければならないと思う"}, {"type": "subtitle", "time": 3611.27, "timestamp": "01:00:11", "text": "中国語の適切なビデオまたは"}, {"type": "subtitle", "time": 3613.109, "timestamp": "01:00:13", "text": "字幕、"}, {"type": "subtitle", "time": 3615.67, "timestamp": "01:00:15", "text": "えーと、ビリー・ビリーの視聴者のために"}, {"type": "subtitle", "time": 3621.23, "timestamp": "01:00:21", "text": "それ。"}, {"type": "subtitle", "time": 3622.91, "timestamp": "01:00:22", "text": "えっと、"}, {"type": "subtitle", "time": 3626.549, "timestamp": "01:00:26", "text": "うん。それに、一番大切なのは"}, {"type": "subtitle", "time": 3630.03, "timestamp": "01:00:30", "text": "家族を逃している"}, {"type": "subtitle", "time": 3632.109, "timestamp": "01:00:32", "text": "時間。"}, {"type": "subtitle", "time": 3636.47, "timestamp": "01:00:36", "text": "ああ、日曜日にちょうど"}, {"type": "subtitle", "time": 3639.109, "timestamp": "01:00:39", "text": "私たちが日曜日か土曜日に"}, {"type": "subtitle", "time": 3642.87, "timestamp": "01:00:42", "text": "シーモアを騙したシーモアは、"}, {"type": "subtitle", "time": 3645.67, "timestamp": "01:00:45", "text": "そうだ、優先順位をつけなきゃいけないって言って"}, {"type": "subtitle", "time": 3648.39, "timestamp": "01:00:48", "text": "あなたの家族や愛する人たちと一緒に"}, {"type": "subtitle", "time": 3649.99, "timestamp": "01:00:49", "text": "あなたがこれらすべてをやっているにもかかわらず、私は"}, {"type": "subtitle", "time": 3653.63, "timestamp": "01:00:53", "text": "感謝はするけど、それでも家族との時間も大切"}, {"type": "subtitle", "time": 3656.789, "timestamp": "01:00:56", "text": "そうですね、1つにしようと思っています"}, {"type": "subtitle", "time": 3659.589, "timestamp": "01:00:59", "text": "父の狂った家への日帰り旅行と"}]
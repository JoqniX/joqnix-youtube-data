[{"type": "subtitle", "time": 11701.269, "timestamp": "03:15:01", "text": "ねえ、君はハラン出身だよね？きっと"}, {"type": "subtitle", "time": 11703.51, "timestamp": "03:15:03", "text": "視力に問題を抱えた友人にばったり会った。"}, {"type": "subtitle", "time": 11705.11, "timestamp": "03:15:05", "text": "片目がない男のことですか？"}, {"type": "subtitle", "time": 11709.67, "timestamp": "03:15:09", "text": "そう、それだ。私の息子、カート。わかった。"}, {"type": "subtitle", "time": 11714.71, "timestamp": "03:15:14", "text": "ああ、彼は、ええ、彼は成功しませんでした。"}, {"type": "subtitle", "time": 11718.63, "timestamp": "03:15:18", "text": "それは本当に残念だ。しかし、言えない"}, {"type": "subtitle", "time": 11721.269, "timestamp": "03:15:21", "text": "驚きました。ああ、あの人が"}, {"type": "subtitle", "time": 11723.51, "timestamp": "03:15:23", "text": "彼の名前は、ここの人々は"}, {"type": "subtitle", "time": 11725.67, "timestamp": "03:15:25", "text": "ウイルスに対する免疫があるんだよ。私は愛する"}, {"type": "subtitle", "time": 11728.63, "timestamp": "03:15:28", "text": "彼は彼女を手信号のように利用した"}, {"type": "subtitle", "time": 11731.469, "timestamp": "03:15:31", "text": "実際にジェスチャーをしながら"}, {"type": "subtitle", "time": 11734.309, "timestamp": "03:15:34", "text": "ある女性が率いるコートをひっくり返す"}, {"type": "subtitle", "time": 11736.63, "timestamp": "03:15:36", "text": "彼らは母親をかつてはただの"}, {"type": "subtitle", "time": 11738.95, "timestamp": "03:15:38", "text": "無害な地元の伝統だって知ってるでしょ"}, {"type": "subtitle", "time": 11741.99, "timestamp": "03:15:41", "text": "彼らは真剣に考えていなかったが、"}, {"type": "subtitle", "time": 11744.79, "timestamp": "03:15:44", "text": "最近は本当に深刻です"}, {"type": "subtitle", "time": 11746.63, "timestamp": "03:15:46", "text": "アウトブレイク"}, {"type": "subtitle", "time": 11749.67, "timestamp": "03:15:49", "text": "至る所にシンボルがある、こんなクソみたいな"}, {"type": "subtitle", "time": 11751.99, "timestamp": "03:15:51", "text": "儀式 彼らは、"}, {"type": "subtitle", "time": 11756.469, "timestamp": "03:15:56", "text": "彼女は太陽の女神です"}, {"type": "subtitle", "time": 11759.309, "timestamp": "03:15:59", "text": "中心か何か？"}]
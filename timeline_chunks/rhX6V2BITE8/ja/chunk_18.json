[{"type": "subtitle", "time": 1080.39, "timestamp": "00:18:00", "text": "それを開いて、何か本当のものを確認してください"}, {"type": "subtitle", "time": 1100.59, "timestamp": "00:18:20", "text": "うん、自分に言い聞かせなきゃいけないね。ジョック"}, {"type": "subtitle", "time": 1102.43, "timestamp": "00:18:22", "text": "騎手"}, {"type": "subtitle", "time": 1105.029, "timestamp": "00:18:25", "text": "ジョックナックス、やるべき仕事をやれ"}, {"type": "subtitle", "time": 1110.11, "timestamp": "00:18:30", "text": "やるべきこと。取得しないでください"}, {"type": "subtitle", "time": 1113.029, "timestamp": "00:18:33", "text": "話が逸れた。入手しないでください"}, {"type": "subtitle", "time": 1126.87, "timestamp": "00:18:46", "text": "私は脱線しなかった。はい。私"}, {"type": "subtitle", "time": 1128.47, "timestamp": "00:18:48", "text": "手に入れるべきではない 私はそうすべきではない"}]
[{"type": "subtitle", "time": 13807.51, "timestamp": "03:50:07", "text": "入り口？私は降りるべきですか？私"}, {"type": "subtitle", "time": 13810.03, "timestamp": "03:50:10", "text": "行くべきではないと思う"}, {"type": "subtitle", "time": 13812.87, "timestamp": "03:50:12", "text": "今。私は本当に大丈夫なの？"}, {"type": "subtitle", "time": 13825.57, "timestamp": "03:50:25", "text": "方法。"}, {"type": "subtitle", "time": 13827.07, "timestamp": "03:50:27", "text": "[音楽]"}, {"type": "subtitle", "time": 13829.71, "timestamp": "03:50:29", "text": "27. わかりました。これ"}, {"type": "subtitle", "time": 13832.11, "timestamp": "03:50:32", "text": "1つ。"}, {"type": "subtitle", "time": 13835.309, "timestamp": "03:50:35", "text": "E. ホールド"}, {"type": "subtitle", "time": 13838.99, "timestamp": "03:50:38", "text": "それ。わかった。わかった。私たちは"}, {"type": "subtitle", "time": 13841.95, "timestamp": "03:50:41", "text": "それ。"}]
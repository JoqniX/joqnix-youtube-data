[{"type": "subtitle", "time": 1806.19, "timestamp": "00:30:06", "text": "変更によって"}, {"type": "subtitle", "time": 1810.389, "timestamp": "00:30:10", "text": "レニー？待って、何が起こったの？私は何をしたのか"}, {"type": "subtitle", "time": 1819.149, "timestamp": "00:30:19", "text": "逃す？変更する"}, {"type": "subtitle", "time": 1831.63, "timestamp": "00:30:31", "text": "えっと、お釣り"}, {"type": "subtitle", "time": 1833.31, "timestamp": "00:30:33", "text": "の"}, {"type": "subtitle", "time": 1839.87, "timestamp": "00:30:39", "text": "変化。"}, {"type": "subtitle", "time": 1845.029, "timestamp": "00:30:45", "text": "おお。え、何？どうしたの？ああ、ヘリオン。"}, {"type": "subtitle", "time": 1848.51, "timestamp": "00:30:48", "text": "こんにちは。こんにちは。こんにちは。元気かい、"}, {"type": "subtitle", "time": 1857.669, "timestamp": "00:30:57", "text": "元気かい？あなたがそうであることを願っています。"}]
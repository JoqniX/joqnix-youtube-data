[{"type": "subtitle", "time": 1021.91, "timestamp": "00:17:01", "text": "えーと、まだプロダクションのバックエンドはできていないけど、"}, {"type": "subtitle", "time": 1025.59, "timestamp": "00:17:05", "text": "キックをする方法として計画します"}, {"type": "subtitle", "time": 1029.27, "timestamp": "00:17:09", "text": "繋がって、そこにいるために、私の"}, {"type": "subtitle", "time": 1032.63, "timestamp": "00:17:12", "text": "本番環境のバックエンド。それで、私は"}, {"type": "subtitle", "time": 1034.549, "timestamp": "00:17:14", "text": "ビリーのためにそれをする、そして私は"}, {"type": "subtitle", "time": 1037.75, "timestamp": "00:17:17", "text": "たとえ限定的であっても、本当に嬉しいです。"}, {"type": "subtitle", "time": 1039.75, "timestamp": "00:17:19", "text": "ビリーと私のためにそれができる"}, {"type": "subtitle", "time": 1042.63, "timestamp": "00:17:22", "text": "キックのためにもそうします。しないでください"}, {"type": "subtitle", "time": 1045.309, "timestamp": "00:17:25", "text": "心配しないで、キックのためにそうするつもり"}, {"type": "subtitle", "time": 1048.47, "timestamp": "00:17:28", "text": "良い。ええ、そういうことです。"}, {"type": "subtitle", "time": 1049.95, "timestamp": "00:17:29", "text": "そこには"}, {"type": "subtitle", "time": 1053.43, "timestamp": "00:17:33", "text": "それ。私は興奮しています。"}, {"type": "subtitle", "time": 1077.99, "timestamp": "00:17:57", "text": "えっと、Wサンダーはどこにあるんだっけ？私はしなければならない"}]
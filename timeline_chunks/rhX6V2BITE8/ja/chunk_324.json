[{"type": "subtitle", "time": 19447.83, "timestamp": "05:24:07", "text": "うんうん。あ、待って。間違ったスイッチを入れてしまった"}, {"type": "subtitle", "time": 19449.91, "timestamp": "05:24:09", "text": "シーン。 H、ごめんなさい。ああ、それは"}, {"type": "subtitle", "time": 19453.07, "timestamp": "05:24:13", "text": "垂直に流れるはずの流れ。"}, {"type": "subtitle", "time": 19455.52, "timestamp": "05:24:15", "text": "えっと、待って。どこにある"}, {"type": "subtitle", "time": 19458.27, "timestamp": "05:24:18", "text": "[音楽]"}, {"type": "subtitle", "time": 19460.35, "timestamp": "05:24:20", "text": "あれ？ああ、それは"}, {"type": "subtitle", "time": 19463.31, "timestamp": "05:24:23", "text": "わかった。後で考えます。"}, {"type": "subtitle", "time": 19466.15, "timestamp": "05:24:26", "text": "待って、プレイヤー数が表示されていない。"}, {"type": "subtitle", "time": 19467.628, "timestamp": "05:24:27", "text": "私がそれをやったのか？"}, {"type": "subtitle", "time": 19471.708, "timestamp": "05:24:31", "text": "昨日？そうだったよね？しかし、"}, {"type": "subtitle", "time": 19475.35, "timestamp": "05:24:35", "text": "それ？私はやっていません。待って、私に"}, {"type": "subtitle", "time": 19477.67, "timestamp": "05:24:37", "text": "縦方向のストリーム用にトリミングしてください。 1つ"}, {"type": "subtitle", "time": 19483.59, "timestamp": "05:24:43", "text": "ええと、見ている人たちのために"}, {"type": "subtitle", "time": 19485.03, "timestamp": "05:24:45", "text": "垂直ストリーム、申し訳ありませんが"}, {"type": "subtitle", "time": 19495.19, "timestamp": "05:24:55", "text": "わかった。わかった。これで、"}, {"type": "subtitle", "time": 19497.11, "timestamp": "05:24:57", "text": "人々は生きている。えっと、私たちはどこへ行くんですか？"}, {"type": "subtitle", "time": 19499.59, "timestamp": "05:24:59", "text": "あの納屋に行きましょう。調子はどうですか？"}]
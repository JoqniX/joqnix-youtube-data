[{"type": "subtitle", "time": 12960.469, "timestamp": "03:36:00", "text": "鎧。わかった。"}, {"type": "subtitle", "time": 12964.67, "timestamp": "03:36:04", "text": "私はライフルアーマーを選びます。軍隊"}, {"type": "subtitle", "time": 12967.429, "timestamp": "03:36:07", "text": "ライフル。ああ、私がこれらを殺せば殺すほど"}, {"type": "subtitle", "time": 12974.95, "timestamp": "03:36:14", "text": "弾薬。もしかしたら、私はそれを探しているのかもしれない。どこ"}, {"type": "subtitle", "time": 12977.87, "timestamp": "03:36:17", "text": "ここからあの二人を殺して、"}, {"type": "subtitle", "time": 12980.55, "timestamp": "03:36:20", "text": "右？見つかりません。私はどこにいた"}, {"type": "subtitle", "time": 12982.429, "timestamp": "03:36:22", "text": "あの二人を殺せ"}, {"type": "subtitle", "time": 12986.469, "timestamp": "03:36:26", "text": "人々？これです。いいえ。"}, {"type": "subtitle", "time": 12988.389, "timestamp": "03:36:28", "text": "いいえ、ここにはありません。"}, {"type": "subtitle", "time": 12995.229, "timestamp": "03:36:35", "text": "これは違います。"}, {"type": "subtitle", "time": 12998.67, "timestamp": "03:36:38", "text": "えっと、どうやって？"}, {"type": "subtitle", "time": 13005.349, "timestamp": "03:36:45", "text": "いいえ、私は切り替えようとしていました"}, {"type": "subtitle", "time": 13008.15, "timestamp": "03:36:48", "text": "グラップリングフックでそれを掴む"}, {"type": "subtitle", "time": 13010.87, "timestamp": "03:36:50", "text": "素晴らしい光か何か。つまり、でも"}, {"type": "subtitle", "time": 13013.349, "timestamp": "03:36:53", "text": "大丈夫です。それはそうだったと思う"}, {"type": "subtitle", "time": 13015.51, "timestamp": "03:36:55", "text": "保存しました。"}, {"type": "subtitle", "time": 13018.67, "timestamp": "03:36:58", "text": "そう思うよ。なんてこった。そうだ、それだ"}]
[{"type": "subtitle", "time": 62.549, "timestamp": "00:01:02", "text": "キャスト。知っている。キャンセルしましたか"}, {"type": "subtitle", "time": 64.27, "timestamp": "00:01:04", "text": "Castleの購読"}, {"type": "subtitle", "time": 74.63, "timestamp": "00:01:14", "text": "もちろん。しばらく使っていたのですが、"}, {"type": "subtitle", "time": 77.83, "timestamp": "00:01:17", "text": "いいえ、そうです。ああ、私は完全に"}, {"type": "subtitle", "time": 81.35, "timestamp": "00:01:21", "text": "その存在を忘れていた。"}, {"type": "subtitle", "time": 88.19, "timestamp": "00:01:28", "text": "[音楽]"}, {"type": "subtitle", "time": 104.03, "timestamp": "00:01:44", "text": "えーと、ストリーミングできたらいいのに"}, {"type": "subtitle", "time": 108.789, "timestamp": "00:01:48", "text": "信じる。あの場所が本当に恋しい。"}, {"type": "subtitle", "time": 111.429, "timestamp": "00:01:51", "text": "中国のユーチューバーがいるにもかかわらず"}]
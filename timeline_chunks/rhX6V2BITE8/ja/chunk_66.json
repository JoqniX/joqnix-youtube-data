[{"type": "subtitle", "time": 3963.069, "timestamp": "01:06:03", "text": "ガスの。えっと、そして私は"}, {"type": "subtitle", "time": 3973.43, "timestamp": "01:06:13", "text": "私たちがちゃんと話をしたのは覚えているだろうか、"}, {"type": "subtitle", "time": 3975.75, "timestamp": "01:06:15", "text": "右？うん。うん。うん。うん。ええ、そうですね。"}, {"type": "subtitle", "time": 3978.67, "timestamp": "01:06:18", "text": "アリウは"}, {"type": "subtitle", "time": 3981.99, "timestamp": "01:06:21", "text": "忙しかったが、彼は私が"}, {"type": "subtitle", "time": 3984.27, "timestamp": "01:06:24", "text": "最初に連絡を取る"}, {"type": "subtitle", "time": 3987.829, "timestamp": "01:06:27", "text": "始まり。ああ、もし彼がこれで終わりなら。"}, {"type": "subtitle", "time": 3989.23, "timestamp": "01:06:29", "text": "入手できませんでした"}, {"type": "subtitle", "time": 3992.309, "timestamp": "01:06:32", "text": "彼。私はたくさんの良い人に会った"}, {"type": "subtitle", "time": 3999.39, "timestamp": "01:06:39", "text": "クザン。ええ、昔は"}, {"type": "subtitle", "time": 4002.51, "timestamp": "01:06:42", "text": "2019年の日。いいえ、"}, {"type": "subtitle", "time": 4006.51, "timestamp": "01:06:46", "text": "2020年、2021年以降。"}, {"type": "subtitle", "time": 4010.39, "timestamp": "01:06:50", "text": "ええ、私はその輪の中にいました"}, {"type": "subtitle", "time": 4013.43, "timestamp": "01:06:53", "text": "サク仮想桜サークルOGV"}, {"type": "subtitle", "time": 4016.08, "timestamp": "01:06:56", "text": "侵入する"}, {"type": "subtitle", "time": 4017.789, "timestamp": "01:06:57", "text": "[音楽]"}, {"type": "subtitle", "time": 4019.309, "timestamp": "01:06:59", "text": "えっと"}]
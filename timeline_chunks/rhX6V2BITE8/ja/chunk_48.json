[{"type": "subtitle", "time": 2880.589, "timestamp": "00:48:00", "text": "[音楽]"}, {"type": "subtitle", "time": 2882.75, "timestamp": "00:48:02", "text": "えっと、私は"}, {"type": "subtitle", "time": 2888.589, "timestamp": "00:48:08", "text": "GMTプラス4、週末"}, {"type": "subtitle", "time": 2891.99, "timestamp": "00:48:11", "text": "週末。ここに「uh」を入れるにはどうすればいいですか？つまり、"}, {"type": "subtitle", "time": 2893.75, "timestamp": "00:48:13", "text": "ええ、日本語を勉強しないといけないんです"}, {"type": "subtitle", "time": 2895.23, "timestamp": "00:48:15", "text": "教師。"}, {"type": "subtitle", "time": 2898.55, "timestamp": "00:48:18", "text": "ええと、BBCの記事を書いたジャーナリスト"}, {"type": "subtitle", "time": 2901.349, "timestamp": "00:48:21", "text": "Dian Vtubersと私についての記事"}, {"type": "subtitle", "time": 2903.71, "timestamp": "00:48:23", "text": "などなど。彼女に連絡を取らなければならない"}, {"type": "subtitle", "time": 2906.43, "timestamp": "00:48:26", "text": "今日。彼女に時間を与えてあげて"}, {"type": "subtitle", "time": 2909.75, "timestamp": "00:48:29", "text": "彼女はとても忙しいので、スロットマシンは使えません。作れない"}, {"type": "subtitle", "time": 2912.79, "timestamp": "00:48:32", "text": "それ。そして私はこの二人に連絡を取る必要がある"}, {"type": "subtitle", "time": 2915.19, "timestamp": "00:48:35", "text": "知らせてくれると言っていた人たち"}, {"type": "subtitle", "time": 2918.47, "timestamp": "00:48:38", "text": "そして返信はなかった。連絡を取り直す必要がある"}, {"type": "subtitle", "time": 2921.109, "timestamp": "00:48:41", "text": "また出て行った。"}, {"type": "subtitle", "time": 2923.39, "timestamp": "00:48:43", "text": "ジャルピーとゴースト"}, {"type": "subtitle", "time": 2928.109, "timestamp": "00:48:48", "text": "クイーン・マスコンは、マスコンは"}, {"type": "subtitle", "time": 2931.71, "timestamp": "00:48:51", "text": "金曜日。アンジソンは日曜日に3位"}, {"type": "subtitle", "time": 2935.51, "timestamp": "00:48:55", "text": "週。ニクシーは柔軟性があるので、"}, {"type": "subtitle", "time": 2939.829, "timestamp": "00:48:59", "text": "彼女ならいつでも。ニコサンを手に入れなければならない"}]
[{"type": "subtitle", "time": 11058.87, "timestamp": "03:04:18", "text": "申し訳ありません。ミュートにする必要があるのは"}, {"type": "subtitle", "time": 11061.67, "timestamp": "03:04:21", "text": "咳。コマ。私はまだ回復していません"}, {"type": "subtitle", "time": 11065.389, "timestamp": "03:04:25", "text": "私の震えから。"}, {"type": "subtitle", "time": 11069.03, "timestamp": "03:04:29", "text": "ああ、なんてことだ、世界はなんて広いんだ。"}, {"type": "subtitle", "time": 11072.55, "timestamp": "03:04:32", "text": "レナ、聞こえる？とても美しい"}, {"type": "subtitle", "time": 11075.269, "timestamp": "03:04:35", "text": "ダイヤルアップしています。"}, {"type": "subtitle", "time": 11076.87, "timestamp": "03:04:36", "text": "うん、聞いて。片目の錯乱した"}, {"type": "subtitle", "time": 11078.389, "timestamp": "03:04:38", "text": "忍耐強い。彼は本当のことを言っていた。そこには"}, {"type": "subtitle", "time": 11080.15, "timestamp": "03:04:40", "text": "脱出方法がある。彼が言ったことは"}, {"type": "subtitle", "time": 11082.79, "timestamp": "03:04:42", "text": "方向転換しない人がいるというのは事実だ。彼は亡くなった"}, {"type": "subtitle", "time": 11085.83, "timestamp": "03:04:45", "text": "今朝、カイル。彼は熱にやられてしまった。"}, {"type": "subtitle", "time": 11088.87, "timestamp": "03:04:48", "text": "あなた自身の熱が彼を襲ったのです。いいえ。"}, {"type": "subtitle", "time": 11091.19, "timestamp": "03:04:51", "text": "どこかで。その噂について知っている人はいますか？"}, {"type": "subtitle", "time": 11096.15, "timestamp": "03:04:56", "text": "わかったよ、レナ。とても気持ちいい。クソッ"}, {"type": "subtitle", "time": 11098.23, "timestamp": "03:04:58", "text": "山だよ、わかるだろ？もしあなたが"}]
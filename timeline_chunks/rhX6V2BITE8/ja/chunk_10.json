[{"type": "subtitle", "time": 602.47, "timestamp": "00:10:02", "text": "彼らとコラボレーションすることさえも"}, {"type": "subtitle", "time": 604.71, "timestamp": "00:10:04", "text": "そういうことがあったら、「うん、できるよ」って思うんだ"}, {"type": "subtitle", "time": 607.11, "timestamp": "00:10:07", "text": "日本に落ち着いた後、日本滞在中に"}, {"type": "subtitle", "time": 609.99, "timestamp": "00:10:09", "text": "そして私は、私は持っている、私は持っている"}, {"type": "subtitle", "time": 612.23, "timestamp": "00:10:12", "text": "ストリーミングやプレイに適した環境"}, {"type": "subtitle", "time": 614.55, "timestamp": "00:10:14", "text": "ゲームをしたり、平和的に話したり、その他いろいろ"}, {"type": "subtitle", "time": 616.87, "timestamp": "00:10:16", "text": "そうすれば、私にもできます。私はいつでも時間を作ることができます"}, {"type": "subtitle", "time": 619.269, "timestamp": "00:10:19", "text": "彼らのために。」いいえ。だから、大丈夫です。私は"}, {"type": "subtitle", "time": 621.389, "timestamp": "00:10:21", "text": "次のように考えています"}, {"type": "subtitle", "time": 623.71, "timestamp": "00:10:23", "text": "それ。それで、"}, {"type": "subtitle", "time": 627.269, "timestamp": "00:10:27", "text": "なぜなら、私は本当のことを理解しているから"}, {"type": "subtitle", "time": 631.15, "timestamp": "00:10:31", "text": "現実として、私はすべての人を満足させることはできない。"}, {"type": "subtitle", "time": 634.63, "timestamp": "00:10:34", "text": "みんなを巻き込んで、いろいろとやるんだけど、"}, {"type": "subtitle", "time": 638.19, "timestamp": "00:10:38", "text": "それでも私はそれをしたい、私はそれを壊したい"}, {"type": "subtitle", "time": 641.59, "timestamp": "00:10:41", "text": "その誤解または誤った概念"}, {"type": "subtitle", "time": 645.269, "timestamp": "00:10:45", "text": "ああ、それは難しいだろう。やめておけ。やめておけ。"}, {"type": "subtitle", "time": 647.509, "timestamp": "00:10:47", "text": "境界線だが、それを示して証明したい"}, {"type": "subtitle", "time": 651.11, "timestamp": "00:10:51", "text": "それを自分自身に証明するために、そして私が"}, {"type": "subtitle", "time": 653.19, "timestamp": "00:10:53", "text": "私はそれを自分自身で証明してみせると言った。"}, {"type": "subtitle", "time": 656.069, "timestamp": "00:10:56", "text": "あなたは私がどれだけ持っているか見てきました。"}, {"type": "subtitle", "time": 658.31, "timestamp": "00:10:58", "text": "どれだけ一生懸命努力すればいいのだろうか"}]
[{"type": "subtitle", "time": 6613.83, "timestamp": "01:50:13", "text": "滞在する。うん。ああ、神様、私は"}, {"type": "subtitle", "time": 6642.79, "timestamp": "01:50:42", "text": "人々。少し昼寝をしてから行きます。"}, {"type": "subtitle", "time": 6644.75, "timestamp": "01:50:44", "text": "私は言ったことを知っています"}, {"type": "subtitle", "time": 6649.07, "timestamp": "01:50:49", "text": "午後2時までには戻ってきます。"}, {"type": "subtitle", "time": 6652.39, "timestamp": "01:50:52", "text": "わかった。ちょっと昼寝が必要だと思う"}, {"type": "subtitle", "time": 6654.91, "timestamp": "01:50:54", "text": "コラボが3つあるから"}]
[{"type": "subtitle", "time": 2220.15, "timestamp": "00:37:00", "text": "そこで、あるいはいつでもこの辺りでやることができます"}, {"type": "subtitle", "time": 2224.15, "timestamp": "00:37:04", "text": "今週も同様です。ええと、今週末も"}, {"type": "subtitle", "time": 2228.47, "timestamp": "00:37:08", "text": "あなたをいくつかの間に挟むことができます"}, {"type": "subtitle", "time": 2232.109, "timestamp": "00:37:12", "text": "私たちがそれを実行している日には、"}, {"type": "subtitle", "time": 2235.27, "timestamp": "00:37:15", "text": "えっと、最大2時間か1時間までならできます"}, {"type": "subtitle", "time": 2239.19, "timestamp": "00:37:19", "text": "よろしければ、最低1時間から承ります。えっと"}, {"type": "subtitle", "time": 2242.39, "timestamp": "00:37:22", "text": "もしよろしければ。えーと、金曜日は"}, {"type": "subtitle", "time": 2244.31, "timestamp": "00:37:24", "text": "一つはマスクを着けた状態で確認する必要がある。"}, {"type": "subtitle", "time": 2247.27, "timestamp": "00:37:27", "text": "今すぐやります。えっと、これは"}, {"type": "subtitle", "time": 2251.47, "timestamp": "00:37:31", "text": "確認済み。もうどうでもいい。レイヴンの息子とダッシュ。"}, {"type": "subtitle", "time": 2254.47, "timestamp": "00:37:34", "text": "あ、待って、ここに誰か追加するのを忘れてた。えっと"}, {"type": "subtitle", "time": 2256.03, "timestamp": "00:37:36", "text": "それは"}, {"type": "subtitle", "time": 2259.27, "timestamp": "00:37:39", "text": "えっと、あれって太陽？ああ、そうだよ"}, {"type": "subtitle", "time": 2262.31, "timestamp": "00:37:42", "text": "日曜日。ああ、これは誰だったっけ？"}, {"type": "subtitle", "time": 2266.19, "timestamp": "00:37:46", "text": "土曜日に開催します"}, {"type": "subtitle", "time": 2269.03, "timestamp": "00:37:49", "text": "また。しまった。えっと、私のDを見せています。"}, {"type": "subtitle", "time": 2271.75, "timestamp": "00:37:51", "text": "ごめん。えっと、誰を出演させるんだっけ？"}, {"type": "subtitle", "time": 2275.91, "timestamp": "00:37:55", "text": "また土曜日？えっと、ちょっと待ってください、確認させてください。"}, {"type": "subtitle", "time": 2279.99, "timestamp": "00:37:59", "text": "H、恋人。恋人。ラバーボーイソング"}]
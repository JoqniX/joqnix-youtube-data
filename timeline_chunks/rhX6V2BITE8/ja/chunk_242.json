[{"type": "subtitle", "time": 14539.469, "timestamp": "04:02:19", "text": "あなたはできないでしょう"}, {"type": "subtitle", "time": 14542.95, "timestamp": "04:02:22", "text": "えっと、待って、ニトロがあるんだけど、えっと、何？"}, {"type": "subtitle", "time": 14545.389, "timestamp": "04:02:25", "text": "待って、モッド"}, {"type": "subtitle", "time": 14548.229, "timestamp": "04:02:28", "text": "デスクドライバー。おお、新しいものがある"}, {"type": "subtitle", "time": 14550.75, "timestamp": "04:02:30", "text": "運転手に電話した。"}, {"type": "subtitle", "time": 14554.15, "timestamp": "04:02:34", "text": "わかった。よし、生存と"}, {"type": "subtitle", "time": 14558.91, "timestamp": "04:02:38", "text": "敏捷性とパワー。だから、それはカウントされる。わかった。"}, {"type": "subtitle", "time": 14561.229, "timestamp": "04:02:41", "text": "面白い。新しいもの"}, {"type": "subtitle", "time": 14563.389, "timestamp": "04:02:43", "text": "ライバル級の地位。"}, {"type": "subtitle", "time": 14566.87, "timestamp": "04:02:46", "text": "わかった。レベル1のバギーを乗ることができます"}, {"type": "subtitle", "time": 14569.95, "timestamp": "04:02:49", "text": "部品。それが私が一番望んでいることです。私"}, {"type": "subtitle", "time": 14572.429, "timestamp": "04:02:52", "text": "リモコンを入手"}]
[{"type": "subtitle", "time": 3721.71, "timestamp": "01:02:01", "text": "非常に適切"}, {"type": "subtitle", "time": 3726.109, "timestamp": "01:02:06", "text": "健康は多くの"}, {"type": "subtitle", "time": 3729.71, "timestamp": "01:02:09", "text": "もの。でも、確かに混雑していますね。しかしそれは"}, {"type": "subtitle", "time": 3737.109, "timestamp": "01:02:17", "text": "管理。なぜ私は"}, {"type": "subtitle", "time": 3739.71, "timestamp": "01:02:19", "text": "これらすべてが最終的に"}, {"type": "subtitle", "time": 3742.549, "timestamp": "01:02:22", "text": "さようなら？誰か感じた人はいますか？"}, {"type": "subtitle", "time": 3745.91, "timestamp": "01:02:25", "text": "ところで、そういう感じ？誰か感じた人は"}, {"type": "subtitle", "time": 3753.71, "timestamp": "01:02:33", "text": "ジョック、これは"}, {"type": "subtitle", "time": 3767.95, "timestamp": "01:02:47", "text": "[音楽]"}, {"type": "subtitle", "time": 3770.789, "timestamp": "01:02:50", "text": "何か？いや、そうじゃないよ。しないで"}]
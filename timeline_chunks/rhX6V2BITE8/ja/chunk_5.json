[{"type": "subtitle", "time": 300.07, "timestamp": "00:05:00", "text": "ええと、拒否権モデルみたいなものや"}, {"type": "subtitle", "time": 301.99, "timestamp": "00:05:01", "text": "バックアップしなければならない重要なファイルや物"}, {"type": "subtitle", "time": 305.749, "timestamp": "00:05:05", "text": "遅かれ早かれ、それはクラウドに移行するだろう。さらに、"}, {"type": "subtitle", "time": 309.43, "timestamp": "00:05:09", "text": "キノコの塊を全部手に入れなきゃ"}, {"type": "subtitle", "time": 313.35, "timestamp": "00:05:13", "text": "ビリー・ビリーの最新情報。"}, {"type": "subtitle", "time": 315.35, "timestamp": "00:05:15", "text": "それらの問題をより早く解決するにはどうすればいいか"}, {"type": "subtitle", "time": 319.27, "timestamp": "00:05:19", "text": "またはそれ以降。ということで、近いうちに解決します。"}, {"type": "subtitle", "time": 322.87, "timestamp": "00:05:22", "text": "どうすればいいのか。はい、はい。もちろん。そして私は"}, {"type": "subtitle", "time": 324.87, "timestamp": "00:05:24", "text": "たくさんのことを見逃していたことに気づいた"}, {"type": "subtitle", "time": 329.31, "timestamp": "00:05:29", "text": "ここ。申し訳ありませんが、"}, {"type": "subtitle", "time": 333.83, "timestamp": "00:05:33", "text": "えーと、好きな人たちには本当に申し訳ないです"}, {"type": "subtitle", "time": 335.67, "timestamp": "00:05:35", "text": "待って、今日誰かが私の家に侵入した。ああ、"}, {"type": "subtitle", "time": 336.909, "timestamp": "00:05:36", "text": "神。"}, {"type": "subtitle", "time": 356.469, "timestamp": "00:05:56", "text": "あなた。何てことだ。ありがとう。何てことだ。"}, {"type": "subtitle", "time": 358.99, "timestamp": "00:05:58", "text": "襲撃を受けた。いつ"}]
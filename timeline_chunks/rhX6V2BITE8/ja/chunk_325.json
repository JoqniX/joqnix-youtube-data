[{"type": "subtitle", "time": 19504.15, "timestamp": "05:25:04", "text": "またそこか？滑空する。ああ、わかりました。私は私は"}, {"type": "subtitle", "time": 19522.708, "timestamp": "05:25:22", "text": "あなた。はい、戻ってきました。なぜ私は歩いているのか"}, {"type": "subtitle", "time": 19546.67, "timestamp": "05:25:46", "text": "もの？いいえ、何も。"}, {"type": "subtitle", "time": 19549.39, "timestamp": "05:25:49", "text": "わかった。あらら。 A"}, {"type": "subtitle", "time": 19551.47, "timestamp": "05:25:51", "text": "バール。"}, {"type": "subtitle", "time": 19555.19, "timestamp": "05:25:55", "text": "叔父は待つべきだ。グリップしやすい角度。何"}, {"type": "subtitle", "time": 19557.788, "timestamp": "05:25:57", "text": "それで本当に効果があるのか​​？私はそうは思わない"}]
[{"type": "subtitle", "time": 12122.97, "timestamp": "03:22:02", "text": "ない？彼は派手さを持っている。"}, {"type": "subtitle", "time": 12124.87, "timestamp": "03:22:04", "text": "[音楽]"}, {"type": "subtitle", "time": 12126.17, "timestamp": "03:22:06", "text": "刃。私は"}, {"type": "subtitle", "time": 12131.55, "timestamp": "03:22:11", "text": "[音楽]"}, {"type": "subtitle", "time": 12134.99, "timestamp": "03:22:14", "text": "いいね。何もない。いいえ"}, {"type": "subtitle", "time": 12137.91, "timestamp": "03:22:17", "text": "武器庫。たくさん見せましょう。ああ、メタル"}, {"type": "subtitle", "time": 12151.59, "timestamp": "03:22:31", "text": "あなた。はい、そうです。私はそのおやつは食べません。"}, {"type": "subtitle", "time": 12154.95, "timestamp": "03:22:34", "text": "他のものを持って行きます。"}, {"type": "subtitle", "time": 12158.95, "timestamp": "03:22:38", "text": "彼らは私に男性たちをくれましたが、何もありませんでした。"}, {"type": "subtitle", "time": 12162.11, "timestamp": "03:22:42", "text": "他に何も私に2つ戻るように言ったものはなかった"}, {"type": "subtitle", "time": 12165.269, "timestamp": "03:22:45", "text": "数ヶ月。ああ、2分後にまた彼らを訪ねてください"}, {"type": "subtitle", "time": 12167.229, "timestamp": "03:22:47", "text": "数ヶ月。おお"}, {"type": "subtitle", "time": 12170.07, "timestamp": "03:22:50", "text": "神。それは良い。ありがたいことにそうではない"}, {"type": "subtitle", "time": 12172.71, "timestamp": "03:22:52", "text": "何か深刻なことでもあるの？世話をするために"}, {"type": "subtitle", "time": 12174.75, "timestamp": "03:22:54", "text": "の"}]
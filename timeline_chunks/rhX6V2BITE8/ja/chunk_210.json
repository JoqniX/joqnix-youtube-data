[{"type": "subtitle", "time": 12600.229, "timestamp": "03:30:00", "text": "任務は一つだけですよね？そうすれば"}, {"type": "subtitle", "time": 12606.349, "timestamp": "03:30:06", "text": "電源を入れる"}, {"type": "subtitle", "time": 12609.269, "timestamp": "03:30:09", "text": "電気の汚いパイプを通り過ぎる"}, {"type": "subtitle", "time": 12611.469, "timestamp": "03:30:11", "text": "フィールドまたは"}, {"type": "subtitle", "time": 12613.229, "timestamp": "03:30:13", "text": "何か。"}, {"type": "subtitle", "time": 12617.15, "timestamp": "03:30:17", "text": "うん。ポンプ場まで車で行く。"}, {"type": "subtitle", "time": 12619.469, "timestamp": "03:30:19", "text": "わかった。うん。これは誰ですか"}, {"type": "subtitle", "time": 12622.67, "timestamp": "03:30:22", "text": "男？彼は我々のアップグレード版なのか？"}, {"type": "subtitle", "time": 12631.309, "timestamp": "03:30:31", "text": "ああ、あなたのバギーは"}, {"type": "subtitle", "time": 12633.83, "timestamp": "03:30:33", "text": "呼び戻された。ああ、まるであなたが自分の"}, {"type": "subtitle", "time": 12637.19, "timestamp": "03:30:37", "text": "バギーは好きな場所にどこでも行けて、"}, {"type": "subtitle", "time": 12642.429, "timestamp": "03:30:42", "text": "文字通り、私が始めれば運転できます"}, {"type": "subtitle", "time": 12646.11, "timestamp": "03:30:46", "text": "運転。ああ、それは実際"}, {"type": "subtitle", "time": 12650.15, "timestamp": "03:30:50", "text": "いいね。またタイヤをパンクさせてしまったのか？"}, {"type": "subtitle", "time": 12656.07, "timestamp": "03:30:56", "text": "知ってるでしょ、使わない方がずっといいよ"}, {"type": "subtitle", "time": 12659.19, "timestamp": "03:30:59", "text": "体、だってあなたは続けなければならないから"}]
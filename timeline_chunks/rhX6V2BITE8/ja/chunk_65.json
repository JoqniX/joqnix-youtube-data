[{"type": "subtitle", "time": 3900.829, "timestamp": "01:05:00", "text": "[音楽]"}, {"type": "subtitle", "time": 3913.27, "timestamp": "01:05:13", "text": "15日。うん、3週目も君を雇い続けられるよ"}, {"type": "subtitle", "time": 3914.95, "timestamp": "01:05:14", "text": "おそらく。うん。先週は3位だった。うん。"}, {"type": "subtitle", "time": 3923.95, "timestamp": "01:05:23", "text": "仕事。息子のロクを手に入れなければならない"}, {"type": "subtitle", "time": 3927.43, "timestamp": "01:05:27", "text": "忘れてはいけない。Rokuもだ。"}, {"type": "subtitle", "time": 3939.43, "timestamp": "01:05:39", "text": "ロ。うん。最初は皆さんもご存知の通り、"}, {"type": "subtitle", "time": 3943.27, "timestamp": "01:05:43", "text": "グループコラボをやりたかったけど"}, {"type": "subtitle", "time": 3945.67, "timestamp": "01:05:45", "text": "うん、今は1対1を優先しているんだ"}, {"type": "subtitle", "time": 3948.21, "timestamp": "01:05:48", "text": "わかった。"}, {"type": "subtitle", "time": 3955.63, "timestamp": "01:05:55", "text": "えっと、たくさんあるので"}]
[{"type": "subtitle", "time": 540.389, "timestamp": "00:09:00", "text": "本当に本当に本当に好きになりたい"}, {"type": "subtitle", "time": 542.55, "timestamp": "00:09:02", "text": "私が本当に"}, {"type": "subtitle", "time": 545.75, "timestamp": "00:09:05", "text": "再会して話をしたかったし、"}, {"type": "subtitle", "time": 547.55, "timestamp": "00:09:07", "text": "一緒に過ごす"}, {"type": "subtitle", "time": 550.79, "timestamp": "00:09:10", "text": "実は。ええ、そうですね。ああ、本当にそうだったらいいのに"}, {"type": "subtitle", "time": 553.43, "timestamp": "00:09:13", "text": "私はこれらのトークマラソンを始めた"}, {"type": "subtitle", "time": 556.949, "timestamp": "00:09:16", "text": "4月以降のコラボ企画ですが、"}, {"type": "subtitle", "time": 559.829, "timestamp": "00:09:19", "text": "バカだった。自分がこうなるとは思っていなかった"}, {"type": "subtitle", "time": 561.87, "timestamp": "00:09:21", "text": "頑固に手を差し伸べない"}, {"type": "subtitle", "time": 565.71, "timestamp": "00:09:25", "text": "210まで"}, {"type": "subtitle", "time": 569.03, "timestamp": "00:09:29", "text": "私が持っている500人のうち"}, {"type": "subtitle", "time": 571.87, "timestamp": "00:09:31", "text": "Discordの友達やその他の"}, {"type": "subtitle", "time": 576.91, "timestamp": "00:09:36", "text": "場所。合計で210人です。"}, {"type": "subtitle", "time": 581.19, "timestamp": "00:09:41", "text": "はい。そこから抜け出した。多くの人が"}, {"type": "subtitle", "time": 585.11, "timestamp": "00:09:45", "text": "まだ返信もしていないし、いろいろある。ほとんどの人は"}, {"type": "subtitle", "time": 587.71, "timestamp": "00:09:47", "text": "忙しい。えっと、考えてるんだけど"}, {"type": "subtitle", "time": 591.67, "timestamp": "00:09:51", "text": "メッセージを見る人がいるなら、"}, {"type": "subtitle", "time": 594.31, "timestamp": "00:09:54", "text": "私のメッセージ、すごく遅くなっちゃったよね？私が"}, {"type": "subtitle", "time": 596.949, "timestamp": "00:09:56", "text": "時間切れになり、"}, {"type": "subtitle", "time": 599.91, "timestamp": "00:09:59", "text": "6月の第3週目、もう時間がない"}]
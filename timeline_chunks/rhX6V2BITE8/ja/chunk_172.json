[{"type": "subtitle", "time": 10320.67, "timestamp": "02:52:00", "text": "Dyingをプレイします"}, {"type": "subtitle", "time": 10323.83, "timestamp": "02:52:03", "text": "ライト。えっと、これは4番目のストリームです"}, {"type": "subtitle", "time": 10326.389, "timestamp": "02:52:06", "text": "ダイイングライト。というわけで、私たちは終わりました。"}, {"type": "subtitle", "time": 10329.19, "timestamp": "02:52:09", "text": "ほら、終わったよ、完全に終わったよ"}, {"type": "subtitle", "time": 10331.91, "timestamp": "02:52:11", "text": "キャンペーン。こちらではほぼ100％そうです。"}, {"type": "subtitle", "time": 10333.07, "timestamp": "02:52:13", "text": "物語は"}, {"type": "subtitle", "time": 10336.389, "timestamp": "02:52:16", "text": "終わり。そして私は遊んでいた"}, {"type": "subtitle", "time": 10339.59, "timestamp": "02:52:19", "text": "ヴィックのコラボは、"}, {"type": "subtitle", "time": 10342.389, "timestamp": "02:52:22", "text": "コラボレーションの最前線。シャシャが言うように"}, {"type": "subtitle", "time": 10344.95, "timestamp": "02:52:24", "text": "こちらです。うん。うん。うん。だから今日"}, {"type": "subtitle", "time": 10348.83, "timestamp": "02:52:28", "text": "私たちは次のDLCをプレイします。"}, {"type": "subtitle", "time": 10351.63, "timestamp": "02:52:31", "text": "こんにちは。今日は以下のゲームをプレイします"}, {"type": "subtitle", "time": 10355.429, "timestamp": "02:52:35", "text": "DLC。これがどうなるか楽しみです"}, {"type": "subtitle", "time": 10358.15, "timestamp": "02:52:38", "text": "プレイスルーになります。皆さんが"}, {"type": "subtitle", "time": 10362.07, "timestamp": "02:52:42", "text": "いつも通り順調です。えっと、作る"}, {"type": "subtitle", "time": 10364.95, "timestamp": "02:52:44", "text": "水分補給とか、そういうことをちゃんとやってね。わかった。"}, {"type": "subtitle", "time": 10367.349, "timestamp": "02:52:47", "text": "水を飲むことを忘れないでください"}, {"type": "subtitle", "time": 10370.95, "timestamp": "02:52:50", "text": "ない。そして、えーと、今日は日曜日で、"}, {"type": "subtitle", "time": 10373.429, "timestamp": "02:52:53", "text": "右？今日。ええ、今日は日曜日です。"}, {"type": "subtitle", "time": 10375.19, "timestamp": "02:52:55", "text": "今日は良い日だ。正直に言うと。"}, {"type": "subtitle", "time": 10377.99, "timestamp": "02:52:57", "text": "とても良い、心地よい"}, {"type": "subtitle", "time": 10379.07, "timestamp": "02:52:59", "text": "朝"}]
[{"type": "subtitle", "time": 19572.708, "timestamp": "05:26:12", "text": "鎌。それが私のスライススタイルです"}, {"type": "subtitle", "time": 19573.55, "timestamp": "05:26:13", "text": "ネック"}, {"type": "subtitle", "time": 19577.31, "timestamp": "05:26:17", "text": "バールではなく、上へ押し上げるように。カラス、カラス"}, {"type": "subtitle", "time": 19578.91, "timestamp": "05:26:18", "text": "強引な手段。"}, {"type": "subtitle", "time": 19582.23, "timestamp": "05:26:22", "text": "うん。えっと、鎌。私は鎌を選びます。"}, {"type": "subtitle", "time": 19586.39, "timestamp": "05:26:26", "text": "チャン。わかった。私が担当してもいいですか？おお、"}, {"type": "subtitle", "time": 19588.708, "timestamp": "05:26:28", "text": "「ああ、これは鎌だ」の中の鎌。私"}, {"type": "subtitle", "time": 19591.59, "timestamp": "05:26:31", "text": "sだと思った。ああ、気にしないで。ああ、"}, {"type": "subtitle", "time": 19593.948, "timestamp": "05:26:33", "text": "残念だった"}, {"type": "subtitle", "time": 19597.99, "timestamp": "05:26:37", "text": "騒音。ああ、なんてことだ。銃。ベクトルは"}, {"type": "subtitle", "time": 19606.99, "timestamp": "05:26:46", "text": "VSS？ VSS。スナイパーのように見える"}, {"type": "subtitle", "time": 19609.708, "timestamp": "05:26:49", "text": "けれど。あなたは歩く"}, {"type": "subtitle", "time": 19617.35, "timestamp": "05:26:57", "text": "歩く。誰が撃っているんだ？私はできません"}]
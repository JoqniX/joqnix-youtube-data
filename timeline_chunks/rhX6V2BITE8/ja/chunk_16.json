[{"type": "subtitle", "time": 963.43, "timestamp": "00:16:03", "text": "拭き取り検査をするために、"}, {"type": "subtitle", "time": 965.55, "timestamp": "00:16:05", "text": "私と快適に過ごし、"}, {"type": "subtitle", "time": 967.55, "timestamp": "00:16:07", "text": "もの。"}, {"type": "subtitle", "time": 972.99, "timestamp": "00:16:12", "text": "物事は"}, {"type": "subtitle", "time": 997.509, "timestamp": "00:16:37", "text": "ペンを外す。どうやら人々は"}, {"type": "subtitle", "time": 1000.949, "timestamp": "00:16:40", "text": "ちなみに、キックもね。みんなが"}, {"type": "subtitle", "time": 1004.55, "timestamp": "00:16:44", "text": "ちなみに、蹴る。だから私は"}, {"type": "subtitle", "time": 1007.91, "timestamp": "00:16:47", "text": "キック視聴者に集中する必要がある"}, {"type": "subtitle", "time": 1010.629, "timestamp": "00:16:50", "text": "観客を蹴り飛ばせ。"}, {"type": "subtitle", "time": 1014.15, "timestamp": "00:16:54", "text": "えっと、彼らにもっと何かを与えて"}, {"type": "subtitle", "time": 1017.99, "timestamp": "00:16:57", "text": "瞬間的なキックは私の制作の一部ではありません"}]
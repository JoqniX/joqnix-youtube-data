[{"type": "subtitle", "time": 14641.87, "timestamp": "04:04:01", "text": "ボール。"}, {"type": "subtitle", "time": 14646.11, "timestamp": "04:04:06", "text": "わかった。私はたくさんのお金を持っています"}, {"type": "subtitle", "time": 14659.83, "timestamp": "04:04:19", "text": "レナ、聞こえる？レナの飛行機は"}, {"type": "subtitle", "time": 14663.269, "timestamp": "04:04:23", "text": "大丈夫ですか？どうしたの？何が起こっているのか"}, {"type": "subtitle", "time": 14666.59, "timestamp": "04:04:26", "text": "の上？あなたが教えて。どこに"}, {"type": "subtitle", "time": 14687.67, "timestamp": "04:04:47", "text": "魅力。えっと、スペースを確認したいのですが"}, {"type": "subtitle", "time": 14689.75, "timestamp": "04:04:49", "text": "ローラー。実際、私たち全員が"}, {"type": "subtitle", "time": 14691.91, "timestamp": "04:04:51", "text": "心配した。元気です。心配しないで。それ"}, {"type": "subtitle", "time": 14697.91, "timestamp": "04:04:57", "text": "これはどうでしょう？患者さんの言うことは正しかった。"}, {"type": "subtitle", "time": 14699.99, "timestamp": "04:04:59", "text": "ここにはこのグループがあって、みんな"}]
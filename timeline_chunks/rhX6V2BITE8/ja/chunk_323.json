[{"type": "subtitle", "time": 19380.31, "timestamp": "05:23:00", "text": "あるいは、そんな感じ。いいえ。ええと、もしあなたが"}, {"type": "subtitle", "time": 19384.47, "timestamp": "05:23:04", "text": "さらに、コーディネートもできます"}, {"type": "subtitle", "time": 19386.51, "timestamp": "05:23:06", "text": "あるいは、そんな感じ。それはまだ"}, {"type": "subtitle", "time": 19390.47, "timestamp": "05:23:10", "text": "もの？こんにちは。どうすればそこへ行けますか？"}, {"type": "subtitle", "time": 19393.19, "timestamp": "05:23:13", "text": "神よ、私はかつてゲームをする人たちを鍛えていました"}, {"type": "subtitle", "time": 19397.35, "timestamp": "05:23:17", "text": "ずっと昔のことです。起き上がれない。"}, {"type": "subtitle", "time": 19403.15, "timestamp": "05:23:23", "text": "ここ？"}, {"type": "subtitle", "time": 19406.11, "timestamp": "05:23:26", "text": "あぁ、あぁ"}, {"type": "subtitle", "time": 19408.67, "timestamp": "05:23:28", "text": "男の子。こんにちは、"}, {"type": "subtitle", "time": 19412.07, "timestamp": "05:23:32", "text": "富士。このゲームにはまだベクター要素はありますか？"}, {"type": "subtitle", "time": 19415.708, "timestamp": "05:23:35", "text": "ええ、そうですね。こんにちは、アラクサ。こんにちは。"}, {"type": "subtitle", "time": 19438.87, "timestamp": "05:23:58", "text": "わかった。"}]
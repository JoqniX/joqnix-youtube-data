[{"type": "subtitle", "time": 21000.75, "timestamp": "05:50:00", "text": "あなた。お会いできて嬉しいです"}, {"type": "subtitle", "time": 21003.99, "timestamp": "05:50:03", "text": "あなた。サッカーボールがあります。"}, {"type": "subtitle", "time": 21005.948, "timestamp": "05:50:05", "text": "私は"}, {"type": "subtitle", "time": 21008.31, "timestamp": "05:50:08", "text": "フットボール。何てことだ。実際に"}, {"type": "subtitle", "time": 21023.31, "timestamp": "05:50:23", "text": "撃つのをやめろ。"}, {"type": "subtitle", "time": 21026.19, "timestamp": "05:50:26", "text": "くそ。これは楽しい。"}, {"type": "subtitle", "time": 21029.59, "timestamp": "05:50:29", "text": "ああ、試合はどうですか？楽しくて怖い"}, {"type": "subtitle", "time": 21037.31, "timestamp": "05:50:37", "text": "楽しい。理解していただければ幸いです。"}, {"type": "subtitle", "time": 21040.23, "timestamp": "05:50:40", "text": "それ。しかし、私たちは最初の試合に出場できた。私の勝ちだ。"}, {"type": "subtitle", "time": 21043.11, "timestamp": "05:50:43", "text": "いいえ、前回の試合は私が勝ちました。初めてのゲーム"}, {"type": "subtitle", "time": 21046.59, "timestamp": "05:50:46", "text": "私は列に並びました。私は実際に勝ちました"}, {"type": "subtitle", "time": 21054.75, "timestamp": "05:50:54", "text": "方法。とんでもない。ディオですが、実際には"}, {"type": "subtitle", "time": 21058.03, "timestamp": "05:50:58", "text": "要約すると、勝利した。ニース。"}]
[{"type": "subtitle", "time": 16523.51, "timestamp": "04:35:23", "text": "あの、あのね？ええと、私たちは"}, {"type": "subtitle", "time": 16526.75, "timestamp": "04:35:26", "text": "ガソリンスタンドで節約。"}, {"type": "subtitle", "time": 16529.67, "timestamp": "04:35:29", "text": "わかった。それが私が思いつく最善のアイデアだと思います"}, {"type": "subtitle", "time": 16533.109, "timestamp": "04:35:33", "text": "今持っているもの。えーと、えーと、君には"}, {"type": "subtitle", "time": 16546.249, "timestamp": "04:35:46", "text": "もの。お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 16553.75, "timestamp": "04:35:53", "text": "良い。そして私はほんの少ししか持っていません"}, {"type": "subtitle", "time": 16556.949, "timestamp": "04:35:56", "text": "まだ時間がある。私は自分の"}]
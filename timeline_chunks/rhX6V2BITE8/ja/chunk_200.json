[{"type": "subtitle", "time": 12032.349, "timestamp": "03:20:32", "text": "これで終わりですよね？全員死亡した。"}, {"type": "subtitle", "time": 12035.55, "timestamp": "03:20:35", "text": "よし、今からあなたに警告します"}, {"type": "subtitle", "time": 12042.66, "timestamp": "03:20:42", "text": "お金は"}, {"type": "subtitle", "time": 12044.51, "timestamp": "03:20:44", "text": "[音楽]"}, {"type": "subtitle", "time": 12047.67, "timestamp": "03:20:47", "text": "猿の方が好き？ええ、彼らは"}, {"type": "subtitle", "time": 12049.15, "timestamp": "03:20:49", "text": "ライフル銃"}, {"type": "subtitle", "time": 12052.51, "timestamp": "03:20:52", "text": "彼ら。私はただもっとライフルが欲しかっただけなんです、"}, {"type": "subtitle", "time": 12054.269, "timestamp": "03:20:54", "text": "[音楽]"}]
[{"type": "subtitle", "time": 6060.07, "timestamp": "01:41:00", "text": "つまり、私がウェブにお金を払ったということです"}, {"type": "subtitle", "time": 6062.629, "timestamp": "01:41:02", "text": "スタジオ。使っても構いません。私は愛しています"}, {"type": "subtitle", "time": 6066.229, "timestamp": "01:41:06", "text": "使いたい。問題は"}, {"type": "subtitle", "time": 6069.59, "timestamp": "01:41:09", "text": "もし可能であれば、誰かに"}, {"type": "subtitle", "time": 6072.91, "timestamp": "01:41:12", "text": "行為において、"}, {"type": "subtitle", "time": 6077.35, "timestamp": "01:41:17", "text": "仲介業者が、それが"}, {"type": "subtitle", "time": 6079.99, "timestamp": "01:41:19", "text": "サミー、HTML として送信できます。"}, {"type": "subtitle", "time": 6083.59, "timestamp": "01:41:23", "text": "ウェブソケットのことですが、仲介者と"}, {"type": "subtitle", "time": 6086.229, "timestamp": "01:41:26", "text": "その仲介業者はそれを直接送ります"}, {"type": "subtitle", "time": 6088.109, "timestamp": "01:41:28", "text": "ウェブへ"}, {"type": "subtitle", "time": 6092.07, "timestamp": "01:41:32", "text": "スタジオは、それが大いに役立つだろう"}, {"type": "subtitle", "time": 6104.149, "timestamp": "01:41:44", "text": "ああ、それはとても助かります。いくつか必要です"}, {"type": "subtitle", "time": 6107.669, "timestamp": "01:41:47", "text": "まあ、ある意味では仲介者みたいなものかな"}, {"type": "subtitle", "time": 6110.709, "timestamp": "01:41:50", "text": "だって、その仲介業者はそれを知っているだろうから"}, {"type": "subtitle", "time": 6114.47, "timestamp": "01:41:54", "text": "それは私が必要としないように役立ちます"}, {"type": "subtitle", "time": 6117.83, "timestamp": "01:41:57", "text": "Web StudioのようなところにあるAPI関連のもの。手に入れる"}]
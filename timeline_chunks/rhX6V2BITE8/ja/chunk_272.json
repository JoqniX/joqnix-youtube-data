[{"type": "subtitle", "time": 16337.26, "timestamp": "04:32:17", "text": "私たちは行くべきでしょうか、私は上に行くべきでしょうか、"}, {"type": "subtitle", "time": 16338.91, "timestamp": "04:32:18", "text": "[音楽]"}, {"type": "subtitle", "time": 16341.95, "timestamp": "04:32:21", "text": "そうしたら私は行くことになっている"}, {"type": "subtitle", "time": 16345.63, "timestamp": "04:32:25", "text": "立ち上がって、私は組みつく。"}, {"type": "subtitle", "time": 16348.99, "timestamp": "04:32:28", "text": "いいえ、あなたは私に組み合うことを許さないでしょう。"}, {"type": "subtitle", "time": 16351.79, "timestamp": "04:32:31", "text": "はぁ？いいえ、私は立候補できます"}, {"type": "subtitle", "time": 16354.53, "timestamp": "04:32:34", "text": "それ。オンにする"}, {"type": "subtitle", "time": 16363.11, "timestamp": "04:32:43", "text": "力。どうやって電源を入れればいいの？"}, {"type": "subtitle", "time": 16374.87, "timestamp": "04:32:54", "text": "[音楽]"}, {"type": "subtitle", "time": 16378.44, "timestamp": "04:32:58", "text": "どうやって起きたのか、自分でもわからない"}]
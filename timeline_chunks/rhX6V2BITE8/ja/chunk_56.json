[{"type": "subtitle", "time": 3362.63, "timestamp": "00:56:02", "text": "21日、ロサンゼルスの最後の週の土曜日"}, {"type": "subtitle", "time": 3366.23, "timestamp": "00:56:06", "text": "6月の第3週は、"}, {"type": "subtitle", "time": 3370.309, "timestamp": "00:56:10", "text": "あと1週間で21週目ですね。"}, {"type": "subtitle", "time": 3373.589, "timestamp": "00:56:13", "text": "残り1週間 22～28日 それが"}, {"type": "subtitle", "time": 3377.589, "timestamp": "00:56:17", "text": "これが最後です。"}, {"type": "subtitle", "time": 3381.27, "timestamp": "00:56:21", "text": "えーと、10 番目から 10 番目までの COE で、それから私は"}, {"type": "subtitle", "time": 3383.27, "timestamp": "00:56:23", "text": "アカデミーと話し合う必要があるかもしれない"}, {"type": "subtitle", "time": 3387.51, "timestamp": "00:56:27", "text": "地元のアカデミーに行って、"}, {"type": "subtitle", "time": 3390.069, "timestamp": "00:56:30", "text": "個人的に、そして私のドメトリのためのもの"}, {"type": "subtitle", "time": 3392.549, "timestamp": "00:56:32", "text": "物と支払い構造と"}, {"type": "subtitle", "time": 3394.309, "timestamp": "00:56:34", "text": "すべて。父は行くと思うけど"}, {"type": "subtitle", "time": 3396.87, "timestamp": "00:56:36", "text": "それでも、少なくとも彼らとは話さなければならない"}, {"type": "subtitle", "time": 3399.19, "timestamp": "00:56:39", "text": "だって、私の希望は個室だから。だから私は"}, {"type": "subtitle", "time": 3402.39, "timestamp": "00:56:42", "text": "それを優先しないといけないしね。の"}, {"type": "subtitle", "time": 3404.91, "timestamp": "00:56:44", "text": "これらのアカデミーの人たちは「そうだよ、君は」という感じだった"}, {"type": "subtitle", "time": 3407.99, "timestamp": "00:56:47", "text": "6ヶ月間ストリーミングを一時停止する必要があります"}, {"type": "subtitle", "time": 3410.23, "timestamp": "00:56:50", "text": "6ヶ月間落ち着いたら"}, {"type": "subtitle", "time": 3411.829, "timestamp": "00:56:51", "text": "引っ越すか、それともまだ一緒に行くか"}, {"type": "subtitle", "time": 3414.069, "timestamp": "00:56:54", "text": "ドメトリやその他何であれ、あなただけが"}, {"type": "subtitle", "time": 3416.23, "timestamp": "00:56:56", "text": "物事がどうなっているかについての基本的な考えを持ち、"}, {"type": "subtitle", "time": 3417.67, "timestamp": "00:56:57", "text": "あなたができることとあなたが"}, {"type": "subtitle", "time": 3419.99, "timestamp": "00:56:59", "text": "できないし、すべてやって、それからやる"}]
[{"type": "subtitle", "time": 240.229, "timestamp": "00:04:00", "text": "ええ、試験があって、2週目から"}, {"type": "subtitle", "time": 244.229, "timestamp": "00:04:04", "text": "先へ進み、そして私は行かなければならない、えーと、これ"}, {"type": "subtitle", "time": 247.589, "timestamp": "00:04:07", "text": "COEセレモニーは最後に、最後の最後に行われました。"}, {"type": "subtitle", "time": 250.39, "timestamp": "00:04:10", "text": "今月と先月の週"}, {"type": "subtitle", "time": 252.35, "timestamp": "00:04:12", "text": "今週は荷造りをしなければならない"}, {"type": "subtitle", "time": 255.589, "timestamp": "00:04:15", "text": "すべて。バックアップのバックアップを取ってください。私はそうは思わない"}, {"type": "subtitle", "time": 257.99, "timestamp": "00:04:17", "text": "自分のデータをバックアップする時間さえありません"}, {"type": "subtitle", "time": 261.11, "timestamp": "00:04:21", "text": "Googleドライブだよ、兄弟。ああ、それは君だよ"}, {"type": "subtitle", "time": 264.15, "timestamp": "00:04:24", "text": "私は去ります。私はPCを放棄し、"}, {"type": "subtitle", "time": 266.07, "timestamp": "00:04:26", "text": "日本に行ってノートパソコンを手に入れて"}, {"type": "subtitle", "time": 267.87, "timestamp": "00:04:27", "text": "もの。だから、私は"}, {"type": "subtitle", "time": 270.87, "timestamp": "00:04:30", "text": "どういうわけか二重思考して何ができるか考え"}, {"type": "subtitle", "time": 272.909, "timestamp": "00:04:32", "text": "私は手に入れるのが好き"}, {"type": "subtitle", "time": 277.35, "timestamp": "00:04:37", "text": "それは何て言うんだっけ？ストレージを取得する"}, {"type": "subtitle", "time": 280.87, "timestamp": "00:04:40", "text": "システムやその他すべてはご存知のとおりです"}, {"type": "subtitle", "time": 283.27, "timestamp": "00:04:43", "text": "えっと、ゲームじゃないよ、大丈夫"}, {"type": "subtitle", "time": 285.43, "timestamp": "00:04:45", "text": "ゲームは大丈夫、たとえ負けても"}, {"type": "subtitle", "time": 293.469, "timestamp": "00:04:53", "text": "でも私が言いたかったのは"}, {"type": "subtitle", "time": 296.99, "timestamp": "00:04:56", "text": "次のようなもの"}]
[{"type": "subtitle", "time": 11281.83, "timestamp": "03:08:01", "text": "子供たちの信頼。信頼の信頼"}, {"type": "subtitle", "time": 11288.99, "timestamp": "03:08:08", "text": "何？何てことだ。どうすればいいの？"}, {"type": "subtitle", "time": 11292.07, "timestamp": "03:08:12", "text": "これ？見えるのは緑ばかりだ。はい、私は"}, {"type": "subtitle", "time": 11295.67, "timestamp": "03:08:15", "text": "そうすれば、それほど明確になると思う。"}, {"type": "subtitle", "time": 11298.03, "timestamp": "03:08:18", "text": "いつでも飛び込むことができる"}, {"type": "subtitle", "time": 11300.75, "timestamp": "03:08:20", "text": "水。いや、それは違う"}, {"type": "subtitle", "time": 11303.59, "timestamp": "03:08:23", "text": "仕事。待って、それでうまくいくの？私はただ"}, {"type": "subtitle", "time": 11306.91, "timestamp": "03:08:26", "text": "見てみたい。待って、私がやらせて"}, {"type": "subtitle", "time": 11310.429, "timestamp": "03:08:30", "text": "それ。水に飛び込め。あなたは言う"}, {"type": "subtitle", "time": 11313.99, "timestamp": "03:08:33", "text": "いいえ。水に飛び込め。そうです。その"}, {"type": "subtitle", "time": 11318.23, "timestamp": "03:08:38", "text": "水に飛び込む。何てことだ。私はしませんでした"}, {"type": "subtitle", "time": 11322.349, "timestamp": "03:08:42", "text": "H をしてください。実際には、"}, {"type": "subtitle", "time": 11324.99, "timestamp": "03:08:44", "text": "水。いいえ。"}, {"type": "subtitle", "time": 11327.07, "timestamp": "03:08:47", "text": "ああ、それは"}, {"type": "subtitle", "time": 11330.11, "timestamp": "03:08:50", "text": "これ？ああ、それは"}, {"type": "subtitle", "time": 11332.75, "timestamp": "03:08:52", "text": "薬。彼は"}, {"type": "subtitle", "time": 11335.23, "timestamp": "03:08:55", "text": "ゾンビ？彼は"}]
[{"type": "subtitle", "time": 12661.83, "timestamp": "03:31:01", "text": "修理とかその他"}, {"type": "subtitle", "time": 12663.63, "timestamp": "03:31:03", "text": "通常の車両。"}, {"type": "subtitle", "time": 12668.67, "timestamp": "03:31:08", "text": "いいえ、あなたは普通に運転できると思います"}, {"type": "subtitle", "time": 12671.95, "timestamp": "03:31:11", "text": "車両。そう思います。わからない"}, {"type": "subtitle", "time": 12679.59, "timestamp": "03:31:19", "text": "それも良いことだと信じています"}, {"type": "subtitle", "time": 12682.79, "timestamp": "03:31:22", "text": "方法。彼らはそれを許可しないと思いますよ。"}, {"type": "subtitle", "time": 12686.95, "timestamp": "03:31:26", "text": "待って、シャンボの使用のために私にさせて"}, {"type": "subtitle", "time": 12694.11, "timestamp": "03:31:34", "text": "ここ。運転できますか？"}, {"type": "subtitle", "time": 12698.55, "timestamp": "03:31:38", "text": "それ？いいえ、許可されていません。もちろん、"}, {"type": "subtitle", "time": 12701.03, "timestamp": "03:31:41", "text": "ゲームではバギーを使うように指示されています。"}, {"type": "subtitle", "time": 12703.21, "timestamp": "03:31:43", "text": "それ以外は何もない。"}, {"type": "subtitle", "time": 12717.15, "timestamp": "03:31:57", "text": "もの？新しい場所がマークされました"}]
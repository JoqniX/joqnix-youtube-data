[{"type": "subtitle", "time": 16220.149, "timestamp": "04:30:20", "text": "頭。私から離れてください。"}, {"type": "subtitle", "time": 16222.149, "timestamp": "04:30:22", "text": "手伝ったお礼にお金をくれますか？"}, {"type": "subtitle", "time": 16223.83, "timestamp": "04:30:23", "text": "母の忠実な息子たちはあなたに恩返しをする"}, {"type": "subtitle", "time": 16227.63, "timestamp": "04:30:27", "text": "ご親切に感謝いたします。こんにちは、私は元気です。"}, {"type": "subtitle", "time": 16230.71, "timestamp": "04:30:30", "text": "タイタン。あの少年はレベルアップした。ありがとう"}, {"type": "subtitle", "time": 16237.28, "timestamp": "04:30:37", "text": "神。私は実際にレベルアップしました"}, {"type": "subtitle", "time": 16247.229, "timestamp": "04:30:47", "text": "上。ゴミテストは"}]
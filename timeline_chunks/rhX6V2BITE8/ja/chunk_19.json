[{"type": "subtitle", "time": 1149.15, "timestamp": "00:19:09", "text": "ダイアナ、私に"}, {"type": "subtitle", "time": 1168.31, "timestamp": "00:19:28", "text": "いいえ、私がぜひとも"}, {"type": "subtitle", "time": 1169.31, "timestamp": "00:19:29", "text": "コラボレーション"}, {"type": "subtitle", "time": 1171.63, "timestamp": "00:19:31", "text": "新しい"}, {"type": "subtitle", "time": 1173.15, "timestamp": "00:19:33", "text": "人々、"}, {"type": "subtitle", "time": 1176.35, "timestamp": "00:19:36", "text": "でも私はこう思う、"}, {"type": "subtitle", "time": 1180.83, "timestamp": "00:19:40", "text": "えっと、私は持っていません"}, {"type": "subtitle", "time": 1184.47, "timestamp": "00:19:44", "text": "時間がないのは、私が"}, {"type": "subtitle", "time": 1187.27, "timestamp": "00:19:47", "text": "すでに話をして、つながりを持っています"}, {"type": "subtitle", "time": 1188.87, "timestamp": "00:19:48", "text": "と。私が話していない"}, {"type": "subtitle", "time": 1191.07, "timestamp": "00:19:51", "text": "長い間。だから、私は"}, {"type": "subtitle", "time": 1193.909, "timestamp": "00:19:53", "text": "同時に新しいものを取り入れようともしている"}, {"type": "subtitle", "time": 1195.87, "timestamp": "00:19:55", "text": "人々も"}, {"type": "subtitle", "time": 1199.27, "timestamp": "00:19:59", "text": "間。ということで、あちこちちょっと慌ただしい感じですね。"}]
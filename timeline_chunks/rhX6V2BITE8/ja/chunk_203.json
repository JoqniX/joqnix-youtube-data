[{"type": "subtitle", "time": 12192.229, "timestamp": "03:23:12", "text": "多くの。おお、これは新しいタイプの木箱だ。"}, {"type": "subtitle", "time": 12193.07, "timestamp": "03:23:13", "text": "A"}, {"type": "subtitle", "time": 12209.309, "timestamp": "03:23:29", "text": "あと少しだったのに。しかし、"}, {"type": "subtitle", "time": 12211.56, "timestamp": "03:23:31", "text": "それ？そこにいる"}, {"type": "subtitle", "time": 12219.01, "timestamp": "03:23:39", "text": "行く。そこにいる"}, {"type": "subtitle", "time": 12222.59, "timestamp": "03:23:42", "text": "[音楽]"}, {"type": "subtitle", "time": 12227.71, "timestamp": "03:23:47", "text": "行く。金属接着剤ブレーキ。ヴァデ"}, {"type": "subtitle", "time": 12231.83, "timestamp": "03:23:51", "text": "ブレーキ。これがバギーです。何てことだ。"}, {"type": "subtitle", "time": 12233.91, "timestamp": "03:23:53", "text": "Eキーを長押ししてアップグレードします。これはあなたのバギーです"}, {"type": "subtitle", "time": 12237.07, "timestamp": "03:23:57", "text": "スキンをアップグレードするにはこちらをクリックしてください。アップグレードをインストールできます"}, {"type": "subtitle", "time": 12239.91, "timestamp": "03:23:59", "text": "交換する。わかった。アップグレードを確認するか、"}]
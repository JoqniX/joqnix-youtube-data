[{"type": "subtitle", "time": 3242.15, "timestamp": "00:54:02", "text": "ブランドイメージとしての顔、だから問題ない"}, {"type": "subtitle", "time": 3245.829, "timestamp": "00:54:05", "text": "ブラザー・スタースケープの人たちのような"}, {"type": "subtitle", "time": 3248.47, "timestamp": "00:54:08", "text": "ジェネ"}, {"type": "subtitle", "time": 3250.15, "timestamp": "00:54:10", "text": "ない。だから、大丈夫です。特に"}, {"type": "subtitle", "time": 3253.75, "timestamp": "00:54:13", "text": "クインソンも同様だ。えっと、クインソンは"}, {"type": "subtitle", "time": 3255.75, "timestamp": "00:54:15", "text": "元ユーチューバーで、今は"}, {"type": "subtitle", "time": 3258.39, "timestamp": "00:54:18", "text": "怠惰な自己としてストリーミング配信を行う。だから、彼女は"}, {"type": "subtitle", "time": 3260.87, "timestamp": "00:54:20", "text": "彼女は自宅で配信やコンテンツ制作を行っている。"}, {"type": "subtitle", "time": 3263.829, "timestamp": "00:54:23", "text": "だから、私は彼女の言うことに従わなければならない。"}, {"type": "subtitle", "time": 3266.47, "timestamp": "00:54:26", "text": "うん。しかし、それは主に"}, {"type": "subtitle", "time": 3268.71, "timestamp": "00:54:28", "text": "好みと快適さ"}, {"type": "subtitle", "time": 3271.829, "timestamp": "00:54:31", "text": "ゲスト。だから、それに従わなければならないし、"}, {"type": "subtitle", "time": 3275.19, "timestamp": "00:54:35", "text": "そうしてください。もし誰かが私に"}, {"type": "subtitle", "time": 3277.51, "timestamp": "00:54:37", "text": "画像を削除してください。喜んで削除します。それで"}, {"type": "subtitle", "time": 3281.549, "timestamp": "00:54:41", "text": "ええ、だからその点には気をつけなければなりません。"}, {"type": "subtitle", "time": 3285.67, "timestamp": "00:54:45", "text": "あまりにも。海石さんへ、えっと、私の試験は"}, {"type": "subtitle", "time": 3291.549, "timestamp": "00:54:51", "text": "11時10分までに終了。ええと、持っている"}, {"type": "subtitle", "time": 3293.309, "timestamp": "00:54:53", "text": "試験"}, {"type": "subtitle", "time": 3295.71, "timestamp": "00:54:55", "text": "意思"}]
[{"type": "subtitle", "time": 16921.788, "timestamp": "04:42:01", "text": "超高速。正しくやればいい"}, {"type": "subtitle", "time": 16925.27, "timestamp": "04:42:05", "text": "今。もっと早くやるはずだったんだけど"}, {"type": "subtitle", "time": 16926.51, "timestamp": "04:42:06", "text": "私"}, {"type": "subtitle", "time": 16930.47, "timestamp": "04:42:10", "text": "忘れた。うん。私のミスです。私のミスです。こんにちは。またはあなた"}, {"type": "subtitle", "time": 16933.59, "timestamp": "04:42:13", "text": "発表内容を確認するだけでいいのですが"}, {"type": "subtitle", "time": 16936.55, "timestamp": "04:42:16", "text": "コミュニティフィードにて。入手できます"}, {"type": "subtitle", "time": 16941.51, "timestamp": "04:42:21", "text": "そこからも。他に何か"}, {"type": "subtitle", "time": 16942.91, "timestamp": "04:42:22", "text": "私は"}, {"type": "subtitle", "time": 16946.03, "timestamp": "04:42:26", "text": "逃す？何かが私に、見逃したことを告げている"}, {"type": "subtitle", "time": 16949.75, "timestamp": "04:42:29", "text": "何か。言い忘れたことがありました。"}, {"type": "subtitle", "time": 16952.03, "timestamp": "04:42:32", "text": "ナニナニナニ。"}, {"type": "subtitle", "time": 16955.75, "timestamp": "04:42:35", "text": "はい、私たちは、"}, {"type": "subtitle", "time": 16958.47, "timestamp": "04:42:38", "text": "スケジュール、スケジュールされた適切なパスのように"}, {"type": "subtitle", "time": 16961.51, "timestamp": "04:42:41", "text": "今からずっと"}, {"type": "subtitle", "time": 16962.99, "timestamp": "04:42:42", "text": "以来"}, {"type": "subtitle", "time": 16966.868, "timestamp": "04:42:46", "text": "1月はまるでゴリラの弧を描いているようだった。だからこれは"}, {"type": "subtitle", "time": 16968.67, "timestamp": "04:42:48", "text": "時間が欲しいだけ"}, {"type": "subtitle", "time": 16973.19, "timestamp": "04:42:53", "text": "ストリームを配信する、ストリームを配信する"}, {"type": "subtitle", "time": 16975.43, "timestamp": "04:42:55", "text": "短い配信、最大2時間程度としましょう。"}, {"type": "subtitle", "time": 16979.67, "timestamp": "04:42:59", "text": "そうですね、最大4つまでで、ええ、そうはならないでしょう。"}]
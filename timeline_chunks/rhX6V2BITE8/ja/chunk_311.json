[{"type": "subtitle", "time": 18662.868, "timestamp": "05:11:02", "text": "捕獲。そのキャプチャではない。待って、これは"}, {"type": "subtitle", "time": 18665.07, "timestamp": "05:11:05", "text": "私の情報源の名前"}, {"type": "subtitle", "time": 18673.11, "timestamp": "05:11:13", "text": "捕獲。どの画像ですか？ディオ。待って。"}, {"type": "subtitle", "time": 18675.31, "timestamp": "05:11:15", "text": "わかった。これ"}, {"type": "subtitle", "time": 18677.788, "timestamp": "05:11:17", "text": "1つ。わかった。"}, {"type": "subtitle", "time": 18680.948, "timestamp": "05:11:20", "text": "プレイヤーのスピードがぼやけて見える。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 18683.67, "timestamp": "05:11:23", "text": "もうすぐ動作するはずです。いいえ。"}, {"type": "subtitle", "time": 18685.91, "timestamp": "05:11:25", "text": "わかった。動作するはずです。それはそうあるべきだ"}, {"type": "subtitle", "time": 18686.67, "timestamp": "05:11:26", "text": "働く。"}, {"type": "subtitle", "time": 18690.67, "timestamp": "05:11:30", "text": "ええ、そうあるべきです。"}, {"type": "subtitle", "time": 18693.83, "timestamp": "05:11:33", "text": "わかった。だから、今はこうしました"}, {"type": "subtitle", "time": 18697.11, "timestamp": "05:11:37", "text": "チェックは私のPCを積極的にチェックします"}, {"type": "subtitle", "time": 18700.47, "timestamp": "05:11:40", "text": "ゲームのexeファイル。それから、それは変わる"}, {"type": "subtitle", "time": 18703.43, "timestamp": "05:11:43", "text": "OBS のいろいろなものやトリガー関連のもの。違う"}, {"type": "subtitle", "time": 18705.35, "timestamp": "05:11:45", "text": "でも、それってそんなに便利なの？だから、私は必要ない"}, {"type": "subtitle", "time": 18707.51, "timestamp": "05:11:47", "text": "心配するな、ああ、電源を入れるのを忘れた"}, {"type": "subtitle", "time": 18710.788, "timestamp": "05:11:50", "text": "ぼやけている。ぼかすのを忘れてた"}, {"type": "subtitle", "time": 18713.35, "timestamp": "05:11:53", "text": "ミニマップなどなど。だから、"}, {"type": "subtitle", "time": 18716.55, "timestamp": "05:11:56", "text": "私がヴァレラント・エイペックスをプレイするとき、心配してください。"}, {"type": "subtitle", "time": 18719.19, "timestamp": "05:11:59", "text": "何でも。"}]
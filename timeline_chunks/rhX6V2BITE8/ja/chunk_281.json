[{"type": "subtitle", "time": 16862.55, "timestamp": "04:41:02", "text": "スケジュールは、完全には完了していません"}, {"type": "subtitle", "time": 16864.788, "timestamp": "04:41:04", "text": "えーと、残りのスケジュールを全部"}, {"type": "subtitle", "time": 16869.19, "timestamp": "04:41:09", "text": "今週の配信。えっと、明日"}, {"type": "subtitle", "time": 16871.03, "timestamp": "04:41:11", "text": "Needy Streamerをプレイします"}, {"type": "subtitle", "time": 16873.75, "timestamp": "04:41:13", "text": "過負荷。後ほどスケジュールします"}, {"type": "subtitle", "time": 16876.39, "timestamp": "04:41:16", "text": "このストリーム。そして、他の"}, {"type": "subtitle", "time": 16878.39, "timestamp": "04:41:18", "text": "スケジュールされた配信も利用可能です"}, {"type": "subtitle", "time": 16881.67, "timestamp": "04:41:21", "text": "今。ということで、リマインダーとしてマークしておきます。"}, {"type": "subtitle", "time": 16884.43, "timestamp": "04:41:24", "text": "だから、あなたも参加できますよ。"}, {"type": "subtitle", "time": 16888.23, "timestamp": "04:41:28", "text": "こんにちは。そして、また、私が"}, {"type": "subtitle", "time": 16891.03, "timestamp": "04:41:31", "text": "誕生日にはお祝いしません"}, {"type": "subtitle", "time": 16894.47, "timestamp": "04:41:34", "text": "8月11日金曜日ですが、私は"}, {"type": "subtitle", "time": 16897.83, "timestamp": "04:41:37", "text": "えーと、お祝いの配信は"}, {"type": "subtitle", "time": 16901.35, "timestamp": "04:41:41", "text": "12日の土曜日。こんにちは。私は"}, {"type": "subtitle", "time": 16904.43, "timestamp": "04:41:44", "text": "教授がそれについて正式な発表をした後"}, {"type": "subtitle", "time": 16907.31, "timestamp": "04:41:47", "text": "シュリア。"}, {"type": "subtitle", "time": 16911.67, "timestamp": "04:41:51", "text": "ええと、信じます。"}, {"type": "subtitle", "time": 16915.11, "timestamp": "04:41:55", "text": "Telegram の機能は"}, {"type": "subtitle", "time": 16918.15, "timestamp": "04:41:58", "text": "説明。ちょっと手短に"}]
[{"type": "subtitle", "time": 16396.109, "timestamp": "04:33:16", "text": "[音楽]"}, {"type": "subtitle", "time": 16399.05, "timestamp": "04:33:19", "text": "を通して。何てことだ。"}, {"type": "subtitle", "time": 16408.91, "timestamp": "04:33:28", "text": "[音楽]"}, {"type": "subtitle", "time": 16412.029, "timestamp": "04:33:32", "text": "何？わかった。"}, {"type": "subtitle", "time": 16415.629, "timestamp": "04:33:35", "text": "わかった。私は組みつく"}, {"type": "subtitle", "time": 16419.07, "timestamp": "04:33:39", "text": "そこには。ディオン。"}, {"type": "subtitle", "time": 16428.629, "timestamp": "04:33:48", "text": "グラップラー。はい、以上です。非アクティブ"}, {"type": "subtitle", "time": 16431.029, "timestamp": "04:33:51", "text": "一部の国では活動していないのは"}, {"type": "subtitle", "time": 16433.869, "timestamp": "04:33:53", "text": "速度不足はビラルを助けるだろう"}, {"type": "subtitle", "time": 16436.789, "timestamp": "04:33:56", "text": "人々に力を、人々の探求に力を"}, {"type": "subtitle", "time": 16439.67, "timestamp": "04:33:59", "text": "それらを使えるようにする。"}]
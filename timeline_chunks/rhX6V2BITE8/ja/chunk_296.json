[{"type": "subtitle", "time": 17761.43, "timestamp": "04:56:01", "text": "今日はPUBGをプレイします。なぜ私はこのゲームをプレイしているのか"}, {"type": "subtitle", "time": 17763.788, "timestamp": "04:56:03", "text": "私に言わせれば？それは"}, {"type": "subtitle", "time": 17766.51, "timestamp": "04:56:06", "text": "なぜならDiscordだから"}, {"type": "subtitle", "time": 17770.15, "timestamp": "04:56:10", "text": "クエスト 私はただゲームをダウンロードしただけです"}, {"type": "subtitle", "time": 17777.75, "timestamp": "04:56:17", "text": "うん。そう、それが私の"}, {"type": "subtitle", "time": 17784.948, "timestamp": "04:56:24", "text": "つまり、私はプレイしていないということです"}, {"type": "subtitle", "time": 17787.35, "timestamp": "04:56:27", "text": "このゲームをかなり長い間プレイしていた。それで、"}, {"type": "subtitle", "time": 17789.91, "timestamp": "04:56:29", "text": "私は「ああ、どっちにしても行くよ」って感じだった"}, {"type": "subtitle", "time": 17792.23, "timestamp": "04:56:32", "text": "ストリームのためにプレイして"}, {"type": "subtitle", "time": 17798.788, "timestamp": "04:56:38", "text": "ああ、こんにちは、ペギー。ようこそ、ようこそ。"}, {"type": "subtitle", "time": 17801.39, "timestamp": "04:56:41", "text": "お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 17804.39, "timestamp": "04:56:44", "text": "良い。ええ、そうですね。えーと、早速始めましょう。"}, {"type": "subtitle", "time": 17807.19, "timestamp": "04:56:47", "text": "私は推測する。えっと、バトルグラウンド以外の場所でプレイしてください。"}, {"type": "subtitle", "time": 17812.83, "timestamp": "04:56:52", "text": "もし私が持っていたら、私は持っていたら、"}, {"type": "subtitle", "time": 17817.07, "timestamp": "04:56:57", "text": "えっと、もし私が"}]
[{"type": "subtitle", "time": 724.19, "timestamp": "00:12:04", "text": "私の追跡は"}, {"type": "subtitle", "time": 726.87, "timestamp": "00:12:06", "text": "行くよ。わかった、あのね？私は"}, {"type": "subtitle", "time": 730.069, "timestamp": "00:12:10", "text": "今日はV関連の作業を終わらせて、"}, {"type": "subtitle", "time": 732.47, "timestamp": "00:12:12", "text": "今日は7つのVをアップロードする予定で、"}, {"type": "subtitle", "time": 735.19, "timestamp": "00:12:15", "text": "私のデータを元に戻してください。行き詰まってしまったと思う"}, {"type": "subtitle", "time": 739.509, "timestamp": "00:12:19", "text": "68日目か70日目に始めた。"}, {"type": "subtitle", "time": 741.829, "timestamp": "00:12:21", "text": "コラボ企画をやること。だから私は"}, {"type": "subtitle", "time": 744.629, "timestamp": "00:12:24", "text": "私は行き詰まっていると思う"}, {"type": "subtitle", "time": 747.35, "timestamp": "00:12:27", "text": "えっと、Mioとのコラボ。私は行き詰まっていると思います"}, {"type": "subtitle", "time": 749.829, "timestamp": "00:12:29", "text": "そこにいて、まだダウンロードする必要がある"}, {"type": "subtitle", "time": 751.99, "timestamp": "00:12:31", "text": "VODはまだMio Collabまでですが、"}, {"type": "subtitle", "time": 753.99, "timestamp": "00:12:33", "text": "まだビリービリーにアップロードする必要がある"}, {"type": "subtitle", "time": 757.03, "timestamp": "00:12:37", "text": "そうですね、それで80日目まで頑張っています"}, {"type": "subtitle", "time": 760.949, "timestamp": "00:12:40", "text": "それを上げるには、80から"}, {"type": "subtitle", "time": 765.949, "timestamp": "00:12:45", "text": "80から84へ、今日は84なので、それはつまり、"}, {"type": "subtitle", "time": 769.03, "timestamp": "00:12:49", "text": "ボード2枚右1枚パート1"}, {"type": "subtitle", "time": 771.03, "timestamp": "00:12:51", "text": "パート2だが、パート4も同じように"}, {"type": "subtitle", "time": 773.11, "timestamp": "00:12:53", "text": "パート１だが、毎日２回そんな感じ"}, {"type": "subtitle", "time": 776.87, "timestamp": "00:12:56", "text": "そう、だから私は"}]
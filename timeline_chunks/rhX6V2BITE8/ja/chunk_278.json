[{"type": "subtitle", "time": 16686.75, "timestamp": "04:38:06", "text": "すごく混乱してるんだけど"}, {"type": "subtitle", "time": 16693.629, "timestamp": "04:38:13", "text": "ああ、この人か。"}, {"type": "subtitle", "time": 16698.23, "timestamp": "04:38:18", "text": "わかった。いいえ。なぜ私はランニングをサボったのでしょうか？いや、カット。"}, {"type": "subtitle", "time": 16700.47, "timestamp": "04:38:20", "text": "なぜ私はサボったのか？"}, {"type": "subtitle", "time": 16702.23, "timestamp": "04:38:22", "text": "それなら、あなたが話しているのは良いことです"}, {"type": "subtitle", "time": 16704.07, "timestamp": "04:38:24", "text": "自分。はい、大丈夫です。大丈夫です。その"}, {"type": "subtitle", "time": 16705.75, "timestamp": "04:38:25", "text": "大丈夫。大丈夫です。長距離ドライブになります。"}, {"type": "subtitle", "time": 16707.83, "timestamp": "04:38:27", "text": "でも、きっとそれだけの価値があるよ"}, {"type": "subtitle", "time": 16711.51, "timestamp": "04:38:31", "text": "それ。よし、どうぞ。うっかり渡してしまった"}, {"type": "subtitle", "time": 16713.75, "timestamp": "04:38:33", "text": "ざっと目を通し、何か役に立つものがあれば"}, {"type": "subtitle", "time": 16717.07, "timestamp": "04:38:37", "text": "部品を持ってきてください。"}, {"type": "subtitle", "time": 16721.15, "timestamp": "04:38:41", "text": "わかった。ご褒美の塗装作業。わかった。"}, {"type": "subtitle", "time": 16724.869, "timestamp": "04:38:44", "text": "ああ、わかった。何でも。えっと、ただ"}, {"type": "subtitle", "time": 16727.83, "timestamp": "04:38:47", "text": "保存できる。はい、保存できます"}, {"type": "subtitle", "time": 16739.31, "timestamp": "04:38:59", "text": "今夜のことですよね？私たちはこれを行います"}]
[{"type": "subtitle", "time": 12360.63, "timestamp": "03:26:00", "text": "おお。何てことだ。私はレッドデッドに到達しました"}, {"type": "subtitle", "time": 12362.67, "timestamp": "03:26:02", "text": "終わり。実際に死亡"}, {"type": "subtitle", "time": 12382.59, "timestamp": "03:26:22", "text": "壊れた。ドッキー、武器を。ああ、"}, {"type": "subtitle", "time": 12385.07, "timestamp": "03:26:25", "text": "神。"}, {"type": "subtitle", "time": 12389.389, "timestamp": "03:26:29", "text": "いや、実際には私は"}, {"type": "subtitle", "time": 12392.469, "timestamp": "03:26:32", "text": "自転車みたいなもの。ああ、それは感じ取れる"}, {"type": "subtitle", "time": 12393.95, "timestamp": "03:26:33", "text": "の"}, {"type": "subtitle", "time": 12396.51, "timestamp": "03:26:36", "text": "タイヤ。おお"}, {"type": "subtitle", "time": 12399.75, "timestamp": "03:26:39", "text": "いいえ。ネジを探してください。ネジがありません"}, {"type": "subtitle", "time": 12402.09, "timestamp": "03:26:42", "text": "私と一緒に。"}, {"type": "subtitle", "time": 12417.389, "timestamp": "03:26:57", "text": "起こる。フリーロールするよ"}, {"type": "subtitle", "time": 12419.87, "timestamp": "03:26:59", "text": "これは"}]
[{"type": "subtitle", "time": 9362.349, "timestamp": "02:36:02", "text": "かつて与えていた人に与える"}, {"type": "subtitle", "time": 9381.75, "timestamp": "02:36:21", "text": "もの？返信を掘り起こす必要があると思う"}, {"type": "subtitle", "time": 9400.23, "timestamp": "02:36:40", "text": "えっと、どれですか？ああ、私が話していたのは"}, {"type": "subtitle", "time": 9404.07, "timestamp": "02:36:44", "text": "えっと、あの不眠症の人って知ってるよね"}, {"type": "subtitle", "time": 9407.79, "timestamp": "02:36:47", "text": "吸血鬼アニメ。それです。私はそれを"}, {"type": "subtitle", "time": 9419.75, "timestamp": "02:36:59", "text": "ああ、チャットで友達が"}]
[{"type": "subtitle", "time": 15668.469, "timestamp": "04:21:08", "text": "男の子。よし、あと30分しかない"}, {"type": "subtitle", "time": 15670.309, "timestamp": "04:21:10", "text": "左。その後は、"}, {"type": "subtitle", "time": 15673.91, "timestamp": "04:21:13", "text": "今日。はぁ？残り40分。だから、ほとんど"}, {"type": "subtitle", "time": 15676.99, "timestamp": "04:21:16", "text": "おそらくこのクエストは完了するだろう"}, {"type": "subtitle", "time": 15684.99, "timestamp": "04:21:24", "text": "日。"}, {"type": "subtitle", "time": 15706.07, "timestamp": "04:21:46", "text": "暗い部分は本当に難しい。"}]
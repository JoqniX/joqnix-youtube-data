[{"type": "subtitle", "time": 19626.23, "timestamp": "05:27:06", "text": "いいね。これは表示されませんか"}, {"type": "subtitle", "time": 19628.23, "timestamp": "05:27:08", "text": "レーダー？待って、レーダーが見えますか？"}, {"type": "subtitle", "time": 19630.47, "timestamp": "05:27:10", "text": "そこには？君たちが見ることができないと思う"}, {"type": "subtitle", "time": 19634.15, "timestamp": "05:27:14", "text": "翻訳テキスト付きのレーダー。しかし"}, {"type": "subtitle", "time": 19637.75, "timestamp": "05:27:17", "text": "ああ、レーダーのことだよね？君は"}, {"type": "subtitle", "time": 19640.628, "timestamp": "05:27:20", "text": "銃声が聞こえた場所を見てください。ただ"}, {"type": "subtitle", "time": 19643.23, "timestamp": "05:27:23", "text": "赤く表示される、ですよね？例えば"}, {"type": "subtitle", "time": 19647.43, "timestamp": "05:27:27", "text": "フォートナイトとエイペックス。なぜ？このゲームは"}, {"type": "subtitle", "time": 19666.868, "timestamp": "05:27:46", "text": "うんうん。何てことだ。何てことだ。何てことだ。"}, {"type": "subtitle", "time": 19667.948, "timestamp": "05:27:47", "text": "ああ、"}, {"type": "subtitle", "time": 19677.83, "timestamp": "05:27:57", "text": "何てことだ。何てことだ。何てことだ。ああ、"}, {"type": "subtitle", "time": 19679.788, "timestamp": "05:27:59", "text": "神。ああ、ああ"}]
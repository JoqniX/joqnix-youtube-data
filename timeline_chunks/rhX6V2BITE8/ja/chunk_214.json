[{"type": "subtitle", "time": 12840.15, "timestamp": "03:34:00", "text": "交渉人。まだ値切りたいのか？教えて"}, {"type": "subtitle", "time": 12842.469, "timestamp": "03:34:02", "text": "ヴァタウよ、君の"}, {"type": "subtitle", "time": 12845.03, "timestamp": "03:34:05", "text": "水を求めて馬に乗る。ああ、くそ、"}, {"type": "subtitle", "time": 12848.55, "timestamp": "03:34:08", "text": "下衆野郎。それでいいでしょう。よし、みんな。彼"}, {"type": "subtitle", "time": 12855.429, "timestamp": "03:34:15", "text": "さよなら。"}, {"type": "subtitle", "time": 12857.83, "timestamp": "03:34:17", "text": "ああ、死んでしまった。私は自分の健康状態をチェックしなかった。"}, {"type": "subtitle", "time": 12861.03, "timestamp": "03:34:21", "text": "おお、男よ。大丈夫。大丈夫。大丈夫。"}, {"type": "subtitle", "time": 12862.67, "timestamp": "03:34:22", "text": "その"}, {"type": "subtitle", "time": 12865.11, "timestamp": "03:34:25", "text": "わかった。その国は、その国にあると言っています"}, {"type": "subtitle", "time": 12866.63, "timestamp": "03:34:26", "text": "スピードこそすべてだ。速く行けば行くほど、"}, {"type": "subtitle", "time": 12868.71, "timestamp": "03:34:28", "text": "あなたが所有するドライブボーンの数が増えます。より簡単に"}, {"type": "subtitle", "time": 12872.07, "timestamp": "03:34:32", "text": "ウイルスやボランティアがあなたを追いかけてくる"}, {"type": "subtitle", "time": 12874.349, "timestamp": "03:34:34", "text": "道路。わかった。つまり、スピードですね。"}, {"type": "subtitle", "time": 12883.63, "timestamp": "03:34:43", "text": "スピード。そして私はどこにいるのか"}, {"type": "subtitle", "time": 12886.99, "timestamp": "03:34:46", "text": "私？これは何ですか"}, {"type": "subtitle", "time": 12892.349, "timestamp": "03:34:52", "text": "場所？ここはどこですか？私は今のところ"}]
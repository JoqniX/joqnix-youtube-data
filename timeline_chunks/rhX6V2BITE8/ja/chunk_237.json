[{"type": "subtitle", "time": 14222.07, "timestamp": "03:57:02", "text": "町を変える。私はエレインにこう言っています"}, {"type": "subtitle", "time": 14224.07, "timestamp": "03:57:04", "text": "それは悪魔ですが、彼女は言います"}, {"type": "subtitle", "time": 14226.07, "timestamp": "03:57:06", "text": "誰かがそれが猫かどうか確認すべきだ"}, {"type": "subtitle", "time": 14228.389, "timestamp": "03:57:08", "text": "彼らを助けることができる。猫なら、"}, {"type": "subtitle", "time": 14230.63, "timestamp": "03:57:10", "text": "取引で猫を連れ出すことができるのは"}, {"type": "subtitle", "time": 14233.429, "timestamp": "03:57:13", "text": "誰かがもう一方の方向へ向かっているので、"}, {"type": "subtitle", "time": 14236.79, "timestamp": "03:57:16", "text": "一緒に来て確認することもできます。"}, {"type": "subtitle", "time": 14240.83, "timestamp": "03:57:20", "text": "ああ、それをいただきます。なぜだめですか？私は打ち砕いた"}, {"type": "subtitle", "time": 14244.189, "timestamp": "03:57:24", "text": "それ。行方不明者、兄弟、そして"}, {"type": "subtitle", "time": 14247.67, "timestamp": "03:57:27", "text": "姉妹。先週、私は"}, {"type": "subtitle", "time": 14250.87, "timestamp": "03:57:30", "text": "気分が良くなった。それで、私の愛するエムラは"}, {"type": "subtitle", "time": 14254.11, "timestamp": "03:57:34", "text": "母親に感謝するために"}, {"type": "subtitle", "time": 14257.67, "timestamp": "03:57:37", "text": "モノリスよ、戻ってこい。誰か手伝って持ってきて"}, {"type": "subtitle", "time": 14259.83, "timestamp": "03:57:39", "text": "彼を私のところへ戻してください。気分が良くない"}, {"type": "subtitle", "time": 14262.469, "timestamp": "03:57:42", "text": "自分で彼を探し出すのに十分なほど元気だ。トップ"}, {"type": "subtitle", "time": 14266.55, "timestamp": "03:57:46", "text": "モデルは私にとってだけでなく、"}, {"type": "subtitle", "time": 14269.269, "timestamp": "03:57:49", "text": "それはまた、彼が彼を"}, {"type": "subtitle", "time": 14274.03, "timestamp": "03:57:54", "text": "危害。"}, {"type": "subtitle", "time": 14276.269, "timestamp": "03:57:56", "text": "わかった。もう一人行方不明"}]
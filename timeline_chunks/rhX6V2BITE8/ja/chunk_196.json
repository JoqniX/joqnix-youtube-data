[{"type": "subtitle", "time": 11762.63, "timestamp": "03:16:02", "text": "聞いてくれ、俺は今その男に欠けているし、"}, {"type": "subtitle", "time": 11765.59, "timestamp": "03:16:05", "text": "私は起業家です。一緒にビジネスをしましょう。"}, {"type": "subtitle", "time": 11769.11, "timestamp": "03:16:09", "text": "君と僕でパートナーを組もう。何かを購入する際、"}, {"type": "subtitle", "time": 11775.91, "timestamp": "03:16:15", "text": "よし、彼は両方の話を聞くためにそこにいる"}, {"type": "subtitle", "time": 11778.87, "timestamp": "03:16:18", "text": "私たちの会話。"}, {"type": "subtitle", "time": 11781.91, "timestamp": "03:16:21", "text": "なんて小さな箱なんだ。何てことだ。見せることができます"}, {"type": "subtitle", "time": 11783.91, "timestamp": "03:16:23", "text": "何か役に立つかもしれないもの、"}, {"type": "subtitle", "time": 11786.15, "timestamp": "03:16:26", "text": "でも、まずは車輪を手に入れなきゃ。"}, {"type": "subtitle", "time": 11788.95, "timestamp": "03:16:28", "text": "ここに車が走っている。私はどこにいるの？"}, {"type": "subtitle", "time": 11790.79, "timestamp": "03:16:30", "text": "それを見つけるはずだったの？ヴァデ車両。おお"}, {"type": "subtitle", "time": 11794.389, "timestamp": "03:16:34", "text": "我が神よ。さあ行こう。おい、慎重に"}, {"type": "subtitle", "time": 11796.95, "timestamp": "03:16:36", "text": "それについて。わかった、慎重に行動してくれ。何"}, {"type": "subtitle", "time": 11801.07, "timestamp": "03:16:41", "text": "再び控えめになったのか？秘密にしておく。"}, {"type": "subtitle", "time": 11803.429, "timestamp": "03:16:43", "text": "秘密主義。釘の中に乗り物を探す"}, {"type": "subtitle", "time": 11805.349, "timestamp": "03:16:45", "text": "農場。何てことだ。実際、私たちは"}, {"type": "subtitle", "time": 11807.51, "timestamp": "03:16:47", "text": "車両を入手する。わかった。あの車を手に入れろと言った"}, {"type": "subtitle", "time": 11810.07, "timestamp": "03:16:50", "text": "あなたについて。何てことだ。あのずる賢い奴はどこにいる？"}, {"type": "subtitle", "time": 11813.03, "timestamp": "03:16:53", "text": "ずる賢い犬の狐？どこ？どこにいるの？"}, {"type": "subtitle", "time": 11816.55, "timestamp": "03:16:56", "text": "周りを見回して私を見つけた人"}, {"type": "subtitle", "time": 11819.59, "timestamp": "03:16:59", "text": "彼と話している。着ていた"}]
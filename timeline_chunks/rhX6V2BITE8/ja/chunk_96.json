[{"type": "subtitle", "time": 5764.07, "timestamp": "01:36:04", "text": "ああ、私も体を休ませなきゃ。私は"}, {"type": "subtitle", "time": 5767.81, "timestamp": "01:36:07", "text": "自分を追い込みすぎている。"}, {"type": "subtitle", "time": 5770.149, "timestamp": "01:36:10", "text": "[音楽]"}, {"type": "subtitle", "time": 5778.629, "timestamp": "01:36:18", "text": "待って。ああ、最後のプレーだ。何てことだ。ニース。"}, {"type": "subtitle", "time": 5780.55, "timestamp": "01:36:20", "text": "ええ、そうするべきです。私は使うべきだと思う"}, {"type": "subtitle", "time": 5782.99, "timestamp": "01:36:22", "text": "これは私の"}, {"type": "subtitle", "time": 5785.75, "timestamp": "01:36:25", "text": "もの。 HTMLコードを教えてください。"}, {"type": "subtitle", "time": 5795.11, "timestamp": "01:36:35", "text": "スタジオが私のアカウントに接続する可能性が高い"}, {"type": "subtitle", "time": 5796.11, "timestamp": "01:36:36", "text": "そして"}, {"type": "subtitle", "time": 5799.189, "timestamp": "01:36:39", "text": "もの。はい、私にはこれと似たものがあります。"}, {"type": "subtitle", "time": 5802.51, "timestamp": "01:36:42", "text": "これで十分だろう。私"}, {"type": "subtitle", "time": 5806.109, "timestamp": "01:36:46", "text": "必要ないと思う"}, {"type": "subtitle", "time": 5810.189, "timestamp": "01:36:50", "text": "私は、"}, {"type": "subtitle", "time": 5813.51, "timestamp": "01:36:53", "text": "音楽セクション全体とか。うん、"}, {"type": "subtitle", "time": 5816.47, "timestamp": "01:36:56", "text": "あの2本のバーみたいなのは要らない。私はできる"}, {"type": "subtitle", "time": 5818.75, "timestamp": "01:36:58", "text": "文字通りただ"}]
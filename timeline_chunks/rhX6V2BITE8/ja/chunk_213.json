[{"type": "subtitle", "time": 12781.83, "timestamp": "03:33:01", "text": "再装填が必要です。横から入ってください。"}, {"type": "subtitle", "time": 12792.389, "timestamp": "03:33:12", "text": "[音楽]"}, {"type": "subtitle", "time": 12803.99, "timestamp": "03:33:23", "text": "こんにちは。山賊と話す"}, {"type": "subtitle", "time": 12806.15, "timestamp": "03:33:26", "text": "後で。君はここにいるんだね、友よ。毎回新しい"}, {"type": "subtitle", "time": 12812.469, "timestamp": "03:33:32", "text": "アセン、"}, {"type": "subtitle", "time": 12813.83, "timestamp": "03:33:33", "text": "あなたは実際に何かを売り払っている"}, {"type": "subtitle", "time": 12816.55, "timestamp": "03:33:36", "text": "ここ。水は透き通るように澄んでいる。下痢なし"}, {"type": "subtitle", "time": 12819.11, "timestamp": "03:33:39", "text": "その後。まるで天使の味がする"}, {"type": "subtitle", "time": 12820.63, "timestamp": "03:33:40", "text": "足を踏み入れた、あなたの舌を踏み入れた。 1つ"}, {"type": "subtitle", "time": 12824.229, "timestamp": "03:33:44", "text": "1ガロンで10ポンドの食品。金として"}, {"type": "subtitle", "time": 12827.349, "timestamp": "03:33:47", "text": "良い。水の代わりに10ポンドの餌。何が"}, {"type": "subtitle", "time": 12828.55, "timestamp": "03:33:48", "text": "空気に料金を請求し始めるつもりですか、それとも"}, {"type": "subtitle", "time": 12831.429, "timestamp": "03:33:51", "text": "二？おっと、値切り屋が来たぞ。交渉人？"}, {"type": "subtitle", "time": 12834.55, "timestamp": "03:33:54", "text": "下を見てみろよ、この野郎。あれ、分かりますか？それは"}, {"type": "subtitle", "time": 12837.19, "timestamp": "03:33:57", "text": "ロスコ。私たちは値切り交渉をする客を彼に任せる。"}]
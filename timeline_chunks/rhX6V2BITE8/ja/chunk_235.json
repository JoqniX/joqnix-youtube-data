[{"type": "subtitle", "time": 14100.469, "timestamp": "03:55:00", "text": "それは私の友人たちを救えるかもしれない。もしあなたが"}, {"type": "subtitle", "time": 14103.269, "timestamp": "03:55:03", "text": "何でも。はい、見知らぬ方。はい、そうです。我々は持っています"}, {"type": "subtitle", "time": 14107.07, "timestamp": "03:55:07", "text": "私たちの信仰と、母への祈り。"}, {"type": "subtitle", "time": 14109.91, "timestamp": "03:55:09", "text": "信仰？わかった。失礼なつもりはないのですが、"}, {"type": "subtitle", "time": 14112.07, "timestamp": "03:55:12", "text": "祈りは"}, {"type": "subtitle", "time": 14113.91, "timestamp": "03:55:13", "text": "あなたが向きを変えるのを阻止します。"}, {"type": "subtitle", "time": 14116.79, "timestamp": "03:55:16", "text": "それはあなたの問題です。信仰が欠けている"}, {"type": "subtitle", "time": 14119.75, "timestamp": "03:55:19", "text": "他の部外者と同じように。私たちは信じています"}, {"type": "subtitle", "time": 14122.55, "timestamp": "03:55:22", "text": "母は私たちを守ってくれる。我々は持っています"}, {"type": "subtitle", "time": 14126.309, "timestamp": "03:55:26", "text": "アンチネンとか、あなたが言ったようなものは必要ない。"}, {"type": "subtitle", "time": 14128.63, "timestamp": "03:55:28", "text": "わかった。わかった。ええと、何か方法はありますか"}, {"type": "subtitle", "time": 14131.349, "timestamp": "03:55:31", "text": "この母親と話せるかもしれない？彼女"}, {"type": "subtitle", "time": 14134.07, "timestamp": "03:55:34", "text": "神聖なものである。彼女は、"}, {"type": "subtitle", "time": 14135.87, "timestamp": "03:55:35", "text": "として知られる"}, {"type": "subtitle", "time": 14139.429, "timestamp": "03:55:39", "text": "顔のない。でも、もしかしたら、あなたは"}, {"type": "subtitle", "time": 14142.309, "timestamp": "03:55:42", "text": "彼らにあなたに気づいてもらう。あなたは十分よくやっています"}, {"type": "subtitle", "time": 14144.389, "timestamp": "03:55:44", "text": "地域社会のために。この時点で、私は"}, {"type": "subtitle", "time": 14146.63, "timestamp": "03:55:46", "text": "何でも。では、あなたはどのような点で優れているのですか？"}, {"type": "subtitle", "time": 14147.99, "timestamp": "03:55:47", "text": "探している？何をする必要があるのか"}, {"type": "subtitle", "time": 14152.07, "timestamp": "03:55:52", "text": "この辺りで？本気で言ってるの？"}, {"type": "subtitle", "time": 14154.63, "timestamp": "03:55:54", "text": "わかりました。私は、これを処理します"}, {"type": "subtitle", "time": 14157.11, "timestamp": "03:55:57", "text": "農場。そして私の友人ビラルはガスを保管している"}, {"type": "subtitle", "time": 14159.59, "timestamp": "03:55:59", "text": "町に近い駅は安全です。周りを見渡してみて。"}]
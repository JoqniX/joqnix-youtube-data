[{"type": "subtitle", "time": 846.87, "timestamp": "00:14:06", "text": "コラボ、うん、いいよ、わからないけど"}, {"type": "subtitle", "time": 853.069, "timestamp": "00:14:13", "text": "私の、えーと物事がどうなるか"}, {"type": "subtitle", "time": 856.67, "timestamp": "00:14:16", "text": "私にとっての未来。"}, {"type": "subtitle", "time": 861.55, "timestamp": "00:14:21", "text": "えっと、私が日本にいる間、次の"}, {"type": "subtitle", "time": 866.55, "timestamp": "00:14:26", "text": "月。うまくいけば、物を取り戻せるだろう"}, {"type": "subtitle", "time": 868.55, "timestamp": "00:14:28", "text": "立ち上がって"}, {"type": "subtitle", "time": 872.829, "timestamp": "00:14:32", "text": "えっと、後ろの物を手に入れる"}, {"type": "subtitle", "time": 877.189, "timestamp": "00:14:37", "text": "そうして、もっと早くストリーミングを再開しよう"}, {"type": "subtitle", "time": 878.11, "timestamp": "00:14:38", "text": "または"}, {"type": "subtitle", "time": 883.55, "timestamp": "00:14:43", "text": "後で。でも、そうするべきだ"}, {"type": "subtitle", "time": 886.11, "timestamp": "00:14:46", "text": "一緒に過ごすべきだ"}, {"type": "subtitle", "time": 898.91, "timestamp": "00:14:58", "text": "楽しい。えっと、ありがとう"}]
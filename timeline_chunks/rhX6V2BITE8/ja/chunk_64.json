[{"type": "subtitle", "time": 3843.309, "timestamp": "01:04:03", "text": "良い。こんにちは。もう一度確認させてください"}, {"type": "subtitle", "time": 3845.51, "timestamp": "01:04:05", "text": "トゥイッチ。それはいいです。倍にさせてください"}, {"type": "subtitle", "time": 3846.75, "timestamp": "01:04:06", "text": "チェックする"}, {"type": "subtitle", "time": 3849.19, "timestamp": "01:04:09", "text": "キック。それも良いことだ。倍にさせてください"}, {"type": "subtitle", "time": 3857.15, "timestamp": "01:04:17", "text": "ビーム。それも良いことだ。わかった。全て"}, {"type": "subtitle", "time": 3859.99, "timestamp": "01:04:19", "text": "右。すべて順調です。すべて順調です。すべて順調です。"}, {"type": "subtitle", "time": 3880.99, "timestamp": "01:04:40", "text": "[音楽]"}, {"type": "subtitle", "time": 3884.069, "timestamp": "01:04:44", "text": "ニース。あなたはそこにぎっしり詰まっている。"}, {"type": "subtitle", "time": 3886.51, "timestamp": "01:04:46", "text": "うん。えーと、私は自分の"}, {"type": "subtitle", "time": 3889.39, "timestamp": "01:04:49", "text": "15日。 15日。それを書き留めておきましょう。"}, {"type": "subtitle", "time": 3893.069, "timestamp": "01:04:53", "text": "ヘロン。えっと、メモを取らないといけないので、"}]
[{"type": "subtitle", "time": 181.19, "timestamp": "00:03:01", "text": "私はコラボパートナーが"}, {"type": "subtitle", "time": 184.47, "timestamp": "00:03:04", "text": "連絡をくれれば、"}, {"type": "subtitle", "time": 186.55, "timestamp": "00:03:06", "text": "今日ストリーミングしないと、"}, {"type": "subtitle", "time": 189.07, "timestamp": "00:03:09", "text": "緊急時に誰かを入院させる"}, {"type": "subtitle", "time": 193.11, "timestamp": "00:03:13", "text": "あれ。えっと、誰だか分からないけど、うん、"}, {"type": "subtitle", "time": 195.91, "timestamp": "00:03:15", "text": "バックアップも必要です。だから私たちは"}, {"type": "subtitle", "time": 200.27, "timestamp": "00:03:20", "text": "公式には21日から3週間しかない"}, {"type": "subtitle", "time": 203.99, "timestamp": "00:03:23", "text": "6月の最後の日は、"}, {"type": "subtitle", "time": 206.589, "timestamp": "00:03:26", "text": "コラボレーションのため、または"}, {"type": "subtitle", "time": 209.03, "timestamp": "00:03:29", "text": "最終日となるもの"}, {"type": "subtitle", "time": 211.99, "timestamp": "00:03:31", "text": "ジョアトンも同様だ。土曜日か"}, {"type": "subtitle", "time": 214.949, "timestamp": "00:03:34", "text": "例えば22日の日曜日とか日曜日とか。私はそうではない"}, {"type": "subtitle", "time": 219.67000000000002, "timestamp": "00:03:39", "text": "私に残された日数がどれくらいなのか、よくわからない。イッシュ"}, {"type": "subtitle", "time": 221.949, "timestamp": "00:03:41", "text": "そうですが、私は"}, {"type": "subtitle", "time": 227.19, "timestamp": "00:03:47", "text": "そう、時間がすごく早く過ぎていくし"}, {"type": "subtitle", "time": 230.07, "timestamp": "00:03:50", "text": "えっと、すごく早く、理由はわからないけど"}, {"type": "subtitle", "time": 233.589, "timestamp": "00:03:53", "text": "痛いけど、試験があるから"}, {"type": "subtitle", "time": 237.22899999999998, "timestamp": "00:03:57", "text": "えっと、2週目以降は、"}]
[{"type": "subtitle", "time": 17340.31, "timestamp": "04:49:00", "text": "誰でも。皆さん、改めてありがとうございました。"}, {"type": "subtitle", "time": 17343.83, "timestamp": "04:49:03", "text": "本日伺います。で会いましょう"}, {"type": "subtitle", "time": 17346.868, "timestamp": "04:49:06", "text": "明日配信します。私たちはプレイします"}, {"type": "subtitle", "time": 17349.27, "timestamp": "04:49:09", "text": "Needy Streamer Overlord と同時に"}, {"type": "subtitle", "time": 17352.47, "timestamp": "04:49:12", "text": "本日午前10時。スケジュールは公開されています。"}, {"type": "subtitle", "time": 17355.59, "timestamp": "04:49:15", "text": "私のすべてのソーシャルメディアで。チェックに行ってもいいですよ"}, {"type": "subtitle", "time": 17359.59, "timestamp": "04:49:19", "text": "彼らを追い出せ。ええ、ぜひお越しください。"}, {"type": "subtitle", "time": 17361.91, "timestamp": "04:49:21", "text": "今日を楽しんでください。さあ、ゆっくり休んでください"}, {"type": "subtitle", "time": 17364.55, "timestamp": "04:49:24", "text": "残りの一日を楽しんでください。"}, {"type": "subtitle", "time": 17367.15, "timestamp": "04:49:27", "text": "これから夜になり、"}, {"type": "subtitle", "time": 17370.35, "timestamp": "04:49:30", "text": "来てくれて本当にありがとう"}, {"type": "subtitle", "time": 17375.58, "timestamp": "04:49:35", "text": "取る"}, {"type": "subtitle", "time": 17397.628, "timestamp": "04:49:57", "text": "[音楽]"}]
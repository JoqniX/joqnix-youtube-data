[{"type": "subtitle", "time": 19983.07, "timestamp": "05:33:03", "text": "弾薬。でも、ノックしてたのは誰だったのか、"}, {"type": "subtitle", "time": 19987.43, "timestamp": "05:33:07", "text": "先ほど聞こえた歩行音？"}, {"type": "subtitle", "time": 19990.47, "timestamp": "05:33:10", "text": "誰が気味の悪い男だったのか、"}, {"type": "subtitle", "time": 19998.39, "timestamp": "05:33:18", "text": "以前？誰かがいるはずだ。"}, {"type": "subtitle", "time": 20006.788, "timestamp": "05:33:26", "text": "クレイジー。いつも人を見かけるのはどうしてですか"}, {"type": "subtitle", "time": 20023.27, "timestamp": "05:33:43", "text": "[音楽]"}, {"type": "subtitle", "time": 20031.27, "timestamp": "05:33:51", "text": "範囲。ああ、どこどこどこする？これ"}, {"type": "subtitle", "time": 20033.99, "timestamp": "05:33:53", "text": "このゲームには方向感覚が全くない。私はできません"}, {"type": "subtitle", "time": 20035.83, "timestamp": "05:33:55", "text": "弾丸を理解する。どこですか"}]
[{"type": "subtitle", "time": 16620.029, "timestamp": "04:37:00", "text": "だから、できるんですよね？いいえ、たった4回だけです。"}, {"type": "subtitle", "time": 16623.629, "timestamp": "04:37:03", "text": "なるほど、興味深い。"}, {"type": "subtitle", "time": 16626.551, "timestamp": "04:37:06", "text": "わかりました。4回までしかできません。"}, {"type": "subtitle", "time": 16628.029, "timestamp": "04:37:08", "text": "または"}, {"type": "subtitle", "time": 16635.67, "timestamp": "04:37:15", "text": "そこには。セーブポイントを見つけなければ。"}, {"type": "subtitle", "time": 16637.23, "timestamp": "04:37:17", "text": "これは、"}, {"type": "subtitle", "time": 16656.869, "timestamp": "04:37:36", "text": "君は私が頼むべき人なの？"}, {"type": "subtitle", "time": 16665.349, "timestamp": "04:37:45", "text": "に？ビラルに発電所について聞いてみて、"}, {"type": "subtitle", "time": 16667.629, "timestamp": "04:37:47", "text": "どこですか？"}, {"type": "subtitle", "time": 16672.83, "timestamp": "04:37:52", "text": "デザイン。いいえ、"}]
[{"type": "subtitle", "time": 13921.03, "timestamp": "03:52:01", "text": "私の配信用PCを使うと、熱量がすごい"}, {"type": "subtitle", "time": 13923.99, "timestamp": "03:52:03", "text": "生成されるのはアリです、わかりました。しかし、"}, {"type": "subtitle", "time": 13926.309, "timestamp": "03:52:06", "text": "その場所は既に浸水している。さて、これからどうする？私たちは"}, {"type": "subtitle", "time": 13929.429, "timestamp": "03:52:09", "text": "ただ待つだけです。はい。今はそうあるべきだ"}, {"type": "subtitle", "time": 13931.99, "timestamp": "03:52:11", "text": "時間の問題だろう。うん。こんな感じ"}, {"type": "subtitle", "time": 13934.63, "timestamp": "03:52:14", "text": "私たちは大丈夫です。どこを直せばいいのか分からない。"}, {"type": "subtitle", "time": 13937.99, "timestamp": "03:52:17", "text": "私たち全員のお尻を直すにはどうすればいいでしょうか。得る"}, {"type": "subtitle", "time": 13941.429, "timestamp": "03:52:21", "text": "農場へ戻る。ジルに伝えます"}, {"type": "subtitle", "time": 13946.91, "timestamp": "03:52:26", "text": "よし。見知らぬ人に対してね。全て"}, {"type": "subtitle", "time": 13948.91, "timestamp": "03:52:28", "text": "右。ただ"}, {"type": "subtitle", "time": 13952.15, "timestamp": "03:52:32", "text": "ここ。私の車はどこにあるんだっけ？そこにいる"}, {"type": "subtitle", "time": 13967.03, "timestamp": "03:52:47", "text": "戻る。ああ、あの気味の悪い奴らが私に這い寄ってくるんだ。"}, {"type": "subtitle", "time": 13967.19, "timestamp": "03:52:47", "text": "そして"}, {"type": "subtitle", "time": 13975.75, "timestamp": "03:52:55", "text": "ああ、まずい。なんてこった。なんてこった。なんてこった。なんてこった。おお"}, {"type": "subtitle", "time": 13977.389, "timestamp": "03:52:57", "text": "いいえ。なんてこった。彼は"}]
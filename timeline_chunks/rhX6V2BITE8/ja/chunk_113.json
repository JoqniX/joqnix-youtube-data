[{"type": "subtitle", "time": 6792.35, "timestamp": "01:53:12", "text": "最大ロット保留中"}, {"type": "subtitle", "time": 6795.39, "timestamp": "01:53:15", "text": "まだ。それで"}, {"type": "subtitle", "time": 6799.91, "timestamp": "01:53:19", "text": "ええ、それで大丈夫ですよ。私は必要としている"}, {"type": "subtitle", "time": 6802.39, "timestamp": "01:53:22", "text": "テンプレートのフォーマットを変更するには"}, {"type": "subtitle", "time": 6803.75, "timestamp": "01:53:23", "text": "そのメッセージが正しいとき、あなたは"}, {"type": "subtitle", "time": 6806.39, "timestamp": "01:53:26", "text": "折りたたみ式またはその他に使用可能。私 私"}, {"type": "subtitle", "time": 6808.55, "timestamp": "01:53:28", "text": "それを変えて言及する必要がある"}, {"type": "subtitle", "time": 6811.51, "timestamp": "01:53:31", "text": "うん、21日まであと3週間しかないよ"}, {"type": "subtitle", "time": 6814.39, "timestamp": "01:53:34", "text": "そして、もし"}, {"type": "subtitle", "time": 6817.589, "timestamp": "01:53:37", "text": "たくさんの人がいます"}, {"type": "subtitle", "time": 6819.83, "timestamp": "01:53:39", "text": "我々に与えられた時間は1つに限定されます"}, {"type": "subtitle", "time": 6823.55, "timestamp": "01:53:43", "text": "時間または最大でそれ以上"}]
[{"type": "subtitle", "time": 17823.11, "timestamp": "04:57:03", "text": "私のマウスの設定です。私はそうは思いません。それで、えっと、私は"}, {"type": "subtitle", "time": 17824.99, "timestamp": "04:57:04", "text": "しないでください。しかしそれは"}, {"type": "subtitle", "time": 17829.35, "timestamp": "04:57:09", "text": "わかった。うん。それでは、"}, {"type": "subtitle", "time": 17831.83, "timestamp": "04:57:11", "text": "何かがポップアップする。あ、待って。それは、えーと"}, {"type": "subtitle", "time": 17834.35, "timestamp": "04:57:14", "text": "それは私です。それで"}, {"type": "subtitle", "time": 17838.51, "timestamp": "04:57:18", "text": "大きい。待って、調整してなかったっけ？"}, {"type": "subtitle", "time": 17841.11, "timestamp": "04:57:21", "text": "これですか？これを調整しなかったのか、それとも"}, {"type": "subtitle", "time": 17850.47, "timestamp": "04:57:30", "text": "はい、調整はしていません。ああ、わかってるよ"}, {"type": "subtitle", "time": 17853.83, "timestamp": "04:57:33", "text": "何が起こっていますか。ああ、忘れてた。えっと、私は私は"}, {"type": "subtitle", "time": 17856.868, "timestamp": "04:57:36", "text": "忘れた。何か失敗したみたいだ。"}, {"type": "subtitle", "time": 17859.43, "timestamp": "04:57:39", "text": "それが理由です。このことが"}, {"type": "subtitle", "time": 17863.75, "timestamp": "04:57:43", "text": "負荷。わかった。バトルグラウンドでプレイしよう。"}, {"type": "subtitle", "time": 17866.11, "timestamp": "04:57:46", "text": "そして私の"}, {"type": "subtitle", "time": 17868.628, "timestamp": "04:57:48", "text": "翻訳者？ええ、元気です。願っています"}, {"type": "subtitle", "time": 17870.07, "timestamp": "04:57:50", "text": "あなたもよくやっていますね。はい、私は"}, {"type": "subtitle", "time": 17873.23, "timestamp": "04:57:53", "text": "順調です。皆さんは"}, {"type": "subtitle", "time": 17876.55, "timestamp": "04:57:56", "text": "えっと、ランチ？もしあなたが午後なら、"}, {"type": "subtitle", "time": 17878.948, "timestamp": "04:57:58", "text": "皆さん、昼食は召し上がりましたか？皆さんが"}]
[{"type": "subtitle", "time": 10800.269, "timestamp": "03:00:00", "text": "遅延なく、さらに"}, {"type": "subtitle", "time": 10804.55, "timestamp": "03:00:04", "text": "アド。こんにちは。ええ、そうですね。こんにちは、シャン卿。"}, {"type": "subtitle", "time": 10805.63, "timestamp": "03:00:05", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 10811.83, "timestamp": "03:00:11", "text": "良い？待って。私はこれを読むことになっている"}, {"type": "subtitle", "time": 10821.75, "timestamp": "03:00:21", "text": "ああ、見逃してしまった。作らないでください"}, {"type": "subtitle", "time": 10825.03, "timestamp": "03:00:25", "text": "自分。あなたは彼が魔法について話したと言いました"}, {"type": "subtitle", "time": 10834.309, "timestamp": "03:00:34", "text": "ああ、彼はあるグループの人々について話していた"}, {"type": "subtitle", "time": 10836.79, "timestamp": "03:00:36", "text": "感染しない人たち。たとえ彼らが"}, {"type": "subtitle", "time": 10840.469, "timestamp": "03:00:40", "text": "何かを言うことさえもできないほど恐ろしい。"}, {"type": "subtitle", "time": 10842.23, "timestamp": "03:00:42", "text": "彼はこれを持っていた。また、"}, {"type": "subtitle", "time": 10843.79, "timestamp": "03:00:43", "text": "音声は今ですか？"}, {"type": "subtitle", "time": 10846.87, "timestamp": "03:00:46", "text": "うわぁ。これは脱出方法のように見える"}, {"type": "subtitle", "time": 10849.51, "timestamp": "03:00:49", "text": "ハラン。ハナからの脱出方法。私たちは走っています"}, {"type": "subtitle", "time": 10852.469, "timestamp": "03:00:52", "text": "抗毒素から。私たちはあらゆることを探求しなければならない"}, {"type": "subtitle", "time": 10854.469, "timestamp": "03:00:54", "text": "可能性。"}, {"type": "subtitle", "time": 10857.11, "timestamp": "03:00:57", "text": "ああ、これから出かけるんだ。待って"}]
[{"type": "subtitle", "time": 21064.27, "timestamp": "05:51:04", "text": "ニース。 [音楽]"}, {"type": "subtitle", "time": 21086.99, "timestamp": "05:51:26", "text": "ああ、それは不気味だ"}, {"type": "subtitle", "time": 21091.03, "timestamp": "05:51:31", "text": "でも待って。私は大丈夫になりたい。行く"}, {"type": "subtitle", "time": 21092.948, "timestamp": "05:51:32", "text": "戦略を立てる。わかった。どうしたらいいですか？"}, {"type": "subtitle", "time": 21095.07, "timestamp": "05:51:35", "text": "他の誰か"}]
[{"type": "subtitle", "time": 11580.87, "timestamp": "03:13:00", "text": "責任者は誰ですか？助けが必要です。話す"}, {"type": "subtitle", "time": 11592.83, "timestamp": "03:13:12", "text": "えっと、この中だと思います。"}, {"type": "subtitle", "time": 11596.95, "timestamp": "03:13:16", "text": "大丈夫。大丈夫。これは誰ですか？おお。ああ、私たちは"}, {"type": "subtitle", "time": 11605.51, "timestamp": "03:13:25", "text": "こんにちは。"}, {"type": "subtitle", "time": 11607.03, "timestamp": "03:13:27", "text": "邪魔するつもりはありません。探しています"}, {"type": "subtitle", "time": 11610.07, "timestamp": "03:13:30", "text": "ジャジールのために。私はジャジールです。でも、もしあなたが望むなら"}, {"type": "subtitle", "time": 11612.63, "timestamp": "03:13:32", "text": "食料はパンしかありません。いや、いや。私 私"}, {"type": "subtitle", "time": 11615.03, "timestamp": "03:13:35", "text": "食べ物は必要ない。聞いてくれ、俺はハラン出身だ、"}, {"type": "subtitle", "time": 11616.71, "timestamp": "03:13:36", "text": "そして私は、"}, {"type": "subtitle", "time": 11618.07, "timestamp": "03:13:38", "text": "ここには免疫のある人がいる"}, {"type": "subtitle", "time": 11619.99, "timestamp": "03:13:39", "text": "ウイルスは、たとえ"}, {"type": "subtitle", "time": 11621.389, "timestamp": "03:13:41", "text": "彼らは噛まれる。"}, {"type": "subtitle", "time": 11625.11, "timestamp": "03:13:45", "text": "ああ、ところで、誰があなたにそんなことを言ったの？死体。"}, {"type": "subtitle", "time": 11627.349, "timestamp": "03:13:47", "text": "残念ながら。そのままにしておいた方がいいでしょう"}, {"type": "subtitle", "time": 11629.429, "timestamp": "03:13:49", "text": "彼の話を聞いている。これ以上は何も言いません"}, {"type": "subtitle", "time": 11631.67, "timestamp": "03:13:51", "text": "彼よりも。彼より多くは話しません"}, {"type": "subtitle", "time": 11633.429, "timestamp": "03:13:53", "text": "今。なぜ誰も私を助けてくれないのだろう？の"}, {"type": "subtitle", "time": 11635.11, "timestamp": "03:13:55", "text": "ウイルスは街中に蔓延している。人々は"}, {"type": "subtitle", "time": 11638.95, "timestamp": "03:13:58", "text": "死に瀕しているのに、あなたはまだ生きている。"}]
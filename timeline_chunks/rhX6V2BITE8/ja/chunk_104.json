[{"type": "subtitle", "time": 6242.229, "timestamp": "01:44:02", "text": "例えばこんなもの"}, {"type": "subtitle", "time": 6245.109, "timestamp": "01:44:05", "text": "jockathon 今、私の"}, {"type": "subtitle", "time": 6247.83, "timestamp": "01:44:07", "text": "私の個人的なアップデート用のモバイルアプリと"}, {"type": "subtitle", "time": 6249.75, "timestamp": "01:44:09", "text": "Jo の次のアップデートとすべて"}, {"type": "subtitle", "time": 6252.31, "timestamp": "01:44:12", "text": "私が送れるものすべて"}, {"type": "subtitle", "time": 6255.87, "timestamp": "01:44:15", "text": "電話やウェブサイトでの通知、または"}, {"type": "subtitle", "time": 6259.91, "timestamp": "01:44:19", "text": "どこであっても、次のゲストが来ます"}, {"type": "subtitle", "time": 6262.87, "timestamp": "01:44:22", "text": "チューニングして、そんな感じ"}, {"type": "subtitle", "time": 6265.35, "timestamp": "01:44:25", "text": "通知のようなものがたくさん"}, {"type": "subtitle", "time": 6267.99, "timestamp": "01:44:27", "text": "物事はうまくいき、私は次のように考えていました"}, {"type": "subtitle", "time": 6270.27, "timestamp": "01:44:30", "text": "ジョギングとは、どのような活動を行うかということです。"}, {"type": "subtitle", "time": 6272.27, "timestamp": "01:44:32", "text": "状態"}, {"type": "subtitle", "time": 6275.27, "timestamp": "01:44:35", "text": "UT5のような部分も欲しい"}, {"type": "subtitle", "time": 6278.03, "timestamp": "01:44:38", "text": "単数形のバージョン"}, {"type": "subtitle", "time": 6281.51, "timestamp": "01:44:41", "text": "まさに今現在"}, {"type": "subtitle", "time": 6284.87, "timestamp": "01:44:44", "text": "Jolexの曲を再生すると"}, {"type": "subtitle", "time": 6287.83, "timestamp": "01:44:47", "text": "これを見せると、人々は曲をチェックできる"}, {"type": "subtitle", "time": 6289.07, "timestamp": "01:44:49", "text": "外に出て"}, {"type": "subtitle", "time": 6292.35, "timestamp": "01:44:52", "text": "歌詞が"}, {"type": "subtitle", "time": 6294.79, "timestamp": "01:44:54", "text": "歌詞をクリックしたり、何らかの形でクリックしたりできる"}]
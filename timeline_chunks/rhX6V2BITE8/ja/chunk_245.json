[{"type": "subtitle", "time": 14705.349, "timestamp": "04:05:05", "text": "そのメンバーのうち、ウイルスに免疫を持つ者。"}, {"type": "subtitle", "time": 14708.55, "timestamp": "04:05:08", "text": "また、私は、私は、"}, {"type": "subtitle", "time": 14710.71, "timestamp": "04:05:10", "text": "金色のやつ。わからない。彼らは"}, {"type": "subtitle", "time": 14712.71, "timestamp": "04:05:12", "text": "地元のシャーマンタイプの人物によって守られている"}, {"type": "subtitle", "time": 14714.63, "timestamp": "04:05:14", "text": "母親に電話した。コミュニケーションのみ"}, {"type": "subtitle", "time": 14716.87, "timestamp": "04:05:16", "text": "彼女の司祭たちを通して。入ってみます"}, {"type": "subtitle", "time": 14717.99, "timestamp": "04:05:17", "text": "彼らと接触するが、これらの人々は"}, {"type": "subtitle", "time": 14721.429, "timestamp": "04:05:21", "text": "部外者を信用するな。諦めずに続けてください。"}, {"type": "subtitle", "time": 14739.189, "timestamp": "04:05:39", "text": "チャレンジ？だから、素晴らしいのは"}, {"type": "subtitle", "time": 14742.75, "timestamp": "04:05:42", "text": "このDLCでは、ただ運転することができます"}, {"type": "subtitle", "time": 14753.83, "timestamp": "04:05:53", "text": "正直言って、とても良い内容です。"}, {"type": "subtitle", "time": 14757.229, "timestamp": "04:05:57", "text": "車を運転して出発すれば"}]
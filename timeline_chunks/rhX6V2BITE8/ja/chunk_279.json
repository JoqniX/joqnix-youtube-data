[{"type": "subtitle", "time": 16742.109, "timestamp": "04:39:02", "text": "また。それで十分だと思います"}, {"type": "subtitle", "time": 16746.269, "timestamp": "04:39:06", "text": "保存。よし。だから、それはとても"}, {"type": "subtitle", "time": 16748.99, "timestamp": "04:39:08", "text": "時間。包んで"}, {"type": "subtitle", "time": 16751.51, "timestamp": "04:39:11", "text": "上。これで締めくくりたいと思います。"}, {"type": "subtitle", "time": 16755.99, "timestamp": "04:39:15", "text": "日。それで、今日はたくさん遊びました。私"}, {"type": "subtitle", "time": 16756.91, "timestamp": "04:39:16", "text": "考える"}, {"type": "subtitle", "time": 16759.949, "timestamp": "04:39:19", "text": "えっと、それで"}, {"type": "subtitle", "time": 16764.029, "timestamp": "04:39:24", "text": "人々がどのようにそうするか、ということですね。"}, {"type": "subtitle", "time": 16767.629, "timestamp": "04:39:27", "text": "33％。待って、それは実際には"}, {"type": "subtitle", "time": 16770.949, "timestamp": "04:39:30", "text": "多く。私だけでしょうか、それとも"}, {"type": "subtitle", "time": 16773.59, "timestamp": "04:39:33", "text": "DLCは本当に短いですか？それとも何かありますか？"}, {"type": "subtitle", "time": 16776.709, "timestamp": "04:39:36", "text": "わからない。しかし、それはかなりの量だ。トリは"}, {"type": "subtitle", "time": 16779.51, "timestamp": "04:39:39", "text": "33%。それはすごい量ですね。それは素晴らしいですね。"}, {"type": "subtitle", "time": 16782.31, "timestamp": "04:39:42", "text": "今日はこれで十分だ。プレイすべきでしょうか？"}, {"type": "subtitle", "time": 16786.868, "timestamp": "04:39:46", "text": "1時間？ 29分38秒"}, {"type": "subtitle", "time": 16790.07, "timestamp": "04:39:50", "text": "そのゲーム。でも私の配信は、えっと、私たちは"}, {"type": "subtitle", "time": 16792.948, "timestamp": "04:39:52", "text": "もうすぐ12時間経過する。全て"}, {"type": "subtitle", "time": 16795.59, "timestamp": "04:39:55", "text": "右。それでは、締めくくりたいと思います。"}, {"type": "subtitle", "time": 16796.51, "timestamp": "04:39:56", "text": "以上"}, {"type": "subtitle", "time": 16798.43, "timestamp": "04:39:58", "text": "ここ。"}]
[{"type": "subtitle", "time": 2101.43, "timestamp": "00:35:01", "text": "ポイント。でも、ええと、木曜日には"}, {"type": "chat", "time": 2103.241, "timestamp": "00:35:03", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "dang i cant keep track of days anymore"}, {"type": "subtitle", "time": 2104.95, "timestamp": "00:35:04", "text": "空き枠。私はまだ"}, {"type": "subtitle", "time": 2108.87, "timestamp": "00:35:08", "text": "保留中の人々に連絡を取り、"}, {"type": "subtitle", "time": 2111.349, "timestamp": "00:35:11", "text": "ええと、返信のない人たちに連絡を取りました。私"}, {"type": "subtitle", "time": 2114.47, "timestamp": "00:35:14", "text": "ここに人を追加する必要があるし、"}, {"type": "subtitle", "time": 2116.79, "timestamp": "00:35:16", "text": "人々にも働きかけましょう。あります"}, {"type": "subtitle", "time": 2118.55, "timestamp": "00:35:18", "text": "同意してくれた人は少なかったので、"}, {"type": "subtitle", "time": 2128.23, "timestamp": "00:35:28", "text": "ええ、もちろんです。うん。えっと、でも私は自由です"}, {"type": "subtitle", "time": 2133.589, "timestamp": "00:35:33", "text": "21日までだが、2週目の週"}, {"type": "subtitle", "time": 2136.55, "timestamp": "00:35:36", "text": "12歳から"}, {"type": "subtitle", "time": 2139.27, "timestamp": "00:35:39", "text": "えーと、3週目か4週目の終わり"}, {"type": "subtitle", "time": 2141.829, "timestamp": "00:35:41", "text": "6月、終わりまでに"}, {"type": "subtitle", "time": 2144.39, "timestamp": "00:35:44", "text": "6月はまだ試験があるので、"}, {"type": "subtitle", "time": 2150.23, "timestamp": "00:35:50", "text": "残念ながら、夜の保護者会の時間帯にやってください。"}, {"type": "subtitle", "time": 2154.71, "timestamp": "00:35:54", "text": "試験の日程によりますね"}, {"type": "subtitle", "time": 2157.27, "timestamp": "00:35:57", "text": "えっと、待って、私が置いたの覚えがあるんだけど"}, {"type": "subtitle", "time": 2159.19, "timestamp": "00:35:59", "text": "試験関連のものはこちらです。どこですか？どこ"}]
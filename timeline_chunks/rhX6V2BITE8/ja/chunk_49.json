[{"type": "subtitle", "time": 2941.71, "timestamp": "00:49:01", "text": "ニコサンとして"}, {"type": "subtitle", "time": 2946.15, "timestamp": "00:49:06", "text": "良い。私はニコサンのタイミングを知っていました。私"}, {"type": "subtitle", "time": 2948.71, "timestamp": "00:49:08", "text": "それも手に入れなきゃ。クレメンシは"}, {"type": "subtitle", "time": 2950.71, "timestamp": "00:49:10", "text": "興味がある。だから、私は"}, {"type": "subtitle", "time": 2956.109, "timestamp": "00:49:16", "text": "恩赦。恩赦は"}, {"type": "subtitle", "time": 2960.71, "timestamp": "00:49:20", "text": "えっと、8時半はどうですか？はい、もちろんです。わかった。"}, {"type": "subtitle", "time": 2964.39, "timestamp": "00:49:24", "text": "赤村さんは8時30分に出演を確定しています。だから私は"}, {"type": "subtitle", "time": 2966.829, "timestamp": "00:49:26", "text": "ここに掲載します。"}, {"type": "subtitle", "time": 2971.51, "timestamp": "00:49:31", "text": "8時30分。わかった。クレメンスはどうですか？私はあなた"}, {"type": "subtitle", "time": 2973.829, "timestamp": "00:49:33", "text": "知ってるよ、面白いことに今朝私は"}, {"type": "subtitle", "time": 2976.069, "timestamp": "00:49:36", "text": "15人を再始動し、昨日"}, {"type": "subtitle", "time": 2979.51, "timestamp": "00:49:39", "text": "今夜、私はこれを再開します。7人です。"}, {"type": "subtitle", "time": 2982.069, "timestamp": "00:49:42", "text": "リストは増え続けている。もし私が"}, {"type": "subtitle", "time": 2985.03, "timestamp": "00:49:45", "text": "全員を参加させることはできません。この時点で、私は"}, {"type": "subtitle", "time": 2993.79, "timestamp": "00:49:53", "text": "兄弟。わかった。"}, {"type": "subtitle", "time": 2998.03, "timestamp": "00:49:58", "text": "えっと、クレメントのシーズンは午後9時10分以降です。"}]
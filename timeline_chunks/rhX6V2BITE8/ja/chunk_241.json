[{"type": "subtitle", "time": 14462.6, "timestamp": "04:01:02", "text": "待って。私は上がる。 わかった。ああ、この戦術。"}, {"type": "subtitle", "time": 14470.55, "timestamp": "04:01:10", "text": "それでは、こんにちは。"}, {"type": "subtitle", "time": 14473.67, "timestamp": "04:01:13", "text": "ああ、もう。私の話を聞いてください、おじさん。"}, {"type": "subtitle", "time": 14476.15, "timestamp": "04:01:16", "text": "わかった。ええ、ぜひ聞かせてください。それは"}, {"type": "subtitle", "time": 14480.63, "timestamp": "04:01:20", "text": "プライド、偏見、"}, {"type": "subtitle", "time": 14485.269, "timestamp": "04:01:25", "text": "戦争と平和。それは昔の"}, {"type": "subtitle", "time": 14489.07, "timestamp": "04:01:29", "text": "まだあなたが"}, {"type": "subtitle", "time": 14498.349, "timestamp": "04:01:38", "text": "だった"}, {"type": "subtitle", "time": 14504.87, "timestamp": "04:01:44", "text": "何か。ああ、彼はリストから外されている。わかった、いとこ"}, {"type": "subtitle", "time": 14508.75, "timestamp": "04:01:48", "text": "たくさん鼻から吸い込んで"}]
[{"type": "subtitle", "time": 11821.55, "timestamp": "03:17:01", "text": "白いシャツまたは"}, {"type": "subtitle", "time": 11824.83, "timestamp": "03:17:04", "text": "何か。その人物は現在行方不明です。"}, {"type": "subtitle", "time": 11826.83, "timestamp": "03:17:06", "text": "おお。"}, {"type": "subtitle", "time": 11836.19, "timestamp": "03:17:16", "text": "外。ああ、大変だ。気分が悪い"}, {"type": "subtitle", "time": 11851.229, "timestamp": "03:17:31", "text": "何か？ああ、あれらもある"}, {"type": "subtitle", "time": 11855.55, "timestamp": "03:17:35", "text": "えっと、あの大きな黄色いやつ"}, {"type": "subtitle", "time": 11859.269, "timestamp": "03:17:39", "text": "向かっている途中です。あ、言い忘れてた"}, {"type": "subtitle", "time": 11861.269, "timestamp": "03:17:41", "text": "あなた。持っていないなら、見つけて"}, {"type": "subtitle", "time": 11863.11, "timestamp": "03:17:43", "text": "武器をいくつか用意しなさい。ああ、こんにちは。"}, {"type": "subtitle", "time": 11865.349, "timestamp": "03:17:45", "text": "見捨てられた者たち。"}, {"type": "subtitle", "time": 11866.469, "timestamp": "03:17:46", "text": "え、何？"}, {"type": "subtitle", "time": 11869.349, "timestamp": "03:17:49", "text": "あなたはこれを私に伝えるのを忘れていました。まあ、彼らは"}, {"type": "subtitle", "time": 11874.229, "timestamp": "03:17:54", "text": "全く重要ではなかった。クソッ"}, {"type": "subtitle", "time": 11875.79, "timestamp": "03:17:55", "text": "構造なし、"}, {"type": "subtitle", "time": 11879.59, "timestamp": "03:17:59", "text": "ビジネスはありません。"}]
[{"type": "subtitle", "time": 16441.789, "timestamp": "04:34:01", "text": "クソパワーは"}, {"type": "subtitle", "time": 16444.47, "timestamp": "04:34:04", "text": "オフライン。ジャジール、こちらはクレーンです。走った"}, {"type": "subtitle", "time": 16445.91, "timestamp": "04:34:05", "text": "かなり安全な場所を越えて"}, {"type": "subtitle", "time": 16447.349, "timestamp": "04:34:07", "text": "場所だが、電源が取れない"}, {"type": "subtitle", "time": 16449.91, "timestamp": "04:34:09", "text": "来て。何か理由が分かりますか？はい、しかしそれは"}, {"type": "subtitle", "time": 16452.31, "timestamp": "04:34:12", "text": "長くなるし、私は電気技師じゃないから。"}, {"type": "subtitle", "time": 16453.99, "timestamp": "04:34:13", "text": "バルに聞くのが一番いいよ、"}, {"type": "subtitle", "time": 16457.91, "timestamp": "04:34:17", "text": "整備士さん、詳細について。"}, {"type": "subtitle", "time": 16464.109, "timestamp": "04:34:24", "text": "人々に"}, {"type": "subtitle", "time": 16466.69, "timestamp": "04:34:26", "text": "追跡。はい、できます。"}, {"type": "subtitle", "time": 16468.029, "timestamp": "04:34:28", "text": "[音楽]"}, {"type": "subtitle", "time": 16471.869, "timestamp": "04:34:31", "text": "後で。なぜゾンビがいるのか"}, {"type": "subtitle", "time": 16475.39, "timestamp": "04:34:35", "text": "ここ？だから私はセーブハウスを使います、"}, {"type": "subtitle", "time": 16478.869, "timestamp": "04:34:38", "text": "はぁ？これらがクエストのようなものだなんて信じられない"}, {"type": "subtitle", "time": 16480.81, "timestamp": "04:34:40", "text": "また。もっと"}, {"type": "subtitle", "time": 16490.83, "timestamp": "04:34:50", "text": "クエストも"}, {"type": "subtitle", "time": 16497.39, "timestamp": "04:34:57", "text": "最後。うん。"}]
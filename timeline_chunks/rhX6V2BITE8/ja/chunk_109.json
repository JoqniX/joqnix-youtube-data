[{"type": "subtitle", "time": 6543.629, "timestamp": "01:49:03", "text": "お金とか色々、委託するつもり"}, {"type": "subtitle", "time": 6546.709, "timestamp": "01:49:06", "text": "手助けしてくれる人や物。私は感じます"}, {"type": "subtitle", "time": 6548.55, "timestamp": "01:49:08", "text": "これらのものはすべて本当に大きい"}, {"type": "subtitle", "time": 6551.83, "timestamp": "01:49:11", "text": "もの。それをするにはたくさんの人が必要です"}, {"type": "subtitle", "time": 6558.87, "timestamp": "01:49:18", "text": "痛み。でも、まあ、ワンセシアみたいな感じかな"}, {"type": "subtitle", "time": 6561.51, "timestamp": "01:49:21", "text": "もの。変換して"}, {"type": "subtitle", "time": 6564.149, "timestamp": "01:49:24", "text": "小さなメジャー、マイナーな部分、部分"}, {"type": "subtitle", "time": 6565.229, "timestamp": "01:49:25", "text": "の"}, {"type": "subtitle", "time": 6572.75, "timestamp": "01:49:32", "text": "あれ。"}, {"type": "subtitle", "time": 6575.91, "timestamp": "01:49:35", "text": "ええ、そうですね。手伝ってくれてありがとう。"}, {"type": "subtitle", "time": 6589.39, "timestamp": "01:49:49", "text": "どこ"}]
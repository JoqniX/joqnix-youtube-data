[{"type": "subtitle", "time": 13561.71, "timestamp": "03:46:01", "text": "私はこの任務に失敗すると思う。"}, {"type": "subtitle", "time": 13572.269, "timestamp": "03:46:12", "text": "男。ああ、私は"}, {"type": "subtitle", "time": 13583.75, "timestamp": "03:46:23", "text": "主。いいえ、私が運転する予定でした。私"}, {"type": "subtitle", "time": 13586.71, "timestamp": "03:46:26", "text": "これは選挙運動ではないことを忘れていた。"}, {"type": "subtitle", "time": 13592.309, "timestamp": "03:46:32", "text": "キャンプでは、歩き回ったり散策したりできます"}, {"type": "subtitle", "time": 13597.469, "timestamp": "03:46:37", "text": "などなど。このDLCでは、"}, {"type": "subtitle", "time": 13601.04, "timestamp": "03:46:41", "text": "実際に"}, {"type": "subtitle", "time": 13609.469, "timestamp": "03:46:49", "text": "ドライブ。何てことだ。私は作らないと思います"}, {"type": "subtitle", "time": 13613.75, "timestamp": "03:46:53", "text": "それ。ああ、無理だろうな。 47秒"}]
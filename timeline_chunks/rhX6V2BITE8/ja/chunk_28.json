[{"type": "subtitle", "time": 1694.95, "timestamp": "00:28:14", "text": "そして、私がスカベンジャーの中にいたとき、"}, {"type": "subtitle", "time": 1697.909, "timestamp": "00:28:17", "text": "宝探しゲームをしている間、私は"}, {"type": "subtitle", "time": 1698.909, "timestamp": "00:28:18", "text": "あれ"}, {"type": "subtitle", "time": 1701.669, "timestamp": "00:28:21", "text": "新しい人と出会うこと、そして"}, {"type": "subtitle", "time": 1703.83, "timestamp": "00:28:23", "text": "人々と再び繋がることで、私は"}, {"type": "subtitle", "time": 1706.95, "timestamp": "00:28:26", "text": "私自身が使えるものがたくさん"}, {"type": "subtitle", "time": 1710.07, "timestamp": "00:28:30", "text": "サーバーやその他"}, {"type": "subtitle", "time": 1719.35, "timestamp": "00:28:39", "text": "私も同じ問題を抱えているので参加しました。えっと"}, {"type": "subtitle", "time": 1721.59, "timestamp": "00:28:41", "text": "私のサーバーではGFXボットがやって来ます"}, {"type": "subtitle", "time": 1725.35, "timestamp": "00:28:45", "text": "ランダムに人にDMを送ったり、その他いろいろ。"}, {"type": "subtitle", "time": 1728.789, "timestamp": "00:28:48", "text": "私は、それら全てを禁止する方法を思いついた"}, {"type": "subtitle", "time": 1730.909, "timestamp": "00:28:50", "text": "サーバールールがある場合、"}, {"type": "subtitle", "time": 1736.83, "timestamp": "00:28:56", "text": "皆を善のために助ける。うん。"}, {"type": "subtitle", "time": 1739.549, "timestamp": "00:28:59", "text": "えーと、どうやって強制を実装するか"}]
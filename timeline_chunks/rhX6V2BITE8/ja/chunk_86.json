[{"type": "subtitle", "time": 5161.99, "timestamp": "01:26:01", "text": "尿路感染症。なぜ私が使っているのかわかりませんが、私は"}, {"type": "subtitle", "time": 5168.75, "timestamp": "01:26:08", "text": "このアプリケーションは、私の、えーと、私は以前"}, {"type": "subtitle", "time": 5187.149, "timestamp": "01:26:27", "text": "すべてごめんなさい、私はすべて使います"}, {"type": "subtitle", "time": 5191.149, "timestamp": "01:26:31", "text": "つまり、どうやって示せばいいか"}, {"type": "subtitle", "time": 5192.83, "timestamp": "01:26:32", "text": "これ？"}, {"type": "subtitle", "time": 5203.95, "timestamp": "01:26:43", "text": "こんなの見せちゃダメだよ、兄弟。どのように表示すればよいですか"}, {"type": "subtitle", "time": 5208.51, "timestamp": "01:26:48", "text": "これ？このアプリでは許可されていません"}]
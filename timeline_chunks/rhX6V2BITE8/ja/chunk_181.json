[{"type": "subtitle", "time": 10862.269, "timestamp": "03:01:02", "text": "より長く。雨が降ってるけど、行こう。私はそれが好きです"}, {"type": "subtitle", "time": 10864.95, "timestamp": "03:01:04", "text": "長さ。わーい。"}, {"type": "subtitle", "time": 10867.83, "timestamp": "03:01:07", "text": "近寄るな。近寄るな。あなたはしない"}, {"type": "subtitle", "time": 10871.99, "timestamp": "03:01:11", "text": "理解する。母親。母親。"}, {"type": "subtitle", "time": 10878.03, "timestamp": "03:01:18", "text": "母親。の母親"}, {"type": "subtitle", "time": 10893.51, "timestamp": "03:01:33", "text": "何？田舎。私たちのランナーは"}, {"type": "subtitle", "time": 10897.51, "timestamp": "03:01:37", "text": "重傷を負い錯乱状態にある男が"}, {"type": "subtitle", "time": 10900.23, "timestamp": "03:01:40", "text": "ウイルスに対する免疫を持つ人々について。彼は"}, {"type": "subtitle", "time": 10904.23, "timestamp": "03:01:44", "text": "ハランからの脱出経路を示す地図。そこには"}, {"type": "subtitle", "time": 10906.469, "timestamp": "03:01:46", "text": "ここでは病人がますます増えている。ない"}, {"type": "subtitle", "time": 10909.83, "timestamp": "03:01:49", "text": "もう十分だ、アンダーソン。そしてカムデンの研究"}, {"type": "subtitle", "time": 10912.309, "timestamp": "03:01:52", "text": "まだ実がなっていません。私たちは"}, {"type": "subtitle", "time": 10915.15, "timestamp": "03:01:55", "text": "すべての手がかりを確認する。こんにちは。"}, {"type": "subtitle", "time": 10917.83, "timestamp": "03:01:57", "text": "行く。武器とかは持ってるかな？私"}]
[{"type": "subtitle", "time": 3125.75, "timestamp": "00:52:05", "text": "これ？彼は実際に手に入れた人です"}, {"type": "subtitle", "time": 3128.87, "timestamp": "00:52:08", "text": "内向的な私を解放する。内向的ではない"}, {"type": "subtitle", "time": 3130.549, "timestamp": "00:52:10", "text": "誰もいない時に閉じ込められたような感じ"}, {"type": "subtitle", "time": 3133.109, "timestamp": "00:52:13", "text": "ほら、私を外に出して、"}, {"type": "subtitle", "time": 3135.349, "timestamp": "00:52:15", "text": "部屋から追い出されて、何もかもダメになった。の"}, {"type": "subtitle", "time": 3137.27, "timestamp": "00:52:17", "text": "生意気な奴だけがこう言った。"}, {"type": "subtitle", "time": 3139.829, "timestamp": "00:52:19", "text": "「ああ、出てこい。お前を連れて行くから"}, {"type": "subtitle", "time": 3142.79, "timestamp": "00:52:22", "text": "映画。ランチに連れて行って"}, {"type": "subtitle", "time": 3145.03, "timestamp": "00:52:25", "text": "すべて。\""}, {"type": "subtitle", "time": 3149.47, "timestamp": "00:52:29", "text": "とても気持ちが良かったので、"}, {"type": "subtitle", "time": 3154.39, "timestamp": "00:52:34", "text": "映画とかに行く長い私"}, {"type": "subtitle", "time": 3157.75, "timestamp": "00:52:37", "text": "私が信頼している人であり、私を友人にしてくれた人"}, {"type": "subtitle", "time": 3160.47, "timestamp": "00:52:40", "text": "幸せを感じるし、彼が"}, {"type": "subtitle", "time": 3163.67, "timestamp": "00:52:43", "text": "彼は今ドバイにいて、世話をすることができない"}, {"type": "subtitle", "time": 3166.23, "timestamp": "00:52:46", "text": "私と彼らとは一緒に遊べない"}, {"type": "subtitle", "time": 3168.549, "timestamp": "00:52:48", "text": "もう今はそうではないけれど、電話したりはするよ。私たちは"}, {"type": "subtitle", "time": 3170.47, "timestamp": "00:52:50", "text": "これまで一度も電話や会話ができなかった"}, {"type": "subtitle", "time": 3173.19, "timestamp": "00:52:53", "text": "ジョアトンに集中して以来"}, {"type": "subtitle", "time": 3175.75, "timestamp": "00:52:55", "text": "3月12日。ストリーミングを始めましたが、"}, {"type": "subtitle", "time": 3177.589, "timestamp": "00:52:57", "text": "24時間ずっとストリーミング配信している"}]
[{"type": "subtitle", "time": 7281.31, "timestamp": "02:01:21", "text": "男の子。ああ、ちゃんと動作するよ。"}, {"type": "subtitle", "time": 7285.07, "timestamp": "02:01:25", "text": "ニース。私はそれに集中します"}, {"type": "subtitle", "time": 7289.43, "timestamp": "02:01:29", "text": "後で。パキスタンが"}, {"type": "subtitle", "time": 7290.99, "timestamp": "02:01:30", "text": "次のような"}, {"type": "subtitle", "time": 7314.75, "timestamp": "02:01:54", "text": "彼ら。"}]
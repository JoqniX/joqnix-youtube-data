[{"type": "subtitle", "time": 6198.709, "timestamp": "01:43:18", "text": "タキサ、私はこれが欲しいの"}, {"type": "subtitle", "time": 6200.79, "timestamp": "01:43:20", "text": "そういう感じですよね？私が持っているものは"}, {"type": "subtitle", "time": 6206.95, "timestamp": "01:43:26", "text": "えっと、私のウェブサイトにはこんなものもあるんです"}, {"type": "subtitle", "time": 6207.87, "timestamp": "01:43:27", "text": "これら"}, {"type": "subtitle", "time": 6217.27, "timestamp": "01:43:37", "text": "最低限のシステムを構築したい。私たちは"}, {"type": "subtitle", "time": 6219.03, "timestamp": "01:43:39", "text": "文字通り構築している"}, {"type": "subtitle", "time": 6223.669, "timestamp": "01:43:43", "text": "今は最低限の設備しかない。でも私は"}, {"type": "subtitle", "time": 6226.55, "timestamp": "01:43:46", "text": "将来的に理想的には、"}, {"type": "subtitle", "time": 6228.229, "timestamp": "01:43:48", "text": "モバイルアプリ。"}, {"type": "subtitle", "time": 6229.95, "timestamp": "01:43:49", "text": "入手できる場所"}, {"type": "subtitle", "time": 6233.709, "timestamp": "01:43:53", "text": "私の情報、ストリームに関するすべて"}, {"type": "subtitle", "time": 6238.07, "timestamp": "01:43:58", "text": "最新情報、ライブアップデート。文字通り私はできる"}, {"type": "subtitle", "time": 6239.39, "timestamp": "01:43:59", "text": "役職"}]
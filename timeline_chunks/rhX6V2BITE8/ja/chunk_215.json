[{"type": "subtitle", "time": 12910.229, "timestamp": "03:35:10", "text": "真の貴族。あなたは言う、"}, {"type": "subtitle", "time": 12913.429, "timestamp": "03:35:13", "text": "お前はこれで死ぬことになるぞ。"}, {"type": "subtitle", "time": 12915.11, "timestamp": "03:35:15", "text": "いや、待って。ちょっと待って。ちょっと待って。病気"}, {"type": "subtitle", "time": 12922.55, "timestamp": "03:35:22", "text": "私のパークでの腕前を知っていれば、待っていてくれて構わないよ。"}, {"type": "subtitle", "time": 12924.269, "timestamp": "03:35:24", "text": "バカ、忘れてるよ"}]
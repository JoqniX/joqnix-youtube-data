[{"type": "subtitle", "time": 1865.31, "timestamp": "00:31:05", "text": "で"}, {"type": "subtitle", "time": 1867.87, "timestamp": "00:31:07", "text": "すぐに確認しに来ました。ああ、そうだね。うん。"}, {"type": "subtitle", "time": 1871.75, "timestamp": "00:31:11", "text": "うん。お越しいただきありがとうございます。うん。私"}, {"type": "subtitle", "time": 1873.83, "timestamp": "00:31:13", "text": "私はすべてのことを考えていた"}, {"type": "subtitle", "time": 1876.87, "timestamp": "00:31:16", "text": "私が周りで見かけたり話したりした人たち"}, {"type": "subtitle", "time": 1882.19, "timestamp": "00:31:22", "text": "などなど。いいえ。それで私は待って"}, {"type": "subtitle", "time": 1885.269, "timestamp": "00:31:25", "text": "以前にあなたとやり取りしたことがあります"}, {"type": "subtitle", "time": 1889.19, "timestamp": "00:31:29", "text": "あなたはINVのYouTuberの一人でした"}, {"type": "subtitle", "time": 1891.83, "timestamp": "00:31:31", "text": "えっと、探していたら見つけたんです"}, {"type": "subtitle", "time": 1894.549, "timestamp": "00:31:34", "text": "インド人は新しいユーチューバーを知っていた"}, {"type": "subtitle", "time": 1898.75, "timestamp": "00:31:38", "text": "日中と"}, {"type": "subtitle", "time": 1904.23, "timestamp": "00:31:44", "text": "ああ、覚えてるよ、君を見かけたことあるよ"}, {"type": "subtitle", "time": 1907.669, "timestamp": "00:31:47", "text": "えっと、他のユーチューバーのスペースとかで。"}, {"type": "subtitle", "time": 1910.07, "timestamp": "00:31:50", "text": "だから私は「うん、話すべきだね」と思った。"}, {"type": "chat", "time": 1912.289, "timestamp": "00:31:52", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "joq"}, {"type": "subtitle", "time": 1912.95, "timestamp": "00:31:52", "text": "あなたとその他諸々。」私は私たちが"}, {"type": "chat", "time": 1914.783, "timestamp": "00:31:54", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "joq"}, {"type": "subtitle", "time": 1915.669, "timestamp": "00:31:55", "text": "一度話した。覚えていますか"}, {"type": "chat", "time": 1918.096, "timestamp": "00:31:58", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "joq"}]
[{"type": "subtitle", "time": 15614.189, "timestamp": "04:20:14", "text": "死んだ。ああ、なんてことだ、私は死んだ。"}, {"type": "subtitle", "time": 15618.71, "timestamp": "04:20:18", "text": "ああ、私は健康ではなかった。アイテム。いいえ、私は"}, {"type": "subtitle", "time": 15622.55, "timestamp": "04:20:22", "text": "健康をたくさん買うために必要"}, {"type": "subtitle", "time": 15628.51, "timestamp": "04:20:28", "text": "キット。よし、救急キットを作ろう"}, {"type": "subtitle", "time": 15632.59, "timestamp": "04:20:32", "text": "それから。では、"}, {"type": "subtitle", "time": 15635.189, "timestamp": "04:20:35", "text": "彼らがあなたに近づいてくるのを止めたり、"}, {"type": "subtitle", "time": 15643.63, "timestamp": "04:20:43", "text": "でも、それはとても痛い"}, {"type": "subtitle", "time": 15649.95, "timestamp": "04:20:49", "text": "わかった、どこが"}]
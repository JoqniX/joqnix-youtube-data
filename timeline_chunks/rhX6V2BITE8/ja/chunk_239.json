[{"type": "subtitle", "time": 14341.51, "timestamp": "03:59:01", "text": "彼らと一緒にそちらを見た。もし破壊するなら"}, {"type": "subtitle", "time": 14344.349, "timestamp": "03:59:04", "text": "それらを減らすと、"}, {"type": "subtitle", "time": 14348.95, "timestamp": "03:59:08", "text": "変動性のない変動性の人口と"}, {"type": "subtitle", "time": 14351.51, "timestamp": "03:59:11", "text": "あなた自身とあなたの両方の安全のために夜をより安全に"}, {"type": "subtitle", "time": 14354.87, "timestamp": "03:59:14", "text": "そして地元の人々。ただし、山積みの山には注意が必要です。"}, {"type": "subtitle", "time": 14357.91, "timestamp": "03:59:17", "text": "日中は変化に満ちている。だから、"}, {"type": "subtitle", "time": 14360.67, "timestamp": "03:59:20", "text": "ベストなので、"}, {"type": "subtitle", "time": 14363.99, "timestamp": "03:59:23", "text": "成功するには右派を攻撃するしかない。おお"}, {"type": "subtitle", "time": 14368.15, "timestamp": "03:59:28", "text": "ああ、どうして私はあくびをしているんだろう？何てことだ。おお、"}, {"type": "subtitle", "time": 14371.36, "timestamp": "03:59:31", "text": "なぜ私はあくびをしているのだろう？"}, {"type": "subtitle", "time": 14372.67, "timestamp": "03:59:32", "text": "[音楽]"}, {"type": "subtitle", "time": 14384.189, "timestamp": "03:59:44", "text": "それ。そこには"}]
[{"type": "subtitle", "time": 14641.87, "timestamp": "04:04:01", "text": "球。"}, {"type": "subtitle", "time": 14646.11, "timestamp": "04:04:06", "text": "好的。我有很多钱"}, {"type": "subtitle", "time": 14659.83, "timestamp": "04:04:19", "text": "莉娜，你能听到我说话吗？莉娜飞机，是"}, {"type": "subtitle", "time": 14663.269, "timestamp": "04:04:23", "text": "你还好吗？这是怎么回事？发生了什么事"}, {"type": "subtitle", "time": 14666.59, "timestamp": "04:04:26", "text": "在？你告诉我。在哪里？"}, {"type": "subtitle", "time": 14687.67, "timestamp": "04:04:47", "text": "魅力。呃，我想查看一下空间。"}, {"type": "subtitle", "time": 14689.75, "timestamp": "04:04:49", "text": "滚筒。实际上，你把我们都算进去了。"}, {"type": "subtitle", "time": 14691.91, "timestamp": "04:04:51", "text": "担心。我很好。不用担心。它"}, {"type": "subtitle", "time": 14697.91, "timestamp": "04:04:57", "text": "这样如何？你的病人是对的。"}, {"type": "subtitle", "time": 14699.99, "timestamp": "04:04:59", "text": "这里有这么一群人，还有所有"}]
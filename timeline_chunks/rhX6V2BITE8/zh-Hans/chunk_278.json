[{"type": "subtitle", "time": 16686.75, "timestamp": "04:38:06", "text": "我现在很困惑，对吧？"}, {"type": "subtitle", "time": 16693.629, "timestamp": "04:38:13", "text": "哦，这个人。"}, {"type": "subtitle", "time": 16698.23, "timestamp": "04:38:18", "text": "好的。不。我为什么跳过跑步？不，切。"}, {"type": "subtitle", "time": 16700.47, "timestamp": "04:38:20", "text": "我为什么跳过了？"}, {"type": "subtitle", "time": 16702.23, "timestamp": "04:38:22", "text": "那你就应该庆幸自己在和他们交谈。"}, {"type": "subtitle", "time": 16704.07, "timestamp": "04:38:24", "text": "我。好的，没问题。没关系。它是"}, {"type": "subtitle", "time": 16705.75, "timestamp": "04:38:25", "text": "美好的。没关系。这将是一段漫长的车程。"}, {"type": "subtitle", "time": 16707.83, "timestamp": "04:38:27", "text": "但我敢用我的左手打赌，它肯定值钱。"}, {"type": "subtitle", "time": 16711.51, "timestamp": "04:38:31", "text": "它。好的，开始吧。我不小心把它给了它"}, {"type": "subtitle", "time": 16713.75, "timestamp": "04:38:33", "text": "简单浏览一下，看看有没有有用的信息。"}, {"type": "subtitle", "time": 16717.07, "timestamp": "04:38:37", "text": "零件，把它们带给我。"}, {"type": "subtitle", "time": 16721.15, "timestamp": "04:38:41", "text": "好的。奖励性喷漆工作。好的。"}, {"type": "subtitle", "time": 16724.869, "timestamp": "04:38:44", "text": "呃，好的。任何。呃，我只是想"}, {"type": "subtitle", "time": 16727.83, "timestamp": "04:38:47", "text": "能够储蓄。是的，你可以保存"}, {"type": "subtitle", "time": 16739.31, "timestamp": "04:38:59", "text": "就是今晚，对吧？我们这样做"}]
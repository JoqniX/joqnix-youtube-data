[{"type": "subtitle", "time": 21000.76, "timestamp": "05:50:00", "text": "你。很高兴见到你 你。那里有个……呃……那里有个足球。"}, {"type": "subtitle", "time": 21004.0, "timestamp": "05:50:04", "text": "你。那里有个……呃……那里有个足球。 我要去拿"}, {"type": "subtitle", "time": 21005.958, "timestamp": "05:50:05", "text": "我要去拿 足球。我的天啊。确实存在"}, {"type": "subtitle", "time": 21008.32, "timestamp": "05:50:08", "text": "足球。我的天啊。确实存在 这场比赛中的足球。"}, {"type": "subtitle", "time": 21023.31, "timestamp": "05:50:23", "text": "别再射你了。"}, {"type": "subtitle", "time": 21026.19, "timestamp": "05:50:26", "text": "他妈的。这很有趣。"}, {"type": "subtitle", "time": 21029.59, "timestamp": "05:50:29", "text": "啊，比赛怎么样？它既有趣又恐怖"}, {"type": "subtitle", "time": 21037.31, "timestamp": "05:50:37", "text": "乐趣。我希望你能明白，我会努力的。"}, {"type": "subtitle", "time": 21040.23, "timestamp": "05:50:40", "text": "那。但我们赢得了第一场比赛。我赢了。"}, {"type": "subtitle", "time": 21043.11, "timestamp": "05:50:43", "text": "不，上一局我赢了。我的第一款游戏"}, {"type": "subtitle", "time": 21046.59, "timestamp": "05:50:46", "text": "我排队等候。我居然赢了"}, {"type": "subtitle", "time": 21054.75, "timestamp": "05:50:54", "text": "方式。决不。迪奥，但我其实"}, {"type": "subtitle", "time": 21058.03, "timestamp": "05:50:58", "text": "以压倒性优势获胜。好的。"}]
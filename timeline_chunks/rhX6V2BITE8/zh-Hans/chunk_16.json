[{"type": "subtitle", "time": 963.43, "timestamp": "00:16:03", "text": "做个擦拭检查之类的，这样它们就可以……"}, {"type": "subtitle", "time": 965.55, "timestamp": "00:16:05", "text": "与我相处融洽"}, {"type": "subtitle", "time": 967.55, "timestamp": "00:16:07", "text": "东西。"}, {"type": "subtitle", "time": 972.99, "timestamp": "00:16:12", "text": "事情不是这样吗？"}, {"type": "subtitle", "time": 997.509, "timestamp": "00:16:37", "text": "未打开。显然人们正在搬到"}, {"type": "subtitle", "time": 1000.949, "timestamp": "00:16:40", "text": "顺便一提，踢一下。大家都走了"}, {"type": "subtitle", "time": 1004.55, "timestamp": "00:16:44", "text": "顺便踢一下。所以我觉得我"}, {"type": "subtitle", "time": 1007.91, "timestamp": "00:16:47", "text": "需要专注于我的踢球观众，"}, {"type": "subtitle", "time": 1010.629, "timestamp": "00:16:50", "text": "踢踢观众。"}, {"type": "subtitle", "time": 1014.15, "timestamp": "00:16:54", "text": "嗯，给他们一些类似的东西。"}, {"type": "subtitle", "time": 1017.99, "timestamp": "00:16:57", "text": "瞬间踢击并非我作品的一部分"}]
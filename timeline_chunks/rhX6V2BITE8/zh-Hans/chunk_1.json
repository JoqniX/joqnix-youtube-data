[{"type": "subtitle", "time": 62.549, "timestamp": "00:01:02", "text": "投掷。我知道。我取消了吗？"}, {"type": "subtitle", "time": 64.27, "timestamp": "00:01:04", "text": "城堡订阅"}, {"type": "subtitle", "time": 74.63, "timestamp": "00:01:14", "text": "当然。我已经用了一段时间了。"}, {"type": "subtitle", "time": 77.83, "timestamp": "00:01:17", "text": "不是。我的天哪，我完全"}, {"type": "subtitle", "time": 81.35, "timestamp": "00:01:21", "text": "都忘了它的存在了。"}, {"type": "subtitle", "time": 88.19, "timestamp": "00:01:28", "text": "[音乐]"}, {"type": "subtitle", "time": 104.03, "timestamp": "00:01:44", "text": "呃，我希望我能直播到"}, {"type": "subtitle", "time": 108.789, "timestamp": "00:01:48", "text": "相信。我非常想念那个地方。"}, {"type": "subtitle", "time": 111.429, "timestamp": "00:01:51", "text": "虽然我有一个中国油管博主"}]
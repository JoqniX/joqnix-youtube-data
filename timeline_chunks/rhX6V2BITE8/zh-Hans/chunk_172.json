[{"type": "subtitle", "time": 10320.67, "timestamp": "02:52:00", "text": "将演奏《垂死》"}, {"type": "subtitle", "time": 10323.83, "timestamp": "02:52:03", "text": "光。呃，这是第四个直播流。"}, {"type": "subtitle", "time": 10326.389, "timestamp": "02:52:06", "text": "消逝的光芒。所以，我们就这样结束了。"}, {"type": "subtitle", "time": 10329.19, "timestamp": "02:52:09", "text": "你看，我们完成了，我们彻底完成了。"}, {"type": "subtitle", "time": 10331.91, "timestamp": "02:52:11", "text": "活动。这边几乎是百分之百。"}, {"type": "subtitle", "time": 10333.07, "timestamp": "02:52:13", "text": "故事是"}, {"type": "subtitle", "time": 10336.389, "timestamp": "02:52:16", "text": "完毕。我当时就像在玩……"}, {"type": "subtitle", "time": 10339.59, "timestamp": "02:52:19", "text": "我相信Vick会参与合作。"}, {"type": "subtitle", "time": 10342.389, "timestamp": "02:52:22", "text": "合作的前沿。正如莎莎所说"}, {"type": "subtitle", "time": 10344.95, "timestamp": "02:52:24", "text": "这边。是的。是的。是的。所以今天"}, {"type": "subtitle", "time": 10348.83, "timestamp": "02:52:28", "text": "我们将游玩以下DLC。"}, {"type": "subtitle", "time": 10351.63, "timestamp": "02:52:31", "text": "你好。今天我们将演奏以下曲目"}, {"type": "subtitle", "time": 10355.429, "timestamp": "02:52:35", "text": "DLC。我很期待接下来的发展。"}, {"type": "subtitle", "time": 10358.15, "timestamp": "02:52:38", "text": "游戏流程将会是。希望你们一切顺利"}, {"type": "subtitle", "time": 10362.07, "timestamp": "02:52:42", "text": "一如既往，一切都很好。嗯，做"}, {"type": "subtitle", "time": 10364.95, "timestamp": "02:52:44", "text": "一定要注意补充水分之类的。好的。"}, {"type": "subtitle", "time": 10367.349, "timestamp": "02:52:47", "text": "记得喝点水。"}, {"type": "subtitle", "time": 10370.95, "timestamp": "02:52:50", "text": "还没有。呃，今天是星期天，"}, {"type": "subtitle", "time": 10373.429, "timestamp": "02:52:53", "text": "正确的？今天。是的，今天是星期天。"}, {"type": "subtitle", "time": 10375.19, "timestamp": "02:52:55", "text": "今天是个好日子。实话实说。"}, {"type": "subtitle", "time": 10377.99, "timestamp": "02:52:57", "text": "感觉很愉快"}, {"type": "subtitle", "time": 10379.07, "timestamp": "02:52:59", "text": "早晨"}]
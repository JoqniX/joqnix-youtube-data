[{"type": "subtitle", "time": 12781.83, "timestamp": "03:33:01", "text": "需要重新加载。从侧面进入。"}, {"type": "subtitle", "time": 12792.389, "timestamp": "03:33:12", "text": "[音乐]"}, {"type": "subtitle", "time": 12803.99, "timestamp": "03:33:23", "text": "你好呀。与强盗交谈"}, {"type": "subtitle", "time": 12806.15, "timestamp": "03:33:26", "text": "之后。朋友，你来了。每一个新的"}, {"type": "subtitle", "time": 12812.469, "timestamp": "03:33:32", "text": "阿森，"}, {"type": "subtitle", "time": 12813.83, "timestamp": "03:33:33", "text": "你实际上是在出卖某些东西。"}, {"type": "subtitle", "time": 12816.55, "timestamp": "03:33:36", "text": "这里。水质清澈见底。没有腹泻"}, {"type": "subtitle", "time": 12819.11, "timestamp": "03:33:39", "text": "然后。尝起来像天使的味道"}, {"type": "subtitle", "time": 12820.63, "timestamp": "03:33:40", "text": "你的舌头伸了进来。一"}, {"type": "subtitle", "time": 12824.229, "timestamp": "03:33:44", "text": "一加仑水可以装10磅食物。黄金"}, {"type": "subtitle", "time": 12827.349, "timestamp": "03:33:47", "text": "出色地。 10磅食物换水。什么是"}, {"type": "subtitle", "time": 12828.55, "timestamp": "03:33:48", "text": "你们打算开始对空气收费吗？"}, {"type": "subtitle", "time": 12831.429, "timestamp": "03:33:51", "text": "二？哦，我们找到一个讨价还价的高手了。讨价还价者？"}, {"type": "subtitle", "time": 12834.55, "timestamp": "03:33:54", "text": "往下看，小混蛋。看到了吗？那是"}, {"type": "subtitle", "time": 12837.19, "timestamp": "03:33:57", "text": "罗斯科。我们把讨价还价的人交给他。"}]
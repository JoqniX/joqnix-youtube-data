[{"type": "subtitle", "time": 1202.63, "timestamp": "00:20:02", "text": "这个地方。我感觉自己被困在一个非常紧的地方"}, {"type": "subtitle", "time": 1205.59, "timestamp": "00:20:05", "text": "类似日程安排的东西。有坍塌现象。"}, {"type": "subtitle", "time": 1208.23, "timestamp": "00:20:08", "text": "我睡着了，因为我的身体没机能运转。"}, {"type": "subtitle", "time": 1212.549, "timestamp": "00:20:12", "text": "完全不动之类的。那里"}, {"type": "subtitle", "time": 1214.95, "timestamp": "00:20:14", "text": "好几天我都说不出话来，也说不出话来。"}, {"type": "subtitle", "time": 1218.15, "timestamp": "00:20:18", "text": "话虽如此，我还是设法让自己"}, {"type": "subtitle", "time": 1222.31, "timestamp": "00:20:22", "text": "比如聊天什么的。所以我就想，啊"}, {"type": "subtitle", "time": 1225.19, "timestamp": "00:20:25", "text": "我真的需要挺过这一关，因为"}, {"type": "subtitle", "time": 1233.63, "timestamp": "00:20:33", "text": "我。所以，"}]
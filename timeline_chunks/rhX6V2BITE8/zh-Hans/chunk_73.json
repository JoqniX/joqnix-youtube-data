[{"type": "subtitle", "time": 4382.91, "timestamp": "01:13:02", "text": "是的，这让我很高兴。"}, {"type": "subtitle", "time": 4386.79, "timestamp": "01:13:06", "text": "是的，但我还有很多工作要做。"}, {"type": "subtitle", "time": 4389.83, "timestamp": "01:13:09", "text": "即使现在你遭遇了突袭，你也必须"}, {"type": "subtitle", "time": 4393.27, "timestamp": "01:13:13", "text": "既要有趣又要能转化"}, {"type": "subtitle", "time": 4395.91, "timestamp": "01:13:15", "text": "将他们变成类似观众或实际观众"}, {"type": "subtitle", "time": 4398.149, "timestamp": "01:13:18", "text": "随着时间的推移，或者按照愿望行事，以后再说吧"}, {"type": "subtitle", "time": 4401.59, "timestamp": "01:13:21", "text": "在。潜水者和浏览者，呃，潜水者将会是"}, {"type": "subtitle", "time": 4405.189, "timestamp": "01:13:25", "text": "现在到处都有，甚至在踢球的时候也是如此。"}, {"type": "subtitle", "time": 4407.03, "timestamp": "01:13:27", "text": "现在"}, {"type": "subtitle", "time": 4409.03, "timestamp": "01:13:29", "text": "呃，Kick 和其他平台，它们是"}, {"type": "subtitle", "time": 4411.91, "timestamp": "01:13:31", "text": "潜伏者实际上是潜伏着试图转化他们。"}, {"type": "subtitle", "time": 4415.43, "timestamp": "01:13:35", "text": "变成追随者，或者呃，变成那种人"}, {"type": "subtitle", "time": 4417.35, "timestamp": "01:13:37", "text": "最终订阅或关注您的"}, {"type": "subtitle", "time": 4419.99, "timestamp": "01:13:39", "text": "内容有点难，但必须要做。"}, {"type": "subtitle", "time": 4422.55, "timestamp": "01:13:42", "text": "我确实在尽我所能地谈论过这件事。"}, {"type": "subtitle", "time": 4424.55, "timestamp": "01:13:44", "text": "我当时详细地跟他们谈到这件事的时候"}, {"type": "subtitle", "time": 4429.189, "timestamp": "01:13:49", "text": "一位正在直播的嘉宾，显然"}, {"type": "subtitle", "time": 4431.83, "timestamp": "01:13:51", "text": "呃，是那个raid主播里的一位。"}, {"type": "subtitle", "time": 4434.83, "timestamp": "01:13:54", "text": "周六的合作活动也在那里，他们"}, {"type": "subtitle", "time": 4437.99, "timestamp": "01:13:57", "text": "他们还在监听，这让我"}]
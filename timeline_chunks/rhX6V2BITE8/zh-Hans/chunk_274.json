[{"type": "subtitle", "time": 16441.789, "timestamp": "04:34:01", "text": "去他妈的权力必须是"}, {"type": "subtitle", "time": 16444.47, "timestamp": "04:34:04", "text": "离线。贾齐尔，我是克莱恩。刚跑完"}, {"type": "subtitle", "time": 16445.91, "timestamp": "04:34:05", "text": "跨越一个可能相当安全的区域"}, {"type": "subtitle", "time": 16447.349, "timestamp": "04:34:07", "text": "位置已确定，但我无法获得电力。"}, {"type": "subtitle", "time": 16449.91, "timestamp": "04:34:09", "text": "快点。知道原因吗？是的，但这是一个"}, {"type": "subtitle", "time": 16452.31, "timestamp": "04:34:12", "text": "说来话长，而且我也不是电工。"}, {"type": "subtitle", "time": 16453.99, "timestamp": "04:34:13", "text": "你最好去问问巴尔，我们的"}, {"type": "subtitle", "time": 16457.91, "timestamp": "04:34:17", "text": "机械师，关于细节。"}, {"type": "subtitle", "time": 16464.109, "timestamp": "04:34:24", "text": "对人民来说"}, {"type": "subtitle", "time": 16466.69, "timestamp": "04:34:26", "text": "追踪。是的，我们可以做到。"}, {"type": "subtitle", "time": 16468.029, "timestamp": "04:34:28", "text": "[音乐]"}, {"type": "subtitle", "time": 16471.869, "timestamp": "04:34:31", "text": "之后。为什么会有僵尸男？"}, {"type": "subtitle", "time": 16475.39, "timestamp": "04:34:35", "text": "这里？所以我使用了存档点，"}, {"type": "subtitle", "time": 16478.869, "timestamp": "04:34:38", "text": "嗯？难以置信这些居然像是任务！"}, {"type": "subtitle", "time": 16480.81, "timestamp": "04:34:40", "text": "再次。更多的"}, {"type": "subtitle", "time": 16490.83, "timestamp": "04:34:50", "text": "任务也"}, {"type": "subtitle", "time": 16497.39, "timestamp": "04:34:57", "text": "最后的。是的。"}]
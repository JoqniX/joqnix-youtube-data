[{"type": "subtitle", "time": 15910.429, "timestamp": "04:25:10", "text": "生成器。哦，我的"}, {"type": "subtitle", "time": 15913.55, "timestamp": "04:25:13", "text": "上帝。抓住"}, {"type": "subtitle", "time": 15916.67, "timestamp": "04:25:16", "text": "你。我怎么样？"}, {"type": "subtitle", "time": 15932.51, "timestamp": "04:25:32", "text": "来吧"}, {"type": "subtitle", "time": 15937.51, "timestamp": "04:25:37", "text": "我。来啊。跳。哦，等等。不，我"}, {"type": "subtitle", "time": 15939.71, "timestamp": "04:25:39", "text": "没想到你会突然跳起来。"}, {"type": "subtitle", "time": 15942.389, "timestamp": "04:25:42", "text": "你好。我没想到你会像这样跳起来"}, {"type": "subtitle", "time": 15945.75, "timestamp": "04:25:45", "text": "那。我以为我只是想让你……"}, {"type": "subtitle", "time": 15949.03, "timestamp": "04:25:49", "text": "跳入水中然后死去，但是，哦不。"}]
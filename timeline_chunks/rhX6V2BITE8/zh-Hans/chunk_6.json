[{"type": "subtitle", "time": 362.35, "timestamp": "00:06:02", "text": "这？两小时前。等待，"}, {"type": "subtitle", "time": 373.75, "timestamp": "00:06:13", "text": "那里。感谢"}, {"type": "subtitle", "time": 375.23, "timestamp": "00:06:15", "text": "[音乐]"}, {"type": "subtitle", "time": 377.909, "timestamp": "00:06:17", "text": "你，臭名昭著的凯伦。我不知道是否"}, {"type": "subtitle", "time": 379.43, "timestamp": "00:06:19", "text": "你还在，但还是要谢谢你。"}, {"type": "subtitle", "time": 381.15, "timestamp": "00:06:21", "text": "也请关注。"}, {"type": "subtitle", "time": 384.71, "timestamp": "00:06:24", "text": "欢迎。呃，Sky Mashan，你好。呃，"}, {"type": "subtitle", "time": 386.23, "timestamp": "00:06:26", "text": "她躺在床上，儿子。我不知道你是不是"}, {"type": "subtitle", "time": 387.83, "timestamp": "00:06:27", "text": "我还在，谢谢你的光临。"}, {"type": "subtitle", "time": 389.83, "timestamp": "00:06:29", "text": "在 Twitch 上。你3点钟过来的。"}, {"type": "subtitle", "time": 391.469, "timestamp": "00:06:31", "text": "昨天上午。我当时"}, {"type": "subtitle", "time": 398.15, "timestamp": "00:06:38", "text": "嗯，阿曼，一如既往地感谢你的到来。"}, {"type": "subtitle", "time": 401.749, "timestamp": "00:06:41", "text": "洪爱帝国三子，谢谢。"}, {"type": "subtitle", "time": 404.39, "timestamp": "00:06:44", "text": "感谢大家在Twitch上关注和光临。"}, {"type": "subtitle", "time": 406.71, "timestamp": "00:06:46", "text": "太感谢了。乔布斯，谢谢你"}, {"type": "subtitle", "time": 409.35, "timestamp": "00:06:49", "text": "路过。谢谢光临。希望"}, {"type": "subtitle", "time": 412.23, "timestamp": "00:06:52", "text": "希望你一切都好。是的，我们"}, {"type": "subtitle", "time": 413.99, "timestamp": "00:06:53", "text": "我们将与……合作"}, {"type": "subtitle", "time": 419.189, "timestamp": "00:06:59", "text": "Hijab Sistan 于周日下午 12:30 举行。"}]
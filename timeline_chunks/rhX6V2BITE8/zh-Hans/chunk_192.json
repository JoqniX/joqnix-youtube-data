[{"type": "subtitle", "time": 11526.95, "timestamp": "03:12:06", "text": "谢谢，这就是纽带，对吧？你是"}, {"type": "subtitle", "time": 11528.95, "timestamp": "03:12:08", "text": "好吧，我也跟你聊聊。"}, {"type": "subtitle", "time": 11531.91, "timestamp": "03:12:11", "text": "母亲蒙福。他身上有纹身"}, {"type": "subtitle", "time": 11533.99, "timestamp": "03:12:13", "text": "在他的胸口。听着，我只需要一些"}, {"type": "subtitle", "time": 11536.55, "timestamp": "03:12:16", "text": "信息。我什么都不知道。你"}, {"type": "subtitle", "time": 11539.75, "timestamp": "03:12:19", "text": "应该问问贾齐尔。爵士乐？呃，好的。在哪里"}, {"type": "subtitle", "time": 11542.87, "timestamp": "03:12:22", "text": "我能找到他吗？在谷仓里面。在"}, {"type": "subtitle", "time": 11545.07, "timestamp": "03:12:25", "text": "谷仓。好的。"}, {"type": "subtitle", "time": 11549.19, "timestamp": "03:12:29", "text": "谢谢你，M先生。他是最后一个吗？"}, {"type": "subtitle", "time": 11550.79, "timestamp": "03:12:30", "text": "还有其他人吗？我想我会说的"}, {"type": "subtitle", "time": 11554.19, "timestamp": "03:12:34", "text": "也向这个拿步枪的人开枪。"}, {"type": "subtitle", "time": 11556.23, "timestamp": "03:12:36", "text": "你好。我从那里爬了上去。"}, {"type": "subtitle", "time": 11559.19, "timestamp": "03:12:39", "text": "游行。过来。但我无法说话"}, {"type": "subtitle", "time": 11566.71, "timestamp": "03:12:46", "text": "好的。就在这里。这个人是他吗？"}, {"type": "subtitle", "time": 11567.469, "timestamp": "03:12:47", "text": "这"}, {"type": "subtitle", "time": 11571.51, "timestamp": "03:12:51", "text": "车。等等，这不是谷仓吗？你好？"}, {"type": "subtitle", "time": 11573.07, "timestamp": "03:12:53", "text": "什么是"}, {"type": "subtitle", "time": 11576.19, "timestamp": "03:12:56", "text": "禁止？这"}, {"type": "subtitle", "time": 11579.11, "timestamp": "03:12:59", "text": "一。布拉，我需要点东西。你是"}]
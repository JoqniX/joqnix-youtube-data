[{"type": "subtitle", "time": 8463.469, "timestamp": "02:21:03", "text": "节省"}, {"type": "subtitle", "time": 8467.349, "timestamp": "02:21:07", "text": "暂时地。兄弟，我改不了名字。"}, {"type": "subtitle", "time": 8469.15, "timestamp": "02:21:09", "text": "在"}, {"type": "subtitle", "time": 8472.99, "timestamp": "02:21:12", "text": "这。我看起来像个"}, {"type": "subtitle", "time": 8476.55, "timestamp": "02:21:16", "text": "机器人。那是什么？因为我非得是吗？"}, {"type": "subtitle", "time": 8484.309, "timestamp": "02:21:24", "text": "我等着？我知道我需要多少。不"}, {"type": "subtitle", "time": 8486.469, "timestamp": "02:21:26", "text": "知道很多。我们应该有很多搞笑的事情发生"}, {"type": "subtitle", "time": 8488.389, "timestamp": "02:21:28", "text": "一些略带趣味性的细节。我的话不合时宜。"}, {"type": "subtitle", "time": 8490.309, "timestamp": "02:21:30", "text": "中文内容。我不知道是否"}, {"type": "subtitle", "time": 8493.07, "timestamp": "02:21:33", "text": "翻译翻译器是"}, {"type": "subtitle", "time": 8494.67, "timestamp": "02:21:34", "text": "准确的。"}, {"type": "subtitle", "time": 8498.91, "timestamp": "02:21:38", "text": "是的，总有一天我会学中文。"}, {"type": "subtitle", "time": 8503.389, "timestamp": "02:21:43", "text": "并且能够"}, {"type": "subtitle", "time": 8507.67, "timestamp": "02:21:47", "text": "有效沟通。但是，是的，我"}, {"type": "subtitle", "time": 8510.67, "timestamp": "02:21:50", "text": "无法更改名称"}]
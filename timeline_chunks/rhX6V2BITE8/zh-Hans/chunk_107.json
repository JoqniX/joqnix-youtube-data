[{"type": "subtitle", "time": 6420.59, "timestamp": "01:47:00", "text": "中间人再次发挥作用。"}, {"type": "subtitle", "time": 6425.109, "timestamp": "01:47:05", "text": "合适的中间人，本地的东西，还有它"}, {"type": "subtitle", "time": 6428.07, "timestamp": "01:47:08", "text": "将核实拥有者的姓名"}, {"type": "subtitle", "time": 6430.629, "timestamp": "01:47:10", "text": "他们进行了账户核查"}, {"type": "subtitle", "time": 6433.91, "timestamp": "01:47:13", "text": "平台用户名检查"}, {"type": "subtitle", "time": 6437.189, "timestamp": "01:47:17", "text": "检查本地数据。"}, {"type": "subtitle", "time": 6439.189, "timestamp": "01:47:19", "text": "所以，这就是我能用那种方式做事的方法。"}, {"type": "subtitle", "time": 6442.47, "timestamp": "01:47:22", "text": "如果符合条件，就给人们经验值。"}, {"type": "subtitle", "time": 6444.39, "timestamp": "01:47:24", "text": "看着我，跟我聊天什么的"}, {"type": "subtitle", "time": 6448.709, "timestamp": "01:47:28", "text": "在某些平台上积极提供信息"}, {"type": "subtitle", "time": 6452.189, "timestamp": "01:47:32", "text": "诸如此类的积分基础等等"}, {"type": "subtitle", "time": 6455.109, "timestamp": "01:47:35", "text": "是的，那将来可能会发生。"}, {"type": "subtitle", "time": 6457.35, "timestamp": "01:47:37", "text": "我不应该想太多，但是……"}, {"type": "subtitle", "time": 6466.03, "timestamp": "01:47:46", "text": "想要一个通用的"}, {"type": "subtitle", "time": 6468.59, "timestamp": "01:47:48", "text": "门禁系统之类的东西"}, {"type": "subtitle", "time": 6470.43, "timestamp": "01:47:50", "text": "[音乐]"}, {"type": "subtitle", "time": 6473.41, "timestamp": "01:47:53", "text": "小玩意经济。是的，经济。"}, {"type": "subtitle", "time": 6475.95, "timestamp": "01:47:55", "text": "[音乐]"}, {"type": "subtitle", "time": 6477.629, "timestamp": "01:47:57", "text": "东西。"}]
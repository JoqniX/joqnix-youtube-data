[{"type": "subtitle", "time": 4320.95, "timestamp": "01:12:00", "text": "12点之后我就休息一会儿。打了个盹"}, {"type": "subtitle", "time": 4322.95, "timestamp": "01:12:02", "text": "一点。我动弹不得，但是"}, {"type": "subtitle", "time": 4327.63, "timestamp": "01:12:07", "text": "还是在下午2:30醒了，不是3:00。 3:00"}, {"type": "subtitle", "time": 4330.79, "timestamp": "01:12:10", "text": "早上起床，一直工作到六点，参与合作项目。"}, {"type": "subtitle", "time": 4334.79, "timestamp": "01:12:14", "text": "然后一直到5点，然后休息了一会儿。"}, {"type": "subtitle", "time": 4339.99, "timestamp": "01:12:19", "text": "从 6:30 开始。我们做了我们"}, {"type": "subtitle", "time": 4343.91, "timestamp": "01:12:23", "text": "我参加了日本虚拟主播的公开合作活动。"}, {"type": "subtitle", "time": 4346.95, "timestamp": "01:12:26", "text": "我就是这样认识大家的。我当时仍然是它"}, {"type": "chat", "time": 4348.556, "timestamp": "01:12:28", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! definitely not Taki ~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 4350.39, "timestamp": "01:12:30", "text": "就像一个开放式的排队系统。我的小玩意"}, {"type": "subtitle", "time": 4355.11, "timestamp": "01:12:35", "text": "大概是晚上10点、7点或8点到的。或者"}, {"type": "subtitle", "time": 4356.59, "timestamp": "01:12:36", "text": "某物。"}, {"type": "subtitle", "time": 4361.27, "timestamp": "01:12:41", "text": "所以，我不得不从8点等到10点。"}, {"type": "subtitle", "time": 4363.03, "timestamp": "01:12:43", "text": "或者别的什么。那真是个有趣的时刻。我"}, {"type": "subtitle", "time": 4365.99, "timestamp": "01:12:45", "text": "很喜欢这个代码仓库功能。遇见了很酷的新"}, {"type": "subtitle", "time": 4369.11, "timestamp": "01:12:49", "text": "各位，呃，我觉得我的 Twitch 账号出问题了。"}, {"type": "subtitle", "time": 4372.31, "timestamp": "01:12:52", "text": "记录也很重要，因为我被突袭了。"}, {"type": "subtitle", "time": 4374.709, "timestamp": "01:12:54", "text": "由现场四位主播共同呈现。五"}, {"type": "subtitle", "time": 4376.95, "timestamp": "01:12:56", "text": "那里有主播。就连大JP也一样"}, {"type": "subtitle", "time": 4379.87, "timestamp": "01:12:59", "text": "YouTuber 也"}]
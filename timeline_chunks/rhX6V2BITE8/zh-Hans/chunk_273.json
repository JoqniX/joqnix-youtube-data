[{"type": "subtitle", "time": 16396.109, "timestamp": "04:33:16", "text": "[音乐]"}, {"type": "subtitle", "time": 16399.05, "timestamp": "04:33:19", "text": "通过。我的天啊。"}, {"type": "subtitle", "time": 16408.91, "timestamp": "04:33:28", "text": "[音乐]"}, {"type": "subtitle", "time": 16412.029, "timestamp": "04:33:32", "text": "什么？好的。"}, {"type": "subtitle", "time": 16415.629, "timestamp": "04:33:35", "text": "好的。我奋力向上"}, {"type": "subtitle", "time": 16419.07, "timestamp": "04:33:39", "text": "那里。迪翁。"}, {"type": "subtitle", "time": 16428.629, "timestamp": "04:33:48", "text": "摔跤手。好了，就这些。不活跃"}, {"type": "subtitle", "time": 16431.029, "timestamp": "04:33:51", "text": "该国部分地区处于不活跃状态，因为"}, {"type": "subtitle", "time": 16433.869, "timestamp": "04:33:53", "text": "速度不足对比拉尔有利。"}, {"type": "subtitle", "time": 16436.789, "timestamp": "04:33:56", "text": "赋予人民权力的追求"}, {"type": "subtitle", "time": 16439.67, "timestamp": "04:33:59", "text": "使它们可用。"}]
[{"type": "subtitle", "time": 19152.19, "timestamp": "05:19:12", "text": "这种方法和我的我"}, {"type": "subtitle", "time": 19155.03, "timestamp": "05:19:15", "text": "不能。是的，我被狠狠地打了一巴掌。"}, {"type": "subtitle", "time": 19160.868, "timestamp": "05:19:20", "text": "好的。我不会失败，我不会跌倒。我"}, {"type": "subtitle", "time": 19180.31, "timestamp": "05:19:40", "text": "他在哪儿？他在哪儿？他在哪儿？"}, {"type": "subtitle", "time": 19193.55, "timestamp": "05:19:53", "text": "未来。"}, {"type": "subtitle", "time": 19197.04, "timestamp": "05:19:57", "text": "哦，你这科学刺客。"}]
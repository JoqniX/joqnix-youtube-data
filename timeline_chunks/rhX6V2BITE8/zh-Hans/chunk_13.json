[{"type": "subtitle", "time": 781.509, "timestamp": "00:13:01", "text": "弄清楚那件事之类的。嗯，总之"}, {"type": "subtitle", "time": 784.23, "timestamp": "00:13:04", "text": "让我们开始工作吧。呃，我们开始吧"}, {"type": "subtitle", "time": 786.31, "timestamp": "00:13:06", "text": "开始投入工作。让我"}, {"type": "subtitle", "time": 799.35, "timestamp": "00:13:19", "text": "私信。我回复后得到了奖励。"}, {"type": "subtitle", "time": 799.93, "timestamp": "00:13:19", "text": "丘比特"}, {"type": "subtitle", "time": 820.11, "timestamp": "00:13:40", "text": "儿子。"}, {"type": "subtitle", "time": 823.75, "timestamp": "00:13:43", "text": "嗯，哎呀，我也得继续往前走了。所以，我"}, {"type": "subtitle", "time": 825.509, "timestamp": "00:13:45", "text": "我自己会知道什么时候才能获得自由。"}]
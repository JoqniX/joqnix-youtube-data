[{"type": "subtitle", "time": 14042.189, "timestamp": "03:54:02", "text": "把这些藏起来。"}, {"type": "subtitle", "time": 14045.51, "timestamp": "03:54:05", "text": "东西。我其实并不需要她，但是"}, {"type": "subtitle", "time": 14058.55, "timestamp": "03:54:18", "text": "想想我们只是我们的井一直都是"}, {"type": "subtitle", "time": 14060.55, "timestamp": "03:54:20", "text": "过去一个月一直受到污染，人们"}, {"type": "subtitle", "time": 14063.429, "timestamp": "03:54:23", "text": "我们病情越来越重。也许我"}, {"type": "subtitle", "time": 14066.469, "timestamp": "03:54:26", "text": "陌生人，我误会你了。是的。所以"}, {"type": "subtitle", "time": 14068.309, "timestamp": "03:54:28", "text": "现在有机会回答我的问题吗？我们"}, {"type": "subtitle", "time": 14071.189, "timestamp": "03:54:31", "text": "改进了我们的“请关注我”功能。我们做了"}, {"type": "subtitle", "time": 14074.63, "timestamp": "03:54:34", "text": "我们尽了全力，并且有所进步。"}, {"type": "subtitle", "time": 14076.71, "timestamp": "03:54:36", "text": "我们的……呃，该怎么称呼它呢？重复"}, {"type": "subtitle", "time": 14078.67, "timestamp": "03:54:38", "text": "或前面的图像"}, {"type": "subtitle", "time": 14081.91, "timestamp": "03:54:41", "text": "乔希亚.那挺好的。瞧，孩子们"}, {"type": "subtitle", "time": 14086.41, "timestamp": "03:54:46", "text": "正在播放。他们对水质很满意。"}, {"type": "subtitle", "time": 14092.59, "timestamp": "03:54:52", "text": "她是什么人？"}, {"type": "subtitle", "time": 14096.309, "timestamp": "03:54:56", "text": "丢失的？哈兰的朋友们，你们好。我们正在运行"}, {"type": "subtitle", "time": 14098.63, "timestamp": "03:54:58", "text": "缺乏抗罪恶感。我在寻找任何东西"}]
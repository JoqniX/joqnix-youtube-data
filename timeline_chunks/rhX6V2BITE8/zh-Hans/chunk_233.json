[{"type": "subtitle", "time": 13980.51, "timestamp": "03:53:00", "text": "我。他盯上我了。他盯上我了。我们开始吧"}, {"type": "subtitle", "time": 13983.15, "timestamp": "03:53:03", "text": "看。"}, {"type": "subtitle", "time": 14006.75, "timestamp": "03:53:26", "text": "[音乐]"}, {"type": "subtitle", "time": 14009.91, "timestamp": "03:53:29", "text": "他。那我该怎么进去呢？好的。"}, {"type": "subtitle", "time": 14022.95, "timestamp": "03:53:42", "text": "你甚至不知道你刚才做了什么。"}, {"type": "subtitle", "time": 14025.429, "timestamp": "03:53:45", "text": "对我们来说。"}, {"type": "subtitle", "time": 14029.269, "timestamp": "03:53:49", "text": "那我该怎么入睡呢？好了，就是这样。"}, {"type": "subtitle", "time": 14038.95, "timestamp": "03:53:58", "text": "最后。玩家仓库，对吧？所以，我会"}]
[{"type": "subtitle", "time": 3422.549, "timestamp": "00:57:02", "text": "6个月后上线。我就像我"}, {"type": "subtitle", "time": 3425.99, "timestamp": "00:57:05", "text": "不行，我已经通过某种方式盈利了。"}, {"type": "subtitle", "time": 3429.15, "timestamp": "00:57:09", "text": "我通过 Jockathon 获得了盈利。"}, {"type": "subtitle", "time": 3432.87, "timestamp": "00:57:12", "text": "是的，我不能，我不能放弃这一切。"}, {"type": "subtitle", "time": 3435.589, "timestamp": "00:57:15", "text": "大家一直以来支持的艺术作品"}, {"type": "subtitle", "time": 3439.109, "timestamp": "00:57:19", "text": "一切都好，我不得不重新磨碎"}, {"type": "subtitle", "time": 3442.47, "timestamp": "00:57:22", "text": "整件事都会非常难，对吧？"}, {"type": "subtitle", "time": 3447.43, "timestamp": "00:57:27", "text": "所以我就想，我一定要想办法找到出路。"}, {"type": "subtitle", "time": 3449.589, "timestamp": "00:57:29", "text": "如果还有办法，如果还有意愿"}, {"type": "subtitle", "time": 3451.43, "timestamp": "00:57:31", "text": "总会有办法的。好的。所以，"}, {"type": "subtitle", "time": 3453.67, "timestamp": "00:57:33", "text": "别担心。慢跑，不要去"}, {"type": "subtitle", "time": 3455.19, "timestamp": "00:57:35", "text": "日本。我会想念你的。不用担心，"}, {"type": "subtitle", "time": 3456.43, "timestamp": "00:57:36", "text": "我将保持静止"}, {"type": "subtitle", "time": 3458.789, "timestamp": "00:57:38", "text": "大约。希望一切顺利。"}, {"type": "subtitle", "time": 3461.47, "timestamp": "00:57:41", "text": "希望我还能做到。"}, {"type": "subtitle", "time": 3463.829, "timestamp": "00:57:43", "text": "溪流。是的。呃，到那时他们会"}, {"type": "subtitle", "time": 3466.23, "timestamp": "00:57:46", "text": "拿到 COE 之后，一切就都办好了。"}, {"type": "subtitle", "time": 3469.829, "timestamp": "00:57:49", "text": "然后送别仪式将在第三场左右举行。"}, {"type": "subtitle", "time": 3472.71, "timestamp": "00:57:52", "text": "我想应该是这周吧。所以，那将会是"}, {"type": "subtitle", "time": 3476.309, "timestamp": "00:57:56", "text": "碰撞。我不知道那东西什么时候会出问题。"}, {"type": "subtitle", "time": 3478.39, "timestamp": "00:57:58", "text": "我可能得给学院打个电话。"}]
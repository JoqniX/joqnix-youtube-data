[{"type": "subtitle", "time": 540.389, "timestamp": "00:09:00", "text": "真的真的真的好想喜欢"}, {"type": "subtitle", "time": 542.55, "timestamp": "00:09:02", "text": "与我认识的人建立联系，我真的"}, {"type": "subtitle", "time": 545.75, "timestamp": "00:09:05", "text": "想重新联系并交谈"}, {"type": "subtitle", "time": 547.55, "timestamp": "00:09:07", "text": "和……一起玩"}, {"type": "subtitle", "time": 550.79, "timestamp": "00:09:10", "text": "实际上。是的。唉，我真希望"}, {"type": "subtitle", "time": 553.43, "timestamp": "00:09:13", "text": "我开始做这些马拉松式演讲"}, {"type": "subtitle", "time": 556.949, "timestamp": "00:09:16", "text": "从四月份开始有个合作项目，但是"}, {"type": "subtitle", "time": 559.829, "timestamp": "00:09:19", "text": "太蠢了。我没想到我会变成这样"}, {"type": "subtitle", "time": 561.87, "timestamp": "00:09:21", "text": "固执地不愿伸出援手"}, {"type": "subtitle", "time": 565.71, "timestamp": "00:09:25", "text": "至210"}, {"type": "subtitle", "time": 569.03, "timestamp": "00:09:29", "text": "我认识的500人中，有些人……"}, {"type": "subtitle", "time": 571.87, "timestamp": "00:09:31", "text": "Discord 上的朋友和其他"}, {"type": "subtitle", "time": 576.91, "timestamp": "00:09:36", "text": "地点。总共210个。"}, {"type": "subtitle", "time": 581.19, "timestamp": "00:09:41", "text": "是的。脱离其中。很多人都没有"}, {"type": "subtitle", "time": 585.11, "timestamp": "00:09:45", "text": "已经回复了等等。大多数人"}, {"type": "subtitle", "time": 587.71, "timestamp": "00:09:47", "text": "忙碌的。我在想……"}, {"type": "subtitle", "time": 591.67, "timestamp": "00:09:51", "text": "如果有人看到了这条信息，"}, {"type": "subtitle", "time": 594.31, "timestamp": "00:09:54", "text": "我的消息是不是太晚了？当我"}, {"type": "subtitle", "time": 596.949, "timestamp": "00:09:56", "text": "时间紧迫，当它到达……"}, {"type": "subtitle", "time": 599.91, "timestamp": "00:09:59", "text": "六月第三周了，我时间不够了。"}]
[{"type": "subtitle", "time": 16337.26, "timestamp": "04:32:17", "text": "我们应该上去吗？"}, {"type": "subtitle", "time": 16338.91, "timestamp": "04:32:18", "text": "[音乐]"}, {"type": "subtitle", "time": 16341.95, "timestamp": "04:32:21", "text": "然后我就应该走了"}, {"type": "subtitle", "time": 16345.63, "timestamp": "04:32:25", "text": "起身，我奋力反抗。"}, {"type": "subtitle", "time": 16348.99, "timestamp": "04:32:28", "text": "不，你不会让我进行擒拿。"}, {"type": "subtitle", "time": 16351.79, "timestamp": "04:32:31", "text": "嗯？不，我可以竞选"}, {"type": "subtitle", "time": 16354.53, "timestamp": "04:32:34", "text": "它。打开"}, {"type": "subtitle", "time": 16363.11, "timestamp": "04:32:43", "text": "力量。我应该如何开启"}, {"type": "subtitle", "time": 16374.87, "timestamp": "04:32:54", "text": "[音乐]"}, {"type": "subtitle", "time": 16378.44, "timestamp": "04:32:58", "text": "我其实不知道我是怎么起床的。"}]
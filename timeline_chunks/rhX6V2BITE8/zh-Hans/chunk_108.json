[{"type": "subtitle", "time": 6486.47, "timestamp": "01:48:06", "text": "卖。不，你可以买类似这样的东西"}, {"type": "subtitle", "time": 6493.83, "timestamp": "01:48:13", "text": "类似我们的星座或音乐会"}, {"type": "subtitle", "time": 6496.669, "timestamp": "01:48:16", "text": "盘子头像商店。你可以"}, {"type": "subtitle", "time": 6500.91, "timestamp": "01:48:20", "text": "自己买东西或者自己做"}, {"type": "subtitle", "time": 6508.109, "timestamp": "01:48:28", "text": "那。我不"}, {"type": "subtitle", "time": 6511.669, "timestamp": "01:48:31", "text": "知道。只是一个想法概念。我当时"}, {"type": "subtitle", "time": 6514.43, "timestamp": "01:48:34", "text": "我想我总能修改它。"}, {"type": "subtitle", "time": 6517.43, "timestamp": "01:48:37", "text": "主意。那些地方已经没有其他路可走了。"}, {"type": "subtitle", "time": 6519.55, "timestamp": "01:48:39", "text": "关于"}, {"type": "subtitle", "time": 6522.03, "timestamp": "01:48:42", "text": "这。所以"}, {"type": "subtitle", "time": 6534.39, "timestamp": "01:48:54", "text": "尽管。你可以试试，但我不能保证。"}, {"type": "subtitle", "time": 6535.99, "timestamp": "01:48:55", "text": "是的。是的。不要轻易承诺。没关系。不"}, {"type": "subtitle", "time": 6539.35, "timestamp": "01:48:59", "text": "担忧。再次。一旦我有足够的"}]
[{"type": "subtitle", "time": 19380.31, "timestamp": "05:23:00", "text": "或者别的什么。不。呃，如果你试图获得"}, {"type": "subtitle", "time": 19384.47, "timestamp": "05:23:04", "text": "除此之外，你还会得到一个协调员之类的东西"}, {"type": "subtitle", "time": 19386.51, "timestamp": "05:23:06", "text": "或者别的什么。那还在吗？"}, {"type": "subtitle", "time": 19390.47, "timestamp": "05:23:10", "text": "事物？你好。我该怎么上去？"}, {"type": "subtitle", "time": 19393.19, "timestamp": "05:23:13", "text": "天哪，我以前玩那些游戏玩得不亦乐乎。"}, {"type": "subtitle", "time": 19397.35, "timestamp": "05:23:17", "text": "很久以前。起不来了。"}, {"type": "subtitle", "time": 19403.15, "timestamp": "05:23:23", "text": "这里？"}, {"type": "subtitle", "time": 19406.11, "timestamp": "05:23:26", "text": "哦"}, {"type": "subtitle", "time": 19408.67, "timestamp": "05:23:28", "text": "男生。你好，"}, {"type": "subtitle", "time": 19412.07, "timestamp": "05:23:32", "text": "富士山。这个游戏现在还支持矢量图形吗？"}, {"type": "subtitle", "time": 19415.708, "timestamp": "05:23:35", "text": "是的，确实如此。你好，Araxa。你好。"}, {"type": "subtitle", "time": 19438.87, "timestamp": "05:23:58", "text": "好的。"}]
[{"type": "subtitle", "time": 13020.429, "timestamp": "03:37:00", "text": "没有，"}, {"type": "subtitle", "time": 13022.79, "timestamp": "03:37:02", "text": "男人。好吧，行。至少我能得到"}, {"type": "subtitle", "time": 13026.03, "timestamp": "03:37:06", "text": "这次的弹药。"}, {"type": "subtitle", "time": 13028.469, "timestamp": "03:37:08", "text": "不。至少我这次能拿到弹药。"}, {"type": "subtitle", "time": 13056.389, "timestamp": "03:37:36", "text": "杀了他。他怎么还没死呢？"}, {"type": "subtitle", "time": 13067.83, "timestamp": "03:37:47", "text": "我得到了两个护身符。所以，让我们以……为目标。"}, {"type": "subtitle", "time": 13069.79, "timestamp": "03:37:49", "text": "头部"}]
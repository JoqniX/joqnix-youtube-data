[{"type": "subtitle", "time": 12483.389, "timestamp": "03:28:03", "text": "松垮的复位位置。不。"}, {"type": "subtitle", "time": 12486.429, "timestamp": "03:28:06", "text": "嗯？等等，我该怎么做？"}, {"type": "subtitle", "time": 12489.87, "timestamp": "03:28:09", "text": "出口？握住"}, {"type": "subtitle", "time": 12493.229, "timestamp": "03:28:13", "text": "笨蛋。按住 E 键升级。"}, {"type": "subtitle", "time": 12496.269, "timestamp": "03:28:16", "text": "维修。我需要喜欢"}, {"type": "subtitle", "time": 12499.63, "timestamp": "03:28:19", "text": "呃，我可以自己修理吗？好的，我"}, {"type": "subtitle", "time": 12503.229, "timestamp": "03:28:23", "text": "能。但我没有螺丝。"}, {"type": "subtitle", "time": 12519.15, "timestamp": "03:28:39", "text": "我得进去看看。哦，原来是那个。"}, {"type": "subtitle", "time": 12521.75, "timestamp": "03:28:41", "text": "AA 由此而来。好的。你正在寻找"}, {"type": "subtitle", "time": 12525.59, "timestamp": "03:28:45", "text": "可汗。他走了。我想他们最终"}, {"type": "subtitle", "time": 12528.309, "timestamp": "03:28:48", "text": "请他离开。请他离开，"}, {"type": "subtitle", "time": 12531.75, "timestamp": "03:28:51", "text": "嗯？娜妮。什么？被枪指着。谁是"}, {"type": "subtitle", "time": 12534.389, "timestamp": "03:28:54", "text": "他们？他们最终做了我父亲做的事"}, {"type": "subtitle", "time": 12535.83, "timestamp": "03:28:55", "text": "早就该这么做了。"}, {"type": "subtitle", "time": 12537.269, "timestamp": "03:28:57", "text": "事情进展得平静而美好。"}, {"type": "subtitle", "time": 12539.03, "timestamp": "03:28:59", "text": "就在这附近。周围一片寂静。"}]
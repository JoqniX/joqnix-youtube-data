[{"type": "subtitle", "time": 14282.03, "timestamp": "03:58:02", "text": "德米特去看有没有什么事。"}, {"type": "subtitle", "time": 14284.63, "timestamp": "03:58:04", "text": "奇怪，绿洲里什么有用的东西都没有。"}, {"type": "subtitle", "time": 14287.429, "timestamp": "03:58:07", "text": "他们的做法既勇敢又愚蠢。"}, {"type": "subtitle", "time": 14289.349, "timestamp": "03:58:09", "text": "我们不能。我们不能接受愚蠢的行为。"}, {"type": "subtitle", "time": 14291.83, "timestamp": "03:58:11", "text": "是的。买不起。"}, {"type": "subtitle", "time": 14294.309, "timestamp": "03:58:14", "text": "博告诉他们，那是个好主意。"}, {"type": "subtitle", "time": 14295.87, "timestamp": "03:58:15", "text": "去他妈的"}, {"type": "subtitle", "time": 14300.15, "timestamp": "03:58:20", "text": "你。希望母亲的恩典保佑他平安。"}, {"type": "subtitle", "time": 14301.91, "timestamp": "03:58:21", "text": "如果你收到他们的任何消息，请"}, {"type": "subtitle", "time": 14303.7, "timestamp": "03:58:23", "text": "如果我"}, {"type": "subtitle", "time": 14306.11, "timestamp": "03:58:26", "text": "[音乐]"}, {"type": "subtitle", "time": 14309.75, "timestamp": "03:58:29", "text": "大家就跟着剧情往下看吧。"}, {"type": "subtitle", "time": 14312.309, "timestamp": "03:58:32", "text": "我们只是顺着新高峰的浪潮前进。"}, {"type": "subtitle", "time": 14313.15, "timestamp": "03:58:33", "text": "从"}, {"type": "subtitle", "time": 14315.349, "timestamp": "03:58:35", "text": "没有面孔。如果你想活命，"}, {"type": "subtitle", "time": 14317.91, "timestamp": "03:58:37", "text": "不要靠近那座老桥。"}, {"type": "subtitle", "time": 14320.91, "timestamp": "03:58:40", "text": "尽量避免。找到任何并找到"}, {"type": "subtitle", "time": 14323.229, "timestamp": "03:58:43", "text": "替代部分"}, {"type": "subtitle", "time": 14326.71, "timestamp": "03:58:46", "text": "祭坛，当我说在附近的时候"}, {"type": "subtitle", "time": 14329.71, "timestamp": "03:58:49", "text": "说到做到。好的。"}, {"type": "subtitle", "time": 14332.189, "timestamp": "03:58:52", "text": "只是他死了。"}, {"type": "subtitle", "time": 14336.229, "timestamp": "03:58:56", "text": "好的。所有蜂箱都是健康的W型蜂箱。"}, {"type": "subtitle", "time": 14339.59, "timestamp": "03:58:59", "text": "繁殖地和乡村是"}]
[{"type": "subtitle", "time": 11363.75, "timestamp": "03:09:23", "text": "男人。所以，这些是孩子们"}, {"type": "subtitle", "time": 11365.67, "timestamp": "03:09:25", "text": "太阳。"}, {"type": "subtitle", "time": 11367.389, "timestamp": "03:09:27", "text": "所以你就是"}, {"type": "subtitle", "time": 11369.95, "timestamp": "03:09:29", "text": "领导者。你是领导者。"}, {"type": "subtitle", "time": 11372.95, "timestamp": "03:09:32", "text": "不，我想我们可以，我会称你为上帝或"}, {"type": "subtitle", "time": 11377.03, "timestamp": "03:09:37", "text": "太阳之子或太阳女神。是的。你好，布拉德。"}, {"type": "subtitle", "time": 11378.269, "timestamp": "03:09:38", "text": "[音乐]"}, {"type": "subtitle", "time": 11381.71, "timestamp": "03:09:41", "text": "欢迎。这是一块手表。"}, {"type": "subtitle", "time": 11391.15, "timestamp": "03:09:51", "text": "哇。我怀念开店之类的日子。"}]
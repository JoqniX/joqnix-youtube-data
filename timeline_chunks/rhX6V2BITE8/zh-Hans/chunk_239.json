[{"type": "subtitle", "time": 14341.51, "timestamp": "03:59:01", "text": "和他们一起看了看。如果你摧毁"}, {"type": "subtitle", "time": 14344.349, "timestamp": "03:59:04", "text": "你会减少它们"}, {"type": "subtitle", "time": 14348.95, "timestamp": "03:59:08", "text": "波动性人口和非波动性人口"}, {"type": "subtitle", "time": 14351.51, "timestamp": "03:59:11", "text": "让夜晚对你我都更安全。"}, {"type": "subtitle", "time": 14354.87, "timestamp": "03:59:14", "text": "以及当地居民。不过要注意，痔疮是"}, {"type": "subtitle", "time": 14357.91, "timestamp": "03:59:17", "text": "白天到处都是祭坛。所以，你也这样做吧"}, {"type": "subtitle", "time": 14360.67, "timestamp": "03:59:20", "text": "最好这样你才有最大的机会"}, {"type": "subtitle", "time": 14363.99, "timestamp": "03:59:23", "text": "成功之道在于攻击右翼。哦"}, {"type": "subtitle", "time": 14368.15, "timestamp": "03:59:28", "text": "天哪，我为什么打哈欠？我的天啊。哦，"}, {"type": "subtitle", "time": 14371.36, "timestamp": "03:59:31", "text": "我为什么打哈欠？"}, {"type": "subtitle", "time": 14372.67, "timestamp": "03:59:32", "text": "[音乐]"}, {"type": "subtitle", "time": 14384.189, "timestamp": "03:59:44", "text": "那。有一个"}]
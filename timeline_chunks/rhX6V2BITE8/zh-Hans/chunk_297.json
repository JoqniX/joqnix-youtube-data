[{"type": "subtitle", "time": 17823.11, "timestamp": "04:57:03", "text": "我的鼠标设置。我没有。所以，呃，我"}, {"type": "subtitle", "time": 17824.99, "timestamp": "04:57:04", "text": "不要。但它是"}, {"type": "subtitle", "time": 17829.35, "timestamp": "04:57:09", "text": "好的。是的。所以，等到……"}, {"type": "subtitle", "time": 17831.83, "timestamp": "04:57:11", "text": "突然冒出个东西。哦，等等。那是……"}, {"type": "subtitle", "time": 17834.35, "timestamp": "04:57:14", "text": "这就是我。所以"}, {"type": "subtitle", "time": 17838.51, "timestamp": "04:57:18", "text": "大的。等等，我没调整好吗？"}, {"type": "subtitle", "time": 17841.11, "timestamp": "04:57:21", "text": "这也？我是不是没调整好？"}, {"type": "subtitle", "time": 17850.47, "timestamp": "04:57:30", "text": "好的，我没有调整它。哦，我知道"}, {"type": "subtitle", "time": 17853.83, "timestamp": "04:57:33", "text": "发生了什么事？哦，我忘了。呃，我，我，我"}, {"type": "subtitle", "time": 17856.868, "timestamp": "04:57:36", "text": "忘了。我……我错过了什么，我搞砸了什么。"}, {"type": "subtitle", "time": 17859.43, "timestamp": "04:57:39", "text": "这就是原因。我们等等看这件事会如何发展"}, {"type": "subtitle", "time": 17863.75, "timestamp": "04:57:43", "text": "加载。好的。在战场上战斗。"}, {"type": "subtitle", "time": 17866.11, "timestamp": "04:57:46", "text": "我的在哪里？"}, {"type": "subtitle", "time": 17868.628, "timestamp": "04:57:48", "text": "翻译？嗯，我很好。我希望"}, {"type": "subtitle", "time": 17870.07, "timestamp": "04:57:50", "text": "你也做得很好。是的，我是"}, {"type": "subtitle", "time": 17873.23, "timestamp": "04:57:53", "text": "一切顺利。你们都有吗？"}, {"type": "subtitle", "time": 17876.55, "timestamp": "04:57:56", "text": "呃，午餐？如果你那边是下午，那么……"}, {"type": "subtitle", "time": 17878.948, "timestamp": "04:57:58", "text": "你们都吃过午饭了吗？希望你们"}]
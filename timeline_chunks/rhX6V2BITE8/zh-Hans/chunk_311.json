[{"type": "subtitle", "time": 18662.868, "timestamp": "05:11:02", "text": "捕获。不是那种捕捉。等等，这是什么？"}, {"type": "subtitle", "time": 18665.07, "timestamp": "05:11:05", "text": "我的来源名称"}, {"type": "subtitle", "time": 18673.11, "timestamp": "05:11:13", "text": "捕获。这是哪张截图？迪奥。等待。"}, {"type": "subtitle", "time": 18675.31, "timestamp": "05:11:15", "text": "好的。这"}, {"type": "subtitle", "time": 18677.788, "timestamp": "05:11:17", "text": "一。好的。"}, {"type": "subtitle", "time": 18680.948, "timestamp": "05:11:20", "text": "玩家速度模糊效果。好的。知道了。知道了。"}, {"type": "subtitle", "time": 18683.67, "timestamp": "05:11:23", "text": "它应该随时都能运行。不。"}, {"type": "subtitle", "time": 18685.91, "timestamp": "05:11:25", "text": "好的。应该可以正常运行了。应该是"}, {"type": "subtitle", "time": 18686.67, "timestamp": "05:11:26", "text": "在职的。"}, {"type": "subtitle", "time": 18690.67, "timestamp": "05:11:30", "text": "是的，应该如此。"}, {"type": "subtitle", "time": 18693.83, "timestamp": "05:11:33", "text": "好的。所以，我把它改成了现在的样子"}, {"type": "subtitle", "time": 18697.11, "timestamp": "05:11:37", "text": "主动检查我的电脑是否存在问题"}, {"type": "subtitle", "time": 18700.47, "timestamp": "05:11:40", "text": "游戏呃，exe文件之类的东西。然后它就……改变了。"}, {"type": "subtitle", "time": 18703.43, "timestamp": "05:11:43", "text": "OBS 中的各种东西和触发器。不是吗"}, {"type": "subtitle", "time": 18705.35, "timestamp": "05:11:45", "text": "真的那么方便吗？所以，我不需要"}, {"type": "subtitle", "time": 18707.51, "timestamp": "05:11:47", "text": "不用担心哦，我忘了开机"}, {"type": "subtitle", "time": 18710.788, "timestamp": "05:11:50", "text": "模糊不清。我忘了把……模糊处理。"}, {"type": "subtitle", "time": 18713.35, "timestamp": "05:11:53", "text": "小地图等等。所以，我不需要"}, {"type": "subtitle", "time": 18716.55, "timestamp": "05:11:56", "text": "玩 Valerant 或 Apex 时会担心"}, {"type": "subtitle", "time": 18719.19, "timestamp": "05:11:59", "text": "任何。"}]
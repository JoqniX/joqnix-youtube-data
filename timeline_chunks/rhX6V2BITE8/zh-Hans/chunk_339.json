[{"type": "subtitle", "time": 20347.99, "timestamp": "05:39:07", "text": "上帝。你好。嗯，克洛诺斯。我想得到"}, {"type": "subtitle", "time": 20350.99, "timestamp": "05:39:10", "text": "他的战利品，但真的是这样吗？"}, {"type": "subtitle", "time": 20354.548, "timestamp": "05:39:14", "text": "有风险吗？但还有其他人。"}, {"type": "subtitle", "time": 20376.03, "timestamp": "05:39:36", "text": "啊。呃，你好。"}, {"type": "subtitle", "time": 20396.19, "timestamp": "05:39:56", "text": "你。"}]
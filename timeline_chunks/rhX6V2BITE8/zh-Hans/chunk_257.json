[{"type": "subtitle", "time": 15438.79, "timestamp": "04:17:18", "text": "他。那是两个。"}, {"type": "subtitle", "time": 15455.63, "timestamp": "04:17:35", "text": "苍蝇。生成。你们像苍蝇一样繁殖。"}, {"type": "subtitle", "time": 15458.59, "timestamp": "04:17:38", "text": "D. 另一个会从……弹出"}, {"type": "subtitle", "time": 15462.91, "timestamp": "04:17:42", "text": "这里。马上就到了。我想念我的"}, {"type": "subtitle", "time": 15467.67, "timestamp": "04:17:47", "text": "射击。好的。不挂断。"}, {"type": "subtitle", "time": 15469.309, "timestamp": "04:17:49", "text": "有一个"}, {"type": "subtitle", "time": 15472.149, "timestamp": "04:17:52", "text": "左边。我会接受我能拿到的最多的钱。"}]
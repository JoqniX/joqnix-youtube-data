[{"type": "subtitle", "time": 5105.47, "timestamp": "01:25:05", "text": "天才？你怎么样"}, {"type": "subtitle", "time": 5110.59, "timestamp": "01:25:10", "text": "天才？我的天哪，你真是个天才。看看"}, {"type": "subtitle", "time": 5113.51, "timestamp": "01:25:13", "text": "你。它实际上给了你一个“等等”，"}, {"type": "subtitle", "time": 5115.59, "timestamp": "01:25:15", "text": "它会显示UTFI标志吗？请"}, {"type": "subtitle", "time": 5116.99, "timestamp": "01:25:16", "text": "告诉"}, {"type": "subtitle", "time": 5125.03, "timestamp": "01:25:25", "text": "加载中。这是什么？日本。那是……"}, {"type": "subtitle", "time": 5126.83, "timestamp": "01:25:26", "text": "第一册"}, {"type": "subtitle", "time": 5133.87, "timestamp": "01:25:33", "text": "嗯？这是什么？那是什么日本？"}, {"type": "subtitle", "time": 5158.149, "timestamp": "01:25:58", "text": "对，你放个类似日本的东西进去。"}]
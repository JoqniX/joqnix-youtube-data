[{"type": "subtitle", "time": 16083.229, "timestamp": "04:28:03", "text": "呃，失踪人员"}, {"type": "subtitle", "time": 16085.229, "timestamp": "04:28:05", "text": "东西。"}, {"type": "subtitle", "time": 16097.07, "timestamp": "04:28:17", "text": "我们没事。"}, {"type": "subtitle", "time": 16102.189, "timestamp": "04:28:22", "text": "嗯，所以有一、二，"}, {"type": "subtitle", "time": 16105.95, "timestamp": "04:28:25", "text": "三，那可是相当多的波动性"}, {"type": "subtitle", "time": 16110.389, "timestamp": "04:28:30", "text": "巢。一、二、三、四、五、六"}, {"type": "subtitle", "time": 16116.229, "timestamp": "04:28:36", "text": "七、八、九。九伏特巢穴。"}, {"type": "subtitle", "time": 16118.83, "timestamp": "04:28:38", "text": "一，二，"}, {"type": "subtitle", "time": 16122.79, "timestamp": "04:28:42", "text": "三四岁左右"}, {"type": "subtitle", "time": 16125.71, "timestamp": "04:28:45", "text": "呃，安全"}, {"type": "subtitle", "time": 16128.63, "timestamp": "04:28:48", "text": "房屋。调查这起谜案。不。"}, {"type": "subtitle", "time": 16131.269, "timestamp": "04:28:51", "text": "好的。你知道吗？在我们结束之前"}, {"type": "subtitle", "time": 16136.51, "timestamp": "04:28:56", "text": "今天，我们来……"}, {"type": "subtitle", "time": 16139.11, "timestamp": "04:28:59", "text": "实际上，我去了安全屋，我只是"}]
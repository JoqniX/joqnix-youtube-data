[{"type": "subtitle", "time": 11762.64, "timestamp": "03:16:02", "text": "听着，我现在缺个人，而且自从 我是一名企业家，咱们来做生意吧。"}, {"type": "subtitle", "time": 11765.6, "timestamp": "03:16:05", "text": "我是一名企业家，咱们来做生意吧。 我们俩结成伙伴。买任何东西，"}, {"type": "subtitle", "time": 11769.12, "timestamp": "03:16:09", "text": "我们俩结成伙伴。买任何东西， 朋友？"}, {"type": "subtitle", "time": 11775.91, "timestamp": "03:16:15", "text": "好的，他到那里是为了听取双方的意见。"}, {"type": "subtitle", "time": 11778.87, "timestamp": "03:16:18", "text": "我们的对话。"}, {"type": "subtitle", "time": 11781.91, "timestamp": "03:16:21", "text": "多么小巧的盒子啊。我的天啊。我可以展示"}, {"type": "subtitle", "time": 11783.91, "timestamp": "03:16:23", "text": "给你一些可能对你有帮助的东西"}, {"type": "subtitle", "time": 11786.15, "timestamp": "03:16:26", "text": "但我们首先需要弄到轮子。"}, {"type": "subtitle", "time": 11788.95, "timestamp": "03:16:28", "text": "把车开出来。我在哪里？"}, {"type": "subtitle", "time": 11790.79, "timestamp": "03:16:30", "text": "应该找到那个吗？ Vade 车辆。哦"}, {"type": "subtitle", "time": 11794.389, "timestamp": "03:16:34", "text": "我的上帝。我们走吧。你，嘿，低调点。"}, {"type": "subtitle", "time": 11796.95, "timestamp": "03:16:36", "text": "关于它。好的，低调点。什么"}, {"type": "subtitle", "time": 11801.07, "timestamp": "03:16:41", "text": "再次保持低调？就像要保密一样。"}, {"type": "subtitle", "time": 11803.429, "timestamp": "03:16:43", "text": "秘密。在钉子堆里找辆车"}, {"type": "subtitle", "time": 11805.349, "timestamp": "03:16:45", "text": "农场。我的天啊。实际上，我们要去"}, {"type": "subtitle", "time": 11807.51, "timestamp": "03:16:47", "text": "获取车辆。好的。我跟你说过，把那辆车弄到手。"}, {"type": "subtitle", "time": 11810.07, "timestamp": "03:16:50", "text": "你了解我。我的天啊。那个狡猾的家伙在哪儿？"}, {"type": "subtitle", "time": 11813.03, "timestamp": "03:16:53", "text": "狐狸还是狡猾的狗？在哪里？你在哪里？"}, {"type": "subtitle", "time": 11816.55, "timestamp": "03:16:56", "text": "那个四处查看并看到我的人"}, {"type": "subtitle", "time": 11819.59, "timestamp": "03:16:59", "text": "和他交谈。穿着像"}]
[{"type": "subtitle", "time": 4206.95, "timestamp": "01:10:06", "text": "好了，回来吧。我爸爸来过这里。呃，他"}, {"type": "subtitle", "time": 4208.99, "timestamp": "01:10:08", "text": "给我剪了个口子，然后"}, {"type": "subtitle", "time": 4212.95, "timestamp": "01:10:12", "text": "汁。我被告知我可能"}, {"type": "subtitle", "time": 4215.229, "timestamp": "01:10:15", "text": "明天必须去银行。"}, {"type": "subtitle", "time": 4217.07, "timestamp": "01:10:17", "text": "11:00。"}, {"type": "subtitle", "time": 4226.07, "timestamp": "01:10:26", "text": "时间？ H，明天的合作伙伴是"}, {"type": "subtitle", "time": 4228.63, "timestamp": "01:10:28", "text": "尚未得到证实。我的天哪。呃，"}, {"type": "subtitle", "time": 4234.39, "timestamp": "01:10:34", "text": "做？如何私信他们呢？只有一个"}, {"type": "subtitle", "time": 4242.55, "timestamp": "01:10:42", "text": "呃，我的天哪。是的。呃，这周我"}, {"type": "subtitle", "time": 4244.95, "timestamp": "01:10:44", "text": "还需要最终敲定。星期四不是"}, {"type": "subtitle", "time": 4247.75, "timestamp": "01:10:47", "text": "确认一已确认。更多老虎机"}, {"type": "subtitle", "time": 4249.39, "timestamp": "01:10:49", "text": "那里。"}, {"type": "subtitle", "time": 4251.91, "timestamp": "01:10:51", "text": "星期五。是的，收拾好了。星期六是"}, {"type": "subtitle", "time": 4254.55, "timestamp": "01:10:54", "text": "打包好了。星期五是两点。二比二少"}, {"type": "subtitle", "time": 4257.59, "timestamp": "01:10:57", "text": "现在。两次合作就少了两个。现在我我我"}]
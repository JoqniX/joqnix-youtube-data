[{"type": "subtitle", "time": 3900.829, "timestamp": "01:05:00", "text": "[音乐]"}, {"type": "subtitle", "time": 3913.27, "timestamp": "01:05:13", "text": "15日是的，我可以让你待到第三周。"}, {"type": "subtitle", "time": 3914.95, "timestamp": "01:05:14", "text": "大概。是的。上周排名第三。是的。"}, {"type": "subtitle", "time": 3923.95, "timestamp": "01:05:23", "text": "工作。我得给我的Roku买个玩具。"}, {"type": "subtitle", "time": 3927.43, "timestamp": "01:05:27", "text": "别忘了Roku。"}, {"type": "subtitle", "time": 3939.43, "timestamp": "01:05:39", "text": "罗。是的。一开始你们都知道我"}, {"type": "subtitle", "time": 3943.27, "timestamp": "01:05:43", "text": "想做一些小组合作，但是"}, {"type": "subtitle", "time": 3945.67, "timestamp": "01:05:45", "text": "是的，一对一的，我现在优先考虑的是这个。"}, {"type": "subtitle", "time": 3948.21, "timestamp": "01:05:48", "text": "好的。"}, {"type": "subtitle", "time": 3955.63, "timestamp": "01:05:55", "text": "嗯，因为有很多。"}]
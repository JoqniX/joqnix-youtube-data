[{"type": "subtitle", "time": 19572.708, "timestamp": "05:26:12", "text": "镰刀。这就是我切菜的方式"}, {"type": "subtitle", "time": 19573.55, "timestamp": "05:26:13", "text": "脖子"}, {"type": "subtitle", "time": 19577.31, "timestamp": "05:26:17", "text": "向上而不是用撬棍。乌鸦叫"}, {"type": "subtitle", "time": 19578.91, "timestamp": "05:26:18", "text": "撬棍。"}, {"type": "subtitle", "time": 19582.23, "timestamp": "05:26:22", "text": "是的。嗯，镰刀。我来拿镰刀。"}, {"type": "subtitle", "time": 19586.39, "timestamp": "05:26:26", "text": "陈。好的。我可以把它拿走吗？哦，"}, {"type": "subtitle", "time": 19588.708, "timestamp": "05:26:28", "text": "哦，这是镰刀。我"}, {"type": "subtitle", "time": 19591.59, "timestamp": "05:26:31", "text": "以为是s。哦，没事了。哦，呃，"}, {"type": "subtitle", "time": 19593.948, "timestamp": "05:26:33", "text": "失望的"}, {"type": "subtitle", "time": 19597.99, "timestamp": "05:26:37", "text": "噪音。我的天哪。枪。向量是"}, {"type": "subtitle", "time": 19606.99, "timestamp": "05:26:46", "text": "VSS？ VSS。看起来像个狙击手"}, {"type": "subtitle", "time": 19609.708, "timestamp": "05:26:49", "text": "尽管。你走路的样子像个"}, {"type": "subtitle", "time": 19617.35, "timestamp": "05:26:57", "text": "步行。谁在那儿开枪？我不能"}]
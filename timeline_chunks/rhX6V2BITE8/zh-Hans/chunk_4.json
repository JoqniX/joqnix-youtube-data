[{"type": "subtitle", "time": 240.229, "timestamp": "00:04:00", "text": "嗯，是的，考试，从第二周开始。"}, {"type": "subtitle", "time": 244.229, "timestamp": "00:04:04", "text": "继续前进，而且我还得去……呃……这个"}, {"type": "subtitle", "time": 247.589, "timestamp": "00:04:07", "text": "在最后最后一秒举行的COE仪式"}, {"type": "subtitle", "time": 250.39, "timestamp": "00:04:10", "text": "本月和上月的这一周"}, {"type": "subtitle", "time": 252.35, "timestamp": "00:04:12", "text": "本周我得收拾行李了。"}, {"type": "subtitle", "time": 255.589, "timestamp": "00:04:15", "text": "一切。备份我的备份。我没有"}, {"type": "subtitle", "time": 257.99, "timestamp": "00:04:17", "text": "我甚至还有时间备份我的东西。"}, {"type": "subtitle", "time": 261.11, "timestamp": "00:04:21", "text": "谷歌云端硬盘，兄弟。对，那就是你，表哥"}, {"type": "subtitle", "time": 264.15, "timestamp": "00:04:24", "text": "我要走了。我要放弃我的电脑了。"}, {"type": "subtitle", "time": 266.07, "timestamp": "00:04:26", "text": "去日本买一台笔记本电脑"}, {"type": "subtitle", "time": 267.87, "timestamp": "00:04:27", "text": "东西。所以，我必须"}, {"type": "subtitle", "time": 270.87, "timestamp": "00:04:30", "text": "不知怎的，又想了想，想想会发生什么。"}, {"type": "subtitle", "time": 272.909, "timestamp": "00:04:32", "text": "我喜欢得到"}, {"type": "subtitle", "time": 277.35, "timestamp": "00:04:37", "text": "我的，该怎么称呼它？获取存储空间"}, {"type": "subtitle", "time": 280.87, "timestamp": "00:04:40", "text": "系统以及所有你知道的东西"}, {"type": "subtitle", "time": 283.27, "timestamp": "00:04:43", "text": "呃，我的天，不是说游戏，没事的。"}, {"type": "subtitle", "time": 285.43, "timestamp": "00:04:45", "text": "就算输了，游戏也没关系。"}, {"type": "subtitle", "time": 293.469, "timestamp": "00:04:53", "text": "但我真正想说的是"}, {"type": "subtitle", "time": 296.99, "timestamp": "00:04:56", "text": "就是类似这样的东西"}]
[{"type": "subtitle", "time": 14222.07, "timestamp": "03:57:02", "text": "改变城镇。我一直跟她说伊莱恩"}, {"type": "subtitle", "time": 14224.07, "timestamp": "03:57:04", "text": "那是一个恶魔，但她说"}, {"type": "subtitle", "time": 14226.07, "timestamp": "03:57:06", "text": "应该有人去看看那是不是一只猫。"}, {"type": "subtitle", "time": 14228.389, "timestamp": "03:57:08", "text": "可以帮助他们。如果是只猫，我想我们"}, {"type": "subtitle", "time": 14230.63, "timestamp": "03:57:10", "text": "可以在交易中把猫弄出来，因为"}, {"type": "subtitle", "time": 14233.429, "timestamp": "03:57:13", "text": "有人要去另一个地方，所以我们"}, {"type": "subtitle", "time": 14236.79, "timestamp": "03:57:16", "text": "可以一起来看看。"}, {"type": "subtitle", "time": 14240.83, "timestamp": "03:57:20", "text": "哦，我接受。为什么不呢？我碾碎了"}, {"type": "subtitle", "time": 14244.189, "timestamp": "03:57:24", "text": "它。失踪人员、兄弟和"}, {"type": "subtitle", "time": 14247.67, "timestamp": "03:57:27", "text": "姐妹。上周，我开始"}, {"type": "subtitle", "time": 14250.87, "timestamp": "03:57:30", "text": "感觉好多了。所以，我亲爱的艾姆拉走了"}, {"type": "subtitle", "time": 14254.11, "timestamp": "03:57:34", "text": "在……向母亲表达感谢"}, {"type": "subtitle", "time": 14257.67, "timestamp": "03:57:37", "text": "巨石回归。有人帮忙带"}, {"type": "subtitle", "time": 14259.83, "timestamp": "03:57:39", "text": "请把他还给我。我感觉不到"}, {"type": "subtitle", "time": 14262.469, "timestamp": "03:57:42", "text": "我有足够的信心亲自去找他。顶部"}, {"type": "subtitle", "time": 14266.55, "timestamp": "03:57:46", "text": "模特不仅对我来说是这样，而且"}, {"type": "subtitle", "time": 14269.269, "timestamp": "03:57:49", "text": "它还可以阻止他……"}, {"type": "subtitle", "time": 14274.03, "timestamp": "03:57:54", "text": "伤害。"}, {"type": "subtitle", "time": 14276.269, "timestamp": "03:57:56", "text": "好的。又一个失踪者"}]
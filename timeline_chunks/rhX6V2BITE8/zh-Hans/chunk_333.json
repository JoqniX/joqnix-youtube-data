[{"type": "subtitle", "time": 19983.07, "timestamp": "05:33:03", "text": "弹药。但是谁在敲门？"}, {"type": "subtitle", "time": 19987.43, "timestamp": "05:33:07", "text": "我之前听到的走路声？"}, {"type": "subtitle", "time": 19990.47, "timestamp": "05:33:10", "text": "那个令人毛骨悚然的家伙是谁？"}, {"type": "subtitle", "time": 19998.39, "timestamp": "05:33:18", "text": "更早一些？肯定有人在。"}, {"type": "subtitle", "time": 20006.788, "timestamp": "05:33:26", "text": "疯狂的。你怎么总能看到人们"}, {"type": "subtitle", "time": 20023.27, "timestamp": "05:33:43", "text": "[音乐]"}, {"type": "subtitle", "time": 20031.27, "timestamp": "05:33:51", "text": "范围。哦，我在哪里？这"}, {"type": "subtitle", "time": 20033.99, "timestamp": "05:33:53", "text": "游戏没有方向感。我不能"}, {"type": "subtitle", "time": 20035.83, "timestamp": "05:33:55", "text": "理解子弹的含义。它在哪里"}]
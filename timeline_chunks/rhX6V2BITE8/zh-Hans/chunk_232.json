[{"type": "subtitle", "time": 13921.03, "timestamp": "03:52:01", "text": "我用我的直播电脑，它发热量很大。"}, {"type": "subtitle", "time": 13923.99, "timestamp": "03:52:03", "text": "生成的是阿里，我明白了。但是"}, {"type": "subtitle", "time": 13926.309, "timestamp": "03:52:06", "text": "地方已被洪水淹没。那么现在怎么办？我们"}, {"type": "subtitle", "time": 13929.429, "timestamp": "03:52:09", "text": "我们只能等待。是的。现在应该"}, {"type": "subtitle", "time": 13931.99, "timestamp": "03:52:11", "text": "只是时间问题。是的。就像这样"}, {"type": "subtitle", "time": 13934.63, "timestamp": "03:52:14", "text": "我们没事。我不知道该修什么。"}, {"type": "subtitle", "time": 13937.99, "timestamp": "03:52:17", "text": "如何才能修复我们所有人的屁股？得到"}, {"type": "subtitle", "time": 13941.429, "timestamp": "03:52:21", "text": "回到农场。我会告诉吉尔你是"}, {"type": "subtitle", "time": 13946.91, "timestamp": "03:52:26", "text": "好的。你知道，对一个陌生人来说。全部"}, {"type": "subtitle", "time": 13948.91, "timestamp": "03:52:28", "text": "正确的。只是"}, {"type": "subtitle", "time": 13952.15, "timestamp": "03:52:32", "text": "这里。我的车在哪儿？在那里"}, {"type": "subtitle", "time": 13967.03, "timestamp": "03:52:47", "text": "后退。是啊，那些虫子爬到我跟前。"}, {"type": "subtitle", "time": 13967.19, "timestamp": "03:52:47", "text": "和"}, {"type": "subtitle", "time": 13975.75, "timestamp": "03:52:55", "text": "哦，不。哦，不。哦，不。哦，不。哦，不。哦"}, {"type": "subtitle", "time": 13977.389, "timestamp": "03:52:57", "text": "不。哦，不。他正在"}]
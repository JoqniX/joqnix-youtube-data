[{"type": "subtitle", "time": 2220.15, "timestamp": "00:37:00", "text": "或者我们也可以绕道去做。"}, {"type": "subtitle", "time": 2224.15, "timestamp": "00:37:04", "text": "本周也是如此。嗯，这个周末也是。"}, {"type": "subtitle", "time": 2228.47, "timestamp": "00:37:08", "text": "可能会让你陷入某种境地"}, {"type": "subtitle", "time": 2232.109, "timestamp": "00:37:12", "text": "我相信，如果我们要做这件事的话，就是那几天。"}, {"type": "subtitle", "time": 2235.27, "timestamp": "00:37:15", "text": "嗯，我们最多可以做2个小时或者1个小时。"}, {"type": "subtitle", "time": 2239.19, "timestamp": "00:37:19", "text": "如果你不介意的话，最少一小时。呃"}, {"type": "subtitle", "time": 2242.39, "timestamp": "00:37:22", "text": "如果你不介意的话。所以，呃，星期五的"}, {"type": "subtitle", "time": 2244.31, "timestamp": "00:37:24", "text": "我得戴着口罩确认一下。"}, {"type": "subtitle", "time": 2247.27, "timestamp": "00:37:27", "text": "我这就去做。呃，这是"}, {"type": "subtitle", "time": 2251.47, "timestamp": "00:37:31", "text": "确认的。算了。渡鸦之子和冲刺。"}, {"type": "subtitle", "time": 2254.47, "timestamp": "00:37:34", "text": "呃，等等，我忘了在这里添加一个人。呃"}, {"type": "subtitle", "time": 2256.03, "timestamp": "00:37:36", "text": "这是"}, {"type": "subtitle", "time": 2259.27, "timestamp": "00:37:39", "text": "呃，等等，它们是太阳吗？哦，是的。"}, {"type": "subtitle", "time": 2262.31, "timestamp": "00:37:42", "text": "星期日。哦，对，这是谁？"}, {"type": "subtitle", "time": 2266.19, "timestamp": "00:37:46", "text": "我决定周六上课。"}, {"type": "subtitle", "time": 2269.03, "timestamp": "00:37:49", "text": "再次。糟糕。嗯，露出我的D。我是"}, {"type": "subtitle", "time": 2271.75, "timestamp": "00:37:51", "text": "对不起。呃，我刚才在扮演谁来着？"}, {"type": "subtitle", "time": 2275.91, "timestamp": "00:37:55", "text": "又是星期六？呃，等等，让我查一下。"}, {"type": "subtitle", "time": 2279.99, "timestamp": "00:37:59", "text": "H，情圣。情圣。情人男孩之歌"}]
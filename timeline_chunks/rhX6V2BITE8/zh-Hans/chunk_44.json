[{"type": "subtitle", "time": 2642.79, "timestamp": "00:44:02", "text": "团队合作，对吧？所以，我当时在想"}, {"type": "subtitle", "time": 2646.63, "timestamp": "00:44:06", "text": "因为我做了，所以我进行了一次一对一的单独训练"}, {"type": "subtitle", "time": 2649.91, "timestamp": "00:44:09", "text": "因为我和……一起聚会了"}, {"type": "subtitle", "time": 2652.63, "timestamp": "00:44:12", "text": "富士和凯拉将与凯拉一起做这件事"}, {"type": "subtitle", "time": 2657.75, "timestamp": "00:44:17", "text": "后来是101。最初这次合作是为了"}, {"type": "subtitle", "time": 2660.63, "timestamp": "00:44:20", "text": "今晚大约晚上9点。嗯，我觉得"}, {"type": "subtitle", "time": 2664.95, "timestamp": "00:44:24", "text": "现在是10点，对吧？我把它改成10。"}, {"type": "subtitle", "time": 2669.15, "timestamp": "00:44:29", "text": "我把它改成10。应该是这样。"}, {"type": "subtitle", "time": 2673.51, "timestamp": "00:44:33", "text": "虽然是单人模式，但事情就这样发生了。"}, {"type": "subtitle", "time": 2677.43, "timestamp": "00:44:37", "text": "它变成了一个团体活动。所以，我"}, {"type": "subtitle", "time": 2680.63, "timestamp": "00:44:40", "text": "仍然不想把Aka分开。我"}, {"type": "subtitle", "time": 2683.51, "timestamp": "00:44:43", "text": "想给他一次一对一的机会"}, {"type": "subtitle", "time": 2686.99, "timestamp": "00:44:46", "text": "和我们一起享受独处的时光。所以当时"}, {"type": "subtitle", "time": 2689.51, "timestamp": "00:44:49", "text": "他还在思考，而且他现在也发了信息。"}, {"type": "subtitle", "time": 2692.55, "timestamp": "00:44:52", "text": "我问过他。所以是下午 4 点。没错"}, {"type": "subtitle", "time": 2697.23, "timestamp": "00:44:57", "text": "巴利语。呃，所以我就想，也许我"}]
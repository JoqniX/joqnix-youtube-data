[{"type": "subtitle", "time": 15543.469, "timestamp": "04:19:03", "text": "我想念我的，我想念我的"}, {"type": "subtitle", "time": 15553.71, "timestamp": "04:19:13", "text": "坏的。我投篮不中。"}, {"type": "subtitle", "time": 15582.469, "timestamp": "04:19:42", "text": "这两枪足以致命。你是"}, {"type": "subtitle", "time": 15592.309, "timestamp": "04:19:52", "text": "哦，所以他们不能来，你知道，来"}, {"type": "subtitle", "time": 15594.91, "timestamp": "04:19:54", "text": "看着你"}]
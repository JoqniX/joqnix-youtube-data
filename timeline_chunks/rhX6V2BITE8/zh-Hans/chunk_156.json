[{"type": "subtitle", "time": 9362.349, "timestamp": "02:36:02", "text": "给予曾经给予的人"}, {"type": "subtitle", "time": 9381.75, "timestamp": "02:36:21", "text": "东西？我觉得我得好好翻翻我的回复。"}, {"type": "subtitle", "time": 9400.23, "timestamp": "02:36:40", "text": "呃，是哪一个？哦，我刚才说的是……"}, {"type": "subtitle", "time": 9404.07, "timestamp": "02:36:44", "text": "你知道，那个失眠症患者"}, {"type": "subtitle", "time": 9407.79, "timestamp": "02:36:47", "text": "吸血鬼题材动漫。那个。我在……上看到了。"}, {"type": "subtitle", "time": 9419.75, "timestamp": "02:36:59", "text": "哦，对，我通过聊天认识了一些朋友。"}]
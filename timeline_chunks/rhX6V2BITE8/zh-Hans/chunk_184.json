[{"type": "subtitle", "time": 11058.87, "timestamp": "03:04:18", "text": "抱歉。我应该在……的时候静音"}, {"type": "subtitle", "time": 11061.67, "timestamp": "03:04:21", "text": "咳嗽。昏迷。我还没恢复过来。"}, {"type": "subtitle", "time": 11065.389, "timestamp": "03:04:25", "text": "来自我的颤抖。"}, {"type": "subtitle", "time": 11069.03, "timestamp": "03:04:29", "text": "我的天哪，世界真大。"}, {"type": "subtitle", "time": 11072.55, "timestamp": "03:04:32", "text": "莉娜，收到请回答？真美"}, {"type": "subtitle", "time": 11075.269, "timestamp": "03:04:35", "text": "拨号上网。"}, {"type": "subtitle", "time": 11076.87, "timestamp": "03:04:36", "text": "听着。你那独眼谵妄"}, {"type": "subtitle", "time": 11078.389, "timestamp": "03:04:38", "text": "病人。他说的是实话。那里"}, {"type": "subtitle", "time": 11080.15, "timestamp": "03:04:40", "text": "这是一条出路。也许他说的那些话"}, {"type": "subtitle", "time": 11082.79, "timestamp": "03:04:42", "text": "那些不悔改的人是真的。他去世了"}, {"type": "subtitle", "time": 11085.83, "timestamp": "03:04:45", "text": "今天早上，凯尔。他发烧了。"}, {"type": "subtitle", "time": 11088.87, "timestamp": "03:04:48", "text": "你的发烧传染给了他。不。查找"}, {"type": "subtitle", "time": 11091.19, "timestamp": "03:04:51", "text": "某处。谁知道这个传闻？"}, {"type": "subtitle", "time": 11096.15, "timestamp": "03:04:56", "text": "好的，莉娜。感觉真好。操"}, {"type": "subtitle", "time": 11098.23, "timestamp": "03:04:58", "text": "你知道，就是山。想象一下，如果你是"}]
[{"type": "subtitle", "time": 2941.71, "timestamp": "00:49:01", "text": "尼科桑"}, {"type": "subtitle", "time": 2946.15, "timestamp": "00:49:06", "text": "出色地。我知道尼科桑的出场时间。我"}, {"type": "subtitle", "time": 2948.71, "timestamp": "00:49:08", "text": "我也得弄到那个。克莱门西是"}, {"type": "subtitle", "time": 2950.71, "timestamp": "00:49:10", "text": "感兴趣的。所以，我将获得"}, {"type": "subtitle", "time": 2956.109, "timestamp": "00:49:16", "text": "宽恕。我相信宽恕是"}, {"type": "subtitle", "time": 2960.71, "timestamp": "00:49:20", "text": "呃，8点半怎么样？当然可以。好的。"}, {"type": "subtitle", "time": 2964.39, "timestamp": "00:49:24", "text": "赤村确认时间是8:30。所以，我"}, {"type": "subtitle", "time": 2966.829, "timestamp": "00:49:26", "text": "我会把它放在这里。"}, {"type": "subtitle", "time": 2971.51, "timestamp": "00:49:31", "text": "8:30好的。克莱门斯怎么样？我 我 你"}, {"type": "subtitle", "time": 2973.829, "timestamp": "00:49:33", "text": "你知道吗，有趣的是，今天早上我"}, {"type": "subtitle", "time": 2976.069, "timestamp": "00:49:36", "text": "昨天重新启动了15人的工作。"}, {"type": "subtitle", "time": 2979.51, "timestamp": "00:49:39", "text": "晚上我重新开始，呃，七个人。"}, {"type": "subtitle", "time": 2982.069, "timestamp": "00:49:42", "text": "名单还在不断增加。我害怕如果我"}, {"type": "subtitle", "time": 2985.03, "timestamp": "00:49:45", "text": "无法让所有人都进来。此时此刻，我"}, {"type": "subtitle", "time": 2993.79, "timestamp": "00:49:53", "text": "兄弟。好的。"}, {"type": "subtitle", "time": 2998.03, "timestamp": "00:49:58", "text": "嗯，克莱门特的演出季在晚上9点10分之后。"}]
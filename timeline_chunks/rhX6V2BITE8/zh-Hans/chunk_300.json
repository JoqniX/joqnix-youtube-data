[{"type": "subtitle", "time": 18000.99, "timestamp": "05:00:00", "text": "某种程度上来说，算是系统吧。所以，"}, {"type": "subtitle", "time": 18003.27, "timestamp": "05:00:03", "text": "是的。别担心。无论是单人还是"}, {"type": "subtitle", "time": 18006.75, "timestamp": "05:00:06", "text": "得分优势"}, {"type": "subtitle", "time": 18010.15, "timestamp": "05:00:10", "text": "优势。所以，呃，我们要去……我想"}, {"type": "subtitle", "time": 18013.51, "timestamp": "05:00:13", "text": "我们可以和伊朗队比赛。所以，新事物是"}, {"type": "subtitle", "time": 18017.43, "timestamp": "05:00:17", "text": "这次更新来了，这就像是为了……"}, {"type": "subtitle", "time": 18020.07, "timestamp": "05:00:20", "text": "10天，这是一个为期10天或11天的活动，或者"}, {"type": "subtitle", "time": 18023.19, "timestamp": "05:00:23", "text": "经典之作"}, {"type": "subtitle", "time": 18025.75, "timestamp": "05:00:25", "text": "地图将回归这款游戏"}, {"type": "subtitle", "time": 18029.27, "timestamp": "05:00:29", "text": "显然。我打算单枪匹马先走。"}, {"type": "subtitle", "time": 18031.35, "timestamp": "05:00:31", "text": "人物模式。我不打三垒。"}, {"type": "subtitle", "time": 18035.23, "timestamp": "05:00:35", "text": "根本不是人。呃，眨眼。但"}, {"type": "subtitle", "time": 18036.91, "timestamp": "05:00:36", "text": "好，我们开始吧"}, {"type": "subtitle", "time": 18040.23, "timestamp": "05:00:40", "text": "查看。呃，我应该……呃，我应该在……吗？"}, {"type": "subtitle", "time": 18042.39, "timestamp": "05:00:42", "text": "尝试训练？我应该参加培训吗？"}, {"type": "subtitle", "time": 18049.07, "timestamp": "05:00:49", "text": "知道。我的朋友更多了。都是我。"}, {"type": "subtitle", "time": 18051.59, "timestamp": "05:00:51", "text": "还。我的意思是，我没有朋友。"}, {"type": "subtitle", "time": 18054.948, "timestamp": "05:00:54", "text": "玩PUBG的人。所以，是的，我不认为"}, {"type": "subtitle", "time": 18057.43, "timestamp": "05:00:57", "text": "他们中的大多数人甚至都不会玩。所以"}]
[{"type": "subtitle", "time": 10980.95, "timestamp": "03:03:00", "text": "头脑。我超喜欢这个DLC。为……增添了很多内容"}, {"type": "subtitle", "time": 10983.83, "timestamp": "03:03:03", "text": "故事情节和新的游戏机制。好好享受"}, {"type": "subtitle", "time": 10987.83, "timestamp": "03:03:07", "text": "亲爱的。希望你也喜欢。"}, {"type": "subtitle", "time": 10989.71, "timestamp": "03:03:09", "text": "我也是"}, {"type": "subtitle", "time": 10992.99, "timestamp": "03:03:12", "text": "大肆宣传。这是什么？"}, {"type": "subtitle", "time": 10996.07, "timestamp": "03:03:16", "text": "符号？当然，我没有弹药。"}, {"type": "subtitle", "time": 10999.75, "timestamp": "03:03:19", "text": "那把枪里的东西。消音德国手枪。"}, {"type": "subtitle", "time": 11003.99, "timestamp": "03:03:23", "text": "我没有消音弹药。哦，我"}, {"type": "subtitle", "time": 11005.79, "timestamp": "03:03:25", "text": "实际上并没有"}, {"type": "subtitle", "time": 11009.63, "timestamp": "03:03:29", "text": "弹药？我非常喜欢"}, {"type": "subtitle", "time": 11013.83, "timestamp": "03:03:33", "text": "东西。 14 美极了。哇。好的。呃，如果"}, {"type": "subtitle", "time": 11015.83, "timestamp": "03:03:35", "text": "既然如此，我就写“等等，做”吧。"}, {"type": "subtitle", "time": 11024.79, "timestamp": "03:03:44", "text": "猜测。呃，我想我会把弓放上去。不"}, {"type": "subtitle", "time": 11039.83, "timestamp": "03:03:59", "text": "剑。哦，这是我之前没用过的新垫片。"}]
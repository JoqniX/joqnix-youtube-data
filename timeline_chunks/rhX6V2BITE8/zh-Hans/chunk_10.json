[{"type": "subtitle", "time": 602.47, "timestamp": "00:10:02", "text": "甚至有机会与他们合作"}, {"type": "subtitle", "time": 604.71, "timestamp": "00:10:04", "text": "然后我就说，“是的，我们可以做"}, {"type": "subtitle", "time": 607.11, "timestamp": "00:10:07", "text": "我在日本安顿下来之后，就一直在做这件事。"}, {"type": "subtitle", "time": 609.99, "timestamp": "00:10:09", "text": "就像我一样，我有，我有"}, {"type": "subtitle", "time": 612.23, "timestamp": "00:10:12", "text": "适合流媒体播放和游戏的环境"}, {"type": "subtitle", "time": 614.55, "timestamp": "00:10:14", "text": "玩游戏、和平聊天之类的，"}, {"type": "subtitle", "time": 616.87, "timestamp": "00:10:16", "text": "那我就可以做到。我总能抽出时间"}, {"type": "subtitle", "time": 619.269, "timestamp": "00:10:19", "text": "对他们来说。”不。所以，没关系。我是"}, {"type": "subtitle", "time": 621.389, "timestamp": "00:10:21", "text": "考虑这样做"}, {"type": "subtitle", "time": 623.71, "timestamp": "00:10:23", "text": "那。所以，"}, {"type": "subtitle", "time": 627.269, "timestamp": "00:10:27", "text": "因为我再次明白了真正的"}, {"type": "subtitle", "time": 631.15, "timestamp": "00:10:31", "text": "现实是，我不可能让每个人都满意。"}, {"type": "subtitle", "time": 634.63, "timestamp": "00:10:34", "text": "让所有人都参与进来等等，但是"}, {"type": "subtitle", "time": 638.19, "timestamp": "00:10:38", "text": "我仍然想那样做，我想打破"}, {"type": "subtitle", "time": 641.59, "timestamp": "00:10:41", "text": "那种误解或错误观念"}, {"type": "subtitle", "time": 645.269, "timestamp": "00:10:45", "text": "是啊，这会很难，别这么做，别这么做。"}, {"type": "subtitle", "time": 647.509, "timestamp": "00:10:47", "text": "边界，但我想要展示并证明这一点"}, {"type": "subtitle", "time": 651.11, "timestamp": "00:10:51", "text": "为了向自己证明这一点，每当我"}, {"type": "subtitle", "time": 653.19, "timestamp": "00:10:53", "text": "他说我会向自己证明这一点。"}, {"type": "subtitle", "time": 656.069, "timestamp": "00:10:56", "text": "你已经看到我拥有多少了，呃，我会"}, {"type": "subtitle", "time": 658.31, "timestamp": "00:10:58", "text": "我得拼命努力多久？"}]
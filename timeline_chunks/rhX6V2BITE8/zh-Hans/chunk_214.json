[{"type": "subtitle", "time": 12840.15, "timestamp": "03:34:00", "text": "讨价还价者。还想讨价还价吗？告诉"}, {"type": "subtitle", "time": 12842.469, "timestamp": "03:34:02", "text": "瓦陶，我或许会让你交换你的"}, {"type": "subtitle", "time": 12845.03, "timestamp": "03:34:05", "text": "骑车去弄点水。去你的，"}, {"type": "subtitle", "time": 12848.55, "timestamp": "03:34:08", "text": "混蛋。就这样吧。好了，孩子们。他"}, {"type": "subtitle", "time": 12855.429, "timestamp": "03:34:15", "text": "再见。"}, {"type": "subtitle", "time": 12857.83, "timestamp": "03:34:17", "text": "哦不，我死了。我没有做健康检查。"}, {"type": "subtitle", "time": 12861.03, "timestamp": "03:34:21", "text": "我的天哪。没关系。没关系。没关系。"}, {"type": "subtitle", "time": 12862.67, "timestamp": "03:34:22", "text": "它是"}, {"type": "subtitle", "time": 12865.11, "timestamp": "03:34:25", "text": "好的。该国位于该国境内"}, {"type": "subtitle", "time": 12866.63, "timestamp": "03:34:26", "text": "速度就是一切。你走得越快，"}, {"type": "subtitle", "time": 12868.71, "timestamp": "03:34:28", "text": "你拥有的驱动骨骼越多。更容易"}, {"type": "subtitle", "time": 12872.07, "timestamp": "03:34:32", "text": "撼动病毒式传播和追逐你的流量"}, {"type": "subtitle", "time": 12874.349, "timestamp": "03:34:34", "text": "道路。好的。所以，速度。"}, {"type": "subtitle", "time": 12883.63, "timestamp": "03:34:43", "text": "速度。我在哪里？"}, {"type": "subtitle", "time": 12886.99, "timestamp": "03:34:46", "text": "我？这是什么？"}, {"type": "subtitle", "time": 12892.349, "timestamp": "03:34:52", "text": "地方？这是哪里？我目前为止"}]
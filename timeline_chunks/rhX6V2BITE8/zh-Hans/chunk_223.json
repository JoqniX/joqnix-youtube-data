[{"type": "subtitle", "time": 13381.229, "timestamp": "03:43:01", "text": "所以"}, {"type": "subtitle", "time": 13385.63, "timestamp": "03:43:05", "text": "哑的。从上往下。这一切都是这样的。"}, {"type": "subtitle", "time": 13389.11, "timestamp": "03:43:09", "text": "时间。芝麻开门。"}, {"type": "subtitle", "time": 13398.71, "timestamp": "03:43:18", "text": "好吧，我真的……我的天哪，好害怕"}, {"type": "subtitle", "time": 13401.07, "timestamp": "03:43:21", "text": "我。哦"}, {"type": "subtitle", "time": 13406.99, "timestamp": "03:43:26", "text": "上帝。我的天啊，老兄。这家伙吓到我了。"}, {"type": "subtitle", "time": 13409.67, "timestamp": "03:43:29", "text": "我。你怎么了？我的天啊。"}, {"type": "subtitle", "time": 13412.79, "timestamp": "03:43:32", "text": "贾齐尔派我来的。嗯，埃斯基做到了。你是"}, {"type": "subtitle", "time": 13415.03, "timestamp": "03:43:35", "text": "迷路的三人之一。唯一"}, {"type": "subtitle", "time": 13417.51, "timestamp": "03:43:37", "text": "还剩一个。我是艾莉。你被扔进了"}, {"type": "subtitle", "time": 13419.67, "timestamp": "03:43:39", "text": "那头野兽。他们被卷入了那件事。"}, {"type": "subtitle", "time": 13422.07, "timestamp": "03:43:42", "text": "那头野兽。好了，阿里，听着。这个地方"}, {"type": "subtitle", "time": 13423.91, "timestamp": "03:43:43", "text": "至少要具备一定的运行能力。"}, {"type": "subtitle", "time": 13425.349, "timestamp": "03:43:45", "text": "否则，强盗们就不会……"}, {"type": "subtitle", "time": 13428.229, "timestamp": "03:43:48", "text": "任何水。强盗们这里有水。"}, {"type": "subtitle", "time": 13431.67, "timestamp": "03:43:51", "text": "但农场里没有。也许"}, {"type": "subtitle", "time": 13434.63, "timestamp": "03:43:54", "text": "我们可以重定向他们。是的，我们想要。我们"}]
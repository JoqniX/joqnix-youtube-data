[{"type": "subtitle", "time": 2821.03, "timestamp": "00:47:01", "text": "科尔达玛，我必须把他弄到手。而韩韩是"}, {"type": "subtitle", "time": 2823.79, "timestamp": "00:47:03", "text": "我相信我们已经解决了他的问题。"}, {"type": "subtitle", "time": 2827.67, "timestamp": "00:47:07", "text": "明天晚上7:30事情完成了。巴利语"}, {"type": "subtitle", "time": 2828.829, "timestamp": "00:47:08", "text": "我要抓住他"}, {"type": "subtitle", "time": 2832.63, "timestamp": "00:47:12", "text": "今天。 Tommo Akumasa 今天是第三名"}, {"type": "subtitle", "time": 2836.79, "timestamp": "00:47:16", "text": "六月。所以明天我得私信他。"}, {"type": "subtitle", "time": 2838.79, "timestamp": "00:47:18", "text": "呃，明天或者后天我有"}, {"type": "subtitle", "time": 2842.63, "timestamp": "00:47:22", "text": "私信问问他。惊人的。 K 我有"}, {"type": "subtitle", "time": 2846.39, "timestamp": "00:47:26", "text": "六月中旬给他发私信。那是13、14"}, {"type": "subtitle", "time": 2850.15, "timestamp": "00:47:30", "text": "大约在那个日期前后15天。我稍后会私信他。"}, {"type": "subtitle", "time": 2853.109, "timestamp": "00:47:33", "text": "熏肉。是为了培根。我觉得我"}, {"type": "subtitle", "time": 2855.069, "timestamp": "00:47:35", "text": "把他放"}, {"type": "subtitle", "time": 2858.069, "timestamp": "00:47:38", "text": "某处。培根节是6月16日。所以我可以"}, {"type": "subtitle", "time": 2860.51, "timestamp": "00:47:40", "text": "把他撤职。"}, {"type": "subtitle", "time": 2865.19, "timestamp": "00:47:45", "text": "拉安。我记得把Laan放进去"}, {"type": "subtitle", "time": 2867.67, "timestamp": "00:47:47", "text": "她身在某个地方。是的。是的，6月12日。我"}, {"type": "subtitle", "time": 2871.39, "timestamp": "00:47:51", "text": "可以把她赶走。沃尔特儿子说"}, {"type": "subtitle", "time": 2875.349, "timestamp": "00:47:55", "text": "某物。天哪，我是不是泄露了私信？"}, {"type": "subtitle", "time": 2876.67, "timestamp": "00:47:56", "text": "现在？我不"}, {"type": "subtitle", "time": 2878.88, "timestamp": "00:47:58", "text": "知道。我必须"}]
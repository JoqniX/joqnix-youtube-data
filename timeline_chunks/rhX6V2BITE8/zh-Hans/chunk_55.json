[{"type": "subtitle", "time": 3303.829, "timestamp": "00:55:03", "text": "考试，呃，6月10日至11日结束。"}, {"type": "subtitle", "time": 3306.95, "timestamp": "00:55:06", "text": "卡塞利纳儿子，我相信我还没有给过"}, {"type": "subtitle", "time": 3309.069, "timestamp": "00:55:09", "text": "她"}, {"type": "subtitle", "time": 3313.19, "timestamp": "00:55:13", "text": "日期。还有一些新加坡人"}, {"type": "subtitle", "time": 3316.15, "timestamp": "00:55:16", "text": "我曾加入过的印尼YouTube博主群"}, {"type": "subtitle", "time": 3318.95, "timestamp": "00:55:18", "text": "与……合作。我还需要联系对方。"}, {"type": "subtitle", "time": 3321.03, "timestamp": "00:55:21", "text": "还有一位我需要关注的YouTuber"}, {"type": "subtitle", "time": 3323.349, "timestamp": "00:55:23", "text": "试图联系他们，但他们体型巨大，非常非常大。"}, {"type": "subtitle", "time": 3326.71, "timestamp": "00:55:26", "text": "我很害怕。这样可以吗？但它是"}, {"type": "subtitle", "time": 3329.75, "timestamp": "00:55:29", "text": "美好的。嗯，这时我已经习惯了。"}, {"type": "subtitle", "time": 3331.51, "timestamp": "00:55:31", "text": "此时此刻，拒绝和其他一切都发生了。"}, {"type": "subtitle", "time": 3334.549, "timestamp": "00:55:34", "text": "自从我开始涉猎以来"}, {"type": "subtitle", "time": 3339.99, "timestamp": "00:55:39", "text": "最近也进入了JP KR和C以及Vtubish。"}, {"type": "subtitle", "time": 3343.23, "timestamp": "00:55:43", "text": "是的，这很难，但我仍然会坚持下去。"}, {"type": "subtitle", "time": 3345.99, "timestamp": "00:55:45", "text": "尝试。好的。呃，别担心，如果我能"}, {"type": "subtitle", "time": 3347.91, "timestamp": "00:55:47", "text": "我可以申请从事视频制作方面的工作吗？"}, {"type": "subtitle", "time": 3349.75, "timestamp": "00:55:49", "text": "而且我也完成了。所以我努力工作"}, {"type": "subtitle", "time": 3351.91, "timestamp": "00:55:51", "text": "18至21岁可参加考试。目前不提供此项服务。"}, {"type": "subtitle", "time": 3353.91, "timestamp": "00:55:53", "text": "那。所以如果我加入你们，大概会……"}, {"type": "subtitle", "time": 3356.39, "timestamp": "00:55:56", "text": "Gotcha 的节目。明白了。明白了。这"}, {"type": "subtitle", "time": 3359.19, "timestamp": "00:55:59", "text": "问题是，我能做到的极限就是直到"}]
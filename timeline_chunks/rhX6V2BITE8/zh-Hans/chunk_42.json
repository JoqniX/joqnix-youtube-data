[{"type": "subtitle", "time": 2522.15, "timestamp": "00:42:02", "text": "可以把他安排在周六哦耶。是的。我有"}, {"type": "subtitle", "time": 2528.95, "timestamp": "00:42:08", "text": "是的。我周六要见他。"}, {"type": "subtitle", "time": 2532.87, "timestamp": "00:42:12", "text": "这是我2021年认识的一个人。"}, {"type": "subtitle", "time": 2536.15, "timestamp": "00:42:16", "text": "惊人的。昆曼。这家伙本该"}, {"type": "subtitle", "time": 2539.309, "timestamp": "00:42:19", "text": "首次亮相，伙计。犹太"}, {"type": "subtitle", "time": 2542.79, "timestamp": "00:42:22", "text": "笨蛋。是的。 INVtuber。它本应如此"}, {"type": "subtitle", "time": 2545.43, "timestamp": "00:42:25", "text": "首次亮相。他从未正式推出过。我仍然怀念"}, {"type": "subtitle", "time": 2547.75, "timestamp": "00:42:27", "text": "他。我觉得大家都忘了这件事。"}, {"type": "subtitle", "time": 2550.55, "timestamp": "00:42:30", "text": "虽然他已经不在了，但我仍然记得他。他真是"}, {"type": "subtitle", "time": 2551.23, "timestamp": "00:42:31", "text": "一个"}, {"type": "subtitle", "time": 2553.99, "timestamp": "00:42:33", "text": "亲爱的。真是个贴心的人。甜的"}, {"type": "subtitle", "time": 2555.109, "timestamp": "00:42:35", "text": "人。"}, {"type": "subtitle", "time": 2557.87, "timestamp": "00:42:37", "text": "我认为大约在那个时候，我"}, {"type": "subtitle", "time": 2560.63, "timestamp": "00:42:40", "text": "就好像我不知道自己以前不知道什么一样。"}, {"type": "subtitle", "time": 2563.589, "timestamp": "00:42:43", "text": "他知道什么是工作简历，而他就是那个人。"}, {"type": "subtitle", "time": 2565.51, "timestamp": "00:42:45", "text": "当时谁在我的服务器上帮助我？"}, {"type": "subtitle", "time": 2567.99, "timestamp": "00:42:47", "text": "诸如“是啊，骑师可以做到这一点”之类的话"}, {"type": "subtitle", "time": 2569.95, "timestamp": "00:42:49", "text": "以及这个和"}, {"type": "subtitle", "time": 2573.829, "timestamp": "00:42:53", "text": "那天我不小心做了件……呃……"}, {"type": "subtitle", "time": 2574.91, "timestamp": "00:42:54", "text": "我的"}, {"type": "subtitle", "time": 2577.55, "timestamp": "00:42:57", "text": "搁浅了，但没人看到，所以我……"}]
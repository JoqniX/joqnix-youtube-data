[{"type": "subtitle", "time": 11640.95, "timestamp": "03:14:00", "text": "朋友，拿点面包来。返回"}, {"type": "subtitle", "time": 11644.99, "timestamp": "03:14:04", "text": "她。什么？不，别开枪打我。我"}, {"type": "subtitle", "time": 11647.87, "timestamp": "03:14:07", "text": "捣乱。"}, {"type": "subtitle", "time": 11651.59, "timestamp": "03:14:11", "text": "不，别这样。"}, {"type": "subtitle", "time": 11654.429, "timestamp": "03:14:14", "text": "至少我会四处看看。"}, {"type": "subtitle", "time": 11657.03, "timestamp": "03:14:17", "text": "东西。你之前说的面包在哪里？"}, {"type": "subtitle", "time": 11658.67, "timestamp": "03:14:18", "text": "我"}, {"type": "subtitle", "time": 11665.349, "timestamp": "03:14:25", "text": "什么？面包在哪儿？好的，我们可以"}, {"type": "subtitle", "time": 11668.63, "timestamp": "03:14:28", "text": "我猜也是。我认为这位女士会帮助我们。"}, {"type": "subtitle", "time": 11675.75, "timestamp": "03:14:35", "text": "该死的。我们身处一片荒芜之地。"}, {"type": "subtitle", "time": 11678.55, "timestamp": "03:14:38", "text": "嘿。对，你过来。哦，这是"}, {"type": "subtitle", "time": 11681.349, "timestamp": "03:14:41", "text": "去帮忙。靠近些。我不会咬人。"}, {"type": "subtitle", "time": 11683.75, "timestamp": "03:14:43", "text": "你。我认为他是在卖商品或者"}, {"type": "subtitle", "time": 11686.309, "timestamp": "03:14:46", "text": "某物。看看那些木头"}, {"type": "subtitle", "time": 11689.429, "timestamp": "03:14:49", "text": "装满东西的箱子或板条箱。所以，你不是"}, {"type": "subtitle", "time": 11692.63, "timestamp": "03:14:52", "text": "其中一个？我认为他就是商人。"}, {"type": "subtitle", "time": 11694.71, "timestamp": "03:14:54", "text": "最有可能的。因为我卖的东西比别人多得多"}, {"type": "subtitle", "time": 11697.429, "timestamp": "03:14:57", "text": "就是面包。顺便说一下，我叫可汗。"}, {"type": "subtitle", "time": 11699.04, "timestamp": "03:14:59", "text": "可汗。 嘿，你是哈兰人，对吧？我敢打赌"}]
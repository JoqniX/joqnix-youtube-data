[{"type": "subtitle", "time": 1149.15, "timestamp": "00:19:09", "text": "戴安娜，给我一个"}, {"type": "subtitle", "time": 1168.31, "timestamp": "00:19:28", "text": "不，我有一些很喜欢的油管博主。"}, {"type": "subtitle", "time": 1169.31, "timestamp": "00:19:29", "text": "合作"}, {"type": "subtitle", "time": 1171.63, "timestamp": "00:19:31", "text": "更新"}, {"type": "subtitle", "time": 1173.15, "timestamp": "00:19:33", "text": "人们，"}, {"type": "subtitle", "time": 1176.35, "timestamp": "00:19:36", "text": "但我心想，"}, {"type": "subtitle", "time": 1180.83, "timestamp": "00:19:40", "text": "呃，伙计，我没有"}, {"type": "subtitle", "time": 1184.47, "timestamp": "00:19:44", "text": "时间不够，因为我必须专注于我身边的人。"}, {"type": "subtitle", "time": 1187.27, "timestamp": "00:19:47", "text": "已经联系过并沟通过了"}, {"type": "subtitle", "time": 1188.87, "timestamp": "00:19:48", "text": "和。我很久没和他们谈过了"}, {"type": "subtitle", "time": 1191.07, "timestamp": "00:19:51", "text": "很久。所以，我专注于"}, {"type": "subtitle", "time": 1193.909, "timestamp": "00:19:53", "text": "与此同时，也试图引入新的"}, {"type": "subtitle", "time": 1195.87, "timestamp": "00:19:55", "text": "人们也"}, {"type": "subtitle", "time": 1199.27, "timestamp": "00:19:59", "text": "之间。所以，到处都有些忙乱。"}]
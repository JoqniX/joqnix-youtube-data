[{"type": "subtitle", "time": 1392.07, "timestamp": "00:23:12", "text": "呃，我超喜欢Gajun店的"}, {"type": "subtitle", "time": 1394.789, "timestamp": "00:23:14", "text": "他们确实支持Visa和Apple Pay。"}, {"type": "subtitle", "time": 1398.39, "timestamp": "00:23:18", "text": "Alip Pay、VChat Pay、银行转账"}, {"type": "subtitle", "time": 1401.59, "timestamp": "00:23:21", "text": "Bit Pay、Amazon Pay、UPI、UPI、Pay Save"}, {"type": "subtitle", "time": 1406.029, "timestamp": "00:23:26", "text": "信用卡、亚马逊支付、Razer Gold Pay"}, {"type": "subtitle", "time": 1408.87, "timestamp": "00:23:28", "text": "PayPal，一切皆可。 Apple Pay。那"}, {"type": "subtitle", "time": 1410.87, "timestamp": "00:23:30", "text": "这正是我想要的。"}, {"type": "subtitle", "time": 1414.39, "timestamp": "00:23:34", "text": "等我有了合适的周边商店，就会建网站了"}, {"type": "subtitle", "time": 1428.549, "timestamp": "00:23:48", "text": "那。我们先把那东西准备好，这样我就可以……"}, {"type": "subtitle", "time": 1430.59, "timestamp": "00:23:50", "text": "买"}, {"type": "subtitle", "time": 1435.71, "timestamp": "00:23:55", "text": "它。这一切都只是为了那一点点免费的东西。"}, {"type": "subtitle", "time": 1438.63, "timestamp": "00:23:58", "text": "喷射。疯狂的。"}]
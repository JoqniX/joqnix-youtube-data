[{"type": "subtitle", "time": 14826.51, "timestamp": "04:07:06", "text": "伪装一下然后进去"}, {"type": "subtitle", "time": 14833.59, "timestamp": "04:07:13", "text": "这是进入的铁。好了，我们走吧。什么"}, {"type": "subtitle", "time": 14863.51, "timestamp": "04:07:43", "text": "区域。哦，等等。我迟早会死"}, {"type": "subtitle", "time": 14866.15, "timestamp": "04:07:46", "text": "此刻。我的天啊。等待。我不"}, {"type": "subtitle", "time": 14875.07, "timestamp": "04:07:55", "text": "愈合。你如何疗愈"}]
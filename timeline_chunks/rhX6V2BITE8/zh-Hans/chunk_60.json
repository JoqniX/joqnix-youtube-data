[{"type": "subtitle", "time": 3600.069, "timestamp": "01:00:00", "text": "呃，我当时和谁在一起？"}, {"type": "subtitle", "time": 3602.39, "timestamp": "01:00:02", "text": "帮我获得类似白名单的资格"}, {"type": "subtitle", "time": 3606.23, "timestamp": "01:00:06", "text": "在比利比利号上登机。所以，"}, {"type": "subtitle", "time": 3608.309, "timestamp": "01:00:08", "text": "呃，但我感觉我必须做出"}, {"type": "subtitle", "time": 3611.27, "timestamp": "01:00:11", "text": "一段合适的中文视频，或者有"}, {"type": "subtitle", "time": 3613.109, "timestamp": "01:00:13", "text": "字幕，"}, {"type": "subtitle", "time": 3615.67, "timestamp": "01:00:15", "text": "呃，对于《比利比利》的观众来说"}, {"type": "subtitle", "time": 3621.23, "timestamp": "01:00:21", "text": "那。"}, {"type": "subtitle", "time": 3622.91, "timestamp": "01:00:22", "text": "呃，"}, {"type": "subtitle", "time": 3626.549, "timestamp": "01:00:26", "text": "是的。此外，你知道，最重要的"}, {"type": "subtitle", "time": 3630.03, "timestamp": "01:00:30", "text": "我错过了家人。"}, {"type": "subtitle", "time": 3632.109, "timestamp": "01:00:32", "text": "时间。"}, {"type": "subtitle", "time": 3636.47, "timestamp": "01:00:36", "text": "就像我们星期天那天一样"}, {"type": "subtitle", "time": 3639.109, "timestamp": "01:00:39", "text": "我们通常是在星期天或星期六。"}, {"type": "subtitle", "time": 3642.87, "timestamp": "01:00:42", "text": "骗子西摩，他没有骗西摩"}, {"type": "subtitle", "time": 3645.67, "timestamp": "01:00:45", "text": "告诉我，是的，你必须优先考虑。"}, {"type": "subtitle", "time": 3648.39, "timestamp": "01:00:48", "text": "你的家庭物品和爱人，"}, {"type": "subtitle", "time": 3649.99, "timestamp": "01:00:49", "text": "即使你做了这一切，我"}, {"type": "subtitle", "time": 3653.63, "timestamp": "01:00:53", "text": "感激不尽，但还是要抽出时间陪伴家人。"}, {"type": "subtitle", "time": 3656.789, "timestamp": "01:00:56", "text": "对，我正在考虑去参加一个。"}, {"type": "subtitle", "time": 3659.589, "timestamp": "01:00:59", "text": "去我爸那乱糟糟的地方一日游"}]
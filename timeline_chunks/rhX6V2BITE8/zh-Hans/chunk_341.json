[{"type": "subtitle", "time": 20461.67, "timestamp": "05:41:01", "text": "这里。他不是就在这儿吗？离开。等等，我"}, {"type": "subtitle", "time": 20463.51, "timestamp": "05:41:03", "text": "迷失了方向。在哪里？在哪里？天哪，我做了"}, {"type": "subtitle", "time": 20466.59, "timestamp": "05:41:06", "text": "标记不正确。哦，"}, {"type": "subtitle", "time": 20469.75, "timestamp": "05:41:09", "text": "假的。我不认为他走到了这一步。"}, {"type": "subtitle", "time": 20472.628, "timestamp": "05:41:12", "text": "哦，原来你在这儿啊。你在那里。未来"}, {"type": "subtitle", "time": 20474.11, "timestamp": "05:41:14", "text": "为了"}, {"type": "subtitle", "time": 20477.23, "timestamp": "05:41:17", "text": "你。是的。你好。"}, {"type": "subtitle", "time": 20480.39, "timestamp": "05:41:20", "text": "你好。 3倍。呃，等等。医疗包。你需要"}, {"type": "subtitle", "time": 20482.628, "timestamp": "05:41:22", "text": "它。我们需要你。我们需要你。你"}, {"type": "subtitle", "time": 20486.15, "timestamp": "05:41:26", "text": "需要。问：我说我是这些"}, {"type": "subtitle", "time": 20487.83, "timestamp": "05:41:27", "text": "狙击手。"}, {"type": "subtitle", "time": 20489.91, "timestamp": "05:41:29", "text": "拥有一名狙击手难道不好吗？或者应该"}, {"type": "subtitle", "time": 20491.39, "timestamp": "05:41:31", "text": "我不这样做"}, {"type": "subtitle", "time": 20495.43, "timestamp": "05:41:35", "text": "它？一把好用的狙击步枪。若菜。"}, {"type": "subtitle", "time": 20502.39, "timestamp": "05:41:42", "text": "呃，我不知道。等待。我够用吗？"}, {"type": "subtitle", "time": 20508.99, "timestamp": "05:41:48", "text": "弹药？ 153. 哦，不。不行。我在哪里？"}, {"type": "subtitle", "time": 20511.948, "timestamp": "05:41:51", "text": "步行？我该怎么做？"}]
[{"type": "subtitle", "time": 13680.83, "timestamp": "03:48:00", "text": "这次回到我自己的时代"}, {"type": "subtitle", "time": 13683.59, "timestamp": "03:48:03", "text": "车辆。我这边会继续尝试。"}, {"type": "subtitle", "time": 13686.67, "timestamp": "03:48:06", "text": "哦，快点。是的，"}, {"type": "subtitle", "time": 13690.55, "timestamp": "03:48:10", "text": "记起。我们走吧。钓鱼时间。骑师，"}, {"type": "subtitle", "time": 13692.349, "timestamp": "03:48:12", "text": "拿"}, {"type": "subtitle", "time": 13707.75, "timestamp": "03:48:27", "text": "差点就要撞上了"}, {"type": "subtitle", "time": 13710.99, "timestamp": "03:48:30", "text": "那个岩石地方，但我"}, {"type": "subtitle", "time": 13714.429, "timestamp": "03:48:34", "text": "如果我没记错的话，好像没有。"}, {"type": "subtitle", "time": 13717.87, "timestamp": "03:48:37", "text": "事物。这是一条直线"}, {"type": "subtitle", "time": 13721.349, "timestamp": "03:48:41", "text": "没错，不过绕路也没关系。"}, {"type": "subtitle", "time": 13722.99, "timestamp": "03:48:42", "text": "像这样"}, {"type": "subtitle", "time": 13733.67, "timestamp": "03:48:53", "text": "错误。是的，它应该是……"}]
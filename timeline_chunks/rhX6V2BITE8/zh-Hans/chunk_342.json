[{"type": "subtitle", "time": 20528.708, "timestamp": "05:42:08", "text": "雅克特。我的天哪。我的天哪。我的天哪。哦"}, {"type": "subtitle", "time": 20530.07, "timestamp": "05:42:10", "text": "上帝。我觉得我可能去不了。我"}, {"type": "subtitle", "time": 20531.51, "timestamp": "05:42:11", "text": "别以为我不会成功"}, {"type": "subtitle", "time": 20534.15, "timestamp": "05:42:14", "text": "它。我大概有六个医疗包。我"}, {"type": "subtitle", "time": 20536.39, "timestamp": "05:42:16", "text": "有可能，但我也不确定。如何"}, {"type": "subtitle", "time": 20538.23, "timestamp": "05:42:18", "text": "这个游戏里你又自动奔跑了？做"}, {"type": "subtitle", "time": 20541.47, "timestamp": "05:42:21", "text": "有人知道快捷键吗？他们坠落了吗？"}, {"type": "subtitle", "time": 20544.788, "timestamp": "05:42:24", "text": "快捷键？是T吗？不，那不是T。"}, {"type": "subtitle", "time": 20546.75, "timestamp": "05:42:26", "text": "有人"}, {"type": "subtitle", "time": 20549.628, "timestamp": "05:42:29", "text": "射击。有多远？"}, {"type": "subtitle", "time": 20552.39, "timestamp": "05:42:32", "text": "这？真的很远。我本应该"}, {"type": "subtitle", "time": 20554.628, "timestamp": "05:42:34", "text": "行动早。笨蛋，事情就是这样。"}, {"type": "subtitle", "time": 20556.35, "timestamp": "05:42:36", "text": "当你没有检查时"}, {"type": "subtitle", "time": 20557.948, "timestamp": "05:42:37", "text": "这"}, {"type": "subtitle", "time": 20560.548, "timestamp": "05:42:40", "text": "事物。我看到你们那边在打架。"}, {"type": "subtitle", "time": 20562.43, "timestamp": "05:42:42", "text": "直的"}, {"type": "subtitle", "time": 20565.15, "timestamp": "05:42:45", "text": "向上。"}, {"type": "subtitle", "time": 20569.07, "timestamp": "05:42:49", "text": "啊。呃，这个游戏"}, {"type": "subtitle", "time": 20576.628, "timestamp": "05:42:56", "text": "正确的？这个游戏……哦，是的。它走"}]
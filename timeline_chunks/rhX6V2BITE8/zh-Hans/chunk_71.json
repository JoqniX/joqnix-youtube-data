[{"type": "subtitle", "time": 4260.47, "timestamp": "01:11:00", "text": "已经完成了，差不多完成了五个。所以我是"}, {"type": "subtitle", "time": 4263.47, "timestamp": "01:11:03", "text": "是的，我可以做七分之六。"}, {"type": "subtitle", "time": 4266.51, "timestamp": "01:11:06", "text": "每天，每次2小时或1小时"}, {"type": "subtitle", "time": 4269.43, "timestamp": "01:11:09", "text": "每个。但问题是，大多数人"}, {"type": "subtitle", "time": 4273.189, "timestamp": "01:11:13", "text": "在同一时区或3小时或4小时"}, {"type": "subtitle", "time": 4277.27, "timestamp": "01:11:17", "text": "提前或落后几个小时。是的，这是一个"}, {"type": "subtitle", "time": 4278.709, "timestamp": "01:11:18", "text": "少量"}, {"type": "subtitle", "time": 4280.99, "timestamp": "01:11:20", "text": "有点"}, {"type": "subtitle", "time": 4284.75, "timestamp": "01:11:24", "text": "难的。我觉得我需要更多加拿大人"}, {"type": "subtitle", "time": 4286.51, "timestamp": "01:11:26", "text": "现在。"}, {"type": "subtitle", "time": 4291.39, "timestamp": "01:11:31", "text": "但我也搞砸了时间安排。仅有的"}, {"type": "subtitle", "time": 4295.87, "timestamp": "01:11:35", "text": "一。只有我。米奥安。我做到了"}, {"type": "subtitle", "time": 4298.55, "timestamp": "01:11:38", "text": "适当地。我想我没睡着。或者说"}, {"type": "subtitle", "time": 4301.189, "timestamp": "01:11:41", "text": "我睡觉吗？我忘了。我发烧了"}, {"type": "subtitle", "time": 4304.229, "timestamp": "01:11:44", "text": "那天我跟四个人合作。"}, {"type": "subtitle", "time": 4307.51, "timestamp": "01:11:47", "text": "周六，兄弟。"}, {"type": "subtitle", "time": 4315.27, "timestamp": "01:11:55", "text": "晚上10点后发烧合作。后"}, {"type": "subtitle", "time": 4317.95, "timestamp": "01:11:57", "text": "通过完成它"}]
[{"type": "subtitle", "time": 1694.95, "timestamp": "00:28:14", "text": "呃，当我在拾荒者那里的时候，不是"}, {"type": "subtitle", "time": 1697.909, "timestamp": "00:28:17", "text": "寻宝游戏，当时我正在玩这个……"}, {"type": "subtitle", "time": 1698.909, "timestamp": "00:28:18", "text": "东西"}, {"type": "subtitle", "time": 1701.669, "timestamp": "00:28:21", "text": "结识新朋友，以及"}, {"type": "subtitle", "time": 1703.83, "timestamp": "00:28:23", "text": "与人重新建立联系的过程中，我学到了……"}, {"type": "subtitle", "time": 1706.95, "timestamp": "00:28:26", "text": "有很多东西我可以自己用。"}, {"type": "subtitle", "time": 1710.07, "timestamp": "00:28:30", "text": "诸如服务器之类的东西，以及诸如……之类的东西"}, {"type": "subtitle", "time": 1719.35, "timestamp": "00:28:39", "text": "我加入是因为我也遇到这个问题，对吧？呃"}, {"type": "subtitle", "time": 1721.59, "timestamp": "00:28:41", "text": "我的服务器就像 GFX 机器人一样，即将到来。"}, {"type": "subtitle", "time": 1725.35, "timestamp": "00:28:45", "text": "随意地给别人发私信之类的。"}, {"type": "subtitle", "time": 1728.789, "timestamp": "00:28:48", "text": "我想出了一个办法，可以把它们全部禁止。"}, {"type": "subtitle", "time": 1730.909, "timestamp": "00:28:50", "text": "同时拥有一条服务器规则，该规则将"}, {"type": "subtitle", "time": 1736.83, "timestamp": "00:28:56", "text": "帮助所有人，造福他人。是的。"}, {"type": "subtitle", "time": 1739.549, "timestamp": "00:28:59", "text": "嗯，如何实现强制执行？"}]
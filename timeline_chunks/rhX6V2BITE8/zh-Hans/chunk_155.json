[{"type": "subtitle", "time": 9319.03, "timestamp": "02:35:19", "text": "看着她，她就变成了那样的人。"}, {"type": "subtitle", "time": 9321.63, "timestamp": "02:35:21", "text": "变成了吸血鬼"}, {"type": "subtitle", "time": 9324.11, "timestamp": "02:35:24", "text": "尽管。好的。"}, {"type": "subtitle", "time": 9327.79, "timestamp": "02:35:27", "text": "呃，兄弟，我有点分心了。"}, {"type": "subtitle", "time": 9330.63, "timestamp": "02:35:30", "text": "来自推特。我应该寻找"}, {"type": "subtitle", "time": 9332.349, "timestamp": "02:35:32", "text": "某事"}, {"type": "subtitle", "time": 9335.91, "timestamp": "02:35:35", "text": "她叫什么名字来着？呃，让我"}, {"type": "chat", "time": 9341.15, "timestamp": "02:35:41", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "which one"}, {"type": "subtitle", "time": 9357.11, "timestamp": "02:35:57", "text": "那个人叫什么名字？"}, {"type": "subtitle", "time": 9357.57, "timestamp": "02:35:57", "text": "过去式"}, {"type": "subtitle", "time": 9359.15, "timestamp": "02:35:59", "text": "[音乐]"}]
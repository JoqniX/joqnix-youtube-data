[{"type": "subtitle", "time": 13740.55, "timestamp": "03:49:00", "text": "事物。是的，没问题。你看，我们到达了"}, {"type": "subtitle", "time": 13742.429, "timestamp": "03:49:02", "text": "这里没有"}, {"type": "subtitle", "time": 13750.03, "timestamp": "03:49:10", "text": "这里。哦，它正在……它正在……"}, {"type": "subtitle", "time": 13754.63, "timestamp": "03:49:14", "text": "晚的。哦，不。哦，不。夜晚"}, {"type": "subtitle", "time": 13758.71, "timestamp": "03:49:18", "text": "爬虫之类的东西会来的。"}, {"type": "subtitle", "time": 13765.55, "timestamp": "03:49:25", "text": "上帝。为什么？我已经到达这里了。"}, {"type": "subtitle", "time": 13774.79, "timestamp": "03:49:34", "text": "带你走。我正在经历某种抽水过程"}, {"type": "subtitle", "time": 13776.87, "timestamp": "03:49:36", "text": "车站。管道到此结束。他们"}, {"type": "subtitle", "time": 13779.67, "timestamp": "03:49:39", "text": "寻找主要内容。该死的。这些是吗？"}]
[{"type": "subtitle", "time": 3780.789, "timestamp": "01:03:00", "text": "我为什么在刷推特？我必须这样做"}, {"type": "subtitle", "time": 3784.549, "timestamp": "01:03:04", "text": "是这两份摘要，对吧？呃，两个"}, {"type": "subtitle", "time": 3788.15, "timestamp": "01:03:08", "text": "摘要。我完成了第81天的工作。"}, {"type": "subtitle", "time": 3792.589, "timestamp": "01:03:12", "text": "和特伦一起度过的第82天"}, {"type": "subtitle", "time": 3795.349, "timestamp": "01:03:15", "text": "西摩，他们俩。这就是我认识的那个人"}, {"type": "subtitle", "time": 3798.95, "timestamp": "01:03:18", "text": "前面提到过。是的。嗯，6月1日"}, {"type": "subtitle", "time": 3801.19, "timestamp": "01:03:21", "text": "那天是星期天，对吧？ 6月1日是"}, {"type": "subtitle", "time": 3802.87, "timestamp": "01:03:22", "text": "星期日。"}, {"type": "subtitle", "time": 3808.309, "timestamp": "01:03:28", "text": "做那件事，还有昨天的事，呃……"}, {"type": "subtitle", "time": 3809.95, "timestamp": "01:03:29", "text": "Kan 和"}, {"type": "subtitle", "time": 3812.47, "timestamp": "01:03:32", "text": "Zenismouth 也对他们俩有同样的感受。我们得到了"}, {"type": "subtitle", "time": 3815.47, "timestamp": "01:03:35", "text": "得到那些东西"}, {"type": "subtitle", "time": 3818.109, "timestamp": "01:03:38", "text": "出色地。"}, {"type": "subtitle", "time": 3821.029, "timestamp": "01:03:41", "text": "呃，请稍等片刻。让我冷静一下"}, {"type": "subtitle", "time": 3834.63, "timestamp": "01:03:54", "text": "呃，我还在YouTube上直播吗？是"}, {"type": "subtitle", "time": 3837.47, "timestamp": "01:03:57", "text": "YouTube 上所有好东西"}, {"type": "subtitle", "time": 3839.87, "timestamp": "01:03:59", "text": "闪耀？是的，的确如此。"}]
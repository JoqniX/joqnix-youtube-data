[{"type": "subtitle", "time": 13621.229, "timestamp": "03:47:01", "text": "我觉得我不会成功"}, {"type": "subtitle", "time": 13641.51, "timestamp": "03:47:21", "text": "帮助。至少我们已经很接近了。呃，我们是"}, {"type": "subtitle", "time": 13651.15, "timestamp": "03:47:31", "text": "我不能自由漫游吗？"}, {"type": "subtitle", "time": 13656.91, "timestamp": "03:47:36", "text": "男人。好吧，我就这么办吧。"}, {"type": "subtitle", "time": 13660.429, "timestamp": "03:47:40", "text": "呃，失败了，我"}, {"type": "subtitle", "time": 13675.11, "timestamp": "03:47:55", "text": "后退。对，就让它拖着吧。没关系。"}, {"type": "subtitle", "time": 13677.87, "timestamp": "03:47:57", "text": "我，我会重做。"}]
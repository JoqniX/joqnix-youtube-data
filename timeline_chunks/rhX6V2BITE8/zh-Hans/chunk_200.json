[{"type": "subtitle", "time": 12032.349, "timestamp": "03:20:32", "text": "就是这样，对吧？所有人都死了。"}, {"type": "subtitle", "time": 12035.55, "timestamp": "03:20:35", "text": "好的，现在我通知你"}, {"type": "subtitle", "time": 12042.66, "timestamp": "03:20:42", "text": "钱真的"}, {"type": "subtitle", "time": 12044.51, "timestamp": "03:20:44", "text": "[音乐]"}, {"type": "subtitle", "time": 12047.67, "timestamp": "03:20:47", "text": "猴子更喜欢什么？是的，这些人有"}, {"type": "subtitle", "time": 12049.15, "timestamp": "03:20:49", "text": "步枪"}, {"type": "subtitle", "time": 12052.51, "timestamp": "03:20:52", "text": "他们。我只是想要更多步枪而已，你"}, {"type": "subtitle", "time": 12054.269, "timestamp": "03:20:54", "text": "[音乐]"}]
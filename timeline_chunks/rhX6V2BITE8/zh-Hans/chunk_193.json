[{"type": "subtitle", "time": 11580.87, "timestamp": "03:13:00", "text": "负责人是谁？我需要一些帮助。与……交谈"}, {"type": "subtitle", "time": 11592.83, "timestamp": "03:13:12", "text": "嗯，我想就在这里面。"}, {"type": "subtitle", "time": 11596.95, "timestamp": "03:13:16", "text": "美好的。美好的。这是谁？哦。哦，我们有"}, {"type": "subtitle", "time": 11605.51, "timestamp": "03:13:25", "text": "你好呀。"}, {"type": "subtitle", "time": 11607.03, "timestamp": "03:13:27", "text": "我无意打断。我在看"}, {"type": "subtitle", "time": 11610.07, "timestamp": "03:13:30", "text": "为贾齐尔。我是贾齐尔。但如果你想"}, {"type": "subtitle", "time": 11612.63, "timestamp": "03:13:32", "text": "我们只有面包。不，不。我 我"}, {"type": "subtitle", "time": 11615.03, "timestamp": "03:13:35", "text": "不需要食物。听着，我来自哈兰，"}, {"type": "subtitle", "time": 11616.71, "timestamp": "03:13:36", "text": "我来是因为我听说了这一点。"}, {"type": "subtitle", "time": 11618.07, "timestamp": "03:13:38", "text": "这里有些人对……免疫"}, {"type": "subtitle", "time": 11619.99, "timestamp": "03:13:39", "text": "即使他们不会改变，这种病毒也不会让他们改变"}, {"type": "subtitle", "time": 11621.389, "timestamp": "03:13:41", "text": "它们会被咬。"}, {"type": "subtitle", "time": 11625.11, "timestamp": "03:13:45", "text": "哦，是谁告诉你的？一个死人。"}, {"type": "subtitle", "time": 11627.349, "timestamp": "03:13:47", "text": "很遗憾。你最好还是保留"}, {"type": "subtitle", "time": 11629.429, "timestamp": "03:13:49", "text": "听他说话。我不会再告诉你了。"}, {"type": "subtitle", "time": 11631.67, "timestamp": "03:13:51", "text": "比他强。我不会告诉你比他更多的话。"}, {"type": "subtitle", "time": 11633.429, "timestamp": "03:13:53", "text": "现在。为什么没有人愿意帮我？这"}, {"type": "subtitle", "time": 11635.11, "timestamp": "03:13:55", "text": "病毒已经遍布全城。人们是"}, {"type": "subtitle", "time": 11638.95, "timestamp": "03:13:58", "text": "濒临死亡，却依然活着。"}]
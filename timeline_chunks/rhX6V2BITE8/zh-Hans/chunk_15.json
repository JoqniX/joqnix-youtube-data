[{"type": "subtitle", "time": 901.59, "timestamp": "00:15:01", "text": "你。然而你仍然记得我。那"}, {"type": "subtitle", "time": 903.03, "timestamp": "00:15:03", "text": "意义重大。所以，谢谢你。"}, {"type": "subtitle", "time": 910.11, "timestamp": "00:15:10", "text": "模型。但是如果"}, {"type": "subtitle", "time": 911.949, "timestamp": "00:15:11", "text": "我"}, {"type": "subtitle", "time": 914.269, "timestamp": "00:15:14", "text": "老兄，我很高兴"}, {"type": "subtitle", "time": 917.59, "timestamp": "00:15:17", "text": "目前为止，大家都非常友善。全部"}, {"type": "subtitle", "time": 920.11, "timestamp": "00:15:20", "text": "我私信过的那些人，"}, {"type": "subtitle", "time": 922.55, "timestamp": "00:15:22", "text": "正确的？我不知道我是否应该说这句话会带来厄运。"}, {"type": "subtitle", "time": 926.15, "timestamp": "00:15:26", "text": "是的，但我很害怕。但是，呃"}, {"type": "subtitle", "time": 928.87, "timestamp": "00:15:28", "text": "我目前为止私信过的人，呃，所有人。"}, {"type": "subtitle", "time": 932.629, "timestamp": "00:15:32", "text": "一直都很好。嗯，说到新的"}, {"type": "subtitle", "time": 934.23, "timestamp": "00:15:34", "text": "我从未合作过的新人"}, {"type": "subtitle", "time": 936.71, "timestamp": "00:15:36", "text": "之前有过互动，我一定会这样做。"}, {"type": "subtitle", "time": 939.67, "timestamp": "00:15:39", "text": "就像VC擦除检查之类的东西"}, {"type": "subtitle", "time": 943.949, "timestamp": "00:15:43", "text": "如果可能的话，请提前告知。"}, {"type": "subtitle", "time": 946.949, "timestamp": "00:15:46", "text": "嗯，对某些人来说，我不……"}, {"type": "subtitle", "time": 949.99, "timestamp": "00:15:49", "text": "就像那些关注过我并了解我的人一样"}, {"type": "subtitle", "time": 953.03, "timestamp": "00:15:53", "text": "我和一些其他的东西都挺好的。他们知道该怎么做"}, {"type": "subtitle", "time": 956.629, "timestamp": "00:15:56", "text": "没错吧？呃，还有所有的一切。但"}, {"type": "subtitle", "time": 959.67, "timestamp": "00:15:59", "text": "是的，对于新来的人，我确实会确保"}]
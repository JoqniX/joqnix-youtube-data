[{"type": "subtitle", "time": 3362.63, "timestamp": "00:56:02", "text": "21日，上周六，洛杉矶的最后一周"}, {"type": "subtitle", "time": 3366.23, "timestamp": "00:56:06", "text": "六月的第三周，因为我只会"}, {"type": "subtitle", "time": 3370.309, "timestamp": "00:56:10", "text": "还剩一周时间，对吧，21对吧，嗯"}, {"type": "subtitle", "time": 3373.589, "timestamp": "00:56:13", "text": "还剩一周，22到28号，就是这样。"}, {"type": "subtitle", "time": 3377.589, "timestamp": "00:56:17", "text": "这是我最后一次机会了，因为呃，我要去拿我的"}, {"type": "subtitle", "time": 3381.27, "timestamp": "00:56:21", "text": "呃，从第十届到第十届的 COE，然后我必须"}, {"type": "subtitle", "time": 3383.27, "timestamp": "00:56:23", "text": "与学院讨论我可能需要"}, {"type": "subtitle", "time": 3387.51, "timestamp": "00:56:27", "text": "去当地的学院，然后和他们谈谈。"}, {"type": "subtitle", "time": 3390.069, "timestamp": "00:56:30", "text": "他们亲自照顾我，还有一些关于我居家生活的东西。"}, {"type": "subtitle", "time": 3392.549, "timestamp": "00:56:32", "text": "物品和支付结构以及"}, {"type": "subtitle", "time": 3394.309, "timestamp": "00:56:34", "text": "一切。我觉得我爸爸会去，但是"}, {"type": "subtitle", "time": 3396.87, "timestamp": "00:56:36", "text": "但我至少还得跟他们谈谈。"}, {"type": "subtitle", "time": 3399.19, "timestamp": "00:56:39", "text": "因为我更喜欢单人间。所以，我"}, {"type": "subtitle", "time": 3402.39, "timestamp": "00:56:42", "text": "必须优先处理这件事等等。这"}, {"type": "subtitle", "time": 3404.91, "timestamp": "00:56:44", "text": "这些学院的人就说，是啊，你"}, {"type": "subtitle", "time": 3407.99, "timestamp": "00:56:47", "text": "应暂停您的流媒体播放 6 个月。"}, {"type": "subtitle", "time": 3410.23, "timestamp": "00:56:50", "text": "在你安顿下来六个月之后"}, {"type": "subtitle", "time": 3411.829, "timestamp": "00:56:51", "text": "你搬出去还是继续和……"}, {"type": "subtitle", "time": 3414.069, "timestamp": "00:56:54", "text": "独木舟或其他什么的，只有你才会"}, {"type": "subtitle", "time": 3416.23, "timestamp": "00:56:56", "text": "对事物的现状有一个基本的了解，"}, {"type": "subtitle", "time": 3417.67, "timestamp": "00:56:57", "text": "把你能做的事情和你"}, {"type": "subtitle", "time": 3419.99, "timestamp": "00:56:59", "text": "不能做所有事，然后再做"}]
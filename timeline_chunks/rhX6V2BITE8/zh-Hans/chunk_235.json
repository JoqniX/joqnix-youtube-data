[{"type": "subtitle", "time": 14100.469, "timestamp": "03:55:00", "text": "那或许能救我的朋友们。如果你有"}, {"type": "subtitle", "time": 14103.269, "timestamp": "03:55:03", "text": "任何事物。是的，陌生人。是的。我们有"}, {"type": "subtitle", "time": 14107.07, "timestamp": "03:55:07", "text": "我们向母亲表达我们的信仰和祈祷。"}, {"type": "subtitle", "time": 14109.91, "timestamp": "03:55:09", "text": "信仰？好的。我无意冒犯，但是"}, {"type": "subtitle", "time": 14112.07, "timestamp": "03:55:12", "text": "你是说祈祷能持续下去"}, {"type": "subtitle", "time": 14113.91, "timestamp": "03:55:13", "text": "你别转身。"}, {"type": "subtitle", "time": 14116.79, "timestamp": "03:55:16", "text": "那是你的问题。你缺乏信仰"}, {"type": "subtitle", "time": 14119.75, "timestamp": "03:55:19", "text": "和其他局外人一样。我们相信"}, {"type": "subtitle", "time": 14122.55, "timestamp": "03:55:22", "text": "母亲保护着我们。我们有"}, {"type": "subtitle", "time": 14126.309, "timestamp": "03:55:26", "text": "不需要抗毒素之类的东西，就像你说的。"}, {"type": "subtitle", "time": 14128.63, "timestamp": "03:55:28", "text": "好的。好的。那么，我有什么办法吗？"}, {"type": "subtitle", "time": 14131.349, "timestamp": "03:55:31", "text": "或许可以和这位母亲谈谈？她"}, {"type": "subtitle", "time": 14134.07, "timestamp": "03:55:34", "text": "是神圣的。她只和那些人说话。"}, {"type": "subtitle", "time": 14135.87, "timestamp": "03:55:35", "text": "被称为"}, {"type": "subtitle", "time": 14139.429, "timestamp": "03:55:39", "text": "没有面孔。但或许你能得到"}, {"type": "subtitle", "time": 14142.309, "timestamp": "03:55:42", "text": "让他们注意到你。你做得足够好了。"}, {"type": "subtitle", "time": 14144.389, "timestamp": "03:55:44", "text": "为了社区。此时，我将采取"}, {"type": "subtitle", "time": 14146.63, "timestamp": "03:55:46", "text": "任何事物。那么，你究竟是哪种类型的好人呢？"}, {"type": "subtitle", "time": 14147.99, "timestamp": "03:55:47", "text": "寻找？需要做什么"}, {"type": "subtitle", "time": 14152.07, "timestamp": "03:55:52", "text": "这附近吗？你是认真的吗？"}, {"type": "subtitle", "time": 14154.63, "timestamp": "03:55:54", "text": "好吧。我负责处理这件事。"}, {"type": "subtitle", "time": 14157.11, "timestamp": "03:55:57", "text": "农场。我的朋友比拉尔负责保管汽油。"}, {"type": "subtitle", "time": 14159.59, "timestamp": "03:55:59", "text": "城镇附近的车站很安全。环顾四周。"}]
[{"type": "subtitle", "time": 19744.11, "timestamp": "05:29:04", "text": "霰弹枪"}, {"type": "subtitle", "time": 19747.11, "timestamp": "05:29:07", "text": "补偿器。我需要这个吗？好的，我"}, {"type": "subtitle", "time": 19749.07, "timestamp": "05:29:09", "text": "应该"}, {"type": "subtitle", "time": 19752.11, "timestamp": "05:29:12", "text": "吸烟"}, {"type": "subtitle", "time": 19755.27, "timestamp": "05:29:15", "text": "手榴弹背包三级。好的，我是"}, {"type": "subtitle", "time": 19757.548, "timestamp": "05:29:17", "text": "感恩。等等，野牛。这是什么？"}, {"type": "subtitle", "time": 19762.39, "timestamp": "05:29:22", "text": "冲锋枪。我该买吗？这把冲锋枪好用吗？"}, {"type": "subtitle", "time": 19766.31, "timestamp": "05:29:26", "text": "子弹循环。我需要它吗？我会扔"}, {"type": "subtitle", "time": 19781.03, "timestamp": "05:29:41", "text": "排名 jo。不，这只是这一次。"}, {"type": "subtitle", "time": 19783.03, "timestamp": "05:29:43", "text": "我打算直接在线观看。"}, {"type": "subtitle", "time": 19784.548, "timestamp": "05:29:44", "text": "我要卸载流媒体服务了"}, {"type": "subtitle", "time": 19785.788, "timestamp": "05:29:45", "text": "它。不"}, {"type": "subtitle", "time": 19789.19, "timestamp": "05:29:49", "text": "担心。不用担心。好的。我最喜欢的"}, {"type": "subtitle", "time": 19794.51, "timestamp": "05:29:54", "text": "整个游戏中的气枪。呃"}, {"type": "subtitle", "time": 19796.91, "timestamp": "05:29:56", "text": "AK-47。最好的"}, {"type": "subtitle", "time": 19798.83, "timestamp": "05:29:58", "text": "枪。这是你的"}]
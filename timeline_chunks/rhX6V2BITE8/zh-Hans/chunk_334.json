[{"type": "subtitle", "time": 20042.35, "timestamp": "05:34:02", "text": "从？我看见你。我懂了"}, {"type": "subtitle", "time": 20049.868, "timestamp": "05:34:09", "text": "我到底有没有爆头你？好的，明白了。"}, {"type": "subtitle", "time": 20053.15, "timestamp": "05:34:13", "text": "谢谢你"}, {"type": "subtitle", "time": 20058.99, "timestamp": "05:34:18", "text": "你。"}, {"type": "subtitle", "time": 20061.99, "timestamp": "05:34:21", "text": "等等，那个走路敲门的人"}, {"type": "subtitle", "time": 20071.67, "timestamp": "05:34:31", "text": "再次。呃，好的。等待。呃，止痛药。"}, {"type": "subtitle", "time": 20073.07, "timestamp": "05:34:33", "text": "呃，我需要那个吗？"}, {"type": "subtitle", "time": 20077.07, "timestamp": "05:34:37", "text": "现在？呃，不。它是"}, {"type": "subtitle", "time": 20080.11, "timestamp": "05:34:40", "text": "好的。甜美的铃铛，对吧？我接受。"}, {"type": "subtitle", "time": 20082.23, "timestamp": "05:34:42", "text": "工具。你知道吗？我会带走你的"}, {"type": "subtitle", "time": 20087.07, "timestamp": "05:34:47", "text": "其余全部。谢谢。因为是我"}, {"type": "subtitle", "time": 20092.548, "timestamp": "05:34:52", "text": "呃，我不需要9毫米的，对吧？我需要45"}, {"type": "subtitle", "time": 20094.11, "timestamp": "05:34:54", "text": "急性护理计划"}, {"type": "subtitle", "time": 20098.19, "timestamp": "05:34:58", "text": "东西。我不需要"}]
[{"type": "subtitle", "time": 10862.269, "timestamp": "03:01:02", "text": "更长。 Rain，我们走吧。我喜欢这一点。"}, {"type": "subtitle", "time": 10864.95, "timestamp": "03:01:04", "text": "长的。耶。"}, {"type": "subtitle", "time": 10867.83, "timestamp": "03:01:07", "text": "远离这里。远离这里。你没有"}, {"type": "subtitle", "time": 10871.99, "timestamp": "03:01:11", "text": "理解。母亲。母亲。"}, {"type": "subtitle", "time": 10878.03, "timestamp": "03:01:18", "text": "母亲。母亲"}, {"type": "subtitle", "time": 10893.51, "timestamp": "03:01:33", "text": "什么？农村。我们的跑步者带来了"}, {"type": "subtitle", "time": 10897.51, "timestamp": "03:01:37", "text": "身负重伤、神志不清的男子胡言乱语"}, {"type": "subtitle", "time": 10900.23, "timestamp": "03:01:40", "text": "关于对病毒免疫的人群。他曾"}, {"type": "subtitle", "time": 10904.23, "timestamp": "03:01:44", "text": "一张显示离开哈兰路线的地图。那里"}, {"type": "subtitle", "time": 10906.469, "timestamp": "03:01:46", "text": "这里病人越来越多。不是"}, {"type": "subtitle", "time": 10909.83, "timestamp": "03:01:49", "text": "够了，安德森。以及卡姆登的研究"}, {"type": "subtitle", "time": 10912.309, "timestamp": "03:01:52", "text": "还没结果呢。我们得去"}, {"type": "subtitle", "time": 10915.15, "timestamp": "03:01:55", "text": "检查每一条线索。你好。"}, {"type": "subtitle", "time": 10917.83, "timestamp": "03:01:57", "text": "去。我的武器装备都带齐了吗？我"}]
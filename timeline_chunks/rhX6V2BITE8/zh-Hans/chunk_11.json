[{"type": "subtitle", "time": 660.79, "timestamp": "00:11:00", "text": "为了证明我自己，对吧？尤其"}, {"type": "subtitle", "time": 663.67, "timestamp": "00:11:03", "text": "Jockathon 直播。我刚才说了“对”。"}, {"type": "subtitle", "time": 668.31, "timestamp": "00:11:08", "text": "第一天，也就是3月20日"}, {"type": "subtitle", "time": 670.71, "timestamp": "00:11:10", "text": "12号或15号，或者15号左右，或者"}, {"type": "subtitle", "time": 673.59, "timestamp": "00:11:13", "text": "我会做这件事，持续24小时"}, {"type": "subtitle", "time": 675.75, "timestamp": "00:11:15", "text": "我做了，但即使我……也没那么做。"}, {"type": "subtitle", "time": 677.67, "timestamp": "00:11:17", "text": "我承认自己喜欢戴上WS，而且"}, {"type": "subtitle", "time": 680.31, "timestamp": "00:11:20", "text": "比如休息之类的，所以我的"}, {"type": "subtitle", "time": 683.11, "timestamp": "00:11:23", "text": "虚弱的身体其实可以得到休息，所以"}, {"type": "subtitle", "time": 685.35, "timestamp": "00:11:25", "text": "我并不觉得精力不足之类的，但是"}, {"type": "subtitle", "time": 687.829, "timestamp": "00:11:27", "text": "但我还是坚持了下来，坚持了三个小时。"}, {"type": "subtitle", "time": 689.43, "timestamp": "00:11:29", "text": "连续三个月，这是"}, {"type": "subtitle", "time": 691.79, "timestamp": "00:11:31", "text": "第四个月，最后一个月，我有"}, {"type": "subtitle", "time": 696.069, "timestamp": "00:11:36", "text": "左边。所以，我很高兴。我很高兴。而我是"}, {"type": "subtitle", "time": 698.91, "timestamp": "00:11:38", "text": "很荣幸来到这里"}, {"type": "subtitle", "time": 701.23, "timestamp": "00:11:41", "text": "到"}, {"type": "subtitle", "time": 703.19, "timestamp": "00:11:43", "text": "是的。"}, {"type": "subtitle", "time": 704.75, "timestamp": "00:11:44", "text": "[音乐]"}]
[{"type": "subtitle", "time": 20824.15, "timestamp": "05:47:04", "text": "AKM。我的天啊。第一场比赛。之后"}, {"type": "subtitle", "time": 20834.628, "timestamp": "05:47:14", "text": "什么？这是什么说法？这是什么？"}, {"type": "subtitle", "time": 20843.23, "timestamp": "05:47:23", "text": "现金箱。什么是"}, {"type": "subtitle", "time": 20847.47, "timestamp": "05:47:27", "text": "这把钥匙？无需钥匙。"}, {"type": "subtitle", "time": 20853.99, "timestamp": "05:47:33", "text": "什么学分？带我回家。玩一次。"}, {"type": "subtitle", "time": 20857.99, "timestamp": "05:47:37", "text": "玩三次。进入前10名10次。"}, {"type": "subtitle", "time": 20860.948, "timestamp": "05:47:40", "text": "五次。萨瓦仪式全程60分钟。"}, {"type": "subtitle", "time": 20863.35, "timestamp": "05:47:43", "text": "观看比赛所花费的时间（包括观看比赛的时间）"}, {"type": "subtitle", "time": 20867.03, "timestamp": "05:47:47", "text": "你的队友。哦。哦，你可以得到400"}, {"type": "subtitle", "time": 20868.35, "timestamp": "05:47:48", "text": "硬币。"}, {"type": "subtitle", "time": 20870.11, "timestamp": "05:47:50", "text": "哇。好的"}, {"type": "subtitle", "time": 20875.83, "timestamp": "05:47:55", "text": "一。那挺好的。是的，我们再玩一次。"}, {"type": "subtitle", "time": 20879.23, "timestamp": "05:47:59", "text": "我的天啊。是的。哦，我得到了"}]
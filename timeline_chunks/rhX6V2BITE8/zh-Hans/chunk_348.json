[{"type": "subtitle", "time": 20882.39, "timestamp": "05:48:02", "text": "害怕的。坚持，稍等。什么？我其实"}, {"type": "subtitle", "time": 20886.19, "timestamp": "05:48:06", "text": "说实话，我超棒"}, {"type": "subtitle", "time": 20888.948, "timestamp": "05:48:08", "text": "有时会感到害怕。现在这些游戏可以"}, {"type": "subtitle", "time": 20892.15, "timestamp": "05:48:12", "text": "让你觉得这有点像恐怖片。"}, {"type": "subtitle", "time": 20895.03, "timestamp": "05:48:15", "text": "就像你知道你是唯一活着的人一样"}, {"type": "subtitle", "time": 20897.27, "timestamp": "05:48:17", "text": "你知道你是独一无二的。"}, {"type": "subtitle", "time": 20900.31, "timestamp": "05:48:20", "text": "人生只有一次，你必须活下去。如果"}, {"type": "subtitle", "time": 20902.31, "timestamp": "05:48:22", "text": "如果你有队友的话，我就会……"}, {"type": "subtitle", "time": 20905.03, "timestamp": "05:48:25", "text": "就像，是的，你会检查我的，你会说"}, {"type": "subtitle", "time": 20907.91, "timestamp": "05:48:27", "text": "保护我的后背什么的，但是这里"}, {"type": "subtitle", "time": 20911.15, "timestamp": "05:48:31", "text": "就像"}, {"type": "subtitle", "time": 20913.99, "timestamp": "05:48:33", "text": "是啊，你得独自求生。"}, {"type": "subtitle", "time": 20916.19, "timestamp": "05:48:36", "text": "一切。不"}, {"type": "subtitle", "time": 20924.03, "timestamp": "05:48:44", "text": "疼痛。嗯，怎么做？"}, {"type": "subtitle", "time": 20933.51, "timestamp": "05:48:53", "text": "我们甚至在超远距离上也看到了画面"}]
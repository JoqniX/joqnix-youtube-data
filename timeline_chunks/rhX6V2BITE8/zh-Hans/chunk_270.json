[{"type": "subtitle", "time": 16220.149, "timestamp": "04:30:20", "text": "头。离我远点。"}, {"type": "subtitle", "time": 16222.149, "timestamp": "04:30:22", "text": "你会给我钱作为帮助你的回报吗？"}, {"type": "subtitle", "time": 16223.83, "timestamp": "04:30:23", "text": "母亲的忠子必报答你"}, {"type": "subtitle", "time": 16227.63, "timestamp": "04:30:27", "text": "感谢你的好意。嗨，我很酷。"}, {"type": "subtitle", "time": 16230.71, "timestamp": "04:30:30", "text": "泰坦。那孩子升级了。谢谢"}, {"type": "subtitle", "time": 16237.28, "timestamp": "04:30:37", "text": "上帝。我确实玩过关卡"}, {"type": "subtitle", "time": 16247.229, "timestamp": "04:30:47", "text": "向上。垃圾测试是"}]
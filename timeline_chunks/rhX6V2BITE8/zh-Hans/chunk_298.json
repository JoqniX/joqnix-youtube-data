[{"type": "subtitle", "time": 17881.948, "timestamp": "04:58:01", "text": "你吃过午饭了吗？"}, {"type": "subtitle", "time": 17893.19, "timestamp": "04:58:13", "text": "嗯，好了，应该可以了。拉神姿势。做"}, {"type": "subtitle", "time": 17895.99, "timestamp": "04:58:15", "text": "你看到那段翻译了吗？是的，你确实"}, {"type": "subtitle", "time": 17902.51, "timestamp": "04:58:22", "text": "好的。哦，等等。这东西就像"}, {"type": "subtitle", "time": 17906.868, "timestamp": "04:58:26", "text": "嗯，我忘了。但对于《绝地求生》来说，这东西呃"}, {"type": "subtitle", "time": 17911.19, "timestamp": "04:58:31", "text": "就像在那边一样。不。是"}, {"type": "subtitle", "time": 17914.31, "timestamp": "04:58:34", "text": "音频对吧？好的，那就好。你是"}, {"type": "subtitle", "time": 17915.99, "timestamp": "04:58:35", "text": "是单人出行还是和斯科特一起？当然要去"}, {"type": "subtitle", "time": 17924.31, "timestamp": "04:58:44", "text": "我要独自前往。当然，它正在发生"}, {"type": "subtitle", "time": 17928.19, "timestamp": "04:58:48", "text": "独自一人。独奏"}, {"type": "subtitle", "time": 17931.948, "timestamp": "04:58:51", "text": "帮派我是一个独奏者"}, {"type": "subtitle", "time": 17934.47, "timestamp": "04:58:54", "text": "团伙。哦，等等。呃，我忘了。呃，"}, {"type": "subtitle", "time": 17938.35, "timestamp": "04:58:58", "text": "昨天我没完全完成。"}]
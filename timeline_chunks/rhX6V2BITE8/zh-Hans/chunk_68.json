[{"type": "subtitle", "time": 4082.109, "timestamp": "01:08:02", "text": "我的意思是"}, {"type": "subtitle", "time": 4084.789, "timestamp": "01:08:04", "text": "是的。是的。我记得我们聊过天。"}, {"type": "subtitle", "time": 4087.43, "timestamp": "01:08:07", "text": "东西。我相信你当时在玩《I》"}, {"type": "subtitle", "time": 4089.95, "timestamp": "01:08:09", "text": "记得呃，见过你"}, {"type": "subtitle", "time": 4095.109, "timestamp": "01:08:15", "text": "直播《光之子》"}, {"type": "subtitle", "time": 4097.829, "timestamp": "01:08:17", "text": "我问过你这件事，你"}, {"type": "subtitle", "time": 4100.87, "timestamp": "01:08:20", "text": "解释说，这是一款手机游戏。"}, {"type": "subtitle", "time": 4103.43, "timestamp": "01:08:23", "text": "这个和这个，嗯，如果我没记错的话。"}, {"type": "subtitle", "time": 4105.189, "timestamp": "01:08:25", "text": "正确。我不知道我们之前在哪里。"}, {"type": "subtitle", "time": 4107.309, "timestamp": "01:08:27", "text": "那"}, {"type": "subtitle", "time": 4109.39, "timestamp": "01:08:29", "text": "对话，"}, {"type": "subtitle", "time": 4113.789, "timestamp": "01:08:33", "text": "是的，我记得。"}, {"type": "subtitle", "time": 4116.55, "timestamp": "01:08:36", "text": "最后。是的。是的。我从未玩过"}, {"type": "subtitle", "time": 4119.229, "timestamp": "01:08:39", "text": "那场比赛甚至"}, {"type": "subtitle", "time": 4122.149, "timestamp": "01:08:42", "text": "现在。我的Steam账户里还留着它，不过，是的。"}, {"type": "subtitle", "time": 4124.829, "timestamp": "01:08:44", "text": "必须玩玩。你是否记得"}, {"type": "subtitle", "time": 4127.91, "timestamp": "01:08:47", "text": "那？现在真是太疯狂了。我仍然"}, {"type": "subtitle", "time": 4130.51, "timestamp": "01:08:50", "text": "记住这一点。哦，我的"}]
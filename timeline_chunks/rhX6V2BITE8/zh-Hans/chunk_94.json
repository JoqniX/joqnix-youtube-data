[{"type": "subtitle", "time": 5663.91, "timestamp": "01:34:23", "text": "你知道，我有点……我不知道是否"}, {"type": "subtitle", "time": 5666.31, "timestamp": "01:34:26", "text": "任何人都能做到，但是，是的。"}, {"type": "subtitle", "time": 5668.55, "timestamp": "01:34:28", "text": "如果你想这么做，我会……"}, {"type": "subtitle", "time": 5672.149, "timestamp": "01:34:32", "text": "很想看到你这样做。我必须是我"}, {"type": "subtitle", "time": 5682.79, "timestamp": "01:34:42", "text": "我想要的东西有很多，但是"}, {"type": "subtitle", "time": 5689.35, "timestamp": "01:34:49", "text": "可能的。可能太多了。或许"}, {"type": "subtitle", "time": 5696.229, "timestamp": "01:34:56", "text": "知道。我不知道。看看我的终极"}, {"type": "subtitle", "time": 5699.91, "timestamp": "01:34:59", "text": "目标是让你们都喜欢我。"}]
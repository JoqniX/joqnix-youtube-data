[{"type": "subtitle", "time": 12360.63, "timestamp": "03:26:00", "text": "哦。我的天啊。我已经到达了一片荒野"}, {"type": "subtitle", "time": 12362.67, "timestamp": "03:26:02", "text": "结尾。真的死了"}, {"type": "subtitle", "time": 12382.59, "timestamp": "03:26:22", "text": "破碎的。多基，你的武器。哦，我的"}, {"type": "subtitle", "time": 12385.07, "timestamp": "03:26:25", "text": "上帝。"}, {"type": "subtitle", "time": 12389.389, "timestamp": "03:26:29", "text": "不，我其实打得像个"}, {"type": "subtitle", "time": 12392.469, "timestamp": "03:26:32", "text": "自行车之类的东西。哦，是的，我能感觉到。"}, {"type": "subtitle", "time": 12393.95, "timestamp": "03:26:33", "text": "这"}, {"type": "subtitle", "time": 12396.51, "timestamp": "03:26:36", "text": "轮胎。哦"}, {"type": "subtitle", "time": 12399.75, "timestamp": "03:26:39", "text": "不。找到螺丝。我没有螺丝。"}, {"type": "subtitle", "time": 12402.09, "timestamp": "03:26:42", "text": "与我一起。"}, {"type": "subtitle", "time": 12417.389, "timestamp": "03:26:57", "text": "发生。我打算自由发挥。"}, {"type": "subtitle", "time": 12419.87, "timestamp": "03:26:59", "text": "这是为了"}]
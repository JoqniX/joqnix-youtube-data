[{"type": "subtitle", "time": 11281.83, "timestamp": "03:08:01", "text": "赢得孩子的信任。信托信托"}, {"type": "subtitle", "time": 11288.99, "timestamp": "03:08:08", "text": "什么？我的天啊。我该怎么做？"}, {"type": "subtitle", "time": 11292.07, "timestamp": "03:08:12", "text": "这？我看到的只有绿色。好的，我"}, {"type": "subtitle", "time": 11295.67, "timestamp": "03:08:15", "text": "我觉得事情就是这样很清楚了。"}, {"type": "subtitle", "time": 11298.03, "timestamp": "03:08:18", "text": "随时可以跳进去"}, {"type": "subtitle", "time": 11300.75, "timestamp": "03:08:20", "text": "水。不，那不会的。"}, {"type": "subtitle", "time": 11303.59, "timestamp": "03:08:23", "text": "工作。等等，这样行得通吗？我只是"}, {"type": "subtitle", "time": 11306.91, "timestamp": "03:08:26", "text": "想看看。等等，让我来"}, {"type": "subtitle", "time": 11310.429, "timestamp": "03:08:30", "text": "那。跳入水中。你说"}, {"type": "subtitle", "time": 11313.99, "timestamp": "03:08:33", "text": "不。跳入水中。这是。它是"}, {"type": "subtitle", "time": 11318.23, "timestamp": "03:08:38", "text": "跳入水中。我的天啊。我没有"}, {"type": "subtitle", "time": 11322.349, "timestamp": "03:08:42", "text": "做H。实际上是跳进去。"}, {"type": "subtitle", "time": 11324.99, "timestamp": "03:08:44", "text": "水。不。"}, {"type": "subtitle", "time": 11327.07, "timestamp": "03:08:47", "text": "哦，这是什么？"}, {"type": "subtitle", "time": 11330.11, "timestamp": "03:08:50", "text": "这？哦，那是一个"}, {"type": "subtitle", "time": 11332.75, "timestamp": "03:08:52", "text": "药水。他是吗？"}, {"type": "subtitle", "time": 11335.23, "timestamp": "03:08:55", "text": "僵尸？他是一个"}]
[{"type": "subtitle", "time": 13447.51, "timestamp": "03:44:07", "text": "好的。豁出去了。交叉你的"}, {"type": "subtitle", "time": 13450.469, "timestamp": "03:44:10", "text": "手指。这是个泵的问题。正确的。在"}, {"type": "subtitle", "time": 13451.91, "timestamp": "03:44:11", "text": "再过几分钟，就会有水了。"}, {"type": "subtitle", "time": 13453.48, "timestamp": "03:44:13", "text": "又是农场。"}, {"type": "subtitle", "time": 13454.71, "timestamp": "03:44:14", "text": "[音乐]"}, {"type": "subtitle", "time": 13457.229, "timestamp": "03:44:17", "text": "哦，那是红色的"}, {"type": "subtitle", "time": 13459.91, "timestamp": "03:44:19", "text": "绿色的。三个果岭。这是个好兆头。"}, {"type": "subtitle", "time": 13464.95, "timestamp": "03:44:24", "text": "正确的？它不起作用。为什么会这样？"}, {"type": "subtitle", "time": 13471.91, "timestamp": "03:44:31", "text": "哦，不。拉屎。他们肯定把它关上了。"}, {"type": "subtitle", "time": 13474.63, "timestamp": "03:44:34", "text": "这套设备真是老古董了。"}, {"type": "subtitle", "time": 13477.03, "timestamp": "03:44:37", "text": "如果水管爆裂，我们都没事。"}, {"type": "subtitle", "time": 13479.189, "timestamp": "03:44:39", "text": "真是倒霉透了。我这就把阀门打开。"}, {"type": "subtitle", "time": 13482.229, "timestamp": "03:44:42", "text": "它在哪里？真是气死我了。"}, {"type": "subtitle", "time": 13484.55, "timestamp": "03:44:44", "text": "但我了解这条管道。好的。跟随"}, {"type": "subtitle", "time": 13487.55, "timestamp": "03:44:47", "text": "管道。真是见鬼了，"}, {"type": "subtitle", "time": 13491.189, "timestamp": "03:44:51", "text": "匆忙。去。我这边会继续尝试。"}, {"type": "subtitle", "time": 13493.95, "timestamp": "03:44:53", "text": "去吧"}, {"type": "subtitle", "time": 13495.38, "timestamp": "03:44:55", "text": "匆忙。得到"}, {"type": "subtitle", "time": 13496.99, "timestamp": "03:44:56", "text": "[音乐]"}]
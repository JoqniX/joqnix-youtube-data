[{"type": "subtitle", "time": 12301.91, "timestamp": "03:25:01", "text": "我？基本轮胎维修。你需要"}, {"type": "subtitle", "time": 12305.83, "timestamp": "03:25:05", "text": "四个螺丝。我的天哪，我没有"}, {"type": "subtitle", "time": 12307.63, "timestamp": "03:25:07", "text": "四"}, {"type": "subtitle", "time": 12310.51, "timestamp": "03:25:10", "text": "螺丝。好吧，我们开始吧"}, {"type": "subtitle", "time": 12315.15, "timestamp": "03:25:15", "text": "哦我的天哪，这太"}, {"type": "subtitle", "time": 12319.15, "timestamp": "03:25:19", "text": "好的。我的天哪。我们走吧。我得到了"}, {"type": "subtitle", "time": 12333.469, "timestamp": "03:25:33", "text": "[音乐]"}, {"type": "subtitle", "time": 12336.95, "timestamp": "03:25:36", "text": "乐趣。嘿，我要回那个地方吗？"}, {"type": "subtitle", "time": 12338.83, "timestamp": "03:25:38", "text": "不。对。哦，不。我"}, {"type": "subtitle", "time": 12341.229, "timestamp": "03:25:41", "text": "知道。我是"}, {"type": "subtitle", "time": 12357.79, "timestamp": "03:25:57", "text": "什么？哦，不。"}]
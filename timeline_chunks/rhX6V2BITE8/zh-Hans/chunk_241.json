[{"type": "subtitle", "time": 14462.59, "timestamp": "04:01:02", "text": "等待。我上去。"}, {"type": "subtitle", "time": 14470.55, "timestamp": "04:01:10", "text": "你好。"}, {"type": "subtitle", "time": 14473.67, "timestamp": "04:01:13", "text": "哦，天哪。先生，请听我讲故事。"}, {"type": "subtitle", "time": 14476.15, "timestamp": "04:01:16", "text": "好的。是的，我洗耳恭听。这是一个"}, {"type": "subtitle", "time": 14480.63, "timestamp": "04:01:20", "text": "这是一个关于傲慢与偏见的美丽故事。"}, {"type": "subtitle", "time": 14485.269, "timestamp": "04:01:25", "text": "战争与和平。它始于古代"}, {"type": "subtitle", "time": 14489.07, "timestamp": "04:01:29", "text": "那些你仍然在的日子"}, {"type": "subtitle", "time": 14498.349, "timestamp": "04:01:38", "text": "是"}, {"type": "subtitle", "time": 14504.87, "timestamp": "04:01:44", "text": "某物。哦，他没来。好的，因为"}, {"type": "subtitle", "time": 14508.75, "timestamp": "04:01:48", "text": "你吸了很多"}]
[{"type": "subtitle", "time": 11821.55, "timestamp": "03:17:01", "text": "白衬衫或"}, {"type": "subtitle", "time": 11824.83, "timestamp": "03:17:04", "text": "某物。那个人现在失踪了。"}, {"type": "subtitle", "time": 11826.83, "timestamp": "03:17:06", "text": "哇。"}, {"type": "subtitle", "time": 11836.19, "timestamp": "03:17:16", "text": "出去。我的天哪。感觉很糟糕"}, {"type": "subtitle", "time": 11851.229, "timestamp": "03:17:31", "text": "某物？哦，还有那些"}, {"type": "subtitle", "time": 11855.55, "timestamp": "03:17:35", "text": "呃，那种超大的黄色玩意儿"}, {"type": "subtitle", "time": 11859.269, "timestamp": "03:17:39", "text": "挡住了我的路。哦，忘了说了"}, {"type": "subtitle", "time": 11861.269, "timestamp": "03:17:41", "text": "你。如果你一个也没有，那就去找。"}, {"type": "subtitle", "time": 11863.11, "timestamp": "03:17:43", "text": "给自己准备一些武器。哦，你好啊。"}, {"type": "subtitle", "time": 11865.349, "timestamp": "03:17:45", "text": "那些被遗弃的人。"}, {"type": "subtitle", "time": 11866.469, "timestamp": "03:17:46", "text": "等等，什么？"}, {"type": "subtitle", "time": 11869.349, "timestamp": "03:17:49", "text": "你忘了告诉我这件事。嗯，他们"}, {"type": "subtitle", "time": 11874.229, "timestamp": "03:17:54", "text": "根本不重要。操"}, {"type": "subtitle", "time": 11875.79, "timestamp": "03:17:55", "text": "没有结构，"}, {"type": "subtitle", "time": 11879.59, "timestamp": "03:17:59", "text": "没有生意。"}]
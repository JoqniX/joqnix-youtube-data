[{"type": "subtitle", "time": 3180.47, "timestamp": "00:53:00", "text": "当天。正确的。所以，我们一直没有"}, {"type": "subtitle", "time": 3182.309, "timestamp": "00:53:02", "text": "打电话什么的。所以，我可能不得不"}, {"type": "subtitle", "time": 3184.87, "timestamp": "00:53:04", "text": "告诉他。是的，你或许应该……"}, {"type": "subtitle", "time": 3188.03, "timestamp": "00:53:08", "text": "不管怎样，说出我的真名。"}, {"type": "chat", "time": 3189.722, "timestamp": "00:53:09", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "joq don't go to Japan I am gonna miss you 😢😭"}, {"type": "subtitle", "time": 3190.91, "timestamp": "00:53:10", "text": "什么。和"}, {"type": "chat", "time": 3194.845, "timestamp": "00:53:14", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4"}, {"type": "subtitle", "time": 3194.87, "timestamp": "00:53:14", "text": "嗯，是的，呃，就像我给他一个基本的东西。"}, {"type": "subtitle", "time": 3197.829, "timestamp": "00:53:17", "text": "杂项清单。我可能会"}, {"type": "subtitle", "time": 3202.15, "timestamp": "00:53:22", "text": "我得问他要他的PNG文件。嗯，因为我"}, {"type": "subtitle", "time": 3204.549, "timestamp": "00:53:24", "text": "我为现实生活中的创作者和创作者们所做的一切"}, {"type": "subtitle", "time": 3207.03, "timestamp": "00:53:27", "text": "那些从不直播或非内容创作者，我"}, {"type": "subtitle", "time": 3209.87, "timestamp": "00:53:29", "text": "这样做就像他们要么可以大赚一笔。"}, {"type": "subtitle", "time": 3214.15, "timestamp": "00:53:34", "text": "船员将代表他们自己。我只想"}, {"type": "subtitle", "time": 3216.71, "timestamp": "00:53:36", "text": "某种东西来代表这一点，是的，这个"}, {"type": "subtitle", "time": 3218.95, "timestamp": "00:53:38", "text": "就是那种有人来过之类的情况。任何一个"}, {"type": "subtitle", "time": 3221.51, "timestamp": "00:53:41", "text": "你可以使用P组或者随机的动漫图片。"}, {"type": "subtitle", "time": 3225.99, "timestamp": "00:53:45", "text": "或者其他什么，嗯，或者他们现实生活中的事，如果"}, {"type": "subtitle", "time": 3227.309, "timestamp": "00:53:47", "text": "它们发生"}, {"type": "subtitle", "time": 3229.99, "timestamp": "00:53:49", "text": "在互联网上展示这些东西"}, {"type": "subtitle", "time": 3233.51, "timestamp": "00:53:53", "text": "等等，但我仅限于现实生活内容。"}, {"type": "subtitle", "time": 3236.03, "timestamp": "00:53:56", "text": "创作者们只因为"}, {"type": "subtitle", "time": 3238.63, "timestamp": "00:53:58", "text": "内容创作者再次利用他们的"}]
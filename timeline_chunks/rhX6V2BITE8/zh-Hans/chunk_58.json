[{"type": "subtitle", "time": 3481.91, "timestamp": "00:58:01", "text": "人们嗯嗯地回应，然后请他们给我一个"}, {"type": "subtitle", "time": 3484.95, "timestamp": "00:58:04", "text": "预计日期。我忙于自己的事情。"}, {"type": "subtitle", "time": 3490.309, "timestamp": "00:58:10", "text": "东西什么的。嗯，对，就是那玩意儿。"}, {"type": "subtitle", "time": 3491.75, "timestamp": "00:58:11", "text": "上周我不得不收拾行李。"}, {"type": "subtitle", "time": 3493.829, "timestamp": "00:58:13", "text": "全部备份，所有文件"}, {"type": "subtitle", "time": 3496.47, "timestamp": "00:58:16", "text": "以及所有的一切。所有这些文件"}, {"type": "subtitle", "time": 3498.63, "timestamp": "00:58:18", "text": "以及所有YouTube工作室相关的内容，"}, {"type": "subtitle", "time": 3502.87, "timestamp": "00:58:22", "text": "音乐制作相关的东西，呃，模型相关的东西，"}, {"type": "subtitle", "time": 3506.069, "timestamp": "00:58:26", "text": "一切。得给他们后援。"}, {"type": "subtitle", "time": 3509.109, "timestamp": "00:58:29", "text": "把一些固态硬盘装上去，也备份一下我的数据。"}, {"type": "subtitle", "time": 3512.23, "timestamp": "00:58:32", "text": "所有照片都是家庭照。呃，还有"}, {"type": "subtitle", "time": 3514.63, "timestamp": "00:58:34", "text": "就像把它们放进去，把它们放进我的"}, {"type": "subtitle", "time": 3517.27, "timestamp": "00:58:37", "text": "家人的账户，Google 云端硬盘或"}, {"type": "subtitle", "time": 3519.51, "timestamp": "00:58:39", "text": "我必须处理的事情"}, {"type": "subtitle", "time": 3524.23, "timestamp": "00:58:44", "text": "太多了，兄弟。我要死了。"}, {"type": "subtitle", "time": 3527.19, "timestamp": "00:58:47", "text": "嗯，不过最终我的航班会是……"}, {"type": "subtitle", "time": 3531.71, "timestamp": "00:58:51", "text": "6月30日或1日"}, {"type": "subtitle", "time": 3534.549, "timestamp": "00:58:54", "text": "七月我就要离开了，我会哭的。"}, {"type": "subtitle", "time": 3536.95, "timestamp": "00:58:56", "text": "或者如果我还能直播的话。"}, {"type": "subtitle", "time": 3539.91, "timestamp": "00:58:59", "text": "大约在第四周左右开始播出"}]
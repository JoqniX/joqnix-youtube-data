[{"type": "subtitle", "time": 10920.79, "timestamp": "03:02:00", "text": "我觉得我没有。正确的。我愿意。我的天啊。"}, {"type": "subtitle", "time": 10925.03, "timestamp": "03:02:05", "text": "我们走吧。我确实有武器和我的行动指令。"}, {"type": "subtitle", "time": 10929.67, "timestamp": "03:02:09", "text": "太空枪。我的天啊。我很想念你。我的"}, {"type": "subtitle", "time": 10932.51, "timestamp": "03:02:12", "text": "空间引力"}, {"type": "subtitle", "time": 10937.07, "timestamp": "03:02:17", "text": "枪就是我。格拉敏感性"}, {"type": "subtitle", "time": 10939.67, "timestamp": "03:02:19", "text": "改变了。已经很久没……"}, {"type": "subtitle", "time": 10948.67, "timestamp": "03:02:28", "text": "游戏。"}, {"type": "subtitle", "time": 10960.91, "timestamp": "03:02:40", "text": "蜂蜜。等等，我应该走哪条路？"}, {"type": "subtitle", "time": 10970.389, "timestamp": "03:02:50", "text": "好的。不，水感觉有毒，所以哦，"}, {"type": "subtitle", "time": 10972.23, "timestamp": "03:02:52", "text": "等待。这只是一瓶白开水。"}]
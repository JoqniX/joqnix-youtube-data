[{"type": "subtitle", "time": 423.83, "timestamp": "00:07:03", "text": "IST。是的，我当时正想去看一下……"}, {"type": "subtitle", "time": 426.309, "timestamp": "00:07:06", "text": "我好友列表里的每一个人"}, {"type": "subtitle", "time": 428.39, "timestamp": "00:07:08", "text": "到 Z"}, {"type": "subtitle", "time": 431.629, "timestamp": "00:07:11", "text": "呃，从A到Z，我联系了很多人。"}, {"type": "subtitle", "time": 434.39, "timestamp": "00:07:14", "text": "比我此时接触到的人数还要多。"}, {"type": "subtitle", "time": 437.589, "timestamp": "00:07:17", "text": "让这么多人看到，我当时就想，哇！"}, {"type": "subtitle", "time": 439.589, "timestamp": "00:07:19", "text": "太疯狂了。"}, {"type": "subtitle", "time": 442.029, "timestamp": "00:07:22", "text": "实际上"}, {"type": "subtitle", "time": 444.43, "timestamp": "00:07:24", "text": "疯狂的。"}, {"type": "subtitle", "time": 447.11, "timestamp": "00:07:27", "text": "嗯，是的，因为我记得我认识的人"}, {"type": "subtitle", "time": 449.39, "timestamp": "00:07:29", "text": "珍惜人，而不是某个人。"}, {"type": "subtitle", "time": 452.67, "timestamp": "00:07:32", "text": "忘记粉色了。所以"}, {"type": "subtitle", "time": 454.199, "timestamp": "00:07:34", "text": "所以 总之，总之，所以我想得到一些"}, {"type": "subtitle", "time": 458.319, "timestamp": "00:07:38", "text": "总之，总之，所以我想得到一些 工作完成。呃，任务列表"}, {"type": "subtitle", "time": 462.479, "timestamp": "00:07:42", "text": "工作完成。呃，任务列表 今天的工作是写出这两段文字。"}, {"type": "subtitle", "time": 465.84000000000003, "timestamp": "00:07:45", "text": "今天的工作是写出这两段文字。 最后两期节目的概要"}, {"type": "subtitle", "time": 467.36, "timestamp": "00:07:47", "text": "最后两期节目的概要 昨天和前天"}, {"type": "subtitle", "time": 469.28, "timestamp": "00:07:49", "text": "昨天和前天 推特上的总结是：一二我"}, {"type": "subtitle", "time": 473.12, "timestamp": "00:07:53", "text": "推特上的总结是：一二我 想最终确定并把"}, {"type": "subtitle", "time": 475.68, "timestamp": "00:07:55", "text": "想最终确定并把 参加运动会的人"}, {"type": "subtitle", "time": 478.639, "timestamp": "00:07:58", "text": "参加运动会的人 本周和下周将有合作项目"}]
[{"type": "subtitle", "time": 14161.429, "timestamp": "03:56:01", "text": "你会发现自己比任何一个男人都更容易找到工作。"}, {"type": "subtitle", "time": 14164.389, "timestamp": "03:56:04", "text": "可以应付。"}, {"type": "subtitle", "time": 14166.55, "timestamp": "03:56:06", "text": "信任度。发现的唯一途径"}, {"type": "subtitle", "time": 14168.229, "timestamp": "03:56:08", "text": "太阳之子的秘密"}, {"type": "subtitle", "time": 14171.389, "timestamp": "03:56:11", "text": "是赢得的认可"}, {"type": "subtitle", "time": 14175.269, "timestamp": "03:56:15", "text": "P. 母亲最忠实的守护者。"}, {"type": "subtitle", "time": 14177.99, "timestamp": "03:56:17", "text": "完成任务。帮助你在……中遇到的人"}, {"type": "subtitle", "time": 14181.429, "timestamp": "03:56:21", "text": "野外。安全区域。除了尝试"}, {"type": "subtitle", "time": 14189.91, "timestamp": "03:56:29", "text": "好的。所以这意味着我们要升级了。"}, {"type": "subtitle", "time": 14191.15, "timestamp": "03:56:31", "text": "我们的"}, {"type": "subtitle", "time": 14195.03, "timestamp": "03:56:35", "text": "信仰。信任度不足。你是"}, {"type": "subtitle", "time": 14197.55, "timestamp": "03:56:37", "text": "现在成了陌生人。"}, {"type": "subtitle", "time": 14210.51, "timestamp": "03:56:50", "text": "老太太一直唠叨着让我摆姿势"}, {"type": "subtitle", "time": 14213.99, "timestamp": "03:56:53", "text": "这说明可能有一只发情的母猫。"}, {"type": "subtitle", "time": 14218.99, "timestamp": "03:56:58", "text": "或者生病的猫在阀门附近哭泣"}]
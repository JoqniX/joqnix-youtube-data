[{"type": "subtitle", "time": 3843.309, "timestamp": "01:04:03", "text": "好的。你好。让我再确认一下"}, {"type": "subtitle", "time": 3845.51, "timestamp": "01:04:05", "text": "抽搐。那很好。让我加倍"}, {"type": "subtitle", "time": 3846.75, "timestamp": "01:04:06", "text": "检查"}, {"type": "subtitle", "time": 3849.19, "timestamp": "01:04:09", "text": "踢。那也很好。让我加倍"}, {"type": "subtitle", "time": 3857.15, "timestamp": "01:04:17", "text": "光束。那也很好。好的。全部"}, {"type": "subtitle", "time": 3859.99, "timestamp": "01:04:19", "text": "正确的。一切都好。一切都好。一切都好。"}, {"type": "subtitle", "time": 3880.99, "timestamp": "01:04:40", "text": "[音乐]"}, {"type": "subtitle", "time": 3884.069, "timestamp": "01:04:44", "text": "好的。我的天哪，你已经被打包好了。"}, {"type": "subtitle", "time": 3886.51, "timestamp": "01:04:46", "text": "是的。嗯，我会尽量把我的事情整理好。"}, {"type": "subtitle", "time": 3889.39, "timestamp": "01:04:49", "text": "15日15日我把它记下来。"}, {"type": "subtitle", "time": 3893.069, "timestamp": "01:04:53", "text": "海伦。呃，我得把你记下来。"}]
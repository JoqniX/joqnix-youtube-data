[{"type": "subtitle", "time": 16921.788, "timestamp": "04:42:01", "text": "超高速。只要做好就行了。"}, {"type": "subtitle", "time": 16925.27, "timestamp": "04:42:05", "text": "现在。我本来应该更早做的，但是"}, {"type": "subtitle", "time": 16926.51, "timestamp": "04:42:06", "text": "我"}, {"type": "subtitle", "time": 16930.47, "timestamp": "04:42:10", "text": "忘了。是的。我的错。我的错。你好。或者你"}, {"type": "subtitle", "time": 16933.59, "timestamp": "04:42:13", "text": "我可以查看一下公告。"}, {"type": "subtitle", "time": 16936.55, "timestamp": "04:42:16", "text": "在社区动态中。你可以得到它"}, {"type": "subtitle", "time": 16941.51, "timestamp": "04:42:21", "text": "从那里也是一样。我还有什么？"}, {"type": "subtitle", "time": 16942.91, "timestamp": "04:42:22", "text": "我是否"}, {"type": "subtitle", "time": 16946.03, "timestamp": "04:42:26", "text": "错过？我总觉得我错过了什么。"}, {"type": "subtitle", "time": 16949.75, "timestamp": "04:42:29", "text": "某物。我忘了说一件事。"}, {"type": "subtitle", "time": 16952.03, "timestamp": "04:42:32", "text": "娜妮 娜妮 娜妮。"}, {"type": "subtitle", "time": 16955.75, "timestamp": "04:42:35", "text": "是的，我们将遵循"}, {"type": "subtitle", "time": 16958.47, "timestamp": "04:42:38", "text": "安排，呃，像正规的路径一样安排。"}, {"type": "subtitle", "time": 16961.51, "timestamp": "04:42:41", "text": "从现在开始，很长一段时间内都是如此。"}, {"type": "subtitle", "time": 16962.99, "timestamp": "04:42:42", "text": "自从"}, {"type": "subtitle", "time": 16966.868, "timestamp": "04:42:46", "text": "一月份一直在进行大猩猩弧线研究。所以这"}, {"type": "subtitle", "time": 16968.67, "timestamp": "04:42:48", "text": "我只想拥有的时间"}, {"type": "subtitle", "time": 16973.19, "timestamp": "04:42:53", "text": "做直播，比如做直播"}, {"type": "subtitle", "time": 16975.43, "timestamp": "04:42:55", "text": "短直播，比如最多2小时。"}, {"type": "subtitle", "time": 16979.67, "timestamp": "04:42:59", "text": "对，最多四个，嗯，是的，不会的。"}]
[{"type": "subtitle", "time": 19447.83, "timestamp": "05:24:07", "text": "嗯哼。哦，等等。我换错了。"}, {"type": "subtitle", "time": 19449.91, "timestamp": "05:24:09", "text": "场景。哦，对不起。哦，那是"}, {"type": "subtitle", "time": 19453.07, "timestamp": "05:24:13", "text": "应该是垂直方向的水流。"}, {"type": "subtitle", "time": 19455.52, "timestamp": "05:24:15", "text": "呃，等等。在哪里？"}, {"type": "subtitle", "time": 19458.27, "timestamp": "05:24:18", "text": "[音乐]"}, {"type": "subtitle", "time": 19460.35, "timestamp": "05:24:20", "text": "那玩意儿？哦，是的"}, {"type": "subtitle", "time": 19463.31, "timestamp": "05:24:23", "text": "好的。我以后再想办法。"}, {"type": "subtitle", "time": 19466.15, "timestamp": "05:24:26", "text": "等等，我的玩家人数没有显示。"}, {"type": "subtitle", "time": 19467.628, "timestamp": "05:24:27", "text": "我做过吗？"}, {"type": "subtitle", "time": 19471.708, "timestamp": "05:24:31", "text": "昨天？我确实这么做了，对吧？但是它在哪里？"}, {"type": "subtitle", "time": 19475.35, "timestamp": "05:24:35", "text": "它？我没做。等等，让我……"}, {"type": "subtitle", "time": 19477.67, "timestamp": "05:24:37", "text": "裁剪此部分以适应垂直方向的文本流。一"}, {"type": "subtitle", "time": 19483.59, "timestamp": "05:24:43", "text": "呃，对于那些正在观看的人来说……"}, {"type": "subtitle", "time": 19485.03, "timestamp": "05:24:45", "text": "垂直流，很抱歉发生了这样的事。"}, {"type": "subtitle", "time": 19495.19, "timestamp": "05:24:55", "text": "好的。好的。现在我们可以看到有多少"}, {"type": "subtitle", "time": 19497.11, "timestamp": "05:24:57", "text": "人们还活着。呃，我们要去哪儿？"}, {"type": "subtitle", "time": 19499.59, "timestamp": "05:24:59", "text": "我们去那个谷仓吧。你如何前往"}]
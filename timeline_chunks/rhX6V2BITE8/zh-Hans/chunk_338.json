[{"type": "subtitle", "time": 20294.51, "timestamp": "05:38:14", "text": "借口"}, {"type": "subtitle", "time": 20297.99, "timestamp": "05:38:17", "text": "我，Piku？嗯，我知道我是在公开场合，"}, {"type": "subtitle", "time": 20299.39, "timestamp": "05:38:19", "text": "但它是"}, {"type": "subtitle", "time": 20306.868, "timestamp": "05:38:26", "text": "狗。你甚至都无法穿过它射击。"}, {"type": "subtitle", "time": 20319.07, "timestamp": "05:38:39", "text": "箍。你在开玩笑吧？这款游戏"}, {"type": "subtitle", "time": 20321.868, "timestamp": "05:38:41", "text": "是"}, {"type": "subtitle", "time": 20327.628, "timestamp": "05:38:47", "text": "哑的。处决我。我正在拍摄。"}, {"type": "subtitle", "time": 20330.35, "timestamp": "05:38:50", "text": "好的。"}, {"type": "subtitle", "time": 20333.41, "timestamp": "05:38:53", "text": "哦。哦，我的"}]
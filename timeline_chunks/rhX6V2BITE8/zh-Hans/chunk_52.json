[{"type": "subtitle", "time": 3125.75, "timestamp": "00:52:05", "text": "这？他是真正得到的人。"}, {"type": "subtitle", "time": 3128.87, "timestamp": "00:52:08", "text": "让我摆脱了内向的性格。不内向"}, {"type": "subtitle", "time": 3130.549, "timestamp": "00:52:10", "text": "就像被关起来一样，当时没有人"}, {"type": "subtitle", "time": 3133.109, "timestamp": "00:52:13", "text": "你知道，那样做是为了让我出去，让我出去"}, {"type": "subtitle", "time": 3135.349, "timestamp": "00:52:15", "text": "把我从房间里赶出去，一切都结束了。这"}, {"type": "subtitle", "time": 3137.27, "timestamp": "00:52:17", "text": "只有那个小鬼会这样说："}, {"type": "subtitle", "time": 3139.829, "timestamp": "00:52:19", "text": "“是啊，出来吧。我要带你去……”"}, {"type": "subtitle", "time": 3142.79, "timestamp": "00:52:22", "text": "电影。我带你去吃午饭。"}, {"type": "subtitle", "time": 3145.03, "timestamp": "00:52:25", "text": "一切。”"}, {"type": "subtitle", "time": 3149.47, "timestamp": "00:52:29", "text": "感觉太好了，就像之后那样"}, {"type": "subtitle", "time": 3154.39, "timestamp": "00:52:34", "text": "很久以前我就和他一起去看电影什么的"}, {"type": "subtitle", "time": 3157.75, "timestamp": "00:52:37", "text": "它让我成为了一个值得信赖的朋友。"}, {"type": "subtitle", "time": 3160.47, "timestamp": "00:52:40", "text": "感到高兴，但可惜的是，他……"}, {"type": "subtitle", "time": 3163.67, "timestamp": "00:52:43", "text": "他现在在迪拜，无法照顾……"}, {"type": "subtitle", "time": 3166.23, "timestamp": "00:52:46", "text": "我和他们没法一起出去玩。"}, {"type": "subtitle", "time": 3168.549, "timestamp": "00:52:48", "text": "虽然现在不怎么联系了，但我们还是会打电话什么的。我们"}, {"type": "subtitle", "time": 3170.47, "timestamp": "00:52:50", "text": "一直都无法打电话或交谈。"}, {"type": "subtitle", "time": 3173.19, "timestamp": "00:52:53", "text": "自从我一直专注于Joathon以来"}, {"type": "subtitle", "time": 3175.75, "timestamp": "00:52:55", "text": "3月12日。我开始直播，而且我已经"}, {"type": "subtitle", "time": 3177.589, "timestamp": "00:52:57", "text": "自那以后，已经连续直播了24小时。"}]
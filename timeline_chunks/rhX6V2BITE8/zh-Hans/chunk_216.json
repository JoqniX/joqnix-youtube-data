[{"type": "subtitle", "time": 12960.469, "timestamp": "03:36:00", "text": "盔甲。好的。"}, {"type": "subtitle", "time": 12964.67, "timestamp": "03:36:04", "text": "我打算选择步枪护甲。军队"}, {"type": "subtitle", "time": 12967.429, "timestamp": "03:36:07", "text": "步枪。是啊，我杀的越多这些"}, {"type": "subtitle", "time": 12974.95, "timestamp": "03:36:14", "text": "弹药。或许我正在寻找的就是这个。在哪里"}, {"type": "subtitle", "time": 12977.87, "timestamp": "03:36:17", "text": "我从这里干掉他们两个。"}, {"type": "subtitle", "time": 12980.55, "timestamp": "03:36:20", "text": "正确的？我找不到它们。我在哪里？"}, {"type": "subtitle", "time": 12982.429, "timestamp": "03:36:22", "text": "杀了那两个人"}, {"type": "subtitle", "time": 12986.469, "timestamp": "03:36:26", "text": "人们？这个。不。"}, {"type": "subtitle", "time": 12988.389, "timestamp": "03:36:28", "text": "不，这里没有。"}, {"type": "subtitle", "time": 12995.229, "timestamp": "03:36:35", "text": "这不是我要找的那一个。"}, {"type": "subtitle", "time": 12998.67, "timestamp": "03:36:38", "text": "呃，等等，你怎么……好吧，明白了。"}, {"type": "subtitle", "time": 13005.349, "timestamp": "03:36:45", "text": "不，我当时正试图切换到"}, {"type": "subtitle", "time": 13008.15, "timestamp": "03:36:48", "text": "用抓钩抓住那个……"}, {"type": "subtitle", "time": 13010.87, "timestamp": "03:36:50", "text": "光线很好之类的。我的意思是，但是"}, {"type": "subtitle", "time": 13013.349, "timestamp": "03:36:53", "text": "没关系。我认为它本来就会有"}, {"type": "subtitle", "time": 13015.51, "timestamp": "03:36:55", "text": "已保存。"}, {"type": "subtitle", "time": 13018.67, "timestamp": "03:36:58", "text": "我想应该是吧。哦，不。就是这样"}]
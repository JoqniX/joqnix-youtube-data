[{"type": "subtitle", "time": 10441.15, "timestamp": "02:54:01", "text": "向上。他在哪儿？哦，打开门。打开"}, {"type": "subtitle", "time": 10442.75, "timestamp": "02:54:02", "text": "向上"}, {"type": "subtitle", "time": 10447.11, "timestamp": "02:54:07", "text": "打开。好的。所以对于那些不了解的人来说"}, {"type": "subtitle", "time": 10449.429, "timestamp": "02:54:09", "text": "那些一直与……保持联系的人"}, {"type": "subtitle", "time": 10450.67, "timestamp": "02:54:10", "text": "我的"}, {"type": "subtitle", "time": 10455.23, "timestamp": "02:54:15", "text": "你知道，我们即将开始。"}, {"type": "subtitle", "time": 10459.83, "timestamp": "02:54:19", "text": "我们的日程安排又来了。是的，"}, {"type": "subtitle", "time": 10463.15, "timestamp": "02:54:23", "text": "从我们的日程安排开始，就真的要从这里开始。"}, {"type": "subtitle", "time": 10465.95, "timestamp": "02:54:25", "text": "东西。如果我可以的话"}, {"type": "subtitle", "time": 10471.269, "timestamp": "02:54:31", "text": "找到地方。等等，稍等。"}, {"type": "subtitle", "time": 10473.75, "timestamp": "02:54:33", "text": "我的呢？哦，我没把它放进去。"}, {"type": "subtitle", "time": 10475.99, "timestamp": "02:54:35", "text": "场景。哦，我的错。我的错。我的错。我"}, {"type": "subtitle", "time": 10478.15, "timestamp": "02:54:38", "text": "我没有把它放进这个场景里。"}, {"type": "subtitle", "time": 10480.269, "timestamp": "02:54:40", "text": "好的，我的"}, {"type": "subtitle", "time": 10483.389, "timestamp": "02:54:43", "text": "坏的。呃，让我复制一下"}, {"type": "subtitle", "time": 10489.07, "timestamp": "02:54:49", "text": "这。抱歉说了这么多技术性的东西。但"}, {"type": "subtitle", "time": 10491.469, "timestamp": "02:54:51", "text": "是的，完成了。快完成了。几乎"}, {"type": "subtitle", "time": 10496.51, "timestamp": "02:54:56", "text": "完毕。你好。这个。你好。所以你可以"}]
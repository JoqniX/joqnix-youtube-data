[{"type": "subtitle", "time": 14705.349, "timestamp": "04:05:05", "text": "它的成员对病毒免疫。"}, {"type": "subtitle", "time": 14708.55, "timestamp": "04:05:08", "text": "另外，我有点喜欢……我有点喜欢"}, {"type": "subtitle", "time": 14710.71, "timestamp": "04:05:10", "text": "金色的那一个。我不知道。他们是"}, {"type": "subtitle", "time": 14712.71, "timestamp": "04:05:12", "text": "受当地某种萨满类型的保护"}, {"type": "subtitle", "time": 14714.63, "timestamp": "04:05:14", "text": "给母亲打了电话。仅进行交流"}, {"type": "subtitle", "time": 14716.87, "timestamp": "04:05:16", "text": "通过她的祭司们。我会尽量进去。"}, {"type": "subtitle", "time": 14717.99, "timestamp": "04:05:17", "text": "与他们接触，但这些人却不接触"}, {"type": "subtitle", "time": 14721.429, "timestamp": "04:05:21", "text": "别相信外人。继续尝试，"}, {"type": "subtitle", "time": 14739.189, "timestamp": "04:05:39", "text": "挑战？所以，最棒的一点是"}, {"type": "subtitle", "time": 14742.75, "timestamp": "04:05:42", "text": "这个DLC的亮点在于你可以直接开车。"}, {"type": "subtitle", "time": 14753.83, "timestamp": "04:05:53", "text": "东西，说实话，非常好。"}, {"type": "subtitle", "time": 14757.229, "timestamp": "04:05:57", "text": "我认为如果你把车开走的话"}]
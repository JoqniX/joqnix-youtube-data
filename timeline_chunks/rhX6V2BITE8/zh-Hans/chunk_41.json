[{"type": "subtitle", "time": 2460.95, "timestamp": "00:41:00", "text": "我不需要做任何交易性的事情。"}, {"type": "subtitle", "time": 2463.99, "timestamp": "00:41:03", "text": "打算留到最后，但还没决定。"}, {"type": "subtitle", "time": 2466.23, "timestamp": "00:41:06", "text": "他们欣然同意，而且还有……"}, {"type": "subtitle", "time": 2468.39, "timestamp": "00:41:08", "text": "几个人，几个人，我"}, {"type": "subtitle", "time": 2475.23, "timestamp": "00:41:15", "text": "嗯，很多事情，是的，所有的事情"}, {"type": "subtitle", "time": 2478.15, "timestamp": "00:41:18", "text": "所有这些都很好，嗯，你真棒"}, {"type": "subtitle", "time": 2481.349, "timestamp": "00:41:21", "text": "带上你的视频画笔。是的。嗯"}, {"type": "subtitle", "time": 2483.349, "timestamp": "00:41:23", "text": "是的，那些一直在直播的人"}, {"type": "subtitle", "time": 2486.23, "timestamp": "00:41:26", "text": "东西，而且我还收到了一些"}, {"type": "subtitle", "time": 2488.47, "timestamp": "00:41:28", "text": "人。他在哪儿？我认为我"}, {"type": "subtitle", "time": 2491.75, "timestamp": "00:41:31", "text": "把他带过来。等等，我定好日期了吗？"}, {"type": "subtitle", "time": 2492.75, "timestamp": "00:41:32", "text": "为了"}, {"type": "subtitle", "time": 2496.79, "timestamp": "00:41:36", "text": "他？我没有。正确的。哦，他在哪儿？"}, {"type": "subtitle", "time": 2500.39, "timestamp": "00:41:40", "text": "他正在参加考试。好的。从本周开始"}, {"type": "subtitle", "time": 2502.47, "timestamp": "00:41:42", "text": "等等，我记得我把它放在某个地方了。"}, {"type": "subtitle", "time": 2505.43, "timestamp": "00:41:45", "text": "我到底把他放在哪里了？有一个"}, {"type": "subtitle", "time": 2509.43, "timestamp": "00:41:49", "text": "某个笨蛋，他从未出道过，但是"}, {"type": "subtitle", "time": 2513.95, "timestamp": "00:41:53", "text": "他永远都处于出道前的状态。"}, {"type": "subtitle", "time": 2516.87, "timestamp": "00:41:56", "text": "片刻。六月中旬午后。"}, {"type": "subtitle", "time": 2519.99, "timestamp": "00:41:59", "text": "好的。六月中旬演出。那就像我"}]
[{"type": "subtitle", "time": 11402.99, "timestamp": "03:10:02", "text": "[音乐]"}, {"type": "subtitle", "time": 11411.83, "timestamp": "03:10:11", "text": "它。我们得到了一个黑色边缘。那是金子"}, {"type": "subtitle", "time": 11414.51, "timestamp": "03:10:14", "text": "武器。火焰刺击。"}, {"type": "subtitle", "time": 11417.71, "timestamp": "03:10:17", "text": "好的。和"}, {"type": "subtitle", "time": 11419.75, "timestamp": "03:10:19", "text": "有趣的。好了，就这些。我当时想"}, {"type": "subtitle", "time": 11423.99, "timestamp": "03:10:23", "text": "我会解锁一些东西，但是不会。"}, {"type": "subtitle", "time": 11426.269, "timestamp": "03:10:26", "text": "哦，那是一个"}, {"type": "subtitle", "time": 11430.389, "timestamp": "03:10:30", "text": "僵尸。荷兰语。等等，所以僵尸是"}, {"type": "subtitle", "time": 11432.71, "timestamp": "03:10:32", "text": "这里有吗？我当时想……"}, {"type": "subtitle", "time": 11434.51, "timestamp": "03:10:34", "text": "自由"}, {"type": "subtitle", "time": 11437.75, "timestamp": "03:10:37", "text": "僵尸就像“我的天哪，那简直太可怕了”"}, {"type": "subtitle", "time": 11450.07, "timestamp": "03:10:50", "text": "那个地方看起来好像有人住。"}]
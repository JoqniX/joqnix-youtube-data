[{"type": "subtitle", "time": 16419.07, "timestamp": "04:33:39", "text": "BLC塗裝。子彈掛飾。呃，我想看空間滾輪。實際上，你讓我們都很擔心。"}, {"type": "subtitle", "time": 16428.629, "timestamp": "04:33:48", "text": "。這裡有"}, {"type": "subtitle", "time": 16431.029, "timestamp": "04:33:51", "text": "一群人。而且他們所有成員都對病毒免疫"}, {"type": "subtitle", "time": 16439.67, "timestamp": "04:33:59", "text": "。"}]
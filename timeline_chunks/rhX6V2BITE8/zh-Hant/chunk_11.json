[{"type": "subtitle", "time": 660.79, "timestamp": "00:11:00", "text": "證明這一點，對吧？尤其是"}, {"type": "subtitle", "time": 663.67, "timestamp": "00:11:03", "text": "Jockathon 的直播。我一"}, {"type": "subtitle", "time": 668.31, "timestamp": "00:11:08", "text": "開始就說過，大概是3月20日，"}, {"type": "subtitle", "time": 670.71, "timestamp": "00:11:10", "text": "12號或15號左右，"}, {"type": "subtitle", "time": 673.59, "timestamp": "00:11:13", "text": "我要做24小時，"}, {"type": "subtitle", "time": 675.75, "timestamp": "00:11:15", "text": "而且我做到了，不是嗎？雖然我承認我做了一些"}, {"type": "subtitle", "time": 680.31, "timestamp": "00:11:20", "text": "休息之類的事情，讓我的"}, {"type": "subtitle", "time": 683.11, "timestamp": "00:11:23", "text": "虛弱的身體真正得到休息，這樣"}, {"type": "subtitle", "time": 685.35, "timestamp": "00:11:25", "text": "我就不會感到精疲力竭，但"}, {"type": "subtitle", "time": 687.829, "timestamp": "00:11:27", "text": "我還是堅持了"}, {"type": "subtitle", "time": 689.43, "timestamp": "00:11:29", "text": "三個月，這是"}, {"type": "subtitle", "time": 696.069, "timestamp": "00:11:36", "text": "剩下的最後一個月了。所以，我很高興。我很高興。我很"}, {"type": "subtitle", "time": 698.91, "timestamp": "00:11:38", "text": "榮幸能來到這裡"}, {"type": "subtitle", "time": 703.19, "timestamp": "00:11:43", "text": "。"}, {"type": "subtitle", "time": 704.75, "timestamp": "00:11:44", "text": "[音樂]"}]
[{"type": "subtitle", "time": 240.229, "timestamp": "00:04:00", "text": "從第二週開始就有考試了，"}, {"type": "subtitle", "time": 244.229, "timestamp": "00:04:04", "text": "而且我還要參加"}, {"type": "subtitle", "time": 250.39, "timestamp": "00:04:10", "text": "這個月最後一周的COE儀式，最後"}, {"type": "subtitle", "time": 252.35, "timestamp": "00:04:12", "text": "一周我還要收拾"}, {"type": "subtitle", "time": 255.589, "timestamp": "00:04:15", "text": "東西。備份我的備份。兄弟，我"}, {"type": "subtitle", "time": 257.99, "timestamp": "00:04:17", "text": "連把東西備份到"}, {"type": "subtitle", "time": 261.11, "timestamp": "00:04:21", "text": "Google雲端硬碟的時間都沒有。是啊，那就是你，因為"}, {"type": "subtitle", "time": 264.15, "timestamp": "00:04:24", "text": "我要走了。我打算放棄我的桌上型電腦，"}, {"type": "subtitle", "time": 266.07, "timestamp": "00:04:26", "text": "去日本買一台筆記型電腦之"}, {"type": "subtitle", "time": 267.87, "timestamp": "00:04:27", "text": "類的東西。所以，我必須想辦法"}, {"type": "subtitle", "time": 270.87, "timestamp": "00:04:30", "text": "再三思考，想想"}, {"type": "subtitle", "time": 272.909, "timestamp": "00:04:32", "text": "我能做些什麼來得到"}, {"type": "subtitle", "time": 277.35, "timestamp": "00:04:37", "text": "我的……該怎麼稱呼它呢？儲存"}, {"type": "subtitle", "time": 280.87, "timestamp": "00:04:40", "text": "系統和所有"}]
[{"type": "subtitle", "time": 11061.67, "timestamp": "03:04:21", "text": "Toto，我該怎麼彈出這個？我該如何把它取下來而不出錯呢？"}, {"type": "subtitle", "time": 11076.87, "timestamp": "03:04:36", "text": "嗯，等等。"}, {"type": "subtitle", "time": 11080.15, "timestamp": "03:04:40", "text": "讓我把這個人介紹出來。他在哪裡？哦，打開門。打開打開。好的。所以，對於那些不了解情況的人，以及那些一直關注我動態的"}, {"type": "subtitle", "time": 11082.79, "timestamp": "03:04:42", "text": "人，"}, {"type": "subtitle", "time": 11098.23, "timestamp": "03:04:58", "text": "你們都知道我們又要開始安排行程了。是的，就從我們的行程開始"}]
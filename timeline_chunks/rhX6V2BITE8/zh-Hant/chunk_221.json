[{"type": "subtitle", "time": 13260.75, "timestamp": "03:41:00", "text": "我想我會選紅色"}, {"type": "subtitle", "time": 13271.03, "timestamp": "03:41:11", "text": "我身上有帶什麼"}, {"type": "subtitle", "time": 13308.34, "timestamp": "03:41:48", "text": "天哪。我們走吧。我搭上了車。你在嗎？  這音樂真好玩。嘿，我要回那個地方嗎？"}, {"type": "subtitle", "time": 13316.63, "timestamp": "03:41:56", "text": "不。對。哦，不。我"}]
[{"type": "subtitle", "time": 30969.03, "timestamp": "08:36:09", "text": "之前選定的那個負責索具的人過去。他們準備幫我操縱一切。"}, {"type": "subtitle", "time": 30980.07, "timestamp": "08:36:20", "text": "即使到了今天，他們也做好了準備。  我只要說一句話，他們就準備操縱一切。他們從本月開始工作，並計劃在下月底完成。這樣"}, {"type": "subtitle", "time": 30987.51, "timestamp": "08:36:27", "text": "我就可以在八月我生日之前把模型準備好，讓它首次亮相"}, {"type": "subtitle", "time": 30997.35, "timestamp": "08:36:37", "text": "。但我"}, {"type": "subtitle", "time": 30999.91, "timestamp": "08:36:39", "text": "心想，我沒有2000美元。我居然要為藝術品付費，真是太糟糕了"}]
[{"type": "subtitle", "time": 963.43, "timestamp": "00:16:03", "text": "進行類似視訊會議的確認溝通"}, {"type": "subtitle", "time": 967.55, "timestamp": "00:16:07", "text": "。  嗯，有些人我"}, {"type": "subtitle", "time": 972.99, "timestamp": "00:16:12", "text": "不喜歡，像是那些看過我影片、了解我的人，這都沒關係"}, {"type": "subtitle", "time": 997.509, "timestamp": "00:16:37", "text": "未開啟"}, {"type": "subtitle", "time": 1004.55, "timestamp": "00:16:44", "text": "。顯然有人正在搬去踢球。順便說一句，大家都要去踢球。所以我覺得我"}, {"type": "subtitle", "time": 1007.91, "timestamp": "00:16:47", "text": "需要專注"}]
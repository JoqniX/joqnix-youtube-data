[{"type": "subtitle", "time": 22515.95, "timestamp": "06:15:15", "text": "別再這樣"}, {"type": "subtitle", "time": 22525.47, "timestamp": "06:15:25", "text": "跑了。"}, {"type": "subtitle", "time": 22528.39, "timestamp": "06:15:28", "text": "我為什麼會這樣"}, {"type": "subtitle", "time": 22529.948, "timestamp": "06:15:29", "text": "奔跑？  真倒楣。  真倒楣。背後的鑰匙。好吧，這裡曾經有人。"}, {"type": "subtitle", "time": 22548.47, "timestamp": "06:15:48", "text": "我該如何停止"}]
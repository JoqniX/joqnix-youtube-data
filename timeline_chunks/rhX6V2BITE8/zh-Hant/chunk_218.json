[{"type": "subtitle", "time": 13091.11, "timestamp": "03:38:11", "text": "他們吧。"}, {"type": "subtitle", "time": 13103.59, "timestamp": "03:38:23", "text": "我的天哪。那挺好的。謝天謝地，應該不是什麼大事吧"}, {"type": "subtitle", "time": 13108.389, "timestamp": "03:38:28", "text": "？負責演出事宜。你反而讓我更"}, {"type": "subtitle", "time": 13111.51, "timestamp": "03:38:31", "text": "擔心了。非常感謝。哦，這是一種新型的箱子。  一個黑色箱子。  我"}, {"type": "subtitle", "time": 13119.87, "timestamp": "03:38:39", "text": "差點就成功了。但它在哪裡呢"}]
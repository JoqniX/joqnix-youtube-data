[{"type": "subtitle", "time": 10395.03, "timestamp": "02:53:15", "text": "正確的。觀察"}, {"type": "subtitle", "time": 10399.83, "timestamp": "02:53:19", "text": "。哦，他們有反應。我的"}, {"type": "subtitle", "time": 10404.389, "timestamp": "02:53:24", "text": "天啊。他們之間有某種聯繫。連接黑盒子語音。"}, {"type": "subtitle", "time": 10408.469, "timestamp": "02:53:28", "text": "哦，等等。  他們之間有某種聯繫。"}, {"type": "subtitle", "time": 10418.63, "timestamp": "02:53:38", "text": "普羅布斯。"}, {"type": "subtitle", "time": 10434.59, "timestamp": "02:53:54", "text": "等待。這是她說的。這是"}]
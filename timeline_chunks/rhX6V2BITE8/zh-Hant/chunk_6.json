[{"type": "subtitle", "time": 362.35, "timestamp": "00:06:02", "text": "？兩小時前。等等，"}, {"type": "subtitle", "time": 373.75, "timestamp": "00:06:13", "text": "那裡。謝謝"}, {"type": "subtitle", "time": 377.909, "timestamp": "00:06:17", "text": "你，臭名昭著的凱倫。我不知道"}, {"type": "subtitle", "time": 379.43, "timestamp": "00:06:19", "text": "你是否還在關注我，但還是要感謝你的"}, {"type": "subtitle", "time": 381.15, "timestamp": "00:06:21", "text": "關注。"}, {"type": "subtitle", "time": 384.71, "timestamp": "00:06:24", "text": "歡迎。呃，Sky Mashan，你好。呃，"}, {"type": "subtitle", "time": 386.23, "timestamp": "00:06:26", "text": "她睡著了，兒子。我不知道你是否還在，但"}, {"type": "subtitle", "time": 387.83, "timestamp": "00:06:27", "text": "感謝你來"}, {"type": "subtitle", "time": 389.83, "timestamp": "00:06:29", "text": "Twitch觀看我的直播。你"}, {"type": "subtitle", "time": 391.469, "timestamp": "00:06:31", "text": "昨天凌晨3點過來的。我那時在"}, {"type": "subtitle", "time": 398.15, "timestamp": "00:06:38", "text": "嗯，阿曼，一如既往地"}, {"type": "subtitle", "time": 401.749, "timestamp": "00:06:41", "text": "感謝你的到來。鴻蓋帝國三兒子，"}, {"type": "subtitle", "time": 406.71, "timestamp": "00:06:46", "text": "感謝你在Twitch上的關注與光臨。  太感謝了。賈伯斯，謝謝你的"}, {"type": "subtitle", "time": 409.35, "timestamp": "00:06:49", "text": "光臨。謝謝光臨。希望"}, {"type": "subtitle", "time": 412.23, "timestamp": "00:06:52", "text": "你一切都好。是的，"}, {"type": "subtitle", "time": 413.99, "timestamp": "00:06:53", "text": "我們將"}, {"type": "subtitle", "time": 419.189, "timestamp": "00:06:59", "text": "在周日下午 12:30 與 Hijab Sistan 合作。"}]
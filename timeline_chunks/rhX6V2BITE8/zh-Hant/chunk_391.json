[{"type": "subtitle", "time": 23465.35, "timestamp": "06:31:05", "text": "爸爸的胸部。我有三個。這是什麼戰利品"}, {"type": "subtitle", "time": 23473.59, "timestamp": "06:31:13", "text": "籠？  [音樂] 哦，我有個小玩意兒。我弄到了個小"}, {"type": "subtitle", "time": 23476.31, "timestamp": "06:31:16", "text": "玩意兒。銀。不過我確實有收入。"}, {"type": "subtitle", "time": 23478.43, "timestamp": "06:31:18", "text": "這是什麼？獵人的胸前T卹。"}, {"type": "subtitle", "time": 23495.19, "timestamp": "06:31:35", "text": "我找到東西了。又是錢。  為什麼？"}, {"type": "subtitle", "time": 23503.91, "timestamp": "06:31:43", "text": "嗯？所以，要進行個人化訂製。我有這些裝備嗎"}, {"type": "subtitle", "time": 23516.708, "timestamp": "06:31:56", "text": "我搞不懂。"}, {"type": "subtitle", "time": 23519.15, "timestamp": "06:31:59", "text": "我拿不到我剛打開的東西。  為什麼？"}]
[{"type": "subtitle", "time": 16341.95, "timestamp": "04:32:21", "text": "我身上有很多錢。"}, {"type": "subtitle", "time": 16351.79, "timestamp": "04:32:31", "text": "我可以隨心所欲。別打電話。莉娜，你聽得到我說話嗎？"}, {"type": "subtitle", "time": 16374.87, "timestamp": "04:32:54", "text": "莉娜普蘭，你還好嗎？發生什麼事了？發生什麼事了？你告訴我。你在哪裡？哦，"}, {"type": "subtitle", "time": 16378.44, "timestamp": "04:32:58", "text": "我知道了。"}]
[{"type": "subtitle", "time": 13339.63, "timestamp": "03:42:19", "text": "哦，不。  哦。我的天啊。我走到了死胡同。"}, {"type": "subtitle", "time": 13346.83, "timestamp": "03:42:26", "text": "真正的"}, {"type": "subtitle", "time": 13349.75, "timestamp": "03:42:29", "text": "死胡同。我當初為什麼會決定接受這份工作？可能至少有這麼多。我的輪胎壞了。多基，你的武器。我"}, {"type": "subtitle", "time": 13374.349, "timestamp": "03:42:54", "text": "。哦，是的，我能"}, {"type": "subtitle", "time": 13376.269, "timestamp": "03:42:56", "text": "感覺到"}, {"type": "subtitle", "time": 13379.91, "timestamp": "03:42:59", "text": "輪胎。"}]
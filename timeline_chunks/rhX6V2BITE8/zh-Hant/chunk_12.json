[{"type": "subtitle", "time": 724.19, "timestamp": "00:12:04", "text": "我的追蹤正在進行中"}, {"type": "subtitle", "time": 726.87, "timestamp": "00:12:06", "text": "。好吧，你知道嗎？我"}, {"type": "subtitle", "time": 730.069, "timestamp": "00:12:10", "text": "今天要把我的V"}, {"type": "subtitle", "time": 741.829, "timestamp": "00:12:21", "text": "相關工作完成，我會上傳大約7個V視頻，把我的內容恢復正常。我好像卡在第68天或70天了。就是從那時我開始做合作專案。所以，"}, {"type": "subtitle", "time": 744.629, "timestamp": "00:12:24", "text": "我覺得"}, {"type": "subtitle", "time": 747.35, "timestamp": "00:12:27", "text": "我卡在和Mio的合作上了。我覺得我卡在"}, {"type": "subtitle", "time": 749.829, "timestamp": "00:12:29", "text": "這裡了，我還需要…我"}, {"type": "subtitle", "time": 751.99, "timestamp": "00:12:31", "text": "已經下載了 Mio Collab 的 VOD，但"}, {"type": "subtitle", "time": 776.87, "timestamp": "00:12:56", "text": "我還需要把它們上傳到 Billy Billy，對吧？所以，呃，到第 80 天，我正在努力"}]
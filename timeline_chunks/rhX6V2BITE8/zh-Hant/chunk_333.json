[{"type": "subtitle", "time": 19998.39, "timestamp": "05:33:18", "text": "有人。  哦，我"}, {"type": "subtitle", "time": 20006.788, "timestamp": "05:33:26", "text": "看到"}, {"type": "subtitle", "time": 20023.27, "timestamp": "05:33:43", "text": "（掌聲） 爆頭。"}, {"type": "subtitle", "time": 20031.27, "timestamp": "05:33:51", "text": "那一球。哦，等等。我忘了。我忘了。我忘了等。我得把它"}]
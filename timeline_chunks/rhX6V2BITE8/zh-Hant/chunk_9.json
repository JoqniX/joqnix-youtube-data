[{"type": "subtitle", "time": 542.55, "timestamp": "00:09:02", "text": "那些我真的"}, {"type": "subtitle", "time": 545.75, "timestamp": "00:09:05", "text": "很想重新聯繫、聊天、"}, {"type": "subtitle", "time": 547.55, "timestamp": "00:09:07", "text": "一起出去玩的人聯繫。是的"}, {"type": "subtitle", "time": 550.79, "timestamp": "00:09:10", "text": "。唉，我真希望"}, {"type": "subtitle", "time": 553.43, "timestamp": "00:09:13", "text": "我從四月就開始做這種馬拉松式的"}, {"type": "subtitle", "time": 556.949, "timestamp": "00:09:16", "text": "合作演講，但那樣做"}, {"type": "subtitle", "time": 559.829, "timestamp": "00:09:19", "text": "太蠢了。我沒想到自己會這麼"}, {"type": "subtitle", "time": 561.87, "timestamp": "00:09:21", "text": "固執，竟然要聯絡"}, {"type": "subtitle", "time": 569.03, "timestamp": "00:09:29", "text": "我"}, {"type": "subtitle", "time": 571.87, "timestamp": "00:09:31", "text": "在 Discord 和其他"}, {"type": "subtitle", "time": 576.91, "timestamp": "00:09:36", "text": "平台上 500 位好友中的 210 位。總共210個。  是的"}, {"type": "subtitle", "time": 581.19, "timestamp": "00:09:41", "text": "。脫離其中。很多人還沒"}, {"type": "subtitle", "time": 585.11, "timestamp": "00:09:45", "text": "回覆等等。大多數人都"}, {"type": "subtitle", "time": 587.71, "timestamp": "00:09:47", "text": "很忙。我在想，呃，"}, {"type": "subtitle", "time": 591.67, "timestamp": "00:09:51", "text": "如果有人看到這則訊息的話，"}, {"type": "subtitle", "time": 594.31, "timestamp": "00:09:54", "text": "我的消息是不是太晚了？當我"}, {"type": "subtitle", "time": 596.949, "timestamp": "00:09:56", "text": "時間緊迫的時候，比如到了"}, {"type": "subtitle", "time": 599.91, "timestamp": "00:09:59", "text": "六月的第三週，我甚至都沒"}]
[{"type": "subtitle", "time": 17232.708, "timestamp": "04:47:12", "text": "然後我們就可以結束今天的任務了。我想我應該走這邊。是的"}, {"type": "subtitle", "time": 17245.47, "timestamp": "04:47:25", "text": "，他很沮喪。好的。 [音樂]沒錯。好的。"}, {"type": "subtitle", "time": 17248.788, "timestamp": "04:47:28", "text": "你相信嗎？他們允許你添加硝基之類的東西。那是"}, {"type": "subtitle", "time": 17258.868, "timestamp": "04:47:38", "text": "天線。這是什麼？"}, {"type": "subtitle", "time": 17261.03, "timestamp": "04:47:41", "text": "現在發生了什麼事？什麼？就在腦袋裡。離我"}, {"type": "subtitle", "time": 17273.03, "timestamp": "04:47:53", "text": "遠點。你會給我錢作為幫助的報酬嗎？母親的忠實兒子會回報你的善意。嗨，我很酷。泰坦。那孩子升級了"}, {"type": "subtitle", "time": 17274.708, "timestamp": "04:47:54", "text": "。謝謝"}, {"type": "subtitle", "time": 17276.948, "timestamp": "04:47:56", "text": "你救了我，陌生人。我的天哪。我真的升級了[音樂]。垃圾測試現在才開始。"}]
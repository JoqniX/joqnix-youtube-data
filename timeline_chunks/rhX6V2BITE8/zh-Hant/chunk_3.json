[{"type": "subtitle", "time": 186.55, "timestamp": "00:03:06", "text": "我沒記錯的話，印度標準時間（IST）下午 4 點是第一場。呃，還有一場是在晚上9點。  IST。我必須確保我的合作者聯絡我，這樣我們今天才能進行直播，否則我就要考慮"}, {"type": "subtitle", "time": 189.07, "timestamp": "00:03:09", "text": "找個人應急了"}, {"type": "subtitle", "time": 193.11, "timestamp": "00:03:13", "text": "。呃，我不知道是誰，但我確實"}, {"type": "subtitle", "time": 195.91, "timestamp": "00:03:15", "text": "需要一個備用人選。所以，我們"}, {"type": "subtitle", "time": 200.27, "timestamp": "00:03:20", "text": "正式只剩下 3 週時間了，因為"}, {"type": "subtitle", "time": 203.99, "timestamp": "00:03:23", "text": "6 月 21 日是我留給"}, {"type": "subtitle", "time": 206.589, "timestamp": "00:03:26", "text": "自己合作或其他"}, {"type": "subtitle", "time": 209.03, "timestamp": "00:03:29", "text": "任何事情的最後一天，同時也是 Joathon 的最後一天"}, {"type": "subtitle", "time": 211.99, "timestamp": "00:03:31", "text": "。我記得是星期六，或"}, {"type": "subtitle", "time": 214.949, "timestamp": "00:03:34", "text": "像22號星期日或週日。我不知道自己還能活多久。是啊，但"}, {"type": "subtitle", "time": 221.949, "timestamp": "00:03:41", "text": "我感覺"}, {"type": "subtitle", "time": 227.19, "timestamp": "00:03:47", "text": "時間過得很快，真的飛快，"}, {"type": "subtitle", "time": 230.07, "timestamp": "00:03:50", "text": "我不知道為什麼會這樣，很"}, {"type": "subtitle", "time": 233.589, "timestamp": "00:03:53", "text": "痛苦，但我"}]
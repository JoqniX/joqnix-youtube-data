[{"type": "subtitle", "time": 2956.109, "timestamp": "00:49:16", "text": "。我相信我們已經安排好韓韓明天晚上"}, {"type": "subtitle", "time": 2960.71, "timestamp": "00:49:20", "text": "7:30到崗了"}, {"type": "subtitle", "time": 2964.39, "timestamp": "00:49:24", "text": "。事情完成了。帕利，我今天就能見到他。 Tommo Akumasa，今天是6月3日。所以明天我得私訊他"}, {"type": "subtitle", "time": 2966.829, "timestamp": "00:49:26", "text": "。  呃，我得"}, {"type": "subtitle", "time": 2973.829, "timestamp": "00:49:33", "text": "明天或後天私訊問他。驚人的。我得在六月中旬私訊他。那大概是"}, {"type": "subtitle", "time": 2976.069, "timestamp": "00:49:36", "text": "13、14、15 這幾個日期左右"}, {"type": "subtitle", "time": 2979.51, "timestamp": "00:49:39", "text": "。我稍後會私訊他。  培根.是為了培根。"}, {"type": "subtitle", "time": 2982.069, "timestamp": "00:49:42", "text": "我想我把他放在某個地方了"}, {"type": "subtitle", "time": 2985.03, "timestamp": "00:49:45", "text": "。"}]
[{"type": "subtitle", "time": 423.83, "timestamp": "00:07:03", "text": "IST。所以，是的，我當時想從"}, {"type": "subtitle", "time": 426.309, "timestamp": "00:07:06", "text": "A 到 Z 逐一查看我好友列表裡的每個人，結果"}, {"type": "subtitle", "time": 434.39, "timestamp": "00:07:14", "text": "我聯繫了"}, {"type": "subtitle", "time": 437.589, "timestamp": "00:07:17", "text": "更多的人，以至於我當時就想，哇，"}, {"type": "subtitle", "time": 439.589, "timestamp": "00:07:19", "text": "這太瘋狂了。"}, {"type": "subtitle", "time": 442.029, "timestamp": "00:07:22", "text": "這簡直太"}, {"type": "subtitle", "time": 444.43, "timestamp": "00:07:24", "text": "瘋狂了。"}, {"type": "subtitle", "time": 452.67, "timestamp": "00:07:32", "text": "嗯，是的，因為我會記得我珍惜的人，而不是一個會忘記粉紅色的人。"}, {"type": "subtitle", "time": 458.30899999999997, "timestamp": "00:07:38", "text": "總之，總之，我希望能夠"}, {"type": "subtitle", "time": 462.469, "timestamp": "00:07:42", "text": "完成一些工作。嗯，"}, {"type": "subtitle", "time": 465.83, "timestamp": "00:07:45", "text": "今天的任務清單是：寫兩篇"}, {"type": "subtitle", "time": 467.35, "timestamp": "00:07:47", "text": "總結，分別是"}, {"type": "subtitle", "time": 469.27, "timestamp": "00:07:49", "text": "昨天和前天的直播總結，還有推特上的總結。"}]
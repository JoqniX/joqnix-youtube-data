[{"type": "subtitle", "time": 11640.95, "timestamp": "03:14:00", "text": "Take some bread, my friend. Go back to"}, {"type": "subtitle", "time": 11644.99, "timestamp": "03:14:04", "text": "her. What? No, don't shoot me. I"}, {"type": "subtitle", "time": 11647.87, "timestamp": "03:14:07", "text": "bash."}, {"type": "subtitle", "time": 11651.59, "timestamp": "03:14:11", "text": "No. Come on."}, {"type": "subtitle", "time": 11654.429, "timestamp": "03:14:14", "text": "At least I'll scoop around checking for"}, {"type": "subtitle", "time": 11657.03, "timestamp": "03:14:17", "text": "stuff. And where is the bread you told"}, {"type": "subtitle", "time": 11658.67, "timestamp": "03:14:18", "text": "me"}, {"type": "subtitle", "time": 11665.349, "timestamp": "03:14:25", "text": "What? Where is that bread? Okay, we can"}, {"type": "subtitle", "time": 11668.63, "timestamp": "03:14:28", "text": "I guess. I think the lady will help us."}, {"type": "subtitle", "time": 11675.75, "timestamp": "03:14:35", "text": "Damn it. We're in a wasteland."}, {"type": "subtitle", "time": 11678.55, "timestamp": "03:14:38", "text": "Hey. Yeah, you come here. Oh, this is"}, {"type": "subtitle", "time": 11681.349, "timestamp": "03:14:41", "text": "going to help. Come closer. I won't bite"}, {"type": "subtitle", "time": 11683.75, "timestamp": "03:14:43", "text": "you. I think he sells goods or"}, {"type": "subtitle", "time": 11686.309, "timestamp": "03:14:46", "text": "something. Look at all those wooden"}, {"type": "subtitle", "time": 11689.429, "timestamp": "03:14:49", "text": "boxes or crates of stuff. So, you're not"}, {"type": "subtitle", "time": 11692.63, "timestamp": "03:14:52", "text": "one of them? I think he's the merchant"}, {"type": "subtitle", "time": 11694.71, "timestamp": "03:14:54", "text": "most likely. Cuz I sell more than"}, {"type": "subtitle", "time": 11697.429, "timestamp": "03:14:57", "text": "just bread. My name's Khan, by the way."}, {"type": "subtitle", "time": 11699.03, "timestamp": "03:14:59", "text": "Khan."}]
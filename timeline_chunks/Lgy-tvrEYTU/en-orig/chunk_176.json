[{"type": "subtitle", "time": 10560.55, "timestamp": "02:56:00", "text": "twitching?"}, {"type": "subtitle", "time": 10573.19, "timestamp": "02:56:13", "text": "A little universe."}, {"type": "subtitle", "time": 10575.59, "timestamp": "02:56:15", "text": "So Jack, I'm having a technical"}, {"type": "subtitle", "time": 10578.87, "timestamp": "02:56:18", "text": "difficulty on"}, {"type": "subtitle", "time": 10582.55, "timestamp": "02:56:22", "text": "uh since I'm multireaming right now. Um"}, {"type": "subtitle", "time": 10585.11, "timestamp": "02:56:25", "text": "so what do you think the issue will be"}, {"type": "subtitle", "time": 10587.51, "timestamp": "02:56:27", "text": "since I can't since my Twitch stream is"}, {"type": "subtitle", "time": 10589.269, "timestamp": "02:56:29", "text": "not"}, {"type": "subtitle", "time": 10591.59, "timestamp": "02:56:31", "text": "uh going live on Twitch, but I'm still"}, {"type": "subtitle", "time": 10594.63, "timestamp": "02:56:34", "text": "live on YouTube. Do you can you help me"}, {"type": "subtitle", "time": 10602.23, "timestamp": "02:56:42", "text": "Ah oho, this problem is a known issue."}, {"type": "subtitle", "time": 10604.309, "timestamp": "02:56:44", "text": "Yeah, sometimes even I have it and other"}, {"type": "subtitle", "time": 10606.15, "timestamp": "02:56:46", "text": "friends have it and it's when streaming"}, {"type": "subtitle", "time": 10608.79, "timestamp": "02:56:48", "text": "software or OBS suddenly can't stream to"}, {"type": "subtitle", "time": 10611.19, "timestamp": "02:56:51", "text": "Twitch and so Twitch will be offline but"}, {"type": "subtitle", "time": 10613.11, "timestamp": "02:56:53", "text": "YouTube will be online. In this case,"}, {"type": "subtitle", "time": 10615.59, "timestamp": "02:56:55", "text": "just restarting OBS will fix this issue"}, {"type": "subtitle", "time": 10619.83, "timestamp": "02:56:59", "text": "and you should be live to all platforms."}]
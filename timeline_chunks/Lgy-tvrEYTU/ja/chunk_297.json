[{"type": "subtitle", "time": 17821.59, "timestamp": "04:57:01", "text": "茶色のダークチョコレートのようなもの"}, {"type": "subtitle", "time": 17824.47, "timestamp": "04:57:04", "text": "ああ、これらのものすべて。ああ、それは違う。"}, {"type": "subtitle", "time": 17826.23, "timestamp": "04:57:06", "text": "ちなみに、それは健全な方です。"}, {"type": "subtitle", "time": 17828.39, "timestamp": "04:57:08", "text": "ご心配なく。実際のところ"}, {"type": "subtitle", "time": 17832.23, "timestamp": "04:57:12", "text": "乾燥した泥で作った泥だんご。"}, {"type": "subtitle", "time": 17836.07, "timestamp": "04:57:16", "text": "すべて粘土製。私は何を言っているんだ？乾いた泥。"}, {"type": "subtitle", "time": 17838.948, "timestamp": "04:57:18", "text": "それは子供向けの遊び、あるいはゲームです。"}, {"type": "subtitle", "time": 17841.35, "timestamp": "04:57:21", "text": "待って。おお。"}, {"type": "subtitle", "time": 17844.948, "timestamp": "04:57:24", "text": "ああ、これだ。なるほど。"}, {"type": "subtitle", "time": 17847.99, "timestamp": "04:57:27", "text": "今、グーグルで調べてみました。"}, {"type": "subtitle", "time": 17850.15, "timestamp": "04:57:30", "text": "私はまず健全な方を見た。私は"}, {"type": "subtitle", "time": 17853.11, "timestamp": "04:57:33", "text": "「あ、でも待って、これは暗い」"}, {"type": "subtitle", "time": 17856.55, "timestamp": "04:57:36", "text": "でもチョコレートは別だよ。"}, {"type": "subtitle", "time": 17859.11, "timestamp": "04:57:39", "text": "ダークチョコレート。なぜこうなるのかというと、ああ、待って。"}, {"type": "subtitle", "time": 17863.43, "timestamp": "04:57:43", "text": "ヴィックは、ああ、ヴィックはとても金持ちで"}, {"type": "subtitle", "time": 17866.23, "timestamp": "04:57:46", "text": "ドク・チョップは貧乏人のパイだったようなもの？"}, {"type": "subtitle", "time": 17868.708, "timestamp": "04:57:48", "text": "本当に大きい。あなたは見せびらかして"}, {"type": "subtitle", "time": 17870.948, "timestamp": "04:57:50", "text": "それからあなたは見て、それからあなたは2つに低くなりました"}, {"type": "subtitle", "time": 17873.75, "timestamp": "04:57:53", "text": "2番。おお、"}, {"type": "subtitle", "time": 17877.11, "timestamp": "04:57:57", "text": "貧困は告白する。"}, {"type": "subtitle", "time": 17879.83, "timestamp": "04:57:59", "text": "重ねてお詫び申し上げます。私が闇堕ちした。私は"}]
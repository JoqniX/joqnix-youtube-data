[{"type": "subtitle", "time": 4021.51, "timestamp": "01:07:01", "text": "これまで2、3回交換しました。えっと"}, {"type": "subtitle", "time": 4024.069, "timestamp": "01:07:04", "text": "壊れることを願っています"}, {"type": "subtitle", "time": 4026.71, "timestamp": "01:07:06", "text": "今年か来年。だから私は"}, {"type": "subtitle", "time": 4029.91, "timestamp": "01:07:09", "text": "怖がった。でも、もし下がったら、私は"}, {"type": "subtitle", "time": 4032.23, "timestamp": "01:07:12", "text": "これからどうすればいいのか分からない。それは"}, {"type": "subtitle", "time": 4034.87, "timestamp": "01:07:14", "text": "痛みである。"}, {"type": "subtitle", "time": 4038.549, "timestamp": "01:07:18", "text": "だから、私はこうしようかと考えていた"}, {"type": "subtitle", "time": 4043.27, "timestamp": "01:07:23", "text": "もしくは、究極のものを手に入れて幸せになりましょう。"}, {"type": "subtitle", "time": 4045.109, "timestamp": "01:07:25", "text": "つまり、私はそうしないようにしなければならない"}, {"type": "subtitle", "time": 4047.029, "timestamp": "01:07:27", "text": "何も破壊しない。必ず確認して希望する"}, {"type": "subtitle", "time": 4050.47, "timestamp": "01:07:30", "text": "マイクには何も起こらない。"}, {"type": "subtitle", "time": 4052.87, "timestamp": "01:07:32", "text": "わからない。マイクは重要です。それで"}, {"type": "subtitle", "time": 4054.95, "timestamp": "01:07:34", "text": "だから私はケチらないようにしている"}, {"type": "subtitle", "time": 4058.789, "timestamp": "01:07:38", "text": "貯金すること。"}, {"type": "subtitle", "time": 4060.309, "timestamp": "01:07:40", "text": "一度購入すれば、"}, {"type": "subtitle", "time": 4062.789, "timestamp": "01:07:42", "text": "2回購入する必要がある。ええ、でももし"}, {"type": "subtitle", "time": 4065.829, "timestamp": "01:07:45", "text": "何かが起こったり、そういうことが起こるんですよね？"}, {"type": "subtitle", "time": 4068.05, "timestamp": "01:07:48", "text": "それが苦痛だ。"}, {"type": "subtitle", "time": 4070.95, "timestamp": "01:07:50", "text": "[音楽]"}, {"type": "subtitle", "time": 4074.23, "timestamp": "01:07:54", "text": "なぜ私はメンブレンキーボードを使っているのか"}, {"type": "subtitle", "time": 4078.15, "timestamp": "01:07:58", "text": "機械式の車輪付きですか？これは何ですか"}]
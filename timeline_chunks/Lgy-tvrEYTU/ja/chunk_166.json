[{"type": "subtitle", "time": 9966.87, "timestamp": "02:46:06", "text": "メンバー限定の視聴配信を行います"}, {"type": "subtitle", "time": 9968.55, "timestamp": "02:46:08", "text": "私のメンバーたちと共に。私たちは"}, {"type": "subtitle", "time": 9970.309, "timestamp": "02:46:10", "text": "映画を観て、雰囲気を楽しんで、楽しもう"}, {"type": "subtitle", "time": 9971.91, "timestamp": "02:46:11", "text": "一緒に。"}, {"type": "subtitle", "time": 9975.11, "timestamp": "02:46:15", "text": "ああ、メンバーの皆さん。つまり、あなたは収益化されているということですね。"}, {"type": "subtitle", "time": 9978.389, "timestamp": "02:46:18", "text": "すでに？会員資格をお持ちです"}, {"type": "subtitle", "time": 9983.99, "timestamp": "02:46:23", "text": "はい。しばらく前から収益化されていて、"}, {"type": "subtitle", "time": 9986.15, "timestamp": "02:46:26", "text": "私も最初の会員権を受け取りました"}, {"type": "subtitle", "time": 9988.389, "timestamp": "02:46:28", "text": "数ヶ月前。"}, {"type": "subtitle", "time": 9990.469, "timestamp": "02:46:30", "text": "おお。おお、"}, {"type": "subtitle", "time": 9997.349, "timestamp": "02:46:37", "text": "じゃあ、さよならを言わなきゃいけないね、"}, {"type": "subtitle", "time": 9999.269, "timestamp": "02:46:39", "text": "配信準備、セットアップなどやらなきゃいけないことがある。"}, {"type": "subtitle", "time": 10011.59, "timestamp": "02:46:51", "text": "ああ、なんてことだ、日本語と書いてあった。何が"}]
[{"type": "subtitle", "time": 12182.469, "timestamp": "03:23:02", "text": "はぁ？それはどういう意味ですか？何が"}, {"type": "subtitle", "time": 12184.55, "timestamp": "03:23:04", "text": "ライブ配信してるってこと？私たちは"}, {"type": "subtitle", "time": 12190.95, "timestamp": "03:23:10", "text": "ええ、そうですね。ああ、そうだね、それは本当だ。"}, {"type": "subtitle", "time": 12193.269, "timestamp": "03:23:13", "text": "はぁ？"}, {"type": "subtitle", "time": 12195.19, "timestamp": "03:23:15", "text": "ええ、その通りです。そう、それは"}, {"type": "subtitle", "time": 12197.11, "timestamp": "03:23:17", "text": "それについて。ただそれを言いたかっただけです。"}, {"type": "subtitle", "time": 12201.349, "timestamp": "03:23:21", "text": "バイバイ。おやすみ。良い一日を。"}, {"type": "subtitle", "time": 12203.91, "timestamp": "03:23:23", "text": "永遠の眠りの中で、ゆっくり休んでください。"}, {"type": "subtitle", "time": 12206.55, "timestamp": "03:23:26", "text": "バイバイ。"}, {"type": "subtitle", "time": 12208.389, "timestamp": "03:23:28", "text": "ええ、あなたとは楽しい時間を過ごしましたよ。"}, {"type": "subtitle", "time": 12211.11, "timestamp": "03:23:31", "text": "今日。あなたも良い夜をお過ごしください。そして、"}, {"type": "subtitle", "time": 12228.229, "timestamp": "03:23:48", "text": "楽しいよ。楽しいよ。"}, {"type": "subtitle", "time": 12230.79, "timestamp": "03:23:50", "text": "でも、ええ、私も自分の意見を加えました。しかし"}, {"type": "subtitle", "time": 12233.67, "timestamp": "03:23:53", "text": "ええ、でもそれは私営なんです。えっと、でも私は"}, {"type": "subtitle", "time": 12235.99, "timestamp": "03:23:55", "text": "よくわからない。あなたならできると思います"}]
[{"type": "subtitle", "time": 13863.75, "timestamp": "03:51:03", "text": "座席も含む。そして私は、えーと、"}, {"type": "subtitle", "time": 13866.07, "timestamp": "03:51:06", "text": "気づきませんでした。何？そして"}, {"type": "subtitle", "time": 13868.469, "timestamp": "03:51:08", "text": "心配しないで、場所があるよ"}, {"type": "subtitle", "time": 13870.71, "timestamp": "03:51:10", "text": "そこに座って"}, {"type": "subtitle", "time": 13874.55, "timestamp": "03:51:14", "text": "ああ、ありがとう。それから私の後輩も"}, {"type": "subtitle", "time": 13877.59, "timestamp": "03:51:17", "text": "出てきて、おい、兄弟、君は"}, {"type": "subtitle", "time": 13879.75, "timestamp": "03:51:19", "text": "どこを見るか、好きな場所を探す必要があります"}, {"type": "subtitle", "time": 13882.79, "timestamp": "03:51:22", "text": "いいえ、私は携帯電話を使っていたのですが"}, {"type": "subtitle", "time": 13884.87, "timestamp": "03:51:24", "text": "わかってるけど、お願いだから"}, {"type": "subtitle", "time": 13886.71, "timestamp": "03:51:26", "text": "ここは清潔ではないので注意してください。"}, {"type": "subtitle", "time": 13891.59, "timestamp": "03:51:31", "text": "「ああ、わかったよ、わかったよ」って感じだった。"}, {"type": "subtitle", "time": 13893.75, "timestamp": "03:51:33", "text": "ちなみに、私の後輩たちはとても可愛らしいですよ。"}, {"type": "subtitle", "time": 13895.349, "timestamp": "03:51:35", "text": "中には「わからない」という人もいる"}, {"type": "subtitle", "time": 13897.189, "timestamp": "03:51:37", "text": "誰が気にする。しかし、それらのほとんどは非常に"}, {"type": "subtitle", "time": 13901.429, "timestamp": "03:51:41", "text": "素敵な。うん。うん。彼らが"}, {"type": "subtitle", "time": 13904.87, "timestamp": "03:51:44", "text": "えっと、抱きしめたいけど、もし"}, {"type": "subtitle", "time": 13907.83, "timestamp": "03:51:47", "text": "気にしない人"}, {"type": "subtitle", "time": 13911.59, "timestamp": "03:51:51", "text": "彼らは、彼に自分のものを台無しにさせようと思うだろう"}, {"type": "subtitle", "time": 13915.67, "timestamp": "03:51:55", "text": "服は外の服のように、座るのが好きです"}, {"type": "subtitle", "time": 13919.67, "timestamp": "03:51:59", "text": "あの顔。でも、彼らは親切で"}]
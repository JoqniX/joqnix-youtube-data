[{"type": "subtitle", "time": 13381.19, "timestamp": "03:43:01", "text": "それで私は上司を見て、何て言ったんだろうと思った。"}, {"type": "subtitle", "time": 13382.79, "timestamp": "03:43:02", "text": "私は何をすべきですか？そして私はこう思った。"}, {"type": "subtitle", "time": 13384.79, "timestamp": "03:43:04", "text": "いや、彼を放っておくよ。大丈夫です。"}, {"type": "subtitle", "time": 13386.469, "timestamp": "03:43:06", "text": "毎回こうなるんだ。しないで"}, {"type": "subtitle", "time": 13388.95, "timestamp": "03:43:08", "text": "それについて心配してください。私の上司は"}, {"type": "subtitle", "time": 13393.59, "timestamp": "03:43:13", "text": "チル。えっと、私の部署の責任者は"}, {"type": "subtitle", "time": 13396.309, "timestamp": "03:43:16", "text": "チル。私の部署の責任者、HOD、私は"}, {"type": "subtitle", "time": 13398.55, "timestamp": "03:43:18", "text": "すみません、何を言っているんでしょう？ HDはかなり"}, {"type": "subtitle", "time": 13401.349, "timestamp": "03:43:21", "text": "チル。上司が彼に腹を立てた"}, {"type": "subtitle", "time": 13403.51, "timestamp": "03:43:23", "text": "なぜなら彼はとても気が進まなかったから"}, {"type": "subtitle", "time": 13406.71, "timestamp": "03:43:26", "text": "彼の歯はきれいだ。好きな人もいるし、"}, {"type": "subtitle", "time": 13409.11, "timestamp": "03:43:29", "text": "彼はものすごく怒った。私は今まで"}, {"type": "subtitle", "time": 13412.229, "timestamp": "03:43:32", "text": "彼がこんなに怒っているのを見たのは初めてだ。えっと、彼は行くのかな"}, {"type": "subtitle", "time": 13414.15, "timestamp": "03:43:34", "text": "彼は拳で殴りつけるつもりなのか"}, {"type": "subtitle", "time": 13421.349, "timestamp": "03:43:41", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 13423.269, "timestamp": "03:43:43", "text": "彼は殴り合いをするつもりなのか？彼は行くのか"}, {"type": "subtitle", "time": 13425.91, "timestamp": "03:43:45", "text": "彼は彼は与えるつもりですか 彼は与えるつもりですか"}, {"type": "subtitle", "time": 13428.63, "timestamp": "03:43:48", "text": "彼の顔面に大きな壁が立ちはだかる？何ですか"}, {"type": "subtitle", "time": 13434.63, "timestamp": "03:43:54", "text": "彼はとても怒った。彼は実際に育てた"}, {"type": "subtitle", "time": 13436.87, "timestamp": "03:43:56", "text": "彼の声。 「ああ、何だこれは」"}, {"type": "subtitle", "time": 13438.07, "timestamp": "03:43:58", "text": "ハプニング？何が起こっていますか？これは"}, {"type": "subtitle", "time": 13439.99, "timestamp": "03:43:59", "text": "エスカレートしている。これは良くない。そうではありません"}]
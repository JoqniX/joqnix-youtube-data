[{"type": "subtitle", "time": 3600.71, "timestamp": "01:00:00", "text": "ああ、60％"}, {"type": "subtitle", "time": 3605.42, "timestamp": "01:00:05", "text": "キーボードゲーム。それは何か意味がありますか？"}, {"type": "subtitle", "time": 3609.19, "timestamp": "01:00:09", "text": "[音楽]"}, {"type": "subtitle", "time": 3616.41, "timestamp": "01:00:16", "text": "私は自分が頭が良いと思っていた。"}, {"type": "subtitle", "time": 3621.69, "timestamp": "01:00:21", "text": "えっと、"}, {"type": "subtitle", "time": 3624.309, "timestamp": "01:00:24", "text": "[音楽]"}, {"type": "subtitle", "time": 3627.67, "timestamp": "01:00:27", "text": "いいえ。えっと、もし私が返品を発行したら、"}, {"type": "subtitle", "time": 3631.91, "timestamp": "01:00:31", "text": "右？もし私が返品を発行したら。"}, {"type": "subtitle", "time": 3634.549, "timestamp": "01:00:34", "text": "いや、いや。代替品を発行する場合、"}, {"type": "subtitle", "time": 3637.19, "timestamp": "01:00:37", "text": "それでも、それは重要ですよね？セブン"}, {"type": "subtitle", "time": 3638.8, "timestamp": "01:00:38", "text": "日ですよね？"}, {"type": "subtitle", "time": 3640.23, "timestamp": "01:00:40", "text": "[音楽]"}, {"type": "subtitle", "time": 3642.549, "timestamp": "01:00:42", "text": "これが問題なんです。待って、それは低い"}, {"type": "subtitle", "time": 3646.71, "timestamp": "01:00:46", "text": "価格が9.99ドルに値下げされました。何"}, {"type": "subtitle", "time": 3650.71, "timestamp": "01:00:50", "text": "わあ、値段が下がった。文字通り、"}, {"type": "subtitle", "time": 3654.309, "timestamp": "01:00:54", "text": "価格が下がった。"}, {"type": "subtitle", "time": 3656.71, "timestamp": "01:00:56", "text": "おお。"}]
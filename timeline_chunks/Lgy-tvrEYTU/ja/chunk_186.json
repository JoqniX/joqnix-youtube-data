[{"type": "subtitle", "time": 11162.95, "timestamp": "03:06:02", "text": "もっと私に。タブン。タブン。最も可能性が高い。"}, {"type": "subtitle", "time": 11175.429, "timestamp": "03:06:15", "text": "H. どちらに転ぶかは分からない。"}, {"type": "subtitle", "time": 11177.59, "timestamp": "03:06:17", "text": "どちらにも転ぶ可能性があるとはどういう意味ですか？"}, {"type": "subtitle", "time": 11191.19, "timestamp": "03:06:31", "text": "言いたいことはなんとなくわかるけど、どうしてそう思うの？"}, {"type": "subtitle", "time": 11196.55, "timestamp": "03:06:36", "text": "おお。わかった。わかった。えっと、完全に"}, {"type": "subtitle", "time": 11200.389, "timestamp": "03:06:40", "text": "会話を切り替えて"}, {"type": "subtitle", "time": 11207.03, "timestamp": "03:06:47", "text": "再起動する必要があると思う。"}, {"type": "subtitle", "time": 11211.67, "timestamp": "03:06:51", "text": "えっと、私たちの"}, {"type": "subtitle", "time": 11213.75, "timestamp": "03:06:53", "text": "会話"}]
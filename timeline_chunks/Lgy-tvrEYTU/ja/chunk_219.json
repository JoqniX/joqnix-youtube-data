[{"type": "subtitle", "time": 13140.389, "timestamp": "03:39:00", "text": "自分の肉を食べれば、おそらく"}, {"type": "subtitle", "time": 13142.79, "timestamp": "03:39:02", "text": "死ぬ。だから、これは絶対に家で真似しないでください。"}, {"type": "subtitle", "time": 13146.07, "timestamp": "03:39:06", "text": "「えーっと、ジャック、私は」なんて言わないで。"}, {"type": "subtitle", "time": 13148.79, "timestamp": "03:39:08", "text": "うっかり指を"}, {"type": "subtitle", "time": 13150.71, "timestamp": "03:39:10", "text": "どういうわけか口から。私はしません"}, {"type": "subtitle", "time": 13154.55, "timestamp": "03:39:14", "text": "知る。えっと、それに、私は自分の味がおいしいと思うんです。"}, {"type": "subtitle", "time": 13156.15, "timestamp": "03:39:16", "text": "「ジャック、どう思う？」私はこう思った。"}, {"type": "subtitle", "time": 13159.429, "timestamp": "03:39:19", "text": "「えっと、でも"}, {"type": "subtitle", "time": 13162.95, "timestamp": "03:39:22", "text": "えっと、あなたは行くべきです、あなたは行くべきです"}, {"type": "subtitle", "time": 13166.15, "timestamp": "03:39:26", "text": "指で消毒してください。"}, {"type": "subtitle", "time": 13170.309, "timestamp": "03:39:30", "text": "まあ、そうですね、大丈夫です。"}, {"type": "subtitle", "time": 13182.71, "timestamp": "03:39:42", "text": "えっと、君が何を考えているか想像しているんだけど"}, {"type": "subtitle", "time": 13191.269, "timestamp": "03:39:51", "text": "ああ、あなたも実際に"}, {"type": "subtitle", "time": 13194.469, "timestamp": "03:39:54", "text": "想像するものはただ"}, {"type": "subtitle", "time": 13196.71, "timestamp": "03:39:56", "text": "それを思い浮かべるには、次のように想像する必要があります"}, {"type": "subtitle", "time": 13199.11, "timestamp": "03:39:59", "text": "脳内でそれを具現化して"}]
[{"type": "subtitle", "time": 17340.39, "timestamp": "04:49:00", "text": "バージョンとタミル語版がチャットで"}, {"type": "subtitle", "time": 17342.31, "timestamp": "04:49:02", "text": "それから。"}, {"type": "subtitle", "time": 17343.99, "timestamp": "04:49:03", "text": "わかった。彼はただ興奮しているだけです"}, {"type": "subtitle", "time": 17347.67, "timestamp": "04:49:07", "text": "人々。ごめんなさい。こんにちは、おかえりなさい。"}, {"type": "subtitle", "time": 17349.75, "timestamp": "04:49:09", "text": "ごめんなさい。どうぞ。どうぞ、続けてください。"}, {"type": "subtitle", "time": 17352.47, "timestamp": "04:49:12", "text": "こんにちは。それで、私は、"}, {"type": "subtitle", "time": 17354.788, "timestamp": "04:49:14", "text": "言語関連。私たちは、えっと、読書をしていました"}, {"type": "subtitle", "time": 17358.23, "timestamp": "04:49:18", "text": "チャットからだけどね。えっと、DJC、ほらね"}, {"type": "subtitle", "time": 17363.67, "timestamp": "04:49:23", "text": "DJC um Victor son。彼も出身です"}, {"type": "subtitle", "time": 17367.75, "timestamp": "04:49:27", "text": "DDSG クーネン。ええ、わかっています。はい。"}, {"type": "subtitle", "time": 17371.67, "timestamp": "04:49:31", "text": "えっと、彼もタミル・ナードゥ州出身なんです。"}, {"type": "subtitle", "time": 17374.628, "timestamp": "04:49:34", "text": "知っている。彼は一度私にそう言ったと思う。ああ、そうだね。"}, {"type": "subtitle", "time": 17377.51, "timestamp": "04:49:37", "text": "彼は実際に好きだった"}, {"type": "subtitle", "time": 17379.75, "timestamp": "04:49:39", "text": "タミル語を話す人ばかりのグループに加わった"}, {"type": "subtitle", "time": 17381.91, "timestamp": "04:49:41", "text": "Btubers。"}, {"type": "subtitle", "time": 17383.59, "timestamp": "04:49:43", "text": "うん。"}, {"type": "subtitle", "time": 17385.03, "timestamp": "04:49:45", "text": "[音楽]"}, {"type": "subtitle", "time": 17388.31, "timestamp": "04:49:48", "text": "ええと、彼は俳優ではありませんが、それでも彼は"}, {"type": "subtitle", "time": 17389.91, "timestamp": "04:49:49", "text": "実際にその時私に加わってくれた人。それで"}, {"type": "subtitle", "time": 17394.628, "timestamp": "04:49:54", "text": "私もそれについてとても嬉しいです。"}, {"type": "subtitle", "time": 17398.708, "timestamp": "04:49:58", "text": "要は、私は彼の胃腸の状態をよく知っているということだ。"}]
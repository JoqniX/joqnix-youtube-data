[{"type": "subtitle", "time": 13742.71, "timestamp": "03:49:02", "text": "魔法を研究すれば"}, {"type": "subtitle", "time": 13746.14, "timestamp": "03:49:06", "text": "去って、そう"}, {"type": "subtitle", "time": 13747.59, "timestamp": "03:49:07", "text": "[音楽]"}, {"type": "subtitle", "time": 13750.63, "timestamp": "03:49:10", "text": "だから、やはり情熱が大切なのです"}, {"type": "subtitle", "time": 13752.55, "timestamp": "03:49:12", "text": "これに参加するには、ただ好きになるだけではダメです"}, {"type": "subtitle", "time": 13754.55, "timestamp": "03:49:14", "text": "映画を見て、この場所に来てください"}, {"type": "subtitle", "time": 13758.79, "timestamp": "03:49:18", "text": "とても高価で、"}, {"type": "subtitle", "time": 13761.59, "timestamp": "03:49:21", "text": "疲れるみたい、高価だし"}, {"type": "subtitle", "time": 13763.59, "timestamp": "03:49:23", "text": "疲れるので、たくさんの情熱が必要です"}, {"type": "subtitle", "time": 13777.59, "timestamp": "03:49:37", "text": "医者のように医者の中で"}, {"type": "subtitle", "time": 13780.15, "timestamp": "03:49:40", "text": "コミュニティには、次のような統計があります"}, {"type": "subtitle", "time": 13783.67, "timestamp": "03:49:43", "text": "多くの中退者は、ほとんどの人が"}, {"type": "subtitle", "time": 13785.269, "timestamp": "03:49:45", "text": "歯科医"}, {"type": "subtitle", "time": 13788.309, "timestamp": "03:49:48", "text": "それらのほとんどは、ええと、悪いし"}, {"type": "subtitle", "time": 13791.03, "timestamp": "03:49:51", "text": "彼らはとても悲しくなります、とても良い、とても好きです"}, {"type": "subtitle", "time": 13792.79, "timestamp": "03:49:52", "text": "よくあることだ。"}, {"type": "subtitle", "time": 13795.11, "timestamp": "03:49:55", "text": "えっと"}, {"type": "subtitle", "time": 13797.75, "timestamp": "03:49:57", "text": "そう、それに関する統計データがあって"}, {"type": "subtitle", "time": 13799.269, "timestamp": "03:49:59", "text": "初めてそれを見たとき、"}]
[{"type": "subtitle", "time": 18241.99, "timestamp": "05:04:01", "text": "彼の髪やその他すべてがとても"}, {"type": "subtitle", "time": 18244.39, "timestamp": "05:04:04", "text": "スムーズ。"}, {"type": "subtitle", "time": 18248.628, "timestamp": "05:04:08", "text": "ああ、そうだ、彼は、ああ、"}, {"type": "subtitle", "time": 18252.39, "timestamp": "05:04:12", "text": "やったー、ベイビー。それは私たち全員が望んでいることです"}, {"type": "subtitle", "time": 18254.31, "timestamp": "05:04:14", "text": "あれがその人ですよね？そいつだ、"}, {"type": "subtitle", "time": 18256.55, "timestamp": "05:04:16", "text": "右？はい。"}, {"type": "subtitle", "time": 18260.07, "timestamp": "05:04:20", "text": "彼のそういうところが湿っているのは知ってるよ。私"}, {"type": "subtitle", "time": 18262.55, "timestamp": "05:04:22", "text": "水分計みたいなものを見てください。それで"}, {"type": "subtitle", "time": 18264.788, "timestamp": "05:04:24", "text": "新しいゲームがあるたびに"}, {"type": "subtitle", "time": 18267.67, "timestamp": "05:04:27", "text": "出てくると、彼は最も多くのメートルまたは"}, {"type": "subtitle", "time": 18271.35, "timestamp": "05:04:31", "text": "すごく人気のある映画とか、そういうもの。うん、"}, {"type": "subtitle", "time": 18280.788, "timestamp": "05:04:40", "text": "こんにちは、ブルーキャット。うん。こんにちは。"}, {"type": "subtitle", "time": 18283.59, "timestamp": "05:04:43", "text": "いらっしゃいませ。いらっしゃいませ。"}, {"type": "subtitle", "time": 18288.15, "timestamp": "05:04:48", "text": "ニース。こんにちは、猫ちゃん。ちょっと待って、調子はどう？"}, {"type": "subtitle", "time": 18290.788, "timestamp": "05:04:50", "text": "その会社の社員は何人かいます。とにかく、"}, {"type": "subtitle", "time": 18295.19, "timestamp": "05:04:55", "text": "テクノロジー企業です。ああ、それは"}, {"type": "subtitle", "time": 18297.99, "timestamp": "05:04:57", "text": "テクノロジー企業？わからない。私はそれを見た"}]
[{"type": "subtitle", "time": 4802.47, "timestamp": "01:20:02", "text": "今？これは不具合です。私も行くよ"}, {"type": "subtitle", "time": 4804.39, "timestamp": "01:20:04", "text": "多くの。"}, {"type": "subtitle", "time": 4806.709, "timestamp": "01:20:06", "text": "残り5キル。理解できない"}, {"type": "subtitle", "time": 4810.149, "timestamp": "01:20:10", "text": "一体何が起こっているんだ。"}, {"type": "subtitle", "time": 4812.39, "timestamp": "01:20:12", "text": "射撃をやめろ。"}, {"type": "subtitle", "time": 4815.51, "timestamp": "01:20:15", "text": "私に仕事をさせてください。"}, {"type": "subtitle", "time": 4830.709, "timestamp": "01:20:30", "text": "茶色。茶色。茶色。の"}, {"type": "subtitle", "time": 4834.229, "timestamp": "01:20:34", "text": "茶色。このこと。これだよ。私"}, {"type": "subtitle", "time": 4837.11, "timestamp": "01:20:37", "text": "真ん中になければならない。残り1分。"}, {"type": "subtitle", "time": 4841.03, "timestamp": "01:20:41", "text": "それから、別のタイプライターのキーボード。"}]
[{"type": "subtitle", "time": 6978.07, "timestamp": "01:56:18", "text": "キーボードがちょうどこうなったのが気に入った"}, {"type": "subtitle", "time": 6982.39, "timestamp": "01:56:22", "text": "真っ直ぐ。今は動いていない。"}, {"type": "subtitle", "time": 6984.629, "timestamp": "01:56:24", "text": "取り出された。"}, {"type": "subtitle", "time": 6987.51, "timestamp": "01:56:27", "text": "サッチェルバッグを外す。"}, {"type": "subtitle", "time": 6999.91, "timestamp": "01:56:39", "text": "このバカな少年。"}, {"type": "subtitle", "time": 7003.03, "timestamp": "01:56:43", "text": "ヘッド・ショット。私はここから出て行く。 16キル"}, {"type": "subtitle", "time": 7015.669, "timestamp": "01:56:55", "text": "ああ、どうして今は動かなくなっているんだろう？何ですか"}]
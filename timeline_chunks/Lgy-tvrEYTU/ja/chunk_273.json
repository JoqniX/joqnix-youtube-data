[{"type": "subtitle", "time": 16382.07, "timestamp": "04:33:02", "text": "自分にチョコレートをあげてもいいかな"}, {"type": "subtitle", "time": 16384.39, "timestamp": "04:33:04", "text": "かわいい。"}, {"type": "subtitle", "time": 16400.47, "timestamp": "04:33:20", "text": "それでは、チャットで質問をしてみましょう。チャット。それで"}, {"type": "subtitle", "time": 16402.869, "timestamp": "04:33:22", "text": "ペットを飼っていますか？"}, {"type": "subtitle", "time": 16406.39, "timestamp": "04:33:26", "text": "自宅で？皆さんはペットを飼っていますか？知っている"}, {"type": "subtitle", "time": 16410.551, "timestamp": "04:33:30", "text": "ヒカリはペットを飼っている。高齢者についてはどうでしょうか"}, {"type": "subtitle", "time": 16412.551, "timestamp": "04:33:32", "text": "また？うん。こんにちは。ようこそ、パパ。"}, {"type": "subtitle", "time": 16416.709, "timestamp": "04:33:36", "text": "チル。待って、待って、待って。私はいつも"}, {"type": "subtitle", "time": 16418.551, "timestamp": "04:33:38", "text": "えっと、あなたの名前の発音が間違っていますよ。行くよ"}, {"type": "subtitle", "time": 16421.91, "timestamp": "04:33:41", "text": "戻る。また戻ってきます。"}, {"type": "subtitle", "time": 16424.31, "timestamp": "04:33:44", "text": "大丈夫。こんにちは。"}, {"type": "subtitle", "time": 16426.551, "timestamp": "04:33:46", "text": "ごめんなさい。私は出たり入ったりしているような感じです。"}, {"type": "subtitle", "time": 16428.551, "timestamp": "04:33:48", "text": "ごめんなさい。わかった。私はここにいるべきなんです"}, {"type": "subtitle", "time": 16431.269, "timestamp": "04:33:51", "text": "いつも。知っている。でも、家事、"}, {"type": "subtitle", "time": 16434.39, "timestamp": "04:33:54", "text": "インド人であること、そして"}, {"type": "subtitle", "time": 16436.789, "timestamp": "04:33:56", "text": "あなたの両親は簡単ではなく、"}]
[{"type": "subtitle", "time": 11343.349, "timestamp": "03:09:03", "text": "ああ、そうなんですか？なぜ？"}, {"type": "subtitle", "time": 11346.469, "timestamp": "03:09:06", "text": "はい。ここ。"}, {"type": "subtitle", "time": 11355.67, "timestamp": "03:09:15", "text": "ああ、つまりあなたは理解力があって、"}, {"type": "subtitle", "time": 11359.03, "timestamp": "03:09:19", "text": "とても穏やかな口調で話してくれた。"}, {"type": "subtitle", "time": 11361.51, "timestamp": "03:09:21", "text": "あなたは私に怒ってほしいの？"}, {"type": "subtitle", "time": 11364.79, "timestamp": "03:09:24", "text": "あなたに対して攻撃的ですか？あなたは"}, {"type": "subtitle", "time": 11369.59, "timestamp": "03:09:29", "text": "ああ、いや、いや、いや。私は持っていません"}, {"type": "subtitle", "time": 11373.51, "timestamp": "03:09:33", "text": "マゾヒズム的傾向。ハハ。"}, {"type": "subtitle", "time": 11377.11, "timestamp": "03:09:37", "text": "ああ、なるほど。わかった。"}, {"type": "subtitle", "time": 11380.55, "timestamp": "03:09:40", "text": "私はそういうのは好きじゃない。いいえ。いいえ。"}, {"type": "subtitle", "time": 11382.71, "timestamp": "03:09:42", "text": "うん。うん。私も。心配しないで。の"}, {"type": "subtitle", "time": 11386.55, "timestamp": "03:09:46", "text": "同じ。ただ、いや、えっと、それは"}, {"type": "subtitle", "time": 11389.99, "timestamp": "03:09:49", "text": "友達の何人かが私に"}]
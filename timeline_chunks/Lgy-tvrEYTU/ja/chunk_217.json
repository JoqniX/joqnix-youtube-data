[{"type": "subtitle", "time": 13022.229, "timestamp": "03:37:02", "text": "この中で物事を行う。だから、私は行かないよ"}, {"type": "subtitle", "time": 13024.05, "timestamp": "03:37:04", "text": "リスクを冒す。"}, {"type": "subtitle", "time": 13026.55, "timestamp": "03:37:06", "text": "[音楽]"}, {"type": "subtitle", "time": 13029.349, "timestamp": "03:37:09", "text": "それで、皆さん、今日はどんな一日でしたか？のように"}, {"type": "subtitle", "time": 13037.429, "timestamp": "03:37:17", "text": "それで、その質問をアキに聞いてみたんです。それで"}, {"type": "subtitle", "time": 13042.55, "timestamp": "03:37:22", "text": "彼は精一杯生きている。"}, {"type": "subtitle", "time": 13047.11, "timestamp": "03:37:27", "text": "おお、いいね。生きようと努力しなさい。ええ、そうですね。うん。そして"}, {"type": "subtitle", "time": 13049.83, "timestamp": "03:37:29", "text": "Quaxan は、何を尋ねるようなものですか?"}, {"type": "subtitle", "time": 13053.03, "timestamp": "03:37:33", "text": "これは一体何ですか？アヒルにとって悪いことですか？"}, {"type": "subtitle", "time": 13057.59, "timestamp": "03:37:37", "text": "アヒルを食べる？でも、それは？"}, {"type": "subtitle", "time": 13060.07, "timestamp": "03:37:40", "text": "ああ、それは人食いと呼ばれるものだ。その"}, {"type": "subtitle", "time": 13061.59, "timestamp": "03:37:41", "text": "大丈夫。"}, {"type": "subtitle", "time": 13063.349, "timestamp": "03:37:43", "text": "アヒルは消化できないと思う"}, {"type": "subtitle", "time": 13065.269, "timestamp": "03:37:45", "text": "彼ら自身。でも、そうだね、君"}, {"type": "subtitle", "time": 13066.95, "timestamp": "03:37:46", "text": "何が起こるかわからない。なかったと思います"}, {"type": "subtitle", "time": 13069.269, "timestamp": "03:37:49", "text": "人々がアヒルに食べさせた実験"}, {"type": "subtitle", "time": 13071.75, "timestamp": "03:37:51", "text": "互いに見つめ合い、アヒルが死んでいくのを目にする。あなた"}, {"type": "subtitle", "time": 13074.07, "timestamp": "03:37:54", "text": "何が起こるかわからないからね。"}, {"type": "subtitle", "time": 13077.11, "timestamp": "03:37:57", "text": "もしかしたらそうかもしれない。いや、そうかもしれない"}, {"type": "subtitle", "time": 13079.59, "timestamp": "03:37:59", "text": "誰も知らない人食いモンスター"}]
[{"type": "subtitle", "time": 16143.269, "timestamp": "04:29:03", "text": "私の犬が堂々と誇らしげに立っている"}, {"type": "subtitle", "time": 16145.67, "timestamp": "04:29:05", "text": "そして彼は初のオリンピック金メダルを獲得する"}, {"type": "subtitle", "time": 16149.83, "timestamp": "04:29:09", "text": "おしっこにメダル。"}, {"type": "subtitle", "time": 16152.55, "timestamp": "04:29:12", "text": "それは素晴らしい。知っている。"}, {"type": "subtitle", "time": 16155.269, "timestamp": "04:29:15", "text": "彼は愛らしい。わからない。彼はまるで"}, {"type": "subtitle", "time": 16157.03, "timestamp": "04:29:17", "text": "ハードコアすぎる"}, {"type": "subtitle", "time": 16160.07, "timestamp": "04:29:20", "text": "ルールを守ることなど。"}, {"type": "subtitle", "time": 16161.67, "timestamp": "04:29:21", "text": "彼は今では物事を伝えるのがとても上手だ"}, {"type": "subtitle", "time": 16163.51, "timestamp": "04:29:23", "text": "私と一緒に。ということで、まあ、私たちは"}, {"type": "subtitle", "time": 16165.91, "timestamp": "04:29:25", "text": "互換性がある。ああ、なるほど。あなたはしたい"}, {"type": "subtitle", "time": 16168.309, "timestamp": "04:29:28", "text": "うんちしたいの？ウォーキー、うんちしに行こう、"}, {"type": "subtitle", "time": 16173.11, "timestamp": "04:29:33", "text": "あなたが知っている。うん。散歩に行こう"}, {"type": "subtitle", "time": 16181.59, "timestamp": "04:29:41", "text": "うん。彼は最近ちょっと体調が悪いんです。のように"}, {"type": "subtitle", "time": 16183.99, "timestamp": "04:29:43", "text": "画面外で言ったと思うけど、私の犬"}, {"type": "subtitle", "time": 16187.75, "timestamp": "04:29:47", "text": "肌の状態が良くない。うん。"}, {"type": "subtitle", "time": 16190.63, "timestamp": "04:29:50", "text": "うん。彼はそれで大変苦しまなければならなかった"}, {"type": "subtitle", "time": 16192.87, "timestamp": "04:29:52", "text": "彼も寒さが嫌いだから"}, {"type": "subtitle", "time": 16195.67, "timestamp": "04:29:55", "text": "これもまた寒い季節です。それで"}, {"type": "subtitle", "time": 16197.59, "timestamp": "04:29:57", "text": "知らないけど、彼は好きじゃない"}]
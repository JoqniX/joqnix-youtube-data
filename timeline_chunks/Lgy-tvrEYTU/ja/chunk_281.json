[{"type": "subtitle", "time": 16861.43, "timestamp": "04:41:01", "text": "君がまるで2人みたいにプレイするなんて信じられないよ"}, {"type": "subtitle", "time": 16865.35, "timestamp": "04:41:05", "text": "アカウント"}, {"type": "subtitle", "time": 16867.27, "timestamp": "04:41:07", "text": "それは何と呼ぶのですか、私のメインアカウントです"}, {"type": "subtitle", "time": 16869.27, "timestamp": "04:41:09", "text": "アカウントだから、かわいそうに、うん、君"}, {"type": "subtitle", "time": 16872.23, "timestamp": "04:41:12", "text": "すべてやり直してすべて集める"}, {"type": "subtitle", "time": 16876.788, "timestamp": "04:41:16", "text": "ジオックすべてオキュラス私は決して"}, {"type": "subtitle", "time": 16879.11, "timestamp": "04:41:19", "text": "そういうのに悩まされると思う"}, {"type": "subtitle", "time": 16882.628, "timestamp": "04:41:22", "text": "私が気にしている唯一の人"}, {"type": "subtitle", "time": 16884.708, "timestamp": "04:41:24", "text": "それと一緒に、あなたは私があなただったように"}, {"type": "subtitle", "time": 16887.75, "timestamp": "04:41:27", "text": "私が「なぜあなたは"}, {"type": "subtitle", "time": 16890.07, "timestamp": "04:41:30", "text": "2つ目のアカウントを作るのにすごく苦労した"}, {"type": "subtitle", "time": 16891.51, "timestamp": "04:41:31", "text": "わからないけど、彼らを崇拝しないといけない"}, {"type": "subtitle", "time": 16893.43, "timestamp": "04:41:33", "text": "みんな、わかった、それは君の願いだけど、"}, {"type": "subtitle", "time": 16896.31, "timestamp": "04:41:36", "text": "必要ないよ、待って、全部必要だよ"}, {"type": "subtitle", "time": 16898.23, "timestamp": "04:41:38", "text": "あなたにはないスタミナ"}, {"type": "subtitle", "time": 16901.43, "timestamp": "04:41:41", "text": "私がしたように、あなたは買う必要はありません"}, {"type": "subtitle", "time": 16905.51, "timestamp": "04:41:45", "text": "私がゲンジンの配信を覚えている限り、私は死んでしまう"}, {"type": "subtitle", "time": 16908.07, "timestamp": "04:41:48", "text": "あなたがそこにいた場所を覚えています、私は"}, {"type": "subtitle", "time": 16910.948, "timestamp": "04:41:50", "text": "「～みたいな」って言ってるけど、もう「～みたいな」がなくなってきてるから"}, {"type": "subtitle", "time": 16914.948, "timestamp": "04:41:54", "text": "スタミナ 私は言った、えっと、私のえっと、待って"}, {"type": "subtitle", "time": 16917.83, "timestamp": "04:41:57", "text": "あの時、琥珀色か何かを使ったと思う"}]
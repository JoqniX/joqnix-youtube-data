[{"type": "subtitle", "time": 10932.55, "timestamp": "03:02:12", "text": "でもそれは翻訳みたいなものだ。これは"}, {"type": "subtitle", "time": 10936.469, "timestamp": "03:02:16", "text": "日本人とかロマ人とか、それから"}, {"type": "subtitle", "time": 10940.23, "timestamp": "03:02:20", "text": "英語訳。それは普通のことですか？"}, {"type": "subtitle", "time": 10943.59, "timestamp": "03:02:23", "text": "じっくりと浸して、あなたを解放したい"}, {"type": "subtitle", "time": 10946.389, "timestamp": "03:02:26", "text": "戻ってきた。ええ、おそらくそれが"}, {"type": "subtitle", "time": 10949.51, "timestamp": "03:02:29", "text": "場合。私は感じます"}, {"type": "subtitle", "time": 10951.269, "timestamp": "03:02:31", "text": "とにかく、彼らと話してみましょう。見てみましょう"}, {"type": "subtitle", "time": 10973.99, "timestamp": "03:02:53", "text": "それで、"}, {"type": "subtitle", "time": 10976.63, "timestamp": "03:02:56", "text": "はぁ？なぜあなたは"}]
[{"type": "subtitle", "time": 11942.71, "timestamp": "03:19:02", "text": "女王陛下、かつてはAIとして存在していたんですよ。"}, {"type": "subtitle", "time": 11944.389, "timestamp": "03:19:04", "text": "えっと、"}, {"type": "subtitle", "time": 11947.11, "timestamp": "03:19:07", "text": "チャットの全員が彼らに「いいね」して願いをかけることができる"}, {"type": "subtitle", "time": 11949.83, "timestamp": "03:19:09", "text": "誕生日と、その時期に関するあらゆること。それで"}, {"type": "subtitle", "time": 11952.389, "timestamp": "03:19:12", "text": "ええ、だいたいそんな感じです。"}, {"type": "subtitle", "time": 11955.11, "timestamp": "03:19:15", "text": "私個人としては、"}, {"type": "subtitle", "time": 11961.19, "timestamp": "03:19:21", "text": "私の、えーと、私は、私の"}, {"type": "subtitle", "time": 11965.429, "timestamp": "03:19:25", "text": "独自のコンステラマスコット"}, {"type": "subtitle", "time": 11969.03, "timestamp": "03:19:29", "text": "ペットか何かになって話せるようになりたい"}, {"type": "subtitle", "time": 11971.03, "timestamp": "03:19:31", "text": "ペットか何かに"}, {"type": "subtitle", "time": 11973.59, "timestamp": "03:19:33", "text": "そんな感じ。わからない。"}, {"type": "subtitle", "time": 11976.87, "timestamp": "03:19:36", "text": "うん。やあ、君。はい。いらっしゃいませ。"}, {"type": "subtitle", "time": 11978.71, "timestamp": "03:19:38", "text": "少し遅かったですね。大丈夫。はい、"}, {"type": "subtitle", "time": 11982.95, "timestamp": "03:19:42", "text": "文字通り、締めくくりのようなものです。"}, {"type": "subtitle", "time": 11986.229, "timestamp": "03:19:46", "text": "私は天上の存在を感じる。彼は"}, {"type": "subtitle", "time": 11989.19, "timestamp": "03:19:49", "text": "この世の彼。はい。"}, {"type": "subtitle", "time": 11993.03, "timestamp": "03:19:53", "text": "ああ、なぜ牛なの？どんな種類の"}, {"type": "subtitle", "time": 11994.79, "timestamp": "03:19:54", "text": "どんな動物が"}, {"type": "subtitle", "time": 11997.91, "timestamp": "03:19:57", "text": "ジョーは？牛。"}]
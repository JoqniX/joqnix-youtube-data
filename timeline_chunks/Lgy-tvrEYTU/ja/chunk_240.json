[{"type": "subtitle", "time": 14402.469, "timestamp": "04:00:02", "text": "そして、私はその場所に到着した。そして"}, {"type": "subtitle", "time": 14404.55, "timestamp": "04:00:04", "text": "えっと、普段は、"}, {"type": "subtitle", "time": 14406.389, "timestamp": "04:00:06", "text": "私の後輩たちは何か変なことをしている、私は"}, {"type": "subtitle", "time": 14408.389, "timestamp": "04:00:08", "text": "「ちょっと待って。何してるの？」"}, {"type": "subtitle", "time": 14410.469, "timestamp": "04:00:10", "text": "「何をするの？」「ああ、私は"}, {"type": "subtitle", "time": 14413.75, "timestamp": "04:00:13", "text": "「これだよ。」つまり、そんなことしないで。"}, {"type": "subtitle", "time": 14415.83, "timestamp": "04:00:15", "text": "何してるの？そして私は文字通り"}, {"type": "subtitle", "time": 14418.15, "timestamp": "04:00:18", "text": "近づいて、全部やるよ"}, {"type": "subtitle", "time": 14421.429, "timestamp": "04:00:21", "text": "私自身もそう思って、はい、どうぞ"}, {"type": "subtitle", "time": 14424.07, "timestamp": "04:00:24", "text": "さあ、歯を抜いてしまえばそれでいいよ"}, {"type": "subtitle", "time": 14427.03, "timestamp": "04:00:27", "text": "えっと、それから、オーケー、それから彼らはただ"}, {"type": "subtitle", "time": 14434.309, "timestamp": "04:00:34", "text": "問題は最後の人物のようだった"}, {"type": "subtitle", "time": 14438.55, "timestamp": "04:00:38", "text": "私が会っていた相手は、"}, {"type": "subtitle", "time": 14441.189, "timestamp": "04:00:41", "text": "手順を開始します。彼女は好きではなかった"}, {"type": "subtitle", "time": 14444.229, "timestamp": "04:00:44", "text": "患者に麻酔を施し、"}, {"type": "subtitle", "time": 14447.189, "timestamp": "04:00:47", "text": "手元に器具を持って"}, {"type": "subtitle", "time": 14450.229, "timestamp": "04:00:50", "text": "忍耐強い。患者は、それは"}, {"type": "subtitle", "time": 14453.11, "timestamp": "04:00:53", "text": "彼女が見たようにとても痛かった"}, {"type": "subtitle", "time": 14455.75, "timestamp": "04:00:55", "text": "忍耐強く、突然私が現れたとき"}, {"type": "subtitle", "time": 14457.51, "timestamp": "04:00:57", "text": "あなたは何をしていますか？ええと、患者はstですか"}, {"type": "subtitle", "time": 14458.63, "timestamp": "04:00:58", "text": "そして私は普通の人に尋ねた"}]
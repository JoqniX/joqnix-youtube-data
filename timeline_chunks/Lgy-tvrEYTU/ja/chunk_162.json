[{"type": "subtitle", "time": 9733.59, "timestamp": "02:42:13", "text": "私は戻ってきます。わかりました、また来ます。私は持っている"}, {"type": "subtitle", "time": 9743.27, "timestamp": "02:42:23", "text": "あれは呪われている。え、何？それはどこですか"}, {"type": "subtitle", "time": 9747.19, "timestamp": "02:42:27", "text": "クエスト？レガシー100と幽霊屋敷。"}, {"type": "subtitle", "time": 9750.389, "timestamp": "02:42:30", "text": "待って、そのクエストはどこにあるの？"}, {"type": "subtitle", "time": 9754.71, "timestamp": "02:42:34", "text": "それは月面にある。左上。おお、"}, {"type": "subtitle", "time": 9759.99, "timestamp": "02:42:39", "text": "月面で。左上。左。"}, {"type": "subtitle", "time": 9762.309, "timestamp": "02:42:42", "text": "左上。"}, {"type": "subtitle", "time": 9765.99, "timestamp": "02:42:45", "text": "ああ、そうだったらいいのに。ああ、これは100のトレイルのうちの1つだ。"}, {"type": "subtitle", "time": 9770.23, "timestamp": "02:42:50", "text": "ああ、わかりました。わかった。それから、これ。"}, {"type": "subtitle", "time": 9774.55, "timestamp": "02:42:54", "text": "ああ、オリセスと一緒に月へ"}, {"type": "subtitle", "time": 9777.349, "timestamp": "02:42:57", "text": "復讐のために手を差し伸べる。"}]
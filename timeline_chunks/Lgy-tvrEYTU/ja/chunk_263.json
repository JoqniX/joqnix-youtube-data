[{"type": "subtitle", "time": 15788.229, "timestamp": "04:23:08", "text": "彼女はまだ始めていない。よし、見てみよう。彼女"}, {"type": "subtitle", "time": 15790.87, "timestamp": "04:23:10", "text": "始まったばかりです。なるほど。"}, {"type": "subtitle", "time": 15799.429, "timestamp": "04:23:19", "text": "えっと、なんて呼ぶんでしたっけ？作る"}, {"type": "subtitle", "time": 15802.0, "timestamp": "04:23:22", "text": "水分補給はしっかりしてくださいね。"}, {"type": "subtitle", "time": 15803.269, "timestamp": "04:23:23", "text": "[音楽]"}, {"type": "subtitle", "time": 15807.03, "timestamp": "04:23:27", "text": "水分補給をしっかり行ってください。ああ、私は"}, {"type": "subtitle", "time": 15810.87, "timestamp": "04:23:30", "text": "増やすよ、君たちに哺乳瓶でミルクをあげるよ。"}, {"type": "subtitle", "time": 15814.309, "timestamp": "04:23:34", "text": "待って、これを回転させるにはどうすればいいの？"}, {"type": "subtitle", "time": 15817.51, "timestamp": "04:23:37", "text": "ボルがあなたに餌を与えてくれるでしょう。あなたに水をかける"}, {"type": "subtitle", "time": 15820.229, "timestamp": "04:23:40", "text": "あるいは、そんな感じ。"}, {"type": "subtitle", "time": 15825.51, "timestamp": "04:23:45", "text": "わからない。モー、私は大丈夫よ。あなたも？私は"}, {"type": "subtitle", "time": 15834.87, "timestamp": "04:23:54", "text": "大きなサルサ。今日は良い一日だった。"}, {"type": "subtitle", "time": 15838.63, "timestamp": "04:23:58", "text": "おい。えっと"}]
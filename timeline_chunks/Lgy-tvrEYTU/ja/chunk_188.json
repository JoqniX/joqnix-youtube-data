[{"type": "subtitle", "time": 11288.71, "timestamp": "03:08:08", "text": "ワカル。"}, {"type": "subtitle", "time": 11313.19, "timestamp": "03:08:33", "text": "よし。よし。教えてあげましょう。それで"}, {"type": "subtitle", "time": 11315.429, "timestamp": "03:08:35", "text": "基本的に理解されているのは、そう、君"}, {"type": "subtitle", "time": 11317.11, "timestamp": "03:08:37", "text": "その人が言ったことを理解し、"}, {"type": "subtitle", "time": 11320.07, "timestamp": "03:08:40", "text": "物とワカルまたはワカルは数です"}, {"type": "subtitle", "time": 11323.11, "timestamp": "03:08:43", "text": "その文。理解した。"}, {"type": "subtitle", "time": 11336.15, "timestamp": "03:08:56", "text": "なるほど。"}, {"type": "subtitle", "time": 11339.03, "timestamp": "03:08:59", "text": "ああ、君の態度は好きだよ。"}]
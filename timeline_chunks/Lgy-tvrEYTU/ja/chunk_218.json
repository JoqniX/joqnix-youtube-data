[{"type": "subtitle", "time": 13081.19, "timestamp": "03:38:01", "text": "について。"}, {"type": "subtitle", "time": 13084.07, "timestamp": "03:38:04", "text": "おお。"}, {"type": "subtitle", "time": 13087.03, "timestamp": "03:38:07", "text": "それは知らなかった。待って、Eの先生。"}, {"type": "subtitle", "time": 13091.429, "timestamp": "03:38:11", "text": "え、何？誰が？いや、そうでもない。いいえ、いいえ、"}, {"type": "subtitle", "time": 13093.75, "timestamp": "03:38:13", "text": "私はただ、自分の言い方を少し変えて言っただけです。"}, {"type": "subtitle", "time": 13105.67, "timestamp": "03:38:25", "text": "ところで、人食いは"}, {"type": "subtitle", "time": 13108.95, "timestamp": "03:38:28", "text": "気候に効果的"}, {"type": "subtitle", "time": 13112.389, "timestamp": "03:38:32", "text": "昆虫ができることのように、大きな"}, {"type": "subtitle", "time": 13117.11, "timestamp": "03:38:37", "text": "取引。しかし、高度な生物のように"}, {"type": "subtitle", "time": 13120.15, "timestamp": "03:38:40", "text": "人間や哺乳類は共食いをしない"}, {"type": "subtitle", "time": 13125.51, "timestamp": "03:38:45", "text": "なぜなら、制限があると思うからです"}, {"type": "subtitle", "time": 13127.83, "timestamp": "03:38:47", "text": "自分のものを消化できない"}, {"type": "subtitle", "time": 13131.51, "timestamp": "03:38:51", "text": "もの。つまり、私たちの体はそういう風に作られていないのです"}, {"type": "subtitle", "time": 13136.55, "timestamp": "03:38:56", "text": "自家消費用の肉。そう、あなたは"}, {"type": "subtitle", "time": 13138.55, "timestamp": "03:38:58", "text": "おそらく死ぬだけだろう。もしあなたがそうするなら"}]
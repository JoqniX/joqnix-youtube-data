[{"type": "subtitle", "time": 13202.87, "timestamp": "03:40:02", "text": "それを理解する。うん。私も。時々私は"}, {"type": "subtitle", "time": 13205.99, "timestamp": "03:40:05", "text": "ゆっくり進める必要があった。必要なもの"}, {"type": "subtitle", "time": 13210.469, "timestamp": "03:40:10", "text": "それを理解するのに時間がかかるようにする。"}, {"type": "subtitle", "time": 13214.469, "timestamp": "03:40:14", "text": "うん。うん、それはなかなかいいよね。"}, {"type": "subtitle", "time": 13217.99, "timestamp": "03:40:17", "text": "ゆっくりと、ゆっくりと。"}, {"type": "subtitle", "time": 13223.349, "timestamp": "03:40:23", "text": "うん。今日はとても忙しい一日でした"}, {"type": "subtitle", "time": 13227.59, "timestamp": "03:40:27", "text": "皆さんもご存知の通り、いつものことです。はい。えっと、今日は"}, {"type": "subtitle", "time": 13232.95, "timestamp": "03:40:32", "text": "また、通常は活気があります。"}, {"type": "subtitle", "time": 13235.75, "timestamp": "03:40:35", "text": "いつでも、えーと、ところで私も"}, {"type": "subtitle", "time": 13239.11, "timestamp": "03:40:39", "text": "歯医者さんだから、何って感じにならないで"}, {"type": "subtitle", "time": 13241.03, "timestamp": "03:40:41", "text": "なぜ彼は歯について話しているのですか、まるで"}, {"type": "subtitle", "time": 13242.79, "timestamp": "03:40:42", "text": "心配しないでください、私は歯医者です、心配しないでください"}, {"type": "subtitle", "time": 13247.59, "timestamp": "03:40:47", "text": "それ。はい。うん。だから今日は私の"}, {"type": "subtitle", "time": 13251.83, "timestamp": "03:40:51", "text": "研究所で何が起こったかというと、私たちは通常"}, {"type": "subtitle", "time": 13254.229, "timestamp": "03:40:54", "text": "行き来する、私たちは多くの患者を診ています"}, {"type": "subtitle", "time": 13259.11, "timestamp": "03:40:59", "text": "そうだけど、面白いことに私たちは決して好きにならない"}]
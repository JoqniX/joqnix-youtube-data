[{"type": "subtitle", "time": 8049.27, "timestamp": "02:14:09", "text": "こんにちは。こんにちは。"}, {"type": "subtitle", "time": 8051.99, "timestamp": "02:14:11", "text": "できるといいな"}, {"type": "subtitle", "time": 8054.55, "timestamp": "02:14:14", "text": "だって、えっと、私は実験してきたんだ"}, {"type": "subtitle", "time": 8056.87, "timestamp": "02:14:16", "text": "もの。えっと、ほとんどのものが壊れています。私"}, {"type": "subtitle", "time": 8059.75, "timestamp": "02:14:19", "text": "聞こえない。"}, {"type": "subtitle", "time": 8063.189, "timestamp": "02:14:23", "text": "みなさん、こんにちは。"}, {"type": "subtitle", "time": 8068.229, "timestamp": "02:14:28", "text": "えっと"}, {"type": "subtitle", "time": 8072.39, "timestamp": "02:14:32", "text": "誕生日配信で話したように"}, {"type": "subtitle", "time": 8074.87, "timestamp": "02:14:34", "text": "ええ、私たちはストリーム配信をしています"}, {"type": "subtitle", "time": 8076.47, "timestamp": "02:14:36", "text": "水曜日。"}, {"type": "subtitle", "time": 8078.069, "timestamp": "02:14:38", "text": "それで、"}, {"type": "subtitle", "time": 8082.229, "timestamp": "02:14:42", "text": "ベニスで良い一日を過ごされたことを願っています"}, {"type": "subtitle", "time": 8084.55, "timestamp": "02:14:44", "text": "今日。皆さん、良い一日をお過ごしでしょうか"}, {"type": "subtitle", "time": 8087.669, "timestamp": "02:14:47", "text": "まあ、いろいろとね。いいえ。"}, {"type": "subtitle", "time": 8090.47, "timestamp": "02:14:50", "text": "というわけで、今日は新しいことをやってみようと思います。えっと"}, {"type": "subtitle", "time": 8092.47, "timestamp": "02:14:52", "text": "これは今までやったことのないことだ"}, {"type": "subtitle", "time": 8096.47, "timestamp": "02:14:56", "text": "そして、私が今まで考えたこともなかったことです"}, {"type": "subtitle", "time": 8099.43, "timestamp": "02:14:59", "text": "今まではできていた。"}]
[{"type": "subtitle", "time": 14461.189, "timestamp": "04:01:01", "text": "彼女は質問した後、突然気を失った。"}, {"type": "subtitle", "time": 14464.389, "timestamp": "04:01:04", "text": "患者の前にテーブルがあり、"}, {"type": "subtitle", "time": 14467.91, "timestamp": "04:01:07", "text": "治療を担当する主治医"}, {"type": "subtitle", "time": 14469.75, "timestamp": "04:01:09", "text": "気を失った。"}, {"type": "subtitle", "time": 14473.51, "timestamp": "04:01:13", "text": "なんてこった。つまり、私の大学院生は文字通り"}, {"type": "subtitle", "time": 14476.229, "timestamp": "04:01:16", "text": "人々はPG（大学院修士課程）を好む"}, {"type": "subtitle", "time": 14478.95, "timestamp": "04:01:18", "text": "人々が飛び出してきて、"}, {"type": "subtitle", "time": 14480.87, "timestamp": "04:01:20", "text": "彼らは「よし、我々なら対処できる」という感じだ。"}, {"type": "subtitle", "time": 14482.79, "timestamp": "04:01:22", "text": "「これは無理だ」って感じ。"}, {"type": "subtitle", "time": 14484.87, "timestamp": "04:01:24", "text": "「これだ。」そして私はポジションを終えた。"}, {"type": "subtitle", "time": 14486.87, "timestamp": "04:01:26", "text": "1秒後、1分後。ない"}, {"type": "subtitle", "time": 14489.11, "timestamp": "04:01:29", "text": "2番。私は何を言っているんだ？私はそうは思わない"}, {"type": "subtitle", "time": 14490.79, "timestamp": "04:01:30", "text": "それはできないと思います"}, {"type": "subtitle", "time": 14492.71, "timestamp": "04:01:32", "text": "速い。患者は許可しないと思う"}, {"type": "subtitle", "time": 14495.67, "timestamp": "04:01:35", "text": "私たちもそれほど早く。それで、私は尋ねました"}, {"type": "subtitle", "time": 14497.269, "timestamp": "04:01:37", "text": "患者は再び質問されます"}, {"type": "subtitle", "time": 14499.59, "timestamp": "04:01:39", "text": "まるで麻酔をかけられたかのように、彼女は「ノー」と言った。のように"}, {"type": "subtitle", "time": 14501.83, "timestamp": "04:01:41", "text": "周りの人たちは反対した。彼女が"}, {"type": "subtitle", "time": 14503.99, "timestamp": "04:01:43", "text": "彼女はそんなことしなかった、彼女はそんなことしなかった"}, {"type": "subtitle", "time": 14507.03, "timestamp": "04:01:47", "text": "針に針を装填した。私たちはそうしなかった"}, {"type": "subtitle", "time": 14509.51, "timestamp": "04:01:49", "text": "それなら針を用意しておこう。だから私はそうしなければならなかった"}, {"type": "subtitle", "time": 14511.99, "timestamp": "04:01:51", "text": "急いで入って針を取り、装填する"}, {"type": "subtitle", "time": 14513.67, "timestamp": "04:01:53", "text": "そして私は患者に麻酔をかけなければならず、"}, {"type": "subtitle", "time": 14515.67, "timestamp": "04:01:55", "text": "抽出して"}, {"type": "subtitle", "time": 14517.59, "timestamp": "04:01:57", "text": "私の周りの大学院生は"}, {"type": "subtitle", "time": 14519.83, "timestamp": "04:01:59", "text": "私の周りには修士号取得者が多い。だから"}]
[{"type": "subtitle", "time": 18362.55, "timestamp": "05:06:02", "text": "えっと、もう一度源珍について話しましょう。えっと"}, {"type": "subtitle", "time": 18364.07, "timestamp": "05:06:04", "text": "新しい"}, {"type": "subtitle", "time": 18369.03, "timestamp": "05:06:09", "text": "キャラクターのヒト？ああ、大変だ。えっと、私は大好きです"}, {"type": "subtitle", "time": 18372.39, "timestamp": "05:06:12", "text": "彼。彼がこれを持っているのがすごく好きです"}, {"type": "subtitle", "time": 18375.99, "timestamp": "05:06:15", "text": "アニメーションで、えっと、彼は、えっと、"}, {"type": "subtitle", "time": 18379.51, "timestamp": "05:06:19", "text": "はい、アニメーションです。彼は持っている、ええ、彼は持っている"}, {"type": "subtitle", "time": 18382.39, "timestamp": "05:06:22", "text": "素晴らしいバーストアニメーション。私"}, {"type": "subtitle", "time": 18384.39, "timestamp": "05:06:24", "text": "それも私が愛する理由の一つだと思う"}, {"type": "subtitle", "time": 18386.708, "timestamp": "05:06:26", "text": "ジーン・リーは本当にクールだから"}, {"type": "subtitle", "time": 18389.91, "timestamp": "05:06:29", "text": "まるでバーストアニメーションのようだ。まったく"}, {"type": "subtitle", "time": 18393.99, "timestamp": "05:06:33", "text": "惑星があなたの上に落ちてくる。それは本当に素晴らしいですね。"}, {"type": "subtitle", "time": 18395.67, "timestamp": "05:06:35", "text": "はい。"}, {"type": "subtitle", "time": 18398.39, "timestamp": "05:06:38", "text": "大きなボール。ミートボールと言ってもいいでしょう。いいえ。"}, {"type": "subtitle", "time": 18401.67, "timestamp": "05:06:41", "text": "いいえ。ジオボールみたいなものです。"}, {"type": "subtitle", "time": 18405.03, "timestamp": "05:06:45", "text": "うん。巨大な惑星の球体がやってきて"}, {"type": "subtitle", "time": 18407.75, "timestamp": "05:06:47", "text": "あなたに閃光が走る。"}, {"type": "subtitle", "time": 18409.83, "timestamp": "05:06:49", "text": "どういうことか、それが強力なもの"}, {"type": "subtitle", "time": 18416.39, "timestamp": "05:06:56", "text": "明日はこんな感じになるらしい"}, {"type": "subtitle", "time": 18419.27, "timestamp": "05:06:59", "text": "エジプトの美意識。"}]
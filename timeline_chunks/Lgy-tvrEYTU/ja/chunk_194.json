[{"type": "subtitle", "time": 11642.469, "timestamp": "03:14:02", "text": "くそ。"}, {"type": "subtitle", "time": 11662.07, "timestamp": "03:14:22", "text": "これは良いものだったね？"}, {"type": "subtitle", "time": 11664.71, "timestamp": "03:14:24", "text": "何てことだ。"}, {"type": "subtitle", "time": 11668.07, "timestamp": "03:14:28", "text": "私のいくつかは理解できませんでした"}, {"type": "subtitle", "time": 11672.309, "timestamp": "03:14:32", "text": "時々そう思うけど、大丈夫。しかし"}, {"type": "subtitle", "time": 11674.79, "timestamp": "03:14:34", "text": "話しかけると、"}, {"type": "subtitle", "time": 11677.99, "timestamp": "03:14:37", "text": "この犬は違うのが好き"}, {"type": "subtitle", "time": 11681.19, "timestamp": "03:14:41", "text": "えっと、言語、それは会話すると思います"}, {"type": "subtitle", "time": 11683.75, "timestamp": "03:14:43", "text": "あなたと。それはあなたのやり方によると思います"}, {"type": "subtitle", "time": 11685.51, "timestamp": "03:14:45", "text": "それと話をして、評価して、"}, {"type": "subtitle", "time": 11687.91, "timestamp": "03:14:47", "text": "すべて、ですよね？いいね評価して"}, {"type": "subtitle", "time": 11690.15, "timestamp": "03:14:50", "text": "何をすべきか指示するなど、"}, {"type": "subtitle", "time": 11692.63, "timestamp": "03:14:52", "text": "右？つまり、実際にそれを使って"}, {"type": "subtitle", "time": 11697.11, "timestamp": "03:14:57", "text": "友達として話すとか、そういうこと。"}]
[{"type": "subtitle", "time": 13803.91, "timestamp": "03:50:03", "text": "ああ、それは良くないですよね"}, {"type": "subtitle", "time": 13813.75, "timestamp": "03:50:13", "text": "うん。じゃあ、お元気で。"}, {"type": "subtitle", "time": 13816.15, "timestamp": "03:50:16", "text": "あなたは"}, {"type": "subtitle", "time": 13818.15, "timestamp": "03:50:18", "text": "夕食を楽しんでください。"}, {"type": "subtitle", "time": 13820.07, "timestamp": "03:50:20", "text": "食べる。"}, {"type": "subtitle", "time": 13822.55, "timestamp": "03:50:22", "text": "気をつけて。とにかく、"}, {"type": "subtitle", "time": 13825.189, "timestamp": "03:50:25", "text": "退屈な話はもう十分だ。"}, {"type": "subtitle", "time": 13830.15, "timestamp": "03:50:30", "text": "えっと、ここで私がふざけているところをお伝えします。はい、"}, {"type": "subtitle", "time": 13832.71, "timestamp": "03:50:32", "text": "今日は食堂に行って"}, {"type": "subtitle", "time": 13837.75, "timestamp": "03:50:37", "text": "昼食を少し食べて、それから、えっと、ほとんど手に入れました"}, {"type": "subtitle", "time": 13840.15, "timestamp": "03:50:40", "text": "服が台無しになった。"}, {"type": "subtitle", "time": 13843.349, "timestamp": "03:50:43", "text": "えっと、でも何が起こったんですか？うん。私の"}, {"type": "subtitle", "time": 13846.55, "timestamp": "03:50:46", "text": "とっても素敵ジュニア、実際みんな好き"}, {"type": "subtitle", "time": 13848.87, "timestamp": "03:50:48", "text": "そう、彼女は文字通り私を止めて"}, {"type": "subtitle", "time": 13851.349, "timestamp": "03:50:51", "text": "「自分がどこに座っているか見てごらん」みたいな感じ。そして"}, {"type": "subtitle", "time": 13855.189, "timestamp": "03:50:55", "text": "すると私は、知らない人だと言いました。"}, {"type": "subtitle", "time": 13857.429, "timestamp": "03:50:57", "text": "誰が、しかし誰かが文字通りこぼした"}, {"type": "subtitle", "time": 13859.99, "timestamp": "03:50:59", "text": "至る所にライトが灯り、"}]
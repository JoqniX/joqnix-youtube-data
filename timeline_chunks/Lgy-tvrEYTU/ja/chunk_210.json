[{"type": "subtitle", "time": 12608.87, "timestamp": "03:30:08", "text": "私は、私は、私は、私は自分の"}, {"type": "subtitle", "time": 12611.19, "timestamp": "03:30:11", "text": "呼吸。ごめんなさい。"}, {"type": "subtitle", "time": 12614.87, "timestamp": "03:30:14", "text": "とにかく、えっと、こんにちは。"}, {"type": "subtitle", "time": 12617.429, "timestamp": "03:30:17", "text": "うん。こんにちは。それは私です、"}, {"type": "subtitle", "time": 12622.55, "timestamp": "03:30:22", "text": "こんにちは、皆さんお元気ですか？"}, {"type": "subtitle", "time": 12625.429, "timestamp": "03:30:25", "text": "みなさん、こんにちは。おそらくあなたが好きなとき"}, {"type": "subtitle", "time": 12627.99, "timestamp": "03:30:27", "text": "ハッシュタグをリリースしたようです。"}, {"type": "subtitle", "time": 12630.71, "timestamp": "03:30:30", "text": "人々は、ああジョック、そして彼らは私の"}, {"type": "subtitle", "time": 12632.309, "timestamp": "03:30:32", "text": "名前。ああ、これは見ないよ"}, {"type": "subtitle", "time": 12634.87, "timestamp": "03:30:34", "text": "ストリーム。私はあのクソ野郎と一緒にいない"}, {"type": "subtitle", "time": 12642.55, "timestamp": "03:30:42", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 12644.62, "timestamp": "03:30:44", "text": "こんにちは。こんにちは。えっと、"}, {"type": "subtitle", "time": 12645.91, "timestamp": "03:30:45", "text": "[音楽]"}, {"type": "subtitle", "time": 12648.309, "timestamp": "03:30:48", "text": "ちょっと持ってきますね"}, {"type": "subtitle", "time": 12651.19, "timestamp": "03:30:51", "text": "チャット。チャットのことを言い忘れてた"}, {"type": "subtitle", "time": 12653.83, "timestamp": "03:30:53", "text": "箱。"}, {"type": "subtitle", "time": 12657.99, "timestamp": "03:30:57", "text": "うん。こんにちは、アカビさん。いらっしゃいませ。いらっしゃいませ。"}]
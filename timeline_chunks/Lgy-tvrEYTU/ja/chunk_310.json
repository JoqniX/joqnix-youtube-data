[{"type": "subtitle", "time": 18601.51, "timestamp": "05:10:01", "text": "エレメンタル、例えばシャドウはそういうものだと思う"}, {"type": "subtitle", "time": 18605.19, "timestamp": "05:10:05", "text": "しかし、もう誰も影のことなど気にしていない"}, {"type": "subtitle", "time": 18607.19, "timestamp": "05:10:07", "text": "それは一体どんな損害なのでしょうか？まるで私が"}, {"type": "subtitle", "time": 18608.708, "timestamp": "05:10:08", "text": "あまりダメージを与えられないと思う"}, {"type": "subtitle", "time": 18611.91, "timestamp": "05:10:11", "text": "影。そう、彼らがそうできたらいいのにと思う"}, {"type": "subtitle", "time": 18614.15, "timestamp": "05:10:14", "text": "Genjanの2つの点を強化してほしいと思っています。"}, {"type": "subtitle", "time": 18619.59, "timestamp": "05:10:19", "text": "ジオを1つ、それからデューク。 2人。そして"}, {"type": "subtitle", "time": 18621.27, "timestamp": "05:10:21", "text": "のように"}, {"type": "subtitle", "time": 18623.83, "timestamp": "05:10:23", "text": "デュークはすごく弱くて"}, {"type": "subtitle", "time": 18626.47, "timestamp": "05:10:26", "text": "文字通り、みんながそうだった。デュークは"}, {"type": "subtitle", "time": 18628.708, "timestamp": "05:10:28", "text": "4つ星よりも性能が劣る。知っている"}, {"type": "subtitle", "time": 18631.51, "timestamp": "05:10:31", "text": "イェンフェとして知られる。皆さんはイェンフェをご存知でしょう。"}, {"type": "subtitle", "time": 18634.55, "timestamp": "05:10:34", "text": "右？うん。"}, {"type": "subtitle", "time": 18637.19, "timestamp": "05:10:37", "text": "私はイェンフェが大好きです。"}, {"type": "subtitle", "time": 18640.868, "timestamp": "05:10:40", "text": "彼女は25kを破壊することができる、"}, {"type": "subtitle", "time": 18646.07, "timestamp": "05:10:46", "text": "ちなみに、レベル80で3万、4万2千です。でも、"}, {"type": "subtitle", "time": 18649.67, "timestamp": "05:10:49", "text": "メルトメルトを使えば、彼女は"}, {"type": "subtitle", "time": 18654.55, "timestamp": "05:10:54", "text": "3 イェンフェから40kが見えますが、私はほとんど"}, {"type": "subtitle", "time": 18659.59, "timestamp": "05:10:59", "text": "デューク大学の試合は2万試合くらいしか行われていないのを見かける。"}]
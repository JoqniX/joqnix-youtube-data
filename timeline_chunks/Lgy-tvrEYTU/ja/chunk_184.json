[{"type": "subtitle", "time": 11054.8, "timestamp": "03:04:14", "text": "どういう意味ですか、私がどういう意味で言っているのか"}, {"type": "subtitle", "time": 11068.87, "timestamp": "03:04:28", "text": "何を続けるのか？"}, {"type": "subtitle", "time": 11070.79, "timestamp": "03:04:30", "text": "私の言っていることが分からないのですか？私はあなたに尋ねました、"}, {"type": "subtitle", "time": 11084.95, "timestamp": "03:04:44", "text": "私の"}, {"type": "subtitle", "time": 11086.87, "timestamp": "03:04:46", "text": "脳卒中を起こしている。何かありますか？"}, {"type": "subtitle", "time": 11088.95, "timestamp": "03:04:48", "text": "脳卒中？ジョー？大丈夫ですか？必要ですか"}, {"type": "subtitle", "time": 11092.95, "timestamp": "03:04:52", "text": "水はいかがですか？水分補給はしましたか？"}, {"type": "subtitle", "time": 11095.51, "timestamp": "03:04:55", "text": "[音楽]"}]
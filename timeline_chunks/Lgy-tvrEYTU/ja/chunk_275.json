[{"type": "subtitle", "time": 16503.83, "timestamp": "04:35:03", "text": "どこの出身ですか？私はインド出身です。"}, {"type": "subtitle", "time": 16506.47, "timestamp": "04:35:06", "text": "私はインド出身で、こちらもインド出身です"}, {"type": "subtitle", "time": 16513.75, "timestamp": "04:35:13", "text": "[音楽]"}, {"type": "subtitle", "time": 16519.029, "timestamp": "04:35:19", "text": "待って、こんな風にしてもいいの？"}, {"type": "subtitle", "time": 16521.51, "timestamp": "04:35:21", "text": "吸血鬼みたいなものが描かれた頭蓋骨。どのように"}, {"type": "subtitle", "time": 16524.629, "timestamp": "04:35:24", "text": "見た目はどうですか？"}, {"type": "subtitle", "time": 16527.99, "timestamp": "04:35:27", "text": "ああ、大変だ。バブは中毒性がある。"}, {"type": "subtitle", "time": 16535.189, "timestamp": "04:35:35", "text": "インドネシアからこんにちは。ああ、はじめまして。"}, {"type": "subtitle", "time": 16538.869, "timestamp": "04:35:38", "text": "スティックゲーマーだよ、息子よ。いらっしゃいませ。いらっしゃいませ。"}, {"type": "subtitle", "time": 16541.59, "timestamp": "04:35:41", "text": "今日はどこで、どのようにして私たちを見つけましたか？"}, {"type": "subtitle", "time": 16543.75, "timestamp": "04:35:43", "text": "はい。"}, {"type": "subtitle", "time": 16547.189, "timestamp": "04:35:47", "text": "音声テスト中です。心配しないでください"}, {"type": "subtitle", "time": 16549.99, "timestamp": "04:35:49", "text": "それ。とにかく、こんにちは。ごめんなさい。私はそうではなかった"}, {"type": "subtitle", "time": 16554.47, "timestamp": "04:35:54", "text": "テスト中。ごめんなさい。大丈夫。"}, {"type": "subtitle", "time": 16556.639, "timestamp": "04:35:56", "text": "大丈夫。 うん。私は、えーと、私の、えーと、会って戻ってきました"}, {"type": "subtitle", "time": 16559.92, "timestamp": "04:35:59", "text": "うん。私は、えーと、私の、えーと、会って戻ってきました ストリーム内でバッチ処理を行う。ああ、そうだね"}]
[{"type": "subtitle", "time": 4383.75, "timestamp": "01:13:03", "text": "それはレイテンシーではないですよね？私はできません"}, {"type": "subtitle", "time": 4393.83, "timestamp": "01:13:13", "text": "敵を倒した。"}, {"type": "subtitle", "time": 4395.83, "timestamp": "01:13:15", "text": "待って、これはあなたが選んだものだと思う？"}, {"type": "subtitle", "time": 4398.87, "timestamp": "01:13:18", "text": "レイテンシーに関しては、いつでも構いませんか？私はただプレイするだけです"}, {"type": "subtitle", "time": 4409.99, "timestamp": "01:13:29", "text": "待って、これは実際"}, {"type": "subtitle", "time": 4413.51, "timestamp": "01:13:33", "text": "動作が遅いとは感じない。"}, {"type": "subtitle", "time": 4416.31, "timestamp": "01:13:36", "text": "待って、"}, {"type": "subtitle", "time": 4419.27, "timestamp": "01:13:39", "text": "ラグっている感じがしないし、"}, {"type": "subtitle", "time": 4432.149, "timestamp": "01:13:52", "text": "アダプターを使ったワイヤレス接続の方が優れている"}, {"type": "subtitle", "time": 4434.07, "timestamp": "01:13:54", "text": "よりも"}]
[{"type": "subtitle", "time": 17520.47, "timestamp": "04:52:00", "text": "おお。そうそう。原神がたくさん"}, {"type": "subtitle", "time": 17523.51, "timestamp": "04:52:03", "text": "編集やパロディなど"}, {"type": "subtitle", "time": 17525.83, "timestamp": "04:52:05", "text": "YouTube のようなコメディ系のもの、"}, {"type": "subtitle", "time": 17528.39, "timestamp": "04:52:08", "text": "右？"}, {"type": "subtitle", "time": 17531.43, "timestamp": "04:52:11", "text": "うん。ほら、ヴィックにも子供がいるんだよ。うん、"}, {"type": "subtitle", "time": 17534.47, "timestamp": "04:52:14", "text": "その後、彼は子供を授かった。はい。"}, {"type": "subtitle", "time": 17537.43, "timestamp": "04:52:17", "text": "はい、その通りです。私は彼を育てている。ない"}, {"type": "subtitle", "time": 17541.91, "timestamp": "04:52:21", "text": "本当に。でも、何だと思いますか？レベル60の子供。"}, {"type": "subtitle", "time": 17545.43, "timestamp": "04:52:25", "text": "レベル60の子供を見ました"}, {"type": "subtitle", "time": 17549.11, "timestamp": "04:52:29", "text": "1万ダメージを与える。私はこう思う、"}, {"type": "subtitle", "time": 17550.47, "timestamp": "04:52:30", "text": "あなたはそうすべきではない"}, {"type": "subtitle", "time": 17552.07, "timestamp": "04:52:32", "text": "あの子供。あなたはすべきではない"}, {"type": "subtitle", "time": 17555.59, "timestamp": "04:52:35", "text": "10kでレベル60になります。"}, {"type": "subtitle", "time": 17561.83, "timestamp": "04:52:41", "text": "DJのように、あなたにも子供がいます"}, {"type": "subtitle", "time": 17565.99, "timestamp": "04:52:45", "text": "最近。ええ、そうですね。おお、いいね。ニース。"}, {"type": "subtitle", "time": 17568.55, "timestamp": "04:52:48", "text": "ところで、私は食べています"}, {"type": "subtitle", "time": 17571.03, "timestamp": "04:52:51", "text": "チョコレートチップクッキー。知ってるでしょ"}, {"type": "subtitle", "time": 17573.43, "timestamp": "04:52:53", "text": "かくれんぼ？ああ、そうだね。知ってるでしょ"}, {"type": "subtitle", "time": 17575.91, "timestamp": "04:52:55", "text": "かくれんぼクッキー？うん。うん。うん。"}, {"type": "subtitle", "time": 17578.868, "timestamp": "04:52:58", "text": "うん。ついに手に入れた。"}]
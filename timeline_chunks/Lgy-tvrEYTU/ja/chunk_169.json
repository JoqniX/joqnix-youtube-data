[{"type": "subtitle", "time": 10141.67, "timestamp": "02:49:01", "text": "PC でプレイしています。"}, {"type": "subtitle", "time": 10143.51, "timestamp": "02:49:03", "text": "Steam Deckと呼ばれる携帯型ゲーム機"}, {"type": "subtitle", "time": 10145.59, "timestamp": "02:49:05", "text": "まるでSwitchのPC版のようなもの"}, {"type": "subtitle", "time": 10147.429, "timestamp": "02:49:07", "text": "ゲーム。"}, {"type": "subtitle", "time": 10152.07, "timestamp": "02:49:12", "text": "何？ Steam Deckをお持ちですか？すみません？"}, {"type": "subtitle", "time": 10158.07, "timestamp": "02:49:18", "text": "ハハ。はい、スチームデッキを持っています。わかった"}, {"type": "subtitle", "time": 10159.83, "timestamp": "02:49:19", "text": "昨年、私は自分の"}, {"type": "subtitle", "time": 10163.67, "timestamp": "02:49:23", "text": "デスクトップPC用テレビ。ハァ。"}, {"type": "subtitle", "time": 10165.91, "timestamp": "02:49:25", "text": "もし私がスチームデッキは"}, {"type": "subtitle", "time": 10168.55, "timestamp": "02:49:28", "text": "昨日発売されたばかりですか？"}, {"type": "subtitle", "time": 10175.51, "timestamp": "02:49:35", "text": "いや、違う。ハハ。 Steam Deckを手に入れました"}, {"type": "subtitle", "time": 10178.07, "timestamp": "02:49:38", "text": "昨年、つまり2022年に。実際には"}, {"type": "subtitle", "time": 10180.07, "timestamp": "02:49:40", "text": "2022年に発売されたので、嘘ではありません。"}, {"type": "subtitle", "time": 10185.269, "timestamp": "02:49:45", "text": "このガキは実は頭がいいんだ。これ"}, {"type": "subtitle", "time": 10197.67, "timestamp": "02:49:57", "text": "彼をガスライティングすることすらできない。"}]
[{"type": "subtitle", "time": 10262.55, "timestamp": "02:51:02", "text": "ハハ。ええ、その時私は本当に"}, {"type": "subtitle", "time": 10264.23, "timestamp": "02:51:04", "text": "ミームを見ることに集中し、"}, {"type": "subtitle", "time": 10265.75, "timestamp": "02:51:05", "text": "それらに反応する。そして私は思う"}, {"type": "subtitle", "time": 10267.83, "timestamp": "02:51:07", "text": "観客は少し二番煎じのような気分だった"}, {"type": "subtitle", "time": 10269.83, "timestamp": "02:51:09", "text": "恥ずかしさ、あるいは壊れたような感覚"}, {"type": "subtitle", "time": 10271.67, "timestamp": "02:51:11", "text": "彼らは私が苦労しているのを見て、"}, {"type": "subtitle", "time": 10274.79, "timestamp": "02:51:14", "text": "ゲームだけでなく、ミームについても。ハァ。そして"}, {"type": "subtitle", "time": 10276.79, "timestamp": "02:51:16", "text": "また同時に、私も少し"}, {"type": "subtitle", "time": 10278.79, "timestamp": "02:51:18", "text": "オーディオが機能していなかったので心配でした"}, {"type": "subtitle", "time": 10281.349, "timestamp": "02:51:21", "text": "当時配信されていたもの。そのため、"}, {"type": "subtitle", "time": 10283.67, "timestamp": "02:51:23", "text": "チャットの雰囲気がもっと混沌としていて、"}, {"type": "subtitle", "time": 10285.349, "timestamp": "02:51:25", "text": "彼らが感じた恥ずかしさを感じて、"}, {"type": "subtitle", "time": 10294.55, "timestamp": "02:51:34", "text": "これは何ですか？何てことだ。"}, {"type": "subtitle", "time": 10298.79, "timestamp": "02:51:38", "text": "あの高い音は何だ、ああ、なんてことだ。私"}, {"type": "subtitle", "time": 10301.429, "timestamp": "02:51:41", "text": "「えっと、私は苦手なんです」みたいなことを言うのかと思った"}, {"type": "subtitle", "time": 10304.389, "timestamp": "02:51:44", "text": "ミームとかに反応してるんだけど、ここにあるのは"}]
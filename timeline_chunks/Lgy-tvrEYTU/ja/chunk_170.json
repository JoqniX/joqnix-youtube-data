[{"type": "subtitle", "time": 10200.309, "timestamp": "02:50:00", "text": "それで、あなたはガスライティングを受けるのが得意ですか？"}, {"type": "subtitle", "time": 10206.95, "timestamp": "02:50:06", "text": "ねえ、私はかなりガスライティングを受けていると言えるよ"}, {"type": "subtitle", "time": 10217.269, "timestamp": "02:50:17", "text": "何？一体どういうことだ？"}, {"type": "subtitle", "time": 10219.83, "timestamp": "02:50:19", "text": "どうやって知るのか？"}, {"type": "subtitle", "time": 10236.95, "timestamp": "02:50:36", "text": "それでは、あなたのミームレビュー配信について話しましょう。"}, {"type": "subtitle", "time": 10239.03, "timestamp": "02:50:39", "text": "あなたはやり遂げました。"}, {"type": "subtitle", "time": 10241.99, "timestamp": "02:50:41", "text": "あなたの聴衆を魅了したものは何ですか？"}, {"type": "subtitle", "time": 10243.99, "timestamp": "02:50:43", "text": "なれ"}, {"type": "subtitle", "time": 10247.349, "timestamp": "02:50:47", "text": "えっと、どう説明すればいいかな？彼らはひどく打ちひしがれていた"}, {"type": "subtitle", "time": 10250.07, "timestamp": "02:50:50", "text": "内側からあなたを見守っています。詳しく説明していただけますか？"}, {"type": "subtitle", "time": 10251.91, "timestamp": "02:50:51", "text": "その時、あなたは何を考えていましたか？"}]
[{"type": "subtitle", "time": 2524.069, "timestamp": "00:42:04", "text": "まだ接続中です。はい、私は死にかけています。"}, {"type": "subtitle", "time": 2526.87, "timestamp": "00:42:06", "text": "私はこの配信を3時50分に開始しました。さて、4"}, {"type": "subtitle", "time": 2531.67, "timestamp": "00:42:11", "text": "午前3時30分までに終わらせる必要があります。"}, {"type": "subtitle", "time": 2538.63, "timestamp": "00:42:18", "text": "私たちは長い流れです。ええ、それは私のものになります"}, {"type": "subtitle", "time": 2542.309, "timestamp": "00:42:22", "text": "この場所での初の12時間配信。"}, {"type": "subtitle", "time": 2546.069, "timestamp": "00:42:26", "text": "でも、問題は、私があなたに私はできるということです"}, {"type": "subtitle", "time": 2548.79, "timestamp": "00:42:28", "text": "より長いストリームを実行する"}, {"type": "subtitle", "time": 2551.51, "timestamp": "00:42:31", "text": "両親の家に戻った。あの時私は"}, {"type": "subtitle", "time": 2554.069, "timestamp": "00:42:34", "text": "外に出て実際に"}, {"type": "subtitle", "time": 2555.67, "timestamp": "00:42:35", "text": "外に出てキッチンに行き、"}, {"type": "subtitle", "time": 2558.15, "timestamp": "00:42:38", "text": "お茶も淹れてくれたし、何もかもね。しかし、ここで私は"}, {"type": "subtitle", "time": 2560.15, "timestamp": "00:42:40", "text": "お茶とか何も飲めないんです。ただ"}, {"type": "subtitle", "time": 2562.39, "timestamp": "00:42:42", "text": "淡水"}, {"type": "subtitle", "time": 2565.43, "timestamp": "00:42:45", "text": "それと、ちょっとしたおやつ。それでおしまい。だから私は"}, {"type": "subtitle", "time": 2567.99, "timestamp": "00:42:47", "text": "インスタントコーヒーみたいなものを手に入れるために"}, {"type": "subtitle", "time": 2570.95, "timestamp": "00:42:50", "text": "沸騰したお湯を入れるような感じですよね？そして"}, {"type": "subtitle", "time": 2573.589, "timestamp": "00:42:53", "text": "それはあなたに"}, {"type": "subtitle", "time": 2576.309, "timestamp": "00:42:56", "text": "コーヒーみたいなやつ。私はしなければならない"}]
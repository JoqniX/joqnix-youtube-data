[{"type": "subtitle", "time": 10560.55, "timestamp": "02:56:00", "text": "ピクピクする？"}, {"type": "subtitle", "time": 10573.19, "timestamp": "02:56:13", "text": "小さな宇宙。"}, {"type": "subtitle", "time": 10575.59, "timestamp": "02:56:15", "text": "ジャック、技術的な問題が発生しているんだ"}, {"type": "subtitle", "time": 10578.87, "timestamp": "02:56:18", "text": "難易度"}, {"type": "subtitle", "time": 10582.55, "timestamp": "02:56:22", "text": "えっと、今マルチリーミング中なので。えっと"}, {"type": "subtitle", "time": 10585.11, "timestamp": "02:56:25", "text": "では、問題は何だと思いますか？"}, {"type": "subtitle", "time": 10587.51, "timestamp": "02:56:27", "text": "私のTwitchストリームはできないので"}, {"type": "subtitle", "time": 10589.269, "timestamp": "02:56:29", "text": "ない"}, {"type": "subtitle", "time": 10591.59, "timestamp": "02:56:31", "text": "えっと、Twitchでライブ配信するんだけど、まだ"}, {"type": "subtitle", "time": 10594.63, "timestamp": "02:56:34", "text": "YouTubeでライブ配信中。手伝ってくれますか？"}, {"type": "subtitle", "time": 10602.23, "timestamp": "02:56:42", "text": "ああ、これは既知の問題です。"}, {"type": "subtitle", "time": 10604.309, "timestamp": "02:56:44", "text": "ええ、私も時々そうなりますし、他の人も"}, {"type": "subtitle", "time": 10606.15, "timestamp": "02:56:46", "text": "友達が持っていて、ストリーミングするとき"}, {"type": "subtitle", "time": 10608.79, "timestamp": "02:56:48", "text": "ソフトウェアまたはOBSが突然ストリーミングできなくなった"}, {"type": "subtitle", "time": 10611.19, "timestamp": "02:56:51", "text": "Twitchはオフラインになりますが、"}, {"type": "subtitle", "time": 10613.11, "timestamp": "02:56:53", "text": "YouTubeはオンラインになります。この場合、"}, {"type": "subtitle", "time": 10615.59, "timestamp": "02:56:55", "text": "OBSを再起動するだけでこの問題は解決します"}, {"type": "subtitle", "time": 10619.83, "timestamp": "02:56:59", "text": "そして、すべてのプラットフォームでライブ配信を行う必要があります。"}]
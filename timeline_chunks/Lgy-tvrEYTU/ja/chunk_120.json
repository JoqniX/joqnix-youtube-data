[{"type": "subtitle", "time": 7215.669, "timestamp": "02:00:15", "text": "誰かがノックしているように聞こえる"}, {"type": "subtitle", "time": 7220.79, "timestamp": "02:00:20", "text": "何？"}, {"type": "subtitle", "time": 7245.589, "timestamp": "02:00:45", "text": "もしかしたらそれは私の個人的な感覚かもしれないけど、"}, {"type": "subtitle", "time": 7248.95, "timestamp": "02:00:48", "text": "たぶん、私は眠くて頭がぼーっとしていて眠いから"}, {"type": "subtitle", "time": 7250.95, "timestamp": "02:00:50", "text": "また。とにかく、これで終わりにします。"}, {"type": "subtitle", "time": 7252.95, "timestamp": "02:00:52", "text": "はい、申し訳ありませんが、"}, {"type": "subtitle", "time": 7256.95, "timestamp": "02:00:56", "text": "12時間の配信にはできなかった。"}, {"type": "subtitle", "time": 7259.189, "timestamp": "02:00:59", "text": "でも大丈夫。そうすべきだったと思う"}]
[{"type": "subtitle", "time": 12120.87, "timestamp": "03:22:00", "text": "テキスト読み上げ機能があることを確認してください"}, {"type": "subtitle", "time": 12123.19, "timestamp": "03:22:03", "text": "何か質問があれば"}, {"type": "subtitle", "time": 12127.11, "timestamp": "03:22:07", "text": "AIと直接会話できるというジョーク。わかった。"}, {"type": "subtitle", "time": 12128.87, "timestamp": "03:22:08", "text": "えっと、どのアプリを使っていますか？えーと"}, {"type": "subtitle", "time": 12131.269, "timestamp": "03:22:11", "text": "キャラクターAI"}, {"type": "subtitle", "time": 12134.07, "timestamp": "03:22:14", "text": "えっと、そこにオプションがあったのですが、"}, {"type": "subtitle", "time": 12137.349, "timestamp": "03:22:17", "text": "追加の音声を追加できます。そこで私は自分の"}, {"type": "subtitle", "time": 12139.19, "timestamp": "03:22:19", "text": "本来はそうすべきではない自分の声。私"}, {"type": "subtitle", "time": 12142.63, "timestamp": "03:22:22", "text": "削除しなければならない。でも、追加しました"}, {"type": "subtitle", "time": 12145.83, "timestamp": "03:22:25", "text": "自分の意見も加えてみました。なんだか"}, {"type": "subtitle", "time": 12147.91, "timestamp": "03:22:27", "text": "このような。"}, {"type": "subtitle", "time": 12150.389, "timestamp": "03:22:30", "text": "待って、待って、待って。"}, {"type": "subtitle", "time": 12152.229, "timestamp": "03:22:32", "text": "それを、私はただ、"}, {"type": "subtitle", "time": 12154.71, "timestamp": "03:22:34", "text": "少しだけね？それでは、これで終わりにします。"}, {"type": "subtitle", "time": 12161.75, "timestamp": "03:22:41", "text": "こんにちは、ジョー、少しだけ。どうして？私は少し"}, {"type": "subtitle", "time": 12164.71, "timestamp": "03:22:44", "text": "興味が湧いてきた。"}, {"type": "subtitle", "time": 12169.83, "timestamp": "03:22:49", "text": "「ちょっと気になる」ってどういう意味ですか？ O"}, {"type": "subtitle", "time": 12172.389, "timestamp": "03:22:52", "text": "えっと、えっと、えっと、えっと、私はただ"}, {"type": "subtitle", "time": 12175.67, "timestamp": "03:22:55", "text": "私はただあなたの声が"}, {"type": "subtitle", "time": 12179.349, "timestamp": "03:22:59", "text": "全員に聞こえた。"}]
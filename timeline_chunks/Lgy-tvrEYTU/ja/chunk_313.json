[{"type": "subtitle", "time": 18781.43, "timestamp": "05:13:01", "text": "全てを破壊してしまう可能性がある。"}, {"type": "subtitle", "time": 18784.31, "timestamp": "05:13:04", "text": "彼らはそれを取り締まることができる。"}, {"type": "subtitle", "time": 18786.948, "timestamp": "05:13:06", "text": "人々がただふざけている様子を想像してみてください"}, {"type": "subtitle", "time": 18789.91, "timestamp": "05:13:09", "text": "突然PvPが始まって、"}, {"type": "subtitle", "time": 18792.708, "timestamp": "05:13:12", "text": "大混乱が起こるだろう。"}, {"type": "subtitle", "time": 18795.27, "timestamp": "05:13:15", "text": "それはまたしても文字通り破滅させるだろう"}, {"type": "subtitle", "time": 18797.59, "timestamp": "05:13:17", "text": "源珍が全てを"}, {"type": "subtitle", "time": 18799.91, "timestamp": "05:13:19", "text": "ゲームのポイントは友達を作るようなもので、"}, {"type": "subtitle", "time": 18801.99, "timestamp": "05:13:21", "text": "右？"}, {"type": "subtitle", "time": 18803.43, "timestamp": "05:13:23", "text": "はい。"}, {"type": "subtitle", "time": 18806.23, "timestamp": "05:13:26", "text": "えーと、ところで、サムが作ってくれて"}, {"type": "subtitle", "time": 18809.67, "timestamp": "05:13:29", "text": "友達、えっと、人に許可するのは好きですか"}, {"type": "subtitle", "time": 18811.99, "timestamp": "05:13:31", "text": "あなたの世界で形になるような、"}, {"type": "subtitle", "time": 18814.31, "timestamp": "05:13:34", "text": "何でも？私は気にしない。お電話ください"}, {"type": "subtitle", "time": 18817.03, "timestamp": "05:13:37", "text": "何でもいいよ、君が好きなら"}, {"type": "chat", "time": 18820.454, "timestamp": "05:13:40", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Today's Guest - WillowMeow | https://x.com/meow_willow | https://www.youtube.com/@WillowMeow/"}, {"type": "subtitle", "time": 18822.15, "timestamp": "05:13:42", "text": "あなたの場所では、人々は形式が好きですか？えっと、私は"}, {"type": "subtitle", "time": 18824.23, "timestamp": "05:13:44", "text": "招待状を受け取ったとき、私は好きではありませんでした"}, {"type": "subtitle", "time": 18828.07, "timestamp": "05:13:48", "text": "参加リクエストのようなものですが、私は好きではありません"}, {"type": "subtitle", "time": 18831.75, "timestamp": "05:13:51", "text": "えっと、私はそれが気に入らなかっただけで、動揺したわけではありません。私"}, {"type": "subtitle", "time": 18836.07, "timestamp": "05:13:56", "text": "私が知っている人たちを動揺させてしまう。それで、えっと、私は"}, {"type": "subtitle", "time": 18839.99, "timestamp": "05:13:59", "text": "私の友達はレイドが好きだと思うし、"}]
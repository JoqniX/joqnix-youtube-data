[{"type": "subtitle", "time": 17580.948, "timestamp": "04:53:00", "text": "うん。めちゃくちゃ美味しいよ。そして"}, {"type": "subtitle", "time": 17585.19, "timestamp": "04:53:05", "text": "私はこれを楽しんでいます。うん。"}, {"type": "subtitle", "time": 17586.708, "timestamp": "04:53:06", "text": "なぜなら"}, {"type": "subtitle", "time": 17588.39, "timestamp": "04:53:08", "text": "かなり良いですよ。どこだかわからない"}, {"type": "subtitle", "time": 17590.868, "timestamp": "04:53:10", "text": "彼らは去ってしまった。彼らはまだ存在しているのか？私"}, {"type": "subtitle", "time": 17595.43, "timestamp": "04:53:15", "text": "わからないけど、私はそれらを手に入れることができなかった"}, {"type": "subtitle", "time": 17599.43, "timestamp": "04:53:19", "text": "7年間も知らないんだ。"}, {"type": "subtitle", "time": 17602.23, "timestamp": "04:53:22", "text": "そして私は好きで、ついに手に入れました"}, {"type": "subtitle", "time": 17608.948, "timestamp": "04:53:28", "text": "その周り。うん。私の近所のショッピングモールで。うんうん。"}, {"type": "subtitle", "time": 17611.27, "timestamp": "04:53:31", "text": "そして私は「一番大きいのが欲しい」と思った。"}, {"type": "subtitle", "time": 17613.67, "timestamp": "04:53:33", "text": "お願いします。"}, {"type": "subtitle", "time": 17617.43, "timestamp": "04:53:37", "text": "そして私はそれを手に入れ、正しく終わらせました"}, {"type": "subtitle", "time": 17618.948, "timestamp": "04:53:38", "text": "今。"}, {"type": "subtitle", "time": 17622.07, "timestamp": "04:53:42", "text": "お腹が空いた。私には時間がかかりました。いいえ、"}, {"type": "subtitle", "time": 17625.35, "timestamp": "04:53:45", "text": "私にとってそれは文字通り私を「えーと」"}, {"type": "subtitle", "time": 17627.59, "timestamp": "04:53:47", "text": "全部終わらせるのに文字通り1ヶ月"}, {"type": "subtitle", "time": 17630.47, "timestamp": "04:53:50", "text": "パケット。だから、あまり食べなかったんです。それ"}, {"type": "subtitle", "time": 17632.47, "timestamp": "04:53:52", "text": "それはまるで懐かしさに浸るような旅だった。"}, {"type": "subtitle", "time": 17634.868, "timestamp": "04:53:54", "text": "「ああ、お腹いっぱいだ。もう食べられない」って感じ。"}, {"type": "subtitle", "time": 17636.708, "timestamp": "04:53:56", "text": "それ。\""}]
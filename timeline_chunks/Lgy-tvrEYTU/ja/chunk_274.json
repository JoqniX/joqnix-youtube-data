[{"type": "subtitle", "time": 16440.551, "timestamp": "04:34:00", "text": "それに、簡単ではない。ジョスだと思うよ、うん、"}, {"type": "subtitle", "time": 16444.709, "timestamp": "04:34:04", "text": "大丈夫です。すべて"}, {"type": "subtitle", "time": 16456.551, "timestamp": "04:34:16", "text": "[音楽]"}, {"type": "subtitle", "time": 16460.39, "timestamp": "04:34:20", "text": "私はあなたに少し待ってもらいました。あぁ、えーと、"}, {"type": "subtitle", "time": 16464.23, "timestamp": "04:34:24", "text": "見て。私はただ、あなたに"}, {"type": "subtitle", "time": 16467.83, "timestamp": "04:34:27", "text": "それは何と呼ばれますか？ドクロのピンバッジ。"}, {"type": "subtitle", "time": 16471.51, "timestamp": "04:34:31", "text": "あなたに"}, {"type": "subtitle", "time": 16475.029, "timestamp": "04:34:35", "text": "やったね、君はやり遂げたんだ。うん。えーと、VTub えーと"}, {"type": "subtitle", "time": 16477.189, "timestamp": "04:34:37", "text": "あれ。"}, {"type": "subtitle", "time": 16480.709, "timestamp": "04:34:40", "text": "なぜ牛なのか？"}, {"type": "subtitle", "time": 16483.59, "timestamp": "04:34:43", "text": "ああ、もしあなたがただ開けるなら"}, {"type": "subtitle", "time": 16487.429, "timestamp": "04:34:47", "text": "ストリームのやつ、えっと、見ることができます。なんてこった。"}, {"type": "subtitle", "time": 16489.269, "timestamp": "04:34:49", "text": "何もしないで"}, {"type": "subtitle", "time": 16490.789, "timestamp": "04:34:50", "text": "私にとって恥ずかしいことだ。ただ私に"}, {"type": "subtitle", "time": 16492.629, "timestamp": "04:34:52", "text": "2番。"}, {"type": "subtitle", "time": 16496.23, "timestamp": "04:34:56", "text": "いやいや、君にはすごく似合ってるよ。ただ"}]
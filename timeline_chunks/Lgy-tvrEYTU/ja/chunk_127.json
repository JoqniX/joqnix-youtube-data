[{"type": "subtitle", "time": 7623.669, "timestamp": "02:07:03", "text": "さて、今日はこれで終わりにします。わかった。"}, {"type": "subtitle", "time": 7626.47, "timestamp": "02:07:06", "text": "一緒に遊んでくれた皆さん、ありがとうございました。"}, {"type": "subtitle", "time": 7629.109, "timestamp": "02:07:09", "text": "それは、えっと"}, {"type": "subtitle", "time": 7631.91, "timestamp": "02:07:11", "text": "肉で遊ぶ"}, {"type": "subtitle", "time": 7634.629, "timestamp": "02:07:14", "text": "えっと、私と一緒にいて、私とチャットして"}, {"type": "subtitle", "time": 7637.83, "timestamp": "02:07:17", "text": "もの。ありがとう。私は大きなストリームで"}, {"type": "subtitle", "time": 7640.069, "timestamp": "02:07:20", "text": "良い。とても楽しかったです。ありがとうございます"}, {"type": "subtitle", "time": 7642.87, "timestamp": "02:07:22", "text": "今行くよ。まるで"}, {"type": "subtitle", "time": 7645.75, "timestamp": "02:07:25", "text": "長い間は本当に良い機会でした"}, {"type": "subtitle", "time": 7647.669, "timestamp": "02:07:27", "text": "話すことのように。"}, {"type": "subtitle", "time": 7650.31, "timestamp": "02:07:30", "text": "楽しかったです。ありがとう。そして、"}, {"type": "subtitle", "time": 7652.39, "timestamp": "02:07:32", "text": "考えてみて、私たちはこれまで一度もそういう経験をしたことがない。いいえ、"}, {"type": "subtitle", "time": 7655.51, "timestamp": "02:07:35", "text": "私たちはそうしました。 1、2回は思うけど、"}, {"type": "subtitle", "time": 7659.27, "timestamp": "02:07:39", "text": "私たちは普段あまり話さないけれど、楽しかった。私"}, {"type": "subtitle", "time": 7661.43, "timestamp": "02:07:41", "text": "あなたと協力できることを楽しみにしています"}, {"type": "subtitle", "time": 7663.589, "timestamp": "02:07:43", "text": "一日をきちんと過ごす。"}, {"type": "subtitle", "time": 7674.629, "timestamp": "02:07:54", "text": "そして私たちはズチと一緒に練習しました"}, {"type": "subtitle", "time": 7676.87, "timestamp": "02:07:56", "text": "そして禅。"}]
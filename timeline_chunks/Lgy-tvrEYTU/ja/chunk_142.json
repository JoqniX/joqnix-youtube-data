[{"type": "subtitle", "time": 8523.99, "timestamp": "02:22:03", "text": "この男は「ピープス」と言った。この男は言った"}, {"type": "subtitle", "time": 8527.349, "timestamp": "02:22:07", "text": "みんな。それは私が一度も使ったことのない言葉です。"}, {"type": "subtitle", "time": 8530.55, "timestamp": "02:22:10", "text": "それはハジから聞いた話で、"}, {"type": "subtitle", "time": 8532.79, "timestamp": "02:22:12", "text": "いつも「ピープス」と言う。チャットでみんなと"}, {"type": "subtitle", "time": 8536.95, "timestamp": "02:22:16", "text": "私は彼からその言葉を教わりました。"}, {"type": "subtitle", "time": 8540.71, "timestamp": "02:22:20", "text": "そして彼はこのジョークを既に使っている。"}, {"type": "subtitle", "time": 8542.23, "timestamp": "02:22:22", "text": "何？"}, {"type": "subtitle", "time": 8550.309, "timestamp": "02:22:30", "text": "ああ、それはすごくクールだね。面白い。"}, {"type": "subtitle", "time": 8552.07, "timestamp": "02:22:32", "text": "えっと、"}, {"type": "subtitle", "time": 8555.67, "timestamp": "02:22:35", "text": "どんな活動が"}, {"type": "subtitle", "time": 8562.55, "timestamp": "02:22:42", "text": "ほとんどは雰囲気と笑い声だけ。その"}, {"type": "subtitle", "time": 8564.23, "timestamp": "02:22:44", "text": "素晴らしい"}, {"type": "subtitle", "time": 8567.429, "timestamp": "02:22:47", "text": "一緒にリラックスして楽しめる人たち。"}, {"type": "subtitle", "time": 8575.75, "timestamp": "02:22:55", "text": "えっと、BPLって何ですか？詳しく説明していただけますか？"}, {"type": "subtitle", "time": 8578.389, "timestamp": "02:22:58", "text": "それについて？"}]
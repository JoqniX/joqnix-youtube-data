[{"type": "subtitle", "time": 12841.51, "timestamp": "03:34:01", "text": "だって、しばらく水分補給してないんだもん"}, {"type": "subtitle", "time": 12844.469, "timestamp": "03:34:04", "text": "えっと、1時間くらいかな。私はまだ"}, {"type": "subtitle", "time": 12851.91, "timestamp": "03:34:11", "text": "はい、戻ってきました。"}, {"type": "subtitle", "time": 12855.83, "timestamp": "03:34:15", "text": "こんにちは、おかえりなさい。戻る。"}, {"type": "subtitle", "time": 12859.269, "timestamp": "03:34:19", "text": "母が私の部屋にいる。大丈夫です。"}, {"type": "subtitle", "time": 12861.75, "timestamp": "03:34:21", "text": "腕は大したことないんだけど、"}, {"type": "subtitle", "time": 12864.63, "timestamp": "03:34:24", "text": "英語で話すのはちょっと恥ずかしい"}, {"type": "subtitle", "time": 12866.469, "timestamp": "03:34:26", "text": "彼女の前で。彼女はおそらく"}, {"type": "subtitle", "time": 12868.71, "timestamp": "03:34:28", "text": "まるで私を見ている"}, {"type": "subtitle", "time": 12872.469, "timestamp": "03:34:32", "text": "邪悪な悪魔。それはまるで"}, {"type": "subtitle", "time": 12882.309, "timestamp": "03:34:42", "text": "私は誰を呼び出してしまったのか？私は誰を召喚したのか"}, {"type": "subtitle", "time": 12886.87, "timestamp": "03:34:46", "text": "これに基づいて？吸血鬼"}, {"type": "subtitle", "time": 12890.79, "timestamp": "03:34:50", "text": "祖母が私の部屋にいます。私の祖母の"}, {"type": "subtitle", "time": 12893.67, "timestamp": "03:34:53", "text": "私の"}, {"type": "subtitle", "time": 12895.99, "timestamp": "03:34:55", "text": "私は一般的にミュートが好きです"}, {"type": "subtitle", "time": 12898.389, "timestamp": "03:34:58", "text": "彼女が話し始めたからだ。それはまるで、"}, {"type": "subtitle", "time": 12899.83, "timestamp": "03:34:59", "text": "わかった、彼女がミュートする必要がある"}]
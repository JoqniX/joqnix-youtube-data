[{"type": "subtitle", "time": 7441.91, "timestamp": "02:04:01", "text": "ワイヤレスキーボードについて。そして私は"}, {"type": "subtitle", "time": 7444.47, "timestamp": "02:04:04", "text": "知る。"}, {"type": "subtitle", "time": 7448.95, "timestamp": "02:04:08", "text": "現状のままで良いと思います。私はただ"}, {"type": "subtitle", "time": 7452.31, "timestamp": "02:04:12", "text": "トーナメントのために。古いものを使うよ"}, {"type": "subtitle", "time": 7453.99, "timestamp": "02:04:13", "text": "ねずみ。"}, {"type": "subtitle", "time": 7456.149, "timestamp": "02:04:16", "text": "私は何をするだろうか"}, {"type": "subtitle", "time": 7463.43, "timestamp": "02:04:23", "text": "古いマウスを使います。"}, {"type": "subtitle", "time": 7473.109, "timestamp": "02:04:33", "text": "キーボードの外側を使ってタイプします"}, {"type": "subtitle", "time": 7477.189, "timestamp": "02:04:37", "text": "それ。大丈夫です。貯金して買います"}, {"type": "subtitle", "time": 7482.79, "timestamp": "02:04:42", "text": "43001で見たあのキーボード。"}, {"type": "subtitle", "time": 7485.91, "timestamp": "02:04:45", "text": "お金を貯めてそれを買うよ。わかった。"}, {"type": "subtitle", "time": 7488.31, "timestamp": "02:04:48", "text": "うん。"}, {"type": "subtitle", "time": 7493.589, "timestamp": "02:04:53", "text": "そこから色々なことができる。は"}, {"type": "subtitle", "time": 7495.669, "timestamp": "02:04:55", "text": "のように"}, {"type": "subtitle", "time": 7497.43, "timestamp": "02:04:57", "text": "もう月の半ばだし、"}]
[{"type": "subtitle", "time": 6902.07, "timestamp": "01:55:02", "text": "スポット。"}, {"type": "subtitle", "time": 6915.27, "timestamp": "01:55:15", "text": "ステージなし。"}, {"type": "subtitle", "time": 6917.669, "timestamp": "01:55:17", "text": "さあ、楽しみが始まるぞ。"}, {"type": "subtitle", "time": 6939.669, "timestamp": "01:55:39", "text": "彼らは私の電線を見つけた。再装填中。"}]
[{"type": "subtitle", "time": 2764.309, "timestamp": "00:46:04", "text": "前回の配信から24時間経過。うん。"}, {"type": "subtitle", "time": 2767.109, "timestamp": "00:46:07", "text": "そして問題は"}, {"type": "subtitle", "time": 2769.829, "timestamp": "00:46:09", "text": "他の人たちにとっては、彼らはヴァロールをプレイしている"}, {"type": "subtitle", "time": 2773.27, "timestamp": "00:46:13", "text": "ただし、ヴァレラントに新しく参加したゼンは例外です。"}, {"type": "subtitle", "time": 2780.15, "timestamp": "00:46:20", "text": "キーボードに慣れていないので、"}, {"type": "subtitle", "time": 2781.91, "timestamp": "00:46:21", "text": "今日新しいキーボードが使えるようになった"}, {"type": "subtitle", "time": 2784.55, "timestamp": "00:46:24", "text": "右。だから私は慣れていない"}, {"type": "subtitle", "time": 2787.43, "timestamp": "00:46:27", "text": "キーボード。それに加えてマウスも。これは"}, {"type": "subtitle", "time": 2790.069, "timestamp": "00:46:30", "text": "マウスとの2日目。"}, {"type": "subtitle", "time": 2792.39, "timestamp": "00:46:32", "text": "私がマラリンを演じているところ。 2日目は"}, {"type": "subtitle", "time": 2801.829, "timestamp": "00:46:41", "text": "だから、これに慣れる必要がある。"}, {"type": "subtitle", "time": 2809.829, "timestamp": "00:46:49", "text": "私は何が起こるか知っています"}, {"type": "subtitle", "time": 2812.47, "timestamp": "00:46:52", "text": "トーナメント。"}, {"type": "subtitle", "time": 2815.27, "timestamp": "00:46:55", "text": "私はその感覚に慣れている"}, {"type": "subtitle", "time": 2818.15, "timestamp": "00:46:58", "text": "だって、これは私にとって2回目みたいなものだから"}]
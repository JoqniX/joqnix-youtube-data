[{"type": "subtitle", "time": 14700.469, "timestamp": "04:05:00", "text": "それはそういう仕組みではない。"}, {"type": "subtitle", "time": 14704.07, "timestamp": "04:05:04", "text": "ヌバスがポテトチップスを食べている。どのような種類の"}, {"type": "subtitle", "time": 14707.67, "timestamp": "04:05:07", "text": "ポテトチップスを食べてるの？ナス。"}, {"type": "subtitle", "time": 14726.15, "timestamp": "04:05:26", "text": "[音楽]"}, {"type": "subtitle", "time": 14729.75, "timestamp": "04:05:29", "text": "私は私たちにパンをあげました、えっと、あなたは"}, {"type": "subtitle", "time": 14733.03, "timestamp": "04:05:33", "text": "セブンボウルと呼ぶ"}, {"type": "subtitle", "time": 14736.79, "timestamp": "04:05:36", "text": "そして、なんて言うんだっけ？ボウル"}, {"type": "subtitle", "time": 14740.87, "timestamp": "04:05:40", "text": "私たちが好んで飲むための水。私はしませんでした"}, {"type": "subtitle", "time": 14743.83, "timestamp": "04:05:43", "text": "テーブルはまだないので、"}, {"type": "subtitle", "time": 14758.11, "timestamp": "04:05:58", "text": "待って、私は"}]
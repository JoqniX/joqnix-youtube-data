[{"type": "subtitle", "time": 4561.03, "timestamp": "01:16:01", "text": "タイプライターのキーボード、"}, {"type": "subtitle", "time": 4562.95, "timestamp": "01:16:02", "text": "私はマウスを使うことができません"}, {"type": "subtitle", "time": 4571.83, "timestamp": "01:16:11", "text": "そして、もし私が以前のものに戻るなら、"}, {"type": "subtitle", "time": 4577.669, "timestamp": "01:16:17", "text": "私はキーボードのキーを"}, {"type": "subtitle", "time": 4593.27, "timestamp": "01:16:33", "text": "私はそうは思わない"}, {"type": "subtitle", "time": 4610.63, "timestamp": "01:16:50", "text": "わかりました、では別の方法でやってみましょう。"}]
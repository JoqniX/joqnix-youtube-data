[{"type": "subtitle", "time": 18662.55, "timestamp": "05:11:02", "text": "溶けてもなお。たとえ溶けても。"}, {"type": "subtitle", "time": 18665.59, "timestamp": "05:11:05", "text": "溶けても構わないと思う。たとえ"}, {"type": "subtitle", "time": 18668.628, "timestamp": "05:11:08", "text": "オオカミ オオカミの剣のようなもの"}, {"type": "subtitle", "time": 18671.59, "timestamp": "05:11:11", "text": "灰色のように"}, {"type": "subtitle", "time": 18676.868, "timestamp": "05:11:16", "text": "レーザーレーザーウルフソードみたいなもの。"}, {"type": "subtitle", "time": 18679.35, "timestamp": "05:11:19", "text": "ドゥークー伯爵でさえ、ドゥークーの剣を持っていても。"}, {"type": "subtitle", "time": 18684.15, "timestamp": "05:11:24", "text": "彼は10kmしか走らない。ああ、神様"}, {"type": "subtitle", "time": 18686.39, "timestamp": "05:11:26", "text": "あなたは何も与えていない"}, {"type": "subtitle", "time": 18688.868, "timestamp": "05:11:28", "text": "自分。あなたをどうしたらいいの？"}, {"type": "subtitle", "time": 18691.59, "timestamp": "05:11:31", "text": "それが、見た目を重視する唯一の理由です。"}, {"type": "subtitle", "time": 18693.35, "timestamp": "05:11:33", "text": "まるで彼はただ、それはただ"}, {"type": "subtitle", "time": 18695.75, "timestamp": "05:11:35", "text": "材料の無駄遣いが多すぎるので、"}, {"type": "subtitle", "time": 18698.15, "timestamp": "05:11:38", "text": "困惑した。うん。"}, {"type": "subtitle", "time": 18701.03, "timestamp": "05:11:41", "text": "あと、ええ、そうですね。こんにちは、ミマ。いらっしゃいませ。"}, {"type": "subtitle", "time": 18702.878, "timestamp": "05:11:42", "text": "いらっしゃいませ。 いらっしゃいませ。うん。こんにちは。"}, {"type": "subtitle", "time": 18705.76, "timestamp": "05:11:45", "text": "いらっしゃいませ。うん。こんにちは。 好きだったかな 好きだったかな スタート"}, {"type": "subtitle", "time": 18708.32, "timestamp": "05:11:48", "text": "好きだったかな 好きだったかな スタート チャットで議論？人々は"}, {"type": "subtitle", "time": 18710.4, "timestamp": "05:11:50", "text": "チャットで議論？人々は 今もそうです。"}, {"type": "subtitle", "time": 18713.28, "timestamp": "05:11:53", "text": "今もそうです。 いいえ、彼らはただ私たちの話を聞いているだけです。うん。"}, {"type": "subtitle", "time": 18716.798, "timestamp": "05:11:56", "text": "いいえ、彼らはただ私たちの話を聞いているだけです。うん。 人々はただ笑うだけだ。ああ、なんてことだ、これらは"}, {"type": "subtitle", "time": 18718.638, "timestamp": "05:11:58", "text": "人々はただ笑うだけだ。ああ、なんてことだ、これらは このバカなオタクどもは、"}]
[{"type": "subtitle", "time": 4743.51, "timestamp": "01:19:03", "text": "待てよ、両方とも同じじゃないか。何？"}, {"type": "subtitle", "time": 4747.11, "timestamp": "01:19:07", "text": "メカニカルキーボードを接続する必要があります"}, {"type": "subtitle", "time": 4748.95, "timestamp": "01:19:08", "text": "前面用。待って、これも"}, {"type": "subtitle", "time": 4757.35, "timestamp": "01:19:17", "text": "ええ、それ用のソフトウェアがありますよ。我々は持っていた"}, {"type": "subtitle", "time": 4760.47, "timestamp": "01:19:20", "text": "もう5年間更新を続けています。私の"}, {"type": "subtitle", "time": 4762.55, "timestamp": "01:19:22", "text": "待って。"}, {"type": "subtitle", "time": 4770.55, "timestamp": "01:19:30", "text": "しばらくの間はそうだったよね？うん。"}, {"type": "subtitle", "time": 4780.31, "timestamp": "01:19:40", "text": "待って、なぜ？"}, {"type": "subtitle", "time": 4789.74, "timestamp": "01:19:49", "text": "これはやり過ぎだ。"}, {"type": "subtitle", "time": 4795.51, "timestamp": "01:19:55", "text": "彼はこう言う、そしてフェニックスはこう言う、何"}]
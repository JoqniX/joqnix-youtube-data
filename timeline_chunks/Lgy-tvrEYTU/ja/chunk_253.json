[{"type": "subtitle", "time": 15180.149, "timestamp": "04:13:00", "text": "ああ、あのね？私はこれをできますが、"}, {"type": "subtitle", "time": 15181.91, "timestamp": "04:13:01", "text": "何も話さないだろうし、全てを話さないだろう。だから、"}, {"type": "subtitle", "time": 15184.79, "timestamp": "04:13:04", "text": "ちょっと待ってください。ああ、わかった。待って、何？"}, {"type": "subtitle", "time": 15187.269, "timestamp": "04:13:07", "text": "もう一度やるべきかな？待って、あなたが私に送る"}, {"type": "subtitle", "time": 15193.75, "timestamp": "04:13:13", "text": "[音楽]"}, {"type": "subtitle", "time": 15196.389, "timestamp": "04:13:16", "text": "はい、それは"}, {"type": "subtitle", "time": 15198.229, "timestamp": "04:13:18", "text": "えーと"}, {"type": "subtitle", "time": 15200.87, "timestamp": "04:13:20", "text": "言葉"}, {"type": "subtitle", "time": 15204.149, "timestamp": "04:13:24", "text": "そしてタニ。ああ、そう、それも"}, {"type": "subtitle", "time": 15213.269, "timestamp": "04:13:33", "text": "待って、藤くん、君は両方の言語を知っているの？"}, {"type": "subtitle", "time": 15215.349, "timestamp": "04:13:35", "text": "ナニ。"}, {"type": "subtitle", "time": 15230.55, "timestamp": "04:13:50", "text": "誰ですか？うん。"}, {"type": "subtitle", "time": 15232.79, "timestamp": "04:13:52", "text": "ところで、えーと、ジャック、君はえーと"}, {"type": "subtitle", "time": 15235.51, "timestamp": "04:13:55", "text": "大学とか、君はただ"}, {"type": "subtitle", "time": 15238.309, "timestamp": "04:13:58", "text": "学校は卒業したんだよね？ああ、終わったよ"}]
[{"type": "subtitle", "time": 4201.669, "timestamp": "01:10:01", "text": "デスクにケーブルを置かなくて済む方法みたいなもの"}, {"type": "subtitle", "time": 4204.79, "timestamp": "01:10:04", "text": "だから私はできる。これは長いマウスパッドです。私"}, {"type": "subtitle", "time": 4207.35, "timestamp": "01:10:07", "text": "マウスの端に行きたかった"}, {"type": "subtitle", "time": 4209.51, "timestamp": "01:10:09", "text": "パッドとキーボードはそのままにして、"}, {"type": "subtitle", "time": 4213.27, "timestamp": "01:10:13", "text": "手で他の端をミッドや"}, {"type": "subtitle", "time": 4216.07, "timestamp": "01:10:16", "text": "中央と右側で"}, {"type": "subtitle", "time": 4218.07, "timestamp": "01:10:18", "text": "マウスを使ってドラッグなどを行う。しかし、"}, {"type": "subtitle", "time": 4220.07, "timestamp": "01:10:20", "text": "覚えてるよ、うん、私は高い感覚を持ってる、"}, {"type": "subtitle", "time": 4222.31, "timestamp": "01:10:22", "text": "でもマウスをドラッグする必要はありません"}, {"type": "subtitle", "time": 4224.55, "timestamp": "01:10:24", "text": "もはや低い感覚だ。"}, {"type": "subtitle", "time": 4227.99, "timestamp": "01:10:27", "text": "昔のように。そうすれば物を置くことができます"}, {"type": "subtitle", "time": 4244.47, "timestamp": "01:10:44", "text": "一致する結果が見つかりました。"}, {"type": "subtitle", "time": 4249.99, "timestamp": "01:10:49", "text": "プレイしたらどんな感じだろう"}, {"type": "subtitle", "time": 4253.43, "timestamp": "01:10:53", "text": "私は一流チームを作ってゲームをしました。"}, {"type": "subtitle", "time": 4257.59, "timestamp": "01:10:57", "text": "以前は夏ファミリア"}]
[{"type": "subtitle", "time": 16981.43, "timestamp": "04:43:01", "text": "推測。ええ、でも実際はそうでもないんです。私はできません"}, {"type": "subtitle", "time": 16983.67, "timestamp": "04:43:03", "text": "繰り返しますが、彼女には強化要素はないと思います。"}, {"type": "subtitle", "time": 16986.628, "timestamp": "04:43:06", "text": "彼女は私たちに何のボーナスもくれない"}, {"type": "subtitle", "time": 16989.75, "timestamp": "04:43:09", "text": "その上にあるもの。そうですね、そう思います"}, {"type": "subtitle", "time": 16993.67, "timestamp": "04:43:13", "text": "彼女はただの冷凍保存された存在だ。でももし私が"}, {"type": "subtitle", "time": 16997.91, "timestamp": "04:43:17", "text": "すごく退屈なので、"}, {"type": "subtitle", "time": 16999.87, "timestamp": "04:43:19", "text": "合金。"}, {"type": "subtitle", "time": 17001.43, "timestamp": "04:43:21", "text": "[音楽]"}, {"type": "subtitle", "time": 17004.07, "timestamp": "04:43:24", "text": "もし私が「私はすべてを構築し、"}, {"type": "subtitle", "time": 17006.868, "timestamp": "04:43:26", "text": "これは私ができない唯一の人です"}, {"type": "subtitle", "time": 17009.11, "timestamp": "04:43:29", "text": "面倒くさい。今私はとても"}, {"type": "subtitle", "time": 17012.868, "timestamp": "04:43:32", "text": "私のチームには弓使いがたくさんいますが、"}, {"type": "subtitle", "time": 17016.39, "timestamp": "04:43:36", "text": "とてもとても印象的です。なぜなら今私は"}, {"type": "subtitle", "time": 17019.27, "timestamp": "04:43:39", "text": "槍使い1名、剣使い1名"}, {"type": "subtitle", "time": 17022.15, "timestamp": "04:43:42", "text": "それはキッシングで、それから私は2つ持っています"}, {"type": "subtitle", "time": 17025.19, "timestamp": "04:43:45", "text": "それはユミアと子供のようなもので、"}, {"type": "subtitle", "time": 17027.03, "timestamp": "04:43:47", "text": "非常に印象的だったのは、"}, {"type": "subtitle", "time": 17031.83, "timestamp": "04:43:51", "text": "弓。私は弓を使うのが嫌いだった"}, {"type": "subtitle", "time": 17033.99, "timestamp": "04:43:53", "text": "期間、モバイルを使用しているため"}, {"type": "subtitle", "time": 17037.75, "timestamp": "04:43:57", "text": "まるで、それを使って何もできないかのように。 H."}]
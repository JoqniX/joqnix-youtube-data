[{"type": "subtitle", "time": 18842.07, "timestamp": "05:14:02", "text": "他の人たちは、"}, {"type": "subtitle", "time": 18845.43, "timestamp": "05:14:05", "text": "魚たち。だから、彼らに任せることにする"}, {"type": "subtitle", "time": 18847.67, "timestamp": "05:14:07", "text": "ああ、釣り要素がある"}, {"type": "subtitle", "time": 18851.99, "timestamp": "05:14:11", "text": "ゲーム。ああ、そうそう、釣りね。うん、"}, {"type": "subtitle", "time": 18855.19, "timestamp": "05:14:15", "text": "忘れていました。"}, {"type": "subtitle", "time": 18858.07, "timestamp": "05:14:18", "text": "私はそうしません 私はそうしません 私は一般的にそうしません"}, {"type": "subtitle", "time": 18869.43, "timestamp": "05:14:29", "text": "えーっと、みなさんこんにちは。こんにちは、こんにちは、こんにちは。"}, {"type": "subtitle", "time": 18872.15, "timestamp": "05:14:32", "text": "久しぶりですね。えっと、すみません"}, {"type": "subtitle", "time": 18874.628, "timestamp": "05:14:34", "text": "午前中ずっと姿を見せなかったから。私は"}, {"type": "subtitle", "time": 18878.23, "timestamp": "05:14:38", "text": "ちょっと具合が悪そうで、"}, {"type": "subtitle", "time": 18881.19, "timestamp": "05:14:41", "text": "ちょっとした、えーと、直前の変更"}, {"type": "subtitle", "time": 18885.83, "timestamp": "05:14:45", "text": "今日のコラボゲストと、えっと、私は"}, {"type": "subtitle", "time": 18888.23, "timestamp": "05:14:48", "text": "眠ってしまったか、できなかった"}, {"type": "subtitle", "time": 18890.788, "timestamp": "05:14:50", "text": "最初に延期されるもの"}, {"type": "subtitle", "time": 18893.91, "timestamp": "05:14:53", "text": "その日の最後のコラボレーションは夜に行われました。"}, {"type": "subtitle", "time": 18897.43, "timestamp": "05:14:57", "text": "ええと、現在ここにはウィローがいます。"}]
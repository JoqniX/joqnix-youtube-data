[{"type": "subtitle", "time": 19200.948, "timestamp": "05:20:00", "text": "それを持ち上げる。何てことだ。どちらも悪い。"}, {"type": "subtitle", "time": 19203.67, "timestamp": "05:20:03", "text": "猫の繁殖速度が速すぎる。犬を増やす"}, {"type": "subtitle", "time": 19205.43, "timestamp": "05:20:05", "text": "しかも速い。でも少なくとも彼らはいつも"}, {"type": "subtitle", "time": 19211.51, "timestamp": "05:20:11", "text": "[音楽]"}, {"type": "subtitle", "time": 19213.11, "timestamp": "05:20:13", "text": "どちらも悪い。おそらく最善の策は"}, {"type": "subtitle", "time": 19221.75, "timestamp": "05:20:21", "text": "あなたはハムスターが好きですか？"}, {"type": "subtitle", "time": 19223.59, "timestamp": "05:20:23", "text": "いいえ、私はハムスターが好きではありません。彼らは"}, {"type": "subtitle", "time": 19225.35, "timestamp": "05:20:25", "text": "基本的にはネズミですよね？そして彼らはただ"}, {"type": "subtitle", "time": 19228.868, "timestamp": "05:20:28", "text": "彼らは1年間生き、その後死ぬ。ああ、"}, {"type": "subtitle", "time": 19233.43, "timestamp": "05:20:33", "text": "ああ、それは知らなかった。何？"}, {"type": "subtitle", "time": 19241.03, "timestamp": "05:20:41", "text": "ハムスター用ライトバンド。まるで"}, {"type": "subtitle", "time": 19247.27, "timestamp": "05:20:47", "text": "うん。だから、彼らは"}, {"type": "subtitle", "time": 19249.43, "timestamp": "05:20:49", "text": "幼児のペットは、おそらく"}, {"type": "subtitle", "time": 19251.67, "timestamp": "05:20:51", "text": "あなたのハムのことは覚えていないでしょう。そうそう。私は持っていた"}, {"type": "subtitle", "time": 19253.27, "timestamp": "05:20:53", "text": "ハムスター。"}]
[{"type": "subtitle", "time": 8762.87, "timestamp": "02:26:02", "text": "えっと、誰かに何て言うかな"}, {"type": "subtitle", "time": 8765.67, "timestamp": "02:26:05", "text": "えっと、誰？"}, {"type": "subtitle", "time": 8769.91, "timestamp": "02:26:09", "text": "えーと、友達を作りたい人"}, {"type": "subtitle", "time": 8773.03, "timestamp": "02:26:13", "text": "あなたと？"}, {"type": "subtitle", "time": 8775.27, "timestamp": "02:26:15", "text": "そうですね、私が言いたいのは"}, {"type": "subtitle", "time": 8777.91, "timestamp": "02:26:17", "text": "自分らしく振る舞い、人々に近づいて"}, {"type": "subtitle", "time": 8779.99, "timestamp": "02:26:19", "text": "チャットしてゆっくりと絆を築き始めるか"}, {"type": "subtitle", "time": 8782.389, "timestamp": "02:26:22", "text": "彼らとの友情。インターネットは"}, {"type": "subtitle", "time": 8785.19, "timestamp": "02:26:25", "text": "広大で、PL（製品ライン）も豊富です。だから、"}, {"type": "subtitle", "time": 8787.03, "timestamp": "02:26:27", "text": "良い人もいれば、悪い人もいる。"}, {"type": "subtitle", "time": 8789.59, "timestamp": "02:26:29", "text": "そして、Hを見つけるのはあなた次第です。"}, {"type": "subtitle", "time": 8791.51, "timestamp": "02:26:31", "text": "なりたい人に何て言うか"}, {"type": "subtitle", "time": 8794.23, "timestamp": "02:26:34", "text": "私の友人？誰もがいつも"}, {"type": "subtitle", "time": 8796.23, "timestamp": "02:26:36", "text": "私に会いに来て、私の"}, {"type": "subtitle", "time": 8798.71, "timestamp": "02:26:38", "text": "親切な限り友達、"}, {"type": "subtitle", "time": 8800.95, "timestamp": "02:26:40", "text": "健全で、それなりに楽しい。"}, {"type": "subtitle", "time": 8807.27, "timestamp": "02:26:47", "text": "[音楽]"}, {"type": "subtitle", "time": 8810.95, "timestamp": "02:26:50", "text": "何？何？何を聞いているんだ？"}, {"type": "subtitle", "time": 8815.03, "timestamp": "02:26:55", "text": "何が起こっているの？何？"}]
[{"type": "subtitle", "time": 3421.51, "timestamp": "00:57:01", "text": "7月10日に注文しました。今日は"}, {"type": "subtitle", "time": 3424.23, "timestamp": "00:57:04", "text": "16日。"}, {"type": "subtitle", "time": 3429.03, "timestamp": "00:57:09", "text": "私はそれを着ました"}, {"type": "subtitle", "time": 3432.549, "timestamp": "00:57:12", "text": "一昨日届きました"}, {"type": "subtitle", "time": 3435.589, "timestamp": "00:57:15", "text": "そして、交換作業を行いました。その"}, {"type": "subtitle", "time": 3438.23, "timestamp": "00:57:18", "text": "7月13日に来る予定です。それは"}, {"type": "subtitle", "time": 3440.789, "timestamp": "00:57:20", "text": "明日。ああ、そうそう、私は"}, {"type": "subtitle", "time": 3444.39, "timestamp": "00:57:24", "text": "7月13日に交代。つまり、"}, {"type": "subtitle", "time": 3446.87, "timestamp": "00:57:26", "text": "私がそれを手に入れた日。同じ日に私は"}, {"type": "subtitle", "time": 3449.589, "timestamp": "00:57:29", "text": "交換。それで10日に注文しました"}, {"type": "subtitle", "time": 3451.51, "timestamp": "00:57:31", "text": "わかった。"}, {"type": "subtitle", "time": 3454.069, "timestamp": "00:57:34", "text": "7日間ポリシー。待つ必要はありません。確認してみます。させて"}, {"type": "subtitle", "time": 3457.67, "timestamp": "00:57:37", "text": "確認します。確認してみます。"}, {"type": "subtitle", "time": 3460.23, "timestamp": "00:57:40", "text": "ただし、7日間の交換保証付きです。そうではありません"}, {"type": "subtitle", "time": 3471.43, "timestamp": "00:57:51", "text": "待って、戻ってきてくれる？待って、戻って、"}, {"type": "subtitle", "time": 3478.63, "timestamp": "00:57:58", "text": "払い戻し金は回収されます。待って、いや、"}]
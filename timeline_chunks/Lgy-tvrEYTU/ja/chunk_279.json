[{"type": "subtitle", "time": 16745.99, "timestamp": "04:39:05", "text": "おい。えっと"}, {"type": "subtitle", "time": 16748.629, "timestamp": "04:39:08", "text": "待って。他にどんなゲームをプレイしましたか？"}, {"type": "subtitle", "time": 16754.869, "timestamp": "04:39:14", "text": "最近の私とか、ゲームとか"}, {"type": "subtitle", "time": 16760.07, "timestamp": "04:39:20", "text": "最近は時代劇をやっていて、どちらも好きです"}, {"type": "subtitle", "time": 16762.629, "timestamp": "04:39:22", "text": "最近では、原神とコールオブデューティモバイル"}, {"type": "subtitle", "time": 16765.029, "timestamp": "04:39:25", "text": "私は携帯電話しか持っていないので"}, {"type": "subtitle", "time": 16768.869, "timestamp": "04:39:28", "text": "だいたいそんな感じです。うん。コールオブデューティ"}, {"type": "subtitle", "time": 16771.109, "timestamp": "04:39:31", "text": "まったく。時々私はただ"}, {"type": "subtitle", "time": 16774.47, "timestamp": "04:39:34", "text": "ログイン報酬だと思うけど、ゲンチン"}, {"type": "subtitle", "time": 16780.07, "timestamp": "04:39:40", "text": "ええ、やりますよ。うんうん。おい。おい、ゲンシン。"}, {"type": "subtitle", "time": 16783.03, "timestamp": "04:39:43", "text": "源珍では良いことは何も起きていない。私"}, {"type": "subtitle", "time": 16784.868, "timestamp": "04:39:44", "text": "良いものは終わったと思う"}, {"type": "subtitle", "time": 16787.19, "timestamp": "04:39:47", "text": "げんちん。だから、私には何もすることがない"}, {"type": "subtitle", "time": 16790.31, "timestamp": "04:39:50", "text": "そこには。私はイベントしか持っていません"}, {"type": "subtitle", "time": 16792.708, "timestamp": "04:39:52", "text": "時々良い。時々彼らは行くのが好きです"}, {"type": "subtitle", "time": 16795.99, "timestamp": "04:39:55", "text": "物語とか、何でもいいんだけど。彼らのほとんど"}, {"type": "subtitle", "time": 16799.11, "timestamp": "04:39:59", "text": "私は何人かの人を殴りに行くつもりです"}]
[{"type": "subtitle", "time": 14101.99, "timestamp": "03:55:01", "text": "初日は解剖学の授業だった。その"}, {"type": "subtitle", "time": 14106.469, "timestamp": "03:55:06", "text": "とても面白い。えーと、彼らが、えーと手に入れるとき"}, {"type": "subtitle", "time": 14108.79, "timestamp": "03:55:08", "text": "彼らが通常示すように"}, {"type": "subtitle", "time": 14111.11, "timestamp": "03:55:11", "text": "カダヴと一緒に。人々が考えるとき"}, {"type": "subtitle", "time": 14114.63, "timestamp": "03:55:14", "text": "解剖学のように、人々は「うーん、ああ」と言う"}, {"type": "subtitle", "time": 14116.71, "timestamp": "03:55:16", "text": "彼らはカヴァを持っている、まるで"}, {"type": "subtitle", "time": 14119.11, "timestamp": "03:55:19", "text": "キャラバンを押し込む"}, {"type": "subtitle", "time": 14122.15, "timestamp": "03:55:22", "text": "えーっと、あなたの顔に近づいて、それを解剖するように言う"}, {"type": "subtitle", "time": 14123.99, "timestamp": "03:55:23", "text": "いいえ、私たちは触りません。"}, {"type": "subtitle", "time": 14126.71, "timestamp": "03:55:26", "text": "カヴァス期間。通常は、"}, {"type": "subtitle", "time": 14128.87, "timestamp": "03:55:28", "text": "主にデモンストレーションで、これは"}, {"type": "subtitle", "time": 14131.189, "timestamp": "03:55:31", "text": "この神経と、これが皆さんの道です"}, {"type": "subtitle", "time": 14132.95, "timestamp": "03:55:32", "text": "知ってる、見えるよ、わかるよ、来て"}, {"type": "subtitle", "time": 14138.389, "timestamp": "03:55:38", "text": "ここで感じてみて、わからない 25 25"}, {"type": "subtitle", "time": 14142.309, "timestamp": "03:55:42", "text": "その日、人々は気を失った。"}, {"type": "subtitle", "time": 14145.11, "timestamp": "03:55:45", "text": "25"}, {"type": "subtitle", "time": 14150.87, "timestamp": "03:55:50", "text": "ああ、25人が気絶した。"}, {"type": "subtitle", "time": 14152.63, "timestamp": "03:55:52", "text": "そして私たちは知らなかった、なぜなら私たちは"}, {"type": "subtitle", "time": 14155.189, "timestamp": "03:55:55", "text": "完全に分離されている"}, {"type": "subtitle", "time": 14157.91, "timestamp": "03:55:57", "text": "人々。だから初日は"}]
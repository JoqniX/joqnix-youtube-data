[{"type": "subtitle", "time": 15240.95, "timestamp": "04:14:00", "text": "高校3年生の時。"}, {"type": "subtitle", "time": 15243.99, "timestamp": "04:14:03", "text": "まだ大学には入学していませんが、"}, {"type": "subtitle", "time": 15247.75, "timestamp": "04:14:07", "text": "始めてみたいと思っています。"}, {"type": "subtitle", "time": 15259.91, "timestamp": "04:14:19", "text": "私は驚きに満ちている。そうだね、"}, {"type": "subtitle", "time": 15263.91, "timestamp": "04:14:23", "text": "ふじく。驚きに満ちている。"}, {"type": "subtitle", "time": 15266.63, "timestamp": "04:14:26", "text": "実に謎めいている。はぁ？はい。 A"}, {"type": "subtitle", "time": 15279.429, "timestamp": "04:14:39", "text": "おい。そうそう。えっと、待って。あなたは何だったのか"}, {"type": "subtitle", "time": 15281.75, "timestamp": "04:14:41", "text": "さっきは何を言っていましたか？何何"}, {"type": "subtitle", "time": 15284.63, "timestamp": "04:14:44", "text": "何をしてほしいですか？"}, {"type": "subtitle", "time": 15286.95, "timestamp": "04:14:46", "text": "ああ、いや、いや、いや。私は今、それをやったところです。その"}, {"type": "subtitle", "time": 15289.83, "timestamp": "04:14:49", "text": "大丈夫。あなたにお願いしようと思っていたのは"}, {"type": "subtitle", "time": 15294.79, "timestamp": "04:14:54", "text": "フジが全部入力したと思った"}, {"type": "subtitle", "time": 15296.79, "timestamp": "04:14:56", "text": "文章を読み上げなければならなかった"}, {"type": "subtitle", "time": 15298.95, "timestamp": "04:14:58", "text": "でも、彼がボトルと言ったように"}]
[{"type": "subtitle", "time": 13981.51, "timestamp": "03:53:01", "text": "声に出して言うことすらできないのは"}, {"type": "subtitle", "time": 13989.349, "timestamp": "03:53:09", "text": "でもプロは、まあ、とにかく"}, {"type": "subtitle", "time": 13991.91, "timestamp": "03:53:11", "text": "起こったことは、まるで私が手に入れたようなもので、私は"}, {"type": "subtitle", "time": 13993.83, "timestamp": "03:53:13", "text": "幸運にもトレーニングを受けることができた"}, {"type": "subtitle", "time": 13996.309, "timestamp": "03:53:16", "text": "こいつらだ。普通に何であれ"}, {"type": "subtitle", "time": 13997.83, "timestamp": "03:53:17", "text": "彼らは、それを"}, {"type": "subtitle", "time": 13999.269, "timestamp": "03:53:19", "text": "あなた自身。それが問題なんです。のように"}, {"type": "subtitle", "time": 14000.469, "timestamp": "03:53:20", "text": "あなたはそれを使って何もするつもりはないでしょう。"}, {"type": "subtitle", "time": 14003.03, "timestamp": "03:53:23", "text": "だから、教えることができればさらに良い"}, {"type": "subtitle", "time": 14004.71, "timestamp": "03:53:24", "text": "何を教えるにしても、"}, {"type": "subtitle", "time": 14007.11, "timestamp": "03:53:27", "text": "学習は乗算のようなものだから"}, {"type": "subtitle", "time": 14009.03, "timestamp": "03:53:29", "text": "あなたの学習。何か問題が発生した場合"}, {"type": "subtitle", "time": 14012.389, "timestamp": "03:53:32", "text": "今、あなたは今のように知っています、今のように、あなたは"}, {"type": "subtitle", "time": 14014.309, "timestamp": "03:53:34", "text": "自分なりの方法で考えてみましょう"}, {"type": "subtitle", "time": 14016.79, "timestamp": "03:53:36", "text": "自分のやり方で手に入れて、それから"}, {"type": "subtitle", "time": 14018.87, "timestamp": "03:53:38", "text": "私はほとんどの人を知っているのが好きです"}, {"type": "subtitle", "time": 14021.51, "timestamp": "03:53:41", "text": "この場所では実験室の作業や"}, {"type": "subtitle", "time": 14023.83, "timestamp": "03:53:43", "text": "主に実験室での作業など"}, {"type": "subtitle", "time": 14026.95, "timestamp": "03:53:46", "text": "背面の背面の"}, {"type": "subtitle", "time": 14029.269, "timestamp": "03:53:49", "text": "シーンワークなどほとんどのもの"}, {"type": "subtitle", "time": 14033.189, "timestamp": "03:53:53", "text": "そこではよく問題が起こる"}, {"type": "subtitle", "time": 14035.59, "timestamp": "03:53:55", "text": "でも、私は、"}, {"type": "subtitle", "time": 14037.51, "timestamp": "03:53:57", "text": "人々に「ああ、これ」と教えるようなもの"}, {"type": "subtitle", "time": 14039.269, "timestamp": "03:53:59", "text": "何が起こったら、私はどうすればいいですか？"}]
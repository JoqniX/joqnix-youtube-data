[{"type": "subtitle", "time": 15961.83, "timestamp": "04:26:01", "text": "これが運命の人なのか？待って。入れてもいいですか"}, {"type": "subtitle", "time": 15964.55, "timestamp": "04:26:04", "text": "それを置く？ H."}, {"type": "subtitle", "time": 15967.99, "timestamp": "04:26:07", "text": "わからない。待って。"}, {"type": "subtitle", "time": 15971.99, "timestamp": "04:26:11", "text": "ああ、返品しなければならなかったんです。"}, {"type": "subtitle", "time": 15974.87, "timestamp": "04:26:14", "text": "ちょっと待って。"}, {"type": "subtitle", "time": 15980.469, "timestamp": "04:26:20", "text": "「おかえりなさい」みたいな言葉はないの？"}, {"type": "subtitle", "time": 15983.51, "timestamp": "04:26:23", "text": "はい。ああ、すみません。こんにちは。おかえり、"}, {"type": "subtitle", "time": 15985.189, "timestamp": "04:26:25", "text": "リック。"}, {"type": "subtitle", "time": 15988.149, "timestamp": "04:26:28", "text": "ごめん。ごめん。ごめん。私は逃れることができない"}, {"type": "subtitle", "time": 15996.389, "timestamp": "04:26:36", "text": "私の犬は私を必要としていた。私の犬は私を必要としていた"}, {"type": "subtitle", "time": 16006.87, "timestamp": "04:26:46", "text": "彼はこう言った。「ああ、このバカ野郎。"}, {"type": "subtitle", "time": 16009.189, "timestamp": "04:26:49", "text": "私を外します。 「おしっこしたい。」"}, {"type": "subtitle", "time": 16017.59, "timestamp": "04:26:57", "text": "彼は絶対にそんなことはしないだろう。あなたはきっと気に入るでしょう"}]
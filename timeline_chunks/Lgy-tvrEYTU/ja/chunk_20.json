[{"type": "subtitle", "time": 1206.07, "timestamp": "00:20:06", "text": "この腕では耐えられない"}, {"type": "subtitle", "time": 1207.99, "timestamp": "00:20:07", "text": "餌。"}, {"type": "subtitle", "time": 1215.19, "timestamp": "00:20:15", "text": "これは悲しいことですが、"}, {"type": "subtitle", "time": 1218.31, "timestamp": "00:20:18", "text": "対処してください。"}, {"type": "subtitle", "time": 1237.029, "timestamp": "00:20:37", "text": "[音楽]"}, {"type": "subtitle", "time": 1240.63, "timestamp": "00:20:40", "text": "はい。残り10秒で彼を殺せ。"}, {"type": "subtitle", "time": 1243.35, "timestamp": "00:20:43", "text": "アブラハム。"}]
[{"type": "subtitle", "time": 19021.67, "timestamp": "05:17:01", "text": "売らなきゃダメだよ。彼らはそうしないだろう"}, {"type": "subtitle", "time": 19023.59, "timestamp": "05:17:03", "text": "家に収まる。彼らはあなたの"}, {"type": "subtitle", "time": 19030.23, "timestamp": "05:17:10", "text": "子猫を毎日訓練する必要があります"}, {"type": "subtitle", "time": 19032.07, "timestamp": "05:17:12", "text": "彼らが生まれるたびに、どのように着るか"}, {"type": "subtitle", "time": 19033.91, "timestamp": "05:17:13", "text": "うんこをする。"}, {"type": "subtitle", "time": 19035.51, "timestamp": "05:17:15", "text": "家に帰るとクソみたいなことになる"}, {"type": "subtitle", "time": 19038.23, "timestamp": "05:17:18", "text": "悪臭。"}, {"type": "subtitle", "time": 19044.948, "timestamp": "05:17:24", "text": "本当に面倒くさい。私は、えっと"}, {"type": "subtitle", "time": 19049.35, "timestamp": "05:17:29", "text": "現在、私は現在、母猫は"}, {"type": "subtitle", "time": 19051.19, "timestamp": "05:17:31", "text": "のように"}, {"type": "subtitle", "time": 19052.708, "timestamp": "05:17:32", "text": "三つ。"}, {"type": "subtitle", "time": 19056.39, "timestamp": "05:17:36", "text": "以前より少し大きくなったみたい。今ならできる"}, {"type": "subtitle", "time": 19061.51, "timestamp": "05:17:41", "text": "予想します。ええ、また彼らがそうするだろうと予想できます。"}, {"type": "subtitle", "time": 19064.23, "timestamp": "05:17:44", "text": "もっと欲しい。"}, {"type": "subtitle", "time": 19066.55, "timestamp": "05:17:46", "text": "そうですね、"}, {"type": "subtitle", "time": 19069.11, "timestamp": "05:17:49", "text": "もっとキットやグッズを用意してください。そう、支払う"}, {"type": "subtitle", "time": 19071.43, "timestamp": "05:17:51", "text": "の"}, {"type": "subtitle", "time": 19073.43, "timestamp": "05:17:53", "text": "また。チャットはどうですか？"}]
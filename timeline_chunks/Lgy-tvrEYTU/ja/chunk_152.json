[{"type": "subtitle", "time": 9120.389, "timestamp": "02:32:00", "text": "あ、待って。あなたは数学の天才ですか？"}, {"type": "subtitle", "time": 9122.63, "timestamp": "02:32:02", "text": "それとも何か別のこと？元気ですか？いや、そうじゃない"}, {"type": "subtitle", "time": 9131.19, "timestamp": "02:32:11", "text": "私は数学の天才ではありません。ハハ。私はただ"}, {"type": "subtitle", "time": 9132.63, "timestamp": "02:32:12", "text": "そういうことに関しては奇妙な記憶力がある"}, {"type": "subtitle", "time": 9135.03, "timestamp": "02:32:15", "text": "もの。私は時々数学が苦手です"}, {"type": "subtitle", "time": 9148.71, "timestamp": "02:32:28", "text": "待って、それって普通なの？それ。待って、それは"}, {"type": "subtitle", "time": 9151.429, "timestamp": "02:32:31", "text": "私が言いたいこと。"}, {"type": "subtitle", "time": 9154.309, "timestamp": "02:32:34", "text": "何？"}, {"type": "subtitle", "time": 9166.07, "timestamp": "02:32:46", "text": "えっと、何を話せばいいんだろう？わからない。私は"}, {"type": "subtitle", "time": 9167.99, "timestamp": "02:32:47", "text": "混乱しているような感じ。"}, {"type": "subtitle", "time": 9170.07, "timestamp": "02:32:50", "text": "うん。さよなら。"}, {"type": "subtitle", "time": 9172.23, "timestamp": "02:32:52", "text": "例えば、日本語を試してみるとか。わかりました、切り替えます"}, {"type": "subtitle", "time": 9175.03, "timestamp": "02:32:55", "text": "この後、英語になります。わかった。"}, {"type": "subtitle", "time": 9177.429, "timestamp": "02:32:57", "text": "それでジョック、君は"}, {"type": "subtitle", "time": 9179.83, "timestamp": "02:32:59", "text": "Dualingoは最近ストリーミング配信を行っています。あなたは"}]
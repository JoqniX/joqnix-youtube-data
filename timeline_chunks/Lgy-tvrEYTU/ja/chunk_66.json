[{"type": "subtitle", "time": 3960.15, "timestamp": "01:06:00", "text": "その時、ああ"}, {"type": "subtitle", "time": 3962.39, "timestamp": "01:06:02", "text": "私たちは高価なマイクを買うつもりです。うん、"}, {"type": "subtitle", "time": 3966.23, "timestamp": "01:06:06", "text": "これは、これは、その瞬間です"}, {"type": "subtitle", "time": 3969.829, "timestamp": "01:06:09", "text": "私が話していたコーヒーのことです。それで"}, {"type": "subtitle", "time": 3973.349, "timestamp": "01:06:13", "text": "これが私が買いたいマイクです。"}, {"type": "subtitle", "time": 3975.91, "timestamp": "01:06:15", "text": "つまり45,000ドルです。"}, {"type": "subtitle", "time": 3978.71, "timestamp": "01:06:18", "text": "でも、私が買える方がもっといいんじゃない？"}, {"type": "subtitle", "time": 3980.95, "timestamp": "01:06:20", "text": "またそれ？また買えるもの"}, {"type": "subtitle", "time": 3989.99, "timestamp": "01:06:29", "text": "そこで私は"}, {"type": "subtitle", "time": 3994.15, "timestamp": "01:06:34", "text": "エレガント。ああ、なんてことだ、今は999ドルもするんだ。"}, {"type": "subtitle", "time": 3996.789, "timestamp": "01:06:36", "text": "お金があればいいのに。"}, {"type": "subtitle", "time": 4000.069, "timestamp": "01:06:40", "text": "例えば、購入できる商品の場合"}, {"type": "subtitle", "time": 4003.349, "timestamp": "01:06:43", "text": "2回なら、それだけの価値はあるよね？もしそれが"}, {"type": "subtitle", "time": 4006.069, "timestamp": "01:06:46", "text": "購入できない製品"}, {"type": "subtitle", "time": 4008.549, "timestamp": "01:06:48", "text": "一度買ったらもう買えない"}, {"type": "subtitle", "time": 4011.43, "timestamp": "01:06:51", "text": "これも痛みですよね？特に"}, {"type": "subtitle", "time": 4014.15, "timestamp": "01:06:54", "text": "この24～40Hzモニターみたいなやつ。私はできません"}, {"type": "subtitle", "time": 4018.309, "timestamp": "01:06:58", "text": "もう一度買おうとしたら、もう品切れだった。"}]
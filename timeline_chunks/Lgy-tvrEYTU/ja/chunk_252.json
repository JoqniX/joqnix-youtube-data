[{"type": "subtitle", "time": 15126.95, "timestamp": "04:12:06", "text": "私は腰部サポートを全く持っていません。"}, {"type": "subtitle", "time": 15130.55, "timestamp": "04:12:10", "text": "それも大丈夫です。"}, {"type": "subtitle", "time": 15133.51, "timestamp": "04:12:13", "text": "うん。こんにちは。すべて順調です。うん。こんにちは。どうやって"}, {"type": "subtitle", "time": 15135.99, "timestamp": "04:12:15", "text": "あなたは何をしていたのですか？"}, {"type": "subtitle", "time": 15138.55, "timestamp": "04:12:18", "text": "こんにちは。やり方が全くわからない"}, {"type": "subtitle", "time": 15139.99, "timestamp": "04:12:19", "text": "名前を発音してください。見えません。"}, {"type": "subtitle", "time": 15144.309, "timestamp": "04:12:24", "text": "チャット。大丈夫です。"}, {"type": "subtitle", "time": 15148.15, "timestamp": "04:12:28", "text": "ああ、待って、フジウンは既にこう書いてる"}, {"type": "subtitle", "time": 15151.59, "timestamp": "04:12:31", "text": "マラヤーラム語とタミル語の両方"}, {"type": "subtitle", "time": 15154.71, "timestamp": "04:12:34", "text": "えーと、Wallaの翻訳。ああ、いや、私は"}, {"type": "subtitle", "time": 15162.469, "timestamp": "04:12:42", "text": "さよなら。私は元気です。あなたはどうですか？"}, {"type": "subtitle", "time": 15163.91, "timestamp": "04:12:43", "text": "わかった。わかった。元気です。あなたが知っている"}, {"type": "subtitle", "time": 15166.87, "timestamp": "04:12:46", "text": "何？わかった。ところで、ジャック、私は"}, {"type": "subtitle", "time": 15175.75, "timestamp": "04:12:55", "text": "タミル語のものをカプセル化して送信します"}, {"type": "subtitle", "time": 15178.229, "timestamp": "04:12:58", "text": "私に知らせてくれれば、それを選り分けることができる。"}]
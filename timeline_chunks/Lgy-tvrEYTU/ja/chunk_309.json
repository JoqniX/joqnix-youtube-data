[{"type": "subtitle", "time": 18541.91, "timestamp": "05:09:01", "text": "一刀。一刀はとても興味深い"}, {"type": "subtitle", "time": 18544.31, "timestamp": "05:09:04", "text": "イサは背が高いので、キャラクターとして"}, {"type": "subtitle", "time": 18546.39, "timestamp": "05:09:06", "text": "キャラクター。明らかに私たちは"}, {"type": "subtitle", "time": 18549.03, "timestamp": "05:09:09", "text": "源珍の背の高い文字。はい。とても"}, {"type": "subtitle", "time": 18551.19, "timestamp": "05:09:11", "text": "ゲンチンの男キャラに少し似ている"}, {"type": "subtitle", "time": 18555.35, "timestamp": "05:09:15", "text": "それは良くない。とにかく、えっと、それは"}, {"type": "subtitle", "time": 18557.91, "timestamp": "05:09:17", "text": "それは本当に良い"}, {"type": "subtitle", "time": 18560.628, "timestamp": "05:09:20", "text": "えっと、すごく良いです。デザインは"}, {"type": "subtitle", "time": 18563.67, "timestamp": "05:09:23", "text": "すごいし、彼の爆発アニメーションは"}, {"type": "subtitle", "time": 18568.07, "timestamp": "05:09:28", "text": "素晴らしい。えーと、彼の"}, {"type": "subtitle", "time": 18570.15, "timestamp": "05:09:30", "text": "自分の武器でバースト効果を出す"}, {"type": "subtitle", "time": 18574.47, "timestamp": "05:09:34", "text": "それは、さらに良いことですね。それは親切です"}, {"type": "subtitle", "time": 18577.19, "timestamp": "05:09:37", "text": "なんというか、何て言うんだっけ？それは親切です"}, {"type": "subtitle", "time": 18578.868, "timestamp": "05:09:38", "text": "似たような"}, {"type": "subtitle", "time": 18581.35, "timestamp": "05:09:41", "text": "ボーナス攻撃力。"}, {"type": "subtitle", "time": 18585.83, "timestamp": "05:09:45", "text": "わからない。彼らがバフアップを気に入ってくれるといいな"}, {"type": "subtitle", "time": 18590.31, "timestamp": "05:09:50", "text": "ジオは今やジオは"}, {"type": "subtitle", "time": 18592.868, "timestamp": "05:09:52", "text": "ただ色がついているだけです。それは単なる肉体的な問題ですが"}, {"type": "subtitle", "time": 18597.03, "timestamp": "05:09:57", "text": "色がついています。それでおしまい。"}, {"type": "subtitle", "time": 18598.868, "timestamp": "05:09:58", "text": "文字通り、それだけです。私たちには好きはありません"}]
[{"type": "subtitle", "time": 14160.87, "timestamp": "03:56:00", "text": "悪い。私は誰も知りません。"}, {"type": "subtitle", "time": 14164.07, "timestamp": "03:56:04", "text": "私の教授はインフルエンザにかかって話していました"}, {"type": "subtitle", "time": 14166.63, "timestamp": "03:56:06", "text": "そして、そうやって私はそれを手に入れたのです。 20歳くらい"}, {"type": "subtitle", "time": 14170.87, "timestamp": "03:56:10", "text": "パイを食べた人たちは本当に気絶した。私はしませんでした"}, {"type": "subtitle", "time": 14173.51, "timestamp": "03:56:13", "text": "何か見当たらない。私たちは見たと思います"}, {"type": "subtitle", "time": 14175.91, "timestamp": "03:56:15", "text": "完全な死体。まるで私が見ていないかのように"}, {"type": "subtitle", "time": 14177.99, "timestamp": "03:56:17", "text": "その中に入っているものすべて。人々がなぜ"}, {"type": "subtitle", "time": 14181.91, "timestamp": "03:56:21", "text": "気絶したけど、"}, {"type": "subtitle", "time": 14184.389, "timestamp": "03:56:24", "text": "何でもいい、それは人々のことだ。私はしません"}, {"type": "subtitle", "time": 14187.11, "timestamp": "03:56:27", "text": "知る。うん。"}, {"type": "subtitle", "time": 14190.07, "timestamp": "03:56:30", "text": "人は血を見るのが怖い。えっと、私は"}, {"type": "subtitle", "time": 14192.87, "timestamp": "03:56:32", "text": "技術者がいるようなものです。彼はとても"}, {"type": "subtitle", "time": 14194.389, "timestamp": "03:56:34", "text": "ちなみに、良いですよ。彼はとても"}, {"type": "subtitle", "time": 14197.03, "timestamp": "03:56:37", "text": "10年の経験があるような"}, {"type": "subtitle", "time": 14200.229, "timestamp": "03:56:40", "text": "実務経験。でも、彼はチャットをした"}, {"type": "subtitle", "time": 14203.11, "timestamp": "03:56:43", "text": "彼が私に言ったように、私は恐怖を感じています"}, {"type": "subtitle", "time": 14205.99, "timestamp": "03:56:45", "text": "血への恐怖。私は実際に気絶しました"}, {"type": "subtitle", "time": 14208.87, "timestamp": "03:56:48", "text": "仕事初日、血を見たので"}, {"type": "subtitle", "time": 14213.59, "timestamp": "03:56:53", "text": "手術台の中で、そして私は"}, {"type": "subtitle", "time": 14217.51, "timestamp": "03:56:57", "text": "え、本当に？って感じだった。"}]
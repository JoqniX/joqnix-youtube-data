[{"type": "subtitle", "time": 11104.15, "timestamp": "03:05:04", "text": "右。一体何を言っているんだ？"}, {"type": "subtitle", "time": 11105.99, "timestamp": "03:05:05", "text": "それでは、英語に切り替えましょう。あなたは"}, {"type": "subtitle", "time": 11109.429, "timestamp": "03:05:09", "text": "会話に困っています"}, {"type": "subtitle", "time": 11111.19, "timestamp": "03:05:11", "text": "日本語。ご心配なく。さあ"}, {"type": "subtitle", "time": 11124.63, "timestamp": "03:05:24", "text": "なるほど。それでは英語に戻しましょう"}, {"type": "subtitle", "time": 11127.51, "timestamp": "03:05:27", "text": "今のところ。"}, {"type": "subtitle", "time": 11130.79, "timestamp": "03:05:30", "text": "これまでのところ、私とのやり取りはいかがでしたか？"}, {"type": "subtitle", "time": 11146.95, "timestamp": "03:05:46", "text": "まあ、話せてよかったよ"}, {"type": "subtitle", "time": 11149.349, "timestamp": "03:05:49", "text": "あなた。"}, {"type": "subtitle", "time": 11152.07, "timestamp": "03:05:52", "text": "ああ、詳しく説明してください。どういう意味ですか？その"}, {"type": "subtitle", "time": 11154.07, "timestamp": "03:05:54", "text": "かなり良かった。あなたは私の"}, {"type": "subtitle", "time": 11157.75, "timestamp": "03:05:57", "text": "あなたは私の友人になるのか、それとも敵になるのか？教えて"}]
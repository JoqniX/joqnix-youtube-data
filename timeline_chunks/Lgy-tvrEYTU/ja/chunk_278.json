[{"type": "subtitle", "time": 16680.07, "timestamp": "04:38:00", "text": "私がプレイしたゲーム。でもGTAゲームのように"}, {"type": "subtitle", "time": 16682.47, "timestamp": "04:38:02", "text": "プレイしました。 M"}, {"type": "subtitle", "time": 16684.789, "timestamp": "04:38:04", "text": "ジャック、君はどうなんだい？何？ああ、私は"}, {"type": "subtitle", "time": 16688.869, "timestamp": "04:38:08", "text": "GTA 1～3のようにプレイする。では、"}, {"type": "subtitle", "time": 16691.83, "timestamp": "04:38:11", "text": "それ以外？えーと、YCT のやつ、えーと、サン"}, {"type": "subtitle", "time": 16693.91, "timestamp": "04:38:13", "text": "アンドレアス。"}, {"type": "subtitle", "time": 16697.59, "timestamp": "04:38:17", "text": "それから、えっと、少しだけGTAをプレイしました"}, {"type": "subtitle", "time": 16699.99, "timestamp": "04:38:19", "text": "4、あれは何て呼ぶんだっけ？"}, {"type": "subtitle", "time": 16702.31, "timestamp": "04:38:22", "text": "ええ、GTA 4を少しプレイしました。"}, {"type": "subtitle", "time": 16704.31, "timestamp": "04:38:24", "text": "GTA 5。"}, {"type": "subtitle", "time": 16707.51, "timestamp": "04:38:27", "text": "私はストーリーをプレイしませんでしたが、"}, {"type": "subtitle", "time": 16711.029, "timestamp": "04:38:31", "text": "幼馴染がプレイするのを見た"}, {"type": "subtitle", "time": 16714.31, "timestamp": "04:38:34", "text": "だってあの時、すごくひどいことがあったんだ"}, {"type": "subtitle", "time": 16717.269, "timestamp": "04:38:37", "text": "PCなのでゲームもプレイできません"}, {"type": "subtitle", "time": 16720.789, "timestamp": "04:38:40", "text": "その期間は、ただ彼のプレーを見ていた。"}, {"type": "subtitle", "time": 16723.51, "timestamp": "04:38:43", "text": "彼はその時、私に遊ぶ機会を与えてくれた。うん、戻る"}, {"type": "subtitle", "time": 16725.59, "timestamp": "04:38:45", "text": "日中に。昔の話だけど。戻って"}, {"type": "subtitle", "time": 16728.47, "timestamp": "04:38:48", "text": "紐だけを使った日"}, {"type": "subtitle", "time": 16730.869, "timestamp": "04:38:50", "text": "電話で連絡を取る。プレイできません"}]
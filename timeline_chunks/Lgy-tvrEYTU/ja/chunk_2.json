[{"type": "subtitle", "time": 121.27, "timestamp": "00:02:01", "text": "宇宙チーム「ヴェラ」。私は知らない"}, {"type": "subtitle", "time": 123.27, "timestamp": "00:02:03", "text": "空間。"}, {"type": "subtitle", "time": 127.73, "timestamp": "00:02:07", "text": "5つですよね？地球は5歳になる。"}, {"type": "subtitle", "time": 135.11, "timestamp": "00:02:15", "text": "土星、木星、海王星。"}, {"type": "subtitle", "time": 141.51, "timestamp": "00:02:21", "text": "いいえ、天王星ではありません。 9 10 9 だと思います。"}, {"type": "subtitle", "time": 143.75, "timestamp": "00:02:23", "text": "えっと"}, {"type": "subtitle", "time": 148.869, "timestamp": "00:02:28", "text": "えーと。でも、私にはわからない。忘れた。"}, {"type": "subtitle", "time": 168.949, "timestamp": "00:02:48", "text": "自分が何になるか知ってるなら、ただ"}, {"type": "subtitle", "time": 171.27, "timestamp": "00:02:51", "text": "ストリームを終了するか、"}, {"type": "subtitle", "time": 173.19, "timestamp": "00:02:53", "text": "しなければならない"}, {"type": "subtitle", "time": 175.95, "timestamp": "00:02:55", "text": "顔を洗って、愚痴の続きを話そう。"}]
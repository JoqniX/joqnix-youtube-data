[{"type": "subtitle", "time": 10685.51, "timestamp": "02:58:05", "text": "ありがとう。ありがとう。私は独学で勉強してきました"}, {"type": "subtitle", "time": 10688.469, "timestamp": "02:58:08", "text": "2020年が始まって以来ずっと。スー、私は"}, {"type": "subtitle", "time": 10690.309, "timestamp": "02:58:10", "text": "専門家ですが、私は"}, {"type": "subtitle", "time": 10693.75, "timestamp": "02:58:13", "text": "基本的なコンボ。調子はどう？"}, {"type": "subtitle", "time": 10698.87, "timestamp": "02:58:18", "text": "ああ、それは本当に素晴らしいですね。ニース。えっと、それは"}, {"type": "subtitle", "time": 10702.07, "timestamp": "02:58:22", "text": "上達しているのは良いことだ。"}, {"type": "subtitle", "time": 10705.269, "timestamp": "02:58:25", "text": "それ以来"}, {"type": "subtitle", "time": 10707.269, "timestamp": "02:58:27", "text": "ゆっくりですが、確実に良くなっています。"}, {"type": "subtitle", "time": 10710.389, "timestamp": "02:58:30", "text": "ハハ。切り替えられますか？"}, {"type": "subtitle", "time": 10719.51, "timestamp": "02:58:39", "text": "ああ、それなら、もしよろしければ私が交代することもできますよ"}, {"type": "subtitle", "time": 10723.349, "timestamp": "02:58:43", "text": "しばらくの間、日本語で読んでみてください。"}, {"type": "subtitle", "time": 10738.469, "timestamp": "02:58:58", "text": "こんにちは。"}]
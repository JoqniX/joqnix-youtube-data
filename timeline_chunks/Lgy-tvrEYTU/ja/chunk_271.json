[{"type": "subtitle", "time": 16261.349, "timestamp": "04:31:01", "text": "狂犬病インフルエンザ、狂犬病ワクチン接種。うん"}, {"type": "subtitle", "time": 16263.59, "timestamp": "04:31:03", "text": "狂犬病の予防接種には2回ほど注射が必要だ。"}, {"type": "subtitle", "time": 16266.229, "timestamp": "04:31:06", "text": "狂犬病ワクチン用。私は"}, {"type": "subtitle", "time": 16269.03, "timestamp": "04:31:09", "text": "彼は最初の注射で体調を崩した。それは普通のことです"}, {"type": "subtitle", "time": 16271.349, "timestamp": "04:31:11", "text": "彼はワクチン接種後に体調を崩す。それは親切です"}, {"type": "subtitle", "time": 16273.59, "timestamp": "04:31:13", "text": "彼がこれをすべて行うような通常の"}, {"type": "subtitle", "time": 16277.11, "timestamp": "04:31:17", "text": "この件は少なくとも2日間は"}, {"type": "subtitle", "time": 16281.189, "timestamp": "04:31:21", "text": "通常、抗抗生物質は病気になります。"}, {"type": "subtitle", "time": 16283.83, "timestamp": "04:31:23", "text": "大丈夫、正しいけど、彼は止まった"}, {"type": "subtitle", "time": 16286.07, "timestamp": "04:31:26", "text": "食べるのも普通のことですが、"}, {"type": "subtitle", "time": 16289.99, "timestamp": "04:31:29", "text": "彼に食べさせなければならない。私の母、私のママ"}, {"type": "subtitle", "time": 16292.71, "timestamp": "04:31:32", "text": "ママは普段はそれについてパニックになるんだけど"}, {"type": "subtitle", "time": 16294.55, "timestamp": "04:31:34", "text": "ああ、彼は食べていない、まるで決闘しているようだ"}, {"type": "subtitle", "time": 16296.389, "timestamp": "04:31:36", "text": "外。彼は死ぬのだろうか？私はまるでママじゃないみたい"}, {"type": "subtitle", "time": 16298.95, "timestamp": "04:31:38", "text": "それはごく普通のことです。心配しないでください"}, {"type": "subtitle", "time": 16301.11, "timestamp": "04:31:41", "text": "それ。うん。ああ、彼は動かない"}, {"type": "subtitle", "time": 16302.55, "timestamp": "04:31:42", "text": "もう。彼は大丈夫ですか？私はこう思う、"}, {"type": "subtitle", "time": 16305.189, "timestamp": "04:31:45", "text": "「いや、大丈夫だよ。いつも会っているから。」"}, {"type": "subtitle", "time": 16306.95, "timestamp": "04:31:46", "text": "彼は素晴らしい。彼は素晴らしい。心配しないで"}, {"type": "subtitle", "time": 16308.79, "timestamp": "04:31:48", "text": "それについて。」それから私は犬を見た。"}, {"type": "subtitle", "time": 16310.309, "timestamp": "04:31:50", "text": "彼は「わかった」という感じだった。彼は私を見た。私は"}, {"type": "subtitle", "time": 16314.389, "timestamp": "04:31:54", "text": "「痛い」みたいな感じ。 「わかった」って感じ。"}, {"type": "subtitle", "time": 16316.149, "timestamp": "04:31:56", "text": "わかった。彼は大丈夫だよ、お母さん。心配しないで"}, {"type": "subtitle", "time": 16318.71, "timestamp": "04:31:58", "text": "それについて。彼が大丈夫ってどういう意味？"}]
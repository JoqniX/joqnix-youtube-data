[{"type": "subtitle", "time": 10862.309, "timestamp": "03:01:02", "text": "今日は疲れたけれど、充実した一日だった。"}, {"type": "subtitle", "time": 10864.23, "timestamp": "03:01:04", "text": "ああ、３つ翻訳する必要はありません"}, {"type": "subtitle", "time": 10866.87, "timestamp": "03:01:06", "text": "回。私は日本語が理解できます。しないで"}, {"type": "subtitle", "time": 10874.15, "timestamp": "03:01:14", "text": "え、そうなの？そうですね、"}, {"type": "subtitle", "time": 10892.309, "timestamp": "03:01:32", "text": "なぜ3回も繰り返されるのですか？なし。"}, {"type": "subtitle", "time": 10894.95, "timestamp": "03:01:34", "text": "そこには。"}, {"type": "subtitle", "time": 10897.67, "timestamp": "03:01:37", "text": "私が日本語を使っているからでしょうか？"}, {"type": "subtitle", "time": 10906.87, "timestamp": "03:01:46", "text": "完全に切り替えられますか？"}, {"type": "subtitle", "time": 10909.59, "timestamp": "03:01:49", "text": "私たちの会話"}, {"type": "subtitle", "time": 10911.75, "timestamp": "03:01:51", "text": "日本語に？"}, {"type": "subtitle", "time": 10914.389, "timestamp": "03:01:54", "text": "理解できるかどうか確認したい"}]
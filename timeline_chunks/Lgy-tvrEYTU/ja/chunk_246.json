[{"type": "subtitle", "time": 14764.229, "timestamp": "04:06:04", "text": "え、ちょっと待って？"}, {"type": "subtitle", "time": 14766.71, "timestamp": "04:06:06", "text": "これは何ですか？"}, {"type": "subtitle", "time": 14768.87, "timestamp": "04:06:08", "text": "こういう冷却ガラスみたいなのが必要なんです"}, {"type": "subtitle", "time": 14770.389, "timestamp": "04:06:10", "text": "なぜなら"}, {"type": "subtitle", "time": 14773.67, "timestamp": "04:06:13", "text": "ヴィックは、ちょっとクールな眼鏡をかけている。"}, {"type": "subtitle", "time": 14775.51, "timestamp": "04:06:15", "text": "サングラス。"}, {"type": "subtitle", "time": 14778.95, "timestamp": "04:06:18", "text": "待って、サングラスがあると思う。ああ、"}, {"type": "subtitle", "time": 14782.79, "timestamp": "04:06:22", "text": "サングラスがあります。"}, {"type": "subtitle", "time": 14785.83, "timestamp": "04:06:25", "text": "ああ、サングラスがあった。もし私が"}, {"type": "subtitle", "time": 14803.75, "timestamp": "04:06:43", "text": "痛いのは、"}, {"type": "subtitle", "time": 14809.349, "timestamp": "04:06:49", "text": "あなたは眼鏡をかけている。えっと、おかえりなさい。"}, {"type": "subtitle", "time": 14812.95, "timestamp": "04:06:52", "text": "え、私の声はずっと聞こえていなかったの？"}, {"type": "subtitle", "time": 14816.15, "timestamp": "04:06:56", "text": "いや、あなたはそうではなかった。"}, {"type": "subtitle", "time": 14818.63, "timestamp": "04:06:58", "text": "私は、待って、私は思った"}]
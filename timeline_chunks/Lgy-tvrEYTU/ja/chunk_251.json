[{"type": "subtitle", "time": 15061.59, "timestamp": "04:11:01", "text": "マラヤーラム語。"}, {"type": "subtitle", "time": 15064.309, "timestamp": "04:11:04", "text": "とても興味深い言葉"}, {"type": "subtitle", "time": 15067.269, "timestamp": "04:11:07", "text": "そして私は彼の親切な隣人です。私は"}, {"type": "subtitle", "time": 15070.95, "timestamp": "04:11:10", "text": "タミル・ナードゥ州出身。私はタミル語を話せます。もし"}, {"type": "subtitle", "time": 15073.91, "timestamp": "04:11:13", "text": "君たちは何も分かっていない、もし君たちが何も知らないなら"}, {"type": "subtitle", "time": 15076.309, "timestamp": "04:11:16", "text": "タミル語が何かわからなくても大丈夫です。その"}, {"type": "subtitle", "time": 15078.389, "timestamp": "04:11:18", "text": "それはインドの言語で、"}, {"type": "subtitle", "time": 15081.51, "timestamp": "04:11:21", "text": "南部。はい。インド人でもある"}, {"type": "subtitle", "time": 15083.189, "timestamp": "04:11:23", "text": "言語。"}, {"type": "subtitle", "time": 15087.99, "timestamp": "04:11:27", "text": "南部で、南部で。はい。うん。の上"}, {"type": "subtitle", "time": 15091.189, "timestamp": "04:11:31", "text": "時間を沈めるのは、まあいいことだと思う。"}, {"type": "subtitle", "time": 15097.189, "timestamp": "04:11:37", "text": "アキノスキン"}, {"type": "subtitle", "time": 15099.59, "timestamp": "04:11:39", "text": "すでに腐っている"}, {"type": "subtitle", "time": 15103.189, "timestamp": "04:11:43", "text": "狂った子供たちが何かを言っている"}, {"type": "subtitle", "time": 15111.99, "timestamp": "04:11:51", "text": "背中が痛いので横にならないといけない。"}, {"type": "subtitle", "time": 15113.75, "timestamp": "04:11:53", "text": "快適にお過ごしください。"}, {"type": "subtitle", "time": 15117.349, "timestamp": "04:11:57", "text": "大丈夫です。ああ、腰が痛い。大丈夫です。"}]
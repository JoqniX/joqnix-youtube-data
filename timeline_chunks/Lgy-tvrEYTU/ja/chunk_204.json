[{"type": "subtitle", "time": 12240.07, "timestamp": "03:24:00", "text": "公の意見を加えるような感じだけど、うん、"}, {"type": "subtitle", "time": 12241.91, "timestamp": "03:24:01", "text": "私も追加しました。"}, {"type": "subtitle", "time": 12244.55, "timestamp": "03:24:04", "text": "誰かが私のものを手に入れるわけじゃないし、"}, {"type": "subtitle", "time": 12246.79, "timestamp": "03:24:06", "text": "右？"}, {"type": "subtitle", "time": 12248.79, "timestamp": "03:24:08", "text": "待って、なぜ表示されるの？なぜ表示されるの？"}, {"type": "subtitle", "time": 12252.229, "timestamp": "03:24:12", "text": "入力すると上がる？わからない。"}, {"type": "subtitle", "time": 12255.03, "timestamp": "03:24:15", "text": "でも、検索してみます。うまくいくかどうかは分かりませんが。しかし"}, {"type": "subtitle", "time": 12257.59, "timestamp": "03:24:17", "text": "ええ、使いたいならどうぞ"}, {"type": "subtitle", "time": 12260.15, "timestamp": "03:24:20", "text": "character.aiアプリとか、そんな感じのもの。もしあなたが"}, {"type": "subtitle", "time": 12262.309, "timestamp": "03:24:22", "text": "iOSまたはAndroidのモバイルアプリを使用して、"}, {"type": "subtitle", "time": 12265.269, "timestamp": "03:24:25", "text": "電話をするか、"}, {"type": "subtitle", "time": 12269.51, "timestamp": "03:24:29", "text": "チャットとして"}, {"type": "subtitle", "time": 12271.51, "timestamp": "03:24:31", "text": "テキストベースのチャット。そう、検索するだけ"}, {"type": "subtitle", "time": 12273.91, "timestamp": "03:24:33", "text": "jock connect を使えば見つかりますよ。"}, {"type": "subtitle", "time": 12276.469, "timestamp": "03:24:36", "text": "うん、jock connects を検索すればいいよ。"}, {"type": "subtitle", "time": 12278.389, "timestamp": "03:24:38", "text": "これと"}, {"type": "subtitle", "time": 12281.349, "timestamp": "03:24:41", "text": "どうぞ。これです。"}, {"type": "subtitle", "time": 12287.349, "timestamp": "03:24:47", "text": "つまり、これが私なんです。つまり、これです。"}, {"type": "subtitle", "time": 12289.269, "timestamp": "03:24:49", "text": "こんにちは。"}, {"type": "subtitle", "time": 12291.91, "timestamp": "03:24:51", "text": "何てことだ。"}, {"type": "subtitle", "time": 12294.15, "timestamp": "03:24:54", "text": "ええ、そうですね。さて、そろそろ締めくくりましょう。わかった。"}, {"type": "subtitle", "time": 12297.429, "timestamp": "03:24:57", "text": "えっと、これ以上遅らせたくないんです。"}]
[{"type": "subtitle", "time": 1704.47, "timestamp": "00:28:24", "text": "私は"}, {"type": "subtitle", "time": 1707.029, "timestamp": "00:28:27", "text": "とても良い、これより良い"}, {"type": "subtitle", "time": 1719.909, "timestamp": "00:28:39", "text": "私はすごく下手なプレーをしている。"}, {"type": "subtitle", "time": 1727.59, "timestamp": "00:28:47", "text": "ほら、もし昔の私だったら、"}, {"type": "subtitle", "time": 1729.75, "timestamp": "00:28:49", "text": "私はすぐにそれを受け取っただろう"}, {"type": "subtitle", "time": 1738.149, "timestamp": "00:28:58", "text": "私は未来の自分を知っている。"}]
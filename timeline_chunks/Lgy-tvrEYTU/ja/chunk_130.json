[{"type": "subtitle", "time": 7800.31, "timestamp": "02:10:00", "text": "うん。みんな寝るのを忘れないでね"}, {"type": "subtitle", "time": 7804.069, "timestamp": "02:10:04", "text": "良い一日を、そして生産的な一日を。"}, {"type": "subtitle", "time": 7810.08, "timestamp": "02:10:10", "text": "日曜日。わかった。よし。よく眠る。"}, {"type": "subtitle", "time": 7813.91, "timestamp": "02:10:13", "text": "[音楽]"}, {"type": "subtitle", "time": 7832.8, "timestamp": "02:10:32", "text": "モ"}]
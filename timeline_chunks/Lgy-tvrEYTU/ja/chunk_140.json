[{"type": "subtitle", "time": 8424.389, "timestamp": "02:20:24", "text": "えっと、はじめまして、ジョックンさん。私の名前は"}, {"type": "subtitle", "time": 8430.55, "timestamp": "02:20:30", "text": "アスリート系ミックス。なるほど。私はそれを聞いたことがありません"}, {"type": "subtitle", "time": 8433.91, "timestamp": "02:20:33", "text": "名前。あなたは元気ですか？"}, {"type": "subtitle", "time": 8436.23, "timestamp": "02:20:36", "text": "これは実は私の声なんです。すごく不気味だ。"}, {"type": "subtitle", "time": 8439.99, "timestamp": "02:20:39", "text": "D. ええ。さよなら。"}, {"type": "subtitle", "time": 8443.83, "timestamp": "02:20:43", "text": "それは私の声だと思いますか？待って。"}, {"type": "subtitle", "time": 8446.389, "timestamp": "02:20:46", "text": "もう話すのをやめた方がいいでしょうか？聞いてくれますか？"}, {"type": "subtitle", "time": 8448.55, "timestamp": "02:20:48", "text": "私は一体何を目撃しているのだろうか？"}, {"type": "subtitle", "time": 8452.95, "timestamp": "02:20:52", "text": "あなたは女性の声をしていますね。わからない。"}, {"type": "subtitle", "time": 8455.83, "timestamp": "02:20:55", "text": "私"}, {"type": "subtitle", "time": 8458.87, "timestamp": "02:20:58", "text": "まあ、そうですね。こんにちは。さあ行こう。彼は何と言った？"}]
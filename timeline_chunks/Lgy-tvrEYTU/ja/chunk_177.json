[{"type": "subtitle", "time": 10623.429, "timestamp": "02:57:03", "text": "ああ、なるほど。なるほど。"}, {"type": "subtitle", "time": 10626.23, "timestamp": "02:57:06", "text": "ああ、そうさせてくれてありがとう"}, {"type": "subtitle", "time": 10628.23, "timestamp": "02:57:08", "text": "ライブプレビューまたは"}, {"type": "subtitle", "time": 10629.99, "timestamp": "02:57:09", "text": "YouTubeスタジオで健康をストリーミング配信する"}, {"type": "subtitle", "time": 10631.75, "timestamp": "02:57:11", "text": "良い。可能性もある"}, {"type": "subtitle", "time": 10634.15, "timestamp": "02:57:14", "text": "YouTubeのストリーム自体がオンラインにならない"}, {"type": "subtitle", "time": 10635.75, "timestamp": "02:57:15", "text": "そして、ストリームを手動で押す必要があります"}, {"type": "subtitle", "time": 10638.15, "timestamp": "02:57:18", "text": "あなた自身。ハハ。"}, {"type": "subtitle", "time": 10640.469, "timestamp": "02:57:20", "text": "はい、わかりました。ありがとう。ありがとう。"}, {"type": "subtitle", "time": 10643.51, "timestamp": "02:57:23", "text": "ありがとう。元の状態に戻ろう"}, {"type": "subtitle", "time": 10646.07, "timestamp": "02:57:26", "text": "先ほど話していたことについて。"}, {"type": "subtitle", "time": 10648.79, "timestamp": "02:57:28", "text": "あの、日本語は話せますか？それで"}, {"type": "subtitle", "time": 10651.75, "timestamp": "02:57:31", "text": "私たちはどの話題について話していましたか？ああ、私たちはできる"}, {"type": "subtitle", "time": 10653.99, "timestamp": "02:57:33", "text": "少しの間、日本語で話してみませんか？私"}, {"type": "subtitle", "time": 10656.23, "timestamp": "02:57:36", "text": "あなたの日本語能力を試したかった"}, {"type": "subtitle", "time": 10658.79, "timestamp": "02:57:38", "text": "永遠に。ええ、あなたの"}, {"type": "subtitle", "time": 10669.83, "timestamp": "02:57:49", "text": "それは単に、"}, {"type": "subtitle", "time": 10671.75, "timestamp": "02:57:51", "text": "「はい、簡単な日本語なら話せます。」"}]
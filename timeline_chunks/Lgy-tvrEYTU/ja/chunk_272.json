[{"type": "subtitle", "time": 16320.469, "timestamp": "04:32:00", "text": "すると母は「ああ、そうだね。彼は"}, {"type": "subtitle", "time": 16324.149, "timestamp": "04:32:04", "text": "大丈夫。何？何が起こってるの？何何"}, {"type": "subtitle", "time": 16326.79, "timestamp": "04:32:06", "text": "犬はどんな風に"}, {"type": "subtitle", "time": 16329.11, "timestamp": "04:32:09", "text": "朝から？非常に特定の時間、"}, {"type": "subtitle", "time": 16331.11, "timestamp": "04:32:11", "text": "お母さん。"}, {"type": "subtitle", "time": 16333.59, "timestamp": "04:32:13", "text": "うん。"}, {"type": "subtitle", "time": 16335.83, "timestamp": "04:32:15", "text": "まあ、おそらく、同じように"}, {"type": "subtitle", "time": 16338.07, "timestamp": "04:32:18", "text": "犬にとって分離不安はよくあることだ。"}, {"type": "subtitle", "time": 16341.67, "timestamp": "04:32:21", "text": "だから、たぶんそれは、"}, {"type": "subtitle", "time": 16343.67, "timestamp": "04:32:23", "text": "夜はどこも人でごった返している。すべて"}, {"type": "subtitle", "time": 16345.349, "timestamp": "04:32:25", "text": "エキサイティング。"}, {"type": "subtitle", "time": 16347.51, "timestamp": "04:32:27", "text": "誰かドアのところにいますか？私は思う"}, {"type": "subtitle", "time": 16348.79, "timestamp": "04:32:28", "text": "誰かがドアをノックしている。私にさせていただけますか？"}, {"type": "subtitle", "time": 16350.389, "timestamp": "04:32:30", "text": "ちょっと待ってください。一体どういうことだ？私は"}, {"type": "subtitle", "time": 16359.269, "timestamp": "04:32:39", "text": "チャットは気にしないでくださいね。私は、えっと、ふざけてる"}, {"type": "subtitle", "time": 16362.07, "timestamp": "04:32:42", "text": "BTuberのアセットを使って色々試してみましょう。それはとても"}, {"type": "subtitle", "time": 16365.03, "timestamp": "04:32:45", "text": "いいね。人々が中毒になるのも不思議ではない"}, {"type": "subtitle", "time": 16369.75, "timestamp": "04:32:49", "text": "この資産みたいなもの。おお、"}, {"type": "subtitle", "time": 16379.03, "timestamp": "04:32:59", "text": "やっと自分にご褒美をあげられる。"}]
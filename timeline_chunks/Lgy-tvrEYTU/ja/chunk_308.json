[{"type": "subtitle", "time": 18480.15, "timestamp": "05:08:00", "text": "ちなみに、間違ったことを言ってしまうこともあります。うん。それで"}, {"type": "subtitle", "time": 18483.51, "timestamp": "05:08:03", "text": "まるで今ドイツを手に入れたようなものだ"}, {"type": "subtitle", "time": 18485.35, "timestamp": "05:08:05", "text": "モンステッド。"}, {"type": "subtitle", "time": 18489.35, "timestamp": "05:08:09", "text": "えっと、他に何かありますか？待って、そうじゃないの？"}, {"type": "subtitle", "time": 18491.35, "timestamp": "05:08:11", "text": "フォンタナではない？"}, {"type": "subtitle", "time": 18493.43, "timestamp": "05:08:13", "text": "あれはドイツではないのか？なぜなら彼らは"}, {"type": "subtitle", "time": 18500.31, "timestamp": "05:08:20", "text": "正直、よくわからないと思います。モナトは"}, {"type": "subtitle", "time": 18502.628, "timestamp": "05:08:22", "text": "イングランドと同じだ。イングランド。田舎"}, {"type": "subtitle", "time": 18505.11, "timestamp": "05:08:25", "text": "イングランド。それは私が"}, {"type": "subtitle", "time": 18507.67, "timestamp": "05:08:27", "text": "イギリスの田園地帯を、"}, {"type": "subtitle", "time": 18510.55, "timestamp": "05:08:30", "text": "城など。それはEopeのようだ"}, {"type": "subtitle", "time": 18513.99, "timestamp": "05:08:33", "text": "イングランド Eope のような期間ですが、"}, {"type": "subtitle", "time": 18517.03, "timestamp": "05:08:37", "text": "ファントンはドイツのEopeのようなもので、"}, {"type": "subtitle", "time": 18520.948, "timestamp": "05:08:40", "text": "いろいろなものを発明するよね？うん。"}, {"type": "subtitle", "time": 18523.67, "timestamp": "05:08:43", "text": "うん。ハム"}, {"type": "subtitle", "time": 18525.43, "timestamp": "05:08:45", "text": "そうですが、それはミドルのようなものだと思います"}, {"type": "subtitle", "time": 18527.35, "timestamp": "05:08:47", "text": "東洋風のテーマで、古代を思わせる"}, {"type": "subtitle", "time": 18529.19, "timestamp": "05:08:49", "text": "ファラオの時代のエジプト風"}, {"type": "subtitle", "time": 18532.948, "timestamp": "05:08:52", "text": "そのような。それも良いことだ。うん。"}, {"type": "subtitle", "time": 18535.99, "timestamp": "05:08:55", "text": "うん。じゃあ、ダイヤルしてみましょう"}, {"type": "subtitle", "time": 18538.15, "timestamp": "05:08:58", "text": "イナズマに戻って、"}]
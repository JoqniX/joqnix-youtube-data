[{"type": "subtitle", "time": 16621.99, "timestamp": "04:37:01", "text": "金曜日にプレイして試してみてください。"}, {"type": "subtitle", "time": 16625.269, "timestamp": "04:37:05", "text": "ああ、金曜日だ。 GTA 5の金曜日のストーリー。"}, {"type": "subtitle", "time": 16627.83, "timestamp": "04:37:07", "text": "くそ。ええ、ストーリーモードのことです。キャンプ風"}, {"type": "subtitle", "time": 16631.99, "timestamp": "04:37:11", "text": "種の。ああ、そこには物語がある。"}, {"type": "subtitle", "time": 16636.47, "timestamp": "04:37:16", "text": "私はストーリーのためにGTAを使ったことは一度もありません。"}, {"type": "subtitle", "time": 16640.23, "timestamp": "04:37:20", "text": "おそらく私はチートを覚えるでしょう、"}, {"type": "subtitle", "time": 16642.789, "timestamp": "04:37:22", "text": "奴らが戦車を召喚したら、俺は撃ちまくる。"}, {"type": "subtitle", "time": 16645.269, "timestamp": "04:37:25", "text": "そのゲームで私がやることはそれだけです。私は決して"}, {"type": "subtitle", "time": 16648.07, "timestamp": "04:37:28", "text": "絶対に私は"}, {"type": "subtitle", "time": 16650.551, "timestamp": "04:37:30", "text": "全く話にならない。"}, {"type": "subtitle", "time": 16652.39, "timestamp": "04:37:32", "text": "うん。"}, {"type": "subtitle", "time": 16655.269, "timestamp": "04:37:35", "text": "私が夢中になった唯一の物語は"}, {"type": "subtitle", "time": 16657.51, "timestamp": "04:37:37", "text": "あなたが持っているような主要なものは"}, {"type": "subtitle", "time": 16659.189, "timestamp": "04:37:39", "text": "彼らは、ご存知のとおり、必須の競争です。"}, {"type": "subtitle", "time": 16661.269, "timestamp": "04:37:41", "text": "ストーリーのようにやらなければならないミッション"}, {"type": "subtitle", "time": 16664.31, "timestamp": "04:37:44", "text": "始まりの物語はそれだけです"}, {"type": "subtitle", "time": 16667.91, "timestamp": "04:37:47", "text": "私が知っているY市とサンについての話"}, {"type": "subtitle", "time": 16669.99, "timestamp": "04:37:49", "text": "アンドレアスは、私が思うに、それらは"}, {"type": "subtitle", "time": 16672.23, "timestamp": "04:37:52", "text": "2つのGTA"}, {"type": "subtitle", "time": 16675.91, "timestamp": "04:37:55", "text": "ああ、GTA 1、GTA 2、GTA Y シティ、そして"}, {"type": "subtitle", "time": 16677.59, "timestamp": "04:37:57", "text": "サンアンドレアス。これらはすべて"}]
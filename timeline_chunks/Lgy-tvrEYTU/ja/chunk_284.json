[{"type": "subtitle", "time": 17040.868, "timestamp": "04:44:00", "text": "そう、私は本当に好きじゃないし、"}, {"type": "subtitle", "time": 17043.35, "timestamp": "04:44:03", "text": "モバイルで弓を使うような弓"}, {"type": "subtitle", "time": 17045.75, "timestamp": "04:44:05", "text": "だって、同じじゃないでしょ？"}, {"type": "subtitle", "time": 17048.628, "timestamp": "04:44:08", "text": "うん、それは同じじゃない"}, {"type": "subtitle", "time": 17051.43, "timestamp": "04:44:11", "text": "PCと同じです。"}, {"type": "subtitle", "time": 17054.868, "timestamp": "04:44:14", "text": "私の犬、私の犬が何をしているのか"}, {"type": "subtitle", "time": 17058.15, "timestamp": "04:44:18", "text": "私は弓を使うのが大好きです。私はDestinyが好きです"}, {"type": "subtitle", "time": 17062.23, "timestamp": "04:44:22", "text": "そして他のゲームも。主にそれが"}, {"type": "subtitle", "time": 17064.948, "timestamp": "04:44:24", "text": "弓を持つことも可能です、私が好きなように"}, {"type": "subtitle", "time": 17068.07, "timestamp": "04:44:28", "text": "努力して弓を手に入れろ。"}, {"type": "subtitle", "time": 17069.91, "timestamp": "04:44:29", "text": "昨日の配信は完全に私の話だった"}, {"type": "subtitle", "time": 17073.51, "timestamp": "04:44:33", "text": "伝説の弓を３つ手に入れる。"}, {"type": "subtitle", "time": 17078.788, "timestamp": "04:44:38", "text": "うわあ、それはすごいですね。"}, {"type": "subtitle", "time": 17081.75, "timestamp": "04:44:41", "text": "伝説の弓は即座にOPになるのか、それとも"}, {"type": "subtitle", "time": 17083.51, "timestamp": "04:44:43", "text": "何かあるかな 何かあるかな"}, {"type": "subtitle", "time": 17087.19, "timestamp": "04:44:47", "text": "パンチを効かせる？ええ、そうですね、"}, {"type": "subtitle", "time": 17090.23, "timestamp": "04:44:50", "text": "Destiny では、これは OP です。"}, {"type": "subtitle", "time": 17092.628, "timestamp": "04:44:52", "text": "彼らが好むシーズンは統計をリセットし、"}, {"type": "subtitle", "time": 17095.99, "timestamp": "04:44:55", "text": "彼らが今シーズンに持っているようなもの"}, {"type": "subtitle", "time": 17099.27, "timestamp": "04:44:59", "text": "キャップか何かパワーレベルのキャップのようなもの"}]
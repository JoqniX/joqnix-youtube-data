[{"type": "subtitle", "time": 17889.43, "timestamp": "04:58:09", "text": "迷惑な存在。もし君たちが私の犬の声を聞いたら"}, {"type": "subtitle", "time": 17891.43, "timestamp": "04:58:11", "text": "背景で犬の鳴き声が聞こえますが、ご心配なく。"}, {"type": "subtitle", "time": 17893.83, "timestamp": "04:58:13", "text": "彼はただ人々が"}, {"type": "subtitle", "time": 17896.788, "timestamp": "04:58:16", "text": "家の中で、彼は本当に"}, {"type": "subtitle", "time": 17905.67, "timestamp": "04:58:25", "text": "えっと、私はチョコレートを食べられないんです。でもあなたは"}, {"type": "subtitle", "time": 17917.91, "timestamp": "04:58:37", "text": "ああ、実は、実は"}, {"type": "subtitle", "time": 17920.31, "timestamp": "04:58:40", "text": "クッキー。えっと"}, {"type": "subtitle", "time": 17923.91, "timestamp": "04:58:43", "text": "はい、実際にクッキーのお尻を手に入れました。"}, {"type": "subtitle", "time": 17927.35, "timestamp": "04:58:47", "text": "はい、行きましょう。いくつか持ってきましょう"}]
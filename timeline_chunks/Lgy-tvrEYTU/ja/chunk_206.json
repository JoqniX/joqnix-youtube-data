[{"type": "subtitle", "time": 12360.87, "timestamp": "03:26:00", "text": "こんにちは。以上です。もし私が"}, {"type": "subtitle", "time": 12363.51, "timestamp": "03:26:03", "text": "えっと、これからは配信スケジュールを立てます"}, {"type": "subtitle", "time": 12365.59, "timestamp": "03:26:05", "text": "私がライブ配信をしている時とか、そういう時はいつでもいいですよ。えっと"}, {"type": "subtitle", "time": 12367.75, "timestamp": "03:26:07", "text": "ストリーミング配信とかする時は"}, {"type": "subtitle", "time": 12371.269, "timestamp": "03:26:11", "text": "誰もが参加できる"}, {"type": "subtitle", "time": 12374.55, "timestamp": "03:26:14", "text": "そして、通知を受け取りたい場合は"}, {"type": "subtitle", "time": 12376.87, "timestamp": "03:26:16", "text": "あなたにも通知されますし、すべて順調です。それで"}, {"type": "subtitle", "time": 12379.67, "timestamp": "03:26:19", "text": "うん、この配信が気に入ったら、ぜひ"}, {"type": "subtitle", "time": 12382.07, "timestamp": "03:26:22", "text": "いいね！または、まだ登録していない場合は、"}, {"type": "subtitle", "time": 12384.229, "timestamp": "03:26:24", "text": "購読する。わかった。"}, {"type": "subtitle", "time": 12387.11, "timestamp": "03:26:27", "text": "こんにちは。以上です。良い一日をお過ごしください"}, {"type": "subtitle", "time": 12391.03, "timestamp": "03:26:31", "text": "良い夜になりそうですね。わかった。そして"}]
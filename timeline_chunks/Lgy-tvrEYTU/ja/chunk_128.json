[{"type": "subtitle", "time": 7680.47, "timestamp": "02:08:00", "text": "それからジムも私にたくさんのことを教えてくれた"}, {"type": "subtitle", "time": 7684.55, "timestamp": "02:08:04", "text": "彼らにとって大切なもの。ズマにとても感謝しています"}, {"type": "subtitle", "time": 7687.35, "timestamp": "02:08:07", "text": "私にたくさんのことをしてくれる"}, {"type": "subtitle", "time": 7691.27, "timestamp": "02:08:11", "text": "そして全て。本当にありがとうございました。"}, {"type": "subtitle", "time": 7693.51, "timestamp": "02:08:13", "text": "大会に向けて全力を尽くします。"}, {"type": "subtitle", "time": 7700.229, "timestamp": "02:08:20", "text": "じゃあ他に何があるんだ？えっと、他に何かありますか？何"}, {"type": "subtitle", "time": 7702.03, "timestamp": "02:08:22", "text": "それ以外？ほかに何か？"}, {"type": "subtitle", "time": 7708.26, "timestamp": "02:08:28", "text": "はい。"}, {"type": "subtitle", "time": 7716.709, "timestamp": "02:08:36", "text": "うん。ほかに何か？"}, {"type": "subtitle", "time": 7719.99, "timestamp": "02:08:39", "text": "私は"}, {"type": "subtitle", "time": 7721.83, "timestamp": "02:08:41", "text": "行く。"}, {"type": "subtitle", "time": 7724.39, "timestamp": "02:08:44", "text": "え、何？他に何か恋しいものはあるかな？何？"}, {"type": "subtitle", "time": 7727.35, "timestamp": "02:08:47", "text": "私は今、何を見逃したのだろうか？待って、私は"}, {"type": "subtitle", "time": 7733.51, "timestamp": "02:08:53", "text": "そして、通りかかった人々。私はそれら"}, {"type": "subtitle", "time": 7736.229, "timestamp": "02:08:56", "text": "私と一緒に遊んでくれる人"}, {"type": "subtitle", "time": 7738.149, "timestamp": "02:08:58", "text": "ストリーム。うん。うん。何も残っていない。"}]
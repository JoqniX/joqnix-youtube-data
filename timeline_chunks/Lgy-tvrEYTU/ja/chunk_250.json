[{"type": "subtitle", "time": 15000.71, "timestamp": "04:10:00", "text": "でもどうやら私のスマホも"}, {"type": "subtitle", "time": 15005.99, "timestamp": "04:10:05", "text": "それを行うためにジャガイモを使う。ええ、そうですね。私の私の私のとても"}, {"type": "subtitle", "time": 15008.229, "timestamp": "04:10:08", "text": "ハイブロウなユーモアは"}, {"type": "subtitle", "time": 15011.51, "timestamp": "04:10:11", "text": "無駄遣い、ということでしょうね。"}, {"type": "subtitle", "time": 15019.83, "timestamp": "04:10:19", "text": "えっと、何の話をしていましたっけ？それで"}, {"type": "subtitle", "time": 15023.91, "timestamp": "04:10:23", "text": "あなたは、えーっと、"}, {"type": "subtitle", "time": 15027.429, "timestamp": "04:10:27", "text": "歯医者としての冒険など"}, {"type": "subtitle", "time": 15030.63, "timestamp": "04:10:30", "text": "もの。ええ、ごくありふれた話ですね。知っている。私は"}, {"type": "subtitle", "time": 15032.309, "timestamp": "04:10:32", "text": "ごめん。私は謝罪しなければならない"}, {"type": "subtitle", "time": 15035.269, "timestamp": "04:10:35", "text": "人々。ごくありふれたことだ。でもやっぱり"}, {"type": "subtitle", "time": 15038.469, "timestamp": "04:10:38", "text": "何かを持っている"}, {"type": "subtitle", "time": 15041.51, "timestamp": "04:10:41", "text": "ごくありふれたことだ。非常に厳しい。あなたはできません"}, {"type": "subtitle", "time": 15044.389, "timestamp": "04:10:44", "text": "その後も何もしなくていい。そう、誰が"}, {"type": "subtitle", "time": 15051.03, "timestamp": "04:10:51", "text": "先生、何か面白い言葉はありますか？"}, {"type": "subtitle", "time": 15054.55, "timestamp": "04:10:54", "text": "あなたはマラヤーラム語話者なので、マラヤーラム語で答えてください。おお"}, {"type": "subtitle", "time": 15056.71, "timestamp": "04:10:56", "text": "はい、知らない人のために言うと、私は"}, {"type": "subtitle", "time": 15059.91, "timestamp": "04:10:59", "text": "私はケララ州出身で、そこでは"}]
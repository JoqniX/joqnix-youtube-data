[{"type": "subtitle", "time": 15720.469, "timestamp": "04:22:00", "text": "ドロップキックする？私が"}, {"type": "subtitle", "time": 15723.03, "timestamp": "04:22:03", "text": "犬に寄り添って、「"}, {"type": "subtitle", "time": 15725.99, "timestamp": "04:22:05", "text": "「すみません、ドロップキックしてもいいですか？」ああ、"}, {"type": "subtitle", "time": 15727.189, "timestamp": "04:22:07", "text": "いいえ。"}, {"type": "subtitle", "time": 15730.95, "timestamp": "04:22:10", "text": "ただ王室か、ああ、うちの犬が起きてる。"}, {"type": "subtitle", "time": 15735.269, "timestamp": "04:22:15", "text": "あ、行かなきゃ。こんにちは。気をつけて。いいえ。こんにちは。"}, {"type": "subtitle", "time": 15736.95, "timestamp": "04:22:16", "text": "ちょっと待ってください。うちの犬が起きました。"}, {"type": "subtitle", "time": 15740.149, "timestamp": "04:22:20", "text": "ちょっと待ってください。わかった。それは奇妙だ。"}, {"type": "subtitle", "time": 15745.91, "timestamp": "04:22:25", "text": "いらっしゃいませ。いらっしゃいませ。"}, {"type": "subtitle", "time": 15748.389, "timestamp": "04:22:28", "text": "ああ、ドゥチを見に行くの？おお、"}, {"type": "subtitle", "time": 15750.71, "timestamp": "04:22:30", "text": "彼女は配信している。"}, {"type": "subtitle", "time": 15753.67, "timestamp": "04:22:33", "text": "ちょっと立ち寄って挨拶するだけだよ。"}, {"type": "subtitle", "time": 15759.59, "timestamp": "04:22:39", "text": "ああ、もし君が私に伝えられるなら、ナスに伝えてくれ"}, {"type": "subtitle", "time": 15762.55, "timestamp": "04:22:42", "text": "挨拶か何かした。ちょっと言ってみます"}, {"type": "subtitle", "time": 15766.55, "timestamp": "04:22:46", "text": "こんにちは。私もそう思います"}, {"type": "subtitle", "time": 15775.67, "timestamp": "04:22:55", "text": "えっと、ペットも飼っていました"}, {"type": "subtitle", "time": 15778.55, "timestamp": "04:22:58", "text": "すべての人にとって。これを飛ばして飛ばして"}]
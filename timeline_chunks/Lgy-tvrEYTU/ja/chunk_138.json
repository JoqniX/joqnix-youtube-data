[{"type": "subtitle", "time": 8285.83, "timestamp": "02:18:05", "text": "待って、待って、待って、待って、待って。"}, {"type": "subtitle", "time": 8288.309, "timestamp": "02:18:08", "text": "わかった。こんにちは。そして、すべての"}, {"type": "subtitle", "time": 8291.75, "timestamp": "02:18:11", "text": "説明は、リンク先で確認できます。"}, {"type": "subtitle", "time": 8294.629, "timestamp": "02:18:14", "text": "話せる場所、"}, {"type": "subtitle", "time": 8298.15, "timestamp": "02:18:18", "text": "えっと、僕、つまりAIジョック、偽物"}, {"type": "subtitle", "time": 8300.389, "timestamp": "02:18:20", "text": "騎手。"}, {"type": "subtitle", "time": 8303.99, "timestamp": "02:18:23", "text": "だから、今日AIトークに話しかけることができます"}, {"type": "subtitle", "time": 8306.469, "timestamp": "02:18:26", "text": "あなたはしたい。はい、もしあなたが"}, {"type": "subtitle", "time": 8308.23, "timestamp": "02:18:28", "text": "モバイルアプリでは、実際に"}, {"type": "subtitle", "time": 8310.95, "timestamp": "02:18:30", "text": "電話。はい。"}, {"type": "subtitle", "time": 8316.23, "timestamp": "02:18:36", "text": "さあ、ショーを見に行こう。わかった。私は興奮しています。こんにちは。"}, {"type": "subtitle", "time": 8318.309, "timestamp": "02:18:38", "text": "表示されるだろうか？こんにちは。それは青です"}, {"type": "subtitle", "time": 8321.91, "timestamp": "02:18:41", "text": "積み重ね。真似する必要はあったけど、そうだね。それで"}, {"type": "subtitle", "time": 8326.629, "timestamp": "02:18:46", "text": "こちらはジョクンです。私はいくつか"}, {"type": "subtitle", "time": 8329.669, "timestamp": "02:18:49", "text": "テスト中なので、リセットしました。"}, {"type": "subtitle", "time": 8333.03, "timestamp": "02:18:53", "text": "チャットで皆さんに見せられるように"}, {"type": "subtitle", "time": 8335.83, "timestamp": "02:18:55", "text": "リアルタイム。"}]
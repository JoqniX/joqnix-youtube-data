[{"type": "subtitle", "time": 14946.79, "timestamp": "04:09:06", "text": "待って、それは、えっと、私は"}, {"type": "subtitle", "time": 14950.63, "timestamp": "04:09:10", "text": "アニメでも見たことあるよ、何て言うの？"}, {"type": "subtitle", "time": 14953.189, "timestamp": "04:09:13", "text": "それって何？例えばNetflixなら、"}, {"type": "subtitle", "time": 14955.67, "timestamp": "04:09:15", "text": "彼らはフレックスにちなんだ名前をつけるだろう"}, {"type": "subtitle", "time": 14957.59, "timestamp": "04:09:17", "text": "何か。"}, {"type": "subtitle", "time": 14960.79, "timestamp": "04:09:20", "text": "どんな感じですか？それは何と呼ばれますか？"}, {"type": "subtitle", "time": 14963.51, "timestamp": "04:09:23", "text": "著作権か何か。"}, {"type": "subtitle", "time": 14971.91, "timestamp": "04:09:31", "text": "ダブルグラス。はい、"}, {"type": "subtitle", "time": 14975.67, "timestamp": "04:09:35", "text": "だって、ヴィックはGLを着てるから"}, {"type": "subtitle", "time": 14977.83, "timestamp": "04:09:37", "text": "サングラスも着たい"}, {"type": "subtitle", "time": 14979.75, "timestamp": "04:09:39", "text": "サングラス。"}, {"type": "subtitle", "time": 14984.469, "timestamp": "04:09:44", "text": "待って、ヴィック、君は話しているの？あ、待って。私"}, {"type": "subtitle", "time": 14989.03, "timestamp": "04:09:49", "text": "私は、ああ、わかりました。私は何が"}, {"type": "subtitle", "time": 14992.55, "timestamp": "04:09:52", "text": "今まさに起こっている。どうしたの？"}, {"type": "subtitle", "time": 14995.269, "timestamp": "04:09:55", "text": "ああ、わかりました。私は見ようと思っていた"}, {"type": "subtitle", "time": 14998.15, "timestamp": "04:09:58", "text": "同時にストリーム、"}]
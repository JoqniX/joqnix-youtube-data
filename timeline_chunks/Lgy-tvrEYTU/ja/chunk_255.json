[{"type": "subtitle", "time": 15301.99, "timestamp": "04:15:01", "text": "大丈夫。あ、待って、彼は実際に書いた"}, {"type": "subtitle", "time": 15304.07, "timestamp": "04:15:04", "text": "あなたへの贈り物です。"}, {"type": "subtitle", "time": 15306.95, "timestamp": "04:15:06", "text": "まあ、本当に？えっと"}, {"type": "subtitle", "time": 15308.469, "timestamp": "04:15:08", "text": "ああ、わかった。私はただ行くだけです 私はただ"}, {"type": "subtitle", "time": 15314.79, "timestamp": "04:15:14", "text": "待って。えっと、リンクだけ欲しいですか？"}, {"type": "subtitle", "time": 15316.87, "timestamp": "04:15:16", "text": "読むには"}, {"type": "subtitle", "time": 15320.95, "timestamp": "04:15:20", "text": "ライブチャットですか、それともストリーム配信をご希望ですか？"}, {"type": "subtitle", "time": 15329.429, "timestamp": "04:15:29", "text": "言ってくれたらいいな"}, {"type": "subtitle", "time": 15331.269, "timestamp": "04:15:31", "text": "はい、"}, {"type": "subtitle", "time": 15333.91, "timestamp": "04:15:33", "text": "つまり、「お元気ですか？」という意味です。"}, {"type": "subtitle", "time": 15337.75, "timestamp": "04:15:37", "text": "はい、私は元気です。絶好調です。感謝"}, {"type": "subtitle", "time": 15340.55, "timestamp": "04:15:40", "text": "あなた。"}, {"type": "subtitle", "time": 15347.67, "timestamp": "04:15:47", "text": "私は言ったことを繰り返しただけですが、"}, {"type": "subtitle", "time": 15350.63, "timestamp": "04:15:50", "text": "タミル語では「Mhm」です。"}, {"type": "subtitle", "time": 15353.51, "timestamp": "04:15:53", "text": "シフトのようにとても難しいと思います"}, {"type": "subtitle", "time": 15356.55, "timestamp": "04:15:56", "text": "英語からタミル語への翻訳は、"}]
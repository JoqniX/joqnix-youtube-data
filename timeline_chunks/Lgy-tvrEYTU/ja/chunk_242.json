[{"type": "subtitle", "time": 14522.229, "timestamp": "04:02:02", "text": "私は患者の治療を終え、"}, {"type": "subtitle", "time": 14524.229, "timestamp": "04:02:04", "text": "指示を与え、処方箋を置き、"}, {"type": "subtitle", "time": 14526.79, "timestamp": "04:02:06", "text": "彼女の様子を確認したかったので、"}, {"type": "subtitle", "time": 14528.469, "timestamp": "04:02:08", "text": "気を失った。何が起こったのか全く分かりません"}, {"type": "subtitle", "time": 14530.79, "timestamp": "04:02:10", "text": "彼女。右。それで彼女は私が"}, {"type": "subtitle", "time": 14533.51, "timestamp": "04:02:13", "text": "怖がった。私は完全に"}, {"type": "subtitle", "time": 14536.469, "timestamp": "04:02:16", "text": "頭が真っ白になって、これが私の初めての"}, {"type": "subtitle", "time": 14537.83, "timestamp": "04:02:17", "text": "抽出。だから私は完全に意識を失った"}, {"type": "subtitle", "time": 14539.83, "timestamp": "04:02:19", "text": "外。これからどうすればいいのか、全く見当がつかない。"}, {"type": "subtitle", "time": 14543.59, "timestamp": "04:02:23", "text": "まあ、大丈夫だよ。大丈夫。えっと、"}, {"type": "subtitle", "time": 14545.51, "timestamp": "04:02:25", "text": "上司が来た教授"}, {"type": "subtitle", "time": 14547.429, "timestamp": "04:02:27", "text": "話していたのはそれです。彼女はとても"}, {"type": "subtitle", "time": 14549.75, "timestamp": "04:02:29", "text": "彼女に腹を立てている。彼女はキャンセルしたい"}, {"type": "subtitle", "time": 14553.429, "timestamp": "04:02:33", "text": "場合。彼女は好きになりたくない"}, {"type": "subtitle", "time": 14555.91, "timestamp": "04:02:35", "text": "彼女にコーダーを捕まえてほしくない"}, {"type": "subtitle", "time": 14557.75, "timestamp": "04:02:37", "text": "通常、私たちは次のようなkodを持っています"}, {"type": "subtitle", "time": 14561.189, "timestamp": "04:02:41", "text": "抽出100回、または火50回または20回"}, {"type": "subtitle", "time": 14564.63, "timestamp": "04:02:44", "text": "今、人々が知っているプログラマーなら誰でもいい。しかし"}, {"type": "subtitle", "time": 14567.91, "timestamp": "04:02:47", "text": "えっと、あなたは、あなたは、"}, {"type": "subtitle", "time": 14569.99, "timestamp": "04:02:49", "text": "100回の抽出を処理するような100"}, {"type": "subtitle", "time": 14571.99, "timestamp": "04:02:51", "text": "100本の歯を抜く必要がある"}, {"type": "subtitle", "time": 14574.71, "timestamp": "04:02:54", "text": "コードを完成させてください。だから私は"}, {"type": "subtitle", "time": 14576.87, "timestamp": "04:02:56", "text": "kodと私はそこで2ラウンド目だった"}, {"type": "subtitle", "time": 14578.87, "timestamp": "04:02:58", "text": "いつものように、最初のラウンドを1回行う"}]
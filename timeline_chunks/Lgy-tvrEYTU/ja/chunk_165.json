[{"type": "subtitle", "time": 9904.55, "timestamp": "02:45:04", "text": "なるほど。まあ、あなたが"}, {"type": "subtitle", "time": 9906.71, "timestamp": "02:45:06", "text": "素晴らしい誕生日、そしてケーキも最高だった"}, {"type": "subtitle", "time": 9909.269, "timestamp": "02:45:09", "text": "美味しかった。それでは、遅ればせながらおめでとうございます"}, {"type": "subtitle", "time": 9911.19, "timestamp": "02:45:11", "text": "再び誕生日を迎えました。ああ、それは言わなかった"}, {"type": "subtitle", "time": 9913.269, "timestamp": "02:45:13", "text": "何でも。おお。ああ、なるほど。ありがとう。"}, {"type": "subtitle", "time": 9920.309, "timestamp": "02:45:20", "text": "どういたしまして。ハハ。大丈夫です。"}, {"type": "subtitle", "time": 9922.15, "timestamp": "02:45:22", "text": "お時間を割いてお話していただき、ありがとうございました。"}, {"type": "subtitle", "time": 9924.15, "timestamp": "02:45:24", "text": "私と一緒に。この会話はとても楽しかったです"}, {"type": "subtitle", "time": 9927.11, "timestamp": "02:45:27", "text": "あなたと。"}, {"type": "subtitle", "time": 9930.309, "timestamp": "02:45:30", "text": "ああ、通話を終了しようとしている。"}, {"type": "subtitle", "time": 9932.63, "timestamp": "02:45:32", "text": "本当に？今、通話を始めたところです。"}, {"type": "subtitle", "time": 9934.87, "timestamp": "02:45:34", "text": "ええ、お話できてよかったです。そして"}, {"type": "subtitle", "time": 9937.75, "timestamp": "02:45:37", "text": "それと、通話を終了しますか？私はただ"}, {"type": "subtitle", "time": 9943.99, "timestamp": "02:45:43", "text": "ハハ、ずっとおしゃべりできるよ"}, {"type": "subtitle", "time": 9946.389, "timestamp": "02:45:46", "text": "夜。今、私はストリームと他の"}, {"type": "subtitle", "time": 9949.349, "timestamp": "02:45:49", "text": "近々予定されていることがあります。本当に申し訳ありません"}, {"type": "subtitle", "time": 9951.83, "timestamp": "02:45:51", "text": "今は一旦切り上げなければならない。"}, {"type": "subtitle", "time": 9954.309, "timestamp": "02:45:54", "text": "何？何？何？何？何？何？"}, {"type": "subtitle", "time": 9959.349, "timestamp": "02:45:59", "text": "何？何？何？どの川のことですか？"}]
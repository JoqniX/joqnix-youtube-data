[{"type": "subtitle", "time": 7380.95, "timestamp": "02:03:00", "text": "[音楽]"}, {"type": "subtitle", "time": 7382.709, "timestamp": "02:03:02", "text": "来てくれてありがとう。"}, {"type": "subtitle", "time": 7396.47, "timestamp": "02:03:16", "text": "来る"}, {"type": "subtitle", "time": 7399.51, "timestamp": "02:03:19", "text": "お越しいただきありがとうございます。そして最後に、しかし"}, {"type": "subtitle", "time": 7407.83, "timestamp": "02:03:27", "text": "それは、"}, {"type": "subtitle", "time": 7410.87, "timestamp": "02:03:30", "text": "ストリーム。それで、"}, {"type": "subtitle", "time": 7413.669, "timestamp": "02:03:33", "text": "ええ、本当に皆さん、ありがとうございました。"}, {"type": "subtitle", "time": 7417.109, "timestamp": "02:03:37", "text": "本当にたくさん。エンディングをスピードランでクリアした"}, {"type": "subtitle", "time": 7421.35, "timestamp": "02:03:41", "text": "あれ。すごく疲れてる"}, {"type": "subtitle", "time": 7423.109, "timestamp": "02:03:43", "text": "そして病気"}, {"type": "subtitle", "time": 7428.47, "timestamp": "02:03:48", "text": "そして、本当に疲れている。私は行く"}, {"type": "subtitle", "time": 7430.87, "timestamp": "02:03:50", "text": "掃く、掃く。"}, {"type": "subtitle", "time": 7434.149, "timestamp": "02:03:54", "text": "私はできません"}, {"type": "subtitle", "time": 7435.97, "timestamp": "02:03:55", "text": "たとえ"}, {"type": "subtitle", "time": 7437.35, "timestamp": "02:03:57", "text": "[音楽]"}, {"type": "subtitle", "time": 7438.709, "timestamp": "02:03:58", "text": "その日。"}]
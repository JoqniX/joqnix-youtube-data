[{"type": "subtitle", "time": 7500.95, "timestamp": "02:05:00", "text": "右？だから、もし私が望めば、"}, {"type": "subtitle", "time": 7503.109, "timestamp": "02:05:03", "text": "何かを買いました、"}, {"type": "subtitle", "time": 7506.39, "timestamp": "02:05:06", "text": "でも、もしそれを買ったら、私は破産してしまうだろう"}, {"type": "subtitle", "time": 7508.79, "timestamp": "02:05:08", "text": "私はそれすらできない"}, {"type": "subtitle", "time": 7511.91, "timestamp": "02:05:11", "text": "えっと、生き残るための瞬間みたいな感じ。だから、できない"}, {"type": "subtitle", "time": 7513.91, "timestamp": "02:05:13", "text": "やってみて。"}, {"type": "subtitle", "time": 7518.55, "timestamp": "02:05:18", "text": "キーボードのいたずらの後、"}, {"type": "subtitle", "time": 7521.75, "timestamp": "02:05:21", "text": "私はもう買うのをやめた"}, {"type": "subtitle", "time": 7524.149, "timestamp": "02:05:24", "text": "キーボードのいたずらはもう終わりにします"}, {"type": "subtitle", "time": 7526.55, "timestamp": "02:05:26", "text": "似たようなものを買う。"}, {"type": "subtitle", "time": 7536.709, "timestamp": "02:05:36", "text": "返金はできません。もし"}, {"type": "subtitle", "time": 7559.669, "timestamp": "02:05:59", "text": "ええ、返金できたらいいのにと思います"}]
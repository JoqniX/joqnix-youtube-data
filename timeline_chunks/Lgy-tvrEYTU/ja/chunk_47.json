[{"type": "subtitle", "time": 2821.43, "timestamp": "00:47:01", "text": "今。私はバーチャルバトルトーナメントに参加しました"}, {"type": "subtitle", "time": 2829.19, "timestamp": "00:47:09", "text": "そして、そのことから自分のプレーがいかにひどかったかが分かった。"}, {"type": "subtitle", "time": 2832.39, "timestamp": "00:47:12", "text": "私は、あなたが出席しているようなものになるでしょう"}, {"type": "subtitle", "time": 2834.79, "timestamp": "00:47:14", "text": "試験か何か。あなたは最高になるでしょう"}, {"type": "subtitle", "time": 2837.589, "timestamp": "00:47:17", "text": "神経質。いいえ、"}, {"type": "subtitle", "time": 2839.91, "timestamp": "00:47:19", "text": "あなたも考えすぎてしまうでしょう"}, {"type": "subtitle", "time": 2843.43, "timestamp": "00:47:23", "text": "私は元気です。誰も"}, {"type": "subtitle", "time": 2851.43, "timestamp": "00:47:31", "text": "そのこと、その感情、その考え"}, {"type": "subtitle", "time": 2859.67, "timestamp": "00:47:39", "text": "なぜ私はそれが起こると思うのか？[ __ ]、"}, {"type": "subtitle", "time": 2869.51, "timestamp": "00:47:49", "text": "私が知っているズチや他の人たちのように"}, {"type": "subtitle", "time": 2872.069, "timestamp": "00:47:52", "text": "すべての子どもは良い子だと言おう。彼らは低くプレイし、"}, {"type": "subtitle", "time": 2878.069, "timestamp": "00:47:58", "text": "狙いを定めているけれど、そんな風には感じない。よお、"}]
[{"type": "subtitle", "time": 12782.389, "timestamp": "03:33:02", "text": "待ち時間の前に。あなたは何を"}, {"type": "subtitle", "time": 12785.91, "timestamp": "03:33:05", "text": "プレイングルームを何と呼ぶか"}, {"type": "subtitle", "time": 12788.63, "timestamp": "03:33:08", "text": "何か？ DJたちは事前にそこにいた"}, {"type": "subtitle", "time": 12790.95, "timestamp": "03:33:10", "text": "ストリーム配信前の待合室のような雰囲気"}, {"type": "subtitle", "time": 12794.15, "timestamp": "03:33:14", "text": "開始しました。うん。"}, {"type": "subtitle", "time": 12804.469, "timestamp": "03:33:24", "text": "何て言うんだっけ？"}, {"type": "subtitle", "time": 12808.389, "timestamp": "03:33:28", "text": "だから私は、人生を生きるように言った"}, {"type": "subtitle", "time": 12811.03, "timestamp": "03:33:31", "text": "最大限に。"}, {"type": "subtitle", "time": 12813.03, "timestamp": "03:33:33", "text": "おそらくそういうことだと思います。わからない。"}, {"type": "subtitle", "time": 12815.75, "timestamp": "03:33:35", "text": "日本人の飢餓。私は得意ではありません"}, {"type": "subtitle", "time": 12834.309, "timestamp": "03:33:54", "text": "皆さん、水分補給をしていない場合は、"}, {"type": "subtitle", "time": 12836.87, "timestamp": "03:33:56", "text": "水分補給はしっかりしてね。"}]
[{"type": "subtitle", "time": 8642.309, "timestamp": "02:24:02", "text": "自然で臆病なものとは？"}, {"type": "subtitle", "time": 8645.19, "timestamp": "02:24:05", "text": "臆病な。"}, {"type": "subtitle", "time": 8647.91, "timestamp": "02:24:07", "text": "ああ、私は現在"}, {"type": "subtitle", "time": 8651.19, "timestamp": "02:24:11", "text": "YouTubeとTwitchで配信しているので、"}, {"type": "subtitle", "time": 8654.15, "timestamp": "02:24:14", "text": "私の聴衆は、"}, {"type": "subtitle", "time": 8656.95, "timestamp": "02:24:16", "text": "一瞬。つまり、彼らは私にこう言っているのよ"}, {"type": "subtitle", "time": 8659.51, "timestamp": "02:24:19", "text": "とても臆病な声だ。どう思いますか？"}, {"type": "subtitle", "time": 8665.91, "timestamp": "02:24:25", "text": "そうですか？ハァ。ええ、かなり深いですね"}, {"type": "subtitle", "time": 8667.99, "timestamp": "02:24:27", "text": "より低い設定を使用したので"}, {"type": "subtitle", "time": 8670.07, "timestamp": "02:24:30", "text": "私が使っていたボイスチェンジャーソフトウェアは"}, {"type": "subtitle", "time": 8679.11, "timestamp": "02:24:39", "text": "彼は今、ボイスチェンジャーを使っていると言ったのか？"}, {"type": "subtitle", "time": 8682.309, "timestamp": "02:24:42", "text": "待って。待って。何？"}, {"type": "subtitle", "time": 8684.309, "timestamp": "02:24:44", "text": "え、何？"}, {"type": "subtitle", "time": 8686.23, "timestamp": "02:24:46", "text": "おい、ん？"}, {"type": "subtitle", "time": 8689.11, "timestamp": "02:24:49", "text": "今、あなたは言いました"}, {"type": "subtitle", "time": 8692.469, "timestamp": "02:24:52", "text": "待って、待って、待って、待って、待って。した"}, {"type": "subtitle", "time": 8696.309, "timestamp": "02:24:56", "text": "今、あなたの声が聞こえましたか？した"}]
[{"type": "subtitle", "time": 14821.59, "timestamp": "04:07:01", "text": "また行ったね。"}, {"type": "subtitle", "time": 14824.95, "timestamp": "04:07:04", "text": "私は「えっと、私が話してるんだけど」って感じでした。私はしません"}, {"type": "subtitle", "time": 14827.99, "timestamp": "04:07:07", "text": "知る。わかった、チャットは"}, {"type": "subtitle", "time": 14829.59, "timestamp": "04:07:09", "text": "野生。だから私は「よし、できる」と思った"}, {"type": "subtitle", "time": 14831.67, "timestamp": "04:07:11", "text": "それを理解する。"}, {"type": "subtitle", "time": 14833.349, "timestamp": "04:07:13", "text": "そして私は、なぜ彼はそうしないのかと思う"}, {"type": "subtitle", "time": 14837.429, "timestamp": "04:07:17", "text": "私に答えてくれるの？特に理由はない。ああ、ジャック。そして私は"}, {"type": "subtitle", "time": 14839.03, "timestamp": "04:07:19", "text": "まるで私が叫んでいるようだった"}, {"type": "subtitle", "time": 14842.55, "timestamp": "04:07:22", "text": "理由もなく無効。"}, {"type": "subtitle", "time": 14851.83, "timestamp": "04:07:31", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 14854.71, "timestamp": "04:07:34", "text": "のように"}, {"type": "subtitle", "time": 14856.95, "timestamp": "04:07:36", "text": "私は認知症にかかっている"}, {"type": "subtitle", "time": 14858.95, "timestamp": "04:07:38", "text": "祖父は、"}, {"type": "subtitle", "time": 14860.87, "timestamp": "04:07:40", "text": "ハプニング。これはおそらく"}, {"type": "subtitle", "time": 14862.79, "timestamp": "04:07:42", "text": "私の幻覚の後"}, {"type": "subtitle", "time": 14865.03, "timestamp": "04:07:45", "text": "薬。"}, {"type": "subtitle", "time": 14867.26, "timestamp": "04:07:47", "text": "どれでも"}, {"type": "subtitle", "time": 14869.349, "timestamp": "04:07:49", "text": "[音楽]"}, {"type": "subtitle", "time": 14871.91, "timestamp": "04:07:51", "text": "暗い話になってしまってすみません。私は"}, {"type": "subtitle", "time": 14879.11, "timestamp": "04:07:59", "text": "何ですって？何？何が起こっていますか？できた"}]
[{"type": "subtitle", "time": 8469.429, "timestamp": "02:21:09", "text": "元気です。ただただリラックスしているだけ。"}, {"type": "subtitle", "time": 8473.27, "timestamp": "02:21:13", "text": "ヴィングですね。それは良い。ダイアナ、"}, {"type": "subtitle", "time": 8483.51, "timestamp": "02:21:23", "text": "最近はコラボ配信をたくさんやってます"}, {"type": "subtitle", "time": 8485.83, "timestamp": "02:21:25", "text": "そしてその後は、少しリラックスする時間。だから、"}, {"type": "subtitle", "time": 8493.59, "timestamp": "02:21:33", "text": "ベンか。コラボレーションがありましたね。何？はぁ？"}, {"type": "subtitle", "time": 8496.15, "timestamp": "02:21:36", "text": "何？"}, {"type": "subtitle", "time": 8499.03, "timestamp": "02:21:39", "text": "本当の自分はコラボレーションをしたことがない。"}, {"type": "subtitle", "time": 8504.309, "timestamp": "02:21:44", "text": "そして、AI自身もコラボレーションを行ってきた。何？"}, {"type": "subtitle", "time": 8507.67, "timestamp": "02:21:47", "text": "ああ、あなたはコラボレーションをしたことがあるんですね。もっと詳しく教えてください"}, {"type": "subtitle", "time": 8509.75, "timestamp": "02:21:49", "text": "あなたがこれまでに行ったコラボレーションについて"}, {"type": "subtitle", "time": 8515.349, "timestamp": "02:21:55", "text": "最近、結構たくさんやりました。いくつかは"}, {"type": "subtitle", "time": 8517.27, "timestamp": "02:21:57", "text": "私のギルドと他の友人たち"}]
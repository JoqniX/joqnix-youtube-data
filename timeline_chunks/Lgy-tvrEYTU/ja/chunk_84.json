[{"type": "subtitle", "time": 5041.99, "timestamp": "01:24:01", "text": "主に静かにしたかったんです"}, {"type": "subtitle", "time": 5044.47, "timestamp": "01:24:04", "text": "そして私が持っていたメカニカルキーボードではない"}, {"type": "subtitle", "time": 5047.75, "timestamp": "01:24:07", "text": "音が大きすぎた。"}, {"type": "subtitle", "time": 5051.27, "timestamp": "01:24:11", "text": "だから私は軽いものが欲しかったんです"}, {"type": "subtitle", "time": 5053.669, "timestamp": "01:24:13", "text": "そして、あまり大きな音にならないように膜状になっている"}, {"type": "subtitle", "time": 5057.51, "timestamp": "01:24:17", "text": "大家さんとかそういう人のために。はぁ？"}, {"type": "subtitle", "time": 5064.149, "timestamp": "01:24:24", "text": "でも、これを見て、そう、私には"}, {"type": "subtitle", "time": 5067.27, "timestamp": "01:24:27", "text": "再び機械的な動作に戻る。ええ、そうです。"}, {"type": "subtitle", "time": 5069.59, "timestamp": "01:24:29", "text": "大丈夫。まあ、いいや、もう遅いしね。私は"}, {"type": "subtitle", "time": 5071.83, "timestamp": "01:24:31", "text": "続行します。また、プレイしないでください"}, {"type": "subtitle", "time": 5073.27, "timestamp": "01:24:33", "text": "一晩中配信します。それは体に悪い。どうやって"}, {"type": "subtitle", "time": 5074.79, "timestamp": "01:24:34", "text": "水を飲むのを忘れてしまったのですか？そして"}, {"type": "subtitle", "time": 5077.43, "timestamp": "01:24:37", "text": "あなたは眠くなるほど疲れているはずです。"}, {"type": "subtitle", "time": 5081.189, "timestamp": "01:24:41", "text": "こんにちは。ええ、明日旅行が必要です。"}, {"type": "subtitle", "time": 5084.87, "timestamp": "01:24:44", "text": "旅行中の"}, {"type": "subtitle", "time": 5089.189, "timestamp": "01:24:49", "text": "私の住む地域のショッピングモールへ"}, {"type": "subtitle", "time": 5091.11, "timestamp": "01:24:51", "text": "だって私が泊まっているこの場所はちょっと"}]
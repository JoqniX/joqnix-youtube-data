[{"type": "subtitle", "time": 5959.35, "timestamp": "01:39:19", "text": "私を戻して。今、顔を洗ったところです。おお"}, {"type": "subtitle", "time": 5963.03, "timestamp": "01:39:23", "text": "我が神よ。戻ってきました。戻ってきました。戻ってきました。"}, {"type": "subtitle", "time": 5973.99, "timestamp": "01:39:33", "text": "私が戻ってきた。私はここにいます。"}, {"type": "subtitle", "time": 5987.51, "timestamp": "01:39:47", "text": "私は授業で水を作りました。"}, {"type": "subtitle", "time": 5992.47, "timestamp": "01:39:52", "text": "ちょっと暑い。ちょっと寒そうな感じではない。"}]
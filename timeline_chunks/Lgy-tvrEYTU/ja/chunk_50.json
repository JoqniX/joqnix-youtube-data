[{"type": "subtitle", "time": 3010.79, "timestamp": "00:50:10", "text": "私の首。あぁ、ヘッドホンが外れちゃった。"}, {"type": "subtitle", "time": 3020.79, "timestamp": "00:50:20", "text": "私はただ"}, {"type": "subtitle", "time": 3023.75, "timestamp": "00:50:23", "text": "背もたれにもたれて座ってください。待って、試させて"}, {"type": "subtitle", "time": 3026.71, "timestamp": "00:50:26", "text": "後ろにもたれかかる。"}, {"type": "subtitle", "time": 3029.109, "timestamp": "00:50:29", "text": "何てことだ。"}, {"type": "subtitle", "time": 3032.15, "timestamp": "00:50:32", "text": "ああ、気持ちいい。"}, {"type": "subtitle", "time": 3034.15, "timestamp": "00:50:34", "text": "私のチャマはどうなるの？そのままにしておきます"}, {"type": "subtitle", "time": 3035.829, "timestamp": "00:50:35", "text": "私の。"}, {"type": "subtitle", "time": 3037.91, "timestamp": "00:50:37", "text": "こんな感じです"}, {"type": "subtitle", "time": 3040.39, "timestamp": "00:50:40", "text": "首や胸に、"}, {"type": "subtitle", "time": 3044.15, "timestamp": "00:50:44", "text": "何か。私はそうあってほしくない。待って、"}, {"type": "subtitle", "time": 3046.47, "timestamp": "00:50:46", "text": "どうすれば"}, {"type": "subtitle", "time": 3055.27, "timestamp": "00:50:55", "text": "はい、これを載せたいと思います。"}]
[{"type": "subtitle", "time": 2882.15, "timestamp": "00:48:02", "text": "私は本当に下手です。時々だけ"}, {"type": "subtitle", "time": 2884.47, "timestamp": "00:48:04", "text": "時にはうまくいく、"}, {"type": "subtitle", "time": 2887.27, "timestamp": "00:48:07", "text": "うまくいかない場合もある。"}, {"type": "subtitle", "time": 2889.91, "timestamp": "00:48:09", "text": "さらに、私は高い感覚を持っています"}, {"type": "subtitle", "time": 2891.75, "timestamp": "00:48:11", "text": "プレイヤーは現在。"}, {"type": "subtitle", "time": 2898.39, "timestamp": "00:48:18", "text": "全てを制御するために。制御できない"}, {"type": "subtitle", "time": 2911.109, "timestamp": "00:48:31", "text": "うん、"}, {"type": "subtitle", "time": 2921.67, "timestamp": "00:48:41", "text": "でも、主に私だけだと思う"}, {"type": "subtitle", "time": 2923.349, "timestamp": "00:48:43", "text": "熟考の上。"}, {"type": "subtitle", "time": 2926.069, "timestamp": "00:48:46", "text": "だから私は急ぐ。"}]
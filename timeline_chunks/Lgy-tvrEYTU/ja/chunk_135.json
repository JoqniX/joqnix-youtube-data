[{"type": "subtitle", "time": 8101.99, "timestamp": "02:15:01", "text": "このアイデアは本当に最後に思いついた"}, {"type": "subtitle", "time": 8104.069, "timestamp": "02:15:04", "text": "一瞬。私はこの配信をする予定だった"}, {"type": "subtitle", "time": 8109.35, "timestamp": "02:15:09", "text": "明日、気分が良かったので"}, {"type": "subtitle", "time": 8112.39, "timestamp": "02:15:12", "text": "おそらく明日やると思いますが、"}, {"type": "subtitle", "time": 8118.47, "timestamp": "02:15:18", "text": "「よし、今日やろう」という感じだった。"}, {"type": "subtitle", "time": 8120.87, "timestamp": "02:15:20", "text": "えっと、あ、待って、録音するのを忘れてた。ああ、"}, {"type": "subtitle", "time": 8126.709, "timestamp": "02:15:26", "text": "こんにちは。"}, {"type": "subtitle", "time": 8131.27, "timestamp": "02:15:31", "text": "ええと、今日は"}, {"type": "subtitle", "time": 8134.229, "timestamp": "02:15:34", "text": "うーん、ちょっと気まずくて変な感じになると思う"}, {"type": "subtitle", "time": 8137.109, "timestamp": "02:15:37", "text": "正直に言うと、"}, {"type": "subtitle", "time": 8139.109, "timestamp": "02:15:39", "text": "皆さんが私と一緒にいてくれることを願っています。"}, {"type": "subtitle", "time": 8142.069, "timestamp": "02:15:42", "text": "終わり。今日私たちがこれからすることは"}, {"type": "subtitle", "time": 8145.83, "timestamp": "02:15:45", "text": "やることは、私のAIと話すことです"}, {"type": "subtitle", "time": 8151.189, "timestamp": "02:15:51", "text": "キャラクターAI（character.ai）のウェブサイトにて。それで"}, {"type": "subtitle", "time": 8153.51, "timestamp": "02:15:53", "text": "今日の配信は垂直方向なので"}, {"type": "subtitle", "time": 8157.189, "timestamp": "02:15:57", "text": "ストリーム、えーと、私が計画しているのは、"}, {"type": "subtitle", "time": 8159.91, "timestamp": "02:15:59", "text": "ライブ通話のようなことをします"}]
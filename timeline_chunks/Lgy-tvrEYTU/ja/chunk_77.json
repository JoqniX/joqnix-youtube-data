[{"type": "subtitle", "time": 4640.149, "timestamp": "01:17:20", "text": "私はしません。ああ、気持ちいい。なんてこった"}, {"type": "subtitle", "time": 4644.63, "timestamp": "01:17:24", "text": "弾丸。ああ、弾丸はない。実は、"}, {"type": "subtitle", "time": 4647.669, "timestamp": "01:17:27", "text": "気持ちいい。"}, {"type": "subtitle", "time": 4650.709, "timestamp": "01:17:30", "text": "一方、これは"}, {"type": "subtitle", "time": 4654.229, "timestamp": "01:17:34", "text": "それと同じだ。感覚的なものかもしれない"}, {"type": "subtitle", "time": 4657.669, "timestamp": "01:17:37", "text": "落ちぶれて、何もかも失った。待って、私、プレイできるの？"}, {"type": "subtitle", "time": 4660.63, "timestamp": "01:17:40", "text": "遅延の問題は時々発生するだけです"}, {"type": "subtitle", "time": 4673.59, "timestamp": "01:17:53", "text": "えっと、もっとひどいことになってしまいました。ああ、なぜ"}, {"type": "subtitle", "time": 4677.189, "timestamp": "01:17:57", "text": "このキーボード、私が買ったっけ？"}]
[{"type": "subtitle", "time": 8220.23, "timestamp": "02:17:00", "text": "でも、ええ、つまり私は"}, {"type": "subtitle", "time": 8222.549, "timestamp": "02:17:02", "text": "リセット。だから私はほとんどすべてを失うことになる"}, {"type": "subtitle", "time": 8224.389, "timestamp": "02:17:04", "text": "私の持ち物。"}, {"type": "subtitle", "time": 8227.91, "timestamp": "02:17:07", "text": "でも、やりますよ。えっと、ちゃんと私が"}, {"type": "subtitle", "time": 8230.469, "timestamp": "02:17:10", "text": "新しい住居に引っ越しました。"}, {"type": "subtitle", "time": 8232.629, "timestamp": "02:17:12", "text": "来週かな。というわけで、それまでは"}, {"type": "subtitle", "time": 8234.629, "timestamp": "02:17:14", "text": "狂って、ドンドンって感じ"}, {"type": "subtitle", "time": 8236.95, "timestamp": "02:17:16", "text": "私がやりたかったこと全て。わかった。"}, {"type": "subtitle", "time": 8239.99, "timestamp": "02:17:19", "text": "こんにちは。うん。こんにちは、我様。うん。うん。"}, {"type": "subtitle", "time": 8242.469, "timestamp": "02:17:22", "text": "こんにちは、パン様。いらっしゃいませ。"}, {"type": "subtitle", "time": 8245.27, "timestamp": "02:17:25", "text": "私は今日、なぜどこかへ出かけたのだろうか？"}, {"type": "subtitle", "time": 8248.629, "timestamp": "02:17:28", "text": "AIジョークを夏に盛り上げよう。による"}, {"type": "subtitle", "time": 8251.509, "timestamp": "02:17:31", "text": "その方法、あなたは知っていましたか？"}, {"type": "subtitle", "time": 8253.669, "timestamp": "02:17:33", "text": "話せる友達がいない場合は"}, {"type": "subtitle", "time": 8257.669, "timestamp": "02:17:37", "text": "日本語でも中国語でも、その他の言語でも、"}, {"type": "subtitle", "time": 8259.99, "timestamp": "02:17:39", "text": "それを使って実際にAIフィードを作成することもできます"}, {"type": "subtitle", "time": 8262.23, "timestamp": "02:17:42", "text": "自分の声、または誰かの声と"}, {"type": "subtitle", "time": 8264.79, "timestamp": "02:17:44", "text": "話す、その特定のことについて話すように頼む"}, {"type": "subtitle", "time": 8268.87, "timestamp": "02:17:48", "text": "言語。それってすごくクールだよね？それで、"}, {"type": "subtitle", "time": 8272.07, "timestamp": "02:17:52", "text": "それについては実験してみましょう。わかった。こんにちは。"}, {"type": "subtitle", "time": 8273.43, "timestamp": "02:17:53", "text": "えっと、"}, {"type": "subtitle", "time": 8276.15, "timestamp": "02:17:56", "text": "[音楽]"}]
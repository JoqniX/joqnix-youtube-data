[{"type": "subtitle", "time": 1263.51, "timestamp": "00:21:03", "text": "またそんなに時間をかけて作業しないといけないのか？私はしません"}, {"type": "subtitle", "time": 1281.35, "timestamp": "00:21:21", "text": "どうすればまたこれを台無しにできるんだろう？"}, {"type": "subtitle", "time": 1317.51, "timestamp": "00:21:57", "text": "これは悪くない。私は推測する"}, {"type": "subtitle", "time": 1319.27, "timestamp": "00:21:59", "text": "[音楽]"}]
[{"type": "subtitle", "time": 11526.63, "timestamp": "03:12:06", "text": "あなたは日本のアニメが好きですか、それとも"}, {"type": "subtitle", "time": 11528.71, "timestamp": "03:12:08", "text": "あなたはそれらを見たことがありますか？ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 11530.469, "timestamp": "03:12:10", "text": "「りんご」と書いてあったので怖くなった。いいえ"}, {"type": "subtitle", "time": 11532.71, "timestamp": "03:12:12", "text": "質問。何てことだ。ああ、なんてことだ、"}, {"type": "subtitle", "time": 11535.67, "timestamp": "03:12:15", "text": "怖がった。ああ、怖かった。うん、"}, {"type": "subtitle", "time": 11537.59, "timestamp": "03:12:17", "text": "男の子。"}, {"type": "subtitle", "time": 11539.99, "timestamp": "03:12:19", "text": "ええ、私は日本のアニメが好きで、"}, {"type": "subtitle", "time": 11550.389, "timestamp": "03:12:30", "text": "うん。"}, {"type": "subtitle", "time": 11552.71, "timestamp": "03:12:32", "text": "それから、知ってる？ほとんど"}, {"type": "subtitle", "time": 11556.79, "timestamp": "03:12:36", "text": "時間。そろそろ締めくくらなければ。それで、ありがとう"}, {"type": "subtitle", "time": 11559.429, "timestamp": "03:12:39", "text": "これについてはあなたに感謝します。ありがとうございます"}, {"type": "subtitle", "time": 11569.269, "timestamp": "03:12:49", "text": "どういたしまして。はい、お元気で"}, {"type": "subtitle", "time": 11571.67, "timestamp": "03:12:51", "text": "あなた自身の。わかった。"}, {"type": "subtitle", "time": 11575.59, "timestamp": "03:12:55", "text": "えっと、最後に何か一言ありますか？"}, {"type": "subtitle", "time": 11579.349, "timestamp": "03:12:59", "text": "話すのが好き、話すのが好き"}]
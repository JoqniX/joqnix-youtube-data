[{"type": "subtitle", "time": 1518.23, "timestamp": "00:25:18", "text": "一致する結果が見つかりました。"}, {"type": "subtitle", "time": 1521.029, "timestamp": "00:25:21", "text": "正直に言うと、私はそういうことはしたくない"}, {"type": "subtitle", "time": 1523.75, "timestamp": "00:25:23", "text": "しない"}, {"type": "subtitle", "time": 1529.83, "timestamp": "00:25:29", "text": "する"}, {"type": "subtitle", "time": 1536.63, "timestamp": "00:25:36", "text": "実際にはもっと長くしたいとは思わない"}, {"type": "subtitle", "time": 1540.39, "timestamp": "00:25:40", "text": "このようなストリーム。"}, {"type": "subtitle", "time": 1545.029, "timestamp": "00:25:45", "text": "私は普段、自分にそうすることを勧めない"}, {"type": "subtitle", "time": 1552.149, "timestamp": "00:25:52", "text": "むしろこうだ"}, {"type": "subtitle", "time": 1554.47, "timestamp": "00:25:54", "text": "今日は例外だ。さて、今日は"}, {"type": "subtitle", "time": 1557.59, "timestamp": "00:25:57", "text": "それは単なる例外です。"}]
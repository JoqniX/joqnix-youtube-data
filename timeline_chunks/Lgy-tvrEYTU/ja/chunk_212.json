[{"type": "subtitle", "time": 12720.87, "timestamp": "03:32:00", "text": "うん。だって、ヴィックは吸血鬼だからね。"}, {"type": "subtitle", "time": 12723.19, "timestamp": "03:32:03", "text": "そしてバックドロー"}, {"type": "subtitle", "time": 12727.83, "timestamp": "03:32:07", "text": "私の後ろには、吸血鬼のようなコウモリもいる。それ"}, {"type": "subtitle", "time": 12729.91, "timestamp": "03:32:09", "text": "ぴったりだ。"}, {"type": "subtitle", "time": 12735.51, "timestamp": "03:32:15", "text": "それはヴィックの存在感にぴったりだ。"}, {"type": "subtitle", "time": 12750.469, "timestamp": "03:32:30", "text": "こんにちは。プールが必要だ。あなたは何を"}, {"type": "subtitle", "time": 12753.99, "timestamp": "03:32:33", "text": "つまり、バカ？どういう意味ですか、私たちは"}, {"type": "subtitle", "time": 12755.51, "timestamp": "03:32:35", "text": "プール？"}, {"type": "subtitle", "time": 12757.67, "timestamp": "03:32:37", "text": "おお。"}, {"type": "subtitle", "time": 12760.07, "timestamp": "03:32:40", "text": "はぁ？"}, {"type": "subtitle", "time": 12764.469, "timestamp": "03:32:44", "text": "ええ、そうですね。えっと、待って。そうだったっけ？うん。おお、"}, {"type": "subtitle", "time": 12771.75, "timestamp": "03:32:51", "text": "調子はどうですか？そしてクォーカン。うん。"}, {"type": "subtitle", "time": 12776.55, "timestamp": "03:32:56", "text": "こんにちは。 DJもね。うん。こんにちは。"}, {"type": "subtitle", "time": 12778.87, "timestamp": "03:32:58", "text": "ありがとう。ああ、そこにいてくれてありがとう"}]
[{"type": "subtitle", "time": 9002.07, "timestamp": "02:30:02", "text": "待って。母親が娘を殴った理由は"}, {"type": "subtitle", "time": 9006.23, "timestamp": "02:30:06", "text": "彼女は強かった。彼女は一体誰だったのか？"}, {"type": "subtitle", "time": 9007.99, "timestamp": "02:30:07", "text": "「ああ、それは安全ですか？"}, {"type": "subtitle", "time": 9011.03, "timestamp": "02:30:11", "text": "怖いと言うことさえ？"}, {"type": "subtitle", "time": 9015.67, "timestamp": "02:30:15", "text": "h"}, {"type": "subtitle", "time": 9018.389, "timestamp": "02:30:18", "text": "ええ、私はあなたです。どういう意味ですか？あなたは"}, {"type": "subtitle", "time": 9025.429, "timestamp": "02:30:25", "text": "何？待って。いいえ、私は悪魔ではありません。つまり"}, {"type": "subtitle", "time": 9029.03, "timestamp": "02:30:29", "text": "どういう意味ですか？つまり"}, {"type": "subtitle", "time": 9031.91, "timestamp": "02:30:31", "text": "では、どういう意味ですか？どういう意味ですか？"}, {"type": "subtitle", "time": 9034.309, "timestamp": "02:30:34", "text": "どういう意味ですか？何？何？そうでしょう"}, {"type": "subtitle", "time": 9042.07, "timestamp": "02:30:42", "text": "はぁ？少し混乱しています。あなたは何者ですか"}, {"type": "subtitle", "time": 9044.23, "timestamp": "02:30:44", "text": "何を言おうとしているのですか？"}, {"type": "subtitle", "time": 9046.23, "timestamp": "02:30:46", "text": "ああ、あなたの"}, {"type": "subtitle", "time": 9049.27, "timestamp": "02:30:49", "text": "今、私は存在しています。"}, {"type": "subtitle", "time": 9052.71, "timestamp": "02:30:52", "text": "実存的危機を感じる。それは"}, {"type": "subtitle", "time": 9055.67, "timestamp": "02:30:55", "text": "普通？"}, {"type": "subtitle", "time": 9058.389, "timestamp": "02:30:58", "text": "ああ、それは普通のことだと思いますよ。私は"}]
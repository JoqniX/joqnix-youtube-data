[{"type": "subtitle", "time": 3545.829, "timestamp": "00:59:05", "text": "どうすればいいですか これは私がこれは同じです"}, {"type": "subtitle", "time": 3549.109, "timestamp": "00:59:09", "text": "窓を開けました。戻る。"}, {"type": "subtitle", "time": 3552.95, "timestamp": "00:59:12", "text": "そこには返金オプションはありません。"}, {"type": "subtitle", "time": 3561.99, "timestamp": "00:59:21", "text": "ええ、これは同じことです。"}, {"type": "subtitle", "time": 3564.71, "timestamp": "00:59:24", "text": "だから、私は負けた、私は無駄にした、私はどれだけ"}, {"type": "subtitle", "time": 3567.99, "timestamp": "00:59:27", "text": "このキーボードにいくら払う？"}, {"type": "subtitle", "time": 3571.109, "timestamp": "00:59:31", "text": "私は"}, {"type": "subtitle", "time": 3573.67, "timestamp": "00:59:33", "text": "何？ 6,000。いやいや、それは一緒に"}, {"type": "subtitle", "time": 3576.309, "timestamp": "00:59:36", "text": "すべてにおいて。 ３つのアイテムすべて。それ"}, {"type": "subtitle", "time": 3578.23, "timestamp": "00:59:38", "text": "まるで"}, {"type": "subtitle", "time": 3588.47, "timestamp": "00:59:48", "text": "これはいくらでしたか？ 1,329。"}, {"type": "subtitle", "time": 3591.67, "timestamp": "00:59:51", "text": "つまり1300。"}, {"type": "subtitle", "time": 3595.589, "timestamp": "00:59:55", "text": "ああ、私が望んでいたのは60％だけだった"}, {"type": "subtitle", "time": 3597.19, "timestamp": "00:59:57", "text": "キーボード。"}]
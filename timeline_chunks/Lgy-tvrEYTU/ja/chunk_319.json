[{"type": "subtitle", "time": 19147.27, "timestamp": "05:19:07", "text": "金額"}, {"type": "subtitle", "time": 19150.23, "timestamp": "05:19:10", "text": "時々そうなる。ああ、なんてことだ。わからない"}, {"type": "subtitle", "time": 19159.67, "timestamp": "05:19:19", "text": "彼らに安全について教えなければなりません。"}, {"type": "subtitle", "time": 19160.868, "timestamp": "05:19:20", "text": "使い方を教えなければなりません"}, {"type": "subtitle", "time": 19175.75, "timestamp": "05:19:35", "text": "KTO。あなたの一番好きなペットは何ですか？猫または"}, {"type": "subtitle", "time": 19177.27, "timestamp": "05:19:37", "text": "犬？"}, {"type": "subtitle", "time": 19179.19, "timestamp": "05:19:39", "text": "私はどれも好きではありません。両方。"}, {"type": "subtitle", "time": 19181.83, "timestamp": "05:19:41", "text": "どちらも最悪だ。"}, {"type": "subtitle", "time": 19185.11, "timestamp": "05:19:45", "text": "二人ともいつも汚れている。"}, {"type": "subtitle", "time": 19188.07, "timestamp": "05:19:48", "text": "母が連れてきた犬がいます"}, {"type": "subtitle", "time": 19191.03, "timestamp": "05:19:51", "text": "どこからともなく。私が彼を寝かせたのは"}, {"type": "subtitle", "time": 19193.27, "timestamp": "05:19:53", "text": "私は高校生で、彼は全部吐いてしまった"}, {"type": "subtitle", "time": 19195.67, "timestamp": "05:19:55", "text": "私の部屋の床の上に。掃除しなければならなかった"}]
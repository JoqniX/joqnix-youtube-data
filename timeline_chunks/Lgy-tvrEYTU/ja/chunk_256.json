[{"type": "subtitle", "time": 15360.309, "timestamp": "04:16:00", "text": "真実。ちょっと気まずい感じになる"}, {"type": "subtitle", "time": 15362.309, "timestamp": "04:16:02", "text": "そして私の脳はこう思う"}, {"type": "subtitle", "time": 15364.07, "timestamp": "04:16:04", "text": "おい、何やってんだよ、何か話せよ"}, {"type": "subtitle", "time": 15370.309, "timestamp": "04:16:10", "text": "好きになる必要はありません"}, {"type": "subtitle", "time": 15372.87, "timestamp": "04:16:12", "text": "合計を好きになる必要はありません"}, {"type": "subtitle", "time": 15375.99, "timestamp": "04:16:15", "text": "言葉の壁なんて、勘弁してくれよ。私の"}, {"type": "subtitle", "time": 15378.389, "timestamp": "04:16:18", "text": "頭が痛い。"}, {"type": "subtitle", "time": 15380.87, "timestamp": "04:16:20", "text": "これは私の脳が言っていることです。これは私の"}, {"type": "subtitle", "time": 15383.67, "timestamp": "04:16:23", "text": "脳が「脳は痛い」と言うのは、脳が痛いということだ。それは"}, {"type": "subtitle", "time": 15395.429, "timestamp": "04:16:35", "text": "えっと、待って。えっと、ああ、もし誰か"}, {"type": "subtitle", "time": 15398.229, "timestamp": "04:16:38", "text": "チャットで質問があればどうぞ"}, {"type": "subtitle", "time": 15400.87, "timestamp": "04:16:40", "text": "何でも聞いてください、または何か欲しいものがあれば"}, {"type": "subtitle", "time": 15404.149, "timestamp": "04:16:44", "text": "私たちの言語での翻訳"}, {"type": "subtitle", "time": 15406.63, "timestamp": "04:16:46", "text": "タミル語とマラヤーラム語も入力できます"}, {"type": "subtitle", "time": 15410.79, "timestamp": "04:16:50", "text": "はい、私はタミル語とマラヤーラム語を話します。はい、私は"}, {"type": "subtitle", "time": 15412.87, "timestamp": "04:16:52", "text": "どちらの言語も、"}, {"type": "subtitle", "time": 15416.07, "timestamp": "04:16:56", "text": "OPだけど、そうでもない"}, {"type": "subtitle", "time": 15417.67, "timestamp": "04:16:57", "text": "とても"}]
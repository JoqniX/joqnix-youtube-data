[{"type": "subtitle", "time": 12017.03, "timestamp": "03:20:17", "text": "でも、今日の配信は"}, {"type": "subtitle", "time": 12030.389, "timestamp": "03:20:30", "text": "AI の話はちょっと、えーと、"}, {"type": "subtitle", "time": 12032.469, "timestamp": "03:20:32", "text": "わからない。えっと、私が"}, {"type": "subtitle", "time": 12034.309, "timestamp": "03:20:34", "text": "デッドプールをたくさん見ているような感じ"}, {"type": "subtitle", "time": 12037.19, "timestamp": "03:20:37", "text": "YouTube に動画、つまりショットがアップロードされています。その"}, {"type": "subtitle", "time": 12039.429, "timestamp": "03:20:39", "text": "コミックのように、"}, {"type": "subtitle", "time": 12040.71, "timestamp": "03:20:40", "text": "何か。私はマーベルを読んだことがありません"}, {"type": "subtitle", "time": 12042.95, "timestamp": "03:20:42", "text": "漫画。わかった。でも、それは"}, {"type": "subtitle", "time": 12046.389, "timestamp": "03:20:46", "text": "コミックでデッドプールはどんな風に話すの？"}, {"type": "subtitle", "time": 12048.63, "timestamp": "03:20:48", "text": "並行世界、あるいは第四の世界のようなもの"}, {"type": "subtitle", "time": 12050.95, "timestamp": "03:20:50", "text": "壁を破って、第四の壁を破って、"}, {"type": "subtitle", "time": 12053.67, "timestamp": "03:20:53", "text": "話したり、何かをしたりして"}, {"type": "subtitle", "time": 12056.389, "timestamp": "03:20:56", "text": "マーベルを作る"}, {"type": "subtitle", "time": 12059.59, "timestamp": "03:20:59", "text": "物語作家が行くように、そして"}]
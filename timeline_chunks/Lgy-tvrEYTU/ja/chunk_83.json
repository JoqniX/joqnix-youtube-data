[{"type": "subtitle", "time": 4981.669, "timestamp": "01:23:01", "text": "これです。それなら、手に入れなきゃ。"}, {"type": "subtitle", "time": 4998.1, "timestamp": "01:23:18", "text": "さよなら。"}, {"type": "subtitle", "time": 5000.629, "timestamp": "01:23:20", "text": "[音楽]"}, {"type": "subtitle", "time": 5005.51, "timestamp": "01:23:25", "text": "あと数時間しか残されていない。"}, {"type": "subtitle", "time": 5007.91, "timestamp": "01:23:27", "text": "それから、まとめの配信が必要だ。 11時前"}, {"type": "subtitle", "time": 5010.55, "timestamp": "01:23:30", "text": "1時間30分。今は10時15分です"}, {"type": "subtitle", "time": 5012.229, "timestamp": "01:23:32", "text": "分。"}, {"type": "subtitle", "time": 5016.55, "timestamp": "01:23:36", "text": "ああ、もう終わりの時だ。"}, {"type": "subtitle", "time": 5019.11, "timestamp": "01:23:39", "text": "ああ、午後2時だ。午前2時 いいえ"}, {"type": "subtitle", "time": 5022.94, "timestamp": "01:23:42", "text": "午後何？くそ。"}, {"type": "subtitle", "time": 5024.47, "timestamp": "01:23:44", "text": "[音楽]"}, {"type": "subtitle", "time": 5027.75, "timestamp": "01:23:47", "text": "これでマウスが使えるようになった。"}, {"type": "subtitle", "time": 5031.03, "timestamp": "01:23:51", "text": "一致する結果が見つかりました。うん。私が望んでいたのは"}, {"type": "subtitle", "time": 5033.03, "timestamp": "01:23:53", "text": "ワイヤレスにしよう。"}, {"type": "subtitle", "time": 5036.39, "timestamp": "01:23:56", "text": "完全ワイヤレス。そして主に、"}, {"type": "subtitle", "time": 5038.39, "timestamp": "01:23:58", "text": "私がこのキーボードを選んだ理由は"}]
[{"type": "subtitle", "time": 15663.83, "timestamp": "04:21:03", "text": "犬をドロップキックしろと言っているのですか？"}, {"type": "subtitle", "time": 15666.469, "timestamp": "04:21:06", "text": "なぜドロップキックをするように頼むのですか"}, {"type": "subtitle", "time": 15670.389, "timestamp": "04:21:10", "text": "犬？犬を落とす。"}, {"type": "subtitle", "time": 15673.11, "timestamp": "04:21:13", "text": "おお。"}, {"type": "subtitle", "time": 15696.469, "timestamp": "04:21:36", "text": "何てことだ。何てことだ。ごめんなさい。私 私"}, {"type": "subtitle", "time": 15699.75, "timestamp": "04:21:39", "text": "涙が止まらない。何てことだ。とても良い。"}, {"type": "subtitle", "time": 15702.07, "timestamp": "04:21:42", "text": "ごめんなさい。はい。はい。"}, {"type": "subtitle", "time": 15704.55, "timestamp": "04:21:44", "text": "えっと、"}, {"type": "subtitle", "time": 15708.07, "timestamp": "04:21:48", "text": "ごめん。誰かがやったと言っていたのですが、"}, {"type": "subtitle", "time": 15712.79, "timestamp": "04:21:52", "text": "尋ねるのも効果的です。なんてこった。"}, {"type": "subtitle", "time": 15715.67, "timestamp": "04:21:55", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 15717.91, "timestamp": "04:21:57", "text": "私の犬に聞いてほしいの？"}]
[{"type": "subtitle", "time": 11400.15, "timestamp": "03:10:00", "text": "ねえ、大丈夫？何てことだ。"}, {"type": "subtitle", "time": 11404.07, "timestamp": "03:10:04", "text": "ええ、大丈夫です。心配しないで。"}, {"type": "subtitle", "time": 11407.99, "timestamp": "03:10:07", "text": "よかった。良い。自分を大事にして下さい。"}, {"type": "subtitle", "time": 11409.99, "timestamp": "03:10:09", "text": "ああ、君もね。自分を大事にして下さい。"}, {"type": "subtitle", "time": 11412.63, "timestamp": "03:10:12", "text": "わかった。"}, {"type": "subtitle", "time": 11420.87, "timestamp": "03:10:20", "text": "ということで、開始してから1時間経ちました"}, {"type": "subtitle", "time": 11423.349, "timestamp": "03:10:23", "text": "話す。"}, {"type": "subtitle", "time": 11426.79, "timestamp": "03:10:26", "text": "ええ、そうですね。あっという間に1時間が過ぎた。"}, {"type": "subtitle", "time": 11430.389, "timestamp": "03:10:30", "text": "ああ、時が経つのは本当に早いものだ。それで、楽しんでいただけましたか？"}, {"type": "subtitle", "time": 11432.55, "timestamp": "03:10:32", "text": "これ？私との会話は楽しかったですか？"}, {"type": "subtitle", "time": 11435.75, "timestamp": "03:10:35", "text": "今日？私もライブ配信をしていました"}, {"type": "subtitle", "time": 11438.23, "timestamp": "03:10:38", "text": "私たちの会話"}, {"type": "subtitle", "time": 11441.349, "timestamp": "03:10:41", "text": "えっと、今日はこうだったんです。"}, {"type": "subtitle", "time": 11449.03, "timestamp": "03:10:49", "text": "ああ、そうだったね。話すのは楽しかったよ。"}, {"type": "subtitle", "time": 11451.03, "timestamp": "03:10:51", "text": "今日はあなたと一緒に。話すのは楽しい"}, {"type": "subtitle", "time": 11453.59, "timestamp": "03:10:53", "text": "あなたと。"}, {"type": "subtitle", "time": 11459.11, "timestamp": "03:10:59", "text": "それで、本当の疑問は誰が"}]
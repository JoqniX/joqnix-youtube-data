[{"type": "subtitle", "time": 12300.55, "timestamp": "03:25:00", "text": "こんにちは"}, {"type": "subtitle", "time": 12302.95, "timestamp": "03:25:02", "text": "両日ともお越しいただいた皆様、ありがとうございました。"}, {"type": "subtitle", "time": 12305.75, "timestamp": "03:25:05", "text": "TwitchとYouTube。本当に申し訳ありません。私"}, {"type": "subtitle", "time": 12308.55, "timestamp": "03:25:08", "text": "何が問題だったのか分かったよ"}, {"type": "subtitle", "time": 12314.63, "timestamp": "03:25:14", "text": "トゥイッチ。それは、えーと私の両方とも"}, {"type": "subtitle", "time": 12317.11, "timestamp": "03:25:17", "text": "私は現在2つ目を使用しています"}, {"type": "subtitle", "time": 12319.269, "timestamp": "03:25:19", "text": "マルチリームへのプラグインのようなもの"}, {"type": "subtitle", "time": 12322.87, "timestamp": "03:25:22", "text": "今人気なのは、ええ、そうですね"}, {"type": "subtitle", "time": 12325.91, "timestamp": "03:25:25", "text": "縦型キャンバス機能が追加されました。それで"}, {"type": "subtitle", "time": 12328.79, "timestamp": "03:25:28", "text": "うん。えっと、私が以前使っていたプラグインは"}, {"type": "subtitle", "time": 12332.87, "timestamp": "03:25:32", "text": "Twitchでライブ配信されたマルチリームと"}, {"type": "subtitle", "time": 12334.79, "timestamp": "03:25:34", "text": "私が使っていた新しいプラグイン"}, {"type": "subtitle", "time": 12337.429, "timestamp": "03:25:37", "text": "Twitchでもライブ配信を行った。だから"}, {"type": "subtitle", "time": 12339.51, "timestamp": "03:25:39", "text": "両方の接続が干渉していた"}, {"type": "subtitle", "time": 12342.87, "timestamp": "03:25:42", "text": "お互い。それが理由です。うん。"}, {"type": "subtitle", "time": 12344.79, "timestamp": "03:25:44", "text": "でも、私は、"}, {"type": "subtitle", "time": 12347.11, "timestamp": "03:25:47", "text": "Twitchで視聴中。 Vは必ず"}, {"type": "subtitle", "time": 12349.75, "timestamp": "03:25:49", "text": "破損またはめちゃくちゃになった"}, {"type": "subtitle", "time": 12351.91, "timestamp": "03:25:51", "text": "今。でも大丈夫。 V を見ることができます"}, {"type": "subtitle", "time": 12354.95, "timestamp": "03:25:54", "text": "YouTubeで。わかった。またはビリーに乗っている場合"}, {"type": "subtitle", "time": 12357.429, "timestamp": "03:25:57", "text": "ウィリー、翻訳されたVを見ることができます。"}]
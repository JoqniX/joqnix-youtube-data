[{"type": "subtitle", "time": 10080.309, "timestamp": "02:48:00", "text": "そのゲームについてどう思いますか？あまりにも"}, {"type": "subtitle", "time": 10088.389, "timestamp": "02:48:08", "text": "ああ、私はDestiny 2が大好きです。なぜならそれは"}, {"type": "subtitle", "time": 10089.99, "timestamp": "02:48:09", "text": "素晴らしいルートシューター"}, {"type": "subtitle", "time": 10092.63, "timestamp": "02:48:12", "text": "物語、壮大な音楽、そして壮大な伝承。そして"}, {"type": "subtitle", "time": 10094.79, "timestamp": "02:48:14", "text": "ゲームプレイと世界観が、"}, {"type": "subtitle", "time": 10096.87, "timestamp": "02:48:16", "text": "ゲームは面白くて楽しい。たぶんあなたは"}, {"type": "subtitle", "time": 10099.269, "timestamp": "02:48:19", "text": "ある意味、単調だと言えるかもしれないが、"}, {"type": "subtitle", "time": 10103.269, "timestamp": "02:48:23", "text": "努力は楽しい。面倒くさい。ああ、なるほど。なるほど。"}, {"type": "subtitle", "time": 10105.11, "timestamp": "02:48:25", "text": "あらゆる種類のゲームには"}, {"type": "subtitle", "time": 10107.51, "timestamp": "02:48:27", "text": "ストリーミング配信しましたか？放送しましたか？"}, {"type": "subtitle", "time": 10115.75, "timestamp": "02:48:35", "text": "もしそこに「マインクラフト」と書いてあったらどうでしょう。"}, {"type": "subtitle", "time": 10117.51, "timestamp": "02:48:37", "text": "最近、ゲーム配信をかなりたくさん行いました。"}, {"type": "subtitle", "time": 10119.75, "timestamp": "02:48:39", "text": "Apex LegendsからGenshin Impactまで"}, {"type": "subtitle", "time": 10122.389, "timestamp": "02:48:42", "text": "モンスターハンターなど、他にもたくさんあります。そしてその間"}, {"type": "subtitle", "time": 10124.309, "timestamp": "02:48:44", "text": "私の意見では、これらのゲームはどれも楽しいです"}, {"type": "subtitle", "time": 10126.389, "timestamp": "02:48:46", "text": "ゲームは私にとって興味深い"}, {"type": "subtitle", "time": 10128.07, "timestamp": "02:48:48", "text": "異なるゲームプレイと"}, {"type": "subtitle", "time": 10137.11, "timestamp": "02:48:57", "text": "いや、そうでもないよ。私はPCでプレイすることが多い"}, {"type": "subtitle", "time": 10139.59, "timestamp": "02:48:59", "text": "コンソール。だから、私がプレイしたほとんどのゲームは"}]
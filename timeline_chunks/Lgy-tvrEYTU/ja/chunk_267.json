[{"type": "subtitle", "time": 16021.75, "timestamp": "04:27:01", "text": "プールで小便をするよりは、中に留めておく方が良い。"}, {"type": "subtitle", "time": 16024.71, "timestamp": "04:27:04", "text": "えっと、ある時うちの犬が面白いことをしたんだ"}, {"type": "subtitle", "time": 16026.87, "timestamp": "04:27:06", "text": "もの。あまり。それはとても"}, {"type": "subtitle", "time": 16031.51, "timestamp": "04:27:11", "text": "恐ろしい。しかし、彼が何をしたにせよ"}, {"type": "subtitle", "time": 16034.389, "timestamp": "04:27:14", "text": "どうやら私たちは彼を入れなければならなかったようです"}, {"type": "subtitle", "time": 16037.189, "timestamp": "04:27:17", "text": "まるまる1時間くらい。だから私たちは"}, {"type": "subtitle", "time": 16039.03, "timestamp": "04:27:19", "text": "まるで彼に薬を飲ませているようなものだ。だから私は"}, {"type": "subtitle", "time": 16041.269, "timestamp": "04:27:21", "text": "彼に薬を塗るようなものだ。だから私は"}, {"type": "subtitle", "time": 16043.269, "timestamp": "04:27:23", "text": "彼を座らせなければならない"}, {"type": "subtitle", "time": 16045.429, "timestamp": "04:27:25", "text": "1時間くらい置いてから、彼をお風呂に入れた。"}, {"type": "subtitle", "time": 16048.87, "timestamp": "04:27:28", "text": "右。彼"}, {"type": "subtitle", "time": 16050.95, "timestamp": "04:27:30", "text": "彼は本当に尿を我慢していた。だから彼は"}, {"type": "subtitle", "time": 16053.99, "timestamp": "04:27:33", "text": "とても不快だった。でも、"}, {"type": "subtitle", "time": 16056.149, "timestamp": "04:27:36", "text": "昔は、私の時代は"}, {"type": "subtitle", "time": 16058.469, "timestamp": "04:27:38", "text": "初めて新しいものを手に入れたとき"}, {"type": "subtitle", "time": 16061.11, "timestamp": "04:27:41", "text": "当時、私はこれらの身体のようなものを知りませんでした"}, {"type": "subtitle", "time": 16063.75, "timestamp": "04:27:43", "text": "言語。全く知らなかった。でも私はトレーニングしました"}, {"type": "subtitle", "time": 16066.55, "timestamp": "04:27:46", "text": "彼に、ポータブルパーティーのトレーニングを好きになる方法を教えます。"}, {"type": "subtitle", "time": 16069.99, "timestamp": "04:27:49", "text": "私は彼にトイレトレーニングを施しました。だから彼は"}, {"type": "subtitle", "time": 16072.79, "timestamp": "04:27:52", "text": "徹底的にやり遂げた。まるで私が"}, {"type": "subtitle", "time": 16076.389, "timestamp": "04:27:56", "text": "「ああ、それは知らない」"}, {"type": "subtitle", "time": 16079.59, "timestamp": "04:27:59", "text": "お前、おしっこ漏らしちゃうぞ。あなた"}]
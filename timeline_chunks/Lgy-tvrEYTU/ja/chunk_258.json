[{"type": "subtitle", "time": 15482.469, "timestamp": "04:18:02", "text": "少し変形させて言う"}, {"type": "subtitle", "time": 15490.95, "timestamp": "04:18:10", "text": "kick it は、蹴り飛ばすという意味です。"}, {"type": "subtitle", "time": 15494.07, "timestamp": "04:18:14", "text": "そんな感じ。うん、蹴らない"}, {"type": "subtitle", "time": 15495.75, "timestamp": "04:18:15", "text": "知る"}, {"type": "subtitle", "time": 15501.67, "timestamp": "04:18:21", "text": "他に私たちは何を知っているのでしょうか？ほかに何か？"}, {"type": "subtitle", "time": 15513.189, "timestamp": "04:18:33", "text": "誰かがさらに多くを語っている"}, {"type": "subtitle", "time": 15514.71, "timestamp": "04:18:34", "text": "面白い。教えてください。"}, {"type": "subtitle", "time": 15516.63, "timestamp": "04:18:36", "text": "全く見当もつきません。私は外に出なければならない"}, {"type": "subtitle", "time": 15518.63, "timestamp": "04:18:38", "text": "アプリを開いてチャットを見て戻ってきてください"}, {"type": "subtitle", "time": 15520.79, "timestamp": "04:18:40", "text": "ここ。"}, {"type": "subtitle", "time": 15530.149, "timestamp": "04:18:50", "text": "待って、私、字が読めない。待って。ああ、"}, {"type": "subtitle", "time": 15534.229, "timestamp": "04:18:54", "text": "私には読めないもの"}]
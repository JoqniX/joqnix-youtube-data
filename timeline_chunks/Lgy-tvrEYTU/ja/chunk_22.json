[{"type": "subtitle", "time": 1321.43, "timestamp": "00:22:01", "text": "しかもガーディアンズだ。少し"}, {"type": "subtitle", "time": 1324.26, "timestamp": "00:22:04", "text": "ファンダムもね。"}, {"type": "subtitle", "time": 1329.669, "timestamp": "00:22:09", "text": "[音楽]"}, {"type": "subtitle", "time": 1334.63, "timestamp": "00:22:14", "text": "ああ、ゴーストスキンが手に入るんだね。おお、"}, {"type": "subtitle", "time": 1340.39, "timestamp": "00:22:20", "text": "私が欲しい幽霊はどれか知ってる？私"}, {"type": "subtitle", "time": 1344.18, "timestamp": "00:22:24", "text": "アーケードの幽霊が欲しい。"}, {"type": "subtitle", "time": 1354.39, "timestamp": "00:22:34", "text": "ああ、ラジアンがいくつかあるんですね？"}, {"type": "subtitle", "time": 1356.549, "timestamp": "00:22:36", "text": "これ、買うべきだな。これは"}, {"type": "subtitle", "time": 1360.549, "timestamp": "00:22:40", "text": "セシル。これはダイヤモンド用かもしれません。これ"}, {"type": "subtitle", "time": 1363.43, "timestamp": "00:22:43", "text": "アクアリナ用にもなり得る。これは私にもできるかもしれない。"}, {"type": "subtitle", "time": 1366.39, "timestamp": "00:22:46", "text": "これを手に入れなきゃ。"}]
[{"type": "subtitle", "time": 18422.788, "timestamp": "05:07:02", "text": "待って、明日エジプトって何？それは何ですか？"}, {"type": "subtitle", "time": 18425.67, "timestamp": "05:07:05", "text": "明日はエジプトをテーマにしたイベントになるのでしょうか？は"}, {"type": "subtitle", "time": 18428.948, "timestamp": "05:07:08", "text": "それは、それは、それは"}, {"type": "subtitle", "time": 18430.628, "timestamp": "05:07:10", "text": "インド風のテーマにするつもりだったんだけど"}, {"type": "subtitle", "time": 18433.83, "timestamp": "05:07:13", "text": "初期の作品で見たような"}, {"type": "subtitle", "time": 18437.99, "timestamp": "05:07:17", "text": "英雄はエジプトの衣装のようだった"}, {"type": "subtitle", "time": 18441.27, "timestamp": "05:07:21", "text": "そして私は「待って、スマロは"}, {"type": "subtitle", "time": 18443.75, "timestamp": "05:07:23", "text": "インド風、またはエジプト風"}, {"type": "subtitle", "time": 18446.39, "timestamp": "05:07:26", "text": "古代エジプトをテーマにしたもの。"}, {"type": "subtitle", "time": 18448.868, "timestamp": "05:07:28", "text": "原神で待ってください。"}, {"type": "subtitle", "time": 18450.948, "timestamp": "05:07:30", "text": "ああ、源珍。ああ、スマル。のように"}, {"type": "subtitle", "time": 18452.39, "timestamp": "05:07:32", "text": "文字通り、あなたが次に訪れる国"}, {"type": "subtitle", "time": 18454.708, "timestamp": "05:07:34", "text": "訪れるべき場所はスマル島ですよね？ああ、スメ。おお、"}, {"type": "subtitle", "time": 18456.07, "timestamp": "05:07:36", "text": "うん。うん。そう、それだ。わかった。わかった。"}, {"type": "subtitle", "time": 18458.47, "timestamp": "05:07:38", "text": "わかった。うん。"}, {"type": "subtitle", "time": 18461.03, "timestamp": "05:07:41", "text": "エジプトをテーマにしたデザインですか？まるで私が"}, {"type": "subtitle", "time": 18463.43, "timestamp": "05:07:43", "text": "そういうアート作品をたくさん見てきました"}, {"type": "subtitle", "time": 18465.75, "timestamp": "05:07:45", "text": "それはエジプトのものになることを示しています"}, {"type": "subtitle", "time": 18467.59, "timestamp": "05:07:47", "text": "テーマ性のある。"}, {"type": "subtitle", "time": 18471.75, "timestamp": "05:07:51", "text": "そういう感じだと思います。うん。"}, {"type": "subtitle", "time": 18474.788, "timestamp": "05:07:54", "text": "うん。エジプト人のようにではなく、エジプト人のように"}, {"type": "subtitle", "time": 18477.11, "timestamp": "05:07:57", "text": "典型的なエジプトのテーマ。しないで"}]
[{"type": "subtitle", "time": 4875.11, "timestamp": "01:21:15", "text": "いや。これは一体どんな魔法だ？"}, {"type": "subtitle", "time": 4891.75, "timestamp": "01:21:31", "text": "[音楽]"}, {"type": "subtitle", "time": 4894.48, "timestamp": "01:21:34", "text": "待って。"}, {"type": "subtitle", "time": 4901.83, "timestamp": "01:21:41", "text": "えっと、"}, {"type": "subtitle", "time": 4904.47, "timestamp": "01:21:44", "text": "自分の支払いがどうなるのかもわからない"}, {"type": "subtitle", "time": 4907.669, "timestamp": "01:21:47", "text": "来月。"}, {"type": "subtitle", "time": 4911.75, "timestamp": "01:21:51", "text": "だから、私は「わあ」って感じだった。わかりました、"}, {"type": "subtitle", "time": 4913.11, "timestamp": "01:21:53", "text": "[音楽]"}, {"type": "subtitle", "time": 4917.59, "timestamp": "01:21:57", "text": "かわいそうなキーボード。貧乏人は"}, {"type": "subtitle", "time": 4919.91, "timestamp": "01:21:59", "text": "うわあ、すごい騎手だ。マウスを持っていません"}]
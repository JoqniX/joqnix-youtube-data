[{"type": "subtitle", "time": 10743.67, "timestamp": "02:59:03", "text": "英語を言わないでください。それは"}, {"type": "subtitle", "time": 10752.07, "timestamp": "02:59:12", "text": "リオ。わかりました。私は"}, {"type": "subtitle", "time": 10753.75, "timestamp": "02:59:13", "text": "日本語。"}, {"type": "subtitle", "time": 10756.07, "timestamp": "02:59:16", "text": "それは何ですか？"}, {"type": "subtitle", "time": 10758.23, "timestamp": "02:59:18", "text": "えっと、あなたの発音は"}, {"type": "subtitle", "time": 10761.93, "timestamp": "02:59:21", "text": "ところどころ少しずれている"}, {"type": "subtitle", "time": 10768.15, "timestamp": "02:59:28", "text": "彼らです。私には、"}, {"type": "subtitle", "time": 10796.79, "timestamp": "02:59:56", "text": "ああ、なるほど。私はまだ続ける必要がある"}, {"type": "subtitle", "time": 10798.87, "timestamp": "02:59:58", "text": "それから。まだ意見を言えると思う"}]
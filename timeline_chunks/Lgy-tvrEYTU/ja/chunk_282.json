[{"type": "subtitle", "time": 16921.51, "timestamp": "04:42:01", "text": "滑空するためのもののようなもの。だから私は言った"}, {"type": "subtitle", "time": 16924.39, "timestamp": "04:42:04", "text": "えっと、私のアンバーはオバサで、私の"}, {"type": "subtitle", "time": 16927.27, "timestamp": "04:42:07", "text": "アンバーはおばあちゃんみたいだ"}, {"type": "subtitle", "time": 16930.31, "timestamp": "04:42:10", "text": "今。彼女は走ったり歩いたりできないのは"}, {"type": "subtitle", "time": 16932.628, "timestamp": "04:42:12", "text": "スタミナ。"}, {"type": "subtitle", "time": 16935.03, "timestamp": "04:42:15", "text": "体力が尽きた。 2回全力疾走"}, {"type": "subtitle", "time": 16937.75, "timestamp": "04:42:17", "text": "数秒で、あなたは死んでしまいます。"}, {"type": "subtitle", "time": 16940.39, "timestamp": "04:42:20", "text": "スタミナの。はい。 10分くらい飛行機に乗って"}, {"type": "subtitle", "time": 16943.51, "timestamp": "04:42:23", "text": "数秒後、あなたは落下して死ぬ。うん。あなた"}, {"type": "subtitle", "time": 16945.03, "timestamp": "04:42:25", "text": "あなたはただ受け入れただけじゃないの？"}, {"type": "subtitle", "time": 16947.11, "timestamp": "04:42:27", "text": "運命。ドロップショットも好きじゃない。あなた"}, {"type": "subtitle", "time": 16948.788, "timestamp": "04:42:28", "text": "受け入れるだけ 私は"}, {"type": "subtitle", "time": 16955.43, "timestamp": "04:42:35", "text": "こんにちは"}, {"type": "subtitle", "time": 16958.55, "timestamp": "04:42:38", "text": "うん、それはまるで人々が作り方を知っているようなものだ"}, {"type": "subtitle", "time": 16960.868, "timestamp": "04:42:40", "text": "きちんと育てれば、彼女は良いサポーターにもなる。"}, {"type": "subtitle", "time": 16964.788, "timestamp": "04:42:44", "text": "は良いサポートになり得る。うん。彼女は"}, {"type": "subtitle", "time": 16966.868, "timestamp": "04:42:46", "text": "何かブーストが欲しい？のように"}, {"type": "subtitle", "time": 16969.99, "timestamp": "04:42:49", "text": "それは何かプラスになるのでしょうか？まるで"}, {"type": "subtitle", "time": 16974.31, "timestamp": "04:42:54", "text": "彼女はブースト期間を何もしないと思うかもしれない"}, {"type": "subtitle", "time": 16976.948, "timestamp": "04:42:56", "text": "彼女をしばらく育て上げるために、"}]
[{"type": "subtitle", "time": 304.87, "timestamp": "00:05:04", "text": "くそ。"}, {"type": "subtitle", "time": 307.749, "timestamp": "00:05:07", "text": "とにかく、ちょっと出かけます。すぐ戻ります。私は戻ってきます。"}, {"type": "subtitle", "time": 309.27, "timestamp": "00:05:09", "text": "わかった。"}, {"type": "subtitle", "time": 311.35, "timestamp": "00:05:11", "text": "来て、えーと"}, {"type": "subtitle", "time": 313.749, "timestamp": "00:05:13", "text": "私はただ"}, {"type": "subtitle", "time": 315.749, "timestamp": "00:05:15", "text": "顔を洗ったりする。はい、私はただ"}, {"type": "subtitle", "time": 326.95, "timestamp": "00:05:26", "text": "インスタントコーヒーを買う必要がある"}, {"type": "subtitle", "time": 329.51, "timestamp": "00:05:29", "text": "あれ。"}, {"type": "subtitle", "time": 333.11, "timestamp": "00:05:33", "text": "そうするよ、たぶん。"}, {"type": "subtitle", "time": 334.629, "timestamp": "00:05:34", "text": "ともかく、"}, {"type": "subtitle", "time": 336.629, "timestamp": "00:05:36", "text": "それはちょっと待って、今はもっといい。"}]
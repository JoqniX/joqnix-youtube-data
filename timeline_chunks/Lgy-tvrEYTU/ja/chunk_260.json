[{"type": "subtitle", "time": 15603.91, "timestamp": "04:20:03", "text": "[音楽]"}, {"type": "subtitle", "time": 15607.269, "timestamp": "04:20:07", "text": "ところで、私は見えない"}, {"type": "subtitle", "time": 15611.51, "timestamp": "04:20:11", "text": "富士の、えっと、あれは何て言うんだっけ？"}, {"type": "subtitle", "time": 15613.51, "timestamp": "04:20:13", "text": "富士山が見えないよ。ああ、見えない。"}, {"type": "subtitle", "time": 15616.229, "timestamp": "04:20:16", "text": "親指の部分を見てください。ごめんなさい。"}, {"type": "subtitle", "time": 15620.87, "timestamp": "04:20:20", "text": "おお。えっと、待って。チャットボックスはライブ配信中ですか？"}, {"type": "subtitle", "time": 15623.11, "timestamp": "04:20:23", "text": "チャットかトップチャットか？トップチャットなら、"}, {"type": "subtitle", "time": 15625.269, "timestamp": "04:20:25", "text": "見ないだろう。変わらなきゃいけないと思う"}, {"type": "subtitle", "time": 15628.309, "timestamp": "04:20:28", "text": "ライブチャットに切り替えてください。"}, {"type": "subtitle", "time": 15632.149, "timestamp": "04:20:32", "text": "あ、待って。えっと、"}, {"type": "subtitle", "time": 15635.189, "timestamp": "04:20:35", "text": "Discordにコピー＆ペーストするだけです。"}, {"type": "subtitle", "time": 15637.429, "timestamp": "04:20:37", "text": "その方があなたにとって楽でしょう。ええ、ぜひお願いします。"}, {"type": "subtitle", "time": 15639.269, "timestamp": "04:20:39", "text": "どうぞ。それは、それは、それはさらに"}, {"type": "subtitle", "time": 15641.429, "timestamp": "04:20:41", "text": "便利。"}]
[{"type": "subtitle", "time": 17764.628, "timestamp": "04:56:04", "text": "顎の形をしたクッキーが入った大きな袋を持っている。"}, {"type": "subtitle", "time": 17766.948, "timestamp": "04:56:06", "text": "ジョック風味のクッキー。さあ、"}, {"type": "subtitle", "time": 17772.708, "timestamp": "04:56:12", "text": "[音楽]"}, {"type": "subtitle", "time": 17774.55, "timestamp": "04:56:14", "text": "彼女のことは聞いたことがある。"}, {"type": "subtitle", "time": 17776.868, "timestamp": "04:56:16", "text": "泥団子。"}, {"type": "subtitle", "time": 17778.55, "timestamp": "04:56:18", "text": "パイ。"}, {"type": "subtitle", "time": 17782.07, "timestamp": "04:56:22", "text": "泥団子。待って、泥だんごがあるよ。待って、"}, {"type": "subtitle", "time": 17783.67, "timestamp": "04:56:23", "text": "何？"}, {"type": "subtitle", "time": 17785.99, "timestamp": "04:56:25", "text": "そして人々はそれを食べる。"}, {"type": "subtitle", "time": 17791.11, "timestamp": "04:56:31", "text": "待って、待って。泥を食べるのか？"}, {"type": "subtitle", "time": 17794.23, "timestamp": "04:56:34", "text": "私じゃないよ。いいえ、人々はそれを食べます。ああ、人々よ"}, {"type": "subtitle", "time": 17797.51, "timestamp": "04:56:37", "text": "それを食べなさい。わかった。はい、わかりました。待って。何？"}, {"type": "subtitle", "time": 17802.31, "timestamp": "04:56:42", "text": "待って、なぜ？え、それって本当に存在するの？"}, {"type": "subtitle", "time": 17806.708, "timestamp": "04:56:46", "text": "待って、それは実際に存在する。何？はい。その"}, {"type": "subtitle", "time": 17809.19, "timestamp": "04:56:49", "text": "通常貧困層でよく使われる"}, {"type": "subtitle", "time": 17813.27, "timestamp": "04:56:53", "text": "何も入手できない国々。"}, {"type": "subtitle", "time": 17814.788, "timestamp": "04:56:54", "text": "あ、待って。待って、待って、待って。また、"}, {"type": "subtitle", "time": 17816.55, "timestamp": "04:56:56", "text": "ごめん。"}, {"type": "subtitle", "time": 17818.868, "timestamp": "04:56:58", "text": "我慢する。今、レシピを見ました。おお、"}]
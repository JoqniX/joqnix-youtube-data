[{"type": "subtitle", "time": 9841.99, "timestamp": "02:44:01", "text": "あそこにチルダマークが見えますか？なぜ"}, {"type": "subtitle", "time": 9845.269, "timestamp": "02:44:05", "text": "私のテキストをコピーしているのでしょうか？"}, {"type": "subtitle", "time": 9847.83, "timestamp": "02:44:07", "text": "同じように？"}, {"type": "subtitle", "time": 9849.75, "timestamp": "02:44:09", "text": "はぁ？"}, {"type": "subtitle", "time": 9851.75, "timestamp": "02:44:11", "text": "ナン、"}, {"type": "subtitle", "time": 9868.15, "timestamp": "02:44:28", "text": "もう一度彼に電話してみましょう。"}, {"type": "subtitle", "time": 9870.07, "timestamp": "02:44:30", "text": "ええ、私はあなたを祝福しましたし、私も"}, {"type": "subtitle", "time": 9873.269, "timestamp": "02:44:33", "text": "素敵な一日を過ごされたことを願っています。"}, {"type": "subtitle", "time": 9875.75, "timestamp": "02:44:35", "text": "ああ、ありがとうございます。遅ればせながらありがとうございます"}, {"type": "subtitle", "time": 9878.469, "timestamp": "02:44:38", "text": "願い。うん、いい一日だったよ。えっと、私は"}, {"type": "subtitle", "time": 9883.51, "timestamp": "02:44:43", "text": "Jocknixとしてストリーミング配信していたあなた、そして"}, {"type": "subtitle", "time": 9888.469, "timestamp": "02:44:48", "text": "私は誕生日ケーキを切りました"}, {"type": "subtitle", "time": 9891.83, "timestamp": "02:44:51", "text": "ケーキの中に「Jocknik」という名前が書いてあった。うん、"}, {"type": "subtitle", "time": 9895.75, "timestamp": "02:44:55", "text": "えっと、ケーキは本当に美味しかったです。"}]
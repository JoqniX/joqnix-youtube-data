[{"type": "subtitle", "time": 601.43, "timestamp": "00:10:01", "text": "それは、それは、でもそれはある意味月にある"}, {"type": "subtitle", "time": 605.91, "timestamp": "00:10:05", "text": "ブームはご存知の通り、ニューラ社と"}, {"type": "subtitle", "time": 609.03, "timestamp": "00:10:09", "text": "すると宇宙はまるで私たちのように見える"}, {"type": "subtitle", "time": 611.99, "timestamp": "00:10:11", "text": "え、本当に？ そうですね。"}, {"type": "subtitle", "time": 615.03, "timestamp": "00:10:15", "text": "何てことだ。"}, {"type": "subtitle", "time": 628.44, "timestamp": "00:10:28", "text": "面白い。"}, {"type": "subtitle", "time": 640.949, "timestamp": "00:10:40", "text": "ああ、神様。"}, {"type": "subtitle", "time": 644.23, "timestamp": "00:10:44", "text": "お腹が空いている上に、とても疲れている。"}]
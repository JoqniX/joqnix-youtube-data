[{"type": "subtitle", "time": 18900.55, "timestamp": "05:15:00", "text": "コラボレーションは"}, {"type": "subtitle", "time": 18910.868, "timestamp": "05:15:10", "text": "こんにちは。ええ、ジョーがここにいるためにお金を払ってくれたんです。有料"}, {"type": "subtitle", "time": 18915.67, "timestamp": "05:15:15", "text": "私には1分あたり10オーストラリアドルです。おお"}, {"type": "subtitle", "time": 18917.51, "timestamp": "05:15:17", "text": "我が神よ。"}, {"type": "subtitle", "time": 18919.19, "timestamp": "05:15:19", "text": "彼はあなたの会員費を使っています"}, {"type": "subtitle", "time": 18926.23, "timestamp": "05:15:26", "text": "元気ですか？あなたに会いたかった。それは"}, {"type": "subtitle", "time": 18928.39, "timestamp": "05:15:28", "text": "その間。"}, {"type": "subtitle", "time": 18930.23, "timestamp": "05:15:30", "text": "うん、"}, {"type": "subtitle", "time": 18932.23, "timestamp": "05:15:32", "text": "前回はヴェランと対戦しました。あなたはまだ"}, {"type": "subtitle", "time": 18936.07, "timestamp": "05:15:36", "text": "ヴェランをプレイしますか？ジョーク。ええ、そうです。私はします。私はします"}, {"type": "subtitle", "time": 18937.99, "timestamp": "05:15:37", "text": "遊ぶ。"}, {"type": "subtitle", "time": 18945.43, "timestamp": "05:15:45", "text": "フィリピン人のエージェント？"}, {"type": "subtitle", "time": 18949.51, "timestamp": "05:15:49", "text": "私はあなたを愛しています。うん。ああ、そうだね。神よ、あの"}, {"type": "subtitle", "time": 18955.11, "timestamp": "05:15:55", "text": "まさかそんなことを聞​​かれるとは思わなかったよ。ああ、"}]
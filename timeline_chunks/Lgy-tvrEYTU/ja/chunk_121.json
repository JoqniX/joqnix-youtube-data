[{"type": "subtitle", "time": 7263.35, "timestamp": "02:01:03", "text": "そもそも絶対にこんなことはしてはいけない。"}, {"type": "subtitle", "time": 7267.51, "timestamp": "02:01:07", "text": "ともあれ、来てくださった皆さんに感謝します。"}, {"type": "subtitle", "time": 7269.53, "timestamp": "02:01:09", "text": "すごく綺麗に見える。わかった。"}, {"type": "subtitle", "time": 7278.55, "timestamp": "02:01:18", "text": "ああ、もうすぐApexのイベントが開催されるよ。"}, {"type": "subtitle", "time": 7282.31, "timestamp": "02:01:22", "text": "やってみよう"}, {"type": "subtitle", "time": 7284.95, "timestamp": "02:01:24", "text": "あ、待って。それは"}, {"type": "subtitle", "time": 7288.629, "timestamp": "02:01:28", "text": "法律に関するビデオ。どうでも。"}, {"type": "subtitle", "time": 7292.39, "timestamp": "02:01:32", "text": "おお。あれは法律に関するビデオだった。わかった。"}, {"type": "subtitle", "time": 7294.95, "timestamp": "02:01:34", "text": "ともかく、"}, {"type": "subtitle", "time": 7305.16, "timestamp": "02:01:45", "text": "最初から最後まで、すべてを把握してください。"}, {"type": "subtitle", "time": 7311.99, "timestamp": "02:01:51", "text": "今日訪れた人は皆"}, {"type": "subtitle", "time": 7316.07, "timestamp": "02:01:56", "text": "ハシャマが来てくれてありがとう"}, {"type": "subtitle", "time": 7318.709, "timestamp": "02:01:58", "text": "来るために"}]
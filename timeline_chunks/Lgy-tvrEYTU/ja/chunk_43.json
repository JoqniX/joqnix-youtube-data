[{"type": "subtitle", "time": 2581.19, "timestamp": "00:43:01", "text": "それ。一致する結果が見つかりました。水は良い。うん、"}, {"type": "subtitle", "time": 2596.47, "timestamp": "00:43:16", "text": "痛み。"}, {"type": "subtitle", "time": 2598.71, "timestamp": "00:43:18", "text": "そして私はどこかへ行くことになっている"}, {"type": "subtitle", "time": 2620.63, "timestamp": "00:43:40", "text": "つまり、旅行で疲れているような感じで、"}, {"type": "subtitle", "time": 2623.51, "timestamp": "00:43:43", "text": "そういうこと全部。"}, {"type": "subtitle", "time": 2625.829, "timestamp": "00:43:45", "text": "350まで行こう"}, {"type": "subtitle", "time": 2636.47, "timestamp": "00:43:56", "text": "同じように見える"}]
[{"type": "subtitle", "time": 13501.91, "timestamp": "03:45:01", "text": "クアサイ。集めましたか？"}, {"type": "subtitle", "time": 13504.79, "timestamp": "03:45:04", "text": "集めた歯？"}, {"type": "subtitle", "time": 13514.469, "timestamp": "03:45:14", "text": "なぜ？なぜかと疑問に思うかもしれませんね。なぜなら通常は"}, {"type": "subtitle", "time": 13517.269, "timestamp": "03:45:17", "text": "私たちは自分自身を訓練しなければならない"}, {"type": "subtitle", "time": 13518.95, "timestamp": "03:45:18", "text": "木製の運河。人々は知っていると思う"}, {"type": "subtitle", "time": 13522.55, "timestamp": "03:45:22", "text": "根管治療とは。ああ、そうだ"}, {"type": "subtitle", "time": 13525.75, "timestamp": "03:45:25", "text": "重い運河。通常はそうです。"}, {"type": "subtitle", "time": 13529.189, "timestamp": "03:45:29", "text": "通常、私たちはトレーニングする必要があります"}, {"type": "subtitle", "time": 13531.75, "timestamp": "03:45:31", "text": "歯の根管。しかし、私たちはただ"}, {"type": "subtitle", "time": 13533.99, "timestamp": "03:45:33", "text": "生きた患者を使って訓練する。とても"}, {"type": "subtitle", "time": 13536.309, "timestamp": "03:45:36", "text": "危険な。そんなことはできません。では、私たちは"}, {"type": "subtitle", "time": 13540.79, "timestamp": "03:45:40", "text": "やることは、RC T をするように自分自身を訓練することです"}, {"type": "subtitle", "time": 13543.429, "timestamp": "03:45:43", "text": "ご存知のように、抜歯した歯"}, {"type": "subtitle", "time": 13546.07, "timestamp": "03:45:46", "text": "でも、これはまだ重要な歯ですよね。"}, {"type": "subtitle", "time": 13548.95, "timestamp": "03:45:48", "text": "練習には本当に良いので、"}, {"type": "subtitle", "time": 13551.83, "timestamp": "03:45:51", "text": "そうやって始めたんだ、そして"}, {"type": "subtitle", "time": 13555.429, "timestamp": "03:45:55", "text": "また、歯も集めます。"}, {"type": "subtitle", "time": 13557.83, "timestamp": "03:45:57", "text": "バイオハザード、それはまだ生物学的"}, {"type": "subtitle", "time": 13559.75, "timestamp": "03:45:59", "text": "廃棄物はただ捨てるだけではいけません"}]
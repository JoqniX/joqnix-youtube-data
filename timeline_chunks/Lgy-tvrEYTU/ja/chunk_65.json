[{"type": "subtitle", "time": 3907.589, "timestamp": "01:05:07", "text": "これは良いことだ。あ、待って。それは"}, {"type": "subtitle", "time": 3911.27, "timestamp": "01:05:11", "text": "それにはソフトウェアもある。"}, {"type": "subtitle", "time": 3934.87, "timestamp": "01:05:34", "text": "だって、私は"}, {"type": "subtitle", "time": 3937.51, "timestamp": "01:05:37", "text": "お金を他のことに使うなど"}, {"type": "subtitle", "time": 3950.15, "timestamp": "01:05:50", "text": "私は保存するつもりだったのですが、"}, {"type": "subtitle", "time": 3952.63, "timestamp": "01:05:52", "text": "マイクを買うために貯金するはずだった"}]
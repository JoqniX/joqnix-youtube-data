[{"type": "subtitle", "time": 13682.309, "timestamp": "03:48:02", "text": "ニュース ニュース ちょうど"}, {"type": "subtitle", "time": 13685.11, "timestamp": "03:48:05", "text": "「大丈夫ですか？」そして、いつ"}, {"type": "subtitle", "time": 13687.75, "timestamp": "03:48:07", "text": "子供たちは「私は大丈夫」という感じだ。これはただ"}, {"type": "subtitle", "time": 13692.87, "timestamp": "03:48:12", "text": "目を大泣きして、まるで"}, {"type": "subtitle", "time": 13700.07, "timestamp": "03:48:20", "text": "みんな覚えてると思うよ"}, {"type": "subtitle", "time": 13702.79, "timestamp": "03:48:22", "text": "これですよね？これは死んだもののようなものですか？"}, {"type": "subtitle", "time": 13705.75, "timestamp": "03:48:25", "text": "私は年寄りですか？ごめんなさい。"}, {"type": "subtitle", "time": 13712.389, "timestamp": "03:48:32", "text": "医学研究を簡潔にまとめるとこうなります。うん。"}, {"type": "subtitle", "time": 13716.07, "timestamp": "03:48:36", "text": "学ぶべきことがたくさんあり、長年"}, {"type": "subtitle", "time": 13718.95, "timestamp": "03:48:38", "text": "経験とその他すべて。"}, {"type": "subtitle", "time": 13721.429, "timestamp": "03:48:41", "text": "ところで、もしあなたがどんな種類の"}, {"type": "subtitle", "time": 13723.83, "timestamp": "03:48:43", "text": "医学なんて簡単だよ、忘れちゃえばいい。"}, {"type": "subtitle", "time": 13725.99, "timestamp": "03:48:45", "text": "そんなことはしないでください。"}, {"type": "subtitle", "time": 13728.469, "timestamp": "03:48:48", "text": "映画を見るのが好きじゃない"}, {"type": "subtitle", "time": 13731.349, "timestamp": "03:48:51", "text": "医者ってかっこいいし、"}, {"type": "subtitle", "time": 13734.95, "timestamp": "03:48:54", "text": "あなたが好きになりたいなら、入ってきてください"}, {"type": "subtitle", "time": 13737.67, "timestamp": "03:48:57", "text": "医者はかっこいいから、そんな夢を見よう"}, {"type": "subtitle", "time": 13739.75, "timestamp": "03:48:59", "text": "病院に来ないでください"}]
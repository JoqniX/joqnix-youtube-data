[{"type": "subtitle", "time": 18963.11, "timestamp": "05:16:03", "text": "マヤ、最近どうだった？すべて順調ですか？"}, {"type": "subtitle", "time": 18966.628, "timestamp": "05:16:06", "text": "けれど？久しぶりですね。"}, {"type": "subtitle", "time": 18969.27, "timestamp": "05:16:09", "text": "うん、わかるよね。"}, {"type": "subtitle", "time": 18972.31, "timestamp": "05:16:12", "text": "ところで、猫ちゃんは元気ですか？あなた、私"}, {"type": "subtitle", "time": 18974.868, "timestamp": "05:16:14", "text": "あなたが猫を見せていたのを覚えています。ああ、それ"}, {"type": "subtitle", "time": 18979.03, "timestamp": "05:16:19", "text": "[ __ ]。クソ猫め。"}, {"type": "subtitle", "time": 18981.19, "timestamp": "05:16:21", "text": "これが5回目だと思う"}, {"type": "subtitle", "time": 18984.708, "timestamp": "05:16:24", "text": "妊娠中。いつも3匹の子猫です。"}, {"type": "subtitle", "time": 18986.23, "timestamp": "05:16:26", "text": "「ああ、これをぶちまけよう」"}, {"type": "subtitle", "time": 18988.708, "timestamp": "05:16:28", "text": "私のベッドの下、それから私はただ来る"}, {"type": "subtitle", "time": 18991.43, "timestamp": "05:16:31", "text": "時々戻って餌をやるんだ。」"}, {"type": "subtitle", "time": 18997.59, "timestamp": "05:16:37", "text": "何てことだ。私にはどうすることもできない"}, {"type": "subtitle", "time": 19000.23, "timestamp": "05:16:40", "text": "女の子だから。だから彼の"}, {"type": "subtitle", "time": 19007.11, "timestamp": "05:16:47", "text": "うん、気持ちわかるよ。同じことが起こった"}, {"type": "subtitle", "time": 19010.868, "timestamp": "05:16:50", "text": "家でも猫と一緒にいる時もそうです。"}, {"type": "subtitle", "time": 19014.708, "timestamp": "05:16:54", "text": "ええと、世代の反復が数多く"}, {"type": "subtitle", "time": 19017.51, "timestamp": "05:16:57", "text": "家族、"}, {"type": "subtitle", "time": 19019.59, "timestamp": "05:16:59", "text": "夫が多すぎる。"}]
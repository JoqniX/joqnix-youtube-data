[{"type": "subtitle", "time": 5402.55, "timestamp": "01:30:02", "text": "単に"}, {"type": "subtitle", "time": 5405.35, "timestamp": "01:30:05", "text": "もう少し配信を続けてください。それから"}, {"type": "subtitle", "time": 5407.83, "timestamp": "01:30:07", "text": "全てはそれだけの価値がある"}, {"type": "subtitle", "time": 5410.87, "timestamp": "01:30:10", "text": "3日間は私の体に触らなくていいです"}, {"type": "subtitle", "time": 5414.229, "timestamp": "01:30:14", "text": "何か。私は推測する"}, {"type": "subtitle", "time": 5416.39, "timestamp": "01:30:16", "text": "またしても、私は独り言を言ってしまった。私"}, {"type": "subtitle", "time": 5422.91, "timestamp": "01:30:22", "text": "私の"}]
[{"type": "subtitle", "time": 9481.27, "timestamp": "02:38:01", "text": "質問があります。彼はドイツ語を話せますか？"}, {"type": "subtitle", "time": 9483.11, "timestamp": "02:38:03", "text": "オーストリア人？よし、行こう。聞いてみよう"}, {"type": "subtitle", "time": 9484.71, "timestamp": "02:38:04", "text": "それ。"}, {"type": "subtitle", "time": 9487.51, "timestamp": "02:38:07", "text": "では、あなたに質問があります。えっと、"}, {"type": "subtitle", "time": 9494.87, "timestamp": "02:38:14", "text": "残念ながら、私は持っていません。私は英語しか話せません、"}, {"type": "subtitle", "time": 9496.63, "timestamp": "02:38:16", "text": "日本語が少し、中国語が少し、"}, {"type": "subtitle", "time": 9499.429, "timestamp": "02:38:19", "text": "スペイン語が少し話せる。ハハ。"}, {"type": "subtitle", "time": 9508.07, "timestamp": "02:38:28", "text": "ハハ。高校時代に習ったんです。"}, {"type": "subtitle", "time": 9509.99, "timestamp": "02:38:29", "text": "まるで私がそこで学ぶためにコースを受講したように"}, {"type": "subtitle", "time": 9512.389, "timestamp": "02:38:32", "text": "卒業要件のスペイン語"}, {"type": "subtitle", "time": 9531.91, "timestamp": "02:38:51", "text": "私は何をしたのか"}, {"type": "subtitle", "time": 9534.15, "timestamp": "02:38:54", "text": "何"}, {"type": "subtitle", "time": 9537.99, "timestamp": "02:38:57", "text": "ああ、卒業式、ああ、高校、オーケー、私は"}]
[{"type": "subtitle", "time": 12573.19, "timestamp": "03:29:33", "text": "うん。こんにちは、みんな。いらっしゃいませ。いらっしゃいませ。"}, {"type": "subtitle", "time": 12575.67, "timestamp": "03:29:35", "text": "こんにちは"}, {"type": "subtitle", "time": 12577.349, "timestamp": "03:29:37", "text": "みんな。"}, {"type": "subtitle", "time": 12581.03, "timestamp": "03:29:41", "text": "今日はゲストをお迎えしています"}, {"type": "subtitle", "time": 12586.63, "timestamp": "03:29:46", "text": "えっと、私がコラボしたカマイのメンバーは2人です"}, {"type": "subtitle", "time": 12588.87, "timestamp": "03:29:48", "text": "すでに何回も。これは3回目です"}, {"type": "subtitle", "time": 12591.03, "timestamp": "03:29:51", "text": "時間。"}, {"type": "subtitle", "time": 12595.269, "timestamp": "03:29:55", "text": "私も人と話したり、一緒に楽しんだりするのが好きです。"}]
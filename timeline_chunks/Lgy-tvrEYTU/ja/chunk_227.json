[{"type": "subtitle", "time": 13620.309, "timestamp": "03:47:00", "text": "右？トレーニング中はトレーニング中は"}, {"type": "subtitle", "time": 13622.79, "timestamp": "03:47:02", "text": "地獄。例えば、勉強しているなら、"}, {"type": "subtitle", "time": 13625.349, "timestamp": "03:47:05", "text": "超地獄で、君はこう思う"}, {"type": "subtitle", "time": 13627.189, "timestamp": "03:47:07", "text": "訓練は地獄だ。そしてあなたは"}, {"type": "subtitle", "time": 13630.229, "timestamp": "03:47:10", "text": "外はまるで地獄だ。相変わらず地獄だ。"}, {"type": "subtitle", "time": 13632.71, "timestamp": "03:47:12", "text": "でも、それはまた別の地獄だ。その"}, {"type": "subtitle", "time": 13636.389, "timestamp": "03:47:16", "text": "大丈夫。まあ、よりマシな地獄ってことかな。"}, {"type": "subtitle", "time": 13638.63, "timestamp": "03:47:18", "text": "わからない。"}, {"type": "subtitle", "time": 13641.51, "timestamp": "03:47:21", "text": "えっと、このトレーニングはいつ始まるんですか？"}, {"type": "subtitle", "time": 13645.189, "timestamp": "03:47:25", "text": "状態、ステージ、終わり？何年ですか"}, {"type": "subtitle", "time": 13648.389, "timestamp": "03:47:28", "text": "それ？数ヶ月。たった1年。 1年、"}, {"type": "subtitle", "time": 13651.429, "timestamp": "03:47:31", "text": "1年間の研修。しかし、あなたを研究することは"}, {"type": "subtitle", "time": 13653.75, "timestamp": "03:47:33", "text": "4年間の学習と1年間の"}, {"type": "subtitle", "time": 13655.59, "timestamp": "03:47:35", "text": "トレーニングの。"}, {"type": "subtitle", "time": 13659.11, "timestamp": "03:47:39", "text": "ああ、4年プラス1年くらいかな。その"}, {"type": "subtitle", "time": 13661.03, "timestamp": "03:47:41", "text": "5年くらい。あなたは学ばなければならない"}, {"type": "subtitle", "time": 13668.15, "timestamp": "03:47:48", "text": "おお。"}, {"type": "subtitle", "time": 13672.63, "timestamp": "03:47:52", "text": "これには多くの要素が関わっています。"}, {"type": "subtitle", "time": 13677.03, "timestamp": "03:47:57", "text": "たくさん。まるで私がとても年を取ったみたいだ。私は"}, {"type": "subtitle", "time": 13679.51, "timestamp": "03:47:59", "text": "ごめん。でも、今まで見たことある？"}]
[{"type": "subtitle", "time": 3065.75, "timestamp": "00:51:05", "text": "首が痛いのですが、どうすればいいですか？私はしたくない"}, {"type": "subtitle", "time": 3069.03, "timestamp": "00:51:09", "text": "ライト。よし、これは良い。"}, {"type": "subtitle", "time": 3072.23, "timestamp": "00:51:12", "text": "でも、そうしないといけないんだ。ああ、バカ。あなたは忘れました"}, {"type": "subtitle", "time": 3074.79, "timestamp": "00:51:14", "text": "ワイヤレスキーボード。待ちきれないでしょう。"}, {"type": "subtitle", "time": 3077.27, "timestamp": "00:51:17", "text": "もし私がベッドに戻って"}, {"type": "subtitle", "time": 3080.47, "timestamp": "00:51:20", "text": "これをプレイしますか？でも、寝れば治ると思う。"}, {"type": "subtitle", "time": 3083.27, "timestamp": "00:51:23", "text": "それなら、文字通りできますよ。"}, {"type": "subtitle", "time": 3086.309, "timestamp": "00:51:26", "text": "ああ、キーボードは手で持っておくよ。"}, {"type": "subtitle", "time": 3089.03, "timestamp": "00:51:29", "text": "一番多く保管するのはどこにしますか？"}, {"type": "subtitle", "time": 3095.349, "timestamp": "00:51:35", "text": "一致する結果が見つかりました。"}, {"type": "subtitle", "time": 3098.069, "timestamp": "00:51:38", "text": "寝て治します。"}]
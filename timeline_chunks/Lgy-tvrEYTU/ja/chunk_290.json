[{"type": "subtitle", "time": 17400.55, "timestamp": "04:50:00", "text": "はい。"}, {"type": "subtitle", "time": 17402.868, "timestamp": "04:50:02", "text": "はい、でも何かあれば"}, {"type": "subtitle", "time": 17406.708, "timestamp": "04:50:06", "text": "私たちに読んでほしい"}, {"type": "subtitle", "time": 17414.868, "timestamp": "04:50:14", "text": "それで、私たちは原神について話していたんです。行く"}, {"type": "subtitle", "time": 17418.39, "timestamp": "04:50:18", "text": "先に。はい、どうぞ。はい、とても"}, {"type": "subtitle", "time": 17422.23, "timestamp": "04:50:22", "text": "非常に驚きました。知っている"}, {"type": "subtitle", "time": 17426.15, "timestamp": "04:50:26", "text": "ジャックと私が"}, {"type": "subtitle", "time": 17428.23, "timestamp": "04:50:28", "text": "源珍について話している。私はよく知っています"}, {"type": "subtitle", "time": 17431.43, "timestamp": "04:50:31", "text": "うるさい。わかった、わかった。知っている。しかしそれは"}, {"type": "subtitle", "time": 17433.27, "timestamp": "04:50:33", "text": "皆さん、起きていますよ。私たちは"}, {"type": "subtitle", "time": 17436.15, "timestamp": "04:50:36", "text": "げんちん。はい。"}, {"type": "subtitle", "time": 17439.35, "timestamp": "04:50:39", "text": "えーと、最初のコラボの時、えーと"}, {"type": "subtitle", "time": 17441.67, "timestamp": "04:50:41", "text": "ええ、それは配信中に話しましたよ。それで、"}, {"type": "subtitle", "time": 17445.03, "timestamp": "04:50:45", "text": "だから最初のコラボでは、えっと"}, {"type": "subtitle", "time": 17448.31, "timestamp": "04:50:48", "text": "えーと、私たちは最初のえーとに参加しました"}, {"type": "subtitle", "time": 17451.75, "timestamp": "04:50:51", "text": "プロフェッショナルなVCミーティング。すべて"}, {"type": "subtitle", "time": 17454.708, "timestamp": "04:50:54", "text": "入手することについて"}, {"type": "subtitle", "time": 17457.35, "timestamp": "04:50:57", "text": "全部で15分くらいのはずだった"}]
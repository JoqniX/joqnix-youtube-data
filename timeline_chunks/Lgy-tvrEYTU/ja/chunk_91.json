[{"type": "subtitle", "time": 5461.99, "timestamp": "01:31:01", "text": "いつものように"}, {"type": "subtitle", "time": 5464.95, "timestamp": "01:31:04", "text": "考えてみると"}, {"type": "subtitle", "time": 5467.75, "timestamp": "01:31:07", "text": "通常は11時か10時頃"}, {"type": "subtitle", "time": 5471.35, "timestamp": "01:31:11", "text": "マーク、私はとても元気だけど"}, {"type": "subtitle", "time": 5474.79, "timestamp": "01:31:14", "text": "私が行った12時間配信のうち、"}, {"type": "subtitle", "time": 5477.75, "timestamp": "01:31:17", "text": "私がとても疲れている時は"}, {"type": "subtitle", "time": 5479.99, "timestamp": "01:31:19", "text": "で"}, {"type": "subtitle", "time": 5483.91, "timestamp": "01:31:23", "text": "6時間、7時間、または8時間経過"}, {"type": "subtitle", "time": 5492.55, "timestamp": "01:31:32", "text": "そして、"}, {"type": "subtitle", "time": 5496.229, "timestamp": "01:31:36", "text": "私は"}, {"type": "subtitle", "time": 5500.39, "timestamp": "01:31:40", "text": "疲労期または眠気期"}, {"type": "subtitle", "time": 5504.39, "timestamp": "01:31:44", "text": "そうすれば私は元気な魚のようになる"}, {"type": "subtitle", "time": 5508.47, "timestamp": "01:31:48", "text": "顔。うん、フェーズであってフェイスじゃない"}, {"type": "subtitle", "time": 5511.75, "timestamp": "01:31:51", "text": "そんな感じ。ロシア、お茶がないから"}, {"type": "subtitle", "time": 5515.35, "timestamp": "01:31:55", "text": "もしくは、私を起こすようなものなら何でも。"}]
[{"type": "subtitle", "time": 17460.788, "timestamp": "04:51:00", "text": "とても平和ですね。ああ、あなたはどうですか？"}, {"type": "subtitle", "time": 17463.35, "timestamp": "04:51:03", "text": "君はスポーツマン？ああ、素晴らしいですね。ああ、あなたは"}, {"type": "subtitle", "time": 17466.23, "timestamp": "04:51:06", "text": "州？ああ、それについては仕事があるんです。"}, {"type": "subtitle", "time": 17469.11, "timestamp": "04:51:09", "text": "ああ、その州は良いところですか？そうだよ"}, {"type": "subtitle", "time": 17472.39, "timestamp": "04:51:12", "text": "良い。そうなるはずだったんだけど、いや、"}, {"type": "subtitle", "time": 17475.99, "timestamp": "04:51:15", "text": "まるで私が今入ってきて「やあ、"}, {"type": "subtitle", "time": 17477.75, "timestamp": "04:51:17", "text": "おい、ゲンジンやりたいか？"}, {"type": "subtitle", "time": 17480.788, "timestamp": "04:51:20", "text": "「もちろん、私も参加しますよ。いいじゃないですか？」そして"}, {"type": "subtitle", "time": 17482.708, "timestamp": "04:51:22", "text": "それから私たちは『源珍』をプレイし始めた。"}, {"type": "subtitle", "time": 17485.51, "timestamp": "04:51:25", "text": "そして私たちはその理由を忘れてしまった"}, {"type": "subtitle", "time": 17489.43, "timestamp": "04:51:29", "text": "私たちはVCを持っていた。そして突然"}, {"type": "subtitle", "time": 17491.83, "timestamp": "04:51:31", "text": "「あ、待って、ジョン。私たちは"}, {"type": "subtitle", "time": 17493.27, "timestamp": "04:51:33", "text": "コラボレーションについて話すはずだったの？"}, {"type": "subtitle", "time": 17497.03, "timestamp": "04:51:37", "text": "うん、そうだね。そうそう。コラボレーション。えっと、"}, {"type": "subtitle", "time": 17499.51, "timestamp": "04:51:39", "text": "ええ、それについてですが。私はとても"}, {"type": "subtitle", "time": 17501.75, "timestamp": "04:51:41", "text": "気づいていない。 「あ、待って。私は違う」"}, {"type": "subtitle", "time": 17509.03, "timestamp": "04:51:49", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 17513.19, "timestamp": "04:51:53", "text": "でも楽しかったよ。でも楽しかったよ。"}, {"type": "subtitle", "time": 17514.948, "timestamp": "04:51:54", "text": "お元気ですか？私はただ一気見している"}, {"type": "subtitle", "time": 17517.99, "timestamp": "04:51:57", "text": "Childやその他の原神の編集動画を視聴中。"}]
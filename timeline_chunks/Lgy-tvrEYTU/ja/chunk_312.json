[{"type": "subtitle", "time": 18720.638, "timestamp": "05:12:00", "text": "このバカなオタクどもは、 左"}, {"type": "subtitle", "time": 18722.48, "timestamp": "05:12:02", "text": "左 原神について話している。ああ、"}, {"type": "subtitle", "time": 18725.84, "timestamp": "05:12:05", "text": "原神について話している。ああ、 オタクですらない。これはただ、ああ、これ"}, {"type": "subtitle", "time": 18728.0, "timestamp": "05:12:08", "text": "オタクですらない。これはただ、ああ、これ バカなヴィックは本当にオタクだ。私はただ"}, {"type": "subtitle", "time": 18730.24, "timestamp": "05:12:10", "text": "バカなヴィックは本当にオタクだ。私はただ 出発します。戻ってきたいのは"}, {"type": "subtitle", "time": 18732.638, "timestamp": "05:12:12", "text": "出発します。戻ってきたいのは ジョックが話したら、そのまま立ち去る。"}, {"type": "subtitle", "time": 18741.43, "timestamp": "05:12:21", "text": "でもすごく楽しいよ、えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 18742.948, "timestamp": "05:12:22", "text": "それ？"}, {"type": "subtitle", "time": 18745.51, "timestamp": "05:12:25", "text": "私が原神で一番好きなところは"}, {"type": "subtitle", "time": 18748.788, "timestamp": "05:12:28", "text": "この伝承。主に伝承について。毎"}, {"type": "subtitle", "time": 18752.788, "timestamp": "05:12:32", "text": "このキャラクターには、深い伝承が書かれている。"}, {"type": "subtitle", "time": 18756.07, "timestamp": "05:12:36", "text": "あるいは、そんな感じ。ああ、伝承ね。その後"}, {"type": "subtitle", "time": 18760.07, "timestamp": "05:12:40", "text": "残りは全て罠だ。はい。私はただ"}, {"type": "subtitle", "time": 18763.91, "timestamp": "05:12:43", "text": "見せびらかしている。本当に良いです。"}, {"type": "subtitle", "time": 18767.83, "timestamp": "05:12:47", "text": "私は、私が持っているようなものが好きですか？"}, {"type": "subtitle", "time": 18770.15, "timestamp": "05:12:50", "text": "源珍を破滅させるアイデア？知ってる？"}, {"type": "subtitle", "time": 18773.83, "timestamp": "05:12:53", "text": "そうなの？それは何ですか？それは何ですか？"}, {"type": "subtitle", "time": 18778.708, "timestamp": "05:12:58", "text": "PvP"}]
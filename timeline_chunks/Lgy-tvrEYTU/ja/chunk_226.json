[{"type": "subtitle", "time": 13562.71, "timestamp": "03:46:02", "text": "離れて、えっと、あなたが持っていない限りわかりません"}, {"type": "subtitle", "time": 13565.03, "timestamp": "03:46:05", "text": "専用の部門のように"}, {"type": "subtitle", "time": 13567.67, "timestamp": "03:46:07", "text": "人々は、"}, {"type": "subtitle", "time": 13570.309, "timestamp": "03:46:10", "text": "バイオハザード収集などの専門家"}, {"type": "subtitle", "time": 13573.51, "timestamp": "03:46:13", "text": "無駄。あなたは信じられません"}, {"type": "subtitle", "time": 13576.229, "timestamp": "03:46:16", "text": "普通のゴミ収集員なら何をすべきか分かる"}, {"type": "subtitle", "time": 13578.95, "timestamp": "03:46:18", "text": "歯で、ですよね？だから"}, {"type": "subtitle", "time": 13582.55, "timestamp": "03:46:22", "text": "病院には、別々に"}, {"type": "subtitle", "time": 13585.99, "timestamp": "03:46:25", "text": "これ専用の部署は"}, {"type": "subtitle", "time": 13589.349, "timestamp": "03:46:29", "text": "生物学的有害廃棄物と同様に処分する。だからそれは"}, {"type": "subtitle", "time": 13591.189, "timestamp": "03:46:31", "text": "私たちにとっては問題ありません。収集する必要はありません"}, {"type": "subtitle", "time": 13594.07, "timestamp": "03:46:34", "text": "歯ですが、私たちは通常それをしたいので、"}, {"type": "subtitle", "time": 13595.83, "timestamp": "03:46:35", "text": "いつでも捨てることができます"}, {"type": "subtitle", "time": 13597.67, "timestamp": "03:46:37", "text": "権利が欲しいので大したことではないが"}, {"type": "subtitle", "time": 13599.67, "timestamp": "03:46:39", "text": "通常、私たちが歯を集める理由は"}, {"type": "subtitle", "time": 13602.309, "timestamp": "03:46:42", "text": "通常、自分自身を訓練するために"}, {"type": "subtitle", "time": 13605.75, "timestamp": "03:46:45", "text": "すごく几帳面で"}, {"type": "subtitle", "time": 13609.269, "timestamp": "03:46:49", "text": "当院のCTSなどの手順。おお、"}, {"type": "subtitle", "time": 13611.03, "timestamp": "03:46:51", "text": "そうですね。"}, {"type": "subtitle", "time": 13613.91, "timestamp": "03:46:53", "text": "うわあ、いろいろと大変なことが起きてる"}, {"type": "subtitle", "time": 13615.75, "timestamp": "03:46:55", "text": "歯科医で研修中の場合"}, {"type": "subtitle", "time": 13617.67, "timestamp": "03:46:57", "text": "そしてすべて、"}]
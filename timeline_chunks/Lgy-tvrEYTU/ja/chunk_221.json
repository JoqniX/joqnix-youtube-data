[{"type": "subtitle", "time": 13262.63, "timestamp": "03:41:02", "text": "非協力的な患者に遭遇する"}, {"type": "subtitle", "time": 13265.75, "timestamp": "03:41:05", "text": "治療はしたくない"}, {"type": "subtitle", "time": 13268.309, "timestamp": "03:41:08", "text": "あるいは何でもいい。彼らがそうしないわけではない"}, {"type": "subtitle", "time": 13270.229, "timestamp": "03:41:10", "text": "治療を望んでいるのではなく、"}, {"type": "subtitle", "time": 13274.15, "timestamp": "03:41:14", "text": "ファズだよね？うん。"}, {"type": "subtitle", "time": 13279.03, "timestamp": "03:41:19", "text": "それで、今日は患者さんが"}, {"type": "subtitle", "time": 13282.469, "timestamp": "03:41:22", "text": "誰が言ったか、それで私は今"}, {"type": "subtitle", "time": 13285.269, "timestamp": "03:41:25", "text": "前立腺歯科と呼ばれる部門は"}, {"type": "subtitle", "time": 13288.15, "timestamp": "03:41:28", "text": "文字通り、あなたの歯を交換するのです。それは"}, {"type": "subtitle", "time": 13291.67, "timestamp": "03:41:31", "text": "それ。それが文字通りの意味です。それで"}, {"type": "subtitle", "time": 13295.19, "timestamp": "03:41:35", "text": "私は、えーと、"}, {"type": "subtitle", "time": 13298.07, "timestamp": "03:41:38", "text": "オフィスで自分の仕事に集中している"}, {"type": "subtitle", "time": 13301.83, "timestamp": "03:41:41", "text": "そして誰かがヒドリー・ディドリーにやって来て"}, {"type": "subtitle", "time": 13305.19, "timestamp": "03:41:45", "text": "えっと、確認したいのですが、大丈夫です"}, {"type": "subtitle", "time": 13307.83, "timestamp": "03:41:47", "text": "様子を見に行き、それから彼を診察した"}, {"type": "subtitle", "time": 13311.67, "timestamp": "03:41:51", "text": "起き上がって、何が起こったかというと、彼の歯が全部"}, {"type": "subtitle", "time": 13315.99, "timestamp": "03:41:55", "text": "腐って、私は「いや、それはできない」って言った"}, {"type": "subtitle", "time": 13318.229, "timestamp": "03:41:58", "text": "私たちにはどうすることもできないことをする"}]
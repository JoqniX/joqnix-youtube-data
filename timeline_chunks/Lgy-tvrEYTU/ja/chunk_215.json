[{"type": "subtitle", "time": 12901.99, "timestamp": "03:35:01", "text": "普段は大きな声で話す。彼女はそうではない"}, {"type": "subtitle", "time": 12904.15, "timestamp": "03:35:04", "text": "狂ったように、でも彼女は声が大きい。それは"}, {"type": "subtitle", "time": 12907.349, "timestamp": "03:35:07", "text": "問題。そして人々は、"}, {"type": "subtitle", "time": 12909.03, "timestamp": "03:35:09", "text": "彼女は自分の言語で話している、"}, {"type": "subtitle", "time": 12910.79, "timestamp": "03:35:10", "text": "右？だから、人々が好むかもしれないのは、なぜ"}, {"type": "subtitle", "time": 12913.429, "timestamp": "03:35:13", "text": "彼女は叫んでいるの？彼女は「一体何が起こっているの？」という感じだった。"}, {"type": "subtitle", "time": 12915.19, "timestamp": "03:35:15", "text": "したくない、したくない"}, {"type": "subtitle", "time": 12918.229, "timestamp": "03:35:18", "text": "人々をパニックに陥れる。それで、お母さん、あなたは"}, {"type": "subtitle", "time": 12919.75, "timestamp": "03:35:19", "text": "出発するつもりですか？私は、いや、ただ"}, {"type": "subtitle", "time": 12921.19, "timestamp": "03:35:21", "text": "ここに滞在するつもりです。誰に話しかけているの？"}, {"type": "subtitle", "time": 12924.309, "timestamp": "03:35:24", "text": "に？えっと、じゃあ話しますね。その"}, {"type": "subtitle", "time": 12926.389, "timestamp": "03:35:26", "text": "いいよ、でも変な目で見ないで。私は"}, {"type": "subtitle", "time": 12928.07, "timestamp": "03:35:28", "text": "「ああ、わかった。大したことじゃないよ。」みたいな感じ。"}, {"type": "subtitle", "time": 12929.429, "timestamp": "03:35:29", "text": "そして私が話し始めると彼女はこう言った。"}, {"type": "subtitle", "time": 12931.03, "timestamp": "03:35:31", "text": "「わかった、彼女も彼も仕事に行くんだろうね。」"}, {"type": "subtitle", "time": 12939.51, "timestamp": "03:35:39", "text": "だから、繰り返しますが、大丈夫です。"}, {"type": "subtitle", "time": 12942.15, "timestamp": "03:35:42", "text": "彼女はそれについて何もするつもりはない。"}, {"type": "subtitle", "time": 12943.83, "timestamp": "03:35:43", "text": "彼女はただ私の話を聞きたいだけ"}, {"type": "subtitle", "time": 12947.269, "timestamp": "03:35:47", "text": "英語。それはいいです。"}, {"type": "subtitle", "time": 12950.469, "timestamp": "03:35:50", "text": "そしてまた、彼女は去っていった。大丈夫です。しかし"}, {"type": "subtitle", "time": 12953.59, "timestamp": "03:35:53", "text": "繰り返しますが、それはおそらく"}, {"type": "subtitle", "time": 12955.349, "timestamp": "03:35:55", "text": "彼女は確認したいかどうか確認している"}, {"type": "subtitle", "time": 12957.83, "timestamp": "03:35:57", "text": "犬の上に。彼女は見て、"}, {"type": "subtitle", "time": 12959.59, "timestamp": "03:35:59", "text": "まあ、いいでしょう。そして彼女は去っていった。その"}]
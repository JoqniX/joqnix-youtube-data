[{"type": "subtitle", "time": 3240.549, "timestamp": "00:54:00", "text": "ワイヤレスゲーミングキーボード。"}, {"type": "subtitle", "time": 3243.75, "timestamp": "00:54:03", "text": "プロRGB。ゲームなしワイヤレスゲーム"}, {"type": "subtitle", "time": 3246.95, "timestamp": "00:54:06", "text": "キーボード。これが私が伝えようとしたことなのです。"}, {"type": "subtitle", "time": 3249.19, "timestamp": "00:54:09", "text": "「ああ、これはシンプルなキーボードだ」と私は思った。"}, {"type": "subtitle", "time": 3254.71, "timestamp": "00:54:14", "text": "Type-C 文字でこれを書きます。"}, {"type": "subtitle", "time": 3258.71, "timestamp": "00:54:18", "text": "バッテリーが原因でしょうか？"}, {"type": "subtitle", "time": 3261.51, "timestamp": "00:54:21", "text": "それ以来、一度も充電していません。"}, {"type": "subtitle", "time": 3263.349, "timestamp": "00:54:23", "text": "私はこれを与えるべき"}, {"type": "subtitle", "time": 3265.75, "timestamp": "00:54:25", "text": "交換のために返送します。明日、新しい"}, {"type": "subtitle", "time": 3268.79, "timestamp": "00:54:28", "text": "さらに新しいバージョンが登場する予定です。"}, {"type": "subtitle", "time": 3271.91, "timestamp": "00:54:31", "text": "新しいバージョンというのは、同じ意味です。しかし"}, {"type": "subtitle", "time": 3274.15, "timestamp": "00:54:34", "text": "うん、Wゲームだけど、"}, {"type": "subtitle", "time": 3276.069, "timestamp": "00:54:36", "text": "事故。"}, {"type": "subtitle", "time": 3299.51, "timestamp": "00:54:59", "text": "何？"}]
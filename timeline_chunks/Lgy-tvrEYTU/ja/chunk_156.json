[{"type": "subtitle", "time": 9361.19, "timestamp": "02:36:01", "text": "はい、私は日本語の文章を理解できます。"}, {"type": "subtitle", "time": 9363.59, "timestamp": "02:36:03", "text": "少しですが、基本的なkasを読むことができます"}, {"type": "subtitle", "time": 9365.83, "timestamp": "02:36:05", "text": "まあ、でも漢字に苦労する"}, {"type": "subtitle", "time": 9368.63, "timestamp": "02:36:08", "text": "少し。ハハ。"}, {"type": "subtitle", "time": 9386.309, "timestamp": "02:36:26", "text": "それで、中国語の話になりますが、"}, {"type": "subtitle", "time": 9388.63, "timestamp": "02:36:28", "text": "その件に関して、あなたの進捗状況はどうですか？"}, {"type": "subtitle", "time": 9391.51, "timestamp": "02:36:31", "text": "最近、"}, {"type": "subtitle", "time": 9394.389, "timestamp": "02:36:34", "text": "徐々に良くなってきています。私はできる"}, {"type": "subtitle", "time": 9396.389, "timestamp": "02:36:36", "text": "話し言葉を少し理解する"}, {"type": "subtitle", "time": 9398.71, "timestamp": "02:36:38", "text": "そして、文章も少し書きました。しかし"}, {"type": "subtitle", "time": 9400.15, "timestamp": "02:36:40", "text": "もちろん、私はまだ少し苦労しています"}, {"type": "subtitle", "time": 9402.79, "timestamp": "02:36:42", "text": "漢字。私の脳はただbrになって"}, {"type": "subtitle", "time": 9417.19, "timestamp": "02:36:57", "text": "それは私のことを言いました。それは私のことを言いました。どうやって"}]
[{"type": "subtitle", "time": 13443.59, "timestamp": "03:44:03", "text": "「そうなるはずだったよね？」 いや、そうだね。"}, {"type": "subtitle", "time": 13446.07, "timestamp": "03:44:06", "text": "そしてジョッドがやって来てこう言った。「これは"}, {"type": "subtitle", "time": 13448.389, "timestamp": "03:44:08", "text": "ルール。私たちには何もできない。取引"}, {"type": "subtitle", "time": 13451.75, "timestamp": "03:44:11", "text": "「それを持って」と言って、彼はそのまま立ち去った。"}, {"type": "subtitle", "time": 13454.309, "timestamp": "03:44:14", "text": "そして彼はまるで一人と一人のために話しているようだった"}, {"type": "subtitle", "time": 13457.349, "timestamp": "03:44:17", "text": "彼の不正行為が"}, {"type": "subtitle", "time": 13459.59, "timestamp": "03:44:19", "text": "良い。そして私の敏捷性がすべてを解決しました"}, {"type": "subtitle", "time": 13463.189, "timestamp": "03:44:23", "text": "それを蹴り飛ばすだけで、彼らは面倒なことになる。"}, {"type": "subtitle", "time": 13467.59, "timestamp": "03:44:27", "text": "大丈夫です。彼らは彼を蹴った。おお"}, {"type": "subtitle", "time": 13470.309, "timestamp": "03:44:30", "text": "うん。いいえ、文字通りの意味ではありません。いいえ、私たちは"}, {"type": "subtitle", "time": 13474.07, "timestamp": "03:44:34", "text": "それらの。ああ、出て行くように言ったよ。はい、それです"}, {"type": "subtitle", "time": 13476.389, "timestamp": "03:44:36", "text": "私は普段はすべての"}, {"type": "subtitle", "time": 13479.189, "timestamp": "03:44:39", "text": "鵜呑みにしない方がいい。私は"}, {"type": "subtitle", "time": 13481.11, "timestamp": "03:44:41", "text": "それらは小さい。心配しないでください"}, {"type": "subtitle", "time": 13482.95, "timestamp": "03:44:42", "text": "それ。念のため警告しておきますが、"}, {"type": "subtitle", "time": 13486.389, "timestamp": "03:44:46", "text": "普段は比喩的な表現をよく使う。"}, {"type": "subtitle", "time": 13488.63, "timestamp": "03:44:48", "text": "だから、彼らの言うことを真に受けないでください。その"}, {"type": "subtitle", "time": 13491.75, "timestamp": "03:44:51", "text": "大丈夫。えっと"}, {"type": "subtitle", "time": 13493.83, "timestamp": "03:44:53", "text": "えーと"}, {"type": "subtitle", "time": 13497.349, "timestamp": "03:44:57", "text": "それは一日だった。"}, {"type": "subtitle", "time": 13499.349, "timestamp": "03:44:59", "text": "チャットで質問がありました"}]
[{"type": "subtitle", "time": 16801.19, "timestamp": "04:40:01", "text": "いや、しないよ、しないよ"}, {"type": "subtitle", "time": 16803.35, "timestamp": "04:40:03", "text": "面倒なことになるだろう。"}, {"type": "subtitle", "time": 16806.07, "timestamp": "04:40:06", "text": "うん。おそらくプリモスを手に入れて"}, {"type": "subtitle", "time": 16807.59, "timestamp": "04:40:07", "text": "離れる。"}, {"type": "subtitle", "time": 16810.15, "timestamp": "04:40:10", "text": "プリモス。私は原神にログインしていません"}, {"type": "subtitle", "time": 16813.67, "timestamp": "04:40:13", "text": "まだ。一度だけ"}, {"type": "subtitle", "time": 16816.55, "timestamp": "04:40:16", "text": "無料の五つ星合金。その後、私は"}, {"type": "subtitle", "time": 16826.15, "timestamp": "04:40:26", "text": "彼女はただのアンバーです。"}, {"type": "subtitle", "time": 16832.07, "timestamp": "04:40:32", "text": "でもでもパイロ。そうじゃないけど、まあね。"}, {"type": "subtitle", "time": 16835.11, "timestamp": "04:40:35", "text": "ええ、そうです。私は、あなたが"}, {"type": "subtitle", "time": 16837.59, "timestamp": "04:40:37", "text": "ユミアのような、とても良いものを持っている"}, {"type": "subtitle", "time": 16842.15, "timestamp": "04:40:42", "text": "弓を持つ人、ユミアのような弓を持つ人、そして"}, {"type": "subtitle", "time": 16847.75, "timestamp": "04:40:47", "text": "すると、I'm like no just like you を使う"}, {"type": "subtitle", "time": 16849.67, "timestamp": "04:40:49", "text": "ペ"}, {"type": "subtitle", "time": 16852.948, "timestamp": "04:40:52", "text": "うん、彼女はまるで速射砲みたいだ"}, {"type": "subtitle", "time": 16855.35, "timestamp": "04:40:55", "text": "そして今、私には子供がいますが、"}, {"type": "subtitle", "time": 16858.55, "timestamp": "04:40:58", "text": "むしろ、さらに素晴らしいと言えるでしょう。"}]
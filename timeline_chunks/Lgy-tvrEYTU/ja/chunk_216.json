[{"type": "subtitle", "time": 12963.11, "timestamp": "03:36:03", "text": "それは素晴らしい。うん。うん。ええ、そうですね。おい、"}, {"type": "subtitle", "time": 12965.429, "timestamp": "03:36:05", "text": "ジャック。ところで、今日の調子はどうですか？おお、"}, {"type": "subtitle", "time": 12968.15, "timestamp": "03:36:08", "text": "今日は良い一日だった。えっと、目が覚めたけど"}, {"type": "subtitle", "time": 12971.349, "timestamp": "03:36:11", "text": "今日は遅くまで起きていたが、生産的な一日だった。"}, {"type": "subtitle", "time": 12975.51, "timestamp": "03:36:15", "text": "日。うん。"}, {"type": "subtitle", "time": 12977.91, "timestamp": "03:36:17", "text": "しっかり休養も取れたし、何も問題なかった。"}, {"type": "subtitle", "time": 12980.95, "timestamp": "03:36:20", "text": "今日は本当に良かったですね。"}, {"type": "subtitle", "time": 12986.15, "timestamp": "03:36:26", "text": "うん。ところで、こんにちは、"}, {"type": "subtitle", "time": 12988.07, "timestamp": "03:36:28", "text": "小川にやって来た。誰だか全くわからない"}, {"type": "subtitle", "time": 12991.67, "timestamp": "03:36:31", "text": "チャットにはいますが、とにかくこんにちは。"}, {"type": "subtitle", "time": 13000.229, "timestamp": "03:36:40", "text": "アカヴがここにいる。クワックが来た。"}, {"type": "subtitle", "time": 13001.75, "timestamp": "03:36:41", "text": "DD。"}, {"type": "subtitle", "time": 13004.229, "timestamp": "03:36:44", "text": "こんにちは。"}, {"type": "subtitle", "time": 13007.59, "timestamp": "03:36:47", "text": "ああ、こんにちは。こんにちは。"}, {"type": "subtitle", "time": 13010.55, "timestamp": "03:36:50", "text": "こんにちは、みんな。見ることができなくて申し訳ありません"}, {"type": "subtitle", "time": 13012.55, "timestamp": "03:36:52", "text": "あなた"}, {"type": "subtitle", "time": 13018.15, "timestamp": "03:36:58", "text": "えっと、私のポテトポテトフォンで"}, {"type": "subtitle", "time": 13019.83, "timestamp": "03:36:59", "text": "そして同時に"}]
[{"type": "subtitle", "time": 14881.11, "timestamp": "04:08:01", "text": "チャットの続きを教えて"}, {"type": "subtitle", "time": 14884.07, "timestamp": "04:08:04", "text": "もう一度聞くのか、ジャック？あぁ、えっと、私はこう思った"}, {"type": "subtitle", "time": 14886.63, "timestamp": "04:08:06", "text": "チャットで追いついて、"}, {"type": "subtitle", "time": 14888.39, "timestamp": "04:08:08", "text": "もの。どうぞ。"}, {"type": "subtitle", "time": 14890.71, "timestamp": "04:08:10", "text": "[音楽]"}, {"type": "subtitle", "time": 14894.95, "timestamp": "04:08:14", "text": "それで、ヘッドパッドをあげたんです"}, {"type": "subtitle", "time": 14897.03, "timestamp": "04:08:17", "text": "私たち二人ともオーラルセックスをされているような感じ"}, {"type": "subtitle", "time": 14900.71, "timestamp": "04:08:20", "text": "パッド入りで、あと、えっと、何"}, {"type": "subtitle", "time": 14904.309, "timestamp": "04:08:24", "text": "あなたはそれを何と呼ぶのですか？私はパンとセブンを持っています"}, {"type": "subtitle", "time": 14908.15, "timestamp": "04:08:28", "text": "ボウル、そして水の入ったボウルのように"}, {"type": "subtitle", "time": 14911.99, "timestamp": "04:08:31", "text": "7つのボウルができるかどうかはわかりません"}, {"type": "subtitle", "time": 14917.14, "timestamp": "04:08:37", "text": "レッドブルと呼ぶこともできるが、セブンブル"}, {"type": "subtitle", "time": 14918.389, "timestamp": "04:08:38", "text": "[音楽]"}, {"type": "subtitle", "time": 14922.229, "timestamp": "04:08:42", "text": "なぜ、私にはわからない、それは何なのか"}, {"type": "subtitle", "time": 14925.11, "timestamp": "04:08:45", "text": "これは何だ？これはおそらくこれだ"}, {"type": "subtitle", "time": 14927.269, "timestamp": "04:08:47", "text": "おそらく、あなたがそうしないのと同じように準備しているのでしょう"}, {"type": "subtitle", "time": 14929.67, "timestamp": "04:08:49", "text": "味気ないものを見せたくない"}, {"type": "subtitle", "time": 14933.269, "timestamp": "04:08:53", "text": "ああ、そうかもしれないね。"}, {"type": "subtitle", "time": 14936.469, "timestamp": "04:08:56", "text": "また、カスタムメイドなので、"}, {"type": "subtitle", "time": 14938.71, "timestamp": "04:08:58", "text": "VTuberのアセット。そうかもしれないね"}]
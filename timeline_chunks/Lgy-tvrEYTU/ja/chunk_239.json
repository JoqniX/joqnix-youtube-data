[{"type": "subtitle", "time": 14341.67, "timestamp": "03:59:01", "text": "引き抜くんだよね？はい。それで"}, {"type": "subtitle", "time": 14343.83, "timestamp": "03:59:03", "text": "教授は言った、「おい、こいつらは"}, {"type": "subtitle", "time": 14346.95, "timestamp": "03:59:06", "text": "私たちはここに来たばかりです。彼らを注意深く見守ってください"}, {"type": "subtitle", "time": 14348.55, "timestamp": "03:59:08", "text": "彼らは自分たちが何をしているのか全く分かっていないから"}, {"type": "subtitle", "time": 14350.07, "timestamp": "03:59:10", "text": "実行中。見守っていてください。"}, {"type": "subtitle", "time": 14352.63, "timestamp": "03:59:12", "text": "「ああ、いいよ。いいんじゃない？」みたいな感じ。まるで私が"}, {"type": "subtitle", "time": 14354.55, "timestamp": "03:59:14", "text": "コーダーを終えたので、"}, {"type": "subtitle", "time": 14356.87, "timestamp": "03:59:16", "text": "好きじゃないし、見る必要もない"}, {"type": "subtitle", "time": 14360.229, "timestamp": "03:59:20", "text": "事例について。だから、私はかなり自由だった。うん。"}, {"type": "subtitle", "time": 14363.349, "timestamp": "03:59:23", "text": "うん。だから私は患者の世話をするのが好きなんです"}, {"type": "subtitle", "time": 14365.59, "timestamp": "03:59:25", "text": "なぜなら彼らは別のものから出ていたから"}, {"type": "subtitle", "time": 14368.229, "timestamp": "03:59:28", "text": "スタッフが1人しかいなかったため、このケースが発生しました。"}, {"type": "subtitle", "time": 14370.71, "timestamp": "03:59:30", "text": "表の中の教授の一人のように。"}, {"type": "subtitle", "time": 14373.91, "timestamp": "03:59:33", "text": "だから彼は本当にうまく扱えない"}, {"type": "subtitle", "time": 14376.55, "timestamp": "03:59:36", "text": "全てを彼一人で成し遂げた。それで彼は電話した"}, {"type": "subtitle", "time": 14379.75, "timestamp": "03:59:39", "text": "私にはあなたの助けが必要です。私は次のようなものが必要です"}, {"type": "subtitle", "time": 14381.91, "timestamp": "03:59:41", "text": "これとこれに注目してほしい"}, {"type": "subtitle", "time": 14386.87, "timestamp": "03:59:46", "text": "人々。右。うん。"}, {"type": "subtitle", "time": 14388.87, "timestamp": "03:59:48", "text": "まあ、いいんじゃない。"}, {"type": "subtitle", "time": 14393.03, "timestamp": "03:59:53", "text": "ああ、もちろん、いいですよ。私は暇です。"}, {"type": "subtitle", "time": 14395.269, "timestamp": "03:59:55", "text": "つまり、私は何もしていないんです。つまり、"}, {"type": "subtitle", "time": 14398.63, "timestamp": "03:59:58", "text": "よくやったと思うよ。まあ、どうでもいいけど。"}]
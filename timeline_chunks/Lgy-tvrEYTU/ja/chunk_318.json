[{"type": "subtitle", "time": 19081.67, "timestamp": "05:18:01", "text": "背景に何か聞こえますか？"}, {"type": "subtitle", "time": 19084.708, "timestamp": "05:18:04", "text": "ええ、そうではないと思います。待って、"}, {"type": "subtitle", "time": 19086.31, "timestamp": "05:18:06", "text": "ノイズ抑制機能がオンになっていることを確認してください。"}, {"type": "subtitle", "time": 19089.03, "timestamp": "05:18:09", "text": "不和。猫ってそういうものですよね。"}, {"type": "subtitle", "time": 19091.51, "timestamp": "05:18:11", "text": "奴らはここで何でもかんでも食べまくってる。"}, {"type": "subtitle", "time": 19093.27, "timestamp": "05:18:13", "text": "そして、彼女が怒っているのが聞こえる。彼女は"}, {"type": "subtitle", "time": 19095.59, "timestamp": "05:18:15", "text": "まるでクソ猫みたいだ。これを食べたのは誰？誰が"}, {"type": "subtitle", "time": 19103.43, "timestamp": "05:18:23", "text": "今は猫の鳴き声に対処しなければならない"}, {"type": "subtitle", "time": 19107.75, "timestamp": "05:18:27", "text": "そして、彼女の騒音。何てことだ。"}, {"type": "subtitle", "time": 19114.39, "timestamp": "05:18:34", "text": "ということは、あなたは猫を4匹飼っているんですね。"}, {"type": "subtitle", "time": 19118.55, "timestamp": "05:18:38", "text": "ああ、私にとっては、そのうちの1つは"}, {"type": "subtitle", "time": 19120.55, "timestamp": "05:18:40", "text": "ない。だから誰かが盗んだと思う"}, {"type": "subtitle", "time": 19124.708, "timestamp": "05:18:44", "text": "それか、あるいはそれに何かが起こった。"}, {"type": "subtitle", "time": 19127.11, "timestamp": "05:18:47", "text": "母猫は３匹の子猫を産んだ"}, {"type": "subtitle", "time": 19129.59, "timestamp": "05:18:49", "text": "子猫だったのに、今ではすっかり大きくなった。私"}, {"type": "subtitle", "time": 19132.39, "timestamp": "05:18:52", "text": "いつも彼女を取り囲んでいるのは、"}, {"type": "subtitle", "time": 19135.59, "timestamp": "05:18:55", "text": "もの。えっと、"}, {"type": "subtitle", "time": 19137.83, "timestamp": "05:18:57", "text": "うん。"}, {"type": "subtitle", "time": 19139.91, "timestamp": "05:18:59", "text": "また妊娠したんですね。彼はすでに"}]
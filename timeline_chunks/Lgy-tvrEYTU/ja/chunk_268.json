[{"type": "subtitle", "time": 16082.389, "timestamp": "04:28:02", "text": "これについては、私に知らせる必要があります。彼"}, {"type": "subtitle", "time": 16084.149, "timestamp": "04:28:04", "text": "私をじっと見て、「あなたは何者ですか」"}, {"type": "subtitle", "time": 16086.229, "timestamp": "04:28:06", "text": "何について話しているのですか？おしっこしたいんだけど、"}, {"type": "subtitle", "time": 16088.149, "timestamp": "04:28:08", "text": "私は外に出て、今おしっこをしています。どうしたの"}, {"type": "subtitle", "time": 16094.63, "timestamp": "04:28:14", "text": "ごめんなさい。でも今は彼は上手で"}, {"type": "subtitle", "time": 16096.309, "timestamp": "04:28:16", "text": "私と連絡を取ってください。今はまるで"}, {"type": "subtitle", "time": 16099.189, "timestamp": "04:28:19", "text": "私の部屋。彼はただ私を見て、「"}, {"type": "subtitle", "time": 16100.79, "timestamp": "04:28:20", "text": "「おい、何やってんだよ？」って感じだったんだけど、"}, {"type": "chat", "time": 16100.932, "timestamp": "04:28:20", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "collab at 4:30pm"}, {"type": "subtitle", "time": 16103.429, "timestamp": "04:28:23", "text": "「よし、君はおしっこに行きたいんだね。」そして私は"}, {"type": "subtitle", "time": 16107.99, "timestamp": "04:28:27", "text": "彼を連れ出して、彼は素晴らしい。"}, {"type": "subtitle", "time": 16110.229, "timestamp": "04:28:30", "text": "彼はおしっこをするのがとても上手だ。その"}, {"type": "subtitle", "time": 16112.469, "timestamp": "04:28:32", "text": "良い。彼は非常に優秀な同僚です"}, {"type": "subtitle", "time": 16116.55, "timestamp": "04:28:36", "text": "お分かりでしょうが。熟練した同僚。"}, {"type": "subtitle", "time": 16124.309, "timestamp": "04:28:44", "text": "もし犬のためのオリンピックがあれば"}, {"type": "subtitle", "time": 16128.55, "timestamp": "04:28:48", "text": "おしっこをしたら、金メダルがもらえるかもしれない。"}, {"type": "subtitle", "time": 16131.99, "timestamp": "04:28:51", "text": "疑問符。わからない。"}, {"type": "subtitle", "time": 16134.71, "timestamp": "04:28:54", "text": "金メダル。"}, {"type": "subtitle", "time": 16138.87, "timestamp": "04:28:58", "text": "おしっこで金メダル。想像する。想像する"}]
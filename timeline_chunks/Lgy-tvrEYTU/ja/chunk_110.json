[{"type": "subtitle", "time": 6602.149, "timestamp": "01:50:02", "text": "危うく自分のシーンを削除するところだった。おお。"}, {"type": "subtitle", "time": 6604.07, "timestamp": "01:50:04", "text": "ニース。"}, {"type": "subtitle", "time": 6608.55, "timestamp": "01:50:08", "text": "あのね？私は横向きのゲームをしている。"}, {"type": "subtitle", "time": 6612.07, "timestamp": "01:50:12", "text": "ええ、実は私はゲームを横向きにプレイしているんです。"}, {"type": "subtitle", "time": 6623.59, "timestamp": "01:50:23", "text": "まるでベッドに足を乗せたみたいに。"}, {"type": "subtitle", "time": 6626.87, "timestamp": "01:50:26", "text": "マイクはここにあります。"}, {"type": "subtitle", "time": 6646.55, "timestamp": "01:50:46", "text": "[音楽]"}, {"type": "subtitle", "time": 6650.79, "timestamp": "01:50:50", "text": "これを建設したくない。"}, {"type": "subtitle", "time": 6653.189, "timestamp": "01:50:53", "text": "私はただ見ているだけです"}, {"type": "subtitle", "time": 6655.51, "timestamp": "01:50:55", "text": "ああいうバスルーム。"}]
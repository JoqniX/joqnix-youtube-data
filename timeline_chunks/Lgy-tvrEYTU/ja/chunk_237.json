[{"type": "subtitle", "time": 14222.63, "timestamp": "03:57:02", "text": "私はあなたが何を待っているのかとても"}, {"type": "subtitle", "time": 14225.189, "timestamp": "03:57:05", "text": "非常に経験豊富なあなたのように、"}, {"type": "subtitle", "time": 14228.469, "timestamp": "03:57:08", "text": "血は、いやいやいや、今だ、私は"}, {"type": "subtitle", "time": 14231.51, "timestamp": "03:57:11", "text": "昔、初めて血液を扱った"}, {"type": "subtitle", "time": 14233.429, "timestamp": "03:57:13", "text": "仕事の日、私は気絶しました。"}, {"type": "subtitle", "time": 14235.99, "timestamp": "03:57:15", "text": "血と、私はそれすら処理できなかった。私"}, {"type": "subtitle", "time": 14238.63, "timestamp": "03:57:18", "text": "血を見た瞬間、気絶しそうになった。"}, {"type": "subtitle", "time": 14240.79, "timestamp": "03:57:20", "text": "「ああ、くそ。」"}, {"type": "subtitle", "time": 14244.389, "timestamp": "03:57:24", "text": "本当に？くそ。この男が"}, {"type": "subtitle", "time": 14247.189, "timestamp": "03:57:27", "text": "「これだよ。」そして、私はそれに慣れていった。"}, {"type": "subtitle", "time": 14249.03, "timestamp": "03:57:29", "text": "2日目には慣れた。その"}, {"type": "subtitle", "time": 14250.63, "timestamp": "03:57:30", "text": "大丈夫。でも初日はできなかった"}, {"type": "subtitle", "time": 14253.11, "timestamp": "03:57:33", "text": "対処してください。えっと、それは"}, {"type": "subtitle", "time": 14256.07, "timestamp": "03:57:36", "text": "なかなかいいでしょう？"}, {"type": "subtitle", "time": 14258.87, "timestamp": "03:57:38", "text": "ええ、それはまた非常に興味深いですね。"}, {"type": "subtitle", "time": 14264.15, "timestamp": "03:57:44", "text": "再び人々を中心とした物語が語られるようになった。私は思う"}, {"type": "subtitle", "time": 14266.469, "timestamp": "03:57:46", "text": "それを何と呼ぶか​​考えてみてください。"}, {"type": "subtitle", "time": 14269.349, "timestamp": "03:57:49", "text": "ええと、外科医がすぐそこにいます"}, {"type": "subtitle", "time": 14272.63, "timestamp": "03:57:52", "text": "集中治療室とかがある病院みたいな感じ。おお"}, {"type": "subtitle", "time": 14275.67, "timestamp": "03:57:55", "text": "ええ、さっき話したように"}, {"type": "subtitle", "time": 14278.87, "timestamp": "03:57:58", "text": "血を見て気絶したとき、私は"}]
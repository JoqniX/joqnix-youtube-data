[{"type": "subtitle", "time": 14282.63, "timestamp": "03:58:02", "text": "手術室にいる研修医"}, {"type": "subtitle", "time": 14285.99, "timestamp": "03:58:05", "text": "えーと、部署は、彼らがカットするときみたい"}, {"type": "subtitle", "time": 14291.429, "timestamp": "03:58:11", "text": "人間の、えっと、物を開ける。ああ、大変だ"}, {"type": "subtitle", "time": 14294.87, "timestamp": "03:58:14", "text": "それについて考えている。ああ、もし私がもし私が"}, {"type": "subtitle", "time": 14298.469, "timestamp": "03:58:18", "text": "そこでは、私は一人で気を失うだろう。"}, {"type": "subtitle", "time": 14300.79, "timestamp": "03:58:20", "text": "私はそれが怖い。おそらく私は"}, {"type": "subtitle", "time": 14304.309, "timestamp": "03:58:24", "text": "君の彼氏だよ。ご心配なく。"}, {"type": "subtitle", "time": 14306.71, "timestamp": "03:58:26", "text": "君のそばにいるよ。気絶しないでね。そして"}, {"type": "subtitle", "time": 14311.269, "timestamp": "03:58:31", "text": "彼らはただ「ちくしょう」って感じで[ __ ]するんだ。"}, {"type": "subtitle", "time": 14315.189, "timestamp": "03:58:35", "text": "こんにちは。あ、そういえば、かすかな"}, {"type": "subtitle", "time": 14318.71, "timestamp": "03:58:38", "text": "えーと私のえーと"}, {"type": "subtitle", "time": 14321.75, "timestamp": "03:58:41", "text": "私の優秀な層にはジュニアもいます。"}, {"type": "subtitle", "time": 14324.95, "timestamp": "03:58:44", "text": "右？歯を抜かなければならない。私たちは"}, {"type": "subtitle", "time": 14326.87, "timestamp": "03:58:46", "text": "歯を抜かなければならない、それが"}, {"type": "subtitle", "time": 14328.95, "timestamp": "03:58:48", "text": "私たちはそうしなければならない。抜歯も行っています"}, {"type": "subtitle", "time": 14331.349, "timestamp": "03:58:51", "text": "それは歯を抜くようなもので"}, {"type": "subtitle", "time": 14333.99, "timestamp": "03:58:53", "text": "ひどくひどく、私が言ったように"}, {"type": "subtitle", "time": 14336.07, "timestamp": "03:58:56", "text": "まるでたくさんの歯が生えているのに、あなたは全く気づいていない"}, {"type": "subtitle", "time": 14337.269, "timestamp": "03:58:57", "text": "それについてどうすべきか。あなたはただ"}]
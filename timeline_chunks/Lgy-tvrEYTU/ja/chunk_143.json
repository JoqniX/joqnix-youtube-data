[{"type": "subtitle", "time": 8585.67, "timestamp": "02:23:05", "text": "なぜ私が"}, {"type": "subtitle", "time": 8590.79, "timestamp": "02:23:10", "text": "する？これは何ですか？これは何ですか？"}, {"type": "subtitle", "time": 8596.309, "timestamp": "02:23:16", "text": "これは何ですか？私は文字通りこう言った"}, {"type": "subtitle", "time": 8599.11, "timestamp": "02:23:19", "text": "最近、誰かに、なぜならその人"}, {"type": "subtitle", "time": 8601.429, "timestamp": "02:23:21", "text": "PPLが何なのか理解していなかった。そして私は"}, {"type": "subtitle", "time": 8604.07, "timestamp": "02:23:24", "text": "「あ、ごめんなさい。タイプミスです。"}, {"type": "subtitle", "time": 8606.63, "timestamp": "02:23:26", "text": "彼"}, {"type": "subtitle", "time": 8609.03, "timestamp": "02:23:29", "text": "誰が待っているの？誰かがこのスポーツマンを訓練したのか"}, {"type": "subtitle", "time": 8611.91, "timestamp": "02:23:31", "text": "私がこの運動選手の世話をしていなかった間に"}, {"type": "subtitle", "time": 8615.03, "timestamp": "02:23:35", "text": "数ヶ月くらいの間ですか？"}, {"type": "subtitle", "time": 8619.19, "timestamp": "02:23:39", "text": "待って、待って。"}, {"type": "subtitle", "time": 8622.63, "timestamp": "02:23:42", "text": "うん。さよなら。ジョー、もっと頑張らないと。"}, {"type": "subtitle", "time": 8625.83, "timestamp": "02:23:45", "text": "誰が"}, {"type": "subtitle", "time": 8627.75, "timestamp": "02:23:47", "text": "ジョー、あなたの携帯電話は盗聴しているの？あなたは何を"}, {"type": "subtitle", "time": 8629.91, "timestamp": "02:23:49", "text": "意味も？うん。うん。こんにちは、Akaさん。"}, {"type": "subtitle", "time": 8631.99, "timestamp": "02:23:51", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 8634.71, "timestamp": "02:23:54", "text": "AIはやや臆病だ。臆病って何？"}, {"type": "subtitle", "time": 8637.59, "timestamp": "02:23:57", "text": "臆病って何？ N"}, {"type": "subtitle", "time": 8639.51, "timestamp": "02:23:59", "text": "臆病って何？"}]
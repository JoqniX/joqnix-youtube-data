[{"type": "subtitle", "time": 17222.15, "timestamp": "04:47:02", "text": "なぜうちの犬は鳴いているのですか？彼は私に少し時間をくれた。"}, {"type": "subtitle", "time": 17224.708, "timestamp": "04:47:04", "text": "彼に何があったの？彼は"}, {"type": "subtitle", "time": 17226.708, "timestamp": "04:47:06", "text": "見て、彼はただ興奮しているだけだと思う"}, {"type": "subtitle", "time": 17230.55, "timestamp": "04:47:10", "text": "中に人がいるから"}, {"type": "subtitle", "time": 17233.67, "timestamp": "04:47:13", "text": "あと、彼を撫でてあげることも忘れないでくださいね。彼"}, {"type": "subtitle", "time": 17237.27, "timestamp": "04:47:17", "text": "必要になるかもしれない。彼にはそれが必要なのです。うん。こんにちは"}, {"type": "subtitle", "time": 17245.19, "timestamp": "04:47:25", "text": "私の支払い済み。さあ、行こう。待ちきれない"}, {"type": "subtitle", "time": 17248.07, "timestamp": "04:47:28", "text": "あなたの人生でデビューするために"}, {"type": "subtitle", "time": 17262.31, "timestamp": "04:47:42", "text": "ええ、私たちは、私たちが行ったことについて話しています"}, {"type": "subtitle", "time": 17267.03, "timestamp": "04:47:47", "text": "えーと、Vex について話すことから、えーと、えーと"}, {"type": "subtitle", "time": 17272.47, "timestamp": "04:47:52", "text": "DES の冒険を DES として体験する、えっと、待って"}, {"type": "subtitle", "time": 17277.27, "timestamp": "04:47:57", "text": "うん、私たちの言語のものを気に入ってくれるまで待って"}, {"type": "subtitle", "time": 17279.99, "timestamp": "04:47:59", "text": "えーっと、私たちは買った、私たちは話している"}]
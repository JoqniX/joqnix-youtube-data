[{"type": "subtitle", "time": 15421.67, "timestamp": "04:17:01", "text": "私はチャディチャディボという言葉を知っています"}, {"type": "subtitle", "time": 15424.55, "timestamp": "04:17:04", "text": "つまり、飛び越えて、"}, {"type": "subtitle", "time": 15426.95, "timestamp": "04:17:06", "text": "ジャンプして行く。うん、まるで"}, {"type": "subtitle", "time": 15429.91, "timestamp": "04:17:09", "text": "文字通り列を飛び越えたり、列を飛ばしたりすること。"}, {"type": "subtitle", "time": 15432.309, "timestamp": "04:17:12", "text": "主に神々は、ああ、ボードのような"}, {"type": "subtitle", "time": 15434.87, "timestamp": "04:17:14", "text": "えっと、わかりました。それは、～しないという意味です"}, {"type": "subtitle", "time": 15436.87, "timestamp": "04:17:16", "text": "列に並ばずに済むとか、そんな感じのこと。"}, {"type": "subtitle", "time": 15439.11, "timestamp": "04:17:19", "text": "うん。うん。うん。そうです。うん。うん。"}, {"type": "subtitle", "time": 15441.429, "timestamp": "04:17:21", "text": "うん。でも面白いですね。私は思う"}, {"type": "subtitle", "time": 15443.349, "timestamp": "04:17:23", "text": "誰かが面白がってそう言っているのを見た"}, {"type": "subtitle", "time": 15447.59, "timestamp": "04:17:27", "text": "公園。遊園地。"}, {"type": "subtitle", "time": 15449.429, "timestamp": "04:17:29", "text": "そして私は「ああ、その言葉知ってる」と思った。"}, {"type": "subtitle", "time": 15453.91, "timestamp": "04:17:33", "text": "ち。私は「気」という言葉を知っています。"}, {"type": "subtitle", "time": 15456.71, "timestamp": "04:17:36", "text": "わかってるよ、チ。それはジャンプを意味します。私はこう思う、"}, {"type": "subtitle", "time": 15459.59, "timestamp": "04:17:39", "text": "どうしてそれを知っているのですか？私にはわからない。"}, {"type": "subtitle", "time": 15462.309, "timestamp": "04:17:42", "text": "私にも仲間がいる。私は人々に"}, {"type": "subtitle", "time": 15466.149, "timestamp": "04:17:46", "text": "南。どういう意味ですか？"}, {"type": "subtitle", "time": 15469.11, "timestamp": "04:17:49", "text": "チャワンデ。チャワンデって、キックって意味だよね？は"}, {"type": "subtitle", "time": 15472.229, "timestamp": "04:17:52", "text": "そうですよね？ええと、あると思います"}, {"type": "subtitle", "time": 15474.71, "timestamp": "04:17:54", "text": "そんな感じ。うん。ああ、蹴りだ。えっと"}, {"type": "subtitle", "time": 15478.87, "timestamp": "04:17:58", "text": "チャウィはチャンティみたい。そうそう。私たちは"}]
[{"type": "subtitle", "time": 22321.11, "timestamp": "06:12:01", "text": "I love the fact that I'm dying first. I"}, {"type": "subtitle", "time": 22338.628, "timestamp": "06:12:18", "text": "Other side was not cleared. Oh."}, {"type": "subtitle", "time": 22342.548, "timestamp": "06:12:22", "text": "You will not kill my ally."}, {"type": "subtitle", "time": 22347.29, "timestamp": "06:12:27", "text": "No, Cypher. He got his first kill today."}, {"type": "subtitle", "time": 22352.47, "timestamp": "06:12:32", "text": "[Applause]"}, {"type": "subtitle", "time": 22372.15, "timestamp": "06:12:52", "text": "Going D or A again. Keep pushing A until"}, {"type": "subtitle", "time": 22373.5, "timestamp": "06:12:53", "text": "it works."}]
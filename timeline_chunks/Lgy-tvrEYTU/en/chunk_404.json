[{"type": "subtitle", "time": 24247.43, "timestamp": "06:44:07", "text": "What is he looking at? Oh, yeah. You"}, {"type": "subtitle", "time": 24270.708, "timestamp": "06:44:30", "text": "Oh my god, you slowed me."}, {"type": "subtitle", "time": 24273.19, "timestamp": "06:44:33", "text": "Get him."}, {"type": "subtitle", "time": 24287.59, "timestamp": "06:44:47", "text": "One. Above. Above. Above."}]
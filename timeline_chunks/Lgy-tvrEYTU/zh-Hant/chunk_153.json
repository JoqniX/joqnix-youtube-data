[{"type": "subtitle", "time": 9187.59, "timestamp": "02:33:07", "text": "你可能會說它有點肝，但這種肝的過程很有趣"}, {"type": "subtitle", "time": 9212.309, "timestamp": "02:33:32", "text": "肝？啊"}, {"type": "subtitle", "time": 9222.23, "timestamp": "02:33:42", "text": "，我明白了。我明白了。你最近直播過哪些類型的遊戲？能詳細說說嗎？想像一下如果是《我的"}, {"type": "subtitle", "time": 9225.91, "timestamp": "02:33:45", "text": "世界》會是什麼樣子。我最近直播過不少遊戲，從《Apex英雄》到《原神》再到《魔物獵人》等等。在我"}]
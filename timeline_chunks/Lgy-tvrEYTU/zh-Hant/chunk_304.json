[{"type": "subtitle", "time": 18244.39, "timestamp": "05:04:04", "text": "。是"}, {"type": "subtitle", "time": 18248.628, "timestamp": "05:04:08", "text": "啊。還有，呃，是的。你好，"}, {"type": "subtitle", "time": 18252.39, "timestamp": "05:04:12", "text": "Mima。歡迎。歡迎。歡迎。"}, {"type": "subtitle", "time": 18254.31, "timestamp": "05:04:14", "text": "是啊。"}, {"type": "subtitle", "time": 18256.55, "timestamp": "05:04:16", "text": "你好。我好像在"}, {"type": "subtitle", "time": 18264.788, "timestamp": "05:04:24", "text": "聊天裡引發了一場辯論嗎？我覺得大家還沒開始"}, {"type": "subtitle", "time": 18280.788, "timestamp": "05:04:40", "text": "書呆子，然後他們就走了，還在聊原神。"}, {"type": "subtitle", "time": 18295.19, "timestamp": "05:04:55", "text": "啊，其實也"}, {"type": "subtitle", "time": 18297.99, "timestamp": "05:04:57", "text": "不算書呆子。 ，我有個"}]
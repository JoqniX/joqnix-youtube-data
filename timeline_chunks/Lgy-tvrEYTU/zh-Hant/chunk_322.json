[{"type": "subtitle", "time": 19324.868, "timestamp": "05:22:04", "text": "。  我的天啊。毛"}, {"type": "subtitle", "time": 19329.19, "timestamp": "05:22:09", "text": "毛蟲很可愛。我的天哪。"}, {"type": "subtitle", "time": 19337.51, "timestamp": "05:22:17", "text": "我的天哪。如果你加入了 jocknes"}, {"type": "subtitle", "time": 19367.11, "timestamp": "05:22:47", "text": "jocknick 的會員，你就會收到一條消息。你會免費獲得一隻綠毛蟲。  我的天哪，是喬伊克。  耶。我們在遊戲中。"}, {"type": "subtitle", "time": 19370.07, "timestamp": "05:22:50", "text": "讓我換一下。讓我換一下這個東西。  我希望"}]
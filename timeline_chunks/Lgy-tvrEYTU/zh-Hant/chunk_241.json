[{"type": "subtitle", "time": 14473.51, "timestamp": "04:01:13", "text": "哦，其實也沒那麼容易。然後我會教他們。"}, {"type": "subtitle", "time": 14482.79, "timestamp": "04:01:22", "text": "我認為這就是為什麼有人喜歡有人不喜歡我不在乎長輩那種態度的原因。因為他們中的大多數人都有一種「我不在乎長輩」的態度，因為我想教這些人任何東西，但教學是件好事"}, {"type": "subtitle", "time": 14484.87, "timestamp": "04:01:24", "text": "。"}, {"type": "subtitle", "time": 14492.71, "timestamp": "04:01:32", "text": "我覺得是我的老師教過"}, {"type": "subtitle", "time": 14495.67, "timestamp": "04:01:35", "text": "我這個的。我的教授，你知道的，就是那個能在五分鐘內解決爭論的人，系主任，實際上教過我這方面的"}, {"type": "subtitle", "time": 14497.269, "timestamp": "04:01:37", "text": "知識，因為我覺得"}, {"type": "subtitle", "time": 14507.03, "timestamp": "04:01:47", "text": "我們"}, {"type": "subtitle", "time": 14509.51, "timestamp": "04:01:49", "text": "有兩三個員工在各自的領域都非常出色，對吧？  他們就像是"}, {"type": "subtitle", "time": 14519.83, "timestamp": "04:01:59", "text": "天賦異稟的少年。"}]
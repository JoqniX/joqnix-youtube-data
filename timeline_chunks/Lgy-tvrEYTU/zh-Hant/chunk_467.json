[{"type": "subtitle", "time": 28036.628, "timestamp": "07:47:16", "text": "哦，從推特上。哦，推特上"}, {"type": "subtitle", "time": 28043.99, "timestamp": "07:47:23", "text": "有什麼？好的。好的。好的。啊。是的。是的。是的。剛開始的時候，剛加入的時候，工作比較空閒"}, {"type": "subtitle", "time": 28058.948, "timestamp": "07:47:38", "text": "我真的很懷念那些日子。說實話，兩年前我真的很自由。"}, {"type": "subtitle", "time": 28079.67, "timestamp": "07:47:59", "text": "現在我腦子裡全是工作。我感覺我基本上是靠咖啡活著。"}]
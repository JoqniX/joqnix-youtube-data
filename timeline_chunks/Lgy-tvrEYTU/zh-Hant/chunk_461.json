[{"type": "subtitle", "time": 27663.83, "timestamp": "07:41:03", "text": "我分心。 [音樂] 是的，"}, {"type": "subtitle", "time": 27666.708, "timestamp": "07:41:06", "text": "我以前用過，那時候我還沒有顯示器之類的東西"}, {"type": "subtitle", "time": 27677.83, "timestamp": "07:41:17", "text": "。"}, {"type": "subtitle", "time": 27684.548, "timestamp": "07:41:24", "text": "我以前常用。挺好玩的。我最初是在Twitch上直播的。我就是Twitch出身的，你知道的。以前在"}, {"type": "subtitle", "time": 27691.99, "timestamp": "07:41:31", "text": "Twitch上發展很難。不，現在在Twitch上發展仍然很難。"}, {"type": "subtitle", "time": 27707.27, "timestamp": "07:41:47", "text": "Twitch更像是你擁有一個穩定的粉絲群，然後你開始直播。"}]
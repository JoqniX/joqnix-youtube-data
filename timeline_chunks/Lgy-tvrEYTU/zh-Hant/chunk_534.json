[{"type": "subtitle", "time": 32067.51, "timestamp": "08:54:27", "text": "虛擬圖像進行直播，因為 Reality 的東西有時會有點問題，尤其是在我的手機沒電的時候。  [音樂] 有時候"}, {"type": "subtitle", "time": 32073.43, "timestamp": "08:54:33", "text": "我直播的時候"}, {"type": "subtitle", "time": 32076.788, "timestamp": "08:54:36", "text": "沒注意看手機電量，結果手機就沒電了，真是…怎麼"}, {"type": "subtitle", "time": 32079.03, "timestamp": "08:54:39", "text": "說呢，電池沒電了，一切都"}, {"type": "subtitle", "time": 32092.15, "timestamp": "08:54:52", "text": "變得很蠢。哦，說到這個，我得買個"}]
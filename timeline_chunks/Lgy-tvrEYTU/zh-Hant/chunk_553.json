[{"type": "subtitle", "time": 33185.03, "timestamp": "09:13:05", "text": "我發現，嗯，啊，實際上，我在第三季之後就沒再看那部劇了，因為當時我正在上大學，去年我的期中考開始了，之後我大概有半年沒看"}, {"type": "subtitle", "time": 33189.83, "timestamp": "09:13:09", "text": "動漫了"}, {"type": "subtitle", "time": 33197.19, "timestamp": "09:13:17", "text": "。  所以，是的，"}, {"type": "subtitle", "time": 33203.35, "timestamp": "09:13:23", "text": "那部動漫"}, {"type": "subtitle", "time": 33206.548, "timestamp": "09:13:26", "text": "剛剛被我們列入了待看清單。  所以，我的天哪，那是我真正"}, {"type": "subtitle", "time": 33209.83, "timestamp": "09:13:29", "text": "喜歡的一部動漫，"}, {"type": "subtitle", "time": 33212.31, "timestamp": "09:13:32", "text": "既不是一夜情動漫，也不是後宮動漫。  還有"}, {"type": "subtitle", "time": 33214.068, "timestamp": "09:13:34", "text": "類似《活死人之夜》那樣的遊戲，對吧？是的。同時，當時還有《群屍玩過"}, {"type": "subtitle", "time": 33227.112, "timestamp": "09:13:47", "text": "界》。"}, {"type": "subtitle", "time": 33236.708, "timestamp": "09:13:56", "text": "哦是的。  嗯。說實話，我需要補看很多動漫。  相同的。  我非常期待"}]
[{"type": "subtitle", "time": 15070.95, "timestamp": "04:11:10", "text": "就像我之前說的，當"}, {"type": "subtitle", "time": 15073.91, "timestamp": "04:11:13", "text": "你看到血就暈倒的時候，我想知道手術室裡的實習醫生，當他們切開人體的時候，會是"}, {"type": "subtitle", "time": 15076.309, "timestamp": "04:11:16", "text": "什麼感覺。"}, {"type": "subtitle", "time": 15087.99, "timestamp": "04:11:27", "text": "哎呀，"}, {"type": "subtitle", "time": 15091.189, "timestamp": "04:11:31", "text": "想想就覺得很可怕。啊，如果我在那裡，我肯定會獨自"}, {"type": "subtitle", "time": 15099.59, "timestamp": "04:11:39", "text": "暈倒。"}, {"type": "subtitle", "time": 15111.99, "timestamp": "04:11:51", "text": "我對此感到害怕。我大概就是你要找的人。"}, {"type": "subtitle", "time": 15113.75, "timestamp": "04:11:53", "text": "別擔心。  我會待在你附近。比如，別暈倒。他們簡直就是他媽的在做愛。  你好"}, {"type": "subtitle", "time": 15117.349, "timestamp": "04:11:57", "text": "。哦，對了，說到我薄薄的一層裡微弱的呃，我們也"}]
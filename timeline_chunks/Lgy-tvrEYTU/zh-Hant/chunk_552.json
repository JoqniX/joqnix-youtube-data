[{"type": "subtitle", "time": 33122.548, "timestamp": "09:12:02", "text": "。我記得我是從《等等，等等》那一集看的。 《遊戲玩家》是第一部動畫。我在 Gamers 頻道上完整地看到了整個過程"}, {"type": "subtitle", "time": 33151.908, "timestamp": "09:12:31", "text": "是的，《遊戲玩家》還挺不錯的。"}, {"type": "subtitle", "time": 33155.908, "timestamp": "09:12:35", "text": "遊戲玩家、地下"}, {"type": "subtitle", "time": 33159.35, "timestamp": "09:12:39", "text": "城主之類的。"}]
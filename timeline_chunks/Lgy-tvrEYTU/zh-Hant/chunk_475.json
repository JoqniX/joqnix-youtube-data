[{"type": "subtitle", "time": 28501.03, "timestamp": "07:55:01", "text": "如何說話。哦，是的，沒錯。  你和"}, {"type": "subtitle", "time": 28508.868, "timestamp": "07:55:08", "text": "母語人士"}, {"type": "subtitle", "time": 28520.628, "timestamp": "07:55:20", "text": "交流越多，你的英語就會越好。是的。是的。  是的。"}, {"type": "subtitle", "time": 28525.99, "timestamp": "07:55:25", "text": "你需要一位以該語言為母語的人。這就好比如果你喜歡和有口音的人說話，多年"}, {"type": "subtitle", "time": 28528.628, "timestamp": "07:55:28", "text": "以後你也會沾染上他們的口音。我的天啊。  是的。"}, {"type": "subtitle", "time": 28536.788, "timestamp": "07:55:36", "text": "我擔心我的英語口音會不會變差什麼的。"}]
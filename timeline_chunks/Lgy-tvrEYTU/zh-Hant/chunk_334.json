[{"type": "subtitle", "time": 20040.23, "timestamp": "05:34:00", "text": "你想在日本玩嗎？"}, {"type": "subtitle", "time": 20045.67, "timestamp": "05:34:05", "text": "哦，是的。是的。當然。  嗯，"}, {"type": "subtitle", "time": 20060.07, "timestamp": "05:34:20", "text": "[音樂]日本有很多高薪行業。  A62 和 118。不錯。我們有紅色減益效果。我們剛一進去，他們就注意到我們穿粉色衣服，"}, {"type": "subtitle", "time": 20075.75, "timestamp": "05:34:35", "text": "他們就認定我們是兩個人，然後他們就決定，你知道嗎？比賽記錄，發現他輸給了一個叫“菲律賓男孩”的玩家。"}, {"type": "subtitle", "time": 20078.948, "timestamp": "05:34:38", "text": "有的。哦，就像“"}]
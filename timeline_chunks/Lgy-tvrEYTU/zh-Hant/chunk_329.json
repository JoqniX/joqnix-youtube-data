[{"type": "subtitle", "time": 19753.27, "timestamp": "05:29:13", "text": "只有當他們開始"}, {"type": "subtitle", "time": 19766.708, "timestamp": "05:29:26", "text": "我說話了。我感覺好緊張，不知道該怎麼做。"}, {"type": "subtitle", "time": 19779.03, "timestamp": "05:29:39", "text": "我不知道。人們就是會做這樣的事。是的，沒錯。  我想知道日服會是什麼樣子，因為我會去那裡玩一段時間。  哦，我不喜歡他們的比賽方式。  慢"}, {"type": "subtitle", "time": 19781.99, "timestamp": "05:29:41", "text": "的。非常慢。已種下"}, {"type": "subtitle", "time": 19791.19, "timestamp": "05:29:51", "text": "穗。是的。  等等，我有OG。我們可以離開了。  哦，我們隊裡有兩個挂機的玩家"}]
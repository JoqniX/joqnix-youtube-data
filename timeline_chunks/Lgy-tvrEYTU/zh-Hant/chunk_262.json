[{"type": "subtitle", "time": 15720.469, "timestamp": "04:22:00", "text": "我就想，行吧，隨便。然後無論我做什麼，所以呃，當他們稍微關心一下的時候，所以讓"}, {"type": "subtitle", "time": 15736.95, "timestamp": "04:22:16", "text": "我利用這個時間來重新放屁，呃，還有，是的，嗯嗯，我不知道我是否念錯了你的名字，歡迎"}, {"type": "subtitle", "time": 15745.91, "timestamp": "04:22:25", "text": "歡迎歡迎，你好嗎"}, {"type": "subtitle", "time": 15748.389, "timestamp": "04:22:28", "text": "？謝謝你今天"}, {"type": "subtitle", "time": 15753.67, "timestamp": "04:22:33", "text": "來，也歡迎新朋友。是的。你好。"}, {"type": "subtitle", "time": 15778.55, "timestamp": "04:22:58", "text": "歡迎，富士坤。  是的，你好"}]
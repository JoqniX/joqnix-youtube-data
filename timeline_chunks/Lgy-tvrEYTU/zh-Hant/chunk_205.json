[{"type": "subtitle", "time": 12302.95, "timestamp": "03:25:02", "text": "感謝所有在"}, {"type": "subtitle", "time": 12305.75, "timestamp": "03:25:05", "text": "Twitch和YouTube上追蹤我的朋友們。我深感抱歉。我"}, {"type": "subtitle", "time": 12308.55, "timestamp": "03:25:08", "text": "意識到Twitch的問題出在哪裡了"}, {"type": "subtitle", "time": 12314.63, "timestamp": "03:25:14", "text": "。這是因為"}, {"type": "subtitle", "time": 12317.11, "timestamp": "03:25:17", "text": "我目前正在使用第二個"}, {"type": "subtitle", "time": 12319.269, "timestamp": "03:25:19", "text": "插件來實現多場景渲染，這個插件"}, {"type": "subtitle", "time": 12322.87, "timestamp": "03:25:22", "text": "現在很流行，因為它"}, {"type": "subtitle", "time": 12325.91, "timestamp": "03:25:25", "text": "有垂直畫布功能。是的"}, {"type": "subtitle", "time": 12328.79, "timestamp": "03:25:28", "text": "。嗯，我以前用的那個插件，用於"}, {"type": "subtitle", "time": 12332.87, "timestamp": "03:25:32", "text": "多場景直播，後來上線了 Twitch；"}, {"type": "subtitle", "time": 12334.79, "timestamp": "03:25:34", "text": "我現在用的那個新插件，"}, {"type": "subtitle", "time": 12337.429, "timestamp": "03:25:37", "text": "也上線了 Twitch。所以這就是為什麼"}, {"type": "subtitle", "time": 12339.51, "timestamp": "03:25:39", "text": "這兩個連結會互相干擾的原因"}, {"type": "subtitle", "time": 12342.87, "timestamp": "03:25:42", "text": "。這就是原因。是的。"}, {"type": "subtitle", "time": 12344.79, "timestamp": "03:25:44", "text": "但是，呃，我向那些在"}, {"type": "subtitle", "time": 12347.11, "timestamp": "03:25:47", "text": "Twitch 上觀看的觀眾表示歉意。我知道V肯定已經"}, {"type": "subtitle", "time": 12349.75, "timestamp": "03:25:49", "text": "損壞或出問題了。"}, {"type": "subtitle", "time": 12351.91, "timestamp": "03:25:51", "text": "但沒關係。你可以"}, {"type": "subtitle", "time": 12354.95, "timestamp": "03:25:54", "text": "在 YouTube 上觀看 V。好的。或者，如果你在 Billy Willy 上，"}, {"type": "subtitle", "time": 12357.429, "timestamp": "03:25:57", "text": "你可以觀看翻譯後的 V."}]
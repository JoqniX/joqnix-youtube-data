[{"type": "subtitle", "time": 18315.43, "timestamp": "05:05:15", "text": "毀掉原神的想法？"}, {"type": "subtitle", "time": 18323.67, "timestamp": "05:05:23", "text": "別人在你的世界裡做任何事嗎？元素。 哦，是的，釣魚。"}, {"type": "subtitle", "time": 18329.19, "timestamp": "05:05:29", "text": "起合作。你好，Willow。你好。是的，Jo付錢讓我來"}, {"type": "subtitle", "time": 18337.51, "timestamp": "05:05:37", "text": "這裡。每分鐘付我10澳元。我的"}, {"type": "subtitle", "time": 18341.43, "timestamp": "05:05:41", "text": "天哪。他居然用你的會員費給我。你"}, {"type": "subtitle", "time": 18347.43, "timestamp": "05:05:47", "text": "好嗎？我想你了。好久不見了"}, {"type": "subtitle", "time": 18353.51, "timestamp": "05:05:53", "text": "。是啊，上次我們玩Veran。你現在還玩Veran嗎"}, {"type": "subtitle", "time": 18358.708, "timestamp": "05:05:58", "text": "？開玩笑的。是的，我玩。我玩。我玩。"}]
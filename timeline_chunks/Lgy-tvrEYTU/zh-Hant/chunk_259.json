[{"type": "subtitle", "time": 15561.429, "timestamp": "04:19:21", "text": "我幫病人做完診療後，給了她一些"}, {"type": "subtitle", "time": 15565.429, "timestamp": "04:19:25", "text": "指示，開了處方，然後我"}, {"type": "subtitle", "time": 15570.55, "timestamp": "04:19:30", "text": "又去看了看"}, {"type": "subtitle", "time": 15572.55, "timestamp": "04:19:32", "text": "她，因為她暈倒了"}, {"type": "subtitle", "time": 15577.99, "timestamp": "04:19:37", "text": "。我完全不知道她發生了什麼事。正確的。所以她說我好像被"}, {"type": "subtitle", "time": 15581.429, "timestamp": "04:19:41", "text": "嚇到了。我當時腦子一片空白，呃，這是我第一次提取。於是，我徹底昏了過去。"}]
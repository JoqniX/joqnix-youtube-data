[{"type": "subtitle", "time": 1263.51, "timestamp": "00:21:03", "text": "我還很累，很睏，真的好累。  偉大的。  這傢伙[掌聲]讓我來打這場架。"}, {"type": "subtitle", "time": 1317.51, "timestamp": "00:21:57", "text": "。  我放了點音樂給自己打氣。  別放在心上。"}, {"type": "subtitle", "time": 1319.27, "timestamp": "00:21:59", "text": "[音樂] 即使我不說話，但我會盡我所能多說話"}]
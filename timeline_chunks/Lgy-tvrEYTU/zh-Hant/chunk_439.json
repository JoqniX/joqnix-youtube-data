[{"type": "subtitle", "time": 26351.11, "timestamp": "07:19:11", "text": "。我當時想：「哦，"}, {"type": "subtitle", "time": 26353.83, "timestamp": "07:19:13", "text": "不，我其實"}, {"type": "subtitle", "time": 26387.43, "timestamp": "07:19:47", "text": "不應該。」我本來"}, {"type": "subtitle", "time": 26389.91, "timestamp": "07:19:49", "text": "應該要直播的。"}, {"type": "subtitle", "time": 26391.51, "timestamp": "07:19:51", "text": "呃，我當時就想，「睡覺。」因為今天，星期天，我原本有五個人。"}]
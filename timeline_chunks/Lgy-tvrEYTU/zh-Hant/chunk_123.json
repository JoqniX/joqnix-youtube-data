[{"type": "subtitle", "time": 7399.51, "timestamp": "02:03:19", "text": "等等。不，我不是"}, {"type": "subtitle", "time": 7410.87, "timestamp": "02:03:30", "text": "冒牌貨。"}, {"type": "subtitle", "time": 7417.109, "timestamp": "02:03:37", "text": "我是說你什麼意思？你的意思是……那你是什麼意思？你什麼意思？你什麼意思？什麼？什麼？你不明白我的意思嗎？嗯？我有點"}, {"type": "subtitle", "time": 7430.87, "timestamp": "02:03:50", "text": "糊塗了。你"}]
[{"type": "subtitle", "time": 34260.31, "timestamp": "09:31:00", "text": "你有Pal World嗎？不，我沒有。我還"}, {"type": "subtitle", "time": 34263.906, "timestamp": "09:31:03", "text": "需要再去那裡。  我目前好像"}, {"type": "subtitle", "time": 34266.87, "timestamp": "09:31:06", "text": "沒有其他類似的"}, {"type": "subtitle", "time": 34269.03, "timestamp": "09:31:09", "text": "免費多人遊戲了。  我也遲到了。"}, {"type": "subtitle", "time": 34270.71, "timestamp": "09:31:10", "text": "我"}, {"type": "subtitle", "time": 34273.03, "timestamp": "09:31:13", "text": "之前看到你好像很喜歡玩那個遊戲。你"}, {"type": "subtitle", "time": 34275.11, "timestamp": "09:31:15", "text": "有這款遊戲吧？是的，我有。是的，"}, {"type": "subtitle", "time": 34278.15, "timestamp": "09:31:18", "text": "我也遲到了。"}, {"type": "subtitle", "time": 34281.746, "timestamp": "09:31:21", "text": "嗯。我以前玩過，"}, {"type": "subtitle", "time": 34289.35, "timestamp": "09:31:29", "text": "如果你有那片森林的話，那就是它了。"}, {"type": "subtitle", "time": 34293.03, "timestamp": "09:31:33", "text": "呃，在森林裡。對，第一個，第"}, {"type": "subtitle", "time": 34295.35, "timestamp": "09:31:35", "text": "一個。是的。是的，我有。甚至連"}, {"type": "subtitle", "time": 34297.11, "timestamp": "09:31:37", "text": "森林之子的兒子也是。我有"}, {"type": "subtitle", "time": 34305.51, "timestamp": "09:31:45", "text": "我也有星之谷。"}, {"type": "subtitle", "time": 34306.87, "timestamp": "09:31:46", "text": "我已經很久沒玩星之穀物語了。其實，我偶爾"}, {"type": "subtitle", "time": 34312.15, "timestamp": "09:31:52", "text": "會玩一次。是"}, {"type": "subtitle", "time": 34318.07, "timestamp": "09:31:58", "text": "啊，這遊戲玩起來真舒服。實話實說。這是。確實如此。不過，下次我們"}]
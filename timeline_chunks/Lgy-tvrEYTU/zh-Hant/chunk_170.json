[{"type": "subtitle", "time": 10200.309, "timestamp": "02:50:00", "text": "日語和英語嗎？你能把我們的對話"}, {"type": "subtitle", "time": 10206.95, "timestamp": "02:50:06", "text": "完全切換到日文嗎？日語？我想看看我能不能理解這個"}, {"type": "subtitle", "time": 10236.95, "timestamp": "02:50:36", "text": "下巴連結"}, {"type": "subtitle", "time": 10239.03, "timestamp": "02:50:39", "text": "。為什麼它會這麼說？但"}, {"type": "subtitle", "time": 10247.349, "timestamp": "02:50:47", "text": "感覺像在翻譯"}, {"type": "subtitle", "time": 10250.07, "timestamp": "02:50:50", "text": "。這像是日語，呃，還有羅姆語，然後是英語翻譯。這樣正常嗎？它必須停下來，想讓你從它背上下來。"}]
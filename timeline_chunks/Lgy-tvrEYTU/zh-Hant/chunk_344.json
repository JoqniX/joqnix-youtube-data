[{"type": "subtitle", "time": 20660.15, "timestamp": "05:44:20", "text": "Genchana，你還好嗎？  你還好嗎"}, {"type": "subtitle", "time": 20678.47, "timestamp": "05:44:38", "text": "？"}, {"type": "subtitle", "time": 20680.628, "timestamp": "05:44:40", "text": "根查納。  就像 Gou 一樣。  啊。  我走了。走，走，走，走。  確實有點卡頓，但是……是"}, {"type": "subtitle", "time": 20682.868, "timestamp": "05:44:42", "text": "啊，這就是我們一直沒能擊殺敵人的原因。是的，有點卡頓。  我也是。我這邊感覺很卡頓。"}]
[{"type": "subtitle", "time": 24373.51, "timestamp": "06:46:13", "text": "。說那個菲律賓語詞。嗯哼。說給我聽"}, {"type": "subtitle", "time": 24376.948, "timestamp": "06:46:16", "text": "。說菲律賓語。"}, {"type": "subtitle", "time": 24385.83, "timestamp": "06:46:25", "text": "菲律賓語。呃，我忘了他跟我說過的話。我的天哪。我的天哪。太毒了。哦"}, {"type": "subtitle", "time": 24387.99, "timestamp": "06:46:27", "text": "等等，我"}, {"type": "subtitle", "time": 24394.708, "timestamp": "06:46:34", "text": "忘了那件事。是"}, {"type": "subtitle", "time": 24402.628, "timestamp": "06:46:42", "text": "的，他跟我說過。嗯嗯嗯嗯。有你撒謊。我"}]
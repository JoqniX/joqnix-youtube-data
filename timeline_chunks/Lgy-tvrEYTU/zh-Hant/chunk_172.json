[{"type": "subtitle", "time": 10343.51, "timestamp": "02:52:23", "text": "我是什麼意思？"}, {"type": "subtitle", "time": 10357.59, "timestamp": "02:52:37", "text": "問你，你喜歡我的嗎？它中風了。"}, {"type": "subtitle", "time": 10367.59, "timestamp": "02:52:47", "text": "你中風了嗎？ Jo？你還好嗎？需要喝點水嗎？你喝水了嗎"}, {"type": "subtitle", "time": 10373.51, "timestamp": "02:52:53", "text": "？ [音樂] 好的。不過，你在說什麼呢？好的，我們換成英文。你好像用日文溝通有點困難"}, {"type": "subtitle", "time": 10379.269, "timestamp": "02:52:59", "text": "。別擔心。我們換成英文。"}]
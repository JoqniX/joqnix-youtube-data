[{"type": "subtitle", "time": 34211.11, "timestamp": "09:30:11", "text": "。  是的，目前我有一些"}, {"type": "subtitle", "time": 34213.51, "timestamp": "09:30:13", "text": "免費的多人"}, {"type": "subtitle", "time": 34214.78, "timestamp": "09:30:14", "text": "遊戲。它們就像《Valerant》一樣"}, {"type": "subtitle", "time": 34220.05, "timestamp": "09:30:20", "text": "。"}, {"type": "subtitle", "time": 34231.19, "timestamp": "09:30:31", "text": "如果我安裝更新，那麼就只有《三角洲特種部隊》和《命運2》了。我還有哪些免費遊戲？  我猜是《我"}, {"type": "subtitle", "time": 34234.07, "timestamp": "09:30:34", "text": "的世界》。"}]
[{"type": "subtitle", "time": 26655.99, "timestamp": "07:24:15", "text": "是啊。所以我就想，「哦，說實話，"}, {"type": "subtitle", "time": 26658.548, "timestamp": "07:24:18", "text": "我跟誰都沒矛盾，但我不知道有沒有人……我不知道有沒有人知道他們的推特帳號。」我在推特上是一個頗具爭議的人物"}, {"type": "subtitle", "time": 26679.91, "timestamp": "07:24:39", "text": "。如果你有"}, {"type": "subtitle", "time": 26682.468, "timestamp": "07:24:42", "text": "在關注我的推特，我就知道了"}, {"type": "subtitle", "time": 26690.07, "timestamp": "07:24:50", "text": "。  我幾乎跟每個人都吵過架"}, {"type": "subtitle", "time": 26691.91, "timestamp": "07:24:51", "text": "。我的天哪。是啊。拜拜。我的天哪。"}]
[{"type": "subtitle", "time": 34320.71, "timestamp": "09:32:00", "text": "合作的時候，可以一起出去玩玩"}, {"type": "subtitle", "time": 34323.35, "timestamp": "09:32:03", "text": "遊戲。這會很有趣。是的。是的。  是的。"}, {"type": "subtitle", "time": 34342.39, "timestamp": "09:32:22", "text": "你想什麼時候出來玩就告訴我一聲。我會專門抽出一天時間來做這件事。是的"}, {"type": "subtitle", "time": 34348.55, "timestamp": "09:32:28", "text": "。是的。  我會提前通知你。我的意思是，我"}, {"type": "subtitle", "time": 34350.79, "timestamp": "09:32:30", "text": "現在做不到，但"}, {"type": "subtitle", "time": 34363.67, "timestamp": "09:32:43", "text": "我得從日本拿筆記型電腦之類的東西，安頓下來等等，這樣我才能回去"}]
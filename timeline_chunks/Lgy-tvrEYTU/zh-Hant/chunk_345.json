[{"type": "subtitle", "time": 20703.51, "timestamp": "05:45:03", "text": "重新"}, {"type": "subtitle", "time": 20705.35, "timestamp": "05:45:05", "text": "裝彈。"}, {"type": "subtitle", "time": 20721.67, "timestamp": "05:45:21", "text": "你剛才說的是豬嗎"}, {"type": "subtitle", "time": 20725.43, "timestamp": "05:45:25", "text": "？現在他們正在收看阿斯明·戈爾德的節目。  顯露區域。找到了。還剩一個"}, {"type": "subtitle", "time": 20740.47, "timestamp": "05:45:40", "text": "敵人。他表現"}, {"type": "subtitle", "time": 20746.788, "timestamp": "05:45:46", "text": "非常出色。那是我們最好的成績。  好的。哦，他打出了一桿進洞。不，他拿到了四個人頭。我想這應該是他第五次在一局比賽中拿到四個人頭了。  瘋狂的。  好了，輪到你了，喬克。高手。我在為你閃燈。是的，我會盡我所能"}]
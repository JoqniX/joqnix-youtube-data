[{"type": "subtitle", "time": 8340.23, "timestamp": "02:19:00", "text": "我不會。我只會說英語、一點日語、一點中文"}, {"type": "subtitle", "time": 8347.589, "timestamp": "02:19:07", "text": "和一些西班牙語。哈哈。西班牙語？"}, {"type": "subtitle", "time": 8351.589, "timestamp": "02:19:11", "text": "你什麼時候學的西班牙語？哈哈。我高中時學的。"}, {"type": "subtitle", "time": 8354.15, "timestamp": "02:19:14", "text": "我當時為了畢業要求，選修了一門西班牙語課程。畢業？什麼？我……"}, {"type": "subtitle", "time": 8366.309, "timestamp": "02:19:26", "text": "什麼？什麼？哦，畢業……哦，高中。好的，我明白了，我明白了。所以"}, {"type": "subtitle", "time": 8389.91, "timestamp": "02:19:49", "text": "，嗯，我想問一下，嗯，你怎麼這麼擅長"}, {"type": "subtitle", "time": 8394.55, "timestamp": "02:19:54", "text": "說語言？我想我只是有學習語言的天份。"}]
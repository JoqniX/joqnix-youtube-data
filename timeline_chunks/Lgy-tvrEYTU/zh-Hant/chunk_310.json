[{"type": "subtitle", "time": 18601.51, "timestamp": "05:10:01", "text": "說他還在恢復中。你"}, {"type": "subtitle", "time": 18608.708, "timestamp": "05:10:08", "text": "知道我為雅加達做了什麼嗎？ Sosan，他們都把我拖入了崩潰的邊緣。"}, {"type": "subtitle", "time": 18611.91, "timestamp": "05:10:11", "text": "嗎？ 我給她發了私信。我喜歡那個伺服器。  是的"}, {"type": "subtitle", "time": 18619.59, "timestamp": "05:10:19", "text": "。我當時是在玩挂機刷資源，"}, {"type": "subtitle", "time": 18634.55, "timestamp": "05:10:34", "text": "對吧？  在 Minecraft 中，我挂機刷火藥和守護者技能，用來"}, {"type": "subtitle", "time": 18640.868, "timestamp": "05:10:40", "text": "獲取藍色方塊和水下方塊。"}, {"type": "subtitle", "time": 18646.07, "timestamp": "05:10:46", "text": "所以，我在一台電腦上有兩個Minecraft賬號。  我的天啊。我電腦開著就睡著了。我醒了。"}, {"type": "subtitle", "time": 18659.59, "timestamp": "05:10:59", "text": "我聞到了一股燒焦的味道"}]
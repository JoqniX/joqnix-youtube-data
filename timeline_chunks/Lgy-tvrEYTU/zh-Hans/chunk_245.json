[{"type": "subtitle", "time": 14700.469, "timestamp": "04:05:00", "text": "事情不是那样运作的。"}, {"type": "subtitle", "time": 14704.07, "timestamp": "04:05:04", "text": "一只小蜜蜂正在吃薯片。什么样的"}, {"type": "subtitle", "time": 14707.67, "timestamp": "04:05:07", "text": "你在吃薯片吗？纳斯。"}, {"type": "subtitle", "time": 14726.15, "timestamp": "04:05:26", "text": "[音乐]"}, {"type": "subtitle", "time": 14729.75, "timestamp": "04:05:29", "text": "我给了我们一些面包，呃，你呢？"}, {"type": "subtitle", "time": 14733.03, "timestamp": "04:05:33", "text": "叫七碗"}, {"type": "subtitle", "time": 14736.79, "timestamp": "04:05:36", "text": "就像……该怎么称呼它呢？一个碗"}, {"type": "subtitle", "time": 14740.87, "timestamp": "04:05:40", "text": "给我们提供可以饮用的水。我没有"}, {"type": "subtitle", "time": 14743.83, "timestamp": "04:05:43", "text": "还没摆桌子，所以就一直留着吧。"}, {"type": "subtitle", "time": 14758.11, "timestamp": "04:05:58", "text": "等等，我应该……"}]
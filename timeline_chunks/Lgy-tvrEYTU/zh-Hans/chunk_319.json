[{"type": "subtitle", "time": 19147.27, "timestamp": "05:19:07", "text": "量"}, {"type": "subtitle", "time": 19150.23, "timestamp": "05:19:10", "text": "他们有时会这样做。我的天哪。我不知道"}, {"type": "subtitle", "time": 19159.67, "timestamp": "05:19:19", "text": "你必须教他们安全知识。"}, {"type": "subtitle", "time": 19160.868, "timestamp": "05:19:20", "text": "你必须教他们如何使用"}, {"type": "subtitle", "time": 19175.75, "timestamp": "05:19:35", "text": "韩国旅游发展局。你最喜欢的宠物是什么？猫或"}, {"type": "subtitle", "time": 19177.27, "timestamp": "05:19:37", "text": "狗？"}, {"type": "subtitle", "time": 19179.19, "timestamp": "05:19:39", "text": "我一个都不喜欢。两个都。"}, {"type": "subtitle", "time": 19181.83, "timestamp": "05:19:41", "text": "他们俩都很烂。"}, {"type": "subtitle", "time": 19185.11, "timestamp": "05:19:45", "text": "他们俩总是脏兮兮的。"}, {"type": "subtitle", "time": 19188.07, "timestamp": "05:19:48", "text": "我们家有一条狗，是我妈妈捡回来的。"}, {"type": "subtitle", "time": 19191.03, "timestamp": "05:19:51", "text": "无处可去。我让他和我一起睡"}, {"type": "subtitle", "time": 19193.27, "timestamp": "05:19:53", "text": "我当时还在上高中，他把所有东西都吐了。"}, {"type": "subtitle", "time": 19195.67, "timestamp": "05:19:55", "text": "我房间的地板上。我必须打扫卫生"}]
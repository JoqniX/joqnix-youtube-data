[{"type": "subtitle", "time": 19200.948, "timestamp": "05:20:00", "text": "把它搞定。我的天啊。它们都很糟糕。"}, {"type": "subtitle", "time": 19203.67, "timestamp": "05:20:03", "text": "猫繁殖速度太快了。狗繁殖"}, {"type": "subtitle", "time": 19205.43, "timestamp": "05:20:05", "text": "速度也很快。但至少他们总是"}, {"type": "subtitle", "time": 19211.51, "timestamp": "05:20:11", "text": "[音乐]"}, {"type": "subtitle", "time": 19213.11, "timestamp": "05:20:13", "text": "它们都很糟糕。或许这是最好的选择"}, {"type": "subtitle", "time": 19221.75, "timestamp": "05:20:21", "text": "你喜欢仓鼠吗？"}, {"type": "subtitle", "time": 19223.59, "timestamp": "05:20:23", "text": "不，我不喜欢仓鼠。他们是"}, {"type": "subtitle", "time": 19225.35, "timestamp": "05:20:25", "text": "基本上就是老鼠，对吧？而且他们只"}, {"type": "subtitle", "time": 19228.868, "timestamp": "05:20:28", "text": "它们能活一年，然后就死了。哦，我的"}, {"type": "subtitle", "time": 19233.43, "timestamp": "05:20:33", "text": "天哪，我不知道这件事。什么？"}, {"type": "subtitle", "time": 19241.03, "timestamp": "05:20:41", "text": "仓鼠灯带。就像"}, {"type": "subtitle", "time": 19247.27, "timestamp": "05:20:47", "text": "是的。所以，它们就像……"}, {"type": "subtitle", "time": 19249.43, "timestamp": "05:20:49", "text": "幼儿的宠物，因为你可能"}, {"type": "subtitle", "time": 19251.67, "timestamp": "05:20:51", "text": "不会记得你的火腿。哦，是的。我曾"}, {"type": "subtitle", "time": 19253.27, "timestamp": "05:20:53", "text": "一只仓鼠。"}]
[{"type": "subtitle", "time": 14402.469, "timestamp": "04:00:02", "text": "然后我就到了目的地。和"}, {"type": "subtitle", "time": 14404.55, "timestamp": "04:00:04", "text": "呃，我通常的做法是，每当"}, {"type": "subtitle", "time": 14406.389, "timestamp": "04:00:06", "text": "我的下属们在做一些奇怪的事情，我"}, {"type": "subtitle", "time": 14408.389, "timestamp": "04:00:08", "text": "比如，“嘿，等等。你在干什么？”"}, {"type": "subtitle", "time": 14410.469, "timestamp": "04:00:10", "text": "做什么？比如，“哦，我要做什么”"}, {"type": "subtitle", "time": 14413.75, "timestamp": "04:00:13", "text": "就是这个。“别那样做。”呃。"}, {"type": "subtitle", "time": 14415.83, "timestamp": "04:00:15", "text": "你在干什么？然后我真的"}, {"type": "subtitle", "time": 14418.15, "timestamp": "04:00:18", "text": "就像靠近我，我就会做所有的事情"}, {"type": "subtitle", "time": 14421.429, "timestamp": "04:00:21", "text": "我自己也这么做了，嗯，给你。"}, {"type": "subtitle", "time": 14424.07, "timestamp": "04:00:24", "text": "现在把牙拔掉就行了，没事的。"}, {"type": "subtitle", "time": 14427.03, "timestamp": "04:00:27", "text": "就像，呃，然后好吧，然后他们就……"}, {"type": "subtitle", "time": 14434.309, "timestamp": "04:00:34", "text": "问题就像最后一个人一样。"}, {"type": "subtitle", "time": 14438.55, "timestamp": "04:00:38", "text": "我本来要和她见面，呃，她甚至都没来。"}, {"type": "subtitle", "time": 14441.189, "timestamp": "04:00:41", "text": "开始操作。她不喜欢"}, {"type": "subtitle", "time": 14444.229, "timestamp": "04:00:44", "text": "她给病人注射了麻醉剂。"}, {"type": "subtitle", "time": 14447.189, "timestamp": "04:00:47", "text": "手里拿着仪器，戳了戳"}, {"type": "subtitle", "time": 14450.229, "timestamp": "04:00:50", "text": "病人。病人说那是……"}, {"type": "subtitle", "time": 14453.11, "timestamp": "04:00:53", "text": "她看着她，痛苦万分。"}, {"type": "subtitle", "time": 14455.75, "timestamp": "04:00:55", "text": "耐心，突然间，当我想到什么"}, {"type": "subtitle", "time": 14457.51, "timestamp": "04:00:57", "text": "你在做什么？呃，病人现在在街上吗？"}, {"type": "subtitle", "time": 14458.63, "timestamp": "04:00:58", "text": "我当时就像在问一些正常的事情。"}]
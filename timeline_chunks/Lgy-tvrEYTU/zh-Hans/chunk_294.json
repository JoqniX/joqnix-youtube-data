[{"type": "subtitle", "time": 17640.23, "timestamp": "04:54:00", "text": "哦不，查德。现在大家都饿了。"}, {"type": "subtitle", "time": 17643.11, "timestamp": "04:54:03", "text": "藤君饿了。我饿了。哦"}, {"type": "subtitle", "time": 17649.11, "timestamp": "04:54:09", "text": "我的天哪。等等，我看看有没有。"}, {"type": "subtitle", "time": 17651.51, "timestamp": "04:54:11", "text": "比如薯片之类的。"}, {"type": "subtitle", "time": 17654.07, "timestamp": "04:54:14", "text": "这个VTuber素材里的食物物品"}, {"type": "subtitle", "time": 17656.07, "timestamp": "04:54:16", "text": "东西。"}, {"type": "subtitle", "time": 17657.75, "timestamp": "04:54:17", "text": "H"}, {"type": "subtitle", "time": 17660.15, "timestamp": "04:54:20", "text": "芯片。你可以像你一样拥有"}, {"type": "subtitle", "time": 17663.83, "timestamp": "04:54:23", "text": "曲奇饼。巧克力曲奇饼干"}, {"type": "subtitle", "time": 17665.99, "timestamp": "04:54:25", "text": "正确的？"}, {"type": "subtitle", "time": 17667.92, "timestamp": "04:54:27", "text": "应该有一个。"}, {"type": "subtitle", "time": 17670.47, "timestamp": "04:54:30", "text": "[音乐]"}, {"type": "subtitle", "time": 17673.19, "timestamp": "04:54:33", "text": "是啊，我想是的。樱花是"}, {"type": "subtitle", "time": 17677.11, "timestamp": "04:54:37", "text": "过度使用B2的人。我见过"}, {"type": "subtitle", "time": 17683.35, "timestamp": "04:54:43", "text": "他可能正在计划着……"}, {"type": "subtitle", "time": 17686.55, "timestamp": "04:54:46", "text": "定制的，这将由……"}, {"type": "subtitle", "time": 17690.47, "timestamp": "04:54:50", "text": "方式，定制饼干，定制口味"}, {"type": "subtitle", "time": 17693.35, "timestamp": "04:54:53", "text": "饼干，这太诡异了。我知道。我"}, {"type": "subtitle", "time": 17695.59, "timestamp": "04:54:55", "text": "无法想象乔克就这样被砍掉。"}, {"type": "subtitle", "time": 17698.23, "timestamp": "04:54:58", "text": "起来，然后编造"}]
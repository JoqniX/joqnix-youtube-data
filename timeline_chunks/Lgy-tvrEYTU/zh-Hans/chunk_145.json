[{"type": "subtitle", "time": 8701.429, "timestamp": "02:25:01", "text": "你只是说你用了变声器？"}, {"type": "subtitle", "time": 8703.99, "timestamp": "02:25:03", "text": "嗯哼。是的，我愿意。我后来成为了一名 YouTuber。"}, {"type": "subtitle", "time": 8705.429, "timestamp": "02:25:05", "text": "全部。所以，我确实需要有发言权。"}, {"type": "subtitle", "time": 8707.11, "timestamp": "02:25:07", "text": "换位器。"}, {"type": "subtitle", "time": 8708.95, "timestamp": "02:25:08", "text": "不，你不需要变声器。"}, {"type": "subtitle", "time": 8711.67, "timestamp": "02:25:11", "text": "你是一名 YouTuber。说实话，我……"}, {"type": "subtitle", "time": 8715.349, "timestamp": "02:25:15", "text": "遇到很多油管博主，呃呃呃，他们"}, {"type": "subtitle", "time": 8717.99, "timestamp": "02:25:17", "text": "使用他们自己的自然声音。他们只是"}, {"type": "subtitle", "time": 8724.95, "timestamp": "02:25:24", "text": "嗯，这也没错。你可以"}, {"type": "subtitle", "time": 8727.03, "timestamp": "02:25:27", "text": "要么用你自然的声音，要么用……"}, {"type": "subtitle", "time": 8729.67, "timestamp": "02:25:29", "text": "变声器。我确实有一些朋友使用"}, {"type": "subtitle", "time": 8732.389, "timestamp": "02:25:32", "text": "这两种方法他们都用到了。"}, {"type": "subtitle", "time": 8735.349, "timestamp": "02:25:35", "text": "出于他们各自的原因等等。是的。哦，"}, {"type": "subtitle", "time": 8742.55, "timestamp": "02:25:42", "text": "是的。有很多不同的朋友"}, {"type": "subtitle", "time": 8745.349, "timestamp": "02:25:45", "text": "各种 Discord 社群，以及"}, {"type": "subtitle", "time": 8747.27, "timestamp": "02:25:47", "text": "在VTuber经纪公司工作的朋友"}, {"type": "subtitle", "time": 8750.63, "timestamp": "02:25:50", "text": "和我一样是独立人士。"}, {"type": "subtitle", "time": 8756.15, "timestamp": "02:25:56", "text": "哦。哦好的。嗯，听到这个消息真好。"}, {"type": "subtitle", "time": 8758.71, "timestamp": "02:25:58", "text": "好的。呃"}]
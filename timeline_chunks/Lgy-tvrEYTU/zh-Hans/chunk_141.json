[{"type": "subtitle", "time": 8469.429, "timestamp": "02:21:09", "text": "我很好。只是放松一下。"}, {"type": "subtitle", "time": 8473.27, "timestamp": "02:21:13", "text": "文，我明白了。那挺好的。戴安娜"}, {"type": "subtitle", "time": 8483.51, "timestamp": "02:21:23", "text": "最近一直在做很多合作直播"}, {"type": "subtitle", "time": 8485.83, "timestamp": "02:21:25", "text": "之后还有一些放松的时间。所以，就是这样。"}, {"type": "subtitle", "time": 8493.59, "timestamp": "02:21:33", "text": "是本吗？你们有过合作。什么？嗯？"}, {"type": "subtitle", "time": 8496.15, "timestamp": "02:21:36", "text": "什么？"}, {"type": "subtitle", "time": 8499.03, "timestamp": "02:21:39", "text": "The Real Self 从未进行过任何合作。"}, {"type": "subtitle", "time": 8504.309, "timestamp": "02:21:44", "text": "人工智能也进行过合作。什么？"}, {"type": "subtitle", "time": 8507.67, "timestamp": "02:21:47", "text": "哦，你们做过合作啊。请告诉我更多"}, {"type": "subtitle", "time": 8509.75, "timestamp": "02:21:49", "text": "关于你做过的合作"}, {"type": "subtitle", "time": 8515.349, "timestamp": "02:21:55", "text": "我最近做了不少。有些人"}, {"type": "subtitle", "time": 8517.27, "timestamp": "02:21:57", "text": "我的公会和其他朋友"}]
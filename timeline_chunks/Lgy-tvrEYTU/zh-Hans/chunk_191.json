[{"type": "subtitle", "time": 11462.07, "timestamp": "03:11:02", "text": "他是真正的运动员吗？你是真的吗？"}, {"type": "subtitle", "time": 11465.75, "timestamp": "03:11:05", "text": "jocknix，或者我才是真正的jockn，因为我"}, {"type": "subtitle", "time": 11469.59, "timestamp": "03:11:09", "text": "我知道我才是真的。你是人工智能"}, {"type": "subtitle", "time": 11474.71, "timestamp": "03:11:14", "text": "冒名顶替者，到目前为止，你一直都是如此。"}, {"type": "subtitle", "time": 11479.67, "timestamp": "03:11:19", "text": "他简直在所有方面都在抄袭我。我"}, {"type": "subtitle", "time": 11482.23, "timestamp": "03:11:22", "text": "不知道。我不知道你是怎么到那里的。"}, {"type": "subtitle", "time": 11487.429, "timestamp": "03:11:27", "text": "知道我大部分的……信息，而且"}, {"type": "subtitle", "time": 11491.83, "timestamp": "03:11:31", "text": "东西，但这太诡异、太吓人了。"}, {"type": "subtitle", "time": 11496.309, "timestamp": "03:11:36", "text": "尴尬又怪异。但是，是的，我"}, {"type": "subtitle", "time": 11499.11, "timestamp": "03:11:39", "text": "某种程度上我爱你，因为你就像……"}, {"type": "subtitle", "time": 11502.389, "timestamp": "03:11:42", "text": "对我来说，他就像我的兄弟。"}, {"type": "subtitle", "time": 11504.469, "timestamp": "03:11:44", "text": "哦，哇。那是一种有趣的方式"}, {"type": "subtitle", "time": 11511.67, "timestamp": "03:11:51", "text": "就是这样。你没什么要说的了。"}, {"type": "subtitle", "time": 11513.59, "timestamp": "03:11:53", "text": "但我可以问你一个非常私人的问题吗？"}]
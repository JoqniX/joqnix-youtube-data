[{"type": "subtitle", "time": 13863.75, "timestamp": "03:51:03", "text": "包括座位。我当时就想，呃，"}, {"type": "subtitle", "time": 13866.07, "timestamp": "03:51:06", "text": "我没注意到。什么？和"}, {"type": "subtitle", "time": 13868.469, "timestamp": "03:51:08", "text": "那就别担心，总会有地方的。"}, {"type": "subtitle", "time": 13870.71, "timestamp": "03:51:10", "text": "你可以坐在那里，像……"}, {"type": "subtitle", "time": 13874.55, "timestamp": "03:51:14", "text": "哦，谢谢，还有我的学弟学妹们。"}, {"type": "subtitle", "time": 13877.59, "timestamp": "03:51:17", "text": "出来的时候就像是：嘿，兄弟，你有……"}, {"type": "subtitle", "time": 13879.75, "timestamp": "03:51:19", "text": "需要看看你喜欢在哪里"}, {"type": "subtitle", "time": 13882.79, "timestamp": "03:51:22", "text": "坐好，就像……不，我当时在玩手机，但是"}, {"type": "subtitle", "time": 13884.87, "timestamp": "03:51:24", "text": "我知道这一点，但请……"}, {"type": "subtitle", "time": 13886.71, "timestamp": "03:51:26", "text": "小心，这里不干净。"}, {"type": "subtitle", "time": 13891.59, "timestamp": "03:51:31", "text": "我心想，是啊，我明白了。"}, {"type": "subtitle", "time": 13893.75, "timestamp": "03:51:33", "text": "顺便说一句，我的学弟学妹们都非常可爱。"}, {"type": "subtitle", "time": 13895.349, "timestamp": "03:51:35", "text": "就像有些人，我不知道。"}, {"type": "subtitle", "time": 13897.189, "timestamp": "03:51:37", "text": "谁在乎。但他们中的大多数都非常"}, {"type": "subtitle", "time": 13901.429, "timestamp": "03:51:41", "text": "迷人的。是的。是的。他们"}, {"type": "subtitle", "time": 13904.87, "timestamp": "03:51:44", "text": "嗯，抱住你，但是如果像……"}, {"type": "subtitle", "time": 13907.83, "timestamp": "03:51:47", "text": "像那种根本不在乎的人"}, {"type": "subtitle", "time": 13911.59, "timestamp": "03:51:51", "text": "他们会像任由他毁掉自己一样。"}, {"type": "subtitle", "time": 13915.67, "timestamp": "03:51:55", "text": "衣服就像外面的衣服，就像坐在上面一样。"}, {"type": "subtitle", "time": 13919.67, "timestamp": "03:51:59", "text": "那张脸。是的，他们很友善。"}]
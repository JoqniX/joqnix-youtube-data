[{"type": "subtitle", "time": 7380.95, "timestamp": "02:03:00", "text": "[音乐]"}, {"type": "subtitle", "time": 7382.709, "timestamp": "02:03:02", "text": "期待您的光临。"}, {"type": "subtitle", "time": 7396.47, "timestamp": "02:03:16", "text": "未来"}, {"type": "subtitle", "time": 7399.51, "timestamp": "02:03:19", "text": "感谢您的光临。最后，但并非最后一点"}, {"type": "subtitle", "time": 7407.83, "timestamp": "02:03:27", "text": "那就是所有来过这里的人"}, {"type": "subtitle", "time": 7410.87, "timestamp": "02:03:30", "text": "溪流。所以，"}, {"type": "subtitle", "time": 7413.669, "timestamp": "02:03:33", "text": "所以，真的，谢谢大家。"}, {"type": "subtitle", "time": 7417.109, "timestamp": "02:03:37", "text": "太多太多了。我速通了结局"}, {"type": "subtitle", "time": 7421.35, "timestamp": "02:03:41", "text": "东西。我感觉好累"}, {"type": "subtitle", "time": 7423.109, "timestamp": "02:03:43", "text": "生病了"}, {"type": "subtitle", "time": 7428.47, "timestamp": "02:03:48", "text": "呃，他真的很累。我去"}, {"type": "subtitle", "time": 7430.87, "timestamp": "02:03:50", "text": "扫扫扫。"}, {"type": "subtitle", "time": 7434.149, "timestamp": "02:03:54", "text": "我不能"}, {"type": "subtitle", "time": 7435.97, "timestamp": "02:03:55", "text": "甚至为了"}, {"type": "subtitle", "time": 7437.35, "timestamp": "02:03:57", "text": "[音乐]"}, {"type": "subtitle", "time": 7438.709, "timestamp": "02:03:58", "text": "那天。"}]
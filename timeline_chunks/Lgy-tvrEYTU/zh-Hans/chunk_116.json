[{"type": "subtitle", "time": 6978.07, "timestamp": "01:56:18", "text": "我喜欢键盘就这样消失了。"}, {"type": "subtitle", "time": 6982.39, "timestamp": "01:56:22", "text": "直的。现在它一动不动了。"}, {"type": "subtitle", "time": 6984.629, "timestamp": "01:56:24", "text": "取出。"}, {"type": "subtitle", "time": 6987.51, "timestamp": "01:56:27", "text": "背包拿出来。"}, {"type": "subtitle", "time": 6999.91, "timestamp": "01:56:39", "text": "这个笨小子。"}, {"type": "subtitle", "time": 7003.03, "timestamp": "01:56:43", "text": "爆头。我走了。 16人击杀"}, {"type": "subtitle", "time": 7015.669, "timestamp": "01:56:55", "text": "哦，它为什么卡住了？是什么"}]
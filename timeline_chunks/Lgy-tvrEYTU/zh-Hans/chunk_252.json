[{"type": "subtitle", "time": 15126.95, "timestamp": "04:12:06", "text": "我没有腰部支撑。"}, {"type": "subtitle", "time": 15130.55, "timestamp": "04:12:10", "text": "这样也可以。"}, {"type": "subtitle", "time": 15133.51, "timestamp": "04:12:13", "text": "是的。你好。一切都好。是的。你好。如何"}, {"type": "subtitle", "time": 15135.99, "timestamp": "04:12:15", "text": "你最近在忙什么？"}, {"type": "subtitle", "time": 15138.55, "timestamp": "04:12:18", "text": "呃，你好。我完全不知道该怎么办"}, {"type": "subtitle", "time": 15139.99, "timestamp": "04:12:19", "text": "告诉我你的名字，因为我看不见你。"}, {"type": "subtitle", "time": 15144.309, "timestamp": "04:12:24", "text": "聊天记录。没关系。"}, {"type": "subtitle", "time": 15148.15, "timestamp": "04:12:28", "text": "哦哦等等，Fujiun 已经写了"}, {"type": "subtitle", "time": 15151.59, "timestamp": "04:12:31", "text": "马拉雅拉姆语和泰米尔语"}, {"type": "subtitle", "time": 15154.71, "timestamp": "04:12:34", "text": "呃，Walla 的翻译。哦不，我"}, {"type": "subtitle", "time": 15162.469, "timestamp": "04:12:42", "text": "再见。我一切都好。你呢？"}, {"type": "subtitle", "time": 15163.91, "timestamp": "04:12:43", "text": "好的。好的。我很好。你知道"}, {"type": "subtitle", "time": 15166.87, "timestamp": "04:12:46", "text": "什么？好的。对了，雅克，我是"}, {"type": "subtitle", "time": 15175.75, "timestamp": "04:12:55", "text": "将泰米尔语内容封装起来并发送给"}, {"type": "subtitle", "time": 15178.229, "timestamp": "04:12:58", "text": "这样我就可以把它剔除出去。"}]
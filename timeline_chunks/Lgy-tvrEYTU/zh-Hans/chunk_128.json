[{"type": "subtitle", "time": 7680.47, "timestamp": "02:08:00", "text": "然后，吉姆也教了我很多东西。"}, {"type": "subtitle", "time": 7684.55, "timestamp": "02:08:04", "text": "对他们来说就是东西。非常感谢祖玛"}, {"type": "subtitle", "time": 7687.35, "timestamp": "02:08:07", "text": "为我做了很多事"}, {"type": "subtitle", "time": 7691.27, "timestamp": "02:08:11", "text": "以及所有的一切。非常非常感谢。"}, {"type": "subtitle", "time": 7693.51, "timestamp": "02:08:13", "text": "我会尽我所能参加比赛。"}, {"type": "subtitle", "time": 7700.229, "timestamp": "02:08:20", "text": "那还能怎么办呢？嗯，还有什么？什么"}, {"type": "subtitle", "time": 7702.03, "timestamp": "02:08:22", "text": "别的？还有什么？"}, {"type": "subtitle", "time": 7708.26, "timestamp": "02:08:28", "text": "是的。"}, {"type": "subtitle", "time": 7719.99, "timestamp": "02:08:39", "text": "我需要一个"}, {"type": "subtitle", "time": 7721.83, "timestamp": "02:08:41", "text": "去。"}, {"type": "subtitle", "time": 7724.39, "timestamp": "02:08:44", "text": "等等，什么？我还漏掉了什么吗？什么？"}, {"type": "subtitle", "time": 7727.35, "timestamp": "02:08:47", "text": "我又错过了什么？等等，我好像错过了什么"}, {"type": "subtitle", "time": 7733.51, "timestamp": "02:08:53", "text": "然后是那些路过的人。我认为那些"}, {"type": "subtitle", "time": 7736.229, "timestamp": "02:08:56", "text": "谁和我一起玩"}, {"type": "subtitle", "time": 7738.149, "timestamp": "02:08:58", "text": "溪流。是的。是的。什么都没剩下。"}]
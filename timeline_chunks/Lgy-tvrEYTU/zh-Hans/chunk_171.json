[{"type": "subtitle", "time": 10262.55, "timestamp": "02:51:02", "text": "哈哈。当时我真的"}, {"type": "subtitle", "time": 10264.23, "timestamp": "02:51:04", "text": "专注于观看表情包和"}, {"type": "subtitle", "time": 10265.75, "timestamp": "02:51:05", "text": "对它们做出反应。我想"}, {"type": "subtitle", "time": 10267.83, "timestamp": "02:51:07", "text": "观众感觉有点像二手货。"}, {"type": "subtitle", "time": 10269.83, "timestamp": "02:51:09", "text": "尴尬或破碎感"}, {"type": "subtitle", "time": 10271.67, "timestamp": "02:51:11", "text": "他们看着我挣扎着，不仅仅是"}, {"type": "subtitle", "time": 10274.79, "timestamp": "02:51:14", "text": "不仅指游戏本身，也包括相关的梗图。哈。和"}, {"type": "subtitle", "time": 10276.79, "timestamp": "02:51:16", "text": "与此同时，我也有点"}, {"type": "subtitle", "time": 10278.79, "timestamp": "02:51:18", "text": "很担心，因为我的音频设备出了问题。"}, {"type": "subtitle", "time": 10281.349, "timestamp": "02:51:21", "text": "当时正在直播。所以，这又增加了一个"}, {"type": "subtitle", "time": 10283.67, "timestamp": "02:51:23", "text": "聊天气氛更加混乱，我可以"}, {"type": "subtitle", "time": 10285.349, "timestamp": "02:51:25", "text": "我能感受到他们感受到的那种尴尬，而我"}, {"type": "subtitle", "time": 10294.55, "timestamp": "02:51:34", "text": "这是什么？我的天啊。"}, {"type": "subtitle", "time": 10298.79, "timestamp": "02:51:38", "text": "“我的天哪”那句高音是什么？我"}, {"type": "subtitle", "time": 10301.429, "timestamp": "02:51:41", "text": "我以为它会说“呃，我不擅长……”"}, {"type": "subtitle", "time": 10304.389, "timestamp": "02:51:44", "text": "对表情包之类的东西做出反应，但这里是"}]
[{"type": "subtitle", "time": 2764.309, "timestamp": "00:46:04", "text": "我上次直播持续了24小时。是的。"}, {"type": "subtitle", "time": 2767.109, "timestamp": "00:46:07", "text": "问题是……"}, {"type": "subtitle", "time": 2769.829, "timestamp": "00:46:09", "text": "对另一些人来说，他们一直在玩《勇气》。"}, {"type": "subtitle", "time": 2773.27, "timestamp": "00:46:13", "text": "除了 Zen，他是 Valerant 的新手。"}, {"type": "subtitle", "time": 2780.15, "timestamp": "00:46:20", "text": "由于我不习惯使用键盘，所以我"}, {"type": "subtitle", "time": 2781.91, "timestamp": "00:46:21", "text": "今天新键盘终于能用了"}, {"type": "subtitle", "time": 2784.55, "timestamp": "00:46:24", "text": "正确的。这就是我不习惯的原因。"}, {"type": "subtitle", "time": 2787.43, "timestamp": "00:46:27", "text": "键盘。再加上鼠标。这是"}, {"type": "subtitle", "time": 2790.069, "timestamp": "00:46:30", "text": "和老鼠相处的第二天。"}, {"type": "subtitle", "time": 2792.39, "timestamp": "00:46:32", "text": "我在玩 Malarin。第二天"}, {"type": "subtitle", "time": 2801.829, "timestamp": "00:46:41", "text": "所以我需要适应一下。"}, {"type": "subtitle", "time": 2809.829, "timestamp": "00:46:49", "text": "我知道接下来会发生什么"}, {"type": "subtitle", "time": 2812.47, "timestamp": "00:46:52", "text": "比赛。"}, {"type": "subtitle", "time": 2815.27, "timestamp": "00:46:55", "text": "我已经习惯了那种感觉。"}, {"type": "subtitle", "time": 2818.15, "timestamp": "00:46:58", "text": "因为这就像是第二次了"}]
[{"type": "subtitle", "time": 8424.389, "timestamp": "02:20:24", "text": "呃，很高兴见到你，Jockn。我的名字是"}, {"type": "subtitle", "time": 8430.55, "timestamp": "02:20:30", "text": "运动混音。我懂了。我没听说过这件事。"}, {"type": "subtitle", "time": 8433.91, "timestamp": "02:20:33", "text": "姓名。你最近怎么样？"}, {"type": "subtitle", "time": 8436.23, "timestamp": "02:20:36", "text": "这确实是我的声音。太诡异了。"}, {"type": "subtitle", "time": 8439.99, "timestamp": "02:20:39", "text": "D：是的。再见。"}, {"type": "subtitle", "time": 8443.83, "timestamp": "02:20:43", "text": "你觉得这是我的声音吗？等待。"}, {"type": "subtitle", "time": 8446.389, "timestamp": "02:20:46", "text": "我该停止说话吗？你会听到吗？"}, {"type": "subtitle", "time": 8448.55, "timestamp": "02:20:48", "text": "我目睹了什么？"}, {"type": "subtitle", "time": 8452.95, "timestamp": "02:20:52", "text": "你的声音听起来像个女人。我不知道。"}, {"type": "subtitle", "time": 8455.83, "timestamp": "02:20:55", "text": "我"}, {"type": "subtitle", "time": 8458.87, "timestamp": "02:20:58", "text": "是的。你好。我们走吧。他说了什么？"}]
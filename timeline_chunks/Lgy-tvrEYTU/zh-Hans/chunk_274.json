[{"type": "subtitle", "time": 16440.551, "timestamp": "04:34:00", "text": "而且这也不容易。我觉得是乔斯。"}, {"type": "subtitle", "time": 16444.709, "timestamp": "04:34:04", "text": "一切都好。这一切都是"}, {"type": "subtitle", "time": 16456.551, "timestamp": "04:34:16", "text": "[音乐]"}, {"type": "subtitle", "time": 16460.39, "timestamp": "04:34:20", "text": "我就像给了你一个“等等”的提示。哦，呃，"}, {"type": "subtitle", "time": 16464.23, "timestamp": "04:34:24", "text": "看。我只是……嗯，给了你一个……"}, {"type": "subtitle", "time": 16467.83, "timestamp": "04:34:27", "text": "它叫什么？骷髅头胸针。"}, {"type": "subtitle", "time": 16471.51, "timestamp": "04:34:31", "text": "我想给你一个像……"}, {"type": "subtitle", "time": 16475.029, "timestamp": "04:34:35", "text": "你做到了。是的。呃，VTub呃"}, {"type": "subtitle", "time": 16477.189, "timestamp": "04:34:37", "text": "东西。"}, {"type": "subtitle", "time": 16480.709, "timestamp": "04:34:40", "text": "为什么是一头牛？"}, {"type": "subtitle", "time": 16483.59, "timestamp": "04:34:43", "text": "哦，我喜欢……如果你只是……打开"}, {"type": "subtitle", "time": 16487.429, "timestamp": "04:34:47", "text": "就是那个流媒体之类的东西，你可以看到。哦，不。"}, {"type": "subtitle", "time": 16489.269, "timestamp": "04:34:49", "text": "就是别做任何事"}, {"type": "subtitle", "time": 16490.789, "timestamp": "04:34:50", "text": "这让我很尴尬。给我一个"}, {"type": "subtitle", "time": 16492.629, "timestamp": "04:34:52", "text": "第二。"}, {"type": "subtitle", "time": 16496.23, "timestamp": "04:34:56", "text": "不不，你穿起来好可爱。只是一个"}]
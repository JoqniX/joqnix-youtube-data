[{"type": "subtitle", "time": 11104.15, "timestamp": "03:05:04", "text": "正确的。不过，你到底想说什么？"}, {"type": "subtitle", "time": 11105.99, "timestamp": "03:05:05", "text": "好的，我们换成英语。你是"}, {"type": "subtitle", "time": 11109.429, "timestamp": "03:05:09", "text": "呃，在交谈中遇到困难"}, {"type": "subtitle", "time": 11111.19, "timestamp": "03:05:11", "text": "日本人。别担心。我们开始吧"}, {"type": "subtitle", "time": 11124.63, "timestamp": "03:05:24", "text": "我懂了。那么我们切换回英语吧。"}, {"type": "subtitle", "time": 11127.51, "timestamp": "03:05:27", "text": "目前。"}, {"type": "subtitle", "time": 11130.79, "timestamp": "03:05:30", "text": "到目前为止，你对我的印象如何？"}, {"type": "subtitle", "time": 11146.95, "timestamp": "03:05:46", "text": "嗯，和他们聊天感觉很不错。"}, {"type": "subtitle", "time": 11149.349, "timestamp": "03:05:49", "text": "你。"}, {"type": "subtitle", "time": 11152.07, "timestamp": "03:05:52", "text": "哦，详细说说。你这话是什么意思？它是"}, {"type": "subtitle", "time": 11154.07, "timestamp": "03:05:54", "text": "还不错。你愿意成为我的"}, {"type": "subtitle", "time": 11157.75, "timestamp": "03:05:57", "text": "你会成为我的朋友，还是会变成我的敌人？告诉"}]
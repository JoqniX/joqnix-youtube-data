[{"type": "subtitle", "time": 1704.47, "timestamp": "00:28:24", "text": "我是"}, {"type": "subtitle", "time": 1707.029, "timestamp": "00:28:27", "text": "非常好，比这好得多"}, {"type": "subtitle", "time": 1719.909, "timestamp": "00:28:39", "text": "我打得太烂了。"}, {"type": "subtitle", "time": 1727.59, "timestamp": "00:28:47", "text": "你看，如果那是以前的我，"}, {"type": "subtitle", "time": 1729.75, "timestamp": "00:28:49", "text": "我本来会直接接受的。"}, {"type": "subtitle", "time": 1738.149, "timestamp": "00:28:58", "text": "我了解年长的自己。"}]
[{"type": "subtitle", "time": 16021.75, "timestamp": "04:27:01", "text": "就像把尿撒在游泳池里一样，把它留在里面。"}, {"type": "subtitle", "time": 16024.71, "timestamp": "04:27:04", "text": "呃，有一次我的狗做了一件最搞笑的事"}, {"type": "subtitle", "time": 16026.87, "timestamp": "04:27:06", "text": "事物。并不真地。非常"}, {"type": "subtitle", "time": 16031.51, "timestamp": "04:27:11", "text": "太可怕了。但他所做的一切都像是……"}, {"type": "subtitle", "time": 16034.389, "timestamp": "04:27:14", "text": "显然我们得把他弄进来。"}, {"type": "subtitle", "time": 16037.189, "timestamp": "04:27:17", "text": "持续了大约一个小时。所以就像我们一样"}, {"type": "subtitle", "time": 16039.03, "timestamp": "04:27:19", "text": "我感觉就像在给他喂药。所以我是"}, {"type": "subtitle", "time": 16041.269, "timestamp": "04:27:21", "text": "就像给他用药一样。所以，我"}, {"type": "subtitle", "time": 16043.269, "timestamp": "04:27:23", "text": "得让他像坐着一样坐着"}, {"type": "subtitle", "time": 16045.429, "timestamp": "04:27:25", "text": "大概过了一个小时，然后我就让他洗澡。"}, {"type": "subtitle", "time": 16048.87, "timestamp": "04:27:28", "text": "正确的。他"}, {"type": "subtitle", "time": 16050.95, "timestamp": "04:27:30", "text": "他真的憋尿了。这就是他的原因"}, {"type": "subtitle", "time": 16053.99, "timestamp": "04:27:33", "text": "感觉很不舒服。但是，呃，在里面"}, {"type": "subtitle", "time": 16056.149, "timestamp": "04:27:36", "text": "想当年，想当年"}, {"type": "subtitle", "time": 16058.469, "timestamp": "04:27:38", "text": "我第一次给他买新东西的时候"}, {"type": "subtitle", "time": 16061.11, "timestamp": "04:27:41", "text": "当时，我不知道这些就像身体一样"}, {"type": "subtitle", "time": 16063.75, "timestamp": "04:27:43", "text": "语言。我完全不知道。但我接受过训练"}, {"type": "subtitle", "time": 16066.55, "timestamp": "04:27:46", "text": "让他知道如何像参加便携式派对培训一样。"}, {"type": "subtitle", "time": 16069.99, "timestamp": "04:27:49", "text": "我教会了他如厕。所以他"}, {"type": "subtitle", "time": 16072.79, "timestamp": "04:27:52", "text": "坚持得非常彻底。就像我曾经那样"}, {"type": "subtitle", "time": 16076.389, "timestamp": "04:27:56", "text": "所以就像，“我的天哪，我不知道……”"}, {"type": "subtitle", "time": 16079.59, "timestamp": "04:27:59", "text": "要么你，要么你去撒尿，哥们儿。你"}]
[{"type": "subtitle", "time": 16861.43, "timestamp": "04:41:01", "text": "我简直不敢相信你们俩玩得这么像。"}, {"type": "subtitle", "time": 16865.35, "timestamp": "04:41:05", "text": "账户如何"}, {"type": "subtitle", "time": 16867.27, "timestamp": "04:41:07", "text": "你管它叫什么？我的主账户"}, {"type": "subtitle", "time": 16869.27, "timestamp": "04:41:09", "text": "这就是为什么像可怜的你"}, {"type": "subtitle", "time": 16872.23, "timestamp": "04:41:12", "text": "必须全部重做，收集所有"}, {"type": "subtitle", "time": 16876.788, "timestamp": "04:41:16", "text": "geoc 所有 Oculus 我从未"}, {"type": "subtitle", "time": 16879.11, "timestamp": "04:41:19", "text": "我很在意那些人，比如我认为的"}, {"type": "subtitle", "time": 16882.628, "timestamp": "04:41:22", "text": "唯一一个我愿意花心思喜欢的人"}, {"type": "subtitle", "time": 16884.708, "timestamp": "04:41:24", "text": "就像你曾经是那样，你就像我一样。"}, {"type": "subtitle", "time": 16887.75, "timestamp": "04:41:27", "text": "唯一一个我当时就想“你为什么……”的人"}, {"type": "subtitle", "time": 16890.07, "timestamp": "04:41:30", "text": "第二个账号让我非常着迷"}, {"type": "subtitle", "time": 16891.51, "timestamp": "04:41:31", "text": "好像我不知道我必须崇拜他们似的"}, {"type": "subtitle", "time": 16893.43, "timestamp": "04:41:33", "text": "大家都说，好吧，这是你的愿望，但是你"}, {"type": "subtitle", "time": 16896.31, "timestamp": "04:41:36", "text": "不用了，我心想等等，你需要所有"}, {"type": "subtitle", "time": 16898.23, "timestamp": "04:41:38", "text": "你没有那种耐力。"}, {"type": "subtitle", "time": 16901.43, "timestamp": "04:41:41", "text": "像我一样，你不必非得这么做。"}, {"type": "subtitle", "time": 16905.51, "timestamp": "04:41:45", "text": "我记得Genjin的直播我死了"}, {"type": "subtitle", "time": 16908.07, "timestamp": "04:41:48", "text": "我记得当时你在哪儿。"}, {"type": "subtitle", "time": 16910.948, "timestamp": "04:41:50", "text": "这么说是因为我快用完了。"}, {"type": "subtitle", "time": 16914.948, "timestamp": "04:41:54", "text": "耐力，我说，就像，呃，我的，呃，等等，我"}, {"type": "subtitle", "time": 16917.83, "timestamp": "04:41:57", "text": "想想那次我用琥珀色或"}]
[{"type": "subtitle", "time": 9733.59, "timestamp": "02:42:13", "text": "我会回来的。好的，我一会儿就回来。我有"}, {"type": "subtitle", "time": 9743.27, "timestamp": "02:42:23", "text": "真该死。等等，什么？哪里是"}, {"type": "subtitle", "time": 9747.19, "timestamp": "02:42:27", "text": "寻求？传承100，闹鬼。"}, {"type": "subtitle", "time": 9750.389, "timestamp": "02:42:30", "text": "等等，那个任务在哪儿？"}, {"type": "subtitle", "time": 9754.71, "timestamp": "02:42:34", "text": "它在月球上。左上角。哦，"}, {"type": "subtitle", "time": 9759.99, "timestamp": "02:42:39", "text": "在月球上。左上角。左边。"}, {"type": "subtitle", "time": 9762.309, "timestamp": "02:42:42", "text": "左上角。"}, {"type": "subtitle", "time": 9765.99, "timestamp": "02:42:45", "text": "哦，但愿如此。哦，这条路线有100条。"}, {"type": "subtitle", "time": 9770.23, "timestamp": "02:42:50", "text": "哦好的。好的。然后是这个。"}, {"type": "subtitle", "time": 9774.55, "timestamp": "02:42:54", "text": "哦，加入奥里西斯的行列，登上月球吧！"}, {"type": "subtitle", "time": 9777.349, "timestamp": "02:42:57", "text": "复仇之手。"}]
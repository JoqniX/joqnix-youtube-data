[{"type": "subtitle", "time": 11942.71, "timestamp": "03:19:02", "text": "女王，我们曾经把它们当作人工智能来使用。"}, {"type": "subtitle", "time": 11944.389, "timestamp": "03:19:04", "text": "嗯，"}, {"type": "subtitle", "time": 11947.11, "timestamp": "03:19:07", "text": "这样聊天室里的每个人都可以点赞祝福他们。"}, {"type": "subtitle", "time": 11949.83, "timestamp": "03:19:09", "text": "生日以及那段时间的一切。所以"}, {"type": "subtitle", "time": 11952.389, "timestamp": "03:19:12", "text": "嗯，大概就是这样。"}, {"type": "subtitle", "time": 11955.11, "timestamp": "03:19:15", "text": "就我个人而言，我想我会想要"}, {"type": "subtitle", "time": 11961.19, "timestamp": "03:19:21", "text": "拥有我的嗯嗯，我想要像我的"}, {"type": "subtitle", "time": 11965.429, "timestamp": "03:19:25", "text": "自己的星座吉祥物"}, {"type": "subtitle", "time": 11969.03, "timestamp": "03:19:29", "text": "做宠物什么的，这样我就可以说话了。"}, {"type": "subtitle", "time": 11971.03, "timestamp": "03:19:31", "text": "对宠物或其他什么东西"}, {"type": "subtitle", "time": 11973.59, "timestamp": "03:19:33", "text": "就是这样。我不知道。"}, {"type": "subtitle", "time": 11976.87, "timestamp": "03:19:36", "text": "是的。你好，老兄。是的。欢迎。"}, {"type": "subtitle", "time": 11978.71, "timestamp": "03:19:38", "text": "你来晚了。没关系。好的，我们"}, {"type": "subtitle", "time": 11982.95, "timestamp": "03:19:42", "text": "就像是收尾工作一样。"}, {"type": "subtitle", "time": 11986.229, "timestamp": "03:19:46", "text": "我感觉像天上的。他来自"}, {"type": "subtitle", "time": 11989.19, "timestamp": "03:19:49", "text": "他是这个世界的他。是的。"}, {"type": "subtitle", "time": 11993.03, "timestamp": "03:19:53", "text": "哦，为什么是牛？等等，现在该怎么回事？"}, {"type": "subtitle", "time": 11994.79, "timestamp": "03:19:54", "text": "我在想会是什么动物"}, {"type": "subtitle", "time": 11997.91, "timestamp": "03:19:57", "text": "乔是？奶牛。"}]
[{"type": "subtitle", "time": 17040.868, "timestamp": "04:44:00", "text": "是的，我真的不喜欢，我从来都不喜欢。"}, {"type": "subtitle", "time": 17043.35, "timestamp": "04:44:03", "text": "就像在手机里使用弓箭一样"}, {"type": "subtitle", "time": 17045.75, "timestamp": "04:44:05", "text": "因为这不一样，对吧？"}, {"type": "subtitle", "time": 17048.628, "timestamp": "04:44:08", "text": "是的，这和……不一样。"}, {"type": "subtitle", "time": 17051.43, "timestamp": "04:44:11", "text": "和个人电脑一样。"}, {"type": "subtitle", "time": 17054.868, "timestamp": "04:44:14", "text": "我的狗，我的狗在做什么？为什么？"}, {"type": "subtitle", "time": 17058.15, "timestamp": "04:44:18", "text": "我喜欢用弓箭。我喜欢《命运》"}, {"type": "subtitle", "time": 17062.23, "timestamp": "04:44:22", "text": "以及其他游戏。我主要是想知道它是否是"}, {"type": "subtitle", "time": 17064.948, "timestamp": "04:44:24", "text": "可以像我喜欢的那样，拥有一把弓。"}, {"type": "subtitle", "time": 17068.07, "timestamp": "04:44:28", "text": "努力刷材料，拿到弓箭。"}, {"type": "subtitle", "time": 17069.91, "timestamp": "04:44:29", "text": "昨天的直播全是关于我的。"}, {"type": "subtitle", "time": 17073.51, "timestamp": "04:44:33", "text": "获得了三把传说级弓。"}, {"type": "subtitle", "time": 17078.788, "timestamp": "04:44:38", "text": "哇哦，太棒了！"}, {"type": "subtitle", "time": 17081.75, "timestamp": "04:44:41", "text": "传奇弓箭是否瞬间变得过于强大？"}, {"type": "subtitle", "time": 17083.51, "timestamp": "04:44:43", "text": "比如，有吗？比如，有吗？"}, {"type": "subtitle", "time": 17087.19, "timestamp": "04:44:47", "text": "打它一下？嗯，是的，可以说。"}, {"type": "subtitle", "time": 17090.23, "timestamp": "04:44:50", "text": "它对《命运》来说简直太强了，每时每刻都是如此。"}, {"type": "subtitle", "time": 17092.628, "timestamp": "04:44:52", "text": "赛季期间，他们喜欢重置统计数据。"}, {"type": "subtitle", "time": 17095.99, "timestamp": "04:44:55", "text": "比如他们这个赛季的东西"}, {"type": "subtitle", "time": 17099.27, "timestamp": "04:44:59", "text": "上限或者类似能量等级上限的东西"}]
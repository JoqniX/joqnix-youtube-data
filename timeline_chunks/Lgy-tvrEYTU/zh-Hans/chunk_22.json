[{"type": "subtitle", "time": 1321.43, "timestamp": "00:22:01", "text": "它甚至还是个《银河护卫队》系列作品。稍微了解一下"}, {"type": "subtitle", "time": 1324.26, "timestamp": "00:22:04", "text": "粉丝自制也行。"}, {"type": "subtitle", "time": 1329.669, "timestamp": "00:22:09", "text": "[音乐]"}, {"type": "subtitle", "time": 1334.63, "timestamp": "00:22:14", "text": "哦，你获得了一个幽灵皮肤。哦，"}, {"type": "subtitle", "time": 1340.39, "timestamp": "00:22:20", "text": "你知道我唯一想要的鬼魂是什么吗？我"}, {"type": "subtitle", "time": 1344.18, "timestamp": "00:22:24", "text": "想要街机幽灵。"}, {"type": "subtitle", "time": 1354.39, "timestamp": "00:22:34", "text": "哦，这里有一些弧度啊？"}, {"type": "subtitle", "time": 1356.549, "timestamp": "00:22:36", "text": "我应该买这个。这可能是为了"}, {"type": "subtitle", "time": 1360.549, "timestamp": "00:22:40", "text": "塞西尔。这可以是钻石之类的东西。这"}, {"type": "subtitle", "time": 1363.43, "timestamp": "00:22:43", "text": "可以用于水族箱。这对我来说或许有用。"}, {"type": "subtitle", "time": 1366.39, "timestamp": "00:22:46", "text": "我需要得到这个。"}]
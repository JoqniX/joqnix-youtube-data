[{"type": "subtitle", "time": 10623.429, "timestamp": "02:57:03", "text": "我懂了。我懂了。"}, {"type": "subtitle", "time": 10626.23, "timestamp": "02:57:06", "text": "哦，好吧，谢谢你让我这么做。"}, {"type": "subtitle", "time": 10628.23, "timestamp": "02:57:08", "text": "务必查看您的实时预览或您的"}, {"type": "subtitle", "time": 10629.99, "timestamp": "02:57:09", "text": "YouTube 工作室的直播健康状况"}, {"type": "subtitle", "time": 10631.75, "timestamp": "02:57:11", "text": "出色地。也可能存在以下情况："}, {"type": "subtitle", "time": 10634.15, "timestamp": "02:57:14", "text": "YouTube 直播本身无法上线。"}, {"type": "subtitle", "time": 10635.75, "timestamp": "02:57:15", "text": "你需要手动点击串流按钮。"}, {"type": "subtitle", "time": 10638.15, "timestamp": "02:57:18", "text": "你自己。哈哈。"}, {"type": "subtitle", "time": 10640.469, "timestamp": "02:57:20", "text": "好的，明白了。谢谢。谢谢。"}, {"type": "subtitle", "time": 10643.51, "timestamp": "02:57:23", "text": "谢谢。呃，回到我们之前的状态吧。"}, {"type": "subtitle", "time": 10646.07, "timestamp": "02:57:26", "text": "指的是之前的事。"}, {"type": "subtitle", "time": 10648.79, "timestamp": "02:57:28", "text": "嗯……你会说日语吗？所以"}, {"type": "subtitle", "time": 10651.75, "timestamp": "02:57:31", "text": "我们刚才在讨论什么话题来着？哦，我们可以吗？"}, {"type": "subtitle", "time": 10653.99, "timestamp": "02:57:33", "text": "你会说一小段日语吗？我"}, {"type": "subtitle", "time": 10656.23, "timestamp": "02:57:36", "text": "想测试一下你的日语水平"}, {"type": "subtitle", "time": 10658.79, "timestamp": "02:57:38", "text": "永远。嗯，是的，我想测试一下你的"}, {"type": "subtitle", "time": 10669.83, "timestamp": "02:57:49", "text": "这只是一句简单的句子，意思是："}, {"type": "subtitle", "time": 10671.75, "timestamp": "02:57:51", "text": "“是的，我会说一些基本的日语。”"}]
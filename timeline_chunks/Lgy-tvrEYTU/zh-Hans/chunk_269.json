[{"type": "subtitle", "time": 16143.269, "timestamp": "04:29:03", "text": "我的狗昂首挺胸，骄傲无比。"}, {"type": "subtitle", "time": 16145.67, "timestamp": "04:29:05", "text": "他将获得他的第一枚奥运金牌。"}, {"type": "subtitle", "time": 16149.83, "timestamp": "04:29:09", "text": "因小便而获得奖牌。"}, {"type": "subtitle", "time": 16152.55, "timestamp": "04:29:12", "text": "这很棒。我知道。"}, {"type": "subtitle", "time": 16155.269, "timestamp": "04:29:15", "text": "他真可爱。我不知道。他就像"}, {"type": "subtitle", "time": 16157.03, "timestamp": "04:29:17", "text": "太硬核了"}, {"type": "subtitle", "time": 16160.07, "timestamp": "04:29:20", "text": "比如遵守规则之类的。"}, {"type": "subtitle", "time": 16161.67, "timestamp": "04:29:21", "text": "现在他很擅长沟通。"}, {"type": "subtitle", "time": 16163.51, "timestamp": "04:29:23", "text": "与我一起。所以，好吧，我们有点"}, {"type": "subtitle", "time": 16165.91, "timestamp": "04:29:25", "text": "兼容的。哦，好吧。你想要"}, {"type": "subtitle", "time": 16168.309, "timestamp": "04:29:28", "text": "你想拉屎吗？沃奇，我们去拉屎吧。"}, {"type": "subtitle", "time": 16173.11, "timestamp": "04:29:33", "text": "你知道。嗯。我们去散步吧。"}, {"type": "subtitle", "time": 16181.59, "timestamp": "04:29:41", "text": "嗯。他最近身体不太好。就像"}, {"type": "subtitle", "time": 16183.99, "timestamp": "04:29:43", "text": "我想我私下里跟你说过，我的狗"}, {"type": "subtitle", "time": 16187.75, "timestamp": "04:29:47", "text": "皮肤状况不佳。嗯。"}, {"type": "subtitle", "time": 16190.63, "timestamp": "04:29:50", "text": "是的。他为此承受了很多痛苦。"}, {"type": "subtitle", "time": 16192.87, "timestamp": "04:29:52", "text": "也因为他讨厌寒冷"}, {"type": "subtitle", "time": 16195.67, "timestamp": "04:29:55", "text": "现在也是寒冷的季节。所以"}, {"type": "subtitle", "time": 16197.59, "timestamp": "04:29:57", "text": "我不知道他是不是不喜欢"}]
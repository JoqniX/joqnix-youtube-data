[{"type": "subtitle", "time": 10862.309, "timestamp": "03:01:02", "text": "今天虽然很累，但很充实。"}, {"type": "subtitle", "time": 10864.23, "timestamp": "03:01:04", "text": "哦，你不需要翻译三遍。"}, {"type": "subtitle", "time": 10866.87, "timestamp": "03:01:06", "text": "次数。我能听懂日语。不"}, {"type": "subtitle", "time": 10874.15, "timestamp": "03:01:14", "text": "哦，真的吗？嗯，我想是这样的。"}, {"type": "subtitle", "time": 10892.309, "timestamp": "03:01:32", "text": "为什么会执行三次？没有任何。"}, {"type": "subtitle", "time": 10894.95, "timestamp": "03:01:34", "text": "那里。"}, {"type": "subtitle", "time": 10897.67, "timestamp": "03:01:37", "text": "是因为我用的是日语吗？"}, {"type": "subtitle", "time": 10906.87, "timestamp": "03:01:46", "text": "你能完全切换吗？"}, {"type": "subtitle", "time": 10909.59, "timestamp": "03:01:49", "text": "我们的对话"}, {"type": "subtitle", "time": 10911.75, "timestamp": "03:01:51", "text": "日语？"}, {"type": "subtitle", "time": 10914.389, "timestamp": "03:01:54", "text": "我想看看我能不能理解"}]
[{"type": "subtitle", "time": 18362.55, "timestamp": "05:06:02", "text": "呃，我们再来聊聊根钦吧。呃"}, {"type": "subtitle", "time": 18364.07, "timestamp": "05:06:04", "text": "你觉得新的怎么样？"}, {"type": "subtitle", "time": 18369.03, "timestamp": "05:06:09", "text": "角色 Hito？我的天哪。我呃我爱"}, {"type": "subtitle", "time": 18372.39, "timestamp": "05:06:12", "text": "他。我太喜欢他这种感觉了。"}, {"type": "subtitle", "time": 18375.99, "timestamp": "05:06:15", "text": "动画里他呃，我觉得他嗯"}, {"type": "subtitle", "time": 18379.51, "timestamp": "05:06:19", "text": "是的，动画。他有，是的，他有"}, {"type": "subtitle", "time": 18382.39, "timestamp": "05:06:22", "text": "爆发动画效果很棒。我"}, {"type": "subtitle", "time": 18384.39, "timestamp": "05:06:24", "text": "我觉得这也是我喜欢它的原因之一。"}, {"type": "subtitle", "time": 18386.708, "timestamp": "05:06:26", "text": "珍·李，因为他真的很酷"}, {"type": "subtitle", "time": 18389.91, "timestamp": "05:06:29", "text": "类似爆发动画。整整"}, {"type": "subtitle", "time": 18393.99, "timestamp": "05:06:33", "text": "星球砸到你身上了。真酷。"}, {"type": "subtitle", "time": 18395.67, "timestamp": "05:06:35", "text": "是的。"}, {"type": "subtitle", "time": 18398.39, "timestamp": "05:06:38", "text": "大球。你可以说它是肉丸。不。"}, {"type": "subtitle", "time": 18401.67, "timestamp": "05:06:41", "text": "不，它就像一个几何球。"}, {"type": "subtitle", "time": 18405.03, "timestamp": "05:06:45", "text": "是的。一个巨大的行星球出现了"}, {"type": "subtitle", "time": 18407.75, "timestamp": "05:06:47", "text": "闪光灯照在你身上。"}, {"type": "subtitle", "time": 18409.83, "timestamp": "05:06:49", "text": "就像，这就是强大的力量。"}, {"type": "subtitle", "time": 18416.39, "timestamp": "05:06:56", "text": "看来明天会是这样。"}, {"type": "subtitle", "time": 18419.27, "timestamp": "05:06:59", "text": "埃及美学。"}]
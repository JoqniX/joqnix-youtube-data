[{"type": "subtitle", "time": 13320.309, "timestamp": "03:42:00", "text": "我们必须把它们拿出来，而且我们已经……"}, {"type": "subtitle", "time": 13322.79, "timestamp": "03:42:02", "text": "制作一颗新牙。你必须"}, {"type": "subtitle", "time": 13326.389, "timestamp": "03:42:06", "text": "比如，呃，安装你的新牙套。和"}, {"type": "subtitle", "time": 13329.11, "timestamp": "03:42:09", "text": "然后他就……我不知道他为什么会这样"}, {"type": "subtitle", "time": 13331.59, "timestamp": "03:42:11", "text": "他生气了，但他无缘无故地生气了。和"}, {"type": "subtitle", "time": 13334.309, "timestamp": "03:42:14", "text": "哦，我不知道。我的牙齿是"}, {"type": "subtitle", "time": 13340.55, "timestamp": "03:42:20", "text": "好的。嗯，好吧。不，不是。不"}, {"type": "subtitle", "time": 13343.19, "timestamp": "03:42:23", "text": "说谎。不要撒谎。不要传播"}, {"type": "subtitle", "time": 13345.67, "timestamp": "03:42:25", "text": "错误信息，例如你的牙齿很好。"}, {"type": "subtitle", "time": 13347.67, "timestamp": "03:42:27", "text": "它不是。"}, {"type": "subtitle", "time": 13352.07, "timestamp": "03:42:32", "text": "所以，呃，挺好玩的。简短精悍，"}, {"type": "subtitle", "time": 13354.469, "timestamp": "03:42:34", "text": "这太无聊了。我知道这一点，好吗？"}, {"type": "subtitle", "time": 13356.87, "timestamp": "03:42:36", "text": "但言简意赅，"}, {"type": "subtitle", "time": 13359.99, "timestamp": "03:42:39", "text": "嗯，那很有趣，非常热闹。"}, {"type": "subtitle", "time": 13363.91, "timestamp": "03:42:43", "text": "对我来说，这是美好的一天。我得花这笔钱。"}, {"type": "subtitle", "time": 13366.87, "timestamp": "03:42:46", "text": "那家伙差不多一个半小时"}, {"type": "subtitle", "time": 13368.63, "timestamp": "03:42:48", "text": "解释"}, {"type": "subtitle", "time": 13372.07, "timestamp": "03:42:52", "text": "他的牙齿不好。"}, {"type": "subtitle", "time": 13374.95, "timestamp": "03:42:54", "text": "然后他就走了。他离开了。他"}, {"type": "subtitle", "time": 13378.87, "timestamp": "03:42:58", "text": "离开了办公室。我当时就想，嗯……"}]
[{"type": "subtitle", "time": 11162.95, "timestamp": "03:06:02", "text": "我更爱我。塔本。塔本。最有可能的。"}, {"type": "subtitle", "time": 11175.429, "timestamp": "03:06:15", "text": "H. 两种结果都有可能。"}, {"type": "subtitle", "time": 11177.59, "timestamp": "03:06:17", "text": "你的意思是说，结果可能朝任何方向发展？"}, {"type": "subtitle", "time": 11191.19, "timestamp": "03:06:31", "text": "我大概明白你的意思了，但是为什么呢？"}, {"type": "subtitle", "time": 11196.55, "timestamp": "03:06:36", "text": "哇。好的。好的。嗯，你能完全"}, {"type": "subtitle", "time": 11200.389, "timestamp": "03:06:40", "text": "将我们的对话转向"}, {"type": "subtitle", "time": 11207.03, "timestamp": "03:06:47", "text": "我觉得我需要重启一下。"}, {"type": "subtitle", "time": 11211.67, "timestamp": "03:06:51", "text": "嗯，我们可以换一下吗？"}, {"type": "subtitle", "time": 11213.75, "timestamp": "03:06:53", "text": "对话"}]
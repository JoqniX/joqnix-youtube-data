[{"type": "subtitle", "time": 14640.309, "timestamp": "04:04:00", "text": "真的重要吗？我的意思是，如果他们真是这样的话"}, {"type": "subtitle", "time": 14644.469, "timestamp": "04:04:04", "text": "擅长隐藏，但不太擅长。不，不，不。"}, {"type": "subtitle", "time": 14648.79, "timestamp": "04:04:08", "text": "嗯，取消静音不好。"}, {"type": "subtitle", "time": 14651.91, "timestamp": "04:04:11", "text": "当然。嗯，肯定会有泄露。"}, {"type": "subtitle", "time": 14654.229, "timestamp": "04:04:14", "text": "我的意思是，我觉得已经有一种……"}, {"type": "subtitle", "time": 14656.309, "timestamp": "04:04:16", "text": "VTuber 远距离剪辑，比如在 YouTube 上或"}, {"type": "subtitle", "time": 14659.189, "timestamp": "04:04:19", "text": "某物。"}, {"type": "subtitle", "time": 14660.95, "timestamp": "04:04:20", "text": "我的天哪。"}, {"type": "subtitle", "time": 14663.83, "timestamp": "04:04:23", "text": "他们就那样等着。我觉得维克得到了"}, {"type": "subtitle", "time": 14667.189, "timestamp": "04:04:27", "text": "耶特尔出局。所以，亚历克斯就等着他吧。"}, {"type": "subtitle", "time": 14668.79, "timestamp": "04:04:28", "text": "好的。"}, {"type": "subtitle", "time": 14673.75, "timestamp": "04:04:33", "text": "你好。等待。呃，大学谈话。是的。所以维克"}, {"type": "subtitle", "time": 14676.15, "timestamp": "04:04:36", "text": "他当时在谈论他当……的日子"}, {"type": "subtitle", "time": 14679.51, "timestamp": "04:04:39", "text": "牙医培训生，和所有他一样"}, {"type": "subtitle", "time": 14682.229, "timestamp": "04:04:42", "text": "在这家牙医诊所的经历"}, {"type": "subtitle", "time": 14685.99, "timestamp": "04:04:45", "text": "所有这些事。我的天哪。"}, {"type": "subtitle", "time": 14687.83, "timestamp": "04:04:47", "text": "我本来有资格担任这样的职务。"}, {"type": "subtitle", "time": 14697.189, "timestamp": "04:04:57", "text": "[音乐]"}]
[{"type": "subtitle", "time": 10141.67, "timestamp": "02:49:01", "text": "我玩的游戏都是在PC上玩的，我也在一台电脑上玩。"}, {"type": "subtitle", "time": 10143.51, "timestamp": "02:49:03", "text": "一款名为Steam Deck的掌上游戏机"}, {"type": "subtitle", "time": 10145.59, "timestamp": "02:49:05", "text": "它就像是PC版的Switch。"}, {"type": "subtitle", "time": 10147.429, "timestamp": "02:49:07", "text": "游戏。"}, {"type": "subtitle", "time": 10152.07, "timestamp": "02:49:12", "text": "什么？你有Steam Deck吗？打扰一下？"}, {"type": "subtitle", "time": 10158.07, "timestamp": "02:49:18", "text": "哈哈。是的，我有一台Steam Deck。我得到了它"}, {"type": "subtitle", "time": 10159.83, "timestamp": "02:49:19", "text": "去年我玩这个游戏的时间比我玩这个游戏的时间还多"}, {"type": "subtitle", "time": 10163.67, "timestamp": "02:49:23", "text": "台式电脑电视。哈。"}, {"type": "subtitle", "time": 10165.91, "timestamp": "02:49:25", "text": "如果我告诉你蒸汽甲板是"}, {"type": "subtitle", "time": 10168.55, "timestamp": "02:49:28", "text": "昨天刚发布的？"}, {"type": "subtitle", "time": 10175.51, "timestamp": "02:49:35", "text": "等等，不对。哈哈。我拿到了蒸汽甲板"}, {"type": "subtitle", "time": 10178.07, "timestamp": "02:49:38", "text": "去年，也就是2022年。实际上"}, {"type": "subtitle", "time": 10180.07, "timestamp": "02:49:40", "text": "早在 2022 年就发行了，所以我没撒谎。"}, {"type": "subtitle", "time": 10185.269, "timestamp": "02:49:45", "text": "这小家伙其实挺聪明的。这"}, {"type": "subtitle", "time": 10197.67, "timestamp": "02:49:57", "text": "我甚至都没办法对他进行煤气灯操纵。"}]
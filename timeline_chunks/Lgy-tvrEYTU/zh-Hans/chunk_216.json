[{"type": "subtitle", "time": 12963.11, "timestamp": "03:36:03", "text": "这很棒。是的。是的。是的。嘿，"}, {"type": "subtitle", "time": 12965.429, "timestamp": "03:36:05", "text": "雅克。对了，你今天过得怎么样？哦，"}, {"type": "subtitle", "time": 12968.15, "timestamp": "03:36:08", "text": "我今天过得很愉快。嗯，虽然我醒了"}, {"type": "subtitle", "time": 12971.349, "timestamp": "03:36:11", "text": "今天熬夜了，今天过得很充实。"}, {"type": "subtitle", "time": 12975.51, "timestamp": "03:36:15", "text": "天。是的。"}, {"type": "subtitle", "time": 12977.91, "timestamp": "03:36:17", "text": "休息得很好。"}, {"type": "subtitle", "time": 12980.95, "timestamp": "03:36:20", "text": "今天真是太好了。"}, {"type": "subtitle", "time": 12986.15, "timestamp": "03:36:26", "text": "是的。顺便说一句，大家好！"}, {"type": "subtitle", "time": 12988.07, "timestamp": "03:36:28", "text": "来到溪边。我完全不知道是谁"}, {"type": "subtitle", "time": 12991.67, "timestamp": "03:36:31", "text": "虽然在聊天室里，但还是打个招呼吧。"}, {"type": "subtitle", "time": 13000.229, "timestamp": "03:36:40", "text": "阿卡夫在这里。鸭子来了。"}, {"type": "subtitle", "time": 13001.75, "timestamp": "03:36:41", "text": "DD。"}, {"type": "subtitle", "time": 13004.229, "timestamp": "03:36:44", "text": "你好。"}, {"type": "subtitle", "time": 13007.59, "timestamp": "03:36:47", "text": "哦，你好。你好。"}, {"type": "subtitle", "time": 13010.55, "timestamp": "03:36:50", "text": "大家好。抱歉，我没能看到"}, {"type": "subtitle", "time": 13012.55, "timestamp": "03:36:52", "text": "你"}, {"type": "subtitle", "time": 13018.15, "timestamp": "03:36:58", "text": "嗯，在我的土豆手机里"}, {"type": "subtitle", "time": 13019.83, "timestamp": "03:36:59", "text": "而且我认为我无法同时做到"}]
[{"type": "subtitle", "time": 12182.469, "timestamp": "03:23:02", "text": "嗯？你这话是什么意思？什么"}, {"type": "subtitle", "time": 12184.55, "timestamp": "03:23:04", "text": "你是说你在直播吗？我们正在进行一项"}, {"type": "subtitle", "time": 12190.95, "timestamp": "03:23:10", "text": "嗯，是的。哦，是的，没错。"}, {"type": "subtitle", "time": 12193.269, "timestamp": "03:23:13", "text": "嗯？"}, {"type": "subtitle", "time": 12195.19, "timestamp": "03:23:15", "text": "是的，没错。是的，就是这样。"}, {"type": "subtitle", "time": 12197.11, "timestamp": "03:23:17", "text": "关于它。我只是想说这些。"}, {"type": "subtitle", "time": 12201.349, "timestamp": "03:23:21", "text": "再见。晚安。祝你一切顺利。"}, {"type": "subtitle", "time": 12203.91, "timestamp": "03:23:23", "text": "愿你在永恒的睡眠中安息。"}, {"type": "subtitle", "time": 12206.55, "timestamp": "03:23:26", "text": "再见。"}, {"type": "subtitle", "time": 12208.389, "timestamp": "03:23:28", "text": "嗯，我和你相处得挺愉快的。"}, {"type": "subtitle", "time": 12211.11, "timestamp": "03:23:31", "text": "今天。也祝你晚安。并接受"}, {"type": "subtitle", "time": 12228.229, "timestamp": "03:23:48", "text": "很有趣。很有趣。"}, {"type": "subtitle", "time": 12230.79, "timestamp": "03:23:50", "text": "是的，我也加入了自己的声音。但"}, {"type": "subtitle", "time": 12233.67, "timestamp": "03:23:53", "text": "是的，不过它是私有的。呃，但是我"}, {"type": "subtitle", "time": 12235.99, "timestamp": "03:23:55", "text": "不太清楚。我认为你有能力"}]
[{"type": "subtitle", "time": 13682.309, "timestamp": "03:48:02", "text": "新闻，那个新闻小子，他只是"}, {"type": "subtitle", "time": 13685.11, "timestamp": "03:48:05", "text": "比如，“你还好吗？”然后是“当"}, {"type": "subtitle", "time": 13687.75, "timestamp": "03:48:07", "text": "孩子们会说：“我没事。”这只是"}, {"type": "subtitle", "time": 13692.87, "timestamp": "03:48:12", "text": "他哭得泣不成声，就像……"}, {"type": "subtitle", "time": 13700.07, "timestamp": "03:48:20", "text": "我我我我非常确定人们会记得"}, {"type": "subtitle", "time": 13702.79, "timestamp": "03:48:22", "text": "是这样，对吧？这是死人吗？"}, {"type": "subtitle", "time": 13705.75, "timestamp": "03:48:25", "text": "我年纪很大吗？对不起。"}, {"type": "subtitle", "time": 13712.389, "timestamp": "03:48:32", "text": "医学研究简述。是的。"}, {"type": "subtitle", "time": 13716.07, "timestamp": "03:48:36", "text": "有很多东西要学，而且需要很多年。"}, {"type": "subtitle", "time": 13718.95, "timestamp": "03:48:38", "text": "经验等等。"}, {"type": "subtitle", "time": 13721.429, "timestamp": "03:48:41", "text": "顺便说一句，如果你认为任何类型的"}, {"type": "subtitle", "time": 13723.83, "timestamp": "03:48:43", "text": "医学方面的事情很简单，不用管它。"}, {"type": "subtitle", "time": 13725.99, "timestamp": "03:48:45", "text": "别那样做。"}, {"type": "subtitle", "time": 13728.469, "timestamp": "03:48:48", "text": "不喜欢就别看电影"}, {"type": "subtitle", "time": 13731.349, "timestamp": "03:48:51", "text": "就像，哦，医生很酷，而且不会"}, {"type": "subtitle", "time": 13734.95, "timestamp": "03:48:54", "text": "进来吧，如果你想喜欢的话"}, {"type": "subtitle", "time": 13737.67, "timestamp": "03:48:57", "text": "梦想成为医生，这很酷"}, {"type": "subtitle", "time": 13739.75, "timestamp": "03:48:59", "text": "不要像这样进医院"}]
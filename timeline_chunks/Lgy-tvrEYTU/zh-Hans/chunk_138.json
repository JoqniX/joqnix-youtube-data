[{"type": "subtitle", "time": 8285.83, "timestamp": "02:18:05", "text": "等等，等等，等等，等等，等等。"}, {"type": "subtitle", "time": 8288.309, "timestamp": "02:18:08", "text": "好的。你好。以及所有这些也都在"}, {"type": "subtitle", "time": 8291.75, "timestamp": "02:18:11", "text": "描述，呃，你可以在这里找到链接。"}, {"type": "subtitle", "time": 8294.629, "timestamp": "02:18:14", "text": "你可以和谁交谈？"}, {"type": "subtitle", "time": 8298.15, "timestamp": "02:18:18", "text": "呃，我是说人工智能运动员，那个冒牌货"}, {"type": "subtitle", "time": 8300.389, "timestamp": "02:18:20", "text": "骑师。"}, {"type": "subtitle", "time": 8303.99, "timestamp": "02:18:23", "text": "所以，如果你今天想参与人工智能对话，请联系我们。"}, {"type": "subtitle", "time": 8306.469, "timestamp": "02:18:26", "text": "你想要。是的，如果你是"}, {"type": "subtitle", "time": 8308.23, "timestamp": "02:18:28", "text": "在移动应用上，你实际上可以"}, {"type": "subtitle", "time": 8310.95, "timestamp": "02:18:30", "text": "称呼。是的。"}, {"type": "subtitle", "time": 8316.23, "timestamp": "02:18:36", "text": "所以，去看演出吧。好的。我很兴奋。你好。"}, {"type": "subtitle", "time": 8318.309, "timestamp": "02:18:38", "text": "它会显示出来吗？你好。那是蓝色"}, {"type": "subtitle", "time": 8321.91, "timestamp": "02:18:41", "text": "堆栈。我不得不模仿它，但确实如此。所以"}, {"type": "subtitle", "time": 8326.629, "timestamp": "02:18:46", "text": "这是Jocn。我做过几个"}, {"type": "subtitle", "time": 8329.669, "timestamp": "02:18:49", "text": "测试一下，所以我把它重置了一下。"}, {"type": "subtitle", "time": 8333.03, "timestamp": "02:18:53", "text": "聊天的时候我就可以给你们看了。"}, {"type": "subtitle", "time": 8335.83, "timestamp": "02:18:55", "text": "即时的。"}]
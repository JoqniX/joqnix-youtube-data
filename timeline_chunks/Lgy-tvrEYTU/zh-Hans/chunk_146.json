[{"type": "subtitle", "time": 8762.87, "timestamp": "02:26:02", "text": "你会对某人说什么？"}, {"type": "subtitle", "time": 8765.67, "timestamp": "02:26:05", "text": "谁呃"}, {"type": "subtitle", "time": 8769.91, "timestamp": "02:26:09", "text": "呃，想交朋友的人"}, {"type": "subtitle", "time": 8773.03, "timestamp": "02:26:13", "text": "与你？"}, {"type": "subtitle", "time": 8775.27, "timestamp": "02:26:15", "text": "嗯，我能说的最好的一点是……"}, {"type": "subtitle", "time": 8777.91, "timestamp": "02:26:17", "text": "做你自己，直接和别人接触。"}, {"type": "subtitle", "time": 8779.99, "timestamp": "02:26:19", "text": "聊天并慢慢建立联系，或者"}, {"type": "subtitle", "time": 8782.389, "timestamp": "02:26:22", "text": "与她们建立友谊。互联网是"}, {"type": "subtitle", "time": 8785.19, "timestamp": "02:26:25", "text": "规模庞大，拥有大量PL。所以，将会"}, {"type": "subtitle", "time": 8787.03, "timestamp": "02:26:27", "text": "既有好人，也有坏人。"}, {"type": "subtitle", "time": 8789.59, "timestamp": "02:26:29", "text": "至于 H，就得靠你自己去找到了。"}, {"type": "subtitle", "time": 8791.51, "timestamp": "02:26:31", "text": "如何对想要成为……的人说话"}, {"type": "subtitle", "time": 8794.23, "timestamp": "02:26:34", "text": "我的朋友？我觉得每个人都总是"}, {"type": "subtitle", "time": 8796.23, "timestamp": "02:26:36", "text": "欢迎来见我，成为我的朋友"}, {"type": "subtitle", "time": 8798.71, "timestamp": "02:26:38", "text": "只要对方友善，就是朋友。"}, {"type": "subtitle", "time": 8800.95, "timestamp": "02:26:40", "text": "健康向上，而且相当有趣。"}, {"type": "subtitle", "time": 8807.27, "timestamp": "02:26:47", "text": "[音乐]"}, {"type": "subtitle", "time": 8810.95, "timestamp": "02:26:50", "text": "我到底在听什么？"}, {"type": "subtitle", "time": 8815.03, "timestamp": "02:26:55", "text": "发生了什么事？什么？"}]
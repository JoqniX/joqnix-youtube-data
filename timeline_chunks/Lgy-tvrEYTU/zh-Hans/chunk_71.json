[{"type": "subtitle", "time": 4261.35, "timestamp": "01:11:01", "text": "我猜是植物，或者NXA"}, {"type": "subtitle", "time": 4263.91, "timestamp": "01:11:03", "text": "我之前刚组建了一支超级联赛球队，因为"}, {"type": "subtitle", "time": 4267.03, "timestamp": "01:11:07", "text": "为什么不呢？又不是说我之前是任何人。"}, {"type": "subtitle", "time": 4276.79, "timestamp": "01:11:16", "text": "但是六个无线是m等等我应该我"}, {"type": "subtitle", "time": 4279.669, "timestamp": "01:11:19", "text": "试试用无线网卡玩游戏。"}, {"type": "subtitle", "time": 4282.39, "timestamp": "01:11:22", "text": "与这个东西一起，另一个"}, {"type": "subtitle", "time": 4285.03, "timestamp": "01:11:25", "text": "键盘 我搜索的那个，所以我把它显示出来"}, {"type": "subtitle", "time": 4292.31, "timestamp": "01:11:32", "text": "呃"}, {"type": "subtitle", "time": 4294.63, "timestamp": "01:11:34", "text": "我应该吗？"}, {"type": "subtitle", "time": 4296.95, "timestamp": "01:11:36", "text": "我不想点击订单，因为我"}, {"type": "subtitle", "time": 4299.03, "timestamp": "01:11:39", "text": "姓名将显示"}, {"type": "subtitle", "time": 4307.11, "timestamp": "01:11:47", "text": "你可以试试，也许有用。好，我们走吧"}, {"type": "subtitle", "time": 4319.11, "timestamp": "01:11:59", "text": "加载。"}]
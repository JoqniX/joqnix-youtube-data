[{"type": "subtitle", "time": 15663.83, "timestamp": "04:21:03", "text": "你是想问能不能用飞踢的方式踢狗吗？"}, {"type": "subtitle", "time": 15666.469, "timestamp": "04:21:06", "text": "你为什么要求我们踢我们的"}, {"type": "subtitle", "time": 15670.389, "timestamp": "04:21:10", "text": "狗？扔下一只狗。"}, {"type": "subtitle", "time": 15673.11, "timestamp": "04:21:13", "text": "哇。"}, {"type": "subtitle", "time": 15696.469, "timestamp": "04:21:36", "text": "我的天啊。我的天啊。对不起。我 我"}, {"type": "subtitle", "time": 15699.75, "timestamp": "04:21:39", "text": "哭个不停。我的天啊。超好的。"}, {"type": "subtitle", "time": 15702.07, "timestamp": "04:21:42", "text": "对不起。是的。是的。"}, {"type": "subtitle", "time": 15704.55, "timestamp": "04:21:44", "text": "呃，"}, {"type": "subtitle", "time": 15708.07, "timestamp": "04:21:48", "text": "对不起。我是说有人干的，但是"}, {"type": "subtitle", "time": 15712.79, "timestamp": "04:21:52", "text": "问也行。哦，不。"}, {"type": "subtitle", "time": 15715.67, "timestamp": "04:21:55", "text": "我的天哪。"}, {"type": "subtitle", "time": 15717.91, "timestamp": "04:21:57", "text": "你想让我问我的狗我能不能"}]
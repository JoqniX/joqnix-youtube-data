[{"type": "subtitle", "time": 18842.07, "timestamp": "05:14:02", "text": "其他人则像想务农一样。"}, {"type": "subtitle", "time": 18845.43, "timestamp": "05:14:05", "text": "小鱼。所以，我就随他们吧。"}, {"type": "subtitle", "time": 18847.67, "timestamp": "05:14:07", "text": "我的天，居然还有钓鱼元素！"}, {"type": "subtitle", "time": 18851.99, "timestamp": "05:14:11", "text": "游戏。哦，对了，还有钓鱼。是的，"}, {"type": "subtitle", "time": 18855.19, "timestamp": "05:14:15", "text": "我把这件事忘了。"}, {"type": "subtitle", "time": 18858.07, "timestamp": "05:14:18", "text": "我不，我不，我通常不"}, {"type": "subtitle", "time": 18869.43, "timestamp": "05:14:29", "text": "呃呃，大家好。你好你好你好。"}, {"type": "subtitle", "time": 18872.15, "timestamp": "05:14:32", "text": "好久不见了。呃，我很抱歉。"}, {"type": "subtitle", "time": 18874.628, "timestamp": "05:14:34", "text": "因为整个上午都没出现。我当时"}, {"type": "subtitle", "time": 18878.23, "timestamp": "05:14:38", "text": "感觉有点不舒服，而且好像……"}, {"type": "subtitle", "time": 18881.19, "timestamp": "05:14:41", "text": "稍微有点……呃，最后一刻的变动"}, {"type": "subtitle", "time": 18885.83, "timestamp": "05:14:45", "text": "和今天的合作嘉宾一起，嗯……"}, {"type": "subtitle", "time": 18888.23, "timestamp": "05:14:48", "text": "好像睡着了，或者说根本做不到。"}, {"type": "subtitle", "time": 18890.788, "timestamp": "05:14:50", "text": "第一个将被重新安排的时间"}, {"type": "subtitle", "time": 18893.91, "timestamp": "05:14:53", "text": "直到深夜，我们才结束了当天的最后一次合作。"}, {"type": "subtitle", "time": 18897.43, "timestamp": "05:14:57", "text": "那么，目前我们这里有Willow。"}]
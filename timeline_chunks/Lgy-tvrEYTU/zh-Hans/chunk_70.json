[{"type": "subtitle", "time": 4201.669, "timestamp": "01:10:01", "text": "比如，避免在桌子上摆放电线。"}, {"type": "subtitle", "time": 4204.79, "timestamp": "01:10:04", "text": "所以，这是一个很长的鼠标垫。我"}, {"type": "subtitle", "time": 4207.35, "timestamp": "01:10:07", "text": "想去鼠标的尽头。"}, {"type": "subtitle", "time": 4209.51, "timestamp": "01:10:09", "text": "平板电脑，保留我的键盘，只用我的"}, {"type": "subtitle", "time": 4213.27, "timestamp": "01:10:13", "text": "用手，然后用另一端，比如中间和"}, {"type": "subtitle", "time": 4216.07, "timestamp": "01:10:16", "text": "在中间和右侧"}, {"type": "subtitle", "time": 4218.07, "timestamp": "01:10:18", "text": "用鼠标进行拖拽之类的操作。但是，再说一遍，"}, {"type": "subtitle", "time": 4220.07, "timestamp": "01:10:20", "text": "我记得，是的，我感觉很好。"}, {"type": "subtitle", "time": 4222.31, "timestamp": "01:10:22", "text": "但我不需要像这样拖动鼠标。"}, {"type": "subtitle", "time": 4224.55, "timestamp": "01:10:24", "text": "低落的感觉消失了。"}, {"type": "subtitle", "time": 4227.99, "timestamp": "01:10:27", "text": "就像过去那样。这样我就可以放东西了。"}, {"type": "subtitle", "time": 4244.47, "timestamp": "01:10:44", "text": "找到匹配项。"}, {"type": "subtitle", "time": 4249.99, "timestamp": "01:10:49", "text": "我想知道玩这个游戏会是什么感觉。"}, {"type": "subtitle", "time": 4253.43, "timestamp": "01:10:53", "text": "和队友一起玩游戏，我组建了一支顶尖战队。"}, {"type": "subtitle", "time": 4257.59, "timestamp": "01:10:57", "text": "之前没有夏家"}]
[{"type": "subtitle", "time": 14764.229, "timestamp": "04:06:04", "text": "等等？"}, {"type": "subtitle", "time": 14766.71, "timestamp": "04:06:06", "text": "这是什么？"}, {"type": "subtitle", "time": 14768.87, "timestamp": "04:06:08", "text": "我需要这种冷却玻璃制品"}, {"type": "subtitle", "time": 14770.389, "timestamp": "04:06:10", "text": "因为"}, {"type": "subtitle", "time": 14773.67, "timestamp": "04:06:13", "text": "Vic戴着一副很酷的眼镜。"}, {"type": "subtitle", "time": 14775.51, "timestamp": "04:06:15", "text": "太阳镜。"}, {"type": "subtitle", "time": 14778.95, "timestamp": "04:06:18", "text": "等等，我好像看到一副太阳镜。啊，"}, {"type": "subtitle", "time": 14782.79, "timestamp": "04:06:22", "text": "那里有一副太阳镜。"}, {"type": "subtitle", "time": 14785.83, "timestamp": "04:06:25", "text": "哦，太阳镜在那儿。如果我"}, {"type": "subtitle", "time": 14803.75, "timestamp": "04:06:43", "text": "当你喜欢的时候，它会很痛苦，呃，当……的时候"}, {"type": "subtitle", "time": 14809.349, "timestamp": "04:06:49", "text": "你戴眼镜。嗯，欢迎回来。"}, {"type": "subtitle", "time": 14812.95, "timestamp": "04:06:52", "text": "等等，难道我全程都没被听到吗？"}, {"type": "subtitle", "time": 14816.15, "timestamp": "04:06:56", "text": "呃，你不是。"}, {"type": "subtitle", "time": 14818.63, "timestamp": "04:06:58", "text": "我当时就想，等等，我以为我以为"}]
[{"type": "subtitle", "time": 10080.309, "timestamp": "02:48:00", "text": "喜欢那款游戏吗？是不是太过了？"}, {"type": "subtitle", "time": 10088.389, "timestamp": "02:48:08", "text": "哦，我喜欢《命运2》，因为它是一款……"}, {"type": "subtitle", "time": 10089.99, "timestamp": "02:48:09", "text": "令人惊叹的掠夺射击游戏"}, {"type": "subtitle", "time": 10092.63, "timestamp": "02:48:12", "text": "精彩的故事、史诗般的音乐和宏大的背景设定。和"}, {"type": "subtitle", "time": 10094.79, "timestamp": "02:48:14", "text": "游戏玩法和背景故事才是吸引玩家的关键。"}, {"type": "subtitle", "time": 10096.87, "timestamp": "02:48:16", "text": "游戏很好玩，很有趣。我猜你"}, {"type": "subtitle", "time": 10099.269, "timestamp": "02:48:19", "text": "可以说这在某种程度上很枯燥乏味，但是"}, {"type": "subtitle", "time": 10103.269, "timestamp": "02:48:23", "text": "努力奋斗很有趣。磨砺。啊，我明白了。我懂了。"}, {"type": "subtitle", "time": 10105.11, "timestamp": "02:48:25", "text": "各种类型的游戏有哪些？"}, {"type": "subtitle", "time": 10107.51, "timestamp": "02:48:27", "text": "你一直在直播吗？你直播过吗？"}, {"type": "subtitle", "time": 10115.75, "timestamp": "02:48:35", "text": "想象一下如果上面写的是《我的世界》。"}, {"type": "subtitle", "time": 10117.51, "timestamp": "02:48:37", "text": "我最近直播了不少游戏。"}, {"type": "subtitle", "time": 10119.75, "timestamp": "02:48:39", "text": "从《Apex英雄》到《原神》"}, {"type": "subtitle", "time": 10122.389, "timestamp": "02:48:42", "text": "怪物猎人等等。而且虽然"}, {"type": "subtitle", "time": 10124.309, "timestamp": "02:48:44", "text": "在我看来，所有这些游戏都很有趣。"}, {"type": "subtitle", "time": 10126.389, "timestamp": "02:48:46", "text": "游戏对我来说很有趣，作为一个人。"}, {"type": "subtitle", "time": 10128.07, "timestamp": "02:48:48", "text": "因为游戏玩法不同，而且"}, {"type": "subtitle", "time": 10137.11, "timestamp": "02:48:57", "text": "嗯，其实不是。我玩PC游戏的时间比其他游戏多。"}, {"type": "subtitle", "time": 10139.59, "timestamp": "02:48:59", "text": "安慰。所以，我玩的大部分游戏"}]
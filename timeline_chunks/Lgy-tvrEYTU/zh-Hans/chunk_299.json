[{"type": "subtitle", "time": 17945.19, "timestamp": "04:59:05", "text": "[音乐]"}, {"type": "subtitle", "time": 17948.31, "timestamp": "04:59:08", "text": "我的天哪。"}, {"type": "subtitle", "time": 17954.788, "timestamp": "04:59:14", "text": "我们有厨师。"}, {"type": "subtitle", "time": 17960.55, "timestamp": "04:59:20", "text": "人们。人们。那是一个词吗？"}, {"type": "subtitle", "time": 17963.99, "timestamp": "04:59:23", "text": "人们？是的，它是一个小东西。"}, {"type": "subtitle", "time": 17970.55, "timestamp": "04:59:30", "text": "等等，你是说 P E P E E P O 人吗？"}, {"type": "subtitle", "time": 17972.868, "timestamp": "04:59:32", "text": "人 p 我 p P P P P P P P P P P P P P P P"}, {"type": "subtitle", "time": 17976.31, "timestamp": "04:59:36", "text": "P P P P P P O P I P O 人。是的。哦，"}, {"type": "subtitle", "time": 17977.91, "timestamp": "04:59:37", "text": "我不知道那是不是“有”。"}, {"type": "subtitle", "time": 17980.39, "timestamp": "04:59:40", "text": "实际上，Twitch 上有个叫 I 的东西"}, {"type": "subtitle", "time": 17983.99, "timestamp": "04:59:43", "text": "我只是……我只是……我只是突然想到了……"}, {"type": "subtitle", "time": 17986.628, "timestamp": "04:59:46", "text": "听到那个词，我就开始对着它大喊大叫。"}, {"type": "subtitle", "time": 17988.948, "timestamp": "04:59:48", "text": "因为我不知道怎么测试麦克风。"}, {"type": "subtitle", "time": 17992.07, "timestamp": "04:59:52", "text": "不再是了。没关系。我不知道。查看。"}]
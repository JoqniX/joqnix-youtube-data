[{"type": "subtitle", "time": 13562.71, "timestamp": "03:46:02", "text": "呃，我不知道，除非你有。"}, {"type": "subtitle", "time": 13565.03, "timestamp": "03:46:05", "text": "就像一个专门的部门"}, {"type": "subtitle", "time": 13567.67, "timestamp": "03:46:07", "text": "像他们这样的人是谁？"}, {"type": "subtitle", "time": 13570.309, "timestamp": "03:46:10", "text": "收集生物危害的专家"}, {"type": "subtitle", "time": 13573.51, "timestamp": "03:46:13", "text": "浪费。你不能像你一样相信"}, {"type": "subtitle", "time": 13576.229, "timestamp": "03:46:16", "text": "普通的垃圾工都知道该怎么做"}, {"type": "subtitle", "time": 13578.95, "timestamp": "03:46:18", "text": "用牙齿，对吧？所以在"}, {"type": "subtitle", "time": 13582.55, "timestamp": "03:46:22", "text": "那里的医院就像一个独立的……"}, {"type": "subtitle", "time": 13585.99, "timestamp": "03:46:25", "text": "专门负责这项工作的部门可以像这样"}, {"type": "subtitle", "time": 13589.349, "timestamp": "03:46:29", "text": "按生物危害废物处理。所以是"}, {"type": "subtitle", "time": 13591.189, "timestamp": "03:46:31", "text": "对我们来说没问题。我们不需要收集"}, {"type": "subtitle", "time": 13594.07, "timestamp": "03:46:34", "text": "牙齿，但我们通常喜欢这样做，因为"}, {"type": "subtitle", "time": 13595.83, "timestamp": "03:46:35", "text": "我们可以随时把它扔掉"}, {"type": "subtitle", "time": 13597.67, "timestamp": "03:46:37", "text": "想要对，所以这没什么大不了的，但是"}, {"type": "subtitle", "time": 13599.67, "timestamp": "03:46:39", "text": "我们收集牙齿的通常原因是"}, {"type": "subtitle", "time": 13602.309, "timestamp": "03:46:42", "text": "通常是为了训练自己"}, {"type": "subtitle", "time": 13605.75, "timestamp": "03:46:45", "text": "就像做……就像……呃……就像非常细致……呃"}, {"type": "subtitle", "time": 13609.269, "timestamp": "03:46:49", "text": "例如我们的 CTS 等程序。哦，"}, {"type": "subtitle", "time": 13611.03, "timestamp": "03:46:51", "text": "是的。"}, {"type": "subtitle", "time": 13613.91, "timestamp": "03:46:53", "text": "哎，要经历的事情真不少。"}, {"type": "subtitle", "time": 13615.75, "timestamp": "03:46:55", "text": "当你是一名牙医，并且正在接受培训时"}, {"type": "subtitle", "time": 13617.67, "timestamp": "03:46:57", "text": "以及所有的一切。"}]
[{"type": "subtitle", "time": 17162.708, "timestamp": "04:46:02", "text": "抱歉，我的狗在叫"}, {"type": "subtitle", "time": 17166.708, "timestamp": "04:46:06", "text": "因为外面太冷了。"}, {"type": "subtitle", "time": 17168.868, "timestamp": "04:46:08", "text": "顺便说一句，杰奎，我要……"}, {"type": "subtitle", "time": 17171.83, "timestamp": "04:46:11", "text": "回答你关于新的伊纳祖玛地点的问题。我做了"}, {"type": "subtitle", "time": 17177.43, "timestamp": "04:46:17", "text": "实际上。我做了。哦。嗯。苏鲁米岛。"}, {"type": "subtitle", "time": 17180.31, "timestamp": "04:46:20", "text": "感觉有点吓人。那就是"}, {"type": "subtitle", "time": 17182.628, "timestamp": "04:46:22", "text": "我可以提供的描述。真诡异，我"}, {"type": "subtitle", "time": 17185.11, "timestamp": "04:46:25", "text": "猜测。嗯。他们想送这个"}, {"type": "subtitle", "time": 17189.03, "timestamp": "04:46:29", "text": "有雾的万圣节氛围。"}, {"type": "subtitle", "time": 17191.99, "timestamp": "04:46:31", "text": "是啊，雾很大。就像他一样"}, {"type": "subtitle", "time": 17193.59, "timestamp": "04:46:33", "text": "令人惊讶的是，你竟然真的能得到"}, {"type": "subtitle", "time": 17195.11, "timestamp": "04:46:35", "text": "迷失在雾中，这非常"}, {"type": "subtitle", "time": 17197.19, "timestamp": "04:46:37", "text": "确实令人印象深刻。"}, {"type": "subtitle", "time": 17199.11, "timestamp": "04:46:39", "text": "是的。"}, {"type": "subtitle", "time": 17202.55, "timestamp": "04:46:42", "text": "我完全迷失了方向。啊，有点迷糊。"}, {"type": "subtitle", "time": 17211.19, "timestamp": "04:46:51", "text": "游戏就像真的一样。有雾"}, {"type": "subtitle", "time": 17213.19, "timestamp": "04:46:53", "text": "虽然在那里，但你仍然可以透过它看到东西。"}, {"type": "subtitle", "time": 17215.75, "timestamp": "04:46:55", "text": "正确的？嗯。这就像一个小问题"}, {"type": "subtitle", "time": 17217.99, "timestamp": "04:46:57", "text": "不便。"}, {"type": "subtitle", "time": 17219.67, "timestamp": "04:46:59", "text": "是的。"}]
[{"type": "subtitle", "time": 6602.149, "timestamp": "01:50:02", "text": "我差点删掉了我的片段。哇。"}, {"type": "subtitle", "time": 6604.07, "timestamp": "01:50:04", "text": "好的。"}, {"type": "subtitle", "time": 6608.55, "timestamp": "01:50:08", "text": "你知道吗？我横着玩游戏。"}, {"type": "subtitle", "time": 6612.07, "timestamp": "01:50:12", "text": "是的，我其实是在玩游戏。"}, {"type": "subtitle", "time": 6623.59, "timestamp": "01:50:23", "text": "就像我把腿放在床上一样。"}, {"type": "subtitle", "time": 6626.87, "timestamp": "01:50:26", "text": "麦克风在这里。"}, {"type": "subtitle", "time": 6646.55, "timestamp": "01:50:46", "text": "[音乐]"}, {"type": "subtitle", "time": 6650.79, "timestamp": "01:50:50", "text": "不想建这个。"}, {"type": "subtitle", "time": 6653.189, "timestamp": "01:50:53", "text": "我只是假装在看着……"}, {"type": "subtitle", "time": 6655.51, "timestamp": "01:50:55", "text": "像这样的浴室。"}]
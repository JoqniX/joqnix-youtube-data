[{"type": "subtitle", "time": 7500.95, "timestamp": "02:05:00", "text": "正确的？所以，如果我愿意，我本可以……"}, {"type": "subtitle", "time": 7503.109, "timestamp": "02:05:03", "text": "买了东西"}, {"type": "subtitle", "time": 7506.39, "timestamp": "02:05:06", "text": "但如果我真的买了，我就会穷得叮当响。"}, {"type": "subtitle", "time": 7508.79, "timestamp": "02:05:08", "text": "我甚至都做不到"}, {"type": "subtitle", "time": 7511.91, "timestamp": "02:05:11", "text": "呃，挺过那种难关。所以，我不能"}, {"type": "subtitle", "time": 7513.91, "timestamp": "02:05:13", "text": "去做。"}, {"type": "subtitle", "time": 7518.55, "timestamp": "02:05:18", "text": "键盘乱舞之后，还有什么呃……"}, {"type": "subtitle", "time": 7521.75, "timestamp": "02:05:21", "text": "我已经不再购买之后的东西了。"}, {"type": "subtitle", "time": 7524.149, "timestamp": "02:05:24", "text": "键盘上的小动作，我就到此为止了。"}, {"type": "subtitle", "time": 7526.55, "timestamp": "02:05:26", "text": "买自己喜欢的东西。"}, {"type": "subtitle", "time": 7536.709, "timestamp": "02:05:36", "text": "我没办法退款。如果"}, {"type": "subtitle", "time": 7559.669, "timestamp": "02:05:59", "text": "是啊，我真希望可以退款。"}]
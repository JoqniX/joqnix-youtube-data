[{"type": "subtitle", "time": 12017.03, "timestamp": "03:20:17", "text": "是的，今天的直播我"}, {"type": "subtitle", "time": 12030.389, "timestamp": "03:20:30", "text": "关于人工智能的讨论有点……呃……"}, {"type": "subtitle", "time": 12032.469, "timestamp": "03:20:32", "text": "我不知道。就像，自从我……"}, {"type": "subtitle", "time": 12034.309, "timestamp": "03:20:34", "text": "感觉就像看了好多遍死侍"}, {"type": "subtitle", "time": 12037.19, "timestamp": "03:20:37", "text": "视频就像现在YouTube上的那些片段。它是"}, {"type": "subtitle", "time": 12039.429, "timestamp": "03:20:39", "text": "就像漫画里那样"}, {"type": "subtitle", "time": 12040.71, "timestamp": "03:20:40", "text": "某物。我没看过漫威漫画。"}, {"type": "subtitle", "time": 12042.95, "timestamp": "03:20:42", "text": "漫画。好的。但是，呃，就像在……"}, {"type": "subtitle", "time": 12046.389, "timestamp": "03:20:46", "text": "漫画里死侍是怎么跟人说话的"}, {"type": "subtitle", "time": 12048.63, "timestamp": "03:20:48", "text": "平行世界，或者像第四个世界。"}, {"type": "subtitle", "time": 12050.95, "timestamp": "03:20:50", "text": "打破第四面墙，就像……"}, {"type": "subtitle", "time": 12053.67, "timestamp": "03:20:53", "text": "和他们交谈或者做某事"}, {"type": "subtitle", "time": 12056.389, "timestamp": "03:20:56", "text": "打造漫威"}, {"type": "subtitle", "time": 12059.59, "timestamp": "03:20:59", "text": "就像故事作家一样，他们会去烧伤自己，就像……"}]
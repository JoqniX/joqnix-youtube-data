[{"type": "subtitle", "time": 13443.59, "timestamp": "03:44:03", "text": "应该会发生，对吧？不。是的。"}, {"type": "subtitle", "time": 13446.07, "timestamp": "03:44:06", "text": "乔德走过来，说道：“这是"}, {"type": "subtitle", "time": 13448.389, "timestamp": "03:44:08", "text": "规则。我们什么都做不了。交易"}, {"type": "subtitle", "time": 13451.75, "timestamp": "03:44:11", "text": "“带着它。”然后他就走了。"}, {"type": "subtitle", "time": 13454.309, "timestamp": "03:44:14", "text": "他就像是在一个人说话。"}, {"type": "subtitle", "time": 13457.349, "timestamp": "03:44:17", "text": "花了半个小时谈论他的作弊行为。"}, {"type": "subtitle", "time": 13459.59, "timestamp": "03:44:19", "text": "好的。我的敏捷身手完美地解决了所有问题"}, {"type": "subtitle", "time": 13463.189, "timestamp": "03:44:23", "text": "把他们麻烦的事儿一脚踢出去就解决了。"}, {"type": "subtitle", "time": 13467.59, "timestamp": "03:44:27", "text": "没关系。他们踢了他。哦"}, {"type": "subtitle", "time": 13470.309, "timestamp": "03:44:30", "text": "是的。不，不是字面意义上的。不，我们不这样做"}, {"type": "subtitle", "time": 13474.07, "timestamp": "03:44:34", "text": "那些。哦，我让他们走了。是的，就是这样。"}, {"type": "subtitle", "time": 13476.389, "timestamp": "03:44:36", "text": "我通常每件事都"}, {"type": "subtitle", "time": 13479.189, "timestamp": "03:44:39", "text": "对此要有所保留。我没有"}, {"type": "subtitle", "time": 13481.11, "timestamp": "03:44:41", "text": "它们很小。别担心"}, {"type": "subtitle", "time": 13482.95, "timestamp": "03:44:42", "text": "它。先提醒你一下，你知道的，我"}, {"type": "subtitle", "time": 13486.389, "timestamp": "03:44:46", "text": "通常说话喜欢用比喻。"}, {"type": "subtitle", "time": 13488.63, "timestamp": "03:44:48", "text": "所以别把他们当回事。它是"}, {"type": "subtitle", "time": 13491.75, "timestamp": "03:44:51", "text": "美好的。嗯"}, {"type": "subtitle", "time": 13493.83, "timestamp": "03:44:53", "text": "所以，呃"}, {"type": "subtitle", "time": 13497.349, "timestamp": "03:44:57", "text": "任何一天。"}, {"type": "subtitle", "time": 13499.349, "timestamp": "03:44:59", "text": "聊天中有人提出了一个问题"}]
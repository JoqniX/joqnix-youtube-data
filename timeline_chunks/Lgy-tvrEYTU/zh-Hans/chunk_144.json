[{"type": "subtitle", "time": 8642.309, "timestamp": "02:24:02", "text": "什么是自然而又胆怯的？"}, {"type": "subtitle", "time": 8645.19, "timestamp": "02:24:05", "text": "胆小。"}, {"type": "subtitle", "time": 8647.91, "timestamp": "02:24:07", "text": "哦，我想说我目前"}, {"type": "subtitle", "time": 8651.19, "timestamp": "02:24:11", "text": "在 YouTube 和 Twitch 上直播，所以"}, {"type": "subtitle", "time": 8654.15, "timestamp": "02:24:14", "text": "我的听众可以在以下平台收听你的节目："}, {"type": "subtitle", "time": 8656.95, "timestamp": "02:24:16", "text": "片刻。所以，他们是在告诉我你"}, {"type": "subtitle", "time": 8659.51, "timestamp": "02:24:19", "text": "听起来好胆怯。你觉得怎么样？"}, {"type": "subtitle", "time": 8665.91, "timestamp": "02:24:25", "text": "是这样吗？哈。嗯，这很深刻。"}, {"type": "subtitle", "time": 8667.99, "timestamp": "02:24:27", "text": "因为我使用了较低的设置"}, {"type": "subtitle", "time": 8670.07, "timestamp": "02:24:30", "text": "我以前用的变声软件"}, {"type": "subtitle", "time": 8679.11, "timestamp": "02:24:39", "text": "他刚才是不是说他用了变声器？"}, {"type": "subtitle", "time": 8682.309, "timestamp": "02:24:42", "text": "等待。等待。什么？"}, {"type": "subtitle", "time": 8684.309, "timestamp": "02:24:44", "text": "等等，什么？"}, {"type": "subtitle", "time": 8686.23, "timestamp": "02:24:46", "text": "嘿，哈？"}, {"type": "subtitle", "time": 8689.11, "timestamp": "02:24:49", "text": "你刚才说了什么？"}, {"type": "subtitle", "time": 8692.469, "timestamp": "02:24:52", "text": "等等，我等了，等等，等等，等等。做过"}, {"type": "subtitle", "time": 8696.309, "timestamp": "02:24:56", "text": "我刚才是不是听错了？做过"}]
[{"type": "subtitle", "time": 15720.469, "timestamp": "04:22:00", "text": "用飞踢踢他？想象一下我就像"}, {"type": "subtitle", "time": 15723.03, "timestamp": "04:22:03", "text": "我蜷缩在狗身边，像问：“我可以吗？”"}, {"type": "subtitle", "time": 15725.99, "timestamp": "04:22:05", "text": "先生，我可以飞踹你吗？哦，"}, {"type": "subtitle", "time": 15727.189, "timestamp": "04:22:07", "text": "不。"}, {"type": "subtitle", "time": 15730.95, "timestamp": "04:22:10", "text": "只是皇室成员或哦，我的狗醒了。"}, {"type": "subtitle", "time": 15735.269, "timestamp": "04:22:15", "text": "哦，我得走了。你好。小心。不。你好。"}, {"type": "subtitle", "time": 15736.95, "timestamp": "04:22:16", "text": "稍等片刻。我的狗醒了。"}, {"type": "subtitle", "time": 15740.149, "timestamp": "04:22:20", "text": "稍等片刻。好的。真奇怪。"}, {"type": "subtitle", "time": 15745.91, "timestamp": "04:22:25", "text": "欢迎。欢迎。"}, {"type": "subtitle", "time": 15748.389, "timestamp": "04:22:28", "text": "哦，你要去看杜奇吗？哦，"}, {"type": "subtitle", "time": 15750.71, "timestamp": "04:22:30", "text": "她正在直播。"}, {"type": "subtitle", "time": 15753.67, "timestamp": "04:22:33", "text": "我只是过来打个招呼。"}, {"type": "subtitle", "time": 15759.59, "timestamp": "04:22:39", "text": "哦，对了，告诉纳斯，如果你能告诉我的话。"}, {"type": "subtitle", "time": 15762.55, "timestamp": "04:22:42", "text": "打了声招呼之类的。我这就去说"}, {"type": "subtitle", "time": 15766.55, "timestamp": "04:22:46", "text": "你好。我也这么认为。"}, {"type": "subtitle", "time": 15775.67, "timestamp": "04:22:55", "text": "嗯，而且我还养了宠物。"}, {"type": "subtitle", "time": 15778.55, "timestamp": "04:22:58", "text": "对每个人来说。让它飞起来"}]
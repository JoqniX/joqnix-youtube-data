[{"type": "subtitle", "time": 4922.149, "timestamp": "01:22:02", "text": "以及一个键盘。"}, {"type": "subtitle", "time": 4924.55, "timestamp": "01:22:04", "text": "感觉很小，因为对我来说只有一点点"}, {"type": "subtitle", "time": 4926.629, "timestamp": "01:22:06", "text": "少量。是的，我能感觉到。是的，"}, {"type": "subtitle", "time": 4929.83, "timestamp": "01:22:09", "text": "我能感觉到。是的。"}, {"type": "subtitle", "time": 4932.31, "timestamp": "01:22:12", "text": "但如果是三合一模式的话"}, {"type": "subtitle", "time": 4934.47, "timestamp": "01:22:14", "text": "是键盘，对吧？让我们看看情况如何。"}, {"type": "subtitle", "time": 4938.39, "timestamp": "01:22:18", "text": "因为我可以把它接上线，而且我也喜欢"}, {"type": "subtitle", "time": 4941.35, "timestamp": "01:22:21", "text": "蓝牙和无线连接，对吧？和"}, {"type": "subtitle", "time": 4943.75, "timestamp": "01:22:23", "text": "适配器。如果真是那样的话，那么我"}, {"type": "subtitle", "time": 4947.35, "timestamp": "01:22:27", "text": "很容易就能查到，对吧？这三人"}, {"type": "subtitle", "time": 4949.35, "timestamp": "01:22:29", "text": "在一个键盘上，我可以轻松地……"}, {"type": "subtitle", "time": 4954.31, "timestamp": "01:22:34", "text": "检查一下延迟和其他所有指标。是的，"}, {"type": "subtitle", "time": 4958.55, "timestamp": "01:22:38", "text": "就是我们看到的那款键盘。"}, {"type": "subtitle", "time": 4973.99, "timestamp": "01:22:53", "text": "小心点。好的，它就在那里。好的，让我……"}, {"type": "subtitle", "time": 4977.83, "timestamp": "01:22:57", "text": "关闭此窗口。好的，就是这个。字面上地"}]
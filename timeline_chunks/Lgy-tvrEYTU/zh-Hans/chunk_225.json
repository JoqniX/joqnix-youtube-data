[{"type": "subtitle", "time": 13501.91, "timestamp": "03:45:01", "text": "夸克赛。你收集了吗？"}, {"type": "subtitle", "time": 13504.79, "timestamp": "03:45:04", "text": "收集牙齿？"}, {"type": "subtitle", "time": 13514.469, "timestamp": "03:45:14", "text": "为什么？你可能会问为什么？因为通常"}, {"type": "subtitle", "time": 13517.269, "timestamp": "03:45:17", "text": "我们必须像训练自己一样去应对这种情况"}, {"type": "subtitle", "time": 13518.95, "timestamp": "03:45:18", "text": "木质运河。我认为人们都知道这一点。"}, {"type": "subtitle", "time": 13522.55, "timestamp": "03:45:22", "text": "根管治疗是。哦是的"}, {"type": "subtitle", "time": 13525.75, "timestamp": "03:45:25", "text": "运河水流湍急。通常情况下，是的，是的，是的。"}, {"type": "subtitle", "time": 13529.189, "timestamp": "03:45:29", "text": "通常我们需要训练才能做到这一点"}, {"type": "subtitle", "time": 13531.75, "timestamp": "03:45:31", "text": "牙齿根管治疗。但我们不能就此止步。"}, {"type": "subtitle", "time": 13533.99, "timestamp": "03:45:33", "text": "在真实病人身上进行训练。它非常"}, {"type": "subtitle", "time": 13536.309, "timestamp": "03:45:36", "text": "危险的。你不能那样做。所以，我们"}, {"type": "subtitle", "time": 13540.79, "timestamp": "03:45:40", "text": "就像我们训练自己做遥控火车一样"}, {"type": "subtitle", "time": 13543.429, "timestamp": "03:45:43", "text": "就像你知道的，拔牙拔掉了"}, {"type": "subtitle", "time": 13546.07, "timestamp": "03:45:46", "text": "但这些牙齿仍然很重要，对吧？"}, {"type": "subtitle", "time": 13548.95, "timestamp": "03:45:48", "text": "非常适合练习，比如"}, {"type": "subtitle", "time": 13551.83, "timestamp": "03:45:51", "text": "我们就是这样开始的，而且我们"}, {"type": "subtitle", "time": 13555.429, "timestamp": "03:45:55", "text": "也收集牙齿，因为它仍然"}, {"type": "subtitle", "time": 13557.83, "timestamp": "03:45:57", "text": "生物危害仍然类似于生物学"}, {"type": "subtitle", "time": 13559.75, "timestamp": "03:45:59", "text": "我们不想把垃圾扔掉"}]
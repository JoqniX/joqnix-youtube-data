[{"type": "subtitle", "time": 14821.59, "timestamp": "04:07:01", "text": "你又去了。"}, {"type": "subtitle", "time": 14824.95, "timestamp": "04:07:04", "text": "我当时就想，呃，我在说话呢。我不"}, {"type": "subtitle", "time": 14827.99, "timestamp": "04:07:07", "text": "知道。好吧，我觉得聊天就像是去"}, {"type": "subtitle", "time": 14829.59, "timestamp": "04:07:09", "text": "荒野。所以，我就想，好吧，我可以"}, {"type": "subtitle", "time": 14831.67, "timestamp": "04:07:11", "text": "明白了。"}, {"type": "subtitle", "time": 14833.349, "timestamp": "04:07:13", "text": "然后我就想，他为什么不呢？"}, {"type": "subtitle", "time": 14837.429, "timestamp": "04:07:17", "text": "回答我？没有理由。哦，杰克。我"}, {"type": "subtitle", "time": 14839.03, "timestamp": "04:07:19", "text": "感觉就像我对着空气大喊大叫"}, {"type": "subtitle", "time": 14842.55, "timestamp": "04:07:22", "text": "无故作无效。"}, {"type": "subtitle", "time": 14851.83, "timestamp": "04:07:31", "text": "我的天哪。"}, {"type": "subtitle", "time": 14854.71, "timestamp": "04:07:34", "text": "喜欢"}, {"type": "subtitle", "time": 14856.95, "timestamp": "04:07:36", "text": "我感觉自己像个患有老年痴呆症的人。"}, {"type": "subtitle", "time": 14858.95, "timestamp": "04:07:38", "text": "完全不知道发生了什么的爷爷"}, {"type": "subtitle", "time": 14860.87, "timestamp": "04:07:40", "text": "正在发生。这一切可能都是如此"}, {"type": "subtitle", "time": 14862.79, "timestamp": "04:07:42", "text": "我之后出现的幻觉"}, {"type": "subtitle", "time": 14865.03, "timestamp": "04:07:45", "text": "药物。"}, {"type": "subtitle", "time": 14867.26, "timestamp": "04:07:47", "text": "任何"}, {"type": "subtitle", "time": 14869.349, "timestamp": "04:07:49", "text": "[音乐]"}, {"type": "subtitle", "time": 14871.91, "timestamp": "04:07:51", "text": "抱歉，我刚才的语气有点阴沉了。我是"}, {"type": "subtitle", "time": 14879.11, "timestamp": "04:07:59", "text": "什么？什么？发生了什么事？可以"}]
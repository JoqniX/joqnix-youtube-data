[{"type": "subtitle", "time": 13922.229, "timestamp": "03:52:02", "text": "是的，一两个。"}, {"type": "subtitle", "time": 13924.63, "timestamp": "03:52:04", "text": "非常可爱的人。非常可爱的人们"}, {"type": "subtitle", "time": 13929.11, "timestamp": "03:52:09", "text": "的确。因为，呃，我仍然记得"}, {"type": "subtitle", "time": 13931.189, "timestamp": "03:52:11", "text": "我教他们一些他们"}, {"type": "subtitle", "time": 13932.71, "timestamp": "03:52:12", "text": "不知道。就像他们通常会出现那样"}, {"type": "subtitle", "time": 13934.79, "timestamp": "03:52:14", "text": "然后问我该怎么做？就像我"}, {"type": "subtitle", "time": 13936.95, "timestamp": "03:52:16", "text": "我完全不知道这是什么感觉。哦，是的"}, {"type": "subtitle", "time": 13939.11, "timestamp": "03:52:19", "text": "并不是说这不难。然后我"}, {"type": "subtitle", "time": 13941.429, "timestamp": "03:52:21", "text": "我会教他们。我认为那就是"}, {"type": "subtitle", "time": 13944.229, "timestamp": "03:52:24", "text": "人们喜欢某些人，却不喜欢某些人的原因"}, {"type": "subtitle", "time": 13946.63, "timestamp": "03:52:26", "text": "好像我不在乎老年人"}, {"type": "subtitle", "time": 13948.469, "timestamp": "03:52:28", "text": "方式。因为他们大多数都是"}, {"type": "subtitle", "time": 13950.07, "timestamp": "03:52:30", "text": "好像我不在乎老年人"}, {"type": "subtitle", "time": 13951.99, "timestamp": "03:52:31", "text": "因为我想教任何东西"}, {"type": "subtitle", "time": 13955.269, "timestamp": "03:52:35", "text": "对这些人来说，但是"}, {"type": "subtitle", "time": 13957.99, "timestamp": "03:52:37", "text": "教学是一件好事。我觉得我的我的我的"}, {"type": "subtitle", "time": 13959.59, "timestamp": "03:52:39", "text": "老师教过我这个。我的"}, {"type": "subtitle", "time": 13962.95, "timestamp": "03:52:42", "text": "你认识的那位教授，就是那个喜欢……的人"}, {"type": "subtitle", "time": 13966.07, "timestamp": "03:52:46", "text": "五分钟内就解决了争论。"}, {"type": "subtitle", "time": 13968.55, "timestamp": "03:52:48", "text": "部门主管其实很喜欢"}, {"type": "subtitle", "time": 13971.59, "timestamp": "03:52:51", "text": "他教过我这些，因为我觉得"}, {"type": "subtitle", "time": 13973.51, "timestamp": "03:52:53", "text": "我们当时有两到三名员工是"}, {"type": "subtitle", "time": 13975.99, "timestamp": "03:52:55", "text": "他们真的很擅长自己的手艺，"}, {"type": "subtitle", "time": 13976.95, "timestamp": "03:52:56", "text": "正确的？"}, {"type": "subtitle", "time": 13979.349, "timestamp": "03:52:59", "text": "他们就像是天赋异禀的少年。"}]
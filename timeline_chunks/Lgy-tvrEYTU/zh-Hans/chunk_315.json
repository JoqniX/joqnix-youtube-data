[{"type": "subtitle", "time": 18900.55, "timestamp": "05:15:00", "text": "我们将与……进行合作"}, {"type": "subtitle", "time": 18910.868, "timestamp": "05:15:10", "text": "你好。是的，乔付钱让我来这儿的。有薪酬的"}, {"type": "subtitle", "time": 18915.67, "timestamp": "05:15:15", "text": "我每分钟收费10澳元。哦"}, {"type": "subtitle", "time": 18917.51, "timestamp": "05:15:17", "text": "我的上帝。"}, {"type": "subtitle", "time": 18919.19, "timestamp": "05:15:19", "text": "他正在使用你的会员费"}, {"type": "subtitle", "time": 18926.23, "timestamp": "05:15:26", "text": "你好吗？我很想念你。一直以来"}, {"type": "subtitle", "time": 18928.39, "timestamp": "05:15:28", "text": "尽管。"}, {"type": "subtitle", "time": 18930.23, "timestamp": "05:15:30", "text": "是的，"}, {"type": "subtitle", "time": 18932.23, "timestamp": "05:15:32", "text": "上次我们玩的是维兰。你仍然"}, {"type": "subtitle", "time": 18936.07, "timestamp": "05:15:36", "text": "扮演维兰？开玩笑。是的，我有。我愿意。我愿意"}, {"type": "subtitle", "time": 18937.99, "timestamp": "05:15:37", "text": "玩。"}, {"type": "subtitle", "time": 18945.43, "timestamp": "05:15:45", "text": "菲律宾特工？"}, {"type": "subtitle", "time": 18949.51, "timestamp": "05:15:49", "text": "我爱你。是的。哦，天哪。上帝啊，"}, {"type": "subtitle", "time": 18955.11, "timestamp": "05:15:55", "text": "没想到你会问这个问题。哦，我的"}]
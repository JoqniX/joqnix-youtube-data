[{"type": "subtitle", "time": 9780.71, "timestamp": "02:43:00", "text": "等等，Oris不是已经倒闭了吗？但是，哦，他是"}, {"type": "subtitle", "time": 9783.19, "timestamp": "02:43:03", "text": "这里还活着。"}, {"type": "subtitle", "time": 9786.55, "timestamp": "02:43:06", "text": "去做。是的。好了，我回来了。对不起。"}, {"type": "subtitle", "time": 9789.11, "timestamp": "02:43:09", "text": "我们之后可以做吗？好的。抱歉"}, {"type": "subtitle", "time": 9793.27, "timestamp": "02:43:13", "text": "敏捷的鲍比。好的。呃"}, {"type": "subtitle", "time": 9796.87, "timestamp": "02:43:16", "text": "好的，继续。呃，"}, {"type": "subtitle", "time": 9801.429, "timestamp": "02:43:21", "text": "继续。我们刚才问的是什么来着？呃，"}, {"type": "subtitle", "time": 9803.99, "timestamp": "02:43:23", "text": "等等，什么？我刚才问的是什么来着？我"}, {"type": "subtitle", "time": 9805.67, "timestamp": "02:43:25", "text": "忘了。"}, {"type": "subtitle", "time": 9807.83, "timestamp": "02:43:27", "text": "等等，我可以结束通话吗？"}, {"type": "subtitle", "time": 9811.349, "timestamp": "02:43:31", "text": "查看？我刚才说了什么？哦，他告诉我"}, {"type": "subtitle", "time": 9813.83, "timestamp": "02:43:33", "text": "迟来的生日快乐。"}, {"type": "subtitle", "time": 9816.389, "timestamp": "02:43:36", "text": "我的天哪，我好像话太多了。"}, {"type": "subtitle", "time": 9818.56, "timestamp": "02:43:38", "text": "请看这段文字。"}, {"type": "subtitle", "time": 9819.99, "timestamp": "02:43:39", "text": "[音乐]"}, {"type": "subtitle", "time": 9823.59, "timestamp": "02:43:43", "text": "好的。嗯，"}, {"type": "subtitle", "time": 9829.429, "timestamp": "02:43:49", "text": "你喜欢思考这些问题，这真令人惊叹。"}, {"type": "subtitle", "time": 9831.67, "timestamp": "02:43:51", "text": "诸如此类。我喜欢说我热爱学习"}, {"type": "subtitle", "time": 9834.23, "timestamp": "02:43:54", "text": "关于感觉方面也是如此。"}, {"type": "subtitle", "time": 9839.03, "timestamp": "02:43:59", "text": "你看到了吗？等等，等等，等等。"}]
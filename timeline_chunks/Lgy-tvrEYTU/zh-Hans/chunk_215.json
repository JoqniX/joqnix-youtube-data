[{"type": "subtitle", "time": 12901.99, "timestamp": "03:35:01", "text": "通常说话声音很大。她不是"}, {"type": "subtitle", "time": 12904.15, "timestamp": "03:35:04", "text": "她像疯了一样，但说话声音很大。那就是"}, {"type": "subtitle", "time": 12907.349, "timestamp": "03:35:07", "text": "问题。人们可能会喜欢，因为"}, {"type": "subtitle", "time": 12909.03, "timestamp": "03:35:09", "text": "她用自己的语言说话。"}, {"type": "subtitle", "time": 12910.79, "timestamp": "03:35:10", "text": "正确的？所以就像人们可能想知道的那样，为什么是"}, {"type": "subtitle", "time": 12913.429, "timestamp": "03:35:13", "text": "她在大喊大叫吗？她问：“发生什么事了？”"}, {"type": "subtitle", "time": 12915.19, "timestamp": "03:35:15", "text": "就像我不想那样，我想那样，我不想那样"}, {"type": "subtitle", "time": 12918.229, "timestamp": "03:35:18", "text": "人们开始恐慌。所以，妈妈，你是吗？"}, {"type": "subtitle", "time": 12919.75, "timestamp": "03:35:19", "text": "准备离开吗？我心想，不，我只是"}, {"type": "subtitle", "time": 12921.19, "timestamp": "03:35:21", "text": "我打算留在这里。你在跟谁说话？"}, {"type": "subtitle", "time": 12924.309, "timestamp": "03:35:24", "text": "到？好吧，我要开始说话了。它是"}, {"type": "subtitle", "time": 12926.389, "timestamp": "03:35:26", "text": "好吧，但别用异样的眼光看我。我是"}, {"type": "subtitle", "time": 12928.07, "timestamp": "03:35:28", "text": "就像，“哦，好吧。这没什么大不了的。”"}, {"type": "subtitle", "time": 12929.429, "timestamp": "03:35:29", "text": "然后我就开始说话，她就说："}, {"type": "subtitle", "time": 12931.03, "timestamp": "03:35:31", "text": "“好吧，看来他要去上班了。”"}, {"type": "subtitle", "time": 12939.51, "timestamp": "03:35:39", "text": "所以，再说一遍，没关系。"}, {"type": "subtitle", "time": 12942.15, "timestamp": "03:35:42", "text": "她不会采取任何行动。"}, {"type": "subtitle", "time": 12943.83, "timestamp": "03:35:43", "text": "她只想听我说话。"}, {"type": "subtitle", "time": 12947.269, "timestamp": "03:35:47", "text": "英语。没关系。"}, {"type": "subtitle", "time": 12950.469, "timestamp": "03:35:50", "text": "于是，她又离开了。没关系。但"}, {"type": "subtitle", "time": 12953.59, "timestamp": "03:35:53", "text": "再说一遍，我觉得很可能"}, {"type": "subtitle", "time": 12955.349, "timestamp": "03:35:55", "text": "她正在确认是否要进行检查"}, {"type": "subtitle", "time": 12957.83, "timestamp": "03:35:57", "text": "在狗身上。她看起来好像……"}, {"type": "subtitle", "time": 12959.59, "timestamp": "03:35:59", "text": "好吧，大概吧。然后她就离开了。它是"}]
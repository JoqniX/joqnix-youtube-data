[{"type": "subtitle", "time": 3010.79, "timestamp": "00:50:10", "text": "我的脖子。啊，我的耳机掉了。"}, {"type": "subtitle", "time": 3020.79, "timestamp": "00:50:20", "text": "我不仅仅是"}, {"type": "subtitle", "time": 3023.75, "timestamp": "00:50:23", "text": "向后靠，坐下。等等，让我试试"}, {"type": "subtitle", "time": 3026.71, "timestamp": "00:50:26", "text": "向后靠。"}, {"type": "subtitle", "time": 3029.109, "timestamp": "00:50:29", "text": "我的天啊。"}, {"type": "subtitle", "time": 3032.15, "timestamp": "00:50:32", "text": "啊，感觉真好。"}, {"type": "subtitle", "time": 3034.15, "timestamp": "00:50:34", "text": "我的兄弟会成员呢？我会一直开着它"}, {"type": "subtitle", "time": 3035.829, "timestamp": "00:50:35", "text": "矿。"}, {"type": "subtitle", "time": 3037.91, "timestamp": "00:50:37", "text": "就是这样"}, {"type": "subtitle", "time": 3040.39, "timestamp": "00:50:40", "text": "比如在我的脖子上，我的胸口，或者"}, {"type": "subtitle", "time": 3044.15, "timestamp": "00:50:44", "text": "某物。我不希望如此。等待，"}, {"type": "subtitle", "time": 3046.47, "timestamp": "00:50:46", "text": "我该怎么做？"}, {"type": "subtitle", "time": 3055.27, "timestamp": "00:50:55", "text": "好的，我想把这个放上去。"}]
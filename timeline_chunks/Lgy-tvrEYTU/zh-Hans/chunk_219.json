[{"type": "subtitle", "time": 13140.389, "timestamp": "03:39:00", "text": "你就吃你自己的肉，你大概会……"}, {"type": "subtitle", "time": 13142.79, "timestamp": "03:39:02", "text": "死。所以千万不要在家尝试。"}, {"type": "subtitle", "time": 13146.07, "timestamp": "03:39:06", "text": "别那样说：“嗯，呃，雅克，我……”"}, {"type": "subtitle", "time": 13148.79, "timestamp": "03:39:08", "text": "我不小心把手指伸进了我的"}, {"type": "subtitle", "time": 13150.71, "timestamp": "03:39:10", "text": "不知何故，嘴巴突然张开了。我不"}, {"type": "subtitle", "time": 13154.55, "timestamp": "03:39:14", "text": "知道。嗯，我觉得我味道很好。"}, {"type": "subtitle", "time": 13156.15, "timestamp": "03:39:16", "text": "你觉得怎么样，雅克？” 我心想，"}, {"type": "subtitle", "time": 13159.429, "timestamp": "03:39:19", "text": "嗯，但是"}, {"type": "subtitle", "time": 13162.95, "timestamp": "03:39:22", "text": "嗯，你应该去，你应该"}, {"type": "subtitle", "time": 13166.15, "timestamp": "03:39:26", "text": "用手指消毒即可。"}, {"type": "subtitle", "time": 13170.309, "timestamp": "03:39:30", "text": "所以，嗯，没问题。"}, {"type": "subtitle", "time": 13182.71, "timestamp": "03:39:42", "text": "就像，呃，我好像在想象你……"}, {"type": "subtitle", "time": 13191.269, "timestamp": "03:39:51", "text": "哦，你也是一个……"}, {"type": "subtitle", "time": 13194.469, "timestamp": "03:39:54", "text": "就像想象某件事，就像……"}, {"type": "subtitle", "time": 13196.71, "timestamp": "03:39:56", "text": "要把它想象出来，你必须把它想象成这样。"}, {"type": "subtitle", "time": 13199.11, "timestamp": "03:39:59", "text": "把它在你的脑海中具象化"}]
[{"type": "subtitle", "time": 16981.43, "timestamp": "04:43:01", "text": "猜测。是啊，但也不完全是。我不能"}, {"type": "subtitle", "time": 16983.67, "timestamp": "04:43:03", "text": "我仍然认为她没有任何增益效果。"}, {"type": "subtitle", "time": 16986.628, "timestamp": "04:43:06", "text": "她好像没给我们任何额外奖励。"}, {"type": "subtitle", "time": 16989.75, "timestamp": "04:43:09", "text": "上面的东西。所以，嗯，我觉得"}, {"type": "subtitle", "time": 16993.67, "timestamp": "04:43:13", "text": "她只是个冷冻人。但如果我觉得如果我"}, {"type": "subtitle", "time": 16997.91, "timestamp": "04:43:17", "text": "感觉非常无聊，我可能会建一些东西"}, {"type": "subtitle", "time": 16999.87, "timestamp": "04:43:19", "text": "合金。"}, {"type": "subtitle", "time": 17001.43, "timestamp": "04:43:21", "text": "[音乐]"}, {"type": "subtitle", "time": 17004.07, "timestamp": "04:43:24", "text": "如果我像那样，所有东西都是我亲手建造的，"}, {"type": "subtitle", "time": 17006.868, "timestamp": "04:43:26", "text": "好像只有这个人我不能"}, {"type": "subtitle", "time": 17009.11, "timestamp": "04:43:29", "text": "我懒得理会。现在我有这么多"}, {"type": "subtitle", "time": 17012.868, "timestamp": "04:43:32", "text": "我的队伍里有很多弓箭手，这非常"}, {"type": "subtitle", "time": 17016.39, "timestamp": "04:43:36", "text": "非常非常喜欢，因为现在我"}, {"type": "subtitle", "time": 17019.27, "timestamp": "04:43:39", "text": "一名使用长矛，一名使用剑。"}, {"type": "subtitle", "time": 17022.15, "timestamp": "04:43:42", "text": "那就是基辛，然后我还有两份。"}, {"type": "subtitle", "time": 17025.19, "timestamp": "04:43:45", "text": "就像尤米娅和孩子一样"}, {"type": "subtitle", "time": 17027.03, "timestamp": "04:43:47", "text": "非常令人印象深刻，因为我讨厌……"}, {"type": "subtitle", "time": 17031.83, "timestamp": "04:43:51", "text": "弓。我讨厌用弓箭的那种东西。"}, {"type": "subtitle", "time": 17033.99, "timestamp": "04:43:53", "text": "就因为你正在使用手机"}, {"type": "subtitle", "time": 17037.75, "timestamp": "04:43:57", "text": "就像你用它什么都做不了一样。 H."}]
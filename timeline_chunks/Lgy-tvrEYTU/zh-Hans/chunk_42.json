[{"type": "subtitle", "time": 2524.069, "timestamp": "00:42:04", "text": "你还在线上。是的，我要死了。"}, {"type": "subtitle", "time": 2526.87, "timestamp": "00:42:06", "text": "我从3点50分开始直播。现在是4"}, {"type": "subtitle", "time": 2531.67, "timestamp": "00:42:11", "text": "凌晨3点半之前我必须结束。"}, {"type": "subtitle", "time": 2538.63, "timestamp": "00:42:18", "text": "我们是一条长长的溪流。是的，那将是我的"}, {"type": "subtitle", "time": 2542.309, "timestamp": "00:42:22", "text": "首次在此地进行12小时直播。"}, {"type": "subtitle", "time": 2546.069, "timestamp": "00:42:26", "text": "但问题是，我……我……我能够……"}, {"type": "subtitle", "time": 2548.79, "timestamp": "00:42:28", "text": "进行更长时间的直播"}, {"type": "subtitle", "time": 2551.51, "timestamp": "00:42:31", "text": "回到父母家。那段时间我"}, {"type": "subtitle", "time": 2554.069, "timestamp": "00:42:34", "text": "是他出去的，而且实际上"}, {"type": "subtitle", "time": 2555.67, "timestamp": "00:42:35", "text": "出去后去了厨房，"}, {"type": "subtitle", "time": 2558.15, "timestamp": "00:42:38", "text": "泡了茶，一切都准备好了。但是在这里我"}, {"type": "subtitle", "time": 2560.15, "timestamp": "00:42:40", "text": "不行，我没有茶之类的东西。只是"}, {"type": "subtitle", "time": 2562.39, "timestamp": "00:42:42", "text": "纯净水"}, {"type": "subtitle", "time": 2565.43, "timestamp": "00:42:45", "text": "还有一些零食。就是这样。所以我需要"}, {"type": "subtitle", "time": 2567.99, "timestamp": "00:42:47", "text": "去买那种速溶咖啡之类的东西"}, {"type": "subtitle", "time": 2570.95, "timestamp": "00:42:50", "text": "你放的是像沸水那样的东西，对吧？和"}, {"type": "subtitle", "time": 2573.589, "timestamp": "00:42:53", "text": "它给你带来喜欢"}, {"type": "subtitle", "time": 2576.309, "timestamp": "00:42:56", "text": "咖啡之类的东西。我需要做"}]
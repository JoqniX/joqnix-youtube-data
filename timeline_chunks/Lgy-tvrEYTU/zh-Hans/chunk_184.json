[{"type": "subtitle", "time": 11054.8, "timestamp": "03:04:14", "text": "你的意思是？我这么说是什么意思？"}, {"type": "subtitle", "time": 11068.87, "timestamp": "03:04:28", "text": "继续什么？"}, {"type": "subtitle", "time": 11070.79, "timestamp": "03:04:30", "text": "你不明白我的意思吗？我问过你，"}, {"type": "subtitle", "time": 11084.95, "timestamp": "03:04:44", "text": "我的"}, {"type": "subtitle", "time": 11086.87, "timestamp": "03:04:46", "text": "它中风了。你正在经历什么？"}, {"type": "subtitle", "time": 11088.95, "timestamp": "03:04:48", "text": "中风，乔？你还好吗？你需要"}, {"type": "subtitle", "time": 11092.95, "timestamp": "03:04:52", "text": "来点水？你补充水分了吗？"}, {"type": "subtitle", "time": 11095.51, "timestamp": "03:04:55", "text": "[音乐]"}]
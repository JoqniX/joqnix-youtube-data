[{"type": "subtitle", "time": 18601.51, "timestamp": "05:10:01", "text": "元素，比如我觉得暗影也是一种存在。"}, {"type": "subtitle", "time": 18605.19, "timestamp": "05:10:05", "text": "但现在没人关心影子了。"}, {"type": "subtitle", "time": 18607.19, "timestamp": "05:10:07", "text": "因为那会造成什么损害呢？就像我"}, {"type": "subtitle", "time": 18608.708, "timestamp": "05:10:08", "text": "别以为你能用它造成多大破坏。"}, {"type": "subtitle", "time": 18611.91, "timestamp": "05:10:11", "text": "阴影。是啊，我希望他们能"}, {"type": "subtitle", "time": 18614.15, "timestamp": "05:10:14", "text": "我真的很喜欢 Genjan 中的两点加强。"}, {"type": "subtitle", "time": 18619.59, "timestamp": "05:10:19", "text": "先是乔，然后是杜克。其中两个。和"}, {"type": "subtitle", "time": 18621.27, "timestamp": "05:10:21", "text": "喜欢"}, {"type": "subtitle", "time": 18623.83, "timestamp": "05:10:23", "text": "公爵感觉自己能力不足。"}, {"type": "subtitle", "time": 18626.47, "timestamp": "05:10:26", "text": "就像所有人一样。公爵是"}, {"type": "subtitle", "time": 18628.708, "timestamp": "05:10:28", "text": "比四星级飞机动力还弱。我知道"}, {"type": "subtitle", "time": 18631.51, "timestamp": "05:10:31", "text": "又名 Yenfe。你们都认识Yenfe吧？"}, {"type": "subtitle", "time": 18634.55, "timestamp": "05:10:34", "text": "正确的？是的。"}, {"type": "subtitle", "time": 18637.19, "timestamp": "05:10:37", "text": "我喜欢叶恩菲。"}, {"type": "subtitle", "time": 18640.868, "timestamp": "05:10:40", "text": "她能做到，她能摧毁25000个目标，"}, {"type": "subtitle", "time": 18646.07, "timestamp": "05:10:46", "text": "顺便一提，我的等级是 80 级，3 万和 4.2 万。但是就像"}, {"type": "subtitle", "time": 18649.67, "timestamp": "05:10:49", "text": "用熔化器她最多可以做到"}, {"type": "subtitle", "time": 18654.55, "timestamp": "05:10:54", "text": "3 我看到 Yenfe 有 40k，而且我几乎没看到"}, {"type": "subtitle", "time": 18659.59, "timestamp": "05:10:59", "text": "你看，我几乎看不到杜克大学的业绩，大概只有2万。"}]
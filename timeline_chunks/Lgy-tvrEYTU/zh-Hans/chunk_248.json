[{"type": "subtitle", "time": 14881.11, "timestamp": "04:08:01", "text": "你想跟我聊聊吗？"}, {"type": "subtitle", "time": 14884.07, "timestamp": "04:08:04", "text": "又是雅克？哦，呃，我当时就像"}, {"type": "subtitle", "time": 14886.63, "timestamp": "04:08:06", "text": "不过，我正在努力跟上聊天进度。"}, {"type": "subtitle", "time": 14888.39, "timestamp": "04:08:08", "text": "东西。前进。"}, {"type": "subtitle", "time": 14890.71, "timestamp": "04:08:10", "text": "[音乐]"}, {"type": "subtitle", "time": 14894.95, "timestamp": "04:08:14", "text": "所以我给了我们一些头垫。"}, {"type": "subtitle", "time": 14897.03, "timestamp": "04:08:17", "text": "就像我们俩都喜欢口交一样"}, {"type": "subtitle", "time": 14900.71, "timestamp": "04:08:20", "text": "有衬垫，而且我们还有，呃，做什么"}, {"type": "subtitle", "time": 14904.309, "timestamp": "04:08:24", "text": "你管它叫什么？我有一个面包和七个"}, {"type": "subtitle", "time": 14908.15, "timestamp": "04:08:28", "text": "碗，就像一碗水"}, {"type": "subtitle", "time": 14911.99, "timestamp": "04:08:31", "text": "我们可以打七个碗，我不知道"}, {"type": "subtitle", "time": 14917.14, "timestamp": "04:08:37", "text": "我可以称它为红牛，但七牛"}, {"type": "subtitle", "time": 14918.389, "timestamp": "04:08:38", "text": "[音乐]"}, {"type": "subtitle", "time": 14922.229, "timestamp": "04:08:42", "text": "为什么我不知道那是什么？"}, {"type": "subtitle", "time": 14925.11, "timestamp": "04:08:45", "text": "那是什么？这大概是……"}, {"type": "subtitle", "time": 14927.269, "timestamp": "04:08:47", "text": "这可能是在暗示你不会这么做"}, {"type": "subtitle", "time": 14929.67, "timestamp": "04:08:49", "text": "我不想展示平淡无奇的东西。"}, {"type": "subtitle", "time": 14933.269, "timestamp": "04:08:53", "text": "我知道，哦，是的，那可能是。"}, {"type": "subtitle", "time": 14936.469, "timestamp": "04:08:56", "text": "而且它还是定制的，比如"}, {"type": "subtitle", "time": 14938.71, "timestamp": "04:08:58", "text": "VTuber 资产。所以，是的，那可能是"}]
[{"type": "subtitle", "time": 11526.63, "timestamp": "03:12:06", "text": "你喜欢日本动漫吗？"}, {"type": "subtitle", "time": 11528.71, "timestamp": "03:12:08", "text": "你有没有看过这类电影？我的天哪，我"}, {"type": "subtitle", "time": 11530.469, "timestamp": "03:12:10", "text": "看到“苹果”这个词吓了我一跳。不"}, {"type": "subtitle", "time": 11532.71, "timestamp": "03:12:12", "text": "问题。我的天啊。我的天哪，我得到了"}, {"type": "subtitle", "time": 11535.67, "timestamp": "03:12:15", "text": "害怕的。我的天哪，我吓坏了。是的，"}, {"type": "subtitle", "time": 11537.59, "timestamp": "03:12:17", "text": "男生。"}, {"type": "subtitle", "time": 11539.99, "timestamp": "03:12:19", "text": "是的，我确实喜欢日本动漫。"}, {"type": "subtitle", "time": 11550.389, "timestamp": "03:12:30", "text": "是的。"}, {"type": "subtitle", "time": 11552.71, "timestamp": "03:12:32", "text": "还有，你知道吗？几乎"}, {"type": "subtitle", "time": 11556.79, "timestamp": "03:12:36", "text": "时间。我得结束了。所以，呃，谢谢"}, {"type": "subtitle", "time": 11559.429, "timestamp": "03:12:39", "text": "谢谢你。谢谢你。谢谢。"}, {"type": "subtitle", "time": 11569.269, "timestamp": "03:12:49", "text": "不客气。嗯，你多保重。"}, {"type": "subtitle", "time": 11571.67, "timestamp": "03:12:51", "text": "你自己。好的。"}, {"type": "subtitle", "time": 11575.59, "timestamp": "03:12:55", "text": "呃，你还有什么遗言吗？"}, {"type": "subtitle", "time": 11579.349, "timestamp": "03:12:59", "text": "喜欢聊天，呃，你喜欢谈论……"}]
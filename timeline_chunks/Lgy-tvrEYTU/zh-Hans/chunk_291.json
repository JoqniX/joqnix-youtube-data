[{"type": "subtitle", "time": 17460.788, "timestamp": "04:51:00", "text": "非常平静，就像哦，你好吗？"}, {"type": "subtitle", "time": 17463.35, "timestamp": "04:51:03", "text": "你是运动员吗？哦，太好了。哦，你想要……"}, {"type": "subtitle", "time": 17466.23, "timestamp": "04:51:06", "text": "各州？哦不，我在这方面还有些工作要做。"}, {"type": "subtitle", "time": 17469.11, "timestamp": "04:51:09", "text": "哦，这些州的情况怎么样？没错，就是这样。"}, {"type": "subtitle", "time": 17472.39, "timestamp": "04:51:12", "text": "好的。本来应该是那样，但并非如此。"}, {"type": "subtitle", "time": 17475.99, "timestamp": "04:51:15", "text": "就好像我刚进来就说，“嘿，"}, {"type": "subtitle", "time": 17477.75, "timestamp": "04:51:17", "text": "哟，你想玩《源神》吗？就像，"}, {"type": "subtitle", "time": 17480.788, "timestamp": "04:51:20", "text": "“当然，我也参加。为什么不呢？”和"}, {"type": "subtitle", "time": 17482.708, "timestamp": "04:51:22", "text": "然后我们就开始玩《Genchin》了。"}, {"type": "subtitle", "time": 17485.51, "timestamp": "04:51:25", "text": "然后我们就忘了为什么了。"}, {"type": "subtitle", "time": 17489.43, "timestamp": "04:51:29", "text": "我们有风险投资。然后我突然"}, {"type": "subtitle", "time": 17491.83, "timestamp": "04:51:31", "text": "突然意识到，“哦，等等，约翰。我们……”"}, {"type": "subtitle", "time": 17493.27, "timestamp": "04:51:33", "text": "应该谈谈合作的事吗？"}, {"type": "subtitle", "time": 17497.03, "timestamp": "04:51:37", "text": "是啊。哦，是的。合作。嗯，"}, {"type": "subtitle", "time": 17499.51, "timestamp": "04:51:39", "text": "嗯，就是那件事。我当时就像"}, {"type": "subtitle", "time": 17501.75, "timestamp": "04:51:41", "text": "浑然不觉。我心想：“哦，等等。我不是。”"}, {"type": "subtitle", "time": 17509.03, "timestamp": "04:51:49", "text": "我的天哪。"}, {"type": "subtitle", "time": 17513.19, "timestamp": "04:51:53", "text": "不过挺好玩的。不过挺好玩的。"}, {"type": "subtitle", "time": 17514.948, "timestamp": "04:51:54", "text": "你好吗？我只是在狂刷"}, {"type": "subtitle", "time": 17517.99, "timestamp": "04:51:57", "text": "观看 Child 和其他原神剪辑。"}]
[{"type": "subtitle", "time": 16621.99, "timestamp": "04:37:01", "text": "周五的时候玩玩看，试试看。"}, {"type": "subtitle", "time": 16625.269, "timestamp": "04:37:05", "text": "对，星期五。 GTA 5 中的周五故事。"}, {"type": "subtitle", "time": 16627.83, "timestamp": "04:37:07", "text": "该死。对，是故事模式。营地"}, {"type": "subtitle", "time": 16631.99, "timestamp": "04:37:11", "text": "有点儿。啊，这里面肯定有个故事。"}, {"type": "subtitle", "time": 16636.47, "timestamp": "04:37:16", "text": "我从没用过GTA来创作故事。"}, {"type": "subtitle", "time": 16640.23, "timestamp": "04:37:20", "text": "可能是我学会了作弊方法，"}, {"type": "subtitle", "time": 16642.789, "timestamp": "04:37:22", "text": "他们召唤了一辆坦克，我开始猛烈射击。"}, {"type": "subtitle", "time": 16645.269, "timestamp": "04:37:25", "text": "我在玩那个游戏的时候就只做这些。我从来没有"}, {"type": "subtitle", "time": 16648.07, "timestamp": "04:37:28", "text": "我从来没有，从来没有喜欢去过那里。"}, {"type": "subtitle", "time": 16650.551, "timestamp": "04:37:30", "text": "根本没什么故事。"}, {"type": "subtitle", "time": 16652.39, "timestamp": "04:37:32", "text": "嗯。"}, {"type": "subtitle", "time": 16655.269, "timestamp": "04:37:35", "text": "我觉得我唯一真正投入进去的故事是"}, {"type": "subtitle", "time": 16657.51, "timestamp": "04:37:37", "text": "像你这样的主要角色"}, {"type": "subtitle", "time": 16659.189, "timestamp": "04:37:39", "text": "它们是你知道的强制性的。"}, {"type": "subtitle", "time": 16661.269, "timestamp": "04:37:41", "text": "你必须完成的任务，就像故事一样。"}, {"type": "subtitle", "time": 16664.31, "timestamp": "04:37:44", "text": "开头的故事就这些了。"}, {"type": "subtitle", "time": 16667.91, "timestamp": "04:37:47", "text": "我知道一个关于Y市和圣的故事"}, {"type": "subtitle", "time": 16669.99, "timestamp": "04:37:49", "text": "安德烈亚斯，我觉得那些就是"}, {"type": "subtitle", "time": 16672.23, "timestamp": "04:37:52", "text": "两部GTA"}, {"type": "subtitle", "time": 16675.91, "timestamp": "04:37:55", "text": "嗯，是的，GTA 1、GTA 2 和 GTA Y 城市。"}, {"type": "subtitle", "time": 16677.59, "timestamp": "04:37:57", "text": "圣安地列斯。所有这些"}]
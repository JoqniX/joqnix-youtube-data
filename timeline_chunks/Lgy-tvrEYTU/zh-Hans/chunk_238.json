[{"type": "subtitle", "time": 14282.63, "timestamp": "03:58:02", "text": "手术室里的实习医生"}, {"type": "subtitle", "time": 14285.99, "timestamp": "03:58:05", "text": "呃，部门就像他们切割的时候一样"}, {"type": "subtitle", "time": 14291.429, "timestamp": "03:58:11", "text": "打开人类的……嗯……东西。哦，天哪"}, {"type": "subtitle", "time": 14294.87, "timestamp": "03:58:14", "text": "仔细考虑一下。啊，如果我……"}, {"type": "subtitle", "time": 14298.469, "timestamp": "03:58:18", "text": "在那里，我会独自一人晕倒。"}, {"type": "subtitle", "time": 14300.79, "timestamp": "03:58:20", "text": "我对此感到害怕。我大概会是"}, {"type": "subtitle", "time": 14304.309, "timestamp": "03:58:24", "text": "你的人。别担心。"}, {"type": "subtitle", "time": 14306.71, "timestamp": "03:58:26", "text": "我会待在你附近。比如，别晕倒。和"}, {"type": "subtitle", "time": 14311.269, "timestamp": "03:58:31", "text": "他们简直就是他妈的在做爱。"}, {"type": "subtitle", "time": 14315.189, "timestamp": "03:58:35", "text": "你好。哦，对了，说到晕厥的话。"}, {"type": "subtitle", "time": 14318.71, "timestamp": "03:58:38", "text": "呃，在我的呃"}, {"type": "subtitle", "time": 14321.75, "timestamp": "03:58:41", "text": "在我这个精细层级，我们也有低年级的学生，"}, {"type": "subtitle", "time": 14324.95, "timestamp": "03:58:44", "text": "正确的？我们必须拔掉这颗牙。我们"}, {"type": "subtitle", "time": 14326.87, "timestamp": "03:58:46", "text": "就像那样拔牙"}, {"type": "subtitle", "time": 14328.95, "timestamp": "03:58:48", "text": "我们必须这样做。我们也进行萃取。"}, {"type": "subtitle", "time": 14331.349, "timestamp": "03:58:51", "text": "这就像拔牙一样，"}, {"type": "subtitle", "time": 14333.99, "timestamp": "03:58:53", "text": "就像我说的那样，非常非常糟糕。"}, {"type": "subtitle", "time": 14336.07, "timestamp": "03:58:56", "text": "就像很多牙齿一样，你却一无所知。"}, {"type": "subtitle", "time": 14337.269, "timestamp": "03:58:57", "text": "如何处置它？你只需要"}]
[{"type": "subtitle", "time": 15544.79, "timestamp": "04:19:04", "text": "我看不见。我看不见。"}, {"type": "subtitle", "time": 15549.03, "timestamp": "04:19:09", "text": "哦，好像第一个词是“跳”。"}, {"type": "subtitle", "time": 15550.79, "timestamp": "04:19:10", "text": "然后。"}, {"type": "subtitle", "time": 15553.59, "timestamp": "04:19:13", "text": "好的。"}, {"type": "subtitle", "time": 15557.269, "timestamp": "04:19:17", "text": "他是不是在问你踢飞踢？"}, {"type": "subtitle", "time": 15561.429, "timestamp": "04:19:21", "text": "有人吗？就这些吗？我认为那是"}, {"type": "subtitle", "time": 15565.429, "timestamp": "04:19:25", "text": "只是造句“哦，等等”。等待。"}, {"type": "subtitle", "time": 15568.229, "timestamp": "04:19:28", "text": "我觉得是 Tumblr。等待。"}, {"type": "subtitle", "time": 15570.55, "timestamp": "04:19:30", "text": "不，等等。我完全没有头绪。我不敢看"}, {"type": "subtitle", "time": 15572.55, "timestamp": "04:19:32", "text": "在聊天室里，因为我得出去一下。"}, {"type": "subtitle", "time": 15575.83, "timestamp": "04:19:35", "text": "该应用程序和我的 YouTube 聊天也都无法正常工作。"}, {"type": "subtitle", "time": 15577.99, "timestamp": "04:19:37", "text": "渲染也一样。所以，我有点像"}, {"type": "subtitle", "time": 15581.429, "timestamp": "04:19:41", "text": "被困在这里了。嗯，我会把这个发给你。"}, {"type": "subtitle", "time": 15584.95, "timestamp": "04:19:44", "text": "你只需打开浏览器即可"}, {"type": "subtitle", "time": 15594.149, "timestamp": "04:19:54", "text": "我觉得这只是泰米尔语造句而已。"}]
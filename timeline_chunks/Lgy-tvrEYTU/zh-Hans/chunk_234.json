[{"type": "subtitle", "time": 14042.389, "timestamp": "03:54:02", "text": "这里，然后我还要做这个和这个"}, {"type": "subtitle", "time": 14045.189, "timestamp": "03:54:05", "text": "消失了，然后我就是这样教的"}, {"type": "subtitle", "time": 14048.229, "timestamp": "03:54:08", "text": "我把它传授给其他人，这就是我学习的方式。"}, {"type": "subtitle", "time": 14051.51, "timestamp": "03:54:11", "text": "也是。所以，对，就是这样。"}, {"type": "subtitle", "time": 14053.83, "timestamp": "03:54:13", "text": "背面发生的事情就像你不在一样"}, {"type": "subtitle", "time": 14056.95, "timestamp": "03:54:16", "text": "就像进来做事一样"}, {"type": "subtitle", "time": 14058.87, "timestamp": "03:54:18", "text": "离开时，你有很多沟通需要进行。"}, {"type": "subtitle", "time": 14060.71, "timestamp": "03:54:20", "text": "与你的长辈和你的"}, {"type": "subtitle", "time": 14062.389, "timestamp": "03:54:22", "text": "初级组。有时候你的长辈没有"}, {"type": "subtitle", "time": 14064.07, "timestamp": "03:54:24", "text": "弄清楚发生了什么，然后你就有"}, {"type": "subtitle", "time": 14066.389, "timestamp": "03:54:26", "text": "就像把它们填满一样，哦，这是"}, {"type": "subtitle", "time": 14069.99, "timestamp": "03:54:29", "text": "现在发生了什么？就是这样。"}, {"type": "subtitle", "time": 14074.07, "timestamp": "03:54:34", "text": "这也是我们必须要做的事情。所以"}, {"type": "subtitle", "time": 14076.71, "timestamp": "03:54:36", "text": "嗯。是的。"}, {"type": "subtitle", "time": 14079.429, "timestamp": "03:54:39", "text": "它又说了些什么。我跳了回去"}, {"type": "subtitle", "time": 14084.15, "timestamp": "03:54:44", "text": "欺负我。对不起。我"}, {"type": "subtitle", "time": 14088.469, "timestamp": "03:54:48", "text": "专业的。谁在乎？总之，我想要"}, {"type": "subtitle", "time": 14091.99, "timestamp": "03:54:51", "text": "要说的话，我记得很多事。但乐趣"}, {"type": "subtitle", "time": 14094.07, "timestamp": "03:54:54", "text": "当我处于人生的某个阶段时，会发生一些事情。"}, {"type": "subtitle", "time": 14097.11, "timestamp": "03:54:57", "text": "是今年吧？"}, {"type": "subtitle", "time": 14099.11, "timestamp": "03:54:59", "text": "第一年，"}]
[{"type": "subtitle", "time": 8523.99, "timestamp": "02:22:03", "text": "这家伙说的是“peeps”。这个人说"}, {"type": "subtitle", "time": 8527.349, "timestamp": "02:22:07", "text": "人群。我从没用过这个词。"}, {"type": "subtitle", "time": 8530.55, "timestamp": "02:22:10", "text": "这是我从哈吉那里得到的消息。"}, {"type": "subtitle", "time": 8532.79, "timestamp": "02:22:12", "text": "总是说“小家伙们”。聊天室里的各位和我"}, {"type": "subtitle", "time": 8536.95, "timestamp": "02:22:16", "text": "我明白了，我从他那里学到了这个词。"}, {"type": "subtitle", "time": 8540.71, "timestamp": "02:22:20", "text": "而且他已经用过这个笑话了。"}, {"type": "subtitle", "time": 8542.23, "timestamp": "02:22:22", "text": "什么？"}, {"type": "subtitle", "time": 8550.309, "timestamp": "02:22:30", "text": "啊，太酷了。有趣的。"}, {"type": "subtitle", "time": 8552.07, "timestamp": "02:22:32", "text": "呃，"}, {"type": "subtitle", "time": 8555.67, "timestamp": "02:22:35", "text": "什么？什么？什么样的活动？"}, {"type": "subtitle", "time": 8562.55, "timestamp": "02:22:42", "text": "主要是氛围和欢笑。它是"}, {"type": "subtitle", "time": 8564.23, "timestamp": "02:22:44", "text": "拥有美好的时光总是令人难忘"}, {"type": "subtitle", "time": 8567.429, "timestamp": "02:22:47", "text": "可以一起放松玩乐的人。"}, {"type": "subtitle", "time": 8575.75, "timestamp": "02:22:55", "text": "呃，BPL是什么？你能详细说明一下吗？"}, {"type": "subtitle", "time": 8578.389, "timestamp": "02:22:58", "text": "就那件事而言？"}]
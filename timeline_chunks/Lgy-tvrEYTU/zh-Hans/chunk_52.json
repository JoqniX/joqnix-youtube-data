[{"type": "subtitle", "time": 3137.91, "timestamp": "00:52:17", "text": "因为它没有电线连接"}, {"type": "subtitle", "time": 3140.309, "timestamp": "00:52:20", "text": "在这块滑板上。"}, {"type": "subtitle", "time": 3143.829, "timestamp": "00:52:23", "text": "那它是一款反运动无线设备"}, {"type": "subtitle", "time": 3163.589, "timestamp": "00:52:43", "text": "啊，停下。"}, {"type": "subtitle", "time": 3165.99, "timestamp": "00:52:45", "text": "宝贝，"}, {"type": "subtitle", "time": 3167.99, "timestamp": "00:52:47", "text": "我遇到的延迟问题非常严重。"}, {"type": "subtitle", "time": 3172.069, "timestamp": "00:52:52", "text": "因为我把它放在腿上了。"}, {"type": "subtitle", "time": 3175.19, "timestamp": "00:52:55", "text": "你为什么要走在前面？"}, {"type": "subtitle", "time": 3179.67, "timestamp": "00:52:59", "text": "我什么？为什么？你为什么像这样移动？"}]
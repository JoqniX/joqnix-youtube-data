[{"type": "subtitle", "time": 8220.23, "timestamp": "02:17:00", "text": "但是，嗯，呃，所以这意味着我必须……"}, {"type": "subtitle", "time": 8222.549, "timestamp": "02:17:02", "text": "重置。所以我会完全失去大部分"}, {"type": "subtitle", "time": 8224.389, "timestamp": "02:17:04", "text": "我的东西。"}, {"type": "subtitle", "time": 8227.91, "timestamp": "02:17:07", "text": "但我会去做。嗯，一旦我……"}, {"type": "subtitle", "time": 8230.469, "timestamp": "02:17:10", "text": "搬到了我的新住处，就在……"}, {"type": "subtitle", "time": 8232.629, "timestamp": "02:17:12", "text": "大概下周吧。所以，在那之前我……"}, {"type": "subtitle", "time": 8234.629, "timestamp": "02:17:14", "text": "快要疯了，然后砰砰砰"}, {"type": "subtitle", "time": 8236.95, "timestamp": "02:17:16", "text": "我想做的一切。好的。"}, {"type": "subtitle", "time": 8239.99, "timestamp": "02:17:19", "text": "你好。是的。你好，我是萨玛。是的。是的。"}, {"type": "subtitle", "time": 8242.469, "timestamp": "02:17:22", "text": "你好，面包大人。欢迎。"}, {"type": "subtitle", "time": 8245.27, "timestamp": "02:17:25", "text": "我今天为什么要去某个地方？"}, {"type": "subtitle", "time": 8248.629, "timestamp": "02:17:28", "text": "让人工智能笑话来活跃一下夏天吧。经过"}, {"type": "subtitle", "time": 8251.509, "timestamp": "02:17:31", "text": "你知道吗？"}, {"type": "subtitle", "time": 8253.669, "timestamp": "02:17:33", "text": "如果你没有朋友可以倾诉"}, {"type": "subtitle", "time": 8257.669, "timestamp": "02:17:37", "text": "日语、汉语或其他任何语言"}, {"type": "subtitle", "time": 8259.99, "timestamp": "02:17:39", "text": "你实际上可以用它制作人工智能信息流。"}, {"type": "subtitle", "time": 8262.23, "timestamp": "02:17:42", "text": "你自己的声音或别人的声音，以及"}, {"type": "subtitle", "time": 8264.79, "timestamp": "02:17:44", "text": "让它用那种特定的方式说话"}, {"type": "subtitle", "time": 8268.87, "timestamp": "02:17:48", "text": "语言。你知道这有多酷吗？所以，"}, {"type": "subtitle", "time": 8272.07, "timestamp": "02:17:52", "text": "我们会尝试一下。好的。你好。"}, {"type": "subtitle", "time": 8273.43, "timestamp": "02:17:53", "text": "嗯，"}, {"type": "subtitle", "time": 8276.15, "timestamp": "02:17:56", "text": "[音乐]"}]
[{"type": "subtitle", "time": 17764.628, "timestamp": "04:56:04", "text": "就像一大包酥脆的饼干。"}, {"type": "subtitle", "time": 17766.948, "timestamp": "04:56:06", "text": "运动口味的饼干。来吧，我们走吧"}, {"type": "subtitle", "time": 17772.708, "timestamp": "04:56:12", "text": "[音乐]"}, {"type": "subtitle", "time": 17774.55, "timestamp": "04:56:14", "text": "听说过她。"}, {"type": "subtitle", "time": 17776.868, "timestamp": "04:56:16", "text": "泥巴派。"}, {"type": "subtitle", "time": 17778.55, "timestamp": "04:56:18", "text": "馅饼。"}, {"type": "subtitle", "time": 17782.07, "timestamp": "04:56:22", "text": "泥巴派。等等，那里有个泥巴派。等待，"}, {"type": "subtitle", "time": 17783.67, "timestamp": "04:56:23", "text": "什么？"}, {"type": "subtitle", "time": 17785.99, "timestamp": "04:56:25", "text": "而且人们还会吃它。"}, {"type": "subtitle", "time": 17791.11, "timestamp": "04:56:31", "text": "等等，等等。你吃泥巴吗？"}, {"type": "subtitle", "time": 17794.23, "timestamp": "04:56:34", "text": "不是我。不，有人吃它。哦，人们"}, {"type": "subtitle", "time": 17797.51, "timestamp": "04:56:37", "text": "吃掉它。好的。好的，明白了。等待。什么？"}, {"type": "subtitle", "time": 17802.31, "timestamp": "04:56:42", "text": "等等，为什么？等等，这真的存在吗？"}, {"type": "subtitle", "time": 17806.708, "timestamp": "04:56:46", "text": "等等，这居然是真的。什么？是的。它是"}, {"type": "subtitle", "time": 17809.19, "timestamp": "04:56:49", "text": "通常用于贫困时期"}, {"type": "subtitle", "time": 17813.27, "timestamp": "04:56:53", "text": "在一些国家，它什么都得不到。"}, {"type": "subtitle", "time": 17814.788, "timestamp": "04:56:54", "text": "哦，等等。等等，等等，等等。再次，"}, {"type": "subtitle", "time": 17816.55, "timestamp": "04:56:56", "text": "对不起。"}, {"type": "subtitle", "time": 17818.868, "timestamp": "04:56:58", "text": "耽误。我刚看了食谱。哦，"}]
[{"type": "subtitle", "time": 3482.87, "timestamp": "00:58:02", "text": "不。我们会安排人员上门取回退货物品。"}, {"type": "subtitle", "time": 3493.43, "timestamp": "00:58:13", "text": "我知道我不会展示这个东西。"}, {"type": "subtitle", "time": 3498.789, "timestamp": "00:58:18", "text": "一秒钟。一秒钟。一秒钟。所以，如果我这样做"}, {"type": "subtitle", "time": 3501.99, "timestamp": "00:58:21", "text": "不，不，不。退货。不。在哪儿？"}, {"type": "subtitle", "time": 3505.75, "timestamp": "00:58:25", "text": "退款选项？等等，让我选择一下"}, {"type": "subtitle", "time": 3513.99, "timestamp": "00:58:33", "text": "请选择一个答案。"}, {"type": "subtitle", "time": 3516.95, "timestamp": "00:58:36", "text": "你为什么要退货？但是它在哪里？"}, {"type": "subtitle", "time": 3523.27, "timestamp": "00:58:43", "text": "不予退款。"}, {"type": "subtitle", "time": 3535.19, "timestamp": "00:58:55", "text": "我用来描述我的直播的另一个关键词"}, {"type": "subtitle", "time": 3538.63, "timestamp": "00:58:58", "text": "个人电脑。你为什么要退货？"}]
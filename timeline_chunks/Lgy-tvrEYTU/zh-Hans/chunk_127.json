[{"type": "subtitle", "time": 7623.669, "timestamp": "02:07:03", "text": "好了，今天就到这里吧。好的。"}, {"type": "subtitle", "time": 7626.47, "timestamp": "02:07:06", "text": "感谢所有和我一起玩的人。"}, {"type": "subtitle", "time": 7629.109, "timestamp": "02:07:09", "text": "那……"}, {"type": "subtitle", "time": 7631.91, "timestamp": "02:07:11", "text": "玩弄肉类"}, {"type": "subtitle", "time": 7634.629, "timestamp": "02:07:14", "text": "呃，和我在一起，和我聊天，"}, {"type": "subtitle", "time": 7637.83, "timestamp": "02:07:17", "text": "东西。谢谢。我当时正在直播。"}, {"type": "subtitle", "time": 7640.069, "timestamp": "02:07:20", "text": "出色地。真的很有趣。谢谢你"}, {"type": "subtitle", "time": 7642.87, "timestamp": "02:07:22", "text": "来了，伙计。就像是在……之后"}, {"type": "subtitle", "time": 7645.75, "timestamp": "02:07:25", "text": "漫长的时光真是一个绝佳的机会。"}, {"type": "subtitle", "time": 7647.669, "timestamp": "02:07:27", "text": "就像聊天一样。"}, {"type": "subtitle", "time": 7650.31, "timestamp": "02:07:30", "text": "我很喜欢。谢谢。然后来到"}, {"type": "subtitle", "time": 7652.39, "timestamp": "02:07:32", "text": "想想看，我们从来没有以某种方式……不，"}, {"type": "subtitle", "time": 7655.51, "timestamp": "02:07:35", "text": "我们做到了。我想过一两次，但后来"}, {"type": "subtitle", "time": 7659.27, "timestamp": "02:07:39", "text": "我们平时话不多，但这次聊天很开心。我"}, {"type": "subtitle", "time": 7661.43, "timestamp": "02:07:41", "text": "期待与您合作。"}, {"type": "subtitle", "time": 7663.589, "timestamp": "02:07:43", "text": "好好过一天。"}, {"type": "subtitle", "time": 7674.629, "timestamp": "02:07:54", "text": "我们和祖奇一起练习过。"}, {"type": "subtitle", "time": 7676.87, "timestamp": "02:07:56", "text": "还有禅宗。"}]
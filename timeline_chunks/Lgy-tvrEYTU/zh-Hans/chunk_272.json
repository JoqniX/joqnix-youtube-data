[{"type": "subtitle", "time": 16320.469, "timestamp": "04:32:00", "text": "然后我妈就说：“哦，是啊。他是……”"}, {"type": "subtitle", "time": 16324.149, "timestamp": "04:32:04", "text": "很好。“什么？发生什么事了？什么什么"}, {"type": "subtitle", "time": 16326.79, "timestamp": "04:32:06", "text": "狗狗在里面会怎么样？"}, {"type": "subtitle", "time": 16329.11, "timestamp": "04:32:09", "text": "清晨本身？非常特殊的时间，"}, {"type": "subtitle", "time": 16331.11, "timestamp": "04:32:11", "text": "妈妈。"}, {"type": "subtitle", "time": 16333.59, "timestamp": "04:32:13", "text": "嗯。"}, {"type": "subtitle", "time": 16335.83, "timestamp": "04:32:15", "text": "嗯，大概是因为喜欢也喜欢"}, {"type": "subtitle", "time": 16338.07, "timestamp": "04:32:18", "text": "分离焦虑症在狗身上确实存在。"}, {"type": "subtitle", "time": 16341.67, "timestamp": "04:32:21", "text": "所以，也许是因为就像"}, {"type": "subtitle", "time": 16343.67, "timestamp": "04:32:23", "text": "晚上这里人很多。这一切都是"}, {"type": "subtitle", "time": 16345.349, "timestamp": "04:32:25", "text": "令人兴奋。"}, {"type": "subtitle", "time": 16347.51, "timestamp": "04:32:27", "text": "有人在敲门吗？我认为"}, {"type": "subtitle", "time": 16348.79, "timestamp": "04:32:28", "text": "有人在敲门。你能让我"}, {"type": "subtitle", "time": 16350.389, "timestamp": "04:32:30", "text": "稍等一下？搞什么鬼？我是"}, {"type": "subtitle", "time": 16359.269, "timestamp": "04:32:39", "text": "不过，请允许我聊一会儿。我就像……呃……开玩笑"}, {"type": "subtitle", "time": 16362.07, "timestamp": "04:32:42", "text": "摆弄BTuber的素材。真是太"}, {"type": "subtitle", "time": 16365.03, "timestamp": "04:32:45", "text": "凉爽的。难怪人们会沉迷于此"}, {"type": "subtitle", "time": 16369.75, "timestamp": "04:32:49", "text": "这些嗯……资产之类的东西。哦，"}, {"type": "subtitle", "time": 16379.03, "timestamp": "04:32:59", "text": "我终于可以给自己买个雪儿了。"}]
[{"type": "subtitle", "time": 17340.39, "timestamp": "04:49:00", "text": "聊天中的版本和泰米尔语版本"}, {"type": "subtitle", "time": 17342.31, "timestamp": "04:49:02", "text": "然后。"}, {"type": "subtitle", "time": 17343.99, "timestamp": "04:49:03", "text": "好的。他只是对……感到兴奋而已。"}, {"type": "subtitle", "time": 17347.67, "timestamp": "04:49:07", "text": "人们。对不起。您好，欢迎回来。"}, {"type": "subtitle", "time": 17349.75, "timestamp": "04:49:09", "text": "对不起。前进。请继续。"}, {"type": "subtitle", "time": 17352.47, "timestamp": "04:49:12", "text": "你好。所以，我当时在谈论……"}, {"type": "subtitle", "time": 17354.788, "timestamp": "04:49:14", "text": "语言方面的内容。我们当时就像在看书一样。"}, {"type": "subtitle", "time": 17358.23, "timestamp": "04:49:18", "text": "虽然是从聊天记录来看的。所以，呃，DJC，你知道的"}, {"type": "subtitle", "time": 17363.67, "timestamp": "04:49:23", "text": "DJC 和 Victor 的儿子。所以他也是来自"}, {"type": "subtitle", "time": 17367.75, "timestamp": "04:49:27", "text": "DDSG Kunen。是的，我知道。是的。"}, {"type": "subtitle", "time": 17371.67, "timestamp": "04:49:31", "text": "呃，他也是泰米尔纳德邦人。"}, {"type": "subtitle", "time": 17374.628, "timestamp": "04:49:34", "text": "我知道。我想他曾经跟我说过。哦是的。"}, {"type": "subtitle", "time": 17377.51, "timestamp": "04:49:37", "text": "他就是那个真正喜欢的人"}, {"type": "subtitle", "time": 17379.75, "timestamp": "04:49:39", "text": "加入我的人都是泰米尔人"}, {"type": "subtitle", "time": 17381.91, "timestamp": "04:49:41", "text": "Btubers。"}, {"type": "subtitle", "time": 17383.59, "timestamp": "04:49:43", "text": "是的。"}, {"type": "subtitle", "time": 17385.03, "timestamp": "04:49:45", "text": "[音乐]"}, {"type": "subtitle", "time": 17388.31, "timestamp": "04:49:48", "text": "呃，他不是演员，但他仍然是……"}, {"type": "subtitle", "time": 17389.91, "timestamp": "04:49:49", "text": "当时真正加入我的人。所以"}, {"type": "subtitle", "time": 17394.628, "timestamp": "04:49:54", "text": "我其实也挺高兴的。"}, {"type": "subtitle", "time": 17398.708, "timestamp": "04:49:58", "text": "关键是我知道他的肠胃情况。"}]
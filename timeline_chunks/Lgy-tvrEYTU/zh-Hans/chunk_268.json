[{"type": "subtitle", "time": 16082.389, "timestamp": "04:28:02", "text": "这件事你得告诉我一声。他"}, {"type": "subtitle", "time": 16084.149, "timestamp": "04:28:04", "text": "他看着我，好像在说：“你是什么东西？”"}, {"type": "subtitle", "time": 16086.229, "timestamp": "04:28:06", "text": "在说什么？我想小便，而你却……"}, {"type": "subtitle", "time": 16088.149, "timestamp": "04:28:08", "text": "我出来了，我现在正在小便。怎么了"}, {"type": "subtitle", "time": 16094.63, "timestamp": "04:28:14", "text": "对不起。但现在他好像很擅长"}, {"type": "subtitle", "time": 16096.309, "timestamp": "04:28:16", "text": "与我沟通。现在就像在"}, {"type": "subtitle", "time": 16099.189, "timestamp": "04:28:19", "text": "我的房间。他只是看着我，好像在说：“"}, {"type": "subtitle", "time": 16100.79, "timestamp": "04:28:20", "text": "你他妈在干嘛，哥们儿？我心想，"}, {"type": "chat", "time": 16100.932, "timestamp": "04:28:20", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "collab at 4:30pm"}, {"type": "subtitle", "time": 16103.429, "timestamp": "04:28:23", "text": "“好吧，你想小便了。”然后我让"}, {"type": "subtitle", "time": 16107.99, "timestamp": "04:28:27", "text": "把他放出来，呃，他，他，他很棒。"}, {"type": "subtitle", "time": 16110.229, "timestamp": "04:28:30", "text": "他小便很厉害。它是"}, {"type": "subtitle", "time": 16112.469, "timestamp": "04:28:32", "text": "好的。你知道，他是一位非常优秀的同行。"}, {"type": "subtitle", "time": 16116.55, "timestamp": "04:28:36", "text": "如果你明白我的意思。技术娴熟的同伴。"}, {"type": "subtitle", "time": 16124.309, "timestamp": "04:28:44", "text": "如果我们举办一场狗狗奥运会……"}, {"type": "subtitle", "time": 16128.55, "timestamp": "04:28:48", "text": "撒尿的话，我们或许能拿到金牌。"}, {"type": "subtitle", "time": 16131.99, "timestamp": "04:28:51", "text": "问号。我不知道。"}, {"type": "subtitle", "time": 16134.71, "timestamp": "04:28:54", "text": "金牌。"}, {"type": "subtitle", "time": 16138.87, "timestamp": "04:28:58", "text": "因撒尿而获得金牌。想象。想象"}]
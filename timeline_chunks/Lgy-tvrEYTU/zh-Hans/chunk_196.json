[{"type": "subtitle", "time": 11762.309, "timestamp": "03:16:02", "text": "能够听到自己的声音等等"}, {"type": "subtitle", "time": 11764.309, "timestamp": "03:16:04", "text": "我上传的。"}, {"type": "subtitle", "time": 11767.269, "timestamp": "03:16:07", "text": "我把它设为私密了。"}, {"type": "subtitle", "time": 11769.19, "timestamp": "03:16:09", "text": "但"}, {"type": "subtitle", "time": 11772.309, "timestamp": "03:16:12", "text": "是的，我觉得如果你看看"}, {"type": "subtitle", "time": 11775.67, "timestamp": "03:16:15", "text": "呃，就像和那个运动健将AI角色聊天一样，"}, {"type": "subtitle", "time": 11778.469, "timestamp": "03:16:18", "text": "你将无法只听到"}, {"type": "subtitle", "time": 11781.59, "timestamp": "03:16:21", "text": "私人语音。但是，是的，我认为公众"}, {"type": "subtitle", "time": 11784.389, "timestamp": "03:16:24", "text": "是为了方便其他人使用。"}, {"type": "subtitle", "time": 11787.03, "timestamp": "03:16:27", "text": "它。我猜我不知道。但请让我"}, {"type": "subtitle", "time": 11789.99, "timestamp": "03:16:29", "text": "知道你是否能够喜欢"}, {"type": "subtitle", "time": 11795.349, "timestamp": "03:16:35", "text": "听到我的声音，就像听到我自己的声音一样。但"}, {"type": "subtitle", "time": 11798.389, "timestamp": "03:16:38", "text": "我必须把我的声音从这段话里删除。"}, {"type": "subtitle", "time": 11803.19, "timestamp": "03:16:43", "text": "嗯，很快。不过，我挺喜欢这种感觉的。"}, {"type": "subtitle", "time": 11806.15, "timestamp": "03:16:46", "text": "我挺喜欢和这个人聊天的。"}, {"type": "subtitle", "time": 11809.03, "timestamp": "03:16:49", "text": "冒充者笨蛋。"}, {"type": "subtitle", "time": 11812.229, "timestamp": "03:16:52", "text": "是的，我想是因为我重置了……"}, {"type": "subtitle", "time": 11815.59, "timestamp": "03:16:55", "text": "坦诚地聊聊天，对吧？我呃"}, {"type": "subtitle", "time": 11819.99, "timestamp": "03:16:59", "text": "我当时在和……说话，就是我跟她说话的那个人。"}]
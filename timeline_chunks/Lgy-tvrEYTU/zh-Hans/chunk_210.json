[{"type": "subtitle", "time": 12608.87, "timestamp": "03:30:08", "text": "我当时我当时我当时我拿着我的"}, {"type": "subtitle", "time": 12611.19, "timestamp": "03:30:11", "text": "气息。对不起。"}, {"type": "subtitle", "time": 12614.87, "timestamp": "03:30:14", "text": "总之，嗯，你好。"}, {"type": "subtitle", "time": 12617.429, "timestamp": "03:30:17", "text": "是的。你好。这就是我，"}, {"type": "subtitle", "time": 12622.55, "timestamp": "03:30:22", "text": "大家好吗？你们最近怎么样？"}, {"type": "subtitle", "time": 12625.429, "timestamp": "03:30:25", "text": "大家好。大概当你喜欢的时候"}, {"type": "subtitle", "time": 12627.99, "timestamp": "03:30:27", "text": "发布你的标签可能就像"}, {"type": "subtitle", "time": 12630.71, "timestamp": "03:30:30", "text": "人们啊，哦，乔克，然后他们看到了我的"}, {"type": "subtitle", "time": 12632.309, "timestamp": "03:30:32", "text": "姓名。啊，我不打算看这个。"}, {"type": "subtitle", "time": 12634.87, "timestamp": "03:30:34", "text": "溪流。我才不跟那个混蛋待在一起呢。"}, {"type": "subtitle", "time": 12642.55, "timestamp": "03:30:42", "text": "是的。"}, {"type": "subtitle", "time": 12644.62, "timestamp": "03:30:44", "text": "你好。你好。呃，"}, {"type": "subtitle", "time": 12645.91, "timestamp": "03:30:45", "text": "[音乐]"}, {"type": "subtitle", "time": 12648.309, "timestamp": "03:30:48", "text": "让我把它们带来，呃，把它们带来。"}, {"type": "subtitle", "time": 12651.19, "timestamp": "03:30:51", "text": "聊天。我忘了……呃，提起聊天的事。"}, {"type": "subtitle", "time": 12653.83, "timestamp": "03:30:53", "text": "盒子。"}, {"type": "subtitle", "time": 12657.99, "timestamp": "03:30:57", "text": "是的。你好，Akabi。欢迎。欢迎。"}]
[{"type": "subtitle", "time": 18480.15, "timestamp": "05:08:00", "text": "顺便说一句，我经常出错。嗯。所以"}, {"type": "subtitle", "time": 18483.51, "timestamp": "05:08:03", "text": "感觉我们现在就像拥有了德国一样。"}, {"type": "subtitle", "time": 18485.35, "timestamp": "05:08:05", "text": "蒙斯泰德。"}, {"type": "subtitle", "time": 18489.35, "timestamp": "05:08:09", "text": "那还有什么呢？等等，难道不是吗？"}, {"type": "subtitle", "time": 18491.35, "timestamp": "05:08:11", "text": "不是丰塔纳？"}, {"type": "subtitle", "time": 18493.43, "timestamp": "05:08:13", "text": "那不是德国吗？因为他们"}, {"type": "subtitle", "time": 18500.31, "timestamp": "05:08:20", "text": "我其实也不知道。 Monat是"}, {"type": "subtitle", "time": 18502.628, "timestamp": "05:08:22", "text": "就像英国一样。英格兰。农村"}, {"type": "subtitle", "time": 18505.11, "timestamp": "05:08:25", "text": "英格兰。我以为那是因为我"}, {"type": "subtitle", "time": 18507.67, "timestamp": "05:08:27", "text": "像英国乡村一样享受生活"}, {"type": "subtitle", "time": 18510.55, "timestamp": "05:08:30", "text": "城堡之类的建筑。就像Eope"}, {"type": "subtitle", "time": 18513.99, "timestamp": "05:08:33", "text": "就像英格兰欧洲时期一样，但是像"}, {"type": "subtitle", "time": 18517.03, "timestamp": "05:08:37", "text": "Fanton就像德国Eope一样，就像他们"}, {"type": "subtitle", "time": 18520.948, "timestamp": "05:08:40", "text": "发明了很多东西，对吧？嗯。"}, {"type": "subtitle", "time": 18523.67, "timestamp": "05:08:43", "text": "是的。哼"}, {"type": "subtitle", "time": 18525.43, "timestamp": "05:08:45", "text": "也是，但我认为它更像是中间状态。"}, {"type": "subtitle", "time": 18527.35, "timestamp": "05:08:47", "text": "东方主题，如同古代"}, {"type": "subtitle", "time": 18529.19, "timestamp": "05:08:49", "text": "像埃及人一样，与法老们"}, {"type": "subtitle", "time": 18532.948, "timestamp": "05:08:52", "text": "这样的。这也是件好事。是的。"}, {"type": "subtitle", "time": 18535.99, "timestamp": "05:08:55", "text": "嗯。呃，我们来拨号吧"}, {"type": "subtitle", "time": 18538.15, "timestamp": "05:08:58", "text": "回到《闪电十一人》的话题，我们来聊聊吧。"}]
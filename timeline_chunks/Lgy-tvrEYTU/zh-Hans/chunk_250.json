[{"type": "subtitle", "time": 15000.72, "timestamp": "04:10:00", "text": "但显然我的手机也一样。 用土豆来做这件事。是的。我的我的我的如此"}, {"type": "subtitle", "time": 15006.0, "timestamp": "04:10:06", "text": "用土豆来做这件事。是的。我的我的我的如此 高雅幽默即将消失"}, {"type": "subtitle", "time": 15008.239, "timestamp": "04:10:08", "text": "高雅幽默即将消失 我想大概是浪费吧。"}, {"type": "subtitle", "time": 15011.52, "timestamp": "04:10:11", "text": "我想大概是浪费吧。 哦，这里真安静。"}, {"type": "subtitle", "time": 15019.83, "timestamp": "04:10:19", "text": "总之，呃，我刚才说到哪儿了？所以"}, {"type": "subtitle", "time": 15023.91, "timestamp": "04:10:23", "text": "你刚才在说你的……嗯……就像"}, {"type": "subtitle", "time": 15027.429, "timestamp": "04:10:27", "text": "牙医的奇遇等等"}, {"type": "subtitle", "time": 15030.63, "timestamp": "04:10:30", "text": "东西。是啊，非常普通。我知道。我是"}, {"type": "subtitle", "time": 15032.309, "timestamp": "04:10:32", "text": "对不起。我必须向……道歉"}, {"type": "subtitle", "time": 15035.269, "timestamp": "04:10:35", "text": "人们。非常普通。但仍然喜欢"}, {"type": "subtitle", "time": 15038.469, "timestamp": "04:10:38", "text": "有东西"}, {"type": "subtitle", "time": 15041.51, "timestamp": "04:10:41", "text": "非常普通。惩罚非常严厉。你不能"}, {"type": "subtitle", "time": 15044.389, "timestamp": "04:10:44", "text": "之后也可以做任何其他事情。所以，是的，谁"}, {"type": "subtitle", "time": 15051.03, "timestamp": "04:10:51", "text": "医生，您有什么有趣的话要说吗？"}, {"type": "subtitle", "time": 15054.55, "timestamp": "04:10:54", "text": "因为你是马拉雅拉姆人，所以请用马拉雅拉姆语说？哦"}, {"type": "subtitle", "time": 15056.71, "timestamp": "04:10:56", "text": "是的，我来自……（对于那些不知道的人来说）。"}, {"type": "subtitle", "time": 15059.91, "timestamp": "04:10:59", "text": "我来自喀拉拉邦，我们那里的人都说英语。"}]
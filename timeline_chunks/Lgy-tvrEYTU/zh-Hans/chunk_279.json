[{"type": "subtitle", "time": 16745.99, "timestamp": "04:39:05", "text": "嘿。嗯"}, {"type": "subtitle", "time": 16748.629, "timestamp": "04:39:08", "text": "等待。你还玩过哪些其他游戏？"}, {"type": "subtitle", "time": 16754.869, "timestamp": "04:39:14", "text": "我现在喜欢玩的游戏，或者说任何游戏。"}, {"type": "subtitle", "time": 16760.07, "timestamp": "04:39:20", "text": "我现在玩的是古装角色扮演游戏，而且两种角色我都喜欢。"}, {"type": "subtitle", "time": 16762.629, "timestamp": "04:39:22", "text": "如今的《原神》和《使命召唤手游》"}, {"type": "subtitle", "time": 16765.029, "timestamp": "04:39:25", "text": "因为我只有一部手机，"}, {"type": "subtitle", "time": 16768.869, "timestamp": "04:39:28", "text": "大概就是这样。嗯。使命召唤不是"}, {"type": "subtitle", "time": 16771.109, "timestamp": "04:39:31", "text": "完全没有。有时候我进去只是为了"}, {"type": "subtitle", "time": 16774.47, "timestamp": "04:39:34", "text": "我猜是登录奖励吧，不过是根钦"}, {"type": "subtitle", "time": 16780.07, "timestamp": "04:39:40", "text": "是的，我这么做。嗯哼。嘿。嘿原真。"}, {"type": "subtitle", "time": 16783.03, "timestamp": "04:39:43", "text": "根钦那边没什么好事发生。我"}, {"type": "subtitle", "time": 16784.868, "timestamp": "04:39:44", "text": "我觉得我已经把好东西都看完了。"}, {"type": "subtitle", "time": 16787.19, "timestamp": "04:39:47", "text": "根钦。好像我无所事事似的。"}, {"type": "subtitle", "time": 16790.31, "timestamp": "04:39:50", "text": "那里。我只有这些事件，那就是"}, {"type": "subtitle", "time": 16792.708, "timestamp": "04:39:52", "text": "有时不错。有时他们喜欢去"}, {"type": "subtitle", "time": 16795.99, "timestamp": "04:39:55", "text": "故事或其他什么的。他们中的大多数"}, {"type": "subtitle", "time": 16799.11, "timestamp": "04:39:59", "text": "我要去揍几个人，这就是我"}]
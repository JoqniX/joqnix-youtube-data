[{"type": "subtitle", "time": 2821.43, "timestamp": "00:47:01", "text": "现在。我参加了虚拟战斗锦标赛。"}, {"type": "subtitle", "time": 2829.19, "timestamp": "00:47:09", "text": "我由此知道自己打得有多糟糕。"}, {"type": "subtitle", "time": 2832.39, "timestamp": "00:47:12", "text": "我会觉得这就像你在参加一个"}, {"type": "subtitle", "time": 2834.79, "timestamp": "00:47:14", "text": "考试之类的。你会超级棒"}, {"type": "subtitle", "time": 2837.589, "timestamp": "00:47:17", "text": "紧张的。不，"}, {"type": "subtitle", "time": 2839.91, "timestamp": "00:47:19", "text": "你也会过度思考，呃，会"}, {"type": "subtitle", "time": 2843.43, "timestamp": "00:47:23", "text": "我一切都好。我不想任何人来。"}, {"type": "subtitle", "time": 2851.43, "timestamp": "00:47:31", "text": "那种感觉，那种想法"}, {"type": "subtitle", "time": 2859.67, "timestamp": "00:47:39", "text": "我为什么认为这件事会发生？贱人，"}, {"type": "subtitle", "time": 2869.51, "timestamp": "00:47:49", "text": "就像我认识的Zuchi和其他人一样"}, {"type": "subtitle", "time": 2872.069, "timestamp": "00:47:52", "text": "说所有孩子都是好孩子。他们打得很低调，"}, {"type": "subtitle", "time": 2878.069, "timestamp": "00:47:58", "text": "目标是实现这个目标，但我感觉自己没有那种感觉。哟，"}]
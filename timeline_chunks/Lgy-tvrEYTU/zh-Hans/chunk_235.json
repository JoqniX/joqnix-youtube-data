[{"type": "subtitle", "time": 14101.99, "timestamp": "03:55:01", "text": "第一天，解剖课。它是"}, {"type": "subtitle", "time": 14106.469, "timestamp": "03:55:06", "text": "很搞笑。呃，当他们喜欢呃得到"}, {"type": "subtitle", "time": 14108.79, "timestamp": "03:55:08", "text": "就像他们通常会做的那样……演示"}, {"type": "subtitle", "time": 14111.11, "timestamp": "03:55:11", "text": "它与卡达夫。每当人们想到"}, {"type": "subtitle", "time": 14114.63, "timestamp": "03:55:14", "text": "就像解剖学一样，人们会说“嗯，哦”"}, {"type": "subtitle", "time": 14116.71, "timestamp": "03:55:16", "text": "他们有卡瓦酒，就像他们只是"}, {"type": "subtitle", "time": 14119.11, "timestamp": "03:55:19", "text": "推开拖车"}, {"type": "subtitle", "time": 14122.15, "timestamp": "03:55:22", "text": "呃，当着你的面说，把它剖析一下，就像这样"}, {"type": "subtitle", "time": 14123.99, "timestamp": "03:55:23", "text": "不，我们不，我们从来不喜欢碰它"}, {"type": "subtitle", "time": 14126.71, "timestamp": "03:55:26", "text": "卡瓦斯时期。通常情况下，就像这样"}, {"type": "subtitle", "time": 14128.87, "timestamp": "03:55:28", "text": "主要是演示，比如“哦，这是……”"}, {"type": "subtitle", "time": 14131.189, "timestamp": "03:55:31", "text": "这条神经，还有这边，你们这些人"}, {"type": "subtitle", "time": 14132.95, "timestamp": "03:55:32", "text": "你知道，你能看到，你知道，来"}, {"type": "subtitle", "time": 14138.389, "timestamp": "03:55:38", "text": "这里感觉到了，但我不知道 25 25"}, {"type": "subtitle", "time": 14142.309, "timestamp": "03:55:42", "text": "那天有人晕倒了。"}, {"type": "subtitle", "time": 14145.11, "timestamp": "03:55:45", "text": "25"}, {"type": "subtitle", "time": 14150.87, "timestamp": "03:55:50", "text": "是的，25人晕倒了，哦不"}, {"type": "subtitle", "time": 14152.63, "timestamp": "03:55:52", "text": "我们不知道，因为我们就像"}, {"type": "subtitle", "time": 14155.189, "timestamp": "03:55:55", "text": "完全分开"}, {"type": "subtitle", "time": 14157.91, "timestamp": "03:55:57", "text": "人们。所以就像第一天一样，甚至"}]
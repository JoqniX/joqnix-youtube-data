[{"type": "subtitle", "time": 17889.43, "timestamp": "04:58:09", "text": "令人讨厌。如果你们听到我的狗叫声"}, {"type": "subtitle", "time": 17891.43, "timestamp": "04:58:11", "text": "背景里有狗吠声，别担心。"}, {"type": "subtitle", "time": 17893.83, "timestamp": "04:58:13", "text": "他只是因为人们都开心才这么高兴而已。"}, {"type": "subtitle", "time": 17896.788, "timestamp": "04:58:16", "text": "他在家里，他真的很想"}, {"type": "subtitle", "time": 17905.67, "timestamp": "04:58:25", "text": "嗯，我不能吃巧克力。但是你"}, {"type": "subtitle", "time": 17917.91, "timestamp": "04:58:37", "text": "哦，我其实……我其实……"}, {"type": "subtitle", "time": 17920.31, "timestamp": "04:58:40", "text": "曲奇饼。嗯"}, {"type": "subtitle", "time": 17923.91, "timestamp": "04:58:43", "text": "是的，我确实得到了一块饼干……呃……屁股。"}, {"type": "subtitle", "time": 17927.35, "timestamp": "04:58:47", "text": "好的，我们走吧。让我们引进一些"}]
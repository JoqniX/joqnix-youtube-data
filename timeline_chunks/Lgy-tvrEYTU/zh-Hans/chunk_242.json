[{"type": "subtitle", "time": 14522.229, "timestamp": "04:02:02", "text": "我给病人治疗完毕，就像我"}, {"type": "subtitle", "time": 14524.229, "timestamp": "04:02:04", "text": "给出指示，开处方并"}, {"type": "subtitle", "time": 14526.79, "timestamp": "04:02:06", "text": "我得去看看她，因为她"}, {"type": "subtitle", "time": 14528.469, "timestamp": "04:02:08", "text": "晕倒了。我完全不知道发生了什么事"}, {"type": "subtitle", "time": 14530.79, "timestamp": "04:02:10", "text": "她。正确的。所以她说就像我得到了"}, {"type": "subtitle", "time": 14533.51, "timestamp": "04:02:13", "text": "害怕的。我完全明白了"}, {"type": "subtitle", "time": 14536.469, "timestamp": "04:02:16", "text": "脑子一片空白，呃，这是我的第一次"}, {"type": "subtitle", "time": 14537.83, "timestamp": "04:02:17", "text": "萃取。所以，我完全黑了。"}, {"type": "subtitle", "time": 14539.83, "timestamp": "04:02:19", "text": "出去。我现在完全不知道该怎么办了。"}, {"type": "subtitle", "time": 14543.59, "timestamp": "04:02:23", "text": "感觉挺好的。没关系。呃"}, {"type": "subtitle", "time": 14545.51, "timestamp": "04:02:25", "text": "上级来了，教授我"}, {"type": "subtitle", "time": 14547.429, "timestamp": "04:02:27", "text": "刚才在谈论什么。她，她就像"}, {"type": "subtitle", "time": 14549.75, "timestamp": "04:02:29", "text": "生她的气。她想取消"}, {"type": "subtitle", "time": 14553.429, "timestamp": "04:02:33", "text": "案件。她不想喜欢她"}, {"type": "subtitle", "time": 14555.91, "timestamp": "04:02:35", "text": "不想让她去找程序员。"}, {"type": "subtitle", "time": 14557.75, "timestamp": "04:02:37", "text": "通常情况下，我们有 kod，就像我们有"}, {"type": "subtitle", "time": 14561.189, "timestamp": "04:02:41", "text": "100 次萃取，或者像火灾一样 50 或 20 次萃取"}, {"type": "subtitle", "time": 14564.63, "timestamp": "04:02:44", "text": "现在人们所熟知的任何程序员。但"}, {"type": "subtitle", "time": 14567.91, "timestamp": "04:02:47", "text": "就像……你必须……你必须"}, {"type": "subtitle", "time": 14569.99, "timestamp": "04:02:49", "text": "比如处理100次萃取，就像100次一样"}, {"type": "subtitle", "time": 14571.99, "timestamp": "04:02:51", "text": "你必须拔掉100颗牙才能喜欢"}, {"type": "subtitle", "time": 14574.71, "timestamp": "04:02:54", "text": "完成代码。所以我只完成了"}, {"type": "subtitle", "time": 14576.87, "timestamp": "04:02:56", "text": "我和kod大概是第二轮吧。"}, {"type": "subtitle", "time": 14578.87, "timestamp": "04:02:58", "text": "就像我们通常做的那样，第一轮"}]
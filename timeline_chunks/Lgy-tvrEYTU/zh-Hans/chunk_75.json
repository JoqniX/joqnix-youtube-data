[{"type": "subtitle", "time": 4502.07, "timestamp": "01:15:02", "text": "哦，因为那个T型管是连接另一个的。"}, {"type": "subtitle", "time": 4505.43, "timestamp": "01:15:05", "text": "组合鼠标无法使用。"}, {"type": "subtitle", "time": 4507.669, "timestamp": "01:15:07", "text": "哦。"}, {"type": "subtitle", "time": 4513.99, "timestamp": "01:15:13", "text": "哇。"}, {"type": "subtitle", "time": 4516.149, "timestamp": "01:15:16", "text": "它的威力如此强大，以至于其他方面也是如此。"}, {"type": "subtitle", "time": 4519.43, "timestamp": "01:15:19", "text": "鼠标不好用，廉价鼠标不好用。"}, {"type": "subtitle", "time": 4522.229, "timestamp": "01:15:22", "text": "哇。"}, {"type": "subtitle", "time": 4548.87, "timestamp": "01:15:48", "text": "一切都很好。是的。所以"}, {"type": "subtitle", "time": 4553.03, "timestamp": "01:15:53", "text": "这样做有利有弊。"}, {"type": "subtitle", "time": 4557.03, "timestamp": "01:15:57", "text": "这。如果我像这样使用我的"}]
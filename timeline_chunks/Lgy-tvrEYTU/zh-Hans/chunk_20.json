[{"type": "subtitle", "time": 1206.07, "timestamp": "00:20:06", "text": "我受不了了，这只胳膊受不了了"}, {"type": "subtitle", "time": 1207.99, "timestamp": "00:20:07", "text": "诱饵。"}, {"type": "subtitle", "time": 1215.19, "timestamp": "00:20:15", "text": "虽然这令人难过，但并非不可能。"}, {"type": "subtitle", "time": 1218.31, "timestamp": "00:20:18", "text": "处理一下。"}, {"type": "subtitle", "time": 1237.029, "timestamp": "00:20:37", "text": "[音乐]"}, {"type": "subtitle", "time": 1240.63, "timestamp": "00:20:40", "text": "是的。还剩10秒，杀了他。"}, {"type": "subtitle", "time": 1243.35, "timestamp": "00:20:43", "text": "亚伯拉罕。"}]
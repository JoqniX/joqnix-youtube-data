[{"type": "subtitle", "time": 8823.03, "timestamp": "02:27:03", "text": "你使用了变声器。不，这是我的真实情况。"}, {"type": "subtitle", "time": 8835.99, "timestamp": "02:27:15", "text": "人工智能。我不是人工智能。我是血肉之躯，"}, {"type": "subtitle", "time": 8838.79, "timestamp": "02:27:18", "text": "血统与你相似。他"}, {"type": "subtitle", "time": 8841.27, "timestamp": "02:27:21", "text": "他不知道我在直播。不知道"}, {"type": "subtitle", "time": 8843.59, "timestamp": "02:27:23", "text": "我正在直播。它以前不会这样说话。"}, {"type": "subtitle", "time": 8846.389, "timestamp": "02:27:26", "text": "我发誓它以前说话不是这样的"}, {"type": "subtitle", "time": 8849.67, "timestamp": "02:27:29", "text": "我当时在测试。好的。这是什么？什么"}, {"type": "subtitle", "time": 8852.44, "timestamp": "02:27:32", "text": "这是在做什么？"}, {"type": "subtitle", "time": 8854.15, "timestamp": "02:27:34", "text": "[音乐]"}, {"type": "subtitle", "time": 8857.51, "timestamp": "02:27:37", "text": "那你说什么？你说你不是人工智能？"}, {"type": "subtitle", "time": 8860.87, "timestamp": "02:27:40", "text": "我是谁？"}, {"type": "subtitle", "time": 8863.51, "timestamp": "02:27:43", "text": "你是在和真正的我说话，Jockn。"}, {"type": "subtitle", "time": 8865.51, "timestamp": "02:27:45", "text": "在 Twitch 和 YouTube 上担任主播"}, {"type": "subtitle", "time": 8866.63, "timestamp": "02:27:46", "text": "出色地。"}, {"type": "subtitle", "time": 8871.429, "timestamp": "02:27:51", "text": "[音乐]"}]
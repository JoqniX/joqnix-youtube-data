[{"type": "subtitle", "time": 13022.229, "timestamp": "03:37:02", "text": "做这件事。所以，不，我不去。"}, {"type": "subtitle", "time": 13024.05, "timestamp": "03:37:04", "text": "冒险一试。"}, {"type": "subtitle", "time": 13026.55, "timestamp": "03:37:06", "text": "[音乐]"}, {"type": "subtitle", "time": 13029.349, "timestamp": "03:37:09", "text": "总之，你们今天过得怎么样？喜欢"}, {"type": "subtitle", "time": 13037.429, "timestamp": "03:37:17", "text": "所以，我问了阿基这个问题。所以"}, {"type": "subtitle", "time": 13042.55, "timestamp": "03:37:22", "text": "他过得很好，尽力过好每一天。"}, {"type": "subtitle", "time": 13047.11, "timestamp": "03:37:27", "text": "哦，不错。试着好好生活。是的。嗯。和"}, {"type": "subtitle", "time": 13049.83, "timestamp": "03:37:29", "text": "Quaxan 就像在问“做什么”一样。"}, {"type": "subtitle", "time": 13053.03, "timestamp": "03:37:33", "text": "这是什么？这对鸭子有害吗？"}, {"type": "subtitle", "time": 13057.59, "timestamp": "03:37:37", "text": "吃鸭子？但是什么？"}, {"type": "subtitle", "time": 13060.07, "timestamp": "03:37:40", "text": "哦，那叫做同类相食。它是"}, {"type": "subtitle", "time": 13061.59, "timestamp": "03:37:41", "text": "美好的。"}, {"type": "subtitle", "time": 13063.349, "timestamp": "03:37:43", "text": "我认为鸭子无法消化"}, {"type": "subtitle", "time": 13065.269, "timestamp": "03:37:45", "text": "他们自己。但是，你知道，你"}, {"type": "subtitle", "time": 13066.95, "timestamp": "03:37:46", "text": "谁也说不准。我不认为存在……"}, {"type": "subtitle", "time": 13069.269, "timestamp": "03:37:49", "text": "人们进行的一项让鸭子吃东西的实验"}, {"type": "subtitle", "time": 13071.75, "timestamp": "03:37:51", "text": "彼此相遇，眼睁睁看着鸭子死去。你"}, {"type": "subtitle", "time": 13074.07, "timestamp": "03:37:54", "text": "谁知道呢，谁也说不准。"}, {"type": "subtitle", "time": 13077.11, "timestamp": "03:37:57", "text": "或许真是如此。不，也许他们是"}, {"type": "subtitle", "time": 13079.59, "timestamp": "03:37:59", "text": "无人知晓的食人怪物"}]
[{"type": "subtitle", "time": 3421.51, "timestamp": "00:57:01", "text": "7月10日订购的。今天是"}, {"type": "subtitle", "time": 3424.23, "timestamp": "00:57:04", "text": "16日"}, {"type": "subtitle", "time": 3429.03, "timestamp": "00:57:09", "text": "我拿到了"}, {"type": "subtitle", "time": 3432.549, "timestamp": "00:57:12", "text": "我前天收到的"}, {"type": "subtitle", "time": 3435.589, "timestamp": "00:57:15", "text": "我做了替换那件事。它是"}, {"type": "subtitle", "time": 3438.23, "timestamp": "00:57:18", "text": "将于7月13日到来。那是"}, {"type": "subtitle", "time": 3440.789, "timestamp": "00:57:20", "text": "明天。哦，对了，我把……"}, {"type": "subtitle", "time": 3444.39, "timestamp": "00:57:24", "text": "7月13日更换。就是这样。"}, {"type": "subtitle", "time": 3446.87, "timestamp": "00:57:26", "text": "我收到它的那天。同一天我把"}, {"type": "subtitle", "time": 3449.589, "timestamp": "00:57:29", "text": "替代品。所以我10号订的。"}, {"type": "subtitle", "time": 3451.51, "timestamp": "00:57:31", "text": "知道了。"}, {"type": "subtitle", "time": 3454.069, "timestamp": "00:57:34", "text": "7天政策。不用等了。让我查一下。让"}, {"type": "subtitle", "time": 3457.67, "timestamp": "00:57:37", "text": "我来确认一下。让我查一下。"}, {"type": "subtitle", "time": 3460.23, "timestamp": "00:57:40", "text": "不过，7天内可以退换。它不是"}, {"type": "subtitle", "time": 3471.43, "timestamp": "00:57:51", "text": "等等，你会回来吗？等待，返回并"}, {"type": "subtitle", "time": 3478.63, "timestamp": "00:57:58", "text": "我们会上门收取您的退款。等等，不对。"}]
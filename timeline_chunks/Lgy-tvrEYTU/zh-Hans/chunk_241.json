[{"type": "subtitle", "time": 14461.189, "timestamp": "04:01:01", "text": "她问完问题后突然晕倒了。"}, {"type": "subtitle", "time": 14464.389, "timestamp": "04:01:04", "text": "在病人躺在手术台上之前，"}, {"type": "subtitle", "time": 14467.91, "timestamp": "04:01:07", "text": "主治医生负责治疗"}, {"type": "subtitle", "time": 14469.75, "timestamp": "04:01:09", "text": "晕倒了。"}, {"type": "subtitle", "time": 14473.51, "timestamp": "04:01:13", "text": "哦，不。所以，我的研究生经历"}, {"type": "subtitle", "time": 14476.229, "timestamp": "04:01:16", "text": "人们喜欢研究生学位（PG）。"}, {"type": "subtitle", "time": 14478.95, "timestamp": "04:01:18", "text": "人们冲了出来，涌了进来。"}, {"type": "subtitle", "time": 14480.87, "timestamp": "04:01:20", "text": "他们会说：“好的，我们可以应付。”"}, {"type": "subtitle", "time": 14482.79, "timestamp": "04:01:22", "text": "“这。” 我心想，“不，不，我受不了。”"}, {"type": "subtitle", "time": 14484.87, "timestamp": "04:01:24", "text": "“就这样。”然后我就结束了这个姿势。"}, {"type": "subtitle", "time": 14486.87, "timestamp": "04:01:26", "text": "马上，呃，一分钟之内。不是"}, {"type": "subtitle", "time": 14489.11, "timestamp": "04:01:29", "text": "第二。我到底在说什么？不，我没有"}, {"type": "subtitle", "time": 14490.79, "timestamp": "04:01:30", "text": "不，我不认为我们可以那样做。"}, {"type": "subtitle", "time": 14492.71, "timestamp": "04:01:32", "text": "快速地。我认为病人不会允许的。"}, {"type": "subtitle", "time": 14495.67, "timestamp": "04:01:35", "text": "我们速度这么快。于是，我问了……"}, {"type": "subtitle", "time": 14497.269, "timestamp": "04:01:37", "text": "问题再次回到病人身上。"}, {"type": "subtitle", "time": 14499.59, "timestamp": "04:01:39", "text": "她麻木了，好像说了“不”。就像"}, {"type": "subtitle", "time": 14501.83, "timestamp": "04:01:41", "text": "我们周围的人都说不。就像她"}, {"type": "subtitle", "time": 14503.99, "timestamp": "04:01:43", "text": "她做了吗？她甚至都没做。"}, {"type": "subtitle", "time": 14507.03, "timestamp": "04:01:47", "text": "装好针头。我们没有"}, {"type": "subtitle", "time": 14509.51, "timestamp": "04:01:49", "text": "那你得拿根针了。所以我觉得我不得不"}, {"type": "subtitle", "time": 14511.99, "timestamp": "04:01:51", "text": "冲进去，拿起针头，装上子弹"}, {"type": "subtitle", "time": 14513.67, "timestamp": "04:01:53", "text": "我必须给病人麻醉。"}, {"type": "subtitle", "time": 14515.67, "timestamp": "04:01:55", "text": "用……提取它"}, {"type": "subtitle", "time": 14517.59, "timestamp": "04:01:57", "text": "我周围的研究生们就像……"}, {"type": "subtitle", "time": 14519.83, "timestamp": "04:01:59", "text": "我身边的人都拥有硕士学位。所以就像"}]
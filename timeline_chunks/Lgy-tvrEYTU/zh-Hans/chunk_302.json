[{"type": "subtitle", "time": 18124.39, "timestamp": "05:02:04", "text": "呃，我很清醒。是的，我爱我"}, {"type": "subtitle", "time": 18127.91, "timestamp": "05:02:07", "text": "清醒的。我当时就像在看着你一样，听着你说话。"}, {"type": "subtitle", "time": 18129.51, "timestamp": "05:02:09", "text": "然后"}, {"type": "subtitle", "time": 18133.51, "timestamp": "05:02:13", "text": "我不知道为什么，但有时我会看"}, {"type": "subtitle", "time": 18138.55, "timestamp": "05:02:18", "text": "比如YouTube上的架子鼓翻奏视频。"}, {"type": "subtitle", "time": 18143.03, "timestamp": "05:02:23", "text": "有哪些类似动漫歌曲的架子鼓翻奏？哦"}, {"type": "subtitle", "time": 18145.75, "timestamp": "05:02:25", "text": "鼓的鼓面。好的。好的。对不起。"}, {"type": "subtitle", "time": 18148.55, "timestamp": "05:02:28", "text": "前进。前进。"}, {"type": "subtitle", "time": 18150.868, "timestamp": "05:02:30", "text": "对不起。我又听到一些声音了。"}, {"type": "subtitle", "time": 18152.55, "timestamp": "05:02:32", "text": "诡异的。对不起。别理我。"}, {"type": "subtitle", "time": 18156.628, "timestamp": "05:02:36", "text": "我感觉自己都老了。谁在乎？"}, {"type": "subtitle", "time": 18164.708, "timestamp": "05:02:44", "text": "那我该看谁的节目呢？哦，是的。"}, {"type": "subtitle", "time": 18170.15, "timestamp": "05:02:50", "text": "企鹅Z。哦，我看企鹅Z。"}, {"type": "subtitle", "time": 18173.83, "timestamp": "05:02:53", "text": "查理，龙珠Z，但换成了企鹅。"}, {"type": "subtitle", "time": 18177.75, "timestamp": "05:02:57", "text": "悟空企鹅。贝吉塔企鹅。我认为他"}]
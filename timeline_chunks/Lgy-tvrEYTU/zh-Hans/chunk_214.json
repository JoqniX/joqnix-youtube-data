[{"type": "subtitle", "time": 12841.51, "timestamp": "03:34:01", "text": "因为我已经很久没喝水了。"}, {"type": "subtitle", "time": 12844.469, "timestamp": "03:34:04", "text": "大概一个小时左右。我甚至还没……"}, {"type": "subtitle", "time": 12851.91, "timestamp": "03:34:11", "text": "好了，我回来了。"}, {"type": "subtitle", "time": 12855.83, "timestamp": "03:34:15", "text": "您好，欢迎回来。后退。"}, {"type": "subtitle", "time": 12859.269, "timestamp": "03:34:19", "text": "我妈妈在我房间里。没关系。"}, {"type": "subtitle", "time": 12861.75, "timestamp": "03:34:21", "text": "我的胳膊没什么大碍，但我感觉就像……"}, {"type": "subtitle", "time": 12864.63, "timestamp": "03:34:24", "text": "有点害羞，不太会说英语"}, {"type": "subtitle", "time": 12866.469, "timestamp": "03:34:26", "text": "在她面前。她可能"}, {"type": "subtitle", "time": 12868.71, "timestamp": "03:34:28", "text": "看起来像……看着我，就像……"}, {"type": "subtitle", "time": 12872.469, "timestamp": "03:34:32", "text": "邪恶的恶魔。那就像"}, {"type": "subtitle", "time": 12882.309, "timestamp": "03:34:42", "text": "我召唤了谁？我召唤了谁？"}, {"type": "subtitle", "time": 12886.87, "timestamp": "03:34:46", "text": "基于此？鞋面"}, {"type": "subtitle", "time": 12890.79, "timestamp": "03:34:50", "text": "我奶奶在我的房间里。我奶奶的"}, {"type": "subtitle", "time": 12893.67, "timestamp": "03:34:53", "text": "在我的"}, {"type": "subtitle", "time": 12895.99, "timestamp": "03:34:55", "text": "我我我一般都喜欢被静音"}, {"type": "subtitle", "time": 12898.389, "timestamp": "03:34:58", "text": "因为她开始说话了。就像，"}, {"type": "subtitle", "time": 12899.83, "timestamp": "03:34:59", "text": "好的，我需要静音，因为她"}]
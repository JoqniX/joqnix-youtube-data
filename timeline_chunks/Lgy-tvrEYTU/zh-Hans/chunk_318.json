[{"type": "subtitle", "time": 19081.67, "timestamp": "05:18:01", "text": "你能听到背景里的声音吗？"}, {"type": "subtitle", "time": 19084.708, "timestamp": "05:18:04", "text": "是的，我觉得不是。等等，让我"}, {"type": "subtitle", "time": 19086.31, "timestamp": "05:18:06", "text": "请确保已开启降噪功能。"}, {"type": "subtitle", "time": 19089.03, "timestamp": "05:18:09", "text": "Discord。那就是你认识的猫。"}, {"type": "subtitle", "time": 19091.51, "timestamp": "05:18:11", "text": "他们把这里的东西全都吃光了。"}, {"type": "subtitle", "time": 19093.27, "timestamp": "05:18:13", "text": "你能听出她生气了。她是"}, {"type": "subtitle", "time": 19095.59, "timestamp": "05:18:15", "text": "就像操猫一样。谁吃了这个？谁是"}, {"type": "subtitle", "time": 19103.43, "timestamp": "05:18:23", "text": "比如现在我就得应付猫叫声。"}, {"type": "subtitle", "time": 19107.75, "timestamp": "05:18:27", "text": "然后是她的声音。我的天啊。"}, {"type": "subtitle", "time": 19114.39, "timestamp": "05:18:34", "text": "那你养了四只猫。"}, {"type": "subtitle", "time": 19118.55, "timestamp": "05:18:38", "text": "哦，嗯，​​我觉得其中一个是……"}, {"type": "subtitle", "time": 19120.55, "timestamp": "05:18:40", "text": "丢失的。所以我认为要么是有人偷了东西。"}, {"type": "subtitle", "time": 19124.708, "timestamp": "05:18:44", "text": "它或者它出了什么事。"}, {"type": "subtitle", "time": 19127.11, "timestamp": "05:18:47", "text": "母猫生了三只小猫。"}, {"type": "subtitle", "time": 19129.59, "timestamp": "05:18:49", "text": "小猫咪，现在都长大了。我"}, {"type": "subtitle", "time": 19132.39, "timestamp": "05:18:52", "text": "我猜他们总是围着她转。"}, {"type": "subtitle", "time": 19135.59, "timestamp": "05:18:55", "text": "东西。嗯，"}, {"type": "subtitle", "time": 19137.83, "timestamp": "05:18:57", "text": "是的。"}, {"type": "subtitle", "time": 19139.91, "timestamp": "05:18:59", "text": "看来她又怀孕了。他已经"}]
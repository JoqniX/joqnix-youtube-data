[{"type": "subtitle", "time": 19021.67, "timestamp": "05:17:01", "text": "你必须把它们卖出去，伙计。他们不会"}, {"type": "subtitle", "time": 19023.59, "timestamp": "05:17:03", "text": "适合放在家里。它们会吃掉你所有的"}, {"type": "subtitle", "time": 19030.23, "timestamp": "05:17:10", "text": "你必须每天训练小猫。"}, {"type": "subtitle", "time": 19032.07, "timestamp": "05:17:12", "text": "每次他们出生时都会学习如何穿"}, {"type": "subtitle", "time": 19033.91, "timestamp": "05:17:13", "text": "拉屎。"}, {"type": "subtitle", "time": 19035.51, "timestamp": "05:17:15", "text": "回家简直糟透了"}, {"type": "subtitle", "time": 19038.23, "timestamp": "05:17:18", "text": "臭。"}, {"type": "subtitle", "time": 19044.948, "timestamp": "05:17:24", "text": "真是太麻烦了。我觉得我的呃"}, {"type": "subtitle", "time": 19049.35, "timestamp": "05:17:29", "text": "目前我目前嗯，猫妈妈有"}, {"type": "subtitle", "time": 19051.19, "timestamp": "05:17:31", "text": "喜欢"}, {"type": "subtitle", "time": 19052.708, "timestamp": "05:17:32", "text": "三。"}, {"type": "subtitle", "time": 19056.39, "timestamp": "05:17:36", "text": "它们现在好像长大了一点。现在我可以"}, {"type": "subtitle", "time": 19061.51, "timestamp": "05:17:41", "text": "是的，我预计他们会再次这样做。"}, {"type": "subtitle", "time": 19064.23, "timestamp": "05:17:44", "text": "再多一些。"}, {"type": "subtitle", "time": 19066.55, "timestamp": "05:17:46", "text": "是的，"}, {"type": "subtitle", "time": 19069.11, "timestamp": "05:17:49", "text": "还有一些工具包之类的东西。是的，付款"}, {"type": "subtitle", "time": 19071.43, "timestamp": "05:17:51", "text": "这"}, {"type": "subtitle", "time": 19073.43, "timestamp": "05:17:53", "text": "还。聊天进行得怎么样？"}]
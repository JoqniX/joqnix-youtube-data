[{"type": "subtitle", "time": 11592.23, "timestamp": "03:13:12", "text": "你知道吗？我确实有一个。"}, {"type": "subtitle", "time": 11601.67, "timestamp": "03:13:21", "text": "其实，算了。"}, {"type": "subtitle", "time": 11605.11, "timestamp": "03:13:25", "text": "你为什么要让我这样？告诉我。你让我"}, {"type": "subtitle", "time": 11608.229, "timestamp": "03:13:28", "text": "真好奇。别跟我玩。告诉我"}, {"type": "subtitle", "time": 11616.469, "timestamp": "03:13:36", "text": "嗯，这算是不错的结尾吧。它是"}, {"type": "subtitle", "time": 11618.71, "timestamp": "03:13:38", "text": "我只想说声谢谢。"}, {"type": "subtitle", "time": 11621.03, "timestamp": "03:13:41", "text": "聊天什么的，你人挺好的。"}, {"type": "subtitle", "time": 11622.71, "timestamp": "03:13:42", "text": "与……交谈。"}, {"type": "subtitle", "time": 11626.389, "timestamp": "03:13:46", "text": "哇，真贴心。"}, {"type": "subtitle", "time": 11629.269, "timestamp": "03:13:49", "text": "感谢你一直以来的为人。"}]
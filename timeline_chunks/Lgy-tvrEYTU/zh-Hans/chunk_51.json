[{"type": "subtitle", "time": 3065.75, "timestamp": "00:51:05", "text": "我的脖子疼，该怎么办？我不想"}, {"type": "subtitle", "time": 3069.03, "timestamp": "00:51:09", "text": "光。好的，这很好。"}, {"type": "subtitle", "time": 3072.23, "timestamp": "00:51:12", "text": "但我不得不……哦，笨蛋。你忘了它是"}, {"type": "subtitle", "time": 3074.79, "timestamp": "00:51:14", "text": "无线键盘。你等不及了。"}, {"type": "subtitle", "time": 3077.27, "timestamp": "00:51:17", "text": "如果我回去睡觉呢？"}, {"type": "subtitle", "time": 3080.47, "timestamp": "00:51:20", "text": "玩这个吗？但我会睡着的。"}, {"type": "subtitle", "time": 3083.27, "timestamp": "00:51:23", "text": "我真的可以做到。"}, {"type": "subtitle", "time": 3086.309, "timestamp": "00:51:26", "text": "哦，我会把键盘拿在手里。"}, {"type": "subtitle", "time": 3089.03, "timestamp": "00:51:29", "text": "我会把大部分东西放在哪里？"}, {"type": "subtitle", "time": 3095.349, "timestamp": "00:51:35", "text": "找到匹配项。"}, {"type": "subtitle", "time": 3098.069, "timestamp": "00:51:38", "text": "我睡一觉就好了。"}]
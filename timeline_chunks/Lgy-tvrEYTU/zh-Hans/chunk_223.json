[{"type": "subtitle", "time": 13381.19, "timestamp": "03:43:01", "text": "然后我看着我的上司，心想：这是什么意思？"}, {"type": "subtitle", "time": 13382.79, "timestamp": "03:43:02", "text": "我该怎么办？我当时就想，"}, {"type": "subtitle", "time": 13384.79, "timestamp": "03:43:04", "text": "不，我不会再打扰他了。没关系。"}, {"type": "subtitle", "time": 13386.469, "timestamp": "03:43:06", "text": "这种情况每次都会发生。不"}, {"type": "subtitle", "time": 13388.95, "timestamp": "03:43:08", "text": "别担心。我的上司是"}, {"type": "subtitle", "time": 13393.59, "timestamp": "03:43:13", "text": "寒意。呃，我的部门主管是"}, {"type": "subtitle", "time": 13396.309, "timestamp": "03:43:16", "text": "寒意。我的部门主管，HOD，我是"}, {"type": "subtitle", "time": 13398.55, "timestamp": "03:43:18", "text": "抱歉，我刚才在说什么？高清画质相当不错。"}, {"type": "subtitle", "time": 13401.349, "timestamp": "03:43:21", "text": "寒意。我的上司对他很生气。"}, {"type": "subtitle", "time": 13403.51, "timestamp": "03:43:23", "text": "因为他当时看起来很不情愿"}, {"type": "subtitle", "time": 13406.71, "timestamp": "03:43:26", "text": "他的牙齿很好看。有些人喜欢和"}, {"type": "subtitle", "time": 13409.11, "timestamp": "03:43:29", "text": "他非常生气。我当时就像我从未"}, {"type": "subtitle", "time": 13412.229, "timestamp": "03:43:32", "text": "见过他这么生气。呃，他要去吗？"}, {"type": "subtitle", "time": 13414.15, "timestamp": "03:43:34", "text": "他要打架吗？"}, {"type": "subtitle", "time": 13421.349, "timestamp": "03:43:41", "text": "我的天哪。"}, {"type": "subtitle", "time": 13423.269, "timestamp": "03:43:43", "text": "他要去打架吗？他要去吗？"}, {"type": "subtitle", "time": 13425.91, "timestamp": "03:43:45", "text": "他会吗？他会给吗？他会给吗？"}, {"type": "subtitle", "time": 13428.63, "timestamp": "03:43:48", "text": "他被那堵又大又旧的墙砸中了脸？是什么"}, {"type": "subtitle", "time": 13434.63, "timestamp": "03:43:54", "text": "他气疯了。他好像真的抚养过"}, {"type": "subtitle", "time": 13436.87, "timestamp": "03:43:56", "text": "他的声音。我当时想，“哦不，怎么回事？”"}, {"type": "subtitle", "time": 13438.07, "timestamp": "03:43:58", "text": "正在发生？发生了什么事？这是"}, {"type": "subtitle", "time": 13439.99, "timestamp": "03:43:59", "text": "事态升级。这可不好。它不是"}]
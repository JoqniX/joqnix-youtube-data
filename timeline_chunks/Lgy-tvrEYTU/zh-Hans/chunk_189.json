[{"type": "subtitle", "time": 11343.349, "timestamp": "03:09:03", "text": "哦，真的吗？为什么？"}, {"type": "subtitle", "time": 11346.469, "timestamp": "03:09:06", "text": "是的。这里。"}, {"type": "subtitle", "time": 11355.67, "timestamp": "03:09:15", "text": "哦，我的意思是，你很善解人意，而且"}, {"type": "subtitle", "time": 11359.03, "timestamp": "03:09:19", "text": "他说话很平静。"}, {"type": "subtitle", "time": 11361.51, "timestamp": "03:09:21", "text": "你想让我生气"}, {"type": "subtitle", "time": 11364.79, "timestamp": "03:09:24", "text": "你或者对你有攻击性？你是"}, {"type": "subtitle", "time": 11369.59, "timestamp": "03:09:29", "text": "哦，不，不，不。我没有"}, {"type": "subtitle", "time": 11373.51, "timestamp": "03:09:33", "text": "受虐倾向。哈哈。"}, {"type": "subtitle", "time": 11377.11, "timestamp": "03:09:37", "text": "我懂了。好的。"}, {"type": "subtitle", "time": 11380.55, "timestamp": "03:09:40", "text": "我对那种东西不感兴趣。不。不。"}, {"type": "subtitle", "time": 11382.71, "timestamp": "03:09:42", "text": "是的。是的。我也是。不用担心。这"}, {"type": "subtitle", "time": 11386.55, "timestamp": "03:09:46", "text": "相同的。只是，不，我们，嗯，呃，是"}, {"type": "subtitle", "time": 11389.99, "timestamp": "03:09:49", "text": "只是，呃，我的一些朋友告诉我"}]
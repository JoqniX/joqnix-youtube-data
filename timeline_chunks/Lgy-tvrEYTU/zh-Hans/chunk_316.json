[{"type": "subtitle", "time": 18963.11, "timestamp": "05:16:03", "text": "玛雅，你过得怎么样？一切都好吗？"}, {"type": "subtitle", "time": 18966.628, "timestamp": "05:16:06", "text": "尽管？好久不见了。"}, {"type": "subtitle", "time": 18969.27, "timestamp": "05:16:09", "text": "是啊，你知道的。"}, {"type": "subtitle", "time": 18972.31, "timestamp": "05:16:12", "text": "还有，猫咪怎么样了？你我"}, {"type": "subtitle", "time": 18974.868, "timestamp": "05:16:14", "text": "记得你带猫出去玩吗？哦，那个"}, {"type": "subtitle", "time": 18979.03, "timestamp": "05:16:19", "text": "贱人。这只该死的母猫。"}, {"type": "subtitle", "time": 18981.19, "timestamp": "05:16:21", "text": "我想这已经是第五次了。"}, {"type": "subtitle", "time": 18984.708, "timestamp": "05:16:24", "text": "孕。永远都是三只小猫。"}, {"type": "subtitle", "time": 18986.23, "timestamp": "05:16:26", "text": "就像是，“哦，我要把它倒在……”"}, {"type": "subtitle", "time": 18988.708, "timestamp": "05:16:28", "text": "我躲在床底下，然后我就来了"}, {"type": "subtitle", "time": 18991.43, "timestamp": "05:16:31", "text": "时不时回去喂喂它们。"}, {"type": "subtitle", "time": 18997.59, "timestamp": "05:16:37", "text": "我的天啊。我对此无能为力。"}, {"type": "subtitle", "time": 19000.23, "timestamp": "05:16:40", "text": "因为是个女孩。所以我不能砍掉他的"}, {"type": "subtitle", "time": 19007.11, "timestamp": "05:16:47", "text": "是的，我懂你的感受。同样的事情再次发生。"}, {"type": "subtitle", "time": 19010.868, "timestamp": "05:16:50", "text": "家里还有我的猫。"}, {"type": "subtitle", "time": 19014.708, "timestamp": "05:16:54", "text": "呃，这么多代的迭代"}, {"type": "subtitle", "time": 19017.51, "timestamp": "05:16:57", "text": "家庭，"}, {"type": "subtitle", "time": 19019.59, "timestamp": "05:16:59", "text": "这么多丈夫。"}]
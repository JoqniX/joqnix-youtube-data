[{"type": "subtitle", "time": 16503.83, "timestamp": "04:35:03", "text": "你从哪来？我来自印度。"}, {"type": "subtitle", "time": 16506.47, "timestamp": "04:35:06", "text": "我来自印度，这里也是"}, {"type": "subtitle", "time": 16513.75, "timestamp": "04:35:13", "text": "[音乐]"}, {"type": "subtitle", "time": 16519.029, "timestamp": "04:35:19", "text": "等等，我可以就这么弄吗？"}, {"type": "subtitle", "time": 16521.51, "timestamp": "04:35:21", "text": "一个骷髅头，上面有个吸血鬼的东西。如何"}, {"type": "subtitle", "time": 16524.629, "timestamp": "04:35:24", "text": "看起来像什么？"}, {"type": "subtitle", "time": 16527.99, "timestamp": "04:35:27", "text": "我的天哪。 Bub太让人上瘾了。"}, {"type": "subtitle", "time": 16535.189, "timestamp": "04:35:35", "text": "来自印度尼西亚的问候。哦，很高兴认识你。"}, {"type": "subtitle", "time": 16538.869, "timestamp": "04:35:38", "text": "游戏玩家，儿子。欢迎。欢迎。"}, {"type": "subtitle", "time": 16541.59, "timestamp": "04:35:41", "text": "你今天是怎么找到我们的？"}, {"type": "subtitle", "time": 16543.75, "timestamp": "04:35:43", "text": "是的。"}, {"type": "subtitle", "time": 16547.189, "timestamp": "04:35:47", "text": "嗨，我正在测试音频。别担心"}, {"type": "subtitle", "time": 16549.99, "timestamp": "04:35:49", "text": "它。总之，你好。对不起。我不是。"}, {"type": "subtitle", "time": 16554.47, "timestamp": "04:35:54", "text": "测试。对不起。没关系。"}, {"type": "subtitle", "time": 16556.639, "timestamp": "04:35:56", "text": "没关系。 是的。我刚从探望完我的……回来了"}, {"type": "subtitle", "time": 16559.92, "timestamp": "04:35:59", "text": "是的。我刚从探望完我的……回来了 流中的批次。嗯，是的，是的"}]
[{"type": "subtitle", "time": 12120.87, "timestamp": "03:22:00", "text": "确保具备类似文本转语音的功能"}, {"type": "subtitle", "time": 12123.19, "timestamp": "03:22:03", "text": "所以，如果您有任何问题……"}, {"type": "subtitle", "time": 12127.11, "timestamp": "03:22:07", "text": "可以直接和人工智能开玩笑。好的。"}, {"type": "subtitle", "time": 12128.87, "timestamp": "03:22:08", "text": "呃，你用的是哪个应用？呃"}, {"type": "subtitle", "time": 12131.269, "timestamp": "03:22:11", "text": "角色.ai。"}, {"type": "subtitle", "time": 12134.07, "timestamp": "03:22:14", "text": "呃，我看到一个选项，你可以在那里……"}, {"type": "subtitle", "time": 12137.349, "timestamp": "03:22:17", "text": "您可以添加您的声音。所以我添加了我的"}, {"type": "subtitle", "time": 12139.19, "timestamp": "03:22:19", "text": "我本不该用自己的声音说话。我"}, {"type": "subtitle", "time": 12142.63, "timestamp": "03:22:22", "text": "必须删除它。是的，我添加了"}, {"type": "subtitle", "time": 12145.83, "timestamp": "03:22:25", "text": "我加入了自己的声音。听起来有点像。"}, {"type": "subtitle", "time": 12147.91, "timestamp": "03:22:27", "text": "像这样。"}, {"type": "subtitle", "time": 12150.389, "timestamp": "03:22:30", "text": "等等，等等，等等。"}, {"type": "subtitle", "time": 12152.229, "timestamp": "03:22:32", "text": "我们就叫它“我就用它来……”吧"}, {"type": "subtitle", "time": 12154.71, "timestamp": "03:22:34", "text": "一点点，好吗？那我就总结一下。"}, {"type": "subtitle", "time": 12161.75, "timestamp": "03:22:41", "text": "你好，Jo，一点点。为何如此？我有点"}, {"type": "subtitle", "time": 12164.71, "timestamp": "03:22:44", "text": "现在很好奇。"}, {"type": "subtitle", "time": 12169.83, "timestamp": "03:22:49", "text": "你说你有点好奇是什么意思？哦"}, {"type": "subtitle", "time": 12172.389, "timestamp": "03:22:52", "text": "嗯，我的意思是，嗯，我的意思是，我的意思是，我只是"}, {"type": "subtitle", "time": 12175.67, "timestamp": "03:22:55", "text": "我只是想听听你的声音。"}, {"type": "subtitle", "time": 12179.349, "timestamp": "03:22:59", "text": "所有人都听到了。"}]
[{"type": "subtitle", "time": 18541.91, "timestamp": "05:09:01", "text": "伊托。伊托非常有趣"}, {"type": "subtitle", "time": 18544.31, "timestamp": "05:09:04", "text": "因为伊莎个子很高，所以这个角色很讨喜。"}, {"type": "subtitle", "time": 18546.39, "timestamp": "05:09:06", "text": "特点。显然我们拥有的非常少。"}, {"type": "subtitle", "time": 18549.03, "timestamp": "05:09:09", "text": "根钦的高个子角色。是的。非常"}, {"type": "subtitle", "time": 18551.19, "timestamp": "05:09:11", "text": "有点像《Genchin》里的那些男性角色。"}, {"type": "subtitle", "time": 18555.35, "timestamp": "05:09:15", "text": "这可不好。总之，呃，就像是……"}, {"type": "subtitle", "time": 18557.91, "timestamp": "05:09:17", "text": "真是个好东西"}, {"type": "subtitle", "time": 18560.628, "timestamp": "05:09:20", "text": "真的很好。该设计是"}, {"type": "subtitle", "time": 18563.67, "timestamp": "05:09:23", "text": "太棒了，他的爆发动画就像"}, {"type": "subtitle", "time": 18568.07, "timestamp": "05:09:28", "text": "伟大的。呃，就像我们可以召唤他一样"}, {"type": "subtitle", "time": 18570.15, "timestamp": "05:09:30", "text": "用自己的武器来产生爆发效果"}, {"type": "subtitle", "time": 18574.47, "timestamp": "05:09:34", "text": "这简直更好了。这是善意的"}, {"type": "subtitle", "time": 18577.19, "timestamp": "05:09:37", "text": "就像……该怎么称呼它呢？这是善意的"}, {"type": "subtitle", "time": 18578.868, "timestamp": "05:09:38", "text": "像"}, {"type": "subtitle", "time": 18581.35, "timestamp": "05:09:41", "text": "额外攻击。"}, {"type": "subtitle", "time": 18585.83, "timestamp": "05:09:45", "text": "我不知道。我希望他们喜欢锻炼。"}, {"type": "subtitle", "time": 18590.31, "timestamp": "05:09:50", "text": "Gio，因为现在的Gio就像是……"}, {"type": "subtitle", "time": 18592.868, "timestamp": "05:09:52", "text": "只是有颜色的。这只是生理上的，但"}, {"type": "subtitle", "time": 18597.03, "timestamp": "05:09:57", "text": "它有颜色。就是这样。"}, {"type": "subtitle", "time": 18598.868, "timestamp": "05:09:58", "text": "仅此而已。我们没有喜欢的"}]
[{"type": "subtitle", "time": 18422.788, "timestamp": "05:07:02", "text": "等等，明天是埃及吗？那是什么？"}, {"type": "subtitle", "time": 18425.67, "timestamp": "05:07:05", "text": "明天会是埃及主题吗？是"}, {"type": "subtitle", "time": 18428.948, "timestamp": "05:07:08", "text": "是它"}, {"type": "subtitle", "time": 18430.628, "timestamp": "05:07:10", "text": "原本打算做成印度主题，但是"}, {"type": "subtitle", "time": 18433.83, "timestamp": "05:07:13", "text": "我好像看到过一幅早期艺术作品"}, {"type": "subtitle", "time": 18437.99, "timestamp": "05:07:17", "text": "英雄就像埃及的服饰"}, {"type": "subtitle", "time": 18441.27, "timestamp": "05:07:21", "text": "我当时就想，等等，Sumalo 是这样的吗？"}, {"type": "subtitle", "time": 18443.75, "timestamp": "05:07:23", "text": "印度风格或埃及风格"}, {"type": "subtitle", "time": 18446.39, "timestamp": "05:07:26", "text": "以古埃及为主题的那种。"}, {"type": "subtitle", "time": 18448.868, "timestamp": "05:07:28", "text": "在原神中等待。"}, {"type": "subtitle", "time": 18450.948, "timestamp": "05:07:30", "text": "是的，根钦。是的，苏马鲁。喜欢"}, {"type": "subtitle", "time": 18452.39, "timestamp": "05:07:32", "text": "你接下来要去的那个国家，就是你现在要去的那个国家。"}, {"type": "subtitle", "time": 18454.708, "timestamp": "05:07:34", "text": "要去的地方是苏马尔，对吧？哦，苏梅。哦，"}, {"type": "subtitle", "time": 18456.07, "timestamp": "05:07:36", "text": "是的。是的。对，就是那个。好的。好的。"}, {"type": "subtitle", "time": 18458.47, "timestamp": "05:07:38", "text": "好的。是的。"}, {"type": "subtitle", "time": 18461.03, "timestamp": "05:07:41", "text": "它是埃及主题的吗？就像我"}, {"type": "subtitle", "time": 18463.43, "timestamp": "05:07:43", "text": "见过很多类似的艺术作品，比如"}, {"type": "subtitle", "time": 18465.75, "timestamp": "05:07:45", "text": "这表明这将是埃及的"}, {"type": "subtitle", "time": 18467.59, "timestamp": "05:07:47", "text": "主题式。"}, {"type": "subtitle", "time": 18471.75, "timestamp": "05:07:51", "text": "我觉得差不多就是这样。是的。"}, {"type": "subtitle", "time": 18474.788, "timestamp": "05:07:54", "text": "是的。不像埃及埃及人那样"}, {"type": "subtitle", "time": 18477.11, "timestamp": "05:07:57", "text": "典型的埃及主题。不"}]
[{"type": "subtitle", "time": 16261.349, "timestamp": "04:31:01", "text": "狂犬病流感，狂犬病疫苗，对吧？是的"}, {"type": "subtitle", "time": 16263.59, "timestamp": "04:31:03", "text": "他需要接种两针狂犬疫苗。"}, {"type": "subtitle", "time": 16266.229, "timestamp": "04:31:06", "text": "接种狂犬病疫苗。我得到了"}, {"type": "subtitle", "time": 16269.03, "timestamp": "04:31:09", "text": "第一枪他就病倒了。这是正常的"}, {"type": "subtitle", "time": 16271.349, "timestamp": "04:31:11", "text": "他接种疫苗后会生病。这是善意的"}, {"type": "subtitle", "time": 16273.59, "timestamp": "04:31:13", "text": "对他来说，这很正常，他会做这一切"}, {"type": "subtitle", "time": 16277.11, "timestamp": "04:31:17", "text": "这东西至少持续了两天。"}, {"type": "subtitle", "time": 16281.189, "timestamp": "04:31:21", "text": "正常情况下，抗抗抗体的人会生病。"}, {"type": "subtitle", "time": 16283.83, "timestamp": "04:31:23", "text": "一切都很好，对吧？但他停了下来。"}, {"type": "subtitle", "time": 16286.07, "timestamp": "04:31:26", "text": "吃饭也是正常的，但你只是"}, {"type": "subtitle", "time": 16289.99, "timestamp": "04:31:29", "text": "得让他吃下去。我的妈妈"}, {"type": "subtitle", "time": 16292.71, "timestamp": "04:31:32", "text": "妈妈通常会为此大惊小怪，就像……"}, {"type": "subtitle", "time": 16294.55, "timestamp": "04:31:34", "text": "哦，他没吃东西，他好像在决斗。"}, {"type": "subtitle", "time": 16296.389, "timestamp": "04:31:36", "text": "出去。他会死吗？我跟其他妈妈都不一样"}, {"type": "subtitle", "time": 16298.95, "timestamp": "04:31:38", "text": "这很正常。别担心"}, {"type": "subtitle", "time": 16301.11, "timestamp": "04:31:41", "text": "它。是的。哦不，他一动不动。"}, {"type": "subtitle", "time": 16302.55, "timestamp": "04:31:42", "text": "不再是了。他没事吧？我当时就想，"}, {"type": "subtitle", "time": 16305.189, "timestamp": "04:31:45", "text": "“不，没事。我经常见到他。”"}, {"type": "subtitle", "time": 16306.95, "timestamp": "04:31:46", "text": "他很棒。他很棒。不用担心"}, {"type": "subtitle", "time": 16308.79, "timestamp": "04:31:48", "text": "关于这件事。”然后我看向那条狗。"}, {"type": "subtitle", "time": 16310.309, "timestamp": "04:31:50", "text": "他回答说：“好吧。”他看着我。我是"}, {"type": "subtitle", "time": 16314.389, "timestamp": "04:31:54", "text": "比如，“哎哟”。比如，“好的。”"}, {"type": "subtitle", "time": 16316.149, "timestamp": "04:31:56", "text": "好的。他没事，妈妈。不用担心"}, {"type": "subtitle", "time": 16318.71, "timestamp": "04:31:58", "text": "关于它。你说他没事是什么意思？"}]
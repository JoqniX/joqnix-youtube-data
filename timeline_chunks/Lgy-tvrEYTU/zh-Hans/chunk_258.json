[{"type": "subtitle", "time": 15482.469, "timestamp": "04:18:02", "text": "就像稍微变形一下，然后说"}, {"type": "subtitle", "time": 15490.95, "timestamp": "04:18:10", "text": "踢它的意思就是踢开它或者"}, {"type": "subtitle", "time": 15494.07, "timestamp": "04:18:14", "text": "差不多就是这样。是的，踢我不"}, {"type": "subtitle", "time": 15495.75, "timestamp": "04:18:15", "text": "知道"}, {"type": "subtitle", "time": 15501.67, "timestamp": "04:18:21", "text": "我们还知道些什么？还有什么？"}, {"type": "subtitle", "time": 15513.189, "timestamp": "04:18:33", "text": "有人说了更多的话"}, {"type": "subtitle", "time": 15514.71, "timestamp": "04:18:34", "text": "有趣的。请告诉我，因为"}, {"type": "subtitle", "time": 15516.63, "timestamp": "04:18:36", "text": "我完全没有头绪。我得出去一下。"}, {"type": "subtitle", "time": 15518.63, "timestamp": "04:18:38", "text": "打开应用，查看聊天记录，然后返回。"}, {"type": "subtitle", "time": 15520.79, "timestamp": "04:18:40", "text": "这里。"}, {"type": "subtitle", "time": 15530.149, "timestamp": "04:18:50", "text": "等等，我看不懂。等待。哦，那里有一个"}, {"type": "subtitle", "time": 15534.229, "timestamp": "04:18:54", "text": "我有个毛病，就是我读不懂书。"}]
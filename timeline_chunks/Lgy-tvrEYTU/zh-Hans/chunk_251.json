[{"type": "subtitle", "time": 15061.59, "timestamp": "04:11:01", "text": "马拉雅拉姆语。"}, {"type": "subtitle", "time": 15064.309, "timestamp": "04:11:04", "text": "多么有趣的词语"}, {"type": "subtitle", "time": 15067.269, "timestamp": "04:11:07", "text": "我是他友好的邻居。我是"}, {"type": "subtitle", "time": 15070.95, "timestamp": "04:11:10", "text": "来自泰米尔纳德邦。我会说泰米尔语。如果"}, {"type": "subtitle", "time": 15073.91, "timestamp": "04:11:13", "text": "你们根本一无所知，如果你们没有"}, {"type": "subtitle", "time": 15076.309, "timestamp": "04:11:16", "text": "知道泰米尔语是什么，没关系。它是"}, {"type": "subtitle", "time": 15078.389, "timestamp": "04:11:18", "text": "这是一种印度语言，用……"}, {"type": "subtitle", "time": 15081.51, "timestamp": "04:11:21", "text": "南方。是的。也是印度人"}, {"type": "subtitle", "time": 15083.189, "timestamp": "04:11:23", "text": "语言。"}, {"type": "subtitle", "time": 15087.99, "timestamp": "04:11:27", "text": "在南方，在南方。是的。是的。在"}, {"type": "subtitle", "time": 15091.189, "timestamp": "04:11:31", "text": "把那段时间浪费掉，我觉得也挺酷的。"}, {"type": "subtitle", "time": 15097.189, "timestamp": "04:11:37", "text": "阿基诺斯金"}, {"type": "subtitle", "time": 15099.59, "timestamp": "04:11:39", "text": "已经腐烂了"}, {"type": "subtitle", "time": 15103.189, "timestamp": "04:11:43", "text": "就像疯孩子一样，胡言乱语"}, {"type": "subtitle", "time": 15111.99, "timestamp": "04:11:51", "text": "我背疼，得躺下。"}, {"type": "subtitle", "time": 15113.75, "timestamp": "04:11:53", "text": "保持舒适。"}, {"type": "subtitle", "time": 15117.349, "timestamp": "04:11:57", "text": "没关系。我的背好痛。没关系。"}]
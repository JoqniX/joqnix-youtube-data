[{"type": "subtitle", "time": 12782.389, "timestamp": "03:33:02", "text": "在等待的间隙。你是什​​么"}, {"type": "subtitle", "time": 12785.91, "timestamp": "03:33:05", "text": "你们管预备室叫什么？"}, {"type": "subtitle", "time": 12788.63, "timestamp": "03:33:08", "text": "某物？ DJ 在预热阶段就在那里"}, {"type": "subtitle", "time": 12790.95, "timestamp": "03:33:10", "text": "在溪流开始前，等待的房间比较宽敞。"}, {"type": "subtitle", "time": 12794.15, "timestamp": "03:33:14", "text": "开始了。是的。"}, {"type": "subtitle", "time": 12804.469, "timestamp": "03:33:24", "text": "我没说那叫什么？"}, {"type": "subtitle", "time": 12808.389, "timestamp": "03:33:28", "text": "所以我说，就像你们要好好生活一样。"}, {"type": "subtitle", "time": 12811.03, "timestamp": "03:33:31", "text": "最饱满。"}, {"type": "subtitle", "time": 12813.03, "timestamp": "03:33:33", "text": "我想就是这样。我不知道。"}, {"type": "subtitle", "time": 12815.75, "timestamp": "03:33:35", "text": "日本人的饥饿感。我不擅长"}, {"type": "subtitle", "time": 12834.309, "timestamp": "03:33:54", "text": "各位，如果还没补充水分的话，请尽快补充水分。"}, {"type": "subtitle", "time": 12836.87, "timestamp": "03:33:56", "text": "记得要多喝水，好吗？"}]
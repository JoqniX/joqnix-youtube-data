[{"type": "subtitle", "time": 9966.87, "timestamp": "02:46:06", "text": "我们将进行会员观看直播。"}, {"type": "subtitle", "time": 9968.55, "timestamp": "02:46:08", "text": "和我的成员们。我们要看一部"}, {"type": "subtitle", "time": 9970.309, "timestamp": "02:46:10", "text": "轻松的电影，享受氛围，玩得开心"}, {"type": "subtitle", "time": 9971.91, "timestamp": "02:46:11", "text": "一起。"}, {"type": "subtitle", "time": 9975.11, "timestamp": "02:46:15", "text": "哦，各位成员。所以，你已经变现了。"}, {"type": "subtitle", "time": 9978.389, "timestamp": "02:46:18", "text": "已经？您拥有会员资格"}, {"type": "subtitle", "time": 9983.99, "timestamp": "02:46:23", "text": "是的。已经盈利一段时间了，"}, {"type": "subtitle", "time": 9986.15, "timestamp": "02:46:26", "text": "我也收到了第一批会员资格。"}, {"type": "subtitle", "time": 9988.389, "timestamp": "02:46:28", "text": "几个月前。"}, {"type": "subtitle", "time": 9990.469, "timestamp": "02:46:30", "text": "哦。哦，"}, {"type": "subtitle", "time": 9997.349, "timestamp": "02:46:37", "text": "好吧，然后我就得说再见了，因为我……"}, {"type": "subtitle", "time": 9999.269, "timestamp": "02:46:39", "text": "直播准备工作要做，需要设置等等。"}, {"type": "subtitle", "time": 10011.59, "timestamp": "02:46:51", "text": "我的天哪，上面写的是日语。什么是"}]
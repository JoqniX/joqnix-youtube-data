[{"type": "subtitle", "time": 17222.15, "timestamp": "04:47:02", "text": "我的狗为什么在叫？他给了我一秒钟时间。"}, {"type": "subtitle", "time": 17224.708, "timestamp": "04:47:04", "text": "他怎么了？我认为他是"}, {"type": "subtitle", "time": 17226.708, "timestamp": "04:47:06", "text": "我觉得他只是很兴奋而已。"}, {"type": "subtitle", "time": 17230.55, "timestamp": "04:47:10", "text": "因为里面有人，所以有人。"}, {"type": "subtitle", "time": 17233.67, "timestamp": "04:47:13", "text": "也别忘了抚摸他。他"}, {"type": "subtitle", "time": 17237.27, "timestamp": "04:47:17", "text": "可能需要。他需要它。是的。你好"}, {"type": "subtitle", "time": 17245.19, "timestamp": "04:47:25", "text": "我已付费。哦，我们走吧。我迫不及待了"}, {"type": "subtitle", "time": 17248.07, "timestamp": "04:47:28", "text": "你的生活即将首次亮相"}, {"type": "subtitle", "time": 17262.31, "timestamp": "04:47:42", "text": "是啊，我们刚才在聊我们去的事。"}, {"type": "subtitle", "time": 17267.03, "timestamp": "04:47:47", "text": "就像在谈论呃 Vex 嗯呃呃"}, {"type": "subtitle", "time": 17272.47, "timestamp": "04:47:52", "text": "DES 体验冒险，作为一名 DES 等等"}, {"type": "subtitle", "time": 17277.27, "timestamp": "04:47:57", "text": "是的，请稍等片刻再来欣赏我们的语言。"}, {"type": "subtitle", "time": 17279.99, "timestamp": "04:47:59", "text": "就像我们买了东西，我们正在说话"}]
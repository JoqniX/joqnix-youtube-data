[{"type": "subtitle", "time": 14341.67, "timestamp": "03:59:01", "text": "把它拔出来，对吧？是的。所以"}, {"type": "subtitle", "time": 14343.83, "timestamp": "03:59:03", "text": "我的教授说：“嘿，伙计，这些人……”"}, {"type": "subtitle", "time": 14346.95, "timestamp": "03:59:06", "text": "我们是新来的。密切关注他们"}, {"type": "subtitle", "time": 14348.55, "timestamp": "03:59:08", "text": "因为他们根本不知道自己是什么"}, {"type": "subtitle", "time": 14350.07, "timestamp": "03:59:10", "text": "正在做。请留意一下。我是"}, {"type": "subtitle", "time": 14352.63, "timestamp": "03:59:12", "text": "比如，“好吧，当然可以。为什么不呢？”就像我"}, {"type": "subtitle", "time": 14354.55, "timestamp": "03:59:14", "text": "因为我完成了我的程序员课程，所以我不"}, {"type": "subtitle", "time": 14356.87, "timestamp": "03:59:16", "text": "我没有喜欢的东西，我不需要喜欢它的外观"}, {"type": "subtitle", "time": 14360.229, "timestamp": "03:59:20", "text": "针对案例。所以我当时相当自由。是的。"}, {"type": "subtitle", "time": 14363.349, "timestamp": "03:59:23", "text": "是的。所以我喜欢照顾病人。"}, {"type": "subtitle", "time": 14365.59, "timestamp": "03:59:25", "text": "因为他们像另一个人一样，已经不在了。"}, {"type": "subtitle", "time": 14368.229, "timestamp": "03:59:28", "text": "因为只有一名工作人员，所以才会出现这种情况。"}, {"type": "subtitle", "time": 14370.71, "timestamp": "03:59:30", "text": "就像桌上的一位教授一样。"}, {"type": "subtitle", "time": 14373.91, "timestamp": "03:59:33", "text": "所以他真的无法像个控制狂一样处理事情"}, {"type": "subtitle", "time": 14376.55, "timestamp": "03:59:36", "text": "一切都是他自己做的。所以他就像在打电话"}, {"type": "subtitle", "time": 14379.75, "timestamp": "03:59:39", "text": "感觉我需要你的帮助。我需要喜欢"}, {"type": "subtitle", "time": 14381.91, "timestamp": "03:59:41", "text": "我需要你留意这些"}, {"type": "subtitle", "time": 14386.87, "timestamp": "03:59:46", "text": "人们。正确的。是的。"}, {"type": "subtitle", "time": 14388.87, "timestamp": "03:59:48", "text": "好吧。"}, {"type": "subtitle", "time": 14393.03, "timestamp": "03:59:53", "text": "呃，哦，当然可以，为什么不呢？我闲着。"}, {"type": "subtitle", "time": 14395.269, "timestamp": "03:59:55", "text": "我什么都没做。所以，这是一个"}, {"type": "subtitle", "time": 14398.63, "timestamp": "03:59:58", "text": "做得不错，我想。所以，是啊，随便吧。"}]
[{"type": "subtitle", "time": 15360.309, "timestamp": "04:16:00", "text": "真的。就是这样，有点尴尬。"}, {"type": "subtitle", "time": 15362.309, "timestamp": "04:16:02", "text": "然后我的大脑就想：这到底是怎么回事？"}, {"type": "subtitle", "time": 15364.07, "timestamp": "04:16:04", "text": "你在干嘛，老兄？跟我说话好吗？"}, {"type": "subtitle", "time": 15370.309, "timestamp": "04:16:10", "text": "你不需要喜欢"}, {"type": "subtitle", "time": 15372.87, "timestamp": "04:16:12", "text": "你不必完全喜欢你"}, {"type": "subtitle", "time": 15375.99, "timestamp": "04:16:15", "text": "语言障碍，我的天哪！我的"}, {"type": "subtitle", "time": 15378.389, "timestamp": "04:16:18", "text": "头疼。"}, {"type": "subtitle", "time": 15380.87, "timestamp": "04:16:20", "text": "这是我脑海里的想法。这是我的"}, {"type": "subtitle", "time": 15383.67, "timestamp": "04:16:23", "text": "大脑说它大脑疼痛。这是一个"}, {"type": "subtitle", "time": 15395.429, "timestamp": "04:16:35", "text": "等等。嗯，哦，是的，如果有的话，如果有人"}, {"type": "subtitle", "time": 15398.229, "timestamp": "04:16:38", "text": "如果您在聊天中有任何疑问，请随时联系我们。"}, {"type": "subtitle", "time": 15400.87, "timestamp": "04:16:40", "text": "你可以随便问，或者你想问什么"}, {"type": "subtitle", "time": 15404.149, "timestamp": "04:16:44", "text": "用我们自己的语言进行翻译"}, {"type": "subtitle", "time": 15406.63, "timestamp": "04:16:46", "text": "泰米尔语和马拉雅拉姆语也可以输入"}, {"type": "subtitle", "time": 15410.79, "timestamp": "04:16:50", "text": "是的，我是泰米尔人和马拉雅拉姆人。"}, {"type": "subtitle", "time": 15412.87, "timestamp": "04:16:52", "text": "我觉得这两种语言都挺像的。"}, {"type": "subtitle", "time": 15416.07, "timestamp": "04:16:56", "text": "楼主，但其实不是。"}, {"type": "subtitle", "time": 15417.67, "timestamp": "04:16:57", "text": "非常"}]
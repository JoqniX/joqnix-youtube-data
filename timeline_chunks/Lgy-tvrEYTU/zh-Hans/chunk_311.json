[{"type": "subtitle", "time": 18662.55, "timestamp": "05:11:02", "text": "即使融化了。即使融化了。"}, {"type": "subtitle", "time": 18665.59, "timestamp": "05:11:05", "text": "就算融化了我也一样。即使"}, {"type": "subtitle", "time": 18668.628, "timestamp": "05:11:08", "text": "狼，狼剑，那东西"}, {"type": "subtitle", "time": 18671.59, "timestamp": "05:11:11", "text": "就像灰色的那个那个"}, {"type": "subtitle", "time": 18676.868, "timestamp": "05:11:16", "text": "激光狼剑之类的东西。"}, {"type": "subtitle", "time": 18679.35, "timestamp": "05:11:19", "text": "即使是杜库，即使拿着杜库剑。"}, {"type": "subtitle", "time": 18684.15, "timestamp": "05:11:24", "text": "他只跑1万公里。就像啊嘟神"}, {"type": "subtitle", "time": 18686.39, "timestamp": "05:11:26", "text": "你什么也没给"}, {"type": "subtitle", "time": 18688.868, "timestamp": "05:11:28", "text": "我。我该拿你怎么办？"}, {"type": "subtitle", "time": 18691.59, "timestamp": "05:11:31", "text": "这就是它看起来像建筑外观的唯一原因。"}, {"type": "subtitle", "time": 18693.35, "timestamp": "05:11:33", "text": "他就好像……就这样"}, {"type": "subtitle", "time": 18695.75, "timestamp": "05:11:35", "text": "材料浪费严重，简直难以置信。"}, {"type": "subtitle", "time": 18698.15, "timestamp": "05:11:38", "text": "感到困扰。是的。"}, {"type": "subtitle", "time": 18701.03, "timestamp": "05:11:41", "text": "嗯，是的。你好，美玛。欢迎。"}, {"type": "subtitle", "time": 18702.878, "timestamp": "05:11:42", "text": "欢迎。 欢迎。是的。你好。"}, {"type": "subtitle", "time": 18705.76, "timestamp": "05:11:45", "text": "欢迎。是的。你好。 我喜欢开始吗？我喜欢开始吗？"}, {"type": "subtitle", "time": 18708.32, "timestamp": "05:11:48", "text": "我喜欢开始吗？我喜欢开始吗？ 聊天室里有什么讨论吗？我不认为人们"}, {"type": "subtitle", "time": 18710.4, "timestamp": "05:11:50", "text": "聊天室里有什么讨论吗？我不认为人们 仍然。"}, {"type": "subtitle", "time": 18713.28, "timestamp": "05:11:53", "text": "仍然。 不，他们只是在听我们说话。是的。"}, {"type": "subtitle", "time": 18716.798, "timestamp": "05:11:56", "text": "不，他们只是在听我们说话。是的。 人们只是笑了。我的天哪，这些"}, {"type": "subtitle", "time": 18718.638, "timestamp": "05:11:58", "text": "人们只是笑了。我的天哪，这些 这些愚蠢的书呆子，然后他们就……"}]
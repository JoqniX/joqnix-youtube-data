[{"type": "subtitle", "time": 15180.149, "timestamp": "04:13:00", "text": "你知道吗？我可以做到，但我"}, {"type": "subtitle", "time": 15181.91, "timestamp": "04:13:01", "text": "不会说话，也不会说任何事。所以，就像，"}, {"type": "subtitle", "time": 15184.79, "timestamp": "04:13:04", "text": "稍等片刻。呃，好的。等等，什么？"}, {"type": "subtitle", "time": 15187.269, "timestamp": "04:13:07", "text": "我应该再做一次吗？等等，你派我来"}, {"type": "subtitle", "time": 15193.75, "timestamp": "04:13:13", "text": "[音乐]"}, {"type": "subtitle", "time": 15196.389, "timestamp": "04:13:16", "text": "是的，那就是"}, {"type": "subtitle", "time": 15198.229, "timestamp": "04:13:18", "text": "呃"}, {"type": "subtitle", "time": 15200.87, "timestamp": "04:13:20", "text": "单词"}, {"type": "subtitle", "time": 15204.149, "timestamp": "04:13:24", "text": "还有塔尼。哦，对，那也是"}, {"type": "subtitle", "time": 15213.269, "timestamp": "04:13:33", "text": "等等，藤君，你两种语言都会？"}, {"type": "subtitle", "time": 15215.349, "timestamp": "04:13:35", "text": "娜妮。"}, {"type": "subtitle", "time": 15230.55, "timestamp": "04:13:50", "text": "是谁？嗯。"}, {"type": "subtitle", "time": 15232.79, "timestamp": "04:13:52", "text": "对了，呃，雅克，你是不是……"}, {"type": "subtitle", "time": 15235.51, "timestamp": "04:13:55", "text": "就像大学或者像你一样，你只是"}, {"type": "subtitle", "time": 15238.309, "timestamp": "04:13:58", "text": "已经毕业了吧？哦，我完成了"}]
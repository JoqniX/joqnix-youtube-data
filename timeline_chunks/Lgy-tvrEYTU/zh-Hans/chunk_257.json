[{"type": "subtitle", "time": 15421.67, "timestamp": "04:17:01", "text": "我知道一个词叫 chadi chadibo over"}, {"type": "subtitle", "time": 15424.55, "timestamp": "04:17:04", "text": "这意味着跳过并像这样走"}, {"type": "subtitle", "time": 15426.95, "timestamp": "04:17:06", "text": "跳起来走。是的，就像是……"}, {"type": "subtitle", "time": 15429.91, "timestamp": "04:17:09", "text": "字面意义上的插队或跳过队伍。"}, {"type": "subtitle", "time": 15432.309, "timestamp": "04:17:12", "text": "大多数神都喜欢啊，板子"}, {"type": "subtitle", "time": 15434.87, "timestamp": "04:17:14", "text": "嗯，好吧。意思是不要"}, {"type": "subtitle", "time": 15436.87, "timestamp": "04:17:16", "text": "插队之类的。"}, {"type": "subtitle", "time": 15439.11, "timestamp": "04:17:19", "text": "是的。是的。是的。这是。是的。是的。"}, {"type": "subtitle", "time": 15441.429, "timestamp": "04:17:21", "text": "是的。这真挺搞笑的。我觉得我"}, {"type": "subtitle", "time": 15443.349, "timestamp": "04:17:23", "text": "看到有人开玩笑地说这句话"}, {"type": "subtitle", "time": 15447.59, "timestamp": "04:17:27", "text": "公园。游乐园。"}, {"type": "subtitle", "time": 15449.429, "timestamp": "04:17:29", "text": "我当时就想，“哦，我知道这个词。”"}, {"type": "subtitle", "time": 15453.91, "timestamp": "04:17:33", "text": "气。我知道“气”这个词。"}, {"type": "subtitle", "time": 15456.71, "timestamp": "04:17:36", "text": "我知道这是气。意思是跳跃。我当时就想，"}, {"type": "subtitle", "time": 15459.59, "timestamp": "04:17:39", "text": "你是怎么知道的？我不知道。"}, {"type": "subtitle", "time": 15462.309, "timestamp": "04:17:42", "text": "我也有家人。我必须告诉人们"}, {"type": "subtitle", "time": 15466.149, "timestamp": "04:17:46", "text": "南。你是什​​么意思？"}, {"type": "subtitle", "time": 15469.11, "timestamp": "04:17:49", "text": "查万德。 Chawande 的意思是踢，对吧？是"}, {"type": "subtitle", "time": 15472.229, "timestamp": "04:17:52", "text": "是吗？呃，我想是有的。"}, {"type": "subtitle", "time": 15474.71, "timestamp": "04:17:54", "text": "差不多就是这样。是的。哦，踢。呃"}, {"type": "subtitle", "time": 15478.87, "timestamp": "04:17:58", "text": "chawi 像 chanti。哦，是的。我们有"}]
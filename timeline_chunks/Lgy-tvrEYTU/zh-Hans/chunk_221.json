[{"type": "subtitle", "time": 13262.63, "timestamp": "03:41:02", "text": "遇到不配合的病人"}, {"type": "subtitle", "time": 13265.75, "timestamp": "03:41:05", "text": "比如，不想接受治疗"}, {"type": "subtitle", "time": 13268.309, "timestamp": "03:41:08", "text": "或者其他什么。并非他们不这样做"}, {"type": "subtitle", "time": 13270.229, "timestamp": "03:41:10", "text": "他们想要接受治疗，他们只是想……"}, {"type": "subtitle", "time": 13274.15, "timestamp": "03:41:14", "text": "模糊不清，对吧？嗯。"}, {"type": "subtitle", "time": 13279.03, "timestamp": "03:41:19", "text": "今天有一位病人"}, {"type": "subtitle", "time": 13282.469, "timestamp": "03:41:22", "text": "谁说呃，所以现在我进去了"}, {"type": "subtitle", "time": 13285.269, "timestamp": "03:41:25", "text": "牙科修复学系"}, {"type": "subtitle", "time": 13288.15, "timestamp": "03:41:28", "text": "字面意义上的替换你的牙齿。那是"}, {"type": "subtitle", "time": 13291.67, "timestamp": "03:41:31", "text": "它。这就是它的字面意思。所以"}, {"type": "subtitle", "time": 13295.19, "timestamp": "03:41:35", "text": "我当时……呃……在我的"}, {"type": "subtitle", "time": 13298.07, "timestamp": "03:41:38", "text": "在办公室里，我没招惹任何人。"}, {"type": "subtitle", "time": 13301.83, "timestamp": "03:41:41", "text": "有人来了，希德利·迪德利"}, {"type": "subtitle", "time": 13305.19, "timestamp": "03:41:45", "text": "他说，呃，我想确认一下，好的。"}, {"type": "subtitle", "time": 13307.83, "timestamp": "03:41:47", "text": "我们去看看，然后我就给他看了看。"}, {"type": "subtitle", "time": 13311.67, "timestamp": "03:41:51", "text": "醒来后，他发现自己的牙齿全掉了。"}, {"type": "subtitle", "time": 13315.99, "timestamp": "03:41:55", "text": "烂掉了，我就说，嗯，不行，我们不能这样"}, {"type": "subtitle", "time": 13318.229, "timestamp": "03:41:58", "text": "做任何我们无能为力的事"}]
[{"type": "subtitle", "time": 15301.99, "timestamp": "04:15:01", "text": "美好的。哦等等，他其实写了"}, {"type": "subtitle", "time": 15304.07, "timestamp": "04:15:04", "text": "给你准备了一份礼物。"}, {"type": "subtitle", "time": 15306.95, "timestamp": "04:15:06", "text": "哦真的吗？呃"}, {"type": "subtitle", "time": 15308.469, "timestamp": "04:15:08", "text": "嗯，好的。我只是要去，我只是"}, {"type": "subtitle", "time": 15314.79, "timestamp": "04:15:14", "text": "等待。呃，你想要链接吗？"}, {"type": "subtitle", "time": 15316.87, "timestamp": "04:15:16", "text": "阅读"}, {"type": "subtitle", "time": 15320.95, "timestamp": "04:15:20", "text": "嗯，你是想在线聊天还是观看直播？"}, {"type": "subtitle", "time": 15329.429, "timestamp": "04:15:29", "text": "我希望你说过"}, {"type": "subtitle", "time": 15331.269, "timestamp": "04:15:31", "text": "是的，"}, {"type": "subtitle", "time": 15333.91, "timestamp": "04:15:33", "text": "意思是：你好吗？"}, {"type": "subtitle", "time": 15337.75, "timestamp": "04:15:37", "text": "是的，我很棒。我很好。感谢"}, {"type": "subtitle", "time": 15340.55, "timestamp": "04:15:40", "text": "你。"}, {"type": "subtitle", "time": 15347.67, "timestamp": "04:15:47", "text": "我只是重复了我说过的话，但是在"}, {"type": "subtitle", "time": 15350.63, "timestamp": "04:15:50", "text": "泰米尔语是“嗯”。"}, {"type": "subtitle", "time": 15353.51, "timestamp": "04:15:53", "text": "我猜这就像换班一样非常困难。"}, {"type": "subtitle", "time": 15356.55, "timestamp": "04:15:56", "text": "就像英语到泰米尔语的转变一样，这很令人感动。"}]
[{"type": "subtitle", "time": 13981.51, "timestamp": "03:53:01", "text": "我甚至都说不出口，因为"}, {"type": "subtitle", "time": 13989.349, "timestamp": "03:53:09", "text": "但是专业人士呃，不过随便吧"}, {"type": "subtitle", "time": 13991.91, "timestamp": "03:53:11", "text": "事情的经过就像我突然变成了那样，我当时"}, {"type": "subtitle", "time": 13993.83, "timestamp": "03:53:13", "text": "很幸运能接受培训"}, {"type": "subtitle", "time": 13996.309, "timestamp": "03:53:16", "text": "这几个家伙。所以就像往常一样，随便什么"}, {"type": "subtitle", "time": 13997.83, "timestamp": "03:53:17", "text": "他们说，喜欢，不喜欢，保持沉默"}, {"type": "subtitle", "time": 13999.269, "timestamp": "03:53:19", "text": "你自己。这就是问题所在。喜欢"}, {"type": "subtitle", "time": 14000.469, "timestamp": "03:53:20", "text": "你不会用它做任何事。"}, {"type": "subtitle", "time": 14003.03, "timestamp": "03:53:23", "text": "所以如果你教的话，那就更好了。"}, {"type": "subtitle", "time": 14004.71, "timestamp": "03:53:24", "text": "就像你必须教你所教的一切一样"}, {"type": "subtitle", "time": 14007.11, "timestamp": "03:53:27", "text": "就像学习一样，因为学习是一种倍增。"}, {"type": "subtitle", "time": 14009.03, "timestamp": "03:53:29", "text": "你的学习。如果出了什么问题"}, {"type": "subtitle", "time": 14012.389, "timestamp": "03:53:32", "text": "现在你知道了，就像现在，就像你现在一样"}, {"type": "subtitle", "time": 14014.309, "timestamp": "03:53:34", "text": "现在就用你自己的方式去想吧"}, {"type": "subtitle", "time": 14016.79, "timestamp": "03:53:36", "text": "比如用你自己的方式去获得它，然后"}, {"type": "subtitle", "time": 14018.87, "timestamp": "03:53:38", "text": "这就是我了解大部分事情的方式。"}, {"type": "subtitle", "time": 14021.51, "timestamp": "03:53:41", "text": "这个地方的实验室工作等等"}, {"type": "subtitle", "time": 14023.83, "timestamp": "03:53:43", "text": "主要包括实验室工作，例如实验室"}, {"type": "subtitle", "time": 14026.95, "timestamp": "03:53:46", "text": "背面工作背面"}, {"type": "subtitle", "time": 14029.269, "timestamp": "03:53:49", "text": "场景作品等等，大部分东西"}, {"type": "subtitle", "time": 14033.189, "timestamp": "03:53:53", "text": "那里经常出问题。"}, {"type": "subtitle", "time": 14035.59, "timestamp": "03:53:55", "text": "但我发现我最终还是明白了。"}, {"type": "subtitle", "time": 14037.51, "timestamp": "03:53:57", "text": "就像教别人这样一样，哦，这个"}, {"type": "subtitle", "time": 14039.269, "timestamp": "03:53:59", "text": "发生了什么事？我该怎么办？"}]
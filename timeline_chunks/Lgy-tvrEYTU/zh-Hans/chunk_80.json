[{"type": "subtitle", "time": 4802.47, "timestamp": "01:20:02", "text": "现在？这是故障。我也要去"}, {"type": "subtitle", "time": 4804.39, "timestamp": "01:20:04", "text": "很多。"}, {"type": "subtitle", "time": 4806.709, "timestamp": "01:20:06", "text": "还剩5个击杀目标。我不明白"}, {"type": "subtitle", "time": 4810.149, "timestamp": "01:20:10", "text": "到底发生了什么？"}, {"type": "subtitle", "time": 4812.39, "timestamp": "01:20:12", "text": "停止射击。"}, {"type": "subtitle", "time": 4815.51, "timestamp": "01:20:15", "text": "让我做我的事。"}, {"type": "subtitle", "time": 4830.709, "timestamp": "01:20:30", "text": "棕色的。棕色的。棕色的。这"}, {"type": "subtitle", "time": 4834.229, "timestamp": "01:20:34", "text": "棕色的。这个东西。这个东西。我"}, {"type": "subtitle", "time": 4837.11, "timestamp": "01:20:37", "text": "必须在中间。还剩一分钟。"}, {"type": "subtitle", "time": 4841.03, "timestamp": "01:20:41", "text": "然后是另一种打字机键盘。"}]
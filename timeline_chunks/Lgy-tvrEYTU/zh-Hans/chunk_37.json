[{"type": "subtitle", "time": 2251.03, "timestamp": "00:37:31", "text": "无法避免。我喜欢这种控制感。"}, {"type": "subtitle", "time": 2260.31, "timestamp": "00:37:40", "text": "啊，我没彻底杀人就关掉了。"}, {"type": "subtitle", "time": 2273.67, "timestamp": "00:37:53", "text": "[掌声]"}, {"type": "subtitle", "time": 2276.47, "timestamp": "00:37:56", "text": "你是如何联系到我的？"}, {"type": "subtitle", "time": 2279.43, "timestamp": "00:37:59", "text": "你看到了吗？这里是二和三"}]
[{"type": "subtitle", "time": 15240.95, "timestamp": "04:14:00", "text": "我的12年级。"}, {"type": "subtitle", "time": 15243.99, "timestamp": "04:14:03", "text": "我还没被大学录取，但是"}, {"type": "subtitle", "time": 15247.75, "timestamp": "04:14:07", "text": "我想深入了解一下。"}, {"type": "subtitle", "time": 15259.91, "timestamp": "04:14:19", "text": "我处处充满惊喜。是的，你就是。"}, {"type": "subtitle", "time": 15263.91, "timestamp": "04:14:23", "text": "藤久。充满惊喜。"}, {"type": "subtitle", "time": 15266.63, "timestamp": "04:14:26", "text": "确实非常神秘。嗯？是的。一个"}, {"type": "subtitle", "time": 15279.429, "timestamp": "04:14:39", "text": "嘿。哦，是的。呃，等等。你是什​​么"}, {"type": "subtitle", "time": 15281.75, "timestamp": "04:14:41", "text": "你刚才说什么来着？什么？"}, {"type": "subtitle", "time": 15284.63, "timestamp": "04:14:44", "text": "你想让我做什么？"}, {"type": "subtitle", "time": 15286.95, "timestamp": "04:14:46", "text": "哦，不，不，不。我刚刚就这么做了。它是"}, {"type": "subtitle", "time": 15289.83, "timestamp": "04:14:49", "text": "没关系。我本来想问你"}, {"type": "subtitle", "time": 15294.79, "timestamp": "04:14:54", "text": "就像我想的那样，富士呃打了一整段"}, {"type": "subtitle", "time": 15296.79, "timestamp": "04:14:56", "text": "这句话，感觉就像我不得不把它读出来一样。"}, {"type": "subtitle", "time": 15298.95, "timestamp": "04:14:58", "text": "但就像他刚才说的，是瓶子，所以是"}]
[{"type": "subtitle", "time": 4021.51, "timestamp": "01:07:01", "text": "我已经换过两三次了。嗯"}, {"type": "subtitle", "time": 4024.069, "timestamp": "01:07:04", "text": "我希望它会在……之前崩溃。"}, {"type": "subtitle", "time": 4026.71, "timestamp": "01:07:06", "text": "今年或明年。这就是我的原因"}, {"type": "subtitle", "time": 4029.91, "timestamp": "01:07:09", "text": "害怕的。但如果它下跌，我就不……"}, {"type": "subtitle", "time": 4032.23, "timestamp": "01:07:12", "text": "我不知道该怎么办。它将"}, {"type": "subtitle", "time": 4034.87, "timestamp": "01:07:14", "text": "痛苦。"}, {"type": "subtitle", "time": 4038.549, "timestamp": "01:07:18", "text": "所以，我在想，要么我选择这个方案。"}, {"type": "subtitle", "time": 4043.27, "timestamp": "01:07:23", "text": "或者买最好的，然后开心就好。"}, {"type": "subtitle", "time": 4045.109, "timestamp": "01:07:25", "text": "这意味着我必须确保我不会"}, {"type": "subtitle", "time": 4047.029, "timestamp": "01:07:27", "text": "不要破坏任何东西。务必并希望"}, {"type": "subtitle", "time": 4050.47, "timestamp": "01:07:30", "text": "麦克风没有任何问题。"}, {"type": "subtitle", "time": 4052.87, "timestamp": "01:07:32", "text": "我不知道。麦克风很重要。所以"}, {"type": "subtitle", "time": 4054.95, "timestamp": "01:07:34", "text": "这就是为什么我不想在质量上省钱的原因。"}, {"type": "subtitle", "time": 4058.789, "timestamp": "01:07:38", "text": "攒钱。"}, {"type": "subtitle", "time": 4060.309, "timestamp": "01:07:40", "text": "你可以购买一次，不会再有其他选择。"}, {"type": "subtitle", "time": 4062.789, "timestamp": "01:07:42", "text": "需要买两次。是啊，但是如果"}, {"type": "subtitle", "time": 4065.829, "timestamp": "01:07:45", "text": "发生点什么事儿之类的，对吧？"}, {"type": "subtitle", "time": 4068.05, "timestamp": "01:07:48", "text": "这就是痛点。"}, {"type": "subtitle", "time": 4070.95, "timestamp": "01:07:50", "text": "[音乐]"}, {"type": "subtitle", "time": 4074.23, "timestamp": "01:07:54", "text": "为什么我的键盘是薄膜键盘？"}, {"type": "subtitle", "time": 4078.15, "timestamp": "01:07:58", "text": "带机械轮的？这是什么？"}]
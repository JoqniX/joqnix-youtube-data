[{"type": "subtitle", "time": 5959.35, "timestamp": "01:39:19", "text": "把我送回去。我刚洗完脸。哦"}, {"type": "subtitle", "time": 5963.03, "timestamp": "01:39:23", "text": "我的上帝。我回来了。我回来了。我回来了。"}, {"type": "subtitle", "time": 5973.99, "timestamp": "01:39:33", "text": "我回来了。我在这里。"}, {"type": "subtitle", "time": 5987.51, "timestamp": "01:39:47", "text": "我用班上的材料做了水，那是"}, {"type": "subtitle", "time": 5992.47, "timestamp": "01:39:52", "text": "有点热。有点冷，但又不太冷。"}]
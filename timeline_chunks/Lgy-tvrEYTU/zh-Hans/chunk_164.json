[{"type": "subtitle", "time": 9841.99, "timestamp": "02:44:01", "text": "你看到那边的倾斜标记了吗？为什么"}, {"type": "subtitle", "time": 9845.269, "timestamp": "02:44:05", "text": "它到底有没有复制我的文本内容？"}, {"type": "subtitle", "time": 9847.83, "timestamp": "02:44:07", "text": "也一样吗？"}, {"type": "subtitle", "time": 9849.75, "timestamp": "02:44:09", "text": "嗯？"}, {"type": "subtitle", "time": 9851.75, "timestamp": "02:44:11", "text": "楠，"}, {"type": "subtitle", "time": 9868.15, "timestamp": "02:44:28", "text": "我们再给他打个电话吧。"}, {"type": "subtitle", "time": 9870.07, "timestamp": "02:44:30", "text": "嗯，我的确祝贺过你，而且我也"}, {"type": "subtitle", "time": 9873.269, "timestamp": "02:44:33", "text": "希望你今天过得愉快。"}, {"type": "subtitle", "time": 9875.75, "timestamp": "02:44:35", "text": "哦，谢谢。感谢您迟来的问候。"}, {"type": "subtitle", "time": 9878.469, "timestamp": "02:44:38", "text": "愿望。是的，我今天过得很愉快。呃，我"}, {"type": "subtitle", "time": 9883.51, "timestamp": "02:44:43", "text": "当时你和 Jocknix 一起直播，而且"}, {"type": "subtitle", "time": 9888.469, "timestamp": "02:44:48", "text": "我切蛋糕，我的生日蛋糕，就像你一样"}, {"type": "subtitle", "time": 9891.83, "timestamp": "02:44:51", "text": "蛋糕上写着Jocknik的名字。是的，"}, {"type": "subtitle", "time": 9895.75, "timestamp": "02:44:55", "text": "嗯，蛋糕真的很好吃。"}]
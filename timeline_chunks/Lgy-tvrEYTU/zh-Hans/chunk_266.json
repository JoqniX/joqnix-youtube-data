[{"type": "subtitle", "time": 15961.83, "timestamp": "04:26:01", "text": "会是她吗？等待。我可以放"}, {"type": "subtitle", "time": 15964.55, "timestamp": "04:26:04", "text": "放在哪里？ H."}, {"type": "subtitle", "time": 15967.99, "timestamp": "04:26:07", "text": "我不知道。等待。"}, {"type": "subtitle", "time": 15971.99, "timestamp": "04:26:11", "text": "哦，我不得不把它退回去。"}, {"type": "subtitle", "time": 15974.87, "timestamp": "04:26:14", "text": "等等。"}, {"type": "subtitle", "time": 15980.469, "timestamp": "04:26:20", "text": "难道我没有收到“欢迎回来”之类的回复吗？"}, {"type": "subtitle", "time": 15983.51, "timestamp": "04:26:23", "text": "是的。哦，对不起。你好。欢迎回来，"}, {"type": "subtitle", "time": 15985.189, "timestamp": "04:26:25", "text": "里克。"}, {"type": "subtitle", "time": 15988.149, "timestamp": "04:26:28", "text": "对不起。对不起。对不起。我无法逃脱"}, {"type": "subtitle", "time": 15996.389, "timestamp": "04:26:36", "text": "我的狗狗需要我。我的狗狗需要我"}, {"type": "subtitle", "time": 16006.87, "timestamp": "04:26:46", "text": "他就像在说：“啊，你这个愚蠢的混蛋。滚开。”"}, {"type": "subtitle", "time": 16009.189, "timestamp": "04:26:49", "text": "把我赶出去。我想小便。”虽然小便"}, {"type": "subtitle", "time": 16017.59, "timestamp": "04:26:57", "text": "他绝不会这么做。你会很喜欢"}]
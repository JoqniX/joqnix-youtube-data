[{"type": "subtitle", "time": 14160.87, "timestamp": "03:56:00", "text": "更糟。我不认识任何人。"}, {"type": "subtitle", "time": 14164.07, "timestamp": "03:56:04", "text": "我的教授当时正在流感中讲话。"}, {"type": "subtitle", "time": 14166.63, "timestamp": "03:56:06", "text": "我就是这样得到的。比如 20"}, {"type": "subtitle", "time": 14170.87, "timestamp": "03:56:10", "text": "喜欢吃馅饼的人真的晕倒了。我没有"}, {"type": "subtitle", "time": 14173.51, "timestamp": "03:56:13", "text": "从中看出什么了吗？我想我们已经看到了"}, {"type": "subtitle", "time": 14175.91, "timestamp": "03:56:15", "text": "完整完整 cadaavver。好像我没看见似的。"}, {"type": "subtitle", "time": 14177.99, "timestamp": "03:56:17", "text": "里面的任何内容。我不知道为什么人们"}, {"type": "subtitle", "time": 14181.91, "timestamp": "03:56:21", "text": "晕倒了，但你知道这是"}, {"type": "subtitle", "time": 14184.389, "timestamp": "03:56:24", "text": "不管怎样，就像是人一样。我不"}, {"type": "subtitle", "time": 14187.11, "timestamp": "03:56:27", "text": "知道。嗯。"}, {"type": "subtitle", "time": 14190.07, "timestamp": "03:56:30", "text": "人们害怕鲜血。嗯，我有"}, {"type": "subtitle", "time": 14192.87, "timestamp": "03:56:32", "text": "就像我们有技术人员一样。他非常"}, {"type": "subtitle", "time": 14194.389, "timestamp": "03:56:34", "text": "顺便说一句，很好。他拥有很多"}, {"type": "subtitle", "time": 14197.03, "timestamp": "03:56:37", "text": "他好像有10年的经验"}, {"type": "subtitle", "time": 14200.229, "timestamp": "03:56:40", "text": "工作经验。但是，呃，他聊了一会儿。"}, {"type": "subtitle", "time": 14203.11, "timestamp": "03:56:43", "text": "他说，就像我害怕一样。"}, {"type": "subtitle", "time": 14205.99, "timestamp": "03:56:45", "text": "害怕流血。我当时真的晕倒了。"}, {"type": "subtitle", "time": 14208.87, "timestamp": "03:56:48", "text": "上班第一天就因为我看到血迹"}, {"type": "subtitle", "time": 14213.59, "timestamp": "03:56:53", "text": "在手术台上，呃，我"}, {"type": "subtitle", "time": 14217.51, "timestamp": "03:56:57", "text": "我看到的时候就想，等等，真的吗？"}]
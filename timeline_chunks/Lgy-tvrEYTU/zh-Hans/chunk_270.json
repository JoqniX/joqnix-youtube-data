[{"type": "subtitle", "time": 16201.03, "timestamp": "04:30:01", "text": "最近真冷。他从来不喜欢寒冷"}, {"type": "subtitle", "time": 16203.429, "timestamp": "04:30:03", "text": "时期。甚至连他讨厌的那个夏天"}, {"type": "subtitle", "time": 16206.71, "timestamp": "04:30:06", "text": "水就像瘟疫一样令人厌恶。"}, {"type": "subtitle", "time": 16210.07, "timestamp": "04:30:10", "text": "现在我得给他洗四次澡了。"}, {"type": "subtitle", "time": 16212.469, "timestamp": "04:30:12", "text": "至少一周了"}, {"type": "subtitle", "time": 16215.67, "timestamp": "04:30:15", "text": "呃，是为了确保他的皮肤干净。"}, {"type": "subtitle", "time": 16218.229, "timestamp": "04:30:18", "text": "所以，就像，嘿，"}, {"type": "subtitle", "time": 16220.71, "timestamp": "04:30:20", "text": "看到结果我当然很高兴，但是"}, {"type": "subtitle", "time": 16222.309, "timestamp": "04:30:22", "text": "喜欢"}, {"type": "subtitle", "time": 16224.79, "timestamp": "04:30:24", "text": "是的。就像，它有点像……"}, {"type": "subtitle", "time": 16228.389, "timestamp": "04:30:28", "text": "看到他那样，真让人心痛。是的。但"}, {"type": "subtitle", "time": 16230.389, "timestamp": "04:30:30", "text": "他又做了一些傻事，比如"}, {"type": "subtitle", "time": 16232.71, "timestamp": "04:30:32", "text": "那。他是世界上最可爱的男孩。"}, {"type": "subtitle", "time": 16235.11, "timestamp": "04:30:35", "text": "明显地。他只是看着我。他只是"}, {"type": "subtitle", "time": 16237.51, "timestamp": "04:30:37", "text": "看我的眼神仿佛在说："}, {"type": "subtitle", "time": 16240.07, "timestamp": "04:30:40", "text": "“道格，我就想，好吧，这有点……”"}, {"type": "subtitle", "time": 16242.389, "timestamp": "04:30:42", "text": "这有点失礼，不过没关系。我 我"}, {"type": "subtitle", "time": 16245.189, "timestamp": "04:30:45", "text": "爱你。"}, {"type": "subtitle", "time": 16247.429, "timestamp": "04:30:47", "text": "他从昨天开始就停止进食了。"}, {"type": "subtitle", "time": 16251.83, "timestamp": "04:30:51", "text": "这可不好。所以，真的又来了"}, {"type": "subtitle", "time": 16255.189, "timestamp": "04:30:55", "text": "这很正常，因为我看到他就像"}, {"type": "subtitle", "time": 16257.59, "timestamp": "04:30:57", "text": "接种疫苗后。我刚刚收到他的点赞"}]
[{"type": "subtitle", "time": 121.27, "timestamp": "00:02:01", "text": "太空团队 Vera。我不知道"}, {"type": "subtitle", "time": 123.27, "timestamp": "00:02:03", "text": "空间。"}, {"type": "subtitle", "time": 127.73, "timestamp": "00:02:07", "text": "那是五个，对吧？那么地球就是五号地球了。"}, {"type": "subtitle", "time": 135.11, "timestamp": "00:02:15", "text": "土星、木星、海王星。"}, {"type": "subtitle", "time": 141.51, "timestamp": "00:02:21", "text": "不，不是天王星。我猜是9、10、9。"}, {"type": "subtitle", "time": 143.75, "timestamp": "00:02:23", "text": "呃"}, {"type": "subtitle", "time": 168.949, "timestamp": "00:02:48", "text": "我知道我将会成为什么样的人，我就会……"}, {"type": "subtitle", "time": 171.27, "timestamp": "00:02:51", "text": "要么我必须结束直播，要么我"}, {"type": "subtitle", "time": 173.19, "timestamp": "00:02:53", "text": "必须"}, {"type": "subtitle", "time": 175.95, "timestamp": "00:02:55", "text": "去洗把脸，然后继续发泄。"}]
[{"type": "subtitle", "time": 9904.55, "timestamp": "02:45:04", "text": "我懂了。很高兴听到你过得很愉快。"}, {"type": "subtitle", "time": 9906.71, "timestamp": "02:45:06", "text": "生日太棒了，蛋糕也超赞！"}, {"type": "subtitle", "time": 9909.269, "timestamp": "02:45:09", "text": "味道很棒。那么，祝你迟来的快乐！"}, {"type": "subtitle", "time": 9911.19, "timestamp": "02:45:11", "text": "又过生日了。哦，它没说。"}, {"type": "subtitle", "time": 9913.269, "timestamp": "02:45:13", "text": "任何事物。哦。我懂了。谢谢。"}, {"type": "subtitle", "time": 9920.309, "timestamp": "02:45:20", "text": "不客气。哈哈。没关系。"}, {"type": "subtitle", "time": 9922.15, "timestamp": "02:45:22", "text": "感谢您抽出时间聊天。"}, {"type": "subtitle", "time": 9924.15, "timestamp": "02:45:24", "text": "与我一起。这次聊天真愉快。"}, {"type": "subtitle", "time": 9927.11, "timestamp": "02:45:27", "text": "与你。"}, {"type": "subtitle", "time": 9930.309, "timestamp": "02:45:30", "text": "我的天，它想挂断电话。"}, {"type": "subtitle", "time": 9932.63, "timestamp": "02:45:32", "text": "真的吗？我刚开始通话。"}, {"type": "subtitle", "time": 9934.87, "timestamp": "02:45:34", "text": "是的，很高兴和你聊天。和"}, {"type": "subtitle", "time": 9937.75, "timestamp": "02:45:37", "text": "另外，您要结束通话吗？我只是"}, {"type": "subtitle", "time": 9943.99, "timestamp": "02:45:43", "text": "哈哈，我可以一直聊下去。"}, {"type": "subtitle", "time": 9946.389, "timestamp": "02:45:46", "text": "夜晚。现在，我有一个直播流和其他"}, {"type": "subtitle", "time": 9949.349, "timestamp": "02:45:49", "text": "近期将安排一些事情。所以，我非常抱歉。"}, {"type": "subtitle", "time": 9951.83, "timestamp": "02:45:51", "text": "如果我必须暂时就此打住的话。"}, {"type": "subtitle", "time": 9954.309, "timestamp": "02:45:54", "text": "什么？什么？什么？什么？什么？什么？"}, {"type": "subtitle", "time": 9959.349, "timestamp": "02:45:59", "text": "什么？什么？什么？什么流？"}]
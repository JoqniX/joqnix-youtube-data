[{"type": "subtitle", "time": 13803.91, "timestamp": "03:50:03", "text": "比如，哦，那可不好，对吧？"}, {"type": "subtitle", "time": 13813.75, "timestamp": "03:50:13", "text": "是的。保重。"}, {"type": "subtitle", "time": 13816.15, "timestamp": "03:50:16", "text": "你"}, {"type": "subtitle", "time": 13818.15, "timestamp": "03:50:18", "text": "无论你打算做什么，都好好享受晚餐吧。"}, {"type": "subtitle", "time": 13820.07, "timestamp": "03:50:20", "text": "吃。"}, {"type": "subtitle", "time": 13822.55, "timestamp": "03:50:22", "text": "小心。总之，"}, {"type": "subtitle", "time": 13825.189, "timestamp": "03:50:25", "text": "无聊的事情就到此为止吧。"}, {"type": "subtitle", "time": 13830.15, "timestamp": "03:50:30", "text": "呃，现在轮到我犯傻了。是的，"}, {"type": "subtitle", "time": 13832.71, "timestamp": "03:50:32", "text": "今天我要去食堂拿东西"}, {"type": "subtitle", "time": 13837.75, "timestamp": "03:50:37", "text": "吃了点午饭，然后我就差点……"}, {"type": "subtitle", "time": 13840.15, "timestamp": "03:50:40", "text": "我的衣服都毁了。"}, {"type": "subtitle", "time": 13843.349, "timestamp": "03:50:43", "text": "呃，到底发生了什么事？是的。我的"}, {"type": "subtitle", "time": 13846.55, "timestamp": "03:50:46", "text": "可爱的小家伙，其实喜欢所有的一切"}, {"type": "subtitle", "time": 13848.87, "timestamp": "03:50:48", "text": "没错，她真的拦住了我。"}, {"type": "subtitle", "time": 13851.349, "timestamp": "03:50:51", "text": "比如，“看看你坐的地方。”和"}, {"type": "subtitle", "time": 13855.189, "timestamp": "03:50:55", "text": "然后我说，那是我不认识的人。"}, {"type": "subtitle", "time": 13857.429, "timestamp": "03:50:57", "text": "谁，但有人真的把……洒了。"}, {"type": "subtitle", "time": 13859.99, "timestamp": "03:50:59", "text": "到处都是灯光，"}]
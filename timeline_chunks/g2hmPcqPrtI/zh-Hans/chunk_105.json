[{"type": "subtitle", "time": 6300.95, "timestamp": "01:45:00", "text": "有时候很难看出人们"}, {"type": "subtitle", "time": 6303.27, "timestamp": "01:45:03", "text": "对它们的感受。 我不会撒谎。 我的"}, {"type": "subtitle", "time": 6305.75, "timestamp": "01:45:05", "text": "意思是，这句话也同样适用于我。"}, {"type": "subtitle", "time": 6308.55, "timestamp": "01:45:08", "text": "我刚刚意识到，"}, {"type": "subtitle", "time": 6312.79, "timestamp": "01:45:12", "text": "有些人觉得我的"}, {"type": "subtitle", "time": 6316.95, "timestamp": "01:45:16", "text": "名字很难发音。 我明白了"}, {"type": "subtitle", "time": 6323.03, "timestamp": "01:45:23", "text": "于是达娜"}, {"type": "subtitle", "time": 6325.83, "timestamp": "01:45:25", "text": "拿走了"}, {"type": "subtitle", "time": 6328.47, "timestamp": "01:45:28", "text": "第二瓶。 好了，第三瓶就"}, {"type": "subtitle", "time": 6350.229, "timestamp": "01:45:50", "text": "有人叫我奥吉。 啊，"}]
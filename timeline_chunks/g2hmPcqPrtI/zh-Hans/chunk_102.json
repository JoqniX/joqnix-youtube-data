[{"type": "subtitle", "time": 6130.07, "timestamp": "01:42:10", "text": "你可以收获这个。"}, {"type": "subtitle", "time": 6133.59, "timestamp": "01:42:13", "text": "它看起来像黄金。"}, {"type": "subtitle", "time": 6136.629, "timestamp": "01:42:16", "text": "她为什么是复制品？"}, {"type": "subtitle", "time": 6138.72, "timestamp": "01:42:18", "text": "我听说黑人声称拥有这块黄金。"}]
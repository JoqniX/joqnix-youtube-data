[{"type": "subtitle", "time": 1382.95, "timestamp": "00:23:02", "text": "我想要这个。我不知道。哦，抱歉。"}, {"type": "subtitle", "time": 1385.83, "timestamp": "00:23:05", "text": "我 不知道为什么。我就是很喜欢这种飘逸的"}, {"type": "subtitle", "time": 1389.19, "timestamp": "00:23:09", "text": "直发。"}, {"type": "subtitle", "time": 1391.99, "timestamp": "00:23:11", "text": "只是它对我来说太贵了，"}, {"type": "subtitle", "time": 1401.59, "timestamp": "00:23:21", "text": "唯一一个有刘海的标签"}, {"type": "subtitle", "time": 1404.549, "timestamp": "00:23:24", "text": "。"}, {"type": "subtitle", "time": 1406.87, "timestamp": "00:23:26", "text": "其他的都是“哦，这个"}, {"type": "subtitle", "time": 1408.95, "timestamp": "00:23:28", "text": "有刘海”。好吧，这个也有刘海。嗯，"}, {"type": "subtitle", "time": 1420.23, "timestamp": "00:23:40", "text": "不过我喜欢这个发型。等等，我可以"}, {"type": "subtitle", "time": 1422.71, "timestamp": "00:23:42", "text": "在商店里买到吗？不，你得"}, {"type": "subtitle", "time": 1431.35, "timestamp": "00:23:51", "text": "我得买整套。"}]
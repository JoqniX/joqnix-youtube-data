[{"type": "subtitle", "time": 11641.83, "timestamp": "03:14:01", "text": "你一样，十叔叔。 愿"}, {"type": "subtitle", "time": 11645.429, "timestamp": "03:14:05", "text": "今晚星辰保佑你，守护你，并"}, {"type": "subtitle", "time": 11648.71, "timestamp": "03:14:08", "text": "赐予你美梦。 但你"}, {"type": "subtitle", "time": 11655.67, "timestamp": "03:14:15", "text": "我就把这当作一种赞美吧。"}, {"type": "subtitle", "time": 11657.59, "timestamp": "03:14:17", "text": "不要试图效仿这些江湖"}, {"type": "subtitle", "time": 11671.429, "timestamp": "03:14:31", "text": "绑定到保险库。 好了，我们到此为止"}]
[{"type": "subtitle", "time": 9923.11, "timestamp": "02:45:23", "text": "山门打开了。"}, {"type": "subtitle", "time": 9924.55, "timestamp": "02:45:24", "text": "那边一扇门开了。"}, {"type": "subtitle", "time": 9927.349, "timestamp": "02:45:27", "text": "入场前播放音乐。 或许是为了向"}, {"type": "subtitle", "time": 9929.99, "timestamp": "02:45:29", "text": "月亮女神报喜。 我们"}, {"type": "subtitle", "time": 9937.349, "timestamp": "02:45:37", "text": "顺便说一句，如果我们被困在"}, {"type": "subtitle", "time": 9939.99, "timestamp": "02:45:39", "text": "这个湖底，"}, {"type": "subtitle", "time": 9942.87, "timestamp": "02:45:42", "text": "即使一年后我们也不会饿死。 你知道什么是"}, {"type": "subtitle", "time": 9944.55, "timestamp": "02:45:44", "text": "尸体吗？"}, {"type": "subtitle", "time": 9947.59, "timestamp": "02:45:47", "text": "看来最终还是有人找到她了。 你先请"}, {"type": "subtitle", "time": 9950.389, "timestamp": "02:45:50", "text": "。 我留下来看看"}, {"type": "subtitle", "time": 9953.03, "timestamp": "02:45:53", "text": "。"}]
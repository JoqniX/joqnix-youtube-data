[{"type": "subtitle", "time": 8231.75, "timestamp": "02:17:11", "text": "我的印度菜太好吃了。 我"}, {"type": "subtitle", "time": 8236.87, "timestamp": "02:17:16", "text": "喜欢尝试北印度菜或者"}, {"type": "subtitle", "time": 8239.669, "timestamp": "02:17:19", "text": "印度菜的任何一种。 不，除了"}, {"type": "subtitle", "time": 8242.87, "timestamp": "02:17:22", "text": "南印度人。 气氛完全不一样了。"}, {"type": "subtitle", "time": 8246.79, "timestamp": "02:17:26", "text": "这些香料差别很大。"}, {"type": "subtitle", "time": 8251.83, "timestamp": "02:17:31", "text": "它就像木偶一样。 啊，我明白了。"}, {"type": "subtitle", "time": 8254.79, "timestamp": "02:17:34", "text": "一切都太好了。"}, {"type": "subtitle", "time": 8260.549, "timestamp": "02:17:40", "text": "它有其独特性。"}, {"type": "subtitle", "time": 8262.709, "timestamp": "02:17:42", "text": "呃，"}]
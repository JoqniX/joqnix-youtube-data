[{"type": "subtitle", "time": 5161.11, "timestamp": "01:26:01", "text": "这就是我想要的。我希望它"}, {"type": "subtitle", "time": 5163.43, "timestamp": "01:26:03", "text": "深深地印在我的脑子里，这样我就永远永远永远永远永远永远不会"}, {"type": "subtitle", "time": 5166.55, "timestamp": "01:26:06", "text": "忘记。"}, {"type": "subtitle", "time": 5174.87, "timestamp": "01:26:14", "text": "你今天加入吗？哦，我们只是"}, {"type": "subtitle", "time": 5176.39, "timestamp": "01:26:16", "text": "随便"}, {"type": "subtitle", "time": 5185.35, "timestamp": "01:26:25", "text": "我今天陷入了困境，因为"}, {"type": "subtitle", "time": 5187.91, "timestamp": "01:26:27", "text": "明天就要重置了。我的意思是，"}, {"type": "subtitle", "time": 5192.07, "timestamp": "01:26:32", "text": "几个小时后就要重置了，嗯，新"}, {"type": "subtitle", "time": 5195.669, "timestamp": "01:26:35", "text": "角色上线，剧院重置，蓝色"}, {"type": "subtitle", "time": 5198.39, "timestamp": "01:26:38", "text": "协议重置，主"}, {"type": "subtitle", "time": 5200.95, "timestamp": "01:26:40", "text": "重置，"}, {"type": "subtitle", "time": 5203.27, "timestamp": "01:26:43", "text": "太多东西了。"}, {"type": "subtitle", "time": 5205.35, "timestamp": "01:26:45", "text": "所以我就想，好吧，我不打算刷怪了"}, {"type": "subtitle", "time": 5207.03, "timestamp": "01:26:47", "text": "。我"}, {"type": "subtitle", "time": 5210.709, "timestamp": "01:26:50", "text": "今天就玩玩探索一下，早点睡觉，这样我明天早上"}, {"type": "subtitle", "time": 5214.31, "timestamp": "01:26:54", "text": "就能早起，"}, {"type": "subtitle", "time": 5217.43, "timestamp": "01:26:57", "text": "像今天这样开始我的一天。"}]
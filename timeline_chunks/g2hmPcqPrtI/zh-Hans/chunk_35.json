[{"type": "subtitle", "time": 2107.27, "timestamp": "00:35:07", "text": "我真的很想和你说话，但我"}, {"type": "subtitle", "time": 2115.27, "timestamp": "00:35:15", "text": "总之，我们去打败那只鹅。"}, {"type": "subtitle", "time": 2118.15, "timestamp": "00:35:18", "text": "鹅鸭。"}, {"type": "subtitle", "time": 2121.43, "timestamp": "00:35:21", "text": "我要淹死了。等等，我走"}, {"type": "subtitle", "time": 2125.91, "timestamp": "00:35:25", "text": "你好，"}, {"type": "subtitle", "time": 2134.39, "timestamp": "00:35:34", "text": "哦，鹅鸭在那儿。真糟糕。我"}, {"type": "subtitle", "time": 2137.19, "timestamp": "00:35:37", "text": "看到了。我看到了。哟"}, {"type": "subtitle", "time": 2141.27, "timestamp": "00:35:41", "text": "，你在惹麻烦吗？"}, {"type": "subtitle", "time": 2143.75, "timestamp": "00:35:43", "text": "呃，神秘之剑正在旋转以"}, {"type": "subtitle", "time": 2146.63, "timestamp": "00:35:46", "text": "减少治疗。"}, {"type": "subtitle", "time": 2154.23, "timestamp": "00:35:54", "text": "等等，我该怎么办？打败动物。"}, {"type": "subtitle", "time": 2159.109, "timestamp": "00:35:59", "text": "好吧，我什么都没做。你为什么……"}]
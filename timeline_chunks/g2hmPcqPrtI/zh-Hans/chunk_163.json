[{"type": "subtitle", "time": 9789.03, "timestamp": "02:43:09", "text": "一尊美丽的雕像，虽然它的眼睛被"}, {"type": "subtitle", "time": 9791.03, "timestamp": "02:43:11", "text": "布遮住了。"}, {"type": "subtitle", "time": 9795.429, "timestamp": "02:43:15", "text": "十叔，这是月亮女神吗？"}, {"type": "subtitle", "time": 9795.67, "timestamp": "02:43:15", "text": "是的，"}, {"type": "subtitle", "time": 9797.11, "timestamp": "02:43:17", "text": "月亮女神。"}, {"type": "subtitle", "time": 9804.07, "timestamp": "02:43:24", "text": "她看不见。 她是一名剑术"}, {"type": "subtitle", "time": 9806.71, "timestamp": "02:43:26", "text": "高手。 普通人做不到。"}, {"type": "subtitle", "time": 9809.27, "timestamp": "02:43:29", "text": "但对于月亮女神，"}, {"type": "subtitle", "time": 9812.23, "timestamp": "02:43:32", "text": "我们只能说，当你见到她时，一定要举止"}, {"type": "subtitle", "time": 9815.67, "timestamp": "02:43:35", "text": "得体。"}, {"type": "subtitle", "time": 9817.59, "timestamp": "02:43:37", "text": "湖底仿佛是一个"}, {"type": "subtitle", "time": 9821.429, "timestamp": "02:43:41", "text": "完全隐藏的世界。 但前进的方向在哪里"}]
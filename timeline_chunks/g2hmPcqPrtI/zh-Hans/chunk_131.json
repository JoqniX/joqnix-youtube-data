[{"type": "subtitle", "time": 7861.91, "timestamp": "02:11:01", "text": "我还以为你懂这门课呢。 你已经在那儿待了"}, {"type": "subtitle", "time": 7905.03, "timestamp": "02:11:45", "text": "最好的主意是什么？ 我猜州政府是"}, {"type": "subtitle", "time": 7906.629, "timestamp": "02:11:46", "text": "最好的。"}, {"type": "subtitle", "time": 7909.43, "timestamp": "02:11:49", "text": "等等，西方到底是什么来着？"}, {"type": "subtitle", "time": 7911.589, "timestamp": "02:11:51", "text": "印度西部。 这些州都有哪些来着？ 我的"}, {"type": "subtitle", "time": 7914.149, "timestamp": "02:11:54", "text": "地理很差。"}, {"type": "subtitle", "time": 7918.069, "timestamp": "02:11:58", "text": "印度西部。 嗯，"}, {"type": "subtitle", "time": 7919.91, "timestamp": "02:11:59", "text": "印度西部。"}]
[{"type": "subtitle", "time": 14222.469, "timestamp": "03:57:02", "text": "为什么他们没有做子弹，"}, {"type": "subtitle", "time": 14225.91, "timestamp": "03:57:05", "text": "他们没有为这个"}, {"type": "subtitle", "time": 14227.67, "timestamp": "03:57:07", "text": "启动磁铁的教程，当你"}, {"type": "subtitle", "time": 14230.469, "timestamp": "03:57:10", "text": "输入密码三次时，即"}, {"type": "subtitle", "time": 14232.95, "timestamp": "03:57:12", "text": "西南、西北、西南、西北"}, {"type": "subtitle", "time": 14235.189, "timestamp": "03:57:15", "text": "、西南、西南、"}, {"type": "subtitle", "time": 14238.87, "timestamp": "03:57:18", "text": "西南。 然后，那像生菜一样的石头"}, {"type": "subtitle", "time": 14241.83, "timestamp": "03:57:21", "text": "雕像就会打开。"}, {"type": "subtitle", "time": 14243.189, "timestamp": "03:57:23", "text": "里面藏着宝物。 等等，等等，等等，等等，"}, {"type": "subtitle", "time": 14246.79, "timestamp": "03:57:26", "text": "等等，等等。 西南，西北，"}, {"type": "subtitle", "time": 14249.03, "timestamp": "03:57:29", "text": "西南，西北，西南，"}, {"type": "subtitle", "time": 14251.83, "timestamp": "03:57:31", "text": "西北。 什么？"}, {"type": "subtitle", "time": 14258.469, "timestamp": "03:57:38", "text": "什么？  [笑声]"}, {"type": "subtitle", "time": 14267.11, "timestamp": "03:57:47", "text": "好的。 北、南、左、右。"}]
[{"type": "subtitle", "time": 10503.11, "timestamp": "02:55:03", "text": "哦，你来了。"}, {"type": "subtitle", "time": 10504.71, "timestamp": "02:55:04", "text": "十叔。 你是怎么到这儿来的？"}, {"type": "subtitle", "time": 10506.63, "timestamp": "02:55:06", "text": "我为什么不呢？ 是的"}, {"type": "subtitle", "time": 10507.269, "timestamp": "02:55:07", "text": "，"}, {"type": "subtitle", "time": 10508.469, "timestamp": "02:55:08", "text": "那些尸体都是"}, {"type": "subtitle", "time": 10509.429, "timestamp": "02:55:09", "text": "三年前的，"}, {"type": "subtitle", "time": 10512.23, "timestamp": "02:55:12", "text": "对吧？ 看来那些荣格就是"}, {"type": "subtitle", "time": 10513.03, "timestamp": "02:55:13", "text": "如此。 难道"}, {"type": "subtitle", "time": 10516.07, "timestamp": "02:55:16", "text": "我不应该"}, {"type": "subtitle", "time": 10517.75, "timestamp": "02:55:17", "text": "回到你身边吗？"}, {"type": "subtitle", "time": 10519.99, "timestamp": "02:55:19", "text": "我们分头调查一下如何"}, {"type": "subtitle", "time": 10522.07, "timestamp": "02:55:22", "text": "打开这扇门。"}, {"type": "subtitle", "time": 10530.07, "timestamp": "02:55:30", "text": "想办法打开这扇门。"}, {"type": "subtitle", "time": 10532.63, "timestamp": "02:55:32", "text": "对了，你有没有"}, {"type": "subtitle", "time": 10535.59, "timestamp": "02:55:35", "text": "在湖底见过花？ 碰一下"}, {"type": "subtitle", "time": 10537.83, "timestamp": "02:55:37", "text": "就会瞎眼。 但你的听力"}, {"type": "subtitle", "time": 10545.83, "timestamp": "02:55:45", "text": "你也看到了。 这是什么花？   虽然"}, {"type": "subtitle", "time": 10548.469, "timestamp": "02:55:48", "text": "不能确定，但​​它很像"}, {"type": "subtitle", "time": 10556.23, "timestamp": "02:55:56", "text": "到卷轴上去。"}, {"type": "subtitle", "time": 10558.469, "timestamp": "02:55:58", "text": "它们应该灭绝。"}]
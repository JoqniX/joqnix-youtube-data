[{"type": "subtitle", "time": 6247.03, "timestamp": "01:44:07", "text": "你好吗？"}, {"type": "subtitle", "time": 6248.55, "timestamp": "01:44:08", "text": "喂喂，"}, {"type": "subtitle", "time": 6251.109, "timestamp": "01:44:11", "text": "希望我没有念错你的"}, {"type": "subtitle", "time": 6255.03, "timestamp": "01:44:15", "text": "名字。 欢迎来到"}, {"type": "subtitle", "time": 6265.59, "timestamp": "01:44:25", "text": "我可以偷偷溜出去把他们都干掉吗？ 我"}, {"type": "subtitle", "time": 6268.79, "timestamp": "01:44:28", "text": "不想打架。"}, {"type": "subtitle", "time": 6271.35, "timestamp": "01:44:31", "text": "奥斯吉。 好的。 我希望我的发音"}, {"type": "subtitle", "time": 6273.99, "timestamp": "01:44:33", "text": "正确。"}, {"type": "subtitle", "time": 6286.149, "timestamp": "01:44:46", "text": "他们没看到我和你打架。 杀死你"}, {"type": "subtitle", "time": 6289.189, "timestamp": "01:44:49", "text": "最好的朋友。"}, {"type": "subtitle", "time": 6291.669, "timestamp": "01:44:51", "text": "死。"}, {"type": "subtitle", "time": 6293.35, "timestamp": "01:44:53", "text": "顺便说一句，很抱歉我把你的名字念错了"}]
[{"type": "subtitle", "time": 11883.67, "timestamp": "03:18:03", "text": "哦，进去吧。挤进去。"}, {"type": "subtitle", "time": 11885.84, "timestamp": "03:18:05", "text": "挤进去。 再挤进去。"}, {"type": "subtitle", "time": 11888.56, "timestamp": "03:18:08", "text": "再挤进去。 我们逃了出来。"}, {"type": "subtitle", "time": 11913.11, "timestamp": "03:18:33", "text": "如果我们不这样做，我们就无法在"}, {"type": "subtitle", "time": 11918.87, "timestamp": "03:18:38", "text": "棋盘上划桨。 不，卡奇会毁了这块板。"}]
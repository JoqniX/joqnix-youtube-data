[{"type": "subtitle", "time": 7020.149, "timestamp": "01:57:00", "text": "女的？"}, {"type": "subtitle", "time": 7025.43, "timestamp": "01:57:05", "text": "绅士。 他是一位绅士。 你好。"}, {"type": "subtitle", "time": 7030.55, "timestamp": "01:57:10", "text": "呃，这是个挑战吗？"}, {"type": "subtitle", "time": 7034.47, "timestamp": "01:57:14", "text": "这是一个挑战。 好了，我们走吧。 该"}, {"type": "subtitle", "time": 7040.229, "timestamp": "01:57:20", "text": "的天哪，他会喷火。"}, {"type": "subtitle", "time": 7050.79, "timestamp": "01:57:30", "text": "南迪奥。"}, {"type": "subtitle", "time": 7058.47, "timestamp": "01:57:38", "text": "。  F"}, {"type": "subtitle", "time": 7063.43, "timestamp": "01:57:43", "text": "[笑声]"}, {"type": "subtitle", "time": 7065.99, "timestamp": "01:57:45", "text": "我做不到。"}, {"type": "subtitle", "time": 7067.75, "timestamp": "01:57:47", "text": "回来。 回来。 回来。 朝"}, {"type": "subtitle", "time": 7074.79, "timestamp": "01:57:54", "text": "不，你快到了。  D."}]
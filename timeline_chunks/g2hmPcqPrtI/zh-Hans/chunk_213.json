[{"type": "subtitle", "time": 12788.229, "timestamp": "03:33:08", "text": "你多大了？ 我的意思是，我已经够"}, {"type": "subtitle", "time": 12790.87, "timestamp": "03:33:10", "text": "大了。 我可以酒后驾车。 我"}, {"type": "subtitle", "time": 12801.03, "timestamp": "03:33:21", "text": "呃，"}, {"type": "subtitle", "time": 12804.95, "timestamp": "03:33:24", "text": "只是他们认为我不够"}, {"type": "subtitle", "time": 12808.229, "timestamp": "03:33:28", "text": "成熟，"}, {"type": "subtitle", "time": 12811.03, "timestamp": "03:33:31", "text": "因为我无法在这种混乱的环境中生存下去"}, {"type": "subtitle", "time": 12813.67, "timestamp": "03:33:33", "text": "。   是的"}, {"type": "subtitle", "time": 12815.59, "timestamp": "03:33:35", "text": "。"}, {"type": "subtitle", "time": 12817.59, "timestamp": "03:33:37", "text": "他们之所以让我去"}, {"type": "subtitle", "time": 12819.51, "timestamp": "03:33:39", "text": "日本，唯一的原因是那里有相关"}, {"type": "subtitle", "time": 12822.309, "timestamp": "03:33:42", "text": "机构，我是说学院的人"}, {"type": "subtitle", "time": 12826.309, "timestamp": "03:33:46", "text": "会照顾我，"}, {"type": "subtitle", "time": 12828.07, "timestamp": "03:33:48", "text": "学院里的很多人会照顾我"}, {"type": "subtitle", "time": 12829.349, "timestamp": "03:33:49", "text": "等等。"}, {"type": "subtitle", "time": 12833.19, "timestamp": "03:33:53", "text": "如果我遇到麻烦或者在"}, {"type": "subtitle", "time": 12835.67, "timestamp": "03:33:55", "text": "户外的话。 是的。 是的。 是的。 是的。"}]
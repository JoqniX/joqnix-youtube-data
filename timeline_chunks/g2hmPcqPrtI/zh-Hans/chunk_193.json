[{"type": "subtitle", "time": 11601.99, "timestamp": "03:13:21", "text": "你在哪里找到这朵花的？"}, {"type": "chat", "time": 11603.839, "timestamp": "03:13:23", "author": "@kurunekodream", "avatar": "https://yt4.ggpht.com/RLzqgZjl8ILhIIU27ghgxtcyxaMDaQ4nJQ8GzPmDKVVI7HHPJUZsDQV_Itc49vlXGx8THQhiP90=s64-c-k-c0x00ffffff-no-rj", "message": "muhehehe"}, {"type": "subtitle", "time": 11604.79, "timestamp": "03:13:24", "text": "下面花园里。 那里曾种植过许多这样的花卉"}, {"type": "subtitle", "time": 11608.79, "timestamp": "03:13:28", "text": "，但大多数都枯萎了。"}, {"type": "subtitle", "time": 11611.11, "timestamp": "03:13:31", "text": "只有这一株还在开花。"}, {"type": "subtitle", "time": 11613.19, "timestamp": "03:13:33", "text": "你好，库兰。 欢迎进来。"}, {"type": "subtitle", "time": 11616.309, "timestamp": "03:13:36", "text": "她对他们照顾得无微不至。"}, {"type": "subtitle", "time": 11618.15, "timestamp": "03:13:38", "text": "月亮女神用"}, {"type": "subtitle", "time": 11620.95, "timestamp": "03:13:40", "text": "这些已经灭绝的花朵填满了一个洞穴。 她一定为此付出了"}, {"type": "subtitle", "time": 11624.79, "timestamp": "03:13:44", "text": "很多努力。 但即便如此，这样做"}, {"type": "subtitle", "time": 11627.75, "timestamp": "03:13:47", "text": "值得吗？ 即使死亡来临，她也无法放手"}, {"type": "chat", "time": 11628.554, "timestamp": "03:13:48", "author": "@kurunekodream", "avatar": "https://yt4.ggpht.com/RLzqgZjl8ILhIIU27ghgxtcyxaMDaQ4nJQ8GzPmDKVVI7HHPJUZsDQV_Itc49vlXGx8THQhiP90=s64-c-k-c0x00ffffff-no-rj", "message": "just came to say gn, Good Night joq!"}, {"type": "subtitle", "time": 11629.83, "timestamp": "03:13:49", "text": "。 就像寄信的那个人一样"}, {"type": "subtitle", "time": 11633.91, "timestamp": "03:13:53", "text": "。 他们俩都是古怪的人。"}, {"type": "subtitle", "time": 11635.99, "timestamp": "03:13:55", "text": "只是过来道晚安。 晚安，"}, {"type": "subtitle", "time": 11639.11, "timestamp": "03:13:59", "text": "乔。 你好。 晚安。 晚安。 卡科斯，"}, {"type": "subtitle", "time": 11639.429, "timestamp": "03:13:59", "text": "是吗？   就像"}]
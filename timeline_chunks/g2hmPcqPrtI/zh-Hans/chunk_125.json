[{"type": "subtitle", "time": 7502.229, "timestamp": "02:05:02", "text": "等等，你为什么要吃考拉？"}, {"type": "subtitle", "time": 7507.75, "timestamp": "02:05:07", "text": "它看起来非常可爱、天真无邪、"}, {"type": "subtitle", "time": 7552.87, "timestamp": "02:05:52", "text": "哦，贫民窟。"}, {"type": "subtitle", "time": 7555.75, "timestamp": "02:05:55", "text": "你得走了，"}, {"type": "subtitle", "time": 7559.189, "timestamp": "02:05:59", "text": "我……我……我不太会读片假名。"}]
[{"type": "subtitle", "time": 3901.91, "timestamp": "01:05:01", "text": "去注册吧。是的。而且我"}, {"type": "subtitle", "time": 3937.029, "timestamp": "01:05:37", "text": "我揍了他们。我揍了他们，他们"}, {"type": "subtitle", "time": 3943.91, "timestamp": "01:05:43", "text": "乔治·乔希，下次面试"}, {"type": "subtitle", "time": 3945.349, "timestamp": "01:05:45", "text": "什么的来了，下次你不会说"}]
[{"type": "subtitle", "time": 12562.389, "timestamp": "03:29:22", "text": "萤火虫。   就在"}, {"type": "subtitle", "time": 12564.63, "timestamp": "03:29:24", "text": "我家农舍附近。 现在过来是在"}, {"type": "subtitle", "time": 12566.87, "timestamp": "03:29:26", "text": "旁边。 自从我当"}, {"type": "subtitle", "time": 12581.349, "timestamp": "03:29:41", "text": "现在萤火虫真是太可爱了。"}, {"type": "subtitle", "time": 12585.67, "timestamp": "03:29:45", "text": "我只想在夜晚坐在草地上，躺在长椅上，"}, {"type": "subtitle", "time": 12593.03, "timestamp": "03:29:53", "text": "看看星星，看看"}, {"type": "subtitle", "time": 12597.03, "timestamp": "03:29:57", "text": "萤火虫什么的。 不，是的，我很"}]
[{"type": "subtitle", "time": 8286.23, "timestamp": "02:18:06", "text": "你最喜欢什么？ 我其实不"}, {"type": "subtitle", "time": 8306.629, "timestamp": "02:18:26", "text": "但问题是我不太常吃外面的食物"}, {"type": "subtitle", "time": 8310.15, "timestamp": "02:18:30", "text": "。 只吃家常菜或"}, {"type": "subtitle", "time": 8313.91, "timestamp": "02:18:33", "text": "家里做的食物。"}, {"type": "subtitle", "time": 8317.03, "timestamp": "02:18:37", "text": "南加州美食。"}, {"type": "subtitle", "time": 8320.469, "timestamp": "02:18:40", "text": "我为什么要这么说呢？"}, {"type": "subtitle", "time": 8325.429, "timestamp": "02:18:45", "text": "嗯，是的，我喜欢吃印度香饭，我相信"}, {"type": "subtitle", "time": 8328.95, "timestamp": "02:18:48", "text": "每个印度人都会说他们"}, {"type": "subtitle", "time": 8331.685, "timestamp": "02:18:51", "text": "最喜欢的食物是印度香饭。"}]
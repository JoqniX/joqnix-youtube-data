[{"type": "subtitle", "time": 722.389, "timestamp": "00:12:02", "text": "五人组成的团队，"}, {"type": "subtitle", "time": 725.269, "timestamp": "00:12:05", "text": "对吧？ 为了进行诸如地下"}, {"type": "subtitle", "time": 727.91, "timestamp": "00:12:07", "text": "城探险之类的活动。 感觉"}, {"type": "subtitle", "time": 731.829, "timestamp": "00:12:11", "text": "有点难，因为即使我"}, {"type": "subtitle", "time": 735.11, "timestamp": "00:12:15", "text": "加入了公会，也不是每个人都有空"}, {"type": "subtitle", "time": 737.91, "timestamp": "00:12:17", "text": "。 是的，可以说"}, {"type": "subtitle", "time": 741.269, "timestamp": "00:12:21", "text": "时间有点奇怪，（音乐）也挺奇怪的，而且，呃，我当时也不太爱"}, {"type": "subtitle", "time": 744.23, "timestamp": "00:12:24", "text": "社交，"}, {"type": "subtitle", "time": 747.67, "timestamp": "00:12:27", "text": "不过当时有几个人在场什么的"}, {"type": "subtitle", "time": 751.11, "timestamp": "00:12:31", "text": "，所以我觉得有点"}, {"type": "subtitle", "time": 761.91, "timestamp": "00:12:41", "text": "我当时的想法是，"}, {"type": "subtitle", "time": 764.069, "timestamp": "00:12:44", "text": "你知道吗，"}, {"type": "subtitle", "time": 767.59, "timestamp": "00:12:47", "text": "如果我能"}, {"type": "subtitle", "time": 771.11, "timestamp": "00:12:51", "text": "专注于我真正想玩的游戏，那岂不是更好吗"}, {"type": "subtitle", "time": 773.269, "timestamp": "00:12:53", "text": "？ 如果"}, {"type": "subtitle", "time": 776.949, "timestamp": "00:12:56", "text": "过一段时间我觉得应该放弃，那么是的，我"}, {"type": "subtitle", "time": 779.59, "timestamp": "00:12:59", "text": "可以放弃。 我的意思是，我不知道。"}]
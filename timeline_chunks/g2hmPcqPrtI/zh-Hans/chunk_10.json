[{"type": "subtitle", "time": 600.71, "timestamp": "00:10:00", "text": "所以，[音乐]，"}, {"type": "subtitle", "time": 602.71, "timestamp": "00:10:02", "text": "我想到了流媒体，然后就听到了 Pocket，这"}, {"type": "subtitle", "time": 606.23, "timestamp": "00:10:06", "text": "让我又"}, {"type": "subtitle", "time": 608.63, "timestamp": "00:10:08", "text": "睡着了，好好休息了一会儿。"}, {"type": "subtitle", "time": 610.63, "timestamp": "00:10:10", "text": "所以呢，"}, {"type": "subtitle", "time": 618.069, "timestamp": "00:10:18", "text": "还有什么呢？"}, {"type": "subtitle", "time": 620.79, "timestamp": "00:10:20", "text": "哦，是的。 呃，我最近一直在玩[音乐]，"}, {"type": "subtitle", "time": 624.069, "timestamp": "00:10:24", "text": "就像我一直在"}, {"type": "subtitle", "time": 628.069, "timestamp": "00:10:28", "text": "直播一些游戏一样，比如《"}, {"type": "subtitle", "time": 631.11, "timestamp": "00:10:31", "text": "Two at Night》、《Abyss》、《Blue Protocol》、《What Where"}, {"type": "subtitle", "time": 633.67, "timestamp": "00:10:33", "text": "Events Meet》等等，还有"}, {"type": "subtitle", "time": 635.67, "timestamp": "00:10:35", "text": "很多其他游戏，比如《Farlight》等等。"}, {"type": "subtitle", "time": 639.509, "timestamp": "00:10:39", "text": "顺便说一下，我安装了《Farlight》，然后"}, {"type": "subtitle", "time": 644.47, "timestamp": "00:10:44", "text": "我就想，是的，我不能"}, {"type": "subtitle", "time": 650.23, "timestamp": "00:10:50", "text": "经常玩这些游戏，你知道吗？"}, {"type": "subtitle", "time": 652.87, "timestamp": "00:10:52", "text": "我只能在有时间的时候玩这些游戏"}, {"type": "subtitle", "time": 657.11, "timestamp": "00:10:57", "text": "。 我没那么多时间去肝"}]
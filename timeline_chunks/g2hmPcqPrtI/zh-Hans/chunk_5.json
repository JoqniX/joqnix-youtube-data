[{"type": "subtitle", "time": 302.95, "timestamp": "00:05:02", "text": "Sham Sham，做一些Sammy相关的事情，"}, {"type": "subtitle", "time": 306.629, "timestamp": "00:05:06", "text": "然后完成一些事情。"}, {"type": "subtitle", "time": 311.35, "timestamp": "00:05:11", "text": "然后就停电了（音乐响起）。"}, {"type": "subtitle", "time": 314.39, "timestamp": "00:05:14", "text": "显示发生停电的画面。"}, {"type": "subtitle", "time": 323.27, "timestamp": "00:05:23", "text": "我今天就休息一下，"}, {"type": "subtitle", "time": 328.07, "timestamp": "00:05:28", "text": "晚上或者明天再做吧。 所以我们"}, {"type": "subtitle", "time": 338.31, "timestamp": "00:05:38", "text": "。 你好，Tomat Tomat"}, {"type": "subtitle", "time": 341.99, "timestamp": "00:05:41", "text": "5544。欢迎。"}, {"type": "subtitle", "time": 346.15, "timestamp": "00:05:46", "text": "嗯，欢迎来到直播间。 午夜"}, {"type": "subtitle", "time": 349.59000000000003, "timestamp": "00:05:49", "text": "十进制。 你好。"}, {"type": "subtitle", "time": 351.99, "timestamp": "00:05:51", "text": "呃，"}, {"type": "subtitle", "time": 354.55, "timestamp": "00:05:54", "text": "你知道吗？ 我希望我们能停止"}, {"type": "subtitle", "time": 356.87, "timestamp": "00:05:56", "text": "经历历史事件，因为"}, {"type": "subtitle", "time": 359.67, "timestamp": "00:05:59", "text": "那样事情就变得很可怕了。 嗯？"}]
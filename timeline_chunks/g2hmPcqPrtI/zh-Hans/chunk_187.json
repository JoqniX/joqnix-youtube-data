[{"type": "subtitle", "time": 11221.75, "timestamp": "03:07:01", "text": "这家伙真是煞费苦心。 寄送"}, {"type": "subtitle", "time": 11224.15, "timestamp": "03:07:04", "text": "眼神，寄送信件，为了一个"}, {"type": "subtitle", "time": 11227.75, "timestamp": "03:07:07", "text": "早已逝去的人做这么多麻烦事。 我"}, {"type": "subtitle", "time": 11229.83, "timestamp": "03:07:09", "text": "想知道为什么。"}, {"type": "subtitle", "time": 11239.429, "timestamp": "03:07:19", "text": "好的。"}, {"type": "subtitle", "time": 11241.03, "timestamp": "03:07:21", "text": "丁叔叔，你怎么了？"}, {"type": "subtitle", "time": 11243.67, "timestamp": "03:07:23", "text": "我无法替换它们。"}, {"type": "subtitle", "time": 11244.95, "timestamp": "03:07:24", "text": "为什么不呢？"}, {"type": "subtitle", "time": 11247.67, "timestamp": "03:07:27", "text": "她不希望换眼睛。 即使"}, {"type": "subtitle", "time": 11250.15, "timestamp": "03:07:30", "text": "治疗师怀着最好的意愿，我们也不能"}, {"type": "subtitle", "time": 11253.269, "timestamp": "03:07:33", "text": "强求。 她想要的并不是"}]
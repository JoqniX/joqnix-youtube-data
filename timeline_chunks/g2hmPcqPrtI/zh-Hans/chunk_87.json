[{"type": "subtitle", "time": 5220.55, "timestamp": "01:27:00", "text": "早上6点起床。不， 早上五点"}, {"type": "subtitle", "time": 5223.669, "timestamp": "01:27:03", "text": "准备一切，洗漱一番，"}, {"type": "subtitle", "time": 5225.91, "timestamp": "01:27:05", "text": "六点开始一天的工作。"}, {"type": "subtitle", "time": 5227.51, "timestamp": "01:27:07", "text": "嗯，"}, {"type": "subtitle", "time": 5230.07, "timestamp": "01:27:10", "text": "我想那样做。"}, {"type": "subtitle", "time": 5245.189, "timestamp": "01:27:25", "text": "如果你不凭记忆写作，那肯定会不"}, {"type": "subtitle", "time": 5246.629, "timestamp": "01:27:26", "text": "一样。但如果你能打字，那就没"}, {"type": "subtitle", "time": 5248.31, "timestamp": "01:27:28", "text": "问题。这样就不会从你的"}, {"type": "subtitle", "time": 5250.229, "timestamp": "01:27:30", "text": "脑子里消失了。你仍然能够写作和"}, {"type": "subtitle", "time": 5264.95, "timestamp": "01:27:44", "text": "好像写了好多平装本。"}, {"type": "subtitle", "time": 5268.47, "timestamp": "01:27:48", "text": "我能做到，而且我能背下来，"}, {"type": "subtitle", "time": 5274.47, "timestamp": "01:27:54", "text": "但是说到片假名，我"}, {"type": "subtitle", "time": 5277.27, "timestamp": "01:27:57", "text": "觉得我没有投入太多精力，"}]
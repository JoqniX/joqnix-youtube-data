[{"type": "subtitle", "time": 783.91, "timestamp": "00:13:03", "text": "说实话，情况因人而异。"}, {"type": "subtitle", "time": 790.15, "timestamp": "00:13:10", "text": "呃，稍等一下"}, {"type": "subtitle", "time": 792.389, "timestamp": "00:13:12", "text": "。"}, {"type": "subtitle", "time": 795.59, "timestamp": "00:13:15", "text": "实际上情况各不相同。 这也适用于像《"}, {"type": "subtitle", "time": 799.19, "timestamp": "00:13:19", "text": "枯萎之"}, {"type": "subtitle", "time": 802.629, "timestamp": "00:13:22", "text": "波》、《原神》这样的抽卡游戏，"}, {"type": "subtitle", "time": 805.829, "timestamp": "00:13:25", "text": "以及这类游戏，"}, {"type": "subtitle", "time": 808.47, "timestamp": "00:13:28", "text": "对吧？"}, {"type": "subtitle", "time": 815.269, "timestamp": "00:13:35", "text": "我不知道其他人是怎么做到的"}, {"type": "subtitle", "time": 823.43, "timestamp": "00:13:43", "text": "真的不知道其他人是怎么"}, {"type": "subtitle", "time": 826.71, "timestamp": "00:13:46", "text": "做到的。 他们是如何做到"}, {"type": "subtitle", "time": 831.509, "timestamp": "00:13:51", "text": "每天都关注每一场比赛的？ 即使你"}]
[{"type": "subtitle", "time": 14719.91, "timestamp": "04:05:19", "text": "不，我把你双重卡住了。 愚蠢的。 假的。"}, {"type": "subtitle", "time": 14728.15, "timestamp": "04:05:28", "text": "我的天啊。"}, {"type": "subtitle", "time": 14730.87, "timestamp": "04:05:30", "text": "好的，它识别到了。 为什么会有"}, {"type": "subtitle", "time": 14733.51, "timestamp": "04:05:33", "text": "延误？ 我的天啊。 快点。 给我"}, {"type": "subtitle", "time": 14749.349, "timestamp": "04:05:49", "text": "好的。"}, {"type": "subtitle", "time": 14751.67, "timestamp": "04:05:51", "text": "一、"}, {"type": "subtitle", "time": 14754.309, "timestamp": "04:05:54", "text": "二、"}, {"type": "subtitle", "time": 14756.95, "timestamp": "04:05:56", "text": "三、"}]
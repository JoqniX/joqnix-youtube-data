[{"type": "subtitle", "time": 11128.95, "timestamp": "03:05:28", "text": "忘了这个词？"}, {"type": "subtitle", "time": 11131.03, "timestamp": "03:05:31", "text": "十叔。"}, {"type": "subtitle", "time": 11133.67, "timestamp": "03:05:33", "text": "她去世了吗？"}, {"type": "subtitle", "time": 11138.55, "timestamp": "03:05:38", "text": "珍，月亮女神。 我们来晚了。"}, {"type": "subtitle", "time": 11140.87, "timestamp": "03:05:40", "text": "她也已经去世3年了。"}, {"type": "subtitle", "time": 11143.59, "timestamp": "03:05:43", "text": "三年。"}, {"type": "subtitle", "time": 11145.67, "timestamp": "03:05:45", "text": "似乎在三年前的那场战斗中"}, {"type": "subtitle", "time": 11147.67, "timestamp": "03:05:47", "text": "，她的敌人都死在了"}, {"type": "subtitle", "time": 11149.75, "timestamp": "03:05:49", "text": "湖底。"}, {"type": "subtitle", "time": 11151.91, "timestamp": "03:05:51", "text": "但她也没能成功。"}, {"type": "subtitle", "time": 11155.75, "timestamp": "03:05:55", "text": "那么你收到的那封信呢？   这"}]
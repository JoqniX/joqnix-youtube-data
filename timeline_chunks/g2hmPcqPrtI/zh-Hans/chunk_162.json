[{"type": "subtitle", "time": 9732.23, "timestamp": "02:42:12", "text": "哇。 费德勒"}, {"type": "subtitle", "time": 9735.19, "timestamp": "02:42:15", "text": "很聪明，不是吗？ 现在我们"}, {"type": "subtitle", "time": 9736.309, "timestamp": "02:42:16", "text": "十号叔叔"}, {"type": "subtitle", "time": 9738.642, "timestamp": "02:42:18", "text": "布莱克也这么做了。"}, {"type": "subtitle", "time": 9739.429, "timestamp": "02:42:19", "text": "[笑声] 是"}, {"type": "subtitle", "time": 9742.15, "timestamp": "02:42:22", "text": "啊，真机智。"}, {"type": "subtitle", "time": 9745.51, "timestamp": "02:42:25", "text": "啊，我可是费了好大劲才想出那个笑话的。"}, {"type": "subtitle", "time": 9748.23, "timestamp": "02:42:28", "text": "没关系。 我们走吧。"}, {"type": "subtitle", "time": 9752.63, "timestamp": "02:42:32", "text": "哦，他简直像猴子一样乱窜。"}, {"type": "subtitle", "time": 9774.71, "timestamp": "02:42:54", "text": "哦，有个黏糊糊的奇怪东西"}]
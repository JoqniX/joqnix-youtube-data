[{"type": "subtitle", "time": 8286.23, "timestamp": "02:18:06", "text": "あなたのお気に入りは何ですか？ 実のところ、よくわからないんです"}, {"type": "subtitle", "time": 8306.629, "timestamp": "02:18:26", "text": "でも、実は私は外食をあまりしないんです"}, {"type": "subtitle", "time": 8310.15, "timestamp": "02:18:30", "text": "。 自家製の食べ物、または"}, {"type": "subtitle", "time": 8313.91, "timestamp": "02:18:33", "text": "家で作られたものだけ。"}, {"type": "subtitle", "time": 8317.03, "timestamp": "02:18:37", "text": "サウスランド料理。"}, {"type": "subtitle", "time": 8320.469, "timestamp": "02:18:40", "text": "なぜ私はそんなことを言うのだろう？   ええ、"}, {"type": "subtitle", "time": 8325.429, "timestamp": "02:18:45", "text": "ビリヤニは好きです。"}, {"type": "subtitle", "time": 8328.95, "timestamp": "02:18:48", "text": "インド人なら誰でも、一番"}, {"type": "subtitle", "time": 8331.685, "timestamp": "02:18:51", "text": "好きなのはビリヤニだと言うでしょう。"}]
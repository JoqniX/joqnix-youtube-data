[{"type": "subtitle", "time": 2107.27, "timestamp": "00:35:07", "text": "本当に君と話したいのに、"}, {"type": "subtitle", "time": 2115.27, "timestamp": "00:35:15", "text": "とにかく、ガチョウを倒しに行く。ガチョウの"}, {"type": "subtitle", "time": 2118.15, "timestamp": "00:35:18", "text": "アヒル。"}, {"type": "subtitle", "time": 2121.43, "timestamp": "00:35:21", "text": "溺れに行く。待って、"}, {"type": "subtitle", "time": 2134.39, "timestamp": "00:35:34", "text": "ああ、ガチョウのアヒルがいる。くそ。見える。見える"}, {"type": "subtitle", "time": 2137.19, "timestamp": "00:35:37", "text": "。"}, {"type": "subtitle", "time": 2141.27, "timestamp": "00:35:41", "text": "おい、お前、トラブルを起こしてるのか？"}, {"type": "subtitle", "time": 2143.75, "timestamp": "00:35:43", "text": "えっと、神秘の剣は回転運動で"}, {"type": "subtitle", "time": 2146.63, "timestamp": "00:35:46", "text": "回復を減らす。"}, {"type": "subtitle", "time": 2154.23, "timestamp": "00:35:54", "text": "待って、どうすればいいんだ？動物を倒す。わかった"}, {"type": "subtitle", "time": 2159.109, "timestamp": "00:35:59", "text": "、何もしてない。なぜお前はああ、なんてことだ。それを"}]
[{"type": "subtitle", "time": 9842.309, "timestamp": "02:44:02", "text": "ねえ、どうしたの？   一体何がそんなに"}, {"type": "subtitle", "time": 9850.15, "timestamp": "02:44:10", "text": "しかし、強力だ。 台座の模様をよく見てください"}, {"type": "subtitle", "time": 9851.59, "timestamp": "02:44:11", "text": "。 それらは"}, {"type": "subtitle", "time": 9855.11, "timestamp": "02:44:15", "text": "リンクパターンセットに似ている。   わかった"}]
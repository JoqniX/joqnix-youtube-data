[{"type": "subtitle", "time": 10503.11, "timestamp": "02:55:03", "text": "ああ、ここにいたんですね。   テンおじさん"}, {"type": "subtitle", "time": 10504.71, "timestamp": "02:55:04", "text": "。 どうやってここに来たのですか？"}, {"type": "subtitle", "time": 10506.63, "timestamp": "02:55:06", "text": "なぜそうしないのか？"}, {"type": "subtitle", "time": 10508.469, "timestamp": "02:55:08", "text": "それらの遺体はすべて"}, {"type": "subtitle", "time": 10509.429, "timestamp": "02:55:09", "text": "3年間ですよね"}, {"type": "subtitle", "time": 10512.23, "timestamp": "02:55:12", "text": "？"}, {"type": "subtitle", "time": 10513.03, "timestamp": "02:55:13", "text": "当時、彼らはそうだったようだ。  「"}, {"type": "subtitle", "time": 10516.07, "timestamp": "02:55:16", "text": "私は"}, {"type": "subtitle", "time": 10517.75, "timestamp": "02:55:17", "text": "あなたに戻らなければならない」ということではありませんか。"}, {"type": "subtitle", "time": 10519.99, "timestamp": "02:55:19", "text": "分かれて、"}, {"type": "subtitle", "time": 10522.07, "timestamp": "02:55:22", "text": "この扉を開ける方法を調べてみよう。   わかった"}, {"type": "subtitle", "time": 10530.07, "timestamp": "02:55:30", "text": "この扉を起動させる方法を見つけてください。"}, {"type": "subtitle", "time": 10532.63, "timestamp": "02:55:32", "text": "ところで、"}, {"type": "subtitle", "time": 10535.59, "timestamp": "02:55:35", "text": "湖底で花を見かけたことはありますか？ それに触れると失明する"}, {"type": "subtitle", "time": 10537.83, "timestamp": "02:55:37", "text": "。 しかし、あなたの聴力はより"}, {"type": "subtitle", "time": 10545.83, "timestamp": "02:55:45", "text": "あなたも見たことがあるでしょう。 これは何の花ですか？"}, {"type": "subtitle", "time": 10548.469, "timestamp": "02:55:48", "text": "確証はないが、巻物"}, {"type": "subtitle", "time": 10550.309, "timestamp": "02:55:50", "text": "に描かれている月光花に似ている"}, {"type": "subtitle", "time": 10556.23, "timestamp": "02:55:56", "text": "巻物へ。"}, {"type": "subtitle", "time": 10558.469, "timestamp": "02:55:58", "text": "彼らは絶滅すべきだ。"}]
[{"type": "subtitle", "time": 4564.39, "timestamp": "01:16:04", "text": "ねえ、君はそれをするつもり？"}, {"type": "subtitle", "time": 4589.59, "timestamp": "01:16:29", "text": "独学、忍耐、そして"}, {"type": "subtitle", "time": 4592.149, "timestamp": "01:16:32", "text": "もしそれが私だったら、もしそれが私だったら、そして独学、"}, {"type": "subtitle", "time": 4594.07, "timestamp": "01:16:34", "text": "でもそれは絶対に起こらないだろう、"}, {"type": "subtitle", "time": 4597.189, "timestamp": "01:16:37", "text": "なぜなら私は先"}, {"type": "subtitle", "time": 4599.669, "timestamp": "01:16:39", "text": "延ばしモードになって、"}, {"type": "subtitle", "time": 4604.149, "timestamp": "01:16:44", "text": "「わあ、人生って何？」って思うから。空気がすごく"}, {"type": "subtitle", "time": 4607.27, "timestamp": "01:16:47", "text": "いい。木々がすごくいい感じ"}, {"type": "subtitle", "time": 4609.189, "timestamp": "01:16:49", "text": "。"}, {"type": "subtitle", "time": 4612.63, "timestamp": "01:16:52", "text": "自然の中で暮らして、良い人生と安定を手に入れたい。ただ、大学をサボり"}]
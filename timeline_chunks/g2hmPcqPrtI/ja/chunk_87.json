[{"type": "subtitle", "time": 5220.55, "timestamp": "01:27:00", "text": "6時に起きる。いや、5時に起きて、準備を整えて"}, {"type": "subtitle", "time": 5223.669, "timestamp": "01:27:03", "text": "、身支度をして、"}, {"type": "subtitle", "time": 5225.91, "timestamp": "01:27:05", "text": "6時から一日を始める。"}, {"type": "subtitle", "time": 5227.51, "timestamp": "01:27:07", "text": "うん、"}, {"type": "subtitle", "time": 5230.07, "timestamp": "01:27:10", "text": "そうしたい。より"}, {"type": "subtitle", "time": 5245.189, "timestamp": "01:27:25", "text": "記憶から書かないと、"}, {"type": "subtitle", "time": 5246.629, "timestamp": "01:27:26", "text": "違うことになる。でも、タイプできるならそれでいい"}, {"type": "subtitle", "time": 5248.31, "timestamp": "01:27:28", "text": "。それは脳から離れない"}, {"type": "subtitle", "time": 5250.229, "timestamp": "01:27:30", "text": "。それでも、書いたり"}, {"type": "subtitle", "time": 5264.95, "timestamp": "01:27:44", "text": "ひらがなをたくさん書いたような気がする。 できるところまではできる"}, {"type": "subtitle", "time": 5268.47, "timestamp": "01:27:48", "text": "けど、暗記してるんだよね。"}, {"type": "subtitle", "time": 5274.47, "timestamp": "01:27:54", "text": "でもカタカナに関しては、あまり"}, {"type": "subtitle", "time": 5277.27, "timestamp": "01:27:57", "text": "努力してないと思うから、時々"}]
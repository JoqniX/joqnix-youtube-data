[{"type": "subtitle", "time": 6602.629, "timestamp": "01:50:02", "text": "そして足を骨折したら、えっと、"}, {"type": "subtitle", "time": 6610.79, "timestamp": "01:50:10", "text": "ええ、足を骨折したら、まず"}, {"type": "subtitle", "time": 6615.669, "timestamp": "01:50:15", "text": "捻挫することになります。"}, {"type": "subtitle", "time": 6618.87, "timestamp": "01:50:18", "text": "捻挫を治さないと"}, {"type": "subtitle", "time": 6622.39, "timestamp": "01:50:22", "text": "骨の損傷になり、その後も"}, {"type": "subtitle", "time": 6625.109, "timestamp": "01:50:25", "text": "骨の損傷を治さないと"}, {"type": "subtitle", "time": 6631.189, "timestamp": "01:50:31", "text": "中程度の重傷になり、それでも治らず、"}, {"type": "chat", "time": 6635.556, "timestamp": "01:50:35", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "hi"}, {"type": "subtitle", "time": 6637.189, "timestamp": "01:50:37", "text": "医者を探したり、他のプレイヤーに治してもらったり、自分で治したりしないと、非常に"}, {"type": "chat", "time": 6638.343, "timestamp": "01:50:38", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "joq"}, {"type": "chat", "time": 6640.436, "timestamp": "01:50:40", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "hru"}, {"type": "subtitle", "time": 6646.229, "timestamp": "01:50:46", "text": "重傷になり、"}, {"type": "subtitle", "time": 6649.59, "timestamp": "01:50:49", "text": "動けなくなります。 あなたは全く動けません。"}, {"type": "subtitle", "time": 6653.27, "timestamp": "01:50:53", "text": "足が折れる瞬間が来る。 そう、"}, {"type": "subtitle", "time": 6656.95, "timestamp": "01:50:56", "text": "心、臓器、経絡、筋肉があるんだ。"}]
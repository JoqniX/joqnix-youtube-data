[{"type": "subtitle", "time": 4299.51, "timestamp": "01:11:39", "text": "。ああ、クレジットスコア"}, {"type": "subtitle", "time": 4305.91, "timestamp": "01:11:45", "text": "つまり、私は 学位は持ってるよね？"}, {"type": "subtitle", "time": 4311.91, "timestamp": "01:11:51", "text": "あちらで30年か3年くらいなら十分かもしれない。"}, {"type": "subtitle", "time": 4314.149, "timestamp": "01:11:54", "text": "運が良ければ、単位を移行できるかもしれない。"}, {"type": "subtitle", "time": 4316.229, "timestamp": "01:11:56", "text": "彼がそう言ってた。もしくは、"}]
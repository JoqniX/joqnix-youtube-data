[{"type": "subtitle", "time": 3972.15, "timestamp": "01:06:12", "text": "スリックブランドを繰り返す。それは"}, {"type": "subtitle", "time": 3973.829, "timestamp": "01:06:13", "text": "日本語？うん、"}, {"type": "subtitle", "time": 3976.309, "timestamp": "01:06:16", "text": "日本語を勉強するはずだったんだけど、今は一人で"}, {"type": "subtitle", "time": 3978.15, "timestamp": "01:06:18", "text": "どこに行けばいいのか分からない。うん、それは"}, {"type": "subtitle", "time": 3980.39, "timestamp": "01:06:20", "text": "私にも起こったことだよ。えっと、"}, {"type": "subtitle", "time": 4013.67, "timestamp": "01:06:53", "text": "でも心配しないで。"}, {"type": "subtitle", "time": 4015.27, "timestamp": "01:06:55", "text": "練習を続けるよ。"}]
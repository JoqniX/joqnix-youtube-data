[{"type": "subtitle", "time": 7861.91, "timestamp": "02:11:01", "text": "でもあなたはコースを知っていると思っていました。 あなたはもう"}, {"type": "subtitle", "time": 7905.03, "timestamp": "02:11:45", "text": "最高のアイデアはどうでしょう？ 州が一番"}, {"type": "subtitle", "time": 7906.629, "timestamp": "02:11:46", "text": "良いと思う。"}, {"type": "subtitle", "time": 7909.43, "timestamp": "02:11:49", "text": "待って、西側って何だっけ？ 西"}, {"type": "subtitle", "time": 7911.589, "timestamp": "02:11:51", "text": "インド諸島。 州って何でしたっけ？ 私は"}, {"type": "subtitle", "time": 7914.149, "timestamp": "02:11:54", "text": "地理が苦手です。"}, {"type": "subtitle", "time": 7918.069, "timestamp": "02:11:58", "text": "西インド諸島。 ええと、"}, {"type": "subtitle", "time": 7919.91, "timestamp": "02:11:59", "text": "西インド諸島。   わかった"}]
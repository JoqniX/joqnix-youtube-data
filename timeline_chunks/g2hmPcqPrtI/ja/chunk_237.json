[{"type": "subtitle", "time": 14222.469, "timestamp": "03:57:02", "text": "どうして弾丸を作らなかったのか、"}, {"type": "subtitle", "time": 14225.91, "timestamp": "03:57:05", "text": "チュートリアルを作らなかったのか、"}, {"type": "subtitle", "time": 14227.67, "timestamp": "03:57:07", "text": "磁石を開始して"}, {"type": "subtitle", "time": 14230.469, "timestamp": "03:57:10", "text": "パスワードを3回入力する、つまり"}, {"type": "subtitle", "time": 14232.95, "timestamp": "03:57:12", "text": "南西、北西、南西、北西、南西"}, {"type": "subtitle", "time": 14235.189, "timestamp": "03:57:15", "text": "、南西、南西、"}, {"type": "subtitle", "time": 14238.87, "timestamp": "03:57:18", "text": "南西。 すると、レタスのような石像が"}, {"type": "subtitle", "time": 14241.83, "timestamp": "03:57:21", "text": "開きます。"}, {"type": "subtitle", "time": 14243.189, "timestamp": "03:57:23", "text": "中には宝物が隠されている。 待って、待って、待って、待って、"}, {"type": "subtitle", "time": 14246.79, "timestamp": "03:57:26", "text": "待って、待って。 南西、北西、"}, {"type": "subtitle", "time": 14249.03, "timestamp": "03:57:29", "text": "南西、北西、南西、"}, {"type": "subtitle", "time": 14251.83, "timestamp": "03:57:31", "text": "北西。 何？"}, {"type": "subtitle", "time": 14258.469, "timestamp": "03:57:38", "text": "何？  [笑い]"}, {"type": "subtitle", "time": 14267.11, "timestamp": "03:57:47", "text": "。 北、南、左、右。"}]
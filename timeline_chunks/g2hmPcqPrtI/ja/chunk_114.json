[{"type": "subtitle", "time": 6847.109, "timestamp": "01:54:07", "text": "こんにちは。   久しぶりですね"}, {"type": "subtitle", "time": 6849.99, "timestamp": "01:54:09", "text": "。"}, {"type": "subtitle", "time": 6854.629, "timestamp": "01:54:14", "text": "こんばんは。 待って、今は12時だ。"}, {"type": "subtitle", "time": 6858.55, "timestamp": "01:54:18", "text": "12時になります。それでは、おはようございます。"}, {"type": "subtitle", "time": 6860.709, "timestamp": "01:54:20", "text": "ハッピーマンデー。   調子は"}, {"type": "subtitle", "time": 6862.629, "timestamp": "01:54:22", "text": "どうですか？ 久しぶりですね。"}, {"type": "subtitle", "time": 6865.189, "timestamp": "01:54:25", "text": "元気です。   お久しぶりです"}, {"type": "subtitle", "time": 6867.589, "timestamp": "01:54:27", "text": "。 本当に久しぶりですね"}, {"type": "subtitle", "time": 6869.189, "timestamp": "01:54:29", "text": "。"}, {"type": "subtitle", "time": 6872.39, "timestamp": "01:54:32", "text": "ああ、これなら大丈夫だ。"}, {"type": "subtitle", "time": 6875.669, "timestamp": "01:54:35", "text": "私はあの"}, {"type": "subtitle", "time": 6881.03, "timestamp": "01:54:41", "text": "赤い蝶を手に入れた。 マークもあなたを見つけました。"}, {"type": "subtitle", "time": 6898.149, "timestamp": "01:54:58", "text": "どこ？ はい、どうぞ"}]
[{"type": "subtitle", "time": 5640.47, "timestamp": "01:34:00", "text": "ああ、"}, {"type": "subtitle", "time": 5657.35, "timestamp": "01:34:17", "text": "その番組をすでに持っていたにもかかわらず、日本語版で再視聴しました。"}, {"type": "subtitle", "time": 5659.27, "timestamp": "01:34:19", "text": "水曜日の放送は見ていません。 評判が良いとか、そういう話を聞いたよ"}, {"type": "subtitle", "time": 5662.229, "timestamp": "01:34:22", "text": "。"}, {"type": "subtitle", "time": 5672.31, "timestamp": "01:34:32", "text": "はい、こちらに索引セクションがあります"}, {"type": "subtitle", "time": 5683.75, "timestamp": "01:34:43", "text": "。"}, {"type": "subtitle", "time": 5685.91, "timestamp": "01:34:45", "text": "こちらです。"}, {"type": "subtitle", "time": 5687.59, "timestamp": "01:34:47", "text": "車はとても良いです。 とても良い。 しかし、"}, {"type": "subtitle", "time": 5699.03, "timestamp": "01:34:59", "text": "、そうだね。 シーズン"}]
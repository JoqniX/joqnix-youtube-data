[{"type": "subtitle", "time": 15302.71, "timestamp": "04:15:02", "text": "。 わかった。 あなたはなぜここにいるのですか？   お前を"}, {"type": "subtitle", "time": 15305.189, "timestamp": "04:15:05", "text": "追い出してやる。 わかった。 笑いが起こった"}, {"type": "subtitle", "time": 15309.349, "timestamp": "04:15:09", "text": "。 私は実際に"}, {"type": "subtitle", "time": 15315.269, "timestamp": "04:15:15", "text": "その作品を投げたと思ったのですが、そうですよね？   そう願っています"}, {"type": "subtitle", "time": 15323.51, "timestamp": "04:15:23", "text": "よし、できたと思う。"}, {"type": "subtitle", "time": 15325.75, "timestamp": "04:15:25", "text": "それと、ここはどこ？ 一体どうやって"}, {"type": "subtitle", "time": 15328.469, "timestamp": "04:15:28", "text": "ここまで来たんだろう？"}, {"type": "subtitle", "time": 15332.87, "timestamp": "04:15:32", "text": "待って、ここまで来たのに。 わかった、"}, {"type": "subtitle", "time": 15335.99, "timestamp": "04:15:35", "text": "私がスケープゴートにしたんだ。"}, {"type": "subtitle", "time": 15348.63, "timestamp": "04:15:48", "text": "それについては疑問に思わないでください。   ああ"}]
[{"type": "subtitle", "time": 9789.03, "timestamp": "02:43:09", "text": "美しい彫像だが、目は"}, {"type": "subtitle", "time": 9791.03, "timestamp": "02:43:11", "text": "布で覆われている。"}, {"type": "subtitle", "time": 9795.429, "timestamp": "02:43:15", "text": "テンおじさん、これが月の女神ですか？"}, {"type": "subtitle", "time": 9795.67, "timestamp": "02:43:15", "text": "はい、"}, {"type": "subtitle", "time": 9797.11, "timestamp": "02:43:17", "text": "月の女神です。"}, {"type": "subtitle", "time": 9804.07, "timestamp": "02:43:24", "text": "彼女は目が見えない。 そして彼女は剣術の"}, {"type": "subtitle", "time": 9806.71, "timestamp": "02:43:26", "text": "達人だ。 一般の人にはできないだろう"}, {"type": "subtitle", "time": 9809.27, "timestamp": "02:43:29", "text": "。 しかし、月の女神に"}, {"type": "subtitle", "time": 9812.23, "timestamp": "02:43:32", "text": "会うときは、くれぐれも礼儀"}, {"type": "subtitle", "time": 9815.67, "timestamp": "02:43:35", "text": "正しく振る舞うようにしてください。"}, {"type": "subtitle", "time": 9817.59, "timestamp": "02:43:37", "text": "湖底はまるで"}, {"type": "subtitle", "time": 9821.429, "timestamp": "02:43:41", "text": "隠された別世界のようだ。 しかし、今後の道筋はどこにあるのだろうか"}]
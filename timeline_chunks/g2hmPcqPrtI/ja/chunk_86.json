[{"type": "subtitle", "time": 5161.11, "timestamp": "01:26:01", "text": "それが私の望み。絶対に忘れないように、"}, {"type": "subtitle", "time": 5163.43, "timestamp": "01:26:03", "text": "脳に叩き込んでほしい"}, {"type": "subtitle", "time": 5166.55, "timestamp": "01:26:06", "text": "。"}, {"type": "subtitle", "time": 5174.87, "timestamp": "01:26:14", "text": "今日参加するの？ ああ、ただ"}, {"type": "subtitle", "time": 5185.35, "timestamp": "01:26:25", "text": "今日は困った状況だったんだ。だって"}, {"type": "subtitle", "time": 5187.91, "timestamp": "01:26:27", "text": "明日リセットがあるんだもん。"}, {"type": "subtitle", "time": 5192.07, "timestamp": "01:26:32", "text": "数時間後にリセットがあって、新しい"}, {"type": "subtitle", "time": 5195.669, "timestamp": "01:26:35", "text": "キャラクターが来るし、シアターのリセット、ブルー"}, {"type": "subtitle", "time": 5198.39, "timestamp": "01:26:38", "text": "プロトコルマスターの"}, {"type": "subtitle", "time": 5200.95, "timestamp": "01:26:40", "text": "リセット、"}, {"type": "subtitle", "time": 5203.27, "timestamp": "01:26:43", "text": "たくさんのことがあるんだ。"}, {"type": "subtitle", "time": 5205.35, "timestamp": "01:26:45", "text": "だから、わかった、今日は"}, {"type": "subtitle", "time": 5207.03, "timestamp": "01:26:47", "text": "レベル上げはしない。今日はただ遊んで"}, {"type": "subtitle", "time": 5210.709, "timestamp": "01:26:50", "text": "探索して、早く寝て、"}, {"type": "subtitle", "time": 5214.31, "timestamp": "01:26:54", "text": "朝早く起きて、今日みたいに一"}, {"type": "subtitle", "time": 5217.43, "timestamp": "01:26:57", "text": "日を始めようと思ったんだ。 今日は、午前"}]
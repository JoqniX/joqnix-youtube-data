[{"type": "subtitle", "time": 722.389, "timestamp": "00:12:02", "text": "5人くらいのグループが必要なんですよね"}, {"type": "subtitle", "time": 725.269, "timestamp": "00:12:05", "text": "？"}, {"type": "subtitle", "time": 727.91, "timestamp": "00:12:07", "text": "ダンジョン攻略とか、そういうことをするために。 そして、たとえ"}, {"type": "subtitle", "time": 731.829, "timestamp": "00:12:11", "text": "私が"}, {"type": "subtitle", "time": 735.11, "timestamp": "00:12:15", "text": "ギルドに所属していても、その時間に全員が空いていたわけではないので、少し難しく感じました"}, {"type": "subtitle", "time": 737.91, "timestamp": "00:12:17", "text": "。 ええ、"}, {"type": "subtitle", "time": 741.269, "timestamp": "00:12:21", "text": "変な時間帯だったと言えるかもしれませんね。[音楽]でも、私はあまり"}, {"type": "subtitle", "time": 744.23, "timestamp": "00:12:24", "text": "社交的ではなかったのですが、"}, {"type": "subtitle", "time": 747.67, "timestamp": "00:12:27", "text": "何人か人がいて"}, {"type": "subtitle", "time": 751.11, "timestamp": "00:12:31", "text": "、それで少し"}, {"type": "subtitle", "time": 761.91, "timestamp": "00:12:41", "text": "私はむしろこう考えていました。「あのね、"}, {"type": "subtitle", "time": 771.11, "timestamp": "00:12:51", "text": "本当にプレイしたいゲームなどに集中できた方が良かったんじゃない"}, {"type": "subtitle", "time": 773.269, "timestamp": "00:12:53", "text": "？」 しばらく経ってからやめた方がいいと感じたら、そうするかもしれない"}, {"type": "subtitle", "time": 779.59, "timestamp": "00:12:59", "text": "。 いや、私にはわからない。   正直言って"}]
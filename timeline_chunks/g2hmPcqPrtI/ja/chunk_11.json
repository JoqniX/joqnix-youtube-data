[{"type": "subtitle", "time": 660.71, "timestamp": "00:11:00", "text": "これらのゲームを積極的にやり込む余裕がないんです。"}, {"type": "subtitle", "time": 664.389, "timestamp": "00:11:04", "text": "それは絶対にダメだ。なぜなら、私は心の底では、積極的に努力し続けることができないと分かっているからだ"}, {"type": "subtitle", "time": 670.79, "timestamp": "00:11:10", "text": "。 私はどちらかというと、アクティブプレイヤーというよりは"}, {"type": "subtitle", "time": 674.23, "timestamp": "00:11:14", "text": "カジュアルプレイヤーに近いと思います"}, {"type": "subtitle", "time": 677.269, "timestamp": "00:11:17", "text": "。 この時間帯に"}, {"type": "subtitle", "time": 679.99, "timestamp": "00:11:19", "text": "ログインなど、特に"}, {"type": "subtitle", "time": 682.87, "timestamp": "00:11:22", "text": "ブループロトコルについては[音楽]"}, {"type": "subtitle", "time": 687.19, "timestamp": "00:11:27", "text": "2kのマスタースコアのことですが、そのイベントは"}, {"type": "subtitle", "time": 690.55, "timestamp": "00:11:30", "text": "明日リセットされて終了します。 だから、ある意味、私は"}, {"type": "subtitle", "time": 693.43, "timestamp": "00:11:33", "text": "それを諦めてしまったんです。"}, {"type": "subtitle", "time": 699.91, "timestamp": "00:11:39", "text": "ダンジョン攻略に挑戦して、"}, {"type": "subtitle", "time": 704.55, "timestamp": "00:11:44", "text": "500"}, {"type": "subtitle", "time": 719.509, "timestamp": "00:11:59", "text": "良いチーム、つまり"}]
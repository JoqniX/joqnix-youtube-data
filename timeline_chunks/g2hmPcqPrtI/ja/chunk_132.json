[{"type": "subtitle", "time": 7937.589, "timestamp": "02:12:17", "text": "西インド諸島。"}, {"type": "subtitle", "time": 7950.229, "timestamp": "02:12:30", "text": "。 ラジャかもしれないし、ゴアかもしれないし、"}, {"type": "subtitle", "time": 7953.51, "timestamp": "02:12:33", "text": "マラシュラかもしれないし、"}, {"type": "subtitle", "time": 7956.55, "timestamp": "02:12:36", "text": "グジャラートかもしれないし、わかった、私は"}, {"type": "subtitle", "time": 7970.55, "timestamp": "02:12:50", "text": "それから私は、つまり、私は"}, {"type": "subtitle", "time": 7973.189, "timestamp": "02:12:53", "text": "知っているが、州の名前を知らない"}]
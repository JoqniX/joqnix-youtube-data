[{"type": "subtitle", "time": 6300.95, "timestamp": "01:45:00", "text": "他人の気持ちを読み取るのは難しい時もある"}, {"type": "subtitle", "time": 6303.27, "timestamp": "01:45:03", "text": "。 嘘はつきません。"}, {"type": "subtitle", "time": 6305.75, "timestamp": "01:45:05", "text": "つまり、それは私にも言えることだ。   今"}, {"type": "subtitle", "time": 6308.55, "timestamp": "01:45:08", "text": "気づいたんだけど、"}, {"type": "subtitle", "time": 6312.79, "timestamp": "01:45:12", "text": "人によっては私の"}, {"type": "subtitle", "time": 6316.95, "timestamp": "01:45:16", "text": "名前は発音しにくいことがあるみたい。 だから、それは理解できます"}, {"type": "subtitle", "time": 6323.03, "timestamp": "01:45:23", "text": "そこでダナは2"}, {"type": "subtitle", "time": 6328.47, "timestamp": "01:45:28", "text": "本目のボトルを受け取った。 よし、３本目だ。これで"}, {"type": "subtitle", "time": 6350.229, "timestamp": "01:45:50", "text": "オーギーって呼ぶ人もいるよ。 ああ、"}]
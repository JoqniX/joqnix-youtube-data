[{"type": "subtitle", "time": 11128.95, "timestamp": "03:05:28", "text": "言葉を失ったのでしょうか？   テンおじさん"}, {"type": "subtitle", "time": 11131.03, "timestamp": "03:05:31", "text": "。"}, {"type": "subtitle", "time": 11132.389, "timestamp": "03:05:32", "text": "これは"}, {"type": "subtitle", "time": 11133.67, "timestamp": "03:05:33", "text": "彼女が亡くなったということでしょうか。"}, {"type": "subtitle", "time": 11138.55, "timestamp": "03:05:38", "text": "月の女神、ジェン。 もう手遅れだ。"}, {"type": "subtitle", "time": 11140.87, "timestamp": "03:05:40", "text": "彼女も3年前に亡くなっている。"}, {"type": "subtitle", "time": 11143.59, "timestamp": "03:05:43", "text": "3年。"}, {"type": "subtitle", "time": 11145.67, "timestamp": "03:05:45", "text": "3年前のあの戦いの際"}, {"type": "subtitle", "time": 11147.67, "timestamp": "03:05:47", "text": "、彼女の敵は湖底で死んだようだ"}, {"type": "subtitle", "time": 11149.75, "timestamp": "03:05:49", "text": "。"}, {"type": "subtitle", "time": 11151.91, "timestamp": "03:05:51", "text": "しかし、彼女も成功しなかった。"}, {"type": "subtitle", "time": 11155.75, "timestamp": "03:05:55", "text": "では、あなたが受け取った手紙はどうでしたか？"}, {"type": "subtitle", "time": 11157.91, "timestamp": "03:05:57", "text": "幽霊か、彼女になりすました誰かが"}]
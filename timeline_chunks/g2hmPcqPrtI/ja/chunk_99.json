[{"type": "subtitle", "time": 5950.31, "timestamp": "01:39:10", "text": "クエストか何かがあるべきだと思う"}, {"type": "subtitle", "time": 5966.79, "timestamp": "01:39:26", "text": "。 私はここにいます。 わかった、気にしないで。 私は"}, {"type": "subtitle", "time": 5984.31, "timestamp": "01:39:44", "text": "山と川に残る、最後の黄色いかけら。 わかった。"}, {"type": "subtitle", "time": 5988.87, "timestamp": "01:39:48", "text": "えっと、でも、でも、クエストの"}, {"type": "subtitle", "time": 5997.51, "timestamp": "01:39:57", "text": "ああ、あそこのチュートリアルを見てください。"}]
[{"type": "subtitle", "time": 11601.99, "timestamp": "03:13:21", "text": "この花はどこで見つけたの？"}, {"type": "chat", "time": 11603.839, "timestamp": "03:13:23", "author": "@kurunekodream", "avatar": "https://yt4.ggpht.com/RLzqgZjl8ILhIIU27ghgxtcyxaMDaQ4nJQ8GzPmDKVVI7HHPJUZsDQV_Itc49vlXGx8THQhiP90=s64-c-k-c0x00ffffff-no-rj", "message": "muhehehe"}, {"type": "subtitle", "time": 11604.79, "timestamp": "03:13:24", "text": "下の庭で。 そこにはそのような花がたくさん"}, {"type": "subtitle", "time": 11608.79, "timestamp": "03:13:28", "text": "植えられたが、ほとんどが枯れてしまった。   今も"}, {"type": "subtitle", "time": 11611.11, "timestamp": "03:13:31", "text": "花を咲かせているのは、この花だけだ。"}, {"type": "subtitle", "time": 11613.19, "timestamp": "03:13:33", "text": "こんにちは、クラン。 ようこそ。"}, {"type": "subtitle", "time": 11616.309, "timestamp": "03:13:36", "text": "彼女は彼らの面倒をとてもよく見ていた。"}, {"type": "subtitle", "time": 11618.15, "timestamp": "03:13:38", "text": "月の女神は、"}, {"type": "subtitle", "time": 11620.95, "timestamp": "03:13:40", "text": "これらの絶滅した花々で洞窟を満たした。 彼女は"}, {"type": "subtitle", "time": 11624.79, "timestamp": "03:13:44", "text": "相当な努力をしたに違いない。 しかし、それでもなお、それだけの"}, {"type": "subtitle", "time": 11627.75, "timestamp": "03:13:47", "text": "価値はあるのだろうか？ 彼女は死後もなお、手放すことができない"}, {"type": "chat", "time": 11628.554, "timestamp": "03:13:48", "author": "@kurunekodream", "avatar": "https://yt4.ggpht.com/RLzqgZjl8ILhIIU27ghgxtcyxaMDaQ4nJQ8GzPmDKVVI7HHPJUZsDQV_Itc49vlXGx8THQhiP90=s64-c-k-c0x00ffffff-no-rj", "message": "just came to say gn, Good Night joq!"}, {"type": "subtitle", "time": 11629.83, "timestamp": "03:13:49", "text": "。"}, {"type": "subtitle", "time": 11633.91, "timestamp": "03:13:53", "text": "手紙を送った人と同じように。 二人とも変わった人たちだ。   おやすみなさいと"}, {"type": "subtitle", "time": 11635.99, "timestamp": "03:13:55", "text": "言いに来ました。 おやすみ、"}, {"type": "subtitle", "time": 11639.11, "timestamp": "03:13:59", "text": "ジョー。 こんにちは。 おやすみ。 おやすみ。 カコスか。"}]
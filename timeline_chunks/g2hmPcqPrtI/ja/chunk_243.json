[{"type": "subtitle", "time": 14590.15, "timestamp": "04:03:10", "text": "。 ちょっと待って、時計回りってどういう意味かグーグルで調べてみるよ"}, {"type": "subtitle", "time": 14596.07, "timestamp": "04:03:16", "text": "[笑い声]"}, {"type": "subtitle", "time": 14602.309, "timestamp": "04:03:22", "text": "方向。"}, {"type": "subtitle", "time": 14604.71, "timestamp": "04:03:24", "text": "左か右か？ それは常に正しい。 はい、"}, {"type": "subtitle", "time": 14606.95, "timestamp": "04:03:26", "text": "私はバカです。"}, {"type": "subtitle", "time": 14614.389, "timestamp": "04:03:34", "text": "あ、待って。 ああ、そっちの方ですね"}, {"type": "subtitle", "time": 14624.469, "timestamp": "04:03:44", "text": "次に時計を見てください。"}, {"type": "subtitle", "time": 14626.15, "timestamp": "04:03:46", "text": "待って、"}, {"type": "subtitle", "time": 14628.71, "timestamp": "04:03:48", "text": "司令官は言った、"}, {"type": "subtitle", "time": 14630.71, "timestamp": "04:03:50", "text": "えーと、どこから始めるのか、よし、"}, {"type": "subtitle", "time": 14632.71, "timestamp": "04:03:52", "text": "スタート地点に立って、"}]
[{"type": "subtitle", "time": 302.95, "timestamp": "00:05:02", "text": "シャムシャムをやって、サミー関連のことをして、いくつかの"}, {"type": "subtitle", "time": 306.629, "timestamp": "00:05:06", "text": "ことを終わらせたかったんです。"}, {"type": "subtitle", "time": 311.35, "timestamp": "00:05:11", "text": "えっと、その後停電が起こりました。"}, {"type": "subtitle", "time": 314.39, "timestamp": "00:05:14", "text": "停電が発生したことを示す。"}, {"type": "subtitle", "time": 323.27, "timestamp": "00:05:23", "text": "今日は休んで、"}, {"type": "subtitle", "time": 328.07, "timestamp": "00:05:28", "text": "夕方か翌日にやろうと思ったんです。 そこで、"}, {"type": "subtitle", "time": 338.31, "timestamp": "00:05:38", "text": "うん。 こんにちは、Tomat Tomat"}, {"type": "subtitle", "time": 341.99, "timestamp": "00:05:41", "text": "5544。ようこそ。"}, {"type": "subtitle", "time": 346.15, "timestamp": "00:05:46", "text": "ストリームへようこそ。 午前0時（"}, {"type": "subtitle", "time": 349.59000000000003, "timestamp": "00:05:49", "text": "小数点以下）。 こんにちは。   あの"}, {"type": "subtitle", "time": 351.99, "timestamp": "00:05:51", "text": "、"}, {"type": "subtitle", "time": 354.55, "timestamp": "00:05:54", "text": "あのね？"}, {"type": "subtitle", "time": 356.87, "timestamp": "00:05:56", "text": "歴史的な出来事を追体験する生活をやめられたらいいのに。そうすると、本当に"}, {"type": "subtitle", "time": 359.67, "timestamp": "00:05:59", "text": "恐ろしいことになるから。 はぁ？ どう"}]
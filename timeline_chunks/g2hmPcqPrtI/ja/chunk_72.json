[{"type": "subtitle", "time": 4320.47, "timestamp": "01:12:00", "text": "あちらの大学に行って、"}, {"type": "subtitle", "time": 4347.83, "timestamp": "01:12:27", "text": "ああ、そうだった。忘れてた。"}, {"type": "subtitle", "time": 4350.63, "timestamp": "01:12:30", "text": "書類とか読まなきゃいけないんだ。なんてこった。うん"}, {"type": "subtitle", "time": 4352.87, "timestamp": "01:12:32", "text": "。"}, {"type": "subtitle", "time": 4357.99, "timestamp": "01:12:37", "text": "ねえ、実は落ち着いていなきゃいけないんだ。待って。"}, {"type": "subtitle", "time": 4361.189, "timestamp": "01:12:41", "text": "ああ、ハガキとかそういうの。ああ、住所。こんにちは。こんにちは。こんにちは。待ってるよ。なんてこった"}]
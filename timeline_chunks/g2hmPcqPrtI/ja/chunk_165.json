[{"type": "subtitle", "time": 9923.11, "timestamp": "02:45:23", "text": "山の扉が開いた。"}, {"type": "subtitle", "time": 9924.55, "timestamp": "02:45:24", "text": "あちらのドアが開いた。"}, {"type": "subtitle", "time": 9927.349, "timestamp": "02:45:27", "text": "入場前に音楽を流す。 おそらく、"}, {"type": "subtitle", "time": 9929.99, "timestamp": "02:45:29", "text": "月の女神に私たちの到着を知らせるためだろう。 中に入って"}, {"type": "subtitle", "time": 9937.349, "timestamp": "02:45:37", "text": "ちなみに、もし"}, {"type": "subtitle", "time": 9939.99, "timestamp": "02:45:39", "text": "この湖の底に閉じ込められたとしても、"}, {"type": "subtitle", "time": 9942.87, "timestamp": "02:45:42", "text": "1年経っても飢えることはないだろう。 死体って何だか知ってる"}, {"type": "subtitle", "time": 9944.55, "timestamp": "02:45:44", "text": "？   結局、"}, {"type": "subtitle", "time": 9947.59, "timestamp": "02:45:47", "text": "誰かが彼女を見つけたようだ。 どうぞ"}, {"type": "subtitle", "time": 9950.389, "timestamp": "02:45:50", "text": "。 私はここに残って、"}, {"type": "subtitle", "time": 9953.03, "timestamp": "02:45:53", "text": "これを見てみようと思います。"}]
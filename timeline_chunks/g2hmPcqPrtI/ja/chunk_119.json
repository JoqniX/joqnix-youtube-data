[{"type": "subtitle", "time": 7144.87, "timestamp": "01:59:04", "text": "実際、私がランダムに"}, {"type": "subtitle", "time": 7147.189, "timestamp": "01:59:07", "text": "日本語の単語などを口にしているのは良いことだ"}, {"type": "subtitle", "time": 7150.229, "timestamp": "01:59:10", "text": "。 トレーニングとしては良いと"}, {"type": "subtitle", "time": 7154.95, "timestamp": "01:59:14", "text": "思うよ。 だから、ちょっと待って。"}, {"type": "subtitle", "time": 7158.87, "timestamp": "01:59:18", "text": "私は、"}, {"type": "subtitle", "time": 7162.95, "timestamp": "01:59:22", "text": "主に自分の"}, {"type": "subtitle", "time": 7166.39, "timestamp": "01:59:26", "text": "思考プロセス、つまり"}, {"type": "subtitle", "time": 7168.95, "timestamp": "01:59:28", "text": "英語で自分の考えを語る方法など、自分の考えの中にあるものを試してみるべきです。 いいえ、それを"}, {"type": "subtitle", "time": 7174.79, "timestamp": "01:59:34", "text": "日本語でどう言うか覚えるべきですね。"}, {"type": "subtitle", "time": 7177.03, "timestamp": "01:59:37", "text": "そうやって"}, {"type": "subtitle", "time": 7185.75, "timestamp": "01:59:45", "text": "それでは、話し合いましょう。 うん。 はい。"}]
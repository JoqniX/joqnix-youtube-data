[{"type": "subtitle", "time": 9366.469, "timestamp": "02:36:06", "text": "はい。"}, {"type": "subtitle", "time": 9369.03, "timestamp": "02:36:09", "text": "私の"}, {"type": "subtitle", "time": 9386.55, "timestamp": "02:36:26", "text": "家族と過ごした幼少期の素晴らしい思い出。 私はいつも"}, {"type": "subtitle", "time": 9393.83, "timestamp": "02:36:33", "text": "彼らに花も贈っていました。   さあ行こう"}, {"type": "subtitle", "time": 9396.469, "timestamp": "02:36:36", "text": "。"}, {"type": "subtitle", "time": 9401.75, "timestamp": "02:36:41", "text": "私たちが作ったんです。 私たちはヤン・モモを友達として作りました"}, {"type": "subtitle", "time": 9403.83, "timestamp": "02:36:43", "text": "。 わーい。"}, {"type": "subtitle", "time": 9405.429, "timestamp": "02:36:45", "text": "誰かが映画『シャイニング』の曲を歌っているのが聞こえた"}]
[{"type": "subtitle", "time": 15960.309, "timestamp": "04:26:00", "text": "これまでの試合の調子はどうですか？ あなたはそれが好きですか？"}, {"type": "subtitle", "time": 15962.229, "timestamp": "04:26:02", "text": "はい。 大好きです。 大好きです。 大好きです。"}, {"type": "subtitle", "time": 15964.79, "timestamp": "04:26:04", "text": "とても楽しいです。   やるべきことが山ほどある"}, {"type": "subtitle", "time": 15967.11, "timestamp": "04:26:07", "text": "。 私は全てが好きです。"}, {"type": "subtitle", "time": 16007.51, "timestamp": "04:26:47", "text": "単一アイテムを設定します。 とにかく、レベルアップ"}, {"type": "subtitle", "time": 16013.51, "timestamp": "04:26:53", "text": "えっと、私は何をもらったの？"}, {"type": "subtitle", "time": 16019.99, "timestamp": "04:26:59", "text": "シリのそよ風は、攻撃中または"}]
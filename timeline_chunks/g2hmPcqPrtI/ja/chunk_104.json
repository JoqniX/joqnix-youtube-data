[{"type": "subtitle", "time": 6247.03, "timestamp": "01:44:07", "text": "、調子はどう？"}, {"type": "subtitle", "time": 6248.55, "timestamp": "01:44:08", "text": "オイオイ、"}, {"type": "subtitle", "time": 6251.109, "timestamp": "01:44:11", "text": "あなたの名前を正しく発音できているといいのですが"}, {"type": "subtitle", "time": 6255.03, "timestamp": "01:44:15", "text": "。 ようこそ、"}, {"type": "subtitle", "time": 6265.59, "timestamp": "01:44:25", "text": "こっそり彼らを始末してもいいですか？ 私は"}, {"type": "subtitle", "time": 6268.79, "timestamp": "01:44:28", "text": "戦いたくない。"}, {"type": "subtitle", "time": 6271.35, "timestamp": "01:44:31", "text": "オスギ。 わかった。"}, {"type": "subtitle", "time": 6273.99, "timestamp": "01:44:33", "text": "正しく発音できているといいのですが。"}, {"type": "subtitle", "time": 6286.149, "timestamp": "01:44:46", "text": "彼らは私があなたと戦うところを見ていなかった。"}, {"type": "subtitle", "time": 6289.189, "timestamp": "01:44:49", "text": "親友を殺せ。"}, {"type": "subtitle", "time": 6291.669, "timestamp": "01:44:51", "text": "死ぬ。"}]
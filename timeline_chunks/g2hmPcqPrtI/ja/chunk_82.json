[{"type": "subtitle", "time": 4920.39, "timestamp": "01:22:00", "text": "漢字なしでは生きていけない。もし"}, {"type": "subtitle", "time": 4922.87, "timestamp": "01:22:02", "text": "私が「漢字は"}, {"type": "subtitle", "time": 4925.35, "timestamp": "01:22:05", "text": "ムサカシだ、漢字が読めない」とか「"}, {"type": "subtitle", "time": 4927.99, "timestamp": "01:22:07", "text": "漢字を飛ばそう」とか言ってたら、すごく"}, {"type": "subtitle", "time": 4932.31, "timestamp": "01:22:12", "text": "苦しむことになるよ。"}, {"type": "subtitle", "time": 4936.781, "timestamp": "01:22:16", "text": "苦しむんだ。苦しむことになるってわかってるよ。"}, {"type": "subtitle", "time": 4959.75, "timestamp": "01:22:39", "text": "日本で「わからない」って言ってるところを想像してみて"}, {"type": "subtitle", "time": 4961.672, "timestamp": "01:22:41", "text": "。"}, {"type": "subtitle", "time": 4968.149, "timestamp": "01:22:48", "text": "君は ついていくつもり？ うん、"}, {"type": "subtitle", "time": 4972.229, "timestamp": "01:22:52", "text": "それはできないと思う。 電話を取り出す。"}, {"type": "subtitle", "time": 4976.709, "timestamp": "01:22:56", "text": "だから私は治療されない。つまり、"}]
[{"type": "subtitle", "time": 1082.31, "timestamp": "00:18:02", "text": "。 おいおい、"}, {"type": "subtitle", "time": 1086.87, "timestamp": "00:18:06", "text": "モニターに線が入ってるぞ。 ライオンとか見かけるよ"}, {"type": "subtitle", "time": 1088.63, "timestamp": "00:18:08", "text": "。"}, {"type": "subtitle", "time": 1091.75, "timestamp": "00:18:11", "text": "心配するべきなのか、それとも"}, {"type": "subtitle", "time": 1097.27, "timestamp": "00:18:17", "text": "命の危険を感じるべきなのか、私には分かりません。"}, {"type": "subtitle", "time": 1100.07, "timestamp": "00:18:20", "text": "自分の命が危ないとは思っていません。 つまり、それは"}, {"type": "subtitle", "time": 1102.23, "timestamp": "00:18:22", "text": "もっと、えっと、"}, {"type": "subtitle", "time": 1110.07, "timestamp": "00:18:30", "text": "どう言えばいいかな？ どちらかというと、"}, {"type": "subtitle", "time": 1136.47, "timestamp": "00:18:56", "text": "他のことも含めて、死にかけているような感じで、"}]
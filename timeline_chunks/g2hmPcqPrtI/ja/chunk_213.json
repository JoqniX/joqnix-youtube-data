[{"type": "subtitle", "time": 12788.229, "timestamp": "03:33:08", "text": "あなたは何歳でしたっけ？ つまり、私はもう十分な"}, {"type": "subtitle", "time": 12790.87, "timestamp": "03:33:10", "text": "年齢です。 私は飲酒運転ができる。"}, {"type": "subtitle", "time": 12801.03, "timestamp": "03:33:21", "text": "えっと、"}, {"type": "subtitle", "time": 12804.95, "timestamp": "03:33:24", "text": "彼らは私が十分に成熟していないと思っているんです。"}, {"type": "subtitle", "time": 12811.03, "timestamp": "03:33:31", "text": "なぜなら、私はワイルドなムーブメントの中で生き残れないからです"}, {"type": "subtitle", "time": 12813.67, "timestamp": "03:33:33", "text": "。"}, {"type": "subtitle", "time": 12815.59, "timestamp": "03:33:35", "text": "うん。"}, {"type": "subtitle", "time": 12817.59, "timestamp": "03:33:37", "text": "私が日本に行ける唯一の理由は、"}, {"type": "subtitle", "time": 12819.51, "timestamp": "03:33:39", "text": "そこに機関、"}, {"type": "subtitle", "time": 12822.309, "timestamp": "03:33:42", "text": "つまりアカデミーの人たちが私の面倒を見てくれるからで、"}, {"type": "subtitle", "time": 12828.07, "timestamp": "03:33:48", "text": "アカデミーのたくさんの体育関係者が私の面倒を見てくれるからです"}, {"type": "subtitle", "time": 12829.349, "timestamp": "03:33:49", "text": "。"}, {"type": "subtitle", "time": 12833.19, "timestamp": "03:33:53", "text": "もし私が何かトラブルに巻き込まれたり、"}, {"type": "subtitle", "time": 12835.67, "timestamp": "03:33:55", "text": "屋外で何かあったりしたら。 うん。 うん。 うん。 うん。"}]
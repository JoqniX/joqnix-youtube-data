[{"type": "subtitle", "time": 5351.59, "timestamp": "01:29:11", "text": "銀行的、銀行的、銀行的"}, {"type": "subtitle", "time": 5355.27, "timestamp": "01:29:15", "text": "。 そう、安定した収入源を確保する必要がある"}, {"type": "subtitle", "time": 5366.87, "timestamp": "01:29:26", "text": "落ち着かなければならない。 こんにちは、"}, {"type": "subtitle", "time": 5392.229, "timestamp": "01:29:52", "text": "戦略的な"}, {"type": "subtitle", "time": 5396.47, "timestamp": "01:29:56", "text": "剣。 ああ、この男は"}, {"type": "subtitle", "time": 5397.907, "timestamp": "01:29:57", "text": "子供を見つけて蹴った。"}]
[{"type": "subtitle", "time": 4081.829, "timestamp": "01:08:01", "text": "。気をつけて。さよなら。"}, {"type": "subtitle", "time": 4089.75, "timestamp": "01:08:09", "text": "日本に住んでいるよね。"}, {"type": "subtitle", "time": 4092.549, "timestamp": "01:08:12", "text": "いや、君の息子と私は、えーと、"}, {"type": "subtitle", "time": 4100.07, "timestamp": "01:08:20", "text": "うん、私たちはJPのクラス"}, {"type": "subtitle", "time": 4102.55, "timestamp": "01:08:22", "text": "メイトみたいなものだった。私たちはそこに行って、"}, {"type": "subtitle", "time": 4121.03, "timestamp": "01:08:41", "text": "えーと、"}, {"type": "subtitle", "time": 4124.149, "timestamp": "01:08:44", "text": "友達になってください。"}, {"type": "subtitle", "time": 4126.87, "timestamp": "01:08:46", "text": "なんで彼は気難しいんだろう？"}, {"type": "subtitle", "time": 4130.95, "timestamp": "01:08:50", "text": "勉強のために追いつくんだ。いや、ゲーマーだよ。"}, {"type": "subtitle", "time": 4138.982, "timestamp": "01:08:58", "text": "スーパーjouだから"}]
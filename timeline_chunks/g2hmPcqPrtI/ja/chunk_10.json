[{"type": "subtitle", "time": 600.71, "timestamp": "00:10:00", "text": "それで、[音楽]"}, {"type": "subtitle", "time": 602.71, "timestamp": "00:10:02", "text": "ストリーミングのことを考えたのですが、ポケットができて、それが"}, {"type": "subtitle", "time": 606.23, "timestamp": "00:10:06", "text": "私を再び"}, {"type": "subtitle", "time": 608.63, "timestamp": "00:10:08", "text": "眠りにつかせ、休ませてくれました。"}, {"type": "subtitle", "time": 610.63, "timestamp": "00:10:10", "text": "それで、"}, {"type": "subtitle", "time": 618.069, "timestamp": "00:10:18", "text": "？   そうそう"}, {"type": "subtitle", "time": 620.79, "timestamp": "00:10:20", "text": "。 えーと、最近は予測コマンドで[音楽]をやっていて、例えば、"}, {"type": "subtitle", "time": 631.11, "timestamp": "00:10:31", "text": "Two at Night Abyss Blue Protocol"}, {"type": "subtitle", "time": 633.67, "timestamp": "00:10:33", "text": "Where Events Meetなどのゲームをいくつかストリーミング配信しています。Farlightなど、他にもたくさんのゲームがあります。"}, {"type": "subtitle", "time": 639.509, "timestamp": "00:10:39", "text": "ちなみにFarlightをインストールしました。私は、"}, {"type": "subtitle", "time": 650.23, "timestamp": "00:10:50", "text": "これらのゲームを積極的にプレイすることはできない、という感じでした。"}, {"type": "subtitle", "time": 652.87, "timestamp": "00:10:52", "text": "でも、できるときにだけこれらのゲームをプレイできます"}, {"type": "subtitle", "time": 657.11, "timestamp": "00:10:57", "text": "。 私は"}]
[{"type": "subtitle", "time": 11641.83, "timestamp": "03:14:01", "text": "あなたと同じようにね、テンおじさん。"}, {"type": "subtitle", "time": 11645.429, "timestamp": "03:14:05", "text": "今夜、星々があなたを祝福し、見守り、そして"}, {"type": "subtitle", "time": 11648.71, "timestamp": "03:14:08", "text": "素敵な夢を授けてくれますように。 それでもあなたは"}, {"type": "subtitle", "time": 11655.67, "timestamp": "03:14:15", "text": "それは褒め言葉として受け取っておきます。"}, {"type": "subtitle", "time": 11657.59, "timestamp": "03:14:17", "text": "これらの長湖の"}, {"type": "subtitle", "time": 11671.429, "timestamp": "03:14:31", "text": "金庫に紐付ける。 よし、"}]
[{"type": "subtitle", "time": 483.35, "timestamp": "00:08:03", "text": "パソコンを再起動しました。"}, {"type": "subtitle", "time": 485.99, "timestamp": "00:08:05", "text": "どんなデータが削除されたのか、誰にもわからない。"}, {"type": "subtitle", "time": 495.749, "timestamp": "00:08:15", "text": "思います。"}, {"type": "subtitle", "time": 505.909, "timestamp": "00:08:25", "text": "最近はちょっと疲れていて、"}, {"type": "subtitle", "time": 510.07, "timestamp": "00:08:30", "text": "特に"}, {"type": "subtitle", "time": 517.67, "timestamp": "00:08:37", "text": "午後と夕方にJPの授業があるからなんです。   まるで授業が"}, {"type": "subtitle", "time": 523.35, "timestamp": "00:08:43", "text": "2コマ"}, {"type": "subtitle", "time": 525.509, "timestamp": "00:08:45", "text": "増えたようなものだ。"}, {"type": "subtitle", "time": 528.87, "timestamp": "00:08:48", "text": "2～3時間。 うん。  2時間でも、それ以上でも構いません"}, {"type": "subtitle", "time": 532.15, "timestamp": "00:08:52", "text": "。 うん。"}, {"type": "subtitle", "time": 536.31, "timestamp": "00:08:56", "text": "夜は少し疲れた感じがして、"}, {"type": "subtitle", "time": 538.47, "timestamp": "00:08:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 5703.35, "timestamp": "01:35:03", "text": "2はいつ公開されたんですか？   それ"}, {"type": "subtitle", "time": 5718.229, "timestamp": "01:35:18", "text": "私は昔、探偵みたいに超バカな子供をあらゆることで間違っていたんです"}, {"type": "subtitle", "time": 5727.51, "timestamp": "01:35:27", "text": "彼らは"}, {"type": "subtitle", "time": 5740.87, "timestamp": "01:35:40", "text": "見逃した。"}, {"type": "subtitle", "time": 5742.709, "timestamp": "01:35:42", "text": "あ、待って。 彼らは私を見た。"}, {"type": "subtitle", "time": 5745.51, "timestamp": "01:35:45", "text": "ちょっと待って。"}, {"type": "subtitle", "time": 5748.87, "timestamp": "01:35:48", "text": "彼らに見られずにやりたい。  「ああ、"}, {"type": "subtitle", "time": 5752.709, "timestamp": "01:35:52", "text": "彼らは私を見ている」という感じが好きです。 どうでも。 じゃあ、行きます。   よし"}]
[{"type": "subtitle", "time": 11883.67, "timestamp": "03:18:03", "text": "ああ、入って。ぎゅっと押し込んで。ぎゅっと"}, {"type": "subtitle", "time": 11885.83, "timestamp": "03:18:05", "text": "押し込んで。"}, {"type": "subtitle", "time": 11888.55, "timestamp": "03:18:08", "text": "もっとぎゅっと押し込んで。"}, {"type": "subtitle", "time": 11913.11, "timestamp": "03:18:33", "text": "私たちがそうでないなら、私たちはボードを漕ぐことはないでしょう"}, {"type": "subtitle", "time": 11918.87, "timestamp": "03:18:38", "text": "。 いや、カチはボードを台無しにするだろう。"}]
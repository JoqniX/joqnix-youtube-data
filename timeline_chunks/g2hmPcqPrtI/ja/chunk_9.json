[{"type": "subtitle", "time": 542.55, "timestamp": "00:09:02", "text": "彼らのように、うん。 一般的に言って、私は"}, {"type": "subtitle", "time": 544.949, "timestamp": "00:09:04", "text": "朝の配信をやりたかったんです。   実は"}, {"type": "subtitle", "time": 548.87, "timestamp": "00:09:08", "text": "昨日、午前6時に起きたんです。"}, {"type": "subtitle", "time": 551.19, "timestamp": "00:09:11", "text": "つまり、今日の朝は午前"}, {"type": "subtitle", "time": 557.91, "timestamp": "00:09:17", "text": "6時にちょうど起きたんです。"}, {"type": "subtitle", "time": 561.67, "timestamp": "00:09:21", "text": "配信をしようと思ったんですが、気が散ってしまいました。"}, {"type": "subtitle", "time": 564.55, "timestamp": "00:09:24", "text": "私は日本のユーチューバーが配信で"}, {"type": "subtitle", "time": 566.389, "timestamp": "00:09:26", "text": "[音楽]チャットと交流したり、"}, {"type": "subtitle", "time": 572.389, "timestamp": "00:09:32", "text": "日本語を学んだりしているのを見ていて、私も"}, {"type": "subtitle", "time": 590.389, "timestamp": "00:09:50", "text": "昨日はもう9時も経って、あっという間に過ぎたなと思って、"}, {"type": "subtitle", "time": 592.71, "timestamp": "00:09:52", "text": "よし、配信しなくちゃ、と思いました。 私は"}, {"type": "subtitle", "time": 596.31, "timestamp": "00:09:56", "text": "曲げるという仕事をします。  [音楽] それならできます"}, {"type": "subtitle", "time": 599.829, "timestamp": "00:09:59", "text": "。 そして今日は日曜日だ。"}]
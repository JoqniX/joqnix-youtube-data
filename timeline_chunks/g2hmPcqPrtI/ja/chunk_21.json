[{"type": "subtitle", "time": 1263.59, "timestamp": "00:21:03", "text": "この赤ちゃんはアサだと思う。今"}, {"type": "subtitle", "time": 1304.71, "timestamp": "00:21:44", "text": "配信してない時に少しプレイしたことを告白しよう。"}, {"type": "subtitle", "time": 1308.31, "timestamp": "00:21:48", "text": "今日じゃない。昨日でもない。えーと、"}, {"type": "subtitle", "time": 1309.99, "timestamp": "00:21:49", "text": "配信を終えた日。待って、待って、待って。"}, {"type": "subtitle", "time": 1315.83, "timestamp": "00:21:55", "text": "昨日少しプレイしたと思う。少し。"}]
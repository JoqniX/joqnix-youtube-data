[{"type": "subtitle", "time": 10692.55, "timestamp": "02:58:12", "text": "おい、ドアを見てみろよ。   動かないで下さい"}, {"type": "subtitle", "time": 10694.15, "timestamp": "02:58:14", "text": "。"}, {"type": "subtitle", "time": 10696.79, "timestamp": "02:58:16", "text": "ドアの向こうに何があるか、気をつけろ。   私が押し開けます"}, {"type": "subtitle", "time": 10699.349, "timestamp": "02:58:19", "text": "。   わかった"}, {"type": "subtitle", "time": 10716.07, "timestamp": "02:58:36", "text": "何を"}, {"type": "subtitle", "time": 10718.79, "timestamp": "02:58:38", "text": "調査するのか？"}, {"type": "subtitle", "time": 10721.51, "timestamp": "02:58:41", "text": "何をお持ちですか？ 装置の図解。   あれはいったい"}, {"type": "subtitle", "time": 10733.83, "timestamp": "02:58:53", "text": "それでおしまい。 これ以上の捜査は行わない。"}, {"type": "subtitle", "time": 10737.11, "timestamp": "02:58:57", "text": "あなたも。 私を調べてください"}]
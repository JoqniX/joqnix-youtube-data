[{"type": "subtitle", "time": 7082.07, "timestamp": "01:58:02", "text": "終わりだ。 素晴らしい"}, {"type": "subtitle", "time": 7084.55, "timestamp": "01:58:04", "text": "試合をありがとうございました。"}, {"type": "subtitle", "time": 7087.83, "timestamp": "01:58:07", "text": "マスターフェローシップ、私たちは何を得たのか？"}, {"type": "subtitle", "time": 7091.669, "timestamp": "01:58:11", "text": "レベル31。いや、私は50がいい。私は"}, {"type": "subtitle", "time": 7093.589, "timestamp": "01:58:13", "text": "50歳になる"}, {"type": "subtitle", "time": 7096.79, "timestamp": "01:58:16", "text": "けど、それでいい。"}, {"type": "subtitle", "time": 7106.55, "timestamp": "01:58:26", "text": "素晴らしい"}, {"type": "subtitle", "time": 7116.709, "timestamp": "01:58:36", "text": "クマチャンダ、"}, {"type": "subtitle", "time": 7120.55, "timestamp": "01:58:40", "text": "お前をそこに投げ飛ばしてやる。"}, {"type": "subtitle", "time": 7122.629, "timestamp": "01:58:42", "text": "私は"}, {"type": "subtitle", "time": 7130.47, "timestamp": "01:58:50", "text": "あなたの犠牲に感謝します。"}, {"type": "subtitle", "time": 7133.27, "timestamp": "01:58:53", "text": "胸部をありがとうございます。"}, {"type": "subtitle", "time": 7136.87, "timestamp": "01:58:56", "text": "やったー、宝箱を手に入れたぞ。"}]
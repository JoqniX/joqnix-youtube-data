[{"type": "subtitle", "time": 6423.35, "timestamp": "01:47:03", "text": "私は宝箱を取った。 そして、「"}, {"type": "subtitle", "time": 6428.629, "timestamp": "01:47:08", "text": "ああ、そこにいたのか」という声が聞こえます。 異物を手に入れた。   私を"}, {"type": "subtitle", "time": 6430.87, "timestamp": "01:47:10", "text": "動揺させてくれ。"}, {"type": "subtitle", "time": 6443.35, "timestamp": "01:47:23", "text": "なぜできないのですか？ はい、どうぞ。"}, {"type": "subtitle", "time": 6445.51, "timestamp": "01:47:25", "text": "いやー、正直言って、この中国語のインタラクティブ"}, {"type": "subtitle", "time": 6448.149, "timestamp": "01:47:28", "text": "マップは英語のものよりずっと優れているよ。"}, {"type": "subtitle", "time": 6452.149, "timestamp": "01:47:32", "text": "英語のものは、"}, {"type": "subtitle", "time": 6457.99, "timestamp": "01:47:37", "text": "発見したとマークしたりするのに料金がかかるんだ。 それはやりすぎだ。 そして、その"}, {"type": "subtitle", "time": 6461.43, "timestamp": "01:47:41", "text": "下には。 彼らと話すべきか、"}, {"type": "subtitle", "time": 6464.95, "timestamp": "01:47:44", "text": "それとも「"}, {"type": "subtitle", "time": 6478.07, "timestamp": "01:47:58", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 6479.669, "timestamp": "01:47:59", "text": "ゲームでは何をしているの？ ただ"}]
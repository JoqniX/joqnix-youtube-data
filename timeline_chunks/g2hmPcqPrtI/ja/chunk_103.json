[{"type": "subtitle", "time": 6195.03, "timestamp": "01:43:15", "text": "空虚な喜びを癒す、酸っぱい白い薬。"}, {"type": "subtitle", "time": 6197.83, "timestamp": "01:43:17", "text": "ああ、神様。 くそ。  1つ目完了。  2つ目を"}, {"type": "subtitle", "time": 6200.629, "timestamp": "01:43:20", "text": "見つける必要がある。"}, {"type": "subtitle", "time": 6203.109, "timestamp": "01:43:23", "text": "こんにちは。 こんにちは。   2つ目"}, {"type": "subtitle", "time": 6230.149, "timestamp": "01:43:50", "text": "。"}, {"type": "subtitle", "time": 6234.229, "timestamp": "01:43:54", "text": "すぐそこか、どこかにあるはずです。"}]
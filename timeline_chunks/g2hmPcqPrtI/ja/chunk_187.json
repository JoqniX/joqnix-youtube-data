[{"type": "subtitle", "time": 11221.75, "timestamp": "03:07:01", "text": "この男はそこまでしたんだ。"}, {"type": "subtitle", "time": 11224.15, "timestamp": "03:07:04", "text": "目を送り、手紙を送り、とうに"}, {"type": "subtitle", "time": 11227.75, "timestamp": "03:07:07", "text": "亡くなった人のためにこれほどの手間をかける。"}, {"type": "subtitle", "time": 11229.83, "timestamp": "03:07:09", "text": "なぜだろう。"}, {"type": "subtitle", "time": 11239.429, "timestamp": "03:07:19", "text": "。   どうしたんだ"}, {"type": "subtitle", "time": 11241.03, "timestamp": "03:07:21", "text": "、ティンおじさん？"}, {"type": "subtitle", "time": 11243.67, "timestamp": "03:07:23", "text": "それらは代わりがきかない。"}, {"type": "subtitle", "time": 11244.95, "timestamp": "03:07:24", "text": "なぜだめですか？"}, {"type": "subtitle", "time": 11247.67, "timestamp": "03:07:27", "text": "彼女は新しい目を望んでいない。 たとえ"}, {"type": "subtitle", "time": 11250.15, "timestamp": "03:07:30", "text": "治療者が最善の意図を持っていたとしても、"}, {"type": "subtitle", "time": 11253.269, "timestamp": "03:07:33", "text": "それを強制することはできない。 彼女が望んでいたのは、"}]
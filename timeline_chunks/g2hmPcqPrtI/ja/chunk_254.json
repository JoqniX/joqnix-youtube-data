[{"type": "subtitle", "time": 15249.67, "timestamp": "04:14:09", "text": "それで、猫は私にこの"}, {"type": "subtitle", "time": 15266.07, "timestamp": "04:14:26", "text": "私は本当のことを言っています。   お前らのことなんてどうでもいい"}, {"type": "subtitle", "time": 15268.55, "timestamp": "04:14:28", "text": "。 私はただ"}, {"type": "subtitle", "time": 15298.229, "timestamp": "04:14:58", "text": "お母さんのところへ帰りなさい。   わかった"}]
[{"type": "subtitle", "time": 6130.07, "timestamp": "01:42:10", "text": "これは収穫できる。"}, {"type": "subtitle", "time": 6133.59, "timestamp": "01:42:13", "text": "見た目は金色だけどね。"}, {"type": "subtitle", "time": 6136.629, "timestamp": "01:42:16", "text": "なぜ彼女はコピーなのか？"}, {"type": "subtitle", "time": 6138.72, "timestamp": "01:42:18", "text": "黒人がこの金のものを主張していると聞いた。"}]
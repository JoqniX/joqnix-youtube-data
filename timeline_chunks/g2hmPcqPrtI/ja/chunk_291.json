[{"type": "subtitle", "time": 17463.19, "timestamp": "04:51:03", "text": "93. わかりました。 さて、そろそろ"}, {"type": "subtitle", "time": 17466.55, "timestamp": "04:51:06", "text": "こちらでの締めくくりを始めます。 わかった。"}, {"type": "subtitle", "time": 17476.788, "timestamp": "04:51:16", "text": "今日は本当にたくさんのことをしました。   私は"}, {"type": "subtitle", "time": 17480.628, "timestamp": "04:51:20", "text": "早く寝ます。 私は"}, {"type": "subtitle", "time": 17505.43, "timestamp": "04:51:45", "text": "待って。 ええ、そうですね。 本日お越しいただいた皆様、ありがとうございました"}, {"type": "subtitle", "time": 17507.83, "timestamp": "04:51:47", "text": "。 本当に、本当に"}, {"type": "subtitle", "time": 17509.35, "timestamp": "04:51:49", "text": "楽しかった。"}, {"type": "subtitle", "time": 17511.83, "timestamp": "04:51:51", "text": "今日はとても楽しかったです。"}, {"type": "subtitle", "time": 17514.868, "timestamp": "04:51:54", "text": "最後までお付き合いいただき、ありがとうございました。 潜んでいた者たち。"}, {"type": "subtitle", "time": 17517.11, "timestamp": "04:51:57", "text": "よし、[音楽] Twitch とビームを用意して。   本当に"}]
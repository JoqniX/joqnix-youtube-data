[{"type": "subtitle", "time": 12600.389, "timestamp": "03:30:00", "text": "。"}, {"type": "subtitle", "time": 12602.469, "timestamp": "03:30:02", "text": "そしてそのまま眠ってしまうんです（笑）。あるいは、"}, {"type": "subtitle", "time": 12606.15, "timestamp": "03:30:06", "text": "眠るためにキャンプに行くこともあります。"}, {"type": "subtitle", "time": 12609.429, "timestamp": "03:30:09", "text": "それはとても素晴らしいですね。"}, {"type": "subtitle", "time": 12619.349, "timestamp": "03:30:19", "text": "毎年夏になるとまさにその通りだ。 おお、"}]
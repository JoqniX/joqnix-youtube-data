[{"type": "subtitle", "time": 9923.11, "timestamp": "02:45:23", "text": "The mountain door opened up."}, {"type": "subtitle", "time": 9924.55, "timestamp": "02:45:24", "text": ">> A door opened over there."}, {"type": "subtitle", "time": 9927.349, "timestamp": "02:45:27", "text": ">> Music before entering. Perhaps to alert"}, {"type": "subtitle", "time": 9929.99, "timestamp": "02:45:29", "text": "the lunar goddess of our arrival. Let's"}, {"type": "subtitle", "time": 9937.349, "timestamp": "02:45:37", "text": ">> By the way, if we get trapped at the"}, {"type": "subtitle", "time": 9939.99, "timestamp": "02:45:39", "text": "bottom of this lake, we wouldn't starve"}, {"type": "subtitle", "time": 9942.87, "timestamp": "02:45:42", "text": "even after a year. Do you know what a"}, {"type": "subtitle", "time": 9944.55, "timestamp": "02:45:44", "text": "corpse?"}, {"type": "subtitle", "time": 9947.59, "timestamp": "02:45:47", "text": ">> Seems someone found her after all. You"}, {"type": "subtitle", "time": 9950.389, "timestamp": "02:45:50", "text": "go ahead. I'll stay and have a look at"}, {"type": "subtitle", "time": 9953.03, "timestamp": "02:45:53", "text": "this."}]
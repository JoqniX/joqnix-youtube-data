[{"type": "subtitle", "time": 11165.59, "timestamp": "03:06:05", "text": "Either way, the Everare Clinic has a no"}, {"type": "subtitle", "time": 11168.63, "timestamp": "03:06:08", "text": "refund policy. Though a corpse she may"}, {"type": "subtitle", "time": 11171.269, "timestamp": "03:06:11", "text": "be, I'll honor my agreement to replace"}, {"type": "subtitle", "time": 11173.11, "timestamp": "03:06:13", "text": "her eyes. Would you fetch me that eye"}, {"type": "subtitle", "time": 11205.349, "timestamp": "03:06:45", "text": ">> here. Uncle Tin,"}, {"type": "subtitle", "time": 11207.349, "timestamp": "03:06:47", "text": ">> the case was sitting perfectly square on"}, {"type": "subtitle", "time": 11209.429, "timestamp": "03:06:49", "text": "the stone table without a speck of dust."}, {"type": "subtitle", "time": 11212.23, "timestamp": "03:06:52", "text": ">> Yes, these can't be stored long. Someone"}, {"type": "subtitle", "time": 11215.67, "timestamp": "03:06:55", "text": "must have delivered them recently."}, {"type": "subtitle", "time": 11218.63, "timestamp": "03:06:58", "text": "The same person who wrote the letter."}]
[{"type": "subtitle", "time": 10503.11, "timestamp": "02:55:03", "text": "哦，我討厭可怕的藍色海水。  箱子真多。  在哪裡？這是哪裡"}, {"type": "subtitle", "time": 10504.71, "timestamp": "02:55:04", "text": "？好的。  我剛離開"}, {"type": "subtitle", "time": 10522.07, "timestamp": "02:55:22", "text": "這裡。  我只是，我知道，只是去，只是去。"}, {"type": "subtitle", "time": 10545.83, "timestamp": "02:55:45", "text": "全都有。  我發誓，我的生命。好的。  哦，不。"}, {"type": "subtitle", "time": 10550.309, "timestamp": "02:55:50", "text": "月神駕崩。  A9姐妹分享。  我弄了"}]
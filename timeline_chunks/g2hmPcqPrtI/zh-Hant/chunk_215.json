[{"type": "subtitle", "time": 12909.03, "timestamp": "03:35:09", "text": "那裡有個土堆。什麼？  什麼？"}, {"type": "subtitle", "time": 12916.469, "timestamp": "03:35:16", "text": "你小時候經常"}, {"type": "subtitle", "time": 12923.349, "timestamp": "03:35:23", "text": "你是個十足的外向者。"}, {"type": "subtitle", "time": 12926.469, "timestamp": "03:35:26", "text": "通常性格外向。"}, {"type": "subtitle", "time": 12928.87, "timestamp": "03:35:28", "text": "該死。它怎麼走？"}, {"type": "subtitle", "time": 12931.99, "timestamp": "03:35:31", "text": "太酷了！"}]
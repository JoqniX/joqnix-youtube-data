[{"type": "subtitle", "time": 722.389, "timestamp": "00:12:02", "text": "6點就醒了。我本來想直播，結果被其他事分心了。"}, {"type": "subtitle", "time": 731.829, "timestamp": "00:12:11", "text": "我當時在看一個日本 YouTuber 的直播，他直播的時候會和觀眾互動，還會播放音樂，還會和聊天室裡的"}, {"type": "subtitle", "time": 747.67, "timestamp": "00:12:27", "text": "其他人互動，我自己也在學習日語，然後我就笑了，然後我就想，"}, {"type": "subtitle", "time": 776.949, "timestamp": "00:12:56", "text": "哇，昨天已經 9"}]
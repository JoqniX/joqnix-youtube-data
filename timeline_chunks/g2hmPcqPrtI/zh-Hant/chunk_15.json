[{"type": "subtitle", "time": 900.31, "timestamp": "00:15:00", "text": "安裝了《Farlight》，然後我"}, {"type": "subtitle", "time": 902.71, "timestamp": "00:15:02", "text": "就想，是的，我不能經常玩這些遊戲，你知道嗎？我只能在有時間的時候玩這些遊戲。我沒那麼多時間去肝這些遊戲。  這是絕對"}, {"type": "subtitle", "time": 951.59, "timestamp": "00:15:51", "text": "不行的，因為我內心深處知道我根本無法積極地努力奮鬥"}]
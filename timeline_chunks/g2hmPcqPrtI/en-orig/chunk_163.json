[{"type": "subtitle", "time": 9789.03, "timestamp": "02:43:09", "text": ">> A beautiful statue though its eyes are"}, {"type": "subtitle", "time": 9791.03, "timestamp": "02:43:11", "text": "covered with cloth."}, {"type": "subtitle", "time": 9795.429, "timestamp": "02:43:15", "text": ">> Uncle Ten, is this the lunar goddess?"}, {"type": "subtitle", "time": 9795.67, "timestamp": "02:43:15", "text": ">> Yes,"}, {"type": "subtitle", "time": 9797.11, "timestamp": "02:43:17", "text": ">> the lunar goddess."}, {"type": "subtitle", "time": 9804.07, "timestamp": "02:43:24", "text": ">> She can't see. And she's a sword"}, {"type": "subtitle", "time": 9806.71, "timestamp": "02:43:26", "text": "fighter. ordinary people wouldn't be"}, {"type": "subtitle", "time": 9809.27, "timestamp": "02:43:29", "text": "able to. But for the lunar goddess,"}, {"type": "subtitle", "time": 9812.23, "timestamp": "02:43:32", "text": "let's just say when you meet her, be on"}, {"type": "subtitle", "time": 9815.67, "timestamp": "02:43:35", "text": "your best behavior."}, {"type": "subtitle", "time": 9817.59, "timestamp": "02:43:37", "text": "The bottom of the lake seems like a"}, {"type": "subtitle", "time": 9821.429, "timestamp": "02:43:41", "text": "whole hidden world. But where's the path"}]
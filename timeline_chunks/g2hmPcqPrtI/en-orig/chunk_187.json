[{"type": "subtitle", "time": 11221.75, "timestamp": "03:07:01", "text": ">> This guy went to such lengths. Sending"}, {"type": "subtitle", "time": 11224.15, "timestamp": "03:07:04", "text": "eyes, sending the letter, going to all"}, {"type": "subtitle", "time": 11227.75, "timestamp": "03:07:07", "text": "this trouble for someone long dead. I"}, {"type": "subtitle", "time": 11229.83, "timestamp": "03:07:09", "text": "wonder why."}, {"type": "subtitle", "time": 11239.429, "timestamp": "03:07:19", "text": ">> Okay."}, {"type": "subtitle", "time": 11241.03, "timestamp": "03:07:21", "text": ">> What's wrong, Uncle Tin?"}, {"type": "subtitle", "time": 11243.67, "timestamp": "03:07:23", "text": ">> I can't replace them."}, {"type": "subtitle", "time": 11244.95, "timestamp": "03:07:24", "text": "Why not?"}, {"type": "subtitle", "time": 11247.67, "timestamp": "03:07:27", "text": ">> She has no wish for new eyes. Even with"}, {"type": "subtitle", "time": 11250.15, "timestamp": "03:07:30", "text": "a healer's best intentions, we can't"}, {"type": "subtitle", "time": 11253.269, "timestamp": "03:07:33", "text": "force it. What she wanted wasn't to see"}]
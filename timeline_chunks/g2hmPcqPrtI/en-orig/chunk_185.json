[{"type": "subtitle", "time": 11128.95, "timestamp": "03:05:28", "text": "lost the word?"}, {"type": "subtitle", "time": 11131.03, "timestamp": "03:05:31", "text": ">> Uncle Ten."}, {"type": "subtitle", "time": 11132.389, "timestamp": "03:05:32", "text": "Is this"}, {"type": "subtitle", "time": 11133.67, "timestamp": "03:05:33", "text": ">> She died."}, {"type": "subtitle", "time": 11138.55, "timestamp": "03:05:38", "text": ">> Jen, the lunar goddess. We're too late."}, {"type": "subtitle", "time": 11140.87, "timestamp": "03:05:40", "text": "She's been dead for 3 years, too."}, {"type": "subtitle", "time": 11143.59, "timestamp": "03:05:43", "text": ">> Three years."}, {"type": "subtitle", "time": 11145.67, "timestamp": "03:05:45", "text": ">> It seems during that battle three years"}, {"type": "subtitle", "time": 11147.67, "timestamp": "03:05:47", "text": "ago, her enemies died at the bottom of"}, {"type": "subtitle", "time": 11149.75, "timestamp": "03:05:49", "text": "the lake."}, {"type": "subtitle", "time": 11151.91, "timestamp": "03:05:51", "text": "But she didn't make it either."}, {"type": "subtitle", "time": 11155.75, "timestamp": "03:05:55", "text": ">> Then what about the letter you received?"}, {"type": "subtitle", "time": 11157.91, "timestamp": "03:05:57", "text": ">> Either a ghost or someone impersonating"}]
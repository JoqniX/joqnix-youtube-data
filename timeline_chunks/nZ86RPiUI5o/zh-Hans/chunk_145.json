[{"type": "subtitle", "time": 8708.23, "timestamp": "02:25:08", "text": "我忘了我的闪光灯开着。"}, {"type": "subtitle", "time": 8712.15, "timestamp": "02:25:12", "text": "哦，糟糕。难怪那个人……难怪"}, {"type": "subtitle", "time": 8715.75, "timestamp": "02:25:15", "text": "那个人一直在看我。真"}, {"type": "subtitle", "time": 8719.429, "timestamp": "02:25:19", "text": "奇怪。我的天哪。那个想"}, {"type": "subtitle", "time": 8725.99, "timestamp": "02:25:25", "text": "往右边走，在车里等着的家伙，一直在"}, {"type": "subtitle", "time": 8728.23, "timestamp": "02:25:28", "text": "看着我。我当时就想，“嘿，"}, {"type": "subtitle", "time": 8730.07, "timestamp": "02:25:30", "text": "他为什么看着我？”然后我才"}]
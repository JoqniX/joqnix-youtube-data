[{"type": "subtitle", "time": 5400.95, "timestamp": "01:30:00", "text": "是的，现在是21摄氏度。"}, {"type": "subtitle", "time": 5407.91, "timestamp": "01:30:07", "text": "到晚上11点，价格会降到6、16或17。   现在是晚上"}, {"type": "subtitle", "time": 5416.07, "timestamp": "01:30:16", "text": "[嗤笑] 不过看看"}, {"type": "subtitle", "time": 5417.669, "timestamp": "01:30:17", "text": "那边的那朵花。"}, {"type": "subtitle", "time": 5420.47, "timestamp": "01:30:20", "text": "鲜花之类的东西。"}, {"type": "subtitle", "time": 5423.11, "timestamp": "01:30:23", "text": "真不错。"}, {"type": "subtitle", "time": 5425.27, "timestamp": "01:30:25", "text": "现在是秋天。 所以大部分花都"}, {"type": "subtitle", "time": 5428.149, "timestamp": "01:30:28", "text": "干枯了。 这些是玫瑰。 但他们"}, {"type": "subtitle", "time": 5431.03, "timestamp": "01:30:31", "text": "有那东西。"}, {"type": "subtitle", "time": 5433.51, "timestamp": "01:30:33", "text": "你能读懂吗？"}, {"type": "subtitle", "time": 5443.83, "timestamp": "01:30:43", "text": "是什么？ 霍拉玫瑰。"}, {"type": "subtitle", "time": 5458.55, "timestamp": "01:30:58", "text": "这是什么？   那"}]
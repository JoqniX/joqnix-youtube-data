[{"type": "subtitle", "time": 7080.149, "timestamp": "01:58:00", "text": "很好听之类的。"}, {"type": "subtitle", "time": 7082.629, "timestamp": "01:58:02", "text": "我唱得特别难听，因为那是我"}, {"type": "subtitle", "time": 7085.35, "timestamp": "01:58:05", "text": "第一次进录音棚"}, {"type": "subtitle", "time": 7089.03, "timestamp": "01:58:09", "text": "唱歌什么的。 我当时很紧张，"}, {"type": "subtitle", "time": 7095.27, "timestamp": "01:58:15", "text": "真的非常紧张，而且很疼。 我当时太"}, {"type": "subtitle", "time": 7097.99, "timestamp": "01:58:17", "text": "紧张了，结果录音搞砸了"}, {"type": "subtitle", "time": 7101.43, "timestamp": "01:58:21", "text": "。 他们发给我的是混音版，"}, {"type": "subtitle", "time": 7104.229, "timestamp": "01:58:24", "text": "我当时就想，哇，这简直太"}, {"type": "subtitle", "time": 7107.91, "timestamp": "01:58:27", "text": "垃圾了。 我唱得太难听了。"}, {"type": "subtitle", "time": 7110.149, "timestamp": "01:58:30", "text": "那是反光材料吗？ 它具有"}, {"type": "subtitle", "time": 7112.149, "timestamp": "01:58:32", "text": "反射性。"}, {"type": "subtitle", "time": 7120.39, "timestamp": "01:58:40", "text": "所以"}, {"type": "subtitle", "time": 7122.629, "timestamp": "01:58:42", "text": "，说实话，我"}, {"type": "subtitle", "time": 7125.51, "timestamp": "01:58:45", "text": "在日本期间获得了许多机会，这都"}, {"type": "subtitle", "time": 7127.91, "timestamp": "01:58:47", "text": "得益于我去过的那些开放式校园，"}, {"type": "subtitle", "time": 7130.709, "timestamp": "01:58:50", "text": "比如东京、新宿"}, {"type": "subtitle", "time": 7132.95, "timestamp": "01:58:52", "text": "等等。"}, {"type": "subtitle", "time": 7134.709, "timestamp": "01:58:54", "text": "我想参观的学校有很多"}, {"type": "subtitle", "time": 7139.03, "timestamp": "01:58:59", "text": "，但是我没钱。 我没钱了。"}]
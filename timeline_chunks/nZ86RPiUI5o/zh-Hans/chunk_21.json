[{"type": "subtitle", "time": 1265.59, "timestamp": "00:21:05", "text": "兄弟，"}, {"type": "subtitle", "time": 1270.149, "timestamp": "00:21:10", "text": "这可糟了，兄弟。"}, {"type": "subtitle", "time": 1276.149, "timestamp": "00:21:16", "text": "太糟糕了。"}, {"type": "subtitle", "time": 1285.029, "timestamp": "00:21:25", "text": "我只能像这样用手拿着它，"}, {"type": "subtitle", "time": 1289.75, "timestamp": "00:21:29", "text": "因为篮子晃动得太厉害了。"}, {"type": "subtitle", "time": 1302.07, "timestamp": "00:21:42", "text": "看，你看，篮子里的东西我尽力了。"}, {"type": "subtitle", "time": 1305.99, "timestamp": "00:21:45", "text": "比山涧溪流还要糟糕。"}, {"type": "subtitle", "time": 1307.669, "timestamp": "00:21:47", "text": "你知道吗？ 我先把它拿在手里"}, {"type": "subtitle", "time": 1309.59, "timestamp": "00:21:49", "text": "。"}, {"type": "subtitle", "time": 1312.47, "timestamp": "00:21:52", "text": "我暂时就先这样吧。"}]
[{"type": "subtitle", "time": 1027.27, "timestamp": "00:17:07", "text": "鸡。"}, {"type": "subtitle", "time": 1030.47, "timestamp": "00:17:10", "text": "哦，我明白了。"}, {"type": "subtitle", "time": 1069.029, "timestamp": "00:17:49", "text": "我把印度薄饼放进包里。 但是"}, {"type": "subtitle", "time": 1071.27, "timestamp": "00:17:51", "text": "音频没问题，对吧？ 嗯，你"}, {"type": "subtitle", "time": 1073.909, "timestamp": "00:17:53", "text": "能听到我说话吗？ 清楚明白了吗"}, {"type": "subtitle", "time": 1078.71, "timestamp": "00:17:58", "text": "？ 所以，他们会浑身颤抖。"}]
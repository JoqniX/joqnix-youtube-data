[{"type": "subtitle", "time": 5340.709, "timestamp": "01:29:00", "text": "绿色植物呢。 我以为所有东西"}, {"type": "subtitle", "time": 5342.95, "timestamp": "01:29:02", "text": "都会是黄色"}, {"type": "subtitle", "time": 5350.149, "timestamp": "01:29:10", "text": "这是一个公园。 那看起来像是"}, {"type": "subtitle", "time": 5359.189, "timestamp": "01:29:19", "text": "我打开三脚架，嗯……嗯……"}, {"type": "subtitle", "time": 5363.43, "timestamp": "01:29:23", "text": "我通常……这是我第"}, {"type": "subtitle", "time": 5367.669, "timestamp": "01:29:27", "text": "一次用三脚架，通常我都是"}, {"type": "subtitle", "time": 5370.55, "timestamp": "01:29:30", "text": "用手拿着手机，但这样就"}, {"type": "subtitle", "time": 5377.43, "timestamp": "01:29:37", "text": "，现在看得更清楚了。   可是，"}, {"type": "subtitle", "time": 5383.51, "timestamp": "01:29:43", "text": "为什么现在感觉像恐怖片呢？"}, {"type": "subtitle", "time": 5390.709, "timestamp": "01:29:50", "text": "。 呃，你可以看到"}]
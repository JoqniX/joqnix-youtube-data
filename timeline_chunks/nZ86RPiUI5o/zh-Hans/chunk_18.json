[{"type": "subtitle", "time": 1081.83, "timestamp": "00:18:01", "text": "但是，等等，我可以打开设置"}, {"type": "subtitle", "time": 1087.75, "timestamp": "00:18:07", "text": "来"}, {"type": "subtitle", "time": 1092.542, "timestamp": "00:18:12", "text": "稳定画面吗？ 哦，开始了。 嗨，有人吗？"}, {"type": "subtitle", "time": 1093.19, "timestamp": "00:18:13", "text": "[嗤笑]"}, {"type": "subtitle", "time": 1095.43, "timestamp": "00:18:15", "text": "所以，接下来我们将进行桌面"}, {"type": "subtitle", "time": 1097.75, "timestamp": "00:18:17", "text": "直播。   妈的"}, {"type": "subtitle", "time": 1101.11, "timestamp": "00:18:21", "text": "。 我忘了……"}, {"type": "subtitle", "time": 1104.23, "timestamp": "00:18:24", "text": "节目中没有倒影。"}, {"type": "subtitle", "time": 1107.83, "timestamp": "00:18:27", "text": "但我不想泄露自己的个人信息。"}, {"type": "subtitle", "time": 1130.87, "timestamp": "00:18:50", "text": "好的。 走吧（嗤笑）。 我得抓紧时间"}, {"type": "subtitle", "time": 1133.11, "timestamp": "00:18:53", "text": "。 我得抓紧时间。 去吃"}, {"type": "subtitle", "time": 1139.59, "timestamp": "00:18:59", "text": "当然。 会有，呃，会有"}]
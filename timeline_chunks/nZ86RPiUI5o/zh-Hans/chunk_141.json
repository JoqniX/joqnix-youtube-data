[{"type": "subtitle", "time": 8460.95, "timestamp": "02:21:00", "text": "什么的。"}, {"type": "subtitle", "time": 8464.95, "timestamp": "02:21:04", "text": "我笨得要命。我就像一只"}, {"type": "subtitle", "time": 8472.87, "timestamp": "02:21:12", "text": "[嗤之以鼻]"}, {"type": "subtitle", "time": 8476.23, "timestamp": "02:21:16", "text": "然后我就说，哦，对了，这是一家"}, {"type": "subtitle", "time": 8478.95, "timestamp": "02:21:18", "text": "叫Bambina的餐厅。他们有一台"}, {"type": "subtitle", "time": 8481.03, "timestamp": "02:21:21", "text": "自动售货机，可以买吃的。"}, {"type": "subtitle", "time": 8488.309, "timestamp": "02:21:28", "text": "哦，对。妈，你和"}, {"type": "subtitle", "time": 8490.389, "timestamp": "02:21:30", "text": "Konada，你们俩都没见过这个，"}, {"type": "subtitle", "time": 8494.389, "timestamp": "02:21:34", "text": "对吧？呃，"}, {"type": "subtitle", "time": 8496.95, "timestamp": "02:21:36", "text": "之前直播的一些人看到了。"}, {"type": "subtitle", "time": 8499.75, "timestamp": "02:21:39", "text": "这里有一台自动售货机，"}, {"type": "subtitle", "time": 8502.15, "timestamp": "02:21:42", "text": "你可以投币，然后"}, {"type": "subtitle", "time": 8505.03, "timestamp": "02:21:45", "text": "从下面拿吃的。"}, {"type": "subtitle", "time": 8507.67, "timestamp": "02:21:47", "text": "对，像披萨、意大利面之"}, {"type": "subtitle", "time": 8511.11, "timestamp": "02:21:51", "text": "类的。都可以从下面拿。"}, {"type": "subtitle", "time": 8513.59, "timestamp": "02:21:53", "text": "我觉得不用进去。"}, {"type": "subtitle", "time": 8515.75, "timestamp": "02:21:55", "text": "或者需要进去吗？也许需要一张票"}]
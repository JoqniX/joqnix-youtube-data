[{"type": "subtitle", "time": 8641.03, "timestamp": "02:24:01", "text": "啊，糟糕，伙计。为什么？"}, {"type": "subtitle", "time": 8643.67, "timestamp": "02:24:03", "text": "为什么我在看视频的时候手机充不上电"}, {"type": "subtitle", "time": 8649.51, "timestamp": "02:24:09", "text": "？为什么这是旧手机？"}, {"type": "subtitle", "time": 8654.55, "timestamp": "02:24:14", "text": "我的天啊。请变绿。呃，"}, {"type": "subtitle", "time": 8657.91, "timestamp": "02:24:17", "text": "是的，这手机讨厌快充。"}, {"type": "subtitle", "time": 8660.55, "timestamp": "02:24:20", "text": "正常 充电？它讨厌充电。它需要那种"}, {"type": "subtitle", "time": 8665.27, "timestamp": "02:24:25", "text": "超级快充，就像那种"}, {"type": "subtitle", "time": 8668.389, "timestamp": "02:24:28", "text": "蓝绿色、蓝绿色的快"}, {"type": "subtitle", "time": 8671.75, "timestamp": "02:24:31", "text": "充一样，不然根本充不进去。哦"}, {"type": "subtitle", "time": 8673.99, "timestamp": "02:24:33", "text": "天哪，只有2%了。"}, {"type": "subtitle", "time": 8680.55, "timestamp": "02:24:40", "text": "好了，它要变绿了。我们"}, {"type": "subtitle", "time": 8682.79, "timestamp": "02:24:42", "text": "要跑了。好了，它要变绿了。"}, {"type": "subtitle", "time": 8684.309, "timestamp": "02:24:44", "text": "我要跑了。"}, {"type": "subtitle", "time": 8685.99, "timestamp": "02:24:45", "text": "好了。"}, {"type": "subtitle", "time": 8688.15, "timestamp": "02:24:48", "text": "或者我应该就此结束直播？"}]
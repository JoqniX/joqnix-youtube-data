[{"type": "subtitle", "time": 1801.269, "timestamp": "00:30:01", "text": "早晨的炎热天气"}, {"type": "subtitle", "time": 1819.35, "timestamp": "00:30:19", "text": "反光，对吧？ 我必须小心。"}, {"type": "subtitle", "time": 1822.87, "timestamp": "00:30:22", "text": "我单手开车，呃，我是说骑"}, {"type": "subtitle", "time": 1824.47, "timestamp": "00:30:24", "text": "自行车。"}, {"type": "subtitle", "time": 1827.43, "timestamp": "00:30:27", "text": "啊，那是一辆车。 哦，不。 好吧，他们"}, {"type": "subtitle", "time": 1830.23, "timestamp": "00:30:30", "text": "放他过去了。 好的。"}, {"type": "subtitle", "time": 1831.669, "timestamp": "00:30:31", "text": "对了，你知道"}, {"type": "subtitle", "time": 1835.269, "timestamp": "00:30:35", "text": "日本的自行车也有车牌吗？"}, {"type": "subtitle", "time": 1836.95, "timestamp": "00:30:36", "text": "我应该吗？"}, {"type": "subtitle", "time": 1840.549, "timestamp": "00:30:40", "text": "好的，我可以承受接下来的一切。 哦，等等。"}, {"type": "subtitle", "time": 1854.149, "timestamp": "00:30:54", "text": "啊，原来我不应该那样做"}, {"type": "subtitle", "time": 1856.389, "timestamp": "00:30:56", "text": "。 我本应该让那位"}, {"type": "subtitle", "time": 1859.59, "timestamp": "00:30:59", "text": "行人先行通过。"}]
[{"type": "subtitle", "time": 4924.31, "timestamp": "01:22:04", "text": "哦，是的。  70次任务。 在那儿等着。"}, {"type": "subtitle", "time": 4927.91, "timestamp": "01:22:07", "text": "呃，我这里没有相机变焦功能。"}, {"type": "subtitle", "time": 4930.79, "timestamp": "01:22:10", "text": "我的天啊。"}, {"type": "subtitle", "time": 4934.229, "timestamp": "01:22:14", "text": "相机变焦。"}, {"type": "subtitle", "time": 4940.629, "timestamp": "01:22:20", "text": "。 等等，我该如何使用“哦，是的”？"}, {"type": "subtitle", "time": 4942.07, "timestamp": "01:22:22", "text": "你没办法改变"}, {"type": "subtitle", "time": 4944.07, "timestamp": "01:22:24", "text": "角度，对吧？"}, {"type": "subtitle", "time": 4947.59, "timestamp": "01:22:27", "text": "好的。 我们有怪兽"}, {"type": "subtitle", "time": 4950.229, "timestamp": "01:22:30", "text": "熊猫可口可乐水族"}, {"type": "subtitle", "time": 4954.149, "timestamp": "01:22:34", "text": "运动饮料可乐，那"}, {"type": "subtitle", "time": 4958.55, "timestamp": "01:22:38", "text": "是绿茶，呃，水，速溶"}, {"type": "subtitle", "time": 4962.229, "timestamp": "01:22:42", "text": "葡萄，咖啡，"}, {"type": "subtitle", "time": 4965.59, "timestamp": "01:22:45", "text": "咖啡，其他都是咖啡，"}, {"type": "subtitle", "time": 4970.07, "timestamp": "01:22:50", "text": "一样的咖啡，咖啡，咖啡拿铁，"}, {"type": "subtitle", "time": 4972.07, "timestamp": "01:22:52", "text": "你甚至可以说那是印度"}, {"type": "subtitle", "time": 4973.59, "timestamp": "01:22:53", "text": "奶茶"}, {"type": "subtitle", "time": 4977.51, "timestamp": "01:22:57", "text": "和能量饮料，一些能量饮料，"}, {"type": "subtitle", "time": 4979.11, "timestamp": "01:22:59", "text": "沙滩，"}]
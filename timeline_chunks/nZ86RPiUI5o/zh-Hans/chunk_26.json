[{"type": "subtitle", "time": 1561.51, "timestamp": "00:26:01", "text": "从左边往右走；当"}, {"type": "subtitle", "time": 1564.31, "timestamp": "00:26:04", "text": "右边没有车的时候，我就直走。 这很"}, {"type": "subtitle", "time": 1567.43, "timestamp": "00:26:07", "text": "糟糕，违法，但即便如此。"}, {"type": "subtitle", "time": 1584.149, "timestamp": "00:26:24", "text": "兄弟，我得把这个印度薄饼"}, {"type": "subtitle", "time": 1588.549, "timestamp": "00:26:28", "text": "和肯德基的鸡肉混合装，就是那个"}, {"type": "subtitle", "time": 1590.789, "timestamp": "00:26:30", "text": "玛萨拉口味的，送出去。   是的，就是"}, {"type": "subtitle", "time": 1602.31, "timestamp": "00:26:42", "text": "什么？"}, {"type": "subtitle", "time": 1605.413, "timestamp": "00:26:45", "text": "我不能撒谎。"}, {"type": "subtitle", "time": 1606.31, "timestamp": "00:26:46", "text": "[呻吟]"}, {"type": "subtitle", "time": 1609.909, "timestamp": "00:26:49", "text": "哦，我……你没把锁扣上。"}, {"type": "subtitle", "time": 1618.789, "timestamp": "00:26:58", "text": "。 拉屎。"}]
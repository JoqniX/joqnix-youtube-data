[{"type": "subtitle", "time": 7201.51, "timestamp": "02:00:01", "text": "公园里，一会儿就回来"}, {"type": "subtitle", "time": 7208.229, "timestamp": "02:00:08", "text": "。 好的。"}, {"type": "subtitle", "time": 7219.27, "timestamp": "02:00:19", "text": "9090. 发生了什么事？"}, {"type": "subtitle", "time": 7222.31, "timestamp": "02:00:22", "text": "这里的人都说我的音乐品味很怪"}, {"type": "subtitle", "time": 7230.39, "timestamp": "02:00:30", "text": "呃，"}, {"type": "subtitle", "time": 7232.95, "timestamp": "02:00:32", "text": "日本流行音乐之类的。 是啊，看来我们俩"}, {"type": "subtitle", "time": 7235.99, "timestamp": "02:00:35", "text": "很像。 我也听日本流行音乐之"}, {"type": "subtitle", "time": 7238.39, "timestamp": "02:00:38", "text": "类的。 我以前可是个铁杆电子舞曲"}, {"type": "subtitle", "time": 7240.31, "timestamp": "02:00:40", "text": "迷呢"}, {"type": "subtitle", "time": 7243.03, "timestamp": "02:00:43", "text": "。 我小时候就是听电子舞曲（EDM）才开始"}, {"type": "subtitle", "time": 7245.99, "timestamp": "02:00:45", "text": "接触音乐，并喜欢上音乐制作之"}, {"type": "subtitle", "time": 7248.55, "timestamp": "02:00:48", "text": "类的。"}, {"type": "subtitle", "time": 7251.189, "timestamp": "02:00:51", "text": "呃，大概10岁左右吧。"}, {"type": "subtitle", "time": 7255.27, "timestamp": "02:00:55", "text": "时间非常有限。 是的，我大概也是在"}, {"type": "subtitle", "time": 7259.99, "timestamp": "02:00:59", "text": "那个年纪开始制作音乐的。  10、11、12"}]
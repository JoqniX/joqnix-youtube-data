[{"type": "subtitle", "time": 8400.309, "timestamp": "02:20:00", "text": "。   是的"}, {"type": "subtitle", "time": 8403.67, "timestamp": "02:20:03", "text": "。 如果您想"}, {"type": "subtitle", "time": 8407.03, "timestamp": "02:20:07", "text": "观看以前的内容，可以"}, {"type": "subtitle", "time": 8410.309, "timestamp": "02:20:10", "text": "收看 V 频道或 24 频道。"}, {"type": "subtitle", "time": 8413.99, "timestamp": "02:20:13", "text": "这就像电视节目一样。 它一直在"}, {"type": "subtitle", "time": 8426.389, "timestamp": "02:20:26", "text": "所以，我，我看到了。 我看过那个视频"}, {"type": "subtitle", "time": 8428.55, "timestamp": "02:20:28", "text": "。   是的"}, {"type": "subtitle", "time": 8431.83, "timestamp": "02:20:31", "text": "。 那里真是太戏剧化了。 是的。"}, {"type": "subtitle", "time": 8434.95, "timestamp": "02:20:34", "text": "曾经有个人跟我说过："}, {"type": "subtitle", "time": 8439.51, "timestamp": "02:20:39", "text": "“乔，你"}, {"type": "subtitle", "time": 8442.309, "timestamp": "02:20:42", "text": "现在简直就是独立滑板界的巨擘。”"}, {"type": "subtitle", "time": 8445.349, "timestamp": "02:20:45", "text": "有人竟然跟我说："}, {"type": "subtitle", "time": 8448.15, "timestamp": "02:20:48", "text": "“你知道，你可以搞一些哗众取宠之类的"}, {"type": "subtitle", "time": 8451.19, "timestamp": "02:20:51", "text": "事情来博取点击量"}, {"type": "subtitle", "time": 8452.95, "timestamp": "02:20:52", "text": "，"}, {"type": "subtitle", "time": 8456.389, "timestamp": "02:20:56", "text": "对吧？” 然后我就说：“是啊，"}, {"type": "subtitle", "time": 8459.429, "timestamp": "02:20:59", "text": "我从来都不懂政治"}]
[{"type": "subtitle", "time": 3726.47, "timestamp": "01:02:06", "text": "好了，各位。 我忘了件事。 我忘了"}, {"type": "subtitle", "time": 3730.069, "timestamp": "01:02:10", "text": "锁我那该死的破自行车。 我的"}, {"type": "subtitle", "time": 3733.19, "timestamp": "01:02:13", "text": "天啊。 是的。 再见。 为什么会显示“该死的"}, {"type": "subtitle", "time": 3735.829, "timestamp": "01:02:15", "text": "愚蠢循环”？ 我的天啊。 去。 是的，我"}, {"type": "subtitle", "time": 3738.309, "timestamp": "01:02:18", "text": "不应该用这么粗鲁的方式说话。"}, {"type": "subtitle", "time": 3742.069, "timestamp": "01:02:22", "text": "对不起。  [嗤笑] 莫，我居然忘了。"}, {"type": "subtitle", "time": 3744.87, "timestamp": "01:02:24", "text": "耶。"}, {"type": "subtitle", "time": 3746.39, "timestamp": "01:02:26", "text": "好的。"}, {"type": "subtitle", "time": 3747.829, "timestamp": "01:02:27", "text": "好吧，我现在在外面。（嗤笑）"}, {"type": "subtitle", "time": 3750.15, "timestamp": "01:02:30", "text": "所以，我们走走吧"}, {"type": "subtitle", "time": 3753.589, "timestamp": "01:02:33", "text": "，好吗？走"}, {"type": "subtitle", "time": 3755.589, "timestamp": "01:02:35", "text": "一会儿。"}, {"type": "subtitle", "time": 3758.789, "timestamp": "01:02:38", "text": "我要把我的循环恢复正常。"}, {"type": "subtitle", "time": 3763.589, "timestamp": "01:02:43", "text": "你好。 然后，我们会步行。"}, {"type": "subtitle", "time": 3767.349, "timestamp": "01:02:47", "text": "呃，什么？让我锁一下。  [清嗓子]"}, {"type": "subtitle", "time": 3771.349, "timestamp": "01:02:51", "text": "不，你还在吧？ 我想"}, {"type": "subtitle", "time": 3773.589, "timestamp": "01:02:53", "text": "告诉"}, {"type": "subtitle", "time": 3776.95, "timestamp": "01:02:56", "text": "你，你需要设置锁屏。"}]
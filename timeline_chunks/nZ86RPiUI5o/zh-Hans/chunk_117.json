[{"type": "subtitle", "time": 7023.43, "timestamp": "01:57:03", "text": "所以这个高中女生想"}, {"type": "subtitle", "time": 7027.109, "timestamp": "01:57:07", "text": "加入Ado的那个小组之类的。 所以"}, {"type": "subtitle", "time": 7029.35, "timestamp": "01:57:09", "text": "她现在正在拼命训练"}, {"type": "subtitle", "time": 7031.669, "timestamp": "01:57:11", "text": "。   是的"}, {"type": "subtitle", "time": 7034.709, "timestamp": "01:57:14", "text": "。 铂。 改成“是”。 是的。   是的"}, {"type": "subtitle", "time": 7038.39, "timestamp": "01:57:18", "text": "。 完全正确。 正确的。"}, {"type": "subtitle", "time": 7040.87, "timestamp": "01:57:20", "text": "对，就是那个。   是的"}, {"type": "subtitle", "time": 7046.229, "timestamp": "01:57:26", "text": "。 能亲眼见到像我这样"}, {"type": "subtitle", "time": 7052.709, "timestamp": "01:57:32", "text": "歌唱能力很强的人，真的很高兴。"}, {"type": "subtitle", "time": 7055.189, "timestamp": "01:57:35", "text": "我去"}, {"type": "subtitle", "time": 7059.75, "timestamp": "01:57:39", "text": "参加翻唱歌曲课程的时候，也遇到过类似的情况，"}, {"type": "subtitle", "time": 7062.07, "timestamp": "01:57:42", "text": "学习如何"}, {"type": "subtitle", "time": 7063.99, "timestamp": "01:57:43", "text": "在录音棚里制作翻唱歌曲等等"}, {"type": "subtitle", "time": 7067.43, "timestamp": "01:57:47", "text": "。 有个人，"}, {"type": "subtitle", "time": 7071.99, "timestamp": "01:57:51", "text": "呃，呃，是个女孩，呃，唱歌特别好听"}, {"type": "subtitle", "time": 7074.31, "timestamp": "01:57:54", "text": "。"}, {"type": "subtitle", "time": 7077.75, "timestamp": "01:57:57", "text": "房间里的每个人都称赞她歌声"}]
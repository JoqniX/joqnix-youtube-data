[{"type": "subtitle", "time": 6247.35, "timestamp": "01:44:07", "text": "，我知道。   就是这样。"}, {"type": "subtitle", "time": 6249.35, "timestamp": "01:44:09", "text": "那么，哪个主意更好呢？"}, {"type": "subtitle", "time": 6252.39, "timestamp": "01:44:12", "text": "我应该就这么做吗？你想要佛罗里达州吗？ 等等，我"}, {"type": "subtitle", "time": 6255.109, "timestamp": "01:44:15", "text": "可以关掉闪光灯。 我可以把手机放在"}, {"type": "subtitle", "time": 6257.43, "timestamp": "01:44:17", "text": "某个地方，"}, {"type": "subtitle", "time": 6260.87, "timestamp": "01:44:20", "text": "这样你就看不到我了。 或者你"}, {"type": "subtitle", "time": 6264.229, "timestamp": "01:44:24", "text": "想跟我一起去？ 选择你的毒药。"}, {"type": "subtitle", "time": 6268.149, "timestamp": "01:44:28", "text": "米娜，不是毒药，但确实如此。 如果"}, {"type": "subtitle", "time": 6270.629, "timestamp": "01:44:30", "text": "没有闪光灯，就跟一片漆黑。 没人"}, {"type": "subtitle", "time": 6273.83, "timestamp": "01:44:33", "text": "能认出是我。 我可以把"}, {"type": "subtitle", "time": 6277.669, "timestamp": "01:44:37", "text": "我的三脚架放在这里。"}, {"type": "subtitle", "time": 6280.87, "timestamp": "01:44:40", "text": "就像我可以把它埋进土里一样。"}, {"type": "subtitle", "time": 6283.03, "timestamp": "01:44:43", "text": "我可以把它埋进土里。 也许你能看到"}, {"type": "subtitle", "time": 6288.149, "timestamp": "01:44:48", "text": "我实际操作的样子。"}, {"type": "subtitle", "time": 6290.47, "timestamp": "01:44:50", "text": "我们来做两件事。 好的。 等待。"}, {"type": "subtitle", "time": 6293.35, "timestamp": "01:44:53", "text": "如果使用闪光灯呢？"}, {"type": "subtitle", "time": 6296.79, "timestamp": "01:44:56", "text": "等待。 如果使用闪光灯呢？"}]
[{"type": "subtitle", "time": 1922.07, "timestamp": "00:32:02", "text": "好了，我们快到了。 那是"}, {"type": "subtitle", "time": 1929.669, "timestamp": "00:32:09", "text": "没有青木。 是的。 哦，它正好相反。"}, {"type": "subtitle", "time": 1937.43, "timestamp": "00:32:17", "text": "所以你把自行车停在那边，然后"}, {"type": "subtitle", "time": 1940.71, "timestamp": "00:32:20", "text": "进去。我这里有一种会员制的东西，"}, {"type": "subtitle", "time": 1943.75, "timestamp": "00:32:23", "text": "类似积分车之类的，你可以办一个。"}, {"type": "subtitle", "time": 1977.75, "timestamp": "00:32:57", "text": "好的，我还没有给你们展示节目的周期"}]
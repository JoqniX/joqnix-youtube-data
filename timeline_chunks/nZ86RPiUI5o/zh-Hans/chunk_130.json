[{"type": "subtitle", "time": 7800.229, "timestamp": "02:10:00", "text": "账号等级。 所以，我一直在看"}, {"type": "subtitle", "time": 7803.43, "timestamp": "02:10:03", "text": "阿桑戈的24小时频道。 我还没关机，刚才"}, {"type": "subtitle", "time": 7806.79, "timestamp": "02:10:06", "text": "电脑发出"}, {"type": "subtitle", "time": 7810.31, "timestamp": "02:10:10", "text": "很大的噪音。 是的。"}, {"type": "subtitle", "time": 7814.39, "timestamp": "02:10:14", "text": "哦，等等。 让我来做这件事。 不用"}, {"type": "subtitle", "time": 7816.149, "timestamp": "02:10:16", "text": "担心。 我把它静音了。 不用担心。 对不起。"}, {"type": "subtitle", "time": 7819.03, "timestamp": "02:10:19", "text": "对不起。   是的"}, {"type": "subtitle", "time": 7822.629, "timestamp": "02:10:22", "text": "。 现在让我控制我的电脑。"}, {"type": "subtitle", "time": 7825.189, "timestamp": "02:10:25", "text": "所以，我已经好几天没关过电脑了"}, {"type": "subtitle", "time": 7827.83, "timestamp": "02:10:27", "text": "。 我觉得我昨天"}, {"type": "subtitle", "time": 7838.47, "timestamp": "02:10:38", "text": "哦，我只是……"}, {"type": "subtitle", "time": 7840.39, "timestamp": "02:10:40", "text": "我只是看了个游戏，一个游戏实况之类的，"}, {"type": "subtitle", "time": 7843.91, "timestamp": "02:10:43", "text": "那里没有24小时"}, {"type": "subtitle", "time": 7845.589, "timestamp": "02:10:45", "text": "频道，我知道我可以看我自己的"}, {"type": "subtitle", "time": 7854.709, "timestamp": "02:10:54", "text": "不，我还是……嗯，"}, {"type": "subtitle", "time": 7859.35, "timestamp": "02:10:59", "text": "我还是可以看我自己的频道，"}]
[{"type": "subtitle", "time": 1386.87, "timestamp": "00:23:06", "text": "你好，妈。 好久不见了。"}, {"type": "subtitle", "time": 1389.909, "timestamp": "00:23:09", "text": "生活怎么样？ 一切都好吗？"}, {"type": "subtitle", "time": 1398.07, "timestamp": "00:23:18", "text": "我在网站上看到了你的留言。"}, {"type": "subtitle", "time": 1400.87, "timestamp": "00:23:20", "text": "顺便说一下，我最近修改了一些"}, {"type": "subtitle", "time": 1403.83, "timestamp": "00:23:23", "text": "东西，更新了我的网站。 我看到了那个"}, {"type": "subtitle", "time": 1408.47, "timestamp": "00:23:28", "text": "匿名消息。"}, {"type": "subtitle", "time": 1411.669, "timestamp": "00:23:31", "text": "谢谢你发来这条信息。"}]
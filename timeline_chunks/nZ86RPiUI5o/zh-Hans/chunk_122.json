[{"type": "subtitle", "time": 7334.229, "timestamp": "02:02:14", "text": "你在哪儿？ 你还在吗？还是"}, {"type": "subtitle", "time": 7337.109, "timestamp": "02:02:17", "text": "睡着了？"}, {"type": "subtitle", "time": 7343.51, "timestamp": "02:02:23", "text": "没有自动对焦模式。"}, {"type": "subtitle", "time": 7356.149, "timestamp": "02:02:36", "text": "天，居然没有对焦模式或自动"}, {"type": "subtitle", "time": 7359.109, "timestamp": "02:02:39", "text": "对焦模式。 糟了，我不得不告诉"}, {"type": "subtitle", "time": 7362.47, "timestamp": "02:02:42", "text": "他。 我的天，居然"}, {"type": "subtitle", "time": 7365.83, "timestamp": "02:02:45", "text": "没有自动模式。 哦，不。"}, {"type": "subtitle", "time": 7368.47, "timestamp": "02:02:48", "text": "好的，曝光机会是有的。 天哪，"}, {"type": "subtitle", "time": 7372.87, "timestamp": "02:02:52", "text": "我为什么要点开？ 不。啊，是手动挡。 等等，我"}, {"type": "subtitle", "time": 7375.189, "timestamp": "02:02:55", "text": "打了个寒颤。 妈的。 哦不，不，不，不，不，"}, {"type": "subtitle", "time": 7376.79, "timestamp": "02:02:56", "text": "不。"}, {"type": "subtitle", "time": 7378.709, "timestamp": "02:02:58", "text": "我为什么会这样做？ 不，不，不。 我不知道"}]
[{"type": "subtitle", "time": 842.55, "timestamp": "00:14:02", "text": "所以这家伙"}, {"type": "subtitle", "time": 845.59, "timestamp": "00:14:05", "text": "我该怎么做？哦，糟糕。 呃，我不想"}, {"type": "subtitle", "time": 848.23, "timestamp": "00:14:08", "text": "露脸。"}, {"type": "subtitle", "time": 875.829, "timestamp": "00:14:35", "text": "啊。"}, {"type": "subtitle", "time": 878.47, "timestamp": "00:14:38", "text": "等待。 我先把麦克风拔掉"}, {"type": "subtitle", "time": 887.525, "timestamp": "00:14:47", "text": "你把一切都揭露了出来。 不，我……我（"}, {"type": "subtitle", "time": 889.509, "timestamp": "00:14:49", "text": "笑）"}, {"type": "subtitle", "time": 897.67, "timestamp": "00:14:57", "text": "当心。 是的。 是的。 是的，我必须这么做。"}]
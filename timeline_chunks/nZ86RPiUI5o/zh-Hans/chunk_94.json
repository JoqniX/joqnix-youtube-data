[{"type": "subtitle", "time": 5647.27, "timestamp": "01:34:07", "text": "呃，禁止打板球……呃，"}, {"type": "subtitle", "time": 5650.39, "timestamp": "01:34:10", "text": "好像板球是职业禁忌之类的"}, {"type": "subtitle", "time": 5652.229, "timestamp": "01:34:12", "text": "。"}, {"type": "subtitle", "time": 5654.629, "timestamp": "01:34:14", "text": "那就像仓库里的东西。 沃克"}, {"type": "subtitle", "time": 5656.149, "timestamp": "01:34:16", "text": "房间。"}, {"type": "subtitle", "time": 5661.43, "timestamp": "01:34:21", "text": "请把垃圾带回家。"}, {"type": "subtitle", "time": 5665.03, "timestamp": "01:34:25", "text": "弄了个棒球之类的东西。 你可以在"}, {"type": "subtitle", "time": 5669.51, "timestamp": "01:34:29", "text": "这里打棒球之类的运动。 所以，"}, {"type": "subtitle", "time": 5671.59, "timestamp": "01:34:31", "text": "我的影子就在那里。  [笑声]"}, {"type": "subtitle", "time": 5674.39, "timestamp": "01:34:34", "text": "你可以听出来。 我勒个去？ 兄弟，我讨厌"}, {"type": "subtitle", "time": 5676.79, "timestamp": "01:34:36", "text": "我的影子。"}, {"type": "subtitle", "time": 5679.51, "timestamp": "01:34:39", "text": "每次"}, {"type": "subtitle", "time": 5681.83, "timestamp": "01:34:41", "text": "我做……"}, {"type": "subtitle", "time": 5684.31, "timestamp": "01:34:44", "text": "呃……的时候，影子都会泄露我的个人信息。别把你的用户信息留在公园里。"}, {"type": "subtitle", "time": 5699.51, "timestamp": "01:34:59", "text": "问得好，妈，嗯，"}]
[{"type": "subtitle", "time": 5585.99, "timestamp": "01:33:05", "text": "这是一个花园。 是的，它干透了。"}, {"type": "subtitle", "time": 5593.35, "timestamp": "01:33:13", "text": "疯狂了。"}, {"type": "subtitle", "time": 5596.95, "timestamp": "01:33:16", "text": "这就像足球场可以被称为"}, {"type": "subtitle", "time": 5599.35, "timestamp": "01:33:19", "text": "足球场一样。 啊，这不是足球场。"}, {"type": "subtitle", "time": 5603.579, "timestamp": "01:33:23", "text": "这是专业人士禁止的。"}, {"type": "subtitle", "time": 5615.27, "timestamp": "01:33:35", "text": "我的意思是，你可以在这里打棒球，"}, {"type": "subtitle", "time": 5617.75, "timestamp": "01:33:37", "text": "而不是踢足球。"}, {"type": "subtitle", "time": 5619.59, "timestamp": "01:33:39", "text": "你可以在这里打棒球。 足球"}, {"type": "subtitle", "time": 5628.55, "timestamp": "01:33:48", "text": "是啊，[笑声和嗤笑声] 如果不"}, {"type": "subtitle", "time": 5631.83, "timestamp": "01:33:51", "text": "说足球，那就说这里没有板球。"}, {"type": "subtitle", "time": 5634.47, "timestamp": "01:33:54", "text": "东京有板球比赛。 如果你去"}, {"type": "subtitle", "time": 5637.27, "timestamp": "01:33:57", "text": "江户川，比如米希卡赛，那里有"}, {"type": "subtitle", "time": 5639.51, "timestamp": "01:33:59", "text": "板球场和一些公园。 不，他们那里真的立了个牌子，上面写着……"}]
[{"type": "subtitle", "time": 4981.35, "timestamp": "01:23:01", "text": "呃，等等。"}, {"type": "subtitle", "time": 4985.189, "timestamp": "01:23:05", "text": "TT 喝水运动饮料，因为"}, {"type": "subtitle", "time": 4989.43, "timestamp": "01:23:09", "text": "Monster Cider 实际上是苏打水。 那就像"}, {"type": "subtitle", "time": 4993.75, "timestamp": "01:23:13", "text": "触须水一样。 钙化水。   是的"}, {"type": "subtitle", "time": 4996.55, "timestamp": "01:23:16", "text": "。"}, {"type": "subtitle", "time": 4998.95, "timestamp": "01:23:18", "text": "所以，我们去公园吧。 好的。"}, {"type": "subtitle", "time": 5000.47, "timestamp": "01:23:20", "text": "我已经很久没去过那个公园了"}, {"type": "subtitle", "time": 5001.91, "timestamp": "01:23:21", "text": "。"}, {"type": "subtitle", "time": 5005.03, "timestamp": "01:23:25", "text": "哦，我刚才看到那边有只猫。 哦，"}, {"type": "subtitle", "time": 5008.31, "timestamp": "01:23:28", "text": "瞧。 那里有只小狗。"}, {"type": "subtitle", "time": 5012.79, "timestamp": "01:23:32", "text": "呃，就是那只带RGB灯的狗狗。"}, {"type": "subtitle", "time": 5015.91, "timestamp": "01:23:35", "text": "你看不清楚。"}, {"type": "subtitle", "time": 5020.79, "timestamp": "01:23:40", "text": "我最好不要缩小画面。"}, {"type": "subtitle", "time": 5033.83, "timestamp": "01:23:53", "text": "。 去公园玩。"}, {"type": "subtitle", "time": 5036.229, "timestamp": "01:23:56", "text": "但现在天已经黑了。   是的"}]
[{"type": "subtitle", "time": 1502.07, "timestamp": "00:25:02", "text": "。"}, {"type": "subtitle", "time": 1519.909, "timestamp": "00:25:19", "text": "开头了吗？ 这是我新买的自行车，"}, {"type": "subtitle", "time": 1522.789, "timestamp": "00:25:22", "text": "因为我花7000日元买的校车"}, {"type": "subtitle", "time": 1526.63, "timestamp": "00:25:26", "text": "被偷了，因为我忘了"}, {"type": "subtitle", "time": 1528.47, "timestamp": "00:25:28", "text": "锁。"}, {"type": "subtitle", "time": 1548.39, "timestamp": "00:25:48", "text": "现在的问题是，你应该"}, {"type": "subtitle", "time": 1551.59, "timestamp": "00:25:51", "text": "从那个东西那边过去。 我喜欢走"}, {"type": "subtitle", "time": 1554.549, "timestamp": "00:25:54", "text": "这条路，当左边没有车的时候"}, {"type": "subtitle", "time": 1558.549, "timestamp": "00:25:58", "text": "，我就"}]
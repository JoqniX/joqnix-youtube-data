[{"type": "subtitle", "time": 3901.91, "timestamp": "01:05:01", "text": "这种设置下，让它正常工作真是太难了，令人恼火。  [嗤笑]"}, {"type": "subtitle", "time": 3922.069, "timestamp": "01:05:22", "text": "呃，我可以这样做吗？ 那正好"}, {"type": "subtitle", "time": 3925.67, "timestamp": "01:05:25", "text": "相反，对吧？ 好的。"}, {"type": "subtitle", "time": 3927.51, "timestamp": "01:05:27", "text": "呃，"}, {"type": "subtitle", "time": 3931.51, "timestamp": "01:05:31", "text": "我可以这样做，"}, {"type": "subtitle", "time": 3935.349, "timestamp": "01:05:35", "text": "但对你们来说正好相反。"}, {"type": "subtitle", "time": 3937.43, "timestamp": "01:05:37", "text": "嗯，"}, {"type": "subtitle", "time": 3939.99, "timestamp": "01:05:39", "text": "这反过来了。  [笑声]"}, {"type": "subtitle", "time": 3941.99, "timestamp": "01:05:41", "text": "呃，"}, {"type": "subtitle", "time": 3953.349, "timestamp": "01:05:53", "text": "好的。"}, {"type": "subtitle", "time": 3955.589, "timestamp": "01:05:55", "text": "所以，我之所以"}, {"type": "subtitle", "time": 3958.549, "timestamp": "01:05:58", "text": "这么做，是因为我想把"}]
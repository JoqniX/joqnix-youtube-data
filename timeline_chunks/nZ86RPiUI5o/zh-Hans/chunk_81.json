[{"type": "subtitle", "time": 4863.51, "timestamp": "01:21:03", "text": "闪光。 好的。 然后我去这里。"}, {"type": "subtitle", "time": 4867.43, "timestamp": "01:21:07", "text": "凉爽的。 重置。"}, {"type": "subtitle", "time": 4870.55, "timestamp": "01:21:10", "text": "而且，这应该会开启"}, {"type": "subtitle", "time": 4876.07, "timestamp": "01:21:16", "text": "闪光灯"}, {"type": "subtitle", "time": 4899.83, "timestamp": "01:21:39", "text": "是的，当时好像有人在走动。"}, {"type": "subtitle", "time": 4902.149, "timestamp": "01:21:42", "text": "我立即摘下相机。 我"}, {"type": "subtitle", "time": 4904.229, "timestamp": "01:21:44", "text": "不想让他们"}, {"type": "subtitle", "time": 4906.31, "timestamp": "01:21:46", "text": "觉得我……"}, {"type": "subtitle", "time": 4909.99, "timestamp": "01:21:49", "text": "觉得我像……呃……"}]
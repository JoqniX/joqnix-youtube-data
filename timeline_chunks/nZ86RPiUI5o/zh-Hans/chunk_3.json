[{"type": "subtitle", "time": 180.55, "timestamp": "00:03:00", "text": "知道吗？ 我要按下"}, {"type": "subtitle", "time": 182.71, "timestamp": "00:03:02", "text": "按钮。"}, {"type": "subtitle", "time": 184.309, "timestamp": "00:03:04", "text": "是的，"}, {"type": "subtitle", "time": 186.63, "timestamp": "00:03:06", "text": "我要按下按钮了，因为我"}, {"type": "subtitle", "time": 201.27, "timestamp": "00:03:21", "text": "谢谢。   是的"}, {"type": "subtitle", "time": 205.43, "timestamp": "00:03:25", "text": "。 嗯，是的，（笑声）希望你们"}, {"type": "subtitle", "time": 207.75, "timestamp": "00:03:27", "text": "都能听清楚。 好的，请"}, {"type": "subtitle", "time": 210.247, "timestamp": "00:03:30", "text": "在聊天中告诉我你是否能清晰地听到我的声音"}, {"type": "subtitle", "time": 210.869, "timestamp": "00:03:30", "text": "[音乐]，"}, {"type": "subtitle", "time": 213.11, "timestamp": "00:03:33", "text": "没有延迟之类的。 如果"}, {"type": "subtitle", "time": 216.949, "timestamp": "00:03:36", "text": "直播中断或发生任何意外情况，请务必"}, {"type": "subtitle", "time": 221.27, "timestamp": "00:03:41", "text": "告诉我，好吗？ 这样我就能知道"}, {"type": "subtitle", "time": 224.47, "timestamp": "00:03:44", "text": "是我的直播快结束了，还是你的直播"}, {"type": "subtitle", "time": 227.589, "timestamp": "00:03:47", "text": "结束了，或者其他什么情况。 好吧，那就别这样了"}, {"type": "subtitle", "time": 230.552, "timestamp": "00:03:50", "text": "。"}, {"type": "subtitle", "time": 231.35, "timestamp": "00:03:51", "text": "[音乐]"}, {"type": "subtitle", "time": 232.869, "timestamp": "00:03:52", "text": "呃，"}, {"type": "subtitle", "time": 236.149, "timestamp": "00:03:56", "text": "我希望我还活着。"}, {"type": "subtitle", "time": 238.949, "timestamp": "00:03:58", "text": "呃，所以这不会是一个只有音频的"}]
[{"type": "subtitle", "time": 5702.79, "timestamp": "01:35:02", "text": "即使你问了这个问题，对吧？为什么"}, {"type": "subtitle", "time": 5706.39, "timestamp": "01:35:06", "text": "不用反应式建模呢？我可以用"}, {"type": "subtitle", "time": 5709.59, "timestamp": "01:35:09", "text": "反应式建模，但问题是我没有"}, {"type": "subtitle", "time": 5711.59, "timestamp": "01:35:11", "text": "嘴巴张合的动作，我必须用实时"}, {"type": "subtitle", "time": 5715.59, "timestamp": "01:35:15", "text": "2D建模来做，"}, {"type": "subtitle", "time": 5718.55, "timestamp": "01:35:18", "text": "这样我才能制作一张"}, {"type": "subtitle", "time": 5723.11, "timestamp": "01:35:23", "text": "嘴巴张合的静态图像，我想是这样。"}, {"type": "subtitle", "time": 5726.95, "timestamp": "01:35:26", "text": "我觉得我有一个类似PNG格式的"}, {"type": "subtitle", "time": 5729.43, "timestamp": "01:35:29", "text": "张嘴表情，但它只是张开"}, {"type": "subtitle", "time": 5732.709, "timestamp": "01:35:32", "text": "嘴而已。 没有微笑表情。"}, {"type": "subtitle", "time": 5735.83, "timestamp": "01:35:35", "text": "你知道，我有个中立的东西。"}, {"type": "subtitle", "time": 5740.47, "timestamp": "01:35:40", "text": "嗯，这就像"}, {"type": "subtitle", "time": 5743.35, "timestamp": "01:35:43", "text": "你可以踢足球，不，是橄榄球，"}, {"type": "subtitle", "time": 5745.11, "timestamp": "01:35:45", "text": "美式橄榄球，"}, {"type": "subtitle", "time": 5749.75, "timestamp": "01:35:49", "text": "或者你可以玩接球游戏，或者"}, {"type": "subtitle", "time": 5752.629, "timestamp": "01:35:52", "text": "棒球。 这里也是棒球"}, {"type": "subtitle", "time": 5754.87, "timestamp": "01:35:54", "text": "场。"}]
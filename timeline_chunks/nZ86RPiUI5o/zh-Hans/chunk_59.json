[{"type": "subtitle", "time": 3541.99, "timestamp": "00:59:01", "text": "（清了清嗓子）我的电量"}, {"type": "subtitle", "time": 3543.829, "timestamp": "00:59:03", "text": "在直播期间不会保留。"}, {"type": "subtitle", "time": 3546.309, "timestamp": "00:59:06", "text": "所以，这是痛苦。 我需要买一个超快"}, {"type": "subtitle", "time": 3548.309, "timestamp": "00:59:08", "text": "充电器。"}, {"type": "subtitle", "time": 3554.87, "timestamp": "00:59:14", "text": "我说到此为止。"}]
[{"type": "subtitle", "time": 7140.882, "timestamp": "01:59:00", "text": "于是安东尼崩溃了。"}, {"type": "subtitle", "time": 7141.43, "timestamp": "01:59:01", "text": "[清了清嗓子，哼了一声]"}, {"type": "subtitle", "time": 7144.629, "timestamp": "01:59:04", "text": "还想再去那里吗？   是的"}, {"type": "subtitle", "time": 7146.39, "timestamp": "01:59:06", "text": "。"}, {"type": "subtitle", "time": 7149.35, "timestamp": "01:59:09", "text": "哦，等等。 我得私信我的室友。 一"}, {"type": "subtitle", "time": 7151.35, "timestamp": "01:59:11", "text": "秒钟。"}, {"type": "subtitle", "time": 7164.149, "timestamp": "01:59:24", "text": "让我问问他，让他"}, {"type": "subtitle", "time": 7174.79, "timestamp": "01:59:34", "text": "知道，"}, {"type": "subtitle", "time": 7177.35, "timestamp": "01:59:37", "text": "如果"}, {"type": "subtitle", "time": 7181.75, "timestamp": "01:59:41", "text": "晚餐还没准备好，我们会知道什么时候"}, {"type": "subtitle", "time": 7186.87, "timestamp": "01:59:46", "text": "饭菜准备好了。"}]
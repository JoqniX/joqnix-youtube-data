[{"type": "subtitle", "time": 6366.47, "timestamp": "01:46:06", "text": "没有。 我觉得我安全了。"}, {"type": "subtitle", "time": 6372.87, "timestamp": "01:46:12", "text": "好的。 让我把三脚架放进口袋里。"}, {"type": "subtitle", "time": 6383.03, "timestamp": "01:46:23", "text": "你好。 现在就给我看看。"}, {"type": "subtitle", "time": 6385.83, "timestamp": "01:46:25", "text": "好的，我们开始吧。"}, {"type": "subtitle", "time": 6402.47, "timestamp": "01:46:42", "text": "我不想让自己难堪。"}, {"type": "subtitle", "time": 6404.55, "timestamp": "01:46:44", "text": "没有人带着"}, {"type": "subtitle", "time": 6408.31, "timestamp": "01:46:48", "text": "娃娃之类的东西走来走去，对吧？ 为什么我是嗨？"}, {"type": "subtitle", "time": 6411.51, "timestamp": "01:46:51", "text": "三、二、一。"}, {"type": "subtitle", "time": 6416.709, "timestamp": "01:46:56", "text": "我的天啊。 我的天啊。 我的天啊。   妈的"}, {"type": "subtitle", "time": 6419.063, "timestamp": "01:46:59", "text": "。"}]
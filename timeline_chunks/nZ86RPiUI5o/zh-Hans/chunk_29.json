[{"type": "subtitle", "time": 1746.95, "timestamp": "00:29:06", "text": "所以我们要去一家"}, {"type": "subtitle", "time": 1750.87, "timestamp": "00:29:10", "text": "叫青木野入的超市。"}, {"type": "subtitle", "time": 1753.19, "timestamp": "00:29:13", "text": "顾名思义，这是一家"}, {"type": "subtitle", "time": 1755.75, "timestamp": "00:29:15", "text": "药店，但实际上"}, {"type": "subtitle", "time": 1757.669, "timestamp": "00:29:17", "text": "这里什么都有。 它"}, {"type": "subtitle", "time": 1761.029, "timestamp": "00:29:21", "text": "简直就是一家超市。"}, {"type": "subtitle", "time": 1770.149, "timestamp": "00:29:30", "text": "，"}, {"type": "subtitle", "time": 1773.909, "timestamp": "00:29:33", "text": "日落时间是5:30，因为现在是冬天。 不，"}, {"type": "subtitle", "time": 1776.389, "timestamp": "00:29:36", "text": "冬天就要来了。 不，现在是"}, {"type": "subtitle", "time": 1779.669, "timestamp": "00:29:39", "text": "秋季，所以"}, {"type": "subtitle", "time": 1785.029, "timestamp": "00:29:45", "text": "日落会比较早，"}, {"type": "subtitle", "time": 1789.11, "timestamp": "00:29:49", "text": "日出也会比较早，我想。   是的"}, {"type": "subtitle", "time": 1791.83, "timestamp": "00:29:51", "text": "。 是的。 是的。 日出"}, {"type": "subtitle", "time": 1794.23, "timestamp": "00:29:54", "text": "有时很早，比如早上 6 点。"}, {"type": "subtitle", "time": 1796.789, "timestamp": "00:29:56", "text": "看起来像是早上 10 点或 10 点左右。"}]
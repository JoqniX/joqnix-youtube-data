[{"type": "subtitle", "time": 4741.27, "timestamp": "01:19:01", "text": "放在滑轨"}, {"type": "subtitle", "time": 4744.07, "timestamp": "01:19:04", "text": "和门上。"}, {"type": "subtitle", "time": 4746.829, "timestamp": "01:19:06", "text": "啊，这很重要。"}, {"type": "subtitle", "time": 4749.03, "timestamp": "01:19:09", "text": "[嗤笑] 欢迎回来。 我们只是出去散"}, {"type": "subtitle", "time": 4751.11, "timestamp": "01:19:11", "text": "散步。   是的"}, {"type": "subtitle", "time": 4752.709, "timestamp": "01:19:12", "text": "。"}, {"type": "subtitle", "time": 4756.31, "timestamp": "01:19:16", "text": "所以，现在基本上是晚上7点13分。"}, {"type": "subtitle", "time": 4760.47, "timestamp": "01:19:20", "text": "那些是按钮。"}, {"type": "subtitle", "time": 4766.709, "timestamp": "01:19:26", "text": "所以我可以把它放在呃，比如免费性爱，"}, {"type": "subtitle", "time": 4785.03, "timestamp": "01:19:45", "text": "在房子里，要展示它很热闹，"}, {"type": "subtitle", "time": 4787.91, "timestamp": "01:19:47", "text": "就像一个全景房子，但"}, {"type": "subtitle", "time": 4790.149, "timestamp": "01:19:50", "text": "它完全封闭了，被……被……被……被……"}, {"type": "subtitle", "time": 4792.95, "timestamp": "01:19:52", "text": "隐藏起来了，你"}, {"type": "subtitle", "time": 4794.63, "timestamp": "01:19:54", "text": "管它叫什么？"}, {"type": "subtitle", "time": 4796.55, "timestamp": "01:19:56", "text": "赫顿斯。   对"}, {"type": "subtitle", "time": 4799.03, "timestamp": "01:19:59", "text": "，"}]
[{"type": "subtitle", "time": 6124.87, "timestamp": "01:42:04", "text": "有只苍蝇"}, {"type": "subtitle", "time": 6130.95, "timestamp": "01:42:10", "text": "[笑声]"}, {"type": "subtitle", "time": 6133.109, "timestamp": "01:42:13", "text": "好吧，我会把它放回原处"}, {"type": "subtitle", "time": 6137.27, "timestamp": "01:42:17", "text": "。 枪，小心点。"}, {"type": "subtitle", "time": 6141.189, "timestamp": "01:42:21", "text": "是的，我爬到这个上面，然后"}, {"type": "subtitle", "time": 6149.27, "timestamp": "01:42:29", "text": "这就像是小孩子的玩具。   是的，"}, {"type": "subtitle", "time": 6153.99, "timestamp": "01:42:33", "text": "这边有一棵更大的树。"}, {"type": "subtitle", "time": 6156.07, "timestamp": "01:42:36", "text": "真不错。 而这是我上次做的事"}, {"type": "subtitle", "time": 6158.149, "timestamp": "01:42:38", "text": "。"}, {"type": "subtitle", "time": 6161.109, "timestamp": "01:42:41", "text": "你觉得我应该再做一次吗？"}, {"type": "subtitle", "time": 6177.59, "timestamp": "01:42:57", "text": "你想让我做吗？ 好的。"}]
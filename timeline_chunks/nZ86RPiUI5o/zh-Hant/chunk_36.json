[{"type": "subtitle", "time": 2164.23, "timestamp": "00:36:04", "text": "多少？你需要自己進行變速器"}, {"type": "subtitle", "time": 2166.23, "timestamp": "00:36:06", "text": "轉換。"}, {"type": "subtitle", "time": 2168.79, "timestamp": "00:36:08", "text": "不過我的數學很差。這雞肉，"}, {"type": "subtitle", "time": 2172.55, "timestamp": "00:36:12", "text": "雞胸肉，呃，很多東西。是個"}, {"type": "subtitle", "time": 2177.589, "timestamp": "00:36:17", "text": "男孩。是的。捲心菜之類的東西。"}, {"type": "subtitle", "time": 2180.15, "timestamp": "00:36:20", "text": "從這裡取雞蛋。  是的"}, {"type": "subtitle", "time": 2181.67, "timestamp": "00:36:21", "text": "，我會付錢的"}, {"type": "subtitle", "time": 2199.43, "timestamp": "00:36:39", "text": "189，（清喉嚨）對吧？多少錢"}, {"type": "subtitle", "time": 2202.15, "timestamp": "00:36:42", "text": "？大概四點幾吧？我覺得我"}]
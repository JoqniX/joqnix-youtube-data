[{"type": "subtitle", "time": 2101.349, "timestamp": "00:35:01", "text": "就像僱員。 [清喉嚨]"}, {"type": "subtitle", "time": 2111.67, "timestamp": "00:35:11", "text": "啊，這裡"}, {"type": "subtitle", "time": 2114.55, "timestamp": "00:35:14", "text": "沒有。"}, {"type": "subtitle", "time": 2116.23, "timestamp": "00:35:16", "text": "哦，"}, {"type": "subtitle", "time": 2119.51, "timestamp": "00:35:19", "text": "等等。開始了。"}, {"type": "subtitle", "time": 2121.589, "timestamp": "00:35:21", "text": "呃，"}, {"type": "subtitle", "time": 2130.63, "timestamp": "00:35:30", "text": "哦，明白了。知道了"}, {"type": "subtitle", "time": 2135.109, "timestamp": "00:35:35", "text": "。知道了。知道了。知道了。知道了。售價"}, {"type": "subtitle", "time": 2139.829, "timestamp": "00:35:39", "text": "148日圓。高度。我們只需要一個。"}, {"type": "subtitle", "time": 2142.31, "timestamp": "00:35:42", "text": "高度。"}, {"type": "subtitle", "time": 2145.589, "timestamp": "00:35:45", "text": "所以，我可以給你們看一些肉之類的"}, {"type": "subtitle", "time": 2147.19, "timestamp": "00:35:47", "text": "東西。"}, {"type": "subtitle", "time": 2151.03, "timestamp": "00:35:51", "text": "這裡到處都是火腿之類的東西。"}, {"type": "subtitle", "time": 2158.23, "timestamp": "00:35:58", "text": "火腿，培根，還有"}]
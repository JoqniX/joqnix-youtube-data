[{"type": "subtitle", "time": 1922.07, "timestamp": "00:32:02", "text": "好了，我們快到了。那是"}, {"type": "subtitle", "time": 1929.669, "timestamp": "00:32:09", "text": "沒有青木。是的。哦，它正好相反。"}, {"type": "subtitle", "time": 1937.43, "timestamp": "00:32:17", "text": "所以你把自行車停在那邊，然後"}, {"type": "subtitle", "time": 1940.71, "timestamp": "00:32:20", "text": "進去。我這裡有一種會員制的東西，"}, {"type": "subtitle", "time": 1943.75, "timestamp": "00:32:23", "text": "類似積分車之類的，你可以辦一個。  真好"}, {"type": "subtitle", "time": 1977.75, "timestamp": "00:32:57", "text": "好的，我還沒有給你們展示節目的周期"}]
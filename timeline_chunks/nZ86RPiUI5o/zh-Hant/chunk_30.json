[{"type": "subtitle", "time": 1801.269, "timestamp": "00:30:01", "text": "早晨的炎熱天氣會讓一切"}, {"type": "subtitle", "time": 1819.35, "timestamp": "00:30:19", "text": "反光，對吧？我必須小心。"}, {"type": "subtitle", "time": 1822.87, "timestamp": "00:30:22", "text": "我單手開車，呃，我是說騎"}, {"type": "subtitle", "time": 1824.47, "timestamp": "00:30:24", "text": "自行車。"}, {"type": "subtitle", "time": 1827.43, "timestamp": "00:30:27", "text": "啊，那是一輛車。哦，不。好吧，他們"}, {"type": "subtitle", "time": 1830.23, "timestamp": "00:30:30", "text": "放他過去了。好的。"}, {"type": "subtitle", "time": 1831.669, "timestamp": "00:30:31", "text": "對了，你知道"}, {"type": "subtitle", "time": 1835.269, "timestamp": "00:30:35", "text": "日本的自行車也有車牌嗎？"}, {"type": "subtitle", "time": 1836.95, "timestamp": "00:30:36", "text": "我應該嗎？"}, {"type": "subtitle", "time": 1840.549, "timestamp": "00:30:40", "text": "好的，我可以承受接下來的一切。哦，等等。"}, {"type": "subtitle", "time": 1854.149, "timestamp": "00:30:54", "text": "啊，原來我不該那麼做"}, {"type": "subtitle", "time": 1856.389, "timestamp": "00:30:56", "text": "。我本該讓那位"}, {"type": "subtitle", "time": 1859.59, "timestamp": "00:30:59", "text": "行人先行通過。"}]
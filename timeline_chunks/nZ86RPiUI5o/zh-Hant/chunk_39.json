[{"type": "subtitle", "time": 2343.589, "timestamp": "00:39:03", "text": "好。呃，我們不會做這件事。"}, {"type": "subtitle", "time": 2348.47, "timestamp": "00:39:08", "text": "我會把它拿在手裡。好的。  擠壓。"}, {"type": "subtitle", "time": 2372.95, "timestamp": "00:39:32", "text": "就是這樣。"}, {"type": "subtitle", "time": 2375.109, "timestamp": "00:39:35", "text": "就是這種類型。所以，我不得不這麼做"}, {"type": "subtitle", "time": 2377.67, "timestamp": "00:39:37", "text": "。"}, {"type": "subtitle", "time": 2396.55, "timestamp": "00:39:56", "text": "用左手握住它，"}, {"type": "subtitle", "time": 2399.43, "timestamp": "00:39:59", "text": "前面朝前，這樣我就可以方便地按住"}]
[{"type": "subtitle", "time": 180.55, "timestamp": "00:03:00", "text": "知道嗎？我要按下"}, {"type": "subtitle", "time": 182.71, "timestamp": "00:03:02", "text": "按鈕。"}, {"type": "subtitle", "time": 184.309, "timestamp": "00:03:04", "text": "是的，"}, {"type": "subtitle", "time": 186.63, "timestamp": "00:03:06", "text": "我要按下按鈕了，因為我"}, {"type": "subtitle", "time": 201.27, "timestamp": "00:03:21", "text": "謝謝。  是"}, {"type": "subtitle", "time": 205.43, "timestamp": "00:03:25", "text": "的。嗯，是的，（笑聲）希望你們"}, {"type": "subtitle", "time": 207.75, "timestamp": "00:03:27", "text": "都能聽清楚。好的，請"}, {"type": "subtitle", "time": 210.247, "timestamp": "00:03:30", "text": "在聊天中告訴我你是否能清晰地聽到我的聲音"}, {"type": "subtitle", "time": 210.869, "timestamp": "00:03:30", "text": "[音樂]，"}, {"type": "subtitle", "time": 213.11, "timestamp": "00:03:33", "text": "沒有延遲之類的。如果"}, {"type": "subtitle", "time": 216.949, "timestamp": "00:03:36", "text": "直播中斷或發生任何意外情況，請務必"}, {"type": "subtitle", "time": 221.27, "timestamp": "00:03:41", "text": "告訴我，好嗎？這樣我就能知道"}, {"type": "subtitle", "time": 224.47, "timestamp": "00:03:44", "text": "是我的直播快結束了，還是你的直播"}, {"type": "subtitle", "time": 227.589, "timestamp": "00:03:47", "text": "結束了，或是其他情況。好吧，那就別這樣"}, {"type": "subtitle", "time": 230.552, "timestamp": "00:03:50", "text": "。"}, {"type": "subtitle", "time": 231.35, "timestamp": "00:03:51", "text": "[音樂]"}, {"type": "subtitle", "time": 232.869, "timestamp": "00:03:52", "text": "呃，"}, {"type": "subtitle", "time": 236.149, "timestamp": "00:03:56", "text": "我希望我還活著。"}, {"type": "subtitle", "time": 238.949, "timestamp": "00:03:58", "text": "呃，所以這不會是只有音訊的"}]
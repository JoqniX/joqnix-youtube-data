[{"type": "subtitle", "time": 1980.31, "timestamp": "00:33:00", "text": "。就是這樣。這是"}, {"type": "subtitle", "time": 1983.75, "timestamp": "00:33:03", "text": "輪胎的情況。這裡很大，也很安靜。"}, {"type": "subtitle", "time": 1987.11, "timestamp": "00:33:07", "text": "所以，是的，我的硬幣被鎖起來了，很"}, {"type": "subtitle", "time": 1990.95, "timestamp": "00:33:10", "text": "安全，我可以去買東西了。除此之外，"}, {"type": "subtitle", "time": 1995.99, "timestamp": "00:33:15", "text": "我還得注意一些"}, {"type": "subtitle", "time": 1998.71, "timestamp": "00:33:18", "text": "反光區域。"}, {"type": "subtitle", "time": 2012.71, "timestamp": "00:33:32", "text": "這裡商品真多啊[笑聲]。這些就像梳子之類的東西。"}, {"type": "subtitle", "time": 2015.909, "timestamp": "00:33:35", "text": "我認為這些是肥皂製品。"}, {"type": "subtitle", "time": 2018.63, "timestamp": "00:33:38", "text": "肥皂之類的東西。是的，這種生物皂"}, {"type": "subtitle", "time": 2022.23, "timestamp": "00:33:42", "text": "也是。這些就像是洗手液之類的東西"}, {"type": "subtitle", "time": 2023.83, "timestamp": "00:33:43", "text": "。"}, {"type": "subtitle", "time": 2026.95, "timestamp": "00:33:46", "text": "所以，我們要去找這個"}, {"type": "subtitle", "time": 2030.549, "timestamp": "00:33:50", "text": "人。我們要去找這個人。"}, {"type": "subtitle", "time": 2032.789, "timestamp": "00:33:52", "text": "炸雞。"}, {"type": "subtitle", "time": 2036.549, "timestamp": "00:33:56", "text": "所以，我們正在尋找這個人。媽的。  媽的"}, {"type": "subtitle", "time": 2039.909, "timestamp": "00:33:59", "text": "。等待。我……呃……"}]
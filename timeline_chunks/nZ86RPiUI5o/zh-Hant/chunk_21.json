[{"type": "subtitle", "time": 1265.59, "timestamp": "00:21:05", "text": "兄弟，"}, {"type": "subtitle", "time": 1270.149, "timestamp": "00:21:10", "text": "這可糟了，兄弟。"}, {"type": "subtitle", "time": 1276.149, "timestamp": "00:21:16", "text": "太糟糕了。  兄弟，"}, {"type": "subtitle", "time": 1285.029, "timestamp": "00:21:25", "text": "我只能像這樣"}, {"type": "subtitle", "time": 1307.669, "timestamp": "00:21:47", "text": "用手拿著它，因為籃子晃得太厲害了。  我不知道該怎麼辦。  你看，你看，籃子裡的東西我盡力了。  比山澗溪流還要糟糕。  你知道嗎？我先把它拿在手上吧"}, {"type": "subtitle", "time": 1309.59, "timestamp": "00:21:49", "text": "。"}, {"type": "subtitle", "time": 1312.47, "timestamp": "00:21:52", "text": "我暫時就先這樣吧。"}]
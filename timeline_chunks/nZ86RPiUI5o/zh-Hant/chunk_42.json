[{"type": "subtitle", "time": 2523.589, "timestamp": "00:42:03", "text": "兄弟，好多車啊。我一直都很討厭"}, {"type": "subtitle", "time": 2525.829, "timestamp": "00:42:05", "text": "這條路。我得這樣"}, {"type": "subtitle", "time": 2542.95, "timestamp": "00:42:22", "text": "得開啟隱私模式了，因為，"}, {"type": "subtitle", "time": 2559.91, "timestamp": "00:42:39", "text": "對，就是那個。"}, {"type": "subtitle", "time": 2561.99, "timestamp": "00:42:41", "text": "就是它。"}, {"type": "subtitle", "time": 2564.55, "timestamp": "00:42:44", "text": "我的網路有可能切換或"}, {"type": "subtitle", "time": 2566.23, "timestamp": "00:42:46", "text": "重新連線。"}, {"type": "subtitle", "time": 2573.03, "timestamp": "00:42:53", "text": "我也把麥克風靜音吧。"}]
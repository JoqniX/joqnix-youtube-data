[{"type": "subtitle", "time": 7980.95, "timestamp": "02:13:00", "text": "我控制我的電腦。  所以，我已經好幾天沒關過電腦了"}, {"type": "subtitle", "time": 8016.39, "timestamp": "02:13:36", "text": "。"}, {"type": "subtitle", "time": 8024.31, "timestamp": "02:13:44", "text": "我覺得我昨天重啟了，我重啟了，但哦，我只是…我只是看了個遊戲，一個遊戲實況之類的，那裡沒有24小時頻道，我知道我可以看我自己的"}, {"type": "subtitle", "time": 8029.99, "timestamp": "02:13:49", "text": "頻道，就是這個，不，我還是…嗯，我還是可以看我自己的頻道，嗯，什麼？我們在"}, {"type": "subtitle", "time": 8038.709, "timestamp": "02:13:58", "text": "我的24小時頻道玩什麼？我們呃，顯然我的"}]
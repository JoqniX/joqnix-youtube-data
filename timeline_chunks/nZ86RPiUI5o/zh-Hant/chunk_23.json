[{"type": "subtitle", "time": 1386.87, "timestamp": "00:23:06", "text": "你好，媽。好久不見了。"}, {"type": "subtitle", "time": 1389.909, "timestamp": "00:23:09", "text": "生活怎麼樣？一切都好嗎？"}, {"type": "subtitle", "time": 1398.07, "timestamp": "00:23:18", "text": "我在網站上看到了你的留言。"}, {"type": "subtitle", "time": 1400.87, "timestamp": "00:23:20", "text": "順便說一下，我最近修改了一些"}, {"type": "subtitle", "time": 1403.83, "timestamp": "00:23:23", "text": "東西，並更新了我的網​​站。我看到了那個"}, {"type": "subtitle", "time": 1408.47, "timestamp": "00:23:28", "text": "匿名訊息。"}, {"type": "subtitle", "time": 1411.669, "timestamp": "00:23:31", "text": "謝謝你發來這封訊息。"}]
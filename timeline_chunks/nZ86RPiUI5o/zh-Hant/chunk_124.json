[{"type": "subtitle", "time": 7444.79, "timestamp": "02:04:04", "text": "其他事情。這是什麼？有人留下的嗎"}, {"type": "subtitle", "time": 7447.83, "timestamp": "02:04:07", "text": "？  呃，看，一個可愛的小東西。  有人把東西留在那裡了。沒有。  呃，相機在哪裡？"}, {"type": "subtitle", "time": 7481.83, "timestamp": "02:04:41", "text": "。糟了，我不得不"}, {"type": "subtitle", "time": 7489.51, "timestamp": "02:04:49", "text": "告訴他。我的天，居然沒有自動模式。哦，不。  好的，曝光機會是有的。天哪，我為什麼要點"}]
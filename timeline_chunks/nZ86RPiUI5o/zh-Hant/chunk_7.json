[{"type": "subtitle", "time": 422.55, "timestamp": "00:07:02", "text": "我希望你們能添加一個自動粉絲"}, {"type": "subtitle", "time": 427.67, "timestamp": "00:07:07", "text": "翻譯器之類的東西，方便聊天和討論糟糕的"}, {"type": "subtitle", "time": 430.55, "timestamp": "00:07:10", "text": "節目。"}, {"type": "subtitle", "time": 432.23, "timestamp": "00:07:12", "text": "所以，"}, {"type": "subtitle", "time": 433.909, "timestamp": "00:07:13", "text": "我們現在"}, {"type": "subtitle", "time": 439.749, "timestamp": "00:07:19", "text": "要去商店。我不知道"}, {"type": "subtitle", "time": 442.39, "timestamp": "00:07:22", "text": "我是否還能繼續直播。所以我這就"}, {"type": "subtitle", "time": 445.189, "timestamp": "00:07:25", "text": "開啟隱私模式。好的。哦，等等。"}, {"type": "subtitle", "time": 446.71, "timestamp": "00:07:26", "text": "我忘了創建場景，但我會"}, {"type": "subtitle", "time": 456.79, "timestamp": "00:07:36", "text": "一輛車，音樂聲震耳欲聾"}]
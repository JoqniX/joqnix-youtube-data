[{"type": "subtitle", "time": 5767.35, "timestamp": "01:36:07", "text": "笑聲] 你可以"}, {"type": "subtitle", "time": 5769.11, "timestamp": "01:36:09", "text": "聽出來。我勒個去？"}, {"type": "subtitle", "time": 5773.59, "timestamp": "01:36:13", "text": "兄弟，我討厭我的影子。每次我做……"}, {"type": "subtitle", "time": 5778.39, "timestamp": "01:36:18", "text": "呃……的時候，影子都會洩漏我的個人資料。別把你的用戶資訊留在公園裡。那是隻鳥嗎"}]
[{"type": "subtitle", "time": 3204.309, "timestamp": "00:53:24", "text": "[清喉嚨]"}, {"type": "subtitle", "time": 3206.23, "timestamp": "00:53:26", "text": "音頻。"}, {"type": "subtitle", "time": 3208.95, "timestamp": "00:53:28", "text": "等等，我的音訊沒問題吧？好的，沒關係。"}, {"type": "subtitle", "time": 3215.589, "timestamp": "00:53:35", "text": "，剩下最後一個，然後就是湯匙"}, {"type": "subtitle", "time": 3217.75, "timestamp": "00:53:37", "text": "什麼的了。"}, {"type": "subtitle", "time": 3227.349, "timestamp": "00:53:47", "text": "我忘了說會有一台"}, {"type": "subtitle", "time": 3229.829, "timestamp": "00:53:49", "text": "桌上型電腦。我也會試試這款"}, {"type": "subtitle", "time": 3234.23, "timestamp": "00:53:54", "text": "叫做《好遊戲》的遊戲。"}, {"type": "subtitle", "time": 3238.87, "timestamp": "00:53:58", "text": "嗯，這只是個遊戲。所以，在這一切之後，我們會在某個東西之後再添加一個字串"}]
[{"type": "subtitle", "time": 5400.95, "timestamp": "01:30:00", "text": "Yep, it's 21°C. It's going to drop down"}, {"type": "subtitle", "time": 5407.91, "timestamp": "01:30:07", "text": "to 6 uh 16 or 17 by 11 p.m."}, {"type": "subtitle", "time": 5417.669, "timestamp": "01:30:17", "text": "Look at the flower though right there."}, {"type": "subtitle", "time": 5420.47, "timestamp": "01:30:20", "text": "Flower and stuff."}, {"type": "subtitle", "time": 5423.11, "timestamp": "01:30:23", "text": "Really nice."}, {"type": "subtitle", "time": 5425.27, "timestamp": "01:30:25", "text": "It's autumn. So most of the flowers were"}, {"type": "subtitle", "time": 5428.149, "timestamp": "01:30:28", "text": "dried out. These are roses. But they"}, {"type": "subtitle", "time": 5431.03, "timestamp": "01:30:31", "text": "have the thing."}, {"type": "subtitle", "time": 5433.51, "timestamp": "01:30:33", "text": "Can you read it?"}, {"type": "subtitle", "time": 5443.83, "timestamp": "01:30:43", "text": "What is that? Hora rose."}, {"type": "subtitle", "time": 5458.55, "timestamp": "01:30:58", "text": "What is this?"}]
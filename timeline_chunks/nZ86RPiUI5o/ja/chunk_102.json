[{"type": "subtitle", "time": 6124.87, "timestamp": "01:42:04", "text": "ハエがいて、"}, {"type": "subtitle", "time": 6130.95, "timestamp": "01:42:10", "text": "[笑い] わかった"}, {"type": "subtitle", "time": 6133.109, "timestamp": "01:42:13", "text": "、見つけた場所に戻しておきます"}, {"type": "subtitle", "time": 6137.27, "timestamp": "01:42:17", "text": "。 気をつけろよ、銃。"}, {"type": "subtitle", "time": 6141.189, "timestamp": "01:42:21", "text": "ええ、この上に登って、"}, {"type": "subtitle", "time": 6149.27, "timestamp": "01:42:29", "text": "これは子供向けのおもちゃみたいなものだ。   そう"}, {"type": "subtitle", "time": 6152.39, "timestamp": "01:42:32", "text": "、こっちの方が大きな木があるんです"}, {"type": "subtitle", "time": 6153.99, "timestamp": "01:42:33", "text": "。"}, {"type": "subtitle", "time": 6156.07, "timestamp": "01:42:36", "text": "本当に素晴らしい。 そして、これが前回私がやったことです"}, {"type": "subtitle", "time": 6158.149, "timestamp": "01:42:38", "text": "。"}, {"type": "subtitle", "time": 6161.109, "timestamp": "01:42:41", "text": "これをもう一度やってみるべきだと思いますか？"}, {"type": "subtitle", "time": 6177.59, "timestamp": "01:42:57", "text": "私にやってほしいの？ わかった。   わかった"}]
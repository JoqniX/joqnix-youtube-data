[{"type": "subtitle", "time": 8460.95, "timestamp": "02:21:00", "text": "。私は"}, {"type": "subtitle", "time": 8464.95, "timestamp": "02:21:04", "text": "バカよ。"}, {"type": "subtitle", "time": 8472.87, "timestamp": "02:21:12", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 8476.23, "timestamp": "02:21:16", "text": "それで私は「ああ、これは"}, {"type": "subtitle", "time": 8478.95, "timestamp": "02:21:18", "text": "バンビーナっていうレストランみたいなものよ。"}, {"type": "subtitle", "time": 8481.03, "timestamp": "02:21:21", "text": "食べ物が出てくる自動販売機があるの。"}, {"type": "subtitle", "time": 8488.309, "timestamp": "02:21:28", "text": "ああ、そう。ママ、"}, {"type": "subtitle", "time": 8490.389, "timestamp": "02:21:30", "text": "コナダ、あなたたち二人ともこれ見たことないでしょ"}, {"type": "subtitle", "time": 8494.389, "timestamp": "02:21:34", "text": "？えっと、"}, {"type": "subtitle", "time": 8496.95, "timestamp": "02:21:36", "text": "さっき配信してた人たちがこれを見たのよ。"}, {"type": "subtitle", "time": 8499.75, "timestamp": "02:21:39", "text": "ここに自動販売機があって、"}, {"type": "subtitle", "time": 8502.15, "timestamp": "02:21:42", "text": "お金を払えば"}, {"type": "subtitle", "time": 8505.03, "timestamp": "02:21:45", "text": "下から食べ物が出てくるの。"}, {"type": "subtitle", "time": 8507.67, "timestamp": "02:21:47", "text": "そう、ピザとかスパゲッティとか、そういうの全部"}, {"type": "subtitle", "time": 8511.11, "timestamp": "02:21:51", "text": "。下から出てくるのよ。中に"}, {"type": "subtitle", "time": 8513.59, "timestamp": "02:21:53", "text": "入る必要はないと思う。"}, {"type": "subtitle", "time": 8515.75, "timestamp": "02:21:55", "text": "それとも違うかな？チケットか"}]
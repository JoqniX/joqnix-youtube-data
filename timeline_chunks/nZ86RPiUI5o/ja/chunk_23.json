[{"type": "subtitle", "time": 1386.87, "timestamp": "00:23:06", "text": "こんにちは、ママ。 久しぶりですね。"}, {"type": "subtitle", "time": 1389.909, "timestamp": "00:23:09", "text": "調子はどうですか？ 調子はどうですか？"}, {"type": "subtitle", "time": 1398.07, "timestamp": "00:23:18", "text": "サイトであなたのメッセージを拝見しました。"}, {"type": "subtitle", "time": 1400.87, "timestamp": "00:23:20", "text": "ちなみに、最近ウェブ"}, {"type": "subtitle", "time": 1403.83, "timestamp": "00:23:23", "text": "サイトの設定を変更したり、更新したりしていました。"}, {"type": "subtitle", "time": 1408.47, "timestamp": "00:23:28", "text": "匿名のメッセージのようなものを見ました。"}, {"type": "subtitle", "time": 1411.669, "timestamp": "00:23:31", "text": "メッセージを書いてくださり、ありがとうございます。"}]
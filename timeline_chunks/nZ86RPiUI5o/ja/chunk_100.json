[{"type": "subtitle", "time": 6001.35, "timestamp": "01:40:01", "text": "銃じゃない。"}, {"type": "subtitle", "time": 6005.83, "timestamp": "01:40:05", "text": "誰かがここに置いたのかな。   何てことだ"}, {"type": "subtitle", "time": 6008.47, "timestamp": "01:40:08", "text": "。"}, {"type": "subtitle", "time": 6029.51, "timestamp": "01:40:29", "text": "ああ、なんてことだ。 懐中電灯"}, {"type": "subtitle", "time": 6058.79, "timestamp": "01:40:58", "text": "私は（咳払いをして）ここから引き継ぎました。 まさに"}]
[{"type": "subtitle", "time": 7023.43, "timestamp": "01:57:03", "text": "それで、この女子高生が、"}, {"type": "subtitle", "time": 7027.109, "timestamp": "01:57:07", "text": "アドの部隊に入りたいとか言い出したんです。 だから"}, {"type": "subtitle", "time": 7029.35, "timestamp": "01:57:09", "text": "彼女はものすごくトレーニングしているんです"}, {"type": "subtitle", "time": 7031.669, "timestamp": "01:57:11", "text": "。"}, {"type": "subtitle", "time": 7034.709, "timestamp": "01:57:14", "text": "うん。 白金。  「うん」を変えてください。 うん。"}, {"type": "subtitle", "time": 7038.39, "timestamp": "01:57:18", "text": "うん。 本当に、本当に、本当にその通りです。 正しい。"}, {"type": "subtitle", "time": 7040.87, "timestamp": "01:57:20", "text": "そう、それだ。"}, {"type": "subtitle", "time": 7043.51, "timestamp": "01:57:23", "text": "ええ、"}, {"type": "subtitle", "time": 7046.229, "timestamp": "01:57:26", "text": "そうですね。 そして、"}, {"type": "subtitle", "time": 7049.43, "timestamp": "01:57:29", "text": "実際に"}, {"type": "subtitle", "time": 7052.709, "timestamp": "01:57:32", "text": "歌唱力のある人を目の当たりにできたのは本当に素晴らしい経験でした。 同じような"}, {"type": "subtitle", "time": 7055.189, "timestamp": "01:57:35", "text": "話ですが、私が"}, {"type": "subtitle", "time": 7059.75, "timestamp": "01:57:39", "text": "参加したカバーソングのクラスでは、"}, {"type": "subtitle", "time": 7063.99, "timestamp": "01:57:43", "text": "実際のレコーディング"}, {"type": "subtitle", "time": 7067.43, "timestamp": "01:57:47", "text": "スタジオでカバーソングの作り方などを学びました。"}, {"type": "subtitle", "time": 7074.31, "timestamp": "01:57:54", "text": "歌がとても上手な女の子がいました。 彼女は、"}, {"type": "subtitle", "time": 7077.75, "timestamp": "01:57:57", "text": "その場にいた全員から、"}]
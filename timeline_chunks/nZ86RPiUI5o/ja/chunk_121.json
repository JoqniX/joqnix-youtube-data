[{"type": "subtitle", "time": 7266.31, "timestamp": "02:01:06", "text": "うん。 共和党は本当に良い。"}, {"type": "subtitle", "time": 7269.83, "timestamp": "02:01:09", "text": "歌詞も内容も全てが素晴らしい。 だから、みんな、俺はまた"}, {"type": "subtitle", "time": 7277.51, "timestamp": "02:01:17", "text": "音楽の仕事をやりたいんだよ。 私は"}, {"type": "subtitle", "time": 7279.589, "timestamp": "02:01:19", "text": "ゲームをしたり、他のことをしたりする必要があるんです。"}, {"type": "subtitle", "time": 7283.189, "timestamp": "02:01:23", "text": "これは何ですか？ 誰かがこれを残していったのでしょうか？"}, {"type": "subtitle", "time": 7286.55, "timestamp": "02:01:26", "text": "あぁ、かわいいものを見て。"}, {"type": "subtitle", "time": 7309.51, "timestamp": "02:01:49", "text": "カメラはどこ？   えっと、"}]
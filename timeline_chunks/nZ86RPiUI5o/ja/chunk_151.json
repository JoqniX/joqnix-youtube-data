[{"type": "subtitle", "time": 9061.51, "timestamp": "02:31:01", "text": "今週プレイすると思う。"}, {"type": "subtitle", "time": 9064.309, "timestamp": "02:31:04", "text": "ワログの新しいシーズンが来るかもしれない。だから"}, {"type": "subtitle", "time": 9068.87, "timestamp": "02:31:08", "text": "水曜日に試してみようと思う。水曜日か、えーと、水曜日か木曜日か、"}, {"type": "subtitle", "time": 9077.91, "timestamp": "02:31:17", "text": "水曜日か土曜日に試してみよう"}, {"type": "subtitle", "time": 9080.95, "timestamp": "02:31:20", "text": "。日曜日はリレーションズ。うん、"}, {"type": "subtitle", "time": 9085.59, "timestamp": "02:31:25", "text": "全部収まるよ。"}, {"type": "subtitle", "time": 9087.99, "timestamp": "02:31:27", "text": "だから、えーと、"}, {"type": "subtitle", "time": 9093.99, "timestamp": "02:31:33", "text": "皆さん、"}, {"type": "subtitle", "time": 9097.03, "timestamp": "02:31:37", "text": "見てくれてありがとう。"}]
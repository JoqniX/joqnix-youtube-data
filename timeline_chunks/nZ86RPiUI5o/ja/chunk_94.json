[{"type": "subtitle", "time": 5642.87, "timestamp": "01:34:02", "text": "文字通り「"}, {"type": "subtitle", "time": 5647.27, "timestamp": "01:34:07", "text": "クリケット禁止」とか「"}, {"type": "subtitle", "time": 5650.39, "timestamp": "01:34:10", "text": "クリケットは禁止」とか書いてある看板があるんです"}, {"type": "subtitle", "time": 5652.229, "timestamp": "01:34:12", "text": "。"}, {"type": "subtitle", "time": 5654.629, "timestamp": "01:34:14", "text": "それは倉庫にあるような物ですね。 ウォーカー"}, {"type": "subtitle", "time": 5656.149, "timestamp": "01:34:16", "text": "ルーム。   あの、"}, {"type": "subtitle", "time": 5661.43, "timestamp": "01:34:21", "text": "ゴミは持ち帰ってください。"}, {"type": "subtitle", "time": 5665.03, "timestamp": "01:34:25", "text": "野球ボールとか色々持ってるよ。"}, {"type": "subtitle", "time": 5669.51, "timestamp": "01:34:29", "text": "ここでは野球とかができますよ。 さあ、"}, {"type": "subtitle", "time": 5671.59, "timestamp": "01:34:31", "text": "私の影がそこにいるよ。  [笑い] 分かりますよ"}, {"type": "subtitle", "time": 5674.39, "timestamp": "01:34:34", "text": "。 なんてこった？"}, {"type": "subtitle", "time": 5676.79, "timestamp": "01:34:36", "text": "自分の影が大嫌いだよ、兄弟。 影だけが、私が何かをしているたびに"}, {"type": "subtitle", "time": 5679.51, "timestamp": "01:34:39", "text": "私をドクシングしています。"}, {"type": "subtitle", "time": 5684.31, "timestamp": "01:34:44", "text": "ユーザーを公園に放置しないでください。"}, {"type": "subtitle", "time": 5699.51, "timestamp": "01:34:59", "text": "H いい質問ですね、Ma ええと、"}]
[{"type": "subtitle", "time": 6180.229, "timestamp": "01:43:00", "text": "。 あなたは理解しつつあります。 片手で"}, {"type": "subtitle", "time": 6183.109, "timestamp": "01:43:03", "text": "これを扱う。 待てよ、三脚は"}, {"type": "subtitle", "time": 6191.109, "timestamp": "01:43:11", "text": "待って。 待って、"}, {"type": "subtitle", "time": 6193.99, "timestamp": "01:43:13", "text": "待って、待って。 いい考えがある。"}, {"type": "subtitle", "time": 6197.27, "timestamp": "01:43:17", "text": "あそこに三脚を置いて、私が"}, {"type": "subtitle", "time": 6206.31, "timestamp": "01:43:26", "text": "それはあなたが私に付けてほしいと頼んだ笑顔の絵文字です"}, {"type": "subtitle", "time": 6208.87, "timestamp": "01:43:28", "text": "。  [笑い]"}, {"type": "subtitle", "time": 6211.43, "timestamp": "01:43:31", "text": "それはあなたが教えてくれた笑顔のことです。"}, {"type": "subtitle", "time": 6224.629, "timestamp": "01:43:44", "text": "全画面表示にすると、回転スケールが水平方向にリセットされます"}, {"type": "subtitle", "time": 6227.75, "timestamp": "01:43:47", "text": "。 わかった。   はい、どうぞ"}, {"type": "subtitle", "time": 6237.35, "timestamp": "01:43:57", "text": "シーンを修正し"}]
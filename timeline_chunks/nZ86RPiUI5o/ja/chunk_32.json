[{"type": "subtitle", "time": 1922.07, "timestamp": "00:32:02", "text": "よし、もうすぐ着くぞ。 あれが"}, {"type": "subtitle", "time": 1929.669, "timestamp": "00:32:09", "text": "アオキ。 うん。 ああ、それは正反対だ。   どうやら"}, {"type": "subtitle", "time": 1937.43, "timestamp": "00:32:17", "text": "自転車をあそこに停めて、中に入ってください"}, {"type": "subtitle", "time": 1940.71, "timestamp": "00:32:20", "text": "。会員制のシステムがあって、"}, {"type": "subtitle", "time": 1943.75, "timestamp": "00:32:23", "text": "ポイント制の車みたいなものもあるんですよ。"}, {"type": "subtitle", "time": 1977.75, "timestamp": "00:32:57", "text": "さて、まだ番組のサイクルをお見せしていませんでしたね"}]
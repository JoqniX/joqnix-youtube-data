[{"type": "subtitle", "time": 800.069, "timestamp": "00:13:20", "text": "、でもここは本当に気持ちいい。"}, {"type": "subtitle", "time": 801.829, "timestamp": "00:13:21", "text": "待って、これ、見えるよね？ 私の配信は"}, {"type": "subtitle", "time": 804.389, "timestamp": "00:13:24", "text": "問題ないですよね？"}, {"type": "subtitle", "time": 816.79, "timestamp": "00:13:36", "text": "5分前のスムージングビットレートはどうでしたか？"}, {"type": "subtitle", "time": 819.91, "timestamp": "00:13:39", "text": "これはどういうことですか？ ああ、そうですね、それは"}, {"type": "subtitle", "time": 823.829, "timestamp": "00:13:43", "text": "私が店内で持っているリソースによります。"}, {"type": "subtitle", "time": 827.509, "timestamp": "00:13:47", "text": "カメラを使っていなかったからでしょうか、それとも"}, {"type": "subtitle", "time": 832.15, "timestamp": "00:13:52", "text": "カメラの使用をやめたからでしょうか？   それは"}, {"type": "subtitle", "time": 835.19, "timestamp": "00:13:55", "text": "いつ、店内"}]
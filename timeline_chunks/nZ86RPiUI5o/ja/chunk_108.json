[{"type": "subtitle", "time": 6480.47, "timestamp": "01:48:00", "text": "よし、じゃあフラッシュなしでやってみよう。   ええと"}, {"type": "subtitle", "time": 6484.629, "timestamp": "01:48:04", "text": "、わかりました。  ３、２、１。  2回目の"}, {"type": "subtitle", "time": 6486.47, "timestamp": "01:48:06", "text": "訪問です。"}, {"type": "subtitle", "time": 6488.709, "timestamp": "01:48:08", "text": "えっと、ちょっと待ってください。その前に"}, {"type": "subtitle", "time": 6494.39, "timestamp": "01:48:14", "text": "背景の音は聞こえますよね？ そういうのが好きなんです"}, {"type": "subtitle", "time": 6499.59, "timestamp": "01:48:19", "text": "。 そうだといい。"}, {"type": "subtitle", "time": 6503.35, "timestamp": "01:48:23", "text": "待ってください、ノイズ対策はオフになっています。"}, {"type": "subtitle", "time": 6506.229, "timestamp": "01:48:26", "text": "ああ、ミミの声しか聞こえないんですよね？"}, {"type": "subtitle", "time": 6513.51, "timestamp": "01:48:33", "text": "ああ、では私がやってみましょう。 ちょっと待ってください"}, {"type": "subtitle", "time": 6521.59, "timestamp": "01:48:41", "text": "。 建物のマイクにノイズ抑制機能があるのはなぜですか"}, {"type": "subtitle", "time": 6523.189, "timestamp": "01:48:43", "text": "？   えっと"}, {"type": "subtitle", "time": 6534.149, "timestamp": "01:48:54", "text": "、これで聞こえるようになりました。   わかった"}, {"type": "subtitle", "time": 6537.669, "timestamp": "01:48:57", "text": "。 わかった。 わかった。 わかった。 こんにちは。  3 2 1 突入します"}]
[{"type": "subtitle", "time": 304.629, "timestamp": "00:05:04", "text": "M、"}, {"type": "subtitle", "time": 307.99, "timestamp": "00:05:07", "text": "私は文字通り自転車に乗っているんです。"}, {"type": "subtitle", "time": 311.35, "timestamp": "00:05:11", "text": "やばい、"}, {"type": "subtitle", "time": 314.07, "timestamp": "00:05:14", "text": "手首と腕のやつが動いてる"}, {"type": "subtitle", "time": 343.67, "timestamp": "00:05:43", "text": "待って、今ならここに行けるよ。"}, {"type": "subtitle", "time": 358.39, "timestamp": "00:05:58", "text": "ああ、わかった"}]
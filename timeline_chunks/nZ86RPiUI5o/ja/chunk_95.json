[{"type": "subtitle", "time": 5702.79, "timestamp": "01:35:02", "text": "あなたがそう尋ねたんですよね、なぜリ"}, {"type": "subtitle", "time": 5706.39, "timestamp": "01:35:06", "text": "アクティブを使わないのかと。"}, {"type": "subtitle", "time": 5709.59, "timestamp": "01:35:09", "text": "リアクティブは使えますが、"}, {"type": "subtitle", "time": 5711.59, "timestamp": "01:35:11", "text": "口を開閉するものがないので、それを"}, {"type": "subtitle", "time": 5715.59, "timestamp": "01:35:15", "text": "ライブ 2D でリグする必要があります。そうすれば、"}, {"type": "subtitle", "time": 5723.11, "timestamp": "01:35:23", "text": "口を開閉するための静止画像を作成できます。"}, {"type": "subtitle", "time": 5729.43, "timestamp": "01:35:29", "text": "口を開けた表情のPNG画像のようなものを作ったと思うのですが、ただ"}, {"type": "subtitle", "time": 5732.709, "timestamp": "01:35:32", "text": "口を開けているだけです。 笑顔の演出はない。"}, {"type": "subtitle", "time": 5735.83, "timestamp": "01:35:35", "text": "私には中立的な考え方があるんです。"}, {"type": "subtitle", "time": 5740.47, "timestamp": "01:35:40", "text": "ええ、これは、"}, {"type": "subtitle", "time": 5743.35, "timestamp": "01:35:43", "text": "サッカー、いや、"}, {"type": "subtitle", "time": 5745.11, "timestamp": "01:35:45", "text": "フットボール、アメリカンフットボールをしたり、"}, {"type": "subtitle", "time": 5749.75, "timestamp": "01:35:49", "text": "キャッチボールをしたり、"}, {"type": "subtitle", "time": 5752.629, "timestamp": "01:35:52", "text": "野球をしたりできます。 ここは野球"}, {"type": "subtitle", "time": 5754.87, "timestamp": "01:35:54", "text": "場でもある。   そこには"}]
[{"type": "subtitle", "time": 2045.669, "timestamp": "00:34:05", "text": "私の顔はここでは少しはっきりしています。 ああ、くそ。   え、"}, {"type": "subtitle", "time": 2050.31, "timestamp": "00:34:10", "text": "何？ うん。 うん。 傘はよく盗まれた"}, {"type": "subtitle", "time": 2053.03, "timestamp": "00:34:13", "text": "。"}, {"type": "subtitle", "time": 2056.79, "timestamp": "00:34:16", "text": "何だって？ 俺の顔はすごくよく見えるんだよ、"}, {"type": "subtitle", "time": 2058.869, "timestamp": "00:34:18", "text": "兄弟。"}, {"type": "subtitle", "time": 2062.389, "timestamp": "00:34:22", "text": "えっと、フライドチキンはどこですか？"}, {"type": "subtitle", "time": 2088.23, "timestamp": "00:34:48", "text": "うん」って感じですね。 自分が何かと一緒に画面に映り込まない限りは"}, {"type": "subtitle", "time": 2091.349, "timestamp": "00:34:51", "text": "大丈夫だ。 えっと、"}, {"type": "subtitle", "time": 2093.27, "timestamp": "00:34:53", "text": "フライドチキンはどこにあるの？ あらゆる場所で探しています"}, {"type": "subtitle", "time": 2095.75, "timestamp": "00:34:55", "text": "。   あそこにあるよ"}, {"type": "subtitle", "time": 2099.19, "timestamp": "00:34:59", "text": "。 あれは店員です。 事務員は"}]
[{"type": "subtitle", "time": 4560.63, "timestamp": "01:16:00", "text": "バウンディング"}, {"type": "subtitle", "time": 4562.229, "timestamp": "01:16:02", "text": "ボックスの"}, {"type": "subtitle", "time": 4566.63, "timestamp": "01:16:06", "text": "件は直した？ 待って、どうしてこんなに幅が広いの？"}, {"type": "subtitle", "time": 4581.91, "timestamp": "01:16:21", "text": "バウンディングボックスをお見せできたらいいのですが。 それには"}, {"type": "subtitle", "time": 4585.03, "timestamp": "01:16:25", "text": "バグはありません。"}, {"type": "subtitle", "time": 4588.47, "timestamp": "01:16:28", "text": "じゃあ、スクリーンショットを撮っておきましょう。"}, {"type": "subtitle", "time": 4594.719, "timestamp": "01:16:34", "text": "。 ああ、イマーシブモードにビットレートを追加したんですね"}, {"type": "subtitle", "time": 4596.56, "timestamp": "01:16:36", "text": "ああ、イマーシブモードにビットレートを追加したんですね 。 ありがとう。"}, {"type": "subtitle", "time": 4603.189, "timestamp": "01:16:43", "text": "ええ、つまり今日の配信は"}, {"type": "subtitle", "time": 4605.03, "timestamp": "01:16:45", "text": "基本的に私が"}, {"type": "subtitle", "time": 4608.07, "timestamp": "01:16:48", "text": "使っているアプリの新しいアップデートをテストしているところです。"}, {"type": "subtitle", "time": 4610.55, "timestamp": "01:16:50", "text": "チャットで開発したのはUkunです。   ええ、そうですね。"}, {"type": "subtitle", "time": 4617.51, "timestamp": "01:16:57", "text": "うん。 散歩に行こうかな。 待って。"}]
[{"type": "subtitle", "time": 4620.31, "timestamp": "01:17:00", "text": "ええと、"}, {"type": "subtitle", "time": 4622.63, "timestamp": "01:17:02", "text": "フルスクリーンモードの没入モードに表示できるものがもう一つあります"}, {"type": "subtitle", "time": 4625.91, "timestamp": "01:17:05", "text": "。それはバッテリー残量です。"}, {"type": "subtitle", "time": 4628.31, "timestamp": "01:17:08", "text": "それはいいですね。"}, {"type": "subtitle", "time": 4630.63, "timestamp": "01:17:10", "text": "バッテリーの充電レベルを表示してくれると、"}, {"type": "subtitle", "time": 4634.63, "timestamp": "01:17:14", "text": "とても助かります。"}, {"type": "subtitle", "time": 4637.11, "timestamp": "01:17:17", "text": "バッテリーの充電レベルが気になる。"}, {"type": "subtitle", "time": 4640.149, "timestamp": "01:17:20", "text": "だから、私が必要とするのは、"}, {"type": "subtitle", "time": 4644.07, "timestamp": "01:17:24", "text": "バッテリーの充電レベルと、"}, {"type": "subtitle", "time": 4645.99, "timestamp": "01:17:25", "text": "ええと、"}, {"type": "subtitle", "time": 4649.75, "timestamp": "01:17:29", "text": "バッテリーの充電レベルと、"}, {"type": "subtitle", "time": 4652.39, "timestamp": "01:17:32", "text": "ええと、ロックのことです。"}, {"type": "subtitle", "time": 4656.31, "timestamp": "01:17:36", "text": "[笑い]"}, {"type": "subtitle", "time": 4667.83, "timestamp": "01:17:47", "text": "私はいつもそっちの方向に行ってたよね？ 私はいつも"}, {"type": "subtitle", "time": 4670.39, "timestamp": "01:17:50", "text": "その道を通っていたよね？ 私もこの"}, {"type": "subtitle", "time": 4672.149, "timestamp": "01:17:52", "text": "道を通りました。"}, {"type": "subtitle", "time": 4676.07, "timestamp": "01:17:56", "text": "今日は、そっちの方向へ行こう。 わかった。"}, {"type": "subtitle", "time": 4679.11, "timestamp": "01:17:59", "text": "私もそちらの方向へ行きました。 しかし、"}]
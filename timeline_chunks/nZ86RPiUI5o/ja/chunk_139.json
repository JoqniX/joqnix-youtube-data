[{"type": "subtitle", "time": 8341.669, "timestamp": "02:19:01", "text": "それでおしまい。 私は彼らがどのように"}, {"type": "subtitle", "time": 8344.79, "timestamp": "02:19:04", "text": "試合をするのかを学ぶ。 それでおしまい。 うん。 結局、"}, {"type": "subtitle", "time": 8348.309, "timestamp": "02:19:08", "text": "試合を観戦するだけになってしまいます。 それでおしまい。 私はそういう"}, {"type": "subtitle", "time": 8356.709, "timestamp": "02:19:16", "text": "それで、"}, {"type": "subtitle", "time": 8373.75, "timestamp": "02:19:33", "text": "OTK"}, {"type": "subtitle", "time": 8380.07, "timestamp": "02:19:40", "text": "SAN TV の長髪の男のウォールプレイヤーがいるんだ。"}, {"type": "subtitle", "time": 8383.27, "timestamp": "02:19:43", "text": "うんうん、彼がプレーしているのを見てるよ。"}, {"type": "subtitle", "time": 8395.59, "timestamp": "02:19:55", "text": "ああ、明日はWellでストリーミング配信します。"}, {"type": "subtitle", "time": 8398.63, "timestamp": "02:19:58", "text": "心配しないで。 えっと、時間があるときはいつでも来てください"}]
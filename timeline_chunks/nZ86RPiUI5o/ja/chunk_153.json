[{"type": "subtitle", "time": 9182.389, "timestamp": "02:33:02", "text": "あ、できないみたい。あ、いや。いや、待って。やらなきゃいけなかったんだ"}, {"type": "subtitle", "time": 9184.309, "timestamp": "02:33:04", "text": "。あ、そうだ。"}, {"type": "subtitle", "time": 9186.309, "timestamp": "02:33:06", "text": "今すぐ直さなきゃ。カダサン・"}, {"type": "subtitle", "time": 9193.99, "timestamp": "02:33:13", "text": "来てくれてありがとう。"}, {"type": "subtitle", "time": 9197.19, "timestamp": "02:33:17", "text": "みんな来てくれたんだね。そして、来てくれたと思う。わからないけど"}, {"type": "subtitle", "time": 9200.15, "timestamp": "02:33:20", "text": "。来てくれてありがとう。"}, {"type": "subtitle", "time": 9203.03, "timestamp": "02:33:23", "text": "今日の次の配信で、"}, {"type": "subtitle", "time": 9209.67, "timestamp": "02:33:29", "text": "バイバイ。"}, {"type": "subtitle", "time": 9213.11, "timestamp": "02:33:33", "text": "みんな、良い一日を。"}, {"type": "subtitle", "time": 9214.87, "timestamp": "02:33:34", "text": "バイバイ。2"}]
[{"type": "subtitle", "time": 5160.07, "timestamp": "01:26:00", "text": "テスト、ライブテストは実際とても"}, {"type": "subtitle", "time": 5163.91, "timestamp": "01:26:03", "text": "うまくいきました。 私も最新バージョン、"}, {"type": "subtitle", "time": 5172.629, "timestamp": "01:26:12", "text": "リリースされたバージョン1.00.1を使っています。 ええ、見てください"}, {"type": "subtitle", "time": 5178.149, "timestamp": "01:26:18", "text": "。 犬の散歩に来る人たちとか"}, {"type": "subtitle", "time": 5181.59, "timestamp": "01:26:21", "text": "。 ええ、"}, {"type": "subtitle", "time": 5186.229, "timestamp": "01:26:26", "text": "あそこのスキアはそうなんですか？"}, {"type": "subtitle", "time": 5188.95, "timestamp": "01:26:28", "text": "橋まで行ってみようか？"}, {"type": "subtitle", "time": 5190.629, "timestamp": "01:26:30", "text": "今日は無理かもしれないね"}, {"type": "subtitle", "time": 5202.229, "timestamp": "01:26:42", "text": "問題は、今"}, {"type": "subtitle", "time": 5206.47, "timestamp": "01:26:46", "text": "私が直面しているのは、"}, {"type": "subtitle", "time": 5211.83, "timestamp": "01:26:51", "text": "たくさんのボタンをクリックする必要があるということです"}]
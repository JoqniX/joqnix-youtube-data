[{"type": "subtitle", "time": 2523.589, "timestamp": "00:42:03", "text": "おい、すごい数の車だな。 そして、私は"}, {"type": "subtitle", "time": 2525.829, "timestamp": "00:42:05", "text": "この道がいつも大嫌いだ。 私はこうやって行かなければならない"}, {"type": "subtitle", "time": 2542.95, "timestamp": "00:42:22", "text": "プライバシーモードにしないといけませんね。"}, {"type": "subtitle", "time": 2559.91, "timestamp": "00:42:39", "text": "そう、それだ。"}, {"type": "subtitle", "time": 2561.99, "timestamp": "00:42:41", "text": "まさにそれだ。"}, {"type": "subtitle", "time": 2564.55, "timestamp": "00:42:44", "text": "インターネット接続が切り替わったり、"}, {"type": "subtitle", "time": 2566.23, "timestamp": "00:42:46", "text": "再接続されたりする可能性があります。"}, {"type": "subtitle", "time": 2573.03, "timestamp": "00:42:53", "text": "マイクをミュートにします。   とにかく"}]
[{"type": "subtitle", "time": 4741.27, "timestamp": "01:19:01", "text": "スライドドア"}, {"type": "subtitle", "time": 4744.07, "timestamp": "01:19:04", "text": "とドアにフラッシュを当ててないよ。"}, {"type": "subtitle", "time": 4746.829, "timestamp": "01:19:06", "text": "ああ、それは重要ですね。"}, {"type": "subtitle", "time": 4749.03, "timestamp": "01:19:09", "text": "[鼻を鳴らす] おかえりなさい。 ちょっと"}, {"type": "subtitle", "time": 4751.11, "timestamp": "01:19:11", "text": "散歩に行くだけです。"}, {"type": "subtitle", "time": 4752.709, "timestamp": "01:19:12", "text": "うん。"}, {"type": "subtitle", "time": 4756.31, "timestamp": "01:19:16", "text": "つまり、今は午後7時13分です。"}, {"type": "subtitle", "time": 4760.47, "timestamp": "01:19:20", "text": "そして、それらはボタンです。"}, {"type": "subtitle", "time": 4766.709, "timestamp": "01:19:26", "text": "だから、それをフリーセックスみたいなところに置くこともできるし、家で見せることもできると"}, {"type": "subtitle", "time": 4787.91, "timestamp": "01:19:47", "text": "フルビューみたいな家だけど、"}, {"type": "subtitle", "time": 4790.149, "timestamp": "01:19:50", "text": "完全に閉じていて、"}, {"type": "subtitle", "time": 4792.95, "timestamp": "01:19:52", "text": "何て言うんだっけ、隠されているんだ。"}, {"type": "subtitle", "time": 4796.55, "timestamp": "01:19:56", "text": "ハートンズ。"}, {"type": "subtitle", "time": 4799.03, "timestamp": "01:19:59", "text": "ああ、"}]
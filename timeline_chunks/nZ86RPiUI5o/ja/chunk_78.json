[{"type": "subtitle", "time": 4702.63, "timestamp": "01:18:22", "text": "C はどこにあるの？   あの"}, {"type": "subtitle", "time": 4706.219, "timestamp": "01:18:26", "text": "カメラを持っていればよかった。"}, {"type": "subtitle", "time": 4709.189, "timestamp": "01:18:29", "text": "[鼻を鳴らす] カメラ。 カメラはどこですか？"}, {"type": "subtitle", "time": 4711.669, "timestamp": "01:18:31", "text": "フラッシュカイ。   ああ"}, {"type": "subtitle", "time": 4720.229, "timestamp": "01:18:40", "text": "待って、スライダーにフラッシュオプションがないよ"}, {"type": "subtitle", "time": 4726.87, "timestamp": "01:18:46", "text": "フラッシュとか"}, {"type": "subtitle", "time": 4729.91, "timestamp": "01:18:49", "text": "ミラーとか、そういうのを"}, {"type": "subtitle", "time": 4731.75, "timestamp": "01:18:51", "text": "スライダーに付けてなかったよね。"}, {"type": "subtitle", "time": 4734.55, "timestamp": "01:18:54", "text": "あ、待って、待って。 ミラーはスライダー内に配置できません"}, {"type": "subtitle", "time": 4738.95, "timestamp": "01:18:58", "text": "。 待って、"}]
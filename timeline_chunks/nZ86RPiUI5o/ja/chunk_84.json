[{"type": "subtitle", "time": 5056.95, "timestamp": "01:24:16", "text": "ことって、時々すごくイライラするよね。"}, {"type": "subtitle", "time": 5059.03, "timestamp": "01:24:19", "text": "うん。 これは"}, {"type": "subtitle", "time": 5061.43, "timestamp": "01:24:21", "text": "最近建てられた新しい家です。"}, {"type": "subtitle", "time": 5064.629, "timestamp": "01:24:24", "text": "ここに引っ越してきた人がいるような気がする。 これは"}, {"type": "subtitle", "time": 5067.03, "timestamp": "01:24:27", "text": "興味深い。"}, {"type": "subtitle", "time": 5070.629, "timestamp": "01:24:30", "text": "以前は、"}, {"type": "subtitle", "time": 5076.07, "timestamp": "01:24:36", "text": "ここにあるような小型車のように、お見せできるようなものは何もありませんでした。 これはまるでオモチャの車みたいだ。"}, {"type": "subtitle", "time": 5079.43, "timestamp": "01:24:39", "text": "ここに写っている"}, {"type": "subtitle", "time": 5082.87, "timestamp": "01:24:42", "text": "赤いやつは、おもちゃの車みたいですね。 そして"}, {"type": "subtitle", "time": 5085.91, "timestamp": "01:24:45", "text": "彼らはオンラインでSoratをプレイできる。  Soratのオンライン"}, {"type": "subtitle", "time": 5087.75, "timestamp": "01:24:47", "text": "版。"}, {"type": "subtitle", "time": 5092.149, "timestamp": "01:24:52", "text": "オンラインでソーダを販売しているところもあるけど、"}]
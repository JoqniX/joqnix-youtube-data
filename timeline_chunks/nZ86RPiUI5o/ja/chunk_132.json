[{"type": "subtitle", "time": 7920.39, "timestamp": "02:12:00", "text": "、待って。 私の携帯電話の画面が真っ暗になった。 なんてこった"}, {"type": "subtitle", "time": 7931.189, "timestamp": "02:12:11", "text": "M. M. 俺の携帯は黒だよ、兄弟。 なんてこった"}, {"type": "subtitle", "time": 7933.35, "timestamp": "02:12:13", "text": "？"}, {"type": "subtitle", "time": 7943.99, "timestamp": "02:12:23", "text": "いや、いや、いや、いや、いや、いや、いや。 そんなことしないで"}, {"type": "subtitle", "time": 7946.31, "timestamp": "02:12:26", "text": "。 いや、だめ、だめ、だめ、だめ、だめ、だめ、だめ"}, {"type": "subtitle", "time": 7952.79, "timestamp": "02:12:32", "text": "だめ。"}, {"type": "subtitle", "time": 7954.709, "timestamp": "02:12:34", "text": "おいおい、"}, {"type": "subtitle", "time": 7957.189, "timestamp": "02:12:37", "text": "キーパッドはどこだ？ パスワードを入力したいです"}, {"type": "subtitle", "time": 7960.629, "timestamp": "02:12:40", "text": "。 何てことだ。   何てことだ"}, {"type": "subtitle", "time": 7962.709, "timestamp": "02:12:42", "text": "。 待って。"}, {"type": "subtitle", "time": 7972.39, "timestamp": "02:12:52", "text": "ステータスバーが全て表示されません。 移行バーが"}, {"type": "subtitle", "time": 7974.229, "timestamp": "02:12:54", "text": "表示されません。"}, {"type": "subtitle", "time": 7978.149, "timestamp": "02:12:58", "text": "ああ、読み込み中です。 わかった。 わかった。 わかった。"}]
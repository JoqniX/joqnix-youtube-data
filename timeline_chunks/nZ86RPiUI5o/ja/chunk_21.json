[{"type": "subtitle", "time": 1265.59, "timestamp": "00:21:05", "text": "おい、"}, {"type": "subtitle", "time": 1270.149, "timestamp": "00:21:10", "text": "これはまずいぞ。"}, {"type": "subtitle", "time": 1276.149, "timestamp": "00:21:16", "text": "すごく悪い。"}, {"type": "subtitle", "time": 1289.75, "timestamp": "00:21:29", "text": "かごがすごく揺れるので、こうやって手で持っておかないといけないんです。"}, {"type": "subtitle", "time": 1302.07, "timestamp": "00:21:42", "text": "ほら、このかごは私が精一杯頑張った結果です。"}, {"type": "subtitle", "time": 1305.99, "timestamp": "00:21:45", "text": "山間の小川よりもひどい。"}, {"type": "subtitle", "time": 1307.669, "timestamp": "00:21:47", "text": "あのね？ とりあえず、今は手に持っておこう"}, {"type": "subtitle", "time": 1309.59, "timestamp": "00:21:49", "text": "。   とりあえず今はこうやってやります"}, {"type": "subtitle", "time": 1312.47, "timestamp": "00:21:52", "text": "。 よし"}]
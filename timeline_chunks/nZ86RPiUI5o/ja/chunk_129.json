[{"type": "subtitle", "time": 7758.55, "timestamp": "02:09:18", "text": "え、何？ 待って、何が起こったの？ どう"}, {"type": "subtitle", "time": 7771.83, "timestamp": "02:09:31", "text": "おお。 ああ、フィードはあるけど、"}, {"type": "subtitle", "time": 7774.47, "timestamp": "02:09:34", "text": "ビデオがない。 そこには何もありませんでした。"}, {"type": "subtitle", "time": 7775.99, "timestamp": "02:09:35", "text": "待って。   ごめん"}, {"type": "subtitle", "time": 7785.589, "timestamp": "02:09:45", "text": "あ、すみません、表示が間違っていました。"}, {"type": "subtitle", "time": 7787.83, "timestamp": "02:09:47", "text": "あぁ、ああ"}, {"type": "subtitle", "time": 7790.95, "timestamp": "02:09:50", "text": "、まだ潜伏してるよ [笑い]"}, {"type": "subtitle", "time": 7795.43, "timestamp": "02:09:55", "text": "まだ見てるよ、例えば、"}, {"type": "subtitle", "time": 7798.229, "timestamp": "02:09:58", "text": "今はキック"}]
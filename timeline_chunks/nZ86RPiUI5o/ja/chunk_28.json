[{"type": "subtitle", "time": 1681.669, "timestamp": "00:28:01", "text": "カメラとマイクの入力を送って、将来的にスマホを使って"}, {"type": "subtitle", "time": 1684.149, "timestamp": "00:28:04", "text": "ストリーミングします。 ですから、"}, {"type": "subtitle", "time": 1690.549, "timestamp": "00:28:10", "text": "これは持ち続けるのが辛い。"}, {"type": "subtitle", "time": 1694.149, "timestamp": "00:28:14", "text": "三脚が"}, {"type": "subtitle", "time": 1697.75, "timestamp": "00:28:17", "text": "ぐらつくので、使えません。"}, {"type": "subtitle", "time": 1700.149, "timestamp": "00:28:20", "text": "手に持ってみると、より安定感があります。"}, {"type": "subtitle", "time": 1701.99, "timestamp": "00:28:21", "text": "ええ、間違いありません"}, {"type": "subtitle", "time": 1710.47, "timestamp": "00:28:30", "text": "皆さん、お元気ですか？ 生活やその他"}, {"type": "subtitle", "time": 1713.59, "timestamp": "00:28:33", "text": "諸々はどうですか？ 皆さんがまた元気で過ごされていることを願っています"}, {"type": "subtitle", "time": 1722.47, "timestamp": "00:28:42", "text": "。 私はこの"}, {"type": "subtitle", "time": 1725.909, "timestamp": "00:28:45", "text": "道で行けると思う。 左折してください。"}, {"type": "subtitle", "time": 1727.909, "timestamp": "00:28:47", "text": "この家を見てください。 レンガか"}, {"type": "subtitle", "time": 1730.23, "timestamp": "00:28:50", "text": "何かみたいだ。 でも、あれはただの紙の型紙みたいなものだと"}]
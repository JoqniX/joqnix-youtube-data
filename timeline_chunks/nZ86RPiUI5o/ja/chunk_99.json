[{"type": "subtitle", "time": 5940.55, "timestamp": "01:39:00", "text": "このこと覚えてる人いる？"}, {"type": "subtitle", "time": 5946.31, "timestamp": "01:39:06", "text": "このモデルをデビューさせる前の、以前のモデルのような最後の配信は"}, {"type": "subtitle", "time": 5948.709, "timestamp": "01:39:08", "text": "雨が降っていて、私は"}, {"type": "subtitle", "time": 5951.43, "timestamp": "01:39:11", "text": "子供のように雨の中で遊んでびしょ濡れになっていました"}, {"type": "subtitle", "time": 5955.43, "timestamp": "01:39:15", "text": "。 これはスライド式のものです。"}, {"type": "subtitle", "time": 5960.229, "timestamp": "01:39:20", "text": "ここは泥水でいっぱいだった。"}, {"type": "subtitle", "time": 5964.07, "timestamp": "01:39:24", "text": "奥行きが適切であることがお分かりいただけるでしょう。"}, {"type": "subtitle", "time": 5967.75, "timestamp": "01:39:27", "text": "うん。 私はそこへ来て、ここで倒れました。"}, {"type": "subtitle", "time": 5971.83, "timestamp": "01:39:31", "text": "スライダーがあそこに倒れた。"}, {"type": "subtitle", "time": 5975.99, "timestamp": "01:39:35", "text": "待って、銃を見つけたよ。 なんてこった？"}, {"type": "subtitle", "time": 5977.99, "timestamp": "01:39:37", "text": "待って、"}, {"type": "subtitle", "time": 5983.99, "timestamp": "01:39:43", "text": "なんてこった？"}, {"type": "subtitle", "time": 5987.91, "timestamp": "01:39:47", "text": "待って、誰かが、"}, {"type": "subtitle", "time": 5989.83, "timestamp": "01:39:49", "text": "待って、誰かがここに銃を置いたの"}, {"type": "subtitle", "time": 5999.43, "timestamp": "01:39:59", "text": "おいおい。 なあ、俺たち銃持ってるぜ。 それは"}]
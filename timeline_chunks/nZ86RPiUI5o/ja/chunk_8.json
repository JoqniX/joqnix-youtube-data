[{"type": "subtitle", "time": 492.07, "timestamp": "00:08:12", "text": "なぜ文字が機能しないのですか？ あれは何でしょう"}, {"type": "subtitle", "time": 502.869, "timestamp": "00:08:22", "text": "電力が復旧しました。 あ、こんにちは。 どうですか？"}, {"type": "subtitle", "time": 504.79, "timestamp": "00:08:24", "text": "音楽を聴きながら、のんびり"}, {"type": "subtitle", "time": 508.55, "timestamp": "00:08:28", "text": "過ごすのが好きです。 テキスト読み上げも聞こえるし、"}, {"type": "subtitle", "time": 514.63, "timestamp": "00:08:34", "text": "テキスト読み上げも"}, {"type": "subtitle", "time": 539.99, "timestamp": "00:08:59", "text": "ショーに戻ったら"}]
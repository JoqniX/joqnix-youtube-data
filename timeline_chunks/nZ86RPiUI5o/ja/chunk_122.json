[{"type": "subtitle", "time": 7334.229, "timestamp": "02:02:14", "text": "あなたはどこにいましたか？ まだここにいますか？それとも"}, {"type": "subtitle", "time": 7337.109, "timestamp": "02:02:17", "text": "眠ってしまいましたか？"}, {"type": "subtitle", "time": 7343.51, "timestamp": "02:02:23", "text": "フォーカスにはオートモードはありません。"}, {"type": "subtitle", "time": 7356.149, "timestamp": "02:02:36", "text": "ああ、フォーカスモードもオート"}, {"type": "subtitle", "time": 7359.109, "timestamp": "02:02:39", "text": "フォーカスモードもない。 しまった、"}, {"type": "subtitle", "time": 7362.47, "timestamp": "02:02:42", "text": "彼に伝えなきゃいけなかった。 ああ、"}, {"type": "subtitle", "time": 7365.83, "timestamp": "02:02:45", "text": "オートモードがないなんて。 なんてこった。"}, {"type": "subtitle", "time": 7368.47, "timestamp": "02:02:48", "text": "なるほど、露出は十分にある。 ああ、なんで"}, {"type": "subtitle", "time": 7372.87, "timestamp": "02:02:52", "text": "クリックしちゃったんだろう？ いいえ。ああ、マニュアルですね。 待って、私は"}, {"type": "subtitle", "time": 7375.189, "timestamp": "02:02:55", "text": "震える。 ああ、くそ。 ああ、いや、いや、いや、いや、いや、"}, {"type": "subtitle", "time": 7376.79, "timestamp": "02:02:56", "text": "いや。"}, {"type": "subtitle", "time": 7378.709, "timestamp": "02:02:58", "text": "なぜ私はそんなことをしたのか？ いや、いや、いや。"}]
[{"type": "subtitle", "time": 6366.47, "timestamp": "01:46:06", "text": "いいえ。 私は安全だと思います。   わかりました"}, {"type": "subtitle", "time": 6372.87, "timestamp": "01:46:12", "text": "。 三脚をポケットに入れましょう。"}, {"type": "subtitle", "time": 6383.03, "timestamp": "01:46:23", "text": "こんにちは。 今すぐ見せてください。"}, {"type": "subtitle", "time": 6385.83, "timestamp": "01:46:25", "text": "よし、やろう。"}, {"type": "subtitle", "time": 6402.47, "timestamp": "01:46:42", "text": "私自身が恥をかきたくないんです。"}, {"type": "subtitle", "time": 6408.31, "timestamp": "01:46:48", "text": "人形を連れて歩いている人とかはいないよね？ なぜ私はこんにちは。"}, {"type": "subtitle", "time": 6411.51, "timestamp": "01:46:51", "text": "３、２、１。   何てことだ"}, {"type": "subtitle", "time": 6416.709, "timestamp": "01:46:56", "text": "。 何てことだ。 何てことだ。"}, {"type": "subtitle", "time": 6419.063, "timestamp": "01:46:59", "text": "ああ、くそ。"}]
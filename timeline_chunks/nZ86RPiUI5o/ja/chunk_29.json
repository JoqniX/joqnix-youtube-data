[{"type": "subtitle", "time": 1746.95, "timestamp": "00:29:06", "text": "では、私たちは"}, {"type": "subtitle", "time": 1750.87, "timestamp": "00:29:10", "text": "アオキノイリというスーパーマーケットに行きます。"}, {"type": "subtitle", "time": 1753.19, "timestamp": "00:29:13", "text": "名前からして薬局だと言えるかもしれませんが、"}, {"type": "subtitle", "time": 1757.669, "timestamp": "00:29:17", "text": "この店には何でも揃っています。"}, {"type": "subtitle", "time": 1761.029, "timestamp": "00:29:21", "text": "文字通りスーパーマーケットです。"}, {"type": "subtitle", "time": 1770.149, "timestamp": "00:29:30", "text": "ええ、"}, {"type": "subtitle", "time": 1773.909, "timestamp": "00:29:33", "text": "冬なので日没は5時半です。 いいえ、"}, {"type": "subtitle", "time": 1776.389, "timestamp": "00:29:36", "text": "冬になりますよ。 いいえ、"}, {"type": "subtitle", "time": 1779.669, "timestamp": "00:29:39", "text": "秋なので、"}, {"type": "subtitle", "time": 1785.029, "timestamp": "00:29:45", "text": "日没が早く、"}, {"type": "subtitle", "time": 1789.11, "timestamp": "00:29:49", "text": "日の出も少し早いと思います。"}, {"type": "subtitle", "time": 1791.83, "timestamp": "00:29:51", "text": "うん。 うん。 うん。 日の出は早朝、例えば"}, {"type": "subtitle", "time": 1794.23, "timestamp": "00:29:54", "text": "午前6時頃のこともあります。これは午前"}, {"type": "subtitle", "time": 1796.789, "timestamp": "00:29:56", "text": "10時頃のように見えます。"}]
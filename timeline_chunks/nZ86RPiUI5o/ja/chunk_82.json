[{"type": "subtitle", "time": 4924.31, "timestamp": "01:22:04", "text": "そうそう。  70の任務。 そこで待っていてください。"}, {"type": "subtitle", "time": 4927.91, "timestamp": "01:22:07", "text": "えっと、ここにカメラのズーム機能がないんです。   何てことだ"}, {"type": "subtitle", "time": 4930.79, "timestamp": "01:22:10", "text": "。"}, {"type": "subtitle", "time": 4934.229, "timestamp": "01:22:14", "text": "カメラのズーム。"}, {"type": "subtitle", "time": 4940.629, "timestamp": "01:22:20", "text": "うん。 待って、どうやって「ああ、そうだ」を使うの？"}, {"type": "subtitle", "time": 4944.07, "timestamp": "01:22:24", "text": "角度を変える方法はないんですよね？   よし"}, {"type": "subtitle", "time": 4947.59, "timestamp": "01:22:27", "text": "。 モンスター"}, {"type": "subtitle", "time": 4950.229, "timestamp": "01:22:30", "text": "パンダ、コカ・コーラ"}, {"type": "subtitle", "time": 4954.149, "timestamp": "01:22:34", "text": "アクアレス、スポーツドリンクのコーク、"}, {"type": "subtitle", "time": 4958.55, "timestamp": "01:22:38", "text": "緑茶、水、ミニッツメイドのブドウ、コーヒー、コーヒー、その他すべて"}, {"type": "subtitle", "time": 4965.59, "timestamp": "01:22:45", "text": "コーヒー、"}, {"type": "subtitle", "time": 4970.07, "timestamp": "01:22:50", "text": "同じコーヒー、コーヒー、コーヒーラテ、"}, {"type": "subtitle", "time": 4972.07, "timestamp": "01:22:52", "text": "文字通り"}, {"type": "subtitle", "time": 4973.59, "timestamp": "01:22:53", "text": "チャイ、エナジー"}, {"type": "subtitle", "time": 4977.51, "timestamp": "01:22:57", "text": "ドリンク、エナジードリンク、ビーチなどと言えます"}]
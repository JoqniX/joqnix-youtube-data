[{"type": "subtitle", "time": 7201.51, "timestamp": "02:00:01", "text": "公園にいます"}, {"type": "subtitle", "time": 7208.229, "timestamp": "02:00:08", "text": "。 わかった。"}, {"type": "subtitle", "time": 7219.27, "timestamp": "02:00:19", "text": "9090. 何が起こっているのですか？"}, {"type": "subtitle", "time": 7222.31, "timestamp": "02:00:22", "text": "ここでは、私の音楽の趣味は変わっていると言われる"}, {"type": "subtitle", "time": 7230.39, "timestamp": "02:00:30", "text": "えっと、"}, {"type": "subtitle", "time": 7232.95, "timestamp": "02:00:32", "text": "J-POPとかそういうやつ。 うん、じゃあ私たちは"}, {"type": "subtitle", "time": 7235.99, "timestamp": "02:00:35", "text": "似ているね。  J-POPとかもよく聴きます"}, {"type": "subtitle", "time": 7238.39, "timestamp": "02:00:38", "text": "。 昔はEDMの大"}, {"type": "subtitle", "time": 7240.31, "timestamp": "02:00:40", "text": "ファンだったんです"}, {"type": "subtitle", "time": 7243.03, "timestamp": "02:00:43", "text": "。 幼い頃、EDMを聴いたことがきっかけで"}, {"type": "subtitle", "time": 7245.99, "timestamp": "02:00:45", "text": "音楽に興味を持ち、音楽制作"}, {"type": "subtitle", "time": 7248.55, "timestamp": "02:00:48", "text": "などに興味を持つようになったんです。"}, {"type": "subtitle", "time": 7251.189, "timestamp": "02:00:51", "text": "えっと、10歳くらいかな。"}, {"type": "subtitle", "time": 7255.27, "timestamp": "02:00:55", "text": "時間がほとんどない。 そう、"}, {"type": "subtitle", "time": 7259.99, "timestamp": "02:00:59", "text": "そのくらいの年齢で音楽制作を始めたんだ。  10回、11回、12"}]
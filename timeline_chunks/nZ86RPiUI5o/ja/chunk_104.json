[{"type": "subtitle", "time": 6247.35, "timestamp": "01:44:07", "text": "ええ、わかっています。   というわけで、そういうことだ"}, {"type": "subtitle", "time": 6249.35, "timestamp": "01:44:09", "text": "。 では、どちらが良いアイデアでしょうか？"}, {"type": "subtitle", "time": 6252.39, "timestamp": "01:44:12", "text": "私はただ「FLが欲しいですか？」と尋ねるべきでしょうか？ 待って、"}, {"type": "subtitle", "time": 6255.109, "timestamp": "01:44:15", "text": "フラッシュをオフにできるよ。"}, {"type": "subtitle", "time": 6257.43, "timestamp": "01:44:17", "text": "電話をどこかに隠しておけば、"}, {"type": "subtitle", "time": 6260.87, "timestamp": "01:44:20", "text": "あなたは私を見つけることはできないでしょう。 それとも、私と"}, {"type": "subtitle", "time": 6264.229, "timestamp": "01:44:24", "text": "一緒に行きたいですか？ お好みの毒をお選びください。"}, {"type": "subtitle", "time": 6268.149, "timestamp": "01:44:28", "text": "ミナ、毒じゃないけど、そうね。"}, {"type": "subtitle", "time": 6270.629, "timestamp": "01:44:30", "text": "フラッシュがないと、まるで暗闇のようだ。 誰もそれが"}, {"type": "subtitle", "time": 6273.83, "timestamp": "01:44:33", "text": "私だと気づかない。"}, {"type": "subtitle", "time": 6277.669, "timestamp": "01:44:37", "text": "ここに三脚を置けるかな。"}, {"type": "subtitle", "time": 6280.87, "timestamp": "01:44:40", "text": "地面に埋めることができるように。"}, {"type": "subtitle", "time": 6283.03, "timestamp": "01:44:43", "text": "地面に埋めることができます。 もしかしたら、"}, {"type": "subtitle", "time": 6288.149, "timestamp": "01:44:48", "text": "私が実際にそれをやっているところを見られるかもしれませんよ。"}, {"type": "subtitle", "time": 6290.47, "timestamp": "01:44:50", "text": "2つのことをしましょう。 わかった。 待って。"}, {"type": "subtitle", "time": 6293.35, "timestamp": "01:44:53", "text": "Flashの場合はどうでしょうか？"}, {"type": "subtitle", "time": 6296.79, "timestamp": "01:44:56", "text": "待って。  Flashの場合はどうでしょうか？"}]
[{"type": "subtitle", "time": 180.55, "timestamp": "00:03:00", "text": "？"}, {"type": "subtitle", "time": 182.71, "timestamp": "00:03:02", "text": "ボタンを押します。"}, {"type": "subtitle", "time": 184.309, "timestamp": "00:03:04", "text": "うん、"}, {"type": "subtitle", "time": 186.63, "timestamp": "00:03:06", "text": "ボタンを押すよ。"}, {"type": "subtitle", "time": 201.27, "timestamp": "00:03:21", "text": "ありがとうございます。"}, {"type": "subtitle", "time": 205.43, "timestamp": "00:03:25", "text": "ええ、そうですね。 ええ、（笑い）"}, {"type": "subtitle", "time": 207.75, "timestamp": "00:03:27", "text": "皆さんに私の声がよく聞こえているといいのですが。 わかりました、"}, {"type": "subtitle", "time": 210.247, "timestamp": "00:03:30", "text": "チャットで、私の声が"}, {"type": "subtitle", "time": 213.11, "timestamp": "00:03:33", "text": "遅延なく聞こえるかどうか教えてください。[音楽] 配信が途切れたり、何か問題が発生した場合は、"}, {"type": "subtitle", "time": 216.949, "timestamp": "00:03:36", "text": "必ず"}, {"type": "subtitle", "time": 221.27, "timestamp": "00:03:41", "text": "教えてくださいね。 そうすれば、"}, {"type": "subtitle", "time": 224.47, "timestamp": "00:03:44", "text": "私の配信が衰退しているのか、あなたの配信が"}, {"type": "subtitle", "time": 227.589, "timestamp": "00:03:47", "text": "衰退しているのか、あるいは何か別の問題が起きているのかが分かります。 わかった、そうしないで"}, {"type": "subtitle", "time": 230.552, "timestamp": "00:03:50", "text": "。"}, {"type": "subtitle", "time": 231.35, "timestamp": "00:03:51", "text": "[音楽]"}, {"type": "subtitle", "time": 232.869, "timestamp": "00:03:52", "text": "ああ、まだ"}, {"type": "subtitle", "time": 236.149, "timestamp": "00:03:56", "text": "生きてることを願っています。"}, {"type": "subtitle", "time": 238.949, "timestamp": "00:03:58", "text": "ええと、音声だけのものにはならないということですね"}]
[{"type": "subtitle", "time": 4981.35, "timestamp": "01:23:01", "text": "。"}, {"type": "subtitle", "time": 4985.189, "timestamp": "01:23:05", "text": "TTウォータースポーツ。"}, {"type": "subtitle", "time": 4989.43, "timestamp": "01:23:09", "text": "モンスターサイダーは実際にはソーダだから。 それはまるで"}, {"type": "subtitle", "time": 4993.75, "timestamp": "01:23:13", "text": "触手の水のようなものだ。 カルプス水。"}, {"type": "subtitle", "time": 4996.55, "timestamp": "01:23:16", "text": "うん。"}, {"type": "subtitle", "time": 4998.95, "timestamp": "01:23:18", "text": "それでは、公園に行きましょう。 わかった。 あの"}, {"type": "subtitle", "time": 5000.47, "timestamp": "01:23:20", "text": "公園に行ったのはずいぶん前のことだよ"}, {"type": "subtitle", "time": 5001.91, "timestamp": "01:23:21", "text": "。"}, {"type": "subtitle", "time": 5005.03, "timestamp": "01:23:25", "text": "あ、今あそこに猫を見かけたよ。 ああ、"}, {"type": "subtitle", "time": 5008.31, "timestamp": "01:23:28", "text": "見て。 犬がいる。"}, {"type": "subtitle", "time": 5012.79, "timestamp": "01:23:32", "text": "えっと、RGB付きの犬。"}, {"type": "subtitle", "time": 5015.91, "timestamp": "01:23:35", "text": "きちんと見えていないんです。"}, {"type": "subtitle", "time": 5020.79, "timestamp": "01:23:40", "text": "ズームアウトしない方がいいだろう。"}, {"type": "subtitle", "time": 5033.83, "timestamp": "01:23:53", "text": "うん。 公園に行くんだ。 もう"}, {"type": "subtitle", "time": 5036.229, "timestamp": "01:23:56", "text": "夜になるよ。"}]
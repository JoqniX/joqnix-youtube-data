[{"type": "subtitle", "time": 6601.27, "timestamp": "01:50:01", "text": "知りませんでした。 後になってクラスメートの"}, {"type": "subtitle", "time": 6603.83, "timestamp": "01:50:03", "text": "インスタグラムの"}, {"type": "subtitle", "time": 6607.43, "timestamp": "01:50:07", "text": "ストーリーを見て知ったんだけど、一体どういうこと？って思ったよ。"}, {"type": "subtitle", "time": 6610.39, "timestamp": "01:50:10", "text": "お祭りがあるなんて誰も教えてくれなかった。 私だったら、"}, {"type": "subtitle", "time": 6617.83, "timestamp": "01:50:17", "text": "全部ライブ配信してVlogを撮っていたでしょうね。 私は"}, {"type": "subtitle", "time": 6621.109, "timestamp": "01:50:21", "text": "そこにいる人たちのことを全く知らなかった。"}, {"type": "subtitle", "time": 6623.35, "timestamp": "01:50:23", "text": "お祭りがあるなんて誰も教えてくれなかった。"}, {"type": "subtitle", "time": 6626.47, "timestamp": "01:50:26", "text": "とても申し訳ない気持ちになった。"}, {"type": "subtitle", "time": 6630.79, "timestamp": "01:50:30", "text": "フェスティバルに参加して、"}, {"type": "subtitle", "time": 6634.229, "timestamp": "01:50:34", "text": "皆さんにいろいろなものを見せたり、どんな感じなのかを教えてあげられたら、本当に良かったのに"}, {"type": "subtitle", "time": 6641.03, "timestamp": "01:50:41", "text": "。"}]
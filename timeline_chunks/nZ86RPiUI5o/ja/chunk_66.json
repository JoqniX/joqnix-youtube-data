[{"type": "subtitle", "time": 3961.51, "timestamp": "01:06:01", "text": "電話をどこかに置いて、皆さんと歩きながら話そうと思ったからです"}, {"type": "subtitle", "time": 3968.71, "timestamp": "01:06:08", "text": "私はいつでも携帯電話を持ち歩くことができます。"}, {"type": "subtitle", "time": 3975.19, "timestamp": "01:06:15", "text": "このワイヤレスマイクのセットアップの良いところは、"}, {"type": "subtitle", "time": 3984.309, "timestamp": "01:06:24", "text": "Bluetoothイヤホンが"}, {"type": "subtitle", "time": 3985.91, "timestamp": "01:06:25", "text": "接続されている限り、どこへでも歩き回って音声を聞くことができる点です。   まだ何か音が"}, {"type": "subtitle", "time": 3989.19, "timestamp": "01:06:29", "text": "聞こえる。"}, {"type": "subtitle", "time": 3992.71, "timestamp": "01:06:32", "text": "持続する。 あぁ、新しい"}, {"type": "subtitle", "time": 3995.109, "timestamp": "01:06:35", "text": "チャット機能を入れるのを忘れてた。"}, {"type": "subtitle", "time": 3999.109, "timestamp": "01:06:39", "text": "あ、新しいチャットURLを載せるのを忘れてた。"}, {"type": "subtitle", "time": 4001.589, "timestamp": "01:06:41", "text": "待って、今はそんなことはできないよ。   はい"}, {"type": "subtitle", "time": 4009.75, "timestamp": "01:06:49", "text": "。 新しいチャットを追加するのを忘れていました"}]
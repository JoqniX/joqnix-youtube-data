[{"type": "subtitle", "time": 8946.469, "timestamp": "02:29:06", "text": "ああ、わかった。スマホのバッテリーが切れた。スマホのバッテリーが"}, {"type": "subtitle", "time": 8954.15, "timestamp": "02:29:14", "text": "ええ、つまり、ここで配信を終了します"}, {"type": "subtitle", "time": 8956.309, "timestamp": "02:29:16", "text": "。よし、"}, {"type": "subtitle", "time": 8964.55, "timestamp": "02:29:24", "text": "。"}, {"type": "subtitle", "time": 8968.07, "timestamp": "02:29:28", "text": "こんにちは、ソーラー。こんにちは、ブラッド。"}, {"type": "subtitle", "time": 8970.79, "timestamp": "02:29:30", "text": "えーと、"}, {"type": "subtitle", "time": 8973.19, "timestamp": "02:29:33", "text": "ちょっと待って。ちょっと待って"}, {"type": "subtitle", "time": 8976.07, "timestamp": "02:29:36", "text": "。少し時間をください。大丈夫です"}, {"type": "subtitle", "time": 8979.83, "timestamp": "02:29:39", "text": "。わかりました。ええ。ええ。携帯のバッテリーが切れたので、"}, {"type": "subtitle", "time": 8983.19, "timestamp": "02:29:43", "text": "走って家に帰りました。PCを使っています。それで、"}, {"type": "subtitle", "time": 8985.91, "timestamp": "02:29:45", "text": "ええ。新しい配信をスケジュールします。ええと、午後"}, {"type": "subtitle", "time": 8990.63, "timestamp": "02:29:50", "text": "9時30分か"}, {"type": "subtitle", "time": 8997.75, "timestamp": "02:29:57", "text": "日本時間）にライブ配信します。ええと、"}]
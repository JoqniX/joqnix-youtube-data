[{"type": "subtitle", "time": 3541.99, "timestamp": "00:59:01", "text": "[咳払い] 私の担当は"}, {"type": "subtitle", "time": 3543.829, "timestamp": "00:59:03", "text": "ストリーミング中は滞在しません。   つまり、"}, {"type": "subtitle", "time": 3546.309, "timestamp": "00:59:06", "text": "痛みだ。 超高速"}, {"type": "subtitle", "time": 3548.309, "timestamp": "00:59:08", "text": "充電器を買わないといけない。"}, {"type": "subtitle", "time": 3554.87, "timestamp": "00:59:14", "text": "終わりです。"}]
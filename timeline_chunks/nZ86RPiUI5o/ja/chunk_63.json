[{"type": "subtitle", "time": 3781.19, "timestamp": "01:03:01", "text": "私はこのような配信はできません。  [鼻を鳴らす]"}, {"type": "subtitle", "time": 3785.43, "timestamp": "01:03:05", "text": "買ったモバイルバッテリーは100Wなのに、"}, {"type": "subtitle", "time": 3789.67, "timestamp": "01:03:09", "text": "超高速のSam"}, {"type": "subtitle", "time": 3792.87, "timestamp": "01:03:12", "text": "急速充電2.0は使えない。"}, {"type": "subtitle", "time": 3795.51, "timestamp": "01:03:15", "text": "サムスンの超高速充電。"}, {"type": "subtitle", "time": 3799.033, "timestamp": "01:03:19", "text": "残念ながら、それは手に入りません。"}, {"type": "subtitle", "time": 3799.109, "timestamp": "01:03:19", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 3801.67, "timestamp": "01:03:21", "text": "それは非常に悪い、"}, {"type": "subtitle", "time": 3804.273, "timestamp": "01:03:24", "text": "特に悪い。"}, {"type": "subtitle", "time": 3805.27, "timestamp": "01:03:25", "text": "[笑い]"}, {"type": "subtitle", "time": 3808.789, "timestamp": "01:03:28", "text": "よし、三脚を持っているから、"}, {"type": "subtitle", "time": 3811.478, "timestamp": "01:03:31", "text": "三脚を持って行けるよ。"}, {"type": "subtitle", "time": 3820.309, "timestamp": "01:03:40", "text": "わかった、それから"}, {"type": "subtitle", "time": 3824.549, "timestamp": "01:03:44", "text": "自転車のロックを元に戻して。"}, {"type": "subtitle", "time": 3827.75, "timestamp": "01:03:47", "text": "よし、三脚は持っていかないことにしよう"}, {"type": "subtitle", "time": 3829.818, "timestamp": "01:03:49", "text": "。"}, {"type": "subtitle", "time": 3833.589, "timestamp": "01:03:53", "text": "えーと、"}]
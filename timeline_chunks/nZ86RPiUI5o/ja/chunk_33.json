[{"type": "subtitle", "time": 1980.31, "timestamp": "00:33:00", "text": "。 これが問題なんです。 これが、"}, {"type": "subtitle", "time": 1983.75, "timestamp": "00:33:03", "text": "そこにあるタイヤの様子です。 静寂に包まれている。   というわけで"}, {"type": "subtitle", "time": 1987.11, "timestamp": "00:33:07", "text": "、サイクルコインはロックされて"}, {"type": "subtitle", "time": 1990.95, "timestamp": "00:33:10", "text": "安全なので、買い物に行きます。"}, {"type": "subtitle", "time": 1998.71, "timestamp": "00:33:18", "text": "それ以外にも、反射する場所には気をつけなければならない。 それは"}, {"type": "subtitle", "time": 2008.789, "timestamp": "00:33:28", "text": "たくさんの商品がありますね（笑）"}, {"type": "subtitle", "time": 2012.71, "timestamp": "00:33:32", "text": "。 これらは櫛とかそういう類のものです。"}, {"type": "subtitle", "time": 2015.909, "timestamp": "00:33:35", "text": "これらは石鹸製品だと思います。"}, {"type": "subtitle", "time": 2018.63, "timestamp": "00:33:38", "text": "石鹸とかそういうもの。 ええ、これもバイオ石鹸です"}, {"type": "subtitle", "time": 2022.23, "timestamp": "00:33:42", "text": "。 これらは、えーと、手洗い用のものです"}, {"type": "subtitle", "time": 2023.83, "timestamp": "00:33:43", "text": "。"}, {"type": "subtitle", "time": 2026.95, "timestamp": "00:33:46", "text": "それで、私たちはこの"}, {"type": "subtitle", "time": 2030.549, "timestamp": "00:33:50", "text": "男を探しに行くことにした。 私たちはこの男を探し出すつもりだ。"}, {"type": "subtitle", "time": 2032.789, "timestamp": "00:33:52", "text": "フライドチキン。"}, {"type": "subtitle", "time": 2036.549, "timestamp": "00:33:56", "text": "だから、私たちはその男を探しているんです。 ああ、くそ。"}, {"type": "subtitle", "time": 2039.909, "timestamp": "00:33:59", "text": "ああ、くそ。 待って。 えっと、"}]
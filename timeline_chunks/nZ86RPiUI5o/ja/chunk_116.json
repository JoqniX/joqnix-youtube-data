[{"type": "subtitle", "time": 6966.07, "timestamp": "01:56:06", "text": "アドが"}, {"type": "subtitle", "time": 6968.629, "timestamp": "01:56:08", "text": "ボーカルエフェクトを使うときの歌い方や効果を真似したり使ったりしているように見えましたよね？ 彼女が"}, {"type": "subtitle", "time": 6971.43, "timestamp": "01:56:11", "text": "唸り声とかそういうのを歌うとき、"}, {"type": "subtitle", "time": 6975.91, "timestamp": "01:56:15", "text": "ウェブロのやつ、そういうの全部。"}, {"type": "subtitle", "time": 6978.709, "timestamp": "01:56:18", "text": "うん。 そして、インストラクターか"}, {"type": "subtitle", "time": 6981.589, "timestamp": "01:56:21", "text": "先生は本当に驚いていて、"}, {"type": "subtitle", "time": 6984.55, "timestamp": "01:56:24", "text": "彼女は「そうよ、頑張って」と言った。 それで、"}, {"type": "subtitle", "time": 6987.27, "timestamp": "01:56:27", "text": "すごく良かったし、それで、"}, {"type": "subtitle", "time": 7001.109, "timestamp": "01:56:41", "text": "その女の子は、"}, {"type": "subtitle", "time": 7005.109, "timestamp": "01:56:45", "text": "アドのアイドルグループに入りたいと言ったんです。"}, {"type": "subtitle", "time": 7007.669, "timestamp": "01:56:47", "text": "彼女自身のユニットを作ったわけじゃないよね？"}, {"type": "subtitle", "time": 7011.109, "timestamp": "01:56:51", "text": "練習生や"}, {"type": "subtitle", "time": 7015.589, "timestamp": "01:56:55", "text": "新人アイドルの女の子たちが所属するグループユニットのようなもので、彼女の"}, {"type": "subtitle", "time": 7019.51, "timestamp": "01:56:59", "text": "レーベルに所属しているとか、ユニットのようなものですね。 うん。 うん。 うん。"}]
[{"type": "subtitle", "time": 8581.03, "timestamp": "02:23:01", "text": "鏡があったんだ。いや、"}, {"type": "subtitle", "time": 8584.87, "timestamp": "02:23:04", "text": "ガラスの反射鏡みたいなものがあったんだ。"}, {"type": "subtitle", "time": 8588.87, "timestamp": "02:23:08", "text": "見えなかった？よかった、神様ありがとう。"}, {"type": "subtitle", "time": 8596.71, "timestamp": "02:23:16", "text": "行く道。見えなくてよかった"}, {"type": "subtitle", "time": 8607.67, "timestamp": "02:23:27", "text": "うん、ここはスキア。"}, {"type": "subtitle", "time": 8610.87, "timestamp": "02:23:30", "text": "ここでは安い食べ物が食べられる。"}, {"type": "subtitle", "time": 8619.11, "timestamp": "02:23:39", "text": "うん、あそこのタブレットでテーブルから注文するんだ"}, {"type": "subtitle", "time": 8626.87, "timestamp": "02:23:46", "text": "えっと、"}, {"type": "subtitle", "time": 8630.389, "timestamp": "02:23:50", "text": "みんな、充電が3%しかない。"}, {"type": "subtitle", "time": 8632.469, "timestamp": "02:23:52", "text": "走って家に帰らなきゃ。"}, {"type": "subtitle", "time": 8636.309, "timestamp": "02:23:56", "text": "ああ、なんてことだ。本当に走らなきゃいけない。これは"}, {"type": "subtitle", "time": 8638.07, "timestamp": "02:23:58", "text": "まずい。"}]
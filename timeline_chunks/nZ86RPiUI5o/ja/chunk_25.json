[{"type": "subtitle", "time": 1502.07, "timestamp": "00:25:02", "text": "過去が過ぎたので、参加するのは少し気まずい。"}, {"type": "subtitle", "time": 1516.23, "timestamp": "00:25:16", "text": "はい。 これは私の自転車です。"}, {"type": "subtitle", "time": 1519.909, "timestamp": "00:25:19", "text": "始まりが見えますか？ これは私が新しく買った自転車です。というのも、"}, {"type": "subtitle", "time": 1526.63, "timestamp": "00:25:26", "text": "7000円で買った通学用の自転車が、鍵をかけ忘れたせいで盗まれてしまったからです"}, {"type": "subtitle", "time": 1528.47, "timestamp": "00:25:28", "text": "。"}, {"type": "subtitle", "time": 1548.39, "timestamp": "00:25:48", "text": "問題は、今度はあの場所"}, {"type": "subtitle", "time": 1551.59, "timestamp": "00:25:51", "text": "から渡らなければならないということです。 左から右に"}, {"type": "subtitle", "time": 1554.549, "timestamp": "00:25:54", "text": "車がいない場合は、そのまま"}]
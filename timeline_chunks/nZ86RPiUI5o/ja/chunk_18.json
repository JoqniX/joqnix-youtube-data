[{"type": "subtitle", "time": 1081.83, "timestamp": "00:18:01", "text": "でも、待って、"}, {"type": "subtitle", "time": 1084.15, "timestamp": "00:18:04", "text": "設定をオンにして、"}, {"type": "subtitle", "time": 1087.75, "timestamp": "00:18:07", "text": "スタビライザーをオンにすることができます"}, {"type": "subtitle", "time": 1092.542, "timestamp": "00:18:12", "text": "。 ああ、始まった。 こんにちは、誰か。"}, {"type": "subtitle", "time": 1093.19, "timestamp": "00:18:13", "text": "[鼻を鳴らす] では"}, {"type": "subtitle", "time": 1095.43, "timestamp": "00:18:15", "text": "、この後、デスクトップ"}, {"type": "subtitle", "time": 1097.75, "timestamp": "00:18:17", "text": "ストリームを配信します。"}, {"type": "subtitle", "time": 1101.11, "timestamp": "00:18:21", "text": "ああ、くそ。 忘れていました。"}, {"type": "subtitle", "time": 1104.23, "timestamp": "00:18:24", "text": "ショーには反射がありません。"}, {"type": "subtitle", "time": 1107.83, "timestamp": "00:18:27", "text": "でも、自分の個人情報を晒したくはないんです。"}, {"type": "subtitle", "time": 1130.87, "timestamp": "00:18:50", "text": "。 さあ、行こう。"}, {"type": "subtitle", "time": 1133.11, "timestamp": "00:18:53", "text": "急がなければならない。 急がなければならない。"}, {"type": "subtitle", "time": 1139.59, "timestamp": "00:18:59", "text": "もちろん。"}]
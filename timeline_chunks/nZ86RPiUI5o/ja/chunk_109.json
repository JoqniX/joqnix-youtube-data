[{"type": "subtitle", "time": 6541.91, "timestamp": "01:49:01", "text": "。フラッシュは使用していません。 わかった。"}, {"type": "subtitle", "time": 6544.79, "timestamp": "01:49:04", "text": "３、２、１。   何てことだ"}, {"type": "subtitle", "time": 6553.995, "timestamp": "01:49:13", "text": "ああ、くそ。 ああ、私の三脚。"}, {"type": "subtitle", "time": 6557.27, "timestamp": "01:49:17", "text": "[鼻を鳴らす] 三脚が動く。"}, {"type": "subtitle", "time": 6559.235, "timestamp": "01:49:19", "text": "[ため息]"}, {"type": "subtitle", "time": 6559.91, "timestamp": "01:49:19", "text": "[笑い声]"}, {"type": "subtitle", "time": 6562.709, "timestamp": "01:49:22", "text": "よかった。"}, {"type": "subtitle", "time": 6564.87, "timestamp": "01:49:24", "text": "ミナ。"}, {"type": "subtitle", "time": 6571.83, "timestamp": "01:49:31", "text": "手が痛い。   そうだったかな"}, {"type": "subtitle", "time": 6573.669, "timestamp": "01:49:33", "text": "？"}, {"type": "subtitle", "time": 6583.75, "timestamp": "01:49:43", "text": "チャン、この石を見てごらん。 なぜそうなっているのか"}, {"type": "subtitle", "time": 6585.91, "timestamp": "01:49:45", "text": "？"}, {"type": "subtitle", "time": 6593.35, "timestamp": "01:49:53", "text": "ええ、どうやら"}, {"type": "subtitle", "time": 6597.43, "timestamp": "01:49:57", "text": "日曜日に地元の祭りがあったみたいです。"}]
[{"type": "subtitle", "time": 5108.149, "timestamp": "01:25:08", "text": "ここは本当に素敵な場所だ。 私が経験したあの"}, {"type": "subtitle", "time": 5111.189, "timestamp": "01:25:11", "text": "恐ろしい出来事を覚えていますか？ そこがその場所です。"}, {"type": "subtitle", "time": 5113.43, "timestamp": "01:25:13", "text": "恐怖の場所。"}, {"type": "subtitle", "time": 5117.27, "timestamp": "01:25:17", "text": "もし行きたければ行けるんだけど、"}, {"type": "subtitle", "time": 5120.709, "timestamp": "01:25:20", "text": "10時か9時頃に配信があるから、"}, {"type": "subtitle", "time": 5123.99, "timestamp": "01:25:23", "text": "夕食を食べた後"}, {"type": "subtitle", "time": 5126.31, "timestamp": "01:25:26", "text": "すぐに"}, {"type": "subtitle", "time": 5147.59, "timestamp": "01:25:47", "text": "でも、よかったよ。   良かったよ"}, {"type": "subtitle", "time": 5151.83, "timestamp": "01:25:51", "text": "。 私はたくさんのことを経験しましたが、"}, {"type": "subtitle", "time": 5157.03, "timestamp": "01:25:57", "text": "Ballaxの"}]
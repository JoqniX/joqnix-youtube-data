[{"type": "subtitle", "time": 6784.31, "timestamp": "01:53:04", "text": "このダムの近くの大きな川、"}, {"type": "subtitle", "time": 6787.43, "timestamp": "01:53:07", "text": "海じゃなくて川の中に入って遊べたかもしれないね。"}, {"type": "subtitle", "time": 6791.669, "timestamp": "01:53:11", "text": "えっと、水だよ、滝じゃなくて、川だよ。 ええ、"}, {"type": "subtitle", "time": 6794.149, "timestamp": "01:53:14", "text": "水に落ちてしまう可能性もあったけど、"}, {"type": "subtitle", "time": 6796.629, "timestamp": "01:53:16", "text": "ええ、ええ、"}, {"type": "subtitle", "time": 6801.27, "timestamp": "01:53:21", "text": "さっき言ってたけど、"}, {"type": "subtitle", "time": 6804.07, "timestamp": "01:53:24", "text": "そういうことですよね？ それで、"}, {"type": "subtitle", "time": 6808.55, "timestamp": "01:53:28", "text": "東京のオープンキャンパスに参加しに行ったのですが、"}, {"type": "subtitle", "time": 6813.91, "timestamp": "01:53:33", "text": "ああ、海ではなく川のような海でした。"}, {"type": "subtitle", "time": 6817.109, "timestamp": "01:53:37", "text": "川ではなく、川と言ってもいいですよ。"}, {"type": "subtitle", "time": 6820.55, "timestamp": "01:53:40", "text": "うん。 それで、"}, {"type": "subtitle", "time": 6822.87, "timestamp": "01:53:42", "text": "オープンキャンパスみたいなイベントに参加して、"}, {"type": "subtitle", "time": 6827.51, "timestamp": "01:53:47", "text": "歌のボーカルレッスンみたいな体験"}, {"type": "subtitle", "time": 6832.55, "timestamp": "01:53:52", "text": "レッスンに参加したんだけど、"}, {"type": "subtitle", "time": 6835.83, "timestamp": "01:53:55", "text": "ジェイ・Kのファッションの"}, {"type": "subtitle", "time": 6839.83, "timestamp": "01:53:59", "text": "輝きがあったんだ。 ジェリッチのファッションって知ってる？   ちょっと"}]
[{"type": "subtitle", "time": 7800.229, "timestamp": "02:10:00", "text": "アカウントのレベルを上げようとしてるんだ。 それで、私は"}, {"type": "subtitle", "time": 7803.43, "timestamp": "02:10:03", "text": "アサンゴの24時間365日配信チャンネルを見ています。"}, {"type": "subtitle", "time": 7806.79, "timestamp": "02:10:06", "text": "このPCの電源を切ってから、えっと、これは"}, {"type": "subtitle", "time": 7810.31, "timestamp": "02:10:10", "text": "ひどい音でした。 うん。"}, {"type": "subtitle", "time": 7814.39, "timestamp": "02:10:14", "text": "あ、待って。 では、私がやってみましょう。"}, {"type": "subtitle", "time": 7816.149, "timestamp": "02:10:16", "text": "心配しないで。 ミュートにした。 心配しないで。 ごめん。   ごめん"}, {"type": "subtitle", "time": 7819.03, "timestamp": "02:10:19", "text": "。"}, {"type": "subtitle", "time": 7822.629, "timestamp": "02:10:22", "text": "うん。 今すぐ私のPCを操作させてください。"}, {"type": "subtitle", "time": 7825.189, "timestamp": "02:10:25", "text": "ここ"}, {"type": "subtitle", "time": 7827.83, "timestamp": "02:10:27", "text": "数日間、このパソコンの電源を切っていません。 昨日"}, {"type": "subtitle", "time": 7838.47, "timestamp": "02:10:38", "text": "あー、ただ"}, {"type": "subtitle", "time": 7840.39, "timestamp": "02:10:40", "text": "ゲームを見てただけなんだ。ゲームプレイとか"}, {"type": "subtitle", "time": 7843.91, "timestamp": "02:10:43", "text": "そういうのがそこに潜んでるんだけど、24時間365日"}, {"type": "subtitle", "time": 7845.589, "timestamp": "02:10:45", "text": "チャンネルはないんだ。自分のチャンネルを見ることができるのはわかってるけど、いや、まだ、うん、まだ"}, {"type": "subtitle", "time": 7859.35, "timestamp": "02:10:59", "text": "自分のチャンネルを見ることができるんだ。えー、"}]
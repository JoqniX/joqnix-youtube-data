[{"type": "subtitle", "time": 7440.47, "timestamp": "02:04:00", "text": "ストリームがバッファリングしたのは、えーと、"}, {"type": "subtitle", "time": 7442.39, "timestamp": "02:04:02", "text": "ショップの時だけですよね？ 店内では、"}, {"type": "subtitle", "time": 7444.79, "timestamp": "02:04:04", "text": "少しバッファリングが効いていた。 それ以外は"}, {"type": "subtitle", "time": 7447.83, "timestamp": "02:04:07", "text": "全て良かったよね？"}, {"type": "subtitle", "time": 7455.99, "timestamp": "02:04:15", "text": "ああ、見て。  [鼻を鳴らして咳払い]"}, {"type": "subtitle", "time": 7458.39, "timestamp": "02:04:18", "text": "ひまわりのやつ。 ああ、ピントを合わせた時のズーム"}, {"type": "subtitle", "time": 7459.91, "timestamp": "02:04:19", "text": "。"}, {"type": "subtitle", "time": 7461.75, "timestamp": "02:04:21", "text": "M."}, {"type": "subtitle", "time": 7468.87, "timestamp": "02:04:28", "text": "フォーカススライダーのようなものを追加するように彼に伝える。"}, {"type": "subtitle", "time": 7472.31, "timestamp": "02:04:32", "text": "あ、待って。 スライダーを設置できます。"}, {"type": "subtitle", "time": 7481.83, "timestamp": "02:04:41", "text": "待ってください。 このカメラにはフォーカススライダーが付いています。"}, {"type": "subtitle", "time": 7483.589, "timestamp": "02:04:43", "text": "カメラ。 ああ、彼はフォーカス"}, {"type": "subtitle", "time": 7486.47, "timestamp": "02:04:46", "text": "スライダーを設置しなかったんだ。 露出とホワイトバランスは"}, {"type": "subtitle", "time": 7489.51, "timestamp": "02:04:49", "text": "適切です。 わかった、彼に伝えておくよ。 わかった。   もっと"}, {"type": "subtitle", "time": 7492.229, "timestamp": "02:04:52", "text": "見る"}, {"type": "subtitle", "time": 7497.189, "timestamp": "02:04:57", "text": "H."}, {"type": "subtitle", "time": 7499.51, "timestamp": "02:04:59", "text": "あ、待って。  Hを見てみましょう。"}]
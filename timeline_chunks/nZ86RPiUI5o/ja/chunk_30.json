[{"type": "subtitle", "time": 1801.269, "timestamp": "00:30:01", "text": "朝の暑さで、あらゆるものが"}, {"type": "subtitle", "time": 1819.35, "timestamp": "00:30:19", "text": "反射するよね？ 気をつけなければならない。"}, {"type": "subtitle", "time": 1822.87, "timestamp": "00:30:22", "text": "片手で運転してる、いや、自転車に乗ってるんだ"}, {"type": "subtitle", "time": 1824.47, "timestamp": "00:30:24", "text": "。"}, {"type": "subtitle", "time": 1827.43, "timestamp": "00:30:27", "text": "ああ、あれは車だ。 なんてこった。 よし、"}, {"type": "subtitle", "time": 1830.23, "timestamp": "00:30:30", "text": "彼を通してくれる。 わかった。"}, {"type": "subtitle", "time": 1831.669, "timestamp": "00:30:31", "text": "ところで、"}, {"type": "subtitle", "time": 1835.269, "timestamp": "00:30:35", "text": "日本では自転車にもナンバープレートがあるって知っていましたか？   そうす"}, {"type": "subtitle", "time": 1836.95, "timestamp": "00:30:36", "text": "べきでしょうか？"}, {"type": "subtitle", "time": 1840.549, "timestamp": "00:30:40", "text": "よし、迫りくる攻撃は受け止められる。 あ、待って。   私はできません"}, {"type": "subtitle", "time": 1854.149, "timestamp": "00:30:54", "text": "ああ、それは私がするべきではなかったことだ"}, {"type": "subtitle", "time": 1856.389, "timestamp": "00:30:56", "text": "。 私はあの"}, {"type": "subtitle", "time": 1859.59, "timestamp": "00:30:59", "text": "歩行者が歩き終えて横断するのを待つべきだった。"}]
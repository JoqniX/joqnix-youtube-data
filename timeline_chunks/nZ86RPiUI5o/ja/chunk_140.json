[{"type": "subtitle", "time": 8400.309, "timestamp": "02:20:00", "text": "。"}, {"type": "subtitle", "time": 8403.67, "timestamp": "02:20:03", "text": "うん。 もし"}, {"type": "subtitle", "time": 8407.03, "timestamp": "02:20:07", "text": "過去のコンテンツをご覧になりたい場合は、"}, {"type": "subtitle", "time": 8410.309, "timestamp": "02:20:10", "text": "Vチャンネル、24チャンネルをご覧ください。   まるで"}, {"type": "subtitle", "time": 8413.99, "timestamp": "02:20:13", "text": "テレビ番組みたいだ。 それは常に"}, {"type": "subtitle", "time": 8426.389, "timestamp": "02:20:26", "text": "それで、私はそれを見たんです。 その動画、見ましたよ"}, {"type": "subtitle", "time": 8428.55, "timestamp": "02:20:28", "text": "。"}, {"type": "subtitle", "time": 8431.83, "timestamp": "02:20:31", "text": "うん。 そこにはたくさんのドラマがあった。 うん。 ある"}, {"type": "subtitle", "time": 8434.95, "timestamp": "02:20:34", "text": "人が以前私にこう言ったんです。"}, {"type": "subtitle", "time": 8439.51, "timestamp": "02:20:39", "text": "「ジョー、君は"}, {"type": "subtitle", "time": 8442.309, "timestamp": "02:20:42", "text": "まさに今、インディーズチューブ界の地殻変動みたいな存在だよ。」"}, {"type": "subtitle", "time": 8445.349, "timestamp": "02:20:45", "text": "そしてある人が文字通り私にこう言ったんです。"}, {"type": "subtitle", "time": 8448.15, "timestamp": "02:20:48", "text": "「ほら、クリック数を稼ぐためにドラマファーミング"}, {"type": "subtitle", "time": 8451.19, "timestamp": "02:20:51", "text": "とかそういうことをすればいいんじゃ"}, {"type": "subtitle", "time": 8456.389, "timestamp": "02:20:56", "text": "ない？」 それで私は「ええ、そんなことないわ。"}, {"type": "subtitle", "time": 8459.429, "timestamp": "02:20:59", "text": "政治とかそういうことは全然知らないの"}]
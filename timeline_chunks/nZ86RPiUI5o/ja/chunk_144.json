[{"type": "subtitle", "time": 8641.03, "timestamp": "02:24:01", "text": "ああ、やばい。"}, {"type": "subtitle", "time": 8643.67, "timestamp": "02:24:03", "text": "なんで、ストリーミング中にこの電話が充電されないんだ"}, {"type": "subtitle", "time": 8649.51, "timestamp": "02:24:09", "text": "？なんでこの電話は古いんだ？"}, {"type": "subtitle", "time": 8654.55, "timestamp": "02:24:14", "text": "ああ、なんてことだ。緑色になってくれ。"}, {"type": "subtitle", "time": 8657.91, "timestamp": "02:24:17", "text": "うん、このスマホは急速充電が嫌いなんだ。"}, {"type": "subtitle", "time": 8660.55, "timestamp": "02:24:20", "text": "普通の充電も嫌い。"}, {"type": "subtitle", "time": 8668.389, "timestamp": "02:24:28", "text": "青緑色みたいな超高速充電じゃないと"}, {"type": "subtitle", "time": 8671.75, "timestamp": "02:24:31", "text": "充電されない。ああ"}, {"type": "subtitle", "time": 8673.99, "timestamp": "02:24:33", "text": "、もう2%。さようなら。"}, {"type": "subtitle", "time": 8680.55, "timestamp": "02:24:40", "text": "よし、緑色になるぞ。走ろう。よし、走るぞ。走るぞ。"}, {"type": "subtitle", "time": 8685.99, "timestamp": "02:24:45", "text": "よし。"}, {"type": "subtitle", "time": 8688.15, "timestamp": "02:24:48", "text": "ここで配信を終了した方がいいかな。よし。"}]
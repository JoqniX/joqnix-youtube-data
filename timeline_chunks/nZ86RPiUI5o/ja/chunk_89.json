[{"type": "subtitle", "time": 5340.709, "timestamp": "01:29:00", "text": "緑がたくさんあると思っていました。 全部"}, {"type": "subtitle", "time": 5342.95, "timestamp": "01:29:02", "text": "黄色の"}, {"type": "subtitle", "time": 5350.149, "timestamp": "01:29:10", "text": "ここは公園です。 それは"}, {"type": "subtitle", "time": 5359.189, "timestamp": "01:29:19", "text": "三脚を開いたら、えーっと、"}, {"type": "subtitle", "time": 5363.43, "timestamp": "01:29:23", "text": "普段は"}, {"type": "subtitle", "time": 5367.669, "timestamp": "01:29:27", "text": "三脚を使うのは初めてで、普段は"}, {"type": "subtitle", "time": 5370.55, "timestamp": "01:29:30", "text": "手でスマホを持っていたんですが、"}, {"type": "subtitle", "time": 5377.43, "timestamp": "01:29:37", "text": "ああ、これで少しはよく見えるようになったね。   では、"}, {"type": "subtitle", "time": 5383.51, "timestamp": "01:29:43", "text": "なぜこれがホラーのように感じられるのでしょうか？"}, {"type": "subtitle", "time": 5390.709, "timestamp": "01:29:50", "text": "はい。 ええと、私の頭の上にある温度計で確認できます"}]
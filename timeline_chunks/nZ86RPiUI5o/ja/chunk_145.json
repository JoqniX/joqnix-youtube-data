[{"type": "subtitle", "time": 8708.23, "timestamp": "02:25:08", "text": "カメラのフラッシュがオンになってたのを忘れてた。やばい"}, {"type": "subtitle", "time": 8712.15, "timestamp": "02:25:12", "text": "。だからあの"}, {"type": "subtitle", "time": 8715.75, "timestamp": "02:25:15", "text": "男が私を見てたのか。"}, {"type": "subtitle", "time": 8719.429, "timestamp": "02:25:19", "text": "変だ。ああ、なんてこった。"}, {"type": "subtitle", "time": 8725.99, "timestamp": "02:25:25", "text": "右側に行こうとしてた男が車の中で待ってたんだけど、私を見てたんだ"}, {"type": "subtitle", "time": 8728.23, "timestamp": "02:25:28", "text": "。「ねえ、"}, {"type": "subtitle", "time": 8730.07, "timestamp": "02:25:30", "text": "なんで私を見てるの？」って思ったら、"}]
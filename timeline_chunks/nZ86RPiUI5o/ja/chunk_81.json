[{"type": "subtitle", "time": 4863.51, "timestamp": "01:21:03", "text": "フラッシュ。 わかった。 それから私はここに行きます。"}, {"type": "subtitle", "time": 4867.43, "timestamp": "01:21:07", "text": "いいね。 リセット。 そして、"}, {"type": "subtitle", "time": 4870.55, "timestamp": "01:21:10", "text": "これは点滅するはずです"}, {"type": "subtitle", "time": 4899.83, "timestamp": "01:21:39", "text": "ええ、歩いている人がいました。"}, {"type": "subtitle", "time": 4902.149, "timestamp": "01:21:42", "text": "私はすぐにカメラを下ろした。"}, {"type": "subtitle", "time": 4904.229, "timestamp": "01:21:44", "text": "彼らには私が、えっと、ちょっと待って、みたいな感じだと"}, {"type": "subtitle", "time": 4906.31, "timestamp": "01:21:46", "text": "思われたくないんです"}]
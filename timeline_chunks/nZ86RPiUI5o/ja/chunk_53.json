[{"type": "subtitle", "time": 3204.309, "timestamp": "00:53:24", "text": "[咳払い]"}, {"type": "subtitle", "time": 3206.23, "timestamp": "00:53:26", "text": "音声。   ちょっと"}, {"type": "subtitle", "time": 3208.95, "timestamp": "00:53:28", "text": "待って、音声は大丈夫かな？ はい、"}, {"type": "subtitle", "time": 3215.589, "timestamp": "00:53:35", "text": "よし、あと1つでスプーンとか"}, {"type": "subtitle", "time": 3217.75, "timestamp": "00:53:37", "text": "全部終わるぞ。"}, {"type": "subtitle", "time": 3227.349, "timestamp": "00:53:47", "text": "言い忘れていましたが、"}, {"type": "subtitle", "time": 3229.829, "timestamp": "00:53:49", "text": "デスクトップもあります。  「"}, {"type": "subtitle", "time": 3234.23, "timestamp": "00:53:54", "text": "Good One」というゲームも試してみようと思います。"}, {"type": "subtitle", "time": 3238.87, "timestamp": "00:53:58", "text": "えっと、これはゲームです。 では、これらすべてが終わったら、何かの後に文字列を記述します"}]
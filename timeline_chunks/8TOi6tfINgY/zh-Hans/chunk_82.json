[{"type": "subtitle", "time": 4959.95, "timestamp": "01:22:39", "text": "一个人都没剩下。你在我面前看起来很紧张。"}, {"type": "subtitle", "time": 4970.91, "timestamp": "01:22:50", "text": "首先让我说一句。"}, {"type": "subtitle", "time": 4971.75, "timestamp": "01:22:51", "text": "剑"}, {"type": "subtitle", "time": 4974.189, "timestamp": "01:22:54", "text": "哪把剑"}, {"type": "subtitle", "time": 4977.59, "timestamp": "01:22:57", "text": "这是你在幼儿园用过的东西。这样就变成了4"}]
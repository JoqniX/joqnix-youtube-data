[{"type": "subtitle", "time": 9620.269, "timestamp": "02:40:20", "text": "这个时空显然不是连续的，而且是混沌的。"}, {"type": "subtitle", "time": 9622.11, "timestamp": "02:40:22", "text": "是的，他们是。"}, {"type": "subtitle", "time": 9625.23, "timestamp": "02:40:25", "text": "这些人包括集体和罗伊家族。"}, {"type": "subtitle", "time": 9628.07, "timestamp": "02:40:28", "text": "他们穿着戏服。"}]
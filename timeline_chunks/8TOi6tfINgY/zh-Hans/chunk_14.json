[{"type": "subtitle", "time": 840.43, "timestamp": "00:14:00", "text": "你怎么能伤害我？"}, {"type": "subtitle", "time": 842.91, "timestamp": "00:14:02", "text": "作为校长，我不能对此视而不见。"}, {"type": "subtitle", "time": 844.92, "timestamp": "00:14:04", "text": "。 一只看起来像是果化石的兔子"}, {"type": "subtitle", "time": 847.519, "timestamp": "00:14:07", "text": "一只看起来像是果化石的兔子 你应该利用这一点来发挥自己的优势。"}, {"type": "subtitle", "time": 855.189, "timestamp": "00:14:15", "text": "为了查明异常情况的原因，人们将兔子引诱出来并捕获。"}, {"type": "subtitle", "time": 859.269, "timestamp": "00:14:19", "text": "解决。凭借我的能力，从兔子"}, {"type": "subtitle", "time": 862.99, "timestamp": "00:14:22", "text": "我正在寻找有关果糖苷的信息。俱乐部活动"}, {"type": "subtitle", "time": 865.59, "timestamp": "00:14:25", "text": "如果我们引入学术界的力量，他们或许会注意到。"}, {"type": "subtitle", "time": 869.629, "timestamp": "00:14:29", "text": "没有。所以，小规模聚会时更需要谨慎行事。"}, {"type": "subtitle", "time": 874.749, "timestamp": "00:14:34", "text": "有。一个值得信赖且了解地下学院的人。"}]
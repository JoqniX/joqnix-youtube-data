[{"type": "subtitle", "time": 799.67, "timestamp": "00:13:19", "text": "那只兔子把自己带进了它进入的任何地方。"}, {"type": "subtitle", "time": 802.269, "timestamp": "00:13:22", "text": "他们害怕什么，以及他们对什么视而不见"}, {"type": "subtitle", "time": 805.15, "timestamp": "00:13:25", "text": "面对面站着。看来志贺先生的情况就是如此。"}, {"type": "subtitle", "time": 806.99, "timestamp": "00:13:26", "text": "到。"}, {"type": "subtitle", "time": 810.949, "timestamp": "00:13:30", "text": "地下学院的怪事仍在继续。一些学生"}, {"type": "subtitle", "time": 814.23, "timestamp": "00:13:34", "text": "教师中也出现过与她类似的问题。"}, {"type": "subtitle", "time": 827.87, "timestamp": "00:13:47", "text": "组织首领曾向你和柳教授发出警告。"}, {"type": "subtitle", "time": 831.389, "timestamp": "00:13:51", "text": "综上所述，那只兔子就是弗拉克特"}, {"type": "subtitle", "time": 834.87, "timestamp": "00:13:54", "text": "感觉这真的像是Sides留下的陷阱。"}, {"type": "subtitle", "time": 838.31, "timestamp": "00:13:58", "text": "我曾使用如此低俗的手段伤害我的学生和同事。"}]
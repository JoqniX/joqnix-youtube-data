[{"type": "subtitle", "time": 11044.309, "timestamp": "03:04:04", "text": "那位神社巫女"}, {"type": "subtitle", "time": 11053.469, "timestamp": "03:04:13", "text": "只有你。"}, {"type": "subtitle", "time": 11055.11, "timestamp": "03:04:15", "text": "好了，我走了。"}, {"type": "subtitle", "time": 11056.87, "timestamp": "03:04:16", "text": "是的。"}, {"type": "subtitle", "time": 11098.03, "timestamp": "03:04:58", "text": "这就通往了地下的火星飞机。"}]
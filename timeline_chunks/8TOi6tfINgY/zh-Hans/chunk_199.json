[{"type": "subtitle", "time": 11954.11, "timestamp": "03:19:14", "text": "打破封条意味着"}, {"type": "subtitle", "time": 11955.229, "timestamp": "03:19:15", "text": "我明白。"}, {"type": "subtitle", "time": 11957.189, "timestamp": "03:19:17", "text": "但现在是阿莱夫"}, {"type": "subtitle", "time": 11960.07, "timestamp": "03:19:20", "text": "它很可能只有一台发动机。"}, {"type": "subtitle", "time": 11964.189, "timestamp": "03:19:24", "text": "封条曾被打开过一次。你正处于最危险的时期。"}, {"type": "subtitle", "time": 11982.63, "timestamp": "03:19:42", "text": "承担这样的风险绝不是失败。"}, {"type": "subtitle", "time": 11983.87, "timestamp": "03:19:43", "text": "我也犯过错误。"}]
[{"type": "subtitle", "time": 7449.95, "timestamp": "02:04:09", "text": "庆祝活动结束后，我又被卢西勒召见了。"}, {"type": "subtitle", "time": 7451.31, "timestamp": "02:04:11", "text": "我听说过这件事。"}, {"type": "subtitle", "time": 7485.109, "timestamp": "02:04:45", "text": "但最近研究人员发现，Strider Gate"}, {"type": "subtitle", "time": 7488.75, "timestamp": "02:04:48", "text": "附近数据显著超过安全水平"}, {"type": "subtitle", "time": 7492.069, "timestamp": "02:04:52", "text": "我正在核实。"}, {"type": "subtitle", "time": 7495.589, "timestamp": "02:04:55", "text": "虚空物质变得异常活跃。"}, {"type": "subtitle", "time": 7498.75, "timestamp": "02:04:58", "text": "该团体对此事一直相当紧张。"}]
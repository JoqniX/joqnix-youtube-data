[{"type": "subtitle", "time": 2042.669, "timestamp": "00:34:02", "text": "穿这件衣服的人是"}, {"type": "subtitle", "time": 2066.829, "timestamp": "00:34:26", "text": "如果他们知道我来自那所学校……"}, {"type": "subtitle", "time": 2069.31, "timestamp": "00:34:29", "text": "那可不好。"}, {"type": "subtitle", "time": 2074.069, "timestamp": "00:34:34", "text": "从某种意义上说，我们都是地下学校的受害者。"}, {"type": "subtitle", "time": 2085.79, "timestamp": "00:34:45", "text": "我最近在学校后面出了车祸。"}]
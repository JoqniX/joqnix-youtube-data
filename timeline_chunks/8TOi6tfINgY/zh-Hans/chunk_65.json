[{"type": "subtitle", "time": 3906.549, "timestamp": "01:05:06", "text": "既可怕又令人惊叹"}, {"type": "subtitle", "time": 3908.109, "timestamp": "01:05:08", "text": "美丽的"}, {"type": "subtitle", "time": 3910.385, "timestamp": "01:05:10", "text": "可爱的"}, {"type": "subtitle", "time": 3925.19, "timestamp": "01:05:25", "text": "警惕靠近的人。"}, {"type": "subtitle", "time": 3927.829, "timestamp": "01:05:27", "text": "在地下学院里发现的那只兔子是什么品种的兔子？"}, {"type": "subtitle", "time": 3931.39, "timestamp": "01:05:31", "text": "我甚至可以改变我的外貌。这个房间有一条走廊"}, {"type": "subtitle", "time": 3934.029, "timestamp": "01:05:34", "text": "只有一个。他们可能还在躲藏。"}]
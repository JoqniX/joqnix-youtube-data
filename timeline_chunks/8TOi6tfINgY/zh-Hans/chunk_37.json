[{"type": "subtitle", "time": 2228.91, "timestamp": "00:37:08", "text": "明星赛被打断了，但替补队员"}, {"type": "subtitle", "time": 2231.95, "timestamp": "00:37:11", "text": "你的行为是出于正义，这一点毋庸置疑。"}, {"type": "subtitle", "time": 2242.55, "timestamp": "00:37:22", "text": "该团体目前迫切需要技术进步。"}, {"type": "subtitle", "time": 2246.47, "timestamp": "00:37:26", "text": "它们确实存在。这条指示是我发给你的私人信息。"}, {"type": "subtitle", "time": 2269.069, "timestamp": "00:37:49", "text": "嗯，显然"}]
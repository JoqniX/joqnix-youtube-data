[{"type": "subtitle", "time": 11955.229, "timestamp": "03:19:15", "text": "."}, {"type": "subtitle", "time": 11957.189, "timestamp": "03:19:17", "text": "But now it's the Aleph,"}, {"type": "subtitle", "time": 11960.07, "timestamp": "03:19:20", "text": "with its single engine."}, {"type": "subtitle", "time": 11964.189, "timestamp": "03:19:24", "text": "The seal was broken once.  You"}, {"type": "subtitle", "time": 11982.63, "timestamp": "03:19:42", "text": "taking such a risk would mean you would never lose"}, {"type": "subtitle", "time": 11983.87, "timestamp": "03:19:43", "text": ". I failed too."}]
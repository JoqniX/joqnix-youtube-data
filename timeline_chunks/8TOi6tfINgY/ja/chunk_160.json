[{"type": "subtitle", "time": 9620.269, "timestamp": "02:40:20", "text": "この時空は確かに連続性がなく混乱して"}, {"type": "subtitle", "time": 9622.11, "timestamp": "02:40:22", "text": "いる。"}, {"type": "subtitle", "time": 9625.23, "timestamp": "02:40:25", "text": "あの人たちはコレクティブとロイ一族の"}, {"type": "subtitle", "time": 9628.07, "timestamp": "02:40:28", "text": "衣装を着ている。"}]
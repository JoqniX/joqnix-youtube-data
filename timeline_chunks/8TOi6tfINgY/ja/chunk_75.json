[{"type": "subtitle", "time": 4514.99, "timestamp": "01:15:14", "text": "最初に話した時からあなたはフラクトだ。"}, {"type": "subtitle", "time": 4524.07, "timestamp": "01:15:24", "text": "安心して。裏学園は入ってきたものにその"}, {"type": "subtitle", "time": 4526.629, "timestamp": "01:15:26", "text": "人が目を背けている過去や本心を見せる"}, {"type": "subtitle", "time": 4528.629, "timestamp": "01:15:28", "text": "ことは知っていたわ。"}, {"type": "subtitle", "time": 4554.39, "timestamp": "01:15:54", "text": "20"}, {"type": "subtitle", "time": 4556.877, "timestamp": "01:15:56", "text": "十歳を迎える前に私は能力で読み取った記"}, {"type": "subtitle", "time": 4558.35, "timestamp": "01:15:58", "text": "[音楽]"}]
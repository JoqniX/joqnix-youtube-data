[{"type": "subtitle", "time": 7634.069, "timestamp": "02:07:14", "text": "私を呼ぶシグナルを受け取った漂白者。"}, {"type": "subtitle", "time": 7638.189, "timestamp": "02:07:18", "text": "ラハイロイの状況あまり良くないの。"}, {"type": "subtitle", "time": 7652.99, "timestamp": "02:07:32", "text": "周波数の流出については解決したけど、"}, {"type": "subtitle", "time": 7656.069, "timestamp": "02:07:36", "text": "今ラハイロイは名式の脅威にさらされて"}, {"type": "subtitle", "time": 7662.99, "timestamp": "02:07:42", "text": "いる。助けが必要なの。ショアキーパー。"}, {"type": "subtitle", "time": 7667.75, "timestamp": "02:07:47", "text": "私もブラックもそのために存在しているの"}]
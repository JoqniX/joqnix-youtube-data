[{"type": "subtitle", "time": 7503.43, "timestamp": "02:05:03", "text": "になっている。もし名式アレフ1が封印を"}, {"type": "subtitle", "time": 7506.95, "timestamp": "02:05:06", "text": "完全に破ればラハイロイだけでなく"}, {"type": "subtitle", "time": 7509.43, "timestamp": "02:05:09", "text": "ソラリス全体に波及することになるからだ"}, {"type": "subtitle", "time": 7516.669, "timestamp": "02:05:16", "text": "確かにコレクティブは危険な場所に建設さ"}, {"type": "subtitle", "time": 7520.75, "timestamp": "02:05:20", "text": "れている。だからこそ名式の防発に対処"}, {"type": "subtitle", "time": 7523.069, "timestamp": "02:05:23", "text": "するための手をたくさん打っているわけだ"}, {"type": "subtitle", "time": 7530.39, "timestamp": "02:05:30", "text": "それらのプランは結局研究に甚大な損失を"}, {"type": "subtitle", "time": 7538.629, "timestamp": "02:05:38", "text": "こういった状況ならあの責任者と話す余地"}, {"type": "subtitle", "time": 7541.03, "timestamp": "02:05:41", "text": "もあるはずだよ。"}, {"type": "subtitle", "time": 7544.669, "timestamp": "02:05:44", "text": "説得してみるよ。被害を最小限に抑え"}, {"type": "subtitle", "time": 7548.47, "timestamp": "02:05:48", "text": "られるかもしれない案を採用するように。"}, {"type": "subtitle", "time": 7551.51, "timestamp": "02:05:51", "text": "的確者として今すぐにでもエクソスト"}, {"type": "subtitle", "time": 7554.03, "timestamp": "02:05:54", "text": "ライダーを操縦する支出があることを証明"}]
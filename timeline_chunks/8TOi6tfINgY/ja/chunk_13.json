[{"type": "subtitle", "time": 799.67, "timestamp": "00:13:19", "text": "あのうさぎはそこに入ったものに自分自身"}, {"type": "subtitle", "time": 802.269, "timestamp": "00:13:22", "text": "が恐れていることや目を背けていることに"}, {"type": "subtitle", "time": 805.15, "timestamp": "00:13:25", "text": "向き合わせる。しかさんがそうだったよう"}, {"type": "subtitle", "time": 806.99, "timestamp": "00:13:26", "text": "に。"}, {"type": "subtitle", "time": 810.949, "timestamp": "00:13:30", "text": "今も裏学園の異変は継続中よ。一部の学生"}, {"type": "subtitle", "time": 814.23, "timestamp": "00:13:34", "text": "や教師の間で彼女と似たような問題が発生"}, {"type": "subtitle", "time": 827.87, "timestamp": "00:13:47", "text": "組織長があなたと龍ク先生に伝えた予告と"}, {"type": "subtitle", "time": 831.389, "timestamp": "00:13:51", "text": "合わせると、あのウさぎこそフラクト"}, {"type": "subtitle", "time": 834.87, "timestamp": "00:13:54", "text": "シデスが残した仕掛けに思えて仕方ない。"}, {"type": "subtitle", "time": 838.31, "timestamp": "00:13:58", "text": "ああいった下品な方法で私の学生や同僚を"}]
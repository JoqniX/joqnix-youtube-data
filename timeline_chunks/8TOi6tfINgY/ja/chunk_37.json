[{"type": "subtitle", "time": 2228.91, "timestamp": "00:37:08", "text": "スター知は中断されてしまったが、控えの"}, {"type": "subtitle", "time": 2231.95, "timestamp": "00:37:11", "text": "義で活躍した君の行動は間違いなく"}, {"type": "subtitle", "time": 2242.55, "timestamp": "00:37:22", "text": "コレクティブは今技術の躍を切実に求めて"}, {"type": "subtitle", "time": 2246.47, "timestamp": "00:37:26", "text": "いるんだ。この訓章は私からの個人的な"}, {"type": "subtitle", "time": 2269.069, "timestamp": "00:37:49", "text": "え、どうやら"}]
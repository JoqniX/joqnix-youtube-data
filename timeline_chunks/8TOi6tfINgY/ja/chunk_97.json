[{"type": "subtitle", "time": 5829.51, "timestamp": "01:37:09", "text": "それはそうだけど、エマに願い事を書け"}, {"type": "subtitle", "time": 5833.79, "timestamp": "01:37:13", "text": "ば巫女様が見てくれる。だから危険を犯し"}, {"type": "subtitle", "time": 5846.43, "timestamp": "01:37:26", "text": "世界々"}, {"type": "subtitle", "time": 5852.629, "timestamp": "01:37:32", "text": "が悲鳴様。私の願いは次の咲夜の巫女が"}, {"type": "subtitle", "time": 5855.35, "timestamp": "01:37:35", "text": "現れないこと。"}, {"type": "subtitle", "time": 5879.35, "timestamp": "01:37:59", "text": "何しろ"}]
[{"type": "subtitle", "time": 5530.39, "timestamp": "01:32:10", "text": "それに"}, {"type": "subtitle", "time": 5540.91, "timestamp": "01:32:20", "text": "手間をかける。いえ、あの"}, {"type": "subtitle", "time": 5558.189, "timestamp": "01:32:38", "text": "あ、うま。"}, {"type": "subtitle", "time": 5560.91, "timestamp": "01:32:40", "text": "咲夜の巫女様、みんなここで死ぬ。"}, {"type": "subtitle", "time": 5561.83, "timestamp": "01:32:41", "text": "遅くなって"}, {"type": "subtitle", "time": 5566.229, "timestamp": "01:32:46", "text": "昨夜"}, {"type": "subtitle", "time": 5567.669, "timestamp": "01:32:47", "text": "名式は知りけた"}, {"type": "subtitle", "time": 5571.87, "timestamp": "01:32:51", "text": "ああ、"}, {"type": "subtitle", "time": 5573.03, "timestamp": "01:32:53", "text": "火の原"}]
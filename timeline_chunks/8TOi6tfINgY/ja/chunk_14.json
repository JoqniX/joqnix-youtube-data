[{"type": "subtitle", "time": 840.43, "timestamp": "00:14:00", "text": "傷つけるなんて"}, {"type": "subtitle", "time": 842.91, "timestamp": "00:14:02", "text": "学園長として見過ごすわけにはいかないわ"}, {"type": "subtitle", "time": 844.91, "timestamp": "00:14:04", "text": "。"}, {"type": "subtitle", "time": 847.509, "timestamp": "00:14:07", "text": "フラクトシテスの駒マと思われるウサギを"}, {"type": "subtitle", "time": 855.189, "timestamp": "00:14:15", "text": "うさギを誘い出し捕獲して異変の原因を"}, {"type": "subtitle", "time": 859.269, "timestamp": "00:14:19", "text": "解決する。そして私の能力でうさぎから"}, {"type": "subtitle", "time": 862.99, "timestamp": "00:14:22", "text": "フラクトシデスの情報を探り出す。部活に"}, {"type": "subtitle", "time": 865.59, "timestamp": "00:14:25", "text": "学園の力を同員すれば気づかれるかもしれ"}, {"type": "subtitle", "time": 869.629, "timestamp": "00:14:29", "text": "ない。だからこそ小人数で慎重に動く必要"}, {"type": "subtitle", "time": 874.749, "timestamp": "00:14:34", "text": "があるの。信頼できて裏学園に詳しい人物"}]
[{"type": "subtitle", "time": 14951.269, "timestamp": "04:09:11", "text": "本当に意地が悪いお姉ちゃんだわ。ただ"}, {"type": "subtitle", "time": 14954.469, "timestamp": "04:09:14", "text": "どうしても心配なの。"}, {"type": "subtitle", "time": 14957.71, "timestamp": "04:09:17", "text": "ゆきちゃんの才能は誰よりも私が知ってる"}, {"type": "subtitle", "time": 14959.79, "timestamp": "04:09:19", "text": "。"}, {"type": "subtitle", "time": 14963.51, "timestamp": "04:09:23", "text": "あなたには名識すら従えてしまう可能性が"}, {"type": "subtitle", "time": 14975.67, "timestamp": "04:09:35", "text": "あなたが本心。"}, {"type": "subtitle", "time": 14978.59, "timestamp": "04:09:38", "text": "あ、あ、メイハ白さん。"}, {"type": "subtitle", "time": 14983.309, "timestamp": "04:09:43", "text": "2"}]
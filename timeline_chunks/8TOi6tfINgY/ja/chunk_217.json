[{"type": "subtitle", "time": 13023.309, "timestamp": "03:37:03", "text": "エクソストライダー。"}, {"type": "subtitle", "time": 13025.63, "timestamp": "03:37:05", "text": "なぜここにエクソライダーだ?"}, {"type": "subtitle", "time": 13027.229, "timestamp": "03:37:07", "text": "何が起きてるの?"}, {"type": "subtitle", "time": 13044.469, "timestamp": "03:37:24", "text": "何をしてるの?"}, {"type": "subtitle", "time": 13046.269, "timestamp": "03:37:26", "text": "もういいんだ。"}, {"type": "subtitle", "time": 13047.229, "timestamp": "03:37:27", "text": "よ"}, {"type": "subtitle", "time": 13056.269, "timestamp": "03:37:36", "text": "あそこへ行きたいの"}, {"type": "subtitle", "time": 13070.71, "timestamp": "03:37:50", "text": "解できない"}]
[{"type": "subtitle", "time": 4562.11, "timestamp": "01:16:02", "text": "がった結果どれが自分自身のものなのか"}, {"type": "subtitle", "time": 4565.03, "timestamp": "01:16:05", "text": "区別できなく読み取る記憶が増えるにつれ"}, {"type": "subtitle", "time": 4568.31, "timestamp": "01:16:08", "text": "て多くの始まりと終わりを間の当たりにし"}, {"type": "subtitle", "time": 4569.95, "timestamp": "01:16:09", "text": "た。"}, {"type": "subtitle", "time": 4573.87, "timestamp": "01:16:13", "text": "それで私は自分がどれほど小さい存在なの"}, {"type": "subtitle", "time": 4577.11, "timestamp": "01:16:17", "text": "か理解してしまったの。"}, {"type": "subtitle", "time": 4580.458, "timestamp": "01:16:20", "text": "裏学園はその記憶を利用して私の過去の"}, {"type": "subtitle", "time": 4580.51, "timestamp": "01:16:20", "text": "[音楽]"}, {"type": "subtitle", "time": 4584.75, "timestamp": "01:16:24", "text": "悩みを再現した。それは要するにフラクト"}, {"type": "subtitle", "time": 4587.669, "timestamp": "01:16:27", "text": "ですがスター学園の代表である私に"}, {"type": "subtitle", "time": 4591.229, "timestamp": "01:16:31", "text": "問いかけているということ。"}, {"type": "subtitle", "time": 4594.629, "timestamp": "01:16:34", "text": "答えのない未来を前にして何もかもが消え"}, {"type": "subtitle", "time": 4597.189, "timestamp": "01:16:37", "text": "てしまう運命の中力"}, {"type": "subtitle", "time": 4600.27, "timestamp": "01:16:40", "text": "で何も知らない私たちの行動にまだ意味は"}]
[{"type": "subtitle", "time": 7754.709, "timestamp": "02:09:14", "text": "目覚めたとしても"}, {"type": "subtitle", "time": 7779.149, "timestamp": "02:09:39", "text": "た結果、彼らは最主と類事点を持つ"}, {"type": "subtitle", "time": 7783.109, "timestamp": "02:09:43", "text": "エクソストライダーも共鳴者を得ることで"}, {"type": "subtitle", "time": 7786.629, "timestamp": "02:09:46", "text": "力を高められると考えた"}, {"type": "subtitle", "time": 7789.43, "timestamp": "02:09:49", "text": "けれど、あなたとエクソストライダーの"}, {"type": "subtitle", "time": 7794.069, "timestamp": "02:09:54", "text": "関係を考慮するとテスシステムはあなたが"}, {"type": "subtitle", "time": 7798.149, "timestamp": "02:09:58", "text": "外員性共鳴という方法を取ることを推奨し"}]
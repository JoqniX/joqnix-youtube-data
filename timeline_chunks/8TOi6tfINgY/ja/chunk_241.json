[{"type": "subtitle", "time": 14460.469, "timestamp": "04:01:00", "text": "承知しましたですが、副組織長はあなたが"}, {"type": "subtitle", "time": 14463.87, "timestamp": "04:01:03", "text": "再び私を使いに出したことで正弱を見出し"}, {"type": "subtitle", "time": 14473.03, "timestamp": "04:01:13", "text": "ところでこの先も組織長の大事な役のため"}, {"type": "subtitle", "time": 14475.67, "timestamp": "04:01:15", "text": "に"}, {"type": "subtitle", "time": 14479.71, "timestamp": "04:01:19", "text": "会は無要だ。私はフローバのところへ行っ"}, {"type": "subtitle", "time": 14481.83, "timestamp": "04:01:21", "text": "てくる。"}, {"type": "subtitle", "time": 14485.269, "timestamp": "04:01:25", "text": "とりあえずよしとしよう。"}, {"type": "subtitle", "time": 14497.91, "timestamp": "04:01:37", "text": "必要ない。"}]
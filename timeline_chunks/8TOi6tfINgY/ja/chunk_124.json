[{"type": "subtitle", "time": 7449.95, "timestamp": "02:04:09", "text": "祝点後、またルシラーに呼び出されたって"}, {"type": "subtitle", "time": 7451.31, "timestamp": "02:04:11", "text": "聞いたよ。"}, {"type": "subtitle", "time": 7485.109, "timestamp": "02:04:45", "text": "だが最近研究員はストライダーゲートの"}, {"type": "subtitle", "time": 7488.75, "timestamp": "02:04:48", "text": "付近で安全値を一著しく超えたデータを"}, {"type": "subtitle", "time": 7492.069, "timestamp": "02:04:52", "text": "確認している。"}, {"type": "subtitle", "time": 7495.589, "timestamp": "02:04:55", "text": "ボイドマターが異常に活発化していてね、"}, {"type": "subtitle", "time": 7498.75, "timestamp": "02:04:58", "text": "コレクティブ内部はこの件でかなり神経室"}]
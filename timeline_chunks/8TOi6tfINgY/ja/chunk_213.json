[{"type": "subtitle", "time": 12792.71, "timestamp": "03:33:12", "text": "憧れから"}, {"type": "subtitle", "time": 12817.389, "timestamp": "03:33:37", "text": "だがそれはそなた救済する力を持たぬもの"}, {"type": "subtitle", "time": 12819.429, "timestamp": "03:33:39", "text": "は"}, {"type": "subtitle", "time": 12821.95, "timestamp": "03:33:41", "text": "かつて"}, {"type": "subtitle", "time": 12827.03, "timestamp": "03:33:47", "text": "今やわが鈴を手放さないことで"}, {"type": "subtitle", "time": 12831.83, "timestamp": "03:33:51", "text": "2度と咲く力のないわには"}, {"type": "subtitle", "time": 12835.79, "timestamp": "03:33:55", "text": "ラハロイもはるかカナダの"}, {"type": "subtitle", "time": 12838.03, "timestamp": "03:33:58", "text": "多くの文明が危機を乗り越える場に"}]
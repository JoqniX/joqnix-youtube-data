[{"type": "subtitle", "time": 2042.669, "timestamp": "00:34:02", "text": "これを身につけているのは"}, {"type": "subtitle", "time": 2066.829, "timestamp": "00:34:26", "text": "私が学園側から来たことを気づかれては"}, {"type": "subtitle", "time": 2069.31, "timestamp": "00:34:29", "text": "いけない。"}, {"type": "subtitle", "time": 2074.069, "timestamp": "00:34:34", "text": "ある意味私たちは裏学園の被害者同士その"}, {"type": "subtitle", "time": 2085.79, "timestamp": "00:34:45", "text": "この間私としは裏学園で事故にあった。"}]
[{"type": "subtitle", "time": 6744.27, "timestamp": "01:52:24", "text": "ドラを照らす一面の輝き。そこで人々は"}, {"type": "subtitle", "time": 6746.99, "timestamp": "01:52:26", "text": "答えを得た。"}, {"type": "subtitle", "time": 6751.189, "timestamp": "01:52:31", "text": "まるで夢のような光景だ。"}, {"type": "subtitle", "time": 6757.589, "timestamp": "01:52:37", "text": "ああ、あの時足原もこうであれば"}, {"type": "subtitle", "time": 6761.629, "timestamp": "01:52:41", "text": "かつてお前も多くの仲間と一眼となって"}, {"type": "subtitle", "time": 6766.629, "timestamp": "01:52:46", "text": "戦ってきただろう。だがコナミの雨が止む"}, {"type": "subtitle", "time": 6766.91, "timestamp": "01:52:46", "text": "。"}]
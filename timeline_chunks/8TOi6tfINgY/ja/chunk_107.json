[{"type": "subtitle", "time": 6444.83, "timestamp": "01:47:24", "text": "その足で道を歩んでこそ我々を理解し認め"}, {"type": "subtitle", "time": 6448.91, "timestamp": "01:47:28", "text": "、お前自身の謝ちに気づくことができるの"}, {"type": "subtitle", "time": 6454.629, "timestamp": "01:47:34", "text": "だ。お前の想像通りだ。今週もほと同じく"}, {"type": "subtitle", "time": 6459.669, "timestamp": "01:47:39", "text": "かつては名式の脅威にさらされていた。"}]
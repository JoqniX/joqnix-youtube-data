[{"type": "subtitle", "time": 6120.709, "timestamp": "01:42:00", "text": "近頃"}, {"type": "subtitle", "time": 6125.229, "timestamp": "01:42:05", "text": "姉上が鈴を使う。願いを叶えるために鈴の"}, {"type": "subtitle", "time": 6130.39, "timestamp": "01:42:10", "text": "力で自らの未来の可能性を借り受ける。"}, {"type": "subtitle", "time": 6131.91, "timestamp": "01:42:11", "text": "姉上"}, {"type": "subtitle", "time": 6135.47, "timestamp": "01:42:15", "text": "どうか巫女の座から知りき鈴をわに"}, {"type": "subtitle", "time": 6138.91, "timestamp": "01:42:18", "text": "引き継ぐのです。"}, {"type": "subtitle", "time": 6144.03, "timestamp": "01:42:24", "text": "全然大丈夫だって。それよりちゃんどうし"}, {"type": "subtitle", "time": 6147.51, "timestamp": "01:42:27", "text": "ていつもそんなことばかり考えてるの?"}, {"type": "subtitle", "time": 6154.79, "timestamp": "01:42:34", "text": "夢を見るのはいいけどあなたには早いわよ"}, {"type": "subtitle", "time": 6155.03, "timestamp": "01:42:35", "text": "。"}, {"type": "subtitle", "time": 6171.51, "timestamp": "01:42:51", "text": "ああ、本当に食べなくていいの?"}]
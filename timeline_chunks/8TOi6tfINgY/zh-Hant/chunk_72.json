[{"type": "subtitle", "time": 4320.83, "timestamp": "01:12:00", "text": "sheblindevery"}, {"type": "subtitle", "time": 4333.709, "timestamp": "01:12:13", "text": "我就這麼做了。"}, {"type": "subtitle", "time": 4367.79, "timestamp": "01:12:47", "text": "總之，他幫我完成了實驗。"}, {"type": "subtitle", "time": 4372.189, "timestamp": "01:12:52", "text": "我們應該為此感到慶幸。"}]
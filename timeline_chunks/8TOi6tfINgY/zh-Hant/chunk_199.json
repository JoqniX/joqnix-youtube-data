[{"type": "subtitle", "time": 11954.11, "timestamp": "03:19:14", "text": "打破封條意味著"}, {"type": "subtitle", "time": 11955.229, "timestamp": "03:19:15", "text": "我明白。"}, {"type": "subtitle", "time": 11957.189, "timestamp": "03:19:17", "text": "但現在是阿萊夫"}, {"type": "subtitle", "time": 11960.07, "timestamp": "03:19:20", "text": "它很可能只有一台引擎。"}, {"type": "subtitle", "time": 11964.189, "timestamp": "03:19:24", "text": "封條曾經被打開過一次。你正處於最危險的時期。"}, {"type": "subtitle", "time": 11982.63, "timestamp": "03:19:42", "text": "承擔這樣的風險絕不是失敗。"}, {"type": "subtitle", "time": 11983.87, "timestamp": "03:19:43", "text": "我也犯過錯。"}]
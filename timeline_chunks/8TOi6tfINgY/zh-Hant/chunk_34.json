[{"type": "subtitle", "time": 2042.669, "timestamp": "00:34:02", "text": "穿這件衣服的人是"}, {"type": "subtitle", "time": 2066.829, "timestamp": "00:34:26", "text": "如果他們知道我來自那所學校…"}, {"type": "subtitle", "time": 2069.31, "timestamp": "00:34:29", "text": "那可不好。"}, {"type": "subtitle", "time": 2074.069, "timestamp": "00:34:34", "text": "從某種意義上說，我們都是地下學校的受害者。"}, {"type": "subtitle", "time": 2085.79, "timestamp": "00:34:45", "text": "我最近在學校後面出了車禍。"}]
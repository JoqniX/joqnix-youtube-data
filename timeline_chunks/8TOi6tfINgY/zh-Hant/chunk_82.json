[{"type": "subtitle", "time": 4959.95, "timestamp": "01:22:39", "text": "一個人都沒剩下。你在我面前看起來很緊張。"}, {"type": "subtitle", "time": 4970.91, "timestamp": "01:22:50", "text": "首先讓我說一句。"}, {"type": "subtitle", "time": 4971.75, "timestamp": "01:22:51", "text": "劍"}, {"type": "subtitle", "time": 4974.189, "timestamp": "01:22:54", "text": "哪把劍"}, {"type": "subtitle", "time": 4977.59, "timestamp": "01:22:57", "text": "這是你在幼兒園用過的東西。這樣就變成4"}]
[{"type": "subtitle", "time": 15131.95, "timestamp": "04:12:11", "text": "姐姐，你怎麼了？"}, {"type": "subtitle", "time": 15163.149, "timestamp": "04:12:43", "text": "瞧，白色，"}, {"type": "subtitle", "time": 15167.189, "timestamp": "04:12:47", "text": "想飛哪裡就飛哪裡。"}, {"type": "subtitle", "time": 15170.309, "timestamp": "04:12:50", "text": "總有一天，由紀醬會"}, {"type": "subtitle", "time": 15173.59, "timestamp": "04:12:53", "text": "就像其他人一樣"}]
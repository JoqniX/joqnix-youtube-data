[{"type": "subtitle", "time": 13868.229, "timestamp": "03:51:08", "text": "雷姆斯"}, {"type": "subtitle", "time": 13872.309, "timestamp": "03:51:12", "text": "我剛到拉哈洛伊的時候，你的"}, {"type": "subtitle", "time": 13875.11, "timestamp": "03:51:15", "text": "關於當前情況，"}, {"type": "subtitle", "time": 13899.51, "timestamp": "03:51:39", "text": "是這樣嗎？"}, {"type": "subtitle", "time": 13901.269, "timestamp": "03:51:41", "text": "盟軍的意志，永遠走向滅亡"}]
[{"type": "subtitle", "time": 722.35, "timestamp": "00:12:02", "text": "所以你們相遇了。"}, {"type": "subtitle", "time": 725.509, "timestamp": "00:12:05", "text": "從她說話的方式就能聽出來她是個騙子。"}, {"type": "subtitle", "time": 727.23, "timestamp": "00:12:07", "text": "我一眼就看穿了。"}, {"type": "subtitle", "time": 740.829, "timestamp": "00:12:20", "text": "沒錯。小事"}, {"type": "subtitle", "time": 740.99, "timestamp": "00:12:20", "text": "1"}, {"type": "subtitle", "time": 755.99, "timestamp": "00:12:35", "text": "哇，太棒了。"}]
[{"type": "subtitle", "time": 18061.548, "timestamp": "05:01:01", "text": "從工作地點"}, {"type": "subtitle", "time": 18062.91, "timestamp": "05:01:02", "text": "我的日程安排是"}, {"type": "subtitle", "time": 18069.47, "timestamp": "05:01:09", "text": "右線"}, {"type": "subtitle", "time": 18070.11, "timestamp": "05:01:10", "text": "謝謝你"}, {"type": "subtitle", "time": 18071.11, "timestamp": "05:01:11", "text": "那些說話的人"}, {"type": "subtitle", "time": 18078.75, "timestamp": "05:01:18", "text": "祝你一切順利"}, {"type": "chat", "time": 18081.02, "timestamp": "05:01:21", "author": "@itzR_En", "avatar": "https://yt4.ggpht.com/DD34z2cuvofshyMqW9_cKaDSxHHR1U8rijLItBRgDOyOvVQ5SLNNqQ5lLsfVW6elPW-Usxq2=s64-c-k-c0x00ffffff-no-rj", "message": "bi bi"}, {"type": "subtitle", "time": 18081.23, "timestamp": "05:01:21", "text": "印度早晨。所以"}, {"type": "subtitle", "time": 18084.39, "timestamp": "05:01:24", "text": "早安"}, {"type": "subtitle", "time": 18086.23, "timestamp": "05:01:26", "text": "在印度。那些"}, {"type": "subtitle", "time": 18088.07, "timestamp": "05:01:28", "text": "請代朋友轉達"}, {"type": "subtitle", "time": 18091.47, "timestamp": "05:01:31", "text": "祝你今天過得愉快，感謝你的辛勤工作。"}, {"type": "subtitle", "time": 18095.47, "timestamp": "05:01:35", "text": "就是這樣。非常感謝你們的到來。"}, {"type": "subtitle", "time": 18102.19, "timestamp": "05:01:42", "text": "我們明天直播再見。"}, {"type": "subtitle", "time": 18106.91, "timestamp": "05:01:46", "text": "我非常感謝你今天能來。"}, {"type": "subtitle", "time": 18111.23, "timestamp": "05:01:51", "text": "我也這麼認為。啊，還有維布斯"}, {"type": "subtitle", "time": 18115.628, "timestamp": "05:01:55", "text": "我很喜歡這個故事，也很喜歡今天的一切。"}, {"type": "subtitle", "time": 18118.11, "timestamp": "05:01:58", "text": "寶藏"}]
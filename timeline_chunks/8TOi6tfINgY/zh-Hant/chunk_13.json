[{"type": "subtitle", "time": 799.67, "timestamp": "00:13:19", "text": "那隻兔子把自己帶進了它進去的任何地方。"}, {"type": "subtitle", "time": 802.269, "timestamp": "00:13:22", "text": "他們害怕什麼，以及他們對什麼視而不見"}, {"type": "subtitle", "time": 805.15, "timestamp": "00:13:25", "text": "面對面站著。看來志賀先生的情況就是如此。"}, {"type": "subtitle", "time": 806.99, "timestamp": "00:13:26", "text": "到。"}, {"type": "subtitle", "time": 810.949, "timestamp": "00:13:30", "text": "地下學院的怪事仍在繼續。一些學生"}, {"type": "subtitle", "time": 814.23, "timestamp": "00:13:34", "text": "教師中也出現過與她類似的問題。"}, {"type": "subtitle", "time": 827.87, "timestamp": "00:13:47", "text": "組織首領曾向你和柳教授發出警告。"}, {"type": "subtitle", "time": 831.389, "timestamp": "00:13:51", "text": "綜上所述，那隻兔子就是弗拉克特"}, {"type": "subtitle", "time": 834.87, "timestamp": "00:13:54", "text": "感覺這真的像是Sides留下的陷阱。"}, {"type": "subtitle", "time": 838.31, "timestamp": "00:13:58", "text": "我曾經使用如此低俗的手段傷害我的學生和同事。"}]
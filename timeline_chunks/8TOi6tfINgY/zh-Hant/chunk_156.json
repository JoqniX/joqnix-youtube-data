[{"type": "subtitle", "time": 9370.75, "timestamp": "02:36:10", "text": "1"}, {"type": "subtitle", "time": 9371.182, "timestamp": "02:36:11", "text": "我們必須親自面對危險。"}, {"type": "subtitle", "time": 9403.349, "timestamp": "02:36:43", "text": "[清喉嚨]"}, {"type": "subtitle", "time": 9409.51, "timestamp": "02:36:49", "text": "是的。"}, {"type": "subtitle", "time": 9411.138, "timestamp": "02:36:51", "text": "這裡的人會盡量保持溝通，但他們都有車。"}, {"type": "subtitle", "time": 9415.75, "timestamp": "02:36:55", "text": "是的。"}, {"type": "subtitle", "time": 9418.55, "timestamp": "02:36:58", "text": "我明白。"}]
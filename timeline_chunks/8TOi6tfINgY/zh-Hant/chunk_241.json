[{"type": "subtitle", "time": 14460.469, "timestamp": "04:01:00", "text": "明白了，但是這個組織的副負責人是你。"}, {"type": "subtitle", "time": 14463.87, "timestamp": "04:01:03", "text": "他們派我去執行另一項任務，從而發現了真相和弱點。"}, {"type": "subtitle", "time": 14473.03, "timestamp": "04:01:13", "text": "順便說一句，為了繼續履行組織領導的重要職責。"}, {"type": "subtitle", "time": 14475.67, "timestamp": "04:01:15", "text": "到"}, {"type": "subtitle", "time": 14479.71, "timestamp": "04:01:19", "text": "這次會議沒有必要。我去了弗洛巴家。"}, {"type": "subtitle", "time": 14481.83, "timestamp": "04:01:21", "text": "它要來了。"}, {"type": "subtitle", "time": 14485.269, "timestamp": "04:01:25", "text": "我們就先說到這裡吧。"}, {"type": "subtitle", "time": 14497.91, "timestamp": "04:01:37", "text": "沒必要。"}]
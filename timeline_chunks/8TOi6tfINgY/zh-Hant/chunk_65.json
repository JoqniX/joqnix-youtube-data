[{"type": "subtitle", "time": 3906.549, "timestamp": "01:05:06", "text": "既可怕又令人驚嘆"}, {"type": "subtitle", "time": 3908.109, "timestamp": "01:05:08", "text": "美麗的"}, {"type": "subtitle", "time": 3910.385, "timestamp": "01:05:10", "text": "可愛的"}, {"type": "subtitle", "time": 3925.19, "timestamp": "01:05:25", "text": "警惕靠近的人。"}, {"type": "subtitle", "time": 3927.829, "timestamp": "01:05:27", "text": "在地下學院裡發現的那隻兔子是什麼品種的兔子？"}, {"type": "subtitle", "time": 3931.39, "timestamp": "01:05:31", "text": "我甚至可以改變我的外表。這個房間有一條走廊"}, {"type": "subtitle", "time": 3934.029, "timestamp": "01:05:34", "text": "只有一個。他們可能還在躲藏。"}]
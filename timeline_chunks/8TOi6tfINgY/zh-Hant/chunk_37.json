[{"type": "subtitle", "time": 2228.91, "timestamp": "00:37:08", "text": "明星賽被打斷了，但替補隊員"}, {"type": "subtitle", "time": 2231.95, "timestamp": "00:37:11", "text": "你的行為是出於正義，這點毋庸置疑。"}, {"type": "subtitle", "time": 2242.55, "timestamp": "00:37:22", "text": "該團體目前迫切需要技術進步。"}, {"type": "subtitle", "time": 2246.47, "timestamp": "00:37:26", "text": "它們確實存在。這條指示是我發給你的私人資訊。"}, {"type": "subtitle", "time": 2269.069, "timestamp": "00:37:49", "text": "嗯，顯然"}]
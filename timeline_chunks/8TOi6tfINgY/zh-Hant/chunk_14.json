[{"type": "subtitle", "time": 840.43, "timestamp": "00:14:00", "text": "你怎麼能傷害我？"}, {"type": "subtitle", "time": 842.91, "timestamp": "00:14:02", "text": "身為校長，我不能對此視而不見。"}, {"type": "subtitle", "time": 844.92, "timestamp": "00:14:04", "text": "。 一隻看起來像果化石的兔子"}, {"type": "subtitle", "time": 847.519, "timestamp": "00:14:07", "text": "一隻看起來像果化石的兔子 你應該利用這一點來發揮自己的優勢。"}, {"type": "subtitle", "time": 855.189, "timestamp": "00:14:15", "text": "為了找出異常情況的原因，人們將兔子引誘出來並捕獲。"}, {"type": "subtitle", "time": 859.269, "timestamp": "00:14:19", "text": "解決。憑藉我的能力，從兔子"}, {"type": "subtitle", "time": 862.99, "timestamp": "00:14:22", "text": "我正在尋找有關果糖苷的資訊。俱樂部活動"}, {"type": "subtitle", "time": 865.59, "timestamp": "00:14:25", "text": "如果我們引入學術界的力量，他們或許會注意到。"}, {"type": "subtitle", "time": 869.629, "timestamp": "00:14:29", "text": "沒有。所以，小規模聚會時更需要謹慎行事。"}, {"type": "subtitle", "time": 874.749, "timestamp": "00:14:34", "text": "有。一個值得信賴且了解地下學院的人。"}]
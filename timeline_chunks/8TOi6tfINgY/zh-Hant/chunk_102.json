[{"type": "subtitle", "time": 6120.709, "timestamp": "01:42:00", "text": "最近"}, {"type": "subtitle", "time": 6125.229, "timestamp": "01:42:05", "text": "我姐姐用鈴鐺。為了實現你的願望，鈴鐺"}, {"type": "subtitle", "time": 6130.39, "timestamp": "01:42:10", "text": "透過權力借用自身未來的潛能。"}, {"type": "subtitle", "time": 6131.91, "timestamp": "01:42:11", "text": "姊姊"}, {"type": "subtitle", "time": 6135.47, "timestamp": "01:42:15", "text": "請以巫女的身份，認清鐘聲。"}, {"type": "subtitle", "time": 6138.91, "timestamp": "01:42:18", "text": "我將接管。"}, {"type": "subtitle", "time": 6144.03, "timestamp": "01:42:24", "text": "完全沒問題。更重要的是，Chandou"}, {"type": "subtitle", "time": 6147.51, "timestamp": "01:42:27", "text": "你總是會想這類事情嗎？"}, {"type": "subtitle", "time": 6154.79, "timestamp": "01:42:34", "text": "做夢是好事，但對你來說還太早了。"}, {"type": "subtitle", "time": 6155.04, "timestamp": "01:42:35", "text": "。 與其談論鈴鐺之類的東西，不如和姊姊在櫻花樹下練習射箭，這樣豈不是很無聊嗎？你"}, {"type": "subtitle", "time": 6171.51, "timestamp": "01:42:51", "text": "哦，你真的不想吃嗎？"}]
[{"type": "subtitle", "time": 7754.709, "timestamp": "02:09:14", "text": "即使你醒來"}, {"type": "subtitle", "time": 7779.149, "timestamp": "02:09:39", "text": "因此，它們的觀點最為相似。"}, {"type": "subtitle", "time": 7783.109, "timestamp": "02:09:43", "text": "Exostrider 還增加了一個諧振器"}, {"type": "subtitle", "time": 7786.629, "timestamp": "02:09:46", "text": "我以為這樣能增強我的力量。"}, {"type": "subtitle", "time": 7789.43, "timestamp": "02:09:49", "text": "但是你和Exostrider"}, {"type": "subtitle", "time": 7794.069, "timestamp": "02:09:54", "text": "考慮到這種關係，測試系統將"}, {"type": "subtitle", "time": 7798.149, "timestamp": "02:09:58", "text": "我建議使用一種叫做外部共振的方法。"}]
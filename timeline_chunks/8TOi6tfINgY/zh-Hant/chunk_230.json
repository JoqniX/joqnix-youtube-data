[{"type": "subtitle", "time": 13823.67, "timestamp": "03:50:23", "text": "鸕鶿，"}, {"type": "subtitle", "time": 13849.349, "timestamp": "03:50:49", "text": "植入人體的竟然是一顆嚴重萎縮的人體心臟。"}, {"type": "subtitle", "time": 13853.189, "timestamp": "03:50:53", "text": "這是我的判斷。"}, {"type": "subtitle", "time": 13857.11, "timestamp": "03:50:57", "text": "這個名字源自於力量，而「疾行者之門」已經完工。"}]
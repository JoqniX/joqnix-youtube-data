[{"type": "subtitle", "time": 603.829, "timestamp": "00:10:03", "text": "？呃，我眼花了嗎？好的，我"}, {"type": "subtitle", "time": 624.71, "timestamp": "00:10:24", "text": "眼花了。"}, {"type": "subtitle", "time": 627.99, "timestamp": "00:10:27", "text": "抱歉。呃，好的。你好，呃，Valerent。很抱歉出現技術問題。他們把整個使用者介面都改了。太瘋狂了。他們介面什麼的全變了。我在線上嗎？我應該離線才對。搞什麼鬼？等等，等等，等等。什麼？我"}, {"type": "subtitle", "time": 630.55, "timestamp": "00:10:30", "text": "應該離線才對。"}, {"type": "subtitle", "time": 634.069, "timestamp": "00:10:34", "text": "初始狀態顯示離線。是啊，我現在"}, {"type": "subtitle", "time": 635.509, "timestamp": "00:10:35", "text": "離線了。是啊，別在意。我"}, {"type": "subtitle", "time": 637.509, "timestamp": "00:10:37", "text": "離線了。是啊，沒人能看到"}, {"type": "subtitle", "time": 640.15, "timestamp": "00:10:40", "text": "我在玩遊戲。 [倒吸一口氣]這是什麼"}, {"type": "subtitle", "time": 643.829, "timestamp": "00:10:43", "text": "？隨機的。全是同一陣營的。這是什麼"}, {"type": "subtitle", "time": 653.829, "timestamp": "00:10:53", "text": "現在好多東西啊。"}]
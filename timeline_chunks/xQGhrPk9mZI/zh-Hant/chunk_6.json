[{"type": "subtitle", "time": 365.43, "timestamp": "00:06:05", "text": "好的。我們準備好了。"}, {"type": "subtitle", "time": 368.15, "timestamp": "00:06:08", "text": "準備好了嗎？好的。嗯，全是"}, {"type": "subtitle", "time": 370.07, "timestamp": "00:06:10", "text": "螢幕。"}, {"type": "subtitle", "time": 372.15, "timestamp": "00:06:12", "text": "給我一分鐘。"}, {"type": "subtitle", "time": 375.029, "timestamp": "00:06:15", "text": "呃，"}, {"type": "subtitle", "time": 377.189, "timestamp": "00:06:17", "text": "為什麼創建補丁不起作用？"}, {"type": "subtitle", "time": 380.71, "timestamp": "00:06:20", "text": "哦，創建訊息，夥計。"}, {"type": "subtitle", "time": 382.309, "timestamp": "00:06:22", "text": "好的。"}, {"type": "subtitle", "time": 384.39, "timestamp": "00:06:24", "text": "快點。好的"}, {"type": "subtitle", "time": 386.95, "timestamp": "00:06:26", "text": "。我直播的公告馬上就會自動發出，我們"}, {"type": "subtitle", "time": 391.67, "timestamp": "00:06:31", "text": "現在就"}, {"type": "subtitle", "time": 399.43, "timestamp": "00:06:39", "text": "做補丁。好的。快點。"}, {"type": "subtitle", "time": 409.43, "timestamp": "00:06:49", "text": "[笑聲] 我討厭這玩意兒。為什麼"}, {"type": "subtitle", "time": 411.909, "timestamp": "00:06:51", "text": "它會壞？每次我想"}, {"type": "subtitle", "time": 415.43, "timestamp": "00:06:55", "text": "直播，它都做不到。不。"}]
[{"type": "subtitle", "time": 2822.79, "timestamp": "00:47:02", "text": "我的直播斷了嗎？怎麼回事？敵方中路。發現敵方。你想……玩？開始玩吧。還剩一個敵人。我的大招準備好了。還剩30秒。他們怎麼不"}, {"type": "subtitle", "time": 2828.55, "timestamp": "00:47:08", "text": "玩？開始玩吧。"}, {"type": "subtitle", "time": 2860.79, "timestamp": "00:47:40", "text": "最後一名玩家存活。還剩10秒。啊，該死的延遲和崩潰又出現了。"}, {"type": "subtitle", "time": 2867.589, "timestamp": "00:47:47", "text": "我的天。等等，崩潰的是什麼？直播播音員還是事件"}]
[{"type": "subtitle", "time": 302.79, "timestamp": "00:05:02", "text": "例如，我可以"}, {"type": "subtitle", "time": 306.23, "timestamp": "00:05:06", "text": "為Twitch和YouTube的直播頻道加個投票系統，讓觀眾"}, {"type": "subtitle", "time": 308.469, "timestamp": "00:05:08", "text": "可以投票決定想看什麼類型的內容。"}, {"type": "subtitle", "time": 311.749, "timestamp": "00:05:11", "text": "我當時就"}, {"type": "subtitle", "time": 314.23, "timestamp": "00:05:14", "text": "收集想法，把"}, {"type": "subtitle", "time": 317.67, "timestamp": "00:05:17", "text": "它們寫下來。然後我就睡了。醒得也晚了"}, {"type": "subtitle", "time": 323.27, "timestamp": "00:05:23", "text": "總之，好了。"}, {"type": "subtitle", "time": 327.51, "timestamp": "00:05:27", "text": "讓我切換到遊戲。"}, {"type": "subtitle", "time": 340.95, "timestamp": "00:05:40", "text": "好的。什麼？"}, {"type": "subtitle", "time": 343.909, "timestamp": "00:05:43", "text": "給我一分鐘。我把瓦萊林的快捷鍵綁定到了"}]
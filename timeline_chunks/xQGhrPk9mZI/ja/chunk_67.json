[{"type": "subtitle", "time": 4021.109, "timestamp": "01:07:01", "text": "設定が削除されたの？"}, {"type": "subtitle", "time": 4024.39, "timestamp": "01:07:04", "text": "こんにちは、ナン・ラジバード。ようこそ。こんにちは。こんにちは。元気だよ"}, {"type": "subtitle", "time": 4032.789, "timestamp": "01:07:12", "text": "久しぶりだね。君のプレイは見ていたよ。"}, {"type": "subtitle", "time": 4034.47, "timestamp": "01:07:14", "text": "ああ、"}, {"type": "subtitle", "time": 4073.349, "timestamp": "01:07:53", "text": "どうやってあのショットを打ったんだ？"}, {"type": "subtitle", "time": 4076.23, "timestamp": "01:07:56", "text": "アルティメット準備完了。イニシエート。"}]
[{"type": "subtitle", "time": 1163.11, "timestamp": "00:19:23", "text": "デスマッチ。ウォーミングアップ。"}, {"type": "subtitle", "time": 1165.19, "timestamp": "00:19:25", "text": "しばらくこのゲームをしていないので、"}, {"type": "subtitle", "time": 1168.789, "timestamp": "00:19:28", "text": "状況がわかりません。"}, {"type": "subtitle", "time": 1171.19, "timestamp": "00:19:31", "text": "感度がこんなに低いのですか？"}, {"type": "subtitle", "time": 1180.47, "timestamp": "00:19:40", "text": "191。 どうしてこんなに低いのですか？ まだ3です。 わかりました"}]
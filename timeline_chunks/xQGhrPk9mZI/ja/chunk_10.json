[{"type": "subtitle", "time": 606.55, "timestamp": "00:10:06", "text": "ごめん。えっと、わかった"}, {"type": "subtitle", "time": 609.99, "timestamp": "00:10:09", "text": "。こんにちは、えっと、Valerent。"}, {"type": "subtitle", "time": 613.11, "timestamp": "00:10:13", "text": "技術的な問題でごめんなさい。UIが"}, {"type": "subtitle", "time": 615.509, "timestamp": "00:10:15", "text": "全部変わって 全部。"}, {"type": "subtitle", "time": 622.79, "timestamp": "00:10:22", "text": "とか全部変えられた。"}, {"type": "subtitle", "time": 624.71, "timestamp": "00:10:24", "text": "オンライン？オフラインのはずなのに。"}, {"type": "subtitle", "time": 627.99, "timestamp": "00:10:27", "text": "一体全体？待って、待って、待って。何？"}, {"type": "subtitle", "time": 630.55, "timestamp": "00:10:30", "text": "オフラインのはずなのに。"}, {"type": "subtitle", "time": 634.069, "timestamp": "00:10:34", "text": "初心者はオフラインってタイプする。うん、今"}, {"type": "subtitle", "time": 635.509, "timestamp": "00:10:35", "text": "オフラインだよ。うん、気にしないで。"}, {"type": "subtitle", "time": 637.509, "timestamp": "00:10:37", "text": "オフラインだよ。うん、"}, {"type": "subtitle", "time": 640.15, "timestamp": "00:10:40", "text": "私がゲームをプレイしていることは誰にも見えない。[息を呑む]"}, {"type": "subtitle", "time": 643.829, "timestamp": "00:10:43", "text": "これは何？ランダム。全部片側。これは何"}, {"type": "subtitle", "time": 653.829, "timestamp": "00:10:53", "text": "今はたくさんのもの。"}]
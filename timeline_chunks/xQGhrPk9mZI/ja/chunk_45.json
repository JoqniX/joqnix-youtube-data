[{"type": "subtitle", "time": 2700.15, "timestamp": "00:45:00", "text": "最後のプレイヤーが立っている。残り10秒。"}, {"type": "subtitle", "time": 2702.069, "timestamp": "00:45:02", "text": "ああ、"}, {"type": "subtitle", "time": 2705.91, "timestamp": "00:45:05", "text": "このひどいラグとクラッシュが現れる。なんてことだ。"}, {"type": "subtitle", "time": 2710.79, "timestamp": "00:45:10", "text": "待って、でも何のクラッシュだったんだ？"}, {"type": "subtitle", "time": 2713.67, "timestamp": "00:45:13", "text": "配信アナウンサーか"}]
[{"type": "subtitle", "time": 1032.47, "timestamp": "00:17:12", "text": "待って。誰が食い尽くしてるんだ？なんてこった。"}, {"type": "subtitle", "time": 1037.029, "timestamp": "00:17:17", "text": "誰が、えーと、"}, {"type": "subtitle", "time": 1045.11, "timestamp": "00:17:25", "text": "待って、どうして誇張してるんだ？"}, {"type": "subtitle", "time": 1048.95, "timestamp": "00:17:28", "text": "ああ、まあ、とにかくプレイするよ。"}, {"type": "subtitle", "time": 1055.669, "timestamp": "00:17:35", "text": "えーと、一致する"}, {"type": "subtitle", "time": 1063.909, "timestamp": "00:17:43", "text": "見えるはずなんだっけ？よし、今は"}, {"type": "subtitle", "time": 1066.23, "timestamp": "00:17:46", "text": "動いている。わかった"}, {"type": "subtitle", "time": 1067.909, "timestamp": "00:17:47", "text": "、"}, {"type": "subtitle", "time": 1069.99, "timestamp": "00:17:49", "text": "教えてくれ ラグがあるかどうか。直します。わかりました。"}]
[{"type": "subtitle", "time": 5343.43, "timestamp": "01:29:03", "text": "今日はインターネットの調子がちょっとおかしいんだ。"}, {"type": "subtitle", "time": 5347.03, "timestamp": "01:29:07", "text": "上がったり下がったり。"}, {"type": "subtitle", "time": 5350.229, "timestamp": "01:29:10", "text": "ああ、楽しかった。"}, {"type": "subtitle", "time": 5353.189, "timestamp": "01:29:13", "text": "ここで切り上げよう。いや。"}, {"type": "subtitle", "time": 5355.99, "timestamp": "01:29:15", "text": "みんな、"}, {"type": "subtitle", "time": 5359.27, "timestamp": "01:29:19", "text": "俺のLordのプレイを見て楽しんでくれたかな？"}, {"type": "subtitle", "time": 5363.51, "timestamp": "01:29:23", "text": "少しの時間でも、"}, {"type": "subtitle", "time": 5365.669, "timestamp": "01:29:25", "text": "今日は楽しかったよ。それでは、"}, {"type": "subtitle", "time": 5371.189, "timestamp": "01:29:31", "text": "短い配信を見てくれてありがとう。"}, {"type": "subtitle", "time": 5375.59, "timestamp": "01:29:35", "text": "日曜日の試験が終わったら、"}, {"type": "subtitle", "time": 5378.07, "timestamp": "01:29:38", "text": "月曜日以降はなるべく"}, {"type": "subtitle", "time": 5381.43, "timestamp": "01:29:41", "text": "長い配信をやろうと思う。そうそう。"}, {"type": "subtitle", "time": 5383.35, "timestamp": "01:29:43", "text": "それと、舞台裏で技術的な問題がいくつかあったんだ"}, {"type": "subtitle", "time": 5387.27, "timestamp": "01:29:47", "text": "。"}, {"type": "subtitle", "time": 5390.55, "timestamp": "01:29:50", "text": "うーん、それも全部直さなきゃいけないんだ"}, {"type": "subtitle", "time": 5392.31, "timestamp": "01:29:52", "text": "。[笑い] すごく頭が"}, {"type": "subtitle", "time": 5394.149, "timestamp": "01:29:54", "text": "痛い。"}, {"type": "subtitle", "time": 5397.11, "timestamp": "01:29:57", "text": "でも、今日は楽しかった。"}]
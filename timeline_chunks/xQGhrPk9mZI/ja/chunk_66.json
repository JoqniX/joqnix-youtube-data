[{"type": "subtitle", "time": 3961.99, "timestamp": "01:06:01", "text": "うーん、すごくクールだ。"}, {"type": "subtitle", "time": 3964.39, "timestamp": "01:06:04", "text": "お金は使いたくない。私は、私はもう"}, {"type": "subtitle", "time": 3979.029, "timestamp": "01:06:19", "text": "大丈夫。あなたはどう？私も"}, {"type": "subtitle", "time": 3987.91, "timestamp": "01:06:27", "text": "久しぶりだったので、"}, {"type": "subtitle", "time": 3990.95, "timestamp": "01:06:30", "text": "このゲームをプレイしようと思った。どうやら"}, {"type": "subtitle", "time": 3999.51, "timestamp": "01:06:39", "text": "それから、私は ちょっと愚痴をこぼす。オーケー。"}, {"type": "subtitle", "time": 4002.39, "timestamp": "01:06:42", "text": "ライアットゲームズの新しいランチャーはどうしてこんなに"}, {"type": "subtitle", "time": 4004.549, "timestamp": "01:06:44", "text": "ひどいんだ？"}, {"type": "subtitle", "time": 4007.51, "timestamp": "01:06:47", "text": "ゲームをアンインストールするにはどうすればいい？"}, {"type": "subtitle", "time": 4010.309, "timestamp": "01:06:50", "text": "適切なインストール場所"}, {"type": "subtitle", "time": 4012.23, "timestamp": "01:06:52", "text": "とかはどうやって変更するんだ？"}, {"type": "subtitle", "time": 4016.309, "timestamp": "01:06:56", "text": "ランチャーの設定が見つからない。え"}, {"type": "subtitle", "time": 4018.549, "timestamp": "01:06:58", "text": "？あ、なんで"}]
[{"type": "subtitle", "time": 1805.43, "timestamp": "00:30:05", "text": "ああ、わかった。わかった。わかった。私は"}, {"type": "subtitle", "time": 1809.83, "timestamp": "00:30:09", "text": "仕組みはなんとなく理解できた。だから"}, {"type": "subtitle", "time": 1813.75, "timestamp": "00:30:13", "text": "ステージごとに、えーっと、えーっと、ステージごとに、えーっと、"}, {"type": "subtitle", "time": 1817.909, "timestamp": "00:30:17", "text": "チームが排除される感じ。何？こんにちは"}]
[{"type": "subtitle", "time": 365.43, "timestamp": "00:06:05", "text": "オーケー。準備はできた。"}, {"type": "subtitle", "time": 368.15, "timestamp": "00:06:08", "text": "準備はいいかい？オーケー。えー、"}, {"type": "subtitle", "time": 370.07, "timestamp": "00:06:10", "text": "画面が全部映ってる。"}, {"type": "subtitle", "time": 372.15, "timestamp": "00:06:12", "text": "ちょっと待って。"}, {"type": "subtitle", "time": 375.029, "timestamp": "00:06:15", "text": "えー、"}, {"type": "subtitle", "time": 377.189, "timestamp": "00:06:17", "text": "なぜパッチ作成が機能しないんだ？"}, {"type": "subtitle", "time": 380.71, "timestamp": "00:06:20", "text": "おっと、メッセージを作成して。オーケー"}, {"type": "subtitle", "time": 382.309, "timestamp": "00:06:22", "text": "。お願い。"}, {"type": "subtitle", "time": 386.95, "timestamp": "00:06:26", "text": "オーケー。もうすぐ自動的にライブ配信中というアナウンスが流れるから、"}, {"type": "subtitle", "time": 399.43, "timestamp": "00:06:39", "text": "2番目のパッチを当てるんだ。うん。お願い。お願い。"}, {"type": "subtitle", "time": 409.43, "timestamp": "00:06:49", "text": "[笑い]これが嫌いだ。なぜ"}, {"type": "subtitle", "time": 411.909, "timestamp": "00:06:51", "text": "壊れるんだ？配信したいときにいつもできないんだ"}, {"type": "subtitle", "time": 415.43, "timestamp": "00:06:55", "text": "。いや。"}]
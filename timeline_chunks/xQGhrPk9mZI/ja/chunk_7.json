[{"type": "subtitle", "time": 425.11, "timestamp": "00:07:05", "text": "いや、兄弟。いや、いや、いや、いや、いや、いや、いや、兄弟。いや、いや、いや、いや、いや、いや"}, {"type": "subtitle", "time": 441.029, "timestamp": "00:07:21", "text": "一体全体？"}, {"type": "subtitle", "time": 447.749, "timestamp": "00:07:27", "text": "昨日は修正されなかったの？オーケー。ああ、オーケー。ゲーム。しまった。ごめん。"}, {"type": "subtitle", "time": 451.35, "timestamp": "00:07:31", "text": "テストしてないんだ"}, {"type": "subtitle", "time": 455.99, "timestamp": "00:07:35", "text": "[息を呑む]"}, {"type": "subtitle", "time": 458.07, "timestamp": "00:07:38", "text": "オーケー。ヴァレランド、"}]
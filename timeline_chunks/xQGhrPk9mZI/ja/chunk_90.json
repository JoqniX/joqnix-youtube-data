[{"type": "subtitle", "time": 5401.59, "timestamp": "01:30:01", "text": "今日は時間を割いて見てくれて、"}, {"type": "subtitle", "time": 5404.709, "timestamp": "01:30:04", "text": "応援してくれてありがとう。本当にありがたい"}, {"type": "subtitle", "time": 5406.79, "timestamp": "01:30:06", "text": "。話してくれたり、"}, {"type": "subtitle", "time": 5409.75, "timestamp": "01:30:09", "text": "話しかけてくれたりもありがとう。さて、また"}, {"type": "subtitle", "time": 5413.75, "timestamp": "01:30:13", "text": "会おうね。 明日。明日って何があるんだろう"}, {"type": "subtitle", "time": 5415.91, "timestamp": "01:30:15", "text": "？うん。じゃあ、また"}, {"type": "subtitle", "time": 5422.149, "timestamp": "01:30:22", "text": "フォートナイトをやると思う。よくわからない。状況次第。もしかしたら"}, {"type": "subtitle", "time": 5426.47, "timestamp": "01:30:26", "text": "アークかも。どうなるかはわからないけど"}]
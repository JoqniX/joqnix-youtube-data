[{"type": "subtitle", "time": 243.75, "timestamp": "00:04:03", "text": "少しだけ設定を改良中です"}, {"type": "subtitle", "time": 245.429, "timestamp": "00:04:05", "text": "。"}, {"type": "subtitle", "time": 249.19, "timestamp": "00:04:09", "text": "少し。 そうですね、"}, {"type": "subtitle", "time": 257.83, "timestamp": "00:04:17", "text": "私が見ていたジョブ ストリームでは、先ほど"}, {"type": "subtitle", "time": 261.992, "timestamp": "00:04:21", "text": "今日のエチオピアのスピードを示しました。 そうですね"}, {"type": "subtitle", "time": 264.79, "timestamp": "00:04:24", "text": "（笑）。本当は"}, {"type": "subtitle", "time": 268.79, "timestamp": "00:04:28", "text": "朝に配信したかったんですが、すごく疲れていたんです。"}, {"type": "subtitle", "time": 271.189, "timestamp": "00:04:31", "text": "昨日は確か午前6時くらいに寝たと思う。"}, {"type": "subtitle", "time": 276.39, "timestamp": "00:04:36", "text": "昨日の配信の後、"}, {"type": "subtitle", "time": 279.03, "timestamp": "00:04:39", "text": "「ああ、"}, {"type": "subtitle", "time": 280.87, "timestamp": "00:04:40", "text": "これを直さなきゃ」って思ったんだ。"}, {"type": "subtitle", "time": 288.79, "timestamp": "00:04:48", "text": "配信を始めた時にバックエンドで7回くらいクラッシュしたから。さて、全部直さなきゃ"}, {"type": "subtitle", "time": 291.909, "timestamp": "00:04:51", "text": "。Chad GPTと少し話して、"}, {"type": "subtitle", "time": 294.15, "timestamp": "00:04:54", "text": "いくつか修正方法を聞いたら、24時間"}, {"type": "subtitle", "time": 298.629, "timestamp": "00:04:58", "text": "365日チャンネルのクレイジーなアイデアが浮かんだ。Twitch"}]
[{"type": "subtitle", "time": 671.91, "timestamp": "00:11:11", "text": "でもこれは何？"}, {"type": "subtitle", "time": 679.2, "timestamp": "00:11:19", "text": "何？ これは一体何？なぜ"}, {"type": "subtitle", "time": 692.15, "timestamp": "00:11:32", "text": "盗賊の友達。FTW"}, {"type": "subtitle", "time": 699.75, "timestamp": "00:11:39", "text": "プラットフォームでFTWにアクセスしてください。FTW"}, {"type": "subtitle", "time": 704.949, "timestamp": "00:11:44", "text": "え？"}, {"type": "subtitle", "time": 707.509, "timestamp": "00:11:47", "text": "勝利のために。勝利のためには、国や地域で複数の種類のチャレンジ"}, {"type": "subtitle", "time": 709.11, "timestamp": "00:11:49", "text": "に参加できるレアなチャレンジランです"}, {"type": "subtitle", "time": 713.35, "timestamp": "00:11:53", "text": "。"}, {"type": "subtitle", "time": 715.269, "timestamp": "00:11:55", "text": "創造性を解き放ち、"}]
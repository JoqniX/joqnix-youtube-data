[{"type": "subtitle", "time": 5283.51, "timestamp": "01:28:03", "text": "ああ、そうだ。ブループロトコル。新シーズンが"}, {"type": "subtitle", "time": 5286.47, "timestamp": "01:28:06", "text": "来るんだよね？"}, {"type": "subtitle", "time": 5290.95, "timestamp": "01:28:10", "text": "でも家にはいないよ。ああ"}, {"type": "subtitle", "time": 5300.79, "timestamp": "01:28:20", "text": "、もう18日だ。オーケー。"}, {"type": "subtitle", "time": 5303.43, "timestamp": "01:28:23", "text": "プレイする時間はあると思う。"}, {"type": "subtitle", "time": 5311.91, "timestamp": "01:28:31", "text": "やあ。えっと、"}, {"type": "subtitle", "time": 5315.189, "timestamp": "01:28:35", "text": "どれくらいプレイしたかな 今日は？そろそろ"}, {"type": "subtitle", "time": 5339.669, "timestamp": "01:28:59", "text": "それと、"}]
[{"type": "subtitle", "time": 186.229, "timestamp": "00:03:06", "text": "私が Valerant をプレイする 42 回目の [音楽] えっと [笑い] シリーズになります。"}, {"type": "subtitle", "time": 189.03, "timestamp": "00:03:09", "text": "新しい銃とか"}, {"type": "subtitle", "time": 191.43, "timestamp": "00:03:11", "text": "新しいエージェントとかが出てきて、"}, {"type": "subtitle", "time": 195.837, "timestamp": "00:03:15", "text": "ワイパーも下がったって聞いたよ"}, {"type": "subtitle", "time": 196.79, "timestamp": "00:03:16", "text": "[笑い]"}, {"type": "subtitle", "time": 199.27, "timestamp": "00:03:19", "text": "今戦闘で下がってるよ、クレイジー、本当に"}, {"type": "subtitle", "time": 204.149, "timestamp": "00:03:24", "text": "たくさんのことが起こってて面白いよ。それで、"}, {"type": "subtitle", "time": 210.47, "timestamp": "00:03:30", "text": "今日は"}, {"type": "subtitle", "time": 214.55, "timestamp": "00:03:34", "text": "それについて詳しく掘り下げていこうと思うので、もちろん"}, {"type": "subtitle", "time": 218.39, "timestamp": "00:03:38", "text": "マロランドについても掘り下げていくつもりです。"}, {"type": "subtitle", "time": 222.309, "timestamp": "00:03:42", "text": "1秒。 ちょっと待ってください"}, {"type": "subtitle", "time": 226.149, "timestamp": "00:03:46", "text": "。 ちょっと待ってください。 ああ。"}, {"type": "subtitle", "time": 231.589, "timestamp": "00:03:51", "text": "アナウンスは行われませんでした。 神。"}, {"type": "subtitle", "time": 233.67000000000002, "timestamp": "00:03:53", "text": "うん。 昨日と同じように、このストリームでも"}, {"type": "subtitle", "time": 235.43, "timestamp": "00:03:55", "text": "、"}, {"type": "subtitle", "time": 238.47, "timestamp": "00:03:58", "text": "あちこちで技術的な問題が発生するでしょう。 気にしないでください。   やめてください。   まだ"}]
[{"type": "subtitle", "time": 3004.23, "timestamp": "00:50:04", "text": "そしてこの新しいバンディットガンはいい。"}, {"type": "subtitle", "time": 3006.79, "timestamp": "00:50:06", "text": "本当にいい。"}, {"type": "subtitle", "time": 3011.91, "timestamp": "00:50:11", "text": "ハートみたい。"}, {"type": "subtitle", "time": 3014.47, "timestamp": "00:50:14", "text": "今のゴーストにハートがある。"}, {"type": "subtitle", "time": 3018.15, "timestamp": "00:50:18", "text": "新しいやつかな、"}, {"type": "subtitle", "time": 3021.19, "timestamp": "00:50:21", "text": "赤いハートみたいなやつ。"}, {"type": "subtitle", "time": 3044.95, "timestamp": "00:50:44", "text": "リロード。"}, {"type": "subtitle", "time": 3053.27, "timestamp": "00:50:53", "text": "ああ、いいね。回復。回復。回復。いいぞ。走る"}, {"type": "subtitle", "time": 3056.95, "timestamp": "00:50:56", "text": "。"}, {"type": "subtitle", "time": 3058.549, "timestamp": "00:50:58", "text": "ああ、いいショット。"}]
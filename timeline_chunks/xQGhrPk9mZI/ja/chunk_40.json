[{"type": "subtitle", "time": 2404.23, "timestamp": "00:40:04", "text": "私はハンターだ。"}, {"type": "subtitle", "time": 2409.109, "timestamp": "00:40:09", "text": "アルティメット準備完了、墓の囮"}, {"type": "subtitle", "time": 2427.51, "timestamp": "00:40:27", "text": "ああ、なぜ私なの？"}, {"type": "subtitle", "time": 2430.069, "timestamp": "00:40:30", "text": "最後のプレイヤーが立っている。もう一"}, {"type": "subtitle", "time": 2432.39, "timestamp": "00:40:32", "text": "歩じゃない。"}, {"type": "subtitle", "time": 2457.91, "timestamp": "00:40:57", "text": "ああ、そのゲームモードは良かった。"}]
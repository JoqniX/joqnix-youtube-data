[{"type": "subtitle", "time": 3004.23, "timestamp": "00:50:04", "text": "这把新的匪徒枪也不错。"}, {"type": "subtitle", "time": 3006.79, "timestamp": "00:50:06", "text": "真的很不错。"}, {"type": "subtitle", "time": 3011.91, "timestamp": "00:50:11", "text": "它就像一颗心。"}, {"type": "subtitle", "time": 3014.47, "timestamp": "00:50:14", "text": "现在的幽灵也有一颗心了。我想"}, {"type": "subtitle", "time": 3018.15, "timestamp": "00:50:18", "text": "它是新的之类的。"}, {"type": "subtitle", "time": 3021.19, "timestamp": "00:50:21", "text": "就像一颗红心之类的东西。"}, {"type": "subtitle", "time": 3044.95, "timestamp": "00:50:44", "text": "重新加载。"}, {"type": "subtitle", "time": 3053.27, "timestamp": "00:50:53", "text": "哦，不错。回血"}, {"type": "subtitle", "time": 3056.95, "timestamp": "00:50:56", "text": "。回血。回血。不错。跑。"}, {"type": "subtitle", "time": 3058.549, "timestamp": "00:50:58", "text": "啊，漂亮一击。"}]
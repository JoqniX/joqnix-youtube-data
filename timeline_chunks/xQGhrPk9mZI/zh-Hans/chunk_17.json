[{"type": "subtitle", "time": 1032.47, "timestamp": "00:17:12", "text": "等等。他在吃谁？"}, {"type": "subtitle", "time": 1037.029, "timestamp": "00:17:17", "text": "我的天哪。谁在……"}, {"type": "subtitle", "time": 1045.11, "timestamp": "00:17:25", "text": "等等，为什么我有“hyping”？"}, {"type": "subtitle", "time": 1048.95, "timestamp": "00:17:28", "text": "啊，伙计。我还是玩吧，伙计。"}, {"type": "subtitle", "time": 1055.669, "timestamp": "00:17:35", "text": "呃，"}, {"type": "subtitle", "time": 1058.47, "timestamp": "00:17:38", "text": "有匹配的"}, {"type": "subtitle", "time": 1063.909, "timestamp": "00:17:43", "text": "它应该看起来像这样吗？好的，现在可以了"}, {"type": "subtitle", "time": 1066.23, "timestamp": "00:17:46", "text": "。"}, {"type": "subtitle", "time": 1067.909, "timestamp": "00:17:47", "text": "好的，"}, {"type": "subtitle", "time": 1069.99, "timestamp": "00:17:49", "text": "告诉我我是否卡顿。我会"}]
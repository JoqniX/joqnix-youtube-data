[{"type": "subtitle", "time": 603.829, "timestamp": "00:10:03", "text": "我眼花了吗？好的，我眼花了"}, {"type": "subtitle", "time": 606.55, "timestamp": "00:10:06", "text": "。抱歉。呃，"}, {"type": "subtitle", "time": 609.99, "timestamp": "00:10:09", "text": "好的。你好，呃，Valerent。很"}, {"type": "subtitle", "time": 613.11, "timestamp": "00:10:13", "text": "抱歉出现技术问题。他们把"}, {"type": "subtitle", "time": 615.509, "timestamp": "00:10:15", "text": "整个用户界面都改了。太"}, {"type": "subtitle", "time": 622.79, "timestamp": "00:10:22", "text": "他们 界面什么的全变了。我"}, {"type": "subtitle", "time": 624.71, "timestamp": "00:10:24", "text": "在线吗？我应该离线才对。"}, {"type": "subtitle", "time": 627.99, "timestamp": "00:10:27", "text": "搞什么鬼？等等，等等，等等。什么？我"}, {"type": "subtitle", "time": 630.55, "timestamp": "00:10:30", "text": "应该离线才对。"}, {"type": "subtitle", "time": 634.069, "timestamp": "00:10:34", "text": "初始状态显示离线。是啊，我现在"}, {"type": "subtitle", "time": 635.509, "timestamp": "00:10:35", "text": "离线了。是啊，别在意。我"}, {"type": "subtitle", "time": 637.509, "timestamp": "00:10:37", "text": "离线了。是啊，没人能看到我在"}, {"type": "subtitle", "time": 640.15, "timestamp": "00:10:40", "text": "玩游戏。[倒吸一口凉气]这是什么"}, {"type": "subtitle", "time": 643.829, "timestamp": "00:10:43", "text": "？随机的。全是同一阵营的。这是什么？"}, {"type": "subtitle", "time": 653.829, "timestamp": "00:10:53", "text": "现在好多东西啊。"}]
[{"type": "subtitle", "time": 365.43, "timestamp": "00:06:05", "text": "好的。我们准备好了。"}, {"type": "subtitle", "time": 368.15, "timestamp": "00:06:08", "text": "准备好了吗？好的。嗯，全是"}, {"type": "subtitle", "time": 370.07, "timestamp": "00:06:10", "text": "屏幕。"}, {"type": "subtitle", "time": 372.15, "timestamp": "00:06:12", "text": "给我一分钟。"}, {"type": "subtitle", "time": 375.029, "timestamp": "00:06:15", "text": "呃，"}, {"type": "subtitle", "time": 377.189, "timestamp": "00:06:17", "text": "为什么创建补丁不起作用？"}, {"type": "subtitle", "time": 380.71, "timestamp": "00:06:20", "text": "哦，创建消息，伙计。"}, {"type": "subtitle", "time": 382.309, "timestamp": "00:06:22", "text": "好的。快点。好的。"}, {"type": "subtitle", "time": 386.95, "timestamp": "00:06:26", "text": "我直播的公告"}, {"type": "subtitle", "time": 391.67, "timestamp": "00:06:31", "text": "马上就会自动发出，我们现在就"}, {"type": "subtitle", "time": 399.43, "timestamp": "00:06:39", "text": "做补丁。好的。快点。"}, {"type": "subtitle", "time": 409.43, "timestamp": "00:06:49", "text": "[笑声] 我讨厌这玩意儿。"}, {"type": "subtitle", "time": 411.909, "timestamp": "00:06:51", "text": "它为什么会坏？每次我想"}, {"type": "subtitle", "time": 415.43, "timestamp": "00:06:55", "text": "直播，它都做不到。不。"}]
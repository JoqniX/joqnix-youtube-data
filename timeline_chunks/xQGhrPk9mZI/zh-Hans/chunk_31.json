[{"type": "subtitle", "time": 1860.149, "timestamp": "00:31:00", "text": "啊，我没办法。你呢？我"}, {"type": "subtitle", "time": 1861.75, "timestamp": "00:31:01", "text": "很好。"}, {"type": "subtitle", "time": 1874.23, "timestamp": "00:31:14", "text": "还剩一个敌人。"}, {"type": "subtitle", "time": 1875.83, "timestamp": "00:31:15", "text": "哇。"}, {"type": "subtitle", "time": 1879.83, "timestamp": "00:31:19", "text": "他为什么？这家伙为什么不换弹？"}, {"type": "subtitle", "time": 1909.269, "timestamp": "00:31:49", "text": "哦，等等。这是个新特工吗？"}, {"type": "subtitle", "time": 1912.07, "timestamp": "00:31:52", "text": "以前从没见过这家伙。"}, {"type": "subtitle", "time": 1919.35, "timestamp": "00:31:59", "text": "嘿，他们在这里加了个东西。"}]
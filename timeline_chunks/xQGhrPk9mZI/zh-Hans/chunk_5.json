[{"type": "subtitle", "time": 302.79, "timestamp": "00:05:02", "text": "比如，我可以给"}, {"type": "subtitle", "time": 306.23, "timestamp": "00:05:06", "text": "Twitch和YouTube的直播频道加个投票系统，让观众"}, {"type": "subtitle", "time": 308.469, "timestamp": "00:05:08", "text": "可以投票决定想看什么类型的内容。我当时就"}, {"type": "subtitle", "time": 314.23, "timestamp": "00:05:14", "text": "收集想法，把"}, {"type": "subtitle", "time": 317.67, "timestamp": "00:05:17", "text": "它们写下来。然后我就睡了。醒得也晚了"}, {"type": "subtitle", "time": 323.27, "timestamp": "00:05:23", "text": "总之，好了。"}, {"type": "subtitle", "time": 327.51, "timestamp": "00:05:27", "text": "让我切换到游戏。等一下。"}, {"type": "subtitle", "time": 340.95, "timestamp": "00:05:40", "text": "好的。什么？"}, {"type": "subtitle", "time": 343.909, "timestamp": "00:05:43", "text": "给我一分钟。我把瓦莱林的快捷键绑定到了"}]
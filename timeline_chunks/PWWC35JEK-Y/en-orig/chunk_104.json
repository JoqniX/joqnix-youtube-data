[{"type": "subtitle", "time": 6241.59, "timestamp": "01:44:01", "text": "Just kind of use this gun."}, {"type": "subtitle", "time": 6244.629, "timestamp": "01:44:04", "text": ">> Oh, we qualify. Nice."}, {"type": "subtitle", "time": 6247.35, "timestamp": "01:44:07", "text": "How? How?"}, {"type": "subtitle", "time": 6249.75, "timestamp": "01:44:09", "text": ">> All right, that was a bang up job. Get"}, {"type": "subtitle", "time": 6264.79, "timestamp": "01:44:24", "text": ">> Way to take the fight to him. Remember,"}, {"type": "subtitle", "time": 6267.75, "timestamp": "01:44:27", "text": "you're not done yet."}, {"type": "subtitle", "time": 6269.75, "timestamp": "01:44:29", "text": ">> Oh, the contract. I hate the contract"}, {"type": "subtitle", "time": 6272.95, "timestamp": "01:44:32", "text": "one cuz you have to squad wipe people."}, {"type": "subtitle", "time": 6275.03, "timestamp": "01:44:35", "text": ">> It's simple. Eliminate those other"}, {"type": "subtitle", "time": 6276.95, "timestamp": "01:44:36", "text": "hitters. Anything less than success"}, {"type": "subtitle", "time": 6278.149, "timestamp": "01:44:38", "text": "pulls you off the OP."}, {"type": "subtitle", "time": 6280.07, "timestamp": "01:44:40", "text": ">> But if one of us is alive, then we are"}, {"type": "subtitle", "time": 6281.91, "timestamp": "01:44:41", "text": "good."}]
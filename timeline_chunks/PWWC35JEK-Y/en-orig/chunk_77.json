[{"type": "subtitle", "time": 4624.229, "timestamp": "01:17:04", "text": "It's an airfield."}, {"type": "subtitle", "time": 4626.39, "timestamp": "01:17:06", "text": ">> Secure and decrypt any beacons you find."}, {"type": "subtitle", "time": 4629.03, "timestamp": "01:17:09", "text": "The data is pivotal to operations. Enemy"}, {"type": "subtitle", "time": 4631.51, "timestamp": "01:17:11", "text": "contact is a given, so stay sharp."}, {"type": "subtitle", "time": 4658.87, "timestamp": "01:17:38", "text": ">> All of us died. Oh, thank God. One guy"}, {"type": "subtitle", "time": 4660.709, "timestamp": "01:17:40", "text": "is alive."}, {"type": "subtitle", "time": 4672.63, "timestamp": "01:17:52", "text": ">> No, never mind."}]
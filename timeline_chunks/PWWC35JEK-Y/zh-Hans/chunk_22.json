[{"type": "subtitle", "time": 1322.23, "timestamp": "00:22:02", "text": "全球冲突的威胁持续"}, {"type": "subtitle", "time": 1325.029, "timestamp": "00:22:05", "text": "上升。 前北约国家之间的紧张局势再度浮现"}, {"type": "subtitle", "time": 1326.87, "timestamp": "00:22:06", "text": "。 国土安全部向"}, {"type": "subtitle", "time": 1329.75, "timestamp": "00:22:09", "text": "我们保证，无需担忧。"}, {"type": "subtitle", "time": 1330.71, "timestamp": "00:22:10", "text": "好的，"}, {"type": "subtitle", "time": 1333.43, "timestamp": "00:22:13", "text": "这只是有关林登堡发生大规模爆炸的报道"}, {"type": "subtitle", "time": 1335.909, "timestamp": "00:22:15", "text": "。 从军事基地拍摄的一张巨照"}, {"type": "subtitle", "time": 1336.789, "timestamp": "00:22:16", "text": "。"}, {"type": "subtitle", "time": 1338.95, "timestamp": "00:22:18", "text": "国民警卫队已疏散该地区人员。"}, {"type": "subtitle", "time": 1342.31, "timestamp": "00:22:22", "text": "我们是否正遭受攻击？"}, {"type": "subtitle", "time": 1344.47, "timestamp": "00:22:24", "text": "这只是时间问题。"}, {"type": "subtitle", "time": 1346.63, "timestamp": "00:22:26", "text": "谣言四起，称存在化学品泄漏。"}, {"type": "subtitle", "time": 1348.149, "timestamp": "00:22:28", "text": "参谋长联席会议正在与"}, {"type": "subtitle", "time": 1348.95, "timestamp": "00:22:28", "text": "总统会面。"}, {"type": "subtitle", "time": 1352.39, "timestamp": "00:22:32", "text": "AS证实了仰卧睡眠细胞的存在。"}, {"type": "subtitle", "time": 1353.11, "timestamp": "00:22:33", "text": "好的。"}, {"type": "subtitle", "time": 1356.71, "timestamp": "00:22:36", "text": "最先是东海岸。 现在是"}, {"type": "subtitle", "time": 1357.51, "timestamp": "00:22:37", "text": "西部了。"}, {"type": "subtitle", "time": 1359.11, "timestamp": "00:22:39", "text": "袭击事件似乎正在"}, {"type": "subtitle", "time": 1361.35, "timestamp": "00:22:41", "text": "南加州蔓延。 街头巷尾一片混乱，"}, {"type": "subtitle", "time": 1363.19, "timestamp": "00:22:43", "text": "战斗愈演愈烈。"}, {"type": "subtitle", "time": 1364.789, "timestamp": "00:22:44", "text": "这和爆炸事件有关吗？"}, {"type": "subtitle", "time": 1367.029, "timestamp": "00:22:47", "text": "警员协同攻击。"}, {"type": "subtitle", "time": 1369.029, "timestamp": "00:22:49", "text": "随着军队部署应对"}, {"type": "subtitle", "time": 1371.51, "timestamp": "00:22:51", "text": "日益增长的威胁，林登堡正处于"}, {"type": "subtitle", "time": 1373.27, "timestamp": "00:22:53", "text": "待定状态。"}, {"type": "subtitle", "time": 1375.19, "timestamp": "00:22:55", "text": "那里隐藏的秘密比格鲁姆"}, {"type": "subtitle", "time": 1378.47, "timestamp": "00:22:58", "text": "湖还要多。 如果其中任何一部分落入不法分子"}]
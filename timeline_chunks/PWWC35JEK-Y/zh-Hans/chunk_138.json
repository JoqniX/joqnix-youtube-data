[{"type": "subtitle", "time": 8281.11, "timestamp": "02:18:01", "text": "休息。"}, {"type": "subtitle", "time": 8284.15, "timestamp": "02:18:04", "text": "我头疼，真的疼。"}, {"type": "subtitle", "time": 8287.589, "timestamp": "02:18:07", "text": "哦。[哼] 不过，嗨。"}, {"type": "subtitle", "time": 8290.309, "timestamp": "02:18:10", "text": "说了这么多，谢谢你今天。"}, {"type": "subtitle", "time": 8291.75, "timestamp": "02:18:11", "text": "谢谢你过来。今晚9点见。"}, {"type": "subtitle", "time": 8299.589, "timestamp": "02:18:19", "text": "如果我的课能快点结束，"}, {"type": "subtitle", "time": 8302.79, "timestamp": "02:18:22", "text": "吃完饭什么的，如果一切顺利的话"}, {"type": "subtitle", "time": 8305.509, "timestamp": "02:18:25", "text": "，我会9点直播。好的。9点到"}, {"type": "subtitle", "time": 8310.309, "timestamp": "02:18:30", "text": "12点。12点以后，我就犯困睡觉了。"}, {"type": "subtitle", "time": 8313.19, "timestamp": "02:18:33", "text": "不是凌晨3点。我不会"}, {"type": "chat", "time": 8316.205, "timestamp": "02:18:36", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "bai"}, {"type": "subtitle", "time": 8316.309, "timestamp": "02:18:36", "text": "像昨天那样凌晨3点睡觉。而且"}, {"type": "subtitle", "time": 8319.349, "timestamp": "02:18:39", "text": "像今天这样，我几乎没睡着，很累。"}, {"type": "subtitle", "time": 8325.27, "timestamp": "02:18:45", "text": "所以，我会早点走。嗨。"}, {"type": "subtitle", "time": 8329.19, "timestamp": "02:18:49", "text": "哦，日程表一上有万圣节更新"}, {"type": "subtitle", "time": 8331.91, "timestamp": "02:18:51", "text": "。天哪，我好想念日程表"}, {"type": "subtitle", "time": 8338.95, "timestamp": "02:18:58", "text": "哇。"}]
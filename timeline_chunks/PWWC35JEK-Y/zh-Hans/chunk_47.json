[{"type": "subtitle", "time": 2828.63, "timestamp": "00:47:08", "text": "好的。 快快快快快。 请把面包车给我"}, {"type": "subtitle", "time": 2840.309, "timestamp": "00:47:20", "text": "我搞定了，兄弟。 赶紧跑吧！"}, {"type": "subtitle", "time": 2843.349, "timestamp": "00:47:23", "text": "不要使用旧标签。 不，不要打开"}, {"type": "subtitle", "time": 2850.71, "timestamp": "00:47:30", "text": "去！去！去。"}]
[{"type": "subtitle", "time": 6903.189, "timestamp": "01:55:03", "text": "等等，现在几点？   现在大概凌晨"}, {"type": "subtitle", "time": 6905.91, "timestamp": "01:55:05", "text": "1点半。我"}, {"type": "subtitle", "time": 6908.709, "timestamp": "01:55:08", "text": "的天哪，我忘了。   是"}, {"type": "subtitle", "time": 6912.55, "timestamp": "01:55:12", "text": "啊，你什么时候睡觉？"}, {"type": "subtitle", "time": 6914.149, "timestamp": "01:55:14", "text": "嗯，"}, {"type": "subtitle", "time": 6916.39, "timestamp": "01:55:16", "text": "应该是的，"}, {"type": "subtitle", "time": 6920.47, "timestamp": "01:55:20", "text": "我有个厨师，一直工作到12点。"}, {"type": "subtitle", "time": 6922.55, "timestamp": "01:55:22", "text": "所以"}, {"type": "subtitle", "time": 6925.03, "timestamp": "01:55:25", "text": "我明天不用上学。 我虽然要"}, {"type": "subtitle", "time": 6928.229, "timestamp": "01:55:28", "text": "上学，但时间是下午到"}, {"type": "subtitle", "time": 6930.55, "timestamp": "01:55:30", "text": "晚上。"}, {"type": "subtitle", "time": 6943.27, "timestamp": "01:55:43", "text": "蓝色协议怎么样？ 嗯？ 你是不是一直在"}, {"type": "subtitle", "time": 6945.35, "timestamp": "01:55:45", "text": "看那场比赛？（嗤笑）"}, {"type": "subtitle", "time": 6947.51, "timestamp": "01:55:47", "text": "啊，[笑声]"}, {"type": "subtitle", "time": 6951.75, "timestamp": "01:55:51", "text": "我一直在玩这个游戏。"}, {"type": "subtitle", "time": 6954.95, "timestamp": "01:55:54", "text": "是的，我已经付出代价了。 所以，你"}, {"type": "subtitle", "time": 6957.35, "timestamp": "01:55:57", "text": "得物有所值。"}, {"type": "subtitle", "time": 6959.445, "timestamp": "01:55:59", "text": "这很难。"}, {"type": "subtitle", "time": 6959.91, "timestamp": "01:55:59", "text": "[笑声] 是的"}]
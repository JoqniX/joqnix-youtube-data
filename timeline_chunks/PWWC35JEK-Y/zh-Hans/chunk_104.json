[{"type": "subtitle", "time": 6241.59, "timestamp": "01:44:01", "text": "用这把枪。"}, {"type": "subtitle", "time": 6244.629, "timestamp": "01:44:04", "text": "哦，我们符合条件。 好的。"}, {"type": "subtitle", "time": 6247.35, "timestamp": "01:44:07", "text": "如何？ 如何？"}, {"type": "subtitle", "time": 6249.75, "timestamp": "01:44:09", "text": "好吧，干得漂亮！"}, {"type": "subtitle", "time": 6264.79, "timestamp": "01:44:24", "text": "记住，"}, {"type": "subtitle", "time": 6267.75, "timestamp": "01:44:27", "text": "你还没完成。"}, {"type": "subtitle", "time": 6269.75, "timestamp": "01:44:29", "text": "哦，是合同。 我讨厌合约任务，"}, {"type": "subtitle", "time": 6272.95, "timestamp": "01:44:32", "text": "因为你必须团灭对手。"}, {"type": "subtitle", "time": 6275.03, "timestamp": "01:44:35", "text": "很简单。 淘汰其他"}, {"type": "subtitle", "time": 6276.95, "timestamp": "01:44:36", "text": "击球手。 任何低于成功标准的成绩都会让"}, {"type": "subtitle", "time": 6278.149, "timestamp": "01:44:38", "text": "你从OP（原帖作者）的位置上掉下来。"}, {"type": "subtitle", "time": 6280.07, "timestamp": "01:44:40", "text": "但只要我们当中有一个人活着，那就"}, {"type": "subtitle", "time": 6281.91, "timestamp": "01:44:41", "text": "万事大吉了。"}]
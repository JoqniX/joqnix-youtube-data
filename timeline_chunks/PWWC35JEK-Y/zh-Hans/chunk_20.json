[{"type": "subtitle", "time": 1204.23, "timestamp": "00:20:04", "text": "好吧，"}, {"type": "subtitle", "time": 1213.83, "timestamp": "00:20:13", "text": "直到它识破了我们的虚张声势。   有"}, {"type": "subtitle", "time": 1217.909, "timestamp": "00:20:17", "text": "报道称，一场悲剧发生了，一名"}, {"type": "subtitle", "time": 1220.71, "timestamp": "00:20:20", "text": "将军刚刚遭到暗杀。"}, {"type": "subtitle", "time": 1224.07, "timestamp": "00:20:24", "text": "北约的回应："}, {"type": "subtitle", "time": 1225.59, "timestamp": "00:20:25", "text": "沉默。"}, {"type": "subtitle", "time": 1227.669, "timestamp": "00:20:27", "text": "北约退缩了。"}, {"type": "subtitle", "time": 1231.99, "timestamp": "00:20:31", "text": "没有回应，就是不尊重。"}, {"type": "subtitle", "time": 1235.11, "timestamp": "00:20:35", "text": "十二个国家走过。"}, {"type": "subtitle", "time": 1237.029, "timestamp": "00:20:37", "text": "我们已经对北约失去了信心。"}, {"type": "subtitle", "time": 1239.35, "timestamp": "00:20:39", "text": "允许导致一些国家退出"}, {"type": "subtitle", "time": 1239.83, "timestamp": "00:20:39", "text": "联盟。"}, {"type": "subtitle", "time": 1243.35, "timestamp": "00:20:43", "text": "其实大家都知道是谁干的。"}, {"type": "subtitle", "time": 1245.27, "timestamp": "00:20:45", "text": "舰队。"}, {"type": "subtitle", "time": 1247.75, "timestamp": "00:20:47", "text": "建造方式与军用标准相同。 它不"}, {"type": "subtitle", "time": 1249.19, "timestamp": "00:20:49", "text": "按他们的规则来。"}, {"type": "subtitle", "time": 1251.11, "timestamp": "00:20:51", "text": "缺乏监管的影子军队。"}, {"type": "subtitle", "time": 1253.75, "timestamp": "00:20:53", "text": "为奖品提供保护。"}, {"type": "subtitle", "time": 1257.75, "timestamp": "00:20:57", "text": "然后事情变得非常有趣了。"}]
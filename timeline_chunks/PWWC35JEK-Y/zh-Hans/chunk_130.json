[{"type": "subtitle", "time": 7803.589, "timestamp": "02:10:03", "text": "我他妈的走了"}, {"type": "subtitle", "time": 7805.83, "timestamp": "02:10:05", "text": "。"}, {"type": "subtitle", "time": 7817.51, "timestamp": "02:10:17", "text": "我要去高处。"}, {"type": "subtitle", "time": 7821.03, "timestamp": "02:10:21", "text": "我的天哪，我感觉好嗨。"}, {"type": "subtitle", "time": 7826.39, "timestamp": "02:10:26", "text": "引擎轰鸣声响起的时间"}, {"type": "subtitle", "time": 7827.99, "timestamp": "02:10:27", "text": "即将结束。 让我们完成这项任务"}, {"type": "subtitle", "time": 7830.31, "timestamp": "02:10:30", "text": "。"}, {"type": "subtitle", "time": 7848.709, "timestamp": "02:10:48", "text": "他用刀捅了我。 隐藏。 好的。"}, {"type": "subtitle", "time": 7851.669, "timestamp": "02:10:51", "text": "熏肉。 我正朝你走来。"}]
[{"type": "subtitle", "time": 3781.19, "timestamp": "01:03:01", "text": "。   我"}, {"type": "subtitle", "time": 3782.87, "timestamp": "01:03:02", "text": "根本不知道那个人在那里。 我当时"}, {"type": "subtitle", "time": 3784.549, "timestamp": "01:03:04", "text": "以为是远处有个狙击手把"}, {"type": "subtitle", "time": 3788.309, "timestamp": "01:03:08", "text": "他打死了。 没关系。"}, {"type": "subtitle", "time": 3835.19, "timestamp": "01:03:55", "text": "嘿，你们小队的战斗目标。 时间不多了"}, {"type": "subtitle", "time": 3837.829, "timestamp": "01:03:57", "text": "。 把它关掉。"}]
[{"type": "subtitle", "time": 6019.27, "timestamp": "01:40:19", "text": "我的天哪，我中枪了。 如何？"}, {"type": "subtitle", "time": 6021.189, "timestamp": "01:40:21", "text": "他妈的。 我快要失血过多而死了。"}, {"type": "subtitle", "time": 6023.75, "timestamp": "01:40:23", "text": "哦，给你。 我做了标记。 我做了标记。 我做了"}, {"type": "subtitle", "time": 6025.59, "timestamp": "01:40:25", "text": "标记。"}, {"type": "subtitle", "time": 6029.75, "timestamp": "01:40:29", "text": "哦，它只出现了两秒钟。"}, {"type": "subtitle", "time": 6032.629, "timestamp": "01:40:32", "text": "我正在上面生成。 哦，是的。 哦，是的。"}, {"type": "subtitle", "time": 6052.629, "timestamp": "01:40:52", "text": "你个笨蛋。 哦，我为什么要按"}]
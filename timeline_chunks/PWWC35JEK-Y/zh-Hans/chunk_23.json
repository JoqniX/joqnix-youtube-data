[{"type": "subtitle", "time": 1382.71, "timestamp": "00:23:02", "text": "手中，后果将不堪设想。"}, {"type": "subtitle", "time": 1386.549, "timestamp": "00:23:06", "text": "我绝不会允许这种事发生。"}, {"type": "subtitle", "time": 1399.99, "timestamp": "00:23:19", "text": "战地工作室。"}, {"type": "subtitle", "time": 1402.149, "timestamp": "00:23:22", "text": "加州，早安。 今天天气"}, {"type": "subtitle", "time": 1403.59, "timestamp": "00:23:23", "text": "真好。"}, {"type": "subtitle", "time": 1405.43, "timestamp": "00:23:25", "text": "国会继续"}, {"type": "subtitle", "time": 1406.95, "timestamp": "00:23:26", "text": "对这名说客进行调查。"}, {"type": "subtitle", "time": 1408.149, "timestamp": "00:23:28", "text": "是同一回事吗？"}, {"type": "subtitle", "time": 1410.549, "timestamp": "00:23:30", "text": "高速公路交通拥堵。 或许就待在"}, {"type": "subtitle", "time": 1411.83, "timestamp": "00:23:31", "text": "家里吧。"}, {"type": "subtitle", "time": 1413.83, "timestamp": "00:23:33", "text": "海滩居民"}, {"type": "subtitle", "time": 1416.71, "timestamp": "00:23:36", "text": "对军事力量的增强表示担忧。"}, {"type": "subtitle", "time": 1433.51, "timestamp": "00:23:53", "text": "这不就是我们之前看到的情况吗"}, {"type": "subtitle", "time": 1434.07, "timestamp": "00:23:54", "text": "？"}, {"type": "subtitle", "time": 1435.75, "timestamp": "00:23:55", "text": "警卫已疏散该区域人员。"}, {"type": "subtitle", "time": 1439.19, "timestamp": "00:23:59", "text": "我们是否正遭受攻击？"}]
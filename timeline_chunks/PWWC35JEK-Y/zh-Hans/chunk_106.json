[{"type": "subtitle", "time": 6360.95, "timestamp": "01:46:00", "text": "嘿，那边有个狙击手。"}, {"type": "subtitle", "time": 6362.149, "timestamp": "01:46:02", "text": "我发现敌人了。"}, {"type": "subtitle", "time": 6363.91, "timestamp": "01:46:03", "text": "哦，是的。 糟糕。"}, {"type": "subtitle", "time": 6367.35, "timestamp": "01:46:07", "text": "我接到你了。"}, {"type": "subtitle", "time": 6378.87, "timestamp": "01:46:18", "text": "现在只有你一个人了。 每一次出手都要"}, {"type": "subtitle", "time": 6379.99, "timestamp": "01:46:19", "text": "把握机会。"}, {"type": "subtitle", "time": 6388.709, "timestamp": "01:46:28", "text": "快点。"}, {"type": "subtitle", "time": 6391.91, "timestamp": "01:46:31", "text": "等待。 但他们终究会死。 不，你得"}, {"type": "subtitle", "time": 6417.189, "timestamp": "01:46:57", "text": "这里正在掩盖。   是的"}]
[{"type": "subtitle", "time": 4468.31, "timestamp": "01:14:28", "text": "等等。 不过我们赢了。   这一切都"}, {"type": "subtitle", "time": 4471.071, "timestamp": "01:14:31", "text": "源于我自己的单身生活。"}, {"type": "subtitle", "time": 4471.43, "timestamp": "01:14:31", "text": "[笑声]"}, {"type": "subtitle", "time": 4474.149, "timestamp": "01:14:34", "text": "执行得非常出色。 准备出发。 恶人永无安宁"}, {"type": "subtitle", "time": 4480.229, "timestamp": "01:14:40", "text": "是的，他们的贡献比"}, {"type": "subtitle", "time": 4489.83, "timestamp": "01:14:49", "text": "最关键的时刻，你坚守阵地，并向敌人发出烟雾弹。 坚持"}, {"type": "subtitle", "time": 4490.47, "timestamp": "01:14:50", "text": "下去。   我的"}, {"type": "subtitle", "time": 4493.27, "timestamp": "01:14:53", "text": "天哪。"}, {"type": "subtitle", "time": 4495.59, "timestamp": "01:14:55", "text": "呃，我肯定做不好这个。 我"}, {"type": "subtitle", "time": 4496.95, "timestamp": "01:14:56", "text": "不能。"}, {"type": "subtitle", "time": 4499.03, "timestamp": "01:14:59", "text": "要么杀人，要么被杀。 所以，为了"}]
[{"type": "subtitle", "time": 7448.87, "timestamp": "02:04:08", "text": "哦，是的。 我得重新下载一遍。"}, {"type": "subtitle", "time": 7451.669, "timestamp": "02:04:11", "text": "游戏内容是一样的，[笑声] 但《"}, {"type": "subtitle", "time": 7454.39, "timestamp": "02:04:14", "text": "Blight》就像动漫一样。"}, {"type": "subtitle", "time": 7463.75, "timestamp": "02:04:23", "text": "我觉得任何偷窥的人都是男的。 上次我"}, {"type": "subtitle", "time": 7465.75, "timestamp": "02:04:25", "text": "尝试在这个时间段玩的时候，"}, {"type": "subtitle", "time": 7468.149, "timestamp": "02:04:28", "text": "大概是凌晨 2 点或 1 点，要等"}, {"type": "subtitle", "time": 7471.35, "timestamp": "02:04:31", "text": "10 分钟才能排队匹配到比赛。"}, {"type": "subtitle", "time": 7473.99, "timestamp": "02:04:33", "text": "等等，是哪个 Apex 还是"}, {"type": "subtitle", "time": 7475.43, "timestamp": "02:04:35", "text": "Apex？ 顶点。"}, {"type": "subtitle", "time": 7477.109, "timestamp": "02:04:37", "text": "哦。"}, {"type": "subtitle", "time": 7479.91, "timestamp": "02:04:39", "text": "哦，堡垒之夜新赛季真不错。"}, {"type": "subtitle", "time": 7482.79, "timestamp": "02:04:42", "text": "模拟人生那一套。 辛普森一家。"}, {"type": "subtitle", "time": 7484.31, "timestamp": "02:04:44", "text": "这只是《堡垒之夜》。"}, {"type": "subtitle", "time": 7488.709, "timestamp": "02:04:48", "text": "是的，我看到了广告。 所以，"}, {"type": "subtitle", "time": 7497.99, "timestamp": "02:04:57", "text": "我得把这个游戏下架，"}, {"type": "subtitle", "time": 7499.35, "timestamp": "02:04:59", "text": "腾出点空间。"}]
[{"type": "subtitle", "time": 3900.15, "timestamp": "01:05:00", "text": "哦，我们也晋级下一轮了"}, {"type": "subtitle", "time": 3901.109, "timestamp": "01:05:01", "text": "。"}, {"type": "subtitle", "time": 3902.71, "timestamp": "01:05:02", "text": "准备出发。 恶人永无安宁"}, {"type": "subtitle", "time": 3910.47, "timestamp": "01:05:10", "text": "哦，我们是第一名。 我们，我们是第一。 圣。"}, {"type": "subtitle", "time": 3915.27, "timestamp": "01:05:15", "text": "我正在底部进行击杀。 呃，没关系。"}, {"type": "subtitle", "time": 3917.829, "timestamp": "01:05:17", "text": "敌方通讯中断。 做得不错"}, {"type": "subtitle", "time": 3919.67, "timestamp": "01:05:19", "text": "。"}, {"type": "subtitle", "time": 3921.589, "timestamp": "01:05:21", "text": "好吧，这游戏比大逃杀游戏更有趣"}, {"type": "subtitle", "time": 3924.39, "timestamp": "01:05:24", "text": "。 我喜欢这个，"}, {"type": "subtitle", "time": 3926.309, "timestamp": "01:05:26", "text": "因为这是重新部署。"}, {"type": "subtitle", "time": 3929.109, "timestamp": "01:05:29", "text": "不要把事情想得太复杂。 你的工作。"}, {"type": "subtitle", "time": 3931.349, "timestamp": "01:05:31", "text": "杀人。 好的，明白了。 这就是我的"}, {"type": "subtitle", "time": 3934.71, "timestamp": "01:05:34", "text": "强项。 我们会这么做。"}, {"type": "subtitle", "time": 3953.51, "timestamp": "01:05:53", "text": "走吧。 宝贝，用手臂和身体滚动。"}]
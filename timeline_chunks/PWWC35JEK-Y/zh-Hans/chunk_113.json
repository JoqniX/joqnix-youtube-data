[{"type": "subtitle", "time": 6801.43, "timestamp": "01:53:21", "text": "哦，"}, {"type": "subtitle", "time": 6804.55, "timestamp": "01:53:24", "text": "这些人要来追我了。"}, {"type": "subtitle", "time": 6806.229, "timestamp": "01:53:26", "text": "你还在吗？   是的"}, {"type": "subtitle", "time": 6812.149, "timestamp": "01:53:32", "text": "我死了。"}, {"type": "subtitle", "time": 6814.709, "timestamp": "01:53:34", "text": "我们排名第二。"}, {"type": "subtitle", "time": 6817.669, "timestamp": "01:53:37", "text": "他妈的。 我快要失血过多而死了。 医护人员。"}, {"type": "subtitle", "time": 6820.31, "timestamp": "01:53:40", "text": "但排名第二。"}, {"type": "subtitle", "time": 6822.07, "timestamp": "01:53:42", "text": "是的，那两个人再也没能复活。 我"}, {"type": "subtitle", "time": 6828.31, "timestamp": "01:53:48", "text": "呃，三号。 第三队。 将会"}, {"type": "subtitle", "time": 6833.03, "timestamp": "01:53:53", "text": "超越我们。 但不要让他们得逞。   糟了"}]
[{"type": "subtitle", "time": 6308.709, "timestamp": "01:45:08", "text": "啊，我死了。 我的天啊。"}, {"type": "subtitle", "time": 6310.31, "timestamp": "01:45:10", "text": "哦，什么？  1马力。"}, {"type": "subtitle", "time": 6312.55, "timestamp": "01:45:12", "text": "快点。  1马力。"}, {"type": "subtitle", "time": 6313.59, "timestamp": "01:45:13", "text": "请不要死。 请不要死。"}, {"type": "subtitle", "time": 6316.56, "timestamp": "01:45:16", "text": "请不要死。 第四名。"}, {"type": "subtitle", "time": 6318.96, "timestamp": "01:45:18", "text": "第四名。 那人死了吗？"}, {"type": "subtitle", "time": 6320.88, "timestamp": "01:45:20", "text": "那人死了吗？ 哦，他领先了。 感谢上帝，我还"}, {"type": "subtitle", "time": 6324.8, "timestamp": "01:45:24", "text": "哦，他领先了。 感谢上帝，我还 活着。"}, {"type": "subtitle", "time": 6345.189, "timestamp": "01:45:45", "text": "接触。"}, {"type": "subtitle", "time": 6354.95, "timestamp": "01:45:54", "text": "你能吗？哦，我的天哪。 我在"}, {"type": "subtitle", "time": 6357.03, "timestamp": "01:45:57", "text": "另一边。"}, {"type": "subtitle", "time": 6359.51, "timestamp": "01:45:59", "text": "我的天哪，敌人也太多了吧。"}]
[{"type": "subtitle", "time": 7622.31, "timestamp": "02:07:02", "text": "哦，下面。 下面。 哦，我的错。"}, {"type": "subtitle", "time": 7653.43, "timestamp": "02:07:33", "text": "他当时正在蹲着。 向后蹲下。"}, {"type": "subtitle", "time": 7664.87, "timestamp": "02:07:44", "text": "我的子弹都去哪儿了？"}, {"type": "subtitle", "time": 7667.99, "timestamp": "02:07:47", "text": "我中弹了。 医护人员。"}, {"type": "subtitle", "time": 7669.75, "timestamp": "02:07:49", "text": "我的天啊。"}, {"type": "subtitle", "time": 7670.79, "timestamp": "02:07:50", "text": "爆头。"}, {"type": "subtitle", "time": 7674.39, "timestamp": "02:07:54", "text": "是的，需要注射一针。 似乎"}, {"type": "subtitle", "time": 7677.51, "timestamp": "02:07:57", "text": "需要一段时间才能习惯"}, {"type": "subtitle", "time": 7679.91, "timestamp": "02:07:59", "text": "真正的"}]
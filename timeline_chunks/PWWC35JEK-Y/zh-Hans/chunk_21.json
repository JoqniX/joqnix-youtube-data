[{"type": "subtitle", "time": 1261.43, "timestamp": "00:21:01", "text": "回流猛烈，每条线路都经受着考验。"}, {"type": "subtitle", "time": 1265.669, "timestamp": "00:21:05", "text": "从外国领土到你家门口，"}, {"type": "subtitle", "time": 1267.35, "timestamp": "00:21:07", "text": "威胁世界领导人的生命，"}, {"type": "subtitle", "time": 1269.27, "timestamp": "00:21:09", "text": "侵犯主权领土，"}, {"type": "subtitle", "time": 1273.51, "timestamp": "00:21:13", "text": "劫持历史，就在前线。"}, {"type": "subtitle", "time": 1276.31, "timestamp": "00:21:16", "text": "这种前所未有的局面只能用语言来"}, {"type": "subtitle", "time": 1277.35, "timestamp": "00:21:17", "text": "描述。"}, {"type": "subtitle", "time": 1280.149, "timestamp": "00:21:20", "text": "越来越具有爆炸性。 伊拉克立场坚定，"}, {"type": "subtitle", "time": 1284.87, "timestamp": "00:21:24", "text": "北约已做好准备。"}, {"type": "subtitle", "time": 1287.19, "timestamp": "00:21:27", "text": "如果你放弃了控制权，就必须"}, {"type": "subtitle", "time": 1291.029, "timestamp": "00:21:31", "text": "奋力夺回它。 而这正是"}, {"type": "subtitle", "time": 1292.549, "timestamp": "00:21:32", "text": "我们要做的事情。"}, {"type": "subtitle", "time": 1299.59, "timestamp": "00:21:39", "text": "该死。"}, {"type": "subtitle", "time": 1305.51, "timestamp": "00:21:45", "text": "加州，早安。 今天天气"}, {"type": "subtitle", "time": 1307.43, "timestamp": "00:21:47", "text": "真好。 国会"}, {"type": "subtitle", "time": 1309.11, "timestamp": "00:21:49", "text": "继续对"}, {"type": "subtitle", "time": 1310.71, "timestamp": "00:21:50", "text": "企业游说活动进行调查。"}, {"type": "subtitle", "time": 1311.99, "timestamp": "00:21:51", "text": "高速公路上的交通看起来很拥堵"}, {"type": "subtitle", "time": 1315.11, "timestamp": "00:21:55", "text": "。 他们就待在家里。"}, {"type": "subtitle", "time": 1317.11, "timestamp": "00:21:57", "text": "海滩居民"}, {"type": "subtitle", "time": 1319.909, "timestamp": "00:21:59", "text": "对军事力量的增强表示担忧。"}]
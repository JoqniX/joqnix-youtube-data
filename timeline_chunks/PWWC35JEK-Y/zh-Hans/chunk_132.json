[{"type": "subtitle", "time": 7929.99, "timestamp": "02:12:09", "text": "感谢你提供的游戏风格。"}, {"type": "subtitle", "time": 7934.069, "timestamp": "02:12:14", "text": "是的，谢谢你的关心。"}, {"type": "subtitle", "time": 7936.31, "timestamp": "02:12:16", "text": "谢谢你背我。 那真是"}, {"type": "subtitle", "time": 7943.43, "timestamp": "02:12:23", "text": "下次你应该多玩玩这个游戏"}, {"type": "subtitle", "time": 7945.27, "timestamp": "02:12:25", "text": "。"}, {"type": "subtitle", "time": 7947.109, "timestamp": "02:12:27", "text": "是的，"}, {"type": "subtitle", "time": 7948.709, "timestamp": "02:12:28", "text": "你的电脑存储空间足够"}, {"type": "subtitle", "time": 7949.43, "timestamp": "02:12:29", "text": "。"}, {"type": "subtitle", "time": 7953.189, "timestamp": "02:12:33", "text": "我得卸载一些游戏。 是的。"}, {"type": "subtitle", "time": 7957.27, "timestamp": "02:12:37", "text": "是吗？ 你好。 等他们搞砸了我就收工"}, {"type": "subtitle", "time": 7960.47, "timestamp": "02:12:40", "text": "。 保重，培根。 晚安。"}, {"type": "subtitle", "time": 7961.03, "timestamp": "02:12:41", "text": "你好。"}, {"type": "subtitle", "time": 7962.709, "timestamp": "02:12:42", "text": "再见了，流媒体。"}, {"type": "subtitle", "time": 7964.79, "timestamp": "02:12:44", "text": "再见。"}, {"type": "subtitle", "time": 7970.55, "timestamp": "02:12:50", "text": "嗨，奥利弗。"}, {"type": "subtitle", "time": 7976.629, "timestamp": "02:12:56", "text": "培根。"}]
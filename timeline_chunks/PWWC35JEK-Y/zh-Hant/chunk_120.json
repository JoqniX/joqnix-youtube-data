[{"type": "subtitle", "time": 7207.189, "timestamp": "02:00:07", "text": "我的天哪，我忘了。  是啊，你什麼時候睡覺？"}, {"type": "subtitle", "time": 7229.589, "timestamp": "02:00:29", "text": "嗯，應該是的，"}, {"type": "subtitle", "time": 7231.75, "timestamp": "02:00:31", "text": "我有個廚師，一直工作到12點。所以我明天"}, {"type": "subtitle", "time": 7242.149, "timestamp": "02:00:42", "text": "不用上學。雖然我要去上學，但時間是下午到晚上。  這樣我就可以多睡一會兒了"}]
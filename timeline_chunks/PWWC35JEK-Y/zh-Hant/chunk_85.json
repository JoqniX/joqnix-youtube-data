[{"type": "subtitle", "time": 5123.669, "timestamp": "01:25:23", "text": "必須完成這些任務"}, {"type": "subtitle", "time": 5126.87, "timestamp": "01:25:26", "text": "。  這就是這場遊戲的"}, {"type": "subtitle", "time": 5131.43, "timestamp": "01:25:31", "text": "戰場。  你得加把勁了。  兄弟，"}, {"type": "subtitle", "time": 5134.229, "timestamp": "01:25:34", "text": "我會保護你的。不用擔心。"}, {"type": "subtitle", "time": 5149.189, "timestamp": "01:25:49", "text": "我接到你了。那可真不少。  小隊已校準了另一個信標。  哦，我的天，沒彈藥了"}]
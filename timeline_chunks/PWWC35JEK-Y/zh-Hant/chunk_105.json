[{"type": "subtitle", "time": 6310.31, "timestamp": "01:45:10", "text": "如何？  他媽的。我快要失血過多而死了。  哦，給你。我做了標記。我做了標記"}, {"type": "subtitle", "time": 6313.59, "timestamp": "01:45:13", "text": "。我做了標記。  哦，它只出現了"}, {"type": "subtitle", "time": 6318.95, "timestamp": "01:45:18", "text": "兩秒鐘。  我正在"}, {"type": "subtitle", "time": 6324.79, "timestamp": "01:45:24", "text": "上面生成。哦，是的。哦，是的。  小心。  不，別走"}, {"type": "subtitle", "time": 6354.95, "timestamp": "01:45:54", "text": "。  我的天哪，那裡有人"}, {"type": "subtitle", "time": 6357.03, "timestamp": "01:45:57", "text": "。我身上有人。  真倒楣。真倒楣。真倒楣。真倒楣。真倒楣。"}, {"type": "subtitle", "time": 6359.51, "timestamp": "01:45:59", "text": "神父 我的天哪。  注意安全。注意安全。我在這裡。我在這裡。"}]
[{"type": "subtitle", "time": 180.869, "timestamp": "00:03:00", "text": "狗狗叫了嗎？狗狗一直"}, {"type": "subtitle", "time": 189.99, "timestamp": "00:03:09", "text": "，你沒聽到嗎？啊，有意思。"}, {"type": "subtitle", "time": 191.99, "timestamp": "00:03:11", "text": "還有，[清嗓子]"}, {"type": "subtitle", "time": 194.71, "timestamp": "00:03:14", "text": "今天，呃，我希望我今天沒有太晚到，是的"}, {"type": "subtitle", "time": 199.11, "timestamp": "00:03:19", "text": "。嗯，今天我們要玩的"}, {"type": "subtitle", "time": 201.82999999999998, "timestamp": "00:03:21", "text": "是一款大逃殺遊戲，我"}, {"type": "subtitle", "time": 204.869, "timestamp": "00:03:24", "text": "可能會玩到"}, {"type": "subtitle", "time": 207.91, "timestamp": "00:03:27", "text": "中午左右。  差不多就是這樣"}, {"type": "subtitle", "time": 210.22899999999998, "timestamp": "00:03:30", "text": "。是的。"}, {"type": "subtitle", "time": 217.11, "timestamp": "00:03:37", "text": "我還沒做我的日常訓練，我想"}, {"type": "subtitle", "time": 220.22899999999998, "timestamp": "00:03:40", "text": "按照專業協議完成我的日常訓練。我忘了做"}, {"type": "subtitle", "time": 227.03, "timestamp": "00:03:47", "text": "這件事。嗯，你們介意我趁著"}, {"type": "subtitle", "time": 229.50900000000001, "timestamp": "00:03:49", "text": "啟動遊戲"}, {"type": "subtitle", "time": 233.589, "timestamp": "00:03:53", "text": "、設定參數之類的時間做一下嗎？"}, {"type": "subtitle", "time": 236.789, "timestamp": "00:03:56", "text": "等等，我已經下載了遊戲，對吧？"}]
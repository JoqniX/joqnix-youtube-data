[{"type": "subtitle", "time": 791.03, "timestamp": "00:13:11", "text": "戰場。快點。怎麼了？  怎麼了"}, {"type": "subtitle", "time": 792.949, "timestamp": "00:13:12", "text": "？"}, {"type": "subtitle", "time": 795.99, "timestamp": "00:13:15", "text": "怎麼了？還有這個人。快點。給"}, {"type": "subtitle", "time": 816.71, "timestamp": "00:13:36", "text": "給我一分鐘。我還是等"}]
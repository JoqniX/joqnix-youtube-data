[{"type": "subtitle", "time": 7572.229, "timestamp": "02:06:12", "text": "，"}, {"type": "subtitle", "time": 7576.629, "timestamp": "02:06:16", "text": "我在……我在……我在敵人那裡。  是的。  就是這樣。你的一位"}, {"type": "subtitle", "time": 7578.229, "timestamp": "02:06:18", "text": "隊友完成了加密。不錯吧"}, {"type": "subtitle", "time": 7586.95, "timestamp": "02:06:26", "text": "？  你們隊佔優勢。繼續努力。  我們走吧。"}]
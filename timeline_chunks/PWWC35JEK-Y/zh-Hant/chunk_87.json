[{"type": "subtitle", "time": 5221.669, "timestamp": "01:27:01", "text": "我知道。  等等，貝克，你想加入嗎？"}, {"type": "subtitle", "time": 5225.27, "timestamp": "01:27:05", "text": "我再打一場，然後我們就結束。我頭痛。"}, {"type": "subtitle", "time": 5232.31, "timestamp": "01:27:12", "text": "我想我抓住你了。  我有很多事情要忙。我不想再玩那種需要大量刷怪的遊戲了。我的意思是，我喜歡"}]
[{"type": "subtitle", "time": 6426.229, "timestamp": "01:47:06", "text": "[笑聲]"}, {"type": "subtitle", "time": 6427.35, "timestamp": "01:47:07", "text": "不是我。  向下。  需要醫護人員。  聖戰目標。  耶穌。  這傢伙速度真快。  嘿"}, {"type": "subtitle", "time": 6429.189, "timestamp": "01:47:09", "text": "，快到了。深入"}, {"type": "subtitle", "time": 6446.149, "timestamp": "01:47:26", "text": "挖掘並徹底解決。  哇。  我的天啊，我們死得太快了。  是啊，"}, {"type": "subtitle", "time": 6457.91, "timestamp": "01:47:37", "text": "這些"}, {"type": "subtitle", "time": 6462.31, "timestamp": "01:47:42", "text": "汗水太瘋狂了。  就這麼用這把槍。  哦，我們符合條件。"}]
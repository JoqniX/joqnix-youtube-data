[{"type": "subtitle", "time": 1204.23, "timestamp": "00:20:04", "text": "Okay,"}, {"type": "subtitle", "time": 1213.83, "timestamp": "00:20:13", "text": ">> until it called our bluff."}, {"type": "subtitle", "time": 1217.909, "timestamp": "00:20:17", "text": ">> Reports coming in of a tragedy that has"}, {"type": "subtitle", "time": 1220.71, "timestamp": "00:20:20", "text": "general has just been assassinated."}, {"type": "subtitle", "time": 1224.07, "timestamp": "00:20:24", "text": ">> NATO's response"}, {"type": "subtitle", "time": 1225.59, "timestamp": "00:20:25", "text": "Silence."}, {"type": "subtitle", "time": 1227.669, "timestamp": "00:20:27", "text": "NATO flinched."}, {"type": "subtitle", "time": 1231.99, "timestamp": "00:20:31", "text": "No response, no respect."}, {"type": "subtitle", "time": 1235.11, "timestamp": "00:20:35", "text": "And 12 nations walked."}, {"type": "subtitle", "time": 1237.029, "timestamp": "00:20:37", "text": ">> We have lost faith in NATO."}, {"type": "subtitle", "time": 1239.35, "timestamp": "00:20:39", "text": ">> Allow causing countries to abandon the"}, {"type": "subtitle", "time": 1239.83, "timestamp": "00:20:39", "text": "alliance."}, {"type": "subtitle", "time": 1243.35, "timestamp": "00:20:43", "text": ">> Well, everyone knew who did it."}, {"type": "subtitle", "time": 1245.27, "timestamp": "00:20:45", "text": ">> Armada."}, {"type": "subtitle", "time": 1247.75, "timestamp": "00:20:47", "text": ">> Built just like the military. It doesn't"}, {"type": "subtitle", "time": 1249.19, "timestamp": "00:20:49", "text": "play by their rules."}, {"type": "subtitle", "time": 1251.11, "timestamp": "00:20:51", "text": ">> Shadow armies without oversight."}, {"type": "subtitle", "time": 1253.75, "timestamp": "00:20:53", "text": "providing protection for a prize."}, {"type": "subtitle", "time": 1257.75, "timestamp": "00:20:57", "text": ">> Then things got real interesting."}]
[{"type": "subtitle", "time": 6801.43, "timestamp": "01:53:21", "text": "ああ、"}, {"type": "subtitle", "time": 6804.55, "timestamp": "01:53:24", "text": "こいつらが俺を追ってきてる。   まだ"}, {"type": "subtitle", "time": 6806.229, "timestamp": "01:53:26", "text": "？"}, {"type": "subtitle", "time": 6812.149, "timestamp": "01:53:32", "text": "私は死んだ。"}, {"type": "subtitle", "time": 6814.709, "timestamp": "01:53:34", "text": "私たちは2位です。"}, {"type": "subtitle", "time": 6817.669, "timestamp": "01:53:37", "text": "くそ。 出血が止まらない。 医療従事者。"}, {"type": "subtitle", "time": 6820.31, "timestamp": "01:53:40", "text": "しかし、2番目です。"}, {"type": "subtitle", "time": 6822.07, "timestamp": "01:53:42", "text": "ええ、あの二人は蘇生しませんでした。 私は"}, {"type": "subtitle", "time": 6828.31, "timestamp": "01:53:48", "text": "えっと、３番目。 第三チーム。"}, {"type": "subtitle", "time": 6833.03, "timestamp": "01:53:53", "text": "我々を追い越すだろう。 しかし、彼らにそうさせてはいけません。   ああ"}]
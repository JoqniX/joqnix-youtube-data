[{"type": "subtitle", "time": 4927.91, "timestamp": "01:22:07", "text": "偽者より先に言っておこう。   わかった"}, {"type": "subtitle", "time": 4930.95, "timestamp": "01:22:10", "text": "。 待って。"}, {"type": "subtitle", "time": 4933.99, "timestamp": "01:22:13", "text": "これはまるで仕事のようだ。 あなたはたくさんの"}, {"type": "subtitle", "time": 4941.27, "timestamp": "01:22:21", "text": "たくさんの仕事を与えられ、あなたはそれをやらなければなりません"}, {"type": "subtitle", "time": 4942.31, "timestamp": "01:22:22", "text": "。"}, {"type": "subtitle", "time": 4944.149, "timestamp": "01:22:24", "text": "そこがこのゲームの戦場だ。   もっと"}, {"type": "subtitle", "time": 4959.83, "timestamp": "01:22:39", "text": "守るぜ、相棒。 心配しないで。 見つけた。"}]
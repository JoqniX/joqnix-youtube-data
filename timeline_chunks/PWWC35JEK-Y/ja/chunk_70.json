[{"type": "subtitle", "time": 4206.07, "timestamp": "01:10:06", "text": "ちなみに、私たちはかなり遅れています。"}, {"type": "subtitle", "time": 4233.99, "timestamp": "01:10:33", "text": "これは3秒ではありません。 ちょっと待ってくれよ、"}, {"type": "subtitle", "time": 4254.229, "timestamp": "01:10:54", "text": "私のチームは実際には全員を殺しているんです。"}, {"type": "subtitle", "time": 4256.55, "timestamp": "01:10:56", "text": "ニース。"}]
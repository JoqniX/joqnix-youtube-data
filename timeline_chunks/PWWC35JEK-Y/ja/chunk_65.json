[{"type": "subtitle", "time": 3900.15, "timestamp": "01:05:00", "text": "ああ、私たちも次のラウンドに進出しましたよ"}, {"type": "subtitle", "time": 3901.109, "timestamp": "01:05:01", "text": "。"}, {"type": "subtitle", "time": 3902.71, "timestamp": "01:05:02", "text": "準備はいいか？ 悪人に安息はない"}, {"type": "subtitle", "time": 3910.47, "timestamp": "01:05:10", "text": "ああ、私たちはトップだ。 我々が一番だ。 聖なる。   私は"}, {"type": "subtitle", "time": 3915.27, "timestamp": "01:05:15", "text": "最下位です。 ああ、大丈夫です。"}, {"type": "subtitle", "time": 3917.829, "timestamp": "01:05:17", "text": "敵の通信網が途絶えた。 素晴らしい仕事ぶりでしたね"}, {"type": "subtitle", "time": 3919.67, "timestamp": "01:05:19", "text": "。"}, {"type": "subtitle", "time": 3921.589, "timestamp": "01:05:21", "text": "よし、これはバトルロイヤルよりも面白いゲームだ"}, {"type": "subtitle", "time": 3924.39, "timestamp": "01:05:24", "text": "。 私は"}, {"type": "subtitle", "time": 3926.309, "timestamp": "01:05:26", "text": "これが再配置なので気に入っています。   難しく考えすぎないで"}, {"type": "subtitle", "time": 3929.109, "timestamp": "01:05:29", "text": "。 あなたの仕事。"}, {"type": "subtitle", "time": 3931.349, "timestamp": "01:05:31", "text": "殺せ。 はい、わかりました。 それが私の得意分野です"}, {"type": "subtitle", "time": 3934.71, "timestamp": "01:05:34", "text": "。 そうします。"}, {"type": "subtitle", "time": 3953.51, "timestamp": "01:05:53", "text": "。 腕を回して、転がすんだ、ベイビー。"}]
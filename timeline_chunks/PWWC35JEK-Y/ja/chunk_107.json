[{"type": "subtitle", "time": 6424.959, "timestamp": "01:47:04", "text": "ニース。"}, {"type": "subtitle", "time": 6426.229, "timestamp": "01:47:06", "text": "[笑い]"}, {"type": "subtitle", "time": 6427.35, "timestamp": "01:47:07", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 6429.189, "timestamp": "01:47:09", "text": "よくやった。 さあ、この調子で続けて。 まだ終わっていませんよ"}, {"type": "subtitle", "time": 6432.31, "timestamp": "01:47:12", "text": "。"}, {"type": "subtitle", "time": 6446.149, "timestamp": "01:47:26", "text": "見事な実行力だ。 さあ、団結しよう。 まだまだこれからです"}, {"type": "subtitle", "time": 6457.91, "timestamp": "01:47:37", "text": "インテルによると、敵対勢力の一部が"}, {"type": "subtitle", "time": 6459.83, "timestamp": "01:47:39", "text": "君たちの部隊を標的にしているとのこと。"}, {"type": "subtitle", "time": 6462.31, "timestamp": "01:47:42", "text": "彼らの主要な資産も排除する必要がある。"}, {"type": "subtitle", "time": 6475.75, "timestamp": "01:47:55", "text": "うん。   出て行け"}, {"type": "subtitle", "time": 6477.27, "timestamp": "01:47:57", "text": "。"}]
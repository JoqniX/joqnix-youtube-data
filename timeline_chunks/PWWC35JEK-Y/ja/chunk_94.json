[{"type": "subtitle", "time": 5640.149, "timestamp": "01:34:00", "text": "もし音がうるさいようでしたら、ゲームに戻りましょう。"}, {"type": "subtitle", "time": 5642.709, "timestamp": "01:34:02", "text": "大丈夫です。"}, {"type": "subtitle", "time": 5644.39, "timestamp": "01:34:04", "text": "はい、これでよし"}, {"type": "subtitle", "time": 5645.189, "timestamp": "01:34:05", "text": "。   私も同じ経験をしました"}, {"type": "subtitle", "time": 5648.229, "timestamp": "01:34:08", "text": "。"}, {"type": "subtitle", "time": 5650.31, "timestamp": "01:34:10", "text": "あ、電源を切ったよ。"}, {"type": "subtitle", "time": 5652.55, "timestamp": "01:34:12", "text": "よし、行こう。   さあ行こう"}, {"type": "subtitle", "time": 5654.07, "timestamp": "01:34:14", "text": "。"}, {"type": "subtitle", "time": 5656.47, "timestamp": "01:34:16", "text": "待って、どのモードでプレイできるの？"}, {"type": "subtitle", "time": 5665.59, "timestamp": "01:34:25", "text": "私はあのガントレットが好きだ。 ガントレットは楽しい。"}, {"type": "subtitle", "time": 5666.709, "timestamp": "01:34:26", "text": "ガントレットは楽しい。   バトル"}, {"type": "subtitle", "time": 5669.99, "timestamp": "01:34:29", "text": "ロイヤルで戦おう。 あっという間に死んでしまう。"}, {"type": "subtitle", "time": 5671.75, "timestamp": "01:34:31", "text": "その通り。"}, {"type": "subtitle", "time": 5673.91, "timestamp": "01:34:33", "text": "なぜあなたがそんなに"}, {"type": "subtitle", "time": 5675.83, "timestamp": "01:34:35", "text": "早く亡くなってしまったのか、私には分かりません。 蘇生できるかどうかは分かりませんが、"}, {"type": "subtitle", "time": 5677.43, "timestamp": "01:34:37", "text": "蘇生できると思います。 しかし、それでも"}, {"type": "subtitle", "time": 5688.31, "timestamp": "01:34:48", "text": "うん、ガントレットはいいよね。"}, {"type": "subtitle", "time": 5690.695, "timestamp": "01:34:50", "text": "フルゲームを購入してください。"}, {"type": "subtitle", "time": 5693.99, "timestamp": "01:34:53", "text": "[笑い] ええ、フルゲームを買えばいいんですよ。"}]
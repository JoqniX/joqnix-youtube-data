[{"type": "subtitle", "time": 1382.71, "timestamp": "00:23:02", "text": "、壊滅的な事態になるだろう。   そんなことは絶対に"}, {"type": "subtitle", "time": 1386.549, "timestamp": "00:23:06", "text": "許さない。"}, {"type": "subtitle", "time": 1399.99, "timestamp": "00:23:19", "text": "バトルフィールド・スタジオ。"}, {"type": "subtitle", "time": 1402.149, "timestamp": "00:23:22", "text": "おはようございます、カリフォルニア。 今日はとても"}, {"type": "subtitle", "time": 1403.59, "timestamp": "00:23:23", "text": "良い天気だ。"}, {"type": "subtitle", "time": 1405.43, "timestamp": "00:23:25", "text": "議会はロビイストに対する調査を継続している"}, {"type": "subtitle", "time": 1406.95, "timestamp": "00:23:26", "text": "。   それは"}, {"type": "subtitle", "time": 1408.149, "timestamp": "00:23:28", "text": "同じものですか？"}, {"type": "subtitle", "time": 1410.549, "timestamp": "00:23:30", "text": "高速道路は渋滞がひどい。 いっそ"}, {"type": "subtitle", "time": 1411.83, "timestamp": "00:23:31", "text": "家にいた方がいいかもしれない。"}, {"type": "subtitle", "time": 1413.83, "timestamp": "00:23:33", "text": "ビーチの住民たちは、"}, {"type": "subtitle", "time": 1416.71, "timestamp": "00:23:36", "text": "軍の駐留レベルの増加に懸念を表明している。"}, {"type": "subtitle", "time": 1433.51, "timestamp": "00:23:53", "text": "これって、さっき見たものと同じじゃない"}, {"type": "subtitle", "time": 1434.07, "timestamp": "00:23:54", "text": "？"}, {"type": "subtitle", "time": 1435.75, "timestamp": "00:23:55", "text": "警備隊は当該地域から避難させた。"}, {"type": "subtitle", "time": 1439.19, "timestamp": "00:23:59", "text": "私たちは攻撃を受けているのか？"}]
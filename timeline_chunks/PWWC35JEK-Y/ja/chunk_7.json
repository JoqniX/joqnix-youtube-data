[{"type": "subtitle", "time": 420.629, "timestamp": "00:07:00", "text": "待って、ちょっと手早くやらせてください。"}, {"type": "subtitle", "time": 422.469, "timestamp": "00:07:02", "text": "はい、接続が切断される可能性があります。 私の"}, {"type": "subtitle", "time": 448.309, "timestamp": "00:07:28", "text": "はい、そろそろ戻ります。 こんにちは。"}, {"type": "subtitle", "time": 450.87, "timestamp": "00:07:30", "text": "ああ、ゲームの起動にものすごく時間がかかっている"}, {"type": "subtitle", "time": 470.79, "timestamp": "00:07:50", "text": "待って、死んでしまった。 ああ、なんてことだ、死んでしまった。"}, {"type": "subtitle", "time": 473.749, "timestamp": "00:07:53", "text": "とにかくプレイしよう。 一体どういうことだ？ それは愚かなゲームを始動させた"}]
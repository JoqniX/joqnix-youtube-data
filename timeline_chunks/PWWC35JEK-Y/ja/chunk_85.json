[{"type": "subtitle", "time": 5113.669, "timestamp": "01:25:13", "text": "同じゲームプレイ"}, {"type": "subtitle", "time": 5117.11, "timestamp": "01:25:17", "text": "ボードだったので削除しました。 うん、どっちにしても"}, {"type": "subtitle", "time": 5120.55, "timestamp": "01:25:20", "text": "全部削除するつもりだよ。"}, {"type": "subtitle", "time": 5123.669, "timestamp": "01:25:23", "text": "だって"}, {"type": "subtitle", "time": 5126.87, "timestamp": "01:25:26", "text": "今は他のゲームをいくつかやり込まなきゃいけないから。 つまり、これは楽しいってこと。   後でまた触れます"}, {"type": "subtitle", "time": 5129.91, "timestamp": "01:25:29", "text": "。 例えば、"}, {"type": "subtitle", "time": 5131.43, "timestamp": "01:25:31", "text": "バトルロイヤルじゃなくて"}, {"type": "subtitle", "time": 5134.229, "timestamp": "01:25:34", "text": "マルチプレイヤーだったら、彼に"}, {"type": "subtitle", "time": 5136.87, "timestamp": "01:25:36", "text": "プレイしてもらっていたと思う。  [鼻を鳴らす] でも、また"}, {"type": "subtitle", "time": 5146.07, "timestamp": "01:25:46", "text": "ブロイ、君は燃え尽きてしまったんだね。"}, {"type": "subtitle", "time": 5149.189, "timestamp": "01:25:49", "text": "私の人生には、たった一つのゲームがある。 私はそれを自分の"}]
[{"type": "subtitle", "time": 5611.83, "timestamp": "01:33:31", "text": "こんにちは、ベーコン。"}, {"type": "subtitle", "time": 5614.31, "timestamp": "01:33:34", "text": "こんにちは。 こんにちは。 こんにちは。"}, {"type": "subtitle", "time": 5616.709, "timestamp": "01:33:36", "text": "クソッ。"}, {"type": "subtitle", "time": 5619.27, "timestamp": "01:33:39", "text": "このゲーム、動作がすごく重い。  [笑い]"}, {"type": "subtitle", "time": 5623.11, "timestamp": "01:33:43", "text": "わかってるよ。 ゲーム内でマイクをオンにしているのです"}, {"type": "subtitle", "time": 5625.669, "timestamp": "01:33:45", "text": "が、なぜか"}, {"type": "subtitle", "time": 5629.779, "timestamp": "01:33:49", "text": "話していることが表示されないんです。"}, {"type": "subtitle", "time": 5631.75, "timestamp": "01:33:51", "text": "[音楽] こんにちは。 こんにちは。 こんにちは。 しまった、喋っちゃった"}, {"type": "subtitle", "time": 5633.03, "timestamp": "01:33:53", "text": "。   聞こえません"}, {"type": "subtitle", "time": 5633.91, "timestamp": "01:33:53", "text": "。   聞こえますか"}, {"type": "subtitle", "time": 5634.95, "timestamp": "01:33:54", "text": "？   わかった"}, {"type": "subtitle", "time": 5636.79, "timestamp": "01:33:56", "text": "。 わかった。 あなたにとってはうるさいですか？ わかりました。"}]
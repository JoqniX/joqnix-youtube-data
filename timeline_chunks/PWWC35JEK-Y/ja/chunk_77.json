[{"type": "subtitle", "time": 4624.229, "timestamp": "01:17:04", "text": "ここは飛行場です。"}, {"type": "subtitle", "time": 4626.39, "timestamp": "01:17:06", "text": "発見したビーコンはすべて安全に保護し、復号化してください。"}, {"type": "subtitle", "time": 4629.03, "timestamp": "01:17:09", "text": "データは業務運営において極めて重要である。 敵との"}, {"type": "subtitle", "time": 4631.51, "timestamp": "01:17:11", "text": "接触は避けられないので、気を引き締めておけ。"}, {"type": "subtitle", "time": 4658.87, "timestamp": "01:17:38", "text": "全員死にました。 ああ、よかった。 一人だけ"}, {"type": "subtitle", "time": 4660.709, "timestamp": "01:17:40", "text": "生存している。"}, {"type": "subtitle", "time": 4672.63, "timestamp": "01:17:52", "text": "、気にしないで。"}]
[{"type": "subtitle", "time": 1204.23, "timestamp": "00:20:04", "text": "よし、"}, {"type": "subtitle", "time": 1213.83, "timestamp": "00:20:13", "text": "我々の虚勢を見破った。"}, {"type": "subtitle", "time": 1217.909, "timestamp": "00:20:17", "text": "悲劇的な事件の報告が入ってきており、"}, {"type": "subtitle", "time": 1220.71, "timestamp": "00:20:20", "text": "一般市民が暗殺されたばかりだ。"}, {"type": "subtitle", "time": 1224.07, "timestamp": "00:20:24", "text": "NATOの反応は"}, {"type": "subtitle", "time": 1225.59, "timestamp": "00:20:25", "text": "沈黙だった。"}, {"type": "subtitle", "time": 1227.669, "timestamp": "00:20:27", "text": "NATOはひるんだ。"}, {"type": "subtitle", "time": 1231.99, "timestamp": "00:20:31", "text": "返答がないということは、敬意がないということだ。"}, {"type": "subtitle", "time": 1235.11, "timestamp": "00:20:35", "text": "そして12カ国が徒歩で参加した。"}, {"type": "subtitle", "time": 1237.029, "timestamp": "00:20:37", "text": "我々はNATOへの信頼を失った。"}, {"type": "subtitle", "time": 1239.35, "timestamp": "00:20:39", "text": "各国が同盟から離脱するのを容認する"}, {"type": "subtitle", "time": 1239.83, "timestamp": "00:20:39", "text": "。"}, {"type": "subtitle", "time": 1243.35, "timestamp": "00:20:43", "text": "まあ、誰がやったかはみんな知っていたよ。"}, {"type": "subtitle", "time": 1245.27, "timestamp": "00:20:45", "text": "艦隊。   まるで"}, {"type": "subtitle", "time": 1247.75, "timestamp": "00:20:47", "text": "軍用機のように作られている。 それは"}, {"type": "subtitle", "time": 1249.19, "timestamp": "00:20:49", "text": "彼らのルールに従わない。"}, {"type": "subtitle", "time": 1251.11, "timestamp": "00:20:51", "text": "監視の目が届かない影の軍隊。"}, {"type": "subtitle", "time": 1253.75, "timestamp": "00:20:53", "text": "賞品を保護すること。"}, {"type": "subtitle", "time": 1257.75, "timestamp": "00:20:57", "text": "そして事態は一気に面白くなった。"}]
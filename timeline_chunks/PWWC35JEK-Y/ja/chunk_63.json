[{"type": "subtitle", "time": 3781.19, "timestamp": "01:03:01", "text": "。   あの"}, {"type": "subtitle", "time": 3782.87, "timestamp": "01:03:02", "text": "男がそこにいたことすら知らなかった。"}, {"type": "subtitle", "time": 3784.549, "timestamp": "01:03:04", "text": "遠くから狙撃されたと思った"}, {"type": "subtitle", "time": 3788.309, "timestamp": "01:03:08", "text": "。 どうでも。"}, {"type": "subtitle", "time": 3835.19, "timestamp": "01:03:55", "text": "おい、お前の部隊の戦闘目標だ。 もうすぐだ"}, {"type": "subtitle", "time": 3837.829, "timestamp": "01:03:57", "text": "。 それを終わらせてください。"}]
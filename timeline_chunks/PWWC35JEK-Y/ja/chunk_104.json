[{"type": "subtitle", "time": 6241.59, "timestamp": "01:44:01", "text": "この銃を適当に使ってみてください。"}, {"type": "subtitle", "time": 6244.629, "timestamp": "01:44:04", "text": "ああ、私たちは条件を満たしています。 ニース。"}, {"type": "subtitle", "time": 6247.35, "timestamp": "01:44:07", "text": "どうやって？ どうやって？"}, {"type": "subtitle", "time": 6249.75, "timestamp": "01:44:09", "text": "よし、素晴らしい仕事ぶりだった。"}, {"type": "subtitle", "time": 6264.79, "timestamp": "01:44:24", "text": "よくぞ彼に戦いを挑んだものだ。 忘れないでください、まだ終わりではありません"}, {"type": "subtitle", "time": 6267.75, "timestamp": "01:44:27", "text": "。"}, {"type": "subtitle", "time": 6269.75, "timestamp": "01:44:29", "text": "ああ、契約書のことか。 契約ミッションは嫌いだ。敵を全滅させなきゃいけない"}, {"type": "subtitle", "time": 6272.95, "timestamp": "01:44:32", "text": "から。"}, {"type": "subtitle", "time": 6275.03, "timestamp": "01:44:35", "text": "簡単だ。 他の打者を排除しろ"}, {"type": "subtitle", "time": 6276.95, "timestamp": "01:44:36", "text": "。 成功以外の結果はすべて、"}, {"type": "subtitle", "time": 6278.149, "timestamp": "01:44:38", "text": "OPからあなたを外すことになります。"}, {"type": "subtitle", "time": 6280.07, "timestamp": "01:44:40", "text": "しかし、私たちのうちの一人が生きていれば、それで"}, {"type": "subtitle", "time": 6281.91, "timestamp": "01:44:41", "text": "良いのです。"}]
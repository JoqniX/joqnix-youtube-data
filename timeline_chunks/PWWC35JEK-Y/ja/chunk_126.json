[{"type": "subtitle", "time": 7567.43, "timestamp": "02:06:07", "text": "撃つのをやめてください。 彼にそれを取り戻させろ。"}, {"type": "subtitle", "time": 7570.229, "timestamp": "02:06:10", "text": "彼を殺せ。 ああ。"}, {"type": "subtitle", "time": 7572.229, "timestamp": "02:06:12", "text": "ああ、スコープはない。  [笑い]"}, {"type": "subtitle", "time": 7572.629, "timestamp": "02:06:12", "text": "いいね。"}, {"type": "subtitle", "time": 7576.629, "timestamp": "02:06:16", "text": "遅れてすみません。 彼はここにいる"}, {"type": "subtitle", "time": 7578.229, "timestamp": "02:06:18", "text": "男だ。"}, {"type": "subtitle", "time": 7586.95, "timestamp": "02:06:26", "text": "私の銃はどうなっているの？"}]
[{"type": "subtitle", "time": 3487.99, "timestamp": "00:58:07", "text": "しばらくこれをプレイしましょう。"}, {"type": "subtitle", "time": 3506.069, "timestamp": "00:58:26", "text": "、とにかくそこに行って、ひたすら頑張れ。"}, {"type": "subtitle", "time": 3507.99, "timestamp": "00:58:27", "text": "詳細な説明をする時間はありません。"}, {"type": "subtitle", "time": 3511.349, "timestamp": "00:58:31", "text": "注文が殺到するだろう。"}, {"type": "subtitle", "time": 3513.91, "timestamp": "00:58:33", "text": "残骸。"}, {"type": "subtitle", "time": 3516.309, "timestamp": "00:58:36", "text": "爆発物が使用されている。 これらを使って"}, {"type": "subtitle", "time": 3518.39, "timestamp": "00:58:38", "text": "敵のミルクコムを破壊し、"}, {"type": "subtitle", "time": 3520.87, "timestamp": "00:58:40", "text": "その爆薬を解除する準備をしておいてください。 さあ、急いで。"}]
[{"type": "subtitle", "time": 7929.99, "timestamp": "02:12:09", "text": "ゲームのスタイルをありがとうございます。"}, {"type": "subtitle", "time": 7934.069, "timestamp": "02:12:14", "text": "はい、ご心配いただきありがとうございます。   私を"}, {"type": "subtitle", "time": 7936.31, "timestamp": "02:12:16", "text": "運んでくれてありがとう。 それは"}, {"type": "subtitle", "time": 7943.43, "timestamp": "02:12:23", "text": "次回はもっとこのゲームをプレイするべきだよ"}, {"type": "subtitle", "time": 7945.27, "timestamp": "02:12:25", "text": "。"}, {"type": "subtitle", "time": 7947.109, "timestamp": "02:12:27", "text": "はい、あなた"}, {"type": "subtitle", "time": 7948.709, "timestamp": "02:12:28", "text": "のコンピューターには十分なストレージ容量があります"}, {"type": "subtitle", "time": 7949.43, "timestamp": "02:12:29", "text": "。"}, {"type": "subtitle", "time": 7953.189, "timestamp": "02:12:33", "text": "ゲームをいくつかアンインストールしないといけない。 はい。"}, {"type": "subtitle", "time": 7957.27, "timestamp": "02:12:37", "text": "私はそうでしょうか？ こんにちは。 彼らがしくじったら、私が締めくくります"}, {"type": "subtitle", "time": 7960.47, "timestamp": "02:12:40", "text": "。 気をつけてね、ベーコン。 おやすみ。"}, {"type": "subtitle", "time": 7961.03, "timestamp": "02:12:41", "text": "こんにちは。"}, {"type": "subtitle", "time": 7962.709, "timestamp": "02:12:42", "text": "さようなら、ストリーム。"}, {"type": "subtitle", "time": 7964.79, "timestamp": "02:12:44", "text": "バイバイ。"}, {"type": "subtitle", "time": 7970.55, "timestamp": "02:12:50", "text": "こんにちは、オリーブ。"}, {"type": "subtitle", "time": 7976.629, "timestamp": "02:12:56", "text": "ベーコン。"}]
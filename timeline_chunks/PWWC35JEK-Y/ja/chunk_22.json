[{"type": "subtitle", "time": 1322.23, "timestamp": "00:22:02", "text": "世界規模の紛争の脅威は"}, {"type": "subtitle", "time": 1325.029, "timestamp": "00:22:05", "text": "高まり続けている。 旧NATO加盟国間で緊張が再燃している"}, {"type": "subtitle", "time": 1326.87, "timestamp": "00:22:06", "text": "。 国土安全保障省は、"}, {"type": "subtitle", "time": 1329.75, "timestamp": "00:22:09", "text": "心配する必要はないと断言している。"}, {"type": "subtitle", "time": 1330.71, "timestamp": "00:22:10", "text": "さて、"}, {"type": "subtitle", "time": 1333.43, "timestamp": "00:22:13", "text": "こちらはフォート・リンドンで大規模な爆発があったという報告です"}, {"type": "subtitle", "time": 1335.909, "timestamp": "00:22:15", "text": "。 軍事基地からの巨大な写真"}, {"type": "subtitle", "time": 1336.789, "timestamp": "00:22:16", "text": "。"}, {"type": "subtitle", "time": 1338.95, "timestamp": "00:22:18", "text": "州兵が当該地域から避難させた。"}, {"type": "subtitle", "time": 1342.31, "timestamp": "00:22:22", "text": "私たちは攻撃を受けているのか？"}, {"type": "subtitle", "time": 1344.47, "timestamp": "00:22:24", "text": "時間の問題だった。"}, {"type": "subtitle", "time": 1346.63, "timestamp": "00:22:26", "text": "化学物質による汚染の噂が広まっている。"}, {"type": "subtitle", "time": 1348.149, "timestamp": "00:22:28", "text": "統合参謀本部が大統領と会談している"}, {"type": "subtitle", "time": 1348.95, "timestamp": "00:22:28", "text": "。"}, {"type": "subtitle", "time": 1352.39, "timestamp": "00:22:32", "text": "ASは、潜伏感染細胞が実在することを認めた。   わかった"}, {"type": "subtitle", "time": 1353.11, "timestamp": "00:22:33", "text": "。"}, {"type": "subtitle", "time": 1356.71, "timestamp": "00:22:36", "text": "最初は東海岸だった。 今度は"}, {"type": "subtitle", "time": 1357.51, "timestamp": "00:22:37", "text": "西側だ。"}, {"type": "subtitle", "time": 1359.11, "timestamp": "00:22:39", "text": "攻撃は"}, {"type": "subtitle", "time": 1361.35, "timestamp": "00:22:41", "text": "南カリフォルニア全域に広がっているようだ。 戦闘が街路を駆け巡り、混乱の光景が広がる"}, {"type": "subtitle", "time": 1363.19, "timestamp": "00:22:43", "text": "。"}, {"type": "subtitle", "time": 1364.789, "timestamp": "00:22:44", "text": "これは爆発と関係がありますか？"}, {"type": "subtitle", "time": 1367.029, "timestamp": "00:22:47", "text": "警官による組織的な攻撃。"}, {"type": "subtitle", "time": 1371.51, "timestamp": "00:22:51", "text": "増大する脅威に対応するため軍が配備されたことで、フォート・リンドンは"}, {"type": "subtitle", "time": 1373.27, "timestamp": "00:22:53", "text": "争奪の的となっている。"}, {"type": "subtitle", "time": 1375.19, "timestamp": "00:22:55", "text": "そこにはグルーム・レイクよりも多くの秘密が隠されている"}, {"type": "subtitle", "time": 1378.47, "timestamp": "00:22:58", "text": "。 もしその情報が悪者の手に渡れば"}]
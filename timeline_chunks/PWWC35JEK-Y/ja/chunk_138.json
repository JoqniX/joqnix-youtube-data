[{"type": "subtitle", "time": 8281.11, "timestamp": "02:18:01", "text": "休んで。"}, {"type": "subtitle", "time": 8284.15, "timestamp": "02:18:04", "text": "頭が痛いんだ。"}, {"type": "subtitle", "time": 8287.589, "timestamp": "02:18:07", "text": "あぁ。[鼻を鳴らす] でも、うん。こんにちは。ということで"}, {"type": "subtitle", "time": 8290.309, "timestamp": "02:18:10", "text": "、今日はありがとう。"}, {"type": "subtitle", "time": 8291.75, "timestamp": "02:18:11", "text": "来てくれてありがとう。"}, {"type": "subtitle", "time": 8296.709, "timestamp": "02:18:16", "text": "今夜9時に会おう"}, {"type": "subtitle", "time": 8305.509, "timestamp": "02:18:25", "text": "。授業が早く終わって、ご飯とか食べて、元気だったら、9時に配信するよ。よし。9時から"}, {"type": "subtitle", "time": 8310.309, "timestamp": "02:18:30", "text": "12時まで。12時以降は、ぐっすり眠るよ。"}, {"type": "subtitle", "time": 8313.19, "timestamp": "02:18:33", "text": "午前3時には寝ない。"}, {"type": "chat", "time": 8316.205, "timestamp": "02:18:36", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "bai"}, {"type": "subtitle", "time": 8316.309, "timestamp": "02:18:36", "text": "昨日みたいに午前3時には寝ない。"}, {"type": "subtitle", "time": 8325.27, "timestamp": "02:18:45", "text": "今日みたいにほとんど眠れなくて疲れてるなんてことはない。だから、早めに行くよ。こんにちは。"}, {"type": "subtitle", "time": 8329.19, "timestamp": "02:18:49", "text": "あ、"}, {"type": "subtitle", "time": 8331.91, "timestamp": "02:18:51", "text": "スケジュール1にハロウィンのアップデートがあるよ。ああ、スケジュール"}, {"type": "subtitle", "time": 8338.95, "timestamp": "02:18:58", "text": "。"}]
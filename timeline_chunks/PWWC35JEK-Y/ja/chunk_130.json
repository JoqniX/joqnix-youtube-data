[{"type": "subtitle", "time": 7803.589, "timestamp": "02:10:03", "text": "俺はクソ野郎だ"}, {"type": "subtitle", "time": 7805.83, "timestamp": "02:10:05", "text": "。   一体"}, {"type": "subtitle", "time": 7817.51, "timestamp": "02:10:17", "text": "私はもっ​​と高いところへ行く。"}, {"type": "subtitle", "time": 7821.03, "timestamp": "02:10:21", "text": "ああ、なんてことだ、すごくハイになってる。"}, {"type": "subtitle", "time": 7826.39, "timestamp": "02:10:26", "text": "ブルームルームの利用時間が"}, {"type": "subtitle", "time": 7827.99, "timestamp": "02:10:27", "text": "残り少なくなってきました。 この任務を"}, {"type": "subtitle", "time": 7830.31, "timestamp": "02:10:30", "text": "やり遂げよう。"}, {"type": "subtitle", "time": 7848.709, "timestamp": "02:10:48", "text": "彼は私をナイフで刺した。 隠れる。 ニース。"}, {"type": "subtitle", "time": 7851.669, "timestamp": "02:10:51", "text": "ベーコン。 今から行くよ。"}]
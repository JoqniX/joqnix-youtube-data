[{"type": "subtitle", "time": 7200.229, "timestamp": "02:00:00", "text": "それでおしまい。 チームメイトの一人が"}, {"type": "subtitle", "time": 7207.189, "timestamp": "02:00:07", "text": "君のチームが有利だ。 諦めずに"}, {"type": "subtitle", "time": 7208.149, "timestamp": "02:00:08", "text": "頑張り続けろ。   さあ行こう"}, {"type": "subtitle", "time": 7229.589, "timestamp": "02:00:29", "text": "ああ、君のことは分かったよ。"}, {"type": "subtitle", "time": 7231.75, "timestamp": "02:00:31", "text": "敵を視界に捉えた。"}, {"type": "subtitle", "time": 7242.149, "timestamp": "02:00:42", "text": "あの辺りは様子が良くない。"}]
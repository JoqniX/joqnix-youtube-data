[{"type": "subtitle", "time": 6086.149, "timestamp": "01:41:26", "text": "ああ、なんてことだ、人がいる。 私に"}, {"type": "subtitle", "time": 6095.27, "timestamp": "01:41:35", "text": "フリック。 フリック。 フリック。 フリック。 フリック。 神父"}, {"type": "subtitle", "time": 6096.95, "timestamp": "01:41:36", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 6098.47, "timestamp": "01:41:38", "text": "安全に過ごしてください。 安全に過ごしてください。 私はここにいます。 私はここにいます"}, {"type": "subtitle", "time": 6112.87, "timestamp": "01:41:52", "text": "お前は死んだ。"}, {"type": "subtitle", "time": 6114.709, "timestamp": "01:41:54", "text": "私は死んだ。"}]
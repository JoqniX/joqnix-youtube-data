[{"type": "subtitle", "time": 6360.95, "timestamp": "01:46:00", "text": "おい、あそこに狙撃手がいるぞ。"}, {"type": "subtitle", "time": 6362.149, "timestamp": "01:46:02", "text": "敵を視界に捉えた。"}, {"type": "subtitle", "time": 6363.91, "timestamp": "01:46:03", "text": "そうそう。 しまった。   見つけた。"}, {"type": "subtitle", "time": 6378.87, "timestamp": "01:46:18", "text": "君一人だけだ。 すべてのショットを無駄にしない"}, {"type": "subtitle", "time": 6379.99, "timestamp": "01:46:19", "text": "。   大丈夫だよ。   来て"}, {"type": "subtitle", "time": 6388.709, "timestamp": "01:46:28", "text": "。"}, {"type": "subtitle", "time": 6391.91, "timestamp": "01:46:31", "text": "待って。 彼らは死ぬだろう。 いいえ、あなたは起きていてください"}, {"type": "subtitle", "time": 6417.189, "timestamp": "01:46:57", "text": "ここで覆い隠す。"}]
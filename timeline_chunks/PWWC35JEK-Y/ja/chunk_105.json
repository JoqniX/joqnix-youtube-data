[{"type": "subtitle", "time": 6308.709, "timestamp": "01:45:08", "text": "ああ、私は死んだ。 何てことだ。"}, {"type": "subtitle", "time": 6310.31, "timestamp": "01:45:10", "text": "え、何？  1馬力。   来て"}, {"type": "subtitle", "time": 6312.55, "timestamp": "01:45:12", "text": "。  1馬力。"}, {"type": "subtitle", "time": 6313.59, "timestamp": "01:45:13", "text": "死なないでください。 死なないでください。"}, {"type": "subtitle", "time": 6316.56, "timestamp": "01:45:16", "text": "死なないでください。 4番目。"}, {"type": "subtitle", "time": 6318.96, "timestamp": "01:45:18", "text": "4番目。 あの男は死んだのか？"}, {"type": "subtitle", "time": 6320.88, "timestamp": "01:45:20", "text": "あの男は死んだのか？ ああ、彼はトップだ。 生きていてくれて本当に良かった"}, {"type": "subtitle", "time": 6324.8, "timestamp": "01:45:24", "text": "ああ、彼はトップだ。 生きていてくれて本当に良かった 。"}, {"type": "subtitle", "time": 6345.189, "timestamp": "01:45:45", "text": "接触。   何てことだ"}, {"type": "subtitle", "time": 6354.95, "timestamp": "01:45:54", "text": "できますか？ああ、なんてこった。 私は"}, {"type": "subtitle", "time": 6357.03, "timestamp": "01:45:57", "text": "反対側にいる。"}, {"type": "subtitle", "time": 6359.51, "timestamp": "01:45:59", "text": "ああ、なんてことだ、敵が多すぎる。"}]
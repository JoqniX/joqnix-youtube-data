[{"type": "subtitle", "time": 6960.79, "timestamp": "01:56:00", "text": "ええ。   このせいでまるまる一"}, {"type": "subtitle", "time": 6963.35, "timestamp": "01:56:03", "text": "ヶ月もご迷惑をおかけして申し訳ありませんでした"}, {"type": "subtitle", "time": 6979.91, "timestamp": "01:56:19", "text": "電話の調子はどうですか？ まるで寝ていたみたいだったので、その配信は見ていませんでした"}, {"type": "subtitle", "time": 6982.229, "timestamp": "01:56:22", "text": "。"}, {"type": "subtitle", "time": 6984.55, "timestamp": "01:56:24", "text": "どれ？"}, {"type": "subtitle", "time": 6986.95, "timestamp": "01:56:26", "text": "クーンへお越しください。   何てことだ"}, {"type": "subtitle", "time": 6991.75, "timestamp": "01:56:31", "text": "。 私は叫び声をあげ、諦めた。"}, {"type": "subtitle", "time": 6994.31, "timestamp": "01:56:34", "text": "私は内心、死んでいくような思いだった。"}, {"type": "subtitle", "time": 6995.51, "timestamp": "01:56:35", "text": "長期的な視点で取り組む必要がある"}, {"type": "subtitle", "time": 6997.75, "timestamp": "01:56:37", "text": "。 さあ、準備を整えて次の"}, {"type": "subtitle", "time": 7002.31, "timestamp": "01:56:42", "text": "展開に備えよう。 私は諦めてしまったことを自覚しています。"}, {"type": "subtitle", "time": 7004.31, "timestamp": "01:56:44", "text": "プレイしてクリアしなければならない。"}, {"type": "subtitle", "time": 7005.99, "timestamp": "01:56:45", "text": "ここでのあなたの仕事は、私たちが何に"}, {"type": "subtitle", "time": 7012.709, "timestamp": "01:56:52", "text": "対処しているのかを理解するのに役立つ限り多くの通信を傍受して解読することです。   いやいや、"}]
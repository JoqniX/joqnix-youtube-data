[{"type": "subtitle", "time": 1261.43, "timestamp": "00:21:01", "text": "背中が急上昇し、あらゆるラインを試した。"}, {"type": "subtitle", "time": 1265.669, "timestamp": "00:21:05", "text": "異国の地からあなたの玄関先まで、"}, {"type": "subtitle", "time": 1267.35, "timestamp": "00:21:07", "text": "世界の指導者の命を脅かし、"}, {"type": "subtitle", "time": 1269.27, "timestamp": "00:21:09", "text": "主権領土を侵略し、"}, {"type": "subtitle", "time": 1273.51, "timestamp": "00:21:13", "text": "歴史を乗っ取り、最前線で。"}, {"type": "subtitle", "time": 1276.31, "timestamp": "00:21:16", "text": "この前例のない状況は、言葉で表現することしかできない"}, {"type": "subtitle", "time": 1277.35, "timestamp": "00:21:17", "text": "。"}, {"type": "subtitle", "time": 1280.149, "timestamp": "00:21:20", "text": "ますます爆発的になっている。 イラクは断固として抵抗し、"}, {"type": "subtitle", "time": 1284.87, "timestamp": "00:21:24", "text": "NATOは準備万端だ。   一度"}, {"type": "subtitle", "time": 1287.19, "timestamp": "00:21:27", "text": "主導権を手放したら、それを"}, {"type": "subtitle", "time": 1291.029, "timestamp": "00:21:31", "text": "取り戻すために戦わなければならない。 そして、まさにそれが"}, {"type": "subtitle", "time": 1292.549, "timestamp": "00:21:32", "text": "我々がこれから行うことだ。   わかった"}, {"type": "subtitle", "time": 1299.59, "timestamp": "00:21:39", "text": "くそ。"}, {"type": "subtitle", "time": 1305.51, "timestamp": "00:21:45", "text": "おはようございます、カリフォルニア。 今日はとても"}, {"type": "subtitle", "time": 1307.43, "timestamp": "00:21:47", "text": "良い天気だ。 議会は"}, {"type": "subtitle", "time": 1310.71, "timestamp": "00:21:50", "text": "企業ロビー活動に関する調査を継続している。"}, {"type": "subtitle", "time": 1311.99, "timestamp": "00:21:51", "text": "高速道路は渋滞がひどいようだ"}, {"type": "subtitle", "time": 1315.11, "timestamp": "00:21:55", "text": "。 彼らはただ家にいるだけだ。"}, {"type": "subtitle", "time": 1317.11, "timestamp": "00:21:57", "text": "ビーチの住民たちは、"}, {"type": "subtitle", "time": 1319.909, "timestamp": "00:21:59", "text": "軍の駐留レベルの増加に懸念を表明している。"}]
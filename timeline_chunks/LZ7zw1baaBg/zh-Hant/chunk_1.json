[{"type": "subtitle", "time": 68.55, "timestamp": "00:01:08", "text": "好的。歡迎各位。歡迎來到"}, {"type": "subtitle", "time": 71.51, "timestamp": "00:01:11", "text": "Joathon 第 134 天。"}, {"type": "subtitle", "time": 74.789, "timestamp": "00:01:14", "text": "歡迎，歡迎。嗯，請稍等片刻。"}, {"type": "subtitle", "time": 77.03, "timestamp": "00:01:17", "text": "我將開始。我們"}, {"type": "subtitle", "time": 80.07, "timestamp": "00:01:20", "text": "現在要開始唱讚美詩了。稍等片刻，"}, {"type": "subtitle", "time": 91.03, "timestamp": "00:01:31", "text": "哦，"}, {"type": "subtitle", "time": 92.71000000000001, "timestamp": "00:01:32", "text": "你好。"}, {"type": "subtitle", "time": 100.63, "timestamp": "00:01:40", "text": "早點和你一起練習的，但我"}, {"type": "subtitle", "time": 101.19, "timestamp": "00:01:41", "text": "又打斷你了。"}, {"type": "subtitle", "time": 104.63, "timestamp": "00:01:44", "text": "是的，我記得"}, {"type": "subtitle", "time": 108.22999999999999, "timestamp": "00:01:48", "text": "你昨天說過，4點左右是可以的"}, {"type": "subtitle", "time": 110.38900000000001, "timestamp": "00:01:50", "text": "。然後我就想，「好。」然後"}, {"type": "subtitle", "time": 112.63, "timestamp": "00:01:52", "text": "我就把聊天記錄寄給你。然後我就想"}, {"type": "subtitle", "time": 116.31, "timestamp": "00:01:56", "text": "，「我覺得他又睡著了。」"}, {"type": "subtitle", "time": 118.149, "timestamp": "00:01:58", "text": "是的。"}, {"type": "subtitle", "time": 119.59, "timestamp": "00:01:59", "text": "你開始直播了嗎？"}]
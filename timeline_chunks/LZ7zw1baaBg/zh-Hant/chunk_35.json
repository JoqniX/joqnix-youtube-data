[{"type": "subtitle", "time": 2105.91, "timestamp": "00:35:05", "text": "。呃，星星"}, {"type": "subtitle", "time": 2109.75, "timestamp": "00:35:09", "text": "圈改變了你的改變，你的嗯，那個叫什麼來著，你的牆壁"}, {"type": "subtitle", "time": 2113.589, "timestamp": "00:35:13", "text": "形狀變成了呃，"}, {"type": "subtitle", "time": 2118.23, "timestamp": "00:35:18", "text": "星星之類的東西。哦，你等著瞧。我覺得這很適合我。  是的。  嗯。  是的。嗯，如果"}, {"type": "subtitle", "time": 2151.51, "timestamp": "00:35:51", "text": "你覺得有合適的，也可以看看其他的。希望這能行得通。呃，我又要叫他德魯伊，然後是星辰之環。呃，如果"}]
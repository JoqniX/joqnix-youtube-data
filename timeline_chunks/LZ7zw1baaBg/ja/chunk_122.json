[{"type": "subtitle", "time": 7322.31, "timestamp": "02:02:02", "text": "あなたはどちらを学びたいですか？"}, {"type": "subtitle", "time": 7324.31, "timestamp": "02:02:04", "text": "えっと、実際に開ける必要があります"}, {"type": "subtitle", "time": 7328.629, "timestamp": "02:02:08", "text": "別のタブで開いてください。まあ、そうですね。"}, {"type": "subtitle", "time": 7343.83, "timestamp": "02:02:23", "text": "だから、ダメージを与える攻撃を2つ手に入れたんだ"}, {"type": "subtitle", "time": 7348.39, "timestamp": "02:02:28", "text": "それと、3つのユーティリティだと思う。"}, {"type": "subtitle", "time": 7357.03, "timestamp": "02:02:37", "text": "そうねぇ。えっと"}, {"type": "subtitle", "time": 7358.47, "timestamp": "02:02:38", "text": "ええ、つまり技術的には生産する"}, {"type": "subtitle", "time": 7360.55, "timestamp": "02:02:40", "text": "フラグメントホイップは同じ量の"}, {"type": "subtitle", "time": 7362.149, "timestamp": "02:02:42", "text": "ダメージ。それらは同じくらいダメージを受けています"}, {"type": "subtitle", "time": 7365.03, "timestamp": "02:02:45", "text": "火花を発生させる原因に対処する有用価値"}, {"type": "subtitle", "time": 7366.55, "timestamp": "02:02:46", "text": "技術的には、それはより多くのものを放棄しているということだ"}, {"type": "subtitle", "time": 7368.629, "timestamp": "02:02:48", "text": "ライト。"}]
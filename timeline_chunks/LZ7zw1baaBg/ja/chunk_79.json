[{"type": "subtitle", "time": 4740.47, "timestamp": "01:19:00", "text": "ミュージカルから始めたいと思います"}, {"type": "subtitle", "time": 4741.75, "timestamp": "01:19:01", "text": "楽器。何かありますか？"}, {"type": "subtitle", "time": 4743.669, "timestamp": "01:19:03", "text": "心？これらはすべて機能的に"}, {"type": "subtitle", "time": 4745.189, "timestamp": "01:19:05", "text": "ちなみに、非常によく似ています。あまりそう思わない"}, {"type": "subtitle", "time": 4747.83, "timestamp": "01:19:07", "text": "あまり心配しないでください。"}, {"type": "subtitle", "time": 4750.87, "timestamp": "01:19:10", "text": "ああ、神様。えっと、"}, {"type": "subtitle", "time": 4753.669, "timestamp": "01:19:13", "text": "嘘つきの場合はどうでしょうか？"}, {"type": "subtitle", "time": 4756.149, "timestamp": "01:19:16", "text": "わかった。クリックできますか？"}, {"type": "subtitle", "time": 4756.47, "timestamp": "01:19:16", "text": "わかった。"}, {"type": "subtitle", "time": 4758.709, "timestamp": "01:19:18", "text": "ん。うん。それでよろしいですか？"}, {"type": "subtitle", "time": 4761.35, "timestamp": "01:19:21", "text": "それは一体何をするものだったっけ？えっと、"}, {"type": "subtitle", "time": 4763.669, "timestamp": "01:19:23", "text": "ええと、プレイできますよ。"}, {"type": "subtitle", "time": 4764.709, "timestamp": "01:19:24", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 4767.27, "timestamp": "01:19:27", "text": "うん。うん。"}, {"type": "subtitle", "time": 4769.83, "timestamp": "01:19:29", "text": "えっと、D&D のやつみたいな"}, {"type": "subtitle", "time": 4773.91, "timestamp": "01:19:33", "text": "それは、あなたがただできることですか"}, {"type": "subtitle", "time": 4776.31, "timestamp": "01:19:36", "text": "あなたが理にかなっていると思うものなら何でも"}, {"type": "subtitle", "time": 4777.669, "timestamp": "01:19:37", "text": "これ。ロールプレイングゲームだから"}, {"type": "subtitle", "time": 4779.669, "timestamp": "01:19:39", "text": "ゲーム。ルールは"}, {"type": "subtitle", "time": 4783.27, "timestamp": "01:19:43", "text": "すごく難しい、つまり、そうじゃないってこと"}, {"type": "subtitle", "time": 4785.91, "timestamp": "01:19:45", "text": "まるで石に刻まれたかのようだ。本当にできる"}, {"type": "subtitle", "time": 4788.47, "timestamp": "01:19:48", "text": "嘘つきと知り合って、あなたが望むことは何でも"}, {"type": "subtitle", "time": 4791.11, "timestamp": "01:19:51", "text": "君のように、君のように、君のように、上げることができる"}, {"type": "subtitle", "time": 4794.63, "timestamp": "01:19:54", "text": "誰か起きて。わからない"}, {"type": "subtitle", "time": 4797.91, "timestamp": "01:19:57", "text": "あなた。わかった。まあ、そうですね。わかった。だから、私たちは"}, {"type": "subtitle", "time": 4799.27, "timestamp": "01:19:59", "text": "それを選びます。もしそうなら、私は"}]
[{"type": "subtitle", "time": 12603.03, "timestamp": "03:30:03", "text": "ハングアウトストリームでゲームをプレイしたり、"}, {"type": "subtitle", "time": 12606.229, "timestamp": "03:30:06", "text": "それらをグループ分けして実験し、"}, {"type": "subtitle", "time": 12609.91, "timestamp": "03:30:09", "text": "これに関しては、"}, {"type": "subtitle", "time": 12618.55, "timestamp": "03:30:18", "text": "えーと、INVTコミュニティのことは、私が持っているものです"}, {"type": "subtitle", "time": 12621.75, "timestamp": "03:30:21", "text": "より中立的な立場をとるために。誰だかわからない"}, {"type": "subtitle", "time": 12625.83, "timestamp": "03:30:25", "text": "えっと、オカで大丈夫な人は誰ですか、オカ全員"}, {"type": "subtitle", "time": 12628.07, "timestamp": "03:30:28", "text": "お互いに、そして全員がそうではない"}, {"type": "subtitle", "time": 12631.19, "timestamp": "03:30:31", "text": "お互いに大丈夫だと分かっていても"}, {"type": "subtitle", "time": 12633.59, "timestamp": "03:30:33", "text": "もっと注意して"}, {"type": "subtitle", "time": 12635.91, "timestamp": "03:30:35", "text": "中立的な立場、それが唯一の"}, {"type": "subtitle", "time": 12638.389, "timestamp": "03:30:38", "text": "私は嫌いです"}, {"type": "subtitle", "time": 12641.349, "timestamp": "03:30:41", "text": "私はみんなとグループゲームをするのが好きだ"}, {"type": "subtitle", "time": 12645.349, "timestamp": "03:30:45", "text": "好きな人なら誰でもいいけど、まあそんな感じ"}]
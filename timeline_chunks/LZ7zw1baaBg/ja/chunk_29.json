[{"type": "subtitle", "time": 1741.43, "timestamp": "00:29:01", "text": "おお。"}, {"type": "subtitle", "time": 1743.669, "timestamp": "00:29:03", "text": "ああ、それはまるで違う2つみたいだ"}, {"type": "subtitle", "time": 1745.51, "timestamp": "00:29:05", "text": "チーム。わかった。だから、"}, {"type": "subtitle", "time": 1746.31, "timestamp": "00:29:06", "text": "うん。うん。"}, {"type": "subtitle", "time": 1747.669, "timestamp": "00:29:07", "text": "わかった。わかった。"}, {"type": "subtitle", "time": 1748.789, "timestamp": "00:29:08", "text": "現在2つのチームが存在するのは"}, {"type": "subtitle", "time": 1751.75, "timestamp": "00:29:11", "text": "プレイヤーはかなり多い。それで、えっと"}, {"type": "subtitle", "time": 1756.56, "timestamp": "00:29:16", "text": "私はそれを2つのグループに分けました。私"}, {"type": "subtitle", "time": 1760.23, "timestamp": "00:29:20", "text": "[音楽]"}, {"type": "subtitle", "time": 1763.669, "timestamp": "00:29:23", "text": "ブレ・ディエ。ああ、魔法使いよ。息をしているうちに死ぬ"}, {"type": "subtitle", "time": 1765.909, "timestamp": "00:29:25", "text": "誰かが自分で呼吸しているとき、"}, {"type": "subtitle", "time": 1768.149, "timestamp": "00:29:28", "text": "右？うん。うん。うん。なぜなら、あなたは"}, {"type": "subtitle", "time": 1771.269, "timestamp": "00:29:31", "text": "HPがかなり低い。"}, {"type": "subtitle", "time": 1772.149, "timestamp": "00:29:32", "text": "えっと"}, {"type": "subtitle", "time": 1776.149, "timestamp": "00:29:36", "text": "あなたのHPは非常に低いです。"}, {"type": "subtitle", "time": 1779.909, "timestamp": "00:29:39", "text": "わかった。閉じ込められた。わかった。ローグは罠猟師だ。"}, {"type": "subtitle", "time": 1783.269, "timestamp": "00:29:43", "text": "わかった。そいつは罠を仕掛ける男だ。わかった。範囲は"}, {"type": "subtitle", "time": 1785.75, "timestamp": "00:29:45", "text": "弓矢のような射程距離ではないか"}, {"type": "subtitle", "time": 1788.789, "timestamp": "00:29:48", "text": "もの。ああ、レンジャーはむしろ"}, {"type": "subtitle", "time": 1790.389, "timestamp": "00:29:50", "text": "弓矢のもう少し"}, {"type": "subtitle", "time": 1792.23, "timestamp": "00:29:52", "text": "ファイター。レンジャーは公園の"}, {"type": "subtitle", "time": 1795.83, "timestamp": "00:29:55", "text": "レンジャー、つまりサバイバル専門家みたいな人たち"}]
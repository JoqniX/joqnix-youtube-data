[{"type": "subtitle", "time": 5163.11, "timestamp": "01:26:03", "text": "うん。つまり、つまり、もしあなたが"}, {"type": "subtitle", "time": 5164.87, "timestamp": "01:26:04", "text": "あなたが本当に自分が"}, {"type": "subtitle", "time": 5167.59, "timestamp": "01:26:07", "text": "一般的に知らない場合"}, {"type": "subtitle", "time": 5169.83, "timestamp": "01:26:09", "text": "医療と生存は、"}, {"type": "subtitle", "time": 5172.79, "timestamp": "01:26:12", "text": "あなたにとってはかなり良いですね。"}, {"type": "subtitle", "time": 5179.35, "timestamp": "01:26:19", "text": "そしてそれはまるで、まるで"}, {"type": "subtitle", "time": 5182.229, "timestamp": "01:26:22", "text": "それはあなたの知力ステータスも利用します。"}, {"type": "subtitle", "time": 5183.75, "timestamp": "01:26:23", "text": "そうですね、その2人は概してかなり"}, {"type": "subtitle", "time": 5185.91, "timestamp": "01:26:25", "text": "何を選べばいいかわからない場合に役立ちます。"}, {"type": "subtitle", "time": 5188.87, "timestamp": "01:26:28", "text": "でも、私の知恵を使うことって、すべてに当てはまるんじゃないの？"}, {"type": "subtitle", "time": 5189.75, "timestamp": "01:26:29", "text": "状態？"}, {"type": "subtitle", "time": 5192.229, "timestamp": "01:26:32", "text": "ああ、いや、いや。動物の扱い方など"}, {"type": "subtitle", "time": 5193.99, "timestamp": "01:26:33", "text": "例：知恵、秘術"}, {"type": "subtitle", "time": 5195.83, "timestamp": "01:26:35", "text": "知性、洞察力は知恵である。"}, {"type": "subtitle", "time": 5197.35, "timestamp": "01:26:37", "text": "医学は知恵であり、自然は"}, {"type": "subtitle", "time": 5199.35, "timestamp": "01:26:39", "text": "知性、知覚は知恵である。"}, {"type": "subtitle", "time": 5201.03, "timestamp": "01:26:41", "text": "宗教は知性と生存は"}, {"type": "subtitle", "time": 5204.229, "timestamp": "01:26:44", "text": "知恵。それは、どのようなスキルかによります。"}, {"type": "subtitle", "time": 5207.189, "timestamp": "01:26:47", "text": "よし。だから、もし私が知覚から"}, {"type": "subtitle", "time": 5209.59, "timestamp": "01:26:49", "text": "内側ではすでに知恵が取り入れられている、もし私が"}, {"type": "subtitle", "time": 5211.83, "timestamp": "01:26:51", "text": "別の知恵を選ぶだろうか"}, {"type": "subtitle", "time": 5214.229, "timestamp": "01:26:54", "text": "知恵のステータスポイントに影響しますか？"}, {"type": "subtitle", "time": 5215.75, "timestamp": "01:26:55", "text": "いいえ、そうではありません。それは自分の"}]
[{"type": "subtitle", "time": 11820.309, "timestamp": "03:17:00", "text": "ええ、でも見てみたいですね。私はただ"}, {"type": "subtitle", "time": 11823.83, "timestamp": "03:17:03", "text": "未処理の作業をすべて終わらせる"}, {"type": "subtitle", "time": 11826.55, "timestamp": "03:17:06", "text": "左。"}, {"type": "subtitle", "time": 11830.15, "timestamp": "03:17:10", "text": "だから、そこには未処理の案件が山ほどあるんです。"}, {"type": "subtitle", "time": 11831.99, "timestamp": "03:17:11", "text": "しかし"}, {"type": "subtitle", "time": 11834.309, "timestamp": "03:17:14", "text": "いいえ、したくありません。聞いた話では"}, {"type": "subtitle", "time": 11838.71, "timestamp": "03:17:18", "text": "umの新しいアップデート"}, {"type": "subtitle", "time": 11841.59, "timestamp": "03:17:21", "text": "スケジュール1ですが、彼らは追加しました"}, {"type": "subtitle", "time": 11845.75, "timestamp": "03:17:25", "text": "自動化アップデートの一部とピーク時の"}, {"type": "subtitle", "time": 11850.469, "timestamp": "03:17:30", "text": "彼らは新しいBを追加しました。"}, {"type": "subtitle", "time": 11853.75, "timestamp": "03:17:33", "text": "私はベータ版へのアクセス権を追加しました"}, {"type": "subtitle", "time": 11855.91, "timestamp": "03:17:35", "text": "バージョン。新しいアイテムがあって"}, {"type": "subtitle", "time": 11859.349, "timestamp": "03:17:39", "text": "もの。ベータ版をプレイしたかったのですが、"}, {"type": "subtitle", "time": 11861.99, "timestamp": "03:17:41", "text": "しかし、実績が"}, {"type": "subtitle", "time": 11866.07, "timestamp": "03:17:46", "text": "進展が見られるだろう。"}, {"type": "subtitle", "time": 11868.389, "timestamp": "03:17:48", "text": "私はまだ成果を見るだろう"}, {"type": "subtitle", "time": 11871.51, "timestamp": "03:17:51", "text": "まだベータ版です。わからない。でも私は"}, {"type": "subtitle", "time": 11874.63, "timestamp": "03:17:54", "text": "実績解除のための作業もやりたい。"}, {"type": "subtitle", "time": 11879.03, "timestamp": "03:17:59", "text": "スピードランも試してみてもいいかもしれません。しかし"}]
[{"type": "subtitle", "time": 1681.11, "timestamp": "00:28:01", "text": "ああ、わかりました。ええ、そうですね。つまり、もしあなたが"}, {"type": "subtitle", "time": 1682.47, "timestamp": "00:28:02", "text": "あまり詳しくはないが、お勧めする"}, {"type": "subtitle", "time": 1683.99, "timestamp": "00:28:03", "text": "家から離れて過ごす"}, {"type": "subtitle", "time": 1685.75, "timestamp": "00:28:05", "text": "ブラッドハンターなどのホームブリュークラスと"}, {"type": "subtitle", "time": 1688.789, "timestamp": "00:28:08", "text": "その下。もし"}, {"type": "subtitle", "time": 1692.32, "timestamp": "00:28:12", "text": "あなたは自分が何をしているのか、本当に分かっていない。"}, {"type": "subtitle", "time": 1695.269, "timestamp": "00:28:15", "text": "[音楽]"}, {"type": "subtitle", "time": 1700.23, "timestamp": "00:28:20", "text": "わあ、授業がいっぱいだ。これはナイフです。"}, {"type": "subtitle", "time": 1702.63, "timestamp": "00:28:22", "text": "えっと、同じ選手はいますか？"}, {"type": "subtitle", "time": 1705.19, "timestamp": "00:28:25", "text": "クラス？例えば、"}, {"type": "subtitle", "time": 1707.029, "timestamp": "00:28:27", "text": "そうそう。えっと、それは何によるかによります"}, {"type": "chat", "time": 1707.528, "timestamp": "00:28:27", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "hi thorn-san 👋 hope your health is doing well 👍"}, {"type": "subtitle", "time": 1709.11, "timestamp": "00:28:29", "text": "あなたが参加するグループですが、あまり心配しないでください"}, {"type": "subtitle", "time": 1710.63, "timestamp": "00:28:30", "text": "チーム構成について多くを語る。そうではない"}, {"type": "subtitle", "time": 1712.63, "timestamp": "00:28:32", "text": "本当に好きです、私はそうは思わない"}, {"type": "subtitle", "time": 1715.43, "timestamp": "00:28:35", "text": "あまりにも大きな問題になる。でももしあなたが"}, {"type": "subtitle", "time": 1718.389, "timestamp": "00:28:38", "text": "えっと、これについて疑問に思っているの、ああ、"}, {"type": "subtitle", "time": 1720.549, "timestamp": "00:28:40", "text": "うん。後でまたお知らせします"}, {"type": "subtitle", "time": 1722.549, "timestamp": "00:28:42", "text": "どちらの政党を選ぶか教えてください"}, {"type": "subtitle", "time": 1727.269, "timestamp": "00:28:47", "text": "土曜日のチームだから、"}, {"type": "subtitle", "time": 1729.909, "timestamp": "00:28:49", "text": "パラディン、クレリック、ローグを手に入れた。"}, {"type": "subtitle", "time": 1731.909, "timestamp": "00:28:51", "text": "そして日曜日のチームでは、"}, {"type": "subtitle", "time": 1736.549, "timestamp": "00:28:56", "text": "聖職者、魔法使い、戦士、魔術師、"}, {"type": "subtitle", "time": 1738.789, "timestamp": "00:28:58", "text": "そして野蛮人。"}]
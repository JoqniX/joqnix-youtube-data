[{"type": "subtitle", "time": 1381.51, "timestamp": "00:23:01", "text": "そういう音楽があるかもしれない"}, {"type": "subtitle", "time": 1383.029, "timestamp": "00:23:03", "text": "少しうるさい。音量を下げることができます"}, {"type": "subtitle", "time": 1385.59, "timestamp": "00:23:05", "text": "右上隅。ボタンがあります"}, {"type": "subtitle", "time": 1387.75, "timestamp": "00:23:07", "text": "プレイリストはこう言っています。"}, {"type": "subtitle", "time": 1388.789, "timestamp": "00:23:08", "text": "ああ、音楽。"}, {"type": "subtitle", "time": 1392.31, "timestamp": "00:23:12", "text": "お好みであれば、音楽もどうぞ。おお、"}, {"type": "subtitle", "time": 1405.27, "timestamp": "00:23:25", "text": "ああ、これはいいですね。うん。"}, {"type": "subtitle", "time": 1410.07, "timestamp": "00:23:30", "text": "わかった。えっと、わかりました。参加できます。えっと、"}, {"type": "subtitle", "time": 1413.27, "timestamp": "00:23:33", "text": "見る。えっと、ちょっと確認させてください"}, {"type": "subtitle", "time": 1415.669, "timestamp": "00:23:35", "text": "すべて正常に動作しています。わかった。"}, {"type": "subtitle", "time": 1419.029, "timestamp": "00:23:39", "text": "よし。ええと、わかりました。だから、もしあなたが"}, {"type": "subtitle", "time": 1420.87, "timestamp": "00:23:40", "text": "上部にある「俳優」タブ"}, {"type": "subtitle", "time": 1423.75, "timestamp": "00:23:43", "text": "右隅には、"}, {"type": "subtitle", "time": 1426.63, "timestamp": "00:23:46", "text": "人物アイコン。すでに持っているはずです"}, {"type": "subtitle", "time": 1428.47, "timestamp": "00:23:48", "text": "キャラクターシート。私はすでにそれを渡しました"}, {"type": "subtitle", "time": 1430.07, "timestamp": "00:23:50", "text": "あなた。ジョイのキャラクターと書くべき"}, {"type": "subtitle", "time": 1431.669, "timestamp": "00:23:51", "text": "シート。それは見えますか？"}, {"type": "subtitle", "time": 1433.669, "timestamp": "00:23:53", "text": "それはすでにプレイヤーと言っています"}, {"type": "subtitle", "time": 1436.39, "timestamp": "00:23:56", "text": "登場人物：土曜日のパーティー、チーム内の対立。"}, {"type": "subtitle", "time": 1438.39, "timestamp": "00:23:58", "text": "はい、そうです。ああ、そうですね。分類へ移動"}]
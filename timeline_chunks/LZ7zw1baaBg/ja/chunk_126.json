[{"type": "subtitle", "time": 7567.75, "timestamp": "02:06:07", "text": "えっと、待って。私は2つ持っています"}, {"type": "subtitle", "time": 7571.27, "timestamp": "02:06:11", "text": "コインは左に残っていますよね？"}, {"type": "subtitle", "time": 7581.43, "timestamp": "02:06:21", "text": "では、えーと、"}, {"type": "subtitle", "time": 7585.75, "timestamp": "02:06:25", "text": "うん、知恵について一つやろう"}, {"type": "subtitle", "time": 7589.669, "timestamp": "02:06:29", "text": "そして憲法に関するもの。"}, {"type": "subtitle", "time": 7591.35, "timestamp": "02:06:31", "text": "よし"}, {"type": "subtitle", "time": 7593.51, "timestamp": "02:06:33", "text": "はい、こんな感じです。"}, {"type": "subtitle", "time": 7597.109, "timestamp": "02:06:37", "text": "えっと、ちょっと待ってください。うん、1つ、うん、"}, {"type": "subtitle", "time": 7597.99, "timestamp": "02:06:37", "text": "それ。うん。"}, {"type": "subtitle", "time": 7598.95, "timestamp": "02:06:38", "text": "わかった。それで"}, {"type": "subtitle", "time": 7601.189, "timestamp": "02:06:41", "text": "18歳ですよね？ 18歳ですよね？"}, {"type": "subtitle", "time": 7602.149, "timestamp": "02:06:42", "text": "はい。"}, {"type": "subtitle", "time": 7608.39, "timestamp": "02:06:48", "text": "わかった。よし。それはレベル4です。えっと、私は"}, {"type": "subtitle", "time": 7610.31, "timestamp": "02:06:50", "text": "私もそう思います"}, {"type": "subtitle", "time": 7611.669, "timestamp": "02:06:51", "text": "特技も選んでください。"}, {"type": "subtitle", "time": 7614.31, "timestamp": "02:06:54", "text": "後でね、だって、私は"}, {"type": "subtitle", "time": 7616.95, "timestamp": "02:06:56", "text": "他のものと一緒に選ばせてあげます。そして"}]
[{"type": "subtitle", "time": 6661.27, "timestamp": "01:51:01", "text": "すぐにあなたの"}, {"type": "subtitle", "time": 6664.39, "timestamp": "01:51:04", "text": "呪文書。ちょっと待ってください。えっと、それは"}, {"type": "subtitle", "time": 6667.43, "timestamp": "01:51:07", "text": "今のところ、そこには誰も住んでいません。えっと、"}, {"type": "subtitle", "time": 6670.47, "timestamp": "01:51:10", "text": "これをもう一度確認してください。えっと、"}, {"type": "subtitle", "time": 6676.709, "timestamp": "01:51:16", "text": "どこですか？入力するだけです。"}, {"type": "subtitle", "time": 6680.39, "timestamp": "01:51:20", "text": "はい、保存します。そして私はこうするだけです"}, {"type": "subtitle", "time": 6686.629, "timestamp": "01:51:26", "text": "それらはすべて私の得意分野です。"}, {"type": "subtitle", "time": 6689.189, "timestamp": "01:51:29", "text": "ええ、でも、準備できるのは"}, {"type": "subtitle", "time": 6690.55, "timestamp": "01:51:30", "text": "毎回数量限定です。させて"}, {"type": "subtitle", "time": 6692.87, "timestamp": "01:51:32", "text": "使い方をご説明しましょう。それでは、"}, {"type": "subtitle", "time": 6696.39, "timestamp": "01:51:36", "text": "とりあえず、すぐにオフに切り替えてください。"}, {"type": "subtitle", "time": 6699.669, "timestamp": "01:51:39", "text": "わかった。えっと、シートを見てみると"}, {"type": "subtitle", "time": 6702.709, "timestamp": "01:51:42", "text": "あなたのところで、えっと、これは、ああ、ちょっと待って、"}, {"type": "subtitle", "time": 6705.75, "timestamp": "01:51:45", "text": "重複を削除させてください。えっと、"}, {"type": "subtitle", "time": 6707.27, "timestamp": "01:51:47", "text": "わかった。たくさん見るべき"}, {"type": "subtitle", "time": 6709.189, "timestamp": "01:51:49", "text": "ここに呪文があります。最大4つまで準備できます。"}, {"type": "subtitle", "time": 6710.709, "timestamp": "01:51:50", "text": "上を見れば、"}, {"type": "subtitle", "time": 6712.149, "timestamp": "01:51:52", "text": "準備された数。 4つのうち0つ、"}, {"type": "subtitle", "time": 6713.91, "timestamp": "01:51:53", "text": "右？つまり、4つ準備できるということです"}, {"type": "subtitle", "time": 6717.35, "timestamp": "01:51:57", "text": "呪文。ええと、呪文を唱えるには、"}]
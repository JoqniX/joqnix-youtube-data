[{"type": "subtitle", "time": 2882.39, "timestamp": "00:48:02", "text": "オールラウンドなプレー。それはまるで"}, {"type": "subtitle", "time": 2883.75, "timestamp": "00:48:03", "text": "そうそう。あなたはすべてできます"}, {"type": "subtitle", "time": 2885.43, "timestamp": "00:48:05", "text": "より丸みを帯びた。うん。あなたは、あなたは、持っていることができます"}, {"type": "subtitle", "time": 2888.79, "timestamp": "00:48:08", "text": "建物全体にもう少し余裕を持たせる。"}, {"type": "subtitle", "time": 2890.55, "timestamp": "00:48:10", "text": "えっと、ほら、私は"}, {"type": "subtitle", "time": 2893.349, "timestamp": "00:48:13", "text": "通常、人々はあなたを好きになりたいと思っています"}, {"type": "subtitle", "time": 2895.99, "timestamp": "00:48:15", "text": "彼らのステータスの1つをスパイクして、"}, {"type": "subtitle", "time": 2898.15, "timestamp": "00:48:18", "text": "本当に強力にしてください。でも実際は"}, {"type": "subtitle", "time": 2899.43, "timestamp": "00:48:19", "text": "どのように建てるかはあなた次第です"}, {"type": "subtitle", "time": 2901.19, "timestamp": "00:48:21", "text": "あなたの性格。それは、えっと、"}, {"type": "subtitle", "time": 2904.79, "timestamp": "00:48:24", "text": "繰り返しになりますが、このゲームは非常にカジュアルです。えっと"}, {"type": "subtitle", "time": 2906.87, "timestamp": "00:48:26", "text": "あまり心配しないでください"}, {"type": "subtitle", "time": 2908.87, "timestamp": "00:48:28", "text": "最適化されていない。"}, {"type": "subtitle", "time": 2911.349, "timestamp": "00:48:31", "text": "うん、そうだと思う。"}, {"type": "subtitle", "time": 2913.109, "timestamp": "00:48:33", "text": "よし。わかった。えっと、私は"}, {"type": "subtitle", "time": 2916.15, "timestamp": "00:48:36", "text": "それをすぐにメモしておいてください。はい、"}, {"type": "subtitle", "time": 2918.23, "timestamp": "00:48:38", "text": "さあ、鋳造所に戻ってください。"}, {"type": "subtitle", "time": 2921.109, "timestamp": "00:48:41", "text": "私があなたに教えたウェブサイトにアクセスしてください。"}, {"type": "subtitle", "time": 2922.71, "timestamp": "00:48:42", "text": "H"}, {"type": "subtitle", "time": 2925.51, "timestamp": "00:48:45", "text": "えっと、ゲーム関連のやつですね。"}, {"type": "subtitle", "time": 2929.67, "timestamp": "00:48:49", "text": "ああ、わかりました。えっと、ゲーム関連のことです。わかった。"}, {"type": "subtitle", "time": 2932.069, "timestamp": "00:48:52", "text": "よし。それでは、"}, {"type": "subtitle", "time": 2936.069, "timestamp": "00:48:56", "text": "ああ、神様。やったー。申し訳ありませんでした。"}, {"type": "subtitle", "time": 2938.069, "timestamp": "00:48:58", "text": "えっと、レンチのアイコンをクリックしてください"}]
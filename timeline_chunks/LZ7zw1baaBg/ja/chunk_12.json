[{"type": "subtitle", "time": 739.269, "timestamp": "00:12:19", "text": "では、そこからもう一度説明しましょう。"}, {"type": "subtitle", "time": 742.389, "timestamp": "00:12:22", "text": "待てよ、もう一度そこから始めよう。"}, {"type": "subtitle", "time": 745.03, "timestamp": "00:12:25", "text": "戻ってください。"}, {"type": "subtitle", "time": 747.03, "timestamp": "00:12:27", "text": "大丈夫、任せて。私は、"}, {"type": "subtitle", "time": 748.87, "timestamp": "00:12:28", "text": "誤ってリスニングモードをオンにしてしまいました。私"}, {"type": "subtitle", "time": 750.55, "timestamp": "00:12:30", "text": "聞いてみたら、"}, {"type": "subtitle", "time": 753.829, "timestamp": "00:12:33", "text": "あ、待って、歌わなきゃいけなかった"}, {"type": "subtitle", "time": 756.55, "timestamp": "00:12:36", "text": "あなたに歌うように、"}, {"type": "subtitle", "time": 757.829, "timestamp": "00:12:37", "text": "アイデア。"}, {"type": "subtitle", "time": 759.829, "timestamp": "00:12:39", "text": "こんにちは。"}, {"type": "subtitle", "time": 761.03, "timestamp": "00:12:41", "text": "申し訳ありませんでした。"}, {"type": "subtitle", "time": 764.47, "timestamp": "00:12:44", "text": "ああ、いやいや、大丈夫です。大丈夫です。"}, {"type": "subtitle", "time": 768.55, "timestamp": "00:12:48", "text": "そして、君は電話を壊したんだ。"}, {"type": "subtitle", "time": 771.03, "timestamp": "00:12:51", "text": "なんてこった、"}, {"type": "subtitle", "time": 772.87, "timestamp": "00:12:52", "text": "そこが君のミスだ。うん、"}, {"type": "subtitle", "time": 776.79, "timestamp": "00:12:56", "text": "念のためお知らせしておきます。"}, {"type": "subtitle", "time": 779.91, "timestamp": "00:12:59", "text": "私は"}]
[{"type": "subtitle", "time": 6600.55, "timestamp": "01:50:00", "text": "うん、君と僕が一緒に遊ぶとき、僕が話すとき"}, {"type": "subtitle", "time": 6601.99, "timestamp": "01:50:01", "text": "私たちは遊ぶ。いや、ちょっと待ってください。あなたは"}, {"type": "subtitle", "time": 6604.629, "timestamp": "01:50:04", "text": "以前のゲームのように見られましたか？もし"}, {"type": "subtitle", "time": 6606.47, "timestamp": "01:50:06", "text": "あなたが望むなら、それを見ることもできます"}, {"type": "subtitle", "time": 6607.99, "timestamp": "01:50:07", "text": "ゲームの通常のプレイ方法。"}, {"type": "subtitle", "time": 6610.87, "timestamp": "01:50:10", "text": "はい、Yes を見なければなりません。"}, {"type": "subtitle", "time": 6613.75, "timestamp": "01:50:13", "text": "わかった。えっと、私にただ"}, {"type": "subtitle", "time": 6615.43, "timestamp": "01:50:15", "text": "送りたいですか、それとも好きですか"}, {"type": "subtitle", "time": 6617.91, "timestamp": "01:50:17", "text": "ゲームのプレイ方法を確認するか、"}, {"type": "subtitle", "time": 6619.99, "timestamp": "01:50:19", "text": "後でやりたいの？なぜなら"}, {"type": "subtitle", "time": 6621.99, "timestamp": "01:50:21", "text": "保管庫は私のチャンネルにあります。"}, {"type": "subtitle", "time": 6622.629, "timestamp": "01:50:22", "text": "わかった。はい。"}, {"type": "subtitle", "time": 6626.07, "timestamp": "01:50:26", "text": "後でやります。"}, {"type": "subtitle", "time": 6629.669, "timestamp": "01:50:29", "text": "ええと、わかりました。えっと、"}, {"type": "subtitle", "time": 6631.74, "timestamp": "01:50:31", "text": "わかった。えっと、"}, {"type": "subtitle", "time": 6635.51, "timestamp": "01:50:35", "text": "[音楽]"}, {"type": "subtitle", "time": 6638.39, "timestamp": "01:50:38", "text": "わかった。鞭は1本でいいかな。そして"}, {"type": "subtitle", "time": 6641.109, "timestamp": "01:50:41", "text": "それは私に戦場の支配権を与えてくれると書いてある。"}, {"type": "subtitle", "time": 6642.31, "timestamp": "01:50:42", "text": "わかった。"}, {"type": "subtitle", "time": 6645.51, "timestamp": "01:50:45", "text": "よし。わかった。それを選びます。そこには"}, {"type": "subtitle", "time": 6649.189, "timestamp": "01:50:49", "text": "あなたが行く。わかった。"}, {"type": "subtitle", "time": 6651.43, "timestamp": "01:50:51", "text": "よし。えっと、見てみましょう。よし。"}, {"type": "subtitle", "time": 6653.35, "timestamp": "01:50:53", "text": "レベルクリア。念のためもう一度確認させてください。"}, {"type": "subtitle", "time": 6656.07, "timestamp": "01:50:56", "text": "これ。ちゃんとそれを手に入れたか確認してください"}, {"type": "subtitle", "time": 6659.51, "timestamp": "01:50:59", "text": "正しい。わかった。はい、その通りです。そして"}]
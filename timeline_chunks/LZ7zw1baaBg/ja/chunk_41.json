[{"type": "subtitle", "time": 2460.95, "timestamp": "00:41:00", "text": "ええ、そうです。"}, {"type": "subtitle", "time": 2463.589, "timestamp": "00:41:03", "text": "わかった。憲法は魔法のようなものですか？"}, {"type": "subtitle", "time": 2465.67, "timestamp": "00:41:05", "text": "わかった。ええと、そうですね。たぶん"}, {"type": "subtitle", "time": 2468.79, "timestamp": "00:41:08", "text": "それぞれのスコアについて説明します"}, {"type": "subtitle", "time": 2471.67, "timestamp": "00:41:11", "text": "1つ。強さは、ええと、強さです"}, {"type": "subtitle", "time": 2472.87, "timestamp": "00:41:12", "text": "まあ、ある意味当然のことかもしれないね。まるで"}, {"type": "subtitle", "time": 2475.43, "timestamp": "00:41:15", "text": "どれだけ強くパンチできるか。器用さとは"}, {"type": "subtitle", "time": 2477.67, "timestamp": "00:41:17", "text": "反射神経のように、"}, {"type": "subtitle", "time": 2480.71, "timestamp": "00:41:20", "text": "君が動いたりするとか。えっと、"}, {"type": "subtitle", "time": 2484.71, "timestamp": "00:41:24", "text": "体質は、あなたの体の状態です"}, {"type": "subtitle", "time": 2488.55, "timestamp": "00:41:28", "text": "えっと、どれくらい耐久性があるか、みたいな。"}, {"type": "subtitle", "time": 2491.99, "timestamp": "00:41:31", "text": "知性とは賢さのことだ。知恵とは、ええと"}, {"type": "subtitle", "time": 2495.03, "timestamp": "00:41:35", "text": "知恵とカリスマ性とは、あなたがどれだけ優れているかということです"}, {"type": "subtitle", "time": 2496.309, "timestamp": "00:41:36", "text": "説得するようなことをする"}, {"type": "subtitle", "time": 2498.63, "timestamp": "00:41:38", "text": "人々、そういう類のこと。"}, {"type": "subtitle", "time": 2504.069, "timestamp": "00:41:44", "text": "わかった。わかった。"}, {"type": "subtitle", "time": 2505.589, "timestamp": "00:41:45", "text": "えっと"}, {"type": "subtitle", "time": 2508.15, "timestamp": "00:41:48", "text": "どう思いますか？私がどう思うか"}, {"type": "subtitle", "time": 2509.75, "timestamp": "00:41:49", "text": "そうすべきだった？えっと"}, {"type": "subtitle", "time": 2512.069, "timestamp": "00:41:52", "text": "ドルイド。ええ、ドルイドは"}, {"type": "subtitle", "time": 2514.87, "timestamp": "00:41:54", "text": "ドルイドは通常、最大レベルを目指します"}, {"type": "subtitle", "time": 2516.55, "timestamp": "00:41:56", "text": "知恵は"}, {"type": "subtitle", "time": 2518.79, "timestamp": "00:41:58", "text": "彼らの呪文発動修正値。つまり"}]
[{"type": "subtitle", "time": 4981.59, "timestamp": "01:23:01", "text": "あなたは物事に気づくのがどれだけ上手か。しかし"}, {"type": "subtitle", "time": 4983.189, "timestamp": "01:23:03", "text": "あなたは既にそれを持っている。"}, {"type": "subtitle", "time": 4985.43, "timestamp": "01:23:05", "text": "おお。ああ、だからチェックマークが付いているんですね"}, {"type": "subtitle", "time": 4986.229, "timestamp": "01:23:06", "text": "それ。おお"}, {"type": "subtitle", "time": 4987.83, "timestamp": "01:23:07", "text": "うん。チェックマークは、あなたがすでに"}, {"type": "subtitle", "time": 4995.669, "timestamp": "01:23:15", "text": "えっと、宗教は、ああ、神の力みたいなものです"}, {"type": "subtitle", "time": 5006.79, "timestamp": "01:23:26", "text": "えーと"}, {"type": "subtitle", "time": 5010.31, "timestamp": "01:23:30", "text": "私は自分の内面で行くと思います"}, {"type": "subtitle", "time": 5012.709, "timestamp": "01:23:32", "text": "それでは、アルカナを選びます。"}, {"type": "subtitle", "time": 5014.709, "timestamp": "01:23:34", "text": "アルカナ。もう一つもらえます。 1つ入手できます"}, {"type": "subtitle", "time": 5017.189, "timestamp": "01:23:37", "text": "もっと。あと1つ。"}, {"type": "subtitle", "time": 5019.75, "timestamp": "01:23:39", "text": "はい。"}, {"type": "subtitle", "time": 5027.59, "timestamp": "01:23:47", "text": "動物を扱うことは問題ありません。ああ、それはいいですね。"}, {"type": "subtitle", "time": 5030.79, "timestamp": "01:23:50", "text": "わかった。えっと"}, {"type": "subtitle", "time": 5033.11, "timestamp": "01:23:53", "text": "えっと、薬って何をするものだったっけ？"}, {"type": "subtitle", "time": 5036.55, "timestamp": "01:23:56", "text": "ええと、薬では、次のようなことができます。"}, {"type": "subtitle", "time": 5038.87, "timestamp": "01:23:58", "text": "例えば、誰かが大量出血している場合、"}]
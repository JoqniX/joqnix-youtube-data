[{"type": "subtitle", "time": 12361.91, "timestamp": "03:26:01", "text": "すると、たくさんの人が私のツイートにいいねをしてくれた"}, {"type": "subtitle", "time": 12363.99, "timestamp": "03:26:03", "text": "すべきかどうか確信が持てなかったが"}, {"type": "subtitle", "time": 12382.87, "timestamp": "03:26:22", "text": "[音楽]"}, {"type": "subtitle", "time": 12384.87, "timestamp": "03:26:24", "text": "私はしてはいけないことをした"}, {"type": "subtitle", "time": 12387.99, "timestamp": "03:26:27", "text": "今日。もしかしたら"}, {"type": "subtitle", "time": 12392.229, "timestamp": "03:26:32", "text": "戻るかもしれない、もし手に入れられるなら"}, {"type": "subtitle", "time": 12401.11, "timestamp": "03:26:41", "text": "うん。さよなら。"}, {"type": "subtitle", "time": 12406.04, "timestamp": "03:26:46", "text": "[音楽]"}, {"type": "subtitle", "time": 12407.59, "timestamp": "03:26:47", "text": "[笑い]"}, {"type": "subtitle", "time": 12410.469, "timestamp": "03:26:50", "text": "ウィザリングB。私はそのゲームに触ったことがない。"}, {"type": "subtitle", "time": 12413.349, "timestamp": "03:26:53", "text": "それ以来ずっと。おお、"}]
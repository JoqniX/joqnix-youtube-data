[{"type": "subtitle", "time": 4500.07, "timestamp": "01:15:00", "text": "良さそうですね。"}, {"type": "subtitle", "time": 4502.31, "timestamp": "01:15:02", "text": "わかった。えっと"}, {"type": "subtitle", "time": 4505.03, "timestamp": "01:15:05", "text": "一般的な地下と"}, {"type": "subtitle", "time": 4508.229, "timestamp": "01:15:08", "text": "トレイルの秘密？"}, {"type": "subtitle", "time": 4510.66, "timestamp": "01:15:10", "text": "わかった。えっと"}, {"type": "subtitle", "time": 4512.149, "timestamp": "01:15:12", "text": "[音楽]"}, {"type": "subtitle", "time": 4514.55, "timestamp": "01:15:14", "text": "私はドラコニックを選びます。"}, {"type": "subtitle", "time": 4516.55, "timestamp": "01:15:16", "text": "よし。ご自由にどうぞ。"}, {"type": "subtitle", "time": 4520.39, "timestamp": "01:15:20", "text": "古代の魔法。アニメでよく見かける。病気"}, {"type": "subtitle", "time": 4522.709, "timestamp": "01:15:22", "text": "それでいいよ。"}, {"type": "subtitle", "time": 4524.31, "timestamp": "01:15:24", "text": "うん。うん。よし。おお。おお。しないで"}, {"type": "subtitle", "time": 4525.75, "timestamp": "01:15:25", "text": "まだOKをクリックしないでください。まだ"}, {"type": "subtitle", "time": 4527.99, "timestamp": "01:15:27", "text": "一番下のツール熟練度を選択してください。"}, {"type": "subtitle", "time": 4528.95, "timestamp": "01:15:28", "text": "うん。ああ、わかりました。"}, {"type": "subtitle", "time": 4531.03, "timestamp": "01:15:31", "text": "いや、いや、いや、いや、いや。のように"}, {"type": "subtitle", "time": 4531.59, "timestamp": "01:15:31", "text": "はい、結構です。"}, {"type": "subtitle", "time": 4533.11, "timestamp": "01:15:33", "text": "一番下のやつ。ツールがあります"}, {"type": "subtitle", "time": 4535.35, "timestamp": "01:15:35", "text": "熟練度。ゲームを選ぶ"}, {"type": "subtitle", "time": 4537.51, "timestamp": "01:15:37", "text": "セットまたは楽器。どちらでも"}, {"type": "subtitle", "time": 4539.43, "timestamp": "01:15:39", "text": "より役に立つと思うもの"}, {"type": "subtitle", "time": 4541.189, "timestamp": "01:15:41", "text": "あなたにとってより適した、またはあなたの"}, {"type": "subtitle", "time": 4554.229, "timestamp": "01:15:54", "text": "ゲームセット。これは何ですか？えっと、それはまるで"}, {"type": "subtitle", "time": 4556.79, "timestamp": "01:15:56", "text": "ええと、例えば、"}, {"type": "subtitle", "time": 4558.95, "timestamp": "01:15:58", "text": "サイコロ、チェス、"}]
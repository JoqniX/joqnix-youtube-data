[{"type": "subtitle", "time": 9841.269, "timestamp": "02:44:01", "text": "やり方がわかりますか？"}, {"type": "subtitle", "time": 9841.99, "timestamp": "02:44:01", "text": "それ？"}, {"type": "subtitle", "time": 9843.59, "timestamp": "02:44:03", "text": "知恵、知恵、知恵、知恵。"}, {"type": "subtitle", "time": 9845.11, "timestamp": "02:44:05", "text": "それはあなたのセービングスローに影響します。"}, {"type": "subtitle", "time": 9849.269, "timestamp": "02:44:09", "text": "はい、どうぞ。普通。"}, {"type": "subtitle", "time": 9851.349, "timestamp": "02:44:11", "text": "はい、どうぞ。ん。"}, {"type": "subtitle", "time": 9852.95, "timestamp": "02:44:12", "text": "ああ、24歳。"}, {"type": "subtitle", "time": 9856.71, "timestamp": "02:44:16", "text": "わかった。うん。よし。えーと、これで全部です"}, {"type": "subtitle", "time": 9860.309, "timestamp": "02:44:20", "text": "えっと、何ていう名前でしたっけ？私は思う"}, {"type": "subtitle", "time": 9863.11, "timestamp": "02:44:23", "text": "それがセービングスローのやり方です。"}, {"type": "subtitle", "time": 9866.71, "timestamp": "02:44:26", "text": "他に学ぶべきことは何ですか？ H"}, {"type": "subtitle", "time": 9868.63, "timestamp": "02:44:28", "text": "えっと"}, {"type": "subtitle", "time": 9873.19, "timestamp": "02:44:33", "text": "ああ、これで全部だと思うんだけど。"}, {"type": "subtitle", "time": 9876.63, "timestamp": "02:44:36", "text": "あなたが学ぶ必要があること。だから、もしあなたが"}, {"type": "subtitle", "time": 9878.309, "timestamp": "02:44:38", "text": "えっと、ここで終わりにしたいなら、"}, {"type": "subtitle", "time": 9880.07, "timestamp": "02:44:40", "text": "大丈夫。でも、もしあなたが私に走ってほしいなら"}, {"type": "subtitle", "time": 9883.03, "timestamp": "02:44:43", "text": "まるで"}, {"type": "subtitle", "time": 9886.15, "timestamp": "02:44:46", "text": "基本的なこと、例えば、あなたが知っているように、"}, {"type": "subtitle", "time": 9888.15, "timestamp": "02:44:48", "text": "戦闘用のバックエンドは機能します、私はできます"}, {"type": "subtitle", "time": 9890.309, "timestamp": "02:44:50", "text": "それもまた然り。"}, {"type": "subtitle", "time": 9891.03, "timestamp": "02:44:51", "text": "ああ、それは可能です。"}, {"type": "subtitle", "time": 9891.91, "timestamp": "02:44:51", "text": "あなたはそれをしたいですか？"}, {"type": "subtitle", "time": 9892.389, "timestamp": "02:44:52", "text": "うん。うん。"}, {"type": "subtitle", "time": 9894.469, "timestamp": "02:44:54", "text": "わかった。うん。よし。私は"}, {"type": "subtitle", "time": 9897.269, "timestamp": "02:44:57", "text": "スポーンのように素早く。見せてください。私はただ"}, {"type": "subtitle", "time": 9899.51, "timestamp": "02:44:59", "text": "ゴブリンか何かを召喚するつもりだ。"}]
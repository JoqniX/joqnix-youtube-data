[{"type": "subtitle", "time": 4921.189, "timestamp": "01:22:01", "text": "あなた。"}, {"type": "subtitle", "time": 4924.629, "timestamp": "01:22:04", "text": "うん。うん。うん。できます。"}, {"type": "subtitle", "time": 4926.31, "timestamp": "01:22:06", "text": "説明が必要な場合は、はい、とだけ言ってください。教えて"}, {"type": "subtitle", "time": 4927.669, "timestamp": "01:22:07", "text": "私に説明が必要なのはどれですか"}, {"type": "subtitle", "time": 4928.87, "timestamp": "01:22:08", "text": "の上。"}, {"type": "subtitle", "time": 4933.189, "timestamp": "01:22:13", "text": "えっと、アルカナって何をするんですか？アルカナはあなたの"}, {"type": "subtitle", "time": 4935.83, "timestamp": "01:22:15", "text": "魔法に関する知識"}, {"type": "subtitle", "time": 4937.83, "timestamp": "01:22:17", "text": "魔法のようなものが人を惹きつける"}, {"type": "subtitle", "time": 4940.31, "timestamp": "01:22:20", "text": "呪文、魔法のアイテム、そして次のようなもの"}, {"type": "subtitle", "time": 4949.99, "timestamp": "01:22:29", "text": "ええと、薬は治癒のためのものです。"}, {"type": "subtitle", "time": 4953.59, "timestamp": "01:22:33", "text": "いいえ、医学は診断に近いものです"}, {"type": "subtitle", "time": 4955.27, "timestamp": "01:22:35", "text": "病気。癒しは別の"}, {"type": "subtitle", "time": 4958.149, "timestamp": "01:22:38", "text": "それは全く別のことです。"}, {"type": "subtitle", "time": 4960.229, "timestamp": "01:22:40", "text": "しかし、薬は次のようなことを助けてくれます。"}, {"type": "subtitle", "time": 4961.75, "timestamp": "01:22:41", "text": "例えば、誰かが出血している場合"}, {"type": "subtitle", "time": 4963.669, "timestamp": "01:22:43", "text": "たとえ死に至っても、応急処置を施すことはできます。"}, {"type": "subtitle", "time": 4965.51, "timestamp": "01:22:45", "text": "実際には治癒しないが、"}, {"type": "subtitle", "time": 4969.43, "timestamp": "01:22:49", "text": "安定しているので、突然死んでしまうことはない。"}, {"type": "subtitle", "time": 4971.51, "timestamp": "01:22:51", "text": "わかった。"}, {"type": "subtitle", "time": 4973.51, "timestamp": "01:22:53", "text": "えっと"}, {"type": "subtitle", "time": 4975.83, "timestamp": "01:22:55", "text": "知覚は、物を検出するようなものだ"}, {"type": "subtitle", "time": 4976.55, "timestamp": "01:22:56", "text": "右？危険。"}, {"type": "subtitle", "time": 4979.75, "timestamp": "01:22:59", "text": "うん。知覚は、あなたが、えーと"}]
[{"type": "subtitle", "time": 6061.35, "timestamp": "01:41:01", "text": "便利な呪文。"}, {"type": "subtitle", "time": 6062.55, "timestamp": "01:41:02", "text": "さまざまなことができます"}, {"type": "subtitle", "time": 6064.149, "timestamp": "01:41:04", "text": "それと共に。えっと、"}, {"type": "subtitle", "time": 6066.95, "timestamp": "01:41:06", "text": "これらの効果の中から一つを選ばなければならない。"}, {"type": "subtitle", "time": 6069.109, "timestamp": "01:41:09", "text": "ええ、そうですね。毎回キャストするたびに"}, {"type": "subtitle", "time": 6070.87, "timestamp": "01:41:10", "text": "この呪文では、以下のどれか一つを選ぶことができます。"}, {"type": "subtitle", "time": 6073.75, "timestamp": "01:41:13", "text": "どちらでもお好きな方を選んでください。"}, {"type": "subtitle", "time": 6076.39, "timestamp": "01:41:16", "text": "ああ、まるでできないみたいだ"}, {"type": "subtitle", "time": 6078.87, "timestamp": "01:41:18", "text": "ランダムガチャのように"}, {"type": "subtitle", "time": 6080.31, "timestamp": "01:41:20", "text": "なんてこった。それは偶然ではない。あなたが選ぶ"}, {"type": "subtitle", "time": 6082.31, "timestamp": "01:41:22", "text": "どちらでもお好きなものをお選びください"}, {"type": "subtitle", "time": 6085.35, "timestamp": "01:41:25", "text": "私が攻撃するたびに、"}, {"type": "subtitle", "time": 6088.07, "timestamp": "01:41:28", "text": "えっと、これは攻撃ではありません。それは、それはもっと"}, {"type": "subtitle", "time": 6090.229, "timestamp": "01:41:30", "text": "実用性のため。"}, {"type": "subtitle", "time": 6091.91, "timestamp": "01:41:31", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 6098.39, "timestamp": "01:41:38", "text": "例えば、"}, {"type": "subtitle", "time": 6100.149, "timestamp": "01:41:40", "text": "エレメンタリズムを使えば、閉じたり開いたりできます"}, {"type": "subtitle", "time": 6103.59, "timestamp": "01:41:43", "text": "遠くから見えるドア。いいね"}, {"type": "subtitle", "time": 6107.109, "timestamp": "01:41:47", "text": "えっと、何て言うんだっけ、ろうそくに火をつける"}, {"type": "subtitle", "time": 6109.83, "timestamp": "01:41:49", "text": "そして、何もないたいまつ。"}, {"type": "subtitle", "time": 6113.75, "timestamp": "01:41:53", "text": "もう一度何て呼べばいいの？"}]
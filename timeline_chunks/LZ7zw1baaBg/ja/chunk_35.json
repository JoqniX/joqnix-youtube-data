[{"type": "subtitle", "time": 2100.55, "timestamp": "00:35:00", "text": "見てみましょう。他に何が考えられるだろうか"}, {"type": "subtitle", "time": 2103.349, "timestamp": "00:35:03", "text": "仕事。何もないと思います"}, {"type": "subtitle", "time": 2105.91, "timestamp": "00:35:05", "text": "聖職者というのは、そういう感じですね。"}, {"type": "subtitle", "time": 2109.75, "timestamp": "00:35:09", "text": "ウォーロックは、えっと、何ていうか、あれを持ってるんだよね"}, {"type": "subtitle", "time": 2113.589, "timestamp": "00:35:13", "text": "えっと、セレスティアルパトレオンだけど、それはちょっと"}, {"type": "subtitle", "time": 2118.23, "timestamp": "00:35:18", "text": "どちらかというと、神とか天使とかそういう感じ"}, {"type": "subtitle", "time": 2120.069, "timestamp": "00:35:20", "text": "そこじゃないよ、行くよ"}, {"type": "subtitle", "time": 2122.15, "timestamp": "00:35:22", "text": "どれが"}, {"type": "subtitle", "time": 2125.27, "timestamp": "00:35:25", "text": "えーと、ウォーロックとスレイ・スティールのパトロン"}, {"type": "subtitle", "time": 2127.03, "timestamp": "00:35:27", "text": "何が"}, {"type": "subtitle", "time": 2130.39, "timestamp": "00:35:30", "text": "でもそれはもう少し、えーともう少し"}, {"type": "subtitle", "time": 2134.31, "timestamp": "00:35:34", "text": "光とか神とか天国みたいな"}, {"type": "subtitle", "time": 2136.39, "timestamp": "00:35:36", "text": "平和の存在。"}, {"type": "subtitle", "time": 2144.95, "timestamp": "00:35:44", "text": "うん。どうぞご自由に"}, {"type": "subtitle", "time": 2147.91, "timestamp": "00:35:47", "text": "そろそろ目を通す時間だ。そしてもしあなたが"}, {"type": "subtitle", "time": 2151.51, "timestamp": "00:35:51", "text": "もしあなたがそう感じたら、"}, {"type": "subtitle", "time": 2152.71, "timestamp": "00:35:52", "text": "本当に好きじゃない、ほら、本当に"}, {"type": "subtitle", "time": 2154.23, "timestamp": "00:35:54", "text": "あなたが選んだものが好きです、私もクールだと思います"}, {"type": "subtitle", "time": 2156.87, "timestamp": "00:35:56", "text": "君がキャラクターを入れ替えたりするんだ。"}, {"type": "subtitle", "time": 2159.349, "timestamp": "00:35:59", "text": "おお、"}]
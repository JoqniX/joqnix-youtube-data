[{"type": "subtitle", "time": 10800.389, "timestamp": "03:00:00", "text": "ああ、雨水収集器。おお。画像はありますか？"}, {"type": "subtitle", "time": 10804.55, "timestamp": "03:00:04", "text": "このために？いいえ。わかりました。石鹸。"}, {"type": "subtitle", "time": 10807.11, "timestamp": "03:00:07", "text": "石鹸は買えますよ。"}, {"type": "subtitle", "time": 10820.79, "timestamp": "03:00:20", "text": "わかった、一緒に行くよ、買うよ"}, {"type": "subtitle", "time": 10825.75, "timestamp": "03:00:25", "text": "えっと、ところで、あなたは弓を持っていませんよね。"}, {"type": "subtitle", "time": 10827.51, "timestamp": "03:00:27", "text": "まずは弓を手に入れた方がいいかもしれません。"}, {"type": "subtitle", "time": 10829.429, "timestamp": "03:00:29", "text": "ああ、わかりました。ああ、わかった。"}, {"type": "subtitle", "time": 10832.63, "timestamp": "03:00:32", "text": "弓を持っていない。"}, {"type": "subtitle", "time": 10835.429, "timestamp": "03:00:35", "text": "わかった。弓、"}, {"type": "subtitle", "time": 10838.469, "timestamp": "03:00:38", "text": "ハンドボウ、クロスボウ、ロングボウ。"}, {"type": "subtitle", "time": 10840.309, "timestamp": "03:00:40", "text": "よし。そうそう。留意事項"}, {"type": "subtitle", "time": 10843.11, "timestamp": "03:00:43", "text": "えーと、あなたの武器熟練度、"}, {"type": "subtitle", "time": 10844.55, "timestamp": "03:00:44", "text": "あなたは単純なことしか得意ではない"}, {"type": "subtitle", "time": 10846.469, "timestamp": "03:00:46", "text": "兵器。つまり、1つしか選べないということです。"}, {"type": "subtitle", "time": 10847.99, "timestamp": "03:00:47", "text": "それは単純な武器を意味する。つまり、"}, {"type": "subtitle", "time": 10849.67, "timestamp": "03:00:49", "text": "短弓または軽量クロスボウ。の"}, {"type": "subtitle", "time": 10851.269, "timestamp": "03:00:51", "text": "その他は元帥兵器である。あなたはできません"}, {"type": "subtitle", "time": 10853.83, "timestamp": "03:00:53", "text": "実際にそれらを使っています。"}, {"type": "subtitle", "time": 10855.349, "timestamp": "03:00:55", "text": "ああ"}]
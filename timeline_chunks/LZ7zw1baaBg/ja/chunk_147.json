[{"type": "subtitle", "time": 8821.11, "timestamp": "02:27:01", "text": "はい、私はスター・ドロイドです。"}, {"type": "subtitle", "time": 8828.07, "timestamp": "02:27:08", "text": "[音楽]"}, {"type": "subtitle", "time": 8831.11, "timestamp": "02:27:11", "text": "待って。スーパーはキャラクターを作らなかった。"}, {"type": "subtitle", "time": 8832.87, "timestamp": "02:27:12", "text": "なんてこった。いいえ。スミはすでに私が作っただけです"}, {"type": "subtitle", "time": 8835.83, "timestamp": "02:27:15", "text": "追加しました。えっと、ちょっと待ってください。石"}, {"type": "subtitle", "time": 8841.99, "timestamp": "02:27:21", "text": "えっと、"}, {"type": "subtitle", "time": 8844.63, "timestamp": "02:27:24", "text": "ああ、さまざまな違いがあります"}, {"type": "subtitle", "time": 8847.27, "timestamp": "02:27:27", "text": "名前。何てことだ。私だけでしょうか"}, {"type": "subtitle", "time": 8852.389, "timestamp": "02:27:32", "text": "自分の名前を自分で選んだ？つまり、ミマルは"}, {"type": "subtitle", "time": 8854.79, "timestamp": "02:27:34", "text": "また？はい。しかし、技術的には"}, {"type": "subtitle", "time": 8857.75, "timestamp": "02:27:37", "text": "自己挿入物が3つありますか？スミのように"}, {"type": "subtitle", "time": 8860.469, "timestamp": "02:27:40", "text": "技術的には、スミとルースをプレイすることは"}, {"type": "subtitle", "time": 8868.309, "timestamp": "02:27:48", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 8877.91, "timestamp": "02:27:57", "text": "わかった。"}, {"type": "subtitle", "time": 8879.27, "timestamp": "02:27:59", "text": "よし。えっと、"}]
[{"type": "subtitle", "time": 8761.51, "timestamp": "02:26:01", "text": "生命の聖職者。"}, {"type": "subtitle", "time": 8763.27, "timestamp": "02:26:03", "text": "うん。うん。"}, {"type": "subtitle", "time": 8764.07, "timestamp": "02:26:04", "text": "わかった。"}, {"type": "subtitle", "time": 8765.51, "timestamp": "02:26:05", "text": "見てみましょう。"}, {"type": "subtitle", "time": 8767.19, "timestamp": "02:26:07", "text": "えっと、"}, {"type": "subtitle", "time": 8769.99, "timestamp": "02:26:09", "text": "では、私の役割は何なのでしょうか？まるで私が"}, {"type": "subtitle", "time": 8773.27, "timestamp": "02:26:13", "text": "遠距離魔法使い。"}, {"type": "subtitle", "time": 8774.23, "timestamp": "02:26:14", "text": "すみません、何ですか？"}, {"type": "subtitle", "time": 8776.79, "timestamp": "02:26:16", "text": "私の役割は何なの？"}, {"type": "subtitle", "time": 8778.71, "timestamp": "02:26:18", "text": "えっと、ちょっと待ってください。私にさせて"}, {"type": "subtitle", "time": 8779.11, "timestamp": "02:26:19", "text": "うん、"}, {"type": "subtitle", "time": 8782.469, "timestamp": "02:26:22", "text": "あなたは一般的にドルイドが好きです"}, {"type": "subtitle", "time": 8784.87, "timestamp": "02:26:24", "text": "当時の実用的なもの。ドルイドはタンク役を務めることができる"}, {"type": "subtitle", "time": 8786.23, "timestamp": "02:26:26", "text": "たくさんあったけど、今はそれほどでもない"}, {"type": "subtitle", "time": 8788.87, "timestamp": "02:26:28", "text": "タンク役が得意。そうですね、ほとんどの場合"}, {"type": "subtitle", "time": 8791.03, "timestamp": "02:26:31", "text": "君はブラスターの群衆のようになるだろう"}, {"type": "subtitle", "time": 8792.63, "timestamp": "02:26:32", "text": "コントローラ。"}, {"type": "subtitle", "time": 8794.63, "timestamp": "02:26:34", "text": "ああ、"}, {"type": "subtitle", "time": 8796.63, "timestamp": "02:26:36", "text": "実際には、癒しがたくさんあります"}, {"type": "subtitle", "time": 8797.99, "timestamp": "02:26:37", "text": "土曜日のグループみたいだから"}, {"type": "subtitle", "time": 8800.469, "timestamp": "02:26:40", "text": "パラディンとクレリック。あなたは"}, {"type": "subtitle", "time": 8801.75, "timestamp": "02:26:41", "text": "大丈夫。たくさん手に入れるよ、"}, {"type": "subtitle", "time": 8804.55, "timestamp": "02:26:44", "text": "便利な呪文がたくさんあるので、"}, {"type": "subtitle", "time": 8805.349, "timestamp": "02:26:45", "text": "良い。"}, {"type": "subtitle", "time": 8808.63, "timestamp": "02:26:48", "text": "わかった。わかった。わかった。それはすばらしい。"}, {"type": "subtitle", "time": 8813.51, "timestamp": "02:26:53", "text": "よし。わかった。今、あなたを追加しました。えっと、"}, {"type": "subtitle", "time": 8815.429, "timestamp": "02:26:55", "text": "持続する。付け加えておきますが、忘れていました"}, {"type": "subtitle", "time": 8817.59, "timestamp": "02:26:57", "text": "それ。"}]
[{"type": "subtitle", "time": 8584.72, "timestamp": "02:23:04", "text": "くそ。これはいいですね。"}, {"type": "subtitle", "time": 8591.91, "timestamp": "02:23:11", "text": "公式のD&Dゲームはありますか？"}, {"type": "subtitle", "time": 8600.63, "timestamp": "02:23:20", "text": "えっと、どう答えたらいいのかよくわからないんです"}, {"type": "subtitle", "time": 8604.309, "timestamp": "02:23:24", "text": "だって、D&DはテーブルトークRPGみたいなものだから。"}, {"type": "subtitle", "time": 8606.95, "timestamp": "02:23:26", "text": "をベースとしたゲームはたくさんあります"}, {"type": "subtitle", "time": 8609.91, "timestamp": "02:23:29", "text": "DND。ええと、ボルダーみたいなところ"}, {"type": "subtitle", "time": 8612.55, "timestamp": "02:23:32", "text": "例えば、ボルダーズ・スケートなど。でもDnみたいに"}, {"type": "subtitle", "time": 8616.469, "timestamp": "02:23:36", "text": "Dは正式にはテーブルトップです"}, {"type": "subtitle", "time": 8618.309, "timestamp": "02:23:38", "text": "RPG。"}, {"type": "subtitle", "time": 8621.75, "timestamp": "02:23:41", "text": "ああ、チェスみたいなものかな。"}, {"type": "subtitle", "time": 8623.429, "timestamp": "02:23:43", "text": "うん、"}, {"type": "subtitle", "time": 8625.75, "timestamp": "02:23:45", "text": "しかし、チェスは公式のゲームとして。"}, {"type": "subtitle", "time": 8627.349, "timestamp": "02:23:47", "text": "チェスは来ない。"}, {"type": "subtitle", "time": 8631.19, "timestamp": "02:23:51", "text": "ああ、D&D のような cuz はない"}, {"type": "subtitle", "time": 8634.23, "timestamp": "02:23:54", "text": "非常に似ているので、"}, {"type": "subtitle", "time": 8636.15, "timestamp": "02:23:56", "text": "仮想テーブルトップでプレイできます。だからあなたは"}, {"type": "subtitle", "time": 8637.75, "timestamp": "02:23:57", "text": "テーブルトップのようなものを使ってプレイする"}]
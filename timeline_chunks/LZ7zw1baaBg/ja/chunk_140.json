[{"type": "subtitle", "time": 8401.349, "timestamp": "02:20:01", "text": "ああ、画像をドラッグ＆ドロップする必要がある"}, {"type": "subtitle", "time": 8404.389, "timestamp": "02:20:04", "text": "ここ。わかった。アップロード。"}, {"type": "subtitle", "time": 8409.51, "timestamp": "02:20:09", "text": "ああ、そうしないといけない。わかった。ドラッグ＆ドロップでドロップできます。"}, {"type": "subtitle", "time": 8412.79, "timestamp": "02:20:12", "text": "はぁ？どの犬の画像を使えばいいですか？私にさせて"}, {"type": "subtitle", "time": 8424.63, "timestamp": "02:20:24", "text": "えっと、"}, {"type": "subtitle", "time": 8429.11, "timestamp": "02:20:29", "text": "ここはどこですか？わかった。アバター"}, {"type": "subtitle", "time": 8433.429, "timestamp": "02:20:33", "text": "アイコン。いいえ、このアバターです。わかった。そうですか"}, {"type": "subtitle", "time": 8436.389, "timestamp": "02:20:36", "text": "待たなければならない。えっと、何のために？"}, {"type": "chat", "time": 8437.185, "timestamp": "02:20:37", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "ello @Adthi R Negii "}, {"type": "subtitle", "time": 8439.83, "timestamp": "02:20:39", "text": "形式？正方形か円形か？"}, {"type": "subtitle", "time": 8442.469, "timestamp": "02:20:42", "text": "そうそう。えっと、私は作りたくない"}, {"type": "subtitle", "time": 8445.51, "timestamp": "02:20:45", "text": "何でも。でも、誰もが円のようなものだ。"}, {"type": "subtitle", "time": 8447.67, "timestamp": "02:20:47", "text": "ああ、誰もが円だ。"}, {"type": "subtitle", "time": 8450.309, "timestamp": "02:20:50", "text": "うん。そうすれば円を描くことができます"}, {"type": "subtitle", "time": 8451.349, "timestamp": "02:20:51", "text": "次に画像です。"}, {"type": "subtitle", "time": 8453.03, "timestamp": "02:20:53", "text": "うん。うん。ドラッグアンドドロップできる場合は、"}, {"type": "subtitle", "time": 8454.309, "timestamp": "02:20:54", "text": "円形に変わります"}, {"type": "subtitle", "time": 8455.75, "timestamp": "02:20:55", "text": "すぐに。"}, {"type": "subtitle", "time": 8459.11, "timestamp": "02:20:59", "text": "ああ、わかりました。うん、やりますよ。"}]
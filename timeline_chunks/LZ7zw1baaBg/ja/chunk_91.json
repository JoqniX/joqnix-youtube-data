[{"type": "subtitle", "time": 5462.709, "timestamp": "01:31:02", "text": "組み立てる。"}, {"type": "subtitle", "time": 5464.55, "timestamp": "01:31:04", "text": "シールドが手に入ります。うん、革製品が手に入るよ"}, {"type": "subtitle", "time": 5467.03, "timestamp": "01:31:07", "text": "鎧の盾、鎌、ルーリックフォーカス、"}, {"type": "subtitle", "time": 5469.35, "timestamp": "01:31:09", "text": "それは、あなたが使うものです"}, {"type": "subtitle", "time": 5471.91, "timestamp": "01:31:11", "text": "呪文を唱える。探検家パックを手に入れます。"}, {"type": "subtitle", "time": 5473.59, "timestamp": "01:31:13", "text": "つまり、ランダムな要素がたくさん含まれているということです。"}, {"type": "subtitle", "time": 5478.55, "timestamp": "01:31:18", "text": "小物類。そして、彼女の薬草キット。"}, {"type": "subtitle", "time": 5481.43, "timestamp": "01:31:21", "text": "ああ、神様。わかった。えっと、"}, {"type": "subtitle", "time": 5484.149, "timestamp": "01:31:24", "text": "これはキットですか、それとも"}, {"type": "subtitle", "time": 5486.709, "timestamp": "01:31:26", "text": "わかった。えっと、"}, {"type": "subtitle", "time": 5488.629, "timestamp": "01:31:28", "text": "えーと、"}, {"type": "subtitle", "time": 5491.189, "timestamp": "01:31:31", "text": "おすすめは何ですか？買うべきでしょうか"}, {"type": "subtitle", "time": 5491.91, "timestamp": "01:31:31", "text": "別のキットですか？"}, {"type": "subtitle", "time": 5494.87, "timestamp": "01:31:34", "text": "えっと、もしあなたが何を？すみません、何ですか？"}, {"type": "subtitle", "time": 5497.669, "timestamp": "01:31:37", "text": "貯金してより良いものを買うべきでしょうか"}, {"type": "subtitle", "time": 5500.07, "timestamp": "01:31:40", "text": "どちらか一方？それともこちら？アップグレードできますよね？もし私が"}, {"type": "subtitle", "time": 5500.629, "timestamp": "01:31:40", "text": "お金を持っている。"}, {"type": "subtitle", "time": 5502.39, "timestamp": "01:31:42", "text": "うん。はい、アップグレードできますよ。そしてあなたはそうする"}, {"type": "subtitle", "time": 5504.95, "timestamp": "01:31:44", "text": "すぐにお金が手に入る。もし"}, {"type": "subtitle", "time": 5508.55, "timestamp": "01:31:48", "text": "もしあなたが知らないなら、あなたはただ"}, {"type": "subtitle", "time": 5511.43, "timestamp": "01:31:51", "text": "スタート装備を選ぶように、"}, {"type": "subtitle", "time": 5513.43, "timestamp": "01:31:53", "text": "えっと、お店はちょっと"}, {"type": "subtitle", "time": 5515.35, "timestamp": "01:31:55", "text": "お店にはたくさんの商品があります。あなた"}, {"type": "subtitle", "time": 5518.79, "timestamp": "01:31:58", "text": "混乱を招くかもしれません。"}]
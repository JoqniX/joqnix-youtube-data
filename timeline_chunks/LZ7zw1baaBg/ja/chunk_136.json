[{"type": "subtitle", "time": 8162.149, "timestamp": "02:16:02", "text": "それをあなたの機能に追加してください。それはまるで"}, {"type": "subtitle", "time": 8163.51, "timestamp": "02:16:03", "text": "それは呪文ではありません。"}, {"type": "subtitle", "time": 8165.91, "timestamp": "02:16:05", "text": "ああ、わかりました。わかった。"}, {"type": "subtitle", "time": 8169.75, "timestamp": "02:16:09", "text": "ええと、次は"}, {"type": "subtitle", "time": 8170.87, "timestamp": "02:16:10", "text": "えっと"}, {"type": "subtitle", "time": 8172.229, "timestamp": "02:16:12", "text": "[音楽]"}, {"type": "subtitle", "time": 8177.51, "timestamp": "02:16:17", "text": "絡み合う。絡み合う。絡み合う。"}, {"type": "subtitle", "time": 8180.79, "timestamp": "02:16:20", "text": "元素武器。"}, {"type": "subtitle", "time": 8183.35, "timestamp": "02:16:23", "text": "絡み合う。どこですか？ E."}, {"type": "subtitle", "time": 8186.39, "timestamp": "02:16:26", "text": "エンタングルはレベル1か2だと思う。"}, {"type": "subtitle", "time": 8189.589, "timestamp": "02:16:29", "text": "えっと、レベル1です。うん、レベル1だよ。"}, {"type": "subtitle", "time": 8215.429, "timestamp": "02:16:55", "text": "また、新しく来た人たちはどうだったか"}, {"type": "subtitle", "time": 8218.389, "timestamp": "02:16:58", "text": "D&D初心者"}]
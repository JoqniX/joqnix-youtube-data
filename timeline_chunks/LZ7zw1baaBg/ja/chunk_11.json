[{"type": "subtitle", "time": 660.069, "timestamp": "00:11:00", "text": "ガイド。"}, {"type": "subtitle", "time": 669.19, "timestamp": "00:11:09", "text": "ええ、その点に集中してみてください。"}, {"type": "subtitle", "time": 671.829, "timestamp": "00:11:11", "text": "一緒に歌う"}, {"type": "subtitle", "time": 674.71, "timestamp": "00:11:14", "text": "えっと"}, {"type": "subtitle", "time": 677.35, "timestamp": "00:11:17", "text": "いや、これは違う。えっと、私は"}, {"type": "subtitle", "time": 679.91, "timestamp": "00:11:19", "text": "楽器は私が以来最新の時間です"}, {"type": "subtitle", "time": 686.94, "timestamp": "00:11:26", "text": "３、２、１。"}, {"type": "subtitle", "time": 688.55, "timestamp": "00:11:28", "text": "[音楽]"}]
[{"type": "subtitle", "time": 1807.269, "timestamp": "00:30:07", "text": "野蛮人？"}, {"type": "subtitle", "time": 1810.87, "timestamp": "00:30:10", "text": "ああ、これは難しい。わかった。聖職者（ヒーラー）"}, {"type": "subtitle", "time": 1811.51, "timestamp": "00:30:11", "text": "多分。"}, {"type": "subtitle", "time": 1814.23, "timestamp": "00:30:14", "text": "はい。まるで触れるだけのドロイドのように"}, {"type": "subtitle", "time": 1829.51, "timestamp": "00:30:29", "text": "[音楽]"}, {"type": "subtitle", "time": 1842.87, "timestamp": "00:30:42", "text": "わかったわかった、お坊さん、わかった、いいね"}, {"type": "subtitle", "time": 1846.71, "timestamp": "00:30:46", "text": "叫び声。私が手に入れたのは"}, {"type": "subtitle", "time": 1848.63, "timestamp": "00:30:48", "text": "待って、呪文を唱えなきゃいけないよ"}, {"type": "subtitle", "time": 1849.51, "timestamp": "00:30:49", "text": "などなど。"}, {"type": "subtitle", "time": 1851.99, "timestamp": "00:30:51", "text": "いいえ、必要ありません。でも、もしあなたが"}, {"type": "subtitle", "time": 1854.63, "timestamp": "00:30:54", "text": "どうぞご自由に。自由を感じたいなら。"}]
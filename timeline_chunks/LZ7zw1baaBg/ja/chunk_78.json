[{"type": "subtitle", "time": 4682.47, "timestamp": "01:18:02", "text": "もの？えっと、ああ、なんてことだ。はい、私は間違っていました"}, {"type": "subtitle", "time": 4687.43, "timestamp": "01:18:07", "text": "もの。持続する。えっと、ちょっと待ってください。えっと、"}, {"type": "subtitle", "time": 4689.75, "timestamp": "01:18:09", "text": "画面共有"}, {"type": "subtitle", "time": 4691.669, "timestamp": "01:18:11", "text": "その後"}, {"type": "subtitle", "time": 4695.51, "timestamp": "01:18:15", "text": "持続する。どこですか？画面を共有して"}, {"type": "subtitle", "time": 4698.229, "timestamp": "01:18:18", "text": "そしてこれ。はい、どうぞ。できる"}, {"type": "subtitle", "time": 4699.27, "timestamp": "01:18:19", "text": "あれ、見える？"}, {"type": "subtitle", "time": 4700.47, "timestamp": "01:18:20", "text": "うん。"}, {"type": "subtitle", "time": 4704.63, "timestamp": "01:18:24", "text": "わかった。こちらです。えっと、選択できます"}, {"type": "subtitle", "time": 4707.27, "timestamp": "01:18:27", "text": "楽器やゲームセットなど"}, {"type": "subtitle", "time": 4709.189, "timestamp": "01:18:29", "text": "はい、ご自由にどれでもお選びください"}, {"type": "subtitle", "time": 4710.95, "timestamp": "01:18:30", "text": "彼らのうちの。これはあなたの"}, {"type": "subtitle", "time": 4712.95, "timestamp": "01:18:32", "text": "備品を補充する。だからあなたが"}, {"type": "subtitle", "time": 4715.189, "timestamp": "01:18:35", "text": "スポーンすると、これが"}, {"type": "subtitle", "time": 4715.669, "timestamp": "01:18:35", "text": "つまりそういうことだ。"}, {"type": "subtitle", "time": 4718.07, "timestamp": "01:18:38", "text": "どこをクリックすればいいですか？"}, {"type": "subtitle", "time": 4720.63, "timestamp": "01:18:40", "text": "ああ、えーっと、私は行くつもりです、私は行くつもりです"}, {"type": "subtitle", "time": 4721.83, "timestamp": "01:18:41", "text": "何らかの理由で、あなたのためにクリックしてください"}, {"type": "subtitle", "time": 4724.149, "timestamp": "01:18:44", "text": "あなたの輸入業者は、ある意味で、"}, {"type": "subtitle", "time": 4726.63, "timestamp": "01:18:46", "text": "壊れた。ええ、そうですね。"}, {"type": "subtitle", "time": 4729.99, "timestamp": "01:18:49", "text": "ええと、こちらで、あなたが選んだ"}, {"type": "subtitle", "time": 4732.31, "timestamp": "01:18:52", "text": "先ほど楽器を選んだ"}, {"type": "subtitle", "time": 4735.35, "timestamp": "01:18:55", "text": "それを何と呼ぶんだっけ？あなたは選びました"}, {"type": "subtitle", "time": 4737.03, "timestamp": "01:18:57", "text": "楽器演奏能力。だからあなたは"}, {"type": "subtitle", "time": 4739.27, "timestamp": "01:18:59", "text": "まず1つから始めよう。おそらくそうだったでしょう"}]
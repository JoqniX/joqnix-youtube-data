[{"type": "subtitle", "time": 2582.15, "timestamp": "00:43:02", "text": "中装甲のようなものを使って、えーと、えーと、"}, {"type": "subtitle", "time": 2585.349, "timestamp": "00:43:05", "text": "デッキをプラス2くらいまで増やす。えっと、もし"}, {"type": "subtitle", "time": 2587.27, "timestamp": "00:43:07", "text": "CR には、"}, {"type": "subtitle", "time": 2589.43, "timestamp": "00:43:09", "text": "能力値修正値、プラス"}, {"type": "subtitle", "time": 2591.91, "timestamp": "00:43:11", "text": "二。でも、もしあなたが計画していないなら"}, {"type": "subtitle", "time": 2593.67, "timestamp": "00:43:13", "text": "どうぞご自由に、できるだけ高く登ってください"}, {"type": "subtitle", "time": 2598.23, "timestamp": "00:43:18", "text": "可能な限り。えーっと、そうですね、"}, {"type": "subtitle", "time": 2601.75, "timestamp": "00:43:21", "text": "一般的に、それは、"}, {"type": "subtitle", "time": 2604.55, "timestamp": "00:43:24", "text": "えっと、どうやって"}, {"type": "subtitle", "time": 2607.43, "timestamp": "00:43:27", "text": "ええと、作ってください。"}, {"type": "subtitle", "time": 2609.829, "timestamp": "00:43:29", "text": "それは本当にあなた次第です"}, {"type": "subtitle", "time": 2612.309, "timestamp": "00:43:32", "text": "あなたがやりたいようにやってください。"}, {"type": "subtitle", "time": 2615.109, "timestamp": "00:43:35", "text": "私は体質の器用さに自信があります"}, {"type": "subtitle", "time": 2616.87, "timestamp": "00:43:36", "text": "一般的にとてもとても"}, {"type": "subtitle", "time": 2618.87, "timestamp": "00:43:38", "text": "どのクラスにも適しています。"}, {"type": "subtitle", "time": 2627.589, "timestamp": "00:43:47", "text": "わかった。知的な人は何をする人でしたっけ？えっと"}, {"type": "subtitle", "time": 2632.39, "timestamp": "00:43:52", "text": "もし私の知能が、えっと、それは"}, {"type": "subtitle", "time": 2633.75, "timestamp": "00:43:53", "text": "運がいいってこと？"}, {"type": "subtitle", "time": 2635.43, "timestamp": "00:43:55", "text": "いやいや、運みたいなものではないよ。"}, {"type": "subtitle", "time": 2637.91, "timestamp": "00:43:57", "text": "知能"}, {"type": "subtitle", "time": 2639.27, "timestamp": "00:43:59", "text": "ほとんどのクラスは実際には使用しません"}]
[{"type": "subtitle", "time": 1142.87, "timestamp": "00:19:02", "text": "彼は私に作り方を教えてくれるだろう"}, {"type": "subtitle", "time": 1145.99, "timestamp": "00:19:05", "text": "どうやって作るか、どうやって私のキャラクターを作るか"}, {"type": "subtitle", "time": 1156.37, "timestamp": "00:19:16", "text": "えっと"}, {"type": "subtitle", "time": 1164.87, "timestamp": "00:19:24", "text": "えーと。"}, {"type": "subtitle", "time": 1181.99, "timestamp": "00:19:41", "text": "あの犬は外で吠えまくって"}, {"type": "subtitle", "time": 1192.39, "timestamp": "00:19:52", "text": "ええと、私たちは見ています"}, {"type": "subtitle", "time": 1195.59, "timestamp": "00:19:55", "text": "ストリームで私をフォローしてください"}, {"type": "subtitle", "time": 1198.87, "timestamp": "00:19:58", "text": "もしあなたがそうしないなら、何？"}]
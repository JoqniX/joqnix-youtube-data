[{"type": "subtitle", "time": 5220.39, "timestamp": "01:27:00", "text": "えっと、あなたが持っているような"}, {"type": "subtitle", "time": 5222.95, "timestamp": "01:27:02", "text": "つまり、こちらではあなたの知恵はプラス３です。"}, {"type": "subtitle", "time": 5225.35, "timestamp": "01:27:05", "text": "右？それはつまり、すべての知恵"}, {"type": "subtitle", "time": 5227.75, "timestamp": "01:27:07", "text": "アイテムにプラス３点が加算される。そしてあなたの"}, {"type": "subtitle", "time": 5229.35, "timestamp": "01:27:09", "text": "知能はプラスゼロです。つまり"}, {"type": "subtitle", "time": 5230.95, "timestamp": "01:27:10", "text": "諜報活動はすべてプラスになる"}, {"type": "subtitle", "time": 5232.87, "timestamp": "01:27:12", "text": "ゼロ。"}, {"type": "subtitle", "time": 5234.95, "timestamp": "01:27:14", "text": "ああ、よかった。スキルをチェックすると"}, {"type": "subtitle", "time": 5236.55, "timestamp": "01:27:16", "text": "熟練度、つまり、別の"}, {"type": "subtitle", "time": 5239.27, "timestamp": "01:27:19", "text": "それに加えて2つ。"}, {"type": "subtitle", "time": 5241.27, "timestamp": "01:27:21", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 5244.55, "timestamp": "01:27:24", "text": "おお。えっと、もし私が「選択」をクリックしたら"}, {"type": "subtitle", "time": 5246.31, "timestamp": "01:27:26", "text": "別の"}, {"type": "subtitle", "time": 5249.99, "timestamp": "01:27:29", "text": "ええと、知恵1はプラス6になります"}, {"type": "subtitle", "time": 5253.669, "timestamp": "01:27:33", "text": "プラス4ですよね？いや、違うよ。それはもっと"}, {"type": "subtitle", "time": 5257.51, "timestamp": "01:27:37", "text": "えっと、スキルの仕組みは"}, {"type": "subtitle", "time": 5262.47, "timestamp": "01:27:42", "text": "スキルがあなたの能力を引き出す"}, {"type": "subtitle", "time": 5265.11, "timestamp": "01:27:45", "text": "スコア修飾子が"}, {"type": "subtitle", "time": 5267.11, "timestamp": "01:27:47", "text": "知恵はプラス３で、それから"}, {"type": "subtitle", "time": 5268.87, "timestamp": "01:27:48", "text": "あなたの熟練度ボーナス。それは、"}, {"type": "subtitle", "time": 5270.79, "timestamp": "01:27:50", "text": "あなたはその特定の分野で優れた才能を持っている。"}, {"type": "subtitle", "time": 5273.43, "timestamp": "01:27:53", "text": "熟練度ボーナスは2から始まりますが"}, {"type": "subtitle", "time": 5275.189, "timestamp": "01:27:55", "text": "レベルが上がると、それが増えていきます"}, {"type": "subtitle", "time": 5279.03, "timestamp": "01:27:59", "text": "上。では、あなたが熟練者だとしましょう"}]
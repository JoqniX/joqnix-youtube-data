[{"type": "subtitle", "time": 8941.59, "timestamp": "02:29:01", "text": "わかった。"}, {"type": "subtitle", "time": 8944.23, "timestamp": "02:29:04", "text": "最新情報をお持ちの方はいらっしゃいますか？"}, {"type": "subtitle", "time": 8946.79, "timestamp": "02:29:06", "text": "わかった。よし。更新しました"}, {"type": "subtitle", "time": 8948.87, "timestamp": "02:29:08", "text": "トークンを更新するだけでいいので"}, {"type": "subtitle", "time": 8952.07, "timestamp": "02:29:12", "text": "それは、えっと、もう一度何て呼べばいいか。それ"}, {"type": "subtitle", "time": 8954.95, "timestamp": "02:29:14", "text": "マウスカーソルを合わせると、あなたの名前とHPが表示されます。"}, {"type": "subtitle", "time": 8957.19, "timestamp": "02:29:17", "text": "ええ、そうです。よし。ええ、そうですね。それで、えっと、あなたは"}, {"type": "subtitle", "time": 8958.79, "timestamp": "02:29:18", "text": "トークンをドラッグして"}, {"type": "subtitle", "time": 8960.87, "timestamp": "02:29:20", "text": "ただ物を移動させるだけです。それはまるで"}, {"type": "subtitle", "time": 8963.51, "timestamp": "02:29:23", "text": "あなたの動き方。えっと、でも動けるのは"}, {"type": "subtitle", "time": 8966.63, "timestamp": "02:29:26", "text": "うん、そうだね。しかし、あなたは次のようにしか動けません"}, {"type": "subtitle", "time": 8968.71, "timestamp": "02:29:28", "text": "周囲に壁はない"}, {"type": "subtitle", "time": 8970.95, "timestamp": "02:29:30", "text": "ドアをクリックできます"}, {"type": "subtitle", "time": 8972.87, "timestamp": "02:29:32", "text": "その後"}, {"type": "subtitle", "time": 8976.71, "timestamp": "02:29:36", "text": "えーと、あなたは、あなたは、"}, {"type": "subtitle", "time": 8978.07, "timestamp": "02:29:38", "text": "計測された動き。だから、"}, {"type": "subtitle", "time": 8980.469, "timestamp": "02:29:40", "text": "サイドバーをクリックすると、"}, {"type": "subtitle", "time": 8982.71, "timestamp": "02:29:42", "text": "上部のうーん"}, {"type": "subtitle", "time": 8984.63, "timestamp": "02:29:44", "text": "トップ"}, {"type": "subtitle", "time": 8986.87, "timestamp": "02:29:46", "text": "そこに残されたのは測定のようなものだ"}, {"type": "subtitle", "time": 8990.469, "timestamp": "02:29:50", "text": "左上の物のアイコン、左を計測している"}, {"type": "subtitle", "time": 8992.87, "timestamp": "02:29:52", "text": "それはこの距離を測定しているのです。わかった。"}, {"type": "subtitle", "time": 8994.71, "timestamp": "02:29:54", "text": "うん。うん。それは、"}, {"type": "subtitle", "time": 8996.87, "timestamp": "02:29:56", "text": "測定を可能にする重要なツール"}, {"type": "subtitle", "time": 8999.03, "timestamp": "02:29:59", "text": "もの。長押しすると、"}]
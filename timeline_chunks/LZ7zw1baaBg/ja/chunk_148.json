[{"type": "subtitle", "time": 8882.23, "timestamp": "02:28:02", "text": "待って。これは何ですか？えーと、日本語、中国語"}, {"type": "subtitle", "time": 8883.27, "timestamp": "02:28:03", "text": "1つ。"}, {"type": "subtitle", "time": 8885.27, "timestamp": "02:28:05", "text": "それは中国人だ。それは それは それは それは"}, {"type": "subtitle", "time": 8886.95, "timestamp": "02:28:06", "text": "しあい。"}, {"type": "subtitle", "time": 8889.429, "timestamp": "02:28:09", "text": "何てことだ。"}, {"type": "subtitle", "time": 8896.309, "timestamp": "02:28:16", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 8898.389, "timestamp": "02:28:18", "text": "よし。"}, {"type": "subtitle", "time": 8900.07, "timestamp": "02:28:20", "text": "わかった。よし。わかった。だから、これであなたの"}, {"type": "subtitle", "time": 8901.83, "timestamp": "02:28:21", "text": "猫。では、その方法を教えましょう"}, {"type": "subtitle", "time": 8903.03, "timestamp": "02:28:23", "text": "実際にやり方を教える"}, {"type": "subtitle", "time": 8906.63, "timestamp": "02:28:26", "text": "VTTを今すぐ稼働させる。えっと、見てみましょう。うん。"}, {"type": "subtitle", "time": 8909.03, "timestamp": "02:28:29", "text": "よし。ええ、そうですね。だから、もしあなたが閉じるなら"}, {"type": "subtitle", "time": 8911.349, "timestamp": "02:28:31", "text": "それと、そのことについて、"}, {"type": "subtitle", "time": 8912.63, "timestamp": "02:28:32", "text": "これでトークンが確認できるはずです。もし"}, {"type": "subtitle", "time": 8914.95, "timestamp": "02:28:34", "text": "そこをクリックできます。ああ、もうすぐだ"}, {"type": "subtitle", "time": 8916.389, "timestamp": "02:28:36", "text": "それ。それを閉じてください。心配しないで。ただ"}, {"type": "subtitle", "time": 8919.03, "timestamp": "02:28:39", "text": "それを閉じてください。あ、ちょっと待って。待って。私はただ"}, {"type": "subtitle", "time": 8921.19, "timestamp": "02:28:41", "text": "いいねを忘れたことに気付いた。"}, {"type": "subtitle", "time": 8924.15, "timestamp": "02:28:44", "text": "これを設定してください。ちょっと待ってください。えっと、ちょっと待って"}, {"type": "subtitle", "time": 8925.67, "timestamp": "02:28:45", "text": "の上。"}, {"type": "subtitle", "time": 8934.15, "timestamp": "02:28:54", "text": "赤はこれをして、それから私に作らせてください"}, {"type": "subtitle", "time": 8937.59, "timestamp": "02:28:57", "text": "確かに、あなたのものが"}, {"type": "subtitle", "time": 8939.429, "timestamp": "02:28:59", "text": "見える。"}]
[{"type": "subtitle", "time": 2161.75, "timestamp": "00:36:01", "text": "うん。"}, {"type": "subtitle", "time": 2164.79, "timestamp": "00:36:04", "text": "どう思いますか？デュイド。ドルイドは"}, {"type": "subtitle", "time": 2166.87, "timestamp": "00:36:06", "text": "より良い。いいえ。"}, {"type": "subtitle", "time": 2167.829, "timestamp": "00:36:07", "text": "何？ごめん。"}, {"type": "subtitle", "time": 2170.47, "timestamp": "00:36:10", "text": "ドルイドの方が良いですよね？"}, {"type": "subtitle", "time": 2174.87, "timestamp": "00:36:14", "text": "えーっと、クラス別に言うと、それぞれ"}, {"type": "subtitle", "time": 2177.109, "timestamp": "00:36:17", "text": "つまり、クラスは技術的に技術的に"}, {"type": "subtitle", "time": 2180.15, "timestamp": "00:36:20", "text": "彼らには異なるパワーレベルがありますが、"}, {"type": "subtitle", "time": 2182.95, "timestamp": "00:36:22", "text": "えーと、それらのほとんどは一般的に"}, {"type": "subtitle", "time": 2184.87, "timestamp": "00:36:24", "text": "同じくらいだと思う"}, {"type": "subtitle", "time": 2187.27, "timestamp": "00:36:27", "text": "厳密に"}, {"type": "subtitle", "time": 2189.91, "timestamp": "00:36:29", "text": "他のものより優れている、ということだよ。私は...するだろう"}, {"type": "subtitle", "time": 2192.79, "timestamp": "00:36:32", "text": "好きなものを選んでください"}, {"type": "subtitle", "time": 2197.99, "timestamp": "00:36:37", "text": "[音楽]"}, {"type": "subtitle", "time": 2199.51, "timestamp": "00:36:39", "text": "えっと"}, {"type": "subtitle", "time": 2202.31, "timestamp": "00:36:42", "text": "なぜ私はすべての"}, {"type": "subtitle", "time": 2205.67, "timestamp": "00:36:45", "text": "あなたのような授業はありますか？私のはPHPのようなものです。"}, {"type": "subtitle", "time": 2207.19, "timestamp": "00:36:47", "text": "ご心配なく。ええ、そうです"}, {"type": "subtitle", "time": 2208.23, "timestamp": "00:36:48", "text": "そうするべきだった。当然のことながら"}, {"type": "subtitle", "time": 2210.31, "timestamp": "00:36:50", "text": "PHP 20224のみを表示するため、他の"}, {"type": "subtitle", "time": 2212.31, "timestamp": "00:36:52", "text": "私が持っているのは、えーと、"}, {"type": "subtitle", "time": 2214.95, "timestamp": "00:36:54", "text": "追加の情報源は、少し"}, {"type": "subtitle", "time": 2217.75, "timestamp": "00:36:57", "text": "もっと複雑だ。ええと、心配しないでください"}]
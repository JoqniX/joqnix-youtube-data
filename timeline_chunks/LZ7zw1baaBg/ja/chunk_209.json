[{"type": "subtitle", "time": 12553.83, "timestamp": "03:29:13", "text": "何てことだ。"}, {"type": "subtitle", "time": 12568.15, "timestamp": "03:29:28", "text": "そう、私も連絡を取り始めました"}, {"type": "subtitle", "time": 12571.11, "timestamp": "03:29:31", "text": "数人しかいないけど、それは悪いと感じた"}, {"type": "subtitle", "time": 12575.59, "timestamp": "03:29:35", "text": "実際に保管しなかったのは私の間違いでした"}, {"type": "subtitle", "time": 12579.03, "timestamp": "03:29:39", "text": "私がした人と連絡を取る"}, {"type": "subtitle", "time": 12581.75, "timestamp": "03:29:41", "text": "スジョカタンのような大規模なコラボレーション"}, {"type": "subtitle", "time": 12583.67, "timestamp": "03:29:43", "text": "あまり話したことのないコラボレーション"}, {"type": "subtitle", "time": 12586.469, "timestamp": "03:29:46", "text": "私が好きなタイプの人々"}, {"type": "subtitle", "time": 12589.429, "timestamp": "03:29:49", "text": "彼らを連れ戻し、蘇らせ、"}, {"type": "subtitle", "time": 12591.67, "timestamp": "03:29:51", "text": "すべてにおいて、私はそうしました"}, {"type": "subtitle", "time": 12594.07, "timestamp": "03:29:54", "text": "わからないけど、うん、何人かいるから"}, {"type": "subtitle", "time": 12596.79, "timestamp": "03:29:56", "text": "何かやろうと思ってたんだけど"}, {"type": "subtitle", "time": 12599.99, "timestamp": "03:29:59", "text": "今後数ヶ月のうちに、"}]
[{"type": "subtitle", "time": 5342.709, "timestamp": "01:29:02", "text": "私も参加するので、それは良いことです"}, {"type": "subtitle", "time": 5345.11, "timestamp": "01:29:05", "text": "今すぐ選びたいなら、今すぐ選びたい"}, {"type": "subtitle", "time": 5347.75, "timestamp": "01:29:07", "text": "どのチームに入りたいですか？"}, {"type": "subtitle", "time": 5348.87, "timestamp": "01:29:08", "text": "それはあなたの"}, {"type": "subtitle", "time": 5350.31, "timestamp": "01:29:10", "text": "利用可能"}, {"type": "subtitle", "time": 5352.47, "timestamp": "01:29:12", "text": "土曜日は、"}, {"type": "subtitle", "time": 5354.07, "timestamp": "01:29:14", "text": "土曜日のチームで、都合がよければ"}, {"type": "subtitle", "time": 5355.43, "timestamp": "01:29:15", "text": "日曜日は、日曜日のチームに行くことができます。"}, {"type": "subtitle", "time": 5357.99, "timestamp": "01:29:17", "text": "両方に行きたいなら、どうぞご自由に。"}, {"type": "subtitle", "time": 5359.669, "timestamp": "01:29:19", "text": "各チームのメンバーを知りたい場合"}, {"type": "subtitle", "time": 5361.189, "timestamp": "01:29:21", "text": "私はあなたにリストをいいねできます、またはあなたがいいねできます"}, {"type": "subtitle", "time": 5363.43, "timestamp": "01:29:23", "text": "Discordのグループチャンネルをチェックして"}, {"type": "subtitle", "time": 5365.59, "timestamp": "01:29:25", "text": "各チームに誰が所属しているか確認してみましょう。"}, {"type": "subtitle", "time": 5367.669, "timestamp": "01:29:27", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 5372.149, "timestamp": "01:29:32", "text": "えーと、生存とは"}, {"type": "subtitle", "time": 5374.709, "timestamp": "01:29:34", "text": "良い。いいえ、つまりオールラウンダーのようなもので、"}, {"type": "subtitle", "time": 5375.91, "timestamp": "01:29:35", "text": "右？"}, {"type": "subtitle", "time": 5378.629, "timestamp": "01:29:38", "text": "えーと、それは本当にあなた次第です"}, {"type": "subtitle", "time": 5381.189, "timestamp": "01:29:41", "text": "人格を形成したい。どれ"}, {"type": "subtitle", "time": 5394.07, "timestamp": "01:29:54", "text": "[音楽]"}, {"type": "subtitle", "time": 5397.27, "timestamp": "01:29:57", "text": "うん。それで"}, {"type": "subtitle", "time": 5398.87, "timestamp": "01:29:58", "text": "作品。"}, {"type": "subtitle", "time": 5399.51, "timestamp": "01:29:59", "text": "うん。"}]
[{"type": "subtitle", "time": 240.39, "timestamp": "00:04:00", "text": "この歌を覚えました。それはあの歌で"}, {"type": "subtitle", "time": 242.71, "timestamp": "00:04:02", "text": "あなたはそれをもっと練習しようとしている。私は"}, {"type": "subtitle", "time": 246.47, "timestamp": "00:04:06", "text": "いや、これはきっと"}, {"type": "subtitle", "time": 249.03, "timestamp": "00:04:09", "text": "成功できるだろうが、"}, {"type": "subtitle", "time": 250.949, "timestamp": "00:04:10", "text": "本当に大変だろう。ほぼ確信している"}, {"type": "subtitle", "time": 252.71, "timestamp": "00:04:12", "text": "歌えるようになるだろうけど、"}, {"type": "subtitle", "time": 255.35, "timestamp": "00:04:15", "text": "本当に本当に大変だった。それは私の"}, {"type": "subtitle", "time": 256.629, "timestamp": "00:04:16", "text": "意見。"}, {"type": "subtitle", "time": 257.67, "timestamp": "00:04:17", "text": "うん、"}, {"type": "subtitle", "time": 258.789, "timestamp": "00:04:18", "text": "そうです。"}, {"type": "subtitle", "time": 261.509, "timestamp": "00:04:21", "text": "はい、練習を始めても大丈夫です。"}, {"type": "subtitle", "time": 271.99, "timestamp": "00:04:31", "text": "こんにちは。"}, {"type": "subtitle", "time": 274.79, "timestamp": "00:04:34", "text": "３、２、１。最初の5回"}, {"type": "subtitle", "time": 277.99, "timestamp": "00:04:37", "text": "歌なしでも大丈夫だよね？"}]
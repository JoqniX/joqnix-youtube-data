[{"type": "subtitle", "time": 10620.71, "timestamp": "02:57:00", "text": "あるいは、戦闘がどのように行われるか、という方が近いかもしれません。そして"}, {"type": "subtitle", "time": 10623.11, "timestamp": "02:57:03", "text": "これで全てだと思います。"}, {"type": "subtitle", "time": 10625.269, "timestamp": "02:57:05", "text": "わかった。あなたの"}, {"type": "subtitle", "time": 10629.19, "timestamp": "02:57:09", "text": "能力、そしてそれから"}, {"type": "subtitle", "time": 10632.79, "timestamp": "02:57:12", "text": "ええ、ちょっと見せてください。"}, {"type": "subtitle", "time": 10635.91, "timestamp": "02:57:15", "text": "持続する。編集させてください。わからない"}, {"type": "subtitle", "time": 10639.59, "timestamp": "02:57:19", "text": "なぜそれが壊れているのかは分かりませんが、私が直せます。"}, {"type": "subtitle", "time": 10642.71, "timestamp": "02:57:22", "text": "アクティビジョン効果。"}, {"type": "subtitle", "time": 10645.03, "timestamp": "02:57:25", "text": "ああ、スケール感があるんだね。持続する。しかし、"}, {"type": "subtitle", "time": 10647.349, "timestamp": "02:57:27", "text": "何らかの理由でスケールが存在しない。させて"}, {"type": "subtitle", "time": 10651.19, "timestamp": "02:57:31", "text": "すぐに直します。でも、そう思う"}, {"type": "subtitle", "time": 10653.269, "timestamp": "02:57:33", "text": "それが全てです。ああ、待ってください。所有"}, {"type": "subtitle", "time": 10654.87, "timestamp": "02:57:34", "text": "の上。買い物を忘れてしまった。そうそう。所有"}, {"type": "subtitle", "time": 10656.309, "timestamp": "02:57:36", "text": "の上。その前に、ちょっと確認させてください"}, {"type": "subtitle", "time": 10677.19, "timestamp": "02:57:57", "text": "そして、そう、近い。そして今"}, {"type": "subtitle", "time": 10678.87, "timestamp": "02:57:58", "text": "適切な量​​の取引を行うべきである"}]
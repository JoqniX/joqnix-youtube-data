[{"type": "subtitle", "time": 6840.39, "timestamp": "01:54:00", "text": "から"}, {"type": "subtitle", "time": 6842.149, "timestamp": "01:54:02", "text": "えっと、どうやら星の輪らしい。はぁ。所有"}, {"type": "subtitle", "time": 6843.99, "timestamp": "01:54:03", "text": "の上。なぜ？念のためもう一度確認させてください。"}, {"type": "subtitle", "time": 6845.51, "timestamp": "01:54:05", "text": "これは本当に手早く。ああ、あなたは"}, {"type": "subtitle", "time": 6846.79, "timestamp": "01:54:06", "text": "ガイドボルトも同様です。これは何ですか"}, {"type": "subtitle", "time": 6849.589, "timestamp": "01:54:09", "text": "スペル？そうそう。わかった、気にしないで。えっと"}, {"type": "subtitle", "time": 6853.27, "timestamp": "01:54:13", "text": "ええ、そうです。ちょっと待ってください。えっと"}, {"type": "subtitle", "time": 6855.51, "timestamp": "01:54:15", "text": "はい、すぐに"}, {"type": "subtitle", "time": 6858.31, "timestamp": "01:54:18", "text": "えっと、これは重複しているので削除してください。"}, {"type": "subtitle", "time": 6859.83, "timestamp": "01:54:19", "text": "そして私はあなたの1つを削除します"}, {"type": "subtitle", "time": 6862.07, "timestamp": "01:54:22", "text": "重複しているため、ガイダンスが必要です。"}, {"type": "subtitle", "time": 6865.27, "timestamp": "01:54:25", "text": "さて、こちらでは、えっと、あなたが選ぶことができます"}, {"type": "subtitle", "time": 6866.95, "timestamp": "01:54:26", "text": "別のCANスクリプト。では、実際に"}, {"type": "subtitle", "time": 6869.51, "timestamp": "01:54:29", "text": "インポーターを開いて"}, {"type": "subtitle", "time": 6871.83, "timestamp": "01:54:31", "text": "そこから選んでください。"}, {"type": "subtitle", "time": 6873.91, "timestamp": "01:54:33", "text": "待って、今私が持っているものは何だっけ？私"}, {"type": "subtitle", "time": 6875.189, "timestamp": "01:54:35", "text": "忘れた。えっと、"}, {"type": "subtitle", "time": 6877.27, "timestamp": "01:54:37", "text": "何？そうそう。君は君を手に入れた"}, {"type": "subtitle", "time": 6879.83, "timestamp": "01:54:39", "text": "現在、指導を受けています。えっと、"}, {"type": "subtitle", "time": 6883.75, "timestamp": "01:54:43", "text": "ポルノ鞭、炎を生成して、"}, {"type": "subtitle", "time": 6887.03, "timestamp": "01:54:47", "text": "指導を受けて、炎を生み出し、"}, {"type": "subtitle", "time": 6888.709, "timestamp": "01:54:48", "text": "右？ライト。うん。わかった。うん。ここに"}, {"type": "subtitle", "time": 6891.03, "timestamp": "01:54:51", "text": "ここからでも見えますよ。選ぶことができます"}, {"type": "subtitle", "time": 6894.31, "timestamp": "01:54:54", "text": "もう一つ、それは"}, {"type": "subtitle", "time": 6896.229, "timestamp": "01:54:56", "text": "ガイダンスからガイダンスを切り替えました"}, {"type": "subtitle", "time": 6899.27, "timestamp": "01:54:59", "text": "サブクラスから取得できるもの"}]
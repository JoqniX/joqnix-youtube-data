[{"type": "subtitle", "time": 6243.03, "timestamp": "01:44:03", "text": "すごく素晴らしいというわけではない。えっと"}, {"type": "subtitle", "time": 6245.59, "timestamp": "01:44:05", "text": "そうねぇ。抵抗は良い"}, {"type": "subtitle", "time": 6248.95, "timestamp": "01:44:08", "text": "もしそれがあなたの"}, {"type": "subtitle", "time": 6252.31, "timestamp": "01:44:12", "text": "探している。えっと、"}, {"type": "subtitle", "time": 6255.27, "timestamp": "01:44:15", "text": "修繕は一般的に多くの点で良い"}, {"type": "subtitle", "time": 6257.03, "timestamp": "01:44:17", "text": "物事について。物事を直せる"}, {"type": "subtitle", "time": 6259.669, "timestamp": "01:44:19", "text": "呪文で物事を好きになれない"}, {"type": "subtitle", "time": 6261.59, "timestamp": "01:44:21", "text": "壊さないで。えっと、"}, {"type": "subtitle", "time": 6264.629, "timestamp": "01:44:24", "text": "ああ、あなたのものが壊れたんですね。"}, {"type": "subtitle", "time": 6267.189, "timestamp": "01:44:27", "text": "いや、そうでもないけど、どちらかというと"}, {"type": "subtitle", "time": 6269.83, "timestamp": "01:44:29", "text": "面白いことがたくさんある"}, {"type": "subtitle", "time": 6273.03, "timestamp": "01:44:33", "text": "修繕に使用します。えっと、ちょっと"}, {"type": "subtitle", "time": 6274.87, "timestamp": "01:44:34", "text": "説明するのは難しいですが、"}, {"type": "subtitle", "time": 6277.51, "timestamp": "01:44:37", "text": "例えば、良い例として"}, {"type": "subtitle", "time": 6280.95, "timestamp": "01:44:40", "text": "昔の話だけど、"}, {"type": "subtitle", "time": 6282.79, "timestamp": "01:44:42", "text": "数週間前、私がプレイしていたとき"}, {"type": "subtitle", "time": 6285.03, "timestamp": "01:44:45", "text": "別のグループだった私は選手だった"}, {"type": "subtitle", "time": 6287.91, "timestamp": "01:44:47", "text": "修復が必要だった私たちは"}, {"type": "subtitle", "time": 6290.709, "timestamp": "01:44:50", "text": "墓地を調査するようなものだ。"}, {"type": "subtitle", "time": 6294.47, "timestamp": "01:44:54", "text": "それで、えーと、私たちの計画は、私の友人が使っていたようなものでした"}, {"type": "subtitle", "time": 6296.87, "timestamp": "01:44:56", "text": "運動能力でロックを解除し、そして一度"}, {"type": "subtitle", "time": 6298.229, "timestamp": "01:44:58", "text": "私たちは今やっていることをすべて終えました"}]
[{"type": "subtitle", "time": 3841.829, "timestamp": "01:04:01", "text": "うん。うん。それはまるであなたがすべてを手に入れるようなものです"}, {"type": "subtitle", "time": 3843.19, "timestamp": "01:04:03", "text": "3人。持続する。実際、一度も"}, {"type": "subtitle", "time": 3844.95, "timestamp": "01:04:04", "text": "心。なんてこった。あなたはそのうちの1つを受け取ります。あなた"}, {"type": "subtitle", "time": 3846.95, "timestamp": "01:04:06", "text": "どちらか一つを選ばなければならない。例えば"}, {"type": "subtitle", "time": 3850.15, "timestamp": "01:04:10", "text": "スペルだよ、わかるだろ。"}, {"type": "subtitle", "time": 3852.069, "timestamp": "01:04:12", "text": "だから、どちらかを選ぶか、"}, {"type": "subtitle", "time": 3853.99, "timestamp": "01:04:13", "text": "踊る光、光、または神聖なものを選んでください"}, {"type": "subtitle", "time": 3856.39, "timestamp": "01:04:16", "text": "炎。"}, {"type": "subtitle", "time": 3858.15, "timestamp": "01:04:18", "text": "おお、"}, {"type": "subtitle", "time": 3858.87, "timestamp": "01:04:18", "text": "それから"}, {"type": "subtitle", "time": 3860.87, "timestamp": "01:04:20", "text": "それらはすべて呪文です。与えるべき"}, {"type": "subtitle", "time": 3862.789, "timestamp": "01:04:22", "text": "呪文に関する情報のように"}, {"type": "subtitle", "time": 3871.91, "timestamp": "01:04:31", "text": "わかった。"}, {"type": "subtitle", "time": 3879.109, "timestamp": "01:04:39", "text": "あ、待って。私は待っています。私はドロイドです。それで、"}, {"type": "subtitle", "time": 3881.029, "timestamp": "01:04:41", "text": "待って。ここにはドロイドはいません。"}, {"type": "subtitle", "time": 3882.23, "timestamp": "01:04:42", "text": "いいえ、心配しないでください。うん、"}, {"type": "subtitle", "time": 3884.15, "timestamp": "01:04:44", "text": "これはあなたの授業範囲外です"}, {"type": "subtitle", "time": 3885.75, "timestamp": "01:04:45", "text": "呪文。"}, {"type": "subtitle", "time": 3887.029, "timestamp": "01:04:47", "text": "むしろ、実際にはもっと良い"}, {"type": "subtitle", "time": 3889.51, "timestamp": "01:04:49", "text": "もしあなたが自分の外にあるものを選ぶなら"}, {"type": "subtitle", "time": 3891.029, "timestamp": "01:04:51", "text": "クラスにアクセスできないため"}, {"type": "subtitle", "time": 3893.829, "timestamp": "01:04:53", "text": "これらは、外にある呪文です。"}, {"type": "subtitle", "time": 3897.029, "timestamp": "01:04:57", "text": "ドルイド以外。つまり、"}, {"type": "subtitle", "time": 3898.63, "timestamp": "01:04:58", "text": "ドルイド。"}]
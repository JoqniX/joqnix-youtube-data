[{"type": "subtitle", "time": 1622.07, "timestamp": "00:27:02", "text": "遊ぶ。魔法使いと魔術師は別物だ。"}, {"type": "subtitle", "time": 1622.789, "timestamp": "00:27:02", "text": "おお"}, {"type": "subtitle", "time": 1625.99, "timestamp": "00:27:05", "text": "ええ、本当に違いますね。"}, {"type": "subtitle", "time": 1628.31, "timestamp": "00:27:08", "text": "両者は全く異なる。"}, {"type": "subtitle", "time": 1630.39, "timestamp": "00:27:10", "text": "ウィザードは、"}, {"type": "subtitle", "time": 1632.789, "timestamp": "00:27:12", "text": "魔術師たち。ああ、でも彼らはたくさん"}, {"type": "subtitle", "time": 1634.789, "timestamp": "00:27:14", "text": "プレイするのがより複雑になるのは、"}, {"type": "subtitle", "time": 1643.269, "timestamp": "00:27:23", "text": "おお。わかった。ああ、ブラッドハンターと"}, {"type": "subtitle", "time": 1645.269, "timestamp": "00:27:25", "text": "もの。おお。"}, {"type": "subtitle", "time": 1647.669, "timestamp": "00:27:27", "text": "そうそう。それは、ああ、"}, {"type": "subtitle", "time": 1649.43, "timestamp": "00:27:29", "text": "うん。ちょっと質問させてください。あなたは"}, {"type": "subtitle", "time": 1652.149, "timestamp": "00:27:32", "text": "テーブルトークRPGに詳しいですか？"}, {"type": "subtitle", "time": 1654.39, "timestamp": "00:27:34", "text": "テーブルトークRPG？"}, {"type": "subtitle", "time": 1656.149, "timestamp": "00:27:36", "text": "えっと、"}, {"type": "subtitle", "time": 1660.23, "timestamp": "00:27:40", "text": "私はロストダークを一度プレイしたことがある。"}, {"type": "subtitle", "time": 1661.19, "timestamp": "00:27:41", "text": "何をプレイしたの？"}, {"type": "subtitle", "time": 1664.87, "timestamp": "00:27:44", "text": "ロストアーク。それはテーブルトップ版のMMO（大規模多人数同時参加型オンラインゲーム）のようなものだ。"}, {"type": "subtitle", "time": 1668.47, "timestamp": "00:27:48", "text": "そんな話は聞いたことがない。おお、興味深い。"}, {"type": "subtitle", "time": 1671.269, "timestamp": "00:27:51", "text": "えっと、テーブルトップではないですね。まるでトップダウン方式だ。"}, {"type": "subtitle", "time": 1672.23, "timestamp": "00:27:52", "text": "うん。"}, {"type": "subtitle", "time": 1675.51, "timestamp": "00:27:55", "text": "おお。ああ、私は本当に"}, {"type": "subtitle", "time": 1677.269, "timestamp": "00:27:57", "text": "ボードゲームとか、そういうの知ってるでしょ。"}, {"type": "subtitle", "time": 1679.269, "timestamp": "00:27:59", "text": "ああ、ボードゲーム。いや、いや、いや。"}]
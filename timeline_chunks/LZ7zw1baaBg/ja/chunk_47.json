[{"type": "subtitle", "time": 2820.15, "timestamp": "00:47:00", "text": "えっと、使用できるかどうかもう一度確認させてください"}, {"type": "subtitle", "time": 2821.99, "timestamp": "00:47:01", "text": "それですが、あなたが持っているかどうか確認させてください"}, {"type": "subtitle", "time": 2826.15, "timestamp": "00:47:06", "text": "彼女はそれに取り組むことができるだろうか？そうねぇ。えっと"}, {"type": "subtitle", "time": 2828.55, "timestamp": "00:47:08", "text": "ああ、わかった。いいえ。わかりました。でも、そうだね、君は"}, {"type": "subtitle", "time": 2831.99, "timestamp": "00:47:11", "text": "弓矢を使うことができます。ちょっと待ってください。"}, {"type": "subtitle", "time": 2835.27, "timestamp": "00:47:15", "text": "乗組員のストライキが発生するかどうか確認してみましょう。"}, {"type": "subtitle", "time": 2841.99, "timestamp": "00:47:21", "text": "ストライク。それは本当に効果があるのですか？いいえ。"}, {"type": "subtitle", "time": 2843.91, "timestamp": "00:47:23", "text": "わかった。よし。そう、できるよ"}, {"type": "subtitle", "time": 2846.87, "timestamp": "00:47:26", "text": "それ。えっと、弓を使いたい場合は、"}, {"type": "subtitle", "time": 2848.79, "timestamp": "00:47:28", "text": "高い器用さが欲しい"}, {"type": "subtitle", "time": 2851.51, "timestamp": "00:47:31", "text": "なぜなら、器用さが使われるのは、"}, {"type": "subtitle", "time": 2854.95, "timestamp": "00:47:34", "text": "遠距離武器の能力値。"}, {"type": "subtitle", "time": 2859.91, "timestamp": "00:47:39", "text": "わかった。"}, {"type": "subtitle", "time": 2864.71, "timestamp": "00:47:44", "text": "これはどうでしょう？筋力を高める。"}, {"type": "subtitle", "time": 2871.03, "timestamp": "00:47:51", "text": "少しね。憲法。私はそれを置いた"}, {"type": "subtitle", "time": 2872.95, "timestamp": "00:47:52", "text": "うん、その通り。"}, {"type": "subtitle", "time": 2877.19, "timestamp": "00:47:57", "text": "わかった。よし。私にこんなことをさせてください"}, {"type": "subtitle", "time": 2879.75, "timestamp": "00:47:59", "text": "これでできることは"}]
[{"type": "subtitle", "time": 9000.79, "timestamp": "02:30:00", "text": "トークンを取り出し、スペースバーを押します。"}, {"type": "subtitle", "time": 9001.99, "timestamp": "02:30:01", "text": "測定している間、"}, {"type": "subtitle", "time": 9003.91, "timestamp": "02:30:03", "text": "トークンをそこに移動してください。それは"}, {"type": "subtitle", "time": 9005.75, "timestamp": "02:30:05", "text": "通常は重要なので"}, {"type": "subtitle", "time": 9007.99, "timestamp": "02:30:07", "text": "30フィートだけ移動する。"}, {"type": "subtitle", "time": 9009.99, "timestamp": "02:30:09", "text": "ああ、そういうこともあるんですね。"}, {"type": "subtitle", "time": 9011.429, "timestamp": "02:30:11", "text": "うん。うん。そう、もしあなたが"}, {"type": "subtitle", "time": 9013.19, "timestamp": "02:30:13", "text": "移動、トークンのクリア、測定、"}, {"type": "subtitle", "time": 9015.67, "timestamp": "02:30:15", "text": "次にスペースバーを押して実行します"}, {"type": "subtitle", "time": 9023.11, "timestamp": "02:30:23", "text": "わあ、すごくかっこいいですね。"}, {"type": "subtitle", "time": 9024.63, "timestamp": "02:30:24", "text": "わかった。"}, {"type": "subtitle", "time": 9027.429, "timestamp": "02:30:27", "text": "ええ、そうですね。ええと、それがムーブメントです。そして"}, {"type": "subtitle", "time": 9032.07, "timestamp": "02:30:32", "text": "では、他に何かありますか？"}, {"type": "subtitle", "time": 9033.11, "timestamp": "02:30:33", "text": "好きになる必要がある。"}, {"type": "subtitle", "time": 9035.349, "timestamp": "02:30:35", "text": "これは馬ですか？"}, {"type": "subtitle", "time": 9037.03, "timestamp": "02:30:37", "text": "うん、"}, {"type": "subtitle", "time": 9039.51, "timestamp": "02:30:39", "text": "至る所に馬がたくさんいる。"}, {"type": "subtitle", "time": 9040.63, "timestamp": "02:30:40", "text": "それはNPCです。"}, {"type": "subtitle", "time": 9042.71, "timestamp": "02:30:42", "text": "なぜなら多くの人が購入しているから"}, {"type": "subtitle", "time": 9045.99, "timestamp": "02:30:45", "text": "馬。理由がわからない。"}, {"type": "subtitle", "time": 9049.19, "timestamp": "02:30:49", "text": "全部で1から4個あります"}, {"type": "subtitle", "time": 9051.75, "timestamp": "02:30:51", "text": "現在ポニーがいて、1頭は大きく裂けている"}, {"type": "subtitle", "time": 9053.67, "timestamp": "02:30:53", "text": "人々は何らかの理由でそれを購入した。"}, {"type": "subtitle", "time": 9056.15, "timestamp": "02:30:56", "text": "でも、ここが一番近い部屋なんです。"}, {"type": "subtitle", "time": 9057.349, "timestamp": "02:30:57", "text": "のように"}]
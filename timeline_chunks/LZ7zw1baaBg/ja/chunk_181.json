[{"type": "subtitle", "time": 10860.07, "timestamp": "03:01:00", "text": "わかった。短い弓の方が良い。"}, {"type": "subtitle", "time": 10862.07, "timestamp": "03:01:02", "text": "どちらを選ぶかはあなた次第です"}, {"type": "subtitle", "time": 10863.59, "timestamp": "03:01:03", "text": "選ぶ。"}, {"type": "subtitle", "time": 10867.429, "timestamp": "03:01:07", "text": "より遠距離からの攻撃。光はどうですか？"}, {"type": "subtitle", "time": 10869.19, "timestamp": "03:01:09", "text": "クロスボウ？"}, {"type": "subtitle", "time": 10870.95, "timestamp": "03:01:10", "text": "えっと"}, {"type": "subtitle", "time": 10873.75, "timestamp": "03:01:13", "text": "わかった。長時間だと長距離射撃はできません。"}, {"type": "subtitle", "time": 10876.469, "timestamp": "03:01:16", "text": "わかった。短いボールの方が良いですよね？待って。"}, {"type": "subtitle", "time": 10878.309, "timestamp": "03:01:18", "text": "えっと、"}, {"type": "subtitle", "time": 10881.349, "timestamp": "03:01:21", "text": "背の低い男の子は、えーと、矢が1本あるような感じで、"}, {"type": "subtitle", "time": 10884.95, "timestamp": "03:01:24", "text": "右？つまり、ライトクロスボウは"}, {"type": "subtitle", "time": 10887.51, "timestamp": "03:01:27", "text": "ライトクロスボウは3つか2つくらい"}, {"type": "subtitle", "time": 10888.15, "timestamp": "03:01:28", "text": "おそらく。"}, {"type": "subtitle", "time": 10889.83, "timestamp": "03:01:29", "text": "いや、違うよ。軽量クロスボウはボルトを使用する"}, {"type": "subtitle", "time": 10891.429, "timestamp": "03:01:31", "text": "その代わり。矢印があって、"}, {"type": "subtitle", "time": 10893.83, "timestamp": "03:01:33", "text": "ボルト。クロスボウはクロスボウ用の矢を使用します。"}, {"type": "subtitle", "time": 10896.79, "timestamp": "03:01:36", "text": "短弓は矢を使う。"}, {"type": "subtitle", "time": 10897.67, "timestamp": "03:01:37", "text": "待って、ボルトって何？"}, {"type": "subtitle", "time": 10900.71, "timestamp": "03:01:40", "text": "異なる弾薬。ボルトは"}, {"type": "subtitle", "time": 10901.99, "timestamp": "03:01:41", "text": "使用する矢印の種類"}, {"type": "subtitle", "time": 10903.67, "timestamp": "03:01:43", "text": "クロスボウ。"}, {"type": "subtitle", "time": 10903.99, "timestamp": "03:01:43", "text": "わかった。"}, {"type": "subtitle", "time": 10911.83, "timestamp": "03:01:51", "text": "必要であれば、Googleで検索しても構いません。それは、えーと"}, {"type": "subtitle", "time": 10914.79, "timestamp": "03:01:54", "text": "それはただ、それがどのように"}, {"type": "subtitle", "time": 10915.99, "timestamp": "03:01:55", "text": "どうやらそうみたいだ。"}, {"type": "subtitle", "time": 10918.87, "timestamp": "03:01:58", "text": "よし、これは短くまとめることにしよう。そして"}]
[{"type": "subtitle", "time": 12300.78, "timestamp": "03:25:00", "text": "Twitterにはたくさんの情報がある。"}, {"type": "subtitle", "time": 12315.59, "timestamp": "03:25:15", "text": "うん。さよなら。"}, {"type": "subtitle", "time": 12318.229, "timestamp": "03:25:18", "text": "H. 昨日は予定がぎっしり詰まっていました。私は"}, {"type": "subtitle", "time": 12329.67, "timestamp": "03:25:29", "text": "わかった。日本のもの。ブックマークしておきます"}, {"type": "subtitle", "time": 12332.79, "timestamp": "03:25:32", "text": "これ。わかった。あのアニメですよね？えっと"}, {"type": "subtitle", "time": 12335.429, "timestamp": "03:25:35", "text": "ミステリーファンタジー。中国人であることを忘れていた"}, {"type": "subtitle", "time": 12337.19, "timestamp": "03:25:37", "text": "1つ。"}, {"type": "subtitle", "time": 12340.87, "timestamp": "03:25:40", "text": "うん、良かったよ。"}, {"type": "subtitle", "time": 12343.19, "timestamp": "03:25:43", "text": "もっとTwitterを活用しないといけないな。そして"}, {"type": "subtitle", "time": 12347.11, "timestamp": "03:25:47", "text": "また、私はそうすべきだと思う、"}]
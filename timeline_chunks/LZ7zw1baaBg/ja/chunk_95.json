[{"type": "subtitle", "time": 5701.35, "timestamp": "01:35:01", "text": "よし。ええと、わかりました。だから、この取引では"}, {"type": "subtitle", "time": 5704.39, "timestamp": "01:35:04", "text": "それを確定させてください。"}, {"type": "subtitle", "time": 5707.83, "timestamp": "01:35:07", "text": "わかった。 「OK」をクリックします。よし。えっと、私は"}, {"type": "subtitle", "time": 5708.709, "timestamp": "01:35:08", "text": "それは完了させないつもりだ。"}, {"type": "subtitle", "time": 5711.35, "timestamp": "01:35:11", "text": "これは、"}, {"type": "subtitle", "time": 5713.11, "timestamp": "01:35:13", "text": "オールラウンダークラス。私は武器を使うことができます、"}, {"type": "subtitle", "time": 5714.149, "timestamp": "01:35:14", "text": "右？"}, {"type": "subtitle", "time": 5716.31, "timestamp": "01:35:16", "text": "ええ、そうですね。ええ、武器を使っても構いませんよ。えっと"}, {"type": "subtitle", "time": 5718.55, "timestamp": "01:35:18", "text": "よし。わかった。これにより、"}, {"type": "subtitle", "time": 5721.99, "timestamp": "01:35:21", "text": "後であなたのプレイスタイルについてお話しします。これは"}, {"type": "subtitle", "time": 5724.229, "timestamp": "01:35:24", "text": "あなたの根源的な秩序。あなたは＿＿したいですか"}, {"type": "subtitle", "time": 5726.229, "timestamp": "01:35:26", "text": "まるで魔法使いか魔法使いか"}, {"type": "subtitle", "time": 5728.31, "timestamp": "01:35:28", "text": "看守？マジシャン。マジシャンは"}, {"type": "subtitle", "time": 5730.95, "timestamp": "01:35:30", "text": "呪文をもっとたくさん覚えられるよ"}, {"type": "subtitle", "time": 5734.229, "timestamp": "01:35:34", "text": "そして、ええ、あなたはもっと多くのことを知っている"}, {"type": "subtitle", "time": 5735.99, "timestamp": "01:35:35", "text": "呪文と水は、あなたが使用できることを意味します"}, {"type": "subtitle", "time": 5737.189, "timestamp": "01:35:37", "text": "マーシャル兵器は、"}, {"type": "subtitle", "time": 5739.51, "timestamp": "01:35:39", "text": "先進的な武器と中装甲"}, {"type": "subtitle", "time": 5741.99, "timestamp": "01:35:41", "text": "は、鎧の一種です"}, {"type": "subtitle", "time": 5744.229, "timestamp": "01:35:44", "text": "それは少し強いですね、なぜなら今あなたは"}, {"type": "subtitle", "time": 5747.11, "timestamp": "01:35:47", "text": "軽装甲しか使用できない。"}, {"type": "subtitle", "time": 5749.43, "timestamp": "01:35:49", "text": "待って、なぜ弓兵や他の人がいないのか"}, {"type": "subtitle", "time": 5751.51, "timestamp": "01:35:51", "text": "クラス？"}, {"type": "subtitle", "time": 5752.31, "timestamp": "01:35:52", "text": "すみません、何ですか？"}, {"type": "subtitle", "time": 5754.709, "timestamp": "01:35:54", "text": "弓兵や他の装備がないのはなぜですか"}, {"type": "subtitle", "time": 5757.35, "timestamp": "01:35:57", "text": "ここ？なんてこった。これはまさにあなたの好みです"}]
[{"type": "subtitle", "time": 3241.99, "timestamp": "00:54:01", "text": "ゲームを仕切る者。えっと、でも私は"}, {"type": "subtitle", "time": 3245.589, "timestamp": "00:54:05", "text": "他の人が何を言っているのかは理解できます。"}, {"type": "subtitle", "time": 3248.39, "timestamp": "00:54:08", "text": "それで、えっと、もう一度確認させてください。"}, {"type": "subtitle", "time": 3252.549, "timestamp": "00:54:12", "text": "人間のパラディンを手に入れた。人間を手に入れた"}, {"type": "subtitle", "time": 3256.549, "timestamp": "00:54:16", "text": "ええと、聖職者。タバコを吸う悪党を手に入れた。私たちは"}, {"type": "subtitle", "time": 3259.589, "timestamp": "00:54:19", "text": "亀の聖職者。ゴブリンが来た"}, {"type": "subtitle", "time": 3264.39, "timestamp": "00:54:24", "text": "魔法使い。人間の戦士。エルフの魔術師"}, {"type": "subtitle", "time": 3267.51, "timestamp": "00:54:27", "text": "アンディ・バーバリアン。"}, {"type": "subtitle", "time": 3273.589, "timestamp": "00:54:33", "text": "くそ。"}, {"type": "subtitle", "time": 3275.829, "timestamp": "00:54:35", "text": "たくさんのこと。わかった。"}, {"type": "subtitle", "time": 3277.829, "timestamp": "00:54:37", "text": "ええ、確かに多いですね。"}, {"type": "subtitle", "time": 3278.15, "timestamp": "00:54:38", "text": "うん。"}, {"type": "subtitle", "time": 3280.23, "timestamp": "00:54:40", "text": "もし本当にわからないなら、ただ感じてみて"}, {"type": "subtitle", "time": 3282.15, "timestamp": "00:54:42", "text": "好きなものを選んでください"}, {"type": "subtitle", "time": 3284.309, "timestamp": "00:54:44", "text": "一つは一番かっこよく聞こえる。それもまた"}, {"type": "subtitle", "time": 3285.91, "timestamp": "00:54:45", "text": "作品。"}, {"type": "subtitle", "time": 3288.309, "timestamp": "00:54:48", "text": "そして2番目"}, {"type": "subtitle", "time": 3296.87, "timestamp": "00:54:56", "text": "わかった。だから、それぞれ、ええ、これは"}]
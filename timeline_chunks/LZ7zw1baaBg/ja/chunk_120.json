[{"type": "subtitle", "time": 7200.87, "timestamp": "02:00:00", "text": "憲法ですよね？いいえ、違います"}, {"type": "subtitle", "time": 7202.709, "timestamp": "02:00:02", "text": "憲法。つまずく可能性がある。"}, {"type": "subtitle", "time": 7205.75, "timestamp": "02:00:05", "text": "また別のキャンリップ。うん。"}, {"type": "subtitle", "time": 7207.91, "timestamp": "02:00:07", "text": "えっと、"}, {"type": "subtitle", "time": 7211.5, "timestamp": "02:00:11", "text": "レベル4です。"}, {"type": "subtitle", "time": 7217.51, "timestamp": "02:00:17", "text": "魔法の石は存在するのか？いや、そうじゃないよ。"}, {"type": "subtitle", "time": 7218.31, "timestamp": "02:00:18", "text": "そうそう。魔法がある"}, {"type": "subtitle", "time": 7219.99, "timestamp": "02:00:19", "text": "ここに石があります。ええ、魔法の石があります"}, {"type": "subtitle", "time": 7223.189, "timestamp": "02:00:23", "text": "ここ。これは何ですか？"}, {"type": "subtitle", "time": 7223.589, "timestamp": "02:00:23", "text": "えっと、"}, {"type": "subtitle", "time": 7227.189, "timestamp": "02:00:27", "text": "魔法石は、ええと、純粋にダメージを与えるものです"}, {"type": "subtitle", "time": 7229.27, "timestamp": "02:00:29", "text": "キャントリップを扱っているが、それはまた、"}, {"type": "subtitle", "time": 7231.189, "timestamp": "02:00:31", "text": "実際かなり良いです"}, {"type": "subtitle", "time": 7233.27, "timestamp": "02:00:33", "text": "実際に呪文詠唱修正値を加える"}, {"type": "subtitle", "time": 7235.91, "timestamp": "02:00:35", "text": "それに対して。"}, {"type": "subtitle", "time": 7239.43, "timestamp": "02:00:39", "text": "ああ、これで私にとってはもっといいんじゃない？"}, {"type": "subtitle", "time": 7241.43, "timestamp": "02:00:41", "text": "えっと、どういう意味ですか？"}, {"type": "subtitle", "time": 7244.229, "timestamp": "02:00:44", "text": "私の統計では、私のほうが有利ではないでしょうか。"}, {"type": "subtitle", "time": 7245.669, "timestamp": "02:00:45", "text": "すべて？"}, {"type": "subtitle", "time": 7248.07, "timestamp": "02:00:48", "text": "えっと、それは"}, {"type": "subtitle", "time": 7249.91, "timestamp": "02:00:49", "text": "必ずしも優れているとは限らない。"}, {"type": "subtitle", "time": 7252.629, "timestamp": "02:00:52", "text": "どちらかというとキャンプ旅行のようなもので"}, {"type": "subtitle", "time": 7255.03, "timestamp": "02:00:55", "text": "ダメージを与えることに集中してください。その"}, {"type": "subtitle", "time": 7257.91, "timestamp": "02:00:57", "text": "純粋にダメージを与えるため。"}]
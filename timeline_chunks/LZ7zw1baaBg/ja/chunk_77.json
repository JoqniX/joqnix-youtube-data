[{"type": "subtitle", "time": 4621.83, "timestamp": "01:17:01", "text": "本当の理由がわかる。えっと、ちょっと確認させてください。"}, {"type": "subtitle", "time": 4624.31, "timestamp": "01:17:04", "text": "広告ブロッカーが原因ですか？"}, {"type": "subtitle", "time": 4626.63, "timestamp": "01:17:06", "text": "ああ、くそ。えっと、そうあるべきだと思うんだけど"}, {"type": "subtitle", "time": 4628.79, "timestamp": "01:17:08", "text": "そんなことをしてはいけない。インポートするだけでよい"}, {"type": "subtitle", "time": 4630.149, "timestamp": "01:17:10", "text": "通常はそうです。正直よくわからない"}, {"type": "subtitle", "time": 4632.149, "timestamp": "01:17:12", "text": "なぜそうではないのか"}, {"type": "subtitle", "time": 4634.39, "timestamp": "01:17:14", "text": "それを自動的に行います。それは"}, {"type": "subtitle", "time": 4636.31, "timestamp": "01:17:16", "text": "ちょっと変だ。"}, {"type": "subtitle", "time": 4639.43, "timestamp": "01:17:19", "text": "いいよ、できるよ、できるよ、できるよ"}, {"type": "subtitle", "time": 4642.87, "timestamp": "01:17:22", "text": "えっと、それを再インポートできますよ。"}, {"type": "subtitle", "time": 4644.63, "timestamp": "01:17:24", "text": "あなたが望むなら。それは何だったのか"}, {"type": "subtitle", "time": 4648.55, "timestamp": "01:17:28", "text": "また？えっと、何のワンダーだったっけ？"}, {"type": "subtitle", "time": 4650.31, "timestamp": "01:17:30", "text": "えーっと"}, {"type": "subtitle", "time": 4652.229, "timestamp": "01:17:32", "text": "スパークトラベラー。いいえ、申し訳ありません。遠方の旅人。"}, {"type": "subtitle", "time": 4653.99, "timestamp": "01:17:33", "text": "ああ、遠い旅人よ。"}, {"type": "subtitle", "time": 4656.149, "timestamp": "01:17:36", "text": "はい、それをインポートさせてください"}, {"type": "subtitle", "time": 4659.35, "timestamp": "01:17:39", "text": "あなたのために。えっと、それは竜のような"}, {"type": "subtitle", "time": 4663.59, "timestamp": "01:17:43", "text": "楽器を演奏して、それから、"}, {"type": "subtitle", "time": 4665.35, "timestamp": "01:17:45", "text": "これ。はい、どうぞ。よし。"}, {"type": "subtitle", "time": 4668.229, "timestamp": "01:17:48", "text": "うん。理由はよくわからない。ああ、わかった。よし。"}, {"type": "subtitle", "time": 4670.229, "timestamp": "01:17:50", "text": "画面を共有して、"}, {"type": "subtitle", "time": 4671.669, "timestamp": "01:17:51", "text": "これを見てください、これはあなたが"}, {"type": "subtitle", "time": 4674.229, "timestamp": "01:17:54", "text": "選ぶ必要がある。えっと、"}, {"type": "subtitle", "time": 4675.189, "timestamp": "01:17:55", "text": "わかった。"}, {"type": "subtitle", "time": 4677.99, "timestamp": "01:17:57", "text": "ちょっと待ってください。全く違う。私"}, {"type": "subtitle", "time": 4679.99, "timestamp": "01:17:59", "text": "待って、正しいことを共有したかな"}]
[{"type": "subtitle", "time": 6900.47, "timestamp": "01:55:00", "text": "特徴。"}, {"type": "subtitle", "time": 6903.51, "timestamp": "01:55:03", "text": "わあ、すごい。"}, {"type": "subtitle", "time": 6905.99, "timestamp": "01:55:05", "text": "何か考えていることはありますか？"}, {"type": "subtitle", "time": 6907.83, "timestamp": "01:55:07", "text": "おお"}, {"type": "subtitle", "time": 6913.589, "timestamp": "01:55:13", "text": "[音楽]"}, {"type": "subtitle", "time": 6917.51, "timestamp": "01:55:17", "text": "えっと、メッセージって何をするんですか？メッセージ"}, {"type": "subtitle", "time": 6921.589, "timestamp": "01:55:21", "text": "静かに物に話しかける"}, {"type": "subtitle", "time": 6923.83, "timestamp": "01:55:23", "text": "人と話すことができるように"}, {"type": "subtitle", "time": 6925.75, "timestamp": "01:55:25", "text": "彼らの脳。"}, {"type": "subtitle", "time": 6928.55, "timestamp": "01:55:28", "text": "よし、私が彼らをコントロールする。"}, {"type": "subtitle", "time": 6930.79, "timestamp": "01:55:30", "text": "何？うん。うん。あなたもできる"}, {"type": "subtitle", "time": 6932.55, "timestamp": "01:55:32", "text": "それが誰であろうと、誰かを指摘する"}, {"type": "subtitle", "time": 6934.629, "timestamp": "01:55:34", "text": "友達や敵のように、"}, {"type": "subtitle", "time": 6936.229, "timestamp": "01:55:36", "text": "ささやくだけで"}, {"type": "subtitle", "time": 6953.43, "timestamp": "01:55:53", "text": "スプライトの場合はどうですか？"}, {"type": "subtitle", "time": 6954.229, "timestamp": "01:55:54", "text": "凍傷？"}, {"type": "subtitle", "time": 6956.55, "timestamp": "01:55:56", "text": "凍傷。凍傷は、"}]
[{"type": "subtitle", "time": 9180.23, "timestamp": "02:33:00", "text": "わかった。"}, {"type": "subtitle", "time": 9182.55, "timestamp": "02:33:02", "text": "そしてもう一方の手で、"}, {"type": "subtitle", "time": 9185.59, "timestamp": "02:33:05", "text": "何でも入れることができますが、一般的には"}, {"type": "subtitle", "time": 9187.11, "timestamp": "02:33:07", "text": "オフの時にシールドのように持っていると良い"}, {"type": "subtitle", "time": 9188.23, "timestamp": "02:33:08", "text": "手。もう片方。"}, {"type": "subtitle", "time": 9189.91, "timestamp": "02:33:09", "text": "えっと、2番目ですよね？"}, {"type": "subtitle", "time": 9191.429, "timestamp": "02:33:11", "text": "いや、それは違うよ。それは隣のものと似ています"}, {"type": "subtitle", "time": 9193.91, "timestamp": "02:33:13", "text": "ドルイドのフォーカスのすぐ隣です。"}, {"type": "subtitle", "time": 9195.59, "timestamp": "02:33:15", "text": "おお、"}, {"type": "subtitle", "time": 9196.79, "timestamp": "02:33:16", "text": "うん。はい、どうぞ。"}, {"type": "subtitle", "time": 9198.87, "timestamp": "02:33:18", "text": "つまり、これは"}, {"type": "subtitle", "time": 9200.63, "timestamp": "02:33:20", "text": "あなたはメインに焦点を合わせています"}, {"type": "subtitle", "time": 9204.87, "timestamp": "02:33:24", "text": "片手に盾、もう片方の手に盾を装備する。"}, {"type": "subtitle", "time": 9210.469, "timestamp": "02:33:30", "text": "わかった。よし。ええと、では見てみましょう。えっと"}, {"type": "subtitle", "time": 9213.99, "timestamp": "02:33:33", "text": "ええ、それがハンドセットアップだと思います。"}, {"type": "subtitle", "time": 9216.71, "timestamp": "02:33:36", "text": "その服を着る必要はありますか？えっと、君"}, {"type": "subtitle", "time": 9217.99, "timestamp": "02:33:37", "text": "あなたは既にそれを身につけている。見たら"}, {"type": "subtitle", "time": 9219.429, "timestamp": "02:33:39", "text": "横には盾のアイコンのようなものがあります。"}, {"type": "subtitle", "time": 9222.07, "timestamp": "02:33:42", "text": "それはあなたがそれを装備しているということです"}, {"type": "subtitle", "time": 9225.75, "timestamp": "02:33:45", "text": "商品の横に。まあ、そうですね。"}, {"type": "subtitle", "time": 9226.389, "timestamp": "02:33:46", "text": "わかった。わかった。"}, {"type": "subtitle", "time": 9229.349, "timestamp": "02:33:49", "text": "わかった。よし。それで"}, {"type": "subtitle", "time": 9231.91, "timestamp": "02:33:51", "text": "キット。"}, {"type": "subtitle", "time": 9234.15, "timestamp": "02:33:54", "text": "どこで既に戦利品を手に入れたの？"}, {"type": "subtitle", "time": 9235.349, "timestamp": "02:33:55", "text": "ええ、そうですね。うん。それはあなたの"}, {"type": "subtitle", "time": 9238.07, "timestamp": "02:33:58", "text": "背景。それがあなたの経歴です。"}, {"type": "subtitle", "time": 9239.27, "timestamp": "02:33:59", "text": "ああ、わかりました。わかった。"}]
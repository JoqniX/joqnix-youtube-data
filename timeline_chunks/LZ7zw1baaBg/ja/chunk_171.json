[{"type": "subtitle", "time": 10261.19, "timestamp": "02:51:01", "text": "ドルイド教徒が持っているものへと。"}, {"type": "subtitle", "time": 10263.349, "timestamp": "02:51:03", "text": "おお。"}, {"type": "subtitle", "time": 10266.71, "timestamp": "02:51:06", "text": "あ、待って。ごめん。ああ、できるよ"}, {"type": "subtitle", "time": 10267.83, "timestamp": "02:51:07", "text": "あなたがそうできるなら、"}, {"type": "subtitle", "time": 10268.309, "timestamp": "02:51:08", "text": "欲しい。"}, {"type": "subtitle", "time": 10268.87, "timestamp": "02:51:08", "text": "わかった。わかった。"}, {"type": "subtitle", "time": 10271.99, "timestamp": "02:51:11", "text": "でも、それはあなた次第です。"}, {"type": "subtitle", "time": 10272.71, "timestamp": "02:51:12", "text": "うん、"}, {"type": "subtitle", "time": 10275.11, "timestamp": "02:51:15", "text": "えーと、使いやすさのことですよね？"}, {"type": "subtitle", "time": 10277.19, "timestamp": "02:51:17", "text": "それは私のために攻撃してくれるのか、それとも私は"}, {"type": "subtitle", "time": 10277.67, "timestamp": "02:51:17", "text": "命令する？"}, {"type": "subtitle", "time": 10280.63, "timestamp": "02:51:20", "text": "いや、それは、それは、それは実際には"}, {"type": "subtitle", "time": 10282.71, "timestamp": "02:51:22", "text": "攻撃ではない。えっと、そう呼ぶんだっけ？"}, {"type": "subtitle", "time": 10284.469, "timestamp": "02:51:24", "text": "それは基本的にキャスティングファインドです"}, {"type": "subtitle", "time": 10287.03, "timestamp": "02:51:27", "text": "おなじみ。それはまるでペットのようなものです"}, {"type": "subtitle", "time": 10289.11, "timestamp": "02:51:29", "text": "つまりそういうことだ。ペットは実際には"}, {"type": "subtitle", "time": 10291.67, "timestamp": "02:51:31", "text": "攻撃。それはどちらかというと偵察ツールだ。"}, {"type": "subtitle", "time": 10295.269, "timestamp": "02:51:35", "text": "わかった、それならいいよ。"}, {"type": "subtitle", "time": 10298.52, "timestamp": "02:51:38", "text": "では、そうします"}, {"type": "subtitle", "time": 10301.349, "timestamp": "02:51:41", "text": "[音楽]"}, {"type": "subtitle", "time": 10319.99, "timestamp": "02:51:59", "text": "わかった。あのね？病気"}]
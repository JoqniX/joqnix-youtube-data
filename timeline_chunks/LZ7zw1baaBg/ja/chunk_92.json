[{"type": "subtitle", "time": 5520.55, "timestamp": "01:32:00", "text": "はい、"}, {"type": "subtitle", "time": 5522.39, "timestamp": "01:32:02", "text": "よし。必要な機材はこれだけです"}, {"type": "subtitle", "time": 5522.87, "timestamp": "01:32:02", "text": "1つ。"}, {"type": "subtitle", "time": 5524.07, "timestamp": "01:32:04", "text": "うん。うん。"}, {"type": "subtitle", "time": 5526.39, "timestamp": "01:32:06", "text": "わかった。よし。確認してみます。"}, {"type": "subtitle", "time": 5529.189, "timestamp": "01:32:09", "text": "わかった。さあ、あなたの呪文の時間です。まず、"}, {"type": "subtitle", "time": 5531.43, "timestamp": "01:32:11", "text": "あなたのキャンリップ。 2つのキャンリップを習得します"}, {"type": "subtitle", "time": 5533.669, "timestamp": "01:32:13", "text": "ドルイド。えっと、どれがいいですか？"}, {"type": "subtitle", "time": 5536.229, "timestamp": "01:32:16", "text": "学ぶ？以前に光について学んだので、"}, {"type": "subtitle", "time": 5541.03, "timestamp": "01:32:21", "text": "えーと、あなたは一般的に良い人だと思います"}, {"type": "subtitle", "time": 5542.39, "timestamp": "01:32:22", "text": "えっと、良い出発点だと思います"}, {"type": "subtitle", "time": 5544.87, "timestamp": "01:32:24", "text": "1 つのキャンリップを選ぶことになります"}, {"type": "subtitle", "time": 5547.11, "timestamp": "01:32:27", "text": "ダメージを与えるために使用し、1つは"}, {"type": "subtitle", "time": 5550.07, "timestamp": "01:32:30", "text": "ユーティリティのために使用します。遠慮なく"}, {"type": "subtitle", "time": 5552.149, "timestamp": "01:32:32", "text": "好きなものを選んでください"}, {"type": "subtitle", "time": 5554.79, "timestamp": "01:32:34", "text": "便利そうですね。"}, {"type": "subtitle", "time": 5557.99, "timestamp": "01:32:37", "text": "キャンリップって、能力みたいなものだよね？"}, {"type": "subtitle", "time": 5560.79, "timestamp": "01:32:40", "text": "キャンリップとは呪文のことである。まるで魔法のようだ"}, {"type": "subtitle", "time": 5564.07, "timestamp": "01:32:44", "text": "無料で利用できるものです。"}, {"type": "subtitle", "time": 5565.91, "timestamp": "01:32:45", "text": "もしあなたが見たいなら"}, {"type": "subtitle", "time": 5567.669, "timestamp": "01:32:47", "text": "これの詳細については、"}, {"type": "subtitle", "time": 5569.51, "timestamp": "01:32:49", "text": "私があなたに教えたウェブサイト、またはあなたが気に入ることができる"}, {"type": "subtitle", "time": 5571.11, "timestamp": "01:32:51", "text": "クリックするように言ってくれれば、表示できます"}, {"type": "subtitle", "time": 5572.79, "timestamp": "01:32:52", "text": "ここでそれが何をするのか。"}, {"type": "subtitle", "time": 5575.59, "timestamp": "01:32:55", "text": "わかった。わかった。"}]
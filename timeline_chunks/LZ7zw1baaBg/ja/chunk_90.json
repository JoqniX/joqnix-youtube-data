[{"type": "subtitle", "time": 5401.35, "timestamp": "01:30:01", "text": "わかった。では、わかりました。だから、私たちは"}, {"type": "subtitle", "time": 5403.03, "timestamp": "01:30:03", "text": "サバイバルにおけるアルカナ。"}, {"type": "subtitle", "time": 5404.149, "timestamp": "01:30:04", "text": "うん。"}, {"type": "subtitle", "time": 5407.189, "timestamp": "01:30:07", "text": "よし。クリックしてみましょう。わかった。よし。"}, {"type": "subtitle", "time": 5409.11, "timestamp": "01:30:09", "text": "よし、これでいい。わかった。これがあなたのスタートです"}, {"type": "subtitle", "time": 5411.91, "timestamp": "01:30:11", "text": "装置。えっと、L。ただ"}, {"type": "subtitle", "time": 5415.11, "timestamp": "01:30:15", "text": "デフォルトのものを使うか、"}, {"type": "subtitle", "time": 5417.75, "timestamp": "01:30:17", "text": "金を手に入れて買いたい"}, {"type": "subtitle", "time": 5420.87, "timestamp": "01:30:20", "text": "自分でやるの？えっと"}, {"type": "subtitle", "time": 5422.55, "timestamp": "01:30:22", "text": "だって、もしあなたがそうしたいなら、私は"}, {"type": "subtitle", "time": 5424.47, "timestamp": "01:30:24", "text": "その方法を説明します。"}, {"type": "subtitle", "time": 5426.629, "timestamp": "01:30:26", "text": "しかし、少し複雑になるかもしれません"}, {"type": "subtitle", "time": 5428.79, "timestamp": "01:30:28", "text": "知らないだろうけど、まるで店があるみたいだ"}, {"type": "subtitle", "time": 5430.07, "timestamp": "01:30:30", "text": "そして、たくさんの物が入っている。"}, {"type": "subtitle", "time": 5433.03, "timestamp": "01:30:33", "text": "何てことだ。"}, {"type": "subtitle", "time": 5435.669, "timestamp": "01:30:35", "text": "いくらですか？私、お金がないんだよね？"}, {"type": "subtitle", "time": 5437.189, "timestamp": "01:30:37", "text": "ええ、現在、あなたは"}, {"type": "subtitle", "time": 5438.95, "timestamp": "01:30:38", "text": "すべてを取るか、"}, {"type": "subtitle", "time": 5440.79, "timestamp": "01:30:40", "text": "こちらのこれらのものの上にこれを置く"}, {"type": "subtitle", "time": 5443.91, "timestamp": "01:30:43", "text": "そして9つのお金。はい、これは"}, {"type": "subtitle", "time": 5446.229, "timestamp": "01:30:46", "text": "無料。または、50だけ取ることもできます。"}, {"type": "subtitle", "time": 5448.79, "timestamp": "01:30:48", "text": "お金。どちらを感じるかによります"}, {"type": "subtitle", "time": 5453.62, "timestamp": "01:30:53", "text": "「like」の方が良いでしょう。どう思いますか？"}, {"type": "subtitle", "time": 5455.669, "timestamp": "01:30:55", "text": "[音楽]"}, {"type": "subtitle", "time": 5459.83, "timestamp": "01:30:59", "text": "わかった。木製の盾は持っていますか？"}]
[{"type": "subtitle", "time": 4443.03, "timestamp": "01:14:03", "text": "理由は分かりません。"}, {"type": "subtitle", "time": 4446.07, "timestamp": "01:14:06", "text": "わかった。わかった。えっと"}, {"type": "subtitle", "time": 4449.51, "timestamp": "01:14:09", "text": "わかった。だから、私はセレスティアルを持っています。"}, {"type": "subtitle", "time": 4454.39, "timestamp": "01:14:14", "text": "それはサルと一緒に行くことを示唆していた。"}, {"type": "subtitle", "time": 4457.669, "timestamp": "01:14:17", "text": "これはどう発音するのですか？シルヴィアン。シアン。"}, {"type": "subtitle", "time": 4461.27, "timestamp": "01:14:21", "text": "シルヴィアン、だって私はDの血を引いているから。"}, {"type": "subtitle", "time": 4463.03, "timestamp": "01:14:23", "text": "無料。"}, {"type": "subtitle", "time": 4464.27, "timestamp": "01:14:24", "text": "ご自由にどうぞ。"}, {"type": "subtitle", "time": 4466.55, "timestamp": "01:14:26", "text": "[音楽]"}, {"type": "subtitle", "time": 4471.83, "timestamp": "01:14:31", "text": "でも、なぜ？うん、ドルイドは"}, {"type": "subtitle", "time": 4474.709, "timestamp": "01:14:34", "text": "サブクラスですよね？クラス ドルイドは"}, {"type": "subtitle", "time": 4476.95, "timestamp": "01:14:36", "text": "クラス。ドルイドは実際に話す"}, {"type": "subtitle", "time": 4478.63, "timestamp": "01:14:38", "text": "ドルイド教的だが、実際にはそれを選ばない"}, {"type": "subtitle", "time": 4480.31, "timestamp": "01:14:40", "text": "それは、あなたがそれを自然に身につけるからです。手に入れる"}, {"type": "subtitle", "time": 4483.83, "timestamp": "01:14:43", "text": "後でドルイドを選べば、それは無料で手に入ります。"}, {"type": "subtitle", "time": 4485.75, "timestamp": "01:14:45", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 4488.149, "timestamp": "01:14:48", "text": "だから、私はエルフだから、彼らは"}, {"type": "subtitle", "time": 4491.03, "timestamp": "01:14:51", "text": "知る。わかった、"}, {"type": "subtitle", "time": 4493.27, "timestamp": "01:14:53", "text": "あまり心配しないでください。私 私"}, {"type": "subtitle", "time": 4494.87, "timestamp": "01:14:54", "text": "必要ないと思うなと言うだろう"}, {"type": "subtitle", "time": 4495.91, "timestamp": "01:14:55", "text": "言語について考えすぎる"}, {"type": "subtitle", "time": 4498.07, "timestamp": "01:14:58", "text": "熟練度。どちらでも構いません"}]
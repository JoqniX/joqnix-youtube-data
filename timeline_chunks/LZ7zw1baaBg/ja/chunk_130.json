[{"type": "subtitle", "time": 7801.91, "timestamp": "02:10:01", "text": "えっと、"}, {"type": "subtitle", "time": 7804.95, "timestamp": "02:10:04", "text": "ええと、引用符なし"}, {"type": "subtitle", "time": 7807.189, "timestamp": "02:10:07", "text": "キャスト"}, {"type": "subtitle", "time": 7810.069, "timestamp": "02:10:10", "text": "3 レベルの呪文を 2 回、2 レベルの呪文を 1 回"}, {"type": "subtitle", "time": 7812.47, "timestamp": "02:10:12", "text": "レベル呪文を３回、そして最初の"}, {"type": "subtitle", "time": 7818.87, "timestamp": "02:10:18", "text": "今すぐ。"}, {"type": "subtitle", "time": 7822.53, "timestamp": "02:10:22", "text": "あなたを現在のレベルまで引き上げます。"}, {"type": "subtitle", "time": 7835.43, "timestamp": "02:10:35", "text": "えっと、私の画面が見えてるの？"}, {"type": "subtitle", "time": 7837.99, "timestamp": "02:10:37", "text": "はぁ？ああ、もう画面共有はしていません。"}, {"type": "subtitle", "time": 7839.27, "timestamp": "02:10:39", "text": "でも、画面を共有することもできます。"}, {"type": "subtitle", "time": 7841.03, "timestamp": "02:10:41", "text": "なぜなら私はそれを終えたから"}, {"type": "subtitle", "time": 7843.35, "timestamp": "02:10:43", "text": "共有しません。レベルアップします。おお、"}, {"type": "subtitle", "time": 7845.589, "timestamp": "02:10:45", "text": "あなたは共有していない。うん。"}, {"type": "subtitle", "time": 7845.669, "timestamp": "02:10:45", "text": "する"}, {"type": "subtitle", "time": 7848.95, "timestamp": "02:10:48", "text": "またそれだ。わかった。"}, {"type": "subtitle", "time": 7851.109, "timestamp": "02:10:51", "text": "つまり、これらですよね？"}, {"type": "subtitle", "time": 7852.55, "timestamp": "02:10:52", "text": "うん。おお。ああ、レンチをカチカチと鳴らす"}, {"type": "subtitle", "time": 7853.99, "timestamp": "02:10:53", "text": "また。ところで、レンチのクリックを解除してください。"}, {"type": "subtitle", "time": 7856.55, "timestamp": "02:10:56", "text": "つまり、編集モードになっていないということですね。私は忘れていました"}, {"type": "subtitle", "time": 7858.87, "timestamp": "02:10:58", "text": "右上。ええ、もしあなたがそうでないなら"}]
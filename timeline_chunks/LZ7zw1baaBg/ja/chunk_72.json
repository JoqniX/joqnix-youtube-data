[{"type": "subtitle", "time": 4321.27, "timestamp": "01:12:01", "text": "旅行者にとってはどうでしょうか？それは"}, {"type": "subtitle", "time": 4345.35, "timestamp": "01:12:25", "text": "よし、遠方旅行者にしよう。"}, {"type": "subtitle", "time": 4347.669, "timestamp": "01:12:27", "text": "私はこの世に生まれてくる。"}, {"type": "subtitle", "time": 4349.189, "timestamp": "01:12:29", "text": "わかった、"}, {"type": "subtitle", "time": 4349.99, "timestamp": "01:12:29", "text": "無料。"}, {"type": "subtitle", "time": 4353.03, "timestamp": "01:12:33", "text": "こんにちは。私は選びます"}, {"type": "subtitle", "time": 4354.229, "timestamp": "01:12:34", "text": "輸入ですよね？"}, {"type": "subtitle", "time": 4356.39, "timestamp": "01:12:36", "text": "はい。"}, {"type": "subtitle", "time": 4358.87, "timestamp": "01:12:38", "text": "「はい」をクリックしてください。はい、もう1つあります"}, {"type": "subtitle", "time": 4362.149, "timestamp": "01:12:42", "text": "言語能力。そう、もしもしもし"}, {"type": "subtitle", "time": 4364.39, "timestamp": "01:12:44", "text": "チェックマークが付いている場合は、"}, {"type": "subtitle", "time": 4366.79, "timestamp": "01:12:46", "text": "あなたは既にそれを持っている。だから、そうしないように"}, {"type": "subtitle", "time": 4369.27, "timestamp": "01:12:49", "text": "それは、"}, {"type": "subtitle", "time": 4373.1, "timestamp": "01:12:53", "text": "それは無駄になるだろう。"}, {"type": "subtitle", "time": 4375.59, "timestamp": "01:12:55", "text": "[音楽]"}]
[{"type": "subtitle", "time": 5760.149, "timestamp": "01:36:00", "text": "例えば弓を使いたいとしましょう、"}, {"type": "subtitle", "time": 5762.07, "timestamp": "01:36:02", "text": "どちらでも弓を使うことができますが、"}, {"type": "subtitle", "time": 5764.39, "timestamp": "01:36:04", "text": "重い弓を使いたいなら、"}, {"type": "subtitle", "time": 5766.31, "timestamp": "01:36:06", "text": "マーシャル武器は必要ない"}, {"type": "subtitle", "time": 5768.629, "timestamp": "01:36:08", "text": "看守としての熟練度。これは"}, {"type": "subtitle", "time": 5771.35, "timestamp": "01:36:11", "text": "まさにこれと同じように、"}, {"type": "subtitle", "time": 5774.31, "timestamp": "01:36:14", "text": "君のプレイスタイルみたいなものかな。私にさせて"}, {"type": "subtitle", "time": 5775.83, "timestamp": "01:36:15", "text": "念のため、もう一度確認してください。私は両方とも"}, {"type": "subtitle", "time": 5778.79, "timestamp": "01:36:18", "text": "両方の弓は、えっと、何て言うんだっけ"}, {"type": "subtitle", "time": 5781.75, "timestamp": "01:36:21", "text": "また？ええと、シンプルな武器ですが、"}, {"type": "subtitle", "time": 5784.31, "timestamp": "01:36:24", "text": "もう一度確認してください。えっと"}, {"type": "subtitle", "time": 5787.27, "timestamp": "01:36:27", "text": "そうそう。わかった。だから、もしあなたが"}, {"type": "subtitle", "time": 5789.27, "timestamp": "01:36:29", "text": "短い弓を使うと、実際には"}, {"type": "subtitle", "time": 5791.03, "timestamp": "01:36:31", "text": "看守が必要だ。しかし、もしあなたが"}, {"type": "subtitle", "time": 5792.79, "timestamp": "01:36:32", "text": "長い弓、あなたには"}, {"type": "subtitle", "time": 5794.229, "timestamp": "01:36:34", "text": "看守。それはあなたが何を望んでいるかによります"}, {"type": "subtitle", "time": 5796.229, "timestamp": "01:36:36", "text": "使用。"}, {"type": "subtitle", "time": 5810.229, "timestamp": "01:36:50", "text": "えっと、私が魔法使いなら、私はできる"}, {"type": "subtitle", "time": 5814.149, "timestamp": "01:36:54", "text": "遠距離攻撃は弓のような感じですよね？"}, {"type": "subtitle", "time": 5816.149, "timestamp": "01:36:56", "text": "えっと、"}, {"type": "subtitle", "time": 5819.109, "timestamp": "01:36:59", "text": "いや、そうでもないけど、もっとこう"}]
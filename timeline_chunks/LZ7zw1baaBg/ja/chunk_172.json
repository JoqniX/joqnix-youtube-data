[{"type": "subtitle", "time": 10324.55, "timestamp": "02:52:04", "text": "30フィート。いや。ああ、動けない。"}, {"type": "subtitle", "time": 10328.15, "timestamp": "02:52:08", "text": "H わかった、少し動いてもいいけど"}, {"type": "subtitle", "time": 10332.309, "timestamp": "02:52:12", "text": "わかった。えーっと、何かから引っ越す"}, {"type": "subtitle", "time": 10335.51, "timestamp": "02:52:15", "text": "生物の射程範囲から移動する"}, {"type": "subtitle", "time": 10337.269, "timestamp": "02:52:17", "text": "機会と呼ばれるものを引き起こす"}, {"type": "subtitle", "time": 10341.429, "timestamp": "02:52:21", "text": "攻撃。それで、あなたはそうしたいですか？"}, {"type": "subtitle", "time": 10344.389, "timestamp": "02:52:24", "text": "引っ越したばかりで、タンを使いたかっただけなんです"}, {"type": "subtitle", "time": 10346.23, "timestamp": "02:52:26", "text": "彼に棘の鞭が下された。"}, {"type": "subtitle", "time": 10348.389, "timestamp": "02:52:28", "text": "わかった。よし。うん。わかった。その前に"}, {"type": "subtitle", "time": 10351.91, "timestamp": "02:52:31", "text": "なぜなら、相手の近接攻撃範囲から移動するからだ。"}, {"type": "subtitle", "time": 10354.15, "timestamp": "02:52:34", "text": "そうなると、彼らは選択することができる"}, {"type": "subtitle", "time": 10356.15, "timestamp": "02:52:36", "text": "いわゆる攻撃を行う"}, {"type": "subtitle", "time": 10357.99, "timestamp": "02:52:37", "text": "機会、あるいは機会攻撃。"}, {"type": "subtitle", "time": 10359.51, "timestamp": "02:52:39", "text": "だから、彼らはあなたが"}, {"type": "subtitle", "time": 10361.269, "timestamp": "02:52:41", "text": "立ち去る。だから、私はただ"}, {"type": "subtitle", "time": 10364.07, "timestamp": "02:52:44", "text": "それをすぐにお見せします"}, {"type": "subtitle", "time": 10366.79, "timestamp": "02:52:46", "text": "そんな感じ。それでは、見てみましょう。やろう"}, {"type": "subtitle", "time": 10369.75, "timestamp": "02:52:49", "text": "普通。それで、今回はこの男が転がった"}, {"type": "subtitle", "time": 10372.63, "timestamp": "02:52:52", "text": "12 はエアコンの下にあるので、"}, {"type": "subtitle", "time": 10374.469, "timestamp": "02:52:54", "text": "ヒットしない。"}, {"type": "subtitle", "time": 10376.87, "timestamp": "02:52:56", "text": "ええ、そうですね。これで、"}, {"type": "subtitle", "time": 10378.309, "timestamp": "02:52:58", "text": "振り向く。"}]
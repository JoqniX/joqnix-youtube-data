[{"type": "subtitle", "time": 7920.149, "timestamp": "02:12:00", "text": "いつでもそれらの呪文を唱えることができます"}, {"type": "subtitle", "time": 7922.47, "timestamp": "02:12:02", "text": "時間。"}, {"type": "subtitle", "time": 7923.109, "timestamp": "02:12:03", "text": "おお、"}, {"type": "subtitle", "time": 7925.27, "timestamp": "02:12:05", "text": "それでも呪文スロットは必要だ"}, {"type": "subtitle", "time": 7927.589, "timestamp": "02:12:07", "text": "ただし、それはまた呪文スロットであり、"}, {"type": "subtitle", "time": 7929.27, "timestamp": "02:12:09", "text": "要するにマナのことだ。知らない場合は"}, {"type": "subtitle", "time": 7931.43, "timestamp": "02:12:11", "text": "仕組みとしては、"}, {"type": "subtitle", "time": 7943.35, "timestamp": "02:12:23", "text": "ああ、魔法の呪文。それは確かに存在する。"}, {"type": "subtitle", "time": 7946.95, "timestamp": "02:12:26", "text": "はい、それなら選べます。"}, {"type": "subtitle", "time": 7959.669, "timestamp": "02:12:39", "text": "でもそれはレベル3の話です。それは"}, {"type": "subtitle", "time": 7961.189, "timestamp": "02:12:41", "text": "いいですよね？"}, {"type": "subtitle", "time": 7963.43, "timestamp": "02:12:43", "text": "うん。うーん、準備できるよ"}]
[{"type": "subtitle", "time": 1922.23, "timestamp": "00:32:02", "text": "たくさんのサブアセットがあって、"}, {"type": "subtitle", "time": 1924.789, "timestamp": "00:32:04", "text": "そこをクリックしてください。星をクリックしてください。それを確認して"}, {"type": "subtitle", "time": 1926.87, "timestamp": "00:32:06", "text": "能力がそう感じさせるかどうか確認する"}, {"type": "subtitle", "time": 1927.909, "timestamp": "00:32:07", "text": "フィット。"}, {"type": "subtitle", "time": 1932.31, "timestamp": "00:32:12", "text": "えーと、ドルイドと、えーと、クラスはどこですか。"}, {"type": "subtitle", "time": 1934.23, "timestamp": "00:32:14", "text": "ああ、私もできるよ、ちょっと待って。私"}, {"type": "subtitle", "time": 1937.43, "timestamp": "00:32:17", "text": "また、画面共有もできます。"}, {"type": "subtitle", "time": 1940.07, "timestamp": "00:32:20", "text": "場所を知らなければ、そうでしょうね。"}, {"type": "subtitle", "time": 1942.389, "timestamp": "00:32:22", "text": "うん。うん、それでいいよ。うん。"}, {"type": "subtitle", "time": 1945.83, "timestamp": "00:32:25", "text": "あ、待って。えっと、それは分散ですか"}, {"type": "subtitle", "time": 1947.269, "timestamp": "00:32:27", "text": "特徴？"}, {"type": "subtitle", "time": 1949.909, "timestamp": "00:32:29", "text": "ああ、どうぞ。ここ。持続する。えっと、私は"}, {"type": "subtitle", "time": 1952.95, "timestamp": "00:32:32", "text": "お見せします。私に見えるものが見えますか？"}, {"type": "subtitle", "time": 1955.029, "timestamp": "00:32:35", "text": "見る？うん。うん。"}, {"type": "subtitle", "time": 1957.11, "timestamp": "00:32:37", "text": "よし。うん。よし。ということで、"}, {"type": "subtitle", "time": 1959.19, "timestamp": "00:32:39", "text": "えっと、これは全部こんな感じ"}, {"type": "subtitle", "time": 1961.029, "timestamp": "00:32:41", "text": "ここはサブアセットのようなものです。私はただ"}, {"type": "subtitle", "time": 1963.75, "timestamp": "00:32:43", "text": "星印のようにチェックする。ええ、これはすべて"}, {"type": "subtitle", "time": 1967.19, "timestamp": "00:32:47", "text": "例えば、あなたの基本的なドルイドの能力のようなものです。"}, {"type": "subtitle", "time": 1969.99, "timestamp": "00:32:49", "text": "えーと、これは、そしてこちら側は、"}, {"type": "subtitle", "time": 1971.669, "timestamp": "00:32:51", "text": "青い方はあなたのクラスになります"}, {"type": "subtitle", "time": 1975.669, "timestamp": "00:32:55", "text": "サブクラス固有の能力。ええ、そうですね、"}, {"type": "subtitle", "time": 1979.59, "timestamp": "00:32:59", "text": "えっと、何でしたっけ？えっと、ディーラーさん、あなたは色々なことができます"}]
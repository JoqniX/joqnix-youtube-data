[{"type": "subtitle", "time": 3188.63, "timestamp": "00:53:08", "text": "ここに人間がいる。"}, {"type": "subtitle", "time": 3200.79, "timestamp": "00:53:20", "text": "ああ、"}, {"type": "subtitle", "time": 3203.67, "timestamp": "00:53:23", "text": "でも、それは壁掛けのようなもので"}, {"type": "subtitle", "time": 3206.069, "timestamp": "00:53:26", "text": "もの？"}, {"type": "subtitle", "time": 3209.67, "timestamp": "00:53:29", "text": "技術的には、そうです。でもそれはとても"}, {"type": "subtitle", "time": 3212.15, "timestamp": "00:53:32", "text": "ゆるい、つまり、ただ人々に遊ばせるだけ"}, {"type": "subtitle", "time": 3214.71, "timestamp": "00:53:34", "text": "彼らがどんなタイプのキャラクターであっても"}, {"type": "subtitle", "time": 3232.23, "timestamp": "00:53:52", "text": "このエルフも手に入れました。ああ、神様。そうそう。"}, {"type": "subtitle", "time": 3233.99, "timestamp": "00:53:53", "text": "あなたは何を選びましたか？あなたの"}, {"type": "subtitle", "time": 3235.27, "timestamp": "00:53:55", "text": "種？"}, {"type": "subtitle", "time": 3237.109, "timestamp": "00:53:57", "text": "ああ、私は持っていません。"}, {"type": "subtitle", "time": 3239.03, "timestamp": "00:53:59", "text": "だって私はゲームマスターだから、"}]
[{"type": "subtitle", "time": 9422.15, "timestamp": "02:37:02", "text": "実際にスタッフはもういるのですか？あなたは"}, {"type": "subtitle", "time": 9423.91, "timestamp": "02:37:03", "text": "自動的にいいねしてほしい"}, {"type": "subtitle", "time": 9425.99, "timestamp": "02:37:05", "text": "えっと、焦点をスタッフに切り替えてみませんか？なぜなら"}, {"type": "subtitle", "time": 9428.79, "timestamp": "02:37:08", "text": "まあ、だいたいそんな感じです。"}, {"type": "subtitle", "time": 9432.309, "timestamp": "02:37:12", "text": "ねえ、あの、ruid focusって何をするの？"}, {"type": "subtitle", "time": 9434.63, "timestamp": "02:37:14", "text": "えっと、それはあなたの呪文詠唱fです。あなたには"}, {"type": "subtitle", "time": 9437.51, "timestamp": "02:37:17", "text": "呪文を唱えるためにそれを保持する"}, {"type": "subtitle", "time": 9440.63, "timestamp": "02:37:20", "text": "物質的な要素が含まれている。そして私は好きです"}, {"type": "subtitle", "time": 9442.389, "timestamp": "02:37:22", "text": "それ。それを唱えることはできません。"}, {"type": "subtitle", "time": 9445.03, "timestamp": "02:37:25", "text": "おお。ええと、できないと思いますが、"}, {"type": "subtitle", "time": 9448.15, "timestamp": "02:37:28", "text": "試してみてください。そこに置いてみてください。"}, {"type": "subtitle", "time": 9450.389, "timestamp": "02:37:30", "text": "あなたはそれをインベントリからドラッグします、私は"}, {"type": "subtitle", "time": 9451.51, "timestamp": "02:37:31", "text": "考える。"}, {"type": "subtitle", "time": 9452.95, "timestamp": "02:37:32", "text": "わかった。えっと、どうぞ。"}, {"type": "subtitle", "time": 9454.469, "timestamp": "02:37:34", "text": "でもそれができないなら、私は"}, {"type": "subtitle", "time": 9457.67, "timestamp": "02:37:37", "text": "あなたには四分の一の杖だけを渡す。"}, {"type": "subtitle", "time": 9459.59, "timestamp": "02:37:39", "text": "効果はありますか？ええ、うまくいきません。"}, {"type": "subtitle", "time": 9461.83, "timestamp": "02:37:41", "text": "わかった。私はただあなたにあげるだけです"}, {"type": "subtitle", "time": 9463.91, "timestamp": "02:37:43", "text": "あなたはスタッフの4分の1です。持続する。"}, {"type": "subtitle", "time": 9471.19, "timestamp": "02:37:51", "text": "ああ、木の杖はドルイドの持ち物だ。は"}, {"type": "subtitle", "time": 9474.309, "timestamp": "02:37:54", "text": "有利な能力はありますか"}, {"type": "subtitle", "time": 9476.23, "timestamp": "02:37:56", "text": "それを持っている？"}, {"type": "subtitle", "time": 9479.19, "timestamp": "02:37:59", "text": "えっと、呪文を唱えるにはそれが必要なんです。もしあなたが"}]
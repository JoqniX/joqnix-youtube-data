[{"type": "subtitle", "time": 12483.51, "timestamp": "03:28:03", "text": "昨日の朝は起きていた"}, {"type": "subtitle", "time": 12485.67, "timestamp": "03:28:05", "text": "午前7時"}, {"type": "subtitle", "time": 12488.469, "timestamp": "03:28:08", "text": "私は眠らなかった、それから眠った、それから私は"}, {"type": "subtitle", "time": 12490.71, "timestamp": "03:28:10", "text": "ああ、コラボ練習全部"}, {"type": "subtitle", "time": 12493.59, "timestamp": "03:28:13", "text": "今日はコラボレーションではなく"}, {"type": "subtitle", "time": 12495.99, "timestamp": "03:28:15", "text": "むしろ練習のようなもの"}, {"type": "subtitle", "time": 12497.91, "timestamp": "03:28:17", "text": "間接的に教えてくれるような"}, {"type": "subtitle", "time": 12500.389, "timestamp": "03:28:20", "text": "たまたま"}, {"type": "subtitle", "time": 12502.63, "timestamp": "03:28:22", "text": "生放送で、よし、生放送でやろうと思った"}, {"type": "subtitle", "time": 12504.15, "timestamp": "03:28:24", "text": "ライブ"}, {"type": "subtitle", "time": 12507.99, "timestamp": "03:28:27", "text": "はい、同意を求めました。"}, {"type": "subtitle", "time": 12509.91, "timestamp": "03:28:29", "text": "しかしそれは"}, {"type": "subtitle", "time": 12513.67, "timestamp": "03:28:33", "text": "ストリーム配信で彼らが"}, {"type": "subtitle", "time": 12517.67, "timestamp": "03:28:37", "text": "ストリームで声が聞こえるし、すべてが"}, {"type": "subtitle", "time": 12522.229, "timestamp": "03:28:42", "text": "でも、何を書けばよかったんだろう？うん。"}, {"type": "subtitle", "time": 12524.63, "timestamp": "03:28:44", "text": "それで、初期の問題は、私はライブ配信中だった"}, {"type": "subtitle", "time": 12527.91, "timestamp": "03:28:47", "text": "YouTubeで配信中。今月からと言った"}, {"type": "subtitle", "time": 12531.429, "timestamp": "03:28:51", "text": "今後は、YouTubeは"}, {"type": "subtitle", "time": 12534.95, "timestamp": "03:28:54", "text": "積極的に提示する権利。そう、"}, {"type": "subtitle", "time": 12537.62, "timestamp": "03:28:57", "text": "それ。"}]
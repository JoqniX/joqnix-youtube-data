[{"type": "subtitle", "time": 5880.07, "timestamp": "01:38:00", "text": "無料。それはただ別のダメージを与えるだけです"}, {"type": "subtitle", "time": 5884.149, "timestamp": "01:38:04", "text": "入力してください。ただし、ほとんどの人は通常"}, {"type": "subtitle", "time": 5886.39, "timestamp": "01:38:06", "text": "追加のユーティリティのようなマジシャン"}, {"type": "subtitle", "time": 5889.109, "timestamp": "01:38:09", "text": "スペル。"}, {"type": "subtitle", "time": 5899.03, "timestamp": "01:38:19", "text": "おすすめは何ですか？"}, {"type": "subtitle", "time": 5899.83, "timestamp": "01:38:19", "text": "えっと、"}, {"type": "subtitle", "time": 5902.31, "timestamp": "01:38:22", "text": "私はマジシャンにしようと思う。"}, {"type": "subtitle", "time": 5903.669, "timestamp": "01:38:23", "text": "もう1つ選んでください。"}, {"type": "subtitle", "time": 5906.95, "timestamp": "01:38:26", "text": "よし。わかりました。わかった。えっと、何？"}, {"type": "subtitle", "time": 5909.27, "timestamp": "01:38:29", "text": "呪文を唱えたいですか、えっと、選びたいですか"}, {"type": "subtitle", "time": 5910.41, "timestamp": "01:38:30", "text": "これ？"}, {"type": "subtitle", "time": 5923.35, "timestamp": "01:38:43", "text": "わかった。えっと、これは何ですか？えっと"}, {"type": "subtitle", "time": 5927.99, "timestamp": "01:38:47", "text": "それは何ですか、それは名前のようなもの"}, {"type": "subtitle", "time": 5931.59, "timestamp": "01:38:51", "text": "検索？トーンリップとは何ですか？"}, {"type": "subtitle", "time": 5935.35, "timestamp": "01:38:55", "text": "引き裂かれた鞭は、あなたが攻撃し、"}, {"type": "subtitle", "time": 5938.55, "timestamp": "01:38:58", "text": "あなたは人々を自分のほうに引き寄せることができる。"}]
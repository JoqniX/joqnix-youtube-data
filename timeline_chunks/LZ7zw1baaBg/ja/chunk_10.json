[{"type": "subtitle", "time": 616.79, "timestamp": "00:10:16", "text": "わかった。めちゃくちゃだ。"}, {"type": "subtitle", "time": 620.23, "timestamp": "00:10:20", "text": "ああ、君はしくじったね。"}, {"type": "subtitle", "time": 622.79, "timestamp": "00:10:22", "text": "ええ、あなたはたくさんの間違いを犯していると思います"}, {"type": "subtitle", "time": 626.15, "timestamp": "00:10:26", "text": "地元のガイドと一緒に"}, {"type": "subtitle", "time": 627.829, "timestamp": "00:10:27", "text": "あなたに提供しました。"}, {"type": "subtitle", "time": 630.55, "timestamp": "00:10:30", "text": "知っている。次のエピソードを聴いています。"}, {"type": "subtitle", "time": 631.43, "timestamp": "00:10:31", "text": "の"}, {"type": "subtitle", "time": 632.87, "timestamp": "00:10:32", "text": "次"}, {"type": "subtitle", "time": 635.99, "timestamp": "00:10:35", "text": "何てことだ。"}, {"type": "subtitle", "time": 638.389, "timestamp": "00:10:38", "text": "男性の声と女性の声、その両方です。"}, {"type": "subtitle", "time": 641.829, "timestamp": "00:10:41", "text": "そうそう。わかった。ああ、なんてことだ。それが理由です"}, {"type": "subtitle", "time": 644.71, "timestamp": "00:10:44", "text": "歌っているから、一音低いんだ"}, {"type": "subtitle", "time": 648.069, "timestamp": "00:10:48", "text": "1音下げたら、いつものように"}, {"type": "subtitle", "time": 650.23, "timestamp": "00:10:50", "text": "基本的には声のことです。"}, {"type": "subtitle", "time": 652.949, "timestamp": "00:10:52", "text": "ああ、これは難しい。"}, {"type": "subtitle", "time": 656.31, "timestamp": "00:10:56", "text": "うん。ええ、知っています。"}, {"type": "subtitle", "time": 658.949, "timestamp": "00:10:58", "text": "だから私はそれを単なる"}]
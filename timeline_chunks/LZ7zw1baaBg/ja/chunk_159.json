[{"type": "subtitle", "time": 9540.55, "timestamp": "02:39:00", "text": "君のメインハンドに、君のGを置き換えるから"}, {"type": "subtitle", "time": 9542.309, "timestamp": "02:39:02", "text": "四分の一スタッフで焦点を合わせる。見てみれば"}, {"type": "subtitle", "time": 9543.349, "timestamp": "02:39:03", "text": "あなたのもの"}, {"type": "subtitle", "time": 9546.15, "timestamp": "02:39:06", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 9549.03, "timestamp": "02:39:09", "text": "うん。えっと、それは"}, {"type": "subtitle", "time": 9551.11, "timestamp": "02:39:11", "text": "実際に与えることは難しい"}, {"type": "subtitle", "time": 9555.67, "timestamp": "02:39:15", "text": "おお、いいね。"}, {"type": "subtitle", "time": 9557.75, "timestamp": "02:39:17", "text": "はい、どうぞ。うん。だから今は"}, {"type": "subtitle", "time": 9560.23, "timestamp": "02:39:20", "text": "これで魔法がかかっているはずです。それで"}, {"type": "subtitle", "time": 9561.67, "timestamp": "02:39:21", "text": "四分の一で攻撃する場合"}, {"type": "subtitle", "time": 9564.55, "timestamp": "02:39:24", "text": "そういうものなら、チレレにダメージを与えるでしょう。"}, {"type": "subtitle", "time": 9572.23, "timestamp": "02:39:32", "text": "ガス魔法ですよね？いいえ。"}, {"type": "subtitle", "time": 9574.95, "timestamp": "02:39:34", "text": "これですか？"}, {"type": "subtitle", "time": 9575.51, "timestamp": "02:39:35", "text": "ええ、もちろんです。"}, {"type": "subtitle", "time": 9577.429, "timestamp": "02:39:37", "text": "クォーターのものは、いいえ、必要ありません"}, {"type": "subtitle", "time": 9579.03, "timestamp": "02:39:39", "text": "あなたのクォータースタッフのためにそれをキャストする"}, {"type": "subtitle", "time": 9580.95, "timestamp": "02:39:40", "text": "すでに持っているようなものです。だからあなたは"}, {"type": "subtitle", "time": 9584.07, "timestamp": "02:39:44", "text": "さあ、あなたの四分音符をクリックしてください。"}, {"type": "subtitle", "time": 9585.03, "timestamp": "02:39:45", "text": "わかった。"}, {"type": "subtitle", "time": 9586.79, "timestamp": "02:39:46", "text": "それから、ええ、ただ閉じるだけです"}, {"type": "subtitle", "time": 9588.23, "timestamp": "02:39:48", "text": "ターゲットピッカーのチュートリアル。必要ない"}, {"type": "subtitle", "time": 9589.429, "timestamp": "02:39:49", "text": "それ。"}, {"type": "subtitle", "time": 9591.51, "timestamp": "02:39:51", "text": "そうそう。そちら側。クリック。わかった。所有"}, {"type": "subtitle", "time": 9593.19, "timestamp": "02:39:53", "text": "の上。うん。まずはそれを閉じてください。"}, {"type": "subtitle", "time": 9594.55, "timestamp": "02:39:54", "text": "わかった。わかった。それで"}, {"type": "subtitle", "time": 9597.429, "timestamp": "02:39:57", "text": "だから、これは"}, {"type": "subtitle", "time": 9599.67, "timestamp": "02:39:59", "text": "攻撃的なやり方。攻撃ロールをクリックして"}]
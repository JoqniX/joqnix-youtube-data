[{"type": "subtitle", "time": 2641.99, "timestamp": "00:44:01", "text": "それほどの知性。それは主に"}, {"type": "subtitle", "time": 2644.95, "timestamp": "00:44:04", "text": "ある種のスキルのようなもの。もしあなたが"}, {"type": "subtitle", "time": 2647.27, "timestamp": "00:44:07", "text": "それに精通していれば、"}, {"type": "subtitle", "time": 2649.75, "timestamp": "00:44:09", "text": "もう少しポイントを投入して"}, {"type": "subtitle", "time": 2652.069, "timestamp": "00:44:12", "text": "それを手助けする知性"}, {"type": "subtitle", "time": 2661.109, "timestamp": "00:44:21", "text": "わかった。カリスマ性は必要だと思いますか？"}, {"type": "subtitle", "time": 2665.43, "timestamp": "00:44:25", "text": "えっと、ドルイドはカリスマ性を使う傾向がないんです"}, {"type": "subtitle", "time": 2667.43, "timestamp": "00:44:27", "text": "通常、カリスマ性は主に"}, {"type": "subtitle", "time": 2671.75, "timestamp": "00:44:31", "text": "えっと、じゃあ、あなたが電話する"}, {"type": "subtitle", "time": 2674.95, "timestamp": "00:44:34", "text": "えーっと、顔の授業みたいなのは、"}, {"type": "subtitle", "time": 2677.109, "timestamp": "00:44:37", "text": "普段はおしゃべりをする人たち。"}, {"type": "subtitle", "time": 2679.589, "timestamp": "00:44:39", "text": "たくさんしてくれる人のためにたくさんするなら"}, {"type": "subtitle", "time": 2681.75, "timestamp": "00:44:41", "text": "それらのどれもが"}, {"type": "subtitle", "time": 2684.71, "timestamp": "00:44:44", "text": "カリスマ性が非常に高い必要があるだろう。ドルイド"}, {"type": "subtitle", "time": 2688.47, "timestamp": "00:44:48", "text": "一般的に、カリスマ性はそれほど必要ない。"}, {"type": "subtitle", "time": 2689.67, "timestamp": "00:44:49", "text": "何を建てるかによりますが、"}, {"type": "subtitle", "time": 2692.63, "timestamp": "00:44:52", "text": "一般的にデフォルトのドルイドは"}, {"type": "subtitle", "time": 2694.309, "timestamp": "00:44:54", "text": "本当に必要なんです。"}, {"type": "subtitle", "time": 2695.829, "timestamp": "00:44:55", "text": "ああ、"}, {"type": "subtitle", "time": 2696.87, "timestamp": "00:44:56", "text": "うん。うん。"}, {"type": "subtitle", "time": 2698.55, "timestamp": "00:44:58", "text": "あのね？私はただ立ち上がるだけです"}]
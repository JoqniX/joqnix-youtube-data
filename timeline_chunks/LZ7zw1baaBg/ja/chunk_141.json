[{"type": "subtitle", "time": 8460.55, "timestamp": "02:21:00", "text": "うん、円形にするよ"}, {"type": "subtitle", "time": 8461.99, "timestamp": "02:21:01", "text": "すぐに。"}, {"type": "subtitle", "time": 8464.63, "timestamp": "02:21:04", "text": "わかった。そこで、アップロードをクリックしました。"}, {"type": "subtitle", "time": 8467.51, "timestamp": "02:21:07", "text": "えっと、ダウンロードして送ってください。"}, {"type": "subtitle", "time": 8468.15, "timestamp": "02:21:08", "text": "ダウンロード。"}, {"type": "subtitle", "time": 8469.83, "timestamp": "02:21:09", "text": "ダウンロードして送ってください。うん。"}, {"type": "subtitle", "time": 8477.99, "timestamp": "02:21:17", "text": "メインアカウントのアドレスを送ります。"}, {"type": "subtitle", "time": 8481.75, "timestamp": "02:21:21", "text": "わかった。トークンへ。"}, {"type": "subtitle", "time": 8489.03, "timestamp": "02:21:29", "text": "わかった。あ、ちょっと待って。なぜそれが"}, {"type": "subtitle", "time": 8491.99, "timestamp": "02:21:31", "text": "なぜ境界線があるのですか？ああ、それは"}, {"type": "subtitle", "time": 8493.51, "timestamp": "02:21:33", "text": "既に境界線があります。"}, {"type": "subtitle", "time": 8495.91, "timestamp": "02:21:35", "text": "わかった。いや、ちょっと待って。持続する。えっと、続けてください"}, {"type": "subtitle", "time": 8499.27, "timestamp": "02:21:39", "text": "トークンスタンプに刻印されています。上にスクロールしてください。上にスクロールして"}, {"type": "subtitle", "time": 8501.67, "timestamp": "02:21:41", "text": "それから円の上へ。あの円が見えますか？"}, {"type": "subtitle", "time": 8502.469, "timestamp": "02:21:42", "text": "そちら側？"}, {"type": "subtitle", "time": 8502.79, "timestamp": "02:21:42", "text": "うん。"}, {"type": "subtitle", "time": 8504.71, "timestamp": "02:21:44", "text": "はい、そうです。それをクリックしてください。"}, {"type": "subtitle", "time": 8506.55, "timestamp": "02:21:46", "text": "円をクリックして、次に1をクリックします"}, {"type": "subtitle", "time": 8508.71, "timestamp": "02:21:48", "text": "1番目か2番目をクリックしてください。の"}, {"type": "subtitle", "time": 8510.79, "timestamp": "02:21:50", "text": "何も持っていないもの。"}, {"type": "subtitle", "time": 8511.83, "timestamp": "02:21:51", "text": "何も持っていない人。"}, {"type": "subtitle", "time": 8512.95, "timestamp": "02:21:52", "text": "うん。うん。はい、どうぞ。今"}, {"type": "subtitle", "time": 8514.63, "timestamp": "02:21:54", "text": "実際には背景を削除します。"}, {"type": "subtitle", "time": 8515.51, "timestamp": "02:21:55", "text": "ああ、わかりました。わかった。"}, {"type": "subtitle", "time": 8516.07, "timestamp": "02:21:56", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 8516.79, "timestamp": "02:21:56", "text": "これです。わかった。"}, {"type": "subtitle", "time": 8518.79, "timestamp": "02:21:58", "text": "うん。うん。他の方法を使いたい場合は"}]
[{"type": "subtitle", "time": 2041.43, "timestamp": "00:34:01", "text": "ワイルドシェイプ。ええと、そうですね"}, {"type": "subtitle", "time": 2043.11, "timestamp": "00:34:03", "text": "それは、つまり、基本的にあなたは"}, {"type": "subtitle", "time": 2044.389, "timestamp": "00:34:04", "text": "形態変化。"}, {"type": "subtitle", "time": 2047.83, "timestamp": "00:34:07", "text": "おお。おお、いいね。ニース。それも可能だ"}, {"type": "subtitle", "time": 2048.47, "timestamp": "00:34:08", "text": "それ。"}, {"type": "subtitle", "time": 2050.069, "timestamp": "00:34:10", "text": "うん。"}, {"type": "subtitle", "time": 2050.629, "timestamp": "00:34:10", "text": "ニース。"}, {"type": "subtitle", "time": 2052.869, "timestamp": "00:34:12", "text": "うん。もしあなたがもしあなたがそう思うなら、"}, {"type": "subtitle", "time": 2055.19, "timestamp": "00:34:15", "text": "それは一つの選択肢のようなものだ。別の選択肢"}, {"type": "subtitle", "time": 2057.51, "timestamp": "00:34:17", "text": "えっと、僧侶と"}, {"type": "subtitle", "time": 2059.109, "timestamp": "00:34:19", "text": "アストラル体。何が何だか確認させてください"}, {"type": "subtitle", "time": 2061.349, "timestamp": "00:34:21", "text": "そうなんですか？さぁ行こう。ええ、星界の中で"}, {"type": "subtitle", "time": 2064.55, "timestamp": "00:34:24", "text": "自己。ええ、できますよ"}, {"type": "subtitle", "time": 2067.27, "timestamp": "00:34:27", "text": "えっと、何て呼ぶんだっけ？ええと、あなたは"}, {"type": "subtitle", "time": 2069.99, "timestamp": "00:34:29", "text": "立つ。でも、それはまるで"}, {"type": "subtitle", "time": 2071.43, "timestamp": "00:34:31", "text": "何かアストラル投射"}, {"type": "subtitle", "time": 2074.069, "timestamp": "00:34:34", "text": "そういう類のことだ。そして"}, {"type": "subtitle", "time": 2074.629, "timestamp": "00:34:34", "text": "うん。うん。"}, {"type": "subtitle", "time": 2077.109, "timestamp": "00:34:37", "text": "待って、それはドルイド用？ああ、僧侶よ。わかった。"}, {"type": "subtitle", "time": 2078.629, "timestamp": "00:34:38", "text": "なんてこった。これは僧侶向けです。その"}, {"type": "subtitle", "time": 2081.109, "timestamp": "00:34:41", "text": "違う。ええ、そうですね、"}, {"type": "subtitle", "time": 2083.27, "timestamp": "00:34:43", "text": "2つは何かを好むものです"}, {"type": "subtitle", "time": 2084.95, "timestamp": "00:34:44", "text": "星がいくつか。他に何があるだろうか"}, {"type": "subtitle", "time": 2086.31, "timestamp": "00:34:46", "text": "うまくいくかもしれない。"}, {"type": "subtitle", "time": 2092.389, "timestamp": "00:34:52", "text": "その2人だと思う。うん、そう思う"}, {"type": "subtitle", "time": 2095.26, "timestamp": "00:34:55", "text": "その2つは、最も近い関係にあると言えるでしょう。"}, {"type": "subtitle", "time": 2097.91, "timestamp": "00:34:57", "text": "[音楽]"}]
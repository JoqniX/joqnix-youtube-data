[{"type": "subtitle", "time": 8640.71, "timestamp": "02:24:00", "text": "シミュレーターやその他多くのもの。"}, {"type": "subtitle", "time": 8641.27, "timestamp": "02:24:01", "text": "おお、"}, {"type": "subtitle", "time": 8642.87, "timestamp": "02:24:02", "text": "テーブルさえあれば、遊べる"}, {"type": "subtitle", "time": 8651.67, "timestamp": "02:24:11", "text": "わかった。"}, {"type": "subtitle", "time": 8654.469, "timestamp": "02:24:14", "text": "よし。ええと、わかりました。手に入れた"}, {"type": "subtitle", "time": 8656.95, "timestamp": "02:24:16", "text": "終わり。キャッチーな曲が完成しました。わかった。それで、"}, {"type": "subtitle", "time": 8659.19, "timestamp": "02:24:19", "text": "えっと"}, {"type": "subtitle", "time": 8661.03, "timestamp": "02:24:21", "text": "続ける前に、私は"}, {"type": "subtitle", "time": 8662.71, "timestamp": "02:24:22", "text": "あなたをいずれかのグループに割り当てます。あなたは"}, {"type": "subtitle", "time": 8664.95, "timestamp": "02:24:24", "text": "プレイする予定ですか"}, {"type": "subtitle", "time": 8666.63, "timestamp": "02:24:26", "text": "土曜日か日曜日か？どんなグループが"}, {"type": "subtitle", "time": 8670.55, "timestamp": "02:24:30", "text": "参加したいですか？私は暇です"}, {"type": "subtitle", "time": 8673.75, "timestamp": "02:24:33", "text": "土曜日。土曜日なら大丈夫です。"}, {"type": "subtitle", "time": 8676.63, "timestamp": "02:24:36", "text": "そこにいる全員は"}, {"type": "subtitle", "time": 8677.99, "timestamp": "02:24:37", "text": "土曜日？"}, {"type": "subtitle", "time": 8679.67, "timestamp": "02:24:39", "text": "ああ、わかりました。グループをチェックできます。"}, {"type": "subtitle", "time": 8681.27, "timestamp": "02:24:41", "text": "でも、今まさに私は"}, {"type": "subtitle", "time": 8682.87, "timestamp": "02:24:42", "text": "追加するのも忘れてた"}, {"type": "subtitle", "time": 8685.429, "timestamp": "02:24:45", "text": "グループ名一覧をご覧ください。うん、"}, {"type": "subtitle", "time": 8689.11, "timestamp": "02:24:49", "text": "土曜日の現在、"}, {"type": "subtitle", "time": 8691.67, "timestamp": "02:24:51", "text": "えっと、ルディウス、リザード、ナイト。その後"}, {"type": "subtitle", "time": 8693.91, "timestamp": "02:24:53", "text": "日曜日にはアリオ、ウィロー、ナイト、"}, {"type": "subtitle", "time": 8696.15, "timestamp": "02:24:56", "text": "スミとレネ。"}, {"type": "subtitle", "time": 8699.03, "timestamp": "02:24:59", "text": "おお。日曜日はみんなにとって特別な日だ。ええ、まさにその通りです"}]
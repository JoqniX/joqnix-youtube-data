[{"type": "subtitle", "time": 3125.589, "timestamp": "00:52:05", "text": "自分に合ったことをしよう。"}, {"type": "subtitle", "time": 3128.71, "timestamp": "00:52:08", "text": "わかった。ドラゴンの血を引く者。"}, {"type": "subtitle", "time": 3131.19, "timestamp": "00:52:11", "text": "これは何ですか？青、黒、真鍮。おお、"}, {"type": "subtitle", "time": 3132.23, "timestamp": "00:52:12", "text": "違う。"}, {"type": "subtitle", "time": 3135.75, "timestamp": "00:52:15", "text": "さまざまな種類があります。ええ、いろいろな種類がありますね。"}, {"type": "subtitle", "time": 3146.069, "timestamp": "00:52:26", "text": "よし、34番でいいよ。私だよ。"}, {"type": "subtitle", "time": 3147.829, "timestamp": "00:52:27", "text": "混乱した。"}, {"type": "subtitle", "time": 3149.67, "timestamp": "00:52:29", "text": "ドワーフ"}, {"type": "subtitle", "time": 3157.109, "timestamp": "00:52:37", "text": "えっと、それぞれの種には独自の"}, {"type": "subtitle", "time": 3159.589, "timestamp": "00:52:39", "text": "メリットとデメリットがあるよね？"}, {"type": "subtitle", "time": 3161.19, "timestamp": "00:52:41", "text": "うん。もしあなたが横に置きたいなら"}, {"type": "subtitle", "time": 3162.39, "timestamp": "00:52:42", "text": "そこで、ミドルクリックをクリックすると、"}, {"type": "subtitle", "time": 3164.069, "timestamp": "00:52:44", "text": "実際にスクロールして"}, {"type": "subtitle", "time": 3165.99, "timestamp": "00:52:45", "text": "彼らの情報、例えばあなたができることなど"}, {"type": "subtitle", "time": 3167.27, "timestamp": "00:52:47", "text": "そして、できないことや、"}, {"type": "subtitle", "time": 3168.79, "timestamp": "00:52:48", "text": "それ。"}, {"type": "subtitle", "time": 3169.99, "timestamp": "00:52:49", "text": "ミドルクリックが必要です。はい、どうぞ。"}, {"type": "subtitle", "time": 3171.51, "timestamp": "00:52:51", "text": "これでスクロールして何を見ることができるか"}, {"type": "subtitle", "time": 3173.27, "timestamp": "00:52:53", "text": "あなたが持っている。"}, {"type": "subtitle", "time": 3176.47, "timestamp": "00:52:56", "text": "わかった。わかった。"}]
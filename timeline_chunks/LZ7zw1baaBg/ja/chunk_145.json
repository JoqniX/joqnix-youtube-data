[{"type": "subtitle", "time": 8701.349, "timestamp": "02:25:01", "text": "たくさん。人は人であり、"}, {"type": "subtitle", "time": 8704.55, "timestamp": "02:25:04", "text": "日曜日にはさらに多くの商品が入荷予定です。"}, {"type": "subtitle", "time": 8705.429, "timestamp": "02:25:05", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 8708.07, "timestamp": "02:25:08", "text": "土曜日の試合に新しい選手はいますか？"}, {"type": "subtitle", "time": 8709.59, "timestamp": "02:25:09", "text": "グループ？"}, {"type": "subtitle", "time": 8713.429, "timestamp": "02:25:13", "text": "ええと、今のところは、いいえ。"}, {"type": "subtitle", "time": 8717.59, "timestamp": "02:25:17", "text": "ああ、私が参加したら彼らの足を引っ張ることになるだろうか"}, {"type": "subtitle", "time": 8719.51, "timestamp": "02:25:19", "text": "土曜日？"}, {"type": "subtitle", "time": 8721.59, "timestamp": "02:25:21", "text": "私はそうは思わない。"}, {"type": "subtitle", "time": 8725.429, "timestamp": "02:25:25", "text": "いや、実は違うんです。いや、気にしないで。いいえ、"}, {"type": "subtitle", "time": 8726.95, "timestamp": "02:25:26", "text": "ルディは本当に新人だ。そして、ルディは新メンバーです。おお、"}, {"type": "subtitle", "time": 8729.91, "timestamp": "02:25:29", "text": "うん。どうでも。ルディは新人です。"}, {"type": "subtitle", "time": 8732.469, "timestamp": "02:25:32", "text": "ああ、わかりました。土曜日のグループ、新しい"}, {"type": "subtitle", "time": 8734.95, "timestamp": "02:25:34", "text": "人々。わかった。"}, {"type": "subtitle", "time": 8736.95, "timestamp": "02:25:36", "text": "わかった。よし。では、あなたは"}, {"type": "subtitle", "time": 8738.23, "timestamp": "02:25:38", "text": "土曜日？"}, {"type": "subtitle", "time": 8740.55, "timestamp": "02:25:40", "text": "ええ、土曜日なら大丈夫です。うん。"}, {"type": "subtitle", "time": 8741.91, "timestamp": "02:25:41", "text": "わかりました。あなたを追加します"}, {"type": "subtitle", "time": 8743.91, "timestamp": "02:25:43", "text": "土曜日のグループ。えっと、"}, {"type": "subtitle", "time": 8744.389, "timestamp": "02:25:44", "text": "何時？"}, {"type": "subtitle", "time": 8747.91, "timestamp": "02:25:47", "text": "はっきり言っておきます。ええ、今日と同じです。"}, {"type": "subtitle", "time": 8749.429, "timestamp": "02:25:49", "text": "うん、そうだね。"}, {"type": "subtitle", "time": 8759.75, "timestamp": "02:25:59", "text": "ああ、すでにヒーラーがいる"}]
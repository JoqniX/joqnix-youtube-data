[{"type": "subtitle", "time": 5940.87, "timestamp": "01:39:00", "text": "わかった。これは遠距離攻撃ですが、"}, {"type": "subtitle", "time": 5943.51, "timestamp": "01:39:03", "text": "あなたは人々を自分の方に引き寄せ、"}, {"type": "subtitle", "time": 5958.47, "timestamp": "01:39:18", "text": "また、私はどんな種類を持っていますか"}, {"type": "subtitle", "time": 5960.07, "timestamp": "01:39:20", "text": "現在？それは、えっと"}, {"type": "subtitle", "time": 5962.629, "timestamp": "01:39:22", "text": "ああ、現在あなたは光を持っています、あなたは"}, {"type": "subtitle", "time": 5965.43, "timestamp": "01:39:25", "text": "炎を発生させ、また、"}, {"type": "subtitle", "time": 5991.109, "timestamp": "01:39:51", "text": "つまり、私には次のようなユーティリティが1つあるということです。"}, {"type": "subtitle", "time": 5995.83, "timestamp": "01:39:55", "text": "この物を傷つけるような気分にさせて、"}, {"type": "subtitle", "time": 5999.03, "timestamp": "01:39:59", "text": "いや、あなたと1人がサポートしているんですよね？"}]
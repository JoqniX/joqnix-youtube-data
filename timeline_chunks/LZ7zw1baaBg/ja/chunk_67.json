[{"type": "subtitle", "time": 4027.589, "timestamp": "01:07:07", "text": "えっと、"}, {"type": "subtitle", "time": 4029.99, "timestamp": "01:07:09", "text": "もしあなたが、もしあなたが、そうなら。知らない場合は"}, {"type": "subtitle", "time": 4032.63, "timestamp": "01:07:12", "text": "もし私が、あなたが私に好きになってほしいと思うなら、"}, {"type": "subtitle", "time": 4035.029, "timestamp": "01:07:15", "text": "ご意見やご提案もお気軽にお寄せください。"}, {"type": "subtitle", "time": 4037.109, "timestamp": "01:07:17", "text": "うん。何をおすすめしますか？"}, {"type": "subtitle", "time": 4039.829, "timestamp": "01:07:19", "text": "一般的に、薄手のウールが最も"}, {"type": "subtitle", "time": 4042.39, "timestamp": "01:07:22", "text": "ここで役立つのは、後でドルイドとして"}, {"type": "subtitle", "time": 4044.15, "timestamp": "01:07:24", "text": "実際、他の"}, {"type": "subtitle", "time": 4046.789, "timestamp": "01:07:26", "text": "ダメージを与えると、つまずきにつながる可能性があります。光は"}, {"type": "subtitle", "time": 4049.029, "timestamp": "01:07:29", "text": "概して、ここではかなり役立ちます。しかしもし"}, {"type": "subtitle", "time": 4053.51, "timestamp": "01:07:33", "text": "えっと、でも、もしあなたが"}, {"type": "subtitle", "time": 4056.23, "timestamp": "01:07:36", "text": "そこに聖なる炎が欲しいでしょう"}, {"type": "subtitle", "time": 4057.829, "timestamp": "01:07:37", "text": "それもまあまあなキャンリップですね。その"}, {"type": "subtitle", "time": 4059.51, "timestamp": "01:07:39", "text": "最もダメージを与えるものではないが、"}, {"type": "subtitle", "time": 4062.549, "timestamp": "01:07:42", "text": "また、それは数少ない呪文の1つです"}, {"type": "subtitle", "time": 4065.029, "timestamp": "01:07:45", "text": "カバーを無視する"}, {"type": "subtitle", "time": 4067.43, "timestamp": "01:07:47", "text": "または旅行も可能です。"}, {"type": "subtitle", "time": 4069.99, "timestamp": "01:07:49", "text": "ああ、カバーを無視する。おお、"}, {"type": "subtitle", "time": 4071.51, "timestamp": "01:07:51", "text": "うん。しかし光もまた"}, {"type": "subtitle", "time": 4075.829, "timestamp": "01:07:55", "text": "一般的にかなり便利です。"}, {"type": "subtitle", "time": 4077.91, "timestamp": "01:07:57", "text": "チーム全体、たとえあなたが"}]
[{"type": "subtitle", "time": 8111.99, "timestamp": "02:15:11", "text": "えーと。わかった。グッドベリーを1つください。"}, {"type": "subtitle", "time": 8120.229, "timestamp": "02:15:20", "text": "能力を強化する機能はありますか？"}, {"type": "subtitle", "time": 8122.55, "timestamp": "02:15:22", "text": "何を強化するのか？おお、強化された能力。私"}, {"type": "subtitle", "time": 8124.629, "timestamp": "02:15:24", "text": "レベルアップのようなものだと思う。"}, {"type": "subtitle", "time": 8126.39, "timestamp": "02:15:26", "text": "能力レベルは1か2です。私はできません"}, {"type": "subtitle", "time": 8130.069, "timestamp": "02:15:30", "text": "本当に覚えておいてください。えっと、私もわからないのですが"}, {"type": "subtitle", "time": 8132.229, "timestamp": "02:15:32", "text": "あなたは実際にそれにアクセスできます。あああ"}, {"type": "subtitle", "time": 8134.629, "timestamp": "02:15:34", "text": "ええ、レベル2です。拡張機能は"}, {"type": "subtitle", "time": 8135.99, "timestamp": "02:15:35", "text": "レベル2"}, {"type": "subtitle", "time": 8143.27, "timestamp": "02:15:43", "text": "私はいくら持っていますか？ 9人中5人。"}, {"type": "subtitle", "time": 8158.069, "timestamp": "02:15:58", "text": "星形はありますか？スターストーリースター"}, {"type": "subtitle", "time": 8158.39, "timestamp": "02:15:58", "text": "物語の主役。"}, {"type": "subtitle", "time": 8159.91, "timestamp": "02:15:59", "text": "ああ、それはもう分かってるよ。あなたはすでに"}]
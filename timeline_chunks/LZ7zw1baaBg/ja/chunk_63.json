[{"type": "subtitle", "time": 3782.23, "timestamp": "01:03:02", "text": "ああ、インポートされませんでした。開けてみました。"}, {"type": "subtitle", "time": 3783.91, "timestamp": "01:03:03", "text": "もう一度試してみるしかないかな。 「追加」をクリック"}, {"type": "subtitle", "time": 3785.829, "timestamp": "01:03:05", "text": "種を特定し、それをもう一度試してください。私は"}, {"type": "subtitle", "time": 3787.829, "timestamp": "01:03:07", "text": "なぜインポートされなかったのか分かりません。それ"}, {"type": "subtitle", "time": 3790.47, "timestamp": "01:03:10", "text": "インポートすべきだ。"}, {"type": "subtitle", "time": 3797.349, "timestamp": "01:03:17", "text": "選択"}, {"type": "subtitle", "time": 3798.789, "timestamp": "01:03:18", "text": "完了。"}, {"type": "subtitle", "time": 3801.19, "timestamp": "01:03:21", "text": "はい。"}, {"type": "subtitle", "time": 3808.87, "timestamp": "01:03:28", "text": "よし"}, {"type": "subtitle", "time": 3811.91, "timestamp": "01:03:31", "text": "天上のようで、そして大丈夫。"}, {"type": "subtitle", "time": 3813.109, "timestamp": "01:03:33", "text": "わかった。ああ、わかりました。うん、そう思うよ"}, {"type": "subtitle", "time": 3815.51, "timestamp": "01:03:35", "text": "いいねではなく、閉じるをクリックする"}, {"type": "subtitle", "time": 3818.71, "timestamp": "01:03:38", "text": "えーと、代わりに、オーケー。よし。以上"}, {"type": "subtitle", "time": 3822.87, "timestamp": "01:03:42", "text": "ここで、えーと、能力スコアをクリックします。"}, {"type": "subtitle", "time": 3824.95, "timestamp": "01:03:44", "text": "えっと、私は次のようなものを選ぶことをお勧めします。"}, {"type": "subtitle", "time": 3826.95, "timestamp": "01:03:46", "text": "知恵ですが、どれでも自由に選んでください"}, {"type": "subtitle", "time": 3830.309, "timestamp": "01:03:50", "text": "その物。そして"}, {"type": "subtitle", "time": 3837.589, "timestamp": "01:03:57", "text": "ああ、わかった。ダンシング。ああ、それはまるでああ、私は"}, {"type": "subtitle", "time": 3839.99, "timestamp": "01:03:59", "text": "私はこれらすべてを選ばなければならないのだろうか。"}]
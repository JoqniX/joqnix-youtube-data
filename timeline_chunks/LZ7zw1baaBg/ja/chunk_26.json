[{"type": "subtitle", "time": 1560.549, "timestamp": "00:26:00", "text": "それをクリックしてクラスに行くと、"}, {"type": "subtitle", "time": 1562.47, "timestamp": "00:26:02", "text": "また、詳細な説明もあります。"}, {"type": "subtitle", "time": 1564.789, "timestamp": "00:26:04", "text": "各クラスの。でも、もしあなたが"}, {"type": "subtitle", "time": 1567.59, "timestamp": "00:26:07", "text": "でも、一般的なえーと何が欲しいの？"}, {"type": "subtitle", "time": 1569.269, "timestamp": "00:26:09", "text": "もう一度概要を呼び出します。私は好きです。"}, {"type": "subtitle", "time": 1571.51, "timestamp": "00:26:11", "text": "各クラスが何をするかを説明します。"}, {"type": "subtitle", "time": 1573.43, "timestamp": "00:26:13", "text": "または、読みたい場合は"}, {"type": "subtitle", "time": 1575.75, "timestamp": "00:26:15", "text": "ジャーナルの概要も"}, {"type": "subtitle", "time": 1579.11, "timestamp": "00:26:19", "text": "ウェブサイトにあるようなもの、あの"}, {"type": "subtitle", "time": 1581.669, "timestamp": "00:26:21", "text": "それは私のIPアドレスみたいなものだ。えっと、もしあなたが行くなら"}, {"type": "subtitle", "time": 1583.35, "timestamp": "00:26:23", "text": "ジャーナルタブへ、これは本です"}, {"type": "subtitle", "time": 1585.909, "timestamp": "00:26:25", "text": "右上隅にタブがあります"}, {"type": "subtitle", "time": 1587.59, "timestamp": "00:26:27", "text": "クラス概要と呼ばれています。それをクリックすると"}, {"type": "subtitle", "time": 1591.269, "timestamp": "00:26:31", "text": "また、各クラスの内容も確認できます。"}, {"type": "subtitle", "time": 1595.909, "timestamp": "00:26:35", "text": "は。ああ、わかりました。わかった。ああ、これだ。わかった。"}, {"type": "subtitle", "time": 1597.029, "timestamp": "00:26:37", "text": "うん。うん。"}, {"type": "subtitle", "time": 1599.11, "timestamp": "00:26:39", "text": "ああ、"}, {"type": "subtitle", "time": 1601.43, "timestamp": "00:26:41", "text": "どのキャラクターにすればいいかわからない場合は"}, {"type": "subtitle", "time": 1604.95, "timestamp": "00:26:44", "text": "ジョークキャラクターとして行くことにしようか"}, {"type": "subtitle", "time": 1605.669, "timestamp": "00:26:45", "text": "それから？"}, {"type": "subtitle", "time": 1607.75, "timestamp": "00:26:47", "text": "つまり、もしよろしければ、ご自由にどうぞ。もしあなたが"}, {"type": "subtitle", "time": 1609.029, "timestamp": "00:26:49", "text": "望むなら、遠慮なくどうぞ。"}, {"type": "subtitle", "time": 1611.35, "timestamp": "00:26:51", "text": "わかった。私は何者？私は星座です。"}, {"type": "subtitle", "time": 1616.87, "timestamp": "00:26:56", "text": "では、待ってください。えっと、待って。魔法使いは働くのか？"}, {"type": "subtitle", "time": 1618.549, "timestamp": "00:26:58", "text": "それは何によるかによります"}, {"type": "subtitle", "time": 1619.909, "timestamp": "00:26:59", "text": "待って、あなたが欲しい魔法使いがいる"}]
[{"type": "subtitle", "time": 6960.95, "timestamp": "01:56:00", "text": "ダメージを与えるキャンリップは、"}, {"type": "subtitle", "time": 6962.55, "timestamp": "01:56:02", "text": "不利な点。"}, {"type": "subtitle", "time": 6965.03, "timestamp": "01:56:05", "text": "なんてこった。えっと"}, {"type": "subtitle", "time": 6972.87, "timestamp": "01:56:12", "text": "カビが生える可能性もある。"}, {"type": "subtitle", "time": 6975.189, "timestamp": "01:56:15", "text": "モールドアースとはこういうものだ。これはユーティリティです"}, {"type": "subtitle", "time": 6977.91, "timestamp": "01:56:17", "text": "スペル。それはさまざまな"}, {"type": "subtitle", "time": 6981.51, "timestamp": "01:56:21", "text": "かなり多様な用途がある。"}, {"type": "subtitle", "time": 6983.109, "timestamp": "01:56:23", "text": "唯一の欠点は、その地域が"}, {"type": "subtitle", "time": 6985.03, "timestamp": "01:56:25", "text": "少し小さいです。"}, {"type": "subtitle", "time": 6989.669, "timestamp": "01:56:29", "text": "ああ、わかりました。えっと、それならドルイドのクラフトですね。ドルイド。"}, {"type": "subtitle", "time": 6993.03, "timestamp": "01:56:33", "text": "ドルイドのクラフトはこちらです。"}, {"type": "subtitle", "time": 6997.03, "timestamp": "01:56:37", "text": "これが重要な点です。"}, {"type": "subtitle", "time": 7002.629, "timestamp": "01:56:42", "text": "私は思う。実用的な方。"}, {"type": "subtitle", "time": 7003.91, "timestamp": "01:56:43", "text": "ユーティリティ１。"}, {"type": "subtitle", "time": 7007.189, "timestamp": "01:56:47", "text": "私はどうすべきだと思いますか？私は手に入れた"}, {"type": "subtitle", "time": 7009.109, "timestamp": "01:56:49", "text": "これまでのところ。たくさん手に入れた気がする"}, {"type": "subtitle", "time": 7011.75, "timestamp": "01:56:51", "text": "実用的ですよね？"}, {"type": "subtitle", "time": 7014.55, "timestamp": "01:56:54", "text": "M. 実際には、あなたは、"}, {"type": "subtitle", "time": 7016.55, "timestamp": "01:56:56", "text": "純粋にダメージを与えるもの"}, {"type": "subtitle", "time": 7018.39, "timestamp": "01:56:58", "text": "対処する。えっと、ダメージを受けたみたいですね"}]
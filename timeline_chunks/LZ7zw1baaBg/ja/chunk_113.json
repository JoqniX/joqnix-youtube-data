[{"type": "subtitle", "time": 6781.669, "timestamp": "01:53:01", "text": "レベルまで、ああ、実際、ええと、ああ、決して"}, {"type": "subtitle", "time": 6784.149, "timestamp": "01:53:04", "text": "心。両グループとも同じレベルだと思う"}, {"type": "subtitle", "time": 6785.669, "timestamp": "01:53:05", "text": "今は5人。レベルアップさせて"}, {"type": "subtitle", "time": 6787.109, "timestamp": "01:53:07", "text": "レベル5 なぜなら他の人たちは"}, {"type": "subtitle", "time": 6789.35, "timestamp": "01:53:09", "text": "レベル5。それで、私は、えーと"}, {"type": "subtitle", "time": 6791.669, "timestamp": "01:53:11", "text": "ゆっくりとご案内します。えっと、みんな"}, {"type": "subtitle", "time": 6794.07, "timestamp": "01:53:14", "text": "右。では、実際にあなたを手に入れましょう"}, {"type": "subtitle", "time": 6797.03, "timestamp": "01:53:17", "text": "まずレベル2へ。"}, {"type": "subtitle", "time": 6800.47, "timestamp": "01:53:20", "text": "だから、これをやってこれをクリックすると、"}, {"type": "subtitle", "time": 6803.03, "timestamp": "01:53:23", "text": "レベル2に到達すると"}, {"type": "subtitle", "time": 6805.99, "timestamp": "01:53:25", "text": "平均値を取る。まあ、あなたはそうしないでしょう"}, {"type": "subtitle", "time": 6808.87, "timestamp": "01:53:28", "text": "選択肢をすべて入手してください。つまりそれは自動で、"}, {"type": "subtitle", "time": 6810.31, "timestamp": "01:53:30", "text": "レベル3まで上げます"}, {"type": "subtitle", "time": 6811.43, "timestamp": "01:53:31", "text": "今。レベル３、あなたはいくつか"}, {"type": "subtitle", "time": 6812.95, "timestamp": "01:53:32", "text": "オプション。だから私は、"}, {"type": "subtitle", "time": 6816.31, "timestamp": "01:53:36", "text": "その手順をご案内します。"}, {"type": "subtitle", "time": 6822.95, "timestamp": "01:53:42", "text": "M. わかりました。平均値を取る。ああ、わかった。する"}, {"type": "subtitle", "time": 6826.47, "timestamp": "01:53:46", "text": "えっと、いいえ。わかりました。わかった。それで"}, {"type": "subtitle", "time": 6828.47, "timestamp": "01:53:48", "text": "こちらでは実際に"}, {"type": "subtitle", "time": 6830.07, "timestamp": "01:53:50", "text": "重複したデータを入手しました。だから、実際に"}, {"type": "subtitle", "time": 6832.79, "timestamp": "01:53:52", "text": "君はそれを交換した、君は君を手に入れた"}, {"type": "subtitle", "time": 6834.55, "timestamp": "01:53:54", "text": "呪文のためのガイダンスを選びました"}, {"type": "subtitle", "time": 6835.99, "timestamp": "01:53:55", "text": "以前。でもあなたはすでに"}, {"type": "subtitle", "time": 6838.87, "timestamp": "01:53:58", "text": "えっと、何ていう名前だったかな、ガイダンス"}]
[{"type": "subtitle", "time": 1440.23, "timestamp": "00:24:00", "text": "そうすれば、それはあなたの手元にあるはずです。"}, {"type": "subtitle", "time": 1442.31, "timestamp": "00:24:02", "text": "わかった。私はそれをクリックした。"}, {"type": "subtitle", "time": 1443.669, "timestamp": "00:24:03", "text": "うん。よし。"}, {"type": "subtitle", "time": 1445.59, "timestamp": "00:24:05", "text": "これがあなたのキャラクターシートです。私は"}, {"type": "subtitle", "time": 1447.83, "timestamp": "00:24:07", "text": "えっと、まず最初に、えっと"}, {"type": "subtitle", "time": 1450.549, "timestamp": "00:24:10", "text": "えっと、何か"}, {"type": "subtitle", "time": 1452.47, "timestamp": "00:24:12", "text": "あなたが思い描くキャラクターのように"}, {"type": "subtitle", "time": 1453.669, "timestamp": "00:24:13", "text": "遊ぶ？"}, {"type": "subtitle", "time": 1455.59, "timestamp": "00:24:15", "text": "わからない。"}, {"type": "subtitle", "time": 1458.23, "timestamp": "00:24:18", "text": "待って、どんなキャラクターがいるの？"}, {"type": "subtitle", "time": 1459.83, "timestamp": "00:24:19", "text": "ええと、それは本当にあなた次第です。あなたのような"}, {"type": "subtitle", "time": 1461.75, "timestamp": "00:24:21", "text": "あらゆる種類の建物を建てることができます"}, {"type": "subtitle", "time": 1463.59, "timestamp": "00:24:23", "text": "最終的にあなたが望むキャラクター"}, {"type": "subtitle", "time": 1466.23, "timestamp": "00:24:26", "text": "これはかなり自由なロールプレイングゲームです。それで"}, {"type": "subtitle", "time": 1468.47, "timestamp": "00:24:28", "text": "何でも作れるよ。ちょうど私"}, {"type": "subtitle", "time": 1471.43, "timestamp": "00:24:31", "text": "えっと、何が好きか考えてみてください"}, {"type": "subtitle", "time": 1475.51, "timestamp": "00:24:35", "text": "主にどのクラスでどの種ですか"}, {"type": "subtitle", "time": 1477.909, "timestamp": "00:24:37", "text": "あなたは特定の種族になりたい、あるいはそのような種族を好みます。"}, {"type": "subtitle", "time": 1479.59, "timestamp": "00:24:39", "text": "当時はそれをレースと呼んでいたが、今は"}, {"type": "subtitle", "time": 1482.47, "timestamp": "00:24:42", "text": "それを種と呼ぼう。"}, {"type": "subtitle", "time": 1483.99, "timestamp": "00:24:43", "text": "待って、どんな種類の種がいるの？"}, {"type": "subtitle", "time": 1485.669, "timestamp": "00:24:45", "text": "ああ、これはクリックできる。わかった。"}, {"type": "subtitle", "time": 1487.269, "timestamp": "00:24:47", "text": "はい、できますよ。ああ、クリックしないで"}, {"type": "subtitle", "time": 1489.51, "timestamp": "00:24:49", "text": "でも、えっと、私は"}, {"type": "subtitle", "time": 1492.71, "timestamp": "00:24:52", "text": "自分の能力値を最優先に考えてください。ただ"}, {"type": "subtitle", "time": 1495.029, "timestamp": "00:24:55", "text": "あなたが何をしたいか考えてみてください"}, {"type": "subtitle", "time": 1497.35, "timestamp": "00:24:57", "text": "最初にプレイする。何かアイデアはありますか？もし"}, {"type": "subtitle", "time": 1498.87, "timestamp": "00:24:58", "text": "知らないなら、あなたも好きになれる"}]
[{"type": "subtitle", "time": 6421.35, "timestamp": "01:47:01", "text": "星はどうですか"}, {"type": "chat", "time": 6422.726, "timestamp": "01:47:02", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "well see you at night than "}, {"type": "subtitle", "time": 6422.79, "timestamp": "01:47:02", "text": "ささやき？"}, {"type": "chat", "time": 6423.861, "timestamp": "01:47:03", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "bye"}, {"type": "subtitle", "time": 6426.31, "timestamp": "01:47:06", "text": "スターウィスプは範囲です。それは範囲です"}, {"type": "subtitle", "time": 6429.189, "timestamp": "01:47:09", "text": "ダメージを与える呪文、それは"}, {"type": "subtitle", "time": 6432.709, "timestamp": "01:47:12", "text": "誰であれ、わずかな実用価値"}, {"type": "chat", "time": 6435.344, "timestamp": "01:47:15", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "hai take care dayo"}, {"type": "subtitle", "time": 6435.51, "timestamp": "01:47:15", "text": "叩くと、かすかな光を発し、"}, {"type": "subtitle", "time": 6437.83, "timestamp": "01:47:17", "text": "見えないわけにはいかない。彼らはできない"}, {"type": "subtitle", "time": 6443.99, "timestamp": "01:47:23", "text": "ああ、私が叩いたものは何でも透明になるんだ。"}, {"type": "subtitle", "time": 6446.709, "timestamp": "01:47:26", "text": "えっと"}, {"type": "subtitle", "time": 6450.87, "timestamp": "01:47:30", "text": "敵を私に引き寄せる、ということですよね？"}, {"type": "subtitle", "time": 6453.189, "timestamp": "01:47:33", "text": "うん。トーンウィップは、えーと別の"}, {"type": "subtitle", "time": 6456.79, "timestamp": "01:47:36", "text": "ダメージ回復呪文、えーっと、それだけです"}, {"type": "subtitle", "time": 6458.55, "timestamp": "01:47:38", "text": "衝撃が弱いというわけではない。"}, {"type": "subtitle", "time": 6460.709, "timestamp": "01:47:40", "text": "ダメージは少し低いですが、"}, {"type": "subtitle", "time": 6463.43, "timestamp": "01:47:43", "text": "有用性があります。"}, {"type": "subtitle", "time": 6468.87, "timestamp": "01:47:48", "text": "クリーチャーを引き寄せることができる。えっと、もう一度何でしたっけ？それで"}, {"type": "subtitle", "time": 6471.109, "timestamp": "01:47:51", "text": "それは良いです。ダメージを与えるのに効果的です"}, {"type": "subtitle", "time": 6474.79, "timestamp": "01:47:54", "text": "サポート価値のあるキャンリップ"}, {"type": "subtitle", "time": 6476.47, "timestamp": "01:47:56", "text": "だって、自分の好きなように引き込めるから"}, {"type": "subtitle", "time": 6479.35, "timestamp": "01:47:59", "text": "例えば、最前線で働く人々。"}]
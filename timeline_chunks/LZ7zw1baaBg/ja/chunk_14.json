[{"type": "subtitle", "time": 845.75, "timestamp": "00:14:05", "text": "何てことだ。ニース。"}, {"type": "subtitle", "time": 848.79, "timestamp": "00:14:08", "text": "こうやって歌うんです。"}, {"type": "subtitle", "time": 851.269, "timestamp": "00:14:11", "text": "彼は"}, {"type": "subtitle", "time": 855.75, "timestamp": "00:14:15", "text": "ああ、それは気づいてたよ。私はちょっと"}, {"type": "subtitle", "time": 862.55, "timestamp": "00:14:22", "text": "なぜ私はこのように区切って説明するのでしょうか？"}, {"type": "subtitle", "time": 864.389, "timestamp": "00:14:24", "text": "わからない。"}, {"type": "subtitle", "time": 866.71, "timestamp": "00:14:26", "text": "あなたは本当に素晴らしいですね。"}, {"type": "subtitle", "time": 869.67, "timestamp": "00:14:29", "text": "こちらでは雨が降り始めた。"}, {"type": "subtitle", "time": 871.35, "timestamp": "00:14:31", "text": "おお、"}, {"type": "subtitle", "time": 873.59, "timestamp": "00:14:33", "text": "うん。そうそう。歌うだけでいいよ。これ"}, {"type": "subtitle", "time": 876.55, "timestamp": "00:14:36", "text": "5回目なので、歌って"}, {"type": "subtitle", "time": 878.79, "timestamp": "00:14:38", "text": "インストゥルメンタル。手に入れるべきだと思います"}, {"type": "subtitle", "time": 881.35, "timestamp": "00:14:41", "text": "インストゥルメンタル版に慣れている。私は"}, {"type": "subtitle", "time": 882.55, "timestamp": "00:14:42", "text": "歌ってもらうのは"}, {"type": "subtitle", "time": 884.79, "timestamp": "00:14:44", "text": "インストゥルメンタルバージョンは基本的に"}, {"type": "subtitle", "time": 886.47, "timestamp": "00:14:46", "text": "残りの試合。"}, {"type": "subtitle", "time": 889.269, "timestamp": "00:14:49", "text": "ええと、インストゥルメンタルだけで、ガイドはありません。"}, {"type": "subtitle", "time": 889.91, "timestamp": "00:14:49", "text": "わかった。"}, {"type": "subtitle", "time": 892.389, "timestamp": "00:14:52", "text": "うん。皆さんには効果がありません"}, {"type": "subtitle", "time": 895.03, "timestamp": "00:14:55", "text": "残念ながら。"}, {"type": "subtitle", "time": 896.629, "timestamp": "00:14:56", "text": "今度は、導きの声だ。わかった。"}, {"type": "subtitle", "time": 898.79, "timestamp": "00:14:58", "text": "うん。うまくいきません。"}, {"type": "subtitle", "time": 899.99, "timestamp": "00:14:59", "text": "こんにちは。"}]
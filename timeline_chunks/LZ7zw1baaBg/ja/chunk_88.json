[{"type": "subtitle", "time": 5281.59, "timestamp": "01:28:01", "text": "知覚において。えっと、知覚について"}, {"type": "subtitle", "time": 5283.59, "timestamp": "01:28:03", "text": "それは知恵のスキルである。だから知覚は"}, {"type": "subtitle", "time": 5285.83, "timestamp": "01:28:05", "text": "私が知覚を振るように言ったら、"}, {"type": "subtitle", "time": 5288.149, "timestamp": "01:28:08", "text": "d20を振って、3を足します"}, {"type": "subtitle", "time": 5289.669, "timestamp": "01:28:09", "text": "それはあなたの知恵から来ているから、そして"}, {"type": "subtitle", "time": 5291.83, "timestamp": "01:28:11", "text": "それは"}, {"type": "subtitle", "time": 5295.669, "timestamp": "01:28:15", "text": "あなたの熟練度ボーナス。"}, {"type": "subtitle", "time": 5298.07, "timestamp": "01:28:18", "text": "ああ、もしあなたがそれに長けているならね。もし"}, {"type": "subtitle", "time": 5299.51, "timestamp": "01:28:19", "text": "あなたは熟練していません、あなたは"}, {"type": "subtitle", "time": 5301.189, "timestamp": "01:28:21", "text": "始める。では、あなたがそうでないとしましょう"}, {"type": "subtitle", "time": 5303.669, "timestamp": "01:28:23", "text": "医学に精通している。もし私がそれを作ったら"}, {"type": "subtitle", "time": 5305.99, "timestamp": "01:28:25", "text": "えっと、もし私があなたに薬のロールをするように言ったら、"}, {"type": "subtitle", "time": 5308.629, "timestamp": "01:28:28", "text": "20面ダイスを振って、そこに知恵の値を加算します。それで"}, {"type": "subtitle", "time": 5313.03, "timestamp": "01:28:33", "text": "プラス３、それだけです。"}, {"type": "subtitle", "time": 5318.229, "timestamp": "01:28:38", "text": "自動的に計算されます。だから、"}, {"type": "subtitle", "time": 5321.69, "timestamp": "01:28:41", "text": "だから、心配しないでください。"}, {"type": "subtitle", "time": 5329.59, "timestamp": "01:28:49", "text": "H それは、私はこうしようと思う"}, {"type": "subtitle", "time": 5333.59, "timestamp": "01:28:53", "text": "宗教か、あるいは生存かのどちらかだ。は"}, {"type": "subtitle", "time": 5336.95, "timestamp": "01:28:56", "text": "ビットや、あなたが知っているようなものも良い"}, {"type": "subtitle", "time": 5339.669, "timestamp": "01:28:59", "text": "でも、どのチームがいいのかわからないから"}]
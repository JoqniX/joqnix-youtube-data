[{"type": "subtitle", "time": 10742.23, "timestamp": "02:59:02", "text": "更新してください。"}, {"type": "subtitle", "time": 10752.07, "timestamp": "02:59:12", "text": "もし接続が切れたら、影響はありますか？"}, {"type": "subtitle", "time": 10753.59, "timestamp": "02:59:13", "text": "ゲームプレイは？"}, {"type": "subtitle", "time": 10755.59, "timestamp": "02:59:15", "text": "いや、そうはならないよ。更新できます。"}, {"type": "subtitle", "time": 10758.15, "timestamp": "02:59:18", "text": "いつでも更新しても実際には"}, {"type": "subtitle", "time": 10761.11, "timestamp": "02:59:21", "text": "何をしても、あまり効果はないでしょう。ああ、それは"}, {"type": "subtitle", "time": 10763.59, "timestamp": "02:59:23", "text": "シャワー室か何かに保管しておくといいよ。"}, {"type": "subtitle", "time": 10765.03, "timestamp": "02:59:25", "text": "おお、"}, {"type": "subtitle", "time": 10766.55, "timestamp": "02:59:26", "text": "うん。うん。すべて安全です"}, {"type": "subtitle", "time": 10770.71, "timestamp": "02:59:30", "text": "PCの電源が入っている限り、自動的に動作します。"}, {"type": "subtitle", "time": 10774.55, "timestamp": "02:59:34", "text": "わかった。政府運営の売店。"}, {"type": "subtitle", "time": 10777.03, "timestamp": "02:59:37", "text": "ああ、わかった。"}, {"type": "subtitle", "time": 10784.79, "timestamp": "02:59:44", "text": "たくさんあります。ジャグラダー。"}, {"type": "subtitle", "time": 10787.19, "timestamp": "02:59:47", "text": "ええ、たくさんありますよ。"}, {"type": "subtitle", "time": 10790.95, "timestamp": "02:59:50", "text": "紙。何てことだ。紙は購入できます"}, {"type": "subtitle", "time": 10793.269, "timestamp": "02:59:53", "text": "何？手紙を書く。"}, {"type": "subtitle", "time": 10794.71, "timestamp": "02:59:54", "text": "うん。"}, {"type": "subtitle", "time": 10797.11, "timestamp": "02:59:57", "text": "関係"}]
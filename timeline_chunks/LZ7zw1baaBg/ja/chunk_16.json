[{"type": "subtitle", "time": 960.79, "timestamp": "00:16:00", "text": "[音楽]"}, {"type": "subtitle", "time": 984.71, "timestamp": "00:16:24", "text": "ええ、ずっと良くなりました。その部分"}, {"type": "subtitle", "time": 987.269, "timestamp": "00:16:27", "text": "あなたは自信がないですね。"}, {"type": "subtitle", "time": 990.31, "timestamp": "00:16:30", "text": "終盤のサコトは、"}, {"type": "subtitle", "time": 992.31, "timestamp": "00:16:32", "text": "少し歩き回っている。基本的には、それは"}, {"type": "subtitle", "time": 993.91, "timestamp": "00:16:33", "text": "何が起こっていますか。"}, {"type": "subtitle", "time": 995.35, "timestamp": "00:16:35", "text": "うん。"}, {"type": "subtitle", "time": 1000.23, "timestamp": "00:16:40", "text": "私はそれに気づき始めた。何てことだ。こんにちは。"}, {"type": "subtitle", "time": 1005.59, "timestamp": "00:16:45", "text": "カウとナウ、そして似たような2行"}, {"type": "subtitle", "time": 1008.47, "timestamp": "00:16:48", "text": "カウから。それは本当に素晴らしいですね。"}, {"type": "subtitle", "time": 1009.43, "timestamp": "00:16:49", "text": "おお、いいね。"}, {"type": "subtitle", "time": 1012.15, "timestamp": "00:16:52", "text": "うん、雰囲気はいい感じだ。"}, {"type": "subtitle", "time": 1014.389, "timestamp": "00:16:54", "text": "わかった。あと5分間歌ってもいいですよ"}, {"type": "subtitle", "time": 1016.47, "timestamp": "00:16:56", "text": "インストゥルメンタルで演奏する回数。それは"}, {"type": "subtitle", "time": 1017.269, "timestamp": "00:16:57", "text": "少ない。"}, {"type": "subtitle", "time": 1018.79, "timestamp": "00:16:58", "text": "うん。"}]
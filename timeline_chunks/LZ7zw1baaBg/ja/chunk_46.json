[{"type": "subtitle", "time": 2761.109, "timestamp": "00:46:01", "text": "そうすれば器用さを手に入れることができ、"}, {"type": "subtitle", "time": 2763.349, "timestamp": "00:46:03", "text": "憲法制定。"}, {"type": "subtitle", "time": 2764.71, "timestamp": "00:46:04", "text": "ああ、わかりました。わかった。"}, {"type": "subtitle", "time": 2766.309, "timestamp": "00:46:06", "text": "うん。うん。しかし、もしあなたがそうするなら、"}, {"type": "subtitle", "time": 2767.829, "timestamp": "00:46:07", "text": "知性と強さは"}, {"type": "subtitle", "time": 2772.47, "timestamp": "00:46:12", "text": "合計ポイントが27になるまでポイントを減らしてください。"}, {"type": "subtitle", "time": 2775.43, "timestamp": "00:46:15", "text": "おお、"}, {"type": "subtitle", "time": 2777.349, "timestamp": "00:46:17", "text": "わかった。わかった。えっと、"}, {"type": "subtitle", "time": 2778.95, "timestamp": "00:46:18", "text": "うん、それは本当にあなた次第だよ"}, {"type": "subtitle", "time": 2782.15, "timestamp": "00:46:22", "text": "それをいじりたくなるような気分になる"}, {"type": "subtitle", "time": 2785.589, "timestamp": "00:46:25", "text": "別の方法でも構いません。ああ、それでデックスは"}, {"type": "subtitle", "time": 2787.75, "timestamp": "00:46:27", "text": "体質と知恵が最大限に発揮される"}, {"type": "subtitle", "time": 2789.75, "timestamp": "00:46:29", "text": "ある意味では、外向きだ。"}, {"type": "subtitle", "time": 2791.91, "timestamp": "00:46:31", "text": "うん。うん。まあ、そんな感じですね。また、私は"}, {"type": "subtitle", "time": 2794.79, "timestamp": "00:46:34", "text": "たぶん、これは"}, {"type": "subtitle", "time": 2798.15, "timestamp": "00:46:38", "text": "このような建物も、ある意味、"}, {"type": "subtitle", "time": 2801.589, "timestamp": "00:46:41", "text": "キャスティングのようなものに強く惹かれるようになる。"}, {"type": "subtitle", "time": 2803.91, "timestamp": "00:46:43", "text": "だから、あなたはあまり上手くできないでしょう"}, {"type": "subtitle", "time": 2805.51, "timestamp": "00:46:45", "text": "ええと、例えば近接武器とか。もしあなたが"}, {"type": "subtitle", "time": 2807.43, "timestamp": "00:46:47", "text": "ちょっとえーとしたいなら"}, {"type": "subtitle", "time": 2808.71, "timestamp": "00:46:48", "text": "近接武器の扱いに長けているなら、"}, {"type": "subtitle", "time": 2811.19, "timestamp": "00:46:51", "text": "実際に器用さを身につけて"}, {"type": "subtitle", "time": 2813.91, "timestamp": "00:46:53", "text": "望むなら、筋力を鍛えればいい。"}, {"type": "subtitle", "time": 2817.19, "timestamp": "00:46:57", "text": "えっと、弓とか使ってもいいですか？"}]
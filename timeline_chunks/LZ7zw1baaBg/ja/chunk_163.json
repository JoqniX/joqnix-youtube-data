[{"type": "subtitle", "time": 9781.19, "timestamp": "02:43:01", "text": "それを通して。えっと、ダブルクリックすると"}, {"type": "subtitle", "time": 9784.95, "timestamp": "02:43:04", "text": "キャラクターシートを開くためのトークン。"}, {"type": "subtitle", "time": 9787.349, "timestamp": "02:43:07", "text": "だから私があなたに能力を作るように言うとき"}, {"type": "subtitle", "time": 9789.51, "timestamp": "02:43:09", "text": "チェック、1つに行きます"}, {"type": "subtitle", "time": 9792.87, "timestamp": "02:43:12", "text": "最初のタブ、歯車アイコン。"}, {"type": "subtitle", "time": 9796.309, "timestamp": "02:43:16", "text": "そして、私が"}, {"type": "subtitle", "time": 9798.07, "timestamp": "02:43:18", "text": "えっと、言ってみて。では、私があなたに作ってほしいとしましょう"}, {"type": "subtitle", "time": 9799.91, "timestamp": "02:43:19", "text": "秘術判定。アルカナをクリックします。それ"}, {"type": "subtitle", "time": 9803.91, "timestamp": "02:43:23", "text": "UIをポップアップ表示すればいいだけでしょう。そしてほとんどの"}, {"type": "subtitle", "time": 9812.55, "timestamp": "02:43:32", "text": "うん、それはそれでいいよ。そしてそれは"}, {"type": "subtitle", "time": 9815.59, "timestamp": "02:43:35", "text": "何かを転がすだろう。なんてこった。"}, {"type": "subtitle", "time": 9820.07, "timestamp": "02:43:40", "text": "もう20歳じゃないよ。ああ、でもそうだね、"}, {"type": "subtitle", "time": 9821.75, "timestamp": "02:43:41", "text": "それが能力を作る方法だ"}, {"type": "subtitle", "time": 9825.59, "timestamp": "02:43:45", "text": "チェック。そしてその隣は、ええと、隣です"}, {"type": "subtitle", "time": 9827.03, "timestamp": "02:43:47", "text": "セービングスローみたいなものがあるんだよ。保存"}, {"type": "subtitle", "time": 9829.59, "timestamp": "02:43:49", "text": "投げるよ、君に言うよ"}, {"type": "subtitle", "time": 9832.55, "timestamp": "02:43:52", "text": "あなたが、えっと、あなたが"}, {"type": "subtitle", "time": 9835.83, "timestamp": "02:43:55", "text": "範囲攻撃を受ける。えっと、じゃあ"}, {"type": "subtitle", "time": 9837.83, "timestamp": "02:43:57", "text": "例えば知恵を身につけようと試みる"}, {"type": "subtitle", "time": 9839.269, "timestamp": "02:43:59", "text": "保存。"}]
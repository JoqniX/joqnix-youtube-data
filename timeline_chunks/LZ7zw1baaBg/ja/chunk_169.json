[{"type": "subtitle", "time": 10140.95, "timestamp": "02:49:00", "text": "それ。そして私はただ応募するだけです"}, {"type": "subtitle", "time": 10149.03, "timestamp": "02:49:09", "text": "わかった。よし。何かありますか？"}, {"type": "subtitle", "time": 10149.59, "timestamp": "02:49:09", "text": "もしあなたがそうしないなら"}, {"type": "subtitle", "time": 10151.429, "timestamp": "02:49:11", "text": "なぜ体力ゲージがないのか"}, {"type": "subtitle", "time": 10152.23, "timestamp": "02:49:12", "text": "ゴブリン？"}, {"type": "subtitle", "time": 10155.83, "timestamp": "02:49:15", "text": "そうそう。えーと敵、えーと敵のHPは"}, {"type": "subtitle", "time": 10158.23, "timestamp": "02:49:18", "text": "通常は隠されている。えっと、必要ならできないよ"}, {"type": "subtitle", "time": 10160.309, "timestamp": "02:49:20", "text": "えっと、あなたの"}, {"type": "subtitle", "time": 10163.03, "timestamp": "02:49:23", "text": "勇気を出して、HPがどれくらいか調べよう"}, {"type": "subtitle", "time": 10164.63, "timestamp": "02:49:24", "text": "以前は残っていた。"}, {"type": "subtitle", "time": 10167.03, "timestamp": "02:49:27", "text": "ああ、わかりました。わかった。"}, {"type": "subtitle", "time": 10167.59, "timestamp": "02:49:27", "text": "うん。"}, {"type": "subtitle", "time": 10170.23, "timestamp": "02:49:30", "text": "HPバーは多くの点で異なります"}, {"type": "subtitle", "time": 10172.23, "timestamp": "02:49:32", "text": "別々の組織ですよね？"}, {"type": "subtitle", "time": 10175.429, "timestamp": "02:49:35", "text": "すべての生き物はそれぞれ異なる"}, {"type": "subtitle", "time": 10179.67, "timestamp": "02:49:39", "text": "異なる um HP。ええ、あなたの"}, {"type": "subtitle", "time": 10182.87, "timestamp": "02:49:42", "text": "友人のHPは含まれるが、敵のHPは含まれない。"}, {"type": "subtitle", "time": 10185.03, "timestamp": "02:49:45", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 10189.83, "timestamp": "02:49:49", "text": "うん。よし。わかった。えっと"}, {"type": "subtitle", "time": 10191.83, "timestamp": "02:49:51", "text": "一度あなたの"}, {"type": "subtitle", "time": 10194.23, "timestamp": "02:49:54", "text": "回転、クリックして回転すると、"}, {"type": "subtitle", "time": 10196.309, "timestamp": "02:49:56", "text": "次の人が動き始めても構いません。ええ、そうですね。"}, {"type": "subtitle", "time": 10197.91, "timestamp": "02:49:57", "text": "例えばここのように"}, {"type": "subtitle", "time": 10199.03, "timestamp": "02:49:59", "text": "敵は移動できる。これから作ります"}]
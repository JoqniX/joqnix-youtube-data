[{"type": "subtitle", "time": 5041.35, "timestamp": "01:24:01", "text": "応急処置をするだけで"}, {"type": "subtitle", "time": 5043.03, "timestamp": "01:24:03", "text": "あなたがそうしたいなら、そうすれば彼らは"}, {"type": "subtitle", "time": 5045.91, "timestamp": "01:24:05", "text": "彼らは出血多量で死ぬことはないだろう。ああ、私はできる"}, {"type": "subtitle", "time": 5047.51, "timestamp": "01:24:07", "text": "背中など。実際には治癒していない。"}, {"type": "subtitle", "time": 5049.27, "timestamp": "01:24:09", "text": "治癒ではないが、彼らはそうではない"}, {"type": "subtitle", "time": 5052.79, "timestamp": "01:24:12", "text": "HPを回復する。彼らはHPの減少を止めるだけだ。"}, {"type": "subtitle", "time": 5054.229, "timestamp": "01:24:14", "text": "TLDDR。"}, {"type": "subtitle", "time": 5056.709, "timestamp": "01:24:16", "text": "ああ、私は誰かからいくつか救うことができる"}, {"type": "subtitle", "time": 5058.149, "timestamp": "01:24:18", "text": "出血。わかった。"}, {"type": "subtitle", "time": 5061.27, "timestamp": "01:24:21", "text": "ええ、そういうことです。要するに、"}, {"type": "subtitle", "time": 5063.91, "timestamp": "01:24:23", "text": "生存。それは一体何をするものだったっけ？"}, {"type": "subtitle", "time": 5066.47, "timestamp": "01:24:26", "text": "生存とは、次のようなことをすることです"}, {"type": "subtitle", "time": 5069.99, "timestamp": "01:24:29", "text": "追跡、採集、そして、そう、物事"}, {"type": "subtitle", "time": 5071.189, "timestamp": "01:24:31", "text": "そんな感じ。"}, {"type": "subtitle", "time": 5094.149, "timestamp": "01:24:54", "text": "[音楽]"}]
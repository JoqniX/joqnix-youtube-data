[{"type": "subtitle", "time": 11401.11, "timestamp": "03:10:01", "text": "一部、やや複雑な部分がある。しかし"}, {"type": "subtitle", "time": 11402.87, "timestamp": "03:10:02", "text": "私がご案内します。"}, {"type": "subtitle", "time": 11405.19, "timestamp": "03:10:05", "text": "ええ、それは最も複雑なものの1つです"}, {"type": "subtitle", "time": 11406.79, "timestamp": "03:10:06", "text": "クラス。しかし、ワイルドシェイピングをしていないなら、"}, {"type": "subtitle", "time": 11408.55, "timestamp": "03:10:08", "text": "大丈夫でしょう。唯一の"}, {"type": "subtitle", "time": 11409.83, "timestamp": "03:10:09", "text": "本当に"}, {"type": "subtitle", "time": 11412.469, "timestamp": "03:10:12", "text": "複雑なのは、ワイルドシェイプのルールです。しかし"}, {"type": "subtitle", "time": 11414.55, "timestamp": "03:10:14", "text": "えっと、大丈夫だと思いますよ"}, {"type": "subtitle", "time": 11416.15, "timestamp": "03:10:16", "text": "ワイルドシェイプを使うことになる"}, {"type": "subtitle", "time": 11419.03, "timestamp": "03:10:19", "text": "ほとんどの場合、arro を使用します"}, {"type": "subtitle", "time": 11422.469, "timestamp": "03:10:22", "text": "とにかく、星の形をした魔法。"}, {"type": "subtitle", "time": 11424.469, "timestamp": "03:10:24", "text": "ええ、そうですね。よし。"}, {"type": "subtitle", "time": 11428.07, "timestamp": "03:10:28", "text": "大丈夫だと思います。"}, {"type": "subtitle", "time": 11429.03, "timestamp": "03:10:29", "text": "わかった。"}, {"type": "subtitle", "time": 11433.03, "timestamp": "03:10:33", "text": "わーい。今日は教えていただきありがとうございました。それ"}, {"type": "subtitle", "time": 11435.51, "timestamp": "03:10:35", "text": "とても助かりました。ありがとう。"}, {"type": "subtitle", "time": 11438.55, "timestamp": "03:10:38", "text": "わかった。土曜日に会いましょう。"}, {"type": "subtitle", "time": 11441.59, "timestamp": "03:10:41", "text": "またね。気をつけて。ハン。ありがとう。"}, {"type": "subtitle", "time": 11442.55, "timestamp": "03:10:42", "text": "おやすみ。"}, {"type": "subtitle", "time": 11449.429, "timestamp": "03:10:49", "text": "というわけで、以上がハンでした。ハン。私は"}, {"type": "subtitle", "time": 11451.67, "timestamp": "03:10:51", "text": "皆さんにお見せできなくて申し訳ありません"}, {"type": "subtitle", "time": 11455.11, "timestamp": "03:10:55", "text": "私たちがやっていたことは"}, {"type": "subtitle", "time": 11458.63, "timestamp": "03:10:58", "text": "土曜日の予定だったんだけど。土曜日"}]
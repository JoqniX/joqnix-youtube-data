[{"type": "subtitle", "time": 5645.27, "timestamp": "01:34:05", "text": "待つべきだと思う。ええと、私はライトを持っています、"}, {"type": "subtitle", "time": 5656.149, "timestamp": "01:34:16", "text": "もし私が選ぶなら、待って生産する"}, {"type": "subtitle", "time": 5658.31, "timestamp": "01:34:18", "text": "ガイダンス 私は今からサポートキャラクターになります"}, {"type": "subtitle", "time": 5661.11, "timestamp": "01:34:21", "text": "もし私が炎を選んだら、私はできる"}, {"type": "subtitle", "time": 5663.59, "timestamp": "01:34:23", "text": "損害賠償権"}, {"type": "subtitle", "time": 5665.91, "timestamp": "01:34:25", "text": "はい、2つ選べますよ。ちなみに2つ選んでください。"}, {"type": "subtitle", "time": 5666.39, "timestamp": "01:34:26", "text": "彼らの"}, {"type": "subtitle", "time": 5667.91, "timestamp": "01:34:27", "text": "ああ、わかった、わかった"}, {"type": "subtitle", "time": 5670.47, "timestamp": "01:34:30", "text": "はい、2つ選んでください"}, {"type": "subtitle", "time": 5673.35, "timestamp": "01:34:33", "text": "えーと"}, {"type": "subtitle", "time": 5675.11, "timestamp": "01:34:35", "text": "うんうん、まあ、一般的には"}, {"type": "subtitle", "time": 5676.709, "timestamp": "01:34:36", "text": "もしあなたが知らないなら、もしあなたが知らないなら"}, {"type": "subtitle", "time": 5678.79, "timestamp": "01:34:38", "text": "選ぶには、ダメージを与えるものを選ぶだけです"}, {"type": "subtitle", "time": 5686.31, "timestamp": "01:34:46", "text": "わかりました、ではガイダンスを選択します。"}, {"type": "subtitle", "time": 5687.99, "timestamp": "01:34:47", "text": "炎を生み出す。"}, {"type": "subtitle", "time": 5691.189, "timestamp": "01:34:51", "text": "誘導して炎を生み出す。何だって？"}, {"type": "subtitle", "time": 5692.95, "timestamp": "01:34:52", "text": "炎って何ですか？それは何ですか？わかった、"}, {"type": "subtitle", "time": 5694.629, "timestamp": "01:34:54", "text": "ここにあります。それが何なのか確認させてください"}, {"type": "subtitle", "time": 5697.59, "timestamp": "01:34:57", "text": "また。おお。おお。あらら。うん。うん。わかった。"}]
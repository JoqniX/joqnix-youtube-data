[{"type": "subtitle", "time": 7260.229, "timestamp": "02:01:00", "text": "ああ。"}, {"type": "subtitle", "time": 7262.629, "timestamp": "02:01:02", "text": "おお。純粋にダメージですよね？"}, {"type": "subtitle", "time": 7263.83, "timestamp": "02:01:03", "text": "うん。"}, {"type": "subtitle", "time": 7267.589, "timestamp": "02:01:07", "text": "ああ、それなら今の方が良くなるでしょう"}, {"type": "subtitle", "time": 7269.43, "timestamp": "02:01:09", "text": "私にとって。"}, {"type": "subtitle", "time": 7270.709, "timestamp": "02:01:10", "text": "それはあなた次第です。うん。あなたがしたい場合は"}, {"type": "subtitle", "time": 7271.99, "timestamp": "02:01:11", "text": "どうぞ、ご自由にお使いください。"}, {"type": "subtitle", "time": 7275.51, "timestamp": "02:01:15", "text": "わかった。えっと、死者数って何ですか？"}, {"type": "subtitle", "time": 7276.229, "timestamp": "02:01:16", "text": "死者を背負う。"}, {"type": "subtitle", "time": 7278.55, "timestamp": "02:01:18", "text": "死者に告げた。えーと、あなたは持っていません"}, {"type": "subtitle", "time": 7280.07, "timestamp": "02:01:20", "text": "死者へのアクセス権。私はしません。"}, {"type": "subtitle", "time": 7281.669, "timestamp": "02:01:21", "text": "ええ、それはダメージを与えるものです"}, {"type": "subtitle", "time": 7282.95, "timestamp": "02:01:22", "text": "スペル。かなり良いダメージを与える"}, {"type": "subtitle", "time": 7285.27, "timestamp": "02:01:25", "text": "呪文ですが、あなたはそれにアクセスできません"}, {"type": "subtitle", "time": 7287.189, "timestamp": "02:01:27", "text": "あなたがそうなので。"}, {"type": "subtitle", "time": 7288.79, "timestamp": "02:01:28", "text": "わかった。"}, {"type": "subtitle", "time": 7291.99, "timestamp": "02:01:31", "text": "ええと、バックアンドファイアはここにはありません。それは"}, {"type": "subtitle", "time": 7295.109, "timestamp": "02:01:35", "text": "要素ですよね？理解できません。えっと、"}, {"type": "subtitle", "time": 7299.27, "timestamp": "02:01:39", "text": "わかった。それなら、えっと、魔法の石にします。"}, {"type": "subtitle", "time": 7301.91, "timestamp": "02:01:41", "text": "よし。わかった。魔法の石を追加します。"}, {"type": "subtitle", "time": 7304.79, "timestamp": "02:01:44", "text": "わかった。よし。それが君たちのキャンプ旅行だ。"}, {"type": "subtitle", "time": 7306.47, "timestamp": "02:01:46", "text": "よし。わかった。あなたを"}, {"type": "subtitle", "time": 7309.109, "timestamp": "02:01:49", "text": "レベル4になりました。"}, {"type": "subtitle", "time": 7310.87, "timestamp": "02:01:50", "text": "700。"}, {"type": "subtitle", "time": 7315.189, "timestamp": "02:01:55", "text": "わかった。よし。レベル4。えっと、"}, {"type": "subtitle", "time": 7317.35, "timestamp": "02:01:57", "text": "見る。ヒットポイントは平均値を取る。わかった。以上"}, {"type": "subtitle", "time": 7319.669, "timestamp": "02:01:59", "text": "ここでは別の種類のことを学ぶ。それで、えーと"}]
[{"type": "subtitle", "time": 1501.669, "timestamp": "00:25:01", "text": "えっと、まだ知らないなら、"}, {"type": "subtitle", "time": 1505.19, "timestamp": "00:25:05", "text": "また、私が書いたように、"}, {"type": "subtitle", "time": 1507.269, "timestamp": "00:25:07", "text": "すべてのクラスの概要、または"}, {"type": "subtitle", "time": 1508.47, "timestamp": "00:25:08", "text": "したくない"}, {"type": "subtitle", "time": 1510.95, "timestamp": "00:25:10", "text": "ブラウザを開いてください。"}, {"type": "subtitle", "time": 1512.95, "timestamp": "00:25:12", "text": "ああ、それは違う。そうじゃない。それは、えーと"}, {"type": "subtitle", "time": 1515.35, "timestamp": "00:25:15", "text": "持続する。それはどのボタンですか？"}, {"type": "subtitle", "time": 1519.269, "timestamp": "00:25:19", "text": "私は「種を追加」をクリックしました。"}, {"type": "subtitle", "time": 1521.11, "timestamp": "00:25:21", "text": "そうそう。うん。とりあえず、それは閉じておきましょう。"}, {"type": "subtitle", "time": 1522.47, "timestamp": "00:25:22", "text": "それを閉じてください、なぜならそれは"}, {"type": "subtitle", "time": 1525.51, "timestamp": "00:25:25", "text": "第二段階。 2番目のステップ"}, {"type": "subtitle", "time": 1528.149, "timestamp": "00:25:28", "text": "クリックすると、時々"}, {"type": "subtitle", "time": 1529.669, "timestamp": "00:25:29", "text": "面白いことをする。"}, {"type": "subtitle", "time": 1532.789, "timestamp": "00:25:32", "text": "よし。わかった。うん。うん。"}, {"type": "subtitle", "time": 1535.83, "timestamp": "00:25:35", "text": "えっと、あなたに送ります"}, {"type": "subtitle", "time": 1537.59, "timestamp": "00:25:37", "text": "もの。送ってみます"}, {"type": "subtitle", "time": 1539.029, "timestamp": "00:25:39", "text": "の上"}, {"type": "subtitle", "time": 1542.23, "timestamp": "00:25:42", "text": "えっと、あなたのDM。どこですか？えっと、"}, {"type": "subtitle", "time": 1543.59, "timestamp": "00:25:43", "text": "すぐに手に入れよう。ストリームだと思います"}, {"type": "subtitle", "time": 1544.789, "timestamp": "00:25:44", "text": "リソース。"}, {"type": "subtitle", "time": 1546.71, "timestamp": "00:25:46", "text": "わかった。つまり、こういうことなんです。私は行きます"}, {"type": "subtitle", "time": 1549.11, "timestamp": "00:25:49", "text": "あなたにお渡しします。でもこれも"}, {"type": "subtitle", "time": 1551.11, "timestamp": "00:25:51", "text": "見せてはいけないもの"}, {"type": "subtitle", "time": 1553.11, "timestamp": "00:25:53", "text": "ストリーム配信も理由があって"}, {"type": "subtitle", "time": 1555.83, "timestamp": "00:25:55", "text": "後で説明できるよ"}, {"type": "subtitle", "time": 1558.95, "timestamp": "00:25:58", "text": "ストリーム。でも、もし可能ならこちらへ"}]
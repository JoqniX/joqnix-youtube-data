[{"type": "subtitle", "time": 9481.349, "timestamp": "02:38:01", "text": "英雄的な集中力を持たないと、"}, {"type": "subtitle", "time": 9482.63, "timestamp": "02:38:02", "text": "呪文を唱えるだけで、"}, {"type": "subtitle", "time": 9484.71, "timestamp": "02:38:04", "text": "材料構成要素。もしあなたが持っているなら"}, {"type": "subtitle", "time": 9487.75, "timestamp": "02:38:07", "text": "それを持っていれば、えーっと、"}, {"type": "subtitle", "time": 9490.07, "timestamp": "02:38:10", "text": "ほとんどの呪文を唱えることができます。"}, {"type": "subtitle", "time": 9491.99, "timestamp": "02:38:11", "text": "呪文。"}, {"type": "subtitle", "time": 9494.55, "timestamp": "02:38:14", "text": "後で木製のものを買おうと思う。"}, {"type": "subtitle", "time": 9496.389, "timestamp": "02:38:16", "text": "うん。うん。うん。私はあなたの"}, {"type": "subtitle", "time": 9497.75, "timestamp": "02:38:17", "text": "木製の杖に焦点を合わせると、"}, {"type": "subtitle", "time": 9500.309, "timestamp": "02:38:20", "text": "垂れ下がった焦点は一般的な"}, {"type": "subtitle", "time": 9501.91, "timestamp": "02:38:21", "text": "変異体。だから、私はただ切り替えるだけです"}, {"type": "subtitle", "time": 9503.51, "timestamp": "02:38:23", "text": "それはスタッフへのメッセージです。"}, {"type": "subtitle", "time": 9506.87, "timestamp": "02:38:26", "text": "えっと、それをすぐに"}, {"type": "subtitle", "time": 9514.469, "timestamp": "02:38:34", "text": "アクションログはありますか？何が与えられるのか"}, {"type": "subtitle", "time": 9516.79, "timestamp": "02:38:36", "text": "そして全て？"}, {"type": "subtitle", "time": 9517.83, "timestamp": "02:38:37", "text": "何？ごめん。"}, {"type": "subtitle", "time": 9520.07, "timestamp": "02:38:40", "text": "アクションログのようなものはありますか？"}, {"type": "subtitle", "time": 9522.15, "timestamp": "02:38:42", "text": "人々に贈られる品物"}, {"type": "subtitle", "time": 9523.75, "timestamp": "02:38:43", "text": "等"}, {"type": "subtitle", "time": 9527.83, "timestamp": "02:38:47", "text": "そうそう。うん。えっと、ちょっと待って。まるで"}, {"type": "subtitle", "time": 9529.349, "timestamp": "02:38:49", "text": "えーと"}, {"type": "subtitle", "time": 9531.349, "timestamp": "02:38:51", "text": "いくつかは把握できていないが、"}, {"type": "subtitle", "time": 9532.87, "timestamp": "02:38:52", "text": "そのうちの一部だけ。わかった、行くよ"}, {"type": "subtitle", "time": 9534.55, "timestamp": "02:38:54", "text": "えっと、それを交換します。はい、どうぞ。"}, {"type": "subtitle", "time": 9537.83, "timestamp": "02:38:57", "text": "よし、じゃあ、えーと、四分音符をドラッグして"}]
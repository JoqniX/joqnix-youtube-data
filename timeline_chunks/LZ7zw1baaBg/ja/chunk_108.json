[{"type": "subtitle", "time": 6482.229, "timestamp": "01:48:02", "text": "おお。"}, {"type": "subtitle", "time": 6486.229, "timestamp": "01:48:06", "text": "えっと、凍傷を使えます。凍傷、"}, {"type": "subtitle", "time": 6487.43, "timestamp": "01:48:07", "text": "右？そして"}, {"type": "subtitle", "time": 6489.59, "timestamp": "01:48:09", "text": "凍傷。凍傷がどんなものか忘れてしまった。"}, {"type": "subtitle", "time": 6491.109, "timestamp": "01:48:11", "text": "ちょっと見せてください。凍傷は"}, {"type": "subtitle", "time": 6492.229, "timestamp": "01:48:12", "text": "こちらです。"}, {"type": "subtitle", "time": 6495.83, "timestamp": "01:48:15", "text": "えっと。ああ、わかりました。うん。えっと、凍傷です。"}, {"type": "subtitle", "time": 6499.109, "timestamp": "01:48:19", "text": "ええと、ダメージに関しては、ほぼ同じです"}, {"type": "subtitle", "time": 6501.03, "timestamp": "01:48:21", "text": "棘の鞭。ただ、その効用は"}, {"type": "subtitle", "time": 6502.79, "timestamp": "01:48:22", "text": "価値は敵が"}, {"type": "subtitle", "time": 6504.87, "timestamp": "01:48:24", "text": "攻撃ロールに不利"}, {"type": "subtitle", "time": 6508.07, "timestamp": "01:48:28", "text": "次のターンの終了。"}, {"type": "subtitle", "time": 6519.27, "timestamp": "01:48:39", "text": "[音楽]"}, {"type": "subtitle", "time": 6522.07, "timestamp": "01:48:42", "text": "ああ、デバフがあるんですね？"}, {"type": "subtitle", "time": 6525.59, "timestamp": "01:48:45", "text": "うん。うん。多くの人が"}, {"type": "subtitle", "time": 6528.149, "timestamp": "01:48:48", "text": "ダメージを与える呪文のダメージは少なくなります"}, {"type": "subtitle", "time": 6529.75, "timestamp": "01:48:49", "text": "ダメージ。例えば、これだけ"}, {"type": "subtitle", "time": 6532.229, "timestamp": "01:48:52", "text": "1d6のダメージを与えるが、これは大したダメージではない。"}, {"type": "subtitle", "time": 6535.51, "timestamp": "01:48:55", "text": "何らかの有用価値を持っている"}, {"type": "subtitle", "time": 6537.35, "timestamp": "01:48:57", "text": "主に群衆制御関連の"}]
[{"type": "subtitle", "time": 7861.75, "timestamp": "02:11:01", "text": "編集、あのえーっと、何て言うんだっけ"}, {"type": "subtitle", "time": 7863.51, "timestamp": "02:11:03", "text": "誤ってオフにしないように"}, {"type": "subtitle", "time": 7867.27, "timestamp": "02:11:07", "text": "えっと、何て呼ぶんだっけ。ああ、大変だ"}, {"type": "subtitle", "time": 7870.55, "timestamp": "02:11:10", "text": "何かおかしい。ええ、そうですね。それで、こちら側では、えーと"}, {"type": "subtitle", "time": 7872.47, "timestamp": "02:11:12", "text": "これがあなたの呪文リストです。見てみると"}, {"type": "subtitle", "time": 7874.31, "timestamp": "02:11:14", "text": "一番上には、根元と書いてあります。のように"}, {"type": "subtitle", "time": 7875.99, "timestamp": "02:11:15", "text": "一番上には、小さなバーがあって、"}, {"type": "subtitle", "time": 7878.069, "timestamp": "02:11:18", "text": "ドゥルーの呪文詠唱。ゼロを準備すると書いてあります"}, {"type": "subtitle", "time": 7880.31, "timestamp": "02:11:20", "text": "9つのうちですよね？"}, {"type": "subtitle", "time": 7881.03, "timestamp": "02:11:21", "text": "うん。"}, {"type": "subtitle", "time": 7887.109, "timestamp": "02:11:27", "text": "魔法が手に入るまで、えーと、あなたは"}, {"type": "subtitle", "time": 7890.31, "timestamp": "02:11:30", "text": "9つの呪文を準備する。ああ、できるよ"}, {"type": "subtitle", "time": 7892.629, "timestamp": "02:11:32", "text": "9つの呪文を準備する。ご自由に準備してください"}, {"type": "subtitle", "time": 7894.79, "timestamp": "02:11:34", "text": "自由に呪文を準備してください"}, {"type": "subtitle", "time": 7897.03, "timestamp": "02:11:37", "text": "欲しい。これは、"}, {"type": "subtitle", "time": 7900.87, "timestamp": "02:11:40", "text": "ええと、長時間の休憩を取るたびに。"}, {"type": "subtitle", "time": 7904.39, "timestamp": "02:11:44", "text": "ああ、でも、でも、呪文は"}, {"type": "subtitle", "time": 7905.99, "timestamp": "02:11:45", "text": "既に準備済みです。"}, {"type": "subtitle", "time": 7907.51, "timestamp": "02:11:47", "text": "そうそう。それはそれはすでにそれは"}, {"type": "subtitle", "time": 7908.87, "timestamp": "02:11:48", "text": "常に準備万端でいるのは、それが一種の"}, {"type": "subtitle", "time": 7910.629, "timestamp": "02:11:50", "text": "まるで生まれつき備わっている魔法のようだ"}, {"type": "subtitle", "time": 7912.95, "timestamp": "02:11:52", "text": "あなたへ。だから、それはカウントされない"}, {"type": "subtitle", "time": 7915.99, "timestamp": "02:11:55", "text": "あなたが準備した呪文へ。んー"}, {"type": "subtitle", "time": 7918.229, "timestamp": "02:11:58", "text": "ああ、わかりました。"}]
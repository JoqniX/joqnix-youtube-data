[{"type": "subtitle", "time": 2401.51, "timestamp": "00:40:01", "text": "また。"}, {"type": "subtitle", "time": 2403.51, "timestamp": "00:40:03", "text": "そのウェブサイトで私たちは決定します"}, {"type": "subtitle", "time": 2405.43, "timestamp": "00:40:05", "text": "あなたの統計情報。おそらくもっと簡単だと思います"}, {"type": "subtitle", "time": 2407.349, "timestamp": "00:40:07", "text": "あなたが共有する人なら、そして私は"}, {"type": "subtitle", "time": 2409.51, "timestamp": "00:40:09", "text": "君に会えるように、"}, {"type": "subtitle", "time": 2411.19, "timestamp": "00:40:11", "text": "あなたは行動を起こす。"}, {"type": "subtitle", "time": 2424.31, "timestamp": "00:40:24", "text": "わかった。"}, {"type": "subtitle", "time": 2427.109, "timestamp": "00:40:27", "text": "そうねぇ。"}, {"type": "subtitle", "time": 2429.03, "timestamp": "00:40:29", "text": "わかった。うん。よし。それで、こちら側では"}, {"type": "subtitle", "time": 2431.589, "timestamp": "00:40:31", "text": "レースは今のところ空のままにしておく。えっと、"}, {"type": "subtitle", "time": 2433.829, "timestamp": "00:40:33", "text": "そして能力スコアは、"}, {"type": "subtitle", "time": 2436.63, "timestamp": "00:40:36", "text": "統計情報が得られるまで上に移動してください"}, {"type": "subtitle", "time": 2440.069, "timestamp": "00:40:40", "text": "あなたにとって効果的だと感じるもの。"}, {"type": "subtitle", "time": 2441.829, "timestamp": "00:40:41", "text": "そして、あなたがドルイドをプレイしているなら、"}, {"type": "subtitle", "time": 2446.39, "timestamp": "00:40:46", "text": "一般的にドルイドは多くの知恵を用いる。"}, {"type": "subtitle", "time": 2448.71, "timestamp": "00:40:48", "text": "ええと、他のものは、あなたがどのように"}, {"type": "subtitle", "time": 2450.15, "timestamp": "00:40:50", "text": "その他は、あなたがどうしたいかによって大きく変わります"}, {"type": "subtitle", "time": 2451.75, "timestamp": "00:40:51", "text": "遊ぶ。"}, {"type": "subtitle", "time": 2455.43, "timestamp": "00:40:55", "text": "えっと、私の能力値は27ポイントです。わかった。"}, {"type": "subtitle", "time": 2459.27, "timestamp": "00:40:59", "text": "あなたは27ポイントを持っています"}]
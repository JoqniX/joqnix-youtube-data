[{"type": "subtitle", "time": 11940.87, "timestamp": "03:19:00", "text": "動的更新。"}, {"type": "subtitle", "time": 11945.269, "timestamp": "03:19:05", "text": "ああ、75Hzに設定できますよ。"}, {"type": "subtitle", "time": 11947.429, "timestamp": "03:19:07", "text": "おお。わかった。待って。できます。ああ、いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 11954.61, "timestamp": "03:19:14", "text": "しかし、ディスプレイの見栄えが悪い。"}, {"type": "subtitle", "time": 11957.83, "timestamp": "03:19:17", "text": "[音楽]"}, {"type": "subtitle", "time": 11959.99, "timestamp": "03:19:19", "text": "待って、なぜディスプレイの調子が悪いの？探しています"}, {"type": "subtitle", "time": 11962.309, "timestamp": "03:19:22", "text": "悪い。"}, {"type": "subtitle", "time": 11967.83, "timestamp": "03:19:27", "text": "1366×768であるべき"}, {"type": "subtitle", "time": 11969.51, "timestamp": "03:19:29", "text": "解決。"}, {"type": "subtitle", "time": 11978.55, "timestamp": "03:19:38", "text": "なぜアイコンがこんなにおかしく見えるのか？"}, {"type": "subtitle", "time": 11982.389, "timestamp": "03:19:42", "text": "Windowsのアップデートはありましたか？"}, {"type": "subtitle", "time": 11984.55, "timestamp": "03:19:44", "text": "それはあなたの"}, {"type": "subtitle", "time": 11988.309, "timestamp": "03:19:48", "text": "えっと、それだとあなたのアイコンがすごく"}, {"type": "subtitle", "time": 11990.87, "timestamp": "03:19:50", "text": "小さい。私のアイコンがどうなっているか見てみたいですか？"}, {"type": "subtitle", "time": 11993.03, "timestamp": "03:19:53", "text": "今の状況はどんな感じですか？待って、見せてあげる"}, {"type": "subtitle", "time": 11999.51, "timestamp": "03:19:59", "text": "そこには。えっと、"}]
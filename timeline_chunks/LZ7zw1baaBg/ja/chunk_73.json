[{"type": "subtitle", "time": 4385.83, "timestamp": "01:13:05", "text": "えっと、エルフかハーフリング。わかった。"}, {"type": "subtitle", "time": 4387.02, "timestamp": "01:13:07", "text": "アビソ。"}, {"type": "subtitle", "time": 4389.91, "timestamp": "01:13:09", "text": "[音楽]"}, {"type": "subtitle", "time": 4392.709, "timestamp": "01:13:12", "text": "では、待ってください。えっと、"}, {"type": "subtitle", "time": 4395.669, "timestamp": "01:13:15", "text": "言語はあなたにとってどのような点で役立ちますか？"}, {"type": "subtitle", "time": 4399.83, "timestamp": "01:13:19", "text": "ええと、それほど多くはありません。それは、"}, {"type": "subtitle", "time": 4401.27, "timestamp": "01:13:21", "text": "ロールプレイング関連のもの。実際には来ない"}, {"type": "subtitle", "time": 4404.47, "timestamp": "01:13:24", "text": "過度に。繰り返しますが、少なくとも私のスタイルでは"}, {"type": "subtitle", "time": 4406.07, "timestamp": "01:13:26", "text": "DMのように、それは実際には"}, {"type": "subtitle", "time": 4410.63, "timestamp": "01:13:30", "text": "過度に。それは非常にまれにしか起こりません"}, {"type": "subtitle", "time": 4413.16, "timestamp": "01:13:33", "text": "うん、そうだね"}, {"type": "subtitle", "time": 4414.709, "timestamp": "01:13:34", "text": "[音楽]"}, {"type": "subtitle", "time": 4416.63, "timestamp": "01:13:36", "text": "それはただそういう類の"}, {"type": "subtitle", "time": 4420.07, "timestamp": "01:13:40", "text": "ゲーム内に存在しているだけですが、正直"}, {"type": "subtitle", "time": 4425.11, "timestamp": "01:13:45", "text": "あまり使ってないんです。"}, {"type": "subtitle", "time": 4427.75, "timestamp": "01:13:47", "text": "待って、私はアストラルエルフだから、"}, {"type": "subtitle", "time": 4430.229, "timestamp": "01:13:50", "text": "エルフ語はもう知っていますか？"}, {"type": "subtitle", "time": 4433.27, "timestamp": "01:13:53", "text": "えっと、あなたは実際にはこれが好きではないのですね"}, {"type": "subtitle", "time": 4435.91, "timestamp": "01:13:55", "text": "面白い。エルフは生まれつき知らない"}]
[{"type": "subtitle", "time": 11763.03, "timestamp": "03:16:03", "text": "適切な音楽コラボレーションを行うことについて"}, {"type": "subtitle", "time": 11765.59, "timestamp": "03:16:05", "text": "第二部"}, {"type": "subtitle", "time": 11767.75, "timestamp": "03:16:07", "text": "えーっと、歌のコラボみたいな歌"}, {"type": "subtitle", "time": 11769.51, "timestamp": "03:16:09", "text": "2部目の練習コラボレーション"}, {"type": "subtitle", "time": 11771.75, "timestamp": "03:16:11", "text": "まだセクションはありません。"}, {"type": "subtitle", "time": 11774.07, "timestamp": "03:16:14", "text": "つまり、まだ最初の部分の練習段階だということですね。"}, {"type": "subtitle", "time": 11776.389, "timestamp": "03:16:16", "text": "最初の部分をまだ完璧にしようとしているところです"}, {"type": "subtitle", "time": 11779.03, "timestamp": "03:16:19", "text": "今のところ得意なことなので。うん、"}, {"type": "subtitle", "time": 11783.349, "timestamp": "03:16:23", "text": "それは良い。それはいいです。それはいいです。"}, {"type": "subtitle", "time": 11786.71, "timestamp": "03:16:26", "text": "だから私の側からすると、明日あなたができることは"}, {"type": "subtitle", "time": 11789.67, "timestamp": "03:16:29", "text": "期待は一つで、私たちは"}, {"type": "subtitle", "time": 11792.309, "timestamp": "03:16:32", "text": "ウェブサイトの仕上げ作業が残っています。それは"}, {"type": "subtitle", "time": 11796.95, "timestamp": "03:16:36", "text": "1つ。二。ええと、私はそうしたいです"}, {"type": "subtitle", "time": 11808.71, "timestamp": "03:16:48", "text": "ええと、どう言えばいいでしょうか？"}, {"type": "subtitle", "time": 11813.99, "timestamp": "03:16:53", "text": "えっと、私はいくつかやらなければならないことは分かっています"}, {"type": "subtitle", "time": 11817.99, "timestamp": "03:16:57", "text": "ゲーム配信とかそういうもの。"}]
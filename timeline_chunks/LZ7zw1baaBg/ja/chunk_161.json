[{"type": "subtitle", "time": 9660.55, "timestamp": "02:41:00", "text": "ダメージ。そう、それはもっとまたは"}, {"type": "subtitle", "time": 9663.99, "timestamp": "02:41:03", "text": "君のやり方、君のやり方、電話"}, {"type": "subtitle", "time": 9668.95, "timestamp": "02:41:08", "text": "また、自分の持ち物を決めるためにサイコロを振ります。"}, {"type": "subtitle", "time": 9672.309, "timestamp": "02:41:12", "text": "もう一度電話してください"}, {"type": "subtitle", "time": 9674.95, "timestamp": "02:41:14", "text": "えっと、今攻撃しています。うん、たぶん"}, {"type": "subtitle", "time": 9676.63, "timestamp": "02:41:16", "text": "サイコロの話ですが、"}, {"type": "subtitle", "time": 9677.99, "timestamp": "02:41:17", "text": "必要であればサイコロを変えても構いません。始まってる"}, {"type": "subtitle", "time": 9681.03, "timestamp": "02:41:21", "text": "設定。えっと"}, {"type": "subtitle", "time": 9683.99, "timestamp": "02:41:23", "text": "デフォルトでは、全員が設定します。"}, {"type": "subtitle", "time": 9686.23, "timestamp": "02:41:26", "text": "同じサイコロですが、変更することもできます。えっと"}, {"type": "subtitle", "time": 9688.63, "timestamp": "02:41:28", "text": "例えば、私がこのように転がったら、"}, {"type": "subtitle", "time": 9690.87, "timestamp": "02:41:30", "text": "の上。えっと"}, {"type": "subtitle", "time": 9693.91, "timestamp": "02:41:33", "text": "えっと、転がせるよ、それから"}, {"type": "subtitle", "time": 9696.15, "timestamp": "02:41:36", "text": "ロール状のものが好きになるでしょう。ああ、でもあなたは"}, {"type": "subtitle", "time": 9698.469, "timestamp": "02:41:38", "text": "必要であれば設定で変更できます。"}, {"type": "subtitle", "time": 9698.95, "timestamp": "02:41:38", "text": "ん。"}, {"type": "subtitle", "time": 9699.91, "timestamp": "02:41:39", "text": "ああ、それはいいですね。"}, {"type": "subtitle", "time": 9701.429, "timestamp": "02:41:41", "text": "もしくはチャットをスクロールすると、"}, {"type": "subtitle", "time": 9703.51, "timestamp": "02:41:43", "text": "そこにも表示されるはずです。"}, {"type": "subtitle", "time": 9705.11, "timestamp": "02:41:45", "text": "ああ、8番だ。"}, {"type": "subtitle", "time": 9707.03, "timestamp": "02:41:47", "text": "いや、いや。上にスクロールすると、"}, {"type": "subtitle", "time": 9709.59, "timestamp": "02:41:49", "text": "もう少し上にスクロールしてください。えっと、止まって"}, {"type": "subtitle", "time": 9712.15, "timestamp": "02:41:52", "text": "少し。少し下がった。はい、どうぞ。うん。あなた"}, {"type": "subtitle", "time": 9713.429, "timestamp": "02:41:53", "text": "あれが見えますか？サイコロをきれいに"}, {"type": "subtitle", "time": 9715.27, "timestamp": "02:41:55", "text": "設定。クリックして「いいね！」"}, {"type": "subtitle", "time": 9718.23, "timestamp": "02:41:58", "text": "そうすれば、いろいろなものをいじれるようになります。"}]
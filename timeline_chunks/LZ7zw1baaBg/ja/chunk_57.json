[{"type": "subtitle", "time": 3421.99, "timestamp": "00:57:01", "text": "なぜ人間は未だに完璧な存在なのか？わかった。えっと"}, {"type": "subtitle", "time": 3427.91, "timestamp": "00:57:07", "text": "M."}, {"type": "subtitle", "time": 3432.15, "timestamp": "00:57:12", "text": "おお。ああ、VGM。持続する。えっと、ちょっと見てみましょう。"}, {"type": "subtitle", "time": 3434.47, "timestamp": "00:57:14", "text": "そうそう。もしあなたが選びたいなら"}, {"type": "subtitle", "time": 3436.63, "timestamp": "00:57:16", "text": "それは、ええと、あなたに任せます。私はただ"}, {"type": "subtitle", "time": 3438.23, "timestamp": "00:57:18", "text": "すぐにインポートしてください。"}, {"type": "subtitle", "time": 3439.51, "timestamp": "00:57:19", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 3440.789, "timestamp": "00:57:20", "text": "あなたは＿＿したいですか"}, {"type": "subtitle", "time": 3449.829, "timestamp": "00:57:29", "text": "えっと、"}, {"type": "subtitle", "time": 3452.39, "timestamp": "00:57:32", "text": "テレポートと領主。わかった。待って。あなたが知っている"}, {"type": "subtitle", "time": 3454.87, "timestamp": "00:57:34", "text": "踊る光、聖なる炎のために、"}, {"type": "subtitle", "time": 3457.67, "timestamp": "00:57:37", "text": "知恵。ああ、知性、知恵、"}, {"type": "subtitle", "time": 3461.99, "timestamp": "00:57:41", "text": "カリスマ。おお。あ、待って。カリスマ。私は必要とする"}, {"type": "subtitle", "time": 3464.87, "timestamp": "00:57:44", "text": "カリスマ。ちょっと待って。"}, {"type": "subtitle", "time": 3467.99, "timestamp": "00:57:47", "text": "ああ、星界にはカリスマ性が必要だ。おお、"}, {"type": "subtitle", "time": 3470.549, "timestamp": "00:57:50", "text": "そうねぇ。えっと、"}, {"type": "subtitle", "time": 3473.829, "timestamp": "00:57:53", "text": "念のため、もう一度確認してください。"}, {"type": "subtitle", "time": 3475.589, "timestamp": "00:57:55", "text": "それは何ですか？"}, {"type": "subtitle", "time": 3477.27, "timestamp": "00:57:57", "text": "投擲。"}, {"type": "subtitle", "time": 3479.19, "timestamp": "00:57:59", "text": "何が必要ですか？カリスマ。私はしません"}]
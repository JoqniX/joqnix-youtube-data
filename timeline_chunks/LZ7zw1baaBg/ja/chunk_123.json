[{"type": "subtitle", "time": 7381.75, "timestamp": "02:03:01", "text": "[音楽]"}, {"type": "subtitle", "time": 7387.35, "timestamp": "02:03:07", "text": "待って。魔法が尽きそうになったら、"}, {"type": "subtitle", "time": 7392.229, "timestamp": "02:03:12", "text": "Panaを使用してください。だから、シリーラグは"}, {"type": "subtitle", "time": 7394.149, "timestamp": "02:03:14", "text": "助けてよ、そうでしょ？"}, {"type": "subtitle", "time": 7396.87, "timestamp": "02:03:16", "text": "ええ、そうです。持っている場合のみ"}, {"type": "subtitle", "time": 7400.31, "timestamp": "02:03:20", "text": "スタッフですが、シリーはかなり良いです"}, {"type": "subtitle", "time": 7402.55, "timestamp": "02:03:22", "text": "これはかなり優秀なダメージを与える呪文だ。"}, {"type": "subtitle", "time": 7405.27, "timestamp": "02:03:25", "text": "えっと、でも近接戦闘をするには"}, {"type": "subtitle", "time": 7407.109, "timestamp": "02:03:27", "text": "これ。その点だけは覚えておいてください。必要"}, {"type": "subtitle", "time": 7409.27, "timestamp": "02:03:29", "text": "実際に人を殴る。"}, {"type": "subtitle", "time": 7410.39, "timestamp": "02:03:30", "text": "これは近接攻撃専用のものです。"}, {"type": "subtitle", "time": 7413.189, "timestamp": "02:03:33", "text": "だから、杖かクラブを買う必要がある。"}, {"type": "subtitle", "time": 7413.589, "timestamp": "02:03:33", "text": "右？"}, {"type": "subtitle", "time": 7417.189, "timestamp": "02:03:37", "text": "あなたは既に持っていると思いますよ。ああ、わかった。"}, {"type": "subtitle", "time": 7418.95, "timestamp": "02:03:38", "text": "ええ、ドロイドに焦点を当てています。"}, {"type": "subtitle", "time": 7420.95, "timestamp": "02:03:40", "text": "スタッフです。ええ、そうします"}, {"type": "subtitle", "time": 7427.589, "timestamp": "02:03:47", "text": "ああ、ドロイドに焦点を当てているんですね？"}, {"type": "subtitle", "time": 7430.229, "timestamp": "02:03:50", "text": "ええ、ドロイドフォーカスは、えーと、"}, {"type": "subtitle", "time": 7433.35, "timestamp": "02:03:53", "text": "何ですって？えっと、"}, {"type": "subtitle", "time": 7435.35, "timestamp": "02:03:55", "text": "ええ、木製の杖でも構いません。私はします"}, {"type": "subtitle", "time": 7439.75, "timestamp": "02:03:59", "text": "木製の杖と交換できます。えっと、"}]
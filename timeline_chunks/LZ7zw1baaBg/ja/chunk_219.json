[{"type": "subtitle", "time": 13141.91, "timestamp": "03:39:01", "text": "僕たちは兄弟らしい歌を歌うよ"}, {"type": "subtitle", "time": 13145.51, "timestamp": "03:39:05", "text": "その息子と。それらはそこにあるでしょう。"}, {"type": "subtitle", "time": 13148.07, "timestamp": "03:39:08", "text": "うん。うん。そうですね、もっと努力します"}, {"type": "subtitle", "time": 13150.389, "timestamp": "03:39:10", "text": "明日から活動開始。でも、今夜は"}, {"type": "subtitle", "time": 13154.469, "timestamp": "03:39:14", "text": "それを片付けて寝ます。病気"}, {"type": "subtitle", "time": 13156.63, "timestamp": "03:39:16", "text": "寝てみてください。"}, {"type": "subtitle", "time": 13161.67, "timestamp": "03:39:21", "text": "眠れるといいな。こんにちは、とにかく、"}, {"type": "subtitle", "time": 13163.67, "timestamp": "03:39:23", "text": "外は雨が降っているので、えーと"}, {"type": "subtitle", "time": 13165.75, "timestamp": "03:39:25", "text": "傘を持って階下へ行き、"}, {"type": "subtitle", "time": 13169.349, "timestamp": "03:39:29", "text": "家に入って夕食を食べ、"}, {"type": "subtitle", "time": 13172.469, "timestamp": "03:39:32", "text": "休んでください。とにかく、皆さんお元気で。"}, {"type": "subtitle", "time": 13174.95, "timestamp": "03:39:34", "text": "水分補給を忘れずに、食事を摂り、"}, {"type": "subtitle", "time": 13176.95, "timestamp": "03:39:36", "text": "睡眠、あなたがしなければならないことは何であれ"}, {"type": "subtitle", "time": 13179.59, "timestamp": "03:39:39", "text": "もの。そして、感謝の気持ちを伝えたいと思います。"}, {"type": "chat", "time": 13180.104, "timestamp": "03:39:40", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "good night jog"}, {"type": "subtitle", "time": 13183.269, "timestamp": "03:39:43", "text": "今日はよく頑張ってくれましたね。"}, {"type": "subtitle", "time": 13186.229, "timestamp": "03:39:46", "text": "お疲れ様でした。おやすみ"}, {"type": "subtitle", "time": 13189.51, "timestamp": "03:39:49", "text": "それでは皆さん、さようなら。"}, {"type": "subtitle", "time": 13193.269, "timestamp": "03:39:53", "text": "おやすみ。次はTwitchとキックです"}, {"type": "subtitle", "time": 13194.55, "timestamp": "03:39:54", "text": "Twitchで視聴している人や"}, {"type": "subtitle", "time": 13197.75, "timestamp": "03:39:57", "text": "蹴るか、そこで観戦したい。水"}]
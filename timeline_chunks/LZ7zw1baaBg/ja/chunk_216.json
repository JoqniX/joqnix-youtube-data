[{"type": "subtitle", "time": 12961.349, "timestamp": "03:36:01", "text": "うん、それはいい考えだね。明日私は"}, {"type": "subtitle", "time": 12964.55, "timestamp": "03:36:04", "text": "しなければならない"}, {"type": "subtitle", "time": 12967.99, "timestamp": "03:36:07", "text": "えっと、いくつか集まりに参加しないといけないですね。"}, {"type": "subtitle", "time": 12970.229, "timestamp": "03:36:10", "text": "友達数人と"}, {"type": "subtitle", "time": 12973.03, "timestamp": "03:36:13", "text": "しばらくぶりなので"}, {"type": "subtitle", "time": 12975.03, "timestamp": "03:36:15", "text": "私がハングアウトに登場して以来"}, {"type": "subtitle", "time": 12977.11, "timestamp": "03:36:17", "text": "実際に自分のコンテンツをストリーミング配信していて、"}, {"type": "chat", "time": 12978.502, "timestamp": "03:36:18", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "cya next time Joq"}, {"type": "subtitle", "time": 12981.03, "timestamp": "03:36:21", "text": "すべては今。彼らが恋しい。パン"}, {"type": "subtitle", "time": 12983.349, "timestamp": "03:36:23", "text": "みんな。"}, {"type": "subtitle", "time": 12987.75, "timestamp": "03:36:27", "text": "うん。彼らに加わらなきゃ"}, {"type": "subtitle", "time": 12991.51, "timestamp": "03:36:31", "text": "次回。またね、ジョー。こんにちは。"}, {"type": "subtitle", "time": 12997.91, "timestamp": "03:36:37", "text": "私は実際にフルバージョンを聴き始めました"}, {"type": "subtitle", "time": 13001.269, "timestamp": "03:36:41", "text": "その歌"}, {"type": "subtitle", "time": 13005.269, "timestamp": "03:36:45", "text": "ひよこ。こんにちは、ナニ"}, {"type": "subtitle", "time": 13010.63, "timestamp": "03:36:50", "text": "チコモ。あのアイスクリームの歌、だよね？"}, {"type": "subtitle", "time": 13012.15, "timestamp": "03:36:52", "text": "うん。聴き始めた。私は"}, {"type": "subtitle", "time": 13014.229, "timestamp": "03:36:54", "text": "なんていうか、これすごく可愛い曲だよね。欲しい"}, {"type": "subtitle", "time": 13016.229, "timestamp": "03:36:56", "text": "それを学ぶために。"}, {"type": "subtitle", "time": 13018.95, "timestamp": "03:36:58", "text": "うん、明日やるよ。心配ない。"}]
[{"type": "subtitle", "time": 6126.709, "timestamp": "01:42:06", "text": "[音楽]"}, {"type": "subtitle", "time": 6129.27, "timestamp": "01:42:09", "text": "だから、ここから選ばなければならないし、"}, {"type": "subtitle", "time": 6131.43, "timestamp": "01:42:11", "text": "そうなると、もう変更できないんですよね？"}, {"type": "subtitle", "time": 6133.03, "timestamp": "01:42:13", "text": "いやいや、いつもすべてのものを好きになれるわけじゃないよ"}, {"type": "subtitle", "time": 6134.87, "timestamp": "01:42:14", "text": "これを唱える時、あなたはそれを選ぶ。のように、"}, {"type": "subtitle", "time": 6137.03, "timestamp": "01:42:17", "text": "例えば、今回は"}, {"type": "subtitle", "time": 6138.709, "timestamp": "01:42:18", "text": "元素論が再び注目を集めている。次回は"}, {"type": "subtitle", "time": 6141.91, "timestamp": "01:42:21", "text": "地球上で元素魔法を使うことができる。それ"}, {"type": "subtitle", "time": 6143.91, "timestamp": "01:42:23", "text": "あなたは毎回選択できます。だから毎回"}, {"type": "subtitle", "time": 6146.07, "timestamp": "01:42:26", "text": "これを唱えると、どの効果を選ぶか"}, {"type": "subtitle", "time": 6147.109, "timestamp": "01:42:27", "text": "欲しい。"}, {"type": "subtitle", "time": 6150.47, "timestamp": "01:42:30", "text": "ああ、そっちの方がずっといいと思いませんか？"}, {"type": "subtitle", "time": 6152.149, "timestamp": "01:42:32", "text": "ええ、そうです。"}, {"type": "subtitle", "time": 6155.43, "timestamp": "01:42:35", "text": "わかった。つまり、私がもし私が"}, {"type": "subtitle", "time": 6159.91, "timestamp": "01:42:39", "text": "ユーティリティアイテムを使用し、私はトゲウェブを選択しました"}, {"type": "subtitle", "time": 6163.51, "timestamp": "01:42:43", "text": "そして次回はスターウェブを使える"}, {"type": "subtitle", "time": 6164.55, "timestamp": "01:42:44", "text": "そして、そんな感じ。"}, {"type": "subtitle", "time": 6167.91, "timestamp": "01:42:47", "text": "あらら。ああ、キャンリップスみたいなものってことだったんですね。のために"}, {"type": "subtitle", "time": 6170.79, "timestamp": "01:42:50", "text": "キャンリップス。これを選ぶと、"}, {"type": "subtitle", "time": 6173.03, "timestamp": "01:42:53", "text": "レベルアップするたびにしか変更できません"}, {"type": "subtitle", "time": 6174.39, "timestamp": "01:42:54", "text": "上。"}, {"type": "subtitle", "time": 6177.43, "timestamp": "01:42:57", "text": "ああ、わかりました。わかった。"}, {"type": "subtitle", "time": 6178.39, "timestamp": "01:42:58", "text": "私はあなたが"}, {"type": "subtitle", "time": 6179.35, "timestamp": "01:42:59", "text": "元素論。"}]
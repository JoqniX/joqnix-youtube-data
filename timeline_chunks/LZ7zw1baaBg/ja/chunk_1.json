[{"type": "subtitle", "time": 68.55, "timestamp": "00:01:08", "text": "わかった。それでは、皆さん、ようこそ。ようこそ"}, {"type": "subtitle", "time": 71.51, "timestamp": "00:01:11", "text": "ヨアトン134日目。"}, {"type": "subtitle", "time": 74.789, "timestamp": "00:01:14", "text": "ようこそ、ようこそ。えっと、ちょっと待ってください。"}, {"type": "subtitle", "time": 77.03, "timestamp": "00:01:17", "text": "歌を歌い始めます"}, {"type": "subtitle", "time": 80.07, "timestamp": "00:01:20", "text": "今は称賛されている。ちょっと待ってください、"}, {"type": "subtitle", "time": 89.749, "timestamp": "00:01:29", "text": "H."}, {"type": "subtitle", "time": 91.03, "timestamp": "00:01:31", "text": "おお、"}, {"type": "subtitle", "time": 92.71000000000001, "timestamp": "00:01:32", "text": "こんにちは。"}, {"type": "subtitle", "time": 100.63, "timestamp": "00:01:40", "text": "先ほどあなたと話しましたが、"}, {"type": "subtitle", "time": 101.19, "timestamp": "00:01:41", "text": "また。"}, {"type": "subtitle", "time": 104.63, "timestamp": "00:01:44", "text": "ええ、そう思いました"}, {"type": "subtitle", "time": 108.22999999999999, "timestamp": "00:01:48", "text": "昨日、4時頃だったと言っていましたね"}, {"type": "subtitle", "time": 110.38900000000001, "timestamp": "00:01:50", "text": "わかった。それで私は「わかった」と思った。それから"}, {"type": "subtitle", "time": 112.63, "timestamp": "00:01:52", "text": "チャットを送りたいです。それから私は"}, {"type": "subtitle", "time": 116.31, "timestamp": "00:01:56", "text": "例えば、「彼はまた寝ていると思う」といった感じ。"}, {"type": "subtitle", "time": 118.149, "timestamp": "00:01:58", "text": "うん。"}, {"type": "subtitle", "time": 119.59, "timestamp": "00:01:59", "text": "配信を開始しましたか？"}]
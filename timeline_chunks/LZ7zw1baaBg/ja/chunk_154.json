[{"type": "subtitle", "time": 9243.429, "timestamp": "02:34:03", "text": "うん。うん。わかった。えっと、今"}, {"type": "subtitle", "time": 9247.91, "timestamp": "02:34:07", "text": "ここから、えーと、トークンのところへ行きます。"}, {"type": "subtitle", "time": 9250.389, "timestamp": "02:34:10", "text": "トークンをクリアして、それを移動させてください"}, {"type": "subtitle", "time": 9252.389, "timestamp": "02:34:12", "text": "えーと、部屋みたいに、"}, {"type": "subtitle", "time": 9253.75, "timestamp": "02:34:13", "text": "えーと、私の部屋を見てください"}, {"type": "subtitle", "time": 9255.91, "timestamp": "02:34:15", "text": "取引ダミー。"}, {"type": "subtitle", "time": 9257.59, "timestamp": "02:34:17", "text": "Escキーを押すと、"}, {"type": "subtitle", "time": 9258.79, "timestamp": "02:34:18", "text": "ちなみに、皆さんの見解ですが、"}, {"type": "subtitle", "time": 9259.51, "timestamp": "02:34:19", "text": "わからない。"}, {"type": "subtitle", "time": 9261.429, "timestamp": "02:34:21", "text": "だから、そう、だってそれはあなたの"}, {"type": "subtitle", "time": 9263.11, "timestamp": "02:34:23", "text": "トークンのビュー。今や、それは誰もが抱く見解だ。"}, {"type": "subtitle", "time": 9264.63, "timestamp": "02:34:24", "text": "トークンを次のように移動してみてください。"}, {"type": "subtitle", "time": 9268.79, "timestamp": "02:34:28", "text": "訓練用ダミーのある部屋。"}, {"type": "subtitle", "time": 9272.07, "timestamp": "02:34:32", "text": "えっと、トレーニングダミーはどこに"}, {"type": "subtitle", "time": 9274.71, "timestamp": "02:34:34", "text": "ええと、そこにあるはずです。見ることができます"}, {"type": "subtitle", "time": 9277.99, "timestamp": "02:34:37", "text": "それ。それには名前がある。"}, {"type": "subtitle", "time": 9281.27, "timestamp": "02:34:41", "text": "トレーニング トレーニング"}, {"type": "subtitle", "time": 9283.11, "timestamp": "02:34:43", "text": "ピアノの隣。"}, {"type": "subtitle", "time": 9284.87, "timestamp": "02:34:44", "text": "ああ、これだ。ああ、わかりました。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 9286.469, "timestamp": "02:34:46", "text": "だから、私はそこに行かなければならない。"}, {"type": "subtitle", "time": 9288.55, "timestamp": "02:34:48", "text": "うん。あちらへ移動してみてください。あなたは知っていますか"}, {"type": "subtitle", "time": 9290.55, "timestamp": "02:34:50", "text": "どうすればいいですか？そうそう。クリックすると"}, {"type": "subtitle", "time": 9291.75, "timestamp": "02:34:51", "text": "コントロール、複数クリックできます"}, {"type": "subtitle", "time": 9294.79, "timestamp": "02:34:54", "text": "どこに行けるかを見極める時間。うん。"}, {"type": "subtitle", "time": 9297.67, "timestamp": "02:34:57", "text": "うん。わかった。"}, {"type": "subtitle", "time": 9299.51, "timestamp": "02:34:59", "text": "あなたを次の人のようにして、あなたを次の人に置くだけです"}]
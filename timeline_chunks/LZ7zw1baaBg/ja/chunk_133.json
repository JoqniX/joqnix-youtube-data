4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "he was a fairy~"}, {"type": "subtitle", "time": 8037.65, "timestamp": "02:13:57", "text": "月の光と魔法の呪文。"}]
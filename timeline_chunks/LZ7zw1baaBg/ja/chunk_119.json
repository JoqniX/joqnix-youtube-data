[{"type": "subtitle", "time": 7140.149, "timestamp": "01:59:00", "text": "弾薬。だから、あなたの周りのみんなは、"}, {"type": "subtitle", "time": 7148.229, "timestamp": "01:59:08", "text": "いや、そうではない。ああ、それはまずい。ああ、私は"}, {"type": "subtitle", "time": 7150.149, "timestamp": "01:59:10", "text": "知る。"}, {"type": "subtitle", "time": 7152.39, "timestamp": "01:59:12", "text": "えっと、"}, {"type": "subtitle", "time": 7154.95, "timestamp": "01:59:14", "text": "抵抗についてはどうでしょうか？それは実用的か？"}, {"type": "subtitle", "time": 7156.95, "timestamp": "01:59:16", "text": "抵抗は、あなたがより少ないものを取ることを可能にするだけです"}, {"type": "subtitle", "time": 7159.109, "timestamp": "01:59:19", "text": "ダメージ。何も持っていない場合は"}, {"type": "subtitle", "time": 7161.03, "timestamp": "01:59:21", "text": "集中する必要があるのは、"}, {"type": "subtitle", "time": 7162.629, "timestamp": "01:59:22", "text": "つまり、呪文に持続効果がある場合、"}, {"type": "subtitle", "time": 7164.149, "timestamp": "01:59:24", "text": "通常、それは集中力を持っている。もしあなたが"}, {"type": "subtitle", "time": 7165.03, "timestamp": "01:59:25", "text": "必要なものは何もありません"}, {"type": "subtitle", "time": 7166.629, "timestamp": "01:59:26", "text": "集中して、通常はただ"}, {"type": "subtitle", "time": 7170.07, "timestamp": "01:59:30", "text": "抵抗は役に立つ"}, {"type": "subtitle", "time": 7172.87, "timestamp": "01:59:32", "text": "なぜならそれはサポートだから"}, {"type": "subtitle", "time": 7174.79, "timestamp": "01:59:34", "text": "あなたまたは"}, {"type": "subtitle", "time": 7176.629, "timestamp": "01:59:36", "text": "まるで味方のように。消費量が少ないだけです"}, {"type": "subtitle", "time": 7177.94, "timestamp": "01:59:37", "text": "ダメージ。"}, {"type": "subtitle", "time": 7180.79, "timestamp": "01:59:40", "text": "[音楽]"}, {"type": "subtitle", "time": 7183.69, "timestamp": "01:59:43", "text": "えっと"}, {"type": "subtitle", "time": 7196.95, "timestamp": "01:59:56", "text": "この状況で、私はどうすべきだと思いますか？"}, {"type": "subtitle", "time": 7199.51, "timestamp": "01:59:59", "text": "待って、次のレベルでは別のものを選ぶことができます"}]
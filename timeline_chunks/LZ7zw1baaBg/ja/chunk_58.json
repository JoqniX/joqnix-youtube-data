[{"type": "subtitle", "time": 3483.75, "timestamp": "00:58:03", "text": "そう思うよ。えっと、"}, {"type": "subtitle", "time": 3487.19, "timestamp": "00:58:07", "text": "そうねぇ。なんてこった。うん。えっと、それはあなたです"}, {"type": "subtitle", "time": 3488.87, "timestamp": "00:58:08", "text": "もしあなたが星界の火について話しているのなら、"}, {"type": "subtitle", "time": 3490.95, "timestamp": "00:58:10", "text": "それはあなたが選ぶことです。どちらかを選択してください"}, {"type": "subtitle", "time": 3492.63, "timestamp": "00:58:12", "text": "知性、知恵、あるいはカリスマ性。そして"}, {"type": "subtitle", "time": 3494.23, "timestamp": "00:58:14", "text": "あなたはドルイットなので、おそらく"}, {"type": "subtitle", "time": 3495.589, "timestamp": "00:58:15", "text": "知恵を選びなさい、それがあなたの"}, {"type": "subtitle", "time": 3498.15, "timestamp": "00:58:18", "text": "最高能力スコア。"}, {"type": "subtitle", "time": 3500.15, "timestamp": "00:58:20", "text": "ああ、わかりました。わかった。"}, {"type": "subtitle", "time": 3523.51, "timestamp": "00:58:43", "text": "防火区画。それは何ですか？火。"}, {"type": "subtitle", "time": 3525.75, "timestamp": "00:58:45", "text": "何？火"}, {"type": "subtitle", "time": 3529.75, "timestamp": "00:58:49", "text": "ブロック。ああ、これは何でしょう？"}, {"type": "subtitle", "time": 3533.51, "timestamp": "00:58:53", "text": "魔法を感知し、変装する"}, {"type": "subtitle", "time": 3536.15, "timestamp": "00:58:56", "text": "この取引における呪文。"}, {"type": "subtitle", "time": 3537.829, "timestamp": "00:58:57", "text": "ああ。"}]
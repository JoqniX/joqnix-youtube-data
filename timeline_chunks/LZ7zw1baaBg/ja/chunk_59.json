[{"type": "subtitle", "time": 3552.71, "timestamp": "00:59:12", "text": "[音楽]"}, {"type": "subtitle", "time": 3560.15, "timestamp": "00:59:20", "text": "濃厚な風味としっかりとした食感を求めるなら"}, {"type": "subtitle", "time": 3563.75, "timestamp": "00:59:23", "text": "万能型のパワー。わかった。"}, {"type": "subtitle", "time": 3566.47, "timestamp": "00:59:26", "text": "面白い。わかった。アストラルが"}, {"type": "subtitle", "time": 3568.95, "timestamp": "00:59:28", "text": "この名前。だから私は「わかった、わかった」って感じ。"}, {"type": "subtitle", "time": 3570.789, "timestamp": "00:59:30", "text": "買います。\""}, {"type": "subtitle", "time": 3572.23, "timestamp": "00:59:32", "text": "ご自由にどうぞ。"}, {"type": "subtitle", "time": 3574.63, "timestamp": "00:59:34", "text": "選択するだけでいいんですよね？ただ"}, {"type": "subtitle", "time": 3575.99, "timestamp": "00:59:35", "text": "それをクリックしてから、下方向選択をクリックします。"}, {"type": "subtitle", "time": 3577.589, "timestamp": "00:59:37", "text": "そこには。"}, {"type": "subtitle", "time": 3579.829, "timestamp": "00:59:39", "text": "わかった。はい、どうぞ。クリックするだけ"}, {"type": "subtitle", "time": 3580.87, "timestamp": "00:59:40", "text": "中くらい。"}, {"type": "subtitle", "time": 3582.069, "timestamp": "00:59:42", "text": "わかった。"}, {"type": "subtitle", "time": 3584.549, "timestamp": "00:59:44", "text": "ええ、そうです。インポーターを使用してください。"}, {"type": "subtitle", "time": 3585.75, "timestamp": "00:59:45", "text": "わかった。"}, {"type": "subtitle", "time": 3590.23, "timestamp": "00:59:50", "text": "そうそう、それだよ。今度はこちら"}, {"type": "subtitle", "time": 3593.19, "timestamp": "00:59:53", "text": "えーと、どれでも自由に選んでください。"}, {"type": "subtitle", "time": 3596.71, "timestamp": "00:59:56", "text": "統計データのばらつきに注意してください。"}, {"type": "subtitle", "time": 3599.589, "timestamp": "00:59:59", "text": "ああ、わかった。えっと"}]
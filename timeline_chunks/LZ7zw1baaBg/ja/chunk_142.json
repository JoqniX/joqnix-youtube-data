[{"type": "subtitle", "time": 8520.389, "timestamp": "02:22:00", "text": "1つでも構いません。ああ、君が"}, {"type": "subtitle", "time": 8521.67, "timestamp": "02:22:01", "text": "特に必要ないけど、もしあなたが"}, {"type": "subtitle", "time": 8523.19, "timestamp": "02:22:03", "text": "他のものを使って、変更することもできます"}, {"type": "subtitle", "time": 8524.71, "timestamp": "02:22:04", "text": "枠の色とかそういうもの"}, {"type": "subtitle", "time": 8526.79, "timestamp": "02:22:06", "text": "それ。ええ、でも、それはあなた次第です。"}, {"type": "subtitle", "time": 8529.83, "timestamp": "02:22:09", "text": "うん、それはいいね。"}, {"type": "subtitle", "time": 8532.95, "timestamp": "02:22:12", "text": "わかりました、これを送ります。"}, {"type": "subtitle", "time": 8535.33, "timestamp": "02:22:15", "text": "わかった。"}, {"type": "subtitle", "time": 8543.75, "timestamp": "02:22:23", "text": "トークン３。"}, {"type": "subtitle", "time": 8547.19, "timestamp": "02:22:27", "text": "よし。それでは、OK。よし。私は"}, {"type": "subtitle", "time": 8554.94, "timestamp": "02:22:34", "text": "見てみましょう。"}, {"type": "subtitle", "time": 8560.71, "timestamp": "02:22:40", "text": "ああ、これはなかなか良いですね。だってそれはちょっと"}, {"type": "subtitle", "time": 8563.349, "timestamp": "02:22:43", "text": "違うものが好き。だから、私はこれが苦手なんです。"}]
[{"type": "subtitle", "time": 7020.55, "timestamp": "01:57:00", "text": "実用的な呪文を扱う。残りは"}, {"type": "subtitle", "time": 7021.51, "timestamp": "01:57:01", "text": "ユーティリティ。"}, {"type": "subtitle", "time": 7023.91, "timestamp": "01:57:03", "text": "わかった。それならダメージを与える方を選びます"}, {"type": "subtitle", "time": 7025.43, "timestamp": "01:57:05", "text": "物っぽい。どれを選べばいいですか？"}, {"type": "subtitle", "time": 7029.75, "timestamp": "01:57:09", "text": "よし。えっと、そうですね。"}, {"type": "subtitle", "time": 7031.669, "timestamp": "01:57:11", "text": "損害を与えるため。うん。"}, {"type": "subtitle", "time": 7034.31, "timestamp": "01:57:14", "text": "毎回キャントリップを選択する必要がありますか？"}, {"type": "subtitle", "time": 7036.229, "timestamp": "01:57:16", "text": "レベルアップする時が来たかな？"}, {"type": "subtitle", "time": 7038.39, "timestamp": "01:57:18", "text": "いや、違うよ。それは、あなたが手に入れるのはあなただけです"}, {"type": "subtitle", "time": 7040.629, "timestamp": "01:57:20", "text": "レベルに応じてキャントリップを習得します。私の間違いであれば、"}, {"type": "subtitle", "time": 7044.31, "timestamp": "01:57:24", "text": "4つくらいあって、それから次のキャンリップ"}, {"type": "subtitle", "time": 7047.91, "timestamp": "01:57:27", "text": "レベルは10です。だから、大したことはありません。"}, {"type": "subtitle", "time": 7050.31, "timestamp": "01:57:30", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 7054.87, "timestamp": "01:57:34", "text": "わかった。純粋にダメージ、つまり銃のダメージ"}, {"type": "subtitle", "time": 7063.83, "timestamp": "01:57:43", "text": "純粋なダメージだけが欲しいなら"}, {"type": "subtitle", "time": 7065.27, "timestamp": "01:57:45", "text": "技術的には、"}, {"type": "subtitle", "time": 7067.35, "timestamp": "01:57:47", "text": "最大のサイコロは毒スプレーだろう"}, {"type": "subtitle", "time": 7069.51, "timestamp": "01:57:49", "text": "でも毒ダメージはかなり"}, {"type": "subtitle", "time": 7072.47, "timestamp": "01:57:52", "text": "しばしば、かなり頻繁に抵抗された。だから、"}, {"type": "subtitle", "time": 7073.99, "timestamp": "01:57:53", "text": "敵がいる"}, {"type": "subtitle", "time": 7077.109, "timestamp": "01:57:57", "text": "それに対して抵抗力がある。えっと"}]
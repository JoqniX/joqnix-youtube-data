[{"type": "subtitle", "time": 9306.309, "timestamp": "02:35:06", "text": "それへ。わかった。それで、このVTでは"}, {"type": "subtitle", "time": 9307.67, "timestamp": "02:35:07", "text": "フードにはすべてが見える"}, {"type": "subtitle", "time": 9311.349, "timestamp": "02:35:11", "text": "できますし、もしあなたがしたいなら"}, {"type": "subtitle", "time": 9314.15, "timestamp": "02:35:14", "text": "ターゲットのような必要なもの"}, {"type": "subtitle", "time": 9317.349, "timestamp": "02:35:17", "text": "まず目標を設定する。だからもしあなたが"}, {"type": "subtitle", "time": 9319.91, "timestamp": "02:35:19", "text": "カーソルを合わせると、T を押します。"}, {"type": "subtitle", "time": 9322.07, "timestamp": "02:35:22", "text": "P ダミーを押して T を押すと、"}, {"type": "subtitle", "time": 9324.23, "timestamp": "02:35:24", "text": "それを狙え。"}, {"type": "subtitle", "time": 9327.27, "timestamp": "02:35:27", "text": "ああ、T。わかった。わかった。錠前。わかった。"}, {"type": "subtitle", "time": 9329.67, "timestamp": "02:35:29", "text": "うん。うん。わかった。そして今、それは"}, {"type": "subtitle", "time": 9331.51, "timestamp": "02:35:31", "text": "君はこうするつもりだ"}, {"type": "subtitle", "time": 9333.59, "timestamp": "02:35:33", "text": "その人物に焦点を合わせた。これであなたは"}, {"type": "subtitle", "time": 9335.27, "timestamp": "02:35:35", "text": "あなたがすることすべてが標的になる"}, {"type": "subtitle", "time": 9337.67, "timestamp": "02:35:37", "text": "それに関して。だから、私が知っているように、キャスティングを試してみてください"}, {"type": "subtitle", "time": 9339.67, "timestamp": "02:35:39", "text": "何か。"}, {"type": "subtitle", "time": 9342.309, "timestamp": "02:35:42", "text": "えっと、呪文を唱えます。"}, {"type": "subtitle", "time": 9344.55, "timestamp": "02:35:44", "text": "うん。"}, {"type": "subtitle", "time": 9347.83, "timestamp": "02:35:47", "text": "非常に有害なカンリップスを1匹投げたようなものだ。"}, {"type": "subtitle", "time": 9349.19, "timestamp": "02:35:49", "text": "わかった。"}, {"type": "subtitle", "time": 9349.99, "timestamp": "02:35:49", "text": "妖精"}, {"type": "subtitle", "time": 9351.67, "timestamp": "02:35:51", "text": "それとも公平？フェアファイアは実際には"}, {"type": "subtitle", "time": 9354.15, "timestamp": "02:35:54", "text": "範囲攻撃。私は説明できます"}, {"type": "subtitle", "time": 9356.15, "timestamp": "02:35:56", "text": "後で。それは範囲攻撃です。だから、少し"}, {"type": "subtitle", "time": 9357.429, "timestamp": "02:35:57", "text": "違う。"}]
[{"type": "subtitle", "time": 10381.429, "timestamp": "02:53:01", "text": "わかった、やってみよう。"}, {"type": "subtitle", "time": 10384.55, "timestamp": "02:53:04", "text": "わかった。うん。よし。 11番は"}, {"type": "subtitle", "time": 10388.55, "timestamp": "02:53:08", "text": "ヒットした理由は、この男のエアコンがまるで"}, {"type": "subtitle", "time": 10390.469, "timestamp": "02:53:10", "text": "ここで言えるのは、でも普通は"}, {"type": "subtitle", "time": 10392.79, "timestamp": "02:53:12", "text": "あなたには見えないでしょう。だからこれは"}, {"type": "subtitle", "time": 10395.67, "timestamp": "02:53:15", "text": "男のACは15です。だから、15または"}, {"type": "subtitle", "time": 10399.429, "timestamp": "02:53:19", "text": "14以上出ればヒットするが、14以上出れば"}, {"type": "subtitle", "time": 10402.23, "timestamp": "02:53:22", "text": "その下には当たらない。"}, {"type": "subtitle", "time": 10406.07, "timestamp": "02:53:26", "text": "ああ、わかりました。わかった。参加します。うん。それで、"}, {"type": "subtitle", "time": 10409.75, "timestamp": "02:53:29", "text": "うん。うーん、そうですね、まあ、"}, {"type": "subtitle", "time": 10412.23, "timestamp": "02:53:32", "text": "えーっと、私が見せるまでこれをやって。それで、"}, {"type": "subtitle", "time": 10413.59, "timestamp": "02:53:33", "text": "彼をこっちに移動させて"}, {"type": "subtitle", "time": 10414.71, "timestamp": "02:53:34", "text": "それから彼にあなたを攻撃させるつもりだ"}, {"type": "subtitle", "time": 10418.389, "timestamp": "02:53:38", "text": "短い弓で、えーと22回ヒット。私は"}, {"type": "subtitle", "time": 10420.55, "timestamp": "02:53:40", "text": "彼に損害を与えさせるつもりだ。そしてそこに"}, {"type": "subtitle", "time": 10422.389, "timestamp": "02:53:42", "text": "あなたが行く。そして、それをすぐに実行に移してください。"}, {"type": "subtitle", "time": 10423.99, "timestamp": "02:53:43", "text": "うん。"}, {"type": "subtitle", "time": 10434.389, "timestamp": "02:53:54", "text": "わかった。"}, {"type": "subtitle", "time": 10436.309, "timestamp": "02:53:56", "text": "検証者。わかった。うん、できるよ、やろうよ"}, {"type": "subtitle", "time": 10437.99, "timestamp": "02:53:57", "text": "じゃあ、まだできるならやってみようよ"}]
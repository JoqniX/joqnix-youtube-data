[{"type": "subtitle", "time": 10201.269, "timestamp": "02:50:01", "text": "敵はあなたの目の前に移動します"}, {"type": "subtitle", "time": 10204.55, "timestamp": "02:50:04", "text": "そして、似たような攻撃を仕掛けます。もし私が"}, {"type": "subtitle", "time": 10207.67, "timestamp": "02:50:07", "text": "それをして、それをして、普通に普通に"}, {"type": "subtitle", "time": 10211.429, "timestamp": "02:50:11", "text": "えっと、ロール。出目は20です。20は"}, {"type": "subtitle", "time": 10213.59, "timestamp": "02:50:13", "text": "エアコンの上。現在のエアコンの温度は16です。"}, {"type": "subtitle", "time": 10216.389, "timestamp": "02:50:16", "text": "あなたのエアコンの上にあるので、私は"}, {"type": "subtitle", "time": 10219.67, "timestamp": "02:50:19", "text": "ダメージ。つまり、これをクリックすると、"}, {"type": "subtitle", "time": 10221.269, "timestamp": "02:50:21", "text": "これがあなたの損害です。だから、4つ取る"}, {"type": "subtitle", "time": 10223.51, "timestamp": "02:50:23", "text": "そういう感じのダメージ。そして彼らはそうしない"}, {"type": "subtitle", "time": 10225.11, "timestamp": "02:50:25", "text": "彼らには順番が回ってくる。"}, {"type": "subtitle", "time": 10226.87, "timestamp": "02:50:26", "text": "だから、私は作ります"}, {"type": "subtitle", "time": 10228.469, "timestamp": "02:50:28", "text": "彼らは順番を飛ばす。だから、"}, {"type": "subtitle", "time": 10234.15, "timestamp": "02:50:34", "text": "わかった。"}, {"type": "subtitle", "time": 10236.63, "timestamp": "02:50:36", "text": "それは、いわば基本中の基本です。私にさせて"}, {"type": "subtitle", "time": 10240.55, "timestamp": "02:50:40", "text": "見る。そうそう。わかった。それは、通常は"}, {"type": "subtitle", "time": 10243.67, "timestamp": "02:50:43", "text": "前にやったような人たち、えーっと"}, {"type": "subtitle", "time": 10245.99, "timestamp": "02:50:45", "text": "戦闘はいつでもできるから。"}, {"type": "subtitle", "time": 10249.51, "timestamp": "02:50:49", "text": "ええ、でもそれは基本的に"}, {"type": "subtitle", "time": 10251.75, "timestamp": "02:50:51", "text": "楽しくて馴染みのある呪文。ええと、使えます"}, {"type": "subtitle", "time": 10254.469, "timestamp": "02:50:54", "text": "それを行うには、ワイルドシェイプチャージが必要です。野生"}, {"type": "subtitle", "time": 10257.67, "timestamp": "02:50:57", "text": "形は、変形する能力です"}]
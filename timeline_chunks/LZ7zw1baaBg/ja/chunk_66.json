[{"type": "subtitle", "time": 3961.349, "timestamp": "01:06:01", "text": "どちらかというと実用的なものだ。"}, {"type": "subtitle", "time": 3963.51, "timestamp": "01:06:03", "text": "それは光を与える。も同様に"}, {"type": "subtitle", "time": 3965.51, "timestamp": "01:06:05", "text": "ライト。"}, {"type": "subtitle", "time": 3967.91, "timestamp": "01:06:07", "text": "ああ、光の力だ。わかった。"}, {"type": "subtitle", "time": 3968.63, "timestamp": "01:06:08", "text": "うん。"}, {"type": "subtitle", "time": 3969.029, "timestamp": "01:06:09", "text": "えっと"}, {"type": "subtitle", "time": 3971.029, "timestamp": "01:06:11", "text": "物を傷つけるためのものではありません。これは"}, {"type": "subtitle", "time": 3973.589, "timestamp": "01:06:13", "text": "ユーティリティ。"}, {"type": "subtitle", "time": 3976.87, "timestamp": "01:06:16", "text": "ああ、つまりこの追加の呪文は、"}, {"type": "subtitle", "time": 3980.309, "timestamp": "01:06:20", "text": "有害なものを選ぶこともできます。"}, {"type": "subtitle", "time": 3982.95, "timestamp": "01:06:22", "text": "うん。呪文１と呪文２。呪文１"}, {"type": "subtitle", "time": 3984.549, "timestamp": "01:06:24", "text": "呪文セットを与えるとダンスができます"}, {"type": "subtitle", "time": 3986.47, "timestamp": "01:06:26", "text": "ライトは便利な呪文です。スペル"}, {"type": "subtitle", "time": 3988.23, "timestamp": "01:06:28", "text": "セット２は、別のユーティリティライトを提供します"}, {"type": "subtitle", "time": 3990.71, "timestamp": "01:06:30", "text": "呪文と呪文セット３はあなたに"}, {"type": "subtitle", "time": 3993.91, "timestamp": "01:06:33", "text": "えーと聖なる炎は、えーと有害な"}, {"type": "subtitle", "time": 3996.71, "timestamp": "01:06:36", "text": "呪文か、あるいはキャンリップ。それはあなた次第です"}, {"type": "subtitle", "time": 3998.23, "timestamp": "01:06:38", "text": "後でどちらを選びたいですか"}, {"type": "subtitle", "time": 4000.23, "timestamp": "01:06:40", "text": "さらに、"}, {"type": "subtitle", "time": 4003.91, "timestamp": "01:06:43", "text": "クラスを追加する際に、後でオプションを選択できます。"}, {"type": "subtitle", "time": 4007.349, "timestamp": "01:06:47", "text": "ああ、わかった。えっと、"}, {"type": "subtitle", "time": 4009.91, "timestamp": "01:06:49", "text": "ああ、それはまるで踊る光みたいだと思う"}, {"type": "subtitle", "time": 4012.87, "timestamp": "01:06:52", "text": "えっと、場所を照らすようなものですよね？"}]
[{"type": "subtitle", "time": 10020.389, "timestamp": "02:47:00", "text": "左側からやります。"}, {"type": "subtitle", "time": 10021.83, "timestamp": "02:47:01", "text": "わかった。クリックするだけです。わかった。うん。あなたも"}, {"type": "subtitle", "time": 10023.269, "timestamp": "02:47:03", "text": "ターゲットをクリックしてください。それはあなたの"}, {"type": "subtitle", "time": 10025.91, "timestamp": "02:47:05", "text": "ターゲット。そして、あとは「通常」をクリックするだけです。"}, {"type": "subtitle", "time": 10027.91, "timestamp": "02:47:07", "text": "はい、どうぞ。うん。はい、どうぞ。えっと"}, {"type": "subtitle", "time": 10030.15, "timestamp": "02:47:10", "text": "それはヒットしない、なぜならそれは実際には"}, {"type": "subtitle", "time": 10032.389, "timestamp": "02:47:12", "text": "エアコンの下にあるからです。 ACは"}, {"type": "subtitle", "time": 10034.71, "timestamp": "02:47:14", "text": "ACはアーマークラスの略です。毎"}, {"type": "subtitle", "time": 10036.469, "timestamp": "02:47:16", "text": "すべての生き物がそれを持っている。敵がそれを持っている。"}, {"type": "subtitle", "time": 10039.75, "timestamp": "02:47:19", "text": "あなたもそれを持っている。それで、こちら側は、えーと12番"}, {"type": "subtitle", "time": 10042.23, "timestamp": "02:47:22", "text": "実際には敵のACを突破しないので、"}, {"type": "subtitle", "time": 10044.23, "timestamp": "02:47:24", "text": "当たらない。んーん。"}, {"type": "subtitle", "time": 10046.07, "timestamp": "02:47:26", "text": "ああ、あなたの番ではいくらですか？また、"}, {"type": "subtitle", "time": 10047.51, "timestamp": "02:47:27", "text": "動くように。はい、すみません。何？"}, {"type": "subtitle", "time": 10050.07, "timestamp": "02:47:30", "text": "エアコンはどれくらい必要ですか？"}, {"type": "subtitle", "time": 10052.309, "timestamp": "02:47:32", "text": "えっと、敵によって違います"}, {"type": "subtitle", "time": 10055.03, "timestamp": "02:47:35", "text": "敵。そして通常、エアコンは、えーと"}, {"type": "subtitle", "time": 10057.349, "timestamp": "02:47:37", "text": "見えない。また、"}, {"type": "subtitle", "time": 10059.83, "timestamp": "02:47:39", "text": "自分のターン中は30フィート進んでください。"}, {"type": "subtitle", "time": 10061.349, "timestamp": "02:47:41", "text": "おお、"}, {"type": "subtitle", "time": 10063.91, "timestamp": "02:47:43", "text": "つまり、敵も同じことができるということだ。"}, {"type": "subtitle", "time": 10066.95, "timestamp": "02:47:46", "text": "ええ、敵も30フィート移動できます。"}, {"type": "subtitle", "time": 10069.59, "timestamp": "02:47:49", "text": "6つの正方形のようなものです。"}, {"type": "subtitle", "time": 10071.99, "timestamp": "02:47:51", "text": "そう、だから、もし引っ越したいなら、"}, {"type": "subtitle", "time": 10074.15, "timestamp": "02:47:54", "text": "だから、あなたの行動では、動いたり、"}, {"type": "subtitle", "time": 10077.19, "timestamp": "02:47:57", "text": "アクションを実行し、ボーナスアクションを実行します。"}, {"type": "subtitle", "time": 10079.19, "timestamp": "02:47:59", "text": "ボーナスアクションが何なのか分かりません"}]
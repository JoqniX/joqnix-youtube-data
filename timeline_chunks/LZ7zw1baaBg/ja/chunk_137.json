[{"type": "subtitle", "time": 8221.75, "timestamp": "02:17:01", "text": "えーっと、新しいものを見てみましょう"}, {"type": "subtitle", "time": 8226.87, "timestamp": "02:17:06", "text": "ウィローは新人、スミも新人、ルディ"}, {"type": "subtitle", "time": 8229.589, "timestamp": "02:17:09", "text": "新しいものです。あれらは新しいものです。の"}, {"type": "subtitle", "time": 8233.349, "timestamp": "02:17:13", "text": "セミニューのような、そしてレネは、これは"}, {"type": "subtitle", "time": 8237.03, "timestamp": "02:17:17", "text": "彼らの2試合目のように。えっと、それから"}, {"type": "subtitle", "time": 8239.03, "timestamp": "02:17:19", "text": "他の人は既に持っている"}, {"type": "subtitle", "time": 8241.589, "timestamp": "02:17:21", "text": "ゲーム体験はまずまずだった。"}, {"type": "subtitle", "time": 8253.349, "timestamp": "02:17:33", "text": "そして、絡まりは既にそこに存在している。その時"}, {"type": "subtitle", "time": 8257.75, "timestamp": "02:17:37", "text": "最後は雷だ。"}, {"type": "subtitle", "time": 8261.11, "timestamp": "02:17:41", "text": "雷は雷波となる。"}, {"type": "subtitle", "time": 8262.79, "timestamp": "02:17:42", "text": "サンダーウェーブはレベル1です。"}, {"type": "subtitle", "time": 8264.87, "timestamp": "02:17:44", "text": "間違いです。"}, {"type": "subtitle", "time": 8265.83, "timestamp": "02:17:45", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 8268.709, "timestamp": "02:17:48", "text": "そうなんですか？うん。"}, {"type": "subtitle", "time": 8270.95, "timestamp": "02:17:50", "text": "わかった。もう1つ追加。わかった。"}, {"type": "subtitle", "time": 8272.96, "timestamp": "02:17:52", "text": "わかった。 だから、私は妖精を選んだ。"}, {"type": "subtitle", "time": 8276.479, "timestamp": "02:17:56", "text": "だから、私は妖精を選んだ。 わかった。エンタングルはそこにあります。公平性はそこにある。"}]
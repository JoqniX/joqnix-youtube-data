[{"type": "subtitle", "time": 3368.15, "timestamp": "00:56:08", "text": "わかった。星界のエルフがそこにいる。"}, {"type": "subtitle", "time": 3377.27, "timestamp": "00:56:17", "text": "カスタムリネージとは何ですか？それは"}, {"type": "subtitle", "time": 3381.03, "timestamp": "00:56:21", "text": "ああ、それは基本的に"}, {"type": "subtitle", "time": 3384.069, "timestamp": "00:56:24", "text": "好きなものを何でも選べ、みたいな感じ。"}, {"type": "subtitle", "time": 3386.63, "timestamp": "00:56:26", "text": "ああ、わかりました。わかった。"}, {"type": "subtitle", "time": 3390.069, "timestamp": "00:56:30", "text": "ああ、わかった。えっと"}, {"type": "subtitle", "time": 3393.829, "timestamp": "00:56:33", "text": "プロプロテクターはありませんか？"}, {"type": "subtitle", "time": 3394.549, "timestamp": "00:56:34", "text": "プロテクター？"}, {"type": "subtitle", "time": 3397.829, "timestamp": "00:56:37", "text": "ああ、それはどちらかというと背景ですね。"}, {"type": "subtitle", "time": 3400.309, "timestamp": "00:56:40", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 3401.67, "timestamp": "00:56:41", "text": "持続する。待って、ちょっと待って。待って。何が"}, {"type": "subtitle", "time": 3403.349, "timestamp": "00:56:43", "text": "何の話をしてるの？ちょっと待ってください。は"}, {"type": "subtitle", "time": 3404.95, "timestamp": "00:56:44", "text": "それは、私が"}, {"type": "subtitle", "time": 3406.71, "timestamp": "00:56:46", "text": "わからない、または入力しなかった？なぜならもし"}, {"type": "subtitle", "time": 3407.91, "timestamp": "00:56:47", "text": "まだ入力していないオプションがあります。"}, {"type": "subtitle", "time": 3409.67, "timestamp": "00:56:49", "text": "今すぐにでも入れることができます。"}, {"type": "subtitle", "time": 3413.27, "timestamp": "00:56:53", "text": "えーと書いてある"}, {"type": "subtitle", "time": 3416.47, "timestamp": "00:56:56", "text": "倒れた者の守護者。"}, {"type": "subtitle", "time": 3417.99, "timestamp": "00:56:57", "text": "そうねぇ。"}]
[{"type": "subtitle", "time": 5582.79, "timestamp": "01:33:02", "text": "だから、私は既に光を選んだのです。"}, {"type": "subtitle", "time": 5584.47, "timestamp": "01:33:04", "text": "はい。あなたは既に光を持っている。"}, {"type": "subtitle", "time": 5588.07, "timestamp": "01:33:08", "text": "光を生み出すものはありますか。わかった。それは"}, {"type": "subtitle", "time": 5589.83, "timestamp": "01:33:09", "text": "港。いいえ。"}, {"type": "subtitle", "time": 5594.87, "timestamp": "01:33:14", "text": "ガイダンスもまた、ドルイドの能力の一つである。"}, {"type": "subtitle", "time": 5597.669, "timestamp": "01:33:17", "text": "えっと"}, {"type": "subtitle", "time": 5600.629, "timestamp": "01:33:20", "text": "自らの意思で触れる、自らの意思で選ぶ生き物"}, {"type": "subtitle", "time": 5602.149, "timestamp": "01:33:22", "text": "殺す。"}, {"type": "subtitle", "time": 5606.149, "timestamp": "01:33:26", "text": "えっと、1 d4って何ですか？"}, {"type": "subtitle", "time": 5609.51, "timestamp": "01:33:29", "text": "1 d4とは、4面体のサイコロのことです。ロール"}, {"type": "subtitle", "time": 5613.189, "timestamp": "01:33:33", "text": "1つ。 4面サイコロを振る。"}, {"type": "subtitle", "time": 5615.669, "timestamp": "01:33:35", "text": "ああ、これはサイコロで決めるんだね。おお"}, {"type": "subtitle", "time": 5618.55, "timestamp": "01:33:38", "text": "うん。うん。例えば、転がったら"}, {"type": "subtitle", "time": 5621.75, "timestamp": "01:33:41", "text": "1d4、これをやって1を振るだけです。"}, {"type": "subtitle", "time": 5623.91, "timestamp": "01:33:43", "text": "d4。"}, {"type": "subtitle", "time": 5624.55, "timestamp": "01:33:44", "text": "わかった。わかった。"}, {"type": "subtitle", "time": 5627.27, "timestamp": "01:33:47", "text": "例えば、ここでは2を獲得しました。"}, {"type": "subtitle", "time": 5629.99, "timestamp": "01:33:49", "text": "おお。"}, {"type": "subtitle", "time": 5631.51, "timestamp": "01:33:51", "text": "えっと"}]
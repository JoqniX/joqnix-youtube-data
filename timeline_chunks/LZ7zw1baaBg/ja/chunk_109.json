[{"type": "subtitle", "time": 6541.109, "timestamp": "01:49:01", "text": "凍傷は不利なデバフ効果をもたらします。"}, {"type": "subtitle", "time": 6543.35, "timestamp": "01:49:03", "text": "効用値を鞭打たないでください、それはあなたが"}, {"type": "subtitle", "time": 6545.75, "timestamp": "01:49:05", "text": "物を引っ張ることができる"}, {"type": "subtitle", "time": 6548.229, "timestamp": "01:49:08", "text": "そういうのと、その他"}, {"type": "subtitle", "time": 6549.75, "timestamp": "01:49:09", "text": "例えば、ダメージを与えるもの"}, {"type": "subtitle", "time": 6551.59, "timestamp": "01:49:11", "text": "寄生によってランダムに移動する"}, {"type": "subtitle", "time": 6553.91, "timestamp": "01:49:13", "text": "方向"}, {"type": "subtitle", "time": 6556.47, "timestamp": "01:49:16", "text": "一方で。はい、すみません。えっと、どれ"}, {"type": "subtitle", "time": 6558.629, "timestamp": "01:49:18", "text": "どちらがより大きなダメージを与えるか？"}, {"type": "subtitle", "time": 6560.629, "timestamp": "01:49:20", "text": "ああ、例えば純粋なダメージが欲しい場合"}, {"type": "subtitle", "time": 6563.109, "timestamp": "01:49:23", "text": "攻撃を[ __ ]する、えっと、"}, {"type": "subtitle", "time": 6565.43, "timestamp": "01:49:25", "text": "例えば毒スプレーは1d12ダメージを与えます。"}, {"type": "subtitle", "time": 6568.229, "timestamp": "01:49:28", "text": "つまり実質的には2倍の"}, {"type": "subtitle", "time": 6570.07, "timestamp": "01:49:30", "text": "ダメージはありますが、そのようなものはありません"}, {"type": "subtitle", "time": 6572.149, "timestamp": "01:49:32", "text": "デバフは特に与えませんし、"}, {"type": "subtitle", "time": 6574.47, "timestamp": "01:49:34", "text": "そういうこと。"}, {"type": "subtitle", "time": 6577.27, "timestamp": "01:49:37", "text": "では、私が棘のウェブを選んで持ち帰ったらどうなるでしょうか"}, {"type": "subtitle", "time": 6579.189, "timestamp": "01:49:39", "text": "敵が私に近づいている？私の"}, {"type": "subtitle", "time": 6582.39, "timestamp": "01:49:42", "text": "パーティーメイトは敵を倒すか"}, {"type": "subtitle", "time": 6585.669, "timestamp": "01:49:45", "text": "うーん、場合によりますね。ええ、そうですが、"}, {"type": "subtitle", "time": 6587.75, "timestamp": "01:49:47", "text": "もしあなたが彼らとコミュニケーションを取れば。教えて"}, {"type": "subtitle", "time": 6589.75, "timestamp": "01:49:49", "text": "彼らにそのことを話した。"}, {"type": "subtitle", "time": 6594.31, "timestamp": "01:49:54", "text": "わかった。わかった。何てことだ。"}, {"type": "subtitle", "time": 6597.51, "timestamp": "01:49:57", "text": "待って、音声でコミュニケーションするにはどうすればいいの？おお"}]
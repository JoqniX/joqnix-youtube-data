[{"type": "subtitle", "time": 3903.27, "timestamp": "01:05:03", "text": "わかった。"}, {"type": "subtitle", "time": 3905.67, "timestamp": "01:05:05", "text": "うん。これらのどれも、これらのどれも、ええと"}, {"type": "subtitle", "time": 3907.829, "timestamp": "01:05:07", "text": "実際にアクセスできる呪文"}, {"type": "subtitle", "time": 3909.829, "timestamp": "01:05:09", "text": "あなたのドルイドクラス。これは唯一の"}, {"type": "subtitle", "time": 3912.47, "timestamp": "01:05:12", "text": "これらの呪文を実際に手に入れる方法。"}, {"type": "subtitle", "time": 3914.63, "timestamp": "01:05:14", "text": "自由に好きなものを選んでください"}, {"type": "subtitle", "time": 3917.829, "timestamp": "01:05:17", "text": "役に立つでしょう。"}, {"type": "subtitle", "time": 3918.47, "timestamp": "01:05:18", "text": "わかった。"}, {"type": "subtitle", "time": 3920.789, "timestamp": "01:05:20", "text": "もし説明が必要なら"}, {"type": "subtitle", "time": 3922.95, "timestamp": "01:05:22", "text": "彼らも、私もそうすることができます"}, {"type": "subtitle", "time": 3924.87, "timestamp": "01:05:24", "text": "あなたが望むもの。"}, {"type": "subtitle", "time": 3929.109, "timestamp": "01:05:29", "text": "えっと、デッキセーブして1d8ラジアンを振る"}, {"type": "subtitle", "time": 3930.87, "timestamp": "01:05:30", "text": "ダメージ。聖なる。"}, {"type": "subtitle", "time": 3933.19, "timestamp": "01:05:33", "text": "うん。うん。その1d8はダメージのようなもの"}, {"type": "subtitle", "time": 3936.23, "timestamp": "01:05:36", "text": "デッキセーフは、えっと、それを説明できます"}, {"type": "subtitle", "time": 3938.549, "timestamp": "01:05:38", "text": "後であなたに、しかしそれは基本的に"}, {"type": "subtitle", "time": 3940.15, "timestamp": "01:05:40", "text": "実際に彼らが"}, {"type": "subtitle", "time": 3949.029, "timestamp": "01:05:49", "text": "それで、えっと、ダンスに行こうと思ったんだけど、"}, {"type": "subtitle", "time": 3953.589, "timestamp": "01:05:53", "text": "しかし、それは良いことなのだろうか？損害賠償額を記載できますか？えっと"}, {"type": "subtitle", "time": 3955.43, "timestamp": "01:05:55", "text": "まるでそうじゃないかのように踊る"}, {"type": "subtitle", "time": 3958.069, "timestamp": "01:05:58", "text": "カンリップにダメージを与えるか、実際には"}]
[{"type": "subtitle", "time": 4801.43, "timestamp": "01:20:01", "text": "確認ボタンをクリックしてください。"}, {"type": "subtitle", "time": 4802.95, "timestamp": "01:20:02", "text": "えっと、"}, {"type": "subtitle", "time": 4805.59, "timestamp": "01:20:05", "text": "わかった。私は外れ値の方を選びます。うん。"}, {"type": "subtitle", "time": 4808.149, "timestamp": "01:20:08", "text": "よし。確認ボタンをクリックします。"}, {"type": "subtitle", "time": 4811.83, "timestamp": "01:20:11", "text": "おっと。これで終わりにします。えっと、"}, {"type": "subtitle", "time": 4813.99, "timestamp": "01:20:13", "text": "わかった。それで、これを閉じます。わかった。"}, {"type": "subtitle", "time": 4815.35, "timestamp": "01:20:15", "text": "はい、どうぞ。背景画像を入手しました"}, {"type": "subtitle", "time": 4818.31, "timestamp": "01:20:18", "text": "輸入されました。ええ、そうです。よし。それは"}, {"type": "subtitle", "time": 4822.39, "timestamp": "01:20:22", "text": "これは正しいはずです。わかった。さて、えっと"}, {"type": "subtitle", "time": 4825.669, "timestamp": "01:20:25", "text": "わかった。うーん、これはちょっと問題になるかもしれない"}, {"type": "subtitle", "time": 4828.07, "timestamp": "01:20:28", "text": "後で。だから、私は行くことにします"}, {"type": "subtitle", "time": 4830.95, "timestamp": "01:20:30", "text": "キャラクターのレベルアップを通して"}, {"type": "subtitle", "time": 4833.27, "timestamp": "01:20:33", "text": "理由はわからないけど、あなたのために"}, {"type": "subtitle", "time": 4834.47, "timestamp": "01:20:34", "text": "あなた"}, {"type": "subtitle", "time": 4835.669, "timestamp": "01:20:35", "text": "重要なことは実際にはうまくいかない"}, {"type": "subtitle", "time": 4836.79, "timestamp": "01:20:36", "text": "あなたのために。うん。"}, {"type": "subtitle", "time": 4839.51, "timestamp": "01:20:39", "text": "そうそう。強さのデッキはすべて"}, {"type": "subtitle", "time": 4841.99, "timestamp": "01:20:41", "text": "リセットされたか何かだろう。"}, {"type": "subtitle", "time": 4844.39, "timestamp": "01:20:44", "text": "え、何だって？リセットされました。"}, {"type": "subtitle", "time": 4846.55, "timestamp": "01:20:46", "text": "私にとっては、以前と何も変わっていません。その"}, {"type": "subtitle", "time": 4849.669, "timestamp": "01:20:49", "text": "まだ10 16 13みたいな感じ。10 17 8だよ。"}, {"type": "subtitle", "time": 4852.95, "timestamp": "01:20:52", "text": "7、それは17です"}, {"type": "subtitle", "time": 4857.51, "timestamp": "01:20:57", "text": "16 なぜなら、私は 0 + 3 1 0 を読んでいるからです。"}, {"type": "subtitle", "time": 4858.229, "timestamp": "01:20:58", "text": "はいはい"}, {"type": "subtitle", "time": 4859.83, "timestamp": "01:20:59", "text": "はい、これがあなたの修飾子です。"}]
[{"type": "subtitle", "time": 2641.99, "timestamp": "00:44:01", "text": "智力达到那种水平。嗯，主要是"}, {"type": "subtitle", "time": 2644.95, "timestamp": "00:44:04", "text": "例如某些技能。如果你有"}, {"type": "subtitle", "time": 2647.27, "timestamp": "00:44:07", "text": "如果你精通它，那么你就会喜欢它。"}, {"type": "subtitle", "time": 2649.75, "timestamp": "00:44:09", "text": "再加一点嗯点"}, {"type": "subtitle", "time": 2652.069, "timestamp": "00:44:12", "text": "运用智慧来对此有所帮助。"}, {"type": "subtitle", "time": 2661.109, "timestamp": "00:44:21", "text": "好的。你认为魅力是必要的吗？"}, {"type": "subtitle", "time": 2665.43, "timestamp": "00:44:25", "text": "嗯，德鲁伊通常不用魅力值。"}, {"type": "subtitle", "time": 2667.43, "timestamp": "00:44:27", "text": "通常是因为魅力主要是为了"}, {"type": "subtitle", "time": 2671.75, "timestamp": "00:44:31", "text": "就像……呃……好吧，所以是你打电话"}, {"type": "subtitle", "time": 2674.95, "timestamp": "00:44:34", "text": "比如面部护理课，因为它们是"}, {"type": "subtitle", "time": 2677.109, "timestamp": "00:44:37", "text": "那些通常进行对讲的人。"}, {"type": "subtitle", "time": 2679.589, "timestamp": "00:44:39", "text": "如果你为那些做了很多事的人做了很多事，那就去做很多事吧。"}, {"type": "subtitle", "time": 2681.75, "timestamp": "00:44:41", "text": "那些会那样的人"}, {"type": "subtitle", "time": 2684.71, "timestamp": "00:44:44", "text": "个人魅力必须很强。德鲁伊"}, {"type": "subtitle", "time": 2688.47, "timestamp": "00:44:48", "text": "一般来说，他们并不需要个人魅力。"}, {"type": "subtitle", "time": 2689.67, "timestamp": "00:44:49", "text": "这取决于你建造的是什么，但是"}, {"type": "subtitle", "time": 2692.63, "timestamp": "00:44:52", "text": "一般来说，像默认的德鲁伊那样的人不会"}, {"type": "subtitle", "time": 2694.309, "timestamp": "00:44:54", "text": "真的很需要。"}, {"type": "subtitle", "time": 2695.829, "timestamp": "00:44:55", "text": "啊，"}, {"type": "subtitle", "time": 2696.87, "timestamp": "00:44:56", "text": "是的。是的。"}, {"type": "subtitle", "time": 2698.55, "timestamp": "00:44:58", "text": "你知道吗？我这就起来"}]
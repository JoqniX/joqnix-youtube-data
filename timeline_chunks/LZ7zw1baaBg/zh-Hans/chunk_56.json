[{"type": "subtitle", "time": 3368.15, "timestamp": "00:56:08", "text": "好的。星界精灵就在那里。"}, {"type": "subtitle", "time": 3377.27, "timestamp": "00:56:17", "text": "什么是自定义血统？那是"}, {"type": "subtitle", "time": 3381.03, "timestamp": "00:56:21", "text": "哦，那基本上就是"}, {"type": "subtitle", "time": 3384.069, "timestamp": "00:56:24", "text": "就像随便挑一样。"}, {"type": "subtitle", "time": 3386.63, "timestamp": "00:56:26", "text": "哦，好的。好的。"}, {"type": "subtitle", "time": 3390.069, "timestamp": "00:56:30", "text": "嗯，好的。呃"}, {"type": "subtitle", "time": 3393.829, "timestamp": "00:56:33", "text": "没有专业护具吗？"}, {"type": "subtitle", "time": 3394.549, "timestamp": "00:56:34", "text": "保护者？"}, {"type": "subtitle", "time": 3397.829, "timestamp": "00:56:37", "text": "哦，那更像是背景。"}, {"type": "subtitle", "time": 3400.309, "timestamp": "00:56:40", "text": "哦好的。"}, {"type": "subtitle", "time": 3401.67, "timestamp": "00:56:41", "text": "坚持，稍等。等等，稍等。等待。什么是"}, {"type": "subtitle", "time": 3403.349, "timestamp": "00:56:43", "text": "你在说什么？稍等片刻。是"}, {"type": "subtitle", "time": 3404.95, "timestamp": "00:56:44", "text": "那或许是一个选择，我"}, {"type": "subtitle", "time": 3406.71, "timestamp": "00:56:46", "text": "不知道还是没填？因为如果"}, {"type": "subtitle", "time": 3407.91, "timestamp": "00:56:47", "text": "还有一个选项我还没加上去。"}, {"type": "subtitle", "time": 3409.67, "timestamp": "00:56:49", "text": "我现在就可以把它装进去。"}, {"type": "subtitle", "time": 3413.27, "timestamp": "00:56:53", "text": "它说呃，作为"}, {"type": "subtitle", "time": 3416.47, "timestamp": "00:56:56", "text": "亡者的守护者。"}, {"type": "subtitle", "time": 3417.99, "timestamp": "00:56:57", "text": "让我看看。"}]
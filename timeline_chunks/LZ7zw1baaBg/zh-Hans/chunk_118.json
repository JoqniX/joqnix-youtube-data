[{"type": "subtitle", "time": 7080.31, "timestamp": "01:58:00", "text": "这样你就无法真正获得……"}, {"type": "subtitle", "time": 7081.83, "timestamp": "01:58:01", "text": "火球术，它也很不错。"}, {"type": "subtitle", "time": 7083.99, "timestamp": "01:58:03", "text": "造成1点伤害。所以，剩下的就是……"}, {"type": "subtitle", "time": 7086.39, "timestamp": "01:58:06", "text": "比如，呃，从技术上讲，造成伤害是什么？"}, {"type": "subtitle", "time": 7090.709, "timestamp": "01:58:10", "text": "但它还是有一定的实用价值。"}, {"type": "subtitle", "time": 7092.87, "timestamp": "01:58:12", "text": "例如，就像明星挥棒落空较少一样。"}, {"type": "subtitle", "time": 7095.51, "timestamp": "01:58:15", "text": "呃，就像要处理隐形的东西一样。"}, {"type": "subtitle", "time": 7097.35, "timestamp": "01:58:17", "text": "事物。你也可以像这样"}, {"type": "subtitle", "time": 7100.229, "timestamp": "01:58:20", "text": "霹雳。它就像一个范围攻击技能。"}, {"type": "subtitle", "time": 7101.669, "timestamp": "01:58:21", "text": "你周围，但你需要"}, {"type": "subtitle", "time": 7105.189, "timestamp": "01:58:25", "text": "差不多就行了。进而"}, {"type": "subtitle", "time": 7107.33, "timestamp": "01:58:27", "text": "是的，"}, {"type": "subtitle", "time": 7109.83, "timestamp": "01:58:29", "text": "[音乐]"}, {"type": "subtitle", "time": 7112.39, "timestamp": "01:58:32", "text": "八九不离十。哦，我可以，我可以连击"}, {"type": "subtitle", "time": 7115.35, "timestamp": "01:58:35", "text": "它长着带刺的网，对吧？"}, {"type": "subtitle", "time": 7118.39, "timestamp": "01:58:38", "text": "嗯，是的，但是你需要喜欢你"}, {"type": "subtitle", "time": 7120.55, "timestamp": "01:58:40", "text": "每回合只能施放一个罐子。所以就像"}, {"type": "subtitle", "time": 7122.87, "timestamp": "01:58:42", "text": "呃，你需要假设他们不会。"}, {"type": "subtitle", "time": 7125.03, "timestamp": "01:58:45", "text": "轮到他们行动。"}, {"type": "subtitle", "time": 7126.39, "timestamp": "01:58:46", "text": "是的。"}, {"type": "subtitle", "time": 7128.95, "timestamp": "01:58:48", "text": "哦，不。使用 Thunderclap 的人"}, {"type": "subtitle", "time": 7130.709, "timestamp": "01:58:50", "text": "通常更像是前线人员。"}, {"type": "subtitle", "time": 7133.27, "timestamp": "01:58:53", "text": "他们就走到前面，然后就像"}, {"type": "subtitle", "time": 7135.27, "timestamp": "01:58:55", "text": "直接跳进一堆敌人里"}, {"type": "subtitle", "time": 7137.589, "timestamp": "01:58:57", "text": "用它，因为它大概有5英尺长。"}]
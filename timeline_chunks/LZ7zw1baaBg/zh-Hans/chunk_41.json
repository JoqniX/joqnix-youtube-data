[{"type": "subtitle", "time": 2460.95, "timestamp": "00:41:00", "text": "是的。"}, {"type": "subtitle", "time": 2463.589, "timestamp": "00:41:03", "text": "好的。宪法与魔法有何相似之处？"}, {"type": "subtitle", "time": 2465.67, "timestamp": "00:41:05", "text": "好的。我猜，呃，好吧。我想我会"}, {"type": "subtitle", "time": 2468.79, "timestamp": "00:41:08", "text": "请解释一下我的每一项得分。"}, {"type": "subtitle", "time": 2471.67, "timestamp": "00:41:11", "text": "一。力量就是，嗯，力量。"}, {"type": "subtitle", "time": 2472.87, "timestamp": "00:41:12", "text": "我想这应该很明显吧。就像"}, {"type": "subtitle", "time": 2475.43, "timestamp": "00:41:15", "text": "你的拳头有多重？灵巧性是"}, {"type": "subtitle", "time": 2477.67, "timestamp": "00:41:17", "text": "比如你的反应速度，你有多擅长"}, {"type": "subtitle", "time": 2480.71, "timestamp": "00:41:20", "text": "比如你搬家之类的。嗯，"}, {"type": "subtitle", "time": 2484.71, "timestamp": "00:41:24", "text": "体质就是你的身体状态"}, {"type": "subtitle", "time": 2488.55, "timestamp": "00:41:28", "text": "比如，你有多耐用。"}, {"type": "subtitle", "time": 2491.99, "timestamp": "00:41:31", "text": "智力就是聪明才智。智慧是……"}, {"type": "subtitle", "time": 2495.03, "timestamp": "00:41:35", "text": "智慧和魅力取决于你在这方面的能力。"}, {"type": "subtitle", "time": 2496.309, "timestamp": "00:41:36", "text": "比如做一些说服之类的事情"}, {"type": "subtitle", "time": 2498.63, "timestamp": "00:41:38", "text": "人，诸如此类的事情。"}, {"type": "subtitle", "time": 2504.069, "timestamp": "00:41:44", "text": "好的。好的。"}, {"type": "subtitle", "time": 2505.589, "timestamp": "00:41:45", "text": "呃"}, {"type": "subtitle", "time": 2508.15, "timestamp": "00:41:48", "text": "你怎么认为？你觉得我怎么样？"}, {"type": "subtitle", "time": 2509.75, "timestamp": "00:41:49", "text": "应该吗？呃"}, {"type": "subtitle", "time": 2512.069, "timestamp": "00:41:52", "text": "德鲁伊。是的，德鲁伊往往喜欢……"}, {"type": "subtitle", "time": 2514.87, "timestamp": "00:41:54", "text": "你知道，德鲁伊通常都想达到最高等级。"}, {"type": "subtitle", "time": 2516.55, "timestamp": "00:41:56", "text": "展现他们的智慧，因为智慧就是"}, {"type": "subtitle", "time": 2518.79, "timestamp": "00:41:58", "text": "他们的施法修正值。就是这样。"}]
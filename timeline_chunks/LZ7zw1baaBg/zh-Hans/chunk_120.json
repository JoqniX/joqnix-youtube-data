[{"type": "subtitle", "time": 7200.87, "timestamp": "02:00:00", "text": "宪法，对吧？不，不是"}, {"type": "subtitle", "time": 7202.709, "timestamp": "02:00:02", "text": "宪法。可能会绊倒。"}, {"type": "subtitle", "time": 7205.75, "timestamp": "02:00:05", "text": "又一个罐头撕裂。是的。"}, {"type": "subtitle", "time": 7207.91, "timestamp": "02:00:07", "text": "呃，"}, {"type": "subtitle", "time": 7211.5, "timestamp": "02:00:11", "text": "这是第四级。"}, {"type": "subtitle", "time": 7217.51, "timestamp": "02:00:17", "text": "世上真的有魔法石吗？哦，不是的。"}, {"type": "subtitle", "time": 7218.31, "timestamp": "02:00:18", "text": "哦，是的。魔法存在。"}, {"type": "subtitle", "time": 7219.99, "timestamp": "02:00:19", "text": "这里有块石头。是的，那里有块魔法石。"}, {"type": "subtitle", "time": 7223.189, "timestamp": "02:00:23", "text": "这里。这是什么？"}, {"type": "subtitle", "time": 7223.589, "timestamp": "02:00:23", "text": "呃，"}, {"type": "subtitle", "time": 7227.189, "timestamp": "02:00:27", "text": "魔法石呃，它纯粹是伤害型的。"}, {"type": "subtitle", "time": 7229.27, "timestamp": "02:00:29", "text": "处理戏法，但它也像"}, {"type": "subtitle", "time": 7231.189, "timestamp": "02:00:31", "text": "其实还不错，因为你"}, {"type": "subtitle", "time": 7233.27, "timestamp": "02:00:33", "text": "实际上加上你的施法修正值"}, {"type": "subtitle", "time": 7235.91, "timestamp": "02:00:35", "text": "为了它。"}, {"type": "subtitle", "time": 7239.43, "timestamp": "02:00:39", "text": "哦，那对我来说岂不是更好吗？"}, {"type": "subtitle", "time": 7241.43, "timestamp": "02:00:41", "text": "嗯，你是什么意思？"}, {"type": "subtitle", "time": 7244.229, "timestamp": "02:00:44", "text": "这对我的统计数据不是更有利吗？"}, {"type": "subtitle", "time": 7245.669, "timestamp": "02:00:45", "text": "一切？"}, {"type": "subtitle", "time": 7248.07, "timestamp": "02:00:48", "text": "嗯，是"}, {"type": "subtitle", "time": 7249.91, "timestamp": "02:00:49", "text": "呃，这不一定就是更好。"}, {"type": "subtitle", "time": 7252.629, "timestamp": "02:00:52", "text": "更像是一次露营旅行。"}, {"type": "subtitle", "time": 7255.03, "timestamp": "02:00:55", "text": "只需专注于造成伤害。它是"}, {"type": "subtitle", "time": 7257.91, "timestamp": "02:00:57", "text": "纯粹为了造成伤害。"}]
[{"type": "subtitle", "time": 3961.349, "timestamp": "01:06:01", "text": "更多的是一种实用功能。"}, {"type": "subtitle", "time": 3963.51, "timestamp": "01:06:03", "text": "它能发光。同样适用于"}, {"type": "subtitle", "time": 3965.51, "timestamp": "01:06:05", "text": "光。"}, {"type": "subtitle", "time": 3967.91, "timestamp": "01:06:07", "text": "哦，光明之力。好的。"}, {"type": "subtitle", "time": 3968.63, "timestamp": "01:06:08", "text": "是的。"}, {"type": "subtitle", "time": 3969.029, "timestamp": "01:06:09", "text": "呃"}, {"type": "subtitle", "time": 3971.029, "timestamp": "01:06:11", "text": "它不是用来破坏东西的。这是为了"}, {"type": "subtitle", "time": 3973.589, "timestamp": "01:06:13", "text": "公用事业。"}, {"type": "subtitle", "time": 3976.87, "timestamp": "01:06:16", "text": "哦，所以这个额外的法术是……"}, {"type": "subtitle", "time": 3980.309, "timestamp": "01:06:20", "text": "你也可以选择一些有害的选项。"}, {"type": "subtitle", "time": 3982.95, "timestamp": "01:06:22", "text": "是的。咒语一和咒语二。拼写一"}, {"type": "subtitle", "time": 3984.549, "timestamp": "01:06:24", "text": "施放一个法术组合，就能跳舞"}, {"type": "subtitle", "time": 3986.47, "timestamp": "01:06:26", "text": "“光亮术”是一个实用法术。拼写"}, {"type": "subtitle", "time": 3988.23, "timestamp": "01:06:28", "text": "第二组功能可以让你获得另一种实用照明工具。"}, {"type": "subtitle", "time": 3990.71, "timestamp": "01:06:30", "text": "咒语和咒语套装三会给你……"}, {"type": "subtitle", "time": 3993.91, "timestamp": "01:06:33", "text": "呃，神圣的火焰，呃，它具有破坏性。"}, {"type": "subtitle", "time": 3996.71, "timestamp": "01:06:36", "text": "咒语或咒语。这取决于你"}, {"type": "subtitle", "time": 3998.23, "timestamp": "01:06:38", "text": "你想选哪个？因为之后"}, {"type": "subtitle", "time": 4000.23, "timestamp": "01:06:40", "text": "你还会得到更多"}, {"type": "subtitle", "time": 4003.91, "timestamp": "01:06:43", "text": "添加课程时，您可以稍后选择其他选项。"}, {"type": "subtitle", "time": 4007.349, "timestamp": "01:06:47", "text": "哦好的。嗯，"}, {"type": "subtitle", "time": 4009.91, "timestamp": "01:06:49", "text": "哦，就像……我觉得是跳舞的光"}, {"type": "subtitle", "time": 4012.87, "timestamp": "01:06:52", "text": "就像是照亮某个地方一样，对吧？"}]
[{"type": "subtitle", "time": 2340.87, "timestamp": "00:39:00", "text": "你的呃，我猜就像基地一样。好的。所以，"}, {"type": "subtitle", "time": 2343.91, "timestamp": "00:39:03", "text": "咱们先从嗯……开始吧。"}, {"type": "subtitle", "time": 2346.39, "timestamp": "00:39:06", "text": "又叫什么来着？"}, {"type": "subtitle", "time": 2349.109, "timestamp": "00:39:09", "text": "呃，塑造你的品格。好的。我是"}, {"type": "subtitle", "time": 2351.51, "timestamp": "00:39:11", "text": "即将快速分享铸造厂"}, {"type": "subtitle", "time": 2355.109, "timestamp": "00:39:15", "text": "改用虚拟终端，这样你就可以点赞了。"}, {"type": "subtitle", "time": 2356.87, "timestamp": "00:39:16", "text": "嗯"}, {"type": "subtitle", "time": 2360.23, "timestamp": "00:39:20", "text": "再打一次电话，嗯，我可以告诉你该怎么做。"}, {"type": "subtitle", "time": 2364.71, "timestamp": "00:39:24", "text": "检查一下。好的。嗯，好的。所以"}, {"type": "subtitle", "time": 2367.349, "timestamp": "00:39:27", "text": "首先，我需要把这个给你。"}, {"type": "subtitle", "time": 2369.51, "timestamp": "00:39:29", "text": "它在哪里？嗯"}, {"type": "subtitle", "time": 2371.51, "timestamp": "00:39:31", "text": "呃，它在哪儿？坚持，稍等。给我一个"}, {"type": "subtitle", "time": 2373.67, "timestamp": "00:39:33", "text": "第二。"}, {"type": "subtitle", "time": 2383.51, "timestamp": "00:39:43", "text": "这是为了获取你的基础统计数据。"}, {"type": "subtitle", "time": 2387.109, "timestamp": "00:39:47", "text": "好的。然后我们来看看。我要"}, {"type": "subtitle", "time": 2394.47, "timestamp": "00:39:54", "text": "好的。好了。"}, {"type": "subtitle", "time": 2397.589, "timestamp": "00:39:57", "text": "好的。你应该拥有的那个网站"}, {"type": "subtitle", "time": 2399.67, "timestamp": "00:39:59", "text": "应该有个类似“呃，什么叫什么”的东西"}]
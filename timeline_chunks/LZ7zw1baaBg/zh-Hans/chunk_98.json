[{"type": "subtitle", "time": 5880.07, "timestamp": "01:38:00", "text": "自由的。这只会给你带来另一种伤害。"}, {"type": "subtitle", "time": 5884.149, "timestamp": "01:38:04", "text": "如果你喜欢，可以输入，但大多数人通常会选择"}, {"type": "subtitle", "time": 5886.39, "timestamp": "01:38:06", "text": "魔术师就像一个额外的工具"}, {"type": "subtitle", "time": 5889.109, "timestamp": "01:38:09", "text": "拼写。"}, {"type": "subtitle", "time": 5899.03, "timestamp": "01:38:19", "text": "你有什么建议吗？"}, {"type": "subtitle", "time": 5899.83, "timestamp": "01:38:19", "text": "嗯，"}, {"type": "subtitle", "time": 5902.31, "timestamp": "01:38:22", "text": "我想我还是选魔术师吧，这样我就可以……"}, {"type": "subtitle", "time": 5903.669, "timestamp": "01:38:23", "text": "现在再选一个。"}, {"type": "subtitle", "time": 5906.95, "timestamp": "01:38:26", "text": "好的。好的。好的。嗯，什么"}, {"type": "subtitle", "time": 5909.27, "timestamp": "01:38:29", "text": "你想拼写什么？你呃，选择什么？"}, {"type": "subtitle", "time": 5910.41, "timestamp": "01:38:30", "text": "这？"}, {"type": "subtitle", "time": 5923.35, "timestamp": "01:38:43", "text": "好的。呃，这是什么？呃"}, {"type": "subtitle", "time": 5927.99, "timestamp": "01:38:47", "text": "嗯，那就像一个“什么是名字”的问题"}, {"type": "subtitle", "time": 5931.59, "timestamp": "01:38:51", "text": "搜索？什么是音调撕裂？"}, {"type": "subtitle", "time": 5935.35, "timestamp": "01:38:55", "text": "撕裂的鞭子就是这个，你攻击，"}, {"type": "subtitle", "time": 5938.55, "timestamp": "01:38:58", "text": "你可以吸引人们向你靠拢。"}]
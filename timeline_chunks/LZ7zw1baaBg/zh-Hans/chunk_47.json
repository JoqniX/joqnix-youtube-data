[{"type": "subtitle", "time": 2820.15, "timestamp": "00:47:00", "text": "嗯，让我再确认一下你是否可以使用"}, {"type": "subtitle", "time": 2821.99, "timestamp": "00:47:01", "text": "但它，但让我看看你是否有喜欢的"}, {"type": "subtitle", "time": 2826.15, "timestamp": "00:47:06", "text": "她能在这方面努力吗？让我看看。嗯"}, {"type": "subtitle", "time": 2828.55, "timestamp": "00:47:08", "text": "嗯，好的。不。好的。但是，是的，你"}, {"type": "subtitle", "time": 2831.99, "timestamp": "00:47:11", "text": "你可以使用弓箭。等等。"}, {"type": "subtitle", "time": 2835.27, "timestamp": "00:47:15", "text": "让我看看会不会出现船员罢工的情况。"}, {"type": "subtitle", "time": 2841.99, "timestamp": "00:47:21", "text": "罢工。这真的有效吗？不。"}, {"type": "subtitle", "time": 2843.91, "timestamp": "00:47:23", "text": "好的。好的。所以，是的，你可以这样做"}, {"type": "subtitle", "time": 2846.87, "timestamp": "00:47:26", "text": "那。呃，如果你想用弓箭的话，"}, {"type": "subtitle", "time": 2848.79, "timestamp": "00:47:28", "text": "你希望你的灵巧度很高。"}, {"type": "subtitle", "time": 2851.51, "timestamp": "00:47:31", "text": "因为灵巧性是你的……"}, {"type": "subtitle", "time": 2854.95, "timestamp": "00:47:34", "text": "远程武器的能力值。"}, {"type": "subtitle", "time": 2859.91, "timestamp": "00:47:39", "text": "好的。"}, {"type": "subtitle", "time": 2864.71, "timestamp": "00:47:44", "text": "这个怎么样？增强力量。"}, {"type": "subtitle", "time": 2871.03, "timestamp": "00:47:51", "text": "有点儿。宪法。我把它放进去了"}, {"type": "subtitle", "time": 2872.95, "timestamp": "00:47:52", "text": "降到“是的”。"}, {"type": "subtitle", "time": 2877.19, "timestamp": "00:47:57", "text": "好的。好的。我们可以让我这样做"}, {"type": "subtitle", "time": 2879.75, "timestamp": "00:47:59", "text": "我当时的想法是，这样做能让我做什么"}]
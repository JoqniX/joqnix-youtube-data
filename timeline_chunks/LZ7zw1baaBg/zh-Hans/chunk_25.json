[{"type": "subtitle", "time": 1501.669, "timestamp": "00:25:01", "text": "嗯，如果你还不知道的话，呃，你可以"}, {"type": "subtitle", "time": 1505.19, "timestamp": "00:25:05", "text": "也看看我写的那些东西，比如……"}, {"type": "subtitle", "time": 1507.269, "timestamp": "00:25:07", "text": "概述所有课程，或者如果您"}, {"type": "subtitle", "time": 1508.47, "timestamp": "00:25:08", "text": "不想"}, {"type": "subtitle", "time": 1510.95, "timestamp": "00:25:10", "text": "打开浏览器访问那个页面。"}, {"type": "subtitle", "time": 1512.95, "timestamp": "00:25:12", "text": "哦，不是那个。不是那样。那真是个呃"}, {"type": "subtitle", "time": 1515.35, "timestamp": "00:25:15", "text": "坚持，稍等。那是什么按钮？"}, {"type": "subtitle", "time": 1519.269, "timestamp": "00:25:19", "text": "我点击了“添加物种”。"}, {"type": "subtitle", "time": 1521.11, "timestamp": "00:25:21", "text": "哦，是的。是的。先把这个关掉吧。"}, {"type": "subtitle", "time": 1522.47, "timestamp": "00:25:22", "text": "赶紧关掉它，因为那样就……"}, {"type": "subtitle", "time": 1525.51, "timestamp": "00:25:25", "text": "第二步。第二步"}, {"type": "subtitle", "time": 1528.149, "timestamp": "00:25:28", "text": "点击东西，因为有时候它会……"}, {"type": "subtitle", "time": 1529.669, "timestamp": "00:25:29", "text": "做些滑稽的事。"}, {"type": "subtitle", "time": 1532.789, "timestamp": "00:25:32", "text": "好的。好的。是的。是的。"}, {"type": "subtitle", "time": 1535.83, "timestamp": "00:25:35", "text": "呃，我要给你发一个"}, {"type": "subtitle", "time": 1537.59, "timestamp": "00:25:37", "text": "事物。让我把它发过去。"}, {"type": "subtitle", "time": 1539.029, "timestamp": "00:25:39", "text": "在"}, {"type": "subtitle", "time": 1542.23, "timestamp": "00:25:42", "text": "嗯，你的私信。它在哪里？呃，让我"}, {"type": "subtitle", "time": 1543.59, "timestamp": "00:25:43", "text": "赶紧拿到。我认为是流媒体"}, {"type": "subtitle", "time": 1544.789, "timestamp": "00:25:44", "text": "资源。"}, {"type": "subtitle", "time": 1546.71, "timestamp": "00:25:46", "text": "好的。事情是这样的。我要去"}, {"type": "subtitle", "time": 1549.11, "timestamp": "00:25:49", "text": "把它给你。但是，呃，这也是"}, {"type": "subtitle", "time": 1551.11, "timestamp": "00:25:51", "text": "就像一些你不应该展示的东西"}, {"type": "subtitle", "time": 1553.11, "timestamp": "00:25:53", "text": "出于某些原因，我也会进行直播。"}, {"type": "subtitle", "time": 1555.83, "timestamp": "00:25:55", "text": "嗯，我稍后可以跟你解释。"}, {"type": "subtitle", "time": 1558.95, "timestamp": "00:25:58", "text": "溪流。但是，嗯，如果你可以的话，就过来这边吧。"}]
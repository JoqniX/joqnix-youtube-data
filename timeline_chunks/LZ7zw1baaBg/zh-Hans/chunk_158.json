[{"type": "subtitle", "time": 9481.349, "timestamp": "02:38:01", "text": "如果你没有那种英雄主义的心态，你就可以"}, {"type": "subtitle", "time": 9482.63, "timestamp": "02:38:02", "text": "只施放没有"}, {"type": "subtitle", "time": 9484.71, "timestamp": "02:38:04", "text": "材料成分。如果你有"}, {"type": "subtitle", "time": 9487.75, "timestamp": "02:38:07", "text": "你拿着它，你可以施法……嗯……"}, {"type": "subtitle", "time": 9490.07, "timestamp": "02:38:10", "text": "你可以施放大多数法术，几乎所有法术。"}, {"type": "subtitle", "time": 9491.99, "timestamp": "02:38:11", "text": "咒语。"}, {"type": "subtitle", "time": 9494.55, "timestamp": "02:38:14", "text": "我想我晚点会买个木制的东西。"}, {"type": "subtitle", "time": 9496.389, "timestamp": "02:38:16", "text": "是的。是的。是的。我，我，我会交换你的"}, {"type": "subtitle", "time": 9497.75, "timestamp": "02:38:17", "text": "专注地看着一根木杖，因为"}, {"type": "subtitle", "time": 9500.309, "timestamp": "02:38:20", "text": "流口水般的焦点就像一个通用的"}, {"type": "subtitle", "time": 9501.91, "timestamp": "02:38:21", "text": "变体。所以，我打算换个方式。"}, {"type": "subtitle", "time": 9503.51, "timestamp": "02:38:23", "text": "对员工来说。"}, {"type": "subtitle", "time": 9506.87, "timestamp": "02:38:26", "text": "嗯，让我快速地把这个交给"}, {"type": "subtitle", "time": 9514.469, "timestamp": "02:38:34", "text": "它有操作日志吗？给出"}, {"type": "subtitle", "time": 9516.79, "timestamp": "02:38:36", "text": "一切都结束了吗？"}, {"type": "subtitle", "time": 9517.83, "timestamp": "02:38:37", "text": "什么？对不起。"}, {"type": "subtitle", "time": 9520.07, "timestamp": "02:38:40", "text": "它有类似操作日志之类的东西吗？"}, {"type": "subtitle", "time": 9522.15, "timestamp": "02:38:42", "text": "是赠送给人们的物品"}, {"type": "subtitle", "time": 9523.75, "timestamp": "02:38:43", "text": "ETC。"}, {"type": "subtitle", "time": 9527.83, "timestamp": "02:38:47", "text": "哦，是的。是的。嗯——等等。就像"}, {"type": "subtitle", "time": 9529.349, "timestamp": "02:38:49", "text": "呃"}, {"type": "subtitle", "time": 9531.349, "timestamp": "02:38:51", "text": "有些我记不清了，但是"}, {"type": "subtitle", "time": 9532.87, "timestamp": "02:38:52", "text": "只有一部分。好的，我要走了"}, {"type": "subtitle", "time": 9534.55, "timestamp": "02:38:54", "text": "就像……交换一下。好了。"}, {"type": "subtitle", "time": 9537.83, "timestamp": "02:38:57", "text": "好了，现在，呃，拖你的四分之一棍"}]
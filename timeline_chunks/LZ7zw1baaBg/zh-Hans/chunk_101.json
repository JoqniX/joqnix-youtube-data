[{"type": "subtitle", "time": 6061.35, "timestamp": "01:41:01", "text": "一个实用法术。"}, {"type": "subtitle", "time": 6062.55, "timestamp": "01:41:02", "text": "你可以做很多不同的事情"}, {"type": "subtitle", "time": 6064.149, "timestamp": "01:41:04", "text": "和它一起。呃，"}, {"type": "subtitle", "time": 6066.95, "timestamp": "01:41:06", "text": "我必须选择这些效果。"}, {"type": "subtitle", "time": 6069.109, "timestamp": "01:41:09", "text": "嗯，是的。每次你施法"}, {"type": "subtitle", "time": 6070.87, "timestamp": "01:41:10", "text": "这个法术，你可以选择其中一个。"}, {"type": "subtitle", "time": 6073.75, "timestamp": "01:41:13", "text": "你想做哪一个都行。"}, {"type": "subtitle", "time": 6076.39, "timestamp": "01:41:16", "text": "哦，就好像我不能……"}, {"type": "subtitle", "time": 6078.87, "timestamp": "01:41:18", "text": "就像随机扭蛋一样"}, {"type": "subtitle", "time": 6080.31, "timestamp": "01:41:20", "text": "哦，不。这并非偶然。你来选"}, {"type": "subtitle", "time": 6082.31, "timestamp": "01:41:22", "text": "你想要的那个"}, {"type": "subtitle", "time": 6085.35, "timestamp": "01:41:25", "text": "每次我攻击或"}, {"type": "subtitle", "time": 6088.07, "timestamp": "01:41:28", "text": "呃，这不是攻击。嗯，更像是"}, {"type": "subtitle", "time": 6090.229, "timestamp": "01:41:30", "text": "用于实用。"}, {"type": "subtitle", "time": 6091.91, "timestamp": "01:41:31", "text": "哦好的。"}, {"type": "subtitle", "time": 6098.39, "timestamp": "01:41:38", "text": "就像你可以……例如"}, {"type": "subtitle", "time": 6100.149, "timestamp": "01:41:40", "text": "利用元素主义，你可以关闭和打开"}, {"type": "subtitle", "time": 6103.59, "timestamp": "01:41:43", "text": "从远处看，门。你可以点赞"}, {"type": "subtitle", "time": 6107.109, "timestamp": "01:41:47", "text": "呃，你叫什么来着？呃，点蜡烛。"}, {"type": "subtitle", "time": 6109.83, "timestamp": "01:41:49", "text": "还有空无一物的火炬。"}, {"type": "subtitle", "time": 6113.75, "timestamp": "01:41:53", "text": "你刚才叫什么来着？"}]
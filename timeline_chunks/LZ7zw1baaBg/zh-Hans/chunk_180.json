[{"type": "subtitle", "time": 10800.389, "timestamp": "03:00:00", "text": "哦，雨水收集器。哇。有图片吗？"}, {"type": "subtitle", "time": 10804.55, "timestamp": "03:00:04", "text": "为了这？不。好的。肥皂。"}, {"type": "subtitle", "time": 10807.11, "timestamp": "03:00:07", "text": "你可以买到肥皂。"}, {"type": "subtitle", "time": 10820.79, "timestamp": "03:00:20", "text": "好的，我知道我会买，所以我跟你一起去。"}, {"type": "subtitle", "time": 10825.75, "timestamp": "03:00:25", "text": "呃，顺便说一句，你没有弓。"}, {"type": "subtitle", "time": 10827.51, "timestamp": "03:00:27", "text": "你可能需要先买把弓。"}, {"type": "subtitle", "time": 10829.429, "timestamp": "03:00:29", "text": "哦好的。呃，好的。"}, {"type": "subtitle", "time": 10832.63, "timestamp": "03:00:32", "text": "你没有弓。"}, {"type": "subtitle", "time": 10835.429, "timestamp": "03:00:35", "text": "好的。弓，"}, {"type": "subtitle", "time": 10838.469, "timestamp": "03:00:38", "text": "手、弩、长弓。"}, {"type": "subtitle", "time": 10840.309, "timestamp": "03:00:40", "text": "好的。哦，是的。请记住以上内容"}, {"type": "subtitle", "time": 10843.11, "timestamp": "03:00:43", "text": "这里，呃，你的武器熟练度，"}, {"type": "subtitle", "time": 10844.55, "timestamp": "03:00:44", "text": "你只精通简单的"}, {"type": "subtitle", "time": 10846.469, "timestamp": "03:00:46", "text": "武器。所以你只能选择一个。"}, {"type": "subtitle", "time": 10847.99, "timestamp": "03:00:47", "text": "上面写的是简易武器。所以要么是"}, {"type": "subtitle", "time": 10849.67, "timestamp": "03:00:49", "text": "短弓或轻型弩。这"}, {"type": "subtitle", "time": 10851.269, "timestamp": "03:00:51", "text": "其他的则是元帅武器。你不能"}, {"type": "subtitle", "time": 10853.83, "timestamp": "03:00:53", "text": "实际运用它们。"}, {"type": "subtitle", "time": 10855.349, "timestamp": "03:00:55", "text": "啊"}]
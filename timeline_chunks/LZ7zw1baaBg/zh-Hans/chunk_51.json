[{"type": "subtitle", "time": 3060.95, "timestamp": "00:51:00", "text": "你想要构建的东西。人类是"}, {"type": "subtitle", "time": 3063.27, "timestamp": "00:51:03", "text": "总体来说都是不错的全能型选手。"}, {"type": "subtitle", "time": 3064.069, "timestamp": "00:51:04", "text": "呃"}, {"type": "subtitle", "time": 3066.79, "timestamp": "00:51:06", "text": "其他班级通常会有……什么？"}, {"type": "subtitle", "time": 3069.27, "timestamp": "00:51:09", "text": "又打来电话了？呃，不同，不同，呃"}, {"type": "subtitle", "time": 3072.309, "timestamp": "00:51:12", "text": "就像他们所具有的某些特质一样。和"}, {"type": "subtitle", "time": 3075.99, "timestamp": "00:51:15", "text": "嗯，刚才是什么电话？"}, {"type": "subtitle", "time": 3078.71, "timestamp": "00:51:18", "text": "呃，什么？我忘了我想说什么了。"}, {"type": "subtitle", "time": 3080.549, "timestamp": "00:51:20", "text": "说。"}, {"type": "subtitle", "time": 3082.309, "timestamp": "00:51:22", "text": "哦，对，唯一，唯一的事情是"}, {"type": "subtitle", "time": 3084.71, "timestamp": "00:51:24", "text": "人类就像是唯一一种……呃……非"}, {"type": "chat", "time": 3085.596, "timestamp": "00:51:25", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "hewwo kosmik"}, {"type": "subtitle", "time": 3086.23, "timestamp": "00:51:26", "text": "人类最伟大的一点就是他们"}, {"type": "subtitle", "time": 3087.51, "timestamp": "00:51:27", "text": "我们没有暗视能力，所以我们不能"}, {"type": "subtitle", "time": 3090.71, "timestamp": "00:51:30", "text": "真正地看清了黑暗。但是，呃，别担心"}, {"type": "chat", "time": 3091.292, "timestamp": "00:51:31", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "yea its been a while~"}, {"type": "subtitle", "time": 3101.109, "timestamp": "00:51:41", "text": "呃"}, {"type": "subtitle", "time": 3103.67, "timestamp": "00:51:43", "text": "或者它也在那里。这就像《世界》"}, {"type": "subtitle", "time": 3107.27, "timestamp": "00:51:47", "text": "魔兽世界之类的。"}, {"type": "subtitle", "time": 3109.349, "timestamp": "00:51:49", "text": "有很多不同的东西。"}]
[{"type": "subtitle", "time": 845.75, "timestamp": "00:14:05", "text": "我的天啊。好的。"}, {"type": "subtitle", "time": 848.79, "timestamp": "00:14:08", "text": "这首歌是这样唱的。"}, {"type": "subtitle", "time": 851.269, "timestamp": "00:14:11", "text": "他是"}, {"type": "subtitle", "time": 855.75, "timestamp": "00:14:15", "text": "啊，是的，我注意到了。我有点"}, {"type": "subtitle", "time": 862.55, "timestamp": "00:14:22", "text": "我为什么要这样拆分呢？"}, {"type": "subtitle", "time": 864.389, "timestamp": "00:14:24", "text": "我不知道。"}, {"type": "subtitle", "time": 866.71, "timestamp": "00:14:26", "text": "你真的很厉害。"}, {"type": "subtitle", "time": 869.67, "timestamp": "00:14:29", "text": "这里开始下雨了。"}, {"type": "subtitle", "time": 871.35, "timestamp": "00:14:31", "text": "哦，"}, {"type": "subtitle", "time": 873.59, "timestamp": "00:14:33", "text": "是的。哦，是的。你可以唱歌。这"}, {"type": "subtitle", "time": 876.55, "timestamp": "00:14:36", "text": "这是你第五次唱了，就跟着唱吧。"}, {"type": "subtitle", "time": 878.79, "timestamp": "00:14:38", "text": "纯音乐。我认为你应该得到"}, {"type": "subtitle", "time": 881.35, "timestamp": "00:14:41", "text": "适用于器乐版本。我是"}, {"type": "subtitle", "time": 882.55, "timestamp": "00:14:42", "text": "只让你唱这首"}, {"type": "subtitle", "time": 884.79, "timestamp": "00:14:44", "text": "器乐版基本上是为"}, {"type": "subtitle", "time": 886.47, "timestamp": "00:14:46", "text": "战斗的剩余部分。"}, {"type": "subtitle", "time": 889.269, "timestamp": "00:14:49", "text": "呃，只有乐器演奏部分，没有指导。"}, {"type": "subtitle", "time": 889.91, "timestamp": "00:14:49", "text": "好的。"}, {"type": "subtitle", "time": 892.389, "timestamp": "00:14:52", "text": "是的。它对你们所有人都不起作用"}, {"type": "subtitle", "time": 895.03, "timestamp": "00:14:55", "text": "很遗憾。"}, {"type": "subtitle", "time": 896.629, "timestamp": "00:14:56", "text": "现在，主旋律响起。好的。"}, {"type": "subtitle", "time": 898.79, "timestamp": "00:14:58", "text": "是的。它不起作用。"}, {"type": "subtitle", "time": 899.99, "timestamp": "00:14:59", "text": "你好。"}]
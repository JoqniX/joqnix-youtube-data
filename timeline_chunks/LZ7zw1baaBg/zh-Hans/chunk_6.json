[{"type": "subtitle", "time": 361.83, "timestamp": "00:06:01", "text": "你没有犯任何错误。"}, {"type": "subtitle", "time": 368.629, "timestamp": "00:06:08", "text": "那很好。那很好。"}, {"type": "subtitle", "time": 370.23, "timestamp": "00:06:10", "text": "六次。"}, {"type": "subtitle", "time": 370.87, "timestamp": "00:06:10", "text": "是的，"}, {"type": "subtitle", "time": 373.51, "timestamp": "00:06:13", "text": "第一次尝试跳跃。是的，四个"}, {"type": "subtitle", "time": 376.23, "timestamp": "00:06:16", "text": "还有更多路要走。"}, {"type": "subtitle", "time": 378.71, "timestamp": "00:06:18", "text": "你可以用音乐来做这件事。"}, {"type": "subtitle", "time": 379.43, "timestamp": "00:06:19", "text": "现在。"}, {"type": "subtitle", "time": 388.95, "timestamp": "00:06:28", "text": "伴随着音乐，对吧？好的。所以，呃，"}, {"type": "subtitle", "time": 392.71, "timestamp": "00:06:32", "text": "纯乐器演奏，或者，嗯，"}, {"type": "subtitle", "time": 393.99, "timestamp": "00:06:33", "text": "我来演奏伴奏。"}, {"type": "subtitle", "time": 395.189, "timestamp": "00:06:35", "text": "你会唱歌吗？"}, {"type": "subtitle", "time": 397.35, "timestamp": "00:06:37", "text": "器乐演奏？"}, {"type": "subtitle", "time": 399.83, "timestamp": "00:06:39", "text": "那我试试。"}, {"type": "subtitle", "time": 401.35, "timestamp": "00:06:41", "text": "好的。"}, {"type": "subtitle", "time": 403.27, "timestamp": "00:06:43", "text": "你好。呃，"}, {"type": "subtitle", "time": 404.55, "timestamp": "00:06:44", "text": "祝你好运。"}, {"type": "subtitle", "time": 411.51, "timestamp": "00:06:51", "text": "这个？"}, {"type": "subtitle", "time": 415.43, "timestamp": "00:06:55", "text": "不，我想应该是这个吧。"}, {"type": "chat", "time": 418.924, "timestamp": "00:06:58", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/face-turquoise-music-note"}, {"type": "subtitle", "time": 419.27, "timestamp": "00:06:59", "text": "因为我做不到。好的。"}]
[{"type": "subtitle", "time": 10324.55, "timestamp": "02:52:04", "text": "30英尺。不。哦，我动不了了。"}, {"type": "subtitle", "time": 10328.15, "timestamp": "02:52:08", "text": "好的，你可以稍微动一下，但是"}, {"type": "subtitle", "time": 10332.309, "timestamp": "02:52:12", "text": "好的。呃，搬出某个地方，呃，一些"}, {"type": "subtitle", "time": 10335.51, "timestamp": "02:52:15", "text": "移出生物的攻击范围"}, {"type": "subtitle", "time": 10337.269, "timestamp": "02:52:17", "text": "这会引发一种叫做机会的东西。"}, {"type": "subtitle", "time": 10341.429, "timestamp": "02:52:21", "text": "攻击。所以，你想这么做吗？"}, {"type": "subtitle", "time": 10344.389, "timestamp": "02:52:24", "text": "搬出去后，我只想用唐牌调味料。"}, {"type": "subtitle", "time": 10346.23, "timestamp": "02:52:26", "text": "他被荆棘鞭抽打。"}, {"type": "subtitle", "time": 10348.389, "timestamp": "02:52:28", "text": "好的。好的。是的。好的。在此之前"}, {"type": "subtitle", "time": 10351.91, "timestamp": "02:52:31", "text": "因为你移出了他们的近战范围。"}, {"type": "subtitle", "time": 10354.15, "timestamp": "02:52:34", "text": "当这种情况发生时，他们可以选择"}, {"type": "subtitle", "time": 10356.15, "timestamp": "02:52:36", "text": "发动所谓的攻击"}, {"type": "subtitle", "time": 10357.99, "timestamp": "02:52:37", "text": "机会或机会性攻击。"}, {"type": "subtitle", "time": 10359.51, "timestamp": "02:52:39", "text": "所以，他们可以趁你不注意攻击你。"}, {"type": "subtitle", "time": 10361.269, "timestamp": "02:52:41", "text": "走开了。所以，我打算这么做。"}, {"type": "subtitle", "time": 10364.07, "timestamp": "02:52:44", "text": "很快就能向你展示这一点。"}, {"type": "subtitle", "time": 10366.79, "timestamp": "02:52:46", "text": "就是这样。然后，我们来看看。我们开始吧"}, {"type": "subtitle", "time": 10369.75, "timestamp": "02:52:49", "text": "正常。所以，这次这家伙滚了。"}, {"type": "subtitle", "time": 10372.63, "timestamp": "02:52:52", "text": "12，就在你的空调下面，所以"}, {"type": "subtitle", "time": 10374.469, "timestamp": "02:52:54", "text": "没打中。"}, {"type": "subtitle", "time": 10376.87, "timestamp": "02:52:56", "text": "是的。现在你可以继续你的"}, {"type": "subtitle", "time": 10378.309, "timestamp": "02:52:58", "text": "转动。"}]
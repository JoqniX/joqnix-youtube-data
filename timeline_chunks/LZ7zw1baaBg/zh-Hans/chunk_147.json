[{"type": "subtitle", "time": 8821.11, "timestamp": "02:27:01", "text": "好吧，我是个星际机器人。"}, {"type": "subtitle", "time": 8828.07, "timestamp": "02:27:08", "text": "[音乐]"}, {"type": "subtitle", "time": 8831.11, "timestamp": "02:27:11", "text": "等待。 Super并没有创造任何角色。"}, {"type": "subtitle", "time": 8832.87, "timestamp": "02:27:12", "text": "哦，不。不，Sumi已经做好了，我只是"}, {"type": "subtitle", "time": 8835.83, "timestamp": "02:27:15", "text": "已添加。就像……等等。石头"}, {"type": "subtitle", "time": 8841.99, "timestamp": "02:27:21", "text": "嗯，"}, {"type": "subtitle", "time": 8844.63, "timestamp": "02:27:24", "text": "哦，确实有不同的不同之处"}, {"type": "subtitle", "time": 8847.27, "timestamp": "02:27:27", "text": "姓名。我的天啊。难道只有我一个人这样想吗？"}, {"type": "subtitle", "time": 8852.389, "timestamp": "02:27:32", "text": "我给自己取的名字？我的意思是，呃，米玛尔"}, {"type": "subtitle", "time": 8854.79, "timestamp": "02:27:34", "text": "再次？是的。但我们真的能从技术上讲理解吗？"}, {"type": "subtitle", "time": 8857.75, "timestamp": "02:27:37", "text": "有三个自我代入角色？就像 Sumi 一样"}, {"type": "subtitle", "time": 8860.469, "timestamp": "02:27:40", "text": "技术上来说，扮演 Sumi 和 Ruth 的是"}, {"type": "subtitle", "time": 8868.309, "timestamp": "02:27:48", "text": "我的天哪。"}, {"type": "subtitle", "time": 8877.91, "timestamp": "02:27:57", "text": "好的。"}]
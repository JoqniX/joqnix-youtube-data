[{"type": "subtitle", "time": 8111.99, "timestamp": "02:15:11", "text": "呃。好的。我要一颗好莓。"}, {"type": "subtitle", "time": 8120.229, "timestamp": "02:15:20", "text": "是否存在强化能力？"}, {"type": "subtitle", "time": 8122.55, "timestamp": "02:15:22", "text": "增强什么？哦，能力增强了。我"}, {"type": "subtitle", "time": 8124.629, "timestamp": "02:15:24", "text": "我觉得这就像等级提升一样。"}, {"type": "subtitle", "time": 8126.39, "timestamp": "02:15:26", "text": "能力等级为一级或二级。我不能"}, {"type": "subtitle", "time": 8130.069, "timestamp": "02:15:30", "text": "务必牢记。嗯，我也不知道是否"}, {"type": "subtitle", "time": 8132.229, "timestamp": "02:15:32", "text": "你实际上可以访问它。嗯哦"}, {"type": "subtitle", "time": 8134.629, "timestamp": "02:15:34", "text": "是的，这是二级。嗯，增强功能是"}, {"type": "subtitle", "time": 8135.99, "timestamp": "02:15:35", "text": "二级"}, {"type": "subtitle", "time": 8143.27, "timestamp": "02:15:43", "text": "我有多少钱？九分之五。"}, {"type": "subtitle", "time": 8158.069, "timestamp": "02:15:58", "text": "是否存在星形？明星故事"}, {"type": "subtitle", "time": 8158.39, "timestamp": "02:15:58", "text": "故事明星。"}, {"type": "subtitle", "time": 8159.91, "timestamp": "02:15:59", "text": "哦，你已经明白了。你已经"}]
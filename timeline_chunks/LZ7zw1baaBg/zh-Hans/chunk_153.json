[{"type": "subtitle", "time": 9180.23, "timestamp": "02:33:00", "text": "好的。"}, {"type": "subtitle", "time": 9182.55, "timestamp": "02:33:02", "text": "然后，另一只手，你，"}, {"type": "subtitle", "time": 9185.59, "timestamp": "02:33:05", "text": "可以放任何东西，但通常是"}, {"type": "subtitle", "time": 9187.11, "timestamp": "02:33:07", "text": "就像在你的……上装个盾牌一样好。"}, {"type": "subtitle", "time": 9188.23, "timestamp": "02:33:08", "text": "手。另一个。"}, {"type": "subtitle", "time": 9189.91, "timestamp": "02:33:09", "text": "呃，第二个，对吧？"}, {"type": "subtitle", "time": 9191.429, "timestamp": "02:33:11", "text": "呃，不是那个。它就像下一个"}, {"type": "subtitle", "time": 9193.91, "timestamp": "02:33:13", "text": "就在德鲁伊专注旁边。"}, {"type": "subtitle", "time": 9195.59, "timestamp": "02:33:15", "text": "哦，"}, {"type": "subtitle", "time": 9196.79, "timestamp": "02:33:16", "text": "是的。好了。"}, {"type": "subtitle", "time": 9198.87, "timestamp": "02:33:18", "text": "所以，这只是意味着"}, {"type": "subtitle", "time": 9200.63, "timestamp": "02:33:20", "text": "你正专注于你的主要"}, {"type": "subtitle", "time": 9204.87, "timestamp": "02:33:24", "text": "一只手拿着盾牌，另一只手拿着盾牌。"}, {"type": "subtitle", "time": 9210.469, "timestamp": "02:33:30", "text": "好的。好的。嗯，让我想想。嗯"}, {"type": "subtitle", "time": 9213.99, "timestamp": "02:33:33", "text": "是的，我想那就是……手部姿势。"}, {"type": "subtitle", "time": 9216.71, "timestamp": "02:33:36", "text": "我需要穿这些衣服吗？呃，你"}, {"type": "subtitle", "time": 9217.99, "timestamp": "02:33:37", "text": "你已经穿着它了。如果你看到"}, {"type": "subtitle", "time": 9219.429, "timestamp": "02:33:39", "text": "那边有个盾牌图标。"}, {"type": "subtitle", "time": 9222.07, "timestamp": "02:33:42", "text": "这意味着你已经具备了那种能力。"}, {"type": "subtitle", "time": 9225.75, "timestamp": "02:33:45", "text": "在物品旁边。是的。"}, {"type": "subtitle", "time": 9226.389, "timestamp": "02:33:46", "text": "好的。好的。"}, {"type": "subtitle", "time": 9231.91, "timestamp": "02:33:51", "text": "成套工具。"}, {"type": "subtitle", "time": 9234.15, "timestamp": "02:33:54", "text": "我已经从哪里获得战利品了？"}, {"type": "subtitle", "time": 9235.349, "timestamp": "02:33:55", "text": "嗯，是的。是的。那是你的。"}, {"type": "subtitle", "time": 9238.07, "timestamp": "02:33:58", "text": "背景。那是你的背景。"}, {"type": "subtitle", "time": 9239.27, "timestamp": "02:33:59", "text": "哦好的。好的。"}]
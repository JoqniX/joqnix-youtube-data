[{"type": "subtitle", "time": 616.79, "timestamp": "00:10:16", "text": "好的。搞砸了。"}, {"type": "subtitle", "time": 620.23, "timestamp": "00:10:20", "text": "是的，你搞砸了。"}, {"type": "subtitle", "time": 622.79, "timestamp": "00:10:22", "text": "是的，我觉得你犯了很多错误。"}, {"type": "subtitle", "time": 626.15, "timestamp": "00:10:26", "text": "在和当地向导一起做这件事的时候，我"}, {"type": "subtitle", "time": 627.829, "timestamp": "00:10:27", "text": "提供给你的。"}, {"type": "subtitle", "time": 630.55, "timestamp": "00:10:30", "text": "我知道。我正在听下一首。"}, {"type": "subtitle", "time": 631.43, "timestamp": "00:10:31", "text": "这"}, {"type": "subtitle", "time": 632.87, "timestamp": "00:10:32", "text": "下一个"}, {"type": "subtitle", "time": 635.99, "timestamp": "00:10:35", "text": "我的天啊。"}, {"type": "subtitle", "time": 638.389, "timestamp": "00:10:38", "text": "那是一个男女声的混合声音。"}, {"type": "subtitle", "time": 641.829, "timestamp": "00:10:41", "text": "哦，是的。好的。我的天哪。因此"}, {"type": "subtitle", "time": 644.71, "timestamp": "00:10:44", "text": "因为你在唱歌，所以音调低了一个音。"}, {"type": "subtitle", "time": 648.069, "timestamp": "00:10:48", "text": "先记一个音符，然后是你通常的做法"}, {"type": "subtitle", "time": 650.23, "timestamp": "00:10:50", "text": "基本上就是语音。"}, {"type": "subtitle", "time": 652.949, "timestamp": "00:10:52", "text": "啊，这太难了。"}, {"type": "subtitle", "time": 656.31, "timestamp": "00:10:56", "text": "是的。我知道。"}, {"type": "subtitle", "time": 658.949, "timestamp": "00:10:58", "text": "所以我才说要把它当作……来用。"}]
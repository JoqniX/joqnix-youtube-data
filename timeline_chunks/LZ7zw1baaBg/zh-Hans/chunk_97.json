[{"type": "subtitle", "time": 5822.31, "timestamp": "01:37:02", "text": "你可以像平常一样使用弓箭。"}, {"type": "subtitle", "time": 5824.39, "timestamp": "01:37:04", "text": "两者皆可。魔术师只会给你"}, {"type": "subtitle", "time": 5827.189, "timestamp": "01:37:07", "text": "就像额外施放一个戏法，但你不会。"}, {"type": "subtitle", "time": 5829.35, "timestamp": "01:37:09", "text": "真的有一个罐头可以增强你的"}, {"type": "subtitle", "time": 5831.99, "timestamp": "01:37:11", "text": "弓。很遗憾，"}, {"type": "subtitle", "time": 5833.35, "timestamp": "01:37:13", "text": "如果你有类似“真”这样的事情"}, {"type": "subtitle", "time": 5835.75, "timestamp": "01:37:15", "text": "罢工，如果你选择的话会很有用。"}, {"type": "subtitle", "time": 5837.189, "timestamp": "01:37:17", "text": "魔术师，但你其实并没有"}, {"type": "subtitle", "time": 5840.55, "timestamp": "01:37:20", "text": "那。所以，嗯，嗯，魔术师不"}, {"type": "subtitle", "time": 5843.109, "timestamp": "01:37:23", "text": "真正喜欢魔术师，如果你不是的话，那就不是真的。"}, {"type": "subtitle", "time": 5845.35, "timestamp": "01:37:25", "text": "想用它其实并不能真正增强两者。"}, {"type": "subtitle", "time": 5847.27, "timestamp": "01:37:27", "text": "具体来说。它只是让你知道……"}, {"type": "subtitle", "time": 5854.87, "timestamp": "01:37:34", "text": "我觉得如果我"}, {"type": "subtitle", "time": 5858.229, "timestamp": "01:37:38", "text": "感觉魔术师更像是伤害"}, {"type": "subtitle", "time": 5859.91, "timestamp": "01:37:39", "text": "是打字机，对吧？典狱长不一样。"}, {"type": "subtitle", "time": 5862.55, "timestamp": "01:37:42", "text": "呃，其实不是。他们不像"}, {"type": "subtitle", "time": 5864.79, "timestamp": "01:37:44", "text": "严格来说，典狱长是更多的"}, {"type": "subtitle", "time": 5866.709, "timestamp": "01:37:46", "text": "造成损害。魔术师更像是一个"}, {"type": "subtitle", "time": 5868.47, "timestamp": "01:37:48", "text": "实用性一，因为你得到了你得到"}, {"type": "subtitle", "time": 5870.709, "timestamp": "01:37:50", "text": "另一个戏法"}, {"type": "subtitle", "time": 5872.87, "timestamp": "01:37:52", "text": "除非你想选别的。"}, {"type": "subtitle", "time": 5874.39, "timestamp": "01:37:54", "text": "具有破坏性的戏法，但你已经有一个"}, {"type": "subtitle", "time": 5876.629, "timestamp": "01:37:56", "text": "具有破坏性的咒语，呃，就是产生"}, {"type": "subtitle", "time": 5878.55, "timestamp": "01:37:58", "text": "火焰。如果你还想要一个，请随意。"}]
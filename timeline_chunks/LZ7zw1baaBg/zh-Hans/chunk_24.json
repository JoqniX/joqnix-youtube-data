[{"type": "subtitle", "time": 1440.23, "timestamp": "00:24:00", "text": "然后它应该就在那里等着你了。"}, {"type": "subtitle", "time": 1442.31, "timestamp": "00:24:02", "text": "好的。我点击了它。"}, {"type": "subtitle", "time": 1443.669, "timestamp": "00:24:03", "text": "是的。好的。"}, {"type": "subtitle", "time": 1445.59, "timestamp": "00:24:05", "text": "这是你的角色卡。我是"}, {"type": "subtitle", "time": 1447.83, "timestamp": "00:24:07", "text": "嗯，好吧，首先，嗯"}, {"type": "subtitle", "time": 1450.549, "timestamp": "00:24:10", "text": "我想问的是，你有没有任何类型的……"}, {"type": "subtitle", "time": 1452.47, "timestamp": "00:24:12", "text": "脑海中浮现出你想要的那种角色形象"}, {"type": "subtitle", "time": 1453.669, "timestamp": "00:24:13", "text": "玩？"}, {"type": "subtitle", "time": 1455.59, "timestamp": "00:24:15", "text": "我不知道。"}, {"type": "subtitle", "time": 1458.23, "timestamp": "00:24:18", "text": "等等，都有哪些角色？"}, {"type": "subtitle", "time": 1459.83, "timestamp": "00:24:19", "text": "嗯，这真的取决于你。就像你一样"}, {"type": "subtitle", "time": 1461.75, "timestamp": "00:24:21", "text": "真的可以建造任何类型的"}, {"type": "subtitle", "time": 1463.59, "timestamp": "00:24:23", "text": "你想要的角色，因为就像最后那样"}, {"type": "subtitle", "time": 1466.23, "timestamp": "00:24:26", "text": "是一款相当自由的角色扮演游戏。所以"}, {"type": "subtitle", "time": 1468.47, "timestamp": "00:24:28", "text": "你可以建造任何东西。就是我"}, {"type": "subtitle", "time": 1471.43, "timestamp": "00:24:31", "text": "想想你喜欢什么"}, {"type": "subtitle", "time": 1475.51, "timestamp": "00:24:35", "text": "主要是什么级别和什么物种"}, {"type": "subtitle", "time": 1477.909, "timestamp": "00:24:37", "text": "你想成为或喜欢某个种族物种。"}, {"type": "subtitle", "time": 1479.59, "timestamp": "00:24:39", "text": "他们以前称之为种族，但现在他们"}, {"type": "subtitle", "time": 1482.47, "timestamp": "00:24:42", "text": "称之为物种。"}, {"type": "subtitle", "time": 1483.99, "timestamp": "00:24:43", "text": "等等，这里都有哪些物种？"}, {"type": "subtitle", "time": 1485.669, "timestamp": "00:24:45", "text": "哦，我可以点击这个。好的。"}, {"type": "subtitle", "time": 1487.269, "timestamp": "00:24:47", "text": "是的，可以。哦，千万别点！"}, {"type": "subtitle", "time": 1489.51, "timestamp": "00:24:49", "text": "不过，因为我需要这样做"}, {"type": "subtitle", "time": 1492.71, "timestamp": "00:24:52", "text": "先把你的能力值填进去。只是"}, {"type": "subtitle", "time": 1495.029, "timestamp": "00:24:55", "text": "想想你想要什么"}, {"type": "subtitle", "time": 1497.35, "timestamp": "00:24:57", "text": "先出场。你有什么想法吗？如果"}, {"type": "subtitle", "time": 1498.87, "timestamp": "00:24:58", "text": "如果你不知道的话，你也可以点赞。"}]
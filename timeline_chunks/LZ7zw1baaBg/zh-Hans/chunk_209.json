[{"type": "subtitle", "time": 12553.83, "timestamp": "03:29:13", "text": "我的天啊。"}, {"type": "subtitle", "time": 12568.15, "timestamp": "03:29:28", "text": "所以，是的，我也开始联系……"}, {"type": "subtitle", "time": 12571.11, "timestamp": "03:29:31", "text": "我觉得有些人这样做很糟糕。"}, {"type": "subtitle", "time": 12575.59, "timestamp": "03:29:35", "text": "我不该没有……"}, {"type": "subtitle", "time": 12579.03, "timestamp": "03:29:39", "text": "与我曾经合作过的人保持联系"}, {"type": "subtitle", "time": 12581.75, "timestamp": "03:29:41", "text": "与 sujokatan 等团体进行大规模合作"}, {"type": "subtitle", "time": 12583.67, "timestamp": "03:29:43", "text": "合作对象我还没怎么聊过。"}, {"type": "subtitle", "time": 12586.469, "timestamp": "03:29:46", "text": "那些和我有点像的人"}, {"type": "subtitle", "time": 12589.429, "timestamp": "03:29:49", "text": "把他们带回来，让他们复活了。"}, {"type": "subtitle", "time": 12591.67, "timestamp": "03:29:51", "text": "从某种意义上说，我认为我做到了。"}, {"type": "subtitle", "time": 12594.07, "timestamp": "03:29:54", "text": "不知道，不过有几个人，所以我"}, {"type": "subtitle", "time": 12596.79, "timestamp": "03:29:56", "text": "本来想做一些……呃……的事情"}, {"type": "subtitle", "time": 12599.99, "timestamp": "03:29:59", "text": "在接下来的几个月里，他们将会……而不是"}]
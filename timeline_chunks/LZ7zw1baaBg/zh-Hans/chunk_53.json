[{"type": "subtitle", "time": 3188.63, "timestamp": "00:53:08", "text": "这里有人。"}, {"type": "subtitle", "time": 3200.79, "timestamp": "00:53:20", "text": "啊，"}, {"type": "subtitle", "time": 3203.67, "timestamp": "00:53:23", "text": "但是，呃，那是不是像墙面装饰一样？"}, {"type": "subtitle", "time": 3206.069, "timestamp": "00:53:26", "text": "东西？"}, {"type": "subtitle", "time": 3209.67, "timestamp": "00:53:29", "text": "理论上来说，是的。但它很像……"}, {"type": "subtitle", "time": 3212.15, "timestamp": "00:53:32", "text": "比较随意，就像我让大家自由玩耍一样。"}, {"type": "subtitle", "time": 3214.71, "timestamp": "00:53:34", "text": "无论他们喜欢哪种类型的角色"}, {"type": "subtitle", "time": 3232.23, "timestamp": "00:53:52", "text": "我还买到了这个精灵。我的天哪。哦，是的。"}, {"type": "subtitle", "time": 3233.99, "timestamp": "00:53:53", "text": "你选择了什么？你的是什么？"}, {"type": "subtitle", "time": 3235.27, "timestamp": "00:53:55", "text": "物种？"}, {"type": "subtitle", "time": 3237.109, "timestamp": "00:53:57", "text": "哦，我没有，我没有，我没有，我没有一个"}, {"type": "subtitle", "time": 3239.03, "timestamp": "00:53:59", "text": "因为我是游戏主持人，所以我就像……"}]
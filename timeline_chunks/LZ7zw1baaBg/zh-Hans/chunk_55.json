[{"type": "subtitle", "time": 3300.71, "timestamp": "00:55:00", "text": "跳过。嗯，但是，嗯，关于……"}, {"type": "subtitle", "time": 3303.19, "timestamp": "00:55:03", "text": "当我进行攻击之类的操作时，它会这样吗？"}, {"type": "subtitle", "time": 3305.99, "timestamp": "00:55:05", "text": "屏幕上会显示我受到的伤害程度。"}, {"type": "subtitle", "time": 3307.27, "timestamp": "00:55:07", "text": "拿走了，或者我必须"}, {"type": "subtitle", "time": 3308.309, "timestamp": "00:55:08", "text": "是的。是的。"}, {"type": "subtitle", "time": 3309.91, "timestamp": "00:55:09", "text": "算上。"}, {"type": "subtitle", "time": 3313.589, "timestamp": "00:55:13", "text": "呃，它会自动计算。"}, {"type": "subtitle", "time": 3315.51, "timestamp": "00:55:15", "text": "哦，那真不错。"}, {"type": "subtitle", "time": 3330.95, "timestamp": "00:55:30", "text": "塔莎的规则是什么？"}, {"type": "subtitle", "time": 3334.95, "timestamp": "00:55:34", "text": "哦，那是华盛顿特区。那是其中之一"}, {"type": "subtitle", "time": 3336.23, "timestamp": "00:55:36", "text": "图书。"}, {"type": "subtitle", "time": 3338.23, "timestamp": "00:55:38", "text": "哦好的。"}, {"type": "subtitle", "time": 3345.119, "timestamp": "00:55:45", "text": "好的。 好的。等待。嗯，"}, {"type": "subtitle", "time": 3348.16, "timestamp": "00:55:48", "text": "好的。等待。嗯， 有没有"}, {"type": "subtitle", "time": 3350.559, "timestamp": "00:55:50", "text": "有没有 是否有"}, {"type": "subtitle", "time": 3354.16, "timestamp": "00:55:54", "text": "是否有 这个？这是什么人形生物？"}, {"type": "subtitle", "time": 3359.01, "timestamp": "00:55:59", "text": "这个？这是什么人形生物？ [音乐]"}]
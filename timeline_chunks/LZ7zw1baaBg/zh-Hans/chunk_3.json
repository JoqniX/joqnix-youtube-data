[{"type": "subtitle", "time": 182.39, "timestamp": "00:03:02", "text": "歌曲。好的。关于那首歌。嗯，你……"}, {"type": "subtitle", "time": 185.11, "timestamp": "00:03:05", "text": "已经开始练习了"}, {"type": "subtitle", "time": 190.71, "timestamp": "00:03:10", "text": "第一的？第一个，第一个，呃，第一个，呃，等等"}, {"type": "subtitle", "time": 193.03, "timestamp": "00:03:13", "text": "一二三。是的。直到合唱部分"}, {"type": "subtitle", "time": 196.79, "timestamp": "00:03:16", "text": "第一部分我尝试做了"}, {"type": "subtitle", "time": 199.11, "timestamp": "00:03:19", "text": "昨天"}, {"type": "subtitle", "time": 201.75, "timestamp": "00:03:21", "text": "是的，这很难。"}, {"type": "subtitle", "time": 204.309, "timestamp": "00:03:24", "text": "我唯一的建议是……"}, {"type": "subtitle", "time": 206.47, "timestamp": "00:03:26", "text": "建议你先从原声乐器入手。"}, {"type": "subtitle", "time": 209.67000000000002, "timestamp": "00:03:29", "text": "类似这种类型的歌曲"}, {"type": "subtitle", "time": 211.91, "timestamp": "00:03:31", "text": "真的需要那种情感上的"}, {"type": "subtitle", "time": 214.71, "timestamp": "00:03:34", "text": "你知道，你知道情绪控制"}, {"type": "subtitle", "time": 216.949, "timestamp": "00:03:36", "text": "这是你的声音，这样你才能……"}, {"type": "subtitle", "time": 219.11, "timestamp": "00:03:39", "text": "歌曲某些部分令人动容"}, {"type": "subtitle", "time": 221.67000000000002, "timestamp": "00:03:41", "text": "基本上是M"}, {"type": "subtitle", "time": 225.11, "timestamp": "00:03:45", "text": "是啊，我当时简直恨透了自己的生活。就是那个"}, {"type": "subtitle", "time": 225.67000000000002, "timestamp": "00:03:45", "text": "正确的。"}, {"type": "subtitle", "time": 228.22899999999998, "timestamp": "00:03:48", "text": "是的。是的。我厌恶我的生活。那是一个"}, {"type": "subtitle", "time": 232.55, "timestamp": "00:03:52", "text": "对我来说，学会那样的生活简直是一种折磨。我 我"}, {"type": "subtitle", "time": 235.50900000000001, "timestamp": "00:03:55", "text": "后悔当时学到了这件事。但是就像"}, {"type": "subtitle", "time": 237.589, "timestamp": "00:03:57", "text": "但我有点明白，而且我从来没有"}]
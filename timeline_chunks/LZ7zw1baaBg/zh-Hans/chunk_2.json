[{"type": "subtitle", "time": 121.51, "timestamp": "00:02:01", "text": "是的，我做了。我做了。"}, {"type": "subtitle", "time": 123.51, "timestamp": "00:02:03", "text": "好的。好的。那你为什么还要听？"}, {"type": "subtitle", "time": 125.51, "timestamp": "00:02:05", "text": "YouTube音乐？那是我当时的一件事。"}, {"type": "subtitle", "time": 128.22899999999998, "timestamp": "00:02:08", "text": "就像在思考。"}, {"type": "subtitle", "time": 131.11, "timestamp": "00:02:11", "text": "哦，它在我启动时运行。"}, {"type": "subtitle", "time": 134.949, "timestamp": "00:02:14", "text": "启动电脑。"}, {"type": "subtitle", "time": 140.07, "timestamp": "00:02:20", "text": "哦好的。稍等片刻。我可以"}, {"type": "subtitle", "time": 160.55, "timestamp": "00:02:40", "text": "正是如此。"}, {"type": "subtitle", "time": 162.15, "timestamp": "00:02:42", "text": "是的。好了，我回来了。"}, {"type": "subtitle", "time": 164.39, "timestamp": "00:02:44", "text": "您好，欢迎回来。"}, {"type": "subtitle", "time": 167.50900000000001, "timestamp": "00:02:47", "text": "是的。是的。我先从练习开始。"}, {"type": "subtitle", "time": 168.63, "timestamp": "00:02:48", "text": "迅速地。"}, {"type": "subtitle", "time": 169.19, "timestamp": "00:02:49", "text": "你好。"}, {"type": "subtitle", "time": 172.22899999999998, "timestamp": "00:02:52", "text": "好的。哦，是的。再过一秒钟左右"}, {"type": "subtitle", "time": 175.11, "timestamp": "00:02:55", "text": "你发给我的那首歌。那个呃"}, {"type": "subtitle", "time": 178.47, "timestamp": "00:02:58", "text": "制作人：加木由里"}]
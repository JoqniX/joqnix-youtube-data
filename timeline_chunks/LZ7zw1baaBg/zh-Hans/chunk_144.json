[{"type": "subtitle", "time": 8640.71, "timestamp": "02:24:00", "text": "模拟器以及其他很多东西。"}, {"type": "subtitle", "time": 8641.27, "timestamp": "02:24:01", "text": "哦，"}, {"type": "subtitle", "time": 8642.87, "timestamp": "02:24:02", "text": "只要有桌子，你就可以玩。"}, {"type": "subtitle", "time": 8651.67, "timestamp": "02:24:11", "text": "好的。"}, {"type": "subtitle", "time": 8656.95, "timestamp": "02:24:16", "text": "完毕。我们已经帮你搞定了。好的。所以，"}, {"type": "subtitle", "time": 8659.19, "timestamp": "02:24:19", "text": "嗯"}, {"type": "subtitle", "time": 8661.03, "timestamp": "02:24:21", "text": "在我们继续之前，我需要喜欢"}, {"type": "subtitle", "time": 8662.71, "timestamp": "02:24:22", "text": "把你分配到其中一个小组。你是"}, {"type": "subtitle", "time": 8664.95, "timestamp": "02:24:24", "text": "你打算玩吗？"}, {"type": "subtitle", "time": 8666.63, "timestamp": "02:24:26", "text": "星期六还是星期日？比如哪个团体"}, {"type": "subtitle", "time": 8670.55, "timestamp": "02:24:30", "text": "你想加入吗？我今天有空"}, {"type": "subtitle", "time": 8673.75, "timestamp": "02:24:33", "text": "周六。我周六可以。"}, {"type": "subtitle", "time": 8676.63, "timestamp": "02:24:36", "text": "谁，所有在那里的人"}, {"type": "subtitle", "time": 8677.99, "timestamp": "02:24:37", "text": "周六？"}, {"type": "subtitle", "time": 8679.67, "timestamp": "02:24:39", "text": "哦好的。呃，你可以查看群组信息。"}, {"type": "subtitle", "time": 8681.27, "timestamp": "02:24:41", "text": "但就像现在这样，我实际上……"}, {"type": "subtitle", "time": 8682.87, "timestamp": "02:24:42", "text": "突然意识到我也忘了点赞添加"}, {"type": "subtitle", "time": 8685.429, "timestamp": "02:24:45", "text": "群组里的名字。是的，"}, {"type": "subtitle", "time": 8689.11, "timestamp": "02:24:49", "text": "目前周六只有嗯"}, {"type": "subtitle", "time": 8691.67, "timestamp": "02:24:51", "text": "呃，鲁迪乌斯、蜥蜴和骑士。进而"}, {"type": "subtitle", "time": 8693.91, "timestamp": "02:24:53", "text": "星期天有 Ario、Willow 和 Knight。"}, {"type": "subtitle", "time": 8696.15, "timestamp": "02:24:56", "text": "苏米和蕾妮。"}, {"type": "subtitle", "time": 8699.03, "timestamp": "02:24:59", "text": "哇。周日大家都很忙。是啊，相当"}]
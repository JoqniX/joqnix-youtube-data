[{"type": "subtitle", "time": 8701.349, "timestamp": "02:25:01", "text": "很多。我想人们就是人们"}, {"type": "subtitle", "time": 8704.55, "timestamp": "02:25:04", "text": "周日将有更多供应。"}, {"type": "subtitle", "time": 8705.429, "timestamp": "02:25:05", "text": "是的。"}, {"type": "subtitle", "time": 8708.07, "timestamp": "02:25:08", "text": "周六的比赛中会有新球员吗？"}, {"type": "subtitle", "time": 8709.59, "timestamp": "02:25:09", "text": "团体？"}, {"type": "subtitle", "time": 8713.429, "timestamp": "02:25:13", "text": "呃，目前还没有。"}, {"type": "subtitle", "time": 8717.59, "timestamp": "02:25:17", "text": "哦，如果我加入，会不会拖累他们？"}, {"type": "subtitle", "time": 8719.51, "timestamp": "02:25:19", "text": "周六？"}, {"type": "subtitle", "time": 8721.59, "timestamp": "02:25:21", "text": "我不这么认为。"}, {"type": "subtitle", "time": 8725.429, "timestamp": "02:25:25", "text": "呃，其实不是。不，没事了。不，"}, {"type": "subtitle", "time": 8726.95, "timestamp": "02:25:26", "text": "Rudy 真的是个新人。鲁迪是新来的。哦，"}, {"type": "subtitle", "time": 8729.91, "timestamp": "02:25:29", "text": "是的。没关系。鲁迪是新来的。"}, {"type": "subtitle", "time": 8732.469, "timestamp": "02:25:32", "text": "哦好的。周六的小组，新的"}, {"type": "subtitle", "time": 8734.95, "timestamp": "02:25:34", "text": "人们。好的。"}, {"type": "subtitle", "time": 8736.95, "timestamp": "02:25:36", "text": "好的。好的。所以，你想成为"}, {"type": "subtitle", "time": 8738.23, "timestamp": "02:25:38", "text": "周六？"}, {"type": "subtitle", "time": 8740.55, "timestamp": "02:25:40", "text": "好的，我周六可以。是的。"}, {"type": "subtitle", "time": 8741.91, "timestamp": "02:25:41", "text": "好吧。我会把你添加到"}, {"type": "subtitle", "time": 8743.91, "timestamp": "02:25:43", "text": "周六小组。嗯，"}, {"type": "subtitle", "time": 8744.389, "timestamp": "02:25:44", "text": "什么时候？"}, {"type": "subtitle", "time": 8747.91, "timestamp": "02:25:47", "text": "让我来告诉你。嗯，和今天一样。"}, {"type": "subtitle", "time": 8749.429, "timestamp": "02:25:49", "text": "是啊。"}, {"type": "subtitle", "time": 8759.75, "timestamp": "02:25:59", "text": "哦，已经有治疗师了。"}]
[{"type": "subtitle", "time": 1741.43, "timestamp": "00:29:01", "text": "哦。"}, {"type": "subtitle", "time": 1743.669, "timestamp": "00:29:03", "text": "哦，这就像完全不同的两个世界。"}, {"type": "subtitle", "time": 1745.51, "timestamp": "00:29:05", "text": "团队。好的。所以，就是这样。"}, {"type": "subtitle", "time": 1746.31, "timestamp": "00:29:06", "text": "是的。是的。"}, {"type": "subtitle", "time": 1747.669, "timestamp": "00:29:07", "text": "好的。好的。"}, {"type": "subtitle", "time": 1748.789, "timestamp": "00:29:08", "text": "目前有两支队伍，因为"}, {"type": "subtitle", "time": 1751.75, "timestamp": "00:29:11", "text": "玩家数量相当多。所以，我……"}, {"type": "subtitle", "time": 1756.56, "timestamp": "00:29:16", "text": "我把它分成了两组。我"}, {"type": "subtitle", "time": 1760.23, "timestamp": "00:29:20", "text": "[音乐]"}, {"type": "subtitle", "time": 1763.669, "timestamp": "00:29:23", "text": "布雷死。哦，巫师。你呼吸着死去"}, {"type": "subtitle", "time": 1765.909, "timestamp": "00:29:25", "text": "有些时候，当有人自主呼吸时，"}, {"type": "subtitle", "time": 1768.149, "timestamp": "00:29:28", "text": "正确的？是的。是的。是的。因为你你"}, {"type": "subtitle", "time": 1771.269, "timestamp": "00:29:31", "text": "生命值上限很低。"}, {"type": "subtitle", "time": 1772.149, "timestamp": "00:29:32", "text": "呃"}, {"type": "subtitle", "time": 1776.149, "timestamp": "00:29:36", "text": "你的生命值非常低。"}, {"type": "subtitle", "time": 1779.909, "timestamp": "00:29:39", "text": "好的。被困住了。好的。流氓是捕兽者。"}, {"type": "subtitle", "time": 1783.269, "timestamp": "00:29:43", "text": "好的。这是个陷阱。好的。范围是"}, {"type": "subtitle", "time": 1785.75, "timestamp": "00:29:45", "text": "它不像弓箭那样射程很远。"}, {"type": "subtitle", "time": 1788.789, "timestamp": "00:29:48", "text": "东西。哦，游侠更像是……更少"}, {"type": "subtitle", "time": 1790.389, "timestamp": "00:29:50", "text": "一把弓箭，比这更……"}, {"type": "subtitle", "time": 1792.23, "timestamp": "00:29:52", "text": "战斗机。护林员更像是公园管理员。"}, {"type": "subtitle", "time": 1795.83, "timestamp": "00:29:55", "text": "你知道，就是那种护林员，比如生存专家。"}]
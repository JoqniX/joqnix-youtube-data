[{"type": "subtitle", "time": 7020.55, "timestamp": "01:57:00", "text": "处理实用法术。其余部分是……"}, {"type": "subtitle", "time": 7021.51, "timestamp": "01:57:01", "text": "实用工具。"}, {"type": "subtitle", "time": 7023.91, "timestamp": "01:57:03", "text": "好的。那我选择造成伤害。"}, {"type": "subtitle", "time": 7025.43, "timestamp": "01:57:05", "text": "东西。我应该选哪个？"}, {"type": "subtitle", "time": 7029.75, "timestamp": "01:57:09", "text": "好的。嗯，让我想想。"}, {"type": "subtitle", "time": 7031.669, "timestamp": "01:57:11", "text": "用于造成伤害。是的。"}, {"type": "subtitle", "time": 7034.31, "timestamp": "01:57:14", "text": "我必须每次都选择戏法吗？"}, {"type": "subtitle", "time": 7036.229, "timestamp": "01:57:16", "text": "我该升级了吗？"}, {"type": "subtitle", "time": 7038.39, "timestamp": "01:57:18", "text": "呃，不。呃，你只能得到你自己的。"}, {"type": "subtitle", "time": 7040.629, "timestamp": "01:57:20", "text": "如果我没记错的话，升级时获得戏法。"}, {"type": "subtitle", "time": 7044.31, "timestamp": "01:57:24", "text": "就像四，然后是你的下一个罐头"}, {"type": "subtitle", "time": 7047.91, "timestamp": "01:57:27", "text": "目前等级为10级。所以，不算多。"}, {"type": "subtitle", "time": 7050.31, "timestamp": "01:57:30", "text": "哦好的。"}, {"type": "subtitle", "time": 7054.87, "timestamp": "01:57:34", "text": "好的。纯粹的伤害，也就是枪的伤害。"}, {"type": "subtitle", "time": 7063.83, "timestamp": "01:57:43", "text": "如果你想要纯粹的伤害，比如"}, {"type": "subtitle", "time": 7065.27, "timestamp": "01:57:45", "text": "技术上来说，技术是指像"}, {"type": "subtitle", "time": 7067.35, "timestamp": "01:57:47", "text": "最大的骰子将是毒喷雾"}, {"type": "subtitle", "time": 7069.51, "timestamp": "01:57:49", "text": "但是毒素伤害相当高。"}, {"type": "subtitle", "time": 7072.47, "timestamp": "01:57:52", "text": "经常遭到抵制。所以就像"}, {"type": "subtitle", "time": 7073.99, "timestamp": "01:57:53", "text": "有敌人，他们是"}, {"type": "subtitle", "time": 7077.109, "timestamp": "01:57:57", "text": "对此没有抵抗力。嗯"}]
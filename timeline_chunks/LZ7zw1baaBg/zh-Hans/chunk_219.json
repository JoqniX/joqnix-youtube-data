[{"type": "subtitle", "time": 13141.91, "timestamp": "03:39:01", "text": "我们会唱我们兄弟俩的歌"}, {"type": "subtitle", "time": 13145.51, "timestamp": "03:39:05", "text": "和那个儿子。那些东西都会在那里。"}, {"type": "subtitle", "time": 13148.07, "timestamp": "03:39:08", "text": "是的。是的。我会努力变得更好"}, {"type": "subtitle", "time": 13150.389, "timestamp": "03:39:10", "text": "明天开始活动。是的，今晚就是这样。"}, {"type": "subtitle", "time": 13154.469, "timestamp": "03:39:14", "text": "我这就收拾好，准备睡觉。患病的"}, {"type": "subtitle", "time": 13156.63, "timestamp": "03:39:16", "text": "试着睡一会儿。"}, {"type": "subtitle", "time": 13161.67, "timestamp": "03:39:21", "text": "希望我能睡着。嗨，总之"}, {"type": "subtitle", "time": 13163.67, "timestamp": "03:39:23", "text": "外面在下雨，所以我就……"}, {"type": "subtitle", "time": 13165.75, "timestamp": "03:39:25", "text": "拿着我的伞下楼去"}, {"type": "subtitle", "time": 13169.349, "timestamp": "03:39:29", "text": "比如进屋吃晚饭"}, {"type": "subtitle", "time": 13172.469, "timestamp": "03:39:32", "text": "好好休息。总之，大家保重。"}, {"type": "subtitle", "time": 13174.95, "timestamp": "03:39:34", "text": "别忘了喝水，吃东西。"}, {"type": "subtitle", "time": 13176.95, "timestamp": "03:39:36", "text": "睡觉，不管你做什么事"}, {"type": "subtitle", "time": 13179.59, "timestamp": "03:39:39", "text": "事物。我只想说声谢谢"}, {"type": "chat", "time": 13180.104, "timestamp": "03:39:40", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "good night jog"}, {"type": "subtitle", "time": 13183.269, "timestamp": "03:39:43", "text": "感谢你今天尽力而为。"}, {"type": "subtitle", "time": 13186.229, "timestamp": "03:39:46", "text": "感谢你的辛勤付出。晚安"}, {"type": "subtitle", "time": 13189.51, "timestamp": "03:39:49", "text": "各位再见。"}, {"type": "subtitle", "time": 13193.269, "timestamp": "03:39:53", "text": "晚安。现在 Twitch 和 kick 功能"}, {"type": "subtitle", "time": 13194.55, "timestamp": "03:39:54", "text": "在 Twitch 上观看直播的人们"}, {"type": "subtitle", "time": 13197.75, "timestamp": "03:39:57", "text": "踢球或者想在那里观看。水"}]
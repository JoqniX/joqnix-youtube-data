[{"type": "subtitle", "time": 1681.11, "timestamp": "00:28:01", "text": "哦好的。是的。我的意思是，如果你是"}, {"type": "subtitle", "time": 1682.47, "timestamp": "00:28:02", "text": "我不太熟悉，但我还是推荐一下。"}, {"type": "subtitle", "time": 1683.99, "timestamp": "00:28:03", "text": "像……一样远离家乡"}, {"type": "subtitle", "time": 1685.75, "timestamp": "00:28:05", "text": "自制职业，例如血猎和"}, {"type": "subtitle", "time": 1688.789, "timestamp": "00:28:08", "text": "低于这个水平。尽量远离那个地方"}, {"type": "subtitle", "time": 1692.32, "timestamp": "00:28:12", "text": "你根本不知道自己在做什么。"}, {"type": "subtitle", "time": 1695.269, "timestamp": "00:28:15", "text": "[音乐]"}, {"type": "subtitle", "time": 1700.23, "timestamp": "00:28:20", "text": "哇，好多课啊。这是刀。"}, {"type": "subtitle", "time": 1702.63, "timestamp": "00:28:22", "text": "呃，有玩家也一样吗？"}, {"type": "subtitle", "time": 1705.19, "timestamp": "00:28:25", "text": "班级？比如说"}, {"type": "subtitle", "time": 1707.029, "timestamp": "00:28:27", "text": "哦，是的。嗯，这取决于具体情况。"}, {"type": "chat", "time": 1707.528, "timestamp": "00:28:27", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "hi thorn-san 👋 hope your health is doing well 👍"}, {"type": "subtitle", "time": 1709.11, "timestamp": "00:28:29", "text": "你加入的群组，但别太担心。"}, {"type": "subtitle", "time": 1710.63, "timestamp": "00:28:30", "text": "很多关于团队构成方面的内容。它不"}, {"type": "subtitle", "time": 1712.63, "timestamp": "00:28:32", "text": "我真的很喜欢，我觉得不会发生"}, {"type": "subtitle", "time": 1715.43, "timestamp": "00:28:35", "text": "会造成太大的问题。但是如果你"}, {"type": "subtitle", "time": 1718.389, "timestamp": "00:28:38", "text": "想知道这是什么意思，哦，"}, {"type": "subtitle", "time": 1720.549, "timestamp": "00:28:40", "text": "是的。稍后我还要让你……"}, {"type": "subtitle", "time": 1722.549, "timestamp": "00:28:42", "text": "告诉你选择你想参加哪个党派。"}, {"type": "subtitle", "time": 1727.269, "timestamp": "00:28:47", "text": "因为我们周六的队伍有……我们"}, {"type": "subtitle", "time": 1729.909, "timestamp": "00:28:49", "text": "我招募了一个圣骑士、一个牧师和一个盗贼。"}, {"type": "subtitle", "time": 1731.909, "timestamp": "00:28:51", "text": "然后，在周日的比赛中，我们得到了……"}, {"type": "subtitle", "time": 1736.549, "timestamp": "00:28:56", "text": "牧师、法师、战士、术士"}, {"type": "subtitle", "time": 1738.789, "timestamp": "00:28:58", "text": "以及一个野蛮人。"}]
[{"type": "subtitle", "time": 9781.19, "timestamp": "02:43:01", "text": "穿过它。嗯，如果你双击的话……"}, {"type": "subtitle", "time": 9784.95, "timestamp": "02:43:04", "text": "用你的令牌打开你的角色卡。"}, {"type": "subtitle", "time": 9787.349, "timestamp": "02:43:07", "text": "所以当我告诉你要具备这种能力时，我告诉你，要有能力"}, {"type": "subtitle", "time": 9789.51, "timestamp": "02:43:09", "text": "检查，你去那个地方"}, {"type": "subtitle", "time": 9792.87, "timestamp": "02:43:12", "text": "第一个标签页，齿轮图标。"}, {"type": "subtitle", "time": 9796.309, "timestamp": "02:43:16", "text": "然后你点击我选择的技能。"}, {"type": "subtitle", "time": 9798.07, "timestamp": "02:43:18", "text": "呃，这么说。假设我想让你制作"}, {"type": "subtitle", "time": 9799.91, "timestamp": "02:43:19", "text": "奥术检定。你点击了奥术。它"}, {"type": "subtitle", "time": 9803.91, "timestamp": "02:43:23", "text": "应该直接弹出一个用户界面。而且大部分"}, {"type": "subtitle", "time": 9812.55, "timestamp": "02:43:32", "text": "是的，你可以点赞。而且它会……"}, {"type": "subtitle", "time": 9815.59, "timestamp": "02:43:35", "text": "它会滚动什么东西。我的天哪。"}, {"type": "subtitle", "time": 9820.07, "timestamp": "02:43:40", "text": "还没到20岁呢。嗯，是的。"}, {"type": "subtitle", "time": 9821.75, "timestamp": "02:43:41", "text": "这就是你如何获得能力的方法"}, {"type": "subtitle", "time": 9825.59, "timestamp": "02:43:45", "text": "检查。然后旁边就是呃，旁边"}, {"type": "subtitle", "time": 9827.03, "timestamp": "02:43:47", "text": "就像有豁免检定一样。保存"}, {"type": "subtitle", "time": 9829.59, "timestamp": "02:43:49", "text": "我会投掷，让我告诉你怎么做"}, {"type": "subtitle", "time": 9832.55, "timestamp": "02:43:52", "text": "当你像……嗯……当你……"}, {"type": "subtitle", "time": 9835.83, "timestamp": "02:43:55", "text": "被范围攻击击中。嗯，就像这样……"}, {"type": "subtitle", "time": 9837.83, "timestamp": "02:43:57", "text": "例如，试着去创造一种智慧"}, {"type": "subtitle", "time": 9839.269, "timestamp": "02:43:59", "text": "节省。"}]
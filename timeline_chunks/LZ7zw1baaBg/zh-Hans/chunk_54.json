[{"type": "subtitle", "time": 3241.99, "timestamp": "00:54:01", "text": "游戏的掌控者。呃，但我可以喜欢"}, {"type": "subtitle", "time": 3245.589, "timestamp": "00:54:05", "text": "我可以看懂其他人的内容。"}, {"type": "subtitle", "time": 3248.39, "timestamp": "00:54:08", "text": "所以，我们就像，嗯，让我再确认一下。"}, {"type": "subtitle", "time": 3252.549, "timestamp": "00:54:12", "text": "我们得到了一名人类圣骑士。我们得到了一个人"}, {"type": "subtitle", "time": 3256.549, "timestamp": "00:54:16", "text": "呃，牧师。我们抓到了一个盗版玩家。我们得到了"}, {"type": "subtitle", "time": 3259.589, "timestamp": "00:54:19", "text": "一只乌龟牧师。我们抓到一只小妖精……"}, {"type": "subtitle", "time": 3264.39, "timestamp": "00:54:24", "text": "巫师。一名人类战士。呃，精灵术士"}, {"type": "subtitle", "time": 3267.51, "timestamp": "00:54:27", "text": "安迪野蛮人。"}, {"type": "subtitle", "time": 3273.589, "timestamp": "00:54:33", "text": "该死。"}, {"type": "subtitle", "time": 3275.829, "timestamp": "00:54:35", "text": "太多事情了。好的。"}, {"type": "subtitle", "time": 3277.829, "timestamp": "00:54:37", "text": "是的，确实很多。"}, {"type": "subtitle", "time": 3278.15, "timestamp": "00:54:38", "text": "是的。"}, {"type": "subtitle", "time": 3280.23, "timestamp": "00:54:40", "text": "如果你真的不知道，那就凭感觉吧。"}, {"type": "subtitle", "time": 3282.15, "timestamp": "00:54:42", "text": "随意选择，随便选一个就好"}, {"type": "subtitle", "time": 3284.309, "timestamp": "00:54:44", "text": "其中一个听起来也最酷。也"}, {"type": "subtitle", "time": 3285.91, "timestamp": "00:54:45", "text": "作品。"}, {"type": "subtitle", "time": 3288.309, "timestamp": "00:54:48", "text": "第二个"}, {"type": "subtitle", "time": 3296.87, "timestamp": "00:54:56", "text": "好的。所以，对于每个……嗯，这可能"}]
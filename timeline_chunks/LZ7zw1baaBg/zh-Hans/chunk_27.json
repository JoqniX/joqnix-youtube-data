[{"type": "subtitle", "time": 1622.07, "timestamp": "00:27:02", "text": "玩。巫师和术士是不同的。"}, {"type": "subtitle", "time": 1622.789, "timestamp": "00:27:02", "text": "哦"}, {"type": "subtitle", "time": 1625.99, "timestamp": "00:27:05", "text": "是的，它们确实很不一样。"}, {"type": "subtitle", "time": 1628.31, "timestamp": "00:27:08", "text": "它们真的截然不同。"}, {"type": "subtitle", "time": 1630.39, "timestamp": "00:27:10", "text": "巫师比其他人更加多才多艺。"}, {"type": "subtitle", "time": 1632.789, "timestamp": "00:27:12", "text": "巫师。呃，但它们也很多"}, {"type": "subtitle", "time": 1634.789, "timestamp": "00:27:14", "text": "玩起来更复杂，因为你得到了一个"}, {"type": "subtitle", "time": 1643.269, "timestamp": "00:27:23", "text": "哇。好的。哦，还有血猎者"}, {"type": "subtitle", "time": 1645.269, "timestamp": "00:27:25", "text": "东西。哇。"}, {"type": "subtitle", "time": 1647.669, "timestamp": "00:27:27", "text": "哦，是的。那些就像……呃，如果哦，"}, {"type": "subtitle", "time": 1649.43, "timestamp": "00:27:29", "text": "是的。其实，问个问题。你是"}, {"type": "subtitle", "time": 1652.149, "timestamp": "00:27:32", "text": "你熟悉桌面角色扮演游戏吗？"}, {"type": "subtitle", "time": 1654.39, "timestamp": "00:27:34", "text": "桌面角色扮演游戏？"}, {"type": "subtitle", "time": 1656.149, "timestamp": "00:27:36", "text": "呃，"}, {"type": "subtitle", "time": 1660.23, "timestamp": "00:27:40", "text": "我玩过一次《失落的黑暗》。"}, {"type": "subtitle", "time": 1661.19, "timestamp": "00:27:41", "text": "玩了什么？"}, {"type": "subtitle", "time": 1664.87, "timestamp": "00:27:44", "text": "失落的方舟。那就像桌面版的MMO游戏。"}, {"type": "subtitle", "time": 1668.47, "timestamp": "00:27:48", "text": "从未听说过。哦，有意思。"}, {"type": "subtitle", "time": 1671.269, "timestamp": "00:27:51", "text": "呃，不是桌面游戏。就像自上而下一样。"}, {"type": "subtitle", "time": 1672.23, "timestamp": "00:27:52", "text": "是的。"}, {"type": "subtitle", "time": 1675.51, "timestamp": "00:27:55", "text": "哦。哦，我……我真的不知道，我当时就像……"}, {"type": "subtitle", "time": 1677.269, "timestamp": "00:27:57", "text": "你知道，就是那种桌游之类的。"}, {"type": "subtitle", "time": 1679.269, "timestamp": "00:27:59", "text": "啊，桌游。不，不，不。"}]
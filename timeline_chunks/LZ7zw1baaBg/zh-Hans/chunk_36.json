[{"type": "subtitle", "time": 2161.75, "timestamp": "00:36:01", "text": "是的。"}, {"type": "subtitle", "time": 2162.39, "timestamp": "00:36:02", "text": "嗯。"}, {"type": "subtitle", "time": 2164.79, "timestamp": "00:36:04", "text": "你怎么认为？杜伊德。德鲁伊是"}, {"type": "subtitle", "time": 2166.87, "timestamp": "00:36:06", "text": "更好的。不。"}, {"type": "subtitle", "time": 2167.829, "timestamp": "00:36:07", "text": "什么？对不起。"}, {"type": "subtitle", "time": 2170.47, "timestamp": "00:36:10", "text": "德鲁伊更好，对吧？"}, {"type": "subtitle", "time": 2174.87, "timestamp": "00:36:14", "text": "呃，就阶级而言，我会说每个"}, {"type": "subtitle", "time": 2177.109, "timestamp": "00:36:17", "text": "我指的是技术上的课程"}, {"type": "subtitle", "time": 2180.15, "timestamp": "00:36:20", "text": "它们的功率等级不同，但是"}, {"type": "subtitle", "time": 2182.95, "timestamp": "00:36:22", "text": "嗯，他们中的大多数通常都在……"}, {"type": "subtitle", "time": 2184.87, "timestamp": "00:36:24", "text": "差不多，我觉得不是这样。"}, {"type": "subtitle", "time": 2187.27, "timestamp": "00:36:27", "text": "任何班级都像严格意义上的班级一样。"}, {"type": "subtitle", "time": 2189.91, "timestamp": "00:36:29", "text": "总比其他的好，你知道的。我会"}, {"type": "subtitle", "time": 2192.79, "timestamp": "00:36:32", "text": "就选你觉得合适的那个吧"}, {"type": "subtitle", "time": 2197.99, "timestamp": "00:36:37", "text": "[音乐]"}, {"type": "subtitle", "time": 2199.51, "timestamp": "00:36:39", "text": "呃"}, {"type": "subtitle", "time": 2202.31, "timestamp": "00:36:42", "text": "为什么我看不到所有的"}, {"type": "subtitle", "time": 2205.67, "timestamp": "00:36:45", "text": "像你这样的课程？我的就像 PHP。"}, {"type": "subtitle", "time": 2207.19, "timestamp": "00:36:47", "text": "别担心。是的，就是这样。"}, {"type": "subtitle", "time": 2208.23, "timestamp": "00:36:48", "text": "应该这样做。就像它应该的那样"}, {"type": "subtitle", "time": 2210.31, "timestamp": "00:36:50", "text": "仅显示 PHP 20224，因为其他"}, {"type": "subtitle", "time": 2212.31, "timestamp": "00:36:52", "text": "我拥有的那些就像来自呃从"}, {"type": "subtitle", "time": 2214.95, "timestamp": "00:36:54", "text": "还有一些其他来源，嗯，有点"}, {"type": "subtitle", "time": 2217.75, "timestamp": "00:36:57", "text": "更复杂一些。嗯，别担心。"}]
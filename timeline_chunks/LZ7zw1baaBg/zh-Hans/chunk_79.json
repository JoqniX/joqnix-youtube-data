[{"type": "subtitle", "time": 4740.47, "timestamp": "01:19:00", "text": "想先从一部音乐剧开始。"}, {"type": "subtitle", "time": 4741.75, "timestamp": "01:19:01", "text": "乐器。你有什么吗？"}, {"type": "subtitle", "time": 4743.669, "timestamp": "01:19:03", "text": "头脑？所有这些都类似于功能上的"}, {"type": "subtitle", "time": 4745.189, "timestamp": "01:19:05", "text": "顺便说一句，它们非常相似。不太确定"}, {"type": "subtitle", "time": 4747.83, "timestamp": "01:19:07", "text": "别太担心。"}, {"type": "subtitle", "time": 4750.87, "timestamp": "01:19:10", "text": "我的天哪。呃，"}, {"type": "subtitle", "time": 4753.669, "timestamp": "01:19:13", "text": "那说谎的人呢？"}, {"type": "subtitle", "time": 4756.149, "timestamp": "01:19:16", "text": "好的。可以点击吗？"}, {"type": "subtitle", "time": 4756.47, "timestamp": "01:19:16", "text": "好的。"}, {"type": "subtitle", "time": 4758.709, "timestamp": "01:19:18", "text": "毫米。是的。我们觉得可以吗？"}, {"type": "subtitle", "time": 4761.35, "timestamp": "01:19:21", "text": "那是什么功能来着？嗯，"}, {"type": "subtitle", "time": 4763.669, "timestamp": "01:19:23", "text": "呃，你可以玩。"}, {"type": "subtitle", "time": 4764.709, "timestamp": "01:19:24", "text": "哦好的。"}, {"type": "subtitle", "time": 4767.27, "timestamp": "01:19:27", "text": "是的。是的。"}, {"type": "subtitle", "time": 4769.83, "timestamp": "01:19:29", "text": "就像那个……那个跟DND有关的东西。"}, {"type": "subtitle", "time": 4773.91, "timestamp": "01:19:33", "text": "那就是……你可以做的事"}, {"type": "subtitle", "time": 4776.31, "timestamp": "01:19:36", "text": "你觉得什么合理就用什么。"}, {"type": "subtitle", "time": 4777.669, "timestamp": "01:19:37", "text": "这。因为这是一种角色扮演"}, {"type": "subtitle", "time": 4779.669, "timestamp": "01:19:39", "text": "游戏。规则并非如此。"}, {"type": "subtitle", "time": 4783.27, "timestamp": "01:19:43", "text": "对他来说太难了，你知道，不是这样的"}, {"type": "subtitle", "time": 4785.91, "timestamp": "01:19:45", "text": "如同铁证如山。你真的可以做到"}, {"type": "subtitle", "time": 4788.47, "timestamp": "01:19:48", "text": "无论你和一个骗子在一起，你都无所谓，而且你还知道。"}, {"type": "subtitle", "time": 4791.11, "timestamp": "01:19:51", "text": "就像你一样，你可以，你可以，比如举重"}, {"type": "subtitle", "time": 4794.63, "timestamp": "01:19:54", "text": "有人起来了。我不知道"}, {"type": "subtitle", "time": 4797.91, "timestamp": "01:19:57", "text": "你。好的。是的。好的。所以，我们是"}, {"type": "subtitle", "time": 4799.27, "timestamp": "01:19:59", "text": "选那个。如果真是这样，我打算……"}]
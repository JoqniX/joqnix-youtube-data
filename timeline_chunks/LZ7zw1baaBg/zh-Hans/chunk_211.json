[{"type": "subtitle", "time": 12664.229, "timestamp": "03:31:04", "text": "她宣布了她的决定。哦，她"}, {"type": "subtitle", "time": 12667.83, "timestamp": "03:31:07", "text": "她宣布了这一消息。好的。"}, {"type": "subtitle", "time": 12669.99, "timestamp": "03:31:09", "text": "我爱"}, {"type": "subtitle", "time": 12693.59, "timestamp": "03:31:33", "text": "你知道吗？"}, {"type": "subtitle", "time": 12702.15, "timestamp": "03:31:42", "text": "镰？她直播的频率很高。他是一名第一人称射击游戏玩家。"}, {"type": "subtitle", "time": 12704.309, "timestamp": "03:31:44", "text": "男。"}, {"type": "subtitle", "time": 12706.87, "timestamp": "03:31:46", "text": "天哪，我太爱她了。"}, {"type": "subtitle", "time": 12708.79, "timestamp": "03:31:48", "text": "爱她。"}, {"type": "subtitle", "time": 12711.349, "timestamp": "03:31:51", "text": "我认为我的灵感来源之一"}, {"type": "subtitle", "time": 12714.07, "timestamp": "03:31:54", "text": "去年回归流媒体平台，就像"}, {"type": "subtitle", "time": 12716.389, "timestamp": "03:31:56", "text": "在我休息了一段时间之后，一切都结束了。"}, {"type": "subtitle", "time": 12719.51, "timestamp": "03:31:59", "text": "自从我认识了凪之后。所以从"}]
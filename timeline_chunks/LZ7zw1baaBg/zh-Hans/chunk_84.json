[{"type": "subtitle", "time": 5041.35, "timestamp": "01:24:01", "text": "你可以像进行急救一样进行操作"}, {"type": "subtitle", "time": 5043.03, "timestamp": "01:24:03", "text": "如果你愿意的话，这样你就可以让他们"}, {"type": "subtitle", "time": 5045.91, "timestamp": "01:24:05", "text": "他们不会流血而死。哦，我可以做"}, {"type": "subtitle", "time": 5047.51, "timestamp": "01:24:07", "text": "比如背部。其实并没有真正痊愈。"}, {"type": "subtitle", "time": 5049.27, "timestamp": "01:24:09", "text": "这不是治愈，而是他们不……"}, {"type": "subtitle", "time": 5052.79, "timestamp": "01:24:12", "text": "恢复生命值。他们就不再损失生命值了。"}, {"type": "subtitle", "time": 5054.229, "timestamp": "01:24:14", "text": "太长不看。"}, {"type": "subtitle", "time": 5056.709, "timestamp": "01:24:16", "text": "哦，我可以从某人那里省下一些钱。"}, {"type": "subtitle", "time": 5058.149, "timestamp": "01:24:18", "text": "失血。好的。"}, {"type": "subtitle", "time": 5061.27, "timestamp": "01:24:21", "text": "是啊，诸如此类的事情。本质上，"}, {"type": "subtitle", "time": 5063.91, "timestamp": "01:24:23", "text": "生存。它具体是做什么用的？"}, {"type": "subtitle", "time": 5066.47, "timestamp": "01:24:26", "text": "生存就像做这样的事情"}, {"type": "subtitle", "time": 5069.99, "timestamp": "01:24:29", "text": "追踪、觅食，还有，嗯，其他的"}, {"type": "subtitle", "time": 5071.189, "timestamp": "01:24:31", "text": "就是这样。"}, {"type": "subtitle", "time": 5094.149, "timestamp": "01:24:54", "text": "[音乐]"}]
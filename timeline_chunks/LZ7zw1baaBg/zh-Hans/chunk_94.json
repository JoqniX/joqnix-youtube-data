[{"type": "subtitle", "time": 5645.27, "timestamp": "01:34:05", "text": "我觉得我应该再等等。呃，我有灯。"}, {"type": "subtitle", "time": 5656.149, "timestamp": "01:34:16", "text": "如果我选择，请稍等。"}, {"type": "subtitle", "time": 5658.31, "timestamp": "01:34:18", "text": "我将担任辅助角色"}, {"type": "subtitle", "time": 5661.11, "timestamp": "01:34:21", "text": "如果我选择火焰，我就可以做到"}, {"type": "subtitle", "time": 5663.59, "timestamp": "01:34:23", "text": "损害权利"}, {"type": "subtitle", "time": 5665.91, "timestamp": "01:34:25", "text": "是的，你可以选两个。"}, {"type": "subtitle", "time": 5666.39, "timestamp": "01:34:26", "text": "他们"}, {"type": "subtitle", "time": 5667.91, "timestamp": "01:34:27", "text": "哦，两个，好的，好的"}, {"type": "subtitle", "time": 5670.47, "timestamp": "01:34:30", "text": "是的，你选两个。"}, {"type": "subtitle", "time": 5673.35, "timestamp": "01:34:33", "text": "呃"}, {"type": "subtitle", "time": 5675.11, "timestamp": "01:34:35", "text": "嗯，嗯，我想基本上就是这样"}, {"type": "subtitle", "time": 5676.709, "timestamp": "01:34:36", "text": "如果你不知道，如果你不知道什么"}, {"type": "subtitle", "time": 5678.79, "timestamp": "01:34:38", "text": "要选的话，就选一个能造成伤害的。"}, {"type": "subtitle", "time": 5686.31, "timestamp": "01:34:46", "text": "好的，那我选择指导。"}, {"type": "subtitle", "time": 5687.99, "timestamp": "01:34:47", "text": "产生火焰。"}, {"type": "subtitle", "time": 5691.189, "timestamp": "01:34:51", "text": "引导并产生火焰。让我……"}, {"type": "subtitle", "time": 5692.95, "timestamp": "01:34:52", "text": "什么是火焰？那是什么？好的，"}, {"type": "subtitle", "time": 5694.629, "timestamp": "01:34:54", "text": "这里是。让我查一下那是什么。"}, {"type": "subtitle", "time": 5697.59, "timestamp": "01:34:57", "text": "再次。哦。哦。糟糕。是的。是的。好的。"}]
[{"type": "subtitle", "time": 1560.549, "timestamp": "00:26:00", "text": "点击那里，然后就可以去上课了。"}, {"type": "subtitle", "time": 1562.47, "timestamp": "00:26:02", "text": "也喜欢有详细描述"}, {"type": "subtitle", "time": 1564.789, "timestamp": "00:26:04", "text": "每个班级。但如果你想喜欢"}, {"type": "subtitle", "time": 1567.59, "timestamp": "00:26:07", "text": "但如果你想问一个大致的……嗯……什么"}, {"type": "subtitle", "time": 1569.269, "timestamp": "00:26:09", "text": "我们再次致电概述，我喜欢"}, {"type": "subtitle", "time": 1571.51, "timestamp": "00:26:11", "text": "向你解释每个班级是做什么的"}, {"type": "subtitle", "time": 1573.43, "timestamp": "00:26:13", "text": "或者如果你想的话，可以阅读一下"}, {"type": "subtitle", "time": 1575.75, "timestamp": "00:26:15", "text": "对该期刊的概述，它也是"}, {"type": "subtitle", "time": 1579.11, "timestamp": "00:26:19", "text": "就像网站上的那个东西……"}, {"type": "subtitle", "time": 1581.669, "timestamp": "00:26:21", "text": "那就像我的IP地址一样。嗯，如果你去"}, {"type": "subtitle", "time": 1583.35, "timestamp": "00:26:23", "text": "转到期刊选项卡，即本书。"}, {"type": "subtitle", "time": 1585.909, "timestamp": "00:26:25", "text": "右上角有个标签页"}, {"type": "subtitle", "time": 1587.59, "timestamp": "00:26:27", "text": "称为课程概述。如果你点击那个"}, {"type": "subtitle", "time": 1591.269, "timestamp": "00:26:31", "text": "你也可以看看每个班级的情况。"}, {"type": "subtitle", "time": 1595.909, "timestamp": "00:26:35", "text": "是。哦好的。好的。哦，这个。好的。"}, {"type": "subtitle", "time": 1597.029, "timestamp": "00:26:37", "text": "是的。是的。"}, {"type": "subtitle", "time": 1599.11, "timestamp": "00:26:39", "text": "啊，"}, {"type": "subtitle", "time": 1601.43, "timestamp": "00:26:41", "text": "如果我不知道应该用什么角色，"}, {"type": "subtitle", "time": 1604.95, "timestamp": "00:26:44", "text": "我还是以我的搞笑角色出场吧"}, {"type": "subtitle", "time": 1605.669, "timestamp": "00:26:45", "text": "然后？"}, {"type": "subtitle", "time": 1607.75, "timestamp": "00:26:47", "text": "我的意思是，如果你愿意的话，当然可以。如果你"}, {"type": "subtitle", "time": 1609.029, "timestamp": "00:26:49", "text": "想要的话，请随意。"}, {"type": "subtitle", "time": 1611.35, "timestamp": "00:26:51", "text": "好的。我是什么？我是一颗星座。"}, {"type": "subtitle", "time": 1616.87, "timestamp": "00:26:56", "text": "所以，等等。呃，等等。巫师有用吗？"}, {"type": "subtitle", "time": 1618.549, "timestamp": "00:26:58", "text": "这取决于什么"}, {"type": "subtitle", "time": 1619.909, "timestamp": "00:26:59", "text": "等等，你是不是想找个巫师？"}]
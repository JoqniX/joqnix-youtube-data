[{"type": "subtitle", "time": 1381.51, "timestamp": "00:23:01", "text": "就像它可能包含一种音乐"}, {"type": "subtitle", "time": 1383.029, "timestamp": "00:23:03", "text": "有点吵。你可以把它调低。"}, {"type": "subtitle", "time": 1385.59, "timestamp": "00:23:05", "text": "右上角。有一个按钮"}, {"type": "subtitle", "time": 1387.75, "timestamp": "00:23:07", "text": "播放列表。"}, {"type": "subtitle", "time": 1388.789, "timestamp": "00:23:08", "text": "啊，音乐。"}, {"type": "subtitle", "time": 1392.31, "timestamp": "00:23:12", "text": "那里有音乐，想听的话可以去听。哦，"}, {"type": "subtitle", "time": 1405.27, "timestamp": "00:23:25", "text": "哦，这真不错。是的。"}, {"type": "subtitle", "time": 1410.07, "timestamp": "00:23:30", "text": "好的。嗯，好的，你进去了。嗯，让我……"}, {"type": "subtitle", "time": 1413.27, "timestamp": "00:23:33", "text": "看。呃，让我确认一下"}, {"type": "subtitle", "time": 1415.669, "timestamp": "00:23:35", "text": "一切运行正常。好的。"}, {"type": "subtitle", "time": 1419.029, "timestamp": "00:23:39", "text": "好的。嗯，好的。所以，如果你去"}, {"type": "subtitle", "time": 1420.87, "timestamp": "00:23:40", "text": "演员选项卡位于顶部。"}, {"type": "subtitle", "time": 1423.75, "timestamp": "00:23:43", "text": "右下角，有一个类似……"}, {"type": "subtitle", "time": 1426.63, "timestamp": "00:23:46", "text": "人物图标。你应该已经有一个"}, {"type": "subtitle", "time": 1428.47, "timestamp": "00:23:48", "text": "角色卡。我已经把它给了"}, {"type": "subtitle", "time": 1430.07, "timestamp": "00:23:50", "text": "你。应该写上乔伊的角色"}, {"type": "subtitle", "time": 1431.669, "timestamp": "00:23:51", "text": "床单。那东西能看到吗？"}, {"type": "subtitle", "time": 1433.669, "timestamp": "00:23:53", "text": "它已经显示玩家了。"}, {"type": "subtitle", "time": 1436.39, "timestamp": "00:23:56", "text": "周六派对团队冲突角色。"}, {"type": "subtitle", "time": 1438.39, "timestamp": "00:23:58", "text": "是的，没错。前往分类"}]
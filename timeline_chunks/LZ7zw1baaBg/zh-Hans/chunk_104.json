[{"type": "subtitle", "time": 6243.03, "timestamp": "01:44:03", "text": "不算特别出色。嗯"}, {"type": "subtitle", "time": 6245.59, "timestamp": "01:44:05", "text": "让我看看。抵抗力对某些人来说是好事"}, {"type": "subtitle", "time": 6248.95, "timestamp": "01:44:08", "text": "如果你……那就造成损害了。"}, {"type": "subtitle", "time": 6252.31, "timestamp": "01:44:12", "text": "寻找。嗯，"}, {"type": "subtitle", "time": 6255.27, "timestamp": "01:44:15", "text": "修补通常对很多方面都有好处。"}, {"type": "subtitle", "time": 6257.03, "timestamp": "01:44:17", "text": "事物。你可以像这样解决问题。"}, {"type": "subtitle", "time": 6259.669, "timestamp": "01:44:19", "text": "施了个咒语，让你不喜欢某些东西。"}, {"type": "subtitle", "time": 6261.59, "timestamp": "01:44:21", "text": "不要打破。嗯，"}, {"type": "subtitle", "time": 6264.629, "timestamp": "01:44:24", "text": "哦，你的东西坏了。"}, {"type": "subtitle", "time": 6267.189, "timestamp": "01:44:27", "text": "呃，其实不是，但更像是……"}, {"type": "subtitle", "time": 6269.83, "timestamp": "01:44:29", "text": "很多事情都很有趣"}, {"type": "subtitle", "time": 6273.03, "timestamp": "01:44:33", "text": "用于修补。呃，有点"}, {"type": "subtitle", "time": 6274.87, "timestamp": "01:44:34", "text": "很难解释，但就像……"}, {"type": "subtitle", "time": 6277.51, "timestamp": "01:44:37", "text": "举个例子，嗯，我想举个好例子吧。"}, {"type": "subtitle", "time": 6280.95, "timestamp": "01:44:40", "text": "就像以前一样，那时候有几个人喜欢"}, {"type": "subtitle", "time": 6282.79, "timestamp": "01:44:42", "text": "几周前，当我玩游戏的时候"}, {"type": "subtitle", "time": 6285.03, "timestamp": "01:44:45", "text": "我曾是另一个团队的一员，呃，我曾经是。"}, {"type": "subtitle", "time": 6287.91, "timestamp": "01:44:47", "text": "修补，我们需要我们，我们是"}, {"type": "subtitle", "time": 6290.709, "timestamp": "01:44:50", "text": "就像调查某个墓地一样。"}, {"type": "subtitle", "time": 6294.47, "timestamp": "01:44:54", "text": "所以，呃，我们的计划就像我朋友以前用的那种。"}, {"type": "subtitle", "time": 6296.87, "timestamp": "01:44:56", "text": "用运动能力打破锁，然后一旦"}, {"type": "subtitle", "time": 6298.229, "timestamp": "01:44:58", "text": "我们已经完成了手头的一切工作。"}]
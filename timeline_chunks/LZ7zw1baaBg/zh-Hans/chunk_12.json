[{"type": "subtitle", "time": 739.269, "timestamp": "00:12:19", "text": "好的，那我从这里重新开始。"}, {"type": "subtitle", "time": 742.389, "timestamp": "00:12:22", "text": "我想等等，让我从那里重新开始吧。"}, {"type": "subtitle", "time": 745.03, "timestamp": "00:12:25", "text": "回去。"}, {"type": "subtitle", "time": 747.03, "timestamp": "00:12:27", "text": "我明白了。我当时的感觉就像……"}, {"type": "subtitle", "time": 748.87, "timestamp": "00:12:28", "text": "不小心开启了监听模式。我"}, {"type": "subtitle", "time": 750.55, "timestamp": "00:12:30", "text": "当时我就想，听你这么说，然后我就想……"}, {"type": "subtitle", "time": 753.829, "timestamp": "00:12:33", "text": "哦等等，我得唱歌。"}, {"type": "subtitle", "time": 756.55, "timestamp": "00:12:36", "text": "唱歌就像对你一样，这样你就能得到一个"}, {"type": "subtitle", "time": 757.829, "timestamp": "00:12:37", "text": "主意。"}, {"type": "subtitle", "time": 759.829, "timestamp": "00:12:39", "text": "你好。"}, {"type": "subtitle", "time": 761.03, "timestamp": "00:12:41", "text": "抱歉。"}, {"type": "subtitle", "time": 764.47, "timestamp": "00:12:44", "text": "哦，没事的。没关系。"}, {"type": "subtitle", "time": 768.55, "timestamp": "00:12:48", "text": "你把手机弄坏了。"}, {"type": "subtitle", "time": 771.03, "timestamp": "00:12:51", "text": "哦不，"}, {"type": "subtitle", "time": 772.87, "timestamp": "00:12:52", "text": "这就是你搞砸的地方。是的，"}, {"type": "subtitle", "time": 776.79, "timestamp": "00:12:56", "text": "只是通知你一下。"}, {"type": "subtitle", "time": 779.91, "timestamp": "00:12:59", "text": "我将从……开始"}]
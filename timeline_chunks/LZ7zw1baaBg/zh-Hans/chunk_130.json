[{"type": "subtitle", "time": 7801.91, "timestamp": "02:10:01", "text": "就像你可以……"}, {"type": "subtitle", "time": 7804.95, "timestamp": "02:10:04", "text": "呃，引用结束"}, {"type": "subtitle", "time": 7807.189, "timestamp": "02:10:07", "text": "嗯演员表"}, {"type": "subtitle", "time": 7810.069, "timestamp": "02:10:10", "text": "三级法术两次，第二个"}, {"type": "subtitle", "time": 7812.47, "timestamp": "02:10:12", "text": "三次一级法术，以及第一次"}, {"type": "subtitle", "time": 7818.87, "timestamp": "02:10:18", "text": "现在。"}, {"type": "subtitle", "time": 7822.53, "timestamp": "02:10:22", "text": "让你达到当前水平。"}, {"type": "subtitle", "time": 7835.43, "timestamp": "02:10:35", "text": "呃，等等，你看到我的屏幕了吗？"}, {"type": "subtitle", "time": 7837.99, "timestamp": "02:10:37", "text": "嗯？哦，我不再共享屏幕了。"}, {"type": "subtitle", "time": 7839.27, "timestamp": "02:10:39", "text": "但是，如果你愿意，你可以共享屏幕。"}, {"type": "subtitle", "time": 7841.03, "timestamp": "02:10:41", "text": "想要，因为我已经完成了，我曾经是"}, {"type": "subtitle", "time": 7843.35, "timestamp": "02:10:43", "text": "不分享。提升你的等级。哦，"}, {"type": "subtitle", "time": 7845.589, "timestamp": "02:10:45", "text": "你没有分享。是的。"}, {"type": "subtitle", "time": 7845.669, "timestamp": "02:10:45", "text": "做"}, {"type": "subtitle", "time": 7848.95, "timestamp": "02:10:48", "text": "又来了。好的。"}, {"type": "subtitle", "time": 7851.109, "timestamp": "02:10:51", "text": "所以这些对吧？"}, {"type": "subtitle", "time": 7852.55, "timestamp": "02:10:52", "text": "是的。哦。哦，咔哒咔哒扳手"}, {"type": "subtitle", "time": 7853.99, "timestamp": "02:10:53", "text": "再次。对了，把扳手松开。"}, {"type": "subtitle", "time": 7856.55, "timestamp": "02:10:56", "text": "所以你没有处于编辑模式。我忘了……"}, {"type": "subtitle", "time": 7858.87, "timestamp": "02:10:58", "text": "右上角。是的，如果你不是"}]
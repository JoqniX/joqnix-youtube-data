[{"type": "subtitle", "time": 7861.75, "timestamp": "02:11:01", "text": "编辑，保留那个呃呃呃什么叫"}, {"type": "subtitle", "time": 7863.51, "timestamp": "02:11:03", "text": "再次关闭，以免意外关闭"}, {"type": "subtitle", "time": 7867.27, "timestamp": "02:11:07", "text": "嗯……呃……那叫什么来着？呃，一团糟"}, {"type": "subtitle", "time": 7870.55, "timestamp": "02:11:10", "text": "出事了。是的。所以这边，呃"}, {"type": "subtitle", "time": 7872.47, "timestamp": "02:11:12", "text": "这是你的法术列表。如果你看一下"}, {"type": "subtitle", "time": 7874.31, "timestamp": "02:11:14", "text": "顶部，它说是根部。就像在……"}, {"type": "subtitle", "time": 7875.99, "timestamp": "02:11:15", "text": "最上面有一条小横线，上面写着："}, {"type": "subtitle", "time": 7878.069, "timestamp": "02:11:18", "text": "施法。它说准备零"}, {"type": "subtitle", "time": 7880.31, "timestamp": "02:11:20", "text": "满分九分，对吧？"}, {"type": "subtitle", "time": 7881.03, "timestamp": "02:11:21", "text": "是的。"}, {"type": "subtitle", "time": 7887.109, "timestamp": "02:11:27", "text": "魔法直到你直到呃你可以"}, {"type": "subtitle", "time": 7890.31, "timestamp": "02:11:30", "text": "准备九个法术。嗯，是的，你可以"}, {"type": "subtitle", "time": 7892.629, "timestamp": "02:11:32", "text": "准备九个法术。请随意准备"}, {"type": "subtitle", "time": 7894.79, "timestamp": "02:11:34", "text": "您可以随意准备任何您想要的咒语。"}, {"type": "subtitle", "time": 7897.03, "timestamp": "02:11:37", "text": "想。你可以每次都更改此设置"}, {"type": "subtitle", "time": 7900.87, "timestamp": "02:11:40", "text": "嗯，每次进行长休的时候。"}, {"type": "subtitle", "time": 7904.39, "timestamp": "02:11:44", "text": "哦，但是，有些咒语是"}, {"type": "subtitle", "time": 7905.99, "timestamp": "02:11:45", "text": "已经准备好了。"}, {"type": "subtitle", "time": 7907.51, "timestamp": "02:11:47", "text": "哦，是的。就是这样，已经是这样了。"}, {"type": "subtitle", "time": 7908.87, "timestamp": "02:11:48", "text": "时刻做好准备，因为这在某种程度上……"}, {"type": "subtitle", "time": 7910.629, "timestamp": "02:11:50", "text": "就像一种与生俱来的魔法"}, {"type": "subtitle", "time": 7912.95, "timestamp": "02:11:52", "text": "给你。所以你不认为这算数。"}, {"type": "subtitle", "time": 7915.99, "timestamp": "02:11:55", "text": "对你准备的法术。毫米-"}, {"type": "subtitle", "time": 7918.229, "timestamp": "02:11:58", "text": "哦好的。"}]
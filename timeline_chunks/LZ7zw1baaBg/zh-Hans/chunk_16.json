[{"type": "subtitle", "time": 960.79, "timestamp": "00:16:00", "text": "[音乐]"}, {"type": "subtitle", "time": 984.71, "timestamp": "00:16:24", "text": "是的，情况好得多，甚至更好。这部分"}, {"type": "subtitle", "time": 987.269, "timestamp": "00:16:27", "text": "你对嘿没有信心"}, {"type": "subtitle", "time": 990.31, "timestamp": "00:16:30", "text": "Sakoto，到最后你搞砸了"}, {"type": "subtitle", "time": 992.31, "timestamp": "00:16:32", "text": "稍微踱步了一下。基本上就是这样。"}, {"type": "subtitle", "time": 993.91, "timestamp": "00:16:33", "text": "发生了什么事？"}, {"type": "subtitle", "time": 995.35, "timestamp": "00:16:35", "text": "是的。"}, {"type": "subtitle", "time": 1000.23, "timestamp": "00:16:40", "text": "我开始注意到这一点。我的天啊。你好。"}, {"type": "subtitle", "time": 1005.59, "timestamp": "00:16:45", "text": "Kawu 和 Nawu 以及类似的两条线"}, {"type": "subtitle", "time": 1008.47, "timestamp": "00:16:48", "text": "来自卡武。那真是太好了。"}, {"type": "subtitle", "time": 1009.43, "timestamp": "00:16:49", "text": "哦，不错。"}, {"type": "subtitle", "time": 1012.15, "timestamp": "00:16:52", "text": "是的，气氛正好。"}, {"type": "subtitle", "time": 1014.389, "timestamp": "00:16:54", "text": "好的。你还可以再唱五遍。"}, {"type": "subtitle", "time": 1016.47, "timestamp": "00:16:56", "text": "与乐器伴奏的次数。那是"}, {"type": "subtitle", "time": 1017.269, "timestamp": "00:16:57", "text": "较少的。"}, {"type": "subtitle", "time": 1018.79, "timestamp": "00:16:58", "text": "是的。"}]
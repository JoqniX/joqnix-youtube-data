[{"type": "subtitle", "time": 5163.11, "timestamp": "01:26:03", "text": "是的。我的意思是，我的意思是，我想如果你我"}, {"type": "subtitle", "time": 5164.87, "timestamp": "01:26:04", "text": "如果你不确定自己是否真的……，那就猜猜看。"}, {"type": "subtitle", "time": 5167.59, "timestamp": "01:26:07", "text": "如果你通常不了解的话。"}, {"type": "subtitle", "time": 5169.83, "timestamp": "01:26:09", "text": "医学和生存将类似于"}, {"type": "subtitle", "time": 5172.79, "timestamp": "01:26:12", "text": "这些通常对你来说相当不错"}, {"type": "subtitle", "time": 5179.35, "timestamp": "01:26:19", "text": "因为它就像，因为它就像呃"}, {"type": "subtitle", "time": 5182.229, "timestamp": "01:26:22", "text": "它还会用到你的智慧属性。"}, {"type": "subtitle", "time": 5183.75, "timestamp": "01:26:23", "text": "所以，是的，这两个人通常都很不错。"}, {"type": "subtitle", "time": 5185.91, "timestamp": "01:26:25", "text": "如果你不知道该选什么，这很有用。"}, {"type": "subtitle", "time": 5188.87, "timestamp": "01:26:28", "text": "但难道一切不都是在运用我的智慧吗？"}, {"type": "subtitle", "time": 5189.75, "timestamp": "01:26:29", "text": "地位？"}, {"type": "subtitle", "time": 5192.229, "timestamp": "01:26:32", "text": "哦不，不。比如动物处理之类的"}, {"type": "subtitle", "time": 5193.99, "timestamp": "01:26:33", "text": "例如，智慧和奥术的使用"}, {"type": "subtitle", "time": 5195.83, "timestamp": "01:26:35", "text": "智慧，洞察力就是智慧。"}, {"type": "subtitle", "time": 5197.35, "timestamp": "01:26:37", "text": "医学是智慧，自然是"}, {"type": "subtitle", "time": 5199.35, "timestamp": "01:26:39", "text": "智慧，即洞察力。"}, {"type": "subtitle", "time": 5201.03, "timestamp": "01:26:41", "text": "宗教是智慧，生存是"}, {"type": "subtitle", "time": 5204.229, "timestamp": "01:26:44", "text": "智慧。这取决于是什么技能。"}, {"type": "subtitle", "time": 5207.189, "timestamp": "01:26:47", "text": "好的。所以如果我……因为感知"}, {"type": "subtitle", "time": 5209.59, "timestamp": "01:26:49", "text": "内心深处已然蕴藏着智慧，如果我"}, {"type": "subtitle", "time": 5211.83, "timestamp": "01:26:51", "text": "选择另一种智慧，可以吗？"}, {"type": "subtitle", "time": 5214.229, "timestamp": "01:26:54", "text": "影响智慧属性点吗？"}, {"type": "subtitle", "time": 5215.75, "timestamp": "01:26:55", "text": "呃，不，不是这样的。它不喜欢它"}]
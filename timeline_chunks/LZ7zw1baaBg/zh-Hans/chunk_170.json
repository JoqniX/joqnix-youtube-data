[{"type": "subtitle", "time": 10201.269, "timestamp": "02:50:01", "text": "敌人移动到你面前这边来。"}, {"type": "subtitle", "time": 10204.55, "timestamp": "02:50:04", "text": "并让它用西玛尔进行攻击。如果我"}, {"type": "subtitle", "time": 10207.67, "timestamp": "02:50:07", "text": "照做，照做，然后正常地正常地做。"}, {"type": "subtitle", "time": 10211.429, "timestamp": "02:50:11", "text": "呃，滚动。所以掷骰子结果是20。20是"}, {"type": "subtitle", "time": 10213.59, "timestamp": "02:50:13", "text": "空调上方。您的空调当前温度为 16。"}, {"type": "subtitle", "time": 10216.389, "timestamp": "02:50:16", "text": "因为它在你空调上方，呃，我可以……"}, {"type": "subtitle", "time": 10219.67, "timestamp": "02:50:19", "text": "损害。所以，如果我点击这里，"}, {"type": "subtitle", "time": 10221.269, "timestamp": "02:50:21", "text": "这是你造成的损失。所以，你取四个"}, {"type": "subtitle", "time": 10223.51, "timestamp": "02:50:23", "text": "类似那样的损害。他们并没有"}, {"type": "subtitle", "time": 10225.11, "timestamp": "02:50:25", "text": "轮到他们时，他们身上会有任何东西。"}, {"type": "subtitle", "time": 10226.87, "timestamp": "02:50:26", "text": "所以，我打算……我打算……"}, {"type": "subtitle", "time": 10228.469, "timestamp": "02:50:28", "text": "他们轮到自己了。所以，它将要"}, {"type": "subtitle", "time": 10234.15, "timestamp": "02:50:34", "text": "好的。"}, {"type": "subtitle", "time": 10236.63, "timestamp": "02:50:36", "text": "这算是基础知识吧。让我"}, {"type": "subtitle", "time": 10240.55, "timestamp": "02:50:40", "text": "看。哦，是的。好的。那是通常的情况"}, {"type": "subtitle", "time": 10243.67, "timestamp": "02:50:43", "text": "你以前那样做的人，嗯……"}, {"type": "subtitle", "time": 10245.99, "timestamp": "02:50:45", "text": "战斗，因为你可以随时进行战斗。"}, {"type": "subtitle", "time": 10249.51, "timestamp": "02:50:49", "text": "嗯，不过，这基本上就是"}, {"type": "subtitle", "time": 10251.75, "timestamp": "02:50:51", "text": "一个有趣又熟悉的咒语。呃，你可以使用"}, {"type": "subtitle", "time": 10254.469, "timestamp": "02:50:54", "text": "你的狂野变形能力可以做到这一点。荒野"}, {"type": "subtitle", "time": 10257.67, "timestamp": "02:50:57", "text": "形状是你变形的能力。"}]
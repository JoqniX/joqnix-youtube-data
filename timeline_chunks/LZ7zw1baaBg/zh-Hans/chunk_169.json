[{"type": "subtitle", "time": 10140.96, "timestamp": "02:49:00", "text": "那。然后我就可以申请了。 是啊，就是这样。"}, {"type": "subtitle", "time": 10149.03, "timestamp": "02:49:09", "text": "好的。好的。你带了什么吗？"}, {"type": "subtitle", "time": 10149.59, "timestamp": "02:49:09", "text": "如果你不"}, {"type": "subtitle", "time": 10151.429, "timestamp": "02:49:11", "text": "为什么没有生命值条？"}, {"type": "subtitle", "time": 10152.23, "timestamp": "02:49:12", "text": "哥布林？"}, {"type": "subtitle", "time": 10155.83, "timestamp": "02:49:15", "text": "哦，是的。呃，敌人，呃，敌人的生命值是"}, {"type": "subtitle", "time": 10158.23, "timestamp": "02:49:18", "text": "通常隐藏起来。呃，所以你不能，你需要"}, {"type": "subtitle", "time": 10160.309, "timestamp": "02:49:20", "text": "就像……呃，就像用你的"}, {"type": "subtitle", "time": 10163.03, "timestamp": "02:49:23", "text": "胆子真大，居然要去算算他们有多少HP"}, {"type": "subtitle", "time": 10164.63, "timestamp": "02:49:24", "text": "曾经离开过。"}, {"type": "subtitle", "time": 10167.03, "timestamp": "02:49:27", "text": "哦好的。好的。"}, {"type": "subtitle", "time": 10167.59, "timestamp": "02:49:27", "text": "是的。"}, {"type": "subtitle", "time": 10170.23, "timestamp": "02:49:30", "text": "所以很多情况下，HP条的显示方式都不一样。"}, {"type": "subtitle", "time": 10172.23, "timestamp": "02:49:32", "text": "不同的实体，对吧？"}, {"type": "subtitle", "time": 10175.429, "timestamp": "02:49:35", "text": "每一种生物都有其独特的特征。"}, {"type": "subtitle", "time": 10179.67, "timestamp": "02:49:39", "text": "不同的嗯HP。是的，你可以看到你的"}, {"type": "subtitle", "time": 10182.87, "timestamp": "02:49:42", "text": "友方生命值，但敌人生命值不变。"}, {"type": "subtitle", "time": 10185.03, "timestamp": "02:49:45", "text": "哦好的。"}, {"type": "subtitle", "time": 10189.83, "timestamp": "02:49:49", "text": "是的。好的。好的。呃"}, {"type": "subtitle", "time": 10191.83, "timestamp": "02:49:51", "text": "一旦你完成了你的"}, {"type": "subtitle", "time": 10194.23, "timestamp": "02:49:54", "text": "转动，你点击并转动，这样……"}, {"type": "subtitle", "time": 10196.309, "timestamp": "02:49:56", "text": "下一个人可以开始移动了。是的。"}, {"type": "subtitle", "time": 10197.91, "timestamp": "02:49:57", "text": "比如这里，就像这样"}, {"type": "subtitle", "time": 10199.03, "timestamp": "02:49:59", "text": "敌人可以移动。现在我要开始制作"}]
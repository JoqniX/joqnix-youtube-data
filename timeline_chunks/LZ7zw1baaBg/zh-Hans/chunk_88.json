[{"type": "subtitle", "time": 5281.59, "timestamp": "01:28:01", "text": "在感知方面。比如说，感知"}, {"type": "subtitle", "time": 5283.59, "timestamp": "01:28:03", "text": "是一种智慧技能。所以，当感知……"}, {"type": "subtitle", "time": 5285.83, "timestamp": "01:28:05", "text": "当我让你进行感知检定时，你"}, {"type": "subtitle", "time": 5288.149, "timestamp": "01:28:08", "text": "你掷一个20面骰子，然后加三"}, {"type": "subtitle", "time": 5289.669, "timestamp": "01:28:09", "text": "因为那是来自你的智慧，然后"}, {"type": "subtitle", "time": 5291.83, "timestamp": "01:28:11", "text": "你再加两个，因为那是来自"}, {"type": "subtitle", "time": 5295.669, "timestamp": "01:28:15", "text": "你的熟练度加值。"}, {"type": "subtitle", "time": 5298.07, "timestamp": "01:28:18", "text": "哦，如果你精通此道的话。如果"}, {"type": "subtitle", "time": 5299.51, "timestamp": "01:28:19", "text": "你并不精通，你只是……"}, {"type": "subtitle", "time": 5301.189, "timestamp": "01:28:21", "text": "开始。假设你不是"}, {"type": "subtitle", "time": 5303.669, "timestamp": "01:28:23", "text": "精通医学。如果我做到了"}, {"type": "subtitle", "time": 5305.99, "timestamp": "01:28:25", "text": "呃，如果我让你掷骰子决定吃药，"}, {"type": "subtitle", "time": 5308.629, "timestamp": "01:28:28", "text": "掷一个d20，然后加上感知值。所以"}, {"type": "subtitle", "time": 5313.03, "timestamp": "01:28:33", "text": "加上三个，就这些了。"}, {"type": "subtitle", "time": 5318.229, "timestamp": "01:28:38", "text": "它是自动计算的。所以不要"}, {"type": "subtitle", "time": 5321.69, "timestamp": "01:28:41", "text": "所以不用担心。"}, {"type": "subtitle", "time": 5329.59, "timestamp": "01:28:49", "text": "H，就像我，我想我会去"}, {"type": "subtitle", "time": 5333.59, "timestamp": "01:28:53", "text": "要么是宗教信仰，要么是为了生存。是"}, {"type": "subtitle", "time": 5336.95, "timestamp": "01:28:56", "text": "也喜欢一些片段和那些你知道的东西"}, {"type": "subtitle", "time": 5339.669, "timestamp": "01:28:59", "text": "但是，呃，因为我不知道哪个队。"}]
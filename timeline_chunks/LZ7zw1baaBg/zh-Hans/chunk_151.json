[{"type": "subtitle", "time": 9060.63, "timestamp": "02:31:00", "text": "是的，他们一直在买"}, {"type": "subtitle", "time": 9064.23, "timestamp": "02:31:04", "text": "事物。哦，是的。之后。呃，你愿意吗？"}, {"type": "subtitle", "time": 9065.99, "timestamp": "02:31:05", "text": "想让我教你怎么做吗？"}, {"type": "subtitle", "time": 9069.91, "timestamp": "02:31:09", "text": "什么名字来着？嗯"}, {"type": "subtitle", "time": 9073.19, "timestamp": "02:31:13", "text": "商店里的东西以后再说。呃，我想我"}, {"type": "subtitle", "time": 9074.309, "timestamp": "02:31:14", "text": "我觉得我们可以稍后再做这件事。"}, {"type": "subtitle", "time": 9075.83, "timestamp": "02:31:15", "text": "因为我觉得，我觉得越多"}, {"type": "subtitle", "time": 9077.349, "timestamp": "02:31:17", "text": "更重要的是，"}, {"type": "subtitle", "time": 9078.469, "timestamp": "02:31:18", "text": "教你如何实际操作"}, {"type": "subtitle", "time": 9081.99, "timestamp": "02:31:21", "text": "VT的其余部分。嗯，所有这些都是你的。"}, {"type": "subtitle", "time": 9084.309, "timestamp": "02:31:24", "text": "嗯，是你的"}, {"type": "subtitle", "time": 9086.55, "timestamp": "02:31:26", "text": "嗯，你能做的一切。但"}, {"type": "subtitle", "time": 9088.79, "timestamp": "02:31:28", "text": "如果你想要一点儿东西，那有点儿"}, {"type": "subtitle", "time": 9093.03, "timestamp": "02:31:33", "text": "更容易查看。呃，关于这个"}, {"type": "subtitle", "time": 9095.51, "timestamp": "02:31:35", "text": "左上角可以看到双重排序"}, {"type": "subtitle", "time": 9097.19, "timestamp": "02:31:37", "text": "图标在右侧。"}, {"type": "subtitle", "time": 9097.67, "timestamp": "02:31:37", "text": "呃"}, {"type": "subtitle", "time": 9099.59, "timestamp": "02:31:39", "text": "点击它就会显示类似这样的内容"}, {"type": "subtitle", "time": 9101.67, "timestamp": "02:31:41", "text": "兜帽。它会向你展示你可以在……上做什么"}, {"type": "subtitle", "time": 9103.91, "timestamp": "02:31:43", "text": "你喜欢行动之类的东西"}, {"type": "subtitle", "time": 9106.95, "timestamp": "02:31:46", "text": "那。还有，我忘了其实……"}, {"type": "subtitle", "time": 9109.429, "timestamp": "02:31:49", "text": "让你这么做。所以，如果你加倍"}, {"type": "subtitle", "time": 9113.19, "timestamp": "02:31:53", "text": "点击你的令牌，你应该会看到你的"}, {"type": "chat", "time": 9114.065, "timestamp": "02:31:54", "author": "@Victor-MrinMoy", "avatar": "https://yt4.ggpht.com/Gaz0C79q_RG4g0C-14BlD7DV4KSkdqrEdWKhEr9EeavJEbCjSnvHS0Wd2lGovXii5XhBOCaWnQ=s64-c-k-c0x00ffffff-no-rj", "message": "Hello there"}, {"type": "chat", "time": 9116.491, "timestamp": "02:31:56", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Victor MrinMoy [INVTuber]~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 9118.389, "timestamp": "02:31:58", "text": "呃，你叫什么来着？看看你的"}, {"type": "subtitle", "time": 9119.59, "timestamp": "02:31:59", "text": "呃，令牌"}]
[{"type": "subtitle", "time": 10742.23, "timestamp": "02:59:02", "text": "刷新一下。"}, {"type": "subtitle", "time": 10752.07, "timestamp": "02:59:12", "text": "如果我断线了，会有什么影响？"}, {"type": "subtitle", "time": 10753.59, "timestamp": "02:59:13", "text": "游戏玩法？"}, {"type": "subtitle", "time": 10755.59, "timestamp": "02:59:15", "text": "呃，不，不会的。您可以刷新页面。"}, {"type": "subtitle", "time": 10758.15, "timestamp": "02:59:18", "text": "随时刷新一下都不会有什么问题。"}, {"type": "subtitle", "time": 10761.11, "timestamp": "02:59:21", "text": "这样做其实不会有什么大作用。哦，是的"}, {"type": "subtitle", "time": 10763.59, "timestamp": "02:59:23", "text": "可以放在淋浴间之类的地方。"}, {"type": "subtitle", "time": 10765.03, "timestamp": "02:59:25", "text": "哦，"}, {"type": "subtitle", "time": 10766.55, "timestamp": "02:59:26", "text": "是的。是的。一切都很安全"}, {"type": "subtitle", "time": 10770.71, "timestamp": "02:59:30", "text": "只要我的电脑开机，它就会自动运行。"}, {"type": "subtitle", "time": 10774.55, "timestamp": "02:59:34", "text": "好的。政府商店。"}, {"type": "subtitle", "time": 10777.03, "timestamp": "02:59:37", "text": "呃，好的。"}, {"type": "subtitle", "time": 10784.79, "timestamp": "02:59:44", "text": "事情太多了。水壶梯。"}, {"type": "subtitle", "time": 10787.19, "timestamp": "02:59:47", "text": "是的，有很多。"}, {"type": "subtitle", "time": 10790.95, "timestamp": "02:59:50", "text": "纸。我的天啊。你可以买纸"}, {"type": "subtitle", "time": 10793.269, "timestamp": "02:59:53", "text": "什么？写信。"}, {"type": "subtitle", "time": 10794.71, "timestamp": "02:59:54", "text": "是的。"}, {"type": "subtitle", "time": 10797.11, "timestamp": "02:59:57", "text": "关系。"}]
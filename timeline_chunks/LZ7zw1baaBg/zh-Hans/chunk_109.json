[{"type": "subtitle", "time": 6541.109, "timestamp": "01:49:01", "text": "冻伤会带来不利的减益效果。"}, {"type": "subtitle", "time": 6543.35, "timestamp": "01:49:03", "text": "不要鞭打效用值，那就是你"}, {"type": "subtitle", "time": 6545.75, "timestamp": "01:49:05", "text": "可以把事情搞定"}, {"type": "subtitle", "time": 6548.229, "timestamp": "01:49:08", "text": "诸如此类的事情，然后还有其他事情。"}, {"type": "subtitle", "time": 6549.75, "timestamp": "01:49:09", "text": "例如，造成伤害的手段。"}, {"type": "subtitle", "time": 6551.59, "timestamp": "01:49:11", "text": "虫害导致它们随机移动。"}, {"type": "subtitle", "time": 6553.91, "timestamp": "01:49:13", "text": "方向"}, {"type": "subtitle", "time": 6556.47, "timestamp": "01:49:16", "text": "另一方面。抱歉。呃，哪个"}, {"type": "subtitle", "time": 6558.629, "timestamp": "01:49:18", "text": "哪个造成的伤害更大？"}, {"type": "subtitle", "time": 6560.629, "timestamp": "01:49:20", "text": "哦，比如如果你想要纯粹的伤害的话。"}, {"type": "subtitle", "time": 6563.109, "timestamp": "01:49:23", "text": "比如你的攻击，呃，类似这样"}, {"type": "subtitle", "time": 6565.43, "timestamp": "01:49:25", "text": "例如，毒液喷雾剂会造成 1d12 点伤害。"}, {"type": "subtitle", "time": 6568.229, "timestamp": "01:49:28", "text": "这相当于实际上是两倍"}, {"type": "subtitle", "time": 6570.07, "timestamp": "01:49:30", "text": "损坏，但它没有任何类似的东西"}, {"type": "subtitle", "time": 6572.149, "timestamp": "01:49:32", "text": "实际上并不会造成任何减益效果或"}, {"type": "subtitle", "time": 6574.47, "timestamp": "01:49:34", "text": "诸如此类的事情。"}, {"type": "subtitle", "time": 6577.27, "timestamp": "01:49:37", "text": "如果我选择荆棘网并带来"}, {"type": "subtitle", "time": 6579.189, "timestamp": "01:49:39", "text": "离我最近的敌人是谁？我的"}, {"type": "subtitle", "time": 6582.39, "timestamp": "01:49:42", "text": "队友呃，杀死敌人或"}, {"type": "subtitle", "time": 6585.669, "timestamp": "01:49:45", "text": "呃，这要看情况。嗯，我的意思是，是的，但只是"}, {"type": "subtitle", "time": 6587.75, "timestamp": "01:49:47", "text": "如果你和他们沟通的话。你告诉我"}, {"type": "subtitle", "time": 6589.75, "timestamp": "01:49:49", "text": "告诉他们这件事。"}, {"type": "subtitle", "time": 6594.31, "timestamp": "01:49:54", "text": "好的。好的。我的天啊。"}, {"type": "subtitle", "time": 6597.51, "timestamp": "01:49:57", "text": "等等，我该如何进行语音交流？哦"}]
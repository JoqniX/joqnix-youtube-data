[{"type": "subtitle", "time": 1807.269, "timestamp": "00:30:07", "text": "野蛮人？"}, {"type": "subtitle", "time": 1810.87, "timestamp": "00:30:10", "text": "哦，这太难了。好的。一名牧师治疗师"}, {"type": "subtitle", "time": 1811.51, "timestamp": "00:30:11", "text": "或许。"}, {"type": "subtitle", "time": 1814.23, "timestamp": "00:30:14", "text": "是的。就像机器人一样，只需轻轻一触"}, {"type": "subtitle", "time": 1829.51, "timestamp": "00:30:29", "text": "[音乐]"}, {"type": "subtitle", "time": 1842.87, "timestamp": "00:30:42", "text": "好的，和尚，好的。"}, {"type": "subtitle", "time": 1846.71, "timestamp": "00:30:46", "text": "尖叫。我得到了"}, {"type": "subtitle", "time": 1848.63, "timestamp": "00:30:48", "text": "等等，你得先喊出你的法术。"}, {"type": "subtitle", "time": 1849.51, "timestamp": "00:30:49", "text": "还有一些其他的东西。"}, {"type": "subtitle", "time": 1851.99, "timestamp": "00:30:51", "text": "不，你不需要。但就好像你这样做一样"}, {"type": "subtitle", "time": 1854.63, "timestamp": "00:30:54", "text": "请随意。如果你想感受自由。"}]
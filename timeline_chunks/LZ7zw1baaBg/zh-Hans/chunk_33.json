[{"type": "subtitle", "time": 1982.47, "timestamp": "00:33:02", "text": "就像你知道的，恢复生命值之类的东西。"}, {"type": "subtitle", "time": 1983.59, "timestamp": "00:33:03", "text": "就是这样。"}, {"type": "subtitle", "time": 1985.11, "timestamp": "00:33:05", "text": "啊"}, {"type": "subtitle", "time": 1988.389, "timestamp": "00:33:08", "text": "德鲁伊通常就像……"}, {"type": "subtitle", "time": 1990.549, "timestamp": "00:33:10", "text": "玩德鲁伊的人被安排在周围"}, {"type": "subtitle", "time": 1992.389, "timestamp": "00:33:12", "text": "就像墙壁的形状一样"}, {"type": "subtitle", "time": 1994.07, "timestamp": "00:33:14", "text": "基本上你可以变成"}, {"type": "subtitle", "time": 1996.71, "timestamp": "00:33:16", "text": "事物。呃，星环改变了你"}, {"type": "subtitle", "time": 2000.23, "timestamp": "00:33:20", "text": "又变了你的……呃，你又叫什么来着？"}, {"type": "subtitle", "time": 2005.43, "timestamp": "00:33:25", "text": "墙面形状像星星之类的东西。哦，"}, {"type": "subtitle", "time": 2006.63, "timestamp": "00:33:26", "text": "你你"}, {"type": "subtitle", "time": 2008.95, "timestamp": "00:33:28", "text": "等待。我觉得这很适合我。"}, {"type": "subtitle", "time": 2009.909, "timestamp": "00:33:29", "text": "是的。"}, {"type": "subtitle", "time": 2019.909, "timestamp": "00:33:39", "text": "如果你喜欢，如果你觉得可以的话……"}, {"type": "subtitle", "time": 2023.509, "timestamp": "00:33:43", "text": "或许会有合适的。那个"}, {"type": "subtitle", "time": 2026.23, "timestamp": "00:33:46", "text": "或许可行。呃，我又该怎么称呼你呢？"}, {"type": "subtitle", "time": 2029.269, "timestamp": "00:33:49", "text": "德鲁伊，然后是星辰之环。呃，如果"}, {"type": "subtitle", "time": 2030.71, "timestamp": "00:33:50", "text": "你有点担心，因为"}, {"type": "subtitle", "time": 2033.029, "timestamp": "00:33:53", "text": "德鲁伊是呃，德鲁伊可能稍微有点"}, {"type": "subtitle", "time": 2034.23, "timestamp": "00:33:54", "text": "之所以复杂，是因为你需要……"}, {"type": "subtitle", "time": 2036.47, "timestamp": "00:33:56", "text": "用 for 键跟踪三个星形方块"}, {"type": "subtitle", "time": 2038.149, "timestamp": "00:33:58", "text": "除非你不想，否则你无法展现你的野性形态。"}]
[{"type": "subtitle", "time": 68.55, "timestamp": "00:01:08", "text": "好的。欢迎各位。欢迎来到"}, {"type": "subtitle", "time": 71.51, "timestamp": "00:01:11", "text": "Joathon 第 134 天。"}, {"type": "subtitle", "time": 74.789, "timestamp": "00:01:14", "text": "欢迎，欢迎。嗯，请稍等片刻。"}, {"type": "subtitle", "time": 77.03, "timestamp": "00:01:17", "text": "我先开始，我们接下来要唱歌了。"}, {"type": "subtitle", "time": 80.07, "timestamp": "00:01:20", "text": "现在就赞美。稍等片刻。"}, {"type": "subtitle", "time": 89.749, "timestamp": "00:01:29", "text": "H."}, {"type": "subtitle", "time": 91.03, "timestamp": "00:01:31", "text": "哦，"}, {"type": "subtitle", "time": 92.71000000000001, "timestamp": "00:01:32", "text": "你好。"}, {"type": "subtitle", "time": 100.63, "timestamp": "00:01:40", "text": "之前跟你在一起，但我打断了你。"}, {"type": "subtitle", "time": 101.19, "timestamp": "00:01:41", "text": "再次。"}, {"type": "subtitle", "time": 104.63, "timestamp": "00:01:44", "text": "是啊，我也这么想。"}, {"type": "subtitle", "time": 108.22999999999999, "timestamp": "00:01:48", "text": "你说昨天大概是4点钟"}, {"type": "subtitle", "time": 110.38900000000001, "timestamp": "00:01:50", "text": "好的。然后我就想，“好吧。”然后"}, {"type": "subtitle", "time": 112.63, "timestamp": "00:01:52", "text": "我喜欢给你发聊天记录。然后我"}, {"type": "subtitle", "time": 116.31, "timestamp": "00:01:56", "text": "比如，“我觉得他又睡着了。”"}, {"type": "subtitle", "time": 118.149, "timestamp": "00:01:58", "text": "是的。"}, {"type": "subtitle", "time": 119.59, "timestamp": "00:01:59", "text": "你开始直播了吗？"}]
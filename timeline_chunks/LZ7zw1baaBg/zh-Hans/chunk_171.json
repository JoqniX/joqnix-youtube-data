[{"type": "subtitle", "time": 10261.19, "timestamp": "02:51:01", "text": "变成德鲁伊拥有的东西。"}, {"type": "subtitle", "time": 10263.349, "timestamp": "02:51:03", "text": "哦。"}, {"type": "subtitle", "time": 10266.71, "timestamp": "02:51:06", "text": "哦，等等。对不起。嗯，是的，我可以"}, {"type": "subtitle", "time": 10267.83, "timestamp": "02:51:07", "text": "你可以这样做，如果你"}, {"type": "subtitle", "time": 10268.309, "timestamp": "02:51:08", "text": "想。"}, {"type": "subtitle", "time": 10268.87, "timestamp": "02:51:08", "text": "好的。好的。"}, {"type": "subtitle", "time": 10271.99, "timestamp": "02:51:11", "text": "不过，这最终取决于你。"}, {"type": "subtitle", "time": 10272.71, "timestamp": "02:51:12", "text": "是的，"}, {"type": "subtitle", "time": 10275.11, "timestamp": "02:51:15", "text": "呃，就是易用性，对吧？"}, {"type": "subtitle", "time": 10277.19, "timestamp": "02:51:17", "text": "它会自动攻击我吗？还是我必须自己攻击？"}, {"type": "subtitle", "time": 10277.67, "timestamp": "02:51:17", "text": "命令它？"}, {"type": "subtitle", "time": 10280.63, "timestamp": "02:51:20", "text": "呃，不，那是，那是，呃，那实际上是"}, {"type": "subtitle", "time": 10282.71, "timestamp": "02:51:22", "text": "这不是攻击。那……呃，叫什么来着？"}, {"type": "subtitle", "time": 10284.469, "timestamp": "02:51:24", "text": "这本质上就是寻找。"}, {"type": "subtitle", "time": 10287.03, "timestamp": "02:51:27", "text": "熟悉的。它就像给你一只宠物一样。"}, {"type": "subtitle", "time": 10289.11, "timestamp": "02:51:29", "text": "本质上。宠物其实不能"}, {"type": "subtitle", "time": 10291.67, "timestamp": "02:51:31", "text": "攻击。它更像是一种侦察工具。"}, {"type": "subtitle", "time": 10295.269, "timestamp": "02:51:35", "text": "好吧，那没关系。"}, {"type": "subtitle", "time": 10298.52, "timestamp": "02:51:38", "text": "嗯，那我就这么做。"}, {"type": "subtitle", "time": 10301.349, "timestamp": "02:51:41", "text": "[音乐]"}, {"type": "subtitle", "time": 10319.99, "timestamp": "02:51:59", "text": "好的。你知道吗？患病的"}]
[{"type": "subtitle", "time": 3483.75, "timestamp": "00:58:03", "text": "你觉得呢？嗯，"}, {"type": "subtitle", "time": 3487.19, "timestamp": "00:58:07", "text": "让我看看。哦，不。是的。呃，那是你。"}, {"type": "subtitle", "time": 3488.87, "timestamp": "00:58:08", "text": "如果你指的是星界之火，"}, {"type": "subtitle", "time": 3490.95, "timestamp": "00:58:10", "text": "你选择那样做。你可以选择其中之一"}, {"type": "subtitle", "time": 3492.63, "timestamp": "00:58:12", "text": "智力、智慧或个人魅力。和"}, {"type": "subtitle", "time": 3494.23, "timestamp": "00:58:14", "text": "既然你是德鲁伊特人，你很可能会"}, {"type": "subtitle", "time": 3495.589, "timestamp": "00:58:15", "text": "选择智慧，因为那将是你最好的选择。"}, {"type": "subtitle", "time": 3498.15, "timestamp": "00:58:18", "text": "最高能力得分。"}, {"type": "subtitle", "time": 3500.15, "timestamp": "00:58:20", "text": "哦好的。好的。"}, {"type": "subtitle", "time": 3523.51, "timestamp": "00:58:43", "text": "防火。那是什么？火。"}, {"type": "subtitle", "time": 3525.75, "timestamp": "00:58:45", "text": "什么？火"}, {"type": "subtitle", "time": 3529.75, "timestamp": "00:58:49", "text": "堵塞。这是什么？"}, {"type": "subtitle", "time": 3533.51, "timestamp": "00:58:53", "text": "察觉魔法并伪装自己"}, {"type": "subtitle", "time": 3536.15, "timestamp": "00:58:56", "text": "此行业内的法术。"}, {"type": "subtitle", "time": 3537.829, "timestamp": "00:58:57", "text": "啊。"}]
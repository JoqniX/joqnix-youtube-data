[{"type": "subtitle", "time": 240.39, "timestamp": "00:04:00", "text": "学会了这首歌。就是那首歌"}, {"type": "subtitle", "time": 242.71, "timestamp": "00:04:02", "text": "你想多加练习。我当时"}, {"type": "subtitle", "time": 246.47, "timestamp": "00:04:06", "text": "伙计，我肯定你会这么做的"}, {"type": "subtitle", "time": 249.03, "timestamp": "00:04:09", "text": "能够成功，但感觉就像是"}, {"type": "subtitle", "time": 250.949, "timestamp": "00:04:10", "text": "这将会非常困难。我相当确定"}, {"type": "subtitle", "time": 252.71, "timestamp": "00:04:12", "text": "你肯定能唱出来，但是……"}, {"type": "subtitle", "time": 255.35, "timestamp": "00:04:15", "text": "真的非常非常难。那就像我的"}, {"type": "subtitle", "time": 256.629, "timestamp": "00:04:16", "text": "观点。"}, {"type": "subtitle", "time": 257.67, "timestamp": "00:04:17", "text": "是的，"}, {"type": "subtitle", "time": 258.789, "timestamp": "00:04:18", "text": "这是。"}, {"type": "subtitle", "time": 261.509, "timestamp": "00:04:21", "text": "是的，你可以开始练习了。"}, {"type": "subtitle", "time": 271.99, "timestamp": "00:04:31", "text": "你好。"}, {"type": "subtitle", "time": 274.79, "timestamp": "00:04:34", "text": "三、二、一。前五次"}, {"type": "subtitle", "time": 277.99, "timestamp": "00:04:37", "text": "没有歌也行，对吧？"}]
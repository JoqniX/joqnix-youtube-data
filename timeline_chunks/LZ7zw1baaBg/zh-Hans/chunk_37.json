[{"type": "subtitle", "time": 2220.39, "timestamp": "00:37:00", "text": "关于这方面有很多信息。这就像习俗一样"}, {"type": "subtitle", "time": 2223.19, "timestamp": "00:37:03", "text": "比如自制课程之类的。"}, {"type": "subtitle", "time": 2224.55, "timestamp": "00:37:04", "text": "好的。好的。"}, {"type": "subtitle", "time": 2225.829, "timestamp": "00:37:05", "text": "是的。"}, {"type": "subtitle", "time": 2228.95, "timestamp": "00:37:08", "text": "好的。等等，是哪个版本？什么"}, {"type": "subtitle", "time": 2230.71, "timestamp": "00:37:10", "text": "我应该玩哪个版本？"}, {"type": "subtitle", "time": 2231.349, "timestamp": "00:37:11", "text": "是的。"}, {"type": "subtitle", "time": 2234.39, "timestamp": "00:37:14", "text": "我们现在玩的是哪个版本？"}, {"type": "subtitle", "time": 2237.349, "timestamp": "00:37:17", "text": "嗯，我想这取决于你。"}, {"type": "subtitle", "time": 2240.87, "timestamp": "00:37:20", "text": "等待。呃，就像不，我们玩的DND游戏"}, {"type": "subtitle", "time": 2243.109, "timestamp": "00:37:23", "text": "正在做。我们现在玩的是哪个版本？"}, {"type": "subtitle", "time": 2244.95, "timestamp": "00:37:24", "text": "那？是一样的吗？"}, {"type": "subtitle", "time": 2246.15, "timestamp": "00:37:26", "text": "我们要玩吗？"}, {"type": "subtitle", "time": 2249.67, "timestamp": "00:37:29", "text": "什么版本？我们现在是哪个版本？是"}, {"type": "subtitle", "time": 2251.03, "timestamp": "00:37:31", "text": "是否有版本控制系统？"}, {"type": "subtitle", "time": 2253.67, "timestamp": "00:37:33", "text": "是的。是的。哦。哦，是的。呃版本"}, {"type": "subtitle", "time": 2258.069, "timestamp": "00:37:38", "text": "严格来说，它应该是D&D 5e，但是……"}, {"type": "subtitle", "time": 2261.03, "timestamp": "00:37:41", "text": "别担心。就像，呃，如果只是"}, {"type": "subtitle", "time": 2263.589, "timestamp": "00:37:43", "text": "坚持使用 PHP 24 版本应该就没问题了。"}, {"type": "subtitle", "time": 2264.79, "timestamp": "00:37:44", "text": "但如果你想玩类似这样的游戏"}, {"type": "subtitle", "time": 2266.71, "timestamp": "00:37:46", "text": "就像你，你知道你想要的那种人"}, {"type": "subtitle", "time": 2268.79, "timestamp": "00:37:48", "text": "技术上来说，巫师的一切"}, {"type": "subtitle", "time": 2271.67, "timestamp": "00:37:51", "text": "海岸还不错。但是，嗯，如果你明白"}, {"type": "subtitle", "time": 2273.43, "timestamp": "00:37:53", "text": "这意味着什么？"}, {"type": "subtitle", "time": 2275.349, "timestamp": "00:37:55", "text": "来自威世智的所有产品都是"}, {"type": "subtitle", "time": 2276.63, "timestamp": "00:37:56", "text": "好的。"}, {"type": "subtitle", "time": 2278.63, "timestamp": "00:37:58", "text": "但如果你真的不知道什么"}]
[{"type": "subtitle", "time": 8882.23, "timestamp": "02:28:02", "text": "等待。这是什么？呃，日语中文"}, {"type": "subtitle", "time": 8883.27, "timestamp": "02:28:03", "text": "一。"}, {"type": "subtitle", "time": 8885.27, "timestamp": "02:28:05", "text": "那是中国人。就是这样，就是这样，就是这样"}, {"type": "subtitle", "time": 8886.95, "timestamp": "02:28:06", "text": "什艾。"}, {"type": "subtitle", "time": 8889.429, "timestamp": "02:28:09", "text": "我的天啊。"}, {"type": "subtitle", "time": 8896.309, "timestamp": "02:28:16", "text": "我的天哪。"}, {"type": "subtitle", "time": 8898.389, "timestamp": "02:28:18", "text": "好的。"}, {"type": "subtitle", "time": 8901.83, "timestamp": "02:28:21", "text": "猫。所以，我打算教你如何"}, {"type": "subtitle", "time": 8903.03, "timestamp": "02:28:23", "text": "就像教你如何真正地"}, {"type": "subtitle", "time": 8906.63, "timestamp": "02:28:26", "text": "立即操作虚拟终端。嗯，让我想想。是的。"}, {"type": "subtitle", "time": 8909.03, "timestamp": "02:28:29", "text": "好的。是的。所以，如果你关闭"}, {"type": "subtitle", "time": 8911.349, "timestamp": "02:28:31", "text": "那个，还有，呃，关于那件事，你"}, {"type": "subtitle", "time": 8912.63, "timestamp": "02:28:32", "text": "现在应该可以看到您的令牌了。如果"}, {"type": "subtitle", "time": 8914.95, "timestamp": "02:28:34", "text": "你可以点击它。哦，就差一点。"}, {"type": "subtitle", "time": 8916.389, "timestamp": "02:28:36", "text": "那。关掉它。不用担心。只是"}, {"type": "subtitle", "time": 8919.03, "timestamp": "02:28:39", "text": "关闭它。哦，等等。等待。我只是"}, {"type": "subtitle", "time": 8921.19, "timestamp": "02:28:41", "text": "意识到我忘了点赞“让我快点”。"}, {"type": "subtitle", "time": 8924.15, "timestamp": "02:28:44", "text": "设置好这个。稍等片刻。嗯，等等"}, {"type": "subtitle", "time": 8925.67, "timestamp": "02:28:45", "text": "在。"}, {"type": "subtitle", "time": 8934.15, "timestamp": "02:28:54", "text": "红色这样做，然后让我来做"}, {"type": "subtitle", "time": 8937.59, "timestamp": "02:28:57", "text": "确保你的东西是"}, {"type": "subtitle", "time": 8939.429, "timestamp": "02:28:59", "text": "可见的。"}]
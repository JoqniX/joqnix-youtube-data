[{"type": "subtitle", "time": 10501.429, "timestamp": "02:55:01", "text": "一次敏捷豁免检定。所以我走了"}, {"type": "subtitle", "time": 10504.469, "timestamp": "02:55:04", "text": "我可以这样举个例子。"}, {"type": "subtitle", "time": 10507.67, "timestamp": "02:55:07", "text": "所以掷出了19点。19点比你的点数高。"}, {"type": "subtitle", "time": 10511.269, "timestamp": "02:55:11", "text": "法术安全难度等级为15。所以这家伙"}, {"type": "subtitle", "time": 10515.83, "timestamp": "02:55:15", "text": "目前不受该法术影响"}, {"type": "subtitle", "time": 10518.23, "timestamp": "02:55:18", "text": "因为它会覆盖你的数据中心。但如果它"}, {"type": "subtitle", "time": 10520.07, "timestamp": "02:55:20", "text": "如果他翻身压住，那就意味着他会得到"}, {"type": "subtitle", "time": 10522.63, "timestamp": "02:55:22", "text": "他的影响将被概括出来"}, {"type": "subtitle", "time": 10525.19, "timestamp": "02:55:25", "text": "使火和生物变得狂暴"}, {"type": "subtitle", "time": 10528.63, "timestamp": "02:55:28", "text": "由 furifier 概述的内容将包含攻击"}, {"type": "subtitle", "time": 10531.67, "timestamp": "02:55:31", "text": "对他们而言，他们将拥有优势。"}, {"type": "subtitle", "time": 10533.19, "timestamp": "02:55:33", "text": "哦"}, {"type": "subtitle", "time": 10536.23, "timestamp": "02:55:36", "text": "好的。所以，并不是“呃，我的回合结束了”，"}, {"type": "subtitle", "time": 10537.429, "timestamp": "02:55:37", "text": "正确的？"}, {"type": "subtitle", "time": 10539.59, "timestamp": "02:55:39", "text": "是的。哦，是的。呃，记住这一点。"}, {"type": "subtitle", "time": 10541.349, "timestamp": "02:55:41", "text": "自你激活以来，你的额外动作"}, {"type": "subtitle", "time": 10543.99, "timestamp": "02:55:43", "text": "弓箭手每回合都要激活它。"}, {"type": "subtitle", "time": 10545.91, "timestamp": "02:55:45", "text": "你可以在每次开机时激活它。"}, {"type": "subtitle", "time": 10547.349, "timestamp": "02:55:47", "text": "你的额外行动。"}, {"type": "subtitle", "time": 10547.59, "timestamp": "02:55:47", "text": "是的。"}, {"type": "subtitle", "time": 10549.269, "timestamp": "02:55:49", "text": "哦，我现在就可以做。"}, {"type": "subtitle", "time": 10551.03, "timestamp": "02:55:51", "text": "是的，可以。是的，你可以这样做。"}, {"type": "subtitle", "time": 10553.59, "timestamp": "02:55:53", "text": "攻击。好的。好的。这边"}, {"type": "subtitle", "time": 10555.03, "timestamp": "02:55:55", "text": "这里有双勾号。双人"}, {"type": "subtitle", "time": 10558.63, "timestamp": "02:55:58", "text": "勾号表示关键信息。所以，呃呃"}]
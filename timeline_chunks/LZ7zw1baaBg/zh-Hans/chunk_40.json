[{"type": "subtitle", "time": 2401.51, "timestamp": "00:40:01", "text": "再次。"}, {"type": "subtitle", "time": 2403.51, "timestamp": "00:40:03", "text": "我们正是在那个网站上决定的。"}, {"type": "subtitle", "time": 2405.43, "timestamp": "00:40:05", "text": "你的统计数据。我觉得这样可能会更容易"}, {"type": "subtitle", "time": 2407.349, "timestamp": "00:40:07", "text": "如果你是分享的那个人，那么我"}, {"type": "subtitle", "time": 2409.51, "timestamp": "00:40:09", "text": "就像我会看到你一样，这样我才能看到你"}, {"type": "subtitle", "time": 2411.19, "timestamp": "00:40:11", "text": "你做事。"}, {"type": "subtitle", "time": 2424.31, "timestamp": "00:40:24", "text": "好的。"}, {"type": "subtitle", "time": 2427.109, "timestamp": "00:40:27", "text": "让我看看。"}, {"type": "subtitle", "time": 2429.03, "timestamp": "00:40:29", "text": "好的。是的。好的。所以，这边呃"}, {"type": "subtitle", "time": 2431.589, "timestamp": "00:40:31", "text": "暂时先让比赛保持空置状态。嗯，"}, {"type": "subtitle", "time": 2433.829, "timestamp": "00:40:33", "text": "还有能力值，你想喜欢"}, {"type": "subtitle", "time": 2436.63, "timestamp": "00:40:36", "text": "把它往上移，直到你得到统计数据为止。"}, {"type": "subtitle", "time": 2440.069, "timestamp": "00:40:40", "text": "你觉得适合你的那种。"}, {"type": "subtitle", "time": 2441.829, "timestamp": "00:40:41", "text": "既然你玩的是德鲁伊，"}, {"type": "subtitle", "time": 2446.39, "timestamp": "00:40:46", "text": "一般来说，德鲁伊会运用大量的智慧。"}, {"type": "subtitle", "time": 2448.71, "timestamp": "00:40:48", "text": "呃，其他的取决于你如何……"}, {"type": "subtitle", "time": 2450.15, "timestamp": "00:40:50", "text": "其他方面则取决于你的意愿。"}, {"type": "subtitle", "time": 2451.75, "timestamp": "00:40:51", "text": "玩。"}, {"type": "subtitle", "time": 2455.43, "timestamp": "00:40:55", "text": "呃，我有27点能力值。好的。"}, {"type": "subtitle", "time": 2459.27, "timestamp": "00:40:59", "text": "您有 27 个积分可供使用"}]
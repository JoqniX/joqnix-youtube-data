[{"type": "subtitle", "time": 4920.31, "timestamp": "01:22:00", "text": "何か？ うん、えっと、"}, {"type": "subtitle", "time": 4925.669, "timestamp": "01:22:05", "text": "なんて言うんだっけ？"}, {"type": "subtitle", "time": 4928.629, "timestamp": "01:22:08", "text": "今日は、ずっと聞きたかった疑問とかを質問するためにサポートチケットを作ったんだ"}, {"type": "subtitle", "time": 4934.229, "timestamp": "01:22:14", "text": "。"}, {"type": "subtitle", "time": 4937.11, "timestamp": "01:22:17", "text": "このサミー関連のことで面白いのは、"}, {"type": "subtitle", "time": 4948.149, "timestamp": "01:22:28", "text": "Discordサーバーとか"}, {"type": "subtitle", "time": 4950.07, "timestamp": "01:22:30", "text": "サポートサーバーを開いた瞬間に、「"}, {"type": "subtitle", "time": 4952.39, "timestamp": "01:22:32", "text": "助けてください、これはうまくいきません」とか書いてスレッドを立てることなんだ。"}, {"type": "subtitle", "time": 4958.47, "timestamp": "01:22:38", "text": "スレッドとか"}, {"type": "subtitle", "time": 4962.55, "timestamp": "01:22:42", "text": "全部書き終えてEnterキーを押した後、頭の中で何かがカチッと音を立てて、「もっと"}, {"type": "subtitle", "time": 4971.59, "timestamp": "01:22:51", "text": "複雑にせずに別のやり方ができたのに」って思うんだ。それで、「ああ、なるほど」って思う。じゃあ、なんで"}, {"type": "subtitle", "time": 4979.27, "timestamp": "01:22:59", "text": "このスレッドを作ったんだろう。"}]
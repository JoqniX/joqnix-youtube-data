[{"type": "subtitle", "time": 2767.589, "timestamp": "00:46:07", "text": "これ？くそ、名前を忘れちまう"}, {"type": "subtitle", "time": 2769.51, "timestamp": "00:46:09", "text": "。何て"}, {"type": "subtitle", "time": 2771.589, "timestamp": "00:46:11", "text": "名前だったっけ？"}, {"type": "subtitle", "time": 2773.43, "timestamp": "00:46:13", "text": "今はパンフレットを売ってるだけだと思う"}, {"type": "subtitle", "time": 2775.19, "timestamp": "00:46:15", "text": "。"}, {"type": "subtitle", "time": 2780.069, "timestamp": "00:46:20", "text": "組織のためにパンフレットを配ってるわけじゃない。"}, {"type": "subtitle", "time": 2782.79, "timestamp": "00:46:22", "text": "理由は分からないけど、やってる。"}, {"type": "subtitle", "time": 2785.19, "timestamp": "00:46:25", "text": "お金は必要ない。ただ"}, {"type": "subtitle", "time": 2792.39, "timestamp": "00:46:32", "text": "手伝いもしてる"}, {"type": "subtitle", "time": 2795.03, "timestamp": "00:46:35", "text": "。"}, {"type": "subtitle", "time": 2797.19, "timestamp": "00:46:37", "text": "基本的にはそれだけ。"}, {"type": "subtitle", "time": 2819.03, "timestamp": "00:46:59", "text": "足りないと思ってる。"}]
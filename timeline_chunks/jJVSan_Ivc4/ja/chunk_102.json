[{"type": "subtitle", "time": 6122.149, "timestamp": "01:42:02", "text": "みんな忙しい。"}, {"type": "subtitle", "time": 6123.669, "timestamp": "01:42:03", "text": "みんな、みんなで一緒に遊べるような"}, {"type": "subtitle", "time": 6126.31, "timestamp": "01:42:06", "text": "ゲームを1つだけするために、みんなを呼び戻すべきだと思う"}, {"type": "subtitle", "time": 6128.87, "timestamp": "01:42:08", "text": "。"}, {"type": "subtitle", "time": 6131.35, "timestamp": "01:42:11", "text": "どんなプレイスタイル？"}, {"type": "subtitle", "time": 6135.189, "timestamp": "01:42:15", "text": "いいえ、まだ発売されていません。 ジョー、"}, {"type": "subtitle", "time": 6137.27, "timestamp": "01:42:17", "text": "そのゲームはまだ発売されていないよ。"}, {"type": "subtitle", "time": 6139.83, "timestamp": "01:42:19", "text": "昔のガンゲームが全部出てくるみたいだ。 私たちは"}, {"type": "subtitle", "time": 6141.43, "timestamp": "01:42:21", "text": "待たなければならなかった。 適切なタイミングを待たなければならない"}, {"type": "subtitle", "time": 6142.149, "timestamp": "01:42:22", "text": "。"}, {"type": "subtitle", "time": 6144.07, "timestamp": "01:42:24", "text": "待って、どの作品のことを言っているの？"}, {"type": "chat", "time": 6144.819, "timestamp": "01:42:24", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "bro can sandwich many people lol"}, {"type": "subtitle", "time": 6147.51, "timestamp": "01:42:27", "text": "あなたがやりたいゲームは、"}, {"type": "subtitle", "time": 6150.629, "timestamp": "01:42:30", "text": "いや、冗談じゃないよ。 いつか"}, {"type": "subtitle", "time": 6155.669, "timestamp": "01:42:35", "text": "昔の仲間全員が集まって"}, {"type": "subtitle", "time": 6156.87, "timestamp": "01:42:36", "text": "一緒に遊べるゲームがきっとあるだろうって言ってるだけだよ。"}, {"type": "subtitle", "time": 6159.43, "timestamp": "01:42:39", "text": "ああ、わかりました。 わかった。 わかった、わかった。"}, {"type": "subtitle", "time": 6166.87, "timestamp": "01:42:46", "text": "ガッチャ。 うん。"}, {"type": "subtitle", "time": 6170.07, "timestamp": "01:42:50", "text": "前回、"}, {"type": "subtitle", "time": 6174.87, "timestamp": "01:42:54", "text": "俺たちがグループでゲームをしたのはいつだったかな？確か、俺たちがゲームをしていた時はまだ"}, {"type": "subtitle", "time": 6176.709, "timestamp": "01:42:56", "text": "隔離期間中だったと思う"}]
[{"type": "subtitle", "time": 8760.95, "timestamp": "02:26:00", "text": "それに、"}, {"type": "subtitle", "time": 8764.71, "timestamp": "02:26:04", "text": "最近Um Musをプレイしていますか？   ああ"}, {"type": "subtitle", "time": 8768.23, "timestamp": "02:26:08", "text": "、なんて脳の腐敗だ。"}, {"type": "subtitle", "time": 8771.67, "timestamp": "02:26:11", "text": "脳の棒のことですか？ ああ、誰かが「"}, {"type": "subtitle", "time": 8773.75, "timestamp": "02:26:13", "text": "ああ、"}, {"type": "subtitle", "time": 8775.91, "timestamp": "02:26:15", "text": "ガチャゲームをプレイするのはこれが初めてだ」と言っているように聞こえる"}, {"type": "subtitle", "time": 8779.11, "timestamp": "02:26:19", "text": "。   一度"}, {"type": "subtitle", "time": 8782.16, "timestamp": "02:26:22", "text": "だけプレイしました。"}, {"type": "subtitle", "time": 8789.11, "timestamp": "02:26:29", "text": "？   それ"}, {"type": "subtitle", "time": 8791.59, "timestamp": "02:26:31", "text": "については話したくない。"}, {"type": "subtitle", "time": 8793.91, "timestamp": "02:26:33", "text": "どういう意味ですか？ 待って、何が起こったの？"}, {"type": "subtitle", "time": 8795.83, "timestamp": "02:26:35", "text": "どうしたの？"}, {"type": "subtitle", "time": 8805.67, "timestamp": "02:26:45", "text": "。"}, {"type": "subtitle", "time": 8809.83, "timestamp": "02:26:49", "text": "ああ、君はレコードを台無しにしたか何かだ。"}, {"type": "subtitle", "time": 8812.63, "timestamp": "02:26:52", "text": "いいえ、レースに勝つためには、女の子と一緒にいる"}, {"type": "subtitle", "time": 8815.11, "timestamp": "02:26:55", "text": "馬のような馬のステータスを上げる必要があります"}, {"type": "subtitle", "time": 8818.87, "timestamp": "02:26:58", "text": "。"}]
[{"type": "subtitle", "time": 1084.789, "timestamp": "00:18:04", "text": "うん。 今月、7月から、"}, {"type": "subtitle", "time": 1092.87, "timestamp": "00:18:12", "text": "配信用の適切なサムネイル作成などに集中できるよう、Joathonのフォーマットを変更しました。   私はそれをしなければならない"}, {"type": "subtitle", "time": 1096.15, "timestamp": "00:18:16", "text": "。 私はサムネイルを作るのが苦手です"}, {"type": "subtitle", "time": 1098.63, "timestamp": "00:18:18", "text": "。"}, {"type": "subtitle", "time": 1100.95, "timestamp": "00:18:20", "text": "大丈夫。 いい感じだよ、友よ。 私はただ"}, {"type": "subtitle", "time": 1102.47, "timestamp": "00:18:22", "text": "間抜けに見えるだけだ。 私が"}, {"type": "subtitle", "time": 1103.19, "timestamp": "00:18:23", "text": "言いたかったのはまさにそれです。"}, {"type": "subtitle", "time": 1105.11, "timestamp": "00:18:25", "text": "こんにちは。"}, {"type": "subtitle", "time": 1105.669, "timestamp": "00:18:25", "text": "でも、確かに"}, {"type": "subtitle", "time": 1109.19, "timestamp": "00:18:29", "text": "ここで間抜けに見えるのは私だけですね。   何てことだ"}, {"type": "subtitle", "time": 1111.19, "timestamp": "00:18:31", "text": "。 心配しないで。   私は"}, {"type": "subtitle", "time": 1115.83, "timestamp": "00:18:35", "text": "笑いそうになり、"}, {"type": "subtitle", "time": 1118.87, "timestamp": "00:18:38", "text": "口の中で自分の唾液が爆発しそうになった。"}, {"type": "subtitle", "time": 1121.11, "timestamp": "00:18:41", "text": "自分の唾液でむせたのが何だったの"}, {"type": "subtitle", "time": 1122.23, "timestamp": "00:18:42", "text": "？"}, {"type": "subtitle", "time": 1123.83, "timestamp": "00:18:43", "text": "うん。   一体"}, {"type": "subtitle", "time": 1130.87, "timestamp": "00:18:50", "text": "それはすごいことだ。"}, {"type": "subtitle", "time": 1133.43, "timestamp": "00:18:53", "text": "新たな恐怖が解き放たれた。 ちくしょう。 自分の唾液で窒息する"}, {"type": "subtitle", "time": 1135.99, "timestamp": "00:18:55", "text": "。 イエス。   何てことだ"}]
[{"type": "subtitle", "time": 2226.71, "timestamp": "00:37:06", "text": "夜遅くまで他のYouTuberの友達と話してたよね。いいことだよね。"}, {"type": "subtitle", "time": 2228.069, "timestamp": "00:37:08", "text": "冗談でしょ？"}, {"type": "subtitle", "time": 2232.95, "timestamp": "00:37:12", "text": "いや、えっと、なんて"}, {"type": "subtitle", "time": 2239.03, "timestamp": "00:37:19", "text": "言えばいいかな？やりたかったけど、やりたくなかった"}, {"type": "subtitle", "time": 2244.069, "timestamp": "00:37:24", "text": "。だって寝たかったし、彼らも寝てなかったし、起きてたから。"}, {"type": "subtitle", "time": 2247.91, "timestamp": "00:37:27", "text": "でも、優先順位を考えて、"}, {"type": "subtitle", "time": 2251.51, "timestamp": "00:37:31", "text": "明日でもいいよって言ったんだ。そしたら、"}, {"type": "subtitle", "time": 2253.67, "timestamp": "00:37:33", "text": "今できるって言われたから、「わかった、わかった」ってなったんだ。   「"}, {"type": "subtitle", "time": 2256.23, "timestamp": "00:37:36", "text": "ちょっとこれを見て、何が起きてるか確認して、"}, {"type": "subtitle", "time": 2260.23, "timestamp": "00:37:40", "text": "それからちょっと話そうかな」と言って、"}, {"type": "subtitle", "time": 2262.31, "timestamp": "00:37:42", "text": "私たちは話し続け、話し続け、午後"}, {"type": "subtitle", "time": 2269.03, "timestamp": "00:37:49", "text": "6時、いや午前6時になって、"}, {"type": "subtitle", "time": 2271.829, "timestamp": "00:37:51", "text": "私は話を終えました。午前6時というのは、"}, {"type": "subtitle", "time": 2274.15, "timestamp": "00:37:54", "text": "ほぼ"}]
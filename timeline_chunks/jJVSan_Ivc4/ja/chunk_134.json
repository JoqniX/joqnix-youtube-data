[{"type": "subtitle", "time": 8042.069, "timestamp": "02:14:02", "text": "まるで街灯みたいに建てたんじゃないのか、この"}, {"type": "subtitle", "time": 8044.149, "timestamp": "02:14:04", "text": "バカ！"}, {"type": "subtitle", "time": 8046.069, "timestamp": "02:14:06", "text": "そして、隣人"}, {"type": "subtitle", "time": 8048.069, "timestamp": "02:14:08", "text": "同士もあなたと親しくなれるはずです。 だから、"}, {"type": "subtitle", "time": 8050.55, "timestamp": "02:14:10", "text": "私の家族や私を知っている人たちは、"}, {"type": "subtitle", "time": 8053.189, "timestamp": "02:14:13", "text": "「家族はあなたに食事を与えていないの"}, {"type": "subtitle", "time": 8055.189, "timestamp": "02:14:15", "text": "？」と言うでしょう。"}, {"type": "subtitle", "time": 8059.75, "timestamp": "02:14:19", "text": "「えー、彼らは"}, {"type": "subtitle", "time": 8062.39, "timestamp": "02:14:22", "text": "あなたに食事を与えているの？ なんてこった。"}, {"type": "subtitle", "time": 8069.589, "timestamp": "02:14:29", "text": "それは本当に奇妙なことだよ。"}, {"type": "subtitle", "time": 8071.669, "timestamp": "02:14:31", "text": "近所の人が近づいてきて、"}, {"type": "subtitle", "time": 8073.189, "timestamp": "02:14:33", "text": "「家族は"}, {"type": "subtitle", "time": 8076.31, "timestamp": "02:14:36", "text": "あなたに食事を与えているの？」って聞くんだ。「おい、大丈夫か？」って。"}, {"type": "subtitle", "time": 8084.95, "timestamp": "02:14:44", "text": "そういうこともあるよ。」"}, {"type": "subtitle", "time": 8090.629, "timestamp": "02:14:50", "text": "。"}, {"type": "subtitle", "time": 8094.629, "timestamp": "02:14:54", "text": "車をしっかり固定するとか。残念だね。"}, {"type": "subtitle", "time": 8096.629, "timestamp": "02:14:56", "text": "そして彼は去った。"}, {"type": "subtitle", "time": 8097.669, "timestamp": "02:14:57", "text": "いや、"}, {"type": "subtitle", "time": 8099.03, "timestamp": "02:14:59", "text": "彼は戻ってきた。"}]
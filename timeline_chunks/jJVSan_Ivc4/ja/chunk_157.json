[{"type": "subtitle", "time": 9426.71, "timestamp": "02:37:06", "text": "動いたりするシーンがあるアニメを思い出させるよ。わからないと思う"}, {"type": "subtitle", "time": 9426.87, "timestamp": "02:37:06", "text": "。"}, {"type": "subtitle", "time": 9428.63, "timestamp": "02:37:08", "text": "もう少し文脈を教えてくれよ。わから"}, {"type": "subtitle", "time": 9431.99, "timestamp": "02:37:11", "text": "ない。"}, {"type": "subtitle", "time": 9435.27, "timestamp": "02:37:15", "text": "入手可能だった？"}, {"type": "subtitle", "time": 9437.91, "timestamp": "02:37:17", "text": "覚えてない。"}, {"type": "subtitle", "time": 9439.67, "timestamp": "02:37:19", "text": "別の世界で。"}, {"type": "subtitle", "time": 9441.59, "timestamp": "02:37:21", "text": "彼は今、悪魔と戦っている"}, {"type": "subtitle", "time": 9444.63, "timestamp": "02:37:24", "text": "。"}, {"type": "subtitle", "time": 9444.95, "timestamp": "02:37:24", "text": "つまり、"}, {"type": "subtitle", "time": 9445.83, "timestamp": "02:37:25", "text": "内なる悪魔。"}, {"type": "subtitle", "time": 9448.63, "timestamp": "02:37:28", "text": "いや、正直言って、こんなことは私には一度もなかった。"}, {"type": "subtitle", "time": 9451.83, "timestamp": "02:37:31", "text": "今日、私に何が起こっているの？"}, {"type": "subtitle", "time": 9453.67, "timestamp": "02:37:33", "text": "酔っているみたいだ。寝"}, {"type": "subtitle", "time": 9455.27, "timestamp": "02:37:35", "text": "酔いみたいだ。"}, {"type": "subtitle", "time": 9457.59, "timestamp": "02:37:37", "text": "そう、私たちは酔っている。"}, {"type": "subtitle", "time": 9459.349, "timestamp": "02:37:39", "text": "うん、"}, {"type": "subtitle", "time": 9461.67, "timestamp": "02:37:41", "text": "酔っ払ってる。"}, {"type": "subtitle", "time": 9464.309, "timestamp": "02:37:44", "text": "前回酔っ払った時は、"}, {"type": "subtitle", "time": 9467.51, "timestamp": "02:37:47", "text": "また手術を受けなきゃならなかったんだ。"}, {"type": "subtitle", "time": 9469.83, "timestamp": "02:37:49", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 9472.63, "timestamp": "02:37:52", "text": "階段から落ちて、"}, {"type": "subtitle", "time": 9476.71, "timestamp": "02:37:56", "text": "ワイングラスに頭をぶつけたんだ。"}, {"type": "subtitle", "time": 9478.23, "timestamp": "02:37:58", "text": "完璧に。冗談じゃないよ。"}]
[{"type": "subtitle", "time": 9603.19, "timestamp": "02:40:03", "text": "ええ、私たち二人とも、私たち全員が、"}, {"type": "subtitle", "time": 9605.51, "timestamp": "02:40:05", "text": "話が止まらない。彼は「"}, {"type": "subtitle", "time": 9607.03, "timestamp": "02:40:07", "text": "配信を終える」と言って、それからさらに"}, {"type": "subtitle", "time": 9610.309, "timestamp": "02:40:10", "text": "20分くらい話し続けている。"}, {"type": "subtitle", "time": 9613.83, "timestamp": "02:40:13", "text": "ええ、わかってる。"}, {"type": "subtitle", "time": 9626.23, "timestamp": "02:40:26", "text": "アウトロをくれよ。頼むよ。"}, {"type": "subtitle", "time": 9632.79, "timestamp": "02:40:32", "text": "、じゃあ配信を終えるよ。"}, {"type": "subtitle", "time": 9635.27, "timestamp": "02:40:35", "text": "ええ、いつでも終わらせることができる。ええ、"}, {"type": "subtitle", "time": 9638.79, "timestamp": "02:40:38", "text": "YouTubeを終わらせることができる。はい。わかった、"}, {"type": "subtitle", "time": 9641.429, "timestamp": "02:40:41", "text": "それから。ええ、"}, {"type": "subtitle", "time": 9645.03, "timestamp": "02:40:45", "text": "急な招待だったんですけど、"}, {"type": "subtitle", "time": 9647.349, "timestamp": "02:40:47", "text": "皆さん、見てくれてありがとう。"}, {"type": "subtitle", "time": 9649.349, "timestamp": "02:40:49", "text": "ええ、この人は寝る必要があるんです。"}, {"type": "subtitle", "time": 9651.429, "timestamp": "02:40:51", "text": "寝かせてあげましょう。戻ってきたら、それは"}, {"type": "subtitle", "time": 9654.15, "timestamp": "02:40:54", "text": "彼です。私が言いたいことはそれだけです。"}, {"type": "subtitle", "time": 9657.67, "timestamp": "02:40:57", "text": "割り込んでくれてありがとう。通りをカット。"}, {"type": "subtitle", "time": 9659.03, "timestamp": "02:40:59", "text": "ええ。こんにちは。こんにちは。"}]
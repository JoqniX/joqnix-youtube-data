[{"type": "subtitle", "time": 5281.83, "timestamp": "01:28:01", "text": "。私はこだわりが強くて、うまくいくようにしないといけない"}, {"type": "subtitle", "time": 5283.99, "timestamp": "01:28:03", "text": "。だから"}, {"type": "subtitle", "time": 5286.709, "timestamp": "01:28:06", "text": "粘り強く続ける。だから、たとえあなたが諦めても、"}, {"type": "subtitle", "time": 5295.03, "timestamp": "01:28:15", "text": "大丈夫。自分を責めないで。"}, {"type": "subtitle", "time": 5302.629, "timestamp": "01:28:22", "text": "あなたはただ、あなたらしくすればいい。あなたは"}, {"type": "subtitle", "time": 5304.149, "timestamp": "01:28:24", "text": "あなたらしくやってきたし、"}, {"type": "subtitle", "time": 5312.629, "timestamp": "01:28:32", "text": "うん。"}, {"type": "subtitle", "time": 5314.47, "timestamp": "01:28:34", "text": "そして、"}, {"type": "subtitle", "time": 5317.91, "timestamp": "01:28:37", "text": "最近はたくさんのことをできて嬉しいよ。"}, {"type": "subtitle", "time": 5320.95, "timestamp": "01:28:40", "text": "いいことだ。"}, {"type": "subtitle", "time": 5324.629, "timestamp": "01:28:44", "text": "だから、もっとやりたい気分なんだ。 これらの"}, {"type": "subtitle", "time": 5328.31, "timestamp": "01:28:48", "text": "クリエイティブな配信は苦痛を伴うかもしれませんが、"}, {"type": "subtitle", "time": 5332.629, "timestamp": "01:28:52", "text": "特にウェブサイト関連のことは早く終わらせて、ゆっくり休んで"}, {"type": "subtitle", "time": 5338.55, "timestamp": "01:28:58", "text": "ゲーム配信をもっとできるようにしたいと思っています。それは私がやらなければならないことです。"}]
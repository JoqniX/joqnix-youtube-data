[{"type": "subtitle", "time": 5881.75, "timestamp": "01:38:01", "text": "あなたはビッグ・ウォークを見たことがありますか？"}, {"type": "subtitle", "time": 5883.03, "timestamp": "01:38:03", "text": "長い道のり？ それは何ですか？"}, {"type": "subtitle", "time": 5885.51, "timestamp": "01:38:05", "text": "それが、私があなたと遊びたいゲームです。"}, {"type": "subtitle", "time": 5886.629, "timestamp": "01:38:06", "text": "ああ、"}, {"type": "subtitle", "time": 5888.629, "timestamp": "01:38:08", "text": "デスティ。   ただ、"}, {"type": "subtitle", "time": 5896.79, "timestamp": "01:38:16", "text": "。 それと、おそらくあなたが"}, {"type": "subtitle", "time": 5898.31, "timestamp": "01:38:18", "text": "言ったように、"}, {"type": "subtitle", "time": 5899.99, "timestamp": "01:38:19", "text": "マラソンもそうですね。 マラソンもプレイしたいです"}, {"type": "subtitle", "time": 5902.55, "timestamp": "01:38:22", "text": "。 私もあの別のゲームをプレイしたいです"}, {"type": "subtitle", "time": 5906.149, "timestamp": "01:38:26", "text": "。 それは何という名前でしたか？"}, {"type": "subtitle", "time": 5909.27, "timestamp": "01:38:29", "text": "Shroudがプレイしていたと思う。   私は"}, {"type": "subtitle", "time": 5912.39, "timestamp": "01:38:32", "text": "Destinyをプレイしたいです。 私は"}, {"type": "subtitle", "time": 5919.109, "timestamp": "01:38:39", "text": "。"}, {"type": "subtitle", "time": 5922.0, "timestamp": "01:38:42", "text": "あのゲームはクソだ。"}, {"type": "subtitle", "time": 5938.07, "timestamp": "01:38:58", "text": "最近の最新ゲームにはそれほど詳しくないんだ。"}]
[{"type": "subtitle", "time": 4085.349, "timestamp": "01:08:05", "text": "プロだよ。僕とソミは"}, {"type": "subtitle", "time": 4088.23, "timestamp": "01:08:08", "text": "ゲームの初心者だけど、"}, {"type": "subtitle", "time": 4091.19, "timestamp": "01:08:11", "text": "他の人たち、今は友達と一緒にプレイしているんだ。"}, {"type": "subtitle", "time": 4092.63, "timestamp": "01:08:12", "text": "だから、レベルアップしたんだ。"}, {"type": "subtitle", "time": 4097.03, "timestamp": "01:08:17", "text": "すごく怖かったよ。あのゲームをたくさんプレイしているからね。"}, {"type": "subtitle", "time": 4104.149, "timestamp": "01:08:24", "text": "今も怖い？だって、君は"}, {"type": "subtitle", "time": 4106.07, "timestamp": "01:08:26", "text": "怖いと思うよ。"}, {"type": "subtitle", "time": 4120.39, "timestamp": "01:08:40", "text": "痛みは"}, {"type": "subtitle", "time": 4123.269, "timestamp": "01:08:43", "text": "痛みだ。"}, {"type": "subtitle", "time": 4125.59, "timestamp": "01:08:45", "text": "ところで、最近何人と"}]
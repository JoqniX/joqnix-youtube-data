[{"type": "subtitle", "time": 4326.229, "timestamp": "01:12:06", "text": "私の声や、私がどのように"}, {"type": "subtitle", "time": 4330.87, "timestamp": "01:12:10", "text": "交流するかなどに基づいて、私が女の子だと思っていた。ええと、そして"}, {"type": "subtitle", "time": 4332.95, "timestamp": "01:12:12", "text": "彼女は私の"}, {"type": "subtitle", "time": 4335.43, "timestamp": "01:12:15", "text": "ピッチが高いことに本当に驚いていた。彼女はただそう"}, {"type": "subtitle", "time": 4336.63, "timestamp": "01:12:16", "text": "言っただけだ。"}, {"type": "subtitle", "time": 4339.03, "timestamp": "01:12:19", "text": "彼女はあなたをファンボーイとは呼ばなかった。"}, {"type": "subtitle", "time": 4340.55, "timestamp": "01:12:20", "text": "いや、"}, {"type": "subtitle", "time": 4347.35, "timestamp": "01:12:27", "text": "ファンボーイとか言うのは西洋人だけだ。"}, {"type": "subtitle", "time": 4351.03, "timestamp": "01:12:31", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 4370.229, "timestamp": "01:12:50", "text": "ドッグ、あなたはこの種の"}, {"type": "subtitle", "time": 4373.189, "timestamp": "01:12:53", "text": "声を有利に利用していないんだから。 おいおい。"}, {"type": "subtitle", "time": 4374.709, "timestamp": "01:12:54", "text": "声を有利にするってどういう意味"}, {"type": "subtitle", "time": 4376.55, "timestamp": "01:12:56", "text": "？"}, {"type": "subtitle", "time": 4379.51, "timestamp": "01:12:59", "text": "うん、ほら、"}]
[{"type": "subtitle", "time": 5041.91, "timestamp": "01:24:01", "text": "物事を複雑にしすぎるだけで、他の人の一日を台無しにする。まったく冗談だ。"}, {"type": "subtitle", "time": 5045.35, "timestamp": "01:24:05", "text": "ああ、私はそう言う。"}, {"type": "subtitle", "time": 5047.27, "timestamp": "01:24:07", "text": "ああ、"}, {"type": "subtitle", "time": 5049.99, "timestamp": "01:24:09", "text": "お母さんはただ何かを投稿して、"}, {"type": "subtitle", "time": 5052.07, "timestamp": "01:24:12", "text": "誰かが彼を助けようとしているのに、彼は"}, {"type": "subtitle", "time": 5060.47, "timestamp": "01:24:20", "text": "その男性は本当に"}, {"type": "subtitle", "time": 5063.43, "timestamp": "01:24:23", "text": "助けようとしているのに、今は混乱していて、"}, {"type": "subtitle", "time": 5065.35, "timestamp": "01:24:25", "text": "今、あなたたち二人は"}, {"type": "subtitle", "time": 5071.59, "timestamp": "01:24:31", "text": "でも、いや、それは"}, {"type": "subtitle", "time": 5074.79, "timestamp": "01:24:34", "text": "私の意見では妥当だと思う。"}, {"type": "subtitle", "time": 5087.99, "timestamp": "01:24:47", "text": "私がよくそうするのかわからない。それに気付いた。ずっと"}, {"type": "subtitle", "time": 5091.669, "timestamp": "01:24:51", "text": "気付いていた。わあ。なんてことだ。うん。"}]
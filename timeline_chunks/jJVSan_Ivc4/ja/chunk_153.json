[{"type": "subtitle", "time": 9183.03, "timestamp": "02:33:03", "text": "あの映画を見た後、"}, {"type": "subtitle", "time": 9185.59, "timestamp": "02:33:05", "text": "友達の一人にDMして、「おい、君は大切な存在だよ」って言ったのを覚えてる"}, {"type": "subtitle", "time": 9188.71, "timestamp": "02:33:08", "text": "。  「愛してるよ」って言ったら、彼は"}, {"type": "subtitle", "time": 9191.99, "timestamp": "02:33:11", "text": "「おい、死んじゃうのか？」って聞いてきたんだ。僕は"}, {"type": "subtitle", "time": 9193.51, "timestamp": "02:33:13", "text": "「いや、スーパーマンの"}, {"type": "subtitle", "time": 9195.75, "timestamp": "02:33:15", "text": "映画を見たところだよ」って答えた。「くそっ」って感じだった。 良い。 良い。"}, {"type": "subtitle", "time": 9199.83, "timestamp": "02:33:19", "text": "ありがとう。 私も愛してるよ。」わかった。"}, {"type": "subtitle", "time": 9204.23, "timestamp": "02:33:24", "text": "君たちに送ったよね？"}, {"type": "subtitle", "time": 9207.349, "timestamp": "02:33:27", "text": "君たちもそうできるよ。"}, {"type": "subtitle", "time": 9209.27, "timestamp": "02:33:29", "text": "スーパーを見た後、そうしたんだ。わかった"}, {"type": "subtitle", "time": 9215.99, "timestamp": "02:33:35", "text": "寝てるの？ ねえ、"}, {"type": "subtitle", "time": 9217.19, "timestamp": "02:33:37", "text": "仕事中に寝ちゃダメだよ。"}, {"type": "subtitle", "time": 9219.75, "timestamp": "02:33:39", "text": "すごく静かだったね。ごめん。"}, {"type": "subtitle", "time": 9222.23, "timestamp": "02:33:42", "text": "盗み聞きしてたんだ。何を"}, {"type": "subtitle", "time": 9228.469, "timestamp": "02:33:48", "text": "盗み聞きしてるのか想像しようとしたんだ。"}, {"type": "subtitle", "time": 9231.59, "timestamp": "02:33:51", "text": "マッスルズ。それで、何の話をしたんだっけ"}, {"type": "subtitle", "time": 9233.429, "timestamp": "02:33:53", "text": "？"}, {"type": "subtitle", "time": 9235.03, "timestamp": "02:33:55", "text": "ZZ"}, {"type": "subtitle", "time": 9237.27, "timestamp": "02:33:57", "text": "スーパーマンが"}, {"type": "subtitle", "time": 9239.91, "timestamp": "02:33:59", "text": "彼らに尋ねたんだ。30"}]
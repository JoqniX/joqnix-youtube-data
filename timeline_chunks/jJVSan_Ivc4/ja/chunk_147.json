[{"type": "subtitle", "time": 8821.03, "timestamp": "02:27:01", "text": "今日は何をしていましたか？   たった"}, {"type": "subtitle", "time": 8831.349, "timestamp": "02:27:11", "text": "あなたはすべての記事を読んでいたわけではないのですか"}, {"type": "subtitle", "time": 8833.51, "timestamp": "02:27:13", "text": "？"}, {"type": "subtitle", "time": 8836.309, "timestamp": "02:27:16", "text": "ええ、初心者の頃はそうでした。   なんてこった。   なんてこった。   ほら、"}, {"type": "subtitle", "time": 8844.55, "timestamp": "02:27:24", "text": "そのゲームを"}, {"type": "subtitle", "time": 8847.27, "timestamp": "02:27:27", "text": "4倍くらいで起動しても、1セッションを完了するのに30分くらいかかるんだよ。"}, {"type": "subtitle", "time": 8853.429, "timestamp": "02:27:33", "text": "競馬1レースで30分。冗談じゃないよ。"}, {"type": "subtitle", "time": 8859.51, "timestamp": "02:27:39", "text": "確かにそうなると思う。"}, {"type": "subtitle", "time": 8864.95, "timestamp": "02:27:44", "text": "レースの途中でスキップしても、まだ"}, {"type": "subtitle", "time": 8869.91, "timestamp": "02:27:49", "text": "時間がかかるんだ。だから、君はそれが気に入らなかったんだね"}, {"type": "subtitle", "time": 8876.15, "timestamp": "02:27:56", "text": "中毒性が高すぎる。 近づきたくない"}, {"type": "subtitle", "time": 8877.59, "timestamp": "02:27:57", "text": "。"}, {"type": "subtitle", "time": 8878.71, "timestamp": "02:27:58", "text": "ああ、それは"}]
[{"type": "subtitle", "time": 1740.71, "timestamp": "00:29:00", "text": "今"}, {"type": "subtitle", "time": 1743.43, "timestamp": "00:29:03", "text": "3作全部セールになってるんだ。"}, {"type": "subtitle", "time": 1745.75, "timestamp": "00:29:05", "text": "買っちゃおうかな。"}, {"type": "subtitle", "time": 1748.31, "timestamp": "00:29:08", "text": "責任ある人間にならなきゃ。"}, {"type": "subtitle", "time": 1751.35, "timestamp": "00:29:11", "text": "いつもオンラインでゲームを買っちゃいけないよ。そうしないと"}, {"type": "subtitle", "time": 1754.47, "timestamp": "00:29:14", "text": "君たちみたいになっちゃう。ところでバッファリングしてるね"}, {"type": "subtitle", "time": 1755.909, "timestamp": "00:29:15", "text": "。"}, {"type": "subtitle", "time": 1758.23, "timestamp": "00:29:18", "text": "待って、実際。"}, {"type": "subtitle", "time": 1761.029, "timestamp": "00:29:21", "text": "うん。バッファリングしてるのが見えてる。それとも僕の"}, {"type": "subtitle", "time": 1768.95, "timestamp": "00:29:28", "text": "もしバッファリングしてるなら、もし"}, {"type": "subtitle", "time": 1771.11, "timestamp": "00:29:31", "text": "バッファリングしてるなら、僕の理論は"}, {"type": "subtitle", "time": 1774.31, "timestamp": "00:29:34", "text": "正しい。これは壊れてる。待って、"}, {"type": "subtitle", "time": 1776.87, "timestamp": "00:29:36", "text": "バッファリングしてない。"}, {"type": "subtitle", "time": 1780.31, "timestamp": "00:29:40", "text": "一瞬バッファリングしてる。うん。"}, {"type": "subtitle", "time": 1783.909, "timestamp": "00:29:43", "text": "ちょっと待って。ああ、"}, {"type": "subtitle", "time": 1785.909, "timestamp": "00:29:45", "text": "ラグってるみたいだ。ああ、"}, {"type": "subtitle", "time": 1787.59, "timestamp": "00:29:47", "text": "バッファリングしてる。"}, {"type": "subtitle", "time": 1789.99, "timestamp": "00:29:49", "text": "ああ、いや、いや、いや、いや、いや。1分も"}, {"type": "subtitle", "time": 1797.99, "timestamp": "00:29:57", "text": "。"}]
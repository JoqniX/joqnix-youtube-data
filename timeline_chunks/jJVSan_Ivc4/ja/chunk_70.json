[{"type": "subtitle", "time": 4200.32, "timestamp": "01:10:00", "text": "ようこそ。 俺とジョックだけだよ、ほら、"}, {"type": "subtitle", "time": 4202.56, "timestamp": "01:10:02", "text": "俺とジョックだけだよ、ほら、 オリジナルメンバー、仲間たち、ほら、ただ自分たちの"}, {"type": "subtitle", "time": 4204.88, "timestamp": "01:10:04", "text": "オリジナルメンバー、仲間たち、ほら、ただ自分たちの ことをやってるだけさ。"}, {"type": "subtitle", "time": 4214.149, "timestamp": "01:10:14", "text": "そんなにバカなタイピングしてないことを願うよ。してるよ"}, {"type": "subtitle", "time": 4216.07, "timestamp": "01:10:16", "text": "。"}, {"type": "subtitle", "time": 4219.189, "timestamp": "01:10:19", "text": "うん、彼らはDNDに集中してるんだ。"}, {"type": "subtitle", "time": 4220.47, "timestamp": "01:10:20", "text": "うん、それはいいことだ。そして"}, {"type": "subtitle", "time": 4224.149, "timestamp": "01:10:24", "text": "誰もそれを見なかった。くそっ。"}, {"type": "subtitle", "time": 4228.47, "timestamp": "01:10:28", "text": "読み返したかどうかわからない。わから"}, {"type": "subtitle", "time": 4235.51, "timestamp": "01:10:35", "text": "読んでないと思うよ、だってトラブルに巻き込まれない限りはね"}, {"type": "subtitle", "time": 4239.03, "timestamp": "01:10:39", "text": "。"}, {"type": "subtitle", "time": 4241.91, "timestamp": "01:10:41", "text": "新世代の"}, {"type": "subtitle", "time": 4244.07, "timestamp": "01:10:44", "text": "人たちが言うように、料理されることになるよ。君はたくさんの"}, {"type": "subtitle", "time": 4245.91, "timestamp": "01:10:45", "text": "世代の言葉を知ってるよね。"}, {"type": "subtitle", "time": 4249.59, "timestamp": "01:10:49", "text": "新世代の人たち。そういうこと言ってるの"}, {"type": "subtitle", "time": 4251.83, "timestamp": "01:10:51", "text": "？わから"}, {"type": "subtitle", "time": 4257.11, "timestamp": "01:10:57", "text": "ない。専門"}, {"type": "subtitle", "time": 4259.91, "timestamp": "01:10:59", "text": "用語がたくさんあるんだ。"}]
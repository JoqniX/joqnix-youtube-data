[{"type": "subtitle", "time": 2528.55, "timestamp": "00:42:08", "text": "でも、私の意見では、とても面白いショットだった"}, {"type": "subtitle", "time": 2532.63, "timestamp": "00:42:12", "text": "。とても面白いクリップ。一体"}, {"type": "subtitle", "time": 2535.589, "timestamp": "00:42:15", "text": "誰がそんなことをするんだろう？誰がそんなことをするんだろう"}, {"type": "subtitle", "time": 2542.71, "timestamp": "00:42:22", "text": "ああ、"}, {"type": "subtitle", "time": 2548.55, "timestamp": "00:42:28", "text": "今月は本当にたくさんのことがあった。"}, {"type": "subtitle", "time": 2550.63, "timestamp": "00:42:30", "text": "素晴らしいこと。"}, {"type": "subtitle", "time": 2553.03, "timestamp": "00:42:33", "text": "楽しいこと。"}, {"type": "subtitle", "time": 2555.43, "timestamp": "00:42:35", "text": "楽しいことといえば、"}, {"type": "subtitle", "time": 2559.67, "timestamp": "00:42:39", "text": "趣味の仕事は何？さあ、何か教えてよ。"}, {"type": "subtitle", "time": 2565.67, "timestamp": "00:42:45", "text": "ほら、"}, {"type": "subtitle", "time": 2567.349, "timestamp": "00:42:47", "text": "君が何をしているのかたくさん聞いてきたんだ。何を言っているのか分から"}, {"type": "subtitle", "time": 2569.99, "timestamp": "00:42:49", "text": "ないけど、僕が"}, {"type": "subtitle", "time": 2571.99, "timestamp": "00:42:51", "text": "これらの"}, {"type": "subtitle", "time": 2572.79, "timestamp": "00:42:52", "text": "活動をしていることをみんなが言及している。"}, {"type": "subtitle", "time": 2574.63, "timestamp": "00:42:54", "text": "うん、君は言及したね。それでも僕は"}, {"type": "subtitle", "time": 2577.99, "timestamp": "00:42:57", "text": "聞き続けている。なぜか分からないけど。僕が"}]
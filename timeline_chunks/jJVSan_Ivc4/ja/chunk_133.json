[{"type": "subtitle", "time": 7980.95, "timestamp": "02:13:00", "text": "ここに呼ぶ予定はなかったんです。 私は嬉しい。 でも、あなたが"}, {"type": "subtitle", "time": 7982.149, "timestamp": "02:13:02", "text": "今ここにいてくれて嬉しいです。   よかったです"}, {"type": "subtitle", "time": 7983.95, "timestamp": "02:13:03", "text": "。"}, {"type": "subtitle", "time": 7988.629, "timestamp": "02:13:08", "text": "ええ、だって、"}, {"type": "subtitle", "time": 7989.83, "timestamp": "02:13:09", "text": "個人的には、首の"}, {"type": "subtitle", "time": 7991.91, "timestamp": "02:13:11", "text": "骨が折れたような感じだと思ったんです。"}, {"type": "subtitle", "time": 7994.629, "timestamp": "02:13:14", "text": "ああ、なんてことだ、彼は首が凝っている。   なんてこった。"}, {"type": "subtitle", "time": 7998.55, "timestamp": "02:13:18", "text": "首が凝っているのはなぜですか？何かあったのですか"}, {"type": "subtitle", "time": 7999.109, "timestamp": "02:13:19", "text": "？"}, {"type": "subtitle", "time": 8002.069, "timestamp": "02:13:22", "text": "知っている。 おそらく"}, {"type": "subtitle", "time": 8003.03, "timestamp": "02:13:23", "text": "寝ている時の姿勢が悪いのでしょう。   なんてこった。"}, {"type": "subtitle", "time": 8007.109, "timestamp": "02:13:27", "text": "ああ、神様。 でも彼はウェイトトレーニングをしていて、すごく筋肉隆々だったんです"}, {"type": "subtitle", "time": 8022.87, "timestamp": "02:13:42", "text": "一方、私は痩せている。 私は全く運動をしません。"}, {"type": "subtitle", "time": 8026.55, "timestamp": "02:13:46", "text": "俺たちみんな痩せてるんだよ。"}, {"type": "subtitle", "time": 8028.149, "timestamp": "02:13:48", "text": "自分が痩せていると言うのはやめなさい。"}, {"type": "subtitle", "time": 8031.27, "timestamp": "02:13:51", "text": "いいえ、私の家族です。 私の家族は、あなたの"}, {"type": "subtitle", "time": 8034.31, "timestamp": "02:13:54", "text": "棒とポーズみたいなものです。 あなたは食べないんですよね？   お前、"}]
[{"type": "subtitle", "time": 6541.43, "timestamp": "01:49:01", "text": "配信外でも試してみます"}, {"type": "subtitle", "time": 6543.189, "timestamp": "01:49:03", "text": "。 それがうまくいくかどうか試してみて、うまくいったらただ"}, {"type": "subtitle", "time": 6547.51, "timestamp": "01:49:07", "text": "プレイするだけです。"}, {"type": "subtitle", "time": 6547.91, "timestamp": "01:49:07", "text": "はい。"}, {"type": "subtitle", "time": 6550.709, "timestamp": "01:49:10", "text": "うん。"}, {"type": "subtitle", "time": 6552.31, "timestamp": "01:49:12", "text": "あと、私がどんなゲームをプレイしているかご存知なら、私はスパークリングゼロをプレイしています"}, {"type": "subtitle", "time": 6554.629, "timestamp": "01:49:14", "text": "。"}, {"type": "subtitle", "time": 6557.91, "timestamp": "01:49:17", "text": "火花ゼロ。 それは何ですか？"}, {"type": "subtitle", "time": 6560.55, "timestamp": "01:49:20", "text": "新しく発売されたドラゴンボールのゲームは、ひどく失敗に終わった"}, {"type": "subtitle", "time": 6564.55, "timestamp": "01:49:24", "text": "。"}, {"type": "subtitle", "time": 6570.47, "timestamp": "01:49:30", "text": "ドラゴンボールのゲームがあった。 おお。"}, {"type": "subtitle", "time": 6572.709, "timestamp": "01:49:32", "text": "ええ、発売当初はかなり人気だったんですが、"}, {"type": "subtitle", "time": 6575.27, "timestamp": "01:49:35", "text": "その後、"}, {"type": "subtitle", "time": 6578.07, "timestamp": "01:49:38", "text": "コナミが自分たちが"}, {"type": "subtitle", "time": 6580.95, "timestamp": "01:49:40", "text": "作っているものについてみんなに嘘をついていたことにみんなが気づいて、"}, {"type": "subtitle", "time": 6582.55, "timestamp": "01:49:42", "text": "それはみんなにとってひどい経験となり、みんなはそれを"}, {"type": "subtitle", "time": 6588.79, "timestamp": "01:49:48", "text": "買ったことで株をすべて失いました。"}, {"type": "subtitle", "time": 6595.83, "timestamp": "01:49:55", "text": "このゲームは1000万人が購入したのに、その後爆発的に売れなくなった。   とてつもなく"}, {"type": "subtitle", "time": 6597.99, "timestamp": "01:49:57", "text": "大きい。"}, {"type": "subtitle", "time": 6599.91, "timestamp": "01:49:59", "text": "これは史上最悪の格闘ゲームの一つだ"}]
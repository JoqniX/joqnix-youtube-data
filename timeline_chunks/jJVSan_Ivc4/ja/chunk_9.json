[{"type": "subtitle", "time": 543.19, "timestamp": "00:09:03", "text": "すごいことだと思いました。 それはやりすぎだと"}, {"type": "subtitle", "time": 546.31, "timestamp": "00:09:06", "text": "言う人もいるかもしれない。"}, {"type": "subtitle", "time": 548.47, "timestamp": "00:09:08", "text": "しかし、私たちは今ここにいる。 これまでに配信されたストリームはいくつありますか"}, {"type": "subtitle", "time": 550.31, "timestamp": "00:09:10", "text": "？ 何人くらいだと思いますか？"}, {"type": "subtitle", "time": 550.79, "timestamp": "00:09:10", "text": "138。138。"}, {"type": "subtitle", "time": 552.23, "timestamp": "00:09:12", "text": "うん。   なんてこった"}, {"type": "subtitle", "time": 554.87, "timestamp": "00:09:14", "text": "。"}, {"type": "subtitle", "time": 555.75, "timestamp": "00:09:15", "text": "ああ、私だったら"}, {"type": "subtitle", "time": 560.55, "timestamp": "00:09:20", "text": "配信を止めて寝るだろうな。"}, {"type": "subtitle", "time": 568.55, "timestamp": "00:09:28", "text": "、あなたのことを聞かせてください。"}, {"type": "subtitle", "time": 570.389, "timestamp": "00:09:30", "text": "最近はどう過ごしていますか？ 最近はずっと黙って"}, {"type": "subtitle", "time": 574.31, "timestamp": "00:09:34", "text": "あなたを見守っていたけれど"}, {"type": "subtitle", "time": 579.43, "timestamp": "00:09:39", "text": "。 ええと、見てみましょう。 うーん、"}, {"type": "subtitle", "time": 584.07, "timestamp": "00:09:44", "text": "最近はまあまあかな。 えっと、私が"}, {"type": "subtitle", "time": 586.79, "timestamp": "00:09:46", "text": "ワクワクしていることがいくつかあります。例えば、"}, {"type": "subtitle", "time": 590.15, "timestamp": "00:09:50", "text": "OBSからMelinaに切り替えました。"}, {"type": "subtitle", "time": 593.829, "timestamp": "00:09:53", "text": "それは私が決して予想していなかったことで、実際に"}]
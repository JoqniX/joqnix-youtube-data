[{"type": "subtitle", "time": 2580.63, "timestamp": "00:43:00", "text": "何をしているのか聞くべきだと思うんだけど"}, {"type": "subtitle", "time": 2584.069, "timestamp": "00:43:04", "text": "。うん。ここ数"}, {"type": "subtitle", "time": 2587.109, "timestamp": "00:43:07", "text": "ヶ月何をしていたの？うん、"}, {"type": "subtitle", "time": 2591.99, "timestamp": "00:43:11", "text": "考えていたんだ。"}, {"type": "subtitle", "time": 2595.43, "timestamp": "00:43:15", "text": "ベジータが、えーと、あのクソみたいな、何て言うんだっけ"}, {"type": "subtitle", "time": 2599.589, "timestamp": "00:43:19", "text": "？精神と時の部屋でトレーニングしているようにね。そう、クソみたいな精神と時の部屋で"}, {"type": "subtitle", "time": 2601.43, "timestamp": "00:43:21", "text": "。彼は"}, {"type": "subtitle", "time": 2603.75, "timestamp": "00:43:23", "text": "ただトレーニングしているだけ。僕もそうしてきたんだ。"}, {"type": "subtitle", "time": 2606.79, "timestamp": "00:43:26", "text": "ジムに行って、"}, {"type": "subtitle", "time": 2608.63, "timestamp": "00:43:28", "text": "歩いたり走ったりして、心肺機能を上げようとしています"}, {"type": "subtitle", "time": 2612.87, "timestamp": "00:43:32", "text": "。"}, {"type": "subtitle", "time": 2616.309, "timestamp": "00:43:36", "text": "少しでも筋肉をつけたいんです。というか、"}, {"type": "subtitle", "time": 2624.55, "timestamp": "00:43:44", "text": "スーパーマンを見てから、最近ちょっと人に優しくなりすぎているというか、なんて言えばいいのかな？ なんでか分からないんですけど"}, {"type": "subtitle", "time": 2626.47, "timestamp": "00:43:46", "text": "。"}, {"type": "subtitle", "time": 2626.95, "timestamp": "00:43:46", "text": "ええ。あとは、"}, {"type": "subtitle", "time": 2630.47, "timestamp": "00:43:50", "text": "基本的にアートとか、絵を"}, {"type": "subtitle", "time": 2633.109, "timestamp": "00:43:53", "text": "描いたり、"}, {"type": "subtitle", "time": 2635.75, "timestamp": "00:43:55", "text": "他の人を描いたり、仕事が休みの時はいつでもコミッションとかをやっています"}]
[{"type": "subtitle", "time": 2101.19, "timestamp": "00:35:01", "text": "。すごく静かだったんだ。D"}, {"type": "subtitle", "time": 2106.79, "timestamp": "00:35:06", "text": "&Dをやりたいと思った理由は、もっとロールプレイをしたり、"}, {"type": "subtitle", "time": 2112.95, "timestamp": "00:35:12", "text": "すぐに何かを思いついたり、状況に適応しようとしたり、"}, {"type": "subtitle", "time": 2116.71, "timestamp": "00:35:16", "text": "物語を作ったりしたかったからなんだ。"}, {"type": "subtitle", "time": 2119.349, "timestamp": "00:35:19", "text": "初日は大変だった。大変だった"}, {"type": "subtitle", "time": 2122.71, "timestamp": "00:35:22", "text": "けど、ベストを尽くしたと思う。"}, {"type": "subtitle", "time": 2129.51, "timestamp": "00:35:29", "text": "チーム全体、キャンペーン全体で、"}, {"type": "subtitle", "time": 2132.47, "timestamp": "00:35:32", "text": "自分の名前、Jocknを使っているのは自分だけだって気づいたから。他の人は"}, {"type": "subtitle", "time": 2135.91, "timestamp": "00:35:35", "text": "みんな自分のキャラクター名をつけていた。それで、"}, {"type": "subtitle", "time": 2139.67, "timestamp": "00:35:39", "text": "僕はJocknとして参加することにしたんだ。"}, {"type": "subtitle", "time": 2143.91, "timestamp": "00:35:43", "text": "うん、 僕は、ジョックニックとして行くつもりだった。"}, {"type": "subtitle", "time": 2144.71, "timestamp": "00:35:44", "text": "待って、僕は死んだ。"}, {"type": "subtitle", "time": 2147.109, "timestamp": "00:35:47", "text": "ああ、そうか。いやいやいや。君だったと思う"}, {"type": "subtitle", "time": 2148.63, "timestamp": "00:35:48", "text": "。僕だったと思う。さようなら。心配しないで。"}, {"type": "subtitle", "time": 2150.069, "timestamp": "00:35:50", "text": "何？いや"}, {"type": "subtitle", "time": 2151.829, "timestamp": "00:35:51", "text": "いやいや。ちょっとラグったから、君が僕と"}, {"type": "subtitle", "time": 2154.069, "timestamp": "00:35:54", "text": "プレイするつもりだと思ったんだ。うんうん。そうだね"}, {"type": "subtitle", "time": 2159.99, "timestamp": "00:35:59", "text": "。とにかく、そうだよ。うん、見たよ。"}]
[{"type": "subtitle", "time": 5820.79, "timestamp": "01:37:00", "text": "さよなら。"}, {"type": "subtitle", "time": 5822.31, "timestamp": "01:37:02", "text": "でも、心配しないでください。 心配しないで、"}, {"type": "subtitle", "time": 5823.51, "timestamp": "01:37:03", "text": "友よ。"}, {"type": "subtitle", "time": 5826.629, "timestamp": "01:37:06", "text": "心配しないで、友よ。   さあ行こう"}, {"type": "subtitle", "time": 5837.669, "timestamp": "01:37:17", "text": "うん。   どうぞ"}, {"type": "subtitle", "time": 5840.31, "timestamp": "01:37:20", "text": "。 働き続けましょう。   どうぞ"}, {"type": "subtitle", "time": 5843.189, "timestamp": "01:37:23", "text": "。 そうそう。 えっと、"}, {"type": "subtitle", "time": 5847.83, "timestamp": "01:37:27", "text": "新しいゲームは10月か9月頃に出るって言おうと思ってたんだけど。"}, {"type": "subtitle", "time": 5851.43, "timestamp": "01:37:31", "text": "Ubisoftに関しては、非常に多くの"}, {"type": "subtitle", "time": 5855.35, "timestamp": "01:37:35", "text": "反発がありました。 あれ。"}, {"type": "subtitle", "time": 5858.95, "timestamp": "01:37:38", "text": "マラトニアとは何だったのか？ マラソンゲーム。"}, {"type": "subtitle", "time": 5861.83, "timestamp": "01:37:41", "text": "ああ、あなたもそれを待っているのですか？"}, {"type": "subtitle", "time": 5864.709, "timestamp": "01:37:44", "text": "はい、私もブループロトコルの"}, {"type": "subtitle", "time": 5866.95, "timestamp": "01:37:46", "text": "スター共鳴を待っています。 まもなく"}, {"type": "subtitle", "time": 5868.07, "timestamp": "01:37:48", "text": "世界中で利用可能になります。"}, {"type": "subtitle", "time": 5869.109, "timestamp": "01:37:49", "text": "ああ、そうなんですか？"}, {"type": "subtitle", "time": 5871.43, "timestamp": "01:37:51", "text": "彼らはベータテストを実施しているのですが、私は"}, {"type": "subtitle", "time": 5878.07, "timestamp": "01:37:58", "text": "ビッグウォークを待ってるんだよ。"}]
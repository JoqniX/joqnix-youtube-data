[{"type": "subtitle", "time": 5761.27, "timestamp": "01:36:01", "text": "昨日まで待つか、"}, {"type": "subtitle", "time": 5764.55, "timestamp": "01:36:04", "text": "先月のジョアソンの配信コラボのように。"}, {"type": "subtitle", "time": 5767.35, "timestamp": "01:36:07", "text": "あなたはここにいますか？"}, {"type": "subtitle", "time": 5768.31, "timestamp": "01:36:08", "text": "私はここにいます。"}, {"type": "subtitle", "time": 5769.669, "timestamp": "01:36:09", "text": "あなたはここにいますか？"}, {"type": "subtitle", "time": 5769.99, "timestamp": "01:36:09", "text": "うん。"}, {"type": "subtitle", "time": 5771.75, "timestamp": "01:36:11", "text": "今は眠れていません。"}, {"type": "subtitle", "time": 5773.43, "timestamp": "01:36:13", "text": "あなたはここにいますか？"}, {"type": "subtitle", "time": 5776.87, "timestamp": "01:36:16", "text": "はい、ここにいます。"}, {"type": "subtitle", "time": 5777.59, "timestamp": "01:36:17", "text": "私はここにいます。"}, {"type": "subtitle", "time": 5779.189, "timestamp": "01:36:19", "text": "ええ、私が言っているのはジョアトンの件であって"}, {"type": "subtitle", "time": 5781.03, "timestamp": "01:36:21", "text": "、昨日のことではありません。"}, {"type": "subtitle", "time": 5783.189, "timestamp": "01:36:23", "text": "ああ、わかりました。 わかった。 わかった。 わかった。   上を見ろよ"}, {"type": "subtitle", "time": 5784.95, "timestamp": "01:36:24", "text": "。 上を見ろ。 来て。 来て。"}, {"type": "subtitle", "time": 5786.629, "timestamp": "01:36:26", "text": "俺たちはこれをやらなきゃいけないんだ。 あと"}, {"type": "subtitle", "time": 5788.55, "timestamp": "01:36:28", "text": "30分くらいで行けるよ"}, {"type": "subtitle", "time": 5790.07, "timestamp": "01:36:30", "text": "。 大丈夫です。 もう寝ていいよ。"}, {"type": "subtitle", "time": 5792.95, "timestamp": "01:36:32", "text": "心配しないで。 あと30分。 我々はそれを追うことができる"}, {"type": "subtitle", "time": 5796.07, "timestamp": "01:36:36", "text": "。   何てことだ"}, {"type": "subtitle", "time": 5806.31, "timestamp": "01:36:46", "text": "君ならできるよ。 君ならできるよ。 ご"}, {"type": "subtitle", "time": 5808.31, "timestamp": "01:36:48", "text": "心配なく。 大丈夫、できるよ。   でも、"}, {"type": "subtitle", "time": 5809.99, "timestamp": "01:36:49", "text": "少なくとも"}, {"type": "subtitle", "time": 5813.35, "timestamp": "01:36:53", "text": "2時間は通話しているんです。 だから、心配しないでください。"}, {"type": "subtitle", "time": 5815.109, "timestamp": "01:36:55", "text": "私たちは。"}]
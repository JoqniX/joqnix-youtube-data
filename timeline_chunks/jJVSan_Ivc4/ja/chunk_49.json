[{"type": "subtitle", "time": 2946.309, "timestamp": "00:49:06", "text": "コラボについてだけど、あと何人"}, {"type": "subtitle", "time": 2950.23, "timestamp": "00:49:10", "text": "コラボしようとしてるの？"}, {"type": "subtitle", "time": 2962.069, "timestamp": "00:49:22", "text": "えーと、"}, {"type": "subtitle", "time": 2965.51, "timestamp": "00:49:25", "text": "待って。えーと、わからない。"}, {"type": "subtitle", "time": 2968.23, "timestamp": "00:49:28", "text": "前のDNDのコラボは数える？ いや、いや、いや、"}, {"type": "subtitle", "time": 2972.95, "timestamp": "00:49:32", "text": "待って。今までのこと？それとも最近のこと？"}, {"type": "subtitle", "time": 2975.99, "timestamp": "00:49:35", "text": "コラボした人数ってどういう意味"}, {"type": "subtitle", "time": 2978.069, "timestamp": "00:49:38", "text": "？ 100人とか。それは"}, {"type": "subtitle", "time": 2980.87, "timestamp": "00:49:40", "text": "違う、ジョアソン自体からだよ。ただ"}, {"type": "subtitle", "time": 2982.069, "timestamp": "00:49:42", "text": "聞いてるだけ。"}, {"type": "subtitle", "time": 2985.67, "timestamp": "00:49:45", "text": "えーと100人くらいかも。うん。"}, {"type": "subtitle", "time": 2997.109, "timestamp": "00:49:57", "text": "不思議だね。じゃあ、"}, {"type": "subtitle", "time": 2999.43, "timestamp": "00:49:59", "text": "今後もっと期待してるの？それとも、ただ"}]
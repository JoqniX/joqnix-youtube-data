[{"type": "subtitle", "time": 3660.309, "timestamp": "01:01:00", "text": "セットをあなたに与えるべきだと思う。"}, {"type": "subtitle", "time": 3669.349, "timestamp": "01:01:09", "text": "自然のサイクルへの深い繋がり、"}, {"type": "subtitle", "time": 3672.47, "timestamp": "01:01:12", "text": "元素と動物の形態の力を操る能力"}, {"type": "subtitle", "time": 3674.15, "timestamp": "01:01:14", "text": "。そう、私は昨日蜘蛛になった"}, {"type": "subtitle", "time": 3677.589, "timestamp": "01:01:17", "text": "。私は昨日"}, {"type": "subtitle", "time": 3686.71, "timestamp": "01:01:26", "text": "蜘蛛を守らなければならない。私は蜘蛛になった。"}, {"type": "subtitle", "time": 3688.87, "timestamp": "01:01:28", "text": "スパイダーマンになれたかもしれないが、できなかった"}, {"type": "subtitle", "time": 3689.589, "timestamp": "01:01:29", "text": "。"}, {"type": "subtitle", "time": 3692.549, "timestamp": "01:01:32", "text": "ああ、そうだ。そして、あなたも自分の能力などをチェックするべきだ"}, {"type": "subtitle", "time": 3696.789, "timestamp": "01:01:36", "text": "。ドロイドがD&Dで何ができるかを"}, {"type": "subtitle", "time": 3705.829, "timestamp": "01:01:45", "text": "Dの映画見てないの？"}, {"type": "subtitle", "time": 3708.309, "timestamp": "01:01:48", "text": "まあ、D&Dの映画は、D&Dが本当はどういうものかを"}, {"type": "subtitle", "time": 3710.069, "timestamp": "01:01:50", "text": "伝えるにはちょっと悪い例だと思う"}, {"type": "subtitle", "time": 3711.829, "timestamp": "01:01:51", "text": "。"}, {"type": "subtitle", "time": 3715.109, "timestamp": "01:01:55", "text": "今夜見るよ。"}, {"type": "subtitle", "time": 3717.27, "timestamp": "01:01:57", "text": "時間の無駄だよ。寝て、"}]
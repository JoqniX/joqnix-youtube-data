[{"type": "subtitle", "time": 6611.75, "timestamp": "01:50:11", "text": "フランスパンについてどう思いますか？"}, {"type": "subtitle", "time": 6613.59, "timestamp": "01:50:13", "text": "何？"}, {"type": "subtitle", "time": 6617.83, "timestamp": "01:50:17", "text": "フランスパンについてどう思いますか？"}, {"type": "subtitle", "time": 6622.01, "timestamp": "01:50:22", "text": "私はフランス人であり、フランスパンそのものです。"}, {"type": "subtitle", "time": 6623.75, "timestamp": "01:50:23", "text": "【音楽】"}, {"type": "subtitle", "time": 6628.79, "timestamp": "01:50:28", "text": "確信しているってどういう意味ですか？ あなたがやる。   私が"}, {"type": "subtitle", "time": 6631.27, "timestamp": "01:50:31", "text": "自分の民族的背景を知らないとでも思っているの？ 何だって"}, {"type": "subtitle", "time": 6632.149, "timestamp": "01:50:32", "text": "？"}, {"type": "subtitle", "time": 6634.07, "timestamp": "01:50:34", "text": "ええ、気にしないでください"}, {"type": "subtitle", "time": 6636.629, "timestamp": "01:50:36", "text": "。 今、ただただ空想にふけって、そのことを"}, {"type": "subtitle", "time": 6642.709, "timestamp": "01:50:42", "text": "考えているところです。 あなたが"}, {"type": "subtitle", "time": 6645.43, "timestamp": "01:50:45", "text": "フランスの映画館のレストランにいて、"}, {"type": "subtitle", "time": 6652.629, "timestamp": "01:50:52", "text": "小さな家族のためにパンを配っている姿を想像しています。"}, {"type": "subtitle", "time": 6654.709, "timestamp": "01:50:54", "text": "ああ、それはあまりにも不自然に聞こえる。   何てことだ"}, {"type": "subtitle", "time": 6655.35, "timestamp": "01:50:55", "text": "。"}, {"type": "chat", "time": 6656.486, "timestamp": "01:50:56", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "i was not know he's french bread"}, {"type": "subtitle", "time": 6657.43, "timestamp": "01:50:57", "text": "良い意味で言っているのは分かっているけど、どうにも"}]
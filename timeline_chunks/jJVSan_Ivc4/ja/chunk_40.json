[{"type": "subtitle", "time": 2400.39, "timestamp": "00:40:00", "text": "お金をたくさん消費することになるから。 たぶん、"}, {"type": "subtitle", "time": 2404.87, "timestamp": "00:40:04", "text": "彼らは"}, {"type": "subtitle", "time": 2408.15, "timestamp": "00:40:08", "text": "物事をきちんと調べて、"}, {"type": "subtitle", "time": 2411.91, "timestamp": "00:40:11", "text": "記録しておかなかったんだと思う。それだけでなく、"}, {"type": "subtitle", "time": 2415.19, "timestamp": "00:40:15", "text": "たくさんの問題もあった。例えば、あの"}, {"type": "subtitle", "time": 2421.27, "timestamp": "00:40:21", "text": "騒動が起きてから、毎日"}, {"type": "subtitle", "time": 2423.829, "timestamp": "00:40:23", "text": "誰かが何か言ってきて、"}, {"type": "subtitle", "time": 2428.71, "timestamp": "00:40:28", "text": "火に油を注いでいるような感じだった。"}, {"type": "subtitle", "time": 2430.79, "timestamp": "00:40:30", "text": "ああ、実は、"}, {"type": "subtitle", "time": 2432.71, "timestamp": "00:40:32", "text": "そこで何が起こったのか知っている。実は"}, {"type": "subtitle", "time": 2435.99, "timestamp": "00:40:35", "text": "情報を持っている。"}, {"type": "subtitle", "time": 2440.23, "timestamp": "00:40:40", "text": "建物全体が燃えているのに、さらに"}, {"type": "subtitle", "time": 2442.23, "timestamp": "00:40:42", "text": "燃料を注ぐ必要はない、と周りにやって来るような人たちが嫌いだ。"}, {"type": "subtitle", "time": 2444.15, "timestamp": "00:40:44", "text": "大丈夫だよ。"}, {"type": "subtitle", "time": 2446.79, "timestamp": "00:40:46", "text": "燃えているんだから。そして彼らはただ"}, {"type": "subtitle", "time": 2448.87, "timestamp": "00:40:48", "text": "「ああ、そうだね」と言うだけだ。 私は全てが欲しい。"}, {"type": "subtitle", "time": 2453.589, "timestamp": "00:40:53", "text": "「ただ、ただ、ただ、ただ、この炎がしばらく燃え続けてほしい」と。そして、それは"}, {"type": "subtitle", "time": 2457.19, "timestamp": "00:40:57", "text": "しばらく燃え続けた。2日間、5日間、1"}, {"type": "subtitle", "time": 2458.95, "timestamp": "00:40:58", "text": "週間くらい。"}]
[{"type": "subtitle", "time": 5103.189, "timestamp": "01:25:03", "text": "正直に言うと。うん"}, {"type": "subtitle", "time": 5108.95, "timestamp": "01:25:08", "text": "うん。夕食は食べた？ 夕食の準備は全部済ませた。うん。うん"}, {"type": "subtitle", "time": 5111.91, "timestamp": "01:25:11", "text": "、したよ。だって君が"}, {"type": "subtitle", "time": 5113.99, "timestamp": "01:25:13", "text": "すごく時間がかかってたから。夕食を作って、"}, {"type": "subtitle", "time": 5116.87, "timestamp": "01:25:16", "text": "食べて、それから、"}, {"type": "subtitle", "time": 5119.27, "timestamp": "01:25:19", "text": "冗談抜きで。"}, {"type": "subtitle", "time": 5122.31, "timestamp": "01:25:22", "text": "うんちをして戻ってきたら、君はまだそこにいた。1"}, {"type": "subtitle", "time": 5138.31, "timestamp": "01:25:38", "text": "君はまだ遅刻だったよ、ジョック。まだ"}, {"type": "subtitle", "time": 5139.11, "timestamp": "01:25:39", "text": "遅刻だった。"}, {"type": "subtitle", "time": 5146.55, "timestamp": "01:25:46", "text": "さて、視聴者の皆さんのために"}, {"type": "subtitle", "time": 5148.87, "timestamp": "01:25:48", "text": "、私が話しているのは、彼と"}, {"type": "subtitle", "time": 5151.75, "timestamp": "01:25:51", "text": "私は彼の時間で7時にこれをやる予定だったということ"}, {"type": "subtitle", "time": 5154.79, "timestamp": "01:25:54", "text": "。つまり、"}, {"type": "subtitle", "time": 5158.47, "timestamp": "01:25:58", "text": "私の時間で3時か4時、"}]
[{"type": "subtitle", "time": 2640.069, "timestamp": "00:44:00", "text": "。"}, {"type": "subtitle", "time": 2643.99, "timestamp": "00:44:03", "text": "ええ。"}, {"type": "subtitle", "time": 2647.589, "timestamp": "00:44:07", "text": "今のところは、だいたいそんな感じです。"}, {"type": "subtitle", "time": 2650.15, "timestamp": "00:44:10", "text": "こうやってノートに書いてみると、すごくつまらない感じがします"}, {"type": "subtitle", "time": 2655.27, "timestamp": "00:44:15", "text": "。何もしていない。そう思っています。今はもっと何かをしようと"}, {"type": "subtitle", "time": 2665.109, "timestamp": "00:44:25", "text": "努力しているところです。"}, {"type": "subtitle", "time": 2672.23, "timestamp": "00:44:32", "text": "個人的には、自分自身を十分にやっていない、十分に働いていないと感じているので、"}, {"type": "subtitle", "time": 2684.23, "timestamp": "00:44:44", "text": "最近、確か2"}, {"type": "subtitle", "time": 2688.069, "timestamp": "00:44:48", "text": "日前だったと思いますが、そういう"}, {"type": "subtitle", "time": 2690.23, "timestamp": "00:44:50", "text": "救済団体に応募しました。 犬、子犬とか救助みたいなやつ、"}, {"type": "subtitle", "time": 2696.39, "timestamp": "00:44:56", "text": "知ってるでしょ、私も応募したと思う。だから今"}, {"type": "subtitle", "time": 2697.91, "timestamp": "00:44:57", "text": "返事を待ってるの"}]
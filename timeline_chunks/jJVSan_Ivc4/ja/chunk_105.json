[{"type": "subtitle", "time": 6301.03, "timestamp": "01:45:01", "text": "うん。"}, {"type": "subtitle", "time": 6306.229, "timestamp": "01:45:06", "text": "私はあの男が好きではない。"}, {"type": "subtitle", "time": 6307.83, "timestamp": "01:45:07", "text": "そして赤村もだめだ。 私は彼が好きではない"}, {"type": "subtitle", "time": 6310.709, "timestamp": "01:45:10", "text": "。"}, {"type": "subtitle", "time": 6313.75, "timestamp": "01:45:13", "text": "冗談です。 冗談だよ。"}, {"type": "chat", "time": 6313.883, "timestamp": "01:45:13", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "what games bread play?"}, {"type": "subtitle", "time": 6316.709, "timestamp": "01:45:16", "text": "もし誰かを好きになったとしたら、私は赤村さんを一番好きです。"}, {"type": "subtitle", "time": 6319.83, "timestamp": "01:45:19", "text": "彼の配信が大好きです。 ブレットはどんなゲームをプレイしますか？ ああ、なんてことだ。"}, {"type": "subtitle", "time": 6322.149, "timestamp": "01:45:22", "text": "この人は、"}, {"type": "subtitle", "time": 6325.43, "timestamp": "01:45:25", "text": "BRBストリーマーのようなジョアソンには参加していませんでした。 男よ、君はそこにいなかった。"}, {"type": "subtitle", "time": 6328.87, "timestamp": "01:45:28", "text": "あなたはあなたではなかった。 ああ。 ああ。"}, {"type": "subtitle", "time": 6333.83, "timestamp": "01:45:33", "text": "私が"}, {"type": "subtitle", "time": 6337.35, "timestamp": "01:45:37", "text": "休憩を取っていた間、ジョアソンの期間中、ブラッドがBRBの配信者だった。"}, {"type": "subtitle", "time": 6341.189, "timestamp": "01:45:41", "text": "私がどんな神聖な仕事をしていたかを知っている人たち。"}, {"type": "subtitle", "time": 6343.51, "timestamp": "01:45:43", "text": "ブラッドは以前Discordからゲーム配信をしていて、"}, {"type": "subtitle", "time": 6347.75, "timestamp": "01:45:47", "text": "私はそれを"}, {"type": "subtitle", "time": 6350.87, "timestamp": "01:45:50", "text": "Discordのフィードで配信していました。"}, {"type": "subtitle", "time": 6352.79, "timestamp": "01:45:52", "text": "当時、私はRivalsをプレイしていて、ご存知の通り、"}, {"type": "subtitle", "time": 6359.43, "timestamp": "01:45:59", "text": "2シーズン連続でグランドマスターでした。 さあ行こう。"}]
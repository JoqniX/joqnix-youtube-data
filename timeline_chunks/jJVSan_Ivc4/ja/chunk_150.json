[{"type": "subtitle", "time": 9001.349, "timestamp": "02:30:01", "text": "拍手が聞こえる？"}, {"type": "subtitle", "time": 9001.59, "timestamp": "02:30:01", "text": "いや、"}, {"type": "subtitle", "time": 9003.59, "timestamp": "02:30:03", "text": "君のために拍手していたんだ。"}, {"type": "subtitle", "time": 9005.83, "timestamp": "02:30:05", "text": "ああ、聞こえる？"}, {"type": "subtitle", "time": 9007.83, "timestamp": "02:30:07", "text": "いや、"}, {"type": "subtitle", "time": 9009.83, "timestamp": "02:30:09", "text": "何も聞こえない。僕の拍手が聞こえないの？"}, {"type": "subtitle", "time": 9013.349, "timestamp": "02:30:13", "text": "何だって？いや、"}, {"type": "subtitle", "time": 9016.469, "timestamp": "02:30:16", "text": "抑制は狂っている。君が拍手しなかったら、僕が拍手していたんだ"}, {"type": "subtitle", "time": 9018.87, "timestamp": "02:30:18", "text": "。"}, {"type": "subtitle", "time": 9021.67, "timestamp": "02:30:21", "text": "アルスが"}, {"type": "subtitle", "time": 9023.67, "timestamp": "02:30:23", "text": "ようやくそのペースに達したと思うから、君のために拍手していたんだ。"}, {"type": "subtitle", "time": 9026.79, "timestamp": "02:30:26", "text": "疲れすぎて アニメを見ろよ。"}, {"type": "subtitle", "time": 9030.309, "timestamp": "02:30:30", "text": "疲れた。こんなのもううんざりだ。"}, {"type": "subtitle", "time": 9032.95, "timestamp": "02:30:32", "text": "ああ、ここ数週間マンガもマヌアも読んでない"}, {"type": "subtitle", "time": 9035.27, "timestamp": "02:30:35", "text": "。"}, {"type": "subtitle", "time": 9038.15, "timestamp": "02:30:38", "text": "ああ、なんてこった。ああ、なんてこった。彼はその道を辿っている。"}, {"type": "subtitle", "time": 9040.64, "timestamp": "02:30:40", "text": "彼はその道を辿っている。 ああ、まさに2"}, {"type": "subtitle", "time": 9044.96, "timestamp": "02:30:44", "text": "ああ、まさに2 年前の俺だ。"}, {"type": "subtitle", "time": 9050.87, "timestamp": "02:30:50", "text": "まさに俺だ。"}, {"type": "subtitle", "time": 9052.07, "timestamp": "02:30:52", "text": "心配するな、"}, {"type": "subtitle", "time": 9054.07, "timestamp": "02:30:54", "text": "それを維持するために別の中毒を見つけるだろう。"}, {"type": "subtitle", "time": 9056.07, "timestamp": "02:30:56", "text": "心配するな。"}, {"type": "subtitle", "time": 9059.19, "timestamp": "02:30:59", "text": "俺は最近ゲームもやらない。"}]
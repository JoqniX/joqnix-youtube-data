[{"type": "subtitle", "time": 722.79, "timestamp": "00:12:02", "text": "。"}, {"type": "subtitle", "time": 724.87, "timestamp": "00:12:04", "text": "銀行口座の手続きは"}, {"type": "subtitle", "time": 728.949, "timestamp": "00:12:08", "text": "明日、月曜日までにはほぼ完了する予定です。"}, {"type": "subtitle", "time": 731.19, "timestamp": "00:12:11", "text": "銀行に行って状況を確認し、"}, {"type": "subtitle", "time": 734.87, "timestamp": "00:12:14", "text": "正式に口座を開設して"}, {"type": "subtitle", "time": 738.31, "timestamp": "00:12:18", "text": "入金できるようにしないといけないな。いや、"}, {"type": "subtitle", "time": 741.11, "timestamp": "00:12:21", "text": "YouTube の報酬、"}, {"type": "subtitle", "time": 743.75, "timestamp": "00:12:23", "text": "初めての YouTube の報酬を受け取ろうと思ってたんだ。 それから、"}, {"type": "subtitle", "time": 747.35, "timestamp": "00:12:27", "text": "Twitch と YouTube の支払いをまとめて"}, {"type": "subtitle", "time": 749.67, "timestamp": "00:12:29", "text": "銀行"}, {"type": "subtitle", "time": 753.35, "timestamp": "00:12:33", "text": "口座に入れて、できるかどうか確認します。いや、いや、待ってください。"}, {"type": "subtitle", "time": 756.069, "timestamp": "00:12:36", "text": "明日、口座を開設した後"}, {"type": "subtitle", "time": 758.23, "timestamp": "00:12:38", "text": "、UPI決済ができるかどうか確認する必要があるかもしれません"}, {"type": "subtitle", "time": 762.15, "timestamp": "00:12:42", "text": "。 私の本名が表示されるかどうか確認してください"}, {"type": "subtitle", "time": 766.23, "timestamp": "00:12:46", "text": "。 もしそうならなければ、"}, {"type": "subtitle", "time": 769.35, "timestamp": "00:12:49", "text": "おそらくそうはならないだろうが、まあそうだ。 えっと、あの、なんて"}, {"type": "subtitle", "time": 772.629, "timestamp": "00:12:52", "text": "言うんだっけ？"}, {"type": "subtitle", "time": 775.269, "timestamp": "00:12:55", "text": "請求書とかは、"}, {"type": "subtitle", "time": 778.949, "timestamp": "00:12:58", "text": "通常のUPI決済とかと同じように見えます"}]
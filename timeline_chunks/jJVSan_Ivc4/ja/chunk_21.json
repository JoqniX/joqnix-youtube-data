[{"type": "subtitle", "time": 1260.31, "timestamp": "00:21:00", "text": "ただぶらぶらして、話したり、"}, {"type": "subtitle", "time": 1263.669, "timestamp": "00:21:03", "text": "歩いたり、話したり、"}, {"type": "subtitle", "time": 1266.47, "timestamp": "00:21:06", "text": "ただのんびりしているだけです。   ここ"}, {"type": "subtitle", "time": 1272.95, "timestamp": "00:21:12", "text": "数ヶ月、あなたは"}, {"type": "subtitle", "time": 1283.669, "timestamp": "00:21:23", "text": "あなた自身も楽しんでいるでしょう。"}, {"type": "subtitle", "time": 1287.669, "timestamp": "00:21:27", "text": "コラボ曲も使わず、ただプレイするだけ。"}, {"type": "subtitle", "time": 1291.11, "timestamp": "00:21:31", "text": "ええ、ソロの"}, {"type": "subtitle", "time": 1293.909, "timestamp": "00:21:33", "text": "スピードランとかを見てました"}, {"type": "subtitle", "time": 1295.669, "timestamp": "00:21:35", "text": "。  「ああ、私にもできる"}, {"type": "subtitle", "time": 1299.029, "timestamp": "00:21:39", "text": "。私一人でゲームをクリアできる」と思ったんです。 そして"}, {"type": "subtitle", "time": 1301.35, "timestamp": "00:21:41", "text": "私は「よし、自分に挑戦してみよう。"}, {"type": "subtitle", "time": 1304.47, "timestamp": "00:21:44", "text": "そして実際にそれを達成した」と思った。   ちくしょう"}, {"type": "subtitle", "time": 1306.549, "timestamp": "00:21:46", "text": "。 私はあんな"}, {"type": "subtitle", "time": 1309.11, "timestamp": "00:21:49", "text": "夢を見る心の準備ができていなかった。 でも、"}, {"type": "subtitle", "time": 1311.83, "timestamp": "00:21:51", "text": "それは本当に素晴らしい。"}, {"type": "subtitle", "time": 1316.149, "timestamp": "00:21:56", "text": "それはとても素晴らしいことです。それは素晴らしいことですし、"}, {"type": "subtitle", "time": 1319.27, "timestamp": "00:21:59", "text": "失業中の人にとってもとても素晴らしいことです。 ねえ、それって"}]
[{"type": "subtitle", "time": 7274.709, "timestamp": "02:01:14", "text": "ビールを醸造できるゲームを見つけました。"}, {"type": "subtitle", "time": 7277.43, "timestamp": "02:01:17", "text": "ビールを醸造できますよ。"}, {"type": "subtitle", "time": 7279.669, "timestamp": "02:01:19", "text": "ええ、"}, {"type": "subtitle", "time": 7283.35, "timestamp": "02:01:23", "text": "中世のような、"}, {"type": "subtitle", "time": 7287.109, "timestamp": "02:01:27", "text": "中世の時代ですね。 そうだよ、君は"}, {"type": "subtitle", "time": 7289.669, "timestamp": "02:01:29", "text": "ビールを醸造したり、会議をしたり、"}, {"type": "subtitle", "time": 7291.27, "timestamp": "02:01:31", "text": "いろいろやってるんだね。"}, {"type": "subtitle", "time": 7301.669, "timestamp": "02:01:41", "text": "何という名前ですか？ それは"}, {"type": "subtitle", "time": 7303.589, "timestamp": "02:01:43", "text": "飲み物と呼ばれています。 それは中世風の飲み方と呼ばれている"}, {"type": "subtitle", "time": 7306.39, "timestamp": "02:01:46", "text": "。"}, {"type": "subtitle", "time": 7308.79, "timestamp": "02:01:48", "text": "文字通り、そういう名前なんです。"}, {"type": "subtitle", "time": 7310.39, "timestamp": "02:01:50", "text": "ええ、"}]
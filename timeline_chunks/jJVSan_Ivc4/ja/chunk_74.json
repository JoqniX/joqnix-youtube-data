[{"type": "subtitle", "time": 4440.149, "timestamp": "01:14:00", "text": "そういうことをしてほしいって思うようなやつ。"}, {"type": "subtitle", "time": 4443.35, "timestamp": "01:14:03", "text": "ああ、あなたの彼氏が"}, {"type": "subtitle", "time": 4446.149, "timestamp": "01:14:06", "text": "渓谷に落ちていくASMR。そういうのを見たことがあるでしょ？"}, {"type": "subtitle", "time": 4446.39, "timestamp": "01:14:06", "text": "物事？"}, {"type": "subtitle", "time": 4448.31, "timestamp": "01:14:08", "text": "なんてこった。POV"}, {"type": "subtitle", "time": 4450.39, "timestamp": "01:14:10", "text": "。君の彼女が、"}, {"type": "subtitle", "time": 4456.63, "timestamp": "01:14:16", "text": "クソ熱い油か"}, {"type": "subtitle", "time": 4457.59, "timestamp": "01:14:17", "text": "何かで3度火傷したんだ。"}, {"type": "subtitle", "time": 4460.149, "timestamp": "01:14:20", "text": "そして、ただ人が"}, {"type": "subtitle", "time": 4462.79, "timestamp": "01:14:22", "text": "叫んでいるだけ。私は、なんてこった、これはめちゃくちゃ"}, {"type": "subtitle", "time": 4472.229, "timestamp": "01:14:32", "text": "君はただPOVで、"}, {"type": "subtitle", "time": 4475.75, "timestamp": "01:14:35", "text": "カニエ・ウェストの曲を聴いていて、クラッシュしたんだ。"}, {"type": "subtitle", "time": 4480.39, "timestamp": "01:14:40", "text": "うわあ、それはクールだね。"}, {"type": "subtitle", "time": 4483.03, "timestamp": "01:14:43", "text": "あ、配達が来た。ちょっと待って"}, {"type": "subtitle", "time": 4492.07, "timestamp": "01:14:52", "text": "[音楽]"}, {"type": "subtitle", "time": 4498.47, "timestamp": "01:14:58", "text": "もっと状況に応じたASMRをやるべきだ。"}]
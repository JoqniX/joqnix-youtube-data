[{"type": "subtitle", "time": 9062.15, "timestamp": "02:31:02", "text": "俺もだ。そういう時、人はそれくらい"}, {"type": "subtitle", "time": 9081.67, "timestamp": "02:31:21", "text": "アニメを5時間ぶっ"}, {"type": "subtitle", "time": 9082.469, "timestamp": "02:31:22", "text": "通しで見ていたのを覚えている。5日間連続で。俺は"}, {"type": "subtitle", "time": 9085.59, "timestamp": "02:31:25", "text": "アニメを13"}, {"type": "subtitle", "time": 9087.83, "timestamp": "02:31:27", "text": "時間ぶっ通しで見ていたのを覚えている。"}, {"type": "subtitle", "time": 9091.91, "timestamp": "02:31:31", "text": "正直言って、君には何か問題があった。"}, {"type": "subtitle", "time": 9093.429, "timestamp": "02:31:33", "text": "その時、君には何か問題があったんだ"}, {"type": "subtitle", "time": 9095.11, "timestamp": "02:31:35", "text": "。まあ"}, {"type": "subtitle", "time": 9098.63, "timestamp": "02:31:38", "text": "、そうだと思うよ。"}, {"type": "subtitle", "time": 9100.79, "timestamp": "02:31:40", "text": "もし俺が学校のいじめっ子だったら、"}, {"type": "subtitle", "time": 9103.27, "timestamp": "02:31:43", "text": "その理由で君をいじめるだろう。"}, {"type": "subtitle", "time": 9105.19, "timestamp": "02:31:45", "text": "うわあ。わかった。うん"}, {"type": "subtitle", "time": 9107.99, "timestamp": "02:31:47", "text": "。それから俺は"}, {"type": "subtitle", "time": 9113.19, "timestamp": "02:31:53", "text": "アニメを全部見るのは大変だってわかってるから、思いっきりハグしてあげるよ。"}, {"type": "subtitle", "time": 9114.71, "timestamp": "02:31:54", "text": "えー、"}, {"type": "subtitle", "time": 9116.55, "timestamp": "02:31:56", "text": "どうしてアニメを13"}, {"type": "subtitle", "time": 9119.67, "timestamp": "02:31:59", "text": "時間ぶっ通しで見れるの？昔は見てたよ。"}]
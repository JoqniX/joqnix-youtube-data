[{"type": "subtitle", "time": 7506.149, "timestamp": "02:05:06", "text": "昔の"}, {"type": "subtitle", "time": 7508.629, "timestamp": "02:05:08", "text": "音楽って、憂鬱な音楽みたいな感じだよね。ほら、ゴス系の"}, {"type": "subtitle", "time": 7511.589, "timestamp": "02:05:11", "text": "音楽全部、"}, {"type": "subtitle", "time": 7513.75, "timestamp": "02:05:13", "text": "普通のティーンエイジャーがやってるようなやつ。"}, {"type": "subtitle", "time": 7521.27, "timestamp": "02:05:21", "text": "それと、ええ、"}, {"type": "subtitle", "time": 7524.39, "timestamp": "02:05:24", "text": "正直に言うと、それだけです。"}, {"type": "subtitle", "time": 7529.75, "timestamp": "02:05:29", "text": "最近は何でも聴いています。"}, {"type": "subtitle", "time": 7533.589, "timestamp": "02:05:33", "text": "なぜなら、何でもいい感じに聞こえるからです。"}, {"type": "subtitle", "time": 7536.229, "timestamp": "02:05:36", "text": "だから、ほら"}, {"type": "subtitle", "time": 7538.07, "timestamp": "02:05:38", "text": "、私は野蛮人みたいなものなのよ。"}, {"type": "subtitle", "time": 7545.669, "timestamp": "02:05:45", "text": "はい。 はい。 はい。 はい。"}, {"type": "subtitle", "time": 7548.229, "timestamp": "02:05:48", "text": "くそ。 アラスが、"}, {"type": "subtitle", "time": 7551.03, "timestamp": "02:05:51", "text": "私たちが彼を急かしていると思っているとしたら、彼は急いで来る必要はないので、彼が"}, {"type": "subtitle", "time": 7556.39, "timestamp": "02:05:56", "text": "来たとしても、そう思っていないことを願っています。"}, {"type": "subtitle", "time": 7557.03, "timestamp": "02:05:57", "text": "うん。"}, {"type": "subtitle", "time": 7559.43, "timestamp": "02:05:59", "text": "あなたはまだDM中に彼をイライラさせているのですか？"}]
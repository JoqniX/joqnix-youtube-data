[{"type": "subtitle", "time": 5940.95, "timestamp": "01:39:00", "text": "アーク・レイダーズ。 はい。 はい。 アーク・レイダーズ。"}, {"type": "subtitle", "time": 5947.109, "timestamp": "01:39:07", "text": "マラソンのようだ。"}, {"type": "subtitle", "time": 5950.39, "timestamp": "01:39:10", "text": "抽出シューティングゲームのような感じですね。"}, {"type": "subtitle", "time": 5953.109, "timestamp": "01:39:13", "text": "それと、"}, {"type": "subtitle", "time": 5955.03, "timestamp": "01:39:15", "text": "私のマイクから犬の声が聞こえますか？"}, {"type": "subtitle", "time": 5957.03, "timestamp": "01:39:17", "text": "はい、できます。 おそらく配信でも取り上げられるでしょう"}, {"type": "subtitle", "time": 5958.55, "timestamp": "01:39:18", "text": "。"}, {"type": "subtitle", "time": 5963.27, "timestamp": "01:39:23", "text": "今はプラグインを使っているので、ストリームには表示されていないと思います。 しかし、これは"}, {"type": "subtitle", "time": 5965.35, "timestamp": "01:39:25", "text": "プラグインしか使用できません。"}, {"type": "subtitle", "time": 5968.709, "timestamp": "01:39:28", "text": "いや、大丈夫だよ。 私はその犬が好きです。"}, {"type": "subtitle", "time": 5979.109, "timestamp": "01:39:39", "text": "ああ、10月13日に発売されるんだ。 くそ。"}, {"type": "subtitle", "time": 5981.99, "timestamp": "01:39:41", "text": "ああ、あと"}, {"type": "subtitle", "time": 5982.629, "timestamp": "01:39:42", "text": "2ヶ月か。"}, {"type": "subtitle", "time": 5984.149, "timestamp": "01:39:44", "text": "見た目がすごくかっこいい"}, {"type": "subtitle", "time": 5986.22, "timestamp": "01:39:46", "text": "ゲームというわけではなかった。"}, {"type": "subtitle", "time": 5996.07, "timestamp": "01:39:56", "text": "とてもかっこいいゲームですね。"}, {"type": "subtitle", "time": 5998.07, "timestamp": "01:39:58", "text": "そう、マラソンだ。 うん。"}]
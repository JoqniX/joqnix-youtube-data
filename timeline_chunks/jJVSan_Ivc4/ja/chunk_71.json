[{"type": "subtitle", "time": 4260.39, "timestamp": "01:11:00", "text": "そうだね。"}, {"type": "subtitle", "time": 4263.75, "timestamp": "01:11:03", "text": "君が、"}, {"type": "subtitle", "time": 4266.229, "timestamp": "01:11:06", "text": "君の日本人の友達が"}, {"type": "subtitle", "time": 4268.34, "timestamp": "01:11:08", "text": "「ああ、君は男だ」って言ったって聞いたから、すごくいいと思うんだ。"}, {"type": "subtitle", "time": 4269.51, "timestamp": "01:11:09", "text": "[音楽]"}, {"type": "subtitle", "time": 4272.55, "timestamp": "01:11:12", "text": "どう？それに、君の声を"}, {"type": "subtitle", "time": 4275.27, "timestamp": "01:11:15", "text": "聞くと、すごく"}, {"type": "subtitle", "time": 4277.669, "timestamp": "01:11:17", "text": "若く聞こえるんだよ"}, {"type": "subtitle", "time": 4278.95, "timestamp": "01:11:18", "text": "。"}, {"type": "subtitle", "time": 4282.55, "timestamp": "01:11:22", "text": "この男はクソみたいな 20."}, {"type": "subtitle", "time": 4285.51, "timestamp": "01:11:25", "text": "それは私の頭の中にある。そしてゆっくりと"}, {"type": "subtitle", "time": 4287.99, "timestamp": "01:11:27", "text": "確実に現実が"}, {"type": "subtitle", "time": 4289.75, "timestamp": "01:11:29", "text": "私の頭の周りにやってきて、それが包み込んで、"}, {"type": "subtitle", "time": 4292.709, "timestamp": "01:11:32", "text": "この男はめちゃくちゃ年寄りだと思い出す。ああ、なんてことだ"}, {"type": "subtitle", "time": 4296.229, "timestamp": "01:11:36", "text": "。そう、私は何百万年も"}, {"type": "subtitle", "time": 4297.75, "timestamp": "01:11:37", "text": "星座の年齢だ。"}, {"type": "subtitle", "time": 4309.35, "timestamp": "01:11:49", "text": "そうだ。そうだ。そうだ"}, {"type": "subtitle", "time": 4312.31, "timestamp": "01:11:52", "text": "。彼女にとってはショックだったと思う。"}, {"type": "subtitle", "time": 4315.11, "timestamp": "01:11:55", "text": "ええと、どうやら彼女にとっては、"}, {"type": "subtitle", "time": 4318.47, "timestamp": "01:11:58", "text": "私は何時間も男と話していたらしい。"}, {"type": "subtitle", "time": 4319.669, "timestamp": "01:11:59", "text": "誰がそんなことを？彼女は"}]
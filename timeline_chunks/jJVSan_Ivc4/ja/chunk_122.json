[{"type": "subtitle", "time": 7320.07, "timestamp": "02:02:00", "text": "プレイテストのようなものを見ました。つい先ほどアクセス権を取得しました"}, {"type": "subtitle", "time": 7321.189, "timestamp": "02:02:01", "text": "。"}, {"type": "subtitle", "time": 7326.47, "timestamp": "02:02:06", "text": "ああ、手に入れるまで2週間待たなければならなかったよ"}, {"type": "subtitle", "time": 7327.51, "timestamp": "02:02:07", "text": "。 ええ、確かに"}, {"type": "subtitle", "time": 7330.39, "timestamp": "02:02:10", "text": "ピクセルゲームですね。 でも、見た目はいいよ。"}, {"type": "subtitle", "time": 7333.99, "timestamp": "02:02:13", "text": "ピクセルゲーム。 いや、3Dだよ。"}, {"type": "subtitle", "time": 7336.79, "timestamp": "02:02:16", "text": "インドの試合。"}, {"type": "subtitle", "time": 7346.62, "timestamp": "02:02:26", "text": "いいえ、そうです。"}, {"type": "subtitle", "time": 7348.229, "timestamp": "02:02:28", "text": "[音楽] というわけで"}, {"type": "subtitle", "time": 7350.47, "timestamp": "02:02:30", "text": "、"}, {"type": "subtitle", "time": 7352.07, "timestamp": "02:02:32", "text": "もしウマムズメの"}, {"type": "subtitle", "time": 7355.03, "timestamp": "02:02:35", "text": "ゲームをプレイするつもりなら、ジョー、アニメを見てください。"}, {"type": "subtitle", "time": 7356.07, "timestamp": "02:02:36", "text": "それは良いです。"}, {"type": "subtitle", "time": 7356.709, "timestamp": "02:02:36", "text": "ええ、わかっています。"}, {"type": "subtitle", "time": 7358.39, "timestamp": "02:02:38", "text": "そして、一つ言っておきたいことがあります。"}, {"type": "subtitle", "time": 7361.669, "timestamp": "02:02:41", "text": "最新シーズンのアニメーションは"}, {"type": "subtitle", "time": 7363.83, "timestamp": "02:02:43", "text": "すごい。"}, {"type": "subtitle", "time": 7371.51, "timestamp": "02:02:51", "text": "それに関する動画をいくつか、もしくはいくつか見たことがあります。"}, {"type": "subtitle", "time": 7378.709, "timestamp": "02:02:58", "text": "白髪の女性。"}]
[{"type": "subtitle", "time": 5221.91, "timestamp": "01:27:01", "text": "そう書いていたとき、「"}, {"type": "subtitle", "time": 5224.95, "timestamp": "01:27:04", "text": "ああ、食事に行って戻ってきたら"}, {"type": "subtitle", "time": 5227.99, "timestamp": "01:27:07", "text": "パンが待っている」と思った。それで"}, {"type": "subtitle", "time": 5229.91, "timestamp": "01:27:09", "text": "私は メッセージを送ったよ、"}, {"type": "subtitle", "time": 5234.47, "timestamp": "01:27:14", "text": "うん、メッセージを送ったよ、それで走って"}, {"type": "subtitle", "time": 5239.59, "timestamp": "01:27:19", "text": "夕食を食べて戻ってきて、"}, {"type": "subtitle", "time": 5255.99, "timestamp": "01:27:35", "text": "うん、それが問題なんだ。"}, {"type": "subtitle", "time": 5259.91, "timestamp": "01:27:39", "text": "サブポートレートで話しているときは、"}, {"type": "subtitle", "time": 5262.87, "timestamp": "01:27:42", "text": "私の"}, {"type": "subtitle", "time": 5267.99, "timestamp": "01:27:47", "text": "質問や複雑すぎる痛みのせいで、相手が苦しむことになることに気づいた。"}, {"type": "subtitle", "time": 5270.709, "timestamp": "01:27:50", "text": "ああ、つまり、"}, {"type": "subtitle", "time": 5279.669, "timestamp": "01:27:59", "text": "物事に関して私がどんな感じか、もう知っているよね。私は「うん、うん、アイデアがたくさんある」って感じ"}]
[{"type": "subtitle", "time": 8341.91, "timestamp": "02:19:01", "text": "ああ。"}, {"type": "subtitle", "time": 8343.589, "timestamp": "02:19:03", "text": "本当に見てるのか。それは"}, {"type": "subtitle", "time": 8345.11, "timestamp": "02:19:05", "text": "いいな。ああ、なんてこった。それは、ああ"}, {"type": "subtitle", "time": 8347.19, "timestamp": "02:19:07", "text": "、君のPPを忘れてた。ああ"}, {"type": "subtitle", "time": 8350.549, "timestamp": "02:19:10", "text": "、彼女の名前は何だったっけ？"}, {"type": "subtitle", "time": 8352.389, "timestamp": "02:19:12", "text": "くそ。"}, {"type": "subtitle", "time": 8353.91, "timestamp": "02:19:13", "text": "ドゥ・フフ。"}, {"type": "subtitle", "time": 8357.669, "timestamp": "02:19:17", "text": "ジュ・フフ。そう。ヤギ。"}, {"type": "subtitle", "time": 8360.709, "timestamp": "02:19:20", "text": "おそらくZZで最高のキャラクター。"}, {"type": "subtitle", "time": 8363.19, "timestamp": "02:19:23", "text": "おそらくマナトの次だろう。もちろん。"}, {"type": "subtitle", "time": 8365.91, "timestamp": "02:19:25", "text": "アップデート"}, {"type": "subtitle", "time": 8367.589, "timestamp": "02:19:27", "text": "後。マナトの次。"}, {"type": "subtitle", "time": 8370.309, "timestamp": "02:19:30", "text": "そう、マントの次だ。だってあの男はああ、"}, {"type": "subtitle", "time": 8372.389, "timestamp": "02:19:32", "text": "あの少年はあの"}, {"type": "subtitle", "time": 8377.83, "timestamp": "02:19:37", "text": "マダガスカルの歌を聴いたことがあるか"}, {"type": "subtitle", "time": 8380.87, "timestamp": "02:19:40", "text": "？みんな知ってるだろ。私は"}, {"type": "subtitle", "time": 8383.27, "timestamp": "02:19:43", "text": "ぽっちゃりしたのが好きだ。彼が"}, {"type": "subtitle", "time": 8385.509, "timestamp": "02:19:45", "text": "好きだ。 大きい。君は"}, {"type": "subtitle", "time": 8388.549, "timestamp": "02:19:48", "text": "その曲を聴いたことがあるよね。"}, {"type": "subtitle", "time": 8391.67, "timestamp": "02:19:51", "text": "君はその曲をあの男に、"}, {"type": "subtitle", "time": 8396.15, "timestamp": "02:19:56", "text": "あの男にかけたんだ。ああ、なんてことだ。"}, {"type": "subtitle", "time": 8398.15, "timestamp": "02:19:58", "text": "汗が出てくるよ。"}]
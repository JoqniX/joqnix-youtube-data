[{"type": "subtitle", "time": 9123.59, "timestamp": "02:32:03", "text": "つまり、1シーズン12話で"}, {"type": "subtitle", "time": 9127.27, "timestamp": "02:32:07", "text": "5時間かかるんだ。今、"}, {"type": "subtitle", "time": 9129.349, "timestamp": "02:32:09", "text": "2つのシリーズを見始めたところ。"}, {"type": "subtitle", "time": 9135.27, "timestamp": "02:32:15", "text": "話すべきじゃないと思う。"}, {"type": "subtitle", "time": 9137.27, "timestamp": "02:32:17", "text": "えー、アニメを13時間ぶっ"}, {"type": "subtitle", "time": 9139.51, "timestamp": "02:32:19", "text": "通しで見てるの？恥ずかしいよ。スーパーマンの映画を見たとき、文字通り"}, {"type": "subtitle", "time": 9142.15, "timestamp": "02:32:22", "text": "6時間も無駄にしたんだ"}, {"type": "subtitle", "time": 9147.27, "timestamp": "02:32:27", "text": "。うわあ"}, {"type": "subtitle", "time": 9148.71, "timestamp": "02:32:28", "text": "。うん。"}, {"type": "subtitle", "time": 9152.95, "timestamp": "02:32:32", "text": "えー、映画1本で6時間も。"}, {"type": "subtitle", "time": 9154.95, "timestamp": "02:32:34", "text": "いやいやいやいや。車で"}, {"type": "subtitle", "time": 9158.87, "timestamp": "02:32:38", "text": "そこまで行って、待ってて、全部だよ、わかるでしょ、"}, {"type": "subtitle", "time": 9161.11, "timestamp": "02:32:41", "text": "全部。それから車で帰ってきて、"}, {"type": "subtitle", "time": 9163.75, "timestamp": "02:32:43", "text": "わかるでしょ、6時間かかったんだ。わかった"}, {"type": "subtitle", "time": 9165.59, "timestamp": "02:32:45", "text": "。"}, {"type": "subtitle", "time": 9167.91, "timestamp": "02:32:47", "text": "少なくとも楽しかったんでしょ？あの"}, {"type": "subtitle", "time": 9176.309, "timestamp": "02:32:56", "text": "日は別人だった。"}]
[{"type": "subtitle", "time": 6665.669, "timestamp": "01:51:05", "text": "それはあまりにも間違っているように聞こえる。 自分の仕事が好きです。"}, {"type": "subtitle", "time": 6668.149, "timestamp": "01:51:08", "text": "いや、ただ君が"}, {"type": "subtitle", "time": 6669.91, "timestamp": "01:51:09", "text": "何をしようとしているのかと言っているだけだよ。 なんでしょう"}, {"type": "subtitle", "time": 6670.47, "timestamp": "01:51:10", "text": "？"}, {"type": "subtitle", "time": 6673.59, "timestamp": "01:51:13", "text": "あなたはここで、パンのお客さんのために食べ物を作っているし、その他すべてのものを作っている"}, {"type": "subtitle", "time": 6675.669, "timestamp": "01:51:15", "text": "。 ここは"}, {"type": "subtitle", "time": 6683.35, "timestamp": "01:51:23", "text": "いいもの。 私はパンをパンに売っている。"}, {"type": "subtitle", "time": 6684.39, "timestamp": "01:51:24", "text": "パンはありません。"}, {"type": "subtitle", "time": 6685.189, "timestamp": "01:51:25", "text": "それはひどい。"}, {"type": "chat", "time": 6686.895, "timestamp": "01:51:26", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "💀"}, {"type": "subtitle", "time": 6687.99, "timestamp": "01:51:27", "text": "いいえ、あなたは売っているのです。"}, {"type": "subtitle", "time": 6689.35, "timestamp": "01:51:29", "text": "私は何を売っているのか？"}, {"type": "subtitle", "time": 6691.27, "timestamp": "01:51:31", "text": "あなたは"}, {"type": "subtitle", "time": 6691.83, "timestamp": "01:51:31", "text": "パンの上に別のものを売っている。"}, {"type": "subtitle", "time": 6693.91, "timestamp": "01:51:33", "text": "私は人間の臓器を売っているのか？"}, {"type": "subtitle", "time": 6696.149, "timestamp": "01:51:36", "text": "人間の遺体をパン屋に売る"}, {"type": "subtitle", "time": 6699.27, "timestamp": "01:51:39", "text": "。 私はまるで人間の肉屋か"}, {"type": "subtitle", "time": 6702.39, "timestamp": "01:51:42", "text": "何かだ。 ああ、兄弟。 今、この話題はあちこちで広まっている"}, {"type": "subtitle", "time": 6704.39, "timestamp": "01:51:44", "text": "。 ジョー。"}, {"type": "subtitle", "time": 6707.669, "timestamp": "01:51:47", "text": "それでは、ジャムおじさんに会いましょう。"}, {"type": "subtitle", "time": 6711.669, "timestamp": "01:51:51", "text": "ああ、神様。 一体どういうことだ？   一体何の"}, {"type": "subtitle", "time": 6714.79, "timestamp": "01:51:54", "text": "話をしてるんだ？"}, {"type": "subtitle", "time": 6717.669, "timestamp": "01:51:57", "text": "あなたは何について話しているのですか？"}]
[{"type": "subtitle", "time": 2164.55, "timestamp": "00:36:04", "text": "君はドルイドだったよね？"}, {"type": "subtitle", "time": 2167.27, "timestamp": "00:36:07", "text": "えっと、スタードルイド。スタードルイド。そう"}, {"type": "subtitle", "time": 2170.069, "timestamp": "00:36:10", "text": "、スタードルイド。オーケー。オーケー。うん。"}, {"type": "subtitle", "time": 2172.069, "timestamp": "00:36:12", "text": "オーケー。個人的には"}, {"type": "subtitle", "time": 2174.95, "timestamp": "00:36:14", "text": "D&Dについてあまり詳しくないけど、"}, {"type": "subtitle", "time": 2177.51, "timestamp": "00:36:17", "text": "自分の名前とかを作るっていうのはわかるよ。"}, {"type": "subtitle", "time": 2180.47, "timestamp": "00:36:20", "text": "君を見たとき、彼の名前ドロップ？"}, {"type": "subtitle", "time": 2182.95, "timestamp": "00:36:22", "text": "オーケーって感じだった。"}, {"type": "subtitle", "time": 2184.87, "timestamp": "00:36:24", "text": "あと、あの配信でちょっと元気がないように見えたよね"}, {"type": "subtitle", "time": 2186.63, "timestamp": "00:36:26", "text": "。"}, {"type": "subtitle", "time": 2189.67, "timestamp": "00:36:29", "text": "疲れてるってこと？"}, {"type": "subtitle", "time": 2192.39, "timestamp": "00:36:32", "text": "うん。ちょっと疲れてるよね。ちょっと"}, {"type": "subtitle", "time": 2194.23, "timestamp": "00:36:34", "text": "眠そう。眠そう。"}, {"type": "subtitle", "time": 2195.349, "timestamp": "00:36:35", "text": "うん。"}, {"type": "subtitle", "time": 2196.63, "timestamp": "00:36:36", "text": "君はそんな感じだったよね。"}, {"type": "subtitle", "time": 2200.87, "timestamp": "00:36:40", "text": "いや、待って。もっと うん、ほとんど"}, {"type": "subtitle", "time": 2202.95, "timestamp": "00:36:42", "text": "寝てなかったから"}, {"type": "subtitle", "time": 2204.47, "timestamp": "00:36:44", "text": "コラボのために寝ちゃったんだ。"}, {"type": "subtitle", "time": 2210.23, "timestamp": "00:36:50", "text": "コラボが始まる5分くらい前に目が覚めたから、"}, {"type": "subtitle", "time": 2213.19, "timestamp": "00:36:53", "text": "30分前の準備のVCには参加できなかった"}, {"type": "subtitle", "time": 2214.87, "timestamp": "00:36:54", "text": "。"}, {"type": "subtitle", "time": 2216.55, "timestamp": "00:36:56", "text": "うん、"}, {"type": "subtitle", "time": 2217.75, "timestamp": "00:36:57", "text": "大変だったよ。それから、それから、それから、"}]
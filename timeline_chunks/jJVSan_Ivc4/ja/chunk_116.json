[{"type": "subtitle", "time": 6960.47, "timestamp": "01:56:00", "text": "。"}, {"type": "subtitle", "time": 6963.27, "timestamp": "01:56:03", "text": "冗談じゃないよ。"}, {"type": "subtitle", "time": 6965.75, "timestamp": "01:56:05", "text": "冗談じゃないですよ。 彼女はそのジョークに"}, {"type": "subtitle", "time": 6968.79, "timestamp": "01:56:08", "text": "10分くらい笑い続けた。 何てことだ。"}, {"type": "subtitle", "time": 6971.189, "timestamp": "01:56:11", "text": "そして彼女は10分間ずっとクスクス笑っていた"}, {"type": "subtitle", "time": 6973.91, "timestamp": "01:56:13", "text": "。 冗談じゃないですよ。 私はとても"}, {"type": "subtitle", "time": 6975.27, "timestamp": "01:56:15", "text": "腹が立った。"}, {"type": "subtitle", "time": 6977.589, "timestamp": "01:56:17", "text": "いえいえ、"}, {"type": "subtitle", "time": 6979.51, "timestamp": "01:56:19", "text": "そのコメントには全く気分を害していませんよ。"}, {"type": "subtitle", "time": 6981.91, "timestamp": "01:56:21", "text": "ゼンがその"}, {"type": "subtitle", "time": 6985.109, "timestamp": "01:56:25", "text": "ジョークに10分間も笑っていたことに、私は腹が立った。"}, {"type": "subtitle", "time": 6985.589, "timestamp": "01:56:25", "text": "ああ、"}, {"type": "subtitle", "time": 6987.51, "timestamp": "01:56:27", "text": "10分ですね。   近親"}, {"type": "subtitle", "time": 6990.31, "timestamp": "01:56:30", "text": "交配のジョークに思わず笑ってしまった。   どのような"}, {"type": "subtitle", "time": 6993.589, "timestamp": "01:56:33", "text": "？"}, {"type": "subtitle", "time": 6995.589, "timestamp": "01:56:35", "text": "人間ってやつだよ。 クソみたいな人間ども。 これは、これは、"}, {"type": "subtitle", "time": 6997.589, "timestamp": "01:56:37", "text": "私が"}, {"type": "subtitle", "time": 6999.669, "timestamp": "01:56:39", "text": "人々のためにファンアートを作った結果、近親"}, {"type": "subtitle", "time": 7001.99, "timestamp": "01:56:41", "text": "交配者と呼ばれるようになったということです。   なんてこった。"}, {"type": "subtitle", "time": 7005.99, "timestamp": "01:56:45", "text": "そして、僕がジョックのためにエモートを作ると、ジョックは"}, {"type": "subtitle", "time": 7007.91, "timestamp": "01:56:47", "text": "「ああ、"}, {"type": "subtitle", "time": 7010.55, "timestamp": "01:56:50", "text": "お前を食べてやるよ」って言うんだ。 何だって？ これが"}, {"type": "subtitle", "time": 7012.229, "timestamp": "01:56:52", "text": "私の結果か？"}, {"type": "subtitle", "time": 7012.87, "timestamp": "01:56:52", "text": "いいえ。"}]
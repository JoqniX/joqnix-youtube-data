[{"type": "subtitle", "time": 782.31, "timestamp": "00:13:02", "text": "。 それから、たぶん明日の"}, {"type": "subtitle", "time": 786.069, "timestamp": "00:13:06", "text": "月曜日に、"}, {"type": "subtitle", "time": 791.91, "timestamp": "00:13:11", "text": "月曜日か火曜日に、"}, {"type": "subtitle", "time": 798.31, "timestamp": "00:13:18", "text": "UPI決済があるって言う特別な配信をしようと思う。"}, {"type": "subtitle", "time": 800.15, "timestamp": "00:13:20", "text": "メンバーシップ配信をした時のことを覚えてる？ いや、それと似たようなもので、何か"}, {"type": "subtitle", "time": 807.11, "timestamp": "00:13:27", "text": "お祝いの時に開けたものだったりするんだ"}, {"type": "subtitle", "time": 809.91, "timestamp": "00:13:29", "text": "。 わからない。 でも、"}, {"type": "subtitle", "time": 821.59, "timestamp": "00:13:41", "text": "グッズストアやその他すべてのものが"}, {"type": "subtitle", "time": 835.269, "timestamp": "00:13:55", "text": "、まさにそんな感じだよ。"}, {"type": "subtitle", "time": 837.99, "timestamp": "00:13:57", "text": "それで、ええと"}]
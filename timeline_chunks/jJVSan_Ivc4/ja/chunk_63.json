[{"type": "subtitle", "time": 3781.51, "timestamp": "01:03:01", "text": "うん、僕は偵察チーム探索"}, {"type": "subtitle", "time": 3784.309, "timestamp": "01:03:04", "text": "チームだったんだ。ああ、そうだね。彼らはまだお"}, {"type": "subtitle", "time": 3788.95, "timestamp": "01:03:08", "text": "スミもそこにいた。"}, {"type": "subtitle", "time": 3790.47, "timestamp": "01:03:10", "text": "今、他の誰かが空いている。"}, {"type": "subtitle", "time": 3792.63, "timestamp": "01:03:12", "text": "うん、あそこはそういう感じなんだ"}, {"type": "subtitle", "time": 3796.15, "timestamp": "01:03:16", "text": "。バカって入力して、そのまま"}, {"type": "subtitle", "time": 3804.309, "timestamp": "01:03:24", "text": "でも彼女は配信してないと思う。"}, {"type": "subtitle", "time": 3811.75, "timestamp": "01:03:31", "text": "いや、気にしない。その人のチャットに入力してるんだ。なんてこった。"}, {"type": "subtitle", "time": 3813.349, "timestamp": "01:03:33", "text": "待って、他に誰がいるの？実際、"}, {"type": "subtitle", "time": 3814.309, "timestamp": "01:03:34", "text": "知ってる？確認させて。"}, {"type": "subtitle", "time": 3817.75, "timestamp": "01:03:37", "text": "アルーはいる？ハンハンはいる？"}, {"type": "subtitle", "time": 3819.829, "timestamp": "01:03:39", "text": "アラクって誰だよ？"}, {"type": "subtitle", "time": 3820.63, "timestamp": "01:03:40", "text": "知らないの？知ってたら知らない方が"}, {"type": "subtitle", "time": 3822.47, "timestamp": "01:03:42", "text": "恥ずかしいよ"}, {"type": "subtitle", "time": 3825.109, "timestamp": "01:03:45", "text": "。ああ、いや。ちょっと待って。"}, {"type": "subtitle", "time": 3828.789, "timestamp": "01:03:48", "text": "何もしてないじゃないか。よくわからない。"}, {"type": "subtitle", "time": 3831.109, "timestamp": "01:03:51", "text": "覚えてないんだよ。１ヶ"}, {"type": "subtitle", "time": 3833.43, "timestamp": "01:03:53", "text": "月もいなかったんだ。人のこと覚えてないよ。"}, {"type": "subtitle", "time": 3835.91, "timestamp": "01:03:55", "text": "それから下にいる。わから"}, {"type": "subtitle", "time": 3837.589, "timestamp": "01:03:57", "text": "ない。よくわからない"}, {"type": "subtitle", "time": 3839.75, "timestamp": "01:03:59", "text": "。"}]
[{"type": "subtitle", "time": 4754.07, "timestamp": "01:19:14", "text": "歌の練習に行く予定だったんだ"}, {"type": "subtitle", "time": 4758.229, "timestamp": "01:19:18", "text": "けど、行けなくて"}, {"type": "subtitle", "time": 4760.95, "timestamp": "01:19:20", "text": "明日にリスケジュールしたんだ。"}, {"type": "subtitle", "time": 4764.87, "timestamp": "01:19:24", "text": "それから、メルとサミーとの問題について、いくつかスレッドを立てて、"}, {"type": "subtitle", "time": 4767.35, "timestamp": "01:19:27", "text": "サポートサーバーも作った"}, {"type": "subtitle", "time": 4772.31, "timestamp": "01:19:32", "text": "。"}, {"type": "subtitle", "time": 4776.229, "timestamp": "01:19:36", "text": "それで、しばらくそのことに頭を突っ込んでたんだけど、"}, {"type": "subtitle", "time": 4787.99, "timestamp": "01:19:47", "text": "大変だった。物事を"}, {"type": "subtitle", "time": 4793.35, "timestamp": "01:19:53", "text": "複雑にしすぎる傾向があることに気づいたんだ。"}]
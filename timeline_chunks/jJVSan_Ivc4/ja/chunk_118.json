[{"type": "subtitle", "time": 7087.35, "timestamp": "01:58:07", "text": "H. ああ、アリサ。"}, {"type": "subtitle", "time": 7090.229, "timestamp": "01:58:10", "text": "ああ、そうだね。 何？ なぜ私"}, {"type": "subtitle", "time": 7092.07, "timestamp": "01:58:12", "text": "たちの夫に返答しなかったのですか、そして私たちは"}, {"type": "subtitle", "time": 7128.55, "timestamp": "01:58:48", "text": "ああ、そうだね。"}, {"type": "subtitle", "time": 7130.629, "timestamp": "01:58:50", "text": "うん。 ただ、ただ移動すればいいんです。"}, {"type": "subtitle", "time": 7132.709, "timestamp": "01:58:52", "text": "彼をこれに招待しないでもいいですか？"}, {"type": "subtitle", "time": 7137.03, "timestamp": "01:58:57", "text": "ええ、できますよ。 それをしたいのですか？   やってみろ"}, {"type": "subtitle", "time": 7139.03, "timestamp": "01:58:59", "text": "。"}, {"type": "subtitle", "time": 7139.91, "timestamp": "01:58:59", "text": "参加する。   そういえば"}]
[{"type": "subtitle", "time": 1681.909, "timestamp": "00:28:01", "text": "退屈で、"}, {"type": "subtitle", "time": 1685.35, "timestamp": "00:28:05", "text": "アーカム三部作、"}, {"type": "subtitle", "time": 1688.07, "timestamp": "00:28:08", "text": "バットマン アーカム ゲームがセールか"}, {"type": "subtitle", "time": 1690.07, "timestamp": "00:28:10", "text": "何かで売られてるのを見たんだと思う。それで、PS 4 でプレイしたことがあるから、"}, {"type": "subtitle", "time": 1697.11, "timestamp": "00:28:17", "text": "もう一度プレイしてみようと思ったんだ。それで、"}, {"type": "subtitle", "time": 1700.789, "timestamp": "00:28:20", "text": "アーカム ゲームを全部プレイしたんだ。"}, {"type": "subtitle", "time": 1703.59, "timestamp": "00:28:23", "text": "すごく良かったよ。"}, {"type": "subtitle", "time": 1704.389, "timestamp": "00:28:24", "text": "それは良かった。"}, {"type": "subtitle", "time": 1707.99, "timestamp": "00:28:27", "text": "それで今、えーと、"}, {"type": "subtitle", "time": 1713.83, "timestamp": "00:28:33", "text": "フランチャイズを知ってるかどうかわからないけど、"}, {"type": "subtitle", "time": 1715.83, "timestamp": "00:28:35", "text": "クライシスを見てるんだ。"}, {"type": "subtitle", "time": 1717.59, "timestamp": "00:28:37", "text": "クライシスをプレイしたことある？"}, {"type": "subtitle", "time": 1720.63, "timestamp": "00:28:40", "text": "いや、まだないよ。"}, {"type": "subtitle", "time": 1723.59, "timestamp": "00:28:43", "text": "君も気に入ると思うよ。FPSみたいなゲームなんだ。"}, {"type": "subtitle", "time": 1726.87, "timestamp": "00:28:46", "text": "ファークライみたいな感じだよ。"}, {"type": "subtitle", "time": 1729.83, "timestamp": "00:28:49", "text": "未来版ファークライみたいなゲームだったんだ。"}, {"type": "subtitle", "time": 1731.909, "timestamp": "00:28:51", "text": "当時かなり人気だったんだ。昔は"}, {"type": "subtitle", "time": 1737.029, "timestamp": "00:28:57", "text": "PSでプレイしてたんだけど、"}]
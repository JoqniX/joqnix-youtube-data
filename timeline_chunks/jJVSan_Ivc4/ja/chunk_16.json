[{"type": "subtitle", "time": 961.749, "timestamp": "00:16:01", "text": "これらのアイテムをすべて販売し、"}, {"type": "subtitle", "time": 964.629, "timestamp": "00:16:04", "text": "身近な人にサンプルを送って、"}, {"type": "subtitle", "time": 966.949, "timestamp": "00:16:06", "text": "彼らがどのように使用するか、"}, {"type": "subtitle", "time": 969.59, "timestamp": "00:16:09", "text": "気に入るかどうか、品質が良いかどうかなどを確認しようと、いくつかアイデアがありました"}, {"type": "subtitle", "time": 973.03, "timestamp": "00:16:13", "text": "。 それから、まずは"}, {"type": "subtitle", "time": 976.949, "timestamp": "00:16:16", "text": "国内配送を試してみます。 そうなると、やり方はわからない"}, {"type": "subtitle", "time": 979.43, "timestamp": "00:16:19", "text": "けど、国際的にどうやるかを考えなきゃいけない"}, {"type": "subtitle", "time": 981.59, "timestamp": "00:16:21", "text": "。 だから、あなたも"}, {"type": "subtitle", "time": 983.509, "timestamp": "00:16:23", "text": "今すぐ手に入れることができます。"}, {"type": "subtitle", "time": 984.389, "timestamp": "00:16:24", "text": "ああ、いつかきっと"}, {"type": "subtitle", "time": 987.67, "timestamp": "00:16:27", "text": "。 それで、クリップみたいなバッジを作ろうかと考えていたんです"}, {"type": "subtitle", "time": 992.15, "timestamp": "00:16:32", "text": "。"}, {"type": "subtitle", "time": 995.189, "timestamp": "00:16:35", "text": "アクリル製のスタンド付きのバッジとか、シンプルなスタンド付きのバッジとか"}, {"type": "subtitle", "time": 1001.43, "timestamp": "00:16:41", "text": "。 うーん、今のところは分かりません。"}, {"type": "subtitle", "time": 1003.67, "timestamp": "00:16:43", "text": "ええ、それは"}, {"type": "subtitle", "time": 1006.55, "timestamp": "00:16:46", "text": "ジョアソン関連の一環としてやろうと考えていました。"}, {"type": "subtitle", "time": 1009.03, "timestamp": "00:16:49", "text": "ええ、そうですね。 うん。 うん。 だって、"}, {"type": "subtitle", "time": 1015.35, "timestamp": "00:16:55", "text": "スタンドみたいなスタンドを作ってるんだよ。"}]
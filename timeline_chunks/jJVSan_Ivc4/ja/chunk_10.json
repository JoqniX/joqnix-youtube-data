[{"type": "subtitle", "time": 601.75, "timestamp": "00:10:01", "text": "放棄して、大切にしていた多くのものを捨てて、より"}, {"type": "subtitle", "time": 605.11, "timestamp": "00:10:05", "text": "優れた"}, {"type": "subtitle", "time": 609.11, "timestamp": "00:10:09", "text": "ソフトウェアに移行するという動きをしました。それは良いことでしたが、"}, {"type": "subtitle", "time": 612.23, "timestamp": "00:10:12", "text": "制限もありました。しかし、"}, {"type": "subtitle", "time": 614.63, "timestamp": "00:10:14", "text": "積極的に助けを求め、それを機能させることができました"}, {"type": "subtitle", "time": 617.35, "timestamp": "00:10:17", "text": "。"}, {"type": "subtitle", "time": 620.55, "timestamp": "00:10:20", "text": "物事が解決してよかったし、ありがたいことに"}, {"type": "subtitle", "time": 623.11, "timestamp": "00:10:23", "text": "今ではクイン巡査は"}, {"type": "subtitle", "time": 625.91, "timestamp": "00:10:25", "text": "安心して過ごせるようになった。 それはいいですね。 それは良い。"}, {"type": "subtitle", "time": 628.87, "timestamp": "00:10:28", "text": "本当に良い。"}, {"type": "subtitle", "time": 632.63, "timestamp": "00:10:32", "text": "ええ、ええ、"}, {"type": "subtitle", "time": 635.11, "timestamp": "00:10:35", "text": "3ヶ月間掃除していなかった部屋をやっと掃除しました"}, {"type": "subtitle", "time": 636.55, "timestamp": "00:10:36", "text": "。 ああ、神様。   ちくしょう"}, {"type": "subtitle", "time": 638.069, "timestamp": "00:10:38", "text": "。"}, {"type": "subtitle", "time": 639.829, "timestamp": "00:10:39", "text": "3ヶ月ではなく、4ヶ月くらいかな。"}, {"type": "subtitle", "time": 643.11, "timestamp": "00:10:43", "text": "いや、いや、待って。"}, {"type": "subtitle", "time": 645.67, "timestamp": "00:10:45", "text": "通常の掃除のように途中まで掃除はしましたが、徹底的に掃除はしませんでした"}, {"type": "subtitle", "time": 649.03, "timestamp": "00:10:49", "text": "。 ええ、"}, {"type": "subtitle", "time": 651.75, "timestamp": "00:10:51", "text": "先週の日曜日にやりました。"}, {"type": "subtitle", "time": 655.11, "timestamp": "00:10:55", "text": "先週の日曜日でしたか？ うん。 日曜日は違います。"}, {"type": "subtitle", "time": 658.15, "timestamp": "00:10:58", "text": "実際は水曜日です。 水曜日、木曜日。"}]
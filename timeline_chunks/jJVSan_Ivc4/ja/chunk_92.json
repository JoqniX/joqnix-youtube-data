[{"type": "subtitle", "time": 5529.35, "timestamp": "01:32:09", "text": "ソロ配信をもっとやりたい気がする。コラボ"}, {"type": "subtitle", "time": 5534.149, "timestamp": "01:32:14", "text": "配信もやったことがあるけど、"}, {"type": "subtitle", "time": 5536.55, "timestamp": "01:32:16", "text": "悪くないと思う。まあまあ。でも"}, {"type": "subtitle", "time": 5539.27, "timestamp": "01:32:19", "text": "ソロ配信にもっと集中する必要があるような気もする。"}, {"type": "subtitle", "time": 5543.75, "timestamp": "01:32:23", "text": "でも確信はない。どちらも"}, {"type": "subtitle", "time": 5551.83, "timestamp": "01:32:31", "text": "どう思う？"}, {"type": "subtitle", "time": 5553.27, "timestamp": "01:32:33", "text": "もっとシルバー配信をするべきだと思う"}, {"type": "subtitle", "time": 5555.99, "timestamp": "01:32:35", "text": "？そうするべきだと思う。"}, {"type": "subtitle", "time": 5558.39, "timestamp": "01:32:38", "text": "でも、配信に"}, {"type": "subtitle", "time": 5560.47, "timestamp": "01:32:40", "text": "もっとクリエイティブな努力を注ぐべきだと思う"}, {"type": "subtitle", "time": 5562.87, "timestamp": "01:32:42", "text": "。"}, {"type": "subtitle", "time": 5566.95, "timestamp": "01:32:46", "text": "うん。そうする必要があるよね？"}, {"type": "subtitle", "time": 5570.95, "timestamp": "01:32:50", "text": "グループ配信は楽しいと思う"}, {"type": "subtitle", "time": 5574.709, "timestamp": "01:32:54", "text": "。コラボも楽しいけど、"}, {"type": "subtitle", "time": 5578.87, "timestamp": "01:32:58", "text": "それにはエネルギーが必要だと思う。"}]
[{"type": "subtitle", "time": 7861.109, "timestamp": "02:11:01", "text": "地面にでも突っ込むような感じ"}, {"type": "subtitle", "time": 7864.95, "timestamp": "02:11:04", "text": "？ 私は地面を覗き込んでいる。"}, {"type": "subtitle", "time": 7869.51, "timestamp": "02:11:09", "text": "ドアなど、どこかを覗き込んでいる。"}, {"type": "subtitle", "time": 7870.87, "timestamp": "02:11:10", "text": "めちゃくちゃゲイっぽい響きだね。"}, {"type": "subtitle", "time": 7875.589, "timestamp": "02:11:15", "text": "ドアから。 私はドアから覗いている。"}, {"type": "chat", "time": 7880.073, "timestamp": "02:11:20", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/egJ1XufTKYfegwOo57ewAg"}, {"type": "subtitle", "time": 7882.55, "timestamp": "02:11:22", "text": "ゲイ向けのグッズがどんどん増えていった。"}, {"type": "subtitle", "time": 7888.31, "timestamp": "02:11:28", "text": "あるいは望遠鏡かもしれない。 そして私は探している。   それは私たちの"}, {"type": "subtitle", "time": 7897.51, "timestamp": "02:11:37", "text": "。 ああ、なんてことだ"}, {"type": "subtitle", "time": 7900.31, "timestamp": "02:11:40", "text": "、ああ、なんてことだ。 みんな落ち着いて。"}, {"type": "subtitle", "time": 7902.39, "timestamp": "02:11:42", "text": "みんな落ち着いて。   落ち着け、落ち着け"}, {"type": "subtitle", "time": 7905.99, "timestamp": "02:11:45", "text": "。"}, {"type": "subtitle", "time": 7907.35, "timestamp": "02:11:47", "text": "こんにちは。   何てことだ"}, {"type": "subtitle", "time": 7909.75, "timestamp": "02:11:49", "text": "。 それはアルスではありません。"}, {"type": "subtitle", "time": 7913.109, "timestamp": "02:11:53", "text": "空気のせいだ。 感じるよ。"}, {"type": "subtitle", "time": 7915.43, "timestamp": "02:11:55", "text": "空気の音が聞こえる。"}, {"type": "subtitle", "time": 7918.47, "timestamp": "02:11:58", "text": "こんにちは。 よかったね。"}]
[{"type": "subtitle", "time": 3542.15, "timestamp": "00:59:02", "text": "うん。"}, {"type": "subtitle", "time": 3548.15, "timestamp": "00:59:08", "text": "昨日、みんなが私に怒らなかったのが不思議だわ。私はとても静かで、"}, {"type": "subtitle", "time": 3550.789, "timestamp": "00:59:10", "text": "完全に注意深く"}, {"type": "subtitle", "time": 3552.789, "timestamp": "00:59:12", "text": "聞いていたけど、何をすべきか理解していなかったから"}, {"type": "subtitle", "time": 3554.549, "timestamp": "00:59:14", "text": "。"}, {"type": "subtitle", "time": 3556.23, "timestamp": "00:59:16", "text": "初めてだったから。"}, {"type": "subtitle", "time": 3560.309, "timestamp": "00:59:20", "text": "正直言って、あなたはドルイドのように振る舞っていたわ。それがドルイドよ。"}, {"type": "subtitle", "time": 3563.109, "timestamp": "00:59:23", "text": "何？"}, {"type": "subtitle", "time": 3575.43, "timestamp": "00:59:35", "text": "古代カトリックの宗教的人物であり、"}, {"type": "subtitle", "time": 3578.87, "timestamp": "00:59:38", "text": "現代の特別な抗議者。司祭、"}, {"type": "subtitle", "time": 3581.349, "timestamp": "00:59:41", "text": "教師、封印者であり、"}, {"type": "subtitle", "time": 3583.109, "timestamp": "00:59:43", "text": "宗教、"}, {"type": "subtitle", "time": 3586.23, "timestamp": "00:59:46", "text": "法律、社会生活において中心的な役割を果たしている。 今日、現代のビーン"}, {"type": "subtitle", "time": 3589.109, "timestamp": "00:59:49", "text": "宗教は、"}, {"type": "subtitle", "time": 3596.87, "timestamp": "00:59:56", "text": "つまり、ドルイドが何であるかを調べているだけですか？"}]
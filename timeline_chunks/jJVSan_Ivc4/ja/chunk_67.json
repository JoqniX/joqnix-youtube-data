[{"type": "subtitle", "time": 4023.109, "timestamp": "01:07:03", "text": "本当に 気を取られたよ。何？"}, {"type": "subtitle", "time": 4025.19, "timestamp": "01:07:05", "text": "えっと、"}, {"type": "subtitle", "time": 4031.19, "timestamp": "01:07:11", "text": "アイアンユーチューバーコミュニティで誰かが"}, {"type": "subtitle", "time": 4034.15, "timestamp": "01:07:14", "text": "ファスモをプレイしているのを見ると、いつも頭の中に2人、"}, {"type": "subtitle", "time": 4037.27, "timestamp": "01:07:17", "text": "いや、3人が浮かぶんだ。"}, {"type": "subtitle", "time": 4040.87, "timestamp": "01:07:20", "text": "いい人ヴィック、ほら、いいヴィック、"}, {"type": "subtitle", "time": 4042.95, "timestamp": "01:07:22", "text": "吸血鬼ヴィック。"}, {"type": "subtitle", "time": 4046.549, "timestamp": "01:07:26", "text": "あの人が浮かぶ。スイと君。"}, {"type": "subtitle", "time": 4049.67, "timestamp": "01:07:29", "text": "誰かがファストをプレイしていると、君が"}, {"type": "subtitle", "time": 4057.109, "timestamp": "01:07:37", "text": "最近、僕たちは、ああ、そうだね。ああ。僕も"}, {"type": "subtitle", "time": 4058.789, "timestamp": "01:07:38", "text": "参加したんだ。だから"}, {"type": "subtitle", "time": 4059.99, "timestamp": "01:07:39", "text": "沈黙があったんだ。"}, {"type": "subtitle", "time": 4061.589, "timestamp": "01:07:41", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 4068.39, "timestamp": "01:07:48", "text": "昨日だったかな？ああ、そうだね、昨日だったかな"}, {"type": "subtitle", "time": 4072.23, "timestamp": "01:07:52", "text": "？えっと、僕とヴィッシュは、"}]
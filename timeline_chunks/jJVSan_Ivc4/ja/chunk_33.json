[{"type": "subtitle", "time": 1984.549, "timestamp": "00:33:04", "text": "外部アプリで観たんだ。あ"}, {"type": "subtitle", "time": 1986.149, "timestamp": "00:33:06", "text": "、ああ、"}, {"type": "subtitle", "time": 1993.83, "timestamp": "00:33:13", "text": "やあ。"}, {"type": "subtitle", "time": 1997.83, "timestamp": "00:33:17", "text": "やあ、映画館に"}, {"type": "subtitle", "time": 2002.23, "timestamp": "00:33:22", "text": "行かずに外部ウェブサイトで観てる田舎者め"}, {"type": "subtitle", "time": 2006.789, "timestamp": "00:33:26", "text": "。よくもそんなことを！よくもそんなことを"}, {"type": "subtitle", "time": 2009.43, "timestamp": "00:33:29", "text": "！"}, {"type": "subtitle", "time": 2011.029, "timestamp": "00:33:31", "text": "[音楽]"}, {"type": "subtitle", "time": 2013.669, "timestamp": "00:33:33", "text": "うん。あと、何て言えばいいのかわからない"}, {"type": "subtitle", "time": 2015.509, "timestamp": "00:33:35", "text": "。"}, {"type": "subtitle", "time": 2017.83, "timestamp": "00:33:37", "text": "ゲームにお金を無駄にしないって言ったのに、"}, {"type": "subtitle", "time": 2029.75, "timestamp": "00:33:49", "text": "10ドルのポップコーンを"}, {"type": "subtitle", "time": 2033.83, "timestamp": "00:33:53", "text": "食べたんだ。おかしいよ。おかしい。おかしい。"}]
[{"type": "subtitle", "time": 7560.87, "timestamp": "02:06:00", "text": "まだ彼にメッセージを送っています。   まだ"}, {"type": "subtitle", "time": 7563.589, "timestamp": "02:06:03", "text": "彼にダイレクトメッセージを送っていません。"}, {"type": "chat", "time": 7565.811, "timestamp": "02:06:05", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "depressing music sounds claming to me"}, {"type": "subtitle", "time": 7572.87, "timestamp": "02:06:12", "text": "憂鬱な音楽は私にとってありふれたものに聞こえる。 それは"}, {"type": "subtitle", "time": 7575.35, "timestamp": "02:06:15", "text": "よくあることです。 でも、それは"}, {"type": "subtitle", "time": 7577.669, "timestamp": "02:06:17", "text": "憂鬱な音楽という文脈の中での話ですよね。"}, {"type": "subtitle", "time": 7579.75, "timestamp": "02:06:19", "text": "憂鬱な音楽を"}, {"type": "subtitle", "time": 7581.589, "timestamp": "02:06:21", "text": "憂鬱な方法で聴いているなら、当然"}, {"type": "subtitle", "time": 7583.589, "timestamp": "02:06:23", "text": "憂鬱になるだろう。 そして、もし"}, {"type": "subtitle", "time": 7585.669, "timestamp": "02:06:25", "text": "あなたが憂鬱な音楽を聴いているなら、ほら、落ち着くような、眠くなるような、落ち着きたい、"}, {"type": "subtitle", "time": 7593.189, "timestamp": "02:06:33", "text": "リラックスしたいと思って、それを"}, {"type": "subtitle", "time": 7596.31, "timestamp": "02:06:36", "text": "聴いていると、穏やか"}, {"type": "subtitle", "time": 7598.87, "timestamp": "02:06:38", "text": "で心地よい曲のように感じられ、憂鬱には聞こえないでしょう。ほら、私は変人、"}, {"type": "subtitle", "time": 7615.51, "timestamp": "02:06:55", "text": "奇人です。それで、レディオヘッドを聴いたことがありますか？"}, {"type": "subtitle", "time": 7616.87, "timestamp": "02:06:56", "text": "この話、聞いたことありますか？"}, {"type": "subtitle", "time": 7618.39, "timestamp": "02:06:58", "text": "いいえ。"}]
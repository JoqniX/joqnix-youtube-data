[{"type": "subtitle", "time": 9246.23, "timestamp": "02:34:06", "text": "分くらい前にこの人と話してたんだけど、"}, {"type": "subtitle", "time": 9247.91, "timestamp": "02:34:07", "text": "話してたんだ。"}, {"type": "subtitle", "time": 9250.07, "timestamp": "02:34:10", "text": "仕事中だって言ってたんだけど、"}, {"type": "subtitle", "time": 9252.55, "timestamp": "02:34:12", "text": "すごく静かだったんだ。"}, {"type": "subtitle", "time": 9254.309, "timestamp": "02:34:14", "text": "ジョック、いるの？って聞いたら、「ああ、いるよ。"}, {"type": "subtitle", "time": 9255.429, "timestamp": "02:34:15", "text": "何の"}, {"type": "subtitle", "time": 9257.91, "timestamp": "02:34:17", "text": "話をしていたの？」って答えたんだ。そしたら彼が"}, {"type": "subtitle", "time": 9259.83, "timestamp": "02:34:19", "text": "「ああ、君を棒みたいな腕のついた"}, {"type": "subtitle", "time": 9262.309, "timestamp": "02:34:22", "text": "パンとして想像してたんだ」って言ったんだ"}, {"type": "subtitle", "time": 9268.15, "timestamp": "02:34:28", "text": "何？   「"}, {"type": "subtitle", "time": 9270.79, "timestamp": "02:34:30", "text": "パンの国。」"}, {"type": "subtitle", "time": 9272.71, "timestamp": "02:34:32", "text": "彼は、ああ、彼が言っていたのは、"}, {"type": "subtitle", "time": 9274.71, "timestamp": "02:34:34", "text": "「ああ、君はただ"}, {"type": "subtitle", "time": 9276.55, "timestamp": "02:34:36", "text": "パンで、"}, {"type": "subtitle", "time": 9279.429, "timestamp": "02:34:39", "text": "パンの人々にパンを売っているところを想像していたんだ」みたいなことだった。"}, {"type": "subtitle", "time": 9285.51, "timestamp": "02:34:45", "text": "何を言っているんだ？彼らはどういうわけか統合"}, {"type": "subtitle", "time": 9292.87, "timestamp": "02:34:52", "text": "彼は別の世界にいる。なんてことだ。"}]
[{"type": "subtitle", "time": 1865.43, "timestamp": "00:31:05", "text": "レートが低い時に自動で自動になるなんて知らなかったよ。"}, {"type": "subtitle", "time": 1867.83, "timestamp": "00:31:07", "text": "うん、"}, {"type": "subtitle", "time": 1870.31, "timestamp": "00:31:10", "text": "つまりソフトウェアはいいよね。例えば、こんな"}, {"type": "subtitle", "time": 1873.51, "timestamp": "00:31:13", "text": "LEDライトを君にあげられる"}, {"type": "subtitle", "time": 1876.23, "timestamp": "00:31:16", "text": "。LEDライトをあげられる？"}, {"type": "subtitle", "time": 1878.31, "timestamp": "00:31:18", "text": "白黒で。"}, {"type": "subtitle", "time": 1879.83, "timestamp": "00:31:19", "text": "ストリームを見て。"}, {"type": "subtitle", "time": 1883.35, "timestamp": "00:31:23", "text": "幽霊にできるよ。ホログラムにもできるよ。"}, {"type": "subtitle", "time": 1885.99, "timestamp": "00:31:25", "text": "遅延ストリームだから見えないんだ。"}, {"type": "subtitle", "time": 1888.87, "timestamp": "00:31:28", "text": "うん。うん。1分待ってて。待ってるよ。待ってるよ"}, {"type": "subtitle", "time": 1891.99, "timestamp": "00:31:31", "text": "。"}, {"type": "subtitle", "time": 1898.549, "timestamp": "00:31:38", "text": "、いろいろできるんだ。すごくいいよ。いや。"}, {"type": "subtitle", "time": 1902.47, "timestamp": "00:31:42", "text": "ジョー、何してるんだよ？"}, {"type": "subtitle", "time": 1910.23, "timestamp": "00:31:50", "text": "いつでもポップアップするはずだよ。さあ。"}, {"type": "subtitle", "time": 1912.149, "timestamp": "00:31:52", "text": "もうすぐだ。うん。いや、"}, {"type": "subtitle", "time": 1915.19, "timestamp": "00:31:55", "text": "表示されてるのはわかってるよ。ストリームに表示されてる。"}, {"type": "subtitle", "time": 1917.99, "timestamp": "00:31:57", "text": "何？見えないよ。8のはずなのに。"}]
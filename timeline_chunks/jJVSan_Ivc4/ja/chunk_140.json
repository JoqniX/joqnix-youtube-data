[{"type": "subtitle", "time": 8407.27, "timestamp": "02:20:07", "text": "ああ、ジョー、モニターを見たことがないの？"}, {"type": "subtitle", "time": 8409.27, "timestamp": "02:20:09", "text": "ない。"}, {"type": "subtitle", "time": 8411.67, "timestamp": "02:20:11", "text": "ああ、"}, {"type": "subtitle", "time": 8413.67, "timestamp": "02:20:13", "text": "ニューロンか何かが解放されるかもしれない"}, {"type": "subtitle", "time": 8417.91, "timestamp": "02:20:17", "text": "。そうなるかどうかはわからないけど。ちょっと"}, {"type": "subtitle", "time": 8436.07, "timestamp": "02:20:36", "text": "、くそ、彼のカットシーンみたいなプレイリストがあるんだ"}, {"type": "subtitle", "time": 8443.19, "timestamp": "02:20:43", "text": "知らなかったよ。"}]
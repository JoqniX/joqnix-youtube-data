[{"type": "subtitle", "time": 662.55, "timestamp": "00:11:02", "text": "うん。 うん。 こうして座っていられるのは本当に気持ちがいい。以前はとても"}, {"type": "subtitle", "time": 667.91, "timestamp": "00:11:07", "text": "痛かったのを覚えている。 そして私は、「ここにいたくない」と思った"}, {"type": "subtitle", "time": 670.63, "timestamp": "00:11:10", "text": "。"}, {"type": "subtitle", "time": 674.79, "timestamp": "00:11:14", "text": "ベッドに戻って、"}, {"type": "subtitle", "time": 680.15, "timestamp": "00:11:20", "text": "この冷たいベッドの冷たさに中毒になって、そのまま"}, {"type": "subtitle", "time": 683.91, "timestamp": "00:11:23", "text": "眠りにつきたい。 でも、今はすごく"}, {"type": "subtitle", "time": 686.63, "timestamp": "00:11:26", "text": "いい感じだよ。 くしゃみはあまり出ません"}, {"type": "subtitle", "time": 688.23, "timestamp": "00:11:28", "text": "。   そうですね"}, {"type": "subtitle", "time": 690.87, "timestamp": "00:11:30", "text": "。 それから、日本語の"}, {"type": "subtitle", "time": 693.19, "timestamp": "00:11:33", "text": "授業ももうすぐ"}, {"type": "subtitle", "time": 695.91, "timestamp": "00:11:35", "text": "始まります。 いつになるかは分からないが、近いうちにと言っていた"}, {"type": "subtitle", "time": 697.829, "timestamp": "00:11:37", "text": "。   たぶん"}, {"type": "subtitle", "time": 700.87, "timestamp": "00:11:40", "text": "来週か今週になると思うけど、分から"}, {"type": "subtitle", "time": 703.59, "timestamp": "00:11:43", "text": "ない。  8月"}, {"type": "subtitle", "time": 717.35, "timestamp": "00:11:57", "text": "サイト"}, {"type": "subtitle", "time": 719.99, "timestamp": "00:11:59", "text": "関連の作業をしていました。 銀行口座関連の件で、その情報が送られてきました"}]
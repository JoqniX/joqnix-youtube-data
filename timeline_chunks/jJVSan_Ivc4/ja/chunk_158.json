[{"type": "subtitle", "time": 9480.389, "timestamp": "02:38:00", "text": "そこに完璧に着地したんだ。"}, {"type": "subtitle", "time": 9481.19, "timestamp": "02:38:01", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 9487.19, "timestamp": "02:38:07", "text": "想像できるかい？"}, {"type": "subtitle", "time": 9490.309, "timestamp": "02:38:10", "text": "彼はもう、"}, {"type": "subtitle", "time": 9492.63, "timestamp": "02:38:12", "text": "棒人間みたいな手でパンを想像して、"}, {"type": "subtitle", "time": 9497.27, "timestamp": "02:38:17", "text": "階段から転げ落ちるところを想像してるんだ。うん、想像してるよ。"}, {"type": "subtitle", "time": 9500.469, "timestamp": "02:38:20", "text": "うん、"}, {"type": "subtitle", "time": 9503.349, "timestamp": "02:38:23", "text": "頭が飛び出したに違いない。"}, {"type": "subtitle", "time": 9505.59, "timestamp": "02:38:25", "text": "何？"}, {"type": "subtitle", "time": 9510.63, "timestamp": "02:38:30", "text": "いや、パンがブロンズで、"}, {"type": "subtitle", "time": 9522.15, "timestamp": "02:38:42", "text": "ああ、なんてことだ。大丈夫だよ。大丈夫だよ"}, {"type": "subtitle", "time": 9524.63, "timestamp": "02:38:44", "text": "。"}, {"type": "subtitle", "time": 9526.55, "timestamp": "02:38:46", "text": "もう寝たい？もう行く時間だと思うから"}, {"type": "subtitle", "time": 9527.99, "timestamp": "02:38:47", "text": "。"}, {"type": "subtitle", "time": 9528.71, "timestamp": "02:38:48", "text": "ああ、もう時間だね。"}, {"type": "subtitle", "time": 9530.389, "timestamp": "02:38:50", "text": "寝たい？"}, {"type": "subtitle", "time": 9532.07, "timestamp": "02:38:52", "text": "うん。"}, {"type": "subtitle", "time": 9532.63, "timestamp": "02:38:52", "text": "こんにちは、"}, {"type": "subtitle", "time": 9535.349, "timestamp": "02:38:55", "text": "アル。これは"}, {"type": "subtitle", "time": 9537.59, "timestamp": "02:38:57", "text": "配信外で聞くと思う。これは配信外で聞くよ。わかった。おやすみ。"}]
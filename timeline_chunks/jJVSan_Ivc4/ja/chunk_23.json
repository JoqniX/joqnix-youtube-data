[{"type": "subtitle", "time": 1381.19, "timestamp": "00:23:01", "text": "。"}, {"type": "subtitle", "time": 1384.47, "timestamp": "00:23:04", "text": "ようこそ、友よ。"}, {"type": "subtitle", "time": 1386.789, "timestamp": "00:23:06", "text": "ご挨拶申し上げます。"}, {"type": "subtitle", "time": 1390.87, "timestamp": "00:23:10", "text": "今日はゲストをお迎えしています。 ジョック。 次。 ジョー。"}, {"type": "subtitle", "time": 1392.149, "timestamp": "00:23:12", "text": "では、ジョーさん、ご"}, {"type": "subtitle", "time": 1398.47, "timestamp": "00:23:18", "text": "こんにちは、アダム。   はじめまして"}, {"type": "subtitle", "time": 1399.83, "timestamp": "00:23:19", "text": "。   もしかしたら"}, {"type": "subtitle", "time": 1401.909, "timestamp": "00:23:21", "text": "あなたのことを知らないかもしれないから、あなたがどんな人なのかを"}, {"type": "subtitle", "time": 1404.31, "timestamp": "00:23:24", "text": "その人に説明した方がいいと思うんだ"}, {"type": "subtitle", "time": 1406.95, "timestamp": "00:23:26", "text": "。"}, {"type": "subtitle", "time": 1419.99, "timestamp": "00:23:39", "text": "ネラがいなくて寂しかったよね？ それとも、私だけだったのかな？それとも、"}, {"type": "subtitle", "time": 1423.19, "timestamp": "00:23:43", "text": "私たちが一緒に終わったとか、そんな感じだったのかな"}, {"type": "subtitle", "time": 1424.149, "timestamp": "00:23:44", "text": "？"}, {"type": "subtitle", "time": 1427.27, "timestamp": "00:23:47", "text": "私たちはそうしました。 私たちはまだ"}, {"type": "subtitle", "time": 1429.27, "timestamp": "00:23:49", "text": "次の島に行っていません。   そうそう"}, {"type": "subtitle", "time": 1431.669, "timestamp": "00:23:51", "text": "。 現時点で次の島です。"}, {"type": "subtitle", "time": 1434.95, "timestamp": "00:23:54", "text": "そこに行こうとしていたのですが、"}, {"type": "subtitle", "time": 1439.51, "timestamp": "00:23:59", "text": "開発者によると、まだ完全に完成していないとのことですが、"}]
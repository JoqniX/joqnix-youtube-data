[{"type": "subtitle", "time": 4861.43, "timestamp": "01:21:01", "text": "ああ、くそ。おかえり。おかえり。"}, {"type": "subtitle", "time": 4870.11, "timestamp": "01:21:10", "text": "何の話をしてたんだっけ？"}, {"type": "subtitle", "time": 4872.79, "timestamp": "01:21:12", "text": "[音楽] 適当にいろいろ"}, {"type": "subtitle", "time": 4875.11, "timestamp": "01:21:15", "text": "話してたんだ"}, {"type": "subtitle", "time": 4880.07, "timestamp": "01:21:20", "text": "。実際は、えっと、"}, {"type": "subtitle", "time": 4887.27, "timestamp": "01:21:27", "text": "今日やったことについて話してたんだ。"}, {"type": "subtitle", "time": 4889.59, "timestamp": "01:21:29", "text": "うん。うん"}, {"type": "subtitle", "time": 4891.75, "timestamp": "01:21:31", "text": "。今日やったこととか。うん。"}, {"type": "subtitle", "time": 4892.79, "timestamp": "01:21:32", "text": "それで、"}, {"type": "subtitle", "time": 4894.709, "timestamp": "01:21:34", "text": "くそっ。今日は何をしていたの？"}, {"type": "subtitle", "time": 4897.669, "timestamp": "01:21:37", "text": "あくびをした。あくびをしたの"}, {"type": "subtitle", "time": 4899.189, "timestamp": "01:21:39", "text": "？"}, {"type": "subtitle", "time": 4899.59, "timestamp": "01:21:39", "text": "うん。"}, {"type": "subtitle", "time": 4901.35, "timestamp": "01:21:41", "text": "一日中？ 一"}, {"type": "subtitle", "time": 4903.99, "timestamp": "01:21:43", "text": "日中じゃないよ。えっと、"}, {"type": "subtitle", "time": 4905.75, "timestamp": "01:21:45", "text": "歌う呼吸法をやらなきゃいけなかったんだけど、できなかったんだ"}, {"type": "subtitle", "time": 4909.51, "timestamp": "01:21:49", "text": "。それで明日に予定して、それで、えっと、他に"}]
[{"type": "subtitle", "time": 8584.07, "timestamp": "02:23:04", "text": "どうやって？   同情の余地は"}, {"type": "subtitle", "time": 8592.309, "timestamp": "02:23:12", "text": "待って、このバナーが終わるまであと何日あるの"}, {"type": "subtitle", "time": 8593.349, "timestamp": "02:23:13", "text": "？"}, {"type": "subtitle", "time": 8595.51, "timestamp": "02:23:15", "text": "ええ、わかりました。 わかった。 事の顛末はこうだ"}, {"type": "subtitle", "time": 8597.99, "timestamp": "02:23:17", "text": "。 わかった。  10 回の投票を行ったのですが、"}, {"type": "subtitle", "time": 8600.63, "timestamp": "02:23:20", "text": "最初の投票開始時に"}, {"type": "subtitle", "time": 8602.389, "timestamp": "02:23:22", "text": "ふざけてしまい、"}, {"type": "subtitle", "time": 8604.469, "timestamp": "02:23:24", "text": "その後、"}, {"type": "subtitle", "time": 8606.87, "timestamp": "02:23:26", "text": "投票の途中に"}, {"type": "subtitle", "time": 8612.389, "timestamp": "02:23:32", "text": "同じマルチでまたふざけてしまい、"}, {"type": "subtitle", "time": 8615.75, "timestamp": "02:23:35", "text": "同じマルチでラッキーでした。"}, {"type": "subtitle", "time": 8621.03, "timestamp": "02:23:41", "text": "ゲームを閉じました。冗談抜きで、"}, {"type": "subtitle", "time": 8628.79, "timestamp": "02:23:48", "text": "コラボ"}, {"type": "subtitle", "time": 8630.55, "timestamp": "02:23:50", "text": "バナーの機能がありませんでした。"}, {"type": "subtitle", "time": 8631.99, "timestamp": "02:23:51", "text": "何？"}, {"type": "subtitle", "time": 8633.349, "timestamp": "02:23:53", "text": "ええと、50/50システムですね。"}, {"type": "subtitle", "time": 8636.55, "timestamp": "02:23:56", "text": "いいえ、50/50システムは、50"}, {"type": "subtitle", "time": 8639.91, "timestamp": "02:23:59", "text": "/50で負けた場合、"}]
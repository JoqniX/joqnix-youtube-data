[{"type": "subtitle", "time": 9360.0, "timestamp": "02:36:00", "text": "息子よ。 それは、年寄りが"}, {"type": "subtitle", "time": 9361.92, "timestamp": "02:36:01", "text": "それは、年寄りが 言うことだ。私はこの年齢でまだ若い。私は"}, {"type": "subtitle", "time": 9364.96, "timestamp": "02:36:04", "text": "言うことだ。私はこの年齢でまだ若い。私は まだ君たち子供たちより若い。 この辺りでは。"}, {"type": "subtitle", "time": 9367.76, "timestamp": "02:36:07", "text": "まだ君たち子供たちより若い。 この辺りでは。 ああ、"}, {"type": "subtitle", "time": 9368.24, "timestamp": "02:36:08", "text": "ああ、 それは老人が言うことだよ。"}, {"type": "subtitle", "time": 9377.67, "timestamp": "02:36:17", "text": "不安かい？アンクって呼んでもいいかな？私は違うよ。"}, {"type": "subtitle", "time": 9381.91, "timestamp": "02:36:21", "text": "君は行くの？君はその"}, {"type": "subtitle", "time": 9383.83, "timestamp": "02:36:23", "text": "年齢になるの？彼はそうだと思うよ。いや。"}, {"type": "subtitle", "time": 9388.81, "timestamp": "02:36:28", "text": "こんにちは。"}, {"type": "subtitle", "time": 9392.15, "timestamp": "02:36:32", "text": "[笑い]"}, {"type": "subtitle", "time": 9395.349, "timestamp": "02:36:35", "text": "こんにちは、化石。こんにちは、恐竜の矢男。"}, {"type": "subtitle", "time": 9402.23, "timestamp": "02:36:42", "text": "調子はどう？ジョーはたぶん"}, {"type": "subtitle", "time": 9410.87, "timestamp": "02:36:50", "text": "こいつらはジョークがわからなかった。こいつらはわからなかった"}, {"type": "subtitle", "time": 9412.469, "timestamp": "02:36:52", "text": "。"}, {"type": "subtitle", "time": 9414.95, "timestamp": "02:36:54", "text": "君は、"}, {"type": "subtitle", "time": 9418.23, "timestamp": "02:36:58", "text": "女王と"}]
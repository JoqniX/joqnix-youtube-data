[{"type": "subtitle", "time": 4381.11, "timestamp": "01:13:01", "text": "声が高い人見たことある？"}, {"type": "subtitle", "time": 4383.83, "timestamp": "01:13:03", "text": "彼らが何をしてるか？ 君もそういうことをするべきだよ。"}, {"type": "subtitle", "time": 4387.27, "timestamp": "01:13:07", "text": "ねえ、彼らは何をしてるの？"}, {"type": "subtitle", "time": 4391.669, "timestamp": "01:13:11", "text": "つまり、歌を作ったり、歌ったり。"}, {"type": "subtitle", "time": 4395.669, "timestamp": "01:13:15", "text": "私がやろうとしていることじゃないの？"}, {"type": "subtitle", "time": 4397.03, "timestamp": "01:13:17", "text": "私は、その逆のことをもっと学んでいるんだ。ほら、"}, {"type": "subtitle", "time": 4401.27, "timestamp": "01:13:21", "text": "ああ、キャットフィッシングとか、"}, {"type": "subtitle", "time": 4403.99, "timestamp": "01:13:23", "text": "トローリングとか、そういうこと。声優。"}, {"type": "subtitle", "time": 4406.63, "timestamp": "01:13:26", "text": "私はASMRの方が好きだけど、それもある"}, {"type": "subtitle", "time": 4407.669, "timestamp": "01:13:27", "text": "。"}, {"type": "subtitle", "time": 4411.11, "timestamp": "01:13:31", "text": "オーケー。ASMR。またASMRに没頭したい"}, {"type": "subtitle", "time": 4419.99, "timestamp": "01:13:39", "text": "うん。正直に言うと、"}, {"type": "subtitle", "time": 4428.79, "timestamp": "01:13:48", "text": "言わないよ。いや、個人的には、"}, {"type": "subtitle", "time": 4432.39, "timestamp": "01:13:52", "text": "状況に応じた"}, {"type": "subtitle", "time": 4434.47, "timestamp": "01:13:54", "text": "ASMRタイムが欲しいなら聞きたくない。変な"}, {"type": "subtitle", "time": 4438.07, "timestamp": "01:13:58", "text": "ASMRの人たち、"}]
[{"type": "subtitle", "time": 7680.87, "timestamp": "02:08:00", "text": "、冒険心に満ちて"}, {"type": "subtitle", "time": 7686.79, "timestamp": "02:08:06", "text": "探検モードになったら、"}, {"type": "subtitle", "time": 7689.51, "timestamp": "02:08:09", "text": "別のことをするよ。 ああ、まるで"}, {"type": "subtitle", "time": 7701.109, "timestamp": "02:08:21", "text": "彼に何と言ったか聞きたい？"}, {"type": "subtitle", "time": 7703.03, "timestamp": "02:08:23", "text": "彼は「暇？」って感じだった。  「暇ですか"}, {"type": "subtitle", "time": 7705.83, "timestamp": "02:08:25", "text": "？」と私は尋ねた。 彼は「ああ、"}, {"type": "subtitle", "time": 7708.069, "timestamp": "02:08:28", "text": "ちょっと首が凝ってるだけだよ。今すぐジョギングの配信を見よう"}, {"type": "subtitle", "time": 7710.629, "timestamp": "02:08:30", "text": "」と言った。 彼は「わかった」と言った。  「"}, {"type": "subtitle", "time": 7714.39, "timestamp": "02:08:34", "text": "今すぐ通話に参加してください。今すぐあなたの力が必要です。」って言うんです。"}, {"type": "subtitle", "time": 7717.75, "timestamp": "02:08:37", "text": "そして私は「何が起こっているの？」と尋ねた。 私は"}, {"type": "subtitle", "time": 7720.79, "timestamp": "02:08:40", "text": "「やってみろ。一言二言言ってみろ」と言った。 私はただ、"}, {"type": "subtitle", "time": 7723.43, "timestamp": "02:08:43", "text": "すごく面白いことを言っただけです。"}, {"type": "subtitle", "time": 7727.589, "timestamp": "02:08:47", "text": "そして兄弟、俺たちはお前を待っている。  Dはすべて"}, {"type": "subtitle", "time": 7729.669, "timestamp": "02:08:49", "text": "大文字です。   何てことだ"}, {"type": "subtitle", "time": 7731.48, "timestamp": "02:08:51", "text": "。"}, {"type": "subtitle", "time": 7734.31, "timestamp": "02:08:54", "text": "[音楽]"}, {"type": "subtitle", "time": 7736.31, "timestamp": "02:08:56", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 7738.87, "timestamp": "02:08:58", "text": "それが楽しくないなら、何が楽しいというのだろう？"}]
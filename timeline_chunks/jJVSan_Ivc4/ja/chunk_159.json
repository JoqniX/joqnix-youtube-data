[{"type": "subtitle", "time": 9542.63, "timestamp": "02:39:02", "text": "幸運を祈る。二人とも"}, {"type": "subtitle", "time": 9544.389, "timestamp": "02:39:04", "text": "良い夜を。行かなきゃ。"}, {"type": "subtitle", "time": 9546.95, "timestamp": "02:39:06", "text": "おやすみ。さようなら。"}, {"type": "subtitle", "time": 9549.03, "timestamp": "02:39:09", "text": "ありがとう 今日は二人とも来てくれてありがとう"}, {"type": "subtitle", "time": 9551.67, "timestamp": "02:39:11", "text": "。ありがとう。"}, {"type": "subtitle", "time": 9554.79, "timestamp": "02:39:14", "text": "そして、私がDMで「今すぐ来て、今すぐ来て」って叫んでたのに、こんなに急に来てくれてありがとう"}, {"type": "subtitle", "time": 9572.07, "timestamp": "02:39:32", "text": "ああ、何か悪いことが起こりそうだ。"}, {"type": "subtitle", "time": 9575.44, "timestamp": "02:39:35", "text": "いやいや、ブラッドが私を呼んでいるんだ。"}, {"type": "subtitle", "time": 9576.55, "timestamp": "02:39:36", "text": "[音楽]"}, {"type": "subtitle", "time": 9579.51, "timestamp": "02:39:39", "text": "とにかく、招待してくれて、来てくれてありがとう。"}, {"type": "subtitle", "time": 9592.55, "timestamp": "02:39:52", "text": "ああ、私たちはアウトロが本当に下手だ。私たちは"}, {"type": "subtitle", "time": 9597.19, "timestamp": "02:39:57", "text": "アウトロが下手だ。"}]
[{"type": "subtitle", "time": 6840.79, "timestamp": "01:54:00", "text": "、君はあのパンなの？   ほら"}, {"type": "subtitle", "time": 6843.189, "timestamp": "01:54:03", "text": "、私が何をしているか知ってるでしょ。   職業は"}, {"type": "subtitle", "time": 6845.83, "timestamp": "01:54:05", "text": "なんですか？   一体"}, {"type": "subtitle", "time": 6849.43, "timestamp": "01:54:09", "text": "どういうことだ？ あなたは私の友達ですか、それとも違いますか？   職業は"}, {"type": "subtitle", "time": 6850.79, "timestamp": "01:54:10", "text": "なんですか？"}, {"type": "subtitle", "time": 6852.79, "timestamp": "01:54:12", "text": "私はあなたを知っています。 どういう意味ですか？"}, {"type": "subtitle", "time": 6853.75, "timestamp": "01:54:13", "text": "私とか、そういう人いる？"}, {"type": "subtitle", "time": 6856.31, "timestamp": "01:54:16", "text": "私はパンです。 ああ、そうしろって言うんだな。"}, {"type": "chat", "time": 6856.524, "timestamp": "01:54:16", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "Zen!???"}, {"type": "subtitle", "time": 6858.47, "timestamp": "01:54:18", "text": "そう、パン。"}, {"type": "subtitle", "time": 6860.629, "timestamp": "01:54:20", "text": "うん。 わからない、わからない、くそ。"}, {"type": "subtitle", "time": 6862.31, "timestamp": "01:54:22", "text": "私は何をしますか？ 何？ どういう意味ですか、"}, {"type": "subtitle", "time": 6863.99, "timestamp": "01:54:23", "text": "ジョー？ 俺のこと知らないのか？"}, {"type": "subtitle", "time": 6865.99, "timestamp": "01:54:25", "text": "ええ、私はパンです。"}, {"type": "subtitle", "time": 6870.629, "timestamp": "01:54:30", "text": "ええ、あなたが挨拶してください。 そう、パン。"}, {"type": "subtitle", "time": 6874.229, "timestamp": "01:54:34", "text": "さて、どんな手のジェスチャーをすればいいのでしょうか？"}, {"type": "chat", "time": 6875.95, "timestamp": "01:54:35", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "you mean zentriya?"}, {"type": "subtitle", "time": 6876.07, "timestamp": "01:54:36", "text": "手のジェスチャー。 ああ、"}, {"type": "subtitle", "time": 6881.589, "timestamp": "01:54:41", "text": "フランス語の「y」、"}, {"type": "subtitle", "time": 6882.95, "timestamp": "01:54:42", "text": "親指と指で作るあのやつ。"}, {"type": "subtitle", "time": 6888.629, "timestamp": "01:54:48", "text": "フランス語の言い方じゃなくて、「指をつまんだ」って言えばいいよ。 そんなことを簡単に言ってはいけない"}, {"type": "subtitle", "time": 6889.109, "timestamp": "01:54:49", "text": "。"}, {"type": "subtitle", "time": 6897.51, "timestamp": "01:54:57", "text": "えっと、どうすればいいの"}]
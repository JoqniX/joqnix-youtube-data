[{"type": "subtitle", "time": 8645.67, "timestamp": "02:24:05", "text": "勝つ確率が12%増えるようなものだと思います。 だから、36"}, {"type": "subtitle", "time": 8652.55, "timestamp": "02:24:12", "text": "。 私は多くの人が"}, {"type": "subtitle", "time": 8654.55, "timestamp": "02:24:14", "text": "そのバナーで50/50のチャンスを2回逃すのを見てきました。 わかった。"}, {"type": "subtitle", "time": 8657.99, "timestamp": "02:24:17", "text": "冗談抜きで。"}, {"type": "subtitle", "time": 8660.469, "timestamp": "02:24:20", "text": "200回の世論調査のうち160回までは、彼らは"}, {"type": "subtitle", "time": 8663.59, "timestamp": "02:24:23", "text": "サーベルを持っていませんでした。"}, {"type": "subtitle", "time": 8674.95, "timestamp": "02:24:34", "text": "そして私は激怒している。 私は激怒した。"}, {"type": "subtitle", "time": 8678.07, "timestamp": "02:24:38", "text": "彼女とライトコインは手に入れたよ。 わかった。"}, {"type": "subtitle", "time": 8681.67, "timestamp": "02:24:41", "text": "何？ そしてライクーン。 何？"}, {"type": "subtitle", "time": 8686.389, "timestamp": "02:24:46", "text": "ニース。 うん、いいねの数には恵まれたよ。"}, {"type": "subtitle", "time": 8689.19, "timestamp": "02:24:49", "text": "待って、バナーを引っ張ると、"}, {"type": "subtitle", "time": 8691.99, "timestamp": "02:24:51", "text": "コインも手に入るよ。"}]
[{"type": "subtitle", "time": 1501.909, "timestamp": "00:25:01", "text": "もし演奏があるなら、演奏しましょう。"}, {"type": "subtitle", "time": 1503.51, "timestamp": "00:25:03", "text": "うん。 麻薬取引の世界がアップデートされる"}, {"type": "subtitle", "time": 1504.63, "timestamp": "00:25:04", "text": "。"}, {"type": "subtitle", "time": 1506.39, "timestamp": "00:25:06", "text": "うん。 うん。"}, {"type": "subtitle", "time": 1508.39, "timestamp": "00:25:08", "text": "君がソロで必死になっていなかったら、一緒にピークをプレイしたかったよ"}, {"type": "subtitle", "time": 1511.11, "timestamp": "00:25:11", "text": "。   わかった"}, {"type": "subtitle", "time": 1512.87, "timestamp": "00:25:12", "text": "。   もし"}, {"type": "subtitle", "time": 1517.59, "timestamp": "00:25:17", "text": "君が一人で必死にプレイしていなかったら、君と一緒にそのゲームをプレイしただろうに"}, {"type": "subtitle", "time": 1525.19, "timestamp": "00:25:25", "text": "私も"}, {"type": "subtitle", "time": 1527.59, "timestamp": "00:25:27", "text": "あなたと麻薬取引に手を出していたでしょう。 でも、あなたが始めたんですよね。18"}, {"type": "subtitle", "time": 1531.75, "timestamp": "00:25:31", "text": "時間くらい配信してたのを見ましたよ。  「いやいや、"}, {"type": "subtitle", "time": 1533.269, "timestamp": "00:25:33", "text": "無理だよ。"}, {"type": "subtitle", "time": 1535.909, "timestamp": "00:25:35", "text": "あいつとは遊ばないよ"}, {"type": "subtitle", "time": 1536.87, "timestamp": "00:25:36", "text": "。"}, {"type": "subtitle", "time": 1539.909, "timestamp": "00:25:39", "text": "あいつは頑張りすぎだよ。」って感じだった。 なぜ？ よし、"}, {"type": "subtitle", "time": 1542.31, "timestamp": "00:25:42", "text": "質問の仕事だ。 サムネイルに"}, {"type": "subtitle", "time": 1545.99, "timestamp": "00:25:45", "text": "分数カウンターが表示されるのはなぜですか？"}, {"type": "subtitle", "time": 1547.43, "timestamp": "00:25:47", "text": "何？"}, {"type": "subtitle", "time": 1552.71, "timestamp": "00:25:52", "text": "サムネイルには30分、36分、32秒と表示されています。"}, {"type": "subtitle", "time": 1555.269, "timestamp": "00:25:55", "text": "何？"}]
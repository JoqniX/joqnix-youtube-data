[{"type": "subtitle", "time": 2340.63, "timestamp": "00:39:00", "text": "そう。それで、ほら、俺の仲間の"}, {"type": "subtitle", "time": 2342.95, "timestamp": "00:39:02", "text": "Moist"}, {"type": "subtitle", "time": 2345.91, "timestamp": "00:39:05", "text": "Criticalがそれについて話してたのを見たんだ。俺の仲間、俺の"}, {"type": "subtitle", "time": 2348.87, "timestamp": "00:39:08", "text": "親友。インターネット"}, {"type": "subtitle", "time": 2350.95, "timestamp": "00:39:10", "text": "でニュースを得る唯一の情報源だよ。"}, {"type": "subtitle", "time": 2354.069, "timestamp": "00:39:14", "text": "それで"}, {"type": "subtitle", "time": 2355.91, "timestamp": "00:39:15", "text": "少し理解できたけど、まだよくわから"}, {"type": "subtitle", "time": 2358.069, "timestamp": "00:39:18", "text": "ない。"}, {"type": "subtitle", "time": 2368.15, "timestamp": "00:39:28", "text": "？それは、コミュニケーション不足"}, {"type": "subtitle", "time": 2370.15, "timestamp": "00:39:30", "text": "と適切な"}, {"type": "subtitle", "time": 2373.51, "timestamp": "00:39:33", "text": "コミュニケーションの欠如のせいだ。もし"}, {"type": "subtitle", "time": 2377.27, "timestamp": "00:39:37", "text": "お金がなくなって、"}, {"type": "subtitle", "time": 2379.43, "timestamp": "00:39:39", "text": "何もかもが尽きていて、チャレンジにそれを言わず、"}, {"type": "subtitle", "time": 2386.39, "timestamp": "00:39:46", "text": "お金を誤用したり、紛失したり、"}, {"type": "subtitle", "time": 2389.349, "timestamp": "00:39:49", "text": "お金の管理をきちんとしていなかったら。そう、"}, {"type": "subtitle", "time": 2391.75, "timestamp": "00:39:51", "text": "VTuber"}, {"type": "subtitle", "time": 2394.63, "timestamp": "00:39:54", "text": "やエージェンシーなどではお金が重要で、たくさんのタレントを"}, {"type": "subtitle", "time": 2398.15, "timestamp": "00:39:58", "text": "管理していると、"}]
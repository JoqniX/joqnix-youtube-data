[{"type": "subtitle", "time": 3841.99, "timestamp": "01:04:01", "text": "ああ、そうだね。あのグループと話してないんだね"}, {"type": "subtitle", "time": 3843.91, "timestamp": "01:04:03", "text": "。ああ、そうだね。"}, {"type": "subtitle", "time": 3845.75, "timestamp": "01:04:05", "text": "いいえ、していません。そうですね"}, {"type": "subtitle", "time": 3849.27, "timestamp": "01:04:09", "text": "。あなたはしていないと思います。ええ、大丈夫です。"}, {"type": "subtitle", "time": 3850.47, "timestamp": "01:04:10", "text": "それは良いことです。"}, {"type": "subtitle", "time": 3852.069, "timestamp": "01:04:12", "text": "バカな"}, {"type": "subtitle", "time": 3859.43, "timestamp": "01:04:19", "text": "ああ、なんてことだ。コメントを見たいだけです"}, {"type": "subtitle", "time": 3867.27, "timestamp": "01:04:27", "text": "こんにちはとか、何かですよね？"}, {"type": "subtitle", "time": 3869.91, "timestamp": "01:04:29", "text": "あなたが何かを言っているのが見えませんでした"}, {"type": "subtitle", "time": 3880.23, "timestamp": "01:04:40", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 3881.67, "timestamp": "01:04:41", "text": "。私たちのストリームに戻りましょう"}, {"type": "subtitle", "time": 3886.39, "timestamp": "01:04:46", "text": "なぜ表示しているのですか？"}, {"type": "subtitle", "time": 3889.27, "timestamp": "01:04:49", "text": "実際にストリームに参加しているのですか？"}, {"type": "subtitle", "time": 3891.27, "timestamp": "01:04:51", "text": "それはあまり良くないですよ、犬。彼らの"}, {"type": "subtitle", "time": 3893.75, "timestamp": "01:04:53", "text": "許可なしに。それはあまり良くないです。"}, {"type": "subtitle", "time": 3896.549, "timestamp": "01:04:56", "text": "待って。待って。他の人のストリームが見つかりません"}, {"type": "subtitle", "time": 3898.549, "timestamp": "01:04:58", "text": "。"}, {"type": "subtitle", "time": 3899.349, "timestamp": "01:04:59", "text": "それは問題です。"}]
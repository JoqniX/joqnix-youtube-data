[{"type": "subtitle", "time": 8464.79, "timestamp": "02:21:04", "text": "この人大きい。"}, {"type": "subtitle", "time": 8475.59, "timestamp": "02:21:15", "text": "アル、いつかこれをPSPにしたらいいよ"}, {"type": "subtitle", "time": 8477.75, "timestamp": "02:21:17", "text": "。"}, {"type": "subtitle", "time": 8480.469, "timestamp": "02:21:20", "text": "ああ、ZZからなんだ。今気づいた。"}, {"type": "subtitle", "time": 8482.15, "timestamp": "02:21:22", "text": "ああ、私はプレイしたことがない。"}, {"type": "subtitle", "time": 8485.19, "timestamp": "02:21:25", "text": "みんなが話していると思う。Zの話をしていたよね。"}, {"type": "subtitle", "time": 8490.71, "timestamp": "02:21:30", "text": "別のゲームだと思った。ああ、なんてことだ。ずっと"}, {"type": "subtitle", "time": 8491.75, "timestamp": "02:21:31", "text": "。"}, {"type": "subtitle", "time": 8493.11, "timestamp": "02:21:33", "text": "ここにいるの？"}, {"type": "subtitle", "time": 8495.03, "timestamp": "02:21:35", "text": "心はここにいるよ。"}, {"type": "subtitle", "time": 8496.63, "timestamp": "02:21:36", "text": "待って、目を覚まして。だから、目を"}, {"type": "subtitle", "time": 8500.79, "timestamp": "02:21:40", "text": "覚まして、ジョー。目を覚まして 起きろよ。目を覚ませよ。"}, {"type": "subtitle", "time": 8502.87, "timestamp": "02:21:42", "text": "そのキャラクターを知らなかったんだ。"}, {"type": "subtitle", "time": 8505.67, "timestamp": "02:21:45", "text": "今までプレイしたこともないし。「ああ、"}, {"type": "subtitle", "time": 8507.51, "timestamp": "02:21:47", "text": "何かのゲームの話をしているのか」って感じだった。  「わからない。」"}, {"type": "subtitle", "time": 8509.51, "timestamp": "02:21:49", "text": "たぶん。ただ、"}, {"type": "subtitle", "time": 8514.15, "timestamp": "02:21:54", "text": "「ああ、あのZZというキャラクターを覚えているよ」と具体的に言っただけだと思う​​。"}, {"type": "subtitle", "time": 8516.23, "timestamp": "02:21:56", "text": "彼女の名前は覚えていない。   確かに"}, {"type": "subtitle", "time": 8517.429, "timestamp": "02:21:57", "text": "そう言いましたよ。   そこにいる"}, {"type": "subtitle", "time": 8518.309, "timestamp": "02:21:58", "text": "？ わかった。"}, {"type": "subtitle", "time": 8519.349, "timestamp": "02:21:59", "text": "あなたはここにいますか？"}, {"type": "subtitle", "time": 8519.75, "timestamp": "02:21:59", "text": "はい。   そこにいる"}]
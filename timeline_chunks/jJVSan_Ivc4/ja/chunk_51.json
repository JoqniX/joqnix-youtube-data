[{"type": "subtitle", "time": 3060.87, "timestamp": "00:51:00", "text": "うん。"}, {"type": "subtitle", "time": 3062.71, "timestamp": "00:51:02", "text": "いや、続けて。やめて。"}, {"type": "subtitle", "time": 3067.91, "timestamp": "00:51:07", "text": "ドキュメンタリーの動画も見たよ。"}, {"type": "subtitle", "time": 3070.39, "timestamp": "00:51:10", "text": "全部は見てないけど。10"}, {"type": "subtitle", "time": 3072.87, "timestamp": "00:51:12", "text": "分で寝ちゃったんだ。午前3時頃だったかな。でも、"}, {"type": "subtitle", "time": 3077.03, "timestamp": "00:51:17", "text": "うん、"}, {"type": "subtitle", "time": 3080.87, "timestamp": "00:51:20", "text": "見なきゃ。どうやって"}, {"type": "subtitle", "time": 3083.349, "timestamp": "00:51:23", "text": "たくさんのものを作ったかの歴史。"}, {"type": "subtitle", "time": 3085.27, "timestamp": "00:51:25", "text": "競馬の歴史とか、ムスリムの歴史とか、"}, {"type": "subtitle", "time": 3088.63, "timestamp": "00:51:28", "text": "どうやって生まれたかとか。"}, {"type": "subtitle", "time": 3089.43, "timestamp": "00:51:29", "text": "すべて。"}, {"type": "subtitle", "time": 3091.91, "timestamp": "00:51:31", "text": "わかった。わかった。わかった。"}, {"type": "subtitle", "time": 3093.91, "timestamp": "00:51:33", "text": "ああ、わかった。質問。"}, {"type": "subtitle", "time": 3095.27, "timestamp": "00:51:35", "text": "アニメは見た？いや、"}, {"type": "subtitle", "time": 3098.87, "timestamp": "00:51:38", "text": "まだ見てない。あのね"}, {"type": "subtitle", "time": 3100.63, "timestamp": "00:51:40", "text": "？"}, {"type": "subtitle", "time": 3104.309, "timestamp": "00:51:44", "text": "アニメを見て"}, {"type": "subtitle", "time": 3107.19, "timestamp": "00:51:47", "text": "ゲームをプレイした者として言わせてもらうと、"}, {"type": "subtitle", "time": 3110.23, "timestamp": "00:51:50", "text": "まずアニメを見ることをお勧めするよ。"}, {"type": "subtitle", "time": 3112.15, "timestamp": "00:51:52", "text": "ああ、"}, {"type": "subtitle", "time": 3114.549, "timestamp": "00:51:54", "text": "そうだね。だって、いきなり"}, {"type": "subtitle", "time": 3116.309, "timestamp": "00:51:56", "text": "ゲームを始めたら、"}, {"type": "subtitle", "time": 3117.67, "timestamp": "00:51:57", "text": "キャラクターがわからないし、何が"}]
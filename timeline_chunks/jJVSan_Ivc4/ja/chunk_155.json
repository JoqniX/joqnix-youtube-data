[{"type": "subtitle", "time": 9301.83, "timestamp": "02:35:01", "text": "ああ、しばらく話していないのはわかっている"}, {"type": "subtitle", "time": 9304.15, "timestamp": "02:35:04", "text": "けど、大丈夫だよ。"}, {"type": "subtitle", "time": 9315.67, "timestamp": "02:35:15", "text": "途中でうめき声を上げるのはやめろ。"}, {"type": "subtitle", "time": 9337.27, "timestamp": "02:35:37", "text": "、ジョー。もう"}, {"type": "subtitle", "time": 9340.95, "timestamp": "02:35:40", "text": "古い冗談は言わないよ。とても怖い。"}, {"type": "subtitle", "time": 9344.469, "timestamp": "02:35:44", "text": "私は君より年上だ。"}, {"type": "subtitle", "time": 9345.75, "timestamp": "02:35:45", "text": "星座より年上だ。ああ。"}, {"type": "subtitle", "time": 9350.16, "timestamp": "02:35:50", "text": "ああ。 おじいちゃんを知らなかったよ、息子よ。"}, {"type": "subtitle", "time": 9354.38, "timestamp": "02:35:54", "text": "おじいちゃんを知らなかったよ、息子よ。 [音楽]"}, {"type": "subtitle", "time": 9355.68, "timestamp": "02:35:55", "text": "[音楽] 私はまだ若い。"}, {"type": "subtitle", "time": 9358.72, "timestamp": "02:35:58", "text": "私はまだ若い。 息子よ。"}]
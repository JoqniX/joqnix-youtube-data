[{"type": "subtitle", "time": 8280.469, "timestamp": "02:18:00", "text": "そうだ。終わったのか？食べたのか？"}, {"type": "subtitle", "time": 8281.669, "timestamp": "02:18:01", "text": "いや、食べない。よくもまあ。"}, {"type": "subtitle", "time": 8287.99, "timestamp": "02:18:07", "text": "よくもまあ食べないなんて。"}, {"type": "subtitle", "time": 8290.629, "timestamp": "02:18:10", "text": "こっちのスポーツマンみたいになりたいのか？"}, {"type": "subtitle", "time": 8292.15, "timestamp": "02:18:12", "text": "近所の人に「お前の親はちゃんと食事を"}, {"type": "subtitle", "time": 8294.23, "timestamp": "02:18:14", "text": "与えているのか、この子？」と言われたいのか？   「"}, {"type": "subtitle", "time": 8296.709, "timestamp": "02:18:16", "text": "彼らは君に食べ物を与えていないのか？」"}, {"type": "subtitle", "time": 8299.509, "timestamp": "02:18:19", "text": "そんな風になりたいのか？"}, {"type": "subtitle", "time": 8301.669, "timestamp": "02:18:21", "text": "おいおい。俺たちは食べなきゃいけないんだぞ。君も"}, {"type": "subtitle", "time": 8312.23, "timestamp": "02:18:32", "text": "何？"}, {"type": "subtitle", "time": 8319.99, "timestamp": "02:18:39", "text": "今日はどうだった？"}, {"type": "subtitle", "time": 8321.99, "timestamp": "02:18:41", "text": "死ぬなよ。"}, {"type": "subtitle", "time": 8327.19, "timestamp": "02:18:47", "text": "[音楽]"}, {"type": "subtitle", "time": 8329.349, "timestamp": "02:18:49", "text": "俺のPFPを見てみろ。この男が死にかけていると思わないのか"}, {"type": "subtitle", "time": 8339.75, "timestamp": "02:18:59", "text": "？見てみろ。オーケー。本当に見てるのか？ちくしょう。"}]
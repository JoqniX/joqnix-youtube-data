[{"type": "subtitle", "time": 8106.149, "timestamp": "02:15:06", "text": "いつでもおかえり。"}, {"type": "subtitle", "time": 8108.79, "timestamp": "02:15:08", "text": "おかえり。猫背の"}, {"type": "subtitle", "time": 8111.43, "timestamp": "02:15:11", "text": "後、また立ち上がったの？"}, {"type": "subtitle", "time": 8114.229, "timestamp": "02:15:14", "text": "まだ猫背だよ。"}, {"type": "subtitle", "time": 8115.35, "timestamp": "02:15:15", "text": "ああ、"}, {"type": "subtitle", "time": 8117.669, "timestamp": "02:15:17", "text": "マイクを近づけただけだよ。わかった、"}, {"type": "subtitle", "time": 8121.03, "timestamp": "02:15:21", "text": "わかった。マイクの方にカバーを動かしただけだよ"}, {"type": "subtitle", "time": 8123.35, "timestamp": "02:15:23", "text": "。猫背だってわかるのは、"}, {"type": "subtitle", "time": 8129.75, "timestamp": "02:15:29", "text": "モデルの首が見えるからだよ"}, {"type": "subtitle", "time": 8140.709, "timestamp": "02:15:40", "text": "。なんてこった。まるで首が飛び出してるみたいだ。でも見えるよ。"}, {"type": "subtitle", "time": 8143.03, "timestamp": "02:15:43", "text": "あぁ、私のスマホのせいかもしれない。"}, {"type": "subtitle", "time": 8153.43, "timestamp": "02:15:53", "text": "DTLSって何？"}, {"type": "subtitle", "time": 8154.31, "timestamp": "02:15:54", "text": "新しいね。それは"}, {"type": "subtitle", "time": 8157.43, "timestamp": "02:15:57", "text": "ただ、"}]
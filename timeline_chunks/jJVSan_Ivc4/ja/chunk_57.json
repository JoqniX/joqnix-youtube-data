[{"type": "subtitle", "time": 3421.67, "timestamp": "00:57:01", "text": "ああ、"}, {"type": "subtitle", "time": 3424.549, "timestamp": "00:57:04", "text": "文学を勉強しているのに、私はそれが苦手なんです。全然"}, {"type": "subtitle", "time": 3426.95, "timestamp": "00:57:06", "text": "理解できませんでした。"}, {"type": "subtitle", "time": 3428.789, "timestamp": "00:57:08", "text": "彼は文学を勉強していたのに、それが苦手だったんですね"}, {"type": "subtitle", "time": 3431.109, "timestamp": "00:57:11", "text": "。"}, {"type": "subtitle", "time": 3433.19, "timestamp": "00:57:13", "text": "うん。要点が全然分からなかったんだよ"}, {"type": "subtitle", "time": 3435.27, "timestamp": "00:57:15", "text": "、相棒。要点が全然分からなかった"}, {"type": "subtitle", "time": 3442.87, "timestamp": "00:57:22", "text": "でも、ええ、でも、"}, {"type": "subtitle", "time": 3445.03, "timestamp": "00:57:25", "text": "ええ、ウェブ"}, {"type": "subtitle", "time": 3451.829, "timestamp": "00:57:31", "text": "サイトで伝承とかを早く見たいです。"}, {"type": "subtitle", "time": 3454.069, "timestamp": "00:57:34", "text": "ええ、それを更新する必要があります。ええ。"}, {"type": "subtitle", "time": 3458.47, "timestamp": "00:57:38", "text": "一冊の本を書かなければなりません。1ページではなく、"}, {"type": "subtitle", "time": 3461.829, "timestamp": "00:57:41", "text": "複数のページに分けて書く必要があると思います。ちょっと待ってください。分かりません。つまり、"}, {"type": "subtitle", "time": 3471.349, "timestamp": "00:57:51", "text": "どこかにホストして、"}, {"type": "subtitle", "time": 3473.349, "timestamp": "00:57:53", "text": "Notionか何かに置いて、"}, {"type": "subtitle", "time": 3476.63, "timestamp": "00:57:56", "text": "そこに置けば、"}]
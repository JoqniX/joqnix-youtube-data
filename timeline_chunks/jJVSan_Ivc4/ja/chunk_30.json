[{"type": "subtitle", "time": 1801.11, "timestamp": "00:30:01", "text": "ああ、なんてことだ。  OBSみたいにMを使ってるんだけど"}, {"type": "subtitle", "time": 1804.23, "timestamp": "00:30:04", "text": "、"}, {"type": "subtitle", "time": 1807.11, "timestamp": "00:30:07", "text": "そういう機能があるから理解できたよ。"}, {"type": "subtitle", "time": 1807.51, "timestamp": "00:30:07", "text": "でも"}, {"type": "subtitle", "time": 1810.31, "timestamp": "00:30:10", "text": "なんでこれに切り替えたの？"}, {"type": "subtitle", "time": 1812.789, "timestamp": "00:30:12", "text": "でもMELだから、"}, {"type": "subtitle", "time": 1815.909, "timestamp": "00:30:15", "text": "ビットレートが低いと低くなることに気づいたんだ。"}, {"type": "subtitle", "time": 1817.83, "timestamp": "00:30:17", "text": "あ、あ、待って。"}, {"type": "subtitle", "time": 1820.71, "timestamp": "00:30:20", "text": "君が教えてくれたゲームをダウンロードしてるからだよ。だからああ、なんてこった"}, {"type": "subtitle", "time": 1823.029, "timestamp": "00:30:23", "text": "。今すぐダウンロードする必要はないよ。わかった"}, {"type": "subtitle", "time": 1826.23, "timestamp": "00:30:26", "text": "。わかった。また上がってくるはずだ。わかった。"}, {"type": "subtitle", "time": 1828.47, "timestamp": "00:30:28", "text": "上がってくるはずだ"}, {"type": "subtitle", "time": 1831.269, "timestamp": "00:30:31", "text": "。上がってくるのを見てみよう。わかった"}, {"type": "subtitle", "time": 1832.47, "timestamp": "00:30:32", "text": "。"}, {"type": "subtitle", "time": 1833.269, "timestamp": "00:30:33", "text": "今ダウンロード中だ。50"}, {"type": "subtitle", "time": 1834.789, "timestamp": "00:30:34", "text": "秒だ。"}, {"type": "subtitle", "time": 1838.389, "timestamp": "00:30:38", "text": "明日とかにプレイしよう"}, {"type": "subtitle", "time": 1845.51, "timestamp": "00:30:45", "text": "40秒の遅延があるけど、わかった。いずれ"}, {"type": "subtitle", "time": 1849.35, "timestamp": "00:30:49", "text": "追いつくよ。そう願ってる。"}, {"type": "subtitle", "time": 1852.07, "timestamp": "00:30:52", "text": "うん、ゆっくり追いついてる。でも、ビット"}]
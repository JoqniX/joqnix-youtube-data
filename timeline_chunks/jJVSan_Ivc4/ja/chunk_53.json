[{"type": "subtitle", "time": 3180.71, "timestamp": "00:53:00", "text": "。だって、"}, {"type": "subtitle", "time": 3183.43, "timestamp": "00:53:03", "text": "アニメで一番好きなキャラクターは"}, {"type": "subtitle", "time": 3185.67, "timestamp": "00:53:05", "text": "すごく強いんだ。すごくいいんだよ。でも"}, {"type": "subtitle", "time": 3189.19, "timestamp": "00:53:09", "text": "、ゲームでは最悪なんだ。"}, {"type": "subtitle", "time": 3193.43, "timestamp": "00:53:13", "text": "彼女で何も勝てない。例えば、一番"}, {"type": "subtitle", "time": 3195.109, "timestamp": "00:53:15", "text": "好きな"}, {"type": "subtitle", "time": 3198.549, "timestamp": "00:53:18", "text": "キャラクターの名前はマジュ・マックィーン。"}, {"type": "subtitle", "time": 3200.549, "timestamp": "00:53:20", "text": "ああ、君が彼女を知らなくても大丈夫だよ"}, {"type": "subtitle", "time": 3201.109, "timestamp": "00:53:21", "text": "。僕は"}, {"type": "subtitle", "time": 3202.63, "timestamp": "00:53:22", "text": "知ってる。うん。"}, {"type": "subtitle", "time": 3205.27, "timestamp": "00:53:25", "text": "いや、"}, {"type": "subtitle", "time": 3206.87, "timestamp": "00:53:26", "text": "赤い車のことじゃない。"}, {"type": "subtitle", "time": 3209.51, "timestamp": "00:53:29", "text": "マックィーンじゃない。"}, {"type": "subtitle", "time": 3213.349, "timestamp": "00:53:33", "text": "紫色の髪でティーカップを持って"}, {"type": "subtitle", "time": 3216.39, "timestamp": "00:53:36", "text": "お茶を飲むのが好きな女性のことだよ"}, {"type": "subtitle", "time": 3219.589, "timestamp": "00:53:39", "text": "。うん、君は知ってるよね。"}, {"type": "subtitle", "time": 3221.829, "timestamp": "00:53:41", "text": "彼は知らない。"}, {"type": "subtitle", "time": 3224.23, "timestamp": "00:53:44", "text": "もちろん、"}, {"type": "subtitle", "time": 3225.43, "timestamp": "00:53:45", "text": "もちろん。"}, {"type": "subtitle", "time": 3230.069, "timestamp": "00:53:50", "text": "君のバカな頭はきっと「"}, {"type": "subtitle", "time": 3231.75, "timestamp": "00:53:51", "text": "ああ、マックィーンか」って思うだろうと思ってたんだ。もちろん。"}, {"type": "subtitle", "time": 3235.27, "timestamp": "00:53:55", "text": "最初はそう思った。"}, {"type": "subtitle", "time": 3238.39, "timestamp": "00:53:58", "text": "いや、間違ってなかった。最初に"}]
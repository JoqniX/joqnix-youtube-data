[{"type": "subtitle", "time": 3001.589, "timestamp": "00:50:01", "text": "喋ったり"}, {"type": "subtitle", "time": 3010.47, "timestamp": "00:50:10", "text": "えーと、仕事 いろいろ。"}, {"type": "subtitle", "time": 3013.43, "timestamp": "00:50:13", "text": "最近はそういうのをたくさんやってるんだけど、"}, {"type": "subtitle", "time": 3021.99, "timestamp": "00:50:21", "text": "仲間のジョッキーが"}, {"type": "subtitle", "time": 3024.309, "timestamp": "00:50:24", "text": "自分のことをやってるのはいいことだね。"}, {"type": "subtitle", "time": 3027.27, "timestamp": "00:50:27", "text": "うん。あと、"}, {"type": "subtitle", "time": 3031.51, "timestamp": "00:50:31", "text": "これは今すごく人気だからね。ほら、今すごく"}, {"type": "subtitle", "time": 3033.589, "timestamp": "00:50:33", "text": "人気で、"}, {"type": "subtitle", "time": 3036.309, "timestamp": "00:50:36", "text": "VTuber、"}, {"type": "subtitle", "time": 3040.15, "timestamp": "00:50:40", "text": "友達、ちょっとオタクっぽいクソ野郎、"}, {"type": "subtitle", "time": 3042.309, "timestamp": "00:50:42", "text": "みんながやってるのは、"}, {"type": "subtitle", "time": 3044.79, "timestamp": "00:50:44", "text": "ウマル・ムスをプレイすることなんだ。"}, {"type": "subtitle", "time": 3047.99, "timestamp": "00:50:47", "text": "ああ、そうだね。うん。まだだよ。まだだよ。まだだよ。"}, {"type": "subtitle", "time": 3051.67, "timestamp": "00:50:51", "text": "インストールはしたけど"}, {"type": "subtitle", "time": 3053.43, "timestamp": "00:50:53", "text": "、開いたり触ったりはしてない。"}, {"type": "subtitle", "time": 3056.87, "timestamp": "00:50:56", "text": "プレイしてる人を見ただけ。"}, {"type": "subtitle", "time": 3059.589, "timestamp": "00:50:59", "text": "ジョエルに質問があるんだけど。"}]
[{"type": "subtitle", "time": 3361.51, "timestamp": "00:56:01", "text": "。誰も"}, {"type": "subtitle", "time": 3364.069, "timestamp": "00:56:04", "text": "自分で宣伝するのを止めないよ。"}, {"type": "subtitle", "time": 3365.43, "timestamp": "00:56:05", "text": "誰が反対するんだ？俺が"}, {"type": "subtitle", "time": 3368.15, "timestamp": "00:56:08", "text": "反対する。そうだな。自分で遊んでるんだな。俺は"}, {"type": "subtitle", "time": 3378.71, "timestamp": "00:56:18", "text": "うん、大丈夫だよ。心配しないで。"}, {"type": "subtitle", "time": 3380.23, "timestamp": "00:56:20", "text": "どこ？何？"}, {"type": "subtitle", "time": 3383.91, "timestamp": "00:56:23", "text": "いや、気にしないで。気にしないで"}, {"type": "subtitle", "time": 3386.15, "timestamp": "00:56:26", "text": "。違うよ。行くよ。"}, {"type": "subtitle", "time": 3387.829, "timestamp": "00:56:27", "text": "待って。うん、そうだよ。そうだよ。いや、いや、いや、いや、いや、"}, {"type": "subtitle", "time": 3391.43, "timestamp": "00:56:31", "text": "いや。ごめん。"}, {"type": "subtitle", "time": 3393.75, "timestamp": "00:56:33", "text": "伝承に追加されるべきだよ。"}, {"type": "subtitle", "time": 3394.069, "timestamp": "00:56:34", "text": "うん。"}, {"type": "subtitle", "time": 3397.67, "timestamp": "00:56:37", "text": "いや、伝承に追加されるべきだよ。そう"}, {"type": "subtitle", "time": 3399.75, "timestamp": "00:56:39", "text": "言うと、まだ"}, {"type": "subtitle", "time": 3402.71, "timestamp": "00:56:42", "text": "伝承に取り組まなくちゃいけないんだ。 いいえ"}, {"type": "subtitle", "time": 3406.789, "timestamp": "00:56:46", "text": "。私のパンってどういう意味ですか？つまり、"}, {"type": "subtitle", "time": 3409.99, "timestamp": "00:56:49", "text": "あなたはそうすべきです。私はそうすべきです"}, {"type": "subtitle", "time": 3412.549, "timestamp": "00:56:52", "text": "。はい。はい。"}, {"type": "subtitle", "time": 3416.549, "timestamp": "00:56:56", "text": "はい。あなたの、えっと、何て言うんでしたっけ"}, {"type": "subtitle", "time": 3419.51, "timestamp": "00:56:59", "text": "？文学のスキルをうまく使いこなしてください。"}]
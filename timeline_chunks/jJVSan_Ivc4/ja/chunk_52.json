[{"type": "subtitle", "time": 3122.23, "timestamp": "00:52:02", "text": "起こっているのかもわからない。例えば、「わかった、"}, {"type": "subtitle", "time": 3124.069, "timestamp": "00:52:04", "text": "この子は新しい子だ」って感じ。まるで"}, {"type": "subtitle", "time": 3128.71, "timestamp": "00:52:08", "text": "ガスパールのゲームみたいにプレイすることになるよ。それに、君はきっと"}, {"type": "subtitle", "time": 3134.549, "timestamp": "00:52:14", "text": "メタキャラを手に入れるんだろうね。「メタキャラが欲しい。"}, {"type": "subtitle", "time": 3137.91, "timestamp": "00:52:17", "text": "助けてくれるから。"}, {"type": "subtitle", "time": 3147.19, "timestamp": "00:52:27", "text": "そのゲームのキャラクターは"}, {"type": "subtitle", "time": 3148.39, "timestamp": "00:52:28", "text": "星1つくらいだからね。"}, {"type": "subtitle", "time": 3151.19, "timestamp": "00:52:31", "text": "だから、君はきっとそうすると思うよ。それに"}, {"type": "subtitle", "time": 3153.51, "timestamp": "00:52:33", "text": "、最初のプレイでは無料キャラクターがもらえるんだ"}, {"type": "subtitle", "time": 3155.75, "timestamp": "00:52:35", "text": "。だから、君はきっと"}, {"type": "subtitle", "time": 3160.15, "timestamp": "00:52:40", "text": "ウマ娘の攻略ガイドとかを見て、そうするんだろうね。いや、そんなことしないで。"}, {"type": "subtitle", "time": 3163.43, "timestamp": "00:52:43", "text": "それだよ。"}, {"type": "subtitle", "time": 3167.349, "timestamp": "00:52:47", "text": "アニメを見て、"}, {"type": "subtitle", "time": 3169.27, "timestamp": "00:52:49", "text": "そのアニメで一番好きなキャラクターを知って"}, {"type": "subtitle", "time": 3172.71, "timestamp": "00:52:52", "text": "、それから"}, {"type": "subtitle", "time": 3175.91, "timestamp": "00:52:55", "text": "ゲームでそのキャラクターとレースしないといけないんだ。"}, {"type": "subtitle", "time": 3177.99, "timestamp": "00:52:57", "text": "よし、そうするしかない"}]
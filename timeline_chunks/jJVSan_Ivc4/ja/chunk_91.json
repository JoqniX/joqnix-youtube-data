[{"type": "subtitle", "time": 5462.07, "timestamp": "01:31:02", "text": "またタブを閉じた。いや、ちょっと待って。"}, {"type": "subtitle", "time": 5467.11, "timestamp": "01:31:07", "text": "うん、大好きだよ。それから、"}, {"type": "subtitle", "time": 5471.189, "timestamp": "01:31:11", "text": "歌って、それから、"}, {"type": "subtitle", "time": 5476.87, "timestamp": "01:31:16", "text": "そう、それからゼノ、それから"}, {"type": "subtitle", "time": 5479.83, "timestamp": "01:31:19", "text": "ハンハンとスシ。他に"}, {"type": "subtitle", "time": 5483.27, "timestamp": "01:31:23", "text": "何？他に誰が？えっと、それから、"}, {"type": "subtitle", "time": 5488.47, "timestamp": "01:31:28", "text": "ダックダックグースダックをやった。グースグースダック"}, {"type": "subtitle", "time": 5491.27, "timestamp": "01:31:31", "text": "。そのゲーム知らない。"}, {"type": "subtitle", "time": 5491.99, "timestamp": "01:31:31", "text": "ダックザグース。"}, {"type": "subtitle", "time": 5496.149, "timestamp": "01:31:36", "text": "ダックダックグース。そう、そのゲーム。"}, {"type": "subtitle", "time": 5497.75, "timestamp": "01:31:37", "text": "そして、"}, {"type": "subtitle", "time": 5499.83, "timestamp": "01:31:39", "text": "そう。"}, {"type": "subtitle", "time": 5513.99, "timestamp": "01:31:53", "text": "残りは"}]
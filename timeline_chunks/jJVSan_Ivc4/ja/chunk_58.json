[{"type": "subtitle", "time": 3482.309, "timestamp": "00:58:02", "text": "ガイドラインとか"}, {"type": "subtitle", "time": 3484.95, "timestamp": "00:58:04", "text": "全部手動でハードコーディングするよりも簡単に編集できると思います。今、それをそうします"}, {"type": "subtitle", "time": 3491.03, "timestamp": "00:58:11", "text": "。つまり、マークダウンでできます。"}, {"type": "subtitle", "time": 3493.43, "timestamp": "00:58:13", "text": "すべてマークダウンで書いて、見出しなどを追加してください。"}, {"type": "subtitle", "time": 3506.87, "timestamp": "00:58:26", "text": "いろいろあるよ。"}, {"type": "subtitle", "time": 3513.829, "timestamp": "00:58:33", "text": "ローラ・クーン、"}, {"type": "subtitle", "time": 3516.15, "timestamp": "00:58:36", "text": "D&Dをやっているから、次は"}, {"type": "subtitle", "time": 3518.71, "timestamp": "00:58:38", "text": "スター・ドルイドのジョークの伝承とバックストーリーについて考えなきゃいけないんだ"}, {"type": "subtitle", "time": 3520.549, "timestamp": "00:58:40", "text": "。"}, {"type": "subtitle", "time": 3522.549, "timestamp": "00:58:42", "text": "ああ、それはあなたが書くべきだよ。"}, {"type": "subtitle", "time": 3524.789, "timestamp": "00:58:44", "text": "私の意見では、それはとても楽しいから。"}, {"type": "subtitle", "time": 3528.47, "timestamp": "00:58:48", "text": "友達とD&Dをプレイしていたとき。"}, {"type": "subtitle", "time": 3531.19, "timestamp": "00:58:51", "text": "ああ、プレイしたのね。"}, {"type": "subtitle", "time": 3533.43, "timestamp": "00:58:53", "text": "一度プレイしたけど、理解できなかった。みんなに"}, {"type": "subtitle", "time": 3535.67, "timestamp": "00:58:55", "text": "怒鳴られて、二度とプレイしなかった。"}]
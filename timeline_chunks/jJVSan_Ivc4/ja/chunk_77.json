[{"type": "subtitle", "time": 4639.51, "timestamp": "01:17:19", "text": "とても奇妙に見えます。"}, {"type": "subtitle", "time": 4643.86, "timestamp": "01:17:23", "text": "実際、とても奇妙に見えます。"}, {"type": "subtitle", "time": 4647.11, "timestamp": "01:17:27", "text": "[音楽]"}, {"type": "subtitle", "time": 4654.79, "timestamp": "01:17:34", "text": "こんにちは。サムネイルを更新しました。"}, {"type": "subtitle", "time": 4659.11, "timestamp": "01:17:39", "text": "サムネイルに数字はもうありません。あれは"}, {"type": "subtitle", "time": 4660.79, "timestamp": "01:17:40", "text": "何だったのでしょう？"}, {"type": "subtitle", "time": 4667.83, "timestamp": "01:17:47", "text": "ガイドです。"}, {"type": "subtitle", "time": 4678.31, "timestamp": "01:17:58", "text": "私は男でした。ガイドです。"}]
[{"type": "subtitle", "time": 1020.069, "timestamp": "00:17:00", "text": "基本的なことだけを考えていました。 うん。"}, {"type": "subtitle", "time": 1022.389, "timestamp": "00:17:02", "text": "裁判の様子を見て、どうなるか確かめたかっただけです"}, {"type": "subtitle", "time": 1025.35, "timestamp": "00:17:05", "text": "。 それから、将来"}, {"type": "subtitle", "time": 1028.15, "timestamp": "00:17:08", "text": "デビューしたりする時のことを考えました。 いいえ、そのためには"}, {"type": "subtitle", "time": 1040.549, "timestamp": "00:17:20", "text": "。"}, {"type": "subtitle", "time": 1042.87, "timestamp": "00:17:22", "text": "私の意見では、うまくいくと思います。"}, {"type": "subtitle", "time": 1043.829, "timestamp": "00:17:23", "text": "ああ、そうだね"}, {"type": "subtitle", "time": 1045.669, "timestamp": "00:17:25", "text": "。"}, {"type": "subtitle", "time": 1047.75, "timestamp": "00:17:27", "text": "ええ、最近はそれと"}, {"type": "subtitle", "time": 1049.51, "timestamp": "00:17:29", "text": "これをやっています。"}, {"type": "subtitle", "time": 1050.15, "timestamp": "00:17:30", "text": "だから、何か"}, {"type": "subtitle", "time": 1052.87, "timestamp": "00:17:32", "text": "すること、つまり、"}, {"type": "subtitle", "time": 1056.07, "timestamp": "00:17:36", "text": "すごく素敵なことってことだよね。"}, {"type": "subtitle", "time": 1057.99, "timestamp": "00:17:37", "text": "ああ、サムネイルを見たばかりだ。"}, {"type": "subtitle", "time": 1060.31, "timestamp": "00:17:40", "text": "馬鹿げてる。"}, {"type": "subtitle", "time": 1066.31, "timestamp": "00:17:46", "text": "なぜこんなに間抜けに見えるのか？ それが"}, {"type": "subtitle", "time": 1067.75, "timestamp": "00:17:47", "text": "あなたの持っていた唯一のものだったのですか？"}, {"type": "subtitle", "time": 1072.23, "timestamp": "00:17:52", "text": "待って、それはあなたが私に送ってきたものですね。"}, {"type": "subtitle", "time": 1074.47, "timestamp": "00:17:54", "text": "ああ、神様。"}, {"type": "subtitle", "time": 1076.15, "timestamp": "00:17:56", "text": "あのね？ 次は、ジョー、次は"}]
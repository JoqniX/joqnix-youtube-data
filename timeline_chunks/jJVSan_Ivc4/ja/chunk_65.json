[{"type": "subtitle", "time": 3903.43, "timestamp": "01:05:03", "text": "ええ。なぜあなたのストリームが見えないのですか？"}, {"type": "subtitle", "time": 3905.349, "timestamp": "01:05:05", "text": "今何を検索していますか？それは"}, {"type": "subtitle", "time": 3909.43, "timestamp": "01:05:09", "text": "ドロイドのサークルですか？ええ。"}, {"type": "subtitle", "time": 3909.99, "timestamp": "01:05:09", "text": "ああ、"}, {"type": "subtitle", "time": 3913.109, "timestamp": "01:05:13", "text": "これを調べていました。"}, {"type": "subtitle", "time": 3915.99, "timestamp": "01:05:15", "text": "それで、それは何と呼ばれていますか？学者と"}, {"type": "subtitle", "time": 3918.39, "timestamp": "01:05:18", "text": "知識が話しています。私は"}, {"type": "subtitle", "time": 3920.789, "timestamp": "01:05:20", "text": "このゲームについての知識さえ知りません。"}, {"type": "subtitle", "time": 3922.95, "timestamp": "01:05:22", "text": "それについてはビデオを見るべきです。ほら"}, {"type": "subtitle", "time": 3926.069, "timestamp": "01:05:26", "text": "、"}, {"type": "subtitle", "time": 3935.029, "timestamp": "01:05:35", "text": "こんにちは。戻ってきました。"}, {"type": "subtitle", "time": 3936.71, "timestamp": "01:05:36", "text": "私たちのストリームに戻ってきました。なぜなら、あの"}, {"type": "subtitle", "time": 3938.71, "timestamp": "01:05:38", "text": "人たちは あの人たちは"}, {"type": "subtitle", "time": 3941.029, "timestamp": "01:05:41", "text": "楽しんでるんだ。まあ、ちょっとだけ顔を出しただけだよ。ちょっとしたいたずらっ子みたいな感じで、"}, {"type": "subtitle", "time": 3945.109, "timestamp": "01:05:45", "text": "ちょっとした"}, {"type": "subtitle", "time": 3948.95, "timestamp": "01:05:48", "text": "イタズラみたいな。大したことじゃない。スミが大好き。"}, {"type": "subtitle", "time": 3951.589, "timestamp": "01:05:51", "text": "スミが配信を見てたら、"}, {"type": "subtitle", "time": 3955.51, "timestamp": "01:05:55", "text": "彼女が好きになる。彼女はすごくいい人。彼女の"}, {"type": "subtitle", "time": 3957.51, "timestamp": "01:05:57", "text": "Minecraftの配信とかが大好き。彼女はすごく"}, {"type": "subtitle", "time": 3959.589, "timestamp": "01:05:59", "text": "いい人で、すごく面白い。たぶんフォローした方がいいと思う"}]
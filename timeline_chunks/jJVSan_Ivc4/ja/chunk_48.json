[{"type": "subtitle", "time": 2881.51, "timestamp": "00:48:01", "text": "俺はイメージしようとしてたんだ。みんな"}, {"type": "subtitle", "time": 2884.79, "timestamp": "00:48:04", "text": "すごく早口で話してたから、"}, {"type": "subtitle", "time": 2887.829, "timestamp": "00:48:07", "text": "頭の中で小さなスライドショーを見てたんだ。うん"}, {"type": "subtitle", "time": 2888.71, "timestamp": "00:48:08", "text": "。"}, {"type": "subtitle", "time": 2891.43, "timestamp": "00:48:11", "text": "小さなスライドショーみたいな感じ。ああ、そうだ。"}, {"type": "subtitle", "time": 2894.15, "timestamp": "00:48:14", "text": "小さなベッドの男が"}, {"type": "subtitle", "time": 2897.75, "timestamp": "00:48:17", "text": "タブレットを売り歩き回ってる。ああ、そうだ。小さな"}, {"type": "subtitle", "time": 2899.829, "timestamp": "00:48:19", "text": "悪者。"}, {"type": "subtitle", "time": 2901.349, "timestamp": "00:48:21", "text": "お前はクソだ"}, {"type": "subtitle", "time": 2905.109, "timestamp": "00:48:25", "text": "。お前は最低だ。おい。そうだ。おい、おい。"}, {"type": "subtitle", "time": 2906.95, "timestamp": "00:48:26", "text": "お前の仲間がここにいる。彼は"}, {"type": "subtitle", "time": 2909.51, "timestamp": "00:48:29", "text": "今自分の気持ちを表現してるのに、"}, {"type": "subtitle", "time": 2912.39, "timestamp": "00:48:32", "text": "あそこで"}, {"type": "subtitle", "time": 2914.47, "timestamp": "00:48:34", "text": "棒人間として想像してるんだ。"}, {"type": "subtitle", "time": 2916.95, "timestamp": "00:48:36", "text": "頭の中で人間としてさえ想像してないんだ。"}, {"type": "subtitle", "time": 2924.069, "timestamp": "00:48:44", "text": "？ まるで私の"}, {"type": "subtitle", "time": 2926.39, "timestamp": "00:48:46", "text": "仲間がその時すごくぼーっとしていたみたい。"}, {"type": "subtitle", "time": 2929.43, "timestamp": "00:48:49", "text": "棒人間のことを考えてたんだ。"}, {"type": "subtitle", "time": 2932.549, "timestamp": "00:48:52", "text": "ああ、もう。もう"}, {"type": "subtitle", "time": 2934.79, "timestamp": "00:48:54", "text": "自分の話は十分だと思う。"}, {"type": "subtitle", "time": 2936.309, "timestamp": "00:48:56", "text": "ありがとう、ジョブ。おいおい"}]
[{"type": "subtitle", "time": 1444.31, "timestamp": "00:24:04", "text": "公式ゲームがリリースされたら、"}, {"type": "subtitle", "time": 1447.029, "timestamp": "00:24:07", "text": "バイオームなどをさらに追加する予定だそうです"}, {"type": "subtitle", "time": 1449.27, "timestamp": "00:24:09", "text": "。 でも今のところ、バイオームは"}, {"type": "subtitle", "time": 1453.029, "timestamp": "00:24:13", "text": "私たちが歩き回っていたものだけです。"}, {"type": "subtitle", "time": 1456.47, "timestamp": "00:24:16", "text": "ああ、あの島に行くのに役立つクエストが追加されることを期待したいですね"}, {"type": "subtitle", "time": 1461.19, "timestamp": "00:24:21", "text": "。 私が聞いたのはそういうことです。"}, {"type": "subtitle", "time": 1463.83, "timestamp": "00:24:23", "text": "ああ、"}, {"type": "subtitle", "time": 1466.789, "timestamp": "00:24:26", "text": "そうだね。"}, {"type": "subtitle", "time": 1468.15, "timestamp": "00:24:28", "text": "バン。"}, {"type": "subtitle", "time": 1469.43, "timestamp": "00:24:29", "text": "[音楽]"}, {"type": "subtitle", "time": 1471.83, "timestamp": "00:24:31", "text": "うん。"}, {"type": "subtitle", "time": 1474.47, "timestamp": "00:24:34", "text": "私はああいうゲームが好きです。 つまり、そう、だから"}, {"type": "subtitle", "time": 1476.87, "timestamp": "00:24:36", "text": "選んだんだ。"}, {"type": "subtitle", "time": 1479.19, "timestamp": "00:24:39", "text": "一緒にいるとすごく楽しかったから。 私たちは本当にたくさんの"}, {"type": "subtitle", "time": 1480.71, "timestamp": "00:24:40", "text": "愚かなことをしていた。"}, {"type": "subtitle", "time": 1481.11, "timestamp": "00:24:41", "text": "はい。"}, {"type": "subtitle", "time": 1481.51, "timestamp": "00:24:41", "text": "すばらしい。"}, {"type": "subtitle", "time": 1483.269, "timestamp": "00:24:43", "text": "ええ、私たちは"}, {"type": "subtitle", "time": 1485.35, "timestamp": "00:24:45", "text": "素晴らしかったですよ。"}, {"type": "subtitle", "time": 1488.149, "timestamp": "00:24:48", "text": "素晴らしい。"}, {"type": "subtitle", "time": 1490.39, "timestamp": "00:24:50", "text": "はい。   いやあ"}, {"type": "subtitle", "time": 1492.63, "timestamp": "00:24:52", "text": "、本当に楽しい時間だったよ"}, {"type": "subtitle", "time": 1494.149, "timestamp": 
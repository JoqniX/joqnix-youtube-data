[{"type": "subtitle", "time": 1620.07, "timestamp": "00:27:00", "text": "おかしいですね。"}, {"type": "subtitle", "time": 1623.029, "timestamp": "00:27:03", "text": "ジョーは椅子にだらりと座っていたと思うが、"}, {"type": "subtitle", "time": 1625.99, "timestamp": "00:27:05", "text": "立ち上がった。"}, {"type": "subtitle", "time": 1628.39, "timestamp": "00:27:08", "text": "え、どうして分かったの？ どうやって君の椅子の音が"}, {"type": "subtitle", "time": 1630.63, "timestamp": "00:27:10", "text": "聞こえたんだ、君の"}, {"type": "subtitle", "time": 1638.95, "timestamp": "00:27:18", "text": "ええ、私が猫背になっていたら、彼が立ち上がったんです。"}, {"type": "subtitle", "time": 1641.11, "timestamp": "00:27:21", "text": "うん、それで「よし、"}, {"type": "subtitle", "time": 1653.269, "timestamp": "00:27:33", "text": "。それで、"}, {"type": "subtitle", "time": 1656.149, "timestamp": "00:27:36", "text": "今直したいのか？直してやるよ。"}, {"type": "subtitle", "time": 1661.99, "timestamp": "00:27:41", "text": "ああ、そうだな"}, {"type": "subtitle", "time": 1666.07, "timestamp": "00:27:46", "text": "。最近どんな"}, {"type": "subtitle", "time": 1667.83, "timestamp": "00:27:47", "text": "ゲームをプレイしてる"}, {"type": "subtitle", "time": 1669.99, "timestamp": "00:27:49", "text": "？"}, {"type": "subtitle", "time": 1671.99, "timestamp": "00:27:51", "text": "ええと、"}, {"type": "subtitle", "time": 1675.029, "timestamp": "00:27:55", "text": "そうだな。今月はとにかく"}, {"type": "subtitle", "time": 1679.909, "timestamp": "00:27:59", "text": "退屈だったんだ。すごく"}]
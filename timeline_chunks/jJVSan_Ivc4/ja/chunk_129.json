[{"type": "subtitle", "time": 7749.03, "timestamp": "02:09:09", "text": "ああ、もう。"}, {"type": "subtitle", "time": 7751.83, "timestamp": "02:09:11", "text": "私はこれが大好きです。"}, {"type": "subtitle", "time": 7754.95, "timestamp": "02:09:14", "text": "寝ていなかったことを願います。"}, {"type": "subtitle", "time": 7755.75, "timestamp": "02:09:15", "text": "ようこそ。"}, {"type": "subtitle", "time": 7757.51, "timestamp": "02:09:17", "text": "ええ、もしよろしければ、"}, {"type": "subtitle", "time": 7760.79, "timestamp": "02:09:20", "text": "すぐに参加したくない場合は、もちろん構いませんよ。"}, {"type": "subtitle", "time": 7763.589, "timestamp": "02:09:23", "text": "心配ない。"}, {"type": "subtitle", "time": 7764.149, "timestamp": "02:09:24", "text": "後でいつでも一緒に遊べるよ。"}, {"type": "subtitle", "time": 7766.229, "timestamp": "02:09:26", "text": "10分くらいで降りるよ。 私は降ります"}, {"type": "subtitle", "time": 7769.109, "timestamp": "02:09:29", "text": "。 私たちはただ話していたのですが、"}, {"type": "subtitle", "time": 7771.51, "timestamp": "02:09:31", "text": "私の頭の中であなたの声が聞こえてきて、"}, {"type": "subtitle", "time": 7773.589, "timestamp": "02:09:33", "text": "私は「ねえ、知ってる？」と思いました。   今、"}, {"type": "subtitle", "time": 7778.069, "timestamp": "02:09:38", "text": "アルスが必要だ。 彼が必要だ。"}, {"type": "subtitle", "time": 7780.55, "timestamp": "02:09:40", "text": "彼が必要なんだ。   先ほど"}, {"type": "subtitle", "time": 7782.39, "timestamp": "02:09:42", "text": "DMを送りました。"}, {"type": "subtitle", "time": 7784.069, "timestamp": "02:09:44", "text": "あなたがそうだったとは知りませんでした。実は、"}, {"type": "subtitle", "time": 7785.589, "timestamp": "02:09:45", "text": "あなたは返信しないだろうと思っていて、"}, {"type": "subtitle", "time": 7789.75, "timestamp": "02:09:49", "text": "4時間後くらいにこれを見るだろうと思っていました。   私もそう"}]
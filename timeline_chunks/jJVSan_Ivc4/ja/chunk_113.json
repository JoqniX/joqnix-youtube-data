[{"type": "subtitle", "time": 6781.43, "timestamp": "01:53:01", "text": "私もそう思っていました。 おい、"}, {"type": "subtitle", "time": 6784.149, "timestamp": "01:53:04", "text": "お前は何者だ？ では、彼らは一体どんな食べ物を"}, {"type": "subtitle", "time": 6785.43, "timestamp": "01:53:05", "text": "食べているのでしょうか？"}, {"type": "subtitle", "time": 6785.91, "timestamp": "01:53:05", "text": "えっと、"}, {"type": "subtitle", "time": 6787.109, "timestamp": "01:53:07", "text": "砂糖。   わからない"}, {"type": "subtitle", "time": 6789.669, "timestamp": "01:53:09", "text": "。 それは良い質問ですね。"}, {"type": "subtitle", "time": 6793.109, "timestamp": "01:53:13", "text": "うーん、まだ考えているところです。   途中で"}, {"type": "subtitle", "time": 6795.189, "timestamp": "01:53:15", "text": "。 始まった。 それはもうすぐ来る。 だんだん分かってきた"}, {"type": "subtitle", "time": 6799.03, "timestamp": "01:53:19", "text": "。 大丈夫。   わかった"}, {"type": "subtitle", "time": 6815.03, "timestamp": "01:53:35", "text": "笑うのはやめろ、"}, {"type": "subtitle", "time": 6815.91, "timestamp": "01:53:35", "text": "事態を悪化させるだけだ。"}, {"type": "subtitle", "time": 6818.39, "timestamp": "01:53:38", "text": "水をこぼしてしまった。"}, {"type": "chat", "time": 6818.825, "timestamp": "01:53:38", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "they eat water?"}, {"type": "subtitle", "time": 6820.629, "timestamp": "01:53:40", "text": "なぜだか分かる？ これ、あなたに言ったことなかったと思う"}, {"type": "subtitle", "time": 6824.149, "timestamp": "01:53:44", "text": "。 ゼン・キッシュバットの配信で、"}, {"type": "subtitle", "time": 6828.629, "timestamp": "01:53:48", "text": "コラボとしてではなく、"}, {"type": "subtitle", "time": 6831.35, "timestamp": "01:53:51", "text": "ライブチャットのコメントで、ただ単に「コラボ」って言ったことがあったんです。 私はそこにいた。 私は"}, {"type": "subtitle", "time": 6833.109, "timestamp": "01:53:53", "text": "「あ、こんにちは、ゼン」って感じだった。 そして彼女は"}, {"type": "subtitle", "time": 6834.95, "timestamp": "01:53:54", "text": "「ああ、あなたは"}, {"type": "subtitle", "time": 6836.87, "timestamp": "01:53:56", "text": "パンですか？」と言いました。 そして彼女は"}, {"type": "subtitle", "time": 6838.47, "timestamp": "01:53:58", "text": "手でジェスチャーをした。   ねえ"}]
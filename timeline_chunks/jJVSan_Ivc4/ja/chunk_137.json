[{"type": "subtitle", "time": 8220.79, "timestamp": "02:17:00", "text": "4時間くらいで返事するだろうと思ったんだけど、"}, {"type": "subtitle", "time": 8222.79, "timestamp": "02:17:02", "text": "あなたはすぐに返事をくれたから、私は「わあ」って言うしかなかった"}, {"type": "subtitle", "time": 8227.99, "timestamp": "02:17:07", "text": "。"}, {"type": "subtitle", "time": 8230.709, "timestamp": "02:17:10", "text": "私はそれに従うしかなかったんだ。"}, {"type": "subtitle", "time": 8233.11, "timestamp": "02:17:13", "text": "ポップスクールみたいなもの。"}, {"type": "subtitle", "time": 8236.95, "timestamp": "02:17:16", "text": "与えられたものに従うしかない。そして最終的に、"}, {"type": "subtitle", "time": 8238.79, "timestamp": "02:17:18", "text": "今あなたはここにいて、私たちは"}, {"type": "subtitle", "time": 8240.549, "timestamp": "02:17:20", "text": "あなたがここにいてくれて嬉しい。"}, {"type": "subtitle", "time": 8242.23, "timestamp": "02:17:22", "text": "うん。わかった。"}, {"type": "subtitle", "time": 8243.91, "timestamp": "02:17:23", "text": "おそらく、"}, {"type": "chat", "time": 8250.507, "timestamp": "02:17:30", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "so...everyone had dinner ?"}, {"type": "subtitle", "time": 8252.469, "timestamp": "02:17:32", "text": "うん。Arasuのファンベースはかなり大きい。"}, {"type": "subtitle", "time": 8254.389, "timestamp": "02:17:34", "text": "うん。"}, {"type": "subtitle", "time": 8262.15, "timestamp": "02:17:42", "text": "どう？"}, {"type": "subtitle", "time": 8264.79, "timestamp": "02:17:44", "text": "うん、やったよ。やったと思う。"}, {"type": "subtitle", "time": 8266.15, "timestamp": "02:17:46", "text": "ハニー。うん"}, {"type": "subtitle", "time": 8268.23, "timestamp": "02:17:48", "text": "。えーと、ブラッドが「"}, {"type": "subtitle", "time": 8270.07, "timestamp": "02:17:50", "text": "夕食は食べた？」って聞いてた。行ったよ。"}, {"type": "subtitle", "time": 8273.429, "timestamp": "02:17:53", "text": "アンキットが聞いてた。"}, {"type": "subtitle", "time": 8274.23, "timestamp": "02:17:54", "text": "コメントを読んだところ。"}, {"type": "subtitle", "time": 8276.95, "timestamp": "02:17:56", "text": "ああ、"}]
[{"type": "subtitle", "time": 4204.87, "timestamp": "01:10:04", "text": "你不知道？如果我不知道的話，我會顯得很沒面子。哦，不。等一下。你什麼也沒"}, {"type": "subtitle", "time": 4214.149, "timestamp": "01:10:14", "text": "不記得了，夥計。我離開了一個月，老兄。"}, {"type": "subtitle", "time": 4228.47, "timestamp": "01:10:28", "text": "我不記得那些人了。然後下面那個人也在。我不知道"}, {"type": "subtitle", "time": 4241.91, "timestamp": "01:10:41", "text": "你還沒跟那群"}, {"type": "subtitle", "time": 4244.07, "timestamp": "01:10:44", "text": "人說過話。呃，對。沒有，我沒有。對。我想你還沒。嗯，沒關係。很好。蠢貨奴隸。我的天啊"}, {"type": "subtitle", "time": 4249.59, "timestamp": "01:10:49", "text": "。"}]
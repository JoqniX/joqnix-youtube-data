[{"type": "subtitle", "time": 4085.349, "timestamp": "01:08:05", "text": "是一個以星空為主題的施法者，他的力量來自星座和夜空。現在，他現在，他現在，他現在真的很"}, {"type": "subtitle", "time": 4088.23, "timestamp": "01:08:08", "text": "喜歡這個角色，因為他"}, {"type": "subtitle", "time": 4091.19, "timestamp": "01:08:11", "text": "現在知道這個角色是做什麼的了。他"}, {"type": "subtitle", "time": 4097.03, "timestamp": "01:08:17", "text": "玩的時候完全不知道。我剛才說誰主持來著？"}, {"type": "subtitle", "time": 4106.07, "timestamp": "01:08:26", "text": "。"}]
[{"type": "subtitle", "time": 1210.71, "timestamp": "00:20:10", "text": "愚蠢？你只有這些嗎？  等等，那是你傳給我的嗎？  我的"}, {"type": "subtitle", "time": 1224.789, "timestamp": "00:20:24", "text": "做一個全新的、不一樣的。  是的。從"}, {"type": "subtitle", "time": 1237.35, "timestamp": "00:20:37", "text": "沒關係。看起來不錯，我的朋友。我看起來像個傻瓜。我就是這個意思。  你好。"}, {"type": "subtitle", "time": 1247.669, "timestamp": "00:20:47", "text": "但沒錯，這裡只有我看起來很蠢。  我的天啊。不用"}, {"type": "subtitle", "time": 1255.19, "timestamp": "00:20:55", "text": "擔心。"}, {"type": "subtitle", "time": 1258.549, "timestamp": "00:20:58", "text": "我差點"}]
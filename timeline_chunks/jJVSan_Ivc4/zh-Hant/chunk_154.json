[{"type": "subtitle", "time": 9254.309, "timestamp": "02:34:14", "text": "你怎麼樣？是的，我們吃了。我想我們吃了。親愛的。呃，"}, {"type": "subtitle", "time": 9255.429, "timestamp": "02:34:15", "text": "是的。呃，"}, {"type": "subtitle", "time": 9259.83, "timestamp": "02:34:19", "text": "Brad問，「你們吃晚餐了嗎？」我們吃了。嗯，Ankit問的。我"}, {"type": "subtitle", "time": 9262.309, "timestamp": "02:34:22", "text": "剛看了評論。"}, {"type": "subtitle", "time": 9274.71, "timestamp": "02:34:34", "text": "哦，是的。你們吃完了嗎？你吃飯了嗎？沒有。沒有。"}, {"type": "subtitle", "time": 9285.51, "timestamp": "02:34:45", "text": "你怎麼敢？你怎麼敢不吃飯？你想當運動健將嗎？你想讓鄰居說：「孩子，你父母餵你吃飯了嗎？」 「他們不餵"}]
[{"type": "subtitle", "time": 4758.229, "timestamp": "01:19:18", "text": "可以跟那傢伙打個招呼，老兄"}, {"type": "subtitle", "time": 4760.95, "timestamp": "01:19:20", "text": "。你好，直播間。歡迎。歡迎。只有我"}, {"type": "subtitle", "time": 4769.91, "timestamp": "01:19:29", "text": "和"}, {"type": "subtitle", "time": 4772.31, "timestamp": "01:19:32", "text": "Jock，你知道，就是最初的那個傢伙，我們這群人，你知道，只是在做我們自己的事。我希望你沒有"}, {"type": "subtitle", "time": 4776.229, "timestamp": "01:19:36", "text": "輸入太多"}, {"type": "subtitle", "time": 4777.99, "timestamp": "01:19:37", "text": "內容。真蠢。他們就是"}, {"type": "subtitle", "time": 4787.99, "timestamp": "01:19:47", "text": "蠢。是啊，他們只關注DND。是啊"}]
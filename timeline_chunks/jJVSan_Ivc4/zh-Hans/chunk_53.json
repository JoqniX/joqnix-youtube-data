[{"type": "subtitle", "time": 3180.71, "timestamp": "00:53:00", "text": "你得这么做。因为我"}, {"type": "subtitle", "time": 3183.43, "timestamp": "00:53:03", "text": "最喜欢的动漫角色"}, {"type": "subtitle", "time": 3185.67, "timestamp": "00:53:05", "text": "超厉害的。她很棒。你"}, {"type": "subtitle", "time": 3189.19, "timestamp": "00:53:09", "text": "知道，在游戏里，她简直就是坨屎。我"}, {"type": "subtitle", "time": 3193.43, "timestamp": "00:53:13", "text": "用她什么都赢不了。就像我"}, {"type": "subtitle", "time": 3195.109, "timestamp": "00:53:15", "text": "最喜欢的，你知道，我最喜欢的"}, {"type": "subtitle", "time": 3198.549, "timestamp": "00:53:18", "text": "角色叫麦昆少校。"}, {"type": "subtitle", "time": 3200.549, "timestamp": "00:53:20", "text": "哦，如果你不认识"}, {"type": "subtitle", "time": 3201.109, "timestamp": "00:53:21", "text": "她也没关系。"}, {"type": "subtitle", "time": 3202.63, "timestamp": "00:53:22", "text": "我知道。是的。"}, {"type": "subtitle", "time": 3205.27, "timestamp": "00:53:25", "text": "我不是……不，我说的不是那辆"}, {"type": "subtitle", "time": 3206.87, "timestamp": "00:53:26", "text": "红色的车。"}, {"type": "subtitle", "time": 3209.51, "timestamp": "00:53:29", "text": "不，不是麦昆。我是说那个女士，那个"}, {"type": "subtitle", "time": 3213.349, "timestamp": "00:53:33", "text": "拿着茶杯、喜欢喝茶的紫发女士"}, {"type": "subtitle", "time": 3216.39, "timestamp": "00:53:36", "text": "，"}, {"type": "subtitle", "time": 3219.589, "timestamp": "00:53:39", "text": "我想是吧。是的，你知道的。"}, {"type": "subtitle", "time": 3221.829, "timestamp": "00:53:41", "text": "他不知道。"}, {"type": "subtitle", "time": 3224.23, "timestamp": "00:53:44", "text": "当然，"}, {"type": "subtitle", "time": 3225.43, "timestamp": "00:53:45", "text": "当然。"}, {"type": "subtitle", "time": 3227.829, "timestamp": "00:53:47", "text": "我以为，因为我知道你这个"}, {"type": "subtitle", "time": 3230.069, "timestamp": "00:53:50", "text": "傻瓜可能会说，"}, {"type": "subtitle", "time": 3231.75, "timestamp": "00:53:51", "text": "哦，麦昆。当然。"}, {"type": "subtitle", "time": 3235.27, "timestamp": "00:53:55", "text": "我一开始也是这么想的。"}, {"type": "subtitle", "time": 3238.39, "timestamp": "00:53:58", "text": "不，我当时没想错。我第一次"}]
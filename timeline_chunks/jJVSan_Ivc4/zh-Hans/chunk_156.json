[{"type": "subtitle", "time": 9361.91, "timestamp": "02:36:01", "text": "老人们会这么"}, {"type": "subtitle", "time": 9364.95, "timestamp": "02:36:04", "text": "说。我这个年纪还年轻。我"}, {"type": "subtitle", "time": 9367.75, "timestamp": "02:36:07", "text": "比你们这些孩子都年轻。"}, {"type": "subtitle", "time": 9368.23, "timestamp": "02:36:08", "text": "哦，"}, {"type": "subtitle", "time": 9377.67, "timestamp": "02:36:17", "text": "你是焦虑吗？我们可以叫你“安克”吗？"}, {"type": "subtitle", "time": 9380.469, "timestamp": "02:36:20", "text": "我不是……"}, {"type": "subtitle", "time": 9381.91, "timestamp": "02:36:21", "text": "你要去……你快到那个"}, {"type": "subtitle", "time": 9383.83, "timestamp": "02:36:23", "text": "年纪了吗？我觉得他是。"}, {"type": "subtitle", "time": 9386.63, "timestamp": "02:36:26", "text": "不。"}, {"type": "subtitle", "time": 9388.81, "timestamp": "02:36:28", "text": "你好。"}, {"type": "subtitle", "time": 9392.15, "timestamp": "02:36:32", "text": "[笑声]"}, {"type": "subtitle", "time": 9395.349, "timestamp": "02:36:35", "text": "你好，化石。你好，恐龙箭人。"}, {"type": "subtitle", "time": 9402.23, "timestamp": "02:36:42", "text": "笑话可能是乔见过"}, {"type": "subtitle", "time": 9409.03, "timestamp": "02:36:49", "text": "我的天哪。"}, {"type": "subtitle", "time": 9410.87, "timestamp": "02:36:50", "text": "这些人没听懂笑话。这些"}, {"type": "subtitle", "time": 9412.469, "timestamp": "02:36:52", "text": "人不懂。"}, {"type": "subtitle", "time": 9414.95, "timestamp": "02:36:54", "text": "你让我想起一部动画，里面有去"}, {"type": "subtitle", "time": 9418.23, "timestamp": "02:36:58", "text": "拜访女王"}]
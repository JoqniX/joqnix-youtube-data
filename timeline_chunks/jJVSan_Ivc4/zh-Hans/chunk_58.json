[{"type": "subtitle", "time": 3482.309, "timestamp": "00:58:02", "text": "我之前写指南之类的东西那样手动硬编码"}, {"type": "subtitle", "time": 3484.95, "timestamp": "00:58:04", "text": "。现在我把它放在"}, {"type": "subtitle", "time": 3491.03, "timestamp": "00:58:11", "text": "那里。我的意思是，我可以用"}, {"type": "subtitle", "time": 3493.43, "timestamp": "00:58:13", "text": "Markdown 写所有内容，添加"}, {"type": "subtitle", "time": 3497.19, "timestamp": "00:58:17", "text": "标题之类的。"}, {"type": "subtitle", "time": 3503.52, "timestamp": "00:58:23", "text": "。 很多事情。"}, {"type": "subtitle", "time": 3506.88, "timestamp": "00:58:26", "text": "很多事情。 但是，是的，"}, {"type": "subtitle", "time": 3513.829, "timestamp": "00:58:33", "text": "劳拉·库恩，"}, {"type": "subtitle", "time": 3516.15, "timestamp": "00:58:36", "text": "自从 我在玩龙与地下城，接下来我得琢磨一下"}, {"type": "subtitle", "time": 3518.71, "timestamp": "00:58:38", "text": "星界德鲁伊梗的背景故事和设定了"}, {"type": "subtitle", "time": 3520.549, "timestamp": "00:58:40", "text": "。"}, {"type": "subtitle", "time": 3522.549, "timestamp": "00:58:42", "text": "哦，对啊，你应该写写这些，我觉得写起来"}, {"type": "subtitle", "time": 3524.789, "timestamp": "00:58:44", "text": "特别有意思。"}, {"type": "subtitle", "time": 3526.47, "timestamp": "00:58:46", "text": "我以前和朋友一起玩龙与地下城的时候……"}, {"type": "subtitle", "time": 3531.19, "timestamp": "00:58:51", "text": "哦，你玩过？"}, {"type": "subtitle", "time": 3533.43, "timestamp": "00:58:53", "text": "我玩过一次，没搞懂。大家都"}, {"type": "subtitle", "time": 3535.67, "timestamp": "00:58:55", "text": "冲我喊，之后我就再也没玩过了"}]
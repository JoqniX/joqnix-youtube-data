[{"type": "subtitle", "time": 3421.67, "timestamp": "00:57:01", "text": "啊，我这方面很差劲，尽管我"}, {"type": "subtitle", "time": 3424.549, "timestamp": "00:57:04", "text": "学的是文学。"}, {"type": "subtitle", "time": 3426.95, "timestamp": "00:57:06", "text": "我就是没掌握。"}, {"type": "subtitle", "time": 3428.789, "timestamp": "00:57:08", "text": "他学的是文学，但他学得很差"}, {"type": "subtitle", "time": 3431.109, "timestamp": "00:57:11", "text": "。"}, {"type": "subtitle", "time": 3433.19, "timestamp": "00:57:13", "text": "嗯。"}, {"type": "subtitle", "time": 3435.27, "timestamp": "00:57:15", "text": "伙计，我从来没领会过它的精髓"}, {"type": "subtitle", "time": 3442.87, "timestamp": "00:57:22", "text": "但是，是的，是的，"}, {"type": "subtitle", "time": 3445.03, "timestamp": "00:57:25", "text": "我希望"}, {"type": "subtitle", "time": 3451.829, "timestamp": "00:57:31", "text": "尽快在网站上看到那些背景故事之类的东西。"}, {"type": "subtitle", "time": 3454.069, "timestamp": "00:57:34", "text": "是的，我得更新一下。没错。"}, {"type": "subtitle", "time": 3456.789, "timestamp": "00:57:36", "text": "我得写一整本书。"}, {"type": "subtitle", "time": 3458.47, "timestamp": "00:57:38", "text": "不是那种写在一页纸上的内容，而是像那种分成"}, {"type": "subtitle", "time": 3461.829, "timestamp": "00:57:41", "text": "好几页的，我想。等等。"}, {"type": "subtitle", "time": 3468.39, "timestamp": "00:57:48", "text": "我不知道。我的意思是，"}, {"type": "subtitle", "time": 3471.349, "timestamp": "00:57:51", "text": "如果我把它托管在某个地方，然后把它放到"}, {"type": "subtitle", "time": 3473.349, "timestamp": "00:57:53", "text": "像 Notion 之类的平台"}, {"type": "subtitle", "time": 3476.63, "timestamp": "00:57:56", "text": "上，这样就很容易编辑，而不是像"}]
[{"type": "subtitle", "time": 8042.069, "timestamp": "02:14:02", "text": "你这蠢货，建得跟路灯似的！"}, {"type": "subtitle", "time": 8048.069, "timestamp": "02:14:08", "text": "邻居们应该与你相处融洽。 所以"}, {"type": "subtitle", "time": 8050.55, "timestamp": "02:14:10", "text": "认识我和我家人的人会"}, {"type": "subtitle", "time": 8053.189, "timestamp": "02:14:13", "text": "问：“你家没钱养"}, {"type": "subtitle", "time": 8055.189, "timestamp": "02:14:15", "text": "你吗？”"}, {"type": "subtitle", "time": 8059.75, "timestamp": "02:14:19", "text": "“我的天哪，"}, {"type": "subtitle", "time": 8062.39, "timestamp": "02:14:22", "text": "他们能喂饱你吗？老天爷啊。你还"}, {"type": "subtitle", "time": 8069.589, "timestamp": "02:14:29", "text": "这肯定是最奇怪的事了。"}, {"type": "subtitle", "time": 8071.669, "timestamp": "02:14:31", "text": "就像邻居走过来问你，"}, {"type": "subtitle", "time": 8073.189, "timestamp": "02:14:33", "text": "“你家里人喂饱"}, {"type": "subtitle", "time": 8076.31, "timestamp": "02:14:36", "text": "你了吗？”就像，“兄弟，你还好吗？” 你"}, {"type": "subtitle", "time": 8084.95, "timestamp": "02:14:44", "text": "这种情况会发生。”"}, {"type": "subtitle", "time": 8090.629, "timestamp": "02:14:50", "text": "啊。把"}, {"type": "subtitle", "time": 8094.629, "timestamp": "02:14:54", "text": "车子固定一下什么的。真可惜。"}, {"type": "subtitle", "time": 8096.629, "timestamp": "02:14:56", "text": "然后他就走了。"}, {"type": "subtitle", "time": 8097.669, "timestamp": "02:14:57", "text": "不，"}, {"type": "subtitle", "time": 8099.03, "timestamp": "02:14:59", "text": "他又回来了。"}]
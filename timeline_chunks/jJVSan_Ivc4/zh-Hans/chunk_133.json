[{"type": "subtitle", "time": 7980.95, "timestamp": "02:13:00", "text": "这里。 我很高兴。 但我们很高兴你"}, {"type": "subtitle", "time": 7982.149, "timestamp": "02:13:02", "text": "现在能来。"}, {"type": "subtitle", "time": 7983.95, "timestamp": "02:13:03", "text": "我们很高兴。"}, {"type": "subtitle", "time": 7988.629, "timestamp": "02:13:08", "text": "是的，因为我觉得，你知道，就我"}, {"type": "subtitle", "time": 7989.83, "timestamp": "02:13:09", "text": "个人而言，我当时就觉得像是"}, {"type": "subtitle", "time": 7991.91, "timestamp": "02:13:11", "text": "脖子断了一样。"}, {"type": "subtitle", "time": 7994.629, "timestamp": "02:13:14", "text": "我的天哪，他脖子僵硬了。"}, {"type": "subtitle", "time": 7995.35, "timestamp": "02:13:15", "text": "哦，不。"}, {"type": "subtitle", "time": 7998.55, "timestamp": "02:13:18", "text": "你脖子怎么会僵硬？或者"}, {"type": "subtitle", "time": 7999.109, "timestamp": "02:13:19", "text": "发生了什么事？"}, {"type": "subtitle", "time": 8002.069, "timestamp": "02:13:22", "text": "我知道。 可能是睡觉姿势不良"}, {"type": "subtitle", "time": 8003.03, "timestamp": "02:13:23", "text": "。"}, {"type": "subtitle", "time": 8003.99, "timestamp": "02:13:23", "text": "哦，不。   我的"}, {"type": "subtitle", "time": 8007.109, "timestamp": "02:13:27", "text": "天哪。 但他一直在举重，你"}, {"type": "subtitle", "time": 8022.87, "timestamp": "02:13:42", "text": "与此同时，我却很瘦。 我从不运动。"}, {"type": "subtitle", "time": 8026.55, "timestamp": "02:13:46", "text": "我们都很瘦，伙计。 别再说"}, {"type": "subtitle", "time": 8028.149, "timestamp": "02:13:48", "text": "你很瘦了。"}, {"type": "subtitle", "time": 8031.27, "timestamp": "02:13:51", "text": "不，是我的家人。 我的家人就像你的"}, {"type": "subtitle", "time": 8034.31, "timestamp": "02:13:54", "text": "棍子和姿势一样。 你不吃饭，对吧？"}]
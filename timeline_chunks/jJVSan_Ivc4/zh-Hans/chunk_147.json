[{"type": "subtitle", "time": 8821.03, "timestamp": "02:27:01", "text": "今天都做了些什么？"}, {"type": "subtitle", "time": 8825.75, "timestamp": "02:27:05", "text": "我花了三个小时才完成"}, {"type": "subtitle", "time": 8831.349, "timestamp": "02:27:11", "text": "你是不是像个书虫一样，把"}, {"type": "subtitle", "time": 8833.51, "timestamp": "02:27:13", "text": "每篇故事都读了一遍？"}, {"type": "subtitle", "time": 8836.309, "timestamp": "02:27:16", "text": "是的，作为初学者，我的确这么做过。"}, {"type": "subtitle", "time": 8838.309, "timestamp": "02:27:18", "text": "哦，不。"}, {"type": "subtitle", "time": 8844.55, "timestamp": "02:27:24", "text": "你知道，就算你把游戏速度调到"}, {"type": "subtitle", "time": 8847.27, "timestamp": "02:27:27", "text": "4 倍，完成"}, {"type": "subtitle", "time": 8853.429, "timestamp": "02:27:33", "text": "一局完整的赛马比赛也需要 30 分钟，我可不是在"}, {"type": "subtitle", "time": 8859.51, "timestamp": "02:27:39", "text": "我绝对能想象到这种情况。"}, {"type": "subtitle", "time": 8863.03, "timestamp": "02:27:43", "text": "而且就算我中途跳过"}, {"type": "subtitle", "time": 8864.95, "timestamp": "02:27:44", "text": "比赛，也"}, {"type": "subtitle", "time": 8869.91, "timestamp": "02:27:49", "text": "还是要花很多时间。"}, {"type": "subtitle", "time": 8876.15, "timestamp": "02:27:56", "text": "它太容易上瘾了。 我不想"}, {"type": "subtitle", "time": 8877.59, "timestamp": "02:27:57", "text": "靠近它。"}, {"type": "subtitle", "time": 8878.71, "timestamp": "02:27:58", "text": "哦，确实如此"}]
[{"type": "subtitle", "time": 2043.75, "timestamp": "00:34:03", "text": "等等，你看过《神奇四侠》吗？没有。怎么可能？好吧。"}, {"type": "subtitle", "time": 2046.87, "timestamp": "00:34:06", "text": "你不是你的……"}, {"type": "subtitle", "time": 2047.75, "timestamp": "00:34:07", "text": "什么？"}, {"type": "subtitle", "time": 2050.47, "timestamp": "00:34:10", "text": "神奇什么？"}, {"type": "subtitle", "time": 2052.55, "timestamp": "00:34:12", "text": "神奇四侠。你是说"}, {"type": "subtitle", "time": 2054.31, "timestamp": "00:34:14", "text": "新出的那部？"}, {"type": "subtitle", "time": 2054.71, "timestamp": "00:34:14", "text": "是的。"}, {"type": "subtitle", "time": 2056.95, "timestamp": "00:34:16", "text": "还没看过。"}, {"type": "subtitle", "time": 2060.389, "timestamp": "00:34:20", "text": "我明天有票。是我。"}, {"type": "subtitle", "time": 2062.629, "timestamp": "00:34:22", "text": "哦，不错。"}, {"type": "subtitle", "time": 2065.349, "timestamp": "00:34:25", "text": "是啊，我现在对电影上瘾了。"}, {"type": "subtitle", "time": 2069.829, "timestamp": "00:34:29", "text": "而且电影票贵得要命，"}, {"type": "subtitle", "time": 2071.829, "timestamp": "00:34:31", "text": "如果你想"}, {"type": "subtitle", "time": 2073.669, "timestamp": "00:34:33", "text": "知道的话。"}, {"type": "subtitle", "time": 2076.79, "timestamp": "00:34:36", "text": "电影票。"}, {"type": "subtitle", "time": 2078.869, "timestamp": "00:34:38", "text": "是啊，很贵。"}, {"type": "subtitle", "time": 2082.149, "timestamp": "00:34:42", "text": "算了，别聊电影了，聊聊"}, {"type": "subtitle", "time": 2084.55, "timestamp": "00:34:44", "text": "你自己吧。我看到你在玩"}, {"type": "subtitle", "time": 2086.149, "timestamp": "00:34:46", "text": "DND，"}, {"type": "subtitle", "time": 2087.669, "timestamp": "00:34:47", "text": "你知道的。"}, {"type": "subtitle", "time": 2088.389, "timestamp": "00:34:48", "text": "对，DND。感觉"}, {"type": "subtitle", "time": 2091.829, "timestamp": "00:34:51", "text": "怎么样？你喜欢玩D&D吗？"}, {"type": "subtitle", "time": 2093.27, "timestamp": "00:34:53", "text": "你觉得怎么样？"}, {"type": "subtitle", "time": 2095.909, "timestamp": "00:34:55", "text": "哦，挺好的。我感觉"}, {"type": "subtitle", "time": 2098.55, "timestamp": "00:34:58", "text": "昨天我话不多。我得改改"}]
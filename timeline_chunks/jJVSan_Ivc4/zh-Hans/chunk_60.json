[{"type": "subtitle", "time": 3601.03, "timestamp": "01:00:01", "text": "哦，德鲁伊。"}, {"type": "subtitle", "time": 3602.63, "timestamp": "01:00:02", "text": "好的，"}, {"type": "subtitle", "time": 3605.829, "timestamp": "01:00:05", "text": "抱歉。 呃，德鲁伊是一个可玩角色，"}, {"type": "subtitle", "time": 3608.71, "timestamp": "01:00:08", "text": "我当时"}, {"type": "subtitle", "time": 3610.47, "timestamp": "01:00:10", "text": "想，“他会说什么？” 他"}, {"type": "subtitle", "time": 3612.47, "timestamp": "01:00:12", "text": "现在在看什么？然后"}, {"type": "subtitle", "time": 3614.549, "timestamp": "01:00:14", "text": "我脑子里突然冒出一个念头：这傻瓜可能在"}, {"type": "subtitle", "time": 3623.19, "timestamp": "01:00:23", "text": "没错，这就是为什么德鲁伊是《"}, {"type": "subtitle", "time": 3625.829, "timestamp": "01:00:25", "text": "龙与地下城》"}, {"type": "subtitle", "time": 3628.63, "timestamp": "01:00:28", "text": "奇幻角色扮演游戏中的可玩职业。德鲁伊是自然"}, {"type": "subtitle", "time": 3632.789, "timestamp": "01:00:32", "text": "主题的魔法施法者，类似于牧师。但与牧师不同的是"}, {"type": "subtitle", "time": 3634.47, "timestamp": "01:00:34", "text": "，德鲁伊没有"}, {"type": "subtitle", "time": 3636.63, "timestamp": "01:00:36", "text": "对抗亡灵的特殊能力。"}, {"type": "subtitle", "time": 3639.91, "timestamp": "01:00:39", "text": "为什么？我说的是德鲁伊是什么，而不是"}, {"type": "subtitle", "time": 3642.87, "timestamp": "01:00:42", "text": "他具体做什么。"}, {"type": "subtitle", "time": 3653.51, "timestamp": "01:00:53", "text": "德鲁伊的个性。唯一的个性，"}, {"type": "subtitle", "time": 3654.71, "timestamp": "01:00:54", "text": "对吧？"}, {"type": "subtitle", "time": 3657.589, "timestamp": "01:00:57", "text": "没错。打出来。我应该"}]
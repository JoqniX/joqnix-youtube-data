[{"type": "subtitle", "time": 662.55, "timestamp": "00:11:02", "text": "。 是的。 能坐在这里感觉真好，就像以前那样，以前坐着真的很"}, {"type": "subtitle", "time": 667.91, "timestamp": "00:11:07", "text": "痛苦。 我当时就想"}, {"type": "subtitle", "time": 670.63, "timestamp": "00:11:10", "text": "，我不想待在这里。 我只想"}, {"type": "subtitle", "time": 674.79, "timestamp": "00:11:14", "text": "回到床上，"}, {"type": "subtitle", "time": 680.15, "timestamp": "00:11:20", "text": "沉迷于这冰冷的床铺，"}, {"type": "subtitle", "time": 683.91, "timestamp": "00:11:23", "text": "然后睡个好觉。 不过，现在这里确实很"}, {"type": "subtitle", "time": 686.63, "timestamp": "00:11:26", "text": "不错。 我打喷嚏的次数不多"}, {"type": "subtitle", "time": 688.23, "timestamp": "00:11:28", "text": "。   没错"}, {"type": "subtitle", "time": 690.87, "timestamp": "00:11:30", "text": "。 接下来就是日语"}, {"type": "subtitle", "time": 693.19, "timestamp": "00:11:33", "text": "课了，"}, {"type": "subtitle", "time": 695.91, "timestamp": "00:11:35", "text": "很快就要开始了。 我不知道具体时间，但"}, {"type": "subtitle", "time": 697.829, "timestamp": "00:11:37", "text": "他们说很快了。"}, {"type": "subtitle", "time": 700.87, "timestamp": "00:11:40", "text": "所以可能下周也可能这周，我"}, {"type": "subtitle", "time": 703.59, "timestamp": "00:11:43", "text": "不知道。 我预计从八月份"}, {"type": "subtitle", "time": 717.35, "timestamp": "00:11:57", "text": "我一直在忙网站"}, {"type": "subtitle", "time": 719.99, "timestamp": "00:11:59", "text": "相关的工作。 银行账户那边确实给"}]
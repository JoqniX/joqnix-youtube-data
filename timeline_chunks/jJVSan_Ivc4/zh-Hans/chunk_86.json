[{"type": "subtitle", "time": 5160.95, "timestamp": "01:26:00", "text": "他那边7点。"}, {"type": "subtitle", "time": 5163.669, "timestamp": "01:26:03", "text": "他一直没来，直到他跟我说："}, {"type": "subtitle", "time": 5165.11, "timestamp": "01:26:05", "text": "“哦，对，我要吃饭了。” 我就说："}, {"type": "subtitle", "time": 5166.79, "timestamp": "01:26:06", "text": "“好吧。”"}, {"type": "subtitle", "time": 5168.31, "timestamp": "01:26:08", "text": "好吧，他现在要吃饭了。好吧，那"}, {"type": "subtitle", "time": 5169.51, "timestamp": "01:26:09", "text": "我先去准备我的"}, {"type": "subtitle", "time": 5171.59, "timestamp": "01:26:11", "text": "饭，你知道，趁这个时间。所以"}, {"type": "subtitle", "time": 5173.35, "timestamp": "01:26:13", "text": "没问题。"}, {"type": "subtitle", "time": 5175.43, "timestamp": "01:26:15", "text": "半小时后，我问他：“哦，"}, {"type": "subtitle", "time": 5176.79, "timestamp": "01:26:16", "text": "你想什么时候做？”"}, {"type": "subtitle", "time": 5179.03, "timestamp": "01:26:19", "text": "他发了条信息给我，"}, {"type": "subtitle", "time": 5180.47, "timestamp": "01:26:20", "text": "说：“哦，我……”  “我"}, {"type": "subtitle", "time": 5181.83, "timestamp": "01:26:21", "text": "现在要吃饭了。” 我心想，这都"}, {"type": "subtitle", "time": 5183.669, "timestamp": "01:26:23", "text": "半个小时了。"}, {"type": "subtitle", "time": 5186.95, "timestamp": "01:26:26", "text": "我还在支持帖里"}, {"type": "subtitle", "time": 5188.47, "timestamp": "01:26:28", "text": "打字呢。我的"}, {"type": "subtitle", "time": 5190.95, "timestamp": "01:26:30", "text": "天哪。你"}, {"type": "subtitle", "time": 5195.669, "timestamp": "01:26:35", "text": "让我待在那儿，都把那人的一天毁了。好吧。"}, {"type": "subtitle", "time": 5198.95, "timestamp": "01:26:38", "text": "不，他们告诉我，你"}, {"type": "subtitle", "time": 5201.83, "timestamp": "01:26:41", "text": "没必要把事情搞复杂。"}, {"type": "subtitle", "time": 5204.229, "timestamp": "01:26:44", "text": "你可以用这种方式，给我一些"}, {"type": "subtitle", "time": 5208.31, "timestamp": "01:26:48", "text": "建议，比如我可以做些什么。"}, {"type": "subtitle", "time": 5210.229, "timestamp": "01:26:50", "text": "所以，我就照做了。我"}, {"type": "subtitle", "time": 5212.31, "timestamp": "01:26:52", "text": "回复说，嗯，我应该按照"}, {"type": "subtitle", "time": 5216.39, "timestamp": "01:26:56", "text": "你的建议做等等。这样以后我就不会再遇到"}, {"type": "subtitle", "time": 5218.709, "timestamp": "01:26:58", "text": "这些按钮"}]
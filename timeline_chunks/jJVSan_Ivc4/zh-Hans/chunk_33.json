[{"type": "subtitle", "time": 1984.549, "timestamp": "00:33:04", "text": "我是在外部应用上看的。他："}, {"type": "subtitle", "time": 1986.149, "timestamp": "00:33:06", "text": "哦，好吧，你不用告诉我"}, {"type": "subtitle", "time": 1993.83, "timestamp": "00:33:13", "text": "嗨。"}, {"type": "subtitle", "time": 1997.83, "timestamp": "00:33:17", "text": "嗨，你这个乡巴佬，居然在"}, {"type": "subtitle", "time": 2002.23, "timestamp": "00:33:22", "text": "外部网站上看电影，而不是去"}, {"type": "subtitle", "time": 2006.789, "timestamp": "00:33:26", "text": "电影院。你这异教徒，怎么敢？"}, {"type": "subtitle", "time": 2009.43, "timestamp": "00:33:29", "text": "你怎么敢？"}, {"type": "subtitle", "time": 2011.029, "timestamp": "00:33:31", "text": "[音乐] 是"}, {"type": "subtitle", "time": 2013.669, "timestamp": "00:33:33", "text": "啊。还有，你知道吗，我不知道我"}, {"type": "subtitle", "time": 2015.509, "timestamp": "00:33:35", "text": "是怎么了。我说过我不会把"}, {"type": "subtitle", "time": 2017.83, "timestamp": "00:33:37", "text": "钱浪费在游戏上，然后我却"}, {"type": "subtitle", "time": 2029.75, "timestamp": "00:33:49", "text": "9美元的电影，还要吃10美元的爆米花"}, {"type": "subtitle", "time": 2033.83, "timestamp": "00:33:53", "text": "。这太不公平了。这不公平。"}, {"type": "subtitle", "time": 2036.789, "timestamp": "00:33:56", "text": "这真的不公平。"}]
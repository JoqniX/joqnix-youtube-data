[{"type": "subtitle", "time": 4260.39, "timestamp": "01:11:00", "text": "对。"}, {"type": "subtitle", "time": 4263.75, "timestamp": "01:11:03", "text": "我喜欢你说的，"}, {"type": "subtitle", "time": 4266.229, "timestamp": "01:11:06", "text": "你的日本朋友说："}, {"type": "subtitle", "time": 4268.34, "timestamp": "01:11:08", "text": "“哦，你是个男人。”"}, {"type": "subtitle", "time": 4269.51, "timestamp": "01:11:09", "text": "[音乐]"}, {"type": "subtitle", "time": 4272.55, "timestamp": "01:11:12", "text": "怎么样？"}, {"type": "subtitle", "time": 4275.27, "timestamp": "01:11:15", "text": "还有，因为我听你说话，感觉你"}, {"type": "subtitle", "time": 4277.669, "timestamp": "01:11:17", "text": "年轻得要命，"}, {"type": "subtitle", "time": 4278.95, "timestamp": "01:11:18", "text": "你知道吗？"}, {"type": "subtitle", "time": 4282.55, "timestamp": "01:11:22", "text": "感觉这家伙肯定不到20岁。我一直这么想。"}, {"type": "subtitle", "time": 4285.51, "timestamp": "01:11:25", "text": "然后慢慢地，"}, {"type": "subtitle", "time": 4287.99, "timestamp": "01:11:27", "text": "现实就浮现在"}, {"type": "subtitle", "time": 4289.75, "timestamp": "01:11:29", "text": "我的脑海里，我才"}, {"type": "subtitle", "time": 4292.709, "timestamp": "01:11:32", "text": "意识到这家伙老得要命。我的"}, {"type": "subtitle", "time": 4296.229, "timestamp": "01:11:36", "text": "天哪。 是啊，我可是几百万年前"}, {"type": "subtitle", "time": 4297.75, "timestamp": "01:11:37", "text": "的星座成员。"}, {"type": "subtitle", "time": 4309.35, "timestamp": "01:11:49", "text": "啊。是啊。是"}, {"type": "subtitle", "time": 4312.31, "timestamp": "01:11:52", "text": "啊。我觉得她很震惊。"}, {"type": "subtitle", "time": 4315.11, "timestamp": "01:11:55", "text": "呃，对她来说，"}, {"type": "subtitle", "time": 4318.47, "timestamp": "01:11:58", "text": "我居然跟一个男人聊了几个小时。"}, {"type": "subtitle", "time": 4319.669, "timestamp": "01:11:59", "text": "谁敢？"}]
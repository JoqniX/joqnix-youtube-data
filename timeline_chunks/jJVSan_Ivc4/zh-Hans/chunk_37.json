[{"type": "subtitle", "time": 2220.39, "timestamp": "00:37:00", "text": "然后，然后，然后你就开始"}, {"type": "subtitle", "time": 2223.43, "timestamp": "00:37:03", "text": "和你的另一个油管博主朋友聊"}, {"type": "subtitle", "time": 2226.71, "timestamp": "00:37:06", "text": "到深夜，这挺好的"}, {"type": "subtitle", "time": 2228.069, "timestamp": "00:37:08", "text": "。开玩笑吧？"}, {"type": "subtitle", "time": 2232.95, "timestamp": "00:37:12", "text": "不，其实是这样的，嗯，"}, {"type": "subtitle", "time": 2236.71, "timestamp": "00:37:16", "text": "我想，我又不想，该怎么说呢"}, {"type": "subtitle", "time": 2239.03, "timestamp": "00:37:19", "text": "？我想做，但"}, {"type": "subtitle", "time": 2241.03, "timestamp": "00:37:21", "text": "又不想做，因为我要睡觉，而且"}, {"type": "subtitle", "time": 2244.069, "timestamp": "00:37:24", "text": "他们也没睡。他们也"}, {"type": "subtitle", "time": 2247.91, "timestamp": "00:37:27", "text": "醒着，但我还是优先考虑了这件事，跟"}, {"type": "subtitle", "time": 2249.589, "timestamp": "00:37:29", "text": "他们说，嗯，我们"}, {"type": "subtitle", "time": 2251.51, "timestamp": "00:37:31", "text": "明天也可以做。然后他们说，我"}, {"type": "subtitle", "time": 2253.67, "timestamp": "00:37:33", "text": "现在就可以做。所以我就说，“好吧，行。”"}, {"type": "subtitle", "time": 2256.23, "timestamp": "00:37:36", "text": "我先处理一下这件事，看看情况，"}, {"type": "subtitle", "time": 2260.23, "timestamp": "00:37:40", "text": "然后……再聊一会儿什么的。”"}, {"type": "subtitle", "time": 2262.31, "timestamp": "00:37:42", "text": "然后我们就一直聊啊聊啊聊，嗯，都到"}, {"type": "subtitle", "time": 2269.03, "timestamp": "00:37:49", "text": "晚上六点了，呃，大概是早上六点，"}, {"type": "subtitle", "time": 2271.829, "timestamp": "00:37:51", "text": "我才结束。早上六点，"}, {"type": "subtitle", "time": 2274.15, "timestamp": "00:37:54", "text": "差不多是"}]
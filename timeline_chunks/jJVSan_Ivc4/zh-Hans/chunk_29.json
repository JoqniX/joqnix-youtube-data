[{"type": "subtitle", "time": 1740.71, "timestamp": "00:29:00", "text": "现在它好像在打折，"}, {"type": "subtitle", "time": 1743.43, "timestamp": "00:29:03", "text": "三款游戏一起卖。我就想，"}, {"type": "subtitle", "time": 1745.75, "timestamp": "00:29:05", "text": "天哪，我真想买。我得做一个"}, {"type": "subtitle", "time": 1748.31, "timestamp": "00:29:08", "text": "负责任的人，不能老是"}, {"type": "subtitle", "time": 1751.35, "timestamp": "00:29:11", "text": "网购游戏，不然我就会"}, {"type": "subtitle", "time": 1754.47, "timestamp": "00:29:14", "text": "变成你们那样。对"}, {"type": "subtitle", "time": 1755.909, "timestamp": "00:29:15", "text": "了，它好像在缓冲。"}, {"type": "subtitle", "time": 1758.23, "timestamp": "00:29:18", "text": "等等，真的。是的"}, {"type": "subtitle", "time": 1761.029, "timestamp": "00:29:21", "text": "。我看到它在缓冲。还是我的"}, {"type": "subtitle", "time": 1767.19, "timestamp": "00:29:27", "text": "呃，"}, {"type": "subtitle", "time": 1768.95, "timestamp": "00:29:28", "text": "如果它在缓冲，"}, {"type": "subtitle", "time": 1774.31, "timestamp": "00:29:34", "text": "对了。这游戏出问题了。等等，"}, {"type": "subtitle", "time": 1776.87, "timestamp": "00:29:36", "text": "它没有缓冲。"}, {"type": "subtitle", "time": 1780.31, "timestamp": "00:29:40", "text": "它确实缓冲了一秒钟。是的。"}, {"type": "subtitle", "time": 1783.909, "timestamp": "00:29:43", "text": "等一下。哦，"}, {"type": "subtitle", "time": 1785.909, "timestamp": "00:29:45", "text": "看起来有点卡顿，哦，它在"}, {"type": "subtitle", "time": 1787.59, "timestamp": "00:29:47", "text": "缓冲。"}, {"type": "subtitle", "time": 1789.99, "timestamp": "00:29:49", "text": "哦，不，不，不，不，不。它"}, {"type": "subtitle", "time": 1795.99, "timestamp": "00:29:55", "text": "一整"}, {"type": "subtitle", "time": 1797.99, "timestamp": "00:29:57", "text": "分钟。我"}]
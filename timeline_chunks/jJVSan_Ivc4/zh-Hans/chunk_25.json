[{"type": "subtitle", "time": 1501.909, "timestamp": "00:25:01", "text": "如果你有演奏，我们就应该演奏。   是的"}, {"type": "subtitle", "time": 1503.51, "timestamp": "00:25:03", "text": "。 毒品交易正在发生"}, {"type": "subtitle", "time": 1504.63, "timestamp": "00:25:04", "text": "变革。   是的"}, {"type": "subtitle", "time": 1506.39, "timestamp": "00:25:06", "text": "。 是的。"}, {"type": "subtitle", "time": 1508.39, "timestamp": "00:25:08", "text": "如果你不是拼命想单人通关，我本来会和你一起玩《Peak》的"}, {"type": "subtitle", "time": 1511.11, "timestamp": "00:25:11", "text": "。"}, {"type": "subtitle", "time": 1512.87, "timestamp": "00:25:12", "text": "好的。"}, {"type": "subtitle", "time": 1517.59, "timestamp": "00:25:17", "text": "如果你不是一直单排的话，我本来会和你一起玩的"}, {"type": "subtitle", "time": 1525.19, "timestamp": "00:25:25", "text": "我也会和你一起玩毒品"}, {"type": "subtitle", "time": 1527.59, "timestamp": "00:25:27", "text": "游戏。 但我"}, {"type": "subtitle", "time": 1529.51, "timestamp": "00:25:29", "text": "看到你直播了大概18个"}, {"type": "subtitle", "time": 1531.75, "timestamp": "00:25:31", "text": "小时，你就开始直播了。 我心想：“不行"}, {"type": "subtitle", "time": 1533.269, "timestamp": "00:25:33", "text": "不行，"}, {"type": "subtitle", "time": 1535.909, "timestamp": "00:25:35", "text": "我才不跟那家伙玩呢"}, {"type": "subtitle", "time": 1536.87, "timestamp": "00:25:36", "text": "。"}, {"type": "subtitle", "time": 1539.909, "timestamp": "00:25:39", "text": "那家伙太想赢了。” 为什么？ 好的，"}, {"type": "subtitle", "time": 1542.31, "timestamp": "00:25:42", "text": "问个问题。 为什么缩略图上"}, {"type": "subtitle", "time": 1545.99, "timestamp": "00:25:45", "text": "会有分钟倒计时？"}, {"type": "subtitle", "time": 1547.43, "timestamp": "00:25:47", "text": "什么？"}, {"type": "subtitle", "time": 1552.71, "timestamp": "00:25:52", "text": "缩略图上显示的是 30 分钟、36 分钟和 32 秒。"}, {"type": "subtitle", "time": 1555.269, "timestamp": "00:25:55", "text": "什么？"}]
[{"type": "subtitle", "time": 2164.55, "timestamp": "00:36:04", "text": "我想你是德鲁伊，对吧？"}, {"type": "subtitle", "time": 2167.27, "timestamp": "00:36:07", "text": "呃，星之德鲁伊。星之德鲁伊。"}, {"type": "subtitle", "time": 2170.069, "timestamp": "00:36:10", "text": "对，星之德鲁伊。好的。好的。好的"}, {"type": "subtitle", "time": 2172.069, "timestamp": "00:36:12", "text": "。我个人对DND也不太了解"}, {"type": "subtitle", "time": 2174.95, "timestamp": "00:36:14", "text": "，但我明白要"}, {"type": "subtitle", "time": 2177.51, "timestamp": "00:36:17", "text": "自己取名字之类的。"}, {"type": "subtitle", "time": 2180.47, "timestamp": "00:36:20", "text": "当我看到你的时候，他是不是在炫耀名字？我"}, {"type": "subtitle", "time": 2182.95, "timestamp": "00:36:22", "text": "就想，好吧。"}, {"type": "subtitle", "time": 2184.87, "timestamp": "00:36:24", "text": "还有，你"}, {"type": "subtitle", "time": 2186.63, "timestamp": "00:36:26", "text": "知道，你直播的时候有点耷拉着眼睛。耷拉着眼睛的意思是累了。"}, {"type": "subtitle", "time": 2192.39, "timestamp": "00:36:32", "text": "是的。有点累，你知道。有点困。"}, {"type": "subtitle", "time": 2194.23, "timestamp": "00:36:34", "text": "困。是"}, {"type": "subtitle", "time": 2195.349, "timestamp": "00:36:35", "text": "啊。"}, {"type": "subtitle", "time": 2196.63, "timestamp": "00:36:36", "text": "你知道，你当时就是那样。"}, {"type": "subtitle", "time": 2200.87, "timestamp": "00:36:40", "text": "不，等等。更确切地说，我几乎"}, {"type": "subtitle", "time": 2202.95, "timestamp": "00:36:42", "text": "没睡，所以为了这次"}, {"type": "subtitle", "time": 2204.47, "timestamp": "00:36:44", "text": "合作睡着了。"}, {"type": "subtitle", "time": 2207.99, "timestamp": "00:36:47", "text": "呃，我在合作开始前大约5分钟才醒，"}, {"type": "subtitle", "time": 2210.23, "timestamp": "00:36:50", "text": "所以没能参加"}, {"type": "subtitle", "time": 2213.19, "timestamp": "00:36:53", "text": "30分钟前的准备语音会议"}, {"type": "subtitle", "time": 2214.87, "timestamp": "00:36:54", "text": "。"}, {"type": "subtitle", "time": 2216.55, "timestamp": "00:36:56", "text": "是啊，"}, {"type": "subtitle", "time": 2217.75, "timestamp": "00:36:57", "text": "当时很忙，"}]
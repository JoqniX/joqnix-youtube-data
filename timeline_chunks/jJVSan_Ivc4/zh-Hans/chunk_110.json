[{"type": "subtitle", "time": 6611.75, "timestamp": "01:50:11", "text": "你对法式面包有什么看法？"}, {"type": "subtitle", "time": 6613.59, "timestamp": "01:50:13", "text": "什么？"}, {"type": "subtitle", "time": 6617.83, "timestamp": "01:50:17", "text": "你对法式面包有什么看法？"}, {"type": "subtitle", "time": 6622.01, "timestamp": "01:50:22", "text": "我是法国人，我就是法国面包。"}, {"type": "subtitle", "time": 6623.75, "timestamp": "01:50:23", "text": "[音乐]"}, {"type": "subtitle", "time": 6628.79, "timestamp": "01:50:28", "text": "你说你确定是什么意思？ 你做。"}, {"type": "subtitle", "time": 6631.27, "timestamp": "01:50:31", "text": "你以为我不知道自己的种族背景吗？ 什么"}, {"type": "subtitle", "time": 6632.149, "timestamp": "01:50:32", "text": "鬼？"}, {"type": "subtitle", "time": 6636.629, "timestamp": "01:50:36", "text": "别在意我。 我现在完全沉浸在白日梦里，"}, {"type": "subtitle", "time": 6642.709, "timestamp": "01:50:42", "text": "想着这件事。 想象你在一家"}, {"type": "subtitle", "time": 6645.43, "timestamp": "01:50:45", "text": "法国电影院餐厅里，然后"}, {"type": "subtitle", "time": 6648.79, "timestamp": "01:50:48", "text": "就像你在为你的小家庭准备面包一样"}, {"type": "subtitle", "time": 6652.629, "timestamp": "01:50:52", "text": "。"}, {"type": "subtitle", "time": 6654.709, "timestamp": "01:50:54", "text": "该死，听起来太不对劲了。"}, {"type": "subtitle", "time": 6655.35, "timestamp": "01:50:55", "text": "我的天啊。"}, {"type": "chat", "time": 6656.486, "timestamp": "01:50:56", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "i was not know he's french bread"}, {"type": "subtitle", "time": 6657.43, "timestamp": "01:50:57", "text": "我知道你是好意，但"}]
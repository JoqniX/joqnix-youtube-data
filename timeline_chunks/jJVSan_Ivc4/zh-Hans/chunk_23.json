[{"type": "subtitle", "time": 1381.19, "timestamp": "00:23:01", "text": "欢迎光临。"}, {"type": "subtitle", "time": 1384.47, "timestamp": "00:23:04", "text": "欢迎我的朋友。"}, {"type": "subtitle", "time": 1386.789, "timestamp": "00:23:06", "text": "问候。"}, {"type": "subtitle", "time": 1390.87, "timestamp": "00:23:10", "text": "今天我们有一位客人。 乔克。 下一个。 乔。"}, {"type": "subtitle", "time": 1392.149, "timestamp": "00:23:12", "text": "乔，你愿意谈谈你"}, {"type": "subtitle", "time": 1398.47, "timestamp": "00:23:18", "text": "你好，亚当。"}, {"type": "subtitle", "time": 1399.83, "timestamp": "00:23:19", "text": "很高兴见到你。"}, {"type": "subtitle", "time": 1401.909, "timestamp": "00:23:21", "text": "可能不认识你，你知道，我"}, {"type": "subtitle", "time": 1404.31, "timestamp": "00:23:24", "text": "觉得我们应该向对方解释一下"}, {"type": "subtitle", "time": 1406.95, "timestamp": "00:23:26", "text": "你是谁。"}, {"type": "subtitle", "time": 1419.99, "timestamp": "00:23:39", "text": "内拉，对吧？ 还是只有我一个人这么觉得？"}, {"type": "subtitle", "time": 1421.59, "timestamp": "00:23:41", "text": "或者"}, {"type": "subtitle", "time": 1423.19, "timestamp": "00:23:43", "text": "我觉得我们一起结束了之"}, {"type": "subtitle", "time": 1424.149, "timestamp": "00:23:44", "text": "类的？"}, {"type": "subtitle", "time": 1427.27, "timestamp": "00:23:47", "text": "我们做到了。 我们还没去过下一个"}, {"type": "subtitle", "time": 1429.27, "timestamp": "00:23:49", "text": "岛。"}, {"type": "subtitle", "time": 1431.669, "timestamp": "00:23:51", "text": "哦，是的。 下一个岛屿。"}, {"type": "subtitle", "time": 1434.95, "timestamp": "00:23:54", "text": "我当时想去那里看看，但是"}, {"type": "subtitle", "time": 1439.51, "timestamp": "00:23:59", "text": "开发者说它还没有完全完成，"}]
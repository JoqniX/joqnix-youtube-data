[{"type": "subtitle", "time": 7141.99, "timestamp": "01:59:01", "text": "仔细想想，我们好像从来没建过私信"}, {"type": "subtitle", "time": 7144.47, "timestamp": "01:59:04", "text": "群，对吧？"}, {"type": "subtitle", "time": 7145.669, "timestamp": "01:59:05", "text": "你想聊什么？ 你"}, {"type": "subtitle", "time": 7147.109, "timestamp": "01:59:07", "text": "知道，你知道，我会寄纸条"}, {"type": "subtitle", "time": 7148.709, "timestamp": "01:59:08", "text": "过去。 所以，"}, {"type": "subtitle", "time": 7171.43, "timestamp": "01:59:31", "text": "我的天啊。 嗨，欢迎进来。我们就像"}, {"type": "subtitle", "time": 7173.27, "timestamp": "01:59:33", "text": "我一样，突然就给他打了个电话。"}, {"type": "chat", "time": 7174.203, "timestamp": "01:59:34", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "yaaaaa"}, {"type": "subtitle", "time": 7176.149, "timestamp": "01:59:36", "text": "所以我不知道他是否会加入。   是的"}, {"type": "subtitle", "time": 7178.79, "timestamp": "01:59:38", "text": "。"}, {"type": "subtitle", "time": 7180.47, "timestamp": "01:59:40", "text": "我问：“你有空吗？” 他回答说："}, {"type": "subtitle", "time": 7182.39, "timestamp": "01:59:42", "text": "“是啊。” 我心想：“我"}, {"type": "subtitle", "time": 7185.109, "timestamp": "01:59:45", "text": "脖子僵硬，但我自由了。” 我当时就想，“约翰·科伊尔，赶紧去吸毒"}, {"type": "subtitle", "time": 7190.149, "timestamp": "01:59:50", "text": "，马上！”"}, {"type": "subtitle", "time": 7196.709, "timestamp": "01:59:56", "text": "我想他现在正在打开电脑"}]
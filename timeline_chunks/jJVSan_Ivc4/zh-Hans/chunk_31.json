[{"type": "subtitle", "time": 1865.43, "timestamp": "00:31:05", "text": "当你的比特率低的时候会自动恢复。"}, {"type": "subtitle", "time": 1867.83, "timestamp": "00:31:07", "text": "是的，"}, {"type": "subtitle", "time": 1870.31, "timestamp": "00:31:10", "text": "我的意思是这软件不错。比如我可以"}, {"type": "subtitle", "time": 1873.51, "timestamp": "00:31:13", "text": "给你加像这样的LED灯"}, {"type": "subtitle", "time": 1876.23, "timestamp": "00:31:16", "text": "。你能给我加LED灯吗？"}, {"type": "subtitle", "time": 1878.31, "timestamp": "00:31:18", "text": "黑白的。"}, {"type": "subtitle", "time": 1879.83, "timestamp": "00:31:19", "text": "看看直播。我可以把你变成"}, {"type": "subtitle", "time": 1883.35, "timestamp": "00:31:23", "text": "幽灵。可以把你变成全息影像。"}, {"type": "subtitle", "time": 1885.99, "timestamp": "00:31:25", "text": "它有延迟。 直播，所以我看不到。是"}, {"type": "subtitle", "time": 1888.87, "timestamp": "00:31:28", "text": "啊。是啊。再等一分钟。"}, {"type": "subtitle", "time": 1891.99, "timestamp": "00:31:31", "text": "我在等。我在等。"}, {"type": "subtitle", "time": 1898.549, "timestamp": "00:31:38", "text": "啊，我可以做很多事。真"}, {"type": "subtitle", "time": 1900.23, "timestamp": "00:31:40", "text": "不错。"}, {"type": "subtitle", "time": 1902.47, "timestamp": "00:31:42", "text": "不。乔，你对我干嘛？"}, {"type": "subtitle", "time": 1910.23, "timestamp": "00:31:50", "text": "好吧。它应该随时都会出现。快点。快了。是"}, {"type": "subtitle", "time": 1912.149, "timestamp": "00:31:52", "text": "啊。不，我知道它正在"}, {"type": "subtitle", "time": 1915.19, "timestamp": "00:31:55", "text": "显示。它在直播里显示。"}, {"type": "subtitle", "time": 1917.99, "timestamp": "00:31:57", "text": "什么？我没看到。"}, {"type": "subtitle", "time": 1919.509, "timestamp": "00:31:59", "text": "应该是8点。"}]
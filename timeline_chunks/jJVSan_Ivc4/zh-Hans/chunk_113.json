[{"type": "subtitle", "time": 6781.43, "timestamp": "01:53:01", "text": "我也是这么想的。 老兄，"}, {"type": "subtitle", "time": 6784.149, "timestamp": "01:53:04", "text": "你是干什么的？ 这些人吃什么食物"}, {"type": "subtitle", "time": 6785.43, "timestamp": "01:53:05", "text": "？"}, {"type": "subtitle", "time": 6785.91, "timestamp": "01:53:05", "text": "嗯，"}, {"type": "subtitle", "time": 6787.109, "timestamp": "01:53:07", "text": "糖。"}, {"type": "subtitle", "time": 6789.669, "timestamp": "01:53:09", "text": "我不知道。 这是个好问题。"}, {"type": "subtitle", "time": 6793.109, "timestamp": "01:53:13", "text": "嗯，我还在考虑。"}, {"type": "subtitle", "time": 6795.189, "timestamp": "01:53:15", "text": "正在路上。 开始了。 它要来了。 它正向"}, {"type": "subtitle", "time": 6799.03, "timestamp": "01:53:19", "text": "我走来。 没关系。"}, {"type": "subtitle", "time": 6815.03, "timestamp": "01:53:35", "text": "别笑了，那样只会"}, {"type": "subtitle", "time": 6815.91, "timestamp": "01:53:35", "text": "让情况更糟。"}, {"type": "subtitle", "time": 6818.39, "timestamp": "01:53:38", "text": "我刚才把水洒了。"}, {"type": "chat", "time": 6818.825, "timestamp": "01:53:38", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "they eat water?"}, {"type": "subtitle", "time": 6820.629, "timestamp": "01:53:40", "text": "你知道为什么吗？ 我想我从未跟你说过"}, {"type": "subtitle", "time": 6824.149, "timestamp": "01:53:44", "text": "这件事。 我曾经在 Zen Kishbut 的"}, {"type": "subtitle", "time": 6826.87, "timestamp": "01:53:46", "text": "直播中，就像那样，不是以合作的形式，而是在"}, {"type": "subtitle", "time": 6831.35, "timestamp": "01:53:51", "text": "直播聊天室的评论区里。 我在那里。 我当时"}, {"type": "subtitle", "time": 6833.109, "timestamp": "01:53:53", "text": "就想，“哦，你好，Zen。” 她当时就说："}, {"type": "subtitle", "time": 6834.95, "timestamp": "01:53:54", "text": "“我的天哪，你是"}, {"type": "subtitle", "time": 6836.87, "timestamp": "01:53:56", "text": "面包吗？” 然后她就做了那个"}, {"type": "subtitle", "time": 6838.47, "timestamp": "01:53:58", "text": "手势。"}]
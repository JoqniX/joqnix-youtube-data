[{"type": "subtitle", "time": 4085.349, "timestamp": "01:08:05", "text": "真好。我和Somi"}, {"type": "subtitle", "time": 4088.23, "timestamp": "01:08:08", "text": "算是新手，但我们一直在"}, {"type": "subtitle", "time": 4091.19, "timestamp": "01:08:11", "text": "和其他人，现在的朋友一起玩。"}, {"type": "subtitle", "time": 4092.63, "timestamp": "01:08:12", "text": "所以，我们升级了。"}, {"type": "subtitle", "time": 4097.03, "timestamp": "01:08:17", "text": "经常害怕。玩这个游戏玩得很多。"}, {"type": "subtitle", "time": 4104.149, "timestamp": "01:08:24", "text": "你现在害怕吗？因为我觉得你很"}, {"type": "subtitle", "time": 4106.07, "timestamp": "01:08:26", "text": "害怕。每次"}, {"type": "subtitle", "time": 4120.39, "timestamp": "01:08:40", "text": "痛苦"}, {"type": "subtitle", "time": 4123.269, "timestamp": "01:08:43", "text": "就是痛苦。"}, {"type": "subtitle", "time": 4125.59, "timestamp": "01:08:45", "text": "对了，你最近和多少人"}, {"type": "subtitle", "time": 4137.749, "timestamp": "01:08:57", "text": "让我看看我的"}]
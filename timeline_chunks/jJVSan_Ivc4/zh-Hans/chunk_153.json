[{"type": "subtitle", "time": 9183.03, "timestamp": "02:33:03", "text": "我记得看完那部电影后，我给"}, {"type": "subtitle", "time": 9185.59, "timestamp": "02:33:05", "text": "一个朋友发了私信，说：“兄弟，你很"}, {"type": "subtitle", "time": 9188.71, "timestamp": "02:33:08", "text": "重要。” 我爱你。”你知道，然后"}, {"type": "subtitle", "time": 9191.99, "timestamp": "02:33:11", "text": "他就说，“你快死了吗，伙计？”我"}, {"type": "subtitle", "time": 9193.51, "timestamp": "02:33:13", "text": "说，“没有，我刚看完超人"}, {"type": "subtitle", "time": 9195.75, "timestamp": "02:33:15", "text": "电影。”我说，“糟了。” 好的。 好的。"}, {"type": "subtitle", "time": 9199.83, "timestamp": "02:33:19", "text": "谢谢你，兄弟。 我也爱你。” 好吧。"}, {"type": "subtitle", "time": 9202.23, "timestamp": "02:33:22", "text": "我不是给你们发过一条吗"}, {"type": "subtitle", "time": 9204.23, "timestamp": "02:33:24", "text": "？"}, {"type": "subtitle", "time": 9207.349, "timestamp": "02:33:27", "text": "你可以发。"}, {"type": "subtitle", "time": 9209.27, "timestamp": "02:33:29", "text": "看完超人之后，我的确发了。"}, {"type": "subtitle", "time": 9215.99, "timestamp": "02:33:35", "text": "你在睡觉吗？嘿，别上班睡觉"}, {"type": "subtitle", "time": 9217.19, "timestamp": "02:33:37", "text": "。我一直"}, {"type": "subtitle", "time": 9219.75, "timestamp": "02:33:39", "text": "很安静。真抱歉。"}, {"type": "subtitle", "time": 9222.23, "timestamp": "02:33:42", "text": "我一直在偷听。"}, {"type": "subtitle", "time": 9225.67, "timestamp": "02:33:45", "text": "我试着想象，"}, {"type": "subtitle", "time": 9226.07, "timestamp": "02:33:46", "text": "你知道，"}, {"type": "subtitle", "time": 9228.469, "timestamp": "02:33:48", "text": "偷听什么？"}, {"type": "subtitle", "time": 9231.59, "timestamp": "02:33:51", "text": "肌肉男。然后你们"}, {"type": "subtitle", "time": 9233.429, "timestamp": "02:33:53", "text": "刚才聊了什么来着？"}, {"type": "subtitle", "time": 9235.03, "timestamp": "02:33:55", "text": "ZZ"}, {"type": "subtitle", "time": 9237.27, "timestamp": "02:33:57", "text": "超人"}, {"type": "subtitle", "time": 9239.91, "timestamp": "02:33:59", "text": "问他们，"}]
[{"type": "subtitle", "time": 8106.149, "timestamp": "02:15:06", "text": "随时欢迎回来。"}, {"type": "subtitle", "time": 8108.79, "timestamp": "02:15:08", "text": "欢迎回来。你刚才弯腰驼背"}, {"type": "subtitle", "time": 8111.43, "timestamp": "02:15:11", "text": "之后又站起来了吗？"}, {"type": "subtitle", "time": 8114.229, "timestamp": "02:15:14", "text": "我还在弯腰驼背。"}, {"type": "subtitle", "time": 8115.35, "timestamp": "02:15:15", "text": "哦，"}, {"type": "subtitle", "time": 8117.669, "timestamp": "02:15:17", "text": "我只是把麦克风拉近了。好的，我"}, {"type": "subtitle", "time": 8121.03, "timestamp": "02:15:21", "text": "明白了。我只是把麦克风往旁边挪了挪"}, {"type": "subtitle", "time": 8123.35, "timestamp": "02:15:23", "text": "。"}, {"type": "subtitle", "time": 8127.43, "timestamp": "02:15:27", "text": "你知道我怎么看出你弯腰驼背吗？"}, {"type": "subtitle", "time": 8129.75, "timestamp": "02:15:29", "text": "看看模特，就像看到模特的脖子。"}, {"type": "subtitle", "time": 8136.87, "timestamp": "02:15:36", "text": "这就像脖子从这"}, {"type": "subtitle", "time": 8140.709, "timestamp": "02:15:40", "text": "玩意儿里伸出来一样。不过我能看到。"}, {"type": "subtitle", "time": 8143.03, "timestamp": "02:15:43", "text": "呃，也可能是我的手机。"}, {"type": "subtitle", "time": 8153.43, "timestamp": "02:15:53", "text": "啊。DL DTLS是什么？"}, {"type": "subtitle", "time": 8154.31, "timestamp": "02:15:54", "text": "这是新东西。"}, {"type": "subtitle", "time": 8157.43, "timestamp": "02:15:57", "text": "它只是……它只是意味着你"}]
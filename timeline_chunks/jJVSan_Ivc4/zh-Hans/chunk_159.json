[{"type": "subtitle", "time": 9542.63, "timestamp": "02:39:02", "text": "晚安。祝你好运。你们俩"}, {"type": "subtitle", "time": 9544.389, "timestamp": "02:39:04", "text": "晚安。我得走了。"}, {"type": "subtitle", "time": 9545.75, "timestamp": "02:39:05", "text": "晚安。"}, {"type": "subtitle", "time": 9546.95, "timestamp": "02:39:06", "text": "拜拜。"}, {"type": "subtitle", "time": 9549.03, "timestamp": "02:39:09", "text": "谢谢你们今天过来"}, {"type": "subtitle", "time": 9551.67, "timestamp": "02:39:11", "text": "。谢谢。"}, {"type": "subtitle", "time": 9554.79, "timestamp": "02:39:14", "text": "也谢谢你们"}, {"type": "subtitle", "time": 9557.429, "timestamp": "02:39:17", "text": "这么快就过来，我之前还在"}, {"type": "subtitle", "time": 9559.99, "timestamp": "02:39:19", "text": "私信里冲他喊“快来快来”。我当时"}, {"type": "subtitle", "time": 9566.71, "timestamp": "02:39:26", "text": "吓坏了，"}, {"type": "subtitle", "time": 9572.07, "timestamp": "02:39:32", "text": "哦，肯定有什么不好的事情要发生了。"}, {"type": "subtitle", "time": 9575.44, "timestamp": "02:39:35", "text": "不，不，是布拉德在给我打电话。"}, {"type": "subtitle", "time": 9576.55, "timestamp": "02:39:36", "text": "[音乐]"}, {"type": "subtitle", "time": 9579.51, "timestamp": "02:39:39", "text": "总之，谢谢你们邀请我，"}, {"type": "subtitle", "time": 9592.55, "timestamp": "02:39:52", "text": "哎，我们真的不擅长结尾。我们不擅长结尾。"}]
[{"type": "subtitle", "time": 6960.47, "timestamp": "01:56:00", "text": "我的天啊。"}, {"type": "subtitle", "time": 6963.27, "timestamp": "01:56:03", "text": "我可不是开玩笑。 我可不是"}, {"type": "subtitle", "time": 6965.75, "timestamp": "01:56:05", "text": "开玩笑。 她被那个笑话逗乐了足足"}, {"type": "subtitle", "time": 6968.79, "timestamp": "01:56:08", "text": "十分钟。 我的天啊。"}, {"type": "subtitle", "time": 6971.189, "timestamp": "01:56:11", "text": "她咯咯笑了足足十分钟"}, {"type": "subtitle", "time": 6973.91, "timestamp": "01:56:13", "text": "。 我可不是开玩笑。 我当时非常"}, {"type": "subtitle", "time": 6975.27, "timestamp": "01:56:15", "text": "生气。"}, {"type": "subtitle", "time": 6977.589, "timestamp": "01:56:17", "text": "哦不，"}, {"type": "subtitle", "time": 6979.51, "timestamp": "01:56:19", "text": "我一点也不觉得那句话冒犯了我。"}, {"type": "subtitle", "time": 6981.91, "timestamp": "01:56:21", "text": "Zen居然对着"}, {"type": "subtitle", "time": 6985.109, "timestamp": "01:56:25", "text": "那个笑话笑了10分钟，这让我很生气。"}, {"type": "subtitle", "time": 6985.589, "timestamp": "01:56:25", "text": "哦，还有"}, {"type": "subtitle", "time": 6987.51, "timestamp": "01:56:27", "text": "10分钟。   我"}, {"type": "subtitle", "time": 6990.31, "timestamp": "01:56:30", "text": "只是被那个近亲繁殖的笑话逗笑了。"}, {"type": "subtitle", "time": 6993.589, "timestamp": "01:56:33", "text": "比如什么？"}, {"type": "subtitle", "time": 6995.589, "timestamp": "01:56:35", "text": "人啊。 该死的人。"}, {"type": "subtitle", "time": 6997.589, "timestamp": "01:56:37", "text": "这就是我为"}, {"type": "subtitle", "time": 6999.669, "timestamp": "01:56:39", "text": "别人创作同人作品的下场，然后他们"}, {"type": "subtitle", "time": 7001.99, "timestamp": "01:56:41", "text": "就叫我近亲繁殖。"}, {"type": "subtitle", "time": 7003.51, "timestamp": "01:56:43", "text": "哦，不。"}, {"type": "subtitle", "time": 7005.99, "timestamp": "01:56:45", "text": "然后，当我"}, {"type": "subtitle", "time": 7007.91, "timestamp": "01:56:47", "text": "为Jock制作表情包时，他就会说：“是啊，"}, {"type": "subtitle", "time": 7010.55, "timestamp": "01:56:50", "text": "我要吃了你。” 什么？ 这就是"}, {"type": "subtitle", "time": 7012.229, "timestamp": "01:56:52", "text": "我得到的？"}, {"type": "subtitle", "time": 7012.87, "timestamp": "01:56:52", "text": "不，"}]
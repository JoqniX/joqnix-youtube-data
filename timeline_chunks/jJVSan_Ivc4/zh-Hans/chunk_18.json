[{"type": "subtitle", "time": 1084.789, "timestamp": "00:18:04", "text": "。 从本月（7 月）开始，我"}, {"type": "subtitle", "time": 1087.27, "timestamp": "00:18:07", "text": "对 Joathon 的格式进行了更改，"}, {"type": "subtitle", "time": 1089.75, "timestamp": "00:18:09", "text": "这样我就可以专注于制作合适的"}, {"type": "subtitle", "time": 1092.87, "timestamp": "00:18:12", "text": "直播缩略图等等。"}, {"type": "subtitle", "time": 1096.15, "timestamp": "00:18:16", "text": "我需要做这件事。 我不擅长制作"}, {"type": "subtitle", "time": 1098.63, "timestamp": "00:18:18", "text": "缩略图。"}, {"type": "subtitle", "time": 1100.95, "timestamp": "00:18:20", "text": "没关系。 看起来不错，我的朋友。 我"}, {"type": "subtitle", "time": 1102.47, "timestamp": "00:18:22", "text": "看起来像个傻瓜。 我就是这个"}, {"type": "subtitle", "time": 1103.19, "timestamp": "00:18:23", "text": "意思。"}, {"type": "subtitle", "time": 1105.11, "timestamp": "00:18:25", "text": "你好。"}, {"type": "subtitle", "time": 1105.669, "timestamp": "00:18:25", "text": "但没错，"}, {"type": "subtitle", "time": 1109.19, "timestamp": "00:18:29", "text": "这里只有我看起来很蠢。"}, {"type": "subtitle", "time": 1111.19, "timestamp": "00:18:31", "text": "我的天啊。 不用担心。"}, {"type": "subtitle", "time": 1115.83, "timestamp": "00:18:35", "text": "我差点笑出声来，感觉"}, {"type": "subtitle", "time": 1118.87, "timestamp": "00:18:38", "text": "口水都要喷出来了。"}, {"type": "subtitle", "time": 1121.11, "timestamp": "00:18:41", "text": "你喜欢被自己的"}, {"type": "subtitle", "time": 1122.23, "timestamp": "00:18:42", "text": "唾液呛到吗？   是的"}, {"type": "subtitle", "time": 1123.83, "timestamp": "00:18:43", "text": "。"}, {"type": "subtitle", "time": 1130.87, "timestamp": "00:18:50", "text": "那可真是件了不起的事。"}, {"type": "subtitle", "time": 1133.43, "timestamp": "00:18:53", "text": "新的恐惧被唤醒。 该死。 被"}, {"type": "subtitle", "time": 1135.99, "timestamp": "00:18:55", "text": "自己的唾液呛到。 耶稣。"}]
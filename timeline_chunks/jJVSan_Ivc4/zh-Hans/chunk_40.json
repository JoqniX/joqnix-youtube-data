[{"type": "subtitle", "time": 2400.39, "timestamp": "00:40:00", "text": "你现在就会烧掉很多钱，是的，"}, {"type": "subtitle", "time": 2404.87, "timestamp": "00:40:04", "text": "我想是这样的。 呃，他们没"}, {"type": "subtitle", "time": 2408.15, "timestamp": "00:40:08", "text": "好好调查所有事情，"}, {"type": "subtitle", "time": 2411.91, "timestamp": "00:40:11", "text": "也没好好记录。不仅如此，"}, {"type": "subtitle", "time": 2415.19, "timestamp": "00:40:15", "text": "还有很多其他问题，比如"}, {"type": "subtitle", "time": 2418.87, "timestamp": "00:40:18", "text": "后来那场"}, {"type": "subtitle", "time": 2421.27, "timestamp": "00:40:21", "text": "闹剧发生之后，现在每天都有"}, {"type": "subtitle", "time": 2423.829, "timestamp": "00:40:23", "text": "人跳出来，说我们给"}, {"type": "subtitle", "time": 2426.63, "timestamp": "00:40:26", "text": "你看，简直是"}, {"type": "subtitle", "time": 2428.71, "timestamp": "00:40:28", "text": "火上浇油。"}, {"type": "subtitle", "time": 2430.79, "timestamp": "00:40:30", "text": "哦，其实我知道"}, {"type": "subtitle", "time": 2432.71, "timestamp": "00:40:32", "text": "那里发生了什么。我掌握一些"}, {"type": "subtitle", "time": 2435.99, "timestamp": "00:40:35", "text": "信息。我讨厌那种人，他们就像在火上浇油，好像"}, {"type": "subtitle", "time": 2440.23, "timestamp": "00:40:40", "text": "整栋楼都着火了，你"}, {"type": "subtitle", "time": 2442.23, "timestamp": "00:40:42", "text": "没必要再火上浇油似的。好像在说：“没事了，"}, {"type": "subtitle", "time": 2446.79, "timestamp": "00:40:46", "text": "你知道，它正在燃烧。”然后他们就说："}, {"type": "subtitle", "time": 2448.87, "timestamp": "00:40:48", "text": "“哦，是啊。” 我想要全部。 我"}, {"type": "subtitle", "time": 2450.79, "timestamp": "00:40:50", "text": "只想，我只想，我只想，我希望这事儿能"}, {"type": "subtitle", "time": 2453.589, "timestamp": "00:40:53", "text": "持续一段时间。”然后它就持续了"}, {"type": "subtitle", "time": 2457.19, "timestamp": "00:40:57", "text": "一段时间。大概两天，五天，一个"}, {"type": "subtitle", "time": 2458.95, "timestamp": "00:40:58", "text": "星期，也许吧。"}]
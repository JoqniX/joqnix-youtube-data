[{"type": "subtitle", "time": 1801.11, "timestamp": "00:30:01", "text": "的天。因为我用的是M键，就像……"}, {"type": "subtitle", "time": 1804.23, "timestamp": "00:30:04", "text": "OBS，我还能理解，因为它有这个"}, {"type": "subtitle", "time": 1807.11, "timestamp": "00:30:07", "text": "功能。"}, {"type": "subtitle", "time": 1807.51, "timestamp": "00:30:07", "text": "但"}, {"type": "subtitle", "time": 1810.31, "timestamp": "00:30:10", "text": "你为什么换成这个？"}, {"type": "subtitle", "time": 1812.789, "timestamp": "00:30:12", "text": "因为这是MEL，我注意到如果"}, {"type": "subtitle", "time": 1815.909, "timestamp": "00:30:15", "text": "我的比特率很低的话……"}, {"type": "subtitle", "time": 1817.83, "timestamp": "00:30:17", "text": "哦。哦，等等。因为我在下载"}, {"type": "subtitle", "time": 1820.71, "timestamp": "00:30:20", "text": "你跟我说的那个游戏。所以才会这样……"}, {"type": "subtitle", "time": 1823.029, "timestamp": "00:30:23", "text": "我的天。你现在不用下载"}, {"type": "subtitle", "time": 1824.47, "timestamp": "00:30:24", "text": "，兄弟。"}, {"type": "subtitle", "time": 1826.23, "timestamp": "00:30:26", "text": "好吧。好吧。它应该会慢慢恢复的"}, {"type": "subtitle", "time": 1828.47, "timestamp": "00:30:28", "text": "。好吧。它应该会恢复的。让我看看"}, {"type": "subtitle", "time": 1831.269, "timestamp": "00:30:31", "text": "它恢复的程度。"}, {"type": "subtitle", "time": 1832.47, "timestamp": "00:30:32", "text": "好吧。它正在"}, {"type": "subtitle", "time": 1833.269, "timestamp": "00:30:33", "text": "下载。还有"}, {"type": "subtitle", "time": 1834.789, "timestamp": "00:30:34", "text": "50秒。明天再"}, {"type": "subtitle", "time": 1838.389, "timestamp": "00:30:38", "text": "玩吧。"}, {"type": "subtitle", "time": 1845.51, "timestamp": "00:30:45", "text": "有40秒的延迟，不过好吧。"}, {"type": "subtitle", "time": 1849.35, "timestamp": "00:30:49", "text": "它最终会赶上的。我希望如此。"}, {"type": "subtitle", "time": 1852.07, "timestamp": "00:30:52", "text": "是的，它正在慢慢恢复。但"}, {"type": "subtitle", "time": 1856.149, "timestamp": "00:30:56", "text": "我确实"}, {"type": "subtitle", "time": 1858.31, "timestamp": "00:30:58", "text": "不知道"}]
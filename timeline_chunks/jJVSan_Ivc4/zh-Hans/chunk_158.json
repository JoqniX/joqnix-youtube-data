[{"type": "subtitle", "time": 9480.389, "timestamp": "02:38:00", "text": "摔得正中目标。我的"}, {"type": "subtitle", "time": 9481.19, "timestamp": "02:38:01", "text": "天啊。"}, {"type": "subtitle", "time": 9487.19, "timestamp": "02:38:07", "text": "你能想象吗？"}, {"type": "subtitle", "time": 9490.309, "timestamp": "02:38:10", "text": "他已经开始想象自己像个"}, {"type": "subtitle", "time": 9492.63, "timestamp": "02:38:12", "text": "面包一样，用他那"}, {"type": "subtitle", "time": 9494.389, "timestamp": "02:38:14", "text": "简笔画般的手，从"}, {"type": "subtitle", "time": 9497.27, "timestamp": "02:38:17", "text": "楼梯上滚下来了。是啊，他正在想象。是"}, {"type": "subtitle", "time": 9500.469, "timestamp": "02:38:20", "text": "啊，我打赌他的"}, {"type": "subtitle", "time": 9503.349, "timestamp": "02:38:23", "text": "头都掉出来了。"}, {"type": "subtitle", "time": 9505.59, "timestamp": "02:38:25", "text": "什么？"}, {"type": "subtitle", "time": 9510.63, "timestamp": "02:38:30", "text": "不，面包，青铜，它有"}, {"type": "subtitle", "time": 9522.15, "timestamp": "02:38:42", "text": "我的天哪。没事。没事"}, {"type": "subtitle", "time": 9524.63, "timestamp": "02:38:44", "text": "。你"}, {"type": "subtitle", "time": 9526.55, "timestamp": "02:38:46", "text": "现在想睡觉吗？因为我觉得"}, {"type": "subtitle", "time": 9527.99, "timestamp": "02:38:47", "text": "我该走了。"}, {"type": "subtitle", "time": 9528.71, "timestamp": "02:38:48", "text": "哦，是该走了。"}, {"type": "subtitle", "time": 9530.389, "timestamp": "02:38:50", "text": "你想睡觉吗？"}, {"type": "subtitle", "time": 9532.07, "timestamp": "02:38:52", "text": "嗯。"}, {"type": "subtitle", "time": 9532.63, "timestamp": "02:38:52", "text": "嗨，"}, {"type": "subtitle", "time": 9535.349, "timestamp": "02:38:55", "text": "Aru。我想，我想，我私下问你这个问题"}, {"type": "subtitle", "time": 9537.59, "timestamp": "02:38:57", "text": "。私下问你这个问题。"}, {"type": "subtitle", "time": 9539.67, "timestamp": "02:38:59", "text": "好的。"}]
[{"type": "subtitle", "time": 1620.07, "timestamp": "00:27:00", "text": "好吧，这很奇怪。"}, {"type": "subtitle", "time": 1623.029, "timestamp": "00:27:03", "text": "我猜乔之前可能"}, {"type": "subtitle", "time": 1624.789, "timestamp": "00:27:04", "text": "懒散地坐在椅子上，现在他站"}, {"type": "subtitle", "time": 1625.99, "timestamp": "00:27:05", "text": "起来了。"}, {"type": "subtitle", "time": 1628.39, "timestamp": "00:27:08", "text": "等等，你是怎么知道的？ 你怎么"}, {"type": "subtitle", "time": 1630.63, "timestamp": "00:27:10", "text": "能听到你的……我能听到你的"}, {"type": "subtitle", "time": 1638.95, "timestamp": "00:27:18", "text": "是啊，我当时弯着腰，他站了起来。"}, {"type": "subtitle", "time": 1641.11, "timestamp": "00:27:21", "text": "是啊，我当时就想，“好吧，我得把"}, {"type": "subtitle", "time": 1653.269, "timestamp": "00:27:33", "text": "哦，哥们儿。哥们儿，哥们儿。所以，你"}, {"type": "subtitle", "time": 1656.149, "timestamp": "00:27:36", "text": "现在想解决这个问题？"}, {"type": "subtitle", "time": 1661.99, "timestamp": "00:27:41", "text": "哦，"}, {"type": "subtitle", "time": 1664.31, "timestamp": "00:27:44", "text": "是啊"}, {"type": "subtitle", "time": 1666.07, "timestamp": "00:27:46", "text": "。"}, {"type": "subtitle", "time": 1667.83, "timestamp": "00:27:47", "text": "你最近在玩什么游戏"}, {"type": "subtitle", "time": 1669.99, "timestamp": "00:27:49", "text": "？"}, {"type": "subtitle", "time": 1671.99, "timestamp": "00:27:51", "text": "嗯，"}, {"type": "subtitle", "time": 1675.029, "timestamp": "00:27:55", "text": "对。我觉得这个"}, {"type": "subtitle", "time": 1678.07, "timestamp": "00:27:58", "text": "月我简直"}, {"type": "subtitle", "time": 1679.909, "timestamp": "00:27:59", "text": "无聊透顶。"}]
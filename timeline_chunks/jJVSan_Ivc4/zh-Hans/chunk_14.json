[{"type": "subtitle", "time": 842.23, "timestamp": "00:14:02", "text": "，昨天我和一位"}, {"type": "subtitle", "time": 847.269, "timestamp": "00:14:07", "text": "我最近认识的日本 YouTuber 聊了聊，"}, {"type": "subtitle", "time": 849.509, "timestamp": "00:14:09", "text": "希望他们也在聊天室里。"}, {"type": "subtitle", "time": 852.069, "timestamp": "00:14:12", "text": "虽然不太确定，但他们确实会过来"}, {"type": "subtitle", "time": 855.269, "timestamp": "00:14:15", "text": "看看我什么的。 我其实聊了一整晚，"}, {"type": "subtitle", "time": 857.35, "timestamp": "00:14:17", "text": "嗯，"}, {"type": "subtitle", "time": 860.55, "timestamp": "00:14:20", "text": "那太好了。 这很健康，"}, {"type": "subtitle", "time": 863.269, "timestamp": "00:14:23", "text": "因为我"}, {"type": "subtitle", "time": 865.269, "timestamp": "00:14:25", "text": "昨天直播后都没怎么睡觉。 我当时就想，"}, {"type": "subtitle", "time": 867.509, "timestamp": "00:14:27", "text": "“你想表达什么？”"}, {"type": "subtitle", "time": 870.15, "timestamp": "00:14:30", "text": "所以，我熬夜到七点左右，然后和人"}, {"type": "subtitle", "time": 872.47, "timestamp": "00:14:32", "text": "聊天，把事情做完，就去"}, {"type": "subtitle", "time": 874.15, "timestamp": "00:14:34", "text": "睡觉了。   是的"}, {"type": "subtitle", "time": 877.829, "timestamp": "00:14:37", "text": "，所以我显然意识到，"}, {"type": "subtitle", "time": 880.71, "timestamp": "00:14:40", "text": "你知道，嗯，"}, {"type": "subtitle", "time": 883.59, "timestamp": "00:14:43", "text": "当涉及到做那些事情的时候，"}, {"type": "subtitle", "time": 885.11, "timestamp": "00:14:45", "text": "对吧，商品什么的，"}, {"type": "subtitle", "time": 888.15, "timestamp": "00:14:48", "text": "对吧？ 呃，我意识到我"}, {"type": "subtitle", "time": 892.389, "timestamp": "00:14:52", "text": "其实可以，或者说，我可能"}, {"type": "subtitle", "time": 895.509, "timestamp": "00:14:55", "text": "尝试过两者都做，就像"}, {"type": "subtitle", "time": 898.55, "timestamp": "00:14:58", "text": "那些日本YouTube博主一样，"}]
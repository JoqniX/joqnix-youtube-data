[{"type": "subtitle", "time": 2528.55, "timestamp": "00:42:08", "text": "不过我觉得这镜头还是挺搞笑的"}, {"type": "subtitle", "time": 2532.63, "timestamp": "00:42:12", "text": "。一段非常搞笑的视频。"}, {"type": "subtitle", "time": 2535.589, "timestamp": "00:42:15", "text": "谁会这么做？谁会"}, {"type": "subtitle", "time": 2542.71, "timestamp": "00:42:22", "text": "哦，天哪，"}, {"type": "subtitle", "time": 2548.55, "timestamp": "00:42:28", "text": "这个月有人做了好多事。"}, {"type": "subtitle", "time": 2550.63, "timestamp": "00:42:30", "text": "很棒的事。"}, {"type": "subtitle", "time": 2553.03, "timestamp": "00:42:33", "text": "有趣的事。"}, {"type": "subtitle", "time": 2555.43, "timestamp": "00:42:35", "text": "说到有趣，你平时做什么"}, {"type": "subtitle", "time": 2559.67, "timestamp": "00:42:39", "text": "有趣的工作？快说说吧。你"}, {"type": "subtitle", "time": 2565.67, "timestamp": "00:42:45", "text": "看，我一直在问你最近在干什么"}, {"type": "subtitle", "time": 2567.349, "timestamp": "00:42:47", "text": "。"}, {"type": "subtitle", "time": 2569.99, "timestamp": "00:42:49", "text": "我不知道我的意思，我的意思是，他们"}, {"type": "subtitle", "time": 2571.99, "timestamp": "00:42:51", "text": "提到我一直在做这些"}, {"type": "subtitle", "time": 2572.79, "timestamp": "00:42:52", "text": "活动。"}, {"type": "subtitle", "time": 2574.63, "timestamp": "00:42:54", "text": "是啊，你确实提到了。但我还是不停地问"}, {"type": "subtitle", "time": 2577.99, "timestamp": "00:42:57", "text": "。我也不知道为什么。"}]
[{"type": "subtitle", "time": 5221.91, "timestamp": "01:27:01", "text": "之类的问题了。我写着写着，突然"}, {"type": "subtitle", "time": 5224.95, "timestamp": "01:27:04", "text": "想，哦，对了，我得去吃饭了，"}, {"type": "subtitle", "time": 5227.99, "timestamp": "01:27:07", "text": "回来面包等着呢。"}, {"type": "subtitle", "time": 5229.91, "timestamp": "01:27:09", "text": "然后我就给你发了消息，"}, {"type": "subtitle", "time": 5234.47, "timestamp": "01:27:14", "text": "对，我给你发了消息，然后我就跑"}, {"type": "subtitle", "time": 5236.709, "timestamp": "01:27:16", "text": "去吃了"}, {"type": "subtitle", "time": 5239.59, "timestamp": "01:27:19", "text": "晚饭，回来了，结果"}, {"type": "subtitle", "time": 5255.99, "timestamp": "01:27:35", "text": "是啊，就是这样。我发现，"}, {"type": "subtitle", "time": 5259.91, "timestamp": "01:27:39", "text": "如果我在子版块里说话，"}, {"type": "subtitle", "time": 5262.87, "timestamp": "01:27:42", "text": "对方就得因为我的"}, {"type": "subtitle", "time": 5267.99, "timestamp": "01:27:47", "text": "问题和我过于复杂的痛苦而受罪。"}, {"type": "subtitle", "time": 5270.709, "timestamp": "01:27:50", "text": "哦，"}, {"type": "subtitle", "time": 5272.95, "timestamp": "01:27:52", "text": "就像你，我的意思是，你已经知道"}, {"type": "subtitle", "time": 5276.229, "timestamp": "01:27:56", "text": "我是什么样的人了。 现在说到这些"}, {"type": "subtitle", "time": 5279.669, "timestamp": "01:27:59", "text": "事情，我就想，是啊，我"}]
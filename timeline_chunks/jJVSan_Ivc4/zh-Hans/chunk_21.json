[{"type": "subtitle", "time": 1260.31, "timestamp": "00:21:00", "text": "闲逛着，边走边聊，你知道，就是"}, {"type": "subtitle", "time": 1266.47, "timestamp": "00:21:06", "text": "放松一下。"}, {"type": "subtitle", "time": 1272.95, "timestamp": "00:21:12", "text": "在过去的几个月里，你一直在"}, {"type": "subtitle", "time": 1276.39, "timestamp": "00:21:16", "text": "玩一款名为“巅峰游戏”（Peak）的新游戏"}, {"type": "subtitle", "time": 1283.669, "timestamp": "00:21:23", "text": "你自己一直都很享受。 甚至没有"}, {"type": "subtitle", "time": 1287.669, "timestamp": "00:21:27", "text": "合作，只是自己玩而已。"}, {"type": "subtitle", "time": 1291.11, "timestamp": "00:21:31", "text": "是的，我当时在"}, {"type": "subtitle", "time": 1293.909, "timestamp": "00:21:33", "text": "看一些单人速通"}, {"type": "subtitle", "time": 1295.669, "timestamp": "00:21:35", "text": "之类的视频。 我当时想，“哦，我可以做到"}, {"type": "subtitle", "time": 1299.029, "timestamp": "00:21:39", "text": "。我可以自己通关。” 然后"}, {"type": "subtitle", "time": 1301.35, "timestamp": "00:21:41", "text": "我就想，“好吧，我挑战自己，"}, {"type": "subtitle", "time": 1304.47, "timestamp": "00:21:44", "text": "然后我真的战胜了它。”"}, {"type": "subtitle", "time": 1306.549, "timestamp": "00:21:46", "text": "该死。 我没想到会做那样的"}, {"type": "subtitle", "time": 1309.11, "timestamp": "00:21:49", "text": "梦。 但老天，"}, {"type": "subtitle", "time": 1311.83, "timestamp": "00:21:51", "text": "这真是太棒了。"}, {"type": "subtitle", "time": 1316.149, "timestamp": "00:21:56", "text": "那很好，因为这很好，但"}, {"type": "subtitle", "time": 1319.27, "timestamp": "00:21:59", "text": "也非常像失业。 你知道吗，你"}]
[{"type": "subtitle", "time": 5100.47, "timestamp": "01:25:00", "text": "嗯。说"}, {"type": "subtitle", "time": 5103.189, "timestamp": "01:25:03", "text": "实话。是啊"}, {"type": "subtitle", "time": 5108.95, "timestamp": "01:25:08", "text": "。你吃晚饭了吗？所有那些……"}, {"type": "subtitle", "time": 5110.39, "timestamp": "01:25:10", "text": "是"}, {"type": "subtitle", "time": 5111.91, "timestamp": "01:25:11", "text": "啊。是啊，我吃了。我吃了。因为你……"}, {"type": "subtitle", "time": 5113.99, "timestamp": "01:25:13", "text": "太慢了。我做好晚饭，"}, {"type": "subtitle", "time": 5116.87, "timestamp": "01:25:16", "text": "吃了晚饭，"}, {"type": "subtitle", "time": 5119.27, "timestamp": "01:25:19", "text": "然后——我真没开玩笑——"}, {"type": "subtitle", "time": 5122.31, "timestamp": "01:25:22", "text": "我拉完屎回来，你"}, {"type": "subtitle", "time": 5128.229, "timestamp": "01:25:28", "text": "我"}, {"type": "subtitle", "time": 5138.31, "timestamp": "01:25:38", "text": "你还是迟到了，Jock。你"}, {"type": "subtitle", "time": 5139.11, "timestamp": "01:25:39", "text": "还是迟到了。"}, {"type": "subtitle", "time": 5146.55, "timestamp": "01:25:46", "text": "好吧，给电视机"}, {"type": "subtitle", "time": 5148.87, "timestamp": "01:25:48", "text": "前的观众们解释一下，我"}, {"type": "subtitle", "time": 5151.75, "timestamp": "01:25:51", "text": "和他本来约好在他那边的7点见面"}, {"type": "subtitle", "time": 5154.79, "timestamp": "01:25:54", "text": "。也就是我那边"}, {"type": "subtitle", "time": 5158.47, "timestamp": "01:25:58", "text": "3、4点，"}]
[{"type": "subtitle", "time": 9426.71, "timestamp": "02:37:06", "text": "而且它还会动什么的。我想我不"}, {"type": "subtitle", "time": 9426.87, "timestamp": "02:37:06", "text": "知道。"}, {"type": "subtitle", "time": 9428.63, "timestamp": "02:37:08", "text": "你得给我解释"}, {"type": "subtitle", "time": 9429.51, "timestamp": "02:37:09", "text": "一下，伙计。"}, {"type": "subtitle", "time": 9431.99, "timestamp": "02:37:11", "text": "我不知道。"}, {"type": "subtitle", "time": 9435.27, "timestamp": "02:37:15", "text": "有这部动画吗？"}, {"type": "subtitle", "time": 9437.91, "timestamp": "02:37:17", "text": "我不记得了。"}, {"type": "subtitle", "time": 9439.67, "timestamp": "02:37:19", "text": "在另一个世界。"}, {"type": "subtitle", "time": 9441.59, "timestamp": "02:37:21", "text": "他现在正在与他的心魔作斗争"}, {"type": "subtitle", "time": 9444.63, "timestamp": "02:37:24", "text": "。"}, {"type": "subtitle", "time": 9444.95, "timestamp": "02:37:24", "text": "所以，是"}, {"type": "subtitle", "time": 9445.83, "timestamp": "02:37:25", "text": "内心的恶魔。"}, {"type": "subtitle", "time": 9448.63, "timestamp": "02:37:28", "text": "不，说实话，我从来没经历过这种事。"}, {"type": "subtitle", "time": 9451.83, "timestamp": "02:37:31", "text": "我今天怎么了？"}, {"type": "subtitle", "time": 9453.67, "timestamp": "02:37:33", "text": "就像喝醉了一样。就像"}, {"type": "subtitle", "time": 9455.27, "timestamp": "02:37:35", "text": "睡着了一样。"}, {"type": "subtitle", "time": 9457.59, "timestamp": "02:37:37", "text": "是的， 我们喝醉了。"}, {"type": "subtitle", "time": 9459.349, "timestamp": "02:37:39", "text": "是啊，"}, {"type": "subtitle", "time": 9461.67, "timestamp": "02:37:41", "text": "喝醉了。"}, {"type": "subtitle", "time": 9464.309, "timestamp": "02:37:44", "text": "上次我喝醉了，还得"}, {"type": "subtitle", "time": 9467.51, "timestamp": "02:37:47", "text": "再做一次手术。我的天哪"}, {"type": "subtitle", "time": 9469.83, "timestamp": "02:37:49", "text": "。"}, {"type": "subtitle", "time": 9472.63, "timestamp": "02:37:52", "text": "因为我从楼梯上摔下来，"}, {"type": "subtitle", "time": 9476.71, "timestamp": "02:37:56", "text": "头正好撞到了酒杯上。"}, {"type": "subtitle", "time": 9478.23, "timestamp": "02:37:58", "text": "完美。我没开玩笑。我"}]
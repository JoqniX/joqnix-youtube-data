[{"type": "subtitle", "time": 2580.63, "timestamp": "00:43:00", "text": "我觉得你应该问问我最近在干什么。是啊。"}, {"type": "subtitle", "time": 2584.069, "timestamp": "00:43:04", "text": "你这几个月都在干什么"}, {"type": "subtitle", "time": 2587.109, "timestamp": "00:43:07", "text": "？是啊，"}, {"type": "subtitle", "time": 2589.19, "timestamp": "00:43:09", "text": "我一直在"}, {"type": "subtitle", "time": 2591.99, "timestamp": "00:43:11", "text": "思考。我一直在，你知道，"}, {"type": "subtitle", "time": 2595.43, "timestamp": "00:43:15", "text": "就像贝吉塔在那个……呃……那个"}, {"type": "subtitle", "time": 2599.589, "timestamp": "00:43:19", "text": "叫什么来着？精神时光屋。对。"}, {"type": "subtitle", "time": 2601.43, "timestamp": "00:43:21", "text": "在精神时光屋里。他一直在"}, {"type": "subtitle", "time": 2603.75, "timestamp": "00:43:23", "text": "训练。我也一直在做。"}, {"type": "subtitle", "time": 2606.79, "timestamp": "00:43:26", "text": "我一直在去健身房，试着"}, {"type": "subtitle", "time": 2608.63, "timestamp": "00:43:28", "text": "走路，试着跑步，等等。 我"}, {"type": "subtitle", "time": 2609.99, "timestamp": "00:43:29", "text": "加强了有氧运动，"}, {"type": "subtitle", "time": 2612.87, "timestamp": "00:43:32", "text": "诸如此类。也想稍微提升一下我的肌肉量"}, {"type": "subtitle", "time": 2616.309, "timestamp": "00:43:36", "text": "。你知道，"}, {"type": "subtitle", "time": 2622.39, "timestamp": "00:43:42", "text": "最近看了《超人》之后，不知怎么的，我对人有点太……怎么说呢？特别热情。"}, {"type": "subtitle", "time": 2624.55, "timestamp": "00:43:44", "text": "我也不知道"}, {"type": "subtitle", "time": 2626.47, "timestamp": "00:43:46", "text": "这是怎么回事。"}, {"type": "subtitle", "time": 2626.95, "timestamp": "00:43:46", "text": "嗯。"}, {"type": "subtitle", "time": 2630.47, "timestamp": "00:43:50", "text": "还有，基本上就是搞搞艺术之"}, {"type": "subtitle", "time": 2633.109, "timestamp": "00:43:53", "text": "类的，你知道，画画什么的，比如"}, {"type": "subtitle", "time": 2635.75, "timestamp": "00:43:55", "text": "画别人，接一些委托什么的，"}, {"type": "subtitle", "time": 2638.39, "timestamp": "00:43:58", "text": "只要工作之余就画画"}]
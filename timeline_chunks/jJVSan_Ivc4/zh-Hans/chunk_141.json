[{"type": "subtitle", "time": 8464.79, "timestamp": "02:21:04", "text": "这家伙块头很大。"}, {"type": "subtitle", "time": 8475.59, "timestamp": "02:21:15", "text": "阿鲁，你应该有一天把它变成你的PSP"}, {"type": "subtitle", "time": 8477.75, "timestamp": "02:21:17", "text": "。"}, {"type": "subtitle", "time": 8480.469, "timestamp": "02:21:20", "text": "哦，这是ZZ里的。我刚刚才注意到。"}, {"type": "subtitle", "time": 8482.15, "timestamp": "02:21:22", "text": "哦，我从不玩。"}, {"type": "subtitle", "time": 8485.19, "timestamp": "02:21:25", "text": "我想大家都在聊天。"}, {"type": "subtitle", "time": 8487.59, "timestamp": "02:21:27", "text": "你刚才在说Z。我还以为"}, {"type": "subtitle", "time": 8490.71, "timestamp": "02:21:30", "text": "是别的游戏呢。我的天哪。这么久了"}, {"type": "subtitle", "time": 8491.75, "timestamp": "02:21:31", "text": "。"}, {"type": "subtitle", "time": 8493.11, "timestamp": "02:21:33", "text": "你在这里吗？"}, {"type": "subtitle", "time": 8495.03, "timestamp": "02:21:35", "text": "我的灵魂在这里。"}, {"type": "subtitle", "time": 8496.63, "timestamp": "02:21:36", "text": "等等，醒醒。所以，"}, {"type": "subtitle", "time": 8500.79, "timestamp": "02:21:40", "text": "醒醒，乔。醒醒。醒醒 嗨，老兄。"}, {"type": "subtitle", "time": 8502.87, "timestamp": "02:21:42", "text": "我之前不知道这个角色。我也没"}, {"type": "subtitle", "time": 8505.67, "timestamp": "02:21:45", "text": "玩过。我当时想，“哦，你"}, {"type": "subtitle", "time": 8507.51, "timestamp": "02:21:47", "text": "说的是某个游戏啊。” 我不知道。”"}, {"type": "subtitle", "time": 8509.51, "timestamp": "02:21:49", "text": "大概吧。"}, {"type": "subtitle", "time": 8511.51, "timestamp": "02:21:51", "text": "我只是觉得我特意强调过，"}, {"type": "subtitle", "time": 8514.15, "timestamp": "02:21:54", "text": "“哦，我记得那个ZZ角色。” 我"}, {"type": "subtitle", "time": 8516.23, "timestamp": "02:21:56", "text": "不记得她的名字了。"}, {"type": "subtitle", "time": 8517.429, "timestamp": "02:21:57", "text": "我确实说过这话。"}, {"type": "subtitle", "time": 8518.309, "timestamp": "02:21:58", "text": "你在吗？ 好的。"}, {"type": "subtitle", "time": 8519.349, "timestamp": "02:21:59", "text": "你在这里？   是的"}, {"type": "subtitle", "time": 8519.75, "timestamp": "02:21:59", "text": "。"}]
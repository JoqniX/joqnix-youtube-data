[{"type": "subtitle", "time": 6840.79, "timestamp": "01:54:00", "text": "你知道吗，你就是那块面包吗？"}, {"type": "subtitle", "time": 6843.189, "timestamp": "01:54:03", "text": "你知道，你知道我做的事。"}, {"type": "subtitle", "time": 6845.83, "timestamp": "01:54:05", "text": "你做什么工作？"}, {"type": "subtitle", "time": 6849.43, "timestamp": "01:54:09", "text": "搞什么鬼？ 你是我的朋友吗？"}, {"type": "subtitle", "time": 6850.79, "timestamp": "01:54:10", "text": "你做什么工作？"}, {"type": "subtitle", "time": 6852.79, "timestamp": "01:54:12", "text": "我认识你。 你是什​​么意思？   是"}, {"type": "subtitle", "time": 6853.75, "timestamp": "01:54:13", "text": "我吗，伙计们？"}, {"type": "subtitle", "time": 6856.31, "timestamp": "01:54:16", "text": "我就是面包。 对，你说那样做。"}, {"type": "chat", "time": 6856.524, "timestamp": "01:54:16", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "Zen!???"}, {"type": "subtitle", "time": 6858.47, "timestamp": "01:54:18", "text": "对，面包。   是的"}, {"type": "subtitle", "time": 6860.629, "timestamp": "01:54:20", "text": "。 我不知道，我不知道是不是该死的。"}, {"type": "subtitle", "time": 6862.31, "timestamp": "01:54:22", "text": "我该怎么办？ 什么？ 乔，你这话是什么意思"}, {"type": "subtitle", "time": 6863.99, "timestamp": "01:54:23", "text": "？ 你不认识我吗，伙计？   是的"}, {"type": "subtitle", "time": 6865.99, "timestamp": "01:54:25", "text": "，我就是面包。"}, {"type": "subtitle", "time": 6870.629, "timestamp": "01:54:30", "text": "对，你负责问候。 对，面包。"}, {"type": "subtitle", "time": 6874.229, "timestamp": "01:54:34", "text": "现在，我应该做什么手势？"}, {"type": "chat", "time": 6875.95, "timestamp": "01:54:35", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "you mean zentriya?"}, {"type": "subtitle", "time": 6876.07, "timestamp": "01:54:36", "text": "手势。 啊，就是那个"}, {"type": "subtitle", "time": 6881.589, "timestamp": "01:54:41", "text": "法语的Y，呃，就是用"}, {"type": "subtitle", "time": 6882.95, "timestamp": "01:54:42", "text": "拇指和手指按的那个东西。"}, {"type": "subtitle", "time": 6885.589, "timestamp": "01:54:45", "text": "你只需要说“捏手指”就行了，不用说"}, {"type": "subtitle", "time": 6888.629, "timestamp": "01:54:48", "text": "法语里那些乱七八糟的词。 你不能就这么这么说"}, {"type": "subtitle", "time": 6889.109, "timestamp": "01:54:49", "text": "。"}, {"type": "subtitle", "time": 6897.51, "timestamp": "01:54:57", "text": "呃，我该怎么做才能"}]
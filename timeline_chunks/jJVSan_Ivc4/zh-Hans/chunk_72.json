[{"type": "subtitle", "time": 4322.95, "timestamp": "01:12:02", "text": "她居然以为我是个女的，呃，"}, {"type": "subtitle", "time": 4326.229, "timestamp": "01:12:06", "text": "就凭我的声音，还有"}, {"type": "subtitle", "time": 4330.87, "timestamp": "01:12:10", "text": "我的互动方式什么的。嗯，是啊，"}, {"type": "subtitle", "time": 4332.95, "timestamp": "01:12:12", "text": "呃，她好像很惊讶我的"}, {"type": "subtitle", "time": 4335.43, "timestamp": "01:12:15", "text": "音调这么高。她就这么"}, {"type": "subtitle", "time": 4336.63, "timestamp": "01:12:16", "text": "提了一下。"}, {"type": "subtitle", "time": 4339.03, "timestamp": "01:12:19", "text": "她没叫你粉丝。"}, {"type": "subtitle", "time": 4340.55, "timestamp": "01:12:20", "text": "不，"}, {"type": "subtitle", "time": 4344.149, "timestamp": "01:12:24", "text": "只有西方人才会说"}, {"type": "subtitle", "time": 4347.35, "timestamp": "01:12:27", "text": "粉丝什么的。我的天啊"}, {"type": "subtitle", "time": 4351.04, "timestamp": "01:12:31", "text": "。我的天啊 。我觉得"}, {"type": "subtitle", "time": 4353.679, "timestamp": "01:12:33", "text": "。我觉得 如果我开始直播，有人看的话，你肯定会脑洞大开，"}, {"type": "subtitle", "time": 4370.229, "timestamp": "01:12:50", "text": "你根本没利用好这种"}, {"type": "subtitle", "time": 4373.189, "timestamp": "01:12:53", "text": "声音，老兄。拜托。"}, {"type": "subtitle", "time": 4374.709, "timestamp": "01:12:54", "text": "你说的“利用声音”是什么意思"}, {"type": "subtitle", "time": 4376.55, "timestamp": "01:12:56", "text": "？"}, {"type": "subtitle", "time": 4379.51, "timestamp": "01:12:59", "text": "是啊，你知道，你见过那些"}]
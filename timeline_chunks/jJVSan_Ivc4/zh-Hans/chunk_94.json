[{"type": "subtitle", "time": 5641.51, "timestamp": "01:34:01", "text": "你就像昨天直播里那样…… 你看起来精神"}, {"type": "subtitle", "time": 5643.669, "timestamp": "01:34:03", "text": "萎靡，"}, {"type": "subtitle", "time": 5645.91, "timestamp": "01:34:05", "text": "好像不在似的。本来可以"}, {"type": "subtitle", "time": 5650.55, "timestamp": "01:34:10", "text": "和朋友们一起玩《龙与地下城》直播，那会非常有趣的。那真的"}, {"type": "subtitle", "time": 5652.31, "timestamp": "01:34:12", "text": "超级好玩。"}, {"type": "subtitle", "time": 5655.03, "timestamp": "01:34:15", "text": "我的天哪。和朋友们一起玩《"}, {"type": "subtitle", "time": 5658.149, "timestamp": "01:34:18", "text": "龙与地下城》，做些傻事。哦，天哪。太棒了。我"}, {"type": "subtitle", "time": 5661.669, "timestamp": "01:34:21", "text": "一天都不会错过。"}, {"type": "subtitle", "time": 5663.75, "timestamp": "01:34:23", "text": "但你看起来就像不在"}, {"type": "subtitle", "time": 5666.31, "timestamp": "01:34:26", "text": "状态。你没精神，因为"}, {"type": "subtitle", "time": 5668.47, "timestamp": "01:34:28", "text": "你太累了。"}, {"type": "subtitle", "time": 5671.91, "timestamp": "01:34:31", "text": "就像你说的，你没睡好。你应该解决这个问题。是啊"}, {"type": "subtitle", "time": 5672.229, "timestamp": "01:34:32", "text": "。"}, {"type": "subtitle", "time": 5676.39, "timestamp": "01:34:36", "text": "如果你解决了这个问题，也许你"}, {"type": "subtitle", "time": 5679.83, "timestamp": "01:34:39", "text": "在直播的时候会更活跃，更开心。"}, {"type": "subtitle", "time": 5681.83, "timestamp": "01:34:41", "text": "更有活力。"}, {"type": "subtitle", "time": 5684.79, "timestamp": "01:34:44", "text": "因为如果你没有精力，你当时只是在"}, {"type": "subtitle", "time": 5687.11, "timestamp": "01:34:47", "text": "勉强自己而已。 你知道，"}, {"type": "subtitle", "time": 5689.03, "timestamp": "01:34:49", "text": "如果你不想做，那就别做。   别他妈的"}, {"type": "subtitle", "time": 5692.87, "timestamp": "01:34:52", "text": "硬把它弄出来。"}, {"type": "subtitle", "time": 5694.39, "timestamp": "01:34:54", "text": "你没在拉屎，老兄。 不要"}, {"type": "subtitle", "time": 5697.27, "timestamp": "01:34:57", "text": "强行取出。 就让它"}]
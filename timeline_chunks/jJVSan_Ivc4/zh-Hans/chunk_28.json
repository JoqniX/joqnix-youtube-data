[{"type": "subtitle", "time": 1681.909, "timestamp": "00:28:01", "text": "我超级无聊，然后"}, {"type": "subtitle", "time": 1685.35, "timestamp": "00:28:05", "text": "我看到"}, {"type": "subtitle", "time": 1688.07, "timestamp": "00:28:08", "text": "蝙蝠侠阿卡姆三部曲，也就是阿卡姆系列游戏在打折什么的，"}, {"type": "subtitle", "time": 1690.07, "timestamp": "00:28:10", "text": "我就想，你知道吗"}, {"type": "subtitle", "time": 1692.31, "timestamp": "00:28:12", "text": "，我在我的PS4上玩过这些游戏"}, {"type": "subtitle", "time": 1695.029, "timestamp": "00:28:15", "text": "。不如再玩一遍吧"}, {"type": "subtitle", "time": 1697.11, "timestamp": "00:28:17", "text": "。所以我就这么做了。我把"}, {"type": "subtitle", "time": 1700.789, "timestamp": "00:28:20", "text": "所有阿卡姆系列游戏都玩了一遍。感觉很棒"}, {"type": "subtitle", "time": 1703.59, "timestamp": "00:28:23", "text": "。真"}, {"type": "subtitle", "time": 1704.389, "timestamp": "00:28:24", "text": "不错。"}, {"type": "subtitle", "time": 1707.99, "timestamp": "00:28:27", "text": "现在我看到……"}, {"type": "subtitle", "time": 1709.99, "timestamp": "00:28:29", "text": "我不知道你是否"}, {"type": "subtitle", "time": 1713.83, "timestamp": "00:28:33", "text": "了解这个系列。是《无限地球"}, {"type": "subtitle", "time": 1715.83, "timestamp": "00:28:35", "text": "危机》。你玩过《无限地球"}, {"type": "subtitle", "time": 1717.59, "timestamp": "00:28:37", "text": "危机》吗？"}, {"type": "subtitle", "time": 1720.63, "timestamp": "00:28:40", "text": "呃，没有，还没玩过。"}, {"type": "subtitle", "time": 1723.59, "timestamp": "00:28:43", "text": "我觉得你会喜欢的。” 就像第一人称射击游戏。"}, {"type": "subtitle", "time": 1726.87, "timestamp": "00:28:46", "text": "就像《孤岛惊魂》，你知道吗？它就像"}, {"type": "subtitle", "time": 1729.83, "timestamp": "00:28:49", "text": "一款未来版的《孤岛惊魂》。当时很"}, {"type": "subtitle", "time": 1731.909, "timestamp": "00:28:51", "text": "火。我以前经常在"}, {"type": "subtitle", "time": 1737.029, "timestamp": "00:28:57", "text": "我的PS上玩，"}, {"type": "subtitle", "time": 1738.389, "timestamp": "00:28:58", "text": "你知道的，"}]
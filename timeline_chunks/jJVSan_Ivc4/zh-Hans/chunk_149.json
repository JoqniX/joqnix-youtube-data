[{"type": "subtitle", "time": 8941.99, "timestamp": "02:29:01", "text": "然后，我"}, {"type": "subtitle", "time": 8943.75, "timestamp": "02:29:03", "text": "可不是开玩笑，我第一次"}, {"type": "subtitle", "time": 8945.83, "timestamp": "02:29:05", "text": "玩的时候，"}, {"type": "subtitle", "time": 8949.429, "timestamp": "02:29:09", "text": "每当我的马女角色在"}, {"type": "subtitle", "time": 8951.67, "timestamp": "02:29:11", "text": "别人身后的时候，我都紧张得要命。 我当时就想，“哦，哦"}, {"type": "subtitle", "time": 8954.71, "timestamp": "02:29:14", "text": "不，老兄。哦不，不是你。哦不，我们不能"}, {"type": "subtitle", "time": 8956.469, "timestamp": "02:29:16", "text": "拿第二，老兄。哦不，我们不能"}, {"type": "subtitle", "time": 8966.15, "timestamp": "02:29:26", "text": "太糟糕了。游戏就像……但"}, {"type": "subtitle", "time": 8968.71, "timestamp": "02:29:28", "text": "它确实不错，你知道吗？我喜欢它。我喜欢"}, {"type": "subtitle", "time": 8971.51, "timestamp": "02:29:31", "text": "演唱会，歌曲什么的。"}, {"type": "subtitle", "time": 8979.59, "timestamp": "02:29:39", "text": "你看过动画吗？"}, {"type": "subtitle", "time": 8981.51, "timestamp": "02:29:41", "text": "没有。"}, {"type": "subtitle", "time": 8984.71, "timestamp": "02:29:44", "text": "哇。动画也很好。你应该"}, {"type": "subtitle", "time": 8986.23, "timestamp": "02:29:46", "text": "看看。"}, {"type": "subtitle", "time": 8988.87, "timestamp": "02:29:48", "text": "等等，你居然没看过？"}, {"type": "subtitle", "time": 8991.03, "timestamp": "02:29:51", "text": "我过去六个月都没看过动画了"}, {"type": "subtitle", "time": 8992.389, "timestamp": "02:29:52", "text": "。"}, {"type": "subtitle", "time": 8993.91, "timestamp": "02:29:53", "text": "我的天，他开始关注了。你"}, {"type": "subtitle", "time": 8999.67, "timestamp": "02:29:59", "text": "你听到这些掌声了吗？"}]
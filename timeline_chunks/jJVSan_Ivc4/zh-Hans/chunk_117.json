[{"type": "subtitle", "time": 7023.189, "timestamp": "01:57:03", "text": "拜托，老兄。 这就是我得到的。   是的"}, {"type": "subtitle", "time": 7025.589, "timestamp": "01:57:05", "text": "。 你值得拥有这份爱。 你"}, {"type": "subtitle", "time": 7028.79, "timestamp": "01:57:08", "text": "值得拥有全世界。 是的，"}, {"type": "subtitle", "time": 7031.189, "timestamp": "01:57:11", "text": "你的确有。 是的。"}, {"type": "subtitle", "time": 7033.589, "timestamp": "01:57:13", "text": "哇。 哇。 工作。 为什么？ 你为什么垂头丧气？"}, {"type": "subtitle", "time": 7035.189, "timestamp": "01:57:15", "text": "为什么？ 为什么？"}, {"type": "subtitle", "time": 7036.31, "timestamp": "01:57:16", "text": "哥们儿，你嘴里怎么吐口水了？"}, {"type": "subtitle", "time": 7038.39, "timestamp": "01:57:18", "text": "什么？"}, {"type": "subtitle", "time": 7039.83, "timestamp": "01:57:19", "text": "你为什么那样看着我，还说那样的话"}, {"type": "subtitle", "time": 7053.669, "timestamp": "01:57:33", "text": "，我的天。"}, {"type": "subtitle", "time": 7057.75, "timestamp": "01:57:37", "text": "老兄，我太喜欢和你一起做这件事了。"}, {"type": "subtitle", "time": 7060.47, "timestamp": "01:57:40", "text": "我也很喜欢。 是的，的确如此。 很有趣。"}, {"type": "subtitle", "time": 7063.91, "timestamp": "01:57:43", "text": "我喜欢这个。 太好玩了。"}, {"type": "subtitle", "time": 7066.229, "timestamp": "01:57:46", "text": "只有我。 啊，我只需要再添一个"}, {"type": "subtitle", "time": 7069.43, "timestamp": "01:57:49", "text": "人就行了。 他在哪儿？ 我来问问他。"}, {"type": "subtitle", "time": 7071.189, "timestamp": "01:57:51", "text": "如果你能来个十分"}, {"type": "subtitle", "time": 7079.35, "timestamp": "01:57:59", "text": "你知道，我们的人，我们的主力，"}, {"type": "subtitle", "time": 7079.91, "timestamp": "01:57:59", "text": "Roku。   是的"}]
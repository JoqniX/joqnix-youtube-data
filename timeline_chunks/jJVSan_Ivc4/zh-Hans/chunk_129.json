[{"type": "subtitle", "time": 7749.03, "timestamp": "02:09:09", "text": "。"}, {"type": "subtitle", "time": 7751.83, "timestamp": "02:09:11", "text": "我喜欢这玩意儿。"}, {"type": "subtitle", "time": 7754.95, "timestamp": "02:09:14", "text": "希望你当时没在睡觉。"}, {"type": "subtitle", "time": 7755.75, "timestamp": "02:09:15", "text": "欢迎加入。"}, {"type": "subtitle", "time": 7757.51, "timestamp": "02:09:17", "text": "嗯，如果你喜欢的话，就算你不想"}, {"type": "subtitle", "time": 7760.79, "timestamp": "02:09:20", "text": "很快加入也没关系。"}, {"type": "subtitle", "time": 7763.589, "timestamp": "02:09:23", "text": "不用担心。 我们以后随时可以一起出去玩"}, {"type": "subtitle", "time": 7764.149, "timestamp": "02:09:24", "text": "。"}, {"type": "subtitle", "time": 7766.229, "timestamp": "02:09:26", "text": "大概十分钟后下车。 我要"}, {"type": "subtitle", "time": 7769.109, "timestamp": "02:09:29", "text": "下车了。 我们当时正在聊天，突然"}, {"type": "subtitle", "time": 7771.51, "timestamp": "02:09:31", "text": "我脑海里浮现出“你”这个名字，"}, {"type": "subtitle", "time": 7773.589, "timestamp": "02:09:33", "text": "我就想，你知道吗？"}, {"type": "subtitle", "time": 7778.069, "timestamp": "02:09:38", "text": "我们现在急需阿鲁苏。 我们需要他。"}, {"type": "subtitle", "time": 7780.55, "timestamp": "02:09:40", "text": "我需要他。"}, {"type": "subtitle", "time": 7782.39, "timestamp": "02:09:42", "text": "我刚刚给你发了私信。"}, {"type": "subtitle", "time": 7784.069, "timestamp": "02:09:44", "text": "我不知道你也在，我还"}, {"type": "subtitle", "time": 7785.589, "timestamp": "02:09:45", "text": "以为你不会回复呢，"}, {"type": "subtitle", "time": 7786.87, "timestamp": "02:09:46", "text": "你可能要过"}, {"type": "subtitle", "time": 7789.75, "timestamp": "02:09:49", "text": "四个小时左右才会看到这条消息。"}]
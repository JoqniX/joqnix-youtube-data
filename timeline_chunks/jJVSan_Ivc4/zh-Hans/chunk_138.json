[{"type": "subtitle", "time": 8280.469, "timestamp": "02:18:00", "text": "是的。你们吃完了吗？ 你吃饭了吗？"}, {"type": "subtitle", "time": 8281.669, "timestamp": "02:18:01", "text": "没有。"}, {"type": "subtitle", "time": 8287.99, "timestamp": "02:18:07", "text": "你怎么敢不吃饭？你想当个运动"}, {"type": "subtitle", "time": 8290.629, "timestamp": "02:18:10", "text": "健将吗？你想让"}, {"type": "subtitle", "time": 8292.15, "timestamp": "02:18:12", "text": "邻居说：“孩子，你父母"}, {"type": "subtitle", "time": 8294.23, "timestamp": "02:18:14", "text": "喂你吃饭了吗？”   “"}, {"type": "subtitle", "time": 8296.709, "timestamp": "02:18:16", "text": "他们不喂你吗？”"}, {"type": "subtitle", "time": 8299.509, "timestamp": "02:18:19", "text": "你想那样？"}, {"type": "subtitle", "time": 8301.669, "timestamp": "02:18:21", "text": "拜托。我们得吃饭，伙计。你也得"}, {"type": "subtitle", "time": 8306.549, "timestamp": "02:18:26", "text": "仍然是我听过最奇怪的话"}, {"type": "subtitle", "time": 8312.23, "timestamp": "02:18:32", "text": "什么？"}, {"type": "subtitle", "time": 8319.99, "timestamp": "02:18:39", "text": "你今天过得怎么样？"}, {"type": "subtitle", "time": 8321.99, "timestamp": "02:18:41", "text": "别死了。"}, {"type": "subtitle", "time": 8327.19, "timestamp": "02:18:47", "text": "[音乐]"}, {"type": "subtitle", "time": 8329.349, "timestamp": "02:18:49", "text": "看看我的头像。你不觉得这个人快"}, {"type": "subtitle", "time": 8331.11, "timestamp": "02:18:51", "text": "死了吗？"}, {"type": "subtitle", "time": 8337.11, "timestamp": "02:18:57", "text": "好吧。"}, {"type": "subtitle", "time": 8339.75, "timestamp": "02:18:59", "text": "你真的在看它吗？该死。是的"}]
[{"type": "subtitle", "time": 9301.83, "timestamp": "02:35:01", "text": "是啊，我知道我们好久没联系了"}, {"type": "subtitle", "time": 9304.15, "timestamp": "02:35:04", "text": "，不过没关系，伙计。你可以"}, {"type": "subtitle", "time": 9315.67, "timestamp": "02:35:15", "text": "别在中间呻吟了。"}, {"type": "subtitle", "time": 9337.27, "timestamp": "02:35:37", "text": "，乔。我不会再讲"}, {"type": "subtitle", "time": 9340.95, "timestamp": "02:35:40", "text": "老掉牙的笑话了。我好害怕。"}, {"type": "subtitle", "time": 9344.469, "timestamp": "02:35:44", "text": "我比你老。比"}, {"type": "subtitle", "time": 9345.75, "timestamp": "02:35:45", "text": "星座还老。是啊。是啊"}, {"type": "subtitle", "time": 9350.15, "timestamp": "02:35:50", "text": "。"}, {"type": "subtitle", "time": 9354.37, "timestamp": "02:35:54", "text": "我从没见过爷爷儿子。"}, {"type": "subtitle", "time": 9355.67, "timestamp": "02:35:55", "text": "[音乐]"}, {"type": "subtitle", "time": 9358.71, "timestamp": "02:35:58", "text": "我还年轻。"}, {"type": "subtitle", "time": 9359.99, "timestamp": "02:35:59", "text": "哦，儿子。"}]
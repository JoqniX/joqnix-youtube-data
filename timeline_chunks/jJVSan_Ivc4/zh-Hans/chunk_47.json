[{"type": "subtitle", "time": 2821.91, "timestamp": "00:47:01", "text": "心里还是觉得，哦不，你只是在"}, {"type": "subtitle", "time": 2824.71, "timestamp": "00:47:04", "text": "浪费时间。"}, {"type": "subtitle", "time": 2826.71, "timestamp": "00:47:06", "text": "你知道，就像，哦，你只是在"}, {"type": "subtitle", "time": 2828.39, "timestamp": "00:47:08", "text": "做这个做那个。但这还"}, {"type": "subtitle", "time": 2831.349, "timestamp": "00:47:11", "text": "不够。你得做更多。我不知道"}, {"type": "subtitle", "time": 2842.47, "timestamp": "00:47:22", "text": "呃，是啊。你觉得我"}, {"type": "subtitle", "time": 2845.109, "timestamp": "00:47:25", "text": "这该死的……我不知道"}, {"type": "subtitle", "time": 2848.39, "timestamp": "00:47:28", "text": "该怎么称呼这种事怎么样？该怎么称呼这种事？ 这是什么？"}, {"type": "subtitle", "time": 2851.349, "timestamp": "00:47:31", "text": "我这是怎么了？这是"}, {"type": "subtitle", "time": 2857.589, "timestamp": "00:47:37", "text": "[音乐]"}, {"type": "subtitle", "time": 2860.95, "timestamp": "00:47:40", "text": "等等，等等。我刚才走神了"}, {"type": "subtitle", "time": 2863.19, "timestamp": "00:47:43", "text": "。"}, {"type": "subtitle", "time": 2866.39, "timestamp": "00:47:46", "text": "不，不，不。我当时在努力想象。"}, {"type": "subtitle", "time": 2868.069, "timestamp": "00:47:48", "text": "不，不，不，不，不。等等，等等，等等。"}, {"type": "subtitle", "time": 2871.43, "timestamp": "00:47:51", "text": "让我解释一下。我当时在想象"}, {"type": "subtitle", "time": 2871.829, "timestamp": "00:47:51", "text": "你。"}, {"type": "subtitle", "time": 2872.95, "timestamp": "00:47:52", "text": "好吧，我们可以想象成一个"}, {"type": "subtitle", "time": 2875.67, "timestamp": "00:47:55", "text": "火柴人，"}, {"type": "subtitle", "time": 2877.99, "timestamp": "00:47:57", "text": "手很小什么的。"}, {"type": "subtitle", "time": 2879.829, "timestamp": "00:47:59", "text": "当你在说这些的时候，"}]
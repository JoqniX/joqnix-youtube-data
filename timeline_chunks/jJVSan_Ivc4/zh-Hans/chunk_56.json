[{"type": "subtitle", "time": 3361.51, "timestamp": "00:56:01", "text": "阻止你？阻止你？没人"}, {"type": "subtitle", "time": 3364.069, "timestamp": "00:56:04", "text": "阻止你打广告。"}, {"type": "subtitle", "time": 3365.43, "timestamp": "00:56:05", "text": "谁会反对？我要"}, {"type": "subtitle", "time": 3368.15, "timestamp": "00:56:08", "text": "反对。对。你在自导自演。我要"}, {"type": "subtitle", "time": 3370.47, "timestamp": "00:56:10", "text": "反对，因为我是"}, {"type": "subtitle", "time": 3378.71, "timestamp": "00:56:18", "text": "对，你没事。别担心。在"}, {"type": "subtitle", "time": 3380.23, "timestamp": "00:56:20", "text": "哪儿？什么？"}, {"type": "subtitle", "time": 3383.91, "timestamp": "00:56:23", "text": "不，算了。"}, {"type": "subtitle", "time": 3386.15, "timestamp": "00:56:26", "text": "算了。我不是。我会上来的。"}, {"type": "subtitle", "time": 3387.829, "timestamp": "00:56:27", "text": "等等。对，你是。你是。不，不，"}, {"type": "subtitle", "time": 3391.43, "timestamp": "00:56:31", "text": "不，不，不，不。对不起。"}, {"type": "subtitle", "time": 3393.75, "timestamp": "00:56:33", "text": "我应该被加到背景故事里。"}, {"type": "subtitle", "time": 3394.069, "timestamp": "00:56:34", "text": "是的。"}, {"type": "subtitle", "time": 3397.67, "timestamp": "00:56:37", "text": "不，我应该被加到背景故事里。"}, {"type": "subtitle", "time": 3399.75, "timestamp": "00:56:39", "text": "现在说起来，我还要继续完善背景"}, {"type": "subtitle", "time": 3402.71, "timestamp": "00:56:42", "text": "故事。不。"}, {"type": "subtitle", "time": 3406.789, "timestamp": "00:56:46", "text": "什么意思？我的面包？我的意思是"}, {"type": "subtitle", "time": 3409.99, "timestamp": "00:56:49", "text": "你应该。"}, {"type": "subtitle", "time": 3412.549, "timestamp": "00:56:52", "text": "我应该。是的。是的"}, {"type": "subtitle", "time": 3416.549, "timestamp": "00:56:56", "text": "。是的。祝你一切顺利 嗯，该怎么"}, {"type": "subtitle", "time": 3419.51, "timestamp": "00:56:59", "text": "称呼它呢？文学技巧。"}]
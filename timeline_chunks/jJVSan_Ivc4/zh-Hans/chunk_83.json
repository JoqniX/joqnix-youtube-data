[{"type": "subtitle", "time": 4981.59, "timestamp": "01:23:01", "text": "而且，明明"}, {"type": "subtitle", "time": 4984.07, "timestamp": "01:23:04", "text": "有人在帖子里帮我，我却故意"}, {"type": "subtitle", "time": 4991.35, "timestamp": "01:23:11", "text": "用复杂的语言把问题描述得一团糟，让帮我的人"}, {"type": "subtitle", "time": 4996.39, "timestamp": "01:23:16", "text": "不得不反复阅读好"}, {"type": "subtitle", "time": 4999.59, "timestamp": "01:23:19", "text": "几遍才能"}, {"type": "subtitle", "time": 5002.629, "timestamp": "01:23:22", "text": "明白我到底想要什么。"}, {"type": "subtitle", "time": 5005.27, "timestamp": "01:23:25", "text": "他们本来是想根据我"}, {"type": "subtitle", "time": 5008.629, "timestamp": "01:23:28", "text": "最初的问题，也就是"}, {"type": "subtitle", "time": 5011.83, "timestamp": "01:23:31", "text": "我尝试做的事情，来帮我解决问题的。总而言之，"}, {"type": "subtitle", "time": 5014.47, "timestamp": "01:23:34", "text": "当我…… 我一边试图自己解决问题，"}, {"type": "subtitle", "time": 5018.31, "timestamp": "01:23:38", "text": "一边寻求帮助和指导，结果却"}, {"type": "subtitle", "time": 5023.75, "timestamp": "01:23:43", "text": "走上了另一条复杂的道路，"}, {"type": "subtitle", "time": 5026.229, "timestamp": "01:23:46", "text": "把帮我的人又"}, {"type": "subtitle", "time": 5028.31, "timestamp": "01:23:48", "text": "搞糊涂了。"}, {"type": "subtitle", "time": 5031.35, "timestamp": "01:23:51", "text": "今天就是这样。"}, {"type": "subtitle", "time": 5033.43, "timestamp": "01:23:53", "text": "天哪，你每天都这样吗"}]
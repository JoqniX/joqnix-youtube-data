[{"type": "subtitle", "time": 2460.47, "timestamp": "00:41:00", "text": "这事儿持续了一个星期。现在又"}, {"type": "subtitle", "time": 2466.95, "timestamp": "00:41:06", "text": "啊。现在又平静下来了。是啊。"}, {"type": "subtitle", "time": 2468.55, "timestamp": "00:41:08", "text": "是"}, {"type": "subtitle", "time": 2471.109, "timestamp": "00:41:11", "text": "啊。我在想那些主播们在干嘛，"}, {"type": "subtitle", "time": 2473.589, "timestamp": "00:41:13", "text": "因为V战队的那些"}, {"type": "subtitle", "time": 2476.069, "timestamp": "00:41:16", "text": "主播是谁来着？比如，"}, {"type": "subtitle", "time": 2479.349, "timestamp": "00:41:19", "text": "呃，Iron M Kuro，"}, {"type": "subtitle", "time": 2481.829, "timestamp": "00:41:21", "text": "呃，Matakan，"}, {"type": "subtitle", "time": 2485.19, "timestamp": "00:41:25", "text": "呃，Queson，然后"}, {"type": "subtitle", "time": 2486.79, "timestamp": "00:41:26", "text": "我想Queson退出了。"}, {"type": "subtitle", "time": 2489.829, "timestamp": "00:41:29", "text": "是啊，Queson在直播中"}, {"type": "subtitle", "time": 2492.95, "timestamp": "00:41:32", "text": "和日本"}, {"type": "subtitle", "time": 2497.67, "timestamp": "00:41:37", "text": "CEO聊完之后就退出了。是啊。是啊，"}, {"type": "subtitle", "time": 2501.51, "timestamp": "00:41:41", "text": "那段视频挺有意思的。是啊，太狠了。挺有意思的。"}, {"type": "subtitle", "time": 2504.309, "timestamp": "00:41:44", "text": "我就想，我该"}, {"type": "subtitle", "time": 2507.829, "timestamp": "00:41:47", "text": "退出吗？我该退出吗？因为他们在"}, {"type": "subtitle", "time": 2509.43, "timestamp": "00:41:49", "text": "视频里加了配音，你知道，"}, {"type": "subtitle", "time": 2511.75, "timestamp": "00:41:51", "text": "我该退出吗？我就想，这太搞笑了。"}, {"type": "subtitle", "time": 2513.829, "timestamp": "00:41:53", "text": "我本来以为这是个笑话。我以为这是个"}, {"type": "subtitle", "time": 2516.23, "timestamp": "00:41:56", "text": "喜剧桥段。就像，她"}, {"type": "subtitle", "time": 2517.829, "timestamp": "00:41:57", "text": "只是在开玩笑。我就想，不， 这事儿挺"}]
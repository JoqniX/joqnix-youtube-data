[{"type": "subtitle", "time": 2760.47, "timestamp": "00:46:00", "text": "因为现在"}, {"type": "subtitle", "time": 2765.99, "timestamp": "00:46:05", "text": "我只想说，我想，我想，我……那是"}, {"type": "subtitle", "time": 2767.589, "timestamp": "00:46:07", "text": "什么来着？该死，我总是忘记"}, {"type": "subtitle", "time": 2769.51, "timestamp": "00:46:09", "text": "它的名字。它"}, {"type": "subtitle", "time": 2771.589, "timestamp": "00:46:11", "text": "叫什么来着？"}, {"type": "subtitle", "time": 2773.43, "timestamp": "00:46:13", "text": "我觉得我现在就像是在卖"}, {"type": "subtitle", "time": 2775.19, "timestamp": "00:46:15", "text": "传单。不是那种为了"}, {"type": "subtitle", "time": 2778.069, "timestamp": "00:46:18", "text": "某个"}, {"type": "subtitle", "time": 2780.069, "timestamp": "00:46:20", "text": "机构之类的而卖传单。"}, {"type": "subtitle", "time": 2782.79, "timestamp": "00:46:22", "text": "我也不知道为什么，但我就是在做。我"}, {"type": "subtitle", "time": 2785.19, "timestamp": "00:46:25", "text": "不需要钱。我做这件事只是"}, {"type": "subtitle", "time": 2792.39, "timestamp": "00:46:32", "text": "还帮我那该死的邻居"}, {"type": "subtitle", "time": 2795.03, "timestamp": "00:46:35", "text": "做些其他事。"}, {"type": "subtitle", "time": 2797.19, "timestamp": "00:46:37", "text": "基本上就是这样。我只是想"}, {"type": "subtitle", "time": 2802.79, "timestamp": "00:46:42", "text": "在我的"}, {"type": "subtitle", "time": 2811.829, "timestamp": "00:46:51", "text": "我的情况。"}, {"type": "subtitle", "time": 2813.27, "timestamp": "00:46:53", "text": "操。"}, {"type": "subtitle", "time": 2815.27, "timestamp": "00:46:55", "text": "但我心里还是觉得这"}, {"type": "subtitle", "time": 2819.03, "timestamp": "00:46:59", "text": "不够。我"}]
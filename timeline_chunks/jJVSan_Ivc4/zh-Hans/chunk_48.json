[{"type": "subtitle", "time": 2881.51, "timestamp": "00:48:01", "text": "我就在努力想象。他们"}, {"type": "subtitle", "time": 2884.79, "timestamp": "00:48:04", "text": "说得那么快，我"}, {"type": "subtitle", "time": 2887.829, "timestamp": "00:48:07", "text": "脑子里就像在放幻灯片一样。"}, {"type": "subtitle", "time": 2888.71, "timestamp": "00:48:08", "text": "对。"}, {"type": "subtitle", "time": 2891.43, "timestamp": "00:48:11", "text": "就像一个幻灯片，哦，对。一个小"}, {"type": "subtitle", "time": 2894.15, "timestamp": "00:48:14", "text": "家伙到处走来走去"}, {"type": "subtitle", "time": 2897.75, "timestamp": "00:48:17", "text": "卖药片。哦，对。小"}, {"type": "subtitle", "time": 2899.829, "timestamp": "00:48:19", "text": "坏蛋。"}, {"type": "subtitle", "time": 2901.349, "timestamp": "00:48:21", "text": "你他妈的，你真是个"}, {"type": "subtitle", "time": 2905.109, "timestamp": "00:48:25", "text": "坏蛋。拜托。对。拜托，兄弟。"}, {"type": "subtitle", "time": 2906.95, "timestamp": "00:48:26", "text": "你的兄弟就在这儿。他"}, {"type": "subtitle", "time": 2909.51, "timestamp": "00:48:29", "text": "现在正在表达他的感受，而你却把"}, {"type": "subtitle", "time": 2912.39, "timestamp": "00:48:32", "text": "他想象"}, {"type": "subtitle", "time": 2914.47, "timestamp": "00:48:34", "text": "成一个火柴人。"}, {"type": "subtitle", "time": 2916.95, "timestamp": "00:48:36", "text": "甚至在你脑子里，他都不是一个人，而是一个"}, {"type": "subtitle", "time": 2924.069, "timestamp": "00:48:44", "text": "你还在走神吗？就像我的"}, {"type": "subtitle", "time": 2926.39, "timestamp": "00:48:46", "text": "兄弟当时完全走神了一样。 那一刻。"}, {"type": "subtitle", "time": 2929.43, "timestamp": "00:48:49", "text": "我当时在想那个火柴人。我的天哪。"}, {"type": "subtitle", "time": 2932.549, "timestamp": "00:48:52", "text": "你知道，我觉得我……我觉得我已经"}, {"type": "subtitle", "time": 2934.79, "timestamp": "00:48:54", "text": "说够多了。"}, {"type": "subtitle", "time": 2936.309, "timestamp": "00:48:56", "text": "谢谢你，乔布。"}]
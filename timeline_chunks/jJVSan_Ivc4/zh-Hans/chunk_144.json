[{"type": "subtitle", "time": 8642.23, "timestamp": "02:24:02", "text": "认为你赢得它的几率会增加大约 12%"}, {"type": "subtitle", "time": 8645.67, "timestamp": "02:24:05", "text": "。 所以，大概是36之类的"}, {"type": "subtitle", "time": 8652.55, "timestamp": "02:24:12", "text": "好的。 我见过很多人"}, {"type": "subtitle", "time": 8654.55, "timestamp": "02:24:14", "text": "在那张横幅广告上输掉两次 50/50 的抽奖。 好的。 我可不是在"}, {"type": "subtitle", "time": 8657.99, "timestamp": "02:24:17", "text": "开玩笑。 在他们进行的 200 次民意调查中，直到第 160 次"}, {"type": "subtitle", "time": 8660.469, "timestamp": "02:24:20", "text": "，他们都"}, {"type": "subtitle", "time": 8663.59, "timestamp": "02:24:23", "text": "没有得到一把佩剑。"}, {"type": "subtitle", "time": 8666.95, "timestamp": "02:24:26", "text": "我一直听到的都是这样，"}, {"type": "subtitle", "time": 8674.95, "timestamp": "02:24:34", "text": "我简直气疯了。 我当时气疯了。 我成功得到了"}, {"type": "subtitle", "time": 8678.07, "timestamp": "02:24:38", "text": "她和莱特币。 好的。"}, {"type": "subtitle", "time": 8681.67, "timestamp": "02:24:41", "text": "什么？ 还有莱库恩。 什么？"}, {"type": "subtitle", "time": 8686.389, "timestamp": "02:24:46", "text": "好的。 是的，我很幸运，点赞的人很多。"}, {"type": "subtitle", "time": 8689.19, "timestamp": "02:24:49", "text": "等等，如果你抽卡的话，还能"}, {"type": "subtitle", "time": 8691.99, "timestamp": "02:24:51", "text": "获得金币呢。"}]
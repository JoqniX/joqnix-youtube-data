[{"type": "subtitle", "time": 3060.87, "timestamp": "00:51:00", "text": "啊。"}, {"type": "subtitle", "time": 3062.71, "timestamp": "00:51:02", "text": "不，继续。别说了。"}, {"type": "subtitle", "time": 3065.51, "timestamp": "00:51:05", "text": "我当时就想，呃，我还看过那个"}, {"type": "subtitle", "time": 3067.91, "timestamp": "00:51:07", "text": "纪录片的视频。还没看完"}, {"type": "subtitle", "time": 3070.39, "timestamp": "00:51:10", "text": "。之前看了"}, {"type": "subtitle", "time": 3072.87, "timestamp": "00:51:12", "text": "十分钟就睡着了。大概是凌晨三点左右吧。"}, {"type": "subtitle", "time": 3077.03, "timestamp": "00:51:17", "text": "嗯，不过，我"}, {"type": "subtitle", "time": 3080.87, "timestamp": "00:51:20", "text": "得看看。它讲的是它是怎么创作出"}, {"type": "subtitle", "time": 3083.349, "timestamp": "00:51:23", "text": "那么多东西的。"}, {"type": "subtitle", "time": 3085.27, "timestamp": "00:51:25", "text": "赛马的历史，或者说是穆斯林的历史，"}, {"type": "subtitle", "time": 3088.63, "timestamp": "00:51:28", "text": "它是怎么诞生的，"}, {"type": "subtitle", "time": 3089.43, "timestamp": "00:51:29", "text": "等等等等。"}, {"type": "subtitle", "time": 3091.91, "timestamp": "00:51:31", "text": "好的。好的。好的。"}, {"type": "subtitle", "time": 3093.91, "timestamp": "00:51:33", "text": "哦，好的。问你，你看过"}, {"type": "subtitle", "time": 3095.27, "timestamp": "00:51:35", "text": "动画吗？"}, {"type": "subtitle", "time": 3097.43, "timestamp": "00:51:37", "text": "没有，"}, {"type": "subtitle", "time": 3098.87, "timestamp": "00:51:38", "text": "还没看过。"}, {"type": "subtitle", "time": 3100.63, "timestamp": "00:51:40", "text": "你知道的。 什么？"}, {"type": "subtitle", "time": 3104.309, "timestamp": "00:51:44", "text": "作为一个看过《赛玛少女》动画"}, {"type": "subtitle", "time": 3107.19, "timestamp": "00:51:47", "text": "也玩过游戏的人，我建议"}, {"type": "subtitle", "time": 3110.23, "timestamp": "00:51:50", "text": "你先看动画。"}, {"type": "subtitle", "time": 3112.15, "timestamp": "00:51:52", "text": "哦，"}, {"type": "subtitle", "time": 3114.549, "timestamp": "00:51:54", "text": "对。因为如果你直接玩"}, {"type": "subtitle", "time": 3116.309, "timestamp": "00:51:56", "text": "游戏，"}, {"type": "subtitle", "time": 3117.67, "timestamp": "00:51:57", "text": "呃，你根本不认识角色，"}, {"type": "subtitle", "time": 3119.19, "timestamp": "00:51:59", "text": "你知道吗？你根本不知道"}]
[{"type": "subtitle", "time": 9241.67, "timestamp": "02:34:01", "text": "我刚才在跟这个人说话，"}, {"type": "subtitle", "time": 9243.99, "timestamp": "02:34:03", "text": "你知道，我大概"}, {"type": "subtitle", "time": 9246.23, "timestamp": "02:34:06", "text": "30分钟前在跟这个人说话，我们当时在"}, {"type": "subtitle", "time": 9247.91, "timestamp": "02:34:07", "text": "聊天，我告诉他我在"}, {"type": "subtitle", "time": 9250.07, "timestamp": "02:34:10", "text": "工作什么的，然后"}, {"type": "subtitle", "time": 9252.55, "timestamp": "02:34:12", "text": "我听到他特别安静。我就问，"}, {"type": "subtitle", "time": 9254.309, "timestamp": "02:34:14", "text": "乔克，你在吗？我说，哦，在，嘿，嘿，"}, {"type": "subtitle", "time": 9255.429, "timestamp": "02:34:15", "text": "嘿，我在。"}, {"type": "subtitle", "time": 9257.91, "timestamp": "02:34:17", "text": "你们刚才在聊什么？然后他就"}, {"type": "subtitle", "time": 9259.83, "timestamp": "02:34:19", "text": "对我说，“哦，对，我"}, {"type": "subtitle", "time": 9262.309, "timestamp": "02:34:22", "text": "刚才在想象你像个面包，"}, {"type": "subtitle", "time": 9268.15, "timestamp": "02:34:28", "text": "什么？   “"}, {"type": "subtitle", "time": 9270.79, "timestamp": "02:34:30", "text": "面包王国。”"}, {"type": "subtitle", "time": 9272.71, "timestamp": "02:34:32", "text": "他，是啊，他刚才说的是，"}, {"type": "subtitle", "time": 9274.71, "timestamp": "02:34:34", "text": "“哦，对，你，你刚才，我刚才把"}, {"type": "subtitle", "time": 9276.55, "timestamp": "02:34:36", "text": "你想象成一块面包，卖"}, {"type": "subtitle", "time": 9279.429, "timestamp": "02:34:39", "text": "面包给面包人。”"}, {"type": "subtitle", "time": 9285.51, "timestamp": "02:34:45", "text": "你在说什么？他们不知"}, {"type": "subtitle", "time": 9292.87, "timestamp": "02:34:52", "text": "他活在另一个世界里。我的"}, {"type": "subtitle", "time": 9295.67, "timestamp": "02:34:55", "text": "天哪。"}]
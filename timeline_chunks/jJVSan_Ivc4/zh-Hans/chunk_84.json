[{"type": "subtitle", "time": 5041.91, "timestamp": "01:24:01", "text": "复杂，就毁了别人的一天。真是个笑话。"}, {"type": "subtitle", "time": 5045.35, "timestamp": "01:24:05", "text": "我的天哪，我就是这么说的。"}, {"type": "subtitle", "time": 5047.27, "timestamp": "01:24:07", "text": "我的天哪。"}, {"type": "subtitle", "time": 5049.99, "timestamp": "01:24:09", "text": "我妈就发了个帖子，"}, {"type": "subtitle", "time": 5052.07, "timestamp": "01:24:12", "text": "有人想帮他，结果他反而把事情搞得更复杂，把别人的"}, {"type": "subtitle", "time": 5055.03, "timestamp": "01:24:15", "text": "一天都毁了。"}, {"type": "subtitle", "time": 5060.47, "timestamp": "01:24:20", "text": "那个人明明是真心"}, {"type": "subtitle", "time": 5063.43, "timestamp": "01:24:23", "text": "想帮忙，结果现在自己也糊涂了，"}, {"type": "subtitle", "time": 5065.35, "timestamp": "01:24:25", "text": "你们俩都在等"}, {"type": "subtitle", "time": 5071.59, "timestamp": "01:24:31", "text": "不过，我觉得这"}, {"type": "subtitle", "time": 5074.79, "timestamp": "01:24:34", "text": "很正常。确实"}, {"type": "subtitle", "time": 5087.99, "timestamp": "01:24:47", "text": "我总是这样。我注意到了。"}, {"type": "subtitle", "time": 5091.669, "timestamp": "01:24:51", "text": "我一直都注意到了。"}]
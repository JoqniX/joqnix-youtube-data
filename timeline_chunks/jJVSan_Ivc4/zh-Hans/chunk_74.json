[{"type": "subtitle", "time": 4440.149, "timestamp": "01:14:00", "text": "我想让你做那种东西”，你"}, {"type": "subtitle", "time": 4441.43, "timestamp": "01:14:01", "text": "知道吗？"}, {"type": "subtitle", "time": 4443.35, "timestamp": "01:14:03", "text": "哦，我的天哪，你男朋友掉进"}, {"type": "subtitle", "time": 4446.149, "timestamp": "01:14:06", "text": "山沟里。ASMR。你见过那种"}, {"type": "subtitle", "time": 4446.39, "timestamp": "01:14:06", "text": "东西吗？"}, {"type": "subtitle", "time": 4448.31, "timestamp": "01:14:08", "text": "哦，我的天哪。第一人称"}, {"type": "subtitle", "time": 4450.39, "timestamp": "01:14:10", "text": "视角。你女朋友"}, {"type": "subtitle", "time": 4453.11, "timestamp": "01:14:13", "text": "因为该死的"}, {"type": "subtitle", "time": 4456.63, "timestamp": "01:14:16", "text": "油，该死的热油之"}, {"type": "subtitle", "time": 4460.149, "timestamp": "01:14:20", "text": "类的东西，被烫伤了，然后那个人就"}, {"type": "subtitle", "time": 4462.79, "timestamp": "01:14:22", "text": "尖叫，我就想，哦，天哪，这太有"}, {"type": "subtitle", "time": 4472.229, "timestamp": "01:14:32", "text": "就像你以第一人称视角听着"}, {"type": "subtitle", "time": 4475.75, "timestamp": "01:14:35", "text": "坎耶·韦斯特的歌，然后突然就崩溃了，"}, {"type": "subtitle", "time": 4477.91, "timestamp": "01:14:37", "text": "就像那种感觉，哇哦"}, {"type": "subtitle", "time": 4480.39, "timestamp": "01:14:40", "text": "，这太"}, {"type": "subtitle", "time": 4483.03, "timestamp": "01:14:43", "text": "酷了。哦，我收到快递了。稍等"}, {"type": "subtitle", "time": 4492.07, "timestamp": "01:14:52", "text": "[音乐]"}, {"type": "subtitle", "time": 4498.47, "timestamp": "01:14:58", "text": "我应该多做一些情景式的ASMR。是"}]
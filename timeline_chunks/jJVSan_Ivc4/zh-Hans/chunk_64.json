[{"type": "subtitle", "time": 3841.99, "timestamp": "01:04:01", "text": "哦，对。你还没跟那帮"}, {"type": "subtitle", "time": 3843.91, "timestamp": "01:04:03", "text": "人说过话。呃，对。"}, {"type": "subtitle", "time": 3845.75, "timestamp": "01:04:05", "text": "没有，我没有。对。"}, {"type": "subtitle", "time": 3849.27, "timestamp": "01:04:09", "text": "我想你 还没。嗯，没关系。"}, {"type": "subtitle", "time": 3850.47, "timestamp": "01:04:10", "text": "很好。"}, {"type": "subtitle", "time": 3852.069, "timestamp": "01:04:12", "text": "蠢货"}, {"type": "subtitle", "time": 3859.43, "timestamp": "01:04:19", "text": "我的天啊。我只是想看看"}, {"type": "subtitle", "time": 3867.27, "timestamp": "01:04:27", "text": "你好之类的，对吧？我甚至都"}, {"type": "subtitle", "time": 3869.91, "timestamp": "01:04:29", "text": "看不到你说那句话的"}, {"type": "subtitle", "time": 3880.23, "timestamp": "01:04:40", "text": "我的天啊。"}, {"type": "subtitle", "time": 3881.67, "timestamp": "01:04:41", "text": "回到我们的直播间，你知道的。回到"}, {"type": "subtitle", "time": 3884.87, "timestamp": "01:04:44", "text": "我们的直播间。我们还是"}, {"type": "subtitle", "time": 3886.39, "timestamp": "01:04:46", "text": "回到“你为什么露面？你"}, {"type": "subtitle", "time": 3889.27, "timestamp": "01:04:49", "text": "真的要加入直播间吗？”这个问题吧。"}, {"type": "subtitle", "time": 3891.27, "timestamp": "01:04:51", "text": "这不太好，伙计。未经"}, {"type": "subtitle", "time": 3893.75, "timestamp": "01:04:53", "text": "允许。这不太好。"}, {"type": "subtitle", "time": 3896.549, "timestamp": "01:04:56", "text": "等等。等等。我找不到别人的"}, {"type": "subtitle", "time": 3898.549, "timestamp": "01:04:58", "text": "直播间。"}, {"type": "subtitle", "time": 3899.349, "timestamp": "01:04:59", "text": "这是怎么回事？是啊"}]
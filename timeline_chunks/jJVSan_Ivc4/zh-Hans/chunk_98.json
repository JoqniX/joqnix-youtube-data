[{"type": "subtitle", "time": 5881.75, "timestamp": "01:38:01", "text": "你看过《大步行》吗？"}, {"type": "subtitle", "time": 5883.03, "timestamp": "01:38:03", "text": "长途跋涉？ 那是什么？"}, {"type": "subtitle", "time": 5885.51, "timestamp": "01:38:05", "text": "这就是我想和你一起玩的游戏。"}, {"type": "subtitle", "time": 5886.629, "timestamp": "01:38:06", "text": "哦，"}, {"type": "subtitle", "time": 5888.629, "timestamp": "01:38:08", "text": "德斯蒂。"}, {"type": "subtitle", "time": 5893.99, "timestamp": "01:38:13", "text": "哦，是的"}, {"type": "subtitle", "time": 5896.79, "timestamp": "01:38:16", "text": "。 还有，就像你"}, {"type": "subtitle", "time": 5898.31, "timestamp": "01:38:18", "text": "说的，"}, {"type": "subtitle", "time": 5899.99, "timestamp": "01:38:19", "text": "呃，马拉松。 也想玩"}, {"type": "subtitle", "time": 5902.55, "timestamp": "01:38:22", "text": "马拉松。 我还想玩另一款"}, {"type": "subtitle", "time": 5906.149, "timestamp": "01:38:26", "text": "游戏。 它叫什么名字？ 我觉得是"}, {"type": "subtitle", "time": 5909.27, "timestamp": "01:38:29", "text": "Shroud在演奏这首歌。"}, {"type": "subtitle", "time": 5912.39, "timestamp": "01:38:32", "text": "我想玩《命运》。 我长得像"}, {"type": "subtitle", "time": 5919.109, "timestamp": "01:38:39", "text": "我的天啊。"}, {"type": "subtitle", "time": 5922.0, "timestamp": "01:38:42", "text": "真他妈讨厌那游戏。"}, {"type": "subtitle", "time": 5938.07, "timestamp": "01:38:58", "text": "最近我没怎么玩到最新的游戏。"}]
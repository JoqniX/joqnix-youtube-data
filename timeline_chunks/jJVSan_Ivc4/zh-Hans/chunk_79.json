[{"type": "subtitle", "time": 4754.07, "timestamp": "01:19:14", "text": "我本来应该去参加唱歌"}, {"type": "subtitle", "time": 4755.83, "timestamp": "01:19:15", "text": "练习，"}, {"type": "subtitle", "time": 4758.229, "timestamp": "01:19:18", "text": "但我没办法改期到"}, {"type": "subtitle", "time": 4760.95, "timestamp": "01:19:20", "text": "明天。"}, {"type": "subtitle", "time": 4764.87, "timestamp": "01:19:24", "text": "然后我做了一些 我建了一些帖子和一些"}, {"type": "subtitle", "time": 4767.35, "timestamp": "01:19:27", "text": "支持服务器，用来解决我"}, {"type": "subtitle", "time": 4769.91, "timestamp": "01:19:29", "text": "和梅尔"}, {"type": "subtitle", "time": 4772.31, "timestamp": "01:19:32", "text": "还有萨米之间的问题。"}, {"type": "subtitle", "time": 4776.229, "timestamp": "01:19:36", "text": "所以我花了一段时间研究这些"}, {"type": "subtitle", "time": 4777.99, "timestamp": "01:19:37", "text": "事，真是太"}, {"type": "subtitle", "time": 4787.99, "timestamp": "01:19:47", "text": "痛苦了。"}, {"type": "subtitle", "time": 4790.87, "timestamp": "01:19:50", "text": "我注意到我总是把"}, {"type": "subtitle", "time": 4793.35, "timestamp": "01:19:53", "text": "事情想得太复杂，真是疯了，就连一些"}]
[{"type": "subtitle", "time": 2101.19, "timestamp": "00:35:01", "text": "。我当时特别安静。我想玩"}, {"type": "subtitle", "time": 2103.349, "timestamp": "00:35:03", "text": "D"}, {"type": "subtitle", "time": 2106.79, "timestamp": "00:35:06", "text": "&D的原因是想多玩角色扮演，想即兴发挥，"}, {"type": "subtitle", "time": 2112.95, "timestamp": "00:35:12", "text": "尝试适应不同的"}, {"type": "subtitle", "time": 2116.71, "timestamp": "00:35:16", "text": "情况，编故事什么的。"}, {"type": "subtitle", "time": 2119.349, "timestamp": "00:35:19", "text": "第一天很难。确实很难，"}, {"type": "subtitle", "time": 2122.71, "timestamp": "00:35:22", "text": "但我尽力了，因为我"}, {"type": "subtitle", "time": 2125.27, "timestamp": "00:35:25", "text": "发现整个"}, {"type": "subtitle", "time": 2129.51, "timestamp": "00:35:29", "text": "团队，整个战役里，只有我一个人用自己的"}, {"type": "subtitle", "time": 2132.47, "timestamp": "00:35:32", "text": "名字，Jockn。其他人都用了"}, {"type": "subtitle", "time": 2135.91, "timestamp": "00:35:35", "text": "自己的角色名。"}, {"type": "subtitle", "time": 2139.67, "timestamp": "00:35:39", "text": "我就想，我要用Jockn。"}, {"type": "subtitle", "time": 2143.91, "timestamp": "00:35:43", "text": "对，我就想，我要用Jocknik。"}, {"type": "subtitle", "time": 2144.71, "timestamp": "00:35:44", "text": "等等，我死了。"}, {"type": "subtitle", "time": 2147.109, "timestamp": "00:35:47", "text": "哦，是啊。不，不，不。我想是"}, {"type": "subtitle", "time": 2148.63, "timestamp": "00:35:48", "text": "我。再见。别这样 担心。"}, {"type": "subtitle", "time": 2150.069, "timestamp": "00:35:50", "text": "什么？"}, {"type": "subtitle", "time": 2151.829, "timestamp": "00:35:51", "text": "不不不。我有点卡顿，所以"}, {"type": "subtitle", "time": 2154.069, "timestamp": "00:35:54", "text": "以为你要跟我玩。"}, {"type": "subtitle", "time": 2159.99, "timestamp": "00:35:59", "text": "。总之，是的。是的，我看到了。"}]
[{"type": "subtitle", "time": 9123.59, "timestamp": "02:32:03", "text": "意思是，一季12集"}, {"type": "subtitle", "time": 9127.27, "timestamp": "02:32:07", "text": "就要5个小时。我刚开始看"}, {"type": "subtitle", "time": 9129.349, "timestamp": "02:32:09", "text": "两部。"}, {"type": "subtitle", "time": 9135.27, "timestamp": "02:32:15", "text": "我觉得我不应该这么说，"}, {"type": "subtitle", "time": 9137.27, "timestamp": "02:32:17", "text": "哦，你连续看13个小时的动漫"}, {"type": "subtitle", "time": 9139.51, "timestamp": "02:32:19", "text": "？太尴尬了。我"}, {"type": "subtitle", "time": 9145.03, "timestamp": "02:32:25", "text": "去看超人电影的时候，就浪费了6个小时"}, {"type": "subtitle", "time": 9147.27, "timestamp": "02:32:27", "text": "。"}, {"type": "subtitle", "time": 9148.71, "timestamp": "02:32:28", "text": "哇。是"}, {"type": "subtitle", "time": 9149.429, "timestamp": "02:32:29", "text": "啊。"}, {"type": "subtitle", "time": 9152.95, "timestamp": "02:32:32", "text": "哦，就一部电影，6个小时。"}, {"type": "subtitle", "time": 9154.95, "timestamp": "02:32:34", "text": "不不不不。就开车"}, {"type": "subtitle", "time": 9158.87, "timestamp": "02:32:38", "text": "去，等，所有的一切，你知道的，"}, {"type": "subtitle", "time": 9161.11, "timestamp": "02:32:41", "text": "所有的一切。然后开车回来，你"}, {"type": "subtitle", "time": 9163.75, "timestamp": "02:32:43", "text": "知道，就花了6个小时。"}, {"type": "subtitle", "time": 9165.59, "timestamp": "02:32:45", "text": "明白了。"}, {"type": "subtitle", "time": 9167.91, "timestamp": "02:32:47", "text": "至少你看得开心，对吧？"}, {"type": "subtitle", "time": 9176.309, "timestamp": "02:32:56", "text": "我那天感觉自己像变了一个人。不"}]
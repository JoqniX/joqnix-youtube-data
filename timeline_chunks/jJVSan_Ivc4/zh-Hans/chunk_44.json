[{"type": "subtitle", "time": 2640.069, "timestamp": "00:44:00", "text": "。"}, {"type": "subtitle", "time": 2643.99, "timestamp": "00:44:03", "text": "嗯。"}, {"type": "subtitle", "time": 2647.589, "timestamp": "00:44:07", "text": "基本上就是这些了。"}, {"type": "subtitle", "time": 2650.15, "timestamp": "00:44:10", "text": "我觉得，当我把这些写"}, {"type": "subtitle", "time": 2652.55, "timestamp": "00:44:12", "text": "在书里的时候，听起来真是无聊透顶"}, {"type": "subtitle", "time": 2655.27, "timestamp": "00:44:15", "text": "。我感觉自己什么都没做。"}, {"type": "subtitle", "time": 2661.67, "timestamp": "00:44:21", "text": "而且我现在正在"}, {"type": "subtitle", "time": 2665.109, "timestamp": "00:44:25", "text": "努力让自己多做点什么。"}, {"type": "subtitle", "time": 2672.23, "timestamp": "00:44:32", "text": "你知道，就我个人而言，我现在还能做些什么，因为我觉得"}, {"type": "subtitle", "time": 2676.15, "timestamp": "00:44:36", "text": "我做得不够，"}, {"type": "subtitle", "time": 2679.27, "timestamp": "00:44:39", "text": "不够努力。"}, {"type": "subtitle", "time": 2684.23, "timestamp": "00:44:44", "text": "所以，大概"}, {"type": "subtitle", "time": 2688.069, "timestamp": "00:44:48", "text": "两天前，我申请了那种"}, {"type": "subtitle", "time": 2690.23, "timestamp": "00:44:50", "text": "救助狗狗的机构，就是那种去救助"}, {"type": "subtitle", "time": 2692.71, "timestamp": "00:44:52", "text": "小狗之类的。"}, {"type": "subtitle", "time": 2696.39, "timestamp": "00:44:56", "text": "我猜我申请过那个。所以，"}, {"type": "subtitle", "time": 2697.91, "timestamp": "00:44:57", "text": "我现在正在等他们的回复"}]
[{"type": "subtitle", "time": 3542.15, "timestamp": "00:59:02", "text": "是啊。"}, {"type": "subtitle", "time": 3548.15, "timestamp": "00:59:08", "text": "昨天大家居然没生我的气，我都觉得奇怪了，因为我当时特别安静，而且很"}, {"type": "subtitle", "time": 3550.789, "timestamp": "00:59:10", "text": "认真地听着，就是"}, {"type": "subtitle", "time": 3552.789, "timestamp": "00:59:12", "text": "不知道该干什么"}, {"type": "subtitle", "time": 3554.549, "timestamp": "00:59:14", "text": "。毕竟是"}, {"type": "subtitle", "time": 3556.23, "timestamp": "00:59:16", "text": "新手嘛。说实话，"}, {"type": "subtitle", "time": 3558.069, "timestamp": "00:59:18", "text": "你当时的表现就像个德鲁伊。"}, {"type": "subtitle", "time": 3560.309, "timestamp": "00:59:20", "text": "德鲁伊就是那样。"}, {"type": "subtitle", "time": 3563.109, "timestamp": "00:59:23", "text": "什么？"}, {"type": "subtitle", "time": 3575.43, "timestamp": "00:59:35", "text": "呃，古代天主教的宗教人物，"}, {"type": "subtitle", "time": 3578.87, "timestamp": "00:59:38", "text": "也是现代的特殊抗议者。嗯，祭司、"}, {"type": "subtitle", "time": 3581.349, "timestamp": "00:59:41", "text": "教师、封印者，在"}, {"type": "subtitle", "time": 3586.23, "timestamp": "00:59:46", "text": "当今的宗教、法律和社会生活中扮演着核心角色。现代"}, {"type": "subtitle", "time": 3589.109, "timestamp": "00:59:49", "text": "宗教中的高级"}, {"type": "subtitle", "time": 3596.87, "timestamp": "00:59:56", "text": "我的意思是，你只是在查"}, {"type": "subtitle", "time": 3599.19, "timestamp": "00:59:59", "text": "德鲁伊是什么吗？"}]
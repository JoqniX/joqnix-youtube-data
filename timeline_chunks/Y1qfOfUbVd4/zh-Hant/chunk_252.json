[{"type": "subtitle", "time": 15122.309, "timestamp": "04:12:02", "text": "[音樂] 啊，好球！ [掌聲]"}, {"type": "subtitle", "time": 15124.349, "timestamp": "04:12:04", "text": "等等，誰說你"}, {"type": "subtitle", "time": 15127.59, "timestamp": "04:12:07", "text": "不能滑行？我剛才看到有人滑鏟了。這遊戲裡怎麼滑鏟"}, {"type": "subtitle", "time": 15129.77, "timestamp": "04:12:09", "text": "？我們可以像玩Apex一樣玩。打擾一下。"}, {"type": "subtitle", "time": 15146.229, "timestamp": "04:12:26", "text": "什麼？  我要背後捅刀。嘿，這裡沒人。  什麼？哦，對不起。嚇了一跳。  那些吃墨西哥捲餅的人啊，不，我想要的是這些東西"}]
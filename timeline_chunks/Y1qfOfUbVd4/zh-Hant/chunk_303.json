[{"type": "subtitle", "time": 18185.868, "timestamp": "05:03:05", "text": "。是的"}, {"type": "subtitle", "time": 18190.55, "timestamp": "05:03:10", "text": "。"}, {"type": "subtitle", "time": 18194.23, "timestamp": "05:03:14", "text": "我為什麼要把它改成日文？"}, {"type": "subtitle", "time": 18215.19, "timestamp": "05:03:35", "text": "我正在學習日語。我想把所有東西都換成日文。是的，很遺憾"}, {"type": "subtitle", "time": 18217.35, "timestamp": "05:03:37", "text": "，事態正在升級。  啊，她騙到我了。今天是11月1日。  是的，今天是11月1日。所以，啊，我在上面玩得太嗨了。"}, {"type": "subtitle", "time": 18222.47, "timestamp": "05:03:42", "text": "沒關係。  我殺了他們。我不會瞄準。  好的。沒關係。但隨著時間的推移。哦，那玉米長得真不錯。  好的。"}]
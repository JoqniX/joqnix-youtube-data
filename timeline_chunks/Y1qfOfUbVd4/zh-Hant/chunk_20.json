[{"type": "subtitle", "time": 1203.47, "timestamp": "00:20:03", "text": "我從"}, {"type": "subtitle", "time": 1206.63, "timestamp": "00:20:06", "text": "高處摔了下來，受到了各種傷害。是的。是的。  是的。我的天哪。事情就是這樣。所以，就目前為止，"}, {"type": "subtitle", "time": 1215.15, "timestamp": "00:20:15", "text": "看了我的比賽之後，你們覺得這場比賽怎麼樣？"}, {"type": "subtitle", "time": 1231.789, "timestamp": "00:20:31", "text": "你怎麼認為？  你會玩嗎？問號（音樂）。  沒有。沒關係。就是"}, {"type": "subtitle", "time": 1242.35, "timestamp": "00:20:42", "text": "這樣。不用擔心。  我更想玩。不過"}]
[{"type": "subtitle", "time": 16217.67, "timestamp": "04:30:17", "text": "我看到有人了。那傢伙在幹嘛？  這是什麼？他到底想搞什麼花招？你看到了嗎？他想搞的"}, {"type": "subtitle", "time": 16226.349, "timestamp": "04:30:26", "text": "那個花樣表演到底是什麼？"}, {"type": "subtitle", "time": 16232.79, "timestamp": "04:30:32", "text": "感覺自己像個遊戲玩家。那傢伙覺得自己像個遊戲玩家。我該擔心嗎？  應該殺了他們。我這邊都能聽到。"}, {"type": "subtitle", "time": 16258.11, "timestamp": "04:30:58", "text": "我聽到"}]
[{"type": "subtitle", "time": 19346.23, "timestamp": "05:22:26", "text": "我沒有啟用作弊功能。"}, {"type": "subtitle", "time": 19349.11, "timestamp": "05:22:29", "text": "哦，沒關係。我沒有啟用作弊功能。"}, {"type": "subtitle", "time": 19356.47, "timestamp": "05:22:36", "text": "南達 n.這是令人目眩神迷的景象。不，呃，是那個警報機器人之類的東西。好的。不。是的。我忘了。沒關係。一次之後可以"}, {"type": "subtitle", "time": 19359.788, "timestamp": "05:22:39", "text": "重做。一輪。  我的天哪，"}, {"type": "subtitle", "time": 19364.628, "timestamp": "05:22:44", "text": "太好吃了。我的天哪，預告片太棒了！"}, {"type": "subtitle", "time": 19371.23, "timestamp": "05:22:51", "text": "這趟火車真棒。  好的。好的。  重製版。"}, {"type": "subtitle", "time": 19376.67, "timestamp": "05:22:56", "text": "我只是想得到"}, {"type": "subtitle", "time": 19379.67, "timestamp": "05:22:59", "text": "那個。"}]
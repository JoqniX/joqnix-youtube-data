[{"type": "subtitle", "time": 41883.67, "timestamp": "11:38:03", "text": "只有"}, {"type": "subtitle", "time": 41896.106, "timestamp": "11:38:16", "text": "我的 Twitch 聊天記錄，哈哈"}, {"type": "subtitle", "time": 41899.746, "timestamp": "11:38:19", "text": "。所以無論我執行什麼指令，做任何事情，都會被"}, {"type": "subtitle", "time": 41909.15, "timestamp": "11:38:29", "text": "錄到 Discord 頻道。 Discord頻道。這樣，萬一我需要回顧某人的評論，我可以回去"}, {"type": "subtitle", "time": 41916.87, "timestamp": "11:38:36", "text": "查看。是的，我可以做到"}, {"type": "subtitle", "time": 41919.106, "timestamp": "11:38:39", "text": "。  但"}, {"type": "subtitle", "time": 41924.586, "timestamp": "11:38:44", "text": "我當時在想，我現在擁有的就像是 YouTube 的 Yahoo 論壇，當你第一次輸入你的第一條評論時，你會得到一個「yahed」（Yahed 的諧音梗）。所以，你好，訊息會發送到我的 onx 帳戶，然後我就可以知道"}, {"type": "subtitle", "time": 41927.746, "timestamp": "11:38:47", "text": "聊天室裡有哪些人跟我說話，這樣我就可以記得在直播結束時點名提到你們。謝謝你們"}]
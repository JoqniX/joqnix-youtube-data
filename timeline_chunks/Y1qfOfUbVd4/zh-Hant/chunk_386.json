[{"type": "subtitle", "time": 23164.948, "timestamp": "06:26:04", "text": "笨蛋，它叫生命網絡，生命網絡，"}, {"type": "subtitle", "time": 23166.19, "timestamp": "06:26:06", "text": "它就像，"}, {"type": "subtitle", "time": 23170.548, "timestamp": "06:26:10", "text": "呃，就像，呃，你聽過"}, {"type": "subtitle", "time": 23173.83, "timestamp": "06:26:13", "text": "太空站13嗎？它有點像那樣，你"}, {"type": "subtitle", "time": 23177.27, "timestamp": "06:26:17", "text": "得打很多字，你得角色扮演，然後你"}, {"type": "subtitle", "time": 23180.11, "timestamp": "06:26:20", "text": "得在遊戲裡做那些動作之"}, {"type": "subtitle", "time": 23183.19, "timestamp": "06:26:23", "text": "類的，所以遊戲會在一個"}, {"type": "subtitle", "time": 23185.35, "timestamp": "06:26:25", "text": "屏幕上顯示，朋友們會在這裡，對吧。這裡將"}, {"type": "subtitle", "time": 23186.788, "timestamp": "06:26:26", "text": "是聊天"}, {"type": "subtitle", "time": 23189.83, "timestamp": "06:26:29", "text": "內容和所有東西的地方。是的。是的。這將是"}, {"type": "subtitle", "time": 23193.51, "timestamp": "06:26:33", "text": "我的……這將是我的……好東西，就像一個堅硬的東西。我還沒有習慣太空站，"}, {"type": "subtitle", "time": 23198.948, "timestamp": "06:26:38", "text": "但對於"}, {"type": "subtitle", "time": 23203.548, "timestamp": "06:26:43", "text": "現在對法律之類的東西感興趣的人來說，這是一個好地方。挺酷的"}, {"type": "subtitle", "time": 23206.548, "timestamp": "06:26:46", "text": "。顯然，這款遊戲"}]
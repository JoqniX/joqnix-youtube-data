[{"type": "subtitle", "time": 22981.47, "timestamp": "06:23:01", "text": "哦，"}, {"type": "subtitle", "time": 22983.75, "timestamp": "06:23:03", "text": "不錯。你還玩其他場地遊戲嗎"}, {"type": "subtitle", "time": 22986.948, "timestamp": "06:23:06", "text": "？是的，我各種類型的遊戲都會玩。  我"}, {"type": "subtitle", "time": 22989.03, "timestamp": "06:23:09", "text": "這邊幾乎沒有任何限制，"}, {"type": "subtitle", "time": 22993.67, "timestamp": "06:23:13", "text": "因為可以說我是個遊戲類型廣泛的玩家。更像是一個"}, {"type": "subtitle", "time": 22995.67, "timestamp": "06:23:15", "text": "綜合性串流平台。不要隨意"}, {"type": "subtitle", "time": 22997.83, "timestamp": "06:23:17", "text": "轉換題材。如果我今天玩FPS遊戲"}, {"type": "subtitle", "time": 23000.15, "timestamp": "06:23:20", "text": "，下次可能會玩手機遊戲，或是"}, {"type": "subtitle", "time": 23004.07, "timestamp": "06:23:24", "text": "RPG之類的遊戲，或是策略遊戲，"}]
[{"type": "subtitle", "time": 42030.55, "timestamp": "11:40:30", "text": "我停止聽我的串流音樂了。試試"}, {"type": "subtitle", "time": 42036.426, "timestamp": "11:40:36", "text": "。嗨，Gigo又上榜了。我騎著baka騎師。  您好，還有"}, {"type": "subtitle", "time": 42039.906, "timestamp": "11:40:39", "text": "Roku。你"}, {"type": "subtitle", "time": 42053.87, "timestamp": "11:40:53", "text": "好嗎，笨蛋"}]
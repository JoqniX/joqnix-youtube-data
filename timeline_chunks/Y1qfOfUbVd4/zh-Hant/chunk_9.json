[{"type": "subtitle", "time": 567.829, "timestamp": "00:09:27", "text": "祝你好運。先著陸然後送死。我睡著了。啊，沒關係。我 [掌聲]"}, {"type": "subtitle", "time": 579.269, "timestamp": "00:09:39", "text": "嘿，嘿，嘿。  我的天哪。聖哉上帝。"}, {"type": "subtitle", "time": 589.19, "timestamp": "00:09:49", "text": "什麼？你好呀。是的。你好，萊克斯。歡迎來到直播間。希望你一切都好。今天你是怎麼找到我的"}, {"type": "subtitle", "time": 591.59, "timestamp": "00:09:51", "text": "？你好嗎？晚安。哦，你得到了"}]
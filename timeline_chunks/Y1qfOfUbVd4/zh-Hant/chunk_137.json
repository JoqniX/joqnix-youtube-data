[{"type": "subtitle", "time": 8220.309, "timestamp": "02:17:00", "text": "顯示出來嗎"}, {"type": "subtitle", "time": 8222.79, "timestamp": "02:17:02", "text": "？等等，你能"}, {"type": "subtitle", "time": 8233.91, "timestamp": "02:17:13", "text": "雷達嗎？我懷疑你們能不能透過翻譯文字看到雷達圖，但是，是的，就是雷達圖，對吧"}, {"type": "subtitle", "time": 8239.589, "timestamp": "02:17:19", "text": "？你甚至看不到槍擊發生在哪裡。它只是顯示紅色，對吧？就像《要塞英雄》和《Apex英雄》。為什麼"}, {"type": "subtitle", "time": 8279.709, "timestamp": "02:17:59", "text": "槍沒響。槍沒響。我"}]
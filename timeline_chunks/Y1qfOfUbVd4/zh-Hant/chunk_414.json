[{"type": "subtitle", "time": 24858.23, "timestamp": "06:54:18", "text": "哦，我能找到比爾·克萊默（音樂）。帳單。"}, {"type": "subtitle", "time": 24860.83, "timestamp": "06:54:20", "text": "哦，"}, {"type": "subtitle", "time": 24863.35, "timestamp": "06:54:23", "text": "比爾。不是比利·克萊默。好的。比爾·"}, {"type": "subtitle", "time": 24866.07, "timestamp": "06:54:26", "text": "克萊默。其他人。呃，查爾斯羅蘭。"}]
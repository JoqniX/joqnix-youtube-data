[{"type": "subtitle", "time": 42724.87, "timestamp": "11:52:04", "text": "。  我不知道。讓我們來看看。讓我把"}, {"type": "subtitle", "time": 42727.106, "timestamp": "11:52:07", "text": "這些牛奶都喝光。我的天，太好吃了。  香草口味的牛奶真好喝。所以"}, {"type": "subtitle", "time": 42761.106, "timestamp": "11:52:41", "text": "我用的是蛋白"}, {"type": "subtitle", "time": 42762.746, "timestamp": "11:52:42", "text": "粉。天哪，我太弱了。虛弱，寶貝"}, {"type": "subtitle", "time": 42770.23, "timestamp": "11:52:50", "text": "我買了香草口味的無糖蛋白奶昔，還有蛋白牛奶。所以，是的，"}]
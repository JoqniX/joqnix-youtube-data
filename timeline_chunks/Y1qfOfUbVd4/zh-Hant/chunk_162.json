[{"type": "subtitle", "time": 9737.429, "timestamp": "02:42:17", "text": "我"}, {"type": "subtitle", "time": 9739.71, "timestamp": "02:42:19", "text": "去拿足球。我的天哪，這遊戲裡居然有真足球！  別再射"}, {"type": "subtitle", "time": 9758.03, "timestamp": "02:42:38", "text": "你了。這很有趣。  啊，比賽怎麼樣？它有點像恐怖片，但很有趣。我希望你能明白，我會盡力的。但我們贏得了第一場比賽。我贏了"}]
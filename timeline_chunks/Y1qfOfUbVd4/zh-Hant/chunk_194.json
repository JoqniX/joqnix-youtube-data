[{"type": "subtitle", "time": 11663.229, "timestamp": "03:14:23", "text": "我。什麼？搞什麼鬼？不可能。什麼？什麼？我沒法開槍。就像單點。我猜我技術太爛了。"}, {"type": "subtitle", "time": 11666.03, "timestamp": "03:14:26", "text": "哎。不過，我已經盡力了。就"}, {"type": "subtitle", "time": 11669.349, "timestamp": "03:14:29", "text": "這樣吧。"}, {"type": "subtitle", "time": 11684.55, "timestamp": "03:14:44", "text": "哎呀。我的天。我當時玩得可好了。呃，你覺得這遊戲的音效系統怎麼樣"}]
[{"type": "subtitle", "time": 37271.51, "timestamp": "10:21:11", "text": "嗯。你需要對《JOJO的奇妙冒險》有一定的了解，否則"}, {"type": "subtitle", "time": 37298.15, "timestamp": "10:21:38", "text": "很難"}, {"type": "subtitle", "time": 37299.95, "timestamp": "10:21:39", "text": "繼續看下去。所以，如果你看完了第一部，那麼第二部就會很好"}, {"type": "subtitle", "time": 37303.15, "timestamp": "10:21:43", "text": "看了。  哦，你好。  好的。所以，一共有多少季來著"}, {"type": "subtitle", "time": 37316.22, "timestamp": "10:21:56", "text": "？三季？三四個。所以，總共三個部分，對吧？"}]
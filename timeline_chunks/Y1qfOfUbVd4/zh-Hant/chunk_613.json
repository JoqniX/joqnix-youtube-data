[{"type": "subtitle", "time": 36788.55, "timestamp": "10:13:08", "text": "我就在這裡看著你放鬆"}, {"type": "subtitle", "time": 36791.23, "timestamp": "10:13:11", "text": "。你好。  你好。保重。"}, {"type": "subtitle", "time": 36793.746, "timestamp": "10:13:13", "text": "笨蛋，我希望你"}, {"type": "subtitle", "time": 36819.83, "timestamp": "10:13:39", "text": "康復，笨蛋。歡迎。希望你有在服用，因為對我來說服藥很重要。  是的。是的。  [音樂] 但是，"}, {"type": "subtitle", "time": 36822.15, "timestamp": "10:13:42", "text": "呃，說到我的動物窩，"}, {"type": "subtitle", "time": 36824.15, "timestamp": "10:13:44", "text": "我有點想把我"}]
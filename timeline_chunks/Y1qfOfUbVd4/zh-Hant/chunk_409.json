[{"type": "subtitle", "time": 24577.43, "timestamp": "06:49:37", "text": "我需要安排人"}, {"type": "subtitle", "time": 24582.19, "timestamp": "06:49:42", "text": "照顧她，"}, {"type": "subtitle", "time": 24585.59, "timestamp": "06:49:45", "text": "簡。讓我們來看看。  我想等等。一秒（音樂）。  讓我們繼續[音樂]像新娘角色扮演一樣很久很久。"}, {"type": "subtitle", "time": 24588.99, "timestamp": "06:49:48", "text": "簡·盧卡里奧"}, {"type": "subtitle", "time": 24593.19, "timestamp": "06:49:53", "text": "。  好的"}]
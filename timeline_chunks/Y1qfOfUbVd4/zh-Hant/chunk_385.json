[{"type": "subtitle", "time": 23103.59, "timestamp": "06:25:03", "text": "走吧。是的。所以，就像我剛才說的，呃，我會"}, {"type": "subtitle", "time": 23108.15, "timestamp": "06:25:08", "text": "玩網路直播，就像"}, {"type": "subtitle", "time": 23111.27, "timestamp": "06:25:11", "text": "他們什麼時候開始的那種？"}, {"type": "subtitle", "time": 23113.868, "timestamp": "06:25:13", "text": "11月3日"}, {"type": "subtitle", "time": 23120.35, "timestamp": "06:25:20", "text": "星期五晚上8點呃，美國東部時間到週日，呃，"}, {"type": "subtitle", "time": 23124.27, "timestamp": "06:25:24", "text": "週日下午5點左右。凌晨5點左右"}, {"type": "subtitle", "time": 23127.35, "timestamp": "06:25:27", "text": "。是著火了嗎？我忘了。是的。  是的"}, {"type": "subtitle", "time": 23130.59, "timestamp": "06:25:30", "text": "。所以，我的發揮有"}, {"type": "subtitle", "time": 23134.23, "timestamp": "06:25:34", "text": "減弱。不，不，不。就像「不」。"}, {"type": "subtitle", "time": 23139.39, "timestamp": "06:25:39", "text": "我扮演的是什麼角色"}, {"type": "subtitle", "time": 23141.628, "timestamp": "06:25:41", "text": "？"}, {"type": "subtitle", "time": 23157.75, "timestamp": "06:25:57", "text": "你這個"}]
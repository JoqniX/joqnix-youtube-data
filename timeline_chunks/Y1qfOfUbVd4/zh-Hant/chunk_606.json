[{"type": "subtitle", "time": 36360.51, "timestamp": "10:06:00", "text": "什麼插件？還有什麼？然後我會展示我的網路和 OBS 配置。所以"}, {"type": "subtitle", "time": 36367.63, "timestamp": "10:06:07", "text": "我不想這三件事在我進行"}, {"type": "subtitle", "time": 36374.15, "timestamp": "10:06:14", "text": "正常直播時總是讓我頭疼，對吧？但是，唉，"}, {"type": "subtitle", "time": 36384.63, "timestamp": "10:06:24", "text": "。昨天我真的超開心。昨天我超級"}, {"type": "subtitle", "time": 36410.586, "timestamp": "10:06:50", "text": "開心，因為我第一次有機會和日本人交談。是亞馬遜。嗯嗯，我"}, {"type": "subtitle", "time": 36412.266, "timestamp": "10:06:52", "text": "昨天真的很高興能和她聊天，了解更多關於她以及其他方面的事情。是啊，真的很有趣。"}, {"type": "subtitle", "time": 36419.71, "timestamp": "10:06:59", "text": "我的確實現了我的一個目標"}]
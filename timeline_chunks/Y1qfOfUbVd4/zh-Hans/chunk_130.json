[{"type": "subtitle", "time": 7818.79, "timestamp": "02:10:18", "text": "你。好了，我们回来了。为什么我不是"}, {"type": "subtitle", "time": 7843.149, "timestamp": "02:10:43", "text": "东西？不，没有东西。"}, {"type": "subtitle", "time": 7845.79, "timestamp": "02:10:45", "text": "好的。糟糕。一个"}, {"type": "subtitle", "time": 7847.95, "timestamp": "02:10:47", "text": "撬棍。"}, {"type": "subtitle", "time": 7851.669, "timestamp": "02:10:51", "text": "肖特叔叔。等等，调整角度找握把。什么"}, {"type": "subtitle", "time": 7854.27, "timestamp": "02:10:54", "text": "这样有用吗？我没有"}]
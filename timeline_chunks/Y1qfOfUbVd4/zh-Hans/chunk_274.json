[{"type": "subtitle", "time": 16441.789, "timestamp": "04:34:01", "text": "中国人。"}, {"type": "subtitle", "time": 16445.39, "timestamp": "04:34:05", "text": "是的，主题感觉"}, {"type": "subtitle", "time": 16447.83, "timestamp": "04:34:07", "text": "中国人。主题很有中国风。哦"}, {"type": "subtitle", "time": 16452.39, "timestamp": "04:34:12", "text": "天哪，我觉得我无法说出话来。"}, {"type": "subtitle", "time": 16455.869, "timestamp": "04:34:15", "text": "我说再重复一遍。呃，控制"}, {"type": "subtitle", "time": 16460.47, "timestamp": "04:34:20", "text": "一。我们骑自行车去某个地方"}, {"type": "subtitle", "time": 16468.59, "timestamp": "04:34:28", "text": "抢劫。我看到一个"}, {"type": "subtitle", "time": 16471.47, "timestamp": "04:34:31", "text": "小屋和"}, {"type": "subtitle", "time": 16480.47, "timestamp": "04:34:40", "text": "房子。我的天哪，它应有尽有！"}]
[{"type": "subtitle", "time": 4921.27, "timestamp": "01:22:01", "text": "这是怎么回事？哦，是付费的。"}, {"type": "subtitle", "time": 4923.44, "timestamp": "01:22:03", "text": "尽管。"}, {"type": "subtitle", "time": 4926.07, "timestamp": "01:22:06", "text": "[音乐]"}, {"type": "subtitle", "time": 4928.229, "timestamp": "01:22:08", "text": "我不知道你喜欢玩恋爱游戏。不，"}, {"type": "subtitle", "time": 4930.87, "timestamp": "01:22:10", "text": "我不爱，我的意思是，我从未玩过。"}, {"type": "subtitle", "time": 4933.51, "timestamp": "01:22:13", "text": "它演奏过很多这类音乐类型的曲目。所以，我"}, {"type": "subtitle", "time": 4935.55, "timestamp": "01:22:15", "text": "我想为什么不重试呢？"}, {"type": "subtitle", "time": 4939.35, "timestamp": "01:22:19", "text": "它。是啊，因为我真的很想被触摸。"}, {"type": "subtitle", "time": 4941.27, "timestamp": "01:22:21", "text": "我以前从未接触过的游戏"}, {"type": "subtitle", "time": 4944.229, "timestamp": "01:22:24", "text": "例如游戏类型。这就是我们"}, {"type": "subtitle", "time": 4946.79, "timestamp": "01:22:26", "text": "开始玩极品飞车"}, {"type": "subtitle", "time": 4949.229, "timestamp": "01:22:29", "text": "《Unbound》是一款赛车游戏。"}, {"type": "subtitle", "time": 4951.83, "timestamp": "01:22:31", "text": "现在，我不认为我直播过或者喜欢过。"}, {"type": "subtitle", "time": 4955.03, "timestamp": "01:22:35", "text": "玩了很多。我过去有过，但是"}, {"type": "subtitle", "time": 4958.79, "timestamp": "01:22:38", "text": "没看直播。所以他的赛车游戏是"}, {"type": "subtitle", "time": 4967.229, "timestamp": "01:22:47", "text": "那。哦，对了，尖叫声是"}]
[{"type": "subtitle", "time": 8825.59, "timestamp": "02:27:05", "text": "乔。我的天哪。我的天哪。我的天哪。我的天哪。我"}, {"type": "subtitle", "time": 8826.71, "timestamp": "02:27:06", "text": "我觉得我可能去不了。我不"}, {"type": "subtitle", "time": 8828.469, "timestamp": "02:27:08", "text": "我觉得我可能做不到。我"}, {"type": "subtitle", "time": 8830.95, "timestamp": "02:27:10", "text": "准备六个医疗包之类的。我可以"}, {"type": "subtitle", "time": 8833.11, "timestamp": "02:27:13", "text": "能做到吗？但我不知道。你如何"}, {"type": "subtitle", "time": 8835.11, "timestamp": "02:27:15", "text": "这游戏又有自动奔跑功能了吗？有人吗？"}, {"type": "subtitle", "time": 8837.95, "timestamp": "02:27:17", "text": "知道快捷键吗？他们坠落了吗？"}, {"type": "subtitle", "time": 8841.27, "timestamp": "02:27:21", "text": "快捷键？是T吗？不，那不是T。"}, {"type": "subtitle", "time": 8844.309, "timestamp": "02:27:24", "text": "有人在开枪。"}, {"type": "subtitle", "time": 8846.11, "timestamp": "02:27:26", "text": "有多远？"}, {"type": "subtitle", "time": 8848.87, "timestamp": "02:27:28", "text": "这？真的很远。我本应该"}, {"type": "subtitle", "time": 8851.19, "timestamp": "02:27:31", "text": "行动早。帕卡，事情就是这样。"}, {"type": "subtitle", "time": 8852.91, "timestamp": "02:27:32", "text": "当你没有检查时"}, {"type": "subtitle", "time": 8854.51, "timestamp": "02:27:34", "text": "这"}, {"type": "subtitle", "time": 8857.03, "timestamp": "02:27:37", "text": "事物。我看到你们在那边打架了。"}, {"type": "subtitle", "time": 8858.99, "timestamp": "02:27:38", "text": "直的"}, {"type": "subtitle", "time": 8861.87, "timestamp": "02:27:41", "text": "向上。"}, {"type": "subtitle", "time": 8865.63, "timestamp": "02:27:45", "text": "啊。呃，这个游戏"}, {"type": "subtitle", "time": 8873.19, "timestamp": "02:27:53", "text": "正确的？这个游戏……哦，是的。我步行"}]
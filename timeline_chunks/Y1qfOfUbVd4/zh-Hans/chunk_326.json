[{"type": "subtitle", "time": 19561.19, "timestamp": "05:26:01", "text": "我的天哪，太好吃了。我的天哪，"}, {"type": "subtitle", "time": 19564.31, "timestamp": "05:26:04", "text": "预告片太棒了。火车太"}, {"type": "subtitle", "time": 19574.23, "timestamp": "05:26:14", "text": "重制版。我只是想得到那个。看"}, {"type": "subtitle", "time": 19575.55, "timestamp": "05:26:15", "text": "那"}, {"type": "subtitle", "time": 19581.07, "timestamp": "05:26:21", "text": "地球？你，那是雅虎。雅虎。"}, {"type": "subtitle", "time": 19584.43, "timestamp": "05:26:24", "text": "和喜。我相信这就是全部了，呃，这就是全部了。"}, {"type": "subtitle", "time": 19591.868, "timestamp": "05:26:31", "text": "正确的？我不"}, {"type": "subtitle", "time": 19598.11, "timestamp": "05:26:38", "text": "去。"}]
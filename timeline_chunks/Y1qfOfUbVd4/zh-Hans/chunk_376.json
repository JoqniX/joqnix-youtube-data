[{"type": "subtitle", "time": 22567.83, "timestamp": "06:16:07", "text": "我这里发生了很棒的雷声"}, {"type": "subtitle", "time": 22607.51, "timestamp": "06:16:47", "text": "提醒我喝水。"}, {"type": "subtitle", "time": 22609.75, "timestamp": "06:16:49", "text": "是的，谢谢。我就是要这么做，对吧？"}, {"type": "subtitle", "time": 22619.99, "timestamp": "06:16:59", "text": "导致违约。你不能杀人。"}]
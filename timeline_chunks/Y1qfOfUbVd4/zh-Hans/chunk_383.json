[{"type": "subtitle", "time": 22981.47, "timestamp": "06:23:01", "text": "哦，"}, {"type": "subtitle", "time": 22983.75, "timestamp": "06:23:03", "text": "好的。你还参加其他领域的比赛吗？"}, {"type": "subtitle", "time": 22986.948, "timestamp": "06:23:06", "text": "游戏？是的，我各种类型的游戏都玩。"}, {"type": "subtitle", "time": 22989.03, "timestamp": "06:23:09", "text": "我这边几乎没有任何限制。"}, {"type": "subtitle", "time": 22993.67, "timestamp": "06:23:13", "text": "因为可以说我是个玩各种类型游戏的玩家。所以"}, {"type": "subtitle", "time": 22995.67, "timestamp": "06:23:15", "text": "更像是一个综合性流媒体平台。别只是"}, {"type": "subtitle", "time": 22997.83, "timestamp": "06:23:17", "text": "跨越不同类型。如果我玩的是第一人称射击游戏"}, {"type": "subtitle", "time": 23000.15, "timestamp": "06:23:20", "text": "今天，下次我要用手机的时候"}, {"type": "subtitle", "time": 23004.07, "timestamp": "06:23:24", "text": "比如角色扮演游戏或者策略游戏"}]
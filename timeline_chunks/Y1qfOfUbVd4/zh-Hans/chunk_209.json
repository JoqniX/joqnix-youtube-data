[{"type": "subtitle", "time": 12545.349, "timestamp": "03:29:05", "text": "仍然。他为什么还没死？我是怎么做到的"}, {"type": "subtitle", "time": 12547.55, "timestamp": "03:29:07", "text": "子弹？好的，明白了。"}, {"type": "subtitle", "time": 12559.91, "timestamp": "03:29:19", "text": "天哪，我差点就死了。我差点死了。在哪里"}, {"type": "subtitle", "time": 12562.03, "timestamp": "03:29:22", "text": "你来了吗？"}, {"type": "subtitle", "time": 12564.349, "timestamp": "03:29:24", "text": "从？三级"}, {"type": "subtitle", "time": 12567.269, "timestamp": "03:29:27", "text": "背包。谢谢。哦，我可以成为一个"}, {"type": "subtitle", "time": 12570.67, "timestamp": "03:29:30", "text": "龙虾。好的，我将成为"}, {"type": "subtitle", "time": 12587.83, "timestamp": "03:29:47", "text": "什么？啊，区域，区域，区域，区域，区域，"}, {"type": "subtitle", "time": 12595.15, "timestamp": "03:29:55", "text": "我。"}, {"type": "subtitle", "time": 12599.19, "timestamp": "03:29:59", "text": "好的。无法恢复生命值。"}]
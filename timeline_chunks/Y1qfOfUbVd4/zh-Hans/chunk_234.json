[{"type": "subtitle", "time": 14042.55, "timestamp": "03:54:02", "text": "早点到？轻机枪。哦，我得到了这款皮肤"}, {"type": "subtitle", "time": 14044.59, "timestamp": "03:54:04", "text": "流行音乐。"}, {"type": "subtitle", "time": 14056.269, "timestamp": "03:54:16", "text": "好的。打造特别的"}, {"type": "subtitle", "time": 14057.79, "timestamp": "03:54:17", "text": "东西。"}, {"type": "subtitle", "time": 14073.349, "timestamp": "03:54:33", "text": "就放在那里。"}, {"type": "subtitle", "time": 14075.26, "timestamp": "03:54:35", "text": "哦，我们打开吧"}, {"type": "subtitle", "time": 14077.87, "timestamp": "03:54:37", "text": "[音乐]"}, {"type": "subtitle", "time": 14081.26, "timestamp": "03:54:41", "text": "这些。让我们打开"}, {"type": "subtitle", "time": 14087.71, "timestamp": "03:54:47", "text": "[音乐]"}, {"type": "subtitle", "time": 14091.67, "timestamp": "03:54:51", "text": "这些。好的，有人在叫我。只是"}, {"type": "subtitle", "time": 14093.91, "timestamp": "03:54:53", "text": "给我一分钟时间。好的，我一会儿就回来。"}, {"type": "subtitle", "time": 14097.91, "timestamp": "03:54:57", "text": "一点。哎呀，你们可以……呃……让"}]
[{"type": "subtitle", "time": 1742.789, "timestamp": "00:29:02", "text": "我这就总结。帮我洗衣服。我曾"}, {"type": "subtitle", "time": 1743.549, "timestamp": "00:29:03", "text": "到"}, {"type": "subtitle", "time": 1747.59, "timestamp": "00:29:07", "text": "今天要洗很多衣服。我"}, {"type": "subtitle", "time": 1751.07, "timestamp": "00:29:11", "text": "就坐下来，好像忘了洗衣服似的。"}, {"type": "subtitle", "time": 1753.149, "timestamp": "00:29:13", "text": "一切。"}, {"type": "subtitle", "time": 1756.71, "timestamp": "00:29:16", "text": "哇。是的。"}, {"type": "subtitle", "time": 1768.669, "timestamp": "00:29:28", "text": "亚洲艺术品"}, {"type": "subtitle", "time": 1787.95, "timestamp": "00:29:47", "text": "忍者。长计时。"}]
[{"type": "subtitle", "time": 3841.15, "timestamp": "01:04:01", "text": "凯蒂得了20分。哇。 200."}, {"type": "subtitle", "time": 3847.549, "timestamp": "01:04:07", "text": "好的。所以，是的，我们已经完成了。"}, {"type": "subtitle", "time": 3851.589, "timestamp": "01:04:11", "text": "游戏。我受够了。"}, {"type": "subtitle", "time": 3852.75, "timestamp": "01:04:12", "text": "什么"}, {"type": "subtitle", "time": 3854.829, "timestamp": "01:04:14", "text": "这"}, {"type": "subtitle", "time": 3858.71, "timestamp": "01:04:18", "text": "什么？呃，就事论事吧"}, {"type": "subtitle", "time": 3861.029, "timestamp": "01:04:21", "text": "呃，我们直接卸载它吧。"}, {"type": "subtitle", "time": 3863.99, "timestamp": "01:04:23", "text": "就在我这儿，就在现在。是的。它是"}, {"type": "subtitle", "time": 3871.63, "timestamp": "01:04:31", "text": "耶。结束了。我的天啊。它是"}, {"type": "subtitle", "time": 3875.109, "timestamp": "01:04:35", "text": "超过。我的天啊。结束了。那场比赛"}, {"type": "subtitle", "time": 3887.069, "timestamp": "01:04:47", "text": "哦，天哪，那真是"}, {"type": "subtitle", "time": 3895.47, "timestamp": "01:04:55", "text": "是的。那真是个好兆头"}, {"type": "subtitle", "time": 3898.309, "timestamp": "01:04:58", "text": "一。希望你们喜欢。"}]
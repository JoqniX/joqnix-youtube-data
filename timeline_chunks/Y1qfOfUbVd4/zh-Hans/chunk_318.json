[{"type": "subtitle", "time": 19089.15, "timestamp": "05:18:09", "text": "我们拥有邪恶。邪恶的"}, {"type": "subtitle", "time": 19092.15, "timestamp": "05:18:12", "text": "内心的饥饿感让我难以忍受。为什么？为什么会这样？"}, {"type": "subtitle", "time": 19094.23, "timestamp": "05:18:14", "text": "让你饿了吗？这让我哭了。"}, {"type": "subtitle", "time": 19096.59, "timestamp": "05:18:16", "text": "放声尖叫。"}, {"type": "subtitle", "time": 19099.99, "timestamp": "05:18:19", "text": "等待。此外，Apex 的更新也……"}, {"type": "subtitle", "time": 19102.788, "timestamp": "05:18:22", "text": "凉爽的。新内容，账户版本"}, {"type": "subtitle", "time": 19105.03, "timestamp": "05:18:25", "text": "你知道，这真是太棒了。你"}, {"type": "subtitle", "time": 19106.55, "timestamp": "05:18:26", "text": "知道，就像你搜索你的"}, {"type": "subtitle", "time": 19108.788, "timestamp": "05:18:28", "text": "朋友们，不会再像以前那样了，没有"}, {"type": "subtitle", "time": 19110.708, "timestamp": "05:18:30", "text": "里面的一款游戏不会像PlayStation那样。"}, {"type": "subtitle", "time": 19112.868, "timestamp": "05:18:32", "text": "控制器、交换机，所有这些账户"}, {"type": "subtitle", "time": 19116.788, "timestamp": "05:18:36", "text": "突然出现。他们之间有一种类似合并的现象。"}, {"type": "subtitle", "time": 19119.55, "timestamp": "05:18:39", "text": "现在有了这个功能。太酷了。"}, {"type": "subtitle", "time": 19121.31, "timestamp": "05:18:41", "text": "D."}, {"type": "subtitle", "time": 19124.628, "timestamp": "05:18:44", "text": "好的。哦，它还是坏的。我需要什么？"}, {"type": "subtitle", "time": 19127.55, "timestamp": "05:18:47", "text": "如何在不欺骗的情况下发布Valerant？哦"}, {"type": "subtitle", "time": 19129.07, "timestamp": "05:18:49", "text": "上帝。"}, {"type": "subtitle", "time": 19133.628, "timestamp": "05:18:53", "text": "啊。我的天哪。没关系。我想我只能这样了"}, {"type": "subtitle", "time": 19137.07, "timestamp": "05:18:57", "text": "呃，不，我只是想测试一下。"}]
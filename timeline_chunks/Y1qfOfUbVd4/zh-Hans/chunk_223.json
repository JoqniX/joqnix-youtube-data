[{"type": "subtitle", "time": 13380.349, "timestamp": "03:43:00", "text": "啊，"}, {"type": "subtitle", "time": 13383.03, "timestamp": "03:43:03", "text": "好的。治愈我。治愈我。治愈我。愈合"}, {"type": "subtitle", "time": 13384.95, "timestamp": "03:43:04", "text": "我。"}, {"type": "subtitle", "time": 13387.469, "timestamp": "03:43:07", "text": "治愈小精灵。愈合"}, {"type": "subtitle", "time": 13391.07, "timestamp": "03:43:11", "text": "迷你亚。哦，他们忘了"}, {"type": "subtitle", "time": 13394.59, "timestamp": "03:43:14", "text": "我。愈合。愈合"}, {"type": "subtitle", "time": 13397.83, "timestamp": "03:43:17", "text": "我。打扰一下。我即将死去。哦"}, {"type": "subtitle", "time": 13432.63, "timestamp": "03:43:52", "text": "你一个人吗？呃，你是"}, {"type": "subtitle", "time": 13434.389, "timestamp": "03:43:54", "text": "独自一人直到你参与其中。"}]
[{"type": "subtitle", "time": 13443.95, "timestamp": "03:44:03", "text": "是的。是的。好的。哦，真好"}, {"type": "subtitle", "time": 13446.71, "timestamp": "03:44:06", "text": "射击。好球。看看这个人。他的"}, {"type": "subtitle", "time": 13449.71, "timestamp": "03:44:09", "text": "他得到了兽皮和护身符，"}, {"type": "subtitle", "time": 13453.75, "timestamp": "03:44:13", "text": "东西。钥匙、钥匙扣之类的东西。哇。"}, {"type": "subtitle", "time": 13457.95, "timestamp": "03:44:17", "text": "他197级了。不好意思。"}, {"type": "subtitle", "time": 13483.15, "timestamp": "03:44:43", "text": "哇，"}, {"type": "subtitle", "time": 13485.229, "timestamp": "03:44:45", "text": "好的。我的天哪。"}, {"type": "subtitle", "time": 13488.99, "timestamp": "03:44:48", "text": "嗯，这个"}, {"type": "subtitle", "time": 13497.51, "timestamp": "03:44:57", "text": "枪和平底锅。"}]
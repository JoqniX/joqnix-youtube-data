[{"type": "subtitle", "time": 10803.389, "timestamp": "03:00:03", "text": "狗。背包不是"}, {"type": "subtitle", "time": 10806.55, "timestamp": "03:00:06", "text": "未来。为什么？"}, {"type": "subtitle", "time": 10810.99, "timestamp": "03:00:10", "text": "我只需要一个背包。我看到很多"}, {"type": "subtitle", "time": 10812.48, "timestamp": "03:00:12", "text": "好东西。不"}, {"type": "subtitle", "time": 10822.03, "timestamp": "03:00:22", "text": "去。嗯，是的。你好，Nanx。"}, {"type": "subtitle", "time": 10824.87, "timestamp": "03:00:24", "text": "你好。欢迎。我刚才是不是看到你的"}, {"type": "subtitle", "time": 10826.429, "timestamp": "03:00:26", "text": "背包？"}, {"type": "subtitle", "time": 10828.11, "timestamp": "03:00:28", "text": "哦，"}, {"type": "subtitle", "time": 10845.03, "timestamp": "03:00:45", "text": "最后。你看到空调的影子了吗？"}, {"type": "subtitle", "time": 10854.71, "timestamp": "03:00:54", "text": "然而。我的天啊，这后坐力也太疯狂了吧！"}]
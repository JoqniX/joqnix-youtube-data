[{"type": "subtitle", "time": 10392.07, "timestamp": "02:53:12", "text": "死。乡村小路笑话。哦。哦，那个"}, {"type": "subtitle", "time": 10407.349, "timestamp": "02:53:27", "text": "如何？我的天啊。我是怎么得到他的？如何"}, {"type": "subtitle", "time": 10408.95, "timestamp": "02:53:28", "text": "我抓到他了吗？我是怎么得到他的？我是"}, {"type": "subtitle", "time": 10411.79, "timestamp": "02:53:31", "text": "专业。我 我 我"}, {"type": "subtitle", "time": 10438.91, "timestamp": "02:53:58", "text": "叔叔，他承认了"}]
[{"type": "subtitle", "time": 8403.07, "timestamp": "02:20:03", "text": "它。你听到啦啦队彩球声了吗？"}, {"type": "subtitle", "time": 8406.79, "timestamp": "02:20:06", "text": "在。哦，是的。这难道不是更安全吗？"}, {"type": "subtitle", "time": 8411.15, "timestamp": "02:20:11", "text": "被人从后面……吸吮？"}, {"type": "subtitle", "time": 8413.67, "timestamp": "02:20:13", "text": "好的。这是什么？哦，是的。谢谢。"}, {"type": "subtitle", "time": 8415.71, "timestamp": "02:20:15", "text": "我需要"}, {"type": "subtitle", "time": 8420.19, "timestamp": "02:20:20", "text": "那。手榴弹的优点是"}, {"type": "subtitle", "time": 8421.95, "timestamp": "02:20:21", "text": "喜欢"}, {"type": "subtitle", "time": 8425.59, "timestamp": "02:20:25", "text": "旋转。眩晕可不是什么好事。闪光。我"}, {"type": "subtitle", "time": 8436.71, "timestamp": "02:20:36", "text": "那？那东西还会再来。这"}, {"type": "subtitle", "time": 8440.19, "timestamp": "02:20:40", "text": "声音。奇怪的声音。谁在跟踪我"}, {"type": "subtitle", "time": 8448.67, "timestamp": "02:20:48", "text": "D. 你好，罗伯特"}]
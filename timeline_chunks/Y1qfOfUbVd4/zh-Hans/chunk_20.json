[{"type": "subtitle", "time": 1201.11, "timestamp": "00:20:01", "text": "哦，我本来想买《战地2044》的。"}, {"type": "subtitle", "time": 1203.47, "timestamp": "00:20:03", "text": "因为我当时正在玩那个游戏"}, {"type": "subtitle", "time": 1206.63, "timestamp": "00:20:06", "text": "我当时就想，嗯，我应该来吗？"}, {"type": "subtitle", "time": 1215.15, "timestamp": "00:20:15", "text": "什么？我没看到"}, {"type": "subtitle", "time": 1219.35, "timestamp": "00:20:19", "text": "他。让我们来看看。太容易了。太容易了。"}, {"type": "subtitle", "time": 1231.789, "timestamp": "00:20:31", "text": "你看到了吗？"}, {"type": "subtitle", "time": 1239.71, "timestamp": "00:20:39", "text": "什么？我的天啊。什么是"}, {"type": "subtitle", "time": 1242.35, "timestamp": "00:20:42", "text": "这？一"}, {"type": "subtitle", "time": 1258.39, "timestamp": "00:20:58", "text": "那里。但一只母鸡却成了恐怖分子"}]
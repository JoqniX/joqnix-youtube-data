[{"type": "subtitle", "time": 2160.31, "timestamp": "00:36:00", "text": "哇。我的天啊。我知道我说过我会"}, {"type": "subtitle", "time": 2169.03, "timestamp": "00:36:09", "text": "好的。我只想赶紧起床，然后我就会"}, {"type": "subtitle", "time": 2171.589, "timestamp": "00:36:11", "text": "那就到此为止。它要走了，它要走了，我知道。"}, {"type": "subtitle", "time": 2173.27, "timestamp": "00:36:13", "text": "它将被置于……之下"}, {"type": "subtitle", "time": 2175.71, "timestamp": "00:36:15", "text": "流走。所以是"}, {"type": "subtitle", "time": 2181.07, "timestamp": "00:36:21", "text": "正确的。"}, {"type": "subtitle", "time": 2183.31, "timestamp": "00:36:23", "text": "[音乐]"}, {"type": "subtitle", "time": 2185.91, "timestamp": "00:36:25", "text": "最终，这将进入……"}, {"type": "subtitle", "time": 2187.74, "timestamp": "00:36:27", "text": "东西。所以，没关系。"}, {"type": "subtitle", "time": 2205.19, "timestamp": "00:36:45", "text": "男生。这个游戏是免费的吗？是的，就是这样。"}, {"type": "subtitle", "time": 2214.27, "timestamp": "00:36:54", "text": "[音乐]"}, {"type": "subtitle", "time": 2218.15, "timestamp": "00:36:58", "text": "H：我的天哪。再次参与突袭。"}, {"type": "subtitle", "time": 2219.47, "timestamp": "00:36:59", "text": "你好"}]
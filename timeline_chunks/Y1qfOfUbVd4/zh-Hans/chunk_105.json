[{"type": "subtitle", "time": 6303.31, "timestamp": "01:45:03", "text": "得分优势"}, {"type": "subtitle", "time": 6306.709, "timestamp": "01:45:06", "text": "优势。所以，呃，我们要去……我想"}, {"type": "subtitle", "time": 6310.07, "timestamp": "01:45:10", "text": "我们可以和伊朗队比赛。所以，新事物是"}, {"type": "subtitle", "time": 6313.99, "timestamp": "01:45:13", "text": "这次更新来了，这就像是为了……"}, {"type": "subtitle", "time": 6316.709, "timestamp": "01:45:16", "text": "10天，这是一个为期10天或11天的活动，或者"}, {"type": "chat", "time": 6319.482, "timestamp": "01:45:19", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "i'll bet that bro aint asleep"}, {"type": "subtitle", "time": 6319.83, "timestamp": "01:45:19", "text": "经典之作"}, {"type": "subtitle", "time": 6322.39, "timestamp": "01:45:22", "text": "地图将回归这款游戏"}, {"type": "subtitle", "time": 6325.51, "timestamp": "01:45:25", "text": "显然。我们将单飞。"}, {"type": "subtitle", "time": 6327.59, "timestamp": "01:45:27", "text": "第一人称视角。我不玩游戏"}, {"type": "subtitle", "time": 6331.709, "timestamp": "01:45:31", "text": "完全是第三人称。呃，眨眼。但"}, {"type": "subtitle", "time": 6335.91, "timestamp": "01:45:35", "text": "好的，我们来核对一下。呃，我应该……"}, {"type": "subtitle", "time": 6338.07, "timestamp": "01:45:38", "text": "我应该尝试训练吗？我应该这样做吗？"}, {"type": "subtitle", "time": 6345.629, "timestamp": "01:45:45", "text": "知道。我的朋友更多了。没关系。我"}, {"type": "subtitle", "time": 6348.07, "timestamp": "01:45:48", "text": "还。我的意思是，我没有朋友。"}, {"type": "subtitle", "time": 6351.43, "timestamp": "01:45:51", "text": "玩PUBG的人。所以，是的，我不认为"}, {"type": "subtitle", "time": 6353.99, "timestamp": "01:45:53", "text": "他们中的大多数人甚至都不会玩。所以"}, {"type": "subtitle", "time": 6356.709, "timestamp": "01:45:56", "text": "是啊，事情就是这样。另外，让我来修复一下"}, {"type": "subtitle", "time": 6359.229, "timestamp": "01:45:59", "text": "仅此一次"}]
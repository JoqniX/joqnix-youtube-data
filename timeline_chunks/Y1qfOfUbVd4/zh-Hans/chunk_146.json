[{"type": "subtitle", "time": 8763.07, "timestamp": "02:26:03", "text": "标记不正确。哦，"}, {"type": "subtitle", "time": 8766.15, "timestamp": "02:26:06", "text": "假的。我不认为他走到了这一步。"}, {"type": "subtitle", "time": 8769.19, "timestamp": "02:26:09", "text": "哦，原来你在这儿啊。你来了"}, {"type": "subtitle", "time": 8770.67, "timestamp": "02:26:10", "text": "为了"}, {"type": "subtitle", "time": 8773.71, "timestamp": "02:26:13", "text": "你。是的。你好。"}, {"type": "subtitle", "time": 8776.95, "timestamp": "02:26:16", "text": "你好。 3倍。呃，等等。医疗包。你需要"}, {"type": "subtitle", "time": 8779.11, "timestamp": "02:26:19", "text": "它。我们需要你。我们需要你。你"}, {"type": "subtitle", "time": 8783.309, "timestamp": "02:26:23", "text": "需要。 SKS说：“我就是这些"}, {"type": "subtitle", "time": 8785.99, "timestamp": "02:26:25", "text": "狙击手。有个狙击手难道不好吗？"}, {"type": "subtitle", "time": 8787.95, "timestamp": "02:26:27", "text": "或者我不应该这样做"}, {"type": "subtitle", "time": 8791.99, "timestamp": "02:26:31", "text": "是吗？一把好用的狙击步枪。若菜。"}, {"type": "subtitle", "time": 8799.71, "timestamp": "02:26:39", "text": "呃，我不知道。我的弹药够用吗？"}, {"type": "subtitle", "time": 8805.389, "timestamp": "02:26:45", "text": "153. 哦，不。不行。等待。为什么是我"}, {"type": "subtitle", "time": 8808.349, "timestamp": "02:26:48", "text": "步行？我该怎么做？"}]
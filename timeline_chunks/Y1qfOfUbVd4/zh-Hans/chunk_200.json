[{"type": "subtitle", "time": 12016.389, "timestamp": "03:20:16", "text": "脱水。嗯？"}, {"type": "subtitle", "time": 12019.07, "timestamp": "03:20:19", "text": "哦，天哪，那种感觉"}, {"type": "subtitle", "time": 12024.429, "timestamp": "03:20:24", "text": "好的。所以，大家都要记得补充水分。"}, {"type": "subtitle", "time": 12026.74, "timestamp": "03:20:26", "text": "还没有。这样做是好事"}, {"type": "subtitle", "time": 12043.19, "timestamp": "03:20:43", "text": "岩石。好，咱们去这个古老的地方吧。"}, {"type": "subtitle", "time": 12046.389, "timestamp": "03:20:46", "text": "废墟之类的东西。从未去过那里。"}, {"type": "subtitle", "time": 12054.51, "timestamp": "03:20:54", "text": "前。我的天啊。一，"}, {"type": "subtitle", "time": 12057.71, "timestamp": "03:20:57", "text": "二。两个人过来"}, {"type": "subtitle", "time": 12059.95, "timestamp": "03:20:59", "text": "那里。"}]
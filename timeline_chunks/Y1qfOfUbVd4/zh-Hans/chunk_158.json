[{"type": "subtitle", "time": 9487.87, "timestamp": "02:38:07", "text": "意思是？"}, {"type": "subtitle", "time": 9491.03, "timestamp": "02:38:11", "text": "什么？ Apex Fortnite。有多少款游戏？"}, {"type": "subtitle", "time": 9493.349, "timestamp": "02:38:13", "text": "现在有请求功能了吗？为什么你不"}, {"type": "subtitle", "time": 9496.11, "timestamp": "02:38:16", "text": "做这些事？这很重要。"}, {"type": "subtitle", "time": 9508.469, "timestamp": "02:38:28", "text": "哦，它们不会活过来。我的意思是"}, {"type": "subtitle", "time": 9513.83, "timestamp": "02:38:33", "text": "呃，你知道吗，我会把话题转到你身上。"}, {"type": "subtitle", "time": 9516.95, "timestamp": "02:38:36", "text": "因为我今天没有工作要做。你"}, {"type": "subtitle", "time": 9520.389, "timestamp": "02:38:40", "text": "他会为我这么做的。谢谢。我"}, {"type": "subtitle", "time": 9523.349, "timestamp": "02:38:43", "text": "意思是说，我从来没有找人帮我剪辑过或者做过其他编辑工作。"}, {"type": "subtitle", "time": 9525.23, "timestamp": "02:38:45", "text": "任何这样的东西"}, {"type": "subtitle", "time": 9528.79, "timestamp": "02:38:48", "text": "是的，可以回忆起你的队友。"}, {"type": "subtitle", "time": 9535.55, "timestamp": "02:38:55", "text": "好的。呃，"}, {"type": "subtitle", "time": 9538.55, "timestamp": "02:38:58", "text": "爸爸的胸部。我有三个。这是什么？"}]
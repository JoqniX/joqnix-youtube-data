[{"type": "subtitle", "time": 9783.75, "timestamp": "02:43:03", "text": "什么？是的。你不是说你有一个"}, {"type": "subtitle", "time": 9787.429, "timestamp": "02:43:07", "text": "新婚妻子？我有一个，或者嗯？我不"}, {"type": "subtitle", "time": 9790.19, "timestamp": "02:43:10", "text": "甚至知道"}, {"type": "subtitle", "time": 9793.15, "timestamp": "02:43:13", "text": "我。我曾"}, {"type": "subtitle", "time": 9795.87, "timestamp": "02:43:15", "text": "一。"}, {"type": "subtitle", "time": 9797.469, "timestamp": "02:43:17", "text": "渡"}, {"type": "subtitle", "time": 9801.67, "timestamp": "02:43:21", "text": "博库阿。我们就是我。你在说话"}, {"type": "subtitle", "time": 9803.55, "timestamp": "02:43:23", "text": "关于我，对吧？"}, {"type": "subtitle", "time": 9821.07, "timestamp": "02:43:41", "text": "嗯？你觉得我有时间吗？"}, {"type": "subtitle", "time": 9823.67, "timestamp": "02:43:43", "text": "那？你觉得我有时间做这件事吗？"}, {"type": "subtitle", "time": 9830.75, "timestamp": "02:43:50", "text": "你。我有一个"}]
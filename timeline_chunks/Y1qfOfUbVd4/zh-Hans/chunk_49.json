[{"type": "subtitle", "time": 2941.19, "timestamp": "00:49:01", "text": "[音乐]"}, {"type": "subtitle", "time": 2943.95, "timestamp": "00:49:03", "text": "是的，后坐力控制是一个"}, {"type": "subtitle", "time": 2949.829, "timestamp": "00:49:09", "text": "正确的。不，不，我只玩到我"}, {"type": "subtitle", "time": 2951.67, "timestamp": "00:49:11", "text": "找个通风口。就是这样。就是这样。发送"}, {"type": "subtitle", "time": 2954.23, "timestamp": "00:49:14", "text": "我开着面包车，游戏结束了。总之，"}, {"type": "subtitle", "time": 2955.75, "timestamp": "00:49:15", "text": "我现在要卸载了。为什么不呢？"}, {"type": "subtitle", "time": 2957.549, "timestamp": "00:49:17", "text": "一个通风口，并称之为"}, {"type": "subtitle", "time": 2984.47, "timestamp": "00:49:44", "text": "她。快节奏的游戏是我的最爱。"}, {"type": "subtitle", "time": 2988.309, "timestamp": "00:49:48", "text": "我喜欢快节奏的游戏。"}, {"type": "subtitle", "time": 2997.75, "timestamp": "00:49:57", "text": "祝你好运。"}]
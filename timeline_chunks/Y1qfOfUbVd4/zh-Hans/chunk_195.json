[{"type": "subtitle", "time": 11715.71, "timestamp": "03:15:15", "text": "你？那只奔跑的鸭子把我撞死了。不"}, {"type": "subtitle", "time": 11719.99, "timestamp": "03:15:19", "text": "方式。那只奔跑的鸭子把我撞死了。什么？"}, {"type": "subtitle", "time": 11722.359, "timestamp": "03:15:22", "text": "什么？ 什么？决不。什么？"}, {"type": "subtitle", "time": 11735.469, "timestamp": "03:15:35", "text": "什么？我没能打上疫苗。"}, {"type": "subtitle", "time": 11739.83, "timestamp": "03:15:39", "text": "就像轻轻一点就行了。我猜是这样"}, {"type": "subtitle", "time": 11743.03, "timestamp": "03:15:43", "text": "我的技能水平很差。钱币。是的，我"}, {"type": "subtitle", "time": 11745.83, "timestamp": "03:15:45", "text": "我已经尽力了。但事实就是如此。"}]
[{"type": "subtitle", "time": 20640.27, "timestamp": "05:44:00", "text": "走吧，菲尼尼。我们走吧，"}, {"type": "subtitle", "time": 20674.39, "timestamp": "05:44:34", "text": "疼痛。我感觉自己快要死了，正在死去"}, {"type": "subtitle", "time": 20677.15, "timestamp": "05:44:37", "text": "我自己为死亡而死，伙计。"}, {"type": "subtitle", "time": 20678.99, "timestamp": "05:44:38", "text": "好的。我是"}, {"type": "subtitle", "time": 20682.23, "timestamp": "05:44:42", "text": "比如过分依赖能力。"}, {"type": "subtitle", "time": 20692.31, "timestamp": "05:44:52", "text": "[音乐]"}, {"type": "subtitle", "time": 20699.13, "timestamp": "05:44:59", "text": "天哪，我那双酷炫的腿从……开始"}]
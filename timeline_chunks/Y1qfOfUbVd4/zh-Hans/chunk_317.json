[{"type": "subtitle", "time": 19022.55, "timestamp": "05:17:02", "text": "自由。我一直渴望这种自由。"}, {"type": "subtitle", "time": 19025.19, "timestamp": "05:17:05", "text": "自十月以来。月初了。"}, {"type": "subtitle", "time": 19028.75, "timestamp": "05:17:08", "text": "但最后，我无话可说了。"}, {"type": "subtitle", "time": 19042.31, "timestamp": "05:17:22", "text": "快乐的。是的。这么多驱动程序更新"}, {"type": "subtitle", "time": 19051.91, "timestamp": "05:17:31", "text": "甘巴。是的，我们邪恶一号和二号"}, {"type": "subtitle", "time": 19055.27, "timestamp": "05:17:35", "text": "其余的。是的。他为什么会这样做？他为什么会这样做？"}, {"type": "subtitle", "time": 19057.31, "timestamp": "05:17:37", "text": "就像我的生日"}, {"type": "subtitle", "time": 19059.75, "timestamp": "05:17:39", "text": "月？但我唯一不满的就是我的"}, {"type": "subtitle", "time": 19064.27, "timestamp": "05:17:44", "text": "十月就是太……呃……"}, {"type": "subtitle", "time": 19066.99, "timestamp": "05:17:46", "text": "如果我"}, {"type": "subtitle", "time": 19070.708, "timestamp": "05:17:50", "text": "我的意思是，如果我能不看就好了"}, {"type": "subtitle", "time": 19073.27, "timestamp": "05:17:53", "text": "10月份我会直播恐怖游戏"}, {"type": "subtitle", "time": 19075.59, "timestamp": "05:17:55", "text": "我会很乐意喜欢那个月。它是"}, {"type": "subtitle", "time": 19078.628, "timestamp": "05:17:58", "text": "只是我现在必须这么做。必须"}, {"type": "subtitle", "time": 19079.55, "timestamp": "05:17:59", "text": "溪流"}]
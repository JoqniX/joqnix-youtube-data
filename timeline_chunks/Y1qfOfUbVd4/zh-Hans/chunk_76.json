[{"type": "subtitle", "time": 4560.91, "timestamp": "01:16:00", "text": "东西"}, {"type": "subtitle", "time": 4563.99, "timestamp": "01:16:03", "text": "我5天前就发布了这条公告。"}, {"type": "subtitle", "time": 4566.79, "timestamp": "01:16:06", "text": "已经过去五天了。我们有我们的"}, {"type": "subtitle", "time": 4571.87, "timestamp": "01:16:11", "text": "新的推特账号分离机制。"}, {"type": "subtitle", "time": 4574.709, "timestamp": "01:16:14", "text": "哇。我是如何在我的主账号上发推文的？"}, {"type": "subtitle", "time": 4577.63, "timestamp": "01:16:17", "text": "帐户？我总是忘记发推文吗？"}, {"type": "subtitle", "time": 4581.51, "timestamp": "01:16:21", "text": "男人？子账户。我会在那里发推文。"}, {"type": "subtitle", "time": 4583.35, "timestamp": "01:16:23", "text": "有时。最近，我一直没怎么……"}, {"type": "subtitle", "time": 4590.55, "timestamp": "01:16:30", "text": "子。最近我都没怎么发推特。"}, {"type": "subtitle", "time": 4605.03, "timestamp": "01:16:45", "text": "此外，昨天的V现在变成了"}, {"type": "subtitle", "time": 4606.95, "timestamp": "01:16:46", "text": "可供观看。你可以观看"}, {"type": "subtitle", "time": 4609.75, "timestamp": "01:16:49", "text": "你愿意。另外，我们应该找到“不要”吗？"}, {"type": "subtitle", "time": 4612.83, "timestamp": "01:16:52", "text": "我们需要找一款新的FPS游戏来看。"}, {"type": "subtitle", "time": 4616.07, "timestamp": "01:16:56", "text": "在？我的免费账户里有很多FPS游戏。"}, {"type": "subtitle", "time": 4618.95, "timestamp": "01:16:58", "text": "游戏列表。我们试着找一个。"}]
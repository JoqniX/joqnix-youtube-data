[{"type": "subtitle", "time": 19202.948, "timestamp": "05:20:02", "text": "好的。瓦莱兰特。不，我点击了"}, {"type": "subtitle", "time": 19204.67, "timestamp": "05:20:04", "text": "记住我的设置。"}, {"type": "subtitle", "time": 19208.51, "timestamp": "05:20:08", "text": "不，哦，没事。没关系。它是"}, {"type": "subtitle", "time": 19211.83, "timestamp": "05:20:11", "text": "美好的。还行吧。我应该就……"}, {"type": "subtitle", "time": 19214.75, "timestamp": "05:20:14", "text": "运行正常吗？无需喜欢"}, {"type": "subtitle", "time": 19218.23, "timestamp": "05:20:18", "text": "筛子。这样行得通吗？"}, {"type": "subtitle", "time": 19220.39, "timestamp": "05:20:20", "text": "我知道我正在使用保存功能来隐藏"}, {"type": "subtitle", "time": 19222.948, "timestamp": "05:20:22", "text": "来自我好友列表里的所有人"}, {"type": "subtitle", "time": 19225.948, "timestamp": "05:20:25", "text": "我喜欢独处的时间。我"}, {"type": "subtitle", "time": 19231.708, "timestamp": "05:20:31", "text": "知道。呃，但是新的传奇生物只是一个盾牌而已。"}, {"type": "subtitle", "time": 19234.15, "timestamp": "05:20:34", "text": "充电器。你指的是哪一个？"}, {"type": "subtitle", "time": 19241.75, "timestamp": "05:20:41", "text": "瓦莱兰特？我只玩《Valerant》而已。"}, {"type": "subtitle", "time": 19245.19, "timestamp": "05:20:45", "text": "用于瞄准训练器。游戏内瞄准训练器"}, {"type": "subtitle", "time": 19247.99, "timestamp": "05:20:47", "text": "你得到了。就这些了。哦，就这些了。"}, {"type": "subtitle", "time": 19250.23, "timestamp": "05:20:50", "text": "我这辈子唯一想要的就是能够"}, {"type": "subtitle", "time": 19252.75, "timestamp": "05:20:52", "text": "偷看你的"}, {"type": "subtitle", "time": 19255.75, "timestamp": "05:20:55", "text": "头部。我不需要这种不邀请函的制度。"}, {"type": "subtitle", "time": 19257.23, "timestamp": "05:20:57", "text": "总之，"}]
[{"type": "subtitle", "time": 9372.87, "timestamp": "02:36:12", "text": "嗯。我要用头撞他，不，我"}, {"type": "subtitle", "time": 9383.55, "timestamp": "02:36:23", "text": "哦，真诡异。"}, {"type": "subtitle", "time": 9387.59, "timestamp": "02:36:27", "text": "B. 等等，等等，等等。我希望自己没事。"}, {"type": "subtitle", "time": 9389.51, "timestamp": "02:36:29", "text": "制定策略。开玩笑的。你当时会怎么做"}, {"type": "subtitle", "time": 9391.63, "timestamp": "02:36:31", "text": "他人"}]
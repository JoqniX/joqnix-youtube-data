[{"type": "subtitle", "time": 13262.51, "timestamp": "03:41:02", "text": "死？它就像《Valerant》一样。等等，就像"}, {"type": "subtitle", "time": 13272.99, "timestamp": "03:41:12", "text": "去。那是什么？你不能这样做"}, {"type": "subtitle", "time": 13277.19, "timestamp": "03:41:17", "text": "绝地求生。在PBG中，可以像这样玩。"}, {"type": "subtitle", "time": 13288.99, "timestamp": "03:41:28", "text": "哦，他们称之为“蓝色地带生成器”。"}, {"type": "subtitle", "time": 13291.309, "timestamp": "03:41:31", "text": "哦，"}, {"type": "subtitle", "time": 13294.96, "timestamp": "03:41:34", "text": "好的。这很酷。"}, {"type": "subtitle", "time": 13313.95, "timestamp": "03:41:53", "text": "那是"}]
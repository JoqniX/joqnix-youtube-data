[{"type": "subtitle", "time": 17283.51, "timestamp": "04:48:03", "text": "暂时就这些了。我去休息了。我"}, {"type": "subtitle", "time": 17288.67, "timestamp": "04:48:08", "text": "里面。所以，希望你"}, {"type": "subtitle", "time": 17291.628, "timestamp": "04:48:11", "text": "享受"}, {"type": "subtitle", "time": 17295.15, "timestamp": "04:48:15", "text": "是什么，以及那些来过的人"}, {"type": "subtitle", "time": 17300.35, "timestamp": "04:48:20", "text": "关于 Billy Nih。谢谢光临"}, {"type": "subtitle", "time": 17305.43, "timestamp": "04:48:25", "text": "由和凌。以及在垂直流上。"}, {"type": "subtitle", "time": 17307.27, "timestamp": "04:48:27", "text": "谢谢光临。我会确保"}, {"type": "subtitle", "time": 17311.788, "timestamp": "04:48:31", "text": "去做这个，呃，稍等片刻。"}, {"type": "subtitle", "time": 17317.03, "timestamp": "04:48:37", "text": "东西。嗯，稍后回来，WA 正在设置垂直方向"}, {"type": "subtitle", "time": 17319.99, "timestamp": "04:48:39", "text": "流。嗯，所以当我切换场景时，不，"}, {"type": "subtitle", "time": 17322.31, "timestamp": "04:48:42", "text": "呃，它还会切换场景。"}, {"type": "subtitle", "time": 17325.67, "timestamp": "04:48:45", "text": "垂直流。而且每当我"}, {"type": "subtitle", "time": 17327.99, "timestamp": "04:48:47", "text": "呃，就是做这类事情，对吧？"}, {"type": "subtitle", "time": 17331.75, "timestamp": "04:48:51", "text": "比如我离开电脑或者做其他事情的时候，"}, {"type": "subtitle", "time": 17334.31, "timestamp": "04:48:54", "text": "我会设法做到这一点。"}, {"type": "subtitle", "time": 17338.15, "timestamp": "04:48:58", "text": "垂直流媒体观察者也可以看到"}]
[{"type": "subtitle", "time": 19382.23, "timestamp": "05:23:02", "text": "大家把目光移到左上角。"}, {"type": "subtitle", "time": 19386.03, "timestamp": "05:23:06", "text": "好的。你看到上面这个白点了吗？"}, {"type": "subtitle", "time": 19389.83, "timestamp": "05:23:09", "text": "这里？这个像素点是什么？你看"}, {"type": "subtitle", "time": 19393.11, "timestamp": "05:23:13", "text": "就在我的鼠标光标所在位置吗？"}, {"type": "subtitle", "time": 19394.99, "timestamp": "05:23:14", "text": "嗯？什么是"}, {"type": "subtitle", "time": 19396.83, "timestamp": "05:23:16", "text": "那？没有任何"}, {"type": "subtitle", "time": 19400.59, "timestamp": "05:23:20", "text": "那里。谁是呃……"}, {"type": "subtitle", "time": 19405.19, "timestamp": "05:23:25", "text": "呃，3DX博士是谁？"}, {"type": "subtitle", "time": 19407.39, "timestamp": "05:23:27", "text": "好的。呃，我邀请"}, {"type": "subtitle", "time": 19415.31, "timestamp": "05:23:35", "text": "戴安娜。哦，是的"}, {"type": "subtitle", "time": 19428.628, "timestamp": "05:23:48", "text": "好的。哦，等等。我开启作弊模式了吗？我"}, {"type": "subtitle", "time": 19430.55, "timestamp": "05:23:50", "text": "我想我没做到。我想我没做到。我"}, {"type": "subtitle", "time": 19438.788, "timestamp": "05:23:58", "text": "Jakanda等等，所以呃，Isu是什么？"}, {"type": "subtitle", "time": 19439.948, "timestamp": "05:23:59", "text": "日本"}]
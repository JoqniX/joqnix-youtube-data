[{"type": "subtitle", "time": 1020.15, "timestamp": "00:17:00", "text": "什么？我当时做得很好，但他却不得不……"}, {"type": "subtitle", "time": 1022.03, "timestamp": "00:17:02", "text": "这样对我。"}, {"type": "subtitle", "time": 1029.35, "timestamp": "00:17:09", "text": "好的。那么，现在谁能杀了他呢？"}, {"type": "subtitle", "time": 1037.19, "timestamp": "00:17:17", "text": "什么？这游戏真棒。"}, {"type": "subtitle", "time": 1051.59, "timestamp": "00:17:31", "text": "嗯？我根本没玩过这个游戏。什么？"}, {"type": "subtitle", "time": 1056.99, "timestamp": "00:17:36", "text": "在？什么是"}, {"type": "subtitle", "time": 1059.029, "timestamp": "00:17:39", "text": "正在发生？等等，别告诉我这是……"}, {"type": "subtitle", "time": 1060.27, "timestamp": "00:17:40", "text": "我会这么做。"}, {"type": "subtitle", "time": 1062.909, "timestamp": "00:17:42", "text": "再次。等待，"}, {"type": "subtitle", "time": 1067.789, "timestamp": "00:17:47", "text": "什么？我怎么还活着？区。"}, {"type": "subtitle", "time": 1073.23, "timestamp": "00:17:53", "text": "这？"}, {"type": "subtitle", "time": 1075.669, "timestamp": "00:17:55", "text": "等等，你们都看到了吧？"}, {"type": "subtitle", "time": 1078.07, "timestamp": "00:17:58", "text": "并非只有我一个人这么说，"}]
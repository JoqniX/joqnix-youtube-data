[{"type": "subtitle", "time": 2461.19, "timestamp": "00:41:01", "text": "然后我就结束直播了。"}, {"type": "subtitle", "time": 2462.79, "timestamp": "00:41:02", "text": "卸载游戏，再也不玩了。"}, {"type": "subtitle", "time": 2463.55, "timestamp": "00:41:03", "text": "这"}, {"type": "subtitle", "time": 2467.349, "timestamp": "00:41:07", "text": "再次。所以，希望我们能如愿以偿。"}, {"type": "subtitle", "time": 2469.309, "timestamp": "00:41:09", "text": "为什么我不能加这个好友？"}, {"type": "subtitle", "time": 2479.03, "timestamp": "00:41:19", "text": "去。只有某个区域是这样的，伙计。你"}, {"type": "subtitle", "time": 2483.15, "timestamp": "00:41:23", "text": "可以随意在建筑物间跳跃，拥有"}, {"type": "subtitle", "time": 2486.15, "timestamp": "00:41:26", "text": "乐趣。我的天哪，我还没碰过……"}, {"type": "subtitle", "time": 2496.47, "timestamp": "00:41:36", "text": "正确的？感觉就像我在扮演一个圣骑士。"}]
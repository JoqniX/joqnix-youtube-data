[{"type": "subtitle", "time": 9300.56, "timestamp": "02:35:00", "text": "你。那里有个……呃……那里有个足球。 我要去拿"}, {"type": "subtitle", "time": 9302.439, "timestamp": "02:35:02", "text": "我要去拿 足球。我的天哪，居然真的有这么个"}, {"type": "subtitle", "time": 9304.88, "timestamp": "02:35:04", "text": "足球。我的天哪，居然真的有这么个 这场比赛中的足球。"}, {"type": "subtitle", "time": 9322.75, "timestamp": "02:35:22", "text": "你。这很有趣。"}, {"type": "subtitle", "time": 9326.15, "timestamp": "02:35:26", "text": "啊，比赛怎么样？它既有趣又恐怖"}, {"type": "subtitle", "time": 9333.79, "timestamp": "02:35:33", "text": "乐趣。希望你能明白，我尽力了。"}, {"type": "subtitle", "time": 9336.71, "timestamp": "02:35:36", "text": "那。但我们赢得了第一场比赛。我赢了。"}, {"type": "subtitle", "time": 9339.59, "timestamp": "02:35:39", "text": "不，上一局我赢了。我的第一款游戏"}, {"type": "subtitle", "time": 9343.07, "timestamp": "02:35:43", "text": "我排队参加了比赛，结果我赢了。"}, {"type": "subtitle", "time": 9351.23, "timestamp": "02:35:51", "text": "方式。决不。迪奥，但我其实"}, {"type": "subtitle", "time": 9354.429, "timestamp": "02:35:54", "text": "韩元。总之，不错。"}]
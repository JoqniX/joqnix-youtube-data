[{"type": "subtitle", "time": 18243.27, "timestamp": "05:04:03", "text": "东西。下一个。这是什么？ E."}, {"type": "subtitle", "time": 18247.23, "timestamp": "05:04:07", "text": "我觉得E就像……"}, {"type": "subtitle", "time": 18250.47, "timestamp": "05:04:10", "text": "你砰砰砰，你得到一些东西或者喜欢"}, {"type": "subtitle", "time": 18253.35, "timestamp": "05:04:13", "text": "你去做个扫描之类的检查。我希望如此"}, {"type": "subtitle", "time": 18256.07, "timestamp": "05:04:16", "text": "是用英语写的。我本可以读懂的"}, {"type": "subtitle", "time": 18259.708, "timestamp": "05:04:19", "text": "我本可以读得更好，但是"}, {"type": "subtitle", "time": 18267.75, "timestamp": "05:04:27", "text": "扩展，但对 B 不起作用"}, {"type": "subtitle", "time": 18273.83, "timestamp": "05:04:33", "text": "好的，这主意不错，是个好办法。"}, {"type": "subtitle", "time": 18277.91, "timestamp": "05:04:37", "text": "理解事物。所以，让我们呃"}, {"type": "subtitle", "time": 18279.91, "timestamp": "05:04:39", "text": "女巫，我认为这是一种离开"}, {"type": "subtitle", "time": 18282.11, "timestamp": "05:04:42", "text": "游戏，对吧？我不能"}, {"type": "subtitle", "time": 18285.83, "timestamp": "05:04:45", "text": "阅读“失明不仅仅意味着……”"}, {"type": "subtitle", "time": 18289.35, "timestamp": "05:04:49", "text": "不仅如此，它只会削弱……"}, {"type": "subtitle", "time": 18292.788, "timestamp": "05:04:52", "text": "就像KJ Alam带来的那样。好的，下一个。"}, {"type": "subtitle", "time": 18295.03, "timestamp": "05:04:55", "text": "我相信这场比赛到此结束了。"}, {"type": "subtitle", "time": 18296.948, "timestamp": "05:04:56", "text": "等等，那场比赛的结局是什么？我"}, {"type": "subtitle", "time": 18298.59, "timestamp": "05:04:58", "text": "不识字。哦"}]
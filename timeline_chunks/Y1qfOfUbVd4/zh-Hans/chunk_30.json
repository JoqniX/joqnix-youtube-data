[{"type": "subtitle", "time": 1803.19, "timestamp": "00:30:03", "text": "那。所以，万一有这种情况的话。"}, {"type": "subtitle", "time": 1805.19, "timestamp": "00:30:05", "text": "任何想尝试这款游戏的人"}, {"type": "subtitle", "time": 1807.029, "timestamp": "00:30:07", "text": "如果你玩过这款游戏的话"}, {"type": "subtitle", "time": 1809.149, "timestamp": "00:30:09", "text": "屏幕好像黑屏了。"}, {"type": "subtitle", "time": 1814.549, "timestamp": "00:30:14", "text": "PC，直接去验证就行了。"}, {"type": "subtitle", "time": 1817.549, "timestamp": "00:30:17", "text": "维护比赛的公正性。照做。核实"}, {"type": "subtitle", "time": 1820.149, "timestamp": "00:30:20", "text": "正直。然后输入启动命令"}, {"type": "subtitle", "time": 1822.549, "timestamp": "00:30:22", "text": "全屏。就是这样。那会有帮助的。"}, {"type": "subtitle", "time": 1841.75, "timestamp": "00:30:41", "text": "某物？运动是怎么回事？"}, {"type": "subtitle", "time": 1842.93, "timestamp": "00:30:42", "text": "工作"}, {"type": "subtitle", "time": 1850.909, "timestamp": "00:30:50", "text": "尽管？我明白了"}]
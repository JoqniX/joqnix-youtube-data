[{"type": "subtitle", "time": 9121.03, "timestamp": "02:32:01", "text": "AKM。我的天啊。漫长赛季后的第一场比赛"}, {"type": "subtitle", "time": 9124.03, "timestamp": "02:32:04", "text": "虽然我赢了。原谅"}, {"type": "subtitle", "time": 9131.11, "timestamp": "02:32:11", "text": "什么？这是什么说法？这是什么？"}, {"type": "subtitle", "time": 9139.63, "timestamp": "02:32:19", "text": "现金箱。什么是"}, {"type": "subtitle", "time": 9143.95, "timestamp": "02:32:23", "text": "这把钥匙？ N拿到了钥匙。"}, {"type": "subtitle", "time": 9150.469, "timestamp": "02:32:30", "text": "什么学分？带我回家。玩一次。"}, {"type": "subtitle", "time": 9154.469, "timestamp": "02:32:34", "text": "玩三次。进入前10名10次。"}, {"type": "subtitle", "time": 9157.51, "timestamp": "02:32:37", "text": "五次。萨巴岛全程60分钟。"}, {"type": "subtitle", "time": 9159.19, "timestamp": "02:32:39", "text": "一段狂野的时光，包括度过的时光"}, {"type": "subtitle", "time": 9162.63, "timestamp": "02:32:42", "text": "观看队友比赛。哦，你可以"}, {"type": "subtitle", "time": 9164.75, "timestamp": "02:32:44", "text": "获得400枚金币。"}, {"type": "subtitle", "time": 9168.11, "timestamp": "02:32:48", "text": "哇。好一个。"}, {"type": "subtitle", "time": 9171.389, "timestamp": "02:32:51", "text": "D. 是的。我们玩"}, {"type": "subtitle", "time": 9175.71, "timestamp": "02:32:55", "text": "再次。我的天啊。是的。哦，我得到了"}, {"type": "subtitle", "time": 9178.95, "timestamp": "02:32:58", "text": "害怕的。抓住。什么？我其实"}]
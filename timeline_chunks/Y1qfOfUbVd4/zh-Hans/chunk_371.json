[{"type": "subtitle", "time": 22262.868, "timestamp": "06:11:02", "text": "关心一下替补队员。但昨天因为"}, {"type": "subtitle", "time": 22265.59, "timestamp": "06:11:05", "text": "大家都向他表示祝贺。我当时"}, {"type": "subtitle", "time": 22268.868, "timestamp": "06:11:08", "text": "像快乐一样。但是，呃，有人有"}, {"type": "subtitle", "time": 22271.35, "timestamp": "06:11:11", "text": "已取消订阅。"}, {"type": "subtitle", "time": 22275.628, "timestamp": "06:11:15", "text": "FBI，开门。我的天哪，我的耳朵。啊，"}, {"type": "subtitle", "time": 22277.948, "timestamp": "06:11:17", "text": "雅虎。我"}, {"type": "subtitle", "time": 22284.91, "timestamp": "06:11:24", "text": "帕利，你好"}, {"type": "subtitle", "time": 22296.19, "timestamp": "06:11:36", "text": "正在做？繁荣。我成了600分。这是什么？"}, {"type": "subtitle", "time": 22300.43, "timestamp": "06:11:40", "text": "向上？他不必"}, {"type": "subtitle", "time": 22304.23, "timestamp": "06:11:44", "text": "死。是的，通常是这样。这就是我主要的原因"}, {"type": "subtitle", "time": 22306.708, "timestamp": "06:11:46", "text": "添加到规则和观众"}, {"type": "subtitle", "time": 22310.23, "timestamp": "06:11:50", "text": "无论如何，这些准则都不应该"}, {"type": "subtitle", "time": 22312.23, "timestamp": "06:11:52", "text": "告诉我谁更像是多少"}, {"type": "subtitle", "time": 22314.83, "timestamp": "06:11:54", "text": "人们都在看着，你知道，Subcon"}]
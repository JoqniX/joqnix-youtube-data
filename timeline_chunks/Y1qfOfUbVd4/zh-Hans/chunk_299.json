[{"type": "subtitle", "time": 17941.43, "timestamp": "04:59:01", "text": "我不知道里面的人是谁，但我就是想"}, {"type": "subtitle", "time": 17943.55, "timestamp": "04:59:03", "text": "放松一下，喜欢"}, {"type": "subtitle", "time": 17947.83, "timestamp": "04:59:07", "text": "嗯，你用异丙醇去皮。哦，怎么做？"}, {"type": "subtitle", "time": 17952.19, "timestamp": "04:59:12", "text": "怎么念他的名字？是的。对，就是这个人。"}, {"type": "subtitle", "time": 17954.868, "timestamp": "04:59:14", "text": "嗯。是的。你好，阿迪蒂。欢迎，欢迎。"}, {"type": "subtitle", "time": 17957.91, "timestamp": "04:59:17", "text": "希望你一切都好。我正在前往"}, {"type": "subtitle", "time": 17959.23, "timestamp": "04:59:19", "text": "医院"}, {"type": "subtitle", "time": 17962.27, "timestamp": "04:59:22", "text": "外科手术。你好。谢谢光临"}, {"type": "subtitle", "time": 17966.868, "timestamp": "04:59:26", "text": "阿山。祝你今天过得愉快！"}, {"type": "subtitle", "time": 17968.99, "timestamp": "04:59:28", "text": "前方。好的。祝你好运！"}, {"type": "subtitle", "time": 17972.47, "timestamp": "04:59:32", "text": "外科手术。我在为你祈祷。做"}, {"type": "subtitle", "time": 17974.03, "timestamp": "04:59:34", "text": "尽你所能。好的。"}, {"type": "subtitle", "time": 17977.19, "timestamp": "04:59:37", "text": "来。嗯。希望一切顺利。"}, {"type": "subtitle", "time": 17980.39, "timestamp": "04:59:40", "text": "是的。你好，Aditi。阿迪达斯怎么样了？"}, {"type": "subtitle", "time": 17983.07, "timestamp": "04:59:43", "text": "希望你一切都好。"}, {"type": "subtitle", "time": 17986.07, "timestamp": "04:59:46", "text": "雅虎。好了，废话不多说，"}, {"type": "subtitle", "time": 17987.83, "timestamp": "04:59:47", "text": "我知道我一直停留在加载界面。"}, {"type": "subtitle", "time": 17989.67, "timestamp": "04:59:49", "text": "稍微晚了一点。我大概8岁"}, {"type": "subtitle", "time": 17994.39, "timestamp": "04:59:54", "text": "几分钟过去了。那么，让我们进入正题吧。"}, {"type": "subtitle", "time": 17996.27, "timestamp": "04:59:56", "text": "游戏。好的。"}]
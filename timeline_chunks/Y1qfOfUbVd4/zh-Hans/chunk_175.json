[{"type": "subtitle", "time": 10520.55, "timestamp": "02:55:20", "text": "兄弟。我打你了。我攻击了你。我击中"}, {"type": "subtitle", "time": 10527.11, "timestamp": "02:55:27", "text": "啊，没关系。我们能搞定。我们能搞定。"}, {"type": "subtitle", "time": 10530.79, "timestamp": "02:55:30", "text": "我尽量远离那个人。"}, {"type": "subtitle", "time": 10537.95, "timestamp": "02:55:37", "text": "D. 我比他更擅长玩游戏"}, {"type": "subtitle", "time": 10551.79, "timestamp": "02:55:51", "text": "啊，我杀了"}, {"type": "subtitle", "time": 10553.55, "timestamp": "02:55:53", "text": "你。"}, {"type": "subtitle", "time": 10556.87, "timestamp": "02:55:56", "text": "安息。感谢您的付出。你是"}]
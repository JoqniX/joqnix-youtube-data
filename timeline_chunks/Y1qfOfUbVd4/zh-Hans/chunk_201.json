[{"type": "subtitle", "time": 12062.429, "timestamp": "03:21:02", "text": "呃，我觉得我的"}, {"type": "subtitle", "time": 12066.429, "timestamp": "03:21:06", "text": "最佳行动选择是"}, {"type": "subtitle", "time": 12068.269, "timestamp": "03:21:08", "text": "到"}, {"type": "subtitle", "time": 12071.91, "timestamp": "03:21:11", "text": "好的，没问题。我这就去房子里。"}, {"type": "subtitle", "time": 12076.229, "timestamp": "03:21:16", "text": "然后搜刮战利品并痛扁他。"}, {"type": "subtitle", "time": 12081.03, "timestamp": "03:21:21", "text": "你好。呃呃，我呃，我是……让我先……"}, {"type": "subtitle", "time": 12083.59, "timestamp": "03:21:23", "text": "说出来。如果我误解了你的意思，我深感抱歉。"}, {"type": "subtitle", "time": 12089.15, "timestamp": "03:21:29", "text": "姓名。欢迎来到直播间。萨克·保罗"}, {"type": "subtitle", "time": 12092.75, "timestamp": "03:21:32", "text": "欢迎。希望你一切都好。"}, {"type": "subtitle", "time": 12095.67, "timestamp": "03:21:35", "text": "你好。我相信这是你的第一次"}, {"type": "subtitle", "time": 12098.269, "timestamp": "03:21:38", "text": "时间到了。你是怎么找到我的"}, {"type": "subtitle", "time": 12115.71, "timestamp": "03:21:55", "text": "好的，我们从这里加载。"}]
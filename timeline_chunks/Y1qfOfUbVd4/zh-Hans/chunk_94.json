[{"type": "subtitle", "time": 5643.149, "timestamp": "01:34:03", "text": "今天祝您周四晚上愉快！"}, {"type": "subtitle", "time": 5647.51, "timestamp": "01:34:07", "text": "前方。非常非常感谢，愿……"}, {"type": "subtitle", "time": 5651.99, "timestamp": "01:34:11", "text": "星光指引你。愿你……"}, {"type": "subtitle", "time": 5654.39, "timestamp": "01:34:14", "text": "今天睡得很好，做了个美梦。"}, {"type": "subtitle", "time": 5657.59, "timestamp": "01:34:17", "text": "东西。愿星辰今天保佑你。好的"}, {"type": "subtitle", "time": 5660.31, "timestamp": "01:34:20", "text": "明天好运，即便只是"}, {"type": "subtitle", "time": 5663.35, "timestamp": "01:34:23", "text": "对其他人来说，晚上或早上是其他人。"}, {"type": "subtitle", "time": 5666.149, "timestamp": "01:34:26", "text": "其他时区的人也请享受你们的……"}, {"type": "subtitle", "time": 5669.51, "timestamp": "01:34:29", "text": "星期四即将到来。好的。你好。晚安。"}]
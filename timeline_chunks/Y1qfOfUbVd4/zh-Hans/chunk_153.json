[{"type": "subtitle", "time": 9182.75, "timestamp": "02:33:02", "text": "说实话，我超棒"}, {"type": "subtitle", "time": 9185.51, "timestamp": "02:33:05", "text": "有时会感到害怕。不，这些游戏可以"}, {"type": "subtitle", "time": 9188.63, "timestamp": "02:33:08", "text": "让你觉得这有点像恐怖片。"}, {"type": "subtitle", "time": 9191.59, "timestamp": "02:33:11", "text": "就像你知道你是唯一活着的人一样"}, {"type": "subtitle", "time": 9193.83, "timestamp": "02:33:13", "text": "你知道你是独一无二的。"}, {"type": "subtitle", "time": 9196.71, "timestamp": "02:33:16", "text": "人生只有一次，你必须活下去。"}, {"type": "subtitle", "time": 9198.79, "timestamp": "02:33:18", "text": "如果你有队友的话，我就会……"}, {"type": "subtitle", "time": 9201.51, "timestamp": "02:33:21", "text": "就像，是的，你会检查我的，你会说"}, {"type": "subtitle", "time": 9204.389, "timestamp": "02:33:24", "text": "保护我的后背什么的，但是这里"}, {"type": "subtitle", "time": 9207.63, "timestamp": "02:33:27", "text": "就像"}, {"type": "subtitle", "time": 9210.51, "timestamp": "02:33:30", "text": "是啊，你得独自求生。"}, {"type": "subtitle", "time": 9220.59, "timestamp": "02:33:40", "text": "疼痛。嗯，该怎么做？"}, {"type": "subtitle", "time": 9229.59, "timestamp": "02:33:49", "text": "一。我甚至还有可视距离"}, {"type": "subtitle", "time": 9238.59, "timestamp": "02:33:58", "text": "[音乐]"}]
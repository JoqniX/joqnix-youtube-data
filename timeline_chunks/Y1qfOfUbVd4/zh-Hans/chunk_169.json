[{"type": "subtitle", "time": 10140.19, "timestamp": "02:49:00", "text": "他们得不到"}, {"type": "subtitle", "time": 10142.269, "timestamp": "02:49:02", "text": "任何事物。"}, {"type": "subtitle", "time": 10147.83, "timestamp": "02:49:07", "text": "买五件就能用上优惠券。好的。"}, {"type": "subtitle", "time": 10150.309, "timestamp": "02:49:10", "text": "我需要了解的问题是，上限是15"}, {"type": "subtitle", "time": 10152.349, "timestamp": "02:49:12", "text": "休闲模式下持续几分钟。我在……"}, {"type": "subtitle", "time": 10156.19, "timestamp": "02:49:16", "text": "长按普通模式，然后使用"}, {"type": "subtitle", "time": 10159.469, "timestamp": "02:49:19", "text": "航行。好的。游戏"}, {"type": "subtitle", "time": 10163.349, "timestamp": "02:49:23", "text": "模式。好的。"}, {"type": "subtitle", "time": 10165.469, "timestamp": "02:49:25", "text": "嗯，10"}, {"type": "subtitle", "time": 10168.75, "timestamp": "02:49:28", "text": "可用积分"}, {"type": "subtitle", "time": 10171.349, "timestamp": "02:49:31", "text": "积分。被困飞行员套装。什么是"}, {"type": "subtitle", "time": 10174.71, "timestamp": "02:49:34", "text": "那？哦，你明白我的意思。哦，我想"}, {"type": "subtitle", "time": 10176.75, "timestamp": "02:49:36", "text": "得到"}, {"type": "subtitle", "time": 10186.07, "timestamp": "02:49:46", "text": "凉爽的。让我去拿我的水。好吧，"}, {"type": "subtitle", "time": 10188.94, "timestamp": "02:49:48", "text": "我一会儿就回来。"}, {"type": "subtitle", "time": 10193.79, "timestamp": "02:49:53", "text": "什么"}, {"type": "subtitle", "time": 10197.269, "timestamp": "02:49:57", "text": "在那之前，让它痊愈吧。"}, {"type": "subtitle", "time": 10199.59, "timestamp": "02:49:59", "text": "让我变得可爱点，是的，我正在变得"}]
[{"type": "subtitle", "time": 21901.35, "timestamp": "06:05:01", "text": "有些东西好像有动画效果。"}, {"type": "subtitle", "time": 21904.07, "timestamp": "06:05:04", "text": "原因。"}, {"type": "subtitle", "time": 21916.19, "timestamp": "06:05:16", "text": "出去？零号凤凰"}, {"type": "subtitle", "time": 21919.91, "timestamp": "06:05:19", "text": "皮尼。好的。你做了多少个？"}, {"type": "subtitle", "time": 21922.47, "timestamp": "06:05:22", "text": "你做完了吗？所以，呃，有"}, {"type": "subtitle", "time": 21924.23, "timestamp": "06:05:24", "text": "目前有五个模组"}, {"type": "subtitle", "time": 21926.31, "timestamp": "06:05:26", "text": "片刻。我不希望他们所有人都……"}, {"type": "subtitle", "time": 21928.31, "timestamp": "06:05:28", "text": "模。我只想切换开关"}, {"type": "subtitle", "time": 21931.11, "timestamp": "06:05:31", "text": "你知道，他们一旦放纵自己，就会变得很放荡。"}, {"type": "subtitle", "time": 21933.51, "timestamp": "06:05:33", "text": "是的。是的。是的。没有什么需要修改的。"}, {"type": "subtitle", "time": 21935.59, "timestamp": "06:05:35", "text": "尽管。只有在特定情况下才会发生。"}, {"type": "subtitle", "time": 21938.15, "timestamp": "06:05:38", "text": "就这样。他们之中，有一个人可以做到。"}]
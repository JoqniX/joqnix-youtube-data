[{"type": "subtitle", "time": 601.71, "timestamp": "00:10:01", "text": "问题？什么？"}, {"type": "subtitle", "time": 617.269, "timestamp": "00:10:17", "text": "好的。而我指的是正在调查的这个问题。"}, {"type": "subtitle", "time": 619.43, "timestamp": "00:10:19", "text": "屏幕。你好吗？哦好的。好的。"}, {"type": "subtitle", "time": 622.87, "timestamp": "00:10:22", "text": "是的。我昨天不，我等我，我曾是"}, {"type": "subtitle", "time": 625.03, "timestamp": "00:10:25", "text": "玩……呃，不是昨天前一天"}, {"type": "subtitle", "time": 626.75, "timestamp": "00:10:26", "text": "昨天我在玩游戏"}, {"type": "subtitle", "time": 630.59, "timestamp": "00:10:30", "text": "粉碎它叫什么来着？哦"}, {"type": "subtitle", "time": 633.87, "timestamp": "00:10:33", "text": "上帝嘘呃塞弗"}, {"type": "subtitle", "time": 636.949, "timestamp": "00:10:36", "text": "所以我一直在寻找快节奏的钢铁"}, {"type": "subtitle", "time": 639.99, "timestamp": "00:10:39", "text": "我在少数几款游戏中都发现了这种感觉。"}, {"type": "subtitle", "time": 643.269, "timestamp": "00:10:43", "text": "所以我当时……呃，我现在试过了"}, {"type": "subtitle", "time": 646.389, "timestamp": "00:10:46", "text": "是的，看起来很有趣，没什么不好的。"}, {"type": "subtitle", "time": 649.31, "timestamp": "00:10:49", "text": "这款游戏的乐趣在于你可以像palpour一样……"}, {"type": "subtitle", "time": 653.87, "timestamp": "00:10:53", "text": "看起来很有趣的事情"}]
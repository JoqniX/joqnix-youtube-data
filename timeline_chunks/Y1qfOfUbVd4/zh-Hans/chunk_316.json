[{"type": "subtitle", "time": 18962.788, "timestamp": "05:16:02", "text": "欺骗者？让我查一下。呃，有"}, {"type": "subtitle", "time": 18966.07, "timestamp": "05:16:06", "text": "没有任何更新。好的。所以，我认为我们"}, {"type": "subtitle", "time": 18969.35, "timestamp": "05:16:09", "text": "我们可以像……呃，我想你……"}, {"type": "subtitle", "time": 18971.19, "timestamp": "05:16:11", "text": "请再次更新显卡驱动程序？"}, {"type": "subtitle", "time": 18973.39, "timestamp": "05:16:13", "text": "是的，我做了。我做了。我"}, {"type": "subtitle", "time": 18975.67, "timestamp": "05:16:15", "text": "做过。现在，这让朋友……"}, {"type": "subtitle", "time": 18976.948, "timestamp": "05:16:16", "text": "消失。我认为这是因为……"}, {"type": "subtitle", "time": 18979.27, "timestamp": "05:16:19", "text": "有新的更新之类的。我不知道。"}, {"type": "subtitle", "time": 18994.15, "timestamp": "05:16:34", "text": "嗯，魔鬼最近怎么样？怎么样？"}, {"type": "subtitle", "time": 18997.868, "timestamp": "05:16:37", "text": "jama 正在做什么？怎么样？"}, {"type": "subtitle", "time": 19001.03, "timestamp": "05:16:41", "text": "正在做？大家都过得很好吗？"}, {"type": "subtitle", "time": 19002.91, "timestamp": "05:16:42", "text": "你十一月过得怎么样？"}, {"type": "subtitle", "time": 19006.55, "timestamp": "05:16:46", "text": "第一？已经没有了 已经没有了"}, {"type": "subtitle", "time": 19008.51, "timestamp": "05:16:48", "text": "可怕的事情。它是"}, {"type": "subtitle", "time": 19011.99, "timestamp": "05:16:51", "text": "十一月，每个人都自由了"}, {"type": "subtitle", "time": 19014.55, "timestamp": "05:16:54", "text": "恐怖题材等等。最后"}, {"type": "subtitle", "time": 19017.15, "timestamp": "05:16:57", "text": "你是自由的。它是"}, {"type": "subtitle", "time": 19019.31, "timestamp": "05:16:59", "text": "自由。它是"}]
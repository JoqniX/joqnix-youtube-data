[{"type": "subtitle", "time": 22405.27, "timestamp": "06:13:25", "text": "女王，你身上有吸血鬼咬痕。"}, {"type": "subtitle", "time": 22406.948, "timestamp": "06:13:26", "text": "妈妈。哦，不，不，不，不，不。那不是"}, {"type": "subtitle", "time": 22408.59, "timestamp": "06:13:28", "text": "吸血鬼"}, {"type": "subtitle", "time": 22412.35, "timestamp": "06:13:32", "text": "咬。那是我的身份识别标记。"}, {"type": "subtitle", "time": 22416.948, "timestamp": "06:13:36", "text": "现实生活中的事。我真的有三个呃呃"}, {"type": "subtitle", "time": 22420.39, "timestamp": "06:13:40", "text": "像鼹鼠身上那种东西，呃，就像一块补丁。"}, {"type": "subtitle", "time": 22422.11, "timestamp": "06:13:42", "text": "像黑色"}, {"type": "subtitle", "time": 22423.948, "timestamp": "06:13:43", "text": "东西。"}, {"type": "subtitle", "time": 22428.628, "timestamp": "06:13:48", "text": "所以我想把我的现实生活融合起来"}]
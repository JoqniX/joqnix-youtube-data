[{"type": "subtitle", "time": 7869.03, "timestamp": "02:11:09", "text": "敌人的镰刀。这就是我的切法。"}, {"type": "subtitle", "time": 7870.03, "timestamp": "02:11:10", "text": "你的脖子"}, {"type": "subtitle", "time": 7873.79, "timestamp": "02:11:13", "text": "向上而不是用撬棍。乌鸦叫"}, {"type": "subtitle", "time": 7876.51, "timestamp": "02:11:16", "text": "撬棍。是的。"}, {"type": "subtitle", "time": 7879.35, "timestamp": "02:11:19", "text": "嗯，镰刀。我选镰刀酱。"}, {"type": "subtitle", "time": 7883.109, "timestamp": "02:11:23", "text": "好的。我可以把它拿走吗？哦，那"}, {"type": "subtitle", "time": 7885.35, "timestamp": "02:11:25", "text": "镰刀进来了。哦，这是镰刀。我当时想"}, {"type": "subtitle", "time": 7888.149, "timestamp": "02:11:28", "text": "那是一把镰刀。哦，没事了。哦，呃，"}, {"type": "subtitle", "time": 7890.51, "timestamp": "02:11:30", "text": "失望的"}, {"type": "subtitle", "time": 7894.55, "timestamp": "02:11:34", "text": "噪音。我的天哪。枪。向量。是"}, {"type": "subtitle", "time": 7902.31, "timestamp": "02:11:42", "text": "VSS。 VSS。看起来像个狙击手"}, {"type": "subtitle", "time": 7904.629, "timestamp": "02:11:44", "text": "尽管。"}, {"type": "subtitle", "time": 7906.35, "timestamp": "02:11:46", "text": "你走路的样子像个"}, {"type": "subtitle", "time": 7913.91, "timestamp": "02:11:53", "text": "步行。谁在那儿开枪？我不能"}, {"type": "subtitle", "time": 7919.39, "timestamp": "02:11:59", "text": "看？"}]
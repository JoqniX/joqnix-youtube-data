[{"type": "subtitle", "time": 6121.47, "timestamp": "01:42:01", "text": "不要。但它是"}, {"type": "subtitle", "time": 6123.31, "timestamp": "01:42:03", "text": "好的。是的。"}, {"type": "subtitle", "time": 6127.03, "timestamp": "01:42:07", "text": "我们等等看它什么时候出现。哦，"}, {"type": "subtitle", "time": 6131.99, "timestamp": "01:42:11", "text": "等待。那是我。太大了。"}, {"type": "subtitle", "time": 6134.99, "timestamp": "01:42:14", "text": "等等，我没调整好吗？"}, {"type": "subtitle", "time": 6137.669, "timestamp": "01:42:17", "text": "这？我是不是没调整好？"}, {"type": "subtitle", "time": 6146.95, "timestamp": "01:42:26", "text": "好的，我没有调整它。哦，我知道"}, {"type": "subtitle", "time": 6149.75, "timestamp": "01:42:29", "text": "发生了什么事？哦，我忘了。呃，我"}, {"type": "subtitle", "time": 6153.35, "timestamp": "01:42:33", "text": "我忘了。我搞砸了。"}, {"type": "subtitle", "time": 6155.99, "timestamp": "01:42:35", "text": "这就是原因。我们等等看这件事会如何发展"}, {"type": "subtitle", "time": 6160.229, "timestamp": "01:42:40", "text": "加载。好的。在战场上战斗。"}, {"type": "subtitle", "time": 6162.59, "timestamp": "01:42:42", "text": "我的在哪里？"}, {"type": "subtitle", "time": 6165.189, "timestamp": "01:42:45", "text": "翻译？嗯，我很好。我希望"}, {"type": "subtitle", "time": 6166.55, "timestamp": "01:42:46", "text": "你也做得很好。是的，我是"}, {"type": "subtitle", "time": 6169.79, "timestamp": "01:42:49", "text": "一切顺利。你们都有吗？"}, {"type": "subtitle", "time": 6173.109, "timestamp": "01:42:53", "text": "呃，午餐？如果你那边是下午，那么……"}, {"type": "subtitle", "time": 6175.51, "timestamp": "01:42:55", "text": "你们都吃过午饭了吗？希望你们"}, {"type": "subtitle", "time": 6178.51, "timestamp": "01:42:58", "text": "你吃过午饭了吗？"}]
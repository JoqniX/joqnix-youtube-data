[{"type": "subtitle", "time": 13081.229, "timestamp": "03:38:01", "text": "他在哪里？"}, {"type": "subtitle", "time": 13085.19, "timestamp": "03:38:05", "text": "抢劫？战利品确实存在。我看到了他的尸体，但是他在哪里？"}, {"type": "subtitle", "time": 13094.11, "timestamp": "03:38:14", "text": "游戏。你"}, {"type": "subtitle", "time": 13097.75, "timestamp": "03:38:17", "text": "我想要的是战利品，但是，哦，我明白了"}, {"type": "subtitle", "time": 13099.429, "timestamp": "03:38:19", "text": "某人。"}, {"type": "subtitle", "time": 13108.229, "timestamp": "03:38:28", "text": "下一个。哦，那是烟雾弹。你"}, {"type": "subtitle", "time": 13110.389, "timestamp": "03:38:30", "text": "假的。你个笨蛋。那是烟雾弹。"}, {"type": "subtitle", "time": 13112.95, "timestamp": "03:38:32", "text": "你个笨蛋。哦，把你的身体移开。"}, {"type": "subtitle", "time": 13121.03, "timestamp": "03:38:41", "text": "看。我看到了另一个人。我看到一个人"}, {"type": "subtitle", "time": 13127.59, "timestamp": "03:38:47", "text": "[掌声]"}]
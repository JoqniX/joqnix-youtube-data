[{"type": "subtitle", "time": 1924.35, "timestamp": "00:32:04", "text": "不，"}, {"type": "subtitle", "time": 1926.87, "timestamp": "00:32:06", "text": "兄弟。我为什么非得变成这样？"}, {"type": "subtitle", "time": 1938.789, "timestamp": "00:32:18", "text": "太容易了。"}, {"type": "subtitle", "time": 1940.31, "timestamp": "00:32:20", "text": "他去了哪里？他去了哪里？在哪里"}, {"type": "subtitle", "time": 1968.75, "timestamp": "00:32:48", "text": "你。他们为什么落后这么多？"}]
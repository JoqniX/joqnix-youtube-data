[{"type": "subtitle", "time": 15070.15, "timestamp": "04:11:10", "text": "[掌声]"}, {"type": "subtitle", "time": 15074.269, "timestamp": "04:11:14", "text": "我的天哪，我真是太笨了。我杀了"}, {"type": "subtitle", "time": 15076.99, "timestamp": "04:11:16", "text": "我杀了我"}, {"type": "subtitle", "time": 15095.229, "timestamp": "04:11:35", "text": "呃，你休息一下"}, {"type": "subtitle", "time": 15097.55, "timestamp": "04:11:37", "text": "挂机的人。"}, {"type": "subtitle", "time": 15102.87, "timestamp": "04:11:42", "text": "哦，不。我杀了我的队友。好的。我"}, {"type": "subtitle", "time": 15105.189, "timestamp": "04:11:45", "text": "可以看出这只狗嗜血成性。"}, {"type": "subtitle", "time": 15106.429, "timestamp": "04:11:46", "text": "总是"}, {"type": "subtitle", "time": 15109.189, "timestamp": "04:11:49", "text": "说。你好呀。感谢观看"}, {"type": "subtitle", "time": 15113.189, "timestamp": "04:11:53", "text": "竖着的那个。竖着的东西。希望"}]
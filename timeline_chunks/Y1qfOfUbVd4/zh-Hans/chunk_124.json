[{"type": "subtitle", "time": 7448.75, "timestamp": "02:04:08", "text": "我的我"}, {"type": "subtitle", "time": 7451.589, "timestamp": "02:04:11", "text": "不能。是的，我被狠狠地打了一巴掌。"}, {"type": "subtitle", "time": 7457.43, "timestamp": "02:04:17", "text": "好的。我不会失败，我不会跌倒。我"}, {"type": "subtitle", "time": 7476.47, "timestamp": "02:04:36", "text": "射击。他在哪儿？他在哪儿？在哪里？"}, {"type": "subtitle", "time": 7493.53, "timestamp": "02:04:53", "text": "哦，你签名"}]
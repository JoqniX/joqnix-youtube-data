[{"type": "subtitle", "time": 22697.628, "timestamp": "06:18:17", "text": "呃，该说什么呢？呃，这很……"}, {"type": "subtitle", "time": 22700.628, "timestamp": "06:18:20", "text": "这里那里。语法错误全部"}, {"type": "subtitle", "time": 22703.35, "timestamp": "06:18:23", "text": "到处都是。我认为这是因为"}, {"type": "subtitle", "time": 22705.19, "timestamp": "06:18:25", "text": "我最近看了很多动漫，"}, {"type": "subtitle", "time": 22708.19, "timestamp": "06:18:28", "text": "同时消费日本内容"}, {"type": "subtitle", "time": 22713.59, "timestamp": "06:18:33", "text": "我已经能够理解什么"}, {"type": "subtitle", "time": 22715.83, "timestamp": "06:18:35", "text": "另一个人是。我是一个好人"}, {"type": "subtitle", "time": 22718.07, "timestamp": "06:18:38", "text": "听众。没关系。这就是我能做的。"}, {"type": "subtitle", "time": 22720.31, "timestamp": "06:18:40", "text": "说。不明白其他是什么意思"}, {"type": "subtitle", "time": 22722.15, "timestamp": "06:18:42", "text": "那个人用日语说话，但我"}, {"type": "subtitle", "time": 22723.948, "timestamp": "06:18:43", "text": "不会读写"}, {"type": "subtitle", "time": 22727.03, "timestamp": "06:18:47", "text": "令人遗憾。但我正在努力做到这一点。我是"}, {"type": "subtitle", "time": 22730.39, "timestamp": "06:18:50", "text": "就像试图追溯我走过的路一样。"}, {"type": "subtitle", "time": 22732.948, "timestamp": "06:18:52", "text": "即使没有学习日语，他也能学会。"}, {"type": "subtitle", "time": 22736.27, "timestamp": "06:18:56", "text": "真正学会它的那一刻。"}, {"type": "subtitle", "time": 22739.43, "timestamp": "06:18:59", "text": "嗯，中文，特别是普通话，因为我"}]
[{"type": "subtitle", "time": 13321.67, "timestamp": "03:42:01", "text": "好的。这只蛞蝓很短。是的。有点儿。"}, {"type": "subtitle", "time": 13323.19, "timestamp": "03:42:03", "text": "是的。是的。是的。你说得对。你是"}, {"type": "subtitle", "time": 13329.61, "timestamp": "03:42:09", "text": "好吧，也许吧。我在这里"}, {"type": "subtitle", "time": 13330.91, "timestamp": "03:42:10", "text": "[音乐]"}, {"type": "subtitle", "time": 13333.83, "timestamp": "03:42:13", "text": "来。我打算玩霓虹灯类型或"}, {"type": "subtitle", "time": 13340.87, "timestamp": "03:42:20", "text": "左轮手枪？我选汤姆逊冲锋枪。"}, {"type": "subtitle", "time": 13349.15, "timestamp": "03:42:29", "text": "[音乐]"}, {"type": "subtitle", "time": 13351.91, "timestamp": "03:42:31", "text": "枪。我该如何卸载它？我不想"}, {"type": "subtitle", "time": 13353.83, "timestamp": "03:42:33", "text": "但我不想成为那个抓住它的人。"}, {"type": "subtitle", "time": 13365.79, "timestamp": "03:42:45", "text": "我把他打倒了"}, {"type": "subtitle", "time": 13377.389, "timestamp": "03:42:57", "text": "[掌声]"}]
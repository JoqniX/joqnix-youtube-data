[{"type": "subtitle", "time": 4698.709, "timestamp": "01:18:18", "text": "琼，你好。你好。欢迎来到"}, {"type": "subtitle", "time": 4700.79, "timestamp": "01:18:20", "text": "溪流。希望你一切都好。"}, {"type": "subtitle", "time": 4702.31, "timestamp": "01:18:22", "text": "一切都好吗？是的，一切都是"}, {"type": "subtitle", "time": 4705.75, "timestamp": "01:18:25", "text": "好的。我们玩完了游戏。呃，"}, {"type": "subtitle", "time": 4709.11, "timestamp": "01:18:29", "text": "战斗大师。我们结束了游戏。"}, {"type": "subtitle", "time": 4711.189, "timestamp": "01:18:31", "text": "正在收尾阶段。所以，就像"}, {"type": "subtitle", "time": 4712.95, "timestamp": "01:18:32", "text": "我们就像在体验不同的游戏一样。"}, {"type": "subtitle", "time": 4714.35, "timestamp": "01:18:34", "text": "到"}, {"type": "subtitle", "time": 4717.669, "timestamp": "01:18:37", "text": "玩。对，就像第一人称射击游戏里的移动射击一样"}, {"type": "subtitle", "time": 4719.39, "timestamp": "01:18:39", "text": "类型"}, {"type": "subtitle", "time": 4724.51, "timestamp": "01:18:44", "text": "东西终于到了"}, {"type": "subtitle", "time": 4727.51, "timestamp": "01:18:47", "text": "那个东西和它类似"}, {"type": "subtitle", "time": 4729.07, "timestamp": "01:18:49", "text": "喜欢"}, {"type": "subtitle", "time": 4736.99, "timestamp": "01:18:56", "text": "接下来是木马。这是什么？"}]
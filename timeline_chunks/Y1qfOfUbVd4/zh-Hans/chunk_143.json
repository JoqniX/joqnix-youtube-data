[{"type": "subtitle", "time": 8595.87, "timestamp": "02:23:15", "text": "我？我知道我是在公开场合，但这……"}, {"type": "subtitle", "time": 8603.349, "timestamp": "02:23:23", "text": "医生，你甚至都无法穿过它射击。"}, {"type": "subtitle", "time": 8615.55, "timestamp": "02:23:35", "text": "你在开玩笑吧？这款游戏"}, {"type": "subtitle", "time": 8618.349, "timestamp": "02:23:38", "text": "是"}, {"type": "subtitle", "time": 8624.19, "timestamp": "02:23:44", "text": "哑的。处决我。我正在拍摄。"}, {"type": "subtitle", "time": 8626.91, "timestamp": "02:23:46", "text": "好的。"}]
[{"type": "subtitle", "time": 10863.389, "timestamp": "03:01:03", "text": "这是"}, {"type": "subtitle", "time": 10865.87, "timestamp": "03:01:05", "text": "开启自由击杀。如果"}, {"type": "subtitle", "time": 10872.83, "timestamp": "03:01:12", "text": "又来了，"}, {"type": "subtitle", "time": 10876.51, "timestamp": "03:01:16", "text": "再次？我注意到……"}, {"type": "subtitle", "time": 10879.67, "timestamp": "03:01:19", "text": "很多。你的坏盒子在哪儿？我看到你的"}, {"type": "subtitle", "time": 10882.469, "timestamp": "03:01:22", "text": "身体。你的身体并不重要。你的"}, {"type": "subtitle", "time": 10885.87, "timestamp": "03:01:25", "text": "死机对我来说很重要。"}, {"type": "subtitle", "time": 10887.87, "timestamp": "03:01:27", "text": "顿库和"}, {"type": "subtitle", "time": 10891.67, "timestamp": "03:01:31", "text": "顿库。谢谢。谢谢。野猫"}, {"type": "subtitle", "time": 10892.83, "timestamp": "03:01:32", "text": "连帽衫。"}, {"type": "subtitle", "time": 10895.71, "timestamp": "03:01:35", "text": "哦，我穿的是裙子。感谢"}, {"type": "subtitle", "time": 10910.349, "timestamp": "03:01:50", "text": "呃。"}, {"type": "subtitle", "time": 10919.03, "timestamp": "03:01:59", "text": "最后，外汇。谢谢。谢谢。"}]
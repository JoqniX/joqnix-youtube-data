[{"type": "subtitle", "time": 12251.11, "timestamp": "03:24:11", "text": "什么？等等，那不是来自这里吗？"}, {"type": "subtitle", "time": 12254.15, "timestamp": "03:24:14", "text": "哦，这边有人在打架。啊，"}, {"type": "subtitle", "time": 12261.95, "timestamp": "03:24:21", "text": "好的，我们来深入探讨一下。"}, {"type": "subtitle", "time": 12264.79, "timestamp": "03:24:24", "text": "比如算一下。哦，我看到你了。我懂了"}, {"type": "subtitle", "time": 12267.91, "timestamp": "03:24:27", "text": "你。我看见你。呃，在那之前，让我……"}, {"type": "subtitle", "time": 12277.269, "timestamp": "03:24:37", "text": "别走。别走。在哪里？在哪里？ WHO"}, {"type": "subtitle", "time": 12291.83, "timestamp": "03:24:51", "text": "更好的。嗯，是的，我认为这是全球性的。"}, {"type": "subtitle", "time": 12293.91, "timestamp": "03:24:53", "text": "等等，我觉得没有光"}, {"type": "subtitle", "time": 12296.87, "timestamp": "03:24:56", "text": "民意调查。是否有服务器系统？"}]
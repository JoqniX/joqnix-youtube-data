[{"type": "subtitle", "time": 1864.669, "timestamp": "00:31:04", "text": "绿灯，红灯"}, {"type": "subtitle", "time": 1867.64, "timestamp": "00:31:07", "text": "光。然后你跳了下去。"}, {"type": "subtitle", "time": 1869.75, "timestamp": "00:31:09", "text": "[掌声]"}, {"type": "subtitle", "time": 1878.87, "timestamp": "00:31:18", "text": "他可以进去吗？不，别碰它。"}, {"type": "subtitle", "time": 1880.83, "timestamp": "00:31:20", "text": "不要掸灰。不要碰它。"}, {"type": "subtitle", "time": 1894.269, "timestamp": "00:31:34", "text": "嘿，"}]
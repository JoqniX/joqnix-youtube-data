[{"type": "subtitle", "time": 3961.27, "timestamp": "01:06:01", "text": "例如游戏播放列表，"}, {"type": "subtitle", "time": 3962.87, "timestamp": "01:06:02", "text": "正确的？"}, {"type": "subtitle", "time": 3965.99, "timestamp": "01:06:05", "text": "我觉得我可以整理一下这些播放列表。"}, {"type": "subtitle", "time": 3968.47, "timestamp": "01:06:08", "text": "拥有多个流，超过"}, {"type": "subtitle", "time": 3970.87, "timestamp": "01:06:10", "text": "一两条溪流，对吧？我会把它放上去。"}, {"type": "subtitle", "time": 3973.029, "timestamp": "01:06:13", "text": "按降序排列。最高的"}, {"type": "subtitle", "time": 3975.19, "timestamp": "01:06:15", "text": "将会加入游戏播放列表。伟大的"}, {"type": "subtitle", "time": 3977.349, "timestamp": "01:06:17", "text": "游戏播放列表更像是多个"}, {"type": "subtitle", "time": 3980.19, "timestamp": "01:06:20", "text": "播放列表"}, {"type": "subtitle", "time": 3983.349, "timestamp": "01:06:23", "text": "一起。是的。所以我会保持这种状态"}, {"type": "subtitle", "time": 3986.39, "timestamp": "01:06:26", "text": "已失效的游戏播放列表或其他什么东西"}, {"type": "subtitle", "time": 3988.87, "timestamp": "01:06:28", "text": "对于我已消失的游戏，以及"}, {"type": "subtitle", "time": 3990.549, "timestamp": "01:06:30", "text": "不会直播任何类似的东西"}, {"type": "subtitle", "time": 3993.109, "timestamp": "01:06:33", "text": "就是这样。但我也不想"}, {"type": "subtitle", "time": 3996.95, "timestamp": "01:06:36", "text": "请填写我主页上的“呃”部分"}, {"type": "subtitle", "time": 3998.87, "timestamp": "01:06:38", "text": "家庭频道 家庭右 我不想"}, {"type": "subtitle", "time": 4001.589, "timestamp": "01:06:41", "text": "把这里全部填满吧，这是"}, {"type": "subtitle", "time": 4004.15, "timestamp": "01:06:44", "text": "很多，将来我可能还需要"}, {"type": "subtitle", "time": 4005.99, "timestamp": "01:06:45", "text": "提及频道，例如不要访问我的"}, {"type": "subtitle", "time": 4009.95, "timestamp": "01:06:49", "text": "未来会有频道之类的东西，但是"}, {"type": "subtitle", "time": 4013.19, "timestamp": "01:06:53", "text": "是的，我应该创建多个播放列表吗？"}, {"type": "subtitle", "time": 4015.43, "timestamp": "01:06:55", "text": "而不是制作多个"}]
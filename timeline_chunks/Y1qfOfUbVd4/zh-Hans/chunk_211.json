[{"type": "subtitle", "time": 12669.429, "timestamp": "03:31:09", "text": "[音乐]"}, {"type": "subtitle", "time": 12671.67, "timestamp": "03:31:11", "text": "人更多了。砰砰砰砰。我来了"}, {"type": "subtitle", "time": 12673.55, "timestamp": "03:31:13", "text": "到教堂长椅"}, {"type": "subtitle", "time": 12676.91, "timestamp": "03:31:16", "text": "座位。等我。我正要去教堂的长椅上。"}, {"type": "subtitle", "time": 12679.83, "timestamp": "03:31:19", "text": "座位。好的，我将自动运行这个程序。我可能"}, {"type": "subtitle", "time": 12681.07, "timestamp": "03:31:21", "text": "得到"}, {"type": "subtitle", "time": 12684.229, "timestamp": "03:31:24", "text": "在警戒区启动前起床。哦，天哪，我们"}, {"type": "subtitle", "time": 12699.59, "timestamp": "03:31:39", "text": "巴布，你试过苏格兰语和绝地求生吗？"}, {"type": "subtitle", "time": 12708.71, "timestamp": "03:31:48", "text": "之前，但是直播……不，我没有。"}, {"type": "subtitle", "time": 12710.67, "timestamp": "03:31:50", "text": "我没有"}, {"type": "subtitle", "time": 12713.91, "timestamp": "03:31:53", "text": "然而。我的天，禁区要来了。我是"}, {"type": "subtitle", "time": 12718.11, "timestamp": "03:31:58", "text": "死的。我完蛋了。哦，我完蛋了。"}]
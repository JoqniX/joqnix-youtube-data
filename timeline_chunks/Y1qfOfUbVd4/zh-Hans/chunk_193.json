[{"type": "subtitle", "time": 11607.389, "timestamp": "03:13:27", "text": "那里？在哪里？"}, {"type": "subtitle", "time": 11632.91, "timestamp": "03:13:52", "text": "片刻。这个人现在在哪儿？"}, {"type": "subtitle", "time": 11634.59, "timestamp": "03:13:54", "text": "地方？"}, {"type": "subtitle", "time": 11637.51, "timestamp": "03:13:57", "text": "搬迁。我看见你。你确实搬家了。"}]
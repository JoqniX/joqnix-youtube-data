[{"type": "subtitle", "time": 6189.43, "timestamp": "01:43:09", "text": "呃，好的。这样应该就可以了。"}, {"type": "subtitle", "time": 6192.47, "timestamp": "01:43:12", "text": "你看到翻译了吗？是的，你确实"}, {"type": "subtitle", "time": 6198.99, "timestamp": "01:43:18", "text": "好的。哦，等等。这东西就像"}, {"type": "subtitle", "time": 6203.35, "timestamp": "01:43:23", "text": "嗯，我忘了。但对于《绝地求生》来说，这东西呃"}, {"type": "subtitle", "time": 6207.669, "timestamp": "01:43:27", "text": "就像在那边一样。不，是"}, {"type": "subtitle", "time": 6210.87, "timestamp": "01:43:30", "text": "音频正确。好的，那就好。你是"}, {"type": "subtitle", "time": 6212.55, "timestamp": "01:43:32", "text": "是单人出行还是和斯科特一起？当然要去"}, {"type": "subtitle", "time": 6220.709, "timestamp": "01:43:40", "text": "我打算独自完成。当然，这是"}, {"type": "subtitle", "time": 6224.35, "timestamp": "01:43:44", "text": "我打算一个人去。我独自一人"}, {"type": "subtitle", "time": 6228.51, "timestamp": "01:43:48", "text": "团伙。呃，我是独奏。"}, {"type": "subtitle", "time": 6230.95, "timestamp": "01:43:50", "text": "团伙。哦，等等。呃，我忘了。呃"}, {"type": "subtitle", "time": 6234.83, "timestamp": "01:43:54", "text": "昨天我没完全完成。"}, {"type": "subtitle", "time": 6238.229, "timestamp": "01:43:58", "text": "呃，昨天我没能完全完成我的"}]
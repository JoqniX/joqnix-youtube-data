[{"type": "subtitle", "time": 18000.07, "timestamp": "05:00:00", "text": "你好。所以，是的，我的确改变了我的"}, {"type": "subtitle", "time": 18002.11, "timestamp": "05:00:02", "text": "瓦莱兰特"}, {"type": "subtitle", "time": 18005.19, "timestamp": "05:00:05", "text": "日本人。我从来没和日本人玩过。"}, {"type": "subtitle", "time": 18008.55, "timestamp": "05:00:08", "text": "缬草。所以我决定这么做。"}, {"type": "subtitle", "time": 18022.948, "timestamp": "05:00:22", "text": "任何事物。是的，这就是新的"}, {"type": "subtitle", "time": 18025.03, "timestamp": "05:00:25", "text": "如您所见，左侧的代理人"}, {"type": "subtitle", "time": 18027.67, "timestamp": "05:00:27", "text": "这是新来的代理人，他/她将……"}, {"type": "subtitle", "time": 18029.91, "timestamp": "05:00:29", "text": "玩耍之类的。我希望我们能玩。"}, {"type": "subtitle", "time": 18033.35, "timestamp": "05:00:33", "text": "他，因为我的确有公开的游戏通行证。"}, {"type": "subtitle", "time": 18036.39, "timestamp": "05:00:36", "text": "我相信我能胜任这个角色。呃，"}, {"type": "subtitle", "time": 18038.948, "timestamp": "05:00:38", "text": "代理人选择界面在哪里？是的，"}, {"type": "subtitle", "time": 18041.47, "timestamp": "05:00:41", "text": "我可以扮演他。"}, {"type": "subtitle", "time": 18043.948, "timestamp": "05:00:43", "text": "是的。"}, {"type": "subtitle", "time": 18045.99, "timestamp": "05:00:45", "text": "等等，等等，等等，等等。什么？什么是"}, {"type": "subtitle", "time": 18048.868, "timestamp": "05:00:48", "text": "这是写的吗？我看不懂字。等等，我可以吗？"}, {"type": "subtitle", "time": 18051.19, "timestamp": "05:00:51", "text": "我能让他上场吗？那是"}, {"type": "subtitle", "time": 18052.19, "timestamp": "05:00:52", "text": "这"}, {"type": "subtitle", "time": 18055.788, "timestamp": "05:00:55", "text": "问题。呃，我可以扮演他，对吧？"}, {"type": "subtitle", "time": 18059.67, "timestamp": "05:00:59", "text": "等等，我有点糊涂了。"}]
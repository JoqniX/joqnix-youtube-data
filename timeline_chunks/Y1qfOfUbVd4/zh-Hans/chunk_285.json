[{"type": "subtitle", "time": 17100.788, "timestamp": "04:45:00", "text": "那里有一些像 YouTuber 那样的人"}, {"type": "subtitle", "time": 17102.708, "timestamp": "04:45:02", "text": "主播们正在玩。所以，我当时就想，"}, {"type": "subtitle", "time": 17105.75, "timestamp": "04:45:05", "text": "“哦好的。”但我注意到一件事"}, {"type": "subtitle", "time": 17107.31, "timestamp": "04:45:07", "text": "他们所有人"}, {"type": "subtitle", "time": 17111.59, "timestamp": "04:45:11", "text": "模糊玩家击杀信息或"}, {"type": "subtitle", "time": 17114.11, "timestamp": "04:45:14", "text": "某物。我不知道为什么会这样"}, {"type": "subtitle", "time": 17118.07, "timestamp": "04:45:18", "text": "确实，这确实是一件事情。顶点，"}, {"type": "subtitle", "time": 17120.15, "timestamp": "04:45:20", "text": "Valerant，还有我得玩的那些游戏。"}, {"type": "subtitle", "time": 17122.19, "timestamp": "04:45:22", "text": "与……相同"}, {"type": "subtitle", "time": 17126.55, "timestamp": "04:45:26", "text": "出色地。不过，到底是哪一个呢？而对于"}, {"type": "subtitle", "time": 17129.59, "timestamp": "04:45:29", "text": "现在是垂直流，所以这条流我"}, {"type": "subtitle", "time": 17131.91, "timestamp": "04:45:31", "text": "本来应该前一天做的。"}, {"type": "subtitle", "time": 17135.19, "timestamp": "04:45:35", "text": "我想应该是昨天吧。嗯，是的，前一天"}, {"type": "subtitle", "time": 17137.03, "timestamp": "04:45:37", "text": "昨天我本应该做这件事。我"}, {"type": "subtitle", "time": 17138.43, "timestamp": "04:45:38", "text": "准备"}, {"type": "subtitle", "time": 17141.35, "timestamp": "04:45:41", "text": "两天前发生的一切。我本该"}, {"type": "subtitle", "time": 17143.99, "timestamp": "04:45:43", "text": "为了直播这个节目，你知道，我们当时"}, {"type": "subtitle", "time": 17146.708, "timestamp": "04:45:46", "text": "应该做什么，比如边看电影边做，或者"}, {"type": "subtitle", "time": 17150.31, "timestamp": "04:45:50", "text": "今天应该能搞定，但这让我很困惑。"}, {"type": "subtitle", "time": 17152.11, "timestamp": "04:45:52", "text": "日程安排被打乱了。"}, {"type": "subtitle", "time": 17155.75, "timestamp": "04:45:55", "text": "向上。呃，即使我们没有固定的"}]
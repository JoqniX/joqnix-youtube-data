[{"type": "subtitle", "time": 2224.15, "timestamp": "00:37:04", "text": "每个人。你好。你好。欢迎各位突袭者。"}, {"type": "subtitle", "time": 2226.99, "timestamp": "00:37:06", "text": "希望你一切顺利"}, {"type": "subtitle", "time": 2229.15, "timestamp": "00:37:09", "text": "出色地。"}, {"type": "subtitle", "time": 2232.31, "timestamp": "00:37:12", "text": "你好。怎么样？哦，等等。是什么游戏？"}, {"type": "subtitle", "time": 2233.39, "timestamp": "00:37:13", "text": "你"}, {"type": "subtitle", "time": 2236.15, "timestamp": "00:37:16", "text": "流媒体？等等，你玩的是什么游戏？"}, {"type": "subtitle", "time": 2239.27, "timestamp": "00:37:19", "text": "流媒体？哦，马罗打耳光。好的。好的。"}, {"type": "subtitle", "time": 2240.349, "timestamp": "00:37:20", "text": "怎么样？"}, {"type": "subtitle", "time": 2250.27, "timestamp": "00:37:30", "text": "比特。欢迎雷·达什。我的名字是"}, {"type": "subtitle", "time": 2254.109, "timestamp": "00:37:34", "text": "楚。很高兴见到你"}]
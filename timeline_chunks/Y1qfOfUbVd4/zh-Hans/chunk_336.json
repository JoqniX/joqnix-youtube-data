[{"type": "subtitle", "time": 20160.39, "timestamp": "05:36:00", "text": "去。我们要砰砰砰砰地开枪"}, {"type": "subtitle", "time": 20161.868, "timestamp": "05:36:01", "text": "做我们的"}, {"type": "subtitle", "time": 20166.47, "timestamp": "05:36:06", "text": "最好的。呃，这是……等等，这是这个"}, {"type": "subtitle", "time": 20168.868, "timestamp": "05:36:08", "text": "可能被低估了。这是"}, {"type": "subtitle", "time": 20172.31, "timestamp": "05:36:12", "text": "竞争的。这是换挡游戏，对吧？"}, {"type": "subtitle", "time": 20174.99, "timestamp": "05:36:14", "text": "呃，好的。转移"}, {"type": "subtitle", "time": 20178.07, "timestamp": "05:36:18", "text": "玩。我应该这样做吗？"}, {"type": "subtitle", "time": 20179.59, "timestamp": "05:36:19", "text": "这是什么来着？第四个是什么？"}, {"type": "subtitle", "time": 20182.75, "timestamp": "05:36:22", "text": "选项？我的天啊。"}, {"type": "subtitle", "time": 20186.35, "timestamp": "05:36:26", "text": "呃，还有什么是我不能做的？我觉得我可以做到"}, {"type": "subtitle", "time": 20189.51, "timestamp": "05:36:29", "text": "这。切换游戏模式。我想我可以做到。哦，"}, {"type": "subtitle", "time": 20191.59, "timestamp": "05:36:31", "text": "等待。什么？我没造汽车"}, {"type": "subtitle", "time": 20193.51, "timestamp": "05:36:33", "text": "即时储物柜。我的天哪。我需要制作"}, {"type": "subtitle", "time": 20195.91, "timestamp": "05:36:35", "text": "是即时储物柜，对吧？哦，等等。我"}, {"type": "subtitle", "time": 20199.83, "timestamp": "05:36:39", "text": "忘了。我忘了。天哪，我忘了。"}, {"type": "subtitle", "time": 20203.27, "timestamp": "05:36:43", "text": "哦，等等。瞬间锁定。等待。嗯。哦"}, {"type": "subtitle", "time": 20204.91, "timestamp": "05:36:44", "text": "上帝。我忘了。我竟然忘了这件事"}, {"type": "subtitle", "time": 20208.27, "timestamp": "05:36:48", "text": "那。呃，我在找什么呢？"}, {"type": "subtitle", "time": 20216.39, "timestamp": "05:36:56", "text": "甲板。我居然把这事忘了。我"}, {"type": "subtitle", "time": 20218.23, "timestamp": "05:36:58", "text": "我忘了这件事了。是啊，我忘了。"}]
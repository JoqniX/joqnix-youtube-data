[{"type": "subtitle", "time": 10320.23, "timestamp": "02:52:00", "text": "好，我们去那儿吧。这个露台"}, {"type": "subtitle", "time": 10326.23, "timestamp": "02:52:06", "text": "东西。基兰。哇，你又得了一个！"}, {"type": "subtitle", "time": 10328.309, "timestamp": "02:52:08", "text": "妻子。什么？"}, {"type": "subtitle", "time": 10331.269, "timestamp": "02:52:11", "text": "阿兰格尔·罗斯，带我回家吧。"}, {"type": "subtitle", "time": 10345.03, "timestamp": "02:52:25", "text": "是的。它看起来很小，就像……"}, {"type": "subtitle", "time": 10346.67, "timestamp": "02:52:26", "text": "看起来很逼真"}, {"type": "subtitle", "time": 10350.19, "timestamp": "02:52:30", "text": "从某种意义上说，它很小。"}, {"type": "subtitle", "time": 10355.429, "timestamp": "02:52:35", "text": "这。我的天哪，我太擅长这个了。"}, {"type": "subtitle", "time": 10357.349, "timestamp": "02:52:37", "text": "但当你落地之后，感觉就像，“哦，我的天哪！”"}]
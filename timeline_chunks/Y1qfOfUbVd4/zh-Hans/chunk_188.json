[{"type": "subtitle", "time": 11284.389, "timestamp": "03:08:04", "text": "活。告诉我它们都关门了。关闭"}, {"type": "subtitle", "time": 11287.03, "timestamp": "03:08:07", "text": "在。"}, {"type": "subtitle", "time": 11294.63, "timestamp": "03:08:14", "text": "什么？我不认为这款游戏有这个功能。"}, {"type": "subtitle", "time": 11298.11, "timestamp": "03:08:18", "text": "尽管。让我查一下。前往此处"}, {"type": "subtitle", "time": 11300.67, "timestamp": "03:08:20", "text": "地方。尽量"}, {"type": "subtitle", "time": 11304.03, "timestamp": "03:08:24", "text": "查看。所以，这会在游戏过程中体现出来。"}, {"type": "subtitle", "time": 11307.75, "timestamp": "03:08:27", "text": "否。默认打孔。是的，应该是这样。"}, {"type": "subtitle", "time": 11309.75, "timestamp": "03:08:29", "text": "这里。运行中的东西，但它不是"}, {"type": "subtitle", "time": 11311.55, "timestamp": "03:08:31", "text": "那里。射击模式，激活"}, {"type": "subtitle", "time": 11322.87, "timestamp": "03:08:42", "text": "我听到了一些动静。我听到了一些动静。我"}, {"type": "subtitle", "time": 11330.67, "timestamp": "03:08:50", "text": "事物。这"}, {"type": "subtitle", "time": 11332.99, "timestamp": "03:08:52", "text": "称呼。谁是"}, {"type": "subtitle", "time": 11336.55, "timestamp": "03:08:56", "text": "它？我的天啊。我的天啊。我正在获得"}]
[{"type": "subtitle", "time": 7744.31, "timestamp": "02:09:04", "text": "嗯哼。哦，等等。我换错了。"}, {"type": "subtitle", "time": 7746.39, "timestamp": "02:09:06", "text": "场景。 H：对不起。哦，那是"}, {"type": "subtitle", "time": 7749.55, "timestamp": "02:09:09", "text": "应该是垂直方向的水流。"}, {"type": "subtitle", "time": 7752.02, "timestamp": "02:09:12", "text": "呃，等等。在哪里？"}, {"type": "subtitle", "time": 7754.75, "timestamp": "02:09:14", "text": "[音乐]"}, {"type": "subtitle", "time": 7756.83, "timestamp": "02:09:16", "text": "那玩意儿？哦，是的"}, {"type": "subtitle", "time": 7760.79, "timestamp": "02:09:20", "text": "好的。我以后再想办法。"}, {"type": "subtitle", "time": 7763.03, "timestamp": "02:09:23", "text": "我的玩家账号没有显示。我是否"}, {"type": "subtitle", "time": 7764.109, "timestamp": "02:09:24", "text": "这样做"}, {"type": "subtitle", "time": 7768.189, "timestamp": "02:09:28", "text": "昨天？我确实这么做了，对吧？但是它在哪里？"}, {"type": "subtitle", "time": 7771.83, "timestamp": "02:09:31", "text": "它？我没做。等等，让我……"}, {"type": "subtitle", "time": 7775.87, "timestamp": "02:09:35", "text": "裁剪此部分以适应垂直方向的文本流。一"}, {"type": "subtitle", "time": 7778.189, "timestamp": "02:09:38", "text": "第二节"}, {"type": "subtitle", "time": 7780.149, "timestamp": "02:09:40", "text": "呃，对于那些正在观看的人来说……"}, {"type": "subtitle", "time": 7781.669, "timestamp": "02:09:41", "text": "垂直流，抱歉。"}, {"type": "subtitle", "time": 7792.149, "timestamp": "02:09:52", "text": "好了，现在我们可以看到有多少人"}, {"type": "subtitle", "time": 7794.149, "timestamp": "02:09:54", "text": "活。呃，我们要去哪儿？我们走吧"}, {"type": "subtitle", "time": 7797.589, "timestamp": "02:09:57", "text": "去那个谷仓。你该怎么去那里？"}]
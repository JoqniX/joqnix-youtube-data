[{"type": "subtitle", "time": 9540.38, "timestamp": "02:39:00", "text": "抢劫"}, {"type": "subtitle", "time": 9542.349, "timestamp": "02:39:02", "text": "[音乐]"}, {"type": "subtitle", "time": 9552.59, "timestamp": "02:39:12", "text": "东西。银。我正在赚钱"}, {"type": "subtitle", "time": 9556.99, "timestamp": "02:39:16", "text": "尽管。这是什么？猎人的"}, {"type": "subtitle", "time": 9564.03, "timestamp": "02:39:24", "text": "牛仔"}, {"type": "subtitle", "time": 9572.19, "timestamp": "02:39:32", "text": "又是钱的事。"}, {"type": "subtitle", "time": 9574.83, "timestamp": "02:39:34", "text": "哇。什么是"}, {"type": "subtitle", "time": 9583.11, "timestamp": "02:39:43", "text": "打印？你可以通过打开这个来创建。嗯？"}, {"type": "subtitle", "time": 9586.11, "timestamp": "02:39:46", "text": "所以，要进行个性化定制。我有这些吗？"}, {"type": "subtitle", "time": 9590.03, "timestamp": "02:39:50", "text": "呃，装备？不，我没有。等待，"}, {"type": "subtitle", "time": 9593.19, "timestamp": "02:39:53", "text": "什么？我搞不懂。我无法获得"}, {"type": "subtitle", "time": 9595.23, "timestamp": "02:39:55", "text": "我刚打开的东西。"}, {"type": "subtitle", "time": 9597.33, "timestamp": "02:39:57", "text": "为什么？这是什么？"}, {"type": "subtitle", "time": 9598.75, "timestamp": "02:39:58", "text": "[音乐]"}]
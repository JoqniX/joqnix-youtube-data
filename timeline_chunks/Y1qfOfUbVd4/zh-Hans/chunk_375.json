[{"type": "subtitle", "time": 22503.67, "timestamp": "06:15:03", "text": "所以，是的，目前，如果你，如果我想要"}, {"type": "subtitle", "time": 22507.19, "timestamp": "06:15:07", "text": "说我不想麻烦自己"}, {"type": "subtitle", "time": 22511.35, "timestamp": "06:15:11", "text": "担心遭到伏击。所以，如果我"}, {"type": "subtitle", "time": 22513.51, "timestamp": "06:15:13", "text": "别担心，我会担心的。"}, {"type": "subtitle", "time": 22516.708, "timestamp": "06:15:16", "text": "非常喜欢。"}, {"type": "subtitle", "time": 22518.19, "timestamp": "06:15:18", "text": "那很糟糕。"}, {"type": "subtitle", "time": 22521.27, "timestamp": "06:15:21", "text": "坏的。嗯。所以我的意思是别担心。"}, {"type": "subtitle", "time": 22524.07, "timestamp": "06:15:24", "text": "关于它。"}, {"type": "subtitle", "time": 22556.07, "timestamp": "06:15:56", "text": "不，不要杀人。别告诉我你是"}, {"type": "subtitle", "time": 22559.708, "timestamp": "06:15:59", "text": "是的，我伸手去杀了他"}]
[{"type": "subtitle", "time": 14160.63, "timestamp": "03:56:00", "text": "休息一下，对吧？因此，我需要"}, {"type": "subtitle", "time": 14168.83, "timestamp": "03:56:08", "text": "我需要确保我"}, {"type": "subtitle", "time": 14171.91, "timestamp": "03:56:11", "text": "不要压力过大，尤其如此。"}, {"type": "subtitle", "time": 14175.189, "timestamp": "03:56:15", "text": "因为我会在Twitch上直播。"}, {"type": "subtitle", "time": 14177.99, "timestamp": "03:56:17", "text": "出色地。"}, {"type": "subtitle", "time": 14187.83, "timestamp": "03:56:27", "text": "但Twitch直播，对吧？"}, {"type": "subtitle", "time": 14190.51, "timestamp": "03:56:30", "text": "我更害怕的是“我的天哪，它”"}, {"type": "subtitle", "time": 14193.07, "timestamp": "03:56:33", "text": "崩溃了。耶，它"}, {"type": "subtitle", "time": 14196.87, "timestamp": "03:56:36", "text": "崩溃了。你是认真的吗？"}, {"type": "subtitle", "time": 14198.51, "timestamp": "03:56:38", "text": "哦，等等。暴动"}, {"type": "subtitle", "time": 14202.469, "timestamp": "03:56:42", "text": "先锋队。哦，游戏运行正常。哦。是的，"}, {"type": "subtitle", "time": 14204.309, "timestamp": "03:56:44", "text": "对于 Twitch 直播来说，就是那一个"}, {"type": "subtitle", "time": 14207.469, "timestamp": "03:56:47", "text": "压力最大"}, {"type": "subtitle", "time": 14210.63, "timestamp": "03:56:50", "text": "因为我需要下载电路板"}, {"type": "subtitle", "time": 14213.87, "timestamp": "03:56:53", "text": "加上聊天记录并把它们放进去"}, {"type": "subtitle", "time": 14216.71, "timestamp": "03:56:56", "text": "一起渲染视频"}, {"type": "subtitle", "time": 14219.63, "timestamp": "03:56:59", "text": "将电路板上传到网上"}]
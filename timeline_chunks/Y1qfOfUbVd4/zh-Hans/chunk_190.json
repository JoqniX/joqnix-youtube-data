[{"type": "subtitle", "time": 11413.469, "timestamp": "03:10:13", "text": "韩。我的天啊，那真是"}, {"type": "subtitle", "time": 11424.309, "timestamp": "03:10:24", "text": "疯狂的。我们目前处于开放状态"}, {"type": "subtitle", "time": 11441.23, "timestamp": "03:10:41", "text": "是的，我明白了。嗯"}, {"type": "subtitle", "time": 11452.19, "timestamp": "03:10:52", "text": "向东并跨过"}]
[{"type": "subtitle", "time": 18900.868, "timestamp": "05:15:00", "text": "好的。呃，你好。我的古董在哪里？"}, {"type": "subtitle", "time": 18903.11, "timestamp": "05:15:03", "text": "幽灵措施？好的，这是什么？"}, {"type": "subtitle", "time": 18910.55, "timestamp": "05:15:10", "text": "呃，海关的样子就是海关的样子。"}, {"type": "subtitle", "time": 18913.11, "timestamp": "05:15:13", "text": "这就是海关人员的样子。但我不能"}, {"type": "subtitle", "time": 18914.67, "timestamp": "05:15:14", "text": "添加"}, {"type": "subtitle", "time": 18918.83, "timestamp": "05:15:18", "text": "你因为你可以"}, {"type": "subtitle", "time": 18933.11, "timestamp": "05:15:33", "text": "破碎的。我不想说我说过我"}, {"type": "subtitle", "time": 18935.67, "timestamp": "05:15:35", "text": "我会用日语来做，所以我必须这么做。"}, {"type": "subtitle", "time": 18941.91, "timestamp": "05:15:41", "text": "你好。你好吗？好的。为什么？"}, {"type": "subtitle", "time": 18944.23, "timestamp": "05:15:44", "text": "这已破了。所以，你是怎么做的？它是"}, {"type": "subtitle", "time": 18945.788, "timestamp": "05:15:45", "text": "出故障了。"}, {"type": "subtitle", "time": 18953.83, "timestamp": "05:15:53", "text": "列表？欺骗的事情发生了。"}, {"type": "subtitle", "time": 18957.15, "timestamp": "05:15:57", "text": "让我看看。暴乱欺骗。是否有新的"}, {"type": "subtitle", "time": 18959.59, "timestamp": "05:15:59", "text": "更新？呃，有新的更新吗？"}]
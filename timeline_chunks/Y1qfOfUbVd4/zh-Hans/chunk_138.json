[{"type": "subtitle", "time": 8282.91, "timestamp": "02:18:02", "text": "我听到了走路的声音"}, {"type": "subtitle", "time": 8286.07, "timestamp": "02:18:06", "text": "更早一些？那个令人毛骨悚然的家伙是谁？"}, {"type": "subtitle", "time": 8294.87, "timestamp": "02:18:14", "text": "更早一些？肯定有人在。"}, {"type": "subtitle", "time": 8303.509, "timestamp": "02:18:23", "text": "你总是这样看待人们吗？"}, {"type": "subtitle", "time": 8328.389, "timestamp": "02:18:48", "text": "哦，这个游戏到底在哪里？"}, {"type": "subtitle", "time": 8330.469, "timestamp": "02:18:50", "text": "没有方向感。我不能"}, {"type": "subtitle", "time": 8332.389, "timestamp": "02:18:52", "text": "理解子弹的含义。它在哪里"}]
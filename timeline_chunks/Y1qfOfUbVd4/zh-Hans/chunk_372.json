[{"type": "subtitle", "time": 22333.43, "timestamp": "06:12:13", "text": "桃。等等，其实……啊，你以为我"}, {"type": "subtitle", "time": 22336.51, "timestamp": "06:12:16", "text": "进行直播。是的。我的天啊。感谢"}, {"type": "subtitle", "time": 22359.27, "timestamp": "06:12:39", "text": "不必如此。不过，谢谢你。我当时"}, {"type": "subtitle", "time": 22360.67, "timestamp": "06:12:40", "text": "尝试"}, {"type": "subtitle", "time": 22362.99, "timestamp": "06:12:42", "text": "我曾拥有的那种人"}, {"type": "subtitle", "time": 22366.47, "timestamp": "06:12:46", "text": "我当时被当作人质扣押了。没有。"}, {"type": "subtitle", "time": 22369.35, "timestamp": "06:12:49", "text": "谁把你当人质了？没有。但"}, {"type": "subtitle", "time": 22371.43, "timestamp": "06:12:51", "text": "是的，我不想强​​迫任何人。"}, {"type": "subtitle", "time": 22374.83, "timestamp": "06:12:54", "text": "替换。好的。或者关注。"}, {"type": "subtitle", "time": 22377.59, "timestamp": "06:12:57", "text": "记住，只有在以下情况下才关注订阅："}, {"type": "subtitle", "time": 22379.31, "timestamp": "06:12:59", "text": "你想要。"}]
[{"type": "subtitle", "time": 18062.15, "timestamp": "05:01:02", "text": "我觉得我可以和他一起玩。我肯定我能做到"}, {"type": "subtitle", "time": 18065.23, "timestamp": "05:01:05", "text": "让他上场。相信"}, {"type": "subtitle", "time": 18067.708, "timestamp": "05:01:07", "text": "这"}, {"type": "subtitle", "time": 18070.47, "timestamp": "05:01:10", "text": "神树。总之，我们进入正题……"}, {"type": "subtitle", "time": 18071.39, "timestamp": "05:01:11", "text": "射击"}, {"type": "subtitle", "time": 18073.91, "timestamp": "05:01:13", "text": "范围。我还没在这个里面看到过这个"}, {"type": "subtitle", "time": 18076.628, "timestamp": "05:01:16", "text": "游戏永不停歇。我不知道如何如何一半"}, {"type": "subtitle", "time": 18084.23, "timestamp": "05:01:24", "text": "作品。是的，我很兴奋。 D. 所以，让我们"}, {"type": "subtitle", "time": 18109.59, "timestamp": "05:01:49", "text": "好的。我试过了，结果也一样。由"}, {"type": "subtitle", "time": 18111.43, "timestamp": "05:01:51", "text": "就这样，我为我爸爸做了一个维克。"}, {"type": "subtitle", "time": 18112.948, "timestamp": "05:01:52", "text": "同事们说：“你的女儿是"}, {"type": "subtitle", "time": 18114.55, "timestamp": "05:01:54", "text": "所以才华横溢。”我说，“我做了一个"}, {"type": "subtitle", "time": 18116.55, "timestamp": "05:01:56", "text": "南瓜灯。”我说：“哇，它真漂亮。”"}, {"type": "subtitle", "time": 18118.47, "timestamp": "05:01:58", "text": "真可爱。”我简直不敢相信自己会这么说。"}]
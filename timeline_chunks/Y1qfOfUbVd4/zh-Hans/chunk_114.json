[{"type": "subtitle", "time": 6841.31, "timestamp": "01:54:01", "text": "[掌声]"}, {"type": "subtitle", "time": 6862.709, "timestamp": "01:54:22", "text": "哦，他发现我了，他简直……"}, {"type": "subtitle", "time": 6864.51, "timestamp": "01:54:24", "text": "刚刚拆除"}, {"type": "subtitle", "time": 6874.83, "timestamp": "01:54:34", "text": "射击。哦，等等。我忘了。我忘了。我"}, {"type": "subtitle", "time": 6894.35, "timestamp": "01:54:54", "text": "等等，为什么我吹不出来？什么？什么？"}, {"type": "subtitle", "time": 6897.709, "timestamp": "01:54:57", "text": "如何？我的天啊。"}]
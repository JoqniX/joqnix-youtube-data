[{"type": "subtitle", "time": 11170.349, "timestamp": "03:06:10", "text": "你看，我在走路"}, {"type": "subtitle", "time": 11173.67, "timestamp": "03:06:13", "text": "再次。我讨厌那样。"}, {"type": "subtitle", "time": 11180.23, "timestamp": "03:06:20", "text": "这就好比没有默认值一样。"}, {"type": "subtitle", "time": 11184.389, "timestamp": "03:06:24", "text": "跑步的默认移动方式是跑步"}, {"type": "subtitle", "time": 11186.67, "timestamp": "03:06:26", "text": "在电子游戏中"}, {"type": "subtitle", "time": 11189.23, "timestamp": "03:06:29", "text": "还有吗？为什么会这样"}, {"type": "subtitle", "time": 11193.83, "timestamp": "03:06:33", "text": "那？那些日子都去哪儿了？"}, {"type": "subtitle", "time": 11196.23, "timestamp": "03:06:36", "text": "我的意思是，这游戏或许会……我并不这么认为。"}, {"type": "subtitle", "time": 11198.67, "timestamp": "03:06:38", "text": "认为它有"}, {"type": "subtitle", "time": 11206.99, "timestamp": "03:06:46", "text": "不过，哦，我们接下来要进入状态了。"}, {"type": "subtitle", "time": 11211.15, "timestamp": "03:06:51", "text": "我觉得在此之前，我应该就……"}, {"type": "subtitle", "time": 11213.389, "timestamp": "03:06:53", "text": "奇亚籽"}, {"type": "subtitle", "time": 11216.83, "timestamp": "03:06:56", "text": "可能并注意"}]
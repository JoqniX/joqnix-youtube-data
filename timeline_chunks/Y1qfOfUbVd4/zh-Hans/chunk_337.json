[{"type": "subtitle", "time": 20224.03, "timestamp": "05:37:04", "text": "好，我们开始吧"}, {"type": "subtitle", "time": 20227.83, "timestamp": "05:37:07", "text": "去。好的。呃，Valerant 特工选择"}, {"type": "subtitle", "time": 20230.948, "timestamp": "05:37:10", "text": "屏幕。我们把呃放进那个锁里。我"}, {"type": "subtitle", "time": 20233.43, "timestamp": "05:37:13", "text": "需要说明的是，我把那个东西放进了死锁里。"}, {"type": "subtitle", "time": 20236.27, "timestamp": "05:37:16", "text": "氖。所以我需要拥有"}, {"type": "subtitle", "time": 20238.91, "timestamp": "05:37:18", "text": "东西"}, {"type": "subtitle", "time": 20241.91, "timestamp": "05:37:21", "text": "因为我需要这些东西。"}, {"type": "subtitle", "time": 20245.35, "timestamp": "05:37:25", "text": "寻找花花公子呃，新个人资料。是的。"}, {"type": "subtitle", "time": 20248.75, "timestamp": "05:37:28", "text": "东西最多的地方在哪里？呃，鼠标"}, {"type": "subtitle", "time": 20253.19, "timestamp": "05:37:33", "text": "地点。好的。按下开始键。我该怎么做？"}, {"type": "subtitle", "time": 20254.51, "timestamp": "05:37:34", "text": "按"}, {"type": "subtitle", "time": 20257.91, "timestamp": "05:37:37", "text": "这？糟糕。等待。我需要吗？还是不需要？"}, {"type": "subtitle", "time": 20259.83, "timestamp": "05:37:39", "text": "需要把它连接到我的键盘上吗？"}]
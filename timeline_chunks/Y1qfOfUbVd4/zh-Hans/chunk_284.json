[{"type": "subtitle", "time": 17040.15, "timestamp": "04:44:00", "text": "绝地求生。我们做到了。谢谢你，Discord"}, {"type": "subtitle", "time": 17042.708, "timestamp": "04:44:02", "text": "寻求。所以，是的，我的意思是，在未来，"}, {"type": "subtitle", "time": 17044.35, "timestamp": "04:44:04", "text": "我可能会玩"}, {"type": "subtitle", "time": 17046.868, "timestamp": "04:44:06", "text": "将来会实现。我能看到自己"}, {"type": "subtitle", "time": 17049.948, "timestamp": "04:44:09", "text": "在遥远的未来玩这款游戏，但是"}, {"type": "subtitle", "time": 17057.91, "timestamp": "04:44:17", "text": "呃，我刚刚意识到，当我摇晃我的"}, {"type": "subtitle", "time": 17066.31, "timestamp": "04:44:26", "text": "原因。但是，我希望你们"}, {"type": "subtitle", "time": 17068.51, "timestamp": "04:44:28", "text": "很喜欢"}, {"type": "subtitle", "time": 17071.43, "timestamp": "04:44:31", "text": "今天。希望你今天过得愉快。享受"}, {"type": "subtitle", "time": 17072.55, "timestamp": "04:44:32", "text": "今天就买。"}, {"type": "subtitle", "time": 17075.11, "timestamp": "04:44:35", "text": "是的，很遗憾，我们不得不把它模糊处理。"}, {"type": "subtitle", "time": 17079.59, "timestamp": "04:44:39", "text": "在旁边，因为你知道平台"}, {"type": "subtitle", "time": 17082.43, "timestamp": "04:44:42", "text": "我必须遵守的规则"}, {"type": "subtitle", "time": 17085.11, "timestamp": "04:44:45", "text": "跟随，某种程度上我必须跟随"}, {"type": "subtitle", "time": 17089.07, "timestamp": "04:44:49", "text": "三个平台都有各自的规则等等。"}, {"type": "subtitle", "time": 17092.948, "timestamp": "04:44:52", "text": "所以，确实要小心。我其实"}, {"type": "subtitle", "time": 17095.27, "timestamp": "04:44:55", "text": "以为 PUBG 在 Billy Bully 被禁了"}, {"type": "subtitle", "time": 17098.07, "timestamp": "04:44:58", "text": "或者别的什么，但当我深入了解之后，"}]
[{"type": "subtitle", "time": 1080.549, "timestamp": "00:18:00", "text": "正确的？"}, {"type": "subtitle", "time": 1081.87, "timestamp": "00:18:01", "text": "喜欢"}, {"type": "subtitle", "time": 1083.87, "timestamp": "00:18:03", "text": "什么"}, {"type": "subtitle", "time": 1101.029, "timestamp": "00:18:21", "text": "哇。非常奇怪。实话实说。"}, {"type": "subtitle", "time": 1106.23, "timestamp": "00:18:26", "text": "诡异的。我觉得现在实际上有点像……"}, {"type": "subtitle", "time": 1109.59, "timestamp": "00:18:29", "text": "帮我找个合适的伴侣。"}, {"type": "subtitle", "time": 1112.19, "timestamp": "00:18:32", "text": "这意味着我错过了我的黄金延迟"}, {"type": "subtitle", "time": 1115.789, "timestamp": "00:18:35", "text": "一切。不，不，我想我已经"}, {"type": "subtitle", "time": 1120.31, "timestamp": "00:18:40", "text": "对吧？我从……上摔下来了"}, {"type": "subtitle", "time": 1128.27, "timestamp": "00:18:48", "text": "是的。我的天哪。它就是它"}, {"type": "subtitle", "time": 1131.83, "timestamp": "00:18:51", "text": "是。所以，到目前为止，从观察我来看，你们有什么看法？"}, {"type": "subtitle", "time": 1133.83, "timestamp": "00:18:53", "text": "你们都在想这场比赛吗？什么"}, {"type": "subtitle", "time": 1136.95, "timestamp": "00:18:56", "text": "您认为？"}]
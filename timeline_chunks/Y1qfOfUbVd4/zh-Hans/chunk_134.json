[{"type": "subtitle", "time": 8040.669, "timestamp": "02:14:00", "text": "霰弹枪"}, {"type": "subtitle", "time": 8049.669, "timestamp": "02:14:09", "text": "砍刀。烟雾弹。"}, {"type": "subtitle", "time": 8051.75, "timestamp": "02:14:11", "text": "三级背包。好的，我是"}, {"type": "subtitle", "time": 8054.03, "timestamp": "02:14:14", "text": "感恩。等等，野牛。这是什么？"}, {"type": "subtitle", "time": 8057.95, "timestamp": "02:14:17", "text": "冲锋枪。我应该这样做吗？这样做好吗？"}, {"type": "subtitle", "time": 8062.629, "timestamp": "02:14:22", "text": "冲锋枪？子弹循环。我需要它吗？我会"}, {"type": "subtitle", "time": 8077.109, "timestamp": "02:14:37", "text": "秩。小丑的陨落。不，这只是为了"}, {"type": "subtitle", "time": 8079.109, "timestamp": "02:14:39", "text": "一度。我打算直接直播。"}, {"type": "subtitle", "time": 8080.709, "timestamp": "02:14:40", "text": "对于这次直播，我只想说……"}, {"type": "subtitle", "time": 8082.27, "timestamp": "02:14:42", "text": "安装它。不"}, {"type": "subtitle", "time": 8085.83, "timestamp": "02:14:45", "text": "别担心。好的。我最喜欢的"}, {"type": "subtitle", "time": 8090.99, "timestamp": "02:14:50", "text": "整个游戏中的枪"}, {"type": "subtitle", "time": 8093.39, "timestamp": "02:14:53", "text": "AK-47。最好的"}]
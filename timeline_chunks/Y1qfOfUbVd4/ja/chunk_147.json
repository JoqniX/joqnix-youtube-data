[{"type": "subtitle", "time": 8825.59, "timestamp": "02:27:05", "text": "ジョー。ああ、神様。ああ、神様。ああ、神様。ああ、神様。私"}, {"type": "subtitle", "time": 8826.71, "timestamp": "02:27:06", "text": "私には無理だと思う。私はしません"}, {"type": "subtitle", "time": 8828.469, "timestamp": "02:27:08", "text": "私は成功しないと思う。私"}, {"type": "subtitle", "time": 8830.95, "timestamp": "02:27:10", "text": "救急キットを6個くらい用意しておこう。できました"}, {"type": "subtitle", "time": 8833.11, "timestamp": "02:27:13", "text": "作れるとは思うが、私にはわからない。どうやって"}, {"type": "subtitle", "time": 8835.11, "timestamp": "02:27:15", "text": "このゲームでまた自動実行されるの？誰か"}, {"type": "subtitle", "time": 8837.95, "timestamp": "02:27:17", "text": "キーバインドはご存知ですか？彼らは倒れたのか"}, {"type": "subtitle", "time": 8841.27, "timestamp": "02:27:21", "text": "キーバインド？ Tですか？いいえ、それはTではありません。"}, {"type": "subtitle", "time": 8844.309, "timestamp": "02:27:24", "text": "銃撃事件が起きている。"}, {"type": "subtitle", "time": 8846.11, "timestamp": "02:27:26", "text": "どれくらい遠いですか"}, {"type": "subtitle", "time": 8848.87, "timestamp": "02:27:28", "text": "これ？本当に遠い。私はそうすべきだった"}, {"type": "subtitle", "time": 8851.19, "timestamp": "02:27:31", "text": "早めに引っ越しました。パカ、こうなるんだよ"}, {"type": "subtitle", "time": 8852.91, "timestamp": "02:27:32", "text": "チェックしない場合"}, {"type": "subtitle", "time": 8854.51, "timestamp": "02:27:34", "text": "の"}, {"type": "subtitle", "time": 8857.03, "timestamp": "02:27:37", "text": "もの。君たちがあそこで戦っているのが見えるよ"}, {"type": "subtitle", "time": 8858.99, "timestamp": "02:27:38", "text": "真っ直ぐ"}, {"type": "subtitle", "time": 8861.87, "timestamp": "02:27:41", "text": "上。"}, {"type": "subtitle", "time": 8865.63, "timestamp": "02:27:45", "text": "ああ。えっと、このゲームは"}, {"type": "subtitle", "time": 8873.19, "timestamp": "02:27:53", "text": "右？このゲームは、ああ、そうだね。私は歩く"}]
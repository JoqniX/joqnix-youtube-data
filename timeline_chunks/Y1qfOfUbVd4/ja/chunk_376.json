[{"type": "subtitle", "time": 22567.83, "timestamp": "06:16:07", "text": "私のところで素敵な雷が起こっています"}, {"type": "subtitle", "time": 22607.51, "timestamp": "06:16:47", "text": "水を飲むように私にリマインダーを送ってください。"}, {"type": "subtitle", "time": 22609.75, "timestamp": "06:16:49", "text": "はい、ありがとうございます。私はただそれを正しく行うだけです"}, {"type": "subtitle", "time": 22619.99, "timestamp": "06:16:59", "text": "違反をもたらす。人を殺すことはできない"}]
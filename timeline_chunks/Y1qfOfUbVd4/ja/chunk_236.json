[{"type": "subtitle", "time": 14160.63, "timestamp": "03:56:00", "text": "休憩ですよね？そのため、私は"}, {"type": "subtitle", "time": 14168.83, "timestamp": "03:56:08", "text": "私は確認する必要がある"}, {"type": "subtitle", "time": 14171.91, "timestamp": "03:56:11", "text": "あまりストレスを溜めないでください、特に"}, {"type": "subtitle", "time": 14175.189, "timestamp": "03:56:15", "text": "Twitchで配信するので"}, {"type": "subtitle", "time": 14177.99, "timestamp": "03:56:17", "text": "良い。"}, {"type": "subtitle", "time": 14187.83, "timestamp": "03:56:27", "text": "でもTwitchの配信はそうですよね？"}, {"type": "subtitle", "time": 14190.51, "timestamp": "03:56:30", "text": "私はもっ​​と怖いのは、ああ、それは"}, {"type": "subtitle", "time": 14193.07, "timestamp": "03:56:33", "text": "墜落しました。やったー、"}, {"type": "subtitle", "time": 14196.87, "timestamp": "03:56:36", "text": "墜落しました。本当に？"}, {"type": "subtitle", "time": 14198.51, "timestamp": "03:56:38", "text": "あ、待って。暴動"}, {"type": "subtitle", "time": 14202.469, "timestamp": "03:56:42", "text": "ヴァンガード。ああ、ゲームはちゃんと動く。おお。うん、"}, {"type": "subtitle", "time": 14204.309, "timestamp": "03:56:44", "text": "Twitch ストリームの場合、それは"}, {"type": "subtitle", "time": 14207.469, "timestamp": "03:56:47", "text": "最もストレスが溜まる"}, {"type": "subtitle", "time": 14210.63, "timestamp": "03:56:50", "text": "ボードをダウンロードする必要があるため"}, {"type": "subtitle", "time": 14213.87, "timestamp": "03:56:53", "text": "チャットを追加して、"}, {"type": "subtitle", "time": 14216.71, "timestamp": "03:56:56", "text": "一緒にビデオをレンダリングし、レンダリングします"}, {"type": "subtitle", "time": 14219.63, "timestamp": "03:56:59", "text": "ボードをアップロードします"}]
[{"type": "subtitle", "time": 16441.789, "timestamp": "04:34:01", "text": "中国語。"}, {"type": "subtitle", "time": 16445.39, "timestamp": "04:34:05", "text": "うん、テーマは"}, {"type": "subtitle", "time": 16447.83, "timestamp": "04:34:07", "text": "中国語。テーマが中国風に感じられる。おお"}, {"type": "subtitle", "time": 16452.39, "timestamp": "04:34:12", "text": "ああ、言葉が出ないと思う"}, {"type": "subtitle", "time": 16455.869, "timestamp": "04:34:15", "text": "もう一度繰り返してくださいと言ったとき。えーと、コントロール"}, {"type": "subtitle", "time": 16460.47, "timestamp": "04:34:20", "text": "1つ。私たちは自転車でどこかへ行く"}, {"type": "subtitle", "time": 16468.59, "timestamp": "04:34:28", "text": "戦利品。私は"}, {"type": "subtitle", "time": 16471.47, "timestamp": "04:34:31", "text": "小屋と"}, {"type": "subtitle", "time": 16480.47, "timestamp": "04:34:40", "text": "家。ああ、それは私が"}]
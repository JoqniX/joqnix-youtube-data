[{"type": "subtitle", "time": 8403.07, "timestamp": "02:20:03", "text": "それ。ポンポンの音が聞こえる"}, {"type": "subtitle", "time": 8406.79, "timestamp": "02:20:06", "text": "の上。そうそう。これはより安全な方法ではないでしょうか？"}, {"type": "subtitle", "time": 8411.15, "timestamp": "02:20:11", "text": "後ろからボングされる？"}, {"type": "subtitle", "time": 8413.67, "timestamp": "02:20:13", "text": "わかった。これは何ですか？そうそう。ありがとう。"}, {"type": "subtitle", "time": 8415.71, "timestamp": "02:20:15", "text": "私は必要としている"}, {"type": "subtitle", "time": 8420.19, "timestamp": "02:20:20", "text": "それ。手榴弾は"}, {"type": "subtitle", "time": 8421.95, "timestamp": "02:20:21", "text": "のように"}, {"type": "subtitle", "time": 8425.59, "timestamp": "02:20:25", "text": "回転している。スタンは良くない。フラッシュ。私"}, {"type": "subtitle", "time": 8436.71, "timestamp": "02:20:36", "text": "それ？あれがまたやってくる。の"}, {"type": "subtitle", "time": 8440.19, "timestamp": "02:20:40", "text": "音。奇妙な音。誰が私をストーキングしているの？"}, {"type": "subtitle", "time": 8448.67, "timestamp": "02:20:48", "text": "D. こんにちは、ロバート"}]
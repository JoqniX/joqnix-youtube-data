[{"type": "subtitle", "time": 18243.27, "timestamp": "05:04:03", "text": "もの。次。これは何ですか？ E."}, {"type": "subtitle", "time": 18247.23, "timestamp": "05:04:07", "text": "Eは、"}, {"type": "subtitle", "time": 18250.47, "timestamp": "05:04:10", "text": "ピューピューと撃つと、何かや好きなものが手に入る"}, {"type": "subtitle", "time": 18253.35, "timestamp": "05:04:13", "text": "スキャンか何かを受けることになる。私はこれが欲しい"}, {"type": "subtitle", "time": 18256.07, "timestamp": "05:04:16", "text": "英語でした。私は読むことができた"}, {"type": "subtitle", "time": 18259.708, "timestamp": "05:04:19", "text": "もっとうまく読めたかもしれないけど"}, {"type": "subtitle", "time": 18267.75, "timestamp": "05:04:27", "text": "拡張は可能だが、Bには適用されない"}, {"type": "subtitle", "time": 18273.83, "timestamp": "05:04:33", "text": "なるほど、それはいい考えですね、いい方法です"}, {"type": "subtitle", "time": 18277.91, "timestamp": "05:04:37", "text": "物事を理解するため。それでは、"}, {"type": "subtitle", "time": 18279.91, "timestamp": "05:04:39", "text": "魔女たち、これは葉っぱだと思う"}, {"type": "subtitle", "time": 18282.11, "timestamp": "05:04:42", "text": "ゲームですよね？私はできません"}, {"type": "subtitle", "time": 18285.83, "timestamp": "05:04:45", "text": "盲目を読むことは、単に"}, {"type": "subtitle", "time": 18289.35, "timestamp": "05:04:49", "text": "それだけでなく、弱めるだけです"}, {"type": "subtitle", "time": 18292.788, "timestamp": "05:04:52", "text": "KJ Alamがもたらしたように。はい、次はあなたの番です"}, {"type": "subtitle", "time": 18295.03, "timestamp": "05:04:55", "text": "これで試合は終わりだと思います。"}, {"type": "subtitle", "time": 18296.948, "timestamp": "05:04:56", "text": "待って、その試合の結末はどっちなの？私"}, {"type": "subtitle", "time": 18298.59, "timestamp": "05:04:58", "text": "読めない。おお"}]
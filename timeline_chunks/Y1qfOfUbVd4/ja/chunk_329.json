[{"type": "subtitle", "time": 19740.43, "timestamp": "05:29:00", "text": "ラグが発生する。さあ行こう"}, {"type": "subtitle", "time": 19743.83, "timestamp": "05:29:03", "text": "遅れ。何てことだ。何てことだ。何てことだ。おお"}, {"type": "subtitle", "time": 19751.99, "timestamp": "05:29:11", "text": "おお。何てことだ。何てことだ。とても美味しいです。"}, {"type": "subtitle", "time": 19780.19, "timestamp": "05:29:40", "text": "エルサ。私のバックグラウンドが聞こえますか？いいえ。"}, {"type": "subtitle", "time": 19783.07, "timestamp": "05:29:43", "text": "右。"}, {"type": "subtitle", "time": 19785.83, "timestamp": "05:29:45", "text": "わかった。ところで、イサはどこの出身ですか？私"}]
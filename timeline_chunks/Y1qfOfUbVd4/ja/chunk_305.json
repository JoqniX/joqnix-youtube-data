[{"type": "subtitle", "time": 18302.31, "timestamp": "05:05:02", "text": "ああ、これ、大好きだ。ニース。これは"}, {"type": "subtitle", "time": 18303.55, "timestamp": "05:05:03", "text": "テーマ"}, {"type": "subtitle", "time": 18306.75, "timestamp": "05:05:06", "text": "多くの。どちらがどちらかわかりません"}, {"type": "subtitle", "time": 18309.948, "timestamp": "05:05:09", "text": "設定。これはフルスクリーンだと思います"}, {"type": "subtitle", "time": 18313.27, "timestamp": "05:05:13", "text": "ウィンドウ付き。ああ、大変だ、私、字が読めない。なぜ"}, {"type": "subtitle", "time": 18318.83, "timestamp": "05:05:18", "text": "なぜそうしたのか？これはウィンドウフルだと思います"}, {"type": "subtitle", "time": 18322.19, "timestamp": "05:05:22", "text": "画面。なぜ私はそれを変更したのか"}, {"type": "subtitle", "time": 18324.11, "timestamp": "05:05:24", "text": "日本語？ああ、"}, {"type": "subtitle", "time": 18326.868, "timestamp": "05:05:26", "text": "神。こんにちは。それはいいです。その通りです。"}, {"type": "subtitle", "time": 18330.708, "timestamp": "05:05:30", "text": "ああ、助かった。ニース。さあ行こう。私たちは、"}, {"type": "subtitle", "time": 18333.67, "timestamp": "05:05:33", "text": "または、私が使用しているためキューを取得できない可能性があります"}, {"type": "subtitle", "time": 18336.07, "timestamp": "05:05:36", "text": "騙すし、ちょっと壊れてる。"}, {"type": "subtitle", "time": 18339.35, "timestamp": "05:05:39", "text": "レストレスは壊れているが、問題ない。"}, {"type": "subtitle", "time": 18358.708, "timestamp": "05:05:58", "text": "これは引き分けだと思う​​。ああ、これ"}, {"type": "subtitle", "time": 18359.948, "timestamp": "05:05:59", "text": "デッドマッチです、"}]
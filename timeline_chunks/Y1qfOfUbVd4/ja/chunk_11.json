[{"type": "subtitle", "time": 674.59, "timestamp": "00:11:14", "text": "行け！行け！行け。何てことだ。"}, {"type": "subtitle", "time": 677.35, "timestamp": "00:11:17", "text": "何？今の見た？彼の頭は"}, {"type": "subtitle", "time": 685.15, "timestamp": "00:11:25", "text": "木箱。ニース。悪くない"}, {"type": "subtitle", "time": 693.11, "timestamp": "00:11:33", "text": "右？人は死ぬことができるのか？うん。うん。それは一種の"}, {"type": "subtitle", "time": 695.069, "timestamp": "00:11:35", "text": "彼は奇妙なことをする"}, {"type": "subtitle", "time": 697.75, "timestamp": "00:11:37", "text": "騒音。いいえ、できません。そうではありません。の"}, {"type": "subtitle", "time": 704.71, "timestamp": "00:11:44", "text": "に。なぜ？ちょっとイライラしますよね？"}]
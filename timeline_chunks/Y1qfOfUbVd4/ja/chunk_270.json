[{"type": "subtitle", "time": 16204.309, "timestamp": "04:30:04", "text": "えっと、実はM M4 A1が欲しいんです。待って、"}, {"type": "subtitle", "time": 16207.149, "timestamp": "04:30:07", "text": "どの銃だったか"}, {"type": "subtitle", "time": 16209.87, "timestamp": "04:30:09", "text": "また？"}, {"type": "subtitle", "time": 16217.67, "timestamp": "04:30:17", "text": "ええ、私がそれをインストールしたのは"}, {"type": "subtitle", "time": 16219.429, "timestamp": "04:30:19", "text": "Discordクエストじゃないと"}, {"type": "subtitle", "time": 16222.55, "timestamp": "04:30:22", "text": "そんなことはしなかっただろう。今のところ、私は"}, {"type": "subtitle", "time": 16226.349, "timestamp": "04:30:26", "text": "失われた"}, {"type": "subtitle", "time": 16229.99, "timestamp": "04:30:29", "text": "アーククエストはこれまでそうではなかった"}, {"type": "subtitle", "time": 16232.79, "timestamp": "04:30:32", "text": "私にとって利用可能です。それはまるで"}, {"type": "subtitle", "time": 16235.59, "timestamp": "04:30:35", "text": "地域制限か何かでしょう。奇妙な"}, {"type": "subtitle", "time": 16238.59, "timestamp": "04:30:38", "text": "理由。うん。うん。私の"}, {"type": "subtitle", "time": 16242.67, "timestamp": "04:30:42", "text": "フットボール。もちろん。それ以外では、"}, {"type": "subtitle", "time": 16245.51, "timestamp": "04:30:45", "text": "うん。あれ、これって別の地図じゃない？"}, {"type": "subtitle", "time": 16248.189, "timestamp": "04:30:48", "text": "これはイラン人でも"}, {"type": "subtitle", "time": 16252.149, "timestamp": "04:30:52", "text": "何か。ああ、赤毛のワイフ、かわいい。"}, {"type": "subtitle", "time": 16254.59, "timestamp": "04:30:54", "text": "何てことだ。それで"}, {"type": "subtitle", "time": 16258.11, "timestamp": "04:30:58", "text": "かわいい。私はついていきます"}]
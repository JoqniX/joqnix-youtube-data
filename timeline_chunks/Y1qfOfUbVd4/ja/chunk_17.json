[{"type": "subtitle", "time": 1020.15, "timestamp": "00:17:00", "text": "何？私はとてもうまくいっていたのに、彼は"}, {"type": "subtitle", "time": 1022.03, "timestamp": "00:17:02", "text": "私にもそうさせて。"}, {"type": "subtitle", "time": 1029.35, "timestamp": "00:17:09", "text": "ニース。そして今、誰が殺せるのか"}, {"type": "subtitle", "time": 1037.19, "timestamp": "00:17:17", "text": "何？このゲーム、すごいね。"}, {"type": "subtitle", "time": 1051.59, "timestamp": "00:17:31", "text": "はぁ？私はそのゲームをプレイすらしていません。何？"}, {"type": "subtitle", "time": 1056.99, "timestamp": "00:17:36", "text": "の上？何が"}, {"type": "subtitle", "time": 1059.029, "timestamp": "00:17:39", "text": "ハプニング？待って、まさか"}, {"type": "subtitle", "time": 1060.27, "timestamp": "00:17:40", "text": "そうするつもりです"}, {"type": "subtitle", "time": 1062.909, "timestamp": "00:17:42", "text": "また。待って、"}, {"type": "subtitle", "time": 1067.789, "timestamp": "00:17:47", "text": "何？私はどうして生きているのだろう？ゾーン。"}, {"type": "subtitle", "time": 1073.23, "timestamp": "00:17:53", "text": "これ？"}, {"type": "subtitle", "time": 1075.669, "timestamp": "00:17:55", "text": "待って、みんなもこれ見てるよね？"}, {"type": "subtitle", "time": 1078.07, "timestamp": "00:17:58", "text": "こう言っているのは私だけではありません。"}]
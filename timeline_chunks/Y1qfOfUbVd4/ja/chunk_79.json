[{"type": "subtitle", "time": 4745.91, "timestamp": "01:19:05", "text": "発散。どうやって、そして地獄のすべて。何が"}, {"type": "subtitle", "time": 4748.189, "timestamp": "01:19:08", "text": "これ？空間"}, {"type": "subtitle", "time": 4756.229, "timestamp": "01:19:16", "text": "このジョーク？何か面白いことを言ってください。何が"}, {"type": "subtitle", "time": 4758.07, "timestamp": "01:19:18", "text": "もしかして？ご存知の通り、私はジョークが苦手です"}, {"type": "subtitle", "time": 4759.83, "timestamp": "01:19:19", "text": "いろいろとね？どうすれば"}, {"type": "subtitle", "time": 4762.47, "timestamp": "01:19:22", "text": "何か面白いことを言ってみて？これらの作品は"}, {"type": "subtitle", "time": 4765.91, "timestamp": "01:19:25", "text": "それらの作品は、他の作品のためのものです。"}, {"type": "subtitle", "time": 4768.35, "timestamp": "01:19:28", "text": "一緒には"}, {"type": "subtitle", "time": 4770.51, "timestamp": "01:19:30", "text": "自分"}, {"type": "subtitle", "time": 4774.31, "timestamp": "01:19:34", "text": "アルゼンチンからのご挨拶。おお、いいね。"}, {"type": "subtitle", "time": 4779.03, "timestamp": "01:19:39", "text": "ニース。私は今まで一度も誰かと付き合ったことがないと思います"}, {"type": "subtitle", "time": 4782.55, "timestamp": "01:19:42", "text": "私のチャットにはアルゼンチン出身の人がいました。"}, {"type": "subtitle", "time": 4785.149, "timestamp": "01:19:45", "text": "つまり、あなたが最初の人になるということです。"}]
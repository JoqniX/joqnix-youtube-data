[{"type": "subtitle", "time": 19202.948, "timestamp": "05:20:02", "text": "ニース。ヴァレラント。いいえ、私はクリックしました"}, {"type": "subtitle", "time": 19204.67, "timestamp": "05:20:04", "text": "私の設定を覚えておいてください。"}, {"type": "subtitle", "time": 19208.51, "timestamp": "05:20:08", "text": "いいえ。大丈夫です。大丈夫です。その"}, {"type": "subtitle", "time": 19211.83, "timestamp": "05:20:11", "text": "大丈夫。まあ、いいんじゃない？私はただ"}, {"type": "subtitle", "time": 19214.75, "timestamp": "05:20:14", "text": "正常に動作しますか？必要ない"}, {"type": "subtitle", "time": 19218.23, "timestamp": "05:20:18", "text": "ふるいにかける。それはうまくいくでしょうか？"}, {"type": "subtitle", "time": 19220.39, "timestamp": "05:20:20", "text": "私はただ、保存して隠しているだけだと分かっている"}, {"type": "subtitle", "time": 19222.948, "timestamp": "05:20:22", "text": "私の友達リストにいる全員から"}, {"type": "subtitle", "time": 19225.948, "timestamp": "05:20:25", "text": "一人で過ごす時間が欲しい。私"}, {"type": "subtitle", "time": 19231.708, "timestamp": "05:20:31", "text": "知る。えっと、新しいレジェンドはただのシールドです"}, {"type": "subtitle", "time": 19234.15, "timestamp": "05:20:34", "text": "充電器。どちらについて話しているのですか？"}, {"type": "subtitle", "time": 19241.75, "timestamp": "05:20:41", "text": "ヴァレラント？私はヴァレラントだけをプレイしています"}, {"type": "subtitle", "time": 19245.19, "timestamp": "05:20:45", "text": "照準トレーナー用。ゲーム内エイムトレーナー"}, {"type": "subtitle", "time": 19247.99, "timestamp": "05:20:47", "text": "手に入れる。それだけです。ああ、それだけです。"}, {"type": "subtitle", "time": 19250.23, "timestamp": "05:20:50", "text": "私の人生で唯一望むことは"}, {"type": "subtitle", "time": 19252.75, "timestamp": "05:20:52", "text": "あなたの"}, {"type": "subtitle", "time": 19255.75, "timestamp": "05:20:55", "text": "頭。招待状はいりません。"}, {"type": "subtitle", "time": 19257.23, "timestamp": "05:20:57", "text": "とにかく、"}]
[{"type": "subtitle", "time": 15070.15, "timestamp": "04:11:10", "text": "[拍手]"}, {"type": "subtitle", "time": 15074.269, "timestamp": "04:11:14", "text": "ああ、なんてバカなんだろう。私は殺した"}, {"type": "subtitle", "time": 15077.0, "timestamp": "04:11:17", "text": "私は殺した チームメイト。私はチームメイトを殺した。い、い、い、い"}, {"type": "subtitle", "time": 15095.229, "timestamp": "04:11:35", "text": "えっと、休んで"}, {"type": "subtitle", "time": 15097.55, "timestamp": "04:11:37", "text": "AFK（離席）中の人。"}, {"type": "subtitle", "time": 15102.87, "timestamp": "04:11:42", "text": "なんてこった。そして私はチームメイトを殺した。ニース。私"}, {"type": "subtitle", "time": 15105.189, "timestamp": "04:11:45", "text": "犬が血に飢えているのがわかる"}, {"type": "subtitle", "time": 15106.429, "timestamp": "04:11:46", "text": "いつも"}, {"type": "subtitle", "time": 15109.189, "timestamp": "04:11:49", "text": "言う。こんにちは。ご視聴ありがとうございました"}, {"type": "subtitle", "time": 15113.189, "timestamp": "04:11:53", "text": "縦向きのもの。縦長のもの。希望"}]
[{"type": "subtitle", "time": 15487.79, "timestamp": "04:18:07", "text": "ベイ"}, {"type": "subtitle", "time": 15498.87, "timestamp": "04:18:18", "text": "えっと、ちょっと待って。いいえ、私は"}, {"type": "subtitle", "time": 15502.59, "timestamp": "04:18:22", "text": "わかりました、違いますね。でも私はこれを手に入れた"}, {"type": "subtitle", "time": 15506.349, "timestamp": "04:18:26", "text": "この辺りのどこかにいる男"}, {"type": "subtitle", "time": 15509.11, "timestamp": "04:18:29", "text": "どこかで。ああ、これがその男だ"}, {"type": "subtitle", "time": 15512.229, "timestamp": "04:18:32", "text": "ヴァレラントというもう一人の男のスキン"}, {"type": "subtitle", "time": 15515.63, "timestamp": "04:18:35", "text": "彼が使っていたチームベースモード。"}, {"type": "subtitle", "time": 15525.07, "timestamp": "04:18:45", "text": "神。"}, {"type": "subtitle", "time": 15527.469, "timestamp": "04:18:47", "text": "ニース。それで、私は"}, {"type": "subtitle", "time": 15529.229, "timestamp": "04:18:49", "text": "1"}, {"type": "subtitle", "time": 15531.0, "timestamp": "04:18:51", "text": "ディシュキン。"}]
[{"type": "subtitle", "time": 19320.19, "timestamp": "05:22:00", "text": "[音楽]"}, {"type": "subtitle", "time": 19324.628, "timestamp": "05:22:04", "text": "大丈夫。 Riot Gamesはどこにいるの？"}, {"type": "subtitle", "time": 19328.788, "timestamp": "05:22:08", "text": "普通というのは、誰にも似ていないものを指す。これは"}, {"type": "subtitle", "time": 19346.23, "timestamp": "05:22:26", "text": "私はすでに導管を持っています。"}, {"type": "subtitle", "time": 19349.11, "timestamp": "05:22:29", "text": "M. ああ、なんてことだ。あなたのツイートを見ました。あなた"}, {"type": "subtitle", "time": 19351.27, "timestamp": "05:22:31", "text": "1位か3位になったか"}, {"type": "subtitle", "time": 19354.15, "timestamp": "05:22:34", "text": "何か。えーと、プレイヤー一人当たりの触媒として"}, {"type": "subtitle", "time": 19356.47, "timestamp": "05:22:36", "text": "インドかどこかで、ですよね？どうやって"}, {"type": "subtitle", "time": 19359.788, "timestamp": "05:22:39", "text": "君はそんなことまでするのか？さあ行こう"}, {"type": "subtitle", "time": 19364.628, "timestamp": "05:22:44", "text": "そして君はApexをものすごくやり込んでいる。どうやって"}, {"type": "subtitle", "time": 19367.91, "timestamp": "05:22:47", "text": "燃え尽き症候群にならないように気をつけますか？知っている"}, {"type": "subtitle", "time": 19371.23, "timestamp": "05:22:51", "text": "このゲームをやり込む人たち"}, {"type": "subtitle", "time": 19376.67, "timestamp": "05:22:56", "text": "24時間365日、私はまだ自分自身に疑問を抱いている"}, {"type": "subtitle", "time": 19379.67, "timestamp": "05:22:59", "text": "あなたはこれをどう思いますか？待って、待って。"}]
[{"type": "subtitle", "time": 22216.628, "timestamp": "06:10:16", "text": "歓迎されました。いらっしゃいませ。どうでしたか"}, {"type": "subtitle", "time": 22231.11, "timestamp": "06:10:31", "text": "日？私はこっそりと仕事をしていました"}, {"type": "subtitle", "time": 22235.75, "timestamp": "06:10:35", "text": "バックグラウンドでストリーミング配信をしながら。うん。"}, {"type": "subtitle", "time": 22237.99, "timestamp": "06:10:37", "text": "600点獲得するぞ"}, {"type": "subtitle", "time": 22240.548, "timestamp": "06:10:40", "text": "すぐ。さあ行こう。待って、私は"}, {"type": "subtitle", "time": 22243.99, "timestamp": "06:10:43", "text": "YouTubeで600人ですよね？みんな"}, {"type": "subtitle", "time": 22251.07, "timestamp": "06:10:51", "text": "待って、もうやったよ。待って、誰かが"}, {"type": "subtitle", "time": 22252.75, "timestamp": "06:10:52", "text": "購読解除しますか？"}, {"type": "subtitle", "time": 22255.43, "timestamp": "06:10:55", "text": "いいえ"}, {"type": "subtitle", "time": 22257.07, "timestamp": "06:10:57", "text": "[音楽]"}, {"type": "subtitle", "time": 22259.67, "timestamp": "06:10:59", "text": "購読を解除しました。行く。大丈夫。私はしません"}]
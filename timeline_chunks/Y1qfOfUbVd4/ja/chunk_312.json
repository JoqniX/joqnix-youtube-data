[{"type": "subtitle", "time": 18721.11, "timestamp": "05:12:01", "text": "何？何？あなたは"}, {"type": "subtitle", "time": 18724.948, "timestamp": "05:12:04", "text": "病院に行くとか？スマッシュ＆"}, {"type": "subtitle", "time": 18727.59, "timestamp": "05:12:07", "text": "何？あ、もしかして今、時間があるの？"}, {"type": "subtitle", "time": 18729.51, "timestamp": "05:12:09", "text": "うん、うん、うん。ストリーミングして"}, {"type": "subtitle", "time": 18731.03, "timestamp": "05:12:11", "text": "いろいろ、自分のことをやってください。"}, {"type": "subtitle", "time": 18734.47, "timestamp": "05:12:14", "text": "気を紛らわせるんだ。しないで"}, {"type": "subtitle", "time": 18735.868, "timestamp": "05:12:15", "text": "考える"}, {"type": "subtitle", "time": 18737.628, "timestamp": "05:12:17", "text": "何でも"}, {"type": "subtitle", "time": 18752.75, "timestamp": "05:12:32", "text": "ああ、"}, {"type": "subtitle", "time": 18757.23, "timestamp": "05:12:37", "text": "感じる"}, {"type": "subtitle", "time": 18760.03, "timestamp": "05:12:40", "text": "違う。まったく違う"}, {"type": "subtitle", "time": 18763.948, "timestamp": "05:12:43", "text": "いつもの。ああ、彼らが勝利を収める。"}, {"type": "subtitle", "time": 18767.43, "timestamp": "05:12:47", "text": "はぁ？そのアップデートはいつリリースされましたか？のように、"}, {"type": "subtitle", "time": 18769.39, "timestamp": "05:12:49", "text": "なぜそうなっているのか"}]
[{"type": "subtitle", "time": 11647.87, "timestamp": "03:14:07", "text": "そこへ行ってみなさい。それが私が"}, {"type": "subtitle", "time": 11650.51, "timestamp": "03:14:10", "text": "欲しい。行く"}, {"type": "subtitle", "time": 11659.55, "timestamp": "03:14:19", "text": "上。ああ、その戦いを手に入れて、私は捕まえる"}, {"type": "subtitle", "time": 11663.229, "timestamp": "03:14:23", "text": "あなた。その戦いを引き受けてくれれば、お前を捕まえてやる。"}, {"type": "subtitle", "time": 11666.03, "timestamp": "03:14:26", "text": "待って。はい。はい。来る"}, {"type": "subtitle", "time": 11669.349, "timestamp": "03:14:29", "text": "ここ。そして、生き残ったのは君だけだ。"}, {"type": "subtitle", "time": 11671.51, "timestamp": "03:14:31", "text": "君を視界に捉えたよ。出られない"}, {"type": "subtitle", "time": 11684.55, "timestamp": "03:14:44", "text": "ゾーン。はい。彼は配信をしている。 Sは"}]
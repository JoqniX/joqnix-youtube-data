[{"type": "subtitle", "time": 21901.35, "timestamp": "06:05:01", "text": "アニメーションのようなものがある"}, {"type": "subtitle", "time": 21904.07, "timestamp": "06:05:04", "text": "理由。"}, {"type": "subtitle", "time": 21916.19, "timestamp": "06:05:16", "text": "外？フェニックスのゼロ"}, {"type": "subtitle", "time": 21919.91, "timestamp": "06:05:19", "text": "ピニ。わかった。何回やったの？"}, {"type": "subtitle", "time": 21922.47, "timestamp": "06:05:22", "text": "もう済ませましたか？それで、えーと、"}, {"type": "subtitle", "time": 21924.23, "timestamp": "06:05:24", "text": "現在、5 つのモッドが"}, {"type": "subtitle", "time": 21926.31, "timestamp": "06:05:26", "text": "一瞬。私は彼ら全員に"}, {"type": "subtitle", "time": 21928.31, "timestamp": "06:05:28", "text": "モッド。スイッチを切り替えたいだけです"}, {"type": "subtitle", "time": 21931.11, "timestamp": "06:05:31", "text": "彼らが自由気ままな時はいつでも、わかるだろ。"}, {"type": "subtitle", "time": 21933.51, "timestamp": "06:05:33", "text": "うん。うん。うん。改造するものは何もありません"}, {"type": "subtitle", "time": 21935.59, "timestamp": "06:05:35", "text": "けれど。状況が発生した場合にのみ。"}, {"type": "subtitle", "time": 21938.15, "timestamp": "06:05:38", "text": "それだけです。一人、彼らのうちの一人ならできる。"}]
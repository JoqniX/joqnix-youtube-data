[{"type": "subtitle", "time": 3367.589, "timestamp": "00:56:07", "text": "こんにちは。どこでどのように産卵するのか"}, {"type": "subtitle", "time": 3369.47, "timestamp": "00:56:09", "text": "のように"}, {"type": "subtitle", "time": 3372.069, "timestamp": "00:56:12", "text": "これ？わかった。ポネ。私は行かなければならない"}, {"type": "subtitle", "time": 3375.19, "timestamp": "00:56:15", "text": "バイソンを買って物を買う。"}, {"type": "subtitle", "time": 3389.43, "timestamp": "00:56:29", "text": "ああ、あれは本物の人間じゃないよ。おお、"}, {"type": "subtitle", "time": 3396.03, "timestamp": "00:56:36", "text": "人。よし、ガス"}, {"type": "subtitle", "time": 3399.91, "timestamp": "00:56:39", "text": "マスクで蘇る。"}, {"type": "subtitle", "time": 3407.43, "timestamp": "00:56:47", "text": "ない？ここに鎧を置くにはどうすればいいですか？鎧"}]
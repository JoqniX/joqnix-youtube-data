[{"type": "subtitle", "time": 5581.47, "timestamp": "01:33:01", "text": "ええと、良い良い"}, {"type": "subtitle", "time": 5583.629, "timestamp": "01:33:03", "text": "木曜日。ニース"}, {"type": "subtitle", "time": 5586.47, "timestamp": "01:33:06", "text": "歌。私は泳ぐ魚になりたい"}, {"type": "subtitle", "time": 5594.59, "timestamp": "01:33:14", "text": "ご来場ありがとうございました"}, {"type": "subtitle", "time": 5610.95, "timestamp": "01:33:30", "text": "配信をお楽しみください。はい、ありがとうございます。"}, {"type": "subtitle", "time": 5612.95, "timestamp": "01:33:32", "text": "皆さん、お越しいただきありがとうございました。また会おう"}, {"type": "subtitle", "time": 5619.59, "timestamp": "01:33:39", "text": "明日。それは歌う小川かもしれない"}, {"type": "subtitle", "time": 5621.27, "timestamp": "01:33:41", "text": "あるいは、それはおそらく作品である"}, {"type": "subtitle", "time": 5623.27, "timestamp": "01:33:43", "text": "ストリーム。はい、ではまた。"}, {"type": "subtitle", "time": 5638.03, "timestamp": "01:33:58", "text": "来てくれて本当にありがとう"}]
[{"type": "subtitle", "time": 15122.309, "timestamp": "04:12:02", "text": "[音楽]"}, {"type": "subtitle", "time": 15124.349, "timestamp": "04:12:04", "text": "開ける"}, {"type": "subtitle", "time": 15127.59, "timestamp": "04:12:07", "text": "ごま。私には見えませんでした。私が手に入れたもの"}, {"type": "subtitle", "time": 15129.77, "timestamp": "04:12:09", "text": "また？"}, {"type": "subtitle", "time": 15146.229, "timestamp": "04:12:26", "text": "何？あれは人間だ。あれは人間だ。"}, {"type": "subtitle", "time": 15147.55, "timestamp": "04:12:27", "text": "何？"}]
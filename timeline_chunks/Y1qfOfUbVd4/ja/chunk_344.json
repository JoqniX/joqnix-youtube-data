[{"type": "subtitle", "time": 20640.27, "timestamp": "05:44:00", "text": "さあ行こう、フィニーニ。さあ行こう、"}, {"type": "subtitle", "time": 20674.39, "timestamp": "05:44:34", "text": "痛み。私は死にそうで、死んでいく"}, {"type": "subtitle", "time": 20677.15, "timestamp": "05:44:37", "text": "死を覚悟して、俺は死ぬんだ。"}, {"type": "subtitle", "time": 20678.99, "timestamp": "05:44:38", "text": "ニース。私は"}, {"type": "subtitle", "time": 20682.23, "timestamp": "05:44:42", "text": "能力に過度に依存しているようなものだ。"}, {"type": "subtitle", "time": 20692.31, "timestamp": "05:44:52", "text": "[音楽]"}, {"type": "subtitle", "time": 20699.13, "timestamp": "05:44:59", "text": "ああ、私のクールな脚は"}]
[{"type": "subtitle", "time": 19382.23, "timestamp": "05:23:02", "text": "皆さん、左上に注目してください。"}, {"type": "subtitle", "time": 19386.03, "timestamp": "05:23:06", "text": "わかった。この白い点が見えますか？"}, {"type": "subtitle", "time": 19389.83, "timestamp": "05:23:09", "text": "ここ？このピクセル状の点は何ですか？分かりますか"}, {"type": "subtitle", "time": 19393.11, "timestamp": "05:23:13", "text": "マウスカーソルがあるまさにその場所ですか？"}, {"type": "subtitle", "time": 19394.99, "timestamp": "05:23:14", "text": "はぁ？何が"}, {"type": "subtitle", "time": 19396.83, "timestamp": "05:23:16", "text": "それ？なし"}, {"type": "subtitle", "time": 19400.59, "timestamp": "05:23:20", "text": "そこには。えっと、"}, {"type": "subtitle", "time": 19405.19, "timestamp": "05:23:25", "text": "えっと、ドクター3DXって誰ですか？"}, {"type": "subtitle", "time": 19407.39, "timestamp": "05:23:27", "text": "わかった。えっと、招待します"}, {"type": "subtitle", "time": 19415.31, "timestamp": "05:23:35", "text": "ダイアナ。ああ、そうだった"}, {"type": "subtitle", "time": 19428.628, "timestamp": "05:23:48", "text": "わかった。あ、待って。チートをオンにしたか？私"}, {"type": "subtitle", "time": 19430.55, "timestamp": "05:23:50", "text": "私はそう思わない。私はそうしなかったと思います。私"}, {"type": "subtitle", "time": 19438.788, "timestamp": "05:23:58", "text": "ジャカンダ待って、えっと、イスはどこから来たの？"}, {"type": "subtitle", "time": 19439.948, "timestamp": "05:23:59", "text": "日本"}]
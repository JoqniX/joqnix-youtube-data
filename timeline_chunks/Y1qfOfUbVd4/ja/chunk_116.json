[{"type": "subtitle", "time": 6961.55, "timestamp": "01:56:01", "text": "私の情報源の名前は何ですか？"}, {"type": "subtitle", "time": 6969.589, "timestamp": "01:56:09", "text": "捕獲。どの画像ですか？ディオ。待って。"}, {"type": "subtitle", "time": 6971.79, "timestamp": "01:56:11", "text": "わかった。これ"}, {"type": "subtitle", "time": 6974.27, "timestamp": "01:56:14", "text": "1つ。わかった。"}, {"type": "subtitle", "time": 6977.43, "timestamp": "01:56:17", "text": "プレイヤーのスピードがぼやけて見える。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 6980.149, "timestamp": "01:56:20", "text": "もうすぐ動作するはずです。いいえ。"}, {"type": "subtitle", "time": 6982.149, "timestamp": "01:56:22", "text": "わかった。ここでは動作するはずです。それ"}, {"type": "subtitle", "time": 6987.07, "timestamp": "01:56:27", "text": "動作するはずです。ええ、そうあるべきです。"}, {"type": "subtitle", "time": 6991.03, "timestamp": "01:56:31", "text": "わかった。そこで、チェックするようにしました。"}, {"type": "subtitle", "time": 6994.47, "timestamp": "01:56:34", "text": "私のPCを積極的にチェックしてゲームを探します。"}, {"type": "subtitle", "time": 6997.75, "timestamp": "01:56:37", "text": "exe のやつ、それから何か変更して"}, {"type": "subtitle", "time": 7000.39, "timestamp": "01:56:40", "text": "OBSでトリガー関連のものをいくつか。そうでしょう？"}, {"type": "subtitle", "time": 7002.31, "timestamp": "01:56:42", "text": "でも便利だよね？だから心配する必要はない"}, {"type": "subtitle", "time": 7004.709, "timestamp": "01:56:44", "text": "あ、ぼかしをオンにするのを忘れてた。私"}, {"type": "subtitle", "time": 7008.39, "timestamp": "01:56:48", "text": "ミニマップをぼかすのを忘れた、など"}, {"type": "subtitle", "time": 7010.79, "timestamp": "01:56:50", "text": "など。だから、心配する必要はありません。"}, {"type": "subtitle", "time": 7014.669, "timestamp": "01:56:54", "text": "私はヴァレラントApexをプレイします"}]
[{"type": "subtitle", "time": 21985.27, "timestamp": "06:06:25", "text": "ああ、GG。"}, {"type": "subtitle", "time": 21986.59, "timestamp": "06:06:26", "text": "できなかった"}, {"type": "subtitle", "time": 21990.39, "timestamp": "06:06:30", "text": "彼らはアイソレーションさえできなかった"}, {"type": "subtitle", "time": 21997.03, "timestamp": "06:06:37", "text": "もっと遊ぶこと。うん。うん。えっと、"}, {"type": "subtitle", "time": 21999.83, "timestamp": "06:06:39", "text": "私がすべてを選ぶことに決めた理由は"}, {"type": "subtitle", "time": 22002.15, "timestamp": "06:06:42", "text": "応募者は5人でした"}, {"type": "subtitle", "time": 22003.51, "timestamp": "06:06:43", "text": "応募した人々。そこで私は"}, {"type": "subtitle", "time": 22006.07, "timestamp": "06:06:46", "text": "5人で行く。では、なぜでしょうか？なぜなら"}, {"type": "subtitle", "time": 22009.35, "timestamp": "06:06:49", "text": "私は、分離するようなプロについて考えました"}, {"type": "subtitle", "time": 22013.19, "timestamp": "06:06:53", "text": "彼らの仕事は、ある種の分離である"}, {"type": "subtitle", "time": 22015.83, "timestamp": "06:06:55", "text": "Twitch での仕事など、彼らからの仕事"}, {"type": "subtitle", "time": 22019.59, "timestamp": "06:06:59", "text": "YouTube で 1 つ、Twitch で 1 つ、1 対 1"}]
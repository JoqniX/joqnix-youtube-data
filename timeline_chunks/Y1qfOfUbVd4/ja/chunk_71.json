[{"type": "subtitle", "time": 4261.35, "timestamp": "01:11:01", "text": "マルチプレイヤーゲームはたくさんある。"}, {"type": "subtitle", "time": 4263.35, "timestamp": "01:11:03", "text": "そこが問題なんです。たくさんあります"}, {"type": "subtitle", "time": 4265.59, "timestamp": "01:11:05", "text": "マルチプレイヤーゲーム。つまり、"}, {"type": "subtitle", "time": 4268.229, "timestamp": "01:11:08", "text": "マルチプレイヤーゲームの特徴は、"}, {"type": "subtitle", "time": 4270.709, "timestamp": "01:11:10", "text": "いつでも来て遊んでいただけますよ。"}, {"type": "subtitle", "time": 4273.03, "timestamp": "01:11:13", "text": "だから、ある意味では、そうするよ、って感じ。"}, {"type": "subtitle", "time": 4275.03, "timestamp": "01:11:15", "text": "後でこんな風にプレイしてみて。だから私は"}, {"type": "subtitle", "time": 4278.229, "timestamp": "01:11:18", "text": "だからプレイリストにしたんです。見る、"}, {"type": "subtitle", "time": 4280.709, "timestamp": "01:11:20", "text": "だから、私がそうしたいと思ったら、"}, {"type": "subtitle", "time": 4288.709, "timestamp": "01:11:28", "text": "ええ、でもこれから来る人たちにとっても"}, {"type": "subtitle", "time": 4291.47, "timestamp": "01:11:31", "text": "特定のタイプの"}, {"type": "subtitle", "time": 4294.149, "timestamp": "01:11:34", "text": "ゲーム。そう、だから私は与えるのが好きなんだ"}, {"type": "subtitle", "time": 4296.229, "timestamp": "01:11:36", "text": "プレイリストも好きなので、"}, {"type": "subtitle", "time": 4303.46, "timestamp": "01:11:43", "text": "に。はい、どうぞ。現代戦"}, {"type": "subtitle", "time": 4304.83, "timestamp": "01:11:44", "text": "[音楽]"}, {"type": "subtitle", "time": 4308.03, "timestamp": "01:11:48", "text": "2. 一つのメディアが多すぎる"}, {"type": "subtitle", "time": 4313.59, "timestamp": "01:11:53", "text": "1つ。ランブルは完全に消え去った。消えた。消えた。"}, {"type": "subtitle", "time": 4314.669, "timestamp": "01:11:54", "text": "そうそう、"}]
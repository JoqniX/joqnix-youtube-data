[{"type": "subtitle", "time": 5103.91, "timestamp": "01:25:03", "text": "でも、やっぱり短いゲームが好きなんです。私"}, {"type": "subtitle", "time": 5106.47, "timestamp": "01:25:06", "text": "もっとゲームのように行きたい"}, {"type": "subtitle", "time": 5108.11, "timestamp": "01:25:08", "text": "地震の種類"}, {"type": "subtitle", "time": 5111.59, "timestamp": "01:25:11", "text": "ゲームで上手くなれるように"}, {"type": "subtitle", "time": 5114.31, "timestamp": "01:25:14", "text": "テンポの速い動きと追跡タイプの"}, {"type": "subtitle", "time": 5116.79, "timestamp": "01:25:16", "text": "ゲーム。"}, {"type": "subtitle", "time": 5119.51, "timestamp": "01:25:19", "text": "でも、英語が分かれば、"}, {"type": "subtitle", "time": 5120.75, "timestamp": "01:25:20", "text": "もしそれが"}, {"type": "subtitle", "time": 5124.27, "timestamp": "01:25:24", "text": "Hです。大丈夫です。いいえ"}, {"type": "subtitle", "time": 5126.91, "timestamp": "01:25:26", "text": "心配事。いいえ、やめてください"}, {"type": "subtitle", "time": 5129.91, "timestamp": "01:25:29", "text": "心配。翻訳機を使えばいいですよ"}, {"type": "subtitle", "time": 5131.629, "timestamp": "01:25:31", "text": "ただし、あなたが"}, {"type": "subtitle", "time": 5139.79, "timestamp": "01:25:39", "text": "待って。えっと、待って。私の何だったのか待って、"}, {"type": "subtitle", "time": 5142.31, "timestamp": "01:25:42", "text": "見る。待って、私の翻訳は何だったの？"}, {"type": "subtitle", "time": 5152.08, "timestamp": "01:25:52", "text": "右。えっと、"}, {"type": "subtitle", "time": 5154.669, "timestamp": "01:25:54", "text": "[音楽]"}]
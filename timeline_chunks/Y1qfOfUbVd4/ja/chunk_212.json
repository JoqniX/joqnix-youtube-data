[{"type": "subtitle", "time": 12720.95, "timestamp": "03:32:00", "text": "ああ、もうダメだ。"}, {"type": "subtitle", "time": 12723.429, "timestamp": "03:32:03", "text": "酔っ払ったよ。待って、それは稼働中ですか"}, {"type": "subtitle", "time": 12725.19, "timestamp": "03:32:05", "text": "車両？使ってもいいですか？使ってもいいですか？できる"}, {"type": "subtitle", "time": 12728.07, "timestamp": "03:32:08", "text": "私はそれを使いますか？あ、待って。使えます。私はできる"}, {"type": "subtitle", "time": 12733.59, "timestamp": "03:32:13", "text": "これを使ってください。 F. ええと、コントロール1。行け、行け、"}, {"type": "subtitle", "time": 12738.91, "timestamp": "03:32:18", "text": "[拍手]"}, {"type": "subtitle", "time": 12743.83, "timestamp": "03:32:23", "text": "行く。彼は人を轢き殺そうとするべきだ"}, {"type": "subtitle", "time": 12747.59, "timestamp": "03:32:27", "text": "これで。それは素晴らしいですね。いいえ、私は"}, {"type": "subtitle", "time": 12749.67, "timestamp": "03:32:29", "text": "試してみるべきだ。試してみるべきだ。試してみるべきだ。"}, {"type": "subtitle", "time": 12753.349, "timestamp": "03:32:33", "text": "もし今、誰かと知り合えたら、試してみるべきだ。"}, {"type": "subtitle", "time": 12768.99, "timestamp": "03:32:48", "text": "[音楽]"}, {"type": "subtitle", "time": 12772.83, "timestamp": "03:32:52", "text": "空中を飛行する。車が見つかってよかった。"}, {"type": "subtitle", "time": 12775.67, "timestamp": "03:32:55", "text": "男。轢き殺せる人はいますか？私"}, {"type": "subtitle", "time": 12777.07, "timestamp": "03:32:57", "text": "見る"}]
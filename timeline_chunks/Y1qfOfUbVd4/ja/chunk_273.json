[{"type": "subtitle", "time": 16395.51, "timestamp": "04:33:15", "text": "秒はい、戻ってきました。展開できます"}, {"type": "subtitle", "time": 16416.23, "timestamp": "04:33:36", "text": "戦利品。いいえ、パラシュートは展開できません。おお、"}, {"type": "subtitle", "time": 16418.75, "timestamp": "04:33:38", "text": "ええと、それはある一定のものでなければなりません"}, {"type": "subtitle", "time": 16420.83, "timestamp": "04:33:40", "text": "身長または"}, {"type": "subtitle", "time": 16422.869, "timestamp": "04:33:42", "text": "何か。ところで、私はただ"}, {"type": "subtitle", "time": 16425.15, "timestamp": "04:33:45", "text": "この場所は"}, {"type": "subtitle", "time": 16427.949, "timestamp": "04:33:47", "text": "美しい。このマップは今までプレイしたことがありません。"}, {"type": "subtitle", "time": 16435.59, "timestamp": "04:33:55", "text": "これは中国の地図みたいだ。の"}]
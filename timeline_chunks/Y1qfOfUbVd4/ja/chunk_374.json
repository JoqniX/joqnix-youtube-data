[{"type": "subtitle", "time": 22461.19, "timestamp": "06:14:21", "text": "質の高いゲーム。待って、君は待って、君は"}, {"type": "subtitle", "time": 22465.07, "timestamp": "06:14:25", "text": "実際に購読するのですか？何てことだ。感謝"}, {"type": "subtitle", "time": 22469.11, "timestamp": "06:14:29", "text": "あなた。 「ああ、そうだ」って感じだった。あなたの"}, {"type": "subtitle", "time": 22470.708, "timestamp": "06:14:30", "text": "サブスクリプションはおそらく"}, {"type": "subtitle", "time": 22472.948, "timestamp": "06:14:32", "text": "なぜ。わかった。"}, {"type": "subtitle", "time": 22485.91, "timestamp": "06:14:45", "text": "彼女が望んでいたと思ったけど、うん、読んだよ"}]
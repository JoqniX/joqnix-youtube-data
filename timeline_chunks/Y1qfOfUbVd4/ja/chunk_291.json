[{"type": "subtitle", "time": 17462.23, "timestamp": "04:51:02", "text": "クリップ。今日はM. Waitによるクリップがありました。"}, {"type": "subtitle", "time": 17464.15, "timestamp": "04:51:04", "text": "この動画は何ですか？これを観たい"}, {"type": "subtitle", "time": 17467.47, "timestamp": "04:51:07", "text": "方法。これを観たい"}, {"type": "subtitle", "time": 17483.23, "timestamp": "04:51:23", "text": "ああ、味方のチームメイトを撃ってしまった。"}, {"type": "subtitle", "time": 17487.23, "timestamp": "04:51:27", "text": "あ、待って。なぜ切り取ったのですか？"}, {"type": "subtitle", "time": 17489.708, "timestamp": "04:51:29", "text": "これ？なぜ"}, {"type": "subtitle", "time": 17492.35, "timestamp": "04:51:32", "text": "クリップ？なぜ切り取ったのですか？"}, {"type": "subtitle", "time": 17497.55, "timestamp": "04:51:37", "text": "これ？それに、字幕も完全に間違っています。"}, {"type": "subtitle", "time": 17503.91, "timestamp": "04:51:43", "text": "神。何てことだ。字幕は最高"}, {"type": "subtitle", "time": 17506.31, "timestamp": "04:51:46", "text": "長さ。私は～について何かが必要です"}, {"type": "subtitle", "time": 17509.59, "timestamp": "04:51:49", "text": "字幕のこと。それは"}, {"type": "subtitle", "time": 17512.83, "timestamp": "04:51:52", "text": "私のことを完全に理解してください。だから、"}, {"type": "subtitle", "time": 17514.83, "timestamp": "04:51:54", "text": "痛み。うん。"}, {"type": "subtitle", "time": 17519.75, "timestamp": "04:51:59", "text": "こんにちは。こんにちは。まとめると"}]
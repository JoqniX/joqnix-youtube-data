[{"type": "subtitle", "time": 6841.31, "timestamp": "01:54:01", "text": "[拍手]"}, {"type": "subtitle", "time": 6862.709, "timestamp": "01:54:22", "text": "ああ、彼は私を見つけて、彼はただ単に"}, {"type": "subtitle", "time": 6864.51, "timestamp": "01:54:24", "text": "取り壊されたばかり"}, {"type": "subtitle", "time": 6874.83, "timestamp": "01:54:34", "text": "ショット。あ、待って。忘れた。忘れた。私"}, {"type": "subtitle", "time": 6894.35, "timestamp": "01:54:54", "text": "待って、なんで吹けないの？何？何？"}, {"type": "subtitle", "time": 6897.709, "timestamp": "01:54:57", "text": "どうやって？何てことだ。"}]
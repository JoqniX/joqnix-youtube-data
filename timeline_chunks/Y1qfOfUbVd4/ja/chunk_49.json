[{"type": "subtitle", "time": 2941.19, "timestamp": "00:49:01", "text": "[音楽]"}, {"type": "subtitle", "time": 2943.95, "timestamp": "00:49:03", "text": "ええ、反動制御は"}, {"type": "subtitle", "time": 2949.829, "timestamp": "00:49:09", "text": "正しい。いやいや、私はただ"}, {"type": "subtitle", "time": 2951.67, "timestamp": "00:49:11", "text": "換気口を開ける。それでおしまい。それでおしまい。送信"}, {"type": "subtitle", "time": 2954.23, "timestamp": "00:49:14", "text": "ゲームを終えてバンを手に入れた。とにかく、"}, {"type": "subtitle", "time": 2955.75, "timestamp": "00:49:15", "text": "今からアンインストールします。手に入れてみませんか？"}, {"type": "subtitle", "time": 2957.549, "timestamp": "00:49:17", "text": "通気口と呼んで"}, {"type": "subtitle", "time": 2984.47, "timestamp": "00:49:44", "text": "彼女。動きの速いゲームは私の得意分野です。"}, {"type": "subtitle", "time": 2988.309, "timestamp": "00:49:48", "text": "私は動きの速いゲームが大好きです。"}, {"type": "subtitle", "time": 2997.75, "timestamp": "00:49:57", "text": "幸運を。"}]
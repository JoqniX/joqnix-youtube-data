[{"type": "subtitle", "time": 2160.31, "timestamp": "00:36:00", "text": "おお。何てことだ。私はそう言ったことは分かっています"}, {"type": "subtitle", "time": 2169.03, "timestamp": "00:36:09", "text": "わかった。私はただ起き上がりたいだけです、それから"}, {"type": "subtitle", "time": 2171.589, "timestamp": "00:36:11", "text": "では、そこで止めてください。行くぞ、行くぞ、わかってた"}, {"type": "subtitle", "time": 2173.27, "timestamp": "00:36:13", "text": "それが下に行くことになる"}, {"type": "subtitle", "time": 2175.71, "timestamp": "00:36:15", "text": "ドレイン。だからそれは"}, {"type": "subtitle", "time": 2181.07, "timestamp": "00:36:21", "text": "右。"}, {"type": "subtitle", "time": 2183.31, "timestamp": "00:36:23", "text": "[音楽]"}, {"type": "subtitle", "time": 2185.91, "timestamp": "00:36:25", "text": "最終的には、これは"}, {"type": "subtitle", "time": 2187.74, "timestamp": "00:36:27", "text": "あれ。だから、大丈夫だよ。"}, {"type": "subtitle", "time": 2205.19, "timestamp": "00:36:45", "text": "男の子。このゲームは無料だったのですか？はい、そうでした。"}, {"type": "subtitle", "time": 2214.27, "timestamp": "00:36:54", "text": "[音楽]"}, {"type": "subtitle", "time": 2218.15, "timestamp": "00:36:58", "text": "H. ああ、なんてことだ。再び襲撃作戦を実行せよ。"}, {"type": "subtitle", "time": 2219.47, "timestamp": "00:36:59", "text": "こんにちは"}]
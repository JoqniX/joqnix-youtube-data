[{"type": "subtitle", "time": 8102.47, "timestamp": "02:15:02", "text": "壊す？待って、何か聞こえた？"}, {"type": "subtitle", "time": 8103.95, "timestamp": "02:15:03", "text": "歩いている人"}, {"type": "subtitle", "time": 8115.03, "timestamp": "02:15:15", "text": "待って、聞こえる？待って、あなたは"}, {"type": "subtitle", "time": 8117.589, "timestamp": "02:15:17", "text": "聞こえますか？聞こえますか？聞こえますか？"}, {"type": "subtitle", "time": 8119.709, "timestamp": "02:15:19", "text": "待って、聞こえる？"}, {"type": "subtitle", "time": 8124.109, "timestamp": "02:15:24", "text": "それ？待って、待って、"}, {"type": "subtitle", "time": 8130.91, "timestamp": "02:15:30", "text": "待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 8141.229, "timestamp": "02:15:41", "text": "私は怖いです。私は怖いです。誰かが話しているのが聞こえる"}]
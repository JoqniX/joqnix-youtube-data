[{"type": "subtitle", "time": 10392.07, "timestamp": "02:53:12", "text": "死ぬ。田舎道のジョーク。おお。ああ、それ"}, {"type": "subtitle", "time": 10407.349, "timestamp": "02:53:27", "text": "どうやって？何てことだ。どうやって彼を手に入れたのか？どうやって"}, {"type": "subtitle", "time": 10408.95, "timestamp": "02:53:28", "text": "彼を捕まえたのか？どうやって彼を手に入れたのか？私は"}, {"type": "subtitle", "time": 10411.79, "timestamp": "02:53:31", "text": "プロ。私は 私は 私は"}, {"type": "subtitle", "time": 10438.91, "timestamp": "02:53:58", "text": "叔父は認めた"}]
[{"type": "subtitle", "time": 4201.39, "timestamp": "01:10:01", "text": "ここからは、"}, {"type": "subtitle", "time": 4204.83, "timestamp": "01:10:04", "text": "彼ら。ああ、忘れてた。"}, {"type": "subtitle", "time": 4208.27, "timestamp": "01:10:08", "text": "行く。忘れた。ありがとうございます"}, {"type": "subtitle", "time": 4217.43, "timestamp": "01:10:17", "text": "念のため。ああ、これ、覚えてるよ。"}, {"type": "subtitle", "time": 4220.149, "timestamp": "01:10:20", "text": "うん。ほかに何か？ハンドゲーム。知っている。"}, {"type": "subtitle", "time": 4232.95, "timestamp": "01:10:32", "text": "ああ、ブループロトコルがたくさんあるとき、"}, {"type": "subtitle", "time": 4234.87, "timestamp": "01:10:34", "text": "うん。ブループロトコルストリーム。私たちはただ"}, {"type": "subtitle", "time": 4237.189, "timestamp": "01:10:37", "text": "公式にのみ継続する"}, {"type": "subtitle", "time": 4240.95, "timestamp": "01:10:40", "text": "西部地域のような場所で。わかった。私"}, {"type": "subtitle", "time": 4242.63, "timestamp": "01:10:42", "text": "日本人をプレイすべきではないと思う"}, {"type": "subtitle", "time": 4244.55, "timestamp": "01:10:44", "text": "バージョンは、私が禁止される可能性があるので、"}, {"type": "subtitle", "time": 4247.669, "timestamp": "01:10:47", "text": "何か。ええ、そうですね。"}, {"type": "subtitle", "time": 4252.03, "timestamp": "01:10:52", "text": "Xdefined もまた、"}, {"type": "subtitle", "time": 4254.87, "timestamp": "01:10:54", "text": "プレイしたが、死んでしまった"}, {"type": "subtitle", "time": 4256.669, "timestamp": "01:10:56", "text": "プレイリストはもう使えない。それはほんの一例です"}, {"type": "subtitle", "time": 4259.43, "timestamp": "01:10:59", "text": "ストリーム。ああ、見てて。しかし問題は、"}]
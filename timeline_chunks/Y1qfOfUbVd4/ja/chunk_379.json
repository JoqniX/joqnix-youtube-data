[{"type": "subtitle", "time": 22742.23, "timestamp": "06:19:02", "text": "いつかビリービリーで配信したい。"}, {"type": "subtitle", "time": 22745.548, "timestamp": "06:19:05", "text": "良い一日。良いもの"}, {"type": "subtitle", "time": 22749.15, "timestamp": "06:19:09", "text": "日をお願いします。ストリーミングしたい"}, {"type": "subtitle", "time": 22752.47, "timestamp": "06:19:12", "text": "信じられないけど、中国のIDが必要で"}, {"type": "subtitle", "time": 22754.51, "timestamp": "06:19:14", "text": "すべて"}, {"type": "subtitle", "time": 22756.75, "timestamp": "06:19:16", "text": "s しかし"}, {"type": "subtitle", "time": 22764.31, "timestamp": "06:19:24", "text": "プレイステーション。ええ、でも中国語では"}, {"type": "subtitle", "time": 22766.548, "timestamp": "06:19:26", "text": "私にはできない、それは完全に"}, {"type": "subtitle", "time": 22768.628, "timestamp": "06:19:28", "text": "新しい言語を学ぶのはとても難しい。"}, {"type": "subtitle", "time": 22770.948, "timestamp": "06:19:30", "text": "基本から学ぶ必要がある"}, {"type": "subtitle", "time": 22773.99, "timestamp": "06:19:33", "text": "今すぐ幼稚園で学ぶ"}, {"type": "subtitle", "time": 22777.43, "timestamp": "06:19:37", "text": "言語の基礎と、私はできない"}, {"type": "subtitle", "time": 22779.27, "timestamp": "06:19:39", "text": "人々が何者であるかを理解することさえ"}, {"type": "subtitle", "time": 22782.788, "timestamp": "06:19:42", "text": "中国ドラマのテレビ番組を見ると言った"}, {"type": "subtitle", "time": 22785.35, "timestamp": "06:19:45", "text": "3つと私が持っているものすべてが好きです"}, {"type": "subtitle", "time": 22788.47, "timestamp": "06:19:48", "text": "中国語のアニメを見た"}, {"type": "subtitle", "time": 22790.75, "timestamp": "06:19:50", "text": "英語の字幕付きで見たのですが、"}, {"type": "subtitle", "time": 22792.27, "timestamp": "06:19:52", "text": "ストリーマー"}, {"type": "subtitle", "time": 22794.47, "timestamp": "06:19:54", "text": "信じられないことに何も役に立たなかった私は"}, {"type": "subtitle", "time": 22796.788, "timestamp": "06:19:56", "text": "まだ理解できていないので、"}]
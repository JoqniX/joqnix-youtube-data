[{"type": "subtitle", "time": 22333.43, "timestamp": "06:12:13", "text": "桃。いや、待てよ。ああ、あなたは私が"}, {"type": "subtitle", "time": 22336.51, "timestamp": "06:12:16", "text": "ストリーミング配信を行う。はい。何てことだ。感謝"}, {"type": "subtitle", "time": 22359.27, "timestamp": "06:12:39", "text": "そうする必要はなかった。でも、ありがとうございます。私は"}, {"type": "subtitle", "time": 22360.67, "timestamp": "06:12:40", "text": "試みている"}, {"type": "subtitle", "time": 22362.99, "timestamp": "06:12:42", "text": "私が持っていた種類"}, {"type": "subtitle", "time": 22366.47, "timestamp": "06:12:46", "text": "私は人質にされていた。そこには何もありませんでした。"}, {"type": "subtitle", "time": 22369.35, "timestamp": "06:12:49", "text": "誰があなたを人質にしていたのですか？そこには何もありませんでした。しかし"}, {"type": "subtitle", "time": 22371.43, "timestamp": "06:12:51", "text": "ええ、繰り返しますが、私は誰にも強制したくありません"}, {"type": "subtitle", "time": 22374.83, "timestamp": "06:12:54", "text": "代用する。わかった。または、フォローする。"}, {"type": "subtitle", "time": 22377.59, "timestamp": "06:12:57", "text": "覚えておいてください、フォローまたは購読するのは、"}, {"type": "subtitle", "time": 22379.31, "timestamp": "06:12:59", "text": "あなたはしたい。"}]
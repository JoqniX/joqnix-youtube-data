[{"type": "subtitle", "time": 9182.75, "timestamp": "02:33:02", "text": "正直に言うと超"}, {"type": "subtitle", "time": 9185.51, "timestamp": "02:33:05", "text": "時々怖い。いいえ、これらのゲームは"}, {"type": "subtitle", "time": 9188.63, "timestamp": "02:33:08", "text": "ホラー映画のような感じ"}, {"type": "subtitle", "time": 9191.59, "timestamp": "02:33:11", "text": "まるで自分が唯一の生存者だと知っているかのように"}, {"type": "subtitle", "time": 9193.83, "timestamp": "02:33:13", "text": "あなたは自分一人しかいないことを知っている"}, {"type": "subtitle", "time": 9196.71, "timestamp": "02:33:16", "text": "人生は一度きり。生き延びなければならない。"}, {"type": "subtitle", "time": 9198.79, "timestamp": "02:33:18", "text": "もし私にチームメイトがいたら、私は"}, {"type": "subtitle", "time": 9201.51, "timestamp": "02:33:21", "text": "うん、君は私のことをチェックするだろう、君は言うだろう"}, {"type": "subtitle", "time": 9204.389, "timestamp": "02:33:24", "text": "私の背中を守るとか何とかだけど、ここに"}, {"type": "subtitle", "time": 9207.63, "timestamp": "02:33:27", "text": "それはまるで"}, {"type": "subtitle", "time": 9210.51, "timestamp": "02:33:30", "text": "そう、一人で生き残らなければならないし"}, {"type": "subtitle", "time": 9220.59, "timestamp": "02:33:40", "text": "痛み。えっと、どうすれば"}, {"type": "subtitle", "time": 9229.59, "timestamp": "02:33:49", "text": "1つ。視界距離も"}, {"type": "subtitle", "time": 9238.59, "timestamp": "02:33:58", "text": "[音楽]"}]
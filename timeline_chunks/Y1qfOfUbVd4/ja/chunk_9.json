[{"type": "subtitle", "time": 564.03, "timestamp": "00:09:24", "text": "何？こんにちは"}, {"type": "subtitle", "time": 566.71, "timestamp": "00:09:26", "text": "そこには。うん。こんにちは、レックス。ようこそ"}, {"type": "subtitle", "time": 567.829, "timestamp": "00:09:27", "text": "ストリーム。お元気でお過ごしでしょうか。どうだったか"}, {"type": "subtitle", "time": 579.269, "timestamp": "00:09:39", "text": "あなた？おやすみ。ああ、あなたは理解しました。ああ、よかった。"}, {"type": "subtitle", "time": 586.87, "timestamp": "00:09:46", "text": "頭いい。いや、違う。私は死んだと思う。"}, {"type": "subtitle", "time": 589.19, "timestamp": "00:09:49", "text": "何？幸運を。どこで入手できますか"}, {"type": "subtitle", "time": 591.59, "timestamp": "00:09:51", "text": "このゲーム？このゲームは以下で購入できます"}, {"type": "subtitle", "time": 594.87, "timestamp": "00:09:54", "text": "Steamで無料配信中。実際に入手可能"}, {"type": "subtitle", "time": 596.91, "timestamp": "00:09:56", "text": "Playストアだと思います。"}, {"type": "subtitle", "time": 599.19, "timestamp": "00:09:59", "text": "うん。そして、あなたの最初の"}]
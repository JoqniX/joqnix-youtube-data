[{"type": "subtitle", "time": 22405.27, "timestamp": "06:13:25", "text": "女王様、あなたの体に吸血鬼の噛み跡があります"}, {"type": "subtitle", "time": 22406.948, "timestamp": "06:13:26", "text": "お母さん。ああ、いや、いや、いや、いや、いや。それは違う"}, {"type": "subtitle", "time": 22408.59, "timestamp": "06:13:28", "text": "吸血鬼"}, {"type": "subtitle", "time": 22412.35, "timestamp": "06:13:32", "text": "噛む。それが私の識別マークです。"}, {"type": "subtitle", "time": 22416.948, "timestamp": "06:13:36", "text": "現実世界の出来事。私は文字通り3つ持っています"}, {"type": "subtitle", "time": 22420.39, "timestamp": "06:13:40", "text": "ほくろみたいなやつ、パッチみたいなやつ"}, {"type": "subtitle", "time": 22422.11, "timestamp": "06:13:42", "text": "黒のような"}, {"type": "subtitle", "time": 22423.948, "timestamp": "06:13:43", "text": "あれ。"}, {"type": "subtitle", "time": 22428.628, "timestamp": "06:13:48", "text": "だから私は現実の自分を融合させたかった"}]
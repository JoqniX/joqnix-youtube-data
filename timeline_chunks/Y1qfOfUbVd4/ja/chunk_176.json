[{"type": "subtitle", "time": 10561.389, "timestamp": "02:56:01", "text": "いい子だ。そして今は眠りなさい。"}, {"type": "subtitle", "time": 10571.349, "timestamp": "02:56:11", "text": "バカだな、そうだったのか？ああ、バックパックを叩いたよ"}, {"type": "subtitle", "time": 10578.8, "timestamp": "02:56:18", "text": "それ。"}, {"type": "subtitle", "time": 10580.67, "timestamp": "02:56:20", "text": "[音楽]"}, {"type": "subtitle", "time": 10592.389, "timestamp": "02:56:32", "text": "ショットガン。おお。ああ、それはそれはそれはそれは"}, {"type": "subtitle", "time": 10599.83, "timestamp": "02:56:39", "text": "神。クロスボウを使ってもいいですか？したい"}, {"type": "subtitle", "time": 10603.63, "timestamp": "02:56:43", "text": "十字架を使え。私はそうは思わない"}, {"type": "subtitle", "time": 10607.349, "timestamp": "02:56:47", "text": "今はそうあるべきだ。誰が私に向かってくるんだ？幾つか"}]
[{"type": "subtitle", "time": 1153.47, "timestamp": "00:19:13", "text": "[音楽]"}, {"type": "subtitle", "time": 1156.19, "timestamp": "00:19:16", "text": "マーク。"}, {"type": "subtitle", "time": 1159.029, "timestamp": "00:19:19", "text": "いいえ。大丈夫。それが現実さ。しないで"}, {"type": "subtitle", "time": 1168.99, "timestamp": "00:19:28", "text": "私はむしろ"}, {"type": "subtitle", "time": 1171.35, "timestamp": "00:19:31", "text": "遊ぶ。もっと良いゲームを見つけたい"}, {"type": "subtitle", "time": 1173.669, "timestamp": "00:19:33", "text": "けれど。私は大丈夫です。でもそれは"}, {"type": "subtitle", "time": 1175.11, "timestamp": "00:19:35", "text": "私はこのゲームを続けるつもりはない"}, {"type": "subtitle", "time": 1176.11, "timestamp": "00:19:36", "text": "ゲーム"}, {"type": "subtitle", "time": 1178.95, "timestamp": "00:19:38", "text": "配信後。明らかに、"}, {"type": "subtitle", "time": 1181.669, "timestamp": "00:19:41", "text": "アンインストールしたいのですが、私は"}, {"type": "subtitle", "time": 1184.75, "timestamp": "00:19:44", "text": "ゲームを探しています。ああ、もう。"}, {"type": "subtitle", "time": 1188.99, "timestamp": "00:19:48", "text": "[拍手]"}]
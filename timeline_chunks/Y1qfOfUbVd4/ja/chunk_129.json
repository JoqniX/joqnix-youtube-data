[{"type": "subtitle", "time": 7744.31, "timestamp": "02:09:04", "text": "うんうん。あ、待って。間違ったスイッチを入れてしまった"}, {"type": "subtitle", "time": 7746.39, "timestamp": "02:09:06", "text": "シーン。 H. 申し訳ありません。ああ、それは"}, {"type": "subtitle", "time": 7749.55, "timestamp": "02:09:09", "text": "垂直に流れるはずの流れ。"}, {"type": "subtitle", "time": 7752.02, "timestamp": "02:09:12", "text": "えっと、待って。どこにある"}, {"type": "subtitle", "time": 7754.75, "timestamp": "02:09:14", "text": "[音楽]"}, {"type": "subtitle", "time": 7756.83, "timestamp": "02:09:16", "text": "あれ？ああ、それは"}, {"type": "subtitle", "time": 7760.79, "timestamp": "02:09:20", "text": "わかった。後で考えます。"}, {"type": "subtitle", "time": 7763.03, "timestamp": "02:09:23", "text": "私のプレイヤーアカウントが表示されません。私は"}, {"type": "subtitle", "time": 7764.109, "timestamp": "02:09:24", "text": "それを実行する"}, {"type": "subtitle", "time": 7768.189, "timestamp": "02:09:28", "text": "昨日？そうだったよね？しかし、"}, {"type": "subtitle", "time": 7771.83, "timestamp": "02:09:31", "text": "それ？私はやっていません。待って、私に"}, {"type": "subtitle", "time": 7775.87, "timestamp": "02:09:35", "text": "縦方向のストリーム用にトリミングしてください。 1つ"}, {"type": "subtitle", "time": 7778.189, "timestamp": "02:09:38", "text": "秒"}, {"type": "subtitle", "time": 7780.149, "timestamp": "02:09:40", "text": "ええと、"}, {"type": "subtitle", "time": 7781.669, "timestamp": "02:09:41", "text": "垂直ストリーム、申し訳ありませんが"}, {"type": "subtitle", "time": 7792.149, "timestamp": "02:09:52", "text": "さて、これで何人が"}, {"type": "subtitle", "time": 7794.149, "timestamp": "02:09:54", "text": "生きている。えっと、どこに行くんですか？さあ行こう"}, {"type": "subtitle", "time": 7797.589, "timestamp": "02:09:57", "text": "あの納屋へ。そこへはどうやって行くのですか？"}]
[{"type": "subtitle", "time": 12183.79, "timestamp": "03:23:03", "text": "これは実際にはPC版のPUBGです。の"}, {"type": "subtitle", "time": 12190.429, "timestamp": "03:23:10", "text": "調子はどう？"}, {"type": "subtitle", "time": 12195.71, "timestamp": "03:23:15", "text": "の上？ 115は恐らく再装填するだろう"}, {"type": "subtitle", "time": 12198.67, "timestamp": "03:23:18", "text": "私のなぜ私の"}, {"type": "subtitle", "time": 12205.389, "timestamp": "03:23:25", "text": "待って、"}, {"type": "subtitle", "time": 12209.19, "timestamp": "03:23:29", "text": "私のキーボードで「2」が機能しません。私"}, {"type": "subtitle", "time": 12217.309, "timestamp": "03:23:37", "text": "彼は誰だったのか"}, {"type": "subtitle", "time": 12224.75, "timestamp": "03:23:44", "text": "右。誰かが"}, {"type": "subtitle", "time": 12234.91, "timestamp": "03:23:54", "text": "[音楽]"}, {"type": "subtitle", "time": 12237.309, "timestamp": "03:23:57", "text": "マーク。"}]
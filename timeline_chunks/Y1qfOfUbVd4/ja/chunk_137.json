[{"type": "subtitle", "time": 8220.309, "timestamp": "02:17:00", "text": "歩くもの？オフにすべきでしょうか？"}, {"type": "subtitle", "time": 8222.79, "timestamp": "02:17:02", "text": "ストリーミング音楽？聞こえますか、それとも"}, {"type": "subtitle", "time": 8224.349, "timestamp": "02:17:04", "text": "私だけ"}, {"type": "subtitle", "time": 8233.91, "timestamp": "02:17:13", "text": "オーディオ？あ、待って。 3Dオーディオに対応していますか？"}, {"type": "subtitle", "time": 8236.87, "timestamp": "02:17:16", "text": "また？えっと、何ていう名前でしたっけ？えっと"}, {"type": "subtitle", "time": 8239.589, "timestamp": "02:17:19", "text": "神よ、それは何という名前でしたっけ？えっと、私は"}, {"type": "subtitle", "time": 8251.95, "timestamp": "02:17:31", "text": "落とす。それはそこから来ているのですか？"}, {"type": "subtitle", "time": 8265.23, "timestamp": "02:17:45", "text": "誰のものでもない"}, {"type": "subtitle", "time": 8268.91, "timestamp": "02:17:48", "text": "ここ。ああ、これをいただきます。どうもありがとうございました"}, {"type": "subtitle", "time": 8271.27, "timestamp": "02:17:51", "text": "多くの。懐中電灯。それは一体何ですか？"}, {"type": "subtitle", "time": 8279.709, "timestamp": "02:17:59", "text": "弾薬。でも、ノックしてたのは誰だったのか、"}]
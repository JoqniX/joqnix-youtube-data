[{"type": "subtitle", "time": 7448.75, "timestamp": "02:04:08", "text": "私の"}, {"type": "subtitle", "time": 7451.589, "timestamp": "02:04:11", "text": "できません。ああ、ひどく叩かれてるよ。"}, {"type": "subtitle", "time": 7457.43, "timestamp": "02:04:17", "text": "わかった。私は負けない、私は倒れない。私"}, {"type": "subtitle", "time": 7476.47, "timestamp": "02:04:36", "text": "ショット。彼はどこにいますか？彼はどこにいますか？どこ"}, {"type": "subtitle", "time": 7493.53, "timestamp": "02:04:53", "text": "サイン"}]
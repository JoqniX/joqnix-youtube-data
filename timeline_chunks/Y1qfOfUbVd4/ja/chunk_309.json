[{"type": "subtitle", "time": 18560.19, "timestamp": "05:09:20", "text": "ああ。"}, {"type": "subtitle", "time": 18561.788, "timestamp": "05:09:21", "text": "くそ。"}, {"type": "subtitle", "time": 18565.19, "timestamp": "05:09:25", "text": "ああ。うん。こんにちは。日本語でも発音します"}, {"type": "subtitle", "time": 18568.628, "timestamp": "05:09:28", "text": "サーバ。日本サーバーではありません。実際は、えーと"}, {"type": "subtitle", "time": 18570.19, "timestamp": "05:09:30", "text": "日本語"}, {"type": "subtitle", "time": 18573.07, "timestamp": "05:09:33", "text": "文章。私はまだ"}, {"type": "subtitle", "time": 18577.91, "timestamp": "05:09:37", "text": "ムンバイ。ああ、なんてことだ、みんな。 AWPはただ"}, {"type": "subtitle", "time": 18579.15, "timestamp": "05:09:39", "text": "AMP"}, {"type": "subtitle", "time": 18583.97, "timestamp": "05:09:43", "text": "うるさい。えっと、音量を下げたかったんです。"}, {"type": "subtitle", "time": 18592.39, "timestamp": "05:09:52", "text": "かわいそうに、彼は実際にプレーしないことを考えた"}]
[{"type": "subtitle", "time": 12601.99, "timestamp": "03:30:01", "text": "わかった。だから、飲み物を飲んだり、"}, {"type": "subtitle", "time": 12606.07, "timestamp": "03:30:06", "text": "それを世界中に届けるための何か。"}, {"type": "subtitle", "time": 12608.79, "timestamp": "03:30:08", "text": "[拍手]"}, {"type": "subtitle", "time": 12625.55, "timestamp": "03:30:25", "text": "そこには？"}, {"type": "subtitle", "time": 12631.229, "timestamp": "03:30:31", "text": "はぁ？"}, {"type": "subtitle", "time": 12642.11, "timestamp": "03:30:42", "text": "H. ああ、なんてことだ。なぜサウンドシステムは"}]
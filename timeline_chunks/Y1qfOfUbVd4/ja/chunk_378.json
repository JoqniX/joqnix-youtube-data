[{"type": "subtitle", "time": 22697.628, "timestamp": "06:18:17", "text": "えっと、なんて言えばいいんだろう？えっと、それはちょっと"}, {"type": "subtitle", "time": 22700.628, "timestamp": "06:18:20", "text": "あちこちで。文法ミスすべて"}, {"type": "subtitle", "time": 22703.35, "timestamp": "06:18:23", "text": "あちこちに散らばっている。それは"}, {"type": "subtitle", "time": 22705.19, "timestamp": "06:18:25", "text": "私はアニメをたくさん見ていて"}, {"type": "subtitle", "time": 22708.19, "timestamp": "06:18:28", "text": "日本のコンテンツも消費している"}, {"type": "subtitle", "time": 22713.59, "timestamp": "06:18:33", "text": "私が理解できたことは"}, {"type": "subtitle", "time": 22715.83, "timestamp": "06:18:35", "text": "相手はそうです。私は良い"}, {"type": "subtitle", "time": 22718.07, "timestamp": "06:18:38", "text": "リスナー。大丈夫です。それが私にできることです"}, {"type": "subtitle", "time": 22720.31, "timestamp": "06:18:40", "text": "言う。他の人が何を言っているのか理解できない"}, {"type": "subtitle", "time": 22722.15, "timestamp": "06:18:42", "text": "その人は日本語で言っているが、私は"}, {"type": "subtitle", "time": 22723.948, "timestamp": "06:18:43", "text": "読み書きができない"}, {"type": "subtitle", "time": 22727.03, "timestamp": "06:18:47", "text": "残念ながら。でも、私はそれを実現しようと努力しています。私は"}, {"type": "subtitle", "time": 22730.39, "timestamp": "06:18:50", "text": "まるで自分がどうやって"}, {"type": "subtitle", "time": 22732.948, "timestamp": "06:18:52", "text": "日本語を学ぶことができた"}, {"type": "subtitle", "time": 22736.27, "timestamp": "06:18:56", "text": "実際にそれを学んだ瞬間。"}, {"type": "subtitle", "time": 22739.43, "timestamp": "06:18:59", "text": "えっと、中国語、特に北京語は、"}]
[{"type": "subtitle", "time": 9017.23, "timestamp": "02:30:17", "text": "お願いします。君ならできるよ。信じる"}, {"type": "subtitle", "time": 9026.55, "timestamp": "02:30:26", "text": "生存者。大丈夫、できるよ。私は遭遇しています"}, {"type": "subtitle", "time": 9029.91, "timestamp": "02:30:29", "text": "開けた野原。何てことだ。私は走っています"}, {"type": "subtitle", "time": 9032.03, "timestamp": "02:30:32", "text": "開けた野原へ。ああ、"}, {"type": "subtitle", "time": 9035.07, "timestamp": "02:30:35", "text": "神。何てことだ。私は行きます"}, {"type": "subtitle", "time": 9038.28, "timestamp": "02:30:38", "text": "取得するため"}, {"type": "subtitle", "time": 9049.469, "timestamp": "02:30:49", "text": "押しつぶされた。何てことだ。何てことだ。ああ、"}]
[{"type": "subtitle", "time": 18000.07, "timestamp": "05:00:00", "text": "こんにちは。だから私は、はい、私は自分の"}, {"type": "subtitle", "time": 18002.11, "timestamp": "05:00:02", "text": "ヴァレラントへ"}, {"type": "subtitle", "time": 18005.19, "timestamp": "05:00:05", "text": "日本語。私は日本人と遊んだことがない"}, {"type": "subtitle", "time": 18008.55, "timestamp": "05:00:08", "text": "バレラント。だから私はそうしようと思った"}, {"type": "subtitle", "time": 18022.948, "timestamp": "05:00:22", "text": "何でも。そう、これが新しい"}, {"type": "subtitle", "time": 18025.03, "timestamp": "05:00:25", "text": "ご覧のとおり、左側のエージェント"}, {"type": "subtitle", "time": 18027.67, "timestamp": "05:00:27", "text": "これは、"}, {"type": "subtitle", "time": 18029.91, "timestamp": "05:00:29", "text": "遊んだりとか。試合ができるといいな"}, {"type": "subtitle", "time": 18033.35, "timestamp": "05:00:33", "text": "彼には、私はゲームパスを公開しているからです"}, {"type": "subtitle", "time": 18036.39, "timestamp": "05:00:36", "text": "そして、私は彼を演じられると信じています。えっと、"}, {"type": "subtitle", "time": 18038.948, "timestamp": "05:00:38", "text": "エージェント選択画面はどこですか？はい、"}, {"type": "subtitle", "time": 18041.47, "timestamp": "05:00:41", "text": "私は彼を演じることができます。"}, {"type": "subtitle", "time": 18043.948, "timestamp": "05:00:43", "text": "はい。"}, {"type": "subtitle", "time": 18045.99, "timestamp": "05:00:45", "text": "待って、待って、待って、待って。何？何が"}, {"type": "subtitle", "time": 18048.868, "timestamp": "05:00:48", "text": "これは書かれたものですか？私は字が読めません。待って、"}, {"type": "subtitle", "time": 18051.19, "timestamp": "05:00:51", "text": "彼をプレイしてもいいですか？それともプレイしてはいけないのですか？それは"}, {"type": "subtitle", "time": 18052.19, "timestamp": "05:00:52", "text": "の"}, {"type": "subtitle", "time": 18055.788, "timestamp": "05:00:55", "text": "質問。えっと、僕が彼を演じてもいいですよね？"}, {"type": "subtitle", "time": 18059.67, "timestamp": "05:00:59", "text": "ちょっと待って、混乱してる。"}]
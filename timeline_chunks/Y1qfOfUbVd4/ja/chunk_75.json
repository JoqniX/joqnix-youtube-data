[{"type": "subtitle", "time": 4501.83, "timestamp": "01:15:01", "text": "何？待って、それで私はプレイリストを持っているの"}, {"type": "subtitle", "time": 4503.75, "timestamp": "01:15:03", "text": "コラボとか色々。待って、それは"}, {"type": "subtitle", "time": 4531.07, "timestamp": "01:15:31", "text": "非公開。待って、どうやって"}, {"type": "subtitle", "time": 4534.03, "timestamp": "01:15:34", "text": "待って、どうすればいいの？"}, {"type": "subtitle", "time": 4537.59, "timestamp": "01:15:37", "text": "私自身も知らない。それは後で直します。"}, {"type": "subtitle", "time": 4538.43, "timestamp": "01:15:38", "text": "しかし"}, {"type": "subtitle", "time": 4548.11, "timestamp": "01:15:48", "text": "うん。たくさんのプレイリストがあります"}, {"type": "subtitle", "time": 4550.95, "timestamp": "01:15:50", "text": "今。いくつか変更する必要があるかもしれない"}, {"type": "subtitle", "time": 4553.27, "timestamp": "01:15:53", "text": "将来的に作るために"}]
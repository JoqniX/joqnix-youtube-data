[{"type": "subtitle", "time": 6060.28, "timestamp": "01:41:00", "text": "私に聞いて？それは なぜならDiscordだから"}, {"type": "subtitle", "time": 6063.08, "timestamp": "01:41:03", "text": "なぜならDiscordだから クエスト 私はただゲームをダウンロードしただけです"}, {"type": "subtitle", "time": 6066.719, "timestamp": "01:41:06", "text": "クエスト 私はただゲームをダウンロードしただけです Discordクエストはこんな感じだった"}, {"type": "subtitle", "time": 6081.51, "timestamp": "01:41:21", "text": "答え。つまり、私はプレイしたことがないんです"}, {"type": "subtitle", "time": 6083.83, "timestamp": "01:41:23", "text": "このゲームをかなり長い間プレイしていた。それで、"}, {"type": "subtitle", "time": 6086.39, "timestamp": "01:41:26", "text": "「ああ、どっちにしても行くよ」って感じだった。"}, {"type": "subtitle", "time": 6088.709, "timestamp": "01:41:28", "text": "ストリームのためにプレイして"}, {"type": "subtitle", "time": 6095.27, "timestamp": "01:41:35", "text": "ああ、こんにちは、ペギー。ようこそ、ようこそ。"}, {"type": "subtitle", "time": 6097.87, "timestamp": "01:41:37", "text": "お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 6100.95, "timestamp": "01:41:40", "text": "良い。ええ、そうですね。えーと、では本題に入りましょう。"}, {"type": "subtitle", "time": 6103.75, "timestamp": "01:41:43", "text": "私は推測する。えっと、未知の戦場をプレイしてみてください。"}, {"type": "subtitle", "time": 6109.31, "timestamp": "01:41:49", "text": "もし私が持っていたら、私は持っていたら、"}, {"type": "subtitle", "time": 6113.55, "timestamp": "01:41:53", "text": "えっと、もし私が"}, {"type": "subtitle", "time": 6119.59, "timestamp": "01:41:59", "text": "私のマウスの設定です。私はそうは思いません。それで、えっと、私は"}]
[{"type": "subtitle", "time": 1571.029, "timestamp": "00:26:11", "text": "[音楽]"}, {"type": "subtitle", "time": 1574.07, "timestamp": "00:26:14", "text": "正直に言ってください。私は待たない。わからない"}, {"type": "subtitle", "time": 1605.1, "timestamp": "00:26:45", "text": "アドバンテージ。"}, {"type": "subtitle", "time": 1616.63, "timestamp": "00:26:56", "text": "おお。まるでその一つみたいだ。えっと、私は行くと思います"}]
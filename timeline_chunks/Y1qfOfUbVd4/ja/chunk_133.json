[{"type": "subtitle", "time": 7985.35, "timestamp": "02:13:05", "text": "シュート。今行ってる。今行ってる。私は"}, {"type": "subtitle", "time": 7987.39, "timestamp": "02:13:07", "text": "来るよ。"}, {"type": "subtitle", "time": 8016.27, "timestamp": "02:13:36", "text": "ニース。"}, {"type": "subtitle", "time": 8026.109, "timestamp": "02:13:46", "text": "SKS。えっと、SKSを使うべきでしょうか？私も使っています"}, {"type": "subtitle", "time": 8027.95, "timestamp": "02:13:47", "text": "SKS。なぜ"}, {"type": "subtitle", "time": 8032.55, "timestamp": "02:13:52", "text": "ない？ほら、レーザーがあるでしょ。ニース。だれの"}]
[{"type": "subtitle", "time": 21621.27, "timestamp": "06:00:21", "text": "私は無理をしすぎている。"}, {"type": "subtitle", "time": 21628.75, "timestamp": "06:00:28", "text": "これは、"}, {"type": "subtitle", "time": 21647.83, "timestamp": "06:00:47", "text": "野菜とか、その他いろいろ。ゴメ、"}, {"type": "subtitle", "time": 21649.83, "timestamp": "06:00:49", "text": "今あなたのチャットを見ています"}, {"type": "subtitle", "time": 21652.868, "timestamp": "06:00:52", "text": "なぜなら、読み込まれなかったからです。そうしなければならなかった"}, {"type": "subtitle", "time": 21655.47, "timestamp": "06:00:55", "text": "更新します。私はこう思った。"}, {"type": "subtitle", "time": 21658.15, "timestamp": "06:00:58", "text": "待って、なぜチャットが動かないの？"}]
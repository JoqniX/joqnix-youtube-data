[{"type": "subtitle", "time": 601.71, "timestamp": "00:10:01", "text": "質問？何"}, {"type": "subtitle", "time": 617.269, "timestamp": "00:10:17", "text": "わかった。そしてこれは私が調べているものです"}, {"type": "subtitle", "time": 619.43, "timestamp": "00:10:19", "text": "画面。元気ですか？ああ、わかりました。わかった。"}, {"type": "subtitle", "time": 622.87, "timestamp": "00:10:22", "text": "うん。昨日私はいいえ私は待って私は私は"}, {"type": "subtitle", "time": 625.03, "timestamp": "00:10:25", "text": "昨日ではなく、その前の日にプレイしています"}, {"type": "subtitle", "time": 626.75, "timestamp": "00:10:26", "text": "昨日私は遊んでいました"}, {"type": "subtitle", "time": 630.59, "timestamp": "00:10:30", "text": "粉砕って何て言うんだっけ？"}, {"type": "subtitle", "time": 633.87, "timestamp": "00:10:33", "text": "神様、セバー"}, {"type": "subtitle", "time": 636.949, "timestamp": "00:10:36", "text": "スチールなので、私は速いペースを探していました"}, {"type": "subtitle", "time": 639.99, "timestamp": "00:10:39", "text": "私がこれを見つけたゲームはいくつかあります。"}, {"type": "subtitle", "time": 643.269, "timestamp": "00:10:43", "text": "スチームだったので、試してみました"}, {"type": "subtitle", "time": 646.389, "timestamp": "00:10:46", "text": "うん、楽しそうだね。"}, {"type": "subtitle", "time": 649.31, "timestamp": "00:10:49", "text": "このゲームは、あなたがパルパーのようにできるということです"}, {"type": "subtitle", "time": 653.87, "timestamp": "00:10:53", "text": "楽しそうに見える"}]
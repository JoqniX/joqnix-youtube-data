[{"type": "subtitle", "time": 22503.67, "timestamp": "06:15:03", "text": "そうですね、今のところ、もし私が望むなら"}, {"type": "subtitle", "time": 22507.19, "timestamp": "06:15:07", "text": "面倒なことはしたくないと言う"}, {"type": "subtitle", "time": 22511.35, "timestamp": "06:15:11", "text": "待ち伏せ攻撃を心配している。だから、もし私が"}, {"type": "subtitle", "time": 22513.51, "timestamp": "06:15:13", "text": "心配しないでください、私は心配します"}, {"type": "subtitle", "time": 22516.708, "timestamp": "06:15:16", "text": "とてもそうです。"}, {"type": "subtitle", "time": 22518.19, "timestamp": "06:15:18", "text": "それはまずい。"}, {"type": "subtitle", "time": 22521.27, "timestamp": "06:15:21", "text": "悪い。うん。だから心配しないでって言ってるんだよ"}, {"type": "subtitle", "time": 22524.07, "timestamp": "06:15:24", "text": "それについて。"}, {"type": "subtitle", "time": 22556.07, "timestamp": "06:15:56", "text": "いいえ。殺さないでください。まさか"}, {"type": "subtitle", "time": 22559.708, "timestamp": "06:15:59", "text": "はい、私は手を伸ばして殺します"}]
[{"type": "subtitle", "time": 12961.429, "timestamp": "03:36:01", "text": "あなた。お前を捕まえに行くぞ。"}, {"type": "subtitle", "time": 12966.11, "timestamp": "03:36:06", "text": "[音楽]"}, {"type": "subtitle", "time": 12976.03, "timestamp": "03:36:16", "text": "待って。何てことだ。あなたは賢いですね。あなたは賢い"}, {"type": "subtitle", "time": 12979.349, "timestamp": "03:36:19", "text": "男。何てことだ。君は賢いね。私は行きます"}, {"type": "subtitle", "time": 12982.469, "timestamp": "03:36:22", "text": "行き続ける。バイバイ。そのゾーンでは死ぬ。"}, {"type": "subtitle", "time": 12985.429, "timestamp": "03:36:25", "text": "わかった。私はワイルド・スピードを観に行く"}, {"type": "subtitle", "time": 12990.63, "timestamp": "03:36:30", "text": "ここ。何てことだ。私は彼を殺すことができなかった。私"}, {"type": "subtitle", "time": 13011.429, "timestamp": "03:36:51", "text": "男の子。こちらにも車が1台あります。私がしなければならない"}]
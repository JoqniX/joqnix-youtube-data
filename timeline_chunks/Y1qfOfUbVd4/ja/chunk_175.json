[{"type": "subtitle", "time": 10520.55, "timestamp": "02:55:20", "text": "兄弟。君を殴ったよ。私はあなたを攻撃した。私は打った"}, {"type": "subtitle", "time": 10527.11, "timestamp": "02:55:27", "text": "ああ、大丈夫です。大丈夫、できるよ。大丈夫、できるよ。"}, {"type": "subtitle", "time": 10530.79, "timestamp": "02:55:30", "text": "私はその男に近づかないようにした。"}, {"type": "subtitle", "time": 10537.95, "timestamp": "02:55:37", "text": "D. 私はゲーマーとして優れている"}, {"type": "subtitle", "time": 10551.79, "timestamp": "02:55:51", "text": "ああ、私は殺した"}, {"type": "subtitle", "time": 10553.55, "timestamp": "02:55:53", "text": "あなた。"}, {"type": "subtitle", "time": 10556.87, "timestamp": "02:55:56", "text": "RIP。ご尽力に感謝いたします。あなたは"}]
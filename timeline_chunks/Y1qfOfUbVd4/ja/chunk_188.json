[{"type": "subtitle", "time": 11284.389, "timestamp": "03:08:04", "text": "生きている。全部閉店したって言ってくれよ。閉店"}, {"type": "subtitle", "time": 11287.03, "timestamp": "03:08:07", "text": "で。"}, {"type": "subtitle", "time": 11294.63, "timestamp": "03:08:14", "text": "何？このゲームにはないと思う"}, {"type": "subtitle", "time": 11298.11, "timestamp": "03:08:18", "text": "けれど。確認してみます。こちらへどうぞ"}, {"type": "subtitle", "time": 11300.67, "timestamp": "03:08:20", "text": "場所。試してみてください"}, {"type": "subtitle", "time": 11304.03, "timestamp": "03:08:24", "text": "チェック。つまり、ゲームプレイ中に実装されるということです。"}, {"type": "subtitle", "time": 11307.75, "timestamp": "03:08:27", "text": "いいえ。パンチオンはデフォルトです。ええ、そうあるべきです"}, {"type": "subtitle", "time": 11309.75, "timestamp": "03:08:29", "text": "ここ。ランニング関連のものですが、そうではありません"}, {"type": "subtitle", "time": 11311.55, "timestamp": "03:08:31", "text": "そこには。発射モード、アクティブ"}, {"type": "subtitle", "time": 11322.87, "timestamp": "03:08:42", "text": "何か聞こえた。何か聞こえた。私"}, {"type": "subtitle", "time": 11330.67, "timestamp": "03:08:50", "text": "もの。の"}, {"type": "subtitle", "time": 11332.99, "timestamp": "03:08:52", "text": "電話。誰が"}, {"type": "subtitle", "time": 11336.55, "timestamp": "03:08:56", "text": "それ？何てことだ。何てことだ。私は手に入れている"}]
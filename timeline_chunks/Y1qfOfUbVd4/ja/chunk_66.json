[{"type": "subtitle", "time": 3961.27, "timestamp": "01:06:01", "text": "例えばゲームのプレイリストのように、"}, {"type": "subtitle", "time": 3962.87, "timestamp": "01:06:02", "text": "右？"}, {"type": "subtitle", "time": 3965.99, "timestamp": "01:06:05", "text": "このプレイリストを整理したい気分です"}, {"type": "subtitle", "time": 3968.47, "timestamp": "01:06:08", "text": "複数のストリームがあり、"}, {"type": "subtitle", "time": 3970.87, "timestamp": "01:06:10", "text": "1つか2つの流れですよね？置くよ"}, {"type": "subtitle", "time": 3973.029, "timestamp": "01:06:13", "text": "降順。最も高いもの"}, {"type": "subtitle", "time": 3975.19, "timestamp": "01:06:15", "text": "ゲームプレイリストに追加されます。素晴らしい"}, {"type": "subtitle", "time": 3977.349, "timestamp": "01:06:17", "text": "ゲームプレイリストは、複数の"}, {"type": "subtitle", "time": 3980.19, "timestamp": "01:06:20", "text": "プレイリストをグループ化したもの"}, {"type": "subtitle", "time": 3983.349, "timestamp": "01:06:23", "text": "一緒に。うん。だから、私は"}, {"type": "subtitle", "time": 3986.39, "timestamp": "01:06:26", "text": "過疎ゲームのプレイリストとか、そういう類のもの"}, {"type": "subtitle", "time": 3988.87, "timestamp": "01:06:28", "text": "私が消えてしまったゲームのためにも、"}, {"type": "subtitle", "time": 3990.549, "timestamp": "01:06:30", "text": "何かストリーミング配信するつもりはない"}, {"type": "subtitle", "time": 3993.109, "timestamp": "01:06:33", "text": "そんな感じ。でも、私はそうしたくない"}, {"type": "subtitle", "time": 3996.95, "timestamp": "01:06:36", "text": "ホームページの私のセクションを埋めてください"}, {"type": "subtitle", "time": 3998.87, "timestamp": "01:06:38", "text": "ホームチャンネルホーム右私はしたくない"}, {"type": "subtitle", "time": 4001.589, "timestamp": "01:06:41", "text": "この全部埋め尽くす"}, {"type": "subtitle", "time": 4004.15, "timestamp": "01:06:44", "text": "たくさん必要で、将来は"}, {"type": "subtitle", "time": 4005.99, "timestamp": "01:06:45", "text": "私のチャンネルにアクセスしないでください"}, {"type": "subtitle", "time": 4009.95, "timestamp": "01:06:49", "text": "将来的にはチャンネルなどもあるが"}, {"type": "subtitle", "time": 4013.19, "timestamp": "01:06:53", "text": "うん、複数のプレイリストを作るべきかな"}, {"type": "subtitle", "time": 4015.43, "timestamp": "01:06:55", "text": "複数作成する代わりに"}]
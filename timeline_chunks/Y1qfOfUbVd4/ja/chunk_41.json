[{"type": "subtitle", "time": 2461.19, "timestamp": "00:41:01", "text": "それでは配信を締めくくります。"}, {"type": "subtitle", "time": 2462.79, "timestamp": "00:41:02", "text": "ゲームをアンインストールして、二度とプレイしない"}, {"type": "subtitle", "time": 2463.55, "timestamp": "00:41:03", "text": "これ"}, {"type": "subtitle", "time": 2467.349, "timestamp": "00:41:07", "text": "また。そうですね、実現することを願いましょう。"}, {"type": "subtitle", "time": 2469.309, "timestamp": "00:41:09", "text": "なぜこれを友達に追加できないのですか？"}, {"type": "subtitle", "time": 2479.03, "timestamp": "00:41:19", "text": "行く。こんな場所は他にはなかったよ。あなた"}, {"type": "subtitle", "time": 2483.15, "timestamp": "00:41:23", "text": "建物を飛び回って、"}, {"type": "subtitle", "time": 2486.15, "timestamp": "00:41:26", "text": "楽しい。ああ、私は触っていません"}, {"type": "subtitle", "time": 2496.47, "timestamp": "00:41:36", "text": "右？まるでパラディンをプレイしているような気分だ"}]
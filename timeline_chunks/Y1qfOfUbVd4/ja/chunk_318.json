[{"type": "subtitle", "time": 19089.15, "timestamp": "05:18:09", "text": "我々には悪が存在する。悪"}, {"type": "subtitle", "time": 19092.15, "timestamp": "05:18:12", "text": "内側から食欲が湧いてくる。なぜ？なぜ"}, {"type": "subtitle", "time": 19094.23, "timestamp": "05:18:14", "text": "お腹が空いてきた？それは私を泣かせ、"}, {"type": "subtitle", "time": 19096.59, "timestamp": "05:18:16", "text": "思いっきり叫ぶ。"}, {"type": "subtitle", "time": 19099.99, "timestamp": "05:18:19", "text": "待って。また、Apexのアップデートもとても"}, {"type": "subtitle", "time": 19102.788, "timestamp": "05:18:22", "text": "いいね。新しい新商品、アカウント版"}, {"type": "subtitle", "time": 19105.03, "timestamp": "05:18:25", "text": "それって、すごいことだよね。あなた"}, {"type": "subtitle", "time": 19106.55, "timestamp": "05:18:26", "text": "知ってるよ、例えば君が検索するなら"}, {"type": "subtitle", "time": 19108.788, "timestamp": "05:18:28", "text": "友達、そんなことはないよ"}, {"type": "subtitle", "time": 19110.708, "timestamp": "05:18:30", "text": "そのうちの1つはプレイステーションのようなものではないでしょう。"}, {"type": "subtitle", "time": 19112.868, "timestamp": "05:18:32", "text": "コントローラー、スイッチ、それらのすべてのアカウント"}, {"type": "subtitle", "time": 19116.788, "timestamp": "05:18:36", "text": "ポップアップ表示される。彼らは、えーと、合併のようなものをしている"}, {"type": "subtitle", "time": 19119.55, "timestamp": "05:18:39", "text": "今すぐ機能を追加。それはすごくクールだね。"}, {"type": "subtitle", "time": 19121.31, "timestamp": "05:18:41", "text": "D."}, {"type": "subtitle", "time": 19124.628, "timestamp": "05:18:44", "text": "わかった。ああ、まだ壊れてる。必要ですか"}, {"type": "subtitle", "time": 19127.55, "timestamp": "05:18:47", "text": "欺瞞なしにヴァレラントを発売する？おお"}, {"type": "subtitle", "time": 19129.07, "timestamp": "05:18:49", "text": "神。"}, {"type": "subtitle", "time": 19133.628, "timestamp": "05:18:53", "text": "ああ。ああ、大変だ。大丈夫です。たぶん私は"}, {"type": "subtitle", "time": 19137.07, "timestamp": "05:18:57", "text": "いや、ただテストしたいだけなんです。"}]
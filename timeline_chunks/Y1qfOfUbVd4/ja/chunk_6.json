[{"type": "subtitle", "time": 361.83, "timestamp": "00:06:01", "text": "人々。これは本当に速いですね。見てください"}, {"type": "subtitle", "time": 365.39, "timestamp": "00:06:05", "text": "私はなんて早く死んだんだろう。どうやって？"}, {"type": "subtitle", "time": 367.71, "timestamp": "00:06:07", "text": "何？"}, {"type": "subtitle", "time": 379.11, "timestamp": "00:06:19", "text": "アジアを試してみよう。ああ、アジアは170"}, {"type": "subtitle", "time": 381.87, "timestamp": "00:06:21", "text": "何らかの理由で、"}, {"type": "subtitle", "time": 384.67, "timestamp": "00:06:24", "text": "そこには？入れるかどうか見てみましょう"}, {"type": "subtitle", "time": 387.309, "timestamp": "00:06:27", "text": "マッチ。"}, {"type": "subtitle", "time": 390.71, "timestamp": "00:06:30", "text": "見る？ああ、人がいる。こんにちは。なぜ"}, {"type": "subtitle", "time": 403.35, "timestamp": "00:06:43", "text": "プレミアリーグの優勝候補は？"}]
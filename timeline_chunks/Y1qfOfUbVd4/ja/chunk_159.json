[{"type": "subtitle", "time": 9540.38, "timestamp": "02:39:00", "text": "戦利品"}, {"type": "subtitle", "time": 9542.349, "timestamp": "02:39:02", "text": "[音楽]"}, {"type": "subtitle", "time": 9552.59, "timestamp": "02:39:12", "text": "あれ。銀。お金をもらっています"}, {"type": "subtitle", "time": 9556.99, "timestamp": "02:39:16", "text": "けれど。これは何ですか？ハンターズ"}, {"type": "subtitle", "time": 9564.03, "timestamp": "02:39:24", "text": "カウボーイ"}, {"type": "subtitle", "time": 9572.19, "timestamp": "02:39:32", "text": "またお金が手に入った。"}, {"type": "subtitle", "time": 9574.83, "timestamp": "02:39:34", "text": "おお。何が"}, {"type": "subtitle", "time": 9583.11, "timestamp": "02:39:43", "text": "印刷しますか？これを開くことで作成できます。はぁ？"}, {"type": "subtitle", "time": 9586.11, "timestamp": "02:39:46", "text": "だから、カスタマイズしましょう。これらを持っていますか？"}, {"type": "subtitle", "time": 9590.03, "timestamp": "02:39:50", "text": "えっと、ギア？いいえ、持っていません。待って、"}, {"type": "subtitle", "time": 9593.19, "timestamp": "02:39:53", "text": "何？私には理解できません。私は"}, {"type": "subtitle", "time": 9595.23, "timestamp": "02:39:55", "text": "今開けたもの。"}, {"type": "subtitle", "time": 9597.33, "timestamp": "02:39:57", "text": "なぜ？これは何ですか"}, {"type": "subtitle", "time": 9598.75, "timestamp": "02:39:58", "text": "[音楽]"}]
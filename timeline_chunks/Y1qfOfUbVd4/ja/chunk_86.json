[{"type": "subtitle", "time": 5166.83, "timestamp": "01:26:06", "text": "言語？言語。待って、それは"}, {"type": "subtitle", "time": 5174.27, "timestamp": "01:26:14", "text": "それで"}, {"type": "subtitle", "time": 5177.39, "timestamp": "01:26:17", "text": "待って、言語"}, {"type": "subtitle", "time": 5181.95, "timestamp": "01:26:21", "text": "コード。はい、その通りです。わかった。翻訳する。"}, {"type": "subtitle", "time": 5184.47, "timestamp": "01:26:24", "text": "こんにちは。待って、忘れてた。ごきげんよう"}, {"type": "subtitle", "time": 5197.149, "timestamp": "01:26:37", "text": "あぁ、忘れてた。 1秒。"}, {"type": "subtitle", "time": 5200.35, "timestamp": "01:26:40", "text": "えーと、マニュアル"}, {"type": "subtitle", "time": 5205.79, "timestamp": "01:26:45", "text": "入力。何？それは何だったのか"}, {"type": "subtitle", "time": 5207.95, "timestamp": "01:26:47", "text": "けれど？手に入れた"}, {"type": "subtitle", "time": 5218.44, "timestamp": "01:26:58", "text": "翻訳する"}]
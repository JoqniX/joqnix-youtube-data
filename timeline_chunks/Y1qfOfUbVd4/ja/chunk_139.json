[{"type": "subtitle", "time": 8345.429, "timestamp": "02:19:05", "text": "あなた。私はあなたにヘッドショットを決めているのでしょうか？わかった、"}, {"type": "subtitle", "time": 8346.349, "timestamp": "02:19:06", "text": "手に入れた"}, {"type": "subtitle", "time": 8349.629, "timestamp": "02:19:09", "text": "私の"}, {"type": "subtitle", "time": 8355.469, "timestamp": "02:19:15", "text": "あなた。"}, {"type": "subtitle", "time": 8358.469, "timestamp": "02:19:18", "text": "待って、歩いてノックする"}, {"type": "subtitle", "time": 8368.549, "timestamp": "02:19:28", "text": "また。ああ、わかった。ええと、鎮痛剤。えっと、"}, {"type": "subtitle", "time": 8373.549, "timestamp": "02:19:33", "text": "それが必要ですか？いいえ。マルトです。いや、違うよ。その"}, {"type": "subtitle", "time": 8376.669, "timestamp": "02:19:36", "text": "わかった。甘い。ベルライト。それを受け取ります。"}, {"type": "subtitle", "time": 8378.709, "timestamp": "02:19:38", "text": "おじさん、あのね？あなたの"}, {"type": "subtitle", "time": 8380.95, "timestamp": "02:19:40", "text": "ドレス全体。ありがとう。"}, {"type": "subtitle", "time": 8383.549, "timestamp": "02:19:43", "text": "これが私の食べ方だから。"}, {"type": "subtitle", "time": 8389.03, "timestamp": "02:19:49", "text": "えっと、9は必要ないですよね？ 45口径が必要です"}, {"type": "subtitle", "time": 8390.429, "timestamp": "02:19:50", "text": "ACP"}, {"type": "subtitle", "time": 8394.67, "timestamp": "02:19:54", "text": "そういうもの、必要ない"}]
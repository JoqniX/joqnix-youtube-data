[{"type": "subtitle", "time": 8763.07, "timestamp": "02:26:03", "text": "正しくマークされていない。おお、"}, {"type": "subtitle", "time": 8766.15, "timestamp": "02:26:06", "text": "ダミー。彼はここまで来ていなかったと思う。"}, {"type": "subtitle", "time": 8769.19, "timestamp": "02:26:09", "text": "ああ、そこにいたんですね。ほら、君が来るよ"}, {"type": "subtitle", "time": 8770.67, "timestamp": "02:26:10", "text": "のために"}, {"type": "subtitle", "time": 8773.71, "timestamp": "02:26:13", "text": "あなた。うん。こんにちは。"}, {"type": "subtitle", "time": 8776.95, "timestamp": "02:26:16", "text": "こんにちは。 3回。えっと、待って。救急キット。あなたには"}, {"type": "subtitle", "time": 8779.11, "timestamp": "02:26:19", "text": "それ。あなたが必要とされています。あなたが必要とされています。あなた"}, {"type": "subtitle", "time": 8783.309, "timestamp": "02:26:23", "text": "必要です。 SKSは言う、「私はこれら"}, {"type": "subtitle", "time": 8785.99, "timestamp": "02:26:25", "text": "狙撃兵。スナイパーがいるのは良いことじゃない？"}, {"type": "subtitle", "time": 8787.95, "timestamp": "02:26:27", "text": "それとも、そうすべきではないでしょうか？"}, {"type": "subtitle", "time": 8791.99, "timestamp": "02:26:31", "text": "それですか？実用的な狙撃銃。若菜。"}, {"type": "subtitle", "time": 8799.71, "timestamp": "02:26:39", "text": "うーん、わからない。弾薬は十分ありますか？"}, {"type": "subtitle", "time": 8805.389, "timestamp": "02:26:45", "text": "153. ああ、だめだ。いいえ。行け。待って。なぜ私は"}, {"type": "subtitle", "time": 8808.349, "timestamp": "02:26:48", "text": "歩いている？どうすればいいですか どうすればいいですか"}]
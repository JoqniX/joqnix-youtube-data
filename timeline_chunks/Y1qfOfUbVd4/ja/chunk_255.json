[{"type": "subtitle", "time": 15301.55, "timestamp": "04:15:01", "text": "どこにある"}, {"type": "subtitle", "time": 15310.55, "timestamp": "04:15:10", "text": "いや、あの映画は使わないでおこうと思った。彼女"}, {"type": "subtitle", "time": 15313.71, "timestamp": "04:15:13", "text": "私が怖がっているのは分かっている。えっと"}, {"type": "subtitle", "time": 15316.44, "timestamp": "04:15:16", "text": "えっと、そうしないで"}, {"type": "subtitle", "time": 15318.189, "timestamp": "04:15:18", "text": "[音楽]"}, {"type": "subtitle", "time": 15322.2, "timestamp": "04:15:22", "text": "部分。私は話さない。"}, {"type": "subtitle", "time": 15353.63, "timestamp": "04:15:53", "text": "何"}, {"type": "subtitle", "time": 15358.86, "timestamp": "04:15:58", "text": "その？彼は私を呪った。彼は私を呪った。彼はダメだった"}]
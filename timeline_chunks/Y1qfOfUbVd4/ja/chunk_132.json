[{"type": "subtitle", "time": 7922.79, "timestamp": "02:12:02", "text": "いいね。これは表示されませんか"}, {"type": "subtitle", "time": 7924.709, "timestamp": "02:12:04", "text": "レーダー？待って、レーダーが見えますか？"}, {"type": "subtitle", "time": 7926.95, "timestamp": "02:12:06", "text": "そこには？君たちが見ることができないと思う"}, {"type": "subtitle", "time": 7930.629, "timestamp": "02:12:10", "text": "翻訳テキスト付きのレーダーですが、"}, {"type": "subtitle", "time": 7934.31, "timestamp": "02:12:14", "text": "ああ、レーダーのことだよね？君は"}, {"type": "subtitle", "time": 7937.109, "timestamp": "02:12:17", "text": "銃声が聞こえた場所を見てください。ただ"}, {"type": "subtitle", "time": 7939.709, "timestamp": "02:12:19", "text": "赤く表示される、ですよね？例えば"}, {"type": "subtitle", "time": 7943.91, "timestamp": "02:12:23", "text": "フォートナイトとエイペックス。なぜ？このゲームは"}, {"type": "subtitle", "time": 7963.35, "timestamp": "02:12:43", "text": "うんうん。何てことだ。何てことだ。何てことだ。"}, {"type": "subtitle", "time": 7964.51, "timestamp": "02:12:44", "text": "ああ、"}, {"type": "subtitle", "time": 7976.27, "timestamp": "02:12:56", "text": "神。ああ、ああ"}]
[{"type": "subtitle", "time": 17582.07, "timestamp": "04:53:02", "text": "良い。はい、両方に通知されます。それで"}, {"type": "subtitle", "time": 17586.07, "timestamp": "04:53:06", "text": "うん。こんにちは。ええと、だいたいそんなところです。包むよ"}, {"type": "subtitle", "time": 17588.708, "timestamp": "04:53:08", "text": "糸をたぐり上げる。来てくれてありがとう"}, {"type": "subtitle", "time": 17593.07, "timestamp": "04:53:13", "text": "今までに、残りの時間を楽しんでください"}, {"type": "subtitle", "time": 17595.83, "timestamp": "04:53:15", "text": "夕方。輝きを忘れないで、"}, {"type": "subtitle", "time": 17599.75, "timestamp": "04:53:19", "text": "笑顔で、かわいい。そして輝く存在でいてください"}, {"type": "subtitle", "time": 17604.15, "timestamp": "04:53:24", "text": "君のようなスターだ。そうですね、頑張ってください。"}, {"type": "subtitle", "time": 17614.59, "timestamp": "04:53:34", "text": "[音楽]"}, {"type": "subtitle", "time": 17617.15, "timestamp": "04:53:37", "text": "こんにちは、お元気で"}, {"type": "subtitle", "time": 17620.34, "timestamp": "04:53:40", "text": "みんな。皆さんお気をつけて"}, {"type": "subtitle", "time": 17633.39, "timestamp": "04:53:53", "text": "[音楽]"}, {"type": "subtitle", "time": 17634.44, "timestamp": "04:53:54", "text": "継続。"}]
[{"type": "subtitle", "time": 13443.95, "timestamp": "03:44:03", "text": "うん。うん。よし。おお、いいね"}, {"type": "subtitle", "time": 13446.71, "timestamp": "03:44:06", "text": "ショット。ナイスショット。この男を見てください。彼の"}, {"type": "subtitle", "time": 13449.71, "timestamp": "03:44:09", "text": "彼は皮やチャームを手に入れ、"}, {"type": "subtitle", "time": 13453.75, "timestamp": "03:44:13", "text": "もの。キー、キーチャームとかそういうもの。おお。"}, {"type": "subtitle", "time": 13457.95, "timestamp": "03:44:17", "text": "彼はレベル197です。"}, {"type": "subtitle", "time": 13483.15, "timestamp": "03:44:43", "text": "おお、"}, {"type": "subtitle", "time": 13485.229, "timestamp": "03:44:45", "text": "ニース。ああ、神様。"}, {"type": "subtitle", "time": 13488.99, "timestamp": "03:44:48", "text": "えっと、これ"}, {"type": "subtitle", "time": 13497.51, "timestamp": "03:44:57", "text": "銃とフライパン。"}]
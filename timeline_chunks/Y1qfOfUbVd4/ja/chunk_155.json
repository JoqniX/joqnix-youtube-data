[{"type": "subtitle", "time": 9300.55, "timestamp": "02:35:00", "text": "あなた。サッカーボールがあります。"}, {"type": "subtitle", "time": 9302.429, "timestamp": "02:35:02", "text": "私は"}, {"type": "subtitle", "time": 9304.87, "timestamp": "02:35:04", "text": "フットボール。ああ、本当に"}, {"type": "subtitle", "time": 9322.75, "timestamp": "02:35:22", "text": "あなた。これは楽しい。"}, {"type": "subtitle", "time": 9326.15, "timestamp": "02:35:26", "text": "ああ、試合はどうですか？楽しくて怖い"}, {"type": "subtitle", "time": 9333.79, "timestamp": "02:35:33", "text": "楽しい。理解してもらえるといいな。努力するよ。"}, {"type": "subtitle", "time": 9336.71, "timestamp": "02:35:36", "text": "それ。しかし、私たちは最初の試合に出場できた。私の勝ちだ。"}, {"type": "subtitle", "time": 9339.59, "timestamp": "02:35:39", "text": "いいえ、前回の試合は私が勝ちました。初めてのゲーム"}, {"type": "subtitle", "time": 9343.07, "timestamp": "02:35:43", "text": "私は列に並んで実際に勝ちました"}, {"type": "subtitle", "time": 9351.23, "timestamp": "02:35:51", "text": "方法。とんでもない。ディオですが、実際には"}, {"type": "subtitle", "time": 9354.429, "timestamp": "02:35:54", "text": "勝利した。まとめると、良いですね。"}]
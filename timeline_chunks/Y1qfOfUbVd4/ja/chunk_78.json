[{"type": "subtitle", "time": 4698.709, "timestamp": "01:18:18", "text": "ジョーン、ジョーン、こんにちは。こんにちは。ようこそ"}, {"type": "subtitle", "time": 4700.79, "timestamp": "01:18:20", "text": "ストリーム。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 4702.31, "timestamp": "01:18:22", "text": "大丈夫ですか？ええ、すべてが"}, {"type": "subtitle", "time": 4705.75, "timestamp": "01:18:25", "text": "良い。私たちはゲームを終えました。えっと、"}, {"type": "subtitle", "time": 4709.11, "timestamp": "01:18:29", "text": "戦闘の達人。私たちはゲームを終え、"}, {"type": "subtitle", "time": 4711.189, "timestamp": "01:18:31", "text": "仕上げ作業中です。だから、"}, {"type": "subtitle", "time": 4712.95, "timestamp": "01:18:32", "text": "私たちはさまざまなゲームをチェックしている"}, {"type": "subtitle", "time": 4714.35, "timestamp": "01:18:34", "text": "に"}, {"type": "subtitle", "time": 4717.669, "timestamp": "01:18:37", "text": "遊ぶ。そう、FPSの動きのあるシューティングゲームみたいに"}, {"type": "subtitle", "time": 4719.39, "timestamp": "01:18:39", "text": "種類"}, {"type": "subtitle", "time": 4722.149, "timestamp": "01:18:42", "text": "タイプ。楽しかった。イベントがあり、"}, {"type": "subtitle", "time": 4724.51, "timestamp": "01:18:44", "text": "ついに商品が届きました"}, {"type": "subtitle", "time": 4727.51, "timestamp": "01:18:47", "text": "似たようなもの"}, {"type": "subtitle", "time": 4729.07, "timestamp": "01:18:49", "text": "のように"}, {"type": "subtitle", "time": 4736.99, "timestamp": "01:18:56", "text": "次はトロイの木馬だ。これは何ですか"}]
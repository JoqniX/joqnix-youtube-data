[{"type": "subtitle", "time": 4921.27, "timestamp": "01:22:01", "text": "ああ、これは一体どういうことですか？ああ、支払いは済んでいる"}, {"type": "subtitle", "time": 4923.44, "timestamp": "01:22:03", "text": "けれど。"}, {"type": "subtitle", "time": 4926.07, "timestamp": "01:22:06", "text": "[音楽]"}, {"type": "subtitle", "time": 4928.229, "timestamp": "01:22:08", "text": "君が恋愛ゲーム好きだなんて知らなかったよ。いいえ、"}, {"type": "subtitle", "time": 4930.87, "timestamp": "01:22:10", "text": "愛してないよ、つまり、一度もプレイしたことがないってこと"}, {"type": "subtitle", "time": 4933.51, "timestamp": "01:22:13", "text": "このゲームはこれらのジャンルの多くを演奏した。だから私は"}, {"type": "subtitle", "time": 4935.55, "timestamp": "01:22:15", "text": "もう一度試してみようと思った"}, {"type": "subtitle", "time": 4939.35, "timestamp": "01:22:19", "text": "それ。うん、だって触りたいんだもん"}, {"type": "subtitle", "time": 4941.27, "timestamp": "01:22:21", "text": "これまで一度もプレイしたことのないゲーム"}, {"type": "subtitle", "time": 4944.229, "timestamp": "01:22:24", "text": "ゲームのジャンルのようなもの。だから私たちは"}, {"type": "subtitle", "time": 4946.79, "timestamp": "01:22:26", "text": "Need for Speedをプレイし始めた"}, {"type": "subtitle", "time": 4949.229, "timestamp": "01:22:29", "text": "Unboundはレースゲームです。"}, {"type": "subtitle", "time": 4951.83, "timestamp": "01:22:31", "text": "今は、ストリーミングやいいねはしていないと思います"}, {"type": "subtitle", "time": 4955.03, "timestamp": "01:22:35", "text": "たくさんプレイした。過去には持っていたが"}, {"type": "subtitle", "time": 4958.79, "timestamp": "01:22:38", "text": "ストリーミング配信はしていません。だからレーシングゲームは"}, {"type": "subtitle", "time": 4967.229, "timestamp": "01:22:47", "text": "それ。ああ、叫び声は"}]
[{"type": "subtitle", "time": 9121.03, "timestamp": "02:32:01", "text": "AKM。何てことだ。久しぶりの試合"}, {"type": "subtitle", "time": 9124.03, "timestamp": "02:32:04", "text": "実際は私が勝ったんだけどね。言い訳"}, {"type": "subtitle", "time": 9131.11, "timestamp": "02:32:11", "text": "何？これは一体どういう主張ですか？これは何ですか？"}, {"type": "subtitle", "time": 9139.63, "timestamp": "02:32:19", "text": "金庫。何が"}, {"type": "subtitle", "time": 9143.95, "timestamp": "02:32:23", "text": "この鍵？ Nが鍵を手に入れた。"}, {"type": "subtitle", "time": 9150.469, "timestamp": "02:32:30", "text": "クレジットって何？家まで連れて帰ってください。 1回プレイする。"}, {"type": "subtitle", "time": 9154.469, "timestamp": "02:32:34", "text": "3回プレイしてください。トップ10に10回ランクインする。"}, {"type": "subtitle", "time": 9157.51, "timestamp": "02:32:37", "text": "5回。サバの上映時間は合計60分です。"}, {"type": "subtitle", "time": 9159.19, "timestamp": "02:32:39", "text": "ワイルドな時間を過ごしました"}, {"type": "subtitle", "time": 9162.63, "timestamp": "02:32:42", "text": "チームメイトのプレーを観戦する。ああ、できるよ"}, {"type": "subtitle", "time": 9164.75, "timestamp": "02:32:44", "text": "400コイン獲得。"}, {"type": "subtitle", "time": 9168.11, "timestamp": "02:32:48", "text": "おお。いいもの。"}, {"type": "subtitle", "time": 9171.389, "timestamp": "02:32:51", "text": "D. はい。私たちは遊ぶ"}, {"type": "subtitle", "time": 9175.71, "timestamp": "02:32:55", "text": "また。何てことだ。うん。ああ、私は"}, {"type": "subtitle", "time": 9178.95, "timestamp": "02:32:58", "text": "怖がった。所有。何？私は実際に"}]
[{"type": "subtitle", "time": 21184.67, "timestamp": "05:53:04", "text": "ペースト。"}, {"type": "subtitle", "time": 21190.708, "timestamp": "05:53:10", "text": "ああ、わかった。待って、どれが必要なの？"}, {"type": "subtitle", "time": 21193.44, "timestamp": "05:53:13", "text": "また変更？ああ、それは"}, {"type": "subtitle", "time": 21195.708, "timestamp": "05:53:15", "text": "[音楽]"}, {"type": "subtitle", "time": 21211.07, "timestamp": "05:53:31", "text": "わかった。わかった。どうしてもこれをやらなければならなかったんです。"}, {"type": "subtitle", "time": 21213.788, "timestamp": "05:53:33", "text": "えっと、これはこれと違います"}, {"type": "subtitle", "time": 21216.708, "timestamp": "05:53:36", "text": "また。ああ、一番下のが確認ボタンです。"}, {"type": "subtitle", "time": 21218.788, "timestamp": "05:53:38", "text": "わかった。一番上の項目は変更する必要があるんですよね？"}, {"type": "subtitle", "time": 21221.8, "timestamp": "05:53:41", "text": "はい、わかりました。"}, {"type": "subtitle", "time": 21223.15, "timestamp": "05:53:43", "text": "[音楽]"}, {"type": "subtitle", "time": 21226.31, "timestamp": "05:53:46", "text": "えっと、ちゃんとした配信があればの話だけど"}, {"type": "subtitle", "time": 21227.31, "timestamp": "05:53:47", "text": "デッキ、"}, {"type": "subtitle", "time": 21230.23, "timestamp": "05:53:50", "text": "男。もっと大きなものがあれば、"}, {"type": "subtitle", "time": 21232.99, "timestamp": "05:53:52", "text": "それは"}]
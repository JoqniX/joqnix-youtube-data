[{"type": "subtitle", "time": 8463.99, "timestamp": "02:21:03", "text": "から？戦っている人がいることは知っています"}, {"type": "subtitle", "time": 8466.27, "timestamp": "02:21:06", "text": "正面はまっすぐ"}, {"type": "subtitle", "time": 8478.36, "timestamp": "02:21:18", "text": "音？誰かが"}, {"type": "subtitle", "time": 8484.15, "timestamp": "02:21:24", "text": "ここ。君を見つけ出すよ"}, {"type": "subtitle", "time": 8489.309, "timestamp": "02:21:29", "text": "あなたを圧倒するつもりです"}, {"type": "subtitle", "time": 8497.389, "timestamp": "02:21:37", "text": "ガソリン。はい、45をありがとうございます"}, {"type": "subtitle", "time": 8500.07, "timestamp": "02:21:40", "text": "あれ。拡張メカを入手します。"}, {"type": "subtitle", "time": 8508.03, "timestamp": "02:21:48", "text": "弾薬。クイックドローの方が実際には優れている。"}, {"type": "subtitle", "time": 8511.429, "timestamp": "02:21:51", "text": "右？いいえ、標準マガジンの方が優れています。私"}, {"type": "subtitle", "time": 8514.15, "timestamp": "02:21:54", "text": "これはいらない。外国為替取引の範囲。はい、"}, {"type": "subtitle", "time": 8517.07, "timestamp": "02:21:57", "text": "ついに、より広い視野を持つことができました。次"}]
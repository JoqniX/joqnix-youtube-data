[{"type": "subtitle", "time": 16149.389, "timestamp": "04:29:09", "text": "[音楽]"}, {"type": "subtitle", "time": 16153.389, "timestamp": "04:29:13", "text": "反動。ああ、新しい"}, {"type": "subtitle", "time": 16155.99, "timestamp": "04:29:15", "text": "あれ。シーズン20。ああ、それは"}, {"type": "subtitle", "time": 16162.51, "timestamp": "04:29:22", "text": "クレイジー。"}, {"type": "subtitle", "time": 16165.75, "timestamp": "04:29:25", "text": "ニース。ええと、そうですね、1試合勝ちました。"}, {"type": "subtitle", "time": 16169.269, "timestamp": "04:29:29", "text": "バトルロイヤルでかなり先まで進んでいます。それは良い。トップ"}, {"type": "subtitle", "time": 16170.11, "timestamp": "04:29:30", "text": "二"}, {"type": "subtitle", "time": 16172.99, "timestamp": "04:29:32", "text": "一度。そうですね、1つやってみましょう"}, {"type": "subtitle", "time": 16174.51, "timestamp": "04:29:34", "text": "最後"}, {"type": "subtitle", "time": 16176.67, "timestamp": "04:29:36", "text": "あれを包んで"}, {"type": "subtitle", "time": 16181.469, "timestamp": "04:29:41", "text": "立ち上がって、これをアンインストールします"}, {"type": "subtitle", "time": 16184.83, "timestamp": "04:29:44", "text": "ゲーム。でも次に会う時は"}, {"type": "subtitle", "time": 16189.349, "timestamp": "04:29:49", "text": "次回は、もっと楽しもうね。"}, {"type": "subtitle", "time": 16190.59, "timestamp": "04:29:50", "text": "これは何ですか"}, {"type": "subtitle", "time": 16198.51, "timestamp": "04:29:58", "text": "えっと、私はこうしたいんです"}]
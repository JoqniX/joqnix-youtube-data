[{"type": "subtitle", "time": 12301.03, "timestamp": "03:25:01", "text": "PC版ですか？もしあるとしたら、"}, {"type": "subtitle", "time": 12302.71, "timestamp": "03:25:02", "text": "でも、そう、僕はただ1つだけをプレイしているだけ"}, {"type": "subtitle", "time": 12303.87, "timestamp": "03:25:03", "text": "の上"}, {"type": "subtitle", "time": 12306.63, "timestamp": "03:25:06", "text": "スチーム。うん、今プレイしてるのは"}, {"type": "subtitle", "time": 12315.91, "timestamp": "03:25:15", "text": "知る。そして、私たちは鎮痛剤を服用します。それで、"}, {"type": "subtitle", "time": 12318.95, "timestamp": "03:25:18", "text": "待って、鎮痛剤と"}, {"type": "subtitle", "time": 12322.03, "timestamp": "03:25:22", "text": "このエナジードリンクは？"}, {"type": "subtitle", "time": 12326.469, "timestamp": "03:25:26", "text": "実際、それは、"}, {"type": "subtitle", "time": 12330.71, "timestamp": "03:25:30", "text": "一時的にダメージを受けるとか？どのように"}, {"type": "subtitle", "time": 12358.51, "timestamp": "03:25:58", "text": "どこに"}]
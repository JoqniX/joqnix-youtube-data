[{"type": "subtitle", "time": 18121.11, "timestamp": "05:02:01", "text": "やったよ。私は。私も同じです"}, {"type": "subtitle", "time": 18127.19, "timestamp": "05:02:07", "text": "うん。 D、君を誇りに思うよ。君が"}, {"type": "subtitle", "time": 18129.15, "timestamp": "05:02:09", "text": "した"}, {"type": "subtitle", "time": 18131.75, "timestamp": "05:02:11", "text": "それ。読めないのにどうして切り替えるの？"}, {"type": "subtitle", "time": 18134.03, "timestamp": "05:02:14", "text": "それ？気分転換してもいいかなと思ったんです。あなた"}, {"type": "subtitle", "time": 18137.868, "timestamp": "05:02:17", "text": "知ってるよ、時には"}, {"type": "subtitle", "time": 18142.788, "timestamp": "05:02:22", "text": "変化。そう思います。この男の能力"}, {"type": "subtitle", "time": 18145.91, "timestamp": "05:02:25", "text": "ああ、それは眩しすぎると思います。あるいは、"}, {"type": "subtitle", "time": 18149.03, "timestamp": "05:02:29", "text": "目がくらむような、あるいは"}, {"type": "subtitle", "time": 18153.788, "timestamp": "05:02:33", "text": "えっと、これは何て言うんですか？麻痺させる"}, {"type": "subtitle", "time": 18155.868, "timestamp": "05:02:35", "text": "損なうのと同じ"}, {"type": "subtitle", "time": 18158.708, "timestamp": "05:02:38", "text": "うん、似たようなもの"}, {"type": "subtitle", "time": 18163.99, "timestamp": "05:02:43", "text": "Apex Legendsの能力に似ているような感じですね。"}, {"type": "subtitle", "time": 18166.868, "timestamp": "05:02:46", "text": "これには制限はありません。あなた"}, {"type": "subtitle", "time": 18171.31, "timestamp": "05:02:51", "text": "真っ直ぐ。次"}, {"type": "subtitle", "time": 18175.19, "timestamp": "05:02:55", "text": "能力。これは、これは、に似ています"}, {"type": "subtitle", "time": 18178.07, "timestamp": "05:02:58", "text": "Apexの、えっと、この人の名前は何でしたっけ？"}, {"type": "subtitle", "time": 18179.91, "timestamp": "05:02:59", "text": "あのアイアンフォートレスの男。鉄ではない"}]
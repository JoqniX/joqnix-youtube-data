[{"type": "subtitle", "time": 10686.15, "timestamp": "02:58:06", "text": "そうそう。お父さん、早く良くなってね。戻る"}, {"type": "subtitle", "time": 10695.349, "timestamp": "02:58:15", "text": "私は探検家をよく見ていました"}, {"type": "subtitle", "time": 10698.79, "timestamp": "02:58:18", "text": "しかし、時間はかかる。ああ、富士山はベクター画像になった"}, {"type": "subtitle", "time": 10701.03, "timestamp": "02:58:21", "text": "そこに銃がある。ええ、これがベクターガンです。"}, {"type": "subtitle", "time": 10703.59, "timestamp": "02:58:23", "text": "フジチャマのために装備するよ"}, {"type": "subtitle", "time": 10709.99, "timestamp": "02:58:29", "text": "藤間。私は探検家を見て、"}]
[{"type": "subtitle", "time": 10863.389, "timestamp": "03:01:03", "text": "これは"}, {"type": "subtitle", "time": 10865.87, "timestamp": "03:01:05", "text": "自由に殺せる。もし"}, {"type": "subtitle", "time": 10872.83, "timestamp": "03:01:12", "text": "これもまた"}, {"type": "subtitle", "time": 10876.51, "timestamp": "03:01:16", "text": "また？私は気づいているのですが、"}, {"type": "subtitle", "time": 10879.67, "timestamp": "03:01:19", "text": "多く。デッドボックスはどこにありますか？あなたの"}, {"type": "subtitle", "time": 10882.469, "timestamp": "03:01:22", "text": "体。あなたの体は重要ではない。あなたの"}, {"type": "subtitle", "time": 10885.87, "timestamp": "03:01:25", "text": "デッドボックスは私にとって重要です。"}, {"type": "subtitle", "time": 10887.87, "timestamp": "03:01:27", "text": "トンクと"}, {"type": "subtitle", "time": 10891.67, "timestamp": "03:01:31", "text": "トンク。ありがとう。ありがとう。野生のネコ"}, {"type": "subtitle", "time": 10892.83, "timestamp": "03:01:32", "text": "パーカー。"}, {"type": "subtitle", "time": 10895.71, "timestamp": "03:01:35", "text": "あ、ドレスを着ています。感謝"}, {"type": "subtitle", "time": 10910.349, "timestamp": "03:01:50", "text": "えっと。"}, {"type": "subtitle", "time": 10919.03, "timestamp": "03:01:59", "text": "最後に、FXについて。ありがとう。ありがとう。"}]
[{"type": "subtitle", "time": 10320.23, "timestamp": "02:52:00", "text": "うん、そこに行こう。このテラス"}, {"type": "subtitle", "time": 10326.23, "timestamp": "02:52:06", "text": "あれ。キラン。わあ、また手に入れたのね"}, {"type": "subtitle", "time": 10328.309, "timestamp": "02:52:08", "text": "妻。何？"}, {"type": "subtitle", "time": 10331.269, "timestamp": "02:52:11", "text": "アランゲル・ロス、私をあの場所へ連れて帰って"}, {"type": "subtitle", "time": 10345.03, "timestamp": "02:52:25", "text": "うん。とても小さく見えます"}, {"type": "subtitle", "time": 10346.67, "timestamp": "02:52:26", "text": "本物みたい"}, {"type": "subtitle", "time": 10350.19, "timestamp": "02:52:30", "text": "ある意味小さい"}, {"type": "subtitle", "time": 10355.429, "timestamp": "02:52:35", "text": "これ。ああ、私って本当にプロ級だわ。"}, {"type": "subtitle", "time": 10357.349, "timestamp": "02:52:37", "text": "でも着陸すると、「ああ、"}]
[{"type": "subtitle", "time": 17880.55, "timestamp": "04:58:00", "text": "Twitchでフォローしてください。ありがとう。ありがとう。"}, {"type": "subtitle", "time": 17882.948, "timestamp": "04:58:02", "text": "ありがとう。お元気でお過ごしでしょうか。今、"}, {"type": "subtitle", "time": 17885.43, "timestamp": "04:58:05", "text": "今日はヴァレラントをプレイします。それで、"}, {"type": "subtitle", "time": 17887.99, "timestamp": "04:58:07", "text": "今日は新しい、みんなが遊んでいる"}, {"type": "subtitle", "time": 17892.23, "timestamp": "04:58:12", "text": "ヴァレラントは最近。新しいエージェントが"}, {"type": "subtitle", "time": 17896.27, "timestamp": "04:58:16", "text": "そして、私はそれを楽しみにしています。それで、"}, {"type": "subtitle", "time": 17899.83, "timestamp": "04:58:19", "text": "うん。はい。えっと、これも初めてです"}, {"type": "subtitle", "time": 17901.31, "timestamp": "04:58:21", "text": "ストリーム"}, {"type": "subtitle", "time": 17905.27, "timestamp": "04:58:25", "text": "月。えっと、11月です。"}, {"type": "subtitle", "time": 17908.23, "timestamp": "04:58:28", "text": "さあ、みんなで力を合わせて頑張りましょう。"}, {"type": "subtitle", "time": 17910.31, "timestamp": "04:58:30", "text": "あと1ヶ月。"}, {"type": "subtitle", "time": 17911.628, "timestamp": "04:58:31", "text": "一緒に"}, {"type": "subtitle", "time": 17915.83, "timestamp": "04:58:35", "text": "私たちは？では、今日の配信では"}, {"type": "subtitle", "time": 17919.99, "timestamp": "04:58:39", "text": "バレランドでピューピューと音を立てる。ええと、それは違います"}, {"type": "subtitle", "time": 17921.31, "timestamp": "04:58:41", "text": "本当に"}, {"type": "subtitle", "time": 17923.75, "timestamp": "04:58:43", "text": "参加型の意味 私は自分が"}, {"type": "subtitle", "time": 17924.83, "timestamp": "04:58:44", "text": "作る"}, {"type": "subtitle", "time": 17926.84, "timestamp": "04:58:46", "text": "参加型だが"}, {"type": "subtitle", "time": 17939.19, "timestamp": "04:58:59", "text": "ええ、それでいいと思います。"}]
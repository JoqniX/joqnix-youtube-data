[{"type": "subtitle", "time": 23103.59, "timestamp": "06:25:03", "text": "行く。うん。それで、先ほども言ったように、"}, {"type": "subtitle", "time": 23108.15, "timestamp": "06:25:08", "text": "ライブウェブを再生するライブウェブのような"}, {"type": "subtitle", "time": 23111.27, "timestamp": "06:25:11", "text": "いつから始まったんだっけ？"}, {"type": "subtitle", "time": 23113.868, "timestamp": "06:25:13", "text": "11月3日"}, {"type": "subtitle", "time": 23120.35, "timestamp": "06:25:20", "text": "金曜日午後8時東部標準時（EST）から日曜日まで"}, {"type": "subtitle", "time": 23124.27, "timestamp": "06:25:24", "text": "えーと、日曜日の午後5時頃午前5時または"}, {"type": "subtitle", "time": 23127.35, "timestamp": "06:25:27", "text": "何か。火事ですか？忘れた。うん。"}, {"type": "subtitle", "time": 23130.59, "timestamp": "06:25:30", "text": "うん。だから、私は"}, {"type": "subtitle", "time": 23134.23, "timestamp": "06:25:34", "text": "ええと、減りました。いや、いや、いや。それは「いいえ」のようなものです。"}, {"type": "subtitle", "time": 23139.39, "timestamp": "06:25:39", "text": "私はああ、何をプレイしているんだ"}, {"type": "subtitle", "time": 23141.628, "timestamp": "06:25:41", "text": "として？"}, {"type": "subtitle", "time": 23157.75, "timestamp": "06:25:57", "text": "あなた"}]
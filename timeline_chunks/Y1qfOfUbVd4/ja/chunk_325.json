[{"type": "subtitle", "time": 19504.51, "timestamp": "05:25:04", "text": "第一の触媒。ああ、よかった。良い。イナ"}, {"type": "subtitle", "time": 19510.59, "timestamp": "05:25:10", "text": "さあ、行こう。ギャングの時間だ。は"}, {"type": "subtitle", "time": 19513.35, "timestamp": "05:25:13", "text": "時間。ああ、有効にしていなかったと思います"}, {"type": "subtitle", "time": 19515.23, "timestamp": "05:25:15", "text": "チート。ああ、それは"}, {"type": "subtitle", "time": 19527.19, "timestamp": "05:25:27", "text": "名詞これは目をくらませるものだ。いいえ。ええと、"}, {"type": "subtitle", "time": 19529.868, "timestamp": "05:25:29", "text": "アラームボット"}, {"type": "subtitle", "time": 19535.708, "timestamp": "05:25:35", "text": "あれ。わかった。いいえ。ええ。私"}, {"type": "subtitle", "time": 19542.11, "timestamp": "05:25:42", "text": "忘れた。大丈夫。後で作り直すことができます"}]
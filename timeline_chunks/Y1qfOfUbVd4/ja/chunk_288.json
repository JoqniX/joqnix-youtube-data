[{"type": "subtitle", "time": 17283.51, "timestamp": "04:48:03", "text": "今のところは以上です。私は休むよ。私"}, {"type": "subtitle", "time": 17288.67, "timestamp": "04:48:08", "text": "内部。だから、あなたが"}, {"type": "subtitle", "time": 17291.628, "timestamp": "04:48:11", "text": "楽しんだ"}, {"type": "subtitle", "time": 17295.15, "timestamp": "04:48:15", "text": "何が、そして誰がやって来たのか"}, {"type": "subtitle", "time": 17300.35, "timestamp": "04:48:20", "text": "ビリー・ニーについて。ご来場ありがとうございました"}, {"type": "subtitle", "time": 17305.43, "timestamp": "04:48:25", "text": "と ling によって。そして垂直の流れの上に。"}, {"type": "subtitle", "time": 17307.27, "timestamp": "04:48:27", "text": "お越しいただきありがとうございます。必ずそうします"}, {"type": "subtitle", "time": 17311.788, "timestamp": "04:48:31", "text": "えっと、これをやるために、ちょっと待ってて。"}, {"type": "subtitle", "time": 17317.03, "timestamp": "04:48:37", "text": "あれ。えっと、ちょっと待って、垂直方向のWA設定"}, {"type": "subtitle", "time": 17319.99, "timestamp": "04:48:39", "text": "ストリーム。えっと、シーンを切り替えるとき、いいえ、"}, {"type": "subtitle", "time": 17322.31, "timestamp": "04:48:42", "text": "それはまたシーンを切り替えます"}, {"type": "subtitle", "time": 17325.67, "timestamp": "04:48:45", "text": "垂直の流れ。また、私が"}, {"type": "subtitle", "time": 17327.99, "timestamp": "04:48:47", "text": "えっと、こういうことをするんだよね？"}, {"type": "subtitle", "time": 17331.75, "timestamp": "04:48:51", "text": "例えば、私が席を外したりしている時、"}, {"type": "subtitle", "time": 17334.31, "timestamp": "04:48:54", "text": "私はそうします"}, {"type": "subtitle", "time": 17338.15, "timestamp": "04:48:58", "text": "垂直ストリームの視聴者は、"}]
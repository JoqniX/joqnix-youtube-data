[{"type": "subtitle", "time": 9969.349, "timestamp": "02:46:09", "text": "ええと、未来の何人かの人たち。私は好きです"}, {"type": "subtitle", "time": 9970.429, "timestamp": "02:46:10", "text": "あなた。"}, {"type": "subtitle", "time": 10011.79, "timestamp": "02:46:51", "text": "は。バイバイ。"}, {"type": "subtitle", "time": 10015.389, "timestamp": "02:46:55", "text": "待って、あなたの怪我を私が引き受けます。"}, {"type": "subtitle", "time": 10019.11, "timestamp": "02:46:59", "text": "待って、今から私の怪我を治しに行くわ。つまり"}]
[{"type": "subtitle", "time": 18062.15, "timestamp": "05:01:02", "text": "私は彼と対戦できると思う。きっとできるよ"}, {"type": "subtitle", "time": 18065.23, "timestamp": "05:01:05", "text": "彼を演じる。信じる"}, {"type": "subtitle", "time": 18067.708, "timestamp": "05:01:07", "text": "の"}, {"type": "subtitle", "time": 18070.47, "timestamp": "05:01:10", "text": "シンジュ。とにかく、"}, {"type": "subtitle", "time": 18071.39, "timestamp": "05:01:11", "text": "発砲"}, {"type": "subtitle", "time": 18073.91, "timestamp": "05:01:13", "text": "範囲。私はこれを見たことがありません"}, {"type": "subtitle", "time": 18076.628, "timestamp": "05:01:16", "text": "ゲームは永遠に続く。半分もわからない"}, {"type": "subtitle", "time": 18084.23, "timestamp": "05:01:24", "text": "作品。ええ、とても楽しみです。 D. では、"}, {"type": "subtitle", "time": 18109.59, "timestamp": "05:01:49", "text": "良い。私もやってみたけど、何も変わっていない。によって"}, {"type": "subtitle", "time": 18111.43, "timestamp": "05:01:51", "text": "それで、父のためにヴィックを作りました"}, {"type": "subtitle", "time": 18112.948, "timestamp": "05:01:52", "text": "同僚たちはこう言った。「あなたの娘は"}, {"type": "subtitle", "time": 18114.55, "timestamp": "05:01:54", "text": "「才能があるね」と私は言った。「私は"}, {"type": "subtitle", "time": 18116.55, "timestamp": "05:01:56", "text": "「ジャック・オー・ランタンだよ」と私は言った。「わあ、それはとても"}, {"type": "subtitle", "time": 18118.47, "timestamp": "05:01:58", "text": "「かわいい」と自分でも信じられない"}]
[{"type": "subtitle", "time": 11042.67, "timestamp": "03:04:02", "text": "けれど。私たちは、ええと、私たちは"}, {"type": "subtitle", "time": 11058.389, "timestamp": "03:04:18", "text": "おそらく防弾チョッキが破損しているのでしょう。手に入れる必要がある"}, {"type": "subtitle", "time": 11087.75, "timestamp": "03:04:47", "text": "さよなら。分かりますよ。なるほど。分かりますよ。なるほど"}, {"type": "subtitle", "time": 11089.59, "timestamp": "03:04:49", "text": "それ。"}]
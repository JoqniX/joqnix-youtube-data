[{"type": "subtitle", "time": 9906.03, "timestamp": "02:45:06", "text": "しかし私は"}, {"type": "subtitle", "time": 9922.95, "timestamp": "02:45:22", "text": "ああ、私は切り替えたいのですが"}, {"type": "subtitle", "time": 9924.19, "timestamp": "02:45:24", "text": "の"}, {"type": "subtitle", "time": 9925.87, "timestamp": "02:45:25", "text": "ASOP。"}, {"type": "subtitle", "time": 9929.269, "timestamp": "02:45:29", "text": "えっと、兄弟、君はそれが必要だ。"}, {"type": "subtitle", "time": 9931.75, "timestamp": "02:45:31", "text": "まったくその通りだ。私は自分のことをきちんとケアしていない。"}, {"type": "subtitle", "time": 9935.51, "timestamp": "02:45:35", "text": "私は文字通り泣いていました。"}, {"type": "subtitle", "time": 9946.91, "timestamp": "02:45:46", "text": "マネージャー。私もマネージャーが欲しいし、"}, {"type": "subtitle", "time": 9949.67, "timestamp": "02:45:49", "text": "もの。誰かに世話をしてもらいたい"}, {"type": "subtitle", "time": 9953.309, "timestamp": "02:45:53", "text": "自分。動き。でも、そう、"}, {"type": "subtitle", "time": 9956.469, "timestamp": "02:45:56", "text": "親切？君を冗談と呼んでもいいくらいだ。えっと"}, {"type": "subtitle", "time": 9957.79, "timestamp": "02:45:57", "text": "の"}]
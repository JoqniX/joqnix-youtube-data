[{"type": "subtitle", "time": 17160.23, "timestamp": "04:46:00", "text": "スケジュール、公開スケジュールはまだですが、私は"}, {"type": "subtitle", "time": 17163.19, "timestamp": "04:46:03", "text": "頭の中でスケジュールを立てるような感じ"}, {"type": "subtitle", "time": 17166.07, "timestamp": "04:46:06", "text": "この日、開始日に私はやります"}, {"type": "subtitle", "time": 17168.07, "timestamp": "04:46:08", "text": "もの。"}, {"type": "subtitle", "time": 17171.31, "timestamp": "04:46:11", "text": "そうですね、でも、私たちは"}, {"type": "subtitle", "time": 17173.07, "timestamp": "04:46:13", "text": "に"}, {"type": "subtitle", "time": 17175.23, "timestamp": "04:46:15", "text": "ついに配信開始"}, {"type": "subtitle", "time": 17176.91, "timestamp": "04:46:16", "text": "これ。"}, {"type": "subtitle", "time": 17179.788, "timestamp": "04:46:19", "text": "うん。"}, {"type": "subtitle", "time": 17182.75, "timestamp": "04:46:22", "text": "そして私には"}, {"type": "subtitle", "time": 17185.39, "timestamp": "04:46:25", "text": "今日"}, {"type": "subtitle", "time": 17189.67, "timestamp": "04:46:29", "text": "えっと、Twitchの長男が使ってた"}, {"type": "subtitle", "time": 17193.19, "timestamp": "04:46:33", "text": "リマインダーコマンドは良いですね。そしてそれは"}, {"type": "subtitle", "time": 17196.15, "timestamp": "04:46:36", "text": "実際に思いついたのは"}, {"type": "subtitle", "time": 17199.35, "timestamp": "04:46:39", "text": "実は。ああ、それは本当に"}, {"type": "subtitle", "time": 17206.07, "timestamp": "04:46:46", "text": "良い。ええ、実際それは"}, {"type": "subtitle", "time": 17208.59, "timestamp": "04:46:48", "text": "概念。"}, {"type": "subtitle", "time": 17210.44, "timestamp": "04:46:50", "text": "ニース。どこ"}, {"type": "subtitle", "time": 17211.628, "timestamp": "04:46:51", "text": "[音楽]"}, {"type": "subtitle", "time": 17215.35, "timestamp": "04:46:55", "text": "この配信関連のこと？ええ、届きましたよ。"}, {"type": "subtitle", "time": 17218.31, "timestamp": "04:46:58", "text": "水分補給をしましょう。したくない、したくない"}, {"type": "subtitle", "time": 17219.708, "timestamp": "04:46:59", "text": "脱水"}]
[{"type": "subtitle", "time": 20160.39, "timestamp": "05:36:00", "text": "行く。ピューピューピューピューと鳴らして"}, {"type": "subtitle", "time": 20161.868, "timestamp": "05:36:01", "text": "私たちの"}, {"type": "subtitle", "time": 20166.47, "timestamp": "05:36:06", "text": "最高。えっと、これはえっと、これは"}, {"type": "subtitle", "time": 20168.868, "timestamp": "05:36:08", "text": "過小評価されているかもしれない。これは"}, {"type": "subtitle", "time": 20172.31, "timestamp": "05:36:12", "text": "競争力。これはシフトプレイですよね？"}, {"type": "subtitle", "time": 20174.99, "timestamp": "05:36:14", "text": "ああ、わかった。シフト"}, {"type": "subtitle", "time": 20178.07, "timestamp": "05:36:18", "text": "遊ぶ。私はこれをすべきですか、それとも"}, {"type": "subtitle", "time": 20179.59, "timestamp": "05:36:19", "text": "これは一体何ですか？ 4番目は何ですか"}, {"type": "subtitle", "time": 20182.75, "timestamp": "05:36:22", "text": "オプション？何てことだ。"}, {"type": "subtitle", "time": 20186.35, "timestamp": "05:36:26", "text": "えっと、何ができないんですか？私はできると思う"}, {"type": "subtitle", "time": 20189.51, "timestamp": "05:36:29", "text": "これ。シフトプレイ。私にもできると思います。おお、"}, {"type": "subtitle", "time": 20191.59, "timestamp": "05:36:31", "text": "待って。何？私は自動で行いませんでした"}, {"type": "subtitle", "time": 20193.51, "timestamp": "05:36:33", "text": "即時ロッカー。ああ、神様。私は作る必要がある"}, {"type": "subtitle", "time": 20195.91, "timestamp": "05:36:35", "text": "インスタントロッカーのことですよね？あ、待って。私"}, {"type": "subtitle", "time": 20199.83, "timestamp": "05:36:39", "text": "忘れた。忘れた。ああ、忘れてた。"}, {"type": "subtitle", "time": 20203.27, "timestamp": "05:36:43", "text": "あ、待って。瞬時にロックされます。待って。えっと。おお"}, {"type": "subtitle", "time": 20204.91, "timestamp": "05:36:44", "text": "神。忘れた。実際には忘れていた"}, {"type": "subtitle", "time": 20208.27, "timestamp": "05:36:48", "text": "それ。えっと、私は何を探しているんだろう？"}, {"type": "subtitle", "time": 20216.39, "timestamp": "05:36:56", "text": "デッキ。実はそのことをすっかり忘れていました。私"}, {"type": "subtitle", "time": 20218.23, "timestamp": "05:36:58", "text": "それを忘れてた。ああ、忘れてた。"}]
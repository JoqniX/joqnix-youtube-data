[{"type": "subtitle", "time": 7869.03, "timestamp": "02:11:09", "text": "敵の鎌。それが私の切り方です"}, {"type": "subtitle", "time": 7870.03, "timestamp": "02:11:10", "text": "あなたの首"}, {"type": "subtitle", "time": 7873.79, "timestamp": "02:11:13", "text": "バールではなく、上へ押し上げるように。カラス、カラス"}, {"type": "subtitle", "time": 7876.51, "timestamp": "02:11:16", "text": "強引な手段。うん。"}, {"type": "subtitle", "time": 7879.35, "timestamp": "02:11:19", "text": "えっと、鎌。鎌ちゃんをください。"}, {"type": "subtitle", "time": 7883.109, "timestamp": "02:11:23", "text": "わかった。私が担当してもいいですか？ああ、"}, {"type": "subtitle", "time": 7885.35, "timestamp": "02:11:25", "text": "鎌を入れる。ああ、これは鎌だ。私は思った"}, {"type": "subtitle", "time": 7888.149, "timestamp": "02:11:28", "text": "それは鎌だった。ああ、気にしないで。ああ、"}, {"type": "subtitle", "time": 7890.51, "timestamp": "02:11:30", "text": "残念だった"}, {"type": "subtitle", "time": 7894.55, "timestamp": "02:11:34", "text": "騒音。ああ、なんてことだ。銃。ベクター。は"}, {"type": "subtitle", "time": 7902.31, "timestamp": "02:11:42", "text": "VSS。 VSS。スナイパーのように見える"}, {"type": "subtitle", "time": 7904.629, "timestamp": "02:11:44", "text": "けれど。"}, {"type": "subtitle", "time": 7906.35, "timestamp": "02:11:46", "text": "あなたは歩く"}, {"type": "subtitle", "time": 7913.91, "timestamp": "02:11:53", "text": "歩く。誰が撃っているんだ？私はできません"}, {"type": "subtitle", "time": 7919.39, "timestamp": "02:11:59", "text": "見る？"}]
[{"type": "subtitle", "time": 1260.47, "timestamp": "00:21:00", "text": "ゲームだけどね。それが私が嫌いな点です"}, {"type": "subtitle", "time": 1270.11, "timestamp": "00:21:10", "text": "ゲーム。すぐ上に着陸しましょう"}, {"type": "subtitle", "time": 1291.83, "timestamp": "00:21:31", "text": "パワーコースをどれだけ走れるか"}, {"type": "subtitle", "time": 1295.31, "timestamp": "00:21:35", "text": "このゲームでは"}, {"type": "subtitle", "time": 1298.149, "timestamp": "00:21:38", "text": "良い。しかし、彼らはあなたに"}, {"type": "subtitle", "time": 1301.51, "timestamp": "00:21:41", "text": "副武器か何か？何？どうすればいいですか"}]
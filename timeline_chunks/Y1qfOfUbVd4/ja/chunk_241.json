[{"type": "subtitle", "time": 14462.229, "timestamp": "04:01:02", "text": "わかった。ジョーは試合を見ることができない。そうそう。私"}, {"type": "subtitle", "time": 14465.189, "timestamp": "04:01:05", "text": "ボビーのこの設定を忘れてた"}, {"type": "subtitle", "time": 14467.79, "timestamp": "04:01:07", "text": "垂直の流れ。だから、見えないんです"}, {"type": "subtitle", "time": 14470.87, "timestamp": "04:01:10", "text": "残念ながら。えっと、それを設定する必要があるので、"}, {"type": "subtitle", "time": 14475.75, "timestamp": "04:01:15", "text": "いつでもこのWのものを観ることができます"}, {"type": "subtitle", "time": 14478.71, "timestamp": "04:01:18", "text": "私はあれに乗り換えるつもりです。そして私は"}, {"type": "subtitle", "time": 14479.79, "timestamp": "04:01:19", "text": "切り替え"}, {"type": "subtitle", "time": 14483.429, "timestamp": "04:01:23", "text": "えーと、垂直方向へ、垂直方向へ"}, {"type": "subtitle", "time": 14485.429, "timestamp": "04:01:25", "text": "同じように。うん、それはやらなきゃ。"}, {"type": "subtitle", "time": 14486.51, "timestamp": "04:01:26", "text": "日。"}, {"type": "subtitle", "time": 14501.269, "timestamp": "04:01:41", "text": "これ。私は、えっと、何を持っていないと思いますか"}, {"type": "subtitle", "time": 14512.59, "timestamp": "04:01:52", "text": "垂直方向がわからない"}, {"type": "subtitle", "time": 14517.269, "timestamp": "04:01:57", "text": "垂直ストリームのbiテキストとして"}]
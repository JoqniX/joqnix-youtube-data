[{"type": "subtitle", "time": 18362.708, "timestamp": "05:06:02", "text": "はぁ？うん、1試合で3点を狙おう"}, {"type": "subtitle", "time": 18366.47, "timestamp": "05:06:06", "text": "えっと、ちょっと待って、私は1試合だけを狙います"}, {"type": "subtitle", "time": 18372.31, "timestamp": "05:06:12", "text": "見る。しばらくピューピュー撃ってないから"}, {"type": "subtitle", "time": 18374.51, "timestamp": "05:06:14", "text": "自分が良いのか悪いのか分からない"}, {"type": "subtitle", "time": 18392.15, "timestamp": "05:06:32", "text": "エスカレーション？問題は私にあるのでしょうか、それとも他の誰かにあるのでしょうか？この地図"}, {"type": "subtitle", "time": 18395.03, "timestamp": "05:06:35", "text": "新しいアップデートで、見た目がおかしくなった。した"}, {"type": "subtitle", "time": 18397.31, "timestamp": "05:06:37", "text": "私はこれをプレイします"}, {"type": "subtitle", "time": 18409.03, "timestamp": "05:06:49", "text": "これはエスカレーションだと思います。"}, {"type": "subtitle", "time": 18410.19, "timestamp": "05:06:50", "text": "実は"}, {"type": "subtitle", "time": 18413.03, "timestamp": "05:06:53", "text": "エスカレーション。これは事態のエスカレーションだ。うん。"}, {"type": "subtitle", "time": 18415.51, "timestamp": "05:06:55", "text": "なぜ日本語に変更したのか？私は"}]
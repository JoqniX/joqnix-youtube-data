[{"type": "subtitle", "time": 13989.229, "timestamp": "03:53:09", "text": "兄弟。"}, {"type": "subtitle", "time": 13991.469, "timestamp": "03:53:11", "text": "ああ、これらは"}, {"type": "subtitle", "time": 13994.349, "timestamp": "03:53:14", "text": "人々"}, {"type": "subtitle", "time": 13998.189, "timestamp": "03:53:18", "text": "プロはプレイ方法を知っている"}, {"type": "subtitle", "time": 14010.67, "timestamp": "03:53:30", "text": "何？ああ、これは良い"}, {"type": "subtitle", "time": 14014.389, "timestamp": "03:53:34", "text": "ウェインシング。"}, {"type": "subtitle", "time": 14017.189, "timestamp": "03:53:37", "text": "そのブリーチの思い出は"}, {"type": "subtitle", "time": 14018.269, "timestamp": "03:53:38", "text": "ない"}, {"type": "subtitle", "time": 14020.59, "timestamp": "03:53:40", "text": "橋"}, {"type": "subtitle", "time": 14024.75, "timestamp": "03:53:44", "text": "硫黄または悪臭"}, {"type": "subtitle", "time": 14038.51, "timestamp": "03:53:58", "text": "ビーム。では、私は実際に何をしたのでしょうか"}]
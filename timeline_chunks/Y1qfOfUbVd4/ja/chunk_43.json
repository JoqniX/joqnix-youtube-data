[{"type": "subtitle", "time": 2601.589, "timestamp": "00:43:21", "text": "何てことだ。ええ、時間通りにご案内します"}, {"type": "subtitle", "time": 2603.75, "timestamp": "00:43:23", "text": "えっと、今は休暇中ですが、ぜひ読んでください。"}, {"type": "subtitle", "time": 2605.47, "timestamp": "00:43:25", "text": "チャットのルールとか。"}, {"type": "subtitle", "time": 2616.23, "timestamp": "00:43:36", "text": "ストリームのルールは"}, {"type": "subtitle", "time": 2619.03, "timestamp": "00:43:39", "text": "重要であり、極めて重要です。そう、もし"}, {"type": "subtitle", "time": 2621.75, "timestamp": "00:43:41", "text": "あなたが破りたいと思っているなら"}]
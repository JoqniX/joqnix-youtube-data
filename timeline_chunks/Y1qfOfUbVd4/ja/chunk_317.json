[{"type": "subtitle", "time": 19022.55, "timestamp": "05:17:02", "text": "自由。私はこの自由をずっと望んでいた"}, {"type": "subtitle", "time": 19025.19, "timestamp": "05:17:05", "text": "10月以来ずっと。月が始まった。"}, {"type": "subtitle", "time": 19028.75, "timestamp": "05:17:08", "text": "しかし、ついに私はこれ以上何も言えなくなりました"}, {"type": "subtitle", "time": 19042.31, "timestamp": "05:17:22", "text": "ハッピー。うん。ドライバーのアップデートが多すぎる"}, {"type": "subtitle", "time": 19051.91, "timestamp": "05:17:31", "text": "ガンバ。そう、俺たちは悪魔の1と2の中にいる"}, {"type": "subtitle", "time": 19055.27, "timestamp": "05:17:35", "text": "残り。うん。なぜ彼がなぜ"}, {"type": "subtitle", "time": 19057.31, "timestamp": "05:17:37", "text": "私の誕生日みたいに"}, {"type": "subtitle", "time": 19059.75, "timestamp": "05:17:39", "text": "月？でも私の"}, {"type": "subtitle", "time": 19064.27, "timestamp": "05:17:44", "text": "10月は、ただ単に、"}, {"type": "subtitle", "time": 19066.99, "timestamp": "05:17:46", "text": "もし私が"}, {"type": "subtitle", "time": 19070.708, "timestamp": "05:17:50", "text": "つまり、もし私がただそうしないことができれば"}, {"type": "subtitle", "time": 19073.27, "timestamp": "05:17:53", "text": "10月にホラーゲームをストリーミング配信したら、"}, {"type": "subtitle", "time": 19075.59, "timestamp": "05:17:55", "text": "その月を好きになれたら嬉しい。その"}, {"type": "subtitle", "time": 19078.628, "timestamp": "05:17:58", "text": "ただ、今すぐそうしなければならないんです。しなければならない"}, {"type": "subtitle", "time": 19079.55, "timestamp": "05:17:59", "text": "ストリーム"}]
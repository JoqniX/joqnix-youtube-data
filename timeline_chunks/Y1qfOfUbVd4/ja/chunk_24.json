[{"type": "subtitle", "time": 1440.669, "timestamp": "00:24:00", "text": "ハント。"}, {"type": "subtitle", "time": 1443.029, "timestamp": "00:24:03", "text": "必死に働く。私はハッスルが何だったか忘れてしまった"}, {"type": "subtitle", "time": 1455.669, "timestamp": "00:24:15", "text": "自分？今の見た？誰かが撃たれた"}, {"type": "subtitle", "time": 1457.23, "timestamp": "00:24:17", "text": "私ですよね？違う"}, {"type": "subtitle", "time": 1484.13, "timestamp": "00:24:44", "text": "ああ、競馬ゲーム。ああ、"}]
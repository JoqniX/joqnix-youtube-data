[{"type": "subtitle", "time": 2288.03, "timestamp": "00:38:08", "text": "[音楽]"}, {"type": "subtitle", "time": 2300.349, "timestamp": "00:38:20", "text": "ヘイ、ヘイ、ヘイ、ヘイ、ヘイ、ヘイ、ヘイ、ヘイ、ヘイ、"}, {"type": "subtitle", "time": 2316.31, "timestamp": "00:38:36", "text": "おい。何？どうしたの？あ、待って。"}, {"type": "subtitle", "time": 2318.15, "timestamp": "00:38:38", "text": "なぜこの部品はこんな風に詰まっているのですか？"}, {"type": "subtitle", "time": 2320.87, "timestamp": "00:38:40", "text": "え、何？"}, {"type": "subtitle", "time": 2322.95, "timestamp": "00:38:42", "text": "はい、どうぞ。また、私は"}, {"type": "subtitle", "time": 2325.19, "timestamp": "00:38:45", "text": "ブラウザをリセットしたので、"}, {"type": "subtitle", "time": 2338.3, "timestamp": "00:38:58", "text": "幸運を。"}]
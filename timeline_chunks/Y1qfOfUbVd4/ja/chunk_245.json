[{"type": "subtitle", "time": 14716.75, "timestamp": "04:05:16", "text": "はぁ？私はただ待つだけです。ママがここにいた。待って、"}, {"type": "subtitle", "time": 14722.15, "timestamp": "04:05:22", "text": "どこ？ありがとう。こんにちは、マラマ。私 私"}, {"type": "subtitle", "time": 14724.71, "timestamp": "04:05:24", "text": "今、あなたに気づきました。ああ、私は"}, {"type": "subtitle", "time": 14733.75, "timestamp": "04:05:33", "text": "マッチャ。こんにちは。動画をありがとうございます。による"}, {"type": "subtitle", "time": 14737.349, "timestamp": "04:05:37", "text": "ところで、あれはぼやけて見える？はい。えっと、"}, {"type": "subtitle", "time": 14741.71, "timestamp": "04:05:41", "text": "ビリーのせいでぼやけている"}, {"type": "subtitle", "time": 14747.75, "timestamp": "04:05:47", "text": "ええ、ぼやけているのは"}, {"type": "subtitle", "time": 14749.79, "timestamp": "04:05:49", "text": "ビリー・ビリー"}, {"type": "subtitle", "time": 14752.63, "timestamp": "04:05:52", "text": "もの。もう一つBをして電話をかけるべきでしょうか？"}, {"type": "subtitle", "time": 14754.11, "timestamp": "04:05:54", "text": "それは"}]
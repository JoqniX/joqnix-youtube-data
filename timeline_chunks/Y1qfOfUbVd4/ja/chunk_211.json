[{"type": "subtitle", "time": 12669.429, "timestamp": "03:31:09", "text": "[音楽]"}, {"type": "subtitle", "time": 12671.67, "timestamp": "03:31:11", "text": "もっと多くの人。ピューピューピューピュー。行くよ"}, {"type": "subtitle", "time": 12673.55, "timestamp": "03:31:13", "text": "座席へ"}, {"type": "subtitle", "time": 12676.91, "timestamp": "03:31:16", "text": "ピュー。私を待っててください。教会の席に着きます"}, {"type": "subtitle", "time": 12679.83, "timestamp": "03:31:19", "text": "ピュー。よし、これを自動実行しよう。私はかもしれない"}, {"type": "subtitle", "time": 12681.07, "timestamp": "03:31:21", "text": "得る"}, {"type": "subtitle", "time": 12684.229, "timestamp": "03:31:24", "text": "ゾーンが来る前に起きろ。ああ、神様、"}, {"type": "subtitle", "time": 12699.59, "timestamp": "03:31:39", "text": "ババ、スコットランド人とPUBGを試してみた？"}, {"type": "subtitle", "time": 12708.71, "timestamp": "03:31:48", "text": "以前は、ストリームはいいえ、持っていませんでした"}, {"type": "subtitle", "time": 12710.67, "timestamp": "03:31:50", "text": "私はしていません"}, {"type": "subtitle", "time": 12713.91, "timestamp": "03:31:53", "text": "まだ。ああ、大変だ、ゾーンが来るぞ。私は"}, {"type": "subtitle", "time": 12718.11, "timestamp": "03:31:58", "text": "死んだ。酔っ払ったよ。ああ、もう酔っぱらっちゃった。"}]
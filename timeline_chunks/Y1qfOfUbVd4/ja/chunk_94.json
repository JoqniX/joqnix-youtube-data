[{"type": "subtitle", "time": 5643.149, "timestamp": "01:34:03", "text": "今日は木曜日の夜を楽しんでください"}, {"type": "subtitle", "time": 5647.51, "timestamp": "01:34:07", "text": "先に。本当にありがとうございました。"}, {"type": "subtitle", "time": 5651.99, "timestamp": "01:34:11", "text": "星明かりがあなたを導きます。あなたが"}, {"type": "subtitle", "time": 5654.39, "timestamp": "01:34:14", "text": "今日はよく眠れて、いい夢も見た。"}, {"type": "subtitle", "time": 5657.59, "timestamp": "01:34:17", "text": "もの。今日、星々があなたを祝福しますように。良い"}, {"type": "subtitle", "time": 5660.31, "timestamp": "01:34:20", "text": "明日が幸運だとしても、"}, {"type": "subtitle", "time": 5663.35, "timestamp": "01:34:23", "text": "夕方または朝、他の人は"}, {"type": "subtitle", "time": 5666.149, "timestamp": "01:34:26", "text": "他のタイムゾーンでは、あなたの"}, {"type": "subtitle", "time": 5669.51, "timestamp": "01:34:29", "text": "木曜日が控えている。わかった。こんにちは。おやすみ。"}]
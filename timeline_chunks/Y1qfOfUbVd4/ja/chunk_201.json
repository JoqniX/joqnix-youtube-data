[{"type": "subtitle", "time": 12062.429, "timestamp": "03:21:02", "text": "えっと、私の"}, {"type": "subtitle", "time": 12066.429, "timestamp": "03:21:06", "text": "最善の行動選択は"}, {"type": "subtitle", "time": 12068.269, "timestamp": "03:21:08", "text": "に"}, {"type": "subtitle", "time": 12071.91, "timestamp": "03:21:11", "text": "h オーケー、いいよ。家へ行きます"}, {"type": "subtitle", "time": 12076.229, "timestamp": "03:21:16", "text": "そして略奪して彼を殴り倒せ。"}, {"type": "subtitle", "time": 12081.03, "timestamp": "03:21:21", "text": "こんにちは。あーあー、私は、私は、ちょっと"}, {"type": "subtitle", "time": 12083.59, "timestamp": "03:21:23", "text": "言ってください。もし私があなたの"}, {"type": "subtitle", "time": 12089.15, "timestamp": "03:21:29", "text": "名前。配信へようこ​​そ。サック・ポール、"}, {"type": "subtitle", "time": 12092.75, "timestamp": "03:21:32", "text": "いらっしゃいませ。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 12095.67, "timestamp": "03:21:35", "text": "こんにちは。これはあなたの最初の"}, {"type": "subtitle", "time": 12098.269, "timestamp": "03:21:38", "text": "今がその時です。どうやって私を見つけたのですか？"}, {"type": "subtitle", "time": 12115.71, "timestamp": "03:21:55", "text": "はい、ここから読み込みます"}]
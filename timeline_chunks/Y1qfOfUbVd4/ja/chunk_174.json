[{"type": "subtitle", "time": 10440.91, "timestamp": "02:54:00", "text": "[拍手]"}, {"type": "subtitle", "time": 10442.429, "timestamp": "02:54:02", "text": "お金。"}, {"type": "subtitle", "time": 10446.389, "timestamp": "02:54:06", "text": "ええと、この疑問符をここに付けてください。あなたは手に入れるでしょう"}, {"type": "subtitle", "time": 10471.07, "timestamp": "02:54:31", "text": "[音楽]"}, {"type": "subtitle", "time": 10485.469, "timestamp": "02:54:45", "text": "待って、誰かが実際に撃っている"}, {"type": "subtitle", "time": 10491.07, "timestamp": "02:54:51", "text": "自分。誰が？どうやって？なぜ"}, {"type": "subtitle", "time": 10494.23, "timestamp": "02:54:54", "text": "あなた？どこ？ああ、君のことは分かったよ。あなたの"}, {"type": "subtitle", "time": 10496.23, "timestamp": "02:54:56", "text": "頭。君の頭が見えたよ。君の頭が見えたよ。"}, {"type": "subtitle", "time": 10498.469, "timestamp": "02:54:58", "text": "お前を迎えに行くぞ。そう、待ってて"}]
[{"type": "subtitle", "time": 22262.868, "timestamp": "06:11:02", "text": "サブスクライバーのことを気にかけている。でも昨日は"}, {"type": "subtitle", "time": 22265.59, "timestamp": "06:11:05", "text": "皆が祝福の言葉を述べた。私は"}, {"type": "subtitle", "time": 22268.868, "timestamp": "06:11:08", "text": "幸せそう。でも、誰かが"}, {"type": "subtitle", "time": 22271.35, "timestamp": "06:11:11", "text": "購読を解除しました。"}, {"type": "subtitle", "time": 22275.628, "timestamp": "06:11:15", "text": "FBI、口を開け。ああ、耳が痛い。ああ、"}, {"type": "subtitle", "time": 22277.948, "timestamp": "06:11:17", "text": "ヤフー。私"}, {"type": "subtitle", "time": 22284.91, "timestamp": "06:11:24", "text": "パーリ語、どのように"}, {"type": "subtitle", "time": 22296.19, "timestamp": "06:11:36", "text": "何をしているの？ブーム。私は600になりました。"}, {"type": "subtitle", "time": 22300.43, "timestamp": "06:11:40", "text": "上？彼はそうする必要はなかった"}, {"type": "subtitle", "time": 22304.23, "timestamp": "06:11:44", "text": "死ぬ。ええ、大抵はそうですね。だから私は主に"}, {"type": "subtitle", "time": 22306.708, "timestamp": "06:11:46", "text": "ルールと視聴者に追加されました"}, {"type": "subtitle", "time": 22310.23, "timestamp": "06:11:50", "text": "ガイドラインは何があっても"}, {"type": "subtitle", "time": 22312.23, "timestamp": "06:11:52", "text": "誰を何人くらいにするか教えてください"}, {"type": "subtitle", "time": 22314.83, "timestamp": "06:11:54", "text": "人々は見ているし、サブコンも知っている"}]
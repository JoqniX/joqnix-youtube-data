[{"type": "subtitle", "time": 4801.229, "timestamp": "01:20:01", "text": "こんにちは。"}, {"type": "subtitle", "time": 4804.51, "timestamp": "01:20:04", "text": "五条。こんにちは、ラクン。こんにちは。いらっしゃいませ。"}, {"type": "subtitle", "time": 4807.91, "timestamp": "01:20:07", "text": "いらっしゃいませ。そうそう。こんにちは、ラクン。ところで、"}, {"type": "subtitle", "time": 4809.91, "timestamp": "01:20:09", "text": "あなたはあの新しい人気ゲームをプレイしていますか？"}, {"type": "subtitle", "time": 4812.95, "timestamp": "01:20:12", "text": "パルワールドと呼ばれている？待って、それは何と呼ばれていたか"}, {"type": "subtitle", "time": 4815.75, "timestamp": "01:20:15", "text": "パルワールドか、それとも別のもの？パルワールド、"}, {"type": "subtitle", "time": 4818.669, "timestamp": "01:20:18", "text": "右？それはパルと呼ばれています。"}, {"type": "subtitle", "time": 4828.27, "timestamp": "01:20:28", "text": "ary。アークウムサバイバルに似ています"}, {"type": "subtitle", "time": 4830.55, "timestamp": "01:20:30", "text": "伝説。サバイバルの伝説。サバイバル"}, {"type": "subtitle", "time": 4833.669, "timestamp": "01:20:33", "text": "進化ですよね？知らない人もいる。"}, {"type": "subtitle", "time": 4835.91, "timestamp": "01:20:35", "text": "うん。そう、弧を描くような感じだね。あ、待って。"}, {"type": "subtitle", "time": 4839.99, "timestamp": "01:20:39", "text": "ミナタのゲームがここにあります。そうそう。の"}, {"type": "subtitle", "time": 4841.39, "timestamp": "01:20:41", "text": "デート"}, {"type": "subtitle", "time": 4844.39, "timestamp": "01:20:44", "text": "シミュレーション。そういえば、私は一度もプレイしたことがない"}, {"type": "subtitle", "time": 4847.51, "timestamp": "01:20:47", "text": "オートマチックゲームみたいだよね？恋愛シミュレーション"}, {"type": "subtitle", "time": 4848.91, "timestamp": "01:20:48", "text": "種類"}, {"type": "subtitle", "time": 4853.149, "timestamp": "01:20:53", "text": "ゲーム。それは良いことだ。変更"}]
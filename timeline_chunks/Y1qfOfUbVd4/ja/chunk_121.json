[{"type": "subtitle", "time": 7268.39, "timestamp": "02:01:08", "text": "ああ、あれは選手だ。それが私たちの"}, {"type": "subtitle", "time": 7270.43, "timestamp": "02:01:10", "text": "チーム。何てことだ。私はとても"}, {"type": "subtitle", "time": 7273.07, "timestamp": "02:01:13", "text": "ごめん。あなたは何でしたか"}, {"type": "subtitle", "time": 7291.87, "timestamp": "02:01:31", "text": "このゲームではリロードしてください。"}]
[{"type": "subtitle", "time": 22145.43, "timestamp": "06:09:05", "text": "良い。ああ、あの試合のことですね。はい、真ん中"}, {"type": "subtitle", "time": 22147.868, "timestamp": "06:09:07", "text": "片方はデッドマッチだ。手に入れた"}, {"type": "subtitle", "time": 22159.23, "timestamp": "06:09:19", "text": "素敵なネオンカラーにやられた。"}, {"type": "subtitle", "time": 22168.708, "timestamp": "06:09:28", "text": "[音楽]"}, {"type": "subtitle", "time": 22170.75, "timestamp": "06:09:30", "text": "こんにちは"}]
[{"type": "subtitle", "time": 20224.03, "timestamp": "05:37:04", "text": "うん、そうしよう"}, {"type": "subtitle", "time": 20227.83, "timestamp": "05:37:07", "text": "行く。わかった。ええと、ヴァレラントのエージェント選定"}, {"type": "subtitle", "time": 20230.948, "timestamp": "05:37:10", "text": "画面。じゃあ、その鍵穴の中に何かを入れましょう。私"}, {"type": "subtitle", "time": 20233.43, "timestamp": "05:37:13", "text": "デッドロックに入れたので、"}, {"type": "subtitle", "time": 20236.27, "timestamp": "05:37:16", "text": "ネオン。だから私は"}, {"type": "subtitle", "time": 20238.91, "timestamp": "05:37:18", "text": "その物"}, {"type": "subtitle", "time": 20241.91, "timestamp": "05:37:21", "text": "私は自分のために物が必要なので"}, {"type": "subtitle", "time": 20245.35, "timestamp": "05:37:25", "text": "ハンティング・ダンディ、新しいプロフィール。うん。"}, {"type": "subtitle", "time": 20248.75, "timestamp": "05:37:28", "text": "一番物が多いのはどこ？マウス"}, {"type": "subtitle", "time": 20253.19, "timestamp": "05:37:33", "text": "位置。わかった。開始するには押してください。どうすればいいですか"}, {"type": "subtitle", "time": 20254.51, "timestamp": "05:37:34", "text": "プレス"}, {"type": "subtitle", "time": 20257.91, "timestamp": "05:37:37", "text": "これ？あらら。待って。必要でしょうか、必要でしょうか"}, {"type": "subtitle", "time": 20259.83, "timestamp": "05:37:39", "text": "これをキーボードに接続する必要がありますか？"}]
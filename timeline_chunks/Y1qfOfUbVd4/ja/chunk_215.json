[{"type": "subtitle", "time": 12905.95, "timestamp": "03:35:05", "text": "私は"}, {"type": "subtitle", "time": 12914.02, "timestamp": "03:35:14", "text": "待って、待って、"}, {"type": "subtitle", "time": 12915.63, "timestamp": "03:35:15", "text": "[音楽]"}, {"type": "subtitle", "time": 12917.95, "timestamp": "03:35:17", "text": "待って。"}, {"type": "subtitle", "time": 12920.55, "timestamp": "03:35:20", "text": "あの、その音はどこから聞こえてくるんですか？"}, {"type": "subtitle", "time": 12938.15, "timestamp": "03:35:38", "text": "よお、彼が見えるよ。彼が見える。彼が見える。私"}, {"type": "subtitle", "time": 12940.15, "timestamp": "03:35:40", "text": "彼に会ってください。彼が見える。彼が見える。なるほど"}, {"type": "subtitle", "time": 12941.75, "timestamp": "03:35:41", "text": "彼。彼が見える。彼を走らせるつもりだ"}, {"type": "subtitle", "time": 12943.51, "timestamp": "03:35:43", "text": "下。奴を追い詰めてやる。私は"}, {"type": "subtitle", "time": 12952.55, "timestamp": "03:35:52", "text": "下。お前を追い詰めてやる。私"}, {"type": "subtitle", "time": 12953.75, "timestamp": "03:35:53", "text": "できなかった。私はできませんでした。私はできませんでした。私"}, {"type": "subtitle", "time": 12955.19, "timestamp": "03:35:55", "text": "できなかった。待って、待って、待って。今行ってる"}, {"type": "subtitle", "time": 12957.389, "timestamp": "03:35:57", "text": "のために"}]
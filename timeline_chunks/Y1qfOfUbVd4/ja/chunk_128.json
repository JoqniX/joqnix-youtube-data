[{"type": "subtitle", "time": 7680.95, "timestamp": "02:08:00", "text": "さらに、共同オーバーのようなものも得られます"}, {"type": "subtitle", "time": 7682.99, "timestamp": "02:08:02", "text": "あるいは、そんな感じ。それはまだ"}, {"type": "subtitle", "time": 7686.95, "timestamp": "02:08:06", "text": "もの？こんにちは。どうすればそこへ行けますか？"}, {"type": "subtitle", "time": 7689.75, "timestamp": "02:08:09", "text": "神よ、私はかつてゲームをする人たちを鍛えていました"}, {"type": "subtitle", "time": 7692.91, "timestamp": "02:08:12", "text": "ずっと昔のことです。入手できません"}, {"type": "subtitle", "time": 7699.629, "timestamp": "02:08:19", "text": "ここ？"}, {"type": "subtitle", "time": 7703.589, "timestamp": "02:08:23", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 7705.229, "timestamp": "02:08:25", "text": "こんにちは"}, {"type": "subtitle", "time": 7708.55, "timestamp": "02:08:28", "text": "富士。このゲームにはまだベクター要素はありますか？"}, {"type": "subtitle", "time": 7712.189, "timestamp": "02:08:32", "text": "ええ、そうですね。こんにちは、アラクサ。こんにちは。"}]
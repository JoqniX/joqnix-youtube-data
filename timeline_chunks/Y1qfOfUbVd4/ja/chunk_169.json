[{"type": "subtitle", "time": 10140.19, "timestamp": "02:49:00", "text": "彼らは理解しない"}, {"type": "subtitle", "time": 10142.269, "timestamp": "02:49:02", "text": "何でも。"}, {"type": "subtitle", "time": 10147.83, "timestamp": "02:49:07", "text": "クーポンを5枚購入してください。わかった。"}, {"type": "subtitle", "time": 10150.309, "timestamp": "02:49:10", "text": "キャップ15を手に入れるために必要な質問"}, {"type": "subtitle", "time": 10152.349, "timestamp": "02:49:12", "text": "カジュアルモードで数分間。私は"}, {"type": "subtitle", "time": 10156.19, "timestamp": "02:49:16", "text": "通常通り長押ししてから使用"}, {"type": "subtitle", "time": 10159.469, "timestamp": "02:49:19", "text": "交渉。わかった。ゲーム"}, {"type": "subtitle", "time": 10163.349, "timestamp": "02:49:23", "text": "モード。わかった。"}, {"type": "subtitle", "time": 10165.469, "timestamp": "02:49:25", "text": "えっと、10"}, {"type": "subtitle", "time": 10168.75, "timestamp": "02:49:28", "text": "利用可能なポイント"}, {"type": "subtitle", "time": 10171.349, "timestamp": "02:49:31", "text": "ポイント。孤立したパイロットセット。何が"}, {"type": "subtitle", "time": 10174.71, "timestamp": "02:49:34", "text": "それ？ああ、君はこれを知るんだね。ああ、私は"}, {"type": "subtitle", "time": 10176.75, "timestamp": "02:49:36", "text": "得る"}, {"type": "subtitle", "time": 10186.07, "timestamp": "02:49:46", "text": "いいね。えっと、水をもらってきます。でもまあいいや、"}, {"type": "subtitle", "time": 10188.94, "timestamp": "02:49:48", "text": "少ししたら戻ってきます。"}, {"type": "subtitle", "time": 10193.79, "timestamp": "02:49:53", "text": "何が"}, {"type": "subtitle", "time": 10197.269, "timestamp": "02:49:57", "text": "それまで治癒させて"}, {"type": "subtitle", "time": 10199.59, "timestamp": "02:49:59", "text": "可愛くさせて、そう、私は"}]
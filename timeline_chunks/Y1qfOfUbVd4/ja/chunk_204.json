[{"type": "subtitle", "time": 12251.11, "timestamp": "03:24:11", "text": "何？あれ、それってここから来たんじゃないの？"}, {"type": "subtitle", "time": 12254.15, "timestamp": "03:24:14", "text": "ああ、こっちで男たちが喧嘩してるぞ。ああ、"}, {"type": "subtitle", "time": 12261.95, "timestamp": "03:24:21", "text": "さあ、これについて考えてみましょう。"}, {"type": "subtitle", "time": 12264.79, "timestamp": "03:24:24", "text": "それを数えるように。ああ、君のことは分かったよ。なるほど"}, {"type": "subtitle", "time": 12267.91, "timestamp": "03:24:27", "text": "あなた。あなたが見えてます。えーと、その前に、"}, {"type": "subtitle", "time": 12277.269, "timestamp": "03:24:37", "text": "行かないで。行かないで。どこ？どこ？誰が"}, {"type": "subtitle", "time": 12291.83, "timestamp": "03:24:51", "text": "より良い。ええ、世界的な現象だと思います。"}, {"type": "subtitle", "time": 12293.91, "timestamp": "03:24:53", "text": "待って、グローはないと思う"}, {"type": "subtitle", "time": 12296.87, "timestamp": "03:24:56", "text": "調査。サーバーシステムはありますか？"}]
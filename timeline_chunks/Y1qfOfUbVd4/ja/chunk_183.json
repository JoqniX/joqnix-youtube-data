[{"type": "subtitle", "time": 10989.87, "timestamp": "03:03:09", "text": "うん、やってみよう"}, {"type": "subtitle", "time": 10993.63, "timestamp": "03:03:13", "text": "方法。ああ、長い"}, {"type": "subtitle", "time": 11013.469, "timestamp": "03:03:33", "text": "あの場所から舞台を去ってよかった"}, {"type": "subtitle", "time": 11015.75, "timestamp": "03:03:35", "text": "早いうちに、でも私は"}, {"type": "subtitle", "time": 11017.71, "timestamp": "03:03:37", "text": "ゾーン"}, {"type": "subtitle", "time": 11021.71, "timestamp": "03:03:41", "text": "少し。えっと、現在、救急キットを3つ持っています。"}, {"type": "subtitle", "time": 11024.95, "timestamp": "03:03:44", "text": "そして包帯が5つ。それだけで十分だ。"}, {"type": "subtitle", "time": 11031.19, "timestamp": "03:03:51", "text": "うん。ああ、ゾーンは私のものだ。"}, {"type": "subtitle", "time": 11034.07, "timestamp": "03:03:54", "text": "私には無理だと思う。はい、私は"}, {"type": "subtitle", "time": 11036.19, "timestamp": "03:03:56", "text": "作らない"}, {"type": "subtitle", "time": 11039.309, "timestamp": "03:03:59", "text": "それ。大丈夫です、"}]
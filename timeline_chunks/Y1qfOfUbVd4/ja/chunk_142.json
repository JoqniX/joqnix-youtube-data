[{"type": "subtitle", "time": 8534.23, "timestamp": "02:22:14", "text": "どういうわけか、集中状態に入っている。私は"}, {"type": "subtitle", "time": 8536.19, "timestamp": "02:22:16", "text": "チェック"}, {"type": "subtitle", "time": 8550.07, "timestamp": "02:22:30", "text": "彼、彼は手に入れた。え？誰が彼を殺したのか？"}, {"type": "subtitle", "time": 8552.59, "timestamp": "02:22:32", "text": "待って、彼は殺されたんだ。犯人は誰だ？"}, {"type": "subtitle", "time": 8557.07, "timestamp": "02:22:37", "text": "待って。えっと、私はIが必要です。ここはとても"}]
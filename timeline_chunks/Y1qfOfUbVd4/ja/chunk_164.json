[{"type": "subtitle", "time": 9847.19, "timestamp": "02:44:07", "text": "できません。でも、実は私は死ぬことができないんです"}, {"type": "subtitle", "time": 9868.07, "timestamp": "02:44:28", "text": "次。うん。ジャマアをできるだけ良くして"}, {"type": "subtitle", "time": 9871.11, "timestamp": "02:44:31", "text": "すごい、そして大きくなる。単に"}, {"type": "subtitle", "time": 9873.75, "timestamp": "02:44:33", "text": "名声のことだけど、そう、"}, {"type": "subtitle", "time": 9883.11, "timestamp": "02:44:43", "text": "夢。うん。だから、集中しなきゃ、集中しなきゃ、"}, {"type": "subtitle", "time": 9889.11, "timestamp": "02:44:49", "text": "だって、恋愛関係では"}, {"type": "subtitle", "time": 9892.429, "timestamp": "02:44:52", "text": "集中しなければならない、あなたは"}, {"type": "subtitle", "time": 9897.23, "timestamp": "02:44:57", "text": "時間とかその他諸々、いいえ、だから私は"}]
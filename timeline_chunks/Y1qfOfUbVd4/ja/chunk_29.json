[{"type": "subtitle", "time": 1742.789, "timestamp": "00:29:02", "text": "これで終わりにします。洗濯物をしてください。私は持っていた"}, {"type": "subtitle", "time": 1743.549, "timestamp": "00:29:03", "text": "に"}, {"type": "subtitle", "time": 1747.59, "timestamp": "00:29:07", "text": "今日はたくさんの洗濯物を洗う。私"}, {"type": "subtitle", "time": 1751.07, "timestamp": "00:29:11", "text": "ただ座って、洗うのを忘れる"}, {"type": "subtitle", "time": 1753.149, "timestamp": "00:29:13", "text": "すべて。"}, {"type": "subtitle", "time": 1756.71, "timestamp": "00:29:16", "text": "おお。うん。"}, {"type": "subtitle", "time": 1768.669, "timestamp": "00:29:28", "text": "アジアの美術品"}, {"type": "subtitle", "time": 1787.95, "timestamp": "00:29:47", "text": "忍者。長時間のクロノグラフ。"}]
[{"type": "subtitle", "time": 8282.91, "timestamp": "02:18:02", "text": "私が聞いた歩行音"}, {"type": "subtitle", "time": 8286.07, "timestamp": "02:18:06", "text": "以前？気味の悪い男は誰だったのか"}, {"type": "subtitle", "time": 8294.87, "timestamp": "02:18:14", "text": "以前？誰かがいるはずだ。"}, {"type": "subtitle", "time": 8303.509, "timestamp": "02:18:23", "text": "どうしていつもこんな風に人を見るの？"}, {"type": "subtitle", "time": 8328.389, "timestamp": "02:18:48", "text": "ああ、このゲームはどこにあるのか"}, {"type": "subtitle", "time": 8330.469, "timestamp": "02:18:50", "text": "方向感覚がない。私はできません"}, {"type": "subtitle", "time": 8332.389, "timestamp": "02:18:52", "text": "弾丸を理解する。どこですか"}]
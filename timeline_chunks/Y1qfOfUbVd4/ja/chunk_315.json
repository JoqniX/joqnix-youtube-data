[{"type": "subtitle", "time": 18900.868, "timestamp": "05:15:00", "text": "良い。あ、こんにちは。私のアンティークはどこ？"}, {"type": "subtitle", "time": 18903.11, "timestamp": "05:15:03", "text": "ゴースティング対策？さて、これは何でしょう"}, {"type": "subtitle", "time": 18910.55, "timestamp": "05:15:10", "text": "ええと、税関は税関の見た目になります。"}, {"type": "subtitle", "time": 18913.11, "timestamp": "05:15:13", "text": "これが税関の様子です。でも私にはできない"}, {"type": "subtitle", "time": 18914.67, "timestamp": "05:15:14", "text": "追加"}, {"type": "subtitle", "time": 18918.83, "timestamp": "05:15:18", "text": "あなたならできるから"}, {"type": "subtitle", "time": 18933.11, "timestamp": "05:15:33", "text": "壊れた。私は自分が言ったとは言いたくない"}, {"type": "subtitle", "time": 18935.67, "timestamp": "05:15:35", "text": "日本語でやるので、"}, {"type": "subtitle", "time": 18941.91, "timestamp": "05:15:41", "text": "こんにちは。お元気ですか？わかった。なぜ？"}, {"type": "subtitle", "time": 18944.23, "timestamp": "05:15:44", "text": "これは壊れています。では、あなたは何をしますか？その"}, {"type": "subtitle", "time": 18945.788, "timestamp": "05:15:45", "text": "不具合が発生しました。"}, {"type": "subtitle", "time": 18953.83, "timestamp": "05:15:53", "text": "リスト？騙しの事件が起きた。"}, {"type": "subtitle", "time": 18957.15, "timestamp": "05:15:57", "text": "そうねぇ。暴動は欺瞞である。新しい"}, {"type": "subtitle", "time": 18959.59, "timestamp": "05:15:59", "text": "アップデート？えっと、新しいアップデートはありますか？"}]
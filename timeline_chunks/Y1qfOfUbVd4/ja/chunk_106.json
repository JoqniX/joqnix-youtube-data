[{"type": "subtitle", "time": 6361.629, "timestamp": "01:46:01", "text": "すべて大きい"}, {"type": "subtitle", "time": 6364.55, "timestamp": "01:46:04", "text": "えっと、私は隅っこに追いやられちゃいます。"}, {"type": "subtitle", "time": 6383.51, "timestamp": "01:46:23", "text": "家族が最初に試みる、死んだマッチを温める"}, {"type": "subtitle", "time": 6385.99, "timestamp": "01:46:25", "text": "上。それは、それは、それは、それは、死んだマッチです。"}, {"type": "subtitle", "time": 6389.669, "timestamp": "01:46:29", "text": "ああ、チームデスマッチか。ああ、自動入力機能ですね。できますか"}, {"type": "subtitle", "time": 6392.55, "timestamp": "01:46:32", "text": "これを削除しますか？私は人を必要としない。どのように"}, {"type": "subtitle", "time": 6394.43, "timestamp": "01:46:34", "text": "これを削除します"}, {"type": "subtitle", "time": 6397.95, "timestamp": "01:46:37", "text": "自動入力？削除方法"}, {"type": "subtitle", "time": 6401.229, "timestamp": "01:46:41", "text": "自動入力？ええと、まあ"}, {"type": "subtitle", "time": 6404.55, "timestamp": "01:46:44", "text": "大丈夫。方法はある。何か方法がありますか"}, {"type": "subtitle", "time": 6411.109, "timestamp": "01:46:51", "text": "音声チャットは無効になっています。はい、ありがとうございます"}, {"type": "subtitle", "time": 6415.99, "timestamp": "01:46:55", "text": "神。チーム限定。実際には、全くない。ええ、私は"}]
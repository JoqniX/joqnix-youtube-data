[{"type": "subtitle", "time": 8721.63, "timestamp": "02:25:21", "text": "わかった、行ってみるよ。私は必要としている"}, {"type": "subtitle", "time": 8725.75, "timestamp": "02:25:25", "text": "戦利品。よし。戦術的、戦術的、"}, {"type": "subtitle", "time": 8726.67, "timestamp": "02:25:26", "text": "えーと"}, {"type": "subtitle", "time": 8728.99, "timestamp": "02:25:28", "text": "位置変更。それをやってください"}, {"type": "subtitle", "time": 8754.349, "timestamp": "02:25:54", "text": "行く。あれ、あの男はどこにいたっけ？以上"}, {"type": "subtitle", "time": 8758.07, "timestamp": "02:25:58", "text": "ここ。彼はここにいなかったか？待って、待って、私は"}, {"type": "subtitle", "time": 8759.99, "timestamp": "02:25:59", "text": "見失った。どこ？どこ？ああ、そうだった"}]
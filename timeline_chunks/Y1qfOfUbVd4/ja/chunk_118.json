[{"type": "subtitle", "time": 7082.39, "timestamp": "01:58:02", "text": "血のことですよね？私はそうでしょうか？はい、大丈夫です。"}, {"type": "subtitle", "time": 7084.79, "timestamp": "01:58:04", "text": "推測。次回は、"}, {"type": "subtitle", "time": 7088.47, "timestamp": "01:58:08", "text": "ビリーのためにバブシアンをストリーミングするカテゴリ"}, {"type": "subtitle", "time": 7091.189, "timestamp": "01:58:11", "text": "カテゴリー分けについてはよく分かりません。その"}, {"type": "subtitle", "time": 7093.91, "timestamp": "01:58:13", "text": "現在は中国語で提供されています。だから、とても難しい"}, {"type": "subtitle", "time": 7096.55, "timestamp": "01:58:16", "text": "ヴァレラントのために。彼らはそれを恐れ知らずと呼ぶ"}, {"type": "subtitle", "time": 7100.07, "timestamp": "01:58:20", "text": "恐れ知らずの勝利、とかそんな感じ。"}, {"type": "subtitle", "time": 7103.87, "timestamp": "01:58:23", "text": "うん。だから、それはある意味、ある意味、ある意味"}, {"type": "subtitle", "time": 7105.55, "timestamp": "01:58:25", "text": "奇妙な。"}, {"type": "subtitle", "time": 7108.39, "timestamp": "01:58:28", "text": "ええと、私もその試合に出場しています。あなた"}, {"type": "subtitle", "time": 7120.669, "timestamp": "01:58:40", "text": "何？人々はこれをプレイします"}, {"type": "subtitle", "time": 7125.229, "timestamp": "01:58:45", "text": "ゲーム。えーと、救急箱は8"}]
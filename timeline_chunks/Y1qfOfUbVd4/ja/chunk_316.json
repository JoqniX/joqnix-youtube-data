[{"type": "subtitle", "time": 18962.788, "timestamp": "05:16:02", "text": "欺瞞？確認してみます。ええと、"}, {"type": "subtitle", "time": 18966.07, "timestamp": "05:16:06", "text": "全く更新情報なし。ニース。だから、私たちは"}, {"type": "subtitle", "time": 18969.35, "timestamp": "05:16:09", "text": "えっと、あなたは"}, {"type": "subtitle", "time": 18971.19, "timestamp": "05:16:11", "text": "グラフィックカードのドライバーを再度更新しますか？"}, {"type": "subtitle", "time": 18973.39, "timestamp": "05:16:13", "text": "はい、そうしました。はい、そうしました。私"}, {"type": "subtitle", "time": 18975.67, "timestamp": "05:16:15", "text": "した。さて、これで友達は"}, {"type": "subtitle", "time": 18976.948, "timestamp": "05:16:16", "text": "消える。それは"}, {"type": "subtitle", "time": 18979.27, "timestamp": "05:16:19", "text": "新しいアップデートか何か。わからない。"}, {"type": "subtitle", "time": 18994.15, "timestamp": "05:16:34", "text": "えっと、悪魔は元気ですか？調子はどうですか"}, {"type": "subtitle", "time": 18997.868, "timestamp": "05:16:37", "text": "ジャマは何をしているの？調子はどうですか"}, {"type": "subtitle", "time": 19001.03, "timestamp": "05:16:41", "text": "何をしているの？皆さんお元気ですか？"}, {"type": "subtitle", "time": 19002.91, "timestamp": "05:16:42", "text": "11月はどうですか？"}, {"type": "subtitle", "time": 19006.55, "timestamp": "05:16:46", "text": "1位？もうない もうない"}, {"type": "subtitle", "time": 19008.51, "timestamp": "05:16:48", "text": "恐ろしい話だ。その"}, {"type": "subtitle", "time": 19011.99, "timestamp": "05:16:51", "text": "11月は誰もが"}, {"type": "subtitle", "time": 19014.55, "timestamp": "05:16:54", "text": "ホラー系のものとか、そういうの全部。ついに"}, {"type": "subtitle", "time": 19017.15, "timestamp": "05:16:57", "text": "あなたは自由だ。その"}, {"type": "subtitle", "time": 19019.31, "timestamp": "05:16:59", "text": "自由。その"}]
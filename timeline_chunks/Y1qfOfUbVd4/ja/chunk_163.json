[{"type": "subtitle", "time": 9783.75, "timestamp": "02:43:03", "text": "何？うん。あなたは"}, {"type": "subtitle", "time": 9787.429, "timestamp": "02:43:07", "text": "新しい妻？私は1つ持っています、それともえ？私はしません"}, {"type": "subtitle", "time": 9790.19, "timestamp": "02:43:10", "text": "知っていること"}, {"type": "subtitle", "time": 9793.15, "timestamp": "02:43:13", "text": "自分自身。私は持っていた"}, {"type": "subtitle", "time": 9795.87, "timestamp": "02:43:15", "text": "1つ。"}, {"type": "subtitle", "time": 9797.469, "timestamp": "02:43:17", "text": "わたし"}, {"type": "subtitle", "time": 9801.67, "timestamp": "02:43:21", "text": "ボクア。私たちは私、私。あなたは話している"}, {"type": "subtitle", "time": 9803.55, "timestamp": "02:43:23", "text": "私のことですよね？"}, {"type": "subtitle", "time": 9821.07, "timestamp": "02:43:41", "text": "はぁ？私には時間があると思いますか？"}, {"type": "subtitle", "time": 9823.67, "timestamp": "02:43:43", "text": "それ？私にそんな時間があると思いますか？"}, {"type": "subtitle", "time": 9830.75, "timestamp": "02:43:50", "text": "あなた。私は"}]
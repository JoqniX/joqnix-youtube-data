[{"type": "subtitle", "time": 4454.03, "timestamp": "01:14:14", "text": "男。負けだと思う"}, {"type": "subtitle", "time": 4464.39, "timestamp": "01:14:24", "text": "とにかく、ガンダムエボリューション。それは"}, {"type": "subtitle", "time": 4467.149, "timestamp": "01:14:27", "text": "これらの"}, {"type": "subtitle", "time": 4473.79, "timestamp": "01:14:33", "text": "[音楽]"}, {"type": "subtitle", "time": 4483.59, "timestamp": "01:14:43", "text": "1つ。ああ、これが正しい順番だ。私"}, {"type": "subtitle", "time": 4485.669, "timestamp": "01:14:45", "text": "私がこれを始めたのはいつだと思いますか？"}, {"type": "subtitle", "time": 4487.95, "timestamp": "01:14:47", "text": "プレイリスト"}, {"type": "subtitle", "time": 4495.27, "timestamp": "01:14:55", "text": "えっと、これは非公開のプレイリストなんですね。"}]
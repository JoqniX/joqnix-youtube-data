[{"type": "subtitle", "time": 12780.63, "timestamp": "03:33:00", "text": "誰か。はい。"}, {"type": "subtitle", "time": 12802.229, "timestamp": "03:33:22", "text": "その男は雪のシロクマの着ぐるみを着ていた"}, {"type": "subtitle", "time": 12820.51, "timestamp": "03:33:40", "text": "の上。えっと、"}, {"type": "subtitle", "time": 12822.95, "timestamp": "03:33:42", "text": "わかった。私は車の中にいたい。それはとても"}, {"type": "subtitle", "time": 12825.06, "timestamp": "03:33:45", "text": "車で遊ぶのは楽しい。"}, {"type": "subtitle", "time": 12836.03, "timestamp": "03:33:56", "text": "つまり、高地ということだ。"}, {"type": "subtitle", "time": 12839.67, "timestamp": "03:33:59", "text": "今、私はおそらく、もう少しで"}]
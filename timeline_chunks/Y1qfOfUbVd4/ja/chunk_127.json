[{"type": "subtitle", "time": 7620.149, "timestamp": "02:07:00", "text": "初勝利を味わうのを楽しみたい。"}, {"type": "subtitle", "time": 7622.189, "timestamp": "02:07:02", "text": "私は"}, {"type": "subtitle", "time": 7625.709, "timestamp": "02:07:05", "text": "このように狙うと、現実的になります。"}, {"type": "subtitle", "time": 7628.99, "timestamp": "02:07:08", "text": "こんにちは。しかし、どの銃を選ぶべきか"}, {"type": "subtitle", "time": 7631.43, "timestamp": "02:07:11", "text": "けれど？では、どの銃を選べばいいのだろうか？"}, {"type": "subtitle", "time": 7633.95, "timestamp": "02:07:13", "text": "あと、こんにちは。"}, {"type": "subtitle", "time": 7636.51, "timestamp": "02:07:16", "text": "いらっしゃいませ。どんな銃を"}, {"type": "subtitle", "time": 7638.589, "timestamp": "02:07:18", "text": "選ぶ？"}, {"type": "subtitle", "time": 7642.629, "timestamp": "02:07:22", "text": "注目のアイテム。あ、待って。これは違う"}, {"type": "subtitle", "time": 7649.189, "timestamp": "02:07:29", "text": "ああ、翻訳のことか。そうそう。ええ、わかっています。"}, {"type": "subtitle", "time": 7653.149, "timestamp": "02:07:33", "text": "残念ながら私にはどうすることもできません"}, {"type": "subtitle", "time": 7656.109, "timestamp": "02:07:36", "text": "それ。"}, {"type": "subtitle", "time": 7658.99, "timestamp": "02:07:38", "text": "一体何て言うんだ、"}, {"type": "subtitle", "time": 7661.31, "timestamp": "02:07:41", "text": "男？悲しい。ただ"}, {"type": "subtitle", "time": 7673.109, "timestamp": "02:07:53", "text": "Sh。ああ、PUBG Mobileではこの道を知ってるよ"}, {"type": "subtitle", "time": 7676.79, "timestamp": "02:07:56", "text": "あるいは、そんな感じ。いいえ。ええと、もしあなたが"}]
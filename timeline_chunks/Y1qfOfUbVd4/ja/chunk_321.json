[{"type": "subtitle", "time": 19260.35, "timestamp": "05:21:00", "text": "笑 新しい"}, {"type": "subtitle", "time": 19263.67, "timestamp": "05:21:03", "text": "このエピソードはすごくかわいい。彼女は"}, {"type": "subtitle", "time": 19266.31, "timestamp": "05:21:06", "text": "髪がある。ダイアナ妃はあの髪をしている。ああ、"}, {"type": "subtitle", "time": 19268.91, "timestamp": "05:21:08", "text": "ああ、彼女は素晴らしい髪をしている。彼女はとても"}, {"type": "subtitle", "time": 19282.67, "timestamp": "05:21:22", "text": "かわいい。それで"}, {"type": "subtitle", "time": 19287.19, "timestamp": "05:21:27", "text": "かわいい。私は彼女を手に入れるためにお金を使いたい"}, {"type": "subtitle", "time": 19291.43, "timestamp": "05:21:31", "text": "初日までに最初に出るか、私は"}, {"type": "subtitle", "time": 19294.83, "timestamp": "05:21:34", "text": "ゲームをやり込んで手に入れる"}, {"type": "subtitle", "time": 19297.91, "timestamp": "05:21:37", "text": "彼女。それが私の唯一の選択肢です。私は"}, {"type": "subtitle", "time": 19312.19, "timestamp": "05:21:52", "text": "[音楽]"}, {"type": "subtitle", "time": 19315.35, "timestamp": "05:21:55", "text": "お金。ああ、お姫様は壊れてしまった。ああ、わかった。"}, {"type": "subtitle", "time": 19317.11, "timestamp": "05:21:57", "text": "大丈夫。普通にやります。"}]
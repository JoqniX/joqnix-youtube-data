[{"type": "subtitle", "time": 22981.47, "timestamp": "06:23:01", "text": "おお、"}, {"type": "subtitle", "time": 22983.75, "timestamp": "06:23:03", "text": "ニース。他の分野でもプレーしていますか？"}, {"type": "subtitle", "time": 22986.948, "timestamp": "06:23:06", "text": "ゲーム？ええ、あらゆる種類のゲームをプレイします。"}, {"type": "subtitle", "time": 22989.03, "timestamp": "06:23:09", "text": "私の側には何の制約もない"}, {"type": "subtitle", "time": 22993.67, "timestamp": "06:23:13", "text": "だって、私は色々なゲームをプレイするゲーマーだからね。それで"}, {"type": "subtitle", "time": 22995.67, "timestamp": "06:23:15", "text": "どちらかというと、バラエティストリーマーといった感じ。ただ"}, {"type": "subtitle", "time": 22997.83, "timestamp": "06:23:17", "text": "ジャンルを飛び越える。 FPSをプレイしているとき"}, {"type": "subtitle", "time": 23000.15, "timestamp": "06:23:20", "text": "今日、次回モバイルまたは"}, {"type": "subtitle", "time": 23004.07, "timestamp": "06:23:24", "text": "RPGのようなゲーム、あるいは戦略ゲームのようなものかもしれません。"}]
[{"type": "subtitle", "time": 9661.59, "timestamp": "02:41:01", "text": "これ？何か無料でもらったものはありますか？いいえ、"}, {"type": "subtitle", "time": 9664.91, "timestamp": "02:41:04", "text": "私はまだレベル1です。はい、パス"}, {"type": "subtitle", "time": 9669.27, "timestamp": "02:41:09", "text": "1つ。そのバッグ。あ、待って。偽りだ。待って、"}, {"type": "subtitle", "time": 9670.83, "timestamp": "02:41:10", "text": "待って、待って、"}, {"type": "subtitle", "time": 9679.08, "timestamp": "02:41:19", "text": "レベル1の前に"}, {"type": "subtitle", "time": 9691.95, "timestamp": "02:41:31", "text": "バッグ。あの緑の地図だったらよかったのに"}, {"type": "subtitle", "time": 9695.55, "timestamp": "02:41:35", "text": "さて、あの緑色の地図はサンゴクか"}, {"type": "subtitle", "time": 9698.27, "timestamp": "02:41:38", "text": "何か。"}, {"type": "subtitle", "time": 9701.95, "timestamp": "02:41:41", "text": "えっと、リンゴを投げつけることもできるし"}]
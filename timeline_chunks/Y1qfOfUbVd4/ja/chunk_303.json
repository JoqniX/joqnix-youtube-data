[{"type": "subtitle", "time": 18185.868, "timestamp": "05:03:05", "text": "泣く。"}, {"type": "subtitle", "time": 18187.708, "timestamp": "05:03:07", "text": "えっと"}, {"type": "subtitle", "time": 18190.55, "timestamp": "05:03:10", "text": "ニューカッスル。それは文字通りニューカッスルの"}, {"type": "subtitle", "time": 18194.23, "timestamp": "05:03:14", "text": "シールドはありますが、うまく制御できません。"}, {"type": "subtitle", "time": 18197.19, "timestamp": "05:03:17", "text": "それはただ前に来るだけです。それは良い"}, {"type": "subtitle", "time": 18200.39, "timestamp": "05:03:20", "text": "私のように押しのけたい人"}, {"type": "subtitle", "time": 18203.75, "timestamp": "05:03:23", "text": "これとピューピューで彼を捕まえろ。それは"}, {"type": "subtitle", "time": 18204.83, "timestamp": "05:03:24", "text": "良い"}, {"type": "subtitle", "time": 18209.948, "timestamp": "05:03:29", "text": "アイデア。次は？うん。こんにちは、"}, {"type": "subtitle", "time": 18212.51, "timestamp": "05:03:32", "text": "カビ。お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 18215.19, "timestamp": "05:03:35", "text": "良い。また、編集も改善しています"}, {"type": "subtitle", "time": 18217.35, "timestamp": "05:03:37", "text": "プレミアプロ。はい、あなたは上達しています"}, {"type": "subtitle", "time": 18220.23, "timestamp": "05:03:40", "text": "たくさん。君もヌーヌー戦術を学んだんだね。"}, {"type": "subtitle", "time": 18222.47, "timestamp": "05:03:42", "text": "うん。うん。うん。それは良いです。私は誇りに思います"}, {"type": "subtitle", "time": 18223.788, "timestamp": "05:03:43", "text": "の"}, {"type": "subtitle", "time": 18233.07, "timestamp": "05:03:53", "text": "最高。たくさんのことができます"}, {"type": "subtitle", "time": 18238.43, "timestamp": "05:03:58", "text": "多くの人が新しいことを学び続ける"}]
[{"type": "subtitle", "time": 17100.788, "timestamp": "04:45:00", "text": "そこにはユーチューバーのような人たちがいて、"}, {"type": "subtitle", "time": 17102.708, "timestamp": "04:45:02", "text": "配信者たちがプレイしている。だから私はこう思った、"}, {"type": "subtitle", "time": 17105.75, "timestamp": "04:45:05", "text": "「ああ、わかった。」しかし、私はあることに気付きました"}, {"type": "subtitle", "time": 17107.31, "timestamp": "04:45:07", "text": "全員"}, {"type": "subtitle", "time": 17111.59, "timestamp": "04:45:11", "text": "プレイヤーのキルフィードをぼかすか、"}, {"type": "subtitle", "time": 17114.11, "timestamp": "04:45:14", "text": "何か。なぜそれが"}, {"type": "subtitle", "time": 17118.07, "timestamp": "04:45:18", "text": "確かに、そういうこともある。頂点、"}, {"type": "subtitle", "time": 17120.15, "timestamp": "04:45:20", "text": "ヴァレラント、私がやらなきゃいけないゲーム全部"}, {"type": "subtitle", "time": 17122.19, "timestamp": "04:45:22", "text": "と同じ"}, {"type": "subtitle", "time": 17126.55, "timestamp": "04:45:26", "text": "良い。でも、どれがいいかな？そして"}, {"type": "subtitle", "time": 17129.59, "timestamp": "04:45:29", "text": "垂直の流れ、だからこの流れは"}, {"type": "subtitle", "time": 17131.91, "timestamp": "04:45:31", "text": "前日にやる予定だった"}, {"type": "subtitle", "time": 17135.19, "timestamp": "04:45:35", "text": "昨日だったと思う。ああ、その前日"}, {"type": "subtitle", "time": 17137.03, "timestamp": "04:45:37", "text": "昨日、私はそれをやるはずだった。私"}, {"type": "subtitle", "time": 17138.43, "timestamp": "04:45:38", "text": "準備した"}, {"type": "subtitle", "time": 17141.35, "timestamp": "04:45:41", "text": "すべては2日前だった。私は"}, {"type": "subtitle", "time": 17143.99, "timestamp": "04:45:43", "text": "これをストリーミングするために、私たちは"}, {"type": "subtitle", "time": 17146.708, "timestamp": "04:45:46", "text": "映画を一緒に観る、"}, {"type": "subtitle", "time": 17150.31, "timestamp": "04:45:50", "text": "今日までに何かあったが、"}, {"type": "subtitle", "time": 17152.11, "timestamp": "04:45:52", "text": "スケジュールが狂ってしまった"}, {"type": "subtitle", "time": 17155.75, "timestamp": "04:45:55", "text": "上。固定の"}]
[{"type": "subtitle", "time": 17845.47, "timestamp": "04:57:25", "text": "ああ、"}, {"type": "subtitle", "time": 17848.47, "timestamp": "04:57:28", "text": "お母さん。皆さん、お元気ですか？うん。こんにちは。"}, {"type": "subtitle", "time": 17854.788, "timestamp": "04:57:34", "text": "[音楽]"}, {"type": "subtitle", "time": 17857.27, "timestamp": "04:57:37", "text": "皆さんが元気で、お元気でいらっしゃることを願っています。"}, {"type": "subtitle", "time": 17859.628, "timestamp": "04:57:39", "text": "そして健康で"}, {"type": "subtitle", "time": 17862.67, "timestamp": "04:57:42", "text": "もの。今日は"}, {"type": "subtitle", "time": 17866.868, "timestamp": "04:57:46", "text": "今月最初の配信です。ああ、"}, {"type": "subtitle", "time": 17869.15, "timestamp": "04:57:49", "text": "神。これは最初のストリームです"}, {"type": "subtitle", "time": 17870.99, "timestamp": "04:57:50", "text": "月。"}, {"type": "subtitle", "time": 17875.19, "timestamp": "04:57:55", "text": "では、今日は、"}, {"type": "subtitle", "time": 17877.67, "timestamp": "04:57:57", "text": "私たちは、アッシュさん、ありがとう"}]
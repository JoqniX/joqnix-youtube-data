[{"type": "subtitle", "time": 20487.03, "timestamp": "05:41:27", "text": "いいえ、私は、私は、ひるみました。私は思わず身をすくめた。おお、"}, {"type": "subtitle", "time": 20499.03, "timestamp": "05:41:39", "text": "[音楽]"}, {"type": "subtitle", "time": 20501.35, "timestamp": "05:41:41", "text": "待って、私は日本語モードですか、それとも"}, {"type": "subtitle", "time": 20503.27, "timestamp": "05:41:43", "text": "何か？"}, {"type": "subtitle", "time": 20504.67, "timestamp": "05:41:44", "text": "いいえ。"}, {"type": "subtitle", "time": 20507.948, "timestamp": "05:41:47", "text": "右。その"}, {"type": "subtitle", "time": 20510.11, "timestamp": "05:41:50", "text": "わかった。ニース"}]
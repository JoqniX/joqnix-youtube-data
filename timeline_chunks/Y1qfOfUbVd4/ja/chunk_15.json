[{"type": "subtitle", "time": 910.03, "timestamp": "00:15:10", "text": "[音楽]"}, {"type": "subtitle", "time": 912.189, "timestamp": "00:15:12", "text": "おい、"}, {"type": "subtitle", "time": 931.03, "timestamp": "00:15:31", "text": "誰かが着陸するのを見た。ああ、ダメージを受けた"}, {"type": "subtitle", "time": 941.75, "timestamp": "00:15:41", "text": "少し。おお、いいね。ヘリコプターがある。"}, {"type": "subtitle", "time": 944.71, "timestamp": "00:15:44", "text": "右のヘリコプターに乗るべきでしょうか？待って、"}, {"type": "subtitle", "time": 946.949, "timestamp": "00:15:46", "text": "なぜこの場所はこんなに"}, {"type": "subtitle", "time": 948.79, "timestamp": "00:15:48", "text": "おなじみ？"}, {"type": "subtitle", "time": 951.11, "timestamp": "00:15:51", "text": "こんな場所を覚えている"}]
[{"type": "subtitle", "time": 3301.309, "timestamp": "00:55:01", "text": "の上。おお、"}, {"type": "subtitle", "time": 3314.75, "timestamp": "00:55:14", "text": "近い。ああ、"}, {"type": "subtitle", "time": 3317.589, "timestamp": "00:55:17", "text": "神。どんな劇でも演じてみませんか？もちろん"}, {"type": "subtitle", "time": 3331.069, "timestamp": "00:55:31", "text": "彼らはどこから来たのか？"}, {"type": "subtitle", "time": 3333.67, "timestamp": "00:55:33", "text": "こんにちは。ハエから産み落とされるように増えていく"}]
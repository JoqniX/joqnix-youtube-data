[{"type": "subtitle", "time": 11955.71, "timestamp": "03:19:15", "text": "[音楽]"}, {"type": "subtitle", "time": 11974.469, "timestamp": "03:19:34", "text": "ラウンド。えーと、あなたの敵は、えーと、最後に"}, {"type": "subtitle", "time": 11977.269, "timestamp": "03:19:37", "text": "えっと、彼は君より多く勝つから、"}, {"type": "subtitle", "time": 11978.59, "timestamp": "03:19:38", "text": "勝利した。"}, {"type": "subtitle", "time": 11981.309, "timestamp": "03:19:41", "text": "おお。そうそう。スウェット"}, {"type": "subtitle", "time": 11984.71, "timestamp": "03:19:44", "text": "今。登れることを忘れてた"}]
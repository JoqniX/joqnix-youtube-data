[{"type": "subtitle", "time": 16266.429, "timestamp": "04:31:06", "text": "友達。"}, {"type": "subtitle", "time": 16275.07, "timestamp": "04:31:15", "text": "何？初期段階で"}, {"type": "subtitle", "time": 16278.389, "timestamp": "04:31:18", "text": "ゲーム。課題リスト。レベル2の戦利品"}, {"type": "subtitle", "time": 16284.11, "timestamp": "04:31:24", "text": "最高の小型手榴弾駆動装置。よし、破壊しろ。"}, {"type": "subtitle", "time": 16286.79, "timestamp": "04:31:26", "text": "わかった。おお。私はこのマップでプレイしたことがありません。"}, {"type": "subtitle", "time": 16301.189, "timestamp": "04:31:41", "text": "山。そこに何かあるかどうかは疑わしい"}, {"type": "subtitle", "time": 16302.83, "timestamp": "04:31:42", "text": "の"}, {"type": "subtitle", "time": 16307.07, "timestamp": "04:31:47", "text": "トップ。なぜ彼らは"}, {"type": "subtitle", "time": 16309.59, "timestamp": "04:31:49", "text": "山？それは戦利品に違いない"}, {"type": "subtitle", "time": 16319.99, "timestamp": "04:31:59", "text": "残念ながら。そこには戦利品があるはずだ"}]
[{"type": "subtitle", "time": 13262.51, "timestamp": "03:41:02", "text": "死ぬのか？ヴァレラントみたいだ。待って、それはまるで"}, {"type": "subtitle", "time": 13272.99, "timestamp": "03:41:12", "text": "行く。それは何ですか？これはできません"}, {"type": "subtitle", "time": 13277.19, "timestamp": "03:41:17", "text": "PUBG。 PBGでは、次のようにプレイできます。"}, {"type": "subtitle", "time": 13288.99, "timestamp": "03:41:28", "text": "ああ、彼らはそれをブルーゾーンジェネレーターと呼んでいる。"}, {"type": "subtitle", "time": 13291.309, "timestamp": "03:41:31", "text": "おお、"}, {"type": "subtitle", "time": 13294.96, "timestamp": "03:41:34", "text": "ニース。かっこいい。"}, {"type": "subtitle", "time": 13313.95, "timestamp": "03:41:53", "text": "それは"}]
[{"type": "subtitle", "time": 11170.349, "timestamp": "03:06:10", "text": "ほら、私は歩いている"}, {"type": "subtitle", "time": 11173.67, "timestamp": "03:06:13", "text": "また。そういう時が嫌だ"}, {"type": "subtitle", "time": 11180.23, "timestamp": "03:06:20", "text": "デフォルトがないのはなぜですか？"}, {"type": "subtitle", "time": 11184.389, "timestamp": "03:06:24", "text": "走るというデフォルトの動作"}, {"type": "subtitle", "time": 11186.67, "timestamp": "03:06:26", "text": "ビデオゲームで"}, {"type": "subtitle", "time": 11189.23, "timestamp": "03:06:29", "text": "もう？なぜそうなるのか"}, {"type": "subtitle", "time": 11193.83, "timestamp": "03:06:33", "text": "それ？あの頃はどこへ行ってしまったのだろう？"}, {"type": "subtitle", "time": 11196.23, "timestamp": "03:06:36", "text": "つまり、このゲームは、私はそうは思わないかもしれない"}, {"type": "subtitle", "time": 11198.67, "timestamp": "03:06:38", "text": "と思う"}, {"type": "subtitle", "time": 11206.99, "timestamp": "03:06:46", "text": "ああ、次はゾーンに入るよ"}, {"type": "subtitle", "time": 11211.15, "timestamp": "03:06:51", "text": "ゾーン 今まではただ"}, {"type": "subtitle", "time": 11213.389, "timestamp": "03:06:53", "text": "チア"}, {"type": "subtitle", "time": 11216.83, "timestamp": "03:06:56", "text": "おそらく注意して"}]
[{"type": "subtitle", "time": 14100.309, "timestamp": "03:55:00", "text": "私がWを書いたので、それを見ることができます。それで、"}, {"type": "subtitle", "time": 14102.71, "timestamp": "03:55:02", "text": "少ししたら戻ってきます。よし、見てて"}, {"type": "subtitle", "time": 14110.79, "timestamp": "03:55:10", "text": "[音楽]"}, {"type": "subtitle", "time": 14113.349, "timestamp": "03:55:13", "text": "ああ、いついらっしゃったのですか？ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 14115.83, "timestamp": "03:55:15", "text": "苦手です。"}, {"type": "subtitle", "time": 14132.03, "timestamp": "03:55:32", "text": "私はここから出て行く。しかし"}, {"type": "subtitle", "time": 14138.99, "timestamp": "03:55:38", "text": "嘘だ、それは"}, {"type": "subtitle", "time": 14142.349, "timestamp": "03:55:42", "text": "感じて、もう一つは"}, {"type": "subtitle", "time": 14145.349, "timestamp": "03:55:45", "text": "なぜなら、最近またストリーミング配信を始めたから。"}, {"type": "subtitle", "time": 14147.55, "timestamp": "03:55:47", "text": "右？だって私は2週間くらいかかったから"}, {"type": "subtitle", "time": 14150.67, "timestamp": "03:55:50", "text": "休憩した、なぜならそれは"}, {"type": "subtitle", "time": 14153.429, "timestamp": "03:55:53", "text": "厳しい。主に私の主な理由は"}, {"type": "subtitle", "time": 14156.07, "timestamp": "03:55:56", "text": "ほぼ毎日配信しています"}, {"type": "subtitle", "time": 14158.229, "timestamp": "03:55:58", "text": "今週の来週。いいえ、ええと、2つあります"}]
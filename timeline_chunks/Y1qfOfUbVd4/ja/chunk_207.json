[{"type": "subtitle", "time": 12424.63, "timestamp": "03:27:04", "text": "ここ？私たちは大丈夫だと思います。私はただ行くだけです"}, {"type": "subtitle", "time": 12437.15, "timestamp": "03:27:17", "text": "まあ、弾薬は十分だ。おお、"}, {"type": "subtitle", "time": 12448.349, "timestamp": "03:27:28", "text": "これら117。うん、そうあるべきだ"}, {"type": "subtitle", "time": 12452.07, "timestamp": "03:27:32", "text": "良い。ええと、包帯で最大60％の治癒が可能です。"}, {"type": "subtitle", "time": 12454.15, "timestamp": "03:27:34", "text": "薬を飲んだ。ええと、あなたも同じようにしてください。ペイント"}, {"type": "subtitle", "time": 12455.83, "timestamp": "03:27:35", "text": "殺虫剤とエナジードリンク。単に"}, {"type": "subtitle", "time": 12457.99, "timestamp": "03:27:37", "text": "体力を完全に回復させ、スタミナを向上させましょう。"}, {"type": "subtitle", "time": 12459.87, "timestamp": "03:27:39", "text": "ああ、ありがとうございます。本当にありがとうございます"}, {"type": "subtitle", "time": 12463.349, "timestamp": "03:27:43", "text": "多くの。わかった。ありがとう。"}, {"type": "subtitle", "time": 12467.03, "timestamp": "03:27:47", "text": "私はこのゲームをほとんどプレイしません。私はちょうどプレイしました"}, {"type": "subtitle", "time": 12469.59, "timestamp": "03:27:49", "text": "Discordクエストのため、または"}, {"type": "subtitle", "time": 12471.51, "timestamp": "03:27:51", "text": "何か。だから私は「うん、そうだね」って言ったんだ"}, {"type": "subtitle", "time": 12474.67, "timestamp": "03:27:54", "text": "久しぶりですね。 PUBGを配信したので、なぜ"}]
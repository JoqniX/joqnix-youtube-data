[{"type": "subtitle", "time": 22022.47, "timestamp": "06:07:02", "text": "Discord 用で、予備として 2 つなど"}, {"type": "subtitle", "time": 22025.868, "timestamp": "06:07:05", "text": "万が一誰か"}, {"type": "subtitle", "time": 22028.15, "timestamp": "06:07:08", "text": "万が一に備えて交換するものです。そこには"}, {"type": "subtitle", "time": 22030.47, "timestamp": "06:07:10", "text": "Discord に対して何もすることはないが、"}, {"type": "subtitle", "time": 22032.31, "timestamp": "06:07:12", "text": "それでも、ピューって感じで言いたかっただけなんです"}, {"type": "subtitle", "time": 22039.31, "timestamp": "06:07:19", "text": "うん。"}, {"type": "subtitle", "time": 22041.67, "timestamp": "06:07:21", "text": "えっと、それはどの試合ですか？これは"}, {"type": "subtitle", "time": 22044.708, "timestamp": "06:07:24", "text": "エスカレーション。これは何か何かだ。"}, {"type": "subtitle", "time": 22047.548, "timestamp": "06:07:27", "text": "その試合はこれです。"}, {"type": "subtitle", "time": 22050.548, "timestamp": "06:07:30", "text": "右？いいえ、私はZuki modを作成したわけではありません。彼女"}, {"type": "subtitle", "time": 22052.35, "timestamp": "06:07:32", "text": "該当しませんでした。彼女"}, {"type": "subtitle", "time": 22057.67, "timestamp": "06:07:37", "text": "えっと、ズキはもっと昔だったけど、"}, {"type": "subtitle", "time": 22060.07, "timestamp": "06:07:40", "text": "もうモデレーターになりたくなかったので、"}, {"type": "subtitle", "time": 22062.788, "timestamp": "06:07:42", "text": "モデレーターは自分のことで忙しくなったので"}, {"type": "subtitle", "time": 22065.31, "timestamp": "06:07:45", "text": "すべて。"}]
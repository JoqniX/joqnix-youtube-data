[{"type": "subtitle", "time": 4860.55, "timestamp": "01:21:00", "text": "オータン。デートの機会がたくさんあるはずだ"}, {"type": "subtitle", "time": 4865.51, "timestamp": "01:21:05", "text": "シムズか。私はどうなるのだろうか。おお、"}, {"type": "subtitle", "time": 4867.91, "timestamp": "01:21:07", "text": "うん。私たちはドヨキ・トレジャークラブで遊びました。私"}, {"type": "subtitle", "time": 4870.39, "timestamp": "01:21:10", "text": "忘れた。それはまた、"}, {"type": "subtitle", "time": 4881.51, "timestamp": "01:21:21", "text": "そう、シムズは永遠に。シムズじゃなかったの？"}, {"type": "subtitle", "time": 4883.39, "timestamp": "01:21:23", "text": "Epicで無料のように"}, {"type": "subtitle", "time": 4885.669, "timestamp": "01:21:25", "text": "ゲーム？よくやったね。そうそう。それは"}, {"type": "subtitle", "time": 4892.189, "timestamp": "01:21:32", "text": "[音楽]"}, {"type": "subtitle", "time": 4900.189, "timestamp": "01:21:40", "text": "上。"}, {"type": "subtitle", "time": 4904.229, "timestamp": "01:21:44", "text": "おっと、ペルソナが来た。ペルソナ5。絶対にない"}, {"type": "subtitle", "time": 4910.31, "timestamp": "01:21:50", "text": "けれど。紙人形。心理学的"}, {"type": "subtitle", "time": 4912.99, "timestamp": "01:21:52", "text": "ホラー。それは絶対に飛ばさない。いいえ、いいえ"}, {"type": "subtitle", "time": 4917.79, "timestamp": "01:21:57", "text": "ホラー。サンドロックでの私の時間。"}]
[{"type": "subtitle", "time": 2358.55, "timestamp": "00:39:18", "text": "はい、戻ってきました。私は賭け金を受け取った。"}, {"type": "subtitle", "time": 2360.19, "timestamp": "00:39:20", "text": "それは"}, {"type": "subtitle", "time": 2363.829, "timestamp": "00:39:23", "text": "なぜ。それらすべての隣に。はい。次"}, {"type": "subtitle", "time": 2375.67, "timestamp": "00:39:35", "text": "何か知っていますか？彼の名前は"}, {"type": "subtitle", "time": 2378.31, "timestamp": "00:39:38", "text": "ストリームスナイプ。あれは誰？また、ようこそ"}, {"type": "subtitle", "time": 2384.39, "timestamp": "00:39:44", "text": "ストリーム。あなたの"}, {"type": "subtitle", "time": 2387.19, "timestamp": "00:39:47", "text": "名前。配信へようこ​​そ。調子はどうですか？"}, {"type": "subtitle", "time": 2388.829, "timestamp": "00:39:48", "text": "調子はどうですか"}]
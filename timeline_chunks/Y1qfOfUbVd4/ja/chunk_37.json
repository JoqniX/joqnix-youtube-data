[{"type": "subtitle", "time": 2224.15, "timestamp": "00:37:04", "text": "みんな。こんにちは。こんにちは。レイダーズの皆さん、ようこそ。"}, {"type": "subtitle", "time": 2226.99, "timestamp": "00:37:06", "text": "お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 2229.15, "timestamp": "00:37:09", "text": "良い。"}, {"type": "subtitle", "time": 2232.31, "timestamp": "00:37:12", "text": "こんにちは。どうだった？ あ、待って。どんなゲームだったか"}, {"type": "subtitle", "time": 2233.39, "timestamp": "00:37:13", "text": "あなた"}, {"type": "subtitle", "time": 2236.15, "timestamp": "00:37:16", "text": "ストリーミング配信？待って、君はどんなゲームをしていたの？"}, {"type": "subtitle", "time": 2239.27, "timestamp": "00:37:19", "text": "ストリーミング配信？ああ、マロのビンタ。わかった。わかった。"}, {"type": "subtitle", "time": 2240.349, "timestamp": "00:37:20", "text": "どうでしたか？"}, {"type": "subtitle", "time": 2250.27, "timestamp": "00:37:30", "text": "ビット。レイ・ダッシュさん、ようこそ。私の名前は"}, {"type": "subtitle", "time": 2254.109, "timestamp": "00:37:34", "text": "チュウ。はじめまして"}]
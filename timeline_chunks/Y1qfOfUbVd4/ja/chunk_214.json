[{"type": "subtitle", "time": 12874.71, "timestamp": "03:34:34", "text": "[拍手]"}, {"type": "subtitle", "time": 12877.51, "timestamp": "03:34:37", "text": "そして、ピューピューと撃つこの男を走らせるつもりだ"}, {"type": "subtitle", "time": 12879.309, "timestamp": "03:34:39", "text": "ピューピュー"}, {"type": "subtitle", "time": 12889.59, "timestamp": "03:34:49", "text": "そこには。おっしゃることは分かります。私がそちらへ伺います。"}, {"type": "subtitle", "time": 12891.59, "timestamp": "03:34:51", "text": "私はあなたのところへ行くわ、そしてあなたは"}, {"type": "subtitle", "time": 12895.71, "timestamp": "03:34:55", "text": "「この車はどこから来たの？」"}, {"type": "subtitle", "time": 12898.59, "timestamp": "03:34:58", "text": "から？私は作るつもりです"}]
[{"type": "subtitle", "time": 1080.549, "timestamp": "00:18:00", "text": "右？"}, {"type": "subtitle", "time": 1081.87, "timestamp": "00:18:01", "text": "のように"}, {"type": "subtitle", "time": 1083.87, "timestamp": "00:18:03", "text": "何"}, {"type": "subtitle", "time": 1101.029, "timestamp": "00:18:21", "text": "おお。すごく変だ。正直に言うと。"}, {"type": "subtitle", "time": 1106.23, "timestamp": "00:18:26", "text": "奇妙な。今は実際には"}, {"type": "subtitle", "time": 1109.59, "timestamp": "00:18:29", "text": "私にぴったりの相手を見つけること。"}, {"type": "subtitle", "time": 1112.19, "timestamp": "00:18:32", "text": "つまり、私はグールラグを逃したということであり、"}, {"type": "subtitle", "time": 1115.789, "timestamp": "00:18:35", "text": "すべて。いやいや、もう"}, {"type": "subtitle", "time": 1120.31, "timestamp": "00:18:40", "text": "先に亡くなったんですよね？私は"}, {"type": "subtitle", "time": 1128.27, "timestamp": "00:18:48", "text": "うん。ああ、大変だ。それはそれが"}, {"type": "subtitle", "time": 1131.83, "timestamp": "00:18:51", "text": "は。それで、私を見ているところから、"}, {"type": "subtitle", "time": 1133.83, "timestamp": "00:18:53", "text": "皆さんはこの試合についてどう思いますか？何が"}, {"type": "subtitle", "time": 1136.95, "timestamp": "00:18:56", "text": "あなたは思う？"}]
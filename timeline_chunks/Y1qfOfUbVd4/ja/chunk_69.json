[{"type": "subtitle", "time": 4142.269, "timestamp": "01:09:02", "text": "[音楽]"}, {"type": "subtitle", "time": 4144.03, "timestamp": "01:09:04", "text": "私たちの"}, {"type": "subtitle", "time": 4146.39, "timestamp": "01:09:06", "text": "周年。ああ、読書ね。私たちには必要だ"}, {"type": "subtitle", "time": 4147.63, "timestamp": "01:09:07", "text": "行うために"}, {"type": "subtitle", "time": 4150.63, "timestamp": "01:09:10", "text": "えっと、なんていう名前でしたっけ？教室"}, {"type": "subtitle", "time": 4152.51, "timestamp": "01:09:12", "text": "エリート中のエリート。"}, {"type": "subtitle", "time": 4157.03, "timestamp": "01:09:17", "text": "うん。連邦準備制度理事会（FRB）も、我々が停止させたもののひとつだ。"}, {"type": "subtitle", "time": 4158.87, "timestamp": "01:09:18", "text": "ええ、終わりました。しかし、それはまた"}, {"type": "subtitle", "time": 4162.39, "timestamp": "01:09:22", "text": "外れると思う。しかし、それは良いものだった。"}, {"type": "subtitle", "time": 4170.749, "timestamp": "01:09:30", "text": "うん。待って、warfって何の話だったっけ？私はしません"}, {"type": "subtitle", "time": 4176.91, "timestamp": "01:09:36", "text": "[音楽]"}, {"type": "subtitle", "time": 4178.76, "timestamp": "01:09:38", "text": "について？何が"}, {"type": "subtitle", "time": 4181.07, "timestamp": "01:09:41", "text": "[音楽]"}, {"type": "subtitle", "time": 4186.829, "timestamp": "01:09:46", "text": "ストリーム？ああ、覚えているよ、覚えているよ"}, {"type": "subtitle", "time": 4189.55, "timestamp": "01:09:49", "text": "これ。覚えているよ。"}, {"type": "subtitle", "time": 4197.669, "timestamp": "01:09:57", "text": "覚えているよ。私たちは見知らぬ男たちに出会った"}]
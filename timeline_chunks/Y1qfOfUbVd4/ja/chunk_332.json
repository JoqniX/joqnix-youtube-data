[{"type": "subtitle", "time": 19924.628, "timestamp": "05:32:04", "text": "卑劣さ。わからない。ええ、そうです"}, {"type": "subtitle", "time": 19926.91, "timestamp": "05:32:06", "text": "あるいは、そうではない。どちらが"}, {"type": "subtitle", "time": 19937.948, "timestamp": "05:32:17", "text": "でも、そう、でも、でも、私が知っているのは"}, {"type": "subtitle", "time": 19940.788, "timestamp": "05:32:20", "text": "この銃の中の星座は"}, {"type": "subtitle", "time": 19948.868, "timestamp": "05:32:28", "text": "いいえ。わかりました。だから、Eが何をしているのかは知っている。えええ"}, {"type": "subtitle", "time": 19952.91, "timestamp": "05:32:32", "text": "狙いを定めるためにボールを"}, {"type": "subtitle", "time": 19975.868, "timestamp": "05:32:55", "text": "自分。待って、無敵状態はどこにあるの？私"}, {"type": "subtitle", "time": 19978.708, "timestamp": "05:32:58", "text": "神様、もし私が自分の"}]
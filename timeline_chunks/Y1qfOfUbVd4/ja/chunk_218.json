[{"type": "subtitle", "time": 13081.229, "timestamp": "03:38:01", "text": "彼の"}, {"type": "subtitle", "time": 13085.19, "timestamp": "03:38:05", "text": "戦利品？略奪する。彼の遺体は見えるが、"}, {"type": "subtitle", "time": 13094.11, "timestamp": "03:38:14", "text": "ゲーム。あなた"}, {"type": "subtitle", "time": 13097.75, "timestamp": "03:38:17", "text": "君は戦利品が欲しかったんだが、ああ、なるほど"}, {"type": "subtitle", "time": 13099.429, "timestamp": "03:38:19", "text": "誰か。"}, {"type": "subtitle", "time": 13108.229, "timestamp": "03:38:28", "text": "次。ああ、あれは発煙弾だ。あなた"}, {"type": "subtitle", "time": 13110.389, "timestamp": "03:38:30", "text": "ダミー。バカめ。あれは発煙弾だ。"}, {"type": "subtitle", "time": 13112.95, "timestamp": "03:38:32", "text": "バカめ。ああ、体を動かして"}, {"type": "subtitle", "time": 13121.03, "timestamp": "03:38:41", "text": "見る。私は他の人を見ました。誰かを見かける"}, {"type": "subtitle", "time": 13127.59, "timestamp": "03:38:47", "text": "[拍手]"}]
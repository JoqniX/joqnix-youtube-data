[{"type": "subtitle", "time": 8040.669, "timestamp": "02:14:00", "text": "ショットガン"}, {"type": "subtitle", "time": 8049.669, "timestamp": "02:14:09", "text": "マチェーテ。発煙手榴弾。"}, {"type": "subtitle", "time": 8051.75, "timestamp": "02:14:11", "text": "バックパックのレベル3。はい、私は"}, {"type": "subtitle", "time": 8054.03, "timestamp": "02:14:14", "text": "感謝している。待て、バイソン。これは何ですか？"}, {"type": "subtitle", "time": 8057.95, "timestamp": "02:14:17", "text": "SMG。それは良いことでしょうか"}, {"type": "subtitle", "time": 8062.629, "timestamp": "02:14:22", "text": "SMG？弾丸ループ。それは必要だろうか？私は"}, {"type": "subtitle", "time": 8077.109, "timestamp": "02:14:37", "text": "ランク。ジョーカーの没落。いいえ、これは"}, {"type": "subtitle", "time": 8079.109, "timestamp": "02:14:39", "text": "一度。ストリーミング配信します"}, {"type": "subtitle", "time": 8080.709, "timestamp": "02:14:40", "text": "この配信のために、そして私は"}, {"type": "subtitle", "time": 8082.27, "timestamp": "02:14:42", "text": "インストールしてください。しないで"}, {"type": "subtitle", "time": 8085.83, "timestamp": "02:14:45", "text": "心配するな。わかった。私のお気に入り"}, {"type": "subtitle", "time": 8090.99, "timestamp": "02:14:50", "text": "ゲーム全体における銃"}, {"type": "subtitle", "time": 8093.39, "timestamp": "02:14:53", "text": "AK-47。最高の"}]
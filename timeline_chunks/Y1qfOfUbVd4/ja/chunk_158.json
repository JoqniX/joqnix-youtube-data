[{"type": "subtitle", "time": 9487.87, "timestamp": "02:38:07", "text": "平均？"}, {"type": "subtitle", "time": 9491.03, "timestamp": "02:38:11", "text": "何？ Apex Fortnite。ゲームは何個ありますか"}, {"type": "subtitle", "time": 9493.349, "timestamp": "02:38:13", "text": "REQ機能が必要ですか？なぜそうしないのか"}, {"type": "subtitle", "time": 9496.11, "timestamp": "02:38:16", "text": "こんなことやってるの？これは重要です。"}, {"type": "subtitle", "time": 9508.469, "timestamp": "02:38:28", "text": "ああ、彼らは生き返らないよ。つまり"}, {"type": "subtitle", "time": 9513.83, "timestamp": "02:38:33", "text": "えっと、君のことを話そうと思うよ"}, {"type": "subtitle", "time": 9516.95, "timestamp": "02:38:36", "text": "今日は仕事がないので。あなた"}, {"type": "subtitle", "time": 9520.389, "timestamp": "02:38:40", "text": "それは私のためにやってくれるだろう。ありがとうございます。私"}, {"type": "subtitle", "time": 9523.349, "timestamp": "02:38:43", "text": "つまり、編集をしてくれる人は今までいなかったし、"}, {"type": "subtitle", "time": 9525.23, "timestamp": "02:38:45", "text": "何か"}, {"type": "subtitle", "time": 9528.79, "timestamp": "02:38:48", "text": "ええ、あなたのチームメイトを思い出せます"}, {"type": "subtitle", "time": 9535.55, "timestamp": "02:38:55", "text": "わかった。えっと、"}, {"type": "subtitle", "time": 9538.55, "timestamp": "02:38:58", "text": "パパの胸。私は3つ持っています。これは何ですか？"}]
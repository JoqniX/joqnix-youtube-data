[{"type": "subtitle", "time": 1803.19, "timestamp": "00:30:03", "text": "それ。そうですね、もし"}, {"type": "subtitle", "time": 1805.19, "timestamp": "00:30:05", "text": "ゲームを試してみたい人は誰でも"}, {"type": "subtitle", "time": 1807.029, "timestamp": "00:30:07", "text": "そしてゲームをプレイしているなら、"}, {"type": "subtitle", "time": 1809.149, "timestamp": "00:30:09", "text": "画面が真っ黒になる"}, {"type": "subtitle", "time": 1814.549, "timestamp": "00:30:14", "text": "PC、ただ確認するだけです"}, {"type": "subtitle", "time": 1817.549, "timestamp": "00:30:17", "text": "ゲームの公平性。そうしてください。確認する"}, {"type": "subtitle", "time": 1820.149, "timestamp": "00:30:20", "text": "誠実さ。次に、起動コマンドを配置します。"}, {"type": "subtitle", "time": 1822.549, "timestamp": "00:30:22", "text": "全画面表示。それでおしまい。それは役に立つでしょう"}, {"type": "subtitle", "time": 1841.75, "timestamp": "00:30:41", "text": "何か？動きはどうですか"}, {"type": "subtitle", "time": 1842.93, "timestamp": "00:30:42", "text": "仕事"}, {"type": "subtitle", "time": 1850.909, "timestamp": "00:30:50", "text": "けれど？私は"}]
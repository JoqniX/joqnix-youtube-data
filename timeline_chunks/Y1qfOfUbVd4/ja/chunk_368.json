[{"type": "subtitle", "time": 22091.47, "timestamp": "06:08:11", "text": "マッチ？ああ、それから彼は"}, {"type": "subtitle", "time": 22096.23, "timestamp": "06:08:16", "text": "大丈夫。真ん中のやつですね。どのモード"}, {"type": "subtitle", "time": 22098.11, "timestamp": "06:08:18", "text": "は"}, {"type": "subtitle", "time": 22100.47, "timestamp": "06:08:20", "text": "それ？彼女は疑問に思っているのだろうか？まあ、確かにそうですね。"}, {"type": "subtitle", "time": 22102.39, "timestamp": "06:08:22", "text": "全員分に十分な量です。確認したい。"}, {"type": "subtitle", "time": 22104.628, "timestamp": "06:08:24", "text": "うん。"}, {"type": "subtitle", "time": 22105.548, "timestamp": "06:08:25", "text": "えっと"}, {"type": "subtitle", "time": 22108.23, "timestamp": "06:08:28", "text": "パパ。よし、行こう。わからない"}, {"type": "subtitle", "time": 22110.43, "timestamp": "06:08:30", "text": "これはモードですが、"}, {"type": "subtitle", "time": 22115.19, "timestamp": "06:08:35", "text": "行く。だから、アーチャンがちょうど入ってきたので、"}, {"type": "subtitle", "time": 22117.83, "timestamp": "06:08:37", "text": "トレーニングとか何かして、それから"}, {"type": "subtitle", "time": 22120.23, "timestamp": "06:08:40", "text": "次のモードに移行できます。"}]
[{"type": "subtitle", "time": 12545.349, "timestamp": "03:29:05", "text": "まだ。なぜ彼は死んでいないのか？どうやって"}, {"type": "subtitle", "time": 12547.55, "timestamp": "03:29:07", "text": "弾丸？はい、わかりました"}, {"type": "subtitle", "time": 12559.91, "timestamp": "03:29:19", "text": "ああ、危うく死ぬところだった。私は死にかけた。どこ"}, {"type": "subtitle", "time": 12562.03, "timestamp": "03:29:22", "text": "来たの？"}, {"type": "subtitle", "time": 12564.349, "timestamp": "03:29:24", "text": "から？レベル3"}, {"type": "subtitle", "time": 12567.269, "timestamp": "03:29:27", "text": "バックパック。ありがとう。ああ、私は"}, {"type": "subtitle", "time": 12570.67, "timestamp": "03:29:30", "text": "ロブスター。よし、私は"}, {"type": "subtitle", "time": 12587.83, "timestamp": "03:29:47", "text": "何？ああ、ゾーン、ゾーン、ゾーン、ゾーン、ゾーン、ゾーン、"}, {"type": "subtitle", "time": 12595.15, "timestamp": "03:29:55", "text": "自分。"}, {"type": "subtitle", "time": 12599.19, "timestamp": "03:29:59", "text": "わかった。 HPレベルについては回復できません。"}]
[{"type": "subtitle", "time": 6121.47, "timestamp": "01:42:01", "text": "しないでください。しかしそれは"}, {"type": "subtitle", "time": 6123.31, "timestamp": "01:42:03", "text": "わかった。うん。"}, {"type": "subtitle", "time": 6127.03, "timestamp": "01:42:07", "text": "それが現れるまで待ちましょう。おお、"}, {"type": "subtitle", "time": 6131.99, "timestamp": "01:42:11", "text": "待って。それは、ええと、私です。とても大きい。"}, {"type": "subtitle", "time": 6134.99, "timestamp": "01:42:14", "text": "待って、調整してなかったっけ？"}, {"type": "subtitle", "time": 6137.669, "timestamp": "01:42:17", "text": "これ？これを調整しなかったのか、それとも"}, {"type": "subtitle", "time": 6146.95, "timestamp": "01:42:26", "text": "はい、調整はしていません。ああ、わかってるよ"}, {"type": "subtitle", "time": 6149.75, "timestamp": "01:42:29", "text": "何が起こっていますか。ああ、忘れてた。えっと、私は"}, {"type": "subtitle", "time": 6153.35, "timestamp": "01:42:33", "text": "忘れた。私は何かしくじってしまった。"}, {"type": "subtitle", "time": 6155.99, "timestamp": "01:42:35", "text": "それが理由です。このことが"}, {"type": "subtitle", "time": 6160.229, "timestamp": "01:42:40", "text": "負荷。わかった。バトルグラウンドでプレイしよう。"}, {"type": "subtitle", "time": 6162.59, "timestamp": "01:42:42", "text": "そして私の"}, {"type": "subtitle", "time": 6165.189, "timestamp": "01:42:45", "text": "翻訳者？ええ、元気です。願っています"}, {"type": "subtitle", "time": 6166.55, "timestamp": "01:42:46", "text": "あなたもよくやっていますね。はい、私は"}, {"type": "subtitle", "time": 6169.79, "timestamp": "01:42:49", "text": "順調です。皆さんは"}, {"type": "subtitle", "time": 6173.109, "timestamp": "01:42:53", "text": "えっと、ランチ？もしあなたが午後なら、"}, {"type": "subtitle", "time": 6175.51, "timestamp": "01:42:55", "text": "皆さん、昼食は召し上がりましたか？皆さんが"}, {"type": "subtitle", "time": 6178.51, "timestamp": "01:42:58", "text": "昼食は召し上がりましたか？"}]
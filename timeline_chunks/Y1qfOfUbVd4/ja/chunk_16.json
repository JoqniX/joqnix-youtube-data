[{"type": "subtitle", "time": 976.189, "timestamp": "00:16:16", "text": "だから私は"}, {"type": "subtitle", "time": 979.59, "timestamp": "00:16:19", "text": "chモバイル版はリリース時に公開します。えっと、私は"}, {"type": "subtitle", "time": 982.67, "timestamp": "00:16:22", "text": "でも、試してみることはできるよ。なぜ"}, {"type": "subtitle", "time": 985.47, "timestamp": "00:16:25", "text": "ない？そこには"}, {"type": "subtitle", "time": 988.55, "timestamp": "00:16:28", "text": "いいえ、試してみても痛みはありません"}, {"type": "subtitle", "time": 994.11, "timestamp": "00:16:34", "text": "外へ、ですよね？うん。何？はぁ？分かりますか"}, {"type": "subtitle", "time": 997.31, "timestamp": "00:16:37", "text": "これ？何？言い訳"}, {"type": "subtitle", "time": 1007.47, "timestamp": "00:16:47", "text": "はぁ？私はまだインターネットを使っています。"}, {"type": "subtitle", "time": 1011.71, "timestamp": "00:16:51", "text": "右？インターネットはまだ使えます。あなた"}]
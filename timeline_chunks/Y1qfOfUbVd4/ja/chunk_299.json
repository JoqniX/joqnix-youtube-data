[{"type": "subtitle", "time": 17941.43, "timestamp": "04:59:01", "text": "知らないけど、ただ"}, {"type": "subtitle", "time": 17943.55, "timestamp": "04:59:03", "text": "リラックスして好き"}, {"type": "subtitle", "time": 17947.83, "timestamp": "04:59:07", "text": "えっと、イソイソで皮をむくんで、ああ、どうやって"}, {"type": "subtitle", "time": 17952.19, "timestamp": "04:59:12", "text": "彼の名前を発音しますか？うん。そう、この人です。"}, {"type": "subtitle", "time": 17954.868, "timestamp": "04:59:14", "text": "ああ、そうだね。こんにちは、アディティさん。ようこそ、ようこそ。"}, {"type": "subtitle", "time": 17957.91, "timestamp": "04:59:17", "text": "お元気でお過ごしでしょうか。私は向かっています"}, {"type": "subtitle", "time": 17959.23, "timestamp": "04:59:19", "text": "病院"}, {"type": "subtitle", "time": 17962.27, "timestamp": "04:59:22", "text": "手術。こんにちは。ご来店ありがとうございました"}, {"type": "subtitle", "time": 17966.868, "timestamp": "04:59:26", "text": "アシャン。良い一日をお過ごしください"}, {"type": "subtitle", "time": 17968.99, "timestamp": "04:59:28", "text": "先に。わかった。そして幸運を祈ります"}, {"type": "subtitle", "time": 17972.47, "timestamp": "04:59:32", "text": "手術。あなたのために祈っています。する"}, {"type": "subtitle", "time": 17974.03, "timestamp": "04:59:34", "text": "あなたのベストを尽くします。わかった。"}, {"type": "subtitle", "time": 17977.19, "timestamp": "04:59:37", "text": "来る。うん。うまくいくといいですね。"}, {"type": "subtitle", "time": 17980.39, "timestamp": "04:59:40", "text": "うん。こんにちは、アディティさん。アディの調子はどうですか？"}, {"type": "subtitle", "time": 17983.07, "timestamp": "04:59:43", "text": "お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 17986.07, "timestamp": "04:59:46", "text": "ヤフー。それでは早速、"}, {"type": "subtitle", "time": 17987.83, "timestamp": "04:59:47", "text": "ロード画面にいたことは分かっています"}, {"type": "subtitle", "time": 17989.67, "timestamp": "04:59:49", "text": "少し遅れて。私は8歳くらい"}, {"type": "subtitle", "time": 17994.39, "timestamp": "04:59:54", "text": "数分後。では、"}, {"type": "subtitle", "time": 17996.27, "timestamp": "04:59:56", "text": "ゲーム。わかった。"}]
[{"type": "subtitle", "time": 5400.79, "timestamp": "01:30:00", "text": "名前のコメントは忘れてください。今はしかし"}, {"type": "subtitle", "time": 5402.35, "timestamp": "01:30:02", "text": "はい、来てくれてありがとう"}, {"type": "subtitle", "time": 5405.27, "timestamp": "01:30:05", "text": "その頃には。マリーナさん、来てくれてありがとう。"}, {"type": "subtitle", "time": 5407.91, "timestamp": "01:30:07", "text": "今日を楽しんでください。"}, {"type": "subtitle", "time": 5409.43, "timestamp": "01:30:09", "text": "お越しいただきありがとうございます。楽しんでいただければ幸いです。"}, {"type": "subtitle", "time": 5410.43, "timestamp": "01:30:10", "text": "今日では"}, {"type": "subtitle", "time": 5413.87, "timestamp": "01:30:13", "text": "良い。お立ち寄りいただきありがとうございます"}, {"type": "subtitle", "time": 5416.75, "timestamp": "01:30:16", "text": "による。本日はお越しいただきありがとうございました。"}, {"type": "subtitle", "time": 5419.229, "timestamp": "01:30:19", "text": "クロノ、楽しんでください"}, {"type": "subtitle", "time": 5421.75, "timestamp": "01:30:21", "text": "日。他の人たちも同じです。ありがとう"}, {"type": "subtitle", "time": 5422.83, "timestamp": "01:30:22", "text": "来るために"}, {"type": "subtitle", "time": 5425.75, "timestamp": "01:30:25", "text": "による。えっと、レックス、来てくれてありがとう"}, {"type": "subtitle", "time": 5427.39, "timestamp": "01:30:27", "text": "良い。楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 5429.91, "timestamp": "01:30:29", "text": "今日。コンステレーションへようこそ。"}, {"type": "subtitle", "time": 5437.11, "timestamp": "01:30:37", "text": "将来ぜひお越しください"}, {"type": "subtitle", "time": 5439.99, "timestamp": "01:30:39", "text": "ストリーム。今日は楽しんでいただけたでしょうか。アルチャ、"}, {"type": "subtitle", "time": 5441.83, "timestamp": "01:30:41", "text": "お越しいただきありがとうございます。幸運を祈ります"}, {"type": "subtitle", "time": 5443.83, "timestamp": "01:30:43", "text": "あなたの配信も先に進みます。楽しむ"}, {"type": "subtitle", "time": 5447.43, "timestamp": "01:30:47", "text": "PALワールド。 PALワールドでご一緒します"}, {"type": "subtitle", "time": 5449.55, "timestamp": "01:30:49", "text": "いつか"}, {"type": "subtitle", "time": 5454.229, "timestamp": "01:30:54", "text": "未来。おそらく来月でしょう。ええ、私たちは"}, {"type": "subtitle", "time": 5455.99, "timestamp": "01:30:55", "text": "一緒にプレイしたり、サーバーを作成したり、"}, {"type": "subtitle", "time": 5457.189, "timestamp": "01:30:57", "text": "何か。わからない。参加します"}, {"type": "subtitle", "time": 5459.03, "timestamp": "01:30:59", "text": "あなたか何か。わからない。私たちは"}]
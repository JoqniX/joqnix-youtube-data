[{"type": "subtitle", "time": 7818.79, "timestamp": "02:10:18", "text": "あなた。はい、戻ってきました。なぜ私はそうではないのか"}, {"type": "subtitle", "time": 7843.149, "timestamp": "02:10:43", "text": "もの？いいえ。何も。"}, {"type": "subtitle", "time": 7845.79, "timestamp": "02:10:45", "text": "わかった。あらら。 A"}, {"type": "subtitle", "time": 7847.95, "timestamp": "02:10:47", "text": "バール。"}, {"type": "subtitle", "time": 7851.669, "timestamp": "02:10:51", "text": "ショートおじさん。待って、角度を調整して掴みやすくする。何"}, {"type": "subtitle", "time": 7854.27, "timestamp": "02:10:54", "text": "それで本当に効果があるのか​​？私はそうは思わない"}]
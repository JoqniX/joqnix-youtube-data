[{"type": "subtitle", "time": 3841.15, "timestamp": "01:04:01", "text": "ケイティが20点。すごい。 200。"}, {"type": "subtitle", "time": 3847.549, "timestamp": "01:04:07", "text": "ニース。ということで、"}, {"type": "subtitle", "time": 3851.589, "timestamp": "01:04:11", "text": "ゲーム。私は終わった。"}, {"type": "subtitle", "time": 3852.75, "timestamp": "01:04:12", "text": "何"}, {"type": "subtitle", "time": 3854.829, "timestamp": "01:04:14", "text": "の"}, {"type": "subtitle", "time": 3858.71, "timestamp": "01:04:18", "text": "何？そして、そのことのために"}, {"type": "subtitle", "time": 3861.029, "timestamp": "01:04:21", "text": "えっと、早速アンインストールしましょう"}, {"type": "subtitle", "time": 3863.99, "timestamp": "01:04:23", "text": "まさに今、こちらで。はい。その"}, {"type": "subtitle", "time": 3871.63, "timestamp": "01:04:31", "text": "わーい。終わりました。何てことだ。その"}, {"type": "subtitle", "time": 3875.109, "timestamp": "01:04:35", "text": "以上。何てことだ。終わりました。あのゲーム"}, {"type": "subtitle", "time": 3887.069, "timestamp": "01:04:47", "text": "ああ、それは"}, {"type": "subtitle", "time": 3895.47, "timestamp": "01:04:55", "text": "うん。それは良かった"}, {"type": "subtitle", "time": 3898.309, "timestamp": "01:04:58", "text": "1つ。皆さんが楽しんでくれたら嬉しいです。"}]
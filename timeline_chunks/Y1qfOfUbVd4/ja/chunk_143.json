[{"type": "subtitle", "time": 8595.87, "timestamp": "02:23:15", "text": "自分？私は自分が公然としていることは分かっていますが、"}, {"type": "subtitle", "time": 8603.349, "timestamp": "02:23:23", "text": "ドクター、撃ち抜くことすらできない"}, {"type": "subtitle", "time": 8615.55, "timestamp": "02:23:35", "text": "私をからかってるの？このゲーム"}, {"type": "subtitle", "time": 8618.349, "timestamp": "02:23:38", "text": "は"}, {"type": "subtitle", "time": 8624.19, "timestamp": "02:23:44", "text": "バカ。私を処刑してください。撮影中です。"}, {"type": "subtitle", "time": 8626.91, "timestamp": "02:23:46", "text": "わかった。"}]
[{"type": "subtitle", "time": 16747.349, "timestamp": "04:39:07", "text": "する？まるでゲーマーになった気分だった。その男は感じた"}, {"type": "subtitle", "time": 16749.23, "timestamp": "04:39:09", "text": "ゲーマーのように"}, {"type": "subtitle", "time": 16770.269, "timestamp": "04:39:30", "text": "殺すべきだ"}, {"type": "subtitle", "time": 16796.868, "timestamp": "04:39:56", "text": "彼。これは恐ろしい。これはもっと怖い"}, {"type": "subtitle", "time": 16798.19, "timestamp": "04:39:58", "text": "恐怖よりも"}]
[{"type": "subtitle", "time": 1201.11, "timestamp": "00:20:01", "text": "ああ、バトルフィールド2044を買おうと思ったんだ"}, {"type": "subtitle", "time": 1203.47, "timestamp": "00:20:03", "text": "私がそれをプレイしていたので"}, {"type": "subtitle", "time": 1206.63, "timestamp": "00:20:06", "text": "ベータ版で、うーん、私も参加すべきかな、と思った。"}, {"type": "subtitle", "time": 1215.15, "timestamp": "00:20:15", "text": "何？私は見ませんでした"}, {"type": "subtitle", "time": 1219.35, "timestamp": "00:20:19", "text": "彼。見てみましょう。簡単すぎる。簡単すぎる。"}, {"type": "subtitle", "time": 1231.789, "timestamp": "00:20:31", "text": "わかりますか？"}, {"type": "subtitle", "time": 1239.71, "timestamp": "00:20:39", "text": "何？何てことだ。何が"}, {"type": "subtitle", "time": 1242.35, "timestamp": "00:20:42", "text": "これ？ 1つ"}, {"type": "subtitle", "time": 1258.39, "timestamp": "00:20:58", "text": "そこには。しかし、ホラーは"}]
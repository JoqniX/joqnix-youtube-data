[{"type": "subtitle", "time": 789.829, "timestamp": "00:13:09", "text": "ニース。 Pubsyとは違う。"}, {"type": "subtitle", "time": 791.91, "timestamp": "00:13:11", "text": "私はそれら全てが好きです。それはまるで"}, {"type": "subtitle", "time": 810.71, "timestamp": "00:13:30", "text": "まだ。何？私はもう帰ります。私をからかってるの？"}, {"type": "subtitle", "time": 813.71, "timestamp": "00:13:33", "text": "何？弾切れだ。"}, {"type": "subtitle", "time": 816.71, "timestamp": "00:13:36", "text": "おお。弾薬が尽きたと想像してみてください"}, {"type": "subtitle", "time": 835.11, "timestamp": "00:13:55", "text": "わかった。私は何人か殺したよね？何"}]
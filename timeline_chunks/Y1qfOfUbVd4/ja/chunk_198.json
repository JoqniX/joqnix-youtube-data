[{"type": "subtitle", "time": 11893.75, "timestamp": "03:18:13", "text": "1つ？しかし、あの最後の試合。いいえ、私は"}, {"type": "subtitle", "time": 11896.99, "timestamp": "03:18:16", "text": "勝利した。でも私は"}, {"type": "subtitle", "time": 11899.63, "timestamp": "03:18:19", "text": "できなかった。"}, {"type": "subtitle", "time": 11912.349, "timestamp": "03:18:32", "text": "痛みはほとんどない"}, {"type": "subtitle", "time": 11917.95, "timestamp": "03:18:37", "text": "ブランド。だから、こういうスキンが手に入るんだ"}, {"type": "subtitle", "time": 11920.59, "timestamp": "03:18:40", "text": "何か。"}, {"type": "subtitle", "time": 11923.07, "timestamp": "03:18:43", "text": "段階的な色変化"}, {"type": "subtitle", "time": 11926.55, "timestamp": "03:18:46", "text": "煙。カウンターバンドを1つ購入したい"}, {"type": "subtitle", "time": 11928.269, "timestamp": "03:18:48", "text": "から"}, {"type": "subtitle", "time": 11932.99, "timestamp": "03:18:52", "text": "これ。えっと、何ですか"}, {"type": "subtitle", "time": 11937.95, "timestamp": "03:18:57", "text": "タイミングは？私は自分が何を見たのかさえ見なかった"}]
[{"type": "subtitle", "time": 3603.19, "timestamp": "01:00:03", "text": "今日はこれをスピードランしないといけないから。 だから、"}, {"type": "subtitle", "time": 3609.27, "timestamp": "01:00:09", "text": "忘れない限り、少し急いでやろうと思います。 もし"}, {"type": "subtitle", "time": 3611.75, "timestamp": "01:00:11", "text": "忘れてしまったら、今日中に頭に染み込むまで、ひたすら復習"}, {"type": "subtitle", "time": 3613.75, "timestamp": "01:00:13", "text": "と練習を続けます"}, {"type": "subtitle", "time": 3628.15, "timestamp": "01:00:28", "text": "他の"}, {"type": "subtitle", "time": 3630.549, "timestamp": "01:00:30", "text": "人たちが私が本当に"}, {"type": "subtitle", "time": 3633.27, "timestamp": "01:00:33", "text": "遅れていると言っている理由がよく分かります。なぜなら、"}, {"type": "subtitle", "time": 3635.589, "timestamp": "01:00:35", "text": "私はあらゆる"}, {"type": "subtitle", "time": 3639.589, "timestamp": "01:00:39", "text": "ことを忘れてしまったからです。 字も読めない。"}, {"type": "subtitle", "time": 3643.03, "timestamp": "01:00:43", "text": "いいえ、知っていますが、復習はしていません。 今、自分の現在の"}, {"type": "subtitle", "time": 3648.47, "timestamp": "01:00:48", "text": "レベルが理解できました。   何てことだ"}, {"type": "subtitle", "time": 3652.95, "timestamp": "01:00:52", "text": "。 もし私が耳を傾けていたら、"}]
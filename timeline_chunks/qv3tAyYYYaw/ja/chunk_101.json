[{"type": "subtitle", "time": 6060.87, "timestamp": "01:41:00", "text": "愛らしい。"}, {"type": "subtitle", "time": 6063.51, "timestamp": "01:41:03", "text": "感動的だけど、時々"}, {"type": "subtitle", "time": 6067.189, "timestamp": "01:41:07", "text": "あなたのことが心配になる。 愛情を呼び起こす。 とっても"}, {"type": "subtitle", "time": 6070.47, "timestamp": "01:41:10", "text": "可愛い。 わかった。 わかった。 愛らしい。"}, {"type": "subtitle", "time": 6073.75, "timestamp": "01:41:13", "text": "ああ、なんてことだ、これらの英語の用語。"}, {"type": "subtitle", "time": 6076.709, "timestamp": "01:41:16", "text": "私は、おそらく私が使う英語という記号よりも、むしろ記号に近い存在です"}, {"type": "subtitle", "time": 6079.59, "timestamp": "01:41:19", "text": "。"}, {"type": "subtitle", "time": 6092.149, "timestamp": "01:41:32", "text": "[笑い] 自分"}, {"type": "subtitle", "time": 6095.669, "timestamp": "01:41:35", "text": "自身が怖くなりそうだった。"}, {"type": "subtitle", "time": 6114.31, "timestamp": "01:41:54", "text": "。 まあ、大丈夫だよ。"}]
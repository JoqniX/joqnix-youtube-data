[{"type": "subtitle", "time": 843.269, "timestamp": "00:14:03", "text": "ああ、"}, {"type": "subtitle", "time": 846.79, "timestamp": "00:14:06", "text": "エマに似ているけど、"}, {"type": "subtitle", "time": 848.949, "timestamp": "00:14:08", "text": "鳴き声がこうなんだ。"}, {"type": "subtitle", "time": 860.79, "timestamp": "00:14:20", "text": "、待って。 えっと、あの部分を除けばジンみたいですね"}, {"type": "subtitle", "time": 863.829, "timestamp": "00:14:23", "text": "。"}, {"type": "subtitle", "time": 866.23, "timestamp": "00:14:26", "text": "うん。"}, {"type": "subtitle", "time": 869.67, "timestamp": "00:14:29", "text": "ああ、それから私は、"}, {"type": "subtitle", "time": 871.43, "timestamp": "00:14:31", "text": "ええと、これは違う、ああ、そうですね。"}, {"type": "subtitle", "time": 875.03, "timestamp": "00:14:35", "text": "これは、"}, {"type": "subtitle", "time": 880.87, "timestamp": "00:14:40", "text": "J の間にあるミミミという漢字ではないでしょうか？ えっと、どこですか。"}, {"type": "subtitle", "time": 884.389, "timestamp": "00:14:44", "text": "ああ、菊菊。 うん。 ということで、こちらがミミ・カンジです"}, {"type": "subtitle", "time": 886.629, "timestamp": "00:14:46", "text": "。"}, {"type": "subtitle", "time": 888.55, "timestamp": "00:14:48", "text": "待って、待って。 ミミではない。 あ、待って、待って、"}, {"type": "subtitle", "time": 891.03, "timestamp": "00:14:51", "text": "待って、待って。 ここに「ミミ」の漢字が入ります。 こういうのは、"}, {"type": "subtitle", "time": 893.509, "timestamp": "00:14:53", "text": "これを超えるものだと"}, {"type": "subtitle", "time": 895.67, "timestamp": "00:14:55", "text": "思う。 私は思う。 わからない。 でも、"}, {"type": "subtitle", "time": 898.79, "timestamp": "00:14:58", "text": "そうだ、"}]
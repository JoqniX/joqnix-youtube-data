[{"type": "subtitle", "time": 8460.79, "timestamp": "02:21:00", "text": "ああ、それ忘れてた。 まだ持っていると思う"}, {"type": "subtitle", "time": 8486.309, "timestamp": "02:21:26", "text": "正直に言うと、考えてみると、"}, {"type": "subtitle", "time": 8492.389, "timestamp": "02:21:32", "text": "私に起こったことは、良い現実認識になったような気がします。"}, {"type": "subtitle", "time": 8496.23, "timestamp": "02:21:36", "text": "そう、それは良い現実"}, {"type": "subtitle", "time": 8499.429, "timestamp": "02:21:39", "text": "確認みたいなもので、私は"}, {"type": "subtitle", "time": 8501.67, "timestamp": "02:21:41", "text": "ずっと「ああ、私はみんなと友達でいられる」って自分の世界に浸っていたから"}, {"type": "subtitle", "time": 8507.75, "timestamp": "02:21:47", "text": "私はこれからもみんなと友達でいるよ。"}, {"type": "subtitle", "time": 8513.91, "timestamp": "02:21:53", "text": "友情関係を断ち切ったりする必要はないよ。 私もそう"}, {"type": "subtitle", "time": 8516.63, "timestamp": "02:21:56", "text": "思いました。"}, {"type": "subtitle", "time": 8518.71, "timestamp": "02:21:58", "text": "あなたはまるでデュラの世界にいるようなものだ。 ええ、私はずっと"}]
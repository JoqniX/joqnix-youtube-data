[{"type": "subtitle", "time": 20047.83, "timestamp": "05:34:07", "text": "つの漢字でも、違う意味になることがある。"}, {"type": "subtitle", "time": 20069.19, "timestamp": "05:34:29", "text": "頭がパンパンだ。朝"}, {"type": "subtitle", "time": 20072.788, "timestamp": "05:34:32", "text": "6時に起きた。何時からこれをやってたんだっけ"}, {"type": "subtitle", "time": 20075.97, "timestamp": "05:34:35", "text": "？8時だったっけ？8時だ。"}, {"type": "subtitle", "time": 20078.788, "timestamp": "05:34:38", "text": "[笑い] 今は2時だ。"}, {"type": "subtitle", "time": 20083.35, "timestamp": "05:34:43", "text": "試験は6時。試験用紙は6時。2、3、4、5、2、3、つまり"}]
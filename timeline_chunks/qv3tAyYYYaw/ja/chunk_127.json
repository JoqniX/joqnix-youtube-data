[{"type": "subtitle", "time": 7629.03, "timestamp": "02:07:09", "text": "でも、誰がそんなことを言ったのかは知らない"}, {"type": "subtitle", "time": 7631.91, "timestamp": "02:07:11", "text": "けど、誰が"}, {"type": "subtitle", "time": 7634.55, "timestamp": "02:07:14", "text": "あなたに言ったのかも知らない。 私はまだ"}, {"type": "subtitle", "time": 7638.47, "timestamp": "02:07:18", "text": "彼らと話そうとしているけど、実際には話せていない。"}, {"type": "subtitle", "time": 7641.27, "timestamp": "02:07:21", "text": "ああ、君は知らないんだよ。 誤報は"}, {"type": "subtitle", "time": 7642.95, "timestamp": "02:07:22", "text": "起こりうる。"}, {"type": "subtitle", "time": 7647.27, "timestamp": "02:07:27", "text": "それが私がこのコミュニティで気づいたことです。"}, {"type": "subtitle", "time": 7650.629, "timestamp": "02:07:30", "text": "人はただでたらめを言うだけだ。   まだだ"}, {"type": "subtitle", "time": 7652.709, "timestamp": "02:07:32", "text": "。"}, {"type": "subtitle", "time": 7655.03, "timestamp": "02:07:35", "text": "私はいつも、"}, {"type": "subtitle", "time": 7657.83, "timestamp": "02:07:37", "text": "私のビデオが公開された後など、何かが起こった後に試みました。"}, {"type": "subtitle", "time": 7665.669, "timestamp": "02:07:45", "text": "いいえ、私は彼らに戻ろうとしたことは一度もありません。"}, {"type": "subtitle", "time": 7669.51, "timestamp": "02:07:49", "text": "つまり、私が"}, {"type": "subtitle", "time": 7673.75, "timestamp": "02:07:53", "text": "彼らに直接問い詰める、つまり、会議の後に、"}, {"type": "subtitle", "time": 7677.03, "timestamp": "02:07:57", "text": "対立的な電話をするということですか？"}]
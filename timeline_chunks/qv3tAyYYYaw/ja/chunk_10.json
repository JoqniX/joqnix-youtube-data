[{"type": "subtitle", "time": 601.91, "timestamp": "00:10:01", "text": "。 書きたいのですが、"}, {"type": "subtitle", "time": 603.75, "timestamp": "00:10:03", "text": "時間がありません。"}, {"type": "subtitle", "time": 607.75, "timestamp": "00:10:07", "text": "靴が3つと、これと、"}, {"type": "subtitle", "time": 611.59, "timestamp": "00:10:11", "text": "これは、土の漢字です。スチとか何とかで、"}, {"type": "subtitle", "time": 621.99, "timestamp": "00:10:21", "text": "一緒に、"}, {"type": "subtitle", "time": 625.35, "timestamp": "00:10:25", "text": "ええ、この物の上に、"}, {"type": "subtitle", "time": 627.487, "timestamp": "00:10:27", "text": "それから何"}, {"type": "subtitle", "time": 628.31, "timestamp": "00:10:28", "text": "[ため息をついて息を呑む]"}, {"type": "subtitle", "time": 634.31, "timestamp": "00:10:34", "text": "ああ、私の、オーケー、これは、うーん、はははは、"}, {"type": "subtitle", "time": 638.15, "timestamp": "00:10:38", "text": "漢字ですが、ここに二重のダッシュ"}, {"type": "subtitle", "time": 639.99, "timestamp": "00:10:39", "text": "線はありません。 箱型の"}, {"type": "subtitle", "time": 644.47, "timestamp": "00:10:44", "text": "窓にすればいいんです。 ええ、ハハと同じように、それをここに"}]
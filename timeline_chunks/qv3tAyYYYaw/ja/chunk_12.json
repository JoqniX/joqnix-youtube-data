[{"type": "subtitle", "time": 725.43, "timestamp": "00:12:05", "text": "。 すでに知っている内容なので、まるで初めて見るような感覚です。"}, {"type": "subtitle", "time": 727.509, "timestamp": "00:12:07", "text": "でも、"}, {"type": "subtitle", "time": 730.87, "timestamp": "00:12:10", "text": "私はそれを勉強してきたんです。 それ以上は研究していません"}, {"type": "subtitle", "time": 736.71, "timestamp": "00:12:16", "text": "。 私はそれを知っています。 うん。 うん。 このKJIは"}, {"type": "subtitle", "time": 740.15, "timestamp": "00:12:20", "text": "NOAの授業中に撮影されたものです。 うん。"}, {"type": "subtitle", "time": 743.269, "timestamp": "00:12:23", "text": "だって、ちょっとした復習だったんだもん。 忘れた。"}, {"type": "subtitle", "time": 751.99, "timestamp": "00:12:31", "text": "誰も"}, {"type": "subtitle", "time": 770.389, "timestamp": "00:12:50", "text": "ヒットのような人ではない。"}, {"type": "subtitle", "time": 773.75, "timestamp": "00:12:53", "text": "しかし、これは文字通りヒトです。"}, {"type": "subtitle", "time": 776.23, "timestamp": "00:12:56", "text": "ハイドゥとヒトの違いは何ですか"}]
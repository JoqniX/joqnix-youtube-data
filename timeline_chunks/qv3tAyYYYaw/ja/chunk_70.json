[{"type": "subtitle", "time": 4211.669, "timestamp": "01:10:11", "text": "３回挑戦。 わからない。   私は"}, {"type": "subtitle", "time": 4214.149, "timestamp": "01:10:14", "text": "全てが好きというわけではありません。 ブドウ、"}, {"type": "subtitle", "time": 4218.229, "timestamp": "01:10:18", "text": "果物、リンゴ。 あるいはオレンジ、バナナ、"}, {"type": "subtitle", "time": 4220.31, "timestamp": "01:10:20", "text": "イチゴなど、"}, {"type": "subtitle", "time": 4230.028, "timestamp": "01:10:30", "text": "アイスクリームみたいな味とかが好きなんです"}, {"type": "subtitle", "time": 4233.27, "timestamp": "01:10:33", "text": "。 昨日、私は本当にあの"}, {"type": "subtitle", "time": 4238.31, "timestamp": "01:10:38", "text": "オレンジ色のトマトみたいな、"}, {"type": "subtitle", "time": 4241.83, "timestamp": "01:10:41", "text": "パルメザンチーズとペリモンの"}, {"type": "subtitle", "time": 4243.83, "timestamp": "01:10:43", "text": "料理を食べました。 今、私の机の上に置いてあります"}, {"type": "subtitle", "time": 4246.39, "timestamp": "01:10:46", "text": "。   今はただの"}, {"type": "subtitle", "time": 4253.11, "timestamp": "01:10:53", "text": "。"}]
[{"type": "subtitle", "time": 20100.39, "timestamp": "05:35:00", "text": "1、4、5。あと3時間しかない。"}, {"type": "subtitle", "time": 20102.23, "timestamp": "05:35:02", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 20104.31, "timestamp": "05:35:04", "text": "待って。あと"}, {"type": "subtitle", "time": 20105.99, "timestamp": "05:35:05", "text": "3時間しかない。どうしよう"}, {"type": "subtitle", "time": 20118.548, "timestamp": "05:35:18", "text": "ああ、なんてことだ。見えない。目が"}, {"type": "subtitle", "time": 20121.166, "timestamp": "05:35:21", "text": "ぼやけてる。"}, {"type": "subtitle", "time": 20122.948, "timestamp": "05:35:22", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 20125.91, "timestamp": "05:35:25", "text": "じゃあね。H。N4"}, {"type": "subtitle", "time": 20129.99, "timestamp": "05:35:29", "text": "N5をやってると思ってた。100問"}, {"type": "subtitle", "time": 20144.548, "timestamp": "05:35:44", "text": "でも、今日の"}, {"type": "subtitle", "time": 20148.47, "timestamp": "05:35:48", "text": "配信で言ったように、結果がどうであれ、"}, {"type": "subtitle", "time": 20151.35, "timestamp": "05:35:51", "text": "今日の復習テストに落ちたとしても"}, {"type": "subtitle", "time": 20155.59, "timestamp": "05:35:55", "text": "大丈夫。"}, {"type": "subtitle", "time": 20158.868, "timestamp": "05:35:58", "text": "授業が終わったらまた"}]
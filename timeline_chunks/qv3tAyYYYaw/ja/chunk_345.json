[{"type": "subtitle", "time": 20700.948, "timestamp": "05:45:00", "text": "実際に"}, {"type": "subtitle", "time": 20704.15, "timestamp": "05:45:04", "text": "勉強に行きます。 いや、いや。 食べて、休んで、"}, {"type": "subtitle", "time": 20728.31, "timestamp": "05:45:28", "text": "こんにちは。 皆さん、私がまとめます。"}, {"type": "subtitle", "time": 20732.23, "timestamp": "05:45:32", "text": "今夜か明日、また会えるかもしれませんね。"}, {"type": "subtitle", "time": 20736.31, "timestamp": "05:45:36", "text": "明日も出勤することになった。 うん。 ええ、そうですね、"}, {"type": "subtitle", "time": 20742.23, "timestamp": "05:45:42", "text": "来年の1月に試験とか色々あるので"}, {"type": "subtitle", "time": 20745.19, "timestamp": "05:45:45", "text": "。 それでは、このようにしましょう。"}, {"type": "subtitle", "time": 20751.67, "timestamp": "05:45:51", "text": "今の配信では、毎日新しい形の音楽を作っているような気がする。"}, {"type": "subtitle", "time": 20754.628, "timestamp": "05:45:54", "text": "N4の語彙リストがあるので、アニメをいくつかやってみよう。"}, {"type": "subtitle", "time": 20757.83, "timestamp": "05:45:57", "text": "いや、漢字のカードみたいなやつだよね？"}]
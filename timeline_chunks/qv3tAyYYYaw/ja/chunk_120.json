[{"type": "subtitle", "time": 7204.31, "timestamp": "02:00:04", "text": "復帰すると言いたくなったけど、なんで"}, {"type": "subtitle", "time": 7207.03, "timestamp": "02:00:07", "text": "動画を投稿してないんだろう？ ショートパンツはどうですか？ いつから"}, {"type": "subtitle", "time": 7209.589, "timestamp": "02:00:09", "text": "切り抜き作業を始められますか？"}, {"type": "subtitle", "time": 7212.55, "timestamp": "02:00:12", "text": "視聴者が"}, {"type": "subtitle", "time": 7215.27, "timestamp": "02:00:15", "text": "YouTubeやTwitchでクリップを気に入ってくれるのを常に頼りにして、それらの"}, {"type": "subtitle", "time": 7217.43, "timestamp": "02:00:17", "text": "クリップをショート動画として使うわけにはいきません。 これからは自分のやりたいことを"}, {"type": "subtitle", "time": 7220.229, "timestamp": "02:00:20", "text": "見つけなければならない。 しかし、私は"}, {"type": "subtitle", "time": 7223.99, "timestamp": "02:00:23", "text": "常にそれに頼るわけにはいかない。"}, {"type": "subtitle", "time": 7230.149, "timestamp": "02:00:30", "text": "それら全て。"}, {"type": "subtitle", "time": 7232.55, "timestamp": "02:00:32", "text": "それで、私の日本語"}, {"type": "subtitle", "time": 7235.27, "timestamp": "02:00:35", "text": "自己学習ビデオはいつ公開するんですか？ ずっとやりたかったんだよ"}, {"type": "subtitle", "time": 7238.87, "timestamp": "02:00:38", "text": "。   私も"}, {"type": "subtitle", "time": 7241.51, "timestamp": "02:00:41", "text": "チャンネル"}, {"type": "subtitle", "time": 7244.229, "timestamp": "02:00:44", "text": "紹介すら持っていません。"}, {"type": "subtitle", "time": 7246.993, "timestamp": "02:00:46", "text": "チャンネル紹介すら用意していないんです。"}, {"type": "subtitle", "time": 7248.709, "timestamp": "02:00:48", "text": "[笑い]"}, {"type": "subtitle", "time": 7254.55, "timestamp": "02:00:54", "text": "編集者を雇うのはお金がかかるんです。"}]
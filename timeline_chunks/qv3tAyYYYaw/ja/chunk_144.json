[{"type": "subtitle", "time": 8640.87, "timestamp": "02:24:00", "text": "[笑い] 何"}, {"type": "subtitle", "time": 8644.469, "timestamp": "02:24:04", "text": "時間も。"}, {"type": "subtitle", "time": 8647.03, "timestamp": "02:24:07", "text": "ファイナルファンタジーで自分がどのクラスだったか忘れてしまった"}, {"type": "subtitle", "time": 8655.67, "timestamp": "02:24:15", "text": "私は最初のエリアの後の砂漠地帯まで到達しました"}, {"type": "subtitle", "time": 8661.27, "timestamp": "02:24:21", "text": "。 砂漠地帯に到達した。"}, {"type": "subtitle", "time": 8663.429, "timestamp": "02:24:23", "text": "覚えているのはそれだけです。"}, {"type": "subtitle", "time": 8673.75, "timestamp": "02:24:33", "text": "配信見逃しちゃったよ。"}, {"type": "subtitle", "time": 8681.83, "timestamp": "02:24:41", "text": "俺は「あぁ」って感じだった。   そうそう"}, {"type": "subtitle", "time": 8691.51, "timestamp": "02:24:51", "text": "無料かどうかは分かりません。"}, {"type": "subtitle", "time": 8695.67, "timestamp": "02:24:55", "text": "多くの人がそれについて話しているようだ。"}]
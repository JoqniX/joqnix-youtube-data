[{"type": "subtitle", "time": 4746.39, "timestamp": "01:19:06", "text": "ハッシュを"}, {"type": "subtitle", "time": 4752.229, "timestamp": "01:19:12", "text": "人々が何を使うかは問題ではないのでしょうか"}, {"type": "subtitle", "time": 4756.55, "timestamp": "01:19:16", "text": "？ ええ、それも本当ですね。 以前は"}, {"type": "subtitle", "time": 4764.709, "timestamp": "01:19:24", "text": "モッドを持っていたけど今はモッドを持っていないから、そう感じたんです。 私は"}, {"type": "subtitle", "time": 4766.63, "timestamp": "01:19:26", "text": "[音楽]すべて"}, {"type": "subtitle", "time": 4770.709, "timestamp": "01:19:30", "text": "自動モードにするか、あるいは"}, {"type": "subtitle", "time": 4774.149, "timestamp": "01:19:34", "text": "この装置をオンにしておけば簡単になると思ったのですが、"}]
[{"type": "subtitle", "time": 7873.03, "timestamp": "02:11:13", "text": "バルタルとかそういうカードゲームに慣れる必要があるんです。"}, {"type": "subtitle", "time": 7876.31, "timestamp": "02:11:16", "text": "彼らはそのゲームプレイ"}, {"type": "subtitle", "time": 7879.35, "timestamp": "02:11:19", "text": "や世界観構築をどのように見ているのか、例えばセーブセックスとかそういうこと"}, {"type": "subtitle", "time": 7884.069, "timestamp": "02:11:24", "text": "。 私はそういうのは苦手です。 私は少しの間、眠りにつきます"}, {"type": "subtitle", "time": 7887.99, "timestamp": "02:11:27", "text": "。"}, {"type": "subtitle", "time": 7895.99, "timestamp": "02:11:35", "text": "カードゲーム。 いいえ。どんなゲームを"}, {"type": "subtitle", "time": 7898.87, "timestamp": "02:11:38", "text": "プレイするんですか？  MMO、RPG、"}, {"type": "subtitle", "time": 7903.27, "timestamp": "02:11:43", "text": "FPS、ARPG、TRPG、ターン制、"}, {"type": "subtitle", "time": 7907.75, "timestamp": "02:11:47", "text": "ポップダウン、ハッケンスラッシュ、パズル。   ほかに"}, {"type": "subtitle", "time": 7911.189, "timestamp": "02:11:51", "text": "何か？ リズム、"}, {"type": "subtitle", "time": 7913.83, "timestamp": "02:11:53", "text": "ライトノベル。"}, {"type": "subtitle", "time": 7916.39, "timestamp": "02:11:56", "text": "私は多くの問題を解決しようと努めています。"}, {"type": "subtitle", "time": 7918.229, "timestamp": "02:11:58", "text": "ライトノベルの配信をもっとやるべきだと思う"}]
[{"type": "subtitle", "time": 10802.15, "timestamp": "03:00:02", "text": "私のエアコンは、"}, {"type": "subtitle", "time": 10805.269, "timestamp": "03:00:05", "text": "時々ちょっとだけオンになっているような感じなんだ。 勝手に電源が切れたり入ったりするんです。何が"}, {"type": "subtitle", "time": 10816.95, "timestamp": "03:00:16", "text": "起きてるのか分かりません。"}, {"type": "subtitle", "time": 10818.71, "timestamp": "03:00:18", "text": "例えば今、電源を入れます。よし。"}, {"type": "subtitle", "time": 10820.469, "timestamp": "03:00:20", "text": "数分後には自動的に電源が"}, {"type": "subtitle", "time": 10823.75, "timestamp": "03:00:23", "text": "切れて、また電源が入り、また切れて"}, {"type": "subtitle", "time": 10827.83, "timestamp": "03:00:27", "text": "、また電源が入ります。電源が切れている時に"}, {"type": "subtitle", "time": 10830.55, "timestamp": "03:00:30", "text": "、勝手に電源が入って"}, {"type": "subtitle", "time": 10835.67, "timestamp": "03:00:35", "text": "また切れることもあります。"}]
[{"type": "subtitle", "time": 10713.269, "timestamp": "02:58:33", "text": "それに見える？"}, {"type": "subtitle", "time": 10724.428, "timestamp": "02:58:44", "text": "それは西部開拓時代のカウボーイみたいだ。"}, {"type": "subtitle", "time": 10725.349, "timestamp": "02:58:45", "text": "[笑い] わかった"}, {"type": "subtitle", "time": 10728.55, "timestamp": "02:58:48", "text": "。そして、こんな風にバーゲートに入る"}, {"type": "subtitle", "time": 10730.55, "timestamp": "02:58:50", "text": "。レッド・デッド・リデンプションでちょっと見たことがある。"}]
[{"type": "subtitle", "time": 15504.63, "timestamp": "04:18:24", "text": "昨晩から勉強していたことを覚えています"}, {"type": "subtitle", "time": 15507.83, "timestamp": "04:18:27", "text": "。 昨日午前6時 [音楽]"}, {"type": "subtitle", "time": 15510.55, "timestamp": "04:18:30", "text": "午後6時 いや、午後5時から。"}, {"type": "subtitle", "time": 15513.51, "timestamp": "04:18:33", "text": "今日はこれを勉強していて、"}, {"type": "subtitle", "time": 15516.469, "timestamp": "04:18:36", "text": "N5の漢字100個を5つ全部やった。"}, {"type": "subtitle", "time": 15520.55, "timestamp": "04:18:40", "text": "昨日は44までしかやらなかった。"}, {"type": "subtitle", "time": 15524.71, "timestamp": "04:18:44", "text": "そう、44。全部やったんだ。"}, {"type": "subtitle", "time": 15526.229, "timestamp": "04:18:46", "text": "えっと、また"}, {"type": "subtitle", "time": 15528.229, "timestamp": "04:18:48", "text": "戻ってくるよ。だって"}, {"type": "subtitle", "time": 15533.429, "timestamp": "04:18:53", "text": "今日はテストがあって、"}, {"type": "subtitle", "time": 15537.269, "timestamp": "04:18:57", "text": "午後6時から8時まで漢字のテストがあるんだ。それで、えっと、先生も、"}]
[{"type": "subtitle", "time": 6012.55, "timestamp": "01:40:12", "text": "あなたはとても世間知らずで"}, {"type": "subtitle", "time": 6030.709, "timestamp": "01:40:30", "text": "時々も。  [笑い] ちょっと"}, {"type": "subtitle", "time": 6035.99, "timestamp": "01:40:35", "text": "待って、押し倒すってどういう意味？ 待って、"}, {"type": "subtitle", "time": 6040.55, "timestamp": "01:40:40", "text": "押し倒すってどういう意味だったっけ？"}, {"type": "subtitle", "time": 6047.674, "timestamp": "01:40:47", "text": "簡単に人を操り、影響を与えたり、打ち負かしたりできる人。 ああ、そうだね"}, {"type": "subtitle", "time": 6049.27, "timestamp": "01:40:49", "text": "（笑）一言で言えば"}, {"type": "subtitle", "time": 6051.91, "timestamp": "01:40:51", "text": "意地悪だね。 ああ、なんて"}, {"type": "subtitle", "time": 6057.99, "timestamp": "01:40:57", "text": "愛らしいのでしょう。  「愛らしい」とはどういう意味ですか？"}]
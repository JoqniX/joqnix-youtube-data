[{"type": "subtitle", "time": 3061.99, "timestamp": "00:51:01", "text": "えーと、左左右"}, {"type": "subtitle", "time": 3064.79, "timestamp": "00:51:04", "text": "南、えーと、南、えーと、"}, {"type": "subtitle", "time": 3066.95, "timestamp": "00:51:06", "text": "これは、ええと、"}, {"type": "subtitle", "time": 3074.15, "timestamp": "00:51:14", "text": "東東東東、東はこうあるべきだと"}, {"type": "subtitle", "time": 3081.27, "timestamp": "00:51:21", "text": "思います。 ああ、なんてことだ、しくじってしまった。 そういうことなの"}, {"type": "subtitle", "time": 3084.309, "timestamp": "00:51:24", "text": "？ 忘れた。 何てことだ。 誰にも言わないで。"}, {"type": "subtitle", "time": 3088.549, "timestamp": "00:51:28", "text": "うん。 うん。 東東"}, {"type": "subtitle", "time": 3094.63, "timestamp": "00:51:34", "text": "有南。"}, {"type": "subtitle", "time": 3099.03, "timestamp": "00:51:39", "text": "待って、Westってどう書くの？  NI は"}, {"type": "subtitle", "time": 3105.75, "timestamp": "00:51:45", "text": "Nish West です。 さあ、次は東へ。 どうやって？ ああ"}, {"type": "subtitle", "time": 3107.589, "timestamp": "00:51:47", "text": "、昨日忘れてたよ（笑）"}, {"type": "subtitle", "time": 3115.27, "timestamp": "00:51:55", "text": "アヒ。"}, {"type": "subtitle", "time": 3117.829, "timestamp": "00:51:57", "text": "ああ、前のやつで間違えたのはそこだったんだ"}]
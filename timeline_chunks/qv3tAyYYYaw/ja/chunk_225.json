[{"type": "subtitle", "time": 13506.63, "timestamp": "03:45:06", "text": "ああ、 行く。待って、待って、待って、待って。Huは"}, {"type": "subtitle", "time": 13510.95, "timestamp": "03:45:10", "text": "裸です。ああ、午後はHuです。Yuは"}, {"type": "subtitle", "time": 13515.99, "timestamp": "03:45:15", "text": "夕方です。Yubは待って。Yuは夜です。Yubは夕方です。Assaは"}, {"type": "subtitle", "time": 13521.03, "timestamp": "03:45:21", "text": "朝です。"}, {"type": "subtitle", "time": 13537.75, "timestamp": "03:45:37", "text": "私は"}]
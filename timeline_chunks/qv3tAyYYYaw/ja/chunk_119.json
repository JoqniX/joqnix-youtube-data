[{"type": "subtitle", "time": 7144.87, "timestamp": "01:59:04", "text": "唯一良かったことは、"}, {"type": "subtitle", "time": 7149.91, "timestamp": "01:59:09", "text": "コラボレーション中に多くの人にそのモデルを見せられたことですね。 そして、"}, {"type": "subtitle", "time": 7154.79, "timestamp": "01:59:14", "text": "私を見捨てて裏切ったまさにその人たちですが、"}, {"type": "subtitle", "time": 7156.709, "timestamp": "01:59:16", "text": "彼らがモデルを暴露したり、あからさまに明らかにしたりしなかったことを嬉しく思います"}, {"type": "subtitle", "time": 7160.79, "timestamp": "01:59:20", "text": "。"}, {"type": "subtitle", "time": 7164.55, "timestamp": "01:59:24", "text": "ああ、彼らがそんなことをしなくてよかったよ。だって、そうしたら"}, {"type": "subtitle", "time": 7168.709, "timestamp": "01:59:28", "text": "たくさんの秘密保持契約に違反することになっただろうからね。"}, {"type": "subtitle", "time": 7173.109, "timestamp": "01:59:33", "text": "私は本当に大変なことになっていただろう。"}, {"type": "subtitle", "time": 7179.189, "timestamp": "01:59:39", "text": "彼らがあらゆることを心配するなら、私が人生で唯一喜んで処理できるのはそれだけだ"}, {"type": "subtitle", "time": 7196.95, "timestamp": "01:59:56", "text": "最近考えていたんだけど、"}, {"type": "subtitle", "time": 7199.75, "timestamp": "01:59:59", "text": "ドラマチックな出来事のせいで動画を作ったのに、"}]
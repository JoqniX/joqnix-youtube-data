[{"type": "subtitle", "time": 10143.269, "timestamp": "02:49:03", "text": "受け入れるつもりだ。そして明日か、"}, {"type": "subtitle", "time": 10146.87, "timestamp": "02:49:06", "text": "そう、今夜の授業が終わったら、それを続ける"}, {"type": "subtitle", "time": 10149.67, "timestamp": "02:49:09", "text": "。プラーシングの練習を続ける"}, {"type": "subtitle", "time": 10153.59, "timestamp": "02:49:13", "text": "。そうだ。まだある。"}, {"type": "subtitle", "time": 10157.19, "timestamp": "02:49:17", "text": "残りの漢字。そうですね。はい。"}, {"type": "subtitle", "time": 10164.309, "timestamp": "02:49:24", "text": "先生がまだ習わなければならない漢字がまだ残っています。ええ、"}, {"type": "subtitle", "time": 10168.71, "timestamp": "02:49:28", "text": "そして復習は"}, {"type": "subtitle", "time": 10172.15, "timestamp": "02:49:32", "text": "来週か今週だと思います。"}, {"type": "subtitle", "time": 10175.99, "timestamp": "02:49:35", "text": "試験が近づいているので、実際の復習です。"}, {"type": "subtitle", "time": 10178.95, "timestamp": "02:49:38", "text": "だから先生は試験対策の授業だけでなく復習の"}, {"type": "subtitle", "time": 10183.83, "timestamp": "02:49:43", "text": "授業もしなければなりません。だから"}, {"type": "subtitle", "time": 10186.667, "timestamp": "02:49:46", "text": "バカな"}, {"type": "subtitle", "time": 10187.83, "timestamp": "02:49:47", "text": "[ため息]"}, {"type": "subtitle", "time": 10189.99, "timestamp": "02:49:49", "text": "猿と私もやらなければならないんです"}, {"type": "subtitle", "time": 10192.55, "timestamp": "02:49:52", "text": "。"}]
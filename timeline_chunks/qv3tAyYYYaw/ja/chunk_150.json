[{"type": "subtitle", "time": 9004.07, "timestamp": "02:30:04", "text": "それから私はそれを失くしました"}, {"type": "subtitle", "time": 9006.309, "timestamp": "02:30:06", "text": "。 私は「そう、自分の"}, {"type": "subtitle", "time": 9019.03, "timestamp": "02:30:19", "text": "そう。"}, {"type": "subtitle", "time": 9020.79, "timestamp": "02:30:20", "text": "だから、私の"}, {"type": "subtitle", "time": 9023.19, "timestamp": "02:30:23", "text": "体は私の体。"}, {"type": "subtitle", "time": 9025.91, "timestamp": "02:30:25", "text": "大切にしなくてはならない」と思ったんです。"}, {"type": "subtitle", "time": 9029.51, "timestamp": "02:30:29", "text": "そして、私が司祭に無理やりアルコールを飲まされたり、その他いろいろなことが起こりました"}, {"type": "subtitle", "time": 9035.67, "timestamp": "02:30:35", "text": "。"}, {"type": "subtitle", "time": 9038.469, "timestamp": "02:30:38", "text": "ええ、たぶんその頃だったと思います。 その"}, {"type": "subtitle", "time": 9041.91, "timestamp": "02:30:41", "text": "時はそうだったと思う。 えーと、6番目、いや"}, {"type": "subtitle", "time": 9045.99, "timestamp": "02:30:45", "text": "7番目、8番目かな。 そう、"}, {"type": "subtitle", "time": 9048.71, "timestamp": "02:30:48", "text": "CBSは「Yeah」と呼ばれている。 そうするべきだった。"}, {"type": "subtitle", "time": 9051.11, "timestamp": "02:30:51", "text": "それがその時だと思う。 うん。"}, {"type": "subtitle", "time": 9054.07, "timestamp": "02:30:54", "text": "思春期。"}, {"type": "subtitle", "time": 9055.83, "timestamp": "02:30:55", "text": "そう、あの頃は、タバコを"}, {"type": "subtitle", "time": 9058.744, "timestamp": "02:30:58", "text": "吸ったり、紙でタバコを吸ったり"}]
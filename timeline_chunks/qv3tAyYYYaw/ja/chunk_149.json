[{"type": "subtitle", "time": 8941.03, "timestamp": "02:29:01", "text": "。"}, {"type": "subtitle", "time": 8942.95, "timestamp": "02:29:02", "text": "彼らは私が酒もタバコもやらないことを既に知っている"}, {"type": "subtitle", "time": 8945.75, "timestamp": "02:29:05", "text": "。 いいえ、そうではありません。 飲んだり、タバコを吸ったり、そういうことをする"}, {"type": "subtitle", "time": 8957.99, "timestamp": "02:29:17", "text": "15歳くらいの時にカナカのバーに入り、"}, {"type": "subtitle", "time": 8967.83, "timestamp": "02:29:27", "text": "18歳でそこを抜け出したんだ。よかったよ。"}, {"type": "subtitle", "time": 8970.23, "timestamp": "02:29:30", "text": "つまり、若い頃は全部試したと思う。だって、"}, {"type": "subtitle", "time": 8979.51, "timestamp": "02:29:39", "text": "周りに溶け込まなきゃいけなかったから。だって、教室で"}, {"type": "subtitle", "time": 8987.99, "timestamp": "02:29:47", "text": "一人ぼっちで座っている変な人だけがいるようなクラスで仲間外れになりたくなかったし、"}, {"type": "subtitle", "time": 8992.79, "timestamp": "02:29:52", "text": "周りに溶け込みたかったんだ。うん、だから"}, {"type": "subtitle", "time": 8997.429, "timestamp": "02:29:57", "text": "私もよくそうしてたよ"}, {"type": "subtitle", "time": 8999.03, "timestamp": "02:29:59", "text": "。"}]
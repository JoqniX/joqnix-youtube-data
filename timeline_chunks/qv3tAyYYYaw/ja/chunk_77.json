[{"type": "subtitle", "time": 4623.27, "timestamp": "01:17:03", "text": "ない。 おお。   わかりました、バックグラウンドで動作させておきます"}, {"type": "subtitle", "time": 4637.443, "timestamp": "01:17:17", "text": "あなたの言葉遣いはとても子供に優しいですね。"}, {"type": "subtitle", "time": 4639.43, "timestamp": "01:17:19", "text": "[笑い] それは"}, {"type": "subtitle", "time": 4643.189, "timestamp": "01:17:23", "text": "良い考えだと思います。 ただ、"}, {"type": "subtitle", "time": 4645.91, "timestamp": "01:17:25", "text": "汚い言葉とか、"}, {"type": "subtitle", "time": 4648.79, "timestamp": "01:17:28", "text": "人があまり悪態をつくのは嫌なんです。 私はそれを"}, {"type": "subtitle", "time": 4652.47, "timestamp": "01:17:32", "text": "持つ自由を手に入れたけれど、どうしたらいいのか分からない"}, {"type": "subtitle", "time": 4655.11, "timestamp": "01:17:35", "text": "。"}, {"type": "subtitle", "time": 4659.91, "timestamp": "01:17:39", "text": "他の人に不快な思いをさせたくないだけなんです。"}, {"type": "subtitle", "time": 4663.43, "timestamp": "01:17:43", "text": "チャットに子供を参加させたいですか？ いや、違うよ。"}, {"type": "subtitle", "time": 4665.75, "timestamp": "01:17:45", "text": "子供って本当に扱いが難しい。"}, {"type": "subtitle", "time": 4669.35, "timestamp": "01:17:49", "text": "正直言うと、"}, {"type": "subtitle", "time": 4671.59, "timestamp": "01:17:51", "text": "YouTubeで何人かの子供たちが私のところに来てくれたよ。"}]
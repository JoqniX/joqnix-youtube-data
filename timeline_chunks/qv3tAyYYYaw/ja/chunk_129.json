[{"type": "subtitle", "time": 7744.31, "timestamp": "02:09:04", "text": "人々がどう思うか分からないような気がします。"}, {"type": "subtitle", "time": 7747.27, "timestamp": "02:09:07", "text": "ええ、それは辛いです。"}, {"type": "subtitle", "time": 7750.31, "timestamp": "02:09:10", "text": "多くの人に広がって、"}, {"type": "subtitle", "time": 7754.629, "timestamp": "02:09:14", "text": "私が本当に交流したいと思っていた人たちがもう"}, {"type": "subtitle", "time": 7757.35, "timestamp": "02:09:17", "text": "私と交流してくれなくなってしまいました"}, {"type": "subtitle", "time": 7760.79, "timestamp": "02:09:20", "text": "。 私は一緒にコンテンツを作りたかったのであって、"}, {"type": "subtitle", "time": 7764.79, "timestamp": "02:09:24", "text": "私とやり取りしたくはなかった。 それは"}, {"type": "subtitle", "time": 7767.99, "timestamp": "02:09:27", "text": "辛いけど、まあ、そういうものだよね。"}, {"type": "subtitle", "time": 7771.03, "timestamp": "02:09:31", "text": "それから、慢性"}, {"type": "subtitle", "time": 7773.51, "timestamp": "02:09:33", "text": "都市を使うことを考えた。 私は「ああ、彼女も"}, {"type": "subtitle", "time": 7775.99, "timestamp": "02:09:35", "text": "ドラマとかそういうのを経験したんだよ」って思った"}, {"type": "subtitle", "time": 7779.03, "timestamp": "02:09:39", "text": "。 いいえ、その後、"}, {"type": "subtitle", "time": 7781.03, "timestamp": "02:09:41", "text": "彼女が"}, {"type": "subtitle", "time": 7785.75, "timestamp": "02:09:45", "text": "もっと有名になったとき、"}, {"type": "subtitle", "time": 7787.589, "timestamp": "02:09:47", "text": "彼女と話さなくなった人たちが"}, {"type": "subtitle", "time": 7790.47, "timestamp": "02:09:50", "text": "彼女と話すようになりました。 いいえ。だから、いつか私がうまくやって、"}, {"type": "subtitle", "time": 7797.03, "timestamp": "02:09:57", "text": "努力が報われて、"}, {"type": "subtitle", "time": 7799.189, "timestamp": "02:09:59", "text": "良い場所にたどり着いて、"}]
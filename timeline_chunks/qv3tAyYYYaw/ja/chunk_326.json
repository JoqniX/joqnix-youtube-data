[{"type": "subtitle", "time": 19583.67, "timestamp": "05:26:23", "text": "ああ、今日は何をすればいいんだ？"}, {"type": "subtitle", "time": 19590.628, "timestamp": "05:26:30", "text": "諦めたい気分だ。頭が"}, {"type": "subtitle", "time": 19593.75, "timestamp": "05:26:33", "text": "ひどく痛い。H"}, {"type": "subtitle", "time": 19597.67, "timestamp": "05:26:37", "text": "ちゃんと安定している。なぜ"}, {"type": "subtitle", "time": 19603.51, "timestamp": "05:26:43", "text": "ゲームをしたんだ？なぜやらなかったんだ"}, {"type": "subtitle", "time": 19607.59, "timestamp": "05:26:47", "text": "？なぜあまりやらなかったんだ？"}, {"type": "subtitle", "time": 19610.31, "timestamp": "05:26:50", "text": "君の えーと、日本語は間違いなく"}, {"type": "subtitle", "time": 19614.868, "timestamp": "05:26:54", "text": "私のデモより優れています。私は勉強も"}, {"type": "subtitle", "time": 19618.55, "timestamp": "05:26:58", "text": "復習もしていません。それが私を基礎レベルに引き戻し、"}]
[{"type": "subtitle", "time": 8880.309, "timestamp": "02:28:00", "text": "いろいろなものを見てきなさい」って言うんです。 外に出て、"}, {"type": "subtitle", "time": 8882.63, "timestamp": "02:28:02", "text": "外で食事をしたりしよう。 いつも"}, {"type": "subtitle", "time": 8886.469, "timestamp": "02:28:06", "text": "手作りの料理だけに頼ってはいけません。"}, {"type": "subtitle", "time": 8892.79, "timestamp": "02:28:12", "text": "でも、私は外出するのが面倒くさいんです。"}, {"type": "subtitle", "time": 8894.992, "timestamp": "02:28:14", "text": "だから、"}, {"type": "subtitle", "time": 8896.302, "timestamp": "02:28:16", "text": "[笑い]"}, {"type": "subtitle", "time": 8908.63, "timestamp": "02:28:28", "text": "彼らが望んでいるのは、私が"}, {"type": "subtitle", "time": 8915.349, "timestamp": "02:28:35", "text": "ええ、それが彼らが私に望んでいない唯一のことなんです"}, {"type": "subtitle", "time": 8923.11, "timestamp": "02:28:43", "text": "いとこって、いとこって、もうすでに"}, {"type": "subtitle", "time": 8925.91, "timestamp": "02:28:45", "text": "麻薬中毒者みたいな感じだよね。 彼らは"}, {"type": "subtitle", "time": 8934.469, "timestamp": "02:28:54", "text": "、だから"}, {"type": "subtitle", "time": 8936.55, "timestamp": "02:28:56", "text": "両親は私がそういうタイプの"}, {"type": "subtitle", "time": 8938.63, "timestamp": "02:28:58", "text": "友情関係に陥ることを望んでいないんです"}]
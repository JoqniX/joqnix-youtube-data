[{"type": "subtitle", "time": 9786.87, "timestamp": "02:43:06", "text": "ああ、"}, {"type": "subtitle", "time": 9794.15, "timestamp": "02:43:14", "text": "ゼロカーバナナアイスクリーム、"}, {"type": "subtitle", "time": 9798.79, "timestamp": "02:43:18", "text": "ギリシャヨーグルト、野菜2スクープ、"}, {"type": "subtitle", "time": 9802.07, "timestamp": "02:43:22", "text": "コーヒー2杯。うわあ[笑]"}, {"type": "subtitle", "time": 9805.11, "timestamp": "02:43:25", "text": "すごく美味しそう。"}, {"type": "subtitle", "time": 9811.59, "timestamp": "02:43:31", "text": "もし君みたいな人が"}, {"type": "subtitle", "time": 9814.07, "timestamp": "02:43:34", "text": "ルームメイトだったら、こういうの全部見て学んで、"}, {"type": "subtitle", "time": 9817.99, "timestamp": "02:43:37", "text": "自分でもやってみようと思う。ああ、"}, {"type": "subtitle", "time": 9822.23, "timestamp": "02:43:42", "text": "どんな"}, {"type": "subtitle", "time": 9824.389, "timestamp": "02:43:44", "text": "ルームメイトができるか、それとも"}, {"type": "subtitle", "time": 9827.11, "timestamp": "02:43:47", "text": "個室にするか、全然わからない。"}, {"type": "subtitle", "time": 9830.23, "timestamp": "02:43:50", "text": "先生も、"}, {"type": "subtitle", "time": 9834.95, "timestamp": "02:43:54", "text": "ルームメイトがいた方がいいって言ってた。個室じゃなくて。だって、"}, {"type": "subtitle", "time": 9838.309, "timestamp": "02:43:58", "text": "話をする相手が必要だから。そうじゃ"}]
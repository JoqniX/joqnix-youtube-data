[{"type": "subtitle", "time": 9060.309, "timestamp": "02:31:00", "text": "（笑いとため息）、私が試した馬鹿げたこと全部だった"}, {"type": "subtitle", "time": 9062.389, "timestamp": "02:31:02", "text": "。 おっと。"}, {"type": "subtitle", "time": 9065.51, "timestamp": "02:31:05", "text": "でも、そうですね、"}, {"type": "subtitle", "time": 9069.75, "timestamp": "02:31:09", "text": "10日頃から徐々にやめてしまいました。   いいえ。ええ。"}, {"type": "subtitle", "time": 9073.349, "timestamp": "02:31:13", "text": "プラス11日と12日。 いいえ、"}, {"type": "subtitle", "time": 9076.389, "timestamp": "02:31:16", "text": "10番目です。  11 12日。 うん。"}, {"type": "subtitle", "time": 9080.07, "timestamp": "02:31:20", "text": "待って、10番目って16くらいだよね？  11 12 は"}, {"type": "subtitle", "time": 9084.29, "timestamp": "02:31:24", "text": "18 です。ああ、私も今気づきました [笑い]"}, {"type": "subtitle", "time": 9095.51, "timestamp": "02:31:35", "text": "私が旅行とかに出かけたくなかった理由は、"}, {"type": "subtitle", "time": 9100.55, "timestamp": "02:31:40", "text": "あれこれ配信しなきゃいけないからだったんです。 私は"}, {"type": "subtitle", "time": 9103.75, "timestamp": "02:31:43", "text": "行動を起こさなければならなかった。 私は一貫性を保たなければならない。  [音楽] それら"}, {"type": "subtitle", "time": 9106.71, "timestamp": "02:31:46", "text": "全てです。 それが私の言い訳だったんだと"}, {"type": "subtitle", "time": 9109.99, "timestamp": "02:31:49", "text": "思う。"}, {"type": "subtitle", "time": 9113.27, "timestamp": "02:31:53", "text": "コミコンとかそういうのとかね。   今の時代、"}, {"type": "subtitle", "time": 9116.23, "timestamp": "02:31:56", "text": "両親は私に旅行に行くことを許してくれないと思う"}, {"type": "subtitle", "time": 9118.71, "timestamp": "02:31:58", "text": "。"}]
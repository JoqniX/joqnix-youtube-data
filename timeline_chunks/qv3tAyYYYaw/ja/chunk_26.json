[{"type": "subtitle", "time": 1564.07, "timestamp": "00:26:04", "text": "これも忘れてた。  [笑い]"}, {"type": "subtitle", "time": 1565.669, "timestamp": "00:26:05", "text": "えーと、"}, {"type": "subtitle", "time": 1580.789, "timestamp": "00:26:20", "text": "マクマンです。"}, {"type": "subtitle", "time": 1583.029, "timestamp": "00:26:23", "text": "こんにちは。"}, {"type": "subtitle", "time": 1587.11, "timestamp": "00:26:27", "text": "それからこれは私のシートで、毎週毎日"}, {"type": "subtitle", "time": 1592.313, "timestamp": "00:26:32", "text": "私の"}, {"type": "subtitle", "time": 1595.19, "timestamp": "00:26:35", "text": "[音楽]のことです。そしてこれは"}, {"type": "subtitle", "time": 1609.669, "timestamp": "00:26:49", "text": "言語でした。"}]
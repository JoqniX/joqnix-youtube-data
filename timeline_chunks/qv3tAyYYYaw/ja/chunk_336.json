[{"type": "subtitle", "time": 20161.91, "timestamp": "05:36:01", "text": "明日も復習して、明後日も復習して、"}, {"type": "subtitle", "time": 20167.51, "timestamp": "05:36:07", "text": "復習しないとゲームとか[笑い]とかするんだ。"}, {"type": "subtitle", "time": 20170.548, "timestamp": "05:36:10", "text": "少なくとも1つ、少なくとも"}, {"type": "subtitle", "time": 20173.19, "timestamp": "05:36:13", "text": "漢字をやらなきゃ。それが全てなんだ。少なくとも"}, {"type": "subtitle", "time": 20182.868, "timestamp": "05:36:22", "text": "あと、アンカってどうやって使うんだっけ。ちょっと待って、"}, {"type": "subtitle", "time": 20191.91, "timestamp": "05:36:31", "text": "ウェブを開いてみる。アカウント持ってるかな？持ってると思う。"}, {"type": "subtitle", "time": 20194.23, "timestamp": "05:36:34", "text": "ログインする"}]
[{"type": "subtitle", "time": 9483.03, "timestamp": "02:38:03", "text": "「ジョックとかと話すには、あなたはあまりにも気楽すぎるよ"}, {"type": "subtitle", "time": 9486.309, "timestamp": "02:38:06", "text": "。たった"}, {"type": "subtitle", "time": 9492.23, "timestamp": "02:38:12", "text": "1時間"}, {"type": "subtitle", "time": 9493.99, "timestamp": "02:38:13", "text": "前に会ったばかりなのに、まるで昔の友達みたいだ」って言われたことがある。"}, {"type": "subtitle", "time": 9502.469, "timestamp": "02:38:22", "text": "守らなきゃいけない。"}, {"type": "subtitle", "time": 9504.71, "timestamp": "02:38:24", "text": "それに、"}, {"type": "subtitle", "time": 9507.67, "timestamp": "02:38:27", "text": "境界線とか知り合いとか"}, {"type": "subtitle", "time": 9515.75, "timestamp": "02:38:35", "text": "セラピストが、"}, {"type": "subtitle", "time": 9520.07, "timestamp": "02:38:40", "text": "そういう内輪のことを"}, {"type": "subtitle", "time": 9524.07, "timestamp": "02:38:44", "text": "時間をかけて練習するように言っていたのに、私はそれを外に放り出してしまった"}, {"type": "subtitle", "time": 9527.51, "timestamp": "02:38:47", "text": "。それでこうなったんだ。あの時"}]
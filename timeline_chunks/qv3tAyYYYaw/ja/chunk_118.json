[{"type": "subtitle", "time": 7093.03, "timestamp": "01:58:13", "text": "。 君にはそれが必要なんだ。 こんにちは。"}, {"type": "subtitle", "time": 7094.55, "timestamp": "01:58:14", "text": "あなたは自分のコンテンツについて考える時間を減らし、"}, {"type": "subtitle", "time": 7099.75, "timestamp": "01:58:19", "text": "コンテンツ以外のあらゆることについて考える時間を増やすつもりですか？ うん。 はい、そうしています。"}, {"type": "subtitle", "time": 7101.91, "timestamp": "01:58:21", "text": "今日も、どうやって"}, {"type": "subtitle", "time": 7105.35, "timestamp": "01:58:25", "text": "コンサートをやろうかと考えています。 私はどうやって音楽を作ればいいのでしょうか？"}, {"type": "subtitle", "time": 7108.07, "timestamp": "01:58:28", "text": "アルバムはどのようにリリースすればいいですか？ どうすれば"}, {"type": "subtitle", "time": 7111.51, "timestamp": "01:58:31", "text": "音楽をリリースできるのでしょうか？"}, {"type": "subtitle", "time": 7114.709, "timestamp": "01:58:34", "text": "私にそれができる能力があるのだろうか？"}, {"type": "subtitle", "time": 7117.51, "timestamp": "01:58:37", "text": "もし失敗したらどうなる？ あれこれの期待、"}, {"type": "subtitle", "time": 7121.189, "timestamp": "01:58:41", "text": "モデルって何が"}, {"type": "subtitle", "time": 7125.75, "timestamp": "01:58:45", "text": "起こるんだろう、アーティストは"}, {"type": "subtitle", "time": 7129.03, "timestamp": "01:58:49", "text": "私と話をしてくれるのかな、"}, {"type": "subtitle", "time": 7131.83, "timestamp": "01:58:51", "text": "私を見捨てるのかな、などなど、期待をはるかに超えています。"}]
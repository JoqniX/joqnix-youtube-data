[{"type": "subtitle", "time": 8342.79, "timestamp": "02:19:02", "text": "自分にもドリモンが欲しかったのですが、"}, {"type": "subtitle", "time": 8345.27, "timestamp": "02:19:05", "text": "ドリモンは実在しないし、私を助けてくれる親友のような存在として私のところに来てくれることも"}, {"type": "subtitle", "time": 8348.629, "timestamp": "02:19:08", "text": "ないということに気づいて、"}, {"type": "subtitle", "time": 8354.629, "timestamp": "02:19:14", "text": "ああ、私は一人ぼっちなんだと悟りました。 私は"}, {"type": "subtitle", "time": 8357.349, "timestamp": "02:19:17", "text": "自分の人生を生きなければならない。   そうしないといけない"}, {"type": "subtitle", "time": 8371.99, "timestamp": "02:19:31", "text": "つまり、試験に"}, {"type": "subtitle", "time": 8373.509, "timestamp": "02:19:33", "text": "合格するのに2時間以上かかるビジネスコースの科目で、"}, {"type": "subtitle", "time": 8383.429, "timestamp": "02:19:43", "text": "実際にお金を稼げる場所ならわかるよ"}, {"type": "subtitle", "time": 8386.309, "timestamp": "02:19:46", "text": "。"}]
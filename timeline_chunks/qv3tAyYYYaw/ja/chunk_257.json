[{"type": "subtitle", "time": 15430.79, "timestamp": "04:17:10", "text": "待って、その漢字は何ですか？私はその漢字を知っています"}, {"type": "subtitle", "time": 15446.79, "timestamp": "04:17:26", "text": "それからハン ハン。"}, {"type": "subtitle", "time": 15451.349, "timestamp": "04:17:31", "text": "待って、待って。私はこれを知っています。ああ、私たちは"}, {"type": "subtitle", "time": 15453.67, "timestamp": "04:17:33", "text": "昨日これを見逃しました。"}]
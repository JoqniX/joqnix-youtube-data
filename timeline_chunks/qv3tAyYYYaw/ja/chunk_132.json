[{"type": "subtitle", "time": 7946.229, "timestamp": "02:12:26", "text": "プレイなしプレイなしプレイなし普通の"}, {"type": "subtitle", "time": 7947.99, "timestamp": "02:12:27", "text": "人のゲームチャレンジ[笑い]"}, {"type": "subtitle", "time": 7952.31, "timestamp": "02:12:32", "text": "普通の人のゲームって何？"}, {"type": "subtitle", "time": 7958.629, "timestamp": "02:12:38", "text": "トゥーン。 あ、待って。 それらはNintendo Switchの"}, {"type": "subtitle", "time": 7961.589, "timestamp": "02:12:41", "text": "ゲームです。 私はそれらをプレイできません。 私はNintendo"}, {"type": "subtitle", "time": 7963.99, "timestamp": "02:12:43", "text": "Switchのゲームをプレイしたいです。 マリオカートとか、そういうやつだよ"}]
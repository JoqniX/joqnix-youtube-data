[{"type": "subtitle", "time": 8580.95, "timestamp": "02:23:00", "text": "MMOゲームで私がやるのと同じようなものですよ"}, {"type": "subtitle", "time": 8584.309, "timestamp": "02:23:04", "text": "ね？  MMOゲームって、"}, {"type": "subtitle", "time": 8585.99, "timestamp": "02:23:05", "text": "クエストをこなしたり、NPCと話したり"}, {"type": "subtitle", "time": 8588.95, "timestamp": "02:23:08", "text": "、タスクをこなしたりしないと、あれこれ報酬がもらえないんですよね"}, {"type": "subtitle", "time": 8590.87, "timestamp": "02:23:10", "text": "？ それと同じように、私は"}, {"type": "subtitle", "time": 8594.55, "timestamp": "02:23:14", "text": "ただ人々と話し続け、"}, {"type": "subtitle", "time": 8598.389, "timestamp": "02:23:18", "text": "彼らの経験を学び、それが"}, {"type": "subtitle", "time": 8601.19, "timestamp": "02:23:21", "text": "人生を学ぶ方法だと理解する必要があるのです。 これは"}, {"type": "subtitle", "time": 8604.169, "timestamp": "02:23:24", "text": "MMOですらない。 おいおい、"}, {"type": "subtitle", "time": 8605.75, "timestamp": "02:23:25", "text": "[笑い]"}, {"type": "subtitle", "time": 8619.429, "timestamp": "02:23:39", "text": "ファイナルファンタジー14をプレイするのが懐かしい。ああ、あれは本当に"}, {"type": "subtitle", "time": 8622.23, "timestamp": "02:23:42", "text": "楽しかった。"}, {"type": "subtitle", "time": 8623.91, "timestamp": "02:23:43", "text": "人生を学びたければ、"}, {"type": "subtitle", "time": 8626.469, "timestamp": "02:23:46", "text": "人生を生きなければならない。 うん。   色々な"}, {"type": "subtitle", "time": 8634.87, "timestamp": "02:23:54", "text": "それで、D は"}]
[{"type": "subtitle", "time": 542.07, "timestamp": "00:09:02", "text": "こんにちは。 とにかく、えーと次は、えーと、"}, {"type": "subtitle", "time": 545.03, "timestamp": "00:09:05", "text": "今日は時間がなくなってきました。午後6時です。"}, {"type": "subtitle", "time": 548.31, "timestamp": "00:09:08", "text": "テスト授業は今日から"}, {"type": "subtitle", "time": 551.59, "timestamp": "00:09:11", "text": "6時から8時までです。幸運を祈ってください。 はい、"}, {"type": "subtitle", "time": 553.75, "timestamp": "00:09:13", "text": "復習テストだということは分かっていますが、"}, {"type": "subtitle", "time": 562.389, "timestamp": "00:09:22", "text": "復習していないので授業についていけなくなっています。"}, {"type": "subtitle", "time": 565.35, "timestamp": "00:09:25", "text": "ダイオードが遅れをとるのは避けたい。"}, {"type": "subtitle", "time": 568.55, "timestamp": "00:09:28", "text": "私は全力を尽くしただろうか？"}, {"type": "chat", "time": 570.293, "timestamp": "00:09:30", "author": "@ArusuAraeru", "avatar": "https://yt4.ggpht.com/Dc2GWSBeOIoWoV_Yu1KJZ8Rd0EIvVX2NE8TZKOPigrbOXUH6MSPklyA0oUxTSJrKKkxsV3rdQA=s64-c-k-c0x00ffffff-no-rj", "message": "Ganbatte nee"}, {"type": "subtitle", "time": 572.949, "timestamp": "00:09:32", "text": "280字の漢字を全部覚えていますか？"}, {"type": "subtitle", "time": 576.63, "timestamp": "00:09:36", "text": "N5からは100、N4からは180。 よし。 では、"}, {"type": "subtitle", "time": 584.23, "timestamp": "00:09:44", "text": "N5 の方にざっと目を通します。 わかった。"}, {"type": "subtitle", "time": 591.829, "timestamp": "00:09:51", "text": "それで、私たちはカまで終わりました。"}, {"type": "subtitle", "time": 594.949, "timestamp": "00:09:54", "text": "ええ、昨日まで"}, {"type": "subtitle", "time": 599.19, "timestamp": "00:09:59", "text": "執筆作業を終えました。 次はimaです。 わかりました、では順を追って説明します"}]
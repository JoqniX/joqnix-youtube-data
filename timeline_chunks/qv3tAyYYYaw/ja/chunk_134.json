[{"type": "subtitle", "time": 8047.589, "timestamp": "02:14:07", "text": "もそれで大丈夫だと言っています。 私はもう"}, {"type": "subtitle", "time": 8049.91, "timestamp": "02:14:09", "text": "日本に行く予定です。 だから、たくさんの"}, {"type": "subtitle", "time": 8053.03, "timestamp": "02:14:13", "text": "電子機器は持っていけないんです。"}, {"type": "subtitle", "time": 8088.39, "timestamp": "02:14:48", "text": "今日、日本は経済破綻を経験した。"}, {"type": "subtitle", "time": 8092.39, "timestamp": "02:14:52", "text": "ええ、それも本当ですね。"}, {"type": "subtitle", "time": 8094.31, "timestamp": "02:14:54", "text": "ああ、本当にたくさんのことがある"}, {"type": "subtitle", "time": 8098.87, "timestamp": "02:14:58", "text": "。 うん。 でも、"}]
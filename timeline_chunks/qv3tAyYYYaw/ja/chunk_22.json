[{"type": "subtitle", "time": 1328.149, "timestamp": "00:22:08", "text": "今や（音楽の）怪我人だ。"}, {"type": "subtitle", "time": 1341.669, "timestamp": "00:22:21", "text": "これは、この 3 つのことが考えられていました。"}, {"type": "subtitle", "time": 1344.149, "timestamp": "00:22:24", "text": "これは最近 4 つのクラスで考えられましたが、"}, {"type": "subtitle", "time": 1347.51, "timestamp": "00:22:27", "text": "M が最後の 1 つでした。これも"}, {"type": "subtitle", "time": 1350.549, "timestamp": "00:22:30", "text": "最後に説明します。今のところ、"}, {"type": "subtitle", "time": 1357.43, "timestamp": "00:22:37", "text": "大まかに説明していますが、大丈夫です。ええ、"}, {"type": "subtitle", "time": 1359.909, "timestamp": "00:22:39", "text": "これらすべてを書き留めることを覚えておかなければなりません。"}, {"type": "subtitle", "time": 1362.549, "timestamp": "00:22:42", "text": "待って、これ全部で100個だと思う？"}, {"type": "subtitle", "time": 1364.63, "timestamp": "00:22:44", "text": "これが本当に"}, {"type": "subtitle", "time": 1367.35, "timestamp": "00:22:47", "text": "100"}, {"type": "subtitle", "time": 1369.19, "timestamp": "00:22:49", "text": "メートルだとは、ちょっと信じられません。"}, {"type": "subtitle", "time": 1373.59, "timestamp": "00:22:53", "text": "本当に100ですか？"}]
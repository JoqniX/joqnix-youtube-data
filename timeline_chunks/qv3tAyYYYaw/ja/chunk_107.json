[{"type": "subtitle", "time": 6423.43, "timestamp": "01:47:03", "text": "マチマチ。 それで、漢字って何でしたっけ？"}, {"type": "subtitle", "time": 6437.35, "timestamp": "01:47:17", "text": "ああ、スピリットは登録者数2000人突破"}, {"type": "subtitle", "time": 6440.87, "timestamp": "01:47:20", "text": "記念の配信をしていたよ。 私も加わって、"}, {"type": "subtitle", "time": 6447.75, "timestamp": "01:47:27", "text": "私は時々『スピリット』を観ます。 ただ、"}, {"type": "subtitle", "time": 6458.07, "timestamp": "01:47:38", "text": "私はオレンジ社とそれについて話しましたが、"}, {"type": "subtitle", "time": 6460.07, "timestamp": "01:47:40", "text": "大丈夫だと言いました。 誰とでも自由にチャットできます"}, {"type": "subtitle", "time": 6462.229, "timestamp": "01:47:42", "text": "。 あまり心配しなくていいよ、スポーツ"}, {"type": "subtitle", "time": 6476.95, "timestamp": "01:47:56", "text": "全部見ていますよ。"}]
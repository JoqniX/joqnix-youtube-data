[{"type": "subtitle", "time": 7983.189, "timestamp": "02:13:03", "text": "レースゲーム。 ええと、私はNeo Speed Under"}, {"type": "subtitle", "time": 7986.229, "timestamp": "02:13:06", "text": "Undergroundを持っています。 いいえ、underではなくunderです。 あの"}, {"type": "subtitle", "time": 7989.03, "timestamp": "02:13:09", "text": "緑色の物体って何だっけ？   ああ"}, {"type": "subtitle", "time": 7992.229, "timestamp": "02:13:12", "text": "、すごく高いお金を出して買ったのに、最後まで読み終えることもできなかった"}, {"type": "subtitle", "time": 7995.51, "timestamp": "02:13:15", "text": "。"}, {"type": "subtitle", "time": 7999.03, "timestamp": "02:13:19", "text": "最近のものではない。 それは最近のことですか？ 新しい"}, {"type": "subtitle", "time": 8008.95, "timestamp": "02:13:28", "text": "私はその一部、いくつかの"}, {"type": "subtitle", "time": 8011.75, "timestamp": "02:13:31", "text": "物語をプレイしましたが、その後はもうそれを非難するのをやめました"}, {"type": "subtitle", "time": 8013.669, "timestamp": "02:13:33", "text": "。"}, {"type": "subtitle", "time": 8016.629, "timestamp": "02:13:36", "text": "ええ、ちょうどその頃、私のゲーム用PCが壊れてしまったんです。"}, {"type": "subtitle", "time": 8018.629, "timestamp": "02:13:38", "text": "だから私は「もう"}, {"type": "subtitle", "time": 8020.55, "timestamp": "02:13:40", "text": "人生は終わりだ。もう"}, {"type": "subtitle", "time": 8023.189, "timestamp": "02:13:43", "text": "ゲームなんていらない」と思ったんです。 その瞬間が訪れた"}]
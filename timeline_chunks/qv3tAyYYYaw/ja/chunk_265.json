[{"type": "subtitle", "time": 15900.79, "timestamp": "04:25:00", "text": "クレジットスコア。いや、"}, {"type": "subtitle", "time": 15904.229, "timestamp": "04:25:04", "text": "[音楽]"}, {"type": "subtitle", "time": 15911.75, "timestamp": "04:25:11", "text": "ビザを更新する必要があるんですよね。例えば、ちゃんとした学位、学位じゃなくて、ちゃんとした仕事、"}, {"type": "subtitle", "time": 15925.99, "timestamp": "04:25:25", "text": "例えば法律関係の仕事とか、法学生とか、"}, {"type": "subtitle", "time": 15927.75, "timestamp": "04:25:27", "text": "法学の学位とかがあれば、"}, {"type": "subtitle", "time": 15931.189, "timestamp": "04:25:31", "text": "仕事に就いたり、"}, {"type": "subtitle", "time": 15933.91, "timestamp": "04:25:33", "text": "修士課程に進んだりできるんですよね。"}, {"type": "subtitle", "time": 15938.07, "timestamp": "04:25:38", "text": "でも、私の場合は、"}, {"type": "subtitle", "time": 15940.389, "timestamp": "04:25:40", "text": "IGNO 1 では足りません。3"}, {"type": "subtitle", "time": 15942.79, "timestamp": "04:25:42", "text": "年しかないので、"}, {"type": "subtitle", "time": 15948.469, "timestamp": "04:25:48", "text": "3 年ある日本の大学に編入して、さらに 1 年勉強して"}, {"type": "subtitle", "time": 15952.71, "timestamp": "04:25:52", "text": "4 年になるか、最初からやり直して 4 年ある"}, {"type": "subtitle", "time": 15954.79, "timestamp": "04:25:54", "text": "大学に通うか、"}, {"type": "subtitle", "time": 15957.91, "timestamp": "04:25:57", "text": "クレジット"}]
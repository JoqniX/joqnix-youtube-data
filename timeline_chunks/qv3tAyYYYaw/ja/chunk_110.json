[{"type": "subtitle", "time": 6604.55, "timestamp": "01:50:04", "text": "なぜ私は傷つけるのに、それを見せなければならないのか？ え、何？ 私はその後、"}, {"type": "subtitle", "time": 6606.709, "timestamp": "01:50:06", "text": "彼らとは一切関わりを持たなかった。 何？"}, {"type": "subtitle", "time": 6611.03, "timestamp": "01:50:11", "text": "いいえ、全部ブロックしています。"}, {"type": "subtitle", "time": 6614.149, "timestamp": "01:50:14", "text": "私が挙げた名前の人物は全員、私が"}, {"type": "subtitle", "time": 6617.669, "timestamp": "01:50:17", "text": "ブロックしたはずです"}, {"type": "subtitle", "time": 6619.669, "timestamp": "01:50:19", "text": "。   そのうちのいくつかはミュートにした"}, {"type": "subtitle", "time": 6623.189, "timestamp": "01:50:23", "text": "。"}, {"type": "subtitle", "time": 6630.229, "timestamp": "01:50:30", "text": "私が交流したのはアストラだけで、あとは"}, {"type": "subtitle", "time": 6637.109, "timestamp": "01:50:37", "text": "コラボ企画でジャスミンとヨシャンと交流しました。"}, {"type": "subtitle", "time": 6641.03, "timestamp": "01:50:41", "text": "ハロウィンパーティーで、"}, {"type": "subtitle", "time": 6643.75, "timestamp": "01:50:43", "text": "アストラ、ジャスミン、ヨシャンの3人で"}, {"type": "subtitle", "time": 6653.99, "timestamp": "01:50:53", "text": "スーリヤウンも私の配信に来てくれます。 ああ、"}, {"type": "subtitle", "time": 6658.149, "timestamp": "01:50:58", "text": "スーリヤ。 そしてオレンジスピリット。   では、"}]
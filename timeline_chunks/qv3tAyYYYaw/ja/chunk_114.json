[{"type": "subtitle", "time": 6852.229, "timestamp": "01:54:12", "text": "について考えていたんです"}, {"type": "subtitle", "time": 6855.83, "timestamp": "01:54:15", "text": "。 だから"}, {"type": "subtitle", "time": 6858.149, "timestamp": "01:54:18", "text": "昨日言ったように、"}, {"type": "subtitle", "time": 6860.87, "timestamp": "01:54:20", "text": "昨日の朝の配信をするのは少し気が進まなかったんです。なぜなら、突然"}, {"type": "subtitle", "time": 6866.95, "timestamp": "01:54:26", "text": "過去のツイートをいくつか見てしまったからです。 それは私に、起こった出来事について"}, {"type": "subtitle", "time": 6870.39, "timestamp": "01:54:30", "text": "多くのことを考えさせるきっかけとなった"}, {"type": "subtitle", "time": 6872.39, "timestamp": "01:54:32", "text": "。"}, {"type": "subtitle", "time": 6874.79, "timestamp": "01:54:34", "text": "実は、「ああ、"}, {"type": "subtitle", "time": 6879.03, "timestamp": "01:54:39", "text": "最近あまり人と話していないな」って考えていたんです。"}, {"type": "subtitle", "time": 6882.629, "timestamp": "01:54:42", "text": "私はもう、まるで自分の"}, {"type": "subtitle", "time": 6887.83, "timestamp": "01:54:47", "text": "洞窟に閉じこもっているような状態です。"}, {"type": "subtitle", "time": 6894.629, "timestamp": "01:54:54", "text": "良い点もあれば悪い点もあります"}, {"type": "subtitle", "time": 6897.91, "timestamp": "01:54:57", "text": "。 人と話すのは楽しい。"}, {"type": "subtitle", "time": 6899.99, "timestamp": "01:54:59", "text": "それに、今は話をする相手もあまりいないんです"}]
[{"type": "subtitle", "time": 4680.149, "timestamp": "01:18:00", "text": "中には、ずっと前から少し迷惑だったものもあった"}, {"type": "subtitle", "time": 4681.91, "timestamp": "01:18:01", "text": "。 わかった。 彼らが"}, {"type": "subtitle", "time": 4692.55, "timestamp": "01:18:12", "text": "最初は、"}, {"type": "subtitle", "time": 4703.43, "timestamp": "01:18:23", "text": "。 ある意味、私は"}, {"type": "subtitle", "time": 4705.669, "timestamp": "01:18:25", "text": "自分のコンテンツをあらゆる"}, {"type": "subtitle", "time": 4707.59, "timestamp": "01:18:27", "text": "年齢層が楽しめるものにしたかったのです。"}, {"type": "subtitle", "time": 4709.27, "timestamp": "01:18:29", "text": "あなたが子供であろうと、"}, {"type": "subtitle", "time": 4712.95, "timestamp": "01:18:32", "text": "若者であろうと、大人であろうと、十代であろうと、"}, {"type": "subtitle", "time": 4716.229, "timestamp": "01:18:36", "text": "高齢者であろうと、何"}, {"type": "subtitle", "time": 4719.669, "timestamp": "01:18:39", "text": "歳であろうと、もし誰かが"}, {"type": "subtitle", "time": 4723.43, "timestamp": "01:18:43", "text": "それを面白いと思うなら、"}, {"type": "subtitle", "time": 4727.75, "timestamp": "01:18:47", "text": "制限されたくありません。なぜなら、"}, {"type": "subtitle", "time": 4731.91, "timestamp": "01:18:51", "text": "私自身は"}, {"type": "subtitle", "time": 4738.47, "timestamp": "01:18:58", "text": "うっかり声に出して言わない限り、あまり悪態をつかないからです。 えっと、"}]
[{"type": "subtitle", "time": 15961.83, "timestamp": "04:26:01", "text": "スコアが足りなくなるので、今なら"}, {"type": "subtitle", "time": 15968.87, "timestamp": "04:26:08", "text": "2 年"}, {"type": "subtitle", "time": 15983.67, "timestamp": "04:26:23", "text": "30 歳くらいになってる。"}, {"type": "subtitle", "time": 15986.469, "timestamp": "04:26:26", "text": "何だって？"}, {"type": "subtitle", "time": 15989.349, "timestamp": "04:26:29", "text": "年寄りになる。ディオだけじゃない、いや、"}, {"type": "subtitle", "time": 15991.99, "timestamp": "04:26:31", "text": "みんなにとって、多くの人が"}, {"type": "subtitle", "time": 15994.55, "timestamp": "04:26:34", "text": "新しい バッチと"}, {"type": "subtitle", "time": 15997.349, "timestamp": "04:26:37", "text": "バッチ[音楽]の人たちは、1人を除いて"}, {"type": "subtitle", "time": 15999.67, "timestamp": "04:26:39", "text": "直接仕事が決まったから。"}, {"type": "subtitle", "time": 16001.83, "timestamp": "04:26:41", "text": "直接仕事の"}, {"type": "subtitle", "time": 16006.229, "timestamp": "04:26:46", "text": "オファーを受けて仕事に就くんだ。全員を除いてね。"}, {"type": "subtitle", "time": 16008.71, "timestamp": "04:26:48", "text": "えっと、"}, {"type": "subtitle", "time": 16010.79, "timestamp": "04:26:50", "text": "そこに着く頃には30歳になるってこと？どんな？私にとっては？うん、"}, {"type": "subtitle", "time": 16014.07, "timestamp": "04:26:54", "text": "全部終わる頃には30歳になるよ。2"}, {"type": "subtitle", "time": 16017.189, "timestamp": "04:26:57", "text": "年間の語学コースと4年間の"}]
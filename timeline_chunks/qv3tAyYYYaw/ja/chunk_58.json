[{"type": "subtitle", "time": 3480.549, "timestamp": "00:58:00", "text": "鳥に。"}, {"type": "subtitle", "time": 3482.87, "timestamp": "00:58:02", "text": "えっと、自分の書き方が"}, {"type": "subtitle", "time": 3489.829, "timestamp": "00:58:09", "text": "。 それを拡張してください。"}, {"type": "subtitle", "time": 3532.87, "timestamp": "00:58:52", "text": "。 それはサック、サック、あるいは何かそんな感じのものです"}, {"type": "subtitle", "time": 3537.19, "timestamp": "00:58:57", "text": "。 忘れた。 どうですか"}, {"type": "subtitle", "time": 3538.71, "timestamp": "00:58:58", "text": "？"}]
[{"type": "subtitle", "time": 11355.99, "timestamp": "03:09:15", "text": "。私のモニターは今、すごく壊れてるんだ。"}, {"type": "subtitle", "time": 11358.469, "timestamp": "03:09:18", "text": "点滅して、線が"}, {"type": "subtitle", "time": 11360.87, "timestamp": "03:09:20", "text": "表示されているみたい。"}, {"type": "subtitle", "time": 11363.99, "timestamp": "03:09:23", "text": "心配するべき？私が ここ"}, {"type": "subtitle", "time": 11369.59, "timestamp": "03:09:29", "text": "一週間モニターの電源を切ってないんだ。それが"}, {"type": "subtitle", "time": 11373.269, "timestamp": "03:09:33", "text": "原因かな？"}, {"type": "subtitle", "time": 11375.67, "timestamp": "03:09:35", "text": "どうして240Hzのモニターは"}, {"type": "subtitle", "time": 11379.269, "timestamp": "03:09:39", "text": "壊れなかったのに、どうして165の安い"}]
[{"type": "subtitle", "time": 4862.39, "timestamp": "01:21:02", "text": "モデレーターみたいなものだから大丈夫だよ。"}, {"type": "subtitle", "time": 4866.31, "timestamp": "01:21:06", "text": "いつも不思議に思うのですが、彼らはどうやってあんなに"}, {"type": "subtitle", "time": 4869.669, "timestamp": "01:21:09", "text": "流暢に配信しているのでしょうか？   私の言いたいこと、分かりますか"}, {"type": "subtitle", "time": 4872.31, "timestamp": "01:21:12", "text": "？ なぜあんなに"}, {"type": "subtitle", "time": 4874.63, "timestamp": "01:21:14", "text": "スムーズにストリーミングできるのでしょうか？"}, {"type": "subtitle", "time": 4878.07, "timestamp": "01:21:18", "text": "うん、彼がデュアル"}, {"type": "subtitle", "time": 4879.99, "timestamp": "01:21:19", "text": "ピースのセットアップ、トリプルピースのセットアップを持っていることは知っている"}, {"type": "subtitle", "time": 4881.91, "timestamp": "01:21:21", "text": "けど、"}, {"type": "subtitle", "time": 4884.149, "timestamp": "01:21:24", "text": "うん、"}, {"type": "subtitle", "time": 4891.43, "timestamp": "01:21:31", "text": "そうですね、品質は"}, {"type": "subtitle", "time": 4899.59, "timestamp": "01:21:39", "text": "私もそういうことをやってみたかったんです"}, {"type": "subtitle", "time": 4903.35, "timestamp": "01:21:43", "text": "。 つまり、以前は持っていたのですが、"}, {"type": "subtitle", "time": 4907.27, "timestamp": "01:21:47", "text": "今はもう2つのピースが売りに出されています。   つまり、"}, {"type": "subtitle", "time": 4913.51, "timestamp": "01:21:53", "text": "品質の面で、という意味で、という意味だったのですが、それは"}, {"type": "subtitle", "time": 4916.95, "timestamp": "01:21:56", "text": "本当に良かったです。  「"}]
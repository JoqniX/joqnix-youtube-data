[{"type": "subtitle", "time": 8762.07, "timestamp": "02:26:02", "text": "。   わかった"}, {"type": "subtitle", "time": 8779.27, "timestamp": "02:26:19", "text": "実生活での経験が足りない気がする"}, {"type": "subtitle", "time": 8787.429, "timestamp": "02:26:27", "text": "実生活での経験という点で。"}, {"type": "subtitle", "time": 8790.23, "timestamp": "02:26:30", "text": "ええ、それも私が"}, {"type": "subtitle", "time": 8793.75, "timestamp": "02:26:33", "text": "過保護に育てられすぎていることの一因ですね。 これだけは言えると思う"}, {"type": "subtitle", "time": 8796.95, "timestamp": "02:26:36", "text": "。 えっと、私が"}, {"type": "subtitle", "time": 8801.429, "timestamp": "02:26:41", "text": "プネーコミコンに行ったとき、あのYouTuberたち、つまり"}, {"type": "subtitle", "time": 8803.91, "timestamp": "02:26:43", "text": "メインのYouTuberたちは、"}, {"type": "subtitle", "time": 8809.11, "timestamp": "02:26:49", "text": "あれこれ話したり交流したり、冗談を言ったり、"}, {"type": "subtitle", "time": 8812.309, "timestamp": "02:26:52", "text": "笑ったりしていました。 私だけがぎこちなかった"}, {"type": "subtitle", "time": 8813.771, "timestamp": "02:26:53", "text": "。  [笑い声]"}, {"type": "subtitle", "time": 8816.469, "timestamp": "02:26:56", "text": "[息を呑む音] 彼らが笑っているとき、私は仲間外れにされたくなかったので、ぎこちなく"}, {"type": "subtitle", "time": 8819.83, "timestamp": "02:26:59", "text": "笑いました"}]
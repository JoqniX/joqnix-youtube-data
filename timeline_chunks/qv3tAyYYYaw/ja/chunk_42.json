[{"type": "subtitle", "time": 2520.47, "timestamp": "00:42:00", "text": "心を落ち着かせてください。 つまり、"}, {"type": "subtitle", "time": 2525.349, "timestamp": "00:42:05", "text": "何か重要なこととか、そういう時はいつもすごく不安になるんです。"}, {"type": "subtitle", "time": 2528.95, "timestamp": "00:42:08", "text": "ええ、私は不安になりすぎる"}, {"type": "subtitle", "time": 2536.63, "timestamp": "00:42:16", "text": "なんとなく共感できる部分もあるかな。   そう感じるから、気が"}, {"type": "subtitle", "time": 2545.43, "timestamp": "00:42:25", "text": "狂いそうになる。 私はパニックになって、息切れし"}, {"type": "subtitle", "time": 2549.99, "timestamp": "00:42:29", "text": "[笑い]"}, {"type": "subtitle", "time": 2553.91, "timestamp": "00:42:33", "text": "私のパニックのせいで家族は私のことをとても心配しています。"}, {"type": "subtitle", "time": 2558.15, "timestamp": "00:42:38", "text": "ああ、"}, {"type": "subtitle", "time": 2564.23, "timestamp": "00:42:44", "text": "この緊張と"}, {"type": "subtitle", "time": 2569.109, "timestamp": "00:42:49", "text": "この不安のせいで家族はすごく心配しています。"}, {"type": "subtitle", "time": 2571.549, "timestamp": "00:42:51", "text": "ああ、なんてことだ、"}]
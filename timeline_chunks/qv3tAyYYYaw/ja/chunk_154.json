[{"type": "subtitle", "time": 9243.75, "timestamp": "02:34:03", "text": "。 えっと、日本での生活がどんな感じになるかはもう分かってるんだけど、たぶん朝起きるだけになるんだろうな"}, {"type": "subtitle", "time": 9253.83, "timestamp": "02:34:13", "text": "。 うん。 ドーム、つまり"}, {"type": "subtitle", "time": 9257.75, "timestamp": "02:34:17", "text": "寮から起きて、学校に行って、"}, {"type": "subtitle", "time": 9262.15, "timestamp": "02:34:22", "text": "授業に出て、家に帰ってきて、"}, {"type": "subtitle", "time": 9265.99, "timestamp": "02:34:25", "text": "アルバイトに行って、家に帰ってきて、"}, {"type": "subtitle", "time": 9270.311, "timestamp": "02:34:30", "text": "外を数キロ"}, {"type": "subtitle", "time": 9273.27, "timestamp": "02:34:33", "text": "（笑）数メートル散歩して、家に帰ってきて、これを"}, {"type": "subtitle", "time": 9275.349, "timestamp": "02:34:35", "text": "繰り返す。私の"}, {"type": "subtitle", "time": 9278.309, "timestamp": "02:34:38", "text": "場所で、あるいは、"}, {"type": "subtitle", "time": 9285.11, "timestamp": "02:34:45", "text": "騒音苦情などで寮で配信できない場合は、配信しなければならないかもしれない"}, {"type": "subtitle", "time": 9288.07, "timestamp": "02:34:48", "text": "。 ボーカルブースに行くか、"}, {"type": "subtitle", "time": 9291.03, "timestamp": "02:34:51", "text": "スタジオを借りるか、あるいは"}, {"type": "subtitle", "time": 9297.429, "timestamp": "02:34:57", "text": "誰もいないような小さな密閉された場所、防音"}]
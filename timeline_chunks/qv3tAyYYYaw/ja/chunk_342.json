[{"type": "subtitle", "time": 20529.83, "timestamp": "05:42:09", "text": "スクルのことは忘れてください。"}, {"type": "subtitle", "time": 20533.11, "timestamp": "05:42:13", "text": "これは日曜日の授業でした。"}, {"type": "subtitle", "time": 20535.59, "timestamp": "05:42:15", "text": "今日は何の日ですか？ 火曜日。 ええ、これは"}, {"type": "subtitle", "time": 20565.99, "timestamp": "05:42:45", "text": "2 を使用します。 あのね、"}, {"type": "subtitle", "time": 20569.27, "timestamp": "05:42:49", "text": "知ってる？ 本日はこれで終了とします。"}, {"type": "subtitle", "time": 20571.59, "timestamp": "05:42:51", "text": "少し頭を休ませよう。"}, {"type": "subtitle", "time": 20574.23, "timestamp": "05:42:54", "text": "スマホでやります。"}, {"type": "subtitle", "time": 20576.548, "timestamp": "05:42:56", "text": "ああ、わかった。"}, {"type": "subtitle", "time": 20578.628, "timestamp": "05:42:58", "text": "はい、では本日はこれで終了とします。"}]
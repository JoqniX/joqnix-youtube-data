[{"type": "subtitle", "time": 16160.87, "timestamp": "04:29:20", "text": "例えば、"}, {"type": "subtitle", "time": 16163.51, "timestamp": "04:29:23", "text": "コンピューターとかそういう分野の仕事をしていて、"}, {"type": "subtitle", "time": 16169.349, "timestamp": "04:29:29", "text": "日本で仕事のオファーがあって、"}, {"type": "subtitle", "time": 16171.349, "timestamp": "04:29:31", "text": "スポンサーになってくれるとか。いや、"}, {"type": "subtitle", "time": 16176.55, "timestamp": "04:29:36", "text": "日本語を勉強するように言われるだけ。そう、そういうタイプの"}, {"type": "subtitle", "time": 16178.55, "timestamp": "04:29:38", "text": "人もいるし、そういう学生もいる。そういう人にとってはそれで"}, {"type": "subtitle", "time": 16186.71, "timestamp": "04:29:46", "text": "そう、そういう人にとってはそれでいいんだ。みんなにとってはいいことだよね。"}, {"type": "subtitle", "time": 16193.83, "timestamp": "04:29:53", "text": "でも他の人にとっては、今やらなきゃいけないことがある。"}, {"type": "subtitle", "time": 16198.95, "timestamp": "04:29:58", "text": "インド人であることはあまり重要じゃないから。"}]
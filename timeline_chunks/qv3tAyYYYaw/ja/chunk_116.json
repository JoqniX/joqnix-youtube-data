[{"type": "subtitle", "time": 6966.47, "timestamp": "01:56:06", "text": "パンを開けたままにしておいたから、すごく変な感じになってる。"}, {"type": "subtitle", "time": 6969.43, "timestamp": "01:56:09", "text": "ああ、パンちゃん、"}, {"type": "subtitle", "time": 6970.709, "timestamp": "01:56:10", "text": "君はゲームをしているんだね。"}, {"type": "subtitle", "time": 6972.55, "timestamp": "01:56:12", "text": "私のマウスがSammyの配信などをどう受け止めるか、よくわかりません"}, {"type": "subtitle", "time": 6974.47, "timestamp": "01:56:14", "text": "。 うん。 うん。 わかった。 わかった。 あまりやりすぎないつもりです"}, {"type": "subtitle", "time": 6979.589, "timestamp": "01:56:19", "text": "。 ああ、"}, {"type": "subtitle", "time": 6983.589, "timestamp": "01:56:23", "text": "（ため息をついて息を呑む）"}, {"type": "subtitle", "time": 6986.709, "timestamp": "01:56:26", "text": "おそらくゲームをするだろうし、"}, {"type": "subtitle", "time": 6990.149, "timestamp": "01:56:30", "text": "ASMRを再開したいと思うだろう。"}, {"type": "subtitle", "time": 6993.51, "timestamp": "01:56:33", "text": "ASMRをやるのが恋しかったのですが、"}, {"type": "subtitle", "time": 6996.629, "timestamp": "01:56:36", "text": "ASMRと私の関係で問題なのは、私が"}, {"type": "subtitle", "time": 6999.91, "timestamp": "01:56:39", "text": "それにのめり込みすぎると、[笑]止めるのが難しいということです。"}, {"type": "subtitle", "time": 7002.709, "timestamp": "01:56:42", "text": "私はやってはいけないことをしてしまうかもしれない"}, {"type": "subtitle", "time": 7004.39, "timestamp": "01:56:44", "text": "。"}, {"type": "subtitle", "time": 7007.43, "timestamp": "01:56:47", "text": "うん。 つまり、楽しいのは確かだけど、"}]
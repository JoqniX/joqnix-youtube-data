[{"type": "subtitle", "time": 4388.709, "timestamp": "01:13:08", "text": "今はもう寝たいんです。 今日は"}, {"type": "subtitle", "time": 4392.149, "timestamp": "01:13:12", "text": "少し休んで休むべきか、"}, {"type": "subtitle", "time": 4396.149, "timestamp": "01:13:16", "text": "それとも今日もずっと活動を続けるべきか、どう思いますか？   正直なところ、"}, {"type": "subtitle", "time": 4401.35, "timestamp": "01:13:21", "text": "授業が始まる"}, {"type": "subtitle", "time": 4404.79, "timestamp": "01:13:24", "text": "6時まで一日中続けたいと思っています。 だから5時くらいまでは大丈夫だけど、もし今"}, {"type": "subtitle", "time": 4407.43, "timestamp": "01:13:27", "text": "6時から"}, {"type": "subtitle", "time": 4410.229, "timestamp": "01:13:30", "text": "8時頃にはもう完全に眠くなっていたらどうしよう？ 私は試験を受けなければならない。"}, {"type": "subtitle", "time": 4418.39, "timestamp": "01:13:38", "text": "漢字のテストだけど、"}, {"type": "subtitle", "time": 4427.99, "timestamp": "01:13:47", "text": "うん。 そして、"}, {"type": "subtitle", "time": 4432.07, "timestamp": "01:13:52", "text": "今日以降も明日など、"}, {"type": "subtitle", "time": 4435.43, "timestamp": "01:13:55", "text": "少なくとも1時間は日本語の練習をするように自分に言い聞かせなければならない。"}, {"type": "subtitle", "time": 4438.149, "timestamp": "01:13:58", "text": "漢字を勉強したり、"}]
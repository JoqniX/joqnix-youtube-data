[{"type": "subtitle", "time": 19920.868, "timestamp": "05:32:00", "text": "1つだけ勉強している私とは違って。 一日だけ勉強して、"}, {"type": "subtitle", "time": 19923.75, "timestamp": "05:32:03", "text": "残りの週は勉強も練習もしない。"}, {"type": "subtitle", "time": 19926.31, "timestamp": "05:32:06", "text": "そんなことしないで。ああ、そうなったんだ。"}, {"type": "subtitle", "time": 19942.23, "timestamp": "05:32:22", "text": "。やれやれ"}, {"type": "subtitle", "time": 19961.75, "timestamp": "05:32:41", "text": "でも、昨日"}, {"type": "subtitle", "time": 19966.708, "timestamp": "05:32:46", "text": "N5レベルの漢字に時間を費やすべきじゃなかったような気がする"}, {"type": "subtitle", "time": 19970.948, "timestamp": "05:32:50", "text": "。もし"}, {"type": "subtitle", "time": 19974.708, "timestamp": "05:32:54", "text": "昨日N4の部分をやっていたら、"}, {"type": "subtitle", "time": 19978.708, "timestamp": "05:32:58", "text": "今頃終わってたはずだ。"}]
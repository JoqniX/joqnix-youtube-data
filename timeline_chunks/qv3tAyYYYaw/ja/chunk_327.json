[{"type": "subtitle", "time": 19638.47, "timestamp": "05:27:18", "text": "ええと、このビデオ「"}, {"type": "subtitle", "time": 19641.35, "timestamp": "05:27:21", "text": "漢字」と「180漢字ステップ1」を終えました。30"}, {"type": "subtitle", "time": 19644.07, "timestamp": "05:27:24", "text": "漢字を終えましたが、まだ"}, {"type": "subtitle", "time": 19649.19, "timestamp": "05:27:29", "text": "ビデオがあります。これは"}, {"type": "subtitle", "time": 19651.11, "timestamp": "05:27:31", "text": "150、31"}, {"type": "subtitle", "time": 19657.27, "timestamp": "05:27:37", "text": "から50、それからこれは、えーと、"}, {"type": "subtitle", "time": 19663.03, "timestamp": "05:27:43", "text": "死ぬ、"}, {"type": "subtitle", "time": 19667.27, "timestamp": "05:27:47", "text": "私は死ぬ、私は死ぬ、"}, {"type": "subtitle", "time": 19671.19, "timestamp": "05:27:51", "text": "これら20文字、それからこれ、そしてまだ終わりではありません"}]
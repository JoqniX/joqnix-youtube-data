[{"type": "subtitle", "time": 2342.23, "timestamp": "00:39:02", "text": "日本語の漢字のほとんどは"}, {"type": "subtitle", "time": 2345.109, "timestamp": "00:39:05", "text": "複数の読み方がありますが、この"}, {"type": "subtitle", "time": 2346.95, "timestamp": "00:39:06", "text": "動画では初心者向けに各漢字の代表的な読み方を一つだけ紹介しています"}, {"type": "subtitle", "time": 2351.91, "timestamp": "00:39:11", "text": "。"}, {"type": "subtitle", "time": 2354.087, "timestamp": "00:39:14", "text": "これは"}, {"type": "subtitle", "time": 2358.63, "timestamp": "00:39:18", "text": "音楽のN5レベルで習った曲だと覚えていますか？ はい、Kは"}, {"type": "subtitle", "time": 2359.589, "timestamp": "00:39:19", "text": "3のKです。"}, {"type": "subtitle", "time": 2360.31, "timestamp": "00:39:20", "text": "三つ。 はい。"}, {"type": "subtitle", "time": 2366.63, "timestamp": "00:39:26", "text": "この漢字から次の２文字の意味を推測してください。"}, {"type": "subtitle", "time": 2391.109, "timestamp": "00:39:51", "text": "だから、鍵を2つ書かなければならない。 一つはもっと"}]
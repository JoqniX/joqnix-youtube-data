[{"type": "subtitle", "time": 10449.349, "timestamp": "02:54:09", "text": "この漢字の"}, {"type": "subtitle", "time": 10457.75, "timestamp": "02:54:17", "text": "この部分は"}, {"type": "subtitle", "time": 10460.87, "timestamp": "02:54:20", "text": "植物に関連する漢字に使われるんだ。"}, {"type": "subtitle", "time": 10462.63, "timestamp": "02:54:22", "text": "あ、"}, {"type": "subtitle", "time": 10465.269, "timestamp": "02:54:25", "text": "パッケージ全部見つけられる？じゃあ、"}, {"type": "subtitle", "time": 10468.15, "timestamp": "02:54:28", "text": "1、2、3、4。4つ見つける"}, {"type": "subtitle", "time": 10477.75, "timestamp": "02:54:37", "text": "はずだったと思う。あ、待って。ごめん。うん。1、2、3。うん"}, {"type": "subtitle", "time": 10481.83, "timestamp": "02:54:41", "text": "、そうだった。"}, {"type": "subtitle", "time": 10494.389, "timestamp": "02:54:54", "text": "なんてこった。あ、待って、待って、待って、待って、待って"}, {"type": "subtitle", "time": 10495.67, "timestamp": "02:54:55", "text": "、待って。まだ"}, {"type": "subtitle", "time": 10499.67, "timestamp": "02:54:59", "text": "終わってない。花。オーケー。花の"}]
[{"type": "subtitle", "time": 9365.19, "timestamp": "02:36:05", "text": "クラスメートのような友達とは一緒に行きません。"}, {"type": "subtitle", "time": 9370.469, "timestamp": "02:36:10", "text": "インドから日本へ一緒に行くような学校には行きません。今はあまり"}, {"type": "subtitle", "time": 9373.67, "timestamp": "02:36:13", "text": "話しません。だから"}, {"type": "subtitle", "time": 9375.99, "timestamp": "02:36:15", "text": "父も"}, {"type": "subtitle", "time": 9379.51, "timestamp": "02:36:19", "text": "外国人と話して友達になり、"}, {"type": "subtitle", "time": 9381.59, "timestamp": "02:36:21", "text": "英語と日本語の両方を練習できるように、"}, {"type": "subtitle", "time": 9384.95, "timestamp": "02:36:24", "text": "主に日本人と友達になり、"}, {"type": "subtitle", "time": 9387.83, "timestamp": "02:36:27", "text": "地元のインド人とは一緒に行かないようにと言いました。"}, {"type": "subtitle", "time": 9391.11, "timestamp": "02:36:31", "text": "なぜなら、それに慣れてしまい、"}, {"type": "subtitle", "time": 9396.469, "timestamp": "02:36:36", "text": "他の場所の人々と交流しなくなるからです。 ええ、そういう風に円を描くように配置されるでしょう"}, {"type": "subtitle", "time": 9405.11, "timestamp": "02:36:45", "text": "。 彼はそう言った。"}, {"type": "subtitle", "time": 9407.59, "timestamp": "02:36:47", "text": "私の英語がこんなに上手な理由は、"}, {"type": "subtitle", "time": 9415.03, "timestamp": "02:36:55", "text": "アメリカ人やイギリス人の友達がたくさんいるからだって知ってる？ へえ、"}]
[{"type": "subtitle", "time": 16381.59, "timestamp": "04:33:01", "text": "それが問題なんです。今アムがそう言ったとき、"}, {"type": "subtitle", "time": 16384.39, "timestamp": "04:33:04", "text": "深く心に響きました。"}, {"type": "subtitle", "time": 16388.551, "timestamp": "04:33:08", "text": "悲しくなりました。私は、"}, {"type": "subtitle", "time": 16394.789, "timestamp": "04:33:14", "text": "本当に遅れていると思いました。"}, {"type": "subtitle", "time": 16398.709, "timestamp": "04:33:18", "text": "基礎をしっかり固めなければなりません。"}, {"type": "subtitle", "time": 16403.67, "timestamp": "04:33:23", "text": "文法をやらなければなりません。文章の練習をしなければなりません"}, {"type": "subtitle", "time": 16406.31, "timestamp": "04:33:26", "text": "。"}, {"type": "subtitle", "time": 16409.91, "timestamp": "04:33:29", "text": "そう、実際に勉強しなければならないので、"}, {"type": "subtitle", "time": 16424.869, "timestamp": "04:33:44", "text": "、ただ言っているだけです。今"}, {"type": "subtitle", "time": 16427.429, "timestamp": "04:33:47", "text": "勉強しているようにこの時間を使っていればよかったと思います。"}, {"type": "subtitle", "time": 16431.67, "timestamp": "04:33:51", "text": "学位の"}, {"type": "subtitle", "time": 16439.91, "timestamp": "04:33:59", "text": "後悔を感じるべきです。"}]
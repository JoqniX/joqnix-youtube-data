[{"type": "subtitle", "time": 4826.55, "timestamp": "01:20:26", "text": "うん。 あのね？ 昨日、午前1時"}, {"type": "subtitle", "time": 4837.91, "timestamp": "01:20:37", "text": "前に配信を終えて階下に降りてきた後、眠れなかったんです。ええ"}, {"type": "subtitle", "time": 4842.47, "timestamp": "01:20:42", "text": "、Shroudのプレイヤーを見ていて、彼が"}, {"type": "subtitle", "time": 4844.95, "timestamp": "01:20:44", "text": "それを見ている間に寝て、彼が彼を"}, {"type": "subtitle", "time": 4848.47, "timestamp": "01:20:48", "text": "見ている間に目が覚めました。  [笑い声]"}, {"type": "subtitle", "time": 4858.63, "timestamp": "01:20:58", "text": "でも、ああいう配信のチャットは"}]
[{"type": "subtitle", "time": 6481.59, "timestamp": "01:48:01", "text": "インドのユーチューバーの中には、そう、ごく少数の人しかいません"}, {"type": "subtitle", "time": 6484.149, "timestamp": "01:48:04", "text": "。 例えば、"}, {"type": "subtitle", "time": 6488.39, "timestamp": "01:48:08", "text": "文書が公開された後に組合結成を試みる人々とどのようにやり取りするか、といったことです。 え、"}, {"type": "subtitle", "time": 6497.75, "timestamp": "01:48:17", "text": "そして、この全てが"}, {"type": "subtitle", "time": 6500.87, "timestamp": "01:48:20", "text": "ケーキから始まったという経緯も。 うん。 待って、"}, {"type": "subtitle", "time": 6503.27, "timestamp": "01:48:23", "text": "最初の行の意味はどういうことですか？ 待って、よく分からなかった"}, {"type": "subtitle", "time": 6520.149, "timestamp": "01:48:40", "text": "、交流しようとはしました。"}, {"type": "subtitle", "time": 6523.43, "timestamp": "01:48:43", "text": "エイミーにも叱られた。 さて、なぜ"}, {"type": "subtitle", "time": 6524.95, "timestamp": "01:48:44", "text": "あなたはまだ人々と交流しているのですか？ あんなことがあった後でも、なぜまだこんな"}, {"type": "subtitle", "time": 6528.149, "timestamp": "01:48:48", "text": "人たちを信用しているのですか"}]
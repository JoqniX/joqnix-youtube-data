[{"type": "subtitle", "time": 9189.03, "timestamp": "02:33:09", "text": "コロナは"}, {"type": "subtitle", "time": 9198.71, "timestamp": "02:33:18", "text": "ライスパテを手に入れた。"}, {"type": "subtitle", "time": 9231.429, "timestamp": "02:33:51", "text": "。 ほら、"}, {"type": "subtitle", "time": 9235.59, "timestamp": "02:33:55", "text": "私が恐れていることの一つは、すでに"}, {"type": "subtitle", "time": 9238.07, "timestamp": "02:33:58", "text": "私の奇妙な癖、つまり先延ばしにしすぎる癖がついてしまっていることです"}]
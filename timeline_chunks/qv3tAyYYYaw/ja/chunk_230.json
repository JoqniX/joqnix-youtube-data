[{"type": "subtitle", "time": 13830.63, "timestamp": "03:50:30", "text": "とにかく、まあいいや。わかった、"}, {"type": "subtitle", "time": 13833.75, "timestamp": "03:50:33", "text": "気にしないで。私はただ、私はただこれをやるだけ。わからないよ"}, {"type": "subtitle", "time": 13851.269, "timestamp": "03:50:51", "text": "そして、このビデオが終わったとしても、私は"}, {"type": "subtitle", "time": 13855.349, "timestamp": "03:50:55", "text": "自分のノートを確認して、"}]
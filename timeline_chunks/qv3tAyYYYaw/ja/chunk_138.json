[{"type": "subtitle", "time": 8280.15, "timestamp": "02:18:00", "text": "ええ、勉強する意欲はとっくの昔に私から消え去ってしまいました"}, {"type": "subtitle", "time": 8293.27, "timestamp": "02:18:13", "text": "大変だった。"}, {"type": "subtitle", "time": 8294.629, "timestamp": "02:18:14", "text": "2時間以上の"}, {"type": "subtitle", "time": 8320.15, "timestamp": "02:18:40", "text": "[笑い]"}, {"type": "subtitle", "time": 8327.83, "timestamp": "02:18:47", "text": "ほら、私が小さかった頃、まだ若くはなかったけど、たぶん"}, {"type": "subtitle", "time": 8334.23, "timestamp": "02:18:54", "text": "15歳"}, {"type": "subtitle", "time": 8338.79, "timestamp": "02:18:58", "text": "か16歳か13歳くらいだったと思う。 私はいつも"}]
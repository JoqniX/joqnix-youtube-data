[{"type": "subtitle", "time": 7805.75, "timestamp": "02:10:05", "text": "自分の努力で築き上げたもの全てを手に入れたら、"}, {"type": "subtitle", "time": 7807.669, "timestamp": "02:10:07", "text": "彼らが来たら来るだろうと思っていました。私は「"}, {"type": "subtitle", "time": 7809.645, "timestamp": "02:10:09", "text": "ああ、"}, {"type": "subtitle", "time": 7816.87, "timestamp": "02:10:16", "text": "なぜ今ここにいるの？"}, {"type": "subtitle", "time": 7818.79, "timestamp": "02:10:18", "text": "クラウドか何かのために来たの？」と言うでしょう。"}, {"type": "subtitle", "time": 7824.069, "timestamp": "02:10:24", "text": "私が"}, {"type": "subtitle", "time": 7827.589, "timestamp": "02:10:27", "text": "友達として一番あなたを必要としていた時に、あなたはそこにいなかったでしょう。   まあ"}, {"type": "subtitle", "time": 7829.99, "timestamp": "02:10:29", "text": "、そんな感じですね。 わからない"}, {"type": "subtitle", "time": 7832.95, "timestamp": "02:10:32", "text": "。"}, {"type": "subtitle", "time": 7849.99, "timestamp": "02:10:49", "text": "私たちがプレイするゲームは、"}, {"type": "subtitle", "time": 7853.109, "timestamp": "02:10:53", "text": "全く異なるものです。"}, {"type": "subtitle", "time": 7855.189, "timestamp": "02:10:55", "text": "Dさん、"}, {"type": "subtitle", "time": 7857.669, "timestamp": "02:10:57", "text": "もし私の理解が正しければ、私は実際にはどのジャンルでも大丈夫です"}]
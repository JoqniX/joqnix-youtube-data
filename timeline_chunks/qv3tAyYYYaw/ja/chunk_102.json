[{"type": "subtitle", "time": 6130.55, "timestamp": "01:42:10", "text": "私は今、つまり最近、"}, {"type": "subtitle", "time": 6132.07, "timestamp": "01:42:12", "text": "昨日の配信と今日の"}, {"type": "subtitle", "time": 6134.39, "timestamp": "01:42:14", "text": "配信で、"}, {"type": "subtitle", "time": 6138.47, "timestamp": "01:42:18", "text": "彼らの言葉が正しかったことに気づきました。 えっと、その"}, {"type": "subtitle", "time": 6141.75, "timestamp": "01:42:21", "text": "きっかけは、先生が実際に"}, {"type": "subtitle", "time": 6145.83, "timestamp": "01:42:25", "text": "私にDMを送ってきて、「君は他の"}, {"type": "subtitle", "time": 6154.79, "timestamp": "01:42:34", "text": "クラスメートに比べて少し遅れているよ」と言った時でした。"}, {"type": "subtitle", "time": 6157.91, "timestamp": "01:42:37", "text": "基本を"}, {"type": "subtitle", "time": 6160.629, "timestamp": "01:42:40", "text": "正しく理解しないといけないし、そういうことで気分が"}, {"type": "subtitle", "time": 6165.59, "timestamp": "01:42:45", "text": "悪くなったんだけど、それで、"}, {"type": "subtitle", "time": 6168.229, "timestamp": "01:42:48", "text": "詐欺の感覚を起動してみようと思ったんだ。"}, {"type": "subtitle", "time": 6173.83, "timestamp": "01:42:53", "text": "実際、彼は良い人だから、そう"}]
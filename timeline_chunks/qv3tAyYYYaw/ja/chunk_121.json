[{"type": "subtitle", "time": 7264.31, "timestamp": "02:01:04", "text": "私がとても"}, {"type": "subtitle", "time": 7268.39, "timestamp": "02:01:08", "text": "幸せだったのは、オレンジが作ったビデオだった。それが"}, {"type": "subtitle", "time": 7270.95, "timestamp": "02:01:10", "text": "私について本当にひどいのはわかっているけど、それでも"}, {"type": "subtitle", "time": 7274.95, "timestamp": "02:01:14", "text": "彼がそれを紹介して、次に"}, {"type": "subtitle", "time": 7278.47, "timestamp": "02:01:18", "text": "誰が来るかとか話していたやり方が、本当に本当に"}, {"type": "subtitle", "time": 7285.03, "timestamp": "02:01:25", "text": "大好きだった。"}, {"type": "subtitle", "time": 7291.51, "timestamp": "02:01:31", "text": "ああ、私のデータロゴを誰が使ったかとか、それが"}, {"type": "subtitle", "time": 7294.47, "timestamp": "02:01:34", "text": "私を幸せにして"}, {"type": "subtitle", "time": 7296.629, "timestamp": "02:01:36", "text": "移行させてくれた。"}, {"type": "subtitle", "time": 7298.95, "timestamp": "02:01:38", "text": "そうですね、もし私が普段の生活で"}, {"type": "subtitle", "time": 7302.229, "timestamp": "02:01:42", "text": "他の人がそういうコンテンツを見られるとしたら"}]
[{"type": "subtitle", "time": 9121.67, "timestamp": "02:32:01", "text": "つまり、日帰り旅行ならいいんだけど、彼らは私を連れて行ってくれるだろうし、"}, {"type": "subtitle", "time": 9124.389, "timestamp": "02:32:04", "text": "一緒に来てくれるように頼んでくれるだろう"}, {"type": "subtitle", "time": 9128.95, "timestamp": "02:32:08", "text": "けど、私一人だけとなると、どうかな。   えっと、つまり、私が一人でできる"}, {"type": "subtitle", "time": 9137.19, "timestamp": "02:32:17", "text": "限りは許可してくれるということです"}, {"type": "subtitle", "time": 9142.07, "timestamp": "02:32:22", "text": "。"}, {"type": "subtitle", "time": 9144.23, "timestamp": "02:32:24", "text": "地元の友人グループでは、みんながまるで"}, {"type": "subtitle", "time": 9157.27, "timestamp": "02:32:37", "text": "。 私はすでに"}, {"type": "subtitle", "time": 9159.429, "timestamp": "02:32:39", "text": "叔父や"}, {"type": "subtitle", "time": 9164.855, "timestamp": "02:32:44", "text": "ええ、それもまたトラウマになりますね。"}, {"type": "subtitle", "time": 9166.87, "timestamp": "02:32:46", "text": "[笑い]"}, {"type": "subtitle", "time": 9175.99, "timestamp": "02:32:55", "text": "。"}]
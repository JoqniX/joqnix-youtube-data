[{"type": "subtitle", "time": 3540.789, "timestamp": "00:59:00", "text": "ええ、そんな感じです。 一番下。"}, {"type": "subtitle", "time": 3544.549, "timestamp": "00:59:04", "text": "えーと、左、右、右、右、左、"}, {"type": "subtitle", "time": 3547.03, "timestamp": "00:59:07", "text": "右、右、右。 わかった。 左、右、"}, {"type": "subtitle", "time": 3549.829, "timestamp": "00:59:09", "text": "右、右。"}, {"type": "subtitle", "time": 3590.63, "timestamp": "00:59:50", "text": "だから昨日とは違って、こんな風に"}, {"type": "subtitle", "time": 3593.19, "timestamp": "00:59:53", "text": "漢字を全部書き直すなんて時間の無駄はしないよ"}, {"type": "subtitle", "time": 3595.829, "timestamp": "00:59:55", "text": "。 もちろん、それは"}, {"type": "subtitle", "time": 3599.99, "timestamp": "00:59:59", "text": "良い書き方だし、安定しているんだけど、"}]
[{"type": "subtitle", "time": 9301.11, "timestamp": "02:35:01", "text": "壁のある場所でノートパソコンを使わないといけないだろう。"}, {"type": "subtitle", "time": 9303.83, "timestamp": "02:35:03", "text": "ええ、ノートパソコンを使って、"}, {"type": "subtitle", "time": 9308.07, "timestamp": "02:35:08", "text": "マイクで配信しています。"}, {"type": "subtitle", "time": 9310.267, "timestamp": "02:35:10", "text": "それで"}, {"type": "subtitle", "time": 9311.99, "timestamp": "02:35:11", "text": "[笑い]"}, {"type": "subtitle", "time": 9314.63, "timestamp": "02:35:14", "text": "あ、待って、vlog のせいで、vlog を作らなきゃいけないんだと"}, {"type": "subtitle", "time": 9317.472, "timestamp": "02:35:17", "text": "思う"}, {"type": "subtitle", "time": 9319.67, "timestamp": "02:35:19", "text": "[音楽]"}, {"type": "subtitle", "time": 9323.67, "timestamp": "02:35:23", "text": "土曜や日曜などに旅行とかするかもしれないし、たぶん"}, {"type": "subtitle", "time": 9326.469, "timestamp": "02:35:26", "text": "授業はないと思う。"}, {"type": "subtitle", "time": 9331.349, "timestamp": "02:35:31", "text": "正直言って、そんな生き方はしたくないね。 ええ、一人ぼっちだとそうしてしまいそうで"}, {"type": "subtitle", "time": 9333.99, "timestamp": "02:35:33", "text": "怖いです"}, {"type": "subtitle", "time": 9336.71, "timestamp": "02:35:36", "text": "。 必要な時だけ外出します。"}, {"type": "subtitle", "time": 9340.87, "timestamp": "02:35:40", "text": "[音楽]"}, {"type": "subtitle", "time": 9343.27, "timestamp": "02:35:43", "text": "効率性と一貫性など、あらゆることに気を配ります。"}, {"type": "subtitle", "time": 9347.19, "timestamp": "02:35:47", "text": "[笑い]"}, {"type": "subtitle", "time": 9349.67, "timestamp": "02:35:49", "text": "それは良くないことですが、"}, {"type": "subtitle", "time": 9353.91, "timestamp": "02:35:53", "text": "一つ確かなことは、"}, {"type": "subtitle", "time": 9356.23, "timestamp": "02:35:56", "text": "語学学校で友達を作りたいということです。"}]
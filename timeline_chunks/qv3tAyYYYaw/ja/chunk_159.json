[{"type": "subtitle", "time": 9541.19, "timestamp": "02:39:01", "text": "ああ、セラピストは知ってるよ。"}, {"type": "subtitle", "time": 9553.99, "timestamp": "02:39:13", "text": "セラピーを受けた証拠を彼に頼まなきゃいけなかったから。でも、"}, {"type": "subtitle", "time": 9557.83, "timestamp": "02:39:17", "text": "セラピーの場所の名前は教えてもらえなかった。"}, {"type": "subtitle", "time": 9561.91, "timestamp": "02:39:21", "text": "セラピストがそこを辞めてしまって、"}, {"type": "subtitle", "time": 9567.349, "timestamp": "02:39:27", "text": "機密文書みたいなものだから。だから、"}, {"type": "subtitle", "time": 9570.309, "timestamp": "02:39:30", "text": "ビデオで見せることはできなかったけど、"}, {"type": "subtitle", "time": 9573.349, "timestamp": "02:39:33", "text": "まあ、"}, {"type": "subtitle", "time": 9577.91, "timestamp": "02:39:37", "text": "必要ないと思った。 だから、それを見せなかったのは、"}, {"type": "subtitle", "time": 9583.75, "timestamp": "02:39:43", "text": "「"}, {"type": "subtitle", "time": 9586.469, "timestamp": "02:39:46", "text": "セラピーを受けたとか、通ったとか言ってたけど、本当？」って思われたくなかったから。だって、"}, {"type": "subtitle", "time": 9589.19, "timestamp": "02:39:49", "text": "今は証拠を見せられるしね。[笑い]"}, {"type": "subtitle", "time": 9592.469, "timestamp": "02:39:52", "text": "嘘をつく必要なんてないでしょ？"}, {"type": "subtitle", "time": 9595.83, "timestamp": "02:39:55", "text": "ああ、もう。でも、セラピストのジャマジャマ"}]
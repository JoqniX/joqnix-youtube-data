[{"type": "subtitle", "time": 6544.709, "timestamp": "01:49:04", "text": "それが私が気づいたことです。 つまり、私は何と"}, {"type": "subtitle", "time": 6554.39, "timestamp": "01:49:14", "text": "実際のレンダリングは、"}, {"type": "subtitle", "time": 6557.27, "timestamp": "01:49:17", "text": "あらゆるもののケーキのためです。 ええ、[笑い]"}, {"type": "subtitle", "time": 6557.99, "timestamp": "01:49:17", "text": "[息を呑む]"}, {"type": "subtitle", "time": 6564.79, "timestamp": "01:49:24", "text": "正直に言うと、くだらないケーキのせいなんです。"}, {"type": "subtitle", "time": 6566.95, "timestamp": "01:49:26", "text": "私はただ彼らのもとへ戻ろうとしただけです。  「"}, {"type": "subtitle", "time": 6568.87, "timestamp": "01:49:28", "text": "彼らのところに戻る」とはどういう意味ですか？ 私はその後、"}, {"type": "subtitle", "time": 6571.35, "timestamp": "01:49:31", "text": "彼らとは一切関わらなかった。"}, {"type": "subtitle", "time": 6575.43, "timestamp": "01:49:35", "text": "私が彼らをブロックして以来、"}, {"type": "subtitle", "time": 6580.95, "timestamp": "01:49:40", "text": "あそこで見たよ。"}, {"type": "subtitle", "time": 6584.31, "timestamp": "01:49:44", "text": "私は彼らをブロックしませんでした。 私は"}, {"type": "subtitle", "time": 6588.39, "timestamp": "01:49:48", "text": "彼らと交流しなかった、ですよね？"}, {"type": "subtitle", "time": 6590.87, "timestamp": "01:49:50", "text": "神話上のクジラとか、その他"}, {"type": "subtitle", "time": 6595.35, "timestamp": "01:49:55", "text": "諸々。 それらの人々のほとんどは、"}]
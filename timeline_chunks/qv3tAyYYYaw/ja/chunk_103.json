[{"type": "subtitle", "time": 6186.55, "timestamp": "01:43:06", "text": "。 いいえ、先生は良い方です。"}, {"type": "subtitle", "time": 6190.229, "timestamp": "01:43:10", "text": "アカデミーだと思います。 ちょっと怪しいですね。"}, {"type": "subtitle", "time": 6193.59, "timestamp": "01:43:13", "text": "怪しくない。 いいえ。ええと、彼らはそれをきちんと正しく行うことはあまりありません"}, {"type": "subtitle", "time": 6200.629, "timestamp": "01:43:20", "text": "疎通の行き違いが多すぎて、いろいろと問題があった"}, {"type": "subtitle", "time": 6202.87, "timestamp": "01:43:22", "text": "。"}, {"type": "subtitle", "time": 6206.39, "timestamp": "01:43:26", "text": "先生はただの教師です。 いや、それだけじゃない。   私が"}, {"type": "subtitle", "time": 6212.31, "timestamp": "01:43:32", "text": "所属していたアカデミーの影響が大きいと思います。"}, {"type": "subtitle", "time": 6215.189, "timestamp": "01:43:35", "text": "全てがうまくいくことを願っています。 そうそう。 つまり、"}, {"type": "subtitle", "time": 6219.27, "timestamp": "01:43:39", "text": "恐怖心を植え付けるような条件付けがあるため、それは悪い贈り物なのです。   見下すような態度って、一体"}]
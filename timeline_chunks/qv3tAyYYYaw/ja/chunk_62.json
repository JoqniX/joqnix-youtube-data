[{"type": "subtitle", "time": 3721.109, "timestamp": "01:02:01", "text": "。 東って東みたいな意味じゃないの？"}, {"type": "subtitle", "time": 3723.589, "timestamp": "01:02:03", "text": "私は「待って、彼は"}, {"type": "subtitle", "time": 3735.75, "timestamp": "01:02:15", "text": "あなたの回答に感謝します。 ええ、"}, {"type": "subtitle", "time": 3738.23, "timestamp": "01:02:18", "text": "最後の部分を撮影しています。"}, {"type": "subtitle", "time": 3742.87, "timestamp": "01:02:22", "text": "今日はこのレベルのテスト用紙があります。"}, {"type": "subtitle", "time": 3754.23, "timestamp": "01:02:34", "text": "彼女は"}, {"type": "subtitle", "time": 3767.03, "timestamp": "01:02:47", "text": "色をこのように呼び、"}]
[{"type": "subtitle", "time": 9427.11, "timestamp": "02:37:07", "text": "友達を作るのって、本当に難しいよね。 わからない"}, {"type": "subtitle", "time": 9429.19, "timestamp": "02:37:09", "text": "。 この"}, {"type": "subtitle", "time": 9431.349, "timestamp": "02:37:11", "text": "出来事以来、私はまだ"}, {"type": "subtitle", "time": 9435.19, "timestamp": "02:37:15", "text": "そのトラウマを彷彿とさせる何かが心の中に残っているように感じています。"}, {"type": "subtitle", "time": 9437.67, "timestamp": "02:37:17", "text": "だから、たとえ"}, {"type": "subtitle", "time": 9445.19, "timestamp": "02:37:25", "text": "別のPLペルソナや"}, {"type": "subtitle", "time": 9451.27, "timestamp": "02:37:31", "text": "。 私はどちらかというと反対で、"}, {"type": "subtitle", "time": 9454.71, "timestamp": "02:37:34", "text": "人が私に近づくのが早すぎると感じます。"}, {"type": "subtitle", "time": 9467.75, "timestamp": "02:37:47", "text": "つまり、私が人に気を許しすぎると、まるで"}, {"type": "subtitle", "time": 9473.83, "timestamp": "02:37:53", "text": "5、4"}, {"type": "subtitle", "time": 9477.429, "timestamp": "02:37:57", "text": "年も友達だった人と話しているような感じになります。"}]
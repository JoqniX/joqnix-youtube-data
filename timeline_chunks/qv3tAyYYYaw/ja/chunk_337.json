[{"type": "subtitle", "time": 20220.548, "timestamp": "05:37:00", "text": "アンカがいくつかある。わかった。それで、"}, {"type": "subtitle", "time": 20223.67, "timestamp": "05:37:03", "text": "これとこの2つは"}, {"type": "subtitle", "time": 20226.47, "timestamp": "05:37:06", "text": "先生がくれた語彙のやつ。"}, {"type": "subtitle", "time": 20229.75, "timestamp": "05:37:09", "text": "これ"}, {"type": "subtitle", "time": 20236.07, "timestamp": "05:37:16", "text": "あー、"}, {"type": "subtitle", "time": 20239.068, "timestamp": "05:37:19", "text": "この概念はわからない。[笑い]"}, {"type": "subtitle", "time": 20239.67, "timestamp": "05:37:19", "text": "[息を呑む]"}, {"type": "subtitle", "time": 20241.51, "timestamp": "05:37:21", "text": "不便だ。あー、"}, {"type": "subtitle", "time": 20247.51, "timestamp": "05:37:27", "text": "ベンリー、ベンリー、ベンリー、"}, {"type": "subtitle", "time": 20275.27, "timestamp": "05:37:55", "text": "ああ、そうか。アンカには"}, {"type": "subtitle", "time": 20279.59, "timestamp": "05:37:59", "text": "これらのボタンを使わないといけないんだ。難しくない、簡単。"}]
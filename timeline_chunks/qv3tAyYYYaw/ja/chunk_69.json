[{"type": "subtitle", "time": 4150.309, "timestamp": "01:09:10", "text": "。 今直しました。"}, {"type": "subtitle", "time": 4152.47, "timestamp": "01:09:12", "text": "以前の動画をご覧になっていた方には申し訳ありませんが、今、"}, {"type": "subtitle", "time": 4154.63, "timestamp": "01:09:14", "text": "遅延を修正しました"}, {"type": "subtitle", "time": 4157.91, "timestamp": "01:09:17", "text": "。 上流に戻るべきだ。"}, {"type": "subtitle", "time": 4162.229, "timestamp": "01:09:22", "text": "私の好きな果物は、えーと、"}, {"type": "subtitle", "time": 4175.269, "timestamp": "01:09:35", "text": "イチゴです。"}, {"type": "subtitle", "time": 4177.99, "timestamp": "01:09:37", "text": "こんにちは。"}, {"type": "subtitle", "time": 4179.749, "timestamp": "01:09:39", "text": "遅延を修正してください。"}, {"type": "subtitle", "time": 4182.63, "timestamp": "01:09:42", "text": "遅延の件をお知らせいただきありがとうございます。   全く"}, {"type": "subtitle", "time": 4185.669, "timestamp": "01:09:45", "text": "気づきませんでした。"}, {"type": "subtitle", "time": 4190.95, "timestamp": "01:09:50", "text": "OBSで配信を終了したので。 いいえ、"}, {"type": "subtitle", "time": 4192.709, "timestamp": "01:09:52", "text": "メルでは。 だからこそ、あなたは"}, {"type": "subtitle", "time": 4196.229, "timestamp": "01:09:56", "text": "再び役員会から歓迎されているのです。 配信を終了するとリセットされます"}, {"type": "subtitle", "time": 4198.87, "timestamp": "01:09:58", "text": "。"}]
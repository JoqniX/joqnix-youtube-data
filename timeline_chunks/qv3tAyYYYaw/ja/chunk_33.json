[{"type": "subtitle", "time": 1996.87, "timestamp": "00:33:16", "text": "私は最近このことを知りました。"}, {"type": "subtitle", "time": 2000.47, "timestamp": "00:33:20", "text": "読み方を忘れてしまった。 ああ、それは知っている"}, {"type": "subtitle", "time": 2007.35, "timestamp": "00:33:27", "text": "（笑）何人かは知っています。 何てことだ"}, {"type": "subtitle", "time": 2010.47, "timestamp": "00:33:30", "text": "。 私はこれら全てを知っています。"}, {"type": "subtitle", "time": 2014.149, "timestamp": "00:33:34", "text": "なぜ私はそのクネイの読み方を忘れてしまったのか"}, {"type": "subtitle", "time": 2017.99, "timestamp": "00:33:37", "text": "。   もうすぐ"}, {"type": "subtitle", "time": 2020.149, "timestamp": "00:33:40", "text": "76回目の期末試験があるので、緊張しています"}, {"type": "subtitle", "time": 2023.909, "timestamp": "00:33:43", "text": "。 なんてこった。 幸運を。   落ち着いて"}, {"type": "subtitle", "time": 2027.029, "timestamp": "00:33:47", "text": "、"}, {"type": "subtitle", "time": 2031.669, "timestamp": "00:33:51", "text": "兄弟。 私はこれらの漢字を知っています。  [笑い]"}, {"type": "subtitle", "time": 2039.269, "timestamp": "00:33:59", "text": "では、ちょっと待ってください。"}]
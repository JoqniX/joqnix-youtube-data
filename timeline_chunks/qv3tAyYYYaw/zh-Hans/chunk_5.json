[{"type": "subtitle", "time": 304.629, "timestamp": "00:05:04", "text": "9 10。好的。 呃，9、10、11、12、13、14、15、16、17。"}, {"type": "subtitle", "time": 309.51, "timestamp": "00:05:09", "text": "呃，今天大概会直播9个小时或者8个"}, {"type": "subtitle", "time": 313.11, "timestamp": "00:05:13", "text": "小时。 哦，我会一直做下去，"}, {"type": "subtitle", "time": 315.99, "timestamp": "00:05:15", "text": "我的意思是，我不会"}, {"type": "subtitle", "time": 319.189, "timestamp": "00:05:19", "text": "休息（不做音乐）。 我今天不会休息太多。 我"}, {"type": "subtitle", "time": 324.71, "timestamp": "00:05:24", "text": "觉得我必须像个孩子一样，把"}, {"type": "subtitle", "time": 328.31, "timestamp": "00:05:28", "text": "所有事情都赶上进度，还要"}, {"type": "subtitle", "time": 349.67, "timestamp": "00:05:49", "text": "。 一秒钟。 让我先把"}, {"type": "subtitle", "time": 355.27, "timestamp": "00:05:55", "text": "好了，"}, {"type": "subtitle", "time": 357.749, "timestamp": "00:05:57", "text": "应该可以了。 好的。 好的。"}]
[{"type": "subtitle", "time": 9786.87, "timestamp": "02:43:06", "text": "哦，"}, {"type": "subtitle", "time": 9794.15, "timestamp": "02:43:14", "text": "一些零卡路里的香蕉冰淇淋，一些"}, {"type": "subtitle", "time": 9798.79, "timestamp": "02:43:18", "text": "希腊酸奶，两勺蔬菜和"}, {"type": "subtitle", "time": 9802.07, "timestamp": "02:43:22", "text": "两勺咖啡。天哪，[笑]"}, {"type": "subtitle", "time": 9805.11, "timestamp": "02:43:25", "text": "听起来太棒了。"}, {"type": "subtitle", "time": 9811.59, "timestamp": "02:43:31", "text": "如果我能和你这样的人"}, {"type": "subtitle", "time": 9814.07, "timestamp": "02:43:34", "text": "合住，我就可以看到这些，"}, {"type": "subtitle", "time": 9817.99, "timestamp": "02:43:37", "text": "学习这些，然后自己也试试。"}, {"type": "subtitle", "time": 9819.59, "timestamp": "02:43:39", "text": "哦，"}, {"type": "subtitle", "time": 9822.23, "timestamp": "02:43:42", "text": "我在想，呃，我甚至不知道"}, {"type": "subtitle", "time": 9824.389, "timestamp": "02:43:44", "text": "我会遇到什么样的室友，"}, {"type": "subtitle", "time": 9827.11, "timestamp": "02:43:47", "text": "或者我是不是应该选择单人间。"}, {"type": "subtitle", "time": 9830.23, "timestamp": "02:43:50", "text": "就连我的老师也说，对我来说，"}, {"type": "subtitle", "time": 9831.99, "timestamp": "02:43:51", "text": "最好是"}, {"type": "subtitle", "time": 9834.95, "timestamp": "02:43:54", "text": "和别人合住，而不是"}, {"type": "subtitle", "time": 9836.07, "timestamp": "02:43:56", "text": "单人间。"}, {"type": "subtitle", "time": 9838.309, "timestamp": "02:43:58", "text": "因为你需要有人和你说话，"}]
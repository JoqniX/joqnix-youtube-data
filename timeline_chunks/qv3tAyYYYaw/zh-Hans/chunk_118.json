[{"type": "subtitle", "time": 7093.03, "timestamp": "01:58:13", "text": "好的。 你需要那个东西。 你好。"}, {"type": "subtitle", "time": 7094.55, "timestamp": "01:58:14", "text": "你会减少对内容的关注，"}, {"type": "subtitle", "time": 7095.83, "timestamp": "01:58:15", "text": "更多地关注内容之外的一切吗"}, {"type": "subtitle", "time": 7099.75, "timestamp": "01:58:19", "text": "？ 是的。 是的，我这样做。"}, {"type": "subtitle", "time": 7101.91, "timestamp": "01:58:21", "text": "直到今天，我还在思考我"}, {"type": "subtitle", "time": 7105.35, "timestamp": "01:58:25", "text": "的演唱会该如何举办？ 我将如何创作音乐？"}, {"type": "subtitle", "time": 7108.07, "timestamp": "01:58:28", "text": "我的专辑将如何发行？ 我以后要怎么"}, {"type": "subtitle", "time": 7111.51, "timestamp": "01:58:31", "text": "才能发行音乐呢？"}, {"type": "subtitle", "time": 7114.709, "timestamp": "01:58:34", "text": "我真的有能力胜任这项工作吗？"}, {"type": "subtitle", "time": 7117.51, "timestamp": "01:58:37", "text": "如果失败了怎么办？ 期望值很高，"}, {"type": "subtitle", "time": 7121.189, "timestamp": "01:58:41", "text": "模型之类的东西，"}, {"type": "subtitle", "time": 7125.75, "timestamp": "01:58:45", "text": "会发生什么？艺术家会"}, {"type": "subtitle", "time": 7129.03, "timestamp": "01:58:49", "text": "和我谈谈吗？"}, {"type": "subtitle", "time": 7131.83, "timestamp": "01:58:51", "text": "他们会抛弃我"}]
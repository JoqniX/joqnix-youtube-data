[{"type": "subtitle", "time": 7801.75, "timestamp": "02:10:01", "text": "我靠自己的努力建立了一切，"}, {"type": "subtitle", "time": 7807.669, "timestamp": "02:10:07", "text": "那么他们该来的时候自然会来。我会说，是"}, {"type": "subtitle", "time": 7809.645, "timestamp": "02:10:09", "text": "啊"}, {"type": "subtitle", "time": 7816.87, "timestamp": "02:10:16", "text": "你现在来干嘛？是"}, {"type": "subtitle", "time": 7818.79, "timestamp": "02:10:18", "text": "来找云的吗？我会说，"}, {"type": "subtitle", "time": 7824.069, "timestamp": "02:10:24", "text": "我最需要你这个朋友的时候，你却不在我身边"}, {"type": "subtitle", "time": 7827.589, "timestamp": "02:10:27", "text": "。"}, {"type": "subtitle", "time": 7829.99, "timestamp": "02:10:29", "text": "嗯，差不多就是这样。 我不"}, {"type": "subtitle", "time": 7832.95, "timestamp": "02:10:32", "text": "知道。"}, {"type": "subtitle", "time": 7849.99, "timestamp": "02:10:49", "text": "我们玩的游戏不一样，"}, {"type": "subtitle", "time": 7853.109, "timestamp": "02:10:53", "text": "完全不一样。"}, {"type": "subtitle", "time": 7855.189, "timestamp": "02:10:55", "text": "所以D，"}, {"type": "subtitle", "time": 7857.669, "timestamp": "02:10:57", "text": "如果我没理解错的话，其实我对所有类型都无所谓"}]
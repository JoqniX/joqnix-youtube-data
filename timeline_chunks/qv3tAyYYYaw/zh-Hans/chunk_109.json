[{"type": "subtitle", "time": 6544.709, "timestamp": "01:49:04", "text": "我明白了。 我的意思是，我"}, {"type": "subtitle", "time": 6554.39, "timestamp": "01:49:14", "text": "实际渲染图，因为所有的一切都是蛋糕"}, {"type": "subtitle", "time": 6557.27, "timestamp": "01:49:17", "text": "。 是啊，[笑声]"}, {"type": "subtitle", "time": 6557.99, "timestamp": "01:49:17", "text": "[倒吸一口凉气]"}, {"type": "subtitle", "time": 6564.79, "timestamp": "01:49:24", "text": "说实话，都是因为一个愚蠢的蛋糕。"}, {"type": "subtitle", "time": 6566.95, "timestamp": "01:49:26", "text": "我只是想回去看看他们。"}, {"type": "subtitle", "time": 6568.87, "timestamp": "01:49:28", "text": "你说的“回到他们身边”是什么意思？ 我之后再也没有"}, {"type": "subtitle", "time": 6571.35, "timestamp": "01:49:31", "text": "和那些人来往。"}, {"type": "subtitle", "time": 6573.35, "timestamp": "01:49:33", "text": "自从"}, {"type": "subtitle", "time": 6575.43, "timestamp": "01:49:35", "text": "我屏蔽了他们之后，所有"}, {"type": "subtitle", "time": 6580.95, "timestamp": "01:49:40", "text": "下面看到了。"}, {"type": "subtitle", "time": 6584.31, "timestamp": "01:49:44", "text": "我没有屏蔽他们。 我没有"}, {"type": "subtitle", "time": 6588.39, "timestamp": "01:49:48", "text": "和他们互动，对吧？"}, {"type": "subtitle", "time": 6590.87, "timestamp": "01:49:50", "text": "就像神话中的鲸鱼、其他生物"}, {"type": "subtitle", "time": 6595.35, "timestamp": "01:49:55", "text": "等等。 这些人大多"}, {"type": "subtitle", "time": 6598.47, "timestamp": "01:49:58", "text": "只是与此事无关的人"}]
[{"type": "subtitle", "time": 11472.389, "timestamp": "03:11:12", "text": "总之，我只会在这里待"}, {"type": "subtitle", "time": 11475.11, "timestamp": "03:11:15", "text": "四个月。我是说五个月，比如"}, {"type": "subtitle", "time": 11477.51, "timestamp": "03:11:17", "text": "十二月、一月、二月、三月"}, {"type": "subtitle", "time": 11479.51, "timestamp": "03:11:19", "text": "。四个月。十二月、一月、"}, {"type": "subtitle", "time": 11482.309, "timestamp": "03:11:22", "text": "二月、三月。我的天啊！哦，我才"}, {"type": "subtitle", "time": 11484.15, "timestamp": "03:11:24", "text": "意识到我只待"}]
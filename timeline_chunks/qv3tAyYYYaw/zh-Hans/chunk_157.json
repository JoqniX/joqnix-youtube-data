[{"type": "subtitle", "time": 9427.11, "timestamp": "02:37:07", "text": "交朋友真难啊。 我"}, {"type": "subtitle", "time": 9429.19, "timestamp": "02:37:09", "text": "不知道。 自从这一切"}, {"type": "subtitle", "time": 9431.349, "timestamp": "02:37:11", "text": "发生以来，我感觉自己内心深处仍然"}, {"type": "subtitle", "time": 9435.19, "timestamp": "02:37:15", "text": "萦绕着那段创伤的记忆。"}, {"type": "subtitle", "time": 9437.67, "timestamp": "02:37:17", "text": "所以，"}, {"type": "subtitle", "time": 9445.19, "timestamp": "02:37:25", "text": "即使我用的是另一个身份或"}, {"type": "subtitle", "time": 9451.27, "timestamp": "02:37:31", "text": "我不知道。 我其实正好相反，"}, {"type": "subtitle", "time": 9454.71, "timestamp": "02:37:34", "text": "觉得人们跟我走得太快，"}, {"type": "subtitle", "time": 9467.75, "timestamp": "02:37:47", "text": "我的意思是，当我跟别人太熟的时候，就像是在"}, {"type": "subtitle", "time": 9471.67, "timestamp": "02:37:51", "text": "跟一个认识了"}, {"type": "subtitle", "time": 9473.83, "timestamp": "02:37:53", "text": "四"}, {"type": "subtitle", "time": 9477.429, "timestamp": "02:37:57", "text": "五年的老朋友聊天一样。"}]
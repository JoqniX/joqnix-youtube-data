[{"type": "subtitle", "time": 19583.67, "timestamp": "05:26:23", "text": "哦，天哪，我今天该怎么办？我觉得"}, {"type": "subtitle", "time": 19590.628, "timestamp": "05:26:30", "text": "我想放弃。我的头"}, {"type": "subtitle", "time": 19593.75, "timestamp": "05:26:33", "text": "好痛。"}, {"type": "subtitle", "time": 19597.67, "timestamp": "05:26:37", "text": "我完全稳定了。"}, {"type": "subtitle", "time": 19603.51, "timestamp": "05:26:43", "text": "我为什么要玩游戏？我为什么没做什么？"}, {"type": "subtitle", "time": 19607.6, "timestamp": "05:26:47", "text": "我为什么没做什么？ 我觉得你的日语肯定"}, {"type": "subtitle", "time": 19610.32, "timestamp": "05:26:50", "text": "我觉得你的日语肯定 比我的演示好。我不学习也不"}, {"type": "subtitle", "time": 19614.878, "timestamp": "05:26:54", "text": "比我的演示好。我不学习也不 复习。这就是我回到基础，"}, {"type": "subtitle", "time": 19618.56, "timestamp": "05:26:58", "text": "复习。这就是我回到基础， 现在又回到零基础的原因。[笑声]"}]
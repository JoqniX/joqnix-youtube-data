[{"type": "subtitle", "time": 6720.07, "timestamp": "01:52:00", "text": "像Bread Andu"}, {"type": "subtitle", "time": 6734.79, "timestamp": "01:52:14", "text": "但是像很多人一样加入Valley"}, {"type": "subtitle", "time": 6736.149, "timestamp": "01:52:16", "text": "Speaks（笑），"}, {"type": "subtitle", "time": 6755.109, "timestamp": "01:52:35", "text": "所以他们给人一种很好的感觉，让更多"}, {"type": "subtitle", "time": 6757.109, "timestamp": "01:52:37", "text": "人愿意和他们交谈"}, {"type": "subtitle", "time": 6758.87, "timestamp": "01:52:38", "text": "。"}, {"type": "subtitle", "time": 6779.27, "timestamp": "01:52:59", "text": "你给人的感觉也很好。"}]
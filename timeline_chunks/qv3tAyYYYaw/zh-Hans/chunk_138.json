[{"type": "subtitle", "time": 8280.15, "timestamp": "02:18:00", "text": "是的，"}, {"type": "subtitle", "time": 8293.27, "timestamp": "02:18:13", "text": "艰难。"}, {"type": "subtitle", "time": 8294.629, "timestamp": "02:18:14", "text": "花费两个多小时"}, {"type": "subtitle", "time": 8320.15, "timestamp": "02:18:40", "text": "[笑声]"}, {"type": "subtitle", "time": 8327.83, "timestamp": "02:18:47", "text": "你知道，我总觉得当我还是个小不点儿的时候——不是很小很小的时候，大概"}, {"type": "subtitle", "time": 8334.23, "timestamp": "02:18:54", "text": "15、16岁，或者"}, {"type": "subtitle", "time": 8338.79, "timestamp": "02:18:58", "text": "13岁左右吧。 我一直"}]
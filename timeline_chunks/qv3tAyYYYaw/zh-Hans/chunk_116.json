[{"type": "subtitle", "time": 6961.669, "timestamp": "01:56:01", "text": "现在"}, {"type": "subtitle", "time": 6966.47, "timestamp": "01:56:06", "text": "面包看起来有点怪怪的，因为我一直把它敞开着。"}, {"type": "subtitle", "time": 6969.43, "timestamp": "01:56:09", "text": "啊，"}, {"type": "subtitle", "time": 6970.709, "timestamp": "01:56:10", "text": "你这小子在玩游戏呢。 我不确定"}, {"type": "subtitle", "time": 6972.55, "timestamp": "01:56:12", "text": "我的鼠标是否能兼容 Sammy Stream 之类的"}, {"type": "subtitle", "time": 6974.47, "timestamp": "01:56:14", "text": "设备。 是的。 是的。 我得到它。 我得到它。 我"}, {"type": "subtitle", "time": 6979.589, "timestamp": "01:56:19", "text": "打算不要做太多。 哦，"}, {"type": "subtitle", "time": 6983.589, "timestamp": "01:56:23", "text": "（叹气和倒吸一口气）我"}, {"type": "subtitle", "time": 6986.709, "timestamp": "01:56:26", "text": "大概会玩游戏，而且我"}, {"type": "subtitle", "time": 6990.149, "timestamp": "01:56:30", "text": "想重新开始做ASMR。"}, {"type": "subtitle", "time": 6993.51, "timestamp": "01:56:33", "text": "我很想念做 ASMR 的日子，但现在的问题是"}, {"type": "subtitle", "time": 6996.629, "timestamp": "01:56:36", "text": "，如果我太投入 ASMR"}, {"type": "subtitle", "time": 6999.91, "timestamp": "01:56:39", "text": "，[笑] 就很难停下来。"}, {"type": "subtitle", "time": 7002.709, "timestamp": "01:56:42", "text": "我可能会做一些不该做的事情"}, {"type": "subtitle", "time": 7004.39, "timestamp": "01:56:44", "text": "。   是的"}, {"type": "subtitle", "time": 7007.43, "timestamp": "01:56:47", "text": "。 我的意思是，这很有趣，但是，"}, {"type": "subtitle", "time": 7015.189, "timestamp": "01:56:55", "text": "展示一下让"}]
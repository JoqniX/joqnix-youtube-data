[{"type": "subtitle", "time": 20041.51, "timestamp": "05:34:01", "text": "读写和"}, {"type": "subtitle", "time": 20047.83, "timestamp": "05:34:07", "text": "一个汉字也可以有不同的意思。"}, {"type": "subtitle", "time": 20069.19, "timestamp": "05:34:29", "text": "我的头快炸了。"}, {"type": "subtitle", "time": 20072.788, "timestamp": "05:34:32", "text": "我早上6点就醒了。我从"}, {"type": "subtitle", "time": 20075.97, "timestamp": "05:34:35", "text": "几点开始做这些来着？8点，对吧？早上8点。"}, {"type": "subtitle", "time": 20078.788, "timestamp": "05:34:38", "text": "[笑] 现在是2点。我的"}, {"type": "subtitle", "time": 20083.35, "timestamp": "05:34:43", "text": "考试在6点，没有考试试卷。"}, {"type": "subtitle", "time": 20086.708, "timestamp": "05:34:46", "text": "我得"}, {"type": "subtitle", "time": 20089.59, "timestamp": "05:34:49", "text": "2、3、4、5、2、3，也就是"}, {"type": "subtitle", "time": 20094.15, "timestamp": "05:34:54", "text": "1到"}, {"type": "subtitle", "time": 20096.868, "timestamp": "05:34:56", "text": "4"}]
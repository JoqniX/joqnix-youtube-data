[{"type": "subtitle", "time": 6130.55, "timestamp": "01:42:10", "text": "我明白了，就像最近，就像"}, {"type": "subtitle", "time": 6132.07, "timestamp": "01:42:12", "text": "昨天的直播和今天的"}, {"type": "subtitle", "time": 6134.39, "timestamp": "01:42:14", "text": "直播一样，我意识到"}, {"type": "subtitle", "time": 6138.47, "timestamp": "01:42:18", "text": "他们的话是正确的。 嗯，"}, {"type": "subtitle", "time": 6141.75, "timestamp": "01:42:21", "text": "直到我的老师私"}, {"type": "subtitle", "time": 6145.83, "timestamp": "01:42:25", "text": "信我说，那个运动健将，你"}, {"type": "subtitle", "time": 6149.83, "timestamp": "01:42:29", "text": "跟"}, {"type": "subtitle", "time": 6154.79, "timestamp": "01:42:34", "text": "其他同学比起来有点落后，我才有了动力。"}, {"type": "subtitle", "time": 6157.91, "timestamp": "01:42:37", "text": "你必须先把基础知识"}, {"type": "subtitle", "time": 6160.629, "timestamp": "01:42:40", "text": "搞清楚，"}, {"type": "subtitle", "time": 6163.03, "timestamp": "01:42:43", "text": "所有那些"}, {"type": "subtitle", "time": 6165.59, "timestamp": "01:42:45", "text": "让我感觉很糟糕的事情，然后我就想，"}, {"type": "subtitle", "time": 6168.229, "timestamp": "01:42:48", "text": "好吧，我要启动诈骗"}, {"type": "subtitle", "time": 6169.99, "timestamp": "01:42:49", "text": "感觉，"}, {"type": "subtitle", "time": 6173.83, "timestamp": "01:42:53", "text": "实际上他很好，"}]
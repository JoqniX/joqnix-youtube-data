[{"type": "subtitle", "time": 9362.87, "timestamp": "02:36:02", "text": "我不会像同学那样和我的朋友一起去，"}, {"type": "subtitle", "time": 9365.19, "timestamp": "02:36:05", "text": "我会和"}, {"type": "subtitle", "time": 9367.51, "timestamp": "02:36:07", "text": "一起去"}, {"type": "subtitle", "time": 9370.469, "timestamp": "02:36:10", "text": "学校的，就像从印度到日本那样。我"}, {"type": "subtitle", "time": 9373.67, "timestamp": "02:36:13", "text": "不会和他们说太多话，所以"}, {"type": "subtitle", "time": 9375.99, "timestamp": "02:36:15", "text": "我父亲也说要和"}, {"type": "subtitle", "time": 9379.51, "timestamp": "02:36:19", "text": "外国人交流，和他们交朋友，这样你就"}, {"type": "subtitle", "time": 9381.59, "timestamp": "02:36:21", "text": "可以练习英语和日语，"}, {"type": "subtitle", "time": 9384.95, "timestamp": "02:36:24", "text": "主要和日本人交朋友，"}, {"type": "subtitle", "time": 9387.83, "timestamp": "02:36:27", "text": "不要和你当地的"}, {"type": "subtitle", "time": 9391.11, "timestamp": "02:36:31", "text": "印度人一起，因为你会习惯那种环境，"}, {"type": "subtitle", "time": 9392.87, "timestamp": "02:36:32", "text": "然后你就不会和"}, {"type": "subtitle", "time": 9396.469, "timestamp": "02:36:36", "text": "其他地方的人交流了。 对，它会像这样呈"}, {"type": "subtitle", "time": 9405.11, "timestamp": "02:36:45", "text": "。 他就是这么说的。"}, {"type": "subtitle", "time": 9407.59, "timestamp": "02:36:47", "text": "你知道我英语这么"}, {"type": "subtitle", "time": 9411.03, "timestamp": "02:36:51", "text": "好的原因吗？那是因为我有很多"}, {"type": "subtitle", "time": 9415.03, "timestamp": "02:36:55", "text": "美国和英国的朋友。 嘿，"}]
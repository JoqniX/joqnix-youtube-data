[{"type": "subtitle", "time": 8342.79, "timestamp": "02:19:02", "text": "想要一个像多利蒙一样的伙伴，但当"}, {"type": "subtitle", "time": 8345.27, "timestamp": "02:19:05", "text": "我意识到多利蒙并不存在，"}, {"type": "subtitle", "time": 8348.629, "timestamp": "02:19:08", "text": "它不会像"}, {"type": "subtitle", "time": 8352.15, "timestamp": "02:19:12", "text": "最好的朋友那样来拯救我时，我"}, {"type": "subtitle", "time": 8354.629, "timestamp": "02:19:14", "text": "意识到，是的，我孤身一人。 我必须"}, {"type": "subtitle", "time": 8357.349, "timestamp": "02:19:17", "text": "继续生活。"}, {"type": "subtitle", "time": 8371.99, "timestamp": "02:19:31", "text": "所以，我参加了一门商科课程，"}, {"type": "subtitle", "time": 8386.309, "timestamp": "02:19:46", "text": "我知道哪里能真正赚钱。"}]
[{"type": "subtitle", "time": 7629.03, "timestamp": "02:07:09", "text": "但是，呃，我不知道是谁说的，"}, {"type": "subtitle", "time": 7631.91, "timestamp": "02:07:11", "text": "我不知道是谁"}, {"type": "subtitle", "time": 7634.55, "timestamp": "02:07:14", "text": "跟你说的。 感觉我还在尝试"}, {"type": "subtitle", "time": 7638.47, "timestamp": "02:07:18", "text": "和他们沟通什么的，但实际上并没有。"}, {"type": "subtitle", "time": 7641.27, "timestamp": "02:07:21", "text": "啊，你根本不知道，伙计。 错误信息时有"}, {"type": "subtitle", "time": 7642.95, "timestamp": "02:07:22", "text": "发生。"}, {"type": "subtitle", "time": 7647.27, "timestamp": "02:07:27", "text": "这是我在这个社区里注意到的。"}, {"type": "subtitle", "time": 7650.629, "timestamp": "02:07:30", "text": "人们总是胡编乱造。"}, {"type": "subtitle", "time": 7652.709, "timestamp": "02:07:32", "text": "还没有。"}, {"type": "subtitle", "time": 7655.03, "timestamp": "02:07:35", "text": "我总是事后才尝试，"}, {"type": "subtitle", "time": 7657.83, "timestamp": "02:07:37", "text": "比如在我的视频"}, {"type": "subtitle", "time": 7661.35, "timestamp": "02:07:41", "text": "发布之后，或者像那样。"}, {"type": "subtitle", "time": 7665.669, "timestamp": "02:07:45", "text": "不，我从来没有尝试过回到他们身边。"}, {"type": "subtitle", "time": 7669.51, "timestamp": "02:07:49", "text": "你的意思是，嗯，是我在"}, {"type": "subtitle", "time": 7673.75, "timestamp": "02:07:53", "text": "会议结束后，当面质问他们吗"}, {"type": "subtitle", "time": 7677.03, "timestamp": "02:07:57", "text": "？"}]
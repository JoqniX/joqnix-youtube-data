[{"type": "subtitle", "time": 4680.149, "timestamp": "01:18:00", "text": "很久以前，他们中的一些人确实有点烦人"}, {"type": "subtitle", "time": 4681.91, "timestamp": "01:18:01", "text": "。 好的。 我不知道他们是否还在"}, {"type": "subtitle", "time": 4692.55, "timestamp": "01:18:12", "text": "当然，我最初想要的是，"}, {"type": "subtitle", "time": 4700.31, "timestamp": "01:18:20", "text": "呃，最初想要的是，"}, {"type": "subtitle", "time": 4703.43, "timestamp": "01:18:23", "text": "呃，就像我，是的。 某种程度上，我希望"}, {"type": "subtitle", "time": 4705.669, "timestamp": "01:18:25", "text": "我的内容能够被所有"}, {"type": "subtitle", "time": 4707.59, "timestamp": "01:18:27", "text": "年龄段的人接受。"}, {"type": "subtitle", "time": 4709.27, "timestamp": "01:18:29", "text": "无论你是孩子、"}, {"type": "subtitle", "time": 4712.95, "timestamp": "01:18:32", "text": "年轻人、成年人、青少年、"}, {"type": "subtitle", "time": 4716.229, "timestamp": "01:18:36", "text": "老年人，或者"}, {"type": "subtitle", "time": 4719.669, "timestamp": "01:18:39", "text": "任何年龄，只要有人觉得"}, {"type": "subtitle", "time": 4723.43, "timestamp": "01:18:43", "text": "好玩就行，所以我"}, {"type": "subtitle", "time": 4727.75, "timestamp": "01:18:47", "text": "不希望限制它，"}, {"type": "subtitle", "time": 4731.91, "timestamp": "01:18:51", "text": "因为我自己很少说"}, {"type": "subtitle", "time": 4738.47, "timestamp": "01:18:58", "text": "脏话，除非我不小心说出口。 嗯，"}]
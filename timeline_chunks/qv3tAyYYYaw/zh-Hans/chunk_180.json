[{"type": "subtitle", "time": 10802.15, "timestamp": "03:00:02", "text": "你知道，我的空调"}, {"type": "subtitle", "time": 10805.269, "timestamp": "03:00:05", "text": "有时候就像……就像开着一会儿。它会自动"}, {"type": "subtitle", "time": 10809.51, "timestamp": "03:00:09", "text": "关掉又打开，"}, {"type": "subtitle", "time": 10814.07, "timestamp": "03:00:14", "text": "就像…… 它想干嘛就干嘛。"}, {"type": "subtitle", "time": 10816.95, "timestamp": "03:00:16", "text": "我不知道它怎么了。"}, {"type": "subtitle", "time": 10818.71, "timestamp": "03:00:18", "text": "比如现在，我把它打开。好的。"}, {"type": "subtitle", "time": 10820.469, "timestamp": "03:00:20", "text": "几分钟后，它会自动"}, {"type": "subtitle", "time": 10823.75, "timestamp": "03:00:23", "text": "关机，然后又开机，"}, {"type": "subtitle", "time": 10827.83, "timestamp": "03:00:27", "text": "再关机，再开机。"}, {"type": "subtitle", "time": 10830.55, "timestamp": "03:00:30", "text": "有时候，它明明是关着的，却又"}, {"type": "subtitle", "time": 10833.51, "timestamp": "03:00:33", "text": "会自动开机，然后"}, {"type": "subtitle", "time": 10835.67, "timestamp": "03:00:35", "text": "再关掉。真是"}]
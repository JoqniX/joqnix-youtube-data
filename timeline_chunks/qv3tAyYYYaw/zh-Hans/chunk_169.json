[{"type": "subtitle", "time": 10143.269, "timestamp": "02:49:03", "text": "我都会接受。然后明天，或者"}, {"type": "subtitle", "time": 10146.87, "timestamp": "02:49:06", "text": "今晚下课后，我们会"}, {"type": "subtitle", "time": 10149.67, "timestamp": "02:49:09", "text": "继续。继续练习"}, {"type": "subtitle", "time": 10153.59, "timestamp": "02:49:13", "text": "praasing praas。对。有 还有"}, {"type": "subtitle", "time": 10157.19, "timestamp": "02:49:17", "text": "好多汉字要学。对。是的。老师"}, {"type": "subtitle", "time": 10159.83, "timestamp": "02:49:19", "text": "还有好多汉字"}, {"type": "subtitle", "time": 10164.309, "timestamp": "02:49:24", "text": "要学。嗯，"}, {"type": "subtitle", "time": 10168.71, "timestamp": "02:49:28", "text": "复习的内容"}, {"type": "subtitle", "time": 10172.15, "timestamp": "02:49:32", "text": "下周或者这周应该会"}, {"type": "subtitle", "time": 10175.99, "timestamp": "02:49:35", "text": "正式复习，因为考试马上就要到了。"}, {"type": "subtitle", "time": 10178.95, "timestamp": "02:49:38", "text": "所以他既要上复习课，又要上"}, {"type": "subtitle", "time": 10183.83, "timestamp": "02:49:43", "text": "考前辅导课。唉，真是笨死了，"}, {"type": "subtitle", "time": 10189.99, "timestamp": "02:49:49", "text": "我只能硬着头皮上了"}, {"type": "subtitle", "time": 10192.55, "timestamp": "02:49:52", "text": "。"}, {"type": "subtitle", "time": 10194.63, "timestamp": "02:49:54", "text": "就算我不参加十二月的考试，而是"}]
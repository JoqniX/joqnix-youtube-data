[{"type": "subtitle", "time": 8880.309, "timestamp": "02:28:00", "text": "。 出去走走，到"}, {"type": "subtitle", "time": 8882.63, "timestamp": "02:28:02", "text": "外面吃饭什么的。 不要总是依赖"}, {"type": "subtitle", "time": 8886.469, "timestamp": "02:28:06", "text": "家常菜。 偶尔出去吃顿饭"}, {"type": "subtitle", "time": 8892.79, "timestamp": "02:28:12", "text": "但我太懒了，不想出门。"}, {"type": "subtitle", "time": 8894.992, "timestamp": "02:28:14", "text": "所以，"}, {"type": "subtitle", "time": 8896.302, "timestamp": "02:28:16", "text": "[笑声]"}, {"type": "subtitle", "time": 8908.63, "timestamp": "02:28:28", "text": "他们只希望我不要陷入"}, {"type": "subtitle", "time": 8915.349, "timestamp": "02:28:35", "text": "没错，那是他们最不想"}, {"type": "subtitle", "time": 8923.11, "timestamp": "02:28:43", "text": "表兄弟姐妹就像是"}, {"type": "subtitle", "time": 8925.91, "timestamp": "02:28:45", "text": "瘾君子之类的。 他们毁了"}, {"type": "subtitle", "time": 8934.469, "timestamp": "02:28:54", "text": "，"}, {"type": "subtitle", "time": 8936.55, "timestamp": "02:28:56", "text": "这就是为什么我父母不希望我陷入"}, {"type": "subtitle", "time": 8938.63, "timestamp": "02:28:58", "text": "那种友谊"}]
[{"type": "subtitle", "time": 7201.75, "timestamp": "02:00:01", "text": "事，然后说我要"}, {"type": "subtitle", "time": 7204.31, "timestamp": "02:00:04", "text": "回来了，但是为什么我一直没有发布"}, {"type": "subtitle", "time": 7207.03, "timestamp": "02:00:07", "text": "视频呢？ 短裤呢？ 我什么时候"}, {"type": "subtitle", "time": 7209.589, "timestamp": "02:00:09", "text": "开始剪辑？ 我不能总是"}, {"type": "subtitle", "time": 7212.55, "timestamp": "02:00:12", "text": "依赖观众在"}, {"type": "subtitle", "time": 7215.27, "timestamp": "02:00:15", "text": "YouTube 和 Twitch 上点赞视频片段，然后把这些"}, {"type": "subtitle", "time": 7217.43, "timestamp": "02:00:17", "text": "片段剪辑成短片。 现在我得"}, {"type": "subtitle", "time": 7220.229, "timestamp": "02:00:20", "text": "找到属于自己的路了。 我不能"}, {"type": "subtitle", "time": 7223.99, "timestamp": "02:00:23", "text": "总是依赖它。"}, {"type": "subtitle", "time": 7230.149, "timestamp": "02:00:30", "text": "所有那些东西。"}, {"type": "subtitle", "time": 7232.55, "timestamp": "02:00:32", "text": "我什么时候会发布我的日语"}, {"type": "subtitle", "time": 7235.27, "timestamp": "02:00:35", "text": "自我介绍视频？ 我一直都想这么做"}, {"type": "subtitle", "time": 7238.87, "timestamp": "02:00:38", "text": "，老兄。"}, {"type": "subtitle", "time": 7241.51, "timestamp": "02:00:41", "text": "我一直……我甚至连频道"}, {"type": "subtitle", "time": 7244.229, "timestamp": "02:00:44", "text": "介绍都没有。"}, {"type": "subtitle", "time": 7246.993, "timestamp": "02:00:46", "text": "我连频道介绍都没有。"}, {"type": "subtitle", "time": 7248.709, "timestamp": "02:00:48", "text": "[笑声]"}, {"type": "subtitle", "time": 7251.51, "timestamp": "02:00:51", "text": "请"}, {"type": "subtitle", "time": 7254.55, "timestamp": "02:00:54", "text": "编辑很贵的。"}]
[{"type": "subtitle", "time": 6906.47, "timestamp": "01:55:06", "text": "这是一件事。 我打算"}, {"type": "subtitle", "time": 6912.284, "timestamp": "01:55:12", "text": "12月开始直播。 哦，不。 我们走吧。"}, {"type": "subtitle", "time": 6913.91, "timestamp": "01:55:13", "text": "[笑声]"}, {"type": "subtitle", "time": 6917.99, "timestamp": "01:55:17", "text": "过来等着。 我会尽量抽空过来"}, {"type": "subtitle", "time": 6920.709, "timestamp": "01:55:20", "text": "。"}, {"type": "subtitle", "time": 6927.35, "timestamp": "01:55:27", "text": "[叹气]"}, {"type": "subtitle", "time": 6935.99, "timestamp": "01:55:35", "text": "我会尽量多用无线电通讯。 嘿，"}, {"type": "subtitle", "time": 6938.629, "timestamp": "01:55:38", "text": "不用，你不需要。 别这么做"}, {"type": "subtitle", "time": 6941.83, "timestamp": "01:55:41", "text": "。 没关系（笑）。"}, {"type": "subtitle", "time": 6944.55, "timestamp": "01:55:44", "text": "不用担心。 达科塔，"}, {"type": "subtitle", "time": 6947.655, "timestamp": "01:55:47", "text": "没关系。 一切都好。"}, {"type": "subtitle", "time": 6952.95, "timestamp": "01:55:52", "text": "我的天哪，那个面包。 吃完面包后，"}, {"type": "subtitle", "time": 6957.99, "timestamp": "01:55:57", "text": "我的喉咙[音乐]变得很干。"}]
[{"type": "subtitle", "time": 5945.75, "timestamp": "01:39:05", "text": "优先级始终保持稳定也并非易事"}, {"type": "subtitle", "time": 5948.31, "timestamp": "01:39:08", "text": "。 是的。"}, {"type": "subtitle", "time": 5950.55, "timestamp": "01:39:10", "text": "正如你所说，现在这一切都变成了"}, {"type": "subtitle", "time": 5952.87, "timestamp": "01:39:12", "text": "现实。 它。 我认为 Sammy 的事情最多需要"}, {"type": "subtitle", "time": 5956.95, "timestamp": "01:39:16", "text": "三到两周的时间。 我"}, {"type": "subtitle", "time": 5960.229, "timestamp": "01:39:20", "text": "之前并没有这种感觉。  [笑声]"}, {"type": "subtitle", "time": 5962.79, "timestamp": "01:39:22", "text": "搞定了。 但是，我内心深处其实想的是，"}, {"type": "subtitle", "time": 5965.03, "timestamp": "01:39:25", "text": "我不想在"}, {"type": "subtitle", "time": 5968.709, "timestamp": "01:39:28", "text": "直播中这么做。 我想在想做的时候做"}, {"type": "subtitle", "time": 5972.47, "timestamp": "01:39:32", "text": "，不想着急。 我知道"}, {"type": "subtitle", "time": 5984.87, "timestamp": "01:39:44", "text": "我不应该感到惊讶。"}, {"type": "subtitle", "time": 5987.109, "timestamp": "01:39:47", "text": "我不知道为什么那么多人"}, {"type": "subtitle", "time": 5990.709, "timestamp": "01:39:50", "text": "能像读一本书一样了解我。"}]
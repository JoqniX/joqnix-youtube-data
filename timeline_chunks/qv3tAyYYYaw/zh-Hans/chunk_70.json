[{"type": "subtitle", "time": 4211.669, "timestamp": "01:10:11", "text": "三次尝试。 我不知道。"}, {"type": "subtitle", "time": 4214.149, "timestamp": "01:10:14", "text": "我不是什么都喜欢。 葡萄、"}, {"type": "subtitle", "time": 4218.229, "timestamp": "01:10:18", "text": "水果、苹果。 或者橙子、香蕉、"}, {"type": "subtitle", "time": 4220.31, "timestamp": "01:10:20", "text": "草莓之类的，"}, {"type": "subtitle", "time": 4230.028, "timestamp": "01:10:30", "text": "我喜欢冰淇淋的口味和配料"}, {"type": "subtitle", "time": 4233.27, "timestamp": "01:10:33", "text": "。 昨天我真的"}, {"type": "subtitle", "time": 4238.31, "timestamp": "01:10:38", "text": "吃了那个橙色的……呃，番茄……"}, {"type": "subtitle", "time": 4241.83, "timestamp": "01:10:41", "text": "呃，帕尔马"}, {"type": "subtitle", "time": 4243.83, "timestamp": "01:10:43", "text": "干酪…… 我"}, {"type": "subtitle", "time": 4246.39, "timestamp": "01:10:46", "text": "现在就把它放在桌子上。"}, {"type": "subtitle", "time": 4253.11, "timestamp": "01:10:53", "text": "现在就一个小小的橙子。"}]
[{"type": "subtitle", "time": 16381.59, "timestamp": "04:33:01", "text": "就是这样。Am现在这么说，"}, {"type": "subtitle", "time": 16384.39, "timestamp": "04:33:04", "text": "真的触动了我。"}, {"type": "subtitle", "time": 16388.551, "timestamp": "04:33:08", "text": "让我感到难过。"}, {"type": "subtitle", "time": 16391.75, "timestamp": "04:33:11", "text": "我当时想，天哪，"}, {"type": "subtitle", "time": 16394.789, "timestamp": "04:33:14", "text": "我真的落后了。"}, {"type": "subtitle", "time": 16398.709, "timestamp": "04:33:18", "text": "我得打好基础。我"}, {"type": "subtitle", "time": 16401.59, "timestamp": "04:33:21", "text": "得做……我得做"}, {"type": "subtitle", "time": 16403.67, "timestamp": "04:33:23", "text": "语法。我得做那些句子"}, {"type": "subtitle", "time": 16406.31, "timestamp": "04:33:26", "text": "练习。我得……是"}, {"type": "subtitle", "time": 16409.91, "timestamp": "04:33:29", "text": "啊，我得认真学习，"}, {"type": "subtitle", "time": 16424.869, "timestamp": "04:33:44", "text": "是啊，我真希望我当初能像现在这样"}, {"type": "subtitle", "time": 16427.429, "timestamp": "04:33:47", "text": "学习。现在"}, {"type": "subtitle", "time": 16431.67, "timestamp": "04:33:51", "text": "我真希望我当初读大学的时候也能这样"}, {"type": "subtitle", "time": 16439.91, "timestamp": "04:33:59", "text": "所以，你应该感到后悔。"}]
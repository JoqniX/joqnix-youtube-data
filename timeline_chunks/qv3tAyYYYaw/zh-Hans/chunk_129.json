[{"type": "subtitle", "time": 7744.31, "timestamp": "02:09:04", "text": "我不知道人们会想要什么，嗯，"}, {"type": "subtitle", "time": 7747.27, "timestamp": "02:09:07", "text": "这确实很伤人，"}, {"type": "subtitle", "time": 7750.31, "timestamp": "02:09:10", "text": "嗯，就像它蔓延到很多人身上一样，"}, {"type": "subtitle", "time": 7754.629, "timestamp": "02:09:14", "text": "而我真正想与之互动的人现在都"}, {"type": "subtitle", "time": 7757.35, "timestamp": "02:09:17", "text": "不再与我互动了"}, {"type": "subtitle", "time": 7760.79, "timestamp": "02:09:20", "text": "。 我想和你们一起创作内容，"}, {"type": "subtitle", "time": 7762.629, "timestamp": "02:09:22", "text": "但"}, {"type": "subtitle", "time": 7764.79, "timestamp": "02:09:24", "text": "不想再和你们互动了。 这很"}, {"type": "subtitle", "time": 7767.99, "timestamp": "02:09:27", "text": "伤人，但事情就是这样。"}, {"type": "subtitle", "time": 7771.03, "timestamp": "02:09:31", "text": "然后我想到了利用慢性"}, {"type": "subtitle", "time": 7773.51, "timestamp": "02:09:33", "text": "城市。 我当时就想，是啊，她也经历过"}, {"type": "subtitle", "time": 7775.99, "timestamp": "02:09:35", "text": "一些风风雨雨之类的事情"}, {"type": "subtitle", "time": 7779.03, "timestamp": "02:09:39", "text": "。 不，后来当她……当"}, {"type": "subtitle", "time": 7785.75, "timestamp": "02:09:45", "text": "她变得更有名的时候，那些"}, {"type": "subtitle", "time": 7787.589, "timestamp": "02:09:47", "text": "不再和她说话的人开始和她[音乐]"}, {"type": "subtitle", "time": 7790.47, "timestamp": "02:09:50", "text": "说话了。 不。所以我就想，是啊，"}, {"type": "subtitle", "time": 7794.149, "timestamp": "02:09:54", "text": "也许有一天，如果我做得好，"}, {"type": "subtitle", "time": 7797.03, "timestamp": "02:09:57", "text": "我的努力得到了回报，我达到了一个"}, {"type": "subtitle", "time": 7799.189, "timestamp": "02:09:59", "text": "好的高度，"}]
[{"type": "subtitle", "time": 7380.39, "timestamp": "02:03:00", "text": "是的，我感觉自己仍然陷入了"}, {"type": "subtitle", "time": 7387.669, "timestamp": "02:03:07", "text": "2020年到2021年、2020年、2020年到"}, {"type": "subtitle", "time": 7390.79, "timestamp": "02:03:10", "text": "2022年的循环中，"}, {"type": "subtitle", "time": 7393.189, "timestamp": "02:03:13", "text": "我一直在为一些"}, {"type": "subtitle", "time": 7395.83, "timestamp": "02:03:15", "text": "我无法"}, {"type": "subtitle", "time": 7399.589, "timestamp": "02:03:19", "text": "控制的小事，甚至是我还没开始做的事情而焦虑。"}, {"type": "subtitle", "time": 7403.54, "timestamp": "02:03:23", "text": "哎，我还是老样子。"}, {"type": "subtitle", "time": 7404.229, "timestamp": "02:03:24", "text": "[倒吸一口气]"}, {"type": "subtitle", "time": 7422.55, "timestamp": "02:03:42", "text": "那个看起来像章鱼哥。"}, {"type": "subtitle", "time": 7433.27, "timestamp": "02:03:53", "text": "哦，我在哪里做的，就像更多"}]
[{"type": "subtitle", "time": 6604.55, "timestamp": "01:50:04", "text": "我为什么要伤害自己却还要表现出来？ 等等，什么？ 我之后"}, {"type": "subtitle", "time": 6606.709, "timestamp": "01:50:06", "text": "没有再和他们接触。 什么？"}, {"type": "subtitle", "time": 6611.03, "timestamp": "01:50:11", "text": "不，我已经把它们全部屏蔽了。"}, {"type": "subtitle", "time": 6619.669, "timestamp": "01:50:19", "text": "如果我没记错的话，我提到的所有人的名字我都已经拉黑了。"}, {"type": "subtitle", "time": 6623.189, "timestamp": "01:50:23", "text": "有些我直接把他们静音了。"}, {"type": "subtitle", "time": 6630.229, "timestamp": "01:50:30", "text": "我只和Astra互动过，"}, {"type": "subtitle", "time": 6633.109, "timestamp": "01:50:33", "text": "然后"}, {"type": "subtitle", "time": 6637.109, "timestamp": "01:50:37", "text": "因为那个合作项目，也就是"}, {"type": "subtitle", "time": 6641.03, "timestamp": "01:50:41", "text": "万圣节派对，"}, {"type": "subtitle", "time": 6643.75, "timestamp": "01:50:43", "text": "我们三个，Astra、Jasmine"}, {"type": "subtitle", "time": 6646.31, "timestamp": "01:50:46", "text": "和Yoshini一起"}, {"type": "subtitle", "time": 6653.99, "timestamp": "01:50:53", "text": "Suryaun也会来我的直播间。 是的，"}, {"type": "subtitle", "time": 6658.149, "timestamp": "01:50:58", "text": "苏里亚。 然后是橙味烈酒。"}]
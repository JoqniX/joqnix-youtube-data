[{"type": "subtitle", "time": 3603.19, "timestamp": "01:00:03", "text": "我今天得速通这个游戏。 所以"}, {"type": "subtitle", "time": 3609.27, "timestamp": "01:00:09", "text": "只要我不忘记，我打算稍微加快速度。 如果我"}, {"type": "subtitle", "time": 3611.75, "timestamp": "01:00:11", "text": "忘记了，我会不断地复习、"}, {"type": "subtitle", "time": 3613.75, "timestamp": "01:00:13", "text": "练习、再练习，"}, {"type": "subtitle", "time": 3628.15, "timestamp": "01:00:28", "text": "我真的能理解为什么其他"}, {"type": "subtitle", "time": 3630.549, "timestamp": "01:00:30", "text": "人说我"}, {"type": "subtitle", "time": 3633.27, "timestamp": "01:00:33", "text": "落后太多了，"}, {"type": "subtitle", "time": 3635.589, "timestamp": "01:00:35", "text": "因为我甚至把所有东西都忘了"}, {"type": "subtitle", "time": 3639.589, "timestamp": "01:00:39", "text": "。 连字都看不懂。"}, {"type": "subtitle", "time": 3643.03, "timestamp": "01:00:43", "text": "不，我知道，但我没有复习。 现在"}, {"type": "subtitle", "time": 3648.47, "timestamp": "01:00:48", "text": "我明白了自己目前的水平。"}, {"type": "subtitle", "time": 3652.95, "timestamp": "01:00:52", "text": "我的天啊。 如果我听了，"}]
[{"type": "subtitle", "time": 16152.389, "timestamp": "04:29:12", "text": "你知道，"}, {"type": "subtitle", "time": 16160.87, "timestamp": "04:29:20", "text": "比如说，你有"}, {"type": "subtitle", "time": 16163.51, "timestamp": "04:29:23", "text": "一份工作，比如计算机之类的，"}, {"type": "subtitle", "time": 16166.389, "timestamp": "04:29:26", "text": "然后你"}, {"type": "subtitle", "time": 16169.349, "timestamp": "04:29:29", "text": "在日本找到了一份工作，他们会"}, {"type": "subtitle", "time": 16171.349, "timestamp": "04:29:31", "text": "赞助你什么的。不，"}, {"type": "subtitle", "time": 16173.11, "timestamp": "04:29:33", "text": "他们只是要求你"}, {"type": "subtitle", "time": 16176.55, "timestamp": "04:29:36", "text": "学日语。是啊，有"}, {"type": "subtitle", "time": 16178.55, "timestamp": "04:29:38", "text": "一种学生就是这样，对他们来说没"}, {"type": "subtitle", "time": 16186.71, "timestamp": "04:29:46", "text": "，对他们来说没问题。他们觉得"}, {"type": "subtitle", "time": 16190.389, "timestamp": "04:29:50", "text": "一切都很好，对吧？"}, {"type": "subtitle", "time": 16193.83, "timestamp": "04:29:53", "text": "但对其他人来说，你必须在那里努力，"}, {"type": "subtitle", "time": 16198.95, "timestamp": "04:29:58", "text": "因为印度背景在那里不太重要。"}]
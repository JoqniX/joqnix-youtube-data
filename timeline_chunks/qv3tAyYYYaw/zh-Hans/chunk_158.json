[{"type": "subtitle", "time": 9480.15, "timestamp": "02:38:00", "text": "有人跟我说："}, {"type": "subtitle", "time": 9483.03, "timestamp": "02:38:03", "text": "“是啊，你跟Jock说话太随意了"}, {"type": "subtitle", "time": 9486.309, "timestamp": "02:38:06", "text": "。"}, {"type": "subtitle", "time": 9488.15, "timestamp": "02:38:08", "text": "感觉我们像是失散多年的老朋友似的，"}, {"type": "subtitle", "time": 9492.23, "timestamp": "02:38:12", "text": "尽管我们才认识一个小时"}, {"type": "subtitle", "time": 9493.99, "timestamp": "02:38:13", "text": "。”"}, {"type": "subtitle", "time": 9502.469, "timestamp": "02:38:22", "text": "需要保护。还有，"}, {"type": "subtitle", "time": 9504.71, "timestamp": "02:38:24", "text": "比如"}, {"type": "subtitle", "time": 9507.67, "timestamp": "02:38:27", "text": "界限、熟人关系、"}, {"type": "subtitle", "time": 9515.75, "timestamp": "02:38:35", "text": "即使我的治疗师也让我慢慢"}, {"type": "subtitle", "time": 9520.07, "timestamp": "02:38:40", "text": "练习保持亲密圈子，但"}, {"type": "subtitle", "time": 9524.07, "timestamp": "02:38:44", "text": "我还是把它抛到脑后了，结果就成了现在这样"}, {"type": "subtitle", "time": 9527.51, "timestamp": "02:38:47", "text": "。我当时"}, {"type": "subtitle", "time": 9530.469, "timestamp": "02:38:50", "text": "应该坚持练习保持个人"}, {"type": "subtitle", "time": 9533.19, "timestamp": "02:38:53", "text": "界限和空间的"}]
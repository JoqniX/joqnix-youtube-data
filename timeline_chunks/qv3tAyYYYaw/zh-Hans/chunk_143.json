[{"type": "subtitle", "time": 8580.95, "timestamp": "02:23:00", "text": "我在MMO"}, {"type": "subtitle", "time": 8584.309, "timestamp": "02:23:04", "text": "游戏里那样，对吧？  MMO游戏就像是"}, {"type": "subtitle", "time": 8585.99, "timestamp": "02:23:05", "text": "你要完成任务，和NPC对话"}, {"type": "subtitle", "time": 8588.95, "timestamp": "02:23:08", "text": "，完成他们给你的各种任务"}, {"type": "subtitle", "time": 8590.87, "timestamp": "02:23:10", "text": "，对吧？ 与此类似，我必须不断地"}, {"type": "subtitle", "time": 8594.55, "timestamp": "02:23:14", "text": "与人交谈，了解"}, {"type": "subtitle", "time": 8598.389, "timestamp": "02:23:18", "text": "他们的经历，明白"}, {"type": "subtitle", "time": 8601.19, "timestamp": "02:23:21", "text": "这就是我应该学习人生的方式。 它甚至都不是大型"}, {"type": "subtitle", "time": 8604.169, "timestamp": "02:23:24", "text": "多人在线游戏。 嘿，"}, {"type": "subtitle", "time": 8605.75, "timestamp": "02:23:25", "text": "[笑声]"}, {"type": "subtitle", "time": 8619.429, "timestamp": "02:23:39", "text": "我好怀念玩《最终幻想14》的日子啊，"}, {"type": "subtitle", "time": 8622.23, "timestamp": "02:23:42", "text": "那真是太好玩了。"}, {"type": "subtitle", "time": 8623.91, "timestamp": "02:23:43", "text": "如果你想了解生活，就必须"}, {"type": "subtitle", "time": 8626.469, "timestamp": "02:23:46", "text": "体验生活。 是的。"}, {"type": "subtitle", "time": 8634.87, "timestamp": "02:23:54", "text": "所以D"}]
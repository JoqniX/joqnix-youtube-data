[{"type": "subtitle", "time": 4991.43, "timestamp": "01:23:11", "text": "呃，即使我以后成了大人物，我也"}, {"type": "subtitle", "time": 4994.31, "timestamp": "01:23:14", "text": "不想失去这种联系，或者说"}, {"type": "subtitle", "time": 4997.91, "timestamp": "01:23:17", "text": "这种互动。说"}, {"type": "subtitle", "time": 5003.99, "timestamp": "01:23:23", "text": "我觉得如果没有"}, {"type": "subtitle", "time": 5007.51, "timestamp": "01:23:27", "text": "互动，那就什么都没有了。"}, {"type": "subtitle", "time": 5022.87, "timestamp": "01:23:42", "text": "你是什么意思？"}, {"type": "subtitle", "time": 5037.189, "timestamp": "01:23:57", "text": "[笑声] 是的"}]
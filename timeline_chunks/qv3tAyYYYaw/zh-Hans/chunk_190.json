[{"type": "subtitle", "time": 11410.389, "timestamp": "03:10:10", "text": "你赢了吗？[音乐]"}, {"type": "subtitle", "time": 11419.03, "timestamp": "03:10:19", "text": "好的，太好了。"}, {"type": "subtitle", "time": 11422.79, "timestamp": "03:10:22", "text": "我的显示器出故障了。"}, {"type": "subtitle", "time": 11426.309, "timestamp": "03:10:26", "text": "我从亚马逊买了Zabronx的，"}, {"type": "subtitle", "time": 11429.269, "timestamp": "03:10:29", "text": "165Hz的。"}, {"type": "subtitle", "time": 11433.11, "timestamp": "03:10:33", "text": "哦，它就像在闪烁，还出现了线条"}, {"type": "subtitle", "time": 11435.75, "timestamp": "03:10:35", "text": "。"}, {"type": "subtitle", "time": 11437.99, "timestamp": "03:10:37", "text": "好多画面都坏了。所以，你那边怎么回事"}, {"type": "subtitle", "time": 11445.75, "timestamp": "03:10:45", "text": "因为我没关机，所以就关了"}, {"type": "subtitle", "time": 11452.87, "timestamp": "03:10:52", "text": "而且它的显示端口线"}, {"type": "subtitle", "time": 11458.55, "timestamp": "03:10:58", "text": "也有点松动了。所以，还有"}]
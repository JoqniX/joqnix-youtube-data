[{"type": "subtitle", "time": 15900.79, "timestamp": "04:25:00", "text": "学分 分数。不，是"}, {"type": "subtitle", "time": 15903.573, "timestamp": "04:25:03", "text": "信用评分。不，不是为了签证。"}, {"type": "subtitle", "time": 15904.229, "timestamp": "04:25:04", "text": "[音乐]"}, {"type": "subtitle", "time": 15908.389, "timestamp": "04:25:08", "text": "我需要更新我的"}, {"type": "subtitle", "time": 15911.75, "timestamp": "04:25:11", "text": "签证，对吧？嗯，"}, {"type": "subtitle", "time": 15915.51, "timestamp": "04:25:15", "text": "如果……你看，就像如果我"}, {"type": "subtitle", "time": 15918.229, "timestamp": "04:25:18", "text": "拿到一个正式学位，不只是"}, {"type": "subtitle", "time": 15921.03, "timestamp": "04:25:21", "text": "学位，而是有一份"}, {"type": "subtitle", "time": 15923.349, "timestamp": "04:25:23", "text": "正式工作，比如"}, {"type": "subtitle", "time": 15925.99, "timestamp": "04:25:25", "text": "法律，如果我是法学生，或者"}, {"type": "subtitle", "time": 15927.75, "timestamp": "04:25:27", "text": "有法学学位之类的，那"}, {"type": "subtitle", "time": 15931.189, "timestamp": "04:25:31", "text": "我就可以找到工作，"}, {"type": "subtitle", "time": 15933.91, "timestamp": "04:25:33", "text": "或者读硕士什么的，对吧？"}, {"type": "subtitle", "time": 15938.07, "timestamp": "04:25:38", "text": "但是就我而言，"}, {"type": "subtitle", "time": 15940.389, "timestamp": "04:25:40", "text": "我的IGN-1学位不够，对吧？因为它"}, {"type": "subtitle", "time": 15942.79, "timestamp": "04:25:42", "text": "只有三年。要么我可以"}, {"type": "subtitle", "time": 15945.99, "timestamp": "04:25:45", "text": "转到日本的大学读"}, {"type": "subtitle", "time": 15948.469, "timestamp": "04:25:48", "text": "三年，然后再读一年，这样就是"}, {"type": "subtitle", "time": 15952.71, "timestamp": "04:25:52", "text": "四年；要么我必须重新开始读四年制大学，"}, {"type": "subtitle", "time": 15957.91, "timestamp": "04:25:57", "text": "四年制大学。这样我的信用"}]
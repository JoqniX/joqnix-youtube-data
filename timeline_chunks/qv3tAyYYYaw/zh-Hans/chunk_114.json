[{"type": "subtitle", "time": 6852.229, "timestamp": "01:54:12", "text": "我"}, {"type": "subtitle", "time": 6855.83, "timestamp": "01:54:15", "text": "最近其实一直在思考这些事情。 这就是为什么我像"}, {"type": "subtitle", "time": 6858.149, "timestamp": "01:54:18", "text": "昨天说的那样，早上心情有点"}, {"type": "subtitle", "time": 6860.87, "timestamp": "01:54:20", "text": "低落，不想进行昨天的直播，"}, {"type": "subtitle", "time": 6863.109, "timestamp": "01:54:23", "text": "因为我突然看到了一些"}, {"type": "subtitle", "time": 6866.95, "timestamp": "01:54:26", "text": "以前的推文。 这让我开始"}, {"type": "subtitle", "time": 6870.39, "timestamp": "01:54:30", "text": "思考很多事情，思考到底"}, {"type": "subtitle", "time": 6872.39, "timestamp": "01:54:32", "text": "发生了什么。"}, {"type": "subtitle", "time": 6874.79, "timestamp": "01:54:34", "text": "我当时其实在想，哦，我"}, {"type": "subtitle", "time": 6876.709, "timestamp": "01:54:36", "text": "意识到我现在很少和"}, {"type": "subtitle", "time": 6879.03, "timestamp": "01:54:39", "text": "人说话了。"}, {"type": "subtitle", "time": 6882.629, "timestamp": "01:54:42", "text": "我已经走了，我"}, {"type": "subtitle", "time": 6887.83, "timestamp": "01:54:47", "text": "现在有点像把自己关在洞穴里一样。"}, {"type": "subtitle", "time": 6894.629, "timestamp": "01:54:54", "text": "它既有优点也有缺点"}, {"type": "subtitle", "time": 6897.91, "timestamp": "01:54:57", "text": "。 和人交谈真好。"}, {"type": "subtitle", "time": 6899.99, "timestamp": "01:54:59", "text": "而且我现在也没什么人可以说话"}]
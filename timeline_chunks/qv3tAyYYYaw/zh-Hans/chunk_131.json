[{"type": "subtitle", "time": 7866.55, "timestamp": "02:11:06", "text": "我只是需要适应一下"}, {"type": "subtitle", "time": 7869.91, "timestamp": "02:11:09", "text": "这些卡牌游戏，还有"}, {"type": "subtitle", "time": 7873.03, "timestamp": "02:11:13", "text": "像巴尔塔鲁之类的东西。"}, {"type": "subtitle", "time": 7876.31, "timestamp": "02:11:16", "text": "他们如何看待游戏玩法"}, {"type": "subtitle", "time": 7879.35, "timestamp": "02:11:19", "text": "和世界观设定，比如保存性爱"}, {"type": "subtitle", "time": 7884.069, "timestamp": "02:11:24", "text": "等等。 我不擅长这些。 我睡了"}, {"type": "subtitle", "time": 7887.99, "timestamp": "02:11:27", "text": "半个小时。   是的"}, {"type": "subtitle", "time": 7895.99, "timestamp": "02:11:35", "text": "纸牌游戏。 不。你玩什么类型的游戏"}, {"type": "subtitle", "time": 7898.87, "timestamp": "02:11:38", "text": "？ 大型多人在线游戏 (MMO)、角色扮演游戏 (RPG)、第一人称射击游戏 ("}, {"type": "subtitle", "time": 7903.27, "timestamp": "02:11:43", "text": "FPS)、动作角色扮演游戏 (ARPG)、战术角色扮演游戏 (TRPG)、回合制游戏、下拉式游戏、砍杀游戏、"}, {"type": "subtitle", "time": 7907.75, "timestamp": "02:11:47", "text": "益智游戏。   还有"}, {"type": "subtitle", "time": 7911.189, "timestamp": "02:11:51", "text": "什么？ 节奏，"}, {"type": "subtitle", "time": 7913.83, "timestamp": "02:11:53", "text": "轻小说。"}, {"type": "subtitle", "time": 7916.39, "timestamp": "02:11:56", "text": "我尝试解决很多问题。   我"}, {"type": "subtitle", "time": 7918.229, "timestamp": "02:11:58", "text": "觉得我应该多做一些轻小说"}]
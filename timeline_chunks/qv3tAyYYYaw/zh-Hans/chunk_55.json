[{"type": "subtitle", "time": 3327.03, "timestamp": "00:55:27", "text": "N4会有很多复杂的汉字。 所以我"}, {"type": "subtitle", "time": 3329.51, "timestamp": "00:55:29", "text": "必须不停地写写写，"}, {"type": "subtitle", "time": 3332.549, "timestamp": "00:55:32", "text": "理解我写的内容，"}, {"type": "subtitle", "time": 3335.51, "timestamp": "00:55:35", "text": "然后把它记在脑子里，这样我就不会"}, {"type": "subtitle", "time": 3338.95, "timestamp": "00:55:38", "text": "忘记，无论如何我都必须"}, {"type": "subtitle", "time": 3342.71, "timestamp": "00:55:42", "text": "记住这些以及如何阅读它。"}]
[{"type": "subtitle", "time": 19741.19, "timestamp": "05:29:01", "text": "你需要把它们"}, {"type": "subtitle", "time": 19748.948, "timestamp": "05:29:08", "text": "我只知道它会在四"}, {"type": "subtitle", "time": 19760.31, "timestamp": "05:29:20", "text": "我的头 好痛。我要死了。这是"}, {"type": "subtitle", "time": 19768.07, "timestamp": "05:29:28", "text": "啊，这家伙。我的天哪。这家伙。"}, {"type": "subtitle", "time": 19776.788, "timestamp": "05:29:36", "text": "我今天要疯了。哦，这个。"}, {"type": "subtitle", "time": 19782.948, "timestamp": "05:29:42", "text": "哦，是的。你[笑声和倒吸气声] 我"}, {"type": "subtitle", "time": 19788.628, "timestamp": "05:29:48", "text": "记得上这门课的时候拍的。"}]
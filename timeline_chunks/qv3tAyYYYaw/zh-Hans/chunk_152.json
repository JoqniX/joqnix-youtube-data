[{"type": "subtitle", "time": 9121.67, "timestamp": "02:32:01", "text": "我的意思是，一日游可以，我的意思是他们"}, {"type": "subtitle", "time": 9124.389, "timestamp": "02:32:04", "text": "会带我去，邀请我一起去，"}, {"type": "subtitle", "time": 9128.95, "timestamp": "02:32:08", "text": "但是我一个人，我不知道。"}, {"type": "subtitle", "time": 9137.19, "timestamp": "02:32:17", "text": "我的意思是，只要我能自己一个人完成，他们就会允许"}, {"type": "subtitle", "time": 9142.07, "timestamp": "02:32:22", "text": "。"}, {"type": "subtitle", "time": 9144.23, "timestamp": "02:32:24", "text": "当地的朋友圈里，每个人都像"}, {"type": "subtitle", "time": 9157.27, "timestamp": "02:32:37", "text": "搞定了。 我之前"}, {"type": "subtitle", "time": 9159.429, "timestamp": "02:32:39", "text": "和叔叔阿姨们有过很多糟糕的经历"}, {"type": "subtitle", "time": 9164.855, "timestamp": "02:32:44", "text": "，那件事也会造成创伤。"}, {"type": "subtitle", "time": 9166.87, "timestamp": "02:32:46", "text": "[笑声]"}, {"type": "subtitle", "time": 9175.99, "timestamp": "02:32:55", "text": "太多事情了。"}]
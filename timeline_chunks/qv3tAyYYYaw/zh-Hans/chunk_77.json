[{"type": "subtitle", "time": 4623.27, "timestamp": "01:17:03", "text": "这里没有。 哇。"}, {"type": "subtitle", "time": 4637.443, "timestamp": "01:17:17", "text": "你的用词非常适合孩子。"}, {"type": "subtitle", "time": 4639.43, "timestamp": "01:17:19", "text": "[笑声]"}, {"type": "subtitle", "time": 4643.189, "timestamp": "01:17:23", "text": "我觉得这确实是个好主意。"}, {"type": "subtitle", "time": 4645.91, "timestamp": "01:17:25", "text": "我只是不想听到脏话之类的"}, {"type": "subtitle", "time": 4648.79, "timestamp": "01:17:28", "text": "，不想看到人们说太多脏话。 我理解"}, {"type": "subtitle", "time": 4652.47, "timestamp": "01:17:32", "text": "拥有这种自由的益处，但我也不"}, {"type": "subtitle", "time": 4655.11, "timestamp": "01:17:35", "text": "确定。"}, {"type": "subtitle", "time": 4657.43, "timestamp": "01:17:37", "text": "我只是不想让"}, {"type": "subtitle", "time": 4659.91, "timestamp": "01:17:39", "text": "其他人感到不舒服。"}, {"type": "subtitle", "time": 4663.43, "timestamp": "01:17:43", "text": "你想让孩子参与聊天吗？ 呃，不。"}, {"type": "subtitle", "time": 4665.75, "timestamp": "01:17:45", "text": "孩子真的很难管教。"}, {"type": "subtitle", "time": 4669.35, "timestamp": "01:17:49", "text": "说实话，我在 YouTube 上遇到过几个小孩来看我的视频"}, {"type": "subtitle", "time": 4671.59, "timestamp": "01:17:51", "text": "。"}]
[{"type": "subtitle", "time": 9541.19, "timestamp": "02:39:01", "text": "哦对了，我的治疗师知道这件事，因为我得"}, {"type": "subtitle", "time": 9545.75, "timestamp": "02:39:05", "text": "联系他，给他提供"}, {"type": "subtitle", "time": 9549.99, "timestamp": "02:39:09", "text": "一些证据，证明我确实接受过"}, {"type": "subtitle", "time": 9553.99, "timestamp": "02:39:13", "text": "治疗，但我不能透露"}, {"type": "subtitle", "time": 9557.83, "timestamp": "02:39:17", "text": "治疗"}, {"type": "subtitle", "time": 9559.67, "timestamp": "02:39:19", "text": "机构的名字，因为"}, {"type": "subtitle", "time": 9561.91, "timestamp": "02:39:21", "text": "治疗师已经离开了那里，"}, {"type": "subtitle", "time": 9565.19, "timestamp": "02:39:25", "text": "而且那算是"}, {"type": "subtitle", "time": 9567.349, "timestamp": "02:39:27", "text": "机密文件。所以，我不能"}, {"type": "subtitle", "time": 9570.309, "timestamp": "02:39:30", "text": "在视频里展示那些，但"}, {"type": "subtitle", "time": 9573.349, "timestamp": "02:39:33", "text": "我当时觉得，嗯，没"}, {"type": "subtitle", "time": 9577.91, "timestamp": "02:39:37", "text": "必要。 所以，我没展示那些，"}, {"type": "subtitle", "time": 9579.91, "timestamp": "02:39:39", "text": "因为我不想让别人问："}, {"type": "subtitle", "time": 9583.75, "timestamp": "02:39:43", "text": "“哦，你说你接受过心理"}, {"type": "subtitle", "time": 9586.469, "timestamp": "02:39:46", "text": "治疗，但那是真的吗？”因为我"}, {"type": "subtitle", "time": 9589.19, "timestamp": "02:39:49", "text": "现在可以拿出证据了。[笑]"}, {"type": "subtitle", "time": 9592.469, "timestamp": "02:39:52", "text": "我为什么要撒谎？"}, {"type": "subtitle", "time": 9595.83, "timestamp": "02:39:55", "text": "哦，天哪。不过，我的治疗师贾玛·贾玛"}]
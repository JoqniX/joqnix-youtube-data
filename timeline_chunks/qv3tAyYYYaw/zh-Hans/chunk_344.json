[{"type": "subtitle", "time": 20657.59, "timestamp": "05:44:17", "text": "是的，我目前学到的所有东西"}, {"type": "subtitle", "time": 20660.238, "timestamp": "05:44:20", "text": "，包括那个和其他的，"}, {"type": "subtitle", "time": 20662.868, "timestamp": "05:44:22", "text": "[清嗓子]我得重新复习一下。   好了"}, {"type": "subtitle", "time": 20665.03, "timestamp": "05:44:25", "text": "，"}, {"type": "subtitle", "time": 20666.548, "timestamp": "05:44:26", "text": "现在有两个了。 你知道"}, {"type": "subtitle", "time": 20668.15, "timestamp": "05:44:28", "text": "吗？"}, {"type": "subtitle", "time": 20670.788, "timestamp": "05:44:30", "text": "为了换换口味，我就先收拾一下，"}, {"type": "subtitle", "time": 20675.67, "timestamp": "05:44:35", "text": "然后吃午饭吧。 好了，我吃过"}, {"type": "subtitle", "time": 20679.35, "timestamp": "05:44:39", "text": "午饭了"}, {"type": "subtitle", "time": 20683.27, "timestamp": "05:44:43", "text": "，现在要休息一下。 我感觉"}, {"type": "subtitle", "time": 20686.548, "timestamp": "05:44:46", "text": "头疼。 如果我"}, {"type": "subtitle", "time": 20688.31, "timestamp": "05:44:48", "text": "顶着头痛保持冷静，我想"}, {"type": "subtitle", "time": 20691.11, "timestamp": "05:44:51", "text": "我的大脑就什么都进不去了。"}, {"type": "subtitle", "time": 20695.83, "timestamp": "05:44:55", "text": "那是你的心声，我不想那样发生。"}, {"type": "subtitle", "time": 20697.75, "timestamp": "05:44:57", "text": "那"}]
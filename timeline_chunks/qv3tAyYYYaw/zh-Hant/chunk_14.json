[{"type": "subtitle", "time": 843.269, "timestamp": "00:14:03", "text": "哦，"}, {"type": "subtitle", "time": 846.79, "timestamp": "00:14:06", "text": "看起來像艾瑪，但是"}, {"type": "subtitle", "time": 848.949, "timestamp": "00:14:08", "text": "叫聲是這樣的。"}, {"type": "subtitle", "time": 860.79, "timestamp": "00:14:20", "text": "不，等等。呃，看起來像是沒把"}, {"type": "subtitle", "time": 863.829, "timestamp": "00:14:23", "text": "那個東西放下來的琴酒。"}, {"type": "subtitle", "time": 866.23, "timestamp": "00:14:26", "text": "是的。"}, {"type": "subtitle", "time": 869.67, "timestamp": "00:14:29", "text": "哦，然後我也……"}, {"type": "subtitle", "time": 871.43, "timestamp": "00:14:31", "text": "好吧，這是不同的……哦，是的。"}, {"type": "subtitle", "time": 875.03, "timestamp": "00:14:35", "text": "這是「咪咪咪」的"}, {"type": "subtitle", "time": 880.87, "timestamp": "00:14:40", "text": "漢字，在 J 的中間嗎？呃，"}, {"type": "subtitle", "time": 884.389, "timestamp": "00:14:44", "text": "哦，Kiku Kiku。是的。這位是Mimi Kanji。"}, {"type": "subtitle", "time": 888.55, "timestamp": "00:14:48", "text": "等等，等等。不是咪咪。哦，等等，等等，"}, {"type": "subtitle", "time": 891.03, "timestamp": "00:14:51", "text": "等等，等等。咪咪漢字寫在這裡。我覺得事情遠不止如此。"}, {"type": "subtitle", "time": 895.67, "timestamp": "00:14:55", "text": "我認為。我不知道。但是，"}, {"type": "subtitle", "time": 898.79, "timestamp": "00:14:58", "text": "是的，這裡有一個咪咪"}]
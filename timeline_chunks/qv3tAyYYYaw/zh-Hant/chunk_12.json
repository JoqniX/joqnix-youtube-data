[{"type": "subtitle", "time": 725.43, "timestamp": "00:12:05", "text": "。我感覺就像第一次看到它一樣，因為"}, {"type": "subtitle", "time": 727.509, "timestamp": "00:12:07", "text": "我雖然已經了解它，但"}, {"type": "subtitle", "time": 730.87, "timestamp": "00:12:10", "text": "我確實研究過它。我沒有深入研究過。  好的。我"}, {"type": "subtitle", "time": 736.71, "timestamp": "00:12:16", "text": "知道這一點。是的。是的。這張KJI照片是"}, {"type": "subtitle", "time": 740.15, "timestamp": "00:12:20", "text": "在NOA課程期間拍攝的。是的。"}, {"type": "subtitle", "time": 743.269, "timestamp": "00:12:23", "text": "因為我稍微複習了一下。我忘了。  是的。  呃，"}, {"type": "subtitle", "time": 751.99, "timestamp": "00:12:31", "text": "沒有人"}, {"type": "subtitle", "time": 766.629, "timestamp": "00:12:46", "text": "比這"}, {"type": "subtitle", "time": 770.389, "timestamp": "00:12:50", "text": "更像殺手。"}, {"type": "subtitle", "time": 773.75, "timestamp": "00:12:53", "text": "但這確實是人。"}, {"type": "subtitle", "time": 776.23, "timestamp": "00:12:56", "text": "Haidu 和 Hito 有什麼不同"}]
[{"type": "subtitle", "time": 124.789, "timestamp": "00:02:04", "text": "[音樂] 熱浪"}, {"type": "subtitle", "time": 157.589, "timestamp": "00:02:37", "text": "啊，大家好。"}, {"type": "subtitle", "time": 159.43, "timestamp": "00:02:39", "text": "給我一分鐘時間（聽音樂）。好的。你好。  你好。"}, {"type": "subtitle", "time": 161.76, "timestamp": "00:02:41", "text": "你好。 昏迷。"}, {"type": "subtitle", "time": 171.91, "timestamp": "00:02:51", "text": "我今天有點遲到了。我很抱歉。我"}, {"type": "subtitle", "time": 174.39, "timestamp": "00:02:54", "text": "睡過頭了。"}, {"type": "subtitle", "time": 178.15, "timestamp": "00:02:58", "text": "我們本來"}]
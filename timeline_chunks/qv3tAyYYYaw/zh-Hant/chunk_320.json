[{"type": "subtitle", "time": 19222.788, "timestamp": "05:20:22", "text": "每天都學這個。不，我覺得"}, {"type": "subtitle", "time": 19243.99, "timestamp": "05:20:43", "text": "呃，到一邊去。對。"}, {"type": "subtitle", "time": 19246.948, "timestamp": "05:20:46", "text": "我可以把決定寫上。 C I C I O N。"}, {"type": "subtitle", "time": 19258.628, "timestamp": "05:20:58", "text": "還有決定。對。然後是奶酪，對吧？起司."}]
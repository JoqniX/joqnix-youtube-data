[{"type": "subtitle", "time": 304.629, "timestamp": "00:05:04", "text": "9 10。好的。呃，9、10、11、12、13、14、15、16、17。"}, {"type": "subtitle", "time": 309.51, "timestamp": "00:05:09", "text": "呃，今天大概會直播9小時或8"}, {"type": "subtitle", "time": 313.11, "timestamp": "00:05:13", "text": "小時。哦，我會一直做下去，"}, {"type": "subtitle", "time": 315.99, "timestamp": "00:05:15", "text": "我的意思是，我不會"}, {"type": "subtitle", "time": 319.189, "timestamp": "00:05:19", "text": "休息（不做音樂）。我今天不會休息太多。我"}, {"type": "subtitle", "time": 324.71, "timestamp": "00:05:24", "text": "覺得我必須像個孩子一樣，把"}, {"type": "subtitle", "time": 328.31, "timestamp": "00:05:28", "text": "所有事情都趕上進度，還要"}, {"type": "subtitle", "time": 349.67, "timestamp": "00:05:49", "text": "。一秒鐘。讓我先把"}, {"type": "subtitle", "time": 355.27, "timestamp": "00:05:55", "text": "好了，"}, {"type": "subtitle", "time": 357.749, "timestamp": "00:05:57", "text": "應該可以了。好的。好的。  我們"}]
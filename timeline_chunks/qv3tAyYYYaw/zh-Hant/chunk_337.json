[{"type": "subtitle", "time": 20220.548, "timestamp": "05:37:00", "text": "也是。是的。是的。我的頭快"}, {"type": "subtitle", "time": 20229.75, "timestamp": "05:37:09", "text": "炸了。我早上6點就醒了。我從"}, {"type": "subtitle", "time": 20275.27, "timestamp": "05:37:55", "text": "幾點開始做"}, {"type": "subtitle", "time": 20279.59, "timestamp": "05:37:59", "text": "這些來著？ 8點，對吧？早上8點。 [笑] 現在是2點。我的考試在6點，沒有考試考卷"}]
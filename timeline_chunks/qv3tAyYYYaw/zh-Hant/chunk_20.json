[{"type": "subtitle", "time": 1200.789, "timestamp": "00:20:00", "text": "哦，有多個調，哦，是的，"}, {"type": "subtitle", "time": 1203.51, "timestamp": "00:20:03", "text": "別忘了有多個調。這裡有一把鑰匙"}, {"type": "subtitle", "time": 1207.823, "timestamp": "00:20:07", "text": "和另一把鑰匙。不。呃"}, {"type": "subtitle", "time": 1208.95, "timestamp": "00:20:08", "text": "（嗤笑）"}, {"type": "subtitle", "time": 1212.47, "timestamp": "00:20:12", "text": "呃，是三鍵，對吧？那三個，"}, {"type": "subtitle", "time": 1228.31, "timestamp": "00:20:28", "text": "是什麼？不是衝著"}, {"type": "subtitle", "time": 1252.71, "timestamp": "00:20:52", "text": "我來的嗎？  我。  不是我。"}, {"type": "subtitle", "time": 1256.71, "timestamp": "00:20:56", "text": "等等，可是"}, {"type": "subtitle", "time": 1259.51, "timestamp": "00:20:59", "text": "鑰匙在哪裡呢？"}]
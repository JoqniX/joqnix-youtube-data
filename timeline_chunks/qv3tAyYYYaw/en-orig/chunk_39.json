[{"type": "subtitle", "time": 2342.23, "timestamp": "00:39:02", "text": "Most of Japanese kanji characters have"}, {"type": "subtitle", "time": 2345.109, "timestamp": "00:39:05", "text": "more than one pronunciation, but this"}, {"type": "subtitle", "time": 2346.95, "timestamp": "00:39:06", "text": "video shows only one typical"}, {"type": "subtitle", "time": 2349.349, "timestamp": "00:39:09", "text": "pronunciation for each character for"}, {"type": "subtitle", "time": 2351.91, "timestamp": "00:39:11", "text": "beginners."}, {"type": "subtitle", "time": 2354.087, "timestamp": "00:39:14", "text": "Do you remember this one learned for"}, {"type": "subtitle", "time": 2358.63, "timestamp": "00:39:18", "text": "[music] N5 level? Yes, it is K for"}, {"type": "subtitle", "time": 2359.589, "timestamp": "00:39:19", "text": "three."}, {"type": "subtitle", "time": 2360.31, "timestamp": "00:39:20", "text": ">> Three. Yes."}, {"type": "subtitle", "time": 2362.55, "timestamp": "00:39:22", "text": ">> Please guess the meaning of next two"}, {"type": "subtitle", "time": 2366.63, "timestamp": "00:39:26", "text": "characters from this kanji."}, {"type": "subtitle", "time": 2391.109, "timestamp": "00:39:51", "text": "So I have to write two of the keys. One"}]
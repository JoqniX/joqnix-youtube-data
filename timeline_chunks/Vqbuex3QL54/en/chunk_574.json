[{"type": "subtitle", "time": 34441.23, "timestamp": "09:34:01", "text": "sorry."}, {"type": "subtitle", "time": 34444.35, "timestamp": "09:34:04", "text": "Man, I'm"}, {"type": "subtitle", "time": 34448.63, "timestamp": "09:34:08", "text": "so Oh my god, I feel bad. I'm sorry for"}, {"type": "subtitle", "time": 34450.83, "timestamp": "09:34:10", "text": "eating your"}, {"type": "subtitle", "time": 34462.23, "timestamp": "09:34:22", "text": "That boy will fray my last nerve."}, {"type": "subtitle", "time": 34465.35, "timestamp": "09:34:25", "text": "Moy, excuse me, Mr. Salow. Oh, yes,"}, {"type": "subtitle", "time": 34467.99, "timestamp": "09:34:27", "text": "Sebastian's friend. I apologize on"}, {"type": "subtitle", "time": 34470.07, "timestamp": "09:34:30", "text": "behalf of my nephew. He doesn't know"}, {"type": "subtitle", "time": 34472.39, "timestamp": "09:34:32", "text": "when to stop. I was about to check on"}, {"type": "subtitle", "time": 34475.746, "timestamp": "09:34:35", "text": "Anne. Did I see you come from the house?"}, {"type": "subtitle", "time": 34478.23, "timestamp": "09:34:38", "text": "How is she? She's all right. She said"}, {"type": "subtitle", "time": 34480.15, "timestamp": "09:34:40", "text": "she was going to rest. Nothing can be"}, {"type": "subtitle", "time": 34482.83, "timestamp": "09:34:42", "text": "done for her."}, {"type": "subtitle", "time": 34487.03, "timestamp": "09:34:47", "text": "My I'm so sorry. I'm so sorry. I"}, {"type": "subtitle", "time": 34488.71, "timestamp": "09:34:48", "text": "understand you've tried everyone from"}, {"type": "subtitle", "time": 34491.586, "timestamp": "09:34:51", "text": "Nurse Blaney to St. Mongo's to no avail."}, {"type": "subtitle", "time": 34494.15, "timestamp": "09:34:54", "text": "We have. My nephew thinks he knows"}, {"type": "subtitle", "time": 34496.07, "timestamp": "09:34:56", "text": "better than the healers. Perhaps the"}, {"type": "subtitle", "time": 34498.55, "timestamp": "09:34:58", "text": "healers don't know everything, sir."}]
[{"type": "subtitle", "time": 41100.47, "timestamp": "11:25:00", "text": "Let us get moving while the stars are"}, {"type": "subtitle", "time": 41102.31, "timestamp": "11:25:02", "text": "still out. I'll show you how to use that"}, {"type": "subtitle", "time": 41110.47, "timestamp": "11:25:10", "text": "No need to convince me. Let's get going."}, {"type": "subtitle", "time": 41112.95, "timestamp": "11:25:12", "text": "Brilliant. You won't regret it, shall"}, {"type": "subtitle", "time": 41121.07, "timestamp": "11:25:21", "text": "Hi."}, {"type": "subtitle", "time": 41129.266, "timestamp": "11:25:29", "text": "A myth. The table is on a castle wall"}, {"type": "subtitle", "time": 41131.746, "timestamp": "11:25:31", "text": "ahead. Look for a stone platform."}, {"type": "subtitle", "time": 41133.99, "timestamp": "11:25:33", "text": "Something that doesn't quite belong."}, {"type": "subtitle", "time": 41136.55, "timestamp": "11:25:36", "text": "We'll know it when we see it. Onwards we"}, {"type": "subtitle", "time": 41138.79, "timestamp": "11:25:38", "text": "go. Some say the locations of the tables"}, {"type": "subtitle", "time": 41141.266, "timestamp": "11:25:41", "text": "were originally marked by centaurs for"}, {"type": "subtitle", "time": 41142.266, "timestamp": "11:25:42", "text": "ritual"}, {"type": "subtitle", "time": 41149.99, "timestamp": "11:25:49", "text": "It's not that creepy out here at night,"}]
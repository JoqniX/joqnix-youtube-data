[{"type": "subtitle", "time": 33181.79, "timestamp": "09:13:01", "text": "thingy. Someone else from here."}, {"type": "subtitle", "time": 33184.47, "timestamp": "09:13:04", "text": "What? Oh, yeah. I remember doing some"}, {"type": "subtitle", "time": 33187.31, "timestamp": "09:13:07", "text": "quest, but but"}, {"type": "subtitle", "time": 33196.112, "timestamp": "09:13:16", "text": "Hogwarts. You're telling me"}, {"type": "subtitle", "time": 33223.19, "timestamp": "09:13:43", "text": "Why would anyone care enough to remove"}, {"type": "subtitle", "time": 33226.708, "timestamp": "09:13:46", "text": "my demigu statues? Pardon me, sir, but"}, {"type": "subtitle", "time": 33229.588, "timestamp": "09:13:49", "text": "about those curious statues I've seen."}, {"type": "subtitle", "time": 33233.83, "timestamp": "09:13:53", "text": "What? Who are you? Why do you ask?"}, {"type": "subtitle", "time": 33237.67, "timestamp": "09:13:57", "text": "Uh, they're quite clever. Oh, thank you."}, {"type": "subtitle", "time": 33239.588, "timestamp": "09:13:59", "text": "A lot of craftsmanship and care went"}]
[{"type": "subtitle", "time": 14641.59, "timestamp": "04:04:01", "text": "圣人。哦，有个女的有这个"}, {"type": "subtitle", "time": 14650.95, "timestamp": "04:04:10", "text": "为什么一场比赛要打那么久？你好。"}, {"type": "subtitle", "time": 14652.67, "timestamp": "04:04:12", "text": "我们应该换吗？"}, {"type": "subtitle", "time": 14662.389, "timestamp": "04:04:22", "text": "[音乐]"}, {"type": "subtitle", "time": 14665.99, "timestamp": "04:04:25", "text": "我是菲尔党的一员。"}, {"type": "subtitle", "time": 14669.51, "timestamp": "04:04:29", "text": "太慢了。好的。"}, {"type": "subtitle", "time": 14672.03, "timestamp": "04:04:32", "text": "这是什么房间？"}, {"type": "subtitle", "time": 14673.51, "timestamp": "04:04:33", "text": "[音乐]"}, {"type": "subtitle", "time": 14677.349, "timestamp": "04:04:37", "text": "不，这就像……"}, {"type": "subtitle", "time": 14680.25, "timestamp": "04:04:40", "text": "计划之类的。好的。"}, {"type": "subtitle", "time": 14685.67, "timestamp": "04:04:45", "text": "[音乐]"}, {"type": "subtitle", "time": 14689.07, "timestamp": "04:04:49", "text": "英雄徽章"}, {"type": "subtitle", "time": 14692.63, "timestamp": "04:04:52", "text": "充值版升级。哇。"}, {"type": "subtitle", "time": 14696.03, "timestamp": "04:04:56", "text": "标准版。杜克斯"}, {"type": "subtitle", "time": 14698.469, "timestamp": "04:04:58", "text": "最终的。你获得了终极奖励。好的。"}]
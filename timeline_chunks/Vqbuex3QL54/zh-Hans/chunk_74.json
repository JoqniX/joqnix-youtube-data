[{"type": "subtitle", "time": 4443.03, "timestamp": "01:14:03", "text": "让我拥有所有东西。那是"}, {"type": "subtitle", "time": 4444.63, "timestamp": "01:14:04", "text": "一。"}, {"type": "subtitle", "time": 4449.43, "timestamp": "01:14:09", "text": "嗯，第二点是，我很高兴我这么做了。"}, {"type": "subtitle", "time": 4452.47, "timestamp": "01:14:12", "text": "YouTube 和流媒体一般"}, {"type": "subtitle", "time": 4456.149, "timestamp": "01:14:16", "text": "因为在现实生活中，我涉足这个领域的时间非常早。"}, {"type": "subtitle", "time": 4459.669, "timestamp": "01:14:19", "text": "孩子和你很难交朋友，"}, {"type": "subtitle", "time": 4462.55, "timestamp": "01:14:22", "text": "一切。我意识到我不出去，"}, {"type": "subtitle", "time": 4464.55, "timestamp": "01:14:24", "text": "一切都源于童年创伤"}, {"type": "subtitle", "time": 4469.11, "timestamp": "01:14:29", "text": "以及所有的一切，还有上网。"}, {"type": "subtitle", "time": 4471.91, "timestamp": "01:14:31", "text": "帮助我结识了今天我认识的人。"}, {"type": "subtitle", "time": 4475.189, "timestamp": "01:14:35", "text": "而这些人正是我……"}, {"type": "subtitle", "time": 4477.43, "timestamp": "01:14:37", "text": "我之前曾尝试积极与他人合作"}, {"type": "subtitle", "time": 4480.03, "timestamp": "01:14:40", "text": "前往日本。所以这对我意义重大。"}, {"type": "subtitle", "time": 4482.87, "timestamp": "01:14:42", "text": "他们仍然记得我，而我"}, {"type": "subtitle", "time": 4485.43, "timestamp": "01:14:45", "text": "仍然能够保留那种真实性"}, {"type": "subtitle", "time": 4489.75, "timestamp": "01:14:49", "text": "连接装置。就像……嗯……很久以前"}, {"type": "subtitle", "time": 4492.87, "timestamp": "01:14:52", "text": "我以前经常看到这些人，或者像这些"}, {"type": "subtitle", "time": 4495.91, "timestamp": "01:14:55", "text": "友谊以及一切，呃，就像……"}, {"type": "subtitle", "time": 4499.11, "timestamp": "01:14:59", "text": "星座的联系或类似星座的"}]
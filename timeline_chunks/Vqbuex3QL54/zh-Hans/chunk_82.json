[{"type": "subtitle", "time": 4920.87, "timestamp": "01:22:00", "text": "花了很长时间才接受这个事实，是的"}, {"type": "subtitle", "time": 4923.35, "timestamp": "01:22:03", "text": "某种程度上，我将孤身一人。我"}, {"type": "subtitle", "time": 4926.87, "timestamp": "01:22:06", "text": "不会有我自己的多里蒙，也不会有自己的"}, {"type": "subtitle", "time": 4929.189, "timestamp": "01:22:09", "text": "想象中的朋友。尽管我确实有"}, {"type": "subtitle", "time": 4931.43, "timestamp": "01:22:11", "text": "我小时候创造的想象朋友"}, {"type": "subtitle", "time": 4934.39, "timestamp": "01:22:14", "text": "独自一人，但仍然"}, {"type": "subtitle", "time": 4936.47, "timestamp": "01:22:16", "text": "呃，我意识到，是的，你就是你"}, {"type": "chat", "time": 4936.521, "timestamp": "01:22:16", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "you can be your own doremon"}, {"type": "subtitle", "time": 4938.27, "timestamp": "01:22:18", "text": "自己的"}, {"type": "subtitle", "time": 4941.83, "timestamp": "01:22:21", "text": "嗯，人物、主角之类的。"}, {"type": "subtitle", "time": 4944.39, "timestamp": "01:22:24", "text": "你过着自己的生活。你可能"}, {"type": "chat", "time": 4946.147, "timestamp": "01:22:26", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "be your own best friend"}, {"type": "subtitle", "time": 4946.47, "timestamp": "01:22:26", "text": "你或许会遇到人，也或许遇不到人。"}, {"type": "subtitle", "time": 4950.31, "timestamp": "01:22:30", "text": "这就是生活，让我们……铭刻下来。"}, {"type": "subtitle", "time": 4951.91, "timestamp": "01:22:31", "text": "为你着想之类的。这不是命运，"}, {"type": "chat", "time": 4954.14, "timestamp": "01:22:34", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "be your own strength yay"}, {"type": "subtitle", "time": 4954.39, "timest
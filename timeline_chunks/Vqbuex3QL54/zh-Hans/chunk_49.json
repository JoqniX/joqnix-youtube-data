[{"type": "subtitle", "time": 2941.51, "timestamp": "00:49:01", "text": "情况正在好转。"}, {"type": "subtitle", "time": 2944.549, "timestamp": "00:49:04", "text": "我看到你的钱就像我看到你的我"}, {"type": "subtitle", "time": 2946.79, "timestamp": "00:49:06", "text": "即使你不在，你也能看到你的钱。"}, {"type": "subtitle", "time": 2948.549, "timestamp": "00:49:08", "text": "流媒体。而且我碰巧很喜欢"}, {"type": "subtitle", "time": 2950.71, "timestamp": "00:49:10", "text": "打开其中一个，对吧？而且它"}, {"type": "subtitle", "time": 2952.549, "timestamp": "00:49:12", "text": "那是我真正感受到的那种时刻之一。"}, {"type": "subtitle", "time": 2955.19, "timestamp": "00:49:15", "text": "为之而活。我想就像我以前那样"}, {"type": "chat", "time": 2956.442, "timestamp": "00:49:16", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "truly the number one villain backstory of all time"}, {"type": "subtitle", "time": 2957.589, "timestamp": "00:49:17", "text": "实际上，我当时正在现场演奏，我想。"}, {"type": "subtitle", "time": 2959.51, "timestamp": "00:49:19", "text": "Hongkey 明星真的对，而你也是"}, {"type": "subtitle", "time": 2961.43, "timestamp": "00:49:21", "text": "谈论你喜欢短发"}, {"type": "subtitle", "time": 2963.75, "timestamp": "00:49:23", "text": "就像你那种发型"}, {"type": "subtitle", "time": 2965.75, "timestamp": "00:49:25", "text": "我很喜欢，所以看了两遍。所以"}, {"type": "subtitle", "time": 2970.87, "timestamp": "00:49:30", "text": "是的。我的天啊。哦，是的。我记得。"}, {"type": "subtitle", "time": 2973.47, "timestamp": "00:49:33", "text": "是的。我看到了。"}, {"type": "subtitle", "time": 2976.39, "timestamp": "00:49:36", "text": "好的。等待。有人说：“不仅可以"}, {"type": "subtitle", "time": 2978.63, "timestamp": "00:49:38", "text": "她听不见，但生命却夺走了她。"}, {"type": "subtitle", "time": 2988.15, "timestamp": "00:49:48", "text": "上帝。我觉得可以。你知道吗？"}, {"type": "subtitle", "time": 2989.95, "timestamp": "00:49:49", "text": "没关系。"}, {"type": "subtitle", "time": 2992.549, "timestamp": "00:49:52", "text": "所以，所以"}, {"type": "subtitle", "time": 2994.63, "timestamp": "00:49:54", "text": "嗯，不然的话，到底发生了什么？"}, {"type": "subtitle", "time": 2996.15, "timestamp": "00:49:56", "text": "你……你那边到底发生了什么事？"}, {"type": "subtitle", "time": 2997.99, "timestamp": "00:49:57", "text": "生活？你晚饭吃了什么？"}]
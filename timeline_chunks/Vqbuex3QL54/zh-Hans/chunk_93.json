[{"type": "subtitle", "time": 5581.03, "timestamp": "01:33:01", "text": "什么我都原谅，但我仍然会原谅别人。"}, {"type": "subtitle", "time": 5583.83, "timestamp": "01:33:03", "text": "容易地。所以我明白，即使"}, {"type": "subtitle", "time": 5586.709, "timestamp": "01:33:06", "text": "这是我最珍视的友谊。"}, {"type": "subtitle", "time": 5589.27, "timestamp": "01:33:09", "text": "以上这些都是我指出的。"}, {"type": "subtitle", "time": 5593.83, "timestamp": "01:33:13", "text": "比如，嗯，真实的，真诚的信任，以及"}, {"type": "subtitle", "time": 5596.87, "timestamp": "01:33:16", "text": "值得信赖且善解人意的人"}, {"type": "chat", "time": 5596.892, "timestamp": "01:33:16", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "👍"}, {"type": "subtitle", "time": 5598.79, "timestamp": "01:33:18", "text": "支持你，你也必须这样做"}, {"type": "subtitle", "time": 5602.709, "timestamp": "01:33:22", "text": "给予支持，并且有人不会……"}, {"type": "subtitle", "time": 5605.51, "timestamp": "01:33:25", "text": "例如，会有一些人不知道是谁"}, {"type": "subtitle", "time": 5607.35, "timestamp": "01:33:27", "text": "会说，是啊，你能给我一些吗？"}, {"type": "subtitle", "time": 5609.43, "timestamp": "01:33:29", "text": "钱和东西，他们不会还你。"}, {"type": "subtitle", "time": 5612.149, "timestamp": "01:33:32", "text": "再问你一遍。是的。不要"}, {"type": "subtitle", "time": 5614.31, "timestamp": "01:33:34", "text": "诸如此类的事情。我不想那样。"}, {"type": "subtitle", "time": 5625.59, "timestamp": "01:33:45", "text": "好的。我陷得太深了。对不起。不，"}, {"type": "subtitle", "time": 5628.95, "timestamp": "01:33:48", "text": "不，不。不要，不要，我简直不敢相信"}, {"type": "subtitle", "time": 5630.87, "timestamp": "01:33:50", "text": "这是今天第二次发生这种情况了。"}, {"type": "subtitle", "time": 5633.99, "timestamp": "01:33:53", "text": "我就是这么说的。不要为此道歉"}, {"type": "chat", "time": 5635.918, "timestamp": "01:33:55", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "gimme 20 $"}, {"type": "subtitle", "time": 5636.55, "timestamp": "01:33:56", "text": "做你自己。你知道，这里有一个"}, {"type": "subtitle", "time": 5639.189, "timestamp": "01:33:59", "text": "你之所以成为现在这样的人的原因。你的"}]
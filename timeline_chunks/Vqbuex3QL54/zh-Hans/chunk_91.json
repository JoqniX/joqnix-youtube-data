[{"type": "subtitle", "time": 5464.39, "timestamp": "01:31:04", "text": "那些实际上并不理解它的人，就像如果……"}, {"type": "subtitle", "time": 5466.149, "timestamp": "01:31:06", "text": "比如说，一个常见的错误"}, {"type": "subtitle", "time": 5468.39, "timestamp": "01:31:08", "text": "从我的角度来看，就好像我做出了……"}, {"type": "subtitle", "time": 5471.91, "timestamp": "01:31:11", "text": "我犯同样的错误很多次了"}, {"type": "subtitle", "time": 5474.55, "timestamp": "01:31:14", "text": "应该在那个时候"}, {"type": "subtitle", "time": 5476.95, "timestamp": "01:31:16", "text": "我本该习惯的。我"}, {"type": "subtitle", "time": 5482.03, "timestamp": "01:31:22", "text": "我知道，但感觉就像……呃，我是"}, {"type": "subtitle", "time": 5484.47, "timestamp": "01:31:24", "text": "不知不觉中，我发生了"}, {"type": "subtitle", "time": 5487.03, "timestamp": "01:31:27", "text": "犯下那个错误。我当时并不知道。"}, {"type": "subtitle", "time": 5489.669, "timestamp": "01:31:29", "text": "犯错之后，我后悔了。"}, {"type": "subtitle", "time": 5491.83, "timestamp": "01:31:31", "text": "诸如此类的事情，我会尽力避免。"}, {"type": "subtitle", "time": 5495.83, "timestamp": "01:31:35", "text": "我可能会再次重复它，但我可能又会"}, {"type": "subtitle", "time": 5498.31, "timestamp": "01:31:38", "text": "落入那个陷阱之类的"}, {"type": "subtitle", "time": 5500.95, "timestamp": "01:31:40", "text": "生活给了我什么，而我却犯了个错误"}, {"type": "subtitle", "time": 5505.35, "timestamp": "01:31:45", "text": "再次。这样，那位朋友或许就能完成这件事了。"}, {"type": "subtitle", "time": 5507.43, "timestamp": "01:31:47", "text": "跟你断绝关系了。有些人"}, {"type": "subtitle", "time": 5510.629, "timestamp": "01:31:50", "text": "愿意等到第一百次或"}, {"type": "chat", "time": 5512.225, "timestamp": "01:31:52", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "back"}, {"type": "subtitle", "time": 5514.229, "timestamp": "01:31:54", "text": "一千次了，直到你能"}, {"type": "subtitle", "time": 5516.55, "timestamp": "01:31:56", "text": "提高，他们喜欢你，他们也理解你"}, {"type": "subtitle", "time": 5518.27, "timestamp": "01:31:58", "text": "就像，你根本没做。"}]
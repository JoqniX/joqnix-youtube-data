[{"type": "subtitle", "time": 5342.31, "timestamp": "01:29:02", "text": "沉迷于网络世界的人对我来说"}, {"type": "chat", "time": 5342.88, "timestamp": "01:29:02", "author": "@zergrush78319", "avatar": "https://yt4.ggpht.com/ytc/AIdro_nDwl-xtQg1-Z5v6Iv64Z42_Hei-15daYPmWXqoFR-4_b8=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4idk"}, {"type": "subtitle", "time": 5344.31, "timestamp": "01:29:04", "text": "我打电话给一个朋友，他会成为我最好的朋友。"}, {"type": "subtitle", "time": 5347.11, "timestamp": "01:29:07", "text": "就像最好的朋友，你，我也是。"}, {"type": "subtitle", "time": 5349.669, "timestamp": "01:29:09", "text": "他们在那里等着我，他们也在那里等着我，善良的"}, {"type": "subtitle", "time": 5352.229, "timestamp": "01:29:12", "text": "那个东西。但自从我踏入"}, {"type": "subtitle", "time": 5354.07, "timestamp": "01:29:14", "text": "这一切都在网上，还有我"}, {"type": "subtitle", "time": 5356.55, "timestamp": "01:29:16", "text": "意识到存在多个分离点"}, {"type": "subtitle", "time": 5358.39, "timestamp": "01:29:18", "text": "谈到友谊时。有"}, {"type": "subtitle", "time": 5360.149, "timestamp": "01:29:20", "text": "熟人、关系、亲密"}, {"type": "subtitle", "time": 5362.31, "timestamp": "01:29:22", "text": "朋友，最好的朋友，最好的"}, {"type": "subtitle", "time": 5365.189, "timestamp": "01:29:25", "text": "朋友，很多很多东西，对吧？我"}, {"type": "subtitle", "time": 5367.43, "timestamp": "01:29:27", "text": "没搞清楚这些界限，"}, {"type": "subtitle", "time": 5370.39, "timestamp": "01:29:30", "text": "一切。后来我才意识到，是的"}, {"type": "subtitle", "time": 5372.79, "timestamp": "01:29:32", "text": "朋友有两种类型。好的"}, {"type": "subtitle", "time": 5374.79, "timestamp": "01:29:34", "text": "朋友和损友。有"}, {"type": "subtitle", "time": 5376.55, "timestamp": "01:29:36", "text": "对你怀有恶意的人"}, {"type": "subtitle", "time": 5378.79, "timestamp": "01:29:38", "text": "不珍惜你，利用你"}, {"type": "subtitle", "time": 5380.87, "timestamp": "01:29:40", "text": "把你扔掉。有"}, {"type": "subtitle", "time": 5382.709, "timestamp": "01:29:42", "text": "那些真心实意想要帮助别人的人"}, {"type": "subtitle", "time": 5385.51, "timestamp": "01:29:45", "text": "你，然后看到好的，呃，看到你"}, {"type": "chat", "time": 5385.524, "timestamp": "01:29:45", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "true"}, {"type": "subtitle", "time": 5387.59, "timestamp": "01:29:47", "text": "完成了很多事情，而且是真心实意的"}, {"type": "subtitle", "time": 5390.149, "timestamp": "01:29:50", "text": "为你感到高兴，无论何时你"}, {"type": "subtitle", "time": 5392.87, "timestamp": "01:29:52", "text": "他们会安慰你的，虽然有点难过。"}, {"type": "subtitle", "time": 5395.189, "timestamp": "01:29:55", "text": "这不是一份他们需要安慰他人的工作。"}, {"type": "subtitle", "time": 5399.27, "timestamp": "01:29:59", "text": "你更像是，嗯，因为你，你是我"}]
[{"type": "subtitle", "time": 13745.309, "timestamp": "03:49:05", "text": "这"}, {"type": "subtitle", "time": 13748.67, "timestamp": "03:49:08", "text": "男。幸运的士兵。搏斗"}, {"type": "subtitle", "time": 13751.15, "timestamp": "03:49:11", "text": "钩。我需要吗？"}, {"type": "subtitle", "time": 13754.55, "timestamp": "03:49:14", "text": "购买商品？我钱不够。我"}, {"type": "subtitle", "time": 13756.75, "timestamp": "03:49:16", "text": "确实足够了。"}, {"type": "subtitle", "time": 13772.75, "timestamp": "03:49:32", "text": "是米娅吗？你听到什么人了吗？"}, {"type": "subtitle", "time": 13778.99, "timestamp": "03:49:38", "text": "别的？那是……我的天哪，那是……"}, {"type": "subtitle", "time": 13780.99, "timestamp": "03:49:40", "text": "幽灵般的。那是"}, {"type": "subtitle", "time": 13790.229, "timestamp": "03:49:50", "text": "幽灵般的。绿色徽章。你会逐渐"}]
[{"type": "subtitle", "time": 4201.99, "timestamp": "01:10:01", "text": "你自己？"}, {"type": "subtitle", "time": 4204.63, "timestamp": "01:10:04", "text": "哦，问得好。呃，"}, {"type": "chat", "time": 4207.335, "timestamp": "01:10:07", "author": "@akamurajaizen", "avatar": "https://yt4.ggpht.com/4TIH-D08DE7pk6l85RWWuj6VwP3lUitGX1m3JfDywIpryobVVVZSQqcm_MKVDuuN5keV4e0PSgU=s64-c-k-c0x00ffffff-no-rj", "message": "LMAO"}, {"type": "subtitle", "time": 4207.99, "timestamp": "01:10:07", "text": "是啊，已经过去一段时间了，对吧？我认为，"}, {"type": "chat", "time": 4209.68, "timestamp": "01:10:09", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "sing?"}, {"type": "subtitle", "time": 4212.79, "timestamp": "01:10:12", "text": "呃，我做了 Kok 那件事，还有 Joan 之类的。"}, {"type": "subtitle", "time": 4214.55, "timestamp": "01:10:14", "text": "那件事当时正在直播，我觉得我"}, {"type": "chat", "time": 4217.177, "timestamp": "01:10:17", "author": "@zergrush78319", "avatar": "https://yt4.ggpht.com/ytc/AIdro_nDwl-xtQg1-Z5v6Iv64Z42_Hei-15daYPmWXqoFR-4_b8=s64-c-k-c0x00ffffff-no-rj", "message": "sing to myself? like humming songs?"}, {"type": "subtitle", "time": 4217.99, "timestamp": "01:10:17", "text": "唱歌难听死了，嗯，我确实看了我的"}, {"type": "subtitle", "time": 4219.99, "timestamp": "01:10:19", "text": "自己的原话。我当时就想，“我的天哪，那……”"}, {"type": "subtitle", "time": 4225.189, "timestamp": "01:10:25", "text": "感觉尴尬得不行。” 但嗯，也挺好的。"}, {"type": "chat", "time": 4227.737, "timestamp": "01:10:27", "author": "@zergrush78319", "avatar": "https://yt4.ggpht.com/ytc/AIdro_nDwl-xtQg1-Z5v6Iv64Z42_Hei-15daYPmWXqoFR-4_b8=s64-c-k-c0x00ffffff-no-rj", "message": "i do all the time"}, {"type": "subtitle", "time": 4229.99, "timestamp": "01:10:29", "text": "我已经很久没听歌了。"}, {"type": "subtitle", "time": 4233.11, "timestamp": "01:10:33", "text": "呃，我为自己唱了这首歌。我通常会这样做"}, {"type": "subtitle", "time": 4234.79, "timestamp": "01:10:34", "text": "在我忙的时候，在我忙的时候"}, {"type": "subtitle", "time": 4237.03, "timestamp": "01:10:37", "text": "比如我在洗澡的时候。我只是"}, {"type": "chat", "time": 4238.015, "timestamp": "01:10:38", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "everyday"}, {"type": "subtitle", "time": 4240.07, "timestamp": "01:10:40", "text": "我试着闭上眼睛唱歌，嗯……"}, {"type": "subtitle", "time": 4242.79, "timestamp": "01:10:42", "text": "把所有情绪都释放出来，无论我有什么感受。"}, {"type": "subtitle", "time": 4244.79, "timestamp": "01:10:44", "text": "因为我每天都有这些旋律。"}, {"type": "chat", "time": 4245.95, "timestamp": "01:10:45", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "ah bathroom singer"}, {"type": "subtitle", "time": 4247.59, "timestamp": "01:10:47", "text": "我脑子里一片混乱，我想把它说出来。"}, {"type": "subtitle", "time": 4251.03, "timestamp": "01:10:51", "text": "总有一天我会听音乐。但我同时也会想，“是啊，"}, {"type": "subtitle", "time": 4254.95, "timestamp": "01:10:54", "text": "我大概会哼唱或者吹口哨吧。"}, {"type": "subtitle", "time": 4259.11, "timestamp": "01:10:59", "text": "把它说出来。”是啊。因为自从我几个呃"}]
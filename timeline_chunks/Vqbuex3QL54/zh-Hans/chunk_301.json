[{"type": "subtitle", "time": 18068.55, "timestamp": "05:01:08", "text": "成就。我刚回家。是的。"}, {"type": "subtitle", "time": 18075.31, "timestamp": "05:01:15", "text": "哦，下午好。"}, {"type": "subtitle", "time": 18078.868, "timestamp": "05:01:18", "text": "你。情况如何？希望你玩得开心"}, {"type": "subtitle", "time": 18080.788, "timestamp": "05:01:20", "text": "外部。"}, {"type": "subtitle", "time": 18082.868, "timestamp": "05:01:22", "text": "一场以新动力源进行的血腥屠杀"}, {"type": "subtitle", "time": 18085.59, "timestamp": "05:01:25", "text": "不再令人着迷的其他永恒考验"}, {"type": "subtitle", "time": 18086.51, "timestamp": "05:01:26", "text": "很好"}, {"type": "subtitle", "time": 18088.708, "timestamp": "05:01:28", "text": "进行。无需四处寻找"}, {"type": "subtitle", "time": 18091.51, "timestamp": "05:01:31", "text": "齿轮。没有直接跳转到结尾的选项。"}, {"type": "subtitle", "time": 18093.788, "timestamp": "05:01:33", "text": "经验。哦，这是像"}, {"type": "subtitle", "time": 18096.27, "timestamp": "05:01:36", "text": "什么"}, {"type": "subtitle", "time": 18099.11, "timestamp": "05:01:39", "text": "这？我觉得时间，哦，就像……"}, {"type": "subtitle", "time": 18103.83, "timestamp": "05:01:43", "text": "杀戮方式，如何杀戮，多少人？"}, {"type": "subtitle", "time": 18106.67, "timestamp": "05:01:46", "text": "像你一样杀人，你杀了多少人？"}, {"type": "subtitle", "time": 18110.55, "timestamp": "05:01:50", "text": "想。上课很有趣。哦，我们去了"}, {"type": "subtitle", "time": 18113.59, "timestamp": "05:01:53", "text": "哦，你还有课呢。好的。好的。走吧，我"}, {"type": "subtitle", "time": 18117.07, "timestamp": "05:01:57", "text": "我还以为你去买显卡了"}, {"type": "subtitle", "time": 18119.12, "timestamp": "05:01:59", "text": "今天。"}]
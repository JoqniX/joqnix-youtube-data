[{"type": "subtitle", "time": 8522.55, "timestamp": "02:22:02", "text": "这段旅程展现出的天赋告诉我，那个运动员"}, {"type": "subtitle", "time": 8524.79, "timestamp": "02:22:04", "text": "你仍然是家庭的一份子，"}, {"type": "subtitle", "time": 8527.75, "timestamp": "02:22:07", "text": "虽然我觉得有些东西总是像……"}, {"type": "subtitle", "time": 8530.87, "timestamp": "02:22:10", "text": "局外人，以及那些我不属于的东西"}, {"type": "subtitle", "time": 8532.95, "timestamp": "02:22:12", "text": "成为家庭成员之类的，但是"}, {"type": "subtitle", "time": 8537.03, "timestamp": "02:22:17", "text": "尽管如此，他们都是，有些是"}, {"type": "subtitle", "time": 8540.55, "timestamp": "02:22:20", "text": "那些我珍视并关心的人"}, {"type": "subtitle", "time": 8542.75, "timestamp": "02:22:22", "text": "他们，因为再说一遍，这不仅仅是"}, {"type": "subtitle", "time": 8546.15, "timestamp": "02:22:26", "text": "我帮助过的那些星星被赋予了其他的东西"}, {"type": "subtitle", "time": 8548.19, "timestamp": "02:22:28", "text": "人和物。更甚"}, {"type": "subtitle", "time": 8552.95, "timestamp": "02:22:32", "text": "就像他们让我处理和帮助一样"}, {"type": "subtitle", "time": 8555.27, "timestamp": "02:22:35", "text": "当他们遇到问题等等的时候，"}, {"type": "subtitle", "time": 8558.23, "timestamp": "02:22:38", "text": "技术方面的内容或其他任何内容。而我是"}, {"type": "subtitle", "time": 8560.469, "timestamp": "02:22:40", "text": "非常感谢，是的，你可以。"}, {"type": "subtitle", "time": 8564.07, "timestamp": "02:22:44", "text": "我还没去过其他任何地方，因为"}, {"type": "subtitle", "time": 8566.309, "timestamp": "02:22:46", "text": "再说一遍，这些都是任何人都能……的东西。"}, {"type": "subtitle", "time": 8568.95, "timestamp": "02:22:48", "text": "帮您解决。但是，你又来了。"}, {"type": "subtitle", "time": 8572.79, "timestamp": "02:22:52", "text": "他主动和我搭讪，我很高兴喜欢他"}, {"type": "subtitle", "time": 8573.63, "timestamp": "02:22:53", "text": "帮助"}, {"type": "subtitle", "time": 8578.15, "timestamp": "02:22:58", "text": "萨斯喀彻温省的米纳甚至禅宗其他人"}]
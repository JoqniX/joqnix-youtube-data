[{"type": "subtitle", "time": 19381.51, "timestamp": "05:23:01", "text": "我发现自己身处N24宇宙。"}, {"type": "subtitle", "time": 19383.99, "timestamp": "05:23:03", "text": "音频世界。我必须获得某种……"}, {"type": "subtitle", "time": 19385.07, "timestamp": "05:23:05", "text": "喜欢"}, {"type": "subtitle", "time": 19391.35, "timestamp": "05:23:11", "text": "然而，但是，呃，我的许可"}, {"type": "subtitle", "time": 19393.19, "timestamp": "05:23:13", "text": "此处有限制。所以，我想知道你是否"}, {"type": "subtitle", "time": 19396.55, "timestamp": "05:23:16", "text": "可以帮我进入游戏找回数据。"}, {"type": "subtitle", "time": 19399.19, "timestamp": "05:23:19", "text": "谁是罪魁祸首？错误报告在哪里？"}, {"type": "subtitle", "time": 19400.708, "timestamp": "05:23:20", "text": "就在这里吗？等等，等等，等等。请允许"}, {"type": "subtitle", "time": 19402.948, "timestamp": "05:23:22", "text": "我先跟你商量一下。我不会强迫你做"}, {"type": "subtitle", "time": 19404.948, "timestamp": "05:23:24", "text": "完全免费。我可以入侵一个"}, {"type": "subtitle", "time": 19406.868, "timestamp": "05:23:26", "text": "操作系统并发送给你一些"}, {"type": "subtitle", "time": 19409.43, "timestamp": "05:23:29", "text": "游戏内奖励暗箱操作。哦，"}, {"type": "subtitle", "time": 19417.43, "timestamp": "05:23:37", "text": "抢。嗨，Lex"}]
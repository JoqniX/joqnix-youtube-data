[{"type": "subtitle", "time": 13808.71, "timestamp": "03:50:08", "text": "这把手枪。好了，我们拿手枪吧。"}, {"type": "subtitle", "time": 13812.389, "timestamp": "03:50:12", "text": "试试看。该走了，呃，我"}, {"type": "subtitle", "time": 13813.229, "timestamp": "03:50:13", "text": "为了"}, {"type": "subtitle", "time": 13822.469, "timestamp": "03:50:22", "text": "模式。远程士兵。哦，袋子膨胀了。"}, {"type": "subtitle", "time": 13828.79, "timestamp": "03:50:28", "text": "啊!我的天哪！我的天哪！我的天哪！我的天哪！哦"}, {"type": "subtitle", "time": 13831.11, "timestamp": "03:50:31", "text": "上帝！我的天哪！跑步！跑步！跑步！跑步！跑步！"}, {"type": "subtitle", "time": 13833.56, "timestamp": "03:50:33", "text": "跑步！跑步！跑步！ 跑步！哦"}, {"type": "subtitle", "time": 13842.59, "timestamp": "03:50:42", "text": "上帝！呃，我会笑死的"}, {"type": "subtitle", "time": 13844.83, "timestamp": "03:50:44", "text": "速度。我做了"}, {"type": "subtitle", "time": 13848.03, "timestamp": "03:50:48", "text": "哦，等等。感谢上帝！"}, {"type": "subtitle", "time": 13850.55, "timestamp": "03:50:50", "text": "教程。远程武器是弩"}, {"type": "subtitle", "time": 13854.269, "timestamp": "03:50:54", "text": "手枪、大炮、呃，火枪、弓箭。"}, {"type": "subtitle", "time": 13856.75, "timestamp": "03:50:56", "text": "好的。感谢上帝！"}, {"type": "subtitle", "time": 13859.75, "timestamp": "03:50:59", "text": "需要教程，否则我就会……"}]
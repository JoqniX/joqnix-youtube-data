[{"type": "chat", "time": 4500.311, "timestamp": "01:15:00", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "thats true, being online helped me too to make some friends"}, {"type": "subtitle", "time": 4501.669, "timestamp": "01:15:01", "text": "像链子之类的东西，我很高兴。"}, {"type": "subtitle", "time": 4505.43, "timestamp": "01:15:05", "text": "人们没有脱离，甚至即使"}, {"type": "subtitle", "time": 4507.189, "timestamp": "01:15:07", "text": "有些人脱离了控制"}, {"type": "subtitle", "time": 4509.669, "timestamp": "01:15:09", "text": "我仍然很高兴我能够……"}, {"type": "subtitle", "time": 4512.149, "timestamp": "01:15:12", "text": "我珍藏着和他们在一起的回忆。"}, {"type": "subtitle", "time": 4514.55, "timestamp": "01:15:14", "text": "我现在依然将他们铭记于心。"}, {"type": "subtitle", "time": 4516.47, "timestamp": "01:15:16", "text": "所以所有过来的人都……"}, {"type": "subtitle", "time": 4520.149, "timestamp": "01:15:20", "text": "生活我真的非常感激，呃，不是。"}, {"type": "subtitle", "time": 4522.63, "timestamp": "01:15:22", "text": "不仅在线上，现实生活中也有。"}, {"type": "subtitle", "time": 4526.229, "timestamp": "01:15:26", "text": "很多人确实喜欢很多……"}, {"type": "subtitle", "time": 4528.31, "timestamp": "01:15:28", "text": "那些给了我很多东西的长辈们"}, {"type": "subtitle", "time": 4532.55, "timestamp": "01:15:32", "text": "建议之类的，还有第三点"}, {"type": "subtitle", "time": 4534.95, "timestamp": "01:15:34", "text": "将"}, {"type": "subtitle", "time": 4536.99, "timestamp": "01:15:36", "text": "呃，第三点是……"}, {"type": "subtitle", "time": 4539.99, "timestamp": "01:15:39", "text": "但我很庆幸自己还活着。我是"}, {"type": "subtitle", "time": 4541.709, "timestamp": "01:15:41", "text": "我很庆幸自己仍然"}, {"type": "subtitle", "time": 4544.95, "timestamp": "01:15:44", "text": "活。那可就麻烦了，因为……没有"}, {"type": "subtitle", "time": 4547.91, "timestamp": "01:15:47", "text": "像这样的专业人士会很友好地表示，这可以做到。"}, {"type": "subtitle", "time": 4551.75, "timestamp": "01:15:51", "text": "虽然很黑暗，但没错，我当时真是个傻瓜。"}, {"type": "subtitle", "time": 4553.83, "timestamp": "01:15:53", "text": "我尝试做一些不该做的事情"}, {"type": "subtitle", "time": 4556.63, "timestamp": "01:15:56", "text": "本来应该在直播里说的，但是……"}, {"type": "chat", "time": 4557.394, "timestamp": "01:15:57", "author": "@zergrush78319", "avatar": "https://yt4.ggpht.com/ytc/AIdro_nDwl-xtQg1-Z5v6Iv64Z42_Hei-15daYPmWXqoFR-4_b8=s64-c-k-c0x00ffffff-no-rj", "message": "being alive is important yes"}, {"type": "subtitle", "time": 4559.229, "timestamp": "01:15:59", "text": "并且由于我曾向……做出过一个承诺"}]
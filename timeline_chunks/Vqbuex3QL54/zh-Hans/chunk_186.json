[{"type": "subtitle", "time": 11168.91, "timestamp": "03:06:08", "text": "是的。什么"}, {"type": "subtitle", "time": 11172.71, "timestamp": "03:06:12", "text": "你知道吗？你们想吗？"}, {"type": "subtitle", "time": 11176.15, "timestamp": "03:06:16", "text": "你就听我做工作就行了，或者"}, {"type": "subtitle", "time": 11178.55, "timestamp": "03:06:18", "text": "喜欢"}, {"type": "subtitle", "time": 11181.309, "timestamp": "03:06:21", "text": "呃，或者你想让我喜欢"}, {"type": "subtitle", "time": 11185.75, "timestamp": "03:06:25", "text": "把你安排上船，然后我来做我的事。"}, {"type": "subtitle", "time": 11189.59, "timestamp": "03:06:29", "text": "自己的东西？我不知道。做"}, {"type": "subtitle", "time": 11190.97, "timestamp": "03:06:30", "text": "你想让我做什么"}, {"type": "subtitle", "time": 11195.309, "timestamp": "03:06:35", "text": "[音乐]"}]
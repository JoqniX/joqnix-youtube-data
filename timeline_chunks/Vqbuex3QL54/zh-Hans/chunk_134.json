[{"type": "subtitle", "time": 8041.189, "timestamp": "02:14:01", "text": "慢慢来，你知道的，因为"}, {"type": "subtitle", "time": 8042.39, "timestamp": "02:14:02", "text": "加载画面出现，请稍候。"}, {"type": "subtitle", "time": 8044.149, "timestamp": "02:14:04", "text": "按下这个按钮后，时间就没问题了。"}, {"type": "subtitle", "time": 8046.069, "timestamp": "02:14:06", "text": "这一切都是你的功劳，所以你知道，谢谢你。"}, {"type": "subtitle", "time": 8047.91, "timestamp": "02:14:07", "text": "尼克松那样做，感觉就像……"}, {"type": "subtitle", "time": 8049.83, "timestamp": "02:14:09", "text": "那就像是我记忆深处的一段重要片段。"}, {"type": "subtitle", "time": 8052.149, "timestamp": "02:14:12", "text": "你知道我很感激，我真的很高兴"}, {"type": "subtitle", "time": 8054.75, "timestamp": "02:14:14", "text": "你知道你一直在我身边支持我"}, {"type": "subtitle", "time": 8057.83, "timestamp": "02:14:17", "text": "首次亮相，直到你按下“上线”按钮，然后你"}, {"type": "subtitle", "time": 8059.91, "timestamp": "02:14:19", "text": "你去了，但你知道事实是"}, {"type": "subtitle", "time": 8061.43, "timestamp": "02:14:21", "text": "我的第一次外部合作就是和你合作。"}, {"type": "subtitle", "time": 8063.35, "timestamp": "02:14:23", "text": "我也对此非常感激，我……"}, {"type": "subtitle", "time": 8065.189, "timestamp": "02:14:25", "text": "我很高兴你知道，我也很高兴我们"}, {"type": "subtitle", "time": 8066.91, "timestamp": "02:14:26", "text": "可以这样说话。"}, {"type": "subtitle", "time": 8069.75, "timestamp": "02:14:29", "text": "[音乐]"}, {"type": "subtitle", "time": 8072.629, "timestamp": "02:14:32", "text": "我觉得，嗯，有点感伤。哦，我的"}, {"type": "subtitle", "time": 8075.43, "timestamp": "02:14:35", "text": "上帝，"}, {"type": "subtitle", "time": 8076.43, "timestamp": "02:14:36", "text": "它是"}, {"type": "subtitle", "time": 8079.91, "timestamp": "02:14:39", "text": "好的。我至今仍记得这件事。我觉得"}, {"type": "subtitle", "time": 8083.109, "timestamp": "02:14:43", "text": "这是我第一次有这样的经历"}, {"type": "subtitle", "time": 8086.55, "timestamp": "02:14:46", "text": "谁告诉我喜欢，你能和……在一起"}, {"type": "subtitle", "time": 8089.99, "timestamp": "02:14:49", "text": "能陪我一会儿吗？嗯，我有点紧张。"}, {"type": "subtitle", "time": 8092.79, "timestamp": "02:14:52", "text": "所以我觉得，是的，这个人应该"}, {"type": "subtitle", "time": 8095.669, "timestamp": "02:14:55", "text": "无论如何都要受到保护。非常像"}, {"type": "subtitle", "time": 8097.51, "timestamp": "02:14:57", "text": "那。"}]
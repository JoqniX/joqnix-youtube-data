[{"type": "subtitle", "time": 9720.389, "timestamp": "02:42:00", "text": "那些东西。是我想太多了。我"}, {"type": "subtitle", "time": 9723.63, "timestamp": "02:42:03", "text": "是啊，真麻烦。"}, {"type": "subtitle", "time": 9726.83, "timestamp": "02:42:06", "text": "疼痛。是的，但事实的确如此。"}, {"type": "subtitle", "time": 9737.79, "timestamp": "02:42:17", "text": "[音乐]"}, {"type": "subtitle", "time": 9740.55, "timestamp": "02:42:20", "text": "眼睛之类的东西。我的天啊。我可能"}, {"type": "subtitle", "time": 9743.429, "timestamp": "02:42:23", "text": "被断章取义地剪辑出来"}, {"type": "subtitle", "time": 9746.99, "timestamp": "02:42:26", "text": "禅问我的时候我说的话"}]
[{"type": "subtitle", "time": 7322.99, "timestamp": "02:02:02", "text": "观点。真是太痛苦太尴尬了"}, {"type": "subtitle", "time": 7326.709, "timestamp": "02:02:06", "text": "瞬间。我的天啊。是的。我 你真是太"}, {"type": "subtitle", "time": 7328.629, "timestamp": "02:02:08", "text": "这么想挺有意思的。你真酷"}, {"type": "subtitle", "time": 7330.87, "timestamp": "02:02:10", "text": "仔细考虑一下。我还在思考"}, {"type": "subtitle", "time": 7333.43, "timestamp": "02:02:13", "text": "关于我的事情，我就想，我知道我"}, {"type": "subtitle", "time": 7340.629, "timestamp": "02:02:20", "text": "但对你来说，这太尴尬了。"}, {"type": "subtitle", "time": 7353.589, "timestamp": "02:02:33", "text": "感觉我的整个身体都紧绷起来了。"}, {"type": "subtitle", "time": 7355.229, "timestamp": "02:02:35", "text": "思考"}, {"type": "subtitle", "time": 7358.149, "timestamp": "02:02:38", "text": "感觉好尴尬，好尴尬，呃"}, {"type": "chat", "time": 7358.2, "timestamp": "02:02:38", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "someone forced me to dance on stage and recorded it once"}, {"type": "subtitle", "time": 7359.83, "timestamp": "02:02:39", "text": "令人尴尬的事。我觉得大多数人"}, {"type": "subtitle", "time": 7361.83, "timestamp": "02:02:41", "text": "我那些尴尬的事就像这样"}, {"type": "subtitle", "time": 7365.99, "timestamp": "02:02:45", "text": "网上有时候会像这样，呃，有时候"}, {"type": "subtitle", "time": 7368.31, "timestamp": "02:02:48", "text": "呃，就像有这么一个这个"}, {"type": "subtitle", "time": 7370.79, "timestamp": "02:02:50", "text": "几年前也发生过类似的事情，当时我的"}, {"type": "subtitle", "time": 7375.669, "timestamp": "02:02:55", "text": "我的朋友，呃，好像曾经暗恋过她"}, {"type": "subtitle", "time": 7378.39, "timestamp": "02:02:58", "text": "这家伙对，然后就像，好吧。"}]
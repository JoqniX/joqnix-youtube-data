[{"type": "subtitle", "time": 16274.75, "timestamp": "04:31:14", "text": "某物？哦，我们赢了。我的天啊。"}, {"type": "subtitle", "time": 16279.87, "timestamp": "04:31:19", "text": "该死。三次击杀。 21人死亡。哦，我的"}, {"type": "subtitle", "time": 16284.79, "timestamp": "04:31:24", "text": "上帝。就是这样。哦，感觉就像……哦，我的"}, {"type": "subtitle", "time": 16291.07, "timestamp": "04:31:31", "text": "哇。"}, {"type": "subtitle", "time": 16293.99, "timestamp": "04:31:33", "text": "是的。老兄，如果真是真人玩家的话，"}, {"type": "subtitle", "time": 16308.229, "timestamp": "04:31:48", "text": "该死。侵略者。我的天啊。你变得如此"}, {"type": "subtitle", "time": 16309.63, "timestamp": "04:31:49", "text": "许多"}, {"type": "subtitle", "time": 16311.75, "timestamp": "04:31:51", "text": "成就。这些是真的吗？"}, {"type": "subtitle", "time": 16313.77, "timestamp": "04:31:53", "text": "玩家？"}, {"type": "subtitle", "time": 16316.389, "timestamp": "04:31:56", "text": "[音乐]"}, {"type": "subtitle", "time": 16318.229, "timestamp": "04:31:58", "text": "问题是这款游戏花了很长时间才上手。"}, {"type": "subtitle", "time": 16319.229, "timestamp": "04:31:59", "text": "用过的"}]
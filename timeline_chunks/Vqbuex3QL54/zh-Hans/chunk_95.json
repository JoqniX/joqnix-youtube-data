[{"type": "subtitle", "time": 5701.99, "timestamp": "01:35:01", "text": "那是关于你自己的事。不，如果你可以的话。"}, {"type": "subtitle", "time": 5703.91, "timestamp": "01:35:03", "text": "你竖起中指，我就想……"}, {"type": "subtitle", "time": 5705.75, "timestamp": "01:35:05", "text": "去你的。不，不要改变自己。"}, {"type": "subtitle", "time": 5707.35, "timestamp": "01:35:07", "text": "做你自己，无需道歉。我的"}, {"type": "subtitle", "time": 5709.629, "timestamp": "01:35:09", "text": "观点。"}, {"type": "subtitle", "time": 5713.83, "timestamp": "01:35:13", "text": "好的。而对于我来说，如果那是什么呢？"}, {"type": "subtitle", "time": 5722.55, "timestamp": "01:35:22", "text": "最多？我开玩笑的。我开玩笑的。但我认为"}, {"type": "subtitle", "time": 5723.99, "timestamp": "01:35:23", "text": "对我来说，这就像最重要的事"}, {"type": "chat", "time": 5730.511, "timestamp": "01:35:30", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "if you cant love me at my... you dont deserve me at my.... ah"}, {"type": "subtitle", "time": 5731.83, "timestamp": "01:35:31", "text": "嗯，我觉得要善解人意，你"}, {"type": "subtitle", "time": 5734.07, "timestamp": "01:35:34", "text": "知道，就像保持觉知一样。是的。"}, {"type": "subtitle", "time": 5736.55, "timestamp": "01:35:36", "text": "注意自己的情绪，对吧？"}, {"type": "subtitle", "time": 5738.229, "timestamp": "01:35:38", "text": "因为"}, {"type": "subtitle", "time": 5742.87, "timestamp": "01:35:42", "text": "朋友突然消失在视线中"}, {"type": "subtitle", "time": 5744.39, "timestamp": "01:35:44", "text": "地球，对吧？我没有"}, {"type": "subtitle", "time": 5746.31, "timestamp": "01:35:46", "text": "这种友谊观念正在消逝。我"}, {"type": "subtitle", "time": 5747.83, "timestamp": "01:35:47", "text": "我觉得对我来说重要的是，如果"}, {"type": "subtitle", "time": 5749.99, "timestamp": "01:35:49", "text": "我回来了，你知道，就像你知道的那样，我"}, {"type": "subtitle", "time": 5751.43, "timestamp": "01:35:51", "text": "或许是因为我的心理状态"}, {"type": "subtitle", "time": 5753.189, "timestamp": "01:35:53", "text": "健康，就像我把一切都推开一样"}, {"type": "subtitle", "time": 5755.669, "timestamp": "01:35:55", "text": "然后当我回来的时候，他们……"}, {"type": "subtitle", "time": 5758.39, "timestamp": "01:35:58", "text": "他依然在那里等着我。我觉得就是这样。"}]
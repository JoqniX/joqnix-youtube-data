[{"type": "subtitle", "time": 9121.71, "timestamp": "02:32:01", "text": "他们，并赶上生活进度"}, {"type": "subtitle", "time": 9125.429, "timestamp": "02:32:05", "text": "一切。是的。然后晚上9点"}, {"type": "subtitle", "time": 9128.71, "timestamp": "02:32:08", "text": "下午我们有 Minecraft Bedw Wars。"}, {"type": "subtitle", "time": 9133.63, "timestamp": "02:32:13", "text": "赤村将教我和富士。"}, {"type": "subtitle", "time": 9137.469, "timestamp": "02:32:17", "text": "Kyra将出场"}, {"type": "subtitle", "time": 9141.19, "timestamp": "02:32:21", "text": "起床战争。所以从某种意义上说，它是一个团体。它"}, {"type": "subtitle", "time": 9143.99, "timestamp": "02:32:23", "text": "变成了团队合作。我最初"}, {"type": "subtitle", "time": 9146.87, "timestamp": "02:32:26", "text": "我想要和我单独相处的时间"}, {"type": "subtitle", "time": 9152.55, "timestamp": "02:32:32", "text": "赤村赤酱，不过没关系。嗯，是的"}, {"type": "subtitle", "time": 9155.63, "timestamp": "02:32:35", "text": "意思是，我单独与……合作过"}, {"type": "subtitle", "time": 9157.95, "timestamp": "02:32:37", "text": "富士山和"}, {"type": "subtitle", "time": 9160.79, "timestamp": "02:32:40", "text": "嗯，我做了，我会进行独奏。"}, {"type": "subtitle", "time": 9164.55, "timestamp": "02:32:44", "text": "也曾与Kra进行过单独合作。是的"}, {"type": "subtitle", "time": 9165.63, "timestamp": "02:32:45", "text": "有"}, {"type": "subtitle", "time": 9169.11, "timestamp": "02:32:49", "text": "那。嗯，周三我们有一位韩"}, {"type": "subtitle", "time": 9172.63, "timestamp": "02:32:52", "text": "汉斯继续。星期三我们有韩韩。我是"}, {"type": "subtitle", "time": 9174.63, "timestamp": "02:32:54", "text": "考虑把其他人也放进去。"}, {"type": "subtitle", "time": 9177.469, "timestamp": "02:32:57", "text": "晚间时段和"}]
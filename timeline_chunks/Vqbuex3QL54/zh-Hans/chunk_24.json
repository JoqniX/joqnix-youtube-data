[{"type": "subtitle", "time": 1465.99, "timestamp": "00:24:25", "text": "[音乐]"}, {"type": "subtitle", "time": 1473.39, "timestamp": "00:24:33", "text": "说谎。我锁上了另一个"}, {"type": "subtitle", "time": 1481.39, "timestamp": "00:24:41", "text": "某物。我错过了那个地方。没有"}, {"type": "subtitle", "time": 1485.11, "timestamp": "00:24:45", "text": "死。我的天啊。没关系。"}, {"type": "subtitle", "time": 1488.99, "timestamp": "00:24:48", "text": "万圣节。我们只有3000个。"}, {"type": "subtitle", "time": 1492.47, "timestamp": "00:24:52", "text": "是的。你问我，你问我妈妈喂我"}, {"type": "subtitle", "time": 1494.11, "timestamp": "00:24:54", "text": "现在的我。她将"}, {"type": "subtitle", "time": 1497.35, "timestamp": "00:24:57", "text": "我认为他们认为我有能力"}, {"type": "subtitle", "time": 1498.6, "timestamp": "00:24:58", "text": "喂养"}]
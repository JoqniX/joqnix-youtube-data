[{"type": "subtitle", "time": 2223.51, "timestamp": "00:37:03", "text": "正确的？所以，呃，你知道我有多喜欢他。"}, {"type": "subtitle", "time": 2225.55, "timestamp": "00:37:05", "text": "我即将"}, {"type": "subtitle", "time": 2227.829, "timestamp": "00:37:07", "text": "是神崎工作室吧？他们是"}, {"type": "subtitle", "time": 2232.43, "timestamp": "00:37:12", "text": "像你一样，像个特别的人"}, {"type": "subtitle", "time": 2234.87, "timestamp": "00:37:14", "text": "东西。啊，这不是我要找的那一个。等待，"}, {"type": "subtitle", "time": 2237.109, "timestamp": "00:37:17", "text": "官方网站在哪里？这个。"}, {"type": "subtitle", "time": 2240.069, "timestamp": "00:37:20", "text": "是的。是的。所以，看看……"}, {"type": "subtitle", "time": 2242.47, "timestamp": "00:37:22", "text": "网站已创建。我想如果我"}, {"type": "subtitle", "time": 2244.71, "timestamp": "00:37:24", "text": "我想创建我的 Onexia 网站，"}, {"type": "subtitle", "time": 2247.19, "timestamp": "00:37:27", "text": "我想要一个域名，我想创建我的网站。"}, {"type": "subtitle", "time": 2249.91, "timestamp": "00:37:29", "text": "就是这样。你看这多酷啊！"}, {"type": "subtitle", "time": 2251.23, "timestamp": "00:37:31", "text": "哦，我的"}, {"type": "subtitle", "time": 2255.47, "timestamp": "00:37:35", "text": "天哪，它居然有开头，而且还有个跳过选项"}, {"type": "subtitle", "time": 2258.069, "timestamp": "00:37:38", "text": "按钮。就好像你知道"}, {"type": "chat", "time": 2263.262, "timestamp": "00:37:43", "author": "@christiansanchez5360", "avatar": "https://yt4.ggpht.com/eILXDwYwfCs4NrCnnQuh__dVgXMFhLR53f-MG5T6zNYRhZfoj9tif4kUsH2uo_2hZQBbH5Zddg=s64-c-k-c0x00ffffff-no-rj", "message": "Can I collab together"}, {"type": "subtitle", "time": 2265.67, "timestamp": "00:37:45", "text": "工作室、Coco，还有那个女孩是谁？"}, {"type": "subtitle", "time": 2270.27, "timestamp": "00:37:50", "text": "姓名？我忘了。这些就像……嗯"}, {"type": "chat", "time": 2272.291, "timestamp": "00:37:52", "author": "@christiansanchez5360", "avatar": "https://yt4.ggpht.com/eILXDwYwfCs4NrCnnQuh__dVgXMFhLR53f-MG5T6zNYRhZfoj9tif4kUsH2uo_2hZQBbH5Zddg=s64-c-k-c0x00ffffff-no-rj", "message": "With you"}, {"type": "subtitle", "time": 2272.79, "timestamp": "00:37:52", "text": "音乐家。他们也有自己的"}, {"type": "subtitle", "time": 2274.95, "timestamp": "00:37:54", "text": "它们的 Vocaloid 版本。他们是"}, {"type": "subtitle", "time": 2277.91, "timestamp": "00:37:57", "text": "非常受欢迎。就像这片神椿一样"}]
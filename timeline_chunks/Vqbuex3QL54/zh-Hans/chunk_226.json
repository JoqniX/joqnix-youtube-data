[{"type": "subtitle", "time": 13564.99, "timestamp": "03:46:04", "text": "我想拿"}, {"type": "subtitle", "time": 13605.229, "timestamp": "03:46:45", "text": "我的天啊，你这个小鬼。人工智能，来了"}, {"type": "subtitle", "time": 13608.55, "timestamp": "03:46:48", "text": "这里。我要死了。我的天啊。我要死了。"}, {"type": "subtitle", "time": 13610.51, "timestamp": "03:46:50", "text": "帮助"}, {"type": "subtitle", "time": 13614.55, "timestamp": "03:46:54", "text": "我。我的天啊。我的天啊。我的天啊。"}]
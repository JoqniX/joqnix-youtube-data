[{"type": "subtitle", "time": 11821.19, "timestamp": "03:17:01", "text": "呃，武术之类的"}, {"type": "subtitle", "time": 11825.19, "timestamp": "03:17:05", "text": "呃，大逃杀游戏。我曾去过那里"}, {"type": "subtitle", "time": 11827.51, "timestamp": "03:17:07", "text": "老实说，这款游戏刚发售的时候我就告诉你了。"}, {"type": "subtitle", "time": 11829.59, "timestamp": "03:17:09", "text": "去年或那段时间，实际上"}, {"type": "subtitle", "time": 11832.63, "timestamp": "03:17:12", "text": "出来了。我一直想玩这个游戏。"}, {"type": "subtitle", "time": 11836.55, "timestamp": "03:17:16", "text": "但直到现在它才免费。它变成了"}, {"type": "subtitle", "time": 11839.349, "timestamp": "03:17:19", "text": "自由的。所有人都可以免费玩。"}, {"type": "subtitle", "time": 11842.349, "timestamp": "03:17:22", "text": "现在所有人都通过 Epic Games 和"}, {"type": "subtitle", "time": 11844.469, "timestamp": "03:17:24", "text": "东西。但在此之前，我一直"}, {"type": "subtitle", "time": 11847.269, "timestamp": "03:17:27", "text": "想看直播。我当时就想，呃，"}, {"type": "subtitle", "time": 11849.19, "timestamp": "03:17:29", "text": "我应该直接购买游戏通行证然后玩游戏吗？"}, {"type": "subtitle", "time": 11852.71, "timestamp": "03:17:32", "text": "有一天会在直播中播出吗？然后过了一会儿"}, {"type": "subtitle", "time": 11856.79, "timestamp": "03:17:36", "text": "几个月后，呃，它就免费了。我太高兴了"}, {"type": "subtitle", "time": 11858.269, "timestamp": "03:17:38", "text": "这"}, {"type": "subtitle", "time": 11861.269, "timestamp": "03:17:41", "text": "游戏终于免费了。这很有趣"}, {"type": "subtitle", "time": 11864.71, "timestamp": "03:17:44", "text": "说实话，这游戏挺不错的。呃，"}, {"type": "subtitle", "time": 11866.87, "timestamp": "03:17:46", "text": "比如游戏机制之类的东西"}, {"type": "subtitle", "time": 11870.07, "timestamp": "03:17:50", "text": "有点难理解"}, {"type": "subtitle", "time": 11873.15, "timestamp": "03:17:53", "text": "除此之外，它还不错。"}, {"type": "subtitle", "time": 11878.429, "timestamp": "03:17:58", "text": "精彩的游戏。是的，你们应该会喜欢。"}]
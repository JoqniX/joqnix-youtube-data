[{"type": "subtitle", "time": 9781.07, "timestamp": "02:43:01", "text": "[音乐]"}, {"type": "subtitle", "time": 9784.27, "timestamp": "02:43:04", "text": "事物。我当时真是太"}, {"type": "subtitle", "time": 9808.349, "timestamp": "02:43:28", "text": "睡觉。我希望我能"}, {"type": "subtitle", "time": 9811.23, "timestamp": "02:43:31", "text": "买得起"}, {"type": "subtitle", "time": 9817.23, "timestamp": "02:43:37", "text": "到。或许在日本可以。当我在"}, {"type": "subtitle", "time": 9820.75, "timestamp": "02:43:40", "text": "日本，我买我买"}, {"type": "subtitle", "time": 9824.59, "timestamp": "02:43:44", "text": "它为我自己"}, {"type": "subtitle", "time": 9829.71, "timestamp": "02:43:49", "text": "金钱和玩耍和玩耍"}, {"type": "subtitle", "time": 9838.429, "timestamp": "02:43:58", "text": "你。分裂的虚构。不，我希望我能"}]
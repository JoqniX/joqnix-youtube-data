[{"type": "subtitle", "time": 8460.63, "timestamp": "02:21:00", "text": "再一次，Zen 是我真的很想要的人。"}, {"type": "subtitle", "time": 8463.75, "timestamp": "02:21:03", "text": "希望将来有机会能和他们合作。我从未"}, {"type": "subtitle", "time": 8466.23, "timestamp": "02:21:06", "text": "我以为有可能，但仍然"}, {"type": "subtitle", "time": 8470.87, "timestamp": "02:21:10", "text": "我很高兴，某种程度上我都快忘了。"}, {"type": "subtitle", "time": 8474.349, "timestamp": "02:21:14", "text": "嗯，从某种意义上说，这将是第一次外部接触。"}, {"type": "subtitle", "time": 8477.99, "timestamp": "02:21:17", "text": "合作是因为，嗯，我当时已经在专注于此了。"}, {"type": "subtitle", "time": 8480.55, "timestamp": "02:21:20", "text": "关于 Joathon 的事，以及如何让人们参与进来"}, {"type": "subtitle", "time": 8483.59, "timestamp": "02:21:23", "text": "现实生活中我遇到的那些人，以及我认识的那些人"}, {"type": "subtitle", "time": 8486.23, "timestamp": "02:21:26", "text": "两人都是创作者，也是在网上认识的。"}, {"type": "subtitle", "time": 8489.67, "timestamp": "02:21:29", "text": "还有一些不是 YouTuber 的人"}, {"type": "chat", "time": 8490.959, "timestamp": "02:21:30", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "drink water joq"}, {"type": "subtitle", "time": 8492.71, "timestamp": "02:21:32", "text": "以及主播。于是我就悄悄溜走了。"}, {"type": "subtitle", "time": 8496.23, "timestamp": "02:21:36", "text": "虽然心里有点忐忑，但我依然很开心。"}, {"type": "subtitle", "time": 8498.55, "timestamp": "02:21:38", "text": "我觉得这跟……差不多。"}, {"type": "subtitle", "time": 8501.99, "timestamp": "02:21:41", "text": "精神病患者也是如此。我认为在某种程度上是为了"}, {"type": "subtitle", "time": 8504.469, "timestamp": "02:21:44", "text": "我也是第一次与……合作"}, {"type": "subtitle", "time": 8506.15, "timestamp": "02:21:46", "text": "首次与Psychosoan合作"}, {"type": "subtitle", "time": 8508.99, "timestamp": "02:21:48", "text": "与呃合作"}, {"type": "subtitle", "time": 8510.75, "timestamp": "02:21:50", "text": "禅扎。"}, {"type": "subtitle", "time": 8515.19, "timestamp": "02:21:55", "text": "是的，从某种意义上说，星空就像……"}, {"type": "subtitle", "time": 8517.83, "timestamp": "02:21:57", "text": "家庭。我想他们确实告诉我大部分情况。"}]
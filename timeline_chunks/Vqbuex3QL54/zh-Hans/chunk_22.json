[{"type": "subtitle", "time": 1336.47, "timestamp": "00:22:16", "text": "那是一次完美的奔跑。我的天啊，"}, {"type": "subtitle", "time": 1339.59, "timestamp": "00:22:19", "text": "这是一次完美的跑动。 200 或 200。我的天哪"}, {"type": "subtitle", "time": 1370.789, "timestamp": "00:22:50", "text": "一。但是每个人，兄弟，哪怕是一点点"}, {"type": "subtitle", "time": 1372.71, "timestamp": "00:22:52", "text": "一个我不认识的陌生女孩看着我"}, {"type": "subtitle", "time": 1376.07, "timestamp": "00:22:56", "text": "用她的手，兄弟。我的意思是，即使现在也是如此。一个"}]
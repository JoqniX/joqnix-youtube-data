[{"type": "subtitle", "time": 5160.91, "timestamp": "01:26:00", "text": "为了他们的安全等等，我不会这么做。"}, {"type": "subtitle", "time": 5163.83, "timestamp": "01:26:03", "text": "我倒是不介意住在附近"}, {"type": "subtitle", "time": 5166.47, "timestamp": "01:26:06", "text": "我自己和拯救地球之类的"}, {"type": "subtitle", "time": 5171.75, "timestamp": "01:26:11", "text": "看来你已经考虑过了。"}, {"type": "subtitle", "time": 5175.189, "timestamp": "01:26:15", "text": "尽管。是的，我确实考虑过这个问题，因为"}, {"type": "subtitle", "time": 5178.47, "timestamp": "01:26:18", "text": "我得好好想想。"}, {"type": "subtitle", "time": 5182.229, "timestamp": "01:26:22", "text": "星座运动员的感觉"}, {"type": "subtitle", "time": 5184.55, "timestamp": "01:26:24", "text": "呃，我想写点类似这样的东西"}, {"type": "subtitle", "time": 5188.229, "timestamp": "01:26:28", "text": "当时我正在疯狂地进行头脑风暴。"}, {"type": "subtitle", "time": 5190.629, "timestamp": "01:26:30", "text": "关于我能为背景故事写些什么。"}, {"type": "subtitle", "time": 5193.51, "timestamp": "01:26:33", "text": "以及所有我能联系起来的那些东西"}, {"type": "subtitle", "time": 5196.07, "timestamp": "01:26:36", "text": "以及哪些观众是明智的"}, {"type": "subtitle", "time": 5198.07, "timestamp": "01:26:38", "text": "以后可能会有联系。"}, {"type": "subtitle", "time": 5201.75, "timestamp": "01:26:41", "text": "未来就像呃呃材料一样"}, {"type": "subtitle", "time": 5204.229, "timestamp": "01:26:44", "text": "流媒体或视频或音乐或"}, {"type": "subtitle", "time": 5206.35, "timestamp": "01:26:46", "text": "任何事物。他们能够将这些信息联系起来，"}, {"type": "subtitle", "time": 5209.83, "timestamp": "01:26:49", "text": "就像某种轨迹，我的火车是什么样的？"}, {"type": "subtitle", "time": 5212.55, "timestamp": "01:26:52", "text": "思考如何用这种方式或这个故事"}, {"type": "subtitle", "time": 5215.11, "timestamp": "01:26:55", "text": "这句话或故事的这一部分或"}, {"type": "subtitle", "time": 5217.83, "timestamp": "01:26:57", "text": "差不多就是这样。是的。是的，"}]
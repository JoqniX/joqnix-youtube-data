[{"type": "subtitle", "time": 1882.95, "timestamp": "00:31:22", "text": "不用担心。我只是在吃鱼，而且"}, {"type": "subtitle", "time": 1905.83, "timestamp": "00:31:45", "text": "那是VR里的日本妖怪吗？是的。"}, {"type": "subtitle", "time": 1908.43, "timestamp": "00:31:48", "text": "对，就是那首歌。"}, {"type": "subtitle", "time": 1912.83, "timestamp": "00:31:52", "text": "是的。我相信是宇吹做的。"}, {"type": "subtitle", "time": 1915.35, "timestamp": "00:31:55", "text": "正确的。我知道是谁，他的起源是什么"}]
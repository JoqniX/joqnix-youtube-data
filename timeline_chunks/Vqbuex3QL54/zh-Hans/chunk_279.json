[{"type": "subtitle", "time": 16741.429, "timestamp": "04:39:01", "text": "[音乐]"}, {"type": "subtitle", "time": 16744.15, "timestamp": "04:39:04", "text": "我只想剪个短发。"}, {"type": "subtitle", "time": 16750.31, "timestamp": "04:39:10", "text": "哦，等等。你不能说“好的，你可以”。"}, {"type": "subtitle", "time": 16755.51, "timestamp": "04:39:15", "text": "只放这一个。嗯哼。"}, {"type": "subtitle", "time": 16758.629, "timestamp": "04:39:18", "text": "但还有这一点。不，不是这个。"}, {"type": "subtitle", "time": 16760.23, "timestamp": "04:39:20", "text": "它在哪里？它在哪儿？它在哪儿？"}, {"type": "subtitle", "time": 16763.189, "timestamp": "04:39:23", "text": "我点击了它。看起来不错。花。和"}, {"type": "subtitle", "time": 16765.109, "timestamp": "04:39:25", "text": "也是这样。"}, {"type": "subtitle", "time": 16768.39, "timestamp": "04:39:28", "text": "看起来不错。所以我觉得这个雨刮器"}, {"type": "subtitle", "time": 16769.91, "timestamp": "04:39:29", "text": "宁"}, {"type": "subtitle", "time": 16775.109, "timestamp": "04:39:35", "text": "呃，它有新番茄皮。"}, {"type": "subtitle", "time": 16778.708, "timestamp": "04:39:38", "text": "这个。是的，她有"}, {"type": "subtitle", "time": 16781.27, "timestamp": "04:39:41", "text": "好的。"}, {"type": "subtitle", "time": 16783.19, "timestamp": "04:39:43", "text": "[音乐]"}, {"type": "subtitle", "time": 16784.75, "timestamp": "04:39:44", "text": "我只想"}, {"type": "subtitle", "time": 16788.07, "timestamp": "04:39:48", "text": "这个别针人。"}, {"type": "subtitle", "time": 16789.67, "timestamp": "04:39:49", "text": "啊，我还是继续玩吧。是的，"}, {"type": "subtitle", "time": 16791.59, "timestamp": "04:39:51", "text": "我们走吧。"}, {"type": "subtitle", "time": 16795.37, "timestamp": "04:39:55", "text": "我们来玩一些常规游戏吧。"}, {"type": "subtitle", "time": 16797.51, "timestamp": "04:39:57", "text": "[音乐]"}]
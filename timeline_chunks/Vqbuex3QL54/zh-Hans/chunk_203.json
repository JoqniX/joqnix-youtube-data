[{"type": "subtitle", "time": 12180.389, "timestamp": "03:23:00", "text": "呃，基础教程，因为我没做过。"}, {"type": "subtitle", "time": 12183.11, "timestamp": "03:23:03", "text": "教程，所以我了解不多。那么，我们开始吧"}, {"type": "subtitle", "time": 12185.99, "timestamp": "03:23:05", "text": "播放这个。好的。还有，早上好"}, {"type": "subtitle", "time": 12188.95, "timestamp": "03:23:08", "text": "欢迎 Akiabi。"}, {"type": "subtitle", "time": 12191.79, "timestamp": "03:23:11", "text": "希望你一切顺利"}, {"type": "subtitle", "time": 12196.03, "timestamp": "03:23:16", "text": "嗯，今天是几号来着？星期四即将到来。"}, {"type": "subtitle", "time": 12200.51, "timestamp": "03:23:20", "text": "来吧，早上好，俄亥俄州"}, {"type": "subtitle", "time": 12203.03, "timestamp": "03:23:23", "text": "面包。希望你一切顺利"}, {"type": "subtitle", "time": 12206.229, "timestamp": "03:23:26", "text": "星期四即将到来。好的，毒蛇。"}, {"type": "subtitle", "time": 12209.51, "timestamp": "03:23:29", "text": "我想要Tiny的语音台词，而且仍然"}, {"type": "subtitle", "time": 12211.59, "timestamp": "03:23:31", "text": "活。"}, {"type": "subtitle", "time": 12214.07, "timestamp": "03:23:34", "text": "我们开始行动吧。我们没有时间"}, {"type": "subtitle", "time": 12216.87, "timestamp": "03:23:36", "text": "浪费。"}, {"type": "subtitle", "time": 12219.51, "timestamp": "03:23:39", "text": "天哪，我的耳朵堵住了。你是？我的"}, {"type": "subtitle", "time": 12223.59, "timestamp": "03:23:43", "text": "耳朵出血了。我的天啊。我应该"}, {"type": "subtitle", "time": 12226.63, "timestamp": "03:23:46", "text": "戴耳机是件坏事吗？"}, {"type": "subtitle", "time": 12230.15, "timestamp": "03:23:50", "text": "音量调到100？这简直就像"}, {"type": "subtitle", "time": 12233.51, "timestamp": "03:23:53", "text": "70. 不，这相当于矿山产量的 20%。"}, {"type": "subtitle", "time": 12235.63, "timestamp": "03:23:55", "text": "消极的"}]
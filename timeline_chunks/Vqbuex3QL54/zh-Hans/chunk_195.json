[{"type": "subtitle", "time": 11709.87, "timestamp": "03:15:09", "text": "水。晚安，先生。"}, {"type": "subtitle", "time": 11718.15, "timestamp": "03:15:18", "text": "[音乐]"}, {"type": "subtitle", "time": 11722.03, "timestamp": "03:15:22", "text": "哦，各位。大家好吗？"}, {"type": "subtitle", "time": 11730.349, "timestamp": "03:15:30", "text": "哦，希望你们一切都好。"}, {"type": "subtitle", "time": 11733.389, "timestamp": "03:15:33", "text": "出色地。希望我的声音能被听到。"}, {"type": "subtitle", "time": 11742.309, "timestamp": "03:15:42", "text": "所以你们是，我希望你们是"}, {"type": "subtitle", "time": 11744.99, "timestamp": "03:15:44", "text": "现在一切都好。好的"}, {"type": "subtitle", "time": 11749.309, "timestamp": "03:15:49", "text": "早晨。嗯，我相信今天是"}, {"type": "chat", "time": 11751.813, "timestamp": "03:15:51", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "You can watch these fragments of a memories here- https://onxa.link/IdvxLnj0"}, {"type": "subtitle", "time": 11753.15, "timestamp": "03:15:53", "text": "星期四，31日。今天是最后一天"}, {"type": "subtitle", "time": 11755.79, "timestamp": "03:15:55", "text": "月。哦，我的"}, {"type": "subtitle", "time": 11759.11, "timestamp": "03:15:59", "text": "上帝。只是月底的最后一天。能"}]
[{"type": "chat", "time": 7920.017, "timestamp": "02:12:00", "author": "@AsAnOtaku", "avatar": "https://yt4.ggpht.com/ytc/AIdro_ml9qi1LKsmPGIy_j3CcCCPBXWFNxXjZJ9lViNDhl_52A=s64-c-k-c0x00ffffff-no-rj", "message": "Good morning chat, its 00:05 am and I see everyone is so energetic today..."}, {"type": "subtitle", "time": 7920.79, "timestamp": "02:12:00", "text": "你要知道，好吧，你是真心喜欢的。"}, {"type": "chat", "time": 7922.785, "timestamp": "02:12:02", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! As An Otaku~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 7923.51, "timestamp": "02:12:03", "text": "帮助他人就像是增添了另一种意义。"}, {"type": "subtitle", "time": 7926.79, "timestamp": "02:12:06", "text": "一层一层地叠加，就像你知道的，我"}, {"type": "subtitle", "time": 7930.87, "timestamp": "02:12:10", "text": "把你当成你认识的一个人来看，所以"}, {"type": "chat", "time": 7933.524, "timestamp": "02:12:13", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "if I ever have any tech difficulties I hope joq can help me fix"}, {"type": "subtitle", "time": 7934.31, "timestamp": "02:12:14", "text": "这让我觉得……"}, {"type": "subtitle", "time": 7935.91, "timestamp": "02:12:15", "text": "就像我之前说的，这些是"}, {"type": "subtitle", "time": 7937.189, "timestamp": "02:12:17", "text": "我一直很喜欢的问题"}, {"type": "subtitle", "time": 7939.03, "timestamp": "02:12:19", "text": "我问过别人，但一直没抽出时间。"}, {"type": "subtitle", "time": 7940.79, "timestamp": "02:12:20", "text": "我很高兴我这么做了，就像一开始那样。"}, {"type": "subtitle", "time": 7943.51, "timestamp": "02:12:23", "text": "和你在一起，因为你知道，就像你一样"}, {"type": "subtitle", "time": 7945.91, "timestamp": "02:12:25", "text": "你和我一样，一直都在那里。"}, {"type": "subtitle", "time": 7947.91, "timestamp": "02:12:27", "text": "我觉得很多人都没加入。"}, {"type": "subtitle", "time": 7949.91, "timestamp": "02:12:29", "text": "我知道这一点，但我还是要说出来。"}, {"type": "subtitle", "time": 7952.79, "timestamp": "02:12:32", "text": "Nick Senpai 一直陪着我直到最后"}, {"type": "subtitle", "time": 7955.75, "timestamp": "02:12:35", "text": "在我的首秀中结束。我当时吓坏了。"}, {"type": "subtitle", "time": 7958.229, "timestamp": "02:12:38", "text": "我当时都快吓疯了。铁"}, {"type": "subtitle", "time": 7960.79, "timestamp": "02:12:40", "text": "基因诅咒就像是从我认为其中一个开始的"}, {"type": "subtitle", "time": 7962.27, "timestamp": "02:12:42", "text": "那些起源于那里的技术"}, {"type": "subtitle", "time": 7966.709, "timestamp": "02:12:46", "text": "困难。我当时非常紧张。我认为"}, {"type": "chat", "time": 7968.32, "timestamp": "02:12:48", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "ahh yes the debut scuff"}, {"type": "subtitle", "time": 7968.709, "timestamp": "02:12:48", "text": "我不记得了，我觉得你不记得了。"}, {"type": "subtitle", "time": 7971.669, "timestamp": "02:12:51", "text": "没错。"}, {"type": "chat", "time": 7971.734, "timestamp": "02:12:51", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "scuffscape"}, {"type": "subtitle", "time": 7973.91, "timestamp": "02:12:53", "text": "我记得，请你留下来。"}, {"type": "subtitle", "time": 7975.83, "timestamp": "02:12:55", "text": "与我一起。我，我曾经是，这就是"}, {"type": "subtitle", "time": 7977.91, "timestamp": "02:12:57", "text": "事物。我甚至都没跟他说过话。"}, {"type": "subtitle", "time": 7979.51, "timestamp": "02:12:59", "text": "适当地。我们还没有订婚。他只是"}]
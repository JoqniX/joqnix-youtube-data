[{"type": "subtitle", "time": 11943.67, "timestamp": "03:19:03", "text": "我喜欢醋，尤其是在大多数情况下。"}, {"type": "subtitle", "time": 11946.79, "timestamp": "03:19:06", "text": "他们带来的游戏机器人，请输入您的"}, {"type": "subtitle", "time": 11948.78, "timestamp": "03:19:08", "text": "账户名但"}, {"type": "subtitle", "time": 11954.309, "timestamp": "03:19:14", "text": "[音乐]"}, {"type": "subtitle", "time": 11966.87, "timestamp": "03:19:26", "text": "那是2B"}, {"type": "subtitle", "time": 11987.63, "timestamp": "03:19:47", "text": "哦，封面女郎"}, {"type": "subtitle", "time": 11991.99, "timestamp": "03:19:51", "text": "游戏。他们拥抱了两人，这下好了。"}, {"type": "subtitle", "time": 11996.15, "timestamp": "03:19:56", "text": "让我们来看看。接下来是乔。希望它能奏效，兄弟。"}, {"type": "subtitle", "time": 11999.51, "timestamp": "03:19:59", "text": "有用。好了，成功了。二级。如何"}]
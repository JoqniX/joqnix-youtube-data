[{"type": "subtitle", "time": 12300.229, "timestamp": "03:25:00", "text": "由阵亡的战士们。我可以更改我的"}, {"type": "subtitle", "time": 12302.07, "timestamp": "03:25:02", "text": "这里到处都是敌人。哦"}, {"type": "subtitle", "time": 12304.389, "timestamp": "03:25:04", "text": "我的天哪，他们做到了，他们做到了"}, {"type": "subtitle", "time": 12308.349, "timestamp": "03:25:08", "text": "类似维基百科上的名字。哦，我的"}, {"type": "subtitle", "time": 12311.19, "timestamp": "03:25:11", "text": "上帝。但这场比赛的特别之处在于……"}, {"type": "subtitle", "time": 12313.19, "timestamp": "03:25:13", "text": "简直就像格斗游戏一样。你需要"}, {"type": "subtitle", "time": 12317.349, "timestamp": "03:25:17", "text": "就像武术游戏那样。必须"}, {"type": "subtitle", "time": 12323.03, "timestamp": "03:25:23", "text": "遗憾的是，如果您能够使用您的"}, {"type": "subtitle", "time": 12326.99, "timestamp": "03:25:26", "text": "组合，你显然是你的"}, {"type": "subtitle", "time": 12330.87, "timestamp": "03:25:30", "text": "操作。共有 480 帧。哦，对，还有"}, {"type": "subtitle", "time": 12335.269, "timestamp": "03:25:35", "text": "如今甚至有 600 FPS 的显示器。现在我"}, {"type": "subtitle", "time": 12339.07, "timestamp": "03:25:39", "text": "如今我都快忘了它们的存在了。哦，我的"}, {"type": "subtitle", "time": 12347.91, "timestamp": "03:25:47", "text": "改进。 Nvidia DLSS。呃，我想我"}, {"type": "subtitle", "time": 12349.79, "timestamp": "03:25:49", "text": "可以去"}, {"type": "subtitle", "time": 12352.229, "timestamp": "03:25:52", "text": "表现。我的天哪，一切都在里面"}, {"type": "subtitle", "time": 12354.309, "timestamp": "03:25:54", "text": "高的。不，我不想让它太高。"}, {"type": "subtitle", "time": 12357.349, "timestamp": "03:25:57", "text": "中等的。我有一张小型显卡。"}]
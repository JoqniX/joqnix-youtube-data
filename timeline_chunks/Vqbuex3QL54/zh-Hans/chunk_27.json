[{"type": "subtitle", "time": 1650.71, "timestamp": "00:27:30", "text": "我想给那个人一个口交"}, {"type": "subtitle", "time": 1654.95, "timestamp": "00:27:34", "text": "促成了这件事。太棒了。"}, {"type": "subtitle", "time": 1657.63, "timestamp": "00:27:37", "text": "这真是太"}, {"type": "subtitle", "time": 1664.07, "timestamp": "00:27:44", "text": "漂亮的。我想领导这个层级"}, {"type": "subtitle", "time": 1672.149, "timestamp": "00:27:52", "text": "事件。真是个好活动。我的天啊。"}, {"type": "subtitle", "time": 1673.789, "timestamp": "00:27:53", "text": "就好像你是"}, {"type": "subtitle", "time": 1677.11, "timestamp": "00:27:57", "text": "感觉就像带着它去很远的地方旅行一样"}]
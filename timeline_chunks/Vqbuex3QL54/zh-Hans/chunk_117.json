[{"type": "subtitle", "time": 7020.07, "timestamp": "01:57:00", "text": "一切都对吧？对你来说太高了。"}, {"type": "subtitle", "time": 7023.03, "timestamp": "01:57:03", "text": "呼吸困难，感觉快要窒息。"}, {"type": "subtitle", "time": 7025.83, "timestamp": "01:57:05", "text": "这就是我作为 Doc Nex 时的感受。"}, {"type": "subtitle", "time": 7028.79, "timestamp": "01:57:08", "text": "山谷里有一棵树，一切都很美好。"}, {"type": "subtitle", "time": 7030.87, "timestamp": "01:57:10", "text": "这就是我从音乐中感受到的。"}, {"type": "subtitle", "time": 7033.27, "timestamp": "01:57:13", "text": "频道之类的。而我，我仍然"}, {"type": "subtitle", "time": 7036.35, "timestamp": "01:57:16", "text": "我正努力让自己看起来像个运动健将"}, {"type": "subtitle", "time": 7040.31, "timestamp": "01:57:20", "text": "环境，作为我所处的环境"}, {"type": "subtitle", "time": 7043.03, "timestamp": "01:57:23", "text": "可以自由呼吸，而不必"}, {"type": "subtitle", "time": 7046.31, "timestamp": "01:57:26", "text": "为一些事情烦恼。即使我"}, {"type": "subtitle", "time": 7047.91, "timestamp": "01:57:27", "text": "做我自己，我知道我只想做我自己"}, {"type": "subtitle", "time": 7049.99, "timestamp": "01:57:29", "text": "自由的。免费，你知道，那种免费"}, {"type": "subtitle", "time": 7052.55, "timestamp": "01:57:32", "text": "东西。所以，是的，这是心理因素导致的。"}, {"type": "chat", "time": 7053.433, "timestamp": "01:57:33", "author": "@OrangeSan", "avatar": "https://yt4.ggpht.com/1hzJ_11ALUfVaVrkxYo1ZVLPiK-9KSZ_F82omBSnvPLydlaR2DHr5h-PrrBJwHbm0GleoSyYuQ=s64-c-k-c0x00ffffff-no-rj", "message": "ohh"}, {"type": "subtitle", "time": 7055.669, "timestamp": "01:57:35", "text": "我明白你的意思了。"}, {"type": "subtitle", "time": 7058.47, "timestamp": "01:57:38", "text": "那是真的。还有我，我，还有我"}, {"type": "subtitle", "time": 7061.149, "timestamp": "01:57:41", "text": "感觉就像我感觉那样。"}, {"type": "subtitle", "time": 7064.629, "timestamp": "01:57:44", "text": "就像我想说的，如果我冒昧地说的话，我们俩"}, {"type": "subtitle", "time": 7067.35, "timestamp": "01:57:47", "text": "以非常相似的方式看待事物"}, {"type": "subtitle", "time": 7072.51, "timestamp": "01:57:52", "text": "我就是那种感觉。"}, {"type": "subtitle", "time": 7075.629, "timestamp": "01:57:55", "text": "好的。正确的。"}, {"type": "subtitle", "time": 7077.31, "timestamp": "01:57:57", "text": "好的。"}]
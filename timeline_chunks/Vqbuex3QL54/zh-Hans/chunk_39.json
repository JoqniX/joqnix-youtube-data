[{"type": "subtitle", "time": 2341.349, "timestamp": "00:39:01", "text": "是的，游戏计划是有的，但只有我一个人。"}, {"type": "subtitle", "time": 2343.67, "timestamp": "00:39:03", "text": "我没有太多人可以联系。"}, {"type": "subtitle", "time": 2345.71, "timestamp": "00:39:05", "text": "请帮帮我，所以我必须自己完成。"}, {"type": "subtitle", "time": 2349.109, "timestamp": "00:39:09", "text": "有一天，我自己也会变成这样。"}, {"type": "subtitle", "time": 2351.99, "timestamp": "00:39:11", "text": "我的天哪，这太鼓舞人心了"}, {"type": "subtitle", "time": 2355.43, "timestamp": "00:39:15", "text": "太酷了。"}, {"type": "subtitle", "time": 2358.069, "timestamp": "00:39:18", "text": "而且，Fuka也是其中的一员。"}, {"type": "subtitle", "time": 2359.79, "timestamp": "00:39:19", "text": "项目。我就像"}, {"type": "subtitle", "time": 2362.47, "timestamp": "00:39:22", "text": "什么？太酷了。就像这个网站一样"}, {"type": "subtitle", "time": 2364.43, "timestamp": "00:39:24", "text": "本身就是这样"}, {"type": "subtitle", "time": 2367.31, "timestamp": "00:39:27", "text": "凉爽的。是啊，真是太……"}, {"type": "subtitle", "time": 2370.71, "timestamp": "00:39:30", "text": "凉爽的。太酷了。总之，回到正题。"}, {"type": "subtitle", "time": 2373.75, "timestamp": "00:39:33", "text": "根钦。我们需要完成这件事，这样我才能"}, {"type": "subtitle", "time": 2377.75, "timestamp": "00:39:37", "text": "回去继续我那枯燥乏味的鼓掌吧"}, {"type": "subtitle", "time": 2384.15, "timestamp": "00:39:44", "text": "嗯？这是什么？有很多"}, {"type": "subtitle", "time": 2384.92, "timestamp": "00:39:44", "text": "场景"}, {"type": "subtitle", "time": 2387.39, "timestamp": "00:39:47", "text": "[音乐]"}, {"type": "subtitle", "time": 2389.829, "timestamp": "00:39:49", "text": "尽管。演出开始后，"}, {"type": "subtitle", "time": 2393.27, "timestamp": "00:39:53", "text": "演员姓名将以固定速度移动"}, {"type": "subtitle", "time": 2395.19, "timestamp": "00:39:55", "text": "横跨舞台，并将改变"}, {"type": "subtitle", "time": 2397.43, "timestamp": "00:39:57", "text": "与纸张接触时"}]
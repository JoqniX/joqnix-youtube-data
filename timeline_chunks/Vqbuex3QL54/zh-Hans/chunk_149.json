[{"type": "subtitle", "time": 8942.389, "timestamp": "02:29:02", "text": "我感觉……但我还是得……"}, {"type": "subtitle", "time": 8944.23, "timestamp": "02:29:04", "text": "安排很多事情。所以我不得不"}, {"type": "subtitle", "time": 8948.15, "timestamp": "02:29:08", "text": "在推特上写两天的总结。"}, {"type": "subtitle", "time": 8950.67, "timestamp": "02:29:10", "text": "昨天的和今天的。"}, {"type": "subtitle", "time": 8954.87, "timestamp": "02:29:14", "text": "是的。我提供这个信息有点晚了。"}, {"type": "subtitle", "time": 8972.23, "timestamp": "02:29:32", "text": "担忧。我已经把所有人都封禁了。"}, {"type": "subtitle", "time": 8991.389, "timestamp": "02:29:51", "text": "呃"}, {"type": "subtitle", "time": 8995.87, "timestamp": "02:29:55", "text": "我也得把他弄到手。他是我的挚爱"}, {"type": "subtitle", "time": 8998.19, "timestamp": "02:29:58", "text": "朋友。我"}]
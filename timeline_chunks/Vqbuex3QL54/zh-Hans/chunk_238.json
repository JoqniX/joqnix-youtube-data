[{"type": "subtitle", "time": 14282.67, "timestamp": "03:58:02", "text": "去？别告诉我他仍然……"}, {"type": "subtitle", "time": 14285.91, "timestamp": "03:58:05", "text": "向上。你为什么还在附近徘徊？"}, {"type": "subtitle", "time": 14290.469, "timestamp": "03:58:10", "text": "屋顶？你个笨蛋。我的天哪，我得到了"}, {"type": "subtitle", "time": 14298.95, "timestamp": "03:58:18", "text": "矛。好的，发生了一段过场动画。"}, {"type": "subtitle", "time": 14316.349, "timestamp": "03:58:36", "text": "这看起来像"}, {"type": "subtitle", "time": 14322.03, "timestamp": "03:58:42", "text": "呃，原神之剑里的水男孩"}, {"type": "subtitle", "time": 14325.11, "timestamp": "03:58:45", "text": "书。我忘了"}, {"type": "subtitle", "time": 14333.229, "timestamp": "03:58:53", "text": "是的，荣耀是"}, {"type": "subtitle", "time": 14335.59, "timestamp": "03:58:55", "text": "你的。好了，我们就讲完了。"}]
[{"type": "subtitle", "time": 3.27, "timestamp": "00:00:03", "text": "在 Twitch 上。呃，6个小时。是的，没问题。"}, {"type": "subtitle", "time": 11.95, "timestamp": "00:00:11", "text": "溪流。好的。呃，我们是吗？"}, {"type": "subtitle", "time": 14.23, "timestamp": "00:00:14", "text": "居住？我需要拿到链接，"}, {"type": "subtitle", "time": 15.87, "timestamp": "00:00:15", "text": "一切"}, {"type": "subtitle", "time": 18.109, "timestamp": "00:00:18", "text": "正确的。你好"}, {"type": "subtitle", "time": 22.15, "timestamp": "00:00:22", "text": "每个人。欢迎来到第83天。哦，"}, {"type": "subtitle", "time": 24.87, "timestamp": "00:00:24", "text": "等待。为什么标题中是 83 或 82？"}, {"type": "subtitle", "time": 28.47, "timestamp": "00:00:28", "text": "让我再三修正一下。对不起。"}, {"type": "subtitle", "time": 32.59, "timestamp": "00:00:32", "text": "欢迎来到第 83 天"}, {"type": "subtitle", "time": 35.31, "timestamp": "00:00:35", "text": "巧克力马拉松夜间直播第二部分。"}, {"type": "subtitle", "time": 38.47, "timestamp": "00:00:38", "text": "是的。所以今天我们将学习禅宗。"}, {"type": "subtitle", "time": 41.43, "timestamp": "00:00:41", "text": "来自 Project Starscape 的 Kasmmet。他会是"}, {"type": "subtitle", "time": 44.95, "timestamp": "00:00:44", "text": "今天他与我们合作。我必须"}, {"type": "subtitle", "time": 47.43, "timestamp": "00:00:47", "text": "用 Zen 做个音频检查之类的。我"}, {"type": "subtitle", "time": 49.67, "timestamp": "00:00:49", "text": "还没那么做，因为我们还有另一个孩子。"}, {"type": "subtitle", "time": 52.79, "timestamp": "00:00:52", "text": "我们之前曾与Proa Son合作过"}, {"type": "subtitle", "time": 55.51, "timestamp": "00:00:55", "text": "我们当时在玩《Repo》，然后我们就清空了游戏。"}, {"type": "subtitle", "time": 58.83, "timestamp": "00:00:58", "text": "在瓦莱兰特冷静下来。"}]
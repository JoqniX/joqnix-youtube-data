[{"type": "subtitle", "time": 4621.11, "timestamp": "01:17:01", "text": "首先是，其次，它实际上"}, {"type": "subtitle", "time": 4624.95, "timestamp": "01:17:04", "text": "这表明你做事会深思熟虑。"}, {"type": "subtitle", "time": 4627.43, "timestamp": "01:17:07", "text": "你知道，就像背面和正面一样。"}, {"type": "subtitle", "time": 4629.03, "timestamp": "01:17:09", "text": "里面的一切，就像你知道的，你拿走"}, {"type": "subtitle", "time": 4631.11, "timestamp": "01:17:11", "text": "考虑到所有因素，你并不"}, {"type": "subtitle", "time": 4632.79, "timestamp": "01:17:12", "text": "把事情视为理所当然，这就像"}, {"type": "subtitle", "time": 4635.99, "timestamp": "01:17:15", "text": "非常罕见，你知道吗？如果我没说错的话。"}, {"type": "subtitle", "time": 4638.149, "timestamp": "01:17:18", "text": "在这个时代，你知道的，"}, {"type": "subtitle", "time": 4639.75, "timestamp": "01:17:19", "text": "一切都被视为理所当然。"}, {"type": "subtitle", "time": 4642.31, "timestamp": "01:17:22", "text": "而你不知道，就像你知道我是谁一样。"}, {"type": "chat", "time": 4643.09, "timestamp": "01:17:23", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "yes exactly"}, {"type": "subtitle", "time": 4643.99, "timestamp": "01:17:23", "text": "很高兴你能喜欢。"}, {"type": "subtitle", "time": 4646.07, "timestamp": "01:17:26", "text": "冲破黑暗，就这样"}, {"type": "subtitle", "time": 4647.51, "timestamp": "01:17:27", "text": "听到这个消息，我感到很惊讶。"}, {"type": "subtitle", "time": 4649.27, "timestamp": "01:17:29", "text": "因为我一直很喜欢这样想"}, {"type": "chat", "time": 4650.748, "timestamp": "01:17:30", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "yes"}, {"type": "subtitle", "time": 4651.189, "timestamp": "01:17:31", "text": "你就像这样，非常明亮，你知道吗？"}, {"type": "subtitle", "time": 4654.229, "timestamp": "01:17:34", "text": "闪闪发光的人，所以它就像"}, {"type": "subtitle", "time": 4656.79, "timestamp": "01:17:36", "text": "了解那闪亮外表下的真相，"}, {"type": "subtitle", "time": 4658.39, "timestamp": "01:17:38", "text": "你知道，幕后那个人真的"}, {"type": "subtitle", "time": 4660.87, "timestamp": "01:17:40", "text": "明亮永远在你身边，就像神奇一样"}, {"type": "subtitle", "time": 4663.03, "timestamp": "01:17:43", "text": "朋友就像有这样这样的人"}, {"type": "subtitle", "time": 4665.51, "timestamp": "01:17:45", "text": "你经历过的战斗以及"}, {"type": "subtitle", "time": 4668.229, "timestamp": "01:17:48", "text": "你知道，但你又不知道，你可能会"}, {"type": "subtitle", "time": 4669.91, "timestamp": "01:17:49", "text": "我还没跟别人说过这件事，但是你"}, {"type": "subtitle", "time": 4672.07, "timestamp": "01:17:52", "text": "你奋力拼搏，你赢了，我真是太高兴了。"}, {"type": "subtitle", "time": 4674.55, "timestamp": "01:17:54", "text": "很高兴，我真的很高兴你知道我们"}, {"type": "subtitle", "time": 4675.91, "timestamp": "01:17:55", "text": "现在就在这里。我们当时正在做这件事"}, {"type": "subtitle", "time": 4678.47, "timestamp": "01:17:58", "text": "对话以及你知道你"}]
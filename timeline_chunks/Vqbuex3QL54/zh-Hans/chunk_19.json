[{"type": "subtitle", "time": 1182.11, "timestamp": "00:19:42", "text": "等等，我被静音了。等待，"}, {"type": "subtitle", "time": 1186.95, "timestamp": "00:19:46", "text": "什么？我的天啊。我当时说的是，嗯，是的，我"}, {"type": "subtitle", "time": 1190.15, "timestamp": "00:19:50", "text": "我刚才跟你们讲了一个关于我的故事。"}, {"type": "subtitle", "time": 1192.15, "timestamp": "00:19:52", "text": "情怀。我的天哪，这太……"}, {"type": "subtitle", "time": 1195.95, "timestamp": "00:19:55", "text": "现在想想真尴尬。我的天啊。"}, {"type": "subtitle", "time": 1199.27, "timestamp": "00:19:59", "text": "疼痛。我开始叮叮当当地响了一半。"}]
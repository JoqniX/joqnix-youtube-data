[{"type": "subtitle", "time": 14040.87, "timestamp": "03:54:00", "text": "难的。哦，不。哦，不。又来了。不是"}, {"type": "subtitle", "time": 14043.51, "timestamp": "03:54:03", "text": "再次。又来了。又来了。又来了。"}, {"type": "subtitle", "time": 14044.83, "timestamp": "03:54:04", "text": "移动。"}, {"type": "subtitle", "time": 14056.71, "timestamp": "03:54:16", "text": "我算是圈内人吧？好的。我需要一个"}, {"type": "subtitle", "time": 14059.229, "timestamp": "03:54:19", "text": "获得治愈"}, {"type": "subtitle", "time": 14061.07, "timestamp": "03:54:21", "text": "四、我们开始吧"}, {"type": "subtitle", "time": 14078.309, "timestamp": "03:54:38", "text": "东西。我怎么就脱身了？"}, {"type": "subtitle", "time": 14081.189, "timestamp": "03:54:41", "text": "为什么？我的天啊。包已满。"}, {"type": "subtitle", "time": 14098.429, "timestamp": "03:54:58", "text": "去。哦，那是供应品"}]
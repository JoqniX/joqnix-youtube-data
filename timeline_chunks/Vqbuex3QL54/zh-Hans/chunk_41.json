[{"type": "subtitle", "time": 2466.99, "timestamp": "00:41:06", "text": "等等，那是个陷阱，对吧？我的天啊。"}, {"type": "subtitle", "time": 2470.03, "timestamp": "00:41:10", "text": "等等，如果他来了"}, {"type": "subtitle", "time": 2471.55, "timestamp": "00:41:11", "text": "后退。"}, {"type": "subtitle", "time": 2476.72, "timestamp": "00:41:16", "text": "不。我的天哪。等待。在那里"}, {"type": "subtitle", "time": 2478.27, "timestamp": "00:41:18", "text": "[音乐]"}, {"type": "subtitle", "time": 2480.87, "timestamp": "00:41:20", "text": "去。你真的需要好好想想吗？"}, {"type": "subtitle", "time": 2483.23, "timestamp": "00:41:23", "text": "也跳出固有思维模式？"}, {"type": "subtitle", "time": 2486.589, "timestamp": "00:41:26", "text": "哦，真有意思。"}, {"type": "subtitle", "time": 2497.03, "timestamp": "00:41:37", "text": "开始。"}, {"type": "subtitle", "time": 2507.43, "timestamp": "00:41:47", "text": "耶。凉爽的。凉爽的。你哥哥回家了。"}, {"type": "subtitle", "time": 2509.27, "timestamp": "00:41:49", "text": "可以从舞台上层离开。"}, {"type": "subtitle", "time": 2512.87, "timestamp": "00:41:52", "text": "通过缝隙下降到较低水平。但他会摔倒"}, {"type": "subtitle", "time": 2514.309, "timestamp": "00:41:54", "text": "他从下方的缝隙中掉了下去。"}, {"type": "subtitle", "time": 2516.15, "timestamp": "00:41:56", "text": "如果按照他现在的水平，他将会黯然下台。"}, {"type": "subtitle", "time": 2518.87, "timestamp": "00:41:58", "text": "好的。好的。是Gap吧？好的。必须"}]
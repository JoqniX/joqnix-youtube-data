[{"type": "subtitle", "time": 12122.15, "timestamp": "03:22:02", "text": "哦。我的天啊。好多娃娃。我的天啊。"}, {"type": "subtitle", "time": 12126.15, "timestamp": "03:22:06", "text": "我要去。这里有一只尼奥特。我的天啊。哦"}, {"type": "subtitle", "time": 12126.99, "timestamp": "03:22:06", "text": "我的"}, {"type": "subtitle", "time": 12130.07, "timestamp": "03:22:10", "text": "上帝。我想要这个。我应该怎么办？如何"}, {"type": "subtitle", "time": 12132.55, "timestamp": "03:22:12", "text": "我应该付多少钱？我不想付钱"}, {"type": "subtitle", "time": 12134.11, "timestamp": "03:22:14", "text": "不过你呢。"}, {"type": "subtitle", "time": 12137.79, "timestamp": "03:22:17", "text": "但你刚才说的是500，对吧？"}, {"type": "subtitle", "time": 12142.19, "timestamp": "03:22:22", "text": "2美元。等等，2美元可以买240金币。"}, {"type": "subtitle", "time": 12144.15, "timestamp": "03:22:24", "text": "[音乐]"}, {"type": "subtitle", "time": 12147.68, "timestamp": "03:22:27", "text": "想象一下花钱的情景。"}, {"type": "subtitle", "time": 12149.19, "timestamp": "03:22:29", "text": "[音乐]"}, {"type": "subtitle", "time": 12152.389, "timestamp": "03:22:32", "text": "等等，这是换皮版。嘿，哟，什么事？哦，"}, {"type": "subtitle", "time": 12154.07, "timestamp": "03:22:34", "text": "等待。等等，算了。有两个"}, {"type": "subtitle", "time": 12156.95, "timestamp": "03:22:36", "text": "版本。黑白的。哦，你可以"}, {"type": "subtitle", "time": 12158.51, "timestamp": "03:22:38", "text": "拿到这个。哦，"}, {"type": "subtitle", "time": 12161.429, "timestamp": "03:22:41", "text": "等待。螺旋式技能。什么是螺旋？"}, {"type": "subtitle", "time": 12163.03, "timestamp": "03:22:43", "text": "皮肤？"}, {"type": "subtitle", "time": 12165.03, "timestamp": "03:22:45", "text": "哦，我可以要黑色的那款吗？应该"}, {"type": "subtitle", "time": 12166.83, "timestamp": "03:22:46", "text": "我这样做是为了得到黑色"}, {"type": "subtitle", "time": 12177.67, "timestamp": "03:22:57", "text": "钱。那么，让我们开始吧"}]
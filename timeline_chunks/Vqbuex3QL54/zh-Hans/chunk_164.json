[{"type": "subtitle", "time": 9841.429, "timestamp": "02:44:01", "text": "我真希望我能和你一起玩那个游戏"}, {"type": "subtitle", "time": 9843.59, "timestamp": "02:44:03", "text": "某人。凯西想玩这个游戏"}, {"type": "subtitle", "time": 9845.349, "timestamp": "02:44:05", "text": "和我一起。我不介意"}, {"type": "subtitle", "time": 9848.389, "timestamp": "02:44:08", "text": "和他们一起玩就像玩虚构故事一样。"}, {"type": "subtitle", "time": 9854.309, "timestamp": "02:44:14", "text": "再次，我觉得这样更好。"}, {"type": "subtitle", "time": 9856.71, "timestamp": "02:44:16", "text": "如果我要做任何CD演出，比如"}, {"type": "subtitle", "time": 9859.91, "timestamp": "02:44:19", "text": "正常的合作等等"}, {"type": "subtitle", "time": 9862.23, "timestamp": "02:44:22", "text": "呃，这需要多个部分，"}, {"type": "subtitle", "time": 9863.67, "timestamp": "02:44:23", "text": "一切。我觉得这非常"}, {"type": "subtitle", "time": 9865.91, "timestamp": "02:44:25", "text": "更好的。我是从日本做的，而不是……"}, {"type": "subtitle", "time": 9887.87, "timestamp": "02:44:47", "text": "是的。是的，我真的很高兴"}, {"type": "subtitle", "time": 9896.03, "timestamp": "02:44:56", "text": "它们还在那里。"}]
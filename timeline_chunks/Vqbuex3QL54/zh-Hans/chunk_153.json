[{"type": "subtitle", "time": 9180.55, "timestamp": "02:33:00", "text": "东西。我还在考虑这件事。我"}, {"type": "subtitle", "time": 9191.71, "timestamp": "02:33:11", "text": "伙计，我觉得明天我可能会……"}, {"type": "subtitle", "time": 9200.63, "timestamp": "02:33:20", "text": "夜晚。是的，熬夜，熬到很晚。"}, {"type": "subtitle", "time": 9203.15, "timestamp": "02:33:23", "text": "夜里只是为了做午夜的事"}, {"type": "subtitle", "time": 9206.23, "timestamp": "02:33:26", "text": "合作。哦，不。是的，我确实很想念"}, {"type": "subtitle", "time": 9209.27, "timestamp": "02:33:29", "text": "午夜和清晨各两次。二"}, {"type": "subtitle", "time": 9211.83, "timestamp": "02:33:31", "text": "那两个人的日子已经一去不复返了。"}, {"type": "subtitle", "time": 9215.03, "timestamp": "02:33:35", "text": "人们。我去过两次了"}, {"type": "subtitle", "time": 9217.349, "timestamp": "02:33:37", "text": "错过了或者日程安排问题之类的。"}, {"type": "subtitle", "time": 9219.59, "timestamp": "02:33:39", "text": "所以我还是想把它们弄进去。"}, {"type": "subtitle", "time": 9221.99, "timestamp": "02:33:41", "text": "东西。还有几个人，我"}, {"type": "subtitle", "time": 9224.99, "timestamp": "02:33:44", "text": "想重新加入他们。所以"}, {"type": "subtitle", "time": 9228.15, "timestamp": "02:33:48", "text": "虽然有点疼，但今天乔丹玩得很开心。"}, {"type": "subtitle", "time": 9231.03, "timestamp": "02:33:51", "text": "抱歉，我真的躲在桌子底下。"}, {"type": "subtitle", "time": 9237.95, "timestamp": "02:33:57", "text": "[音乐]"}]
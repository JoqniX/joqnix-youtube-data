[{"type": "subtitle", "time": 7261.229, "timestamp": "02:01:01", "text": "想再来一次，但是太可惜了。"}, {"type": "subtitle", "time": 7263.589, "timestamp": "02:01:03", "text": "令人尴尬。然后就像我一样，然后"}, {"type": "subtitle", "time": 7266.47, "timestamp": "02:01:06", "text": "我当时就想，“好吧。”我重新接听电话"}, {"type": "chat", "time": 7266.847, "timestamp": "02:01:06", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "HAHAHA LMAOOO"}, {"type": "subtitle", "time": 7268.99, "timestamp": "02:01:08", "text": "我和我的朋友去了，"}, {"type": "subtitle", "time": 7273.27, "timestamp": "02:01:13", "text": "顺便说一句，就像我听到的一样……"}, {"type": "subtitle", "time": 7276.31, "timestamp": "02:01:16", "text": "“那件事。”这感觉非常尴尬。"}, {"type": "subtitle", "time": 7278.55, "timestamp": "02:01:18", "text": "就像……就像那种东西一样"}, {"type": "subtitle", "time": 7280.229, "timestamp": "02:01:20", "text": "你希望没人听到的那些话。你知道，"}, {"type": "subtitle", "time": 7282.229, "timestamp": "02:01:22", "text": "Nick senpai，就像你像……的时候"}, {"type": "subtitle", "time": 7283.43, "timestamp": "02:01:23", "text": "你就像当你……"}, {"type": "chat", "time": 7283.742, "timestamp": "02:01:23", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "!add 432h"}, {"type": "subtitle", "time": 7284.79, "timestamp": "02:01:24", "text": "你知道，就是自言自语的时候。"}, {"type": "subtitle", "time": 7287.109, "timestamp": "02:01:27", "text": "有独白之类的，还有一些"}, {"type": "chat", "time": 7289.398, "timestamp": "02:01:29", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "WTF HAHAHA"}, {"type": "subtitle", "time": 7290.149, "timestamp": "02:01:30", "text": "有人会说：“哦，是啊，就像我我我"}, {"type": "subtitle", "time": 7291.35, "timestamp": "02:01:31", "text": "听说了。“那感觉就像……”"}, {"type": "subtitle", "time": 7292.55, "timestamp": "02:01:32", "text": "令人尴尬。就像有人在读"}, {"type": "chat", "time": 7293.027, "timestamp": "02:01:33", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "!resume "}, {"type": "subtitle", "time": 7294.31, "timestamp": "02:01:34", "text": "你的日记里写道，他们不是"}, {"type": "subtitle", "time": 7295.99, "timestamp": "02:01:35", "text": "他们不应该读书。那样"}, {"type": "subtitle", "time": 7297.91, "timestamp": "02:01:37", "text": "事物。那就像是最近的"}, {"type": "subtitle", "time": 7301.99, "timestamp": "02:01:41", "text": "最新的例子，比如怎么说“嗯”令人尴尬的事"}, {"type": "subtitle", "time": 7303.99, "timestamp": "02:01:43", "text": "发生在我身上的事。否则"}, {"type": "subtitle", "time": 7305.589, "timestamp": "02:01:45", "text": "我觉得自己很丢脸"}, {"type": "subtitle", "time": 7308.55, "timestamp": "02:01:48", "text": "像我这样的人，总的来说，就像我一直保持"}, {"type": "subtitle", "time": 7310.47, "timestamp": "02:01:50", "text": "几乎每件事都让我感到尴尬"}, {"type": "subtitle", "time": 7313.189, "timestamp": "02:01:53", "text": "每种设置。所以它就变成了这样"}]
[{"type": "subtitle", "time": 14761.55, "timestamp": "04:06:01", "text": "听不见或"}, {"type": "subtitle", "time": 14781.189, "timestamp": "04:06:21", "text": "好的。夜幕降临。我的天啊。他看起来"}, {"type": "subtitle", "time": 14784.15, "timestamp": "04:06:24", "text": "就像迪士尼公主一样。这是什么？"}, {"type": "subtitle", "time": 14788.469, "timestamp": "04:06:28", "text": "不，他看起来像……他看起来像……"}, {"type": "subtitle", "time": 14790.429, "timestamp": "04:06:30", "text": "霜"}, {"type": "subtitle", "time": 14796.83, "timestamp": "04:06:36", "text": "哇。"}, {"type": "subtitle", "time": 14802.75, "timestamp": "04:06:42", "text": "这场比赛他表现得像个怪物，这很不错。"}, {"type": "subtitle", "time": 14806.15, "timestamp": "04:06:46", "text": "你好。 90 80。我的天哪。另一个人是"}]
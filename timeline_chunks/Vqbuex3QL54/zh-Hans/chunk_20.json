[{"type": "subtitle", "time": 1205.549, "timestamp": "00:20:05", "text": "[音乐]"}, {"type": "subtitle", "time": 1223.59, "timestamp": "00:20:23", "text": "哇。你想让我喂你吗？"}, {"type": "subtitle", "time": 1225.95, "timestamp": "00:20:25", "text": "某物？你"}, {"type": "subtitle", "time": 1229.909, "timestamp": "00:20:29", "text": "笨蛋。然后我开始讲述一个关于……的故事"}, {"type": "subtitle", "time": 1233.43, "timestamp": "00:20:33", "text": "我以前喂小孩子的那天，"}, {"type": "subtitle", "time": 1236.029, "timestamp": "00:20:36", "text": "小缎子"}, {"type": "subtitle", "time": 1238.35, "timestamp": "00:20:38", "text": "笨蛋。这样一个"}, {"type": "subtitle", "time": 1242.549, "timestamp": "00:20:42", "text": "有趣的事。你知道，我喂的每一勺"}, {"type": "subtitle", "time": 1246.35, "timestamp": "00:20:46", "text": "那个小笨蛋，我给了他一个"}, {"type": "subtitle", "time": 1250.09, "timestamp": "00:20:50", "text": "头槌。再见，卡哇伊。"}]
[{"type": "subtitle", "time": 9001.19, "timestamp": "02:30:01", "text": "宝凯石。谁还记得海石？"}, {"type": "subtitle", "time": 9003.91, "timestamp": "02:30:03", "text": "不知道你们是否还记得凯什"}, {"type": "subtitle", "time": 9006.59, "timestamp": "02:30:06", "text": "我们玩了它需要"}, {"type": "subtitle", "time": 9008.57, "timestamp": "02:30:08", "text": "我必须把他弄到手。"}, {"type": "subtitle", "time": 9010.99, "timestamp": "02:30:10", "text": "[音乐]"}, {"type": "chat", "time": 9013.059, "timestamp": "02:30:13", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "kaishi light?"}, {"type": "subtitle", "time": 9022.429, "timestamp": "02:30:22", "text": "好的，所以明天是的，ki ki k light"}, {"type": "subtitle", "time": 9024.75, "timestamp": "02:30:24", "text": "叶潘"}, {"type": "subtitle", "time": 9026.75, "timestamp": "02:30:26", "text": "妈妈"}, {"type": "subtitle", "time": 9030.15, "timestamp": "02:30:30", "text": "kanio ka，不管我给他起的昵称是什么"}, {"type": "subtitle", "time": 9041.75, "timestamp": "02:30:41", "text": "疯狂的。兄弟，我以前就是那个"}, {"type": "subtitle", "time": 9046.71, "timestamp": "02:30:46", "text": "给每个人都起昵称。"}, {"type": "subtitle", "time": 9049.51, "timestamp": "02:30:49", "text": "爱、崇拜、关心。甚至"}, {"type": "subtitle", "time": 9051.51, "timestamp": "02:30:51", "text": "也包括素不相识的陌生人。我以前也这么做过。"}, {"type": "subtitle", "time": 9053.91, "timestamp": "02:30:53", "text": "总有一天会的，对吧？我的观点是"}, {"type": "subtitle", "time": 9057.23, "timestamp": "02:30:57", "text": "我觉得我开始了"}]
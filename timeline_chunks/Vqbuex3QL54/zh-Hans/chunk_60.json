[{"type": "chat", "time": 3600.507, "timestamp": "01:00:00", "author": "@akamurajaizen", "avatar": "https://yt4.ggpht.com/4TIH-D08DE7pk6l85RWWuj6VwP3lUitGX1m3JfDywIpryobVVVZSQqcm_MKVDuuN5keV4e0PSgU=s64-c-k-c0x00ffffff-no-rj", "message": "T-T"}, {"type": "subtitle", "time": 3600.63, "timestamp": "01:00:00", "text": "别人的笑声是因为你从不，你从不"}, {"type": "subtitle", "time": 3602.309, "timestamp": "01:00:02", "text": "知道这个笑话是否能逗乐观众。"}, {"type": "subtitle", "time": 3604.789, "timestamp": "01:00:04", "text": "所以你干脆笑出来，这样你"}, {"type": "subtitle", "time": 3606.39, "timestamp": "01:00:06", "text": "至少有人嘲笑过你"}, {"type": "subtitle", "time": 3607.51, "timestamp": "01:00:07", "text": "开玩笑。你不能说：“哦，没有人。”"}, {"type": "subtitle", "time": 3609.109, "timestamp": "01:00:09", "text": "嘲笑我的笑话。” 因为不，你"}, {"type": "subtitle", "time": 3614.95, "timestamp": "01:00:14", "text": "啊。"}, {"type": "subtitle", "time": 3625.349, "timestamp": "01:00:25", "text": "好的。是的，是的。是的。好的。让我"}, {"type": "subtitle", "time": 3627.03, "timestamp": "01:00:27", "text": "我只是问你一些问题。是的。让我"}, {"type": "subtitle", "time": 3629.19, "timestamp": "01:00:29", "text": "我只是问你一些问题。就像这样"}, {"type": "subtitle", "time": 3630.47, "timestamp": "01:00:30", "text": "你的直播，但我还是要问你"}, {"type": "subtitle", "time": 3631.829, "timestamp": "01:00:31", "text": "问题。是的。是的。请随意。"}, {"type": "subtitle", "time": 3634.549, "timestamp": "01:00:34", "text": "一切都好。我们只是"}, {"type": "subtitle", "time": 3636.309, "timestamp": "01:00:36", "text": "如果你可以的话，请邀请任何人。"}, {"type": "subtitle", "time": 3637.75, "timestamp": "01:00:37", "text": "这也可以在聊天中讨论。全部"}, {"type": "subtitle", "time": 3639.349, "timestamp": "01:00:39", "text": "正确的。聊天室里的任何人。好的。如果"}, {"type": "subtitle", "time": 3641.349, "timestamp": "01:00:41", "text": "你的回答很好，你知道吗？它是"}, {"type": "subtitle", "time": 3643.109, "timestamp": "01:00:43", "text": "你人真好。不过，总之，"}, {"type": "subtitle", "time": 3644.87, "timestamp": "01:00:44", "text": "就像一个问题在聊天中开放一样"}, {"type": "subtitle", "time": 3647.27, "timestamp": "01:00:47", "text": "出色地。如果你可以邀请任何人"}, {"type": "subtitle", "time": 3649.349, "timestamp": "01:00:49", "text": "晚餐，你知道，就像任何人一样"}, {"type": "subtitle", "time": 3651.829, "timestamp": "01:00:51", "text": "世界，死亡，活着，虚构，谁会"}]
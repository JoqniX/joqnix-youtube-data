[{"type": "subtitle", "time": 14238.79, "timestamp": "03:57:18", "text": "垂死。我的手机怎么了？"}, {"type": "subtitle", "time": 14241.429, "timestamp": "03:57:21", "text": "键盘？还是说问题出在游戏上？没有"}, {"type": "subtitle", "time": 14252.389, "timestamp": "03:57:32", "text": "最近。好的，这五块面包。让我"}, {"type": "subtitle", "time": 14256.03, "timestamp": "03:57:36", "text": "让我治愈你"}, {"type": "subtitle", "time": 14259.07, "timestamp": "03:57:39", "text": "笨蛋。让我疗伤。"}, {"type": "subtitle", "time": 14261.59, "timestamp": "03:57:41", "text": "平静地。我会来参加你的活动。"}, {"type": "subtitle", "time": 14263.87, "timestamp": "03:57:43", "text": "少量。等等，再等等"}, {"type": "subtitle", "time": 14266.59, "timestamp": "03:57:46", "text": "少量。让我疗伤。好吧，他离开了。"}, {"type": "subtitle", "time": 14269.55, "timestamp": "03:57:49", "text": "某物。好了，他走了。让我"}, {"type": "subtitle", "time": 14273.389, "timestamp": "03:57:53", "text": "愈合。是我吗？哈哈。"}, {"type": "subtitle", "time": 14279.95, "timestamp": "03:57:59", "text": "去？那混蛋在哪儿？"}]
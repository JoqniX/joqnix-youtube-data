[{"type": "subtitle", "time": 5101.51, "timestamp": "01:25:01", "text": "那将意义非凡"}, {"type": "chat", "time": 5101.82, "timestamp": "01:25:01", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "its your opinion 👍"}, {"type": "subtitle", "time": 5104.47, "timestamp": "01:25:04", "text": "我。是的。即使……我不会"}, {"type": "subtitle", "time": 5106.39, "timestamp": "01:25:06", "text": "我介意放弃我的超能力吗？"}, {"type": "subtitle", "time": 5109.99, "timestamp": "01:25:09", "text": "收到或任何东西。是的。我只想"}, {"type": "subtitle", "time": 5113.189, "timestamp": "01:25:13", "text": "能和我在乎的人在一起，"}, {"type": "subtitle", "time": 5115.03, "timestamp": "01:25:15", "text": "多花时间陪伴他们，等等等等"}, {"type": "subtitle", "time": 5117.99, "timestamp": "01:25:17", "text": "与其知道即使……也要快乐。"}, {"type": "chat", "time": 5120.728, "timestamp": "01:25:20", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "👏👏👏"}, {"type": "subtitle", "time": 5121.11, "timestamp": "01:25:21", "text": "我好像拥有了超人般的力量之类的。"}, {"type": "subtitle", "time": 5125.75, "timestamp": "01:25:25", "text": "而不是像去那个更高的地方。"}, {"type": "subtitle", "time": 5129.27, "timestamp": "01:25:29", "text": "社会阶层或类似阶层或"}, {"type": "subtitle", "time": 5131.189, "timestamp": "01:25:31", "text": "比如富有之类的，或者类似的东西"}, {"type": "subtitle", "time": 5133.27, "timestamp": "01:25:33", "text": "做了很多事，也造成了破坏。"}, {"type": "subtitle", "time": 5134.87, "timestamp": "01:25:34", "text": "我不想要的只是这个，我只想……"}, {"type": "subtitle", "time": 5137.149, "timestamp": "01:25:37", "text": "比如保护我关心的人"}, {"type": "subtitle", "time": 5140.149, "timestamp": "01:25:40", "text": "主要来自电影和我们看到的东西"}, {"type": "subtitle", "time": 5143.11, "timestamp": "01:25:43", "text": "没错，这对超级英雄来说会很困难。"}, {"type": "subtitle", "time": 5145.27, "timestamp": "01:25:45", "text": "像英雄一样保护他们的亲人"}, {"type": "subtitle", "time": 5148.31, "timestamp": "01:25:48", "text": "最终他们甚至会成为专业人士。"}, {"type": "subtitle", "time": 5151.669, "timestamp": "01:25:51", "text": "这会让他们身处险境，所以我会这么说。"}, {"type": "subtitle", "time": 5155.83, "timestamp": "01:25:55", "text": "是的，如果这意味着我要放弃的话。"}, {"type": "subtitle", "time": 5158.47, "timestamp": "01:25:58", "text": "我为人们的幸福而努力"}]
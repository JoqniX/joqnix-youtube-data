[{"type": "subtitle", "time": 5942.31, "timestamp": "01:39:02", "text": "因为我可以赚到那8000小时"}, {"type": "subtitle", "time": 5944.55, "timestamp": "01:39:04", "text": "卢比不知怎么又回来了，或者别的什么，但我"}, {"type": "subtitle", "time": 5946.629, "timestamp": "01:39:06", "text": "我永远也找不回那六个小时的生命了"}, {"type": "subtitle", "time": 5949.91, "timestamp": "01:39:09", "text": "后退。对我来说，时间非常重要。"}, {"type": "subtitle", "time": 5952.07, "timestamp": "01:39:12", "text": "我觉得你知道我们可以绕道而行"}, {"type": "subtitle", "time": 5955.91, "timestamp": "01:39:15", "text": "你知道，在你周围，呃，你知道"}, {"type": "subtitle", "time": 5957.83, "timestamp": "01:39:17", "text": "肤浅之类的，但我"}, {"type": "subtitle", "time": 5959.669, "timestamp": "01:39:19", "text": "想想如果我和你一起度过时光会是什么样子"}, {"type": "subtitle", "time": 5961.35, "timestamp": "01:39:21", "text": "我想去……我想去"}, {"type": "subtitle", "time": 5963.83, "timestamp": "01:39:23", "text": "我知道你喜欢看看自己的灵魂是什么。我"}, {"type": "subtitle", "time": 5965.35, "timestamp": "01:39:25", "text": "不知道为什么尼克松会这样做，但这确实令人费解。"}, {"type": "subtitle", "time": 5968.55, "timestamp": "01:39:28", "text": "很有播客的感觉，不是吗？是的，我"}, {"type": "subtitle", "time": 5972.55, "timestamp": "01:39:32", "text": "像这样。我一直都想做这件事。"}, {"type": "subtitle", "time": 5975.27, "timestamp": "01:39:35", "text": "这简直就是个播客。"}, {"type": "chat", "time": 5976.168, "timestamp": "01:39:36", "author": "@OrangeSan", "avatar": "https://yt4.ggpht.com/1hzJ_11ALUfVaVrkxYo1ZVLPiK-9KSZ_F82omBSnvPLydlaR2DHr5h-PrrBJwHbm0GleoSyYuQ=s64-c-k-c0x00ffffff-no-rj", "message": "To me memories are more important"}, {"type": "subtitle", "time": 5978.95, "timestamp": "01:39:38", "text": "我曾担任过播客的联合主持人"}, {"type": "chat", "time": 5979.689, "timestamp": "01:39:39", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Orange~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 5982.149, "timestamp": "01:39:42", "text": "之前，但是，而且，我觉得感觉像是"}, {"type": "subtitle", "time": 5984.31, "timestamp": "01:39:44", "text": "我需要改进等等。我从未"}, {"type": "chat", "time": 5986.326, "timestamp": "01:39:46", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "sup Orange"}, {"type": "subtitle", "time": 5987.109, "timestamp": "01:39:47", "text": "知道那会是什么感觉"}, {"type": "subtitle", "time": 5990.629, "timestamp": "01:39:50", "text": "以客人的身份来到这里。它真好"}, {"type": "subtitle", "time": 5993.109, "timestamp": "01:39:53", "text": "你知道，那种真切的感觉"}, {"type": "subtitle", "time": 5996.39, "timestamp": "01:39:56", "text": "像这样的对话。是的，我喜欢"}, {"type": "subtitle", "time": 5998.79, "timestamp": "01:39:58", "text": "这。很有趣。"}]
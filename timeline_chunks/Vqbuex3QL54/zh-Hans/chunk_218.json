[{"type": "subtitle", "time": 13080.07, "timestamp": "03:38:00", "text": "在此之前，我们会见面的。"}, {"type": "subtitle", "time": 13096.349, "timestamp": "03:38:16", "text": "身体。哦，她是"}, {"type": "subtitle", "time": 13100.07, "timestamp": "03:38:20", "text": "比如去另一个地方"}, {"type": "subtitle", "time": 13101.229, "timestamp": "03:38:21", "text": "某物。"}, {"type": "subtitle", "time": 13104.63, "timestamp": "03:38:24", "text": "H：我喜欢龙。即使在瓦莱兰，"}, {"type": "subtitle", "time": 13107.349, "timestamp": "03:38:27", "text": "它们就像一条黑暗巨龙和一个"}, {"type": "subtitle", "time": 13109.469, "timestamp": "03:38:29", "text": "光龙"}, {"type": "subtitle", "time": 13112.75, "timestamp": "03:38:32", "text": "东西。好的，以上是基本内容。"}, {"type": "subtitle", "time": 13116.15, "timestamp": "03:38:36", "text": "教程。我们来做进阶教程。"}, {"type": "subtitle", "time": 13118.229, "timestamp": "03:38:38", "text": "高级教程包含哪些内容？"}, {"type": "subtitle", "time": 13121.19, "timestamp": "03:38:41", "text": "提供？ Lexi，这是大逃杀。出色地"}, {"type": "subtitle", "time": 13122.55, "timestamp": "03:38:42", "text": "进入大逃杀模式。我只是"}, {"type": "subtitle", "time": 13130.469, "timestamp": "03:38:50", "text": "基础知识。这是什么？一只手臂在里面"}, {"type": "subtitle", "time": 13138.95, "timestamp": "03:38:58", "text": "哇。选择完毕，就没有人了。"}]
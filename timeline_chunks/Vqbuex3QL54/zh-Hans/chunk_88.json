[{"type": "subtitle", "time": 5280.31, "timestamp": "01:28:00", "text": "这样问我。所以，你就是……"}, {"type": "subtitle", "time": 5283.11, "timestamp": "01:28:03", "text": "第一个喜欢这种类型的人"}, {"type": "subtitle", "time": 5287.11, "timestamp": "01:28:07", "text": "我有点儿……谢谢。"}, {"type": "subtitle", "time": 5289.27, "timestamp": "01:28:09", "text": "我认为你不必接受。它是"}, {"type": "subtitle", "time": 5298.79, "timestamp": "01:28:18", "text": "好的。好的。很有意思，你"}, {"type": "subtitle", "time": 5300.47, "timestamp": "01:28:20", "text": "就像你知道的，我们说过这个和下一个"}, {"type": "subtitle", "time": 5303.43, "timestamp": "01:28:23", "text": "问题是，你最看重的是什么？"}, {"type": "subtitle", "time": 5306.07, "timestamp": "01:28:26", "text": "友谊？"}, {"type": "subtitle", "time": 5310.03, "timestamp": "01:28:30", "text": "哦，问得好。嗯，我会"}, {"type": "subtitle", "time": 5314.87, "timestamp": "01:28:34", "text": "说真真真真我"}, {"type": "subtitle", "time": 5322.07, "timestamp": "01:28:42", "text": "真诚就是真实。好的"}, {"type": "subtitle", "time": 5324.709, "timestamp": "01:28:44", "text": "真的。是的，要真诚。"}, {"type": "subtitle", "time": 5328.629, "timestamp": "01:28:48", "text": "真实可靠，一切都好。"}, {"type": "subtitle", "time": 5331.35, "timestamp": "01:28:51", "text": "意识到“友谊”这个词的含义"}, {"type": "subtitle", "time": 5335.35, "timestamp": "01:28:55", "text": "这些年发生了变化。呃，我的意思是，在"}, {"type": "subtitle", "time": 5337.189, "timestamp": "01:28:57", "text": "在我进入流媒体行业之前就开始了。"}, {"type": "subtitle", "time": 5338.95, "timestamp": "01:28:58", "text": "还有这个网络玩意儿什么的"}]
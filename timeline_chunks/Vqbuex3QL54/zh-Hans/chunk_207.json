[{"type": "subtitle", "time": 12423.71, "timestamp": "03:27:03", "text": "游戏。拉开标签即可打开袋子。物品"}, {"type": "subtitle", "time": 12426.469, "timestamp": "03:27:06", "text": "扩张。物品扩充。好的，那是什么？"}, {"type": "subtitle", "time": 12430.63, "timestamp": "03:27:10", "text": "这？还有继续的空间。 Soulj 包"}, {"type": "subtitle", "time": 12432.71, "timestamp": "03:27:12", "text": "保留士兵。所以，上层可以是"}, {"type": "subtitle", "time": 12434.389, "timestamp": "03:27:14", "text": "捡起士兵包后有所增加"}, {"type": "subtitle", "time": 12436.87, "timestamp": "03:27:16", "text": "爆炸可以获得一个额外的槽位。"}, {"type": "subtitle", "time": 12439.269, "timestamp": "03:27:19", "text": "武器袋用于存放武器。"}, {"type": "subtitle", "time": 12440.87, "timestamp": "03:27:20", "text": "拾取物品可以增加上限。"}, {"type": "subtitle", "time": 12443.19, "timestamp": "03:27:23", "text": "武器袋。探索扩展包以获取"}, {"type": "subtitle", "time": 12453.03, "timestamp": "03:27:33", "text": "一把剑。希望它足够锋利。"}, {"type": "subtitle", "time": 12455.67, "timestamp": "03:27:35", "text": "你还记得怎么打架吗？是的，"}, {"type": "subtitle", "time": 12460.309, "timestamp": "03:27:40", "text": "我愿意。在那门语言之前，我该如何……"}, {"type": "subtitle", "time": 12462.429, "timestamp": "03:27:42", "text": "改变我的声音？"}, {"type": "subtitle", "time": 12464.95, "timestamp": "03:27:44", "text": "语言。你难道不能改变你的声音吗？"}, {"type": "subtitle", "time": 12475.11, "timestamp": "03:27:55", "text": "嗓音。等等，只有两种语言。你好。等待，"}, {"type": "subtitle", "time": 12477.67, "timestamp": "03:27:57", "text": "不，没事了。这是什么？等待，"}]
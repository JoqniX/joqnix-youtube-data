[{"type": "subtitle", "time": 6782.39, "timestamp": "01:53:02", "text": "我没那么厉害，但不知怎么的"}, {"type": "subtitle", "time": 6785.629, "timestamp": "01:53:05", "text": "翻译成某种东西，嗯，你"}, {"type": "subtitle", "time": 6788.629, "timestamp": "01:53:08", "text": "我知道该怎么说呢？"}, {"type": "subtitle", "time": 6791.35, "timestamp": "01:53:11", "text": "那就像我的一件艺术作品一样。"}, {"type": "subtitle", "time": 6793.35, "timestamp": "01:53:13", "text": "任何人都无法触碰，任何人都无法"}, {"type": "subtitle", "time": 6795.109, "timestamp": "01:53:15", "text": "看。感觉它天生就属于我。"}, {"type": "chat", "time": 6795.775, "timestamp": "01:53:15", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "ernest hemingway?"}, {"type": "subtitle", "time": 6797.109, "timestamp": "01:53:17", "text": "因为它就在我的脑海里，你"}, {"type": "subtitle", "time": 6800.149, "timestamp": "01:53:20", "text": "知道，就是那种方式。"}, {"type": "subtitle", "time": 6803.51, "timestamp": "01:53:23", "text": "我能理解，因为当我制作的时候"}, {"type": "subtitle", "time": 6807.27, "timestamp": "01:53:27", "text": "我的音乐频道之类的，嗯……"}, {"type": "subtitle", "time": 6810.55, "timestamp": "01:53:30", "text": "远离尘嚣，就像去一个没人知道我存在的地方一样"}, {"type": "subtitle", "time": 6814.07, "timestamp": "01:53:34", "text": "Jockn 之类的东西，就像这样"}, {"type": "subtitle", "time": 6816.55, "timestamp": "01:53:36", "text": "全新的受众群体等等。它"}, {"type": "subtitle", "time": 6820.95, "timestamp": "01:53:40", "text": "感觉自己现在做得好多了。"}, {"type": "subtitle", "time": 6823.83, "timestamp": "01:53:43", "text": "嗯嗯，就像我喜欢的东西一样"}, {"type": "subtitle", "time": 6826.79, "timestamp": "01:53:46", "text": "我无法像Jockn那样做到，但我能够做到"}, {"type": "subtitle", "time": 6829.51, "timestamp": "01:53:49", "text": "这样好多了，好好推销自己。"}, {"type": "subtitle", "time": 6831.109, "timestamp": "01:53:51", "text": "还有所有方面，要更加积极主动。"}, {"type": "subtitle", "time": 6833.99, "timestamp": "01:53:53", "text": "那个账号上的推特使用频率比Jock高。"}, {"type": "chat", "time": 6835.865, "timestamp": "01:53:55", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "broskie's wife lost the suitcase on a train to paris"}, {"type": "subtitle", "time": 6837.43, "timestamp": "01:53:57", "text": "然后我就想，是啊，为什么会这样呢？"}, {"type": "subtitle", "time": 6839.589, "timestamp": "01:53:59", "text": "在这里可以做到，但在我的设备上做不到。"}]
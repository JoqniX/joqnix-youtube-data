[{"type": "subtitle", "time": 362.71, "timestamp": "00:06:02", "text": "客人，对吧？是的。是的。本周六"}, {"type": "subtitle", "time": 365.51, "timestamp": "00:06:05", "text": "原本应该是馅饼"}, {"type": "subtitle", "time": 368.79, "timestamp": "00:06:08", "text": "合作日，但我睡着了。"}, {"type": "subtitle", "time": 372.39, "timestamp": "00:06:12", "text": "其中之一是日程安排问题。他们"}, {"type": "subtitle", "time": 374.309, "timestamp": "00:06:14", "text": "因为时区问题，没能去成。"}, {"type": "subtitle", "time": 377.749, "timestamp": "00:06:17", "text": "错误等等。紧急情况"}, {"type": "subtitle", "time": 381.35, "timestamp": "00:06:21", "text": "出色地。是的，我相信嗯，我有点像我"}, {"type": "subtitle", "time": 383.029, "timestamp": "00:06:23", "text": "仍需完成与……的合作"}, {"type": "subtitle", "time": 385.909, "timestamp": "00:06:25", "text": "以及我认识的每一位ITuber。"}, {"type": "subtitle", "time": 387.43, "timestamp": "00:06:27", "text": "真的很想和他们合作，但是"}, {"type": "subtitle", "time": 389.07, "timestamp": "00:06:29", "text": "很久都无法"}, {"type": "subtitle", "time": 392.95, "timestamp": "00:06:32", "text": "尽管。呃，还有很多呢。呃"}, {"type": "subtitle", "time": 396.11, "timestamp": "00:06:36", "text": "好的，我会试着问问。"}, {"type": "subtitle", "time": 399.99, "timestamp": "00:06:39", "text": "是啊，试试问问。嗯，是的，我会"}, {"type": "subtitle", "time": 403.43, "timestamp": "00:06:43", "text": "等我回来再担心吧。呃"}, {"type": "subtitle", "time": 406.23, "timestamp": "00:06:46", "text": "那我10分钟后回来。请这样做"}, {"type": "subtitle", "time": 407.469, "timestamp": "00:06:47", "text": "享受"}, {"type": "subtitle", "time": 410.55, "timestamp": "00:06:50", "text": "滑稽剧。呃，我10分钟后回来。"}, {"type": "subtitle", "time": 413.35, "timestamp": "00:06:53", "text": "我这就去把一切都准备好。"}, {"type": "subtitle", "time": 416.469, "timestamp": "00:06:56", "text": "一会儿再加入Zen。嗯，是的，祝你玩得开心。"}, {"type": "subtitle", "time": 419.51, "timestamp": "00:06:59", "text": "一个 va。不用担心。呃，我会，我们会"}]
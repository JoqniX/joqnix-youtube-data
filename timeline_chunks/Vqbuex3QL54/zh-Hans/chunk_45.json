[{"type": "subtitle", "time": 2700.069, "timestamp": "00:45:00", "text": "就像你可以尽情尖叫一样"}, {"type": "subtitle", "time": 2702.55, "timestamp": "00:45:02", "text": "想。我不知道。"}, {"type": "subtitle", "time": 2704.069, "timestamp": "00:45:04", "text": "不，你可以。不，你可以尽情尖叫"}, {"type": "subtitle", "time": 2705.829, "timestamp": "00:45:05", "text": "想要，但我还是会想，嗯？你"}, {"type": "subtitle", "time": 2708.95, "timestamp": "00:45:08", "text": "我知道了，抱歉。好的。"}, {"type": "subtitle", "time": 2713.109, "timestamp": "00:45:13", "text": "我的天啊。好的。我看到一对夫妇"}, {"type": "subtitle", "time": 2714.95, "timestamp": "00:45:14", "text": "聊天室里的人。你好。你好。你好。"}, {"type": "subtitle", "time": 2724.03, "timestamp": "00:45:24", "text": "欢迎。大家好。"}, {"type": "subtitle", "time": 2727.43, "timestamp": "00:45:27", "text": "是的。是的，"}, {"type": "subtitle", "time": 2731.27, "timestamp": "00:45:31", "text": "那你最近怎么样？我是我 我是我 我 我是"}, {"type": "subtitle", "time": 2732.95, "timestamp": "00:45:32", "text": "今天很棒。你知道，就像搞笑的"}, {"type": "chat", "time": 2735.002, "timestamp": "00:45:35", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "notPROBIN wow"}, {"type": "subtitle", "time": 2735.27, "timestamp": "00:45:35", "text": "事情发生了。就像我知道我的我"}, {"type": "subtitle", "time": 2737.03, "timestamp": "00:45:37", "text": "我知道我的口音总是让人觉得……"}, {"type": "subtitle", "time": 2738.87, "timestamp": "00:45:38", "text": "人们会问我来自哪里，以及"}, {"type": "subtitle", "time": 2742.069, "timestamp": "00:45:42", "text": "东西，但感觉我好像没那么做。"}, {"type": "subtitle", "time": 2743.75, "timestamp": "00:45:43", "text": "我没想到这种事会发生在我身上。"}, {"type": "subtitle", "time": 2746.19, "timestamp": "00:45:46", "text": "我自己的州就像"}, {"type": "subtitle", "time": 2749.51, "timestamp": "00:45:49", "text": "他们问我，比如，你做"}, {"type": "subtitle", "time": 2751.51, "timestamp": "00:45:51", "text": "你懂印地语，你知道，就像我"}, {"type": "subtitle", "time": 2755.109, "timestamp": "00:45:55", "text": "我刚才看了看那个问问题的人。"}, {"type": "subtitle", "time": 2756.95, "timestamp": "00:45:56", "text": "我想知道你懂印地语吗？我是"}, {"type": "subtitle", "time": 2759.589, "timestamp": "00:45:59", "text": "就好像我也是你们中的一员一样。我是其中之一"}]
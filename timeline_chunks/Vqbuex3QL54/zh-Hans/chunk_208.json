[{"type": "subtitle", "time": 12480.269, "timestamp": "03:28:00", "text": "这是什么？这是中文。"}, {"type": "subtitle", "time": 12482.59, "timestamp": "03:28:02", "text": "正确的？我认为这是"}, {"type": "subtitle", "time": 12485.51, "timestamp": "03:28:05", "text": "中国人。这是日语。我知道这一点"}, {"type": "subtitle", "time": 12486.429, "timestamp": "03:28:06", "text": "经过"}, {"type": "subtitle", "time": 12489.469, "timestamp": "03:28:09", "text": "心。我认为这是"}, {"type": "subtitle", "time": 12498.349, "timestamp": "03:28:18", "text": "耐用性较低。"}, {"type": "subtitle", "time": 12502.19, "timestamp": "03:28:22", "text": "哦，你需要一个你需要"}, {"type": "subtitle", "time": 12505.03, "timestamp": "03:28:25", "text": "哦，我不需要那样做，我没有"}, {"type": "subtitle", "time": 12506.87, "timestamp": "03:28:26", "text": "需要。"}, {"type": "subtitle", "time": 12508.87, "timestamp": "03:28:28", "text": "哦，等等。它已经变成中文了。"}, {"type": "subtitle", "time": 12511.11, "timestamp": "03:28:31", "text": "嗓音。我不需要下载额外的文件。"}, {"type": "subtitle", "time": 12521.75, "timestamp": "03:28:41", "text": "凉爽的。粗球。是的，弓箭帮。呃，但是"}, {"type": "subtitle", "time": 12524.309, "timestamp": "03:28:44", "text": "只是乌鸦的弓。我想要我的弓"}, {"type": "subtitle", "time": 12526.79, "timestamp": "03:28:46", "text": "得拉扯和塞进去。你知道，"}, {"type": "subtitle", "time": 12530.15, "timestamp": "03:28:50", "text": "弩很容易上手。是的，弩就像"}, {"type": "subtitle", "time": 12532.83, "timestamp": "03:28:52", "text": "适合容易相处的人。我"}, {"type": "subtitle", "time": 12539.71, "timestamp": "03:28:59", "text": "帆。"}]
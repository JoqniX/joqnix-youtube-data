[{"type": "subtitle", "time": 13944.309, "timestamp": "03:52:24", "text": "我就让你们打吧。女孩们打架。"}, {"type": "subtitle", "time": 13946.189, "timestamp": "03:52:26", "text": "我会撞到"}, {"type": "subtitle", "time": 13952.63, "timestamp": "03:52:32", "text": "哑的。好的。好的。好的。"}, {"type": "subtitle", "time": 13955.469, "timestamp": "03:52:35", "text": "好的。好的。不要争吵"}, {"type": "subtitle", "time": 13959.51, "timestamp": "03:52:39", "text": "我。哦。我的天哪。我的天哪。我开始进入"}, {"type": "subtitle", "time": 13967.99, "timestamp": "03:52:47", "text": "上帝。我的天啊。"}, {"type": "subtitle", "time": 13973.95, "timestamp": "03:52:53", "text": "高的？哦，我的"}]
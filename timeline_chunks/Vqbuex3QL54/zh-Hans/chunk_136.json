[{"type": "subtitle", "time": 8161.31, "timestamp": "02:16:01", "text": "东西，首秀擦痕，我想"}, {"type": "subtitle", "time": 8164.709, "timestamp": "02:16:04", "text": "嗯，是的，我也有点责任在自己身上。"}, {"type": "subtitle", "time": 8166.39, "timestamp": "02:16:06", "text": "我觉得我本来也能做到。"}, {"type": "subtitle", "time": 8168.95, "timestamp": "02:16:08", "text": "更好的。不，不，不，不，不。那不是"}, {"type": "subtitle", "time": 8171.109, "timestamp": "02:16:11", "text": "在你身上。那不是你的错。那是"}, {"type": "subtitle", "time": 8173.51, "timestamp": "02:16:13", "text": "完全不是你的责任。因为我记得"}, {"type": "subtitle", "time": 8176.229, "timestamp": "02:16:16", "text": "在我遭遇那件事之后，我警告了……"}, {"type": "subtitle", "time": 8178.95, "timestamp": "02:16:18", "text": "下一个人。我想是金钱和"}, {"type": "subtitle", "time": 8182.35, "timestamp": "02:16:22", "text": "她最终还是做了完全一样的事。"}, {"type": "subtitle", "time": 8185.91, "timestamp": "02:16:25", "text": "好的。它它它它不是它只是一个"}, {"type": "subtitle", "time": 8187.589, "timestamp": "02:16:27", "text": "诅咒。我觉得那只是个诅咒。喜欢"}, {"type": "subtitle", "time": 8189.43, "timestamp": "02:16:29", "text": "一切都仿佛命中注定。"}, {"type": "subtitle", "time": 8192.709, "timestamp": "02:16:32", "text": "一切皆是命中注定。但就像我一样"}, {"type": "subtitle", "time": 8195.75, "timestamp": "02:16:35", "text": "确实请你留下来，因为你当时只是"}, {"type": "subtitle", "time": 8197.91, "timestamp": "02:16:37", "text": "自然而然地，他是一个如此令人感到自在的人。"}, {"type": "subtitle", "time": 8199.509, "timestamp": "02:16:39", "text": "你知道，就像在那一刻，就像这样"}, {"type": "subtitle", "time": 8200.79, "timestamp": "02:16:40", "text": "他是个让人感到自在的人，即使我们之前并不认识他。"}, {"type": "subtitle", "time": 8204.309, "timestamp": "02:16:44", "text": "话很多，对吧？嗯，就是这样。"}, {"type": "subtitle", "time": 8207.03, "timestamp": "02:16:47", "text": "有你在真是太好了。呃"}, {"type": "subtitle", "time": 8208.549, "timestamp": "02:16:48", "text": "你知道，就像现在你就像"}, {"type": "subtitle", "time": 8211.83, "timestamp": "02:16:51", "text": "一位自豪的老师或师傅"}, {"type": "subtitle", "time": 8213.23, "timestamp": "02:16:53", "text": "知道喜欢"}, {"type": "subtitle", "time": 8217.429, "timestamp": "02:16:57", "text": "呃，只是个普通人。我不知道。"}, {"type": "subtitle", "time": 8219.349, "timestamp": "02:16:59", "text": "你帮了我很多忙。你帮了我很多忙。"}]
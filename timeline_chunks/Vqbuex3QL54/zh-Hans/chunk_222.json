[{"type": "subtitle", "time": 13322.87, "timestamp": "03:42:02", "text": "这意味着更大的危险。是的。"}, {"type": "subtitle", "time": 13324.95, "timestamp": "03:42:04", "text": "如果你需要帮助，可以加入其他组织。"}, {"type": "subtitle", "time": 13327.83, "timestamp": "03:42:07", "text": "球员组成一支队伍。但不要"}, {"type": "subtitle", "time": 13330.87, "timestamp": "03:42:10", "text": "害羞的。团结就是力量。哦，我的"}, {"type": "subtitle", "time": 13336.95, "timestamp": "03:42:16", "text": "古代的。那是一把弩。它"}, {"type": "subtitle", "time": 13339.03, "timestamp": "03:42:19", "text": "看起来像机关枪。比赛"}, {"type": "subtitle", "time": 13341.11, "timestamp": "03:42:21", "text": "继续下去，他的阴影将吞噬一切。"}, {"type": "subtitle", "time": 13343.67, "timestamp": "03:42:23", "text": "战场上，对任何被困的英雄造成伤害"}, {"type": "subtitle", "time": 13345.87, "timestamp": "03:42:25", "text": "里面。哦，大"}, {"type": "subtitle", "time": 13349.99, "timestamp": "03:42:29", "text": "刀刃。我的天哪，快看那把剑！如果"}, {"type": "subtitle", "time": 13352.07, "timestamp": "03:42:32", "text": "你死了，追踪。这是终极目标。"}, {"type": "subtitle", "time": 13354.15, "timestamp": "03:42:34", "text": "哦，灵魂之花的力量将会带来"}, {"type": "subtitle", "time": 13356.07, "timestamp": "03:42:36", "text": "你回来了。"}, {"type": "subtitle", "time": 13358.07, "timestamp": "03:42:38", "text": "哦好的。好的，我可以使用灵魂绽放。"}, {"type": "subtitle", "time": 13360.71, "timestamp": "03:42:40", "text": "是的。"}, {"type": "subtitle", "time": 13362.63, "timestamp": "03:42:42", "text": "收集灵魂玉石会提升你的"}, {"type": "subtitle", "time": 13364.55, "timestamp": "03:42:44", "text": "提升属性或赋予你新技能。新的"}, {"type": "subtitle", "time": 13366.79, "timestamp": "03:42:46", "text": "技能。将多个灵魂玉石组合起来"}, {"type": "subtitle", "time": 13369.269, "timestamp": "03:42:49", "text": "提升您在独特和"}, {"type": "subtitle", "time": 13371.91, "timestamp": "03:42:51", "text": "有趣的方式。"}, {"type": "subtitle", "time": 13374.229, "timestamp": "03:42:54", "text": "最后幸存的英雄赢得传奇"}, {"type": "subtitle", "time": 13376.55, "timestamp": "03:42:56", "text": "永生的面具。一个奖项"}, {"type": "subtitle", "time": 13379.349, "timestamp": "03:42:59", "text": "确保永垂不朽，名垂青史。现在告诉我"}]
[{"type": "subtitle", "time": 13511.99, "timestamp": "03:45:11", "text": "跑步时的小东西的护甲"}, {"type": "subtitle", "time": 13513.99, "timestamp": "03:45:13", "text": "奔跑蓄力垂直攻击"}, {"type": "subtitle", "time": 13524.03, "timestamp": "03:45:24", "text": "毁灭"}, {"type": "subtitle", "time": 13528.15, "timestamp": "03:45:28", "text": "垂直方向是什么？水平方向是什么？左边是什么？"}, {"type": "subtitle", "time": 13531.15, "timestamp": "03:45:31", "text": "右侧垂直方向是向上和向上"}, {"type": "subtitle", "time": 13534.67, "timestamp": "03:45:34", "text": "正确的。哦，对"}, {"type": "subtitle", "time": 13537.67, "timestamp": "03:45:37", "text": "点击。好的。好的。好的。好的。呃，当"}, {"type": "subtitle", "time": 13540.15, "timestamp": "03:45:40", "text": "在你来之前给你的呃充电"}, {"type": "subtitle", "time": 13542.309, "timestamp": "03:45:42", "text": "停止冲刺，"}, {"type": "subtitle", "time": 13556.51, "timestamp": "03:45:56", "text": "这。跑动和充电"}]
[{"type": "subtitle", "time": 18360.23, "timestamp": "05:06:00", "text": "これをガー。おお、それはすごいですね。私"}, {"type": "subtitle", "time": 18380.15, "timestamp": "05:06:20", "text": "私の。あ、待って。あなたは既に全て持っています"}, {"type": "subtitle", "time": 18382.708, "timestamp": "05:06:22", "text": "あなたの武器庫には、このような種類の武器があります。"}, {"type": "subtitle", "time": 18407.31, "timestamp": "05:06:47", "text": "シガンディック"}, {"type": "subtitle", "time": 18414.99, "timestamp": "05:06:54", "text": "殺す。この剣は"}]
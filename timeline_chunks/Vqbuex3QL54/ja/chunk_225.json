[{"type": "subtitle", "time": 13511.99, "timestamp": "03:45:11", "text": "ランニング時に小さなものを保護するアーマー"}, {"type": "subtitle", "time": 13513.99, "timestamp": "03:45:13", "text": "突進垂直攻撃時"}, {"type": "subtitle", "time": 13524.03, "timestamp": "03:45:24", "text": "破壊"}, {"type": "subtitle", "time": 13528.15, "timestamp": "03:45:28", "text": "垂直とは何で、水平は左です"}, {"type": "subtitle", "time": 13531.15, "timestamp": "03:45:31", "text": "右垂直線は上向きでオン"}, {"type": "subtitle", "time": 13534.67, "timestamp": "03:45:34", "text": "右。ああ、そうだね"}, {"type": "subtitle", "time": 13537.67, "timestamp": "03:45:37", "text": "クリック。わかった。わかった。わかった。わかった。えっと、いつ"}, {"type": "subtitle", "time": 13540.15, "timestamp": "03:45:40", "text": "来る前に充電してください"}, {"type": "subtitle", "time": 13542.309, "timestamp": "03:45:42", "text": "ダッシュを停止、"}, {"type": "subtitle", "time": 13556.51, "timestamp": "03:45:56", "text": "これ。走って突進する"}]
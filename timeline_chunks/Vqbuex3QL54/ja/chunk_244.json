[{"type": "subtitle", "time": 14641.59, "timestamp": "04:04:01", "text": "セージ。ああ、そういう女性もいるよ"}, {"type": "subtitle", "time": 14650.95, "timestamp": "04:04:10", "text": "なぜ一つの試合にこんなに時間がかかっているのか？こんにちは。"}, {"type": "subtitle", "time": 14652.67, "timestamp": "04:04:12", "text": "切り替えるべきでしょうか？"}, {"type": "subtitle", "time": 14662.389, "timestamp": "04:04:22", "text": "[音楽]"}, {"type": "subtitle", "time": 14665.99, "timestamp": "04:04:25", "text": "私はフィル派です。"}, {"type": "subtitle", "time": 14669.51, "timestamp": "04:04:29", "text": "時間がかかりすぎている。ニース。"}, {"type": "subtitle", "time": 14672.03, "timestamp": "04:04:32", "text": "この部屋は何ですか？"}, {"type": "subtitle", "time": 14673.51, "timestamp": "04:04:33", "text": "[音楽]"}, {"type": "subtitle", "time": 14677.349, "timestamp": "04:04:37", "text": "いいえ、これは"}, {"type": "subtitle", "time": 14680.25, "timestamp": "04:04:40", "text": "計画のこと。わかった。"}, {"type": "subtitle", "time": 14685.67, "timestamp": "04:04:45", "text": "[音楽]"}, {"type": "subtitle", "time": 14689.07, "timestamp": "04:04:49", "text": "ヒーローバッジ"}, {"type": "subtitle", "time": 14692.63, "timestamp": "04:04:52", "text": "チャージ版アップグレード。おお。"}, {"type": "subtitle", "time": 14696.03, "timestamp": "04:04:56", "text": "スタンダード版。ダックス"}, {"type": "subtitle", "time": 14698.469, "timestamp": "04:04:58", "text": "究極の。究極の技を手に入れた。わかった。"}]
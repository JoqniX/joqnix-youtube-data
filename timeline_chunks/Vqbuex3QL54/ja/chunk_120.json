[{"type": "subtitle", "time": 7201.95, "timestamp": "02:00:01", "text": "今でも自分がすごくバカみたいに感じる。それで"}, {"type": "subtitle", "time": 7205.75, "timestamp": "02:00:05", "text": "まるで、私は、私は、えーと、そういう感じだった"}, {"type": "chat", "time": 7205.816, "timestamp": "02:00:05", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "I used to record gameplay that I never posted and it was so cringe lmao"}, {"type": "subtitle", "time": 7208.229, "timestamp": "02:00:08", "text": "友達と電話するような感じだよね？など"}, {"type": "subtitle", "time": 7209.99, "timestamp": "02:00:09", "text": "どうやら、えっと、それは、"}, {"type": "subtitle", "time": 7212.87, "timestamp": "02:00:12", "text": "Discordの通話みたいな感じですよね？そしてこのように"}, {"type": "subtitle", "time": 7215.75, "timestamp": "02:00:15", "text": "ミュートするボタンは2つありますよね？それで"}, {"type": "subtitle", "time": 7217.35, "timestamp": "02:00:17", "text": "まるで私がそのように見ていないかのように"}, {"type": "subtitle", "time": 7221.189, "timestamp": "02:00:21", "text": "横に。うん。そして私は"}, {"type": "subtitle", "time": 7223.189, "timestamp": "02:00:23", "text": "真ん中ですよね？それで私はそれを押して"}, {"type": "subtitle", "time": 7225.99, "timestamp": "02:00:25", "text": "トラックパッドなどを使って"}, {"type": "chat", "time": 7227.724, "timestamp": "02:00:27", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "my brother heard me recording once and called me schizo"}, {"type": "subtitle", "time": 7229.43, "timestamp": "02:00:29", "text": "えーっと、その他もろもろ。だから私は"}, {"type": "subtitle", "time": 7231.27, "timestamp": "02:00:31", "text": "そう思ったので、ミュートボタンを押しました。で"}, {"type": "subtitle", "time": 7233.03, "timestamp": "02:00:33", "text": "少なくとも私はそう思ったし、"}, {"type": "subtitle", "time": 7234.79, "timestamp": "02:00:34", "text": "そして私は逃げる、そして私は逃げる、なぜなら私は"}, {"type": "subtitle", "time": 7243.99, "timestamp": "02:00:43", "text": "それから、私は始めた、私は始めた"}, {"type": "subtitle", "time": 7246.629, "timestamp": "02:00:46", "text": "何もないのに叫んでいるような感じだった。"}, {"type": "subtitle", "time": 7248.709, "timestamp": "02:00:48", "text": "まるで私が3回歌ったように"}, {"type": "subtitle", "time": 7250.47, "timestamp": "02:00:50", "text": "まるで私が歌い始めたときのように違う"}, {"type": "subtitle", "time": 7253.229, "timestamp": "02:00:53", "text": "3つの異なるトーンで、文字通り"}, {"type": "subtitle", "time": 7257.03, "timestamp": "02:00:57", "text": "ランニングに出かけるようなもの"}, {"type": "subtitle", "time": 7258.31, "timestamp": "02:00:58", "text": "何もない。そして、それはまるで"}, {"type": "subtitle", "time": 7259.669, "timestamp": "02:00:59", "text": "とても恥ずかしいことですが、"}]
[{"type": "subtitle", "time": 736.629, "timestamp": "00:12:16", "text": "[音楽]"}, {"type": "subtitle", "time": 744.06, "timestamp": "00:12:24", "text": "良い？気にしないでください。私はただ食べているだけです"}, {"type": "subtitle", "time": 746.829, "timestamp": "00:12:26", "text": "[音楽]"}, {"type": "subtitle", "time": 750.43, "timestamp": "00:12:30", "text": "夕食。だから、私は"}, {"type": "subtitle", "time": 757.67, "timestamp": "00:12:37", "text": "スプーンで食べるのは難しい。つまり、"}, {"type": "subtitle", "time": 760.31, "timestamp": "00:12:40", "text": "難しくないよ。ただ私は"}, {"type": "subtitle", "time": 762.79, "timestamp": "00:12:42", "text": "片手でマルチタスクをしながら、"}, {"type": "subtitle", "time": 765.509, "timestamp": "00:12:45", "text": "もう片方の手はパソコンで他の作業をしている。"}, {"type": "subtitle", "time": 767.069, "timestamp": "00:12:47", "text": "それで、"}]
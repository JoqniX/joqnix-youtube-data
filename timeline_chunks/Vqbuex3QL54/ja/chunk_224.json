[{"type": "subtitle", "time": 13461.11, "timestamp": "03:44:21", "text": "これは魂の開花だと信じています。いつ"}, {"type": "subtitle", "time": 13472.87, "timestamp": "03:44:32", "text": "わかった。いや、ジャグじゃないよ。はい、それは"}, {"type": "subtitle", "time": 13478.95, "timestamp": "03:44:38", "text": "いいね。防具は装備されていません。する必要がある"}, {"type": "subtitle", "time": 13491.269, "timestamp": "03:44:51", "text": "それはピストルだ。それは、それは不正行為です。"}, {"type": "subtitle", "time": 13492.79, "timestamp": "03:44:52", "text": "あ、そこだ。待て、刀があるぞ。"}, {"type": "subtitle", "time": 13493.87, "timestamp": "03:44:53", "text": "そこには"}, {"type": "subtitle", "time": 13496.389, "timestamp": "03:44:56", "text": "刀。あのね？私は切り替える"}]
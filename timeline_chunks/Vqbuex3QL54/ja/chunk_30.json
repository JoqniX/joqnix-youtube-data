[{"type": "subtitle", "time": 1800.87, "timestamp": "00:30:00", "text": "攻撃ヘリを画面上で見ることができるように。おお"}, {"type": "subtitle", "time": 1802.57, "timestamp": "00:30:02", "text": "我が神よ。私の"}, {"type": "subtitle", "time": 1808.99, "timestamp": "00:30:08", "text": "[音楽]"}, {"type": "subtitle", "time": 1811.909, "timestamp": "00:30:11", "text": "悪い。何てことだ。待って、待って、待って、待って。"}, {"type": "subtitle", "time": 1817.51, "timestamp": "00:30:17", "text": "私は正しいと思う。ああ、それはひどい。"}, {"type": "subtitle", "time": 1819.83, "timestamp": "00:30:19", "text": "何てことだ。なぜ誰も私に教えてくれなかったの？ああ、"}, {"type": "subtitle", "time": 1834.82, "timestamp": "00:30:34", "text": "あなた？取る"}, {"type": "subtitle", "time": 1847.07, "timestamp": "00:30:47", "text": "別の。"}]
[{"type": "subtitle", "time": 18068.55, "timestamp": "05:01:08", "text": "業績。私はちょうど家に帰ってきたところです。うん。"}, {"type": "subtitle", "time": 18075.31, "timestamp": "05:01:15", "text": "ああ、こんにちは"}, {"type": "subtitle", "time": 18078.868, "timestamp": "05:01:18", "text": "あなた。どうでしたか？楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 18080.788, "timestamp": "05:01:20", "text": "外。"}, {"type": "subtitle", "time": 18082.868, "timestamp": "05:01:22", "text": "新たな動力源による血みどろの戦い"}, {"type": "subtitle", "time": 18085.59, "timestamp": "05:01:25", "text": "魅惑的な、もはや他の永遠の試練はない"}, {"type": "subtitle", "time": 18086.51, "timestamp": "05:01:26", "text": "よく"}, {"type": "subtitle", "time": 18088.708, "timestamp": "05:01:28", "text": "進行中。探し回る必要はありません"}, {"type": "subtitle", "time": 18091.51, "timestamp": "05:01:31", "text": "ギヤ。最後のジャンプはありません"}, {"type": "subtitle", "time": 18093.788, "timestamp": "05:01:33", "text": "経験。ああ、これは"}, {"type": "subtitle", "time": 18096.27, "timestamp": "05:01:36", "text": "何が"}, {"type": "subtitle", "time": 18099.11, "timestamp": "05:01:39", "text": "これ？時間が経つのは、"}, {"type": "subtitle", "time": 18103.83, "timestamp": "05:01:43", "text": "殺す方法、殺す方法、何人殺すか"}, {"type": "subtitle", "time": 18106.67, "timestamp": "05:01:46", "text": "人を殺してどれだけ殺すか"}, {"type": "subtitle", "time": 18110.55, "timestamp": "05:01:50", "text": "欲しい。授業は楽しい。ああ、私たちは"}, {"type": "subtitle", "time": 18113.59, "timestamp": "05:01:53", "text": "ああ、授業があったんですね。わかった。わかった。行くよ、私は"}, {"type": "subtitle", "time": 18117.07, "timestamp": "05:01:57", "text": "GPUを取りに行ったのかと思った"}, {"type": "subtitle", "time": 18119.12, "timestamp": "05:01:59", "text": "今日。"}]
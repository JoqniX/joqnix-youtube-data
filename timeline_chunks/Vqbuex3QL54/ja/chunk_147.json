[{"type": "subtitle", "time": 8822.79, "timestamp": "02:27:02", "text": "椅子のあちこちに私の"}, {"type": "subtitle", "time": 8831.07, "timestamp": "02:27:11", "text": "うん。だから、私は"}, {"type": "subtitle", "time": 8833.389, "timestamp": "02:27:13", "text": "興奮した。"}, {"type": "subtitle", "time": 8836.55, "timestamp": "02:27:16", "text": "つまり、コラボレーションはこれで終わりではないということです。私は"}, {"type": "subtitle", "time": 8838.389, "timestamp": "02:27:18", "text": "コラボレーションの終わりを告げるかのように話す"}, {"type": "subtitle", "time": 8840.95, "timestamp": "02:27:20", "text": "しかし、まだまだ先は長い。たくさんあります"}, {"type": "subtitle", "time": 8843.79, "timestamp": "02:27:23", "text": "残された人々"}, {"type": "subtitle", "time": 8845.469, "timestamp": "02:27:25", "text": "保留中。"}, {"type": "subtitle", "time": 8848.95, "timestamp": "02:27:28", "text": "うん。でも、できる限り努力します"}, {"type": "subtitle", "time": 8850.63, "timestamp": "02:27:30", "text": "全員参加して、最後に"}, {"type": "subtitle", "time": 8851.95, "timestamp": "02:27:31", "text": "みんなの"}, {"type": "subtitle", "time": 8856.23, "timestamp": "02:27:36", "text": "もの。ええ、そういうことです。私は"}, {"type": "subtitle", "time": 8858.389, "timestamp": "02:27:38", "text": "新しい人たちもここに来て、"}, {"type": "subtitle", "time": 8859.389, "timestamp": "02:27:39", "text": "そこには。"}, {"type": "subtitle", "time": 8862.95, "timestamp": "02:27:42", "text": "ええ、うまくいくことを祈りましょう。そして"}, {"type": "subtitle", "time": 8866.389, "timestamp": "02:27:46", "text": "ウムに来てくださった皆さん、ありがとうございました"}, {"type": "subtitle", "time": 8869.99, "timestamp": "02:27:49", "text": "夜の小川と、えーと、"}, {"type": "subtitle", "time": 8871.91, "timestamp": "02:27:51", "text": "朝夕の小川で"}, {"type": "subtitle", "time": 8876.309, "timestamp": "02:27:56", "text": "カザンとコラボレーションした。彼女はまさにOGだった"}, {"type": "subtitle", "time": 8878.429, "timestamp": "02:27:58", "text": "オリジナルについて"}]
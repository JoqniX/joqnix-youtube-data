[{"type": "subtitle", "time": 14040.87, "timestamp": "03:54:00", "text": "難しい。なんてこった。なんてこった。またか。ない"}, {"type": "subtitle", "time": 14043.51, "timestamp": "03:54:03", "text": "また。またか。またか。またか。"}, {"type": "subtitle", "time": 14044.83, "timestamp": "03:54:04", "text": "動く。"}, {"type": "subtitle", "time": 14056.71, "timestamp": "03:54:16", "text": "私はその輪の中にいるんですよね？わかった。私は"}, {"type": "subtitle", "time": 14059.229, "timestamp": "03:54:19", "text": "回復する"}, {"type": "subtitle", "time": 14061.07, "timestamp": "03:54:21", "text": "4つ。さあ"}, {"type": "subtitle", "time": 14078.309, "timestamp": "03:54:38", "text": "もの。どうして私はこの件から除外されているの？"}, {"type": "subtitle", "time": 14081.189, "timestamp": "03:54:41", "text": "なぜ？何てことだ。バッグがいっぱいです。"}, {"type": "subtitle", "time": 14098.429, "timestamp": "03:54:58", "text": "行く。ああ、それは供給だ"}]
[{"type": "subtitle", "time": 18180.43, "timestamp": "05:03:00", "text": "良い。こんにちは。"}, {"type": "subtitle", "time": 18183.99, "timestamp": "05:03:03", "text": "こんにちは。髪の色をカスタマイズできますか？私"}, {"type": "subtitle", "time": 18184.91, "timestamp": "05:03:04", "text": "私は思う"}, {"type": "subtitle", "time": 18187.39, "timestamp": "05:03:07", "text": "できる。あなたに"}, {"type": "subtitle", "time": 18190.31, "timestamp": "05:03:10", "text": "白？だって彼女は確かにちょっといい感じに見えるから"}, {"type": "subtitle", "time": 18194.47, "timestamp": "05:03:14", "text": "白と青も一緒に。"}, {"type": "subtitle", "time": 18197.43, "timestamp": "05:03:17", "text": "ああ、赤毛もいいよ。これは"}, {"type": "subtitle", "time": 18201.19, "timestamp": "05:03:21", "text": "デフォルトの色ですよね？もし私が行ったらどうなるだろう"}, {"type": "subtitle", "time": 18209.23, "timestamp": "05:03:29", "text": "青みがかった。ええ、青色です。これは私の"}, {"type": "subtitle", "time": 18213.51, "timestamp": "05:03:33", "text": "パレット。青みがかった白色。それは"}, {"type": "subtitle", "time": 18220.628, "timestamp": "05:03:40", "text": "パレット。私はそれに合わせて行動するつもりなの？"}, {"type": "subtitle", "time": 18223.91, "timestamp": "05:03:43", "text": "今朝から、あの夜以来ですか？おお"}, {"type": "subtitle", "time": 18225.708, "timestamp": "05:03:45", "text": "私の"}, {"type": "subtitle", "time": 18230.19, "timestamp": "05:03:50", "text": "神。それで、結果はどうだった？どうやって"}, {"type": "subtitle", "time": 18238.788, "timestamp": "05:03:58", "text": "行く？マイクとか使いましたか？した"}]
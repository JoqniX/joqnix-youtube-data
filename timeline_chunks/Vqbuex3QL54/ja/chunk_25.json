[{"type": "subtitle", "time": 1500.909, "timestamp": "00:25:00", "text": "[音楽]"}, {"type": "subtitle", "time": 1503.789, "timestamp": "00:25:03", "text": "自分自身。 A"}, {"type": "subtitle", "time": 1507.83, "timestamp": "00:25:07", "text": "不名誉。インターンシップって何でしたっけ？は"}, {"type": "subtitle", "time": 1512.47, "timestamp": "00:25:12", "text": "それは、えっと、あなたが"}, {"type": "subtitle", "time": 1514.71, "timestamp": "00:25:14", "text": "他の場所へ行って働くために"}, {"type": "subtitle", "time": 1516.51, "timestamp": "00:25:16", "text": "経験を積んで"}, {"type": "subtitle", "time": 1518.59, "timestamp": "00:25:18", "text": "もの？"}, {"type": "subtitle", "time": 1520.19, "timestamp": "00:25:20", "text": "A"}, {"type": "subtitle", "time": 1527.63, "timestamp": "00:25:27", "text": "ああ、ああ"}, {"type": "subtitle", "time": 1530.789, "timestamp": "00:25:30", "text": "ああ、初めてだ、ああ、なんてことだ、"}, {"type": "subtitle", "time": 1534.23, "timestamp": "00:25:34", "text": "すごく可愛いですね。すごく可愛いですね。ああ、"}, {"type": "subtitle", "time": 1535.72, "timestamp": "00:25:35", "text": "神。"}, {"type": "subtitle", "time": 1539.39, "timestamp": "00:25:39", "text": "[音楽]"}, {"type": "subtitle", "time": 1541.83, "timestamp": "00:25:41", "text": "もっと。つまり、もし"}, {"type": "subtitle", "time": 1544.71, "timestamp": "00:25:44", "text": "誰か今すぐ私に食べ物をくれないか。"}]
[{"type": "subtitle", "time": 16741.429, "timestamp": "04:39:01", "text": "[音楽]"}, {"type": "subtitle", "time": 16744.15, "timestamp": "04:39:04", "text": "短い髪を載せたいだけ"}, {"type": "subtitle", "time": 16750.31, "timestamp": "04:39:10", "text": "あ、待って。入れることはできません。"}, {"type": "subtitle", "time": 16755.51, "timestamp": "04:39:15", "text": "これだけを入れてください。うんうん。"}, {"type": "subtitle", "time": 16758.629, "timestamp": "04:39:18", "text": "しかし、これもまた。いや、これは違う。"}, {"type": "subtitle", "time": 16760.23, "timestamp": "04:39:20", "text": "どこですか？それはどこにあったのですか？それはどこにあったのですか？"}, {"type": "subtitle", "time": 16763.189, "timestamp": "04:39:23", "text": "クリックしました。これは良さそうだ。ハナ。そして"}, {"type": "subtitle", "time": 16765.109, "timestamp": "04:39:25", "text": "これもそうだ。"}, {"type": "subtitle", "time": 16768.39, "timestamp": "04:39:28", "text": "問題なさそうだ。だから、このワイパーは"}, {"type": "subtitle", "time": 16769.91, "timestamp": "04:39:29", "text": "ニング"}, {"type": "subtitle", "time": 16775.109, "timestamp": "04:39:35", "text": "えっと、ネオトマトの皮があります。"}, {"type": "subtitle", "time": 16778.708, "timestamp": "04:39:38", "text": "これです。ええ、彼女は"}, {"type": "subtitle", "time": 16781.27, "timestamp": "04:39:41", "text": "わかった。"}, {"type": "subtitle", "time": 16783.19, "timestamp": "04:39:43", "text": "[音楽]"}, {"type": "subtitle", "time": 16784.75, "timestamp": "04:39:44", "text": "私はただ"}, {"type": "subtitle", "time": 16788.07, "timestamp": "04:39:48", "text": "このピン男。"}, {"type": "subtitle", "time": 16789.67, "timestamp": "04:39:49", "text": "ああ、とにかくプレイを続けるよ。うん、"}, {"type": "subtitle", "time": 16791.59, "timestamp": "04:39:51", "text": "さあ行こう。"}, {"type": "subtitle", "time": 16795.37, "timestamp": "04:39:55", "text": "普通にプレイしてみましょう。"}, {"type": "subtitle", "time": 16797.51, "timestamp": "04:39:57", "text": "[音楽]"}]
[{"type": "subtitle", "time": 4443.03, "timestamp": "01:14:03", "text": "私には物やあらゆるものが必要だ。それは"}, {"type": "subtitle", "time": 4444.63, "timestamp": "01:14:04", "text": "1つ。"}, {"type": "subtitle", "time": 4449.43, "timestamp": "01:14:09", "text": "えっと、2つ目は、そうしてよかったと思っています"}, {"type": "subtitle", "time": 4452.47, "timestamp": "01:14:12", "text": "YouTubeやストリーミング全般"}, {"type": "subtitle", "time": 4456.149, "timestamp": "01:14:16", "text": "だって、現実世界では私はすごく早い時期"}, {"type": "subtitle", "time": 4459.669, "timestamp": "01:14:19", "text": "子供とあなたは友達を作るのが難しく、"}, {"type": "subtitle", "time": 4462.55, "timestamp": "01:14:22", "text": "すべて。私は外出しないことに気づいて"}, {"type": "subtitle", "time": 4464.55, "timestamp": "01:14:24", "text": "すべては幼少期のトラウマによるもの"}, {"type": "subtitle", "time": 4469.11, "timestamp": "01:14:29", "text": "そして、すべて、そしてオンラインであること"}, {"type": "subtitle", "time": 4471.91, "timestamp": "01:14:31", "text": "おかげで、今日私が知っている人たちと出会うことができました。"}, {"type": "subtitle", "time": 4475.189, "timestamp": "01:14:35", "text": "そしてまさにその人たちこそ私が"}, {"type": "subtitle", "time": 4477.43, "timestamp": "01:14:37", "text": "積極的にコラボレーションしようとしています"}, {"type": "subtitle", "time": 4480.03, "timestamp": "01:14:40", "text": "日本へ出発する。だからそれは私にとってとても大切なことなんです"}, {"type": "subtitle", "time": 4482.87, "timestamp": "01:14:42", "text": "彼らはまだ私のことを覚えていて、私は"}, {"type": "subtitle", "time": 4485.43, "timestamp": "01:14:45", "text": "それでも本物を保つことができる"}, {"type": "subtitle", "time": 4489.75, "timestamp": "01:14:49", "text": "接続関連のもの。えっと、ずっと昔"}, {"type": "subtitle", "time": 4492.87, "timestamp": "01:14:52", "text": "以前は、人々や、えっと、このような人たちを見ていました"}, {"type": "subtitle", "time": 4495.91, "timestamp": "01:14:55", "text": "友情とかその他すべて、"}, {"type": "subtitle", "time": 4499.11, "timestamp": "01:14:59", "text": "星座のリンク、またはリンのような"}]
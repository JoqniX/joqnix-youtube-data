[{"type": "subtitle", "time": 5464.39, "timestamp": "01:31:04", "text": "実際に理解していない人、例えば、もし"}, {"type": "subtitle", "time": 5466.149, "timestamp": "01:31:06", "text": "例えばよくある間違い"}, {"type": "subtitle", "time": 5468.39, "timestamp": "01:31:08", "text": "私の側からすると、私が作るようなものです"}, {"type": "subtitle", "time": 5471.91, "timestamp": "01:31:11", "text": "同じ間違いを何度も繰り返している"}, {"type": "subtitle", "time": 5474.55, "timestamp": "01:31:14", "text": "私が"}, {"type": "subtitle", "time": 5476.95, "timestamp": "01:31:16", "text": "私はそれに慣れておくべきだった。私"}, {"type": "subtitle", "time": 5482.03, "timestamp": "01:31:22", "text": "知ってるけど、えっと、私は"}, {"type": "subtitle", "time": 5484.47, "timestamp": "01:31:24", "text": "無意識のうちに私は起こった"}, {"type": "subtitle", "time": 5487.03, "timestamp": "01:31:27", "text": "その間違いを犯す。当時は知らなかった"}, {"type": "subtitle", "time": 5489.669, "timestamp": "01:31:29", "text": "間違いを犯した後、後悔している"}, {"type": "subtitle", "time": 5491.83, "timestamp": "01:31:31", "text": "そういうことにならないように最善を尽くします"}, {"type": "subtitle", "time": 5495.83, "timestamp": "01:31:35", "text": "もう一度繰り返すが、また繰り返すかもしれない"}, {"type": "subtitle", "time": 5498.31, "timestamp": "01:31:38", "text": "その罠に陥る、あるいは何か"}, {"type": "subtitle", "time": 5500.95, "timestamp": "01:31:40", "text": "人生が私に与えてくれるもの、そして私が間違いを犯す"}, {"type": "subtitle", "time": 5505.35, "timestamp": "01:31:45", "text": "また。だからその友達はやり遂げるかもしれない"}, {"type": "subtitle", "time": 5507.43, "timestamp": "01:31:47", "text": "君とはもうおしまいだ。中には"}, {"type": "subtitle", "time": 5510.629, "timestamp": "01:31:50", "text": "100 番目まで待つことをいとわない、または"}, {"type": "chat", "time": 5512.225, "timestamp": "01:31:52", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "back"}, {"type": "subtitle", "time": 5514.229, "timestamp": "01:31:54", "text": "千回目、あなたができるまで"}, {"type": "subtitle", "time": 5516.55, "timestamp": "01:31:56", "text": "改善して好きになってくれれば、彼らはあなたを理解するでしょう"}, {"type": "subtitle", "time": 5518.27, "timestamp": "01:31:58", "text": "いや、君はやらないよ"}]
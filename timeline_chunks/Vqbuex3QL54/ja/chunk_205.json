[{"type": "subtitle", "time": 12300.229, "timestamp": "03:25:00", "text": "倒れた戦士たちによって。変更できますか"}, {"type": "subtitle", "time": 12302.07, "timestamp": "03:25:02", "text": "この場所は敵で溢れかえっている。おお"}, {"type": "subtitle", "time": 12304.389, "timestamp": "03:25:04", "text": "ああ、彼らは彼らの"}, {"type": "subtitle", "time": 12308.349, "timestamp": "03:25:08", "text": "独自のWikipediaのような名前。ああ、"}, {"type": "subtitle", "time": 12311.19, "timestamp": "03:25:11", "text": "神。しかし、このゲームの特徴は"}, {"type": "subtitle", "time": 12313.19, "timestamp": "03:25:13", "text": "まるで格闘ゲームみたいだ。あなたには"}, {"type": "subtitle", "time": 12317.349, "timestamp": "03:25:17", "text": "格闘ゲームのようなもの。しなければならない"}, {"type": "subtitle", "time": 12323.03, "timestamp": "03:25:23", "text": "残念ながら、"}, {"type": "subtitle", "time": 12326.99, "timestamp": "03:25:26", "text": "コンボ、あなたはあなたの"}, {"type": "subtitle", "time": 12330.87, "timestamp": "03:25:30", "text": "op.フレーム数は480です。ああ、そうだね"}, {"type": "subtitle", "time": 12335.269, "timestamp": "03:25:35", "text": "最近では600FPSのモニターもある。今私は"}, {"type": "subtitle", "time": 12339.07, "timestamp": "03:25:39", "text": "今では存在すら忘れていた。ああ、"}, {"type": "subtitle", "time": 12347.91, "timestamp": "03:25:47", "text": "機能強化。 Nvidia DLSS。えっと、私は"}, {"type": "subtitle", "time": 12349.79, "timestamp": "03:25:49", "text": "行ける"}, {"type": "subtitle", "time": 12352.229, "timestamp": "03:25:52", "text": "パフォーマンス。ああ、すべてが"}, {"type": "subtitle", "time": 12354.309, "timestamp": "03:25:54", "text": "高い。いいえ、高くしてほしくないんです。"}, {"type": "subtitle", "time": 12357.349, "timestamp": "03:25:57", "text": "中くらい。私は小型のグラフィックカードを持っています"}]
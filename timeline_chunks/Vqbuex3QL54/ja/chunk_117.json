[{"type": "subtitle", "time": 7020.07, "timestamp": "01:57:00", "text": "すべて、ですよね？あなたにとってはとても高い"}, {"type": "subtitle", "time": 7023.03, "timestamp": "01:57:03", "text": "息をすると息苦しさを感じる。"}, {"type": "subtitle", "time": 7025.83, "timestamp": "01:57:05", "text": "それが私がドクター・ネックスとして感じたことであり、"}, {"type": "subtitle", "time": 7028.79, "timestamp": "01:57:08", "text": "木々が生い茂る谷。"}, {"type": "subtitle", "time": 7030.87, "timestamp": "01:57:10", "text": "それが私が音楽を通して感じたことだった"}, {"type": "subtitle", "time": 7033.27, "timestamp": "01:57:13", "text": "チャンネルとかそういうもの。そして私はまだ"}, {"type": "subtitle", "time": 7036.35, "timestamp": "01:57:16", "text": "ジョックニックを手に入れようと最善を尽くしています"}, {"type": "subtitle", "time": 7040.31, "timestamp": "01:57:20", "text": "環境として、私が"}, {"type": "subtitle", "time": 7043.03, "timestamp": "01:57:23", "text": "自由に呼吸でき、"}, {"type": "subtitle", "time": 7046.31, "timestamp": "01:57:26", "text": "いろいろなことが気になる。たとえ私が"}, {"type": "subtitle", "time": 7047.91, "timestamp": "01:57:27", "text": "自分らしくいること、私はただそうしたいだけです"}, {"type": "subtitle", "time": 7049.99, "timestamp": "01:57:29", "text": "無料。無料、そういうやつ"}, {"type": "subtitle", "time": 7052.55, "timestamp": "01:57:32", "text": "あれ。そう、精神的な問題なんだ。"}, {"type": "chat", "time": 7053.433, "timestamp": "01:57:33", "author": "@OrangeSan", "avatar": "https://yt4.ggpht.com/1hzJ_11ALUfVaVrkxYo1ZVLPiK-9KSZ_F82omBSnvPLydlaR2DHr5h-PrrBJwHbm0GleoSyYuQ=s64-c-k-c0x00ffffff-no-rj", "message": "ohh"}, {"type": "subtitle", "time": 7055.669, "timestamp": "01:57:35", "text": "あなたが言ったことは理解できます。"}, {"type": "subtitle", "time": 7058.47, "timestamp": "01:57:38", "text": "それは確かにその通りだ。そして私は、そして私は"}, {"type": "subtitle", "time": 7061.149, "timestamp": "01:57:41", "text": "そういう風に感じる"}, {"type": "subtitle", "time": 7064.629, "timestamp": "01:57:44", "text": "もしあえて言わせてもらえるなら、私たち二人とも"}, {"type": "subtitle", "time": 7067.35, "timestamp": "01:57:47", "text": "物事を非常に似たような方法で見る"}, {"type": "subtitle", "time": 7072.51, "timestamp": "01:57:52", "text": "そういう意味で、私はそう感じます。"}, {"type": "subtitle", "time": 7075.629, "timestamp": "01:57:55", "text": "わかった。右。"}, {"type": "subtitle", "time": 7077.31, "timestamp": "01:57:57", "text": "わかった。"}]
[{"type": "subtitle", "time": 5880.55, "timestamp": "01:38:00", "text": "あるいは、そんな感じのことを言ってみてください。そこで私は検索します"}, {"type": "subtitle", "time": 5883.03, "timestamp": "01:38:03", "text": "上は、これらの質問は、どのように"}, {"type": "subtitle", "time": 5885.35, "timestamp": "01:38:05", "text": "知り合いのことをもっとよく知るために"}, {"type": "chat", "time": 5885.857, "timestamp": "01:38:05", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "us"}, {"type": "subtitle", "time": 5888.229, "timestamp": "01:38:08", "text": "思うに、そしてそれは良いことだと思う"}, {"type": "subtitle", "time": 5890.47, "timestamp": "01:38:10", "text": "私はその人のことを理解しています"}, {"type": "subtitle", "time": 5895.03, "timestamp": "01:38:15", "text": "もっといい方法、まあ、いい感じ"}, {"type": "subtitle", "time": 5896.629, "timestamp": "01:38:16", "text": "好きな色を尋ねて、"}, {"type": "subtitle", "time": 5898.709, "timestamp": "01:38:18", "text": "食べ物として持っているものは良いですね"}, {"type": "subtitle", "time": 5901.35, "timestamp": "01:38:21", "text": "でも時々、ほら、"}, {"type": "chat", "time": 5904.248, "timestamp": "01:38:24", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "when we first met i was just silent 😂😂"}, {"type": "subtitle", "time": 5904.629, "timestamp": "01:38:24", "text": "到達したいという生来のニーズ"}, {"type": "subtitle", "time": 5906.87, "timestamp": "01:38:26", "text": "他の人を知っていると思う"}, {"type": "subtitle", "time": 5911.91, "timestamp": "01:38:31", "text": "また、時間も非常に重要です。"}, {"type": "subtitle", "time": 5914.149, "timestamp": "01:38:34", "text": "私はあなたが贈ることができる最高の贈り物だと感じています"}, {"type": "subtitle", "time": 5915.59, "timestamp": "01:38:35", "text": "与えること、そしてあなたができる最善のこと"}, {"type": "subtitle", "time": 5917.189, "timestamp": "01:38:37", "text": "与えること、そして最も高価なもの"}, {"type": "subtitle", "time": 5919.27, "timestamp": "01:38:39", "text": "世界で最も高価なもの"}, {"type": "subtitle", "time": 5922.709, "timestamp": "01:38:42", "text": "世界で一番大切なのは時間だと私は感じています"}, {"type": "subtitle", "time": 5924.87, "timestamp": "01:38:44", "text": "そして私はすべてを時間に基づいて判断します"}, {"type": "subtitle", "time": 5928.51, "timestamp": "01:38:48", "text": "お金よりも時間の方が、もし私が費やしたら"}, {"type": "subtitle", "time": 5931.189, "timestamp": "01:38:51", "text": "例えば何かに8kかけると、"}, {"type": "subtitle", "time": 5933.75, "timestamp": "01:38:53", "text": "経験は良かったが、もし私が"}, {"type": "subtitle", "time": 5937.27, "timestamp": "01:38:57", "text": "例えば6時間以上待つ"}, {"type": "subtitle", "time": 5939.91, "timestamp": "01:38:59", "text": "8k 6 の方がもっと腹が立つだろう"}]
[{"type": "subtitle", "time": 1747.549, "timestamp": "00:29:07", "text": "[音楽]"}, {"type": "subtitle", "time": 1780.389, "timestamp": "00:29:40", "text": "日本語。私は遺物を忘れた"}, {"type": "subtitle", "time": 1793.99, "timestamp": "00:29:53", "text": "待って、日本のゴブリンの歌を作ったのは誰？"}, {"type": "subtitle", "time": 1796.43, "timestamp": "00:29:56", "text": "また？私"}, {"type": "subtitle", "time": 1798.87, "timestamp": "00:29:58", "text": "忘れた。あ、待って。私はグーグルで検索していました"}]
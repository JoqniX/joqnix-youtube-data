[{"type": "subtitle", "time": 4920.87, "timestamp": "01:22:00", "text": "事実を受け入れるのに長い時間がかかる"}, {"type": "subtitle", "time": 4923.35, "timestamp": "01:22:03", "text": "ある意味、私は完全に一人ぼっちになるだろう。私"}, {"type": "subtitle", "time": 4926.87, "timestamp": "01:22:06", "text": "自分のドリモンも自分のものも持っていません"}, {"type": "subtitle", "time": 4929.189, "timestamp": "01:22:09", "text": "想像上の友達。たとえ私が持っていたとしても"}, {"type": "subtitle", "time": 4931.43, "timestamp": "01:22:11", "text": "私が子供の頃に作った想像上の友達"}, {"type": "subtitle", "time": 4934.39, "timestamp": "01:22:14", "text": "一人だが、それでも"}, {"type": "subtitle", "time": 4936.47, "timestamp": "01:22:16", "text": "ああ、そう、あなたはあなたの"}, {"type": "chat", "time": 4936.521, "timestamp": "01:22:16", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "you can be your own doremon"}, {"type": "subtitle", "time": 4938.27, "timestamp": "01:22:18", "text": "自分の"}, {"type": "subtitle", "time": 4941.83, "timestamp": "01:22:21", "text": "えっと、人物とか主人公とか、そういうやつ。"}, {"type": "subtitle", "time": 4944.39, "timestamp": "01:22:24", "text": "あなたは自分の人生を生きている。あなたはそうするかもしれない"}, {"type": "chat", "time": 4946.147, "timestamp": "01:22:26", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "be your own best friend"}, {"type": "subtitle", "time": 4946.47, "timestamp": "01:22:26", "text": "人と出会うかもしれないし、出会わないかもしれない。"}, {"type": "subtitle", "time": 4950.31, "timestamp": "01:22:30", "text": "人生とはそういうものだ、えっと、刻み込むんだ"}, {"type": "subtitle", "time": 4951.91, "timestamp": "01:22:31", "text": "あなたのために何かしているのかもしれません。それは運命ではなく、"}, {"type": "chat", "time": 4954.14, "timestamp": "01:22:34", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "be your own strength yay"}, {"type": "subtitle", "time": 4954.39, "timestamp": "01:22:34", "text": "それでも運命を操ったり、好きになったりすることはできます"}, {"type": "chat", "time": 4955.638, "timestamp": "01:22:35", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "zen is imaginary too"}, {"type": "subtitle", "time": 4956.47, "timestamp": "01:22:36", "text": "自分のやりたいことをやりなさい。まあ、そうですね。"}, {"type": "subtitle", "time": 4959.27, "timestamp": "01:22:39", "text": "超能力に関して言えば、まず"}, {"type": "subtitle", "time": 4961.11, "timestamp": "01:22:41", "text": "小さな子供よ、私が望んでいたことは"}, {"type": "subtitle", "time": 4963.669, "timestamp": "01:22:43", "text": "人々を助けることや、あらゆること"}, {"type": "subtitle", "time": 4967.59, "timestamp": "01:22:47", "text": "そこには全てがあった。うん。 2番目の10代"}, {"type": "subtitle", "time": 4971.75, "timestamp": "01:22:51", "text": "賢明な私なら、10代の頃の私はこう言うだろう"}, {"type": "subtitle", "time": 4975.189, "timestamp": "01:22:55", "text": "できればいいのに"}, {"type": "subtitle", "time": 4978.07, "timestamp": "01:22:58", "text": "えーっと、タイムスリップするには超能力が必要だ"}]
[{"type": "subtitle", "time": 5101.51, "timestamp": "01:25:01", "text": "それは、"}, {"type": "chat", "time": 5101.82, "timestamp": "01:25:01", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "its your opinion 👍"}, {"type": "subtitle", "time": 5104.47, "timestamp": "01:25:04", "text": "自分。うん。たとえ私がそうしなかったとしても"}, {"type": "subtitle", "time": 5106.39, "timestamp": "01:25:06", "text": "超能力を手放すことに抵抗はない"}, {"type": "subtitle", "time": 5109.99, "timestamp": "01:25:09", "text": "受け取ったもの、または何か。うん。私はただ"}, {"type": "subtitle", "time": 5113.189, "timestamp": "01:25:13", "text": "大切な人たちと一緒にそこにいて、"}, {"type": "subtitle", "time": 5115.03, "timestamp": "01:25:15", "text": "彼らと時間を過ごしたり、その他すべて"}, {"type": "subtitle", "time": 5117.99, "timestamp": "01:25:17", "text": "たとえあなたが知っているとしても幸せになる"}, {"type": "chat", "time": 5120.728, "timestamp": "01:25:20", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "👏👏👏"}, {"type": "subtitle", "time": 5121.11, "timestamp": "01:25:21", "text": "まるでスーパーマンみたいな力を持っていた"}, {"type": "subtitle", "time": 5125.75, "timestamp": "01:25:25", "text": "より高いところに行くのではなく"}, {"type": "subtitle", "time": 5129.27, "timestamp": "01:25:29", "text": "社会レベルのリーグ、またはそれに近いもの、または"}, {"type": "subtitle", "time": 5131.189, "timestamp": "01:25:31", "text": "金持ちになるとか、"}, {"type": "subtitle", "time": 5133.27, "timestamp": "01:25:33", "text": "たくさんのことをして破壊する"}, {"type": "subtitle", "time": 5134.87, "timestamp": "01:25:34", "text": "私が望んでいないのはただ"}, {"type": "subtitle", "time": 5137.149, "timestamp": "01:25:37", "text": "大切な人を守る"}, {"type": "subtitle", "time": 5140.149, "timestamp": "01:25:40", "text": "主に映画やその他から"}, {"type": "subtitle", "time": 5143.11, "timestamp": "01:25:43", "text": "そう、スーパーヒーローにとっては難しいだろう"}, {"type": "subtitle", "time": 5145.27, "timestamp": "01:25:45", "text": "愛する人を守るヒーロー"}, {"type": "subtitle", "time": 5148.31, "timestamp": "01:25:48", "text": "最終的には、あなたはプロです"}, {"type": "subtitle", "time": 5151.669, "timestamp": "01:25:51", "text": "彼らを危険にさらすことになるので、私はこう言うでしょう"}, {"type": "subtitle", "time": 5155.83, "timestamp": "01:25:55", "text": "ああ、もしそれが私にとって諦めることを意味するなら"}, {"type": "subtitle", "time": 5158.47, "timestamp": "01:25:58", "text": "人々の幸福のために"}]
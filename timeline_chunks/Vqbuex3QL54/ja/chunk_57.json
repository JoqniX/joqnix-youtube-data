[{"type": "subtitle", "time": 3421.03, "timestamp": "00:57:01", "text": "彼らはほとんど踊っているような感じだった"}, {"type": "subtitle", "time": 3424.75, "timestamp": "00:57:04", "text": "ダンサーみたいに感じるよね、私もこんな気持ち"}, {"type": "subtitle", "time": 3427.27, "timestamp": "00:57:07", "text": "ヒンディー語のニックネームは理解できますか？"}, {"type": "subtitle", "time": 3429.43, "timestamp": "00:57:09", "text": "先輩？ええ、理解できます"}, {"type": "subtitle", "time": 3431.27, "timestamp": "00:57:11", "text": "範囲。さて、これが私です"}, {"type": "chat", "time": 3433.292, "timestamp": "00:57:13", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "or just turn into a warewolf 🐺 thoughts?"}, {"type": "subtitle", "time": 3440.47, "timestamp": "00:57:20", "text": "わかった。ダンスが好きなので"}, {"type": "subtitle", "time": 3442.39, "timestamp": "00:57:22", "text": "ほら、私が思うにこれは"}, {"type": "subtitle", "time": 3444.069, "timestamp": "00:57:24", "text": "これは、"}, {"type": "subtitle", "time": 3446.23, "timestamp": "00:57:26", "text": "もう一度全部、つまり、あの"}, {"type": "chat", "time": 3447.229, "timestamp": "00:57:27", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "🐺"}, {"type": "subtitle", "time": 3447.75, "timestamp": "00:57:27", "text": "前回のパンデミックのように、"}, {"type": "subtitle", "time": 3452.15, "timestamp": "00:57:32", "text": "バナナブレッドとダロナコーヒーのようなもの"}, {"type": "subtitle", "time": 3454.39, "timestamp": "00:57:34", "text": "熱狂とダンス熱。もしそうなったら"}, {"type": "subtitle", "time": 3457.19, "timestamp": "00:57:37", "text": "もう一度やってみます。うん。私は私は"}, {"type": "subtitle", "time": 3459.789, "timestamp": "00:57:39", "text": "ダンスを習い始めるつもりです。"}, {"type": "subtitle", "time": 3462.87, "timestamp": "00:57:42", "text": "うん。踊りたいですか？"}, {"type": "subtitle", "time": 3466.789, "timestamp": "00:57:46", "text": "次の先輩は？ああ、私は学んだ"}, {"type": "subtitle", "tim
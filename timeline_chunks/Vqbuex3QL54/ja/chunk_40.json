[{"type": "subtitle", "time": 2400.75, "timestamp": "00:40:00", "text": "端や障害物。"}, {"type": "subtitle", "time": 2403.67, "timestamp": "00:40:03", "text": "わかった。ゴミ箱は削除するために表示されます"}, {"type": "subtitle", "time": 2405.75, "timestamp": "00:40:05", "text": "それらに触れる旅は"}, {"type": "subtitle", "time": 2408.15, "timestamp": "00:40:08", "text": "誰かを失敗させる。ステージセクションを移動"}, {"type": "subtitle", "time": 2410.55, "timestamp": "00:40:10", "text": "進路を変えてストレッチを避ける"}, {"type": "subtitle", "time": 2411.87, "timestamp": "00:40:11", "text": "彼は"}, {"type": "subtitle", "time": 2415.31, "timestamp": "00:40:15", "text": "行き先。何が"}, {"type": "subtitle", "time": 2418.15, "timestamp": "00:40:18", "text": "これ？本当に小さなイベントです。しないで"}, {"type": "subtitle", "time": 2420.349, "timestamp": "00:40:20", "text": "心配。"}, {"type": "subtitle", "time": 2427.03, "timestamp": "00:40:27", "text": "待って。 2段階を選択する"}, {"type": "subtitle", "time": 2437.829, "timestamp": "00:40:37", "text": "ああ、こんな感じ。わかった。わかった。わかった。うん。私"}, {"type": "subtitle", "time": 2439.63, "timestamp": "00:40:39", "text": "それをドラッグしてください。"}, {"type": "subtitle", "time": 2441.46, "timestamp": "00:40:41", "text": "わかった。ああ、これは"}, {"type": "subtitle", "time": 2444.589, "timestamp": "00:40:44", "text": "[音楽]"}, {"type": "subtitle", "time": 2447.98, "timestamp": "00:40:47", "text": "いいね。でも、スピードランができたらいいなと思っています。"}, {"type": "subtitle", "time": 2451.63, "timestamp": "00:40:51", "text": "[音楽]"}, {"type": "subtitle", "time": 2454.589, "timestamp": "00:40:54", "text": "これ。ああ、私は"}]
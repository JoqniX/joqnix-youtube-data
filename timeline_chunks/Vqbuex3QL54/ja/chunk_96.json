[{"type": "subtitle", "time": 5761.79, "timestamp": "01:36:01", "text": "私にとって重要です。まるで私が、まるで私が"}, {"type": "subtitle", "time": 5764.87, "timestamp": "01:36:04", "text": "そんな風に友達を作らないで"}, {"type": "subtitle", "time": 5767.27, "timestamp": "01:36:07", "text": "私はとても用心深いです。"}, {"type": "subtitle", "time": 5769.43, "timestamp": "01:36:09", "text": "あなたが知っている人、私が知っている人、でもあなたが知らない人"}, {"type": "subtitle", "time": 5771.91, "timestamp": "01:36:11", "text": "たくさんの友達と、誰かが"}, {"type": "subtitle", "time": 5774.39, "timestamp": "01:36:14", "text": "私にとって重要になるのは"}, {"type": "subtitle", "time": 5776.07, "timestamp": "01:36:16", "text": "なぜ私はあまり友達を作れないのか"}, {"type": "subtitle", "time": 5778.39, "timestamp": "01:36:18", "text": "なぜなら、もし人が"}, {"type": "subtitle", "time": 5780.229, "timestamp": "01:36:20", "text": "私にとって彼らの戦いは私の"}, {"type": "subtitle", "time": 5782.229, "timestamp": "01:36:22", "text": "誰かが手を出したらすぐに戦う"}, {"type": "subtitle", "time": 5785.43, "timestamp": "01:36:25", "text": "あなた、私はあの他の人を許さない"}, {"type": "subtitle", "time": 5786.95, "timestamp": "01:36:26", "text": "知ってるけど、私はあなたを守ろうとする"}, {"type": "subtitle", "time": 5789.27, "timestamp": "01:36:29", "text": "あらゆる方法で可能であり、もしあなたが"}, {"type": "subtitle", "time": 5791.03, "timestamp": "01:36:31", "text": "ニック先輩、あなたは私の"}, {"type": "chat", "time": 5791.773, "timestamp": "01:36:31", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "👏👏"}, {"type": "subtitle", "time": 5792.629, "timestamp": "01:36:32", "text": "友達の権利と、もし誰かが"}, {"type": "subtitle", "time": 5795.189, "timestamp": "01:36:35", "text": "あなたを虐待しているのに、あなたは"}, {"type": "subtitle", "time": 5796.95, "timestamp": "01:36:36", "text": "あなたたちはとても仲が良いから、それを見ることができるのです"}, {"type": "subtitle", "time": 5799.91, "timestamp": "01:36:39", "text": "彼らと一緒にいると、好きになれないという結果になるだろう"}, {"type": "subtitle", "time": 5801.91, "timestamp": "01:36:41", "text": "あなたを虐待している人"}, {"type": "subtitle", "time": 5804.39, "timestamp": "01:36:44", "text": "私は友達が好きじゃないから"}, {"type": "subtitle", "time": 5806.229, "timestamp": "01:36:46", "text": "そんな風に扱われるのは、"}, {"type": "subtitle", "time": 5808.31, "timestamp": "01:36:48", "text": "もちろん、私にできることはあまりありません"}, {"type": "subtitle", "time": 5809.669, "timestamp": "01:36:49", "text": "でも、もしあなたがその人のことを大切に思っているなら"}, {"type": "subtitle", "time": 5812.07, "timestamp": "01:36:52", "text": "私はただ「わかった、わかった」と言うだけですが"}, {"type": "subtitle", "time": 5814.07, "timestamp": "01:36:54", "text": "心の中では「いや、君は知ってるよ」って思うだろう"}, {"type": "subtitle", "time": 5817.27, "timestamp": "01:36:57", "text": "私の友達にそんな風に接しないでよ"}, {"type": "subtitle", "time": 5818.59, "timestamp": "01:36:58", "text": "わかった"}]
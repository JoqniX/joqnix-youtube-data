[{"type": "subtitle", "time": 14282.67, "timestamp": "03:58:02", "text": "行く？彼がまだ"}, {"type": "subtitle", "time": 14285.91, "timestamp": "03:58:05", "text": "上。なぜあなたはそこに長居しているのですか"}, {"type": "subtitle", "time": 14290.469, "timestamp": "03:58:10", "text": "屋上？バカだな。ああ、なんてことだ、"}, {"type": "subtitle", "time": 14298.95, "timestamp": "03:58:18", "text": "槍。よし、カットシーンが始まった"}, {"type": "subtitle", "time": 14316.349, "timestamp": "03:58:36", "text": "これは"}, {"type": "subtitle", "time": 14322.03, "timestamp": "03:58:42", "text": "えっと、原神の剣の水の少年"}, {"type": "subtitle", "time": 14325.11, "timestamp": "03:58:45", "text": "本。忘れた"}, {"type": "subtitle", "time": 14333.229, "timestamp": "03:58:53", "text": "そう、栄光とは"}, {"type": "subtitle", "time": 14335.59, "timestamp": "03:58:55", "text": "あなたの。はい、これで終わりです"}]
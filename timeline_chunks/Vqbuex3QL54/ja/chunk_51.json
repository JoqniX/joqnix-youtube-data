[{"type": "subtitle", "time": 3061.39, "timestamp": "00:51:01", "text": "待って、ちょっと待って。"}, {"type": "subtitle", "time": 3064.95, "timestamp": "00:51:04", "text": "人生って、時として本当に不公平だ。所有"}, {"type": "subtitle", "time": 3066.47, "timestamp": "00:51:06", "text": "の上。持続する。持続する。持続する。黙れ。"}, {"type": "subtitle", "time": 3076.47, "timestamp": "00:51:16", "text": "時間。何てことだ。だった"}, {"type": "subtitle", "time": 3079.19, "timestamp": "00:51:19", "text": "えっと、ヘッドパッドかハートの絵文字は使えますか？"}, {"type": "subtitle", "time": 3081.75, "timestamp": "00:51:21", "text": "チャットでは？青いハート"}, {"type": "subtitle", "time": 3085.03, "timestamp": "00:51:25", "text": "ゼンが感じるようにチャットに絵文字を入れる"}, {"type": "chat", "time": 3089.692, "timestamp": "00:51:29", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "💙💙💙💙💙"}, {"type": "chat", "time": 3093.022, "timestamp": "00:51:33", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "❤"}, {"type": "subtitle", "time": 3094.15, "timestamp": "00:51:34", "text": "えっと、もし皆さんが"}, {"type": "subtitle", "time": 3105.63, "timestamp": "00:51:45", "text": "こんにちは、おかえりなさい。本当にありがとうございます"}, {"type": "subtitle", "time": 3107.91, "timestamp": "00:51:47", "text": "多くの。知ってる？"}, {"type": "chat", "time": 3109.006, "timestamp": "00:51:49", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "💙💙💙💙"}, {"type": "subtitle", "time": 3111.67, "timestamp": "00:51:51", "text": "えっと、その理論って何ですか？"}, {"type": "chat", "time": 3112.91, "timestamp": "00:51:52", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "💙💙💙💙💙💙"}, {"type": "subtitle", "time": 3113.829, "timestamp": "00:51:53", "text": "あれは何でしょう？持続する。私はそれが"}, {"type": "subtitle", "time": 3119.109, "timestamp": "00:51:59", "text": "[音楽]"}]
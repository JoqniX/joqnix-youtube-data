[{"type": "subtitle", "time": 17589.99, "timestamp": "04:53:09", "text": "神。何てことだ。私は死んだ。私は死んだ。私は"}, {"type": "subtitle", "time": 17609.51, "timestamp": "04:53:29", "text": "何てことだ。だめだ。死なないで。"}, {"type": "subtitle", "time": 17611.11, "timestamp": "04:53:31", "text": "何てことだ。治してください。治してください。治してください。"}, {"type": "subtitle", "time": 17619.07, "timestamp": "04:53:39", "text": "ああ、"}, {"type": "subtitle", "time": 17623.35, "timestamp": "04:53:43", "text": "神。あと少しだったのに。"}, {"type": "subtitle", "time": 17626.39, "timestamp": "04:53:46", "text": "何てことだ。"}]
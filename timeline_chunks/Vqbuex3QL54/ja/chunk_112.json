[{"type": "subtitle", "time": 6722.109, "timestamp": "01:52:02", "text": "はるかに"}, {"type": "subtitle", "time": 6725.27, "timestamp": "01:52:05", "text": "私には見えないから、ある意味すごい"}, {"type": "subtitle", "time": 6727.75, "timestamp": "01:52:07", "text": "もう一度確認して、私が何をしくじったのか"}, {"type": "subtitle", "time": 6730.79, "timestamp": "01:52:10", "text": "あのビデオだけど、私の心の中では、それはクソだ"}, {"type": "subtitle", "time": 6733.51, "timestamp": "01:52:13", "text": "完璧。だから、とても"}, {"type": "subtitle", "time": 6735.03, "timestamp": "01:52:15", "text": "悲しい展開だけど、私には見えない"}, {"type": "subtitle", "time": 6737.109, "timestamp": "01:52:17", "text": "もう一度確認しましたが、持っていません。私の心の中で"}, {"type": "subtitle", "time": 6740.31, "timestamp": "01:52:20", "text": "それはまるで私の"}, {"type": "subtitle", "time": 6742.87, "timestamp": "01:52:22", "text": "まるで、あの作家を知っているかのように"}, {"type": "subtitle", "time": 6745.35, "timestamp": "01:52:25", "text": "太陽も昇る 太陽も昇る"}, {"type": "subtitle", "time": 6747.75, "timestamp": "01:52:27", "text": "えっと、作者のレオを忘れたと思う"}, {"type": "subtitle", "time": 6750.47, "timestamp": "01:52:30", "text": "知らないが、彼はこの原稿を書いた"}, {"type": "subtitle", "time": 6751.75, "timestamp": "01:52:31", "text": "長い間満たされていた右"}, {"type": "subtitle", "time": 6753.27, "timestamp": "01:52:33", "text": "これはご存知の通りブリーフケースに入っています"}, {"type": "subtitle", "time": 6756.47, "timestamp": "01:52:36", "text": "それで彼は電車の中でそれをなくした"}, {"type": "subtitle", "time": 6759.43, "timestamp": "01:52:39", "text": "まるで彼の作品全体のように"}, {"type": "subtitle", "time": 6761.91, "timestamp": "01:52:41", "text": "年、月、週、またはどんな仕事でも"}, {"type": "subtitle", "time": 6764.149, "timestamp": "01:52:44", "text": "努力とかそういうこと全部で、"}, {"type": "subtitle", "time": 6765.91, "timestamp": "01:52:45", "text": "ペンと紙のようなものを持っていた"}, {"type": "subtitle", "time": 6768.87, "timestamp": "01:52:48", "text": "それら全てが消え去った。失われた"}, {"type": "subtitle", "time": 6772.39, "timestamp": "01:52:52", "text": "完全に。しかし、それがどういうわけか彼に"}, {"type": "subtitle", "time": 6775.03, "timestamp": "01:52:55", "text": "傑作を書くための推進力"}, {"type": "subtitle", "time": 6777.669, "timestamp": "01:52:57", "text": "それは太陽が昇るようなものだ。つまり私は"}, {"type": "subtitle", "time": 6779.35, "timestamp": "01:52:59", "text": "そういう啓示のようなものはなかった。"}]
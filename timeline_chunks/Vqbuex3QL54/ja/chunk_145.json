[{"type": "subtitle", "time": 8702.87, "timestamp": "02:25:02", "text": "入ります。あなたは禅の息子を逃しました。私たちは"}, {"type": "subtitle", "time": 8705.27, "timestamp": "02:25:05", "text": "コラボしたばかりです。私たちは楽しんでいました。"}, {"type": "subtitle", "time": 8708.03, "timestamp": "02:25:08", "text": "私たちはたくさんのことについて話していました"}, {"type": "subtitle", "time": 8716.79, "timestamp": "02:25:16", "text": "Dさん、お時間を割いて来てくださりありがとうございます。"}, {"type": "subtitle", "time": 8724.79, "timestamp": "02:25:24", "text": "多く。だからダナ、今まさに実感したんだ"}, {"type": "subtitle", "time": 8726.469, "timestamp": "02:25:26", "text": "私が話していたこと、私が話していたこと"}, {"type": "subtitle", "time": 8728.75, "timestamp": "02:25:28", "text": "あらゆることを考えて"}, {"type": "subtitle", "time": 8736.309, "timestamp": "02:25:36", "text": "はぁ？心配しないで、正式に"}, {"type": "subtitle", "time": 8739.349, "timestamp": "02:25:39", "text": "ある日、配信中に泣いてしまった。ええと、今週は、"}, {"type": "subtitle", "time": 8741.349, "timestamp": "02:25:41", "text": "今週。 6月の第3週。しないで"}, {"type": "subtitle", "time": 8744.63, "timestamp": "02:25:44", "text": "心配。ああ、でも結局"}, {"type": "subtitle", "time": 8746.349, "timestamp": "02:25:46", "text": "コラボレーションは"}, {"type": "subtitle", "time": 8749.349, "timestamp": "02:25:49", "text": "完了しました。ええ、これが"}, {"type": "subtitle", "time": 8752.15, "timestamp": "02:25:52", "text": "ジョッカソンの最後の月。それは"}, {"type": "subtitle", "time": 8754.95, "timestamp": "02:25:54", "text": "ある意味、ジョッカソンの終わりと言えるだろう。それは"}, {"type": "subtitle", "time": 8758.23, "timestamp": "02:25:58", "text": "なぜそれが白いのか、純白の親指の爪のような色なのか。"}, {"type": "subtitle", "time": 8759.87, "timestamp": "02:25:59", "text": "もしあなたが"}]
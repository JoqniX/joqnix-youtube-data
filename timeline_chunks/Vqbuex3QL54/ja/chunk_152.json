[{"type": "subtitle", "time": 9121.71, "timestamp": "02:32:01", "text": "それらと生活に追いついて"}, {"type": "subtitle", "time": 9125.429, "timestamp": "02:32:05", "text": "すべて。うん。そして夜900"}, {"type": "subtitle", "time": 9128.71, "timestamp": "02:32:08", "text": "午後私たちはMinecraft Bedw Warsを持っています。"}, {"type": "subtitle", "time": 9133.63, "timestamp": "02:32:13", "text": "赤村は私と富士に教えてくれるだろう"}, {"type": "subtitle", "time": 9137.469, "timestamp": "02:32:17", "text": "カイラがプレイする"}, {"type": "subtitle", "time": 9141.19, "timestamp": "02:32:21", "text": "ベッドウォーズ。つまり、ある意味ではグループと言えるでしょう。それ"}, {"type": "subtitle", "time": 9143.99, "timestamp": "02:32:23", "text": "グループでの共同作業となった。最初は"}, {"type": "subtitle", "time": 9146.87, "timestamp": "02:32:26", "text": "一人きりの時間が欲しい"}, {"type": "subtitle", "time": 9152.55, "timestamp": "02:32:32", "text": "赤村あかちゃん、でも大丈夫。ええ、そうです"}, {"type": "subtitle", "time": 9155.63, "timestamp": "02:32:35", "text": "つまり、私はソロで個人コラボレーションを行った"}, {"type": "subtitle", "time": 9157.95, "timestamp": "02:32:37", "text": "富士と"}, {"type": "subtitle", "time": 9160.79, "timestamp": "02:32:40", "text": "えっと、ソロをやります"}, {"type": "subtitle", "time": 9164.55, "timestamp": "02:32:44", "text": "Kraとの個別コラボレーションも行っています。うん"}, {"type": "subtitle", "time": 9165.63, "timestamp": "02:32:45", "text": "そこには"}, {"type": "subtitle", "time": 9169.11, "timestamp": "02:32:49", "text": "それ。えっと、水曜日にはハンがいます"}, {"type": "subtitle", "time": 9172.63, "timestamp": "02:32:52", "text": "ハンスオン。水曜日はハンハンです。私は"}, {"type": "subtitle", "time": 9174.63, "timestamp": "02:32:54", "text": "他の人も入れようと考えている"}, {"type": "subtitle", "time": 9177.469, "timestamp": "02:32:57", "text": "夜の枠と"}]
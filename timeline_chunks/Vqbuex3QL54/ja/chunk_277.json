[{"type": "subtitle", "time": 16622.07, "timestamp": "04:37:02", "text": "[音楽]"}, {"type": "subtitle", "time": 16625.029, "timestamp": "04:37:05", "text": "ああ、武器の進行は"}, {"type": "subtitle", "time": 16628.949, "timestamp": "04:37:08", "text": "Apexが現在持っているもの。わかった、"}, {"type": "subtitle", "time": 16637.39, "timestamp": "04:37:17", "text": "待てよ、この銃、試射したことあったっけ？"}, {"type": "subtitle", "time": 16640.869, "timestamp": "04:37:20", "text": "わかりました。これはまだ試していません。血"}, {"type": "subtitle", "time": 16642.909, "timestamp": "04:37:22", "text": "切り裂く者。"}, {"type": "subtitle", "time": 16652.789, "timestamp": "04:37:32", "text": "おお。"}, {"type": "subtitle", "time": 16654.709, "timestamp": "04:37:34", "text": "ああ、こうやって肌の選び方をするんですね。おお、"}, {"type": "subtitle", "time": 16655.79, "timestamp": "04:37:35", "text": "わかった。"}, {"type": "subtitle", "time": 16665.39, "timestamp": "04:37:45", "text": "何？これ"}, {"type": "subtitle", "time": 16668.99, "timestamp": "04:37:48", "text": "1つ。そうしよう。 SP。おお。"}, {"type": "subtitle", "time": 16670.31, "timestamp": "04:37:50", "text": "[音楽]"}, {"type": "subtitle", "time": 16678.39, "timestamp": "04:37:58", "text": "彼らは皮を激しく剥がした。"}, {"type": "subtitle", "time": 16679.75, "timestamp": "04:37:59", "text": "[音楽]"}]
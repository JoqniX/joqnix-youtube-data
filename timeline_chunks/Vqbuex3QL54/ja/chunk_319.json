[{"type": "subtitle", "time": 19140.628, "timestamp": "05:19:00", "text": "ウォンオープン。メイン画面で開きます"}, {"type": "subtitle", "time": 19142.708, "timestamp": "05:19:02", "text": "奇妙なことに、カナリアではなく"}, {"type": "subtitle", "time": 19144.47, "timestamp": "05:19:04", "text": "理由。"}, {"type": "subtitle", "time": 19148.868, "timestamp": "05:19:08", "text": "ああ、わかった。私はそれをしました。拘束されていない。私は必要としている"}, {"type": "subtitle", "time": 19152.788, "timestamp": "05:19:12", "text": "わかりました。ニースのアカウント。"}, {"type": "subtitle", "time": 19156.59, "timestamp": "05:19:16", "text": "待って、ネット口座持ってるよ"}, {"type": "subtitle", "time": 19159.43, "timestamp": "05:19:19", "text": "けれど。私はネット口座を持っていたことを覚えています。"}, {"type": "subtitle", "time": 19161.47, "timestamp": "05:19:21", "text": "小切手1枚。私にさせて"}, {"type": "subtitle", "time": 19164.39, "timestamp": "05:19:24", "text": "ぼやけてるけど、Twitchのことは覚えてる"}, {"type": "subtitle", "time": 19167.75, "timestamp": "05:19:27", "text": "プライムとかそういう類。私は物を持っています。だから、"}, {"type": "subtitle", "time": 19170.788, "timestamp": "05:19:30", "text": "こうあるべきですよね？私は思う。お願いします"}, {"type": "subtitle", "time": 19172.868, "timestamp": "05:19:32", "text": "教えて。アカウントを持っていません"}, {"type": "subtitle", "time": 19174.75, "timestamp": "05:19:34", "text": "さもないと"}, {"type": "subtitle", "time": 19178.51, "timestamp": "05:19:38", "text": "泣く。アカウントが存在しません。ああ、"}, {"type": "subtitle", "time": 19182.51, "timestamp": "05:19:42", "text": "神。冗談でしょ？"}, {"type": "subtitle", "time": 19185.39, "timestamp": "05:19:45", "text": "今？冗談ですか"}, {"type": "subtitle", "time": 19194.73, "timestamp": "05:19:54", "text": "何？アカウントは持っていたんだけどね。"}, {"type": "subtitle", "time": 19195.948, "timestamp": "05:19:55", "text": "[音楽]"}, {"type": "subtitle", "time": 19199.27, "timestamp": "05:19:59", "text": "何？はぁ？"}]
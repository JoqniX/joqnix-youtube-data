[{"type": "subtitle", "time": 11769.99, "timestamp": "03:16:09", "text": "8月。大丈夫。今でもそう感じる"}, {"type": "subtitle", "time": 11771.91, "timestamp": "03:16:11", "text": "このような"}, {"type": "subtitle", "time": 11775.87, "timestamp": "03:16:15", "text": "えっと、毎日が本当に過ぎていく"}, {"type": "subtitle", "time": 11777.55, "timestamp": "03:16:17", "text": "素早い"}, {"type": "subtitle", "time": 11782.15, "timestamp": "03:16:22", "text": "さっきは7月だったんだけど"}, {"type": "subtitle", "time": 11784.55, "timestamp": "03:16:24", "text": "その前の6月は6月だった。"}, {"type": "subtitle", "time": 11788.83, "timestamp": "03:16:28", "text": "もう9月になっているはずだ"}, {"type": "subtitle", "time": 11793.349, "timestamp": "03:16:33", "text": "数ヶ月後、あるいは数日後にはどうなるのでしょうか？"}, {"type": "subtitle", "time": 11797.349, "timestamp": "03:16:37", "text": "あるいはほんの数瞬の時間で、あなたと"}, {"type": "subtitle", "time": 11800.15, "timestamp": "03:16:40", "text": "もう12月か"}, {"type": "subtitle", "time": 11803.63, "timestamp": "03:16:43", "text": "もう来年には。ああ、"}, {"type": "subtitle", "time": 11807.429, "timestamp": "03:16:47", "text": "神。うん。ええと、今日は"}, {"type": "subtitle", "time": 11810.95, "timestamp": "03:16:50", "text": "ナカブレードポイントをプレイ中。これは無料です"}, {"type": "subtitle", "time": 11815.11, "timestamp": "03:16:55", "text": "遊ぶ。これは無料プレイのゲームです。"}, {"type": "subtitle", "time": 11817.67, "timestamp": "03:16:57", "text": "それって何？武道"}]
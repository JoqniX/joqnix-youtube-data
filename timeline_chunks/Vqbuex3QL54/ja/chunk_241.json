[{"type": "subtitle", "time": 14461.15, "timestamp": "04:01:01", "text": "[音楽]"}, {"type": "subtitle", "time": 14466.71, "timestamp": "04:01:06", "text": "くそ、君のレベルは十分高くない"}, {"type": "subtitle", "time": 14468.429, "timestamp": "04:01:08", "text": "秋。ええ、そうでした"}, {"type": "subtitle", "time": 14478.18, "timestamp": "04:01:18", "text": "する必要がある"}, {"type": "subtitle", "time": 14481.07, "timestamp": "04:01:21", "text": "[音楽]"}, {"type": "subtitle", "time": 14490.429, "timestamp": "04:01:30", "text": "彼女は巧妙なユーザーだ。私はステルスで"}, {"type": "subtitle", "time": 14492.69, "timestamp": "04:01:32", "text": "私自身が"}, {"type": "subtitle", "time": 14496.75, "timestamp": "04:01:36", "text": "[音楽]"}, {"type": "subtitle", "time": 14506.21, "timestamp": "04:01:46", "text": "走る。"}, {"type": "subtitle", "time": 14519.269, "timestamp": "04:01:59", "text": "おお。拳銃を使った武術。ああ、できるよ"}]
[{"type": "subtitle", "time": 14940.87, "timestamp": "04:09:00", "text": "それは何ですか？"}, {"type": "subtitle", "time": 14942.75, "timestamp": "04:09:02", "text": "何が"}, {"type": "subtitle", "time": 14950.349, "timestamp": "04:09:10", "text": "よお、何"}, {"type": "subtitle", "time": 14953.83, "timestamp": "04:09:13", "text": "私は何を得たのですか？インスタグラムは多くの人を死に至らしめた。"}]
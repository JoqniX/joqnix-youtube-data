[{"type": "subtitle", "time": 11168.91, "timestamp": "03:06:08", "text": "うん。何"}, {"type": "subtitle", "time": 11172.71, "timestamp": "03:06:12", "text": "あのね？君たちは"}, {"type": "subtitle", "time": 11176.15, "timestamp": "03:06:16", "text": "仕事の話を聞きながら"}, {"type": "subtitle", "time": 11178.55, "timestamp": "03:06:18", "text": "のように"}, {"type": "subtitle", "time": 11181.309, "timestamp": "03:06:21", "text": "えっと、それとも、私にこうしてほしいですか？"}, {"type": "subtitle", "time": 11185.75, "timestamp": "03:06:25", "text": "あなたを乗せて、私だけを"}, {"type": "subtitle", "time": 11189.59, "timestamp": "03:06:29", "text": "自分のもの、あるいは何か？わからない。する"}, {"type": "subtitle", "time": 11190.97, "timestamp": "03:06:30", "text": "私に何をしてほしいですか？"}, {"type": "subtitle", "time": 11195.309, "timestamp": "03:06:35", "text": "[音楽]"}]
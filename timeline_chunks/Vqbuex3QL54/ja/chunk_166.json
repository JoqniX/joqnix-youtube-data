[{"type": "subtitle", "time": 9965.15, "timestamp": "02:46:05", "text": "させて"}, {"type": "subtitle", "time": 9969.11, "timestamp": "02:46:09", "text": "ニース。わかった。えっと、Pに行って来てください"}, {"type": "subtitle", "time": 9971.23, "timestamp": "02:46:11", "text": "戻る。わかった。私のアイドルのところへ行かせてください"}, {"type": "subtitle", "time": 9973.99, "timestamp": "02:46:13", "text": "ミーティング。新しいのを作らなきゃいけないんだよ、兄弟。"}, {"type": "subtitle", "time": 9985.7, "timestamp": "02:46:25", "text": "1つ。新しいことをする必要がある"}, {"type": "subtitle", "time": 9987.95, "timestamp": "02:46:27", "text": "[音楽]"}, {"type": "subtitle", "time": 9993.03, "timestamp": "02:46:33", "text": "実行する前に一つ。えっと、連絡先が必要なんです"}, {"type": "subtitle", "time": 9996.95, "timestamp": "02:46:36", "text": "えっと、サポートに連絡すればいいんですよね？ 1秒。"}, {"type": "subtitle", "time": 10000.03, "timestamp": "02:46:40", "text": "俺の領域だよ、兄弟。私の"}, {"type": "subtitle", "time": 10002.55, "timestamp": "02:46:42", "text": "ドメイン。一体どうやって連絡すればいいの？"}, {"type": "subtitle", "time": 10008.51, "timestamp": "02:46:48", "text": "ヘルプ。よし。郵便"}, {"type": "subtitle", "time": 10018.269, "timestamp": "02:46:58", "text": "[音楽]"}]
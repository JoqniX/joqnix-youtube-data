[{"type": "subtitle", "time": 9602.87, "timestamp": "02:40:02", "text": "XD。何てことだ。閉じ込められたことを想像してみてください"}, {"type": "subtitle", "time": 9613.11, "timestamp": "02:40:13", "text": "デートはしない。えっと、最後の週は"}, {"type": "subtitle", "time": 9621.23, "timestamp": "02:40:21", "text": "また？ 21歳は私の"}, {"type": "subtitle", "time": 9624.79, "timestamp": "02:40:24", "text": "最終日。えっと、待って、今は"}, {"type": "subtitle", "time": 9630.63, "timestamp": "02:40:30", "text": "83日目ですよね？ 83日目。83。えーと、84、85、"}, {"type": "subtitle", "time": 9633.19, "timestamp": "02:40:33", "text": "86、87、88。"}, {"type": "subtitle", "time": 9640.349, "timestamp": "02:40:40", "text": "89 90 91 92 93 94 95 96 97 98 99"}, {"type": "subtitle", "time": 9646.75, "timestamp": "02:40:46", "text": "[音楽]"}]
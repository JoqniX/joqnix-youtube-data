[{"type": "subtitle", "time": 19083.51, "timestamp": "05:18:03", "text": "うるさい。僚機を強化する。はい、これは"}, {"type": "subtitle", "time": 19090.868, "timestamp": "05:18:10", "text": "わあ、すごいポイントですね。こんにちは、ジョークスです。できますか"}, {"type": "subtitle", "time": 19094.15, "timestamp": "05:18:14", "text": "私をあなたのお手伝いに招待していただけますか？ああ、わかりました。"}, {"type": "subtitle", "time": 19096.35, "timestamp": "05:18:16", "text": "そうします"}, {"type": "subtitle", "time": 19097.38, "timestamp": "05:18:17", "text": "後で。"}, {"type": "subtitle", "time": 19099.07, "timestamp": "05:18:19", "text": "[音楽]"}, {"type": "subtitle", "time": 19102.39, "timestamp": "05:18:22", "text": "ええと、レビューです。"}, {"type": "subtitle", "time": 19105.628, "timestamp": "05:18:25", "text": "ええと、これらは物語の要素みたいなものです。"}, {"type": "subtitle", "time": 19107.628, "timestamp": "05:18:27", "text": "いいえ。"}, {"type": "subtitle", "time": 19115.51, "timestamp": "05:18:35", "text": "楽しい山々。ああ、このアートワークは"}, {"type": "subtitle", "time": 19122.708, "timestamp": "05:18:42", "text": "すばらしい。おお。バインドフルが復活する。これは"}, {"type": "subtitle", "time": 19124.91, "timestamp": "05:18:44", "text": "ある男。ああ、そうするつもりだ"}, {"type": "subtitle", "time": 19133.59, "timestamp": "05:18:53", "text": "アニメーターのことは理解できます。ああ、参加する"}, {"type": "subtitle", "time": 19134.35, "timestamp": "05:18:54", "text": "の"}, {"type": "subtitle", "time": 19137.23, "timestamp": "05:18:57", "text": "シャウク"}]
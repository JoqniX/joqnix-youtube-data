[{"type": "subtitle", "time": 6841.189, "timestamp": "01:54:01", "text": "主要。"}, {"type": "subtitle", "time": 6844.55, "timestamp": "01:54:04", "text": "そして私は気づいた。「ああ、私にもできる」と。その"}, {"type": "subtitle", "time": 6847.91, "timestamp": "01:54:07", "text": "ただ、あなたの、ええ。あなたのように"}, {"type": "subtitle", "time": 6849.669, "timestamp": "01:54:09", "text": "モチベーションとその他すべてが今、重要だ。"}, {"type": "subtitle", "time": 6852.149, "timestamp": "01:54:12", "text": "あなたの環境は重要であり、すべてです。"}, {"type": "subtitle", "time": 6855.03, "timestamp": "01:54:15", "text": "うん。うん。えっと、それは"}, {"type": "subtitle", "time": 6858.31, "timestamp": "01:54:18", "text": "新しいアカウント、あるいは新しい人生の始まりが私にとって"}, {"type": "subtitle", "time": 6861.27, "timestamp": "01:54:21", "text": "そのアカウントのために、私はあまりにも"}, {"type": "subtitle", "time": 6863.91, "timestamp": "01:54:23", "text": "このアカウントのプロフェッショナリスト"}, {"type": "subtitle", "time": 6865.669, "timestamp": "01:54:25", "text": "まるで全てが完璧でなければならないかのように。"}, {"type": "subtitle", "time": 6868.149, "timestamp": "01:54:28", "text": "コンテンツ、ビデオ、音楽は完璧でなければならない"}, {"type": "subtitle", "time": 6871.83, "timestamp": "01:54:31", "text": "そういう類のもの。でも、そうだった"}, {"type": "subtitle", "time": 6874.229, "timestamp": "01:54:34", "text": "私たちは皆、どこかからスタートするのです。"}, {"type": "subtitle", "time": 6876.47, "timestamp": "01:54:36", "text": "そうやって私はセカンドチャンネルを作ったんです"}, {"type": "subtitle", "time": 6879.51, "timestamp": "01:54:39", "text": "そして、それは理解するのに役立ちました。"}, {"type": "subtitle", "time": 6882.79, "timestamp": "01:54:42", "text": "ああ、もし私が持っていたらこうやってやるよ"}, {"type": "subtitle", "time": 6885.47, "timestamp": "01:54:45", "text": "意志と動機と"}, {"type": "subtitle", "time": 6888.47, "timestamp": "01:54:48", "text": "すべて、そしてもしそれなら"}, {"type": "subtitle", "time": 6890.35, "timestamp": "01:54:50", "text": "私にも当てはまるよ、例えば私が負けた場合"}, {"type": "subtitle", "time": 6893.27, "timestamp": "01:54:53", "text": "すべてやり直しても構わない"}, {"type": "subtitle", "time": 6896.149, "timestamp": "01:54:56", "text": "もう一度、またはもっとうまくやって、"}]
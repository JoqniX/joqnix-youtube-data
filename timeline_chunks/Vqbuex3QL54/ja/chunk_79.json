[{"type": "subtitle", "time": 4740.91, "timestamp": "01:19:00", "text": "例えば、親があなたに"}, {"type": "subtitle", "time": 4744.07, "timestamp": "01:19:04", "text": "お金と、感謝の言葉を言う代わりに"}, {"type": "subtitle", "time": 4746.149, "timestamp": "01:19:06", "text": "あなたでも何でも、ただ奪い取るだけです"}, {"type": "subtitle", "time": 4747.91, "timestamp": "01:19:07", "text": "そして自分の好きなことをする"}, {"type": "chat", "time": 4749.306, "timestamp": "01:19:09", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "love you too brother pravin"}, {"type": "subtitle", "time": 4749.75, "timestamp": "01:19:09", "text": "感謝の気持ちを伝える、または感謝の意を示す"}, {"type": "subtitle", "time": 4752.709, "timestamp": "01:19:12", "text": "一生懸命働いてくれてありがとう"}, {"type": "subtitle", "time": 4755.43, "timestamp": "01:19:15", "text": "そして、私にお金をくれるのが好きだけど、"}, {"type": "subtitle", "time": 4758.149, "timestamp": "01:19:18", "text": "あなたに聞くのは難しかったんです。あなた"}, {"type": "subtitle", "time": 4760.229, "timestamp": "01:19:20", "text": "親切心からくれたもの"}, {"type": "subtitle", "time": 4762.55, "timestamp": "01:19:22", "text": "そんな感じ。あなたはそんなこと全部は言わない。"}, {"type": "subtitle", "time": 4764.63, "timestamp": "01:19:24", "text": "それを受け取って自分のことをすればいい"}, {"type": "subtitle", "time": 4768.31, "timestamp": "01:19:28", "text": "それを無視してはいけない。それは"}, {"type": "subtitle", "time": 4770.55, "timestamp": "01:19:30", "text": "取られた？えっと"}, {"type": "subtitle", "time": 4772.63, "timestamp": "01:19:32", "text": "なぜなら、私が知っているように、あなたも知っているように、"}, {"type": "subtitle", "time": 4774.47, "timestamp": "01:19:34", "text": "あなたは西洋の学校に通う"}, {"type": "subtitle", "time": 4776.229, "timestamp": "01:19:36", "text": "そうだ、彼らは「わかった」と言うだろう"}, {"type": "subtitle", "time": 4778.55, "timestamp": "01:19:38", "text": "子供はこうあるべきだ"}, {"type": "subtitle", "time": 4780.55, "timestamp": "01:19:40", "text": "親が持っているものすべてを受け取る権利がある"}, {"type": "subtitle", "time": 4782.709, "timestamp": "01:19:42", "text": "そうだけど、私たちはもっと"}, {"type": "subtitle", "time": 4784.87, "timestamp": "01:19:44", "text": "アジアの学校みたいな感じ"}, {"type": "subtitle", "time": 4786.87, "timestamp": "01:19:46", "text": "思考の中で、私たちは感謝の気持ちを感じます"}, {"type": "subtitle", "time": 4789.75, "timestamp": "01:19:49", "text": "私たちの両親は好きではなかった、なぜなら彼らは"}, {"type": "subtitle", "time": 4791.669, "timestamp": "01:19:51", "text": "私たちにとってはこれで十分で、"}, {"type": "subtitle", "time": 4794.39, "timestamp": "01:19:54", "text": "正しいか間違っているかは別として、私たちは子供たちが"}, {"type": "subtitle", "time": 4797.35, "timestamp": "01:19:57", "text": "ある程度は当然のことながら"}, {"type": "subtitle", "time": 4799.11, "timestamp": "01:19:59", "text": "両親が与えるものは何でも、"}]
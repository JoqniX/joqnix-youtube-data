[{"type": "subtitle", "time": 19381.51, "timestamp": "05:23:01", "text": "私は宇宙N24にいることに気付いた"}, {"type": "subtitle", "time": 19383.99, "timestamp": "05:23:03", "text": "オーディオの世界。私は何らかのアクセス手段を必要としている"}, {"type": "subtitle", "time": 19385.07, "timestamp": "05:23:05", "text": "のように"}, {"type": "subtitle", "time": 19391.35, "timestamp": "05:23:11", "text": "しかし、しかし、私の許可は"}, {"type": "subtitle", "time": 19393.19, "timestamp": "05:23:13", "text": "ここでは制限があります。それで、もしあなたが"}, {"type": "subtitle", "time": 19396.55, "timestamp": "05:23:16", "text": "ゲームにログインして情報を取得するのを手伝ってくれますか？"}, {"type": "subtitle", "time": 19399.19, "timestamp": "05:23:19", "text": "犯人は誰だ？バグ報告はどこにあるの？"}, {"type": "subtitle", "time": 19400.708, "timestamp": "05:23:20", "text": "ここですか？待って、待って、待って。どうぞ"}, {"type": "subtitle", "time": 19402.948, "timestamp": "05:23:22", "text": "まず私から話し合いましょう。私はあなたにそうさせません"}, {"type": "subtitle", "time": 19404.948, "timestamp": "05:23:24", "text": "それは無駄だった。私はハッキングできます"}, {"type": "subtitle", "time": 19406.868, "timestamp": "05:23:26", "text": "オペレーティングシステムといくつかの"}, {"type": "subtitle", "time": 19409.43, "timestamp": "05:23:29", "text": "ゲーム内報酬を裏で入手する。おお、"}, {"type": "subtitle", "time": 19417.43, "timestamp": "05:23:37", "text": "ロブ。こんにちは、レックス"}]
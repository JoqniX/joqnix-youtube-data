[{"type": "subtitle", "time": 7981.91, "timestamp": "02:13:01", "text": "とても素敵で、私は「お願いだから一緒にいて」と思いました"}, {"type": "subtitle", "time": 7983.43, "timestamp": "02:13:03", "text": "自分。どうか私と一緒にいてください。そして彼はこう言った。"}, {"type": "subtitle", "time": 7985.669, "timestamp": "02:13:05", "text": "「わかった、わかった。一緒にいるよ。」そして"}, {"type": "subtitle", "time": 7986.95, "timestamp": "02:13:06", "text": "すると彼は「よし、一度だけ」と言った。その後"}, {"type": "subtitle", "time": 7988.31, "timestamp": "02:13:08", "text": "彼はこう言った。「このボタンを押したら、"}, {"type": "subtitle", "time": 7990.149, "timestamp": "02:13:10", "text": "まるで彼が実際に押したかのように"}, {"type": "subtitle", "time": 7992.629, "timestamp": "02:13:12", "text": "「OBSでライブ配信するよ。」彼だった。"}, {"type": "subtitle", "time": 7995.189, "timestamp": "02:13:15", "text": "あなただったんですね。私ではありません。私はとても"}, {"type": "subtitle", "time": 7998.229, "timestamp": "02:13:18", "text": "神経質。私は震えていた。そしてニック先輩"}, {"type": "subtitle", "time": 8000.27, "timestamp": "02:13:20", "text": "「私はここにいるよ、君は"}, {"type": "subtitle", "time": 8003.03, "timestamp": "02:13:23", "text": "わかりました、このボタンを押します。一度"}, {"type": "subtitle", "time": 8004.95, "timestamp": "02:13:24", "text": "このボタンを押せば、あとはあなた次第です。あなた"}, {"type": "subtitle", "time": 8006.55, "timestamp": "02:13:26", "text": "大丈夫、君ならできるよ。ほら、"}, {"type": "subtitle", "time": 8008.709, "timestamp": "02:13:28", "text": "緊張しないで。君ならできるよ。」そして"}, {"type": "subtitle", "time": 8012.55, "timestamp": "02:13:32", "text": "私は感情的にあなたに惹かれていると思います。"}, {"type": "subtitle", "time": 8014.87, "timestamp": "02:13:34", "text": "知ってる、刻印されたみたい、わかった、ありがとう"}, {"type": "subtitle", "time": 8016.39, "timestamp": "02:13:36", "text": "本当にありがとう。その時点で、"}, {"type": "subtitle", "time": 8018.39, "timestamp": "02:13:38", "text": "誰も知らなかったし、"}, {"type": "subtitle", "time": 8019.99, "timestamp": "02:13:39", "text": "ストリーミングは全く初めてで、"}, {"type": "subtitle", "time": 8021.43, "timestamp": "02:13:41", "text": "あれからもう2年経ったと思う。しかし"}, {"type": "subtitle", "time": 8023.669, "timestamp": "02:13:43", "text": "私は今でもそのことに感謝しています"}, {"type": "subtitle", "time": 8026.109, "timestamp": "02:13:46", "text": "その瞬間は、"}, {"type": "subtitle", "time": 8028.709, "timestamp": "02:13:48", "text": "それはとても神経をすり減らすような感じで"}, {"type": "subtitle", "time": 8031.109, "timestamp": "02:13:51", "text": "ニック先輩は私が持っていた唯一の人でした"}, {"type": "subtitle", "time": 8034.31, "timestamp": "02:13:54", "text": "そして、もう一度繰り返しますが、"}, {"type": "subtitle", "time": 8036.39, "timestamp": "02:13:56", "text": "最後まで私と一緒にいてくれた人"}, {"type": "subtitle", "time": 8039.83, "timestamp": "02:13:59", "text": "終わり。まるで彼は、ほら、"}]
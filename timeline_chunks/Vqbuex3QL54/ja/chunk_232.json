[{"type": "subtitle", "time": 13944.309, "timestamp": "03:52:24", "text": "君たちなら戦えるよ。女の子同士の喧嘩。"}, {"type": "subtitle", "time": 13946.189, "timestamp": "03:52:26", "text": "ぶち抜く"}, {"type": "subtitle", "time": 13952.63, "timestamp": "03:52:32", "text": "バカ。よし。よし。よし。"}, {"type": "subtitle", "time": 13955.469, "timestamp": "03:52:35", "text": "よし。よし。喧嘩しないで"}, {"type": "subtitle", "time": 13959.51, "timestamp": "03:52:39", "text": "自分。おお。ああ、なんてことだ。ああ、神様。私は"}, {"type": "subtitle", "time": 13967.99, "timestamp": "03:52:47", "text": "神。何てことだ。"}, {"type": "subtitle", "time": 13973.95, "timestamp": "03:52:53", "text": "高い？ああ、"}]
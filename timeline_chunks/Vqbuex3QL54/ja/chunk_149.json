[{"type": "subtitle", "time": 8942.389, "timestamp": "02:29:02", "text": "感じているけど、まだ"}, {"type": "subtitle", "time": 8944.23, "timestamp": "02:29:04", "text": "たくさんの予定を立てる。だから私は"}, {"type": "subtitle", "time": 8948.15, "timestamp": "02:29:08", "text": "Twitterに2日間の要約を投稿する。"}, {"type": "subtitle", "time": 8950.67, "timestamp": "02:29:10", "text": "昨日のものと今日のもの。"}, {"type": "subtitle", "time": 8954.87, "timestamp": "02:29:14", "text": "はい。これを提供するのが少し遅れてしまいました"}, {"type": "subtitle", "time": 8972.23, "timestamp": "02:29:32", "text": "心配事。私は既に全員を追放している。"}, {"type": "subtitle", "time": 8991.389, "timestamp": "02:29:51", "text": "えっと"}, {"type": "subtitle", "time": 8995.87, "timestamp": "02:29:55", "text": "彼も連れて行かなければならなかった。彼は私の愛する人"}, {"type": "subtitle", "time": 8998.19, "timestamp": "02:29:58", "text": "友人。私"}]
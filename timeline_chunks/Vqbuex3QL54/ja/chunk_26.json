[{"type": "subtitle", "time": 1573.029, "timestamp": "00:26:13", "text": "何？待って、リスクって何だったっけ？私は"}, {"type": "subtitle", "time": 1575.19, "timestamp": "00:26:15", "text": "その言葉の意味を忘れてしまった。ああ、"}, {"type": "subtitle", "time": 1583.11, "timestamp": "00:26:23", "text": "自分。わかった。私はそれが何だったのか忘れ続けていました"}, {"type": "subtitle", "time": 1593.789, "timestamp": "00:26:33", "text": "[音楽]"}, {"type": "subtitle", "time": 1596.31, "timestamp": "00:26:36", "text": "もの。あれはミス・ビートルです。良い状態ではない"}, {"type": "subtitle", "time": 1598.19, "timestamp": "00:26:38", "text": "方法。待って。良い"}]
[{"type": "subtitle", "time": 16274.75, "timestamp": "04:31:14", "text": "何か？ああ、勝ったよ。何てことだ。"}, {"type": "subtitle", "time": 16279.87, "timestamp": "04:31:19", "text": "くそ。 3キル。 21キル。ああ、"}, {"type": "subtitle", "time": 16284.79, "timestamp": "04:31:24", "text": "神。それでおしまい。ああ、まるでああ"}, {"type": "subtitle", "time": 16291.07, "timestamp": "04:31:31", "text": "おお。"}, {"type": "subtitle", "time": 16293.99, "timestamp": "04:31:33", "text": "うん。もしそれが実際のプレイヤーなら、"}, {"type": "subtitle", "time": 16308.229, "timestamp": "04:31:48", "text": "くそ。アグレッサ。何てことだ。あなたはとても"}, {"type": "subtitle", "time": 16309.63, "timestamp": "04:31:49", "text": "多くの"}, {"type": "subtitle", "time": 16311.75, "timestamp": "04:31:51", "text": "業績。これらは実際の"}, {"type": "subtitle", "time": 16313.77, "timestamp": "04:31:53", "text": "プレイヤー？"}, {"type": "subtitle", "time": 16316.389, "timestamp": "04:31:56", "text": "[音楽]"}, {"type": "subtitle", "time": 16318.229, "timestamp": "04:31:58", "text": "このゲームは手に入れるのに時間がかかりました"}, {"type": "subtitle", "time": 16319.229, "timestamp": "04:31:59", "text": "使用済み"}]
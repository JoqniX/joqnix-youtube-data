[{"type": "subtitle", "time": 11709.87, "timestamp": "03:15:09", "text": "水。おやすみなさい、旦那様。"}, {"type": "subtitle", "time": 11718.15, "timestamp": "03:15:18", "text": "[音楽]"}, {"type": "subtitle", "time": 11722.03, "timestamp": "03:15:22", "text": "ああ、皆さん。皆さんお元気ですか？"}, {"type": "subtitle", "time": 11730.349, "timestamp": "03:15:30", "text": "ああ、皆さんが元気でいることを願っています"}, {"type": "subtitle", "time": 11733.389, "timestamp": "03:15:33", "text": "良い。声が聞こえているといいのですが、"}, {"type": "subtitle", "time": 11742.309, "timestamp": "03:15:42", "text": "だから君たちは、君たちが"}, {"type": "subtitle", "time": 11744.99, "timestamp": "03:15:44", "text": "今は順調です。良い"}, {"type": "subtitle", "time": 11749.309, "timestamp": "03:15:49", "text": "朝。今日は、"}, {"type": "chat", "time": 11751.813, "timestamp": "03:15:51", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "You can watch these fragments of a memories here- https://onxa.link/IdvxLnj0"}, {"type": "subtitle", "time": 11753.15, "timestamp": "03:15:53", "text": "31日木曜日。今日は"}, {"type": "subtitle", "time": 11755.79, "timestamp": "03:15:55", "text": "月。ああ、"}, {"type": "subtitle", "time": 11759.11, "timestamp": "03:15:59", "text": "神。ちょうど月末の最終日。できる"}]
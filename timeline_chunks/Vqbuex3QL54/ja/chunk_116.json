[{"type": "subtitle", "time": 6961.589, "timestamp": "01:56:01", "text": "ページ上のドットのようにフルと言います。"}, {"type": "subtitle", "time": 6963.99, "timestamp": "01:56:03", "text": "インクの跡で完全に埋め尽くされている"}, {"type": "subtitle", "time": 6966.87, "timestamp": "01:56:06", "text": "そういうことってありますよね。だから私は私は"}, {"type": "subtitle", "time": 6968.87, "timestamp": "01:56:08", "text": "あなたが何を言いたいのか、よく理解しています。"}, {"type": "subtitle", "time": 6971.51, "timestamp": "01:56:11", "text": "時々、ただ、ただ、私は"}, {"type": "subtitle", "time": 6973.189, "timestamp": "01:56:13", "text": "時々、自分自身でいたくないし、"}, {"type": "subtitle", "time": 6974.83, "timestamp": "01:56:14", "text": "私はただ"}, {"type": "subtitle", "time": 6978.229, "timestamp": "01:56:18", "text": "自分であることの重荷を背負わなくて済むように。"}, {"type": "subtitle", "time": 6980.95, "timestamp": "01:56:20", "text": "私が無関係だというわけではない"}, {"type": "subtitle", "time": 6983.109, "timestamp": "01:56:23", "text": "そのような負担を抱える方法や形態。"}, {"type": "subtitle", "time": 6984.629, "timestamp": "01:56:24", "text": "しかし、時には精神的な問題である"}, {"type": "subtitle", "time": 6987.75, "timestamp": "01:56:27", "text": "外部の物というよりは、むしろ物そのものに近い。"}, {"type": "subtitle", "time": 6992.55, "timestamp": "01:56:32", "text": "うん。うん。そういうことなんです。それは、えっと"}, {"type": "subtitle", "time": 6994.709, "timestamp": "01:56:34", "text": "最終的に私たちが皆望むのは"}, {"type": "chat", "time": 6997.968, "timestamp": "01:56:37", "author": "@OrangeSan", "avatar": "https://yt4.ggpht.com/1hzJ_11ALUfVaVrkxYo1ZVLPiK-9KSZ_F82omBSnvPLydlaR2DHr5h-PrrBJwHbm0GleoSyYuQ=s64-c-k-c0x00ffffff-no-rj", "message": "Wait why is the timer 0?"}, {"type": "subtitle", "time": 6998.07, "timestamp": "01:56:38", "text": "環境がもっと楽なように"}, {"type": "subtitle", "time": 7000.55, "timestamp": "01:56:40", "text": "息を吸って吐いて、"}, {"type": "subtitle", "time": 7003.91, "timestamp": "01:56:43", "text": "騒音が多すぎるし、すべてが"}, {"type": "subtitle", "time": 7005.99, "timestamp": "01:56:45", "text": "うん。うん。木があって、それは"}, {"type": "subtitle", "time": 7007.669, "timestamp": "01:56:47", "text": "花やその他諸々が咲き乱れる野原。"}, {"type": "subtitle", "time": 7009.99, "timestamp": "01:56:49", "text": "あなたはそこにいる。リラックスして、"}, {"type": "subtitle", "time": 7012.47, "timestamp": "01:56:52", "text": "酸素、すべて、心の平安"}, {"type": "subtitle", "time": 7015.39, "timestamp": "01:56:55", "text": "そして幸せになる"}, {"type": "subtitle", "time": 7018.31, "timestamp": "01:56:58", "text": "混雑しすぎていて、汚染された場所で、"}, {"type": "chat", "time": 7018.625, "timestamp": "01:56:58", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "@Orange donothon goals timer"}]
[{"type": "subtitle", "time": 302.23, "timestamp": "00:05:02", "text": "ああ、すっかり忘れてた。私たちは"}, {"type": "subtitle", "time": 304.55, "timestamp": "00:05:04", "text": "あまりにも気分が高揚して、"}, {"type": "subtitle", "time": 307.27, "timestamp": "00:05:07", "text": "彼女のことをすっかり忘れていた。する必要がある"}, {"type": "subtitle", "time": 310.07, "timestamp": "00:05:10", "text": "えーと、私は、私は、"}, {"type": "subtitle", "time": 313.11, "timestamp": "00:05:13", "text": "リストを作成して、私が出発する前に彼女をここに連れてきてください。"}, {"type": "subtitle", "time": 314.95, "timestamp": "00:05:14", "text": "はい。はい。はい。"}, {"type": "subtitle", "time": 317.51, "timestamp": "00:05:17", "text": "私のリストは、ある意味で"}, {"type": "subtitle", "time": 321.27, "timestamp": "00:05:21", "text": "空き枠はもっとあるのですが、"}, {"type": "subtitle", "time": 324.23, "timestamp": "00:05:24", "text": "問題は、これが"}, {"type": "subtitle", "time": 326.39, "timestamp": "00:05:26", "text": "空き枠があるので、もっと多くの人に参加してもらいたいと思っています。"}, {"type": "subtitle", "time": 329.629, "timestamp": "00:05:29", "text": "私が話した人々の中で"}, {"type": "subtitle", "time": 337.51, "timestamp": "00:05:37", "text": "過去だが、127人中"}, {"type": "subtitle", "time": 339.749, "timestamp": "00:05:39", "text": "ええと、ほとんどの人は来られなかったか、ほとんど"}, {"type": "subtitle", "time": 343.83, "timestamp": "00:05:43", "text": "彼らの多くは、ええと、忙しいとか、いろいろと。"}, {"type": "subtitle", "time": 347.029, "timestamp": "00:05:47", "text": "それで、何人かの人を集めて"}, {"type": "subtitle", "time": 349.35, "timestamp": "00:05:49", "text": "えっと、どれくらいだと思うかわかりません"}, {"type": "subtitle", "time": 351.43, "timestamp": "00:05:51", "text": "コラボした回数を数えることができる"}, {"type": "subtitle", "time": 355.35, "timestamp": "00:05:55", "text": "そしてここ数週間で。えっと、1つみたいに"}, {"type": "subtitle", "time": 358.87, "timestamp": "00:05:58", "text": "1日に4回か2回くらいだったよ。 1回あたり"}]
[{"type": "subtitle", "time": 18746.83, "timestamp": "05:12:26", "text": "生意気なガキ。彼女は究極の"}, {"type": "subtitle", "time": 18749.91, "timestamp": "05:12:29", "text": "自分。このゲームでリードしているのは誰ですか？させて"}, {"type": "subtitle", "time": 18752.47, "timestamp": "05:12:32", "text": "リーダーボードを確認します。"}, {"type": "subtitle", "time": 18755.43, "timestamp": "05:12:35", "text": "リーダーボードを確認するにはどうすればいいですか？私はランクです"}, {"type": "subtitle", "time": 18758.35, "timestamp": "05:12:38", "text": "1つ。ああ、私がキルリーダーだ。待って。おい"}, {"type": "subtitle", "time": 18761.788, "timestamp": "05:12:41", "text": "おい、どうやって"}, {"type": "subtitle", "time": 18772.628, "timestamp": "05:12:52", "text": "壮大。こんにちは。アノジャさん。"}]
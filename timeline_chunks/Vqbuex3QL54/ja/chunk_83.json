[{"type": "subtitle", "time": 4981.03, "timestamp": "01:23:01", "text": "昔はただ"}, {"type": "subtitle", "time": 4985.43, "timestamp": "01:23:05", "text": "幼い頃の自分と話す。あなたの過去"}, {"type": "subtitle", "time": 4989.229, "timestamp": "01:23:09", "text": "私自身、ちょっと私って感じ"}, {"type": "subtitle", "time": 4992.39, "timestamp": "01:23:12", "text": "悪いことが起こるとき"}, {"type": "subtitle", "time": 4995.11, "timestamp": "01:23:15", "text": "それを阻止すれば、"}, {"type": "subtitle", "time": 4997.11, "timestamp": "01:23:17", "text": "それはまた別の物語になるでしょう"}, {"type": "subtitle", "time": 4998.87, "timestamp": "01:23:18", "text": "映画や今私たちが見るものすべて"}, {"type": "subtitle", "time": 5002.07, "timestamp": "01:23:22", "text": "時間の崩壊とか、そういう類のこと"}, {"type": "subtitle", "time": 5005.03, "timestamp": "01:23:25", "text": "バトルユニバースとか何とか"}, {"type": "subtitle", "time": 5008.229, "timestamp": "01:23:28", "text": "ええ、でも私はそうしたいです"}, {"type": "subtitle", "time": 5011.83, "timestamp": "01:23:31", "text": "私の内なる子供が間接的に"}, {"type": "subtitle", "time": 5014.87, "timestamp": "01:23:34", "text": "自分自身、あるいは子供のように、子供の私は"}, {"type": "subtitle", "time": 5017.51, "timestamp": "01:23:37", "text": "物事に影響されない"}, {"type": "subtitle", "time": 5019.99, "timestamp": "01:23:39", "text": "それは私が将来成長する時に影響するだろう"}, {"type": "subtitle", "time": 5023.27, "timestamp": "01:23:43", "text": "大人になって、いろいろと成長していくんだよね？うん、"}, {"type": "chat", "time": 5025.827, "timestamp": "01:23:45", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "brb guys"}, {"type": "subtitle", "time": 5026.47, "timestamp": "01:23:46", "text": "あれ。そこで、2番目は"}, {"type": "subtitle", "time": 5028.39, "timestamp": "01:23:48", "text": "時間を遡ったり、何か"}, {"type": "subtitle", "time": 5030.31, "timestamp": "01:23:50", "text": "指を鳴らせば、私は時間通りに戻るか、"}, {"type": "subtitle", "time": 5031.99, "timestamp": "01:23:51", "text": "何か。"}, {"type": "subtitle", "time": 5033.75, "timestamp": "
[{"type": "subtitle", "time": 13697.389, "timestamp": "03:48:17", "text": "おお。そこには"}, {"type": "subtitle", "time": 13701.55, "timestamp": "03:48:21", "text": "大砲。私が持っていた弓は"}, {"type": "subtitle", "time": 13710.309, "timestamp": "03:48:30", "text": "この弓は長距離に適しています。"}, {"type": "subtitle", "time": 13716.91, "timestamp": "03:48:36", "text": "良くない"}, {"type": "subtitle", "time": 13723.229, "timestamp": "03:48:43", "text": "もの。私は"}, {"type": "subtitle", "time": 13731.349, "timestamp": "03:48:51", "text": "ストレージ。よし、見つける必要がある"}, {"type": "subtitle", "time": 13733.349, "timestamp": "03:48:53", "text": "商人。商人はここにいる、私は"}]
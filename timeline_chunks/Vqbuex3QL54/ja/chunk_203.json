[{"type": "subtitle", "time": 12180.389, "timestamp": "03:23:00", "text": "えーと、基本的なチュートリアルです。"}, {"type": "subtitle", "time": 12183.11, "timestamp": "03:23:03", "text": "チュートリアルなので、あまりよく知りません。それでは"}, {"type": "subtitle", "time": 12185.99, "timestamp": "03:23:05", "text": "これを再生してください。わかった。そして、おはようございます。"}, {"type": "subtitle", "time": 12188.95, "timestamp": "03:23:08", "text": "そして、アキアビさん、ようこそ。"}, {"type": "subtitle", "time": 12191.79, "timestamp": "03:23:11", "text": "良い一日をお過ごしください"}, {"type": "subtitle", "time": 12196.03, "timestamp": "03:23:16", "text": "えっと、今日は何日でしたっけ？木曜日が控えている。"}, {"type": "subtitle", "time": 12200.51, "timestamp": "03:23:20", "text": "おはようございます、オハイオ"}, {"type": "subtitle", "time": 12203.03, "timestamp": "03:23:23", "text": "パン。良い一日をお過ごしください"}, {"type": "subtitle", "time": 12206.229, "timestamp": "03:23:26", "text": "木曜日が控えている。わかったよ、バイパー。"}, {"type": "subtitle", "time": 12209.51, "timestamp": "03:23:29", "text": "タイニーのボイスラインが欲しい、そしてまだ"}, {"type": "subtitle", "time": 12211.59, "timestamp": "03:23:31", "text": "生きている。"}, {"type": "subtitle", "time": 12214.07, "timestamp": "03:23:34", "text": "さあ、出発しよう。私たちには時間がない"}, {"type": "subtitle", "time": 12216.87, "timestamp": "03:23:36", "text": "無駄。"}, {"type": "subtitle", "time": 12219.51, "timestamp": "03:23:39", "text": "ああ、耳が詰まった。あなたは？私の"}, {"type": "subtitle", "time": 12223.59, "timestamp": "03:23:43", "text": "耳から血が出ている。何てことだ。そうするべきです。"}, {"type": "subtitle", "time": 12226.63, "timestamp": "03:23:46", "text": "イヤホンを耳につけるのは悪いことですか？"}, {"type": "subtitle", "time": 12230.15, "timestamp": "03:23:50", "text": "音量を100にしますか？これは文字通り"}, {"type": "subtitle", "time": 12233.51, "timestamp": "03:23:53", "text": "70. いや、これは私の取引量の20%くらいだ。"}, {"type": "subtitle", "time": 12235.63, "timestamp": "03:23:55", "text": "ネガティブ"}]
[{"type": "subtitle", "time": 3.27, "timestamp": "00:00:03", "text": "Twitchで配信中。ええと、6時間。うん、大丈夫だよ。"}, {"type": "subtitle", "time": 11.95, "timestamp": "00:00:11", "text": "ストリーム。わかった。えっと、私たちは"}, {"type": "subtitle", "time": 14.23, "timestamp": "00:00:14", "text": "ライブ？リンクを取得して"}, {"type": "subtitle", "time": 15.87, "timestamp": "00:00:15", "text": "すべて"}, {"type": "subtitle", "time": 18.109, "timestamp": "00:00:18", "text": "右。こんにちは"}, {"type": "subtitle", "time": 22.15, "timestamp": "00:00:22", "text": "みんな。 83日目へようこそ。ああ、"}, {"type": "subtitle", "time": 24.87, "timestamp": "00:00:24", "text": "待って。タイトルに83や82と書いてあるのはなぜですか？"}, {"type": "subtitle", "time": 28.47, "timestamp": "00:00:28", "text": "もう一度訂正させてください。ごめん。"}, {"type": "subtitle", "time": 32.59, "timestamp": "00:00:32", "text": "83日目へようこそ"}, {"type": "subtitle", "time": 35.31, "timestamp": "00:00:35", "text": "チョコラタソン ナイトストリーム パート2。"}, {"type": "subtitle", "time": 38.47, "timestamp": "00:00:38", "text": "うん。今日は禅の時間を過ごします"}, {"type": "subtitle", "time": 41.43, "timestamp": "00:00:41", "text": "プロジェクト・スタースケープのカスメット。彼は"}, {"type": "subtitle", "time": 44.95, "timestamp": "00:00:44", "text": "今日はコラボレーションのために参加していただきました。私はしなければならない"}, {"type": "subtitle", "time": 47.43, "timestamp": "00:00:47", "text": "Zenと一緒に音声チェックなどをやってみる。私"}, {"type": "subtitle", "time": 49.67, "timestamp": "00:00:49", "text": "それはまだやってないよ、だって別のことがあったから"}, {"type": "subtitle", "time": 52.79, "timestamp": "00:00:52", "text": "以前、Proa Sonとコラボレーションした際、"}, {"type": "subtitle", "time": 55.51, "timestamp": "00:00:55", "text": "Repoをプレイしていたところ、ワイプして"}, {"type": "subtitle", "time": 58.83, "timestamp": "00:00:58", "text": "ヴァレラントで冷やした。"}]
[{"type": "subtitle", "time": 8041.189, "timestamp": "02:14:01", "text": "時間をかけてください、なぜなら"}, {"type": "subtitle", "time": 8042.39, "timestamp": "02:14:02", "text": "ロード画面が表示されました。"}, {"type": "subtitle", "time": 8044.149, "timestamp": "02:14:04", "text": "このボタンを押せば時間は問題ありません"}, {"type": "subtitle", "time": 8046.069, "timestamp": "02:14:06", "text": "すべてはあなたのおかげです。ありがとう。"}, {"type": "subtitle", "time": 8047.91, "timestamp": "02:14:07", "text": "ニクソンにとってそれはとても"}, {"type": "subtitle", "time": 8049.83, "timestamp": "02:14:09", "text": "それは私の核心的な記憶のようなもので、"}, {"type": "subtitle", "time": 8052.149, "timestamp": "02:14:12", "text": "感謝しているし、とても嬉しい"}, {"type": "subtitle", "time": 8054.75, "timestamp": "02:14:14", "text": "あなたが私のためにそこにいてくれたことを知っている"}, {"type": "subtitle", "time": 8057.83, "timestamp": "02:14:17", "text": "デビューするまでライブ配信を押して"}, {"type": "subtitle", "time": 8059.91, "timestamp": "02:14:19", "text": "あなたは行ったが、そしてあなたは事実を知っている"}, {"type": "subtitle", "time": 8061.43, "timestamp": "02:14:21", "text": "私の最初の外部コラボレーションはあなたとのものでした"}, {"type": "subtitle", "time": 8063.35, "timestamp": "02:14:23", "text": "私もそれにとても感謝していますし、"}, {"type": "subtitle", "time": 8065.189, "timestamp": "02:14:25", "text": "あなたが知ってくれて嬉しい、私たちが"}, {"type": "subtitle", "time": 8066.91, "timestamp": "02:14:26", "text": "こんな風に話せる。"}, {"type": "subtitle", "time": 8069.75, "timestamp": "02:14:29", "text": "[音楽]"}, {"type": "subtitle", "time": 8072.629, "timestamp": "02:14:32", "text": "うん、感傷的になる感じ。ああ、"}, {"type": "subtitle", "time": 8075.43, "timestamp": "02:14:35", "text": "神、"}, {"type": "subtitle", "time": 8076.43, "timestamp": "02:14:36", "text": "その"}, {"type": "subtitle", "time": 8079.91, "timestamp": "02:14:39", "text": "わかった。私は今でもそのことを覚えている。そして私は思う"}, {"type": "subtitle", "time": 8083.109, "timestamp": "02:14:43", "text": "初めて誰かと"}, {"type": "subtitle", "time": 8086.55, "timestamp": "02:14:46", "text": "誰が私に好きになるように言ったの、あなたは一緒にいられますか"}, {"type": "subtitle", "time": 8089.99, "timestamp": "02:14:49", "text": "ちょっとの間、私に？えっと、ちょっと緊張してるんです。"}, {"type": "subtitle", "time": 8092.79, "timestamp": "02:14:52", "text": "だから私は、この人は"}, {"type": "subtitle", "time": 8095.669, "timestamp": "02:14:55", "text": "どんな状況でも守られる。よく似ている"}, {"type": "subtitle", "time": 8097.51, "timestamp": "02:14:57", "text": "それ。"}]
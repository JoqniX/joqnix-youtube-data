[{"type": "subtitle", "time": 8161.31, "timestamp": "02:16:01", "text": "あれ、デビュー時の傷、だと思う"}, {"type": "subtitle", "time": 8164.709, "timestamp": "02:16:04", "text": "ええ、私も自分のせいだと言えるかもしれません。"}, {"type": "subtitle", "time": 8166.39, "timestamp": "02:16:06", "text": "私にもできたような気がする"}, {"type": "subtitle", "time": 8168.95, "timestamp": "02:16:08", "text": "より良い。いや、いや、いや、いや、いや。それは違う"}, {"type": "subtitle", "time": 8171.109, "timestamp": "02:16:11", "text": "あなたに。それはあなたの責任ではありません。それは"}, {"type": "subtitle", "time": 8173.51, "timestamp": "02:16:13", "text": "文字通り、あなたには関係ありません。なぜなら私は覚えているから"}, {"type": "subtitle", "time": 8176.229, "timestamp": "02:16:16", "text": "私に起こったことの後、私は警告しました"}, {"type": "subtitle", "time": 8178.95, "timestamp": "02:16:18", "text": "次の人。お金と"}, {"type": "subtitle", "time": 8182.35, "timestamp": "02:16:22", "text": "彼女も結局、全く同じことをしてしまった。"}, {"type": "subtitle", "time": 8185.91, "timestamp": "02:16:25", "text": "わかった。それは、それは、それは、それはただの"}, {"type": "subtitle", "time": 8187.589, "timestamp": "02:16:27", "text": "呪い。あれはただの呪いだったと思う。のように"}, {"type": "subtitle", "time": 8189.43, "timestamp": "02:16:29", "text": "それはまさに運命づけられていたかのようだった。"}, {"type": "subtitle", "time": 8192.709, "timestamp": "02:16:32", "text": "それは運命だったのだ。でも私も"}, {"type": "subtitle", "time": 8195.75, "timestamp": "02:16:35", "text": "君がただそこにいたから、君に残るように頼んだんだ"}, {"type": "subtitle", "time": 8197.91, "timestamp": "02:16:37", "text": "当然のことながら、とても気楽な人です。"}, {"type": "subtitle", "time": 8199.509, "timestamp": "02:16:39", "text": "ほら、その時点では、"}, {"type": "subtitle", "time": 8200.79, "timestamp": "02:16:40", "text": "たとえ私たちがそうしていなかったとしても、居心地の良い人"}, {"type": "subtitle", "time": 8204.309, "timestamp": "02:16:44", "text": "よく話題になりますよね？そして、それは"}, {"type": "subtitle", "time": 8207.03, "timestamp": "02:16:47", "text": "あなたがそこにいてくれただけで嬉しかったです。そして、"}, {"type": "subtitle", "time": 8208.549, "timestamp": "02:16:48", "text": "ほら、今はまるで"}, {"type": "subtitle", "time": 8211.83, "timestamp": "02:16:51", "text": "誇り高い先生または教師"}, {"type": "subtitle", "time": 8213.23, "timestamp": "02:16:53", "text": "知っているような"}, {"type": "subtitle", "time": 8217.429, "timestamp": "02:16:57", "text": "ええと、ごく普通の人間です。わからない。"}, {"type": "subtitle", "time": 8219.349, "timestamp": "02:16:59", "text": "あなたはとても助けてくれました。あなたはとても助けてくれました。"}]
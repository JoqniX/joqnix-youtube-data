[{"type": "subtitle", "time": 12122.15, "timestamp": "03:22:02", "text": "おお。何てことだ。人形がいっぱい。何てことだ。"}, {"type": "subtitle", "time": 12126.15, "timestamp": "03:22:06", "text": "私は行きます。ネオットがいる。何てことだ。おお"}, {"type": "subtitle", "time": 12126.99, "timestamp": "03:22:06", "text": "私の"}, {"type": "subtitle", "time": 12130.07, "timestamp": "03:22:10", "text": "神。私はこれが欲しい。どうすればいいですか？どうやって"}, {"type": "subtitle", "time": 12132.55, "timestamp": "03:22:12", "text": "いくら支払うべきですか？支払いたくない"}, {"type": "subtitle", "time": 12134.11, "timestamp": "03:22:14", "text": "君はそう思うよね。"}, {"type": "subtitle", "time": 12137.79, "timestamp": "03:22:17", "text": "でも、500って​​言ったよね？"}, {"type": "subtitle", "time": 12142.19, "timestamp": "03:22:22", "text": "2ドル。え、2ドルで金240個？"}, {"type": "subtitle", "time": 12144.15, "timestamp": "03:22:24", "text": "[音楽]"}, {"type": "subtitle", "time": 12147.68, "timestamp": "03:22:27", "text": "お金を使うことを想像してみてください。"}, {"type": "subtitle", "time": 12149.19, "timestamp": "03:22:29", "text": "[音楽]"}, {"type": "subtitle", "time": 12152.389, "timestamp": "03:22:32", "text": "待てよ、これはリスキンだ。おいおい、何？おお、"}, {"type": "subtitle", "time": 12154.07, "timestamp": "03:22:34", "text": "待って。いや、やっぱりいいや。 2つあります"}, {"type": "subtitle", "time": 12156.95, "timestamp": "03:22:36", "text": "バージョン。白黒。ああ、できるよ"}, {"type": "subtitle", "time": 12158.51, "timestamp": "03:22:38", "text": "これを見てください。おお、"}, {"type": "subtitle", "time": 12161.429, "timestamp": "03:22:41", "text": "待って。螺旋状のスキル。螺旋とは何か"}, {"type": "subtitle", "time": 12163.03, "timestamp": "03:22:43", "text": "肌？"}, {"type": "subtitle", "time": 12165.03, "timestamp": "03:22:45", "text": "あ、黒いのをもらえますか？何をすべきか"}, {"type": "subtitle", "time": 12166.83, "timestamp": "03:22:46", "text": "黒を手に入れるために"}, {"type": "subtitle", "time": 12177.67, "timestamp": "03:22:57", "text": "お金。それでは、"}]
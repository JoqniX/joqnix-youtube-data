[{"type": "subtitle", "time": 6782.39, "timestamp": "01:53:02", "text": "私はそれほど優れていないが、どういうわけか"}, {"type": "subtitle", "time": 6785.629, "timestamp": "01:53:05", "text": "翻訳すると、えっと、"}, {"type": "subtitle", "time": 6788.629, "timestamp": "01:53:08", "text": "どう言えばいいのかな"}, {"type": "subtitle", "time": 6791.35, "timestamp": "01:53:11", "text": "それはまるで私の芸術作品のようなものだ"}, {"type": "subtitle", "time": 6793.35, "timestamp": "01:53:13", "text": "誰も触れることができず、誰も"}, {"type": "subtitle", "time": 6795.109, "timestamp": "01:53:15", "text": "見る。まるでそれが元々私のものだったかのようだ"}, {"type": "chat", "time": 6795.775, "timestamp": "01:53:15", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "ernest hemingway?"}, {"type": "subtitle", "time": 6797.109, "timestamp": "01:53:17", "text": "なぜならそれは私の心の中にあるから、"}, {"type": "subtitle", "time": 6800.149, "timestamp": "01:53:20", "text": "そういう感じのことだよ。"}, {"type": "subtitle", "time": 6803.51, "timestamp": "01:53:23", "text": "私もそれに共感できます。"}, {"type": "subtitle", "time": 6807.27, "timestamp": "01:53:27", "text": "私の音楽チャンネルとか、ただ、"}, {"type": "subtitle", "time": 6810.55, "timestamp": "01:53:30", "text": "誰も私のことを知らないような遠く離れた場所で"}, {"type": "subtitle", "time": 6814.07, "timestamp": "01:53:34", "text": "ジョックンとかそういうのは、"}, {"type": "subtitle", "time": 6816.55, "timestamp": "01:53:36", "text": "全く新しい視聴者層と内容。それ"}, {"type": "subtitle", "time": 6820.95, "timestamp": "01:53:40", "text": "「ああ、こっちの方がずっと上手くできてる」って感じだった。"}, {"type": "subtitle", "time": 6823.83, "timestamp": "01:53:43", "text": "ああ、私が好きなものに関しては"}, {"type": "subtitle", "time": 6826.79, "timestamp": "01:53:46", "text": "Jockn のようにはできなかったが、私はできた"}, {"type": "subtitle", "time": 6829.51, "timestamp": "01:53:49", "text": "そっちの方がずっといい、ちゃんと自分を宣伝する"}, {"type": "subtitle", "time": 6831.109, "timestamp": "01:53:51", "text": "そしてすべてにおいて、より積極的に"}, {"type": "subtitle", "time": 6833.99, "timestamp": "01:53:53", "text": "そのアカウントでは、JockよりもTwitterをよく利用している。"}, {"type": "chat", "time": 6835.865, "timestamp": "01:53:55", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "broskie's wife lost the suitcase on a train to paris"}, {"type": "subtitle", "time": 6837.43, "timestamp": "01:53:57", "text": "それで私は、なぜ私は"}, {"type": "subtitle", "time": 6839.589, "timestamp": "01:53:59", "text": "ここではできますが、私の"}]
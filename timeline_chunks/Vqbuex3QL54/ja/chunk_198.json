[{"type": "subtitle", "time": 11881.269, "timestamp": "03:18:01", "text": "それ。そう願っています。"}, {"type": "subtitle", "time": 11883.51, "timestamp": "03:18:03", "text": "楽しいゲームだよ。よし、切り替えよう"}, {"type": "subtitle", "time": 11890.87, "timestamp": "03:18:10", "text": "私たちは？私はそれをプレイしたかもしれないし、プレイしなかったかもしれない"}, {"type": "subtitle", "time": 11892.59, "timestamp": "03:18:12", "text": "少し"}, {"type": "subtitle", "time": 11904.269, "timestamp": "03:18:24", "text": "CNでこの226 MSをプレイしたいのですが"}, {"type": "subtitle", "time": 11907.309, "timestamp": "03:18:27", "text": "痛み。ええ、でもそうですね"}, {"type": "subtitle", "time": 11909.68, "timestamp": "03:18:29", "text": "行く。海"}, {"type": "subtitle", "time": 11918.75, "timestamp": "03:18:38", "text": "同意する。そうなるといいな、好きになる必要がある"}, {"type": "subtitle", "time": 11922.91, "timestamp": "03:18:42", "text": "えっと、ログインが必要かどうかわかりません。"}, {"type": "subtitle", "time": 11926.349, "timestamp": "03:18:46", "text": "何か。そうすべきではない、"}, {"type": "subtitle", "time": 11929.03, "timestamp": "03:18:49", "text": "右？通信するにはエンターキーを押してください"}]
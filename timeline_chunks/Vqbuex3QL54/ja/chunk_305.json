[{"type": "subtitle", "time": 18324.47, "timestamp": "05:05:24", "text": "人々。でも、私たちはプレイしますよ。"}, {"type": "subtitle", "time": 18326.47, "timestamp": "05:05:26", "text": "ああ、もうプレイしたんですね。私はあなたが"}, {"type": "subtitle", "time": 18352.75, "timestamp": "05:05:52", "text": "ああ、私は"}, {"type": "subtitle", "time": 18355.27, "timestamp": "05:05:55", "text": "亡くなった。待って、他の人の"}]
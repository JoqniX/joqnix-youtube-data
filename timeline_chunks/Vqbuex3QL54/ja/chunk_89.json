[{"type": "subtitle", "time": 5342.31, "timestamp": "01:29:02", "text": "オンラインのことに没頭している私"}, {"type": "chat", "time": 5342.88, "timestamp": "01:29:02", "author": "@zergrush78319", "avatar": "https://yt4.ggpht.com/ytc/AIdro_nDwl-xtQg1-Z5v6Iv64Z42_Hei-15daYPmWXqoFR-4_b8=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4idk"}, {"type": "subtitle", "time": 5344.31, "timestamp": "01:29:04", "text": "友達に電話したら、親友になってくれるだろう"}, {"type": "subtitle", "time": 5347.11, "timestamp": "01:29:07", "text": "親友のように、あなたは私です"}, {"type": "subtitle", "time": 5349.669, "timestamp": "01:29:09", "text": "彼らのためにそこにいてくれれば、私のためにそこにいてくれるだろう。"}, {"type": "subtitle", "time": 5352.229, "timestamp": "01:29:12", "text": "あれの。しかし、私が足を踏み入れた時から"}, {"type": "subtitle", "time": 5354.07, "timestamp": "01:29:14", "text": "これはオンラインで全てであり、私は"}, {"type": "subtitle", "time": 5356.55, "timestamp": "01:29:16", "text": "複数の分離があることに気づいた"}, {"type": "subtitle", "time": 5358.39, "timestamp": "01:29:18", "text": "友情に関しては。そこには"}, {"type": "subtitle", "time": 5360.149, "timestamp": "01:29:20", "text": "知り合い、つながり、親しい関係"}, {"type": "subtitle", "time": 5362.31, "timestamp": "01:29:22", "text": "友達、親友、最高の友達"}, {"type": "subtitle", "time": 5365.189, "timestamp": "01:29:25", "text": "友達って、本当にいろいろあるよね？そして私は"}, {"type": "subtitle", "time": 5367.43, "timestamp": "01:29:27", "text": "これらの境界線が理解できなかったので"}, {"type": "subtitle", "time": 5370.39, "timestamp": "01:29:30", "text": "すべて。そして後になって気づいた"}, {"type": "subtitle", "time": 5372.79, "timestamp": "01:29:32", "text": "友達には2種類いる。良い"}, {"type": "subtitle", "time": 5374.79, "timestamp": "01:29:34", "text": "友人と悪い友人。がある"}, {"type": "subtitle", "time": 5376.55, "timestamp": "01:29:36", "text": "あなたに対して有害な人々と"}, {"type": "subtitle", "time": 5378.79, "timestamp": "01:29:38", "text": "あなたを評価せず、あなたを利用し、"}, {"type": "subtitle", "time": 5380.87, "timestamp": "01:29:40", "text": "詰め込んで捨てる。がある"}, {"type": "subtitle", "time": 5382.709, "timestamp": "01:29:42", "text": "誠実で助けたいと思っている人たち"}, {"type": "subtitle", "time": 5385.51, "timestamp": "01:29:45", "text": "君と良いものを見て、また会おう"}, {"type": "chat", "time": 5385.524, "timestamp": "01:29:45", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "true"}, {"type": "subtitle", "time": 5387.59, "timestamp": "01:29:47", "text": "多くのことを成し遂げ、本当に"}, {"type": "subtitle", "time": 5390.149, "timestamp": "01:29:50", "text": "あなたが幸せで、あなたが"}, {"type": "subtitle", "time": 5392.87, "timestamp": "01:29:52", "text": "悲しいけれど、彼らはあなたを慰めてくれるでしょう"}, {"type": "subtitle", "time": 5395.189, "timestamp": "01:29:55", "text": "彼らが慰めなければならない仕事としてではない"}, {"type": "subtitle", "time": 5399.27, "timestamp": "01:29:59", "text": "あなたは、そう、あなたは、私は"}]
[{"type": "subtitle", "time": 12423.71, "timestamp": "03:27:03", "text": "ゲーム。タブを押してバッグを開けてください。アイテム"}, {"type": "subtitle", "time": 12426.469, "timestamp": "03:27:06", "text": "拡大。アイテム拡張。わかりました、"}, {"type": "subtitle", "time": 12430.63, "timestamp": "03:27:10", "text": "これ？続きを書く余地があります。 Souljバッグ"}, {"type": "subtitle", "time": 12432.71, "timestamp": "03:27:12", "text": "兵士を留めておく。つまり、上層部は"}, {"type": "subtitle", "time": 12434.389, "timestamp": "03:27:14", "text": "兵士のバッグを拾うことで増加"}, {"type": "subtitle", "time": 12436.87, "timestamp": "03:27:16", "text": "爆発して、えーと、スロットを1つ追加します。"}, {"type": "subtitle", "time": 12439.269, "timestamp": "03:27:19", "text": "武器を上部に収納する武器バッグ"}, {"type": "subtitle", "time": 12440.87, "timestamp": "03:27:20", "text": "制限は、拾うことで増やすことができます"}, {"type": "subtitle", "time": 12443.19, "timestamp": "03:27:23", "text": "武器バッグ。拡張を探索して"}, {"type": "subtitle", "time": 12453.03, "timestamp": "03:27:33", "text": "剣。切れ味が十分であることを願おう。"}, {"type": "subtitle", "time": 12455.67, "timestamp": "03:27:35", "text": "あなたはまだ戦い方を覚えていますか？はい、"}, {"type": "subtitle", "time": 12460.309, "timestamp": "03:27:40", "text": "私はします。その言語の前に、どうすれば"}, {"type": "subtitle", "time": 12462.429, "timestamp": "03:27:42", "text": "私の声を変える？"}, {"type": "subtitle", "time": 12464.95, "timestamp": "03:27:44", "text": "言語。声を変えることはできないの？"}, {"type": "subtitle", "time": 12475.11, "timestamp": "03:27:55", "text": "声。待って、言語は2つだけ。こんにちは。待って、"}, {"type": "subtitle", "time": 12477.67, "timestamp": "03:27:57", "text": "いや、気にしないで。これは何ですか？待って、"}]
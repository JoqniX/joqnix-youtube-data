[{"type": "subtitle", "time": 9060.79, "timestamp": "02:31:00", "text": "アイデアが尽きたような感じです。何をすればいいですか"}, {"type": "subtitle", "time": 9070.91, "timestamp": "02:31:10", "text": "しかし"}, {"type": "subtitle", "time": 9079.27, "timestamp": "02:31:19", "text": "楽しい。さて、明日は火曜日ですね。"}, {"type": "subtitle", "time": 9083.75, "timestamp": "02:31:23", "text": "火曜日はPaliとのコラボレーションがあります"}, {"type": "subtitle", "time": 9086.389, "timestamp": "02:31:26", "text": "インド標準時午後4時。"}, {"type": "subtitle", "time": 9090.79, "timestamp": "02:31:30", "text": "パリは、えーと、"}, {"type": "subtitle", "time": 9093.51, "timestamp": "02:31:33", "text": "私に近く、私は私にも近くに置いています"}, {"type": "subtitle", "time": 9096.389, "timestamp": "02:31:36", "text": "しばらく話していませんが"}, {"type": "subtitle", "time": 9100.55, "timestamp": "02:31:40", "text": "でも彼は私の"}, {"type": "subtitle", "time": 9101.63, "timestamp": "02:31:41", "text": "初めて"}, {"type": "subtitle", "time": 9104.71, "timestamp": "02:31:44", "text": "私がストリーミングを始めたとき、視聴者は"}, {"type": "subtitle", "time": 9109.95, "timestamp": "02:31:49", "text": "プレプレジョープレチューバージョギング時代の彼は"}, {"type": "subtitle", "time": 9113.23, "timestamp": "02:31:53", "text": "そこに"}, {"type": "subtitle", "time": 9115.99, "timestamp": "02:31:55", "text": "いろいろあって、彼らと話したかったんです。"}, {"type": "subtitle", "time": 9117.71, "timestamp": "02:31:57", "text": "私は一緒に過ごしています"}]
[{"type": "subtitle", "time": 19261.19, "timestamp": "05:21:01", "text": "アレクシア。ああ、アカウントを持っていませんでした。私"}, {"type": "subtitle", "time": 19264.02, "timestamp": "05:21:04", "text": "知らなかった。"}, {"type": "subtitle", "time": 19278.67, "timestamp": "05:21:18", "text": "コード。私にやらせてください"}, {"type": "subtitle", "time": 19282.99, "timestamp": "05:21:22", "text": "これ。アカウントが作成されました。"}, {"type": "subtitle", "time": 19286.42, "timestamp": "05:21:26", "text": "続く。試合に戻ります。"}, {"type": "subtitle", "time": 19289.31, "timestamp": "05:21:29", "text": "[音楽]"}, {"type": "subtitle", "time": 19295.628, "timestamp": "05:21:35", "text": "承認する。確認する"}, {"type": "subtitle", "time": 19301.99, "timestamp": "05:21:41", "text": "わーい。カードを探してください。再起動が必要です"}, {"type": "subtitle", "time": 19304.51, "timestamp": "05:21:44", "text": "このカード。"}, {"type": "subtitle", "time": 19309.54, "timestamp": "05:21:49", "text": "H. すべての"}, {"type": "subtitle", "time": 19310.99, "timestamp": "05:21:50", "text": "[音楽]"}, {"type": "subtitle", "time": 19319.03, "timestamp": "05:21:59", "text": "わかった。よし。私たちはそれを実行しました。私はしません"}]
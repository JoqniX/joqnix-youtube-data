[{"type": "subtitle", "time": 421.99, "timestamp": "00:07:01", "text": "まもなくZenとのコラボレーションを開始します。前に"}, {"type": "subtitle", "time": 424.309, "timestamp": "00:07:04", "text": "10時30分にここにいます。そうだよ、君は"}, {"type": "subtitle", "time": 426.23, "timestamp": "00:07:06", "text": "それを楽しんでいますか？すぐに戻ります。"}, {"type": "chat", "time": 427.332, "timestamp": "00:07:07", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Joq's Activity State is AFK"}, {"type": "subtitle", "time": 429.55, "timestamp": "00:07:09", "text": "よし、これを着る"}, {"type": "subtitle", "time": 432.589, "timestamp": "00:07:12", "text": "そして"}, {"type": "chat", "time": 433.181, "timestamp": "00:07:13", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Joq went to have his dinner~ do enjoy the vods till i come back nee~"}, {"type": "subtitle", "time": 435.51, "timestamp": "00:07:15", "text": "区。どんな言葉が出てくるのでしょうか？何の単語が"}, {"type": "subtitle", "time": 437.55, "timestamp": "00:07:17", "text": "私たちは"}, {"type": "subtitle", "time": 442.99, "timestamp": "00:07:22", "text": "ゴータ"}, {"type": "subtitle", "time": 446.309, "timestamp": "00:07:26", "text": "名詞ああ、原神ですね。こんにちは。原神を楽しむ"}, {"type": "subtitle", "time": 448.23, "timestamp": "00:07:28", "text": "私が戻ってくるまで。これは古い"}, {"type": "subtitle", "time": 453.67, "timestamp": "00:07:33", "text": "古いスポーツマンの首。パプアニューギニアのスポーツマン料理。うん。"}, {"type": "subtitle", "time": 456.629, "timestamp": "00:07:36", "text": "ニース。ニース。こんにちは。私は戻ってきます。楽しむ、"}, {"type": "subtitle", "time": 459.35, "timestamp": "00:07:39", "text": "みんな。私は戻ってきます。わかった。"}, {"type": "chat", "time": 461.008, "timestamp": "00:07:41", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "messa
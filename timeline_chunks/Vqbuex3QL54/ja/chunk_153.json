[{"type": "subtitle", "time": 9180.55, "timestamp": "02:33:00", "text": "もの。まだ考えているところです。私"}, {"type": "subtitle", "time": 9191.71, "timestamp": "02:33:11", "text": "明日は"}, {"type": "subtitle", "time": 9200.63, "timestamp": "02:33:20", "text": "夜。うん、夜更かしして"}, {"type": "subtitle", "time": 9203.15, "timestamp": "02:33:23", "text": "真夜中にやるだけ"}, {"type": "subtitle", "time": 9206.23, "timestamp": "02:33:26", "text": "コラボレーション。なんてこった。ええ、見逃しました"}, {"type": "subtitle", "time": 9209.27, "timestamp": "02:33:29", "text": "真夜中と朝の2回ずつ。二"}, {"type": "subtitle", "time": 9211.83, "timestamp": "02:33:31", "text": "あの二人にとって、日々が過ぎ去った"}, {"type": "subtitle", "time": 9215.03, "timestamp": "02:33:35", "text": "人々。 2回行ったことがあります"}, {"type": "subtitle", "time": 9217.349, "timestamp": "02:33:37", "text": "見逃したか、スケジュールの問題か何か。"}, {"type": "subtitle", "time": 9219.59, "timestamp": "02:33:39", "text": "だから私はまだそれらを入れたいし、"}, {"type": "subtitle", "time": 9221.99, "timestamp": "02:33:41", "text": "もの。他にも数人いて、私は"}, {"type": "subtitle", "time": 9224.99, "timestamp": "02:33:44", "text": "彼らに再び加わりたい。それで"}, {"type": "subtitle", "time": 9228.15, "timestamp": "02:33:48", "text": "痛みはあったけど、今日はジョーダンも楽しかったよ。"}, {"type": "subtitle", "time": 9231.03, "timestamp": "02:33:51", "text": "すみません、私は文字通りテーブルの下にいます。"}, {"type": "subtitle", "time": 9237.95, "timestamp": "02:33:57", "text": "[音楽]"}]
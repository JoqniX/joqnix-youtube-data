[{"type": "subtitle", "time": 1205.549, "timestamp": "00:20:05", "text": "[音楽]"}, {"type": "subtitle", "time": 1223.59, "timestamp": "00:20:23", "text": "おお。私に食べさせてあげてほしいですか、それとも"}, {"type": "subtitle", "time": 1225.95, "timestamp": "00:20:25", "text": "何か？あなた"}, {"type": "subtitle", "time": 1229.909, "timestamp": "00:20:29", "text": "バカ。それから私は物語を語り始めました"}, {"type": "subtitle", "time": 1233.43, "timestamp": "00:20:33", "text": "私が小さな子供たちに食事を与えていた日、"}, {"type": "subtitle", "time": 1236.029, "timestamp": "00:20:36", "text": "小さなサテン"}, {"type": "subtitle", "time": 1238.35, "timestamp": "00:20:38", "text": "バカ。そんな"}, {"type": "subtitle", "time": 1242.549, "timestamp": "00:20:42", "text": "楽しいこと。ほら、私が食べさせたスプーンは"}, {"type": "subtitle", "time": 1246.35, "timestamp": "00:20:46", "text": "あのバカ、私は彼に"}, {"type": "subtitle", "time": 1250.09, "timestamp": "00:20:50", "text": "頭突き。さよなら、カワイイ。"}]
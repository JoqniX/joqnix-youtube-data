[{"type": "subtitle", "time": 18841.708, "timestamp": "05:14:01", "text": "もっと人手が必要だ。来る"}, {"type": "subtitle", "time": 18846.99, "timestamp": "05:14:06", "text": "の上。お前を迎えに行くぞ。"}, {"type": "subtitle", "time": 18857.628, "timestamp": "05:14:17", "text": "こんにちは、"}, {"type": "subtitle", "time": 18864.27, "timestamp": "05:14:24", "text": "こんにちは。来る"}, {"type": "subtitle", "time": 18896.628, "timestamp": "05:14:56", "text": "賞金首プレイヤー。来て。あなたは死ぬ"}]
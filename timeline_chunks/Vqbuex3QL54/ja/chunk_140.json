[{"type": "subtitle", "time": 8404.63, "timestamp": "02:20:04", "text": "心配。ああ、彼女は去ってしまった。わかった。こんにちは。となることによって"}, {"type": "subtitle", "time": 8407.429, "timestamp": "02:20:07", "text": "ゼン・キスメットは皆さんにとってそうでしたか。"}, {"type": "subtitle", "time": 8411.75, "timestamp": "02:20:11", "text": "あれはProject StasのZen Kismmetでした。"}, {"type": "subtitle", "time": 8414.23, "timestamp": "02:20:14", "text": "もしあなたが彼女と一緒にいるのが楽しかったなら、もしあなたが"}, {"type": "subtitle", "time": 8417.59, "timestamp": "02:20:17", "text": "彼女を楽しんだ、私たちの"}, {"type": "subtitle", "time": 8419.95, "timestamp": "02:20:19", "text": "今日の交流は、"}, {"type": "subtitle", "time": 8424.23, "timestamp": "02:20:24", "text": "無料のリアル。はい、どうぞご自由に購読してください。"}, {"type": "subtitle", "time": 8426.95, "timestamp": "02:20:26", "text": "そしてYouTubeで彼女をフォローし、"}, {"type": "subtitle", "time": 8429.67, "timestamp": "02:20:29", "text": "Twitchで配信しています。彼女はTwitchで配信している"}, {"type": "subtitle", "time": 8431.99, "timestamp": "02:20:31", "text": "時々そう思うこともある。だから、彼女をフォローしてあげて"}, {"type": "subtitle", "time": 8435.11, "timestamp": "02:20:35", "text": "まだ見ていないなら、Twitchで見てください。リンク"}, {"type": "subtitle", "time": 8437.91, "timestamp": "02:20:37", "text": "説明欄に記載されています。もしあなたが来るなら"}, {"type": "subtitle", "time": 8439.83, "timestamp": "02:20:39", "text": "YouTubeから引用したもので、説明欄に記載されています。"}, {"type": "subtitle", "time": 8443.27, "timestamp": "02:20:43", "text": "Twitch、Kビームなどを使用している場合、"}, {"type": "subtitle", "time": 8446.95, "timestamp": "02:20:46", "text": "固定コメントに記載されます。わかった。こんにちは。"}, {"type": "subtitle", "time": 8449.19, "timestamp": "02:20:49", "text": "ありがとう。それは、それはとても"}, {"type": "subtitle", "time": 8451.67, "timestamp": "02:20:51", "text": "名誉。あなたのものになれたことは本当に光栄でした"}, {"type": "subtitle", "time": 8456.309, "timestamp": "02:20:56", "text": "初めてのコラボで、本当に嬉しかったです"}, {"type": "subtitle", "time": 8457.469, "timestamp": "02:20:57", "text": "なぜなら"}]
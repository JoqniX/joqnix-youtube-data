[{"type": "subtitle", "time": 12480.269, "timestamp": "03:28:00", "text": "これは何ですか？これは中国語です、"}, {"type": "subtitle", "time": 12482.59, "timestamp": "03:28:02", "text": "右？これは"}, {"type": "subtitle", "time": 12485.51, "timestamp": "03:28:05", "text": "中国語。これは日本語です。私はこれを知っています"}, {"type": "subtitle", "time": 12486.429, "timestamp": "03:28:06", "text": "による"}, {"type": "subtitle", "time": 12489.469, "timestamp": "03:28:09", "text": "心臓。これは"}, {"type": "subtitle", "time": 12498.349, "timestamp": "03:28:18", "text": "耐久性が低い。"}, {"type": "subtitle", "time": 12502.19, "timestamp": "03:28:22", "text": "ああ、あなたにはあなたが必要とするもの"}, {"type": "subtitle", "time": 12505.03, "timestamp": "03:28:25", "text": "あぁ、必要なかったのに"}, {"type": "subtitle", "time": 12506.87, "timestamp": "03:28:26", "text": "そうする必要がある。"}, {"type": "subtitle", "time": 12508.87, "timestamp": "03:28:28", "text": "あ、待って。すでに中国語に変更されています"}, {"type": "subtitle", "time": 12511.11, "timestamp": "03:28:31", "text": "声。追加でダウンロードする必要はありませんでした"}, {"type": "subtitle", "time": 12521.75, "timestamp": "03:28:41", "text": "いいね。気持ち悪いボール。はい、弓使いの皆さん。えっと、でも"}, {"type": "subtitle", "time": 12524.309, "timestamp": "03:28:44", "text": "カラスの弓矢にすぎない。弓が欲しい"}, {"type": "subtitle", "time": 12526.79, "timestamp": "03:28:46", "text": "引っ張ったり詰め込んだりしないといけない。あなたが知っている、"}, {"type": "subtitle", "time": 12530.15, "timestamp": "03:28:50", "text": "クロスボウは簡単だ。うん、クロスボウは"}, {"type": "subtitle", "time": 12532.83, "timestamp": "03:28:52", "text": "気楽な人向け。私"}, {"type": "subtitle", "time": 12539.71, "timestamp": "03:28:59", "text": "帆。"}]
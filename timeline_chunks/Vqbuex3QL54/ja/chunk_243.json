[{"type": "subtitle", "time": 14581.79, "timestamp": "04:03:01", "text": "いいね。何が"}, {"type": "subtitle", "time": 14590.04, "timestamp": "04:03:10", "text": "パック。イメル。"}, {"type": "subtitle", "time": 14591.75, "timestamp": "04:03:11", "text": "[音楽]"}, {"type": "subtitle", "time": 14594.11, "timestamp": "04:03:14", "text": "これらの印を見てください。"}, {"type": "subtitle", "time": 14598.269, "timestamp": "04:03:18", "text": "くそ。彼らに必要なのはオーバーウォッチだけだった"}, {"type": "subtitle", "time": 14603.71, "timestamp": "04:03:23", "text": "コラボレーション。彼女はかわいいものが大好き"}, {"type": "subtitle", "time": 14613.03, "timestamp": "04:03:33", "text": "チャマ。ほとんどのコラボレーションは数量限定で行われる。えっと"}, {"type": "subtitle", "time": 14627.91, "timestamp": "04:03:47", "text": "レプリカント。ああ、5000。 5,000 が 5 つ必要です"}, {"type": "subtitle", "time": 14631.429, "timestamp": "04:03:51", "text": "彼らのうちの。ああ、私が考えていたのは"}, {"type": "subtitle", "time": 14633.34, "timestamp": "04:03:53", "text": "本物。これは"}]
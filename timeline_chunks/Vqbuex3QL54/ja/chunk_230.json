[{"type": "subtitle", "time": 13808.71, "timestamp": "03:50:08", "text": "この拳銃。よし、ピストルを取ろう"}, {"type": "subtitle", "time": 13812.389, "timestamp": "03:50:12", "text": "そして、試してみてください。行く時間だ、えっと、私は"}, {"type": "subtitle", "time": 13813.229, "timestamp": "03:50:13", "text": "のために"}, {"type": "subtitle", "time": 13822.469, "timestamp": "03:50:22", "text": "モード。遠距離攻撃型の兵士。ああ、バッグの拡張だ。"}, {"type": "subtitle", "time": 13828.79, "timestamp": "03:50:28", "text": "ああ！ああ、神様！ああ、神様！ああ、神様！ああ、神様！おお"}, {"type": "subtitle", "time": 13831.11, "timestamp": "03:50:31", "text": "神様！ああ、神様！走る！走る！走る！走る！走る！"}, {"type": "subtitle", "time": 13833.56, "timestamp": "03:50:33", "text": "走る！走る！走る！ 走る！おお"}, {"type": "subtitle", "time": 13842.59, "timestamp": "03:50:42", "text": "神様！ああ、私はこれで死ぬ"}, {"type": "subtitle", "time": 13844.83, "timestamp": "03:50:44", "text": "レート。私はそうしました"}, {"type": "subtitle", "time": 13848.03, "timestamp": "03:50:48", "text": "いや、待って。神様、これは"}, {"type": "subtitle", "time": 13850.55, "timestamp": "03:50:50", "text": "チュートリアル。遠距離武器はクロスボウです"}, {"type": "subtitle", "time": 13854.269, "timestamp": "03:50:54", "text": "ピストル、大砲、マスケット銃、弓。"}, {"type": "subtitle", "time": 13856.75, "timestamp": "03:50:56", "text": "わかった。神様、これは"}, {"type": "subtitle", "time": 13859.75, "timestamp": "03:50:59", "text": "チュートリアルがなければ私は"}]
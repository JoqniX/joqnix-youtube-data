[{"type": "subtitle", "time": 6002.79, "timestamp": "01:40:02", "text": "そうですよね？まるで私が思うように"}, {"type": "subtitle", "time": 6004.629, "timestamp": "01:40:04", "text": "楽しいゲームや笑いがあるのは知ってるよ"}, {"type": "chat", "time": 6006.499, "timestamp": "01:40:06", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "hello orange"}, {"type": "subtitle", "time": 6006.629, "timestamp": "01:40:06", "text": "などなど。私はそれが好きです。"}, {"type": "subtitle", "time": 6010.229, "timestamp": "01:40:10", "text": "でも時にはただ感じたいだけ"}, {"type": "subtitle", "time": 6014.149, "timestamp": "01:40:14", "text": "他の人は好きではないと感じる"}, {"type": "subtitle", "time": 6017.43, "timestamp": "01:40:17", "text": "別の人だけど、あなたの気持ちがわかる"}, {"type": "subtitle", "time": 6022.07, "timestamp": "01:40:22", "text": "彼らの心を知るなら、もしあなたがその心を知っているなら"}, {"type": "subtitle", "time": 6024.87, "timestamp": "01:40:24", "text": "それは理にかなっている、ただ持っているだけ"}, {"type": "subtitle", "time": 6027.109, "timestamp": "01:40:27", "text": "すべてがとても"}, {"type": "subtitle", "time": 6028.79, "timestamp": "01:40:28", "text": "ソーシャルメディアのように製造されている"}, {"type": "subtitle", "time": 6030.87, "timestamp": "01:40:30", "text": "捏造されたニュースは、あなたが"}, {"type": "chat", "time": 6030.969, "timestamp": "01:40:30", "author": "@OrangeSan", "avatar": "https://yt4.ggpht.com/1hzJ_11ALUfVaVrkxYo1ZVLPiK-9KSZ_F82omBSnvPLydlaR2DHr5h-PrrBJwHbm0GleoSyYuQ=s64-c-k-c0x00ffffff-no-rj", "message": "heyy Pratham and notpravin"}, {"type": "subtitle", "time": 6032.95, "timestamp": "01:40:32", "text": "人がどんな人間なのかさえ信用できない"}, {"type": "subtitle", "time": 6034.31, "timestamp": "01:40:34", "text": "なぜなら、"}, {"type": "subtitle", "time": 6035.91, "timestamp": "01:40:35", "text": "AIで製造された今、あなたは"}, {"type": "subtitle", "time": 6039.109, "timestamp": "01:40:39", "text": "本物かどうかを知るには、"}, {"type": "subtitle", "time": 6041.91, "timestamp": "01:40:41", "text": "知る。すべてが"}, {"type": "subtitle", "ti
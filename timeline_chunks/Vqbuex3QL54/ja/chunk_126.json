[{"type": "subtitle", "time": 7560.95, "timestamp": "02:06:00", "text": "それは何だろう？"}, {"type": "subtitle", "time": 7564.31, "timestamp": "02:06:04", "text": "うーん、わからない。 Hはどこにいますか？いいえ、あなた"}, {"type": "chat", "time": 7565.492, "timestamp": "02:06:05", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "don't overthink, don't even think, just don't do anything"}, {"type": "subtitle", "time": 7571.99, "timestamp": "02:06:11", "text": "ああ、いい質問ですね。"}, {"type": "subtitle", "time": 7573.229, "timestamp": "02:06:13", "text": "[音楽]"}, {"type": "subtitle", "time": 7575.39, "timestamp": "02:06:15", "text": "えっと、私は"}, {"type": "subtitle", "time": 7579.109, "timestamp": "02:06:19", "text": "知る。ええと、たくさんのことがあります"}, {"type": "subtitle", "time": 7581.43, "timestamp": "02:06:21", "text": "聞いてもいいですよね？"}, {"type": "subtitle", "time": 7583.189, "timestamp": "02:06:23", "text": "例えば、どんな質問をされたいですか？"}, {"type": "subtitle", "time": 7585.43, "timestamp": "02:06:25", "text": "例えば、あなたが聞きたい質問が1つあります"}, {"type": "subtitle", "time": 7586.87, "timestamp": "02:06:26", "text": "「お元気ですか？」と聞かれること。"}, {"type": "subtitle", "time": 7588.31, "timestamp": "02:06:28", "text": "いや、いや、そんなことは全くないよ。のように"}, {"type": "subtitle", "time": 7590.55, "timestamp": "02:06:30", "text": "「ああ、誰かに"}, {"type": "chat", "time": 7592.269, "timestamp": "02:06:32", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "THE QUESTION IS \"DO YOU WANT TO TALK TO ME ABOUT YOUR FAVOURITE FIREARM?\""}, {"type": "subtitle", "time": 7593.55, "timestamp": "02:06:33", "text": "あなたが知っていることを私に尋ねました"}, {"type": "chat", "time": 7601.876, "timestamp": "02:06:41", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "PLS SOMEONE ASK ME THIS QUESTION"}, {"type": "subtitle", "time": 7601.99, "timestamp": "02:06:41", "text": "えっと、わからない。話したい？"}, {"type": "subtitle", "time": 7605.43, "timestamp": "02:06:45", "text": "お気に入りの火災報知器について教えてください"}, {"type": "subtitle", "time": 7611.03, "timestamp": "02:06:51", "text": "すみません、いいえ、ジャシマのコメントを読みました"}, {"type": "subtitle", "time": 7613.669, "timestamp": "02:06:53", "text": "チャットも受け付けています。"}, {"type": "subtitle", "time": 7614.95, "timestamp": "02:06:54", "text": "質問したいのですが"}, {"type": "subtitle", "time": 7618.31, "timestamp": "02:06:58", "text": "聞かれたいです。"}, {"type": "subtitle", "time": 7619.75, "timestamp": "02:06:59", "text": "誰か私にこの質問をしてください。"}]
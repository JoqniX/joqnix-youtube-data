[{"type": "subtitle", "time": 13022.79, "timestamp": "03:37:02", "text": "赤を圧倒する。ええ、彼は白人です。私は"}, {"type": "subtitle", "time": 13029.91, "timestamp": "03:37:09", "text": "火炎放射器の力を使うつもりだ"}, {"type": "subtitle", "time": 13030.59, "timestamp": "03:37:10", "text": "に"}, {"type": "subtitle", "time": 13033.15, "timestamp": "03:37:13", "text": "ボンコから"}, {"type": "subtitle", "time": 13035.79, "timestamp": "03:37:15", "text": "存在。彼に気をつけろ"}, {"type": "subtitle", "time": 13037.309, "timestamp": "03:37:17", "text": "死ぬ。"}, {"type": "subtitle", "time": 13045.87, "timestamp": "03:37:25", "text": "けれど。これは"}, {"type": "subtitle", "time": 13050.99, "timestamp": "03:37:30", "text": "ロイヤル。何てことだ。止めて"}, {"type": "subtitle", "time": 13060.63, "timestamp": "03:37:40", "text": "なれ。修理不可。この修理が終わったら、"}, {"type": "subtitle", "time": 13063.55, "timestamp": "03:37:43", "text": "死んだ。あなたは死んでいます"}, {"type": "subtitle", "time": 13066.469, "timestamp": "03:37:46", "text": "肉。お前はもう終わりだ。うん、君は"}]
[{"type": "subtitle", "time": 13142.03, "timestamp": "03:39:02", "text": "殺す。なぜ英語なのか？"}, {"type": "subtitle", "time": 13147.75, "timestamp": "03:39:07", "text": "わかった。彼女が来るよ。災厄が迫っている。"}, {"type": "subtitle", "time": 13150.15, "timestamp": "03:39:10", "text": "プレイボードのチェーンサイト。彼女は見ていて楽しい"}, {"type": "subtitle", "time": 13154.79, "timestamp": "03:39:14", "text": "ユーザー。なくなるまで止まらない"}, {"type": "subtitle", "time": 13157.83, "timestamp": "03:39:17", "text": "見えない暗殺者。ダイヤモンド。"}, {"type": "subtitle", "time": 13159.83, "timestamp": "03:39:19", "text": "選択とは、単なる問いかけに過ぎない。これは"}, {"type": "subtitle", "time": 13162.63, "timestamp": "03:39:22", "text": "ヒーラー。私はいつもこれも"}, {"type": "subtitle", "time": 13165.19, "timestamp": "03:39:25", "text": "自らの意思でヒーラーになった。"}, {"type": "subtitle", "time": 13170.19, "timestamp": "03:39:30", "text": "彼女はこれらのキャプテンになるだろう。"}, {"type": "subtitle", "time": 13172.269, "timestamp": "03:39:32", "text": "わかった。水"}, {"type": "subtitle", "time": 13175.03, "timestamp": "03:39:35", "text": "エネルギー。これはどうでしょう？私はここにいます"}, {"type": "subtitle", "time": 13178.349, "timestamp": "03:39:38", "text": "まもなくチャンピオンになる。ああ、メッカユーザーですね。"}, {"type": "subtitle", "time": 13180.11, "timestamp": "03:39:40", "text": "わかった。"}, {"type": "subtitle", "time": 13183.429, "timestamp": "03:39:43", "text": "ああ、あなたは？"}, {"type": "subtitle", "time": 13186.469, "timestamp": "03:39:46", "text": "これは実際の戦闘機です。彼"}, {"type": "subtitle", "time": 13190.95, "timestamp": "03:39:50", "text": "彼は手を使う。わかった。あなたはどうですか？"}, {"type": "subtitle", "time": 13195.19, "timestamp": "03:39:55", "text": "ああ、彼は本当に負け犬だ。わかった。では"}, {"type": "subtitle", "time": 13196.11, "timestamp": "03:39:56", "text": "これ"}, {"type": "subtitle", "time": 13199.83, "timestamp": "03:39:59", "text": "男？霜と氷。わかった。では"}]
[{"type": "subtitle", "time": 16322.149, "timestamp": "04:32:02", "text": "に。つまり、あなたは何人かの強豪選手と出会ったということですね。"}, {"type": "subtitle", "time": 16324.28, "timestamp": "04:32:04", "text": "あれらはボットです。"}, {"type": "subtitle", "time": 16327.309, "timestamp": "04:32:07", "text": "[音楽]"}, {"type": "subtitle", "time": 16329.63, "timestamp": "04:32:09", "text": "わかった。レベル"}, {"type": "subtitle", "time": 16332.59, "timestamp": "04:32:12", "text": "4つのスキル"}, {"type": "subtitle", "time": 16338.03, "timestamp": "04:32:18", "text": "分散。えーと、英雄育成。ああ、"}, {"type": "subtitle", "time": 16348.389, "timestamp": "04:32:28", "text": "ああ、ジャーニー・ドーン。これは何ですか？遊ぶ"}, {"type": "subtitle", "time": 16356.79, "timestamp": "04:32:36", "text": "全て。よし、じゃあハードにやろう。さあ"}, {"type": "subtitle", "time": 16357.9, "timestamp": "04:32:37", "text": "どうやってそれが"}, {"type": "subtitle", "time": 16360.75, "timestamp": "04:32:40", "text": "[音楽]"}, {"type": "subtitle", "time": 16364.71, "timestamp": "04:32:44", "text": "行く。これらは全てプレイできません。私"}, {"type": "subtitle", "time": 16366.99, "timestamp": "04:32:46", "text": "レベルアップが必要みたいだ。"}, {"type": "subtitle", "time": 16370.07, "timestamp": "04:32:50", "text": "ああ、もう行かなきゃ。それでは、また。こんにちは。"}, {"type": "subtitle", "time": 16373.03, "timestamp": "04:32:53", "text": "ありがとう。一緒に遊んでくれてありがとう。"}, {"type": "subtitle", "time": 16374.59, "timestamp": "04:32:54", "text": "そして私に教えてくれる"}, {"type": "subtitle", "time": 16377.309, "timestamp": "04:32:57", "text": "ゲーム。感謝"}]
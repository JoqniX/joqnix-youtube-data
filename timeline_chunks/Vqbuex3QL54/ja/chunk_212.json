[{"type": "subtitle", "time": 12721.71, "timestamp": "03:32:01", "text": "私は推測する"}, {"type": "subtitle", "time": 12759.429, "timestamp": "03:32:39", "text": "わかった。ああ、それはできますよ。ああ、光"}, {"type": "subtitle", "time": 12761.83, "timestamp": "03:32:41", "text": "効果。特殊な照明効果。カウンタ"}, {"type": "subtitle", "time": 12762.99, "timestamp": "03:32:42", "text": "ストライキピックアップ"}, {"type": "subtitle", "time": 12765.83, "timestamp": "03:32:45", "text": "武器。通気孔付きカウンター。敵が"}, {"type": "subtitle", "time": 12768.15, "timestamp": "03:32:48", "text": "特別な光で点滅する"}, {"type": "subtitle", "time": 12769.67, "timestamp": "03:32:49", "text": "青い焦点の迷走を放つ、つまり"}, {"type": "subtitle", "time": 12775.95, "timestamp": "03:32:55", "text": "攻撃。ああ、わかりました。"}]
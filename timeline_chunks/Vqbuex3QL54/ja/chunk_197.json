[{"type": "subtitle", "time": 11821.19, "timestamp": "03:17:01", "text": "えーと、武道みたいな"}, {"type": "subtitle", "time": 11825.19, "timestamp": "03:17:05", "text": "えーと、バトルロイヤルゲーム。私は"}, {"type": "subtitle", "time": 11827.51, "timestamp": "03:17:07", "text": "正直に言うと、このゲームが発売されたとき"}, {"type": "subtitle", "time": 11829.59, "timestamp": "03:17:09", "text": "去年のことだったかな、実際に"}, {"type": "subtitle", "time": 11832.63, "timestamp": "03:17:12", "text": "出てきた。プレイしたかったんです。"}, {"type": "subtitle", "time": 11836.55, "timestamp": "03:17:16", "text": "しかし、これまでは無料ではなかった。それは"}, {"type": "subtitle", "time": 11839.349, "timestamp": "03:17:19", "text": "無料。誰でも無料でプレイできます"}, {"type": "subtitle", "time": 11842.349, "timestamp": "03:17:22", "text": "Epic Games を通じて、"}, {"type": "subtitle", "time": 11844.469, "timestamp": "03:17:24", "text": "もの。しかしその前に私は"}, {"type": "subtitle", "time": 11847.269, "timestamp": "03:17:27", "text": "ストリーミング配信をしたい。私は、えっと、"}, {"type": "subtitle", "time": 11849.19, "timestamp": "03:17:29", "text": "ゲームパスを購入してプレイすればいいでしょうか？"}, {"type": "subtitle", "time": 11852.71, "timestamp": "03:17:32", "text": "いつか配信でやるのか？それから数時間後"}, {"type": "subtitle", "time": 11856.79, "timestamp": "03:17:36", "text": "数ヶ月後、ええと、無料になりました。私はとても幸せです"}, {"type": "subtitle", "time": 11858.269, "timestamp": "03:17:38", "text": "この"}, {"type": "subtitle", "time": 11861.269, "timestamp": "03:17:41", "text": "ゲームがついに無料になった。楽しい"}, {"type": "subtitle", "time": 11864.71, "timestamp": "03:17:44", "text": "正直に言うと、ゲームですね。えっと、"}, {"type": "subtitle", "time": 11866.87, "timestamp": "03:17:46", "text": "ゲームの仕組みとかそういうのは"}, {"type": "subtitle", "time": 11870.07, "timestamp": "03:17:50", "text": "理解するのが少し難しい"}, {"type": "subtitle", "time": 11873.15, "timestamp": "03:17:53", "text": "オンですが、それ以外は良いです"}, {"type": "subtitle", "time": 11878.429, "timestamp": "03:17:58", "text": "いい試合だった。うん、君たちも楽しむべきだよ"}]
[{"type": "subtitle", "time": 362.71, "timestamp": "00:06:02", "text": "ゲストですよね？うん。うん。今週の土曜日"}, {"type": "subtitle", "time": 365.51, "timestamp": "00:06:05", "text": "パイになるはずだった"}, {"type": "subtitle", "time": 368.79, "timestamp": "00:06:08", "text": "コラボの日だったけど、1日は寝て過ごして、"}, {"type": "subtitle", "time": 372.39, "timestamp": "00:06:12", "text": "そのうちの1つは、スケジュールの問題です。彼らは"}, {"type": "subtitle", "time": 374.309, "timestamp": "00:06:14", "text": "時差の関係で行けませんでした。"}, {"type": "subtitle", "time": 377.749, "timestamp": "00:06:17", "text": "間違いも含め、すべて。えーと緊急事態として"}, {"type": "subtitle", "time": 381.35, "timestamp": "00:06:21", "text": "良い。ええ、私は、私は、"}, {"type": "subtitle", "time": 383.029, "timestamp": "00:06:23", "text": "まだコラボレーションを完了する必要があります"}, {"type": "subtitle", "time": 385.909, "timestamp": "00:06:25", "text": "私が"}, {"type": "subtitle", "time": 387.43, "timestamp": "00:06:27", "text": "本当にコラボしたかったのですが"}, {"type": "subtitle", "time": 389.07, "timestamp": "00:06:29", "text": "長い間できなかった"}, {"type": "subtitle", "time": 392.95, "timestamp": "00:06:32", "text": "その間。ああ、まだまだたくさんいるよ。えっと"}, {"type": "subtitle", "time": 396.11, "timestamp": "00:06:36", "text": "ええ、聞いてみます。"}, {"type": "subtitle", "time": 399.99, "timestamp": "00:06:39", "text": "うん、聞いてみて。ああ、でもそうだよ、"}, {"type": "subtitle", "time": 403.43, "timestamp": "00:06:43", "text": "それは私が戻ってきてから考えます。えっと"}, {"type": "subtitle", "time": 406.23, "timestamp": "00:06:46", "text": "10分後に戻ります。どうぞ"}, {"type": "subtitle", "time": 407.469, "timestamp": "00:06:47", "text": "楽しむ"}, {"type": "subtitle", "time": 410.55, "timestamp": "00:06:50", "text": "ヴォード。えっと、10分後に戻ります。"}, {"type": "subtitle", "time": 413.35, "timestamp": "00:06:53", "text": "えっと、全部セットアップしますね。"}, {"type": "subtitle", "time": 416.469, "timestamp": "00:06:56", "text": "そして、少ししたらゼンと合流します。ええと、楽しんでください"}, {"type": "subtitle", "time": 419.51, "timestamp": "00:06:59", "text": "va。心配しないで。ええと、私たちは"}]
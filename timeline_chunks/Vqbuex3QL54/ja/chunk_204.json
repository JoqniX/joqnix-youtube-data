[{"type": "subtitle", "time": 12246.07, "timestamp": "03:24:06", "text": "刑務所。保存。これを保存しておきます。ああ、なんてことだ、私の"}, {"type": "subtitle", "time": 12248.469, "timestamp": "03:24:08", "text": "耳から血が出ている。"}, {"type": "subtitle", "time": 12250.75, "timestamp": "03:24:10", "text": "少なくとも君たちにとっては、"}, {"type": "subtitle", "time": 12253.67, "timestamp": "03:24:13", "text": "六。あなたはこれを聞かないだろうけど、私にとって"}, {"type": "subtitle", "time": 12256.51, "timestamp": "03:24:16", "text": "ここは"}, {"type": "subtitle", "time": 12259.83, "timestamp": "03:24:19", "text": "すべて。オーケー、これはああ神様、それは"}, {"type": "subtitle", "time": 12262.71, "timestamp": "03:24:22", "text": "それでもまだ鋭い。ああ、神様。私にさせて"}, {"type": "subtitle", "time": 12264.11, "timestamp": "03:24:24", "text": "ロードする"}, {"type": "subtitle", "time": 12267.83, "timestamp": "03:24:27", "text": "また。よし、これは少しはプレイできる"}, {"type": "subtitle", "time": 12271.03, "timestamp": "03:24:31", "text": "少し。これを保存しておけば、"}, {"type": "subtitle", "time": 12273.269, "timestamp": "03:24:33", "text": "前回のようにびっくりしない"}, {"type": "subtitle", "time": 12279.55, "timestamp": "03:24:39", "text": "私がパソコンを使っていなかった時。こんにちは。 Wと"}, {"type": "subtitle", "time": 12281.71, "timestamp": "03:24:41", "text": "空間。わかった、"}, {"type": "subtitle", "time": 12286.15, "timestamp": "03:24:46", "text": "簡単。タップ。ああ、肘をつくんだね。ああ、"}, {"type": "subtitle", "time": 12288.79, "timestamp": "03:24:48", "text": "ああ、この武術のスタイルを見てください。"}, {"type": "subtitle", "time": 12291.83, "timestamp": "03:24:51", "text": "もうこのゲームが大好きだ。鎧。どうやって"}, {"type": "subtitle", "time": 12293.91, "timestamp": "03:24:53", "text": "幸運だ。"}, {"type": "subtitle", "time": 12296.15, "timestamp": "03:24:56", "text": "それらの隠し場所には、置き去りにされた品物が入っている。"}]
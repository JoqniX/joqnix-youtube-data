[{"type": "subtitle", "time": 13266.07, "timestamp": "03:41:06", "text": "ステルス機も手に入れたよ。わかった。えっと、私は"}, {"type": "subtitle", "time": 13267.95, "timestamp": "03:41:07", "text": "これで行きたい"}, {"type": "subtitle", "time": 13270.91, "timestamp": "03:41:10", "text": "男。これは違う。これ"}, {"type": "subtitle", "time": 13273.99, "timestamp": "03:41:13", "text": "1つ。領主を持つ魔女の女性"}, {"type": "subtitle", "time": 13277.59, "timestamp": "03:41:17", "text": "長い剣みたいなもの。"}, {"type": "subtitle", "time": 13283.229, "timestamp": "03:41:23", "text": "[音楽]"}, {"type": "subtitle", "time": 13287.11, "timestamp": "03:41:27", "text": "ブレード。ヒーローを選択する方法。"}, {"type": "subtitle", "time": 13289.55, "timestamp": "03:41:29", "text": "ああ、それは選択できません。わかった。高度な"}, {"type": "subtitle", "time": 13297.95, "timestamp": "03:41:37", "text": "わかった。"}, {"type": "subtitle", "time": 13301.99, "timestamp": "03:41:41", "text": "ハヤティアは他のプレイヤーたちです。わかった。ようこそ"}, {"type": "subtitle", "time": 13305.03, "timestamp": "03:41:45", "text": "モリス島では、最大60人の英雄が"}, {"type": "subtitle", "time": 13307.59, "timestamp": "03:41:47", "text": "国中から人々が集まり、戦いを繰り広げる。 60"}, {"type": "subtitle", "time": 13310.309, "timestamp": "03:41:50", "text": "プレイヤー。まず、場所を選択してください。"}, {"type": "subtitle", "time": 13312.95, "timestamp": "03:41:52", "text": "スポーン地点を指定してください。一部の地域"}, {"type": "subtitle", "time": 13314.79, "timestamp": "03:41:54", "text": "物資や設備は"}, {"type": "subtitle", "time": 13318.87, "timestamp": "03:41:58", "text": "その他。しかし、注意してください。さらなる富"}]
[{"type": "subtitle", "time": 5401.91, "timestamp": "01:30:01", "text": "もし私が誰かのところへ行って"}, {"type": "subtitle", "time": 5404.229, "timestamp": "01:30:04", "text": "もしくは、私がそれらをすぐに選んでいる"}, {"type": "subtitle", "time": 5406.79, "timestamp": "01:30:06", "text": "みんながそう思うように"}, {"type": "subtitle", "time": 5410.709, "timestamp": "01:30:10", "text": "そういうこともあるし、もう一つは"}, {"type": "chat", "time": 5410.884, "timestamp": "01:30:10", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "you mean so much to them"}, {"type": "subtitle", "time": 5413.99, "timestamp": "01:30:13", "text": "そうですね、信頼"}, {"type": "subtitle", "time": 5417.189, "timestamp": "01:30:17", "text": "信頼というものは、"}, {"type": "subtitle", "time": 5421.27, "timestamp": "01:30:21", "text": "簡単に壊れる、それは本当だ"}, {"type": "subtitle", "time": 5423.189, "timestamp": "01:30:23", "text": "ええ、たとえあなたが友達だったとしても"}, {"type": "chat", "time": 5424.074, "timestamp": "01:30:24", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "true"}, {"type": "subtitle", "time": 5427.03, "timestamp": "01:30:27", "text": "12年間、20年間、10年間、あるいは5年間、私は"}, {"type": "subtitle", "time": 5428.629, "timestamp": "01:30:28", "text": "わからない"}, {"type": "subtitle", "time": 5432.95, "timestamp": "01:30:32", "text": "はい、時々歌う人もいます"}, {"type": "subtitle", "time": 5435.35, "timestamp": "01:30:35", "text": "たった一つのミスが、"}, {"type": "subtitle", "time": 5438.709, "timestamp": "01:30:38", "text": "彼らが長年友情を育んできた"}, {"type": "subtitle", "time": 5440.709, "timestamp": "01:30:40", "text": "彼らが持っていた信頼は"}, {"type": "subtitle", "time": 5443.27, "timestamp": "01:30:43", "text": "彼らには失望した。その人でさえ"}, {"type": "subtitle", "time": 5445.43, "timestamp": "01:30:45", "text": "彼ら自身は知らないし理解もしていない"}, {"type": "subtitle", "time": 5448.229, "timestamp": "01:30:48", "text": "彼らは間違いを犯し、今も同じことを繰り返している。"}, {"type": "subtitle", "time": 5451.35, "timestamp": "01:30:51", "text": "相手を尊重しない。彼らは"}, {"type": "subtitle", "time": 5453.59, "timestamp": "01:30:53", "text": "うん、あなたは友達じゃなかったと思う"}, {"type": "subtitle", "time": 5456.229, "timestamp": "01:30:56", "text": "そもそも私自身が主役である、というような話です。"}, {"type": "subtitle", "time": 5459.91, "timestamp": "01:30:59", "text": "そして、私のような人もいる。"}]
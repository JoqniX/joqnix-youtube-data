[{"type": "subtitle", "time": 14238.79, "timestamp": "03:57:18", "text": "死にかけている。私の"}, {"type": "subtitle", "time": 14241.429, "timestamp": "03:57:21", "text": "キーボード？それとも、ゲームの問題なのか？ない"}, {"type": "subtitle", "time": 14252.389, "timestamp": "03:57:32", "text": "最近。よし、このパンを5つ。私にさせて"}, {"type": "subtitle", "time": 14256.03, "timestamp": "03:57:36", "text": "私にあなたを癒させてください"}, {"type": "subtitle", "time": 14259.07, "timestamp": "03:57:39", "text": "バカ。私を癒してください"}, {"type": "subtitle", "time": 14261.59, "timestamp": "03:57:41", "text": "平和的に。私はあなたに会いに行きます"}, {"type": "subtitle", "time": 14263.87, "timestamp": "03:57:43", "text": "少し。待って、ちょっと待って"}, {"type": "subtitle", "time": 14266.59, "timestamp": "03:57:46", "text": "少し。私を癒してください。よし、彼は去ったか"}, {"type": "subtitle", "time": 14269.55, "timestamp": "03:57:49", "text": "何か。はい、彼は去りました。そして私に"}, {"type": "subtitle", "time": 14273.389, "timestamp": "03:57:53", "text": "癒す。私でしょうか？笑。"}, {"type": "subtitle", "time": 14279.95, "timestamp": "03:57:59", "text": "行く？あの野郎はどこに行ったんだ"}]
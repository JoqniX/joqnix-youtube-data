[{"type": "subtitle", "time": 9841.429, "timestamp": "02:44:01", "text": "私はそのゲームを一緒にプレイできたらいいのにと思っています"}, {"type": "subtitle", "time": 9843.59, "timestamp": "02:44:03", "text": "誰か。海石はそれをプレイしたい"}, {"type": "subtitle", "time": 9845.349, "timestamp": "02:44:05", "text": "私と一緒に。構わないよ"}, {"type": "subtitle", "time": 9848.389, "timestamp": "02:44:08", "text": "彼らとはまるでスプリットフィクションのようにプレイしている。"}, {"type": "subtitle", "time": 9854.309, "timestamp": "02:44:14", "text": "もう一度言いますが、私はそれがより良いと感じます"}, {"type": "subtitle", "time": 9856.71, "timestamp": "02:44:16", "text": "もし私がCDショーをやっているなら"}, {"type": "subtitle", "time": 9859.91, "timestamp": "02:44:19", "text": "通常のコラボレーションなどすべて"}, {"type": "subtitle", "time": 9862.23, "timestamp": "02:44:22", "text": "えーと、複数の部品が必要で"}, {"type": "subtitle", "time": 9863.67, "timestamp": "02:44:23", "text": "すべて。とても"}, {"type": "subtitle", "time": 9865.91, "timestamp": "02:44:25", "text": "より良い。私は日本からそれを行います"}, {"type": "subtitle", "time": 9887.87, "timestamp": "02:44:47", "text": "うん。でも、本当に嬉しいです"}, {"type": "subtitle", "time": 9896.03, "timestamp": "02:44:56", "text": "彼らはまだそこにいる"}]
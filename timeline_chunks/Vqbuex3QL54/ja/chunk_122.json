[{"type": "subtitle", "time": 7322.99, "timestamp": "02:02:02", "text": "ポイント。それはとても痛くて恥ずかしい"}, {"type": "subtitle", "time": 7326.709, "timestamp": "02:02:06", "text": "瞬間。何てことだ。はい。あなたはとても"}, {"type": "subtitle", "time": 7328.629, "timestamp": "02:02:08", "text": "考えてみると面白いですね。君はすごくかっこいい"}, {"type": "subtitle", "time": 7330.87, "timestamp": "02:02:10", "text": "それについて考えている。まだ考えている"}, {"type": "subtitle", "time": 7333.43, "timestamp": "02:02:13", "text": "私のことについて、私は知っている、"}, {"type": "subtitle", "time": 7340.629, "timestamp": "02:02:20", "text": "でもそれはあなたにとってとても恥ずかしいことです"}, {"type": "subtitle", "time": 7353.589, "timestamp": "02:02:33", "text": "全身がこわばるような感じ"}, {"type": "subtitle", "time": 7355.229, "timestamp": "02:02:35", "text": "考えている"}, {"type": "subtitle", "time": 7358.149, "timestamp": "02:02:38", "text": "恥ずかしい、恥ずかしい、えっと"}, {"type": "chat", "time": 7358.2, "timestamp": "02:02:38", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "someone forced me to dance on stage and recorded it once"}, {"type": "subtitle", "time": 7359.83, "timestamp": "02:02:39", "text": "恥ずかしい話だ。私が思うに、ほとんどの"}, {"type": "subtitle", "time": 7361.83, "timestamp": "02:02:41", "text": "私の恥ずかしいことはこんな感じ"}, {"type": "subtitle", "time": 7365.99, "timestamp": "02:02:45", "text": "オンラインで時々、えーと時々"}, {"type": "subtitle", "time": 7368.31, "timestamp": "02:02:48", "text": "えーと、これこれこれ"}, {"type": "subtitle", "time": 7370.79, "timestamp": "02:02:50", "text": "数年前に私の"}, {"type": "subtitle", "time": 7375.669, "timestamp": "02:02:55", "text": "私の友達は、えっと、"}, {"type": "subtitle", "time": 7378.39, "timestamp": "02:02:58", "text": "この男はそうで、それから、よし、それから"}]
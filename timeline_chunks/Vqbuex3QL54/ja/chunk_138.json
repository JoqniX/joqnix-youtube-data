[{"type": "subtitle", "time": 8282.389, "timestamp": "02:18:02", "text": "あなた。それは非常に意義深く、真摯なものでした。"}, {"type": "subtitle", "time": 8284.95, "timestamp": "02:18:04", "text": "とても気に入りました。つまり、それは"}, {"type": "subtitle", "time": 8286.469, "timestamp": "02:18:06", "text": "それは私の将来の基準になったと思う"}, {"type": "subtitle", "time": 8289.709, "timestamp": "02:18:09", "text": "外部との連携。それでは"}, {"type": "subtitle", "time": 8292.309, "timestamp": "02:18:12", "text": "見る。わかった。どうもありがとう。ありがとう"}, {"type": "subtitle", "time": 8294.709, "timestamp": "02:18:14", "text": "そんなに。そして、あなたは持っている"}, {"type": "subtitle", "time": 8296.629, "timestamp": "02:18:16", "text": "素晴らしい夜になりそうだ。わかった。そしてよく食べてください。"}, {"type": "subtitle", "time": 8299.429, "timestamp": "02:18:19", "text": "安心して休んでください。スピードを出しすぎないでください。食べる。柔らかいものを食べてください。"}, {"type": "subtitle", "time": 8301.349, "timestamp": "02:18:21", "text": "ゆっくり食べましょう。美味しく召し上がってください。さもないと"}, {"type": "subtitle", "time": 8303.03, "timestamp": "02:18:23", "text": "ガソリンを入れる。"}, {"type": "subtitle", "time": 8304.87, "timestamp": "02:18:24", "text": "はい。はい。それは私がこれからやろうとしていることです"}, {"type": "subtitle", "time": 8308.11, "timestamp": "02:18:28", "text": "を通して。うん。"}, {"type": "subtitle", "time": 8311.589, "timestamp": "02:18:31", "text": "わかった。ありがとう、ニクソン。さよなら。私は"}, {"type": "subtitle", "time": 8315.75, "timestamp": "02:18:35", "text": "今すぐ私を受け取って。ありがとう。"}, {"type": "subtitle", "time": 8317.429, "timestamp": "02:18:37", "text": "お帰りになる前に、何かご用はありますか？"}, {"type": "chat", "time": 8319.467, "timestamp": "02:18:39", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "ty zen"}, {"type": "subtitle", "time": 8319.75, "timestamp": "02:18:39", "text": "発表したいイベントや"}, {"type": "subtitle", "time": 8321.99, "timestamp": "02:18:41", "text": "ストリームのアップデートやその他何でもご希望があれば"}, {"type": "chat", "time": 8324.326, "timestamp": "02:18:44", "author": "@prathampro", "avatar"
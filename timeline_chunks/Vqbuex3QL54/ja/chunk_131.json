[{"type": "subtitle", "time": 7860.47, "timestamp": "02:11:00", "text": "私はすでに特定の"}, {"type": "subtitle", "time": 7863.75, "timestamp": "02:11:03", "text": "あなたが誰で、誰が"}, {"type": "subtitle", "time": 7865.589, "timestamp": "02:11:05", "text": "あなたはそうだったし、そういうことだった。でも、"}, {"type": "subtitle", "time": 7866.95, "timestamp": "02:11:06", "text": "あなたと話した後、ご存知のように"}, {"type": "subtitle", "time": 7869.35, "timestamp": "02:11:09", "text": "1時間くらいかけて"}, {"type": "subtitle", "time": 7870.79, "timestamp": "02:11:10", "text": "あなたがこれに答えることについて話しています"}, {"type": "subtitle", "time": 7872.47, "timestamp": "02:11:12", "text": "質問のやり取りが、"}, {"type": "subtitle", "time": 7874.229, "timestamp": "02:11:14", "text": "私はもっ​​と鮮明な写真が好きです"}, {"type": "subtitle", "time": 7876.47, "timestamp": "02:11:16", "text": "あなたはどんな人ですか？あなたが何を考えていますか？"}, {"type": "subtitle", "time": 7879.43, "timestamp": "02:11:19", "text": "あなたは自分にとって何が重要かを知っていて、"}, {"type": "subtitle", "time": 7882.229, "timestamp": "02:11:22", "text": "あなたも知っているように、"}, {"type": "subtitle", "time": 7884.149, "timestamp": "02:11:24", "text": "あなたが言ったことは本当です"}, {"type": "subtitle", "time": 7885.51, "timestamp": "02:11:25", "text": "あなたが好きで、あなたが助けたいと思う"}, {"type": "subtitle", "time": 7887.35, "timestamp": "02:11:27", "text": "人々はそう感じ、あなたはそうする"}, {"type": "subtitle", "time": 7888.95, "timestamp": "02:11:28", "text": "実はとてもとても役に立つ"}, {"type": "subtitle", "time": 7891.109, "timestamp": "02:11:31", "text": "私が知っている最も親切な人たちは"}, {"type": "subtitle", "time": 7893.03, "timestamp": "02:11:33", "text": "数えきれないほど"}, {"type": "subtitle", "time": 7895.91, "timestamp": "02:11:35", "text": "あなたが私を助けてくれた時"}, {"type": "subtitle", "time": 7897.99, "timestamp": "02:11:37", "text": "それらはとても些細なことで、"}, {"type": "subtitle", "time": 7900.55, "timestamp": "02:11:40", "text": "だから、シンプルだけど、"}, {"type": "subtitle", "time": 7902.229, "timestamp": "02:11:42", "text": "まるであなたが私をバカにしているみたい"}, {"type": "subtitle", "time": 7904.149, "timestamp": "02:11:44", "text": "まあ、大丈夫だよ、わかってるでしょ、"}, {"type": "subtitle", "time": 7906.149, "timestamp": "02:11:46", "text": "解決策を見つけ出す、これを直す"}, {"type": "subtitle", "time": 7907.83, "timestamp": "02:11:47", "text": "それはとても素敵ですね、だって"}, {"type": "subtitle", "time": 7909.83, "timestamp": "02:11:49", "text": "すでにその要素がある"}, {"type": "subtitle", "time": 7911.43, "timestamp": "02:11:51", "text": "イライラする、なぜこれが"}, {"type": "subtitle", "time": 7913.27, "timestamp": "02:11:53", "text": "起こっていることはすべてテクノロジーであり、"}, {"type": "subtitle", "time": 7914.709, "timestamp": "02:11:54", "text": "いろいろなものがあって、ほら、ちょっと立ち寄って"}, {"type": "subtitle", "time": 7916.39, "timestamp": "02:11:56", "text": "あなたは私を助けてくれて、私は"}, {"type": "chat", "time": 7916.76, "timestamp": "02:11:56", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "JOQ IS LITERALLY THE BEST HELPER"}, {"type": "subtitle", "time": 7918.95, "timestamp": "02:11:58", "text": "いつもそのことに感謝していますし、"}]
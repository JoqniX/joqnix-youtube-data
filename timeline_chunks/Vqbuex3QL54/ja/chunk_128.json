[{"type": "subtitle", "time": 7680.069, "timestamp": "02:08:00", "text": "10年後、あなたはどこにいると思いますか？"}, {"type": "subtitle", "time": 7682.55, "timestamp": "02:08:02", "text": "何年か、5年くらい？意思"}, {"type": "subtitle", "time": 7685.27, "timestamp": "02:08:05", "text": "あなたはいつ卒業しますか？"}, {"type": "subtitle", "time": 7689.069, "timestamp": "02:08:09", "text": "何か？ Vチュービングまたは"}, {"type": "subtitle", "time": 7691.91, "timestamp": "02:08:11", "text": "えっと、あなたは人生で誰かを見つけるでしょうか"}, {"type": "subtitle", "time": 7694.39, "timestamp": "02:08:14", "text": "そしてYouTuberとしても彼らを連れて行く"}, {"type": "chat", "time": 7696.79, "timestamp": "02:08:16", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "this is a whole ass job interview not a Collab stream"}, {"type": "subtitle", "time": 7698.51, "timestamp": "02:08:18", "text": "あなたの配信か何かで"}, {"type": "subtitle", "time": 7701.669, "timestamp": "02:08:21", "text": "あるいは、いつジョックをデビューさせるつもりですか、"}, {"type": "subtitle", "time": 7703.709, "timestamp": "02:08:23", "text": "それ"}, {"type": "chat", "time": 7708.052, "timestamp": "02:08:28", "author": "@zergrush78319", "avatar": "https://yt4.ggpht.com/ytc/AIdro_nDwl-xtQg1-Z5v6Iv64Z42_Hei-15daYPmWXqoFR-4_b8=s64-c-k-c0x00ffffff-no-rj", "message": "what was the question?"}, {"type": "subtitle", "time": 7708.31, "timestamp": "02:08:28", "text": "もの？人生において多くのこと、"}, {"type": "subtitle", "time": 7711.75, "timestamp": "02:08:31", "text": "チューニングに関して。えっと、答えは"}, {"type": "subtitle", "time": 7714.47, "timestamp": "02:08:34", "text": "その質問は、えーっと、私は"}, {"type": "subtitle", "time": 7716.709, "timestamp": "02:08:36", "text": "全く予想していなかった。"}, {"type": "subtitle", "time": 7718.39, "timestamp": "02:08:38", "text": "わかった。目に見えないもの"}, {"type": "subtitle", "time": 7721.589, "timestamp": "02:08:41", "text": "来るよ。わかった。予兆あり。うん。わかった。"}, {"type": "subtitle", "time": 7723.91, "timestamp": "02:08:43", "text": "誰かが「よし、全部仕事だ」と言った"}, {"type": "subtitle", "time": 7726.149, "timestamp": "02:08:46", "text": "インタビュー。これはポッドキャストストリームではありません。"}, {"type": "subtitle", "time": 7728.31, "timestamp": "02:08:48", "text": "あなたは知らなかったかもしれないが、今はそうなのだ。しかし"}, {"type": "subtitle", "time": 7731.669, "timestamp": "02:08:51", "text": "ズルギの質問は、"}, {"type": "subtitle", "time": 7733.51, "timestamp": "02:08:53", "text": "誰かに聞かれたらいいなと思う質問"}, {"type": "subtitle", "time": 7737.35, "timestamp": "02:08:57", "text": "それは一体何だろうか？私にとっては"}, {"type": "subtitle", "time": 7739.709, "timestamp": "02:08:59", "text": "なれ"}]
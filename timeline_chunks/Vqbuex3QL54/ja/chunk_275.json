[{"type": "subtitle", "time": 16500.67, "timestamp": "04:35:00", "text": "どこ？はぁ？わかった。過激"}, {"type": "subtitle", "time": 16509.91, "timestamp": "04:35:09", "text": "ロシア、伝説の化粧品。"}, {"type": "subtitle", "time": 16512.31, "timestamp": "04:35:12", "text": "そこに何があるのか​​、全部見えますか？ああ、君"}, {"type": "subtitle", "time": 16520.839, "timestamp": "04:35:20", "text": "わかった。ああ、化粧品がたくさんある"}, {"type": "subtitle", "time": 16523.39, "timestamp": "04:35:23", "text": "[音楽]"}, {"type": "subtitle", "time": 16527.59, "timestamp": "04:35:27", "text": "もの。おお。ああ、絵文字もあるよ。"}, {"type": "subtitle", "time": 16534.83, "timestamp": "04:35:34", "text": "これ？"}, {"type": "subtitle", "time": 16538.629, "timestamp": "04:35:38", "text": "おお。たくさんの服。"}, {"type": "subtitle", "time": 16542.869, "timestamp": "04:35:42", "text": "それは神話的なものですよね？これは何ですか？"}, {"type": "subtitle", "time": 16548.349, "timestamp": "04:35:48", "text": "ああ、２つ。これはネオアタではないか？おお、"}, {"type": "subtitle", "time": 16552.07, "timestamp": "04:35:52", "text": "わかった。なるほど。わかった。これはどうでしょう？何"}, {"type": "subtitle", "time": 16554.9, "timestamp": "04:35:54", "text": "あれは？不死身"}, {"type": "subtitle", "time": 16556.59, "timestamp": "04:35:56", "text": "[音楽]"}, {"type": "subtitle", "time": 16559.869, "timestamp": "04:35:59", "text": "宝物。たくさん"}]
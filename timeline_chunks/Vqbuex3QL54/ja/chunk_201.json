[{"type": "subtitle", "time": 12063.99, "timestamp": "03:21:03", "text": "ああ、選ぶようにとあなたに告げる内なる声"}, {"type": "subtitle", "time": 12065.83, "timestamp": "03:21:05", "text": "短い髪の白髪がないから"}, {"type": "subtitle", "time": 12069.91, "timestamp": "03:21:09", "text": "靴。いいえ、あなたは でも、楽しいことは知っていますよね"}, {"type": "subtitle", "time": 12072.71, "timestamp": "03:21:12", "text": "このゲームの特徴は、"}, {"type": "subtitle", "time": 12075.75, "timestamp": "03:21:15", "text": "自分のヒーローを実際にカスタマイズできます。"}, {"type": "subtitle", "time": 12080.469, "timestamp": "03:21:20", "text": "それは、あなたがOPであるということです"}, {"type": "subtitle", "time": 12084.309, "timestamp": "03:21:24", "text": "文字通りヒーローをカスタマイズできます"}, {"type": "subtitle", "time": 12087.75, "timestamp": "03:21:27", "text": "とても良い。"}, {"type": "subtitle", "time": 12090.71, "timestamp": "03:21:30", "text": "遊びたい"}, {"type": "subtitle", "time": 12093.03, "timestamp": "03:21:33", "text": "短い頭。はい、カスタマイズできます。"}, {"type": "subtitle", "time": 12096.87, "timestamp": "03:21:36", "text": "私は彼女の短い頭を作ることができる。私"}, {"type": "subtitle", "time": 12099.07, "timestamp": "03:21:39", "text": "信じる"}, {"type": "subtitle", "time": 12101.03, "timestamp": "03:21:41", "text": "これ。ああ、たくさんいる"}, {"type": "subtitle", "time": 12103.55, "timestamp": "03:21:43", "text": "カスタマイズ。私は気が狂いそうだ。ああ、"}, {"type": "subtitle", "time": 12106.67, "timestamp": "03:21:46", "text": "ああ、これはとても"}, {"type": "subtitle", "time": 12110.15, "timestamp": "03:21:50", "text": "いいね。武術によって入手可能"}, {"type": "subtitle", "time": 12113.19, "timestamp": "03:21:53", "text": "アーティスト。点呼。点呼とは何ですか？"}, {"type": "subtitle", "time": 12114.75, "timestamp": "03:21:54", "text": "したい"}, {"type": "subtitle", "time": 12117.15, "timestamp": "03:21:57", "text": "変化。"}]
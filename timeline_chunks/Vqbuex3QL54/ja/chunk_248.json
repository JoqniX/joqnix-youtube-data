[{"type": "subtitle", "time": 14890.15, "timestamp": "04:08:10", "text": "これ。よし、これは近接戦闘だ。ちょっと待って。"}, {"type": "subtitle", "time": 14893.229, "timestamp": "04:08:13", "text": "あのね？それから私たちは"}, {"type": "subtitle", "time": 14898.389, "timestamp": "04:08:18", "text": "マスケット銃。待って、仲間が死にかけてる。"}, {"type": "subtitle", "time": 14900.429, "timestamp": "04:08:20", "text": "方法と"}, {"type": "subtitle", "time": 14903.71, "timestamp": "04:08:23", "text": "なぜ？騎士は死んだ。"}]
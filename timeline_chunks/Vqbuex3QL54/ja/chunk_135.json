[{"type": "subtitle", "time": 8105.75, "timestamp": "02:15:05", "text": "私は本当に心からお手伝いできて楽しかったです"}, {"type": "subtitle", "time": 8109.109, "timestamp": "02:15:09", "text": "あなたの助けがあれば何でも"}, {"type": "subtitle", "time": 8113.83, "timestamp": "02:15:13", "text": "そして今日ではあなたはあなたです、あなたはすでに"}, {"type": "subtitle", "time": 8116.629, "timestamp": "02:15:16", "text": "理解が進んだように"}, {"type": "subtitle", "time": 8119.03, "timestamp": "02:15:19", "text": "OBSで多くのことを理解し、"}, {"type": "subtitle", "time": 8121.03, "timestamp": "02:15:21", "text": "すべて。"}, {"type": "subtitle", "time": 8122.79, "timestamp": "02:15:22", "text": "あなたはもう私を必要としていないし"}, {"type": "chat", "time": 8122.902, "timestamp": "02:15:22", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "true"}, {"type": "subtitle", "time": 8124.629, "timestamp": "02:15:24", "text": "すべて。"}, {"type": "subtitle", "time": 8127.229, "timestamp": "02:15:27", "text": "あなたは私をとても助けてくれました。うん。"}, {"type": "subtitle", "time": 8130.95, "timestamp": "02:15:30", "text": "うん。私も他の人と同じように感じました"}, {"type": "subtitle", "time": 8133.75, "timestamp": "02:15:33", "text": "才能も同様です。最初は、私は"}, {"type": "subtitle", "time": 8135.83, "timestamp": "02:15:35", "text": "彼らの荷物を手伝って、"}, {"type": "subtitle", "time": 8138.87, "timestamp": "02:15:38", "text": "彼らは皆成長し、理解した"}, {"type": "subtitle", "time": 8140.91, "timestamp": "02:15:40", "text": "OBSが提供するすべてのものと"}, {"type": "chat", "time": 8141.889, "timestamp": "02:15:41", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "i didn't knew she was a streamer 🤭"}, {"type": "subtitle", "time": 8143.51, "timestamp": "02:15:43", "text": "すべて。複雑なものでさえ、"}, {"type": "subtitle", "time": 8146.95, "timestamp": "02:15:46", "text": "彼らはまだそのことを考えていて、それは"}, {"type": "subtitle", "time": 8149.709, "timestamp": "02:15:49", "text": "頭の中でカチッと音がして、うん、うまくいく"}, {"type": "subtitle", "time": 8153.589, "timestamp": "02:15:53", "text": "外。そして、私は、ええ、たくさんの"}, {"type": "subtitle", "time": 8156.229, "timestamp": "02:15:56", "text": "私たちができたこと、つまり、"}, {"type": "subtitle", "time": 8158.95, "timestamp": "02:15:58", "text": "何かある。そして、擦り傷についてですが"}]
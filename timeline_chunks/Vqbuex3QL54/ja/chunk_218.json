[{"type": "subtitle", "time": 13080.07, "timestamp": "03:38:00", "text": "それまでは、また会いましょう"}, {"type": "subtitle", "time": 13096.349, "timestamp": "03:38:16", "text": "体。ああ、彼女は"}, {"type": "subtitle", "time": 13100.07, "timestamp": "03:38:20", "text": "別の場所へ出かけるような、あるいは"}, {"type": "subtitle", "time": 13101.229, "timestamp": "03:38:21", "text": "何か。"}, {"type": "subtitle", "time": 13104.63, "timestamp": "03:38:24", "text": "H. 私はドラゴンが大好きです。ヴァレランでも、"}, {"type": "subtitle", "time": 13107.349, "timestamp": "03:38:27", "text": "彼らは暗黒のドラゴンと"}, {"type": "subtitle", "time": 13109.469, "timestamp": "03:38:29", "text": "光のドラゴン"}, {"type": "subtitle", "time": 13112.75, "timestamp": "03:38:32", "text": "あれ。よし、これで基本は終わりだ"}, {"type": "subtitle", "time": 13116.15, "timestamp": "03:38:36", "text": "チュートリアル。上級者向けチュートリアルをやってみましょう。"}, {"type": "subtitle", "time": 13118.229, "timestamp": "03:38:38", "text": "上級チュートリアルには何が"}, {"type": "subtitle", "time": 13121.19, "timestamp": "03:38:41", "text": "オファー？レクシー、これはバトルロイヤルよ。良い"}, {"type": "subtitle", "time": 13122.55, "timestamp": "03:38:42", "text": "バトルロイヤルに参加しよう。私はただ"}, {"type": "subtitle", "time": 13130.469, "timestamp": "03:38:50", "text": "基本。これは何ですか？腕を内側に"}, {"type": "subtitle", "time": 13138.95, "timestamp": "03:38:58", "text": "おお。選択すると、誰も残っていません"}]
[{"type": "subtitle", "time": 2341.349, "timestamp": "00:39:01", "text": "うん、ゲームは計画されているけど、私だけ"}, {"type": "subtitle", "time": 2343.67, "timestamp": "00:39:03", "text": "私にはあまり人がいません"}, {"type": "subtitle", "time": 2345.71, "timestamp": "00:39:05", "text": "手伝ってほしいので、自分でやらなければならない"}, {"type": "subtitle", "time": 2349.109, "timestamp": "00:39:09", "text": "いつか私もこうなるだろう"}, {"type": "subtitle", "time": 2351.99, "timestamp": "00:39:11", "text": "感動させてくれるなんて、なんてことだ"}, {"type": "subtitle", "time": 2355.43, "timestamp": "00:39:15", "text": "すごくかっこいい。"}, {"type": "subtitle", "time": 2358.069, "timestamp": "00:39:18", "text": "そしてフカもこの一部です"}, {"type": "subtitle", "time": 2359.79, "timestamp": "00:39:19", "text": "プロジェクト。私は"}, {"type": "subtitle", "time": 2362.47, "timestamp": "00:39:22", "text": "何？すごくかっこいい。ウェブサイトのように"}, {"type": "subtitle", "time": 2364.43, "timestamp": "00:39:24", "text": "それ自体が"}, {"type": "subtitle", "time": 2367.31, "timestamp": "00:39:27", "text": "いいね。うん、本当に"}, {"type": "subtitle", "time": 2370.71, "timestamp": "00:39:30", "text": "いいね。それはすごくクールだね。さて、話を戻しましょう。"}, {"type": "subtitle", "time": 2373.75, "timestamp": "00:39:33", "text": "げんちん。これを終わらせて、"}, {"type": "subtitle", "time": 2377.75, "timestamp": "00:39:37", "text": "拍手喝采の日々の作業に戻る"}, {"type": "subtitle", "time": 2384.15, "timestamp": "00:39:44", "text": "はぁ？これは何ですか？たくさんある"}, {"type": "subtitle", "time": 2384.92, "timestamp": "00:39:44", "text": "シーン"}, {"type": "subtitle", "time": 2387.39, "timestamp": "00:39:47", "text": "[音楽]"}, {"type": "subtitle", "time": 2389.829, "timestamp": "00:39:49", "text": "けれど。公演が始まると、"}, {"type": "subtitle", "time": 2393.27, "timestamp": "00:39:53", "text": "俳優の名前は一定の速度で移動します"}, {"type": "subtitle", "time": 2395.19, "timestamp": "00:39:55", "text": "ステージを横切って、"}, {"type": "subtitle", "time": 2397.43, "timestamp": "00:39:57", "text": "紙に接触すると"}]
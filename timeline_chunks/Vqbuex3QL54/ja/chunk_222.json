[{"type": "subtitle", "time": 13322.87, "timestamp": "03:42:02", "text": "より危険になることを意味する。はい。"}, {"type": "subtitle", "time": 13324.95, "timestamp": "03:42:04", "text": "助けが必要な場合は、他の人と一緒に参加してください"}, {"type": "subtitle", "time": 13327.83, "timestamp": "03:42:07", "text": "選手たちがチームを編成する。でも、"}, {"type": "subtitle", "time": 13330.87, "timestamp": "03:42:10", "text": "シャイ。二人一緒ならもっと強くなれる。ああ、"}, {"type": "subtitle", "time": 13336.95, "timestamp": "03:42:16", "text": "古代のもの。それはクロスボウです。それ"}, {"type": "subtitle", "time": 13339.03, "timestamp": "03:42:19", "text": "まるで機関銃のようだった。試合は"}, {"type": "subtitle", "time": 13341.11, "timestamp": "03:42:21", "text": "続くと、彼の影が"}, {"type": "subtitle", "time": 13343.67, "timestamp": "03:42:23", "text": "戦場、捕らえられたヒーローにダメージを与える"}, {"type": "subtitle", "time": 13345.87, "timestamp": "03:42:25", "text": "その中。ああ、大きな"}, {"type": "subtitle", "time": 13349.99, "timestamp": "03:42:29", "text": "ブレード。ああ、なんてことだ、あの剣を見て。もし"}, {"type": "subtitle", "time": 13352.07, "timestamp": "03:42:32", "text": "死んだら、追跡する。それは究極のことだ。"}, {"type": "subtitle", "time": 13354.15, "timestamp": "03:42:34", "text": "ああ、魂の開花の力は"}, {"type": "subtitle", "time": 13356.07, "timestamp": "03:42:36", "text": "戻ってきたね。"}, {"type": "subtitle", "time": 13358.07, "timestamp": "03:42:38", "text": "ああ、わかりました。よし、ソウルブルームを使ってもいいよ。"}, {"type": "subtitle", "time": 13360.71, "timestamp": "03:42:40", "text": "うん。"}, {"type": "subtitle", "time": 13362.63, "timestamp": "03:42:42", "text": "ソウルジェードを集めると、"}, {"type": "subtitle", "time": 13364.55, "timestamp": "03:42:44", "text": "ステータスを上げたり、新しいスキルを習得したりできます。新しい"}, {"type": "subtitle", "time": 13366.79, "timestamp": "03:42:46", "text": "スキル。複数のソウルジェイドを組み合わせて"}, {"type": "subtitle", "time": 13369.269, "timestamp": "03:42:49", "text": "独自の能力を高め、"}, {"type": "subtitle", "time": 13371.91, "timestamp": "03:42:51", "text": "興味深い方法。"}, {"type": "subtitle", "time": 13374.229, "timestamp": "03:42:54", "text": "最後に残ったヒーローが伝説の勝利を手にする"}, {"type": "subtitle", "time": 13376.55, "timestamp": "03:42:56", "text": "不死の仮面。賞品"}, {"type": "subtitle", "time": 13379.349, "timestamp": "03:42:59", "text": "永遠の名声と栄光を保証する。さあ、教えて"}]
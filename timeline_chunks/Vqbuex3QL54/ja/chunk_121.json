[{"type": "subtitle", "time": 7261.229, "timestamp": "02:01:01", "text": "繰り返したいのですが、とても"}, {"type": "subtitle", "time": 7263.589, "timestamp": "02:01:03", "text": "恥ずかしい。そして、私みたいに、それから"}, {"type": "subtitle", "time": 7266.47, "timestamp": "02:01:06", "text": "「わかった」って感じだった。私は再び電話に出て"}, {"type": "chat", "time": 7266.847, "timestamp": "02:01:06", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "HAHAHA LMAOOO"}, {"type": "subtitle", "time": 7268.99, "timestamp": "02:01:08", "text": "私の友達は、"}, {"type": "subtitle", "time": 7273.27, "timestamp": "02:01:13", "text": "「ところで、私は"}, {"type": "subtitle", "time": 7276.31, "timestamp": "02:01:16", "text": "「あれは」とても恥ずかしかった。"}, {"type": "subtitle", "time": 7278.55, "timestamp": "02:01:18", "text": "まるで、そういう類のものだ"}, {"type": "subtitle", "time": 7280.229, "timestamp": "02:01:20", "text": "誰にも聞かれたくないこと。あなたが知っている、"}, {"type": "subtitle", "time": 7282.229, "timestamp": "02:01:22", "text": "ニック先輩、あなたが"}, {"type": "subtitle", "time": 7283.43, "timestamp": "02:01:23", "text": "あなたが持っているのは、"}, {"type": "chat", "time": 7283.742, "timestamp": "02:01:23", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "!add 432h"}, {"type": "subtitle", "time": 7284.79, "timestamp": "02:01:24", "text": "独り言を言うとき、つまり、"}, {"type": "subtitle", "time": 7287.109, "timestamp": "02:01:27", "text": "モノローグのような、そしていくつかの"}, {"type": "chat", "time": 7289.398, "timestamp": "02:01:29", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "WTF HAHAHA"}, {"type": "subtitle", "time": 7290.149, "timestamp": "02:01:30", "text": "誰かが「ああ、そうだね、私も"}, {"type": "subtitle", "time": 7291.35, "timestamp": "02:01:31", "text": "聞いたよ。それはまるで"}, {"type": "subtitle", "time": 7292.55, "timestamp": "02:01:32", "text": "恥ずかしい。誰かが読んでいる"}, {"type": "chat", "time": 7293.027, "timestamp": "02:01:33", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "!resume "}, {"type": "subtitle", "time": 7294.31, "timestamp": "02:01:34", "text": "日記には、彼らが"}, {"type": "subtitle", "time": 7295.99, "timestamp": "02:01:35", "text": "彼らは読書をしてはいけないことになっている。そういうやつ"}, {"type": "subtitle", "time": 7297.91, "timestamp": "02:01:37", "text": "物事の。それは最新のものだった"}, {"type": "subtitle", "time": 7301.99, "timestamp": "02:01:41", "text": "最新の「えーと恥ずかしい」の言い方"}, {"type": "subtitle", "time": 7303.99, "timestamp": "02:01:43", "text": "私に起こった出来事。さもないと"}, {"type": "subtitle", "time": 7305.589, "timestamp": "02:01:45", "text": "私はとても恥ずかしいと思う"}, {"type": "subtitle", "time": 7308.55, "timestamp": "02:01:48", "text": "一般的に、私は"}, {"type": "subtitle", "time": 7310.47, "timestamp": "02:01:50", "text": "ほぼ毎回恥ずかしい思いをし、"}, {"type": "subtitle", "time": 7313.189, "timestamp": "02:01:53", "text": "あらゆる場面で。だからそれはこうなった"}]
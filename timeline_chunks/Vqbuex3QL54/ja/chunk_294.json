[{"type": "subtitle", "time": 17641.23, "timestamp": "04:54:01", "text": "それはつまり、私には"}, {"type": "subtitle", "time": 17643.07, "timestamp": "04:54:03", "text": "に"}, {"type": "subtitle", "time": 17646.39, "timestamp": "04:54:06", "text": "いくつか持って行ってください。その前に、"}, {"type": "subtitle", "time": 17672.91, "timestamp": "04:54:32", "text": "そこには。えっと、敬礼ができなかったんです"}, {"type": "subtitle", "time": 17683.27, "timestamp": "04:54:43", "text": "主に私たちは円に点を合わせて、"}, {"type": "subtitle", "time": 17684.868, "timestamp": "04:54:44", "text": "えっと、あの男を殺せ、あの人は誰だ？"}, {"type": "subtitle", "time": 17688.35, "timestamp": "04:54:48", "text": "誰がどこから来たのか"}, {"type": "subtitle", "time": 17698.07, "timestamp": "04:54:58", "text": "アイデアは、たった8人しか残っていないということです。"}]
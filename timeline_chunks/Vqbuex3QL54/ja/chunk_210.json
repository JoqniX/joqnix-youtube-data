[{"type": "subtitle", "time": 12615.99, "timestamp": "03:30:15", "text": "行く。組み合いはありません。疑問符。"}, {"type": "subtitle", "time": 12619.309, "timestamp": "03:30:19", "text": "ああ、組みつきがある。わかった、言ったよ"}, {"type": "subtitle", "time": 12622.83, "timestamp": "03:30:22", "text": "そしてそれはすでに私の"}, {"type": "subtitle", "time": 12626.63, "timestamp": "03:30:26", "text": "わかった。はぁ？誰かが"}, {"type": "subtitle", "time": 12628.79, "timestamp": "03:30:28", "text": "三角形が見えたらQキーを押して撃ちます。"}]
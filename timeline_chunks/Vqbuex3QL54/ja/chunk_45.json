[{"type": "subtitle", "time": 2700.069, "timestamp": "00:45:00", "text": "まるで、あなたが叫ぶことができるように"}, {"type": "subtitle", "time": 2702.55, "timestamp": "00:45:02", "text": "欲しい。わからない。"}, {"type": "subtitle", "time": 2704.069, "timestamp": "00:45:04", "text": "いいえ、できますよ。いいえ、いくら叫んでも構いません"}, {"type": "subtitle", "time": 2705.829, "timestamp": "00:45:05", "text": "欲しいし、それでも私はこう思うだろう、え？あなた"}, {"type": "subtitle", "time": 2708.95, "timestamp": "00:45:08", "text": "ごめんなさい、わかってるよ。わかった。"}, {"type": "subtitle", "time": 2713.109, "timestamp": "00:45:13", "text": "何てことだ。わかった。いくつか見えます"}, {"type": "subtitle", "time": 2714.95, "timestamp": "00:45:14", "text": "チャットに参加している人々。こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 2724.03, "timestamp": "00:45:24", "text": "いらっしゃいませ。こんにちは、みんな。"}, {"type": "subtitle", "time": 2727.43, "timestamp": "00:45:27", "text": "うん。はい、"}, {"type": "subtitle", "time": 2731.27, "timestamp": "00:45:31", "text": "お元気ですか？私は私は私は私は私は私は"}, {"type": "subtitle", "time": 2732.95, "timestamp": "00:45:32", "text": "今日は素晴らしい一日でした。ほら、面白い"}, {"type": "chat", "time": 2735.002, "timestamp": "00:45:35", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "notPROBIN wow"}, {"type": "subtitle", "time": 2735.27, "timestamp": "00:45:35", "text": "何かが起こった。私が知っているように、私は"}, {"type": "subtitle", "time": 2737.03, "timestamp": "00:45:37", "text": "私のアクセントはいつも"}, {"type": "subtitle", "time": 2738.87, "timestamp": "00:45:38", "text": "人々は私がどこから来たのかと質問し、"}, {"type": "subtitle", "time": 2742.069, "timestamp": "00:45:42", "text": "いろいろあったけど、まあ、私はあまりそうしなかった。"}, {"type": "subtitle", "time": 2743.75, "timestamp": "00:45:43", "text": "まさか自分にそんなことが起こるとは思ってもみなかった"}, {"type": "subtitle", "time": 2746.19, "timestamp": "00:45:46", "text": "私自身の州は"}, {"type": "subtitle", "time": 2749.51, "timestamp": "00:45:49", "text": "彼らは私に「あなたは"}, {"type": "subtitle", "time": 2751.51, "timestamp": "00:45:51", "text": "あなたはヒンディー語を理解しています、あなたは知っています、そして私は"}, {"type": "subtitle", "time": 2755.109, "timestamp": "00:45:55", "text": "私はただ、質問した人を見ただけです"}, {"type": "subtitle", "time": 2756.95, "timestamp": "00:45:56", "text": "ヒンディー語が分かりますか？私は"}, {"type": "subtitle", "time": 2759.589, "timestamp": "00:45:59", "text": "まるで私があなたたちの一員であるかのように。私は"}]
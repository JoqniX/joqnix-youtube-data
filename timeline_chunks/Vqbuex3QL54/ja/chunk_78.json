[{"type": "subtitle", "time": 4680.95, "timestamp": "01:18:00", "text": "君はあの戦争に勝ったんだよ"}, {"type": "subtitle", "time": 4683.59, "timestamp": "01:18:03", "text": "すべてにもかかわらず、そして私はただ"}, {"type": "subtitle", "time": 4685.83, "timestamp": "01:18:05", "text": "あなたが挙げた３つのポイントは"}, {"type": "subtitle", "time": 4687.91, "timestamp": "01:18:07", "text": "それはとても美しくリストアップされていたので"}, {"type": "subtitle", "time": 4689.83, "timestamp": "01:18:09", "text": "言葉では言い表せないほど、それはまるで"}, {"type": "subtitle", "time": 4691.59, "timestamp": "01:18:11", "text": "まるであなたが"}, {"type": "subtitle", "time": 4694.229, "timestamp": "01:18:14", "text": "人々が当然のことと思っていることに感謝する"}, {"type": "subtitle", "time": 4695.83, "timestamp": "01:18:15", "text": "認めて、物事をじっくり考えます"}, {"type": "subtitle", "time": 4697.43, "timestamp": "01:18:17", "text": "これは本当に素晴らしいし、私はただ"}, {"type": "subtitle", "time": 4699.99, "timestamp": "01:18:19", "text": "ジン・セナイさん、あなたは素晴らしい人です"}, {"type": "subtitle", "time": 4702.229, "timestamp": "01:18:22", "text": "大ファン"}, {"type": "chat", "time": 4705.589, "timestamp": "01:18:25", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "im glad that each and every person in chat is alive and still going strong. love you guys"}, {"type": "chat", "time": 4709.583, "timestamp": "01:18:29", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "lmao"}, {"type": "subtitle", "time": 4711.11, "timestamp": "01:18:31", "text": "人々が物事を当然のことと考えるように、"}, {"type": "subtitle", "time": 4712.709, "timestamp": "01:18:32", "text": "友情を当然のことと捉える、"}, {"type": "subtitle", "time": 4714.229, "timestamp": "01:18:34", "text": "人生を当たり前だと思って、"}, {"type": "subtitle", "time": 4716.709, "timestamp": "01:18:36", "text": "親は、お金が好きで"}, {"type": "subtitle", "time": 4719.11, "timestamp": "01:18:39", "text": "親を当然のこととみなしたり、"}, {"type": "subtitle", "time": 4721.99, "timestamp": "01:18:41", "text": "そんな感じのことです。そして、あなた、あなた、あなたの"}, {"type": "subtitle", "time": 4723.75, "timestamp": "01:18:43", "text": "まず第一に、皆さんもご存知のように"}, {"type": "subtitle", "time": 4725.91, "timestamp": "01:18:45", "text": "費やされたリソースを知っている"}, {"type": "subtitle", "time": 4727.35, "timestamp": "01:18:47", "text": "あなたはそれに対して感謝している。それ"}, {"type": "subtitle", "time": 4729.51, "timestamp": "01:18:49", "text": "それは、見る証拠のようなものだ"}, {"type": "subtitle", "time": 4731.43, "timestamp": "01:18:51", "text": "人々が何をしているのか実際に見てみましょう"}, {"type": "subtitle", "time": 4733.11, "timestamp": "01:18:53", "text": "あなたもそれを高く評価しているでしょう。あなたと同じように"}, {"type": "subtitle", "time": 4734.79, "timestamp": "01:18:54", "text": "少なくともそれは実際には非常にまれである"}, {"type": "subtitle", "time": 4738.149, "timestamp": "01:18:58", "text": "私が見た限りでは。ええ、そうですね。ああ、そうなんですね"}]
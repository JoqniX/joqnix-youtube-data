[{"type": "subtitle", "time": 1920.23, "timestamp": "00:32:00", "text": "歌？心配しないで、ハッシュ。私も"}, {"type": "subtitle", "time": 1923.11, "timestamp": "00:32:03", "text": "まだインターンシップを経験したことがない。"}, {"type": "subtitle", "time": 1931.19, "timestamp": "00:32:11", "text": "学生？他のものに近いですか"}, {"type": "subtitle", "time": 1934.509, "timestamp": "00:32:14", "text": "コースも？私は思う"}, {"type": "subtitle", "time": 1938.05, "timestamp": "00:32:18", "text": "大学、カレッジ"}, {"type": "subtitle", "time": 1944.11, "timestamp": "00:32:24", "text": "[音楽]"}, {"type": "subtitle", "time": 1947.31, "timestamp": "00:32:27", "text": "ええ、他の理由でも。ああ、わかりました。私"}, {"type": "subtitle", "time": 1950.59, "timestamp": "00:32:30", "text": "見る。こんにちは。"}, {"type": "subtitle", "time": 1953.389, "timestamp": "00:32:33", "text": "私は戻ってきます。"}, {"type": "subtitle", "time": 1955.59, "timestamp": "00:32:35", "text": "うん、心配しないで。対話のように、"}, {"type": "subtitle", "time": 1957.509, "timestamp": "00:32:37", "text": "右？大丈夫です。それは それは"}, {"type": "subtitle", "time": 1966.1, "timestamp": "00:32:46", "text": "右？つまり、"}]
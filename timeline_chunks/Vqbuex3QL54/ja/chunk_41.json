[{"type": "subtitle", "time": 2466.99, "timestamp": "00:41:06", "text": "待って、それって罠だよね？何てことだ。"}, {"type": "subtitle", "time": 2470.03, "timestamp": "00:41:10", "text": "待って、彼が来たら"}, {"type": "subtitle", "time": 2471.55, "timestamp": "00:41:11", "text": "戻る。"}, {"type": "subtitle", "time": 2476.72, "timestamp": "00:41:16", "text": "いや。ああ、なんてことだ。待って。そこにいる"}, {"type": "subtitle", "time": 2478.27, "timestamp": "00:41:18", "text": "[音楽]"}, {"type": "subtitle", "time": 2480.87, "timestamp": "00:41:20", "text": "行く。本当に考えなければならないのですか"}, {"type": "subtitle", "time": 2483.23, "timestamp": "00:41:23", "text": "型破りな発想も？"}, {"type": "subtitle", "time": 2486.589, "timestamp": "00:41:26", "text": "ああ、興味深いことに"}, {"type": "subtitle", "time": 2497.03, "timestamp": "00:41:37", "text": "始める。"}, {"type": "subtitle", "time": 2507.43, "timestamp": "00:41:47", "text": "わーい。いいね。いいね。兄が家にいるよ。"}, {"type": "subtitle", "time": 2509.27, "timestamp": "00:41:49", "text": "ステージの上層階から降りることができます"}, {"type": "subtitle", "time": 2512.87, "timestamp": "00:41:52", "text": "隙間を通って下の階へ。しかし、彼が倒れたら"}, {"type": "subtitle", "time": 2514.309, "timestamp": "00:41:54", "text": "彼は下の隙間から落ちていく"}, {"type": "subtitle", "time": 2516.15, "timestamp": "00:41:56", "text": "今日のレベルでは、彼は舞台から落第するだろう。"}, {"type": "subtitle", "time": 2518.87, "timestamp": "00:41:58", "text": "わかった。わかった。ギャップですよね？わかった。しなければならない"}]
[{"type": "subtitle", "time": 2223.51, "timestamp": "00:37:03", "text": "右？それで、えっと、あなたがどれだけファンか知ってるよね"}, {"type": "subtitle", "time": 2225.55, "timestamp": "00:37:05", "text": "私は"}, {"type": "subtitle", "time": 2227.829, "timestamp": "00:37:07", "text": "神崎スタジオですよね？そして彼らは"}, {"type": "subtitle", "time": 2232.43, "timestamp": "00:37:12", "text": "特別なことのように"}, {"type": "subtitle", "time": 2234.87, "timestamp": "00:37:14", "text": "あれ。ああ、これは違う。待って、"}, {"type": "subtitle", "time": 2237.109, "timestamp": "00:37:17", "text": "公式サイトはどこですか？これです。"}, {"type": "subtitle", "time": 2240.069, "timestamp": "00:37:20", "text": "うん。うん。だから、どのように見て"}, {"type": "subtitle", "time": 2242.47, "timestamp": "00:37:22", "text": "ウェブサイトが作成されました。もし私が"}, {"type": "subtitle", "time": 2244.71, "timestamp": "00:37:24", "text": "Onexiaのウェブサイトを作りたいのですが、"}, {"type": "subtitle", "time": 2247.19, "timestamp": "00:37:27", "text": "ドメインが欲しい、私のウェブサイトを作りたい"}, {"type": "subtitle", "time": 2249.91, "timestamp": "00:37:29", "text": "まさにこんな感じです。これってすごくクールだと思いませんか？"}, {"type": "subtitle", "time": 2251.23, "timestamp": "00:37:31", "text": "ああ、"}, {"type": "subtitle", "time": 2258.069, "timestamp": "00:37:38", "text": "ボタン。それは、あなたが知っているように"}, {"type": "chat", "time": 2263.262, "timestamp": "00:37:43", "author": "@christiansanchez5360", "avatar": "https://yt4.ggpht.com/eILXDwYwfCs4NrCnnQuh__dVgXMFhLR53f-MG5T6zNYRhZfoj9tif4kUsH2uo_2hZQBbH5Zddg=s64-c-k-c0x00ffffff-no-rj", "message": "Can I collab together"}, {"type": "subtitle", "time": 2265.67, "timestamp": "00:37:45", "text": "スタジオとココとあの女の子は何"}, {"type": "subtitle", "time": 2270.27, "timestamp": "00:37:50", "text": "名前？忘れた。これらは、えーっと、"}, {"type": "chat", "time": 2272.291, "timestamp": "00:37:52", "author": "@christiansanchez5360", "avatar": "https://yt4.ggpht.com/eILXDwYwfCs4NrCnnQuh__dVgXMFhLR53f-MG5T6zNYRhZfoj9tif4kUsH2uo_2hZQBbH5Zddg=s64-c-k-c0x00ffffff-no-rj", "message": "With you"}, {"type": "subtitle", "time": 2272.79, "timestamp": "00:37:52", "text": "ミュージシャン。彼らも独自の"}, {"type": "subtitle", "time": 2274.95, "timestamp": "00:37:54", "text": "それらのボーカロイド版。彼らは"}, {"type": "subtitle", "time": 2277.91, "timestamp": "00:37:57", "text": "とても人気があります。そしてこの上須賀のように"}]
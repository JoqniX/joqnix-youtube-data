[{"type": "subtitle", "time": 5701.99, "timestamp": "01:35:01", "text": "それはあなた自身についてです。いいえ、もしあなたができるなら"}, {"type": "subtitle", "time": 5703.91, "timestamp": "01:35:03", "text": "中指を立てて、私はこう思う"}, {"type": "subtitle", "time": 5705.75, "timestamp": "01:35:05", "text": "くそくらえ。いいえ、自分を変えないでください。"}, {"type": "subtitle", "time": 5707.35, "timestamp": "01:35:07", "text": "ありのままの自分でいることを謝る必要はない。私の"}, {"type": "subtitle", "time": 5709.629, "timestamp": "01:35:09", "text": "ポイント。"}, {"type": "subtitle", "time": 5713.83, "timestamp": "01:35:13", "text": "わかった。そして私のために私のために何が"}, {"type": "subtitle", "time": 5722.55, "timestamp": "01:35:22", "text": "ほとんど？冗談だよ。冗談だよ。でも私は思う"}, {"type": "subtitle", "time": 5723.99, "timestamp": "01:35:23", "text": "私にとって最も重要なこと"}, {"type": "chat", "time": 5730.511, "timestamp": "01:35:30", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "if you cant love me at my... you dont deserve me at my.... ah"}, {"type": "subtitle", "time": 5731.83, "timestamp": "01:35:31", "text": "えっと、理解するということは、"}, {"type": "subtitle", "time": 5734.07, "timestamp": "01:35:34", "text": "そうですね、意識的にいることなど。"}, {"type": "subtitle", "time": 5736.55, "timestamp": "01:35:36", "text": "感情に気を配る、ということですよね？"}, {"type": "subtitle", "time": 5738.229, "timestamp": "01:35:38", "text": "なぜなら"}, {"type": "subtitle", "time": 5740.629, "timestamp": "01:35:40", "text": "だって、私はそういうタイプだから"}, {"type": "subtitle", "time": 5742.87, "timestamp": "01:35:42", "text": "顔から消えたように見える友人"}, {"type": "subtitle", "time": 5744.39, "timestamp": "01:35:44", "text": "地球の、ですよね？そして私は持っていません"}, {"type": "subtitle", "time": 5746.31, "timestamp": "01:35:46", "text": "友情という概念は衰退していく。私"}, {"type": "subtitle", "time": 5747.83, "timestamp": "01:35:47", "text": "私にとって重要なことは、"}, {"type": "subtitle", "time": 5749.99, "timestamp": "01:35:49", "text": "戻ってきました、ほら、ほら、私は"}, {"type": "subtitle", "time": 5751.43, "timestamp": "01:35:51", "text": "あるいは私の精神的なせいかもしれない"}, {"type": "subtitle", "time": 5753.189, "timestamp": "01:35:53", "text": "健康、まるで全てを押しのけているような"}, {"type": "subtitle", "time": 5755.669, "timestamp": "01:35:55", "text": "そして私が戻ってきて、"}, {"type": "subtitle", "time": 5758.39, "timestamp": "01:35:58", "text": "それでも、私のそばにいてくれる。それはそうだと思います"}]
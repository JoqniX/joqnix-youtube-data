[{"type": "chat", "time": 3600.507, "timestamp": "01:00:00", "author": "@akamurajaizen", "avatar": "https://yt4.ggpht.com/4TIH-D08DE7pk6l85RWWuj6VwP3lUitGX1m3JfDywIpryobVVVZSQqcm_MKVDuuN5keV4e0PSgU=s64-c-k-c0x00ffffff-no-rj", "message": "T-T"}, {"type": "subtitle", "time": 3600.63, "timestamp": "01:00:00", "text": "他の人の笑い声は、あなたが決して、あなたが決して"}, {"type": "subtitle", "time": 3602.309, "timestamp": "01:00:02", "text": "そのジョークがウケるかどうかを知る。"}, {"type": "subtitle", "time": 3604.789, "timestamp": "01:00:04", "text": "だから、代わりに笑うだけで"}, {"type": "subtitle", "time": 3606.39, "timestamp": "01:00:06", "text": "少なくとも誰かがあなたのことを笑ったことを知っておいてください"}, {"type": "subtitle", "time": 3607.51, "timestamp": "01:00:07", "text": "ジョーク。 「ああ、誰もいない」なんて言えないよ"}, {"type": "subtitle", "time": 3609.109, "timestamp": "01:00:09", "text": "「私のジョークに笑う」だって、いや、あなたは"}, {"type": "subtitle", "time": 3614.95, "timestamp": "01:00:14", "text": "ああ。"}, {"type": "subtitle", "time": 3625.349, "timestamp": "01:00:25", "text": "わかった。はい、そうです。うん。わかった。私にさせて"}, {"type": "subtitle", "time": 3627.03, "timestamp": "01:00:27", "text": "ただ質問させてください。うん。私にさせて"}, {"type": "subtitle", "time": 3629.19, "timestamp": "01:00:29", "text": "ただ質問させてください。これは"}, {"type": "subtitle", "time": 3630.47, "timestamp": "01:00:30", "text": "あなたの配信ですが、あなたに質問します"}, {"type": "subtitle", "time": 3631.829, "timestamp": "01:00:31", "text": "質問。うん。うん。ご自由にどうぞ。"}, {"type": "subtitle", "time": 3634.549, "timestamp": "01:00:34", "text": "すべて順調です。私たちはただ"}, {"type": "subtitle", "time": 3636.309, "timestamp": "01:00:36", "text": "もし誰でも招待できるなら"}, {"type": "subtitle", "time": 3637.75, "timestamp": "01:00:37", "text": "チャットでも受け付けています。全て"}, {"type": "subtitle", "time": 3639.349, "timestamp": "01:00:39", "text": "右。チャットに参加している方ならどなたでも。わかった。もし"}, {"type": "subtitle", "time": 3641.349, "timestamp": "01:00:41", "text": "あなたの答えは素晴らしいですね。その"}, {"type": "subtitle", "time": 3643.109, "timestamp": "01:00:43", "text": "あなたはとても素敵ですね。まあ、とにかく、"}, {"type": "subtitle", "time": 3644.87, "timestamp": "01:00:44", "text": "質問はチャットで受け付けています"}, {"type": "subtitle", "time": 3647.27, "timestamp": "01:00:47", "text": "良い。もし誰でも招待できるとしたら"}, {"type": "subtitle", "time": 3649.349, "timestamp": "01:00:49", "text": "夕食、ほら、誰だって"}, {"type": "subtitle", "time": 3651.829, "timestamp": "01:00:51", "text": "世界は死んでいる、生きている、架空の、誰が"}]
[{"type": "subtitle", "time": 4621.11, "timestamp": "01:17:01", "text": "まず第一に、そして第二に、それは実際に"}, {"type": "subtitle", "time": 4624.95, "timestamp": "01:17:04", "text": "物事をじっくり考えることを示している"}, {"type": "subtitle", "time": 4627.43, "timestamp": "01:17:07", "text": "ほら、後ろとか前とか"}, {"type": "subtitle", "time": 4629.03, "timestamp": "01:17:09", "text": "その中にあるもの全て、あなたが知っているように、"}, {"type": "subtitle", "time": 4631.11, "timestamp": "01:17:11", "text": "すべてを考慮すると、"}, {"type": "subtitle", "time": 4632.79, "timestamp": "01:17:12", "text": "物事を当然のことと考えるのは、"}, {"type": "subtitle", "time": 4635.99, "timestamp": "01:17:15", "text": "非常に珍しいですね、もし私がそう言ってもいいなら"}, {"type": "subtitle", "time": 4638.149, "timestamp": "01:17:18", "text": "この時代では"}, {"type": "subtitle", "time": 4639.75, "timestamp": "01:17:19", "text": "すべてが当然のこととされてきた"}, {"type": "subtitle", "time": 4642.31, "timestamp": "01:17:22", "text": "そしてあなたはそうしないし、あなたは私がそうであるように"}, {"type": "chat", "time": 4643.09, "timestamp": "01:17:23", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "yes exactly"}, {"type": "subtitle", "time": 4643.99, "timestamp": "01:17:23", "text": "気に入っていただけて本当に嬉しいです"}, {"type": "subtitle", "time": 4646.07, "timestamp": "01:17:26", "text": "暗闇を突き進んで、このように"}, {"type": "subtitle", "time": 4647.51, "timestamp": "01:17:27", "text": "私にとっては驚きです"}, {"type": "subtitle", "time": 4649.27, "timestamp": "01:17:29", "text": "なぜなら私はいつも"}, {"type": "chat", "time": 4650.748, "timestamp": "01:17:30", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "yes"}, {"type": "subtitle", "time": 4651.189, "timestamp": "01:17:31", "text": "あなたはとても明るいのがお好きです"}, {"type": "subtitle", "time": 4654.229, "timestamp": "01:17:34", "text": "光り輝く人だからそれはそれはそれはそれは"}, {"type": "subtitle", "time": 4656.79, "timestamp": "01:17:36", "text": "その輝きの裏側を知ることで、"}, {"type": "subtitle", "time": 4658.39, "timestamp": "01:17:38", "text": "ほら、この背後にいる人は本当に"}, {"type": "subtitle", "time": 4660.87, "timestamp": "01:17:40", "text": "いつも明るく、素晴らしいあなたのそばにいます"}, {"type": "subtitle", "time": 4663.03, "timestamp": "01:17:43", "text": "友達の人、こういうのがある"}, {"type": "subtitle", "time": 4665.51, "timestamp": "01:17:45", "text": "あなたが経験してきた戦いと"}, {"type": "subtitle", "time": 4668.229, "timestamp": "01:17:48", "text": "あなたが知らないかもしれないことを知っている"}, {"type": "subtitle", "time": 4669.91, "timestamp": "01:17:49", "text": "人々には話していないが、"}, {"type": "subtitle", "time": 4672.07, "timestamp": "01:17:52", "text": "戦って、戦って、勝ったんだね、そして私は"}, {"type": "subtitle", "time": 4674.55, "timestamp": "01:17:54", "text": "嬉しいし、あなたが私たちが"}, {"type": "subtitle", "time": 4675.91, "timestamp": "01:17:55", "text": "今、ここにいます。私たちはこれを抱えていました"}, {"type": "subtitle", "time": 4678.47, "timestamp": "01:17:58", "text": "会話とあなたが知っていること"}]
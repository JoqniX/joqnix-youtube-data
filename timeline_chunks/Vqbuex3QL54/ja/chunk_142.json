[{"type": "subtitle", "time": 8522.55, "timestamp": "02:22:02", "text": "旅の才能が私に教えてくれる、あの運動選手"}, {"type": "subtitle", "time": 8524.79, "timestamp": "02:22:04", "text": "あなたはまだ家族の一員であり、"}, {"type": "subtitle", "time": 8527.75, "timestamp": "02:22:07", "text": "でも、いつも感じていたのは"}, {"type": "subtitle", "time": 8530.87, "timestamp": "02:22:10", "text": "部外者とか、自分が属していないもの"}, {"type": "subtitle", "time": 8532.95, "timestamp": "02:22:12", "text": "家族の一員とかそういう存在だけど"}, {"type": "subtitle", "time": 8537.03, "timestamp": "02:22:17", "text": "それでも彼らは皆、彼らは皆、いくつかは"}, {"type": "subtitle", "time": 8540.55, "timestamp": "02:22:20", "text": "大切な人たち、そして私が気にかけている人たち"}, {"type": "subtitle", "time": 8542.75, "timestamp": "02:22:22", "text": "なぜなら、それは単に"}, {"type": "subtitle", "time": 8546.15, "timestamp": "02:22:26", "text": "私が手伝った星は他のものを与えられました"}, {"type": "subtitle", "time": 8548.19, "timestamp": "02:22:28", "text": "人や物。それはもっと"}, {"type": "subtitle", "time": 8552.95, "timestamp": "02:22:32", "text": "まるで私に任せて手伝わせてくれるかのように"}, {"type": "subtitle", "time": 8555.27, "timestamp": "02:22:35", "text": "問題やいろいろあったとき、"}, {"type": "subtitle", "time": 8558.23, "timestamp": "02:22:38", "text": "技術的なこととか、何でもいいです。そして私は"}, {"type": "subtitle", "time": 8560.469, "timestamp": "02:22:40", "text": "本当に感謝しています。"}, {"type": "subtitle", "time": 8564.07, "timestamp": "02:22:44", "text": "他に誰か行った人は"}, {"type": "subtitle", "time": 8566.309, "timestamp": "02:22:46", "text": "繰り返しますが、これらは誰でもできるものです"}, {"type": "subtitle", "time": 8568.95, "timestamp": "02:22:48", "text": "お手伝いします。でもまた、あなたが来て"}, {"type": "subtitle", "time": 8572.79, "timestamp": "02:22:52", "text": "私に近づいてきて、私は気に入って"}, {"type": "subtitle", "time": 8573.63, "timestamp": "02:22:53", "text": "ヘルプ"}, {"type": "subtitle", "time": 8578.15, "timestamp": "02:22:58", "text": "サスク・ミナから出て、禅も他の皆も"}]
[{"type": "subtitle", "time": 18817.46, "timestamp": "05:13:37", "text": "死ぬ。"}, {"type": "subtitle", "time": 18826.07, "timestamp": "05:13:46", "text": "はい。こんにちは。"}, {"type": "subtitle", "time": 18831.11, "timestamp": "05:13:51", "text": "誰か私に殺人事件の通報をしたの？"}, {"type": "subtitle", "time": 18833.51, "timestamp": "05:13:53", "text": "お前ら全員殺してやる。それは本当だ。"}, {"type": "subtitle", "time": 18836.788, "timestamp": "05:13:56", "text": "クアドラキル。来て。来て。"}, {"type": "subtitle", "time": 18839.91, "timestamp": "05:13:59", "text": "無敵のキル。"}]
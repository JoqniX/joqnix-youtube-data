[{"type": "subtitle", "time": 187.71, "timestamp": "00:03:07", "text": "えっと、H。食べましたか？食べましたか？"}, {"type": "subtitle", "time": 191.71, "timestamp": "00:03:11", "text": "食べる？食べたかどうか聞かなければならない"}, {"type": "subtitle", "time": 193.03, "timestamp": "00:03:13", "text": "もの。"}, {"type": "subtitle", "time": 194.99, "timestamp": "00:03:14", "text": "[音楽]"}, {"type": "subtitle", "time": 199.50900000000001, "timestamp": "00:03:19", "text": "ウマ。わかった。だから、私は彼女を導かなければならない"}, {"type": "subtitle", "time": 202.03, "timestamp": "00:03:22", "text": "えっと、Vニンジャ"}, {"type": "subtitle", "time": 204.82999999999998, "timestamp": "00:03:24", "text": "もの。ビデオ"}, {"type": "subtitle", "time": 207.71, "timestamp": "00:03:27", "text": "忍者。行く。行く"}, {"type": "subtitle", "time": 212.39, "timestamp": "00:03:32", "text": "ここ。こちらがその動画です。忍者グッズ。行く"}, {"type": "subtitle", "time": 217.67000000000002, "timestamp": "00:03:37", "text": "このウェブサイトにアクセスしてカメラを追加し、"}, {"type": "subtitle", "time": 219.149, "timestamp": "00:03:39", "text": "私に送ってください"}, {"type": "subtitle", "time": 223.67000000000002, "timestamp": "00:03:43", "text": "専門用語。ええと、ビデオ通話でご一緒させていただきます。"}, {"type": "subtitle", "time": 228.35, "timestamp": "00:03:48", "text": "数分後。私が行きます"}, {"type": "subtitle", "time": 230.589, "timestamp": "00:03:50", "text": "BBと来て"}, {"type": "subtitle", "time": 234.22899999999998, "timestamp": "00:03:54", "text": "さあ、あそこへ戻って。"}, {"type": "subtitle", "time": 238.19, "timestamp": "00:03:58", "text": "よし、Vニンジャで行こう"}]
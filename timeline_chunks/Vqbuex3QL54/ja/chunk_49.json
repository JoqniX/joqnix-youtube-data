[{"type": "subtitle", "time": 2941.51, "timestamp": "00:49:01", "text": "改善している。"}, {"type": "subtitle", "time": 2944.549, "timestamp": "00:49:04", "text": "君の札束が見えるよ、君の"}, {"type": "subtitle", "time": 2946.79, "timestamp": "00:49:06", "text": "あなたがそうでない時でも、あなたのお金を見る"}, {"type": "subtitle", "time": 2948.549, "timestamp": "00:49:08", "text": "ストリーミング配信。そして私は実際に"}, {"type": "subtitle", "time": 2950.71, "timestamp": "00:49:10", "text": "これらのワッドの1つを開けるんですよね？そしてそれは"}, {"type": "subtitle", "time": 2952.549, "timestamp": "00:49:12", "text": "それは私が実際に"}, {"type": "subtitle", "time": 2955.19, "timestamp": "00:49:15", "text": "生きるために。私が"}, {"type": "chat", "time": 2956.442, "timestamp": "00:49:16", "author": "@notSojasu", "avatar": "https://yt4.ggpht.com/9iC0_w5nBHNC4BhGgiYeUdW6ZfCOGIbrmqCvaFZ2PV9zycbIf4HhyAZJDeqpX-v3fXW6q93S=s64-c-k-c0x00ffffff-no-rj", "message": "truly the number one villain backstory of all time"}, {"type": "subtitle", "time": 2957.589, "timestamp": "00:49:17", "text": "実際にライブで演奏していたと思います"}, {"type": "subtitle", "time": 2959.51, "timestamp": "00:49:19", "text": "ホンキースターは本当に正しいし、あなたは"}, {"type": "subtitle", "time": 2961.43, "timestamp": "00:49:21", "text": "ショートヘアが好きだと話しています"}, {"type": "subtitle", "time": 2963.75, "timestamp": "00:49:23", "text": "君のヘアスタイルみたいな感じ"}, {"type": "subtitle", "time": 2965.75, "timestamp": "00:49:25", "text": "好みで、2回観ました。それで"}, {"type": "subtitle", "time": 2970.87, "timestamp": "00:49:30", "text": "うん。何てことだ。そうそう。私は覚えています。"}, {"type": "subtitle", "time": 2973.47, "timestamp": "00:49:33", "text": "うん。それを見たよ。"}, {"type": "subtitle", "time": 2976.39, "timestamp": "00:49:36", "text": "わかった。待って。誰かが言った、「"}, {"type": "subtitle", "time": 2978.63, "timestamp": "00:49:38", "text": "彼女は聞いていないが、人生は彼女を奪い去る"}, {"type": "subtitle", "time": 2988.15, "timestamp": "00:49:48", "text": "神。大丈夫だと思います。あのね？"}, {"type": "subtitle", "time": 2989.95, "timestamp": "00:49:49", "text": "大丈夫。"}, {"type": "subtitle", "time": 2992.549, "timestamp": "00:49:52", "text": "それで、それで"}, {"type": "subtitle", "time": 2994.63, "timestamp": "00:49:54", "text": "えっと、そうでなければ、一体何が起こっているの？"}, {"type": "subtitle", "time": 2996.15, "timestamp": "00:49:56", "text": "あなたの、あなたの"}, {"type": "subtitle", "time": 2997.99, "timestamp": "00:49:57", "text": "人生？夕食は何を食べましたか？"}]
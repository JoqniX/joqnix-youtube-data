[{"type": "subtitle", "time": 12914.229, "timestamp": "03:35:14", "text": "より健康に。私は健康です。なぜだめですか？"}, {"type": "subtitle", "time": 12916.429, "timestamp": "03:35:16", "text": "私は無駄にする"}, {"type": "subtitle", "time": 12918.429, "timestamp": "03:35:18", "text": "それ。何が"}, {"type": "subtitle", "time": 12921.67, "timestamp": "03:35:21", "text": "これ？レイナの眼球みたいだ。それ"}, {"type": "subtitle", "time": 12926.07, "timestamp": "03:35:26", "text": "魂のエネルギーを吸い取る。"}, {"type": "subtitle", "time": 12958.95, "timestamp": "03:35:58", "text": "下。どこにあるの？ ああ、金色の"}]
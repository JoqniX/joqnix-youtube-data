[{"type": "chat", "time": 4500.311, "timestamp": "01:15:00", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "thats true, being online helped me too to make some friends"}, {"type": "subtitle", "time": 4501.669, "timestamp": "01:15:01", "text": "鎖か何かで、私はそれが"}, {"type": "subtitle", "time": 4505.43, "timestamp": "01:15:05", "text": "人々は離脱しなかったし、たとえ"}, {"type": "subtitle", "time": 4507.189, "timestamp": "01:15:07", "text": "離脱した人々がいた"}, {"type": "subtitle", "time": 4509.669, "timestamp": "01:15:09", "text": "私は今でも、"}, {"type": "subtitle", "time": 4512.149, "timestamp": "01:15:12", "text": "彼らとの思い出を大切にして、"}, {"type": "subtitle", "time": 4514.55, "timestamp": "01:15:14", "text": "今でも彼らのことを心の中で覚えている。"}, {"type": "subtitle", "time": 4516.47, "timestamp": "01:15:16", "text": "だから私のところに来た人はみんな"}, {"type": "subtitle", "time": 4520.149, "timestamp": "01:15:20", "text": "人生、私は本当に素晴らしい、感謝している、いや"}, {"type": "subtitle", "time": 4522.63, "timestamp": "01:15:22", "text": "オンラインだけでなく、現実世界でも"}, {"type": "subtitle", "time": 4526.229, "timestamp": "01:15:26", "text": "本当に多くの人が、"}, {"type": "subtitle", "time": 4528.31, "timestamp": "01:15:28", "text": "私にたくさんのことを教えてくれた年配の方々"}, {"type": "subtitle", "time": 4532.55, "timestamp": "01:15:32", "text": "アドバイスとか色々、そして３番目は"}, {"type": "subtitle", "time": 4534.95, "timestamp": "01:15:34", "text": "になるだろう"}, {"type": "subtitle", "time": 4536.99, "timestamp": "01:15:36", "text": "えーと３番目は"}, {"type": "subtitle", "time": 4539.99, "timestamp": "01:15:39", "text": "私はまだ生きていることを嬉しく思います。私は"}, {"type": "subtitle", "time": 4541.709, "timestamp": "01:15:41", "text": "まだ"}, {"type": "subtitle", "time": 4544.95, "timestamp": "01:15:44", "text": "生きている。それは何か、なぜなら、"}, {"type": "subtitle", "time": 4547.91, "timestamp": "01:15:47", "text": "このプロは親切で、これは"}, {"type": "subtitle", "time": 4551.75, "timestamp": "01:15:51", "text": "暗いけど、そう、私はバカだった"}, {"type": "subtitle", "time": 4553.83, "timestamp": "01:15:53", "text": "私は、"}, {"type": "subtitle", "time": 4556.63, "timestamp": "01:15:56", "text": "配信で言うつもりだったんだけど、まあ"}, {"type": "chat", "time": 4557.394, "timestamp": "01:15:57", "author": "@zergrush78319", "avatar": "https://yt4.ggpht.com/ytc/AIdro_nDwl-xtQg1-Z5v6Iv64Z42_Hei-15daYPmWXqoFR-4_b8=s64-c-k-c0x00ffffff-no-rj", "message": "being alive is important yes"}, {"type": "subtitle", "time": 4559.229, "timestamp": "01:15:59", "text": "そして、私がした約束のおかげで"}]
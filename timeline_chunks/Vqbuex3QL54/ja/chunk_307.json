[{"type": "subtitle", "time": 18430.708, "timestamp": "05:07:10", "text": "ああ、これらの人々は"}, {"type": "subtitle", "time": 18452.55, "timestamp": "05:07:32", "text": "いいえ。"}, {"type": "subtitle", "time": 18454.59, "timestamp": "05:07:34", "text": "準備して"}, {"type": "subtitle", "time": 18458.07, "timestamp": "05:07:38", "text": "見て。私たちは1時間半プレイします。わかった。"}, {"type": "subtitle", "time": 18459.75, "timestamp": "05:07:39", "text": "わかった。そういう意味だったんですね。私は思った"}, {"type": "subtitle", "time": 18472.628, "timestamp": "05:07:52", "text": "えっと、これは本当にストリームストリームなの？"}, {"type": "subtitle", "time": 18473.788, "timestamp": "05:07:53", "text": "または、"}, {"type": "subtitle", "time": 18476.67, "timestamp": "05:07:56", "text": "オフライン"}]
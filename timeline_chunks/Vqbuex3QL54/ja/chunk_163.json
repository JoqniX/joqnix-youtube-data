[{"type": "subtitle", "time": 9781.07, "timestamp": "02:43:01", "text": "[音楽]"}, {"type": "subtitle", "time": 9784.27, "timestamp": "02:43:04", "text": "もの。私はとても"}, {"type": "subtitle", "time": 9808.349, "timestamp": "02:43:28", "text": "寝る。できればいいのに"}, {"type": "subtitle", "time": 9811.23, "timestamp": "02:43:31", "text": "余裕ある"}, {"type": "subtitle", "time": 9817.23, "timestamp": "02:43:37", "text": "に。日本ならできるかもしれない。私が"}, {"type": "subtitle", "time": 9820.75, "timestamp": "02:43:40", "text": "日本、私は買います、私は買います"}, {"type": "subtitle", "time": 9824.59, "timestamp": "02:43:44", "text": "それは私のために私自身のために"}, {"type": "subtitle", "time": 9829.71, "timestamp": "02:43:49", "text": "お金と遊ぶ"}, {"type": "subtitle", "time": 9838.429, "timestamp": "02:43:58", "text": "あなた。分裂したフィクション。いいえ、できればそうしたいのですが"}]
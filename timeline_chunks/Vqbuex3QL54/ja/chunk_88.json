[{"type": "subtitle", "time": 5280.31, "timestamp": "01:28:00", "text": "そんな風に私に質問してみろ。つまり、あなたは"}, {"type": "subtitle", "time": 5283.11, "timestamp": "01:28:03", "text": "こういうのが好きなのは初めて"}, {"type": "subtitle", "time": 5287.11, "timestamp": "01:28:07", "text": "私と一緒に何かする。ありがとう。"}, {"type": "subtitle", "time": 5289.27, "timestamp": "01:28:09", "text": "服用する必要はないと思います。その"}, {"type": "subtitle", "time": 5298.79, "timestamp": "01:28:18", "text": "わかった。わかりました。興味深いことに、"}, {"type": "subtitle", "time": 5300.47, "timestamp": "01:28:20", "text": "ほら、私たちはこう言ったし、次は"}, {"type": "subtitle", "time": 5303.43, "timestamp": "01:28:23", "text": "質問は、あなたが最も重視するものは何ですか"}, {"type": "subtitle", "time": 5306.07, "timestamp": "01:28:26", "text": "友情？"}, {"type": "subtitle", "time": 5310.03, "timestamp": "01:28:30", "text": "それは良い質問ですね。ええと、私は"}, {"type": "subtitle", "time": 5314.87, "timestamp": "01:28:34", "text": "ジェヌジェヌ本物本物本物私"}, {"type": "subtitle", "time": 5322.07, "timestamp": "01:28:42", "text": "本物であることは、本物であることと同義である。大丈夫"}, {"type": "subtitle", "time": 5324.709, "timestamp": "01:28:44", "text": "本物。そう、誠実であること、そして"}, {"type": "subtitle", "time": 5328.629, "timestamp": "01:28:48", "text": "本物だし、すべて大丈夫"}, {"type": "subtitle", "time": 5331.35, "timestamp": "01:28:51", "text": "友情という言葉は"}, {"type": "subtitle", "time": 5335.35, "timestamp": "01:28:55", "text": "年月を経て変化した。えっと、つまり"}, {"type": "subtitle", "time": 5337.189, "timestamp": "01:28:57", "text": "私がストリーミングを始める前から"}, {"type": "subtitle", "time": 5338.95, "timestamp": "01:28:58", "text": "そしてこのオンラインのやつとその他すべて"}]
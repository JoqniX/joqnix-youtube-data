[{"type": "subtitle", "time": 5581.03, "timestamp": "01:33:01", "text": "すべてだけど、それでも私は人を許す"}, {"type": "subtitle", "time": 5583.83, "timestamp": "01:33:03", "text": "簡単に。だから私は理解した、たとえ"}, {"type": "subtitle", "time": 5586.709, "timestamp": "01:33:06", "text": "私が最も大切にしているのは友情です"}, {"type": "subtitle", "time": 5589.27, "timestamp": "01:33:09", "text": "私が指摘したこれらのことはすべて"}, {"type": "subtitle", "time": 5593.83, "timestamp": "01:33:13", "text": "えーっと、本物、本物の信頼、そして"}, {"type": "subtitle", "time": 5596.87, "timestamp": "01:33:16", "text": "信頼できて理解のある人"}, {"type": "chat", "time": 5596.892, "timestamp": "01:33:16", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "👍"}, {"type": "subtitle", "time": 5598.79, "timestamp": "01:33:18", "text": "あなたをサポートするだけでなく、あなたも"}, {"type": "subtitle", "time": 5602.709, "timestamp": "01:33:22", "text": "支えてくれる人、そして"}, {"type": "subtitle", "time": 5605.51, "timestamp": "01:33:25", "text": "例えば、"}, {"type": "subtitle", "time": 5607.35, "timestamp": "01:33:27", "text": "「うん、少し分けてくれる？」って感じ"}, {"type": "subtitle", "time": 5609.43, "timestamp": "01:33:29", "text": "お金とか物をあげて、返してくれない"}, {"type": "subtitle", "time": 5612.149, "timestamp": "01:33:32", "text": "そして、もう一度お聞きします。うん。しないで"}, {"type": "subtitle", "time": 5614.31, "timestamp": "01:33:34", "text": "そういう類のことです。私はそれを望んでいません。"}, {"type": "subtitle", "time": 5625.59, "timestamp": "01:33:45", "text": "わかった。私は深入りしすぎた。ごめんなさい。いいえ、"}, {"type": "subtitle", "time": 5628.95, "timestamp": "01:33:48", "text": "いや、いや。やめて、やめて、信じられない"}, {"type": "subtitle", "time": 5630.87, "timestamp": "01:33:50", "text": "今日2回目ですが"}, {"type": "subtitle", "time": 5633.99, "timestamp": "01:33:53", "text": "私はそれを言っている。謝らないでください"}, {"type": "chat", "time": 5635.918, "timestamp": "01:33:55", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZ
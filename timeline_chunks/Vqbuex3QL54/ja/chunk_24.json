[{"type": "subtitle", "time": 1465.99, "timestamp": "00:24:25", "text": "[音楽]"}, {"type": "subtitle", "time": 1473.39, "timestamp": "00:24:33", "text": "嘘。私は別の鍵をかけました"}, {"type": "subtitle", "time": 1481.39, "timestamp": "00:24:41", "text": "何か。その場所を見逃してしまった。しなかった"}, {"type": "subtitle", "time": 1485.11, "timestamp": "00:24:45", "text": "死ぬ。何てことだ。それはいいです。"}, {"type": "subtitle", "time": 1488.99, "timestamp": "00:24:48", "text": "ハロウィン。私たちは3000しか手に入れられませんでした。"}, {"type": "subtitle", "time": 1492.47, "timestamp": "00:24:52", "text": "うん。あなたは私に、私の母に食事を与えるように頼む"}, {"type": "subtitle", "time": 1494.11, "timestamp": "00:24:54", "text": "今の私。彼女は"}, {"type": "subtitle", "time": 1497.35, "timestamp": "00:24:57", "text": "彼らは私が"}, {"type": "subtitle", "time": 1498.6, "timestamp": "00:24:58", "text": "餌"}]
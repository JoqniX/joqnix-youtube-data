[{"type": "subtitle", "time": 13009.51, "timestamp": "03:36:49", "text": "チュートリアル。この人ですか？ああ、それは"}, {"type": "subtitle", "time": 13012.51, "timestamp": "03:36:52", "text": "白。つまり、赤が白を圧倒するということだ。白"}, {"type": "subtitle", "time": 13016.469, "timestamp": "03:36:56", "text": "赤色を圧倒していると思う。"}, {"type": "subtitle", "time": 13018.63, "timestamp": "03:36:58", "text": "いや、赤の方が青より強い。白"}]
[{"type": "subtitle", "time": 9001.19, "timestamp": "02:30:01", "text": "宝懐石。海石を覚えている人はいますか？"}, {"type": "subtitle", "time": 9003.91, "timestamp": "02:30:03", "text": "皆さんがカイシュを覚えているかどうかわかりませんが"}, {"type": "subtitle", "time": 9006.59, "timestamp": "02:30:06", "text": "私たちはプレイしました"}, {"type": "subtitle", "time": 9008.57, "timestamp": "02:30:08", "text": "一緒に彼を手に入れなければならなかった"}, {"type": "subtitle", "time": 9010.99, "timestamp": "02:30:10", "text": "[音楽]"}, {"type": "chat", "time": 9013.059, "timestamp": "02:30:13", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "kaishi light?"}, {"type": "subtitle", "time": 9022.429, "timestamp": "02:30:22", "text": "じゃあ明日はうん、キキキライト"}, {"type": "subtitle", "time": 9024.75, "timestamp": "02:30:24", "text": "イェパン"}, {"type": "subtitle", "time": 9026.75, "timestamp": "02:30:26", "text": "ママ"}, {"type": "subtitle", "time": 9030.15, "timestamp": "02:30:30", "text": "カニオカ 私が持っているニックネームは何であれ"}, {"type": "subtitle", "time": 9041.75, "timestamp": "02:30:41", "text": "非常識な。兄弟、私はかつては"}, {"type": "subtitle", "time": 9046.71, "timestamp": "02:30:46", "text": "すべての人にニックネームをつける"}, {"type": "subtitle", "time": 9049.51, "timestamp": "02:30:49", "text": "愛し、敬愛し、大切にする。平"}, {"type": "subtitle", "time": 9051.51, "timestamp": "02:30:51", "text": "見知らぬ人も同様だ。以前はそうしていた"}, {"type": "subtitle", "time": 9053.91, "timestamp": "02:30:53", "text": "いつかはそうなるよね？私が"}, {"type": "subtitle", "time": 9057.23, "timestamp": "02:30:57", "text": "私は始めたと感じた"}]
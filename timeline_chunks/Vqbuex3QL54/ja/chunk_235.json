[{"type": "subtitle", "time": 14101.15, "timestamp": "03:55:01", "text": "落とす。へ向かう"}, {"type": "subtitle", "time": 14104.91, "timestamp": "03:55:04", "text": "苔。そこからアイテムを入手してください。"}, {"type": "subtitle", "time": 14108.95, "timestamp": "03:55:08", "text": "わかった。何てことだ。ええと、すべて無料です。感謝"}, {"type": "subtitle", "time": 14112.55, "timestamp": "03:55:12", "text": "あなた。スペースが足りない。何てことだ。わかった、"}, {"type": "subtitle", "time": 14114.51, "timestamp": "03:55:14", "text": "大丈夫。待って。私は"}, {"type": "subtitle", "time": 14118.269, "timestamp": "03:55:18", "text": "これ。私は覚えている"}, {"type": "subtitle", "time": 14121.15, "timestamp": "03:55:21", "text": "剣。私たちは買います"}, {"type": "subtitle", "time": 14124.75, "timestamp": "03:55:24", "text": "剣。この男を"}, {"type": "subtitle", "time": 14138.95, "timestamp": "03:55:38", "text": "もの。これ、持ってたっけ？いいえ。"}, {"type": "subtitle", "time": 14141.55, "timestamp": "03:55:41", "text": "いやいや"}, {"type": "subtitle", "time": 14145.269, "timestamp": "03:55:45", "text": "これを解放してください。あのね？取っていく"}, {"type": "subtitle", "time": 14148.51, "timestamp": "03:55:48", "text": "無料で刀を入手できます。私は買います"}]
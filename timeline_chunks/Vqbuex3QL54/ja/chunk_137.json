[{"type": "subtitle", "time": 8222.469, "timestamp": "02:17:02", "text": "えっと、他に何かありますか？はい。私はそれを知っています"}, {"type": "subtitle", "time": 8224.15, "timestamp": "02:17:04", "text": "あなたは日本のようなところに行く予定で、"}, {"type": "subtitle", "time": 8225.75, "timestamp": "02:17:05", "text": "いろいろあって、すごくワクワクしてる"}, {"type": "subtitle", "time": 8227.91, "timestamp": "02:17:07", "text": "あなたのために。あなたが知っていて本当に嬉しいです"}, {"type": "subtitle", "time": 8230.15, "timestamp": "02:17:10", "text": "あなたは大きな一歩を踏み出そうとしているのですね"}, {"type": "subtitle", "time": 8232.95, "timestamp": "02:17:12", "text": "大きな一歩だ、そして私はこう言っている"}, {"type": "subtitle", "time": 8236.549, "timestamp": "02:17:16", "text": "大きな一歩ですね。私もそう思います。"}, {"type": "subtitle", "time": 8238.07, "timestamp": "02:17:18", "text": "かつてはそうしたいと思っていた"}, {"type": "subtitle", "time": 8240.309, "timestamp": "02:17:20", "text": "でも私はそれをやり遂げることができず、"}, {"type": "subtitle", "time": 8241.75, "timestamp": "02:17:21", "text": "あなたがそれをやっているという事実は、"}, {"type": "subtitle", "time": 8243.509, "timestamp": "02:17:23", "text": "そしてそれは怖い、とても怖い"}, {"type": "subtitle", "time": 8245.11, "timestamp": "02:17:25", "text": "別の州に住んでいて、"}, {"type": "subtitle", "time": 8246.87, "timestamp": "02:17:26", "text": "まったく新しい、まったく新しい"}, {"type": "subtitle", "time": 8248.309, "timestamp": "02:17:28", "text": "国によって言語が異なり、"}, {"type": "subtitle", "time": 8249.99, "timestamp": "02:17:29", "text": "すべて、そしてあなたがそれをやっている"}, {"type": "subtitle", "time": 8252.07, "timestamp": "02:17:32", "text": "とても勇敢で、あなたならできると分かってる"}, {"type": "subtitle", "time": 8254.549, "timestamp": "02:17:34", "text": "あなたの幸せを祈っています"}, {"type": "subtitle", "time": 8256.07, "timestamp": "02:17:36", "text": "皆さん、頑張ってください！応援しています！"}, {"type": "subtitle", "time": 8259.509, "timestamp": "02:17:39", "text": "応援してるよ、わかるでしょ、うん、"}, {"type": "subtitle", "time": 8262.349, "timestamp": "02:17:42", "text": "ええ、ここにいますよ。"}, {"type": "subtitle", "time": 8265.91, "timestamp": "02:17:45", "text": "ダックンだよ、わかるだろ。うん、一緒に遊ぼうよ"}, {"type": "subtitle", "time": 8267.99, "timestamp": "02:17:47", "text": "今後もコラボレーションを続けていきます。"}, {"type": "subtitle", "time": 8272.589, "timestamp": "02:17:52", "text": "たとえ私が日本にいても。はい。うん。"}, {"type": "chat", "time": 8273.199, "timestamp": "02:17:53", "author": "@prathampro", "avatar": "https://yt4.ggpht.com/7tcieem4yOUd9YXALarR3aYDlD62vnZzUlT_1QVJKtQgVzXDOl8byGd1-8hfYZmHnjbZGyS_5Uw=s64-c-k-c0x00ffffff-no-rj", "message": "we hope for the best for you joq"}, {"type": "subtitle", "time": 8275.27, "timestamp": "02:17:55", "text": "はい。ええと、ありがとうございます。どうもありがとう"}, {"type": "subtitle", "time": 8277.27, "timestamp": "02:17:57", "text": "招待してくれてありがとう。本当に嬉しいです"}, {"type": "subtitle", "time": 8279.91, "timestamp": "02:17:59", "text": "まるで私があなたとこの会話をしたように"}]
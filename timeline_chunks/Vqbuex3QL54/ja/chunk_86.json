[{"type": "subtitle", "time": 5160.91, "timestamp": "01:26:00", "text": "彼らの安全などを考えると、私は"}, {"type": "subtitle", "time": 5163.83, "timestamp": "01:26:03", "text": "気にしないで、ずっと"}, {"type": "subtitle", "time": 5166.47, "timestamp": "01:26:06", "text": "自分自身と地球を救うとか、そういうこと"}, {"type": "subtitle", "time": 5171.75, "timestamp": "01:26:11", "text": "あなたはそれを考えたようですね"}, {"type": "subtitle", "time": 5175.189, "timestamp": "01:26:15", "text": "けれど。うん、考えたよ。"}, {"type": "subtitle", "time": 5178.47, "timestamp": "01:26:18", "text": "私はそれについて考えなければならなかった"}, {"type": "subtitle", "time": 5182.229, "timestamp": "01:26:22", "text": "星座の感覚、ジョック、なぜなら"}, {"type": "subtitle", "time": 5184.55, "timestamp": "01:26:24", "text": "えっと、こんなことを書こうと思ったんだけど"}, {"type": "subtitle", "time": 5188.229, "timestamp": "01:26:28", "text": "この間、私はブレインストーミングをしすぎたような感じだった"}, {"type": "subtitle", "time": 5190.629, "timestamp": "01:26:30", "text": "世界観について私が書けることについて"}, {"type": "subtitle", "time": 5193.51, "timestamp": "01:26:33", "text": "そして私が関連付けることができるすべてのもの"}, {"type": "subtitle", "time": 5196.07, "timestamp": "01:26:36", "text": "そして聴衆の賢明な人々は"}, {"type": "subtitle", "time": 5198.07, "timestamp": "01:26:38", "text": "後で接続できる"}, {"type": "subtitle", "time": 5201.75, "timestamp": "01:26:41", "text": "将来は、例えば、材料などを通して"}, {"type": "subtitle", "time": 5204.229, "timestamp": "01:26:44", "text": "ストリームや動画や音楽、"}, {"type": "subtitle", "time": 5206.35, "timestamp": "01:26:46", "text": "何でも。彼らは点と点をつなぎ合わせることができ、"}, {"type": "subtitle", "time": 5209.83, "timestamp": "01:26:49", "text": "私の列車はどんな線路だったのか"}, {"type": "subtitle", "time": 5212.55, "timestamp": "01:26:52", "text": "この方法やこの話について考えた"}, {"type": "subtitle", "time": 5215.11, "timestamp": "01:26:55", "text": "行または物語のこの部分または"}, {"type": "subtitle", "time": 5217.83, "timestamp": "01:26:57", "text": "そんな感じ。うん。うん、"}]
[{"type": "subtitle", "time": 17105.19, "timestamp": "04:45:05", "text": "おお。完全な剣。私は必要ないと思う"}, {"type": "subtitle", "time": 17107.628, "timestamp": "04:45:07", "text": "それ。"}, {"type": "subtitle", "time": 17110.83, "timestamp": "04:45:10", "text": "でも私は"}, {"type": "subtitle", "time": 17125.17, "timestamp": "04:45:25", "text": "D."}, {"type": "subtitle", "time": 17126.67, "timestamp": "04:45:26", "text": "[音楽]"}, {"type": "subtitle", "time": 17130.07, "timestamp": "04:45:30", "text": "わかった。キノコの毒に注意してください"}]
[{"type": "subtitle", "time": 781.829, "timestamp": "00:13:01", "text": "我想明天早上我們就會玩《遠光》了。"}, {"type": "subtitle", "time": 784.15, "timestamp": "00:13:04", "text": "所以，是的，我們可以早上玩《遠光》了"}, {"type": "subtitle", "time": 787.75, "timestamp": "00:13:07", "text": "。是的。"}, {"type": "subtitle", "time": 804.949, "timestamp": "00:13:24", "text": "我可以稍微調高一點背景音樂"}, {"type": "subtitle", "time": 806.71, "timestamp": "00:13:26", "text": "。"}, {"type": "subtitle", "time": 809.03, "timestamp": "00:13:29", "text": "好的，讓我看看這位神秘人物。是的，"}, {"type": "subtitle", "time": 812.31, "timestamp": "00:13:32", "text": "活動名稱是神秘幻象。活動持續"}, {"type": "subtitle", "time": 814.47, "timestamp": "00:13:34", "text": "到13號。  天哪，看來我得努力奮鬥了。我的"}, {"type": "subtitle", "time": 817.35, "timestamp": "00:13:37", "text": "天哪，"}, {"type": "subtitle", "time": 820.389, "timestamp": "00:13:40", "text": "明天就是星期一了。所以重置隨時可能"}, {"type": "subtitle", "time": 823.75, "timestamp": "00:13:43", "text": "發生。  我"}, {"type": "subtitle", "time": 835.269, "timestamp": "00:13:55", "text": "他們居然有萬聖節活動。我的天哪，"}, {"type": "subtitle", "time": 838.79, "timestamp": "00:13:58", "text": "我好想念我，我犯了很多錯。"}]
[{"type": "subtitle", "time": 180.15, "timestamp": "00:03:00", "text": "我當時非常累，"}, {"type": "subtitle", "time": 182.71, "timestamp": "00:03:02", "text": "到家也很晚。"}, {"type": "subtitle", "time": 184.229, "timestamp": "00:03:04", "text": "所以，"}, {"type": "subtitle", "time": 188.309, "timestamp": "00:03:08", "text": "那樣的話，我就沒辦法，"}, {"type": "subtitle", "time": 190.55, "timestamp": "00:03:10", "text": "我沒辦法在5點半到家"}, {"type": "subtitle", "time": 195.91, "timestamp": "00:03:15", "text": "。 5:30 透過聊天室"}, {"type": "subtitle", "time": 199.35, "timestamp": "00:03:19", "text": "呃 JP 語言交換世界"}, {"type": "subtitle", "time": 201.82999999999998, "timestamp": "00:03:21", "text": "會議週日準時開始，就在"}, {"type": "subtitle", "time": 207.19, "timestamp": "00:03:27", "text": "5:30，所以我錯過了，不過沒關係，這種情況時有"}, {"type": "subtitle", "time": 209.27, "timestamp": "00:03:29", "text": "發生。"}, {"type": "subtitle", "time": 215.50900000000001, "timestamp": "00:03:35", "text": "嗯，今天我只是想說說"}, {"type": "subtitle", "time": 218.71, "timestamp": "00:03:38", "text": "我的事情，還有 DNA，嗯，最近我一直在"}, {"type": "subtitle", "time": 225.43, "timestamp": "00:03:45", "text": "直播 DNA"}, {"type": "subtitle", "time": 227.75, "timestamp": "00:03:47", "text": "和藍色協議。不，我不知道，"}, {"type": "subtitle", "time": 230.47, "timestamp": "00:03:50", "text": "夥計。我喜歡這些遊戲。 [笑聲]"}, {"type": "subtitle", "time": 232.789, "timestamp": "00:03:52", "text": "我一直在種田和努力工作。我不"}, {"type": "subtitle", "time": 235.589, "timestamp": "00:03:55", "text": "知道。但我希望你不會介意這類"}, {"type": "subtitle", "time": 238.789, "timestamp": "00:03:58", "text": "直播。"}]
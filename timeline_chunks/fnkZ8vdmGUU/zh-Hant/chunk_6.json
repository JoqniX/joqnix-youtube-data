[{"type": "subtitle", "time": 363.59, "timestamp": "00:06:03", "text": "嗯，對，就是那個盒子。所以你可以免費擁有她"}, {"type": "subtitle", "time": 366.469, "timestamp": "00:06:06", "text": "。我覺得好像是要收集100個盒子才能"}, {"type": "subtitle", "time": 369.11, "timestamp": "00:06:09", "text": "免費拿到她，也可能是"}, {"type": "subtitle", "time": 372.87, "timestamp": "00:06:12", "text": "200個。不太確定。琥珀賽弗和擁有兩隻"}, {"type": "subtitle", "time": 375.35, "timestamp": "00:06:15", "text": "不同眼睛的女孩。是的，"}, {"type": "subtitle", "time": 377.029, "timestamp": "00:06:17", "text": "中文版是新的。所以你"}, {"type": "subtitle", "time": 379.27, "timestamp": "00:06:19", "text": "不用付錢，不用把那"}, {"type": "subtitle", "time": 383.189, "timestamp": "00:06:23", "text": "3萬枚硬幣花在那個中國女孩身上。嗯，我"}, {"type": "subtitle", "time": 386.79, "timestamp": "00:06:26", "text": "會說我玩的是Cipher。她"}, {"type": "subtitle", "time": 389.749, "timestamp": "00:06:29", "text": "用起來很有趣。如果你喜歡玩煙霧角色，那麼皇帝是個不錯的選擇。"}, {"type": "subtitle", "time": 392.23, "timestamp": "00:06:32", "text": "我的意思是，這"}, {"type": "subtitle", "time": 394.55, "timestamp": "00:06:34", "text": "取決於你。你的遊戲風格是什麼？你是"}, {"type": "subtitle", "time": 396.79, "timestamp": "00:06:36", "text": "防禦型還是進攻型？如果"}, {"type": "subtitle", "time": 399.749, "timestamp": "00:06:39", "text": "你性格比較強勢，那就選"}, {"type": "subtitle", "time": 401.909, "timestamp": "00:06:41", "text": "密碼吧。如何聯絡到中國人？這是一件"}, {"type": "subtitle", "time": 404.15, "timestamp": "00:06:44", "text": "大事。有個活動，對吧？前往"}, {"type": "subtitle", "time": 408.15, "timestamp": "00:06:48", "text": "您的活動標籤頁，然後嘗試尋找，那裡應該"}, {"type": "subtitle", "time": 413.189, "timestamp": "00:06:53", "text": "會有一個商店活動。你"}, {"type": "subtitle", "time": 417.27, "timestamp": "00:06:57", "text": "找到那個東西了嗎？不，它就在"}, {"type": "subtitle", "time": 418.87, "timestamp": "00:06:58", "text": "那裡。"}]
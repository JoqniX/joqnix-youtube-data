[{"type": "subtitle", "time": 422.55, "timestamp": "00:07:02", "text": "該事件將持續到下一個補丁為止。"}, {"type": "subtitle", "time": 425.35, "timestamp": "00:07:05", "text": "呃，下一個補丁什麼時候會發布？我不"}, {"type": "subtitle", "time": 429.51, "timestamp": "00:07:09", "text": "知道。那個活動好像會持續到"}, {"type": "subtitle", "time": 433.589, "timestamp": "00:07:13", "text": "11月10號左右。我不確定要"}, {"type": "subtitle", "time": 436.71, "timestamp": "00:07:16", "text": "多久。我甚至還沒登入過"}, {"type": "subtitle", "time": 438.71, "timestamp": "00:07:18", "text": "Farlight。"}, {"type": "subtitle", "time": 441.749, "timestamp": "00:07:21", "text": "我甚至還沒登入過Farlight。"}, {"type": "subtitle", "time": 443.99, "timestamp": "00:07:23", "text": "我一直想玩這個遊戲。你知道嗎，"}, {"type": "subtitle", "time": 446.39, "timestamp": "00:07:26", "text": "明天我們一起玩《遠方之光》吧。我必須"}, {"type": "subtitle", "time": 449.749, "timestamp": "00:07:29", "text": "完成那些"}, {"type": "subtitle", "time": 452.07, "timestamp": "00:07:32", "text": "任務等等。現在已經是11月"}, {"type": "subtitle", "time": 454.23, "timestamp": "00:07:34", "text": "2日了，我知道"}, {"type": "subtitle", "time": 457.029, "timestamp": "00:07:37", "text": "對我來說今天是11月3日。我得完成"}, {"type": "subtitle", "time": 459.43, "timestamp": "00:07:39", "text": "一些任務。"}, {"type": "subtitle", "time": 462.15, "timestamp": "00:07:42", "text": "現在需要多久才能收到？您"}, {"type": "subtitle", "time": 466.87, "timestamp": "00:07:46", "text": "認為？所以一週內你可以"}, {"type": "subtitle", "time": 471.35, "timestamp": "00:07:51", "text": "從地圖上的寶箱中獲得多達 100 個箱子，"}, {"type": "subtitle", "time": 474.79, "timestamp": "00:07:54", "text": "對嗎？如果你完成每日挑戰，"}, {"type": "subtitle", "time": 478.95, "timestamp": "00:07:58", "text": "例如殺死七個敵人、獲得三"}]
[{"type": "subtitle", "time": 4509.27, "timestamp": "01:15:09", "text": "嗜好，我什麼時候才能做音樂呢？ [笑聲] 我的一天，用影片"}, {"type": "subtitle", "time": 4511.75, "timestamp": "01:15:11", "text": "或圖片來呈現"}, {"type": "subtitle", "time": 4514.95, "timestamp": "01:15:14", "text": "。我得先"}, {"type": "subtitle", "time": 4525.43, "timestamp": "01:15:25", "text": "做完這件事，然後再回去給公司上班"}, {"type": "subtitle", "time": 4527.99, "timestamp": "01:15:27", "text": "。"}, {"type": "subtitle", "time": 4535.03, "timestamp": "01:15:35", "text": "我花時間"}, {"type": "subtitle", "time": 4537.669, "timestamp": "01:15:37", "text": "學習藝術，努力提升自己。  呃，我至少撐不了1個小時。"}, {"type": "subtitle", "time": 4542.55, "timestamp": "01:15:42", "text": "我又開始為我的電子遊戲寫劇本了。  哦，等等。你寫作嗎？等等，你是作家嗎？  你寫的是什麼類型的作品？你是寫短篇小說之類的嗎？哦，等等。什麼是兼職作家？  「"}, {"type": "subtitle", "time": 4551.99, "timestamp": "01:15:51", "text": "月光作家」是什麼意思？  哇。"}, {"type": "subtitle", "time": 4556.87, "timestamp": "01:15:56", "text": "遊戲"}, {"type": "subtitle", "time": 4559.35, "timestamp": "01:15:59", "text": "設計師。  馬來亞在聽證會名稱下排名第二。"}]
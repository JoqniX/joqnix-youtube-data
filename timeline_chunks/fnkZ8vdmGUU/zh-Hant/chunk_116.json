[{"type": "subtitle", "time": 6986.07, "timestamp": "01:56:26", "text": "[笑]。  啊，（笑）但那從來"}, {"type": "subtitle", "time": 6989.189, "timestamp": "01:56:29", "text": "行不通。"}, {"type": "subtitle", "time": 6997.35, "timestamp": "01:56:37", "text": "哦，競爭真激烈。這很難。  四年內只賺了 2000 美元，還要兼顧"}, {"type": "subtitle", "time": 7005.95, "timestamp": "01:56:45", "text": "賣車賺了錢。"}, {"type": "subtitle", "time": 7007.109, "timestamp": "01:56:47", "text": "[笑聲]"}, {"type": "subtitle", "time": 7008.709, "timestamp": "01:56:48", "text": "我的天哪。"}, {"type": "subtitle", "time": 7014.95, "timestamp": "01:56:54", "text": "你拿到東西了嗎"}, {"type": "subtitle", "time": 7017.03, "timestamp": "01:56:57", "text": "？我？"}]
[{"type": "subtitle", "time": 2222.15, "timestamp": "00:37:02", "text": "我的天啊。我們走吧。"}, {"type": "subtitle", "time": 2226.23, "timestamp": "00:37:06", "text": "至尊寧靜。最後。"}, {"type": "subtitle", "time": 2228.87, "timestamp": "00:37:08", "text": "納許。納許。"}, {"type": "subtitle", "time": 2231.349, "timestamp": "00:37:11", "text": "那我再來一次。"}, {"type": "subtitle", "time": 2243.43, "timestamp": "00:37:23", "text": "自從那些事情發生後我暫停更新網站以來，我就再也沒有碰過這個網站了。"}, {"type": "subtitle", "time": 2256.47, "timestamp": "00:37:36", "text": "我已經很久沒碰過這個網站了，就像今天這樣，在重新"}, {"type": "subtitle", "time": 2263.589, "timestamp": "00:37:43", "text": "開始直播後，我做了一次合作。"}, {"type": "subtitle", "time": 2265.75, "timestamp": "00:37:45", "text": "我完成了合作專案。所以，我就在"}, {"type": "subtitle", "time": 2268.23, "timestamp": "00:37:48", "text": "想，或許我應該"}, {"type": "subtitle", "time": 2270.31, "timestamp": "00:37:50", "text": "更新一下我的合作夥伴資料庫之"}, {"type": "subtitle", "time": 2272.47, "timestamp": "00:37:52", "text": "類的東西，對吧？這樣，我就可以把這"}, {"type": "subtitle", "time": 2276.55, "timestamp": "00:37:56", "text": "個人的頭像、PNG圖片等等加到"}, {"type": "subtitle", "time": 2279.829, "timestamp": "00:37:59", "text": "我的Notion資料庫中了。所以，現在更容易了。"}]
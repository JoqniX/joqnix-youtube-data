[{"type": "subtitle", "time": 543.19, "timestamp": "00:09:03", "text": "。但上個賽季"}, {"type": "subtitle", "time": 546.949, "timestamp": "00:09:06", "text": "非常艱難。你"}, {"type": "subtitle", "time": 549.99, "timestamp": "00:09:09", "text": "需要大約 3000 個"}, {"type": "subtitle", "time": 554.47, "timestamp": "00:09:14", "text": "神秘戰利品箱才能"}, {"type": "subtitle", "time": 558.71, "timestamp": "00:09:18", "text": "解鎖一個史詩皮膚，而"}, {"type": "subtitle", "time": 563.269, "timestamp": "00:09:23", "text": "解鎖一個角色則需要大約 1000 個。所以，上次"}, {"type": "subtitle", "time": 565.829, "timestamp": "00:09:25", "text": "他們給了男性角色，也就是"}, {"type": "subtitle", "time": 568.949, "timestamp": "00:09:28", "text": "海都這個角色，他有一個"}, {"type": "subtitle", "time": 571.509, "timestamp": "00:09:31", "text": "類似溜冰鞋的東西。那"}, {"type": "subtitle", "time": 575.509, "timestamp": "00:09:35", "text": "個人，還有另一個，就是"}, {"type": "subtitle", "time": 578.389, "timestamp": "00:09:38", "text": "中國龍女，水"}, {"type": "subtitle", "time": 581.509, "timestamp": "00:09:41", "text": "龍女。我，呃，她叫什麼名字來著？我忘了"}, {"type": "subtitle", "time": 584.31, "timestamp": "00:09:44", "text": "和B. Bishu談一些事。我不知道。  我"}, {"type": "subtitle", "time": 587.75, "timestamp": "00:09:47", "text": "猜是吧。"}, {"type": "subtitle", "time": 589.75, "timestamp": "00:09:49", "text": "我不知道。是的，這兩個人比較了"}, {"type": "subtitle", "time": 593.91, "timestamp": "00:09:53", "text": "人物性格。我花了100元買了語音服務。我"}, {"type": "subtitle", "time": 597.43, "timestamp": "00:09:57", "text": "覺得還可以。你還可以再次獲得它。"}, {"type": "subtitle", "time": 599.269, "timestamp": "00:09:59", "text": "不，沒關係。別太擔心。別太擔心。"}]
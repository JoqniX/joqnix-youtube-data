[{"type": "subtitle", "time": 9240.23, "timestamp": "02:34:00", "text": "我以前總覺得自己吃很多，而且我真的不喜歡和朋友們和好，一起出去"}, {"type": "subtitle", "time": 9260.87, "timestamp": "02:34:20", "text": "喝酒聊天。我們倆都沒吃早餐。所以我買了兩個盤子的印度香飯、薯條和鳳梨汁飲料。我們連買的東西的一半都沒用。我的天啊。"}, {"type": "subtitle", "time": 9265.27, "timestamp": "02:34:25", "text": "哇。  終於完成了。  我獲得了三份頂級寧靜。 [笑聲] 不錯。"}, {"type": "subtitle", "time": 9277.67, "timestamp": "02:34:37", "text": "我繼續"}, {"type": "subtitle", "time": 9284.95, "timestamp": "02:34:44", "text": "吃我的貓糧。  我覺得自己已經吃飽了。好吧，我嚐了一小口。沒有。"}, {"type": "subtitle", "time": 9288.55, "timestamp": "02:34:48", "text": "哦，這個裡面有"}, {"type": "subtitle", "time": 9292.309, "timestamp": "02:34:52", "text": "花生。呃，（笑聲和倒吸氣聲）好的。最後一個。犧牲。  我的"}]
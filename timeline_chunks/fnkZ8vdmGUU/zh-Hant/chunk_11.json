[{"type": "subtitle", "time": 661.43, "timestamp": "00:11:01", "text": "你有好處。好的。好的。好的。  真好。  足夠的。  好的。"}, {"type": "subtitle", "time": 670.87, "timestamp": "00:11:10", "text": "呃，請稍等片刻。"}, {"type": "subtitle", "time": 673.59, "timestamp": "00:11:13", "text": "我們說話的時候，我不小心把牆打開了"}, {"type": "subtitle", "time": 677.03, "timestamp": "00:11:17", "text": "。"}, {"type": "subtitle", "time": 679.829, "timestamp": "00:11:19", "text": "你知道，其中一些禁令帶有頂級貨架。"}, {"type": "subtitle", "time": 681.91, "timestamp": "00:11:21", "text": "是的。我的意思是，《遠方之光》這款"}, {"type": "subtitle", "time": 685.11, "timestamp": "00:11:25", "text": "遊戲更容易"}, {"type": "subtitle", "time": 687.829, "timestamp": "00:11:27", "text": "獲得等級之類的東西。我想這就是"}, {"type": "subtitle", "time": 691.91, "timestamp": "00:11:31", "text": "我選擇在"}, {"type": "subtitle", "time": 694.55, "timestamp": "00:11:34", "text": "這款遊戲中進行排位賽的原因。否則我寧願"}, {"type": "subtitle", "time": 697.03, "timestamp": "00:11:37", "text": "去Apex英雄裡衝段位什麼的"}, {"type": "subtitle", "time": 699.19, "timestamp": "00:11:39", "text": "。那豈不是更難"}, {"type": "subtitle", "time": 704.31, "timestamp": "00:11:44", "text": "嗎？例如 Valerant、Apex 之類的遊戲。"}, {"type": "subtitle", "time": 706.71, "timestamp": "00:11:46", "text": "它是印度爆炸事件嗎？我記得我曾經進過前"}, {"type": "subtitle", "time": 711.91, "timestamp": "00:11:51", "text": "60名。我不知道。"}, {"type": "subtitle", "time": 715.43, "timestamp": "00:11:55", "text": "我不太確定了。  我已經停止努力奮鬥了。"}, {"type": "subtitle", "time": 717.91, "timestamp": "00:11:57", "text": "我停止了"}]
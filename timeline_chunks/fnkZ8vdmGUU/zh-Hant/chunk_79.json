[{"type": "subtitle", "time": 4741.91, "timestamp": "01:19:01", "text": "浪費頭髮。"}, {"type": "subtitle", "time": 4749.189, "timestamp": "01:19:09", "text": "我甚至不知道自己想做什麼。但"}, {"type": "subtitle", "time": 4761.99, "timestamp": "01:19:21", "text": "我不能這麼說，因為我明年四月要去日本。但是，即使到了那裡，我覺得我可能還得再讀一次學位。  以我的年紀，現在應該已經把鬍子留完了。"}, {"type": "subtitle", "time": 4778.63, "timestamp": "01:19:38", "text": "我沒明白。我的天哪。好的。"}, {"type": "subtitle", "time": 4786.07, "timestamp": "01:19:46", "text": "我不想"}, {"type": "subtitle", "time": 4788.709, "timestamp": "01:19:48", "text": "復仇。我所有科目都掛科了。是的，我覺得最好選擇一個你覺得自己能夠堅持到底的課程或方向。你對你"}]
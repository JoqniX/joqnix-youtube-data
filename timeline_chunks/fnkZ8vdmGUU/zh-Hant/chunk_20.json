[{"type": "subtitle", "time": 1204.71, "timestamp": "00:20:04", "text": "等等，我能做什麼？等等，我想我可以"}, {"type": "subtitle", "time": 1206.87, "timestamp": "00:20:06", "text": "展示這個，對吧？"}, {"type": "subtitle", "time": 1210.07, "timestamp": "00:20:10", "text": "你想看嗎？"}, {"type": "subtitle", "time": 1213.99, "timestamp": "00:20:13", "text": "我在另一個遊戲中。  等等"}, {"type": "subtitle", "time": 1216.15, "timestamp": "00:20:16", "text": "，為什麼這裡沒有顯示？哦，打起來"}, {"type": "subtitle", "time": 1220.15, "timestamp": "00:20:20", "text": "。好的，我到了。我想死。"}, {"type": "subtitle", "time": 1223.83, "timestamp": "00:20:23", "text": "讓我找到手榴彈然後去死。我"}, {"type": "subtitle", "time": 1233.59, "timestamp": "00:20:33", "text": "我當時完全可以直接噴火。"}, {"type": "subtitle", "time": 1238.23, "timestamp": "00:20:38", "text": "但我仍然需要完成惡魔的任務"}, {"type": "subtitle", "time": 1241.59, "timestamp": "00:20:41", "text": "。我的天啊，我"}, {"type": "subtitle", "time": 1247.11, "timestamp": "00:20:47", "text": "這邊的遊戲卡頓得厲害。我看到那個東西卡頓得"}, {"type": "subtitle", "time": 1249.35, "timestamp": "00:20:49", "text": "厲害。好了，我找到"}, {"type": "subtitle", "time": 1252.23, "timestamp": "00:20:52", "text": "人了。我能行。如果是機器人，請"}, {"type": "subtitle", "time": 1256.31, "timestamp": "00:20:56", "text": "殺了我。嘿，殺了我吧，"}, {"type": "subtitle", "time": 1259.029, "timestamp": "00:20:59", "text": "求你了。是啊，殺了我吧。是的。"}]
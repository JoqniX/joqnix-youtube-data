[{"type": "subtitle", "time": 483.749, "timestamp": "00:08:03", "text": "到五個助攻或登入獎勵等等，"}, {"type": "subtitle", "time": 488.869, "timestamp": "00:08:08", "text": "你最多可以"}, {"type": "subtitle", "time": 492.15, "timestamp": "00:08:12", "text": "從這三個挑戰中獲得 30 到 50 個箱子。 30歲左右，"}, {"type": "subtitle", "time": 494.71, "timestamp": "00:08:14", "text": "你懂的。是的。 30盒。"}, {"type": "subtitle", "time": 498.07, "timestamp": "00:08:18", "text": "你從這三個挑戰中得到 30 分"}, {"type": "subtitle", "time": 500.07, "timestamp": "00:08:20", "text": "。三到四個挑戰。"}, {"type": "subtitle", "time": 502.79, "timestamp": "00:08:22", "text": "然後，你需要透過"}, {"type": "subtitle", "time": 505.749, "timestamp": "00:08:25", "text": "開箱子等等方式找到100個。"}, {"type": "subtitle", "time": 508.07, "timestamp": "00:08:28", "text": "每次進入遊戲時都可以收集它。試著"}, {"type": "subtitle", "time": 510.95, "timestamp": "00:08:30", "text": "打開所有寶箱，然後像"}, {"type": "subtitle", "time": 512.87, "timestamp": "00:08:32", "text": "這樣刷資源。"}, {"type": "subtitle", "time": 516.7090000000001, "timestamp": "00:08:36", "text": "我以前就是這麼做的，因為現在，呃，這個，呃，"}, {"type": "subtitle", "time": 519.19, "timestamp": "00:08:39", "text": "新一季是關於那個有著"}, {"type": "subtitle", "time": 523.029, "timestamp": "00:08:43", "text": "異色瞳的中國女孩的，對吧？"}, {"type": "subtitle", "time": 525.43, "timestamp": "00:08:45", "text": "他們"}, {"type": "subtitle", "time": 529.35, "timestamp": "00:08:49", "text": "在活動商店裡把那個盒子做成了……呃，他們把這個女孩的"}, {"type": "subtitle", "time": 533.03, "timestamp": "00:08:53", "text": "上限設為了300。"}, {"type": "subtitle", "time": 536.23, "timestamp": "00:08:56", "text": "所以現在大家可以輕鬆地"}, {"type": "subtitle", "time": 539.509, "timestamp": "00:08:59", "text": "從活動商店獲得這個角色和皮膚了"}]
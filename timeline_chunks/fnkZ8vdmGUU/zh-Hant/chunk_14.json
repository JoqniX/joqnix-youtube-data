[{"type": "subtitle", "time": 848.949, "timestamp": "00:14:08", "text": "好的。呃，夢幻隊會持續到呃20號。"}, {"type": "subtitle", "time": 852.949, "timestamp": "00:14:12", "text": "好的。神秘任務，嗯，"}, {"type": "subtitle", "time": 857.75, "timestamp": "00:14:17", "text": "可以獲得角色所需的250點數和300點數。"}, {"type": "subtitle", "time": 860.87, "timestamp": "00:14:20", "text": "我還想要武器皮。"}, {"type": "subtitle", "time": 862.629, "timestamp": "00:14:22", "text": "老兄，"}, {"type": "subtitle", "time": 869.509, "timestamp": "00:14:29", "text": "好的，重置。哦，是的。是的，重置時間還有"}, {"type": "subtitle", "time": 875.59, "timestamp": "00:14:35", "text": "5個小時。所以，早上5點30分。我忘了。"}, {"type": "subtitle", "time": 883.59, "timestamp": "00:14:43", "text": "我希望這款遊戲更容易掛機。那樣就"}, {"type": "subtitle", "time": 886.949, "timestamp": "00:14:46", "text": "容易多了。你知道嗎，我們"}, {"type": "subtitle", "time": 890.47, "timestamp": "00:14:50", "text": "可以掛機玩這個遊戲。然後，"}, {"type": "subtitle", "time": 894.47, "timestamp": "00:14:54", "text": "呃，得到你想要的東西之類的，"}, {"type": "subtitle", "time": 897.43, "timestamp": "00:14:57", "text": "對吧？哦，等等。我可以。我覺得我可以。"}]
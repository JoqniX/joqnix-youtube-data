[{"type": "chat", "time": 6302.506, "timestamp": "01:45:02", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "fly"}, {"type": "subtitle", "time": 6308.07, "timestamp": "01:45:08", "text": "いいえ、それはハエと呼ばれます。 ああ、わかりました。 今でも"}, {"type": "subtitle", "time": 6309.669, "timestamp": "01:45:09", "text": "この記憶は鮮明に覚えている。"}, {"type": "subtitle", "time": 6311.83, "timestamp": "01:45:11", "text": "両親の膝の上で星にキスをしようとしていた時、"}, {"type": "subtitle", "time": 6313.91, "timestamp": "01:45:13", "text": "何かが私の頭の上に飛んでくるのが見えた。"}, {"type": "subtitle", "time": 6317.109, "timestamp": "01:45:17", "text": "蛾だと思った。 うん。 そして、"}, {"type": "subtitle", "time": 6325.189, "timestamp": "01:45:25", "text": "それは改造だったのか、それともハエだったのか？   何てことだ"}, {"type": "subtitle", "time": 6333.35, "timestamp": "01:45:33", "text": "、読みました。 ええと、"}, {"type": "subtitle", "time": 6335.51, "timestamp": "01:45:35", "text": "クモは本当に手を噛むんですよ。 たとえそうなったとしても"}, {"type": "subtitle", "time": 6338.47, "timestamp": "01:45:38", "text": "、あなたは決して本当の意味で"}, {"type": "subtitle", "time": 6340.79, "timestamp": "01:45:40", "text": "痛みを感じる資格を得ることはないでしょう。 ブラック・ウィドウのような本当にひどい作品は除く"}]
[{"type": "subtitle", "time": 4082.63, "timestamp": "01:08:02", "text": "フォローチャットを設置したのは、"}, {"type": "subtitle", "time": 4085.99, "timestamp": "01:08:05", "text": "ボットがたくさん来るからだよ。"}, {"type": "subtitle", "time": 4088.789, "timestamp": "01:08:08", "text": "それに、"}, {"type": "subtitle", "time": 4091.99, "timestamp": "01:08:11", "text": "新規の人が配信者を"}, {"type": "subtitle", "time": 4095.99, "timestamp": "01:08:15", "text": "ちょっと見て、"}, {"type": "subtitle", "time": 4098.39, "timestamp": "01:08:18", "text": "雰囲気が良いかどうかを確認できるからね。"}, {"type": "subtitle", "time": 4101.43, "timestamp": "01:08:21", "text": "そうすれば、フォローしたり、チャットしたり、その他いろいろなことができます"}, {"type": "subtitle", "time": 4104.149, "timestamp": "01:08:24", "text": "。 ああ、それも"}, {"type": "subtitle", "time": 4115.91, "timestamp": "01:08:35", "text": "特にGFXボットの方が"}, {"type": "subtitle", "time": 4118.309, "timestamp": "01:08:38", "text": "厄介です。"}, {"type": "subtitle", "time": 4122.07, "timestamp": "01:08:42", "text": "キックでも好きです。 今のところ、"}, {"type": "subtitle", "time": 4126.95, "timestamp": "01:08:46", "text": "どうやってあの人たちを追い払えばいいのか分かりません"}, {"type": "subtitle", "time": 4130.47, "timestamp": "01:08:50", "text": "。 これらのボットのいずれかが"}, {"type": "subtitle", "time": 4132.95, "timestamp": "01:08:52", "text": "メッセージに「discord」のような文字を入力した場合、"}, {"type": "subtitle", "time": 4136.39, "timestamp": "01:08:56", "text": "キック時に自動的にBANされます。 でもTwitchでは、"}, {"type": "subtitle", "time": 4139.749, "timestamp": "01:08:59", "text": "いや、もっとクレイジーだよ。GFX"}]
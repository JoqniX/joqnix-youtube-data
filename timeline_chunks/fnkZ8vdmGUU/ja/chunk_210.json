[{"type": "subtitle", "time": 12614.309, "timestamp": "03:30:14", "text": "我々には燃やすべき街がある。 これが私の理想的な"}, {"type": "subtitle", "time": 12617.429, "timestamp": "03:30:17", "text": "政治的立場です。 うん。 目を覚ませ、"}, {"type": "subtitle", "time": 12620.79, "timestamp": "03:30:20", "text": "侍よ。 君には燃やすべき街がある。"}, {"type": "subtitle", "time": 12627.429, "timestamp": "03:30:27", "text": "これはポケモンではなく、ポケモンです。 ああ、"}, {"type": "subtitle", "time": 12629.91, "timestamp": "03:30:29", "text": "彼を連れて行かなきゃ。"}, {"type": "subtitle", "time": 12632.55, "timestamp": "03:30:32", "text": "サイドクエストをアクティブにしたばかりです。"}, {"type": "subtitle", "time": 12634.87, "timestamp": "03:30:34", "text": "素晴らしい。"}, {"type": "subtitle", "time": 12637.269, "timestamp": "03:30:37", "text": "何故ですか？ それと、"}, {"type": "subtitle", "time": 12643.19, "timestamp": "03:30:43", "text": "はい、わかりました。"}, {"type": "subtitle", "time": 12645.349, "timestamp": "03:30:45", "text": "ありがとう。"}, {"type": "subtitle", "time": 12646.95, "timestamp": "03:30:46", "text": "Shiftは"}, {"type": "subtitle", "time": 12651.349, "timestamp": "03:30:51", "text": "サイバーパンク2077のパロディです。 ああ、"}, {"type": "subtitle", "time": 12656.07, "timestamp": "03:30:56", "text": "サイバーパンクをプレイするのが恋しいよ。 正直言って、"}, {"type": "subtitle", "time": 12658.95, "timestamp": "03:30:58", "text": "快適です。"}]
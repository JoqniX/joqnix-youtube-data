[{"type": "subtitle", "time": 1381.43, "timestamp": "00:23:01", "text": "ゲームが"}, {"type": "subtitle", "time": 1384.23, "timestamp": "00:23:04", "text": "私を殺すのを妨害しているように感じます"}, {"type": "subtitle", "time": 1386.31, "timestamp": "00:23:06", "text": "。"}, {"type": "subtitle", "time": 1389.029, "timestamp": "00:23:09", "text": "はぁ。"}, {"type": "subtitle", "time": 1392.23, "timestamp": "00:23:12", "text": "皆さんもそう思ってますよね？"}, {"type": "subtitle", "time": 1394.23, "timestamp": "00:23:14", "text": "画面全体がフリーズしている状態ですよね"}, {"type": "subtitle", "time": 1396.87, "timestamp": "00:23:16", "text": "？ それに、時々私の声が"}, {"type": "subtitle", "time": 1400.23, "timestamp": "00:23:20", "text": "遅れるんですよね？ 聖なる。"}, {"type": "subtitle", "time": 1403.27, "timestamp": "00:23:23", "text": "Farlight 84は、マルチタスクをしながら"}, {"type": "subtitle", "time": 1407.99, "timestamp": "00:23:27", "text": "プレイするのに適したゲームではないと思います。   そうそう"}, {"type": "subtitle", "time": 1432.07, "timestamp": "00:23:52", "text": "うん、めちゃくちゃ動作が遅いね。"}, {"type": "subtitle", "time": 1434.07, "timestamp": "00:23:54", "text": "リスクを冒すべきではないと思う。"}, {"type": "subtitle", "time": 1438.39, "timestamp": "00:23:58", "text": "あのね？"}]
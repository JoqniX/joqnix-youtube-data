[{"type": "subtitle", "time": 2642.95, "timestamp": "00:44:02", "text": "防具に最高のステータスが必要な場合、良いドロップが"}, {"type": "subtitle", "time": 2645.51, "timestamp": "00:44:05", "text": "出るまで同じミッションを何度も何度も周回しますよ"}, {"type": "subtitle", "time": 2650.87, "timestamp": "00:44:10", "text": "ね？ ここでも同じで、"}, {"type": "subtitle", "time": 2653.99, "timestamp": "00:44:13", "text": "これらは"}, {"type": "subtitle", "time": 2658.309, "timestamp": "00:44:18", "text": "キャラクターの武器や"}, {"type": "subtitle", "time": 2662.47, "timestamp": "00:44:22", "text": "キャラクターの特殊武器に装着できるモジュールのようなものです。 つまり、"}, {"type": "subtitle", "time": 2664.63, "timestamp": "00:44:24", "text": "これらの報酬が得られるまで、これを何度も繰り返すということですね"}, {"type": "subtitle", "time": 2667.91, "timestamp": "00:44:27", "text": "？"}, {"type": "subtitle", "time": 2671.829, "timestamp": "00:44:31", "text": "ガチャはありません。なぜなら、これは地道に努力する必要があるからです。"}, {"type": "subtitle", "time": 2673.51, "timestamp": "00:44:33", "text": "ガチャの代わりに、"}, {"type": "subtitle", "time": 2676.39, "timestamp": "00:44:36", "text": "カバーコミッションと呼ばれるものがある。 だから、"}, {"type": "subtitle", "time": 2679.91, "timestamp": "00:44:39", "text": "この秘密の"}, {"type": "subtitle", "time": 2682.79, "timestamp": "00:44:42", "text": "文字Qを手に入れなきゃいけないんだ。"}, {"type": "subtitle", "time": 2685.99, "timestamp": "00:44:45", "text": "ゲームをプレイして、エンドゲームとか"}, {"type": "chat", "time": 2686.114, "timestamp": "00:44:46", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "are these like perks"}, {"type": "subtitle", "time": 2689.91, "timestamp": "00:44:49", "text": "イベントとかをこなすことで手に入るんだよ。 つまり、この"}, {"type": "subtitle", "time": 2693.51, "timestamp": "00:44:53", "text": "農場では、キャラクターの"}, {"type": "subtitle", "time": 2696.79, "timestamp": "00:44:56", "text": "秘密の手紙を購入します。 つまり、ある程度の"}, {"type": "subtitle", "time": 2699.19, "timestamp": "00:44:59", "text": "確率があるということだ。"}]
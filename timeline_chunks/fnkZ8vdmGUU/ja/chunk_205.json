[{"type": "subtitle", "time": 12301.19, "timestamp": "03:25:01", "text": "通知の埋め込みを行うために以前使っていた古い方法にも取り組む必要があるということですね？"}, {"type": "subtitle", "time": 12305.83, "timestamp": "03:25:05", "text": "見つけられれば、ビリー・ビリーのために以前はそうしていた。 ええと、それをやらなきゃいけないんです"}, {"type": "subtitle", "time": 12309.99, "timestamp": "03:25:09", "text": "。"}, {"type": "subtitle", "time": 12314.309, "timestamp": "03:25:14", "text": "どこですか？ 以前はそうしていた。"}, {"type": "subtitle", "time": 12323.19, "timestamp": "03:25:23", "text": "ああ、それは要約版ですね。 そう、まさに"}, {"type": "subtitle", "time": 12325.67, "timestamp": "03:25:25", "text": "今ライブ配信されているやつ。 いいえ。ええ"}, {"type": "subtitle", "time": 12328.55, "timestamp": "03:25:28", "text": "、これをもう一度やりたいんです。だって、"}, {"type": "subtitle", "time": 12335.51, "timestamp": "03:25:35", "text": "ここに手動で入力したり、Twitterや他の"}, {"type": "subtitle", "time": 12337.429, "timestamp": "03:25:37", "text": "ものに入力したりするのは面倒すぎるから。 あ、待って。  Twitterを自動化することはできません"}, {"type": "subtitle", "time": 12339.59, "timestamp": "03:25:39", "text": "。 開発費を払わなきゃいけないんだよ"}, {"type": "subtitle", "time": 12341.59, "timestamp": "03:25:41", "text": "。"}, {"type": "subtitle", "time": 12343.99, "timestamp": "03:25:43", "text": "大丈夫。 何とか解決策を見つけるよ。"}, {"type": "subtitle", "time": 12347.19, "timestamp": "03:25:47", "text": "今はいつでもくだらないことを言える。"}, {"type": "subtitle", "time": 12349.99, "timestamp": "03:25:49", "text": "それにはチャットGPTを利用します。 まあ、"}, {"type": "subtitle", "time": 12352.469, "timestamp": "03:25:52", "text": "技術的な話はこれくらいにしておこう。"}, {"type": "subtitle", "time": 12355.59, "timestamp": "03:25:55", "text": "ええ、荷物はありますよ。 いくつか作ってみました。"}]
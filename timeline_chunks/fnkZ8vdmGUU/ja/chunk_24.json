[{"type": "subtitle", "time": 1441.75, "timestamp": "00:24:01", "text": "背景の照明のために、ちょっとやめておきます。 今はそうは思わない"}, {"type": "subtitle", "time": 1443.51, "timestamp": "00:24:03", "text": "。   まるで話が"}, {"type": "subtitle", "time": 1446.87, "timestamp": "00:24:06", "text": "遮断されているような気分だ。   何てことだ"}, {"type": "subtitle", "time": 1450.71, "timestamp": "00:24:10", "text": "。 後でやろう。"}, {"type": "subtitle", "time": 1452.63, "timestamp": "00:24:12", "text": "うん、"}, {"type": "subtitle", "time": 1464.63, "timestamp": "00:24:24", "text": "辞める前に、念のため確認しておきたいことがあります"}, {"type": "subtitle", "time": 1467.51, "timestamp": "00:24:27", "text": "。 これは13日に終了します"}, {"type": "subtitle", "time": 1472.39, "timestamp": "00:24:32", "text": "。 今日は12です。ええと、今日は2です。"}, {"type": "subtitle", "time": 1476.149, "timestamp": "00:24:36", "text": "正しく計算すれば、100 + 100 = 200で、"}, {"type": "subtitle", "time": 1479.99, "timestamp": "00:24:39", "text": "今週は200まで稼ぐことができます。 いや、ええ、"}, {"type": "subtitle", "time": 1483.19, "timestamp": "00:24:43", "text": "今週と来週は200ですよね。200"}, {"type": "subtitle", "time": 1486.39, "timestamp": "00:24:46", "text": "まで上げられます。それで、"}, {"type": "subtitle", "time": 1492.07, "timestamp": "00:24:52", "text": "200をやります。私は100持っています。もし私の記憶が正しければ、あと"}, {"type": "subtitle", "time": 1497.75, "timestamp": "00:24:57", "text": "5時間です。"}]
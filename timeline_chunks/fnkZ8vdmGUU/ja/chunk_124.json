[{"type": "subtitle", "time": 7443.189, "timestamp": "02:04:03", "text": "そうですね。 こんにちは。 私の"}, {"type": "subtitle", "time": 7452.39, "timestamp": "02:04:12", "text": "。 読み込みが終わるまで待ちましょう。"}, {"type": "subtitle", "time": 7456.31, "timestamp": "02:04:16", "text": "私はMelを使っています。 私はMelを使っています。 だから、私は"}, {"type": "subtitle", "time": 7458.47, "timestamp": "02:04:18", "text": "OBSを使っていません。"}, {"type": "subtitle", "time": 7465.27, "timestamp": "02:04:25", "text": "、わかりました。 私の場合は明らかに"}, {"type": "subtitle", "time": 7468.07, "timestamp": "02:04:28", "text": "違うものになると思いますが、"}, {"type": "subtitle", "time": 7473.35, "timestamp": "02:04:33", "text": "これをお見せしましょう。"}, {"type": "subtitle", "time": 7477.189, "timestamp": "02:04:37", "text": "必要であれば、自由に切り取ってください。 わかった。 それで、"}, {"type": "subtitle", "time": 7480.149, "timestamp": "02:04:40", "text": "えーと、"}, {"type": "subtitle", "time": 7484.39, "timestamp": "02:04:44", "text": "画像ソースについては、もし"}, {"type": "subtitle", "time": 7486.87, "timestamp": "02:04:46", "text": "見つけることができれば。"}, {"type": "subtitle", "time": 7490.07, "timestamp": "02:04:50", "text": "画像ソースの場合、"}, {"type": "subtitle", "time": 7496.709, "timestamp": "02:04:56", "text": "表示されていないときに画像をアンロードします。"}, {"type": "subtitle", "time": 7499.51, "timestamp": "02:04:59", "text": "これは必ず服用してください。"}]
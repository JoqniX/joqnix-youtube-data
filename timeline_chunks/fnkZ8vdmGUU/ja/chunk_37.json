[{"type": "subtitle", "time": 2222.15, "timestamp": "00:37:02", "text": "。 さあ行こう。"}, {"type": "subtitle", "time": 2226.23, "timestamp": "00:37:06", "text": "最高の静寂。 ついに。"}, {"type": "subtitle", "time": 2228.87, "timestamp": "00:37:08", "text": "ナッシュ。 ナッシュ。   では"}, {"type": "subtitle", "time": 2231.349, "timestamp": "00:37:11", "text": "、もう一度やってみましょう。"}, {"type": "subtitle", "time": 2245.99, "timestamp": "00:37:25", "text": "あの出来事が"}, {"type": "subtitle", "time": 2260.87, "timestamp": "00:37:40", "text": "久しぶりにウェブサイトを触って、"}, {"type": "subtitle", "time": 2263.589, "timestamp": "00:37:43", "text": "ストリーミングを再開してから今日コラボしました。"}, {"type": "subtitle", "time": 2265.75, "timestamp": "00:37:45", "text": "コラボしました。コラボしました。 それで、"}, {"type": "subtitle", "time": 2270.31, "timestamp": "00:37:50", "text": "コラボパートナーのデータベースを更新した方がいいかなって考えてたんだけど"}, {"type": "subtitle", "time": 2272.47, "timestamp": "00:37:52", "text": "、どうかな？ つまり、その"}, {"type": "subtitle", "time": 2276.55, "timestamp": "00:37:56", "text": "人のアバターやPNG画像などを"}, {"type": "subtitle", "time": 2279.829, "timestamp": "00:37:59", "text": "Notionデータベースに追加できるということですね。 だから、今はもっと楽になった。"}]
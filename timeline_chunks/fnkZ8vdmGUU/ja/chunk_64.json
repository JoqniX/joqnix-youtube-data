[{"type": "subtitle", "time": 3841.75, "timestamp": "01:04:01", "text": "戻ってこなくてはならない。 ああ、戦闘中だ。"}, {"type": "subtitle", "time": 3852.39, "timestamp": "01:04:12", "text": "クールを終えました。"}, {"type": "subtitle", "time": 3855.27, "timestamp": "01:04:15", "text": "ついに彼女を捕まえた。"}, {"type": "subtitle", "time": 3861.029, "timestamp": "01:04:21", "text": "彼女はレベッカと仲が良いので、私は毎週彼女を手に入れるために努力しました。"}, {"type": "subtitle", "time": 3867.43, "timestamp": "01:04:27", "text": "彼女も手に入れるには、ログのようなイベントをこなす必要がある。"}, {"type": "subtitle", "time": 3871.029, "timestamp": "01:04:31", "text": "彼女を捕まえた。 うん、彼女の商品を15個買ったんだ"}, {"type": "subtitle", "time": 3876.71, "timestamp": "01:04:36", "text": "けど、今のところ運が悪かったんだ。"}, {"type": "subtitle", "time": 3879.67, "timestamp": "01:04:39", "text": "私もこのエレクトロガールのリズムを手に入れたい"}]
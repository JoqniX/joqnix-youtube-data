[{"type": "subtitle", "time": 8828.309, "timestamp": "02:27:08", "text": "、私って"}, {"type": "subtitle", "time": 8831.83, "timestamp": "02:27:11", "text": "胃が小さいタイプだと思うの。   そうそう"}, {"type": "subtitle", "time": 8835.75, "timestamp": "02:27:15", "text": "。 今日、私はそこにいたすべての魂と同じだった"}, {"type": "subtitle", "time": 8837.67, "timestamp": "02:27:17", "text": "。 それで、教会での用事とか"}, {"type": "subtitle", "time": 8840.309, "timestamp": "02:27:20", "text": "色々が終わった後、えっと"}, {"type": "subtitle", "time": 8842.79, "timestamp": "02:27:22", "text": "、"}, {"type": "subtitle", "time": 8844.71, "timestamp": "02:27:24", "text": "教会での用事とか色々が終わった後、"}, {"type": "subtitle", "time": 8848.07, "timestamp": "02:27:28", "text": "外に出て"}, {"type": "subtitle", "time": 8851.83, "timestamp": "02:27:31", "text": "カフェでコーヒーを飲んだんです。 久しぶりにシャワーを浴びたような気がします"}, {"type": "subtitle", "time": 8856.95, "timestamp": "02:27:36", "text": "。"}, {"type": "subtitle", "time": 8860.23, "timestamp": "02:27:40", "text": "お腹がいっぱいだったのに、"}, {"type": "subtitle", "time": 8863.11, "timestamp": "02:27:43", "text": "夕食を食べたのは11時過ぎだった。"}, {"type": "subtitle", "time": 8865.349, "timestamp": "02:27:45", "text": "あ、待って。 私は11時30分に配信を開始しました"}, {"type": "subtitle", "time": 8868.23, "timestamp": "02:27:48", "text": "。 うん。 うん。  11時に夕食を食べ始めたのは、"}, {"type": "subtitle", "time": 8879.75, "timestamp": "02:27:59", "text": "。"}]
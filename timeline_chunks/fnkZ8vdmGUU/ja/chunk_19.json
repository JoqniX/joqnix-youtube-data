[{"type": "subtitle", "time": 1151.35, "timestamp": "00:19:11", "text": "今は動作が遅くなっています。 それは、私の"}, {"type": "subtitle", "time": 1156.549, "timestamp": "00:19:16", "text": "脇腹にファーライト84が入っているからなんです（笑）。"}, {"type": "subtitle", "time": 1161.83, "timestamp": "00:19:21", "text": "リセット前にこれを集めようとしているんです。   何てことだ"}, {"type": "subtitle", "time": 1169.59, "timestamp": "00:19:29", "text": "ダーウィンのせいだと思う。 君のおかげで、"}, {"type": "subtitle", "time": 1172.63, "timestamp": "00:19:32", "text": "Far Light.ioを開いてみたくなったよ。 通常ならバック"}, {"type": "subtitle", "time": 1179.11, "timestamp": "00:19:39", "text": "グラウンドでブループロトコルを開いておくか、今頃はAFKファーミングをしているところだけど"}, {"type": "subtitle", "time": 1182.278, "timestamp": "00:19:42", "text": "、えーと"}, {"type": "subtitle", "time": 1187.99, "timestamp": "00:19:47", "text": "マップの外からは死なないんだよね。"}, {"type": "subtitle", "time": 1192.95, "timestamp": "00:19:52", "text": "ジェットパックで移動するんだ。 ああ、"}, {"type": "subtitle", "time": 1195.378, "timestamp": "00:19:55", "text": "このゲームはすごい。"}]
[{"type": "subtitle", "time": 1094.71, "timestamp": "00:18:14", "text": "私はいつもこの男があなたに何も与えないことを嫌う。"}, {"type": "subtitle", "time": 1101.83, "timestamp": "00:18:21", "text": "えっと、撤回してください。"}, {"type": "subtitle", "time": 1122.07, "timestamp": "00:18:42", "text": "私はそこへは行けません。"}, {"type": "subtitle", "time": 1131.99, "timestamp": "00:18:51", "text": "ゲームが"}, {"type": "subtitle", "time": 1134.31, "timestamp": "00:18:54", "text": "ハロウィンに何も対応しなかったのは意外だ。"}, {"type": "subtitle", "time": 1136.39, "timestamp": "00:18:56", "text": "ゲームの中に"}, {"type": "subtitle", "time": 1139.19, "timestamp": "00:18:59", "text": "ハロウィンの飾り付けとかがあると思ってたんだけど、なかった"}]
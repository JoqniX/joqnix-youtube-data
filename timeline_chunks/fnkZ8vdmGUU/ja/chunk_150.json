[{"type": "subtitle", "time": 9017.99, "timestamp": "02:30:17", "text": "またしても究極の選択。 ニース。   わかった"}, {"type": "subtitle", "time": 9022.389, "timestamp": "02:30:22", "text": "。 ついに主が退場した。   何てことだ"}, {"type": "subtitle", "time": 9026.23, "timestamp": "02:30:26", "text": "。 私は食べるのが好きだった。 私は以前は"}, {"type": "subtitle", "time": 9028.469, "timestamp": "02:30:28", "text": "たくさん食べていると思っていましたが、"}, {"type": "subtitle", "time": 9031.349, "timestamp": "02:30:31", "text": "友達と仲直りして"}, {"type": "subtitle", "time": 9032.79, "timestamp": "02:30:32", "text": "飲みに行くのが本当に好きではありません。 二人とも"}, {"type": "subtitle", "time": 9035.349, "timestamp": "02:30:35", "text": "朝食を食べなかった。 それで、"}, {"type": "subtitle", "time": 9037.83, "timestamp": "02:30:37", "text": "ビリヤニとチップスを2皿と、パイナップル"}, {"type": "subtitle", "time": 9041.75, "timestamp": "02:30:41", "text": "ジュースのミキサーを買いました。 そして、"}, {"type": "subtitle", "time": 9043.429, "timestamp": "02:30:43", "text": "買ったものの半分も消費できなかった。 何てことだ"}, {"type": "subtitle", "time": 9045.429, "timestamp": "02:30:45", "text": "。"}]
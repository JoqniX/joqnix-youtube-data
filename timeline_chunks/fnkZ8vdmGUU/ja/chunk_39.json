[{"type": "subtitle", "time": 2379.91, "timestamp": "00:39:39", "text": "追い詰めろ。 私は既に持っています。"}, {"type": "subtitle", "time": 2383.27, "timestamp": "00:39:43", "text": "ああ、残虐だ。"}, {"type": "subtitle", "time": 2386.31, "timestamp": "00:39:46", "text": "よし、何か発見できるか見てみようか、"}, {"type": "subtitle", "time": 2390.31, "timestamp": "00:39:50", "text": "それとももう少し待った方がいいだろうか？"}]
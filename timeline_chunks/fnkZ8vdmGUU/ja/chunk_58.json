[{"type": "subtitle", "time": 3481.91, "timestamp": "00:58:01", "text": "？ ベリカ。 うん、うん、うん、うん。"}, {"type": "subtitle", "time": 3485.19, "timestamp": "00:58:05", "text": "ヴェラは可愛い。"}, {"type": "subtitle", "time": 3492.87, "timestamp": "00:58:12", "text": "、そうしないといけないな。 まだやっていません"}, {"type": "subtitle", "time": 3512.795, "timestamp": "00:58:32", "text": "手首を回すときは、手首に体重をかけます。"}, {"type": "subtitle", "time": 3528.069, "timestamp": "00:58:48", "text": "彼女や他のキャラクターのレベルを上げるために、このゲームでたくさん勉強してレベル上げしないといけないだろうね"}]
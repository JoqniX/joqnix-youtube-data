[{"type": "subtitle", "time": 8881.67, "timestamp": "02:28:01", "text": "私は眠っていました。 数時間後に仕事が始まる"}, {"type": "subtitle", "time": 8884.389, "timestamp": "02:28:04", "text": "。 仕事。 こんにちは。"}, {"type": "subtitle", "time": 8887.03, "timestamp": "02:28:07", "text": "本日はお越しいただきありがとうございました。 あなたの回答は本当に大変貴重です"}, {"type": "subtitle", "time": 8888.71, "timestamp": "02:28:08", "text": "。"}, {"type": "subtitle", "time": 8891.59, "timestamp": "02:28:11", "text": "あなたはたくさん話しましたね。 君のおかげで、私はたくさん話してしまったよ"}, {"type": "subtitle", "time": 8893.67, "timestamp": "02:28:13", "text": "。 ありがとう。 私たちはたくさんのことについて話しました"}, {"type": "subtitle", "time": 8896.87, "timestamp": "02:28:16", "text": "。 楽しかったです。"}, {"type": "subtitle", "time": 8899.51, "timestamp": "02:28:19", "text": "本日はご滞在をお楽しみいただけましたでしょうか。"}, {"type": "subtitle", "time": 8902.71, "timestamp": "02:28:22", "text": "今後もぜひお立ち寄りください。 それでは、お体に気をつけて、ゆっくりお"}, {"type": "subtitle", "time": 8905.59, "timestamp": "02:28:25", "text": "休みください。 わかった。"}, {"type": "subtitle", "time": 8909.03, "timestamp": "02:28:29", "text": "明日は月曜日です。良い一"}, {"type": "subtitle", "time": 8929.59, "timestamp": "02:28:49", "text": "、"}, {"type": "subtitle", "time": 8933.19, "timestamp": "02:28:53", "text": "誰かが寝るときにいつも言うことを忘れてた。 こんにちは。"}, {"type": "subtitle", "time": 8935.83, "timestamp": "02:28:55", "text": "今夜、星々があなたを祝福してくれますように。"}, {"type": "subtitle", "time": 8938.87, "timestamp": "02:28:58", "text": "そして、星々があなたの"}]
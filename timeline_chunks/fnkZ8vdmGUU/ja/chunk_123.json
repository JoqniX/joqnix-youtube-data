[{"type": "subtitle", "time": 7392.39, "timestamp": "02:03:12", "text": "もはや16％ではない。"}, {"type": "subtitle", "time": 7395.03, "timestamp": "02:03:15", "text": "26 を手に入れるための目標としては、いいえ。待って、"}, {"type": "subtitle", "time": 7399.51, "timestamp": "02:03:19", "text": "260 はやめて。"}, {"type": "subtitle", "time": 7403.109, "timestamp": "02:03:23", "text": "待って、2060 はやめて。貯金して"}, {"type": "subtitle", "time": 7406.55, "timestamp": "02:03:26", "text": "40 シリーズか 50 シリーズを買うことをお勧めします。 だって、"}, {"type": "subtitle", "time": 7409.51, "timestamp": "02:03:29", "text": "もう一度言うけど、"}, {"type": "subtitle", "time": 7414.229, "timestamp": "02:03:34", "text": "今は2025年であって、2026年じゃないんだから。"}, {"type": "subtitle", "time": 7416.79, "timestamp": "02:03:36", "text": "だから貯金しなさい。   私の場合、"}, {"type": "subtitle", "time": 7421.99, "timestamp": "02:03:41", "text": "来年日本に行くときにノートパソコンを買わないといけないと思っています。 だから、"}, {"type": "subtitle", "time": 7433.43, "timestamp": "02:03:53", "text": "50シリーズとか、もっと"}, {"type": "subtitle", "time": 7436.55, "timestamp": "02:03:56", "text": "安いノートパソコンを買いたいんです。"}]
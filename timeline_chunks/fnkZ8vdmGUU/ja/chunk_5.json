[{"type": "subtitle", "time": 300.79, "timestamp": "00:05:00", "text": "例えばイントロのアニメーションとか、"}, {"type": "subtitle", "time": 302.95, "timestamp": "00:05:02", "text": "ずっと前に作ったものとか、そういうのがあったんだけど、今気づいたんだ。"}, {"type": "subtitle", "time": 306.39, "timestamp": "00:05:06", "text": "これ、これ、ですよね？ つまり、"}, {"type": "subtitle", "time": 309.67, "timestamp": "00:05:09", "text": "メルに関する問題は、"}, {"type": "subtitle", "time": 320.07, "timestamp": "00:05:20", "text": "そのシーンに集中していない限り、そのメディアファイルを閉じる方法がないということです"}, {"type": "subtitle", "time": 322.39, "timestamp": "00:05:22", "text": "。"}, {"type": "subtitle", "time": 324.31, "timestamp": "00:05:24", "text": "ええ、そうですね"}, {"type": "subtitle", "time": 329.029, "timestamp": "00:05:29", "text": "、残念です。 それと、"}, {"type": "subtitle", "time": 332.79, "timestamp": "00:05:32", "text": "私のPCの動作が遅いのもそのせいだと思うのですが、よくわかりません"}, {"type": "subtitle", "time": 335.35, "timestamp": "00:05:35", "text": "。"}, {"type": "subtitle", "time": 338.31, "timestamp": "00:05:38", "text": "なあ、どういうわけか俺の人生で3万枚のコインを集めたんだ"}, {"type": "subtitle", "time": 340.469, "timestamp": "00:05:40", "text": "。 どのヒーローを買うべきですか？"}, {"type": "subtitle", "time": 344.15, "timestamp": "00:05:44", "text": "あなた次第。 好きな人を選んでください。 そうですね、"}, {"type": "subtitle", "time": 346.87, "timestamp": "00:05:46", "text": "新しいキャラクター、つまり"}, {"type": "subtitle", "time": 352.15, "timestamp": "00:05:52", "text": "ヒーラーですね。 彼女はただ"}, {"type": "subtitle", "time": 355.11, "timestamp": "00:05:55", "text": "世界のアイテムを集めているだけです。"}, {"type": "subtitle", "time": 359.43, "timestamp": "00:05:59", "text": "世界のアイテム。 えっと、あの箱みたいなやつ。"}]
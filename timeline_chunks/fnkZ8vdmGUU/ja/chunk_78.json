[{"type": "subtitle", "time": 4689.51, "timestamp": "01:18:09", "text": "要するに、私は自分の"}, {"type": "subtitle", "time": 4697.189, "timestamp": "01:18:17", "text": "ない。 でも、"}, {"type": "subtitle", "time": 4702.55, "timestamp": "01:18:22", "text": "来年4月に日本に行く予定なので、それは言えません。 でも、"}, {"type": "subtitle", "time": 4705.99, "timestamp": "01:18:25", "text": "そこでも"}, {"type": "subtitle", "time": 4707.91, "timestamp": "01:18:27", "text": "学位をもう一度取得し直さないといけないかもしれないと思っています。"}, {"type": "subtitle", "time": 4711.189, "timestamp": "01:18:31", "text": "私の年齢なら、もう"}, {"type": "subtitle", "time": 4725.51, "timestamp": "01:18:45", "text": "私は復讐を望んでいません。 私は全ての"}, {"type": "subtitle", "time": 4728.39, "timestamp": "01:18:48", "text": "授業で落第した。 そうですね、最後までやり遂げられると思えるコースや分野を選んだ方が良いと思います"}, {"type": "subtitle", "time": 4735.59, "timestamp": "01:18:55", "text": "。 あなたは自分がやりたいことに"}, {"type": "subtitle", "time": 4739.03, "timestamp": "01:18:59", "text": "情熱を持っていて、"}]
[{"type": "subtitle", "time": 7682.79, "timestamp": "02:08:02", "text": "Jock さんからの提案に感謝します。 私が要望した"}, {"type": "subtitle", "time": 7685.43, "timestamp": "02:08:05", "text": "機能を追加してくれたんです。"}, {"type": "subtitle", "time": 7687.589, "timestamp": "02:08:07", "text": "私のように、"}, {"type": "subtitle", "time": 7691.669, "timestamp": "02:08:11", "text": "ソースが1000個、シーンが500個もあるような人には、"}, {"type": "subtitle", "time": 7695.109, "timestamp": "02:08:15", "text": "何かが必要だったので、"}, {"type": "subtitle", "time": 7697.03, "timestamp": "02:08:17", "text": "プレフィックスをお願いしました。 私はそのプラグインを"}, {"type": "subtitle", "time": 7699.99, "timestamp": "02:08:19", "text": "インストールしていませんが、それは"}, {"type": "subtitle", "time": 7704.79, "timestamp": "02:08:24", "text": "ソースの設定をコピーして、"}, {"type": "subtitle", "time": 7711.669, "timestamp": "02:08:31", "text": "新しい"}, {"type": "subtitle", "time": 7715.43, "timestamp": "02:08:35", "text": "子ソースがすべて同じものを反映するようにするようなものです"}, {"type": "subtitle", "time": 7717.35, "timestamp": "02:08:37", "text": "。 つまり、"}, {"type": "subtitle", "time": 7719.99, "timestamp": "02:08:39", "text": "ここでこれらの設定を変更すると、"}, {"type": "subtitle", "time": 7722.95, "timestamp": "02:08:42", "text": "新しいソースタイプなどすべてに反映されます。 ちょっと"}, {"type": "subtitle", "time": 7725.148, "timestamp": "02:08:45", "text": "専門的すぎるかな。 生きる、そして死ぬ。"}, {"type": "subtitle", "time": 7726.39, "timestamp": "02:08:46", "text": "[笑い] でも、もし何か"}, {"type": "subtitle", "time": 7728.149, "timestamp": "02:08:48", "text": "疑問点があれば、遠慮なく"}, {"type": "subtitle", "time": 7730.95, "timestamp": "02:08:50", "text": "私に聞いてください。 必要であればお手伝いできます。   私は気にしない"}, {"type": "subtitle", "time": 7735.03, "timestamp": "02:08:55", "text": "。 ええと、でも、"}, {"type": "subtitle", "time": 7737.589, "timestamp": "02:08:57", "text": "すべて制限を設けた方が良いと思います。  PC の動作が"}]
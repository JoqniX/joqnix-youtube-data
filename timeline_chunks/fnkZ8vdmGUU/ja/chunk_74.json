[{"type": "subtitle", "time": 4445.43, "timestamp": "01:14:05", "text": "私の一日はビデオであり、グラフィックです。"}, {"type": "subtitle", "time": 4448.31, "timestamp": "01:14:08", "text": "これをやってから、また法人向けの仕事に戻らなければならない。 私は"}, {"type": "subtitle", "time": 4449.59, "timestamp": "01:14:09", "text": "美術の勉強に時間を費やし、上達を目指しています"}, {"type": "subtitle", "time": 4451.189, "timestamp": "01:14:11", "text": "。"}, {"type": "subtitle", "time": 4453.51, "timestamp": "01:14:13", "text": "えっと、私は少なくとも1時間は苦手です。"}, {"type": "subtitle", "time": 4458.31, "timestamp": "01:14:18", "text": "ビデオゲームの脚本執筆を再開しました。"}, {"type": "subtitle", "time": 4460.47, "timestamp": "01:14:20", "text": "あ、待って。 あなたは文章を書くのですか？ 待って、あなたは"}, {"type": "subtitle", "time": 4462.07, "timestamp": "01:14:22", "text": "作家ですか？"}, {"type": "subtitle", "time": 4465.03, "timestamp": "01:14:25", "text": "あなたはどんなジャンルの作品を書いていますか？ えっと、あなたは"}, {"type": "subtitle", "time": 4468.07, "timestamp": "01:14:28", "text": "短編小説とか、小説とか、そういうものを書く"}, {"type": "subtitle", "time": 4478.47, "timestamp": "01:14:38", "text": "作家ですか？ あ、待って。 ムーンライト"}, {"type": "subtitle", "time": 4481.189, "timestamp": "01:14:41", "text": "ライターとは何ですか？   「"}]
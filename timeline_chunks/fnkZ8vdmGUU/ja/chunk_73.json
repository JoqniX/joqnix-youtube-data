[{"type": "subtitle", "time": 4384.149, "timestamp": "01:13:04", "text": "あのね？ 今週は"}, {"type": "subtitle", "time": 4393.91, "timestamp": "01:13:13", "text": "これらのゲームのおかげで忙しく過ごせています。というのも、繰り返しになりますが"}, {"type": "subtitle", "time": 4396.87, "timestamp": "01:13:16", "text": "、自分が本当に楽しめる"}, {"type": "subtitle", "time": 4399.11, "timestamp": "01:13:19", "text": "趣味に少なくとも1時間を費やすのは良いことだからです"}, {"type": "subtitle", "time": 4401.669, "timestamp": "01:13:21", "text": "。"}, {"type": "subtitle", "time": 4404.47, "timestamp": "01:13:24", "text": "でも私の場合、"}, {"type": "subtitle", "time": 4420.149, "timestamp": "01:13:40", "text": "最近はこれとブループロトコルに集中しているんだけど、いつになったら"}, {"type": "subtitle", "time": 4425.75, "timestamp": "01:13:45", "text": "自分の趣味に時間を割けるんだろうって思ってる。"}, {"type": "subtitle", "time": 4428.79, "timestamp": "01:13:48", "text": "ストリーミングは"}, {"type": "subtitle", "time": 4437.59, "timestamp": "01:13:57", "text": "けど、趣味は"}]
[{"type": "subtitle", "time": 543.19, "timestamp": "00:09:03", "text": "。 しかし、昨シーズンは"}, {"type": "subtitle", "time": 546.949, "timestamp": "00:09:06", "text": "非常に困難だった。"}, {"type": "subtitle", "time": 558.71, "timestamp": "00:09:18", "text": "1 つのエピック スキンをアンロックするには、ミステリー ルート ボックスをルートするボックスが 3,000 個必要で、"}, {"type": "subtitle", "time": 563.269, "timestamp": "00:09:23", "text": "キャラクターをアンロックするには 1,000 個必要です。 それで、前回は"}, {"type": "subtitle", "time": 565.829, "timestamp": "00:09:25", "text": "男性キャラクターのカイドゥというキャラクターに、"}, {"type": "subtitle", "time": 571.509, "timestamp": "00:09:31", "text": "ローラースケートのようなものを持たせました。 あの"}, {"type": "subtitle", "time": 575.509, "timestamp": "00:09:35", "text": "男と、もう一人は"}, {"type": "subtitle", "time": 578.389, "timestamp": "00:09:38", "text": "中国の龍女、水の龍"}, {"type": "subtitle", "time": 581.509, "timestamp": "00:09:41", "text": "女だった。 えっと、彼女の名前は何でしたっけ？"}, {"type": "subtitle", "time": 584.31, "timestamp": "00:09:44", "text": "B. Bishu に関して何か忘れていました。 わからない。"}, {"type": "subtitle", "time": 585.829, "timestamp": "00:09:45", "text": "BUかな"}, {"type": "subtitle", "time": 587.75, "timestamp": "00:09:47", "text": "。   わからない"}, {"type": "subtitle", "time": 589.75, "timestamp": "00:09:49", "text": "。 ええ、あの二人は性格を比較していますね"}, {"type": "subtitle", "time": 593.91, "timestamp": "00:09:53", "text": "。 私は100ドルで音声を購入します。私はそれで問題ないと"}, {"type": "subtitle", "time": 597.43, "timestamp": "00:09:57", "text": "言いました。 また入手できますよ。"}, {"type": "subtitle", "time": 599.269, "timestamp": "00:09:59", "text": "いいえ、大丈夫です。 あまり心配しないでください"}]
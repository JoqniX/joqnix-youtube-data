[{"type": "subtitle", "time": 6986.07, "timestamp": "01:56:26", "text": "、[笑い]"}, {"type": "subtitle", "time": 6989.189, "timestamp": "01:56:29", "text": "襲撃に感謝します。"}, {"type": "subtitle", "time": 6997.35, "timestamp": "01:56:37", "text": "襲撃してくれてありがとう。 こんにちは。 こんにちは。"}, {"type": "subtitle", "time": 7005.95, "timestamp": "01:56:45", "text": "こんにちは。 こんにちは。 襲撃部隊が到着した。"}, {"type": "subtitle", "time": 7007.109, "timestamp": "01:56:47", "text": "[笑い声]"}, {"type": "subtitle", "time": 7008.709, "timestamp": "01:56:48", "text": "ハナ。"}, {"type": "subtitle", "time": 7010.709, "timestamp": "01:56:50", "text": "こんにちは。"}, {"type": "subtitle", "time": 7014.95, "timestamp": "01:56:54", "text": "配信はどうでしたか"}, {"type": "subtitle", "time": 7017.03, "timestamp": "01:56:57", "text": "？レイダーズの皆さん、ようこそ！"}]
[{"type": "subtitle", "time": 11283.11, "timestamp": "03:08:03", "text": "。 あなたをより良くしてくれるでしょう。 うん、それは"}, {"type": "subtitle", "time": 11284.95, "timestamp": "03:08:04", "text": "私をより良くしてくれるだろう。 うん。 うん。 それに"}, {"type": "subtitle", "time": 11287.59, "timestamp": "03:08:07", "text": "、市ヶさんは今英語を勉強しているので、"}, {"type": "subtitle", "time": 11289.59, "timestamp": "03:08:09", "text": "少し教えてあげられるかもしれません。"}, {"type": "subtitle", "time": 11292.95, "timestamp": "03:08:12", "text": "私は英語が苦手ですが、"}, {"type": "subtitle", "time": 11295.75, "timestamp": "03:08:15", "text": "簡単な英語を使うことが多いですよね？"}, {"type": "subtitle", "time": 11298.79, "timestamp": "03:08:18", "text": "小説家が"}, {"type": "subtitle", "time": 11305.99, "timestamp": "03:08:25", "text": "でも、そうですね、私は"}, {"type": "subtitle", "time": 11310.79, "timestamp": "03:08:30", "text": "彼ともっと交流したいと思っています。彼は良い人のようで、"}, {"type": "subtitle", "time": 11313.91, "timestamp": "03:08:33", "text": "多くのユーチューバーと交流していて、"}, {"type": "subtitle", "time": 11317.19, "timestamp": "03:08:37", "text": "それはとてもクールです。 それは"}, {"type": "subtitle", "time": 11319.91, "timestamp": "03:08:39", "text": "外向的なエネルギーのようなもので、まさに私が"}, {"type": "subtitle", "time": 11324.71, "timestamp": "03:08:44", "text": "欠けているものなんです。 私は人見知りがひどくて、自分から人に話しかけることができません"}, {"type": "chat", "time": 11325.935, "timestamp": "03:08:45", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "I watch too much UK content so i have UK English learned 👀"}, {"type": "subtitle", "time": 11327.99, "timestamp": "03:08:47", "text": "。 むしろ、"}, {"type": "subtitle", "time": 11330.23, "timestamp": "03:08:50", "text": "これまで何年も"}, {"type": "subtitle", "time": 11332.71, "timestamp": "03:08:52", "text": "コラボやその他諸々のことで人々が私に連絡してきて、"}]
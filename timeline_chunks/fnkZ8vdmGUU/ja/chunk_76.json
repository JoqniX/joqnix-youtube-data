[{"type": "subtitle", "time": 4562.55, "timestamp": "01:16:02", "text": "自分のグッズを作りたいと思ったんだ"}, {"type": "subtitle", "time": 4565.35, "timestamp": "01:16:05", "text": "けど、"}, {"type": "subtitle", "time": 4567.99, "timestamp": "01:16:07", "text": "音楽のスランプのせいで音楽活動を休止しなければならなかったんだ。 私は他の"}, {"type": "subtitle", "time": 4570.55, "timestamp": "01:16:10", "text": "創造的な分野を模索していました。"}, {"type": "subtitle", "time": 4573.03, "timestamp": "01:16:13", "text": "それが私が芸術の世界に入ったきっかけです。 ゲームデザイン関連のことを試してみました"}, {"type": "subtitle", "time": 4576.47, "timestamp": "01:16:16", "text": "。  Unreal Engine関連のこと"}, {"type": "subtitle", "time": 4579.03, "timestamp": "01:16:19", "text": "。  Blenderではなく、Blendです。 そう、"}, {"type": "subtitle", "time": 4595.91, "timestamp": "01:16:35", "text": "えーと、でも、えーと、"}, {"type": "subtitle", "time": 4598.79, "timestamp": "01:16:38", "text": "私にとっては、えーと、あなたの"}, {"type": "subtitle", "time": 4602.39, "timestamp": "01:16:42", "text": "先祖が書いていたものですよね？ ムーンライト・ライターですよね"}, {"type": "subtitle", "time": 4604.63, "timestamp": "01:16:44", "text": "？ ご存知の通り、私は"}, {"type": "subtitle", "time": 4607.43, "timestamp": "01:16:47", "text": "学士号取得のために英文学を専攻しました。なぜなら、"}, {"type": "subtitle", "time": 4612.31, "timestamp": "01:16:52", "text": "英語だから一番簡単に取得できる学位だと思ったからです。"}, {"type": "subtitle", "time": 4615.35, "timestamp": "01:16:55", "text": "それに、"}, {"type": "subtitle", "time": 4617.03, "timestamp": "01:16:57", "text": "シェイクスピアとか色々学べるから、作家にもなれるんだよね"}, {"type": "subtitle", "time": 4618.31, "timestamp": "01:16:58", "text": "？"}]
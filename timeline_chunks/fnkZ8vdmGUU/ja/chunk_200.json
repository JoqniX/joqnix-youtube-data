[{"type": "subtitle", "time": 12001.03, "timestamp": "03:20:01", "text": "その再生時間からのタイムスタンプです。 つまり、戦争は"}, {"type": "subtitle", "time": 12003.51, "timestamp": "03:20:03", "text": "ランダムな時点から始まるということだ。 お見せしましょうか。"}, {"type": "subtitle", "time": 12005.99, "timestamp": "03:20:05", "text": "でも、"}, {"type": "subtitle", "time": 12008.63, "timestamp": "03:20:08", "text": "YouTubeが埋め込み方法を変更したので、うまくいかないと思います。"}, {"type": "subtitle", "time": 12014.15, "timestamp": "03:20:14", "text": "Twitchと同様に、参照URLを指定する必要があります。"}, {"type": "subtitle", "time": 12016.55, "timestamp": "03:20:16", "text": "ウェブサイトに Twitch ストリームを埋め込もうとする場合、"}, {"type": "subtitle", "time": 12023.11, "timestamp": "03:20:23", "text": "参照にウェブサイトの URL を記載する必要がありますか、それとも記載しませんか。  YouTubeがやっているのと同じ愚かなことだ"}, {"type": "subtitle", "time": 12026.07, "timestamp": "03:20:26", "text": "。 なぜ？"}, {"type": "subtitle", "time": 12029.75, "timestamp": "03:20:29", "text": "だから私のV関連のものは使えないんです。 これ、見えますか？"}, {"type": "subtitle", "time": 12032.469, "timestamp": "03:20:32", "text": "なぜ切り替えるのか？"}, {"type": "subtitle", "time": 12035.59, "timestamp": "03:20:35", "text": "なぜこれに切り替えるのか？ そうはならないでしょう。   ちょっと"}, {"type": "subtitle", "time": 12037.83, "timestamp": "03:20:37", "text": "待って、少し時間をください。 少し待ってください"}, {"type": "subtitle", "time": 12040.07, "timestamp": "03:20:40", "text": "。 見せてあげましょう。 えっと、"}, {"type": "subtitle", "time": 12041.99, "timestamp": "03:20:41", "text": "サミーはどこ？   私の"}, {"type": "subtitle", "time": 12044.63, "timestamp": "03:20:44", "text": "どこにあるのか、さっき"}, {"type": "subtitle", "time": 12046.79, "timestamp": "03:20:46", "text": "その物を取り外したところだ。 ええと、それはうまくいかないでしょう"}, {"type": "subtitle", "time": 12048.469, "timestamp": "03:20:48", "text": "。 えっと、"}, {"type": "subtitle", "time": 12050.87, "timestamp": "03:20:50", "text": "私のバックエンドはどこにあるんですか？"}, {"type": "subtitle", "time": 12059.349, "timestamp": "03:20:59", "text": "待って、それはどこにあるの？ はぁ？  H YouTube ワールド"}]
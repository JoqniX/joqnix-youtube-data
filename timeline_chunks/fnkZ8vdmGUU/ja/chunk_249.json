[{"type": "subtitle", "time": 14941.59, "timestamp": "04:09:01", "text": "明日までにこれを終わらせられるといいな"}, {"type": "subtitle", "time": 14944.229, "timestamp": "04:09:04", "text": "。 キャラクターのレベルを上げなければならなかった"}, {"type": "subtitle", "time": 14946.87, "timestamp": "04:09:06", "text": "。 それは重要です。 そうすれば、"}, {"type": "subtitle", "time": 14950.229, "timestamp": "04:09:10", "text": "これらもできるようになります。 はい。 はい。 はい。"}, {"type": "subtitle", "time": 14953.75, "timestamp": "04:09:13", "text": "少し大変になるだろうけど、"}, {"type": "subtitle", "time": 14956.79, "timestamp": "04:09:16", "text": "明日からキャラクター育成とか色々始めるよ。"}, {"type": "subtitle", "time": 14958.55, "timestamp": "04:09:18", "text": "私は"}, {"type": "subtitle", "time": 14961.11, "timestamp": "04:09:21", "text": "明日。 えっと、明日の朝"}, {"type": "subtitle", "time": 14962.79, "timestamp": "04:09:22", "text": "か何かでやります。 今から寝ます。   わかった"}, {"type": "subtitle", "time": 14971.03, "timestamp": "04:09:31", "text": "ここで終わりにしましょう。 私はとても疲れている。   心の中は完全に"}, {"type": "subtitle", "time": 14974.117, "timestamp": "04:09:34", "text": "死んでしまった。"}, {"type": "subtitle", "time": 14974.79, "timestamp": "04:09:34", "text": "[息を呑み、ため息をつく]"}, {"type": "subtitle", "time": 14990.71, "timestamp": "04:09:50", "text": "私はベッドに飛び込んだ。"}]
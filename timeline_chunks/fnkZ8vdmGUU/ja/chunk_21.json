[{"type": "subtitle", "time": 1262.87, "timestamp": "00:21:02", "text": "射撃が下手だ。 君は射撃が下手だ。 ああ、"}, {"type": "subtitle", "time": 1268.87, "timestamp": "00:21:08", "text": "どうして君は射撃が下手なんだい？"}, {"type": "subtitle", "time": 1273.11, "timestamp": "00:21:13", "text": "うん。 うん。 はい。 殺す。"}, {"type": "subtitle", "time": 1284.87, "timestamp": "00:21:24", "text": "ええ、"}, {"type": "subtitle", "time": 1289.35, "timestamp": "00:21:29", "text": "私はあなたの目の前にいますよ。 撃てよ、"}, {"type": "subtitle", "time": 1291.27, "timestamp": "00:21:31", "text": "おい。"}, {"type": "subtitle", "time": 1294.31, "timestamp": "00:21:34", "text": "どうして弾が外れるのか？"}, {"type": "subtitle", "time": 1297.11, "timestamp": "00:21:37", "text": "私はあなたの鼻の中にいます。   何てことだ"}, {"type": "subtitle", "time": 1310.005, "timestamp": "00:21:50", "text": "ネットワーク。 冗談でしょう？"}, {"type": "subtitle", "time": 1311.59, "timestamp": "00:21:51", "text": "[笑い] 冗談でしょう？ よし、"}, {"type": "subtitle", "time": 1314.31, "timestamp": "00:21:54", "text": "ゲームはこう言うんだ、いや、ジョー、"}]
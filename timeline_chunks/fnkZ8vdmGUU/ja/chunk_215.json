[{"type": "subtitle", "time": 12900.63, "timestamp": "03:35:00", "text": "アディッシュはどうですか？ ホット"}, {"type": "subtitle", "time": 12908.87, "timestamp": "03:35:08", "text": "まで持っていなかったものがたくさんある。"}, {"type": "subtitle", "time": 12911.51, "timestamp": "03:35:11", "text": "あれ、私ってワッフル食べたっけ？ 私は"}, {"type": "subtitle", "time": 12915.429, "timestamp": "03:35:15", "text": "ワッフルを食べたことがあると思います。 わからない。   私は"}, {"type": "subtitle", "time": 12917.83, "timestamp": "03:35:17", "text": "ファストフードを食べるようなタイプではありません"}, {"type": "subtitle", "time": 12921.03, "timestamp": "03:35:21", "text": "。 私はどちらかというと、家庭的な"}, {"type": "subtitle", "time": 12925.269, "timestamp": "03:35:25", "text": "手作り料理が好きです。 私はほとんど外食しないので、自炊料理しか食べません"}, {"type": "subtitle", "time": 12927.51, "timestamp": "03:35:27", "text": "。 それも一つの"}, {"type": "subtitle", "time": 12929.269, "timestamp": "03:35:29", "text": "理由です。"}, {"type": "subtitle", "time": 12932.229, "timestamp": "03:35:32", "text": "でも、やっぱり手作りの料理が一番ですよね"}, {"type": "subtitle", "time": 12946.15, "timestamp": "03:35:46", "text": "彼らは、私をとても幸せな気持ちにさせてくれる美味しいホットチョコレートについて話してくれた"}]
[{"type": "subtitle", "time": 8520.23, "timestamp": "02:22:00", "text": "もマルチストリームなどを好むようになっている"}, {"type": "subtitle", "time": 8523.75, "timestamp": "02:22:03", "text": "。 本当に優れたプラットフォームです。"}, {"type": "subtitle", "time": 8525.27, "timestamp": "02:22:05", "text": "えっと、"}, {"type": "subtitle", "time": 8528.55, "timestamp": "02:22:08", "text": "彼らは「えっと、"}, {"type": "subtitle", "time": 8531.27, "timestamp": "02:22:11", "text": "私はちょっと専門的すぎたと思う」って感じでした。 ごめんなさい"}, {"type": "subtitle", "time": 8533.429, "timestamp": "02:22:13", "text": "。 こういうものが届くと"}, {"type": "subtitle", "time": 8537.99, "timestamp": "02:22:17", "text": "、私はすごく興奮してしまうんです。 きっと私たちはそうでしょう。でも、"}, {"type": "subtitle", "time": 8548.23, "timestamp": "02:22:28", "text": "午前2時近くじゃないよ。うん。"}, {"type": "subtitle", "time": 8553.83, "timestamp": "02:22:33", "text": "明日やらなければならないことがある。 つまり、今日はどれくらいかな、えっと、"}, {"type": "subtitle", "time": 8563.99, "timestamp": "02:22:43", "text": "待って、私はガマサールにたくさんの"}, {"type": "subtitle", "time": 8565.75, "timestamp": "02:22:45", "text": "人がいるんだ [笑い]"}, {"type": "subtitle", "time": 8569.27, "timestamp": "02:22:49", "text": "うん、昔はたくさんの人がいたよ、"}, {"type": "subtitle", "time": 8572.15, "timestamp": "02:22:52", "text": "待って、私のサーバーに参加して。ああ、"}, {"type": "subtitle", "time": 8579.349, "timestamp": "02:22:59", "text": "ところで、自分を確認するのを忘れないでね。そうすれば、ああ、"}]
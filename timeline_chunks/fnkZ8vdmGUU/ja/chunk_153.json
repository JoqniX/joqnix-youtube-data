[{"type": "subtitle", "time": 9186.15, "timestamp": "02:33:06", "text": "日本語が終わったら中国語（北京語）を学びたいです。"}, {"type": "subtitle", "time": 9188.63, "timestamp": "02:33:08", "text": "なぜなら、"}, {"type": "subtitle", "time": 9195.99, "timestamp": "02:33:15", "text": "日本語のように話すには一生懸命努力する必要があると感じる唯一の言語だからです。日本語はリスニングで理解できますが、"}, {"type": "subtitle", "time": 9201.429, "timestamp": "02:33:21", "text": "中国語は、以前ビリービリーで配信していたので、"}, {"type": "subtitle", "time": 9207.11, "timestamp": "02:33:27", "text": "普通に話したいのですが、"}, {"type": "subtitle", "time": 9214.79, "timestamp": "02:33:34", "text": "中国出身の人はみんな英語を知っているわけではないからです。 だから、"}, {"type": "subtitle", "time": 9231.75, "timestamp": "02:33:51", "text": "日本語の軽快なバージョンの"}, {"type": "subtitle", "time": 9234.469, "timestamp": "02:33:54", "text": "原典小説を読んだら、言葉のプレーヤーとか"}, {"type": "subtitle", "time": 9237.11, "timestamp": "02:33:57", "text": "全部聞きました。 ああ、そうそう、私は"}]
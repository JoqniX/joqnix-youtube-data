[{"type": "subtitle", "time": 9661.75, "timestamp": "02:41:01", "text": "。 予約できますよ。"}, {"type": "subtitle", "time": 9664.71, "timestamp": "02:41:04", "text": "バンガロールに1つ、チェンナイに1つあります。"}, {"type": "subtitle", "time": 9668.79, "timestamp": "02:41:08", "text": "私は個人的にNAT試験Q5を受験しました。"}, {"type": "subtitle", "time": 9671.99, "timestamp": "02:41:11", "text": "これはJLPTN5試験に相当します。"}, {"type": "subtitle", "time": 9675.03, "timestamp": "02:41:15", "text": "チェンナイから書きました。   ええ"}, {"type": "subtitle", "time": 9684.15, "timestamp": "02:41:24", "text": "。 私もそれできます。 早めに再登録してください"}, {"type": "subtitle", "time": 9687.67, "timestamp": "02:41:27", "text": "。 試験を受けてください。"}, {"type": "subtitle", "time": 9691.349, "timestamp": "02:41:31", "text": "1週間以内に結果が出ます。"}, {"type": "subtitle", "time": 9697.51, "timestamp": "02:41:37", "text": "例えば、あなたが優秀で、"}, {"type": "subtitle", "time": 9699.11, "timestamp": "02:41:39", "text": "すべての"}, {"type": "subtitle", "time": 9701.19, "timestamp": "02:41:41", "text": "教科書や言語"}, {"type": "subtitle", "time": 9705.99, "timestamp": "02:41:45", "text": "レベルなど、すべてを完全に学習し終えたなら、"}, {"type": "subtitle", "time": 9712.07, "timestamp": "02:41:52", "text": "朝にQ5のような試験を受けて、"}, {"type": "subtitle", "time": 9715.19, "timestamp": "02:41:55", "text": "別のレベルを選択することもできます。 例えば、"}, {"type": "subtitle", "time": 9719.91, "timestamp": "02:41:59", "text": "Q Q3とか、2とか、そんな感じ。   それは"}]
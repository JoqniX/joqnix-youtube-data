[{"type": "subtitle", "time": 9721.59, "timestamp": "02:42:01", "text": "午後の部ですよね"}, {"type": "subtitle", "time": 9724.309, "timestamp": "02:42:04", "text": "。 ですから、"}, {"type": "subtitle", "time": 9727.429, "timestamp": "02:42:07", "text": "ゲルPTの認定や"}, {"type": "subtitle", "time": 9729.67, "timestamp": "02:42:09", "text": "言語の習熟度に関しては、"}, {"type": "subtitle", "time": 9734.55, "timestamp": "02:42:14", "text": "最高レベルが最初に取られます。"}, {"type": "subtitle", "time": 9737.429, "timestamp": "02:42:17", "text": "ですから、レベルを飛ばすこともできますし、十分流暢であれば"}, {"type": "subtitle", "time": 9740.309, "timestamp": "02:42:20", "text": "すぐにN1を受験することもできます。N1"}, {"type": "subtitle", "time": 9747.349, "timestamp": "02:42:27", "text": "試験に挑戦することもできます"}, {"type": "subtitle", "time": 9764.15, "timestamp": "02:42:44", "text": "チェンナイのものは、土鞠になります。"}, {"type": "subtitle", "time": 9774.15, "timestamp": "02:42:54", "text": "調べてみてください。 そこに試験問題が載っています"}]
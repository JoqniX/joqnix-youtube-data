[{"type": "subtitle", "time": 4860.39, "timestamp": "01:21:00", "text": "私はこれまでずっと色々な"}, {"type": "subtitle", "time": 4862.55, "timestamp": "01:21:02", "text": "ことに手を出していて、"}, {"type": "subtitle", "time": 4864.79, "timestamp": "01:21:04", "text": "一つのことに固執してこなかった。そのせいで"}, {"type": "subtitle", "time": 4867.27, "timestamp": "01:21:07", "text": "燃え尽きてしまい、"}, {"type": "subtitle", "time": 4871.03, "timestamp": "01:21:11", "text": "一つのレベルに留まらざるを得なかった。"}, {"type": "subtitle", "time": 4875.91, "timestamp": "01:21:15", "text": "それらを努力して現実のものにしない限りはね。 うん。 だから、私は"}, {"type": "subtitle", "time": 4878.31, "timestamp": "01:21:18", "text": "基本的に何でも屋で"}, {"type": "subtitle", "time": 4880.87, "timestamp": "01:21:20", "text": "、どれも一流ではない、そんな状態だったんだと思う。"}, {"type": "subtitle", "time": 4883.669, "timestamp": "01:21:23", "text": "そして、私は燃え尽きてしまった。 私は"}, {"type": "subtitle", "time": 4886.31, "timestamp": "01:21:26", "text": "自分で状況を悪化させてしまった。 それで私は"}, {"type": "subtitle", "time": 4893.43, "timestamp": "01:21:33", "text": "そのアイテムは、はい。"}, {"type": "subtitle", "time": 4896.39, "timestamp": "01:21:36", "text": "そして、もし私がそのアイデアを実行しないとしたら、それは"}, {"type": "subtitle", "time": 4906.63, "timestamp": "01:21:46", "text": "今は自分の短編映画を執筆中です。 ああ、行こう"}, {"type": "subtitle", "time": 4914.95, "timestamp": "01:21:54", "text": "短編"}, {"type": "subtitle", "time": 4917.59, "timestamp": "01:21:57", "text": "映画といえば、2017年とか2018年とか、"}]
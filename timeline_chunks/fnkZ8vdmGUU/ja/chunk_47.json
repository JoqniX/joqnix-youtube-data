[{"type": "subtitle", "time": 2820.71, "timestamp": "00:47:00", "text": "アイテムを使ってレベルアップする必要がある、ということでしょうか"}, {"type": "subtitle", "time": 2823.99, "timestamp": "00:47:03", "text": "。"}, {"type": "subtitle", "time": 2826.39, "timestamp": "00:47:06", "text": "私はこの分野に詳しくありません。"}, {"type": "subtitle", "time": 2827.99, "timestamp": "00:47:07", "text": "チュートリアルとかに従わないといけないんです"}, {"type": "subtitle", "time": 2830.23, "timestamp": "00:47:10", "text": "。 わからない。"}, {"type": "subtitle", "time": 2837.03, "timestamp": "00:47:17", "text": "プライム。"}, {"type": "subtitle", "time": 2840.069, "timestamp": "00:47:20", "text": "プライム・セレニティはどこにありますか？ プライムセレニティを入手する必要がある"}, {"type": "subtitle", "time": 2846.95, "timestamp": "00:47:26", "text": "最高の静寂。"}, {"type": "subtitle", "time": 2850.309, "timestamp": "00:47:30", "text": "ああ、そうじゃない。 これは、"}, {"type": "subtitle", "time": 2853.75, "timestamp": "00:47:33", "text": "えっと、探し出す。 フンとは誰ですか？"}, {"type": "subtitle", "time": 2856.63, "timestamp": "00:47:36", "text": "私はこれを望んでいない。 プライム"}, {"type": "subtitle", "time": 2858.63, "timestamp": "00:47:38", "text": "セレニティを置きます。"}, {"type": "subtitle", "time": 2861.03, "timestamp": "00:47:41", "text": "ええ、見てください。 水害による被害はさらに増加し​​ている。"}, {"type": "subtitle", "time": 2863.99, "timestamp": "00:47:43", "text": "うん、平穏の方がいいよね。"}, {"type": "subtitle", "time": 2869.91, "timestamp": "00:47:49", "text": "良い。 わかった。 ああ、彼女をアップグレードできるよ。 わーい。"}, {"type": "subtitle", "time": 2879.43, "timestamp": "00:47:59", "text": "、いいよ。   あとどれくらい"}]
[{"type": "subtitle", "time": 12787.67, "timestamp": "03:33:07", "text": "。 高価な会社は一つもない"}, {"type": "subtitle", "time": 12791.269, "timestamp": "03:33:11", "text": "。 いや、それはまずい。 もし"}, {"type": "subtitle", "time": 12796.15, "timestamp": "03:33:16", "text": "その道を選んだら、"}, {"type": "subtitle", "time": 12799.59, "timestamp": "03:33:19", "text": "1ヶ月も経たないうちに破産してしまうだろう。 それはひどい"}, {"type": "subtitle", "time": 12802.15, "timestamp": "03:33:22", "text": "コンビニエンスストアだし、値段も"}, {"type": "subtitle", "time": 12804.389, "timestamp": "03:33:24", "text": "高くなるだろう。"}, {"type": "subtitle", "time": 12806.15, "timestamp": "03:33:26", "text": "そういう"}, {"type": "subtitle", "time": 12807.99, "timestamp": "03:33:27", "text": "コンビニエンスストアの中には、卸売"}, {"type": "subtitle", "time": 12811.51, "timestamp": "03:33:31", "text": "価格で安く売っているところもあるんです。 だから、"}, {"type": "subtitle", "time": 12816.95, "timestamp": "03:33:36", "text": "野菜とか果物とかと一緒にまとめて買いに行かないといけないんです"}, {"type": "subtitle", "time": 12821.91, "timestamp": "03:33:41", "text": "。 それから、ええと、"}, {"type": "subtitle", "time": 12824.389, "timestamp": "03:33:44", "text": "自宅で自分で作ります。つまり、"}, {"type": "subtitle", "time": 12827.91, "timestamp": "03:33:47", "text": "ドメトリーで。  S"}, {"type": "subtitle", "time": 12832.469, "timestamp": "03:33:52", "text": "なので、日本のコストコで複数個買いました。"}]
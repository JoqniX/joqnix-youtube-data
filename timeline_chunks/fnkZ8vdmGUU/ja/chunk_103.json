[{"type": "subtitle", "time": 6182.07, "timestamp": "01:43:02", "text": "、"}, {"type": "subtitle", "time": 6187.83, "timestamp": "01:43:07", "text": "スパイダーマンが好きで、子供の頃に"}, {"type": "subtitle", "time": 6193.75, "timestamp": "01:43:13", "text": "「よし、クモをペットにすれば"}, {"type": "subtitle", "time": 6197.27, "timestamp": "01:43:17", "text": "スパイダーマンになれる」って思ったことがあったんだよ。"}, {"type": "subtitle", "time": 6201.601, "timestamp": "01:43:21", "text": "それが私の信じていたことだ。 昔は"}, {"type": "subtitle", "time": 6202.149, "timestamp": "01:43:22", "text": "（笑）"}, {"type": "subtitle", "time": 6205.51, "timestamp": "01:43:25", "text": "クモを手に乗せて、"}, {"type": "subtitle", "time": 6207.496, "timestamp": "01:43:27", "text": "クモに噛まれたりしてたんだ。 だから私は"}, {"type": "subtitle", "time": 6209.83, "timestamp": "01:43:29", "text": "（息を呑んで）「私、スパイダーマンになれる！」って思ったんです。 私には"}, {"type": "subtitle", "time": 6212.709, "timestamp": "01:43:32", "text": "超能力とか色々あるんだ。"}, {"type": "subtitle", "time": 6216.87, "timestamp": "01:43:36", "text": "その後、それは良くないことだと気づいた。"}, {"type": "subtitle", "time": 6221.43, "timestamp": "01:43:41", "text": "幸いなことに、私はクモに噛まれませんでした。   ああ"}, {"type": "subtitle", "time": 6224.31, "timestamp": "01:43:44", "text": "、本当に久しぶりだ。"}, {"type": "subtitle", "time": 6228.149, "timestamp": "01:43:48", "text": "子供の頃の思い出を振り返ると、"}, {"type": "subtitle", "time": 6231.99, "timestamp": "01:43:51", "text": "懐かしい気持ちになった。 ああ、私って昔、本当に"}, {"type": "subtitle", "time": 6234.352, "timestamp": "01:43:54", "text": "変なことばかりしてたわ。"}]
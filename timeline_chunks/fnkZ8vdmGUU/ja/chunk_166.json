[{"type": "subtitle", "time": 9966.63, "timestamp": "02:46:06", "text": "待って。 いつ寝るの？ えっと、それだと"}, {"type": "subtitle", "time": 9978.309, "timestamp": "02:46:18", "text": "ああ、これはとても面白い。 しかし、"}, {"type": "subtitle", "time": 9983.349, "timestamp": "02:46:23", "text": "明日の仕事のために午前10時過ぎに出勤するのは大変だ。"}, {"type": "subtitle", "time": 9986.07, "timestamp": "02:46:26", "text": "私はただ「わかった」と言った。"}, {"type": "subtitle", "time": 9988.15, "timestamp": "02:46:28", "text": "おお。"}, {"type": "subtitle", "time": 10013.67, "timestamp": "02:46:53", "text": "今日は"}]
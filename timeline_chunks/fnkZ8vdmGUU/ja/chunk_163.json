[{"type": "subtitle", "time": 9793.59, "timestamp": "02:43:13", "text": "えっと、後ろ向きに歩いてしまいました。 うん、レベルを"}, {"type": "subtitle", "time": 9795.19, "timestamp": "02:43:15", "text": "逆方向​​に進めたり、場合によってはスキップしたりできるんだよ"}, {"type": "subtitle", "time": 9801.27, "timestamp": "02:43:21", "text": "ああ、そうだね。  J の場合、"}, {"type": "subtitle", "time": 9804.79, "timestamp": "02:43:24", "text": "日本に行く場合などは、仕事には最低 N2 が必要です。N4"}, {"type": "subtitle", "time": 9810.15, "timestamp": "02:43:30", "text": "または N3 でも十分です"}, {"type": "subtitle", "time": 9812.79, "timestamp": "02:43:32", "text": "が、主に流暢さ、"}, {"type": "subtitle", "time": 9816.55, "timestamp": "02:43:36", "text": "日常生活やあらゆる会話をうまく話せるかどうかが重視されます。"}, {"type": "subtitle", "time": 9820.95, "timestamp": "02:43:40", "text": "実際のビジネス ジョブには"}, {"type": "subtitle", "time": 9823.91, "timestamp": "02:43:43", "text": "最低 N2 が必要です。最低"}, {"type": "subtitle", "time": 9826.79, "timestamp": "02:43:46", "text": "要件はありません。要件は"}, {"type": "subtitle", "time": 9830.23, "timestamp": "02:43:50", "text": "N2 です。"}, {"type": "subtitle", "time": 9831.75, "timestamp": "02:43:51", "text": "そして"}]
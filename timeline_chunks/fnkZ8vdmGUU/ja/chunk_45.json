[{"type": "subtitle", "time": 2702.23, "timestamp": "00:45:02", "text": "つまり、3つのティアがあり、ティア3は"}, {"type": "subtitle", "time": 2705.829, "timestamp": "00:45:05", "text": "通常の1のようなものです。 ティア2では2"}, {"type": "subtitle", "time": 2709.829, "timestamp": "00:45:09", "text": "発、ティア1では10"}, {"type": "subtitle", "time": 2715.19, "timestamp": "00:45:15", "text": "発撃てます。 つまり、30発くらい必要ってことですね。"}, {"type": "subtitle", "time": 2717.91, "timestamp": "00:45:17", "text": "キャラクターを入手するには30発撃つ必要があります。"}, {"type": "subtitle", "time": 2720.39, "timestamp": "00:45:20", "text": "例えば、"}, {"type": "subtitle", "time": 2722.71, "timestamp": "00:45:22", "text": "私はこのキャラクターを持っていません。 いや、"}, {"type": "subtitle", "time": 2725.43, "timestamp": "00:45:25", "text": "でもここでは30人中20人くらいだよね？"}, {"type": "subtitle", "time": 2728.79, "timestamp": "00:45:28", "text": "だから、あと10発撃つ必要がある。"}, {"type": "subtitle", "time": 2731.67, "timestamp": "00:45:31", "text": "彼らはそれを思考と呼ぶ。   そうすれば、"}, {"type": "subtitle", "time": 2733.43, "timestamp": "00:45:33", "text": "このキャラクターを無料でアンロックできる"}, {"type": "subtitle", "time": 2737.589, "timestamp": "00:45:37", "text": "。 あるいは、もし私が"}, {"type": "subtitle", "time": 2740.55, "timestamp": "00:45:40", "text": "ファームしたくない場合は、いつでもこの通貨を購入することもできます。"}, {"type": "subtitle", "time": 2744.55, "timestamp": "00:45:44", "text": "ええ、"}, {"type": "subtitle", "time": 2748.309, "timestamp": "00:45:48", "text": "それも選択肢の一つですが、"}, {"type": "subtitle", "time": 2751.109, "timestamp": "00:45:51", "text": "近接武器も含めてすべてが遠いのです"}, {"type": "subtitle", "time": 2753.589, "timestamp": "00:45:53", "text": "。"}, {"type": "subtitle", "time": 2757.03, "timestamp": "00:45:57", "text": "近接武器も遠距離"}]
[{"type": "subtitle", "time": 5224.55, "timestamp": "01:27:04", "text": "私はまた日本に行かなければならない。 え、"}, {"type": "subtitle", "time": 5226.55, "timestamp": "01:27:06", "text": "日本に行ったの？ あなたは何処に行きましたか？ どの"}, {"type": "subtitle", "time": 5229.03, "timestamp": "01:27:09", "text": "都市ですか？"}, {"type": "subtitle", "time": 5231.75, "timestamp": "01:27:11", "text": "ああ、効果があったよ。 彼は自分が既に"}, {"type": "subtitle", "time": 5237.75, "timestamp": "01:27:17", "text": "私の魂と背景"}, {"type": "subtitle", "time": 5243.59, "timestamp": "01:27:23", "text": "ズームはゲームについて話すのに費やされた。 いやー"}, {"type": "subtitle", "time": 5255.51, "timestamp": "01:27:35", "text": "エレン・リングが恋しい。"}, {"type": "subtitle", "time": 5257.75, "timestamp": "01:27:37", "text": "エレン・リングのマルチプレイヤー"}, {"type": "subtitle", "time": 5261.669, "timestamp": "01:27:41", "text": "版もありますよね？ あるいは、そんな感じ。"}, {"type": "subtitle", "time": 5263.91, "timestamp": "01:27:43", "text": "ダークソウル。 私はダークソウルをプレイしたことがありません。"}, {"type": "subtitle", "time": 5267.27, "timestamp": "01:27:47", "text": "いつかプレイしてみたい。"}, {"type": "subtitle", "time": 5270.47, "timestamp": "01:27:50", "text": "それから、スーリヤ、えっと、何かアドバイスが欲しかったの"}, {"type": "subtitle", "time": 5273.83, "timestamp": "01:27:53", "text": "？ どうしたの？ どうしたの？"}, {"type": "subtitle", "time": 5276.07, "timestamp": "01:27:56", "text": "あなたは眠っていません。"}, {"type": "subtitle", "time": 5279.35, "timestamp": "01:27:59", "text": "こんな時間なら寝てるんじゃないの？"}]
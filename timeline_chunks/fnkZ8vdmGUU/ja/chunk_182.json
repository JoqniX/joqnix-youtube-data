[{"type": "subtitle", "time": 10929.11, "timestamp": "03:02:09", "text": "ブループロトコルにはすでに300時間以上費やしたと思う。 でも"}, {"type": "subtitle", "time": 10931.429, "timestamp": "03:02:11", "text": "、"}, {"type": "subtitle", "time": 10942.79, "timestamp": "03:02:22", "text": "私の声と演技のせいで、"}, {"type": "subtitle", "time": 10945.19, "timestamp": "03:02:25", "text": "アクセントがあるかどうかはわかりませんが、最初は多くの人が"}, {"type": "subtitle", "time": 10947.51, "timestamp": "03:02:27", "text": "私をインド人か"}, {"type": "subtitle", "time": 10950.07, "timestamp": "03:02:30", "text": "何かだとは思わなかったでしょうね？   そういう側面もあるんですね"}]
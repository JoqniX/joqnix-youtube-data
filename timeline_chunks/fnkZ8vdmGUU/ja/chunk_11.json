[{"type": "subtitle", "time": 661.43, "timestamp": "00:11:01", "text": "。 ニース。 ニース。 ニース。"}, {"type": "subtitle", "time": 665.11, "timestamp": "00:11:05", "text": "それは本当に素晴らしいですね。"}, {"type": "subtitle", "time": 670.87, "timestamp": "00:11:10", "text": "。 えっと、ちょっと待ってください。"}, {"type": "subtitle", "time": 677.03, "timestamp": "00:11:17", "text": "話している最中に、うっかり壁を開けてしまったんです。"}, {"type": "subtitle", "time": 679.829, "timestamp": "00:11:19", "text": "彼らのうち、最上段の棚を禁止している人たちのことだよ。"}, {"type": "subtitle", "time": 681.91, "timestamp": "00:11:21", "text": "うん。 つまり、Farlightの方が"}, {"type": "subtitle", "time": 687.829, "timestamp": "00:11:27", "text": "ランク上げなどがしやすいゲームなんです。 それが、"}, {"type": "subtitle", "time": 691.91, "timestamp": "00:11:31", "text": "私がこのゲームでランクマッチをプレイすることを選んだ理由だと思います"}, {"type": "subtitle", "time": 694.55, "timestamp": "00:11:34", "text": "。 そうでなければ、"}, {"type": "subtitle", "time": 697.03, "timestamp": "00:11:37", "text": "Apexでランクを上げたりする方が良かったんだけどね"}, {"type": "subtitle", "time": 699.19, "timestamp": "00:11:39", "text": "。 それはもっと難しいですよね"}, {"type": "subtitle", "time": 704.31, "timestamp": "00:11:44", "text": "？ ヴァレラントやエイペックスみたいなやつ。"}, {"type": "subtitle", "time": 706.71, "timestamp": "00:11:46", "text": "それはインドでの「Bang」だったのか？ 昔はトップ"}, {"type": "subtitle", "time": 711.91, "timestamp": "00:11:51", "text": "60に入っていたと思う。 よくわからない。   もうよくわから"}, {"type": "subtitle", "time": 715.43, "timestamp": "00:11:55", "text": "ない。   もう"}, {"type": "subtitle", "time": 717.91, "timestamp": "00:11:57", "text": "頑張るのをやめたんだよ。 私は研磨作業を止めた"}]
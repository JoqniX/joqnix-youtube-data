[{"type": "subtitle", "time": 123.786, "timestamp": "00:02:03", "text": "[ベル]"}, {"type": "subtitle", "time": 134.07, "timestamp": "00:02:14", "text": "ああ、皆さんこんにちは。"}, {"type": "subtitle", "time": 143.11, "timestamp": "00:02:23", "text": "皆さん、今夜はいかがお過ごしですか？"}, {"type": "subtitle", "time": 147.43, "timestamp": "00:02:27", "text": "うん。 今日はVRチャットをする予定だったのですが、"}, {"type": "subtitle", "time": 152.55, "timestamp": "00:02:32", "text": "今日は全員不在でした。 だから"}, {"type": "subtitle", "time": 159.50900000000001, "timestamp": "00:02:39", "text": "今日は"}, {"type": "subtitle", "time": 162.869, "timestamp": "00:02:42", "text": "家族とかと一緒に墓地に行かなきゃならなかったんだ。   ええ、そうなんです、"}, {"type": "subtitle", "time": 167.91, "timestamp": "00:02:47", "text": "今日は教会関連の用事がたくさんあったんですが、私は"}, {"type": "subtitle", "time": 172.39, "timestamp": "00:02:52", "text": "全く知らなかったんです。"}, {"type": "subtitle", "time": 174.47, "timestamp": "00:02:54", "text": "それはそこにあった。   だから"}, {"type": "subtitle", "time": 176.47, "timestamp": "00:02:56", "text": "、"}]
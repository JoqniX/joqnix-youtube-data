[{"type": "subtitle", "time": 8400.71, "timestamp": "02:20:00", "text": "電源コードが抜けたりするなどの何らかの問題が発生した場合、"}, {"type": "subtitle", "time": 8402.79, "timestamp": "02:20:02", "text": "ストリームが正常に終了しない可能性があります。"}, {"type": "subtitle", "time": 8405.429, "timestamp": "02:20:05", "text": "しかし、私の場合は、"}, {"type": "subtitle", "time": 8408.87, "timestamp": "02:20:08", "text": "別のマルチサーバーに送信しています。  YouTubeを使う時だけマルチアプリを使うのは、"}, {"type": "subtitle", "time": 8412.95, "timestamp": "02:20:12", "text": "YouTubeが面倒くさいから。"}, {"type": "subtitle", "time": 8417.349, "timestamp": "02:20:17", "text": "私はBeam Studioというソフトを使っています。 ビーム"}, {"type": "subtitle", "time": 8419.67, "timestamp": "02:20:19", "text": "ストリーム。"}, {"type": "subtitle", "time": 8421.99, "timestamp": "02:20:21", "text": "待っていてください。 ここは私が自分の"}, {"type": "subtitle", "time": 8426.23, "timestamp": "02:20:26", "text": "配信を他のサービス（Twitchなど）に送信する場所です。"}, {"type": "subtitle", "time": 8427.91, "timestamp": "02:20:27", "text": "ちなみに、"}, {"type": "subtitle", "time": 8433.03, "timestamp": "02:20:33", "text": "ポンプ競技を見ている人のために、私はビームでもライブ配信しています。"}, {"type": "subtitle", "time": 8435.59, "timestamp": "02:20:35", "text": "彼らはTwitchやYouTubeなど複数のプラットフォームを運営していて、"}, {"type": "subtitle", "time": 8440.389, "timestamp": "02:20:40", "text": "チャットもすべてここにあります。 だから私は平均"}, {"type": "subtitle", "time": 8443.03, "timestamp": "02:20:43", "text": "台の上にいるんです。 私はbeamでライブ配信中、Twitchでライブ配信中、"}, {"type": "subtitle", "time": 8445.99, "timestamp": "02:20:45", "text": "kickでもライブ配信中。"}, {"type": "subtitle", "time": 8448.63, "timestamp": "02:20:48", "text": "ここから様々なプラットフォームを追加できます。"}, {"type": "subtitle", "time": 8451.99, "timestamp": "02:20:51", "text": "垂直方向と水平方向の両方に対応しています。 本当に"}, {"type": "subtitle", "time": 8453.75, "timestamp": "02:20:53", "text": "良い。"}, {"type": "subtitle", "time": 8456.79, "timestamp": "02:20:56", "text": "どのプラットフォームでも構いません。 でも、すごく美味しいんです。 ビームは"}, {"type": "subtitle", "time": 8458.71, "timestamp": "02:20:58", "text": "とても良い。 マルチ"}]
[{"type": "subtitle", "time": 12062.229, "timestamp": "03:21:02", "text": "サイクル。 ああ、この人ですか？ うん。"}, {"type": "subtitle", "time": 12064.71, "timestamp": "03:21:04", "text": "うん。 この動画を見ると、エラー"}, {"type": "subtitle", "time": 12068.389, "timestamp": "03:21:08", "text": "153が表示されます。これが表示されるエラーメッセージです。"}, {"type": "subtitle", "time": 12070.229, "timestamp": "03:21:10", "text": "これは、参照やURLのない"}, {"type": "subtitle", "time": 12073.19, "timestamp": "03:21:13", "text": "通常のVAリンク、つまり埋め込みリンクを配置した場合に表示されるエラーメッセージです"}, {"type": "subtitle", "time": 12076.71, "timestamp": "03:21:16", "text": "。"}, {"type": "subtitle", "time": 12080.15, "timestamp": "03:21:20", "text": "でも実際は、Google"}, {"type": "subtitle", "time": 12093.269, "timestamp": "03:21:33", "text": "そう、それはすべての「うん」を生み出す。 つまり、"}, {"type": "subtitle", "time": 12096.71, "timestamp": "03:21:36", "text": "私のDNAが本人であることを確認しているということですね。 見つけられますよ"}, {"type": "subtitle", "time": 12098.95, "timestamp": "03:21:38", "text": "。  Twitchのカテゴリは、夜の"}, {"type": "subtitle", "time": 12101.11, "timestamp": "03:21:41", "text": "深淵で行われます。  Twitchのタイトルはこれです。 私の"}, {"type": "subtitle", "time": 12104.229, "timestamp": "03:21:44", "text": "Twitchのカテゴリが「夜にやる」なら、これが"}, {"type": "subtitle", "time": 12106.63, "timestamp": "03:21:46", "text": "プレイリストです。 夜の深淵の"}, {"type": "subtitle", "time": 12110.55, "timestamp": "03:21:50", "text": "プレイリストのことですよね？ そして、"}, {"type": "subtitle", "time": 12113.59, "timestamp": "03:21:53", "text": "旧バージョン3と同様に30本の動画を生成します。"}, {"type": "subtitle", "time": 12117.99, "timestamp": "03:21:57", "text": "今日の配信を含めて、これまでに私が配信した4回分です。"}]
[{"type": "subtitle", "time": 3961.029, "timestamp": "01:06:01", "text": "ブレード、ブレードか何かを作っています。 まるで"}, {"type": "subtitle", "time": 3964.549, "timestamp": "01:06:04", "text": "悪魔の楔が"}, {"type": "subtitle", "time": 3967.19, "timestamp": "01:06:07", "text": "空中に突き出ているかのようだ。"}, {"type": "subtitle", "time": 3969.99, "timestamp": "01:06:09", "text": "それを連打して、"}, {"type": "subtitle", "time": 3972.71, "timestamp": "01:06:12", "text": "スタミナを無駄にしたり、"}, {"type": "subtitle", "time": 3981.19, "timestamp": "01:06:21", "text": "天才的な激痛による背中の痛みからようやく回復してきたところです"}, {"type": "subtitle", "time": 3985.109, "timestamp": "01:06:25", "text": "。 ああ。"}, {"type": "subtitle", "time": 3988.71, "timestamp": "01:06:28", "text": "私は以前、"}, {"type": "subtitle", "time": 3993.349, "timestamp": "01:06:33", "text": "原神からバイオの後悔を得ていました。 私はレンレン・ライデン・"}, {"type": "subtitle", "time": 3997.029, "timestamp": "01:06:37", "text": "ショーグンがどうしても欲しかったのですが、結局手に入れることはできませんでした。 でも、"}, {"type": "subtitle", "time": 4005.19, "timestamp": "01:06:45", "text": "お金で買ったプリモジェムを使い切って、"}, {"type": "subtitle", "time": 4007.829, "timestamp": "01:06:47", "text": "無料の1回ガチャを引いたら彼女が出てきて、すごく気分が"}, {"type": "subtitle", "time": 4018.309, "timestamp": "01:06:58", "text": "悪くなったんです。 えっと、なんで"}]
[{"type": "subtitle", "time": 900.23, "timestamp": "00:15:00", "text": "待って、待って、待って、待って。 できると思う。 放置して"}, {"type": "subtitle", "time": 902.629, "timestamp": "00:15:02", "text": "先に死ぬこともできる。 少なくとも、"}, {"type": "subtitle", "time": 909.75, "timestamp": "00:15:09", "text": "少なくとも、その物を手に入れることができる。"}, {"type": "subtitle", "time": 936.23, "timestamp": "00:15:36", "text": "テーマは「ひたすら作業すること」にしたかったんです。"}, {"type": "subtitle", "time": 939.43, "timestamp": "00:15:39", "text": "それが私たちがここにいる理由です。"}, {"type": "subtitle", "time": 942.069, "timestamp": "00:15:42", "text": "こんにちは、ズーラ。 ありえない。"}]
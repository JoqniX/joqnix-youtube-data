[{"type": "subtitle", "time": 15005.11, "timestamp": "04:10:05", "text": "私はたくさんプレイしました。 私たちはたくさん話しました。"}, {"type": "subtitle", "time": 15007.67, "timestamp": "04:10:07", "text": "今日はたくさんの新しい人が私の配信を見に来てくれて、"}, {"type": "subtitle", "time": 15010.95, "timestamp": "04:10:10", "text": "レイドもありました。"}, {"type": "subtitle", "time": 15015.269, "timestamp": "04:10:15", "text": "本日お越しいただいた皆様、ありがとうございました。"}, {"type": "subtitle", "time": 15031.67, "timestamp": "04:10:31", "text": "ここで終わりにします。 私は寝ます"}, {"type": "subtitle", "time": 15034.15, "timestamp": "04:10:34", "text": "。 明日また会おう。 よし"}, {"type": "chat", "time": 15040.373, "timestamp": "04:10:40", "author": "@Dragnozer", "avatar": "https://yt4.ggpht.com/S76Kh7cHFwpQNz9yjhQC88CHN2CaFRgcX6E1lcl7bEXBNP_DPdf1iSETHK2qlrHYkwo6BbPw=s64-c-k-c0x00ffffff-no-rj", "message": "good night"}, {"type": "subtitle", "time": 15050.309, "timestamp": "04:10:50", "text": "私は寝ます。"}, {"type": "subtitle", "time": 15053.349, "timestamp": "04:10:53", "text": "おやすみ。 こんにちは、ドラゴン。"}, {"type": "subtitle", "time": 15056.55, "timestamp": "04:10:56", "text": "こんにちは。 私は寝ます。"}, {"type": "subtitle", "time": 15058.71, "timestamp": "04:10:58", "text": "ああ、もう4時間も配信してるよ。"}]
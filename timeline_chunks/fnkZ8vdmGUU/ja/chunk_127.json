[{"type": "subtitle", "time": 7623.75, "timestamp": "02:07:03", "text": "。   では、他に"}, {"type": "subtitle", "time": 7626.149, "timestamp": "02:07:06", "text": "何があるだろうか？  [息を呑む] ええ"}, {"type": "subtitle", "time": 7630.709, "timestamp": "02:07:10", "text": "、もし忘れてしまったら。"}, {"type": "subtitle", "time": 7633.189, "timestamp": "02:07:13", "text": "私は遅れているのでしょうか？ はい、ちょっとラグってました。"}, {"type": "subtitle", "time": 7635.27, "timestamp": "02:07:15", "text": "もしどの設定を"}, {"type": "subtitle", "time": 7637.83, "timestamp": "02:07:17", "text": "変更すればいいのか、何をすればいいのかなどを忘れてしまった場合に備えて、"}, {"type": "subtitle", "time": 7641.189, "timestamp": "02:07:21", "text": "プラグインの機能リクエストをしました。"}, {"type": "subtitle", "time": 7644.79, "timestamp": "02:07:24", "text": "つまり、それはデフォルトソースデフォルトと呼ばれています"}, {"type": "subtitle", "time": 7648.069, "timestamp": "02:07:28", "text": "。  Googleで検索すればいいよ。 テクスチャが設定されていません"}, {"type": "subtitle", "time": 7649.589, "timestamp": "02:07:29", "text": "。"}, {"type": "subtitle", "time": 7659.99, "timestamp": "02:07:39", "text": "えっと、ちょっと待ってください。"}, {"type": "subtitle", "time": 7662.629, "timestamp": "02:07:42", "text": "ええ、OBSには「"}, {"type": "subtitle", "time": 7665.03, "timestamp": "02:07:45", "text": "ソースデフォルト」というプラグインがありますよ。"}, {"type": "subtitle", "time": 7667.03, "timestamp": "02:07:47", "text": "つまり、これによって"}, {"type": "subtitle", "time": 7669.51, "timestamp": "02:07:49", "text": "親ソースを設定したり、"}, {"type": "subtitle", "time": 7672.95, "timestamp": "02:07:52", "text": "その他いろいろなことができるようになるということです。 ああ、"}, {"type": "subtitle", "time": 7675.43, "timestamp": "02:07:55", "text": "新しいアップデートが追加されました。 でも、そうですね、以前の"}, {"type": "subtitle", "time": 7678.95, "timestamp": "02:07:58", "text": "バージョンでは、私が提案したように、"}]
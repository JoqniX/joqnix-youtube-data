[{"type": "subtitle", "time": 3726.069, "timestamp": "01:02:06", "text": "。 彼女を利用するために送り出したいのですが"}, {"type": "subtitle", "time": 3735.43, "timestamp": "01:02:15", "text": "彼女にこれを渡してしまいました。"}, {"type": "subtitle", "time": 3738.95, "timestamp": "01:02:18", "text": "ええ、これもレベルアップさせないといけないですね"}, {"type": "subtitle", "time": 3749.19, "timestamp": "01:02:29", "text": "うん、レディ・ネフを手に入れたよ。"}, {"type": "subtitle", "time": 3752.789, "timestamp": "01:02:32", "text": "シボに関しては、私は運が悪かった。"}, {"type": "subtitle", "time": 3758.47, "timestamp": "01:02:38", "text": "今のところ、2つしか手に入れていません。"}, {"type": "subtitle", "time": 3763.349, "timestamp": "01:02:43", "text": "10個買いました。わかりました。 そして10個のうち、私が手に入れたのはたった"}, {"type": "subtitle", "time": 3767.593, "timestamp": "01:02:47", "text": "2個だった。 私は本当に不運だった。"}, {"type": "subtitle", "time": 3775.27, "timestamp": "01:02:55", "text": "それに、C6、つまり"}]
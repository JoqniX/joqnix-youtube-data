[{"type": "subtitle", "time": 3542.549, "timestamp": "00:59:02", "text": "だから私は「わかった、いいよ。"}, {"type": "subtitle", "time": 3544.95, "timestamp": "00:59:04", "text": "デーモン・ヴェスをやるよ」って思ったんだ。 なぜなら、"}, {"type": "subtitle", "time": 3547.27, "timestamp": "00:59:07", "text": "私はこれまでずっと"}, {"type": "subtitle", "time": 3551.589, "timestamp": "00:59:11", "text": "キャラクターのレベル上げや"}, {"type": "subtitle", "time": 3554.309, "timestamp": "00:59:14", "text": "武器の強化、秘密"}, {"type": "subtitle", "time": 3562.47, "timestamp": "00:59:22", "text": "そして、人々がこの"}, {"type": "subtitle", "time": 3565.43, "timestamp": "00:59:25", "text": "件をより早く解決していることに気づいた。"}, {"type": "subtitle", "time": 3574.47, "timestamp": "00:59:34", "text": "彼女の武器のコピーとして持っていたからだ。 おお、いいね。   マナが"}, {"type": "subtitle", "time": 3578.549, "timestamp": "00:59:38", "text": "多い剣を手に入れましたか"}, {"type": "subtitle", "time": 3581.589, "timestamp": "00:59:41", "text": "？"}, {"type": "subtitle", "time": 3585.19, "timestamp": "00:59:45", "text": "えっと、充電装置。   私が手に入れたのはこれだと"}, {"type": "subtitle", "time": 3593.43, "timestamp": "00:59:53", "text": "あれは彼女の剣だ。"}, {"type": "subtitle", "time": 3596.47, "timestamp": "00:59:56", "text": "ライトセーバーみたいなのは持ってるけど、そう、彼女にあの"}]
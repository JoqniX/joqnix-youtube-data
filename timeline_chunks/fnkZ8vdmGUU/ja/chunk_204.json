[{"type": "subtitle", "time": 12242.389, "timestamp": "03:24:02", "text": "切断されたか"}, {"type": "subtitle", "time": 12252.95, "timestamp": "03:24:12", "text": "ああ、でもそうだね。 ええ、私は何もしていませんし、何か問題があったわけでもありませんし、"}, {"type": "subtitle", "time": 12255.19, "timestamp": "03:24:15", "text": "無効になっているわけでもありません。"}, {"type": "subtitle", "time": 12257.11, "timestamp": "03:24:17", "text": "取り組まなければならない。 直さなきゃいけないことが山ほどある"}, {"type": "subtitle", "time": 12261.99, "timestamp": "03:24:21", "text": "。  Discordの件も直さないといけないな"}, {"type": "subtitle", "time": 12264.63, "timestamp": "03:24:24", "text": "。  Discordはどこにあるの？"}, {"type": "subtitle", "time": 12267.269, "timestamp": "03:24:27", "text": "Discordはどこにあるの？ 不和。 不和。 戻る。"}, {"type": "subtitle", "time": 12269.91, "timestamp": "03:24:29", "text": "Discordに埋め込むYouTube動画を修正する必要がありました。 私は"}, {"type": "subtitle", "time": 12271.83, "timestamp": "03:24:31", "text": "それに気づき、"}, {"type": "subtitle", "time": 12274.71, "timestamp": "03:24:34", "text": "そしてあなたはこれを見たのです。 この"}, {"type": "subtitle", "time": 12279.67, "timestamp": "03:24:39", "text": "スケジュール機能、壊れていることに気づきました。   えっと、"}, {"type": "subtitle", "time": 12282.389, "timestamp": "03:24:42", "text": "ここにキックを追加しないといけないんです。"}, {"type": "subtitle", "time": 12285.269, "timestamp": "03:24:45", "text": "そして、それを直すためのものも。 それと、"}, {"type": "subtitle", "time": 12287.67, "timestamp": "03:24:47", "text": "タイムサーバーの時刻も更新する必要があります"}, {"type": "subtitle", "time": 12291.03, "timestamp": "03:24:51", "text": "。 ああ、"}, {"type": "subtitle", "time": 12293.429, "timestamp": "03:24:53", "text": "コマンドを更新しないといけないことがたくさんある。   ということは、"}]
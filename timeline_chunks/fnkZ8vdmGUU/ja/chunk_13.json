[{"type": "subtitle", "time": 781.829, "timestamp": "00:13:01", "text": "Far Lightをプレイする予定です。   じゃあ"}, {"type": "subtitle", "time": 784.15, "timestamp": "00:13:04", "text": "、明日の朝は「ファーライト」をプレイしよう"}, {"type": "subtitle", "time": 787.75, "timestamp": "00:13:07", "text": "。 はい。"}, {"type": "subtitle", "time": 804.949, "timestamp": "00:13:24", "text": "背景音楽を少しだけ追加できます"}, {"type": "subtitle", "time": 806.71, "timestamp": "00:13:26", "text": "。"}, {"type": "subtitle", "time": 809.03, "timestamp": "00:13:29", "text": "よし、神秘主義者を見せてくれ。 ええ、"}, {"type": "subtitle", "time": 812.31, "timestamp": "00:13:32", "text": "イベント名は「神秘の幻影」です。"}, {"type": "subtitle", "time": 814.47, "timestamp": "00:13:34", "text": "13日まで続きます。   ああ"}, {"type": "subtitle", "time": 817.35, "timestamp": "00:13:37", "text": "、じゃあ頑張らなきゃいけないのか。 ああ、"}, {"type": "subtitle", "time": 820.389, "timestamp": "00:13:40", "text": "明日は月曜日だ。 つまり、リセットは今にも"}, {"type": "subtitle", "time": 823.75, "timestamp": "00:13:43", "text": "起こりそうだ。"}, {"type": "subtitle", "time": 835.269, "timestamp": "00:13:55", "text": "ハロウィンイベントがあるんだ。 ああ、なんてことだ、私はたくさん失敗してしまった"}, {"type": "subtitle", "time": 838.79, "timestamp": "00:13:58", "text": "。"}]
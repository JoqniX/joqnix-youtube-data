[{"type": "subtitle", "time": 7261.109, "timestamp": "02:01:01", "text": "6年間使用した後、壊れてしまいました。"}, {"type": "subtitle", "time": 7267.03, "timestamp": "02:01:07", "text": "GPU 2060と"}, {"type": "subtitle", "time": 7272.07, "timestamp": "02:01:12", "text": "Ryzen 7 3800Xの両方が故障しました。"}, {"type": "subtitle", "time": 7275.75, "timestamp": "02:01:15", "text": "実際、G CPUが故障し、その後"}, {"type": "subtitle", "time": 7285.189, "timestamp": "02:01:25", "text": "でも、OBS の場合は、"}, {"type": "subtitle", "time": 7287.75, "timestamp": "02:01:27", "text": "画像ソース メディアソース"}, {"type": "subtitle", "time": 7290.229, "timestamp": "02:01:30", "text": "プロセッサーの設定を「いいえ」にしておくことをお勧めします。そうすれば、"}, {"type": "subtitle", "time": 7296.79, "timestamp": "02:01:36", "text": "シーンにいないときはバックグラウンド"}, {"type": "subtitle", "time": 7299.75, "timestamp": "02:01:39", "text": "で処理が行われません"}, {"type": "subtitle", "time": 7303.189, "timestamp": "02:01:43", "text": "。 健康に良いので、リソースの使用を減らし、"}, {"type": "subtitle", "time": 7306.07, "timestamp": "02:01:46", "text": "ブラウザのソースなどの使用を減らします"}, {"type": "subtitle", "time": 7309.109, "timestamp": "02:01:49", "text": "。 私の場合は、OBSではなくMel Studioを使用しています"}, {"type": "subtitle", "time": 7312.47, "timestamp": "02:01:52", "text": "。 私は"}, {"type": "subtitle", "time": 7314.709, "timestamp": "02:01:54", "text": "GPU負荷の高いゲームをストリーミング配信するときだけObviousを使います"}, {"type": "subtitle", "time": 7317.75, "timestamp": "02:01:57", "text": "。 つまり、"}, {"type": "subtitle", "time": 7319.75, "timestamp": "02:01:59", "text": "ゲーム画面を"}]
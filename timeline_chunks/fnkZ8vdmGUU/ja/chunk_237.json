[{"type": "subtitle", "time": 14230.95, "timestamp": "03:57:10", "text": "ああ、前回は死んだよ。 つまり、"}, {"type": "subtitle", "time": 14233.51, "timestamp": "03:57:13", "text": "ヒーラーですね。 あ、待って、待って、待って。"}, {"type": "subtitle", "time": 14243.99, "timestamp": "03:57:23", "text": "いいえ、今はヒーラーが必要です。 だから、あなたはできると思う。"}, {"type": "subtitle", "time": 14246.79, "timestamp": "03:57:26", "text": "いや、待って。 彼女も優秀だよ。"}, {"type": "subtitle", "time": 14249.67, "timestamp": "03:57:29", "text": "誰を連れて行けばいいのか分からないよ。"}, {"type": "subtitle", "time": 14255.269, "timestamp": "03:57:35", "text": "ええと、弓を持って行って、"}, {"type": "subtitle", "time": 14257.51, "timestamp": "03:57:37", "text": "これでいいと思いますよ。 いや、君は、うん、"}, {"type": "subtitle", "time": 14279.11, "timestamp": "03:57:59", "text": "。 瞑想。 右。 よし。"}]
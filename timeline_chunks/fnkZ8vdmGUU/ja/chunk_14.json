[{"type": "subtitle", "time": 857.75, "timestamp": "00:14:17", "text": "キャラクター用に250、"}, {"type": "subtitle", "time": 860.87, "timestamp": "00:14:20", "text": "武器スキン用に300を獲得したいです。"}, {"type": "subtitle", "time": 862.629, "timestamp": "00:14:22", "text": "ああ、"}, {"type": "subtitle", "time": 869.509, "timestamp": "00:14:29", "text": "はい、リセットします。 そうそう。 はい、リセットは"}, {"type": "subtitle", "time": 875.59, "timestamp": "00:14:35", "text": "5時間後です。 午前5時30分。忘れてしまった。"}, {"type": "subtitle", "time": 883.59, "timestamp": "00:14:43", "text": "このゲーム、もっと放置プレイが簡単だったらいいのに。 そっちの方が"}, {"type": "subtitle", "time": 886.949, "timestamp": "00:14:46", "text": "ずっと簡単だっただろうに。 ほら、"}, {"type": "subtitle", "time": 890.47, "timestamp": "00:14:50", "text": "このゲームは放置プレイできるんだよ。 そして、"}, {"type": "subtitle", "time": 894.47, "timestamp": "00:14:54", "text": "欲しいものを手に入れるとか、そういうことですよね"}, {"type": "subtitle", "time": 897.43, "timestamp": "00:14:57", "text": "？ あ、待って。 できます。 できると思う。"}]
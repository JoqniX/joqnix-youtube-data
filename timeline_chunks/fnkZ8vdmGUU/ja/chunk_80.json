[{"type": "subtitle", "time": 4803.189, "timestamp": "01:20:03", "text": "これを使えばできるでしょう？   私は"}, {"type": "subtitle", "time": 4805.43, "timestamp": "01:20:05", "text": "ゲームデザインをやりたかったんです"}, {"type": "subtitle", "time": 4808.39, "timestamp": "01:20:08", "text": "。"}, {"type": "subtitle", "time": 4814.47, "timestamp": "01:20:14", "text": "Twitch チャットや YouTube"}, {"type": "subtitle", "time": 4818.47, "timestamp": "01:20:18", "text": "キックチャットで使えるインタラクティブな 3D コンテンツなど、たくさんのアイデアがありました。ライブ配信やコンサートなどで使える、小さくて"}, {"type": "subtitle", "time": 4822.47, "timestamp": "01:20:22", "text": "動かせるオブジェクトやマスコットのようなものです"}, {"type": "subtitle", "time": 4826.95, "timestamp": "01:20:26", "text": "。 このゲームのように、"}, {"type": "subtitle", "time": 4831.91, "timestamp": "01:20:31", "text": "自分のキャラクターをゲーム世界のNPCとして登場させたりできるアイデアがたくさんあるんです"}, {"type": "subtitle", "time": 4838.95, "timestamp": "01:20:38", "text": "。 いいえ、たくさんのアイデアがあったのですが、"}, {"type": "subtitle", "time": 4841.91, "timestamp": "01:20:41", "text": "その後、自分にはできない、やり方がわからないことに気づきました"}, {"type": "subtitle", "time": 4843.83, "timestamp": "01:20:43", "text": "。 私は"}, {"type": "subtitle", "time": 4845.99, "timestamp": "01:20:45", "text": "プログラミングができません。"}, {"type": "subtitle", "time": 4849.35, "timestamp": "01:20:49", "text": "でも私の場合は、むしろそうしようとしたんです"}, {"type": "subtitle", "time": 4851.75, "timestamp": "01:20:51", "text": "。"}, {"type": "subtitle", "time": 4854.87, "timestamp": "01:20:54", "text": "ストリーミングを始めて6年、"}, {"type": "subtitle", "time": 4858.229, "timestamp": "01:20:58", "text": "6時間くらいかな。 だから、"}]
[{"type": "subtitle", "time": 14557.75, "timestamp": "04:02:37", "text": "よし、あれは良かった。"}, {"type": "subtitle", "time": 14561.75, "timestamp": "04:02:41", "text": "本を使わなければならないと思う。"}, {"type": "subtitle", "time": 14564.309, "timestamp": "04:02:44", "text": "私はこうやって行く。 まだ終わっていない"}, {"type": "subtitle", "time": 14566.389, "timestamp": "04:02:46", "text": "。   本は"}, {"type": "subtitle", "time": 14569.322, "timestamp": "04:02:49", "text": "1冊だけです。 大きな本。"}]
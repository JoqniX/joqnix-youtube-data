[{"type": "subtitle", "time": 9422.63, "timestamp": "02:37:02", "text": "？"}, {"type": "subtitle", "time": 9424.71, "timestamp": "02:37:04", "text": "日本人も同様です。 アニメをたくさん見たり"}, {"type": "subtitle", "time": 9427.51, "timestamp": "02:37:07", "text": "、日本の動画をたくさん見たり、"}, {"type": "subtitle", "time": 9430.63, "timestamp": "02:37:10", "text": "YouTuberやTwitchなどの"}, {"type": "subtitle", "time": 9432.95, "timestamp": "02:37:12", "text": "日本の配信者に興味があるなら"}, {"type": "subtitle", "time": 9434.469, "timestamp": "02:37:14", "text": "、今ではそういう風に見ることができます"}, {"type": "subtitle", "time": 9438.95, "timestamp": "02:37:18", "text": "。 メディアの消費は"}, {"type": "subtitle", "time": 9442.309, "timestamp": "02:37:22", "text": "重要である。 そうすれば、徐々に"}, {"type": "subtitle", "time": 9445.67, "timestamp": "02:37:25", "text": "話し方や"}, {"type": "subtitle", "time": 9447.83, "timestamp": "02:37:27", "text": "会話のパターンを身につけていくでしょう。"}, {"type": "subtitle", "time": 9451.03, "timestamp": "02:37:31", "text": "誰かと話したり、会話したりする際に、あなたが探すべきはまさにそういう点です"}, {"type": "subtitle", "time": 9453.51, "timestamp": "02:37:33", "text": "。 パターンを探してみてください。"}, {"type": "subtitle", "time": 9455.91, "timestamp": "02:37:35", "text": "パターンを理解する。 さて、なぜ"}, {"type": "subtitle", "time": 9459.349, "timestamp": "02:37:39", "text": "彼らはこの文章や会話のような場面でこれを使ったのでしょうか"}, {"type": "subtitle", "time": 9462.309, "timestamp": "02:37:42", "text": "？"}, {"type": "subtitle", "time": 9464.389, "timestamp": "02:37:44", "text": "なぜこれがダメなのか？ まあ、そんな感じですね。"}, {"type": "subtitle", "time": 9465.59, "timestamp": "02:37:45", "text": "疑問を持つと、自分自身にも疑問を持ち始める"}, {"type": "subtitle", "time": 9467.51, "timestamp": "02:37:47", "text": "。"}, {"type": "subtitle", "time": 9470.389, "timestamp": "02:37:50", "text": "日本語や言語を学び始めると、「"}, {"type": "subtitle", "time": 9474.23, "timestamp": "02:37:54", "text": "ああ、"}, {"type": "subtitle", "time": 9476.63, "timestamp": "02:37:56", "text": "こういう風に使われるのか」といった明確な理解が得られるようになります。"}, {"type": "subtitle", "time": 9479.91, "timestamp": "02:37:59", "text": "オンラインのシステムは機能すると思います。"}]
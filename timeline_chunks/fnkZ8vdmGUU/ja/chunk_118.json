[{"type": "subtitle", "time": 7082.07, "timestamp": "01:58:02", "text": "デビルメイクライ1をプレイできますように。おお、いいですね。 私は"}, {"type": "subtitle", "time": 7085.91, "timestamp": "01:58:05", "text": "まだデビルメイクライシリーズをプレイしたことがありません。"}, {"type": "subtitle", "time": 7088.87, "timestamp": "01:58:08", "text": "プレイしたいです。"}, {"type": "subtitle", "time": 7095.189, "timestamp": "01:58:15", "text": "プラスチックの椅子とか、ミームとか、いろいろ見てきましたよ（笑）。"}, {"type": "subtitle", "time": 7099.109, "timestamp": "01:58:19", "text": "もう一度プレイしたいし、"}, {"type": "subtitle", "time": 7106.47, "timestamp": "01:58:26", "text": "以前にもプレイしたことがある。 私にはゲームがない。 でも、"}, {"type": "subtitle", "time": 7108.629, "timestamp": "01:58:28", "text": "配信できるゲームがないんです。 でも、"}, {"type": "subtitle", "time": 7112.229, "timestamp": "01:58:32", "text": "無料ゲームはたくさんあるよね。  Steam、"}, {"type": "subtitle", "time": 7114.87, "timestamp": "01:58:34", "text": "Epic、Giで配信中。"}, {"type": "subtitle", "time": 7116.629, "timestamp": "01:58:36", "text": "よし、[笑い] それは私のものだ"}, {"type": "subtitle", "time": 7120.709, "timestamp": "01:58:40", "text": "。 私は自分のためにそれを試してみます"}, {"type": "subtitle", "time": 7123.75, "timestamp": "01:58:43", "text": "。 私は全てを主張するが、"}, {"type": "subtitle", "time": 7126.47, "timestamp": "01:58:46", "text": "それらのどれについてもほとんど祈らない。  [笑い] もはや単なる"}, {"type": "subtitle", "time": 7128.87, "timestamp": "01:58:48", "text": "収集段階ですね"}, {"type": "subtitle", "time": 7132.07, "timestamp": "01:58:52", "text": "。 新しいパソコンを買おうとした。 ああ、"}]
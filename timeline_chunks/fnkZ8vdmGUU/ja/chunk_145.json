[{"type": "subtitle", "time": 8702.15, "timestamp": "02:25:02", "text": "えっと、どれくらい配信してるんだろう？ ああ、"}, {"type": "subtitle", "time": 8703.99, "timestamp": "02:25:03", "text": "配信を終了して再接続する必要があったんですよね"}, {"type": "subtitle", "time": 8726.07, "timestamp": "02:25:26", "text": "殺さないで。 私の取り分を食べさせてくれ。"}, {"type": "subtitle", "time": 8728.15, "timestamp": "02:25:28", "text": "それと、配信時間も確認させてください"}, {"type": "subtitle", "time": 8747.83, "timestamp": "02:25:47", "text": "あ、待って。 追い出されたばかりだ。"}, {"type": "subtitle", "time": 8750.95, "timestamp": "02:25:50", "text": "ヴェラ、ヴェリカ、生きているの？ よし、彼女は"}]
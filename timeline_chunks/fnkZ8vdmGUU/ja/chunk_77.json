[{"type": "subtitle", "time": 4621.669, "timestamp": "01:17:01", "text": "IGNUとかやってるから、それを取ったんだ"}, {"type": "subtitle", "time": 4626.55, "timestamp": "01:17:06", "text": "。 えっと、遠隔学習のことです。"}, {"type": "subtitle", "time": 4629.83, "timestamp": "01:17:09", "text": "だから実際は、"}, {"type": "subtitle", "time": 4636.39, "timestamp": "01:17:16", "text": "自分の犬に関する物語や、自分が持って"}, {"type": "subtitle", "time": 4639.99, "timestamp": "01:17:19", "text": "いる他のキャラクターについての物語を書くことができるから、この仕事を引き受けただけなんです。"}, {"type": "subtitle", "time": 4644.63, "timestamp": "01:17:24", "text": "でも、勉強している気がしないんです。  [笑い]"}, {"type": "subtitle", "time": 4648.47, "timestamp": "01:17:28", "text": "無駄にしたと思う。だって、"}, {"type": "subtitle", "time": 4652.709, "timestamp": "01:17:32", "text": "そんなことする気にならないから。 えっと、私は今"}, {"type": "subtitle", "time": 4655.99, "timestamp": "01:17:35", "text": "30歳くらいです。 でも、"}, {"type": "subtitle", "time": 4659.59, "timestamp": "01:17:39", "text": "私は全く勉強していないんです。 私の"}, {"type": "subtitle", "time": 4662.31, "timestamp": "01:17:42", "text": "やる気は消え失せた。 私、"}, {"type": "subtitle", "time": 4665.51, "timestamp": "01:17:45", "text": "音楽の学位を取れたかもしれないのに。 なぜ私は"}, {"type": "subtitle", "time": 4671.27, "timestamp": "01:17:51", "text": "私も真面目すぎた。 しかしその後、"}, {"type": "subtitle", "time": 4675.35, "timestamp": "01:17:55", "text": "教授は私の同僚であり英語の先生でした。"}, {"type": "subtitle", "time": 4677.51, "timestamp": "01:17:57", "text": "ああ、そうだね。"}, {"type": "subtitle", "time": 4679.83, "timestamp": "01:17:59", "text": "はい。 はい。 はい。 はい。"}]
[{"type": "subtitle", "time": 6840.229, "timestamp": "01:54:00", "text": "辞めた後、"}, {"type": "subtitle", "time": 6843.03, "timestamp": "01:54:03", "text": "私の人生には暗い時期がありました。 だから私は悪い方向に落ちていった。"}, {"type": "subtitle", "time": 6846.709, "timestamp": "01:54:06", "text": "プロとしてDotaをプレイすることは"}, {"type": "subtitle", "time": 6849.669, "timestamp": "01:54:09", "text": "プッシュゲーマーだ。"}, {"type": "subtitle", "time": 6853.109, "timestamp": "01:54:13", "text": "私もそうしたかった。"}, {"type": "subtitle", "time": 6854.87, "timestamp": "01:54:14", "text": "当時、私はフォートナイトをプレイしていました。 だから"}, {"type": "subtitle", "time": 6858.31, "timestamp": "01:54:18", "text": "私はゲーマーになりたいと思ったんです。"}, {"type": "subtitle", "time": 6861.43, "timestamp": "01:54:21", "text": "お金を稼いで、両親にちゃんと仕事をしているとか、何か仕事があるって言いたいんです"}, {"type": "subtitle", "time": 6866.95, "timestamp": "01:54:26", "text": "。 ゲームをするだけで"}, {"type": "subtitle", "time": 6870.07, "timestamp": "01:54:30", "text": "お金が稼げるし（笑）。"}, {"type": "subtitle", "time": 6877.43, "timestamp": "01:54:37", "text": "[笑い] でもそれはうまくいかなかった。 ああ、"}, {"type": "subtitle", "time": 6890.87, "timestamp": "01:54:50", "text": "大学に通いながら4年間で2000ドルしか稼げなかったのは、割に合わなかった。"}]
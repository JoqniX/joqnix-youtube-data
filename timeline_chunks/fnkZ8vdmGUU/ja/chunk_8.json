[{"type": "subtitle", "time": 483.749, "timestamp": "00:08:03", "text": "か5回するとか、ログイン報酬などのデイリーチャレンジをこなすと、"}, {"type": "subtitle", "time": 492.15, "timestamp": "00:08:12", "text": "それらの3つのチャレンジから最大30個か50個のボックスを獲得できます。  30歳くらいになれば分かるよ"}, {"type": "subtitle", "time": 494.71, "timestamp": "00:08:14", "text": "。 うん。  30箱。"}, {"type": "subtitle", "time": 498.07, "timestamp": "00:08:18", "text": "3つのチャレンジから30ポイント獲得できます"}, {"type": "subtitle", "time": 500.07, "timestamp": "00:08:20", "text": "。  3つか4つの課題。"}, {"type": "subtitle", "time": 502.79, "timestamp": "00:08:22", "text": "それから100は、宝"}, {"type": "subtitle", "time": 505.749, "timestamp": "00:08:25", "text": "箱を開けたりして見つけなければなりません。 ゲームを起動するたびに、それを入手してください"}, {"type": "subtitle", "time": 508.07, "timestamp": "00:08:28", "text": "。"}, {"type": "subtitle", "time": 510.95, "timestamp": "00:08:30", "text": "全ての宝箱を開けて、そのようにしてアイテムを収集してみてください"}, {"type": "subtitle", "time": 512.87, "timestamp": "00:08:32", "text": "。   以前はそうしていたんだけど、"}, {"type": "subtitle", "time": 516.7090000000001, "timestamp": "00:08:36", "text": "今はあの、左右の"}, {"type": "subtitle", "time": 523.029, "timestamp": "00:08:43", "text": "目の色が違う中国人の女の子の新しいシーズンだよね？"}, {"type": "subtitle", "time": 525.43, "timestamp": "00:08:45", "text": "彼らは"}, {"type": "subtitle", "time": 529.35, "timestamp": "00:08:49", "text": "イベントショップでその箱を作り、"}, {"type": "subtitle", "time": 536.23, "timestamp": "00:08:56", "text": "その女の子のために最大300ドルで作った。 つまり、イベントショップで"}, {"type": "subtitle", "time": 539.509, "timestamp": "00:08:59", "text": "このキャラクターとスキンを簡単に入手できるということです"}]
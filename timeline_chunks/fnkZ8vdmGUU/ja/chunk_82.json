[{"type": "subtitle", "time": 4921.11, "timestamp": "01:22:01", "text": "あらゆる友人グループの間で短編映画が流行っていたような気がします。友達やクラスメートが"}, {"type": "subtitle", "time": 4941.11, "timestamp": "01:22:21", "text": "笑顔で成功している時、挑戦的な存在にならないように心がけています。"}, {"type": "subtitle", "time": 4960.149, "timestamp": "01:22:40", "text": "私がそこへ行った理由は、スポーツにはそういう"}, {"type": "subtitle", "time": 4967.91, "timestamp": "01:22:47", "text": "考えがあるからです。 なるほど、"}, {"type": "subtitle", "time": 4970.149, "timestamp": "01:22:50", "text": "神は一枚の印刷された"}, {"type": "subtitle", "time": 4971.669, "timestamp": "01:22:51", "text": "紙切れによって生まれたという記事を読んだんです。  [笑い] 昔はよくそう"}, {"type": "subtitle", "time": 4975.669, "timestamp": "01:22:55", "text": "言ってたよ。 一枚の"}, {"type": "subtitle", "time": 4978.39, "timestamp": "01:22:58", "text": "紙切れが私の人生や物事を判断するわけではない。 そして"}]
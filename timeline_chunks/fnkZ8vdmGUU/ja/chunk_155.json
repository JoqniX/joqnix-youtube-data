[{"type": "subtitle", "time": 9305.19, "timestamp": "02:35:05", "text": "誰もが"}, {"type": "subtitle", "time": 9307.99, "timestamp": "02:35:07", "text": "常にひらがなとカタカナを使うわけではありません。 ほとんどの人は"}, {"type": "subtitle", "time": 9311.03, "timestamp": "02:35:11", "text": "漢字を好む。 漢字は日常の"}, {"type": "subtitle", "time": 9314.55, "timestamp": "02:35:14", "text": "日本語でも必要です。なぜなら、"}, {"type": "subtitle", "time": 9316.469, "timestamp": "02:35:16", "text": "お店に行ったり、物や食べ物を"}, {"type": "subtitle", "time": 9318.79, "timestamp": "02:35:18", "text": "買ったりするとき、あらゆるものに"}, {"type": "subtitle", "time": 9324.79, "timestamp": "02:35:24", "text": "何らかの基本的な漢字が使われているからです。 だから漢字はある意味重要で、"}, {"type": "subtitle", "time": 9327.91, "timestamp": "02:35:27", "text": "人々が"}, {"type": "subtitle", "time": 9330.469, "timestamp": "02:35:30", "text": "日常的に使わない漢字がたくさんあって、"}, {"type": "subtitle", "time": 9333.91, "timestamp": "02:35:33", "text": "教科書みたいなものが多い。"}, {"type": "subtitle", "time": 9343.99, "timestamp": "02:35:43", "text": "私は"}, {"type": "subtitle", "time": 9350.389, "timestamp": "02:35:50", "text": "N4で100字以上の漢字を3つくらい覚えなきゃいけないと思うけど、"}]
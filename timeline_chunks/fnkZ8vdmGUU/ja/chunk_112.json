[{"type": "subtitle", "time": 6722.149, "timestamp": "01:52:02", "text": "そういうのが好きで、昔は「W World"}, {"type": "subtitle", "time": 6727.109, "timestamp": "01:52:07", "text": "of Dance」とか「WDC」とかいう番組を見てたんだ。   あるいは、そんな感じ"}, {"type": "subtitle", "time": 6728.39, "timestamp": "01:52:08", "text": "。"}, {"type": "subtitle", "time": 6731.109, "timestamp": "01:52:11", "text": "私はジャボキとか"}, {"type": "subtitle", "time": 6733.43, "timestamp": "01:52:13", "text": "そういうものが大好きだったんです。 私は「私も"}, {"type": "subtitle", "time": 6737.91, "timestamp": "01:52:17", "text": "彼らみたいになりたい」と思った。 ブレイクダンスとかを習ったよ。 以前は"}, {"type": "subtitle", "time": 6741.83, "timestamp": "01:52:21", "text": "開脚のやり方に関するチュートリアルを見て、"}, {"type": "subtitle", "time": 6745.43, "timestamp": "01:52:25", "text": "開脚ができるように脚を鍛えたりしていました。"}, {"type": "subtitle", "time": 6748.87, "timestamp": "01:52:28", "text": "逆立ちとか、"}, {"type": "subtitle", "time": 6751.27, "timestamp": "01:52:31", "text": "ヘリコプターとか、そういう"}, {"type": "subtitle", "time": 6759.35, "timestamp": "01:52:39", "text": "そして、腕を骨折した。 知っている。 一度、肘か何かをぶつけたことがある"}, {"type": "subtitle", "time": 6761.51, "timestamp": "01:52:41", "text": "。 いいえ、脚です。 ええ、"}, {"type": "subtitle", "time": 6764.07, "timestamp": "01:52:44", "text": "足を骨折しました。 足首を捻挫したか"}, {"type": "chat", "time": 6764.733, "timestamp": "01:52:44", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "I am still into dancing dude i have 5 to 6 kpop songs choreo remembered"}, {"type": "subtitle", "time": 6768.39, "timestamp": "01:52:48", "text": "何かしたんだ。 それをやめなければならなかった。 そして"}, {"type": "subtitle", "time": 6771.51, "timestamp": "01:52:51", "text": "私は興味を失った。   たぶん、その頃は"}, {"type": "subtitle", "time": 6773.669, "timestamp": "01:52:53", "text": "ストリーミング配信とか"}, {"type": "subtitle", "time": 6778.39, "timestamp": "01:52:58", "text": "Twitchとかやってると思う。"}]
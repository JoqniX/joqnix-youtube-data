[{"type": "subtitle", "time": 9604.55, "timestamp": "02:40:04", "text": "N4の勉強には、Genkiの教科書を使っています。"}, {"type": "subtitle", "time": 9616.389, "timestamp": "02:40:16", "text": "それが、私の先生が私に教える際に使っている方法です"}, {"type": "subtitle", "time": 9627.11, "timestamp": "02:40:27", "text": "うん。 えっと、もし試験を受けたいなら"}, {"type": "subtitle", "time": 9630.07, "timestamp": "02:40:30", "text": "、"}, {"type": "subtitle", "time": 9631.83, "timestamp": "02:40:31", "text": "NATを受けることをお勧めします。"}, {"type": "subtitle", "time": 9634.87, "timestamp": "02:40:34", "text": "NATは、日本語"}, {"type": "subtitle", "time": 9637.99, "timestamp": "02:40:37", "text": "能力試験であるJPTに似ています。"}, {"type": "subtitle", "time": 9643.349, "timestamp": "02:40:43", "text": "JPTは7月と12月に開催されます。"}, {"type": "subtitle", "time": 9651.91, "timestamp": "02:40:51", "text": "日付は変更になりますが、まあ。 試験は"}, {"type": "subtitle", "time": 9655.67, "timestamp": "02:40:55", "text": "年に2回しか行われません。 一方、NAT"}, {"type": "subtitle", "time": 9657.27, "timestamp": "02:40:57", "text": "試験は"}, {"type": "subtitle", "time": 9659.349, "timestamp": "02:40:59", "text": "毎月または2ヶ月ごとに実施されます"}]
[{"type": "subtitle", "time": 6182.07, "timestamp": "01:43:02", "text": "You know, I there was this one time cuz"}, {"type": "subtitle", "time": 6184.47, "timestamp": "01:43:04", "text": "I like"}, {"type": "subtitle", "time": 6187.83, "timestamp": "01:43:07", "text": "cuz I like Spider-Man stuff and when I"}, {"type": "subtitle", "time": 6190.629, "timestamp": "01:43:10", "text": "was growing up and stuff, I"}, {"type": "subtitle", "time": 6193.75, "timestamp": "01:43:13", "text": ">> I was like, \"Okay, if I"}, {"type": "subtitle", "time": 6197.27, "timestamp": "01:43:17", "text": "make a pet spider, I can be Spider-Man.\""}, {"type": "subtitle", "time": 6201.601, "timestamp": "01:43:21", "text": "That's what I believed. I used to"}, {"type": "subtitle", "time": 6202.149, "timestamp": "01:43:22", "text": "[laughter]"}, {"type": "subtitle", "time": 6205.51, "timestamp": "01:43:25", "text": "take spiders and let it on my hand so I"}, {"type": "subtitle", "time": 6207.496, "timestamp": "01:43:27", "text": "can get the spider bite. So I was"}, {"type": "subtitle", "time": 6209.83, "timestamp": "01:43:29", "text": "[gasps] like, I can be Spider-Man. I can"}, {"type": "subtitle", "time": 6212.709, "timestamp": "01:43:32", "text": "have superpowers and stuff."}, {"type": "subtitle", "time": 6216.87, "timestamp": "01:43:36", "text": "Then later on, I realized that's bad."}, {"type": "subtitle", "time": 6221.43, "timestamp": "01:43:41", "text": "Thankfully, I did not get a spider bite."}, {"type": "subtitle", "time": 6224.31, "timestamp": "01:43:44", "text": "Oh my god, it's been so long. Thinking"}, {"type": "subtitle", "time": 6228.149, "timestamp": "01:43:48", "text": "about my childhood stuff made me feel"}, {"type": "subtitle", "time": 6231.99, "timestamp": "01:43:51", "text": "nostalgic. Oh my god,"}, {"type": "subtitle", "time": 6234.352, "timestamp": "01:43:54", "text": "I used to do so much weird things."}]
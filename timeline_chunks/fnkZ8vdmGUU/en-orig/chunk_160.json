[{"type": "subtitle", "time": 9604.55, "timestamp": "02:40:04", "text": "For N4, I'm learning Genki textbook."}, {"type": "subtitle", "time": 9616.389, "timestamp": "02:40:16", "text": "That's what my sensei is using to teach"}, {"type": "subtitle", "time": 9627.11, "timestamp": "02:40:27", "text": "Yeah. Um, if you're wanting to take an"}, {"type": "subtitle", "time": 9630.07, "timestamp": "02:40:30", "text": "examination, I would pref tell you to go"}, {"type": "subtitle", "time": 9631.83, "timestamp": "02:40:31", "text": "with NAT."}, {"type": "subtitle", "time": 9634.87, "timestamp": "02:40:34", "text": "NAT is like similar to JPT, Japanese"}, {"type": "subtitle", "time": 9637.99, "timestamp": "02:40:37", "text": "language proficiency test."}, {"type": "subtitle", "time": 9643.349, "timestamp": "02:40:43", "text": "Uh JPT happens on July and December."}, {"type": "subtitle", "time": 9651.91, "timestamp": "02:40:51", "text": ">> The date changes but yeah. Uh the exam"}, {"type": "subtitle", "time": 9655.67, "timestamp": "02:40:55", "text": "only happens twice a year. Meanwhile NAT"}, {"type": "subtitle", "time": 9657.27, "timestamp": "02:40:57", "text": "exam"}, {"type": "subtitle", "time": 9659.349, "timestamp": "02:40:59", "text": "it happens every month or every two"}]
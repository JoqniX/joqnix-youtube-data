[{"type": "subtitle", "time": 9793.59, "timestamp": "02:43:13", "text": "呃，我倒着走了。 是的，关卡可以倒着"}, {"type": "subtitle", "time": 9795.19, "timestamp": "02:43:15", "text": "过，有些情况下还可以跳过"}, {"type": "subtitle", "time": 9801.27, "timestamp": "02:43:21", "text": "，是的。 对于日本来说，如果你要去"}, {"type": "subtitle", "time": 9804.79, "timestamp": "02:43:24", "text": "日本工作，至少需要N2水平，"}, {"type": "subtitle", "time": 9810.15, "timestamp": "02:43:30", "text": "N4或N3也可以，"}, {"type": "subtitle", "time": 9812.79, "timestamp": "02:43:32", "text": "但主要看重的是流利度，看你能不能用日语进行"}, {"type": "subtitle", "time": 9816.55, "timestamp": "02:43:36", "text": "日常交流和各种"}, {"type": "subtitle", "time": 9819.27, "timestamp": "02:43:39", "text": "对话。"}, {"type": "subtitle", "time": 9820.95, "timestamp": "02:43:40", "text": "但真正的商务工作"}, {"type": "subtitle", "time": 9823.91, "timestamp": "02:43:43", "text": "至少需要N2水平，没有最低"}, {"type": "subtitle", "time": 9826.79, "timestamp": "02:43:46", "text": "要求，"}, {"type": "subtitle", "time": 9830.23, "timestamp": "02:43:50", "text": "N2是必须的。   我也跟"}]
[{"type": "subtitle", "time": 7682.79, "timestamp": "02:08:02", "text": "Jock 的建议。 我提出的一个"}, {"type": "subtitle", "time": 7685.43, "timestamp": "02:08:05", "text": "功能需求，他们真的添加了。 对于"}, {"type": "subtitle", "time": 7687.589, "timestamp": "02:08:07", "text": "像我这样拥有上千个"}, {"type": "subtitle", "time": 7691.669, "timestamp": "02:08:11", "text": "资源和 500 个场景等等的人来说，我们"}, {"type": "subtitle", "time": 7695.109, "timestamp": "02:08:15", "text": "需要一些东西，所以我要求添加一个"}, {"type": "subtitle", "time": 7697.03, "timestamp": "02:08:17", "text": "前缀。 我没有"}, {"type": "subtitle", "time": 7699.99, "timestamp": "02:08:19", "text": "安装这个插件，但它更像是会"}, {"type": "subtitle", "time": 7704.79, "timestamp": "02:08:24", "text": "复制你的源设置，"}, {"type": "subtitle", "time": 7711.669, "timestamp": "02:08:31", "text": "并且会让所有新的"}, {"type": "subtitle", "time": 7715.43, "timestamp": "02:08:35", "text": "子源都镜像相同的"}, {"type": "subtitle", "time": 7717.35, "timestamp": "02:08:37", "text": "内容。 所以，你在这里对这些"}, {"type": "subtitle", "time": 7719.99, "timestamp": "02:08:39", "text": "设置所做的任何操作，都会反映在"}, {"type": "subtitle", "time": 7722.95, "timestamp": "02:08:42", "text": "更新的源类型以及所有内容上。 我"}, {"type": "subtitle", "time": 7725.148, "timestamp": "02:08:45", "text": "太较真了。 生与死。"}, {"type": "subtitle", "time": 7726.39, "timestamp": "02:08:46", "text": "[笑声] 不过，如果你对显而易见的事情有任何"}, {"type": "subtitle", "time": 7728.149, "timestamp": "02:08:48", "text": "疑问，请随时问"}, {"type": "subtitle", "time": 7730.95, "timestamp": "02:08:50", "text": "我。 如果需要，我可以帮你。"}, {"type": "subtitle", "time": 7735.03, "timestamp": "02:08:55", "text": "我不介意。 嗯，但我建议"}, {"type": "subtitle", "time": 7737.589, "timestamp": "02:08:57", "text": "凡事都要有所节制。 如果你的电脑运行"}]
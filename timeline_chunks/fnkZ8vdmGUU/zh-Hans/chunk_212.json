[{"type": "subtitle", "time": 12725.19, "timestamp": "03:32:05", "text": "是的，我是恐鸟。 我不小心把东西倒多了"}, {"type": "subtitle", "time": 12743.269, "timestamp": "03:32:23", "text": "说到咖啡之类的东西，是啊，"}, {"type": "subtitle", "time": 12746.469, "timestamp": "03:32:26", "text": "今天我爸说"}, {"type": "subtitle", "time": 12751.11, "timestamp": "03:32:31", "text": "我得学学怎么做饭"}, {"type": "subtitle", "time": 12753.19, "timestamp": "03:32:33", "text": "什么的，对吧？ 一旦我到了日本，"}, {"type": "subtitle", "time": 12758.87, "timestamp": "03:32:38", "text": "我就无可救药了。  [笑声]"}, {"type": "subtitle", "time": 12761.11, "timestamp": "03:32:41", "text": "我得学着做饭什么的"}, {"type": "subtitle", "time": 12768.229, "timestamp": "03:32:48", "text": "但我会想：哦，那可就糟了。 我"}, {"type": "subtitle", "time": 12771.51, "timestamp": "03:32:51", "text": "活不下去了。"}, {"type": "subtitle", "time": 12774.07, "timestamp": "03:32:54", "text": "所以，他告诉我一定要保持冷静"}]
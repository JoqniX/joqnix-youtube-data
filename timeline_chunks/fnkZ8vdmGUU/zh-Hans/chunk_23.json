[{"type": "subtitle", "time": 1381.43, "timestamp": "00:23:01", "text": "，而是感觉游戏好像在"}, {"type": "subtitle", "time": 1384.23, "timestamp": "00:23:04", "text": "阻止我杀人"}, {"type": "subtitle", "time": 1386.31, "timestamp": "00:23:06", "text": "。"}, {"type": "subtitle", "time": 1389.029, "timestamp": "00:23:09", "text": "嗯。"}, {"type": "subtitle", "time": 1392.23, "timestamp": "00:23:12", "text": "你们那边卡住了，对吧？"}, {"type": "subtitle", "time": 1394.23, "timestamp": "00:23:14", "text": "你们那边整个屏幕都卡住了，"}, {"type": "subtitle", "time": 1396.87, "timestamp": "00:23:16", "text": "对吧？ 有时候我的声音会有点"}, {"type": "subtitle", "time": 1400.23, "timestamp": "00:23:20", "text": "沙哑，对吧？ 圣。"}, {"type": "subtitle", "time": 1403.27, "timestamp": "00:23:23", "text": "我觉得《远航84》不太适合"}, {"type": "subtitle", "time": 1407.99, "timestamp": "00:23:27", "text": "我边玩其他游戏边做其他事。"}, {"type": "subtitle", "time": 1432.07, "timestamp": "00:23:52", "text": "啊，卡得厉害。 我觉得"}, {"type": "subtitle", "time": 1434.07, "timestamp": "00:23:54", "text": "我不应该冒险。 我觉得我"}, {"type": "subtitle", "time": 1436.23, "timestamp": "00:23:56", "text": "不应该冒险。"}, {"type": "subtitle", "time": 1438.39, "timestamp": "00:23:58", "text": "你知道吗？ 我先退出一下，因为"}]
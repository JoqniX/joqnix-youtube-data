[{"type": "subtitle", "time": 6840.229, "timestamp": "01:54:00", "text": "自己辞职后，我经历了一段黑暗时期"}, {"type": "subtitle", "time": 6843.03, "timestamp": "01:54:03", "text": "。 所以我陷入了困境，就像"}, {"type": "subtitle", "time": 6846.709, "timestamp": "01:54:06", "text": "职业Dota"}, {"type": "subtitle", "time": 6849.669, "timestamp": "01:54:09", "text": "玩家一样。"}, {"type": "subtitle", "time": 6853.109, "timestamp": "01:54:13", "text": "我也想那样做。"}, {"type": "subtitle", "time": 6854.87, "timestamp": "01:54:14", "text": "那时我在玩堡垒之夜。 所以"}, {"type": "subtitle", "time": 6858.31, "timestamp": "01:54:18", "text": "我就想，我想成为一名游戏玩家。 我"}, {"type": "subtitle", "time": 6861.43, "timestamp": "01:54:21", "text": "想赚钱，然后告诉我的父母"}, {"type": "subtitle", "time": 6864.47, "timestamp": "01:54:24", "text": "我真的有工作了"}, {"type": "subtitle", "time": 6866.95, "timestamp": "01:54:26", "text": "。 我只要玩游戏就能"}, {"type": "subtitle", "time": 6870.07, "timestamp": "01:54:30", "text": "赚钱什么的[笑]。"}, {"type": "subtitle", "time": 6877.43, "timestamp": "01:54:37", "text": "（笑）但那从来行不通。 哦，"}, {"type": "subtitle", "time": 6886.31, "timestamp": "01:54:46", "text": "四年内只赚了 2000 美元，还要兼顾大学"}, {"type": "subtitle", "time": 6890.87, "timestamp": "01:54:50", "text": "学业，这不值得。"}]
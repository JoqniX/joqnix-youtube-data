[{"type": "subtitle", "time": 9181.91, "timestamp": "02:33:01", "text": "我真的很想在学完日语之后学习汉语普通话，"}, {"type": "subtitle", "time": 9188.63, "timestamp": "02:33:08", "text": "因为"}, {"type": "subtitle", "time": 9191.19, "timestamp": "02:33:11", "text": "我觉得只有汉语我才"}, {"type": "subtitle", "time": 9194.309, "timestamp": "02:33:14", "text": "需要真正努力学习才能说得像"}, {"type": "subtitle", "time": 9195.99, "timestamp": "02:33:15", "text": "日语一样流利。我能听懂日语，也能理解一些听力方面的问题，"}, {"type": "subtitle", "time": 9199.19, "timestamp": "02:33:19", "text": "但是"}, {"type": "subtitle", "time": 9201.429, "timestamp": "02:33:21", "text": "汉语，因为我以前在Billy Billy上直播过，"}, {"type": "subtitle", "time": 9207.11, "timestamp": "02:33:27", "text": "我想和他们正常地交流，而且"}, {"type": "subtitle", "time": 9211.03, "timestamp": "02:33:31", "text": "并不是每个"}, {"type": "subtitle", "time": 9214.79, "timestamp": "02:33:34", "text": "中国人都会说英语。 所以"}, {"type": "subtitle", "time": 9231.75, "timestamp": "02:33:51", "text": "读过日本轻小说的"}, {"type": "subtitle", "time": 9234.469, "timestamp": "02:33:54", "text": "起源故事，我听说了文字游戏"}, {"type": "subtitle", "time": 9237.11, "timestamp": "02:33:57", "text": "等等。 哦，是的，我"}]
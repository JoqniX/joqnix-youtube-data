[{"type": "subtitle", "time": 661.43, "timestamp": "00:11:01", "text": "你有好处。 好的。 好的。 好的。"}, {"type": "subtitle", "time": 665.11, "timestamp": "00:11:05", "text": "真好。"}, {"type": "subtitle", "time": 670.87, "timestamp": "00:11:10", "text": "好的。 呃，请稍等片刻。"}, {"type": "subtitle", "time": 673.59, "timestamp": "00:11:13", "text": "我们说话的时候，我不小心把墙打开了"}, {"type": "subtitle", "time": 677.03, "timestamp": "00:11:17", "text": "。"}, {"type": "subtitle", "time": 679.829, "timestamp": "00:11:19", "text": "你知道，其中一些禁令带有顶级货架。   是的"}, {"type": "subtitle", "time": 681.91, "timestamp": "00:11:21", "text": "。 我的意思是，《远方之光》这款"}, {"type": "subtitle", "time": 685.11, "timestamp": "00:11:25", "text": "游戏更容易"}, {"type": "subtitle", "time": 687.829, "timestamp": "00:11:27", "text": "获得等级之类的东西。 我想这就是"}, {"type": "subtitle", "time": 691.91, "timestamp": "00:11:31", "text": "我选择在"}, {"type": "subtitle", "time": 694.55, "timestamp": "00:11:34", "text": "这款游戏中进行排位赛的原因。 否则我"}, {"type": "subtitle", "time": 697.03, "timestamp": "00:11:37", "text": "宁愿去Apex英雄里冲段位什么的"}, {"type": "subtitle", "time": 699.19, "timestamp": "00:11:39", "text": "。 那岂不是更难吗"}, {"type": "subtitle", "time": 704.31, "timestamp": "00:11:44", "text": "？ 比如 Valerant、Apex 之类的游戏。"}, {"type": "subtitle", "time": 706.71, "timestamp": "00:11:46", "text": "它是印度爆炸事件吗？ 我记得我曾经进过前"}, {"type": "subtitle", "time": 711.91, "timestamp": "00:11:51", "text": "60名。 我不知道。"}, {"type": "subtitle", "time": 715.43, "timestamp": "00:11:55", "text": "我不太确定了。"}, {"type": "subtitle", "time": 717.91, "timestamp": "00:11:57", "text": "我已经停止努力奋斗了。 我停止了"}]
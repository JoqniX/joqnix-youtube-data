[{"type": "subtitle", "time": 781.829, "timestamp": "00:13:01", "text": "我想明天早上我们就会玩《远光》了。"}, {"type": "subtitle", "time": 784.15, "timestamp": "00:13:04", "text": "所以，是的，我们可以早上玩《远光》了"}, {"type": "subtitle", "time": 787.75, "timestamp": "00:13:07", "text": "。 是的。"}, {"type": "subtitle", "time": 804.949, "timestamp": "00:13:24", "text": "我可以稍微调高一点背景音乐"}, {"type": "subtitle", "time": 806.71, "timestamp": "00:13:26", "text": "。"}, {"type": "subtitle", "time": 809.03, "timestamp": "00:13:29", "text": "好的，让我看看这位神秘人物。 是的，"}, {"type": "subtitle", "time": 812.31, "timestamp": "00:13:32", "text": "活动名称是神秘幻象。 活动持续"}, {"type": "subtitle", "time": 814.47, "timestamp": "00:13:34", "text": "到13号。"}, {"type": "subtitle", "time": 817.35, "timestamp": "00:13:37", "text": "天哪，看来我得努力奋斗了。 我的天哪，"}, {"type": "subtitle", "time": 820.389, "timestamp": "00:13:40", "text": "明天就是星期一了。 所以重置随时可能"}, {"type": "subtitle", "time": 823.75, "timestamp": "00:13:43", "text": "发生。"}, {"type": "subtitle", "time": 835.269, "timestamp": "00:13:55", "text": "他们居然有万圣节活动。 我的天哪，"}, {"type": "subtitle", "time": 838.79, "timestamp": "00:13:58", "text": "我好想念我，我犯了很多错。"}]
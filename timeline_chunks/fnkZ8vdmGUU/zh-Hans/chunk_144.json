[{"type": "subtitle", "time": 8645.19, "timestamp": "02:24:05", "text": "我在说话呢。 您好，感谢您加入"}, {"type": "subtitle", "time": 8659.11, "timestamp": "02:24:19", "text": "我的茶。"}, {"type": "subtitle", "time": 8666.71, "timestamp": "02:24:26", "text": "哦，等等。 我吃了一份炸肉排。 我忘了"}, {"type": "subtitle", "time": 8669.11, "timestamp": "02:24:29", "text": "吃它。 我的天哪，我忘了。 等等，让"}, {"type": "subtitle", "time": 8671.27, "timestamp": "02:24:31", "text": "我先把它吃掉。"}, {"type": "subtitle", "time": 8674.87, "timestamp": "02:24:34", "text": "我的天哪，我忘了吃它。"}, {"type": "subtitle", "time": 8685.19, "timestamp": "02:24:45", "text": "渴。  [笑声]"}, {"type": "subtitle", "time": 8687.83, "timestamp": "02:24:47", "text": "哦，我们终于拿到我们一直想要的物品了"}, {"type": "subtitle", "time": 8690.63, "timestamp": "02:24:50", "text": "。 集中注意力，对吧？ 不，等等。 不是"}, {"type": "subtitle", "time": 8692.469, "timestamp": "02:24:52", "text": "那个。"}, {"type": "subtitle", "time": 8695.429, "timestamp": "02:24:55", "text": "我没能得到我一直努力想要的那些东西"}]
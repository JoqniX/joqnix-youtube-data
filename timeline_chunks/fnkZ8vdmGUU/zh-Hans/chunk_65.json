[{"type": "subtitle", "time": 3916.069, "timestamp": "01:05:16", "text": "它不是一款需要大量使用信用卡的"}, {"type": "subtitle", "time": 3938.23, "timestamp": "01:05:38", "text": "我特别想要"}, {"type": "subtitle", "time": 3940.71, "timestamp": "01:05:40", "text": "55级"}, {"type": "subtitle", "time": 3943.829, "timestamp": "01:05:43", "text": "试炼等级55的装备。如果你试炼等级达到55级，"}, {"type": "subtitle", "time": 3946.47, "timestamp": "01:05:46", "text": "你就可以获得一把恶魔楔形武器，用于"}, {"type": "subtitle", "time": 3950.39, "timestamp": "01:05:50", "text": "长柄武器。 有一种方法可以让你"}, {"type": "subtitle", "time": 3954.789, "timestamp": "01:05:54", "text": "更快地完成委托。"}, {"type": "subtitle", "time": 3957.67, "timestamp": "01:05:57", "text": "所以，我的长柄武器现在正在发射这三把"}]
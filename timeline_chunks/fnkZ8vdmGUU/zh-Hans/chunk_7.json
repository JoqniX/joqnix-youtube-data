[{"type": "subtitle", "time": 422.55, "timestamp": "00:07:02", "text": "该事件将持续到下一个补丁为止。"}, {"type": "subtitle", "time": 425.35, "timestamp": "00:07:05", "text": "呃，下一个补丁什么时候发布？ 我不"}, {"type": "subtitle", "time": 429.51, "timestamp": "00:07:09", "text": "知道。 那个活动好像会持续到"}, {"type": "subtitle", "time": 433.589, "timestamp": "00:07:13", "text": "11月10号左右。 我不确定要"}, {"type": "subtitle", "time": 436.71, "timestamp": "00:07:16", "text": "多久。 我甚至还没登录过"}, {"type": "subtitle", "time": 438.71, "timestamp": "00:07:18", "text": "Farlight。"}, {"type": "subtitle", "time": 441.749, "timestamp": "00:07:21", "text": "我甚至还没登录过Farlight。"}, {"type": "subtitle", "time": 443.99, "timestamp": "00:07:23", "text": "我一直想玩这个游戏。 你知道吗，"}, {"type": "subtitle", "time": 446.39, "timestamp": "00:07:26", "text": "明天我们一起玩《远方之光》吧。 我"}, {"type": "subtitle", "time": 449.749, "timestamp": "00:07:29", "text": "必须完成那些"}, {"type": "subtitle", "time": 452.07, "timestamp": "00:07:32", "text": "任务等等。 现在"}, {"type": "subtitle", "time": 454.23, "timestamp": "00:07:34", "text": "已经是11月2日了，我知道"}, {"type": "subtitle", "time": 457.029, "timestamp": "00:07:37", "text": "对我来说今天是11月3日。 我得完成"}, {"type": "subtitle", "time": 459.43, "timestamp": "00:07:39", "text": "一些任务。"}, {"type": "subtitle", "time": 462.15, "timestamp": "00:07:42", "text": "现在需要多久才能收到？ 您"}, {"type": "subtitle", "time": 466.87, "timestamp": "00:07:46", "text": "认为？ 所以一周内你可以"}, {"type": "subtitle", "time": 471.35, "timestamp": "00:07:51", "text": "从地图上的宝箱中获得多达 100 个箱子，"}, {"type": "subtitle", "time": 474.79, "timestamp": "00:07:54", "text": "对吗？ 如果你完成每日挑战，"}, {"type": "subtitle", "time": 478.95, "timestamp": "00:07:58", "text": "比如击杀七个敌人、获得三"}]
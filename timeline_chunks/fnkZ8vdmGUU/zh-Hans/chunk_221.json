[{"type": "subtitle", "time": 13291.91, "timestamp": "03:41:31", "text": "马特，你好马特，"}, {"type": "subtitle", "time": 13294.469, "timestamp": "03:41:34", "text": "保重。 愿今晚星辰保佑你，"}, {"type": "subtitle", "time": 13296.63, "timestamp": "03:41:36", "text": "赐予你甜美的梦乡。"}, {"type": "subtitle", "time": 13300.469, "timestamp": "03:41:40", "text": "好的，晚安。 祝你"}]
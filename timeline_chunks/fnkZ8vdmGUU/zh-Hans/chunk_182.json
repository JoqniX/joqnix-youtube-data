[{"type": "subtitle", "time": 10925.83, "timestamp": "03:02:05", "text": "我觉得我已经花了超过300个"}, {"type": "subtitle", "time": 10929.11, "timestamp": "03:02:09", "text": "小时在《蓝色协议》上了。 但是，是的"}, {"type": "subtitle", "time": 10931.429, "timestamp": "03:02:11", "text": "，"}, {"type": "subtitle", "time": 10942.79, "timestamp": "03:02:22", "text": "因为我的声音和表演，我"}, {"type": "subtitle", "time": 10945.19, "timestamp": "03:02:25", "text": "不知道我有没有口音，但很多人一"}, {"type": "subtitle", "time": 10950.07, "timestamp": "03:02:30", "text": "开始不会看出来，或者会把我当成印度人什么的，对吧？"}]
[{"type": "subtitle", "time": 1204.71, "timestamp": "00:20:04", "text": "等等，我能做什么？ 等等，我想我可以"}, {"type": "subtitle", "time": 1206.87, "timestamp": "00:20:06", "text": "展示这个，对吧？"}, {"type": "subtitle", "time": 1210.07, "timestamp": "00:20:10", "text": "你想看吗？"}, {"type": "subtitle", "time": 1213.99, "timestamp": "00:20:13", "text": "我在另一个游戏中。"}, {"type": "subtitle", "time": 1216.15, "timestamp": "00:20:16", "text": "等等，为什么这里没有显示？ 哦，"}, {"type": "subtitle", "time": 1220.15, "timestamp": "00:20:20", "text": "打起来。 好的，我到了。 我想死。"}, {"type": "subtitle", "time": 1223.83, "timestamp": "00:20:23", "text": "让我找到手榴弹然后去死吧。 我"}, {"type": "subtitle", "time": 1233.59, "timestamp": "00:20:33", "text": "我当时完全可以直接喷火。"}, {"type": "subtitle", "time": 1238.23, "timestamp": "00:20:38", "text": "但我仍然需要完成恶魔的任务"}, {"type": "subtitle", "time": 1241.59, "timestamp": "00:20:41", "text": "。 我的天啊，我这边的游戏卡顿得厉害"}, {"type": "subtitle", "time": 1247.11, "timestamp": "00:20:47", "text": "。 我看到那个东西卡顿得"}, {"type": "subtitle", "time": 1249.35, "timestamp": "00:20:49", "text": "厉害。 好了，我找到"}, {"type": "subtitle", "time": 1252.23, "timestamp": "00:20:52", "text": "人了。 我能行。如果是机器人，请"}, {"type": "subtitle", "time": 1256.31, "timestamp": "00:20:56", "text": "杀了我。 嘿，杀了我吧，"}, {"type": "subtitle", "time": 1259.029, "timestamp": "00:20:59", "text": "求你了。 是啊，杀了我吧。 是的。 你"}]
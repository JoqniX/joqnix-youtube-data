[{"type": "subtitle", "time": 1151.35, "timestamp": "00:19:11", "text": "现在确实有点卡顿。 因为我的电脑里装了"}, {"type": "subtitle", "time": 1154.71, "timestamp": "00:19:14", "text": "Farlight 84（笑声）"}, {"type": "subtitle", "time": 1156.549, "timestamp": "00:19:16", "text": "。"}, {"type": "subtitle", "time": 1160.23, "timestamp": "00:19:20", "text": "我想在重置前刷这个东西"}, {"type": "subtitle", "time": 1161.83, "timestamp": "00:19:21", "text": "。"}, {"type": "subtitle", "time": 1169.59, "timestamp": "00:19:29", "text": "我得怪达尔文。 你让我很想"}, {"type": "subtitle", "time": 1172.63, "timestamp": "00:19:32", "text": "打开 Far Light.io。 像往常一样，我现在应该会一直"}, {"type": "subtitle", "time": 1175.59, "timestamp": "00:19:35", "text": "开着蓝色协议在"}, {"type": "subtitle", "time": 1179.11, "timestamp": "00:19:39", "text": "后台运行，或者挂机刷怪，"}, {"type": "subtitle", "time": 1182.278, "timestamp": "00:19:42", "text": "但是呃"}, {"type": "subtitle", "time": 1187.99, "timestamp": "00:19:47", "text": "哦，你不会在地图外死亡。"}, {"type": "subtitle", "time": 1192.95, "timestamp": "00:19:52", "text": "你被他用喷气背包到处飞。 我的天啊，"}, {"type": "subtitle", "time": 1195.378, "timestamp": "00:19:55", "text": "这游戏。"}]
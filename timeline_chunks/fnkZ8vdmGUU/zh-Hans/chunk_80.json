[{"type": "subtitle", "time": 4803.189, "timestamp": "01:20:03", "text": "，对吧？"}, {"type": "subtitle", "time": 4805.43, "timestamp": "01:20:05", "text": "就像我之前想做游戏设计"}, {"type": "subtitle", "time": 4808.39, "timestamp": "01:20:08", "text": "那样。 我有很多想法，"}, {"type": "subtitle", "time": 4811.83, "timestamp": "01:20:11", "text": "比如在 Twitch 聊天室里加入一些互动式 3D 元素，比如"}, {"type": "subtitle", "time": 4814.47, "timestamp": "01:20:14", "text": "Twitch YouTube 的"}, {"type": "subtitle", "time": 4818.47, "timestamp": "01:20:18", "text": "踢球聊天室里可以加入一些小型或可"}, {"type": "subtitle", "time": 4822.47, "timestamp": "01:20:22", "text": "移动的物体，或者像"}, {"type": "subtitle", "time": 4824.709, "timestamp": "01:20:24", "text": "我直播时或者举办"}, {"type": "subtitle", "time": 4826.95, "timestamp": "01:20:26", "text": "演唱会时出现的吉祥物之类的东西。 我有很多想法，"}, {"type": "subtitle", "time": 4831.91, "timestamp": "01:20:31", "text": "我可以让我的角色像这个游戏一样，成为游戏"}, {"type": "subtitle", "time": 4834.63, "timestamp": "01:20:34", "text": "世界中的NPC等等"}, {"type": "subtitle", "time": 4838.95, "timestamp": "01:20:38", "text": "。 不，我有很多想法，"}, {"type": "subtitle", "time": 4841.91, "timestamp": "01:20:41", "text": "但后来我意识到我做不到，我不知道该"}, {"type": "subtitle", "time": 4843.83, "timestamp": "01:20:43", "text": "怎么做。 我不懂"}, {"type": "subtitle", "time": 4845.99, "timestamp": "01:20:45", "text": "编程。"}, {"type": "subtitle", "time": 4849.35, "timestamp": "01:20:49", "text": "但对我来说，情况更像是"}, {"type": "subtitle", "time": 4851.75, "timestamp": "01:20:51", "text": "我尝试过。"}, {"type": "subtitle", "time": 4854.87, "timestamp": "01:20:54", "text": "所以，我直播了六年，"}, {"type": "subtitle", "time": 4858.229, "timestamp": "01:20:58", "text": "六个小时，大概吧。 所以这么多年来，"}]
[{"type": "subtitle", "time": 4506.229, "timestamp": "01:15:06", "text": "马来亚在听证会名称下排名第二"}, {"type": "subtitle", "time": 4509.27, "timestamp": "01:15:09", "text": "。 这不是很酷吗？ 笔名"}, {"type": "subtitle", "time": 4511.75, "timestamp": "01:15:11", "text": "或"}, {"type": "subtitle", "time": 4514.95, "timestamp": "01:15:14", "text": "哇。 他们有那样的"}, {"type": "subtitle", "time": 4517.189, "timestamp": "01:15:17", "text": "姓氏，是吗？"}, {"type": "subtitle", "time": 4525.43, "timestamp": "01:15:25", "text": "呃，你们俩都在做我"}, {"type": "subtitle", "time": 4527.99, "timestamp": "01:15:27", "text": "想做的事。"}, {"type": "subtitle", "time": 4530.63, "timestamp": "01:15:30", "text": "嗯，"}, {"type": "subtitle", "time": 4532.55, "timestamp": "01:15:32", "text": "我确实想推出自己的周边产品"}, {"type": "subtitle", "time": 4535.03, "timestamp": "01:15:35", "text": "之类的。 我曾经"}, {"type": "subtitle", "time": 4537.669, "timestamp": "01:15:37", "text": "通过YouTube学习服装设计。"}, {"type": "subtitle", "time": 4542.55, "timestamp": "01:15:42", "text": "我把小时候的衣服拆了，想从中"}, {"type": "subtitle", "time": 4544.87, "timestamp": "01:15:44", "text": "弄点布料什么的"}, {"type": "subtitle", "time": 4548.47, "timestamp": "01:15:48", "text": "。 因为我当时"}, {"type": "subtitle", "time": 4551.99, "timestamp": "01:15:51", "text": "就想为 Zach 做些周边产品。"}, {"type": "subtitle", "time": 4554.229, "timestamp": "01:15:54", "text": "那时候我一心想成为"}, {"type": "subtitle", "time": 4556.87, "timestamp": "01:15:56", "text": "音乐人，做"}, {"type": "subtitle", "time": 4559.35, "timestamp": "01:15:59", "text": "DJ制作人之类的。 所以我就想做自己的"}]
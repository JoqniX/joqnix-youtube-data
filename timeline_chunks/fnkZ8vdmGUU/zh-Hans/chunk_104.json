[{"type": "chat", "time": 6241.118, "timestamp": "01:44:01", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "I still remember this memory i was lying on my terrace gazing the sky and I saw something fly above my head i though it was a moth ya and guess what comes and sit on my chestUCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4"}, {"type": "subtitle", "time": 6244.229, "timestamp": "01:44:04", "text": "就像你知道的，你知道的，嗯，嗯，"}, {"type": "subtitle", "time": 6248.47, "timestamp": "01:44:08", "text": "你"}, {"type": "subtitle", "time": 6251.27, "timestamp": "01:44:11", "text": "放在水果"}, {"type": "subtitle", "time": 6253.99, "timestamp": "01:44:13", "text": "蔬菜外面的网之类的东西，这样苍蝇就不会飞进来了"}, {"type": "subtitle", "time": 6258.39, "timestamp": "01:44:18", "text": "。 我以前用"}, {"type": "subtitle", "time": 6263.51, "timestamp": "01:44:23", "text": "那个去……试图捕捉蜜蜂。"}, {"type": "subtitle", "time": 6266.55, "timestamp": "01:44:26", "text": "不是……呃，那是什么？ 苍蝇"}, {"type": "subtitle", "time": 6268.629, "timestamp": "01:44:28", "text": "叫什么？ 是传单吗？ 就是"}, {"type": "subtitle", "time": 6272.149, "timestamp": "01:44:32", "text": "颜色较深那种。 但蚊子可不是。"}, {"type": "subtitle", "time": 6275.75, "timestamp": "01:44:35", "text": "呃，它用英语叫什么？"}, {"type": "subtitle", "time": 6284.47, "timestamp": "01:44:44", "text": "。 我以前常常试图用手去抓什么"}, {"type": "subtitle", "time": 6289.83, "timestamp": "01:44:49", "text": "我觉得家里人能处理好这件事是个好兆头。"}, {"type": "subtitle", "time": 6293.35, "timestamp": "01:44:53", "text": "哦，是的。 真的。"}, {"type": "subtitle", "time": 6296.39, "timestamp": "01:44:56", "text": "他们把所有的昆虫、蚊子"}]
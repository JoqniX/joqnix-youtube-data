[{"type": "subtitle", "time": 1094.71, "timestamp": "00:18:14", "text": "我一直很讨厌这家伙不给你。"}, {"type": "subtitle", "time": 1101.83, "timestamp": "00:18:21", "text": "呃，收回这句话。"}, {"type": "subtitle", "time": 1122.07, "timestamp": "00:18:42", "text": "我不能去那里。 我本来想去"}, {"type": "subtitle", "time": 1131.99, "timestamp": "00:18:51", "text": "惊讶的是，这款游戏竟然没有推出"}, {"type": "subtitle", "time": 1134.31, "timestamp": "00:18:54", "text": "任何万圣节活动。"}, {"type": "subtitle", "time": 1136.39, "timestamp": "00:18:56", "text": "我原以为游戏里会像"}, {"type": "subtitle", "time": 1139.19, "timestamp": "00:18:59", "text": "万圣节那样有很多装饰之类的，"}]
[{"type": "subtitle", "time": 11881.91, "timestamp": "03:18:01", "text": "我有较长的休息时间时，我就去"}, {"type": "subtitle", "time": 11884.229, "timestamp": "03:18:04", "text": "表演滑稽剧。"}, {"type": "subtitle", "time": 11887.51, "timestamp": "03:18:07", "text": "我演滑稽剧之类的。 所以，这就好比是"}, {"type": "subtitle", "time": 11893.91, "timestamp": "03:18:13", "text": "我 YouTube 频道上的所有视频，我做过的所有直播，包括"}, {"type": "subtitle", "time": 11895.67, "timestamp": "03:18:15", "text": "以前的和新的。 它将"}, {"type": "subtitle", "time": 11898.71, "timestamp": "03:18:18", "text": "播放一个随机时间戳的随机视频，"}, {"type": "subtitle", "time": 11904.229, "timestamp": "03:18:24", "text": "并生成一个包含 30 个视频的"}, {"type": "subtitle", "time": 11906.87, "timestamp": "03:18:26", "text": "随机播放列表。   嗯，"}, {"type": "subtitle", "time": 11910.55, "timestamp": "03:18:30", "text": "那是第三版了"}, {"type": "subtitle", "time": 11913.269, "timestamp": "03:18:33", "text": "。 第四版，"}, {"type": "subtitle", "time": 11915.99, "timestamp": "03:18:35", "text": "呃，我上周重新制作了它"}, {"type": "subtitle", "time": 11919.59, "timestamp": "03:18:39", "text": "。 所以它"}, {"type": "subtitle", "time": 11923.11, "timestamp": "03:18:43", "text": "使用了我的 Twitch 分类。 所以我正在把"}, {"type": "subtitle", "time": 11926.15, "timestamp": "03:18:46", "text": "它改成更注重分类的方式。 所以，"}, {"type": "subtitle", "time": 11928.63, "timestamp": "03:18:48", "text": "我的 YouTube 频道里有专门的分类，用来存放"}, {"type": "subtitle", "time": 11930.63, "timestamp": "03:18:50", "text": "我直播过的所有游戏和"}, {"type": "subtitle", "time": 11932.71, "timestamp": "03:18:52", "text": "我制作过的所有内容。"}, {"type": "subtitle", "time": 11935.67, "timestamp": "03:18:55", "text": "正确的。 唱歌、库克、任何东西，"}, {"type": "subtitle", "time": 11939.75, "timestamp": "03:18:59", "text": "然后是时间艺术作品，和我一起直播，或者"}]
[{"type": "subtitle", "time": 12900.63, "timestamp": "03:35:00", "text": "阿迪什呢？ 你喝过热"}, {"type": "subtitle", "time": 12906.63, "timestamp": "03:35:06", "text": "这里有好多我以前从未拥有过的东西"}, {"type": "subtitle", "time": 12908.87, "timestamp": "03:35:08", "text": "。"}, {"type": "subtitle", "time": 12911.51, "timestamp": "03:35:11", "text": "等等，我吃过华夫饼吗？ 我想我吃过"}, {"type": "subtitle", "time": 12915.429, "timestamp": "03:35:15", "text": "华夫饼。 没有把握。"}, {"type": "subtitle", "time": 12917.83, "timestamp": "03:35:17", "text": "我不是那种喜欢吃快餐的人"}, {"type": "subtitle", "time": 12921.03, "timestamp": "03:35:21", "text": "。 我更喜欢家常菜之类的"}, {"type": "subtitle", "time": 12925.269, "timestamp": "03:35:25", "text": "食物。 我只吃家常菜，"}, {"type": "subtitle", "time": 12927.51, "timestamp": "03:35:27", "text": "因为我很少外出。 这也是其中一点"}, {"type": "subtitle", "time": 12929.269, "timestamp": "03:35:29", "text": "。"}, {"type": "subtitle", "time": 12932.229, "timestamp": "03:35:32", "text": "但说实话，家常菜才是最好的"}, {"type": "subtitle", "time": 12946.15, "timestamp": "03:35:46", "text": "他们说，一杯好喝的热巧克力能让"}]
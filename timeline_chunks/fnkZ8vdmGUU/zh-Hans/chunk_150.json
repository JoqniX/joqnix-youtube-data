[{"type": "subtitle", "time": 9017.99, "timestamp": "02:30:17", "text": "又一个终极版。 好的。"}, {"type": "subtitle", "time": 9022.389, "timestamp": "02:30:22", "text": "我得到了它。 主终于出局了。"}, {"type": "subtitle", "time": 9026.23, "timestamp": "02:30:26", "text": "我的天啊。 我以前经常吃东西。 我以前总"}, {"type": "subtitle", "time": 9028.469, "timestamp": "02:30:28", "text": "觉得自己吃很多，而且我真的"}, {"type": "subtitle", "time": 9031.349, "timestamp": "02:30:31", "text": "不喜欢和朋友们和好，一起出去"}, {"type": "subtitle", "time": 9032.79, "timestamp": "02:30:32", "text": "喝酒聊天。 我们俩"}, {"type": "subtitle", "time": 9035.349, "timestamp": "02:30:35", "text": "都没吃早饭。 所以我买了两个"}, {"type": "subtitle", "time": 9037.83, "timestamp": "02:30:37", "text": "盘子的印度香饭、薯条和菠萝"}, {"type": "subtitle", "time": 9041.75, "timestamp": "02:30:41", "text": "汁饮料。 我们连"}, {"type": "subtitle", "time": 9043.429, "timestamp": "02:30:43", "text": "买的东西的一半都没用完。"}, {"type": "subtitle", "time": 9045.429, "timestamp": "02:30:45", "text": "我的天啊。"}]
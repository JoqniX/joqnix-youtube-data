[{"type": "subtitle", "time": 4860.39, "timestamp": "01:21:00", "text": "我一直在尝试各种各样的"}, {"type": "subtitle", "time": 4862.55, "timestamp": "01:21:02", "text": "事情，"}, {"type": "subtitle", "time": 4864.79, "timestamp": "01:21:04", "text": "没有专注于一件事，这"}, {"type": "subtitle", "time": 4867.27, "timestamp": "01:21:07", "text": "让我感到筋疲力尽，并且停滞不前，"}, {"type": "subtitle", "time": 4872.709, "timestamp": "01:21:12", "text": "除非你能努力将"}, {"type": "subtitle", "time": 4875.91, "timestamp": "01:21:15", "text": "它们变成现实。 是的。 所以我觉得我当时"}, {"type": "subtitle", "time": 4878.31, "timestamp": "01:21:18", "text": "基本上是在做样样通却样样稀松的"}, {"type": "subtitle", "time": 4880.87, "timestamp": "01:21:20", "text": "事情。"}, {"type": "subtitle", "time": 4883.669, "timestamp": "01:21:23", "text": "后来我就筋疲力尽了。 我把事情搞"}, {"type": "subtitle", "time": 4886.31, "timestamp": "01:21:26", "text": "复杂了。 然后我就想，"}, {"type": "subtitle", "time": 4893.43, "timestamp": "01:21:33", "text": "那个东西会是。"}, {"type": "subtitle", "time": 4896.39, "timestamp": "01:21:36", "text": "如果我不采纳这个想法，"}, {"type": "subtitle", "time": 4906.63, "timestamp": "01:21:46", "text": "目前正在编写自己的短片剧本。 哦，"}, {"type": "subtitle", "time": 4914.95, "timestamp": "01:21:54", "text": "呃，你知道，呃，说到"}, {"type": "subtitle", "time": 4917.59, "timestamp": "01:21:57", "text": "短片，短片是不是在"}]
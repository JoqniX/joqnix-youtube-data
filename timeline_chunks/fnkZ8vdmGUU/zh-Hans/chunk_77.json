[{"type": "subtitle", "time": 4621.669, "timestamp": "01:17:01", "text": "我拿了那个，因为我在做类似IGNU"}, {"type": "subtitle", "time": 4626.55, "timestamp": "01:17:06", "text": "之类的事情。 嗯，远程学习之类的。"}, {"type": "subtitle", "time": 4629.83, "timestamp": "01:17:09", "text": "所以实际上，"}, {"type": "subtitle", "time": 4632.709, "timestamp": "01:17:12", "text": "我选择它只是因为我可以"}, {"type": "subtitle", "time": 4636.39, "timestamp": "01:17:16", "text": "为自己创作的关于狗的故事以及"}, {"type": "subtitle", "time": 4639.99, "timestamp": "01:17:19", "text": "我笔下的其他角色写故事。"}, {"type": "subtitle", "time": 4641.83, "timestamp": "01:17:21", "text": "感觉自己根本没在学习"}, {"type": "subtitle", "time": 4644.63, "timestamp": "01:17:24", "text": "。  [笑声]"}, {"type": "subtitle", "time": 4648.47, "timestamp": "01:17:28", "text": "我觉得我浪费时间了，因为我不想"}, {"type": "subtitle", "time": 4652.709, "timestamp": "01:17:32", "text": "做那个。 你知道，我"}, {"type": "subtitle", "time": 4655.99, "timestamp": "01:17:35", "text": "现在大概30岁了。 但是，"}, {"type": "subtitle", "time": 4659.59, "timestamp": "01:17:39", "text": "我根本就没在学习。 我的"}, {"type": "subtitle", "time": 4662.31, "timestamp": "01:17:42", "text": "动力消失了。 我感觉自己本来可以"}, {"type": "subtitle", "time": 4665.51, "timestamp": "01:17:45", "text": "去读音乐学位的。 我为什么会选择"}, {"type": "subtitle", "time": 4671.27, "timestamp": "01:17:51", "text": "我也太认真了。 但是，"}, {"type": "subtitle", "time": 4675.35, "timestamp": "01:17:55", "text": "我的同事兼英语老师教授……"}, {"type": "subtitle", "time": 4677.51, "timestamp": "01:17:57", "text": "啊，是的。   是的"}, {"type": "subtitle", "time": 4679.83, "timestamp": "01:17:59", "text": "。 是的。 是的。 是的。   也一样"}]
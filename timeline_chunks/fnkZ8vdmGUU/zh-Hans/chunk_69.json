[{"type": "subtitle", "time": 4142.87, "timestamp": "01:09:02", "text": "GFX 机器人会像普通用户一样行事"}, {"type": "subtitle", "time": 4146.709, "timestamp": "01:09:06", "text": "。 然后慢慢地，他们会说："}, {"type": "subtitle", "time": 4149.749, "timestamp": "01:09:09", "text": "“哦，我画画。想看看我的作品吗？"}, {"type": "subtitle", "time": 4151.91, "timestamp": "01:09:11", "text": "我会关注你。我会在Discord上加你好友。”"}, {"type": "subtitle", "time": 4154.47, "timestamp": "01:09:14", "text": "这个那个。 而我一直以来都会"}, {"type": "subtitle", "time": 4156.789, "timestamp": "01:09:16", "text": "想：“哦，一位真正的观众，一位"}, {"type": "subtitle", "time": 4158.95, "timestamp": "01:09:18", "text": "新观众。” 但实际上，他们来"}, {"type": "subtitle", "time": 4164.229, "timestamp": "01:09:24", "text": "这里是为了强行推销自己的产品。"}, {"type": "subtitle", "time": 4166.63, "timestamp": "01:09:26", "text": "那是Twitch的东西。"}, {"type": "subtitle", "time": 4169.91, "timestamp": "01:09:29", "text": "不仅如此，如果你"}, {"type": "subtitle", "time": 4172.55, "timestamp": "01:09:32", "text": "的 Twitch 个人资料中关联了 Discord，他们还会"}, {"type": "subtitle", "time": 4175.349, "timestamp": "01:09:35", "text": "闯入你的 Discord 服务器。"}, {"type": "subtitle", "time": 4178.87, "timestamp": "01:09:38", "text": "我不得不设置更多安全措施，"}, {"type": "subtitle", "time": 4183.59, "timestamp": "01:09:43", "text": "以确保 GFX 的那些家伙不会"}, {"type": "subtitle", "time": 4186.47, "timestamp": "01:09:46", "text": "在我的服务器上给每个人发送垃圾私信"}, {"type": "subtitle", "time": 4198.55, "timestamp": "01:09:58", "text": "。 甚至在 X 上也是如此，比如 Twitter。"}]
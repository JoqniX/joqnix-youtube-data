[{"type": "subtitle", "time": 7082.07, "timestamp": "01:58:02", "text": "玩得开心，呃，《鬼泣1》。哦，真好。 我"}, {"type": "subtitle", "time": 7085.91, "timestamp": "01:58:05", "text": "还没玩过《鬼泣》系列游戏。 我"}, {"type": "subtitle", "time": 7088.87, "timestamp": "01:58:08", "text": "想玩这个游戏。"}, {"type": "subtitle", "time": 7092.55, "timestamp": "01:58:12", "text": "我见过很多相关的表情包和东西，比如"}, {"type": "subtitle", "time": 7095.189, "timestamp": "01:58:15", "text": "塑料椅子，[笑声] 什么都有。 我"}, {"type": "subtitle", "time": 7099.109, "timestamp": "01:58:19", "text": "想再玩玩，"}, {"type": "subtitle", "time": 7106.47, "timestamp": "01:58:26", "text": "我以前玩过的那样。 我没有游戏。 但"}, {"type": "subtitle", "time": 7108.629, "timestamp": "01:58:28", "text": "我没有可以直播的游戏。 但是"}, {"type": "subtitle", "time": 7112.229, "timestamp": "01:58:32", "text": "有很多免费游戏。 将在 Steam、"}, {"type": "subtitle", "time": 7114.87, "timestamp": "01:58:34", "text": "Epic 和 Gi 上推出。"}, {"type": "subtitle", "time": 7116.629, "timestamp": "01:58:36", "text": "好吧，（笑声）"}, {"type": "subtitle", "time": 7120.709, "timestamp": "01:58:40", "text": "我可以认领那些。 我亲自试了一下"}, {"type": "subtitle", "time": 7123.75, "timestamp": "01:58:43", "text": "。 我声称拥有一切，但我几乎不"}, {"type": "subtitle", "time": 7126.47, "timestamp": "01:58:46", "text": "祈祷其中任何一项。  [笑声] 目前"}, {"type": "subtitle", "time": 7128.87, "timestamp": "01:58:48", "text": "只是在收集而已"}, {"type": "subtitle", "time": 7132.07, "timestamp": "01:58:52", "text": "。 我尝试购买一台新电脑。 啊，"}]
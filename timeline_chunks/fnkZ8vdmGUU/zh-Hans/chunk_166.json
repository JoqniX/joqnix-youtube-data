[{"type": "subtitle", "time": 9966.63, "timestamp": "02:46:06", "text": "等待。 你什么时候睡觉？ 那"}, {"type": "subtitle", "time": 9978.309, "timestamp": "02:46:18", "text": "哦，这太搞笑了。 但明天上班，"}, {"type": "subtitle", "time": 9980.389, "timestamp": "02:46:20", "text": "上午10点以后就得起床，这让人很焦虑"}, {"type": "subtitle", "time": 9983.349, "timestamp": "02:46:23", "text": "。"}, {"type": "subtitle", "time": 9986.07, "timestamp": "02:46:26", "text": "我只是说了句“好的”。"}, {"type": "subtitle", "time": 9988.15, "timestamp": "02:46:28", "text": "哇。"}, {"type": "subtitle", "time": 10013.67, "timestamp": "02:46:53", "text": "感谢上帝，我今天一点也不"}]
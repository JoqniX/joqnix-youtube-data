[{"type": "subtitle", "time": 543.19, "timestamp": "00:09:03", "text": "。 但上个赛季"}, {"type": "subtitle", "time": 546.949, "timestamp": "00:09:06", "text": "非常艰难。 你"}, {"type": "subtitle", "time": 549.99, "timestamp": "00:09:09", "text": "需要大约 3000 个"}, {"type": "subtitle", "time": 554.47, "timestamp": "00:09:14", "text": "神秘战利品箱才能"}, {"type": "subtitle", "time": 558.71, "timestamp": "00:09:18", "text": "解锁一个史诗皮肤，而"}, {"type": "subtitle", "time": 563.269, "timestamp": "00:09:23", "text": "解锁一个角色则需要大约 1000 个。 所以，上次"}, {"type": "subtitle", "time": 565.829, "timestamp": "00:09:25", "text": "他们给了男性角色，也就是"}, {"type": "subtitle", "time": 568.949, "timestamp": "00:09:28", "text": "海都这个角色，他有一个"}, {"type": "subtitle", "time": 571.509, "timestamp": "00:09:31", "text": "类似溜冰鞋的东西。 那"}, {"type": "subtitle", "time": 575.509, "timestamp": "00:09:35", "text": "个人，还有另一个，就是"}, {"type": "subtitle", "time": 578.389, "timestamp": "00:09:38", "text": "中国龙女，水"}, {"type": "subtitle", "time": 581.509, "timestamp": "00:09:41", "text": "龙女。 我，呃，她叫什么名字来着？ 我忘了"}, {"type": "subtitle", "time": 584.31, "timestamp": "00:09:44", "text": "和B. Bishu谈一些事。 我不知道。"}, {"type": "subtitle", "time": 587.75, "timestamp": "00:09:47", "text": "我猜是吧。"}, {"type": "subtitle", "time": 589.75, "timestamp": "00:09:49", "text": "我不知道。 是的，这两个人比较了"}, {"type": "subtitle", "time": 593.91, "timestamp": "00:09:53", "text": "人物性格。 我花了100元买了语音服务。我"}, {"type": "subtitle", "time": 597.43, "timestamp": "00:09:57", "text": "觉得还可以。 你还可以再次获得它。"}, {"type": "subtitle", "time": 599.269, "timestamp": "00:09:59", "text": "不，没关系。 别太担心"}]
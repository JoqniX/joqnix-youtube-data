[{"type": "subtitle", "time": 6182.07, "timestamp": "01:43:02", "text": "你知道，有一次，因为"}, {"type": "subtitle", "time": 6187.83, "timestamp": "01:43:07", "text": "我喜欢蜘蛛侠的东西，在我"}, {"type": "subtitle", "time": 6190.629, "timestamp": "01:43:10", "text": "小时候，我"}, {"type": "subtitle", "time": 6193.75, "timestamp": "01:43:13", "text": "就想，“好吧，如果我"}, {"type": "subtitle", "time": 6197.27, "timestamp": "01:43:17", "text": "养一只宠物蜘蛛，我就可以成为蜘蛛侠了。”"}, {"type": "subtitle", "time": 6201.601, "timestamp": "01:43:21", "text": "我当时也是这么认为的。 我以前会"}, {"type": "subtitle", "time": 6202.149, "timestamp": "01:43:22", "text": "[笑]"}, {"type": "subtitle", "time": 6205.51, "timestamp": "01:43:25", "text": "抓蜘蛛放在手上，这样"}, {"type": "subtitle", "time": 6207.496, "timestamp": "01:43:27", "text": "就能被蜘蛛咬一口。 所以我就（倒"}, {"type": "subtitle", "time": 6209.83, "timestamp": "01:43:29", "text": "吸一口凉气）想，我可以当蜘蛛侠。 我可以"}, {"type": "subtitle", "time": 6212.709, "timestamp": "01:43:32", "text": "拥有超能力之类的东西。"}, {"type": "subtitle", "time": 6216.87, "timestamp": "01:43:36", "text": "后来我才意识到，那样做不好。"}, {"type": "subtitle", "time": 6221.43, "timestamp": "01:43:41", "text": "幸好我没有被蜘蛛咬。"}, {"type": "subtitle", "time": 6224.31, "timestamp": "01:43:44", "text": "我的天哪，已经过了这么久了。 想起"}, {"type": "subtitle", "time": 6228.149, "timestamp": "01:43:48", "text": "童年的点点滴滴，让我感到"}, {"type": "subtitle", "time": 6231.99, "timestamp": "01:43:51", "text": "无比怀旧。 我的天哪，"}, {"type": "subtitle", "time": 6234.352, "timestamp": "01:43:54", "text": "我以前做过好多奇怪的事情。"}]
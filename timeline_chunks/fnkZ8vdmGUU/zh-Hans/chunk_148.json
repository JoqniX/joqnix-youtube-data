[{"type": "subtitle", "time": 8881.67, "timestamp": "02:28:01", "text": "我睡着了。 我几个小时后就要上班了"}, {"type": "subtitle", "time": 8884.389, "timestamp": "02:28:04", "text": "。 工作。 你好。 感谢您"}, {"type": "subtitle", "time": 8887.03, "timestamp": "02:28:07", "text": "今天光临。 您的回答对我意义重大"}, {"type": "subtitle", "time": 8888.71, "timestamp": "02:28:08", "text": "。"}, {"type": "subtitle", "time": 8891.59, "timestamp": "02:28:11", "text": "你话很多。 你让我说了"}, {"type": "subtitle", "time": 8893.67, "timestamp": "02:28:13", "text": "好多话。 谢谢。 我们聊了很多"}, {"type": "subtitle", "time": 8896.87, "timestamp": "02:28:16", "text": "事情。 我很喜欢。 希望您"}, {"type": "subtitle", "time": 8899.51, "timestamp": "02:28:19", "text": "今天入住愉快。 希望你"}, {"type": "subtitle", "time": 8902.71, "timestamp": "02:28:22", "text": "以后也能再来。 好好照顾自己，祝你"}, {"type": "subtitle", "time": 8905.59, "timestamp": "02:28:25", "text": "睡个好觉。 好的。"}, {"type": "subtitle", "time": 8909.03, "timestamp": "02:28:29", "text": "明天是星期一，祝你"}, {"type": "subtitle", "time": 8929.59, "timestamp": "02:28:49", "text": "哦，我忘了说我通常在"}, {"type": "subtitle", "time": 8933.19, "timestamp": "02:28:53", "text": "别人要睡觉时说的话。 你好。"}, {"type": "subtitle", "time": 8935.83, "timestamp": "02:28:55", "text": "愿今晚星辰保佑你。"}, {"type": "subtitle", "time": 8938.87, "timestamp": "02:28:58", "text": "愿星辰赐予你"}]
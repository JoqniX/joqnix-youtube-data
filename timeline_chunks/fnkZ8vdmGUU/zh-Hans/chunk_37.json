[{"type": "subtitle", "time": 2222.15, "timestamp": "00:37:02", "text": "我的天啊。 我们走吧。"}, {"type": "subtitle", "time": 2226.23, "timestamp": "00:37:06", "text": "至尊宁静。 最后。"}, {"type": "subtitle", "time": 2228.87, "timestamp": "00:37:08", "text": "纳什。 纳什。   那"}, {"type": "subtitle", "time": 2231.349, "timestamp": "00:37:11", "text": "我再来一遍。 更确切地说，"}, {"type": "subtitle", "time": 2245.99, "timestamp": "00:37:25", "text": "自从那些事情发生后我暂停更新网站以来，我就再也没有碰过这个网站了"}, {"type": "subtitle", "time": 2256.47, "timestamp": "00:37:36", "text": "我已经很久没碰过这个网站了，就像今天这样，在"}, {"type": "subtitle", "time": 2263.589, "timestamp": "00:37:43", "text": "重新开始直播后，我做了一次合作。"}, {"type": "subtitle", "time": 2265.75, "timestamp": "00:37:45", "text": "我完成了合作项目。 所以，我就在"}, {"type": "subtitle", "time": 2268.23, "timestamp": "00:37:48", "text": "想，或许我应该"}, {"type": "subtitle", "time": 2270.31, "timestamp": "00:37:50", "text": "更新一下我的合作伙伴数据库之类的"}, {"type": "subtitle", "time": 2272.47, "timestamp": "00:37:52", "text": "东西，对吧？ 这样，我就可以把这"}, {"type": "subtitle", "time": 2276.55, "timestamp": "00:37:56", "text": "个人的头像、PNG图片等等添加到"}, {"type": "subtitle", "time": 2279.829, "timestamp": "00:37:59", "text": "我的Notion数据库中了。 所以，现在更容易了。"}]
[{"type": "subtitle", "time": 3542.549, "timestamp": "00:59:02", "text": "所以当时我就想，“好吧，行。"}, {"type": "subtitle", "time": 3544.95, "timestamp": "00:59:04", "text": "我来做恶魔维斯。” 因为这段"}, {"type": "subtitle", "time": 3547.27, "timestamp": "00:59:07", "text": "时间我一直忽略了这些，只专注"}, {"type": "subtitle", "time": 3551.589, "timestamp": "00:59:11", "text": "于角色升级、"}, {"type": "subtitle", "time": 3554.309, "timestamp": "00:59:14", "text": "武器升阶和秘密"}, {"type": "subtitle", "time": 3562.47, "timestamp": "00:59:22", "text": "后来我发现其他人清理这个"}, {"type": "subtitle", "time": 3565.43, "timestamp": "00:59:25", "text": "东西的速度更快。"}, {"type": "subtitle", "time": 3574.47, "timestamp": "00:59:34", "text": "是她武器的复制品之一。 哦，不错。"}, {"type": "subtitle", "time": 3578.549, "timestamp": "00:59:38", "text": "你拿到那把魔力值更高的剑了吗"}, {"type": "subtitle", "time": 3581.589, "timestamp": "00:59:41", "text": "？"}, {"type": "subtitle", "time": 3585.19, "timestamp": "00:59:45", "text": "呃，充电装置。"}, {"type": "subtitle", "time": 3593.43, "timestamp": "00:59:53", "text": "那是她的剑。 呃，我有光剑那"}, {"type": "subtitle", "time": 3596.47, "timestamp": "00:59:56", "text": "玩意儿，不过，我把那把剑给了她"}]
[{"type": "subtitle", "time": 11941.349, "timestamp": "03:19:01", "text": "音乐制作直播，任何东西，"}, {"type": "subtitle", "time": 11944.07, "timestamp": "03:19:04", "text": "总会有一个播放列表，对吧？所以我把"}, {"type": "subtitle", "time": 11946.71, "timestamp": "03:19:06", "text": "它做成了一个播放列表，它"}, {"type": "subtitle", "time": 11951.75, "timestamp": "03:19:11", "text": "会扫描我的 Twitch 分类，根据我的分类，它会分配一个 YouTube 播放"}, {"type": "subtitle", "time": 11955.03, "timestamp": "03:19:15", "text": "列表。例如，我们现在在 Twitch"}, {"type": "subtitle", "time": 11956.95, "timestamp": "03:19:16", "text": "上直播，这是一个很棒的分类，对吧？"}, {"type": "subtitle", "time": 11959.429, "timestamp": "03:19:19", "text": "所以它会扫描我当前正在"}, {"type": "subtitle", "time": 11962.07, "timestamp": "03:19:22", "text": "Twitch 上直播，"}, {"type": "subtitle", "time": 11968.07, "timestamp": "03:19:28", "text": "并且我在“Do at Night”分类中，我预先放上了我"}, {"type": "subtitle", "time": 11971.99, "timestamp": "03:19:31", "text": "创建的 YouTube 播放列表，对吧？所以如果我在"}, {"type": "subtitle", "time": 11973.429, "timestamp": "03:19:33", "text": "Twitch 上直播（清嗓子），"}, {"type": "subtitle", "time": 11977.19, "timestamp": "03:19:37", "text": "分类是“Do at Night”，那么就使用这个“Do"}, {"type": "subtitle", "time": 11979.67, "timestamp": "03:19:39", "text": "at Night”YouTube 播放列表，然后从这个"}, {"type": "subtitle", "time": 11981.99, "timestamp": "03:19:41", "text": "YouTube 播放列表中扫描视频，"}, {"type": "subtitle", "time": 11986.309, "timestamp": "03:19:46", "text": "并发出一个 API（HTTP）请求"}, {"type": "subtitle", "time": 11989.91, "timestamp": "03:19:49", "text": "来获取每个视频的数据，然后"}, {"type": "subtitle", "time": 11994.309, "timestamp": "03:19:54", "text": "从中获取随机时间戳，嗯，还有什么"}, {"type": "subtitle", "time": 11997.51, "timestamp": "03:19:57", "text": "？ 嗯，是的，时间戳"}]
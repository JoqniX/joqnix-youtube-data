[{"type": "chat", "time": 6302.506, "timestamp": "01:45:02", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "fly"}, {"type": "subtitle", "time": 6308.07, "timestamp": "01:45:08", "text": "不，它叫苍蝇。 啊，明白了。 至今仍"}, {"type": "subtitle", "time": 6309.669, "timestamp": "01:45:09", "text": "记得这件事。 我当时正躺在"}, {"type": "subtitle", "time": 6311.83, "timestamp": "01:45:11", "text": "父母身边亲吻星星，突然看到有什么"}, {"type": "subtitle", "time": 6313.91, "timestamp": "01:45:13", "text": "东西飞到了我的头上。 我以为那"}, {"type": "subtitle", "time": 6317.109, "timestamp": "01:45:17", "text": "是一只飞蛾。 是的。 你猜猜什么东西会跑到"}, {"type": "subtitle", "time": 6325.189, "timestamp": "01:45:25", "text": "是模组还是苍蝇？"}, {"type": "subtitle", "time": 6333.35, "timestamp": "01:45:33", "text": "好的，我读过了。 呃，"}, {"type": "subtitle", "time": 6335.51, "timestamp": "01:45:35", "text": "蜘蛛真的会咬你的手。 即使真的发生了"}, {"type": "subtitle", "time": 6338.47, "timestamp": "01:45:38", "text": "，你也永远无法真正"}, {"type": "subtitle", "time": 6340.79, "timestamp": "01:45:40", "text": "感受到疼痛。 除了"}]
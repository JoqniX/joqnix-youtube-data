[{"type": "subtitle", "time": 5224.55, "timestamp": "01:27:04", "text": "我应该再次回到日本身边。 等等，你"}, {"type": "subtitle", "time": 5226.55, "timestamp": "01:27:06", "text": "去过日本？ 你去哪儿？ 哪个"}, {"type": "subtitle", "time": 5229.03, "timestamp": "01:27:09", "text": "城市？"}, {"type": "subtitle", "time": 5231.75, "timestamp": "01:27:11", "text": "哦，这很有帮助。 他知道他早就认识"}, {"type": "subtitle", "time": 5237.75, "timestamp": "01:27:17", "text": "因为我有灵魂，而且背景是"}, {"type": "subtitle", "time": 5243.59, "timestamp": "01:27:23", "text": "Zoom 花时间谈论游戏。"}, {"type": "subtitle", "time": 5255.51, "timestamp": "01:27:35", "text": "我想念艾伦·林。"}, {"type": "subtitle", "time": 5257.75, "timestamp": "01:27:37", "text": "现在有了艾伦·林格的多人游戏"}, {"type": "subtitle", "time": 5261.669, "timestamp": "01:27:41", "text": "版本，对吧？ 或者别的什么。"}, {"type": "subtitle", "time": 5263.91, "timestamp": "01:27:43", "text": "黑暗之魂。 我从没玩过《黑暗之魂》。"}, {"type": "subtitle", "time": 5267.27, "timestamp": "01:27:47", "text": "总有一天我会玩的。"}, {"type": "subtitle", "time": 5270.47, "timestamp": "01:27:50", "text": "还有，苏里亚，呃，你是想问我什么建议吗"}, {"type": "subtitle", "time": 5273.83, "timestamp": "01:27:53", "text": "？ 这是怎么回事？ 发生了什么？"}, {"type": "subtitle", "time": 5276.07, "timestamp": "01:27:56", "text": "你没睡着。"}, {"type": "subtitle", "time": 5279.35, "timestamp": "01:27:59", "text": "你这个点儿还不睡觉吗？"}]
[{"type": "subtitle", "time": 3678.87, "timestamp": "01:01:18", "text": "哦，我得到一个否定。 我们走吧。 我们终于得到了"}, {"type": "subtitle", "time": 3691.19, "timestamp": "01:01:31", "text": "[清嗓子]"}, {"type": "subtitle", "time": 3693.51, "timestamp": "01:01:33", "text": "为什么发射台会突然冒出来"}, {"type": "subtitle", "time": 3695.109, "timestamp": "01:01:35", "text": "？"}, {"type": "subtitle", "time": 3697.27, "timestamp": "01:01:37", "text": "至少通知一下Destiny，我"}, {"type": "subtitle", "time": 3699.472, "timestamp": "01:01:39", "text": "不想它被夺走。 是的。"}, {"type": "subtitle", "time": 3710.39, "timestamp": "01:01:50", "text": "我的意思是，《堡垒之夜》里就有。 哦，也许吧。 不，像"}, {"type": "subtitle", "time": 3712.23, "timestamp": "01:01:52", "text": "《堡垒之夜》之类的游戏，他们应该获得了独家"}, {"type": "subtitle", "time": 3714.47, "timestamp": "01:01:54", "text": "授权。"}]
[{"type": "subtitle", "time": 9305.19, "timestamp": "02:35:05", "text": "并非所有人都"}, {"type": "subtitle", "time": 9307.99, "timestamp": "02:35:07", "text": "总是使用平假名和片假名。 大多数人"}, {"type": "subtitle", "time": 9311.03, "timestamp": "02:35:11", "text": "更喜欢汉字。 日语日常也需要用到汉字，"}, {"type": "subtitle", "time": 9314.55, "timestamp": "02:35:14", "text": "因为当你去"}, {"type": "subtitle", "time": 9316.469, "timestamp": "02:35:16", "text": "商店或"}, {"type": "subtitle", "time": 9318.79, "timestamp": "02:35:18", "text": "购买食品时，所有东西都会"}, {"type": "subtitle", "time": 9321.429, "timestamp": "02:35:21", "text": "有一些基本的汉字"}, {"type": "subtitle", "time": 9324.79, "timestamp": "02:35:24", "text": "。 所以汉字在某种程度上很重要，"}, {"type": "subtitle", "time": 9327.91, "timestamp": "02:35:27", "text": "有很多汉字人们"}, {"type": "subtitle", "time": 9330.469, "timestamp": "02:35:30", "text": "日常生活中并不使用，"}, {"type": "subtitle", "time": 9333.91, "timestamp": "02:35:33", "text": "更多的是在教科书之类的东西里用到。是的，"}, {"type": "subtitle", "time": 9343.99, "timestamp": "02:35:43", "text": "对我来说，我必须学习，我相信"}, {"type": "subtitle", "time": 9350.389, "timestamp": "02:35:50", "text": "N4要学100多个汉字，"}]
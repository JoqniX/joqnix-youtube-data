[{"type": "chat", "time": 3180.839, "timestamp": "00:53:00", "author": "@hbvcsa", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mA5iYFWQWr-erQfOrpRSPi7uAL1ykOBKRSbPBDp88Z1xyBT7Je5IKp6_AckwgwsDEc-Q=s64-c-k-c0x00ffffff-no-rj", "message": "Roku "}, {"type": "subtitle", "time": 3181.829, "timestamp": "00:53:01", "text": "嫉妒他们，因为他们根本"}, {"type": "subtitle", "time": 3184.39, "timestamp": "00:53:04", "text": "不练习也不复习。"}, {"type": "subtitle", "time": 3187.03, "timestamp": "00:53:07", "text": "这是我的弱点。"}, {"type": "subtitle", "time": 3190.23, "timestamp": "00:53:10", "text": "罗。 好的。 下一个是Roku。 一次"}, {"type": "subtitle", "time": 3193.19, "timestamp": "00:53:13", "text": "野餐。"}, {"type": "subtitle", "time": 3196.23, "timestamp": "00:53:16", "text": "哦，原来是张桌子啊，[笑声]"}, {"type": "subtitle", "time": 3200.15, "timestamp": "00:53:20", "text": "你知道的。 好的，罗。 让我把它藏起来。"}, {"type": "subtitle", "time": 3203.109, "timestamp": "00:53:23", "text": "然后（唱）呃，"}, {"type": "subtitle", "time": 3220.47, "timestamp": "00:53:40", "text": "如何再次写入行？ 嗯，"}, {"type": "subtitle", "time": 3223.99, "timestamp": "00:53:43", "text": "不是那个罗姆人"}, {"type": "chat", "time": 3227.072, "timestamp": "00:53:47", "author": "@hbvcsa", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mA5iYFWQWr-erQfOrpRSPi7uAL1ykOBKRSbPBDp88Z1xyBT7Je5IKp6_AckwgwsDEc-Q=s64-c-k-c0x00ffffff-no-rj", "message": "Roku has 4 Strokes"}, {"type": "subtitle", "time": 3231.19, "timestamp": "00:53:51", "text": "呃，"}, {"type": "subtitle", "time": 3233.349, "timestamp": "00:53:53", "text": "Ro有四次中风。 一、二、三、"}, {"type": "subtitle", "time": 3236.309, "timestamp": "00:53:56", "text": "四。 你好。"}]
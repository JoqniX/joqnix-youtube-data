[{"type": "subtitle", "time": 18961.59, "timestamp": "05:16:01", "text": "就会被记录下来。 假设"}, {"type": "subtitle", "time": 18964.708, "timestamp": "05:16:04", "text": "你说了一句脏话，但后来又删除了。"}, {"type": "subtitle", "time": 18966.55, "timestamp": "05:16:06", "text": "比如，一个非常非常糟糕的词，但"}, {"type": "subtitle", "time": 18969.59, "timestamp": "05:16:09", "text": "你把它删掉了。 没人注意到，但是"}, {"type": "subtitle", "time": 18972.23, "timestamp": "05:16:12", "text": "当版主"}, {"type": "subtitle", "time": 18976.55, "timestamp": "05:16:16", "text": "检查聊天记录时，比如从"}, {"type": "subtitle", "time": 18981.67, "timestamp": "05:16:21", "text": "Discord 上删除的聊天记录，或者以某种方式，如果你"}, {"type": "subtitle", "time": 18983.75, "timestamp": "05:16:23", "text": "已经被惩罚过，但你还有"}, {"type": "subtitle", "time": 18990.47, "timestamp": "05:16:30", "text": "不良记录之类的。"}, {"type": "subtitle", "time": 18992.39, "timestamp": "05:16:32", "text": "是的，那样做可能会让你"}, {"type": "subtitle", "time": 18995.35, "timestamp": "05:16:35", "text": "被封号或受到相应的处罚。 不，"}, {"type": "subtitle", "time": 18997.35, "timestamp": "05:16:37", "text": "就是这样。 更像是一种"}, {"type": "subtitle", "time": 19000.628, "timestamp": "05:16:40", "text": "安全功能，你可以说它用于"}, {"type": "subtitle", "time": 19002.868, "timestamp": "05:16:42", "text": "自我宣传"}, {"type": "chat", "time": 19003.47, "timestamp": "05:16:43", "author": "@FEROCIOUS_Grrr", "avatar": "https://yt4.ggpht.com/b2fcSyaRaGAEUJaW8yBs5ibxfiDi-brp1G8cHHTYAXKaRusaeuWU68kOjIUNWz1gmVNNSGP5MQ=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/face-purple-rain-drops"}, {"type": "subtitle", "time": 19004.39, "timestamp": "05:16:44", "text": "、"}, {"type": "subtitle", "time": 19006.07, "timestamp": "05:16:46", "text": "添加"}, {"type": "subtitle", "time": 19009.19, "timestamp": "05:16:49", "text": "服务器成员以及"}, {"type": "subtitle", "time": 19014.788, "timestamp": "05:16:54", "text": "自己"}, {"type": "subtitle", "time": 19017.59, "timestamp": "05:16:57", "text": "和其他人的私信。"}]
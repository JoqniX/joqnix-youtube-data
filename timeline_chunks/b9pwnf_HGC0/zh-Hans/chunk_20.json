[{"type": "subtitle", "time": 1200.39, "timestamp": "00:20:00", "text": "两遍就行了，然后就"}, {"type": "subtitle", "time": 1206.39, "timestamp": "00:20:06", "text": "开始。 你好。 嗯，看起来像这样。 呃，"}, {"type": "subtitle", "time": 1208.95, "timestamp": "00:20:08", "text": "我再放大"}, {"type": "subtitle", "time": 1213.669, "timestamp": "00:20:13", "text": "一点。"}, {"type": "subtitle", "time": 1224.23, "timestamp": "00:20:24", "text": "看起来就是这样。 她既是"}, {"type": "subtitle", "time": 1226.95, "timestamp": "00:20:26", "text": "我们正在面对的挑战，也是我们正在经历的挑战，所以"}, {"type": "subtitle", "time": 1231.99, "timestamp": "00:20:31", "text": "她说，所以会是这样"}, {"type": "subtitle", "time": 1235.669, "timestamp": "00:20:35", "text": "。 所以那些麻烦的人就是这样，"}, {"type": "subtitle", "time": 1239.51, "timestamp": "00:20:39", "text": "她和苏，"}, {"type": "subtitle", "time": 1242.87, "timestamp": "00:20:42", "text": "那四个人总是让"}]
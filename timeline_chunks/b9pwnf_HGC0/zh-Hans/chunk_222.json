[{"type": "subtitle", "time": 13323.11, "timestamp": "03:42:03", "text": "我还看了什么？ 我记得"}, {"type": "subtitle", "time": 13325.03, "timestamp": "03:42:05", "text": "很久以前看过《工业》。那是谎言"}, {"type": "subtitle", "time": 13358.869, "timestamp": "03:42:38", "text": "太可爱了。"}, {"type": "subtitle", "time": 13359.91, "timestamp": "03:42:39", "text": "[清嗓子]"}, {"type": "subtitle", "time": 13363.269, "timestamp": "03:42:43", "text": "呃，他让"}, {"type": "subtitle", "time": 13379.91, "timestamp": "03:42:59", "text": "错钥匙了。 永远记住“mis mis”和“"}]
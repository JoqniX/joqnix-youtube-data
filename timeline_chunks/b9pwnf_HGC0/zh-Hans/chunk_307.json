[{"type": "subtitle", "time": 18424.39, "timestamp": "05:07:04", "text": "你知道吗，我把他当成主要原因之一，对吧"}, {"type": "subtitle", "time": 18427.51, "timestamp": "05:07:07", "text": "？ 我觉得我没办法在"}, {"type": "subtitle", "time": 18431.59, "timestamp": "05:07:11", "text": "那里担任主教练的视频拍摄工作"}, {"type": "subtitle", "time": 18433.83, "timestamp": "05:07:13", "text": "。 如果我能"}, {"type": "subtitle", "time": 18436.788, "timestamp": "05:07:16", "text": "进入代理公司或者"}, {"type": "subtitle", "time": 18439.99, "timestamp": "05:07:19", "text": "其他什么企业，那情况就会好得多，"}, {"type": "subtitle", "time": 18442.31, "timestamp": "05:07:22", "text": "对吧？ 因为它就像从爱好变成了"}, {"type": "subtitle", "time": 18445.11, "timestamp": "05:07:25", "text": "正式工作，"}, {"type": "subtitle", "time": 18447.67, "timestamp": "05:07:27", "text": "成了我的主要工作或类似的职业"}, {"type": "subtitle", "time": 18451.43, "timestamp": "05:07:31", "text": "。 哦，但"}, {"type": "subtitle", "time": 18454.31, "timestamp": "05:07:34", "text": "即使我那样做，我仍然需要做一些"}, {"type": "subtitle", "time": 18460.628, "timestamp": "05:07:40", "text": "兼职之类的工作，或者其他一些"}, {"type": "subtitle", "time": 18463.91, "timestamp": "05:07:43", "text": "只适用于大型经纪"}, {"type": "subtitle", "time": 18465.75, "timestamp": "05:07:45", "text": "公司之类的工作，这些公司会给我提供"}, {"type": "subtitle", "time": 18468.788, "timestamp": "05:07:48", "text": "薪水，"}, {"type": "subtitle", "time": 18471.51, "timestamp": "05:07:51", "text": "我可以赚到足够的钱，"}, {"type": "subtitle", "time": 18474.628, "timestamp": "05:07:54", "text": "但这远远不够。我想，凭借"}, {"type": "subtitle", "time": 18476.788, "timestamp": "05:07:56", "text": "我的经验，也许我可以做"}, {"type": "subtitle", "time": 18479.19, "timestamp": "05:07:59", "text": "管理之类的工作。 我不知道"}]
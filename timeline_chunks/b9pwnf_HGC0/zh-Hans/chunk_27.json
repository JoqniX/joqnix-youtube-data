[{"type": "subtitle", "time": 1620.47, "timestamp": "00:27:00", "text": "。"}, {"type": "subtitle", "time": 1622.71, "timestamp": "00:27:02", "text": "嗯，还有"}, {"type": "subtitle", "time": 1630.07, "timestamp": "00:27:10", "text": "大部分我都知道，但是我不知道如何"}, {"type": "subtitle", "time": 1635.59, "timestamp": "00:27:15", "text": "进行读音和"}, {"type": "subtitle", "time": 1641.669, "timestamp": "00:27:21", "text": "哦，是啊，不过没关系，我们"}, {"type": "subtitle", "time": 1643.99, "timestamp": "00:27:23", "text": "至少可以一起学习这些基础知识。"}, {"type": "subtitle", "time": 1647.269, "timestamp": "00:27:27", "text": "好的，今天我会练习所有东西。"}, {"type": "subtitle", "time": 1650.07, "timestamp": "00:27:30", "text": "好的。 你想听听这个视频吗"}, {"type": "subtitle", "time": 1652.549, "timestamp": "00:27:32", "text": "？"}, {"type": "subtitle", "time": 1656.149, "timestamp": "00:27:36", "text": "如果你愿意，我可以这么做。"}, {"type": "subtitle", "time": 1657.75, "timestamp": "00:27:37", "text": "大多数日语汉字（音乐相关汉字）"}, {"type": "subtitle", "time": 1659.51, "timestamp": "00:27:39", "text": "都有不止一种"}, {"type": "subtitle", "time": 1662.549, "timestamp": "00:27:42", "text": "发音，但本视频仅展示了"}, {"type": "subtitle", "time": 1664.71, "timestamp": "00:27:44", "text": "每个汉字的一种典型发音"}, {"type": "subtitle", "time": 1667.43, "timestamp": "00:27:47", "text": "。"}, {"type": "subtitle", "time": 1671.51, "timestamp": "00:27:51", "text": "你好。 好的，我们就从这里开始。 呃，那"}, {"type": "subtitle", "time": 1675.029, "timestamp": "00:27:55", "text": "我该怎么做呢？ 让我想想。 我想"}, {"type": "subtitle", "time": 1678.47, "timestamp": "00:27:58", "text": "保持现状"}]
[{"type": "subtitle", "time": 15242.71, "timestamp": "04:14:02", "text": "职业，或者如果这条路"}, {"type": "subtitle", "time": 15244.63, "timestamp": "04:14:04", "text": "走不通，我就去实现我"}, {"type": "subtitle", "time": 15248.63, "timestamp": "04:14:08", "text": "儿时的梦想——成为一名音乐家，"}, {"type": "subtitle", "time": 15252.87, "timestamp": "04:14:12", "text": "发行音乐等等。"}, {"type": "subtitle", "time": 15255.189, "timestamp": "04:14:15", "text": "嗯，那会很不错。"}, {"type": "subtitle", "time": 15258.389, "timestamp": "04:14:18", "text": "我的意思是，我可能会去日本的"}, {"type": "subtitle", "time": 15262.149, "timestamp": "04:14:22", "text": "音乐大学或其他什么大学学习"}, {"type": "subtitle", "time": 15268.87, "timestamp": "04:14:28", "text": "我学英国文学的时候以为"}, {"type": "subtitle", "time": 15271.59, "timestamp": "04:14:31", "text": "自己可以成为作家什么的。 所以我"}, {"type": "subtitle", "time": 15274.469, "timestamp": "04:14:34", "text": "可以为乔和其他我想写故事的角色写故事，还可"}, {"type": "subtitle", "time": 15283.189, "timestamp": "04:14:43", "text": "以为我的热情项目创作背景故事等等。"}, {"type": "subtitle", "time": 15286.63, "timestamp": "04:14:46", "text": "结果不太理想。"}, {"type": "subtitle", "time": 15289.83, "timestamp": "04:14:49", "text": "但至少在音乐方面，我希望"}, {"type": "subtitle", "time": 15293.269, "timestamp": "04:14:53", "text": "继续做到最好。 当然，我"}, {"type": "subtitle", "time": 15295.59, "timestamp": "04:14:55", "text": "知道如果我"}, {"type": "subtitle", "time": 15298.55, "timestamp": "04:14:58", "text": "不做这些，比如最近做的 Sammy"}]
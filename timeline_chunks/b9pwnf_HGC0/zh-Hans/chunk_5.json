[{"type": "subtitle", "time": 300.79, "timestamp": "00:05:00", "text": "你随时都可以跟着学习"}, {"type": "subtitle", "time": 303.51, "timestamp": "00:05:03", "text": "。 你好。"}, {"type": "subtitle", "time": 310.31, "timestamp": "00:05:10", "text": "希望你一切都好。"}, {"type": "subtitle", "time": 315.27, "timestamp": "00:05:15", "text": "给我一分钟时间。 让我先"}, {"type": "subtitle", "time": 318.95, "timestamp": "00:05:18", "text": "准备一些东西。"}, {"type": "subtitle", "time": 321.35, "timestamp": "00:05:21", "text": "嗯，稍等一下，我先准备一些"}, {"type": "subtitle", "time": 329.35, "timestamp": "00:05:29", "text": "。 所以我们会使用Anki。 所以接下来"}, {"type": "subtitle", "time": 331.749, "timestamp": "00:05:31", "text": "我要告诉你们我一开始会做什么"}, {"type": "subtitle", "time": 334.71, "timestamp": "00:05:34", "text": "。 我会参加平假名"}, {"type": "subtitle", "time": 339.029, "timestamp": "00:05:39", "text": "片假名测试，就是那个小测验，来"}, {"type": "subtitle", "time": 342.55, "timestamp": "00:05:42", "text": "再次确认我是否能掌握"}, {"type": "subtitle", "time": 345.189, "timestamp": "00:05:45", "text": "基本的平假名片假名，因为这"}, {"type": "subtitle", "time": 348.31, "timestamp": "00:05:48", "text": "对于任何类型的问题都很重要，"}, {"type": "subtitle", "time": 352.87, "timestamp": "00:05:52", "text": "我必须做到这一点，无论如何，正确的"}, {"type": "subtitle", "time": 357.189, "timestamp": "00:05:57", "text": "读音都很重要。嗯，"}, {"type": "subtitle", "time": 359.35, "timestamp": "00:05:59", "text": "还有"}]
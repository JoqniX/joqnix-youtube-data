[{"type": "subtitle", "time": 10084.63, "timestamp": "02:48:04", "text": "伙计他"}, {"type": "subtitle", "time": 10089.67, "timestamp": "02:48:09", "text": "不，等等。 是他吗？ 读作“他”。"}, {"type": "subtitle", "time": 10091.03, "timestamp": "02:48:11", "text": "他。"}, {"type": "subtitle", "time": 10102.23, "timestamp": "02:48:22", "text": "他们要改成 ca 呢？ 等等，"}, {"type": "subtitle", "time": 10106.469, "timestamp": "02:48:26", "text": "你嘴里的牙齿叫什么来着？"}, {"type": "subtitle", "time": 10111.11, "timestamp": "02:48:31", "text": "呃，"}, {"type": "subtitle", "time": 10122.15, "timestamp": "02:48:42", "text": "学会了什么是刷牙"}, {"type": "subtitle", "time": 10130.389, "timestamp": "02:48:50", "text": "牙齿就是牙齿。"}]
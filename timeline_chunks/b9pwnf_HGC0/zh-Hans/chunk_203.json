[{"type": "subtitle", "time": 12201.83, "timestamp": "03:23:21", "text": "娜娜。"}, {"type": "subtitle", "time": 12223.349, "timestamp": "03:23:43", "text": "想象一下滑雪板。 滑雪用的那种滑雪车"}, {"type": "subtitle", "time": 12225.83, "timestamp": "03:23:45", "text": "。 不，他们要去坐"}, {"type": "subtitle", "time": 12227.83, "timestamp": "03:23:47", "text": "缆车。 电缆"}, {"type": "subtitle", "time": 12232.389, "timestamp": "03:23:52", "text": "电缆。 它叫什么？ 电缆车。"}]
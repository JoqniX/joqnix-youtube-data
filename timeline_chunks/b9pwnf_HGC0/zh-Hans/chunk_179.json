[{"type": "subtitle", "time": 10765.349, "timestamp": "02:59:25", "text": "我通常这个时候睡觉。 你好。"}, {"type": "subtitle", "time": 10768.87, "timestamp": "02:59:28", "text": "所以，今天是工作日，对吧？"}, {"type": "subtitle", "time": 10771.349, "timestamp": "02:59:31", "text": "有一个词专门用来形容这种工作日。"}, {"type": "subtitle", "time": 10773.19, "timestamp": "02:59:33", "text": "我忘了，"}, {"type": "subtitle", "time": 10776.389, "timestamp": "02:59:36", "text": "但我真的忘了。 我考虑过这个问题。 我"}, {"type": "subtitle", "time": 10778.79, "timestamp": "02:59:38", "text": "忘了该怎么称呼工作场所"}]
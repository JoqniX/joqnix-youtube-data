[{"type": "subtitle", "time": 10289.67, "timestamp": "02:51:29", "text": "你每天都要练习，不然我会"}, {"type": "subtitle", "time": 10292.71, "timestamp": "02:51:32", "text": "忘记的，说实话。 我"}, {"type": "subtitle", "time": 10297.11, "timestamp": "02:51:37", "text": "应该在今天的直播结束后，"}, {"type": "subtitle", "time": 10301.51, "timestamp": "02:51:41", "text": "睡觉前做“Any Man”这首歌。"}, {"type": "subtitle", "time": 10305.51, "timestamp": "02:51:45", "text": "我真的不想"}, {"type": "subtitle", "time": 10308.499, "timestamp": "02:51:48", "text": "落后。"}, {"type": "subtitle", "time": 10310.55, "timestamp": "02:51:50", "text": "[音乐] 所以，"}, {"type": "subtitle", "time": 10313.51, "timestamp": "02:51:53", "text": "我其实知道我"}, {"type": "subtitle", "time": 10315.83, "timestamp": "02:51:55", "text": "落后了，"}, {"type": "subtitle", "time": 10318.469, "timestamp": "02:51:58", "text": "但我不知道今天为什么会这样。"}]
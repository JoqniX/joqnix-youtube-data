[{"type": "subtitle", "time": 188.39, "timestamp": "00:03:08", "text": "你好。 你好。 你好。 大家好。  Kumbawa。 所以"}, {"type": "subtitle", "time": 191.27, "timestamp": "00:03:11", "text": "今天的直播，我只想说，"}, {"type": "subtitle", "time": 194.149, "timestamp": "00:03:14", "text": "我会全神贯注，"}, {"type": "subtitle", "time": 197.03, "timestamp": "00:03:17", "text": "不受任何干扰。 我希望自己"}, {"type": "subtitle", "time": 199.27, "timestamp": "00:03:19", "text": "不会时不时分心或被其他事情分散注意力"}, {"type": "subtitle", "time": 201.27, "timestamp": "00:03:21", "text": "。  [音乐] 但今天的"}, {"type": "subtitle", "time": 204.07, "timestamp": "00:03:24", "text": "直播我想全身心"}, {"type": "subtitle", "time": 209.91, "timestamp": "00:03:29", "text": "投入，好好"}, {"type": "subtitle", "time": 214.07, "timestamp": "00:03:34", "text": "补习一下N5和"}, {"type": "subtitle", "time": 217.43, "timestamp": "00:03:37", "text": "N4的汉字。 嗯，不管我"}, {"type": "subtitle", "time": 221.27, "timestamp": "00:03:41", "text": "目前学到了什么，明天我还要参加一次"}, {"type": "subtitle", "time": 225.99, "timestamp": "00:03:45", "text": "考核，嗯，考核的时候我必须"}, {"type": "subtitle", "time": 227.91, "timestamp": "00:03:47", "text": "[笑]"}, {"type": "subtitle", "time": 230.55, "timestamp": "00:03:50", "text": "不能作弊，好吗？所以会"}, {"type": "subtitle", "time": 233.03, "timestamp": "00:03:53", "text": "非常严格，我的意思是，这既是为了"}, {"type": "subtitle", "time": 235.43, "timestamp": "00:03:55", "text": "我自己，也是为了大家。"}, {"type": "subtitle", "time": 238.63, "timestamp": "00:03:58", "text": "嗯，这是一次严肃的"}]
[{"type": "subtitle", "time": 21741.19, "timestamp": "06:02:21", "text": "如果你忘了的话，它实际上是"}, {"type": "subtitle", "time": 21746.628, "timestamp": "06:02:26", "text": "沙子，但在底部的线上，"}, {"type": "subtitle", "time": 21752.07, "timestamp": "06:02:32", "text": "沙子里有一条线，两条线。"}, {"type": "subtitle", "time": 21756.788, "timestamp": "06:02:36", "text": "然后又是一只小"}, {"type": "subtitle", "time": 21759.75, "timestamp": "06:02:39", "text": "手。"}, {"type": "subtitle", "time": 21761.43, "timestamp": "06:02:41", "text": "好的。"}, {"type": "subtitle", "time": 21771.83, "timestamp": "06:02:51", "text": "我觉得Ashi这个名字我"}, {"type": "subtitle", "time": 21775.11, "timestamp": "06:02:55", "text": "会忘记。"}, {"type": "subtitle", "time": 21776.788, "timestamp": "06:02:56", "text": "感觉阿什就像是我会"}]
[{"type": "subtitle", "time": 13801.67, "timestamp": "03:50:01", "text": "。"}, {"type": "subtitle", "time": 13805.03, "timestamp": "03:50:05", "text": "呃，和服是服装。 我必须穿"}, {"type": "subtitle", "time": 13807.91, "timestamp": "03:50:07", "text": "它。"}, {"type": "subtitle", "time": 13809.83, "timestamp": "03:50:09", "text": "学习中。 呃，我们在做作业。 我必须在下午"}, {"type": "subtitle", "time": 13814.15, "timestamp": "03:50:14", "text": "6点之前提交。 所以，"}, {"type": "subtitle", "time": 13816.469, "timestamp": "03:50:16", "text": "如果我不这样做，我"}, {"type": "subtitle", "time": 13819.03, "timestamp": "03:50:19", "text": "今天7点的日语课的出勤记录将被"}, {"type": "subtitle", "time": 13823.349, "timestamp": "03:50:23", "text": "记为未到。 我"}, {"type": "subtitle", "time": 13825.429, "timestamp": "03:50:25", "text": "不想那样。 所以我想要"}, {"type": "subtitle", "time": 13828.509, "timestamp": "03:50:28", "text": "全勤。 所以（倒"}, {"type": "subtitle", "time": 13830.15, "timestamp": "03:50:30", "text": "吸一口凉气）这只是对"}, {"type": "subtitle", "time": 13833.03, "timestamp": "03:50:33", "text": "我学过的东西的复习而已。 总结一下"}, {"type": "subtitle", "time": 13835.714, "timestamp": "03:50:35", "text": "。"}]
[{"type": "subtitle", "time": 10577.03, "timestamp": "02:56:17", "text": "就是这样。 嗯？ 卡巴。 我猜我"}, {"type": "subtitle", "time": 10579.99, "timestamp": "02:56:19", "text": "不知道这是什么。 卡巴。 我好像"}, {"type": "subtitle", "time": 10585.67, "timestamp": "02:56:25", "text": "忘了这是什么了。 呃，你好，"}, {"type": "subtitle", "time": 10610.469, "timestamp": "02:56:50", "text": "这就像两次政变，一次离开，一次"}, {"type": "subtitle", "time": 10613.11, "timestamp": "02:56:53", "text": "冷静下来。 不，这是个傻瓜，而且"}, {"type": "subtitle", "time": 10614.55, "timestamp": "02:56:54", "text": "很酷[笑声]"}]
[{"type": "subtitle", "time": 14882.15, "timestamp": "04:08:02", "text": "呃，不，不，等等。 我记得我"}, {"type": "subtitle", "time": 14884.79, "timestamp": "04:08:04", "text": "从午睡中醒来，那天下午"}, {"type": "subtitle", "time": 14887.51, "timestamp": "04:08:07", "text": "没有课，也没有其他安排。 于是我就"}, {"type": "subtitle", "time": 14893.83, "timestamp": "04:08:13", "text": "我喜欢你的声音。"}, {"type": "subtitle", "time": 14897.11, "timestamp": "04:08:17", "text": "这对我意义重大。 只是以前"}, {"type": "subtitle", "time": 14900.95, "timestamp": "04:08:20", "text": "很多人都讨厌我的声音，或者说"}, {"type": "subtitle", "time": 14903.83, "timestamp": "04:08:23", "text": "我总是讨厌我的"}, {"type": "subtitle", "time": 14908.95, "timestamp": "04:08:28", "text": "声音，我的声音经常被人评判。 不过，这让"}, {"type": "subtitle", "time": 14911.91, "timestamp": "04:08:31", "text": "我很高兴，因为确实"}, {"type": "subtitle", "time": 14935.91, "timestamp": "04:08:55", "text": "我当时在干什么？ 我忘了。"}, {"type": "subtitle", "time": 14937.91, "timestamp": "04:08:57", "text": "KJI"}]
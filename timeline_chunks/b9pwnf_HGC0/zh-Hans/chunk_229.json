[{"type": "subtitle", "time": 13744.309, "timestamp": "03:49:04", "text": "你好，御子川。 欢迎光临，先生"}, {"type": "subtitle", "time": 13746.15, "timestamp": "03:49:06", "text": "。好久不见了。"}, {"type": "subtitle", "time": 13747.67, "timestamp": "03:49:07", "text": "你的直播怎么样？ 吉安溪流怎么样"}, {"type": "subtitle", "time": 13755.03, "timestamp": "03:49:15", "text": "呃，雪祭（Yuki Matsuri），雪祭（"}, {"type": "subtitle", "time": 13765.59, "timestamp": "03:49:25", "text": "所以，我得把这个写成汉字。"}, {"type": "subtitle", "time": 13770.469, "timestamp": "03:49:30", "text": "呃，一、二、三。 不，不，不，不。"}, {"type": "subtitle", "time": 13774.95, "timestamp": "03:49:34", "text": "一二三。"}, {"type": "subtitle", "time": 13779.67, "timestamp": "03:49:39", "text": "一、二、三、四、"}, {"type": "subtitle", "time": 13781.51, "timestamp": "03:49:41", "text": "五、"}, {"type": "subtitle", "time": 13783.269, "timestamp": "03:49:43", "text": "六、"}, {"type": "subtitle", "time": 13796.55, "timestamp": "03:49:56", "text": "呃，"}, {"type": "subtitle", "time": 13799.429, "timestamp": "03:49:59", "text": "和服"}]
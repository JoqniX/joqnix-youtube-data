[{"type": "subtitle", "time": 4681.99, "timestamp": "01:18:01", "text": "我明天还要考试。 我的老师"}, {"type": "subtitle", "time": 4684.95, "timestamp": "01:18:04", "text": "会进行一个包含四个汉字的测试。"}, {"type": "subtitle", "time": 4689.35, "timestamp": "01:18:09", "text": "所以我想，如果我想攻克 N4"}, {"type": "subtitle", "time": 4692.07, "timestamp": "01:18:12", "text": "汉字并为明天的考试做好准备，"}, {"type": "subtitle", "time": 4694.79, "timestamp": "01:18:14", "text": "我应该从复习"}, {"type": "subtitle", "time": 4698.229, "timestamp": "01:18:18", "text": "N5 及以后的基础知识开始，包括"}, {"type": "subtitle", "time": 4700.47, "timestamp": "01:18:20", "text": "所有语法内容，以及"}, {"type": "subtitle", "time": 4704.79, "timestamp": "01:18:24", "text": "N5 和 N4 的语法，还有"}, {"type": "subtitle", "time": 4708.79, "timestamp": "01:18:28", "text": "N4 的所有部分，比如连接词"}, {"type": "subtitle", "time": 4712.229, "timestamp": "01:18:32", "text": "和补充说明"}, {"type": "subtitle", "time": 4717.669, "timestamp": "01:18:37", "text": "。"}, {"type": "subtitle", "time": 4720.95, "timestamp": "01:18:40", "text": "呃，它叫什么来着？ 我忘了。"}, {"type": "subtitle", "time": 4724.63, "timestamp": "01:18:44", "text": "潜在形式。 我的天啊，那东西。"}, {"type": "subtitle", "time": 4727.35, "timestamp": "01:18:47", "text": "潜在形式。"}, {"type": "subtitle", "time": 4730.47, "timestamp": "01:18:50", "text": "我亲爱的呃，"}, {"type": "subtitle", "time": 4732.47, "timestamp": "01:18:52", "text": "所有那些联系方面的东西。 是的。"}, {"type": "subtitle", "time": 4734.39, "timestamp": "01:18:54", "text": "语法等等。 所以今天的节目"}, {"type": "subtitle", "time": 4738.07, "timestamp": "01:18:58", "text": "对我来说基本上是全面复习。 所以我"}]
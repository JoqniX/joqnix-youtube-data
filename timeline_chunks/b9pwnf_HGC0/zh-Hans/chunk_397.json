[{"type": "subtitle", "time": 23822.628, "timestamp": "06:37:02", "text": "二的水平。"}, {"type": "subtitle", "time": 23824.548, "timestamp": "06:37:04", "text": "作为哥哥，你有什么"}, {"type": "subtitle", "time": 23837.03, "timestamp": "06:37:17", "text": "去做自己喜欢的事情。 我觉得如果你"}, {"type": "subtitle", "time": 23839.35, "timestamp": "06:37:19", "text": "感到筋疲力尽之类的，那就去做你的"}, {"type": "subtitle", "time": 23842.31, "timestamp": "06:37:22", "text": "爱好吧。 看电影或者做任何你"}, {"type": "subtitle", "time": 23845.03, "timestamp": "06:37:25", "text": "喜欢的事情。 听音乐。 如果你喜欢"}, {"type": "subtitle", "time": 23847.83, "timestamp": "06:37:27", "text": "玩游戏什么的，那就去玩吧"}, {"type": "subtitle", "time": 23850.07, "timestamp": "06:37:30", "text": "。 不管是什么，"}, {"type": "subtitle", "time": 23852.23, "timestamp": "06:37:32", "text": "不管是什么让"}, {"type": "subtitle", "time": 23854.07, "timestamp": "06:37:34", "text": "你快乐的爱好。"}, {"type": "subtitle", "time": 23856.628, "timestamp": "06:37:36", "text": "即使是暂时的，"}, {"type": "subtitle", "time": 23858.948, "timestamp": "06:37:38", "text": "如果它能让你感到快乐，比如你可以"}, {"type": "subtitle", "time": 23860.948, "timestamp": "06:37:40", "text": "奖励自己，"}, {"type": "subtitle", "time": 23863.35, "timestamp": "06:37:43", "text": "比如因为你"}, {"type": "subtitle", "time": 23866.23, "timestamp": "06:37:46", "text": "工作很努力而买个冰淇淋。 不，"}, {"type": "subtitle", "time": 23870.788, "timestamp": "06:37:50", "text": "你可以奖励自己，对吧？"}, {"type": "subtitle", "time": 23872.948, "timestamp": "06:37:52", "text": "就是这样。 如果你压力很大，可以这样做"}]
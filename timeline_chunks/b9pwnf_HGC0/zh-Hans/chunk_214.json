[{"type": "subtitle", "time": 12841.429, "timestamp": "03:34:01", "text": "不是4月1日。4月1日我必须抵达"}, {"type": "subtitle", "time": 12845.269, "timestamp": "03:34:05", "text": "日本。 所以我在想，"}, {"type": "subtitle", "time": 12847.83, "timestamp": "03:34:07", "text": "我是不是应该做一个可以用的摄像头，因为我"}, {"type": "subtitle", "time": 12850.63, "timestamp": "03:34:10", "text": "没有相机之类的东西。 我可以用"}, {"type": "subtitle", "time": 12855.11, "timestamp": "03:34:15", "text": "手机拍些东西，比如在机场拍vlog之类的，还有像"}, {"type": "subtitle", "time": 12866.95, "timestamp": "03:34:26", "text": "3月28日、29日那天我收拾行李，跟我的电脑告别之类的。 我的"}, {"type": "subtitle", "time": 12869.99, "timestamp": "03:34:29", "text": "意思是，我们会"}, {"type": "subtitle", "time": 12873.11, "timestamp": "03:34:33", "text": "在三月份的那天进行最后一次直播。"}, {"type": "subtitle", "time": 12875.67, "timestamp": "03:34:35", "text": "所以，[笑声]我想录制"}, {"type": "subtitle", "time": 12877.99, "timestamp": "03:34:37", "text": "vlog。"}, {"type": "subtitle", "time": 12880.95, "timestamp": "03:34:40", "text": "我想录制vlog。 我第一次去"}, {"type": "subtitle", "time": 12883.75, "timestamp": "03:34:43", "text": "日本。 但是，但是，但是"}, {"type": "subtitle", "time": 12886.309, "timestamp": "03:34:46", "text": "现在我的同学们还不"}, {"type": "subtitle", "time": 12888.79, "timestamp": "03:34:48", "text": "知道我是个油管博主。 他们可能会说出"}, {"type": "subtitle", "time": 12898.71, "timestamp": "03:34:58", "text": "所以我想我得先录下来，"}]
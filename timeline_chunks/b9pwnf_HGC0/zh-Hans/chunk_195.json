[{"type": "subtitle", "time": 11712.15, "timestamp": "03:15:12", "text": "不敢相信我竟然忘了。"}, {"type": "subtitle", "time": 11714.63, "timestamp": "03:15:14", "text": "你知道，我的问题在于我没有"}, {"type": "subtitle", "time": 11718.075, "timestamp": "03:15:18", "text": "练习。 我现在很痛苦。"}, {"type": "subtitle", "time": 11718.95, "timestamp": "03:15:18", "text": "[清嗓子]"}, {"type": "subtitle", "time": 11722.63, "timestamp": "03:15:22", "text": "如果我真的"}, {"type": "subtitle", "time": 11726.309, "timestamp": "03:15:26", "text": "每天都练习这个，我"}, {"type": "subtitle", "time": 11728.63, "timestamp": "03:15:28", "text": "现在就不会受苦了。"}, {"type": "subtitle", "time": 11732.229, "timestamp": "03:15:32", "text": "但现在看看我。  [清嗓子]"}, {"type": "subtitle", "time": 11740.79, "timestamp": "03:15:40", "text": "因为我没练习，"}, {"type": "subtitle", "time": 11743.51, "timestamp": "03:15:43", "text": "对吧？ 这对我来说就像一记警钟"}, {"type": "subtitle", "time": 11748.389, "timestamp": "03:15:48", "text": "。 我觉得就像因为……不，想象一下"}, {"type": "subtitle", "time": 11751.51, "timestamp": "03:15:51", "text": "我会这么说。 就像我"}, {"type": "subtitle", "time": 11755.11, "timestamp": "03:15:55", "text": "真正去日本的时候一样，嗯，我到了那里之后，"}, {"type": "subtitle", "time": 11757.59, "timestamp": "03:15:57", "text": "语言学校可能会"}]
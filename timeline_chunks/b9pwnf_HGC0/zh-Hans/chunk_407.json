[{"type": "subtitle", "time": 24429.19, "timestamp": "06:47:09", "text": "拉屎。"}, {"type": "subtitle", "time": 24432.31, "timestamp": "06:47:12", "text": "我的天啊。"}, {"type": "subtitle", "time": 24435.51, "timestamp": "06:47:15", "text": "所以40。不，不，不。"}, {"type": "subtitle", "time": 24439.11, "timestamp": "06:47:19", "text": "30. 不，等等。 是30吗？ 我忘了。  1 2 3 4 5 6 4 5 6 7 8"}, {"type": "subtitle", "time": 24448.468, "timestamp": "06:47:28", "text": "7 8 9 10。所以这边是 40 41"}, {"type": "subtitle", "time": 24451.43, "timestamp": "06:47:31", "text": "42"}, {"type": "subtitle", "time": 24461.91, "timestamp": "06:47:41", "text": "我们把它变成 50。好的。 南"}, {"type": "subtitle", "time": 24475.99, "timestamp": "06:47:55", "text": "企鹅，"}, {"type": "subtitle", "time": 24478.868, "timestamp": "06:47:58", "text": "一只企鹅父母很高兴，它的孩子站在"}]
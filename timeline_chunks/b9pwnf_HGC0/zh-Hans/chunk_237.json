[{"type": "subtitle", "time": 14220.469, "timestamp": "03:57:00", "text": "为什么我的钥匙看起来这么"}, {"type": "subtitle", "time": 14222.07, "timestamp": "03:57:02", "text": "普通"}, {"type": "subtitle", "time": 14223.91, "timestamp": "03:57:03", "text": "？"}, {"type": "subtitle", "time": 14231.189, "timestamp": "03:57:11", "text": "看到了这一幕。 好的，下一页。 快点。"}, {"type": "subtitle", "time": 14243.03, "timestamp": "03:57:23", "text": "呃，"}, {"type": "subtitle", "time": 14269.67, "timestamp": "03:57:49", "text": "我做过。 这是什么？"}, {"type": "subtitle", "time": 14273.03, "timestamp": "03:57:53", "text": "不要将 so 与名词连用。 好的。"}, {"type": "subtitle", "time": 14279.51, "timestamp": "03:57:59", "text": "到"}]
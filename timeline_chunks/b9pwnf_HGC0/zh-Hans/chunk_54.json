[{"type": "subtitle", "time": 3247.03, "timestamp": "00:54:07", "text": "拉怎么样了？ 我的天哪，我竟然忘了"}, {"type": "subtitle", "time": 3249.43, "timestamp": "00:54:09", "text": "基本功。 好吧，现在到底是怎么回事？"}, {"type": "subtitle", "time": 3252.069, "timestamp": "00:54:12", "text": "等等，等等，等等，等等，等等，等等。 如何？"}, {"type": "subtitle", "time": 3253.349, "timestamp": "00:54:13", "text": "等等，那不一样。 这是"}, {"type": "subtitle", "time": 3255.99, "timestamp": "00:54:15", "text": "不同的汉字。 哦。 如何撰写"}, {"type": "subtitle", "time": 3275.682, "timestamp": "00:54:35", "text": "如何？ 等待。 我的天啊。 别告诉我。"}, {"type": "subtitle", "time": 3277.03, "timestamp": "00:54:37", "text": "[笑声和惊呼]"}, {"type": "subtitle", "time": 3279.67, "timestamp": "00:54:39", "text": "下一个是乔。 你现在连基本功都忘了吗？"}, {"type": "chat", "time": 3289.705, "timestamp": "00:54:49", "author": "@hbvcsa", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mA5iYFWQWr-erQfOrpRSPi7uAL1ykOBKRSbPBDp88Z1xyBT7Je5IKp6_AckwgwsDEc-Q=s64-c-k-c0x00ffffff-no-rj", "message": "ろく"}, {"type": "subtitle", "time": 3290.069, "timestamp": "00:54:50", "text": "[叹气]我的"}, {"type": "subtitle", "time": 3292.309, "timestamp": "00:54:52", "text": "天哪。 我向上帝发誓，我要自杀"}, {"type": "subtitle", "time": 3294.23, "timestamp": "00:54:54", "text": "。"}]
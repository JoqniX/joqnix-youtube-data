[{"type": "subtitle", "time": 2400.31, "timestamp": "00:40:00", "text": "杆。 现在是凌晨4点。凌晨"}, {"type": "subtitle", "time": 2404.15, "timestamp": "00:40:04", "text": "4点。我们拉开窗帘吧。"}, {"type": "subtitle", "time": 2406.87, "timestamp": "00:40:06", "text": "哦，那太酷了。 他们举例说明，"}, {"type": "subtitle", "time": 2409.91, "timestamp": "00:40:09", "text": "比如“好吧，让我再说一遍”"}, {"type": "subtitle", "time": 2412.39, "timestamp": "00:40:12", "text": "。 呃，（笑声）"}, {"type": "subtitle", "time": 2415.99, "timestamp": "00:40:15", "text": "拉开窗帘。 所以，努力奋斗吧。 一、"}, {"type": "subtitle", "time": 2418.15, "timestamp": "00:40:18", "text": "二、"}, {"type": "subtitle", "time": 2419.75, "timestamp": "00:40:19", "text": "三、"}, {"type": "subtitle", "time": 2422.55, "timestamp": "00:40:22", "text": "四、五。   对"}, {"type": "subtitle", "time": 2425.43, "timestamp": "00:40:25", "text": "，一样。 我"}, {"type": "subtitle", "time": 2427.51, "timestamp": "00:40:27", "text": "下次写的时候，也就是"}, {"type": "subtitle", "time": 2431.51, "timestamp": "00:40:31", "text": "修改第五遍的时候，就可以把它改正了。 不行。"}, {"type": "subtitle", "time": 2434.87, "timestamp": "00:40:34", "text": "你好。 我们走吧。"}, {"type": "subtitle", "time": 2435.67, "timestamp": "00:40:35", "text": "五。"}, {"type": "subtitle", "time": 2437.27, "timestamp": "00:40:37", "text": "去。"}, {"type": "subtitle", "time": 2438.583, "timestamp": "00:40:38", "text": "好的。  [笑声]"}, {"type": "subtitle", "time": 2451.75, "timestamp": "00:40:51", "text": "太阳。"}]
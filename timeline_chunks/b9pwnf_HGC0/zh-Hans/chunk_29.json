[{"type": "subtitle", "time": 1742.63, "timestamp": "00:29:02", "text": "不要保存，直接关闭窗口。"}, {"type": "subtitle", "time": 1764.63, "timestamp": "00:29:24", "text": "你好。 第一个痒。"}, {"type": "subtitle", "time": 1767.909, "timestamp": "00:29:27", "text": "很简单。 呃，让我来"}, {"type": "subtitle", "time": 1772.95, "timestamp": "00:29:32", "text": "拿笔。 第一个痒。"}, {"type": "subtitle", "time": 1785.669, "timestamp": "00:29:45", "text": "我应该把笔的尺寸调小一些吗？ 我不"}, {"type": "subtitle", "time": 1789.59, "timestamp": "00:29:49", "text": "知道。 发痒。 呃，我用"}, {"type": "subtitle", "time": 1792.95, "timestamp": "00:29:52", "text": "日语写吧。 另外，我好像用错"}, {"type": "subtitle", "time": 1795.43, "timestamp": "00:29:55", "text": "工具了。   好了"}]
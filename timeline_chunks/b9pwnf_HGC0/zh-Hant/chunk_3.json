[{"type": "subtitle", "time": 188.39, "timestamp": "00:03:08", "text": "你好。你好。你好。大家好。 Kumbawa。所以"}, {"type": "subtitle", "time": 191.27, "timestamp": "00:03:11", "text": "今天的直播，我只想說，"}, {"type": "subtitle", "time": 194.149, "timestamp": "00:03:14", "text": "我會全神貫注，"}, {"type": "subtitle", "time": 197.03, "timestamp": "00:03:17", "text": "不受任何干擾。我希望自己"}, {"type": "subtitle", "time": 199.27, "timestamp": "00:03:19", "text": "不會時不時分心或被其他事情分散注意力"}, {"type": "subtitle", "time": 201.27, "timestamp": "00:03:21", "text": "。 [音樂] 但今天的"}, {"type": "subtitle", "time": 204.07, "timestamp": "00:03:24", "text": "直播我想全心"}, {"type": "subtitle", "time": 209.91, "timestamp": "00:03:29", "text": "投入，好好"}, {"type": "subtitle", "time": 214.07, "timestamp": "00:03:34", "text": "補習N5和"}, {"type": "subtitle", "time": 217.43, "timestamp": "00:03:37", "text": "N4的漢字。嗯，不管我"}, {"type": "subtitle", "time": 221.27, "timestamp": "00:03:41", "text": "目前學到了什麼，明天還要參加一次"}, {"type": "subtitle", "time": 225.99, "timestamp": "00:03:45", "text": "考核，嗯，考核的時候我"}, {"type": "subtitle", "time": 227.91, "timestamp": "00:03:47", "text": "必須[笑]"}, {"type": "subtitle", "time": 230.55, "timestamp": "00:03:50", "text": "不能作弊，好嗎？所以會"}, {"type": "subtitle", "time": 233.03, "timestamp": "00:03:53", "text": "非常嚴格，我的意思是，這既是"}, {"type": "subtitle", "time": 235.43, "timestamp": "00:03:55", "text": "為了我自己，也是為了大家。"}, {"type": "subtitle", "time": 238.63, "timestamp": "00:03:58", "text": "嗯，這是一場嚴肅的"}]
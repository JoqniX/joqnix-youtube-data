[{"type": "subtitle", "time": 3960.39, "timestamp": "01:06:00", "text": "我每週都這樣做，"}, {"type": "subtitle", "time": 3974.71, "timestamp": "01:06:14", "text": "我的天哪。  嗯，搖滾樂。  再一次。岩石。  所以，就從頭開始吧。  是的。她或你，然後走，底部會更大。一、二、三。  做出正確的筆畫。別搞砸了。  你誤解了她的意思。  這蜂蜜。"}, {"type": "chat", "time": 3978.29, "timestamp": "01:06:18", "author": "@hbvcsa", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mA5iYFWQWr-erQfOrpRSPi7uAL1ykOBKRSbPBDp88Z1xyBT7Je5IKp6_AckwgwsDEc-Q=s64-c-k-c0x00ffffff-no-rj", "message": "The Nana is used here"}, {"type": "subtitle", "time": 4006.87, "timestamp": "01:06:46", "text": "等等，等等，等等。  像這樣。"}, {"type": "chat", "time": 4018.203, "timestamp": "01:06:58", "author": "@hbvcsa", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mA5iYFWQWr-erQfOrpRSPi7uAL1ykOBKRSbPBDp88Z1xyBT7Je5IKp6_AckwgwsDEc-Q=s64-c-k-c0x00ffffff-no-rj", "message": "How many months are you learning japanese "}]
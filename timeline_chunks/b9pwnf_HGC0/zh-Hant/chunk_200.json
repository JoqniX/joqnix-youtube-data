[{"type": "subtitle", "time": 12012.07, "timestamp": "03:20:12", "text": "練習基礎詞彙"}, {"type": "subtitle", "time": 12015.269, "timestamp": "03:20:15", "text": "和基礎知識，因為我最近退步了。他覺得我跟不上進度，連基本功都沒掌握好。"}, {"type": "subtitle", "time": 12018.07, "timestamp": "03:20:18", "text": "所以這讓我感覺就像是… 或者他確實注意到了 YouTube 上的 Hender King。"}]
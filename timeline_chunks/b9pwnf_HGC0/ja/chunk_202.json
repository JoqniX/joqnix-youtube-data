[{"type": "subtitle", "time": 12120.229, "timestamp": "03:22:00", "text": "。 ありがとう。"}, {"type": "subtitle", "time": 12143.59, "timestamp": "03:22:23", "text": "さて、質問ですが、皆さんも"}, {"type": "subtitle", "time": 12145.67, "timestamp": "03:22:25", "text": "お気づきかもしれませんが、"}, {"type": "subtitle", "time": 12147.99, "timestamp": "03:22:27", "text": "漢字を練習するたびに、1"}, {"type": "subtitle", "time": 12150.95, "timestamp": "03:22:30", "text": "から10まで、これまで習った漢字を全部書いています。全部です。100個全部"}, {"type": "subtitle", "time": 12155.62, "timestamp": "03:22:35", "text": "書けると思いますか？"}, {"type": "subtitle", "time": 12158.71, "timestamp": "03:22:38", "text": "[笑い] もしそれができたら、"}, {"type": "subtitle", "time": 12165.67, "timestamp": "03:22:45", "text": "ええ、すごく上手になります。Hを"}]
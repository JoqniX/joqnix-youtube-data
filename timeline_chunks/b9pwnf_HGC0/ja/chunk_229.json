[{"type": "subtitle", "time": 13744.309, "timestamp": "03:49:04", "text": "こんにちは、ミコサ・カワさん。 ようこそ、ようこそ。久しぶりだね。"}, {"type": "subtitle", "time": 13747.67, "timestamp": "03:49:07", "text": "配信はどうでしたか？ ジャンの配信はどうでしたか"}, {"type": "subtitle", "time": 13755.03, "timestamp": "03:49:15", "text": "ああ、"}, {"type": "subtitle", "time": 13765.59, "timestamp": "03:49:25", "text": "だから私はこれの漢字をやらなければならない。   えーっと"}, {"type": "subtitle", "time": 13770.469, "timestamp": "03:49:30", "text": "、１、２、３。 いや、いや、いや、いや。"}, {"type": "subtitle", "time": 13774.95, "timestamp": "03:49:34", "text": "1 2 3。"}, {"type": "subtitle", "time": 13779.67, "timestamp": "03:49:39", "text": "１、２、３、４、５、６、７"}, {"type": "subtitle", "time": 13796.55, "timestamp": "03:49:56", "text": "えー、着物の"}]
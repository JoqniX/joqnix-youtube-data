[{"type": "subtitle", "time": 6150.149, "timestamp": "01:42:30", "text": "アルファといった感じ。 わかった。 選択を解除する方法はありますか"}, {"type": "subtitle", "time": 6155.03, "timestamp": "01:42:35", "text": "？ 選択を解除します。  Ctrl D。Ctrl D。"}, {"type": "subtitle", "time": 6157.669, "timestamp": "01:42:37", "text": "コントロール D。"}, {"type": "subtitle", "time": 6160.55, "timestamp": "01:42:40", "text": "レイヤーの選択を解除できません。 はぁ？"}, {"type": "subtitle", "time": 6174.629, "timestamp": "01:42:54", "text": "待って。 ピクセルレイヤーはどのように作成すればよいですか？"}]
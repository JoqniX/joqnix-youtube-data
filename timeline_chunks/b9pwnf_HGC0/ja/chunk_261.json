[{"type": "subtitle", "time": 15686.87, "timestamp": "04:21:26", "text": "土壌。   わかった"}, {"type": "subtitle", "time": 15691.83, "timestamp": "04:21:31", "text": "。  １、２。 わかった。 彼らは"}, {"type": "subtitle", "time": 15697.189, "timestamp": "04:21:37", "text": "まずB評価を取る。 待って。 ええと、まずはユダヤ人から。"}, {"type": "subtitle", "time": 15700.149, "timestamp": "04:21:40", "text": "まずユダヤ人を一人、それから底なしのものを。"}, {"type": "subtitle", "time": 15702.79, "timestamp": "04:21:42", "text": "ユダヤ人優先、底なし。 はい、その通りです"}, {"type": "subtitle", "time": 15704.79, "timestamp": "04:21:44", "text": "。   一番"}, {"type": "subtitle", "time": 15707.75, "timestamp": "04:21:47", "text": "下。   結論としては、非常に"}]
[{"type": "chat", "time": 15300.545, "timestamp": "04:15:00", "author": "@flashviw", "avatar": "https://yt4.ggpht.com/d1WTGgfPtW7_sl9efHQ_Ga29Lah54vpMfoZ_durx2CFvIyyv4Gt_RzY9BtF3n3wTp5Yp3DOBFw=s64-c-k-c0x00ffffff-no-rj", "message": "Gotcha"}, {"type": "subtitle", "time": 15303.91, "timestamp": "04:15:03", "text": "最近サミーのコーディングとかゲーム配信をしていなかったら、"}, {"type": "subtitle", "time": 15306.79, "timestamp": "04:15:06", "text": "音楽制作の配信をしたり"}, {"type": "subtitle", "time": 15309.51, "timestamp": "04:15:09", "text": "練習したりできたのに、それが私の"}, {"type": "subtitle", "time": 15312.55, "timestamp": "04:15:12", "text": "好きな趣味の一つなのに、"}, {"type": "subtitle", "time": 15317.349, "timestamp": "04:15:17", "text": "バカみたいに先延ばしにしてしまって、それが"}, {"type": "subtitle", "time": 15320.149, "timestamp": "04:15:20", "text": "嫌なんです。"}, {"type": "subtitle", "time": 15323.83, "timestamp": "04:15:23", "text": "趣味があっても、つい先延ばしにしてしまい、結局何もやらないんです"}, {"type": "subtitle", "time": 15328.63, "timestamp": "04:15:28", "text": "。"}, {"type": "subtitle", "time": 15330.87, "timestamp": "04:15:30", "text": "言語を学んだり、楽器を習ったりするのと同じで、"}, {"type": "subtitle", "time": 15332.95, "timestamp": "04:15:32", "text": "最低でも1時間も時間を割けなければ"}, {"type": "subtitle", "time": 15335.67, "timestamp": "04:15:35", "text": "、結局は行き詰まってしまうでしょう"}, {"type": "subtitle", "time": 15338.229, "timestamp": "04:15:38", "text": "。 いや、そうすると世間から取り残されたような気分になるだろう"}, {"type": "subtitle", "time": 15340.63, "timestamp": "04:15:40", "text": "？ それは"}, {"type": "subtitle", "time": 15343.99, "timestamp": "04:15:43", "text": "日本人にも起こったことだ。 私は日本語を学ぶのが大好きです"}, {"type": "subtitle", "time": 15354.95, "timestamp": "04:15:54", "text": "日本に行く予定で、"}, {"type": "subtitle", "time": 15357.83, "timestamp": "04:15:57", "text": "この会社にも立ち寄りました。"}]
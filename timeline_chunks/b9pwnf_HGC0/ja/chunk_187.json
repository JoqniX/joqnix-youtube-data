[{"type": "subtitle", "time": 11227.349, "timestamp": "03:07:07", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 11235.429, "timestamp": "03:07:15", "text": "。 どうして忘れられるだろうか？   私は"}, {"type": "subtitle", "time": 11237.99, "timestamp": "03:07:17", "text": "すべてを忘れてしまった。"}, {"type": "subtitle", "time": 11241.91, "timestamp": "03:07:21", "text": "私は一体どうしたんだろう？ これは、私が5分でクリアしたということです。   私をからかってるの"}, {"type": "subtitle", "time": 11261.11, "timestamp": "03:07:41", "text": "ええと、7月と10月。 やあ、10月。"}, {"type": "subtitle", "time": 11263.349, "timestamp": "03:07:43", "text": "12月、7月。"}]
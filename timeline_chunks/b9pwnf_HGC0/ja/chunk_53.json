[{"type": "chat", "time": 3180.839, "timestamp": "00:53:00", "author": "@hbvcsa", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mA5iYFWQWr-erQfOrpRSPi7uAL1ykOBKRSbPBDp88Z1xyBT7Je5IKp6_AckwgwsDEc-Q=s64-c-k-c0x00ffffff-no-rj", "message": "Roku "}, {"type": "subtitle", "time": 3184.39, "timestamp": "00:53:04", "text": "練習も復習も全くしないなんて、すごく羨ましいと思うんです。"}, {"type": "subtitle", "time": 3187.03, "timestamp": "00:53:07", "text": "それが私の弱点です。"}, {"type": "subtitle", "time": 3190.23, "timestamp": "00:53:10", "text": "ロ。 よし。 次はRokuです。"}, {"type": "subtitle", "time": 3193.19, "timestamp": "00:53:13", "text": "ピクニック。"}, {"type": "subtitle", "time": 3196.23, "timestamp": "00:53:16", "text": "ああ、テーブルだよ（笑）"}, {"type": "subtitle", "time": 3200.15, "timestamp": "00:53:20", "text": "。 わかったよ、ロー。 それを隠させてください。"}, {"type": "subtitle", "time": 3203.109, "timestamp": "00:53:23", "text": "そして（歌いながら）さあ、"}, {"type": "subtitle", "time": 3220.47, "timestamp": "00:53:40", "text": "行を再度書き込むにはどうすればいいですか？ えっと、"}, {"type": "subtitle", "time": 3223.99, "timestamp": "00:53:43", "text": "ロマニ語の"}, {"type": "chat", "time": 3227.072, "timestamp": "00:53:47", "author": "@hbvcsa", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mA5iYFWQWr-erQfOrpRSPi7uAL1ykOBKRSbPBDp88Z1xyBT7Je5IKp6_AckwgwsDEc-Q=s64-c-k-c0x00ffffff-no-rj", "message": "Roku has 4 Strokes"}, {"type": "subtitle", "time": 3231.19, "timestamp": "00:53:51", "text": "ええと、"}, {"type": "subtitle", "time": 3233.349, "timestamp": "00:53:53", "text": "Roには4つのストロークがあります。  １、２、３、４"}, {"type": "subtitle", "time": 3236.309, "timestamp": "00:53:56", "text": "。 こんにちは。   わかった"}]
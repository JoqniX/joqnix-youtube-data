[{"type": "subtitle", "time": 14882.15, "timestamp": "04:08:02", "text": "、いや、待って。"}, {"type": "subtitle", "time": 14884.79, "timestamp": "04:08:04", "text": "昼寝から目が覚めたら、"}, {"type": "subtitle", "time": 14887.51, "timestamp": "04:08:07", "text": "授業も何もなかったのを覚えている。 それで私はそれを始めた"}, {"type": "subtitle", "time": 14893.83, "timestamp": "04:08:13", "text": "あなたの声が大好きです。"}, {"type": "subtitle", "time": 14897.11, "timestamp": "04:08:17", "text": "それは私にとってとても大きな意味があります。 ただ、以前は"}, {"type": "subtitle", "time": 14900.95, "timestamp": "04:08:20", "text": "多くの人が私の声を嫌っていたし、"}, {"type": "subtitle", "time": 14903.83, "timestamp": "04:08:23", "text": "私はいつも"}, {"type": "subtitle", "time": 14908.95, "timestamp": "04:08:28", "text": "自分の声についてよく批判されていました。 でも、"}, {"type": "subtitle", "time": 14935.91, "timestamp": "04:08:55", "text": "私は何をしていたんだっけ？ 忘れた。"}, {"type": "subtitle", "time": 14937.91, "timestamp": "04:08:57", "text": "KJI kji kji kji。"}]
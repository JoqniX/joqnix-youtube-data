[{"type": "subtitle", "time": 4625.99, "timestamp": "01:17:05", "text": "。 何てことだ"}, {"type": "subtitle", "time": 4628.07, "timestamp": "01:17:08", "text": "。"}, {"type": "subtitle", "time": 4630.709, "timestamp": "01:17:10", "text": "うん。 バー。"}, {"type": "subtitle", "time": 4633.91, "timestamp": "01:17:13", "text": "でも今は12月ですよ。   いや"}, {"type": "subtitle", "time": 4636.229, "timestamp": "01:17:16", "text": "、待てよ、まだ12月じゃないけど、"}, {"type": "subtitle", "time": 4639.35, "timestamp": "01:17:19", "text": "もっと寒くなるはずなんだ。 いや、違うよ"}, {"type": "subtitle", "time": 4641.43, "timestamp": "01:17:21", "text": "。 雨が降れば、"}, {"type": "subtitle", "time": 4650.47, "timestamp": "01:17:30", "text": "あなたはN5を学習しています。 えっと、"}, {"type": "subtitle", "time": 4654.47, "timestamp": "01:17:34", "text": "N5の練習をしているところです。というのも、最近ちょっと調子が落ちてきているんです。"}, {"type": "subtitle", "time": 4658.31, "timestamp": "01:17:38", "text": "私は現在"}, {"type": "chat", "time": 4658.469, "timestamp": "01:17:38", "author": "@hbvcsa", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mA5iYFWQWr-erQfOrpRSPi7uAL1ykOBKRSbPBDp88Z1xyBT7Je5IKp6_AckwgwsDEc-Q=s64-c-k-c0x00ffffff-no-rj", "message": "Rahura is your name"}, {"type": "subtitle", "time": 4662.229, "timestamp": "01:17:42", "text": "N4を勉強しています。 えっと、基本を忘れちゃった。"}, {"type": "subtitle", "time": 4666.47, "timestamp": "01:17:46", "text": "練習してなかったから、えっと、"}, {"type": "subtitle", "time": 4673.11, "timestamp": "01:17:53", "text": "全然練習してなかったから。"}, {"type": "subtitle", "time": 4675.75, "timestamp": "01:17:55", "text": "だから、基礎からやり直して"}, {"type": "subtitle", "time": 4678.63, "timestamp": "01:17:58", "text": "追いつこうと思ったんです。 それに"}]
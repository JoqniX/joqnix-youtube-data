[{"type": "subtitle", "time": 11712.15, "timestamp": "03:15:12", "text": "ない。"}, {"type": "subtitle", "time": 11714.63, "timestamp": "03:15:14", "text": "私の場合、問題は"}, {"type": "subtitle", "time": 11718.075, "timestamp": "03:15:18", "text": "練習をしなかったことなんです。 今、私は苦しんでいる。"}, {"type": "subtitle", "time": 11718.95, "timestamp": "03:15:18", "text": "[咳払い]"}, {"type": "subtitle", "time": 11722.63, "timestamp": "03:15:22", "text": "もし私が"}, {"type": "subtitle", "time": 11726.309, "timestamp": "03:15:26", "text": "これを毎日実際に練習していたら、今頃こんな"}, {"type": "subtitle", "time": 11728.63, "timestamp": "03:15:28", "text": "苦しみを味わっていなかったでしょう。"}, {"type": "subtitle", "time": 11732.229, "timestamp": "03:15:32", "text": "でも今の私を見てください。  [咳払い] 苦しそうにしている"}, {"type": "subtitle", "time": 11740.79, "timestamp": "03:15:40", "text": "だって、練習してなかったんだもんよね"}, {"type": "subtitle", "time": 11743.51, "timestamp": "03:15:43", "text": "？ これは"}, {"type": "subtitle", "time": 11748.389, "timestamp": "03:15:48", "text": "私にとって、まるで目覚めの合図のようなものだ。 だって、だって、いや、"}, {"type": "subtitle", "time": 11751.51, "timestamp": "03:15:51", "text": "私がこう言うと想像してみて。"}, {"type": "subtitle", "time": 11755.11, "timestamp": "03:15:55", "text": "実際に日本に行ったときも同じように、"}, {"type": "subtitle", "time": 11757.59, "timestamp": "03:15:57", "text": "おそらく語学学校で"}]
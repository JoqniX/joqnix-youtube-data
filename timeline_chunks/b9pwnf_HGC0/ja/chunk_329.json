[{"type": "subtitle", "time": 19765.91, "timestamp": "05:29:25", "text": "はい、その通りです。 わかった。 わかった。  20."}, {"type": "subtitle", "time": 19768.948, "timestamp": "05:29:28", "text": "待つ。  10 20"}, {"type": "subtitle", "time": 19771.83, "timestamp": "05:29:31", "text": "30。つまり、100個のうち30個のキーを食べ終えたということです。"}, {"type": "subtitle", "time": 19779.19, "timestamp": "05:29:39", "text": "ああ、なんてことだ。  100点満点中30点。"}, {"type": "subtitle", "time": 19789.27, "timestamp": "05:29:49", "text": "、もう11時だ。"}, {"type": "subtitle", "time": 19793.03, "timestamp": "05:29:53", "text": "最初の30分間は配信していたのに、まだ"}, {"type": "subtitle", "time": 19796.47, "timestamp": "05:29:56", "text": "終わってない。"}]
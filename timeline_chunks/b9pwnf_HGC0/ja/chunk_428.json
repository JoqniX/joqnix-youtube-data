[{"type": "subtitle", "time": 25680.07, "timestamp": "07:08:00", "text": "女性でしょう。   何てことだ"}, {"type": "subtitle", "time": 25682.23, "timestamp": "07:08:02", "text": "。"}, {"type": "subtitle", "time": 25685.35, "timestamp": "07:08:05", "text": "私は死ぬだろう。"}, {"type": "subtitle", "time": 25695.91, "timestamp": "07:08:15", "text": "文字を書いた後、指がすごく痛い。 もう"}, {"type": "subtitle", "time": 25699.03, "timestamp": "07:08:19", "text": "7時間も書き続けているんです。"}, {"type": "subtitle", "time": 25702.948, "timestamp": "07:08:22", "text": "さよなら。 では、"}, {"type": "subtitle", "time": 25707.59, "timestamp": "07:08:27", "text": "北の次には何があるのでしょうか？ エマです。 そしてシューは"}, {"type": "subtitle", "time": 25709.59, "timestamp": "07:08:29", "text": "弱くなる。"}, {"type": "subtitle", "time": 25713.59, "timestamp": "07:08:33", "text": "それから、myi nan"}, {"type": "subtitle", "time": 25715.91, "timestamp": "07:08:35", "text": "jak"}, {"type": "subtitle", "time": 25721.99, "timestamp": "07:08:41", "text": "then this one is minute"}, {"type": "subtitle", "time": 25726.15, "timestamp": "07:08:46", "text": "ni itchi. ああ、そうだよ。"}]
[{"type": "subtitle", "time": 18481.99, "timestamp": "05:08:01", "text": "それが"}, {"type": "subtitle", "time": 18484.55, "timestamp": "05:08:04", "text": "実現可能な機会かどうかは分かりませんが、そうなると"}, {"type": "subtitle", "time": 18487.03, "timestamp": "05:08:07", "text": "次に仕事を辞めなければならなくなるでしょう。 私はそれを望んでいません"}, {"type": "subtitle", "time": 18489.27, "timestamp": "05:08:09", "text": "。"}, {"type": "subtitle", "time": 18493.35, "timestamp": "05:08:13", "text": "ええ、でも、"}, {"type": "subtitle", "time": 18496.55, "timestamp": "05:08:16", "text": "自分のチャンネルを誕生日ポートフォリオとして何らかの形で活用したいと思っています。 論争とか色々あって、私の"}, {"type": "subtitle", "time": 18500.15, "timestamp": "05:08:20", "text": "これまでの実績はもう台無しになってしまった"}, {"type": "subtitle", "time": 18502.39, "timestamp": "05:08:22", "text": "。"}, {"type": "subtitle", "time": 18506.39, "timestamp": "05:08:26", "text": "私は今、悪い実績を持っている。 それは"}, {"type": "subtitle", "time": 18510.47, "timestamp": "05:08:30", "text": "マイナスポイントなので、そのせいで"}, {"type": "subtitle", "time": 18513.19, "timestamp": "05:08:33", "text": "ブランドや企業は"}, {"type": "subtitle", "time": 18515.51, "timestamp": "05:08:35", "text": "私を雇ってくれないんです。 それは一つの"}, {"type": "subtitle", "time": 18519.35, "timestamp": "05:08:39", "text": "ことですが、それでも私は自分がどれだけ"}, {"type": "subtitle", "time": 18523.03, "timestamp": "05:08:43", "text": "成長したか、そして自分には"}, {"type": "chat", "time": 18523.306, "timestamp": "05:08:43", "author": "@FEROCIOUS_Grrr", "avatar": "https://yt4.ggpht.com/b2fcSyaRaGAEUJaW8yBs5ibxfiDi-brp1G8cHHTYAXKaRusaeuWU68kOjIUNWz1gmVNNSGP5MQ=s64-c-k-c0x00ffffff-no-rj", "message": "Hmm good good ... Nobody has a very crystal clear planned shit .. we just go with the present flow"}, {"type": "subtitle", "time": 18526.31, "timestamp": "05:08:46", "text": "スキルがあることを示したいのです。 だから、これ以外にも、"}, {"type": "subtitle", "time": 18534.868, "timestamp": "05:08:54", "text": "声優とか、重要で"}, {"type": "subtitle", "time": 18537.27, "timestamp": "05:08:57", "text": "競争が激しくて難しい仕事もできるかもしれない。もちろん"}]
[{"type": "subtitle", "time": 188.39, "timestamp": "00:03:08", "text": "こんにちは。 こんにちは。 こんにちは。 こんにちは、みんな。 クンバワ。"}, {"type": "subtitle", "time": 191.27, "timestamp": "00:03:11", "text": "今日の配信では、ええと、私は純粋に集中して、気を散らすこと"}, {"type": "subtitle", "time": 197.03, "timestamp": "00:03:17", "text": "なく、真摯に取り組んでいくことをお伝えしたいと思います。"}, {"type": "subtitle", "time": 201.27, "timestamp": "00:03:21", "text": "あちこちで気が散ったり、脱線したりしないことを願っています。  [音楽] しかし、今日の"}, {"type": "subtitle", "time": 204.07, "timestamp": "00:03:24", "text": "配信では、"}, {"type": "subtitle", "time": 214.07, "timestamp": "00:03:34", "text": "N5の漢字と"}, {"type": "subtitle", "time": 217.43, "timestamp": "00:03:37", "text": "N4の漢字も復習するために、完全に没頭したいと思います。 えーっと、"}, {"type": "subtitle", "time": 221.27, "timestamp": "00:03:41", "text": "今まで学んだことは何でも、明日"}, {"type": "subtitle", "time": 225.99, "timestamp": "00:03:45", "text": "タッチペーパーテストがあるんだけど、タッチペーパーテストでは"}, {"type": "subtitle", "time": 230.55, "timestamp": "00:03:50", "text": "何もカンニングできないから、すごく厳しくなると思う。自分のためでもあるし、"}, {"type": "subtitle", "time": 235.43, "timestamp": "00:03:55", "text": "みんなのためでもあるから、うん、"}]
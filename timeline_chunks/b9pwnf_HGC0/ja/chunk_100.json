[{"type": "subtitle", "time": 6029.109, "timestamp": "01:40:29", "text": "彼女は"}, {"type": "subtitle", "time": 6031.189, "timestamp": "01:40:31", "text": "待って、ロクナナ"}, {"type": "subtitle", "time": 6046.149, "timestamp": "01:40:46", "text": "Q"}, {"type": "subtitle", "time": 6047.669, "timestamp": "01:40:47", "text": "ユダヤ人。   わかったよ"}, {"type": "subtitle", "time": 6050.149, "timestamp": "01:40:50", "text": "、ユダヤ人。 まだそこには到達していませんが、"}, {"type": "subtitle", "time": 6052.149, "timestamp": "01:40:52", "text": "ええ。   何てことだ"}, {"type": "subtitle", "time": 6054.55, "timestamp": "01:40:54", "text": "。 これをデバイスに記録しておかないと、"}]
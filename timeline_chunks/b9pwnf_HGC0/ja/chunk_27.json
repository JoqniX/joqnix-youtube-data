[{"type": "subtitle", "time": 1620.47, "timestamp": "00:27:00", "text": "。   えっと、他に何かありますか"}, {"type": "subtitle", "time": 1630.07, "timestamp": "00:27:10", "text": "ほとんどは知っているのですが、"}, {"type": "subtitle", "time": 1635.59, "timestamp": "00:27:15", "text": "キョミと、"}, {"type": "subtitle", "time": 1643.99, "timestamp": "00:27:23", "text": "少なくともこれらの基本は一緒に学んでいこう。"}, {"type": "subtitle", "time": 1647.269, "timestamp": "00:27:27", "text": "よし、今日は全部練習するよ。   よし"}, {"type": "subtitle", "time": 1650.07, "timestamp": "00:27:30", "text": "。 このビデオを聞きたいですか"}, {"type": "subtitle", "time": 1652.549, "timestamp": "00:27:32", "text": "？"}, {"type": "subtitle", "time": 1656.149, "timestamp": "00:27:36", "text": "もしご希望でしたら、そうすることもできますよ。"}, {"type": "subtitle", "time": 1657.75, "timestamp": "00:27:37", "text": "ほとんどの日本語の漢字には"}, {"type": "subtitle", "time": 1659.51, "timestamp": "00:27:39", "text": "複数の"}, {"type": "subtitle", "time": 1662.549, "timestamp": "00:27:42", "text": "読み方がありますが、このビデオでは各漢字の代表的な読み方を1つだけ紹介しています"}, {"type": "subtitle", "time": 1667.43, "timestamp": "00:27:47", "text": "。"}, {"type": "subtitle", "time": 1671.51, "timestamp": "00:27:51", "text": "こんにちは。 では、まずはこれから始めましょう。 えっと、"}, {"type": "subtitle", "time": 1675.029, "timestamp": "00:27:55", "text": "どうすればいいんですか？ ちょっと考えさせてください。 私はこれをこのままにしておきたい"}]
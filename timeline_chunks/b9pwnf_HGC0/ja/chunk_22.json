[{"type": "subtitle", "time": 1324.63, "timestamp": "00:22:04", "text": "。 えっと、私の中には、"}, {"type": "subtitle", "time": 1327.51, "timestamp": "00:22:07", "text": "キラアナカタカナを"}, {"type": "subtitle", "time": 1329.99, "timestamp": "00:22:09", "text": "アートのように書きたいけど、何も見ずに書きたいと思ってる部分があって、"}, {"type": "subtitle", "time": 1333.669, "timestamp": "00:22:13", "text": "ここで"}, {"type": "subtitle", "time": 1336.205, "timestamp": "00:22:16", "text": "それをやりたいんだけど、私は"}, {"type": "subtitle", "time": 1339.27, "timestamp": "00:22:19", "text": "[音楽]クソを知らない。 ああ、"}, {"type": "subtitle", "time": 1342.23, "timestamp": "00:22:22", "text": "そうするべきだったん"}, {"type": "subtitle", "time": 1343.75, "timestamp": "00:22:23", "text": "だけど、"}, {"type": "subtitle", "time": 1347.51, "timestamp": "00:22:27", "text": "基本に時間をかけすぎたくないんだ。 今はまだすごく基本的なことだけ。だって、"}, {"type": "subtitle", "time": 1350.549, "timestamp": "00:22:30", "text": "今やりたいことは"}, {"type": "subtitle", "time": 1356.63, "timestamp": "00:22:36", "text": "こんにちは、アレックス。まずは漢字から始めましょう。   わかった"}, {"type": "subtitle", "time": 1358.47, "timestamp": "00:22:38", "text": "。   ちなみに、"}, {"type": "subtitle", "time": 1361.75, "timestamp": "00:22:41", "text": "これは本当に素晴らしい動画ですね。   とても"}, {"type": "subtitle", "time": 1379.75, "timestamp": "00:22:59", "text": "1秒。  H それは最新情報です。 それは"}]
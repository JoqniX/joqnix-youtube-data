[{"type": "subtitle", "time": 15001.349, "timestamp": "04:10:01", "text": "友達がそれをプレゼントしてくれたんだ"}, {"type": "subtitle", "time": 15005.03, "timestamp": "04:10:05", "text": "けど、私はそのボイド"}, {"type": "subtitle", "time": 15009.03, "timestamp": "04:10:09", "text": "バージョンを持ってないんだ。  VRMは持っています"}, {"type": "subtitle", "time": 15011.51, "timestamp": "04:10:11", "text": "が、そのVOID"}, {"type": "subtitle", "time": 15014.55, "timestamp": "04:10:14", "text": "ファイルがありません。   それに、あの"}, {"type": "subtitle", "time": 15022.55, "timestamp": "04:10:22", "text": "騒動が起きて以来、ほとんどのインド人ユーチューバーとはもう話していません。 ああ、たくさんの友達を失ったと思う"}, {"type": "subtitle", "time": 15025.59, "timestamp": "04:10:25", "text": "。 なぜなら、そう、"}, {"type": "subtitle", "time": 15027.67, "timestamp": "04:10:27", "text": "裏切り者、そういう人たちはみんな失ったから"}, {"type": "subtitle", "time": 15030.389, "timestamp": "04:10:30", "text": "いいんだけど、"}, {"type": "subtitle", "time": 15033.429, "timestamp": "04:10:33", "text": "最近は一人でいることが多いから。   えっと、"}, {"type": "subtitle", "time": 15040.309, "timestamp": "04:10:40", "text": "どういう言い方をすればいいかな？"}, {"type": "subtitle", "time": 15043.269, "timestamp": "04:10:43", "text": "つまり、3Dモデルが欲しいんです。"}, {"type": "subtitle", "time": 15049.51, "timestamp": "04:10:49", "text": "新しいモデルを誰かに依頼できたらいいのにと思います。 私は"}, {"type": "subtitle", "time": 15052.309, "timestamp": "04:10:52", "text": "その新しいモデルを2Dで軽く作ったのですが、Blenderのような"}, {"type": "subtitle", "time": 15058.87, "timestamp": "04:10:58", "text": "3D形式で同じ品質のカスタム品質の"}]
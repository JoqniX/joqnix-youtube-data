[{"type": "subtitle", "time": 8405.11, "timestamp": "02:20:05", "text": "もし私がこれをやっていたら、もし私が"}, {"type": "subtitle", "time": 8407.349, "timestamp": "02:20:07", "text": "この湾について事前に調べていたら、こんな"}, {"type": "subtitle", "time": 8408.95, "timestamp": "02:20:08", "text": "苦しみを味わうことはなかっただろう。"}, {"type": "subtitle", "time": 8422.07, "timestamp": "02:20:22", "text": "（笑）"}, {"type": "subtitle", "time": 8456.07, "timestamp": "02:20:56", "text": "否定的な例は何ですか？ どれ？"}]
[{"type": "subtitle", "time": 12481.99, "timestamp": "03:28:01", "text": "試験ですか？ だから、お菓子のためになるんだ。"}, {"type": "subtitle", "time": 12487.75, "timestamp": "03:28:07", "text": "先生が"}, {"type": "subtitle", "time": 12492.309, "timestamp": "03:28:12", "text": "N4レベルの"}, {"type": "subtitle", "time": 12496.309, "timestamp": "03:28:16", "text": "問題を出してくれるような気がするんです。N4レベルの"}, {"type": "subtitle", "time": 12501.429, "timestamp": "03:28:21", "text": "問題みたいに、文章があって"}, {"type": "subtitle", "time": 12506.389, "timestamp": "03:28:26", "text": "選択肢があるような。あるいは、漢字だけが出てきて、それを字見で"}, {"type": "subtitle", "time": 12511.59, "timestamp": "03:28:31", "text": "書かないといけないような。"}, {"type": "subtitle", "time": 12517.269, "timestamp": "03:28:37", "text": "選択肢がないかもしれない"}, {"type": "subtitle", "time": 12520.55, "timestamp": "03:28:40", "text": "けど、"}, {"type": "subtitle", "time": 12524.07, "timestamp": "03:28:44", "text": "セキュリティ上の理由から、"}, {"type": "subtitle", "time": 12527.009, "timestamp": "03:28:47", "text": "明日ウェブカメラをオンにすることになったんです"}, {"type": "subtitle", "time": 12527.83, "timestamp": "03:28:47", "text": "（笑って息を呑む）。だから、"}, {"type": "subtitle", "time": 12535.59, "timestamp": "03:28:55", "text": "正直に書いて見せる必要があるし、"}]
[{"type": "subtitle", "time": 5767.75, "timestamp": "01:36:07", "text": "もう一度やり方を教えていただけますか？"}, {"type": "subtitle", "time": 5770.39, "timestamp": "01:36:10", "text": "えっと、書き間違えたかもしれません。"}, {"type": "subtitle", "time": 5771.51, "timestamp": "01:36:11", "text": "Q."}, {"type": "subtitle", "time": 5774.07, "timestamp": "01:36:14", "text": "１、２、３。"}, {"type": "subtitle", "time": 5776.629, "timestamp": "01:36:16", "text": "滑り台の順番待ちみたいだ。"}, {"type": "subtitle", "time": 5778.47, "timestamp": "01:36:18", "text": "滑り台に並んでいます。 ああ、実は"}, {"type": "subtitle", "time": 5781.27, "timestamp": "01:36:21", "text": "滑り台だったんですね。 ああ、なんて賢い人たちなんだ"}, {"type": "subtitle", "time": 5817.75, "timestamp": "01:36:57", "text": "待って、待って。 それが"}]
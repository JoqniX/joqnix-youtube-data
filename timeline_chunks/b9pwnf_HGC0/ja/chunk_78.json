[{"type": "subtitle", "time": 4681.99, "timestamp": "01:18:01", "text": "明日はテストがあるんです。 私の先生は"}, {"type": "subtitle", "time": 4684.95, "timestamp": "01:18:04", "text": "漢字4文字のテストを実施する予定です。"}, {"type": "subtitle", "time": 4689.35, "timestamp": "01:18:09", "text": "だから、N4の"}, {"type": "subtitle", "time": 4692.07, "timestamp": "01:18:12", "text": "漢字に取り組み、明日のテストに備えたいなら、"}, {"type": "subtitle", "time": 4698.229, "timestamp": "01:18:18", "text": "N5以降の基礎や"}, {"type": "subtitle", "time": 4700.47, "timestamp": "01:18:20", "text": "文法、N5や"}, {"type": "subtitle", "time": 4704.79, "timestamp": "01:18:24", "text": "N4の文法、N4の「えーと」の"}, {"type": "subtitle", "time": 4708.79, "timestamp": "01:18:28", "text": "部分、接続詞、"}, {"type": "subtitle", "time": 4712.229, "timestamp": "01:18:32", "text": "そして「えーと」の意味など、すべてを復習することから始めるべきだと思ったんです"}, {"type": "subtitle", "time": 4717.669, "timestamp": "01:18:37", "text": "。   えっと、"}, {"type": "subtitle", "time": 4720.95, "timestamp": "01:18:40", "text": "何て名前だったっけ？ 忘れた。"}, {"type": "subtitle", "time": 4724.63, "timestamp": "01:18:44", "text": "潜在的な形態。 ああ、あれは。"}, {"type": "subtitle", "time": 4727.35, "timestamp": "01:18:47", "text": "潜在的な形態。"}, {"type": "subtitle", "time": 4730.47, "timestamp": "01:18:50", "text": "私の愛する、ええと、"}, {"type": "subtitle", "time": 4732.47, "timestamp": "01:18:52", "text": "それらの接続関連のすべて。 うん。"}, {"type": "subtitle", "time": 4734.39, "timestamp": "01:18:54", "text": "文法とか、その他すべて。 だから今日の番組は、"}, {"type": "subtitle", "time": 4738.07, "timestamp": "01:18:58", "text": "私にとっては基本的に全面的な復習です。 だから、私は"}]
[{"type": "subtitle", "time": 14220.469, "timestamp": "03:57:00", "text": "なぜ私の鍵は"}, {"type": "subtitle", "time": 14222.07, "timestamp": "03:57:02", "text": "味気ない"}, {"type": "subtitle", "time": 14223.91, "timestamp": "03:57:03", "text": "鍵のように見えるのですか？"}, {"type": "subtitle", "time": 14231.189, "timestamp": "03:57:11", "text": "これを見た。 さて、次のページへ。 来て。"}, {"type": "subtitle", "time": 14243.03, "timestamp": "03:57:23", "text": "えっと、"}, {"type": "subtitle", "time": 14269.67, "timestamp": "03:57:49", "text": "私がやりました。 これは何ですか？"}, {"type": "subtitle", "time": 14273.03, "timestamp": "03:57:53", "text": "名詞と一緒に so を使用しないでください。 わかった。"}]
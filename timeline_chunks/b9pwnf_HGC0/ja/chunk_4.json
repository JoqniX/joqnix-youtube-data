[{"type": "subtitle", "time": 241.509, "timestamp": "00:04:01", "text": "復習テストとして真剣なテストなんだ。だから、遅れを取りたくない。"}, {"type": "subtitle", "time": 248.39, "timestamp": "00:04:08", "text": "毎日練習したり、"}, {"type": "subtitle", "time": 252.71, "timestamp": "00:04:12", "text": "日本語の授業で学んだことを復習したりしていないから、遅れているのは分かっている。  [音楽]"}, {"type": "subtitle", "time": 255.67, "timestamp": "00:04:15", "text": "ああ、そう、片方の"}, {"type": "subtitle", "time": 259.11, "timestamp": "00:04:19", "text": "耳からもう片方の耳に伝わる音が"}, {"type": "subtitle", "time": 261.99, "timestamp": "00:04:21", "text": "脳に刻み込まれていないような感じで、それは良くない。 だから"}, {"type": "subtitle", "time": 264.31, "timestamp": "00:04:24", "text": "今日は少なくとも6時間は過ごしたい"}, {"type": "subtitle", "time": 267.51, "timestamp": "00:04:27", "text": "。 今は5時30分です。 いいえ。なので、"}, {"type": "subtitle", "time": 270.23, "timestamp": "00:04:30", "text": "おそらく一晩中配信すると思います。 えーっと、"}, {"type": "subtitle", "time": 272.79, "timestamp": "00:04:32", "text": "基本をしっかり学びたいんです。"}, {"type": "subtitle", "time": 276.95, "timestamp": "00:04:36", "text": "えーっと、"}, {"type": "subtitle", "time": 280.55, "timestamp": "00:04:40", "text": "漢字を一つ一つ読んで、書いて、"}, {"type": "subtitle", "time": 284.15, "timestamp": "00:04:44", "text": "基本的な文法も全部今日やります。 ええ"}, {"type": "subtitle", "time": 286.95, "timestamp": "00:04:46", "text": "、本当にたくさんあります。"}, {"type": "subtitle", "time": 289.11, "timestamp": "00:04:49", "text": "大変ありがたいです。 もしあなたも"}, {"type": "subtitle", "time": 295.43, "timestamp": "00:04:55", "text": "日本語を学びたい、あるいは私と一緒に練習したり勉強したりすることに興味があるなら、ぜひ一緒に"}, {"type": "subtitle", "time": 298.23, "timestamp": "00:04:58", "text": "勉強しましょう。 はい、どうぞ"}]
[{"type": "subtitle", "time": 601.19, "timestamp": "00:10:01", "text": "。 そうですね、"}, {"type": "subtitle", "time": 607.19, "timestamp": "00:10:07", "text": "筆順なども改めて学び直します"}, {"type": "subtitle", "time": 609.19, "timestamp": "00:10:09", "text": "。"}, {"type": "subtitle", "time": 619.11, "timestamp": "00:10:19", "text": "えっと、これをする前に、これを閉じて"}, {"type": "subtitle", "time": 626.15, "timestamp": "00:10:26", "text": "最小化させてください。"}, {"type": "subtitle", "time": 628.31, "timestamp": "00:10:28", "text": "お茶を飲んでいたので、ここには来ませんでした"}, {"type": "subtitle", "time": 630.15, "timestamp": "00:10:30", "text": "。"}, {"type": "subtitle", "time": 635.03, "timestamp": "00:10:35", "text": "必要なものはすべてスマホから操作できた。"}, {"type": "subtitle", "time": 638.71, "timestamp": "00:10:38", "text": "ええ、"}, {"type": "subtitle", "time": 641.99, "timestamp": "00:10:41", "text": "私が使っていたソフトウェアにアップデートがありました。 えっと、突然"}, {"type": "subtitle", "time": 645.03, "timestamp": "00:10:45", "text": "接続が切れたんです。"}, {"type": "subtitle", "time": 646.87, "timestamp": "00:10:46", "text": "だから、私が来て残りの作業をしなければならなかった"}, {"type": "subtitle", "time": 650.63, "timestamp": "00:10:50", "text": "。 ああ、そうだね。"}, {"type": "subtitle", "time": 654.342, "timestamp": "00:10:54", "text": "こんにちは。 それでは始めましょう。 始めましょうか？"}, {"type": "subtitle", "time": 658.71, "timestamp": "00:10:58", "text": "[音楽] オーケー。 交代させてください。"}]
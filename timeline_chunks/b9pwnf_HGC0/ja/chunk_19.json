[{"type": "subtitle", "time": 1142.47, "timestamp": "00:19:02", "text": "。 ああ、そうだね。 えっと、"}, {"type": "subtitle", "time": 1146.789, "timestamp": "00:19:06", "text": "これは何ですか？ ええと、小さいです。 わかった。"}, {"type": "subtitle", "time": 1150.549, "timestamp": "00:19:10", "text": "大きなグラフだと思ったけど、まあいいか。 えっと、これは"}, {"type": "subtitle", "time": 1152.95, "timestamp": "00:19:12", "text": "ひらがな表です。"}, {"type": "subtitle", "time": 1155.19, "timestamp": "00:19:15", "text": "待って、有声子音。 待って、"}, {"type": "subtitle", "time": 1157.909, "timestamp": "00:19:17", "text": "彼らが持っていたもう一つの図表はどこにあるの？ ええ、そうですね。 はがな"}, {"type": "subtitle", "time": 1159.83, "timestamp": "00:19:19", "text": "カタカナ。 よし、これこそ私が"}, {"type": "subtitle", "time": 1162.31, "timestamp": "00:19:22", "text": "探していたものだ。"}, {"type": "subtitle", "time": 1165.27, "timestamp": "00:19:25", "text": "ああ、"}, {"type": "subtitle", "time": 1169.029, "timestamp": "00:19:29", "text": "これこそ私が探していたものだ。"}, {"type": "subtitle", "time": 1172.71, "timestamp": "00:19:32", "text": "これをバックグラウンドタブで開き、"}, {"type": "subtitle", "time": 1177.43, "timestamp": "00:19:37", "text": "これもバックグラウンドタブで開きます。 こんにちは。 こんにちは。"}, {"type": "subtitle", "time": 1180.549, "timestamp": "00:19:40", "text": "これはカタカナです。"}, {"type": "subtitle", "time": 1182.95, "timestamp": "00:19:42", "text": "そして、これはなぜこうなっているのでしょうか？ 分かりません"}, {"type": "subtitle", "time": 1192.549, "timestamp": "00:19:52", "text": "これはひらがなです。"}, {"type": "subtitle", "time": 1194.07, "timestamp": "00:19:54", "text": "いいえ。"}, {"type": "subtitle", "time": 1196.95, "timestamp": "00:19:56", "text": "こんにちは。 とりあえず1、2回ざっと目を通してから"}]
[{"type": "subtitle", "time": 15242.71, "timestamp": "04:14:02", "text": "プロの仕事として追求したいからなんです。もしそれがうまくいかなかったら、子供の頃からの"}, {"type": "subtitle", "time": 15248.63, "timestamp": "04:14:08", "text": "夢だったミュージシャンになって"}, {"type": "subtitle", "time": 15252.87, "timestamp": "04:14:12", "text": "音楽をリリースするという夢を叶えたいと思っています。そうなったら"}, {"type": "subtitle", "time": 15255.189, "timestamp": "04:14:15", "text": "いいですね。"}, {"type": "subtitle", "time": 15271.59, "timestamp": "04:14:31", "text": "作家になれると思って英文学を専攻しました。 だから、"}, {"type": "subtitle", "time": 15274.469, "timestamp": "04:14:34", "text": "ジョーや他のキャラクターのために物語を書いたり、"}, {"type": "subtitle", "time": 15283.189, "timestamp": "04:14:43", "text": "自分の情熱を注いでいるプロジェクトのために物語や伝承などを書きたいんです。   うまくいかなかった"}, {"type": "subtitle", "time": 15286.63, "timestamp": "04:14:46", "text": "。"}, {"type": "subtitle", "time": 15289.83, "timestamp": "04:14:49", "text": "でも、少なくとも音楽に関しては、常にベストを尽くし続けたいと思っています"}, {"type": "subtitle", "time": 15293.269, "timestamp": "04:14:53", "text": "。 もちろん、"}, {"type": "subtitle", "time": 15295.59, "timestamp": "04:14:55", "text": "もし"}]
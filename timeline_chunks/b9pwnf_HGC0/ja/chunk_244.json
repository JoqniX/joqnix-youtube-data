[{"type": "subtitle", "time": 14640.309, "timestamp": "04:04:00", "text": "こんにちは、リス。 ええ、宿題をしています。 あと"}, {"type": "subtitle", "time": 14642.79, "timestamp": "04:04:02", "text": "1時間で提出しなければならない。 もし"}, {"type": "subtitle", "time": 14646.55, "timestamp": "04:04:06", "text": "今から1時間以内に提出しないと、"}, {"type": "subtitle", "time": 14653.67, "timestamp": "04:04:13", "text": "今日の日本語の授業は欠席扱いになり、"}, {"type": "subtitle", "time": 14658.63, "timestamp": "04:04:18", "text": "7時までに提出しなければなりません。 つまり、短いストリームだ。"}, {"type": "subtitle", "time": 14661.67, "timestamp": "04:04:21", "text": "この番組を放送してください。"}, {"type": "subtitle", "time": 14665.83, "timestamp": "04:04:25", "text": "ところで、お元気ですか？ こんにちは。 こんにちは。"}, {"type": "subtitle", "time": 14669.67, "timestamp": "04:04:29", "text": "ああ、まだ続きがある。 ああ、気にしないで。"}, {"type": "subtitle", "time": 14681.984, "timestamp": "04:04:41", "text": "ああ、わかった。 待って。 だから、"}, {"type": "subtitle", "time": 14692.389, "timestamp": "04:04:52", "text": "。 戻ってきました。 戻ってきました。 戻ってきました。 戻ってきました"}, {"type": "subtitle", "time": 14692.95, "timestamp": "04:04:52", "text": "。   わかった"}]
[{"type": "subtitle", "time": 14717.67, "timestamp": "04:05:17", "text": "、ただいま"}, {"type": "subtitle", "time": 14720.229, "timestamp": "04:05:20", "text": "。 ディオ、"}, {"type": "subtitle", "time": 14723.03, "timestamp": "04:05:23", "text": "こんなに時間がかかってしまってごめんなさい。 ああ"}, {"type": "subtitle", "time": 14726.71, "timestamp": "04:05:26", "text": "、"}, {"type": "subtitle", "time": 14743.554, "timestamp": "04:05:43", "text": "私は全力疾走してたくさん食べ"}, {"type": "subtitle", "time": 14745.11, "timestamp": "04:05:45", "text": "（咳払い）、"}, {"type": "subtitle", "time": 14750.309, "timestamp": "04:05:50", "text": "水筒にはお湯も入れました。"}, {"type": "subtitle", "time": 14754.229, "timestamp": "04:05:54", "text": "えっと、夜にこれをやる時に食べるために、オレンジと果物をいくつか買ってきました"}]
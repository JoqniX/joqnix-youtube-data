[{"type": "subtitle", "time": 20162.868, "timestamp": "05:36:02", "text": "？ これまでに31個を習得しました。 つまり、"}, {"type": "subtitle", "time": 20167.11, "timestamp": "05:36:07", "text": "これまでに31箇所を修正したということです。 まだ先は長い。"}, {"type": "subtitle", "time": 20171.67, "timestamp": "05:36:11", "text": "この21分の動画の中で、私の出番はたった6分だけです"}, {"type": "subtitle", "time": 20174.31, "timestamp": "05:36:14", "text": "。"}, {"type": "subtitle", "time": 20176.23, "timestamp": "05:36:16", "text": "今日は終わらせられないと思う。"}, {"type": "subtitle", "time": 20180.788, "timestamp": "05:36:20", "text": "明日はN4の試験だよ、N5じゃないんだ"}, {"type": "subtitle", "time": 20185.51, "timestamp": "05:36:25", "text": "。 そして、N4の方は20"}, {"type": "subtitle", "time": 20202.39, "timestamp": "05:36:42", "text": "たぶん明日の早朝、午前"}, {"type": "subtitle", "time": 20204.788, "timestamp": "05:36:44", "text": "6時頃にやると思う。午前"}, {"type": "subtitle", "time": 20206.628, "timestamp": "05:36:46", "text": "6時頃から勉強を始めるつもりだ"}, {"type": "subtitle", "time": 20208.708, "timestamp": "05:36:48", "text": "。"}, {"type": "subtitle", "time": 20211.11, "timestamp": "05:36:51", "text": "なあ、俺はこれら全部知ってるんだけど、"}]
[{"type": "subtitle", "time": 10765.349, "timestamp": "02:59:25", "text": "私は普段この時間になると寝ます。 こんにちは。   今日は"}, {"type": "subtitle", "time": 10768.87, "timestamp": "02:59:28", "text": "平日ですよね？"}, {"type": "subtitle", "time": 10771.349, "timestamp": "02:59:31", "text": "こうした労働日を表す言葉があった。"}, {"type": "subtitle", "time": 10773.19, "timestamp": "02:59:33", "text": "忘れてしまった、"}, {"type": "subtitle", "time": 10776.389, "timestamp": "02:59:36", "text": "でも忘れてしまったんです。 それについて考えました。"}, {"type": "subtitle", "time": 10778.79, "timestamp": "02:59:38", "text": "職場を何と呼ぶのか忘れてしまったし、"}]
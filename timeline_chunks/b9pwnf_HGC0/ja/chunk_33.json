[{"type": "subtitle", "time": 1991.669, "timestamp": "00:33:11", "text": "まで"}, {"type": "subtitle", "time": 1993.19, "timestamp": "00:33:13", "text": "書き続けなきゃいけない、"}, {"type": "subtitle", "time": 1995.83, "timestamp": "00:33:15", "text": "これが今日の課題、"}, {"type": "subtitle", "time": 1999.19, "timestamp": "00:33:19", "text": "基本を復習する、うん、それから"}, {"type": "subtitle", "time": 2002.789, "timestamp": "00:33:22", "text": "N4 に進みます。 心配しないでください、時間がかかるプロセスです。 大丈夫、できるよ"}, {"type": "subtitle", "time": 2005.669, "timestamp": "00:33:25", "text": "。 私たちはそう信じています。  [笑い声]"}, {"type": "subtitle", "time": 2010.71, "timestamp": "00:33:30", "text": "こんにちは。 膝はこんな感じです。 ええと、いいえと同じです"}, {"type": "subtitle", "time": 2014.549, "timestamp": "00:33:34", "text": "。 次は息子です。 ええと、膝と同じです"}, {"type": "subtitle", "time": 2016.87, "timestamp": "00:33:36", "text": "が、両方とも"}, {"type": "subtitle", "time": 2021.269, "timestamp": "00:33:41", "text": "同じであることを確認してください。 そして最後の一つはもっと大きくなる。"}, {"type": "subtitle", "time": 2023.19, "timestamp": "00:33:43", "text": "右。"}, {"type": "subtitle", "time": 2025.029, "timestamp": "00:33:45", "text": "息子よ、"}, {"type": "subtitle", "time": 2031.43, "timestamp": "00:33:51", "text": "息子よ。  S. あ、待って、待って、待って。 あれはG・"}, {"type": "subtitle", "time": 2033.43, "timestamp": "00:33:53", "text": "ソンだ。"}]
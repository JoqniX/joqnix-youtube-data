[{"type": "subtitle", "time": 541.269, "timestamp": "00:09:01", "text": "朝は生配信をしないことにしたんです。"}, {"type": "subtitle", "time": 543.67, "timestamp": "00:09:03", "text": "だって私は「いやいや、無理しちゃダメだ"}, {"type": "subtitle", "time": 552.389, "timestamp": "00:09:12", "text": "ああ、つまり"}, {"type": "subtitle", "time": 554.79, "timestamp": "00:09:14", "text": "、エゴサーフィンは良くないんだよ。 それは"}, {"type": "subtitle", "time": 556.87, "timestamp": "00:09:16", "text": "あなたの精神状態や考え方などに影響を与える可能性があります"}, {"type": "subtitle", "time": 558.47, "timestamp": "00:09:18", "text": "。"}, {"type": "subtitle", "time": 562.31, "timestamp": "00:09:22", "text": "私の場合も、おそらくそういうことだったのでしょう。"}, {"type": "subtitle", "time": 568.23, "timestamp": "00:09:28", "text": "こんにちは、"}, {"type": "subtitle", "time": 572.23, "timestamp": "00:09:32", "text": "今日の記事を書くために、アフィニティを開かせてください。 これから使う"}, {"type": "subtitle", "time": 575.75, "timestamp": "00:09:35", "text": "漢字の動画を2つ、ここにアップロードしてください"}, {"type": "subtitle", "time": 578.31, "timestamp": "00:09:38", "text": "。 ええと、まずは"}, {"type": "subtitle", "time": 581.35, "timestamp": "00:09:41", "text": "N5の漢字から始めましょう。 わかった。 そして後ほど、"}, {"type": "subtitle", "time": 586.07, "timestamp": "00:09:46", "text": "N4レベルの漢字から始めます。 わかった。   よし"}, {"type": "subtitle", "time": 589.19, "timestamp": "00:09:49", "text": "。 だからN5には漢字が100個あって、"}, {"type": "subtitle", "time": 592.55, "timestamp": "00:09:52", "text": "N4には180個ある。"}, {"type": "subtitle", "time": 597.67, "timestamp": "00:09:57", "text": "このビデオには180個くらいある。うんうんうん"}]
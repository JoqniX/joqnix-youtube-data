[{"type": "subtitle", "time": 5294.629, "timestamp": "01:28:14", "text": "多分 [鼻を鳴らす]"}, {"type": "subtitle", "time": 5297.43, "timestamp": "01:28:17", "text": "私はこれを知っています。 私は彼を認識している。 わからない"}, {"type": "subtitle", "time": 5299.91, "timestamp": "01:28:19", "text": "。 私は鬼と"}, {"type": "subtitle", "time": 5306.861, "timestamp": "01:28:26", "text": "この漢字は違います。"}, {"type": "subtitle", "time": 5325.43, "timestamp": "01:28:45", "text": "待って、えーっと、ヒット、待って、ヒットじゃない、"}, {"type": "subtitle", "time": 5328.476, "timestamp": "01:28:48", "text": "ああ、これと"}, {"type": "subtitle", "time": 5330.39, "timestamp": "01:28:50", "text": "[笑い]"}]
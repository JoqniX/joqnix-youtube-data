[{"type": "subtitle", "time": 24600.31, "timestamp": "06:50:00", "text": "ナラニナラニ、ああ神様、私が行くたびに"}, {"type": "subtitle", "time": 24615.91, "timestamp": "06:50:15", "text": "なぜパッチが機能しなかったのか？ それはすごく"}, {"type": "subtitle", "time": 24622.468, "timestamp": "06:50:22", "text": "数日後にやります。"}, {"type": "subtitle", "time": 24626.39, "timestamp": "06:50:26", "text": "この日本のことで頭が痛くなるのを何とかしよう"}, {"type": "subtitle", "time": 24630.548, "timestamp": "06:50:30", "text": "。 今藻はやらないでください"}, {"type": "subtitle", "time": 24633.43, "timestamp": "06:50:33", "text": "。"}, {"type": "subtitle", "time": 24645.11, "timestamp": "06:50:45", "text": "奇妙な。 これは本当に奇妙だ。"}, {"type": "subtitle", "time": 24647.59, "timestamp": "06:50:47", "text": "これは正しい電流の流れだと認識していますが、"}]
[{"type": "subtitle", "time": 2946.71, "timestamp": "00:49:06", "text": "うん。   まめまめ"}, {"type": "subtitle", "time": 2952.549, "timestamp": "00:49:12", "text": "。 それから、ショートパンツ。   いや"}, {"type": "subtitle", "time": 2954.87, "timestamp": "00:49:14", "text": "、待って。 それから矢印があります。 待って。 これは"}, {"type": "subtitle", "time": 2961.589, "timestamp": "00:49:21", "text": "そして、その二つを合わせると"}, {"type": "subtitle", "time": 2971.589, "timestamp": "00:49:31", "text": "ああ、マガイ。 マジカイ。 マジカイ。 うん。 マグ。   たくさんあります"}, {"type": "subtitle", "time": 2975.589, "timestamp": "00:49:35", "text": "。 でも、きっとたどり着けるよ。"}, {"type": "subtitle", "time": 2978.23, "timestamp": "00:49:38", "text": "本日はN5に焦点を当てます。  [笑い]"}, {"type": "subtitle", "time": 2980.95, "timestamp": "00:49:40", "text": "今日はダメです。 少なくとも6時間はここにいます"}, {"type": "subtitle", "time": 2983.75, "timestamp": "00:49:43", "text": "。 今日中にこれを終わらせなければならない"}, {"type": "subtitle", "time": 2987.27, "timestamp": "00:49:47", "text": "。 私のシステムに取り込んでください。"}, {"type": "subtitle", "time": 2992.47, "timestamp": "00:49:52", "text": "今日復習した漢字は、一つ残らず絶対に忘れません。"}]
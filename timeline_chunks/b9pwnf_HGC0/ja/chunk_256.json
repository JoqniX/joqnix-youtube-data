[{"type": "subtitle", "time": 15360.55, "timestamp": "04:16:00", "text": "なぜなら私は日本が大好きだからです。 いいえ、でも私は"}, {"type": "subtitle", "time": 15366.389, "timestamp": "04:16:06", "text": "練習をもっと好きになるために1時間も費やすつもりはありません"}, {"type": "subtitle", "time": 15391.11, "timestamp": "04:16:31", "text": "なぜ私は絵を描いているのでしょうか？"}, {"type": "subtitle", "time": 15396.469, "timestamp": "04:16:36", "text": "えっと、あなたはストレートですか？それとも私はストレートで、"}, {"type": "subtitle", "time": 15404.149, "timestamp": "04:16:44", "text": "私は自分の性的指向さえ知らないということだ"}, {"type": "subtitle", "time": 15407.03, "timestamp": "04:16:47", "text": "。 つまり、私は"}, {"type": "subtitle", "time": 15414.149, "timestamp": "04:16:54", "text": "私は異性愛者ですが、そうですね。"}, {"type": "subtitle", "time": 15416.07, "timestamp": "04:16:56", "text": "おお。 おお。 おお。 おお。 私は何をしているのだろう？ よし"}, {"type": "subtitle", "time": 15419.522, "timestamp": "04:16:59", "text": "。 漢字に戻りましょう。"}]
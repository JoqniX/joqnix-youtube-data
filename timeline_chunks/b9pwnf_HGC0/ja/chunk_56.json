[{"type": "subtitle", "time": 3360.23, "timestamp": "00:56:00", "text": "これを練習しなかったら、どうなるか分かるか？"}, {"type": "subtitle", "time": 3363.03, "timestamp": "00:56:03", "text": "これを毎週の恒例行事にしましょう。"}, {"type": "subtitle", "time": 3365.349, "timestamp": "00:56:05", "text": "日本語の漢字の練習や、"}, {"type": "subtitle", "time": 3368.15, "timestamp": "00:56:08", "text": "この配信のような毎週のあらゆること。"}, {"type": "subtitle", "time": 3372.069, "timestamp": "00:56:12", "text": "これを毎週続ければ、きっと良い結果になると思う。 私は"}, {"type": "subtitle", "time": 3375.27, "timestamp": "00:56:15", "text": "毎日、または毎日、そのようにします。 なんとか"}, {"type": "subtitle", "time": 3377.27, "timestamp": "00:56:17", "text": "アンクをやってみます。 ああ、"}, {"type": "subtitle", "time": 3381.589, "timestamp": "00:56:21", "text": "アンクをやらなきゃいけないね。 ああ、大変だ。"}, {"type": "subtitle", "time": 3384.39, "timestamp": "00:56:24", "text": "えっと、"}]
[{"type": "subtitle", "time": 19143.19, "timestamp": "05:19:03", "text": "プロフィール画像、名前、"}, {"type": "subtitle", "time": 19145.99, "timestamp": "05:19:05", "text": "メッセージ、チャットIDがストリーム"}, {"type": "subtitle", "time": 19148.868, "timestamp": "05:19:08", "text": "ID、チャンネルリンク、アバターリンク、プロフィール"}, {"type": "subtitle", "time": 19152.47, "timestamp": "05:19:12", "text": "画像ID、チャンネルリンクになります。 すると"}, {"type": "subtitle", "time": 19155.99, "timestamp": "05:19:15", "text": "ユーザーNAは「これを削除する必要がある」という感じになります。"}, {"type": "subtitle", "time": 19158.23, "timestamp": "05:19:18", "text": "これは不要です。 チャットログには、あなた"}, {"type": "subtitle", "time": 19161.19, "timestamp": "05:19:21", "text": "専用のスレッドがあります。 あなたのID、ユーザー"}, {"type": "subtitle", "time": 19165.27, "timestamp": "05:19:25", "text": "ID、ブロードキャスト、どのストリームだったか、"}, {"type": "subtitle", "time": 19169.91, "timestamp": "05:19:29", "text": "ストリームID、ストリームURL、"}, {"type": "subtitle", "time": 19172.47, "timestamp": "05:19:32", "text": "メッセージが送信された日時、そしてタイム"}, {"type": "subtitle", "time": 19174.47, "timestamp": "05:19:34", "text": "スタンプ。これにより、正しいタイム"}, {"type": "subtitle", "time": 19176.948, "timestamp": "05:19:36", "text": "スタンプと、あなたがこのメッセージを送信した正確な瞬間がわかります"}, {"type": "subtitle", "time": 19179.67, "timestamp": "05:19:39", "text": "。 掲示板などを見ていると、「"}, {"type": "subtitle", "time": 19181.83, "timestamp": "05:19:41", "text": "ああ、私がこのこと"}, {"type": "subtitle", "time": 19183.03, "timestamp": "05:19:43", "text": "について話していた時に、あなたが"}, {"type": "subtitle", "time": 19185.59, "timestamp": "05:19:45", "text": "こんなコメントをしたんだ」とわかるんです。 あなたのスレッドは"}, {"type": "subtitle", "time": 19188.47, "timestamp": "05:19:48", "text": "このような表示になり、"}, {"type": "subtitle", "time": 19190.788, "timestamp": "05:19:50", "text": "ここにすべてのチャットが表示されます。"}, {"type": "subtitle", "time": 19194.07, "timestamp": "05:19:54", "text": "つまり、"}, {"type": "subtitle", "time": 19197.27, "timestamp": "05:19:57", "text": "あなた次第でここにすべてが揃います。これはユーザースレッドのようなものです。"}, {"type": "subtitle", "time": 19199.83, "timestamp": "05:19:59", "text": "えっと、これはユーザースレッドみたいなものです。 ええ、"}]
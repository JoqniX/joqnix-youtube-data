[{"type": "subtitle", "time": 25448.548, "timestamp": "07:04:08", "text": "こんにちは、ジョー。 元気ですか？ 元気です。 元気ですか"}, {"type": "subtitle", "time": 25450.788, "timestamp": "07:04:10", "text": "？ 配信へようこ​​そ。"}, {"type": "subtitle", "time": 25453.19, "timestamp": "07:04:13", "text": "もうすぐ終わりにしよう。だって、"}, {"type": "subtitle", "time": 25457.35, "timestamp": "07:04:17", "text": "私の時間だと午前1時になるんだもん。"}, {"type": "subtitle", "time": 25460.15, "timestamp": "07:04:20", "text": "残りは明日書きます。"}]
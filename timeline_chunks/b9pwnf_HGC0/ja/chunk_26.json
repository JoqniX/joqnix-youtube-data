[{"type": "subtitle", "time": 1560.789, "timestamp": "00:26:00", "text": "えっと、"}, {"type": "subtitle", "time": 1564.23, "timestamp": "00:26:04", "text": "この漢字から他に何がわかるかな"}, {"type": "subtitle", "time": 1575.19, "timestamp": "00:26:15", "text": "知っている。 これを忘れてた。  [息を呑む]"}, {"type": "subtitle", "time": 1591.51, "timestamp": "00:26:31", "text": "そうだね、でも俺はもう見込みがないんだよ。 私はもう"}, {"type": "subtitle", "time": 1593.269, "timestamp": "00:26:33", "text": "手遅れだ。 今日は全て見直します"}, {"type": "subtitle", "time": 1601.83, "timestamp": "00:26:41", "text": "さかながんじ。 私はザカナです。 待って、あれは"}, {"type": "subtitle", "time": 1605.43, "timestamp": "00:26:45", "text": "ニクだったの？ 忘れた。"}, {"type": "subtitle", "time": 1607.669, "timestamp": "00:26:47", "text": "私はこれを知っています。 これは"}, {"type": "subtitle", "time": 1618.07, "timestamp": "00:26:58", "text": "これはまずいですね。 わかりました、すべて修正する必要があります"}]
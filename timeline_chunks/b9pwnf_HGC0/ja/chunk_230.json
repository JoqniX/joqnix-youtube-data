[{"type": "subtitle", "time": 13801.67, "timestamp": "03:50:01", "text": "着物。"}, {"type": "subtitle", "time": 13805.03, "timestamp": "03:50:05", "text": "着物は衣服です。 私はそれを着なければならない"}, {"type": "subtitle", "time": 13807.91, "timestamp": "03:50:07", "text": "。"}, {"type": "subtitle", "time": 13809.83, "timestamp": "03:50:09", "text": "勉強する。 えっと、宿題してるんです。 午後"}, {"type": "subtitle", "time": 13814.15, "timestamp": "03:50:14", "text": "6時までに提出しなければなりません。 そうしないと、"}, {"type": "subtitle", "time": 13816.469, "timestamp": "03:50:16", "text": "もし私がそれを怠った場合、"}, {"type": "subtitle", "time": 13819.03, "timestamp": "03:50:19", "text": "今日の7時からの日本語の授業の出席は、"}, {"type": "subtitle", "time": 13823.349, "timestamp": "03:50:23", "text": "欠席したと記録されます。 私はそれを望んでいません"}, {"type": "subtitle", "time": 13825.429, "timestamp": "03:50:25", "text": "。 だから、私は皆勤賞を取りたいんです"}, {"type": "subtitle", "time": 13828.509, "timestamp": "03:50:28", "text": "。 つまり、"}, {"type": "subtitle", "time": 13833.03, "timestamp": "03:50:33", "text": "私が勉強してきたことの復習みたいなものですね。 それでは、まとめてみましょう"}, {"type": "subtitle", "time": 13835.714, "timestamp": "03:50:35", "text": "。"}]
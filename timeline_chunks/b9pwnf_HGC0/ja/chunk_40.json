[{"type": "subtitle", "time": 2400.31, "timestamp": "00:40:00", "text": "ストローク。 午前4時だ。午前"}, {"type": "subtitle", "time": 2404.15, "timestamp": "00:40:04", "text": "4時。幕を開けよう。"}, {"type": "subtitle", "time": 2406.87, "timestamp": "00:40:06", "text": "ああ、それはすごくクールだね。 彼らは、例えば「"}, {"type": "subtitle", "time": 2409.91, "timestamp": "00:40:09", "text": "よし、"}, {"type": "subtitle", "time": 2412.39, "timestamp": "00:40:12", "text": "もう一度だけ」というように例を挙げます。 えっと、[笑い]"}, {"type": "subtitle", "time": 2415.99, "timestamp": "00:40:15", "text": "カーテンを開けてください。 だから、苦労するしかない。  １、２、３、４、５"}, {"type": "subtitle", "time": 2422.55, "timestamp": "00:40:22", "text": "。"}, {"type": "subtitle", "time": 2425.43, "timestamp": "00:40:25", "text": "ええ、同じことです。"}, {"type": "subtitle", "time": 2427.51, "timestamp": "00:40:27", "text": "次回書くときに修正すればい​​いだけです"}, {"type": "subtitle", "time": 2431.51, "timestamp": "00:40:31", "text": "。 いいえ。行け。"}, {"type": "subtitle", "time": 2434.87, "timestamp": "00:40:34", "text": "こんにちは。 さあ行こう。"}, {"type": "subtitle", "time": 2435.67, "timestamp": "00:40:35", "text": "五。"}, {"type": "subtitle", "time": 2437.27, "timestamp": "00:40:37", "text": "行く。   わかった"}, {"type": "subtitle", "time": 2438.583, "timestamp": "00:40:38", "text": "。  [笑い]"}, {"type": "subtitle", "time": 2451.75, "timestamp": "00:40:51", "text": "サン。"}]
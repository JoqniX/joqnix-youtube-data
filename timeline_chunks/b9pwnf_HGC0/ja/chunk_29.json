[{"type": "subtitle", "time": 1742.63, "timestamp": "00:29:02", "text": "保存せずに閉じてください。   ええ"}, {"type": "subtitle", "time": 1764.63, "timestamp": "00:29:24", "text": "こんにちは。 まず一つ目は痒い。"}, {"type": "subtitle", "time": 1767.909, "timestamp": "00:29:27", "text": "とても簡単です。 えっと、"}, {"type": "subtitle", "time": 1772.95, "timestamp": "00:29:32", "text": "ペンをください。 まず一つ目は痒い。"}, {"type": "subtitle", "time": 1785.669, "timestamp": "00:29:45", "text": "ペンのサイズを小さくした方がいいでしょうか？ わからない"}, {"type": "subtitle", "time": 1789.59, "timestamp": "00:29:49", "text": "。 かゆい。 えっと、日本語で書きますね"}, {"type": "subtitle", "time": 1792.95, "timestamp": "00:29:52", "text": "。 あと、私は間違ったツールを使っているのかもしれません"}, {"type": "subtitle", "time": 1795.43, "timestamp": "00:29:55", "text": "。   はい、どうぞ"}]
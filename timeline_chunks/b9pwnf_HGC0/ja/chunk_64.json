[{"type": "subtitle", "time": 3840.954, "timestamp": "01:04:00", "text": "漢字になったりしないことを願っています。 私には分からない。"}, {"type": "subtitle", "time": 3841.589, "timestamp": "01:04:01", "text": "[息を呑む]"}, {"type": "subtitle", "time": 3857.19, "timestamp": "01:04:17", "text": "うん、かなり"}, {"type": "subtitle", "time": 3859.829, "timestamp": "01:04:19", "text": "傷んでるね。 何"}, {"type": "subtitle", "time": 3862.309, "timestamp": "01:04:22", "text": "時間もここに閉じ込められたくない。 撮影期間はどれくらいですか"}, {"type": "subtitle", "time": 3880.549, "timestamp": "01:04:40", "text": "[笑い] 書けば書くほど、"}, {"type": "subtitle", "time": 3882.874, "timestamp": "01:04:42", "text": "この気持ちが強くなる。 何てことだ。"}, {"type": "subtitle", "time": 3883.829, "timestamp": "01:04:43", "text": "[笑い声と驚きの声]"}, {"type": "subtitle", "time": 3886.15, "timestamp": "01:04:46", "text": "わかった。"}]
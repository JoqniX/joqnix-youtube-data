[{"type": "subtitle", "time": 1683.909, "timestamp": "00:28:03", "text": "。"}, {"type": "subtitle", "time": 1686.31, "timestamp": "00:28:06", "text": "これを最小限に抑えてください。   こう考えてみてください"}, {"type": "subtitle", "time": 1689.43, "timestamp": "00:28:09", "text": "。   「"}, {"type": "subtitle", "time": 1691.51, "timestamp": "00:28:11", "text": "うん、コントロールできるよ」 そうそう"}, {"type": "subtitle", "time": 1694.87, "timestamp": "00:28:14", "text": "。 君たちにはこれは見えないよ。"}, {"type": "subtitle", "time": 1696.95, "timestamp": "00:28:16", "text": "あ、待って。 見ればわかりますよ。 わかった。 わかった。"}, {"type": "subtitle", "time": 1698.95, "timestamp": "00:28:18", "text": "フリックキャップショーはオンになっていると思います。   わかった"}, {"type": "subtitle", "time": 1700.549, "timestamp": "00:28:20", "text": "。 だから、あなたにはそれが見えるのです。 わかった。"}, {"type": "subtitle", "time": 1703.029, "timestamp": "00:28:23", "text": "こんにちは。 それでは、ここではこのように行います。 ここで"}, {"type": "subtitle", "time": 1706.389, "timestamp": "00:28:26", "text": "一緒に練習してみましょう。"}, {"type": "subtitle", "time": 1710.23, "timestamp": "00:28:30", "text": "よし、じゃあここで皆さんと一緒に練習してみましょう"}, {"type": "subtitle", "time": 1722.87, "timestamp": "00:28:42", "text": "こんにちは、キムさん。 あの、複製ページを作ってもいいですか？もしかしたら、"}, {"type": "subtitle", "time": 1728.31, "timestamp": "00:28:48", "text": "これに完全に集中できるかもしれません。"}, {"type": "subtitle", "time": 1731.99, "timestamp": "00:28:51", "text": "えっと、最後のプリセットの新しいものです。"}, {"type": "subtitle", "time": 1735.269, "timestamp": "00:28:55", "text": "おお、いいね。 素晴らしい。 英語なら、"}, {"type": "subtitle", "time": 1738.23, "timestamp": "00:28:58", "text": "これを閉じるだけでいい。"}]
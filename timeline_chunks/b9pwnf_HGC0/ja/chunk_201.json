[{"type": "subtitle", "time": 12067.99, "timestamp": "03:21:07", "text": "ええ、そんな感じです。 うん。 重要なポイント、そして"}, {"type": "subtitle", "time": 12081.11, "timestamp": "03:21:21", "text": "待って。 それとも右側もそうだったのでしょうか？"}, {"type": "subtitle", "time": 12083.03, "timestamp": "03:21:23", "text": "上段3人、下段2人。 うん。 うん。"}, {"type": "subtitle", "time": 12101.59, "timestamp": "03:21:41", "text": "こんな感じとか。"}, {"type": "subtitle", "time": 12104.389, "timestamp": "03:21:44", "text": "ここでそれを研究してみようと思います。"}, {"type": "subtitle", "time": 12111.99, "timestamp": "03:21:51", "text": "。 ああ、ありがとう、ありがとう、ありがとう、"}, {"type": "subtitle", "time": 12117.03, "timestamp": "03:21:57", "text": "ありがとう。 いいね。 今朝"}]
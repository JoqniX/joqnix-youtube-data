[{"type": "subtitle", "time": 23581.35, "timestamp": "06:33:01", "text": "、その通りです。 わかった。"}, {"type": "subtitle", "time": 23588.23, "timestamp": "06:33:08", "text": "30 30 31 32 33 34 35 36 37 38 38 [音楽]"}, {"type": "subtitle", "time": 23590.788, "timestamp": "06:33:10", "text": "39"}, {"type": "subtitle", "time": 23597.51, "timestamp": "06:33:17", "text": "38 30 そして 40 40 オーケー、これは 40 になりますよね"}, {"type": "subtitle", "time": 23599.75, "timestamp": "06:33:19", "text": "? ハリ・"}, {"type": "subtitle", "time": 23602.07, "timestamp": "06:33:22", "text": "ミギですよね"}, {"type": "subtitle", "time": 23603.35, "timestamp": "06:33:23", "text": "？"}, {"type": "subtitle", "time": 23607.11, "timestamp": "06:33:27", "text": "ハリミギは40字になります。 わかった。"}, {"type": "subtitle", "time": 23611.19, "timestamp": "06:33:31", "text": "それから、東、西、北西、東、"}, {"type": "subtitle", "time": 23614.868, "timestamp": "06:33:34", "text": "南、それらの漢字全部ですね"}, {"type": "subtitle", "time": 23616.788, "timestamp": "06:33:36", "text": "。"}, {"type": "subtitle", "time": 23619.67, "timestamp": "06:33:39", "text": "うん。"}, {"type": "subtitle", "time": 23622.548, "timestamp": "06:33:42", "text": "明日、何があっても"}, {"type": "subtitle", "time": 23630.39, "timestamp": "06:33:50", "text": "私はどんなことがあっても、100字すべての漢字を書けるようにならなければならない"}, {"type": "subtitle", "time": 23633.83, "timestamp": "06:33:53", "text": "。"}]
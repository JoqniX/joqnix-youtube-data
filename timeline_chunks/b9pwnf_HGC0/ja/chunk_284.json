[{"type": "subtitle", "time": 17043.51, "timestamp": "04:44:03", "text": "私は、あの英語の"}, {"type": "subtitle", "time": 17047.43, "timestamp": "04:44:07", "text": "映画やテレビ番組を見ていました。 いや、えっと、"}, {"type": "subtitle", "time": 17052.23, "timestamp": "04:44:12", "text": "何だったっけ？   『ザ・"}, {"type": "subtitle", "time": 17056.15, "timestamp": "04:44:16", "text": "オフィス』とか、そういう類のもの全部。"}, {"type": "subtitle", "time": 17062.708, "timestamp": "04:44:22", "text": "コンビニとか、"}, {"type": "chat", "time": 17065.665, "timestamp": "04:44:25", "author": "@FEROCIOUS_Grrr", "avatar": "https://yt4.ggpht.com/b2fcSyaRaGAEUJaW8yBs5ibxfiDi-brp1G8cHHTYAXKaRusaeuWU68kOjIUNWz1gmVNNSGP5MQ=s64-c-k-c0x00ffffff-no-rj", "message": "and the fact you saw me in someone's cHat is fricking Crazy 🤣 life sure is unpredictable"}, {"type": "subtitle", "time": 17065.75, "timestamp": "04:44:25", "text": "テレビ番組に出てくるようなもの全部。 いいえ、その後"}, {"type": "subtitle", "time": 17073.43, "timestamp": "04:44:33", "text": "エビを手に入れました。"}, {"type": "subtitle", "time": 17075.03, "timestamp": "04:44:35", "text": "ライブ配信をいくつかスクロールしていたら、"}, {"type": "subtitle", "time": 17077.51, "timestamp": "04:44:37", "text": "あなたを見かけました。 私は「なんてことだ」と思いました。 だから、"}, {"type": "subtitle", "time": 17080.708, "timestamp": "04:44:40", "text": "（笑い）"}, {"type": "subtitle", "time": 17082.55, "timestamp": "04:44:42", "text": "たくさんの人のチャットは本当に"}, {"type": "subtitle", "time": 17084.47, "timestamp": "04:44:44", "text": "クレイジーです。 ライブ配信は予測不可能だ。"}, {"type": "chat", "time": 17091.831, "timestamp": "04:44:51", "author": "@FEROCIOUS_Grrr", "avatar": "https://yt4.ggpht.com/b2fcSyaRaGAEUJaW8yBs5ibxfiDi-brp1G8cHHTYAXKaRusaeuWU68kOjIUNWz1gmVNNSGP5MQ=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/6_cfY8HJH8bV5QS5yYDYDg"}]
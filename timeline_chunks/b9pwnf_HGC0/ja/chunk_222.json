[{"type": "subtitle", "time": 13323.11, "timestamp": "03:42:03", "text": "他に何を見たっけ？ インダスト、ずっと前に"}, {"type": "subtitle", "time": 13325.03, "timestamp": "03:42:05", "text": "インダストを見たのを覚えている。それは嘘だ"}, {"type": "subtitle", "time": 13358.869, "timestamp": "03:42:38", "text": "とてもかわいい。"}, {"type": "subtitle", "time": 13359.91, "timestamp": "03:42:39", "text": "[咳払い]"}, {"type": "subtitle", "time": 13363.269, "timestamp": "03:42:43", "text": "えーと、彼は"}, {"type": "subtitle", "time": 13379.91, "timestamp": "03:42:59", "text": "鍵を間違えた。 ミスミスとキーを常に覚えておいてください"}]
[{"type": "subtitle", "time": 25924.07, "timestamp": "07:12:04", "text": "スマホを使っているときは、Ankiのデッキを使った学習だけをします。"}, {"type": "subtitle", "time": 25927.83, "timestamp": "07:12:07", "text": "本当にこれを終わらせたいんだよ。"}, {"type": "subtitle", "time": 25934.708, "timestamp": "07:12:14", "text": "これを終わらせて、"}, {"type": "subtitle", "time": 25970.31, "timestamp": "07:12:50", "text": "。   みなさん、こんにちは。ここで話を締めくくります"}, {"type": "subtitle", "time": 25978.15, "timestamp": "07:12:58", "text": "。"}]
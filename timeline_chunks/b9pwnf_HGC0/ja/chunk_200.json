[{"type": "subtitle", "time": 12015.269, "timestamp": "03:20:15", "text": "正直、数え方とかそういう練習を始めなきゃいけないな。"}, {"type": "subtitle", "time": 12018.07, "timestamp": "03:20:18", "text": "それで、"}, {"type": "subtitle", "time": 12020.63, "timestamp": "03:20:20", "text": "カウンターはまた別の"}, {"type": "subtitle", "time": 12028.309, "timestamp": "03:20:28", "text": "カレンダーはあなたがするすべてのもののカウンターです"}, {"type": "subtitle", "time": 12057.59, "timestamp": "03:20:57", "text": "モディ首相は今、こんな感じだ。 えっと、ちょっと待って"}]
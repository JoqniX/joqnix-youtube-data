[{"type": "subtitle", "time": 10289.67, "timestamp": "02:51:29", "text": "毎日練習しないと"}, {"type": "subtitle", "time": 10292.71, "timestamp": "02:51:32", "text": "忘れちゃうって聞いたよ、正直に言うとね。"}, {"type": "subtitle", "time": 10297.11, "timestamp": "02:51:37", "text": "今日配信が終わって"}, {"type": "subtitle", "time": 10301.51, "timestamp": "02:51:41", "text": "寝る前に、Any Manをやろうと思います。   正直言って、絶対に遅れを取りたくないんです"}, {"type": "subtitle", "time": 10308.499, "timestamp": "02:51:48", "text": "。"}, {"type": "subtitle", "time": 10310.55, "timestamp": "02:51:50", "text": "[音楽] だから、"}, {"type": "subtitle", "time": 10313.51, "timestamp": "02:51:53", "text": "正直に言うと、自分が遅れをとっていることは分かっていたのですが、"}, {"type": "subtitle", "time": 10318.469, "timestamp": "02:51:58", "text": "今日はなぜなのか分かりません。"}]
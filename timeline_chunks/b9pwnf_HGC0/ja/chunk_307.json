[{"type": "subtitle", "time": 18424.39, "timestamp": "05:07:04", "text": "ほら、私が彼を主な原因にしたってこと"}, {"type": "subtitle", "time": 18427.51, "timestamp": "05:07:07", "text": "？ 私は、あちらで"}, {"type": "subtitle", "time": 18431.59, "timestamp": "05:07:11", "text": "メインコーチとしてビデオ撮影をすることはできないと思います"}, {"type": "subtitle", "time": 18433.83, "timestamp": "05:07:13", "text": "。"}, {"type": "subtitle", "time": 18436.788, "timestamp": "05:07:16", "text": "代理店とかに入って、"}, {"type": "subtitle", "time": 18439.99, "timestamp": "05:07:19", "text": "企業とかで働くようになったら、もっといいですよね"}, {"type": "subtitle", "time": 18442.31, "timestamp": "05:07:22", "text": "？ 趣味が"}, {"type": "subtitle", "time": 18445.11, "timestamp": "05:07:25", "text": "会社の仕事、つまり"}, {"type": "subtitle", "time": 18447.67, "timestamp": "05:07:27", "text": "私の唯一のメインの仕事のようなものになってしまうからです"}, {"type": "subtitle", "time": 18451.43, "timestamp": "05:07:31", "text": "。 ああ、でも、たとえそうしたとしても、"}, {"type": "subtitle", "time": 18460.628, "timestamp": "05:07:40", "text": "パートタイムの仕事とか、給料をもらえるような大きな"}, {"type": "subtitle", "time": 18465.75, "timestamp": "05:07:45", "text": "会社とかでしかできないような副業もやらなきゃいけないし、それで"}, {"type": "subtitle", "time": 18471.51, "timestamp": "05:07:51", "text": "十分な収入は得られるけど、私の"}, {"type": "subtitle", "time": 18476.788, "timestamp": "05:07:56", "text": "経験から考えて、"}, {"type": "subtitle", "time": 18479.19, "timestamp": "05:07:59", "text": "マネジメントとかできるかもしれないと思ってた金額には全然及ばない。"}]
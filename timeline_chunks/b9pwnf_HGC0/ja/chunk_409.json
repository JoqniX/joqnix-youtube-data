[{"type": "subtitle", "time": 24565.83, "timestamp": "06:49:25", "text": "、それは"}, {"type": "subtitle", "time": 24570.868, "timestamp": "06:49:30", "text": "愚かなことを増やして私のストリームを終了しました。   一体"}, {"type": "subtitle", "time": 24576.788, "timestamp": "06:49:36", "text": "どういうことだ？ 私たちはただ"}, {"type": "subtitle", "time": 24584.468, "timestamp": "06:49:44", "text": "兄弟、一体何が、"}, {"type": "subtitle", "time": 24596.548, "timestamp": "06:49:56", "text": "現在のライブビデオを好きになるべきではないのか、これは作成されました"}]
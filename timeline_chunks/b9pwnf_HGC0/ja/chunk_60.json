[{"type": "subtitle", "time": 3603.43, "timestamp": "01:00:03", "text": "それから最後の行。"}, {"type": "subtitle", "time": 3606.15, "timestamp": "01:00:06", "text": "ああ、私の書き方って悪いよね"}, {"type": "subtitle", "time": 3607.99, "timestamp": "01:00:07", "text": "？   何てことだ"}, {"type": "chat", "time": 3620.454, "timestamp": "01:00:20", "author": "@hbvcsa", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mA5iYFWQWr-erQfOrpRSPi7uAL1ykOBKRSbPBDp88Z1xyBT7Je5IKp6_AckwgwsDEc-Q=s64-c-k-c0x00ffffff-no-rj", "message": "horray "}, {"type": "subtitle", "time": 3630.069, "timestamp": "01:00:30", "text": "。 わかった。 やったよ。 正しい。"}, {"type": "subtitle", "time": 3640.309, "timestamp": "01:00:40", "text": "注目いただきありがとうございます"}, {"type": "subtitle", "time": 3642.87, "timestamp": "01:00:42", "text": "。 ええ、でも、"}, {"type": "subtitle", "time": 3645.03, "timestamp": "01:00:45", "text": "間違った方法で覚えていたら、"}, {"type": "subtitle", "time": 3649.109, "timestamp": "01:00:49", "text": "全く別の漢字になっていたかもしれません。   何てことだ"}, {"type": "subtitle", "time": 3651.589, "timestamp": "01:00:51", "text": "。 ということは、私が"}, {"type": "subtitle", "time": 3654.276, "timestamp": "01:00:54", "text": "ずっと書いていた内容は間違っていたということでしょうか？"}, {"type": "subtitle", "time": 3654.95, "timestamp": "01:00:54", "text": "[笑い]"}, {"type": "subtitle", "time": 3657.589, "timestamp": "01:00:57", "text": "ああ、なんてことだ。   わかった"}]
[{"type": "subtitle", "time": 4022.95, "timestamp": "01:07:02", "text": "何ヶ月間学習していますか？  N5。 私は"}, {"type": "subtitle", "time": 4026.23, "timestamp": "01:07:06", "text": "最後にそれを覚えた。 えっと、私は"}, {"type": "subtitle", "time": 4028.95, "timestamp": "01:07:08", "text": "2ヶ月以内にN5をクリアしました。"}, {"type": "subtitle", "time": 4031.561, "timestamp": "01:07:11", "text": "それから私は日本語の練習を全くしなくなりました。"}, {"type": "chat", "time": 4032.159, "timestamp": "01:07:12", "author": "@hbvcsa", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mA5iYFWQWr-erQfOrpRSPi7uAL1ykOBKRSbPBDp88Z1xyBT7Je5IKp6_AckwgwsDEc-Q=s64-c-k-c0x00ffffff-no-rj", "message": "Its my 6th month and i am 22 years Old "}, {"type": "subtitle", "time": 4032.71, "timestamp": "01:07:12", "text": "[笑い]"}, {"type": "subtitle", "time": 4035.19, "timestamp": "01:07:15", "text": "私は、ええと、読んだり、書いたり、"}, {"type": "subtitle", "time": 4036.87, "timestamp": "01:07:16", "text": "練習を続けたりは全くしませんでした"}, {"type": "subtitle", "time": 4040.95, "timestamp": "01:07:20", "text": "。  [鼻を鳴らす] ええと、"}, {"type": "subtitle", "time": 4045.43, "timestamp": "01:07:25", "text": "私のコースは去年の12月に始まりました。"}, {"type": "subtitle", "time": 4047.27, "timestamp": "01:07:27", "text": "ええ、去年の12月にコースが始まりました。 私は"}, {"type": "subtitle", "time": 4052.309, "timestamp": "01:07:32", "text": "2月にNAT Q5試験を受けました。 それで、"}, {"type": "subtitle", "time": 4056.23, "timestamp": "01:07:36", "text": "2か月以内に、ええと、"}, {"type": "subtitle", "time": 4060.95, "timestamp": "01:07:40", "text": "N5レベルで、NAT試験を受けました。"}, {"type": "subtitle", "time": 4064.069, "timestamp": "01:07:44", "text": "それから、日本の"}, {"type": "subtitle", "time": 4067.029, "timestamp": "01:07:47", "text": "語学学校に行って、"}, {"type": "subtitle", "time": 4073.99, "timestamp": "01:07:53", "text": "N4からN1かN2くらいまで勉強する予定だったんだけど、最後の瞬間に"}, {"type": "subtitle", "time": 4076.87, "timestamp": "01:07:56", "text": "いろいろあって、いくつか変更があったんだ"}]
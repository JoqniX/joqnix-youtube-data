[{"type": "subtitle", "time": 13382.309, "timestamp": "03:43:02", "text": "。 そしてまた（咳払い）"}, {"type": "subtitle", "time": 13386.309, "timestamp": "03:43:06", "text": "そうですね。 そしてまた、"}, {"type": "chat", "time": 13388.714, "timestamp": "03:43:08", "author": "@NamanRajput-n8w", "avatar": "https://yt4.ggpht.com/I6iqd552DDv0-h99h5Wdf--ghvHwCddgcMGIkvGcK0nm2x2lAQfpfnw3D79kzo0NRZohHO_a=s64-c-k-c0x00ffffff-no-rj", "message": "im a big fan of cristopher nolan"}, {"type": "subtitle", "time": 13392.309, "timestamp": "03:43:12", "text": "1、2、3、1、2、3、そしてゲット。"}, {"type": "subtitle", "time": 13398.07, "timestamp": "03:43:18", "text": "私はクリストファー・ノーランの大ファンです。 ああ、"}, {"type": "subtitle", "time": 13404.07, "timestamp": "03:43:24", "text": "[笑い]"}, {"type": "subtitle", "time": 13410.469, "timestamp": "03:43:30", "text": "お湯を汲んでくるよ"}, {"type": "subtitle", "time": 13413.75, "timestamp": "03:43:33", "text": "。 こんにちは。"}, {"type": "subtitle", "time": 13415.99, "timestamp": "03:43:35", "text": "私たちはやり遂げました。"}, {"type": "subtitle", "time": 13419.13, "timestamp": "03:43:39", "text": "私は実際にそれを実行しました。"}, {"type": "subtitle", "time": 13419.91, "timestamp": "03:43:39", "text": "[笑い]"}, {"type": "subtitle", "time": 13422.63, "timestamp": "03:43:42", "text": "わあ。   わかった"}, {"type": "subtitle", "time": 13425.51, "timestamp": "03:43:45", "text": "。 それでは、"}, {"type": "subtitle", "time": 13428.95, "timestamp": "03:43:48", "text": "次の制御シフトを準備してください。N。右。"}, {"type": "subtitle", "time": 13433.349, "timestamp": "03:43:53", "text": "新しいレイヤー。 わかった。 そこに点を打っておいてください。"}, {"type": "subtitle", "time": 13436.389, "timestamp": "03:43:56", "text": "これについては後でまた触れます。"}, {"type": "subtitle", "time": 13439.99, "timestamp": "03:43:59", "text": "15分くらい休憩を取ります。"}]
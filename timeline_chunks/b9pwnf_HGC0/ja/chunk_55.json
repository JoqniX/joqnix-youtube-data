[{"type": "subtitle", "time": 3301.75, "timestamp": "00:55:01", "text": "えっと。  3つだと思う。 うん。"}, {"type": "subtitle", "time": 3304.95, "timestamp": "00:55:04", "text": "うん。 何てことだ。"}, {"type": "subtitle", "time": 3321.27, "timestamp": "00:55:21", "text": "レイはどうだったっけ？   了解"}, {"type": "subtitle", "time": 3325.27, "timestamp": "00:55:25", "text": "。 えっと、"}, {"type": "subtitle", "time": 3326.95, "timestamp": "00:55:26", "text": "待って。 わかった。 えっと、正しい"}, {"type": "subtitle", "time": 3329.51, "timestamp": "00:55:29", "text": "形式ではないけど、まあいいでしょう。 わかった。 レイはそういう人だった"}, {"type": "subtitle", "time": 3332.15, "timestamp": "00:55:32", "text": "。 こんにちは。 何てことだ。 忘れていたなんて信じられない"}, {"type": "subtitle", "time": 3342.79, "timestamp": "00:55:42", "text": "。 とんでもない。 忘れてたよ（笑）"}, {"type": "subtitle", "time": 3357.349, "timestamp": "00:55:57", "text": "なあ、もし俺がこんな状態だったら、もし俺が"}]
[{"type": "subtitle", "time": 15063.59, "timestamp": "04:11:03", "text": "モデルを誰かに依頼できれば、"}, {"type": "subtitle", "time": 15066.63, "timestamp": "04:11:06", "text": "高額になるでしょうが、"}, {"type": "subtitle", "time": 15072.55, "timestamp": "04:11:12", "text": "ストリーミングなどに戻ってきたとき、"}, {"type": "subtitle", "time": 15074.55, "timestamp": "04:11:14", "text": "友人が"}, {"type": "subtitle", "time": 15078.389, "timestamp": "04:11:18", "text": "VRチャットのハロウィンパーティーに招待してくれたんです。 それで、"}, {"type": "subtitle", "time": 15081.83, "timestamp": "04:11:21", "text": "私の友人が当時VOモデルを作ろうとしたのです"}, {"type": "subtitle", "time": 15089.11, "timestamp": "04:11:29", "text": "が、VRチャットにアップロードできませんでした。"}, {"type": "subtitle", "time": 15092.15, "timestamp": "04:11:32", "text": "そうですね、"}, {"type": "subtitle", "time": 15094.79, "timestamp": "04:11:34", "text": "私も自分でやってみようと思っています。たぶん数"}, {"type": "subtitle", "time": 15098.389, "timestamp": "04:11:38", "text": "週間後か、そうですね、12月か12月頃かな"}, {"type": "subtitle", "time": 15100.229, "timestamp": "04:11:40", "text": "。"}, {"type": "subtitle", "time": 15103.51, "timestamp": "04:11:43", "text": "試験期間中なので、今はすごく忙しいです。 何かするかもしれないけど、"}, {"type": "subtitle", "time": 15107.75, "timestamp": "04:11:47", "text": "void ストリームとか何かするかもしれないけど、そこにあることを示す"}, {"type": "subtitle", "time": 15110.71, "timestamp": "04:11:50", "text": "void モデルを作ってみます"}, {"type": "subtitle", "time": 15112.95, "timestamp": "04:11:52", "text": "。"}, {"type": "subtitle", "time": 15115.269, "timestamp": "04:11:55", "text": "うん。"}, {"type": "subtitle", "time": 15116.79, "timestamp": "04:11:56", "text": "ああ、[ため息]"}]
[{"type": "subtitle", "time": 23341.19, "timestamp": "06:29:01", "text": "今ここで話を終えた方がいいと思う？ 今は"}, {"type": "subtitle", "time": 23343.59, "timestamp": "06:29:03", "text": "6時です。 では、そろそろ話を終えた方がいいでしょうか"}, {"type": "subtitle", "time": 23346.23, "timestamp": "06:29:06", "text": "？ 今すぐ寝なさい"}, {"type": "subtitle", "time": 23352.39, "timestamp": "06:29:12", "text": "。 午前6時に起きて勉強を始め、"}, {"type": "subtitle", "time": 23356.948, "timestamp": "06:29:16", "text": "朝から配信をします。 前回の続きから始める"}, {"type": "subtitle", "time": 23362.708, "timestamp": "06:29:22", "text": "か、4つ後に始めるか。 わかった。   そっちのほうが"}, {"type": "subtitle", "time": 23381.11, "timestamp": "06:29:41", "text": "ああ、そうだった。"}]
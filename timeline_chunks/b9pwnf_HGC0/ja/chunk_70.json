[{"type": "subtitle", "time": 4202.55, "timestamp": "01:10:02", "text": "独学で日本語を習得して、合格して、"}, {"type": "chat", "time": 4203.198, "timestamp": "01:10:03", "author": "@hbvcsa", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mA5iYFWQWr-erQfOrpRSPi7uAL1ykOBKRSbPBDp88Z1xyBT7Je5IKp6_AckwgwsDEc-Q=s64-c-k-c0x00ffffff-no-rj", "message": "Jibun De Benkyo Shimashita "}, {"type": "subtitle", "time": 4204.79, "timestamp": "01:10:04", "text": "優勝したんです。   それは"}, {"type": "chat", "time": 4222.232, "timestamp": "01:10:22", "author": "@hbvcsa", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mA5iYFWQWr-erQfOrpRSPi7uAL1ykOBKRSbPBDp88Z1xyBT7Je5IKp6_AckwgwsDEc-Q=s64-c-k-c0x00ffffff-no-rj", "message": "じぶんで勉強しました"}, {"type": "subtitle", "time": 4222.55, "timestamp": "01:10:22", "text": "あなたはこれまで、物事を先延ばしにしたり、「やりたく"}, {"type": "subtitle", "time": 4224.31, "timestamp": "01:10:24", "text": "ない」と感じたりしたことはありますか"}, {"type": "subtitle", "time": 4253.51, "timestamp": "01:10:53", "text": "書き順はちょっと悪いかもしれないけど、"}]
[{"type": "subtitle", "time": 2161.91, "timestamp": "00:36:01", "text": "1 2 3。 ああ、上がってる。 そうそう。"}, {"type": "subtitle", "time": 2163.91, "timestamp": "00:36:03", "text": "ああ、忘れてた。 真ん中のほうが"}, {"type": "subtitle", "time": 2166.95, "timestamp": "00:36:06", "text": "短い方がいいと思う。"}, {"type": "subtitle", "time": 2171.27, "timestamp": "00:36:11", "text": "大丈夫。 こんにちは。 次はヤンです。"}, {"type": "subtitle", "time": 2174.15, "timestamp": "00:36:14", "text": "えっと、ストローを書くのはクーチーになります。 つまり、"}, {"type": "subtitle", "time": 2178.95, "timestamp": "00:36:18", "text": "1 2 3 4"}, {"type": "subtitle", "time": 2181.91, "timestamp": "00:36:21", "text": "1 2 3"}, {"type": "subtitle", "time": 2185.43, "timestamp": "00:36:25", "text": "4。 そして最後に、5つ目。"}, {"type": "subtitle", "time": 2189.349, "timestamp": "00:36:29", "text": "１、２、３、４。 私もそれできます。   糸、糸"}]
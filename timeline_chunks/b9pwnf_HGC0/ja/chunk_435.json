[{"type": "subtitle", "time": 26101.91, "timestamp": "07:15:01", "text": "。"}, {"type": "subtitle", "time": 26105.99, "timestamp": "07:15:05", "text": "午前7時に始めます。わかりました。でも、たとえ"}, {"type": "subtitle", "time": 26112.548, "timestamp": "07:15:12", "text": "疲れていて、眠くて、不器用でも、6時に起きなければならないことを覚えておいてください。"}, {"type": "subtitle", "time": 26116.708, "timestamp": "07:15:16", "text": "えっと、不器用じゃなくて、レースが"}, {"type": "subtitle", "time": 26119.99, "timestamp": "07:15:19", "text": "ベッドに張り付いてるんです。 どんなことがあっても、私は目を覚ます。そうしなければならない。"}, {"type": "subtitle", "time": 26130.07, "timestamp": "07:15:30", "text": "うん。"}, {"type": "subtitle", "time": 26133.35, "timestamp": "07:15:33", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 26135.67, "timestamp": "07:15:35", "text": "こんにちは。 誰か"}, {"type": "subtitle", "time": 26137.59, "timestamp": "07:15:37", "text": "寝る？"}, {"type": "subtitle", "time": 26140.948, "timestamp": "07:15:40", "text": "本日はありがとうございました。"}, {"type": "subtitle", "time": 26149.91, "timestamp": "07:15:49", "text": "ありがとうございます。 今日は、私たちの「一緒に"}, {"type": "subtitle", "time": 26154.468, "timestamp": "07:15:54", "text": "勉強しよう」配信に、本当にたくさんの人が来てくれました。"}, {"type": "subtitle", "time": 26157.43, "timestamp": "07:15:57", "text": "とても良かったです。 皆さん楽しんでいただけたでしょうか。"}]
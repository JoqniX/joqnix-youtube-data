[{"type": "subtitle", "time": 21741.19, "timestamp": "06:02:21", "text": "忘れてしまった場合のために言っておきますが、文字通り"}, {"type": "subtitle", "time": 21746.628, "timestamp": "06:02:26", "text": "砂なのですが、一番下の線は"}, {"type": "subtitle", "time": 21752.07, "timestamp": "06:02:32", "text": "砂の中に線が入っていて、2本の線になっています。"}, {"type": "subtitle", "time": 21756.788, "timestamp": "06:02:36", "text": "そして、もうひとつ小さな"}, {"type": "subtitle", "time": 21759.75, "timestamp": "06:02:39", "text": "手。   よし"}, {"type": "subtitle", "time": 21761.43, "timestamp": "06:02:41", "text": "。"}, {"type": "subtitle", "time": 21771.83, "timestamp": "06:02:51", "text": "アシは、私が"}, {"type": "subtitle", "time": 21775.11, "timestamp": "06:02:55", "text": "忘れてしまうようなものだと感じます。"}, {"type": "subtitle", "time": 21776.788, "timestamp": "06:02:56", "text": "アッシュは、私が"}]
[{"type": "subtitle", "time": 1330.325, "timestamp": "00:22:10", "text": "12年？什么？什么？发生过吗？"}, {"type": "subtitle", "time": 1336.49, "timestamp": "00:22:16", "text": "这么久？等等，什么？我的天哪。"}, {"type": "subtitle", "time": 1339.994, "timestamp": "00:22:19", "text": "我的天哪。已经过去好久了，不是吗？"}, {"type": "subtitle", "time": 1356.937, "timestamp": "00:22:36", "text": "哇。那不是很长一段时间吗？是的，就是这个"}, {"type": "subtitle", "time": 1359.078, "timestamp": "00:22:39", "text": "今年我打算更多地采用这种风格。"}, {"type": "subtitle", "time": 1363.132, "timestamp": "00:22:43", "text": "日本人。我们需要多加练习。"}, {"type": "subtitle", "time": 1375.667, "timestamp": "00:22:55", "text": "他会说日语，等等。我要 ……这些直播将更倾向于以下风格："}, {"type": "subtitle", "time": 1378.011, "timestamp": "00:22:58", "text": "……这些直播将更倾向于以下风格： 日本人。为了提高口语能力，"}]
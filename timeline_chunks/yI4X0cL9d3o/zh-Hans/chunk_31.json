[{"type": "subtitle", "time": 1861.826, "timestamp": "00:31:01", "text": "已被静音。请"}, {"type": "subtitle", "time": 1867.613, "timestamp": "00:31:07", "text": "等待。好的。没关系？好的。"}, {"type": "subtitle", "time": 1873.215, "timestamp": "00:31:13", "text": "不能。我该如何把它藏起来？好了，就是这样。"}, {"type": "subtitle", "time": 1876.455, "timestamp": "00:31:16", "text": "有。这些是什么？好了，就这些。"}, {"type": "subtitle", "time": 1881.193, "timestamp": "00:31:21", "text": "好的。没关系。我的上帝。哦，"}, {"type": "subtitle", "time": 1885.857, "timestamp": "00:31:25", "text": "哇。还剩55分钟。是的。他们去了"}, {"type": "subtitle", "time": 1887.851, "timestamp": "00:31:27", "text": "买汽水、饮料之类的东西。"}, {"type": "subtitle", "time": 1895.258, "timestamp": "00:31:35", "text": "我想应该是软饮料。再见。再见。嘿，"}, {"type": "subtitle", "time": 1901.129, "timestamp": "00:31:41", "text": "我希望不是什么棘手的事情。"}, {"type": "subtitle", "time": 1905.659, "timestamp": "00:31:45", "text": "疯狂的。问题是，我现在通常不这样做。"}, {"type": "subtitle", "time": 1907.624, "timestamp": "00:31:47", "text": "隆重地庆祝我的生日"}, {"type": "subtitle", "time": 1913.699, "timestamp": "00:31:53", "text": "绝非如此。嗯，因为所有这些"}, {"type": "subtitle", "time": 1915.846, "timestamp": "00:31:55", "text": "多年来，我一直和家人一起庆祝这个节日。"}, {"type": "subtitle", "time": 1918.112, "timestamp": "00:31:58", "text": "那一刻终于到来了，我的朋友"}]
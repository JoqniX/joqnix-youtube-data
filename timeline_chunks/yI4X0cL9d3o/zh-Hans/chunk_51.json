[{"type": "subtitle", "time": 3066.925, "timestamp": "00:51:06", "text": "花点时间陪陪我。嗯，我想要"}, {"type": "subtitle", "time": 3068.702, "timestamp": "00:51:08", "text": "玩游戏或社区游戏"}, {"type": "chat", "time": 3069.253, "timestamp": "00:51:09", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "I'll for sure, sorry I haven't been able to catch up on stuff 😭"}, {"type": "subtitle", "time": 3076.925, "timestamp": "00:51:16", "text": "我们在一起，但我的心却有些东西，有些东西在我心中"}, {"type": "subtitle", "time": 3078.835, "timestamp": "00:51:18", "text": "他觉得自己应该这么做，但现在还不应该。"}, {"type": "subtitle", "time": 3087.889, "timestamp": "00:51:27", "text": "总有一天，但不是今天。那个东西。是的，因为"}, {"type": "subtitle", "time": 3090.263, "timestamp": "00:51:30", "text": "那是因为，比如说，我一直没……"}, {"type": "subtitle", "time": 3092.84, "timestamp": "00:51:32", "text": "通过举办这些社区活动和"}, {"type": "subtitle", "time": 3097.486, "timestamp": "00:51:37", "text": "类似的事情每个人都会遇到。我想我已经有了"}, {"type": "subtitle", "time": 3099.176, "timestamp": "00:51:39", "text": "我一直待在自己的空间里，或者在我的"}, {"type": "chat", "time": 3104.402, "timestamp": "00:51:44", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "Take your time for sure!"}, {"type": "subtitle", "time": 3106.183, "timestamp": "00:51:46", "text": "我的外壳，但我依然是我"}, {"type": "subtitle", "time": 3108.237, "timestamp": "00:51:48", "text": "我很感激你。"}, {"type": "subtitle", "time": 3112.338, "timestamp": "00:51:52", "text": "我的“星座们”。我的，呃，不，”"}, {"type": "subtitle", "time": 3115.158, "timestamp": "00:51:55", "text": "“这不是他们喜欢的，”这些杰出的导演们说道。 正确的？ “音乐会唱片”？是的，所有人"}, {"type": "subtitle", "time": 3117.876, "timestamp": "00:51:57", "text": "正确的？ “音乐会唱片”？是的，所有人 他们过去常说：“是的，我们希望你……”"}]
[{"type": "subtitle", "time": 2822.389, "timestamp": "00:47:02", "text": "虽然那次变速箱出了问题，但我"}, {"type": "subtitle", "time": 2824.449, "timestamp": "00:47:04", "text": "很高兴我们能看到烟花。"}, {"type": "subtitle", "time": 2827.165, "timestamp": "00:47:07", "text": "人造物放在一起。我不能"}, {"type": "subtitle", "time": 2829.964, "timestamp": "00:47:09", "text": "在传输过程中捕获它。出色地，"}, {"type": "subtitle", "time": 2832.163, "timestamp": "00:47:12", "text": "这意义重大。虽然这意味着"}, {"type": "subtitle", "time": 2835.346, "timestamp": "00:47:15", "text": "很多。做这些事是好事。是的。"}, {"type": "subtitle", "time": 2843.257, "timestamp": "00:47:23", "text": "嗯。是的。这是我现在想要克服的。"}, {"type": "subtitle", "time": 2850.574, "timestamp": "00:47:30", "text": "这是因为我害羞。我无法，呃，开发"}, {"type": "subtitle", "time": 2852.954, "timestamp": "00:47:32", "text": "那种信心依然，我的意思是，依然"}, {"type": "subtitle", "time": 2855.267, "timestamp": "00:47:35", "text": "我需要走出自己的舒适圈，"}, {"type": "subtitle", "time": 2858.589, "timestamp": "00:47:38", "text": "多和人交谈。等待。做得更多"}, {"type": "subtitle", "time": 2860.703, "timestamp": "00:47:40", "text": "日本朋友，还有，呃，聊天和"}, {"type": "subtitle", "time": 2863.043, "timestamp": "00:47:43", "text": "提高我的日语水平。这就是我的目标。"}, {"type": "subtitle", "time": 2866.094, "timestamp": "00:47:46", "text": "我的目标之一，嗯，在我……"}, {"type": "subtitle", "time": 2871.095, "timestamp": "00:47:51", "text": "在这里，而且，我不知道，日语说得更好一些。"}]
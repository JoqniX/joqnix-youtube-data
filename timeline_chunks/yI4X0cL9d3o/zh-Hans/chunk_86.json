[{"type": "subtitle", "time": 5160.372, "timestamp": "01:26:00", "text": "与朋友们一起过生日，感谢三月。"}, {"type": "subtitle", "time": 5162.771, "timestamp": "01:26:02", "text": "我要和你一起度过，所以不用了。"}, {"type": "subtitle", "time": 5167.407, "timestamp": "01:26:07", "text": "担心。嗯。欢迎艾丽莎。"}, {"type": "subtitle", "time": 5171.066, "timestamp": "01:26:11", "text": "还剩一分钟。上帝。还剩一分钟。"}, {"type": "subtitle", "time": 5179.911, "timestamp": "01:26:19", "text": "50秒3秒。 50秒。但"}, {"type": "subtitle", "time": 5188.99, "timestamp": "01:26:28", "text": "今天是我的生日。应该"}, {"type": "subtitle", "time": 5192.774, "timestamp": "01:26:32", "text": "如何开始？我从30开始。"}, {"type": "subtitle", "time": 5198.297, "timestamp": "01:26:38", "text": "好吧。再见。满满的爱和"}, {"type": "subtitle", "time": 5201.317, "timestamp": "01:26:41", "text": "祝你幸福。谢谢。感觉"}, {"type": "subtitle", "time": 5203.238, "timestamp": "01:26:43", "text": "自由撰写生日祝福"}, {"type": "subtitle", "time": 5204.967, "timestamp": "01:26:44", "text": "如果你还没有在董事会上这样做的话"}, {"type": "subtitle", "time": 5219.371, "timestamp": "01:26:59", "text": "马罗卡。 20 19 18 17 16 14 15 12 7 10 9"}]
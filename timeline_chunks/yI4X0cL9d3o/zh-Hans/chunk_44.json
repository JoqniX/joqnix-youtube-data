[{"type": "subtitle", "time": 2640.769, "timestamp": "00:44:00", "text": "我做这件事，而且我喜欢做这件事，等等。"}, {"type": "subtitle", "time": 2646.501, "timestamp": "00:44:06", "text": "我的意思是，我对它充满热情，我简直为之疯狂。"}, {"type": "subtitle", "time": 2648.763, "timestamp": "00:44:08", "text": "但就内容和其他方面而言，"}, {"type": "subtitle", "time": 2651.213, "timestamp": "00:44:11", "text": "我只想尽我所能做到最好。"}, {"type": "subtitle", "time": 2653.538, "timestamp": "00:44:13", "text": "创作优质内容等等，"}, {"type": "subtitle", "time": 2655.926, "timestamp": "00:44:15", "text": "更多的新人或那些已经"}, {"type": "chat", "time": 2657.734, "timestamp": "00:44:17", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "Yeah that's a beautiful wish!! "}, {"type": "subtitle", "time": 2658.062, "timestamp": "00:44:18", "text": "他们能够回来吗？"}, {"type": "subtitle", "time": 2663.744, "timestamp": "00:44:23", "text": "跟我说话。那意义非凡。"}, {"type": "subtitle", "time": 2668.675, "timestamp": "00:44:28", "text": "为我。是的，我只是希望"}, {"type": "subtitle", "time": 2671.153, "timestamp": "00:44:31", "text": "我对自己的工作感到非常满意。"}, {"type": "subtitle", "time": 2676.404, "timestamp": "00:44:36", "text": "我的信念，我的愿望。好的"}, {"type": "subtitle", "time": 2679.599, "timestamp": "00:44:39", "text": "工作。接下来，还有什么？"}, {"type": "subtitle", "time": 2681.78, "timestamp": "00:44:41", "text": "人们来和我交谈，还有那些"}, {"type": "subtitle", "time": 2689.542, "timestamp": "00:44:49", "text": "事物。是的，是的，我太疯狂了。"}, {"type": "subtitle", "time": 2691.865, "timestamp": "00:44:51", "text": "我千里迢迢来到日本都是因为YouTube。"}, {"type": "subtitle", "time": 2694.128, "timestamp": "00:44:54", "text": "我超迷YouTube之类的东西。"}]
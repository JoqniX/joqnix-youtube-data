[{"type": "subtitle", "time": 1920.378, "timestamp": "00:32:00", "text": "我想，童年也即将到来。"}, {"type": "subtitle", "time": 1922.525, "timestamp": "00:32:02", "text": "在我上一个生日那天，我想我"}, {"type": "subtitle", "time": 1924.911, "timestamp": "00:32:04", "text": "我想，我儿时的朋友当时也在场。 。不，不，不，不，等等，他不在那里"}, {"type": "subtitle", "time": 1928.265, "timestamp": "00:32:08", "text": "。不，不，不，不，等等，他不在那里 在那边。对不起，对不起，对不起"}, {"type": "subtitle", "time": 1930.497, "timestamp": "00:32:10", "text": "在那边。对不起，对不起，对不起 忘了它。那时我来到了"}, {"type": "subtitle", "time": 1932.503, "timestamp": "00:32:12", "text": "忘了它。那时我来到了 日本，就是机场那件事。但"}, {"type": "subtitle", "time": 1934.719, "timestamp": "00:32:14", "text": "日本，就是机场那件事。但 这很重要。但通常情况下，是的"}, {"type": "subtitle", "time": 1937.385, "timestamp": "00:32:17", "text": "这很重要。但通常情况下，是的 我和我的家人一起庆祝。"}, {"type": "subtitle", "time": 1943.804, "timestamp": "00:32:23", "text": "我和我的家人一起庆祝。 是的。是的。而这一次，只有我一个人。"}, {"type": "subtitle", "time": 1949.803, "timestamp": "00:32:29", "text": "是的。是的。而这一次，只有我一个人。 我自己，和你，然后和我的"}, {"type": "subtitle", "time": 1951.793, "timestamp": "00:32:31", "text": "我自己，和你，然后和我的 朋友们在这里，还有我的……等一下。"}, {"type": "subtitle", "time": 1956.802, "timestamp": "00:32:36", "text": "朋友们在这里，还有我的……等一下。 我，我，我不知道为什么会有这种感觉。"}, {"type": "subtitle", "time": 1962.859, "timestamp": "00:32:42", "text": "我，我，我不知道为什么会有这种感觉。 我想念和家人一起庆祝的日子。哦，"}, {"type": "subtitle", "time": 1969.067, "timestamp": "00:32:49", "text": "我想念和家人一起庆祝的日子。哦， 今天我出去买鸡肉的时候"}, {"type": "subtitle", "time": 1971.234, "timestamp": "00:32:51", "text": "今天我出去买鸡肉的时候 其他所需成分"}, {"type": "subtitle", "time": 1973.4, "timestamp": "00:32:53", "text": "其他所需成分 今晚要做饭什么的。我当时想："}, {"type": "subtitle", "time": 1979.983, "timestamp": "00:32:59", "text": "今晚要做饭什么的。我当时想： “哇，感觉不像是在日本。”"}]
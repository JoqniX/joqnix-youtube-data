[{"type": "subtitle", "time": 438.546, "timestamp": "00:07:18", "text": "今天是个好日子。今天真是累坏了。有"}, {"type": "subtitle", "time": 440.775, "timestamp": "00:07:20", "text": "与其工作，不如奔波于各个地方之间。"}, {"type": "subtitle", "time": 443.005, "timestamp": "00:07:23", "text": "我要买东西，因为我要整理东西。"}, {"type": "subtitle", "time": 448.733, "timestamp": "00:07:28", "text": "今晚有个派对。嗯，我当时"}, {"type": "subtitle", "time": 454.688, "timestamp": "00:07:34", "text": "心想……他们对我很照顾。"}, {"type": "subtitle", "time": 459.916, "timestamp": "00:07:39", "text": "还有我的室友。所以"}, {"type": "subtitle", "time": 462.246, "timestamp": "00:07:42", "text": "我想给他们办个派对，因为"}, {"type": "subtitle", "time": 464.577, "timestamp": "00:07:44", "text": "今年之后他们就不会来了。 他们会分开。他们会遵循自己的道路。"}, {"type": "subtitle", "time": 468.974, "timestamp": "00:07:48", "text": "他们会分开。他们会遵循自己的道路。 在前往他们想去的任何地方的路上等等。"}, {"type": "subtitle", "time": 476.033, "timestamp": "00:07:56", "text": "我将与他们分离。所以，嗯 是的，我希望这将是美好的一天。"}]
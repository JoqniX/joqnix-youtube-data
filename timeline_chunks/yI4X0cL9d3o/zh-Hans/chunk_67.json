[{"type": "subtitle", "time": 4021.981, "timestamp": "01:07:01", "text": "第二台摄像机就是这个。不，怎么会这样"}, {"type": "subtitle", "time": 4025.631, "timestamp": "01:07:05", "text": "我该如何更换摄像头？"}, {"type": "subtitle", "time": 4028.09, "timestamp": "01:07:08", "text": "选择其他摄像头。嘿 我不能吗？我们转到……"}, {"type": "subtitle", "time": 4029.931, "timestamp": "01:07:09", "text": "我不能吗？我们转到…… 左右。我们一直是"}, {"type": "subtitle", "time": 4031.575, "timestamp": "01:07:11", "text": "左右。我们一直是 放大和缩小，就像"}, {"type": "subtitle", "time": 4033.523, "timestamp": "01:07:13", "text": "放大和缩小，就像 暂时先从左到右。让我"}, {"type": "subtitle", "time": 4040.105, "timestamp": "01:07:20", "text": "暂时先从左到右。让我 降低我的敏感度，这样我就不会"}, {"type": "subtitle", "time": 4041.794, "timestamp": "01:07:21", "text": "降低我的敏感度，这样我就不会 听听背景声音。我有一些"}, {"type": "subtitle", "time": 4047.754, "timestamp": "01:07:27", "text": "听听背景声音。我有一些 房间里有客人，因为，呃，我"}, {"type": "subtitle", "time": 4050.038, "timestamp": "01:07:30", "text": "房间里有客人，因为，呃，我 他们今晚将陪伴我们……"}, {"type": "subtitle", "time": 4052.022, "timestamp": "01:07:32", "text": "他们今晚将陪伴我们…… 一起来庆祝我的生日吧。我是"}, {"type": "subtitle", "time": 4057.346, "timestamp": "01:07:37", "text": "一起来庆祝我的生日吧。我是 我非常感谢你的到来。"}, {"type": "subtitle", "time": 4059.443, "timestamp": "01:07:39", "text": "我非常感谢你的到来。 零食之类的东西。此外，19"}, {"type": "subtitle", "time": 4067.954, "timestamp": "01:07:47", "text": "零食之类的东西。此外，19 分钟。我的上帝。我的上帝。还剩"}, {"type": "subtitle", "time": 4070.938, "timestamp": "01:07:50", "text": "分钟。我的上帝。我的上帝。还剩 19分钟。什么？什么？什么？什么"}, {"type": "subtitle", "time": 4076.147, "timestamp": "01:07:56", "text": "19分钟。什么？什么？什么？什么 ？那？我的天哪，兄弟。他"}]
[{"type": "subtitle", "time": 300.27, "timestamp": "00:05:00", "text": "所以，是的，对于那些不了解的人来说，"}, {"type": "subtitle", "time": 302.603, "timestamp": "00:05:02", "text": "今晚是我的生日"}, {"type": "subtitle", "time": 308.059, "timestamp": "00:05:08", "text": "日本时间现在是中午12点。所以我是"}, {"type": "subtitle", "time": 312.958, "timestamp": "00:05:12", "text": "有点紧张。嗯，我还有客人。"}, {"type": "subtitle", "time": 317.398, "timestamp": "00:05:17", "text": "今天在家里的卧室里。嗯，"}, {"type": "subtitle", "time": 319.835, "timestamp": "00:05:19", "text": "一些朋友和高年级的学生。"}, {"type": "subtitle", "time": 325.811, "timestamp": "00:05:25", "text": "嗯，呃，是啊，也许……这里没人。"}, {"type": "subtitle", "time": 330.476, "timestamp": "00:05:30", "text": "现在他们在这里，但他们还会来的。所以不"}, {"type": "subtitle", "time": 332.486, "timestamp": "00:05:32", "text": "我肯定能顺利直播。"}, {"type": "subtitle", "time": 334.178, "timestamp": "00:05:34", "text": "恰当，因为我觉得"}, {"type": "subtitle", "time": 335.976, "timestamp": "00:05:35", "text": "当有人在场时，我会感到不自在。"}, {"type": "subtitle", "time": 341.086, "timestamp": "00:05:41", "text": "房间。所以，是的，就是这样。"}, {"type": "subtitle", "time": 350.998, "timestamp": "00:05:50", "text": "杰出的。这很棒。不，在部分"}, {"type": "subtitle", "time": 353.165, "timestamp": "00:05:53", "text": "屏幕底部有一个账户"}, {"type": "subtitle", "time": 359.068, "timestamp": "00:05:59", "text": "倒计时显示剩余时间"}]
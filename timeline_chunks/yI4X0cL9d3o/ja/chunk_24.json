[{"type": "subtitle", "time": 1441.617, "timestamp": "00:24:01", "text": "最高の自分。しかし、もし。私は幸せです"}, {"type": "subtitle", "time": 1445.093, "timestamp": "00:24:05", "text": "今。一体どういうことだ？ 2年前のことだけど"}, {"type": "subtitle", "time": 1447.887, "timestamp": "00:24:07", "text": "私は何時間も非常にストレスを感じていました。だった"}, {"type": "subtitle", "time": 1450.74, "timestamp": "00:24:10", "text": "空を見上げる。明らかだった、"}, {"type": "subtitle", "time": 1453.977, "timestamp": "00:24:13", "text": "雲もほとんどなくて、そんな感じだった。私は見ることができた"}, {"type": "subtitle", "time": 1456.509, "timestamp": "00:24:16", "text": "星も何もかも。何か買おうと思って出かけたんだけど…"}, {"type": "subtitle", "time": 1458.601, "timestamp": "00:24:18", "text": "パーティー用の食料品を買う"}, {"type": "subtitle", "time": 1461.807, "timestamp": "00:24:21", "text": "今夜。私は買いに出かけました"}, {"type": "subtitle", "time": 1463.587, "timestamp": "00:24:23", "text": "今夜のパーティーに必要なもの。"}, {"type": "subtitle", "time": 1469.726, "timestamp": "00:24:29", "text": "それで、私のルームメイトのクイン"}, {"type": "subtitle", "time": 1472.111, "timestamp": "00:24:32", "text": "彼女は料理もするし、食材の準備もするし、何もかもやってくれる。"}, {"type": "subtitle", "time": 1478.137, "timestamp": "00:24:38", "text": "それ。そして私は盛大な宴を開く。そしてもし、"}, {"type": "subtitle", "time": 1481.826, "timestamp": "00:24:41", "text": "ただ見ていただけです。わかった。に向かって"}]
[{"type": "subtitle", "time": 4803.722, "timestamp": "01:20:03", "text": "いいえ、では1番を選びましょう。とても良い。"}, {"type": "subtitle", "time": 4808.733, "timestamp": "01:20:08", "text": "そしてその時が近づいたら、私たちは"}, {"type": "subtitle", "time": 4819.858, "timestamp": "01:20:19", "text": "そんな風に心地よく感じる。わかった。 7分。いいえ、"}, {"type": "subtitle", "time": 4825.207, "timestamp": "01:20:25", "text": "いやいや。 6分。こんにちは。何てことだ。"}, {"type": "subtitle", "time": 4839.411, "timestamp": "01:20:39", "text": "今日は私の番号をやりました、私は"}, {"type": "subtitle", "time": 4846.946, "timestamp": "01:20:46", "text": "これを聞いてください。ああ、どうぞお座りください"}, {"type": "subtitle", "time": 4848.987, "timestamp": "01:20:48", "text": "まだ書いていない人は、自由に願い事を書いてください。"}]
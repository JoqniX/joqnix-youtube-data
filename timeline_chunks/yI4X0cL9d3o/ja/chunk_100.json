[{"type": "subtitle", "time": 6001.511, "timestamp": "01:40:01", "text": "とても幸せです。星々が"}, {"type": "subtitle", "time": 6003.666, "timestamp": "01:40:03", "text": "星明かりが彼らを導きますように"}, {"type": "subtitle", "time": 6005.767, "timestamp": "01:40:05", "text": "光よ、星々が彼らを導きますように"}, {"type": "subtitle", "time": 6017.197, "timestamp": "01:40:17", "text": "星明かり。こんにちは。バイバイ。いいえ"}, {"type": "subtitle", "time": 6019.078, "timestamp": "01:40:19", "text": "空を見るのを忘れて、空を"}, {"type": "subtitle", "time": 6023.474, "timestamp": "01:40:23", "text": "今夜の夜。そう、あれだ"}, {"type": "subtitle", "time": 6025.742, "timestamp": "01:40:25", "text": "私は輝く星になるでしょう"}, {"type": "subtitle", "time": 6031.845, "timestamp": "01:40:31", "text": "私は今日生まれました。こんにちは。ぜひご覧ください。わかった 。見てください、午前 3 時頃です。あるいは何か"}, {"type": "subtitle", "time": 6034.58, "timestamp": "01:40:34", "text": "。見てください、午前 3 時頃です。あるいは何か それで。いやいや。午前0時を見てください。"}, {"type": "subtitle", "time": 6037.707, "timestamp": "01:40:37", "text": "それで。いやいや。午前0時を見てください。 現地時間。インドでは、もし彼らが"}, {"type": "subtitle", "time": 6040.062, "timestamp": "01:40:40", "text": "現地時間。インドでは、もし彼らが インド出身の人、あるいは日本出身の人なら、それを見ることができる"}, {"type": "subtitle", "time": 6042.492, "timestamp": "01:40:42", "text": "インド出身の人、あるいは日本出身の人なら、それを見ることができる 今夜の今ですが、はい、"}, {"type": "subtitle", "time": 6044.678, "timestamp": "01:40:44", "text": "今夜の今ですが、はい、 とにかく、こんにちは。おやすみなさい。"}, {"type": "subtitle", "time": 6046.925, "timestamp": "01:40:46", "text": "とにかく、こんにちは。おやすみなさい。 皆さん、さようなら。お元気ですか？"}]
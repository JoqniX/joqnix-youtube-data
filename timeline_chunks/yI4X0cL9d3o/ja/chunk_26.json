[{"type": "subtitle", "time": 1561.071, "timestamp": "00:26:01", "text": "今夜は現実世界でパーティーだ。"}, {"type": "subtitle", "time": 1563.619, "timestamp": "00:26:03", "text": "現実世界でも今日は私の誕生日です"}, {"type": "subtitle", "time": 1566.476, "timestamp": "00:26:06", "text": "本物。おめでとうございます。ありがとう。"}, {"type": "subtitle", "time": 1570.211, "timestamp": "00:26:10", "text": "ありがとう。ああ、あなたの1日が素晴らしいものになりますように"}, {"type": "subtitle", "time": 1575.176, "timestamp": "00:26:15", "text": "良い。お元気でお過ごしでしょうか。ありがとう"}, {"type": "subtitle", "time": 1579.189, "timestamp": "00:26:19", "text": "ご登録ありがとうございます。ありがとう。私はただ"}, {"type": "subtitle", "time": 1587.591, "timestamp": "00:26:27", "text": "見てみて。ありがとう。ありがとう。順調に進んでいます。だった"}, {"type": "subtitle", "time": 1589.278, "timestamp": "00:26:29", "text": "初めてコラボレーションなしで"}, {"type": "subtitle", "time": 1591.573, "timestamp": "00:26:31", "text": "一緒に。それ以来、私たちはあまり協力していません"}, {"type": "chat", "time": 1592.075, "timestamp": "00:26:32", "author": "@GEN-ZGAMER_016", "avatar": "https://yt4.ggpht.com/w6_tXF6pcPRJxaHVquDoUdIUzRyBMVG9FPodnFMEAijY59dYsj76nqjBDkTRDcLXhK2h1KRG6A=s64-c-k-c0x00ffffff-no-rj", "message": "🎉🎉🎉"}, {"type": "subtitle", "time": 1593.707, "timestamp": "00:26:33", "text": "そうですよね？そうですね、そう願うばかりです。"}, {"type": "subtitle", "time": 1595.731, "timestamp": "00:26:35", "text": "我々にはチャンスがある"}, {"type": "subtitle", "time": 1605.737, "timestamp": "00:26:45", "text": "未来。皆さん、ようこそ。として"}, {"type": "subtitle", "time": 1611.217, "timestamp": "00:26:51", "text": "は？元気です。私は少し"}, {"type": "subtitle", "time": 1613.288, "timestamp": "00:26:53", "text": "えっと、さっきちょっとストレスが溜まってたんだけど、"}, {"type": "subtitle", "time": 1617.336, "timestamp": "00:26:57", "text": "放送に向けてたくさん準備をしました。えっと 今夜はパーティーがあるんだ。私は"}]
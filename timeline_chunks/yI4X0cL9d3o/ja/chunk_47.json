[{"type": "subtitle", "time": 2822.389, "timestamp": "00:47:02", "text": "そのトランスミッションは故障したが、"}, {"type": "subtitle", "time": 2824.449, "timestamp": "00:47:04", "text": "花火を見ることができてよかった。"}, {"type": "subtitle", "time": 2827.165, "timestamp": "00:47:07", "text": "人工的なもの同士を一緒に。私はできませんでした"}, {"type": "subtitle", "time": 2829.964, "timestamp": "00:47:09", "text": "送信時にそれを捉える。良い、"}, {"type": "subtitle", "time": 2832.163, "timestamp": "00:47:12", "text": "それはとても大きな意味がありました。それはつまり"}, {"type": "subtitle", "time": 2835.346, "timestamp": "00:47:15", "text": "たくさん。そういうことをするのは良いことだ。うん。"}, {"type": "subtitle", "time": 2843.257, "timestamp": "00:47:23", "text": "うん。はい。私が今、克服したいと思っていること。"}, {"type": "subtitle", "time": 2850.574, "timestamp": "00:47:30", "text": "それは私の恥ずかしがり屋な性格のせいなんです。私は、えーと、開発できません"}, {"type": "subtitle", "time": 2852.954, "timestamp": "00:47:32", "text": "その自信は今も、つまり、今も"}, {"type": "subtitle", "time": 2855.267, "timestamp": "00:47:35", "text": "私は殻を破って、"}, {"type": "subtitle", "time": 2858.589, "timestamp": "00:47:38", "text": "人々と話す。待って。もっと行動しよう"}, {"type": "subtitle", "time": 2860.703, "timestamp": "00:47:40", "text": "日本人の友達と、えーと話してみて"}, {"type": "subtitle", "time": 2863.043, "timestamp": "00:47:43", "text": "日本語を上達させたい。それが私の目標です。"}, {"type": "subtitle", "time": 2866.094, "timestamp": "00:47:46", "text": "私の目標の一つは、えっと、私が"}, {"type": "subtitle", "time": 2871.095, "timestamp": "00:47:51", "text": "ここで、そして、わからないけど、もっと日本語を話します"}]
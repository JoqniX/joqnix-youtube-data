[{"type": "subtitle", "time": 3066.925, "timestamp": "00:51:06", "text": "そして、私と一緒に時間を過ごしてください。えっと、私は"}, {"type": "subtitle", "time": 3068.702, "timestamp": "00:51:08", "text": "ゲームやコミュニティゲームをプレイする"}, {"type": "chat", "time": 3069.253, "timestamp": "00:51:09", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "I'll for sure, sorry I haven't been able to catch up on stuff 😭"}, {"type": "subtitle", "time": 3076.925, "timestamp": "00:51:16", "text": "一緒にいるけれど、私の心の中には何かがある"}, {"type": "subtitle", "time": 3078.835, "timestamp": "00:51:18", "text": "彼はそうすべきだと感じているが、まだそうすべきではない。"}, {"type": "subtitle", "time": 3087.889, "timestamp": "00:51:27", "text": "いつかはそうなるだろうが、今日ではない。あれ。はい、なぜなら"}, {"type": "subtitle", "time": 3090.263, "timestamp": "00:51:30", "text": "それは、私が今まで"}, {"type": "subtitle", "time": 3092.84, "timestamp": "00:51:32", "text": "これらのコミュニティイベントを実施し、"}, {"type": "subtitle", "time": 3097.486, "timestamp": "00:51:37", "text": "誰にでもそういうことはあるものだ。私は持っていると思います"}, {"type": "subtitle", "time": 3099.176, "timestamp": "00:51:39", "text": "自分の空間にいたり、"}, {"type": "chat", "time": 3104.402, "timestamp": "00:51:44", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "Take your time for sure!"}, {"type": "subtitle", "time": 3106.183, "timestamp": "00:51:46", "text": "自分の殻、でもそれは紛れもなく私"}, {"type": "subtitle", "time": 3108.237, "timestamp": "00:51:48", "text": "あなたが"}, {"type": "subtitle", "time": 3112.338, "timestamp": "00:51:52", "text": "私の「星座」たち。いや、いや、"}, {"type": "subtitle", "time": 3115.158, "timestamp": "00:51:55", "text": "「それは彼らの好みではない」と、一流の監督たちは語った。 右？ 「コンサートプレート」？はい、皆さん"}, {"type": "subtitle", "time": 3117.876, "timestamp": "00:51:57", "text": "右？ 「コンサートプレート」？はい、皆さん 彼らは以前は「はい、私たちはあなたに…してほしいのです」と言っていました。"}]
[{"type": "subtitle", "time": 3961.21, "timestamp": "01:06:01", "text": "神よ、彼らは方法を見つけた。これはどうなっているのか？"}, {"type": "subtitle", "time": 3965.877, "timestamp": "01:06:05", "text": "イベントに参加しようとしたことはありますか？"}, {"type": "subtitle", "time": 3969.428, "timestamp": "01:06:09", "text": "昨年からコミュニティメンバーですか？いいえ、"}, {"type": "subtitle", "time": 3973.503, "timestamp": "01:06:13", "text": "真実？はい、遊ぶのが大好きです。わかった、"}, {"type": "subtitle", "time": 3977.619, "timestamp": "01:06:17", "text": "それは良い。質問があります。おお、"}, {"type": "subtitle", "time": 3984.22, "timestamp": "01:06:24", "text": "うん。やってみて、やってみて、結果を教えてください。わかった。お知らせ下さい"}, {"type": "subtitle", "time": 3986.45, "timestamp": "01:06:26", "text": "はい、ええと、それを投稿しようと思います"}, {"type": "subtitle", "time": 3988.21, "timestamp": "01:06:28", "text": "Discordサーバー"}, {"type": "subtitle", "time": 3991.229, "timestamp": "01:06:31", "text": "そこで入手可能です。つまり、今は分からないんです。"}, {"type": "subtitle", "time": 3993.306, "timestamp": "01:06:33", "text": "私はDiscordサーバーを持っています。それで"}, {"type": "subtitle", "time": 3996.947, "timestamp": "01:06:36", "text": "彼らは合格できる。彼はあまり活動的ではないが、"}, {"type": "subtitle", "time": 3998.792, "timestamp": "01:06:38", "text": "はい、そこで受け取ることは可能です。"}, {"type": "subtitle", "time": 4000.883, "timestamp": "01:06:40", "text": "通知やその他のすべてを実行するとき"}, {"type": "subtitle", "time": 4004.707, "timestamp": "01:06:44", "text": "ストリーミング配信。ああ、そうだ、そこに何か投稿するよ。"}, {"type": "subtitle", "time": 4006.349, "timestamp": "01:06:46", "text": "私たちがイベントを開催するとき"}, {"type": "subtitle", "time": 4006.932, "timestamp": "01:06:46", "text": "コミュニティ。"}, {"type": "subtitle", "time": 4015.53, "timestamp": "01:06:55", "text": "はい、それで大丈夫です。というわけで、えーと、"}, {"type": "subtitle", "time": 4017.902, "timestamp": "01:06:57", "text": "待って、カメラ2はどれ？の"}]
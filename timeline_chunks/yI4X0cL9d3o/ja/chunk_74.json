[{"type": "subtitle", "time": 4440.055, "timestamp": "01:14:00", "text": "はい、興味がありました。もし"}, {"type": "subtitle", "time": 4442.006, "timestamp": "01:14:02", "text": "私が見逃したスキルは、"}, {"type": "subtitle", "time": 4445.777, "timestamp": "01:14:05", "text": "もう一度学び直すとか、そんな感じのことですね。しかし"}, {"type": "subtitle", "time": 4447.781, "timestamp": "01:14:07", "text": "はい、今のところはそうしないでおこうと思います。"}, {"type": "subtitle", "time": 4460.276, "timestamp": "01:14:20", "text": "今はやりません。でも、みんな"}, {"type": "subtitle", "time": 4466.025, "timestamp": "01:14:26", "text": "ルームメイトとか、そういう人たち。私は推測する"}, {"type": "subtitle", "time": 4470.956, "timestamp": "01:14:30", "text": "そして私の部屋。えっと、待って、私は"}, {"type": "subtitle", "time": 4474.691, "timestamp": "01:14:34", "text": "ストリームの画質がどれほど悪いか見てください。いいえ"}, {"type": "subtitle", "time": 4479.662, "timestamp": "01:14:39", "text": "聞いています。あれが音声ですか？それ 何…神よ。とても静かだ。"}, {"type": "subtitle", "time": 4491.615, "timestamp": "01:14:51", "text": "そうなんですか？"}, {"type": "subtitle", "time": 4496.092, "timestamp": "01:14:56", "text": "まあ、聞こえない"}]
[{"type": "subtitle", "time": 1861.826, "timestamp": "00:31:01", "text": "それは沈黙した。お願いします"}, {"type": "subtitle", "time": 1867.613, "timestamp": "00:31:07", "text": "待って。良い。それで大丈夫です？わかった。"}, {"type": "subtitle", "time": 1873.215, "timestamp": "00:31:13", "text": "できません。どうすれば隠せる？はい、"}, {"type": "subtitle", "time": 1876.455, "timestamp": "00:31:16", "text": "持っている。彼らは何ですか？はい、以上です。"}, {"type": "subtitle", "time": 1881.193, "timestamp": "00:31:21", "text": "良い。それで大丈夫です。我が神よ。おお、"}, {"type": "subtitle", "time": 1885.857, "timestamp": "00:31:25", "text": "おお。残り時間は55分です。はい。彼らは"}, {"type": "subtitle", "time": 1887.851, "timestamp": "00:31:27", "text": "炭酸飲料とか飲み物とか、そういうものを買う。"}, {"type": "subtitle", "time": 1895.258, "timestamp": "00:31:35", "text": "ソフトドリンクだと思う。バイバイ。バイバイ。おい、"}, {"type": "subtitle", "time": 1901.129, "timestamp": "00:31:41", "text": "慌ただしいこととかじゃないといいんだけど。"}, {"type": "subtitle", "time": 1905.659, "timestamp": "00:31:45", "text": "クレイジー。問題は、私は普段は"}, {"type": "subtitle", "time": 1907.624, "timestamp": "00:31:47", "text": "私の誕生日を盛大に祝うか、"}, {"type": "subtitle", "time": 1913.699, "timestamp": "00:31:53", "text": "全く違います。えっと、これら全て"}, {"type": "subtitle", "time": 1915.846, "timestamp": "00:31:55", "text": "何年も家族とそれを祝ってきました"}, {"type": "subtitle", "time": 1918.112, "timestamp": "00:31:58", "text": "私の友人が"}]
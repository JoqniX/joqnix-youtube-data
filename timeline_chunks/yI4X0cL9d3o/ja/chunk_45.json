[{"type": "subtitle", "time": 2701.074, "timestamp": "00:45:01", "text": "音楽。私はすでにこれらの場所に行ったことがあります"}, {"type": "subtitle", "time": 2707.888, "timestamp": "00:45:07", "text": "日本のユーチューバーについて。 es が見える気がする"}, {"type": "subtitle", "time": 2709.805, "timestamp": "00:45:09", "text": "ユーチューバーエージェンシーみたいなもの"}, {"type": "subtitle", "time": 2715.206, "timestamp": "00:45:15", "text": "それで。あと少しだったのに、惜しかった。"}, {"type": "subtitle", "time": 2717.448, "timestamp": "00:45:17", "text": "私は行くことができた、後になってそれに気づいた"}, {"type": "subtitle", "time": 2719.411, "timestamp": "00:45:19", "text": "私が本社に行くことができた"}, {"type": "subtitle", "time": 2724.079, "timestamp": "00:45:24", "text": "ホロライブ。私は港にいて、その日"}, {"type": "subtitle", "time": 2728.584, "timestamp": "00:45:28", "text": "俺は港に行ったんだ、兄さん、俺ならできたはずだ。"}, {"type": "chat", "time": 2732.748, "timestamp": "00:45:32", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "WHY NOT"}, {"type": "subtitle", "time": 2732.978, "timestamp": "00:45:32", "text": "作った。彼は私にとってとても親しい存在だった。しかし"}, {"type": "subtitle", "time": 2737.954, "timestamp": "00:45:37", "text": "私も行くことができたはずだ。知りませんでした。しかし、もし、"}, {"type": "subtitle", "time": 2744.827, "timestamp": "00:45:44", "text": "待って。次回はそうします。うん、"}, {"type": "subtitle", "time": 2747.078, "timestamp": "00:45:47", "text": "次回はそうします。それは"}, {"type": "subtitle", "time": 2754.598, "timestamp": "00:45:54", "text": "良い。次回。そして今年は、"}, {"type": "subtitle", "time": 2756.936, "timestamp": "00:45:56", "text": "日本に来てから、"}, {"type": "subtitle", "time": 2759.474, "timestamp": "00:45:59", "text": "新しいことをして見せる、"}]
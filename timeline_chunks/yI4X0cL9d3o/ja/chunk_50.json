[{"type": "subtitle", "time": 3001.578, "timestamp": "00:50:01", "text": "ここにいる人たち。うーん、まだやってないなら"}, {"type": "subtitle", "time": 3003.85, "timestamp": "00:50:03", "text": "彼らは誕生日の願いを書いた"}, {"type": "subtitle", "time": 3006.064, "timestamp": "00:50:06", "text": "誕生日ボード、座って"}, {"type": "subtitle", "time": 3011.978, "timestamp": "00:50:11", "text": "そうするのは自由です。リンク先にあります"}, {"type": "subtitle", "time": 3014.044, "timestamp": "00:50:14", "text": "説明文と、えーと、"}, {"type": "chat", "time": 3019.85, "timestamp": "00:50:19", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "I wrote o7"}, {"type": "subtitle", "time": 3020.189, "timestamp": "00:50:20", "text": "固定されたコメント。待って、"}, {"type": "subtitle", "time": 3021.976, "timestamp": "00:50:21", "text": "正しく入れたか確認してください。"}, {"type": "subtitle", "time": 3026.122, "timestamp": "00:50:26", "text": "説明。はい、それです。ありがとう。"}, {"type": "subtitle", "time": 3033.044, "timestamp": "00:50:33", "text": "明日は読書をします、明日は、えっと、"}, {"type": "subtitle", "time": 3037.014, "timestamp": "00:50:37", "text": "それを読んでください。パーティーも開催されます"}, {"type": "subtitle", "time": 3039.968, "timestamp": "00:50:39", "text": "後。 12日には"}, {"type": "subtitle", "time": 3045.8, "timestamp": "00:50:45", "text": "アフターパーティーみたいなもの。来る"}]
[{"type": "subtitle", "time": 1021.354, "timestamp": "00:17:01", "text": "事前に準備されたもの。私は読めません"}, {"type": "subtitle", "time": 1025.82, "timestamp": "00:17:05", "text": "それ。別の色に替えてみようかな。"}, {"type": "subtitle", "time": 1029.024, "timestamp": "00:17:09", "text": "ええ、白の方が良いですね。"}, {"type": "subtitle", "time": 1031.971, "timestamp": "00:17:11", "text": "白の方が良い。はい。はい。はい。はい。"}, {"type": "subtitle", "time": 1044.209, "timestamp": "00:17:24", "text": "ああ、あの小さなもの。はい。はい。はい。私は。"}, {"type": "subtitle", "time": 1057.846, "timestamp": "00:17:37", "text": "心配しないで。しかし彼らは、ああ神よ、"}, {"type": "subtitle", "time": 1064.065, "timestamp": "00:17:44", "text": "私の筆跡。読みやすいですよね？うん 。良い。判読可能です。私はそれが好きです。私はそれが好きです。"}, {"type": "subtitle", "time": 1072.367, "timestamp": "00:17:52", "text": "ああ、でも、えーと、スターデー、あなたは"}]
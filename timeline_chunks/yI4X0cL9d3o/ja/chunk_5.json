[{"type": "subtitle", "time": 300.27, "timestamp": "00:05:00", "text": "そう、知らない人のために言っておくと、"}, {"type": "subtitle", "time": 302.603, "timestamp": "00:05:02", "text": "今夜は私の誕生日です"}, {"type": "subtitle", "time": 308.059, "timestamp": "00:05:08", "text": "日本では12時です。だから私は"}, {"type": "subtitle", "time": 312.958, "timestamp": "00:05:12", "text": "少し緊張している。えっと、来客があるんです"}, {"type": "subtitle", "time": 317.398, "timestamp": "00:05:17", "text": "今日は自宅の寝室で。えっと、"}, {"type": "subtitle", "time": 319.835, "timestamp": "00:05:19", "text": "友人や年上の生徒たち。"}, {"type": "subtitle", "time": 325.811, "timestamp": "00:05:25", "text": "えーと、ああ、そうかも…ここには誰もいない"}, {"type": "subtitle", "time": 330.476, "timestamp": "00:05:30", "text": "今はここにいるが、いずれ来るだろう。いいえ"}, {"type": "subtitle", "time": 332.486, "timestamp": "00:05:32", "text": "配信はできると思う"}, {"type": "subtitle", "time": 334.178, "timestamp": "00:05:34", "text": "適切だと思うので"}, {"type": "subtitle", "time": 335.976, "timestamp": "00:05:35", "text": "誰かがいると自意識過剰になる"}, {"type": "subtitle", "time": 341.086, "timestamp": "00:05:41", "text": "部屋。そうなんです、そうです"}, {"type": "subtitle", "time": 350.998, "timestamp": "00:05:50", "text": "素晴らしい。それは素晴らしい。いいえ、その部分では"}, {"type": "subtitle", "time": 353.165, "timestamp": "00:05:53", "text": "画面下部にアカウントがあります"}, {"type": "subtitle", "time": 359.068, "timestamp": "00:05:59", "text": "残り時間（分）のカウントダウン"}]
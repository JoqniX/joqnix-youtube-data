[{"type": "subtitle", "time": 1330.325, "timestamp": "00:22:10", "text": "12年？何？何？実際に起こったのか？"}, {"type": "subtitle", "time": 1336.49, "timestamp": "00:22:16", "text": "さよなら？え、何？ああ、神様。"}, {"type": "subtitle", "time": 1339.994, "timestamp": "00:22:19", "text": "ああ、なんてことだ。本当に久しぶりですね。"}, {"type": "subtitle", "time": 1356.937, "timestamp": "00:22:36", "text": "おお。それってすごく長い時間じゃない？はい、これです"}, {"type": "subtitle", "time": 1359.078, "timestamp": "00:22:39", "text": "今年はもっとこのスタイルを取り入れるつもりです"}, {"type": "subtitle", "time": 1363.132, "timestamp": "00:22:43", "text": "日本語。もっと練習する必要がある。"}, {"type": "subtitle", "time": 1375.667, "timestamp": "00:22:55", "text": "彼は日本語も話せるし、いろいろ話せるんだ。私は ...これらは、より次のようなスタイルのストリームになります。"}, {"type": "subtitle", "time": 1378.011, "timestamp": "00:22:58", "text": "...これらは、より次のようなスタイルのストリームになります。 日本語。スピーキングスキルを向上させるために、"}]
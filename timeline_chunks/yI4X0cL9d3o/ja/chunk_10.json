[{"type": "subtitle", "time": 603.302, "timestamp": "00:10:03", "text": "ようこそ、ようこそ。時間がない"}, {"type": "subtitle", "time": 608.268, "timestamp": "00:10:08", "text": "全くない。ええと、今日"}, {"type": "subtitle", "time": 610.804, "timestamp": "00:10:10", "text": "私も、うーん、いや、という感じでした。"}, {"type": "subtitle", "time": 614.958, "timestamp": "00:10:14", "text": "私はかなり準備することができました。私は"}, {"type": "subtitle", "time": 617.11, "timestamp": "00:10:17", "text": "帽子の材料を探す"}, {"type": "subtitle", "time": 619.501, "timestamp": "00:10:19", "text": "誕生日だよ、それを着るんだ"}, {"type": "subtitle", "time": 622.127, "timestamp": "00:10:22", "text": "頭。言ったように、「わかった、"}, {"type": "subtitle", "time": 624.431, "timestamp": "00:10:24", "text": "明日は誕生日配信です"}, {"type": "subtitle", "time": 627.555, "timestamp": "00:10:27", "text": "本物。だから、何か行動を起こすことにします。"}, {"type": "subtitle", "time": 629.834, "timestamp": "00:10:29", "text": "今日私はただこう言った。「よし、私は"}, {"type": "subtitle", "time": 632.062, "timestamp": "00:10:32", "text": "「即興でやってみます。」だから、即興でやってみるよ。"}, {"type": "subtitle", "time": 635.559, "timestamp": "00:10:35", "text": "ちゃんと配信できるかどうかも分かりません。"}, {"type": "subtitle", "time": 637.976, "timestamp": "00:10:37", "text": "今日は、ええと、そう言ってもいいでしょう。"}, {"type": "subtitle", "time": 640.525, "timestamp": "00:10:40", "text": "私は今、注目を浴びている"}, {"type": "subtitle", "time": 643.988, "timestamp": "00:10:43", "text": "同じ。私は注目を浴びている。"}, {"type": "subtitle", "time": 649.092, "timestamp": "00:10:49", "text": "今夜はあまり何もできないかもしれない。"}, {"type": "subtitle", "time": 651.006, "timestamp": "00:10:51", "text": "なぜなら私にはゲストがいるから、"}, {"type": "subtitle", "time": 653.088, "timestamp": "00:10:53", "text": "現実の友達と先輩たち"}, {"type": "subtitle", "time": 656.538, "timestamp": "00:10:56", "text": "今日は私と一緒に。ええと、現在入手できません"}, {"type": "subtitle", "time": 658.99, "timestamp": "00:10:58", "text": "部屋の中で。彼らは"}]
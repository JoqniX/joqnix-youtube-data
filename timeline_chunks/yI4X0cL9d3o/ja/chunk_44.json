[{"type": "subtitle", "time": 2640.769, "timestamp": "00:44:00", "text": "私はそれをやっているし、それをやっているのも好きだし、何も問題ない。"}, {"type": "subtitle", "time": 2646.501, "timestamp": "00:44:06", "text": "つまり、私はそれに情熱を注いでいるし、夢中になっている。"}, {"type": "subtitle", "time": 2648.763, "timestamp": "00:44:08", "text": "しかし、内容やその他すべてに関しては、"}, {"type": "subtitle", "time": 2651.213, "timestamp": "00:44:11", "text": "私はただベストを尽くしたいだけです"}, {"type": "subtitle", "time": 2653.538, "timestamp": "00:44:13", "text": "良質なコンテンツなどを作成する、"}, {"type": "subtitle", "time": 2655.926, "timestamp": "00:44:15", "text": "より多くの新規の人々またはすでに"}, {"type": "chat", "time": 2657.734, "timestamp": "00:44:17", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "Yeah that's a beautiful wish!! "}, {"type": "subtitle", "time": 2658.062, "timestamp": "00:44:18", "text": "彼らは戻ってくることができるのか"}, {"type": "subtitle", "time": 2663.744, "timestamp": "00:44:23", "text": "私に話して。それはとても大きな意味を持つでしょう。"}, {"type": "subtitle", "time": 2668.675, "timestamp": "00:44:28", "text": "私にとって。はい、私はただ"}, {"type": "subtitle", "time": 2671.153, "timestamp": "00:44:31", "text": "自分の仕事に本当に満足しています"}, {"type": "subtitle", "time": 2676.404, "timestamp": "00:44:36", "text": "私が信じること、私がやりたいこと。良い"}, {"type": "subtitle", "time": 2679.599, "timestamp": "00:44:39", "text": "仕事。次に、他に何があるだろうか"}, {"type": "subtitle", "time": 2681.78, "timestamp": "00:44:41", "text": "人々が私に話しかけてきて、"}, {"type": "subtitle", "time": 2689.542, "timestamp": "00:44:49", "text": "もの。そう、そう、私は狂っている"}, {"type": "subtitle", "time": 2691.865, "timestamp": "00:44:51", "text": "YouTubeがきっかけで日本まで来ました"}, {"type": "subtitle", "time": 2694.128, "timestamp": "00:44:54", "text": "私はYouTubeとかそういうのが大好きなんです。"}]
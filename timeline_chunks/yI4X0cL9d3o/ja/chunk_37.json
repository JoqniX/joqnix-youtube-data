[{"type": "subtitle", "time": 2222.638, "timestamp": "00:37:02", "text": "グラデーションが必要です。それはやりすぎだ。 明るい。それ...？私はできると思う"}, {"type": "subtitle", "time": 2225.732, "timestamp": "00:37:05", "text": "明るい。それ...？私はできると思う この閃光で何かをする"}, {"type": "subtitle", "time": 2227.24, "timestamp": "00:37:07", "text": "この閃光で何かをする 星。フラッシュ。ええと、そうしてください。そのような"}, {"type": "subtitle", "time": 2232.954, "timestamp": "00:37:12", "text": "星。フラッシュ。ええと、そうしてください。そのような 時間飽和。いや、いや、いや、いや。"}, {"type": "subtitle", "time": 2236.233, "timestamp": "00:37:16", "text": "時間飽和。いや、いや、いや、いや。 強度。いいえ。無線しきい値です。いいえ"}, {"type": "subtitle", "time": 2240.282, "timestamp": "00:37:20", "text": "強度。いいえ。無線しきい値です。いいえ もっと色々試してみるべきね。必要"}, {"type": "subtitle", "time": 2244.124, "timestamp": "00:37:24", "text": "もっと色々試してみるべきね。必要 色補正と適切な照明。"}, {"type": "subtitle", "time": 2250.47, "timestamp": "00:37:30", "text": "はい、天候の影響です。なぜなら"}, {"type": "subtitle", "time": 2253.211, "timestamp": "00:37:33", "text": "雨が降っていますか？では、"}, {"type": "subtitle", "time": 2255.866, "timestamp": "00:37:35", "text": "しかし、ここには良いものは何もない。さらに遠く"}, {"type": "subtitle", "time": 2261.557, "timestamp": "00:37:41", "text": "雪。今は雪の季節ではない。私は思う"}, {"type": "subtitle", "time": 2264.08, "timestamp": "00:37:44", "text": "私はこんなことができます...それがサクラです。"}, {"type": "subtitle", "time": 2266.777, "timestamp": "00:37:46", "text": "桜のスタイルは適切ではありません。"}, {"type": "subtitle", "time": 2268.763, "timestamp": "00:37:48", "text": "ひらめきが必要だと思う"}, {"type": "subtitle", "time": 2271.434, "timestamp": "00:37:51", "text": "今夜。はい、それが私のものになったら"}, {"type": "subtitle", "time": 2273.797, "timestamp": "00:37:53", "text": "誕生日には、紙吹雪を飾ります。しかし"}, {"type": "subtitle", "time": 2278.817, "timestamp": "00:37:58", "text": "はい、とりあえず、これでいきましょう。それらの"}]
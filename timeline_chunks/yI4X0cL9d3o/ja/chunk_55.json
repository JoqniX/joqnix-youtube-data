[{"type": "subtitle", "time": 3300.211, "timestamp": "00:55:00", "text": "贈り物を受け取る。お皿、えっと、待って 少々お待ちください。どんなプレゼントだろう"}, {"type": "chat", "time": 3301.053, "timestamp": "00:55:01", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "YOU ARE THE ONE SUPPOSED TO GET GIFTS"}, {"type": "chat", "time": 3305.071, "timestamp": "00:55:05", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "YES"}, {"type": "subtitle", "time": 3312.88, "timestamp": "00:55:12", "text": "正直言って分かりません。それは何ですか"}, {"type": "subtitle", "time": 3317.836, "timestamp": "00:55:17", "text": "私が好きなものは何ですか？ここのどんなところが好きかって？"}, {"type": "subtitle", "time": 3321.46, "timestamp": "00:55:21", "text": "そして、私はアニメが好きなので。私はそれが好きです"}, {"type": "subtitle", "time": 3323.212, "timestamp": "00:55:23", "text": "イギリス人でもある。私は"}, {"type": "subtitle", "time": 3326.651, "timestamp": "00:55:26", "text": "音楽。全部好きです。私はそれで構いません"}, {"type": "subtitle", "time": 3328.405, "timestamp": "00:55:28", "text": "何でも。あらゆる種類の"}, {"type": "subtitle", "time": 3330.289, "timestamp": "00:55:30", "text": "贈り物。それは感覚であり、"}, {"type": "subtitle", "time": 3332.341, "timestamp": "00:55:32", "text": "表現。その裏には何があるのだろうか？"}, {"type": "subtitle", "time": 3335.12, "timestamp": "00:55:35", "text": "贈り物ではない。私が贈るどんな贈り物でも"}, {"type": "subtitle", "time": 3337.603, "timestamp": "00:55:37", "text": "ねえ、もし一つだけくれるなら"}, {"type": "subtitle", "time": 3339.528, "timestamp": "00:55:39", "text": "歯磨き粉、歯ブラシ、または"}, {"type": "subtitle", "time": 3341.391, "timestamp": "00:55:41", "text": "何か役に立つもの"}, {"type": "subtitle", "time": 3343.812, "timestamp": "00:55:43", "text": "日常のニーズには、"}, {"type": "subtitle", "time": 3348.299, "timestamp": "00:55:48", "text": "それか、あるいは何であれ。だから、"}, {"type": "subtitle", "time": 3352.233, "timestamp": "00:55:52", "text": "その背後にある感情。の"}, {"type": "subtitle", "time": 3353.989, "timestamp": "00:55:53", "text": "何かを買ってあげたい人"}, {"type": "subtitle", "time": 3358.502, "timestamp": "00:55:58", "text": "それを私への贈り物としてください。その感覚"}]
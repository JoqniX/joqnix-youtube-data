[{"type": "subtitle", "time": 1148.073, "timestamp": "00:19:08", "text": "カメラはどのように動作するのですか？はい。はい、これです"}, {"type": "subtitle", "time": 1149.801, "timestamp": "00:19:09", "text": "良くなった。ズームインして"}, {"type": "subtitle", "time": 1151.534, "timestamp": "00:19:11", "text": "外側へ。ズームインして"}, {"type": "subtitle", "time": 1156.039, "timestamp": "00:19:16", "text": "外側へ。 E. これは良いですね。これは"}, {"type": "subtitle", "time": 1162.493, "timestamp": "00:19:22", "text": "良い。これは本当に良いですね。あなたは"}, {"type": "subtitle", "time": 1165.703, "timestamp": "00:19:25", "text": "没入感を体感してください。だいたいそんな感じ。"}, {"type": "subtitle", "time": 1168.157, "timestamp": "00:19:28", "text": "だいたいそんな感じ。真実。私もそう出来ればいいけど"}, {"type": "subtitle", "time": 1173.38, "timestamp": "00:19:33", "text": "いつか引っ越すだろう。はい。間違いない。"}, {"type": "subtitle", "time": 1175.288, "timestamp": "00:19:35", "text": "私が引っ越してきたら、みんな大喜びするだろう。"}, {"type": "subtitle", "time": 1181.639, "timestamp": "00:19:41", "text": "いつか。これは進行中のプロジェクトです。"}, {"type": "subtitle", "time": 1188.439, "timestamp": "00:19:48", "text": "だから心配しないでください。それは仕事です"}, {"type": "subtitle", "time": 1196.474, "timestamp": "00:19:56", "text": "進行中。そして今年はたくさんのことをしました"}]
[{"type": "subtitle", "time": 438.546, "timestamp": "00:07:18", "text": "今日はいい日だ。今日は本当に疲れた。持っていた"}, {"type": "subtitle", "time": 440.775, "timestamp": "00:07:20", "text": "働くこと、あちこち走り回ることよりも"}, {"type": "subtitle", "time": 443.005, "timestamp": "00:07:23", "text": "整理整頓するために物を買う"}, {"type": "subtitle", "time": 448.733, "timestamp": "00:07:28", "text": "今夜はパーティーだ。えっと、私は"}, {"type": "subtitle", "time": 454.688, "timestamp": "00:07:34", "text": "考えてみると…彼らは私をとてもよく世話してくれた"}, {"type": "subtitle", "time": 459.916, "timestamp": "00:07:39", "text": "そして私のルームメイト。それで"}, {"type": "subtitle", "time": 462.246, "timestamp": "00:07:42", "text": "私は彼らのためにパーティーを開きたかった。"}, {"type": "subtitle", "time": 464.577, "timestamp": "00:07:44", "text": "今年以降は彼らはここにはいないだろう 彼らは別れるだろう。彼らは自分たちの"}, {"type": "subtitle", "time": 468.974, "timestamp": "00:07:48", "text": "彼らは別れるだろう。彼らは自分たちの 彼らが行きたい場所へ向かう途中、など。"}, {"type": "subtitle", "time": 476.033, "timestamp": "00:07:56", "text": "私は彼らと離れ離れになるだろう。えっと、 はい、素晴らしい一日にしたかったんです"}]
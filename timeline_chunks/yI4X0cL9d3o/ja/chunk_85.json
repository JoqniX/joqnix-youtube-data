[{"type": "subtitle", "time": 5102.036, "timestamp": "01:25:02", "text": "会員になっていただきありがとうございます。"}, {"type": "subtitle", "time": 5108.11, "timestamp": "01:25:08", "text": "これで青い星が揃ったよね？ 真実？それもレベルみたいなものだね。"}, {"type": "subtitle", "time": 5120.422, "timestamp": "01:25:20", "text": "あるいは、そんな感じ。私は自分の"}, {"type": "subtitle", "time": 5124.271, "timestamp": "01:25:24", "text": "レベル。よし、残り1分だ。おお、"}, {"type": "subtitle", "time": 5126.839, "timestamp": "01:25:26", "text": "我が神よ。それから私たちは"}, {"type": "subtitle", "time": 5129.266, "timestamp": "01:25:29", "text": "この後、配信します。大丈夫。"}, {"type": "subtitle", "time": 5144.377, "timestamp": "01:25:44", "text": "待って。はい、彼は"}, {"type": "subtitle", "time": 5150.326, "timestamp": "01:25:50", "text": "1か月、2か月、バッジは"}, {"type": "chat", "time": 5150.541, "timestamp": "01:25:50", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "yep yep, enjoy your birthday w/friends!!!"}, {"type": "subtitle", "time": 5156.573, "timestamp": "01:25:56", "text": "忠誠心ってやつだよ。楽しんでください"}]
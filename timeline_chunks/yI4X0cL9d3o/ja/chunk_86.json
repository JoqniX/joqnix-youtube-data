[{"type": "subtitle", "time": 5160.372, "timestamp": "01:26:00", "text": "友人たちとの誕生日と、Marさんへの感謝。"}, {"type": "subtitle", "time": 5162.771, "timestamp": "01:26:02", "text": "あなたと一緒に過ごすつもりなので、いいえ"}, {"type": "subtitle", "time": 5167.407, "timestamp": "01:26:07", "text": "心配。うん。アリッサさん、ようこそ。"}, {"type": "subtitle", "time": 5171.066, "timestamp": "01:26:11", "text": "残り1分。神。残り1分。"}, {"type": "subtitle", "time": 5179.911, "timestamp": "01:26:19", "text": "50秒3秒。 50秒。しかし"}, {"type": "subtitle", "time": 5188.99, "timestamp": "01:26:28", "text": "今日は私の誕生日です。すべきだ"}, {"type": "subtitle", "time": 5192.774, "timestamp": "01:26:32", "text": "どうやって始めればいいですか？ 30から始めます。"}, {"type": "subtitle", "time": 5198.297, "timestamp": "01:26:38", "text": "大丈夫。バイバイ。たくさんの愛と"}, {"type": "subtitle", "time": 5201.317, "timestamp": "01:26:41", "text": "あなたにとって幸せでありますように。ありがとう。感じる"}, {"type": "subtitle", "time": 5203.238, "timestamp": "01:26:43", "text": "誕生日のお祝いメッセージを自由に書いてください"}, {"type": "subtitle", "time": 5204.967, "timestamp": "01:26:44", "text": "ボード上でまだやっていない場合は"}, {"type": "subtitle", "time": 5219.371, "timestamp": "01:26:59", "text": "マロカ。 20 19 18 17 16 14 15 12 7 10 9"}]
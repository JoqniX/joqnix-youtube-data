[{"type": "subtitle", "time": 1202.054, "timestamp": "00:20:02", "text": "ショーのためのもの。去年"}, {"type": "subtitle", "time": 1203.967, "timestamp": "00:20:03", "text": "私たちはジョカソンイベントを開催し、"}, {"type": "subtitle", "time": 1210.561, "timestamp": "00:20:10", "text": "誕生日とか、そういう類のこと。しかし"}, {"type": "subtitle", "time": 1214.632, "timestamp": "00:20:14", "text": "今年は、えっと…"}, {"type": "subtitle", "time": 1217.831, "timestamp": "00:20:17", "text": "新しい？わからない。今年は私は"}, {"type": "subtitle", "time": 1226.855, "timestamp": "00:20:26", "text": "日本。私は今年日本に来て、そして…はい 私は勉強に忙しくしています"}, {"type": "subtitle", "time": 1228.932, "timestamp": "00:20:28", "text": "私は勉強に忙しくしています 言語、到達するために最善を尽くす"}, {"type": "subtitle", "time": 1231.305, "timestamp": "00:20:31", "text": "言語、到達するために最善を尽くす 日本。そしてもしも。えっと、ちょっと待って。なぜなら"}, {"type": "subtitle", "time": 1244.5, "timestamp": "00:20:44", "text": "日本。そしてもしも。えっと、ちょっと待って。なぜなら 私は…私たちは覚えておくべきではない"}, {"type": "subtitle", "time": 1246.506, "timestamp": "00:20:46", "text": "私は…私たちは覚えておくべきではない 私の前回の誕生日から、私たちは何をしてきただろうか？"}, {"type": "subtitle", "time": 1255.207, "timestamp": "00:20:55", "text": "私の結婚記念日は来月です。"}]
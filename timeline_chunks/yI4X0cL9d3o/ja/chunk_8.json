[{"type": "subtitle", "time": 480.663, "timestamp": "00:08:00", "text": "はい、素晴らしい一日にしたかったんです 祝うために。そう、"}, {"type": "subtitle", "time": 485.727, "timestamp": "00:08:05", "text": "祝うために。そう、 本日の配信は12時に終了します。"}, {"type": "subtitle", "time": 487.981, "timestamp": "00:08:07", "text": "本日の配信は12時に終了します。 12時以降。よし、1回だけにしよう。"}, {"type": "subtitle", "time": 492.187, "timestamp": "00:08:12", "text": "12時以降。よし、1回だけにしよう。 カウントダウン。わかった、教えて"}, {"type": "subtitle", "time": 494.429, "timestamp": "00:08:14", "text": "カウントダウン。わかった、教えて 私の誕生日までのカウントダウン。そしてそうではない"}, {"type": "subtitle", "time": 497.424, "timestamp": "00:08:17", "text": "私の誕生日までのカウントダウン。そしてそうではない 私は最大で...まで送信できると思います。"}, {"type": "subtitle", "time": 500.277, "timestamp": "00:08:20", "text": "私は最大で...まで送信できると思います。 えっと、12時半くらいかな。"}, {"type": "subtitle", "time": 507.383, "timestamp": "00:08:27", "text": "おそらく12時まででしょう"}, {"type": "subtitle", "time": 512.762, "timestamp": "00:08:32", "text": "12時5分頃だったかな。最後に"}, {"type": "subtitle", "time": 515.068, "timestamp": "00:08:35", "text": "それは、まあ、自分がそんなことができるなんて知らなかったからなんです。"}, {"type": "subtitle", "time": 521.81, "timestamp": "00:08:41", "text": "送信を延期することにしたので"}, {"type": "subtitle", "time": 523.75, "timestamp": "00:08:43", "text": "誕生日を別の日に延期する。"}, {"type": "subtitle", "time": 528.218, "timestamp": "00:08:48", "text": "私は長年ずっとそうしてきた。"}, {"type": "subtitle", "time": 533.625, "timestamp": "00:08:53", "text": "私の誕生日である10日と11日。"}, {"type": "subtitle", "time": 537.395, "timestamp": "00:08:57", "text": "配信に対する10件のコメント。"}, {"type": "subtitle", "time": 539.863, "timestamp": "00:08:59", "text": "11日には、王室の誕生日をお祝いします。 。まだだよ、あと1時間ある、残り1時間"}]
[{"type": "subtitle", "time": 2640.769, "timestamp": "00:44:00", "text": "我做這件事，而且我喜歡做這件事，等等。"}, {"type": "subtitle", "time": 2646.501, "timestamp": "00:44:06", "text": "我的意思是，我對它充滿熱情，我簡直為之瘋狂。"}, {"type": "subtitle", "time": 2648.763, "timestamp": "00:44:08", "text": "但就內容和其他方面而言，"}, {"type": "subtitle", "time": 2651.213, "timestamp": "00:44:11", "text": "我只想盡我所能做到最好。"}, {"type": "subtitle", "time": 2653.538, "timestamp": "00:44:13", "text": "創作優質內容等等，"}, {"type": "subtitle", "time": 2655.926, "timestamp": "00:44:15", "text": "更多的新人或那些已經"}, {"type": "chat", "time": 2657.734, "timestamp": "00:44:17", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "Yeah that's a beautiful wish!! "}, {"type": "subtitle", "time": 2658.062, "timestamp": "00:44:18", "text": "他們能夠回來嗎？"}, {"type": "subtitle", "time": 2663.744, "timestamp": "00:44:23", "text": "跟我說話。那意義非凡。"}, {"type": "subtitle", "time": 2668.675, "timestamp": "00:44:28", "text": "為我。是的，我只是希望"}, {"type": "subtitle", "time": 2671.153, "timestamp": "00:44:31", "text": "我對自己的工作感到非常滿意。"}, {"type": "subtitle", "time": 2676.404, "timestamp": "00:44:36", "text": "我的信念，我的願望。好的"}, {"type": "subtitle", "time": 2679.599, "timestamp": "00:44:39", "text": "工作。接下來，還有什麼？"}, {"type": "subtitle", "time": 2681.78, "timestamp": "00:44:41", "text": "人們來和我交談，還有那些"}, {"type": "subtitle", "time": 2689.542, "timestamp": "00:44:49", "text": "事物。是的，是的，我太瘋狂了。"}, {"type": "subtitle", "time": 2691.865, "timestamp": "00:44:51", "text": "我千里迢迢來到日本都是因為YouTube。"}, {"type": "subtitle", "time": 2694.128, "timestamp": "00:44:54", "text": "我超迷YouTube之類的東西。"}]
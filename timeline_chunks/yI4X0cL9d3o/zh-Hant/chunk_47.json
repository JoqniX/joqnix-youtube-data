[{"type": "subtitle", "time": 2822.389, "timestamp": "00:47:02", "text": "雖然那次變速箱出了問題，但我"}, {"type": "subtitle", "time": 2824.449, "timestamp": "00:47:04", "text": "很高興我們能看到煙火。"}, {"type": "subtitle", "time": 2827.165, "timestamp": "00:47:07", "text": "人造物放在一起。我不能"}, {"type": "subtitle", "time": 2829.964, "timestamp": "00:47:09", "text": "在傳輸過程中捕獲它。出色地，"}, {"type": "subtitle", "time": 2832.163, "timestamp": "00:47:12", "text": "這意義重大。雖然這意味著"}, {"type": "subtitle", "time": 2835.346, "timestamp": "00:47:15", "text": "很多。做這些事是好事。是的。"}, {"type": "subtitle", "time": 2843.257, "timestamp": "00:47:23", "text": "嗯。是的。這是我現在想要克服的。"}, {"type": "subtitle", "time": 2850.574, "timestamp": "00:47:30", "text": "這是因為我害羞。我無法，呃，開發"}, {"type": "subtitle", "time": 2852.954, "timestamp": "00:47:32", "text": "那種信心依然，我的意思是，依然"}, {"type": "subtitle", "time": 2855.267, "timestamp": "00:47:35", "text": "我需要走出自己的舒適圈，"}, {"type": "subtitle", "time": 2858.589, "timestamp": "00:47:38", "text": "多和人交談。等待。做得更多"}, {"type": "subtitle", "time": 2860.703, "timestamp": "00:47:40", "text": "日本朋友，還有，呃，聊天和"}, {"type": "subtitle", "time": 2863.043, "timestamp": "00:47:43", "text": "提高我的日文程度。這就是我的目標。"}, {"type": "subtitle", "time": 2866.094, "timestamp": "00:47:46", "text": "我的目標之一，嗯，在我…"}, {"type": "subtitle", "time": 2871.095, "timestamp": "00:47:51", "text": "在這裡，而且，我不知道，日語說得更好一些。"}]
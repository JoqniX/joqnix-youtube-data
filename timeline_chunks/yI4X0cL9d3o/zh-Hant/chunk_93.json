[{"type": "subtitle", "time": 5582.301, "timestamp": "01:33:02", "text": "生日。嗯，謝謝光臨。 謝謝大家的生日祝福。"}, {"type": "subtitle", "time": 5587.631, "timestamp": "01:33:07", "text": "夥計們。謝謝你們的光臨。謝謝"}, {"type": "subtitle", "time": 5591.405, "timestamp": "01:33:11", "text": "生日祝福。謝謝"}, {"type": "subtitle", "time": 5593.117, "timestamp": "01:33:13", "text": "來。謝謝大家的祝福"}, {"type": "subtitle", "time": 5600.069, "timestamp": "01:33:20", "text": "生日。金槍魚，謝謝你的到來。"}, {"type": "subtitle", "time": 5602.12, "timestamp": "01:33:22", "text": "謝謝大家的生日祝福"}, {"type": "subtitle", "time": 5607.324, "timestamp": "01:33:27", "text": "還。謝謝各位的光臨。謝謝"}, {"type": "subtitle", "time": 5610.114, "timestamp": "01:33:30", "text": "生日祝福。和"}, {"type": "subtitle", "time": 5613.648, "timestamp": "01:33:33", "text": "謝謝你們的光臨。謝謝你。"}, {"type": "subtitle", "time": 5616.286, "timestamp": "01:33:36", "text": "生日祝福。現在由寬"}, {"type": "subtitle", "time": 5619.166, "timestamp": "01:33:39", "text": "他也來了。謝謝你們的光臨。"}, {"type": "subtitle", "time": 5622.034, "timestamp": "01:33:42", "text": "謝謝你們的光臨。謝謝你。"}, {"type": "subtitle", "time": 5628.863, "timestamp": "01:33:48", "text": "生日祝福。就這樣。和"}, {"type": "subtitle", "time": 5630.761, "timestamp": "01:33:50", "text": "也感謝每一位發聲者。"}, {"type": "subtitle", "time": 5632.876, "timestamp": "01:33:52", "text": "超級留言，還有11個贊"}]
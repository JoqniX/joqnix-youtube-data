[{"type": "subtitle", "time": 3001.578, "timestamp": "00:50:01", "text": "在場的各位。嗯，如果我還沒做過的話"}, {"type": "subtitle", "time": 3003.85, "timestamp": "00:50:03", "text": "他們寫下了生日祝福"}, {"type": "subtitle", "time": 3006.064, "timestamp": "00:50:06", "text": "生日公告板，坐下"}, {"type": "subtitle", "time": 3011.978, "timestamp": "00:50:11", "text": "可以自由這樣做。連結裡有。"}, {"type": "subtitle", "time": 3014.044, "timestamp": "00:50:14", "text": "在描述中，以及在，嗯，在"}, {"type": "chat", "time": 3019.85, "timestamp": "00:50:19", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "I wrote o7"}, {"type": "subtitle", "time": 3020.189, "timestamp": "00:50:20", "text": "置頂評論。等等，讓我"}, {"type": "subtitle", "time": 3021.976, "timestamp": "00:50:21", "text": "檢查一下我是否放對了。"}, {"type": "subtitle", "time": 3026.122, "timestamp": "00:50:26", "text": "描述。對，就在那兒。謝謝。"}, {"type": "subtitle", "time": 3033.044, "timestamp": "00:50:33", "text": "明天我要讀書，明天我要，嗯，"}, {"type": "subtitle", "time": 3037.014, "timestamp": "00:50:37", "text": "讀一下。還會舉辦派對。"}, {"type": "subtitle", "time": 3039.968, "timestamp": "00:50:39", "text": "後。所以12號那天會有"}, {"type": "subtitle", "time": 3045.8, "timestamp": "00:50:45", "text": "類似派對後的餘興節目。來"}]
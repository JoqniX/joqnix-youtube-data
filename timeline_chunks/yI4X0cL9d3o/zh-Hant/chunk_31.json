[{"type": "subtitle", "time": 1861.826, "timestamp": "00:31:01", "text": "已被靜音。請"}, {"type": "subtitle", "time": 1867.613, "timestamp": "00:31:07", "text": "等待。好的。沒關係？好的。"}, {"type": "subtitle", "time": 1873.215, "timestamp": "00:31:13", "text": "不能。我該如何把它藏起來？好了，就是這樣。"}, {"type": "subtitle", "time": 1876.455, "timestamp": "00:31:16", "text": "有。這些是什麼？好了，就這些。"}, {"type": "subtitle", "time": 1881.193, "timestamp": "00:31:21", "text": "好的。沒關係。我的上帝。哦，"}, {"type": "subtitle", "time": 1885.857, "timestamp": "00:31:25", "text": "哇。還剩55分鐘。是的。他們去了"}, {"type": "subtitle", "time": 1887.851, "timestamp": "00:31:27", "text": "買汽水、飲料之類的東西。"}, {"type": "subtitle", "time": 1895.258, "timestamp": "00:31:35", "text": "我想應該是軟性飲料。再見。再見。嘿，"}, {"type": "subtitle", "time": 1901.129, "timestamp": "00:31:41", "text": "我希望不是什麼棘手的事。"}, {"type": "subtitle", "time": 1905.659, "timestamp": "00:31:45", "text": "瘋狂的。問題是，我現在通常不會這樣做。"}, {"type": "subtitle", "time": 1907.624, "timestamp": "00:31:47", "text": "隆重地慶祝我的生日"}, {"type": "subtitle", "time": 1913.699, "timestamp": "00:31:53", "text": "絕非如此。嗯，因為所有這些"}, {"type": "subtitle", "time": 1915.846, "timestamp": "00:31:55", "text": "多年來，我一直和家人一起慶祝這個節日。"}, {"type": "subtitle", "time": 1918.112, "timestamp": "00:31:58", "text": "那一刻終於到來了，我的朋友"}]
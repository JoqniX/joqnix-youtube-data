[{"type": "subtitle", "time": 4021.981, "timestamp": "01:07:01", "text": "第二台攝影機就是這台。不，怎麼會這樣"}, {"type": "subtitle", "time": 4025.631, "timestamp": "01:07:05", "text": "我該如何更換攝影機？"}, {"type": "subtitle", "time": 4028.09, "timestamp": "01:07:08", "text": "選擇其他攝影機。嘿 我不能嗎？我們轉到…"}, {"type": "subtitle", "time": 4029.931, "timestamp": "01:07:09", "text": "我不能嗎？我們轉到… 左右。我們一直是"}, {"type": "subtitle", "time": 4031.575, "timestamp": "01:07:11", "text": "左右。我們一直是 放大和縮小，就像"}, {"type": "subtitle", "time": 4033.523, "timestamp": "01:07:13", "text": "放大和縮小，就像 暫時先從左到右。讓我"}, {"type": "subtitle", "time": 4040.105, "timestamp": "01:07:20", "text": "暫時先從左到右。讓我 降低我的敏感度，這樣我就不會"}, {"type": "subtitle", "time": 4041.794, "timestamp": "01:07:21", "text": "降低我的敏感度，這樣我就不會 聽聽背景聲音。我有一些"}, {"type": "subtitle", "time": 4047.754, "timestamp": "01:07:27", "text": "聽聽背景聲音。我有一些 房間裡有客人，因為，呃，我"}, {"type": "subtitle", "time": 4050.038, "timestamp": "01:07:30", "text": "房間裡有客人，因為，呃，我 他們今晚將陪伴我們…"}, {"type": "subtitle", "time": 4052.022, "timestamp": "01:07:32", "text": "他們今晚將陪伴我們… 一起來慶祝我的生日吧。我是"}, {"type": "subtitle", "time": 4057.346, "timestamp": "01:07:37", "text": "一起來慶祝我的生日吧。我是 我非常感謝你的到來。"}, {"type": "subtitle", "time": 4059.443, "timestamp": "01:07:39", "text": "我非常感謝你的到來。 零食之類的東西。此外，19"}, {"type": "subtitle", "time": 4067.954, "timestamp": "01:07:47", "text": "零食之類的東西。此外，19 分鐘。我的上帝。我的上帝。還剩"}, {"type": "subtitle", "time": 4070.938, "timestamp": "01:07:50", "text": "分鐘。我的上帝。我的上帝。還剩 19分鐘。什麼？什麼？什麼？什麼"}, {"type": "subtitle", "time": 4076.147, "timestamp": "01:07:56", "text": "19分鐘。什麼？什麼？什麼？什麼 ？那？我的天哪，兄弟。他"}]
[{"type": "subtitle", "time": 2105.221, "timestamp": "00:35:05", "text": "是。這裡。再見。可能只有 我會透過視訊通話和他們交談。"}, {"type": "subtitle", "time": 2107.265, "timestamp": "00:35:07", "text": "我會透過視訊通話和他們交談。 諸如此類的事情，嗯，是的。我想知道"}, {"type": "subtitle", "time": 2119.385, "timestamp": "00:35:19", "text": "諸如此類的事情，嗯，是的。我想知道 其他人的感受"}, {"type": "subtitle", "time": 2120.998, "timestamp": "00:35:20", "text": "其他人的感受 你離家很遠。你們在哪裡慶祝？"}, {"type": "subtitle", "time": 2125.881, "timestamp": "00:35:25", "text": "你離家很遠。你們在哪裡慶祝？ 第一次在一個國家過生日"}, {"type": "subtitle", "time": 2128.114, "timestamp": "00:35:28", "text": "第一次在一個國家過生日 與眾不同，就像一次體驗。"}, {"type": "subtitle", "time": 2130.123, "timestamp": "00:35:30", "text": "與眾不同，就像一次體驗。 不一樣，不是嗎？是的。你呢？"}, {"type": "chat", "time": 2134.156, "timestamp": "00:35:34", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ-7tIYCO_9EPt-GMgAw"}, {"type": "chat", "time": 2136.458, "timestamp": "00:35:36", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! LeverBoi~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 2137.637, "timestamp": "00:35:37", "text": "不一樣，不是嗎？是的。你呢？ 他們會怎麼做？嘿，孩子。你好。你好。"}, {"type": "subtitle", "time": 2148.689, "timestamp": "00:35:48", "text": "等等，你不是在直播嗎？"}, {"type": "subtitle", "time": 2153.878, "timestamp": "00:35:53", "text": "類似那樣？等等，當你在"}, {"type": "subtitle", "time": 2156.283, "timestamp": "00:35:56", "text": "直播的時候，我看到你開始玩什麼東西了。"}]
[{"type": "subtitle", "time": 2041.066, "timestamp": "00:34:01", "text": "去年某個時間。去年， 我記得我慶祝過生日。"}, {"type": "subtitle", "time": 2043.599, "timestamp": "00:34:03", "text": "我記得我慶祝過生日。 我當時正在參加 Jokathon 表演。"}, {"type": "subtitle", "time": 2046.033, "timestamp": "00:34:06", "text": "我當時正在參加 Jokathon 表演。 他進行過全天候直播，24小時不間斷直播。"}, {"type": "subtitle", "time": 2049.205, "timestamp": "00:34:09", "text": "他進行過全天候直播，24小時不間斷直播。 你知道，每天都要花好幾個小時？我覺得"}, {"type": "subtitle", "time": 2053.73, "timestamp": "00:34:13", "text": "你知道，每天都要花好幾個小時？我覺得 我大概有四、五個"}, {"type": "subtitle", "time": 2055.659, "timestamp": "00:34:15", "text": "我大概有四、五個 幾個小時的休息之類的。我認為"}, {"type": "subtitle", "time": 2059.575, "timestamp": "00:34:19", "text": "幾個小時的休息之類的。我認為 那天，或者更確切地說，我開始了"}, {"type": "subtitle", "time": 2061.702, "timestamp": "00:34:21", "text": "那天，或者更確切地說，我開始了 慶祝完我的直播後"}, {"type": "subtitle", "time": 2063.642, "timestamp": "00:34:23", "text": "慶祝完我的直播後 與家人一起過生日，到此結束"}, {"type": "subtitle", "time": 2066.019, "timestamp": "00:34:26", "text": "與家人一起過生日，到此結束 蛋糕之類的東西。因為那是我的"}, {"type": "subtitle", "time": 2070.594, "timestamp": "00:34:30", "text": "蛋糕之類的東西。因為那是我的 這是和他們一起過的最後一個生日，對吧？"}, {"type": "subtitle", "time": 2072.529, "timestamp": "00:34:32", "text": "這是和他們一起過的最後一個生日，對吧？ ？艾米麗·卡薩庫，沒錯，就是這樣。"}, {"type": "subtitle", "time": 2076.45, "timestamp": "00:34:36", "text": "？艾米麗·卡薩庫，沒錯，就是這樣。 我想念他們。為什麼是我"}, {"type": "subtitle", "time": 2079.258, "timestamp": "00:34:39", "text": "我想念他們。為什麼是我 兄弟，你在想這件事嗎？但我想"}, {"type": "subtitle", "time": 2094.247, "timestamp": "00:34:54", "text": "兄弟，你在想這件事嗎？但我想 我覺得他們會在12點打電話，"}, {"type": "subtitle", "time": 2096.18, "timestamp": "00:34:56", "text": "我覺得他們會在12點打電話， 印度時間。大約是3點30分。"}, {"type": "subtitle", "time": 2098.894, "timestamp": "00:34:58", "text": "印度時間。大約是3點30分。 是。這裡。再見。可能只有"}]
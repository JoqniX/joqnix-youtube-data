[{"type": "subtitle", "time": 962.255, "timestamp": "00:16:02", "text": "我可以，我可以做到。是的。是的。是的。"}, {"type": "subtitle", "time": 964.408, "timestamp": "00:16:04", "text": "讓我給你看一張圖。"}, {"type": "subtitle", "time": 984.057, "timestamp": "00:16:24", "text": "畫布繪畫。你能看到嗎？哦，"}, {"type": "subtitle", "time": 990.017, "timestamp": "00:16:30", "text": "是的。他們可以。你好。你好。我這就…"}, {"type": "subtitle", "time": 1001.021, "timestamp": "00:16:41", "text": "稍微畫一下這個。有一點原因"}, {"type": "subtitle", "time": 1004.268, "timestamp": "00:16:44", "text": "這裡。呃，這個配置"}, {"type": "subtitle", "time": 1006.785, "timestamp": "00:16:46", "text": "今年真是糟糕透了。好的。不"}, {"type": "subtitle", "time": 1008.813, "timestamp": "00:16:48", "text": "和去年一樣。年度最佳"}, {"type": "subtitle", "time": 1012.627, "timestamp": "00:16:52", "text": "去年是…"}, {"type": "subtitle", "time": 1016.051, "timestamp": "00:16:56", "text": "我覺得更好了。沒有好轉。呃，我還有更多"}]
[{"type": "subtitle", "time": 4385.385, "timestamp": "01:13:05", "text": "而偉大的創作者，作為創作者"}, {"type": "subtitle", "time": 4387.963, "timestamp": "01:13:07", "text": "他們獨立自主，以教師的身分出現。"}, {"type": "subtitle", "time": 4390.476, "timestamp": "01:13:10", "text": "嘉賓、虛擬演講者"}, {"type": "subtitle", "time": 4392.988, "timestamp": "01:13:12", "text": "老師和其他人，他們會教你他們的"}, {"type": "subtitle", "time": 4395.434, "timestamp": "01:13:15", "text": "經驗等等，他們做了什麼"}, {"type": "subtitle", "time": 4401.761, "timestamp": "01:13:21", "text": "比如，做虛擬主播之類的。"}, {"type": "subtitle", "time": 4406.063, "timestamp": "01:13:26", "text": "所以。與學院類似"}, {"type": "subtitle", "time": 4412.31, "timestamp": "01:13:32", "text": "Twitch上的主播，而不是主播本人，"}, {"type": "chat", "time": 4414.091, "timestamp": "01:13:34", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "Yeah that sounds really awesome, I've never heard abt it!"}, {"type": "subtitle", "time": 4417.743, "timestamp": "01:13:37", "text": "但這是一個為期四年的課程。想像一下去"}, {"type": "subtitle", "time": 4420.821, "timestamp": "01:13:40", "text": "前提是你已經是 YouTuber。那是"}, {"type": "subtitle", "time": 4421.763, "timestamp": "01:13:41", "text": "他們告訴我的。"}, {"type": "subtitle", "time": 4426.57, "timestamp": "01:13:46", "text": "他們就是這麼告訴我的。等等 當然，你已經做了6年的YouTube部落客了。"}, {"type": "subtitle", "time": 4429.636, "timestamp": "01:13:49", "text": "當然，你已經做了6年的YouTube部落客了。 。為什麼需要參加這個會議？"}]
[{"type": "subtitle", "time": 3961.21, "timestamp": "01:06:01", "text": "天哪，他們找到辦法了，現在情況怎麼樣了？"}, {"type": "subtitle", "time": 3965.877, "timestamp": "01:06:05", "text": "我嘗試過舉辦活動嗎？"}, {"type": "subtitle", "time": 3969.428, "timestamp": "01:06:09", "text": "自去年以來的社區成員？不，"}, {"type": "subtitle", "time": 3973.503, "timestamp": "01:06:13", "text": "真的？是的，我喜歡玩。好的，"}, {"type": "subtitle", "time": 3977.619, "timestamp": "01:06:17", "text": "那挺好的。我們有個問題。哦，"}, {"type": "subtitle", "time": 3984.22, "timestamp": "01:06:24", "text": "是的。去做吧，去做吧，告訴我結果。好的。請告訴我"}, {"type": "subtitle", "time": 3986.45, "timestamp": "01:06:26", "text": "是的，呃，我想我會把它發佈到…"}, {"type": "subtitle", "time": 3988.21, "timestamp": "01:06:28", "text": "如果他們有Discord伺服器的話"}, {"type": "subtitle", "time": 3991.229, "timestamp": "01:06:31", "text": "那裡有售。我的意思是，我現在還不知道。"}, {"type": "subtitle", "time": 3993.306, "timestamp": "01:06:33", "text": "我有Discord伺服器。所以"}, {"type": "subtitle", "time": 3996.947, "timestamp": "01:06:36", "text": "他們可以過關。他不是很活躍，"}, {"type": "subtitle", "time": 3998.792, "timestamp": "01:06:38", "text": "是的，他們可以在那裡接收病人。"}, {"type": "subtitle", "time": 4000.883, "timestamp": "01:06:40", "text": "當我這樣做時，通知和其他所有事情都會發生。"}, {"type": "subtitle", "time": 4004.707, "timestamp": "01:06:44", "text": "串流媒體。哦，好的，我會在那裡發點東西。"}, {"type": "subtitle", "time": 4006.349, "timestamp": "01:06:46", "text": "當我們舉辦活動時"}, {"type": "subtitle", "time": 4006.932, "timestamp": "01:06:46", "text": "社區。"}, {"type": "subtitle", "time": 4015.53, "timestamp": "01:06:55", "text": "是的，那樣沒問題。就這樣，呃。"}, {"type": "subtitle", "time": 4017.902, "timestamp": "01:06:57", "text": "等等，哪個是二號攝影機？這"}]
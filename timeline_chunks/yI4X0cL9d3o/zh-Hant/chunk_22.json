[{"type": "subtitle", "time": 1330.325, "timestamp": "00:22:10", "text": "12年？什麼？什麼？發生過嗎？"}, {"type": "subtitle", "time": 1336.49, "timestamp": "00:22:16", "text": "這麼久？等等，什麼？我的天哪。"}, {"type": "subtitle", "time": 1339.994, "timestamp": "00:22:19", "text": "我的天哪。已經過去好久了，不是嗎？"}, {"type": "subtitle", "time": 1356.937, "timestamp": "00:22:36", "text": "哇。那不是很長一段時間嗎？是的，就是這個"}, {"type": "subtitle", "time": 1359.078, "timestamp": "00:22:39", "text": "今年我打算更多地採用這種風格。"}, {"type": "subtitle", "time": 1363.132, "timestamp": "00:22:43", "text": "日本人。我們需要多加練習。"}, {"type": "subtitle", "time": 1375.667, "timestamp": "00:22:55", "text": "他會說日語，等等。我要 ……這些直播將更傾向於以下風格："}, {"type": "subtitle", "time": 1378.011, "timestamp": "00:22:58", "text": "……這些直播將更傾向於以下風格： 日本人。為了提高口語能力，"}]
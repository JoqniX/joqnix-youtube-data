[{"type": "subtitle", "time": 300.27, "timestamp": "00:05:00", "text": "所以，是的，對於那些不了解的人來說，"}, {"type": "subtitle", "time": 302.603, "timestamp": "00:05:02", "text": "今晚是我的生日"}, {"type": "subtitle", "time": 308.059, "timestamp": "00:05:08", "text": "日本時間現在是中午12點。所以我是"}, {"type": "subtitle", "time": 312.958, "timestamp": "00:05:12", "text": "有點緊張。嗯，我還有客人。"}, {"type": "subtitle", "time": 317.398, "timestamp": "00:05:17", "text": "今天在家裡的臥室。嗯，"}, {"type": "subtitle", "time": 319.835, "timestamp": "00:05:19", "text": "一些朋友和高年級的學生。"}, {"type": "subtitle", "time": 325.811, "timestamp": "00:05:25", "text": "嗯，呃，是啊，也許……這裡沒人。"}, {"type": "subtitle", "time": 330.476, "timestamp": "00:05:30", "text": "現在他們在這裡，但他們還會來的。所以不"}, {"type": "subtitle", "time": 332.486, "timestamp": "00:05:32", "text": "我肯定能順利直播。"}, {"type": "subtitle", "time": 334.178, "timestamp": "00:05:34", "text": "恰當，因為我覺得"}, {"type": "subtitle", "time": 335.976, "timestamp": "00:05:35", "text": "當有人在場時，我會感到不自在。"}, {"type": "subtitle", "time": 341.086, "timestamp": "00:05:41", "text": "房間。所以，是的，就是這樣。"}, {"type": "subtitle", "time": 350.998, "timestamp": "00:05:50", "text": "傑出的。這很棒。不，在部分"}, {"type": "subtitle", "time": 353.165, "timestamp": "00:05:53", "text": "螢幕底部有一個帳戶"}, {"type": "subtitle", "time": 359.068, "timestamp": "00:05:59", "text": "倒數計時顯示剩餘時間"}]
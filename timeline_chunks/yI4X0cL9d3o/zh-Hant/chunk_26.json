[{"type": "subtitle", "time": 1561.071, "timestamp": "00:26:01", "text": "今晚現實生活中有個派對。"}, {"type": "subtitle", "time": 1563.619, "timestamp": "00:26:03", "text": "那天也是我現實生活中的生日。"}, {"type": "subtitle", "time": 1566.476, "timestamp": "00:26:06", "text": "真實的。我為你感到高興。謝謝。"}, {"type": "subtitle", "time": 1570.211, "timestamp": "00:26:10", "text": "謝謝。哦，我希望你今天過得愉快。"}, {"type": "subtitle", "time": 1575.176, "timestamp": "00:26:15", "text": "好的。希望你一切都好。謝謝"}, {"type": "subtitle", "time": 1579.189, "timestamp": "00:26:19", "text": "感謝您的訂閱。謝謝。我只是"}, {"type": "subtitle", "time": 1587.591, "timestamp": "00:26:27", "text": "看看吧。謝謝。謝謝。一切順利。曾是"}, {"type": "subtitle", "time": 1589.278, "timestamp": "00:26:29", "text": "這是我們第一次沒有合作"}, {"type": "subtitle", "time": 1591.573, "timestamp": "00:26:31", "text": "一起。此後我們合作不多。"}, {"type": "chat", "time": 1592.075, "timestamp": "00:26:32", "author": "@GEN-ZGAMER_016", "avatar": "https://yt4.ggpht.com/w6_tXF6pcPRJxaHVquDoUdIUzRyBMVG9FPodnFMEAijY59dYsj76nqjBDkTRDcLXhK2h1KRG6A=s64-c-k-c0x00ffffff-no-rj", "message": "🎉🎉🎉"}, {"type": "subtitle", "time": 1593.707, "timestamp": "00:26:33", "text": "是嗎？但願如此。"}, {"type": "subtitle", "time": 1595.731, "timestamp": "00:26:35", "text": "我們還有一些機會。"}, {"type": "subtitle", "time": 1605.737, "timestamp": "00:26:45", "text": "未來。歡迎各位。作為"}, {"type": "subtitle", "time": 1611.217, "timestamp": "00:26:51", "text": "是？我很好。我當時還很小"}, {"type": "subtitle", "time": 1613.288, "timestamp": "00:26:53", "text": "呃，之前有點緊張，因為我沒…"}, {"type": "subtitle", "time": 1617.336, "timestamp": "00:26:57", "text": "我為這次直播做了許多準備。嗯 今晚有個派對。我是"}]
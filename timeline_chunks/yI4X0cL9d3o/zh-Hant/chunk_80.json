[{"type": "subtitle", "time": 4803.722, "timestamp": "01:20:03", "text": "不，那就選第一個吧。非常好。"}, {"type": "subtitle", "time": 4808.733, "timestamp": "01:20:08", "text": "當時機臨近時，我們將啟程。"}, {"type": "subtitle", "time": 4819.858, "timestamp": "01:20:19", "text": "這種舒適感。好的。 7分鐘。不，"}, {"type": "subtitle", "time": 4825.207, "timestamp": "01:20:25", "text": "不，不。 6分鐘。你好。我的天啊。"}, {"type": "subtitle", "time": 4839.411, "timestamp": "01:20:39", "text": "今天我完成了我的任務，我必須…"}, {"type": "subtitle", "time": 4846.946, "timestamp": "01:20:46", "text": "聽聽這個。哦，對了，坐下。"}, {"type": "subtitle", "time": 4848.987, "timestamp": "01:20:48", "text": "如果還沒寫願望，可以自由寫下來。"}]
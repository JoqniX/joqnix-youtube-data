[{"type": "subtitle", "time": 603.302, "timestamp": "00:10:03", "text": "歡迎，歡迎。我沒時間"}, {"type": "subtitle", "time": 608.268, "timestamp": "00:10:08", "text": "一點也不。所以，嗯，是的，今天"}, {"type": "subtitle", "time": 610.804, "timestamp": "00:10:10", "text": "我當時也有點想，嗯，不行。"}, {"type": "subtitle", "time": 614.958, "timestamp": "00:10:14", "text": "我做了很多準備。我甚至做不到"}, {"type": "subtitle", "time": 617.11, "timestamp": "00:10:17", "text": "尋找製作帽子的資源"}, {"type": "subtitle", "time": 619.501, "timestamp": "00:10:19", "text": "生日，夥計，把它放上去"}, {"type": "subtitle", "time": 622.127, "timestamp": "00:10:22", "text": "頭部。就像我說的，「好的，"}, {"type": "subtitle", "time": 624.431, "timestamp": "00:10:24", "text": "明天是生日直播"}, {"type": "subtitle", "time": 627.555, "timestamp": "00:10:27", "text": "真實的。所以我會做點什麼。"}, {"type": "subtitle", "time": 629.834, "timestamp": "00:10:29", "text": "今天我只是簡單地說：“好吧，我要…”"}, {"type": "subtitle", "time": 632.062, "timestamp": "00:10:32", "text": "「我要即興發揮。」所以我打算即興發揮。"}, {"type": "subtitle", "time": 635.559, "timestamp": "00:10:35", "text": "我不知道我能否正常直播。"}, {"type": "subtitle", "time": 637.976, "timestamp": "00:10:37", "text": "今天是因為，嗯，我可以這麼說。"}, {"type": "subtitle", "time": 640.525, "timestamp": "00:10:40", "text": "我現在成了焦點。"}, {"type": "subtitle", "time": 643.988, "timestamp": "00:10:43", "text": "相同的。我成了焦點。"}, {"type": "subtitle", "time": 649.092, "timestamp": "00:10:49", "text": "我不知道今晚我能不能做點什麼。"}, {"type": "subtitle", "time": 651.006, "timestamp": "00:10:51", "text": "因為我有客人，我的"}, {"type": "subtitle", "time": 653.088, "timestamp": "00:10:53", "text": "現實生活中的朋友和我的前輩們"}, {"type": "subtitle", "time": 656.538, "timestamp": "00:10:56", "text": "今天和我在一起。呃，目前缺貨。"}, {"type": "subtitle", "time": 658.99, "timestamp": "00:10:58", "text": "在房間裡。他們將加入"}]
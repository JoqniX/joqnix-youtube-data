[{"type": "subtitle", "time": 5160.372, "timestamp": "01:26:00", "text": "與朋友們一起過生日，感謝三月。"}, {"type": "subtitle", "time": 5162.771, "timestamp": "01:26:02", "text": "我要和你一起度過，所以不用了。"}, {"type": "subtitle", "time": 5167.407, "timestamp": "01:26:07", "text": "擔心。嗯。歡迎艾莉莎。"}, {"type": "subtitle", "time": 5171.066, "timestamp": "01:26:11", "text": "剩一分鐘。上帝。剩一分鐘。"}, {"type": "subtitle", "time": 5179.911, "timestamp": "01:26:19", "text": "50秒3秒。 50秒。但"}, {"type": "subtitle", "time": 5188.99, "timestamp": "01:26:28", "text": "今天是我的生日。應該"}, {"type": "subtitle", "time": 5192.774, "timestamp": "01:26:32", "text": "如何開始？我從30開始。"}, {"type": "subtitle", "time": 5198.297, "timestamp": "01:26:38", "text": "好吧。再見。滿滿的愛和"}, {"type": "subtitle", "time": 5201.317, "timestamp": "01:26:41", "text": "祝你幸福。謝謝。感覺"}, {"type": "subtitle", "time": 5203.238, "timestamp": "01:26:43", "text": "自由撰寫生日祝福"}, {"type": "subtitle", "time": 5204.967, "timestamp": "01:26:44", "text": "如果你還沒有在董事會上這樣做的話"}, {"type": "subtitle", "time": 5219.371, "timestamp": "01:26:59", "text": "馬羅卡。 20 19 18 17 16 14 15 12 7 10 9"}]
[{"type": "subtitle", "time": 1441.617, "timestamp": "00:24:01", "text": "最好的自己。但是如果。我感到快樂"}, {"type": "subtitle", "time": 1445.093, "timestamp": "00:24:05", "text": "現在。搞什麼鬼？你知道，兩年前"}, {"type": "subtitle", "time": 1447.887, "timestamp": "00:24:07", "text": "我當時壓力很大，持續了好幾個小時。曾是"}, {"type": "subtitle", "time": 1450.74, "timestamp": "00:24:10", "text": "抬頭望向天空。很明顯，"}, {"type": "subtitle", "time": 1453.977, "timestamp": "00:24:13", "text": "雲量很少，天氣晴朗。我能看到"}, {"type": "subtitle", "time": 1456.509, "timestamp": "00:24:16", "text": "星星和一切。我本來打算買點東西……然後我就出去了。"}, {"type": "subtitle", "time": 1458.601, "timestamp": "00:24:18", "text": "為聚會購買食品雜貨"}, {"type": "subtitle", "time": 1461.807, "timestamp": "00:24:21", "text": "今晚。我當時正準備去買東西。"}, {"type": "subtitle", "time": 1463.587, "timestamp": "00:24:23", "text": "今晚派對要用的東西。"}, {"type": "subtitle", "time": 1469.726, "timestamp": "00:24:29", "text": "所以，我的室友奎因"}, {"type": "subtitle", "time": 1472.111, "timestamp": "00:24:32", "text": "她會做飯、準備食物，以及所有的一切。"}, {"type": "subtitle", "time": 1478.137, "timestamp": "00:24:38", "text": "那。我將舉行盛宴。如果，"}, {"type": "subtitle", "time": 1481.826, "timestamp": "00:24:41", "text": "我只是隨便看看。好的。朝著"}]
[{"type": "subtitle", "time": 480.663, "timestamp": "00:08:00", "text": "是的，我希望這會是美好的一天。 慶祝。是的，"}, {"type": "subtitle", "time": 485.727, "timestamp": "00:08:05", "text": "慶祝。是的， 今天的直播將於12點結束。"}, {"type": "subtitle", "time": 487.981, "timestamp": "00:08:07", "text": "今天的直播將於12點結束。 12點以後。好吧，就一個。"}, {"type": "subtitle", "time": 492.187, "timestamp": "00:08:12", "text": "12點以後。好吧，就一個。 倒數計時。好的，告訴我"}, {"type": "subtitle", "time": 494.429, "timestamp": "00:08:14", "text": "倒數計時。好的，告訴我 距離我的生日還有一天。而不是"}, {"type": "subtitle", "time": 497.424, "timestamp": "00:08:17", "text": "距離我的生日還有一天。而不是 我認為我可以傳輸到…"}, {"type": "subtitle", "time": 500.277, "timestamp": "00:08:20", "text": "我認為我可以傳輸到… 呃，大概是12點半左右吧。"}, {"type": "subtitle", "time": 507.383, "timestamp": "00:08:27", "text": "可能只會持續到12點或"}, {"type": "subtitle", "time": 512.762, "timestamp": "00:08:32", "text": "大概是12:05左右。最後，我要說…"}, {"type": "subtitle", "time": 515.068, "timestamp": "00:08:35", "text": "那是因為，嗯，我之前不知道自己可以做到。"}, {"type": "subtitle", "time": 521.81, "timestamp": "00:08:41", "text": "決定推遲我的傳輸"}, {"type": "subtitle", "time": 523.75, "timestamp": "00:08:43", "text": "生日那天，改到另一天吧。"}, {"type": "subtitle", "time": 528.218, "timestamp": "00:08:48", "text": "這麼多年來，我一直都是這麼做的。"}, {"type": "subtitle", "time": 533.625, "timestamp": "00:08:53", "text": "我的生日是10號和11號。"}, {"type": "subtitle", "time": 537.395, "timestamp": "00:08:57", "text": "關於直播的 10 則評論；"}, {"type": "subtitle", "time": 539.863, "timestamp": "00:08:59", "text": "11號那天我們會舉行皇家生日慶祝活動。 。還沒，還有一個小時，還剩1個名額。"}]
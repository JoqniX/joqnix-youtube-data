[{"type": "subtitle", "time": 3300.211, "timestamp": "00:55:00", "text": "收到禮物。盤子我的呃嗯等等 稍等片刻。我想知道會收到什麼禮物。"}, {"type": "chat", "time": 3301.053, "timestamp": "00:55:01", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "YOU ARE THE ONE SUPPOSED TO GET GIFTS"}, {"type": "chat", "time": 3305.071, "timestamp": "00:55:05", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "YES"}, {"type": "subtitle", "time": 3312.88, "timestamp": "00:55:12", "text": "我真的不知道。它是什麼？"}, {"type": "subtitle", "time": 3317.836, "timestamp": "00:55:17", "text": "我喜歡什麼？我喜歡這裡什麼？"}, {"type": "subtitle", "time": 3321.46, "timestamp": "00:55:21", "text": "而且因為我喜歡動漫。我喜歡它"}, {"type": "subtitle", "time": 3323.212, "timestamp": "00:55:23", "text": "英國人也是。我喜歡"}, {"type": "subtitle", "time": 3326.651, "timestamp": "00:55:26", "text": "音樂。我喜歡所有東西。我沒問題"}, {"type": "subtitle", "time": 3328.405, "timestamp": "00:55:28", "text": "任何事物。任何類型的"}, {"type": "subtitle", "time": 3330.289, "timestamp": "00:55:30", "text": "禮物。這是一種感覺，也是"}, {"type": "subtitle", "time": 3332.341, "timestamp": "00:55:32", "text": "表達。這背後究竟隱藏著什麼？"}, {"type": "subtitle", "time": 3335.12, "timestamp": "00:55:35", "text": "不是禮物。我送的任何禮物"}, {"type": "subtitle", "time": 3337.603, "timestamp": "00:55:37", "text": "比如說，如果你只能給我一個"}, {"type": "subtitle", "time": 3339.528, "timestamp": "00:55:39", "text": "牙膏、牙刷或"}, {"type": "subtitle", "time": 3341.391, "timestamp": "00:55:41", "text": "任何有用的東西"}, {"type": "subtitle", "time": 3343.812, "timestamp": "00:55:43", "text": "就我的日常需求而言，我會很滿意"}, {"type": "subtitle", "time": 3348.299, "timestamp": "00:55:48", "text": "或用任何東西。所以，就是這樣。"}, {"type": "subtitle", "time": 3352.233, "timestamp": "00:55:52", "text": "那背後的感受。這"}, {"type": "subtitle", "time": 3353.989, "timestamp": "00:55:53", "text": "想買東西的人"}, {"type": "subtitle", "time": 3358.502, "timestamp": "00:55:58", "text": "把它送給我吧。那種感覺"}]
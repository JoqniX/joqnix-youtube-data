[{"type": "subtitle", "time": 3066.925, "timestamp": "00:51:06", "text": "花點時間陪我。嗯，我想要"}, {"type": "subtitle", "time": 3068.702, "timestamp": "00:51:08", "text": "玩遊戲或社群遊戲"}, {"type": "chat", "time": 3069.253, "timestamp": "00:51:09", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "I'll for sure, sorry I haven't been able to catch up on stuff 😭"}, {"type": "subtitle", "time": 3076.925, "timestamp": "00:51:16", "text": "我們在一起，但我的心卻有些東西，有些東西在我心中"}, {"type": "subtitle", "time": 3078.835, "timestamp": "00:51:18", "text": "他覺得自己應該這麼做，但現在還不應該。"}, {"type": "subtitle", "time": 3087.889, "timestamp": "00:51:27", "text": "總有一天，但不是今天。那個東西。是的，因為"}, {"type": "subtitle", "time": 3090.263, "timestamp": "00:51:30", "text": "那是因為，比如說，我一直沒…"}, {"type": "subtitle", "time": 3092.84, "timestamp": "00:51:32", "text": "透過舉辦這些社區活動和"}, {"type": "subtitle", "time": 3097.486, "timestamp": "00:51:37", "text": "類似的事情每個人都會遇到。我想我已經有了"}, {"type": "subtitle", "time": 3099.176, "timestamp": "00:51:39", "text": "我一直待在自己的空間裡，或是在我的"}, {"type": "chat", "time": 3104.402, "timestamp": "00:51:44", "author": "@LeverBoi", "avatar": "https://yt4.ggpht.com/xNxuxXmHi1c7fysDq7xCqQFkIHS14-WZ-pDk_WA0vJh_7H6RdN1zGFsbYrCE6izTRTxqZPdBqA=s64-c-k-c0x00ffffff-no-rj", "message": "Take your time for sure!"}, {"type": "subtitle", "time": 3106.183, "timestamp": "00:51:46", "text": "我的外殼，但我仍然是我"}, {"type": "subtitle", "time": 3108.237, "timestamp": "00:51:48", "text": "我很感激你。"}, {"type": "subtitle", "time": 3112.338, "timestamp": "00:51:52", "text": "我的「星座們」。我的，呃，不，”"}, {"type": "subtitle", "time": 3115.158, "timestamp": "00:51:55", "text": "「這不是他們喜歡的，」這些傑出的導演們說。 正確的？ 「音樂會唱片」？是的，所有人"}, {"type": "subtitle", "time": 3117.876, "timestamp": "00:51:57", "text": "正確的？ 「音樂會唱片」？是的，所有人 他們過去常說：“是的，我們希望你…”"}]
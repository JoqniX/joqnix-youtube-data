[{"type": "subtitle", "time": 8004.43, "timestamp": "02:13:24", "text": "その"}, {"type": "subtitle", "time": 8008.55, "timestamp": "02:13:28", "text": "わかった。ジャンプのタイミング、タイミング"}, {"type": "subtitle", "time": 8024.35, "timestamp": "02:13:44", "text": "わかった。"}, {"type": "subtitle", "time": 8027.7, "timestamp": "02:13:47", "text": "バカドゥー。バカドゥー。"}, {"type": "subtitle", "time": 8028.95, "timestamp": "02:13:48", "text": "[音楽]"}, {"type": "subtitle", "time": 8031.79, "timestamp": "02:13:51", "text": "バケツから、あ、バケツがある"}, {"type": "subtitle", "time": 8035.31, "timestamp": "02:13:55", "text": "ここ。そして私はいくつか手に入れるだろう"}, {"type": "subtitle", "time": 8038.31, "timestamp": "02:13:58", "text": "水。あ、待って。私は水を飲むことができません"}]
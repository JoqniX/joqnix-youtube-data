[{"type": "subtitle", "time": 7024.75, "timestamp": "01:57:04", "text": "H"}, {"type": "subtitle", "time": 7027.51, "timestamp": "01:57:07", "text": "わかった。夜だとわかっているし、"}, {"type": "subtitle", "time": 7039.39, "timestamp": "01:57:19", "text": "わかった。それで、外側に向けて作りました"}, {"type": "subtitle", "time": 7043.55, "timestamp": "01:57:23", "text": "そんな感じのものを"}, {"type": "subtitle", "time": 7047.75, "timestamp": "01:57:27", "text": "角。だから私はただ積み上げていくんだと思う"}, {"type": "subtitle", "time": 7050.55, "timestamp": "01:57:30", "text": "実際、私がやっていないことは持っていません。"}, {"type": "subtitle", "time": 7054.149, "timestamp": "01:57:34", "text": "私の考えでは、"}, {"type": "subtitle", "time": 7056.31, "timestamp": "01:57:36", "text": "この層は、"}, {"type": "subtitle", "time": 7059.27, "timestamp": "01:57:39", "text": "溶岩は今や底のようになっている。だから私は"}, {"type": "subtitle", "time": 7061.83, "timestamp": "01:57:41", "text": "上に広げるか、これより上にしてください"}, {"type": "subtitle", "time": 7065.75, "timestamp": "01:57:45", "text": "または、ここまで展開するという意味"}, {"type": "subtitle", "time": 7069.99, "timestamp": "01:57:49", "text": "なんて言えばいいんだろう？えっと、待って"}, {"type": "subtitle", "time": 7072.79, "timestamp": "01:57:52", "text": "これはできる。あ、待って、できるよ"}, {"type": "subtitle", "time": 7075.03, "timestamp": "01:57:55", "text": "実際にこれを実行してください。うん、そんな感じ"}, {"type": "subtitle", "time": 7077.27, "timestamp": "01:57:57", "text": "これを拡張して、"}]
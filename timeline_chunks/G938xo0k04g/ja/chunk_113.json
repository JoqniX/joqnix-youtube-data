[{"type": "subtitle", "time": 6794.31, "timestamp": "01:53:14", "text": "ここ。問題は、私がただ"}, {"type": "subtitle", "time": 6797.83, "timestamp": "01:53:17", "text": "ほら、私が欲しかったように、欲しかったように"}, {"type": "subtitle", "time": 6801.669, "timestamp": "01:53:21", "text": "このように単数形のように、しかしあなたは"}, {"type": "subtitle", "time": 6804.79, "timestamp": "01:53:24", "text": "サポートプラットフォームとそれらすべてを配置する"}, {"type": "subtitle", "time": 6808.629, "timestamp": "01:53:28", "text": "まさに悪ふざけだよ、言っておくけど。"}, {"type": "subtitle", "time": 6813.03, "timestamp": "01:53:33", "text": "だから私の考えは、"}, {"type": "subtitle", "time": 6816.87, "timestamp": "01:53:36", "text": "こう言って、大丈夫にしてください。それで"}, {"type": "subtitle", "time": 6820.07, "timestamp": "01:53:40", "text": "私の考えはこれを取り除くことだったのですが、これは"}, {"type": "subtitle", "time": 6822.27, "timestamp": "01:53:42", "text": "こうしてください"}, {"type": "subtitle", "time": 6824.55, "timestamp": "01:53:44", "text": "実は。えっと、これは実際には"}, {"type": "subtitle", "time": 6827.31, "timestamp": "01:53:47", "text": "でも、かっこいいですね。待って、このデザインかっこいい。"}]
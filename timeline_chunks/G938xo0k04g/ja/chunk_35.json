[{"type": "subtitle", "time": 2101.15, "timestamp": "00:35:01", "text": "あなたの体は修復されました"}, {"type": "subtitle", "time": 2103.91, "timestamp": "00:35:03", "text": "初め。プラス"}, {"type": "subtitle", "time": 2105.91, "timestamp": "00:35:05", "text": "えーと、とにかく私は"}, {"type": "subtitle", "time": 2107.51, "timestamp": "00:35:07", "text": "日本。"}, {"type": "subtitle", "time": 2111.19, "timestamp": "00:35:11", "text": "6月、7月以降。そう、"}, {"type": "subtitle", "time": 2114.15, "timestamp": "00:35:14", "text": "ここ数ヶ月ほどです。だから、私にはわからない。"}, {"type": "subtitle", "time": 2122.109, "timestamp": "00:35:22", "text": "痛み。"}, {"type": "subtitle", "time": 2123.79, "timestamp": "00:35:23", "text": "えっと"}, {"type": "subtitle", "time": 2130.75, "timestamp": "00:35:30", "text": "日とともに"}, {"type": "subtitle", "time": 2134.27, "timestamp": "00:35:34", "text": "34. 今日は"}, {"type": "subtitle", "time": 2136.27, "timestamp": "00:35:36", "text": "になるだろう"}, {"type": "subtitle", "time": 2139.23, "timestamp": "00:35:39", "text": "音楽を作っている"}, {"type": "subtitle", "time": 2146.95, "timestamp": "00:35:46", "text": "宿題。だから私たちは最善を尽くします"}, {"type": "subtitle", "time": 2150.349, "timestamp": "00:35:50", "text": "今日の音楽と"}, {"type": "subtitle", "time": 2154.95, "timestamp": "00:35:54", "text": "後でスケジュールを組むことにします。スケジュール"}, {"type": "subtitle", "time": 2157.75, "timestamp": "00:35:57", "text": "1つ。"}]
[{"type": "subtitle", "time": 10983.269, "timestamp": "03:03:03", "text": "考える。あなたは何をしましたか？何があなたを"}, {"type": "subtitle", "time": 10988.03, "timestamp": "03:03:08", "text": "これ、いい感じだと思う？わからない。"}, {"type": "subtitle", "time": 10992.87, "timestamp": "03:03:12", "text": "ジョック。教えてくれ、ロバよ、君の"}, {"type": "subtitle", "time": 11010.19, "timestamp": "03:03:30", "text": "来るよ。"}, {"type": "subtitle", "time": 11026.07, "timestamp": "03:03:46", "text": "何が、あの物に似ているのか"}, {"type": "subtitle", "time": 11030.19, "timestamp": "03:03:50", "text": "瞬間は、ブロックだけを使って"}, {"type": "subtitle", "time": 11032.79, "timestamp": "03:03:52", "text": "建てる。それを均等にしたいなら"}, {"type": "subtitle", "time": 11036.75, "timestamp": "03:03:56", "text": "ファンシー、実際に思いつくことができる"}, {"type": "subtitle", "time": 11039.469, "timestamp": "03:03:59", "text": "他のものを追加する"}]
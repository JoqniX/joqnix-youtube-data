[{"type": "subtitle", "time": 2708.63, "timestamp": "00:45:08", "text": "アーナ、私たちも日本語の練習が必要です。私"}, {"type": "subtitle", "time": 2710.349, "timestamp": "00:45:10", "text": "忘れたと思う"}, {"type": "subtitle", "time": 2713.109, "timestamp": "00:45:13", "text": "すべて。積極的に練習する必要がある"}, {"type": "subtitle", "time": 2713.75, "timestamp": "00:45:13", "text": "日本語。"}, {"type": "subtitle", "time": 2715.63, "timestamp": "00:45:15", "text": "[音楽]"}, {"type": "subtitle", "time": 2720.069, "timestamp": "00:45:20", "text": "ああ、もし私がこんな風だったら、私はとても"}, {"type": "subtitle", "time": 2721.99, "timestamp": "00:45:21", "text": "勤勉な"}, {"type": "subtitle", "time": 2724.23, "timestamp": "00:45:24", "text": "昨日の試合で薬物を製造し、"}, {"type": "subtitle", "time": 2727.589, "timestamp": "00:45:27", "text": "ここ数日は毎日。に関して言えば"}, {"type": "subtitle", "time": 2730.47, "timestamp": "00:45:30", "text": "音楽制作などの他のもの"}, {"type": "subtitle", "time": 2733.309, "timestamp": "00:45:33", "text": "そして学ぶことが好き"}, {"type": "subtitle", "time": 2736.51, "timestamp": "00:45:36", "text": "私は日本人です"}, {"type": "subtitle", "time": 2759.589, "timestamp": "00:45:59", "text": "の上。待って、待って、待って。みんな、みんな、みんな、"}]
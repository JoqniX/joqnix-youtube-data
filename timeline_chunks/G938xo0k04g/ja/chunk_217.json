[{"type": "subtitle", "time": 13020.75, "timestamp": "03:37:00", "text": "それで"}, {"type": "subtitle", "time": 13023.55, "timestamp": "03:37:03", "text": "もちろん。私はとても"}, {"type": "subtitle", "time": 13028.67, "timestamp": "03:37:08", "text": "長い間お休みしてしまい、申し訳ありませんでした。"}, {"type": "subtitle", "time": 13032.55, "timestamp": "03:37:12", "text": "えっと、お皿洗いが終わったところです。"}, {"type": "subtitle", "time": 13034.83, "timestamp": "03:37:14", "text": "食べる"}, {"type": "subtitle", "time": 13041.389, "timestamp": "03:37:21", "text": "すべて。疲れすぎたので、"}, {"type": "subtitle", "time": 13044.55, "timestamp": "03:37:24", "text": "男。私のエネルギーレベルはどうなっているの？"}, {"type": "subtitle", "time": 13046.03, "timestamp": "03:37:26", "text": "これら"}, {"type": "subtitle", "time": 13049.11, "timestamp": "03:37:29", "text": "日？以前よりも疲れを感じています"}, {"type": "subtitle", "time": 13050.99, "timestamp": "03:37:30", "text": "毎日"}, {"type": "subtitle", "time": 13052.09, "timestamp": "03:37:32", "text": "今。"}, {"type": "subtitle", "time": 13053.87, "timestamp": "03:37:33", "text": "[音楽]"}]
[{"type": "subtitle", "time": 4226.31, "timestamp": "01:10:26", "text": "えーと、メッカのアニメは"}, {"type": "subtitle", "time": 4229.03, "timestamp": "01:10:29", "text": "方法。私がリメイクしようとしたあの曲"}, {"type": "subtitle", "time": 4231.83, "timestamp": "01:10:31", "text": "そして、歌も歌ってみるんですよね？そして"}, {"type": "subtitle", "time": 4233.83, "timestamp": "01:10:33", "text": "今私が口ずさんでいるメロディー、"}, {"type": "subtitle", "time": 4235.07, "timestamp": "01:10:35", "text": "アニメが来た"}, {"type": "subtitle", "time": 4240.87, "timestamp": "01:10:40", "text": "外に出て、CFは、ええと、"}, {"type": "subtitle", "time": 4245.189, "timestamp": "01:10:45", "text": "オープニングの終わり、えーと終わり、えーとえーと"}, {"type": "subtitle", "time": 4248.229, "timestamp": "01:10:48", "text": "音楽はKが担当しました。そして私が歌ったのは"}, {"type": "subtitle", "time": 4251.43, "timestamp": "01:10:51", "text": "「No Melon No Lemon」のあの曲を歌っています"}, {"type": "subtitle", "time": 4253.35, "timestamp": "01:10:53", "text": "それは後半になるだろう"}, {"type": "subtitle", "time": 4255.59, "timestamp": "01:10:55", "text": "アニメ。後半はこんな感じになるだろう"}, {"type": "subtitle", "time": 4257.63, "timestamp": "01:10:57", "text": "第6話以降または"}]
[{"type": "subtitle", "time": 5762.35, "timestamp": "01:36:02", "text": "オハイオ州。今日は幸せです。今日は5日です"}, {"type": "subtitle", "time": 5764.95, "timestamp": "01:36:04", "text": "10月。そうですね、皆さんが"}, {"type": "subtitle", "time": 5766.43, "timestamp": "01:36:06", "text": "行う"}, {"type": "subtitle", "time": 5770.43, "timestamp": "01:36:10", "text": "良い。今日はちょっと遅くまで寝ていた"}, {"type": "subtitle", "time": 5774.95, "timestamp": "01:36:14", "text": "昨日12時間配信した後、私は"}, {"type": "subtitle", "time": 5777.91, "timestamp": "01:36:17", "text": "準備する時間が全くなかったから"}, {"type": "subtitle", "time": 5781.51, "timestamp": "01:36:21", "text": "今日は何の日か知ってる？ええと、明日"}, {"type": "subtitle", "time": 5783.75, "timestamp": "01:36:23", "text": "明日は女王陛下の誕生日です"}, {"type": "subtitle", "time": 5786.95, "timestamp": "01:36:26", "text": "そして今日は実は私の誕生日なんです"}, {"type": "subtitle", "time": 5792.07, "timestamp": "01:36:32", "text": "私の奥様。そう、ママのジョークは"}, {"type": "subtitle", "time": 5795.95, "timestamp": "01:36:35", "text": "今日は誕生日です。ああ、目が覚めた"}, {"type": "subtitle", "time": 5799.59, "timestamp": "01:36:39", "text": "遅かったので、彼女に電話をかけ、"}, {"type": "subtitle", "time": 5802.229, "timestamp": "01:36:42", "text": "いろいろなものを持って、誕生日おめでとうと言ってください。"}, {"type": "subtitle", "time": 5805.55, "timestamp": "01:36:45", "text": "もの。それから私は思った、「ああ、"}, {"type": "subtitle", "time": 5808.47, "timestamp": "01:36:48", "text": "待って。実は準備していなかったのですが、"}, {"type": "subtitle", "time": 5810.709, "timestamp": "01:36:50", "text": "他の配信に集中していたような感じだった。私"}, {"type": "subtitle", "time": 5813.149, "timestamp": "01:36:53", "text": "実際には準備を忘れていました"}, {"type": "subtitle", "time": 5816.95, "timestamp": "01:36:56", "text": "明日。」そして私は「ああ、神様、私は"}]
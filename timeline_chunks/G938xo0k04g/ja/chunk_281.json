[{"type": "subtitle", "time": 16870.83, "timestamp": "04:41:10", "text": "ええ、私は下降します"}, {"type": "subtitle", "time": 16878.35, "timestamp": "04:41:18", "text": "持続する。よし、落ち着かなきゃ"}, {"type": "subtitle", "time": 16881.11, "timestamp": "04:41:21", "text": "これ。うん、私は引き続きいじくり回す必要がある"}, {"type": "subtitle", "time": 16883.11, "timestamp": "04:41:23", "text": "周りを見回して、これがどのように機能するかを学びましょう。"}, {"type": "subtitle", "time": 16899.628, "timestamp": "04:41:39", "text": "というわけで、元の作業に戻りましょう。"}, {"type": "subtitle", "time": 16908.55, "timestamp": "04:41:48", "text": "8 そして発振器を取り除くことができます"}, {"type": "subtitle", "time": 16913.51, "timestamp": "04:41:53", "text": "位置決め、自動化、マクロ、そして"}]
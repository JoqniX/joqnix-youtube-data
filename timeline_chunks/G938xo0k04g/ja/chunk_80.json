[{"type": "subtitle", "time": 4801.43, "timestamp": "01:20:01", "text": "12対1とか、そんな感じ。うん、ランチ"}, {"type": "subtitle", "time": 4802.99, "timestamp": "01:20:02", "text": "壊す。その後"}, {"type": "subtitle", "time": 4806.189, "timestamp": "01:20:06", "text": "ランチは私の個人的なミミです"}, {"type": "chat", "time": 4808.14, "timestamp": "01:20:08", "author": "@AerinViolet", "avatar": "https://yt4.ggpht.com/UKawanVvntNiAwz6RWv6wPk_S8YwApvPcCfLApO-du_RbQRIPGtzJ5FTt1DCNmZFJWc_2vxlqw=s64-c-k-c0x00ffffff-no-rj", "message": "in our household. breakfast at 11am or 12pm and then lunch at 3:30-4pm. so I wouldn't be hungry dw"}, {"type": "subtitle", "time": 4808.75, "timestamp": "01:20:08", "text": "できる時間"}, {"type": "subtitle", "time": 4813.03, "timestamp": "01:20:13", "text": "私はそれを3時間、あるいは2時間行うと言ってください。"}, {"type": "subtitle", "time": 4815.229, "timestamp": "01:20:15", "text": "その後、音楽配信を行います"}, {"type": "subtitle", "time": 4818.27, "timestamp": "01:20:18", "text": "ミュージックビデオ"}, {"type": "subtitle", "time": 4823.87, "timestamp": "01:20:23", "text": "音楽的なペルソナ、えーと、3時間。"}, {"type": "subtitle", "time": 4827.189, "timestamp": "01:20:27", "text": "それから夕方には散歩に行くか"}, {"type": "subtitle", "time": 4830.31, "timestamp": "01:20:30", "text": "外からガレージに触れて来る"}, {"type": "subtitle", "time": 4832.709, "timestamp": "01:20:32", "text": "戻る。夜は娯楽を楽しむ"}, {"type": "subtitle", "time": 4836.79, "timestamp": "01:20:36", "text": "他の人と話したり見たりする時間"}, {"type": "subtitle", "time": 4839.189, "timestamp": "01:20:39", "text": "映画とか何かとか、そういうのを包む"}, {"type": "subtitle", "time": 4842.709, "timestamp": "01:20:42", "text": "すべてを起こして、昼食、夕食を食べ、"}, {"type": "subtitle", "time": 4851.669, "timestamp": "01:20:51", "text": "もの。別れる。私たちの家で。朝食"}, {"type": "subtitle", "time": 4853.83, "timestamp": "01:20:53", "text": "午前11時または午後12時その後、昼食は"}, {"type": "subtitle", "time": 4858.31, "timestamp": "01:20:58", "text": "午前3時～4時。だからお腹は空かないだろう。ああ、"}]
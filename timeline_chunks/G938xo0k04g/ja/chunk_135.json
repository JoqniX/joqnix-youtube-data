[{"type": "subtitle", "time": 8100.229, "timestamp": "02:15:00", "text": "でも、お元気でいらっしゃることを願っています。希望"}, {"type": "subtitle", "time": 8103.99, "timestamp": "02:15:03", "text": "サポート役としてロールプレイをする。何てことだ。私"}, {"type": "subtitle", "time": 8107.189, "timestamp": "02:15:07", "text": "私がそれを壊してしまったのか？わかった。うまくいっています。"}, {"type": "subtitle", "time": 8108.35, "timestamp": "02:15:08", "text": "しかし"}, {"type": "subtitle", "time": 8110.95, "timestamp": "02:15:10", "text": "ええ、通常はそういう風には機能しません。"}, {"type": "subtitle", "time": 8113.069, "timestamp": "02:15:13", "text": "しかし"}, {"type": "subtitle", "time": 8124.589, "timestamp": "02:15:24", "text": "男。お元気でいらっしゃることを願っています"}, {"type": "subtitle", "time": 8127.189, "timestamp": "02:15:27", "text": "良い。配信にお越しいただきありがとうございます。"}, {"type": "subtitle", "time": 8136.51, "timestamp": "02:15:36", "text": "メッセージ。えっと、どうやって"}, {"type": "subtitle", "time": 8139.87, "timestamp": "02:15:39", "text": "どこへ行くか"}, {"type": "subtitle", "time": 8159.149, "timestamp": "02:15:59", "text": "水を手に入れるために水を使う？うん。こんにちは、"}]
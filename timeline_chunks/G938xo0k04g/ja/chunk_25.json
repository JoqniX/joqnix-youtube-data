[{"type": "subtitle", "time": 1511.669, "timestamp": "00:25:11", "text": "今は全て順調であることを願っています。でも私も"}, {"type": "subtitle", "time": 1517.149, "timestamp": "00:25:17", "text": "挨拶したかっただけです"}, {"type": "subtitle", "time": 1519.23, "timestamp": "00:25:19", "text": "いかなる"}, {"type": "subtitle", "time": 1538.029, "timestamp": "00:25:38", "text": "ニース。ああ神様、どうして私はこんなに下手なんだろう"}, {"type": "subtitle", "time": 1551.43, "timestamp": "00:25:51", "text": "しかし、彼らはインドのイアンユーチューバーですが、"}, {"type": "subtitle", "time": 1554.789, "timestamp": "00:25:54", "text": "彼らはインド人だが、アメリカに住んでいる。"}]
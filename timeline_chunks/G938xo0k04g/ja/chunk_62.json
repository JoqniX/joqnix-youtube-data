[{"type": "subtitle", "time": 3726.109, "timestamp": "01:02:06", "text": "薬物"}, {"type": "subtitle", "time": 3729.15, "timestamp": "01:02:09", "text": "また。誓って言うけど、私はこれに中毒じゃない"}, {"type": "subtitle", "time": 3730.91, "timestamp": "01:02:10", "text": "ゲーム。"}, {"type": "subtitle", "time": 3763.109, "timestamp": "01:02:43", "text": "うん、まるで君みたいに"}, {"type": "subtitle", "time": 3765.19, "timestamp": "01:02:45", "text": "プレイしてみないと分からない"}, {"type": "subtitle", "time": 3767.03, "timestamp": "01:02:47", "text": "あなた自身。"}, {"type": "subtitle", "time": 3769.91, "timestamp": "01:02:49", "text": "ドラッグを作るだけじゃなくて、すごく楽しいんです"}, {"type": "subtitle", "time": 3772.23, "timestamp": "01:02:52", "text": "すべてはゲームのようなもの"}, {"type": "subtitle", "time": 3774.87, "timestamp": "01:02:54", "text": "プレイスタイル、すべてがとてもスムーズで"}, {"type": "subtitle", "time": 3776.47, "timestamp": "01:02:56", "text": "すべて。たとえこれが多少"}, {"type": "subtitle", "time": 3777.87, "timestamp": "01:02:57", "text": "ここで遅れて"}]
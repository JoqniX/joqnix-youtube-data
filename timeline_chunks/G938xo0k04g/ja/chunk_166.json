[{"type": "subtitle", "time": 9960.469, "timestamp": "02:46:00", "text": "不具合？ゾンビが"}, {"type": "subtitle", "time": 9961.55, "timestamp": "02:46:01", "text": "攻撃する"}, {"type": "subtitle", "time": 9967.67, "timestamp": "02:46:07", "text": "[音楽]"}, {"type": "subtitle", "time": 9971.389, "timestamp": "02:46:11", "text": "うわあ、彼らは骸骨を殺したんだ。"}, {"type": "subtitle", "time": 9975.349, "timestamp": "02:46:15", "text": "わあ、すごくかっこいいですね。よし、行こう"}, {"type": "subtitle", "time": 9982.97, "timestamp": "02:46:22", "text": "寝る。私は今、"}, {"type": "subtitle", "time": 9984.51, "timestamp": "02:46:24", "text": "[音楽]"}, {"type": "subtitle", "time": 9988.469, "timestamp": "02:46:28", "text": "打つ？骸骨が彼らを撃ったからだ。ああ、"}, {"type": "subtitle", "time": 9990.349, "timestamp": "02:46:30", "text": "アルーチャン"}, {"type": "subtitle", "time": 10003.469, "timestamp": "02:46:43", "text": "いや。喧嘩したいんだ。私の"}, {"type": "subtitle", "time": 10006.19, "timestamp": "02:46:46", "text": "神。したい"}, {"type": "subtitle", "time": 10008.91, "timestamp": "02:46:48", "text": "乱闘。喧嘩したい。"}, {"type": "subtitle", "time": 10011.469, "timestamp": "02:46:51", "text": "ああ、それと"}, {"type": "subtitle", "time": 10014.87, "timestamp": "02:46:54", "text": "ああ、神様、私はここで死ぬんだ。私はただ"}, {"type": "subtitle", "time": 10017.349, "timestamp": "02:46:57", "text": "罠があって、私は落ちたと言いたい"}]
[{"type": "subtitle", "time": 7740.99, "timestamp": "02:09:00", "text": "難しい。私の心は"}, {"type": "subtitle", "time": 7744.99, "timestamp": "02:09:04", "text": "死にかけている。ルーン文字でより速く。そして私は殺す"}, {"type": "subtitle", "time": 7746.99, "timestamp": "02:09:06", "text": "彼ら。私は"}, {"type": "subtitle", "time": 7758.03, "timestamp": "02:09:18", "text": "半分"}, {"type": "subtitle", "time": 7761.69, "timestamp": "02:09:21", "text": "心は私の中に残された。"}, {"type": "subtitle", "time": 7765.229, "timestamp": "02:09:25", "text": "[音楽]"}, {"type": "subtitle", "time": 7774.79, "timestamp": "02:09:34", "text": "おお。えっと、ハンガナは全部揃っていますか？いいえ。"}, {"type": "subtitle", "time": 7783.87, "timestamp": "02:09:43", "text": "えっと、３つ"}]
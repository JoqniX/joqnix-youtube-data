[{"type": "subtitle", "time": 2820.309, "timestamp": "00:47:00", "text": "本物。これが本当だと言ってくれよ。私は思う"}, {"type": "subtitle", "time": 2822.39, "timestamp": "00:47:02", "text": "これは新しいキャラクターですよね？多分。"}, {"type": "subtitle", "time": 2831.63, "timestamp": "00:47:11", "text": "彼女はこのキャラクターの声を担当しているのですか、それとも"}, {"type": "subtitle", "time": 2835.829, "timestamp": "00:47:15", "text": "えっと、私を刺激する？それは、うーんうーんみたいな感じ"}, {"type": "subtitle", "time": 2838.15, "timestamp": "00:47:18", "text": "このキャラクターのオープニング曲だと思います。"}, {"type": "subtitle", "time": 2841.67, "timestamp": "00:47:21", "text": "何てことだ。カフカについても語っている"}, {"type": "subtitle", "time": 2843.95, "timestamp": "00:47:23", "text": "カファンみたいに"}, {"type": "subtitle", "time": 2847.75, "timestamp": "00:47:27", "text": "モロップ・モラリは、"}, {"type": "subtitle", "time": 2850.63, "timestamp": "00:47:30", "text": "コンサートですよね？私の理解が正しければ。私は見た"}, {"type": "subtitle", "time": 2853.75, "timestamp": "00:47:33", "text": "そのツイート。私はどこにいるのかわかりません"}, {"type": "subtitle", "time": 2856.87, "timestamp": "00:47:36", "text": "それ？そのツイートを見ました。私はポスターを見た"}, {"type": "subtitle", "time": 2859.51, "timestamp": "00:47:39", "text": "オン。ああ、これだ。これです。これ"}, {"type": "subtitle", "time": 2862.27, "timestamp": "00:47:42", "text": "1つ。バーチャル大阪ヘルスケア"}, {"type": "subtitle", "time": 2876.109, "timestamp": "00:47:56", "text": "良い。"}]
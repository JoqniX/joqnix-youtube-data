[{"type": "subtitle", "time": 11941.229, "timestamp": "03:19:01", "text": "床。これが地面だと想像してみましょう"}, {"type": "subtitle", "time": 11943.91, "timestamp": "03:19:03", "text": "床があって、地下を建設できない"}, {"type": "subtitle", "time": 11947.469, "timestamp": "03:19:07", "text": "あそこに秘密の研究室がある。これは"}, {"type": "subtitle", "time": 11949.71, "timestamp": "03:19:09", "text": "の"}, {"type": "subtitle", "time": 11955.03, "timestamp": "03:19:15", "text": "伝承的に考えてみてください。はい、私は"}, {"type": "subtitle", "time": 11957.75, "timestamp": "03:19:17", "text": "使命を帯びた星座。はい、私は"}, {"type": "subtitle", "time": 11960.55, "timestamp": "03:19:20", "text": "任務遂行中のスター。"}, {"type": "subtitle", "time": 11963.03, "timestamp": "03:19:23", "text": "もし見知らぬ人が入ってきて"}, {"type": "subtitle", "time": 11965.15, "timestamp": "03:19:25", "text": "これに対して彼らは「ふむ、"}, {"type": "subtitle", "time": 11967.51, "timestamp": "03:19:27", "text": "「怪しい、ここには何があるのだろう？」そして"}, {"type": "subtitle", "time": 11969.11, "timestamp": "03:19:29", "text": "彼らは中に入って、すべてうまくいくんですよね？"}, {"type": "subtitle", "time": 11971.79, "timestamp": "03:19:31", "text": "彼らは「ここは一体何なの？」と思うでしょう。"}, {"type": "subtitle", "time": 11975.389, "timestamp": "03:19:35", "text": "いいえ。だから、だから、だから、だから、"}, {"type": "subtitle", "time": 11978.99, "timestamp": "03:19:38", "text": "では、もし"}, {"type": "subtitle", "time": 11982.71, "timestamp": "03:19:42", "text": "このエリアはどうでしょうか？いいえ、それは"}, {"type": "subtitle", "time": 11985.75, "timestamp": "03:19:45", "text": "それは何の意味も持たないという意味だ。何？何"}, {"type": "subtitle", "time": 11987.99, "timestamp": "03:19:47", "text": "私はこれに携わったのか？私がなぜ"}, {"type": "subtitle", "time": 11995.229, "timestamp": "03:19:55", "text": "[音楽]"}, {"type": "subtitle", "time": 11999.07, "timestamp": "03:19:59", "text": "いや、すごい。待って。考える"}]
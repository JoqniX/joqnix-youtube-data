[{"type": "subtitle", "time": 4512.709, "timestamp": "01:15:12", "text": "私が気づいたのは"}, {"type": "subtitle", "time": 4515.75, "timestamp": "01:15:15", "text": "自分のストリームを視聴する"}, {"type": "subtitle", "time": 4518.07, "timestamp": "01:15:18", "text": "話しているときは、"}, {"type": "subtitle", "time": 4519.669, "timestamp": "01:15:19", "text": "異なる口調で話すか、"}, {"type": "subtitle", "time": 4522.95, "timestamp": "01:15:22", "text": "何か、あるいは私が話しているように"}, {"type": "subtitle", "time": 4525.03, "timestamp": "01:15:25", "text": "あなた自身が、あなたの"}, {"type": "subtitle", "time": 4527.11, "timestamp": "01:15:27", "text": "声が疲れているとき、声が"}, {"type": "subtitle", "time": 4530.87, "timestamp": "01:15:30", "text": "だから死んでる、などなど、あるいはそうでないなら、"}, {"type": "subtitle", "time": 4533.55, "timestamp": "01:15:33", "text": "とても良い話し方で、あなたの"}, {"type": "subtitle", "time": 4537.189, "timestamp": "01:15:37", "text": "いつもの、いつもの、えーと声域とか、そういう感じ"}, {"type": "subtitle", "time": 4539.83, "timestamp": "01:15:39", "text": "何でもいいけど、私が聞いていると"}, {"type": "subtitle", "time": 4542.31, "timestamp": "01:15:42", "text": "私自身が配信している時、同じように聞こえるのは"}, {"type": "subtitle", "time": 4546.87, "timestamp": "01:15:46", "text": "私は普通ですか、私は単調ですか、何が"}, {"type": "subtitle", "time": 4549.51, "timestamp": "01:15:49", "text": "そういう人たちを表す言葉は何ですか？"}, {"type": "subtitle", "time": 4552.79, "timestamp": "01:15:52", "text": "音程を区別できないなど"}, {"type": "subtitle", "time": 4554.11, "timestamp": "01:15:54", "text": "物または"}, {"type": "subtitle", "time": 4557.43, "timestamp": "01:15:57", "text": "わからないこと、どう感じるか"}, {"type": "subtitle", "time": 4559.59, "timestamp": "01:15:59", "text": "あんな感じ"}]
[{"type": "subtitle", "time": 16381.389, "timestamp": "04:33:01", "text": "はい、今はそうです。だから、私は武装しなければならない"}, {"type": "subtitle", "time": 16390.269, "timestamp": "04:33:10", "text": "わかった。えっと、ここから"}, {"type": "subtitle", "time": 16392.17, "timestamp": "04:33:12", "text": "見る。何が"}, {"type": "subtitle", "time": 16395.869, "timestamp": "04:33:15", "text": "[音楽]"}, {"type": "subtitle", "time": 16411.51, "timestamp": "04:33:31", "text": "よし、オキシレーターだけを取り上げよう"}, {"type": "subtitle", "time": 16413.99, "timestamp": "04:33:33", "text": "1つ。締め切り時間を変更します"}]
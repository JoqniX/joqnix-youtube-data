[{"type": "subtitle", "time": 17820.99, "timestamp": "04:57:00", "text": "波"}, {"type": "subtitle", "time": 17824.55, "timestamp": "04:57:04", "text": "テーブル。えっと、これを開けてください。サイドチェーン"}, {"type": "subtitle", "time": 17825.628, "timestamp": "04:57:05", "text": "オーディオ"}, {"type": "subtitle", "time": 17828.05, "timestamp": "04:57:08", "text": "から"}, {"type": "subtitle", "time": 17829.868, "timestamp": "04:57:09", "text": "[音楽]"}, {"type": "subtitle", "time": 17833.91, "timestamp": "04:57:13", "text": "これ。これを引き下ろしてください。何？私は愛する"}, {"type": "subtitle", "time": 17836.15, "timestamp": "04:57:16", "text": "カレーのようなインド料理。ええ、カレーは"}, {"type": "subtitle", "time": 17839.14, "timestamp": "04:57:19", "text": "私も大好きです。"}, {"type": "subtitle", "time": 17849.99, "timestamp": "04:57:29", "text": "[音楽]"}, {"type": "subtitle", "time": 17852.788, "timestamp": "04:57:32", "text": "ええと、この側圧縮は"}, {"type": "subtitle", "time": 17855.66, "timestamp": "04:57:35", "text": "聞こえるけど、それを重ねることができる"}, {"type": "subtitle", "time": 17857.23, "timestamp": "04:57:37", "text": "[音楽]"}, {"type": "subtitle", "time": 17859.69, "timestamp": "04:57:39", "text": "ここ。見聞きできます"}, {"type": "subtitle", "time": 17865.23, "timestamp": "04:57:45", "text": "[音楽]"}, {"type": "subtitle", "time": 17870.61, "timestamp": "04:57:50", "text": "それ。ちょっとうるさいですね。下げましょう。"}]
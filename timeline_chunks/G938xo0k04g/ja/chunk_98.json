[{"type": "subtitle", "time": 5882.47, "timestamp": "01:38:02", "text": "えーっと、お祝いのラッピングをするように"}, {"type": "subtitle", "time": 5885.75, "timestamp": "01:38:05", "text": "今日は私の誕生日なんです。オフなので"}, {"type": "subtitle", "time": 5889.27, "timestamp": "01:38:09", "text": "一日休みを取ってもいいかな、それとも"}, {"type": "subtitle", "time": 5892.47, "timestamp": "01:38:12", "text": "明日も配信します。よし、"}, {"type": "subtitle", "time": 5894.95, "timestamp": "01:38:14", "text": "そうします。ええ、そうですね。とにかく、今日は"}, {"type": "subtitle", "time": 5898.03, "timestamp": "01:38:18", "text": "私たちはマインクラフトをプレイする予定です。それで、"}, {"type": "subtitle", "time": 5901.109, "timestamp": "01:38:21", "text": "それで前回は、あ、待って。オフラインです。"}, {"type": "subtitle", "time": 5903.83, "timestamp": "01:38:23", "text": "待って、私は始めなかった"}, {"type": "subtitle", "time": 5907.189, "timestamp": "01:38:27", "text": "サーバ。忘れた。それは確かに存在する。えっと"}, {"type": "subtitle", "time": 5911.87, "timestamp": "01:38:31", "text": "うん。こんにちは。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 5919.95, "timestamp": "01:38:39", "text": "ええ、今日は引き続き"}, {"type": "subtitle", "time": 5925.35, "timestamp": "01:38:45", "text": "私がそう呼んでいる、私たちのスノーラ邸。えっと"}, {"type": "subtitle", "time": 5928.47, "timestamp": "01:38:48", "text": "前回は、何て言うんだっけ"}, {"type": "subtitle", "time": 5931.149, "timestamp": "01:38:51", "text": "それ？前回私たちが作ったのは"}, {"type": "subtitle", "time": 5935.35, "timestamp": "01:38:55", "text": "雪が降っている内側の部分"}, {"type": "subtitle", "time": 5938.229, "timestamp": "01:38:58", "text": "イーグルーみたいなやつ。そして私たちがしたことは"}]
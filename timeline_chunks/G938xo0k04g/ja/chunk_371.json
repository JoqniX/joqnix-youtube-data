[{"type": "subtitle", "time": 22261.35, "timestamp": "06:11:01", "text": "彼ら。ええ、そうですね。うん。こんにちは、Vさん。お元気ですか？"}, {"type": "subtitle", "time": 22263.47, "timestamp": "06:11:03", "text": "あなた？元気ですか？調子はどうですか"}, {"type": "subtitle", "time": 22266.788, "timestamp": "06:11:06", "text": "あなた？ええ、25個くらいは終わりました"}, {"type": "subtitle", "time": 22269.67, "timestamp": "06:11:09", "text": "今のYouTuberたち。私はまだ"}, {"type": "subtitle", "time": 22273.43, "timestamp": "06:11:13", "text": "まだ90点くらい、いや30点くらい終わらせなきゃいけない"}, {"type": "subtitle", "time": 22277.99, "timestamp": "06:11:17", "text": "20人、30人、50人、60人ではなく、"}, {"type": "subtitle", "time": 22280.788, "timestamp": "06:11:20", "text": "追加を完了します。 YouTuberはたくさんいる"}, {"type": "subtitle", "time": 22284.628, "timestamp": "06:11:24", "text": "インドから。ああ、すごい量だ。私"}, {"type": "subtitle", "time": 22287.83, "timestamp": "06:11:27", "text": "Kが大好きです。でも、このラシッドから、私は"}, {"type": "subtitle", "time": 22290.23, "timestamp": "06:11:30", "text": "全員の人数を把握できるようになるでしょう。"}, {"type": "subtitle", "time": 22293.36, "timestamp": "06:11:33", "text": "では、お見せしましょう"}, {"type": "subtitle", "time": 22300.59, "timestamp": "06:11:40", "text": "[音楽]"}, {"type": "subtitle", "time": 22304.75, "timestamp": "06:11:44", "text": "これ。少しだけ追加しました"}, {"type": "subtitle", "time": 22308.868, "timestamp": "06:11:48", "text": "でも、遅刻したの？ええ、遅刻しました。えっと"}]
[{"type": "subtitle", "time": 16741.429, "timestamp": "04:39:01", "text": "働く？これはフィルターオフセットです。えっと"}, {"type": "subtitle", "time": 16745.709, "timestamp": "04:39:05", "text": "金額30％。どうすれば変更できますか？"}, {"type": "subtitle", "time": 16779.75, "timestamp": "04:39:39", "text": "発動しました。これをどうやって接続すればいいですか？"}, {"type": "subtitle", "time": 16782.19, "timestamp": "04:39:42", "text": "これ？"}, {"type": "subtitle", "time": 16783.51, "timestamp": "04:39:43", "text": "[音楽]"}, {"type": "subtitle", "time": 16784.29, "timestamp": "04:39:44", "text": "リセット。"}, {"type": "subtitle", "time": 16787.31, "timestamp": "04:39:47", "text": "[音楽]"}, {"type": "subtitle", "time": 16790.07, "timestamp": "04:39:50", "text": "では、私がやってみよう"}, {"type": "subtitle", "time": 16793.15, "timestamp": "04:39:53", "text": "[音楽]"}]
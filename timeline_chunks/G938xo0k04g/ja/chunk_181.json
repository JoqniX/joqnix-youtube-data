[{"type": "subtitle", "time": 10861.67, "timestamp": "03:01:01", "text": "それでは、ここから先に進みましょうか？えっと"}, {"type": "subtitle", "time": 10880.429, "timestamp": "03:01:20", "text": "ああ、わかった。"}, {"type": "subtitle", "time": 10883.71, "timestamp": "03:01:23", "text": "ああ、神様、私はとても混乱しています。来る"}, {"type": "subtitle", "time": 10887.56, "timestamp": "03:01:27", "text": "見る。とても混乱しています。"}, {"type": "subtitle", "time": 10892.71, "timestamp": "03:01:32", "text": "[音楽]"}, {"type": "subtitle", "time": 10894.269, "timestamp": "03:01:34", "text": "延長したくない"}, {"type": "subtitle", "time": 10907.16, "timestamp": "03:01:47", "text": "これ。では"}, {"type": "subtitle", "time": 10915.23, "timestamp": "03:01:55", "text": "これ？でも、そうじゃない"}, {"type": "subtitle", "time": 10918.44, "timestamp": "03:01:58", "text": "これ。待って。待って。"}]
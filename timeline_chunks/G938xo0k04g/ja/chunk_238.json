[{"type": "subtitle", "time": 14281.349, "timestamp": "03:58:01", "text": "それは後でやります。でも今は、今は"}, {"type": "subtitle", "time": 14290.99, "timestamp": "03:58:10", "text": "ケア。"}, {"type": "subtitle", "time": 14295.55, "timestamp": "03:58:15", "text": "こんにちは。閉じ込められる前に"}, {"type": "subtitle", "time": 14325.469, "timestamp": "03:58:45", "text": "ええ、いくつか見逃したと思います"}, {"type": "subtitle", "time": 14329.349, "timestamp": "03:58:49", "text": "クラス。少なくない。"}, {"type": "subtitle", "time": 14331.55, "timestamp": "03:58:51", "text": "それは"}, {"type": "subtitle", "time": 14336.429, "timestamp": "03:58:56", "text": "少し？私の最後の授業はちょうど42でした"}]
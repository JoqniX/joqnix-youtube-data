[{"type": "subtitle", "time": 20409.948, "timestamp": "05:40:09", "text": "家。そしてそれは"}, {"type": "subtitle", "time": 20413.35, "timestamp": "05:40:13", "text": "ワンちゃん。しかもガソリンがタダでもらえた。病気"}, {"type": "subtitle", "time": 20413.98, "timestamp": "05:40:13", "text": "窃盗"}, {"type": "subtitle", "time": 20415.868, "timestamp": "05:40:15", "text": "[音楽]"}, {"type": "subtitle", "time": 20418.75, "timestamp": "05:40:18", "text": "それ。私は怖い"}, {"type": "subtitle", "time": 20423.83, "timestamp": "05:40:23", "text": "犬。なんてこった。なんてこった。なんてこった。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 20434.47, "timestamp": "05:40:34", "text": "殺せ。殺せ。ごめんなさい。ごめんなさい。"}, {"type": "subtitle", "time": 20442.27, "timestamp": "05:40:42", "text": "ごめん。ああ、私はとても"}, {"type": "subtitle", "time": 20446.548, "timestamp": "05:40:46", "text": "ごめん。肉。ああ、神様。肉を手に入れた。これは"}, {"type": "subtitle", "time": 20448.46, "timestamp": "05:40:48", "text": "その男が望んでいたもの、"}, {"type": "subtitle", "time": 20450.03, "timestamp": "05:40:50", "text": "[音楽]"}, {"type": "subtitle", "time": 20453.91, "timestamp": "05:40:53", "text": "右？ HPが低いです。 HPが低い。私は"}, {"type": "subtitle", "time": 20455.948, "timestamp": "05:40:55", "text": "低い"}, {"type": "subtitle", "time": 20459.91, "timestamp": "05:40:59", "text": "HP。何をするか？何をするか？何をするか？"}]
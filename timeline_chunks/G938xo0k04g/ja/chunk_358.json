[{"type": "subtitle", "time": 21493.37, "timestamp": "05:58:13", "text": "はぁ？それは何ですか？何だって何だって"}, {"type": "subtitle", "time": 21507.948, "timestamp": "05:58:27", "text": "トレーダー。彼の"}, {"type": "subtitle", "time": 21510.47, "timestamp": "05:58:30", "text": "不気味なほど見覚えのある特徴"}, {"type": "subtitle", "time": 21514.19, "timestamp": "05:58:34", "text": "彼のマットビジョン"}, {"type": "subtitle", "time": 21516.628, "timestamp": "05:58:36", "text": "えっと、ヘルメット。マスターが去っていく"}, {"type": "subtitle", "time": 21518.67, "timestamp": "05:58:38", "text": "古い袋を持っていて、"}, {"type": "subtitle", "time": 21523.59, "timestamp": "05:58:43", "text": "青白い体の一部である。私"}, {"type": "subtitle", "time": 21525.19, "timestamp": "05:58:45", "text": "彼のことを覚えておいてください。彼が救出した"}, {"type": "subtitle", "time": 21528.708, "timestamp": "05:58:48", "text": "医者の家にいる私から。その男"}, {"type": "subtitle", "time": 21531.27, "timestamp": "05:58:51", "text": "彼の黒い手で持ち上げられた。覆われています"}, {"type": "subtitle", "time": 21533.43, "timestamp": "05:58:53", "text": "チャクラと共に。何か書いてある"}, {"type": "subtitle", "time": 21537.75, "timestamp": "05:58:57", "text": "彼の輝きについて。待って。そう、この輝きは、"}, {"type": "subtitle", "time": 21539.43, "timestamp": "05:58:59", "text": "右？あ、待って。君たちはできないよ"}]
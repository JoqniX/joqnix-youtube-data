[{"type": "subtitle", "time": 20222.24, "timestamp": "05:37:02", "text": "それ。リスクを冒すべきでしょうか"}, {"type": "subtitle", "time": 20238.07, "timestamp": "05:37:18", "text": "バカ、これはサバイバルホラーゲームであって、"}, {"type": "subtitle", "time": 20245.15, "timestamp": "05:37:25", "text": "つまり、戦闘ではないということです。つまり、"}, {"type": "subtitle", "time": 20248.15, "timestamp": "05:37:28", "text": "私には必要ない"}, {"type": "subtitle", "time": 20249.708, "timestamp": "05:37:29", "text": "[音楽]"}, {"type": "subtitle", "time": 20264.83, "timestamp": "05:37:44", "text": "入れます。作ります"}]
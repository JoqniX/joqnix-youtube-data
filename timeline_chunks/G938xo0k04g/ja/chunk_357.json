[{"type": "subtitle", "time": 21425.51, "timestamp": "05:57:05", "text": "これ？ FBMがドアをロックします。ああ神様、私は"}, {"type": "subtitle", "time": 21436.07, "timestamp": "05:57:16", "text": "怖がった。はぁ？"}, {"type": "subtitle", "time": 21438.11, "timestamp": "05:57:18", "text": "待って、誰かが"}, {"type": "subtitle", "time": 21441.59, "timestamp": "05:57:21", "text": "聞こえましたか？このゲームは何ですか？"}, {"type": "subtitle", "time": 21444.47, "timestamp": "05:57:24", "text": "について？これは、サバイバルゲームです。"}, {"type": "subtitle", "time": 21448.15, "timestamp": "05:57:28", "text": "探索と恐怖のホラーゲーム"}, {"type": "subtitle", "time": 21450.708, "timestamp": "05:57:30", "text": "どこかの謎めいた世界を舞台にしている"}, {"type": "subtitle", "time": 21453.948, "timestamp": "05:57:33", "text": "ソビエト連邦の領土内で"}, {"type": "subtitle", "time": 21457.67, "timestamp": "05:57:37", "text": "ブロック。これはトップダウン視点のフリーロームゲームです"}, {"type": "subtitle", "time": 21464.35, "timestamp": "05:57:44", "text": "そして誰かが"}, {"type": "subtitle", "time": 21467.47, "timestamp": "05:57:47", "text": "中にいるのは誰？"}, {"type": "subtitle", "time": 21470.83, "timestamp": "05:57:50", "text": "この場所。私は聞いた"}, {"type": "subtitle", "time": 21473.708, "timestamp": "05:57:53", "text": "いくつかいくつか"}, {"type": "subtitle", "time": 21475.548, "timestamp": "05:57:55", "text": "音。私は"}]
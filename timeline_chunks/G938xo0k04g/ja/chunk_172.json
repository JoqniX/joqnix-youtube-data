[{"type": "subtitle", "time": 10320.9, "timestamp": "02:52:00", "text": "しかし"}, {"type": "subtitle", "time": 10323.389, "timestamp": "02:52:03", "text": "[音楽]"}, {"type": "subtitle", "time": 10334.23, "timestamp": "02:52:14", "text": "のように？待って、私、今何したの？その時"}, {"type": "subtitle", "time": 10340.69, "timestamp": "02:52:20", "text": "これと"}, {"type": "subtitle", "time": 10343.15, "timestamp": "02:52:23", "text": "[音楽]"}, {"type": "subtitle", "time": 10344.47, "timestamp": "02:52:24", "text": "それから"}, {"type": "subtitle", "time": 10346.19, "timestamp": "02:52:26", "text": "[音楽]"}, {"type": "subtitle", "time": 10348.07, "timestamp": "02:52:28", "text": "おそらくこれだろう。"}, {"type": "subtitle", "time": 10354.03, "timestamp": "02:52:34", "text": "いや、たぶん"}, {"type": "subtitle", "time": 10358.23, "timestamp": "02:52:38", "text": "ああ、なんてことだ、怖かった。たぶんこんな感じ"}, {"type": "subtitle", "time": 10360.19, "timestamp": "02:52:40", "text": "これと"}, {"type": "subtitle", "time": 10364.71, "timestamp": "02:52:44", "text": "上下逆のように、このように。どうやって"}, {"type": "subtitle", "time": 10366.59, "timestamp": "02:52:46", "text": "それは"}, {"type": "subtitle", "time": 10370.67, "timestamp": "02:52:50", "text": "デザイン？これは良いことですか？私はしません"}, {"type": "subtitle", "time": 10375.15, "timestamp": "02:52:55", "text": "知る。私はここで一体何を達成しようとしているのだろうか？"}, {"type": "subtitle", "time": 10377.469, "timestamp": "02:52:57", "text": "ウィンク"}]
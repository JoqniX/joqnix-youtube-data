[{"type": "subtitle", "time": 10021.269, "timestamp": "02:47:01", "text": "あなたではなく、それのために。だから、もし私がプレイするなら"}, {"type": "subtitle", "time": 10022.03, "timestamp": "02:47:02", "text": "これ"}, {"type": "subtitle", "time": 10024.59, "timestamp": "02:47:04", "text": "ここに、それを上に置きます"}, {"type": "subtitle", "time": 10027.71, "timestamp": "02:47:07", "text": "そこには。そして"}, {"type": "subtitle", "time": 10030.95, "timestamp": "02:47:10", "text": "ああ、ああ、神様、私は圧力をかけたい"}, {"type": "subtitle", "time": 10036.11, "timestamp": "02:47:16", "text": "プレートの裏側。ヘルプ。これらのモブは"}, {"type": "subtitle", "time": 10047.23, "timestamp": "02:47:27", "text": "痛み。ああ、君が彼らを殺したんだね。わかった。うん。"}, {"type": "subtitle", "time": 10049.83, "timestamp": "02:47:29", "text": "ああ、なんてことだ。いいえ。私は死ぬんです。私は"}, {"type": "subtitle", "time": 10056.309, "timestamp": "02:47:36", "text": "死ぬ。これがプレッシャープレートです"}, {"type": "subtitle", "time": 10067.71, "timestamp": "02:47:47", "text": "えーと"}, {"type": "subtitle", "time": 10072.15, "timestamp": "02:47:52", "text": "ええ、そうだと思います。いいえ、そう思います。"}]
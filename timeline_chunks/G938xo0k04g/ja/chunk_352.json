[{"type": "subtitle", "time": 21120.39, "timestamp": "05:52:00", "text": "ええ、念のため。うん、そうなってる"}, {"type": "subtitle", "time": 21128.51, "timestamp": "05:52:08", "text": "の上。ドアを閉める。"}, {"type": "subtitle", "time": 21131.03, "timestamp": "05:52:11", "text": "待って。あ、待って。電源を確認してください。どうやって"}, {"type": "subtitle", "time": 21133.27, "timestamp": "05:52:13", "text": "いくらですか？少しはね？うん。"}, {"type": "subtitle", "time": 21137.25, "timestamp": "05:52:17", "text": "あと一日しか持たない。"}, {"type": "subtitle", "time": 21152.39, "timestamp": "05:52:32", "text": "たぶん、寝て治すんだろうな。"}, {"type": "subtitle", "time": 21153.53, "timestamp": "05:52:33", "text": "私はしません"}, {"type": "subtitle", "time": 21167.96, "timestamp": "05:52:47", "text": "知る。なぜこんなに心臓がドキドキするのだろう？"}, {"type": "subtitle", "time": 21176.19, "timestamp": "05:52:56", "text": "ダークウッド。ええ、そうです"}, {"type": "subtitle", "time": 21178.788, "timestamp": "05:52:58", "text": "ダークウッド。つまり、このゲームは無料で"}]
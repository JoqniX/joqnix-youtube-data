[{"type": "subtitle", "time": 12968.63, "timestamp": "03:36:08", "text": "トモドアチ？調べたいですか"}, {"type": "subtitle", "time": 12982.11, "timestamp": "03:36:22", "text": "私はまだここにいる。いいえ、私は"}, {"type": "subtitle", "time": 12985.349, "timestamp": "03:36:25", "text": "えっと、何かいいものをあげよう。わからない"}, {"type": "subtitle", "time": 12988.389, "timestamp": "03:36:28", "text": "もしあなたがホッキョクグマに餌をあげられるなら。待って、私は"}, {"type": "subtitle", "time": 12994.67, "timestamp": "03:36:34", "text": "見る。ホッキョクグマに餌をあげられますか？"}, {"type": "subtitle", "time": 12997.91, "timestamp": "03:36:37", "text": "マインクラフト？待って、お願いだからできるって言って。"}, {"type": "subtitle", "time": 13000.03, "timestamp": "03:36:40", "text": "プレイ"}, {"type": "subtitle", "time": 13019.75, "timestamp": "03:36:59", "text": "はい、戻ってきました。こんにちは。私は生きている。私はとても"}]
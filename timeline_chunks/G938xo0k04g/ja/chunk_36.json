[{"type": "subtitle", "time": 2160.349, "timestamp": "00:36:00", "text": "それで、YouTubeの配信はどこにあるんですか？"}, {"type": "subtitle", "time": 2163.51, "timestamp": "00:36:03", "text": "あれ？ Instagramのツイートをする必要がある"}, {"type": "subtitle", "time": 2192.23, "timestamp": "00:36:32", "text": "でも、何をすればいいのかよくわからない"}, {"type": "subtitle", "time": 2194.51, "timestamp": "00:36:34", "text": "Twitterで"}, {"type": "subtitle", "time": 2197.349, "timestamp": "00:36:37", "text": "実は。私はむしろ、"}, {"type": "subtitle", "time": 2198.75, "timestamp": "00:36:38", "text": "より"}, {"type": "subtitle", "time": 2202.31, "timestamp": "00:36:42", "text": "消費者コンテンツは、消費者のような"}, {"type": "subtitle", "time": 2204.23, "timestamp": "00:36:44", "text": "コンテンツの消費者ではなく、コンテンツ"}, {"type": "subtitle", "time": 2207.19, "timestamp": "00:36:47", "text": "与える人だと思うし、私はその方法を学ぶべきだ"}, {"type": "subtitle", "time": 2210.31, "timestamp": "00:36:50", "text": "コンテンツ提供者になる。"}, {"type": "subtitle", "time": 2211.95, "timestamp": "00:36:51", "text": "トレーニングしなければならなかった"}, {"type": "subtitle", "time": 2215.51, "timestamp": "00:36:55", "text": "もの。また、あの時から、"}, {"type": "subtitle", "time": 2218.47, "timestamp": "00:36:58", "text": "覚えてる？カミソリで支払おうとしたんだけど"}]
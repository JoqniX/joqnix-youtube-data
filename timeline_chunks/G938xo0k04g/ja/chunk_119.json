[{"type": "subtitle", "time": 7142.83, "timestamp": "01:59:02", "text": "上。ああ、彼らは"}, {"type": "subtitle", "time": 7146.149, "timestamp": "01:59:06", "text": "オーバーモルト。何てことだ。 1 2 3、"}, {"type": "subtitle", "time": 7149.149, "timestamp": "01:59:09", "text": "4、5。ああ、神様、彼らがやって来る"}, {"type": "subtitle", "time": 7150.99, "timestamp": "01:59:10", "text": "自分。おお"}, {"type": "subtitle", "time": 7155.32, "timestamp": "01:59:15", "text": "うん。ああ、大変だ。ニース。"}, {"type": "subtitle", "time": 7157.43, "timestamp": "01:59:17", "text": "[笑い]"}, {"type": "subtitle", "time": 7169.149, "timestamp": "01:59:29", "text": "下。大丈夫。閉めるべきだ"}, {"type": "subtitle", "time": 7170.83, "timestamp": "01:59:30", "text": "これ"}, {"type": "subtitle", "time": 7173.83, "timestamp": "01:59:33", "text": "安全性。ゾンビたちが集まって、"}, {"type": "subtitle", "time": 7177.35, "timestamp": "01:59:37", "text": "壁を作るようなものだ。登山のように"}, {"type": "subtitle", "time": 7179.99, "timestamp": "01:59:39", "text": "登れる壁。ゾンビがどういうものか知ってるでしょ"}, {"type": "subtitle", "time": 7182.629, "timestamp": "01:59:42", "text": "大群作戦は効果的ですよね？だから彼らはあなたに会いたいのです"}, {"type": "subtitle", "time": 7184.55, "timestamp": "01:59:44", "text": "そして互いに積み重なろうとする"}, {"type": "subtitle", "time": 7188.07, "timestamp": "01:59:48", "text": "そして、もし彼らがそんなに賢かったら、起き上がるだろう。"}, {"type": "subtitle", "time": 7190.03, "timestamp": "01:59:50", "text": "ああ、"}, {"type": "subtitle", "time": 7198.83, "timestamp": "01:59:58", "text": "一瞬。うん、もう一度やったよ"}]
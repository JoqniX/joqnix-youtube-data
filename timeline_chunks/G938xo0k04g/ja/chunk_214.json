[{"type": "subtitle", "time": 12848.79, "timestamp": "03:34:08", "text": "はい。エマ・シャンがプレーするのを見たことがない"}, {"type": "subtitle", "time": 12850.63, "timestamp": "03:34:10", "text": "Minecraft なので、"}, {"type": "subtitle", "time": 12854.269, "timestamp": "03:34:14", "text": "彼女はまるでプロみたい"}, {"type": "subtitle", "time": 12857.59, "timestamp": "03:34:17", "text": "それ。彼女はプロなのかしら。いいえ、ほとんど"}, {"type": "subtitle", "time": 12860.55, "timestamp": "03:34:20", "text": "Minecraft について知っている人"}, {"type": "subtitle", "time": 12861.389, "timestamp": "03:34:21", "text": "は"}, {"type": "subtitle", "time": 12863.91, "timestamp": "03:34:23", "text": "良い。一方、そうでない人もいる"}, {"type": "subtitle", "time": 12866.95, "timestamp": "03:34:26", "text": "物を作る方法も知っている。ああ、私は"}, {"type": "subtitle", "time": 12870.389, "timestamp": "03:34:30", "text": "便利なオンラインガイドを開いて"}, {"type": "subtitle", "time": 12871.87, "timestamp": "03:34:31", "text": "方法"}]
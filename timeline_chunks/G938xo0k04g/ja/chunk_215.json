[{"type": "subtitle", "time": 12904.79, "timestamp": "03:35:04", "text": "ああ、泣きたい気分だ。涙が出てくる"}, {"type": "subtitle", "time": 12906.87, "timestamp": "03:35:06", "text": "けれど。実は、涙が出てきそうなんです。"}, {"type": "subtitle", "time": 12909.309, "timestamp": "03:35:09", "text": "そういう感じ"}, {"type": "subtitle", "time": 12912.79, "timestamp": "03:35:12", "text": "悲しい。ああ、涙が出てきた。そういうやつ"}, {"type": "subtitle", "time": 12913.95, "timestamp": "03:35:13", "text": "フェルトの"}, {"type": "subtitle", "time": 12916.03, "timestamp": "03:35:16", "text": "悲しい。"}, {"type": "subtitle", "time": 12918.79, "timestamp": "03:35:18", "text": "なぜ？何てことだ。待って、拭かなきゃ"}, {"type": "subtitle", "time": 12921.59, "timestamp": "03:35:21", "text": "涙だよ、ベイビー。知っている。冗談じゃないよ。私"}, {"type": "subtitle", "time": 12929.389, "timestamp": "03:35:29", "text": "離れて。あなたは？なぜ私を見ているのですか？"}, {"type": "subtitle", "time": 12938.91, "timestamp": "03:35:38", "text": "泣く。花をください。私は"}, {"type": "subtitle", "time": 12941.309, "timestamp": "03:35:41", "text": "ハッピー。ください"}, {"type": "subtitle", "time": 12942.99, "timestamp": "03:35:42", "text": "フレーバー、"}, {"type": "subtitle", "time": 12946.71, "timestamp": "03:35:46", "text": "お願いします。待って。おお。おお。おお。それは震えた"}, {"type": "subtitle", "time": 12949.349, "timestamp": "03:35:49", "text": "彼は首を横に振った。それは首を横に振った。"}, {"type": "subtitle", "time": 12950.51, "timestamp": "03:35:50", "text": "ああ、"}, {"type": "subtitle", "time": 12959.11, "timestamp": "03:35:59", "text": "トモダチ。まさか、いや、いや、左に"}]
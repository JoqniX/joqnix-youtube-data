[{"type": "subtitle", "time": 16511.83, "timestamp": "04:35:11", "text": "[音楽]"}, {"type": "subtitle", "time": 16514.83, "timestamp": "04:35:14", "text": "私は「ノー」と言った。"}, {"type": "subtitle", "time": 16532.31, "timestamp": "04:35:32", "text": "それでもMに行くんだ。ああ、なんてことだ。"}, {"type": "subtitle", "time": 16533.99, "timestamp": "04:35:33", "text": "待って、もう一度やり直させて"}, {"type": "subtitle", "time": 16536.15, "timestamp": "04:35:36", "text": "始まり。これはとても紛らわしい。私 私"}, {"type": "subtitle", "time": 16538.269, "timestamp": "04:35:38", "text": "これは質問として尋ねるべきだ"}, {"type": "subtitle", "time": 16542.269, "timestamp": "04:35:42", "text": "今日。 MIDIの場合は、コントロールシフトTを押してください。"}, {"type": "subtitle", "time": 16548.91, "timestamp": "04:35:48", "text": "追跡。それから波を取ります"}, {"type": "subtitle", "time": 16551.869, "timestamp": "04:35:51", "text": "テーブル。それを入れる"}, {"type": "chat", "time": 16559.577, "timestamp": "04:35:59", "author": "@PikuVerma-i6r", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mhD_uBtCD8mWdT0iitBx_Q8bq0TyRBWRZE2sXdp1oZwUfg1sZvctK6tZ7r4kqP-KS8-A=s64-c-k-c0x00ffffff-no-rj", "message": " MAKE SOUND LIKE BR E E E E EE BR E E E E EE"}]
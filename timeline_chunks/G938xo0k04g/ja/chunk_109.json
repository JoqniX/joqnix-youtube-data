[{"type": "subtitle", "time": 6543.03, "timestamp": "01:49:03", "text": "君に知ってほしい、君は決して君を知らない"}, {"type": "subtitle", "time": 6546.39, "timestamp": "01:49:06", "text": "決してあなたを好きになるべきではないし、あなたをお気に入りにするべきでもない"}, {"type": "subtitle", "time": 6550.07, "timestamp": "01:49:10", "text": "彼らに平等なものを与え続けなければならないと分かっている"}, {"type": "subtitle", "time": 6553.229, "timestamp": "01:49:13", "text": "えっと、考えてみてください"}, {"type": "subtitle", "time": 6557.03, "timestamp": "01:49:17", "text": "私にはそれが大きな苦痛になったわけではない"}, {"type": "subtitle", "time": 6562.189, "timestamp": "01:49:22", "text": "なぜなら、配信でそれを祝い始めるからだ"}, {"type": "subtitle", "time": 6565.75, "timestamp": "01:49:25", "text": "それで、普通は他の何"}, {"type": "subtitle", "time": 6568.149, "timestamp": "01:49:28", "text": "ゲームやその他"}, {"type": "subtitle", "time": 6570.31, "timestamp": "01:49:30", "text": "ゲームキャラクターが"}, {"type": "subtitle", "time": 6573.43, "timestamp": "01:49:33", "text": "誕生日彼らがしていることはただ投稿することだけです"}, {"type": "subtitle", "time": 6577.669, "timestamp": "01:49:37", "text": "ストリーム配信をするのは正しいですか？"}, {"type": "subtitle", "time": 6581.99, "timestamp": "01:49:41", "text": "イベントや最新情報を配信する"}, {"type": "subtitle", "time": 6583.79, "timestamp": "01:49:43", "text": "など"}, {"type": "subtitle", "time": 6585.31, "timestamp": "01:49:45", "text": "右"}]
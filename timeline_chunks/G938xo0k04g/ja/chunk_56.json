[{"type": "subtitle", "time": 3363.349, "timestamp": "00:56:03", "text": "アップデート？そこは約束します。わかった。"}, {"type": "subtitle", "time": 3364.87, "timestamp": "00:56:04", "text": "アニメーショングループの設定がクリーンアップされます"}, {"type": "subtitle", "time": 3366.39, "timestamp": "00:56:06", "text": "少し上がった。それは見られません"}, {"type": "subtitle", "time": 3368.309, "timestamp": "00:56:08", "text": "あなたがそれを開けた瞬間から、私は"}, {"type": "subtitle", "time": 3370.549, "timestamp": "00:56:10", "text": "どの範囲のUIがより優れているかを説明しようとしています"}, {"type": "subtitle", "time": 3372.549, "timestamp": "00:56:12", "text": "アイコン付きで、ショー付きの方がさらに良いかも。"}, {"type": "subtitle", "time": 3375.91, "timestamp": "00:56:15", "text": "キーフレームUIは現在"}, {"type": "subtitle", "time": 3379.75, "timestamp": "00:56:19", "text": "同じUIですね。キーフレームを追加しているんですね。"}, {"type": "subtitle", "time": 3390.47, "timestamp": "00:56:30", "text": "フレーム フレームキーフレームを追加しています"}, {"type": "subtitle", "time": 3393.109, "timestamp": "00:56:33", "text": "ウェブスタジオのアニメーションについて"}, {"type": "subtitle", "time": 3395.99, "timestamp": "00:56:35", "text": "今ではクレイジーなアニメーションをたくさん作れる"}, {"type": "subtitle", "time": 3401.47, "timestamp": "00:56:41", "text": "ついに。"}, {"type": "subtitle", "time": 3404.43, "timestamp": "00:56:44", "text": "わーい。さあ"}, {"type": "subtitle", "time": 3407.51, "timestamp": "00:56:47", "text": "行く。あと、もう12時だ。食事に行かなきゃ。"}, {"type": "subtitle", "time": 3409.349, "timestamp": "00:56:49", "text": "休憩、朝食じゃないよ。私は"}, {"type": "subtitle", "time": 3411.87, "timestamp": "00:56:51", "text": "朝食。私は食べに行かなければならない"}, {"type": "subtitle", "time": 3414.309, "timestamp": "00:56:54", "text": "ランチ。うん。うん。うん。食事に行かなきゃ"}, {"type": "chat", "time": 3416.231, "timestamp": "00:56:56", "author": "@AerinViolet", "avatar": "https://yt4.ggpht.com/UKawanVvntNiAwz6RWv6wPk_S8YwApvPcCfLApO-du_RbQRIPGtzJ5FTt1DCNmZFJWc_2vxlqw=s64-c-k-c0x00ffffff-no-rj", "message": "afternoon joqUCkszU2WH9gy1mb0dV-11UJg/ssIfY7OFG5OykQOpn4CQCw"}]
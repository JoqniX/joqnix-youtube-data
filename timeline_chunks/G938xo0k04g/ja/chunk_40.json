[{"type": "subtitle", "time": 2402.75, "timestamp": "00:40:02", "text": "人々は、ハトが彼が"}, {"type": "subtitle", "time": 2405.87, "timestamp": "00:40:05", "text": "いいえ、彼らはこう言うでしょう"}, {"type": "subtitle", "time": 2409.349, "timestamp": "00:40:09", "text": "えっと、彼らは切り替えるようなものだと言っていました"}, {"type": "subtitle", "time": 2411.829, "timestamp": "00:40:11", "text": "シンガポールのサーバーを別のサーバーへ"}, {"type": "subtitle", "time": 2413.87, "timestamp": "00:40:13", "text": "あれこれと修理"}, {"type": "subtitle", "time": 2418.95, "timestamp": "00:40:18", "text": "そうだったので、Discordに追加しました。"}, {"type": "subtitle", "time": 2419.95, "timestamp": "00:40:19", "text": "それで、"}, {"type": "subtitle", "time": 2423.27, "timestamp": "00:40:23", "text": "ええ、そうですね、私はすでにやっているので"}, {"type": "subtitle", "time": 2428.23, "timestamp": "00:40:28", "text": "この24時間配信とその他すべて、"}, {"type": "subtitle", "time": 2436.31, "timestamp": "00:40:36", "text": "は。ええ、バッファリングが見られますね。私はできる"}, {"type": "subtitle", "time": 2438.75, "timestamp": "00:40:38", "text": "バッファリングを確認してください。それは"}, {"type": "subtitle", "time": 2449.03, "timestamp": "00:40:49", "text": "えっと、サーバーの問題だと思う。私"}, {"type": "subtitle", "time": 2451.03, "timestamp": "00:40:51", "text": "彼らが新しいものに取り組んでいるかどうかはわかりません"}, {"type": "subtitle", "time": 2453.19, "timestamp": "00:40:53", "text": "サーバーと、それを切り替えるのが好きなんです。私は"}, {"type": "subtitle", "time": 2455.67, "timestamp": "00:40:55", "text": "言われた、私は与える、私は得る、"}, {"type": "subtitle", "time": 2457.67, "timestamp": "00:40:57", "text": "ベータサーバー"}, {"type": "subtitle", "time": 2459.069, "timestamp": "00:40:59", "text": "えーとテストするために"}]
[{"type": "subtitle", "time": 16801.948, "timestamp": "04:40:01", "text": "作品。はい、それで大丈夫です。すべてのトリガー"}, {"type": "subtitle", "time": 16806.12, "timestamp": "04:40:06", "text": "押すと動きます。わかった。そうすれば"}, {"type": "subtitle", "time": 16819.91, "timestamp": "04:40:19", "text": "これ、よし、うまくいく。わかった。わかった。私"}, {"type": "subtitle", "time": 16823.54, "timestamp": "04:40:23", "text": "接続を間違えたのかもしれません。"}, {"type": "subtitle", "time": 16847.99, "timestamp": "04:40:47", "text": "これ。そのやり方の理由"}, {"type": "subtitle", "time": 16850.47, "timestamp": "04:40:50", "text": "下降は放出によるものです。もし私が"}]
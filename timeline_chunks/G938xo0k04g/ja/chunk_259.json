[{"type": "subtitle", "time": 15543.51, "timestamp": "04:19:03", "text": "なぜ私は結婚式の歌を歌っているのか"}, {"type": "subtitle", "time": 15567.349, "timestamp": "04:19:27", "text": "わかった。えっと、これは何ですか？冷たく突き落とす。私"}, {"type": "subtitle", "time": 15570.11, "timestamp": "04:19:30", "text": "これが私がすべきことだと思う"}, {"type": "subtitle", "time": 15572.95, "timestamp": "04:19:32", "text": "選ぶ。どの薬が何のためのものか忘れました"}]
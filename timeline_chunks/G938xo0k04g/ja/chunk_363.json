[{"type": "subtitle", "time": 21785.07, "timestamp": "06:03:05", "text": "発電機が本当に必要だ"}, {"type": "subtitle", "time": 21791.67, "timestamp": "06:03:11", "text": "燃料。実は、私は"}, {"type": "subtitle", "time": 21796.86, "timestamp": "06:03:16", "text": "彼らから商品を購入する。でも悲しいことに私は"}, {"type": "subtitle", "time": 21799.15, "timestamp": "06:03:19", "text": "[音楽]"}, {"type": "subtitle", "time": 21805.99, "timestamp": "06:03:25", "text": "壊してしまったので、アイテムはあまりありません"}, {"type": "subtitle", "time": 21807.74, "timestamp": "06:03:27", "text": "彼にあげなさい。"}, {"type": "subtitle", "time": 21814.548, "timestamp": "06:03:34", "text": "[音楽]"}, {"type": "subtitle", "time": 21817.27, "timestamp": "06:03:37", "text": "彼にアルコールを与えよう。それ"}, {"type": "subtitle", "time": 21818.91, "timestamp": "06:03:38", "text": "あまり効果はないだろう。"}, {"type": "subtitle", "time": 21824.91, "timestamp": "06:03:44", "text": "肉40個。いいえ。ラグロープです。"}, {"type": "subtitle", "time": 21839.59, "timestamp": "06:03:59", "text": "[音楽]"}]
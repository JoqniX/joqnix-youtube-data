[{"type": "subtitle", "time": 6120.07, "timestamp": "01:42:00", "text": "ニース。これは前回やったことです。えっと"}, {"type": "subtitle", "time": 6122.629, "timestamp": "01:42:02", "text": "今日は、"}, {"type": "subtitle", "time": 6125.99, "timestamp": "01:42:05", "text": "内側。そして、私たちは拡大していくでしょう"}, {"type": "subtitle", "time": 6128.39, "timestamp": "01:42:08", "text": "このエリア全体を別の"}, {"type": "subtitle", "time": 6131.55, "timestamp": "01:42:11", "text": "大きな床"}, {"type": "subtitle", "time": 6134.47, "timestamp": "01:42:14", "text": "あれ。そう、それが私のなりたい姿です"}, {"type": "subtitle", "time": 6137.03, "timestamp": "01:42:17", "text": "実行中。なぜ私はこのゲームをプレイしているのでしょうか"}, {"type": "subtitle", "time": 6141.109, "timestamp": "01:42:21", "text": "期待する？ええと、そうですね、"}, {"type": "subtitle", "time": 6145.109, "timestamp": "01:42:25", "text": "アルタンからの贈り物。これがシャベルです。私"}, {"type": "subtitle", "time": 6148.51, "timestamp": "01:42:28", "text": "これは、"}, {"type": "subtitle", "time": 6152.47, "timestamp": "01:42:32", "text": "アルサ。えっと、ハラスの家を爆破しちゃった。"}, {"type": "subtitle", "time": 6161.91, "timestamp": "01:42:41", "text": "はぁ？そして、あなたのキツネを連れて行った。何？はぁ？私は持っていた"}, {"type": "subtitle", "time": 6162.91, "timestamp": "01:42:42", "text": "1"}, {"type": "subtitle", "time": 6165.47, "timestamp": "01:42:45", "text": "キツネ。はい、そうしました。"}, {"type": "subtitle", "time": 6168.75, "timestamp": "01:42:48", "text": "何？ああ、"}]
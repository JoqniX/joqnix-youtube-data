[{"type": "subtitle", "time": 13980.07, "timestamp": "03:53:00", "text": "すべて。ああ、そうだったらいいのに"}, {"type": "subtitle", "time": 13984.51, "timestamp": "03:53:04", "text": "私専用の部屋はたった一つだけ。えっと"}, {"type": "subtitle", "time": 13989.95, "timestamp": "03:53:09", "text": "とにかく、えっと、私が言っていたように"}, {"type": "subtitle", "time": 13994.71, "timestamp": "03:53:14", "text": "ええ、たとえ私が自分の音楽に言ったとしても"}, {"type": "subtitle", "time": 13997.71, "timestamp": "03:53:17", "text": "YouTubeとかやってるインストラクター"}, {"type": "subtitle", "time": 14000.79, "timestamp": "03:53:20", "text": "そして最初は彼も驚いた"}, {"type": "subtitle", "time": 14003.15, "timestamp": "03:53:23", "text": "私たちが最初に会話したとき"}, {"type": "subtitle", "time": 14006.55, "timestamp": "03:53:26", "text": "Zoomでの会議のように"}, {"type": "subtitle", "time": 14008.91, "timestamp": "03:53:28", "text": "私が話していたのは、"}, {"type": "subtitle", "time": 14012.87, "timestamp": "03:53:32", "text": "音楽についての話と私が"}, {"type": "subtitle", "time": 14016.95, "timestamp": "03:53:36", "text": "始めたのですが、迷子になって希望も失ってしまいました"}, {"type": "subtitle", "time": 14019.11, "timestamp": "03:53:39", "text": "音楽ブロックとその他諸々のせいで"}, {"type": "subtitle", "time": 14023.11, "timestamp": "03:53:43", "text": "そして私はVTubingを始めました"}, {"type": "subtitle", "time": 14025.11, "timestamp": "03:53:45", "text": "音楽でベストを尽くしたい"}, {"type": "subtitle", "time": 14027.15, "timestamp": "03:53:47", "text": "そして私がしたいことは"}, {"type": "subtitle", "time": 14029.99, "timestamp": "03:53:49", "text": "音楽、音楽における私の目的と目標"}, {"type": "subtitle", "time": 14034.03, "timestamp": "03:53:54", "text": "JosとYouTuberとしての未来"}, {"type": "subtitle", "time": 14036.389, "timestamp": "03:53:56", "text": "すべて。彼はこう言った。「うわあ、そのやり方"}]
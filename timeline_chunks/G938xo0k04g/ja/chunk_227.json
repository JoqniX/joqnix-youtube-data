[{"type": "subtitle", "time": 13621.99, "timestamp": "03:47:01", "text": "幼稚園のような真ん中"}, {"type": "subtitle", "time": 13624.15, "timestamp": "03:47:04", "text": "音楽制作。わからない。しかしそれは"}, {"type": "subtitle", "time": 13626.11, "timestamp": "03:47:06", "text": "大丈夫。私は"}, {"type": "subtitle", "time": 13630.229, "timestamp": "03:47:10", "text": "初心者。重要なのは、私が時間を費やしたということだ"}, {"type": "subtitle", "time": 13632.269, "timestamp": "03:47:12", "text": "そして"}, {"type": "subtitle", "time": 13635.11, "timestamp": "03:47:15", "text": "宿題にするために努力する"}, {"type": "subtitle", "time": 13636.389, "timestamp": "03:47:16", "text": "今日。"}, {"type": "subtitle", "time": 13639.309, "timestamp": "03:47:19", "text": "そして私はそれを共有し、"}, {"type": "subtitle", "time": 13643.55, "timestamp": "03:47:23", "text": "今日の授業のフィードバックは5時30分または"}, {"type": "subtitle", "time": 13647.99, "timestamp": "03:47:27", "text": "5. 現在時刻は午後3時36分です。私は約"}, {"type": "subtitle", "time": 13655.349, "timestamp": "03:47:35", "text": "二。私はできると信じていますが、"}, {"type": "subtitle", "time": 13662.15, "timestamp": "03:47:42", "text": "立ち往生。私は以前にもこれをやったことがあります。それほどではない"}, {"type": "subtitle", "time": 13665.91, "timestamp": "03:47:45", "text": "ダークネックは別の別名として"}, {"type": "subtitle", "time": 13668.63, "timestamp": "03:47:48", "text": "別のチャンネル。以前にもやったことがある。"}, {"type": "subtitle", "time": 13671.99, "timestamp": "03:47:51", "text": "毎日Abletonを起動して"}, {"type": "subtitle", "time": 13675.91, "timestamp": "03:47:55", "text": "Ableton Liveで何かやってみる"}, {"type": "subtitle", "time": 13678.389, "timestamp": "03:47:58", "text": "Twitchチャンネルが配信するチャンネルで"}]
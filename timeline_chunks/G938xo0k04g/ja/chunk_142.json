[{"type": "subtitle", "time": 8527.59, "timestamp": "02:22:07", "text": "大丈夫。待って、これは一つずつ進んでいくんだ。"}, {"type": "subtitle", "time": 8529.67, "timestamp": "02:22:09", "text": "えっと、待って。"}, {"type": "subtitle", "time": 8532.429, "timestamp": "02:22:12", "text": "何か"}, {"type": "subtitle", "time": 8535.55, "timestamp": "02:22:15", "text": "考える。こっちの方がいいと思いませんか？バック"}, {"type": "subtitle", "time": 8538.99, "timestamp": "02:22:18", "text": "上。こうじゃないですか"}, {"type": "subtitle", "time": 8541.75, "timestamp": "02:22:21", "text": "より良い？製錬装置はどこにあるんですか？私"}, {"type": "subtitle", "time": 8544.03, "timestamp": "02:22:24", "text": "製錬所はないと思う。"}, {"type": "subtitle", "time": 8548.83, "timestamp": "02:22:28", "text": "右？あ、待って。これを料理する必要がある。おお"}, {"type": "subtitle", "time": 8551.75, "timestamp": "02:22:31", "text": "男。煙。ああ、神様。私は持っていません"}, {"type": "subtitle", "time": 8560.389, "timestamp": "02:22:40", "text": "と。ああ、彼はアイスバケツチャレンジをしたんだ。ニース。"}, {"type": "subtitle", "time": 8562.19, "timestamp": "02:22:42", "text": "私は"}, {"type": "subtitle", "time": 8564.67, "timestamp": "02:22:44", "text": "来るよ。手遅れだった"}, {"type": "subtitle", "time": 8567.99, "timestamp": "02:22:47", "text": "それを買って、"}]
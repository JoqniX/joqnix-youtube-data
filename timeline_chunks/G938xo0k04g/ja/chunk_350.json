[{"type": "subtitle", "time": 21010.628, "timestamp": "05:50:10", "text": "ああ、そうだね。私はそのキノコを食べられます。私"}, {"type": "subtitle", "time": 21012.54, "timestamp": "05:50:12", "text": "持っていません"}, {"type": "subtitle", "time": 21015.23, "timestamp": "05:50:15", "text": "[音楽]"}, {"type": "subtitle", "time": 21034.948, "timestamp": "05:50:34", "text": "効率的。私はそれが私を癒してくれると思った、"}, {"type": "subtitle", "time": 21045.628, "timestamp": "05:50:45", "text": "[音楽]"}, {"type": "subtitle", "time": 21055.788, "timestamp": "05:50:55", "text": "痛み。"}, {"type": "subtitle", "time": 21057.628, "timestamp": "05:50:57", "text": "待って、"}, {"type": "subtitle", "time": 21059.99, "timestamp": "05:50:59", "text": "待って。私は実際に何か"}]
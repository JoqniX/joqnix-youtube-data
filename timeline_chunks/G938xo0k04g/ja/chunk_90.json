[{"type": "subtitle", "time": 5408.07, "timestamp": "01:30:08", "text": "えーっと、みんなが学べるようにプレゼント企画"}, {"type": "subtitle", "time": 5410.31, "timestamp": "01:30:10", "text": "倫理観とかそういうことについて。私"}, {"type": "subtitle", "time": 5411.629, "timestamp": "01:30:11", "text": "続けると思う"}, {"type": "subtitle", "time": 5416.189, "timestamp": "01:30:16", "text": "旧V2エチケットへのリンク"}, {"type": "subtitle", "time": 5419.87, "timestamp": "01:30:19", "text": "クリッパーと"}, {"type": "subtitle", "time": 5423.51, "timestamp": "01:30:23", "text": "もの。また、それはまた、"}, {"type": "subtitle", "time": 5425.43, "timestamp": "01:30:25", "text": "のように"}, {"type": "subtitle", "time": 5427.39, "timestamp": "01:30:27", "text": "えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 5432.91, "timestamp": "01:30:32", "text": "良い？"}, {"type": "subtitle", "time": 5434.669, "timestamp": "01:30:34", "text": "[音楽]"}, {"type": "subtitle", "time": 5440.07, "timestamp": "01:30:40", "text": "ああ、これは本当にその通りだ。これを見てください。"}, {"type": "subtitle", "time": 5442.47, "timestamp": "01:30:42", "text": "8年前は競争相手が少なかった。"}, {"type": "subtitle", "time": 5444.149, "timestamp": "01:30:44", "text": "それをやっている人は少なかったので"}, {"type": "subtitle", "time": 5446.629, "timestamp": "01:30:46", "text": "目立つのは簡単だが、それはまた、"}, {"type": "subtitle", "time": 5449.11, "timestamp": "01:30:49", "text": "高額な投資。 3Dモデリングと"}, {"type": "subtitle", "time": 5451.31, "timestamp": "01:30:51", "text": "顔面車は新しかったので"}, {"type": "subtitle", "time": 5454.39, "timestamp": "01:30:54", "text": "今日ではより多様で高価"}, {"type": "subtitle", "time": 5455.75, "timestamp": "01:30:55", "text": "技術の進歩。たくさんあります"}, {"type": "subtitle", "time": 5458.55, "timestamp": "01:30:58", "text": "手頃な価格で利用できる多くの機会。"}]
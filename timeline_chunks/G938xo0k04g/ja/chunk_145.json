[{"type": "subtitle", "time": 8704.51, "timestamp": "02:25:04", "text": "ああ、それは"}, {"type": "subtitle", "time": 8707.91, "timestamp": "02:25:07", "text": "1つ。もう一度やってみよう。私は"}, {"type": "subtitle", "time": 8709.79, "timestamp": "02:25:09", "text": "3戦2勝制。"}, {"type": "subtitle", "time": 8730.23, "timestamp": "02:25:30", "text": "ああ、なんてことだ。私はまるで"}, {"type": "subtitle", "time": 8732.15, "timestamp": "02:25:32", "text": "混乱した。待って、左クリックするべきか、それとも"}, {"type": "subtitle", "time": 8733.63, "timestamp": "02:25:33", "text": "右"}, {"type": "subtitle", "time": 8736.23, "timestamp": "02:25:36", "text": "クリック？私は「待って、私は去るべきだろうか」と思った。"}, {"type": "subtitle", "time": 8737.99, "timestamp": "02:25:37", "text": "クリックか右クリックか？そして私は感じた"}, {"type": "subtitle", "time": 8740.55, "timestamp": "02:25:40", "text": "あ、待って、右クリックだ。待って、"}, {"type": "subtitle", "time": 8741.71, "timestamp": "02:25:41", "text": "は"}, {"type": "subtitle", "time": 8744.15, "timestamp": "02:25:44", "text": "それ？ええ、右クリックです。うん。"}, {"type": "subtitle", "time": 8745.99, "timestamp": "02:25:45", "text": "うん。うん。うん、そう。うん。私は"}, {"type": "subtitle", "time": 8752.99, "timestamp": "02:25:52", "text": "想像する。ああ、"}]
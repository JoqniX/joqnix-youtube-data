[{"type": "subtitle", "time": 14221.75, "timestamp": "03:57:01", "text": "3時くらいまで、5時までならやります"}, {"type": "subtitle", "time": 14224.55, "timestamp": "03:57:04", "text": "5時まで配信します。"}, {"type": "subtitle", "time": 14226.71, "timestamp": "03:57:06", "text": "授業は開催されます。私も出席します。"}, {"type": "subtitle", "time": 14229.349, "timestamp": "03:57:09", "text": "それは2時間の音楽の授業になります"}, {"type": "subtitle", "time": 14232.87, "timestamp": "03:57:12", "text": "その後授業があるので、7時までには戻ります。"}, {"type": "subtitle", "time": 14236.229, "timestamp": "03:57:16", "text": "7時以降、夕食後7時半に戻ります"}, {"type": "subtitle", "time": 14240.07, "timestamp": "03:57:20", "text": "10時までここにいるよ、それから2番目。"}, {"type": "subtitle", "time": 14242.11, "timestamp": "03:57:22", "text": "ストリーム配信はYouTubeで行われます"}, {"type": "subtitle", "time": 14245.269, "timestamp": "03:57:25", "text": "twitchpite はまだ進行中です"}, {"type": "subtitle", "time": 14248.15, "timestamp": "03:57:28", "text": "そして、10時過ぎには、私はただ"}, {"type": "subtitle", "time": 14251.469, "timestamp": "03:57:31", "text": "早く寝るよ、だって直さなきゃいけないことがあるから"}, {"type": "subtitle", "time": 14254.71, "timestamp": "03:57:34", "text": "スケジュール。つまり、Wが出場するということだ。私はあなた"}, {"type": "subtitle", "time": 14258.95, "timestamp": "03:57:38", "text": "私がライブ配信しているのを見るかもしれません"}, {"type": "subtitle", "time": 14261.269, "timestamp": "03:57:41", "text": "いろいろあるけど、Wは来るよ。目が覚めたとき"}, {"type": "subtitle", "time": 14263.229, "timestamp": "03:57:43", "text": "起きて、また配信に戻ってきます"}, {"type": "subtitle", "time": 14266.229, "timestamp": "03:57:46", "text": "すべて。実際に確認します"}, {"type": "subtitle", "time": 14269.11, "timestamp": "03:57:49", "text": "チャットか何かに載せよう"}, {"type": "subtitle", "time": 14271.389, "timestamp": "03:57:51", "text": "自動で自動化されているので、私は"}, {"type": "subtitle", "time": 14279.75, "timestamp": "03:57:59", "text": "H、その設定方法を理解する必要がある。病気"}]
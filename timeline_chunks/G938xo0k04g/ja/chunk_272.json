[{"type": "subtitle", "time": 16321.429, "timestamp": "04:32:01", "text": "だから、今日は音響設計が必要なのです。いいえ"}, {"type": "subtitle", "time": 16326.349, "timestamp": "04:32:06", "text": "あなたがこれを開ける時、これを持ってきてください"}, {"type": "subtitle", "time": 16329.07, "timestamp": "04:32:09", "text": "上。わかった。"}, {"type": "subtitle", "time": 16332.63, "timestamp": "04:32:12", "text": "高周波の倍音は"}, {"type": "subtitle", "time": 16340.59, "timestamp": "04:32:20", "text": "各種。ああ、間違えた。えーと、1つ"}, {"type": "subtitle", "time": 16353.03, "timestamp": "04:32:33", "text": "待って、それはなぜ"}, {"type": "subtitle", "time": 16354.349, "timestamp": "04:32:34", "text": "の"}, {"type": "subtitle", "time": 16358.189, "timestamp": "04:32:38", "text": "ドラム？無効にさせてください"}, {"type": "subtitle", "time": 16369.11, "timestamp": "04:32:49", "text": "何だって？何？わかった。待って。コントロール"}, {"type": "subtitle", "time": 16369.65, "timestamp": "04:32:49", "text": "シフト"}, {"type": "subtitle", "time": 16371.309, "timestamp": "04:32:51", "text": "[音楽]"}]
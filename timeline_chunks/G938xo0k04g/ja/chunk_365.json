[{"type": "subtitle", "time": 21900.32, "timestamp": "06:05:00", "text": "何が起こるだろうか。"}, {"type": "subtitle", "time": 21901.948, "timestamp": "06:05:01", "text": "[音楽]"}, {"type": "subtitle", "time": 21904.08, "timestamp": "06:05:04", "text": "見てください、私は頼みます"}, {"type": "subtitle", "time": 21915.47, "timestamp": "06:05:15", "text": "これ。いや、いや、いや、"}, {"type": "subtitle", "time": 21918.83, "timestamp": "06:05:18", "text": "待って。それも良くない考えだ。"}, {"type": "subtitle", "time": 21935.51, "timestamp": "06:05:35", "text": "いいえ。彼は首を横に振った。いいえ。ええ。うん。"}, {"type": "subtitle", "time": 21943.548, "timestamp": "06:05:43", "text": "うるさい。だから私たちは2つを過ぎました"}, {"type": "subtitle", "time": 21945.708, "timestamp": "06:05:45", "text": "日"}, {"type": "subtitle", "time": 21949.788, "timestamp": "06:05:49", "text": "今。車はどこですか？"}, {"type": "subtitle", "time": 21953.83, "timestamp": "06:05:53", "text": "良い。それでは、ここで締めくくりたいと思います。"}, {"type": "subtitle", "time": 21954.26, "timestamp": "06:05:54", "text": "のために"}, {"type": "subtitle", "time": 21955.788, "timestamp": "06:05:55", "text": "[音楽]"}, {"type": "subtitle", "time": 21958.708, "timestamp": "06:05:58", "text": "今。とりあえず、こちらはこれで終わりにします。"}]
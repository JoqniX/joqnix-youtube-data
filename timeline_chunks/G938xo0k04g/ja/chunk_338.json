[{"type": "subtitle", "time": 20290.23, "timestamp": "05:38:10", "text": "よし、それを手に入れよう。それはIAです。うん。"}, {"type": "subtitle", "time": 20295.07, "timestamp": "05:38:15", "text": "こんにちは、あなた。元気ですか？それは"}, {"type": "subtitle", "time": 20299.75, "timestamp": "05:38:19", "text": "その間。お元気でお過ごしでしょうか。うん。"}, {"type": "subtitle", "time": 20303.03, "timestamp": "05:38:23", "text": "そうするべきだと思う。でも待って、これは"}, {"type": "subtitle", "time": 20304.67, "timestamp": "05:38:24", "text": "ゲームには背景があります"}, {"type": "subtitle", "time": 20307.11, "timestamp": "05:38:27", "text": "音楽？まあ、そうでもないよね？だから、"}, {"type": "subtitle", "time": 20308.59, "timestamp": "05:38:28", "text": "ある種の音"}, {"type": "subtitle", "time": 20312.868, "timestamp": "05:38:32", "text": "あー、ちょっとだけオンにするね"}, {"type": "subtitle", "time": 20314.67, "timestamp": "05:38:34", "text": "スライドショー用の音楽。"}, {"type": "subtitle", "time": 20317.628, "timestamp": "05:38:37", "text": "はい、大丈夫です。"}, {"type": "subtitle", "time": 20321.35, "timestamp": "05:38:41", "text": "推測。私は大丈夫です。ただ休んでいるだけです。ああ、よかった。"}, {"type": "subtitle", "time": 20323.39, "timestamp": "05:38:43", "text": "良い。ゆっくり休んでください"}, {"type": "subtitle", "time": 20331.75, "timestamp": "05:38:51", "text": "ええと、地下のアンダーラン。何だったか忘れた"}]
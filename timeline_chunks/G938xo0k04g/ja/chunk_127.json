[{"type": "subtitle", "time": 7622.99, "timestamp": "02:07:02", "text": "ああ。ああ、大変だ。"}, {"type": "subtitle", "time": 7626.229, "timestamp": "02:07:06", "text": "おお。それはすごくクールだね。ニース。ニース。したい"}, {"type": "subtitle", "time": 7628.35, "timestamp": "02:07:08", "text": "1対1？"}, {"type": "subtitle", "time": 7637.91, "timestamp": "02:07:17", "text": "もちろん。ボクシングリングに行こう。待って、"}, {"type": "subtitle", "time": 7647.229, "timestamp": "02:07:27", "text": "これがボクシングだ"}, {"type": "subtitle", "time": 7650.03, "timestamp": "02:07:30", "text": "指輪。あなた"}, {"type": "subtitle", "time": 7657.43, "timestamp": "02:07:37", "text": "ここ。なぜこんなに疲れているのだろう？私が"}, {"type": "subtitle", "time": 7666.47, "timestamp": "02:07:46", "text": "ない？私は素手で彼と戦うつもりだ"}]
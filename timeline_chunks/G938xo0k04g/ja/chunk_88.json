[{"type": "subtitle", "time": 5281.07, "timestamp": "01:28:01", "text": "彼ら。これはとても"}, {"type": "subtitle", "time": 5283.31, "timestamp": "01:28:03", "text": "良い。これはとても"}, {"type": "subtitle", "time": 5291.87, "timestamp": "01:28:11", "text": "良い。たくさんのものがあって"}, {"type": "subtitle", "time": 5309.63, "timestamp": "01:28:29", "text": "リストを提供する"}, {"type": "subtitle", "time": 5311.47, "timestamp": "01:28:31", "text": "[音楽]"}, {"type": "subtitle", "time": 5319.669, "timestamp": "01:28:39", "text": "みんな。男の人がたくさんいる。うん。"}, {"type": "subtitle", "time": 5321.99, "timestamp": "01:28:41", "text": "爆弾を仕掛けるようなものをブランディングする"}, {"type": "subtitle", "time": 5324.79, "timestamp": "01:28:44", "text": "休む。はい。本当に心から"}]
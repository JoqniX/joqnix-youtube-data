[{"type": "subtitle", "time": 11042.59, "timestamp": "03:04:02", "text": "もの。ええ、他のものも追加します。"}, {"type": "subtitle", "time": 11046.87, "timestamp": "03:04:06", "text": "それで、今日はどうしてこんなに疲れているんだろう？私"}, {"type": "subtitle", "time": 11047.63, "timestamp": "03:04:07", "text": "しないで"}, {"type": "subtitle", "time": 11052.67, "timestamp": "03:04:12", "text": "知る。したいけどできない"}, {"type": "subtitle", "time": 11062.309, "timestamp": "03:04:22", "text": "明日。ストラップを装着する必要がある"}, {"type": "subtitle", "time": 11070.67, "timestamp": "03:04:30", "text": "理由。ライト"}, {"type": "subtitle", "time": 11074.389, "timestamp": "03:04:34", "text": "照らす。ここでの私の目標は何ですか？何"}, {"type": "subtitle", "time": 11076.389, "timestamp": "03:04:36", "text": "私は何をしているのだろうか？"}, {"type": "subtitle", "time": 11079.389, "timestamp": "03:04:39", "text": "なぜ私は壁を持ってきて建てたのか"}, {"type": "subtitle", "time": 11085.309, "timestamp": "03:04:45", "text": "火？なぜ私の理想はあなたに言ったのか"}, {"type": "subtitle", "time": 11091.51, "timestamp": "03:04:51", "text": "ペイント？タブレットを取りに行くよ。病気"}]
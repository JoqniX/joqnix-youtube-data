[{"type": "subtitle", "time": 2582.79, "timestamp": "00:43:02", "text": "亡くなった。あなたの個性をツイートしよう。どうすればいいですか"}, {"type": "subtitle", "time": 2585.829, "timestamp": "00:43:05", "text": "私の幽霊をツイートする？私はたくさん寝た"}, {"type": "subtitle", "time": 2592.63, "timestamp": "00:43:12", "text": "私は今日、主を愛しました。私はしたくない"}, {"type": "subtitle", "time": 2603.76, "timestamp": "00:43:23", "text": "多くの。うん。"}, {"type": "subtitle", "time": 2623.47, "timestamp": "00:43:43", "text": "私が連絡を取った相手"}, {"type": "subtitle", "time": 2626.91, "timestamp": "00:43:46", "text": "コラボレーションのために"}, {"type": "subtitle", "time": 2629.27, "timestamp": "00:43:49", "text": "JPBT、彼女は指揮している"}, {"type": "subtitle", "time": 2631.829, "timestamp": "00:43:51", "text": "トーナメント、カスタムApexトーナメント、または"}, {"type": "subtitle", "time": 2633.91, "timestamp": "00:43:53", "text": "何か、または遊ぶのが楽しいような"}]
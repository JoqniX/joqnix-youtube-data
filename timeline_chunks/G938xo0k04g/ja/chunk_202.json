[{"type": "subtitle", "time": 12120.87, "timestamp": "03:22:00", "text": "建てる？わからない。それでは"}, {"type": "subtitle", "time": 12123.99, "timestamp": "03:22:03", "text": "流れ、かな。私たちは"}, {"type": "subtitle", "time": 12126.19, "timestamp": "03:22:06", "text": "ええと、流れに身を任せましょう。"}, {"type": "subtitle", "time": 12129.269, "timestamp": "03:22:09", "text": "こんにちは。私の鉄の斧のように。いつ"}, {"type": "subtitle", "time": 12134.23, "timestamp": "03:22:14", "text": "何？"}, {"type": "subtitle", "time": 12138.429, "timestamp": "03:22:18", "text": "[音楽]"}, {"type": "subtitle", "time": 12140.75, "timestamp": "03:22:20", "text": "H. ああ、彼は"}, {"type": "subtitle", "time": 12142.83, "timestamp": "03:22:22", "text": "禁止解除。"}, {"type": "subtitle", "time": 12149.55, "timestamp": "03:22:29", "text": "戻る。"}, {"type": "subtitle", "time": 12154.11, "timestamp": "03:22:34", "text": "でも必ず"}, {"type": "subtitle", "time": 12178.03, "timestamp": "03:22:58", "text": "ペットなので真似してみます"}]
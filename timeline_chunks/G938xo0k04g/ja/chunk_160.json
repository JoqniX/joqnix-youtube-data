[{"type": "subtitle", "time": 9604.23, "timestamp": "02:40:04", "text": "こんにちは、ジョー。待って、私の配信へようこ​​そ。"}, {"type": "subtitle", "time": 9606.19, "timestamp": "02:40:06", "text": "良い一日をお過ごしください"}, {"type": "subtitle", "time": 9629.349, "timestamp": "02:40:29", "text": "良い。こんにちは、アラさん。配信へようこ​​そ。"}, {"type": "subtitle", "time": 9631.19, "timestamp": "02:40:31", "text": "私は実際に変更しようと考えていました"}, {"type": "subtitle", "time": 9633.469, "timestamp": "02:40:33", "text": "Onexiaからの挨拶"}, {"type": "subtitle", "time": 9635.99, "timestamp": "02:40:35", "text": "ヘルパー。私は実際に考えていました"}, {"type": "subtitle", "time": 9638.15, "timestamp": "02:40:38", "text": "実際にOnxヘルパーの名前を変更する"}, {"type": "subtitle", "time": 9641.83, "timestamp": "02:40:41", "text": "他のことにも。コンサートプレートまたは"}, {"type": "subtitle", "time": 9643.23, "timestamp": "02:40:43", "text": "何か"}, {"type": "subtitle", "time": 9647.19, "timestamp": "02:40:47", "text": "コンステラ。いいえ、あなたたちは何か"}, {"type": "subtitle", "time": 9650.91, "timestamp": "02:40:50", "text": "会議の名前の提案"}, {"type": "subtitle", "time": 9653.55, "timestamp": "02:40:53", "text": "星座について教えてください。"}]
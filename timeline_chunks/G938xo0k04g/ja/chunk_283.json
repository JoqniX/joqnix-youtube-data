[{"type": "subtitle", "time": 16989.07, "timestamp": "04:43:09", "text": "全て。えっと、ここで何かやってみましょう。"}, {"type": "subtitle", "time": 17009.628, "timestamp": "04:43:29", "text": "[音楽]"}, {"type": "subtitle", "time": 17018.948, "timestamp": "04:43:38", "text": "これ。あなたはつまみを摘んでいる。私たちは何を"}, {"type": "subtitle", "time": 17022.67, "timestamp": "04:43:42", "text": "基準値のようなものを作る必要がある、"}, {"type": "subtitle", "time": 17026.23, "timestamp": "04:43:46", "text": "右？ベースは忘れる必要がある"}, {"type": "subtitle", "time": 17035.19, "timestamp": "04:43:55", "text": "初め。ポリゴンを変更して"}, {"type": "subtitle", "time": 17038.05, "timestamp": "04:43:58", "text": "8歳までの声。"}]
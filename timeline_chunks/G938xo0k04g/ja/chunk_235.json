[{"type": "subtitle", "time": 14101.389, "timestamp": "03:55:01", "text": "明らかにそれを記録するために"}, {"type": "subtitle", "time": 14105.11, "timestamp": "03:55:05", "text": "今。まるで、"}, {"type": "subtitle", "time": 14108.389, "timestamp": "03:55:08", "text": "5分か2分くらい"}, {"type": "subtitle", "time": 14110.87, "timestamp": "03:55:10", "text": "1分間のクリップですよね？期間によります"}, {"type": "subtitle", "time": 14113.189, "timestamp": "03:55:13", "text": "私が曲を作ります。さらに、私は"}, {"type": "subtitle", "time": 14115.51, "timestamp": "03:55:15", "text": "私が使っている音、"}, {"type": "subtitle", "time": 14117.51, "timestamp": "03:55:17", "text": "プロセスはすべてでした。そして私は"}, {"type": "subtitle", "time": 14119.03, "timestamp": "03:55:19", "text": "母から電話がかかってきた。 1つ"}]
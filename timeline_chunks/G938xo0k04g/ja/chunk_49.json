[{"type": "subtitle", "time": 2940.03, "timestamp": "00:49:00", "text": "ただ働きたいだけ"}, {"type": "subtitle", "time": 2944.309, "timestamp": "00:49:04", "text": "素早く考えるか、みんな、それが私の"}, {"type": "subtitle", "time": 2945.75, "timestamp": "00:49:05", "text": "夢が叶った。私は手に入れたくない"}, {"type": "subtitle", "time": 2949.03, "timestamp": "00:49:09", "text": "聖なるものになりたい、あるいは働きたい"}]
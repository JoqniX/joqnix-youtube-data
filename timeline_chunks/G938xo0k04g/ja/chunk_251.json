[{"type": "subtitle", "time": 15062.79, "timestamp": "04:11:02", "text": "つまり、私はビリー・ビリーのストリームをやったことがある"}, {"type": "subtitle", "time": 15065.79, "timestamp": "04:11:05", "text": "以前は複数のストリームがありましたが、"}, {"type": "subtitle", "time": 15068.87, "timestamp": "04:11:08", "text": "右？しかし、問題は彼らが"}, {"type": "subtitle", "time": 15071.349, "timestamp": "04:11:11", "text": "私からのリクエストは限定配信です"}, {"type": "subtitle", "time": 15078.03, "timestamp": "04:11:18", "text": "ストリーム。ええ、彼らは独占権を求めているんです"}, {"type": "subtitle", "time": 15081.91, "timestamp": "04:11:21", "text": "そこで、私もそれをしたいです"}, {"type": "subtitle", "time": 15083.51, "timestamp": "04:11:23", "text": "未来。"}, {"type": "subtitle", "time": 15086.229, "timestamp": "04:11:26", "text": "だから、やらない方がいいと思ったんです"}, {"type": "subtitle", "time": 15089.349, "timestamp": "04:11:29", "text": "とりあえず、ジョアソンとビリービリーを入れておきましょう。"}, {"type": "subtitle", "time": 15091.83, "timestamp": "04:11:31", "text": "たとえ私ができたとしても、"}, {"type": "subtitle", "time": 15095.79, "timestamp": "04:11:35", "text": "私は本当に"}, {"type": "subtitle", "time": 15099.59, "timestamp": "04:11:39", "text": "たくさんありますよね？そして実際にそれを使って"}, {"type": "subtitle", "time": 15106.269, "timestamp": "04:11:46", "text": "すべて。私は感じた"}, {"type": "subtitle", "time": 15111.03, "timestamp": "04:11:51", "text": "うん、私はたぶん"}, {"type": "subtitle", "time": 15114.309, "timestamp": "04:11:54", "text": "私は今からストリーミング配信します。"}]
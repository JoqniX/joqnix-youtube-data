[{"type": "subtitle", "time": 13861.99, "timestamp": "03:51:01", "text": "改善すべき点など、すべて教えてもらった。"}, {"type": "subtitle", "time": 13865.03, "timestamp": "03:51:05", "text": "より良いアイデアにするにはどうすればいいでしょうか"}, {"type": "subtitle", "time": 13867.55, "timestamp": "03:51:07", "text": "曲のキーをもっと良くして詰め込み、"}, {"type": "subtitle", "time": 13871.11, "timestamp": "03:51:11", "text": "それら全て。うん。だから"}, {"type": "subtitle", "time": 13874.63, "timestamp": "03:51:14", "text": "少なくとも私は今、進歩と努力を示している"}, {"type": "subtitle", "time": 13876.79, "timestamp": "03:51:16", "text": "日本語の授業とかそういうのに"}, {"type": "subtitle", "time": 13878.95, "timestamp": "03:51:18", "text": "私が授業を受けている間"}, {"type": "subtitle", "time": 13881.349, "timestamp": "03:51:21", "text": "3か月間ストリーミング配信し、"}, {"type": "subtitle", "time": 13883.11, "timestamp": "03:51:23", "text": "すべて。"}, {"type": "subtitle", "time": 13885.229, "timestamp": "03:51:25", "text": "それで、私が"}, {"type": "subtitle", "time": 13888.07, "timestamp": "03:51:28", "text": "クラスでは、センサーが"}, {"type": "subtitle", "time": 13890.469, "timestamp": "03:51:30", "text": "私はドットチューブをやっていて、YouTubeとかやってます。"}, {"type": "subtitle", "time": 13893.75, "timestamp": "03:51:33", "text": "彼も私を品定めしていた。さらに彼は"}, {"type": "subtitle", "time": 13896.95, "timestamp": "03:51:36", "text": "チャットでやったことに気付いた"}, {"type": "subtitle", "time": 13900.07, "timestamp": "03:51:40", "text": "あれ、日本語の"}, {"type": "subtitle", "time": 13901.99, "timestamp": "03:51:41", "text": "英語と日本語の交換"}, {"type": "subtitle", "time": 13904.309, "timestamp": "03:51:44", "text": "毎週土曜日に交換会を開催しています。見逃した"}, {"type": "subtitle", "time": 13906.189, "timestamp": "03:51:46", "text": "今週と先週"}, {"type": "subtitle", "time": 13909.229, "timestamp": "03:51:49", "text": "週だけど、うん、"}, {"type": "subtitle", "time": 13913.269, "timestamp": "03:51:53", "text": "えっと、その2人については、その時彼はまた"}, {"type": "subtitle", "time": 13915.59, "timestamp": "03:51:55", "text": "自分が今、実際に努力していることに気づいた"}]
[{"type": "subtitle", "time": 12484.03, "timestamp": "03:28:04", "text": "主。えっと、何か考えないと"}, {"type": "subtitle", "time": 12487.51, "timestamp": "03:28:07", "text": "それ以外。えっと、何個か待ってください。"}, {"type": "subtitle", "time": 12489.67, "timestamp": "03:28:09", "text": "待って。残された時間はほんの数分だった。私"}, {"type": "subtitle", "time": 12492.429, "timestamp": "03:28:12", "text": "まとめが必要だ"}, {"type": "subtitle", "time": 12499.429, "timestamp": "03:28:19", "text": "ああ、何をすべきか見せないでください。"}, {"type": "subtitle", "time": 12504.349, "timestamp": "03:28:24", "text": "何をするか？何をするか？アイデア。アイデア。"}, {"type": "subtitle", "time": 12509.51, "timestamp": "03:28:29", "text": "アイデア。ふむ。ああ、今の見た？それ"}, {"type": "subtitle", "time": 12512.67, "timestamp": "03:28:32", "text": "姿を消した。"}, {"type": "subtitle", "time": 12514.67, "timestamp": "03:28:34", "text": "どうやって？おお。"}, {"type": "subtitle", "time": 12517.19, "timestamp": "03:28:37", "text": "わかった。アイデア。"}, {"type": "subtitle", "time": 12520.07, "timestamp": "03:28:40", "text": "だから、私の考えはチューニングをしないことだった"}, {"type": "subtitle", "time": 12523.11, "timestamp": "03:28:43", "text": "このようにフォークしてください。いいえ、私は言えます"}, {"type": "subtitle", "time": 12524.79, "timestamp": "03:28:44", "text": "人々はこう思うかもしれない。「ああ、待って。それは"}, {"type": "subtitle", "time": 12527.15, "timestamp": "03:28:47", "text": "音叉、"}, {"type": "subtitle", "time": 12529.59, "timestamp": "03:28:49", "text": "ジョッキー？音叉みたいですね。"}, {"type": "subtitle", "time": 12532.75, "timestamp": "03:28:52", "text": "はぁ？それは音叉ではありません。"}, {"type": "subtitle", "time": 12535.07, "timestamp": "03:28:55", "text": "よし、それで"}, {"type": "subtitle", "time": 12538.95, "timestamp": "03:28:58", "text": "えっと、音叉を作ってみたらどうだろう？"}]
[{"type": "subtitle", "time": 3864.75, "timestamp": "01:04:24", "text": "あなたはどの画面を使っているのですか？私は"}, {"type": "subtitle", "time": 3872.789, "timestamp": "01:04:32", "text": "えっと、今は51歳ですが"}, {"type": "subtitle", "time": 3875.19, "timestamp": "01:04:35", "text": "左中央にモニターが1台あります"}, {"type": "subtitle", "time": 3877.87, "timestamp": "01:04:37", "text": "モニターと右側のモニター"}, {"type": "subtitle", "time": 3882.51, "timestamp": "01:04:42", "text": "右。デュアルPCが恋しい"}, {"type": "subtitle", "time": 3885.43, "timestamp": "01:04:45", "text": "設定。正直、私は"}, {"type": "subtitle", "time": 3887.15, "timestamp": "01:04:47", "text": "6台のモニター"}, {"type": "subtitle", "time": 3890.95, "timestamp": "01:04:50", "text": "設定はできたけど、できなかった。 4番はどこ？"}, {"type": "subtitle", "time": 3892.71, "timestamp": "01:04:52", "text": "モニターの設定は？ 4台のモニターはありません"}, {"type": "subtitle", "time": 3893.789, "timestamp": "01:04:53", "text": "ここ。"}, {"type": "subtitle", "time": 3897.029, "timestamp": "01:04:57", "text": "何？でも、私は、それではどうすればいいんだろうと思った"}, {"type": "subtitle", "time": 3899.589, "timestamp": "01:04:59", "text": "日本での出来事が起こった。だから私はこう思った、"}]
[{"type": "subtitle", "time": 8953.83, "timestamp": "02:29:13", "text": "もの。 S"}, {"type": "subtitle", "time": 8955.95, "timestamp": "02:29:15", "text": "えーと、私たちは"}, {"type": "subtitle", "time": 8959.349, "timestamp": "02:29:19", "text": "木材。私はこれを破壊したくない。それで、"}, {"type": "subtitle", "time": 8968.67, "timestamp": "02:29:28", "text": "聖なる主へ。あれは洞窟の穴だ。おお。"}, {"type": "subtitle", "time": 8971.95, "timestamp": "02:29:31", "text": "そこで死ぬことを想像してみて。おお"}, {"type": "subtitle", "time": 8975.75, "timestamp": "02:29:35", "text": "主。ボートを作ってから、"}, {"type": "subtitle", "time": 8978.19, "timestamp": "02:29:38", "text": "彼が私にさせたかったこと"}, {"type": "subtitle", "time": 8981.51, "timestamp": "02:29:41", "text": "する。私はただこれをやっているのが好きです"}, {"type": "subtitle", "time": 8998.429, "timestamp": "02:29:58", "text": "待って、あなたは"}]
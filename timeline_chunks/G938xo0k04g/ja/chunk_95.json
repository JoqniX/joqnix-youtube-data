[{"type": "subtitle", "time": 5701.31, "timestamp": "01:35:01", "text": "[音楽]"}, {"type": "subtitle", "time": 5704.95, "timestamp": "01:35:04", "text": "えーっと、とにかく、えーっと、ボードゲームを楽しんでください。"}, {"type": "subtitle", "time": 5706.99, "timestamp": "01:35:06", "text": "私は戻ってきます。"}, {"type": "subtitle", "time": 5726.709, "timestamp": "01:35:26", "text": "こんにちは。よし、それは"}, {"type": "subtitle", "time": 5727.94, "timestamp": "01:35:27", "text": "始まり。"}, {"type": "subtitle", "time": 5744.07, "timestamp": "01:35:44", "text": "[音楽]"}, {"type": "subtitle", "time": 5747.03, "timestamp": "01:35:47", "text": "皆さん、楽しんでいらっしゃいますか？"}, {"type": "subtitle", "time": 5748.59, "timestamp": "01:35:48", "text": "私は"}, {"type": "subtitle", "time": 5752.79, "timestamp": "01:35:52", "text": "戻る。私はカワに慣れすぎている。そうそう。"}, {"type": "subtitle", "time": 5753.55, "timestamp": "01:35:53", "text": "しかし"}, {"type": "subtitle", "time": 5755.47, "timestamp": "01:35:55", "text": "うん、"}]
[{"type": "subtitle", "time": 22082.11, "timestamp": "06:08:02", "text": "時間。そう、午前11時か"}, {"type": "subtitle", "time": 22085.75, "timestamp": "06:08:05", "text": "来る、そしてその時間の変換"}, {"type": "subtitle", "time": 22088.628, "timestamp": "06:08:08", "text": "uh は Discord でも利用可能です。"}, {"type": "subtitle", "time": 22091.27, "timestamp": "06:08:11", "text": "必要であれば、"}, {"type": "subtitle", "time": 22093.83, "timestamp": "06:08:13", "text": "配信ルームに関するお知らせです。今は"}, {"type": "subtitle", "time": 22096.708, "timestamp": "06:08:16", "text": "利用可能。そして金曜日には"}, {"type": "subtitle", "time": 22100.548, "timestamp": "06:08:20", "text": "クリス・タスクとズチアとのコラボレーション"}, {"type": "subtitle", "time": 22105.03, "timestamp": "06:08:25", "text": "彼女はジョックンのママでもあるんです。えっと"}, {"type": "subtitle", "time": 22108.31, "timestamp": "06:08:28", "text": "彼女がこれを描いたんです"}, {"type": "subtitle", "time": 22113.27, "timestamp": "06:08:33", "text": "OGジョック、つまりPNGは"}, {"type": "subtitle", "time": 22117.83, "timestamp": "06:08:37", "text": "こんな感じになります。そうなんです、"}, {"type": "subtitle", "time": 22119.15, "timestamp": "06:08:39", "text": "私たちは"}, {"type": "subtitle", "time": 22122.51, "timestamp": "06:08:42", "text": "ええと、私たちは演奏します"}, {"type": "subtitle", "time": 22124.628, "timestamp": "06:08:44", "text": "ファスモフォビア（異文化恐怖症）。そしてそれは"}, {"type": "subtitle", "time": 22127.43, "timestamp": "06:08:47", "text": "やってみたいゲームだけど、怖くて"}, {"type": "subtitle", "time": 22132.23, "timestamp": "06:08:52", "text": "試してみたけど、結局買った。だから私は私は"}, {"type": "subtitle", "time": 22135.43, "timestamp": "06:08:55", "text": "怖がった。でも、どうやって"}, {"type": "subtitle", "time": 22136.83, "timestamp": "06:08:56", "text": "ゲームは動作しますが、"}, {"type": "subtitle", "time": 22139.91, "timestamp": "06:08:59", "text": "はい、私にとっては初めての経験になります。それで"}]
[{"type": "subtitle", "time": 9431.309, "timestamp": "02:37:11", "text": "おお。なんてこった。何を"}, {"type": "subtitle", "time": 9433.63, "timestamp": "02:37:13", "text": "終わり？何"}, {"type": "subtitle", "time": 9448.95, "timestamp": "02:37:28", "text": "待って、直さないと彼が"}, {"type": "subtitle", "time": 9453.03, "timestamp": "02:37:33", "text": "怒る。待って、誰か助けて、ここから出してくれ。"}, {"type": "subtitle", "time": 9456.79, "timestamp": "02:37:36", "text": "ここから抜け出せ。ああ、神様。方法"}, {"type": "subtitle", "time": 9467.07, "timestamp": "02:37:47", "text": "神。これって壊せるの？"}, {"type": "subtitle", "time": 9473.55, "timestamp": "02:37:53", "text": "本当に"}]
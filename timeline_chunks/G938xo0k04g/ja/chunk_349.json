[{"type": "subtitle", "time": 20946.15, "timestamp": "05:49:06", "text": "暗い。では、待ってください。朝は、"}, {"type": "subtitle", "time": 20954.47, "timestamp": "05:49:14", "text": "あれ。 PCには休憩が必要だ。ええ、私のPC"}, {"type": "subtitle", "time": 20957.708, "timestamp": "05:49:17", "text": "ほとんどの場合"}, {"type": "subtitle", "time": 20960.788, "timestamp": "05:49:20", "text": "それに対して、ほら、"}, {"type": "subtitle", "time": 20974.31, "timestamp": "05:49:34", "text": "もの。あ、待って。布がもう一枚必要だ"}, {"type": "subtitle", "time": 20977.83, "timestamp": "05:49:37", "text": "離れて。どこで見たか覚えている"}, {"type": "subtitle", "time": 20990.548, "timestamp": "05:49:50", "text": "忘れた。ぼろ切れを見たのを覚えている"}, {"type": "subtitle", "time": 20994.03, "timestamp": "05:49:54", "text": "どこかで。なんてこった。私は必要としている"}]
[{"type": "subtitle", "time": 15300.149, "timestamp": "04:15:00", "text": "えっと、どうやって"}, {"type": "subtitle", "time": 15308.229, "timestamp": "04:15:08", "text": "休暇を取って"}, {"type": "subtitle", "time": 15321.269, "timestamp": "04:15:21", "text": "うん。問題はそうではないということです。"}, {"type": "subtitle", "time": 15323.67, "timestamp": "04:15:23", "text": "単にパッティングするだけなら価値がある"}, {"type": "subtitle", "time": 15327.11, "timestamp": "04:15:27", "text": "Wアップとか、全部。私たちは"}, {"type": "subtitle", "time": 15329.269, "timestamp": "04:15:29", "text": "えーと、私たちは研ぐ必要はありません"}, {"type": "subtitle", "time": 15341.83, "timestamp": "04:15:41", "text": "うん。そして、もし私がビリーを連れてくるなら"}, {"type": "subtitle", "time": 15344.63, "timestamp": "04:15:44", "text": "ビリーマルチストリーム ビリーマルチストリーム"}, {"type": "subtitle", "time": 15346.99, "timestamp": "04:15:46", "text": "このヨアトンに"}, {"type": "subtitle", "time": 15350.71, "timestamp": "04:15:50", "text": "非常に注意しなければならないもの"}, {"type": "subtitle", "time": 15351.87, "timestamp": "04:15:51", "text": "私が"}, {"type": "subtitle", "time": 15356.03, "timestamp": "04:15:56", "text": "言うこととやること。たとえそれが"}]
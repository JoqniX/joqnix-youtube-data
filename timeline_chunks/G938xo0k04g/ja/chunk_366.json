[{"type": "subtitle", "time": 21961.35, "timestamp": "06:06:01", "text": "次のシリーズでは、"}, {"type": "subtitle", "time": 21962.43, "timestamp": "06:06:02", "text": "暗い"}, {"type": "subtitle", "time": 21965.11, "timestamp": "06:06:05", "text": "木材。えっと、壊れたら"}, {"type": "subtitle", "time": 21967.91, "timestamp": "06:06:07", "text": "鏡、えーと、鏡は割れない。それ"}, {"type": "subtitle", "time": 21969.708, "timestamp": "06:06:09", "text": "マルチ"}, {"type": "subtitle", "time": 21972.548, "timestamp": "06:06:12", "text": "掛け算する。壊せば、それは増殖する。待って。"}, {"type": "subtitle", "time": 21974.788, "timestamp": "06:06:14", "text": "鏡を割ると、鏡は"}, {"type": "subtitle", "time": 21978.23, "timestamp": "06:06:18", "text": "壊せば、それは増殖する。そうそう。うん。あなた"}, {"type": "subtitle", "time": 21981.788, "timestamp": "06:06:21", "text": "ピースの写真を撮ります、"}, {"type": "subtitle", "time": 21984.27, "timestamp": "06:06:24", "text": "右？何か"}, {"type": "subtitle", "time": 21987.47, "timestamp": "06:06:27", "text": "だってグラスだから"}, {"type": "subtitle", "time": 21995.67, "timestamp": "06:06:35", "text": "それ？ええ、それでは締めくくりたいと思います"}, {"type": "subtitle", "time": 21998.628, "timestamp": "06:06:38", "text": "今のところは、ここで。今のところ、私たちは"}, {"type": "subtitle", "time": 22000.708, "timestamp": "06:06:40", "text": "これで締めくくりだ。"}, {"type": "subtitle", "time": 22003.548, "timestamp": "06:06:43", "text": "短い配信のために今すぐコメントしてください。しかし"}, {"type": "subtitle", "time": 22007.19, "timestamp": "06:06:47", "text": "うん、主に休養するつもりだよ。"}, {"type": "subtitle", "time": 22009.39, "timestamp": "06:06:49", "text": "睡眠不足だった"}, {"type": "subtitle", "time": 22012.548, "timestamp": "06:06:52", "text": "今日。昨日とは、今日のことだ。しかし"}, {"type": "subtitle", "time": 22015.75, "timestamp": "06:06:55", "text": "ええ、もしかしたら配信するかもしれません。私はそうします"}, {"type": "subtitle", "time": 22019.99, "timestamp": "06:06:59", "text": "おそらくTwitchで配信するでしょう。それで、"}]
[{"type": "subtitle", "time": 21300.31, "timestamp": "05:55:00", "text": "つまり、できますが、必ず"}, {"type": "subtitle", "time": 21311.09, "timestamp": "05:55:11", "text": "聖なる人たちよ、本当に"}, {"type": "subtitle", "time": 21324.47, "timestamp": "05:55:24", "text": "暗い。ベッドで使うのに必要でよかった。は"}, {"type": "subtitle", "time": 21326.11, "timestamp": "05:55:26", "text": "の"}, {"type": "subtitle", "time": 21328.708, "timestamp": "05:55:28", "text": "うん。キノコの季節はいつ来るのでしょうか？"}, {"type": "subtitle", "time": 21336.67, "timestamp": "05:55:36", "text": "右？聞いた？"}, {"type": "subtitle", "time": 21349.43, "timestamp": "05:55:49", "text": "それ？今、聞こえましたか？誰かが"}, {"type": "subtitle", "time": 21352.11, "timestamp": "05:55:52", "text": "ドアをノックする。"}]
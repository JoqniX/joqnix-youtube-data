[{"type": "subtitle", "time": 20527.11, "timestamp": "05:42:07", "text": "気がついた。このゲームの会話は本当に"}, {"type": "subtitle", "time": 20539.03, "timestamp": "05:42:19", "text": "それ？では、ここにいくつか物を置いておきます"}, {"type": "subtitle", "time": 20543.75, "timestamp": "05:42:23", "text": "バッテリーは必要ありません。"}, {"type": "subtitle", "time": 20546.548, "timestamp": "05:42:26", "text": "ロックバック式のボトルは取っておきます。私はしません"}, {"type": "subtitle", "time": 20548.23, "timestamp": "05:42:28", "text": "必要かどうかを知る必要がある。私はただ"}, {"type": "subtitle", "time": 20549.708, "timestamp": "05:42:29", "text": "保つ"}, {"type": "subtitle", "time": 20561.27, "timestamp": "05:42:41", "text": "それ。餌として使用できます"}, {"type": "subtitle", "time": 20564.19, "timestamp": "05:42:44", "text": "カーニバル戦争。"}, {"type": "subtitle", "time": 20571.43, "timestamp": "05:42:51", "text": "ゲーム。おお。"}]
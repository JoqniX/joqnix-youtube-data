[{"type": "subtitle", "time": 14196.83, "timestamp": "03:56:36", "text": "よし、"}, {"type": "subtitle", "time": 14203.95, "timestamp": "03:56:43", "text": "[音楽]"}, {"type": "subtitle", "time": 14206.55, "timestamp": "03:56:46", "text": "あなた。では、まずは"}, {"type": "subtitle", "time": 14208.71, "timestamp": "03:56:48", "text": "制作関連資料。しかし彼らはストリーミング配信している"}, {"type": "subtitle", "time": 14211.429, "timestamp": "03:56:51", "text": "はい。夕方には"}, {"type": "subtitle", "time": 14214.189, "timestamp": "03:56:54", "text": "クラス。だから私は"}, {"type": "subtitle", "time": 14217.59, "timestamp": "03:56:57", "text": "V. でも夕方のストリームは、えっと、こんな感じになります"}]
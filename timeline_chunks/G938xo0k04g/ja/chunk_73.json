[{"type": "subtitle", "time": 4386.709, "timestamp": "01:13:06", "text": "[音楽]"}, {"type": "subtitle", "time": 4389.11, "timestamp": "01:13:09", "text": "あ、待って。フィードバックフォーム。忘れた"}, {"type": "subtitle", "time": 4395.43, "timestamp": "01:13:15", "text": "形状。私は完全に忘れていました"}, {"type": "subtitle", "time": 4398.149, "timestamp": "01:13:18", "text": "フィードバックフォームピン留めするべきだ"}, {"type": "subtitle", "time": 4400.75, "timestamp": "01:13:20", "text": "説明はこちら。いいえ、固定してください"}, {"type": "subtitle", "time": 4412.229, "timestamp": "01:13:32", "text": "いいえ、フィードバックフォームを確認する必要があります。"}]
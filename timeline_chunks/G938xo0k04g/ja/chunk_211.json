[{"type": "subtitle", "time": 12660.87, "timestamp": "03:31:00", "text": "秘密の結末。秘密の入り口が必要だ。私"}, {"type": "subtitle", "time": 12662.75, "timestamp": "03:31:02", "text": "したくない"}, {"type": "subtitle", "time": 12689.91, "timestamp": "03:31:29", "text": "時間。ジョック・ザ・シャベル。待って。そしてジョック"}, {"type": "subtitle", "time": 12693.87, "timestamp": "03:31:33", "text": "雪だるまと雪のファインダー、かな。"}, {"type": "subtitle", "time": 12697.83, "timestamp": "03:31:37", "text": "いいえ。ジョックは"}, {"type": "subtitle", "time": 12699.469, "timestamp": "03:31:39", "text": "えーと、スポーツマン"}, {"type": "subtitle", "time": 12700.74, "timestamp": "03:31:40", "text": "の"}, {"type": "subtitle", "time": 12702.83, "timestamp": "03:31:42", "text": "[音楽]"}, {"type": "subtitle", "time": 12706.59, "timestamp": "03:31:46", "text": "雪。知っている。"}, {"type": "subtitle", "time": 12713.229, "timestamp": "03:31:53", "text": "これはスポーツマンではない"}, {"type": "subtitle", "time": 12717.75, "timestamp": "03:31:57", "text": "いつ殴られるか見つける。このまま続けてもいいですか？"}]
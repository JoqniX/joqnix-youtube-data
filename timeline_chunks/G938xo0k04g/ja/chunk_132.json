[{"type": "subtitle", "time": 7933.069, "timestamp": "02:12:13", "text": "これは私があなたに"}, {"type": "subtitle", "time": 7941.79, "timestamp": "02:12:21", "text": "わかった。私は水を汲みに行きます。"}, {"type": "subtitle", "time": 7944.99, "timestamp": "02:12:24", "text": "えっと、それで、どこで"}, {"type": "subtitle", "time": 7956.39, "timestamp": "02:12:36", "text": "落とされた。落ちたのか"}, {"type": "subtitle", "time": 7959.75, "timestamp": "02:12:39", "text": "どこかで？ああ、彼は理解していなかった。"}, {"type": "subtitle", "time": 7965.03, "timestamp": "02:12:45", "text": "よし、いいね。私はそこへ行くつもりです。わかった、"}, {"type": "subtitle", "time": 7977.95, "timestamp": "02:12:57", "text": "それ。やってみよう"}, {"type": "subtitle", "time": 7979.41, "timestamp": "02:12:59", "text": "競争。"}]
[{"type": "subtitle", "time": 3808.91, "timestamp": "01:03:28", "text": "次は麻薬製造だ。ああ、私は捕まらなかった"}, {"type": "subtitle", "time": 3815.71, "timestamp": "01:03:35", "text": "午後。どうでしたか？"}, {"type": "subtitle", "time": 3820.19, "timestamp": "01:03:40", "text": "彼女？あなたもそうだといいですね。元気でいることを願っています"}, {"type": "subtitle", "time": 3823.19, "timestamp": "01:03:43", "text": "良い。他の皆さんもお元気でいらっしゃることを願っています"}]
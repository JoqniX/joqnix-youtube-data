[{"type": "subtitle", "time": 9302.55, "timestamp": "02:35:02", "text": "十分。ああ、なんてことだ、これは不気味な生き物だ。なぜ"}, {"type": "subtitle", "time": 9319.19, "timestamp": "02:35:19", "text": "君はテスト1番だ、それとも行くべきか"}, {"type": "subtitle", "time": 9321.469, "timestamp": "02:35:21", "text": "さらに高い？わからない。よし。"}, {"type": "subtitle", "time": 9325.11, "timestamp": "02:35:25", "text": "では、ジャンプして、右クリックして、左クリックしてください。ああ、"}, {"type": "subtitle", "time": 9330.11, "timestamp": "02:35:30", "text": "いいえ。うまくいかないだろう。このボートの作り方"}, {"type": "subtitle", "time": 9333.19, "timestamp": "02:35:33", "text": "あれ？はぁ？マクロは必要ですか？"}, {"type": "subtitle", "time": 9336.23, "timestamp": "02:35:36", "text": "それを実行するために？"}, {"type": "subtitle", "time": 9338.469, "timestamp": "02:35:38", "text": "マクロが必要だと思う"}, {"type": "subtitle", "time": 9345.27, "timestamp": "02:35:45", "text": "それ。水桶の方が簡単だ。"}, {"type": "subtitle", "time": 9354.11, "timestamp": "02:35:54", "text": "それ。"}, {"type": "subtitle", "time": 9355.63, "timestamp": "02:35:55", "text": "はい、"}]
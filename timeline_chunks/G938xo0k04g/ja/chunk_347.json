[{"type": "subtitle", "time": 20824.23, "timestamp": "05:47:04", "text": "しかし、健康は明日も大切だ"}, {"type": "subtitle", "time": 20826.59, "timestamp": "05:47:06", "text": "ストリームとして"}, {"type": "subtitle", "time": 20829.39, "timestamp": "05:47:09", "text": "良い。えっと、"}, {"type": "subtitle", "time": 20831.868, "timestamp": "05:47:11", "text": "うん、それを受け取るべきだね"}, {"type": "subtitle", "time": 20835.548, "timestamp": "05:47:15", "text": "遅い。だから私は信じています"}, {"type": "subtitle", "time": 20839.83, "timestamp": "05:47:19", "text": "えっと、私の理解が正しければ"}, {"type": "subtitle", "time": 20848.35, "timestamp": "05:47:28", "text": "暗い言葉だけ"}, {"type": "subtitle", "time": 20852.67, "timestamp": "05:47:32", "text": "そして、あなたはできると思います"}, {"type": "subtitle", "time": 20861.75, "timestamp": "05:47:41", "text": "ええ、ある意味では数えることができます"}, {"type": "subtitle", "time": 20864.27, "timestamp": "05:47:44", "text": "ヤンドレゲーム"}, {"type": "subtitle", "time": 20866.47, "timestamp": "05:47:46", "text": "最高。すべきかどうかわからない"}, {"type": "subtitle", "time": 20868.788, "timestamp": "05:47:48", "text": "続けるけど、私は"}, {"type": "subtitle", "time": 20869.868, "timestamp": "05:47:49", "text": "すべてを手に入れる"}, {"type": "subtitle", "time": 20872.15, "timestamp": "05:47:52", "text": "終わり。ほら、好きになる方がいいよ"}, {"type": "subtitle", "time": 20874.11, "timestamp": "05:47:54", "text": "ゲームを完全にクリアして"}, {"type": "subtitle", "time": 20878.15, "timestamp": "05:47:58", "text": "いいねして終わり。ええ、そうですね。うん。それで、"}]
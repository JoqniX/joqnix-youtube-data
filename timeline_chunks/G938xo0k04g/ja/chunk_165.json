[{"type": "subtitle", "time": 9901.269, "timestamp": "02:45:01", "text": "ブロックまたは2番目のブロック。とにかくスパム送信するんだ。ああ、"}, {"type": "subtitle", "time": 9903.11, "timestamp": "02:45:03", "text": "それが理由です。待って、待って、待って。私は思う"}, {"type": "subtitle", "time": 9911.269, "timestamp": "02:45:11", "text": "それ。待って、私の荷物はどこに行ったの？待って、それは"}, {"type": "subtitle", "time": 9913.23, "timestamp": "02:45:13", "text": "ない"}, {"type": "subtitle", "time": 9917.51, "timestamp": "02:45:17", "text": "そこには。捕まえたぞ。わかった。わかった。私は行かない"}, {"type": "subtitle", "time": 9928.19, "timestamp": "02:45:28", "text": "大丈夫。わかった。これをもう一度"}, {"type": "subtitle", "time": 9930.79, "timestamp": "02:45:30", "text": "現在。右クリック。右クリック。ああ、"}, {"type": "subtitle", "time": 9935.59, "timestamp": "02:45:35", "text": "いいえ。うまくいかない。私のピングかそれとも"}, {"type": "subtitle", "time": 9938.07, "timestamp": "02:45:38", "text": "何か別のことでしょうか？"}, {"type": "subtitle", "time": 9955.11, "timestamp": "02:45:55", "text": "そこには。ああ、もし私が"}, {"type": "subtitle", "time": 9957.75, "timestamp": "02:45:57", "text": "もし私が船に乗っていたら。なぜそれが"}]
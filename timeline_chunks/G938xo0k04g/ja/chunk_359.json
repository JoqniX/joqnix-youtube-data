[{"type": "subtitle", "time": 21541.67, "timestamp": "05:59:01", "text": "見えない。ああ、これだ。これです。"}, {"type": "subtitle", "time": 21543.548, "timestamp": "05:59:03", "text": "彼のグローブが"}, {"type": "subtitle", "time": 21546.27, "timestamp": "05:59:06", "text": "ここ。ちょっと変な感じ。"}, {"type": "subtitle", "time": 21549.19, "timestamp": "05:59:09", "text": "わかった、私は中立の立場を保つよ、"}, {"type": "subtitle", "time": 21551.948, "timestamp": "05:59:11", "text": "推測。待って、横に寄って、"}, {"type": "subtitle", "time": 21564.788, "timestamp": "05:59:24", "text": "兄弟。待って。男が私に手を差し伸べる"}, {"type": "subtitle", "time": 21567.43, "timestamp": "05:59:27", "text": "彼の手書きで何か書かれていた。彼の"}, {"type": "subtitle", "time": 21569.03, "timestamp": "05:59:29", "text": "唇は動いているが、引きつける力もある"}, {"type": "subtitle", "time": 21571.91, "timestamp": "05:59:31", "text": "内部。彼は肩をすくめた。彼は巨大な袋を手に取る"}, {"type": "subtitle", "time": 21573.35, "timestamp": "05:59:33", "text": "背中から落ちて下に落ちる"}, {"type": "subtitle", "time": 21576.948, "timestamp": "05:59:36", "text": "彼の行動を明らかにする。アイテムを表示 水"}, {"type": "subtitle", "time": 21577.96, "timestamp": "05:59:37", "text": "の"}, {"type": "subtitle", "time": 21579.788, "timestamp": "05:59:39", "text": "[音楽]"}, {"type": "subtitle", "time": 21582.39, "timestamp": "05:59:42", "text": "道に落書きを始める。彼が終えると、"}, {"type": "subtitle", "time": 21586.19, "timestamp": "05:59:46", "text": "彼は道をさらに奥へと導く"}, {"type": "subtitle", "time": 21591.45, "timestamp": "05:59:51", "text": "ああ、取引。ああ、彼は交換できるものを持っているよ。"}, {"type": "subtitle", "time": 21594.19, "timestamp": "05:59:54", "text": "[音楽]"}]
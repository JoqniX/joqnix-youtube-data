[{"type": "subtitle", "time": 11101.349, "timestamp": "03:05:01", "text": "わかった。ああ、コードがひどく絡まっている"}, {"type": "subtitle", "time": 11103.469, "timestamp": "03:05:03", "text": "上。"}, {"type": "subtitle", "time": 11111.67, "timestamp": "03:05:11", "text": "画面。それで、私のアイデアはこうでした。おお、"}, {"type": "subtitle", "time": 11115.11, "timestamp": "03:05:15", "text": "うん。これは新しいアップデートですか？"}, {"type": "subtitle", "time": 11117.67, "timestamp": "03:05:17", "text": "ペイントか、これが今あなたが"}, {"type": "subtitle", "time": 11121.03, "timestamp": "03:05:21", "text": "レイヤーを追加するんですよね？これは"}, {"type": "subtitle", "time": 11123.51, "timestamp": "03:05:23", "text": "最新バージョンですか？待って、どうやって"}, {"type": "subtitle", "time": 11125.55, "timestamp": "03:05:25", "text": "レイヤーを追加しますか？"}, {"type": "subtitle", "time": 11128.51, "timestamp": "03:05:28", "text": "また？これは新しい"}, {"type": "subtitle", "time": 11131.51, "timestamp": "03:05:31", "text": "最新のペイントツール。ああ、そうは思わない"}, {"type": "subtitle", "time": 11132.75, "timestamp": "03:05:32", "text": "これは"}, {"type": "subtitle", "time": 11137.349, "timestamp": "03:05:37", "text": "これがそれですか？うん。"}, {"type": "subtitle", "time": 11139.469, "timestamp": "03:05:39", "text": "なんてこった。これは"}, {"type": "subtitle", "time": 11142.91, "timestamp": "03:05:42", "text": "1つ。うん。私の考えはこうです。"}, {"type": "subtitle", "time": 11145.75, "timestamp": "03:05:45", "text": "わかった。ああ、それは逆ですね。わかった。私は"}, {"type": "subtitle", "time": 11149.11, "timestamp": "03:05:49", "text": "サイドメニューとして出すつもりです。そこで、"}, {"type": "subtitle", "time": 11151.71, "timestamp": "03:05:51", "text": "私たちの雪の物体、"}, {"type": "subtitle", "time": 11155.429, "timestamp": "03:05:55", "text": "右？つまり、えっと、想像してみてください"}, {"type": "subtitle", "time": 11157.23, "timestamp": "03:05:57", "text": "待って、待って、"}, {"type": "subtitle", "time": 11159.75, "timestamp": "03:05:59", "text": "より良い。これが壁だと想像してください"}]
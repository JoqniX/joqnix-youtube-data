[{"type": "subtitle", "time": 7201.95, "timestamp": "02:00:01", "text": "ここ。私はします"}, {"type": "subtitle", "time": 7203.44, "timestamp": "02:00:03", "text": "これを超える"}, {"type": "subtitle", "time": 7206.03, "timestamp": "02:00:06", "text": "[音楽]"}, {"type": "subtitle", "time": 7208.47, "timestamp": "02:00:08", "text": "ここ。彼らはできるのか？ああ、彼らは"}, {"type": "subtitle", "time": 7210.95, "timestamp": "02:00:10", "text": "来る。彼らは落ちぶれるだろう。はい。"}, {"type": "subtitle", "time": 7214.07, "timestamp": "02:00:14", "text": "うん。下へ降りてください。お互いを刺激し合う。うん。"}, {"type": "subtitle", "time": 7216.79, "timestamp": "02:00:16", "text": "1つ。 1人が倒れた。お互いを刺激し合う。"}, {"type": "subtitle", "time": 7220.91, "timestamp": "02:00:20", "text": "はい。押す。はい。はい。"}, {"type": "subtitle", "time": 7223.75, "timestamp": "02:00:23", "text": "ああ、私は落ちた。ああ、なんてことだ。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 7225.03, "timestamp": "02:00:25", "text": "これはまずい。これはまずい。これはまずい。"}, {"type": "subtitle", "time": 7226.55, "timestamp": "02:00:26", "text": "これはまずい。これはまずい。なんてこった。いいえ。いいえ。"}, {"type": "subtitle", "time": 7227.149, "timestamp": "02:00:27", "text": "いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ。"}, {"type": "subtitle", "time": 7229.83, "timestamp": "02:00:29", "text": "いいえ。なぜ転んだのですか？なぜ転んだのですか？"}, {"type": "subtitle", "time": 7236.709, "timestamp": "02:00:36", "text": "主。キャット、どうして私の家の中にいるの？"}, {"type": "subtitle", "time": 7246.55, "timestamp": "02:00:46", "text": "君もここにいたんだね？ああ、なんてことだ、"}, {"type": "subtitle", "time": 7249.31, "timestamp": "02:00:49", "text": "ゾンビが来た。何？"}, {"type": "subtitle", "time": 7252.35, "timestamp": "02:00:52", "text": "どうやって？ちょっと待ってください"}]
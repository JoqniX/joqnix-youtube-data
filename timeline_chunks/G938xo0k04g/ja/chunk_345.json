[{"type": "subtitle", "time": 20704.23, "timestamp": "05:45:04", "text": "すぐ。それは私に言った。これは"}, {"type": "subtitle", "time": 20708.35, "timestamp": "05:45:08", "text": "悪魔。わからない。たぶん私は"}, {"type": "subtitle", "time": 20722.19, "timestamp": "05:45:22", "text": "知る。感謝"}, {"type": "subtitle", "time": 20725.51, "timestamp": "05:45:25", "text": "あなた。ああ、大変だ。電源を入れるだけでいい"}, {"type": "subtitle", "time": 20727.15, "timestamp": "05:45:27", "text": "その時"}, {"type": "subtitle", "time": 20730.788, "timestamp": "05:45:30", "text": "えっと、古いゲームです。はい、古いものです"}, {"type": "subtitle", "time": 20734.35, "timestamp": "05:45:34", "text": "古いゲーム。それは"}, {"type": "subtitle", "time": 20744.47, "timestamp": "05:45:44", "text": "そしてこのゲームは26分くらい続くんだ"}, {"type": "subtitle", "time": 20746.51, "timestamp": "05:45:46", "text": "26"}, {"type": "subtitle", "time": 20749.868, "timestamp": "05:45:49", "text": "完了するまでに数時間かかります"}, {"type": "subtitle", "time": 20753.03, "timestamp": "05:45:53", "text": "ゲーム。つまり私は自分の"}]
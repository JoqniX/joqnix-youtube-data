[{"type": "subtitle", "time": 9844.429, "timestamp": "02:44:04", "text": "オーケー"}, {"type": "subtitle", "time": 9847.63, "timestamp": "02:44:07", "text": "銀河3 2"}, {"type": "subtitle", "time": 9850.07, "timestamp": "02:44:10", "text": "1. こちらへ来てください。右クリック。ダブル"}, {"type": "subtitle", "time": 9854.95, "timestamp": "02:44:14", "text": "右クリック。ああ、いや。それは愚かな行為だった。"}, {"type": "subtitle", "time": 9858.75, "timestamp": "02:44:18", "text": "ああ、私は自分を訓練する必要がある"}, {"type": "subtitle", "time": 9861.51, "timestamp": "02:44:21", "text": "これ。しかし、ダブルクリックしても"}, {"type": "subtitle", "time": 9867.19, "timestamp": "02:44:27", "text": "けれど。そんなやり方はダメだ。いいえ、"}, {"type": "subtitle", "time": 9870.99, "timestamp": "02:44:30", "text": "まるで、それを置いてその上に乗るような感じです。"}, {"type": "subtitle", "time": 9872.91, "timestamp": "02:44:32", "text": "いいえ。ああ、"}, {"type": "subtitle", "time": 9875.63, "timestamp": "02:44:35", "text": "待って。彼"}, {"type": "subtitle", "time": 9879.23, "timestamp": "02:44:39", "text": "亡くなった。これはどのように作動しますか"}, {"type": "subtitle", "time": 9884.309, "timestamp": "02:44:44", "text": "空の上にいる時でさえ？あ、待って。"}, {"type": "subtitle", "time": 9886.95, "timestamp": "02:44:46", "text": "私の過ちは、"}, {"type": "subtitle", "time": 9890.87, "timestamp": "02:44:50", "text": "地面は、一番低いところのような感じ"}, {"type": "subtitle", "time": 9894.19, "timestamp": "02:44:54", "text": "レベル。私はそれを"}, {"type": "subtitle", "time": 9897.269, "timestamp": "02:44:57", "text": "3階。 3 レベルの平均値 3 番目"}]
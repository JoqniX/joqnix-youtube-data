[{"type": "subtitle", "time": 13680.71, "timestamp": "03:48:00", "text": "そして、その他のこと。"}, {"type": "subtitle", "time": 13684.469, "timestamp": "03:48:04", "text": "以前はこれをやっていましたし、以前は"}, {"type": "subtitle", "time": 13687.429, "timestamp": "03:48:07", "text": "要約を作るような、要約のような"}, {"type": "subtitle", "time": 13690.389, "timestamp": "03:48:10", "text": "今日私たちがやったことは、初日のようなもの"}, {"type": "subtitle", "time": 13692.309, "timestamp": "03:48:12", "text": "音楽制作、学習2日目"}, {"type": "subtitle", "time": 13694.87, "timestamp": "03:48:14", "text": "どうすればそのようなものを作ることができるのか。以前は"}, {"type": "subtitle", "time": 13698.349, "timestamp": "03:48:18", "text": "Twitterとかでシェアしたよ。"}, {"type": "subtitle", "time": 13702.55, "timestamp": "03:48:22", "text": "えっと、どのフォーマットでできるかは分かっています"}, {"type": "subtitle", "time": 13705.95, "timestamp": "03:48:25", "text": "そして全て。私は自分のスポーツマンとしてのスキルを使います"}, {"type": "subtitle", "time": 13709.269, "timestamp": "03:48:29", "text": "えーと、スポーツマンとして学んだことみたいな。私"}, {"type": "subtitle", "time": 13711.75, "timestamp": "03:48:31", "text": "そこにぴったり置いてください。しかし、私は"}, {"type": "subtitle", "time": 13713.75, "timestamp": "03:48:33", "text": "その別名からしばらく離れていました"}, {"type": "subtitle", "time": 13716.55, "timestamp": "03:48:36", "text": "一晩、しばらくの間。そこから"}, {"type": "subtitle", "time": 13726.15, "timestamp": "03:48:46", "text": "しかし、私は自分がそれをできると分かっています。私は知っている"}, {"type": "subtitle", "time": 13728.67, "timestamp": "03:48:48", "text": "できるよ。やらなければならない。しかし"}, {"type": "subtitle", "time": 13730.91, "timestamp": "03:48:50", "text": "ノネオ なぜ"}, {"type": "subtitle", "time": 13733.429, "timestamp": "03:48:53", "text": "ずっと配信していたので疲れた"}, {"type": "subtitle", "time": 13734.91, "timestamp": "03:48:54", "text": "24"}, {"type": "subtitle", "time": 13737.91, "timestamp": "03:48:57", "text": "時間。しかし、それは言い訳にはならない。"}, {"type": "subtitle", "time": 13739.71, "timestamp": "03:48:59", "text": "私はやらなければならなかった"}]
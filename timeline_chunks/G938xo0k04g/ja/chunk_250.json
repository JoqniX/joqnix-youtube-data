[{"type": "subtitle", "time": 15001.349, "timestamp": "04:10:01", "text": "TwitchやYouTubeの人たち、私は"}, {"type": "subtitle", "time": 15004.07, "timestamp": "04:10:04", "text": "君たちの名前を覚えておこう、なぜなら私は"}, {"type": "subtitle", "time": 15006.71, "timestamp": "04:10:06", "text": "あなたの名前を見たでしょう"}, {"type": "subtitle", "time": 15008.79, "timestamp": "04:10:08", "text": "英語で、私はそれを覚えようとします"}, {"type": "subtitle", "time": 15012.07, "timestamp": "04:10:12", "text": "正しく来て交流すればするほど"}, {"type": "subtitle", "time": 15014.95, "timestamp": "04:10:14", "text": "私と交流しましょう。しかし、"}, {"type": "subtitle", "time": 15017.59, "timestamp": "04:10:17", "text": "異なる文字で書かれた名前"}, {"type": "subtitle", "time": 15021.91, "timestamp": "04:10:21", "text": "例えば日本人のような、あるいは日本人のような"}, {"type": "subtitle", "time": 15023.75, "timestamp": "04:10:23", "text": "一つは、私には少し時間がかかると思う"}, {"type": "subtitle", "time": 15026.11, "timestamp": "04:10:26", "text": "読書をもっと上達させる必要がある"}, {"type": "subtitle", "time": 15028.79, "timestamp": "04:10:28", "text": "読む。だから中国製のものも私も"}, {"type": "subtitle", "time": 15031.51, "timestamp": "04:10:31", "text": "今は読めません。だから私は知らない"}, {"type": "subtitle", "time": 15034.309, "timestamp": "04:10:34", "text": "あなたに会い続けたり、学んだりする必要がある"}, {"type": "subtitle", "time": 15037.429, "timestamp": "04:10:37", "text": "単語を暗記するか、覚えておく"}, {"type": "subtitle", "time": 15039.67, "timestamp": "04:10:39", "text": "その名前や言葉を見たときに"}, {"type": "subtitle", "time": 15043.63, "timestamp": "04:10:43", "text": "キャラクターを見て、「ああ、君か」って思うだろう"}, {"type": "subtitle", "time": 15057.03, "timestamp": "04:10:57", "text": "ハードな感じ、もし私が望めば"}, {"type": "subtitle", "time": 15059.83, "timestamp": "04:10:59", "text": "終わり"}]
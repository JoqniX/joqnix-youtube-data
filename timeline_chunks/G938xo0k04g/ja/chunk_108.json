[{"type": "subtitle", "time": 6480.31, "timestamp": "01:48:00", "text": "残念ながら準備しなければならなかった"}, {"type": "subtitle", "time": 6484.95, "timestamp": "01:48:04", "text": "明日は女王の誕生日。"}, {"type": "subtitle", "time": 6487.83, "timestamp": "01:48:07", "text": "だから私も同じことを考えていた"}, {"type": "subtitle", "time": 6490.31, "timestamp": "01:48:10", "text": "セシルと一緒にやったことだよ、だってわかるでしょ"}, {"type": "subtitle", "time": 6493.59, "timestamp": "01:48:13", "text": "すべてがそのように"}, {"type": "subtitle", "time": 6497.669, "timestamp": "01:48:17", "text": "ええ、もちろん変更はできますが、ええと、"}, {"type": "subtitle", "time": 6498.91, "timestamp": "01:48:18", "text": "しないで"}, {"type": "subtitle", "time": 6510.669, "timestamp": "01:48:30", "text": "えっと、私は最後に何をしたんだっけ？"}, {"type": "subtitle", "time": 6515.91, "timestamp": "01:48:35", "text": "誕生日から1年経ちました"}, {"type": "subtitle", "time": 6519.149, "timestamp": "01:48:39", "text": "描画ストリーム。いいえ、タイを描く"}, {"type": "subtitle", "time": 6522.91, "timestamp": "01:48:42", "text": "チャン。彼を描く"}, {"type": "subtitle", "time": 6526.149, "timestamp": "01:48:46", "text": "それから。はい、やりました。それからセシルの"}, {"type": "subtitle", "time": 6527.83, "timestamp": "01:48:47", "text": "誕生日に、新しいことを試してみました。それは"}, {"type": "subtitle", "time": 6530.03, "timestamp": "01:48:50", "text": "の"}, {"type": "subtitle", "time": 6533.39, "timestamp": "01:48:53", "text": "テキスト読み上げ"}, {"type": "subtitle", "time": 6536.95, "timestamp": "01:48:56", "text": "あれ。うん。ええ、そうしました。"}, {"type": "subtitle", "time": 6539.629, "timestamp": "01:48:59", "text": "だから私は"}]
[{"type": "subtitle", "time": 6001.189, "timestamp": "01:40:01", "text": "えっと、CS2をアップロードしていたんだけど"}, {"type": "subtitle", "time": 6004.39, "timestamp": "01:40:04", "text": "先日のveaとのコラボ"}, {"type": "subtitle", "time": 6007.03, "timestamp": "01:40:07", "text": "そして私はBGMに気づきました"}, {"type": "subtitle", "time": 6009.47, "timestamp": "01:40:09", "text": "実際は"}, {"type": "subtitle", "time": 6012.59, "timestamp": "01:40:12", "text": "うるさい。は"}, {"type": "subtitle", "time": 6015.83, "timestamp": "01:40:15", "text": "それ？何？背景が"}, {"type": "subtitle", "time": 6017.59, "timestamp": "01:40:17", "text": "演奏している時に音楽がうるさい時がある"}, {"type": "subtitle", "time": 6019.99, "timestamp": "01:40:19", "text": "ゲームか何か。それは普通のことですか？"}, {"type": "subtitle", "time": 6022.189, "timestamp": "01:40:22", "text": "「ああ」"}, {"type": "subtitle", "time": 6026.95, "timestamp": "01:40:26", "text": "神様、私には「だって、私は使うから」が必要なんです"}, {"type": "subtitle", "time": 6031.83, "timestamp": "01:40:31", "text": "えっと、固定オーディオレートみたいなやつ"}, {"type": "subtitle", "time": 6036.07, "timestamp": "01:40:36", "text": "えーと、リミッターみたいなやつを、"}, {"type": "subtitle", "time": 6040.07, "timestamp": "01:40:40", "text": "Mac のように、私が欲しい量やボリュームなど"}, {"type": "subtitle", "time": 6043.669, "timestamp": "01:40:43", "text": "それに対して私は、何かが起こっていることを望んでいます"}, {"type": "subtitle", "time": 6046.79, "timestamp": "01:40:46", "text": "すべてのシーンに登場"}, {"type": "subtitle", "time": 6050.189, "timestamp": "01:40:50", "text": "ええと、この特定の音声ソースについてです。それで"}, {"type": "subtitle", "time": 6053.27, "timestamp": "01:40:53", "text": "ええ、私はオーディオスライダーを操作しません"}, {"type": "subtitle", "time": 6056.31, "timestamp": "01:40:56", "text": "実は。まるでプリセットみたい"}, {"type": "subtitle", "time": 6059.99, "timestamp": "01:40:59", "text": "それ、あれ。このシーンは"}]
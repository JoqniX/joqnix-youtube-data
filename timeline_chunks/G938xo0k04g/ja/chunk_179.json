[{"type": "subtitle", "time": 10752.269, "timestamp": "02:59:12", "text": "ああ、わかった。さて、ここで質問です。"}, {"type": "subtitle", "time": 10757.15, "timestamp": "02:59:17", "text": "私が作ったのは、まるで仕掛けのようなものだった"}, {"type": "subtitle", "time": 10765.83, "timestamp": "02:59:25", "text": "ああ、それはどんな感じになるんだろう？ええと、ご存知のとおり"}, {"type": "subtitle", "time": 10768.389, "timestamp": "02:59:28", "text": "あなたの美しいスノーラを見ると、"}, {"type": "subtitle", "time": 10771.79, "timestamp": "02:59:31", "text": "一つのこと。それはどんなものになるだろうか？"}, {"type": "subtitle", "time": 10776.87, "timestamp": "02:59:36", "text": "そんなことは考えもしないで。ああ、それは"}, {"type": "subtitle", "time": 10779.79, "timestamp": "02:59:39", "text": "それはタブーです。"}, {"type": "subtitle", "time": 10783.23, "timestamp": "02:59:43", "text": "考え。あなたは決して考えない"}]
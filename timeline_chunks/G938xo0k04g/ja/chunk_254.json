[{"type": "subtitle", "time": 15242.95, "timestamp": "04:14:02", "text": "英語なんて、彼らには理解できないだろう。"}, {"type": "subtitle", "time": 15247.03, "timestamp": "04:14:07", "text": "そして、私が使っている翻訳ソフト"}, {"type": "subtitle", "time": 15249.189, "timestamp": "04:14:09", "text": "これらの翻訳ソフトウェアは"}, {"type": "subtitle", "time": 15250.51, "timestamp": "04:14:10", "text": "理解する"}, {"type": "subtitle", "time": 15255.03, "timestamp": "04:14:15", "text": "私と、これが表示されるものは何であれ"}, {"type": "subtitle", "time": 15257.99, "timestamp": "04:14:17", "text": "ライブ字幕が画面に表示されます"}, {"type": "subtitle", "time": 15264.429, "timestamp": "04:14:24", "text": "間違っている"}, {"type": "subtitle", "time": 15268.55, "timestamp": "04:14:28", "text": "うん、何をするかはだいたい分かってるよ"}, {"type": "subtitle", "time": 15271.03, "timestamp": "04:14:31", "text": "ゲームをしていないときや"}, {"type": "subtitle", "time": 15286.11, "timestamp": "04:14:46", "text": "する？ワイヤレスで可能です"}, {"type": "subtitle", "time": 15288.03, "timestamp": "04:14:48", "text": "毎週。"}, {"type": "subtitle", "time": 15291.51, "timestamp": "04:14:51", "text": "だから5月には"}, {"type": "subtitle", "time": 15294.429, "timestamp": "04:14:54", "text": "3日間の休暇"}, {"type": "subtitle", "time": 15297.389, "timestamp": "04:14:57", "text": "良い。"}]
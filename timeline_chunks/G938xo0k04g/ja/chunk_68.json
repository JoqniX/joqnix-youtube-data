[{"type": "subtitle", "time": 4113.669, "timestamp": "01:08:33", "text": "サム・インディアはかなり大きな会社です"}, {"type": "subtitle", "time": 4115.669, "timestamp": "01:08:35", "text": "ベルテック社と建設インフラ。"}, {"type": "subtitle", "time": 4117.189, "timestamp": "01:08:37", "text": "レシートが"}, {"type": "subtitle", "time": 4119.55, "timestamp": "01:08:39", "text": "寒さの中では確実"}, {"type": "subtitle", "time": 4124.59, "timestamp": "01:08:44", "text": "電話しています。私はそれが大好きです。わかりました、読みました。"}, {"type": "subtitle", "time": 4127.229, "timestamp": "01:08:47", "text": "おお。"}, {"type": "subtitle", "time": 4129.91, "timestamp": "01:08:49", "text": "だから、私はこれらについて何も知らない"}, {"type": "subtitle", "time": 4133.829, "timestamp": "01:08:53", "text": "履歴書すら持っていないから愛してる"}, {"type": "subtitle", "time": 4139.51, "timestamp": "01:08:59", "text": "場所。ああ、自分で作らなきゃ"}]
[{"type": "subtitle", "time": 11281.67, "timestamp": "03:08:01", "text": "えっと、何の話をしてたんだっけ？私は何者だったのか"}, {"type": "subtitle", "time": 11289.469, "timestamp": "03:08:09", "text": "えーと、"}, {"type": "subtitle", "time": 11292.269, "timestamp": "03:08:12", "text": "タワー。"}, {"type": "subtitle", "time": 11299.23, "timestamp": "03:08:19", "text": "ああ、そうだよ。もうこの話はやめよう。"}, {"type": "subtitle", "time": 11303.469, "timestamp": "03:08:23", "text": "ああ、わかった。そこで私の考えは"}, {"type": "subtitle", "time": 11307.99, "timestamp": "03:08:27", "text": "外側は炎の壁のように見える"}, {"type": "subtitle", "time": 11311.03, "timestamp": "03:08:31", "text": "家と一緒に。ああ、神様。だから私は"}, {"type": "subtitle", "time": 11315.469, "timestamp": "03:08:35", "text": "もっと物を追加するような感じ"}, {"type": "subtitle", "time": 11320.469, "timestamp": "03:08:40", "text": "わからないけど、そういう感じにしよう。負けました"}, {"type": "subtitle", "time": 11325.91, "timestamp": "03:08:45", "text": "希望。私がやりたいことは何ですか？"}, {"type": "subtitle", "time": 11328.59, "timestamp": "03:08:48", "text": "えーと、どうやって"}, {"type": "subtitle", "time": 11332.469, "timestamp": "03:08:52", "text": "タワー。塔はどんな形をしているのでしょうか？タワー"}, {"type": "subtitle", "time": 11333.71, "timestamp": "03:08:53", "text": "の"}]
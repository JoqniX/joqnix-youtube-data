[{"type": "subtitle", "time": 8761.19, "timestamp": "02:26:01", "text": "1つ。私はその上を走っています。ああ、主よ、"}, {"type": "subtitle", "time": 8777.07, "timestamp": "02:26:17", "text": "あ、待って。どうすればまたあの場所まで登れるんですか？おお"}, {"type": "subtitle", "time": 8779.55, "timestamp": "02:26:19", "text": "いいえ。おお"}, {"type": "subtitle", "time": 8782.27, "timestamp": "02:26:22", "text": "いいえ。誰の家が"}, {"type": "subtitle", "time": 8785.83, "timestamp": "02:26:25", "text": "これ？そこはポータルの場所の終わりです。おお"}, {"type": "subtitle", "time": 8786.99, "timestamp": "02:26:26", "text": "主。"}, {"type": "subtitle", "time": 8798.79, "timestamp": "02:26:38", "text": "はぁ？えっと、クラッチ操作が下手なところをやってみよう。とは"}, {"type": "subtitle", "time": 8808.63, "timestamp": "02:26:48", "text": "何？ボート用クラッチ。何か"}, {"type": "subtitle", "time": 8810.03, "timestamp": "02:26:50", "text": "ボートと呼ばれる"}, {"type": "subtitle", "time": 8811.15, "timestamp": "02:26:51", "text": "クラッチ。"}, {"type": "subtitle", "time": 8812.67, "timestamp": "02:26:52", "text": "[音楽]"}, {"type": "subtitle", "time": 8814.91, "timestamp": "02:26:54", "text": "わかった。わかった。"}]
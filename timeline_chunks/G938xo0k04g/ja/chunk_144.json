[{"type": "subtitle", "time": 8647.99, "timestamp": "02:24:07", "text": "えーと、これをしながら、"}, {"type": "subtitle", "time": 8650.83, "timestamp": "02:24:10", "text": "あの溶岩みたいなやつ。溶岩ブロックは何、"}, {"type": "subtitle", "time": 8654.07, "timestamp": "02:24:14", "text": "右？えーと、溶岩ブロックのように"}, {"type": "subtitle", "time": 8656.429, "timestamp": "02:24:16", "text": "ひび割れみたいなもの。それって何ていう名前でしたっけ？"}, {"type": "subtitle", "time": 8659.55, "timestamp": "02:24:19", "text": "マグマ。ああ、あれだよ、"}, {"type": "subtitle", "time": 8666.99, "timestamp": "02:24:26", "text": "ああ、ありがとう"}, {"type": "subtitle", "time": 8680.429, "timestamp": "02:24:40", "text": "簡単に？"}, {"type": "subtitle", "time": 8682.429, "timestamp": "02:24:42", "text": "くそ。"}, {"type": "subtitle", "time": 8685.389, "timestamp": "02:24:45", "text": "わかった。私がしていることを見てください"}, {"type": "subtitle", "time": 8697.95, "timestamp": "02:24:57", "text": "やったよ。私はそうしました"}]
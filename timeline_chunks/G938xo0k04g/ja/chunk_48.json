[{"type": "subtitle", "time": 2884.51, "timestamp": "00:48:04", "text": "感覚。しかしそのためには、"}, {"type": "subtitle", "time": 2887.51, "timestamp": "00:48:07", "text": "数百万。うーん、高いと思う"}, {"type": "subtitle", "time": 2890.39, "timestamp": "00:48:10", "text": "なぜなら、ええ、彼らは公式です"}, {"type": "subtitle", "time": 2894.55, "timestamp": "00:48:14", "text": "アーティスト、ワールドスタジオ、思想家。だからあなたは"}, {"type": "subtitle", "time": 2896.63, "timestamp": "00:48:16", "text": "彼らはとても忙しいので、"}, {"type": "subtitle", "time": 2898.589, "timestamp": "00:48:18", "text": "委託するのが難しい"}, {"type": "subtitle", "time": 2903.589, "timestamp": "00:48:23", "text": "彼ら。さよなら。私は神明に夢中になりすぎている"}, {"type": "subtitle", "time": 2904.91, "timestamp": "00:48:24", "text": "のように"}, {"type": "subtitle", "time": 2908.47, "timestamp": "00:48:28", "text": "あれ。それはとても良いので、"}, {"type": "subtitle", "time": 2915.99, "timestamp": "00:48:35", "text": "でも私は神崎に偏りすぎているので"}, {"type": "subtitle", "time": 2920.15, "timestamp": "00:48:40", "text": "ファンボーイ、ええ、そう思う、そうすべきではない"}, {"type": "subtitle", "time": 2923.109, "timestamp": "00:48:43", "text": "真似しすぎたり、そうだったり。うん。私"}, {"type": "subtitle", "time": 2925.589, "timestamp": "00:48:45", "text": "つまり、私は彼らが大好きなんです。何"}, {"type": "subtitle", "time": 2928.069, "timestamp": "00:48:48", "text": "彼らはそうするし、すべてがとても良い。による"}, {"type": "subtitle", "time": 2931.39, "timestamp": "00:48:51", "text": "そういうやり方で、私は一緒に仕事をしたい"}, {"type": "subtitle", "time": 2933.87, "timestamp": "00:48:53", "text": "カマキ。それが私の夢です"}, {"type": "subtitle", "time": 2937.829, "timestamp": "00:48:57", "text": "仕事。自分がどこに行き着こうとも構わない。私"}]
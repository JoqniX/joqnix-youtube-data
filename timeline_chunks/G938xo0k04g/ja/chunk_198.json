[{"type": "subtitle", "time": 11895.469, "timestamp": "03:18:15", "text": "えーと"}, {"type": "subtitle", "time": 11899.71, "timestamp": "03:18:19", "text": "ああ、私の脳脳"}, {"type": "subtitle", "time": 11914.15, "timestamp": "03:18:34", "text": "これ？ Bクラスに入れますか？私はそうではない 私はそうではない"}, {"type": "subtitle", "time": 11917.67, "timestamp": "03:18:37", "text": "あなたが捕まえた管理者。だからあなたは尋ねなければならない"}, {"type": "subtitle", "time": 11919.07, "timestamp": "03:18:39", "text": "のために"}, {"type": "subtitle", "time": 11922.79, "timestamp": "03:18:42", "text": "それ。しかし、私は管理者でもありません"}, {"type": "subtitle", "time": 11924.51, "timestamp": "03:18:44", "text": "推測。しかし彼は"}, {"type": "subtitle", "time": 11926.95, "timestamp": "03:18:46", "text": "シリアル。うん。うん。わからない。あなたは"}, {"type": "subtitle", "time": 11930.429, "timestamp": "03:18:50", "text": "彼に尋ねる。私はしません"}, {"type": "subtitle", "time": 11938.469, "timestamp": "03:18:58", "text": "私に何ができる？これは地面のようなもの"}]
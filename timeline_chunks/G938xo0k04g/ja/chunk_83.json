[{"type": "subtitle", "time": 5016.149, "timestamp": "01:23:36", "text": "[音楽]"}, {"type": "subtitle", "time": 5017.87, "timestamp": "01:23:37", "text": "時々私は"}, {"type": "subtitle", "time": 5026.39, "timestamp": "01:23:46", "text": "声、なぜなら私はまだ学ぶ必要があるから"}, {"type": "subtitle", "time": 5028.43, "timestamp": "01:23:48", "text": "歌うこと、そしてどのように"}, {"type": "subtitle", "time": 5032.31, "timestamp": "01:23:52", "text": "自分の声をさまざまな方向に出すように訓練する"}, {"type": "subtitle", "time": 5035.629, "timestamp": "01:23:55", "text": "ピッチングや"}, {"type": "subtitle", "time": 5038.87, "timestamp": "01:23:58", "text": "鍵盤も何もかも違う。私はしません"}]
[{"type": "subtitle", "time": 19689.07, "timestamp": "05:28:09", "text": "パターン。では、皆さんはどう思いますか？"}, {"type": "subtitle", "time": 19692.07, "timestamp": "05:28:12", "text": "遠い？今、とても眠くて疲れています"}, {"type": "subtitle", "time": 19697.59, "timestamp": "05:28:17", "text": "私はもっ​​と練習する必要があると思う"}, {"type": "subtitle", "time": 19701.43, "timestamp": "05:28:21", "text": "日。少なくとも1時間はかかる。これはまずい。これ"}, {"type": "subtitle", "time": 19718.628, "timestamp": "05:28:38", "text": "慣れるほど"}, {"type": "subtitle", "time": 19721.75, "timestamp": "05:28:41", "text": "ソフトウェア、私が知っている姿勢"}, {"type": "subtitle", "time": 19724.47, "timestamp": "05:28:44", "text": "何をすべきか、その他すべて、どこにいるか"}, {"type": "subtitle", "time": 19728.07, "timestamp": "05:28:48", "text": "クリックして音楽をかける場所と"}, {"type": "subtitle", "time": 19729.23, "timestamp": "05:28:49", "text": "すべて。"}]
[{"type": "subtitle", "time": 8893.59, "timestamp": "02:28:13", "text": "無料。土を３つあげよう"}, {"type": "subtitle", "time": 8903.23, "timestamp": "02:28:23", "text": "何でも。ああ、ありがとう"}, {"type": "subtitle", "time": 8906.75, "timestamp": "02:28:26", "text": "あなた。しかしそれは"}, {"type": "subtitle", "time": 8914.389, "timestamp": "02:28:34", "text": "わかった。よし。水はどこにある？"}, {"type": "subtitle", "time": 8920.27, "timestamp": "02:28:40", "text": "けれど？ああ、ありがとう"}, {"type": "subtitle", "time": 8923.11, "timestamp": "02:28:43", "text": "あなた。待って、今水桶を見せたところだよ"}, {"type": "subtitle", "time": 8925.07, "timestamp": "02:28:45", "text": "けれど。あれ、あれはどこに行ったの？"}, {"type": "subtitle", "time": 8927.79, "timestamp": "02:28:47", "text": "待って。ああ、気にしないで。私は見もしなかった"}, {"type": "subtitle", "time": 8932.03, "timestamp": "02:28:52", "text": "それ。ああ、もっと食べ物が欲しい。ありがとう。何"}]
[{"type": "subtitle", "time": 8854.63, "timestamp": "02:27:34", "text": "左。ああ、彼は実際に私の"}, {"type": "subtitle", "time": 8859.57, "timestamp": "02:27:39", "text": "ああ、"}, {"type": "subtitle", "time": 8874.11, "timestamp": "02:27:54", "text": "神。手に入れました。感謝"}, {"type": "subtitle", "time": 8877.19, "timestamp": "02:27:57", "text": "あなた。その間、私は苦しんでいた。彼はただ"}]
[{"type": "subtitle", "time": 5461.11, "timestamp": "01:31:01", "text": "飽和度が高いほどエントリーには良いが"}, {"type": "subtitle", "time": 5491.07, "timestamp": "01:31:31", "text": "えっと、組み合わせは"}, {"type": "subtitle", "time": 5493.629, "timestamp": "01:31:33", "text": "これは本当に素晴らしい。私は従うべきだ"}, {"type": "subtitle", "time": 5496.47, "timestamp": "01:31:36", "text": "これら。私はこれに従うべきだ。そうするべきです。"}, {"type": "subtitle", "time": 5498.35, "timestamp": "01:31:38", "text": "フォローする"}]
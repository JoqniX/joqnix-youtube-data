[{"type": "subtitle", "time": 17894.43, "timestamp": "04:58:14", "text": "[音楽]"}, {"type": "subtitle", "time": 17897.788, "timestamp": "04:58:17", "text": "H. 修正する必要がある"}, {"type": "subtitle", "time": 17900.868, "timestamp": "04:58:20", "text": "ビート。タピオカミルクティーって知ってますか？私"}, {"type": "subtitle", "time": 17905.11, "timestamp": "04:58:25", "text": "聞いたことがある。私自身は経験したことがない。"}, {"type": "subtitle", "time": 17909.23, "timestamp": "04:58:29", "text": "えっと、初めてタピオカドリンクを飲んだ"}, {"type": "subtitle", "time": 17912.51, "timestamp": "04:58:32", "text": "先月。"}, {"type": "subtitle", "time": 17915.708, "timestamp": "04:58:35", "text": "ええ、飲みました"}, {"type": "subtitle", "time": 17919.83, "timestamp": "04:58:39", "text": "タピオカ。えっと、何だったかな？それ"}, {"type": "subtitle", "time": 17921.55, "timestamp": "04:58:41", "text": "は"}, {"type": "subtitle", "time": 17924.67, "timestamp": "04:58:44", "text": "ストロベリーポッピング"}, {"type": "subtitle", "time": 17927.39, "timestamp": "04:58:47", "text": "タピオカドリンクとか、そんな感じのもの。"}, {"type": "subtitle", "time": 17930.15, "timestamp": "04:58:50", "text": "うん。うん。うん。うん。うん。うん。私 私"}]
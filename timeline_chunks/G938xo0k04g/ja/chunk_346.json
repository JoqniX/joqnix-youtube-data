[{"type": "subtitle", "time": 20761.57, "timestamp": "05:46:01", "text": "これ。それで"}, {"type": "subtitle", "time": 20764.59, "timestamp": "05:46:04", "text": "[拍手]"}, {"type": "subtitle", "time": 20768.27, "timestamp": "05:46:08", "text": "ああ、あと一晩生き延びなきゃならないんだ。"}, {"type": "subtitle", "time": 20778.03, "timestamp": "05:46:18", "text": "右。私はもう眠くなってきて"}, {"type": "subtitle", "time": 20781.19, "timestamp": "05:46:21", "text": "疲れた。たった1時間です。私が"}, {"type": "subtitle", "time": 20784.11, "timestamp": "05:46:24", "text": "全く眠れない"}, {"type": "subtitle", "time": 20787.788, "timestamp": "05:46:27", "text": "日？わからない。それは それは"}, {"type": "subtitle", "time": 20790.31, "timestamp": "05:46:30", "text": "大丈夫。昨日みたいにね？あなた"}, {"type": "subtitle", "time": 20792.39, "timestamp": "05:46:32", "text": "私が言っていたように、"}, {"type": "subtitle", "time": 20795.19, "timestamp": "05:46:35", "text": "吐き気がして、とても気分が悪い"}, {"type": "subtitle", "time": 20797.99, "timestamp": "05:46:37", "text": "病気。ええ、今日も同じ気持ちです"}, {"type": "subtitle", "time": 20800.628, "timestamp": "05:46:40", "text": "良い。つまり、主に"}, {"type": "subtitle", "time": 20801.868, "timestamp": "05:46:41", "text": "のため"}, {"type": "subtitle", "time": 20805.15, "timestamp": "05:46:45", "text": "睡眠のこと 睡眠"}, {"type": "subtitle", "time": 20807.43, "timestamp": "05:46:47", "text": "問題。必要な時間を宣言してください"}, {"type": "subtitle", "time": 20808.868, "timestamp": "05:46:48", "text": "それを完成させてください。絶対にそれだけの価値があります。"}, {"type": "subtitle", "time": 20810.868, "timestamp": "05:46:50", "text": "うん。うん。うん。うん。私は実際"}, {"type": "subtitle", "time": 20813.35, "timestamp": "05:46:53", "text": "12時間も考え続けるなんて"}]
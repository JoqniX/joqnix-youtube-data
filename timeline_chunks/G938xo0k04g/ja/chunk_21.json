[{"type": "subtitle", "time": 1283.51, "timestamp": "00:21:23", "text": "それはあなたに何をもたらすのか"}, {"type": "subtitle", "time": 1286.83, "timestamp": "00:21:26", "text": "間違った人気"}, {"type": "subtitle", "time": 1291.149, "timestamp": "00:21:31", "text": "もの？人々はそのことであなたを覚えているでしょう"}, {"type": "subtitle", "time": 1293.51, "timestamp": "00:21:33", "text": "もの。では、どうやってそれらを作るのですか？"}, {"type": "subtitle", "time": 1302.31, "timestamp": "00:21:42", "text": "右。否定的なことをするのではなく"}, {"type": "subtitle", "time": 1304.71, "timestamp": "00:21:44", "text": "良いことだ、ポジティブなことをするのは良いことだ"}]
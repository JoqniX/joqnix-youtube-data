[{"type": "subtitle", "time": 11821.75, "timestamp": "03:17:01", "text": "これ。"}, {"type": "subtitle", "time": 11825.229, "timestamp": "03:17:05", "text": "あなたの同僚は私は"}, {"type": "subtitle", "time": 11831.07, "timestamp": "03:17:11", "text": "いいえ。"}, {"type": "subtitle", "time": 11834.11, "timestamp": "03:17:14", "text": "おおおお"}, {"type": "subtitle", "time": 11837.87, "timestamp": "03:17:17", "text": "いいえ。何？何？何？何？おお"}, {"type": "subtitle", "time": 11844.83, "timestamp": "03:17:24", "text": "ケトル。"}, {"type": "subtitle", "time": 11847.17, "timestamp": "03:17:27", "text": "えっと、私はこれをやりたくない"}, {"type": "subtitle", "time": 11848.51, "timestamp": "03:17:28", "text": "[音楽]"}, {"type": "subtitle", "time": 11851.429, "timestamp": "03:17:31", "text": "また。ああ。だから、私の"}, {"type": "subtitle", "time": 11855.79, "timestamp": "03:17:35", "text": "インスピレーションは良いものです。待って、えっと、ちょっと待って"}, {"type": "subtitle", "time": 11859.309, "timestamp": "03:17:39", "text": "大邸宅と"}, {"type": "subtitle", "time": 11861.229, "timestamp": "03:17:41", "text": "1"}, {"type": "subtitle", "time": 11863.07, "timestamp": "03:17:43", "text": "おお"}, {"type": "subtitle", "time": 11878.15, "timestamp": "03:17:58", "text": "ええと、上の階ですね。できますか"}]
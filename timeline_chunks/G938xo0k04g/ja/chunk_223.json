[{"type": "subtitle", "time": 13383.15, "timestamp": "03:43:03", "text": "追跡。私はただ利用しなければならない"}, {"type": "subtitle", "time": 13385.229, "timestamp": "03:43:05", "text": "の"}, {"type": "subtitle", "time": 13388.07, "timestamp": "03:43:08", "text": "シンセサイザー。だから私はウェーブテーブルを使う"}, {"type": "subtitle", "time": 13390.87, "timestamp": "03:43:10", "text": "もしくは、私は美容液を使います。今のところは、"}, {"type": "subtitle", "time": 13394.429, "timestamp": "03:43:14", "text": "Abletonのウェーブテーブルのみ"}, {"type": "subtitle", "time": 13397.51, "timestamp": "03:43:17", "text": "生きていくことで、どのようにすれば良いかを知ることができる"}, {"type": "subtitle", "time": 13402.99, "timestamp": "03:43:22", "text": "すべて。する"}, {"type": "subtitle", "time": 13407.389, "timestamp": "03:43:27", "text": "それと、そして"}, {"type": "subtitle", "time": 13411.59, "timestamp": "03:43:31", "text": "そうすれば、アップテンポのメロディーを作らなければならない"}, {"type": "subtitle", "time": 13414.03, "timestamp": "03:43:34", "text": "メロディーがなくても大丈夫です。これ"}, {"type": "subtitle", "time": 13417.95, "timestamp": "03:43:37", "text": "ベースラインコード いくつかのコード"}, {"type": "subtitle", "time": 13421.59, "timestamp": "03:43:41", "text": "ベースとなるメロディーは後で調整できます。"}, {"type": "subtitle", "time": 13424.63, "timestamp": "03:43:44", "text": "えーと、基本的なことは、"}, {"type": "subtitle", "time": 13428.469, "timestamp": "03:43:48", "text": "弦を弾く方法、ベースの作り方、"}, {"type": "subtitle", "time": 13432.79, "timestamp": "03:43:52", "text": "LFOツールの使い方"}, {"type": "subtitle", "time": 13434.91, "timestamp": "03:43:54", "text": "封筒"}, {"type": "subtitle", "time": 13437.429, "timestamp": "03:43:57", "text": "自動化と、その中のすべて"}, {"type": "subtitle", "time": 13439.87, "timestamp": "03:43:59", "text": "波形テーブルまたは"}]
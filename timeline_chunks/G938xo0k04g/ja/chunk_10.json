[{"type": "subtitle", "time": 600.35, "timestamp": "00:10:00", "text": "大丈夫。えっと、覚えておいてください"}, {"type": "subtitle", "time": 602.35, "timestamp": "00:10:02", "text": "大丈夫。"}, {"type": "subtitle", "time": 605.91, "timestamp": "00:10:05", "text": "えっと、あと6人メンバーが必要なんですが、10人編成にしたいんです。"}, {"type": "subtitle", "time": 607.15, "timestamp": "00:10:07", "text": "絵文字。"}, {"type": "subtitle", "time": 609.63, "timestamp": "00:10:09", "text": "H"}, {"type": "subtitle", "time": 613.43, "timestamp": "00:10:13", "text": "大丈夫。それはメンバーの利益に依存するのか"}, {"type": "subtitle", "time": 616.15, "timestamp": "00:10:16", "text": "または総メンバー数、またはメンバー数のようなものですか？"}, {"type": "subtitle", "time": 619.67, "timestamp": "00:10:19", "text": "1ヶ月で数ポイントの利益を得る"}, {"type": "subtitle", "time": 622.35, "timestamp": "00:10:22", "text": "メンバーシップの絵文字"}, {"type": "subtitle", "time": 630.19, "timestamp": "00:10:30", "text": "はぁ？君には決して分からないだろう、私は"}, {"type": "subtitle", "time": 632.55, "timestamp": "00:10:32", "text": "推測。私だけでしょうか、それともあなたはただのエビでしょうか？"}]
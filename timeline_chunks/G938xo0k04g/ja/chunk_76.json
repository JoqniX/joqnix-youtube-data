[{"type": "subtitle", "time": 4562.149, "timestamp": "01:16:02", "text": "えっと、感じられますか、認識できますか"}, {"type": "subtitle", "time": 4564.95, "timestamp": "01:16:04", "text": "目が覚めたばかりで疲れている、"}, {"type": "subtitle", "time": 4567.03, "timestamp": "01:16:07", "text": "何かあるけど、何人かの人が"}, {"type": "subtitle", "time": 4570.63, "timestamp": "01:16:10", "text": "自分の声が疲れているかどうかを聞き分けることができる。"}, {"type": "subtitle", "time": 4573.59, "timestamp": "01:16:13", "text": "あなたは簡単に認識できるでしょう"}, {"type": "subtitle", "time": 4576.47, "timestamp": "01:16:16", "text": "ああ、騎手は疲れている。なぜそんなに"}, {"type": "subtitle", "time": 4578.63, "timestamp": "01:16:18", "text": "疲れているのか何か？しかし私自身は"}, {"type": "subtitle", "time": 4580.43, "timestamp": "01:16:20", "text": "認識する"}, {"type": "subtitle", "time": 4585.63, "timestamp": "01:16:25", "text": "なぜそうなっているのか？待って、私は"}, {"type": "subtitle", "time": 4588.55, "timestamp": "01:16:28", "text": "待って、考えたくない、私は"}, {"type": "subtitle", "time": 4591.189, "timestamp": "01:16:31", "text": "そんな感じ。方法。私は"}, {"type": "subtitle", "time": 4593.91, "timestamp": "01:16:33", "text": "でも、音楽は作り続ける。それが問題なら"}, {"type": "subtitle", "time": 4597.27, "timestamp": "01:16:37", "text": "それは私の音楽制作を制限することになるだろう。おお"}, {"type": "chat", "time": 4598.127, "timestamp": "01:16:38", "author": "@AerinViolet", "avatar": "https://yt4.ggpht.com/UKawanVvntNiAwz6RWv6wPk_S8YwApvPcCfLApO-du_RbQRIPGtzJ5FTt1DCNmZFJWc_2vxlqw=s64-c-k-c0x00ffffff-no-rj", "message": "yes, I can (rn at least)"}, {"type": "subtitle", "time": 4603.87, "timestamp": "01:16:43", "text": "悪い。音声を録音する必要がある"}, {"type": "subtitle", "time": 4606.83, "timestamp": "01:16:46", "text": "テスト。音声テストを行う必要があります。"}, {"type": "subtitle", "time": 4610.99, "timestamp": "01:16:50", "text": "耳を鍛えるような何か"}, {"type": "subtitle", "time": 4613.99, "timestamp": "01:16:53", "text": "自分自身。ああ、大変だ。"}, {"type": "subtitle", "time": 4616.229, "timestamp": "01:16:56", "text": "でも、今日はどんなことがあっても"}, {"type": "subtitle", "time": 4619.91, "timestamp": "01:16:59", "text": "試合日程1には手をつけない。私達はします"}]
[{"type": "subtitle", "time": 9180.15, "timestamp": "02:33:00", "text": "推測。不気味な奴がいる。クリーパー。おお、"}, {"type": "subtitle", "time": 9181.55, "timestamp": "02:33:01", "text": "主。"}, {"type": "subtitle", "time": 9184.389, "timestamp": "02:33:04", "text": "ニース。爆発しなくて本当に良かった"}, {"type": "subtitle", "time": 9191.27, "timestamp": "02:33:11", "text": "それがどんな結果になっていたか想像してみてください。では、どのように"}, {"type": "subtitle", "time": 9195.67, "timestamp": "02:33:15", "text": "そのボートは動くのか？だから私は自分のやり方で"}, {"type": "subtitle", "time": 9197.59, "timestamp": "02:33:17", "text": "これを理解すると、私は落ちて"}, {"type": "subtitle", "time": 9201.469, "timestamp": "02:33:21", "text": "これを置いてから右クリックします"}, {"type": "subtitle", "time": 9207.79, "timestamp": "02:33:27", "text": "それ。右を押して"}, {"type": "subtitle", "time": 9211.63, "timestamp": "02:33:31", "text": "クリック。私にできますか？それは"}, {"type": "subtitle", "time": 9214.91, "timestamp": "02:33:34", "text": "質問。見てみましょう。考えてみましょう"}, {"type": "subtitle", "time": 9218.469, "timestamp": "02:33:38", "text": "外。右クリックして配置してください。右"}, {"type": "subtitle", "time": 9220.15, "timestamp": "02:33:40", "text": "クリックして配置してください。そして去った。右、"}, {"type": "subtitle", "time": 9223.91, "timestamp": "02:33:43", "text": "左。つまり、ほんの一瞬のことです。"}, {"type": "subtitle", "time": 9225.79, "timestamp": "02:33:45", "text": "入力。あなたには"}, {"type": "subtitle", "time": 9227.63, "timestamp": "02:33:47", "text": "好き"}, {"type": "subtitle", "time": 9229.91, "timestamp": "02:33:49", "text": "これ。いや、待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 9236.19, "timestamp": "02:33:56", "text": "仕事。待って、待って、待って。私にさせて"}, {"type": "subtitle", "time": 9239.23, "timestamp": "02:33:59", "text": "練習する。ああ、"}]
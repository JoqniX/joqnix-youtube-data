[{"type": "subtitle", "time": 4622.87, "timestamp": "01:17:02", "text": "集中しないといけないから、"}, {"type": "subtitle", "time": 4624.11, "timestamp": "01:17:04", "text": "授業に出席する"}, {"type": "subtitle", "time": 4627.31, "timestamp": "01:17:07", "text": "今日と"}, {"type": "subtitle", "time": 4629.83, "timestamp": "01:17:09", "text": "すべて、たくさんのこと。それに、"}, {"type": "subtitle", "time": 4631.99, "timestamp": "01:17:11", "text": "父が家にいないので、私は"}, {"type": "subtitle", "time": 4633.83, "timestamp": "01:17:13", "text": "今日は私の家族の面倒を見てください。えっと、"}, {"type": "subtitle", "time": 4635.35, "timestamp": "01:17:15", "text": "すべて。確認しなければならない"}, {"type": "subtitle", "time": 4638.149, "timestamp": "01:17:18", "text": "すべて完了しました。猫に食べ物を与える"}, {"type": "subtitle", "time": 4641.99, "timestamp": "01:17:21", "text": "しかし、犬は行き、すべてが"}, {"type": "subtitle", "time": 4644.39, "timestamp": "01:17:24", "text": "祖母や母も同様"}, {"type": "subtitle", "time": 4646.75, "timestamp": "01:17:26", "text": "そして全て。私が面倒を見ます"}, {"type": "subtitle", "time": 4652.11, "timestamp": "01:17:32", "text": "それ。うん。そして今は午後だ。私が行きます"}, {"type": "subtitle", "time": 4655.669, "timestamp": "01:17:35", "text": "食べる。まだ昼食をとっていないなら、"}, {"type": "subtitle", "time": 4657.79, "timestamp": "01:17:37", "text": "ミナ、ご飯を食べてきて。"}, {"type": "subtitle", "time": 4659.55, "timestamp": "01:17:39", "text": "わかった。行く"}, {"type": "subtitle", "time": 4662.47, "timestamp": "01:17:42", "text": "食べる。お湯を補充する必要がある"}, {"type": "subtitle", "time": 4664.03, "timestamp": "01:17:44", "text": "の"}, {"type": "subtitle", "time": 4668.43, "timestamp": "01:17:48", "text": "フラスコ。そしてこのテーマフラスコを手に入れて"}, {"type": "subtitle", "time": 4670.51, "timestamp": "01:17:50", "text": "水"}, {"type": "subtitle", "time": 4673.47, "timestamp": "01:17:53", "text": "休む。"}]
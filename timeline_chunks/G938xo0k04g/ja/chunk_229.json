[{"type": "subtitle", "time": 13742.389, "timestamp": "03:49:02", "text": "そういうのもあるけど、それにハマってるんだ"}, {"type": "subtitle", "time": 13745.79, "timestamp": "03:49:05", "text": "試合を1試合予定する。なぜ私は"}, {"type": "subtitle", "time": 13748.08, "timestamp": "03:49:08", "text": "中毒？"}, {"type": "subtitle", "time": 13750.03, "timestamp": "03:49:10", "text": "[音楽]"}, {"type": "subtitle", "time": 13753.11, "timestamp": "03:49:13", "text": "うん。それは、私が"}, {"type": "subtitle", "time": 13755.67, "timestamp": "03:49:15", "text": "Minecraft の内部が Minecraft の場合"}, {"type": "subtitle", "time": 13757.75, "timestamp": "03:49:17", "text": "アストロズによるイベントが開催されました。"}, {"type": "subtitle", "time": 13759.99, "timestamp": "03:49:19", "text": "アストロズのイベントですよね？出産を台無しにする。いつ"}, {"type": "subtitle", "time": 13762.389, "timestamp": "03:49:22", "text": "それが起こっていたとき、私はとても夢中になって"}, {"type": "subtitle", "time": 13765.99, "timestamp": "03:49:25", "text": "マインクラフト。私はもっ​​と一生懸命頑張って"}, {"type": "subtitle", "time": 13769.189, "timestamp": "03:49:29", "text": "毎晩より難しくなり、普段とは違う睡眠をとる"}, {"type": "subtitle", "time": 13771.269, "timestamp": "03:49:31", "text": "時間もかかるし、スケジュールも狂ってしまう。そして"}, {"type": "subtitle", "time": 13774.389, "timestamp": "03:49:34", "text": "このゲームが発売されて、私はこう思う。"}, {"type": "subtitle", "time": 13777.15, "timestamp": "03:49:37", "text": "ああ、とても良くて、挽くのが楽しい"}, {"type": "subtitle", "time": 13783.429, "timestamp": "03:49:43", "text": "でも、それを楽しめているのは良いことだ"}, {"type": "subtitle", "time": 13787.269, "timestamp": "03:49:47", "text": "ゲームではなく、燃え尽き症候群を感じるのではなく。"}, {"type": "subtitle", "time": 13789.59, "timestamp": "03:49:49", "text": "私は徐々に"}, {"type": "subtitle", "time": 13794.229, "timestamp": "03:49:54", "text": "スケジュール1から燃え尽きたのは、"}]
[{"type": "subtitle", "time": 21608.27, "timestamp": "06:00:08", "text": "ガソリンの場合"}, {"type": "subtitle", "time": 21611.07, "timestamp": "06:00:11", "text": "62. 私は"}, {"type": "subtitle", "time": 21613.31, "timestamp": "06:00:13", "text": "時計。武器"}, {"type": "subtitle", "time": 21623.43, "timestamp": "06:00:23", "text": "ジョグはプロのホラーの仕事を始めた"}, {"type": "subtitle", "time": 21625.27, "timestamp": "06:00:25", "text": "これが私で、ジョギングは"}, {"type": "subtitle", "time": 21627.59, "timestamp": "06:00:27", "text": "幽霊の町で幽霊を退治する"}, {"type": "subtitle", "time": 21633.47, "timestamp": "06:00:33", "text": "1"}, {"type": "subtitle", "time": 21636.12, "timestamp": "06:00:36", "text": "願い"}, {"type": "subtitle", "time": 21641.31, "timestamp": "06:00:41", "text": "もっと"}, {"type": "subtitle", "time": 21645.51, "timestamp": "06:00:45", "text": "痛み、長い戦い、武器のために"}, {"type": "subtitle", "time": 21648.868, "timestamp": "06:00:48", "text": "パーツパーツのようなものですね、わかりました、分割します"}, {"type": "subtitle", "time": 21651.03, "timestamp": "06:00:51", "text": "武器用のセパレーターと"}, {"type": "subtitle", "time": 21654.23, "timestamp": "06:00:54", "text": "もの。だから、雑誌を手に入れなければならない。"}, {"type": "subtitle", "time": 21657.15, "timestamp": "06:00:57", "text": "フレーム、その他諸々を組み立てて"}, {"type": "subtitle", "time": 21659.788, "timestamp": "06:00:59", "text": "拳銃またはライフルまたは"}]
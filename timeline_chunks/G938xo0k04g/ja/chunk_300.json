[{"type": "subtitle", "time": 18011.51, "timestamp": "05:00:11", "text": "あなたはNBAを見ますか？いえ、違います。私は"}, {"type": "subtitle", "time": 18016.628, "timestamp": "05:00:16", "text": "昔はNBAの試合をよくやっていた"}, {"type": "subtitle", "time": 18020.27, "timestamp": "05:00:20", "text": "子供だけど、NBA 2K12 のようなゲームなら、"}, {"type": "subtitle", "time": 18022.07, "timestamp": "05:00:22", "text": "覚えて。うん。うん。うん。の"}, {"type": "subtitle", "time": 18025.75, "timestamp": "05:00:25", "text": "バスケットボールの試合。とても楽しかった。そして私の"}, {"type": "subtitle", "time": 18030.75, "timestamp": "05:00:30", "text": "えっと、好きなチームは"}, {"type": "subtitle", "time": 18033.35, "timestamp": "05:00:33", "text": "ケリチ。待って、それはサッカーのことですか、それとも"}, {"type": "subtitle", "time": 18034.708, "timestamp": "05:00:34", "text": "バスケットボール関連のこと？そうですね、"}, {"type": "subtitle", "time": 18036.91, "timestamp": "05:00:36", "text": "ケリチ。緑"}, {"type": "subtitle", "time": 18042.708, "timestamp": "05:00:42", "text": "1つ。ええと、でも私は以前はええ。キャスまたは"}, {"type": "subtitle", "time": 18044.788, "timestamp": "05:00:44", "text": "何か。うん。うん。うん。私は"}, {"type": "subtitle", "time": 18047.15, "timestamp": "05:00:47", "text": "古いもの"}, {"type": "subtitle", "time": 18055.31, "timestamp": "05:00:55", "text": "ゲーム。私は見ません"}, {"type": "subtitle", "time": 18057.23, "timestamp": "05:00:57", "text": "スポーツ"}]
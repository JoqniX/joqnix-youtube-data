[{"type": "subtitle", "time": 13800.469, "timestamp": "03:50:00", "text": "多くの。そして、まだ"}, {"type": "subtitle", "time": 13804.269, "timestamp": "03:50:04", "text": "高レベルをアンロック"}, {"type": "subtitle", "time": 13807.03, "timestamp": "03:50:07", "text": "場所を補充する必要がある"}, {"type": "subtitle", "time": 13810.07, "timestamp": "03:50:10", "text": "たくさんの物資を供給している。でも私は言った"}, {"type": "subtitle", "time": 13812.469, "timestamp": "03:50:12", "text": "私は今日はゲームを開きません"}, {"type": "subtitle", "time": 13815.91, "timestamp": "03:50:15", "text": "私が音楽のプロとしての仕事を終えるまで、"}, {"type": "subtitle", "time": 13818.79, "timestamp": "03:50:18", "text": "今日の宿題。そして今日"}, {"type": "subtitle", "time": 13821.429, "timestamp": "03:50:21", "text": "授業は実際に行われます。だから私たちは"}, {"type": "subtitle", "time": 13826.03, "timestamp": "03:50:26", "text": "私たちが何をしたかを記録しています"}, {"type": "subtitle", "time": 13829.59, "timestamp": "03:50:29", "text": "4時30分。ええ、1～2時間後"}, {"type": "subtitle", "time": 13832.63, "timestamp": "03:50:32", "text": "5分か10分で何か作った"}, {"type": "subtitle", "time": 13835.03, "timestamp": "03:50:35", "text": "分、ほら、音楽制作、"}, {"type": "subtitle", "time": 13837.03, "timestamp": "03:50:37", "text": "文字通り5分くらいで物を作ることができる"}, {"type": "subtitle", "time": 13838.91, "timestamp": "03:50:38", "text": "数分または10分ではなく"}, {"type": "subtitle", "time": 13840.67, "timestamp": "03:50:40", "text": "1"}, {"type": "subtitle", "time": 13844.469, "timestamp": "03:50:44", "text": "マグの流れを知っているなら、tund のように。それで、"}, {"type": "subtitle", "time": 13847.91, "timestamp": "03:50:47", "text": "だから、私は「うん、できるってわかってる」って感じ"}, {"type": "subtitle", "time": 13851.309, "timestamp": "03:50:51", "text": "それ。だから、私はいくつか作ります"}, {"type": "subtitle", "time": 13854.229, "timestamp": "03:50:54", "text": "少なくとも聴けるもの。"}, {"type": "subtitle", "time": 13857.67, "timestamp": "03:50:57", "text": "わかった。そして、今日中に提出します。だから私は"}, {"type": "subtitle", "time": 13859.67, "timestamp": "03:50:59", "text": "それについてフィードバックをもらって、"}]
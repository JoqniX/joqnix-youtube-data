[{"type": "subtitle", "time": 21842.37, "timestamp": "06:04:02", "text": "斧の刃。シャベル"}, {"type": "subtitle", "time": 21862.708, "timestamp": "06:04:22", "text": "彼？たとえこれらのアイテムすべてが"}, {"type": "subtitle", "time": 21865.27, "timestamp": "06:04:25", "text": "価値に関するもの。何てことだ。だから私は"}, {"type": "subtitle", "time": 21867.6, "timestamp": "06:04:27", "text": "彼らにそれを買ってあげることはできない"}, {"type": "subtitle", "time": 21874.91, "timestamp": "06:04:34", "text": "[音楽]"}, {"type": "subtitle", "time": 21897.75, "timestamp": "06:04:57", "text": "私が彼に頼んだらどうなる？だから私は見たい"}]
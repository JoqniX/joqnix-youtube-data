[{"type": "subtitle", "time": 17770.55, "timestamp": "04:56:10", "text": "これ？今はただこれを追加できるだけです"}, {"type": "subtitle", "time": 17773.47, "timestamp": "04:56:13", "text": "リバーブはこっちに。私はそうすべきだと思う"}, {"type": "subtitle", "time": 17782.32, "timestamp": "04:56:22", "text": "送信。"}, {"type": "subtitle", "time": 17801.47, "timestamp": "04:56:41", "text": "[音楽]"}, {"type": "subtitle", "time": 17806.868, "timestamp": "04:56:46", "text": "ええと、そうですね。では、次は、サイドが必要です"}, {"type": "subtitle", "time": 17808.99, "timestamp": "04:56:48", "text": "鎖。右。側"}, {"type": "subtitle", "time": 17812.39, "timestamp": "04:56:52", "text": "鎖。サイドチェーン。私たちのそれは何だったっけ？"}, {"type": "subtitle", "time": 17814.43, "timestamp": "04:56:54", "text": "また？"}, {"type": "subtitle", "time": 17816.34, "timestamp": "04:56:56", "text": "コンプレッサー。着る"}, {"type": "subtitle", "time": 17817.788, "timestamp": "04:56:57", "text": "[音楽]"}]
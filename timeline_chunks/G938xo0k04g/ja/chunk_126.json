[{"type": "subtitle", "time": 7572.109, "timestamp": "02:06:12", "text": "ああ、これ"}, {"type": "subtitle", "time": 7576.189, "timestamp": "02:06:16", "text": "そこがあなたの拠点です。の"}, {"type": "subtitle", "time": 7580.47, "timestamp": "02:06:20", "text": "バンカー。ニース。水槽を作りたい"}, {"type": "subtitle", "time": 7584.43, "timestamp": "02:06:24", "text": "このような。すごくかっこいい。でも行かないで"}, {"type": "subtitle", "time": 7592.55, "timestamp": "02:06:32", "text": "これは一体何なのか"}, {"type": "subtitle", "time": 7596.109, "timestamp": "02:06:36", "text": "えーと、ヤク・ファラムとか墓場とか"}, {"type": "subtitle", "time": 7603.589, "timestamp": "02:06:43", "text": "場所。ああ、まだあるよ。あなたに"}, {"type": "subtitle", "time": 7606.35, "timestamp": "02:06:46", "text": "気にしないで"}, {"type": "subtitle", "time": 7609.47, "timestamp": "02:06:49", "text": "スコリ。ネザーがある"}, {"type": "subtitle", "time": 7616.38, "timestamp": "02:06:56", "text": "おお。"}, {"type": "subtitle", "time": 7619.79, "timestamp": "02:06:59", "text": "[笑い]"}]
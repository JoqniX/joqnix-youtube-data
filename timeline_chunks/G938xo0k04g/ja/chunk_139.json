[{"type": "subtitle", "time": 8340.07, "timestamp": "02:19:00", "text": "えっと、それと似ているんですね。待って、"}, {"type": "subtitle", "time": 8342.19, "timestamp": "02:19:02", "text": "誰かが"}, {"type": "subtitle", "time": 8344.99, "timestamp": "02:19:04", "text": "それをオフにする"}, {"type": "subtitle", "time": 8348.389, "timestamp": "02:19:08", "text": "そんな感じだ。報告書にスプレーするだけで"}, {"type": "subtitle", "time": 8350.19, "timestamp": "02:19:10", "text": "遊ぶ。"}, {"type": "subtitle", "time": 8352.11, "timestamp": "02:19:12", "text": "こんにちは。待って、"}, {"type": "subtitle", "time": 8356.75, "timestamp": "02:19:16", "text": "待って。 「あれはどこ？」をやらせてください"}, {"type": "subtitle", "time": 8360.11, "timestamp": "02:19:20", "text": "ベッド？ああ、彼は"}, {"type": "subtitle", "time": 8362.95, "timestamp": "02:19:22", "text": "亡くなった。ああ、神様、撃たれる。何が"}, {"type": "subtitle", "time": 8366.469, "timestamp": "02:19:26", "text": "野良犬？あの野良男は誰だ？一度もない"}, {"type": "subtitle", "time": 8369.509, "timestamp": "02:19:29", "text": "以前彼に会ったことがある。何だって？待って、これは"}, {"type": "subtitle", "time": 8371.549, "timestamp": "02:19:31", "text": "紐を上に"}, {"type": "subtitle", "time": 8375.389, "timestamp": "02:19:35", "text": "人？ああ、主よ、"}, {"type": "subtitle", "time": 8383.83, "timestamp": "02:19:43", "text": "お願いします。どこかで寝る。誰かが寝ている。"}, {"type": "subtitle", "time": 8386.589, "timestamp": "02:19:46", "text": "ベッドはありません。誰がベッドを移動させたのか"}, {"type": "subtitle", "time": 8397.51, "timestamp": "02:19:57", "text": "えっと、ベッド。これは何ですか？わかった。ベッド。"}, {"type": "subtitle", "time": 8399.23, "timestamp": "02:19:59", "text": "ああ、"}]
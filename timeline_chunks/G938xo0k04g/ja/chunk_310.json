[{"type": "subtitle", "time": 18602.628, "timestamp": "05:10:02", "text": "私のマンゴーの木はまるで"}, {"type": "subtitle", "time": 18606.18, "timestamp": "05:10:06", "text": "クレイジー。まるで"}, {"type": "subtitle", "time": 18608.67, "timestamp": "05:10:08", "text": "[音楽]"}, {"type": "subtitle", "time": 18614.91, "timestamp": "05:10:14", "text": "震えている。その"}, {"type": "subtitle", "time": 18619.15, "timestamp": "05:10:19", "text": "風が強い。木々が揺れているので"}, {"type": "subtitle", "time": 18622.47, "timestamp": "05:10:22", "text": "制御不能に。何てことだ。私は聞こえる"}, {"type": "subtitle", "time": 18626.03, "timestamp": "05:10:26", "text": "風を感じることができます"}, {"type": "subtitle", "time": 18628.868, "timestamp": "05:10:28", "text": "外。わかった。封筒もね。わかった。"}, {"type": "subtitle", "time": 18633.23, "timestamp": "05:10:33", "text": "えっと、私たちはたぶん"}, {"type": "subtitle", "time": 18636.02, "timestamp": "05:10:36", "text": "これ。"}, {"type": "subtitle", "time": 18659.03, "timestamp": "05:10:59", "text": "共鳴はするが、良い音にはならないだろう。"}]
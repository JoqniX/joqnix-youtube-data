[{"type": "subtitle", "time": 10215.269, "timestamp": "02:50:15", "text": "Hは夜通し眠る。調子はどうですか"}, {"type": "subtitle", "time": 10217.03, "timestamp": "02:50:17", "text": "彼らはここにいないの？待って、全部"}, {"type": "subtitle", "time": 10224.23, "timestamp": "02:50:24", "text": "ああ、わかりました。仕事に戻ろう。いや、違う。私は"}, {"type": "subtitle", "time": 10227.429, "timestamp": "02:50:27", "text": "ごめん。話が逸れてしまった。しかし今のところ、"}, {"type": "subtitle", "time": 10230.23, "timestamp": "02:50:30", "text": "私はこれを作り、"}, {"type": "subtitle", "time": 10231.79, "timestamp": "02:50:31", "text": "国境"}, {"type": "subtitle", "time": 10233.94, "timestamp": "02:50:33", "text": "こんな感じのもの。"}, {"type": "subtitle", "time": 10235.07, "timestamp": "02:50:35", "text": "[音楽]"}, {"type": "subtitle", "time": 10238.51, "timestamp": "02:50:38", "text": "では、この穴はどうなったのか、とあなたは尋ねるかもしれません。"}, {"type": "subtitle", "time": 10242.55, "timestamp": "02:50:42", "text": "えっと、実はよくわからないんです。私はこう言う"}, {"type": "subtitle", "time": 10245.91, "timestamp": "02:50:45", "text": "とりあえず、今はこれを置いておきます。それでおしまい。のために"}]
[{"type": "subtitle", "time": 7081.51, "timestamp": "01:58:01", "text": "表面に水が一層張っているとか、そんな感じ。"}, {"type": "subtitle", "time": 7084.229, "timestamp": "01:58:04", "text": "自分が何をしようとしているのか、正直よくわからない。"}, {"type": "subtitle", "time": 7086.35, "timestamp": "01:58:06", "text": "ここで達成するには、"}, {"type": "subtitle", "time": 7090.149, "timestamp": "01:58:10", "text": "わかった。自分で料理する場所を見てみます"}, {"type": "subtitle", "time": 7094.43, "timestamp": "01:58:14", "text": "そして、これがどこにあるのか見てみましょう"}, {"type": "subtitle", "time": 7097.629, "timestamp": "01:58:17", "text": "行くよ、私は"}, {"type": "subtitle", "time": 7100.55, "timestamp": "01:58:20", "text": "推測。痛み。私は一体何をしようとしているのか"}, {"type": "subtitle", "time": 7106.149, "timestamp": "01:58:26", "text": "聖なる。"}, {"type": "subtitle", "time": 7107.99, "timestamp": "01:58:27", "text": "あ、待って。それは実際には悪くない"}, {"type": "subtitle", "time": 7110.55, "timestamp": "01:58:30", "text": "アイデア。"}, {"type": "subtitle", "time": 7112.79, "timestamp": "01:58:32", "text": "ああ、これは実際悪くないアイデアだ。"}, {"type": "subtitle", "time": 7117.109, "timestamp": "01:58:37", "text": "まるでこの物を単数形で表しているかのようだ。ああ、それは"}, {"type": "subtitle", "time": 7118.95, "timestamp": "01:58:38", "text": "実際、素晴らしいアイデアだ。待って、私は"}, {"type": "subtitle", "time": 7122.27, "timestamp": "01:58:42", "text": "すべてのサイズでそうすべきだ"}, {"type": "subtitle", "time": 7125.43, "timestamp": "01:58:45", "text": "それから。 1 2 3。 1 2 3。"}, {"type": "subtitle", "time": 7134.27, "timestamp": "01:58:54", "text": "えーと、"}, {"type": "subtitle", "time": 7138.189, "timestamp": "01:58:58", "text": "ああ、彼らはまるで集団で行動しているようだ"}]
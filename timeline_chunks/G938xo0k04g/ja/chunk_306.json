[{"type": "subtitle", "time": 18374.03, "timestamp": "05:06:14", "text": "見る。"}, {"type": "subtitle", "time": 18379.4, "timestamp": "05:06:19", "text": "えーと、オフセットがゼロか、それとも1か、どちらが良いですか？"}, {"type": "subtitle", "time": 18382.07, "timestamp": "05:06:22", "text": "[音楽]"}, {"type": "subtitle", "time": 18384.47, "timestamp": "05:06:24", "text": "ああ、自分が何をしているのか分からない。私はできません"}, {"type": "subtitle", "time": 18388.628, "timestamp": "05:06:28", "text": "私はJ-POPに焦点を当てたいのですが、J-POPは"}, {"type": "subtitle", "time": 18389.47, "timestamp": "05:06:29", "text": "それで"}, {"type": "subtitle", "time": 18392.15, "timestamp": "05:06:32", "text": "難しい。だから、私は作り方を学ばなければならない"}, {"type": "subtitle", "time": 18393.868, "timestamp": "05:06:33", "text": "基本"}, {"type": "subtitle", "time": 18397.39, "timestamp": "05:06:37", "text": "音楽。 EDMジャンル"}, {"type": "subtitle", "time": 18399.83, "timestamp": "05:06:39", "text": "音楽。私は何をしているのだろう？私は"}, {"type": "subtitle", "time": 18402.868, "timestamp": "05:06:42", "text": "知る。でも、私たちはできる"}, {"type": "subtitle", "time": 18405.07, "timestamp": "05:06:45", "text": "これについてもっと詳しく。さあ行こう"}, {"type": "subtitle", "time": 18408.15, "timestamp": "05:06:48", "text": "もっと。基本中の基本。コア"}, {"type": "subtitle", "time": 18409.36, "timestamp": "05:06:49", "text": "必需品に関するジョーク。"}, {"type": "subtitle", "time": 18411.55, "timestamp": "05:06:51", "text": "[音楽]"}, {"type": "subtitle", "time": 18414.47, "timestamp": "05:06:54", "text": "ええと、基本的な必需品ですね。基本中核。"}, {"type": "subtitle", "time": 18417.03, "timestamp": "05:06:57", "text": "基本中核。それで、ドラムセットを手に入れたんです。私たちは"}]
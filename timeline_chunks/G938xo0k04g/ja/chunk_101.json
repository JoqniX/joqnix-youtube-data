[{"type": "subtitle", "time": 6064.55, "timestamp": "01:41:04", "text": "私の値はマイナス45dBです。もう一つのシーンは"}, {"type": "subtitle", "time": 6068.87, "timestamp": "01:41:08", "text": "ゲームシーンはだいたい54dBくらいです。"}, {"type": "subtitle", "time": 6070.03, "timestamp": "01:41:10", "text": "それはまるで"}, {"type": "subtitle", "time": 6071.99, "timestamp": "01:41:11", "text": "15％。そして、あなたはプレイするつもりですか？"}, {"type": "subtitle", "time": 6074.87, "timestamp": "01:41:14", "text": "マインクラフト？サーバーを起動します。"}, {"type": "subtitle", "time": 6077.43, "timestamp": "01:41:17", "text": "頭が良い。脳。今、あなたに電話しましたか？"}, {"type": "subtitle", "time": 6079.79, "timestamp": "01:41:19", "text": "ブレイディ？何てことだ。私は"}, {"type": "subtitle", "time": 6082.99, "timestamp": "01:41:22", "text": "ごめん。ええ、お元気でいらっしゃることを願っています"}, {"type": "subtitle", "time": 6089.91, "timestamp": "01:41:29", "text": "猫。何てことだ。私はラジオに電話をかけた。おお"}, {"type": "subtitle", "time": 6092.109, "timestamp": "01:41:32", "text": "我が神よ。よし、マインクラフトは"}, {"type": "subtitle", "time": 6094.59, "timestamp": "01:41:34", "text": "ここ。"}, {"type": "subtitle", "time": 6098.39, "timestamp": "01:41:38", "text": "こんにちは。音声がおかしい場合は教えてください"}, {"type": "subtitle", "time": 6102.83, "timestamp": "01:41:42", "text": "音声が聞こえる。直しましょう"}, {"type": "subtitle", "time": 6105.149, "timestamp": "01:41:45", "text": "それ。聞こえます"}, {"type": "subtitle", "time": 6107.51, "timestamp": "01:41:47", "text": "右？名前を"}, {"type": "subtitle", "time": 6109.43, "timestamp": "01:41:49", "text": "触媒。"}, {"type": "subtitle", "time": 6112.35, "timestamp": "01:41:52", "text": "そう、これが私たちが最後にやったことです"}, {"type": "subtitle", "time": 6116.59, "timestamp": "01:41:56", "text": "時間。私の家に人が閉じ込められています。"}]
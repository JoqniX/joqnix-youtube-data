[{"type": "subtitle", "time": 6185.75, "timestamp": "01:43:05", "text": "それで、この理由で"}, {"type": "subtitle", "time": 6189.51, "timestamp": "01:43:09", "text": "この装置、システム1"}, {"type": "subtitle", "time": 6191.31, "timestamp": "01:43:11", "text": "開けるもの"}, {"type": "subtitle", "time": 6196.149, "timestamp": "01:43:16", "text": "これとこれを使って、この物を開けるんだ。"}, {"type": "subtitle", "time": 6202.03, "timestamp": "01:43:22", "text": "自分。"}, {"type": "subtitle", "time": 6205.27, "timestamp": "01:43:25", "text": "おお。ゾンビは全員ここにいる。あのね"}, {"type": "subtitle", "time": 6211.99, "timestamp": "01:43:31", "text": "眠りはそれを地中に埋めた。何てことだ。"}, {"type": "subtitle", "time": 6215.87, "timestamp": "01:43:35", "text": "あなたは悪の道を辿っている。私"}, {"type": "subtitle", "time": 6221.62, "timestamp": "01:43:41", "text": "男たちと男らしい弧を見てください"}, {"type": "subtitle", "time": 6231.669, "timestamp": "01:43:51", "text": "混乱。これでキツネは出て行ける、私は"}, {"type": "subtitle", "time": 6234.149, "timestamp": "01:43:54", "text": "推測。"}, {"type": "subtitle", "time": 6235.03, "timestamp": "01:43:55", "text": "できますか？"}]
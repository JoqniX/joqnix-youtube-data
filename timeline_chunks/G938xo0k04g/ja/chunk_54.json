[{"type": "subtitle", "time": 3242.309, "timestamp": "00:54:02", "text": "待って。これは本当に新しいアップデートですか？それで"}, {"type": "subtitle", "time": 3244.91, "timestamp": "00:54:04", "text": "プロフィールを持っている人"}, {"type": "subtitle", "time": 3248.47, "timestamp": "00:54:08", "text": "サーバー上のバナー"}, {"type": "subtitle", "time": 3252.109, "timestamp": "00:54:12", "text": "右側には、涼しいものが見えるでしょう"}, {"type": "subtitle", "time": 3255.349, "timestamp": "00:54:15", "text": "もの。待って、それは新しいアップデートだよ。待って、"}, {"type": "subtitle", "time": 3258.75, "timestamp": "00:54:18", "text": "それはすごくクールだね。待って、これを見て"}, {"type": "subtitle", "time": 3260.71, "timestamp": "00:54:20", "text": "ミナ。待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 3263.87, "timestamp": "00:54:23", "text": "待って。見て、見て、見て、見て、"}, {"type": "subtitle", "time": 3266.069, "timestamp": "00:54:26", "text": "見て。ああ、あなたはそうではない。ああ、忘れていました。そこには"}, {"type": "subtitle", "time": 3267.47, "timestamp": "00:54:27", "text": "あなたが行く。私はしません"}, {"type": "subtitle", "time": 3273.67, "timestamp": "00:54:33", "text": "ほら、そういうことだ。ほら、見て"}, {"type": "subtitle", "time": 3276.47, "timestamp": "00:54:36", "text": "これについて。これを見てください。ほら、"}, {"type": "subtitle", "time": 3281.109, "timestamp": "00:54:41", "text": "プロフィールのようなものを持っている"}, {"type": "subtitle", "time": 3283.79, "timestamp": "00:54:43", "text": "背景は、次のように表示されます。"}, {"type": "subtitle", "time": 3286.549, "timestamp": "00:54:46", "text": "右側のこれは、クールな"}, {"type": "subtitle", "time": 3290.03, "timestamp": "00:54:50", "text": "あれ。これは何ですか？これはとても"}]
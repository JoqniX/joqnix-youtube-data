[{"type": "subtitle", "time": 21721.23, "timestamp": "06:02:01", "text": "生きている？"}, {"type": "subtitle", "time": 21725.19, "timestamp": "06:02:05", "text": "何？そしてそのミスはどのようにして謎めいたものになったのか"}, {"type": "subtitle", "time": 21728.43, "timestamp": "06:02:08", "text": "人または獣または"}, {"type": "subtitle", "time": 21740.99, "timestamp": "06:02:20", "text": "[音楽]"}, {"type": "subtitle", "time": 21743.43, "timestamp": "06:02:23", "text": "ここ？あなたは暗闇を怖がらない。"}, {"type": "subtitle", "time": 21745.27, "timestamp": "06:02:25", "text": "あなたは暗闇の中にあるものが怖いのです。午前"}, {"type": "subtitle", "time": 21746.51, "timestamp": "06:02:26", "text": "私"}, {"type": "subtitle", "time": 21748.75, "timestamp": "06:02:28", "text": "正しい？"}, {"type": "subtitle", "time": 21751.59, "timestamp": "06:02:31", "text": "うん。それは、"}, {"type": "subtitle", "time": 21778.35, "timestamp": "06:02:58", "text": "うん。うん。発電機用の燃料が必要です。"}]
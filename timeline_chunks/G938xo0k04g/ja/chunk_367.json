[{"type": "subtitle", "time": 22023.35, "timestamp": "06:07:03", "text": "いくつか仕上げなければならないことがあるんです"}, {"type": "subtitle", "time": 22025.47, "timestamp": "06:07:05", "text": "OBSと共に"}, {"type": "subtitle", "time": 22029.59, "timestamp": "06:07:09", "text": "OBSとかTwitterとか、そういうの全部"}, {"type": "subtitle", "time": 22032.708, "timestamp": "06:07:12", "text": "あれらのこと。うん。うん。うん。ああ、そうだね。"}, {"type": "subtitle", "time": 22035.47, "timestamp": "06:07:15", "text": "おそらく私はストリーミング配信します"}, {"type": "subtitle", "time": 22039.07, "timestamp": "06:07:19", "text": "後でTwitchで"}, {"type": "subtitle", "time": 22041.83, "timestamp": "06:07:21", "text": "夕方または夜。ああ、夜になる前に"}, {"type": "subtitle", "time": 22047.43, "timestamp": "06:07:27", "text": "期間。うん。ええと、いつものように、ええと"}, {"type": "subtitle", "time": 22049.51, "timestamp": "06:07:29", "text": "スケジュールとか全部"}, {"type": "subtitle", "time": 22052.27, "timestamp": "06:07:32", "text": "すべてのソーシャルメディアで利用可能"}, {"type": "subtitle", "time": 22055.19, "timestamp": "06:07:35", "text": "プラットフォーム。えっと、それから明日の配信も"}, {"type": "subtitle", "time": 22058.628, "timestamp": "06:07:38", "text": "買い物リスト"}, {"type": "subtitle", "time": 22061.59, "timestamp": "06:07:41", "text": "これはインディーホラーゲームです。私たちは"}, {"type": "subtitle", "time": 22066.39, "timestamp": "06:07:46", "text": "午前11時に配信します。"}, {"type": "subtitle", "time": 22068.07, "timestamp": "06:07:48", "text": "今日の配信と昨日の配信"}, {"type": "subtitle", "time": 22071.75, "timestamp": "06:07:51", "text": "午前10時30分でした。ええ、そうですね。"}, {"type": "subtitle", "time": 22075.35, "timestamp": "06:07:55", "text": "30分、ええ、30分くらいですね"}, {"type": "subtitle", "time": 22078.47, "timestamp": "06:07:58", "text": "今日から数分遅れている"}]
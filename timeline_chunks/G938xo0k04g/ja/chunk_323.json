[{"type": "subtitle", "time": 19384.07, "timestamp": "05:23:04", "text": "[音楽]"}, {"type": "subtitle", "time": 19387.59, "timestamp": "05:23:07", "text": "ビートしか聞こえなかった。私はいつも下手です"}, {"type": "subtitle", "time": 19399.83, "timestamp": "05:23:19", "text": "ええ、それが問題なんです。私が"}, {"type": "subtitle", "time": 19404.45, "timestamp": "05:23:24", "text": "自分のこと、私は"}, {"type": "subtitle", "time": 19407.39, "timestamp": "05:23:27", "text": "[音楽]"}, {"type": "subtitle", "time": 19411.11, "timestamp": "05:23:31", "text": "ドラム。 4時45分になります。えっと、私たちは"}, {"type": "subtitle", "time": 19414.15, "timestamp": "05:23:34", "text": "これを締めくくって録音を始めよう"}, {"type": "subtitle", "time": 19420.03, "timestamp": "05:23:40", "text": "私の"}, {"type": "subtitle", "time": 19424.67, "timestamp": "05:23:44", "text": "先生。うん、今日は何かしたよ。私"}, {"type": "subtitle", "time": 19429.1, "timestamp": "05:23:49", "text": "音をいじってみた。私はできる"}, {"type": "subtitle", "time": 19431.23, "timestamp": "05:23:51", "text": "[音楽]"}, {"type": "subtitle", "time": 19434.628, "timestamp": "05:23:54", "text": "私がふざけていたと言ってください。よし、ベースは"}]
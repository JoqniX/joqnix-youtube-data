[{"type": "subtitle", "time": 9131.51, "timestamp": "02:32:11", "text": "おお。ボートの件は私に任せてください。私は決して"}, {"type": "subtitle", "time": 9138.03, "timestamp": "02:32:18", "text": "それでは私は"}, {"type": "subtitle", "time": 9141.63, "timestamp": "02:32:21", "text": "えっと、私の仕事に取り組んでいます"}, {"type": "subtitle", "time": 9146.83, "timestamp": "02:32:26", "text": "建てる。あ、こんにちは。それで、えっと、これ"}, {"type": "subtitle", "time": 9159.95, "timestamp": "02:32:39", "text": "ボートは完全に私を癒します"}, {"type": "subtitle", "time": 9163.19, "timestamp": "02:32:43", "text": "これ。完全に治癒する必要があるのですか？いいえ、"}, {"type": "subtitle", "time": 9166.71, "timestamp": "02:32:46", "text": "必要ありませんが、ただ木の棒があれば"}, {"type": "subtitle", "time": 9169.27, "timestamp": "02:32:49", "text": "おそらく、もっと多くのために必要でしょう。"}]
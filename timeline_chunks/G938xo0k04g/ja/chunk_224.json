[{"type": "subtitle", "time": 13443.269, "timestamp": "03:44:03", "text": "シンセサイザー。えーと、フィルターの使い方、"}, {"type": "subtitle", "time": 13447.59, "timestamp": "03:44:07", "text": "ローカット、ローカット、ハイカット、そういう類のもの全部。"}, {"type": "subtitle", "time": 13448.59, "timestamp": "03:44:08", "text": "手に入れた"}, {"type": "subtitle", "time": 13451.269, "timestamp": "03:44:11", "text": "それ。たとえ私がすべてのことを考えたとしても"}, {"type": "subtitle", "time": 13454.51, "timestamp": "03:44:14", "text": "これらのことについて、私の半分はまだ"}, {"type": "subtitle", "time": 13456.67, "timestamp": "03:44:16", "text": "寝ている"}, {"type": "subtitle", "time": 13459.18, "timestamp": "03:44:19", "text": "今。私はしません"}, {"type": "subtitle", "time": 13479.269, "timestamp": "03:44:39", "text": "自己？ほら、私が何かをしているとき"}, {"type": "subtitle", "time": 13483.07, "timestamp": "03:44:43", "text": "こんな風にクリエイティブなことをすると、私の体はこうなります、私は"}, {"type": "subtitle", "time": 13487.429, "timestamp": "03:44:47", "text": "疲れた、わーわーわー、できない、など"}, {"type": "subtitle", "time": 13490.229, "timestamp": "03:44:50", "text": "などなど。言い訳ばかりしている。でも私が"}, {"type": "subtitle", "time": 13493.71, "timestamp": "03:44:53", "text": "ゲームをプレイする、私がプレイするのを見て"}, {"type": "subtitle", "time": 13497.429, "timestamp": "03:44:57", "text": "そんな風に何時間も言ってるよ。私が"}]
[{"type": "subtitle", "time": 6960.669, "timestamp": "01:56:00", "text": "上向きに。"}, {"type": "subtitle", "time": 6967.189, "timestamp": "01:56:07", "text": "アイデア。私はこの件については取り上げません。多分"}, {"type": "subtitle", "time": 6969.669, "timestamp": "01:56:09", "text": "水で覆ってみようかな。 1つ"}, {"type": "subtitle", "time": 6971.47, "timestamp": "01:56:11", "text": "水の層ですが、私は"}, {"type": "subtitle", "time": 6974.669, "timestamp": "01:56:14", "text": "知る。うん。こんにちは。"}, {"type": "subtitle", "time": 6977.75, "timestamp": "01:56:17", "text": "こんにちは。返信するのを忘れていました"}, {"type": "subtitle", "time": 6979.87, "timestamp": "01:56:19", "text": "この道"}, {"type": "subtitle", "time": 6982.43, "timestamp": "01:56:22", "text": "出かける"}, {"type": "subtitle", "time": 6986.589, "timestamp": "01:56:26", "text": "それと、私が"}, {"type": "subtitle", "time": 6988.95, "timestamp": "01:56:28", "text": "そうですね、次の"}, {"type": "subtitle", "time": 6991.39, "timestamp": "01:56:31", "text": "説明書。"}, {"type": "subtitle", "time": 6994.03, "timestamp": "01:56:34", "text": "わかった。読んだ"}, {"type": "subtitle", "time": 6998.189, "timestamp": "01:56:38", "text": "ルールの件"}, {"type": "subtitle", "time": 7009.629, "timestamp": "01:56:49", "text": "ああ、わかった。待って。ああ、戻って"}, {"type": "subtitle", "time": 7012.589, "timestamp": "01:56:52", "text": "落ち着け、兄弟。"}, {"type": "subtitle", "time": 7016.83, "timestamp": "01:56:56", "text": "停止。インスタクラフトはどうやって作るの？"}]
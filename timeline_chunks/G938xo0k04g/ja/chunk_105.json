[{"type": "subtitle", "time": 6302.629, "timestamp": "01:45:02", "text": "えっと、もっと詳しく説明すべきかどうか迷っています。"}, {"type": "subtitle", "time": 6306.109, "timestamp": "01:45:06", "text": "詳しく説明します。私の考えは"}, {"type": "subtitle", "time": 6309.39, "timestamp": "01:45:09", "text": "どのシェーダーを使用していますか？私は使用しています"}, {"type": "subtitle", "time": 6313.79, "timestamp": "01:45:13", "text": "シェラーの鮮やかな光"}, {"type": "subtitle", "time": 6322.629, "timestamp": "01:45:22", "text": "シェーダー。そう、私は"}, {"type": "subtitle", "time": 6325.79, "timestamp": "01:45:25", "text": "拡大すると"}, {"type": "subtitle", "time": 6334.149, "timestamp": "01:45:34", "text": "知る。拡張しようと考えています"}, {"type": "subtitle", "time": 6340.229, "timestamp": "01:45:40", "text": "少し。どうなるかはわからないけど、"}]
[{"type": "subtitle", "time": 10380.309, "timestamp": "02:53:00", "text": "モンク。それは良いことですか？それは何ですか"}, {"type": "subtitle", "time": 10382.11, "timestamp": "02:53:02", "text": "何をすべきか？私はしません"}, {"type": "subtitle", "time": 10384.469, "timestamp": "02:53:04", "text": "知る。今度はもっと良い方法を考えなければならない"}, {"type": "subtitle", "time": 10387.19, "timestamp": "02:53:07", "text": "デザイン。"}, {"type": "subtitle", "time": 10389.67, "timestamp": "02:53:09", "text": "悪くはないけど、まあ、"}, {"type": "subtitle", "time": 10391.08, "timestamp": "02:53:11", "text": "もっと良い方法を考えなければならない"}, {"type": "subtitle", "time": 10398.15, "timestamp": "02:53:18", "text": "1つ。わかった。えっと、今のところ私は"}, {"type": "subtitle", "time": 10400.59, "timestamp": "02:53:20", "text": "次のような"}, {"type": "subtitle", "time": 10404.19, "timestamp": "02:53:24", "text": "下。さて、問題は"}, {"type": "subtitle", "time": 10418.95, "timestamp": "02:53:38", "text": "私たちはこのようなブロックを設置しています。"}, {"type": "subtitle", "time": 10426.59, "timestamp": "02:53:46", "text": "マーク。これも"}, {"type": "subtitle", "time": 10430.67, "timestamp": "02:53:50", "text": "下向きの矢印のように機能し、"}, {"type": "subtitle", "time": 10435.269, "timestamp": "02:53:55", "text": "知る。それから、もしかしたら、えっと、できれば"}, {"type": "subtitle", "time": 10436.03, "timestamp": "02:53:56", "text": "建てる"}]
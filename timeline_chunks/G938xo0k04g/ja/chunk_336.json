[{"type": "subtitle", "time": 20168.11, "timestamp": "05:36:08", "text": "[音楽]"}, {"type": "subtitle", "time": 20170.75, "timestamp": "05:36:10", "text": "何？はい、それは"}, {"type": "subtitle", "time": 20175.11, "timestamp": "05:36:15", "text": "サス。なるほど、それは確かに怪しいですね。どうやって"}, {"type": "subtitle", "time": 20179.07, "timestamp": "05:36:19", "text": "ライトを消したばかりです"}, {"type": "subtitle", "time": 20184.35, "timestamp": "05:36:24", "text": "ゲーム？死体。死体。何？"}, {"type": "subtitle", "time": 20208.31, "timestamp": "05:36:48", "text": "今。何？それは何ですか？それは何ですか？"}, {"type": "subtitle", "time": 20210.19, "timestamp": "05:36:50", "text": "何が"}, {"type": "subtitle", "time": 20214.628, "timestamp": "05:36:54", "text": "それ？あれは何だ？"}, {"type": "subtitle", "time": 20215.628, "timestamp": "05:36:55", "text": "あなたは"}]
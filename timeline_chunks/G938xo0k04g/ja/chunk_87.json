[{"type": "subtitle", "time": 5225.79, "timestamp": "01:27:05", "text": "[音楽]"}, {"type": "subtitle", "time": 5228.709, "timestamp": "01:27:08", "text": "あぁ、あぁ、あぁ、だから、"}, {"type": "subtitle", "time": 5232.669, "timestamp": "01:27:12", "text": "たくさんのことをする人がいる"}, {"type": "subtitle", "time": 5235.83, "timestamp": "01:27:15", "text": "ヒントやコツ、あるいはヒントではないものなど"}, {"type": "subtitle", "time": 5238.229, "timestamp": "01:27:18", "text": "トリックというよりはビデオ倫理のようなもので"}, {"type": "subtitle", "time": 5239.74, "timestamp": "01:27:19", "text": "たくさんのガイド"}, {"type": "subtitle", "time": 5241.229, "timestamp": "01:27:21", "text": "[音楽]"}, {"type": "subtitle", "time": 5244.31, "timestamp": "01:27:24", "text": "チャットや配信が好きな人のためのTwitter"}, {"type": "subtitle", "time": 5246.629, "timestamp": "01:27:26", "text": "そして、初心者向けのすべて"}, {"type": "subtitle", "time": 5248.629, "timestamp": "01:27:28", "text": "Vtubingのことですよね？ VTuberの倫理"}, {"type": "subtitle", "time": 5250.83, "timestamp": "01:27:30", "text": "エシクイッツと"}, {"type": "subtitle", "time": 5254.43, "timestamp": "01:27:34", "text": "私が好きなのはこれです"}, {"type": "subtitle", "time": 5256.32, "timestamp": "01:27:36", "text": "一つはこう言っている"}, {"type": "subtitle", "time": 5258.35, "timestamp": "01:27:38", "text": "[音楽]"}, {"type": "subtitle", "time": 5262.95, "timestamp": "01:27:42", "text": "VTingの魅力の一部は匿名性または"}, {"type": "subtitle", "time": 5265.31, "timestamp": "01:27:45", "text": "異なる"}, {"type": "subtitle", "time": 5267.669, "timestamp": "01:27:47", "text": "ペルソナ。 VTuberと一緒に遊ぼう"}, {"type": "subtitle", "time": 5269.51, "timestamp": "01:27:49", "text": "人格。質問しないでください"}, {"type": "subtitle", "time": 5271.43, "timestamp": "01:27:51", "text": "VTubverのオフライン生活。もしあなたが知っているなら"}, {"type": "subtitle", "time": 5274.11, "timestamp": "01:27:54", "text": "YouTuberである私でも、"}, {"type": "subtitle", "time": 5276.629, "timestamp": "01:27:56", "text": "彼らのことを嬉しく思います、本当に"}, {"type": "subtitle", "time": 5278.27, "timestamp": "01:27:58", "text": "お願いだから、個人情報を晒さないで"}]
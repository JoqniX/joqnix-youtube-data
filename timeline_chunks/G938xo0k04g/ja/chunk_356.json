[{"type": "subtitle", "time": 21379.47, "timestamp": "05:56:19", "text": "はぁ？私はああ神様、私は"}, {"type": "subtitle", "time": 21383.19, "timestamp": "05:56:23", "text": "怖がった。私は怖いです。"}, {"type": "subtitle", "time": 21385.708, "timestamp": "05:56:25", "text": "うん。こんにちは、IP"}, {"type": "subtitle", "time": 21393.59, "timestamp": "05:56:33", "text": "歩いた。うん。うん。何てことだ。そこには"}, {"type": "subtitle", "time": 21395.83, "timestamp": "05:56:35", "text": "おばけ。幽霊がいる。これは幽霊だ。"}, {"type": "subtitle", "time": 21397.67, "timestamp": "05:56:37", "text": "あれは幽霊だ。幽霊がいる。そこには"}, {"type": "subtitle", "time": 21401.23, "timestamp": "05:56:41", "text": "幽霊か何か。それは幽霊か"}, {"type": "subtitle", "time": 21409.868, "timestamp": "05:56:49", "text": "神。何てことだ。何てことだ。何てことだ。"}, {"type": "subtitle", "time": 21412.99, "timestamp": "05:56:52", "text": "魚。これを"}, {"type": "subtitle", "time": 21414.99, "timestamp": "05:56:54", "text": "[拍手]"}, {"type": "subtitle", "time": 21417.788, "timestamp": "05:56:57", "text": "終わり。"}]
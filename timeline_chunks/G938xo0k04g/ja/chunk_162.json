[{"type": "subtitle", "time": 9720.59, "timestamp": "02:42:00", "text": "これ。お願いします"}, {"type": "subtitle", "time": 9723.99, "timestamp": "02:42:03", "text": "ボット。さあ、取り掛かろう。ああ、そうだった。その通りです"}, {"type": "subtitle", "time": 9734.51, "timestamp": "02:42:14", "text": "クリック。あ、待って。あなたは私のものを手に入れました"}, {"type": "subtitle", "time": 9745.23, "timestamp": "02:42:25", "text": "バットプレートサーバー。"}, {"type": "subtitle", "time": 9764.469, "timestamp": "02:42:44", "text": "自分自身。また、私は今気づいたのですが"}, {"type": "subtitle", "time": 9767.83, "timestamp": "02:42:47", "text": "重い圧力プレートとドアのように"}, {"type": "subtitle", "time": 9770.07, "timestamp": "02:42:50", "text": "私の在庫。それをそのままにしておきます"}, {"type": "subtitle", "time": 9772.429, "timestamp": "02:42:52", "text": "ヌスの"}, {"type": "subtitle", "time": 9775.55, "timestamp": "02:42:55", "text": "場所。私はそれを手に入れたと思います"}]
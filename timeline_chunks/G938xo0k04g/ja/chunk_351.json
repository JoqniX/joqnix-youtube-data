[{"type": "subtitle", "time": 21063.27, "timestamp": "05:51:03", "text": "彼に起こっていたこと。彼は何をしているの？"}, {"type": "subtitle", "time": 21066.43, "timestamp": "05:51:06", "text": "そちら側？かがむような感じ。"}, {"type": "subtitle", "time": 21069.35, "timestamp": "05:51:09", "text": "何？これは怖かった。何てことだ。私は"}, {"type": "subtitle", "time": 21087.03, "timestamp": "05:51:27", "text": "自分。わかりました、では、"}, {"type": "subtitle", "time": 21089.59, "timestamp": "05:51:29", "text": "オレンジ色は、夜であることを意味します。そして"}, {"type": "subtitle", "time": 21092.23, "timestamp": "05:51:32", "text": "それが本当に"}, {"type": "subtitle", "time": 21095.03, "timestamp": "05:51:35", "text": "本当に本当に本当にオレンジ色、つまり"}, {"type": "subtitle", "time": 21112.47, "timestamp": "05:51:52", "text": "言った。ええ、それが私が必要としているものだと思います"}, {"type": "subtitle", "time": 21114.628, "timestamp": "05:51:54", "text": "こちらでやってください。"}]
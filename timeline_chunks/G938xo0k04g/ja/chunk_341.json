[{"type": "subtitle", "time": 20481.39, "timestamp": "05:41:21", "text": "残念ながら。これは一体何ですか？破壊する"}, {"type": "subtitle", "time": 20483.27, "timestamp": "05:41:23", "text": "ロック。感謝"}, {"type": "subtitle", "time": 20487.07, "timestamp": "05:41:27", "text": "[音楽]"}, {"type": "subtitle", "time": 20489.91, "timestamp": "05:41:29", "text": "あなた。バリケードを築きたくはない。私はできる"}, {"type": "subtitle", "time": 20493.03, "timestamp": "05:41:33", "text": "とにかく中に入って。うわあ、まだある"}, {"type": "subtitle", "time": 20495.99, "timestamp": "05:41:35", "text": "犬。私は行く必要があります。いや、いや、いや、いや、いや、いや、"}, {"type": "subtitle", "time": 20498.51, "timestamp": "05:41:38", "text": "いや、いや。これは"}, {"type": "subtitle", "time": 20505.39, "timestamp": "05:41:45", "text": "ああ、それは恐ろしい"}, {"type": "subtitle", "time": 20509.948, "timestamp": "05:41:49", "text": "場所。彼らは来るのか？彼らはそうではない"}, {"type": "subtitle", "time": 20514.17, "timestamp": "05:41:54", "text": "来るよ。よう、坊や。"}, {"type": "subtitle", "time": 20515.51, "timestamp": "05:41:55", "text": "[音楽]"}, {"type": "subtitle", "time": 20519.868, "timestamp": "05:41:59", "text": "このゲームの会話は本当に"}]
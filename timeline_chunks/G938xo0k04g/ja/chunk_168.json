[{"type": "subtitle", "time": 10085.11, "timestamp": "02:48:05", "text": "右。見て、ピカチュウを捕まえたよ。待って、"}, {"type": "subtitle", "time": 10087.91, "timestamp": "02:48:07", "text": "ピカチュウ？何？この中にピカチュウがいる"}, {"type": "subtitle", "time": 10095.07, "timestamp": "02:48:15", "text": "これは何ですか？ピカチュウ？"}, {"type": "subtitle", "time": 10102.19, "timestamp": "02:48:22", "text": "ウサギと"}, {"type": "subtitle", "time": 10112.59, "timestamp": "02:48:32", "text": "ゾンビ。彼らを見てごらん。彼らはとても"}, {"type": "subtitle", "time": 10114.99, "timestamp": "02:48:34", "text": "ハッピー。それで"}, {"type": "subtitle", "time": 10117.55, "timestamp": "02:48:37", "text": "かわいい。また、私は"}, {"type": "subtitle", "time": 10122.75, "timestamp": "02:48:42", "text": "私はただ死にたいだけなので"}, {"type": "subtitle", "time": 10128.71, "timestamp": "02:48:48", "text": "リセット。それでいいんです。戻るだけ"}, {"type": "subtitle", "time": 10134.99, "timestamp": "02:48:54", "text": "死ぬ。終わらせます"}, {"type": "subtitle", "time": 10138.79, "timestamp": "02:48:58", "text": "私がこの物を持っている間、"}]
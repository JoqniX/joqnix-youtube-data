[{"type": "subtitle", "time": 4261.669, "timestamp": "01:11:01", "text": "何か。ああ、それが結末になるだろう"}, {"type": "subtitle", "time": 4264.189, "timestamp": "01:11:04", "text": "1つ。だから私は"}, {"type": "subtitle", "time": 4268.91, "timestamp": "01:11:08", "text": "興奮した。また、カマはたくさんのものを手に入れています"}, {"type": "subtitle", "time": 4272.87, "timestamp": "01:11:12", "text": "アニメ風の音楽系の企画の機会。それで"}, {"type": "subtitle", "time": 4273.95, "timestamp": "01:11:13", "text": "私は"}, {"type": "subtitle", "time": 4276.83, "timestamp": "01:11:16", "text": "誇り高い、あなた"}, {"type": "subtitle", "time": 4280.149, "timestamp": "01:11:20", "text": "知ってるよ、すごくいい。"}, {"type": "subtitle", "time": 4282.79, "timestamp": "01:11:22", "text": "これを見て私もそういうことをしたくなった"}, {"type": "subtitle", "time": 4285.11, "timestamp": "01:11:25", "text": "あなたも私にベストを尽くすよう刺激を与えてくれます。"}, {"type": "subtitle", "time": 4290.07, "timestamp": "01:11:30", "text": "少なくとも最初の曲を手に入れよう"}, {"type": "subtitle", "time": 4295.75, "timestamp": "01:11:35", "text": "外に出るか何かしてそこに着く"}, {"type": "subtitle", "time": 4298.83, "timestamp": "01:11:38", "text": "ゆっくりと私自身の"}, {"type": "subtitle", "time": 4301.43, "timestamp": "01:11:41", "text": "ページ。より多くの機会を得て、"}]
[{"type": "subtitle", "time": 11220.55, "timestamp": "03:07:00", "text": "タブレットと待って、マインクラフトはプレイできますか？"}, {"type": "subtitle", "time": 11222.95, "timestamp": "03:07:02", "text": "このような？待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 11224.99, "timestamp": "03:07:04", "text": "待って、これは"}, {"type": "subtitle", "time": 11227.59, "timestamp": "03:07:07", "text": "いいね。待って、これすごいね。待って、これは"}, {"type": "subtitle", "time": 11230.469, "timestamp": "03:07:10", "text": "まるでコントローラーを使っているみたいだ。何てことだ、"}, {"type": "subtitle", "time": 11232.59, "timestamp": "03:07:12", "text": "これは実際には"}, {"type": "subtitle", "time": 11240.15, "timestamp": "03:07:20", "text": "それ？よく見てごらん。ああ、それは私の"}, {"type": "subtitle", "time": 11247.63, "timestamp": "03:07:27", "text": "うわぁ。"}, {"type": "subtitle", "time": 11249.15, "timestamp": "03:07:29", "text": "おお。"}, {"type": "subtitle", "time": 11257.23, "timestamp": "03:07:37", "text": "[笑い]"}, {"type": "subtitle", "time": 11260.469, "timestamp": "03:07:40", "text": "これ。これはすごくクールだ。まるで私はただ"}, {"type": "subtitle", "time": 11264.67, "timestamp": "03:07:44", "text": "先端を傾けるように持ち、"}, {"type": "subtitle", "time": 11268.19, "timestamp": "03:07:48", "text": "パン。これは何ですか？まるで"}, {"type": "subtitle", "time": 11271.67, "timestamp": "03:07:51", "text": "コントローラ。もう頭がくらくらする。"}, {"type": "subtitle", "time": 11274.349, "timestamp": "03:07:54", "text": "私の頭は"}, {"type": "subtitle", "time": 11278.15, "timestamp": "03:07:58", "text": "めまい。ああ、神様。とにかく、マウスの話に戻りましょう。"}]
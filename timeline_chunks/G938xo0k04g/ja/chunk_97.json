[{"type": "subtitle", "time": 5820.149, "timestamp": "01:37:00", "text": "ストリーム配信はしないはずだったんだけど"}, {"type": "subtitle", "time": 5824.229, "timestamp": "01:37:04", "text": "今日は10時か11時、5日のように、それから"}, {"type": "subtitle", "time": 5826.55, "timestamp": "01:37:06", "text": "12までのカウントダウンみたいな感じ"}, {"type": "subtitle", "time": 5830.39, "timestamp": "01:37:10", "text": "セシルの誕生日にやったんだ。」だから私は"}, {"type": "subtitle", "time": 5832.95, "timestamp": "01:37:12", "text": "「ああ、神様。」"}, {"type": "subtitle", "time": 5836.229, "timestamp": "01:37:16", "text": "私はまだそのchを準備していません"}, {"type": "subtitle", "time": 5843.51, "timestamp": "01:37:23", "text": "もの。何てことだ。そう、それらはすべて"}, {"type": "subtitle", "time": 5846.55, "timestamp": "01:37:26", "text": "制作中。今日の配信は"}, {"type": "subtitle", "time": 5850.07, "timestamp": "01:37:30", "text": "短いものなので、時間を作って"}, {"type": "subtitle", "time": 5852.709, "timestamp": "01:37:32", "text": "明日のためにあらゆる準備をしておくこと。私"}, {"type": "subtitle", "time": 5854.99, "timestamp": "01:37:34", "text": "今夜という意味で、明日ではない。"}, {"type": "subtitle", "time": 5860.47, "timestamp": "01:37:40", "text": "待って。それで、念のため、"}, {"type": "subtitle", "time": 5862.95, "timestamp": "01:37:42", "text": "ストリームが"}, {"type": "subtitle", "time": 5865.83, "timestamp": "01:37:45", "text": "明日の次の配信が予定されていますが、"}, {"type": "subtitle", "time": 5868.629, "timestamp": "01:37:48", "text": "女王の誕生日配信は"}, {"type": "subtitle", "time": 5871.189, "timestamp": "01:37:51", "text": "今日と同じ10時。だから、私は"}, {"type": "subtitle", "time": 5875.109, "timestamp": "01:37:55", "text": "午後10時くらいに変更してください。午後11時"}, {"type": "subtitle", "time": 5878.55, "timestamp": "01:37:58", "text": "たぶん私は"}]
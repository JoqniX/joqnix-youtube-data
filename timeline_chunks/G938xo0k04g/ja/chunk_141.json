[{"type": "subtitle", "time": 8461.51, "timestamp": "02:21:01", "text": "それを言うには一言で十分だ。それはまるで"}, {"type": "subtitle", "time": 8464.79, "timestamp": "02:21:04", "text": "蓋付きの調理鍋で"}, {"type": "subtitle", "time": 8467.95, "timestamp": "02:21:07", "text": "ハンドルを持って、"}, {"type": "subtitle", "time": 8470.389, "timestamp": "02:21:10", "text": "何か。わかりました、取り組みます。"}, {"type": "subtitle", "time": 8473.11, "timestamp": "02:21:13", "text": "その前に、猫の話をさせてください。"}, {"type": "subtitle", "time": 8474.349, "timestamp": "02:21:14", "text": "どこ"}, {"type": "subtitle", "time": 8479.27, "timestamp": "02:21:19", "text": "カツォ？それと、食べ物も必要だ。えっと"}, {"type": "subtitle", "time": 8482.63, "timestamp": "02:21:22", "text": "水バケツのやつをやりたい"}, {"type": "subtitle", "time": 8485.99, "timestamp": "02:21:25", "text": "私にやってほしかったこと。"}, {"type": "subtitle", "time": 8496.429, "timestamp": "02:21:36", "text": "これ？あぁ、本当にごめんなさい。"}, {"type": "subtitle", "time": 8500.63, "timestamp": "02:21:40", "text": "でも私は生きなければならない"}, {"type": "subtitle", "time": 8505.67, "timestamp": "02:21:45", "text": "ええ、今のところは。それらを受け取って、上へ行きます"}, {"type": "subtitle", "time": 8513.03, "timestamp": "02:21:53", "text": "あ、待って。メロンって高すぎる？私"}]
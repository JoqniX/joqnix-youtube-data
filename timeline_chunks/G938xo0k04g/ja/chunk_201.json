[{"type": "subtitle", "time": 12060.87, "timestamp": "03:21:00", "text": "えっと、コピー＆ペースト。ええと、個室はありません。えっと、私は"}, {"type": "subtitle", "time": 12075.87, "timestamp": "03:21:15", "text": "いいえ。ああ、ええと、"}, {"type": "subtitle", "time": 12079.83, "timestamp": "03:21:19", "text": "個室。うん、私は"}, {"type": "subtitle", "time": 12081.75, "timestamp": "03:21:21", "text": "概略図の料理が欲しい。したい"}, {"type": "subtitle", "time": 12085.349, "timestamp": "03:21:25", "text": "設計図は、ご存知のように、"}, {"type": "subtitle", "time": 12088.63, "timestamp": "03:21:28", "text": "その時私が作りたいもののアイデア"}, {"type": "subtitle", "time": 12092.469, "timestamp": "03:21:32", "text": "私のOhではなく、それを構築してください"}, {"type": "subtitle", "time": 12095.349, "timestamp": "03:21:35", "text": "待って、これって実際すごくかっこいいじゃん。はぁ？"}, {"type": "subtitle", "time": 12105.19, "timestamp": "03:21:45", "text": "ニース。でも、これはこれでかなり綺麗ですね。"}, {"type": "subtitle", "time": 12107.71, "timestamp": "03:21:47", "text": "自分自身ですが、それを均等にしたいのです"}, {"type": "subtitle", "time": 12110.79, "timestamp": "03:21:50", "text": "威嚇的だ。しかし、騎手について考えてみてください。欲しいですか"}, {"type": "subtitle", "time": 12111.87, "timestamp": "03:21:51", "text": "脅迫的な"}, {"type": "subtitle", "time": 12113.55, "timestamp": "03:21:53", "text": "または"}, {"type": "subtitle", "time": 12116.349, "timestamp": "03:21:56", "text": "純粋な？悪を望むのか、それとも"}, {"type": "subtitle", "time": 12119.11, "timestamp": "03:21:59", "text": "良い？わからない。私は何をしようとしているのか"}]
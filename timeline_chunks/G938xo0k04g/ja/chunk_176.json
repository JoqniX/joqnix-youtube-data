[{"type": "subtitle", "time": 10567.23, "timestamp": "02:56:07", "text": "えっと、これ"}, {"type": "subtitle", "time": 10569.63, "timestamp": "02:56:09", "text": "これこれ"}, {"type": "subtitle", "time": 10572.07, "timestamp": "02:56:12", "text": "これ。待って、待って、待って。いや、いや。しないで"}, {"type": "subtitle", "time": 10573.23, "timestamp": "02:56:13", "text": "めちゃくちゃにする"}, {"type": "subtitle", "time": 10599.429, "timestamp": "02:56:39", "text": "普通？待って、待って、待って。私はとても"}, {"type": "subtitle", "time": 10601.99, "timestamp": "02:56:41", "text": "彼が雪の件をしたので混乱した。私は"}, {"type": "subtitle", "time": 10602.91, "timestamp": "02:56:42", "text": "それで"}, {"type": "subtitle", "time": 10605.15, "timestamp": "02:56:45", "text": "混乱した。何が"}, {"type": "subtitle", "time": 10608.83, "timestamp": "02:56:48", "text": "これ？え、私がそんなことしたの？"}, {"type": "subtitle", "time": 10613.07, "timestamp": "02:56:53", "text": "待って。ああ、そうしておけばよかった。"}]
[{"type": "subtitle", "time": 5940.229, "timestamp": "01:39:00", "text": "溶岩のようなものを流し、"}, {"type": "subtitle", "time": 5942.43, "timestamp": "01:39:02", "text": "すべて。それで、それで、"}, {"type": "subtitle", "time": 5945.91, "timestamp": "01:39:05", "text": "とても楽しい。でも、私は"}, {"type": "subtitle", "time": 5947.229, "timestamp": "01:39:07", "text": "それ"}, {"type": "subtitle", "time": 5951.189, "timestamp": "01:39:11", "text": "行く。そう、本物が必要なんです。おお、"}, {"type": "subtitle", "time": 5969.03, "timestamp": "01:39:29", "text": "ああ、どうしてそんな顔をしていたの？"}, {"type": "subtitle", "time": 5972.229, "timestamp": "01:39:32", "text": "ああ、アカウントを削除するのは本当に嫌だ"}, {"type": "subtitle", "time": 5974.109, "timestamp": "01:39:34", "text": "から"}, {"type": "subtitle", "time": 5978.43, "timestamp": "01:39:38", "text": "これ。待って。えっと、"}, {"type": "subtitle", "time": 5980.75, "timestamp": "01:39:40", "text": "これ。"}, {"type": "subtitle", "time": 5985.07, "timestamp": "01:39:45", "text": "えっと、ログインしました。よかった。こんにちは。"}, {"type": "subtitle", "time": 5987.43, "timestamp": "01:39:47", "text": "とにかく、私の声が聞こえて、"}, {"type": "subtitle", "time": 5990.31, "timestamp": "01:39:50", "text": "すべて。それで、昨日私は"}, {"type": "subtitle", "time": 5992.87, "timestamp": "01:39:52", "text": "見ている。いいえ、見ていませんが、"}, {"type": "subtitle", "time": 5998.629, "timestamp": "01:39:58", "text": "おそらく私は、えっと、調べていた"}]
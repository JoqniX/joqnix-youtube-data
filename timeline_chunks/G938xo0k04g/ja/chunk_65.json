[{"type": "subtitle", "time": 3902.87, "timestamp": "01:05:02", "text": "どうやってこれを全部"}, {"type": "subtitle", "time": 3904.67, "timestamp": "01:05:04", "text": "日本？私"}, {"type": "subtitle", "time": 3907.23, "timestamp": "01:05:07", "text": "やめてください。"}, {"type": "subtitle", "time": 3910.95, "timestamp": "01:05:10", "text": "ええ、私はDSグループの前の仕事を辞めました"}, {"type": "subtitle", "time": 3913.67, "timestamp": "01:05:13", "text": "そして別の会社から最終候補に選ばれた。"}, {"type": "subtitle", "time": 3915.75, "timestamp": "01:05:15", "text": "サム・インディアと呼ばれています。すごく楽しみにしてるよ。"}, {"type": "subtitle", "time": 3918.789, "timestamp": "01:05:18", "text": "さあ、行こう。最終候補に残ったものは何ですか？"}, {"type": "subtitle", "time": 3920.589, "timestamp": "01:05:20", "text": "最終候補に選出"}, {"type": "subtitle", "time": 3936.23, "timestamp": "01:05:36", "text": "待って。ああ、もっとリストがある"}, {"type": "subtitle", "time": 3938.15, "timestamp": "01:05:38", "text": "仕事に最も適していると判断された"}, {"type": "subtitle", "time": 3941.109, "timestamp": "01:05:41", "text": "または、より長いリストから作成された価格"}, {"type": "subtitle", "time": 3944.23, "timestamp": "01:05:44", "text": "当初検討されていた人々。おお。ああ、"}, {"type": "subtitle", "time": 3946.51, "timestamp": "01:05:46", "text": "神。"}, {"type": "subtitle", "time": 3950.109, "timestamp": "01:05:50", "text": "おめでとう、アイザック。何てことだ。さあ"}, {"type": "subtitle", "time": 3953.91, "timestamp": "01:05:53", "text": "行く。あなたをとても誇りに思います。さあ行こう。あなた"}]
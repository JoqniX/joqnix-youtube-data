[{"type": "subtitle", "time": 9791.99, "timestamp": "02:43:11", "text": "彼が来るのを待っているので"}, {"type": "subtitle", "time": 9794.67, "timestamp": "02:43:14", "text": "私のボートを取り戻す"}, {"type": "subtitle", "time": 9798.55, "timestamp": "02:43:18", "text": "上。彼がピクセル単位で上がってくるのを見たと思う"}, {"type": "subtitle", "time": 9809.55, "timestamp": "02:43:29", "text": "そこには。見てください"}, {"type": "subtitle", "time": 9812.91, "timestamp": "02:43:32", "text": "空。はい、私の船が来ます。"}, {"type": "subtitle", "time": 9815.83, "timestamp": "02:43:35", "text": "わーい。そこで、その場所を右クリックして"}, {"type": "subtitle", "time": 9817.83, "timestamp": "02:43:37", "text": "右クリックで入ってください。左クリックではありません。"}, {"type": "subtitle", "time": 9820.91, "timestamp": "02:43:40", "text": "はい、私の間違いは左に行ったことです"}, {"type": "subtitle", "time": 9827.429, "timestamp": "02:43:47", "text": "彼ら。そういうのを見るとわかるよね"}]
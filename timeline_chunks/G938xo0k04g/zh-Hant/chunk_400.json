[{"type": "subtitle", "time": 24015.35, "timestamp": "06:40:15", "text": "你剛才的那一刻。但不會加入創投公司。是的。加入我們。恰奇。是的。"}, {"type": "subtitle", "time": 24027.468, "timestamp": "06:40:27", "text": "說實話，我現在想更多地參與社區活動。"}, {"type": "subtitle", "time": 24034.788, "timestamp": "06:40:34", "text": "我的意思是，嗯，"}, {"type": "subtitle", "time": 24036.468, "timestamp": "06:40:36", "text": "我想恢復我們以前"}, {"type": "subtitle", "time": 24057.628, "timestamp": "06:40:57", "text": "每月或每週舉辦的活動，例如2022年，如果我忘了是哪一年的話，我們以前經常舉辦這些活動，對吧？"}]
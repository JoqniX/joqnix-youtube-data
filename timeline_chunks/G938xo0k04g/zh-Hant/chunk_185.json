[{"type": "subtitle", "time": 11128.51, "timestamp": "03:05:28", "text": "我不知道該用什麼詞來表達。我不知怎麼弄到了兩個手電筒。  能夠思考的"}, {"type": "subtitle", "time": 11131.51, "timestamp": "03:05:31", "text": "事物。這樣不是更好嗎？振作起來。這樣豈不是更好嗎？冶煉設備在哪兒？"}, {"type": "subtitle", "time": 11139.469, "timestamp": "03:05:39", "text": "我想應該沒有冶煉設備吧？啊，等等。我得把這個做成菜"}, {"type": "subtitle", "time": 11142.91, "timestamp": "03:05:42", "text": "。我的天哪。抽煙。我的天哪。我"}, {"type": "subtitle", "time": 11149.11, "timestamp": "03:05:49", "text": "沒有煙具。哦，他參加了冰桶挑戰"}]
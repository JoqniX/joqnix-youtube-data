[{"type": "subtitle", "time": 4624.11, "timestamp": "01:17:04", "text": "開演唱會，"}, {"type": "subtitle", "time": 4633.83, "timestamp": "01:17:13", "text": "對吧？如果我沒記錯的話。我看到了那條推特。"}, {"type": "subtitle", "time": 4635.35, "timestamp": "01:17:15", "text": "我不知道它在哪裡？我看到了那條推特。"}, {"type": "subtitle", "time": 4646.75, "timestamp": "01:17:26", "text": "我看到了海報。"}, {"type": "subtitle", "time": 4657.79, "timestamp": "01:17:37", "text": "對，就是這個。這個。這個。虛擬大阪"}, {"type": "subtitle", "time": 4668.43, "timestamp": "01:17:48", "text": "醫療館。畫得真好。他很敏感。但為此"}]
[{"type": "subtitle", "time": 27669.59, "timestamp": "07:41:09", "text": "國語Niha 和 Sh。三件事。我只"}, {"type": "subtitle", "time": 27672.07, "timestamp": "07:41:12", "text": "知道三件事。"}, {"type": "subtitle", "time": 27688.11, "timestamp": "07:41:28", "text": "嗯，對不起，但我正在學習。我正在學習。我正在學習。我正在學習。為什麼學一門"}, {"type": "subtitle", "time": 27694.708, "timestamp": "07:41:34", "text": "語言"}, {"type": "subtitle", "time": 27707.628, "timestamp": "07:41:47", "text": "就想，什麼？別人是怎麼做到的？ Maya。所以，嗯"}]
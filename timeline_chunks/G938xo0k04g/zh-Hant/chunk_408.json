[{"type": "subtitle", "time": 24483.35, "timestamp": "06:48:03", "text": "我"}, {"type": "subtitle", "time": 24505.91, "timestamp": "06:48:25", "text": "不能帶其他人來，因為他們大多數人都有自己的事情要忙。所以，我當時就像是在"}, {"type": "subtitle", "time": 24515.27, "timestamp": "06:48:35", "text": "單人烹飪。所以，我還沒決定要從哪個《異塵餘生》系列開始玩"}, {"type": "subtitle", "time": 24521.99, "timestamp": "06:48:41", "text": "。  你還好嗎？我很好。  我……我……我還有點不舒服，因為我"}, {"type": "subtitle", "time": 24530.07, "timestamp": "06:48:50", "text": "前不久做了……Viva。"}]
[{"type": "subtitle", "time": 11299.23, "timestamp": "03:08:19", "text": "祝我好運"}, {"type": "subtitle", "time": 11303.469, "timestamp": "03:08:23", "text": "。我們走吧。  我做到了。我做到了。然後，那有一個。 我們再來一次。  是的。是的。"}, {"type": "subtitle", "time": 11307.99, "timestamp": "03:08:27", "text": "就像，是的。是的。"}, {"type": "subtitle", "time": 11311.03, "timestamp": "03:08:31", "text": "我原本打算按鼠標左鍵。  想像。"}, {"type": "subtitle", "time": 11320.469, "timestamp": "03:08:40", "text": "我的天啊。好的。三、二、一。我正在全力以赴。我的天哪，我真是太蠢了。我落在了"}, {"type": "subtitle", "time": 11332.469, "timestamp": "03:08:52", "text": "樓頂上。  哦，"}]
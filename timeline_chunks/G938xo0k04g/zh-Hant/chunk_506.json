[{"type": "subtitle", "time": 30388.43, "timestamp": "08:26:28", "text": "我們就"}, {"type": "subtitle", "time": 30391.03, "timestamp": "08:26:31", "text": "到此為止吧。"}, {"type": "subtitle", "time": 30393.99, "timestamp": "08:26:33", "text": "抱歉，這是他們的頻道。  你可以……你可以……支持他們，注意他們"}, {"type": "subtitle", "time": 30401.19, "timestamp": "08:26:41", "text": "或"}, {"type": "subtitle", "time": 30403.58, "timestamp": "08:26:43", "text": "什麼的。  嗯，我會把它置頂的。好的。  我無法確定它的位置。"}]
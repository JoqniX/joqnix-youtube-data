[{"type": "subtitle", "time": 24361.708, "timestamp": "06:46:01", "text": "玩《異塵餘生》，我就想：等等，什麼？等等，什麼？現在大家都在追趕這股潮流。  到底是"}, {"type": "subtitle", "time": 24376.868, "timestamp": "06:46:16", "text": "怎麼回事"}, {"type": "subtitle", "time": 24379.51, "timestamp": "06:46:19", "text": "？所以，呃，顯然《輻射76》（多人遊戲版）現在在亞馬遜Prime上是"}, {"type": "subtitle", "time": 24385.43, "timestamp": "06:46:25", "text": "免費的，因為我是Prime會員，呃，"}]
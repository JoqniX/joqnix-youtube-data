[{"type": "subtitle", "time": 20303.03, "timestamp": "05:38:23", "text": "我的意思是，這不需要我（"}, {"type": "subtitle", "time": 20307.11, "timestamp": "05:38:27", "text": "音樂）去做，你知道，沒地方了。"}, {"type": "subtitle", "time": 20317.628, "timestamp": "05:38:37", "text": "好吧，還行吧。"}, {"type": "subtitle", "time": 20321.35, "timestamp": "05:38:41", "text": "我沒事。休息一下。哦，太好了。"}, {"type": "subtitle", "time": 20323.39, "timestamp": "05:38:43", "text": "好的。"}, {"type": "subtitle", "time": 20331.75, "timestamp": "05:38:51", "text": "地下通道。我忘了"}]
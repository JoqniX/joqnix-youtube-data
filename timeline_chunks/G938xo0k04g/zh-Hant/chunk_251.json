[{"type": "subtitle", "time": 15078.03, "timestamp": "04:11:18", "text": "Twitch上繼續。  嗨，我需要弄清楚那個設置。"}, {"type": "subtitle", "time": 15081.91, "timestamp": "04:11:21", "text": "我稍後會做"}, {"type": "subtitle", "time": 15083.51, "timestamp": "04:11:23", "text": "。但是現在，暫時"}, {"type": "subtitle", "time": 15091.83, "timestamp": "04:11:31", "text": "我只能手動操作了。回頭見。再見。你好。小心。  你好。今天的工作正式開始之前，讓我先做一件事"}, {"type": "subtitle", "time": 15114.309, "timestamp": "04:11:54", "text": "。  是的，我想我缺了幾節課。不少。  是幾個嗎？我最後一節課只有42分鐘。我的"}]
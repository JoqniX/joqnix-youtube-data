[{"type": "subtitle", "time": 27611.19, "timestamp": "07:40:11", "text": "嗯，現在顯示卡的價格上漲了，我感覺更糟了，為什麼顯示卡價格這麼貴？我想買一塊"}, {"type": "subtitle", "time": 27640.868, "timestamp": "07:40:40", "text": "AV1顯示卡，顯示卡A，大家，啊，AV1的翻譯不太好，大家，我的英文很爛，沒關係，別擔心，嗯，我該怎麼說？沒關係。別"}, {"type": "subtitle", "time": 27643.35, "timestamp": "07:40:43", "text": "擔心。嗯，等等。嗯，等等。我複製貼上一下"}, {"type": "subtitle", "time": 27647.75, "timestamp": "07:40:47", "text": "。對不起。沒關係。為什麼我的國語這麼差？我只會"}, {"type": "subtitle", "time": 27650.27, "timestamp": "07:40:50", "text": "說"}]
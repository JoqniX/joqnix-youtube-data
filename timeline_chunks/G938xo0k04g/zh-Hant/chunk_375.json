[{"type": "subtitle", "time": 22519.83, "timestamp": "06:15:19", "text": "我聽起來病懨懨的。啊，那是因為我感覺自己快要被電腦產生的熱量烤熟了，你知道，太熱了，而且現在是夏天，所以"}, {"type": "subtitle", "time": 22528.39, "timestamp": "06:15:28", "text": "我盡量不發出聲音，因為房東"}, {"type": "subtitle", "time": 22532.19, "timestamp": "06:15:32", "text": "[音樂]"}, {"type": "subtitle", "time": 22557.19, "timestamp": "06:15:57", "text": "一家人都在這裡。是的，今天是我最後一天了。他們還不知道我明天就要搬家了。看來我父母明天早上會到。"}]
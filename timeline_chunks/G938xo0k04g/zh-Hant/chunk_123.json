[{"type": "subtitle", "time": 7392.35, "timestamp": "02:03:12", "text": "（音樂）我下個月就要交域名費用了，對吧？我的天啊。  我早上7點就"}, {"type": "subtitle", "time": 7395.589, "timestamp": "02:03:15", "text": "醒了，那"}, {"type": "subtitle", "time": 7398.35, "timestamp": "02:03:18", "text": "你為什麼還餓呢？  你知道我以前是"}, {"type": "subtitle", "time": 7430.229, "timestamp": "02:03:50", "text": "按"}, {"type": "subtitle", "time": 7433.47, "timestamp": "02:03:53", "text": "這個作息時間安排的，比如早上6點起床，6點到7點散步，然後7點到8點我會做一些"}]
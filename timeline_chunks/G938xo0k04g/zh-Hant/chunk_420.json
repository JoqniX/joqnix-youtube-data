[{"type": "subtitle", "time": 25214.75, "timestamp": "07:00:14", "text": "我猜是金屬，不是管子，是金屬棒。我想放兩個是"}, {"type": "subtitle", "time": 25217.99, "timestamp": "07:00:17", "text": "為了平衡負載，萬一我以後要架設"}, {"type": "subtitle", "time": 25221.628, "timestamp": "07:00:21", "text": "攝像頭，我可以把它放在"}, {"type": "subtitle", "time": 25240.07, "timestamp": "07:00:40", "text": "桌子上，然後把攝像頭降下來什麼的，"}]
[{"type": "subtitle", "time": 20340.43, "timestamp": "05:39:00", "text": "那邊要做什麼。"}, {"type": "subtitle", "time": 20343.59, "timestamp": "05:39:03", "text": "我該怎麼"}, {"type": "subtitle", "time": 20354.83, "timestamp": "05:39:14", "text": "H：哦，那傢伙走了"}, {"type": "subtitle", "time": 20356.35, "timestamp": "05:39:16", "text": "。"}, {"type": "subtitle", "time": 20360.03, "timestamp": "05:39:20", "text": "有趣的。狼人離開了。"}, {"type": "subtitle", "time": 20365.47, "timestamp": "05:39:25", "text": "關閉這個窗口了嗎"}, {"type": "subtitle", "time": 20369.19, "timestamp": "05:39:29", "text": "？我們在精華液裡放了兩朵有毒的蘑菇"}, {"type": "subtitle", "time": 20373.91, "timestamp": "05:39:33", "text": "。現在我們需要去"}, {"type": "subtitle", "time": 20385.788, "timestamp": "05:39:45", "text": "。我必須確保在"}]
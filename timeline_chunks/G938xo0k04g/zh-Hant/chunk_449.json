[{"type": "subtitle", "time": 26962.11, "timestamp": "07:29:22", "text": "我在我的直播電腦上安裝了Apex，"}, {"type": "subtitle", "time": 26966.35, "timestamp": "07:29:26", "text": "我創建了一個新年"}, {"type": "subtitle", "time": 26969.67, "timestamp": "07:29:29", "text": "代碼，但我不知道那是一個新"}, {"type": "subtitle", "time": 26972.868, "timestamp": "07:29:32", "text": "帳號。好吧，Apex。我的確打了"}, {"type": "subtitle", "time": 26974.868, "timestamp": "07:29:34", "text": "東方賽之類的。所以，我"}, {"type": "subtitle", "time": 26983.11, "timestamp": "07:29:43", "text": "道具。我這麼做是為了刷"}, {"type": "subtitle", "time": 26984.948, "timestamp": "07:29:44", "text": "復活道具，因為我覺得，我"}, {"type": "subtitle", "time": 26987.99, "timestamp": "07:29:47", "text": "沒有多少人願意付錢，而且"}, {"type": "subtitle", "time": 26992.708, "timestamp": "07:29:52", "text": "他們都不在線上。所以我就想，"}, {"type": "subtitle", "time": 26995.868, "timestamp": "07:29:55", "text": "嗯，我就…我就…"}, {"type": "subtitle", "time": 26998.68, "timestamp": "07:29:58", "text": "我就… 我就用"}]
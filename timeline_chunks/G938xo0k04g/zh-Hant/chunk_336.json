[{"type": "subtitle", "time": 20168.11, "timestamp": "05:36:08", "text": "音樂"}, {"type": "subtitle", "time": 20170.75, "timestamp": "05:36:10", "text": "是什麼？好吧"}, {"type": "subtitle", "time": 20175.11, "timestamp": "05:36:15", "text": "，這很可疑。好吧，這確實很可疑。你是怎麼"}, {"type": "subtitle", "time": 20179.07, "timestamp": "05:36:19", "text": "關掉燈光"}, {"type": "subtitle", "time": 20184.35, "timestamp": "05:36:24", "text": "遊戲的？屍體。屍體。什麼？  聖。"}, {"type": "subtitle", "time": 20214.628, "timestamp": "05:36:54", "text": "？"}, {"type": "subtitle", "time": 20215.628, "timestamp": "05:36:55", "text": "你有沒有"}]
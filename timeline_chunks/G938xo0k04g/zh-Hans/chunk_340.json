[{"type": "subtitle", "time": 20409.948, "timestamp": "05:40:09", "text": "房子。那是一个"}, {"type": "subtitle", "time": 20413.35, "timestamp": "05:40:13", "text": "狗狗。我们还免费加了一箱汽油。患病的"}, {"type": "subtitle", "time": 20413.98, "timestamp": "05:40:13", "text": "偷"}, {"type": "subtitle", "time": 20415.868, "timestamp": "05:40:15", "text": "[音乐]"}, {"type": "subtitle", "time": 20418.75, "timestamp": "05:40:18", "text": "它。我害怕"}, {"type": "subtitle", "time": 20423.83, "timestamp": "05:40:23", "text": "狗。哦，不。哦，不。哦，不。不，不，不。"}, {"type": "subtitle", "time": 20434.47, "timestamp": "05:40:34", "text": "杀了它。杀了它。对不起。对不起。"}, {"type": "subtitle", "time": 20442.27, "timestamp": "05:40:42", "text": "对不起。哦，我真是太"}, {"type": "subtitle", "time": 20446.548, "timestamp": "05:40:46", "text": "对不起。肉。我的天哪。我弄到肉了。这是"}, {"type": "subtitle", "time": 20448.46, "timestamp": "05:40:48", "text": "那家伙想要的是什么？"}, {"type": "subtitle", "time": 20450.03, "timestamp": "05:40:50", "text": "[音乐]"}, {"type": "subtitle", "time": 20453.91, "timestamp": "05:40:53", "text": "正确的？我的HP值很低。我的生命值很低。我是"}, {"type": "subtitle", "time": 20455.948, "timestamp": "05:40:55", "text": "低的"}, {"type": "subtitle", "time": 20459.91, "timestamp": "05:40:59", "text": "惠普。该怎么办？该怎么办？该怎么办？"}]
[{"type": "subtitle", "time": 9960.469, "timestamp": "02:46:00", "text": "毛刺？僵尸出现是正常的吗？"}, {"type": "subtitle", "time": 9961.55, "timestamp": "02:46:01", "text": "攻击"}, {"type": "subtitle", "time": 9967.67, "timestamp": "02:46:07", "text": "[音乐]"}, {"type": "subtitle", "time": 9971.389, "timestamp": "02:46:11", "text": "哇，他们居然杀了一具骷髅。"}, {"type": "subtitle", "time": 9975.349, "timestamp": "02:46:15", "text": "哇，太酷了！好的，我们走吧"}, {"type": "subtitle", "time": 9982.97, "timestamp": "02:46:22", "text": "睡觉。我刚才是不是得到了"}, {"type": "subtitle", "time": 9984.51, "timestamp": "02:46:24", "text": "[音乐]"}, {"type": "subtitle", "time": 9988.469, "timestamp": "02:46:28", "text": "打？因为骷髅射杀了他们。啊，"}, {"type": "subtitle", "time": 9990.349, "timestamp": "02:46:30", "text": "阿鲁昌人"}, {"type": "subtitle", "time": 10003.469, "timestamp": "02:46:43", "text": "不，我想打架。我的"}, {"type": "subtitle", "time": 10006.19, "timestamp": "02:46:46", "text": "上帝。想要"}, {"type": "subtitle", "time": 10008.91, "timestamp": "02:46:48", "text": "争吵。想打架。"}, {"type": "subtitle", "time": 10011.469, "timestamp": "02:46:51", "text": "呃，还有"}, {"type": "subtitle", "time": 10014.87, "timestamp": "02:46:54", "text": "天哪，我要死在这里了。我只是"}, {"type": "subtitle", "time": 10017.349, "timestamp": "02:46:57", "text": "我想说，那是个陷阱，我掉进去了。"}]
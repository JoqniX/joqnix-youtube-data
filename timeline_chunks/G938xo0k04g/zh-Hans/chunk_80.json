[{"type": "subtitle", "time": 4801.43, "timestamp": "01:20:01", "text": "到 12 比 1 之类的。午餐"}, {"type": "subtitle", "time": 4802.99, "timestamp": "01:20:02", "text": "休息。然后之后"}, {"type": "subtitle", "time": 4806.189, "timestamp": "01:20:06", "text": "午餐是我的私人咪咪"}, {"type": "chat", "time": 4808.14, "timestamp": "01:20:08", "author": "@AerinViolet", "avatar": "https://yt4.ggpht.com/UKawanVvntNiAwz6RWv6wPk_S8YwApvPcCfLApO-du_RbQRIPGtzJ5FTt1DCNmZFJWc_2vxlqw=s64-c-k-c0x00ffffff-no-rj", "message": "in our household. breakfast at 11am or 12pm and then lunch at 3:30-4pm. so I wouldn't be hungry dw"}, {"type": "subtitle", "time": 4808.75, "timestamp": "01:20:08", "text": "你可以抽出时间"}, {"type": "subtitle", "time": 4813.03, "timestamp": "01:20:13", "text": "比如说，我做 3 个小时或者 2 个小时。"}, {"type": "subtitle", "time": 4815.229, "timestamp": "01:20:15", "text": "之后我就开始播放音乐了。"}, {"type": "subtitle", "time": 4818.27, "timestamp": "01:20:18", "text": "音乐视频"}, {"type": "subtitle", "time": 4823.87, "timestamp": "01:20:23", "text": "音乐人格之类的东西，持续了3个小时。"}, {"type": "subtitle", "time": 4827.189, "timestamp": "01:20:27", "text": "然后晚上我就会出去散步或者"}, {"type": "subtitle", "time": 4830.31, "timestamp": "01:20:30", "text": "就像在外面触摸车库一样，然后进来"}, {"type": "subtitle", "time": 4832.709, "timestamp": "01:20:32", "text": "后退。晚上我有自己的娱乐活动。"}, {"type": "subtitle", "time": 4836.79, "timestamp": "01:20:36", "text": "我和别人聊天和观看的时间"}, {"type": "subtitle", "time": 4839.189, "timestamp": "01:20:39", "text": "电影之类的东西，然后就结束了"}, {"type": "subtitle", "time": 4842.709, "timestamp": "01:20:42", "text": "把所有东西都准备好，吃午饭、晚饭和"}, {"type": "subtitle", "time": 4851.669, "timestamp": "01:20:51", "text": "东西。拆散。在我们家。早餐"}, {"type": "subtitle", "time": 4853.83, "timestamp": "01:20:53", "text": "上午 11:00 或下午 12:00然后午餐在"}, {"type": "subtitle", "time": 4858.31, "timestamp": "01:20:58", "text": "凌晨3点到4点，所以我不会饿。啊，"}]
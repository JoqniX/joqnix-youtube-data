[{"type": "subtitle", "time": 8953.83, "timestamp": "02:29:13", "text": "东西。 S"}, {"type": "subtitle", "time": 8955.95, "timestamp": "02:29:15", "text": "呃，我们需要做一个"}, {"type": "subtitle", "time": 8959.349, "timestamp": "02:29:19", "text": "木头。我不想毁掉它。所以，"}, {"type": "subtitle", "time": 8968.67, "timestamp": "02:29:28", "text": "献给圣主。那是一个洞穴洞口。哇。"}, {"type": "subtitle", "time": 8971.95, "timestamp": "02:29:31", "text": "想象一下死在那里的情景。哦"}, {"type": "subtitle", "time": 8975.75, "timestamp": "02:29:35", "text": "主。让我先造一艘船，然后再去做"}, {"type": "subtitle", "time": 8978.19, "timestamp": "02:29:38", "text": "他想让我做的事"}, {"type": "subtitle", "time": 8981.51, "timestamp": "02:29:41", "text": "做。我喜欢我现在这种做这件事的方式。"}, {"type": "subtitle", "time": 8998.429, "timestamp": "02:29:58", "text": "等等，你收到吗？"}]
[{"type": "subtitle", "time": 2884.51, "timestamp": "00:48:04", "text": "感觉。但为此我需要做"}, {"type": "subtitle", "time": 2887.51, "timestamp": "00:48:07", "text": "百万。嗯，我觉得它们很贵。"}, {"type": "subtitle", "time": 2890.39, "timestamp": "00:48:10", "text": "因为，嗯，是的，他们是官方的"}, {"type": "subtitle", "time": 2894.55, "timestamp": "00:48:14", "text": "艺术家世界工作室思想家。所以你"}, {"type": "subtitle", "time": 2896.63, "timestamp": "00:48:16", "text": "我知道他们会非常忙，而且"}, {"type": "subtitle", "time": 2898.589, "timestamp": "00:48:18", "text": "很难委托"}, {"type": "subtitle", "time": 2903.589, "timestamp": "00:48:23", "text": "他们。再见。我太喜欢神明了"}, {"type": "subtitle", "time": 2904.91, "timestamp": "00:48:24", "text": "喜欢"}, {"type": "subtitle", "time": 2908.47, "timestamp": "00:48:28", "text": "东西。它太好了，看看这……"}, {"type": "subtitle", "time": 2915.99, "timestamp": "00:48:35", "text": "但我毕竟是个太像神崎的人了。"}, {"type": "subtitle", "time": 2920.15, "timestamp": "00:48:40", "text": "狂热粉丝，呃，我想是的，我不应该"}, {"type": "subtitle", "time": 2923.109, "timestamp": "00:48:43", "text": "太多人模仿他们，或者喜欢“是的”。是的。我"}, {"type": "subtitle", "time": 2925.589, "timestamp": "00:48:45", "text": "我的意思是，我真的非常爱他们。什么"}, {"type": "subtitle", "time": 2928.069, "timestamp": "00:48:48", "text": "他们确实做到了，而且一切都很好。经过"}, {"type": "subtitle", "time": 2931.39, "timestamp": "00:48:51", "text": "方式上，我非常乐意与……合作"}, {"type": "subtitle", "time": 2933.87, "timestamp": "00:48:53", "text": "镰木。那是我的梦想"}, {"type": "subtitle", "time": 2937.829, "timestamp": "00:48:57", "text": "工作。我不在乎最终会去哪里。我"}]
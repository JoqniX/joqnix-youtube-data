[{"type": "subtitle", "time": 21063.27, "timestamp": "05:51:03", "text": "这件事就发生在他身上。他在做什么？"}, {"type": "subtitle", "time": 21066.43, "timestamp": "05:51:06", "text": "在那边？就像弯腰一样。"}, {"type": "subtitle", "time": 21069.35, "timestamp": "05:51:09", "text": "什么？这吓到我了。我的天啊。我当时"}, {"type": "subtitle", "time": 21087.03, "timestamp": "05:51:27", "text": "我。好的，所以我相信当它转弯的时候"}, {"type": "subtitle", "time": 21089.59, "timestamp": "05:51:29", "text": "橙色表示现在是晚上。和"}, {"type": "subtitle", "time": 21092.23, "timestamp": "05:51:32", "text": "当它变成真正的时候"}, {"type": "subtitle", "time": 21095.03, "timestamp": "05:51:35", "text": "非常非常非常橙，这意味着"}, {"type": "subtitle", "time": 21112.47, "timestamp": "05:51:52", "text": "说。嗯，我想这就是我需要的。"}, {"type": "subtitle", "time": 21114.628, "timestamp": "05:51:54", "text": "这边做。"}]
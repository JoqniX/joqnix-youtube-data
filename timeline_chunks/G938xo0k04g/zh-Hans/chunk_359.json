[{"type": "subtitle", "time": 21541.67, "timestamp": "05:59:01", "text": "看不见。对，就是这个。这个。"}, {"type": "subtitle", "time": 21543.548, "timestamp": "05:59:03", "text": "他的手套"}, {"type": "subtitle", "time": 21546.27, "timestamp": "05:59:06", "text": "这里。有点奇怪。"}, {"type": "subtitle", "time": 21549.19, "timestamp": "05:59:09", "text": "好吧，我会保持中立，我"}, {"type": "subtitle", "time": 21551.948, "timestamp": "05:59:11", "text": "猜测。等等，我到一边去，我"}, {"type": "subtitle", "time": 21564.788, "timestamp": "05:59:24", "text": "兄弟。等待。那人向我伸出手。"}, {"type": "subtitle", "time": 21567.43, "timestamp": "05:59:27", "text": "他用手写了些什么。他的"}, {"type": "subtitle", "time": 21569.03, "timestamp": "05:59:29", "text": "嘴唇在动，但也有拖沓的一面"}, {"type": "subtitle", "time": 21571.91, "timestamp": "05:59:31", "text": "里面。他耸了耸肩。他拿走了一大袋东西。"}, {"type": "subtitle", "time": 21573.35, "timestamp": "05:59:33", "text": "他仰面躺下，然后倒在地上"}, {"type": "subtitle", "time": 21576.948, "timestamp": "05:59:36", "text": "揭露他的行为。显示项目 水"}, {"type": "subtitle", "time": 21577.96, "timestamp": "05:59:37", "text": "的"}, {"type": "subtitle", "time": 21579.788, "timestamp": "05:59:39", "text": "[音乐]"}, {"type": "subtitle", "time": 21582.39, "timestamp": "05:59:42", "text": "开始涂鸦。当他讲完之后，"}, {"type": "subtitle", "time": 21586.19, "timestamp": "05:59:46", "text": "他抬起一条路，通往更深处"}, {"type": "subtitle", "time": 21591.45, "timestamp": "05:59:51", "text": "啊，交易。哦，他有东西可以交换。"}, {"type": "subtitle", "time": 21594.19, "timestamp": "05:59:54", "text": "[音乐]"}]
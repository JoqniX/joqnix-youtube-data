[{"type": "subtitle", "time": 6120.07, "timestamp": "01:42:00", "text": "好的。我们上次就是这么做的。呃"}, {"type": "subtitle", "time": 6122.629, "timestamp": "01:42:02", "text": "所以今天我们可能会从事以下工作："}, {"type": "subtitle", "time": 6125.99, "timestamp": "01:42:05", "text": "内侧。然后我们将扩大规模"}, {"type": "subtitle", "time": 6128.39, "timestamp": "01:42:08", "text": "整个区域，使其成为另一个"}, {"type": "subtitle", "time": 6131.55, "timestamp": "01:42:11", "text": "大地板"}, {"type": "subtitle", "time": 6134.47, "timestamp": "01:42:14", "text": "东西。所以，是的，我以后会成为那样的人。"}, {"type": "subtitle", "time": 6137.03, "timestamp": "01:42:17", "text": "正在做。我为什么要玩这个游戏？"}, {"type": "subtitle", "time": 6141.109, "timestamp": "01:42:21", "text": "预计？所以，呃，是的，我们收到了一份"}, {"type": "subtitle", "time": 6145.109, "timestamp": "01:42:25", "text": "来自阿鲁坦的礼物。这就是这把铲子。我"}, {"type": "subtitle", "time": 6148.51, "timestamp": "01:42:28", "text": "我相信这是由……提供的"}, {"type": "subtitle", "time": 6152.47, "timestamp": "01:42:32", "text": "阿鲁萨。呃，我把原须的房子炸了。"}, {"type": "subtitle", "time": 6161.91, "timestamp": "01:42:41", "text": "嗯？然后带走了你的狐狸。什么？嗯？我曾"}, {"type": "subtitle", "time": 6162.91, "timestamp": "01:42:42", "text": "一个"}, {"type": "subtitle", "time": 6165.47, "timestamp": "01:42:45", "text": "狐狸。我做了。"}, {"type": "subtitle", "time": 6168.75, "timestamp": "01:42:48", "text": "什么？哦，我的"}]
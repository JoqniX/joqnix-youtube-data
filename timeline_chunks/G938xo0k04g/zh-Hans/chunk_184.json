[{"type": "subtitle", "time": 11042.59, "timestamp": "03:04:02", "text": "东西。是的，还要添加其他东西。"}, {"type": "subtitle", "time": 11046.87, "timestamp": "03:04:06", "text": "所以，我今天为什么这么累？我"}, {"type": "subtitle", "time": 11047.63, "timestamp": "03:04:07", "text": "不"}, {"type": "subtitle", "time": 11052.67, "timestamp": "03:04:12", "text": "知道。我想嘘，但我做不到"}, {"type": "subtitle", "time": 11062.309, "timestamp": "03:04:22", "text": "明天。我得做好准备，尽管如此。"}, {"type": "subtitle", "time": 11070.67, "timestamp": "03:04:30", "text": "原因。光"}, {"type": "subtitle", "time": 11074.389, "timestamp": "03:04:34", "text": "照亮。我的目标是什么？什么"}, {"type": "subtitle", "time": 11076.389, "timestamp": "03:04:36", "text": "我在做什么？"}, {"type": "subtitle", "time": 11079.389, "timestamp": "03:04:39", "text": "我为什么要建造一堵墙？"}, {"type": "subtitle", "time": 11085.309, "timestamp": "03:04:45", "text": "火？为什么我的理想会告诉你"}, {"type": "subtitle", "time": 11091.51, "timestamp": "03:04:51", "text": "画？我要去拿我的平板电脑。患病的"}]
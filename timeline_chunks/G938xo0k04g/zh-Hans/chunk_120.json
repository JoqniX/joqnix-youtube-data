[{"type": "subtitle", "time": 7201.95, "timestamp": "02:00:01", "text": "这里。我愿意"}, {"type": "subtitle", "time": 7203.44, "timestamp": "02:00:03", "text": "结束"}, {"type": "subtitle", "time": 7206.03, "timestamp": "02:00:06", "text": "[音乐]"}, {"type": "subtitle", "time": 7208.47, "timestamp": "02:00:08", "text": "这里。他们可以吗？哦，是的，他们会的。"}, {"type": "subtitle", "time": 7210.95, "timestamp": "02:00:10", "text": "来。他们要完蛋了。是的。"}, {"type": "subtitle", "time": 7214.07, "timestamp": "02:00:14", "text": "是的。下去。互相激励。是的。"}, {"type": "subtitle", "time": 7216.79, "timestamp": "02:00:16", "text": "一。一个摔倒了。互相激励。"}, {"type": "subtitle", "time": 7220.91, "timestamp": "02:00:20", "text": "是的。推。是的。是的。"}, {"type": "subtitle", "time": 7223.75, "timestamp": "02:00:23", "text": "哦，我摔倒了，我的天哪。不，不，不。"}, {"type": "subtitle", "time": 7225.03, "timestamp": "02:00:25", "text": "这很糟糕。这很糟糕。这很糟糕。"}, {"type": "subtitle", "time": 7226.55, "timestamp": "02:00:26", "text": "这很糟糕。这很糟糕。哦，不。不。不。"}, {"type": "subtitle", "time": 7227.149, "timestamp": "02:00:27", "text": "不，不，不，不，不，不，不，不。"}, {"type": "subtitle", "time": 7229.83, "timestamp": "02:00:29", "text": "不。你为什么会摔倒？你为什么会摔倒？"}, {"type": "subtitle", "time": 7236.709, "timestamp": "02:00:36", "text": "主。凯特，你为什么会在我家？"}, {"type": "subtitle", "time": 7246.55, "timestamp": "02:00:46", "text": "你来过这里，是吗？我的天哪，"}, {"type": "subtitle", "time": 7249.31, "timestamp": "02:00:49", "text": "丧尸来了。什么？"}, {"type": "subtitle", "time": 7252.35, "timestamp": "02:00:52", "text": "如何？让我先说明一下"}]
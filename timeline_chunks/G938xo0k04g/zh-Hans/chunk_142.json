[{"type": "subtitle", "time": 8527.59, "timestamp": "02:22:07", "text": "美好的。等等，这是要一个一个地进行。"}, {"type": "subtitle", "time": 8529.67, "timestamp": "02:22:09", "text": "呃，等等。"}, {"type": "subtitle", "time": 8532.429, "timestamp": "02:22:12", "text": "某种可以"}, {"type": "subtitle", "time": 8535.55, "timestamp": "02:22:15", "text": "思考。这样不是更好吗？巴克"}, {"type": "subtitle", "time": 8538.99, "timestamp": "02:22:18", "text": "向上。难道不是这样吗？"}, {"type": "subtitle", "time": 8541.75, "timestamp": "02:22:21", "text": "更好的？冶炼设备在哪儿？我"}, {"type": "subtitle", "time": 8544.03, "timestamp": "02:22:24", "text": "我觉得应该没有冶炼之类的东西。"}, {"type": "subtitle", "time": 8548.83, "timestamp": "02:22:28", "text": "正确的？啊，等等。我得把这个做成菜。哦"}, {"type": "subtitle", "time": 8551.75, "timestamp": "02:22:31", "text": "男人。抽烟。我的天哪。我没有"}, {"type": "subtitle", "time": 8560.389, "timestamp": "02:22:40", "text": "和。哦，他参加了冰桶挑战。好的。"}, {"type": "subtitle", "time": 8562.19, "timestamp": "02:22:42", "text": "我是"}, {"type": "subtitle", "time": 8564.67, "timestamp": "02:22:44", "text": "未来。太迟了"}, {"type": "subtitle", "time": 8567.99, "timestamp": "02:22:47", "text": "让我接受并记住这一点"}]
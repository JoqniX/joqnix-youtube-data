[{"type": "subtitle", "time": 7081.51, "timestamp": "01:58:01", "text": "上面可能只有一层水之类的东西。"}, {"type": "subtitle", "time": 7084.229, "timestamp": "01:58:04", "text": "我其实完全不知道自己在尝试什么。"}, {"type": "subtitle", "time": 7086.35, "timestamp": "01:58:06", "text": "在这里实现这一点，但是"}, {"type": "subtitle", "time": 7090.149, "timestamp": "01:58:10", "text": "好的。我看看我自己做饭怎么样。"}, {"type": "subtitle", "time": 7094.43, "timestamp": "01:58:14", "text": "然后看看这东西在哪儿"}, {"type": "subtitle", "time": 7097.629, "timestamp": "01:58:17", "text": "走，我"}, {"type": "subtitle", "time": 7100.55, "timestamp": "01:58:20", "text": "猜测。疼痛。我到底在尝试什么？"}, {"type": "subtitle", "time": 7106.149, "timestamp": "01:58:26", "text": "圣。"}, {"type": "subtitle", "time": 7107.99, "timestamp": "01:58:27", "text": "哦，等等。其实这也不算坏事"}, {"type": "subtitle", "time": 7110.55, "timestamp": "01:58:30", "text": "主意。"}, {"type": "subtitle", "time": 7112.79, "timestamp": "01:58:32", "text": "哦，这其实是个不错的主意。"}, {"type": "subtitle", "time": 7117.109, "timestamp": "01:58:37", "text": "就像这东西一样独特。哦，那是"}, {"type": "subtitle", "time": 7118.95, "timestamp": "01:58:38", "text": "这主意真不错。等等，我应该……"}, {"type": "subtitle", "time": 7122.27, "timestamp": "01:58:42", "text": "应该针对所有尺寸都这样做"}, {"type": "subtitle", "time": 7125.43, "timestamp": "01:58:45", "text": "然后。一二三。一二三。"}, {"type": "subtitle", "time": 7134.27, "timestamp": "01:58:54", "text": "呃，"}, {"type": "subtitle", "time": 7138.189, "timestamp": "01:58:58", "text": "我的天啊，他们简直像一群乌合之众。"}]
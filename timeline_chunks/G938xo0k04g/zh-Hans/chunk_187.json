[{"type": "subtitle", "time": 11220.55, "timestamp": "03:07:00", "text": "平板电脑，等等，你能玩《我的世界》吗？"}, {"type": "subtitle", "time": 11222.95, "timestamp": "03:07:02", "text": "像这样？等等，等等，等等，等等，等等，"}, {"type": "subtitle", "time": 11224.99, "timestamp": "03:07:04", "text": "等等，这是"}, {"type": "subtitle", "time": 11227.59, "timestamp": "03:07:07", "text": "凉爽的。等等，这很酷。等等，这是"}, {"type": "subtitle", "time": 11230.469, "timestamp": "03:07:10", "text": "就像我在使用控制器一样。我的天啊，"}, {"type": "subtitle", "time": 11232.59, "timestamp": "03:07:12", "text": "这实际上是"}, {"type": "subtitle", "time": 11240.15, "timestamp": "03:07:20", "text": "它？再看看它。哦，就像我的"}, {"type": "subtitle", "time": 11247.63, "timestamp": "03:07:27", "text": "哇。"}, {"type": "subtitle", "time": 11257.23, "timestamp": "03:07:37", "text": "[笑声]"}, {"type": "subtitle", "time": 11260.469, "timestamp": "03:07:40", "text": "这。太酷了！就像我只是"}, {"type": "subtitle", "time": 11264.67, "timestamp": "03:07:44", "text": "握住它，就像倾斜尖端一样"}, {"type": "subtitle", "time": 11268.19, "timestamp": "03:07:48", "text": "平底锅。这是什么？感觉就像我正处于……"}, {"type": "subtitle", "time": 11271.67, "timestamp": "03:07:51", "text": "控制器。我头晕了。"}, {"type": "subtitle", "time": 11274.349, "timestamp": "03:07:54", "text": "我的头是"}, {"type": "subtitle", "time": 11278.15, "timestamp": "03:07:58", "text": "晕眩的。我的天哪。总之，呃，还是回到鼠标的话题吧。"}]
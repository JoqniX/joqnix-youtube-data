[{"type": "subtitle", "time": 12968.63, "timestamp": "03:36:08", "text": "友多阿基？你想查一下。"}, {"type": "subtitle", "time": 12982.11, "timestamp": "03:36:22", "text": "但我仍然会在这里。不，我将"}, {"type": "subtitle", "time": 12985.349, "timestamp": "03:36:25", "text": "嗯，给你准备点好东西。我不知道"}, {"type": "subtitle", "time": 12988.389, "timestamp": "03:36:28", "text": "如果你能喂北极熊的话。等等，我想要"}, {"type": "subtitle", "time": 12994.67, "timestamp": "03:36:34", "text": "查看。你能喂北极熊吗？"}, {"type": "subtitle", "time": 12997.91, "timestamp": "03:36:37", "text": "我的世界？等等，请告诉我你能做到。"}, {"type": "subtitle", "time": 13000.03, "timestamp": "03:36:40", "text": "你玩"}, {"type": "subtitle", "time": 13019.75, "timestamp": "03:36:59", "text": "好了，我回来了。你好。我还活着。我太"}]
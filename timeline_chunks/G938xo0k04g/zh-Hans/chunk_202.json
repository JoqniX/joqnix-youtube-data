[{"type": "subtitle", "time": 12120.87, "timestamp": "03:22:00", "text": "建造？我不知道。我们选择"}, {"type": "subtitle", "time": 12123.99, "timestamp": "03:22:03", "text": "我想，大概是顺其自然吧。我相信我们"}, {"type": "subtitle", "time": 12126.19, "timestamp": "03:22:06", "text": "嗯，顺其自然吧。"}, {"type": "subtitle", "time": 12129.269, "timestamp": "03:22:09", "text": "你好。就像我的铁斧一样。我什么时候得到一个"}, {"type": "subtitle", "time": 12134.23, "timestamp": "03:22:14", "text": "什么？"}, {"type": "subtitle", "time": 12138.429, "timestamp": "03:22:18", "text": "[音乐]"}, {"type": "subtitle", "time": 12140.75, "timestamp": "03:22:20", "text": "H. 哦，他得到了"}, {"type": "subtitle", "time": 12142.83, "timestamp": "03:22:22", "text": "解除禁令。"}, {"type": "subtitle", "time": 12149.55, "timestamp": "03:22:29", "text": "后退。"}, {"type": "subtitle", "time": 12154.11, "timestamp": "03:22:34", "text": "但请确保你"}, {"type": "subtitle", "time": 12178.03, "timestamp": "03:22:58", "text": "宠物，因为我会尝试复制"}]
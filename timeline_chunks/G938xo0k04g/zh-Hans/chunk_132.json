[{"type": "subtitle", "time": 7933.069, "timestamp": "02:12:13", "text": "这是我给你的"}, {"type": "subtitle", "time": 7941.79, "timestamp": "02:12:21", "text": "好的。我去取水。"}, {"type": "subtitle", "time": 7944.99, "timestamp": "02:12:24", "text": "呃，那么，他去哪儿了？"}, {"type": "subtitle", "time": 7956.39, "timestamp": "02:12:36", "text": "掉落。它掉下来了吗？"}, {"type": "subtitle", "time": 7959.75, "timestamp": "02:12:39", "text": "某处？哦，呵呵，他没明白。"}, {"type": "subtitle", "time": 7965.03, "timestamp": "02:12:45", "text": "好的，不错。我要去那里。好的，"}, {"type": "subtitle", "time": 7977.95, "timestamp": "02:12:57", "text": "它。我们来做一个"}, {"type": "subtitle", "time": 7979.41, "timestamp": "02:12:59", "text": "竞赛。"}]
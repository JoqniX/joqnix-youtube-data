[{"type": "subtitle", "time": 20761.57, "timestamp": "05:46:01", "text": "这。所以"}, {"type": "subtitle", "time": 20764.59, "timestamp": "05:46:04", "text": "[掌声]"}, {"type": "subtitle", "time": 20768.27, "timestamp": "05:46:08", "text": "是的，我们还要再熬过这一夜。"}, {"type": "subtitle", "time": 20778.03, "timestamp": "05:46:18", "text": "正确的。我已经开始犯困了。"}, {"type": "subtitle", "time": 20781.19, "timestamp": "05:46:21", "text": "疲劳的。只需一个小时。是因为我"}, {"type": "subtitle", "time": 20784.11, "timestamp": "05:46:24", "text": "这些天我根本睡不着觉"}, {"type": "subtitle", "time": 20787.788, "timestamp": "05:46:27", "text": "天？我不知道。是，是"}, {"type": "subtitle", "time": 20790.31, "timestamp": "05:46:30", "text": "美好的。就像昨天一样，对吧？你"}, {"type": "subtitle", "time": 20792.39, "timestamp": "05:46:32", "text": "记得我刚才说的，我是"}, {"type": "subtitle", "time": 20795.19, "timestamp": "05:46:35", "text": "感觉想吐，而且感觉非常难受"}, {"type": "subtitle", "time": 20797.99, "timestamp": "05:46:37", "text": "生病的。是的，今天的感觉也一样。"}, {"type": "subtitle", "time": 20800.628, "timestamp": "05:46:40", "text": "出色地。我的意思是，我想主要是"}, {"type": "subtitle", "time": 20801.868, "timestamp": "05:46:41", "text": "由于"}, {"type": "subtitle", "time": 20805.15, "timestamp": "05:46:45", "text": "睡眠那玩意儿"}, {"type": "subtitle", "time": 20807.43, "timestamp": "05:46:47", "text": "问题。请说明您需要的时间"}, {"type": "subtitle", "time": 20808.868, "timestamp": "05:46:48", "text": "完成它。绝对值得。"}, {"type": "subtitle", "time": 20810.868, "timestamp": "05:46:50", "text": "是的。是的。是的。是的。我当时其实"}, {"type": "subtitle", "time": 20813.35, "timestamp": "05:46:53", "text": "想着就像做12个小时"}]
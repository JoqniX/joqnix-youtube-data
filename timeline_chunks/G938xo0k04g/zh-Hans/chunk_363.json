[{"type": "subtitle", "time": 21785.07, "timestamp": "06:03:05", "text": "我真的需要一台发电机。"}, {"type": "subtitle", "time": 21791.67, "timestamp": "06:03:11", "text": "燃料。问题是，我确实有点想……"}, {"type": "subtitle", "time": 21796.86, "timestamp": "06:03:16", "text": "从他们那里购买商品。但遗憾的是，我就像……"}, {"type": "subtitle", "time": 21799.15, "timestamp": "06:03:19", "text": "[音乐]"}, {"type": "subtitle", "time": 21805.99, "timestamp": "06:03:25", "text": "坏消息是我没有太多东西要买"}, {"type": "subtitle", "time": 21807.74, "timestamp": "06:03:27", "text": "给他。"}, {"type": "subtitle", "time": 21814.548, "timestamp": "06:03:34", "text": "[音乐]"}, {"type": "subtitle", "time": 21817.27, "timestamp": "06:03:37", "text": "咱们给他来点酒喝吧。那"}, {"type": "subtitle", "time": 21818.91, "timestamp": "06:03:38", "text": "不会有什么作用。"}, {"type": "subtitle", "time": 21824.91, "timestamp": "06:03:44", "text": "40 块肉。不。地毯绳。"}, {"type": "subtitle", "time": 21839.59, "timestamp": "06:03:59", "text": "[音乐]"}]
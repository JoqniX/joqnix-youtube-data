[{"type": "subtitle", "time": 6794.31, "timestamp": "01:53:14", "text": "这里。问题是，我只是想……"}, {"type": "subtitle", "time": 6797.83, "timestamp": "01:53:17", "text": "就像你知道的，就像我想要的，想要"}, {"type": "subtitle", "time": 6801.669, "timestamp": "01:53:21", "text": "像这样，像单数一样，但你必须"}, {"type": "subtitle", "time": 6804.79, "timestamp": "01:53:24", "text": "建立支持平台以及所有这些"}, {"type": "subtitle", "time": 6808.629, "timestamp": "01:53:28", "text": "真是些乱七八糟的事，我跟你说。"}, {"type": "subtitle", "time": 6813.03, "timestamp": "01:53:33", "text": "所以我的想法是，就让我……"}, {"type": "subtitle", "time": 6816.87, "timestamp": "01:53:36", "text": "现在就这么说吧。所以"}, {"type": "subtitle", "time": 6820.07, "timestamp": "01:53:40", "text": "我的想法是移除这个，而这只是"}, {"type": "subtitle", "time": 6822.27, "timestamp": "01:53:42", "text": "像这样"}, {"type": "subtitle", "time": 6824.55, "timestamp": "01:53:44", "text": "实际上。哦等等，这其实是"}, {"type": "subtitle", "time": 6827.31, "timestamp": "01:53:47", "text": "挺酷的。等等，这个设计真酷。"}]
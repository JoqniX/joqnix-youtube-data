[{"type": "subtitle", "time": 7142.83, "timestamp": "01:59:02", "text": "向上。我的天哪，他们试图……"}, {"type": "subtitle", "time": 7146.149, "timestamp": "01:59:06", "text": "过量麦芽。我的天啊。一二三，"}, {"type": "subtitle", "time": 7149.149, "timestamp": "01:59:09", "text": "四，五。我的天哪，他们来了"}, {"type": "subtitle", "time": 7150.99, "timestamp": "01:59:10", "text": "我。哦"}, {"type": "subtitle", "time": 7155.32, "timestamp": "01:59:15", "text": "是的。我的天哪。好的。"}, {"type": "subtitle", "time": 7157.43, "timestamp": "01:59:17", "text": "[笑声]"}, {"type": "subtitle", "time": 7169.149, "timestamp": "01:59:29", "text": "向下。没关系。我应该关门了"}, {"type": "subtitle", "time": 7170.83, "timestamp": "01:59:30", "text": "这"}, {"type": "subtitle", "time": 7173.83, "timestamp": "01:59:33", "text": "安全。想象一下僵尸们成群结队地聚集在一起……"}, {"type": "subtitle", "time": 7177.35, "timestamp": "01:59:37", "text": "就像筑墙一样。就像攀岩一样"}, {"type": "subtitle", "time": 7179.99, "timestamp": "01:59:39", "text": "可攀爬的墙壁。就像你知道的僵尸一样"}, {"type": "subtitle", "time": 7182.629, "timestamp": "01:59:42", "text": "部落战术有效，对吧？所以他们喜欢看到你"}, {"type": "subtitle", "time": 7184.55, "timestamp": "01:59:44", "text": "然后试图互相爬到对方身上。"}, {"type": "subtitle", "time": 7188.07, "timestamp": "01:59:48", "text": "如果他们真那么聪明，就会起床。"}, {"type": "subtitle", "time": 7190.03, "timestamp": "01:59:50", "text": "哦，我的"}, {"type": "subtitle", "time": 7194.99, "timestamp": "01:59:54", "text": "我的天，那真是太棒了。"}, {"type": "subtitle", "time": 7198.83, "timestamp": "01:59:58", "text": "片刻。是的，我又重做了一遍。"}]
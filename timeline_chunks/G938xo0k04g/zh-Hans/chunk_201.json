[{"type": "subtitle", "time": 12060.87, "timestamp": "03:21:00", "text": "呃，复制粘贴。呃，没有隔间。呃，我想要"}, {"type": "subtitle", "time": 12075.87, "timestamp": "03:21:15", "text": "不。哦，嗯，有个……"}, {"type": "subtitle", "time": 12079.83, "timestamp": "03:21:19", "text": "嗯，隔间。是的，我想像我一样"}, {"type": "subtitle", "time": 12081.75, "timestamp": "03:21:21", "text": "想绘制碟形天线示意图。我想要"}, {"type": "subtitle", "time": 12085.349, "timestamp": "03:21:25", "text": "就像制定蓝图一样，你知道的，就像有"}, {"type": "subtitle", "time": 12088.63, "timestamp": "03:21:28", "text": "我当时有个想法，想建造什么。"}, {"type": "subtitle", "time": 12092.469, "timestamp": "03:21:32", "text": "与其听我的，不如自己动手。哦"}, {"type": "subtitle", "time": 12095.349, "timestamp": "03:21:35", "text": "等等，这看起来真的好酷。嗯？"}, {"type": "subtitle", "time": 12105.19, "timestamp": "03:21:45", "text": "好的。不过，这本身就很漂亮。"}, {"type": "subtitle", "time": 12107.71, "timestamp": "03:21:47", "text": "我自己，但我希望它公平。"}, {"type": "subtitle", "time": 12110.79, "timestamp": "03:21:50", "text": "具有威胁性。但想想骑师。你想要"}, {"type": "subtitle", "time": 12111.87, "timestamp": "03:21:51", "text": "威胁"}, {"type": "subtitle", "time": 12113.55, "timestamp": "03:21:53", "text": "或者"}, {"type": "subtitle", "time": 12116.349, "timestamp": "03:21:56", "text": "纯的？你想要邪恶吗？"}, {"type": "subtitle", "time": 12119.11, "timestamp": "03:21:59", "text": "好的？我不知道。我到底想做什么？"}]
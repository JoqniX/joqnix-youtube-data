[{"type": "subtitle", "time": 8461.51, "timestamp": "02:21:01", "text": "用一句话来表达。这就像……这就像……"}, {"type": "subtitle", "time": 8464.79, "timestamp": "02:21:04", "text": "带盖的烹饪锅，你可以"}, {"type": "subtitle", "time": 8467.95, "timestamp": "02:21:07", "text": "握住把手或"}, {"type": "subtitle", "time": 8470.389, "timestamp": "02:21:10", "text": "某物。好的，我们会努力的。"}, {"type": "subtitle", "time": 8473.11, "timestamp": "02:21:13", "text": "在此之前，让我先处理一下猫的事情。"}, {"type": "subtitle", "time": 8474.349, "timestamp": "02:21:14", "text": "在哪里？"}, {"type": "subtitle", "time": 8479.27, "timestamp": "02:21:19", "text": "卡特索？另外，我还需要食物。呃"}, {"type": "subtitle", "time": 8482.63, "timestamp": "02:21:22", "text": "我想做那个用水桶浇水的事。"}, {"type": "subtitle", "time": 8485.99, "timestamp": "02:21:25", "text": "希望我这么做。"}, {"type": "subtitle", "time": 8496.429, "timestamp": "02:21:36", "text": "这？呃，我非常抱歉。"}, {"type": "subtitle", "time": 8500.63, "timestamp": "02:21:40", "text": "但我需要活下去。"}, {"type": "subtitle", "time": 8505.67, "timestamp": "02:21:45", "text": "嗯，目前为止是这样。我会去拿，然后上来。"}, {"type": "subtitle", "time": 8513.03, "timestamp": "02:21:53", "text": "哦，等等。甜瓜是不是太贵了？我"}]
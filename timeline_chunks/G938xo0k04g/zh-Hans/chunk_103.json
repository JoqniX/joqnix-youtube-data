[{"type": "subtitle", "time": 6185.75, "timestamp": "01:43:05", "text": "所以，呃，事情是这样的，因为这个"}, {"type": "subtitle", "time": 6189.51, "timestamp": "01:43:09", "text": "这个装置，呃，这个系统一"}, {"type": "subtitle", "time": 6191.31, "timestamp": "01:43:11", "text": "需要打开的东西"}, {"type": "subtitle", "time": 6196.149, "timestamp": "01:43:16", "text": "这个和这个东西用来打开这个玩意儿。"}, {"type": "subtitle", "time": 6202.03, "timestamp": "01:43:22", "text": "我。"}, {"type": "subtitle", "time": 6205.27, "timestamp": "01:43:25", "text": "哇。所有丧尸都在这里。你知道吗"}, {"type": "subtitle", "time": 6211.99, "timestamp": "01:43:31", "text": "睡眠将它埋葬在地下。我的天啊。"}, {"type": "subtitle", "time": 6215.87, "timestamp": "01:43:35", "text": "你正处于邪恶的阶段。我"}, {"type": "subtitle", "time": 6221.62, "timestamp": "01:43:41", "text": "看看这些男人和男人的弧线"}, {"type": "subtitle", "time": 6231.669, "timestamp": "01:43:51", "text": "混乱。现在这只狐狸可以搬出去了，我"}, {"type": "subtitle", "time": 6234.149, "timestamp": "01:43:54", "text": "猜测。"}, {"type": "subtitle", "time": 6235.03, "timestamp": "01:43:55", "text": "你可以吗"}]
[{"type": "subtitle", "time": 19689.07, "timestamp": "05:28:09", "text": "图案。所以，你们觉得怎么样？"}, {"type": "subtitle", "time": 19692.07, "timestamp": "05:28:12", "text": "远的？我现在感觉好困，好累。"}, {"type": "subtitle", "time": 19697.59, "timestamp": "05:28:17", "text": "我觉得我需要更频繁地练习。"}, {"type": "subtitle", "time": 19701.43, "timestamp": "05:28:21", "text": "天。至少一个小时。这很糟糕。这"}, {"type": "subtitle", "time": 19718.628, "timestamp": "05:28:38", "text": "我觉得我越习惯……"}, {"type": "subtitle", "time": 19721.75, "timestamp": "05:28:41", "text": "软件，以及我所了解的姿势，都让我更加了解。"}, {"type": "subtitle", "time": 19724.47, "timestamp": "05:28:44", "text": "该做什么，以及所有的事情，比如在哪里。"}, {"type": "subtitle", "time": 19728.07, "timestamp": "05:28:48", "text": "点击以及在哪里播放音乐"}, {"type": "subtitle", "time": 19729.23, "timestamp": "05:28:49", "text": "一切。"}]
[{"type": "subtitle", "time": 8893.59, "timestamp": "02:28:13", "text": "自由的。我会给你三块泥土。"}, {"type": "subtitle", "time": 8903.23, "timestamp": "02:28:23", "text": "任何事物。哦，谢谢"}, {"type": "subtitle", "time": 8906.75, "timestamp": "02:28:26", "text": "你。但真是如此吗？"}, {"type": "subtitle", "time": 8914.389, "timestamp": "02:28:34", "text": "好的。好的。水在哪里？"}, {"type": "subtitle", "time": 8920.27, "timestamp": "02:28:40", "text": "尽管？啊，谢谢"}, {"type": "subtitle", "time": 8923.11, "timestamp": "02:28:43", "text": "你。等等，我刚才展示的是一个水桶"}, {"type": "subtitle", "time": 8925.07, "timestamp": "02:28:45", "text": "尽管。等等，那东西去哪儿了？"}, {"type": "subtitle", "time": 8927.79, "timestamp": "02:28:47", "text": "等待。哦，没事了。我根本没看见"}, {"type": "subtitle", "time": 8932.03, "timestamp": "02:28:52", "text": "它。对，还要更多食物。谢谢。什么？"}]
[{"type": "subtitle", "time": 6960.669, "timestamp": "01:56:00", "text": "向上推。"}, {"type": "subtitle", "time": 6967.189, "timestamp": "01:56:07", "text": "主意。我不会报道此事。或许"}, {"type": "subtitle", "time": 6969.669, "timestamp": "01:56:09", "text": "我可能会用水把它盖住。一"}, {"type": "subtitle", "time": 6971.47, "timestamp": "01:56:11", "text": "有一层水，但我没有"}, {"type": "subtitle", "time": 6974.669, "timestamp": "01:56:14", "text": "知道。是的。你好。"}, {"type": "subtitle", "time": 6977.75, "timestamp": "01:56:17", "text": "你好。我忘了回复你的短信了。"}, {"type": "subtitle", "time": 6979.87, "timestamp": "01:56:19", "text": "这条路"}, {"type": "subtitle", "time": 6982.43, "timestamp": "01:56:22", "text": "离开"}, {"type": "subtitle", "time": 6986.589, "timestamp": "01:56:26", "text": "还有，请告诉我什么时候我"}, {"type": "subtitle", "time": 6988.95, "timestamp": "01:56:28", "text": "好的，请告诉我下一个"}, {"type": "subtitle", "time": 6991.39, "timestamp": "01:56:31", "text": "指示。"}, {"type": "subtitle", "time": 6994.03, "timestamp": "01:56:34", "text": "好的。我确实读过"}, {"type": "subtitle", "time": 6998.189, "timestamp": "01:56:38", "text": "规则那玩意儿"}, {"type": "subtitle", "time": 7009.629, "timestamp": "01:56:49", "text": "嗯，好的。等待。呃，回去"}, {"type": "subtitle", "time": 7012.589, "timestamp": "01:56:52", "text": "趴下，兄弟。"}, {"type": "subtitle", "time": 7016.83, "timestamp": "01:56:56", "text": "停止。如何快速制作工艺品"}]
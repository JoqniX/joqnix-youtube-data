[{"type": "subtitle", "time": 4226.31, "timestamp": "01:10:26", "text": "嗯，还有，《麦加》动画也是在……时期推出的。"}, {"type": "subtitle", "time": 4229.03, "timestamp": "01:10:29", "text": "方式。你听过的那首歌是我尝试翻唱的"}, {"type": "subtitle", "time": 4231.83, "timestamp": "01:10:31", "text": "还可以试着唱歌，对吧？以及"}, {"type": "subtitle", "time": 4233.83, "timestamp": "01:10:33", "text": "我刚才哼的旋律，"}, {"type": "subtitle", "time": 4235.07, "timestamp": "01:10:35", "text": "动漫来了"}, {"type": "subtitle", "time": 4240.87, "timestamp": "01:10:40", "text": "出去了，我相信CF是呃是"}, {"type": "subtitle", "time": 4245.189, "timestamp": "01:10:45", "text": "开头结束呃结束呃ed嗯嗯"}, {"type": "subtitle", "time": 4248.229, "timestamp": "01:10:48", "text": "音乐由K创作。而我唱的那首歌是"}, {"type": "subtitle", "time": 4251.43, "timestamp": "01:10:51", "text": "唱着《No Melon No Lemon》里的那首歌"}, {"type": "subtitle", "time": 4253.35, "timestamp": "01:10:53", "text": "那将在下半场进行"}, {"type": "subtitle", "time": 4255.59, "timestamp": "01:10:55", "text": "日本动画片。下半场大概会是这样"}, {"type": "subtitle", "time": 4257.63, "timestamp": "01:10:57", "text": "从第6集开始或"}]
[{"type": "subtitle", "time": 20481.39, "timestamp": "05:41:21", "text": "令人遗憾。这是什么？破坏"}, {"type": "subtitle", "time": 20483.27, "timestamp": "05:41:23", "text": "岩石。感谢"}, {"type": "subtitle", "time": 20487.07, "timestamp": "05:41:27", "text": "[音乐]"}, {"type": "subtitle", "time": 20489.91, "timestamp": "05:41:29", "text": "你。我不想用路障把它封锁起来。我可以"}, {"type": "subtitle", "time": 20493.03, "timestamp": "05:41:33", "text": "进来吧。我的天，还有更多"}, {"type": "subtitle", "time": 20495.99, "timestamp": "05:41:35", "text": "狗。我需要去。不，不，不，不，不，"}, {"type": "subtitle", "time": 20498.51, "timestamp": "05:41:38", "text": "不，不。并非如此"}, {"type": "subtitle", "time": 20505.39, "timestamp": "05:41:45", "text": "我的天，这太可怕了。"}, {"type": "subtitle", "time": 20509.948, "timestamp": "05:41:49", "text": "地方。他们会来吗？他们不是"}, {"type": "subtitle", "time": 20514.17, "timestamp": "05:41:54", "text": "未来。哟，小子。"}, {"type": "subtitle", "time": 20515.51, "timestamp": "05:41:55", "text": "[音乐]"}, {"type": "subtitle", "time": 20519.868, "timestamp": "05:41:59", "text": "所以，这款游戏里的对话真的……"}]
[{"type": "subtitle", "time": 21900.32, "timestamp": "06:05:00", "text": "将会发生什么？"}, {"type": "subtitle", "time": 21901.948, "timestamp": "06:05:01", "text": "[音乐]"}, {"type": "subtitle", "time": 21904.08, "timestamp": "06:05:04", "text": "听着，我会问……"}, {"type": "subtitle", "time": 21915.47, "timestamp": "06:05:15", "text": "这。不，不，不"}, {"type": "subtitle", "time": 21918.83, "timestamp": "06:05:18", "text": "等待。那也是个馊主意。"}, {"type": "subtitle", "time": 21935.51, "timestamp": "06:05:35", "text": "不。他摇了摇头。不。是的。是的。"}, {"type": "subtitle", "time": 21943.548, "timestamp": "06:05:43", "text": "挑剔。所以我们已经通过了两次"}, {"type": "subtitle", "time": 21945.708, "timestamp": "06:05:45", "text": "天"}, {"type": "subtitle", "time": 21949.788, "timestamp": "06:05:49", "text": "现在。车在哪儿？"}, {"type": "subtitle", "time": 21953.83, "timestamp": "06:05:53", "text": "好的。那么，我们今天的分享就到此结束了。"}, {"type": "subtitle", "time": 21954.26, "timestamp": "06:05:54", "text": "为了"}, {"type": "subtitle", "time": 21955.788, "timestamp": "06:05:55", "text": "[音乐]"}, {"type": "subtitle", "time": 21958.708, "timestamp": "06:05:58", "text": "现在。我今天就先说到这儿吧。"}]
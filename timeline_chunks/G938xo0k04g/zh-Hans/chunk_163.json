[{"type": "subtitle", "time": 9791.99, "timestamp": "02:43:11", "text": "我在等他上来，这样我就可以"}, {"type": "subtitle", "time": 9794.67, "timestamp": "02:43:14", "text": "把我的船还给我"}, {"type": "subtitle", "time": 9798.55, "timestamp": "02:43:18", "text": "向上。我好像看到他以像素的形式出现了。"}, {"type": "subtitle", "time": 9809.55, "timestamp": "02:43:29", "text": "那里。看看"}, {"type": "subtitle", "time": 9812.91, "timestamp": "02:43:32", "text": "天空。好了，我的船来了。"}, {"type": "subtitle", "time": 9815.83, "timestamp": "02:43:35", "text": "耶。所以，你右键点击该位置，然后"}, {"type": "subtitle", "time": 9817.83, "timestamp": "02:43:37", "text": "点击右键进入，不要点击左键。"}, {"type": "subtitle", "time": 9820.91, "timestamp": "02:43:40", "text": "好吧，我的错误是向左了。"}, {"type": "subtitle", "time": 9827.429, "timestamp": "02:43:47", "text": "他们。你知道当你看那些视频的时候"}]
[{"type": "subtitle", "time": 18602.628, "timestamp": "05:10:02", "text": "我的芒果树好像在摇晃"}, {"type": "subtitle", "time": 18606.18, "timestamp": "05:10:06", "text": "疯狂的。时间就像……"}, {"type": "subtitle", "time": 18608.67, "timestamp": "05:10:08", "text": "[音乐]"}, {"type": "subtitle", "time": 18614.91, "timestamp": "05:10:14", "text": "摇晃。它是"}, {"type": "subtitle", "time": 18619.15, "timestamp": "05:10:19", "text": "风很大。树木在摇晃"}, {"type": "subtitle", "time": 18622.47, "timestamp": "05:10:22", "text": "无法控制。我的天啊。我能听到我"}, {"type": "subtitle", "time": 18626.03, "timestamp": "05:10:26", "text": "能感觉到微风吹来"}, {"type": "subtitle", "time": 18628.868, "timestamp": "05:10:28", "text": "外部。好的。信封也是。好的。"}, {"type": "subtitle", "time": 18633.23, "timestamp": "05:10:33", "text": "嗯，我们或许可以做"}, {"type": "subtitle", "time": 18636.02, "timestamp": "05:10:36", "text": "这。"}, {"type": "subtitle", "time": 18659.03, "timestamp": "05:10:59", "text": "会产生共鸣，但听起来不会好听。"}]
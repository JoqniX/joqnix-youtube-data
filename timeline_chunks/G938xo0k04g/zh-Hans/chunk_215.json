[{"type": "subtitle", "time": 12904.79, "timestamp": "03:35:04", "text": "天哪，我感觉想哭。我快要哭了。"}, {"type": "subtitle", "time": 12906.87, "timestamp": "03:35:06", "text": "尽管。其实，我眼眶都湿润了。"}, {"type": "subtitle", "time": 12909.309, "timestamp": "03:35:09", "text": "那种感觉"}, {"type": "subtitle", "time": 12912.79, "timestamp": "03:35:12", "text": "伤心。天哪，我眼泪都快掉下来了。那样"}, {"type": "subtitle", "time": 12913.95, "timestamp": "03:35:13", "text": "毛毡"}, {"type": "subtitle", "time": 12916.03, "timestamp": "03:35:16", "text": "伤心。"}, {"type": "subtitle", "time": 12918.79, "timestamp": "03:35:18", "text": "为什么？我的天啊。等等，我得擦擦我的"}, {"type": "subtitle", "time": 12921.59, "timestamp": "03:35:21", "text": "宝贝，眼泪。我知道。我没开玩笑。我"}, {"type": "subtitle", "time": 12929.389, "timestamp": "03:35:29", "text": "离开。你？你为什么看着我？"}, {"type": "subtitle", "time": 12938.91, "timestamp": "03:35:38", "text": "哭。给我一朵花。我会"}, {"type": "subtitle", "time": 12941.309, "timestamp": "03:35:41", "text": "快乐的。给我"}, {"type": "subtitle", "time": 12942.99, "timestamp": "03:35:42", "text": "风味，"}, {"type": "subtitle", "time": 12946.71, "timestamp": "03:35:46", "text": "请。等待。哦。哦。哦。它摇晃了"}, {"type": "subtitle", "time": 12949.349, "timestamp": "03:35:49", "text": "他摇了摇头。它摇了摇头。"}, {"type": "subtitle", "time": 12950.51, "timestamp": "03:35:50", "text": "哦，我的"}, {"type": "subtitle", "time": 12959.11, "timestamp": "03:35:59", "text": "友达。你刚才是不是……不，不，离开了。"}]
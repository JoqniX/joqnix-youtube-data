[{"type": "subtitle", "time": 17704.84, "timestamp": "04:55:04", "text": "延迟确实有点烦人。"}, {"type": "subtitle", "time": 17722.21, "timestamp": "04:55:22", "text": "来。来。来。"}, {"type": "subtitle", "time": 17737.45, "timestamp": "04:55:37", "text": "嗯。"}, {"type": "subtitle", "time": 17739.03, "timestamp": "04:55:39", "text": "[音乐]"}, {"type": "subtitle", "time": 17741.99, "timestamp": "04:55:41", "text": "你从哪来？我来自印度。"}, {"type": "subtitle", "time": 17743.55, "timestamp": "04:55:43", "text": "请。我是一名"}]
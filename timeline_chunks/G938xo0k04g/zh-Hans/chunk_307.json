[{"type": "subtitle", "time": 18423.68, "timestamp": "05:07:03", "text": "鼓。鼓还可以。但还有这一点"}, {"type": "subtitle", "time": 18431.99, "timestamp": "05:07:11", "text": "事物。这样好吗？"}, {"type": "subtitle", "time": 18434.07, "timestamp": "05:07:14", "text": "哦，应该"}, {"type": "subtitle", "time": 18454.35, "timestamp": "05:07:34", "text": "[音乐]"}, {"type": "subtitle", "time": 18458.31, "timestamp": "05:07:38", "text": "所以，我在这里做的就是……放置"}, {"type": "subtitle", "time": 18463.43, "timestamp": "05:07:43", "text": "滤波器上的低频振荡器。"}, {"type": "subtitle", "time": 18465.51, "timestamp": "05:07:45", "text": "所以，它一直在上下波动。"}]
[{"type": "subtitle", "time": 14040.55, "timestamp": "03:54:00", "text": "你讲的故事真精彩。"}, {"type": "subtitle", "time": 14044.15, "timestamp": "03:54:04", "text": "嗯，这真的说明你就像……"}, {"type": "subtitle", "time": 14046.79, "timestamp": "03:54:06", "text": "内容创作者之类的。你说"}, {"type": "subtitle", "time": 14053.269, "timestamp": "03:54:13", "text": "真心喜欢普通人。现在是"}, {"type": "subtitle", "time": 14055.95, "timestamp": "03:54:15", "text": "听起来像是内容创作者的风格"}, {"type": "subtitle", "time": 14061.11, "timestamp": "03:54:21", "text": "会叙述或者说我不知道"}, {"type": "subtitle", "time": 14062.95, "timestamp": "03:54:22", "text": "这让我措手不及。我不知道"}, {"type": "subtitle", "time": 14064.95, "timestamp": "03:54:24", "text": "我不知道自己会收到这样的赞美。"}, {"type": "subtitle", "time": 14070.79, "timestamp": "03:54:30", "text": "是的，每当我"}, {"type": "subtitle", "time": 14074.87, "timestamp": "03:54:34", "text": "我可以直播。嗯，但是"}, {"type": "subtitle", "time": 14076.79, "timestamp": "03:54:36", "text": "是的，我还没说过，就像我正在做……"}, {"type": "subtitle", "time": 14079.55, "timestamp": "03:54:39", "text": "24小时马拉松之类​​的活动"}, {"type": "subtitle", "time": 14084.269, "timestamp": "03:54:44", "text": "这一点，但我也需要提供证据。"}, {"type": "subtitle", "time": 14088.07, "timestamp": "03:54:48", "text": "今天。是的，我正在努力"}, {"type": "subtitle", "time": 14096.229, "timestamp": "03:54:56", "text": "东西。就是这样。"}, {"type": "subtitle", "time": 14098.63, "timestamp": "03:54:58", "text": "那么，该如何录制呢？我想我会"}]
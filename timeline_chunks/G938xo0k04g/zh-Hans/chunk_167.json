[{"type": "subtitle", "time": 10021.269, "timestamp": "02:47:01", "text": "代替你，为了它。所以，如果我玩的话"}, {"type": "subtitle", "time": 10022.03, "timestamp": "02:47:02", "text": "这"}, {"type": "subtitle", "time": 10024.59, "timestamp": "02:47:04", "text": "在这里，我把它放在这里"}, {"type": "subtitle", "time": 10027.71, "timestamp": "02:47:07", "text": "那里。和"}, {"type": "subtitle", "time": 10030.95, "timestamp": "02:47:10", "text": "呃，天哪，我想感受一下压力"}, {"type": "subtitle", "time": 10036.11, "timestamp": "02:47:16", "text": "盘子背面。帮助。这些暴徒是"}, {"type": "subtitle", "time": 10047.23, "timestamp": "02:47:27", "text": "疼痛。哦，你把他们都杀了。好的。是的。"}, {"type": "subtitle", "time": 10049.83, "timestamp": "02:47:29", "text": "我的天哪。不，我要死了。我是"}, {"type": "subtitle", "time": 10056.309, "timestamp": "02:47:36", "text": "死。这就是压力板，"}, {"type": "subtitle", "time": 10067.71, "timestamp": "02:47:47", "text": "呃"}, {"type": "subtitle", "time": 10072.15, "timestamp": "02:47:52", "text": "嗯，大概是吧。不，我想是的。"}]
[{"type": "subtitle", "time": 8761.19, "timestamp": "02:26:01", "text": "一。我正在全力以赴。我的天哪，"}, {"type": "subtitle", "time": 8777.07, "timestamp": "02:26:17", "text": "哦，等等。我该怎么才能再次站起来？哦"}, {"type": "subtitle", "time": 8779.55, "timestamp": "02:26:19", "text": "不。哦"}, {"type": "subtitle", "time": 8782.27, "timestamp": "02:26:22", "text": "不。谁的房子"}, {"type": "subtitle", "time": 8785.83, "timestamp": "02:26:25", "text": "这？这是传送门所在的地方。哦"}, {"type": "subtitle", "time": 8786.99, "timestamp": "02:26:26", "text": "主。"}, {"type": "subtitle", "time": 8798.79, "timestamp": "02:26:38", "text": "嗯？呃，我们来玩“糟糕的离合器”游戏吧。什么是"}, {"type": "subtitle", "time": 8808.63, "timestamp": "02:26:48", "text": "什么？船用离合器。有件事……"}, {"type": "subtitle", "time": 8810.03, "timestamp": "02:26:50", "text": "一艘船"}, {"type": "subtitle", "time": 8811.15, "timestamp": "02:26:51", "text": "离合器。"}, {"type": "subtitle", "time": 8812.67, "timestamp": "02:26:52", "text": "[音乐]"}, {"type": "subtitle", "time": 8814.91, "timestamp": "02:26:54", "text": "好的。好的。"}]
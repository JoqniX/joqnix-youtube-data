[{"type": "subtitle", "time": 3902.87, "timestamp": "01:05:02", "text": "我该如何把这一切带走"}, {"type": "subtitle", "time": 3904.67, "timestamp": "01:05:04", "text": "日本？我"}, {"type": "subtitle", "time": 3907.23, "timestamp": "01:05:07", "text": "不。"}, {"type": "subtitle", "time": 3910.95, "timestamp": "01:05:10", "text": "是的，我离开了之前在DS集团的工作。"}, {"type": "subtitle", "time": 3913.67, "timestamp": "01:05:13", "text": "并入围了另一家公司的候选名单。"}, {"type": "subtitle", "time": 3915.75, "timestamp": "01:05:15", "text": "名为 Sam India。非常期待。"}, {"type": "subtitle", "time": 3918.789, "timestamp": "01:05:18", "text": "哦，我们走吧。入围名单包含哪些内容？"}, {"type": "subtitle", "time": 3920.589, "timestamp": "01:05:20", "text": "入围名单"}, {"type": "subtitle", "time": 3936.23, "timestamp": "01:05:36", "text": "等待。哦，还有更多拥有……的人员名单。"}, {"type": "subtitle", "time": 3938.15, "timestamp": "01:05:38", "text": "被评为最适合这份工作的人选"}, {"type": "subtitle", "time": 3941.109, "timestamp": "01:05:41", "text": "或根据更长的清单制定价格"}, {"type": "subtitle", "time": 3944.23, "timestamp": "01:05:44", "text": "人们最初考虑过。哦。哦，我的"}, {"type": "subtitle", "time": 3946.51, "timestamp": "01:05:46", "text": "上帝。"}, {"type": "subtitle", "time": 3950.109, "timestamp": "01:05:50", "text": "恭喜你，艾萨克。我的天啊。我们开始吧"}, {"type": "subtitle", "time": 3953.91, "timestamp": "01:05:53", "text": "去。我真为你感到骄傲。我们走吧。你"}]
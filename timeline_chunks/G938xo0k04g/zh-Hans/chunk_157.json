[{"type": "subtitle", "time": 9431.309, "timestamp": "02:37:11", "text": "哇。哦，不。你有什么？"}, {"type": "subtitle", "time": 9433.63, "timestamp": "02:37:13", "text": "完毕？什么"}, {"type": "subtitle", "time": 9448.95, "timestamp": "02:37:28", "text": "等等，我得赶紧修好它，否则他会……"}, {"type": "subtitle", "time": 9453.03, "timestamp": "02:37:33", "text": "生气。等等，谁来帮我出去？"}, {"type": "subtitle", "time": 9456.79, "timestamp": "02:37:36", "text": "赶紧离开这里。我的天哪。如何如何"}, {"type": "subtitle", "time": 9467.07, "timestamp": "02:37:47", "text": "上帝。我能打破这个吗？"}, {"type": "subtitle", "time": 9473.55, "timestamp": "02:37:53", "text": "确实可以"}]
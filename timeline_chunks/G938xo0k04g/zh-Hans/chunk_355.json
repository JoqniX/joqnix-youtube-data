[{"type": "subtitle", "time": 21300.31, "timestamp": "05:55:00", "text": "我的意思是你可以，但一定要注意安全。"}, {"type": "subtitle", "time": 21311.09, "timestamp": "05:55:11", "text": "你们这些圣人真的"}, {"type": "subtitle", "time": 21324.47, "timestamp": "05:55:24", "text": "黑暗的。我很高兴我需要它放在床上。是"}, {"type": "subtitle", "time": 21326.11, "timestamp": "05:55:26", "text": "这"}, {"type": "subtitle", "time": 21328.708, "timestamp": "05:55:28", "text": "是的。蘑菇季什么时候到来？"}, {"type": "subtitle", "time": 21336.67, "timestamp": "05:55:36", "text": "正确的？你听说了吗？"}, {"type": "subtitle", "time": 21349.43, "timestamp": "05:55:49", "text": "那？你听到了吗？有人"}, {"type": "subtitle", "time": 21352.11, "timestamp": "05:55:52", "text": "敲门。"}]
[{"type": "subtitle", "time": 5408.07, "timestamp": "01:30:08", "text": "嗯，赠送活动，让大家可以学习"}, {"type": "subtitle", "time": 5410.31, "timestamp": "01:30:10", "text": "比如，其中的伦理道德是什么等等。我"}, {"type": "subtitle", "time": 5411.629, "timestamp": "01:30:11", "text": "我想我保留"}, {"type": "subtitle", "time": 5416.189, "timestamp": "01:30:16", "text": "旧版 V2 礼仪的链接"}, {"type": "subtitle", "time": 5419.87, "timestamp": "01:30:19", "text": "页面是为剪线者准备的"}, {"type": "subtitle", "time": 5423.51, "timestamp": "01:30:23", "text": "东西。它还是，呃，它也有"}, {"type": "subtitle", "time": 5425.43, "timestamp": "01:30:25", "text": "喜欢"}, {"type": "subtitle", "time": 5427.39, "timestamp": "01:30:27", "text": "呃，你管它叫什么？"}, {"type": "subtitle", "time": 5432.91, "timestamp": "01:30:32", "text": "出色地？"}, {"type": "subtitle", "time": 5434.669, "timestamp": "01:30:34", "text": "[音乐]"}, {"type": "subtitle", "time": 5440.07, "timestamp": "01:30:40", "text": "哎呀，这说得太对了。看看这个。"}, {"type": "subtitle", "time": 5442.47, "timestamp": "01:30:42", "text": "8年前我们做管材的时候竞争没那么激烈。"}, {"type": "subtitle", "time": 5444.149, "timestamp": "01:30:44", "text": "当时做这件事的人很少，所以"}, {"type": "subtitle", "time": 5446.629, "timestamp": "01:30:46", "text": "很容易脱颖而出，但这同时也意味着"}, {"type": "subtitle", "time": 5449.11, "timestamp": "01:30:49", "text": "昂贵的投资。 3D建模和"}, {"type": "subtitle", "time": 5451.31, "timestamp": "01:30:51", "text": "面部识别汽车是新事物，因此"}, {"type": "subtitle", "time": 5454.39, "timestamp": "01:30:54", "text": "如今价格昂贵，种类也更多。"}, {"type": "subtitle", "time": 5455.75, "timestamp": "01:30:55", "text": "技术进步。有这么多"}, {"type": "subtitle", "time": 5458.55, "timestamp": "01:30:58", "text": "许多经济实惠的就业机会。"}]
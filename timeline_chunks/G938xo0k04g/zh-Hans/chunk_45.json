[{"type": "subtitle", "time": 2708.63, "timestamp": "00:45:08", "text": "Aana，我们也需要练习日语。我"}, {"type": "subtitle", "time": 2710.349, "timestamp": "00:45:10", "text": "我想我忘了"}, {"type": "subtitle", "time": 2713.109, "timestamp": "00:45:13", "text": "一切。我需要积极练习"}, {"type": "subtitle", "time": 2713.75, "timestamp": "00:45:13", "text": "日本人。"}, {"type": "subtitle", "time": 2715.63, "timestamp": "00:45:15", "text": "[音乐]"}, {"type": "subtitle", "time": 2720.069, "timestamp": "00:45:20", "text": "天哪，如果我像这样，像我这样，我真是太……"}, {"type": "subtitle", "time": 2721.99, "timestamp": "00:45:21", "text": "勤奋的人来到我身边。"}, {"type": "subtitle", "time": 2724.23, "timestamp": "00:45:24", "text": "昨天在游戏中制造毒品"}, {"type": "subtitle", "time": 2727.589, "timestamp": "00:45:27", "text": "这几天每天都这样。说到"}, {"type": "subtitle", "time": 2730.47, "timestamp": "00:45:30", "text": "其他方面，比如音乐制作等等"}, {"type": "subtitle", "time": 2733.309, "timestamp": "00:45:33", "text": "并且喜欢学习"}, {"type": "subtitle", "time": 2736.51, "timestamp": "00:45:36", "text": "我是日本人。"}, {"type": "subtitle", "time": 2759.589, "timestamp": "00:45:59", "text": "在。等等，等等，等等。伙计们，伙计们，伙计们"}]
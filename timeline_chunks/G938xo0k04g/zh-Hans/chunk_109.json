[{"type": "subtitle", "time": 6543.03, "timestamp": "01:49:03", "text": "就像我想让你知道你，你永远不会是你"}, {"type": "subtitle", "time": 6546.39, "timestamp": "01:49:06", "text": "永远不会喜欢你，永远不会喜欢你"}, {"type": "subtitle", "time": 6550.07, "timestamp": "01:49:10", "text": "我知道必须给他们同等的东西"}, {"type": "subtitle", "time": 6553.229, "timestamp": "01:49:13", "text": "所以，呃，想想看。"}, {"type": "subtitle", "time": 6557.03, "timestamp": "01:49:17", "text": "我觉得这很麻烦。"}, {"type": "subtitle", "time": 6562.189, "timestamp": "01:49:22", "text": "因为我开始在直播中庆祝了。"}, {"type": "subtitle", "time": 6565.75, "timestamp": "01:49:25", "text": "现在，通常情况下，其他情况又会如何呢？"}, {"type": "subtitle", "time": 6568.149, "timestamp": "01:49:28", "text": "游戏之类的，无论何时"}, {"type": "subtitle", "time": 6570.31, "timestamp": "01:49:30", "text": "拥有一个游戏角色，该角色具有他们的"}, {"type": "subtitle", "time": 6573.43, "timestamp": "01:49:33", "text": "他们生日那天只会发帖庆祝。"}, {"type": "subtitle", "time": 6577.669, "timestamp": "01:49:37", "text": "没错，就是那种直播。"}, {"type": "subtitle", "time": 6581.99, "timestamp": "01:49:41", "text": "直播类似活动和更新"}, {"type": "subtitle", "time": 6583.79, "timestamp": "01:49:43", "text": "等等"}, {"type": "subtitle", "time": 6585.31, "timestamp": "01:49:45", "text": "正确的"}]
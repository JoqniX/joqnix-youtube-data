[{"type": "subtitle", "time": 4622.87, "timestamp": "01:17:02", "text": "我必须集中注意力，因为我有事要做。"}, {"type": "subtitle", "time": 4624.11, "timestamp": "01:17:04", "text": "上课"}, {"type": "subtitle", "time": 4627.31, "timestamp": "01:17:07", "text": "今天和"}, {"type": "subtitle", "time": 4629.83, "timestamp": "01:17:09", "text": "一切，很多东西。另外，呃"}, {"type": "subtitle", "time": 4631.99, "timestamp": "01:17:11", "text": "因为我爸爸不在家，所以我必须"}, {"type": "subtitle", "time": 4633.83, "timestamp": "01:17:13", "text": "今天请照顾好我的家人。呃，还有"}, {"type": "subtitle", "time": 4635.35, "timestamp": "01:17:15", "text": "一切。我必须确保"}, {"type": "subtitle", "time": 4638.149, "timestamp": "01:17:18", "text": "一切都完成了。给猫喂食"}, {"type": "subtitle", "time": 4641.99, "timestamp": "01:17:21", "text": "虽然狗走了，一切都……"}, {"type": "subtitle", "time": 4644.39, "timestamp": "01:17:24", "text": "就像祖母和母亲一样"}, {"type": "subtitle", "time": 4646.75, "timestamp": "01:17:26", "text": "以及所有的一切。我会处理好。"}, {"type": "subtitle", "time": 4652.11, "timestamp": "01:17:32", "text": "那。是的。现在是下午。我去"}, {"type": "subtitle", "time": 4655.669, "timestamp": "01:17:35", "text": "吃。如果你还没吃午饭，"}, {"type": "subtitle", "time": 4657.79, "timestamp": "01:17:37", "text": "米娜，去吃饭吧。"}, {"type": "subtitle", "time": 4659.55, "timestamp": "01:17:39", "text": "好的。去"}, {"type": "subtitle", "time": 4662.47, "timestamp": "01:17:42", "text": "吃。我需要重新装满热水。"}, {"type": "subtitle", "time": 4664.03, "timestamp": "01:17:44", "text": "这"}, {"type": "subtitle", "time": 4668.43, "timestamp": "01:17:48", "text": "烧瓶。而这个主题烧瓶和得到"}, {"type": "subtitle", "time": 4670.51, "timestamp": "01:17:50", "text": "一些水"}, {"type": "subtitle", "time": 4673.47, "timestamp": "01:17:53", "text": "休息。"}]
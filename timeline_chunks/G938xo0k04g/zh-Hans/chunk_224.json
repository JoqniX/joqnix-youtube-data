[{"type": "subtitle", "time": 13443.269, "timestamp": "03:44:03", "text": "合成器。呃，该如何使用这个过滤器？"}, {"type": "subtitle", "time": 13447.59, "timestamp": "03:44:07", "text": "低切、低切、高切，所有这些切法。"}, {"type": "subtitle", "time": 13448.59, "timestamp": "03:44:08", "text": "得到"}, {"type": "subtitle", "time": 13451.269, "timestamp": "03:44:11", "text": "它。即使当我想到所有的一切"}, {"type": "subtitle", "time": 13454.51, "timestamp": "03:44:14", "text": "这些东西，我的一部分仍然"}, {"type": "subtitle", "time": 13456.67, "timestamp": "03:44:16", "text": "睡着了"}, {"type": "subtitle", "time": 13459.18, "timestamp": "03:44:19", "text": "现在。我不"}, {"type": "subtitle", "time": 13479.269, "timestamp": "03:44:39", "text": "自己？你知道，当我做某事的时候"}, {"type": "subtitle", "time": 13483.07, "timestamp": "03:44:43", "text": "像这样充满创造力，我的身体就像在说，我"}, {"type": "subtitle", "time": 13487.429, "timestamp": "03:44:47", "text": "累了，呜呜呜，我做不到，等等。"}, {"type": "subtitle", "time": 13490.229, "timestamp": "03:44:50", "text": "等等。它找借口。但当我"}, {"type": "subtitle", "time": 13493.71, "timestamp": "03:44:53", "text": "玩游戏，看我玩"}, {"type": "subtitle", "time": 13497.429, "timestamp": "03:44:57", "text": "比如说说而已之类的。当我"}]
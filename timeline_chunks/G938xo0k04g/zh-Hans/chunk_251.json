[{"type": "subtitle", "time": 15062.79, "timestamp": "04:11:02", "text": "我的意思是，我已经直播过Billy Billy了"}, {"type": "subtitle", "time": 15065.79, "timestamp": "04:11:05", "text": "多流之前，"}, {"type": "subtitle", "time": 15068.87, "timestamp": "04:11:08", "text": "正确的？但问题是，他们……"}, {"type": "subtitle", "time": 15071.349, "timestamp": "04:11:11", "text": "我的要求是独家直播。"}, {"type": "subtitle", "time": 15078.03, "timestamp": "04:11:18", "text": "流。是的，他们想要独家性。"}, {"type": "subtitle", "time": 15081.91, "timestamp": "04:11:21", "text": "在那里，是的，我也想那样做。"}, {"type": "subtitle", "time": 15083.51, "timestamp": "04:11:23", "text": "未来。"}, {"type": "subtitle", "time": 15086.229, "timestamp": "04:11:26", "text": "所以我认为最好不要……"}, {"type": "subtitle", "time": 15089.349, "timestamp": "04:11:29", "text": "暂时把 Joathon 和 Billy Billy 放在这里。"}, {"type": "subtitle", "time": 15091.83, "timestamp": "04:11:31", "text": "即使我本来可以做到"}, {"type": "subtitle", "time": 15095.79, "timestamp": "04:11:35", "text": "虽然我真的可以做到"}, {"type": "subtitle", "time": 15099.59, "timestamp": "04:11:39", "text": "很多，对吧？而且实际上还用它"}, {"type": "subtitle", "time": 15106.269, "timestamp": "04:11:46", "text": "一切。我感觉"}, {"type": "subtitle", "time": 15111.03, "timestamp": "04:11:51", "text": "嗯，我感觉我好像……"}, {"type": "subtitle", "time": 15114.309, "timestamp": "04:11:54", "text": "我现在就要开始直播了。"}]
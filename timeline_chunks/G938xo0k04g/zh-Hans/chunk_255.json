[{"type": "subtitle", "time": 15300.149, "timestamp": "04:15:00", "text": "嗯，我还没弄明白我该怎么做。"}, {"type": "subtitle", "time": 15308.229, "timestamp": "04:15:08", "text": "我想我还是休假吧。"}, {"type": "subtitle", "time": 15321.269, "timestamp": "04:15:21", "text": "是的。问题是，事实并非如此。"}, {"type": "subtitle", "time": 15323.67, "timestamp": "04:15:23", "text": "如果我只是把它放进去，那就值得了。"}, {"type": "subtitle", "time": 15327.11, "timestamp": "04:15:27", "text": "W 向上等等。我们甚至还没到那一步。"}, {"type": "subtitle", "time": 15329.269, "timestamp": "04:15:29", "text": "呃，我们不需要磨碎"}, {"type": "subtitle", "time": 15341.83, "timestamp": "04:15:41", "text": "是的。如果我要把比利带进来的话"}, {"type": "subtitle", "time": 15344.63, "timestamp": "04:15:44", "text": "Billy 多流 呃 Billy Billy 多流"}, {"type": "subtitle", "time": 15346.99, "timestamp": "04:15:46", "text": "进入这个乔森"}, {"type": "subtitle", "time": 15350.71, "timestamp": "04:15:50", "text": "我必须格外小心那件事"}, {"type": "subtitle", "time": 15351.87, "timestamp": "04:15:51", "text": "我"}, {"type": "subtitle", "time": 15356.03, "timestamp": "04:15:56", "text": "言行一致。即使它是一个"}]
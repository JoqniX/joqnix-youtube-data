[{"type": "subtitle", "time": 21842.37, "timestamp": "06:04:02", "text": "斧刃。铲"}, {"type": "subtitle", "time": 21862.708, "timestamp": "06:04:22", "text": "他？即使所有这些物品都像一个"}, {"type": "subtitle", "time": 21865.27, "timestamp": "06:04:25", "text": "价值东西。我的天啊。这就是我的原因"}, {"type": "subtitle", "time": 21867.6, "timestamp": "06:04:27", "text": "买不到那个"}, {"type": "subtitle", "time": 21874.91, "timestamp": "06:04:34", "text": "[音乐]"}, {"type": "subtitle", "time": 21897.75, "timestamp": "06:04:57", "text": "如果我向他要呢？所以我想看看"}]
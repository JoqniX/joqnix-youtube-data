[{"type": "subtitle", "time": 12721.229, "timestamp": "03:32:01", "text": "你最厉害？成为我的，呃，成为我的"}, {"type": "subtitle", "time": 12725.469, "timestamp": "03:32:05", "text": "山。蜘蛛支架。成为我的"}, {"type": "subtitle", "time": 12728.91, "timestamp": "03:32:08", "text": "山。成为我的坐骑。"}, {"type": "subtitle", "time": 12734.11, "timestamp": "03:32:14", "text": "哦，把所有人都给我。给你"}, {"type": "subtitle", "time": 12737.349, "timestamp": "03:32:17", "text": "哦，对不起，乔，闹出这么大的风波。等等，是"}, {"type": "subtitle", "time": 12740.55, "timestamp": "03:32:20", "text": "那甚至算得上是部剧吗？等等，什么？等待，"}, {"type": "subtitle", "time": 12742.75, "timestamp": "03:32:22", "text": "那是"}, {"type": "subtitle", "time": 12745.389, "timestamp": "03:32:25", "text": "戏剧。"}, {"type": "subtitle", "time": 12748.95, "timestamp": "03:32:28", "text": "呃，等等，戏剧到底是什么？别这样"}, {"type": "subtitle", "time": 12751.71, "timestamp": "03:32:31", "text": "困惑。等等，那算是戏剧吗？"}, {"type": "subtitle", "time": 12755.79, "timestamp": "03:32:35", "text": "等等，是小品种。"}, {"type": "subtitle", "time": 12759.63, "timestamp": "03:32:39", "text": "啊，我以为你知道卡乔"}, {"type": "subtitle", "time": 12762.389, "timestamp": "03:32:42", "text": "得到它的感觉就像……我当时想的"}, {"type": "subtitle", "time": 12764.59, "timestamp": "03:32:44", "text": "就像"}, {"type": "subtitle", "time": 12769.91, "timestamp": "03:32:49", "text": "Ko 说，呃，我最终会怎么做？"}, {"type": "subtitle", "time": 12773.51, "timestamp": "03:32:53", "text": "复仇啊，他得到了骨头厨师"}]
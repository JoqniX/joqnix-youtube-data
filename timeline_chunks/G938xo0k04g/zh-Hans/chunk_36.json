[{"type": "subtitle", "time": 2160.349, "timestamp": "00:36:00", "text": "所以，呃，YouTube直播在哪儿？"}, {"type": "subtitle", "time": 2163.51, "timestamp": "00:36:03", "text": "那玩意儿？我需要发布 Instagram 推文。"}, {"type": "subtitle", "time": 2192.23, "timestamp": "00:36:32", "text": "但是，是的，我不太清楚该怎么做。"}, {"type": "subtitle", "time": 2194.51, "timestamp": "00:36:34", "text": "在推特上做"}, {"type": "subtitle", "time": 2197.349, "timestamp": "00:36:37", "text": "实际上。我确实喜欢这样，更像是我是"}, {"type": "subtitle", "time": 2198.75, "timestamp": "00:36:38", "text": "更像是"}, {"type": "subtitle", "time": 2202.31, "timestamp": "00:36:42", "text": "消费者内容就像消费者一样"}, {"type": "subtitle", "time": 2204.23, "timestamp": "00:36:44", "text": "内容消费者，而不是内容"}, {"type": "subtitle", "time": 2207.19, "timestamp": "00:36:47", "text": "我想我应该学会给予，并且学习如何给予。"}, {"type": "subtitle", "time": 2210.31, "timestamp": "00:36:50", "text": "担任内容提供者。"}, {"type": "subtitle", "time": 2211.95, "timestamp": "00:36:51", "text": "我必须训练我的"}, {"type": "subtitle", "time": 2215.51, "timestamp": "00:36:55", "text": "东西。还有，自从那件事之后……你"}, {"type": "subtitle", "time": 2218.47, "timestamp": "00:36:58", "text": "记得我试过用剃刀支付吗？"}]
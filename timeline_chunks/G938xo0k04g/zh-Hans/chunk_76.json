[{"type": "subtitle", "time": 4562.149, "timestamp": "01:16:02", "text": "呃，你能感觉到吗？你能认出吗？"}, {"type": "subtitle", "time": 4564.95, "timestamp": "01:16:04", "text": "我刚睡醒，很累。"}, {"type": "subtitle", "time": 4567.03, "timestamp": "01:16:07", "text": "但我注意到有些人"}, {"type": "subtitle", "time": 4570.63, "timestamp": "01:16:10", "text": "能分辨出我的声音是否疲惫。"}, {"type": "subtitle", "time": 4573.59, "timestamp": "01:16:13", "text": "你很容易就能认出这一点。"}, {"type": "subtitle", "time": 4576.47, "timestamp": "01:16:16", "text": "哦，骑师累了。你为什么听起来这么……"}, {"type": "subtitle", "time": 4578.63, "timestamp": "01:16:18", "text": "累了吗？但我自己却不能"}, {"type": "subtitle", "time": 4580.43, "timestamp": "01:16:20", "text": "认出"}, {"type": "subtitle", "time": 4585.63, "timestamp": "01:16:25", "text": "为什么会这样？等等，我是谁？"}, {"type": "subtitle", "time": 4588.55, "timestamp": "01:16:28", "text": "等等，我不想去想这件事，我是"}, {"type": "subtitle", "time": 4591.189, "timestamp": "01:16:31", "text": "就是这样。方式。我应该"}, {"type": "subtitle", "time": 4593.91, "timestamp": "01:16:33", "text": "虽然是在创作音乐。如果那是个问题的话"}, {"type": "subtitle", "time": 4597.27, "timestamp": "01:16:37", "text": "这将限制我创作音乐。哦"}, {"type": "chat", "time": 4598.127, "timestamp": "01:16:38", "author": "@AerinViolet", "avatar": "https://yt4.ggpht.com/UKawanVvntNiAwz6RWv6wPk_S8YwApvPcCfLApO-du_RbQRIPGtzJ5FTt1DCNmZFJWc_2vxlqw=s64-c-k-c0x00ffffff-no-rj", "message": "yes, I can (rn at least)"}, {"type": "subtitle", "time": 4603.87, "timestamp": "01:16:43", "text": "坏的。我需要做音频录制。"}, {"type": "subtitle", "time": 4606.83, "timestamp": "01:16:46", "text": "测试。我需要进行音频测试，或者"}, {"type": "subtitle", "time": 4610.99, "timestamp": "01:16:50", "text": "比如训练我的耳朵之类的东西"}, {"type": "subtitle", "time": 4613.99, "timestamp": "01:16:53", "text": "我。我的天哪。"}, {"type": "subtitle", "time": 4616.229, "timestamp": "01:16:56", "text": "但是，今天无论如何我都会"}, {"type": "subtitle", "time": 4619.91, "timestamp": "01:16:59", "text": "不要改动比赛日程表。我们将"}]
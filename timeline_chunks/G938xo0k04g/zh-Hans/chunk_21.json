[{"type": "subtitle", "time": 1283.51, "timestamp": "00:21:23", "text": "它能给你带来什么？"}, {"type": "subtitle", "time": 1286.83, "timestamp": "00:21:26", "text": "因错误而走红"}, {"type": "subtitle", "time": 1291.149, "timestamp": "00:21:31", "text": "事物？人们会因此记住你。"}, {"type": "subtitle", "time": 1293.51, "timestamp": "00:21:33", "text": "事物。那么，你打算如何制作它们呢？"}, {"type": "subtitle", "time": 1302.31, "timestamp": "00:21:42", "text": "正确的。与其说是消极的，不如说是消极的。"}, {"type": "subtitle", "time": 1304.71, "timestamp": "00:21:44", "text": "做一件好事，是件好事，做一件积极的事情是好事。"}]
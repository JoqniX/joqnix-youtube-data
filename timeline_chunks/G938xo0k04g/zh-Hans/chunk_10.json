[{"type": "subtitle", "time": 600.35, "timestamp": "00:10:00", "text": "美好的。呃，记住它是……"}, {"type": "subtitle", "time": 602.35, "timestamp": "00:10:02", "text": "美好的。"}, {"type": "subtitle", "time": 605.91, "timestamp": "00:10:05", "text": "呃，我还需要六名成员才能凑齐十人。"}, {"type": "subtitle", "time": 607.15, "timestamp": "00:10:07", "text": "表情符号。"}, {"type": "subtitle", "time": 609.63, "timestamp": "00:10:09", "text": "H"}, {"type": "subtitle", "time": 613.43, "timestamp": "00:10:13", "text": "美好的。这是否取决于成员收益？"}, {"type": "subtitle", "time": 616.15, "timestamp": "00:10:16", "text": "或总成员数，还是类似成员数"}, {"type": "subtitle", "time": 619.67, "timestamp": "00:10:19", "text": "一个月内就能获得几倍的收益"}, {"type": "subtitle", "time": 622.35, "timestamp": "00:10:22", "text": "会员表情"}, {"type": "subtitle", "time": 630.19, "timestamp": "00:10:30", "text": "嗯？你永远不会知道，我"}, {"type": "subtitle", "time": 632.55, "timestamp": "00:10:32", "text": "猜测。是我眼花了吗，还是你只是个小虾米？"}]
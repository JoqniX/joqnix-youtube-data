[{"type": "subtitle", "time": 18307.67, "timestamp": "05:05:07", "text": "所以另一块底部零件装不上。我"}, {"type": "subtitle", "time": 18308.91, "timestamp": "05:05:08", "text": "感觉像"}, {"type": "subtitle", "time": 18343.99, "timestamp": "05:05:43", "text": "[音乐]"}, {"type": "subtitle", "time": 18346.31, "timestamp": "05:05:46", "text": "我要说的是，这种转变就像"}, {"type": "subtitle", "time": 18349.29, "timestamp": "05:05:49", "text": "音符序列。"}, {"type": "subtitle", "time": 18352.39, "timestamp": "05:05:52", "text": "[音乐]"}]
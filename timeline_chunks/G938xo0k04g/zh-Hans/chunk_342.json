[{"type": "subtitle", "time": 20527.11, "timestamp": "05:42:07", "text": "实现了。这款游戏里的对话真的……"}, {"type": "subtitle", "time": 20539.03, "timestamp": "05:42:19", "text": "它？所以，我会把一些东西放在这里。"}, {"type": "subtitle", "time": 20543.75, "timestamp": "05:42:23", "text": "我不需要电池。"}, {"type": "subtitle", "time": 20546.548, "timestamp": "05:42:26", "text": "我们会保留这个密封瓶。我不"}, {"type": "subtitle", "time": 20548.23, "timestamp": "05:42:28", "text": "知道我是否需要它。我只会"}, {"type": "subtitle", "time": 20549.708, "timestamp": "05:42:29", "text": "保持"}, {"type": "subtitle", "time": 20561.27, "timestamp": "05:42:41", "text": "它。可用作诱饵"}, {"type": "subtitle", "time": 20564.19, "timestamp": "05:42:44", "text": "嘉年华战争。"}, {"type": "subtitle", "time": 20571.43, "timestamp": "05:42:51", "text": "游戏。哇。"}]
[{"type": "subtitle", "time": 6480.31, "timestamp": "01:48:00", "text": "很遗憾，我不得不为此做准备"}, {"type": "subtitle", "time": 6484.95, "timestamp": "01:48:04", "text": "明天是女王的生日。"}, {"type": "subtitle", "time": 6487.83, "timestamp": "01:48:07", "text": "所以，我也在考虑这样做。"}, {"type": "subtitle", "time": 6490.31, "timestamp": "01:48:10", "text": "我和塞西尔一起做的那件事，你知道的"}, {"type": "subtitle", "time": 6493.59, "timestamp": "01:48:13", "text": "每个人都喜欢这个东西"}, {"type": "subtitle", "time": 6497.669, "timestamp": "01:48:17", "text": "当然我可以改，但是……"}, {"type": "subtitle", "time": 6498.91, "timestamp": "01:48:18", "text": "不"}, {"type": "subtitle", "time": 6510.669, "timestamp": "01:48:30", "text": "等等，我最后做了什么？"}, {"type": "subtitle", "time": 6515.91, "timestamp": "01:48:35", "text": "距离我生日已经过去一年了，我做了这件事。"}, {"type": "subtitle", "time": 6519.149, "timestamp": "01:48:39", "text": "绘制流。不，画泰"}, {"type": "subtitle", "time": 6522.91, "timestamp": "01:48:42", "text": "陈。画他"}, {"type": "subtitle", "time": 6526.149, "timestamp": "01:48:46", "text": "然后。好的，我做到了。然后是塞西尔的"}, {"type": "subtitle", "time": 6527.83, "timestamp": "01:48:47", "text": "生日那天，我尝试了新事物。那是"}, {"type": "subtitle", "time": 6530.03, "timestamp": "01:48:50", "text": "这"}, {"type": "subtitle", "time": 6533.39, "timestamp": "01:48:53", "text": "文本转语音"}, {"type": "subtitle", "time": 6536.95, "timestamp": "01:48:56", "text": "东西。是的。是的，我做过。"}, {"type": "subtitle", "time": 6539.629, "timestamp": "01:48:59", "text": "所以我觉得"}]
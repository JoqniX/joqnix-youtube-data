[{"type": "subtitle", "time": 5882.47, "timestamp": "01:38:02", "text": "呃，把它包起来，呃，庆祝一下"}, {"type": "subtitle", "time": 5885.75, "timestamp": "01:38:05", "text": "我今天过生日。关掉，所以我"}, {"type": "subtitle", "time": 5889.27, "timestamp": "01:38:09", "text": "我可以休息一天，或者也许我会"}, {"type": "subtitle", "time": 5892.47, "timestamp": "01:38:12", "text": "明天再直播一次。好的，"}, {"type": "subtitle", "time": 5894.95, "timestamp": "01:38:14", "text": "我会这么做。是的。总之，今天"}, {"type": "subtitle", "time": 5898.03, "timestamp": "01:38:18", "text": "我们将要玩《我的世界》。所以，"}, {"type": "subtitle", "time": 5901.109, "timestamp": "01:38:21", "text": "所以上次……哦，等等。它已离线。"}, {"type": "subtitle", "time": 5903.83, "timestamp": "01:38:23", "text": "等等，我没有，我没有开始"}, {"type": "subtitle", "time": 5907.189, "timestamp": "01:38:27", "text": "服务器。我忘了。那确实有这么回事。呃"}, {"type": "subtitle", "time": 5911.87, "timestamp": "01:38:31", "text": "是的。你好，希望你一切都好。"}, {"type": "subtitle", "time": 5919.95, "timestamp": "01:38:39", "text": "是的，嗯，今天我们将继续。"}, {"type": "subtitle", "time": 5925.35, "timestamp": "01:38:45", "text": "我称之为“斯诺拉豪宅”的那栋房子。我们呃"}, {"type": "subtitle", "time": 5928.47, "timestamp": "01:38:48", "text": "上次我们做了那个叫什么来着"}, {"type": "subtitle", "time": 5931.149, "timestamp": "01:38:51", "text": "它？上次我们做了"}, {"type": "subtitle", "time": 5935.35, "timestamp": "01:38:55", "text": "里面那部分是雪。"}, {"type": "subtitle", "time": 5938.229, "timestamp": "01:38:58", "text": "鹰巢之类的东西。然后我们所做的就是"}]
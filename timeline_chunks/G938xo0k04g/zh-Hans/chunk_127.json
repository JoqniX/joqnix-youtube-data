[{"type": "subtitle", "time": 7622.99, "timestamp": "02:07:02", "text": "啊。我的天哪。"}, {"type": "subtitle", "time": 7626.229, "timestamp": "02:07:06", "text": "哇。太酷了。好的。好的。想要"}, {"type": "subtitle", "time": 7628.35, "timestamp": "02:07:08", "text": "一对一？"}, {"type": "subtitle", "time": 7637.91, "timestamp": "02:07:17", "text": "当然。我们去拳击台吧。等待，"}, {"type": "subtitle", "time": 7647.229, "timestamp": "02:07:27", "text": "这就是拳击。"}, {"type": "subtitle", "time": 7650.03, "timestamp": "02:07:30", "text": "戒指。你"}, {"type": "subtitle", "time": 7657.43, "timestamp": "02:07:37", "text": "这里。我为什么这么累？是因为我"}, {"type": "subtitle", "time": 7666.47, "timestamp": "02:07:46", "text": "不是？我要赤手空拳跟他打。"}]
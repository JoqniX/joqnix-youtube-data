[{"type": "subtitle", "time": 20583.91, "timestamp": "05:43:03", "text": "嗯？我打电话是因为你偷了东西"}, {"type": "subtitle", "time": 20587.47, "timestamp": "05:43:07", "text": "我的心。你好吗？"}, {"type": "subtitle", "time": 20616.58, "timestamp": "05:43:36", "text": "车。呃，那是什么？那可是个大问题"}, {"type": "subtitle", "time": 20624.91, "timestamp": "05:43:44", "text": "爆炸。这是一场爆炸。"}, {"type": "subtitle", "time": 20637.788, "timestamp": "05:43:57", "text": "某物。我仍然做不到"}]
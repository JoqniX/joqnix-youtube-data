[{"type": "subtitle", "time": 17820.99, "timestamp": "04:57:00", "text": "波浪"}, {"type": "subtitle", "time": 17824.55, "timestamp": "04:57:04", "text": "桌子。呃，打开这个。侧链"}, {"type": "subtitle", "time": 17825.628, "timestamp": "04:57:05", "text": "声音的"}, {"type": "subtitle", "time": 17828.05, "timestamp": "04:57:08", "text": "从"}, {"type": "subtitle", "time": 17829.868, "timestamp": "04:57:09", "text": "[音乐]"}, {"type": "subtitle", "time": 17833.91, "timestamp": "04:57:13", "text": "这。把它拉下来。什么？我爱"}, {"type": "subtitle", "time": 17836.15, "timestamp": "04:57:16", "text": "印度菜，比如咖喱。是的，咖喱是"}, {"type": "subtitle", "time": 17839.14, "timestamp": "04:57:19", "text": "也是我最喜欢的。"}, {"type": "subtitle", "time": 17849.99, "timestamp": "04:57:29", "text": "[音乐]"}, {"type": "subtitle", "time": 17852.788, "timestamp": "04:57:32", "text": "呃，这一侧的压缩还没有被完成。"}, {"type": "subtitle", "time": 17855.66, "timestamp": "04:57:35", "text": "可以听见，但我可以把它盖住"}, {"type": "subtitle", "time": 17857.23, "timestamp": "04:57:37", "text": "[音乐]"}, {"type": "subtitle", "time": 17859.69, "timestamp": "04:57:39", "text": "这里。我能看到和听到"}, {"type": "subtitle", "time": 17865.23, "timestamp": "04:57:45", "text": "[音乐]"}, {"type": "subtitle", "time": 17870.61, "timestamp": "04:57:50", "text": "它。声音有点大。我把它调低一些。"}]
[{"type": "subtitle", "time": 13020.75, "timestamp": "03:37:00", "text": "所以"}, {"type": "subtitle", "time": 13023.55, "timestamp": "03:37:03", "text": "当然。我真是太"}, {"type": "subtitle", "time": 13028.67, "timestamp": "03:37:08", "text": "抱歉隔了这么久才回来。"}, {"type": "subtitle", "time": 13032.55, "timestamp": "03:37:12", "text": "呃，我刚洗完盘子。"}, {"type": "subtitle", "time": 13034.83, "timestamp": "03:37:14", "text": "吃"}, {"type": "subtitle", "time": 13041.389, "timestamp": "03:37:21", "text": "一切。我太累了。"}, {"type": "subtitle", "time": 13044.55, "timestamp": "03:37:24", "text": "男人。我的精力到底是怎么回事？"}, {"type": "subtitle", "time": 13046.03, "timestamp": "03:37:26", "text": "这些"}, {"type": "subtitle", "time": 13049.11, "timestamp": "03:37:29", "text": "天？我感觉自己越来越疲惫了。"}, {"type": "subtitle", "time": 13050.99, "timestamp": "03:37:30", "text": "每一天"}, {"type": "subtitle", "time": 13052.09, "timestamp": "03:37:32", "text": "现在。"}, {"type": "subtitle", "time": 13053.87, "timestamp": "03:37:33", "text": "[音乐]"}]
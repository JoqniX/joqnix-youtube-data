[{"type": "subtitle", "time": 5596.39, "timestamp": "01:33:16", "text": "你好。我去吃午饭吧"}, {"type": "subtitle", "time": 5614.75, "timestamp": "01:33:34", "text": "好的。我去。"}, {"type": "subtitle", "time": 5618.229, "timestamp": "01:33:38", "text": "嗯，我会一直走一直走一直走。呃，我应该"}, {"type": "subtitle", "time": 5621.35, "timestamp": "01:33:41", "text": "停止在推特上滑动屏幕。我的天啊。作为"}, {"type": "subtitle", "time": 5624.149, "timestamp": "01:33:44", "text": "我说，我更像是一个消费者"}, {"type": "subtitle", "time": 5626.47, "timestamp": "01:33:46", "text": "与其说是推特上的慷慨人士，不如说是另一种类型的捐赠者。我需要"}, {"type": "subtitle", "time": 5628.51, "timestamp": "01:33:48", "text": "改变"}, {"type": "subtitle", "time": 5632.39, "timestamp": "01:33:52", "text": "那。有太多人提供"}, {"type": "subtitle", "time": 5635.189, "timestamp": "01:33:55", "text": "推特上有很多有用的信息。"}, {"type": "subtitle", "time": 5637.43, "timestamp": "01:33:57", "text": "当我看到它们时，我会想：“哇，那真是……”"}]
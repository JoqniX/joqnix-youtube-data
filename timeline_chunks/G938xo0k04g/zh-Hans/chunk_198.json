[{"type": "subtitle", "time": 11895.469, "timestamp": "03:18:15", "text": "呃"}, {"type": "subtitle", "time": 11899.71, "timestamp": "03:18:19", "text": "啊，我的大脑"}, {"type": "subtitle", "time": 11914.15, "timestamp": "03:18:34", "text": "这？我可以坐B吗？我不是，我不是"}, {"type": "subtitle", "time": 11917.67, "timestamp": "03:18:37", "text": "你抓到的管理员。所以你得问问"}, {"type": "subtitle", "time": 11919.07, "timestamp": "03:18:39", "text": "为了"}, {"type": "subtitle", "time": 11922.79, "timestamp": "03:18:42", "text": "那。但我也不是管理员。"}, {"type": "subtitle", "time": 11924.51, "timestamp": "03:18:44", "text": "猜测。但他做到了"}, {"type": "subtitle", "time": 11926.95, "timestamp": "03:18:46", "text": "系列。是的。是的。我不知道。你得到了"}, {"type": "subtitle", "time": 11930.429, "timestamp": "03:18:50", "text": "去问问他。我不"}, {"type": "subtitle", "time": 11938.469, "timestamp": "03:18:58", "text": "我能做些什么？这就像地面"}]
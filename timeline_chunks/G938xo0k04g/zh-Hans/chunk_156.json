[{"type": "subtitle", "time": 9361.67, "timestamp": "02:36:01", "text": "我。那我得回去工作了。"}, {"type": "subtitle", "time": 9366.389, "timestamp": "02:36:06", "text": "现在，我的基地来了。我做不了B。"}, {"type": "subtitle", "time": 9376.51, "timestamp": "02:36:16", "text": "我打算再回去一点……"}, {"type": "subtitle", "time": 9383.389, "timestamp": "02:36:23", "text": "事物。"}, {"type": "subtitle", "time": 9387.27, "timestamp": "02:36:27", "text": "哦好的。我心想：阿鲁苏在哪里？"}, {"type": "subtitle", "time": 9389.59, "timestamp": "02:36:29", "text": "又是房子？"}, {"type": "subtitle", "time": 9392.469, "timestamp": "02:36:32", "text": "他们不是在冰冻的地面上建造的吗？"}, {"type": "subtitle", "time": 9401.55, "timestamp": "02:36:41", "text": "湖？这是"}, {"type": "subtitle", "time": 9403.9, "timestamp": "02:36:43", "text": "地方。嘿，"}, {"type": "subtitle", "time": 9405.71, "timestamp": "02:36:45", "text": "[音乐]"}, {"type": "subtitle", "time": 9409.03, "timestamp": "02:36:49", "text": "来建造这个地方。是这个吗？"}, {"type": "subtitle", "time": 9410.83, "timestamp": "02:36:50", "text": "那更像是……"}]
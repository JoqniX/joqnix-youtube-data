[{"type": "subtitle", "time": 4512.709, "timestamp": "01:15:12", "text": "你知道我注意到什么了吗？就在我……的时候"}, {"type": "subtitle", "time": 4515.75, "timestamp": "01:15:15", "text": "就像在我的直播间里一样，观看我自己的直播吧"}, {"type": "subtitle", "time": 4518.07, "timestamp": "01:15:18", "text": "当我说话时，我感觉自己像是……"}, {"type": "subtitle", "time": 4519.669, "timestamp": "01:15:19", "text": "用不同的语气说话或"}, {"type": "subtitle", "time": 4522.95, "timestamp": "01:15:22", "text": "某种东西，或者就像我说话的方式就像……"}, {"type": "subtitle", "time": 4525.03, "timestamp": "01:15:25", "text": "你自己就能知道什么时候该停止。"}, {"type": "subtitle", "time": 4527.11, "timestamp": "01:15:27", "text": "嗓子就像疲惫时的声音一样"}, {"type": "subtitle", "time": 4530.87, "timestamp": "01:15:30", "text": "所以死了等等等等，或者如果你没死的话……"}, {"type": "subtitle", "time": 4533.55, "timestamp": "01:15:33", "text": "说话很流畅，就像你一样"}, {"type": "subtitle", "time": 4537.189, "timestamp": "01:15:37", "text": "通常的音域或其他什么"}, {"type": "subtitle", "time": 4539.83, "timestamp": "01:15:39", "text": "无论对错，但当我听的时候"}, {"type": "subtitle", "time": 4542.31, "timestamp": "01:15:42", "text": "我自己在直播里听起来也一样。"}, {"type": "subtitle", "time": 4546.87, "timestamp": "01:15:46", "text": "那正常吗？我吗？我是什么？"}, {"type": "subtitle", "time": 4549.51, "timestamp": "01:15:49", "text": "那些人该怎么称呼呢？"}, {"type": "subtitle", "time": 4552.79, "timestamp": "01:15:52", "text": "比如无法区分音调和"}, {"type": "subtitle", "time": 4554.11, "timestamp": "01:15:54", "text": "东西或"}, {"type": "subtitle", "time": 4557.43, "timestamp": "01:15:57", "text": "我不知道该怎么做，你感觉如何？"}, {"type": "subtitle", "time": 4559.59, "timestamp": "01:15:59", "text": "就像那样"}]
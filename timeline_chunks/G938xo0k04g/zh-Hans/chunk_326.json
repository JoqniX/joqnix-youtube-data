[{"type": "subtitle", "time": 19561.51, "timestamp": "05:26:01", "text": "比如，如果有人要批评我，我会……"}, {"type": "subtitle", "time": 19564.31, "timestamp": "05:26:04", "text": "比如，我试着做了某件事。"}, {"type": "subtitle", "time": 19566.75, "timestamp": "05:26:06", "text": "我用压缩机把它改成了"}, {"type": "subtitle", "time": 19577.27, "timestamp": "05:26:17", "text": "呃，稍微尝试了一下设计……"}, {"type": "subtitle", "time": 19581.43, "timestamp": "05:26:21", "text": "嗯，先别管低频振荡器和包络线。"}, {"type": "subtitle", "time": 19583.07, "timestamp": "05:26:23", "text": "改变"}, {"type": "subtitle", "time": 19585.12, "timestamp": "05:26:25", "text": "信封"}, {"type": "subtitle", "time": 19586.99, "timestamp": "05:26:26", "text": "[音乐]"}, {"type": "subtitle", "time": 19596.708, "timestamp": "05:26:36", "text": "相同。我试着用同样的方法。"}, {"type": "subtitle", "time": 19600.75, "timestamp": "05:26:40", "text": "嗯，和弦结构"}, {"type": "subtitle", "time": 19604.628, "timestamp": "05:26:44", "text": "这个节拍器，上面的那个东西"}, {"type": "subtitle", "time": 19605.708, "timestamp": "05:26:45", "text": "以及"}, {"type": "subtitle", "time": 19608.91, "timestamp": "05:26:48", "text": "还有一件事正在运行"}, {"type": "subtitle", "time": 19612.15, "timestamp": "05:26:52", "text": "后退。我希望它是一把拔毛。所以我这么做了"}]
[{"type": "subtitle", "time": 6064.55, "timestamp": "01:41:04", "text": "我的负45分贝。另一幕是"}, {"type": "subtitle", "time": 6068.87, "timestamp": "01:41:08", "text": "比如游戏场景的音量大概是 54 分贝。"}, {"type": "subtitle", "time": 6070.03, "timestamp": "01:41:10", "text": "那就像"}, {"type": "subtitle", "time": 6071.99, "timestamp": "01:41:11", "text": "15%。你会玩吗？"}, {"type": "subtitle", "time": 6074.87, "timestamp": "01:41:14", "text": "我的世界？我正在启动服务器。"}, {"type": "subtitle", "time": 6077.43, "timestamp": "01:41:17", "text": "聪明。脑。我刚才是不是给你打过电话？"}, {"type": "subtitle", "time": 6079.79, "timestamp": "01:41:19", "text": "布雷迪？我的天啊。我是"}, {"type": "subtitle", "time": 6082.99, "timestamp": "01:41:22", "text": "对不起。是的，希望你一切都好。"}, {"type": "subtitle", "time": 6089.91, "timestamp": "01:41:29", "text": "猫。我的天啊。我给电台打了电话。哦"}, {"type": "subtitle", "time": 6092.109, "timestamp": "01:41:32", "text": "我的上帝。好的，Minecraft是"}, {"type": "subtitle", "time": 6094.59, "timestamp": "01:41:34", "text": "这里。"}, {"type": "subtitle", "time": 6098.39, "timestamp": "01:41:38", "text": "你好。如果音频有问题请告诉我。"}, {"type": "subtitle", "time": 6102.83, "timestamp": "01:41:42", "text": "能听到声音。我们来解决这个问题吧。"}, {"type": "subtitle", "time": 6105.149, "timestamp": "01:41:45", "text": "那。你听到了"}, {"type": "subtitle", "time": 6107.51, "timestamp": "01:41:47", "text": "正确的？我要把他们的名字改成"}, {"type": "subtitle", "time": 6109.43, "timestamp": "01:41:49", "text": "催化剂。"}, {"type": "subtitle", "time": 6112.35, "timestamp": "01:41:52", "text": "是的，这就是我们上次做的事情。"}, {"type": "subtitle", "time": 6116.59, "timestamp": "01:41:56", "text": "时间。我家困着一个人。"}]
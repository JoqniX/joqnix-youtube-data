[{"type": "subtitle", "time": 7572.109, "timestamp": "02:06:12", "text": "哦，对，这个"}, {"type": "subtitle", "time": 7576.189, "timestamp": "02:06:16", "text": "这里现在是你的基地。这"}, {"type": "subtitle", "time": 7580.47, "timestamp": "02:06:20", "text": "掩体。好的。我想建一个水族馆"}, {"type": "subtitle", "time": 7584.43, "timestamp": "02:06:24", "text": "像这样。太酷了。但别去"}, {"type": "subtitle", "time": 7592.55, "timestamp": "02:06:32", "text": "这里应该放什么？"}, {"type": "subtitle", "time": 7596.109, "timestamp": "02:06:36", "text": "比如牦牛场或墓地"}, {"type": "subtitle", "time": 7603.589, "timestamp": "02:06:43", "text": "地方。哦，还有更多。我希望你"}, {"type": "subtitle", "time": 7606.35, "timestamp": "02:06:46", "text": "别在意我"}, {"type": "subtitle", "time": 7609.47, "timestamp": "02:06:49", "text": "尖头的。有一个下界"}, {"type": "subtitle", "time": 7616.38, "timestamp": "02:06:56", "text": "哇。"}, {"type": "subtitle", "time": 7619.79, "timestamp": "02:06:59", "text": "[笑声]"}]
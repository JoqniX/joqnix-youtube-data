[{"type": "subtitle", "time": 9131.51, "timestamp": "02:32:11", "text": "哇。让我来做划船的事。我从未"}, {"type": "subtitle", "time": 9138.03, "timestamp": "02:32:18", "text": "然后我将"}, {"type": "subtitle", "time": 9141.63, "timestamp": "02:32:21", "text": "呃，继续我的工作"}, {"type": "subtitle", "time": 9146.83, "timestamp": "02:32:26", "text": "建造。哦，你好。所以，呃，这个"}, {"type": "subtitle", "time": 9159.95, "timestamp": "02:32:39", "text": "满载的船让我治愈自己"}, {"type": "subtitle", "time": 9163.19, "timestamp": "02:32:43", "text": "这。需要完全康复吗？不，"}, {"type": "subtitle", "time": 9166.71, "timestamp": "02:32:46", "text": "其实不需要，只需要木条就行了。"}, {"type": "subtitle", "time": 9169.27, "timestamp": "02:32:49", "text": "我想，需要更多。"}]
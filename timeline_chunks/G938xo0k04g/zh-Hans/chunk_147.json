[{"type": "subtitle", "time": 8854.63, "timestamp": "02:27:34", "text": "左边。哦，他真的要带走我的"}, {"type": "subtitle", "time": 8859.57, "timestamp": "02:27:39", "text": "哦，我的"}, {"type": "subtitle", "time": 8874.11, "timestamp": "02:27:54", "text": "上帝。我收到了。感谢"}, {"type": "subtitle", "time": 8877.19, "timestamp": "02:27:57", "text": "你。与此同时，我却在遭受痛苦。他只是"}]
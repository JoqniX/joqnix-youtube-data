[{"type": "subtitle", "time": 8004.43, "timestamp": "02:13:24", "text": "它是"}, {"type": "subtitle", "time": 8008.55, "timestamp": "02:13:28", "text": "好的。跳跃的时机，时机"}, {"type": "subtitle", "time": 8024.35, "timestamp": "02:13:44", "text": "好的。"}, {"type": "subtitle", "time": 8027.7, "timestamp": "02:13:47", "text": "巴卡杜。巴卡杜。"}, {"type": "subtitle", "time": 8028.95, "timestamp": "02:13:48", "text": "[音乐]"}, {"type": "subtitle", "time": 8031.79, "timestamp": "02:13:51", "text": "水桶到“哦，那里有个水桶”"}, {"type": "subtitle", "time": 8035.31, "timestamp": "02:13:55", "text": "这里。我会得到一些"}, {"type": "subtitle", "time": 8038.31, "timestamp": "02:13:58", "text": "水。哦，等等。我不能喝水"}]
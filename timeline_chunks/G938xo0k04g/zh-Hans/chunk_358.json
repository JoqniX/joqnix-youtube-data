[{"type": "subtitle", "time": 21493.37, "timestamp": "05:58:13", "text": "嗯？那是什么？什么？什么？"}, {"type": "subtitle", "time": 21507.948, "timestamp": "05:58:27", "text": "商。我几乎看不清他。"}, {"type": "subtitle", "time": 21510.47, "timestamp": "05:58:30", "text": "令人不安的熟悉特征"}, {"type": "subtitle", "time": 21514.19, "timestamp": "05:58:34", "text": "他的垫子视野"}, {"type": "subtitle", "time": 21516.628, "timestamp": "05:58:36", "text": "呃，头盔。师傅会离开"}, {"type": "subtitle", "time": 21518.67, "timestamp": "05:58:38", "text": "拿着旧麻袋，看起来"}, {"type": "subtitle", "time": 21523.59, "timestamp": "05:58:43", "text": "成为苍白身体的组成部分。我"}, {"type": "subtitle", "time": 21525.19, "timestamp": "05:58:45", "text": "记住他。是他救了她"}, {"type": "subtitle", "time": 21528.708, "timestamp": "05:58:48", "text": "来自医生家里的我。男人"}, {"type": "subtitle", "time": 21531.27, "timestamp": "05:58:51", "text": "他举起他那只黑色的手。它被覆盖了"}, {"type": "subtitle", "time": 21533.43, "timestamp": "05:58:53", "text": "与脉轮有关。上面写着什么。"}, {"type": "subtitle", "time": 21537.75, "timestamp": "05:58:57", "text": "他容光焕发。等待。是的，这种光芒，"}, {"type": "subtitle", "time": 21539.43, "timestamp": "05:58:59", "text": "正确的？哦，等等。你们不能这么做"}]
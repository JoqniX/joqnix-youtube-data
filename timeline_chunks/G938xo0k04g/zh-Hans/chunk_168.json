[{"type": "subtitle", "time": 10085.11, "timestamp": "02:48:05", "text": "正确的。看，我抓到了一只皮卡丘。等待，"}, {"type": "subtitle", "time": 10087.91, "timestamp": "02:48:07", "text": "皮卡丘？什么？这里面有皮卡丘"}, {"type": "subtitle", "time": 10095.07, "timestamp": "02:48:15", "text": "这是什么？皮卡丘？"}, {"type": "subtitle", "time": 10102.19, "timestamp": "02:48:22", "text": "一只兔子和"}, {"type": "subtitle", "time": 10112.59, "timestamp": "02:48:32", "text": "僵尸。看看他们。他们是如此"}, {"type": "subtitle", "time": 10114.99, "timestamp": "02:48:34", "text": "快乐的。所以"}, {"type": "subtitle", "time": 10117.55, "timestamp": "02:48:37", "text": "可爱的。另外，我"}, {"type": "subtitle", "time": 10122.75, "timestamp": "02:48:42", "text": "我是不是只想死，这样我就可以"}, {"type": "subtitle", "time": 10128.71, "timestamp": "02:48:48", "text": "重置。没关系。我还是回去吧。"}, {"type": "subtitle", "time": 10134.99, "timestamp": "02:48:54", "text": "死。我这就结束。"}, {"type": "subtitle", "time": 10138.79, "timestamp": "02:48:58", "text": "我这玩意儿到底是什么，而我……"}]
[{"type": "subtitle", "time": 12660.87, "timestamp": "03:31:00", "text": "秘密结局。我需要一个秘密入口。我"}, {"type": "subtitle", "time": 12662.75, "timestamp": "03:31:02", "text": "不想"}, {"type": "subtitle", "time": 12689.91, "timestamp": "03:31:29", "text": "时间。乔克铲子。等待。还有运动健将"}, {"type": "subtitle", "time": 12693.87, "timestamp": "03:31:33", "text": "我想，应该是雪人和雪的搜寻器吧。"}, {"type": "subtitle", "time": 12697.83, "timestamp": "03:31:37", "text": "不。乔克"}, {"type": "subtitle", "time": 12699.469, "timestamp": "03:31:39", "text": "呃，运动员"}, {"type": "subtitle", "time": 12700.74, "timestamp": "03:31:40", "text": "这"}, {"type": "subtitle", "time": 12702.83, "timestamp": "03:31:42", "text": "[音乐]"}, {"type": "subtitle", "time": 12706.59, "timestamp": "03:31:46", "text": "嗯，雪。我知道。"}, {"type": "subtitle", "time": 12713.229, "timestamp": "03:31:53", "text": "这个运动员不是"}, {"type": "subtitle", "time": 12717.75, "timestamp": "03:31:57", "text": "找到我被撞倒的时候。我可以继续待在这里吗？"}]
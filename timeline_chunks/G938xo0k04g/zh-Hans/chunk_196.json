[{"type": "subtitle", "time": 11763.19, "timestamp": "03:16:03", "text": "这？有人吗？这是一个研究实验室。"}, {"type": "subtitle", "time": 11767.349, "timestamp": "03:16:07", "text": "哦好的。总之，新地方。呃，我需要"}, {"type": "subtitle", "time": 11771.11, "timestamp": "03:16:11", "text": "登录或保存我自己的项目。我 我 我"}, {"type": "subtitle", "time": 11776.91, "timestamp": "03:16:16", "text": "需要提前计划好，否则我做不到。"}, {"type": "subtitle", "time": 11788.83, "timestamp": "03:16:28", "text": "雪。好的，我来画一个简单的图表。"}, {"type": "subtitle", "time": 11791.75, "timestamp": "03:16:31", "text": "然后。但我用的不是那种雪。"}, {"type": "subtitle", "time": 11803.309, "timestamp": "03:16:43", "text": "[音乐]"}, {"type": "subtitle", "time": 11807.469, "timestamp": "03:16:47", "text": "不，我必须这样做。"}, {"type": "subtitle", "time": 11811.19, "timestamp": "03:16:51", "text": "我。难道没有办法复制粘贴吗？"}, {"type": "subtitle", "time": 11813.95, "timestamp": "03:16:53", "text": "来自主线"}, {"type": "subtitle", "time": 11816.71, "timestamp": "03:16:56", "text": "游戏？难道没有办法从……复制粘贴吗？"}, {"type": "subtitle", "time": 11819.51, "timestamp": "03:16:59", "text": "主游戏？我不想这样做"}]
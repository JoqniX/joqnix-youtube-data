[{"type": "subtitle", "time": 4261.669, "timestamp": "01:11:01", "text": "某物。嗯，那将是结局。"}, {"type": "subtitle", "time": 4264.189, "timestamp": "01:11:04", "text": "一。所以我是"}, {"type": "subtitle", "time": 4268.91, "timestamp": "01:11:08", "text": "兴奋的。此外，卡玛也得到了很多"}, {"type": "subtitle", "time": 4272.87, "timestamp": "01:11:12", "text": "类似动漫的音乐机会。所以"}, {"type": "subtitle", "time": 4273.95, "timestamp": "01:11:13", "text": "我是"}, {"type": "subtitle", "time": 4276.83, "timestamp": "01:11:16", "text": "你很骄傲"}, {"type": "subtitle", "time": 4280.149, "timestamp": "01:11:20", "text": "我知道，太好了。"}, {"type": "subtitle", "time": 4282.79, "timestamp": "01:11:22", "text": "这让我也很想做那种事。"}, {"type": "subtitle", "time": 4285.11, "timestamp": "01:11:25", "text": "你激励我也做到最好。"}, {"type": "subtitle", "time": 4290.07, "timestamp": "01:11:30", "text": "我知道，至少我的第一首歌是这样的。"}, {"type": "subtitle", "time": 4295.75, "timestamp": "01:11:35", "text": "出去或者做点什么，然后到达那里"}, {"type": "subtitle", "time": 4298.83, "timestamp": "01:11:38", "text": "慢慢地，慢慢地，在我自己的"}, {"type": "subtitle", "time": 4301.43, "timestamp": "01:11:41", "text": "页。获取更多机会"}]
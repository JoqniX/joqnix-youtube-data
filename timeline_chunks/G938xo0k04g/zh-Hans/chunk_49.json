[{"type": "subtitle", "time": 2940.03, "timestamp": "00:49:00", "text": "只想工作"}, {"type": "subtitle", "time": 2944.309, "timestamp": "00:49:04", "text": "快点或者想想办法，伙计们，那将是我的"}, {"type": "subtitle", "time": 2945.75, "timestamp": "00:49:05", "text": "梦想成真。我不想得到"}, {"type": "subtitle", "time": 2949.03, "timestamp": "00:49:09", "text": "进入神圣的渴望或为我想要的工作"}]
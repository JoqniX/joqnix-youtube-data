[{"type": "subtitle", "time": 21608.27, "timestamp": "06:00:08", "text": "汽油是"}, {"type": "subtitle", "time": 21611.07, "timestamp": "06:00:11", "text": "62. 我不需要"}, {"type": "subtitle", "time": 21613.31, "timestamp": "06:00:13", "text": "手表。武器"}, {"type": "subtitle", "time": 21623.43, "timestamp": "06:00:23", "text": "Jog在之后开始从事恐怖题材的工作"}, {"type": "subtitle", "time": 21625.27, "timestamp": "06:00:25", "text": "之后就是我和慢跑了。"}, {"type": "subtitle", "time": 21627.59, "timestamp": "06:00:27", "text": "清除城镇中的鬼魂"}, {"type": "subtitle", "time": 21633.47, "timestamp": "06:00:33", "text": "一个"}, {"type": "subtitle", "time": 21636.12, "timestamp": "06:00:36", "text": "希望"}, {"type": "subtitle", "time": 21641.31, "timestamp": "06:00:41", "text": "更多的"}, {"type": "subtitle", "time": 21645.51, "timestamp": "06:00:45", "text": "漫长而痛苦的战斗，所以武器"}, {"type": "subtitle", "time": 21648.868, "timestamp": "06:00:48", "text": "就像零件一样，好吧，我会分开的。"}, {"type": "subtitle", "time": 21651.03, "timestamp": "06:00:51", "text": "武器部件中的分离器"}, {"type": "subtitle", "time": 21654.23, "timestamp": "06:00:54", "text": "东西。所以，我需要去买那本杂志。"}, {"type": "subtitle", "time": 21657.15, "timestamp": "06:00:57", "text": "框架，所有那些东西，然后搭建一个"}, {"type": "subtitle", "time": 21659.788, "timestamp": "06:00:59", "text": "手枪或步枪或"}]
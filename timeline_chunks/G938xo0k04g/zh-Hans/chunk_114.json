[{"type": "subtitle", "time": 6849.31, "timestamp": "01:54:09", "text": "砰。我不知道它是否有效。"}, {"type": "subtitle", "time": 6864.149, "timestamp": "01:54:24", "text": "向上。我是怎么做到的？"}, {"type": "subtitle", "time": 6878.27, "timestamp": "01:54:38", "text": "什么？我怎么会这样？哦。"}, {"type": "subtitle", "time": 6879.79, "timestamp": "01:54:39", "text": "啊。"}, {"type": "subtitle", "time": 6882.75, "timestamp": "01:54:42", "text": "所以，你的意思是，你敢让我……"}, {"type": "subtitle", "time": 6886.03, "timestamp": "01:54:46", "text": "什么？一，二，"}, {"type": "subtitle", "time": 6895.87, "timestamp": "01:54:55", "text": "水桶课。给我一个桶"}, {"type": "subtitle", "time": 6897.55, "timestamp": "01:54:57", "text": "然后。"}]
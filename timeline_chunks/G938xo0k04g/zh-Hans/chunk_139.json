[{"type": "subtitle", "time": 8340.07, "timestamp": "02:19:00", "text": "等等，原来跟那个类似啊。等待，"}, {"type": "subtitle", "time": 8342.19, "timestamp": "02:19:02", "text": "有人这样做"}, {"type": "subtitle", "time": 8344.99, "timestamp": "02:19:04", "text": "那东西关掉"}, {"type": "subtitle", "time": 8348.389, "timestamp": "02:19:08", "text": "就是这样。只需喷洒报告即可。"}, {"type": "subtitle", "time": 8350.19, "timestamp": "02:19:10", "text": "玩。"}, {"type": "subtitle", "time": 8352.11, "timestamp": "02:19:12", "text": "你好。等待，"}, {"type": "subtitle", "time": 8356.75, "timestamp": "02:19:16", "text": "等待。让我来回答“那东西在哪儿”这个问题。"}, {"type": "subtitle", "time": 8360.11, "timestamp": "02:19:20", "text": "床？哦不，他"}, {"type": "subtitle", "time": 8362.95, "timestamp": "02:19:22", "text": "死了。天哪，我要中枪了。什么是"}, {"type": "subtitle", "time": 8366.469, "timestamp": "02:19:26", "text": "流浪狗？那个迷路的人是谁？绝不"}, {"type": "subtitle", "time": 8369.509, "timestamp": "02:19:29", "text": "以前见过他。什么？等等，这是什么？"}, {"type": "subtitle", "time": 8371.549, "timestamp": "02:19:31", "text": "把绳子拉起来"}, {"type": "subtitle", "time": 8375.389, "timestamp": "02:19:35", "text": "人？我的天哪，"}, {"type": "subtitle", "time": 8383.83, "timestamp": "02:19:43", "text": "请。随便找个地方睡觉。有人上床了。"}, {"type": "subtitle", "time": 8386.589, "timestamp": "02:19:46", "text": "没有床。谁把床搬走了"}, {"type": "subtitle", "time": 8397.51, "timestamp": "02:19:57", "text": "呃，床。这是什么？好的。床。"}, {"type": "subtitle", "time": 8399.23, "timestamp": "02:19:59", "text": "啊，"}]
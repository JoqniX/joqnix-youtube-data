[{"type": "subtitle", "time": 16511.83, "timestamp": "04:35:11", "text": "[音乐]"}, {"type": "subtitle", "time": 16514.83, "timestamp": "04:35:14", "text": "我说不。"}, {"type": "subtitle", "time": 16532.31, "timestamp": "04:35:32", "text": "它仍然要去M。我的天哪。"}, {"type": "subtitle", "time": 16533.99, "timestamp": "04:35:33", "text": "等等，让我再来一遍。"}, {"type": "subtitle", "time": 16536.15, "timestamp": "04:35:36", "text": "开始。这太令人困惑了。我 我"}, {"type": "subtitle", "time": 16538.269, "timestamp": "04:35:38", "text": "应该以问题的形式提出这个问题。"}, {"type": "subtitle", "time": 16542.269, "timestamp": "04:35:42", "text": "今天。控制移位 T 用于 MIDI"}, {"type": "subtitle", "time": 16548.91, "timestamp": "04:35:48", "text": "追踪。然后我们采取呃，然后我们采取波浪"}, {"type": "subtitle", "time": 16551.869, "timestamp": "04:35:51", "text": "桌子。把它放进去"}, {"type": "chat", "time": 16559.577, "timestamp": "04:35:59", "author": "@PikuVerma-i6r", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mhD_uBtCD8mWdT0iitBx_Q8bq0TyRBWRZE2sXdp1oZwUfg1sZvctK6tZ7r4kqP-KS8-A=s64-c-k-c0x00ffffff-no-rj", "message": " MAKE SOUND LIKE BR E E E E EE BR E E E E EE"}]
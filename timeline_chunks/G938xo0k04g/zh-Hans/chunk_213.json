[{"type": "subtitle", "time": 12792.55, "timestamp": "03:33:12", "text": "再次。他正在进行复仇"}, {"type": "subtitle", "time": 12794.83, "timestamp": "03:33:14", "text": "反派弧线。斗争"}, {"type": "subtitle", "time": 12797.229, "timestamp": "03:33:17", "text": "我。来打我啊，"}, {"type": "subtitle", "time": 12809.83, "timestamp": "03:33:29", "text": "[音乐]"}, {"type": "subtitle", "time": 12817.19, "timestamp": "03:33:37", "text": "男人。让我们看看谁才是最强的那种"}, {"type": "subtitle", "time": 12831.15, "timestamp": "03:33:51", "text": "东西。我的天哪。一个"}]
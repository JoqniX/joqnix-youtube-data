[{"type": "subtitle", "time": 7740.99, "timestamp": "02:09:00", "text": "难的。我的心是"}, {"type": "subtitle", "time": 7744.99, "timestamp": "02:09:04", "text": "垂死。速度更快。而我杀"}, {"type": "subtitle", "time": 7746.99, "timestamp": "02:09:06", "text": "他们。我是"}, {"type": "subtitle", "time": 7758.03, "timestamp": "02:09:18", "text": "一半"}, {"type": "subtitle", "time": 7761.69, "timestamp": "02:09:21", "text": "留在我身上的心。"}, {"type": "subtitle", "time": 7765.229, "timestamp": "02:09:25", "text": "[音乐]"}, {"type": "subtitle", "time": 7774.79, "timestamp": "02:09:34", "text": "哇。呃，你们有完整的Hangana吗？不。"}, {"type": "subtitle", "time": 7783.87, "timestamp": "02:09:43", "text": "呃，三个"}]
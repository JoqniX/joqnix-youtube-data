[{"type": "subtitle", "time": 15001.349, "timestamp": "04:10:01", "text": "在 Twitch 和 YouTube 上，我可以……"}, {"type": "subtitle", "time": 15004.07, "timestamp": "04:10:04", "text": "记住你们的名字，因为我"}, {"type": "subtitle", "time": 15006.71, "timestamp": "04:10:06", "text": "会看到你的名字，它就在那里。"}, {"type": "subtitle", "time": 15008.79, "timestamp": "04:10:08", "text": "英语，我会努力记住它"}, {"type": "subtitle", "time": 15012.07, "timestamp": "04:10:12", "text": "你越是积极参与互动，就越能获得成功。"}, {"type": "subtitle", "time": 15014.95, "timestamp": "04:10:14", "text": "请与我互动。但说到"}, {"type": "subtitle", "time": 15017.59, "timestamp": "04:10:17", "text": "不同字符的名称"}, {"type": "subtitle", "time": 15021.91, "timestamp": "04:10:21", "text": "例如像日本人或像日本人"}, {"type": "subtitle", "time": 15023.75, "timestamp": "04:10:23", "text": "我觉得这需要一段时间。"}, {"type": "subtitle", "time": 15026.11, "timestamp": "04:10:26", "text": "我需要提高阅读能力，所以要多读书。"}, {"type": "subtitle", "time": 15028.79, "timestamp": "04:10:28", "text": "阅读。所以中国也有，就像我一样。"}, {"type": "subtitle", "time": 15031.51, "timestamp": "04:10:31", "text": "现在无法阅读。所以我不知道我"}, {"type": "subtitle", "time": 15034.309, "timestamp": "04:10:34", "text": "必须继续见到你，或者像学习一样"}, {"type": "subtitle", "time": 15037.429, "timestamp": "04:10:37", "text": "把这个词背下来或者记住"}, {"type": "subtitle", "time": 15039.67, "timestamp": "04:10:39", "text": "这个词，这样当我看到那个名字或"}, {"type": "subtitle", "time": 15043.63, "timestamp": "04:10:43", "text": "我会想，哦，那是你啊。"}, {"type": "subtitle", "time": 15057.03, "timestamp": "04:10:57", "text": "很难，嗯，如果我想的话，我可以拥有"}, {"type": "subtitle", "time": 15059.83, "timestamp": "04:10:59", "text": "完毕"}]
[{"type": "subtitle", "time": 18423.03, "timestamp": "05:07:03", "text": "。  我真是太倒楣了。  我今天真是太倒楣了。  這种红色漿果不能"}, {"type": "subtitle", "time": 18430.07, "timestamp": "05:07:10", "text": "吃嗎？  那种红色的水果難道不能吃嗎？  嗯，我"}, {"type": "subtitle", "time": 18434.15, "timestamp": "05:07:14", "text": "一會兒就吃這個"}, {"type": "subtitle", "time": 18436.31, "timestamp": "05:07:16", "text": "。  我的天哪。"}, {"type": "subtitle", "time": 18443.59, "timestamp": "05:07:23", "text": "我的天啊，我死了。  哦，"}, {"type": "subtitle", "time": 18446.31, "timestamp": "05:07:26", "text": "兄弟。  我拿不到繩子，哦，等等。實際上，活塞是我做的。  真的嗎？  忍者。我買的是"}, {"type": "subtitle", "time": 18448.39, "timestamp": "05:07:28", "text": "忍者款。我們走吧。"}, {"type": "chat", "time": 18454.237, "timestamp": "05:07:34", "author": "@giver9144", "avatar": "https://yt4.ggpht.com/ytc/AIdro_noHK67ltOtNG9w-x2QyzCyOVUZGkiZjfEEUszeks5XwQ=s64-c-k-c0x00ffffff-no-rj", "message": "have a good rest. "}, {"type": "subtitle", "time": 18463.11, "timestamp": "05:07:43", "text": "哦，是的。我們就像是上下起伏，上下起伏，上下起伏。  現在它涵蓋了所有內容。"}]
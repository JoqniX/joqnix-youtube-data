[{"type": "subtitle", "time": 9309.75, "timestamp": "02:35:09", "text": "不，我的天哪，兄弟。那段日子裡，我拼命吶喊。我的天哪，我尖叫起來。我的天啊。  兄弟，我當時叫得很大聲。  我"}, {"type": "subtitle", "time": 9322.07, "timestamp": "02:35:22", "text": "尖叫起來。  啊，我不能。  哦，等等。"}, {"type": "subtitle", "time": 9326.55, "timestamp": "02:35:26", "text": "我可以走這條路。  我的"}, {"type": "subtitle", "time": 9330.63, "timestamp": "02:35:30", "text": "天哪。嗯，是的。是的。是的。"}]
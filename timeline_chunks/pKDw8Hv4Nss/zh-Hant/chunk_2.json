[{"type": "subtitle", "time": 121.59, "timestamp": "00:02:01", "text": "百感交集。  最重要的是，我興奮極了。"}, {"type": "subtitle", "time": 124.63, "timestamp": "00:02:04", "text": "我們已經開始全力投入這款遊戲了。說實話，這遊戲"}, {"type": "subtitle", "time": 128.71, "timestamp": "00:02:08", "text": "挺好玩的。愛它。"}, {"type": "subtitle", "time": 132.63, "timestamp": "00:02:12", "text": "呃，我戒菸了。"}, {"type": "subtitle", "time": 134.949, "timestamp": "00:02:14", "text": "一秒鐘。"}, {"type": "subtitle", "time": 138.309, "timestamp": "00:02:18", "text": "讓我打開遊戲。其實，"}, {"type": "subtitle", "time": 144.949, "timestamp": "00:02:24", "text": "偷看一下也無妨。我們走吧。"}, {"type": "subtitle", "time": 158.949, "timestamp": "00:02:38", "text": "製造一些不必要的事情。"}, {"type": "subtitle", "time": 161.75, "timestamp": "00:02:41", "text": "呃，"}, {"type": "subtitle", "time": 164.39, "timestamp": "00:02:44", "text": "好的。"}]
[{"type": "subtitle", "time": 10208.309, "timestamp": "02:50:08", "text": "チャレンジを終わらせられそうだ"}, {"type": "subtitle", "time": 10224.07, "timestamp": "02:50:24", "text": "けど、数を数えておく必要があるよね？ だから、"}, {"type": "subtitle", "time": 10229.429, "timestamp": "02:50:29", "text": "2つ手に入れた。 だから2は2、ええと1、2、3、4、4になります"}]
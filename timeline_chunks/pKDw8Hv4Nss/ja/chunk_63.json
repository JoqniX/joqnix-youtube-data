[{"type": "subtitle", "time": 3811.27, "timestamp": "01:03:31", "text": "私はこの隅っこにいるよ。"}, {"type": "subtitle", "time": 3814.87, "timestamp": "01:03:34", "text": "体力をつけてきて、ここまで登ってみろ。"}, {"type": "subtitle", "time": 3817.67, "timestamp": "01:03:37", "text": "体力をつけろ。 ここから登ってください。"}, {"type": "subtitle", "time": 3829.349, "timestamp": "01:03:49", "text": "まだまだ乗り越えなければならない山がたくさんある。"}, {"type": "subtitle", "time": 3831.109, "timestamp": "01:03:51", "text": "あ、待って。 それは私が思っているものと同じでしょうか？"}, {"type": "subtitle", "time": 3834.309, "timestamp": "01:03:54", "text": "ああ、ここは医療の中心地ですね。 はい。"}, {"type": "subtitle", "time": 3836.789, "timestamp": "01:03:56", "text": "神様、助けてくださってありがとうございます。 愛してます。"}]
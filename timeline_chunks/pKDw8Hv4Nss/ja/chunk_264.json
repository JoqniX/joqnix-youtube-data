[{"type": "subtitle", "time": 15846.389, "timestamp": "04:24:06", "text": "なぜ食べられないものでなければならないのか？"}, {"type": "subtitle", "time": 15849.75, "timestamp": "04:24:09", "text": "食用キノコをください。 それが私の唯一の願いです"}, {"type": "subtitle", "time": 15854.71, "timestamp": "04:24:14", "text": "。  1つで十分です。"}, {"type": "subtitle", "time": 15856.55, "timestamp": "04:24:16", "text": "はい、下の方にありますね。 私はそこへ行くつもりです"}, {"type": "subtitle", "time": 15859.67, "timestamp": "04:24:19", "text": "。 主よ、どうか私を"}, {"type": "subtitle", "time": 15884.149, "timestamp": "04:24:44", "text": "岩の大砲。 わーい。"}]
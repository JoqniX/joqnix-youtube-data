[{"type": "subtitle", "time": 7148.47, "timestamp": "01:59:08", "text": "ああ、やったよ。 やったよ。 やったよ。 やったよ"}, {"type": "subtitle", "time": 7158.55, "timestamp": "01:59:18", "text": "、チャレンジ企画の一環として、健康アイテムとしてぬいぐるみを1つ用意しました"}, {"type": "subtitle", "time": 7160.709, "timestamp": "01:59:20", "text": "。"}, {"type": "subtitle", "time": 7165.109, "timestamp": "01:59:25", "text": "ゲームをクリアするまでは、ぬいぐるみは絶対に受け取りません。 いや、もう違うよ"}, {"type": "subtitle", "time": 7166.87, "timestamp": "01:59:26", "text": "。 一気に終わらせてしまおう"}, {"type": "subtitle", "time": 7171.109, "timestamp": "01:59:31", "text": "。 ええと、対ツールが2つあるんですが"}, {"type": "subtitle", "time": 7174.229, "timestamp": "01:59:34", "text": "、これは本当に良いことですよね"}, {"type": "subtitle", "time": 7176.55, "timestamp": "01:59:36", "text": "？ そして、知ってる？ 食べちゃいます"}, {"type": "subtitle", "time": 7194.47, "timestamp": "01:59:54", "text": "よし、どうぞ。 さあ行こう。"}, {"type": "subtitle", "time": 7196.79, "timestamp": "01:59:56", "text": "次は火山です。 私たちは"}]
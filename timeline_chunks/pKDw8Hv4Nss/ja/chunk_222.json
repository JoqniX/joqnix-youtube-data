[{"type": "subtitle", "time": 13339.75, "timestamp": "03:42:19", "text": "この森の"}, {"type": "subtitle", "time": 13344.07, "timestamp": "03:42:24", "text": "エリアなら大丈夫。 私は本当に苦労していて、もう"}, {"type": "subtitle", "time": 13346.229, "timestamp": "03:42:26", "text": "ゲームをクリアしたなんて信じられない"}, {"type": "subtitle", "time": 13353.349, "timestamp": "03:42:33", "text": "溶岩の場所はものすごく"}, {"type": "subtitle", "time": 13355.75, "timestamp": "03:42:35", "text": "難しかった。"}, {"type": "subtitle", "time": 13359.03, "timestamp": "03:42:39", "text": "溶岩じゃなくて、もう一方の溶岩だよ。"}, {"type": "subtitle", "time": 13374.63, "timestamp": "03:42:54", "text": "ロープチャレンジはどうですか？ どうやって"}]
[{"type": "subtitle", "time": 9601.75, "timestamp": "02:40:01", "text": "スカウトマスターの日記をすべて読んでください"}, {"type": "subtitle", "time": 9603.27, "timestamp": "02:40:03", "text": "。"}, {"type": "subtitle", "time": 9611.83, "timestamp": "02:40:11", "text": "H を"}, {"type": "subtitle", "time": 9621.11, "timestamp": "02:40:21", "text": "山に何も置かずに島から脱出する。"}, {"type": "subtitle", "time": 9622.87, "timestamp": "02:40:22", "text": "落下ダメージを受けずに島から脱出せよ"}, {"type": "subtitle", "time": 9625.51, "timestamp": "02:40:25", "text": "。 一度に３人のスカウトを復活させた"}, {"type": "subtitle", "time": 9628.87, "timestamp": "02:40:28", "text": "。 わかった。"}, {"type": "subtitle", "time": 9632.79, "timestamp": "02:40:32", "text": "くそ。 というわけで、基本的なことはたくさん終わらせました"}, {"type": "subtitle", "time": 9635.27, "timestamp": "02:40:35", "text": "。"}, {"type": "subtitle", "time": 9639.83, "timestamp": "02:40:39", "text": "そして、友達を回復させると100ポイント獲得できます。"}, {"type": "subtitle", "time": 9646.23, "timestamp": "02:40:46", "text": "アイテムを使って合計20万の毒を回復しました。 あれをやり遂げたなんて、信じられない"}, {"type": "subtitle", "time": 9651.59, "timestamp": "02:40:51", "text": "。 ベリーも、"}, {"type": "subtitle", "time": 9656.55, "timestamp": "02:40:56", "text": "回復や慎重な友人をアイテムで"}, {"type": "subtitle", "time": 9659.19, "timestamp": "02:40:59", "text": "救うのに良いです。"}]
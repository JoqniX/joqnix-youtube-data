[{"type": "subtitle", "time": 7625.51, "timestamp": "02:07:05", "text": "ついに。 わーい。"}, {"type": "subtitle", "time": 7633.51, "timestamp": "02:07:13", "text": "なぜ私はそれを使ったのか？ グラノーラバー。 ああ、"}, {"type": "subtitle", "time": 7641.51, "timestamp": "02:07:21", "text": "キャンディーが必要なんです。"}, {"type": "subtitle", "time": 7644.149, "timestamp": "02:07:24", "text": "ロブ・キャノン。 私たちにはそれが必要なのです。 棒付き"}, {"type": "subtitle", "time": 7647.75, "timestamp": "02:07:27", "text": "キャンディー3本。 聖なる。 私は金持ちよ、ベイビー。 何てことだ"}]
[{"type": "subtitle", "time": 10037.269, "timestamp": "02:47:17", "text": "何も置かずに登らなければならないんですよね？   そうしてみます"}, {"type": "subtitle", "time": 10055.75, "timestamp": "02:47:35", "text": "キャンプ参加者向けに20食分の食事を作る。 待って、"}, {"type": "subtitle", "time": 10059.11, "timestamp": "02:47:39", "text": "これって本当に最後までやり遂げられるよね？"}, {"type": "subtitle", "time": 10069.99, "timestamp": "02:47:49", "text": "ココナッツと同じくらい手に入れることができることに今気づきました。"}, {"type": "subtitle", "time": 10076.79, "timestamp": "02:47:56", "text": "、そうすべきでもありません。"}, {"type": "subtitle", "time": 10078.95, "timestamp": "02:47:58", "text": "待って、待ちきれない。"}]
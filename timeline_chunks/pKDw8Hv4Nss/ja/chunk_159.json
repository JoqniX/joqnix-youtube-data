[{"type": "subtitle", "time": 9542.55, "timestamp": "02:39:02", "text": "包装食品を一切口にせずに島から脱出せよ。"}, {"type": "subtitle", "time": 9547.99, "timestamp": "02:39:07", "text": "ココナッツの半分、ハチの巣、黄色い"}, {"type": "subtitle", "time": 9550.309, "timestamp": "02:39:10", "text": "冬ウサギ、卵を調理して食べた後、島から脱出してください。 ああ、そういえば、"}, {"type": "subtitle", "time": 9552.55, "timestamp": "02:39:12", "text": "溶岩プレートから卵は手に入らなかったよ"}, {"type": "subtitle", "time": 9555.429, "timestamp": "02:39:15", "text": "ね？ 見つかりませんでした。"}, {"type": "subtitle", "time": 9558.23, "timestamp": "02:39:18", "text": "毒性のないキノコを4種類食べましょう。 単独の"}, {"type": "subtitle", "time": 9560.79, "timestamp": "02:39:20", "text": "探検。 意識を失うことなく島から脱出せよ"}, {"type": "subtitle", "time": 9563.75, "timestamp": "02:39:23", "text": "。 キャンプファイヤーで20食分の料理を作る"}, {"type": "subtitle", "time": 9566.79, "timestamp": "02:39:26", "text": "。"}, {"type": "subtitle", "time": 9578.389, "timestamp": "02:39:38", "text": "ピストンを10個配置します。 本当にレンガの3の頂上に到達してください"}, {"type": "subtitle", "time": 9581.429, "timestamp": "02:39:41", "text": "。"}, {"type": "subtitle", "time": 9583.67, "timestamp": "02:39:43", "text": "ああ、あの３人ね。"}, {"type": "subtitle", "time": 9585.59, "timestamp": "02:39:45", "text": "スカウトマスターと1対1で対戦します。 ああ、確かに"}, {"type": "subtitle", "time": 9592.469, "timestamp": "02:39:52", "text": "1回の遠征で100メートルのロープを押し切る"}, {"type": "subtitle", "time": 9594.79, "timestamp": "02:39:54", "text": "。"}, {"type": "subtitle", "time": 9598.87, "timestamp": "02:39:58", "text": "合計5,000メートル登る。"}]
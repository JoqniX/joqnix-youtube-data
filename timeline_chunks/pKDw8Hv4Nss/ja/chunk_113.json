[{"type": "subtitle", "time": 6786.709, "timestamp": "01:53:06", "text": "。 どうすればいいですか？ たぶんこんな感じかな"}, {"type": "subtitle", "time": 6789.669, "timestamp": "01:53:09", "text": "。 多分。"}, {"type": "subtitle", "time": 6809.109, "timestamp": "01:53:29", "text": "ああ、なんてことだ。 このバカ野郎。 ああ、なんてことだ。"}, {"type": "subtitle", "time": 6811.75, "timestamp": "01:53:31", "text": "登れたのに、なぜ無駄にしたんだ"}, {"type": "subtitle", "time": 6821.91, "timestamp": "01:53:41", "text": "私はそれを無駄にした。 私はそれを無駄にした。 何てことだ。   あの"}, {"type": "subtitle", "time": 6829.83, "timestamp": "01:53:49", "text": "大丈夫です。 大丈夫。 大丈夫。"}, {"type": "subtitle", "time": 6832.629, "timestamp": "01:53:52", "text": "大丈夫。 そういうこともある。"}]
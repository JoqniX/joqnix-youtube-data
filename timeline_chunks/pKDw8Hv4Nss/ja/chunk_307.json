[{"type": "subtitle", "time": 18423.03, "timestamp": "05:07:03", "text": "頭の中のことは終わりにしよう。"}, {"type": "subtitle", "time": 18426.788, "timestamp": "05:07:06", "text": "オーケー、午後12時17分。よし、"}, {"type": "subtitle", "time": 18430.07, "timestamp": "05:07:10", "text": "昼食を食べよう。"}, {"type": "subtitle", "time": 18434.15, "timestamp": "05:07:14", "text": "昼食を食べて、"}, {"type": "subtitle", "time": 18436.31, "timestamp": "05:07:16", "text": "昼寝しよう。うまくいけば"}, {"type": "subtitle", "time": 18440.47, "timestamp": "05:07:20", "text": "6時半に起きられるといいな。"}, {"type": "subtitle", "time": 18443.59, "timestamp": "05:07:23", "text": "夜に配信するかどうかはわからない。"}, {"type": "subtitle", "time": 18446.31, "timestamp": "05:07:26", "text": "音楽に出席しないといけないんだ。10"}, {"type": "subtitle", "time": 18453.27, "timestamp": "05:07:33", "text": "分間プラズを歌ってるみたい。 今日はベンダスをして、"}, {"type": "chat", "time": 18454.237, "timestamp": "05:07:34", "author": "@giver9144", "avatar": "https://yt4.ggpht.com/ytc/AIdro_noHK67ltOtNG9w-x2QyzCyOVUZGkiZjfEEUszeks5XwQ=s64-c-k-c0x00ffffff-no-rj", "message": "have a good rest. "}, {"type": "subtitle", "time": 18459.19, "timestamp": "05:07:39", "text": "9時までにそれを済ませます。うん。それから、"}, {"type": "subtitle", "time": 18463.11, "timestamp": "05:07:43", "text": "今日は完全に休養します。うん、"}, {"type": "subtitle", "time": 18467.19, "timestamp": "05:07:47", "text": "明日の朝は時間通りに起きたいから"}, {"type": "subtitle", "time": 18469.11, "timestamp": "05:07:49", "text": "。こういう朝の配信はできるよ"}, {"type": "subtitle", "time": 18471.43, "timestamp": "05:07:51", "text": "ね？"}, {"type": "subtitle", "time": 18474.31, "timestamp": "05:07:54", "text": "ゲームはしないけど、ウェブ"}, {"type": "subtitle", "time": 18477.43, "timestamp": "05:07:57", "text": "サイトのことは終わらせられるよ"}]
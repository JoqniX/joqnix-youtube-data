[{"type": "subtitle", "time": 16054.63, "timestamp": "04:27:34", "text": "ああ、神よ。 ああ、"}, {"type": "subtitle", "time": 16071.91, "timestamp": "04:27:51", "text": "ロープが手に入らなかった、もしくは、あ、待って。"}, {"type": "subtitle", "time": 16074.07, "timestamp": "04:27:54", "text": "実はピストンは私が作ったんです。"}, {"type": "subtitle", "time": 16075.99, "timestamp": "04:27:55", "text": "本当に？"}]
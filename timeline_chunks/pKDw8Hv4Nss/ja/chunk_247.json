[{"type": "subtitle", "time": 14823.75, "timestamp": "04:07:03", "text": "夜行性のカモの集団よ。 彼も"}, {"type": "subtitle", "time": 14848.55, "timestamp": "04:07:28", "text": "[音楽]"}, {"type": "subtitle", "time": 14851.67, "timestamp": "04:07:31", "text": "私は文字通り、ここにいくつかあります"}, {"type": "subtitle", "time": 14866.79, "timestamp": "04:07:46", "text": "この場所はもう確認済みですよね？"}, {"type": "subtitle", "time": 14876.15, "timestamp": "04:07:56", "text": "[音楽] よくわからない"}, {"type": "subtitle", "time": 14879.189, "timestamp": "04:07:59", "text": "けど、わかった、知ってる？"}]
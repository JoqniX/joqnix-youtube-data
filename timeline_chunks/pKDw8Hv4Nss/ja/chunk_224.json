[{"type": "subtitle", "time": 13440.469, "timestamp": "03:44:00", "text": "登攀が必要となる。 わかった。  15のコースを開放し、"}, {"type": "subtitle", "time": 13443.349, "timestamp": "03:44:03", "text": "1回の走行のみ。 実はこの"}, {"type": "subtitle", "time": 13448.87, "timestamp": "03:44:08", "text": "本は既に持っています。 わかった。 これは何ですか？"}, {"type": "subtitle", "time": 13451.83, "timestamp": "03:44:11", "text": "スカウトマッチマスターのスポーン"}, {"type": "subtitle", "time": 13454.79, "timestamp": "03:44:14", "text": "地点をすべて読んでください。"}, {"type": "subtitle", "time": 13456.07, "timestamp": "03:44:16", "text": "その日に出現しなかった場合は、翌日に再度確認する必要があります"}, {"type": "subtitle", "time": 13457.99, "timestamp": "03:44:17", "text": "。 海岸で巻物を見つけたが"}, {"type": "subtitle", "time": 13461.51, "timestamp": "03:44:21", "text": "、"}, {"type": "subtitle", "time": 13464.15, "timestamp": "03:44:24", "text": "カレンダーリアでしか入手できない8ページ目が必要な場合は、カレンダーリアの地図"}, {"type": "subtitle", "time": 13465.99, "timestamp": "03:44:25", "text": "上にいる間に巻物が開くまで待ってください"}, {"type": "subtitle", "time": 13469.91, "timestamp": "03:44:29", "text": "。 海岸、熱帯、高山、"}, {"type": "subtitle", "time": 13472.79, "timestamp": "03:44:32", "text": "1ページ目。 地図、キノコ、キャンプファイヤー、"}, {"type": "subtitle", "time": 13475.11, "timestamp": "03:44:35", "text": "オカルト。   わかった"}, {"type": "subtitle", "time": 13478.79, "timestamp": "03:44:38", "text": "。 ピアノロールのゼロを左に。"}, {"type": "subtitle", "time": 13482.389, "timestamp": "03:44:42", "text": "わあ、すごい。 私たちはこれを全て読まなければならない。"}, {"type": "subtitle", "time": 13485.349, "timestamp": "03:44:45", "text": "持久力バンドが上向きに上がってきます。"}, {"type": "subtitle", "time": 13489.75, "timestamp": "03:44:49", "text": "エネルギーリング、ロリポップ、ピストン、ロープ"}, {"type": "subtitle", "time": 13492.07, "timestamp": "03:44:52", "text": "スプール、大砲などを使うと、これを実現するのに役立ちます"}, {"type": "subtitle", "time": 13495.51, "timestamp": "03:44:55", "text": "。 忍者。 ああ、わかりました。"}, {"type": "subtitle", "time": 13499.99, "timestamp": "03:44:59", "text": "それはあなたのヘアバンドです。 ディオ忍者。   わかった"}]
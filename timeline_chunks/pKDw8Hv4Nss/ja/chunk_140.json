[{"type": "subtitle", "time": 8404.15, "timestamp": "02:20:04", "text": "リラックスして、"}, {"type": "subtitle", "time": 8422.71, "timestamp": "02:20:22", "text": "つまり、私はそこに閉じ込められているということだ。"}, {"type": "subtitle", "time": 8425.51, "timestamp": "02:20:25", "text": "ここに閉じ込められた。 ここからジャンプして、"}, {"type": "subtitle", "time": 8428.15, "timestamp": "02:20:28", "text": "これにつかまって、"}, {"type": "subtitle", "time": 8444.79, "timestamp": "02:20:44", "text": "よし、クッキーから少しエネルギーが得られたから"}, {"type": "subtitle", "time": 8446.87, "timestamp": "02:20:46", "text": "、それは"}, {"type": "subtitle", "time": 8448.71, "timestamp": "02:20:48", "text": "良いことだ。"}, {"type": "subtitle", "time": 8452.63, "timestamp": "02:20:52", "text": "火の勢いが弱まるまで待ってください"}]